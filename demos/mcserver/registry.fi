// SPDX-License-Identifier: MIT
// demos/mcserver/registry.fi -- the registry codec of protocol 765
// (round 76).
//
// SINCE 1.20.2 the login does not go straight into the world. Between
// Login Success and Join Game sits a CONFIGURATION state, and in it the
// server sends the client the registries: which dimension types exist,
// which biomes, which chat types, which damage types. The client builds its
// own registries from them, and everything that follows refers to entries
// BY NUMBER -- the position in this list. That is why the order matters and
// why a missing entry is not a cosmetic defect: a reference to an entry
// that does not exist disconnects the client.
//
// WHAT IS IN HERE, AND WHY EXACTLY THAT. All SIX registries the vanilla
// server 1.20.4 sends, because the client checks for them by name:
//
//   minecraft:dimension_type   1 entry  -- the world we hand out
//   minecraft:worldgen/biome   1 entry  -- chunk data refers to biome 0
//   minecraft:chat_type        1 entry
//   minecraft:damage_type     44 entries
//   minecraft:trim_pattern     1 entry
//   minecraft:trim_material    1 entry
//
// THE 44 DAMAGE TYPES ARE NOT PADDING. The client builds a `DamageSources`
// when it creates the world and resolves a fixed list of damage types while
// doing so; whichever one is missing throws there, in the middle of the
// loading screen. So the list was not invented here -- it was CAPTURED off
// the running vanilla server (`tools/mcserver/harness.py registries`
// against `java -jar server.jar`, 2026-08-21) and written down with the
// message id, the scaling and the exhaustion each one really has.
//
// The vanilla server sends 39,307 octets here; this one sends about 3,000,
// because dimension_type has one entry instead of four and
// worldgen/biome one instead of 64. Everything that is sent is sent the way
// the client expects it.
//
// The NBT is the NETWORK form: the root compound has NO name (1.20.2). One
// octet, and without it the client leaves without a message.

import std.nbt
import std.bytes

export { build_registry_codec }

// One entry of a registry list: name, numeric id, element. Inside a list
// the entries carry no tag and no name of their own -- the content of the
// compound follows directly, and a TAG_End closes it.
fn entry_head(b: *mut bytes.Bytes, name: u64, id: i32) {
    var k_name: [u8; 5] = "name\0"
    var k_id: [u8; 3] = "id\0"
    nbt.nbt_c_string(b, (&k_name[0]) as u64, name)
    nbt.nbt_c_int(b, (&k_id[0]) as u64, id)
}

fn element_begin(b: *mut bytes.Bytes) {
    var k_el: [u8; 8] = "element\0"
    nbt.nbt_c_compound_begin(b, (&k_el[0]) as u64)
}

// The frame of a registry: a compound with `type` (its own name) and
// `value` (the list of entries).
fn registry_begin(b: *mut bytes.Bytes, name: u64, count: i32) {
    var k_type: [u8; 5] = "type\0"
    var k_value: [u8; 6] = "value\0"
    nbt.nbt_compound_begin(b, name, rt_len(name))
    nbt.nbt_c_string(b, (&k_type[0]) as u64, name)
    nbt.nbt_c_list_open(b, (&k_value[0]) as u64, nbt.TAG_COMPOUND, count)
}

fn registry_end(b: *mut bytes.Bytes) {
    nbt.nbt_end(b) // the registry compound
}

fn rt_len(p: u64) -> usize {
    var n: usize = 0
    while *((p + n as u64) as *mut u8) != 0 as u8 {
        n = n + 1
    }
    return n
}

// One damage type.
fn dt(b: *mut bytes.Bytes, id: i32, name: u64, msg: u64, scaling: u64, exhaustion: f32) {
    var k_msg: [u8; 11] = "message_id\0"
    var k_sc: [u8; 8] = "scaling\0"
    var k_ex: [u8; 11] = "exhaustion\0"
    entry_head(b, name, id)
    element_begin(b)
    nbt.nbt_c_string(b, (&k_msg[0]) as u64, msg)
    nbt.nbt_c_string(b, (&k_sc[0]) as u64, scaling)
    nbt.nbt_c_float(b, (&k_ex[0]) as u64, exhaustion)
    nbt.nbt_end(b) // element
    nbt.nbt_end(b) // entry
}

// The one dimension: minecraft:overworld, field for field as the vanilla
// server sends it. `min_y` -64 and `height` 384 are the two numbers the
// chunk data has to agree with -- 384/16 = 24 sections, and a chunk with a
// different number of sections desynchronises the client's reader mid
// packet.
fn dimension_type(b: *mut bytes.Bytes) {
    var reg: [u8; 25] = "minecraft:dimension_type\0"
    var ow: [u8; 20] = "minecraft:overworld\0"
    var k_piglin: [u8; 12] = "piglin_safe\0"
    var k_natural: [u8; 8] = "natural\0"
    var k_ambient: [u8; 14] = "ambient_light\0"
    var k_msbll: [u8; 32] = "monster_spawn_block_light_limit\0"
    var k_infi: [u8; 11] = "infiniburn\0"
    var v_infi: [u8; 32] = "#minecraft:infiniburn_overworld\0"
    var k_anchor: [u8; 21] = "respawn_anchor_works\0"
    var k_sky: [u8; 13] = "has_skylight\0"
    var k_bed: [u8; 10] = "bed_works\0"
    var k_effects: [u8; 8] = "effects\0"
    var k_raids: [u8; 10] = "has_raids\0"
    var k_logical: [u8; 15] = "logical_height\0"
    var k_coord: [u8; 17] = "coordinate_scale\0"
    var k_msll: [u8; 26] = "monster_spawn_light_level\0"
    var k_type: [u8; 5] = "type\0"
    var v_uniform: [u8; 18] = "minecraft:uniform\0"
    var k_value: [u8; 6] = "value\0"
    var k_min: [u8; 14] = "min_inclusive\0"
    var k_max: [u8; 14] = "max_inclusive\0"
    var k_miny: [u8; 6] = "min_y\0"
    var k_ultra: [u8; 10] = "ultrawarm\0"
    var k_ceiling: [u8; 12] = "has_ceiling\0"
    var k_height: [u8; 7] = "height\0"

    registry_begin(b, (&reg[0]) as u64, 1)
    entry_head(b, (&ow[0]) as u64, 0)
    element_begin(b)
    nbt.nbt_c_byte(b, (&k_piglin[0]) as u64, 0 as i8)
    nbt.nbt_c_byte(b, (&k_natural[0]) as u64, 1 as i8)
    nbt.nbt_c_float(b, (&k_ambient[0]) as u64, 0.0f)
    nbt.nbt_c_int(b, (&k_msbll[0]) as u64, 0)
    nbt.nbt_c_string(b, (&k_infi[0]) as u64, (&v_infi[0]) as u64)
    nbt.nbt_c_byte(b, (&k_anchor[0]) as u64, 0 as i8)
    nbt.nbt_c_byte(b, (&k_sky[0]) as u64, 1 as i8)
    nbt.nbt_c_byte(b, (&k_bed[0]) as u64, 1 as i8)
    nbt.nbt_c_string(b, (&k_effects[0]) as u64, (&ow[0]) as u64)
    nbt.nbt_c_byte(b, (&k_raids[0]) as u64, 1 as i8)
    nbt.nbt_c_int(b, (&k_logical[0]) as u64, 384)
    nbt.nbt_c_double(b, (&k_coord[0]) as u64, 1.0)
    nbt.nbt_c_compound_begin(b, (&k_msll[0]) as u64)
    nbt.nbt_c_string(b, (&k_type[0]) as u64, (&v_uniform[0]) as u64)
    nbt.nbt_c_compound_begin(b, (&k_value[0]) as u64)
    nbt.nbt_c_int(b, (&k_min[0]) as u64, 0)
    nbt.nbt_c_int(b, (&k_max[0]) as u64, 7)
    nbt.nbt_end(b)
    nbt.nbt_end(b)
    nbt.nbt_c_int(b, (&k_miny[0]) as u64, 0 - 64)
    nbt.nbt_c_byte(b, (&k_ultra[0]) as u64, 0 as i8)
    nbt.nbt_c_byte(b, (&k_ceiling[0]) as u64, 0 as i8)
    nbt.nbt_c_int(b, (&k_height[0]) as u64, 384)
    nbt.nbt_end(b) // element
    nbt.nbt_end(b) // entry
    registry_end(b)
}

// The one biome. Chunk data refers to it as number 0, so it has to be the
// first (and here: the only) entry.
fn biomes(b: *mut bytes.Bytes) {
    var reg: [u8; 25] = "minecraft:worldgen/biome\0"
    var plains: [u8; 17] = "minecraft:plains\0"
    var k_effects: [u8; 8] = "effects\0"
    var k_sky: [u8; 10] = "sky_color\0"
    var k_wfog: [u8; 16] = "water_fog_color\0"
    var k_fog: [u8; 10] = "fog_color\0"
    var k_water: [u8; 12] = "water_color\0"
    var k_mood: [u8; 11] = "mood_sound\0"
    var k_tick: [u8; 11] = "tick_delay\0"
    var k_off: [u8; 7] = "offset\0"
    var k_sound: [u8; 6] = "sound\0"
    var v_sound: [u8; 23] = "minecraft:ambient.cave\0"
    var k_bse: [u8; 20] = "block_search_extent\0"
    var k_prec: [u8; 18] = "has_precipitation\0"
    var k_temp: [u8; 12] = "temperature\0"
    var k_down: [u8; 9] = "downfall\0"

    registry_begin(b, (&reg[0]) as u64, 1)
    entry_head(b, (&plains[0]) as u64, 0)
    element_begin(b)
    nbt.nbt_c_compound_begin(b, (&k_effects[0]) as u64)
    nbt.nbt_c_int(b, (&k_sky[0]) as u64, 7907327)
    nbt.nbt_c_int(b, (&k_wfog[0]) as u64, 329011)
    nbt.nbt_c_int(b, (&k_fog[0]) as u64, 12638463)
    nbt.nbt_c_int(b, (&k_water[0]) as u64, 4159204)
    nbt.nbt_c_compound_begin(b, (&k_mood[0]) as u64)
    nbt.nbt_c_int(b, (&k_tick[0]) as u64, 6000)
    nbt.nbt_c_double(b, (&k_off[0]) as u64, 2.0)
    nbt.nbt_c_string(b, (&k_sound[0]) as u64, (&v_sound[0]) as u64)
    nbt.nbt_c_int(b, (&k_bse[0]) as u64, 8)
    nbt.nbt_end(b)
    nbt.nbt_end(b)
    nbt.nbt_c_byte(b, (&k_prec[0]) as u64, 1 as i8)
    nbt.nbt_c_float(b, (&k_temp[0]) as u64, 0.8f)
    nbt.nbt_c_float(b, (&k_down[0]) as u64, 0.4f)
    nbt.nbt_end(b) // element
    nbt.nbt_end(b) // entry
    registry_end(b)
}

fn chat_types(b: *mut bytes.Bytes) {
    var reg: [u8; 20] = "minecraft:chat_type\0"
    var chat: [u8; 15] = "minecraft:chat\0"
    var k_chat: [u8; 5] = "chat\0"
    var k_narr: [u8; 10] = "narration\0"
    var k_tk: [u8; 16] = "translation_key\0"
    var v_tk: [u8; 15] = "chat.type.text\0"
    var v_tkn: [u8; 23] = "chat.type.text.narrate\0"
    var k_par: [u8; 11] = "parameters\0"
    var v_sender: [u8; 7] = "sender\0"
    var v_content: [u8; 8] = "content\0"

    registry_begin(b, (&reg[0]) as u64, 1)
    entry_head(b, (&chat[0]) as u64, 0)
    element_begin(b)
    nbt.nbt_c_compound_begin(b, (&k_chat[0]) as u64)
    nbt.nbt_c_string(b, (&k_tk[0]) as u64, (&v_tk[0]) as u64)
    // A list of STRINGS: the elements carry no name and no type octet.
    nbt.nbt_c_list_open(b, (&k_par[0]) as u64, nbt.TAG_STRING, 2)
    nbt.nbt_raw_string(b, (&v_sender[0]) as u64, 6)
    nbt.nbt_raw_string(b, (&v_content[0]) as u64, 7)
    nbt.nbt_end(b)
    nbt.nbt_c_compound_begin(b, (&k_narr[0]) as u64)
    nbt.nbt_c_string(b, (&k_tk[0]) as u64, (&v_tkn[0]) as u64)
    nbt.nbt_c_list_open(b, (&k_par[0]) as u64, nbt.TAG_STRING, 2)
    nbt.nbt_raw_string(b, (&v_sender[0]) as u64, 6)
    nbt.nbt_raw_string(b, (&v_content[0]) as u64, 7)
    nbt.nbt_end(b)
    nbt.nbt_end(b) // element
    nbt.nbt_end(b) // entry
    registry_end(b)
}

// One entry each. An EMPTY registry would be the honest thing here (this
// server has no armour trims), but the client reads both when it builds its
// item models, and one entry is cheaper than finding out how it reacts to
// none.
fn trims(b: *mut bytes.Bytes) {
    var rp: [u8; 23] = "minecraft:trim_pattern\0"
    var rm: [u8; 24] = "minecraft:trim_material\0"
    var coast: [u8; 16] = "minecraft:coast\0"
    var amethyst: [u8; 19] = "minecraft:amethyst\0"
    var k_ti: [u8; 14] = "template_item\0"
    var v_ti: [u8; 45] = "minecraft:coast_armor_trim_smithing_template\0"
    var k_desc: [u8; 12] = "description\0"
    var k_tr: [u8; 10] = "translate\0"
    var v_trp: [u8; 29] = "trim_pattern.minecraft.coast\0"
    var k_asset: [u8; 9] = "asset_id\0"
    var k_decal: [u8; 6] = "decal\0"
    var k_ing: [u8; 11] = "ingredient\0"
    var v_ing: [u8; 25] = "minecraft:amethyst_shard\0"
    var k_an: [u8; 11] = "asset_name\0"
    var v_an: [u8; 9] = "amethyst\0"
    var k_imi: [u8; 17] = "item_model_index\0"
    var k_color: [u8; 6] = "color\0"
    var v_color: [u8; 8] = "#9A5CC6\0"
    var v_trm: [u8; 33] = "trim_material.minecraft.amethyst\0"

    registry_begin(b, (&rp[0]) as u64, 1)
    entry_head(b, (&coast[0]) as u64, 0)
    element_begin(b)
    nbt.nbt_c_string(b, (&k_ti[0]) as u64, (&v_ti[0]) as u64)
    nbt.nbt_c_compound_begin(b, (&k_desc[0]) as u64)
    nbt.nbt_c_string(b, (&k_tr[0]) as u64, (&v_trp[0]) as u64)
    nbt.nbt_end(b)
    nbt.nbt_c_string(b, (&k_asset[0]) as u64, (&coast[0]) as u64)
    nbt.nbt_c_byte(b, (&k_decal[0]) as u64, 0 as i8)
    nbt.nbt_end(b)
    nbt.nbt_end(b)
    registry_end(b)

    registry_begin(b, (&rm[0]) as u64, 1)
    entry_head(b, (&amethyst[0]) as u64, 0)
    element_begin(b)
    nbt.nbt_c_string(b, (&k_ing[0]) as u64, (&v_ing[0]) as u64)
    nbt.nbt_c_string(b, (&k_an[0]) as u64, (&v_an[0]) as u64)
    nbt.nbt_c_float(b, (&k_imi[0]) as u64, 1.0f)
    nbt.nbt_c_compound_begin(b, (&k_desc[0]) as u64)
    nbt.nbt_c_string(b, (&k_color[0]) as u64, (&v_color[0]) as u64)
    nbt.nbt_c_string(b, (&k_tr[0]) as u64, (&v_trm[0]) as u64)
    nbt.nbt_end(b)
    nbt.nbt_end(b)
    nbt.nbt_end(b)
    registry_end(b)
}

// Every damage type the vanilla server 1.20.4 sends -- all 44, with the
// message id, the scaling and the exhaustion it really has. The list is
// NOT decoration and NOT shortenable: the CLIENT resolves a fixed set of
// them (`DamageSources`, built when the world is created) and throws if
// one is missing. Captured from the running vanilla server with
// `tools/mcserver/harness.py registries`.
fn damage_types(b: *mut bytes.Bytes) {
    var sc0: [u8; 7] = "always\0"
    var sc1: [u8; 33] = "when_caused_by_living_non_player\0"
    var dn0: [u8; 16] = "minecraft:arrow\0"
    var dm0: [u8; 6] = "arrow\0"
    var dn1: [u8; 28] = "minecraft:bad_respawn_point\0"
    var dm1: [u8; 16] = "badRespawnPoint\0"
    var dn2: [u8; 17] = "minecraft:cactus\0"
    var dm2: [u8; 7] = "cactus\0"
    var dn3: [u8; 19] = "minecraft:cramming\0"
    var dm3: [u8; 9] = "cramming\0"
    var dn4: [u8; 24] = "minecraft:dragon_breath\0"
    var dm4: [u8; 13] = "dragonBreath\0"
    var dn5: [u8; 16] = "minecraft:drown\0"
    var dm5: [u8; 6] = "drown\0"
    var dn6: [u8; 18] = "minecraft:dry_out\0"
    var dm6: [u8; 7] = "dryout\0"
    var dn7: [u8; 20] = "minecraft:explosion\0"
    var dm7: [u8; 10] = "explosion\0"
    var dn8: [u8; 15] = "minecraft:fall\0"
    var dm8: [u8; 5] = "fall\0"
    var dn9: [u8; 24] = "minecraft:falling_anvil\0"
    var dm9: [u8; 6] = "anvil\0"
    var dn10: [u8; 24] = "minecraft:falling_block\0"
    var dm10: [u8; 13] = "fallingBlock\0"
    var dn11: [u8; 29] = "minecraft:falling_stalactite\0"
    var dm11: [u8; 18] = "fallingStalactite\0"
    var dn12: [u8; 19] = "minecraft:fireball\0"
    var dm12: [u8; 9] = "fireball\0"
    var dn13: [u8; 20] = "minecraft:fireworks\0"
    var dm13: [u8; 10] = "fireworks\0"
    var dn14: [u8; 24] = "minecraft:fly_into_wall\0"
    var dm14: [u8; 12] = "flyIntoWall\0"
    var dn15: [u8; 17] = "minecraft:freeze\0"
    var dm15: [u8; 7] = "freeze\0"
    var dn16: [u8; 18] = "minecraft:generic\0"
    var dm16: [u8; 8] = "generic\0"
    var dn17: [u8; 23] = "minecraft:generic_kill\0"
    var dm17: [u8; 12] = "genericKill\0"
    var dn18: [u8; 20] = "minecraft:hot_floor\0"
    var dm18: [u8; 9] = "hotFloor\0"
    var dn19: [u8; 18] = "minecraft:in_fire\0"
    var dm19: [u8; 7] = "inFire\0"
    var dn20: [u8; 18] = "minecraft:in_wall\0"
    var dm20: [u8; 7] = "inWall\0"
    var dn21: [u8; 25] = "minecraft:indirect_magic\0"
    var dm21: [u8; 14] = "indirectMagic\0"
    var dn22: [u8; 15] = "minecraft:lava\0"
    var dm22: [u8; 5] = "lava\0"
    var dn23: [u8; 25] = "minecraft:lightning_bolt\0"
    var dm23: [u8; 14] = "lightningBolt\0"
    var dn24: [u8; 16] = "minecraft:magic\0"
    var dm24: [u8; 6] = "magic\0"
    var dn25: [u8; 21] = "minecraft:mob_attack\0"
    var dm25: [u8; 4] = "mob\0"
    var dn26: [u8; 30] = "minecraft:mob_attack_no_aggro\0"
    var dm26: [u8; 4] = "mob\0"
    var dn27: [u8; 25] = "minecraft:mob_projectile\0"
    var dm27: [u8; 4] = "mob\0"
    var dn28: [u8; 18] = "minecraft:on_fire\0"
    var dm28: [u8; 7] = "onFire\0"
    var dn29: [u8; 23] = "minecraft:out_of_world\0"
    var dm29: [u8; 11] = "outOfWorld\0"
    var dn30: [u8; 25] = "minecraft:outside_border\0"
    var dm30: [u8; 14] = "outsideBorder\0"
    var dn31: [u8; 24] = "minecraft:player_attack\0"
    var dm31: [u8; 7] = "player\0"
    var dn32: [u8; 27] = "minecraft:player_explosion\0"
    var dm32: [u8; 17] = "explosion.player\0"
    var dn33: [u8; 21] = "minecraft:sonic_boom\0"
    var dm33: [u8; 11] = "sonic_boom\0"
    var dn34: [u8; 21] = "minecraft:stalagmite\0"
    var dm34: [u8; 11] = "stalagmite\0"
    var dn35: [u8; 17] = "minecraft:starve\0"
    var dm35: [u8; 7] = "starve\0"
    var dn36: [u8; 16] = "minecraft:sting\0"
    var dm36: [u8; 6] = "sting\0"
    var dn37: [u8; 27] = "minecraft:sweet_berry_bush\0"
    var dm37: [u8; 15] = "sweetBerryBush\0"
    var dn38: [u8; 17] = "minecraft:thorns\0"
    var dm38: [u8; 7] = "thorns\0"
    var dn39: [u8; 17] = "minecraft:thrown\0"
    var dm39: [u8; 7] = "thrown\0"
    var dn40: [u8; 18] = "minecraft:trident\0"
    var dm40: [u8; 8] = "trident\0"
    var dn41: [u8; 32] = "minecraft:unattributed_fireball\0"
    var dm41: [u8; 7] = "onFire\0"
    var dn42: [u8; 17] = "minecraft:wither\0"
    var dm42: [u8; 7] = "wither\0"
    var dn43: [u8; 23] = "minecraft:wither_skull\0"
    var dm43: [u8; 12] = "witherSkull\0"

    dt(b, 0, (&dn0[0]) as u64, (&dm0[0]) as u64, (&sc1[0]) as u64, 0.1f)
    dt(b, 1, (&dn1[0]) as u64, (&dm1[0]) as u64, (&sc0[0]) as u64, 0.1f)
    dt(b, 2, (&dn2[0]) as u64, (&dm2[0]) as u64, (&sc1[0]) as u64, 0.1f)
    dt(b, 3, (&dn3[0]) as u64, (&dm3[0]) as u64, (&sc1[0]) as u64, 0.0f)
    dt(b, 4, (&dn4[0]) as u64, (&dm4[0]) as u64, (&sc1[0]) as u64, 0.0f)
    dt(b, 5, (&dn5[0]) as u64, (&dm5[0]) as u64, (&sc1[0]) as u64, 0.0f)
