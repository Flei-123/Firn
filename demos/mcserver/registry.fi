// The whole codec, into `b`. The root compound carries NO name -- the
// network form since 1.20.2.
fn build_registry_codec(b: *mut bytes.Bytes) {
    var reg_dmg: [u8; 22] = "minecraft:damage_type\0"
    nbt.nbt_root_begin_anon(b)
    dimension_type(b)
    biomes(b)
    chat_types(b)
    registry_begin(b, (&reg_dmg[0]) as u64, 44)
    damage_types(b)
    registry_end(b)
    trims(b)
    nbt.nbt_end(b)
}
