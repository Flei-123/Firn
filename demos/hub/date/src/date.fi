// SPDX-License-Identifier: MIT
// demos/hub/date -- civil dates in Firn, round FIRNHUB.
//
// The second real dependency of this round. Like `json` it has no
// dependency of its own and allocates nothing, so it can be fetched into an
// empty world and still build.
//
// THE ONE IDEA IN HERE is Howard Hinnant's `days_from_civil`: shift the year
// so that it begins on 1 March. Then February -- the month with the
// irregular length -- is the LAST one, the leap day sits at the end of the
// year where it can be ignored, and the length of a month becomes a closed
// formula (`(153*m + 2) / 5`) instead of a table. The inverse works the
// same way. Both are exact for every year a 64 bit day count can reach and
// need no loop, which is why the round trip over ±400 years is a test and
// not a hope.
//
// The epoch is 1970-01-01 = day 0, negative days are earlier, and the
// proleptic Gregorian calendar is used throughout -- there is no Julian
// switch-over in here, and a date before 1582 means what the formula says.

export {
    date_is_leap, date_days_in_month, date_valid,
    date_to_days, date_from_days, date_weekday, date_format, date_add_days,
}

fn date_is_leap(y: i64) -> bool {
    if y % 4 != 0 {
        return false
    }
    if y % 100 != 0 {
        return true
    }
    return y % 400 == 0
}

fn date_days_in_month(y: i64, m: i64) -> i64 {
    if m == 2 {
        if date_is_leap(y) {
            return 29
        }
        return 28
    }
    if m == 4 || m == 6 || m == 9 || m == 11 {
        return 30
    }
    if m == 1 || m == 3 || m == 5 || m == 7 || m == 8 || m == 10 || m == 12 {
        return 31
    }
    return 0
}

fn date_valid(y: i64, m: i64, d: i64) -> bool {
    if m < 1 || m > 12 {
        return false
    }
    if d < 1 {
        return false
    }
    return d <= date_days_in_month(y, m)
}

// Days since 1970-01-01. The year is shifted so that it starts in March.
fn date_to_days(y: i64, m: i64, d: i64) -> i64 {
    var yy: i64 = y
    if m <= 2 {
        yy = yy - 1
    }
    var era: i64 = yy / 400
    if yy < 0 {
        if yy % 400 != 0 {
            era = era - 1
        }
    }
    let yoe: i64 = yy - era * 400
    var mp: i64 = m + 9
    if m > 2 {
        mp = m - 3
    }
    let doy: i64 = (153 * mp + 2) / 5 + d - 1
    let doe: i64 = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

fn date_from_days(days: i64, y: *mut i64, m: *mut i64, d: *mut i64) {
    let z: i64 = days + 719468
    var era: i64 = z / 146097
    if z < 0 {
        if z % 146097 != 0 {
            era = era - 1
        }
    }
    let doe: i64 = z - era * 146097
    let yoe: i64 = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let yy: i64 = yoe + era * 400
    let doy: i64 = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp: i64 = (5 * doy + 2) / 153
    let dd: i64 = doy - (153 * mp + 2) / 5 + 1
    var mm: i64 = mp - 9
    if mp < 10 {
        mm = mp + 3
    }
    var year: i64 = yy
    if mm <= 2 {
        year = yy + 1
    }
    *y = year
    *m = mm
    *d = dd
}

// 0 = Sunday. 1970-01-01 was a Thursday, hence the + 4.
fn date_weekday(y: i64, m: i64, d: i64) -> i64 {
    let t: i64 = date_to_days(y, m, d) + 4
    var r: i64 = t % 7
    if r < 0 {
        r = r + 7
    }
    return r
}

fn date_add_days(y: *mut i64, m: *mut i64, d: *mut i64, by: i64) {
    let t: i64 = date_to_days(*y, *m, *d) + by
    date_from_days(t, y, m, d)
}

// `YYYY-MM-DD` into `dst`, ten octets, always. A year outside 0..9999 is
// refused rather than silently cut: a date that prints as four digits when
// it is not one is a lie the caller cannot see.
fn date_format(y: i64, m: i64, d: i64, dst: u64) -> bool {
    if y < 0 || y > 9999 {
        return false
    }
    if !date_valid(y, m, d) {
        return false
    }
    put_digits(dst, 0, y, 4)
    *((dst + 4) as *mut u8) = 45 as u8
    put_digits(dst, 5, m, 2)
    *((dst + 7) as *mut u8) = 45 as u8
    put_digits(dst, 8, d, 2)
    return true
}

fn put_digits(dst: u64, at: usize, v: i64, n: usize) {
    var x: i64 = v
    var i: usize = n
    while i > 0 {
        i = i - 1
        *((dst + (at + i) as u64) as *mut u8) = (48 + (x % 10)) as u8
        x = x / 10
    }
}
