// SPDX-License-Identifier: MIT
// expect_out: date 29 checks passed
// demos/hub/date -- die Tests des Pakets, und sie sind sein `main`.
import date

static mut FAILED: i32 = 0
static mut DONE: i32 = 0

fn write_text(s: str) {
    syscall(1, 1, s.p as i64, s.n as i64, 0, 0, 0)
}

fn write_number(v: i64) {
    var buf: [u8; 24] = [0 as u8; 24]
    var x: i64 = v
    var negative: bool = false
    if x < 0 {
        negative = true
        x = 0 - x
    }
    var i: usize = 24
    if x == 0 {
        i = i - 1
        buf[i] = 48 as u8
    }
    while x > 0 {
        i = i - 1
        buf[i] = (48 + (x % 10)) as u8
        x = x / 10
    }
    if negative {
        i = i - 1
        buf[i] = 45 as u8
    }
    syscall(1, 1, (&buf[i]) as i64, (24 - i) as i64, 0, 0, 0)
}

fn check(what: bool) {
    DONE = DONE + 1
    if !what {
        FAILED = FAILED + 1
        write_text("date: check ")
        write_number(DONE as i64)
        write_text(" failed\n")
    }
}

fn formatted_is(y: i64, m: i64, d: i64, want: str) -> bool {
    var buf: [u8; 10] = [0 as u8; 10]
    if !date.date_format(y, m, d, (&buf[0]) as u64) {
        return false
    }
    if want.n != 10 {
        return false
    }
    var i: usize = 0
    while i < 10 {
        if buf[i] != *((want.p as u64 + i as u64) as *mut u8) {
            return false
        }
        i = i + 1
    }
    return true
}

fn main() -> i32 {
    // --- leap years
    check(date.date_is_leap(2024))
    check(!date.date_is_leap(2023))
    check(!date.date_is_leap(1900))
    check(date.date_is_leap(2000))
    check(date.date_days_in_month(2024, 2) == 29)
    check(date.date_days_in_month(1900, 2) == 28)
    check(date.date_days_in_month(2026, 4) == 30)
    check(date.date_days_in_month(2026, 13) == 0)

    // --- validity
    check(date.date_valid(2024, 2, 29))
    check(!date.date_valid(2023, 2, 29))
    check(!date.date_valid(2026, 0, 1))
    check(!date.date_valid(2026, 1, 0))

    // --- the epoch and a few dates that are known by heart
    check(date.date_to_days(1970, 1, 1) == 0)
    check(date.date_to_days(1969, 12, 31) == 0 - 1)
    check(date.date_to_days(2000, 3, 1) == 11017)
    check(date.date_to_days(2026, 8, 30) == 20695)

    // --- weekday: 1970-01-01 was a Thursday (4), 2026-08-30 a Sunday (0)
    check(date.date_weekday(1970, 1, 1) == 4)
    check(date.date_weekday(2026, 8, 30) == 0)
    check(date.date_weekday(1900, 1, 1) == 1)

    // --- round trip over 800 years, every day. If the shifted year is
    //     wrong anywhere, it is wrong here.
    var t: i64 = date.date_to_days(1600, 1, 1)
    let stop: i64 = date.date_to_days(2400, 1, 1)
    var bad: i64 = 0
    while t < stop {
        var y: i64 = 0
        var m: i64 = 0
        var d: i64 = 0
        date.date_from_days(t, &y, &m, &d)
        if date.date_to_days(y, m, d) != t {
            bad = bad + 1
        }
        if !date.date_valid(y, m, d) {
            bad = bad + 1
        }
        t = t + 1
    }
    check(bad == 0)

    // --- before the epoch as well
    var y2: i64 = 0
    var m2: i64 = 0
    var d2: i64 = 0
    date.date_from_days(0 - 1, &y2, &m2, &d2)
    check(y2 == 1969 && m2 == 12 && d2 == 31)
    date.date_from_days(0, &y2, &m2, &d2)
    check(y2 == 1970 && m2 == 1 && d2 == 1)

    // --- arithmetic
    var y3: i64 = 2024
    var m3: i64 = 2
    var d3: i64 = 28
    date.date_add_days(&y3, &m3, &d3, 1)
    check(y3 == 2024 && m3 == 2 && d3 == 29)
    date.date_add_days(&y3, &m3, &d3, 1)
    check(y3 == 2024 && m3 == 3 && d3 == 1)
    date.date_add_days(&y3, &m3, &d3, 0 - 366)
    check(y3 == 2023 && m3 == 3 && d3 == 1)

    // --- printing
    check(formatted_is(2026, 8, 30, "2026-08-30"))
    check(formatted_is(1, 1, 1, "0001-01-01"))
    var junk: [u8; 10] = [0 as u8; 10]
    check(!date.date_format(10000, 1, 1, (&junk[0]) as u64))
    check(!date.date_format(2023, 2, 29, (&junk[0]) as u64))

    if FAILED == 0 {
        write_text("date ")
        write_number(DONE as i64)
        write_text(" checks passed\n")
        return 0
    }
    return 1
}
