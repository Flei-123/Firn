# demos/hub/json -- eine echte kleine Bibliothek als Beleg fuer Runde FIRNHUB.
#
# 'main' zeigt hier auf die EIGENEN TESTS. Ein Paket mit 'main' laesst sich
# mit 'firnc --package' bauen und ausfuehren; damit wohnen die Tests einer
# Bibliothek in der Bibliothek. 'public json' haelt 'test' aus der
# Schnittstelle heraus: wer dieses Paket einbindet, sieht 'json' und sonst
# nichts.
package  json
version  1.0.0
main     test/main.fi
source   src
source   test
public   json
