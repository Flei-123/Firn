// SPDX-License-Identifier: MIT
// expect_out: json 26 checks passed
// demos/hub/json -- the tests of the package, and they are its `main`.
//
// A package with a `main` can be built and RUN with `firnc --package`
// (round 48). That is used here on purpose: the tests of a library live in
// the library, and `firnc --package demos/hub/json && demos/hub/json/json`
// runs them. `test` is a source directory of its own and `public json`
// keeps it out of everybody else's reach -- a project that depends on this
// package sees the interface and never the tests.
import json

static mut FAILED: i32 = 0
static mut DONE: i32 = 0

fn check(what: bool) {
    DONE = DONE + 1
    if !what {
        FAILED = FAILED + 1
        write_text("json: check ")
        write_number(DONE as i64)
        write_text(" failed\n")
    }
}

fn write_text(s: str) {
    let p: u64 = s.p as u64
    syscall(1, 1, p as i64, s.n as i64, 0, 0, 0)
}

fn write_number(v: i64) {
    var buf: [u8; 24] = [0 as u8; 24]
    var x: i64 = v
    var negative: bool = false
    if x < 0 {
        negative = true
        x = 0 - x
    }
    var i: usize = 24
    if x == 0 {
        i = i - 1
        buf[i] = 48 as u8
    }
    while x > 0 {
        i = i - 1
        buf[i] = (48 + (x % 10)) as u8
        x = x / 10
    }
    if negative {
        i = i - 1
        buf[i] = 45 as u8
    }
    syscall(1, 1, (&buf[i]) as i64, (24 - i) as i64, 0, 0, 0)
}

fn valid(s: str) -> bool {
    return json.json_valid(s.p as u64, s.n)
}

fn main() -> i32 {
    // --- whole documents
    check(valid("null"))
    check(valid("  true  "))
    check(valid("[1, 2, [3], {\"a\": null}]"))
    check(valid("{\"a\": \"b\\\"c\", \"d\": -1.5e10}"))
    check(valid("{}"))
    check(valid("[]"))
    check(!valid(""))
    check(!valid("{"))
    check(!valid("[1,]"))
    check(!valid("{\"a\" 1}"))
    check(!valid("01"))
    check(!valid("1."))
    check(!valid("nul"))
    check(!valid("[1] x"))

    // --- members
    let doc: str = "{\"name\": \"firn\", \"year\": 2026, \"tags\": [1,2], \"deep\": {\"in\": 7}}"
    let p: u64 = doc.p as u64
    var at: usize = 0
    check(json.json_member(p, doc.n, ("year".p) as u64, 4, &at) != json.JSON_BAD)
    var v: i64 = 0
    check(json.json_int(p, doc.n, at, &v))
    check(v == 2026)
    check(json.json_member(p, doc.n, ("gone".p) as u64, 4, &at) == json.JSON_BAD)

    // A nested object is ONE value: the member ends behind its closing brace.
    var ds: usize = 0
    let de: i64 = json.json_member(p, doc.n, ("deep".p) as u64, 4, &ds)
    check(de != json.JSON_BAD)
    check((de as usize) - ds == 9)

    // --- strings
    var dst: [u8; 32] = [0 as u8; 32]
    check(json.json_member(p, doc.n, ("name".p) as u64, 4, &at) != json.JSON_BAD)
    let w: i64 = json.json_string_copy(p, doc.n, at, (&dst[0]) as u64)
    check(w == 4)
    check(dst[0] == 102 as u8 && dst[3] == 110 as u8)

    let esc: str = "\"a\\nb\\\\c\""
    let w2: i64 = json.json_string_copy(esc.p as u64, esc.n, 0, (&dst[0]) as u64)
    check(w2 == 5)
    check(dst[1] == 10 as u8 && dst[3] == 92 as u8)

    // `\u` is refused, not half decoded.
    let uni: str = "\"a\\u0041\""
    check(json.json_string_copy(uni.p as u64, uni.n, 0, (&dst[0]) as u64) == json.JSON_BAD)

    if FAILED == 0 {
        write_text("json ")
        write_number(DONE as i64)
        write_text(" checks passed\n")
        return 0
    }
    return 1
}
