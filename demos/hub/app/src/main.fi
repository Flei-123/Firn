// SPDX-License-Identifier: MIT
// expect_out: firn 2026-08-30 Sunday
// demos/hub/app -- der Beweis der Runde FIRNHUB.
//
// Zwei Abhaengigkeiten, zwei verschiedene Wege:
//   json  ueber einen LOKALEN PFAD  (needs json ../json)
//   date  ueber eine GIT-QUELLE     (needs date git+file://...#v1.1.0)
//
// Im Quelltext sieht man den Unterschied nicht -- und genau das ist der
// Punkt. Der Compiler sieht in beiden Faellen ein Verzeichnis.
//
// KEIN `str` HIER, MIT ABSICHT. Ein Programm mit `str` zieht die
// Sammler-Laufzeit nach (Runde 70), und die zaehlt firnc0 als Datei
// AUSSERHALB jedes Pakets, waehrend firnc1 sie eingebaut mitbringt: die
// `outside`-Zeile von firn.lock kaeme dann bei den beiden Compilern
// verschieden heraus. Das ist ein Fund dieser Runde und steht in
// docs/ROUND-FIRNHUB.md; dieses Beweisprojekt geht ihm aus dem Weg, damit
// es das misst, was es messen soll.
import json
import date

fn out(p: u64, n: usize) {
    syscall(1, 1, p as i64, n as i64, 0, 0, 0)
}

fn copy_out(src: u64, n: usize, dst: u64) -> usize {
    var i: usize = 0
    while i < n {
        *((dst + i as u64) as *mut u8) = *((src + i as u64) as *mut u8)
        i = i + 1
    }
    return n
}

// Der Name des Wochentags in einen Puffer DES AUFRUFERS. Ein Zeiger auf das
// eigene Bild zurueckzugeben lehnt die Fluchtanalyse (Runde 75) ab, und sie
// hat recht: das Bild stirbt mit dem Rahmen.
fn day_name(w: i64, dst: u64) -> usize {
    var d0: [u8; 7] = "Sunday\0"
    var d1: [u8; 7] = "Monday\0"
    var d2: [u8; 8] = "Tuesday\0"
    var d3: [u8; 10] = "Wednesday\0"
    var d4: [u8; 9] = "Thursday\0"
    var d5: [u8; 7] = "Friday\0"
    var d6: [u8; 9] = "Saturday\0"
    if w == 0 {
        return copy_out((&d0[0]) as u64, 6, dst)
    }
    if w == 1 {
        return copy_out((&d1[0]) as u64, 6, dst)
    }
    if w == 2 {
        return copy_out((&d2[0]) as u64, 7, dst)
    }
    if w == 3 {
        return copy_out((&d3[0]) as u64, 9, dst)
    }
    if w == 4 {
        return copy_out((&d4[0]) as u64, 8, dst)
    }
    if w == 5 {
        return copy_out((&d5[0]) as u64, 6, dst)
    }
    return copy_out((&d6[0]) as u64, 8, dst)
}

fn main() -> i32 {
    var doc: [u8; 44] = "{\"name\": \"firn\", \"y\": 2026, \"m\": 8, \"d\": 30}"
    var k_name: [u8; 5] = "name\0"
    var k_y: [u8; 2] = "y\0"
    var k_m: [u8; 2] = "m\0"
    var k_d: [u8; 2] = "d\0"
    var space: [u8; 2] = " \0"
    var newline: [u8; 2] = "\n\0"
    let p: u64 = (&doc[0]) as u64
    let dn: usize = 44
    var at: usize = 0
    var name: [u8; 32] = [0 as u8; 32]
    if json.json_member(p, dn, (&k_name[0]) as u64, 4, &at) == json.JSON_BAD {
        return 1
    }
    let nn: i64 = json.json_string_copy(p, dn, at, (&name[0]) as u64)
    if nn < 0 {
        return 2
    }
    var y: i64 = 0
    var m: i64 = 0
    var d: i64 = 0
    if json.json_member(p, dn, (&k_y[0]) as u64, 1, &at) == json.JSON_BAD { return 3 }
    if !json.json_int(p, dn, at, &y) { return 4 }
    if json.json_member(p, dn, (&k_m[0]) as u64, 1, &at) == json.JSON_BAD { return 5 }
    if !json.json_int(p, dn, at, &m) { return 6 }
    if json.json_member(p, dn, (&k_d[0]) as u64, 1, &at) == json.JSON_BAD { return 7 }
    if !json.json_int(p, dn, at, &d) { return 8 }

    var stamp: [u8; 10] = [0 as u8; 10]
    if !date.date_format(y, m, d, (&stamp[0]) as u64) {
        return 9
    }
    out((&name[0]) as u64, nn as usize)
    out((&space[0]) as u64, 1)
    out((&stamp[0]) as u64, 10)
    out((&space[0]) as u64, 1)
    var wday: [u8; 10] = [0 as u8; 10]
    let wn: usize = day_name(date.date_weekday(y, m, d), (&wday[0]) as u64)
    out((&wday[0]) as u64, wn)
    out((&newline[0]) as u64, 1)
    return 0
}
