# demos/hub/app -- das Beweisprojekt der Runde FIRNHUB.
#
# 'json' kommt ueber einen LOKALEN PFAD, 'date' ueber eine GIT-QUELLE mit
# festem Etikett. Die Git-Adresse steht in firn.pkg.git-Vorlage und wird von
# tools/hub/run.sh eingesetzt, weil eine file://-Adresse den Pfad dieser
# Maschine enthaelt und in kein eingechecktes Manifest gehoert.
package  app
version  0.1.0
main     src/main.fi
source   src

needs    json  ../json  1.0.0
needs    date  ../date  1.1.0
