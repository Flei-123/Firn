// The audio thread (FIRN_AUDIO=device) needs the program's dispatcher.
fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == engine.AUDIO_KIND { return engine.audio_main(arg) }
    if kind == jobs.WORKER_KIND { return jobs.worker_main(arg) }
    return 0
}

const LOGIN_WAITS: i32 = 200
const FOG_R: u32 = 150
const FOG_G: u32 = 190
const FOG_B: u32 = 230
const BOX_RGBA: u32 = 0xFF000000
const TICK_MS: u64 = 50
const TP_QUIET_MS: u64 = 60 // > 1 server tick: Teleport Confirm and the following move must not share a server tick
const SC_ESC: u32 = 1
const SC_F: u32 = 33
const SC_N: u32 = 49
const SC_F11: u32 = 87
const SC_T: u32 = 20
const SC_M: u32 = 50
const SC_O: u32 = 24
const AUDIO_RATE: u32 = 44100
const PLACE_WAIT_MS: u64 = 1500
const ENT_TAU: f64 = 0.05
const ENT_SNAP: f64 = 8.0
const ENT_MAX_DIST: f64 = 96.0
const ENT_FAR_LOD: f64 = 40.0

fn now_ns() -> u64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return (ts[0] as u64) * 1000000000 as u64 + (ts[1] as u64)
}

fn now_ms() -> u64 {
    return now_ns() / 1000000 as u64
}

fn say(f: io.Fmt) {
    io.fmt_print(f)
}

// signed decimal of the C string at p; fallback on any other character
fn parse_dec(p: u64, n: usize, fallback: i64) -> i64 {
    if n == 0 {
        return fallback
    }
    var neg: bool = false
    var i: usize = 0
    if rt.ld8(p, 0) == 45 as u8 {
        neg = true
        i = 1
    }
    if i >= n {
        return fallback
    }
    var v: i64 = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c < 48 as u8 || c > 57 as u8 {
            return fallback
        }
        v = v * 10 + (c - 48 as u8) as i64
        i = i + 1
    }
    if neg {
        return 0 - v
    }
    return v
}

fn parse_ipv4(p: u64) -> u32 {
    let n: usize = rt.c_length(p)
    var parts: [i64; 4] = [0; 4]
    var k: usize = 0
    var cur: i64 = 0
    var digits: usize = 0
    var i: usize = 0
    while i <= n {
        var c: u8 = 46 as u8
        if i < n {
            c = rt.ld8(p, i)
        }
        if c == 46 as u8 {
            if digits == 0 || k >= 4 || cur > 255 {
                return 0 as u32
            }
            parts[k] = cur
            k = k + 1
            cur = 0
            digits = 0
        } else if c >= 48 as u8 && c <= 57 as u8 {
            cur = cur * 10 + (c - 48 as u8) as i64
            digits = digits + 1
        } else {
            return 0 as u32
        }
        i = i + 1
    }
    if k != 4 {
        return 0 as u32
    }
    return net.ipv4(parts[0] as u8, parts[1] as u8, parts[2] as u8, parts[3] as u8)
}

fn env_flag(name: str, fallback: bool) -> bool {
    if !env.has(name) {
        return fallback
    }
    let v: str = env.get(name)
    if v.length() == 0 {
        return fallback
    }
    return v.chars(0) == 49 as u8
}

fn env_int(name: str, fallback: i32) -> i32 {
    if !env.has(name) {
        return fallback
    }
    let v: str = env.get(name)
    return parse_dec(v.p as u64, v.length(), fallback as i64) as i32
}

// ---- command line: flags (--sky --box --hud --all) are skipped by argn/argp so the positional layout stays as before

fn path_buf(out: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(out, s.p as u64, s.n)
    var z: [u8; 1] = [0 as u8; 1]
    rt.buf_push_bytes(out, (&z[0]) as u64, 1)
}

// ---- graphics ------------------------------------------------------------------------------------

struct Gfx {
    atlas: mc_texture.Atlas,
    tb: mc_mesh.MeshTables,
    r: mc_raster.Raster,
    wr: mc_render_world.WorldRender,
    ok: bool,
    res: mc_packs.ResMgr,
    use_res: bool,
}

fn gfx_new(w: i32, h: i32, ver: *mut mc_version.Version, min_y: i32, view: i32, use_res: bool) -> Gfx {
    var atlas: mc_texture.Atlas = mc_texture.atlas_default()
    var tb: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    mc_texture.tex_alloc_tables(&tb)
    var reg: mc_registry.Registry = ver.registry_of()
    let ok: bool = mc_registry.registry_ok(&reg)
    var res: mc_packs.ResMgr = mc_packs.res_new()
    if ok {
        if use_res {
            mc_packs.res_build_tables(&res, &reg, &tb)
        } else {
            mc_texture.tex_build_tables(&reg, &tb)
        }
    }
    var r: mc_raster.Raster = mc_raster.raster_new(w, h)
    mc_raster.backend_upload_atlas(&r, &atlas)
    var wr: mc_render_world.WorldRender = mc_render_world.wr_new(min_y, view, &tb)
    return Gfx { atlas: atlas, tb: tb, r: r, wr: wr, ok: ok, res: res, use_res: use_res }
}

// Loads the packs (env) into the manager and uploads the atlas. Warnings go to stderr.
fn gfx_packs_load(g: *mut Gfx, protocol: i32) {
    mc_packs.res_setup_env(&(*g).res, protocol)
    gfx_packs_reload(g)
}

// Hot reload: re-reads the packs, new atlas, upload. Block tile ids do not change, so cached meshes stay valid.
fn gfx_packs_reload(g: *mut Gfx) -> i32 {
    var be: mc_backend.Backend = mc_backend.backend_cpu(&(*g).r)
    let n: i32 = mc_packs.res_reload_upload(&(*g).res, &be)
    if mc_packs.res_warn_count(&(*g).res) > 0 {
        let wt: str = mc_packs.res_warn_text(&(*g).res)
        io.eprint_line(wt)
    }
    return n
}

// Pick table: a block state is targetable when any face is drawn, solid = opaque (same as demos/mcview).
fn pick_tables(tb: *mut mc_mesh.MeshTables) -> mc_input.InputTables {
    let pk: u64 = rt.heap_alloc(32768)
    let so: u64 = rt.heap_alloc(32768)
    var id: usize = 0
    while id < 32768 {
        var any: u8 = 0 as u8
        var f: usize = 0
        while f < 6 {
            if rt.ld16((*tb).tiles, id * 6 + f) != 0 as u16 { any = 1 as u8 }
            f = f + 1
        }
        rt.st8(pk, id, any)
        rt.st8(so, id, rt.ld8((*tb).opaque, id))
        id = id + 1
    }
    return mc_input.InputTables { pick: pk, solid: so, n: 32768 }
}

// ---- game state ----------------------------------------------------------------------------------

struct Ctx {
    cl: mc_client.Client,
    world: mc_world.World,
    sc: mc_chunk.Scratch,
    dim: mc_dimension.Dimension,
    g: Gfx,
    itb: mc_input.InputTables,
    cam: mc_camera.Camera,
    sky: mc_sky.Sky,
    pl: mc_input.Player,
    rw: raw.Raw,
    win: window.Window,
    wp: *mut window.Window, // the window in use: &win (CPU) or &gw.win (GL)
    gl: bool,
    vk: bool, // MCPLAY_GFX=vk: be = the Vulkan back end table (vbk)
    vbk: vk_mc.VkBackend,
    vk_lost_at: u64, // MCPLAY_VK_LOST_AT: simulated device loss when n_frames reaches it (0 = off)
    vk_losses: u64,
    vk_recoveries: u64,
    gw: glwindow.GlWin,
    gb: gl_mc.GlBackend,
    gsc: gl_scene.Scene,
    sh: glshow.Show,
    be: mc_backend.Backend, // the GL back end table
    stm: mc_stream.Stream, // the world drawn by mc_stream (worker meshing, LOD rings) instead of g.wr (MCPLAY_STREAM=0)
    stream_on: bool,
    stm_live: bool,
    pool: jobs.Jobs, // mesher threads of the stream (blk 0 = none: inline)
    win_cx: i32, // camera column of the last window sync
    win_cz: i32,
    win_n: u32, // frames since the last window sync
    n_win: u64, // columns dropped / announced by the window sync
    t_stream: u64, // total ns in stream_frame (render thread: cull, submit, upload, draw)
    max_stream: u64, // longest stream_frame in ns
    lod: i32, // LOD radius in chunks (0 = off)
    pk: mc_input.Pick,
    bg: u64, // BGRX copy of the frame for the window
    w: i32,
    h: i32,
    view: i32,
    protocol: i32,
    // flags
    join: bool,
    have_pos: bool,
    last_tp: u64,
    tp_quiet_until: u64, // ms: no position packet before this (r197: the server needs a tick between Teleport Confirm and the next move)
    grab: bool,
    closed: bool,
    resized: bool,
    fullscreen: bool,
    hit: bool,
    creative: bool,
    // input accumulated between ticks
    acc_dx: f64,
    acc_dy: f64,
    // input diagnostics for the end line (all raw movement seen, F11 presses)
    tot_dx: f64,
    tot_dy: f64,
    n_f11: i32,
    want_fly: bool,
    want_noclip: bool,
    sent_slot: i32,
    // digging
    digging: bool,
    dig_x: i32,
    dig_y: i32,
    dig_z: i32,
    dig_t0: u64,
    dig_ms: u64,
    seq: i32,
    place_id: i32,
    ticks_day: i32,
    // light + time of day
    light: bool,
    wl: mc_wlight.WorldLight,
    region_done: bool,
    n_region_moves: u64,
    day_time: i64,
    day_fixed: bool,
    n_time: u64,
    // sound
    aud: bool,
    aud_thread: bool,
    aud_t0: u64,
    aud_owed: f64,
    aud_muted: bool,
    eng: *mut engine.Engine,
    bnk: *mut bank.Bank,
    snk: *mut sink.Sink,
    ma: *mut mc_audio.McAudio,
    wk: mc_audio.Walker,
    ents: mc_entity.Store,
    ents_on: bool, // MCPLAY_ENTITIES=0 switches the entity boxes off (packets are still tracked)
    entl: mc_entity_draw.EntList,
    ent_t: u64, // ns of the last interpolation step
    ent_peak: usize, // most entities tracked at once
    ent_vis_max: u32, // most entities that passed culling in one frame
    ent_boxes: u64, // boxes handed to the back end, all frames
    ent_frames: u64, // frames that drew at least one box
    ent_moving: u64, // sum over frames of entities still interpolating
    ent_resets: u64, // Respawn packets (store cleared)
    reg: mc_registry.Registry,
    pend_place: bool,
    pend_x: i32,
    pend_y: i32,
