    probe: bool,
    probe_i: i32,
    probe_next: u64,
    amb: mc_audio.Ambient,
    amb_x: f64,
    amb_dark: bool,
    n_amb: u64,
    // counters
    n_chunks: u64,
    n_unload: u64,
    n_biome_updates: u64,
    n_bchange: u64,
    n_mchange: u64,
    n_dig: u64,
    n_place: u64,
    n_ticks: u64,
    n_frames: u64,
    n_kick: u64,
    end_kind: i32,
    end_text: rt.Buf,
    fps: i32,
    // inventory + break time (mc_inv, mc_dig)
    inv: mc_inv.Inv,
    dg: mc_dig.DigData,
    rcp: mc_craft.Recipes, // recipe table of the version for the craft result prediction (mc_inv.inv_use_recipes)
    show_inv: bool,
    chat: mc_chat.Chat,
    chat_net: mc_chat_net.ChatNet,
    chat_ui: mc_chat_ui.ChatUi,
    tabl: mc_tablist.TabList,
    tab_log: bool,
    health: mc_health.Health,
    hudp: mc_hud_play.HudPlay,
    wfc: mc_water_fog.WaterFogColor,
    icons: mc_item_icon.IconCache,
    iui: mc_inv_ui.InvUi,
    idrag: mc_inv_drag.InvDrag,
    cui: mc_cont_ui.ContUi,
    cact: mc_cont_act.ContAct,
    trades: mc_trade.Trades,
    tui: mc_trade_ui.TradeUi,
    tact: mc_trade_act.TradeAct,
    cr: mc_creative.Creative,
    crui: mc_creative_ui.CrUi,
    cr_sdrag: bool,
    cr_logged: bool,
    shot_req: bool,
    shot_armed: bool,
    shot_n: i32,
    kb: mc_keybinds.Keybinds,
    weather: mc_weather.Weather,
    precip: mc_precip.Precip,
    lightning: mc_lightning.Lightning,
    splash: mc_splash.Splash,
    snowfall: mc_snowfall.Snowfall,
    snow_log_s: u64,
    wsnd: mc_weather_snd.WeatherSnd,
    combat: mc_combat.Combat,
    cfx: mc_combat_fx.CombatFx,
    tgt: mc_combat.Target,
    tgt_hit: bool, // an attackable entity is under the crosshair and nearer than the block pick
    combat_log: bool,
    hud_sig: i32,
    cbt_phase: i32, // MCPLAY_COMBAT_TEST script (attack / interact / use item on the entity under the crosshair)
    cbt_t: u64,
    chat_test_done: bool,
    tab_test_done: bool,
    cont_ui: bool, // the inventory panel was opened by a container window (chest ...): closes with it
    death_regrab: bool,
    ui_regrab: bool, // the mouse was captured when the panel opened: capture it again on close
    give_done: bool,
    dig_total: i32,
    fx: mc_effect.Fx, // own Haste / Mining Fatigue (Entity Effect packets)
    fx_ticks: i32, // last computed break time in ticks (with Efficiency / Haste / Fatigue) and without them
    fx_plain: i32,
    click_phase: i32, // MCPLAY_CLICK_TEST script (Click Container against a real server)
    click_t: u64,
    click_src: i32,
    ct4_phase: i32, // MCPLAY_CRAFT_TEST script (craft result prediction against a real server)
    ct4_t: u64,
    ct4_src: i32,
    ct4_n0: u32,
    ct2_phase: i32, // MCPLAY_CLICK_TEST2 script (shift click / drag / double click against a real server)
    ct2_t: u64,
    ct2_a: i32,
    ct2_b: i32,
    ct2_d: i32,
    ct3_phase: i32, // MCPLAY_CHEST_TEST script (open a chest next to the player, shift click / pick up / drag, close; checked against the server)
    ct3_t: u64,
    ct3_tries: i32,
    tt_phase: i32, // MCPLAY_TABLE_TEST script (crafting table 3x3: right click / shift click on the result, remainder items; checked against the server)
    tt_t: u64,
    tt_tries: i32,
    tt_n0: u32,
    st_phase: i32, // MCPLAY_SNEAK_TEST script (sneak + right click on a chest with a block in hand: the block is placed, the chest stays closed)
    st_t: u64,
    st_seen: i32, // state of the block that appeared above the chest
    st_x: i32,
    st_y: i32,
    st_z: i32,
    sneak_sent: bool, // last sneak state told to the server
    sprint_sent: bool,
    input_sent: u32,
    loaded_sent: bool, // Player Loaded (1.21.4+) sent
    n_loaded: u32, // Player Loaded packets sent
    loaded_base: u64, // n_chunks when the last Respawn arrived
    loaded_since: u64, // now_ms() of the last Respawn
    n_sneak: u32,
    ht_phase: i32, // MCPLAY_HASH_TEST script (hashed stacks: click a stack with components and a plain stack, count the server's re-sends)
    ht_t: u64,
    ht_a: i32,
    ht_b: i32,
    ht_n0: u32,
    ht_d: [i32; 4],
    last_click_slot: i32, // double click detection in the inventory panel
    last_click_t: u64,
    last_quick_item: i32,
    last_quick_sig: i32,
}

// ---- mc_stream mode (MCPLAY_STREAM / MCPLAY_LOD) -------------------------------------------------------

// Chunks the server is asked for: the LOD radius when LOD is on, else the view distance.
fn wire_view(c: *mut Ctx) -> i32 {
    return mc_view_sync.vs_wire((*c).view, (*c).lod)
}

// Fog / far plane distance in chunks.
fn far_view(c: *mut Ctx) -> i32 { return wire_view(c) }

// Address of the mesher pool for mc_stream (0 = inline).
fn pool_addr(c: *mut Ctx) -> u64 {
    if (*c).pool.blk == 0 { return 0 as u64 }
    return ((&(*c).pool) as *mut jobs.Jobs) as u64
}

// Window logic for far columns: the server sends its own radius (often > ours), the stream only keeps what can be drawn
// (view + 2, or the LOD window). Columns that left the window stay in the world and are announced again when the player returns.
// Runs when the camera column changed, else every 40 frames (cheap: a few hash lookups per loaded chunk).
static mut WIN_LAST_MS: u64 = 0 as u64
static mut WIN_GATE_MS: u64 = 500 as u64

fn stream_window_tick(c: *mut Ctx) {
    if !(*c).stream_on || !(*c).stm_live || !(*c).have_pos { return }
    (*c).win_n = (*c).win_n + 1 as u32
    let ccx: i32 = mc_world.block_to_chunk(math.floor((*c).cam.x) as i32)
    let ccz: i32 = mc_world.block_to_chunk(math.floor((*c).cam.z) as i32)
    let nowm: u64 = now_ms()
    if ccx == (*c).win_cx && ccz == (*c).win_cz && ((*c).win_n < 40 as u32 || nowm < WIN_LAST_MS + WIN_GATE_MS) { return }
    WIN_LAST_MS = nowm
    (*c).win_cx = ccx
    (*c).win_cz = ccz
    (*c).win_n = 0 as u32
    var be: mc_backend.Backend = cur_be(c)
    let n: usize = mc_stream.stream_window_sync(&(*c).stm, &(*c).world, &be, &(*c).cam, 2, 64, 64)
    (*c).n_win = (*c).n_win + n as u64
}

fn stream_time(c: *mut Ctx, ns: u64) {
    (*c).t_stream = (*c).t_stream + ns
    if ns > (*c).max_stream { (*c).max_stream = ns }
}

// Frees the stream (its meshes live in the CURRENT back end: call before the back end changes).
fn stream_release(c: *mut Ctx) {
    if !(*c).stream_on || !(*c).stm_live { return }
    var be: mc_backend.Backend = cur_be(c)
    mc_stream.stream_free(&(*c).stm, &be)
    (*c).stm_live = false
}

// New stream for the current dimension; every loaded column is announced again (join, resize).
fn stream_make(c: *mut Ctx) {
    if !(*c).stream_on { return }
    stream_release(c)
    (*c).stm = mc_stream.stream_new((*c).dim.min_y, mc_dimension.dim_sections(&(*c).dim) as i32, (*c).view, &(*c).g.tb, pool_addr(c))
    (*c).stm_live = true
    (*c).win_cx = 1000000
    (*c).win_cz = 1000000
    if (*c).lod > (*c).view { (*c).stm.lod_dist = (*c).lod }
    if env_flag("MCPLAY_TRANS", true) {
        mc_stream.stream_set_translucent(&(*c).stm, true, mc_texture.T_WATER, mc_texture.T_ICE, mc_texture.T_GLASS)
    }
    mc_stream.stream_set_look_flags(&(*c).stm, mc_opts.opts_look_flags(mc_pause.pause_opts()))
    if (*c).light { mc_stream.stream_set_light(&(*c).stm, true, ((&(*c).wl) as *mut mc_wlight.WorldLight) as u64) }
    // pack models: set before the columns are announced, so they are meshed once (the workers share the ModelSet, its bake is locked)
    (*c).stm.cull.graph_mode = env_flag("MCPLAY_CULL_GRAPH", true)
    WIN_GATE_MS = env_int("MCPLAY_WSYNC_MS", 500) as u64
    mc_stream.stream_set_lod_tint(&(*c).stm, env_flag("MCPLAY_LOD_TINT", true))
    if (*c).models_on { mc_stream.stream_set_models(&(*c).stm, ((&(*c).ms) as *mut mc_model_mesh.ModelSet) as u64) }
    var i: usize = 0
    while i < mc_world.world_count(&(*c).world) {
        let ch: *mut mc_chunk.Chunk = mc_world.world_chunk_at(&(*c).world, i)
        let okc: bool = mc_stream.stream_chunk_loaded(&(*c).stm, &(*c).world, (*ch).x, (*ch).z)
        i = i + 1
    }
}

// The light region follows the player: dirties the sections of the old and the new region (counterpart of wr_region_follow).
fn stream_region_follow(c: *mut Ctx, pcx: i32, pcz: i32) -> i32 {
    let wl: *mut mc_wlight.WorldLight = &(*c).wl
    let was_on: bool = mc_wlight.wl_active(wl)
    let ox0: i32 = (*wl).cx0
    let oz0: i32 = (*wl).cz0
    let ox1: i32 = ox0 + (*wl).ncx
    let oz1: i32 = oz0 + (*wl).ncz
    let r: i32 = mc_wlight.wl_region_recenter(wl, &(*c).world, pcx, pcz, 5, 5, 1, true)
    if r == 0 { return 0 }
    var x0: i32 = (*wl).cx0
    var z0: i32 = (*wl).cz0
    var x1: i32 = x0 + (*wl).ncx
    var z1: i32 = z0 + (*wl).ncz
    if was_on {
        if ox0 < x0 { x0 = ox0 }
        if oz0 < z0 { z0 = oz0 }
        if ox1 > x1 { x1 = ox1 }
        if oz1 > z1 { z1 = oz1 }
    }
    var cz: i32 = z0
    while cz < z1 {
        var cx: i32 = x0
        while cx < x1 {
            var sy: i32 = 0
            while sy < (*wl).nsec {
                mc_stream.stream_mark_section(&(*c).stm, cx, sy, cz)
                sy = sy + 1
            }
            cx = cx + 1
        }
        cz = cz + 1
    }
    return r
}

fn mark_air(c: *mut Ctx, x: i32, y: i32, z: i32, id: i32) {
    var old: i32 = 0
    if (*c).light {
        old = mc_wlight.wl_edit(&(*c).wl, &(*c).world, x, y, z, id)
    } else {
        old = mc_blockset.world_set_block(&(*c).world, (*c).dim.min_y, x, y, z, id)
    }
    if old >= 0 && old != id {
        if (*c).stream_on {
            mc_stream.stream_mark_block(&(*c).stm, x, y, z)
            if (*c).light { mc_stream.stream_light_sync(&(*c).stm) }
        } else {
            mc_render_world.wr_mark_block(&(*c).g.wr, x, y, z)
            if (*c).light { mc_render_world.wr_light_sync(&(*c).g.wr) }
        }
    }
}

fn on_map_chunk(c: *mut Ctx) {
    let p: u64 = mc_chunk.chunk_alloc()
    if p == 0 { return }
    let ch: *mut mc_chunk.Chunk = p as *mut mc_chunk.Chunk
    let td: u64 = mc_prof.prof_active_now()
    let ok: bool = mc_chunk.chunk_decode_for(&(*c).cl.ver, mc_client.client_body(&(*c).cl), &(*c).sc, ch, mc_dimension.dim_sections(&(*c).dim)) catch false
    mc_prof.prof_add(mc_prof.PH_NCHDEC, mc_prof.prof_active_now() - td)
    if !ok || (*ch).ground_up == 0 {
        mc_chunk.chunk_release(p)
        return
    }
    let cx: i32 = (*ch).x
    let cz: i32 = (*ch).z
    let tp: u64 = mc_prof.prof_active_now()
    if !mc_world.world_put(&(*c).world, p) {
        mc_chunk.chunk_release(p)
        return
    }
    if (*c).stream_on {
        let okc: bool = mc_stream.stream_chunk_loaded(&(*c).stm, &(*c).world, cx, cz)
    } else {
        mc_render_world.wr_mark_chunk(&(*c).g.wr, cx, cz)
    }
    mc_prof.prof_add(mc_prof.PH_NCHPUT, mc_prof.prof_active_now() - tp)
    (*c).n_chunks = (*c).n_chunks + 1 as u64
}

fn on_unload(c: *mut Ctx) {
    let b: *mut bytes.Bytes = mc_client.client_body(&(*c).cl)
    let first: i32 = bytes.get_i32(b) catch 0
    let second: i32 = bytes.get_i32(b) catch 0
    var cx: i32 = first
    var cz: i32 = second
    if (*c).cl.ver.protocol >= 764 {
        cx = second
        cz = first
    }
    if (*c).stream_on {
        var sbe: mc_backend.Backend = cur_be(c)
        mc_stream.stream_chunk_unloaded(&(*c).stm, &sbe, cx, cz)
    } else if (*c).gl || (*c).vk {
        mc_render_world.wr_drop_chunk_b(&(*c).g.wr, &(*c).be, cx, cz)
    } else {
        mc_render_world.wr_drop_chunk(&(*c).g.wr, &(*c).g.r, cx, cz)
    }
    if mc_world.world_remove(&(*c).world, cx, cz) {
        (*c).n_unload = (*c).n_unload + 1 as u64
    }
}

fn on_chunk_biomes(c: *mut Ctx) {
    let out: u64 = rt.heap_alloc(mc_biome_update.BIOME_UPDATE_MAX * 8)
    if out == 0 { return }
    let n: usize = mc_biome_update.biome_apply_packet(&(*c).world, &(*c).sc, mc_client.client_body(&(*c).cl), out)
    var i: usize = 0
    while i < n {
        let cx: i32 = mc_biome_update.biome_update_x(out, i)
        let cz: i32 = mc_biome_update.biome_update_z(out, i)
        if (*c).stream_on {
            mc_stream.stream_mark_biomes(&(*c).stm, cx, cz, mc_dimension.dim_sections(&(*c).dim))
        } else {
            mc_render_world.wr_mark_chunk(&(*c).g.wr, cx, cz)
        }
        i = i + 1
    }
    (*c).n_biome_updates = (*c).n_biome_updates + n as u64
    if n > 0 && env_flag("MCPLAY_BIOME_LOG", false) { say(f"mcplay: biomes updated chunks={n} total={(*c).n_biome_updates}\n") }
    rt.heap_free(out, mc_biome_update.BIOME_UPDATE_MAX * 8)
}

fn on_block_change(c: *mut Ctx) {
    var x: i32 = 0
    var y: i32 = 0
    var z: i32 = 0
    var s: i32 = 0
    if mc_play.decode_block_change(mc_client.client_body(&(*c).cl), &x, &y, &z, &s) {
        if env_flag("MCPLAY_DEBUG", false) { say(f"mcplay: dbg block_change {x},{y},{z} s={s} pend={(*c).pend_place} pend_at={(*c).pend_x},{(*c).pend_y},{(*c).pend_z}\n") }
        if (*c).aud && (*c).pend_place && s > 0 && x == (*c).pend_x && y == (*c).pend_y && z == (*c).pend_z {
            (*c).pend_place = false
            if now_ms() - (*c).pend_t < PLACE_WAIT_MS {
                if mc_audio.mca_block_sound((*c).ma, &(*c).reg, s, mc_audio.ACT_PLACE, x, y, z) != 0 as u32 { (*c).n_snd = (*c).n_snd + 1 as u64 }
            }
        }
        if (*c).st_phase == 2 && x == (*c).st_x && y == (*c).st_y && z == (*c).st_z && s > 0 { (*c).st_seen = s }
        mark_air(c, x, y, z, s)
        (*c).n_bchange = (*c).n_bchange + 1 as u64
    }
}

fn on_multi_change(c: *mut Ctx) {
    let b: *mut bytes.Bytes = mc_client.client_body(&(*c).cl)
    var x0: i32 = 0
    var y0: i32 = 0
    var z0: i32 = 0
    let n: i32 = mc_play.multi_begin(b, (*c).cl.ver.protocol, &x0, &y0, &z0)
    var i: i32 = 0
    while i < n {
        var x: i32 = 0
        var y: i32 = 0
        var z: i32 = 0
        var s: i32 = 0
        if !mc_play.multi_next(b, x0, y0, z0, &x, &y, &z, &s) { return }
        mark_air(c, x, y, z, s)
        i = i + 1
    }
    (*c).n_mchange = (*c).n_mchange + 1 as u64
}

// update_time: i64 world age, i64 time of day (negative = daylight cycle off, |value| is the fixed time).
fn on_time(c: *mut Ctx) {
    let b: *mut bytes.Bytes = mc_client.client_body(&(*c).cl)
    let age: i64 = bytes.get_i64(b) catch 0
    let tm: i64 = bytes.get_i64(b) catch 0
    if tm < 0 {
        (*c).day_fixed = true
        (*c).day_time = 0 - tm
    } else {
        (*c).day_fixed = false
        (*c).day_time = tm
    }
    (*c).n_time = (*c).n_time + 1 as u64
    sky_apply(c)
}

// Vertex light: the lit mesher needs the filter/emit tables of the registry; Chunk.light supplies the server light of every column,
// the region volume (light_region_tick) makes edits repair the light incrementally.
fn light_setup(c: *mut Ctx) {
    mc_wlight.wl_free(&(*c).wl)
    (*c).wl = mc_wlight.wl_new((*c).dim.min_y, mc_dimension.dim_sections(&(*c).dim) as i32)
    var reg: mc_registry.Registry = (*c).cl.ver.registry_of()
    if mc_registry.registry_ok(&reg) { mc_wlight.wl_set_tables_registry(&(*c).wl, &reg) }
    mc_render_world.wr_set_light(&(*c).g.wr, ((&(*c).wl) as *mut mc_wlight.WorldLight) as u64)
    if (*c).stream_on && (*c).stm_live { mc_stream.stream_set_light(&(*c).stm, true, ((&(*c).wl) as *mut mc_wlight.WorldLight) as u64) }
}

// Once enough columns arrived: a 5x5 column region that FOLLOWS the player (hysteresis 1 column, server light wins) so that block
// edits repair the light incrementally; memory stays bounded however far the player walks. A move dirties the cached sections of
// the old and the new region (mc_render_world.wr_region_follow).
fn light_region_tick(c: *mut Ctx) {
    if !(*c).light || !(*c).have_pos { return }
    if !(*c).region_done && (*c).n_chunks < 25 as u64 { return }
    let cx: i32 = mc_world.block_to_chunk(math.floor((*c).pl.x) as i32)
    let cz: i32 = mc_world.block_to_chunk(math.floor((*c).pl.z) as i32)
    var r: i32 = 0
    if (*c).stream_on {
        r = stream_region_follow(c, cx, cz)
    } else {
        r = mc_render_world.wr_region_follow(&(*c).g.wr, &(*c).world, cx, cz, 5, 5, 1, true)
    }
    if r != 0 { (*c).region_done = true }
    if r == 1 { (*c).n_region_moves = (*c).n_region_moves + 1 as u64 }
}

// One packet.
// Join Game / Respawn: the hashed world seed drives the vanilla Voronoi biome zoom of the model tints (mc_biome_zoom). Versions whose packet has no
// `hashedSeed` field keep the plain 4x4x4 cell biome.
fn apply_hashed_seed(c: *mut Ctx, id: i32) {
    if !(*c).models_on || env_int("MCPLAY_BIOME_ZOOM", 1) == 0 { return }
    let cl: *mut mc_client.Client = &(*c).cl
    let sch: u64 = (*cl).ver.schema_of(mc_version.ST_PLAY, mc_version.DIR_S2C, id)
    if sch == 0 { return }
    let body: *mut bytes.Bytes = mc_client.client_body(cl)
    var off: usize = 0
    var len: usize = 0
    if !mc_schema.field_range(sch, "hashedSeed".p as u64, 10, body, &off, &len) || len != 8 { return }
    var v: bytes.Bytes = bytes.Bytes { data: bytes.bytes_ptr(body) + off as u64, cap: 8, len: 8, pos: 0, bad: false }
    let seed: i64 = bytes.get_i64(&v) catch 0
    mc_model_mesh.ms_set_seed(&(*c).ms, seed)
}

fn health_sig(h: *mut mc_health.Health) -> u64 {
    return (*h).n_updates + (*h).n_deaths * 1000 as u64 + (*h).n_alive * 1000000 as u64 + (mc_health.health_message_len(h) as u64) * 1000000000 as u64
}

static mut VLIGHT: i32 = 0 - 1

fn light_day(c: *mut Ctx) -> i32 {
    if VLIGHT < 0 {
        VLIGHT = 0
        if env_flag("MCPLAY_VLIGHT", true) { VLIGHT = 1 }
    }
    if VLIGHT == 0 { return (*c).sky.daylight }
    let rain: i32 = mc_weather.weather_rain_milli(&(*c).weather) * 256 / 1000
    let thunder: i32 = mc_weather.weather_thunder_milli(&(*c).weather) * 256 / 1000
    return mc_skylight.skylight_vanilla_day((*c).day_time, rain, thunder)
}

fn sky_apply(c: *mut Ctx) {
    mc_sky.sky_set_time(&(*c).sky, (*c).day_time, mc_weather.weather_sky_rain(&(*c).weather))
    mc_sky.sky_set_thunder(&(*c).sky, mc_weather.weather_thunder_milli(&(*c).weather))
    mc_sky.sky_set_flash(&(*c).sky, mc_lightning.lightning_flash_milli(&(*c).lightning, now_ms()))
}

fn weather_tick(c: *mut Ctx) {
    if !(*c).have_pos { return }
    let t: u64 = now_ms()
    if mc_weather.weather_active(&(*c).weather) {
        mc_precip.precip_update(&(*c).precip, &(*c).world, &(*c).reg, (*c).dim.min_y, (*c).pl.x, (*c).pl.y + mc_input.player_eye(&(*c).pl), (*c).pl.z, t)
        mc_weather.weather_set_local(&(*c).weather, (*c).precip.kind, (*c).precip.exposure)
    }
    mc_splash.splash_update(&(*c).splash, &(*c).precip, &(*c).world, &(*c).reg, (*c).dim.min_y, (*c).pl.x, (*c).pl.y + mc_input.player_eye(&(*c).pl), (*c).pl.z,
        mc_weather.weather_rain_milli(&(*c).weather), (*c).precip.kind, t)
    mc_snowfall.snowfall_update(&(*c).snowfall, &(*c).precip, &(*c).world, &(*c).reg, (*c).dim.min_y, (*c).pl.x, (*c).pl.y + mc_input.player_eye(&(*c).pl), (*c).pl.z,
        mc_weather.weather_rain_milli(&(*c).weather), (*c).precip.kind, t)
    if t / 1000 as u64 != (*c).snow_log_s && env_flag("MCPLAY_SNOW_LOG", false) {
        (*c).snow_log_s = t / 1000 as u64
        say(f"mcplay: snowlog kind={(*c).precip.kind} rain={mc_weather.weather_rain_milli(&(*c).weather)} live={mc_snowfall.snowfall_live(&(*c).snowfall, t)} spawned={(*c).snowfall.n_spawned}\n")
    }
    let nb: usize = mc_lightning.lightning_poll(&(*c).lightning, &(*c).ents, &(*c).reg, t)
    mc_entity_draw.entlist_set_bolt_type(&(*c).entl, (*c).lightning.bolt_type)
    if nb > 0 && env_flag("MCPLAY_WEATHER_LOG", false) {
        say(f"mcplay: lightning new={nb} total={(*c).lightning.n_bolts}\n")
    }
    if !(*c).aud { return }
    var i: usize = 0
    while i < nb {
        mc_weather_snd.wsnd_bolt((*c).ma, &(*c).wsnd, (*c).lightning.nx[i], (*c).lightning.ny[i], (*c).lightning.nz[i])
        i = i + 1
    }
    mc_weather_snd.wsnd_tick((*c).ma, &(*c).wsnd, &(*c).weather, &(*c).precip, 0.05)
}

fn on_weather(c: *mut Ctx, id: i32) {
    if !mc_weather.weather_on_packet(&(*c).weather, &(*c).cl, id) { return }
    if (*c).n_time > 0 as u64 { sky_apply(c) }
    if env_flag("MCPLAY_WEATHER_LOG", false) {
        let w: *mut mc_weather.Weather = &(*c).weather
        say(f"mcplay: weather raining={(*w).raining} rain={(*w).rain} thunder={(*w).thunder} kind={(*w).kind} exposure={(*w).exposure} events={(*w).n_events}\n")
    }
}

fn on_health(c: *mut Ctx, id: i32) {
    let h: *mut mc_health.Health = &(*c).health
    let before: u64 = health_sig(h)
    let hp0: i32 = (*h).hp
    let dead0: bool = (*h).dead
    mc_health.health_on_packet(h, &(*c).chat_net, &(*c).cl, id, now_ms())
    if (*c).aud && ((*h).hp < hp0 || (*h).dead != dead0) && hp0 > 0 {
        mc_snd_events.sev_hurt((*c).ma, &(*c).sev, 16, (*c).cl.ver.protocol, (*h).dead, (*c).pl.x, (*c).pl.y, (*c).pl.z)
    }
    if health_sig(h) == before || !env_flag("MCPLAY_HEALTH_LOG", false) { return }
    let msg: str = str { p: mc_health.health_message_ptr(h) as *u8, n: mc_health.health_message_len(h) }
    say(f"mcplay: health hp={(*h).hp} food={(*h).food} dead={(*h).dead} deaths={(*h).n_deaths} alive={(*h).n_alive} respawn_sent={(*h).n_respawn_sent} msg={msg}\n")
}

fn log_combat_hud(c: *mut Ctx) {
    if !(*c).combat_log { return }
    let sig: i32 = mc_combat_fx.cfx_hud_sig(&(*c).cfx)
    if sig == (*c).hud_sig { return }
    (*c).hud_sig = sig
    say(f"mcplay: combat hud tint_frames={(*c).cfx.n_tint_frames} offhand_frames={(*c).cfx.n_offhand_frames} use_max={(*c).cfx.use_max}\n")
}

fn on_combat_fx(c: *mut Ctx, id: i32) {
    let fx: *mut mc_combat_fx.CombatFx = &(*c).cfx
    let before: u64 = (*fx).n_hurts + (*fx).n_knocks
    mc_combat_fx.cfx_on_packet(fx, &(*c).cl, (*c).fx.own, id, now_ms())
    if (*fx).n_hurts + (*fx).n_knocks == before || !(*c).combat_log { return }
    say(f"mcplay: combat fx hurts={(*fx).n_hurts} hits={(*fx).n_hits} self_hurts={(*fx).n_self_hurts} knocks={(*fx).n_knocks}\n")
}

fn on_packet(c: *mut Ctx, id: i32) {
    let cl: *mut mc_client.Client = &(*c).cl
    on_health(c, id)
    mc_hud_play.hp_on_packet(&(*c).hudp, &(*c).chat_net, &(*c).cl, &(*c).health, id, now_ms())
    on_weather(c, id)
    on_combat_fx(c, id)
    if mc_client.client_auto_reply(cl, id) {
    } else if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_JOIN_GAME) {
        if !(*c).join {
            (*c).join = true
            mc_hud_play.hp_open(&(*c).hudp, (*cl).ver.protocol, env_flag("MCPLAY_VANILLA_HUD", true))
            if env_flag("MCPLAY_ENTITY_SKINS", true) { mc_entity_draw.entlist_open_skins(&(*c).entl, (*cl).ver.protocol) }
            if env_flag("MCPLAY_ITEM_ICONS", true) && mc_item_icon.icons_open(&(*c).icons, (*cl).ver.protocol, mc_registry.reg_item_count(&(*c).reg)) { mc_inv_ui.iui_open(&(*c).iui, mc_item_icon.icons_src(&(*c).icons)); mc_cont_ui.cui_open(&(*c).cui, mc_item_icon.icons_src(&(*c).icons)); mc_trade_ui.tui_open(&(*c).tui, mc_item_icon.icons_src(&(*c).icons)); mc_creative_ui.crui_open(&(*c).crui, mc_item_icon.icons_src(&(*c).icons)) }
            mc_effect.fx_own_from_join(&(*c).fx, mc_client.client_body(cl))
            mc_dimension.dim_from_join(&(*cl).ver, id, mc_client.client_body(cl), &(*c).dim)
            apply_hashed_seed(c, id)
            (*c).g.wr.min_y = (*c).dim.min_y
            stream_make(c)
            if (*c).light { light_setup(c) }
            mc_client.client_send_settings(cl, wire_view(c))
        }
    } else if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_MAP_CHUNK) {
        on_map_chunk(c)
    } else if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_UNLOAD_CHUNK) {
        on_unload(c)
    } else if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_CHUNK_BIOMES) {
        on_chunk_biomes(c)
    } else if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_BLOCK_CHANGE) {
        on_block_change(c)
    } else if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_MULTI_BLOCK_CHANGE) {
        on_multi_change(c)
    } else if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_BLOCK_BREAK_ANIMATION) {
        mc_crack_anim.crack_anims_on_packet(&(*c).cra, mc_client.client_body(cl), now_ms())
    } else if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_UPDATE_TIME) {
        on_time(c)
    } else if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_KICK_DISCONNECT) {
        (*c).n_kick = (*c).n_kick + 1 as u64
        (*c).end_kind = END_KICK
        rt.buf_clear(&(*c).end_text)
        mc_chat_net.component_plain(&(*c).chat_net, cl, id, "reason", &(*c).end_text)
        (*c).closed = true
    } else if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_ENTITY_EFFECT) {
        mc_effect.fx_on_effect(&(*c).fx, (*cl).ver.protocol, mc_client.client_body(cl))
    } else if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_REMOVE_ENTITY_EFFECT) {
        mc_effect.fx_on_remove(&(*c).fx, (*cl).ver.protocol, mc_client.client_body(cl))
    } else if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_SET_CURSOR_ITEM) {
        mc_inv.inv_set_efficiency_id(&(*c).inv, mc_client.client_enchant_efficiency(cl))
        mc_inv.inv_set_enchant_keys(&(*c).inv, mc_client.client_enchant_keys(cl), mc_client.client_enchant_count(cl))
        mc_inv.inv_on_set_cursor_v(&(*c).inv, &(*cl).ver, mc_client.client_body(cl))
    } else if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_WINDOW_ITEMS) {
        dump_raw_inv("items", (*cl).ver.protocol, mc_client.client_body(cl))
        mc_inv.inv_set_efficiency_id(&(*c).inv, mc_client.client_enchant_efficiency(cl))
        mc_inv.inv_set_enchant_keys(&(*c).inv, mc_client.client_enchant_keys(cl), mc_client.client_enchant_count(cl))
        mc_inv.inv_on_window_items_v(&(*c).inv, &(*cl).ver, mc_client.client_body(cl))
    } else if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_TRADE_LIST) {
        mc_trade.tr_on_list(&(*c).trades, &(*cl).ver, mc_client.client_body(cl))
        if cont_log(c) { say(f"mcplay: trades win={mc_trade.tr_window(&(*c).trades)} n={mc_trade.tr_count(&(*c).trades)} level={mc_trade.tr_level(&(*c).trades)} xp={mc_trade.tr_xp(&(*c).trades)} t0={mc_trade.tr_item_a(&(*c).trades, 0)}x{mc_trade.tr_cost_a(&(*c).trades, 0)} base0={mc_trade.tr_base_a(&(*c).trades, 0)} cost0={mc_trade.tr_cost_a(&(*c).trades, 0)} ->{mc_trade.tr_item_r(&(*c).trades, 0)}x{mc_trade.tr_count_r(&(*c).trades, 0)}\n") }
    } else if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_OPEN_WINDOW) {
        mc_trade.tr_clear(&(*c).trades)
        mc_inv.inv_on_open_window_v(&(*c).inv, &(*cl).ver, mc_client.client_body(cl))
    } else if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_CRAFT_PROGRESS_BAR) {
        mc_inv.inv_on_property(&(*c).inv, &(*cl).ver, mc_client.client_body(cl))
    } else if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_OPEN_HORSE_WINDOW) {
        mc_inv.inv_on_open_horse(&(*c).inv, &(*cl).ver, mc_client.client_body(cl))
    } else if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_CLOSE_WINDOW) {
        mc_trade.tr_clear(&(*c).trades)
        mc_inv.inv_on_close_window_v(&(*c).inv, &(*cl).ver, mc_client.client_body(cl))
    } else if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_SET_SLOT) {
        dump_raw_inv("slot", (*cl).ver.protocol, mc_client.client_body(cl))
        mc_inv.inv_set_efficiency_id(&(*c).inv, mc_client.client_enchant_efficiency(cl))
        mc_inv.inv_set_enchant_keys(&(*c).inv, mc_client.client_enchant_keys(cl), mc_client.client_enchant_count(cl))
        mc_inv.inv_on_set_slot_v(&(*c).inv, &(*cl).ver, mc_client.client_body(cl))
    } else if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_RESPAWN) {
        // new dimension: the old entities are gone (the server sends no destroy for them)
        apply_hashed_seed(c, id)
        mc_entity.store_clear(&(*c).ents)
        mc_lightning.lightning_reset(&(*c).lightning)
        mc_splash.splash_reset(&(*c).splash)
        mc_snowfall.snowfall_reset(&(*c).snowfall)
        (*c).ent_resets = (*c).ent_resets + 1 as u64
        (*c).loaded_sent = false
        (*c).loaded_base = (*c).n_chunks
        (*c).loaded_since = now_ms()
        (*c).sneak_sent = false
        (*c).sprint_sent = false
        (*c).input_sent = 0 as u32
    } else if on_chat(c, id) {
    } else if on_tab(c, id) {
    } else if mc_entity.entity_on_packet(&(*c).ents, &(*cl).ver, id, mc_client.client_body(cl)) {
        let n: usize = mc_entity.store_count(&(*c).ents)
        if n > (*c).ent_peak { (*c).ent_peak = n }
    } else if (*c).aud {
        if mc_audio.mca_on_packet((*c).ma, &(*cl).ver, id, mc_client.client_body(cl), &(*c).ents) {
            (*c).n_snd_pkt = (*c).n_snd_pkt + 1 as u64
        }
    }
}

// Applies waiting packets (at most `limit`, stops at the first timeout). false = connection lost.
fn net_drain(c: *mut Ctx, limit: i32, budget_ns: u64) -> bool {
    var n: i32 = 0
    let t0: u64 = now_ns()
    while n < limit {
        let id: i32 = mc_client.client_next(&(*c).cl)
        if id == mc_client.CL_TIMEOUT { break }
        if id < 0 {
            if (*c).end_kind == END_QUIT && !(*c).closed {
                (*c).end_kind = END_LOST
                rt.buf_clear(&(*c).end_text)
                let why: str = mc_client.client_error_text(id)
                rt.buf_push_bytes(&(*c).end_text, why.p as u64, why.n)
            }
            return false
        }
        on_packet(c, id)
        n = n + 1
        if mc_net_budget.nb_over(t0, now_ns(), budget_ns) { break }
    }
    mc_prof.prof_add(mc_prof.PH_NPKTS, n as u64)
    return true
}

// ---- events ----------------------------------------------------------------------------------------

fn grab_mouse(c: *mut Ctx, on: bool) {
    if on {
        (*c).grab = window.cursor_mode((*c).wp, window.CURSOR_CAPTURED)
        if !(*c).grab { say(f"mcplay: mouse grab refused\n") }
    } else {
        window.cursor_mode((*c).wp, window.CURSOR_NORMAL)
        (*c).grab = false
    }
}

fn focus_loss_apply(c: *mut Ctx) {
    if !(*c).focus_lost { return }
    (*c).focus_lost = false
    say(f"mcplay: window focus lost grab={(*c).grab} pause_active={mc_pause.pause_active()}\n")
    let plan: u32 = mc_focus.focus_loss_plan((*c).grab, mc_pause.pause_active(), mc_pause.pause_ready((*c).protocol), (*c).chat.open, (*c).show_inv, (*c).health.dead)
    if (plan & mc_focus.FL_RELEASE) != 0 as u32 { grab_mouse(c, false) }
    if (plan & mc_focus.FL_PAUSE) != 0 as u32 {
        mc_pause.pause_bind_keys(&(*c).kb)
        mc_pause.pause_open()
    }
}

// Own event pump (raw.raw_pump drops EV_CONFIGURE / EV_CLOSED): keys + mouse go to raw_feed, resize / close are noted, the captured
// pointer's relative movement is accumulated until the next tick.
fn pump(c: *mut Ctx) {
    raw.raw_begin(&(*c).rw)
    var k: u32 = window.next_event((*c).wp)
    var guard: i32 = 0
    while k != window.EV_NONE && guard < 20000 {
        guard = guard + 1
        if k == window.EV_CHAR {
            mc_chat_ui.chat_ui_char(&(*c).chat, &(*c).chat_ui, window.ev_a((*c).wp), chat_allowed(c))
            anvil_char(c, window.ev_a((*c).wp))
            if cr_active(c) { mc_creative.cr_query_push(&(*c).cr, &(*c).reg, window.ev_a((*c).wp)) }
        }
        if k == window.EV_FOCUS && window.ev_a((*c).wp) == 0 as u32 {
            (*c).focus_lost = true
        }
        if k == window.EV_CONFIGURE {
            (*c).resized = true
        } else if k == window.EV_CLOSED {
            (*c).closed = true
        } else {
            raw.raw_feed(&(*c).rw, k, window.ev_a((*c).wp), window.ev_x((*c).wp), window.ev_y((*c).wp), window.ev_state((*c).wp))
        }
        k = window.next_event((*c).wp)
    }
    var d: [i64; 2] = [0; 2]
    if window.cursor_delta((*c).wp, (&d[0]) as u64) {
        (*c).tot_dx = (*c).tot_dx + (d[0] as f64)
        (*c).tot_dy = (*c).tot_dy + (d[1] as f64)
        if (*c).grab {
            (*c).acc_dx = (*c).acc_dx + (d[0] as f64)
            (*c).acc_dy = (*c).acc_dy + (d[1] as f64)
        }
    }
    raw.raw_end(&(*c).rw)
    chat_pump_end(c)
}

fn chat_allowed(c: *mut Ctx) -> bool {
    return !(*c).show_inv && !(*c).health.dead && !mc_pause.pause_active()
}

fn chat_pump_end(c: *mut Ctx) {
    let ch: *mut mc_chat.Chat = &(*c).chat
    let k: i32 = mc_chat_ui.chat_ui_keys(ch, &(*c).chat_ui, &(*c).kb, &(*c).rw, chat_allowed(c))
    if (*ch).open && !(*ch).was_open {
        (*ch).was_open = true
        (*ch).regrab = (*c).grab
        if (*c).grab { grab_mouse(c, false) }
    }
    if (k & mc_chat_ui.CK_SUBMIT) != 0 { mc_chat_net.chat_send_input(ch, &(*c).cl) }
    if (k & mc_chat_ui.CK_TAB) != 0 { mc_chat_complete.complete_press(ch, &(*c).chat_ui.sugg, &(*c).cl, &(*c).tabl) }
    if (k & mc_chat_ui.CK_REQUEST) != 0 { mc_chat_complete.complete_request(ch, &(*c).chat_ui.sugg, &(*c).cl) }
    if !(*ch).open && (*ch).was_open {
        (*ch).was_open = false
        if (*ch).regrab { grab_mouse(c, true) }
        (*ch).regrab = false
    }
    death_grab_sync(c)
    if !death_screen_ready(c) && mc_health_ui.health_ui_keys(&(*c).health, &(*c).rw) {
        mc_health.health_respawn(&(*c).health, &(*c).cl, now_ms())
        raw.raw_clear(&(*c).rw)
    }
    if k != 0 { raw.raw_clear(&(*c).rw) }
}

fn on_chat(c: *mut Ctx, id: i32) -> bool {
    if !mc_chat_net.chat_on_packet(&(*c).chat_net, &(*c).chat, &(*c).cl, id, now_ms()) { return false }
    if env_flag("MCPLAY_CHAT_LOG", false) && mc_chat.chat_line_count(&(*c).chat) > 0 {
        let line: str = str { p: mc_chat.chat_line_ptr(&(*c).chat, 0) as *u8, n: mc_chat.chat_line_len(&(*c).chat, 0) }
        say(f"mcplay: chat line={line}\n")
    }
    return true
}

fn on_tab(c: *mut Ctx, id: i32) -> bool {
    let cl: *mut mc_client.Client = &(*c).cl
    if mc_chat_complete.complete_on_packet(&(*c).chat_ui.sugg, cl, id) {
        if (*c).tab_log { say(f"mcplay: tabcomplete n={mc_chat_suggest.sugg_count(&(*c).chat_ui.sugg)}\n") }
        return true
    }
    if !mc_tablist.tab_on_packet(&(*c).tabl, &(*c).chat_net, cl, id) { return false }
    if (*c).tab_log { say(f"mcplay: tablist n={mc_tablist.tab_count(&(*c).tabl)}\n") }
    return true
}

fn draw_tab_list(c: *mut Ctx, r: *mut mc_raster.Raster, s: i32) {
    if (*c).chat.open || mc_pause.pause_active() || !mc_keybinds.kb_down(&(*c).kb, &(*c).rw, mc_keybinds.KB_PLAYERLIST) { return }
    mc_tablist_ui.tablist_ui_draw(&(*c).tabl, r, s, env_flag("MCPLAY_TAB_HEADS", false), now_ms())
}

fn chat_test(c: *mut Ctx) {
    if (*c).chat_test_done || (*c).n_ticks < (env_int("MCPLAY_CHAT_TEST_TICKS", 60) as u64) { return }
    (*c).chat_test_done = true
    let s: str = env.get("MCPLAY_CHAT_TEST")
    if s.n == 0 { return }
    let n: i32 = mc_chat_net.chat_send_script(&(*c).chat, &(*c).cl, s.p as u64, s.n)
    say(f"mcplay: chattest sent={n}\n")
}

fn tab_test(c: *mut Ctx) {
    if (*c).tab_test_done || (*c).n_ticks < (env_int("MCPLAY_TAB_TEST_TICKS", 100) as u64) { return }
    (*c).tab_test_done = true
    let s: str = env.get("MCPLAY_TAB_TEST")
    if s.n == 0 { return }
    mc_chat.chat_input_set(&(*c).chat, s.p as u64, s.n)
    let sent: bool = mc_chat_complete.complete_request(&(*c).chat, &(*c).chat_ui.sugg, &(*c).cl)
    say(f"mcplay: tabtest sent={sent}\n")
}

fn load_keybinds() -> mc_keybinds.Keybinds {
    var kb: mc_keybinds.Keybinds = mc_keybinds.kb_new()
    var path: rt.Buf = rt.buf_new()
    if mc_keybinds.kb_default_path(&path) {
        mc_keybinds.kb_load(str { p: rt.buf_ptr(&path) as *u8, n: rt.buf_len(&path) }, &kb)
    }
    rt.buf_free(&path)
    return kb
}

fn keys_now(c: *mut Ctx) -> u32 {
    var m: u32 = 0 as u32
    if (*c).chat.open || (*c).health.dead { return m }
    if mc_pause.pause_active() { return m }
    if (*c).show_inv { return m } // an open inventory / container panel takes the keys
    if env_flag("MCPLAY_FORCE_SNEAK", false) { m = m | mc_input.K_SNEAK }
    return m | mc_keybinds.kb_move_mask(&(*c).kb, &(*c).rw)
}

// The back end that holds the meshes and the atlas: GL or the CPU raster.
// draw hook of the shot flush frames: nothing is drawn (see main loop end)
fn flush_nop_draw(o: u64, h: usize, ox: f64, oy: f64, oz: f64) -> u64 { return 0 as u64 }

fn cur_be(c: *mut Ctx) -> mc_backend.Backend {
    if (*c).gl || (*c).vk { return (*c).be }
    return mc_backend.backend_cpu(&(*c).g.r)
}

fn gfx_resize(c: *mut Ctx, w: i32, h: i32) {
    stream_release(c)
    if (*c).vk {
        mc_render_world.wr_clear_b(&(*c).g.wr, &(*c).be)
        let rok: bool = vk_mc.vkbe_resize(&(*c).vbk, w, h)
        (*c).be = vk_mc.vkbe_backend(&(*c).vbk)
    } else if (*c).gl {
        mc_render_world.wr_clear_b(&(*c).g.wr, &(*c).be)
        gl_mc.glbe_resize(&(*c).gb, w, h)
        (*c).be = gl_mc.glbe_backend(&(*c).gb)
    } else {
        mc_render_world.wr_clear(&(*c).g.wr, &(*c).g.r)
    }
    mc_raster.raster_free(&(*c).g.r)
    (*c).g.r = mc_raster.raster_new(w, h)
    mc_raster.raster_set_edge_expand(&(*c).g.r, env_int("MCPLAY_EDGE_EXP", 1) != 0)
    if !(*c).gl && !(*c).vk {
        if (*c).g.use_res {
            var be: mc_backend.Backend = mc_backend.backend_cpu(&(*c).g.r)
            mc_packs.res_upload(&(*c).g.res, &be)
        } else {
            mc_raster.backend_upload_atlas(&(*c).g.r, &(*c).g.atlas)
        }
    }
    if (*c).bg != 0 { rt.heap_free((*c).bg, ((*c).w as usize) * ((*c).h as usize) * 4) }
    (*c).bg = rt.heap_alloc((w as usize) * (h as usize) * 4)
    (*c).w = w
    (*c).h = h
    mc_camera.camera_resize(&(*c).cam, w, h)
    if (*c).join { stream_make(c) }
}

// Window events that change state: resize, fullscreen, mouse capture, quit key.
fn handle_window(c: *mut Ctx) {
    focus_loss_apply(c)
    if (*c).resized {
        (*c).resized = false
        let nw: i32 = window.width((*c).wp) as i32
        let nh: i32 = window.height((*c).wp) as i32
        if nw >= 64 && nh >= 48 && (nw != (*c).w || nh != (*c).h) {
            gfx_resize(c, nw, nh)
        }
    }
    if raw.key_pressed(&(*c).rw, raw.KEY_ESC) {
        if mc_pause.pause_active() {
        } else if (*c).show_inv {
            ui_close(c)
        } else if !(*c).chat.open && !(*c).health.dead && mc_pause.pause_ready((*c).protocol) {
            grab_mouse(c, false)
            mc_pause.pause_bind_keys(&(*c).kb)
            mc_pause.pause_open()
        } else {
            grab_mouse(c, !(*c).grab)
        }
    }
    if (*c).aud && raw.key_pressed(&(*c).rw, SC_M) {
        (*c).aud_muted = !(*c).aud_muted
        mc_audio.mca_set_muted((*c).ma, (*c).aud_muted)
    }
    if (*c).aud && (*c).g.use_res && raw.key_pressed(&(*c).rw, SC_O) { audio_sounds_toggle(c) }
    let ctrl: bool = raw.key_down(&(*c).rw, 29 as u32) || raw.key_released(&(*c).rw, 29 as u32)
    if mc_keybinds.kb_pressed(&(*c).kb, &(*c).rw, mc_keybinds.KB_PERSPECTIVE) && !ctrl && !mc_pause.pause_active() {
        (*c).cam3_mode = mc_camera3p.mode_next((*c).cam3_mode)
    }
    if (*c).g.use_res && ctrl && raw.key_pressed(&(*c).rw, SC_F5) {
        var be: mc_backend.Backend = cur_be(c)
        let nr: i32 = mc_packs.res_on_key(&(*c).g.res, &be, mc_packs.RES_KEY_RELOAD)
        if nr >= 0 {
            audio_packs_reload(c)
            models_reload(c)
        }
    }
    if !(*c).chat.open && !mc_pause.pause_active() {
        if raw.key_pressed(&(*c).rw, SC_F1) { mc_hud_play.hp_toggle_hidden(&(*c).hudp) }
        if raw.key_pressed(&(*c).rw, SC_F3) { mc_hud_play.hp_toggle_debug(&(*c).hudp) }
        if mc_keybinds.kb_pressed(&(*c).kb, &(*c).rw, mc_keybinds.KB_SCREENSHOT) { shot_request(c) }
    }
    if mc_keybinds.kb_pressed(&(*c).kb, &(*c).rw, mc_keybinds.KB_FULLSCREEN) {
        (*c).n_f11 = (*c).n_f11 + 1
        (*c).fullscreen = !(*c).fullscreen
        window.fullscreen((*c).wp, (*c).fullscreen)
    }
}

// MCPLAY_MODELS after a pack reload (F5): the models / blockstates / texture names may all have changed. Drops every mesh, forgets the baked models
// and restores the cube tables (ms_prepare took the faces of model states out of them), then the translucent table is derived again.
fn models_reload(c: *mut Ctx) {
    if !(*c).models_on { return }
    var be: mc_backend.Backend = cur_be(c)
    // stream: stream_release waits for every mesh job (jobs.group_wait) and frees the meshes, so no job reads the ModelSet while it is reset;
    // stream_make then builds a new stream (models set again, every loaded column announced) after the tables are restored
    stream_release(c)
    mc_render_world.wr_clear_b(&(*c).g.wr, &be)
    mc_model_mesh.ms_reset(&(*c).ms)
    mc_packs.res_build_tables(&(*c).g.res, &(*c).reg, &(*c).g.tb)
    if env_flag("MCPLAY_TRANS", true) {
        mc_render_world.wr_set_translucent(&(*c).g.wr, true, mc_texture.T_WATER, mc_texture.T_ICE, mc_texture.T_GLASS)
    }
    if (*c).join { stream_make(c) }
}

// Hotbar: number keys + wheel (up = previous slot), HELD_ITEM_SLOT on change.
static mut TEST_FLAGS: i32 = 0 - 1

fn test_flags() -> i32 {
    if TEST_FLAGS >= 0 { return TEST_FLAGS }
    var f: i32 = 0
    if env_flag("MCPLAY_CLICK_TEST", false) { f = f | 1 }
    if env_flag("MCPLAY_CLICK_TEST2", false) { f = f | 2 }
    if env_flag("MCPLAY_CRAFT_TEST", false) { f = f | 4 }
    if env_flag("MCPLAY_CHEST_TEST", false) { f = f | 8 }
    if env_flag("MCPLAY_TABLE_TEST", false) { f = f | 16 }
    if env_flag("MCPLAY_TABLE_TEST2", false) { f = f | 32 }
    if env_flag("MCPLAY_SNEAK_TEST", false) { f = f | 64 }
    if env_flag("MCPLAY_HASH_TEST", false) { f = f | 128 }
    if env_flag("MCPLAY_COMBAT_TEST", false) { f = f | 256 }
    if env_int("MCPLAY_CONT_UI", 0) > 0 { f = f | 512 }
    TEST_FLAGS = f
    return f
}

fn dig_bot_tick(c: *mut Ctx) {
    if !(*c).bot.on || !(*c).have_pos { return }
    let go: bool = (*c).bot_go.length() == 0 || fs.exists((*c).bot_go)
    let act: i32 = mc_dig_bot.digbot_step(&(*c).bot, now_ms(), go)
    if act == mc_dig_bot.DIGBOT_NONE { return }
    var status: i32 = mc_play.DIG_START
    if act == mc_dig_bot.DIGBOT_CANCEL { status = mc_play.DIG_CANCEL }
    (*c).seq = (*c).seq + 1
    let ok: bool = mc_play.send_dig(&(*c).cl, status, (*c).bot.x, (*c).bot.y, (*c).bot.z, 1, (*c).seq)
    say(f"mcplay: dig_bot action={act} sent={ok}\n")
}

fn run_tests(c: *mut Ctx, tf: i32) {
    if (tf & 1) != 0 { click_test(c) }
    if (tf & 2) != 0 { click_test2(c) }
    if (tf & 4) != 0 { craft_test(c) }
    if (tf & 8) != 0 { chest_test(c) }
    if (tf & 16) != 0 { table_test(c) }
    if (tf & 32) != 0 { table_test2(c) }
    if (tf & 64) != 0 { sneak_test(c) }
    if (tf & 128) != 0 { hash_test(c) }
    if (tf & 256) != 0 { combat_test(c) }
    if (tf & 512) != 0 { cont_ui_test(c) }
}

fn track_held(c: *mut Ctx) {
    let item: i32 = mc_inv.inv_held_item(&(*c).inv, (*c).pl.slot)
    var n: usize = 0
    var p: u64 = 0
    if item >= 0 { p = mc_registry.reg_item_name(&(*c).reg, item, &n) }
    let before: i32 = (*c).cfx.held_id
    mc_combat_fx.cfx_set_held(&(*c).cfx, item, p, n, now_ms())
    if before != (*c).cfx.held_id && (*c).combat.using_item { release_held_item(c) }
}

fn handle_hotbar(c: *mut Ctx) {
    if mc_pause.pause_active() { return }
    let hb: i32 = mc_keybinds.kb_hotbar_pressed(&(*c).kb, &(*c).rw)
    if hb >= 0 && !(*c).show_inv { (*c).pl.slot = hb }
    let wy: i64 = raw.wheel_y(&(*c).rw)
    if wy != 0 && (*c).grab {
        (*c).pl.slot = mc_world.floor_mod((*c).pl.slot - (wy as i32), 9)
    }
    mc_inv.inv_set_selected(&(*c).inv, (*c).pl.slot)
    if (*c).pl.slot != (*c).sent_slot {
        mc_play.send_slot(&(*c).cl, (*c).pl.slot)
        (*c).sent_slot = (*c).pl.slot
    }
    if mc_keybinds.kb_pressed(&(*c).kb, &(*c).rw, mc_keybinds.KB_INVENTORY) {
        if (*c).show_inv && !(cr_active(c) && mc_creative.cr_focus(&(*c).cr)) && !anvil_focus(c) { ui_close(c) } else if !(*c).show_inv { ui_set_open(c, true) }
    }
    ui_sync(c)
    anvil_keys(c)
    if mc_keybinds.kb_pressed(&(*c).kb, &(*c).rw, mc_keybinds.KB_DROP) && !(*c).show_inv {
        let all: bool = raw.key_down(&(*c).rw, 29 as u32) || raw.key_released(&(*c).rw, 29 as u32)
        let hs: i32 = mc_inv.INV_HOTBAR0 + (*c).pl.slot
        if mc_inv.inv_local_drop(&(*c).inv, hs, all) {
            let sent: bool = mc_play.send_drop(&(*c).cl, all)
            if (*c).combat_log { say(f"mcplay: combat drop all={all} sent={sent}\n") }
        }
    }
    if mc_keybinds.kb_pressed(&(*c).kb, &(*c).rw, mc_keybinds.KB_SWAP) && !(*c).creative && !(*c).show_inv && (*c).have_pos {
        let sent2: bool = mc_play.send_swap_hands(&(*c).cl)
        if (*c).combat_log { say(f"mcplay: combat swap sent={sent2}\n") }
    }
    track_held(c)
    if (*c).have_pos { give_items(c) }
    if (*c).have_pos { chat_test(c) }
    if (*c).have_pos { tab_test(c) }
    if (*c).have_pos {
        let tf: i32 = test_flags()
        if tf != 0 { run_tests(c, tf) }
    }
    if raw.key_pressed(&(*c).rw, SC_F as u32) { (*c).want_fly = true }
    if raw.key_pressed(&(*c).rw, SC_N as u32) { (*c).want_noclip = true }
}

// ---- ticks (20 Hz): movement + position packet -----------------------------------------------------

fn awaiting_loaded(c: *mut Ctx) -> bool {
    return (*c).cl.ver.protocol >= 769 && (*c).loaded_since != 0 as u64 && !(*c).loaded_sent
}

fn sync_game_mode(c: *mut Ctx) {
    if (*c).creative_fixed { return }
    let cr: bool = mc_game_mode.gm_creative((*c).health.mode, (*c).creative)
    if cr == (*c).creative { return }
    (*c).creative = cr
    (*c).pl.creative = cr
    if !cr {
        (*c).pl.flying = false
        (*c).pl.noclip = false
    }
}

fn instant_break(c: *mut Ctx) -> bool {
    if (*c).creative_fixed { return (*c).creative }
    return mc_game_mode.gm_instant_break((*c).health.mode, (*c).creative)
}

fn may_break(c: *mut Ctx) -> bool {
    return (*c).creative_fixed || mc_game_mode.gm_may_break((*c).health.mode)
}

fn do_tick(c: *mut Ctx) {
    sync_game_mode(c)
    var ev: mc_input.InputEvents = mc_input.input_events_new()
    ev.dx = (*c).acc_dx
    ev.dy = (*c).acc_dy
    ev.keys = keys_now(c)
    ev.toggle_fly = (*c).want_fly && (*c).creative
    ev.toggle_noclip = (*c).want_noclip && (*c).creative
    (*c).acc_dx = 0.0
    (*c).acc_dy = 0.0
    (*c).want_fly = false
    (*c).want_noclip = false
    (*c).pl.jump_boost = mc_effect.fx_jump(&(*c).fx)
    (*c).pl.can_sprint = (*c).health.food > 6 || (*c).creative
    (*c).pl.using_item = (*c).combat.using_item
    if !awaiting_loaded(c) { mc_input.player_tick(&(*c).pl, &ev, &(*c).world, &(*c).itb, (*c).dim.min_y) }
    // Player Loaded once the first chunks are in (1.21.4+): the server ignores sneak packets before that
    if (*c).have_pos && !(*c).loaded_sent && ((*c).n_chunks >= (*c).loaded_base + 9 as u64 || ((*c).loaded_since != 0 as u64 && now_ms() >= (*c).loaded_since + 3000 as u64)) {
        (*c).loaded_sent = true
        if mc_play.send_loaded(&(*c).cl) { (*c).n_loaded = (*c).n_loaded + 1 as u32 }
    }
    // sneak state: the server decides from it whether a right click uses a block (chest) or places the held item
    if (*c).have_pos && (*c).loaded_sent && (*c).pl.sneaking != (*c).sneak_sent {
        (*c).sneak_sent = (*c).pl.sneaking
        if mc_play.send_sneak_action(&(*c).cl, (*c).fx.own, (*c).sneak_sent) { (*c).n_sneak = (*c).n_sneak + 1 as u32 } else { (*c).n_sneak = (*c).n_sneak + 100 as u32 }
    }
    if (*c).have_pos && (*c).loaded_sent && (ev.keys & 127 as u32) != (*c).input_sent {
        (*c).input_sent = ev.keys & 127 as u32
        mc_play.send_input(&(*c).cl, (*c).input_sent)
    }
    if (*c).have_pos && (*c).loaded_sent && (*c).pl.sprinting != (*c).sprint_sent {
        (*c).sprint_sent = (*c).pl.sprinting
        mc_play.send_sprint(&(*c).cl, (*c).fx.own, (*c).sprint_sent)
    }
    // the base a relative Synchronize Player Position is resolved against
    if (*c).have_pos { mc_client.client_note_pos(&(*c).cl, (*c).pl.x, (*c).pl.y, (*c).pl.z, (*c).pl.yaw, (*c).pl.pitch) }
    if now_ms() >= (*c).tp_quiet_until {
        mc_play.send_pos_look(&(*c).cl, (*c).pl.x, (*c).pl.y, (*c).pl.z, (*c).pl.yaw, (*c).pl.pitch, (*c).pl.on_ground)
    }
    (*c).n_ticks = (*c).n_ticks + 1 as u64
    mc_hud_play.hp_tick(&(*c).hudp, &(*c).health, &(*c).inv, &(*c).reg, &(*c).pl, &(*c).world, (*c).dim.min_y)
    sync_view_fov(c)
    if env_flag("MCPLAY_POS_LOG", false) && (*c).n_ticks % 5 as u64 == 0 as u64 {
        say(f"mcplay: poslog tick={(*c).n_ticks} tp={(*c).cl.teleports} x={((*c).pl.x * 1000.0) as i64} y={((*c).pl.y * 1000.0) as i64} z={((*c).pl.z * 1000.0) as i64} vy={((*c).pl.vy * 1000.0) as i64} ground={(*c).pl.on_ground} fly={(*c).pl.flying}\n")
    }
    if (*c).aud {
        let fc: mc_audio.FallCtx = mc_audio.FallCtx { known: true, fall: (*c).pl.fall, exempt: (*c).pl.flying || (*c).pl.noclip || (*c).creative, wet: (*c).pl.wet,
            jump: mc_effect.fx_jump(&(*c).fx), slow_fall: mc_effect.fx_slow_fall(&(*c).fx) }
        let st: i32 = mc_audio.mca_walk_ctx((*c).ma, &(*c).wk, &(*c).reg, &(*c).world, (*c).dim.min_y, (*c).pl.x, (*c).pl.y, (*c).pl.z, (*c).pl.on_ground, (*c).pl.sneaking, fc)
        (*c).n_snd = (*c).n_snd + st as u64
        mc_snd_events.sev_water_tick((*c).ma, &(*c).sev, (*c).pl.wet, (*c).pl.x, (*c).pl.y, (*c).pl.z)
        mc_snd_use.su_frame((*c).ma, &(*c).su, &(*c).reg, &(*c).world, (*c).dim.min_y, mc_inv.inv_held_item(&(*c).inv, (*c).pl.slot), (*c).combat.using_item, (*c).health.food < 20, mc_hud_play.hp_under_water(&(*c).hudp), now_ms(), (*c).pl.x, (*c).pl.y, (*c).pl.z, (*c).n_ticks % 4 as u64 == 0 as u64)
    }
    if !(*c).day_fixed && (*c).n_time > 0 as u64 { (*c).day_time = (*c).day_time + 1 }
    weather_tick(c)
    if (*c).n_time > 0 as u64 { sky_apply(c) }
    if (*c).g.use_res {
        var be: mc_backend.Backend = cur_be(c)
        mc_packs.res_tick(&(*c).g.res, (*c).n_ticks as i64, &be)
    }
}

// The server moved us (join, teleport): take its position.
fn sync_position(c: *mut Ctx) {
    var x: f64 = 0.0
    var y: f64 = 0.0
    var z: f64 = 0.0
    if !mc_client.client_position(&(*c).cl, &x, &y, &z) { return }
    if !(*c).have_pos || (*c).cl.teleports != (*c).last_tp {
        (*c).have_pos = true
        (*c).last_tp = (*c).cl.teleports
        if !(*c).cl.pos_reply { (*c).tp_quiet_until = now_ms() + TP_QUIET_MS }
        (*c).pl.x = x
        (*c).pl.y = y
        (*c).pl.z = z
        // look angles (relative flags already resolved by the client) + delta movement (1.21.2+; relative = added to the own velocity)
        var yaw: f32 = 0.0f
        var pitch: f32 = 0.0f
        if mc_client.client_position_look(&(*c).cl, &yaw, &pitch) {
            (*c).pl.yaw = yaw as f64
            (*c).pl.pitch = pitch as f64
        }
        var fl: i32 = 0
        var ddx: f64 = 0.0
        var ddy: f64 = 0.0
        var ddz: f64 = 0.0
        mc_client.client_position_delta(&(*c).cl, &fl, &ddx, &ddy, &ddz)
        if (fl & 64) != 0 { (*c).pl.vy = (*c).pl.vy + ddy } else { (*c).pl.vy = ddy }
        if env_flag("MCPLAY_POS_LOG", false) {
            say(f"mcplay: poslog sync flags={fl} x={(x * 1000.0) as i64} y={(y * 1000.0) as i64} z={(z * 1000.0) as i64} yaw={((*c).pl.yaw * 1000.0) as i64} dy={(ddy * 1000.0) as i64}\n")
        }
    }
}

// MCPLAY_RAW_INV=1: one `rawinv <items|slot> <protocol> <hex of the packet body>` line per Window Items / Set Slot packet (test fixtures
// from a real server, see tests/2960_mc_inv_real.fi)
fn dump_raw_inv(tag: str, protocol: i32, b: *mut bytes.Bytes) {
    if !env_flag("MCPLAY_RAW_INV", false) { return }
    var o: rt.Buf = rt.buf_new()
    var i: usize = bytes.bytes_pos(b)
    let n: usize = bytes.bytes_len(b)
    while i < n {
        rt.buf_push_hex_u64(&o, bytes.bytes_at(b, i) as u64, 2)
        i = i + 1
    }
    io.fmt_print(f"rawinv {tag} {protocol} ")
    io.print_bytes(rt.buf_ptr(&o), rt.buf_len(&o))
    io.fmt_print(f"\n")
    rt.buf_free(&o)
}

// ---- inventory HUD + creative give ------------------------------------------------------------------

// Item label inside a 20 x 20 (HUD px * scale) slot cell at (x, y): first 3 letters of the item name, count at the bottom right.
fn draw_slot_label(c: *mut Ctx, r: *mut mc_raster.Raster, x: i32, y: i32, s: i32, item: i32, count: i32) {
    draw_slot_label_col(c, r, x, y, s, item, count, 0xFFFFFFFF as u32)
}

fn arm_slot(c: *mut Ctx, slot: i32) {
    var p: u64 = 0
    var n: usize = 0
    let ok: bool = mc_inv.inv_slot_meta(&(*c).inv, slot, &p, &n)
    mc_item_deco.deco_arm(p, n, ok)
}

fn arm_cursor(c: *mut Ctx) {
    var p: u64 = 0
    var n: usize = 0
    let ok: bool = mc_inv.inv_cursor_meta(&(*c).inv, &p, &n)
    mc_item_deco.deco_arm(p, n, ok)
}

fn draw_win_slot(c: *mut Ctx, r: *mut mc_raster.Raster, s: i32, gx: i32, gy: i32, ws: i32, k: i32) {
    var shown: i32 = 0
    var clamped: bool = false
    if mc_inv.inv_drag_slot_view(&(*c).inv, ws, &shown, &clamped) {
        mc_hud.hud_rect(r, gx, gy, 16 * s, 16 * s, 0x80FFFFFF as u32)
        var col: u32 = 0xFFFFFFFF as u32
        if clamped { col = mc_inv_ui.YELLOW }
        draw_slot_label_col(c, r, gx - 2 * s, gy - 2 * s, s, mc_inv.inv_cursor_item(&(*c).inv), shown, col)
        return
    }
    if k >= 0 { arm_slot(c, k) }
    if k >= 0 { draw_slot_label(c, r, gx - 2 * s, gy - 2 * s, s, mc_inv.inv_item(&(*c).inv, k), mc_inv.inv_count(&(*c).inv, k)) }
}

fn draw_cursor_stack(c: *mut Ctx, r: *mut mc_raster.Raster, s: i32, mx: i32, my: i32) {
    var count: i32 = mc_inv.inv_cursor_count(&(*c).inv)
    if mc_inv.inv_drag_slots(&(*c).inv) >= 2 { count = mc_inv.inv_drag_left(&(*c).inv) }
    if count <= 0 { return }
    arm_cursor(c)
    draw_slot_label(c, r, mx - 10 * s, my - 10 * s, s, mc_inv.inv_cursor_item(&(*c).inv), count)
}

fn draw_slot_label_col(c: *mut Ctx, r: *mut mc_raster.Raster, x: i32, y: i32, s: i32, item: i32, count: i32, col: u32) {
    if item < 0 { return }
    var inp: u64 = 0
    var inn: usize = 0
    inp = mc_registry.reg_item_name(&(*c).reg, item, &inn)
    mc_item_deco.deco_pre(r, x + 2 * s, y + 2 * s, s, inp, inn)
    if mc_item_icon.icons_draw(&(*c).icons, r, &(*c).reg, item, x + 2 * s, y + 2 * s, s) {
        mc_item_deco.deco_post(r, x + 2 * s, y + 2 * s, s, inp, inn, now_ms())
        mc_item_deco.deco_arm(0 as u64, 0, false)
        mc_inv_ui.iui_count_col(r, x + 2 * s, y + 2 * s, s, count, col)
        return
    }
    mc_item_deco.deco_arm(0 as u64, 0, false)
    var n: usize = 0
    let p: u64 = mc_registry.reg_item_name(&(*c).reg, item, &n)
    var m: usize = n
    if m > 3 { m = 3 }
    mc_hud_text.htext_bytes(r, x + 2 * s, y + 3 * s, s, 0xFFFFFFFF as u32, 0xFF3F3F3F as u32, p, m)
    if count > 1 {
        var b: rt.Buf = rt.buf_new()
        mc_hud.hud_push_int(&b, count as i64)
        let w: i32 = mc_hud_text.htext_width(b.ptr, b.len, s)
        mc_hud_text.htext_bytes(r, x + 19 * s - w, y + 12 * s, s, 0xFFFFFFFF as u32, 0xFF3F3F3F as u32, b.ptr, b.len)
        rt.buf_free(&b)
    }
}

// Hotbar item labels, the dig progress bar and (E) the inventory panel (36 slots: main 3 rows, hotbar row below).
fn sync_view_fov(c: *mut Ctx) {
    let o: *mut mc_opts.Opts = mc_pause.pause_opts()
    mc_camera.camera_set_lens(&(*c).cam, mc_water_fog.wfog_fov((*o).fov as f64, mc_hud_play.hp_under_water(&(*c).hudp)), (*c).cam.near, (*c).cam.far)
}

static mut LOOK_FLAGS: u32 = 0xFFFFFFFF as u32

fn apply_look(c: *mut Ctx, o: *mut mc_opts.Opts, start: bool) {
    let f: u32 = mc_opts.opts_look_flags(o)
    if LOOK_FLAGS == f { return }
    let first: bool = LOOK_FLAGS == 0xFFFFFFFF as u32
    LOOK_FLAGS = f
    if start || first { return }
    mc_render_world.wr_set_flags(&(*c).g.wr, mc_mesh.F_GREEDY | f)
    mc_stream.stream_set_look_flags(&(*c).stm, f)
    if (*c).stream_on && (*c).light {
        mc_stream.stream_set_light(&(*c).stm, true, ((&(*c).wl) as *mut mc_wlight.WorldLight) as u64)
    } else {
        mc_render_world.wr_clear_b(&(*c).g.wr, &(*c).be)
    }
}

fn apply_opts(c: *mut Ctx, start: bool) {
    let o: *mut mc_opts.Opts = mc_pause.pause_opts()
    sync_view_fov(c)
    mc_hud.hud_set_gui_scale((*o).gui_scale)
    mc_lightmap.lm_set_gamma(mc_opts.opts_gamma256(o))
    apply_look(c, o, start)
    if (*c).aud {
        var i: i32 = 0
        while i < mc_opts.OPT_VOLUMES {
            if !start || (*o).vol[i as usize] != 100 { mc_audio.mca_set_category_volume((*c).ma, i, ((*o).vol[i as usize] as f32) / 100.0) }
            i = i + 1
        }
    }
    apply_vsync(c, o)
    if start { return }
    if ((*o).fullscreen != 0) != (*c).fullscreen {
        (*c).fullscreen = !(*c).fullscreen
        window.fullscreen((*c).wp, (*c).fullscreen)
    }
}

fn want_vsync() -> bool {
    let o: *mut mc_opts.Opts = mc_pause.pause_opts()
    return mc_frame_limit.fl_vsync_on((*o).vsync, env.has("MCPLAY_VSYNC"), env_int("MCPLAY_VSYNC", 1))
}

fn apply_vsync(c: *mut Ctx, o: *mut mc_opts.Opts) {
    let on: bool = want_vsync()
    if (*c).gl { glwindow.swap_interval(&(*c).gw, on as i32) }
    if (*c).vk { vk_mc.vkbe_set_vsync(&(*c).vbk, on) }
}

fn frame_limit_ns(c: *mut Ctx) -> u64 {
    let o: *mut mc_opts.Opts = mc_pause.pause_opts()
    let gpu_present: bool = (*c).gl || ((*c).vk && vk_mc.vkbe_sc_on(&(*c).vbk))
    return mc_frame_limit.fl_frame_ns((*o).fps_limit, env.has("MCPLAY_FPS"), env_int("MCPLAY_FPS", 0), gpu_present)
}

fn apply_view(c: *mut Ctx, requested: i32) {
    let plan: mc_lod_policy.LodPlan = mc_lod_policy.lod_plan(requested, env_int("MCPLAY_LOD", mc_lod_policy.LOD_UNSET))
    (*c).view = plan.view
    (*c).lod = plan.lod
    (*c).g.wr.dist = plan.view
    mc_camera.camera_set_lens(&(*c).cam, (*c).cam.fov, (*c).cam.near, ((wire_view(c) as f64) + 2.0) * 16.0 * 1.5)
    if (*c).join {
        stream_make(c)
        mc_client.client_send_settings(&(*c).cl, wire_view(c))
    }
    (*mc_pause.pause_opts()).view_actual = requested
    mc_frame_split.fs_set(mc_frame_split.FS_VIEW, requested as u64)
    mc_pause.pause_persist()
    say(f"mcplay: view applied requested={requested} view={plan.view} lod={plan.lod} wire={wire_view(c)} cols={mc_world.world_count(&(*c).world)}\n")
}

fn view_poll(c: *mut Ctx, dragging: bool) {
    let v: i32 = mc_view_sync.vs_poll(&(*c).vsync, (*mc_pause.pause_opts()).view, dragging)
    if v > 0 { apply_view(c, v) }
}

fn pause_tick(c: *mut Ctx, r: *mut mc_raster.Raster) {
    mc_pause.pause_set_capture(mc_keybinds.kb_capture(&(*c).rw))
    let a: i32 = mc_pause.pause_frame(r, raw.mouse_x(&(*c).rw) as i32, raw.mouse_y(&(*c).rw) as i32, raw.mouse_pressed(&(*c).rw, raw.MB_LEFT), raw.mouse_down(&(*c).rw, raw.MB_LEFT), raw.wheel_y(&(*c).rw) as i32, now_ms(), raw.key_pressed(&(*c).rw, raw.KEY_ESC))
    if mc_pause.pause_take_changed() { apply_opts(c, false) }
    if a == mc_pause.PA_RESUME {
        mc_pause.pause_close()
        mc_pause.pause_persist()
        grab_mouse(c, true)
    }
    if a == mc_pause.PA_DISCONNECT {
        mc_pause.pause_close()
        mc_pause.pause_persist()
        (*c).end_kind = END_DISCONNECT
        (*c).closed = true
    }
}

fn hud_base(c: *mut Ctx, r: *mut mc_raster.Raster, d: *mut mc_hud.HudDebug) {
    let s: i32 = mc_hud.hud_scale((*c).w, (*c).h)
    if !mc_hud_play.hp_vanilla(&(*c).hudp) {
        mc_hud.hud_frame(r, s, mc_hud.HUD_CROSSHAIR | mc_hud.HUD_HOTBAR | mc_hud.HUD_DEBUG, (*c).pl.slot, d)
        return
    }
    if mc_hud_play.hp_hidden(&(*c).hudp) { return }
    mc_hud_play.hp_draw_base(&(*c).hudp, r, s)
    if mc_hud_play.hp_debug(&(*c).hudp) {
        var di: mc_hud_debug.DebugInfo = mc_hud_debug.dbg_new()
        di.protocol = (*c).protocol
        di.fps = (*d).fps
        di.x = (*d).x
        di.y = (*d).y
        di.z = (*d).z
        di.yaw = (*d).yaw
        di.pitch = (*d).pitch
        di.min_y = (*c).dim.min_y
        di.has_block = (*d).has_block
        di.bx = (*d).bx
        di.by = (*d).by
        di.bz = (*d).bz
        di.state = (*d).id
        mc_hud_debug.dbg_draw(r, s, &di, &(*c).world, &(*c).reg)
    }
}

fn draw_cracks(c: *mut Ctx, r: *mut mc_raster.Raster) {
    if !(*c).crk_on || !(*c).have_pos { return }
    if !(*c).crk_tried {
        (*c).crk_tried = true
        if !mc_crack.crack_tex_open(&(*c).crk, (*c).protocol) { say(f"mcplay: crack textures unavailable\n") }
    }
    if !mc_crack.crack_tex_ok(&(*c).crk) { return }
    let now: u64 = now_ms()
    if (*c).digging {
        let st: i32 = mc_dig_progress.dp_stage(&(*c).dp)
        var b: mc_crack.CrackBox = mc_crack_view.crackv_unit_box((*c).dig_x, (*c).dig_y, (*c).dig_z)
        if (*c).hit && (*c).pk.x == (*c).dig_x && (*c).pk.y == (*c).dig_y && (*c).pk.z == (*c).dig_z && (*c).models_on {
            var mb: mc_model_pick.MpBox = sel_box(c)
            b = mc_crack.CrackBox { x0: mb.x0, y0: mb.y0, z0: mb.z0, x1: mb.x1, y1: mb.y1, z1: mb.z1 }
        }
        mc_crack_view.crackv_draw_block(r, &(*c).cam, &(*c).crk, &(*c).world, (*c).dim.min_y, &(*c).itb, (*c).dig_x, (*c).dig_y, (*c).dig_z, st, &b)
        (*c).crk_own = (*c).crk_own + 1 as u64
    }
    let n: i32 = mc_crack_view.crackv_draw_anims(r, &(*c).cam, &(*c).crk, &(*c).cra, &(*c).world, (*c).dim.min_y, &(*c).itb, now)
    (*c).crk_other = (*c).crk_other + (n as u64)
}

fn draw_inventory(c: *mut Ctx, r: *mut mc_raster.Raster) {
    draw_inventory_body(c, r)
    if mc_pause.pause_active() { pause_tick(c, r) }
}

fn player_px(c: *mut Ctx, s: i32) -> i32 { return mc_hud_vanilla.vh_center((*c).w, s, mc_inv_ui.iui_panel_w() * s) }

fn player_py(c: *mut Ctx, s: i32) -> i32 { return mc_hud_vanilla.vh_center((*c).h, s, mc_inv_ui.iui_panel_h() * s) }

fn draw_slot_tooltip(c: *mut Ctx, r: *mut mc_raster.Raster, s: i32, k: i32) {
    if k < 0 || mc_inv.inv_cursor_item(&(*c).inv) >= 0 { return }
    let item: i32 = mc_inv.inv_item(&(*c).inv, k)
    if item < 0 || mc_inv.inv_count(&(*c).inv, k) <= 0 { return }
    draw_item_tooltip(c, r, raw.mouse_x(&(*c).rw) as i32, raw.mouse_y(&(*c).rw) as i32, s, item, k)
}

fn draw_item_tooltip(c: *mut Ctx, r: *mut mc_raster.Raster, mx: i32, my: i32, s: i32, item: i32, slot: i32) {
    var n: usize = 0
    let p: u64 = mc_registry.reg_item_name(&(*c).reg, item, &n)
    var rp: u64 = 0
    var rn: usize = 0
    if slot >= 0 { mc_inv.inv_slot_meta(&(*c).inv, slot, &rp, &rn) }
    var en: usize = 0
    let ep: u64 = mc_client.client_enchant_names(&(*c).cl, &en)
    mc_inv_tooltip.tip_draw_item(r, mx, my, s, rp, rn, p, n, (*c).cl.ver.protocol, ep, en)
}

fn draw_player_panel(c: *mut Ctx, r: *mut mc_raster.Raster, s: i32) {
    let px: i32 = player_px(c, s)
    let py: i32 = player_py(c, s)
    let mx: i32 = raw.mouse_x(&(*c).rw) as i32
    let my: i32 = raw.mouse_y(&(*c).rw) as i32
    mc_inv_ui.iui_draw_bg(&(*c).iui, r, px, py, s)
    let hover: i32 = mc_inv_ui.iui_slot_at(px, py, s, mx, my)
    var ws: i32 = 0
    while ws < 46 {
        var x: i32 = 0
        var y: i32 = 0
        mc_inv_ui.iui_slot_xy(ws, &x, &y)
        let gx: i32 = px + x * s
        let gy: i32 = py + y * s
        if mc_inv.inv_item(&(*c).inv, ws) < 0 || mc_inv.inv_count(&(*c).inv, ws) <= 0 { mc_inv_ui.iui_draw_hint(&(*c).iui, r, ws, gx, gy, s) }
        draw_win_slot(c, r, s, gx, gy, ws, ws)
        if ws == hover { mc_hud.hud_rect(r, gx, gy, 16 * s, 16 * s, 0x80FFFFFF as u32) }
        ws = ws + 1
    }
    draw_cursor_stack(c, r, s, mx, my)
    draw_slot_tooltip(c, r, s, hover)
}

fn death_screen_ready(c: *mut Ctx) -> bool {
    return (*c).health.dead && mc_hud_play.hp_vanilla(&(*c).hudp) && mc_pause.pause_ready((*c).protocol)
}

fn death_grab_sync(c: *mut Ctx) {
    if death_screen_ready(c) {
        if (*c).grab {
            (*c).death_regrab = true
            grab_mouse(c, false)
        }
    } else if (*c).death_regrab && !(*c).health.dead {
        (*c).death_regrab = false
        grab_mouse(c, true)
    }
}

fn draw_death_screen(c: *mut Ctx, r: *mut mc_raster.Raster, s: i32) {
    if !(*c).health.dead {
        mc_pause.pause_death_reset()
        return
    }
    if !death_screen_ready(c) {
        mc_health_ui.health_ui_draw_death(&(*c).health, r, s)
        return
    }
    let h: *mut mc_health.Health = &(*c).health
    let now: u64 = now_ms()
    let a: i32 = mc_pause.pause_death_frame(r, raw.mouse_x(&(*c).rw) as i32, raw.mouse_y(&(*c).rw) as i32, raw.mouse_pressed(&(*c).rw, raw.MB_LEFT), now, (*c).hudp.view.hardcore, mc_health.health_message_ptr(h), mc_health.health_message_len(h), 0, now - (*h).died_ms)
    if a == mc_death_ui.DA_RESPAWN { mc_health.health_respawn(h, &(*c).cl, now) }
    if a == mc_death_ui.DA_TITLE {
        (*c).end_kind = END_DISCONNECT
        (*c).closed = true
    }
}

fn draw_inventory_body(c: *mut Ctx, r: *mut mc_raster.Raster) {
    let s: i32 = mc_hud.hud_scale((*c).w, (*c).h)
    let vanilla: bool = mc_hud_play.hp_vanilla(&(*c).hudp)
    mc_hud_play.hp_draw_underwater(&(*c).hudp, r, (*c).cam.yaw, (*c).cam.pitch, (*c).sky.daylight)
    if vanilla {
        draw_death_screen(c, r, s)
    } else {
        mc_health_ui.health_ui_draw(&(*c).health, r, s)
    }
    mc_hud_play.hp_draw_overlay(&(*c).hudp, r, s, now_ms())
    if !mc_hud_play.hp_hidden(&(*c).hudp) {
        draw_tab_list(c, r, s)
        mc_chat_ui.chat_ui_draw(&(*c).chat, &(*c).chat_ui, r, s, now_ms())
    }
    mc_combat_ui.combat_ui_draw(&(*c).cfx, r, s, now_ms())
    log_combat_hud(c)
    var bx: i32 = ((*r).w - 181 * s) / 2
    var by: i32 = (*r).h - 23 * s
    if vanilla {
        bx = mc_hud_play.hp_hotbar_x(&(*c).hudp, r, s)
        by = mc_hud_play.hp_hotbar_y(&(*c).hudp, r, s)
    }
    let off_item: i32 = mc_inv.inv_item(&(*c).inv, mc_offhand_ui.OFFHAND_SLOT)
    if off_item >= 0 {
        (*c).cfx.n_offhand_frames = (*c).cfx.n_offhand_frames + 1 as u64
        arm_slot(c, mc_offhand_ui.OFFHAND_SLOT)
        if mc_hud_play.hp_draw_offhand(&(*c).hudp, r, s) {
            draw_slot_label(c, r, mc_hud_play.hp_offhand_item_x(r, s) - 2 * s, mc_hud_play.hp_offhand_item_y(r, s) - 2 * s, s, off_item, mc_inv.inv_count(&(*c).inv, mc_offhand_ui.OFFHAND_SLOT))
        } else {
            mc_offhand_ui.offhand_ui_draw(r, s)
            draw_slot_label(c, r, mc_offhand_ui.offhand_cell_x(r, s) + s, mc_offhand_ui.offhand_cell_y(r, s) + s, s, off_item, mc_inv.inv_count(&(*c).inv, mc_offhand_ui.OFFHAND_SLOT))
        }
    }
    var k: i32 = 0
    while k < 9 && !mc_hud_play.hp_hidden(&(*c).hudp) {
        arm_slot(c, mc_inv.INV_HOTBAR0 + k)
        draw_slot_label(c, r, bx + k * 20 * s + s, by + s, s, mc_inv.inv_hotbar_item(&(*c).inv, k), mc_inv.inv_hotbar_count(&(*c).inv, k))
        k = k + 1
    }
    if (*c).digging && (*c).dig_total > 0 {
        let frac: f64 = mc_dig_progress.dp_fraction(&(*c).dp)
        let done: i32 = (frac * ((*c).dig_total as f64)) as i32
        let w: i32 = 40 * s
        let x0: i32 = ((*r).w - w) / 2
        let y0: i32 = (*r).h / 2 + 12 * s
        mc_hud.hud_rect(r, x0 - s, y0 - s, w + 2 * s, 4 * s, 0x90000000 as u32)
        mc_hud.hud_rect(r, x0, y0, (w * done) / (*c).dig_total, 2 * s, 0xFFFFFFFF as u32)
    }
    if !(*c).show_inv { return }
    if ui_cont_open(c) {
        draw_container(c, r)
        return
    }
    if cr_active(c) {
        draw_creative(c, r, s)
        return
    }
    if mc_inv_ui.iui_ok(&(*c).iui) {
        draw_player_panel(c, r, s)
        return
    }
    let pw: i32 = 9 * 20 * s + 8 * s
    let ph: i32 = 5 * 20 * s + 20 * s
    let px: i32 = ((*r).w - pw) / 2
    let py: i32 = ((*r).h - ph) / 2
    mc_hud.hud_rect(r, px, py, pw, ph, 0xC8000000 as u32)
    mc_hud_text.htext(r, px + 4 * s, py + 3 * s, s, 0xFFFFFFFF as u32, 0xFF3F3F3F as u32, "Inventory")
    var row: i32 = 0
    while row < 4 {
        var col: i32 = 0
        while col < 9 {
            var slot: i32 = mc_inv.INV_MAIN0 + row * 9 + col
            var gy: i32 = py + 14 * s + row * 20 * s
            if row == 3 {
                slot = mc_inv.INV_HOTBAR0 + col
                gy = gy + 4 * s
            }
            let gx: i32 = px + 4 * s + col * 20 * s
            mc_hud.hud_rect(r, gx, gy, 19 * s, 19 * s, 0x60808080 as u32)
            arm_slot(c, slot)
            draw_slot_label(c, r, gx - s, gy - s, s, mc_inv.inv_item(&(*c).inv, slot), mc_inv.inv_count(&(*c).inv, slot))
            col = col + 1
        }
        row = row + 1
    }
    // the carried stack follows the mouse
    arm_cursor(c)
    draw_slot_label(c, r, (raw.mouse_x(&(*c).rw) as i32) - 8 * s, (raw.mouse_y(&(*c).rw) as i32) - 8 * s, s, mc_inv.inv_cursor_item(&(*c).inv), mc_inv.inv_cursor_count(&(*c).inv))
}

// Creative: MCPLAY_GIVE="stone:64,diamond_pickaxe:1" fills the hotbar from slot 1 (Set Creative Slot; the server does not echo it).
fn give_items(c: *mut Ctx) {
    if (*c).give_done { return }
    if (*c).inv.n_updates == 0 as u32 { return } // wait for the server's first Window Items (newer servers send it later than the position)
    (*c).give_done = true
    if !(*c).creative { return }
    if !env.has("MCPLAY_GIVE") { return }
    let g: str = env.get("MCPLAY_GIVE")
    var i: usize = 0
    var slot: i32 = 0
    while i < g.n && slot < 9 {
        var j: usize = i
        while j < g.n && rt.ld8(g.p as u64, j) != 58 as u8 && rt.ld8(g.p as u64, j) != 44 as u8 { j = j + 1 }
        let item: i32 = mc_registry.reg_item_by_name(&(*c).reg, g.p as u64 + i as u64, j - i)
        var cnt: i32 = 1
        var e: usize = j
        if j < g.n && rt.ld8(g.p as u64, j) == 58 as u8 {
            e = j + 1
            var v: i32 = 0
            while e < g.n && rt.ld8(g.p as u64, e) >= 48 as u8 && rt.ld8(g.p as u64, e) <= 57 as u8 {
                v = v * 10 + ((rt.ld8(g.p as u64, e) - 48 as u8) as i32)
                e = e + 1
            }
            if v > 0 { cnt = v }
        }
        if item >= 0 {
            mc_inv.inv_send_creative(&(*c).cl, mc_inv.INV_HOTBAR0 + slot, item, cnt)
            mc_inv.inv_set(&(*c).inv, mc_inv.INV_HOTBAR0 + slot, item, cnt)
            slot = slot + 1
        }
        i = e
        while i < g.n && rt.ld8(g.p as u64, i) == 44 as u8 { i = i + 1 }
    }
    say(f"mcplay: gave {slot} items\n")
}

// ---- mouse actions: break / place ------------------------------------------------------------------

fn break_local(c: *mut Ctx, x: i32, y: i32, z: i32) {
    if (*c).aud {
        let old: i32 = mc_audio.mca_state_at(&(*c).world, (*c).dim.min_y, x, y, z)
        if mc_audio.mca_block_sound((*c).ma, &(*c).reg, old, mc_audio.ACT_BREAK, x, y, z) != 0 as u32 { (*c).n_snd = (*c).n_snd + 1 as u64 }
    }
    mark_air(c, x, y, z, 0)
    (*c).n_dig = (*c).n_dig + 1 as u64
}

// Break time in ms of the block state `state` with the item in hand (mc_dig): -1 unbreakable, 0 instant. Without a dig table for this
// protocol (mc_dig_sel: 1.16.5 .. 1.20.2 and 1.21.1 .. 26.1 are generated) the fixed MCPLAY_DIG_MS is used.
fn dig_damage_now(c: *mut Ctx, state: i32) -> f64 {
    let fixed: f64 = (mc_dig_progress.TICK_MS as f64) / ((*c).dig_ms as f64)
    if !mc_dig.dig_ok(&(*c).dg) { return fixed }
    let blk: i32 = mc_registry.reg_block_of_state(&(*c).reg, state)
    if blk < 0 { return fixed }
    let item: i32 = mc_inv.inv_held_item(&(*c).inv, (*c).pl.slot)
    let hard: i32 = mc_registry.reg_block_hardness_milli(&(*c).reg, blk)
    let eff: i32 = mc_inv.inv_held_eff(&(*c).inv, (*c).pl.slot)
    return mc_dig.dig_damage_fx(&(*c).dg, blk, hard, item, eff, mc_effect.fx_haste(&(*c).fx), mc_effect.fx_fatigue(&(*c).fx), (*c).pl.on_ground, mc_hud_play.hp_under_water(&(*c).hudp))
}

fn dig_time_ms(c: *mut Ctx, state: i32) -> i32 {
    if !mc_dig.dig_ok(&(*c).dg) { return env_int("MCPLAY_DIG_MS", 700) }
    let blk: i32 = mc_registry.reg_block_of_state(&(*c).reg, state)
    if blk < 0 { return env_int("MCPLAY_DIG_MS", 700) }
    let item: i32 = mc_inv.inv_held_item(&(*c).inv, (*c).pl.slot)
    let hard: i32 = mc_registry.reg_block_hardness_milli(&(*c).reg, blk)
    let eff: i32 = mc_inv.inv_held_eff(&(*c).inv, (*c).pl.slot)
    let t: i32 = mc_dig.dig_ticks_fx(&(*c).dg, blk, hard, item, eff, mc_effect.fx_haste(&(*c).fx), mc_effect.fx_fatigue(&(*c).fx), (*c).pl.on_ground, mc_hud_play.hp_under_water(&(*c).hudp))
    (*c).fx_ticks = t
    (*c).fx_plain = mc_dig.dig_ticks(&(*c).dg, blk, hard, item, 0, (*c).pl.on_ground, mc_hud_play.hp_under_water(&(*c).hudp))
    if t <= 0 { return t }
    (*c).dig_total = t
    return t * 50
}

// ---- container panel (chest, shulker box, hopper, dispenser): rows of 9 container slots, then the 36 player slots ----------------
// Slot numbers are the window slots of the packets: 0..n-1 container, n..n+26 main inventory, n+27..n+35 hotbar.

fn ui_cont_open(c: *mut Ctx) -> bool {
    return mc_inv.inv_window(&(*c).inv) != 0 && mc_inv.inv_window_slots(&(*c).inv) > 0
}

fn cont_cols(c: *mut Ctx) -> i32 { return mc_inv.inv_window_cols(&(*c).inv) }

fn cont_rows(c: *mut Ctx) -> i32 {
    let k: i32 = cont_cols(c)
    return (mc_inv.inv_window_slots(&(*c).inv) + k - 1) / k
}

fn cont_kind(c: *mut Ctx) -> i32 {
    if !mc_cont_ui.cui_ok(&(*c).cui) { return 0 - 1 }
    return mc_cont_ui.cui_kind_of(mc_inv.inv_window_mk(&(*c).inv), mc_inv.inv_window_slots(&(*c).inv), cont_cols(c))
}

fn cont_pw(c: *mut Ctx, s: i32) -> i32 {
    if cont_kind(c) >= 0 { return mc_cont_ui.cui_panel_w(cont_kind(c)) * s }
    return 9 * 20 * s + 8 * s
}

fn cont_ph(c: *mut Ctx, s: i32) -> i32 {
    if cont_kind(c) >= 0 { return mc_cont_ui.cui_panel_h(cont_kind(c), mc_inv.inv_window_slots(&(*c).inv)) * s }
    return cont_ph_legacy(c, s)
}

fn cont_ph_legacy(c: *mut Ctx, s: i32) -> i32 { return 14 * s + cont_rows(c) * 20 * s + 14 * s + 3 * 20 * s + 4 * s + 20 * s + 4 * s }

fn cont_px(c: *mut Ctx, s: i32) -> i32 { return mc_hud_vanilla.vh_center((*c).w, s, cont_pw(c, s)) }

fn cont_py(c: *mut Ctx, s: i32) -> i32 { return mc_hud_vanilla.vh_center((*c).h, s, cont_ph(c, s)) }

// top-left of the cell of window slot `ws`
fn cont_cell_x(c: *mut Ctx, s: i32, ws: i32) -> i32 {
    if cont_kind(c) >= 0 {
        var vx: i32 = 0
        var vy: i32 = 0
        mc_cont_ui.cui_slot_xy(cont_kind(c), mc_inv.inv_window_slots(&(*c).inv), ws, &vx, &vy)
        return cont_px(c, s) + vx * s
    }
    let n: i32 = mc_inv.inv_window_slots(&(*c).inv)
    let kc: i32 = cont_cols(c)
    var col: i32 = ws - (ws / kc) * kc
    var off: i32 = ((9 - kc) * 20 * s) / 2 // a narrow container (hopper 5, dispenser 3) is centred above the 9 wide inventory
    if ws >= n && ws < n + 27 {
        let k: i32 = ws - n
        col = k - (k / 9) * 9
        off = 0
    } else if ws >= n + 27 {
        col = ws - n - 27
        off = 0
    }
    return cont_px(c, s) + 4 * s + off + col * 20 * s
}

fn cont_cell_y(c: *mut Ctx, s: i32, ws: i32) -> i32 {
    if cont_kind(c) >= 0 {
        var vx: i32 = 0
        var vy: i32 = 0
        mc_cont_ui.cui_slot_xy(cont_kind(c), mc_inv.inv_window_slots(&(*c).inv), ws, &vx, &vy)
        return cont_py(c, s) + vy * s
    }
    let n: i32 = mc_inv.inv_window_slots(&(*c).inv)
    let py: i32 = cont_py(c, s)
    if ws < n { return py + 14 * s + (ws / cont_cols(c)) * 20 * s }
    let ymain: i32 = py + 14 * s + cont_rows(c) * 20 * s + 14 * s
    if ws < n + 27 { return ymain + ((ws - n) / 9) * 20 * s }
    return ymain + 3 * 20 * s + 4 * s
}

// window slot under the mouse, -1 = on the panel but no slot, CLICK_OUTSIDE (-999) = outside
fn ui_cont_slot_at(c: *mut Ctx, s: i32) -> i32 {
    let px: i32 = cont_px(c, s)
    let py: i32 = cont_py(c, s)
    let mx: i32 = raw.mouse_x(&(*c).rw) as i32
    let my: i32 = raw.mouse_y(&(*c).rw) as i32
    if mx < px || my < py || mx >= px + cont_pw(c, s) || my >= py + cont_ph(c, s) { return 0 - 999 }
    let total: i32 = mc_inv.inv_window_slots(&(*c).inv) + 36
    var ws: i32 = 0
    while ws < total {
        let gx: i32 = cont_cell_x(c, s, ws)
        let gy: i32 = cont_cell_y(c, s, ws)
        var cell: i32 = 19 * s
        if cont_kind(c) >= 0 { cell = 16 * s }
        if mx >= gx && my >= gy && mx < gx + cell && my < gy + cell { return ws }
        ws = ws + 1
    }
    return 0 - 1
}

fn draw_container_extras(c: *mut Ctx, r: *mut mc_raster.Raster, n: i32, px: i32, py: i32, s: i32) {
    var v: mc_cont_ui.ContView = mc_cont_ui.cview_new()
    var k: i32 = 0
    while k < 12 {
        v.props[k as usize] = mc_inv.inv_prop(&(*c).inv, k)
        k = k + 1
    }
    k = 0
    while k < 5 && k < n {
        let ik: i32 = mc_inv.inv_win_to_int(&(*c).inv, k)
        v.present[k as usize] = ik >= 0 && mc_inv.inv_item(&(*c).inv, ik) >= 0 && mc_inv.inv_count(&(*c).inv, ik) > 0
        k = k + 1
    }
    if n > 1 {
        let lk: i32 = mc_inv.inv_win_to_int(&(*c).inv, 1)
        if lk >= 0 { v.lapis = mc_inv.inv_count(&(*c).inv, lk) }
    }
    v.mx = raw.mouse_x(&(*c).rw) as i32
    v.my = raw.mouse_y(&(*c).rw) as i32
    v.creative = (*c).creative
    v.tick = now_ms()
    v.xp = (*c).hudp.st.level
    v.edit = anvil_focus(c)
    v.name_p = mc_cont_act.act_name_ptr(&(*c).cact)
    v.name_n = mc_cont_act.act_name_len(&(*c).cact)
    v.name_cur = mc_cont_act.act_name_cursor(&(*c).cact)
    mc_cont_ui.cui_draw_extras(r, &(*c).cui, cont_kind(c), n, px, py, s, &v)
    mc_cont_ui.cview_free(&v)
}

fn trades_live(c: *mut Ctx) -> bool {
    return mc_trade.tr_window(&(*c).trades) == mc_inv.inv_window(&(*c).inv) && mc_inv.inv_window(&(*c).inv) > 0
}

fn trade_item_at(c: *mut Ctx, px: i32, py: i32, s: i32) -> i32 {
    if !trades_live(c) { return 0 - 1 }
    return mc_trade_ui.tui_item_at(px, py, s, raw.mouse_x(&(*c).rw) as i32, raw.mouse_y(&(*c).rw) as i32, mc_trade.tr_visible(&(*c).trades))
}

fn draw_trade_items(c: *mut Ctx, r: *mut mc_raster.Raster, px: i32, py: i32, s: i32) {
    let t: *mut mc_trade.Trades = &(*c).trades
    let rows: i32 = mc_trade.tr_visible(t)
    var row: i32 = 0
    while row < rows {
        let idx: i32 = mc_trade.tr_index_of_row(t, row)
        var x: i32 = 0
        var y: i32 = 0
        mc_trade_ui.tui_item_xy(row, mc_trade_ui.TUI_COST_A, &x, &y)
        let base_a: i32 = mc_trade.tr_base_a(t, idx)
        let cost_a: i32 = mc_trade.tr_cost_a(t, idx)
        if base_a == cost_a {
            draw_slot_label(c, r, px + (x - 2) * s, py + (y - 2) * s, s, mc_trade.tr_item_a(t, idx), cost_a)
        } else {
            draw_slot_label(c, r, px + (x - 2) * s, py + (y - 2) * s, s, mc_trade.tr_item_a(t, idx), base_a)
            mc_inv_ui.iui_count_col(r, px + (x + 14) * s, py + y * s, s, cost_a, 0xFFFFFFFF as u32)
            mc_trade_ui.tui_draw_strike(r, &(*c).tui, px, py, s, row)
        }
        mc_trade_ui.tui_item_xy(row, mc_trade_ui.TUI_COST_B, &x, &y)
        draw_slot_label(c, r, px + (x - 2) * s, py + (y - 2) * s, s, mc_trade.tr_item_b(t, idx), mc_trade.tr_count_b(t, idx))
        mc_trade_ui.tui_item_xy(row, mc_trade_ui.TUI_RESULT, &x, &y)
        draw_slot_label(c, r, px + (x - 2) * s, py + (y - 2) * s, s, mc_trade.tr_item_r(t, idx), mc_trade.tr_count_r(t, idx))
        row = row + 1
    }
}

fn draw_trades(c: *mut Ctx, r: *mut mc_raster.Raster, px: i32, py: i32, s: i32, tp: u64, tn: usize) {
    let mx: i32 = raw.mouse_x(&(*c).rw) as i32
    let my: i32 = raw.mouse_y(&(*c).rw) as i32
    if !trades_live(c) {
        mc_trade_ui.tui_draw(r, &(*c).tui, &(*c).trades, px, py, s, mx, my, tp, tn)
        return
    }
    mc_trade_ui.tui_draw(r, &(*c).tui, &(*c).trades, px, py, s, mx, my, tp, tn)
    draw_trade_items(c, r, px, py, s)
    let hit: i32 = trade_item_at(c, px, py, s)
    if hit < 0 || mc_inv.inv_cursor_item(&(*c).inv) >= 0 { return }
    let t: *mut mc_trade.Trades = &(*c).trades
    let idx: i32 = mc_trade.tr_index_of_row(t, hit / 3)
    var item: i32 = mc_trade.tr_item_a(t, idx)
    if hit % 3 == 1 { item = mc_trade.tr_item_b(t, idx) }
    if hit % 3 == 2 { item = mc_trade.tr_item_r(t, idx) }
    if item >= 0 { draw_item_tooltip(c, r, mx, my, s, item, 0 - 1) }
}

fn trade_input(c: *mut Ctx, btn: i32) -> bool {
    if !trades_live(c) { return false }
    let s: i32 = mc_hud.hud_scale((*c).w, (*c).h)
    let px: i32 = cont_px(c, s)
    let py: i32 = cont_py(c, s)
    let mx: i32 = raw.mouse_x(&(*c).rw) as i32
    let my: i32 = raw.mouse_y(&(*c).rw) as i32
    if btn != 0 { return false }
    let used: bool = mc_trade_act.ta_press(&(*c).tact, &(*c).trades, &(*c).cl, px, py, s, mx, my)
    if used && cont_log(c) { say(f"mcplay: trade click sel={mc_trade.tr_selected(&(*c).trades)} sent={(*c).tact.sent} scroll={mc_trade.tr_scroll(&(*c).trades)}\n") }
    return used
}

fn trade_frame(c: *mut Ctx) {
    if cont_kind(c) != mc_cont_ui.KIND_MERCHANT || !trades_live(c) {
        mc_trade_act.ta_release(&(*c).tact)
        return
    }
    let s: i32 = mc_hud.hud_scale((*c).w, (*c).h)
    mc_trade_act.ta_drag(&(*c).tact, &(*c).trades, cont_py(c, s), s, raw.mouse_y(&(*c).rw) as i32, raw.mouse_down(&(*c).rw, raw.MB_LEFT))
    mc_trade_act.ta_wheel(&(*c).trades, raw.wheel_y(&(*c).rw))
}

fn draw_container_vanilla(c: *mut Ctx, r: *mut mc_raster.Raster, s: i32) {
    let px: i32 = cont_px(c, s)
    let py: i32 = cont_py(c, s)
    let n: i32 = mc_inv.inv_window_slots(&(*c).inv)
    var tn: usize = 0
    let tp: u64 = mc_inv.inv_window_title(&(*c).inv, &tn)
    mc_cont_ui.cui_draw(r, &(*c).cui, cont_kind(c), n, px, py, s, tp, tn)
    draw_container_extras(c, r, n, px, py, s)
    if cont_kind(c) == mc_cont_ui.KIND_MERCHANT { draw_trades(c, r, px, py, s, tp, tn) }
    let mx: i32 = raw.mouse_x(&(*c).rw) as i32
    let my: i32 = raw.mouse_y(&(*c).rw) as i32
    let hover: i32 = ui_cont_slot_at(c, s)
    var ws: i32 = 0
    while ws < n + 36 {
        let gx: i32 = cont_cell_x(c, s, ws)
        let gy: i32 = cont_cell_y(c, s, ws)
        let k: i32 = mc_inv.inv_win_to_int(&(*c).inv, ws)
        draw_win_slot(c, r, s, gx, gy, ws, k)
        if ws == hover { mc_hud.hud_rect(r, gx, gy, 16 * s, 16 * s, 0x80FFFFFF as u32) }
        ws = ws + 1
    }
    draw_cursor_stack(c, r, s, mx, my)
    if hover >= 0 { draw_slot_tooltip(c, r, s, mc_inv.inv_win_to_int(&(*c).inv, hover)) }
    if cont_kind(c) == mc_cont_ui.KIND_ENCHANT { draw_enchant_tooltip(c, r, s, px, py, mx, my) }
}

fn draw_enchant_tooltip(c: *mut Ctx, r: *mut mc_raster.Raster, s: i32, px: i32, py: i32, mx: i32, my: i32) {
    let idx: i32 = mc_cont_ui.cui_enchant_at(px, py, s, mx, my)
    if idx < 0 { return }
    let ik: i32 = mc_inv.inv_win_to_int(&(*c).inv, 0)
    if ik < 0 || mc_inv.inv_count(&(*c).inv, ik) <= 0 { return }
    var props: [i32; 12] = [0; 12]
    var k: i32 = 0
    while k < 12 {
        props[k as usize] = mc_inv.inv_prop(&(*c).inv, k)
        k = k + 1
    }
    var lapis: i32 = 0
    let lk: i32 = mc_inv.inv_win_to_int(&(*c).inv, 1)
    if lk >= 0 && mc_inv.inv_count(&(*c).inv, lk) > 0 { lapis = mc_inv.inv_count(&(*c).inv, lk) }
    var en: usize = 0
    let ep: u64 = mc_client.client_enchant_names(&(*c).cl, &en)
    var t: mc_tip_lines.TipLines = mc_tip_lines.tl_new()
    mc_enchant_tip.et_build(&t, idx, (&props[0]) as u64, lapis, (*c).hudp.st.level, (*c).creative, (*c).cl.ver.protocol, ep, en)
    mc_inv_tooltip.tip_draw_lines(r, mx, my, s, &t)
    mc_tip_lines.tl_free(&t)
}

fn draw_container(c: *mut Ctx, r: *mut mc_raster.Raster) {
    let s: i32 = mc_hud.hud_scale((*c).w, (*c).h)
    if cont_kind(c) >= 0 {
        draw_container_vanilla(c, r, s)
        return
    }
    let px: i32 = cont_px(c, s)
    let py: i32 = cont_py(c, s)
    mc_hud.hud_rect(r, px, py, cont_pw(c, s), cont_ph(c, s), 0xC8000000 as u32)
    var tn: usize = 0
    let tp: u64 = mc_inv.inv_window_title(&(*c).inv, &tn)
    if tn > 0 {
        mc_hud_text.htext(r, px + 4 * s, py + 3 * s, s, 0xFFFFFFFF as u32, 0xFF3F3F3F as u32, str { p: tp as *u8, n: tn })
    } else {
        mc_hud_text.htext(r, px + 4 * s, py + 3 * s, s, 0xFFFFFFFF as u32, 0xFF3F3F3F as u32, "Container")
    }
    mc_hud_text.htext(r, px + 4 * s, py + 14 * s + cont_rows(c) * 20 * s + 3 * s, s, 0xFFFFFFFF as u32, 0xFF3F3F3F as u32, "Inventory")
    let total: i32 = mc_inv.inv_window_slots(&(*c).inv) + 36
    var ws: i32 = 0
    while ws < total {
        let gx: i32 = cont_cell_x(c, s, ws)
        let gy: i32 = cont_cell_y(c, s, ws)
        let k: i32 = mc_inv.inv_win_to_int(&(*c).inv, ws)
        mc_hud.hud_rect(r, gx, gy, 19 * s, 19 * s, 0x60808080 as u32)
        if k >= 0 { arm_slot(c, k) }
        if k >= 0 { draw_slot_label(c, r, gx - s, gy - s, s, mc_inv.inv_item(&(*c).inv, k), mc_inv.inv_count(&(*c).inv, k)) }
        ws = ws + 1
    }
    arm_cursor(c)
    draw_slot_label(c, r, (raw.mouse_x(&(*c).rw) as i32) - 8 * s, (raw.mouse_y(&(*c).rw) as i32) - 8 * s, s, mc_inv.inv_cursor_item(&(*c).inv), mc_inv.inv_cursor_count(&(*c).inv))
}

fn anvil_focus(c: *mut Ctx) -> bool {
    if !(*c).show_inv || (*c).chat.open || (*c).health.dead || mc_pause.pause_active() { return false }
    return cont_kind(c) == mc_cont_ui.KIND_ANVIL
}

fn cont_log(c: *mut Ctx) -> bool { return env_flag("MCPLAY_CONT_LOG", false) }

fn anvil_char(c: *mut Ctx, code: u32) {
    if !anvil_focus(c) || raw.key_down(&(*c).rw, raw.KEY_LEFTCTRL) { return }
    if mc_cont_act.act_name_char(&(*c).cact, &(*c).cl, code) && cont_log(c) {
        say(f"mcplay: anvil name n={mc_cont_act.act_name_len(&(*c).cact)} sent={(*c).cact.sent_name}\n")
    }
}

fn anvil_keys(c: *mut Ctx) {
    if cont_kind(c) != mc_cont_ui.KIND_ANVIL || !ui_cont_open(c) { return }
    anvil_sync_name(c)
    if !anvil_focus(c) { return }
    if raw.key_pressed(&(*c).rw, 14 as u32) { mc_cont_act.act_name_backspace(&(*c).cact, &(*c).cl) }
    if raw.key_pressed(&(*c).rw, 111 as u32) { mc_cont_act.act_name_delete(&(*c).cact, &(*c).cl) }
    if raw.key_pressed(&(*c).rw, 105 as u32) { mc_cont_act.act_name_left(&(*c).cact) }
    if raw.key_pressed(&(*c).rw, 106 as u32) { mc_cont_act.act_name_right(&(*c).cact) }
    if raw.key_pressed(&(*c).rw, 102 as u32) { mc_cont_act.act_name_home(&(*c).cact) }
    if raw.key_pressed(&(*c).rw, 107 as u32) { mc_cont_act.act_name_end(&(*c).cact) }
    if raw.key_down(&(*c).rw, raw.KEY_LEFTCTRL) && raw.key_pressed(&(*c).rw, raw.KEY_A) { mc_cont_act.act_name_wipe(&(*c).cact, &(*c).cl) }
}

fn anvil_sync_name(c: *mut Ctx) {
    let k: i32 = mc_inv.inv_win_to_int(&(*c).inv, 0)
    var item: i32 = 0 - 1
    if k >= 0 && mc_inv.inv_count(&(*c).inv, k) > 0 { item = mc_inv.inv_item(&(*c).inv, k) }
    var name: rt.Buf = rt.buf_new()
    if item >= 0 {
        var n: usize = 0
        let p: u64 = mc_registry.reg_item_name(&(*c).reg, item, &n)
        var rp: u64 = 0
        var rn: usize = 0
        mc_inv.inv_slot_meta(&(*c).inv, k, &rp, &rn)
        mc_item_tip.tip_name_text(rp, rn, p, n, &name)
    }
    let before: i32 = (*c).cact.item
    mc_cont_act.act_name_sync_named(&(*c).cact, &(*c).cl, mc_inv.inv_window(&(*c).inv), item, rt.buf_ptr(&name), rt.buf_len(&name))
    if cont_log(c) && before != (*c).cact.item && item >= 0 { say(f"mcplay: anvil prefill n={mc_cont_act.act_name_len(&(*c).cact)}\n") }
    rt.buf_free(&name)
}

fn enchant_click(c: *mut Ctx) -> bool {
    let s: i32 = mc_hud.hud_scale((*c).w, (*c).h)
    let idx: i32 = mc_cont_ui.cui_enchant_at(cont_px(c, s), cont_py(c, s), s, raw.mouse_x(&(*c).rw) as i32, raw.mouse_y(&(*c).rw) as i32)
    if idx < 0 { return false }
    var lapis: i32 = 0
    let lk: i32 = mc_inv.inv_win_to_int(&(*c).inv, 1)
    if lk >= 0 && mc_inv.inv_item(&(*c).inv, lk) >= 0 { lapis = mc_inv.inv_count(&(*c).inv, lk) }
    let ik: i32 = mc_inv.inv_win_to_int(&(*c).inv, 0)
    if ik < 0 || mc_inv.inv_item(&(*c).inv, ik) < 0 { return true }
    let cost: i32 = mc_inv.inv_prop(&(*c).inv, idx)
    let sent: bool = mc_cont_act.act_enchant_click(&(*c).cact, &(*c).cl, mc_inv.inv_window(&(*c).inv), idx, cost, lapis, (*c).hudp.st.level, (*c).creative)
    if cont_log(c) { say(f"mcplay: enchant click idx={idx} cost={cost} lapis={lapis} xp={(*c).hudp.st.level} sent={sent}\n") }
    return true
}

// open / close the panel: the mouse is released while it is open and captured again afterwards
fn ui_set_open(c: *mut Ctx, on: bool) {
    if on == (*c).show_inv { return }
    (*c).show_inv = on
    (*c).idrag = mc_inv_drag.idrag_new()
    if on {
        (*c).ui_regrab = (*c).grab
        if (*c).grab { grab_mouse(c, false) }
    } else {
        if (*c).ui_regrab { grab_mouse(c, true) }
        (*c).ui_regrab = false
    }
}

// E / Esc: close the panel (and a container window with a Close Window packet)
fn ui_close(c: *mut Ctx) {
    log_creative_state(c)
    if env_flag("MCPLAY_CHEST_UI", false) && ui_cont_open(c) {
        let v: *mut mc_inv.Inv = &(*c).inv
        say(f"mcplay: chestui state c0={mc_inv.inv_win_item(v, 0)} c1={mc_inv.inv_win_item(v, 1)}x{mc_inv.inv_win_count(v, 1)} c5={mc_inv.inv_win_item(v, 5)}x{mc_inv.inv_win_count(v, 5)} c26={mc_inv.inv_win_item(v, 26)} h0={mc_inv.inv_item(v, 36)}x{mc_inv.inv_count(v, 36)} h1={mc_inv.inv_item(v, 37)} cursor={mc_inv.inv_cursor_item(v)}x{mc_inv.inv_cursor_count(v)} clicks={(*c).inv.n_clicks}\n")
    }
    if env_int("MCPLAY_CONT_UI", 0) > 0 && ui_cont_open(c) {
        let v: *mut mc_inv.Inv = &(*c).inv
        say(f"mcplay: contui state kind={cont_kind(c)} w0={mc_inv.inv_win_item(v, 0)}x{mc_inv.inv_win_count(v, 0)} w1={mc_inv.inv_win_item(v, 1)}x{mc_inv.inv_win_count(v, 1)} w2={mc_inv.inv_win_item(v, 2)}x{mc_inv.inv_win_count(v, 2)} cost={mc_inv.inv_prop(v, 0)} name_n={mc_cont_act.act_name_len(&(*c).cact)} sent_name={(*c).cact.sent_name} sent_button={(*c).cact.sent_button}\n")
    }
    if mc_inv.inv_window(&(*c).inv) != 0 { mc_inv.inv_close_window(&(*c).cl, &(*c).inv) }
    (*c).cont_ui = false
    ui_set_open(c, false)
}

// every frame: a container window opened by the server shows the panel, its Close Window (or a local close) hides it;
// a window type we cannot model (furnace, anvil ...) is closed right away so the server does not wait for clicks
fn ui_sync(c: *mut Ctx) {
    let w: i32 = mc_inv.inv_window(&(*c).inv)
    if w != 0 && mc_inv.inv_window_slots(&(*c).inv) <= 0 {
        say(f"mcplay: window {w} is not supported, closing it\n")
        mc_inv.inv_close_window(&(*c).cl, &(*c).inv)
        return
    }
    if w != 0 && !(*c).cont_ui {
        (*c).cont_ui = true
        ui_set_open(c, true)
    } else if w == 0 && (*c).cont_ui {
        (*c).cont_ui = false
        ui_set_open(c, false)
    }
}

// Inventory panel (same geometry as draw_inventory): slot under the mouse, -1 = on the panel but no slot, CLICK_OUTSIDE (-999) = outside
fn ui_slot_at(c: *mut Ctx) -> i32 {
    let s: i32 = mc_hud.hud_scale((*c).w, (*c).h)
    if ui_cont_open(c) { return ui_cont_slot_at(c, s) }
    if mc_inv_ui.iui_ok(&(*c).iui) { return mc_inv_ui.iui_slot_at(player_px(c, s), player_py(c, s), s, raw.mouse_x(&(*c).rw) as i32, raw.mouse_y(&(*c).rw) as i32) }
    let pw: i32 = 9 * 20 * s + 8 * s
    let ph: i32 = 5 * 20 * s + 20 * s
    let px: i32 = ((*c).w - pw) / 2
    let py: i32 = ((*c).h - ph) / 2
    let mx: i32 = raw.mouse_x(&(*c).rw) as i32
    let my: i32 = raw.mouse_y(&(*c).rw) as i32
    if mx < px || my < py || mx >= px + pw || my >= py + ph { return 0 - 999 }
    var row: i32 = 0
    while row < 4 {
        var col: i32 = 0
        while col < 9 {
            var slot: i32 = mc_inv.INV_MAIN0 + row * 9 + col
            var gy: i32 = py + 14 * s + row * 20 * s
            if row == 3 {
                slot = mc_inv.INV_HOTBAR0 + col
                gy = gy + 4 * s
            }
            let gx: i32 = px + 4 * s + col * 20 * s
            if mx >= gx && my >= gy && mx < gx + 19 * s && my < gy + 19 * s { return slot }
            col = col + 1
        }
        row = row + 1
    }
    return 0 - 1
}

fn if_mb(btn: i32) -> u32 {
    if btn == 1 { return raw.MB_RIGHT }
    return raw.MB_LEFT
}

fn plain_container(c: *mut Ctx) -> bool {
    let kind: i32 = cont_kind(c)
    return kind == mc_cont_ui.KIND_GENERIC || kind == mc_cont_ui.KIND_DISPENSER || kind == mc_cont_ui.KIND_HOPPER
}

fn shift_down(c: *mut Ctx) -> bool {
    return raw.key_down(&(*c).rw, 42 as u32) || raw.key_down(&(*c).rw, 54 as u32)
}

fn quick_move_all(c: *mut Ctx, slot: i32) -> bool {
    var lo: i32 = 0
    var hi: i32 = 0
    if !mc_inv_multi.imulti_group(&(*c).inv, slot, plain_container(c), &lo, &hi) { return false }
    mc_inv_multi.imulti_quick_all(&(*c).cl, &(*c).inv, lo, hi, (*c).last_quick_item, (*c).last_quick_sig)
    return true
}

fn remember_quick(c: *mut Ctx, slot: i32) {
    (*c).last_quick_item = 0 - 1
    let k: i32 = mc_inv.inv_win_to_int(&(*c).inv, slot)
    if k < 0 || mc_inv.inv_count(&(*c).inv, k) <= 0 { return }
    (*c).last_quick_item = mc_inv.inv_item(&(*c).inv, k)
    (*c).last_quick_sig = mc_inv.inv_sig(&(*c).inv, k)
}

fn ui_click_now(c: *mut Ctx, btn: i32, slot: i32) {
    var mode: i32 = 0
    let now: u64 = now_ms()
    let twice: bool = btn == 0 && slot >= 0 && slot == (*c).last_click_slot && now - (*c).last_click_t < 250 as u64
    if shift_down(c) && slot >= 0 {
        if twice && (*c).last_quick_item >= 0 && quick_move_all(c, slot) {
            (*c).last_click_t = 0 as u64
            return
        }
        if btn == 0 { remember_quick(c, slot) }
        mode = 1
    }
    if mode == 0 && twice && mc_inv.inv_cursor_item(&(*c).inv) >= 0 {
        mode = 6
    }
    (*c).last_click_slot = slot
    (*c).last_click_t = now
    mc_inv.inv_click(&(*c).cl, &(*c).inv, slot, btn, mode)
}

fn ui_drag_events(c: *mut Ctx, slot: i32) {
    let ev: i32 = mc_inv_drag.idrag_hover(&(*c).idrag, slot)
    let typ: i32 = mc_inv_drag.idrag_type(&(*c).idrag)
    if ev == mc_inv_drag.EV_BEGIN {
        mc_inv.inv_drag_begin(&(*c).cl, &(*c).inv, typ)
        mc_inv.inv_drag_add(&(*c).cl, &(*c).inv, mc_inv_drag.idrag_start_slot(&(*c).idrag), typ)
        mc_inv.inv_drag_add(&(*c).cl, &(*c).inv, slot, typ)
    } else if ev == mc_inv_drag.EV_ADD {
        mc_inv.inv_drag_add(&(*c).cl, &(*c).inv, slot, typ)
    }
}

fn ui_inv_keys(c: *mut Ctx, slot: i32) {
    if slot < 0 || anvil_focus(c) { return }
    if mc_keybinds.kb_pressed(&(*c).kb, &(*c).rw, mc_keybinds.KB_DROP) && mc_inv.inv_cursor_item(&(*c).inv) < 0 {
        let all: bool = raw.key_down(&(*c).rw, 29 as u32)
        mc_inv.inv_drop_slot(&(*c).cl, &(*c).inv, slot, all)
        return
    }
    let hb: i32 = mc_keybinds.kb_hotbar_pressed(&(*c).kb, &(*c).rw)
    if hb >= 0 {
        mc_inv.inv_click(&(*c).cl, &(*c).inv, slot, hb, 2)
        return
    }
    if mc_keybinds.kb_pressed(&(*c).kb, &(*c).rw, mc_keybinds.KB_SWAP) {
        mc_inv.inv_click(&(*c).cl, &(*c).inv, slot, 40, 2)
    }
}

// Mouse in the open inventory panel: click on release, drag over slots with a carried stack (left = split evenly, right = one each), Q / number keys on the hovered slot
fn ui_inv_click(c: *mut Ctx) {
    trade_frame(c)
    if cr_active(c) {
        ui_creative_click(c)
        return
    }
    let slot: i32 = ui_slot_at(c)
    let d: *mut mc_inv_drag.InvDrag = &(*c).idrag
    if mc_inv_drag.idrag_held(d) {
        let b: u32 = if_mb(mc_inv_drag.idrag_button(d))
        if raw.mouse_down(&(*c).rw, b) {
            ui_drag_events(c, slot)
        } else {
            let rel: i32 = mc_inv_drag.idrag_release(d)
            if rel == mc_inv_drag.REL_END {
                mc_inv.inv_drag_end(&(*c).cl, &(*c).inv, mc_inv_drag.idrag_type(d))
            } else if rel == mc_inv_drag.REL_CLICK {
                ui_click_now(c, mc_inv_drag.idrag_button(d), mc_inv_drag.idrag_start_slot(d))
            }
        }
        return
    }
    var btn: i32 = 0 - 1
    if raw.mouse_pressed(&(*c).rw, raw.MB_LEFT) { btn = 0 }
    if raw.mouse_pressed(&(*c).rw, raw.MB_RIGHT) { btn = 1 }
    if btn < 0 {
        if raw.mouse_pressed(&(*c).rw, raw.MB_MIDDLE) && slot >= 0 && mc_inv.inv_cursor_item(&(*c).inv) < 0 {
            mc_inv.inv_click(&(*c).cl, &(*c).inv, slot, 2, mc_inv_multi.MODE_CLONE)
            return
        }
        ui_inv_keys(c, slot)
        return
    }
    if cont_kind(c) == mc_cont_ui.KIND_ENCHANT && enchant_click(c) { return }
    if cont_kind(c) == mc_cont_ui.KIND_MERCHANT && trade_input(c, btn) { return }
    if slot == 0 - 1 { return }
    let shift: bool = shift_down(c)
    if slot >= 0 && !shift && mc_inv.inv_cursor_item(&(*c).inv) >= 0 {
        mc_inv_drag.idrag_press(d, btn, slot)
        return
    }
    ui_click_now(c, btn, slot)
}

fn cr_active(c: *mut Ctx) -> bool {
    if !(*c).show_inv || ui_cont_open(c) || (*c).health.mode != 1 { return false }
    return env_flag("MCPLAY_CREATIVE_UI", true)
}

fn cr_prepare(c: *mut Ctx) {
    if mc_creative.cr_ready(&(*c).cr) { return }
    mc_creative.cr_build(&(*c).cr, &(*c).reg)
}

fn cr_px(c: *mut Ctx, s: i32) -> i32 { return mc_hud_vanilla.vh_center((*c).w, s, mc_creative_ui.crui_panel_w() * s) }

fn cr_py(c: *mut Ctx, s: i32) -> i32 { return mc_hud_vanilla.vh_center((*c).h, s, mc_creative_ui.crui_panel_h() * s) }

fn cr_icon_item(c: *mut Ctx, name: str) -> i32 {
    return mc_registry.reg_item_by_name(&(*c).reg, name.p as u64, name.n)
}

fn log_creative_cells(c: *mut Ctx, px: i32, py: i32, s: i32) {
    if (*c).cr_logged || !env_flag("MCPLAY_CREATIVE_LOG", false) { return }
    (*c).cr_logged = true
    var x: i32 = 0
    var y: i32 = 0
    var t: i32 = 0
    while t < mc_creative_rules.TAB_COUNT {
        mc_creative_ui.crui_tab_xy(t, &x, &y)
        say(f"mcplay: crui cell tab={t} x={px + (x + 13) * s} y={py + (y + 16) * s}\n")
        t = t + 1
    }
    say(f"mcplay: crui cell pick=0 x={px + 17 * s} y={py + 26 * s}\n")
    say(f"mcplay: crui cell pick=1 x={px + 35 * s} y={py + 26 * s}\n")
    say(f"mcplay: crui cell ws=36 x={px + 17 * s} y={py + 120 * s}\n")
    say(f"mcplay: crui cell ws=37 x={px + 35 * s} y={py + 120 * s}\n")
    say(f"mcplay: crui cell delete x={px + 181 * s} y={py + 120 * s}\n")
}

fn log_creative_state(c: *mut Ctx) {
    if !env_flag("MCPLAY_CREATIVE_LOG", false) || !cr_active(c) { return }
    let v: *mut mc_inv.Inv = &(*c).inv
    say(f"mcplay: crui state tab={mc_creative.cr_tab(&(*c).cr)} n={mc_creative.cr_count(&(*c).cr)} first={mc_creative.cr_item(&(*c).cr, 0)} h0={mc_inv.inv_item(v, 36)}x{mc_inv.inv_count(v, 36)} h1={mc_inv.inv_item(v, 37)}x{mc_inv.inv_count(v, 37)} cursor={mc_inv.inv_cursor_item(v)}x{mc_inv.inv_cursor_count(v)}\n")
}

fn draw_creative(c: *mut Ctx, r: *mut mc_raster.Raster, s: i32) {
    cr_prepare(c)
    let cr: *mut mc_creative.Creative = &(*c).cr
    let px: i32 = cr_px(c, s)
    let py: i32 = cr_py(c, s)
    let mx: i32 = raw.mouse_x(&(*c).rw) as i32
    let my: i32 = raw.mouse_y(&(*c).rw) as i32
    let tab: i32 = mc_creative.cr_tab(cr)
    mc_creative_ui.crui_draw(r, &(*c).crui, cr, px, py, s)
    log_creative_cells(c, px, py, s)
    let hit: i32 = mc_creative_ui.crui_hit(cr, px, py, s, mx, my)
    var t: i32 = 0
    while t < mc_creative_rules.TAB_COUNT {
        var ix: i32 = 0
        var iy: i32 = 0
        mc_creative_ui.crui_tab_icon_xy(t, &ix, &iy)
        draw_slot_label(c, r, px + (ix - 2) * s, py + (iy - 2) * s, s, cr_icon_item(c, mc_creative.cr_tab_icon(t)), 1)
        t = t + 1
    }
    var k: i32 = 0
    while k < mc_creative.CR_PAGE && tab != mc_creative_rules.TAB_INVENTORY {
        let gx: i32 = px + (9 + 18 * (k % 9)) * s
        let gy: i32 = py + (18 + 18 * (k / 9)) * s
        draw_slot_label(c, r, gx - 2 * s, gy - 2 * s, s, mc_creative.cr_item(cr, k), 1)
        if hit == mc_creative_ui.HIT_PICK0 + k { mc_hud.hud_rect(r, gx, gy, 16 * s, 16 * s, 0x80FFFFFF as u32) }
        k = k + 1
    }
    var ws: i32 = 0
    while ws < 46 {
        var x: i32 = 0
        var y: i32 = 0
        if mc_creative_ui.crui_slot_xy(tab, ws, &x, &y) {
            let gx: i32 = px + x * s
            let gy: i32 = py + y * s
            arm_slot(c, ws)
            draw_slot_label(c, r, gx - 2 * s, gy - 2 * s, s, mc_inv.inv_item(&(*c).inv, ws), mc_inv.inv_count(&(*c).inv, ws))
            if hit == ws { mc_hud.hud_rect(r, gx, gy, 16 * s, 16 * s, 0x80FFFFFF as u32) }
        }
        ws = ws + 1
    }
    arm_cursor(c)
    draw_slot_label(c, r, mx - 10 * s, my - 10 * s, s, mc_inv.inv_cursor_item(&(*c).inv), mc_inv.inv_cursor_count(&(*c).inv))
    if mc_inv.inv_cursor_item(&(*c).inv) >= 0 { return }
    if hit >= mc_creative_ui.HIT_TAB0 && hit < mc_creative_ui.HIT_TAB0 + mc_creative_rules.TAB_COUNT {
        let title: str = mc_creative.cr_tab_title(hit - mc_creative_ui.HIT_TAB0)
        mc_inv_tooltip.tip_draw(r, mx, my, s, title.p as u64, title.n)
        return
    }
    var item: i32 = 0 - 1
    if hit >= mc_creative_ui.HIT_PICK0 && hit < mc_creative_ui.HIT_PICK0 + mc_creative.CR_PAGE { item = mc_creative.cr_item(cr, hit - mc_creative_ui.HIT_PICK0) }
    if hit >= 0 && hit < 46 { item = mc_inv.inv_item(&(*c).inv, hit) }
    if item < 0 { return }
    var slot: i32 = 0 - 1
    if hit >= 0 && hit < 46 { slot = hit }
    draw_item_tooltip(c, r, mx, my, s, item, slot)
}

fn ui_creative_keys(c: *mut Ctx, hit: i32) {
    let cr: *mut mc_creative.Creative = &(*c).cr
    if raw.key_pressed(&(*c).rw, 14 as u32) && mc_creative.cr_focus(cr) { mc_creative.cr_query_pop(cr, &(*c).reg) }
    if mc_creative.cr_focus(cr) { return }
    if hit >= mc_creative_ui.HIT_PICK0 && hit < mc_creative_ui.HIT_PICK0 + mc_creative.CR_PAGE {
        let k: i32 = hit - mc_creative_ui.HIT_PICK0
        let hb: i32 = mc_keybinds.kb_hotbar_pressed(&(*c).kb, &(*c).rw)
        if hb >= 0 { mc_creative_act.cra_key_swap(&(*c).cl, cr, &(*c).reg, &(*c).inv, k, hb, true) }
        if mc_keybinds.kb_pressed(&(*c).kb, &(*c).rw, mc_keybinds.KB_DROP) {
            mc_creative_act.cra_drop_pick(&(*c).cl, cr, &(*c).reg, k, raw.key_down(&(*c).rw, 29 as u32), true)
        }
    } else if hit >= 0 && hit < 46 && mc_creative.cr_tab(cr) == mc_creative_rules.TAB_INVENTORY {
        ui_inv_keys(c, hit)
    }
}

fn ui_creative_click(c: *mut Ctx) {
    cr_prepare(c)
    let cr: *mut mc_creative.Creative = &(*c).cr
    let s: i32 = mc_hud.hud_scale((*c).w, (*c).h)
    let px: i32 = cr_px(c, s)
    let py: i32 = cr_py(c, s)
    let mx: i32 = raw.mouse_x(&(*c).rw) as i32
    let my: i32 = raw.mouse_y(&(*c).rw) as i32
    let hit: i32 = mc_creative_ui.crui_hit(cr, px, py, s, mx, my)
    let wy: i64 = raw.wheel_y(&(*c).rw)
    if wy != 0 as i64 && mc_creative.cr_has_scrollbar(cr) {
        var d: i32 = 1
        if wy > 0 as i64 { d = 0 - 1 }
        mc_creative.cr_scroll_rows(cr, d)
    }
    if (*c).cr_sdrag {
        if raw.mouse_down(&(*c).rw, raw.MB_LEFT) {
            mc_creative.cr_set_scroll_from_px(cr, (my - (py + 18 * s)) / s, 112, 15)
        } else {
            (*c).cr_sdrag = false
        }
        return
    }
    var btn: i32 = 0 - 1
    if raw.mouse_pressed(&(*c).rw, raw.MB_LEFT) { btn = 0 }
    if raw.mouse_pressed(&(*c).rw, raw.MB_RIGHT) { btn = 1 }
    if raw.mouse_pressed(&(*c).rw, raw.MB_MIDDLE) { btn = 2 }
    if btn < 0 {
        ui_creative_keys(c, hit)
        return
    }
    let shift: bool = raw.key_down(&(*c).rw, 42 as u32)
    let tab: i32 = mc_creative.cr_tab(cr)
    if hit >= mc_creative_ui.HIT_TAB0 && hit < mc_creative_ui.HIT_TAB0 + mc_creative_rules.TAB_COUNT {
        mc_creative.cr_select(cr, &(*c).reg, hit - mc_creative_ui.HIT_TAB0)
    } else if hit == mc_creative_ui.HIT_SCROLL && btn == 0 {
        (*c).cr_sdrag = true
        mc_creative.cr_set_scroll_from_px(cr, (my - (py + 18 * s)) / s, 112, 15)
    } else if hit == mc_creative_ui.HIT_SEARCH {
        mc_creative.cr_set_focus(cr, true)
    } else if hit >= mc_creative_ui.HIT_PICK0 && hit < mc_creative_ui.HIT_PICK0 + mc_creative.CR_PAGE {
        mc_creative_act.cra_pick(cr, &(*c).reg, &(*c).inv, hit - mc_creative_ui.HIT_PICK0, btn, shift)
    } else if hit == mc_creative_ui.HIT_DELETE {
        mc_creative_act.cra_delete(&(*c).cl, &(*c).inv, shift, true)
    } else if hit == mc_creative_ui.HIT_OUTSIDE {
        if tab == mc_creative_rules.TAB_INVENTORY {
            if btn < 2 { ui_click_now(c, btn, 0 - 999) }
        } else {
            mc_creative_act.cra_outside(&(*c).cl, &(*c).inv, btn, true)
        }
    } else if hit >= 0 && hit < 46 && btn < 2 {
        if tab == mc_creative_rules.TAB_INVENTORY {
            ui_click_now(c, btn, hit)
        } else {
            mc_creative_act.cra_slot(&(*c).cl, &(*c).reg, &(*c).inv, hit, btn, true)
        }
    }
}

// MCPLAY_CLICK_TEST=1 (survival, after `give <name> stone 32`): picks the stack of 32 up, puts it into slot 10, takes half, puts that
// into slot 11, drops one from slot 10 -> expected 15 in slot 10, 16 in slot 11 (the harness compares with the server's inventory).
fn click_test(c: *mut Ctx) {
    let now: u64 = now_ms()
    if (*c).click_phase >= 7 { return }
    if (*c).click_phase > 0 && now - (*c).click_t < 350 as u64 { return }
    let cl: *mut mc_client.Client = &(*c).cl
    if (*c).click_phase == 0 {
        var k: i32 = 0
        while k < 36 && (*c).click_src < 0 {
            if mc_inv.inv_count(&(*c).inv, 9 + k) == 32 { (*c).click_src = 9 + k }
            k = k + 1
        }
        if (*c).click_src < 0 { return }
        mc_inv.inv_click(cl, &(*c).inv, (*c).click_src, 0, 0)
    } else if (*c).click_phase == 1 {
        mc_inv.inv_click(cl, &(*c).inv, 10, 0, 0)
    } else if (*c).click_phase == 2 {
        mc_inv.inv_click(cl, &(*c).inv, 10, 1, 0)
    } else if (*c).click_phase == 3 {
        mc_inv.inv_click(cl, &(*c).inv, 11, 0, 0)
    } else if (*c).click_phase == 4 {
        mc_inv.inv_drop_slot(cl, &(*c).inv, 10, false)
    } else if (*c).click_phase == 5 {
        say(f"mcplay: clicktest src={(*c).click_src} slot10={mc_inv.inv_item(&(*c).inv, 10)}x{mc_inv.inv_count(&(*c).inv, 10)} slot11={mc_inv.inv_item(&(*c).inv, 11)}x{mc_inv.inv_count(&(*c).inv, 11)} cursor={mc_inv.inv_cursor_item(&(*c).inv)}x{mc_inv.inv_cursor_count(&(*c).inv)} clicks={(*c).inv.n_clicks}\n")
    }
    (*c).click_phase = (*c).click_phase + 1
    (*c).click_t = now
}

// MCPLAY_HASH_TEST=1 (survival, after `give <name> diamond_pickaxe[<components>]` and `give <name> stone 32`; MCPLAY_HASH_OFF=1 sends the hashes empty):
// picks up and puts back first the stack WITH components, then the plain stack, and counts the packets the server answers with (a hash the server
// does not recognise makes it re-send the slot). Prints `mcplay: hashtest comp_pick=N comp_put=N plain_pick=N plain_put=N`; 0 everywhere = accepted.
fn hash_test(c: *mut Ctx) {
    let now: u64 = now_ms()
    if (*c).ht_phase >= 5 { return }
    if (*c).ht_phase > 0 && now - (*c).ht_t < 1500 as u64 { return }
    let cl: *mut mc_client.Client = &(*c).cl
    let v: *mut mc_inv.Inv = &(*c).inv
    mc_inv.inv_hash_off(v, env_flag("MCPLAY_HASH_OFF", false))
    let ph: i32 = (*c).ht_phase
    if ph == 0 {
        var k: i32 = 0
        while k < 36 {
            let sl: i32 = 9 + k
            if mc_inv.inv_item(v, sl) >= 0 && mc_inv.inv_sig(v, sl) != 0 && (*c).ht_a < 0 { (*c).ht_a = sl }
            if mc_inv.inv_item(v, sl) >= 0 && mc_inv.inv_sig(v, sl) == 0 && mc_inv.inv_count(v, sl) == 32 && (*c).ht_b < 0 { (*c).ht_b = sl }
            k = k + 1
        }
        if (*c).ht_a < 0 || (*c).ht_b < 0 { return }
    } else {
        (*c).ht_d[(ph - 1) as usize] = ((*v).n_srv - (*c).ht_n0) as i32
    }
    (*c).ht_n0 = (*v).n_srv
    if ph < 4 {
        var sl2: i32 = (*c).ht_a
        if ph >= 2 { sl2 = (*c).ht_b }
        mc_inv.inv_click(cl, v, sl2, 0, 0)
    } else {
        say(f"mcplay: hashtest comp_pick={(*c).ht_d[0]} comp_put={(*c).ht_d[1]} plain_pick={(*c).ht_d[2]} plain_put={(*c).ht_d[3]} clicks={(*v).n_clicks} sig={mc_inv.inv_sig(v, (*c).ht_a)}\n")
    }
    (*c).ht_phase = ph + 1
    (*c).ht_t = now
}

// MCPLAY_CLICK_TEST2=1 (survival, after `give <name> stone 64`, `give <name> stone 40`, `give <name> dirt 10`): shift click (40 stone and the dirt
// to the main inventory, the 64 stone then merges into the 40 and overflows), drag (40 stone over three slots), double click (collects them again)
// -> expected: slot 9 = 40 stone, slot 10 = 10 dirt, slot 11 = 64 stone (the harness compares with the server's inventory).
fn click_test2(c: *mut Ctx) {
    let now: u64 = now_ms()
    if (*c).ct2_phase >= 14 { return }
    if (*c).ct2_phase > 0 && now - (*c).ct2_t < 450 as u64 { return }
    let cl: *mut mc_client.Client = &(*c).cl
    let v: *mut mc_inv.Inv = &(*c).inv
    var ph: i32 = (*c).ct2_phase
    if ph == 0 {
        var k: i32 = 36
        while k < 45 {
            if mc_inv.inv_count(v, k) == 64 { (*c).ct2_a = k }
            if mc_inv.inv_count(v, k) == 40 { (*c).ct2_b = k }
            if mc_inv.inv_count(v, k) == 10 { (*c).ct2_d = k }
            k = k + 1
        }
        if (*c).ct2_a < 0 || (*c).ct2_b < 0 || (*c).ct2_d < 0 { return }
        mc_inv.inv_click(cl, v, (*c).ct2_b, 0, 1) // shift: the 40 stone -> slot 9
    } else if ph == 1 {
        mc_inv.inv_click(cl, v, (*c).ct2_d, 0, 1) // shift: dirt -> slot 10
    } else if ph == 2 {
        mc_inv.inv_click(cl, v, (*c).ct2_a, 0, 1) // shift: 64 stone -> merges into slot 9 (64), 40 left -> slot 11
    } else if ph == 3 {
        mc_inv.inv_click(cl, v, 11, 0, 0) // pick up the 40
    } else if ph == 4 {
        mc_inv.inv_drag_begin(cl, v, 0)
    } else if ph == 5 {
        mc_inv.inv_drag_add(cl, v, 12, 0)
        mc_inv.inv_drag_add(cl, v, 13, 0)
        mc_inv.inv_drag_add(cl, v, 14, 0)
    } else if ph == 6 {
        mc_inv.inv_drag_end(cl, v, 0) // 13 each, 1 stays in hand
    } else if ph == 7 {
        mc_inv.inv_click(cl, v, 15, 0, 0) // put the last one down
    } else if ph == 8 {
        mc_inv.inv_click(cl, v, 15, 0, 0) // pick it up again
    } else if ph == 9 {
        mc_inv.inv_click(cl, v, 15, 0, 6) // double click on the empty slot: collects 13 + 13 + 13, then 24 from the full stack in slot 9
    } else if ph == 10 {
        mc_inv.inv_click(cl, v, 11, 0, 0) // put the 64 into slot 11
    } else if ph == 11 {
        say(f"mcplay: clicktest2 s9={mc_inv.inv_item(v, 9)}x{mc_inv.inv_count(v, 9)} s10={mc_inv.inv_item(v, 10)}x{mc_inv.inv_count(v, 10)} s11={mc_inv.inv_item(v, 11)}x{mc_inv.inv_count(v, 11)} s12={mc_inv.inv_count(v, 12)} s15={mc_inv.inv_count(v, 15)} cursor={mc_inv.inv_cursor_item(v)}x{mc_inv.inv_cursor_count(v)} clicks={(*c).inv.n_clicks}\n")
    }
    (*c).ct2_phase = ph + 1
    (*c).ct2_t = now
}

// MCPLAY_CRAFT_TEST=1 (survival, after `give <name> oak_planks 20`): picks the 20 planks up, spreads them over crafting grid slots 1 and 3 with three
// "one each" drags (stick x4 is predicted after each), puts the rest back, takes the result (4 sticks) to the cursor, puts it into slot 20, then shift clicks
// the result (2 more crafts -> 8 sticks merge into slot 20). Expected: slot 20 = 12 sticks, source slot = 14 planks, grid empty, result empty. `srv` = packets
// the server had to send in between (0 = the prediction was exact). The harness compares with the server's inventory.
fn craft_test(c: *mut Ctx) {
    let now: u64 = now_ms()
    if (*c).ct4_phase >= 10 { return }
    if (*c).ct4_phase > 0 && now - (*c).ct4_t < 600 as u64 { return }
    let cl: *mut mc_client.Client = &(*c).cl
    let v: *mut mc_inv.Inv = &(*c).inv
    let ph: i32 = (*c).ct4_phase
    if ph == 0 {
        var k: i32 = 9
        while k < 45 && (*c).ct4_src < 0 {
            if mc_inv.inv_count(v, k) == 20 { (*c).ct4_src = k }
            k = k + 1
        }
        if (*c).ct4_src < 0 { return }
        (*c).ct4_n0 = (*v).n_srv
        mc_inv.inv_click(cl, v, (*c).ct4_src, 0, 0)
    } else if ph >= 1 && ph <= 3 {
        mc_inv.inv_drag_begin(cl, v, 1)
        mc_inv.inv_drag_add(cl, v, 1, 1)
        mc_inv.inv_drag_add(cl, v, 3, 1)
        mc_inv.inv_drag_end(cl, v, 1)
    } else if ph == 4 {
        say(f"mcplay: craftpre res={mc_inv.inv_item(v, 0)}x{mc_inv.inv_count(v, 0)} g1={mc_inv.inv_count(v, 1)} g3={mc_inv.inv_count(v, 3)} cursor={mc_inv.inv_cursor_count(v)}\n")
        mc_inv.inv_click(cl, v, (*c).ct4_src, 0, 0)
    } else if ph == 5 {
        mc_inv.inv_click(cl, v, 0, 0, 0)
    } else if ph == 6 {
        mc_inv.inv_click(cl, v, 20, 0, 0)
    } else if ph == 7 {
        mc_inv.inv_click(cl, v, 0, 0, 1)
    } else if ph == 8 {
        say(f"mcplay: crafttest res={mc_inv.inv_item(v, 0)}x{mc_inv.inv_count(v, 0)} s20={mc_inv.inv_item(v, 20)}x{mc_inv.inv_count(v, 20)} src={mc_inv.inv_item(v, (*c).ct4_src)}x{mc_inv.inv_count(v, (*c).ct4_src)} g1={mc_inv.inv_count(v, 1)} g3={mc_inv.inv_count(v, 3)} cursor={mc_inv.inv_cursor_count(v)} srv={(*v).n_srv - (*c).ct4_n0} stick={mc_inv.inv_item(v, 20)}\n")
    }
    (*c).ct4_phase = ph + 1
    (*c).ct4_t = now
}

fn floor_i(x: f64) -> i32 {
    let i: i32 = x as i32
    if (i as f64) > x { return i - 1 }
    return i
}

// ---- MCPLAY_TABLE_TEST helpers: item id by registry name, window slot of the first player slot holding an item, first free main slot, totals ----
fn tt_item(v: *mut mc_inv.Inv, name: str) -> i32 {
    if (*v).reg == 0 { return 0 - 1 }
    return mc_registry.reg_item_by_name((*v).reg as *mut mc_registry.Registry, name.p as u64, name.n)
}

// window slot (crafting table: player part starts at inv_window_slots) of the first main / hotbar slot holding `item`, -1 = none
fn tt_ws(v: *mut mc_inv.Inv, item: i32) -> i32 {
    var k: i32 = 9
    while k < 45 {
        if mc_inv.inv_item(v, k) == item && mc_inv.inv_count(v, k) > 0 { return k - 9 + mc_inv.inv_window_slots(v) }
        k = k + 1
    }
    return 0 - 1
}

fn tt_free_ws(v: *mut mc_inv.Inv) -> i32 {
    var k: i32 = 9
    while k < 36 {
        if mc_inv.inv_item(v, k) < 0 || mc_inv.inv_count(v, k) <= 0 { return k - 9 + mc_inv.inv_window_slots(v) }
        k = k + 1
    }
    return 0 - 1
}

fn tt_total(v: *mut mc_inv.Inv, item: i32) -> i32 {
    var n: i32 = 0
    var k: i32 = 9
    while k < 45 {
        if mc_inv.inv_item(v, k) == item { n = n + mc_inv.inv_count(v, k) }
        k = k + 1
    }
    k = 1
    while k < mc_inv.inv_window_slots(v) {
        if mc_inv.inv_win_item(v, k) == item { n = n + mc_inv.inv_win_count(v, k) }
        k = k + 1
    }
    if mc_inv.inv_cursor_item(v) == item { n = n + mc_inv.inv_cursor_count(v) }
    return n
}

// MCPLAY_TABLE_TEST=1 (survival; run_inv.sh puts a crafting table at the player's x+1 and gives 12 oak planks, 3 milk buckets, 2 sugar, 1 egg, 3 wheat):
// right click the table, then 6 planks -> grid slots 1 and 4 (3 each): stick x4 is predicted; RIGHT click on the result takes 4 sticks, shift click crafts the
// other 2 sets (8 sticks); then a cake (3 milk buckets, 2 sugar, 1 egg, 3 wheat): right click on the result, the buckets stay in grid slots 1..3.
// Expected locally: sticks 12, planks 6, cake 1, buckets 3 (in the grid), milk/sugar/egg/wheat 0. After the window closes the server returns the grid items.
fn table_test(c: *mut Ctx) {
    let now: u64 = now_ms()
    if (*c).tt_phase >= 12 { return }
    if (*c).tt_phase > 0 && now - (*c).tt_t < 500 as u64 { return }
    let cl: *mut mc_client.Client = &(*c).cl
    let v: *mut mc_inv.Inv = &(*c).inv
    let ph: i32 = (*c).tt_phase
    let planks: i32 = tt_item(v, "oak_planks")
    let stick: i32 = tt_item(v, "stick")
    let milk: i32 = tt_item(v, "milk_bucket")
    let sugar: i32 = tt_item(v, "sugar")
    let egg: i32 = tt_item(v, "egg")
    let wheat: i32 = tt_item(v, "wheat")
    let cake: i32 = tt_item(v, "cake")
    let bucket: i32 = tt_item(v, "bucket")
    if ph == 0 {
        if mc_inv.inv_window(v) != 0 && mc_inv.inv_window_slots(v) == 10 && tt_ws(v, planks) >= 0 && tt_ws(v, milk) >= 0 && tt_ws(v, sugar) >= 0 && tt_ws(v, egg) >= 0 && tt_ws(v, wheat) >= 0 {
            say(f"mcplay: tabletest open win={mc_inv.inv_window(v)} slots={mc_inv.inv_window_slots(v)}\n")
            (*c).tt_n0 = (*v).n_srv
        } else {
            if mc_inv.inv_window(v) == 0 && (tt_ws(v, wheat) < 0 && mc_inv.inv_item(v, 37) < 0) { return } // the /give commands have not arrived yet
            if mc_inv.inv_window(v) != 0 { return } // open, items still on the way
            if (*c).tt_tries == 0 { (*c).tt_tries = 1; (*c).tt_t = now; return }
            if now - (*c).tt_t < 1500 as u64 { return }
            (*c).tt_t = now
            (*c).tt_tries = (*c).tt_tries + 1
            if (*c).tt_tries > 12 { (*c).tt_phase = 12; say(f"mcplay: tabletest FAIL table did not open\n"); return }
            let bx: i32 = floor_i((*c).pl.x + 1.0)
            let by: i32 = floor_i((*c).pl.y)
            let bz: i32 = floor_i((*c).pl.z)
            mc_play.send_place(cl, bx, by, bz, 1, (*c).seq)
            (*c).seq = (*c).seq + 1
            return
        }
    } else if ph == 1 {
        let s: i32 = tt_ws(v, planks)
        mc_inv.inv_click(cl, v, s, 0, 0)
        var k: i32 = 0
        while k < 3 { mc_inv.inv_click(cl, v, 1, 1, 0); mc_inv.inv_click(cl, v, 4, 1, 0); k = k + 1 }
        mc_inv.inv_click(cl, v, s, 0, 0)
    } else if ph == 2 {
        say(f"mcplay: tablepre res={mc_inv.inv_win_item(v, 0)}x{mc_inv.inv_win_count(v, 0)} stick={stick} g1={mc_inv.inv_win_count(v, 1)} g4={mc_inv.inv_win_count(v, 4)} cursor={mc_inv.inv_cursor_count(v)}\n")
    } else if ph == 3 {
        mc_inv.inv_click(cl, v, 0, 1, 0) // RIGHT click on the result
    } else if ph == 4 {
        mc_inv.inv_click(cl, v, tt_free_ws(v), 0, 0)
    } else if ph == 5 {
        mc_inv.inv_click(cl, v, 0, 0, 1) // shift click: the other two crafts
    } else if ph == 6 {
        var k: i32 = 0
        while k < 3 {
            mc_inv.inv_click(cl, v, tt_ws(v, milk), 0, 0)
            mc_inv.inv_click(cl, v, 1 + k, 0, 0)
            k = k + 1
        }
        let ss: i32 = tt_ws(v, sugar)
        mc_inv.inv_click(cl, v, ss, 0, 0)
        mc_inv.inv_click(cl, v, 4, 1, 0)
        mc_inv.inv_click(cl, v, 6, 1, 0)
    } else if ph == 7 {
        let se: i32 = tt_ws(v, egg)
        mc_inv.inv_click(cl, v, se, 0, 0)
        mc_inv.inv_click(cl, v, 5, 1, 0)
        let sw: i32 = tt_ws(v, wheat)
        mc_inv.inv_click(cl, v, sw, 0, 0)
        mc_inv.inv_click(cl, v, 7, 1, 0)
        mc_inv.inv_click(cl, v, 8, 1, 0)
        mc_inv.inv_click(cl, v, 9, 1, 0)
    } else if ph == 8 {
        say(f"mcplay: tablepre2 res={mc_inv.inv_win_item(v, 0)}x{mc_inv.inv_win_count(v, 0)} cake={cake} cursor={mc_inv.inv_cursor_count(v)}\n")
        mc_inv.inv_click(cl, v, 0, 1, 0) // RIGHT click on the cake
    } else if ph == 9 {
        mc_inv.inv_click(cl, v, tt_free_ws(v), 0, 0)
    } else if ph == 10 {
        say(f"mcplay: tabletest res={mc_inv.inv_win_item(v, 0)}x{mc_inv.inv_win_count(v, 0)} stick={tt_total(v, stick)} planks={tt_total(v, planks)} cake={tt_total(v, cake)} bucket={tt_total(v, bucket)} milk={tt_total(v, milk)} sugar={tt_total(v, sugar)} egg={tt_total(v, egg)} wheat={tt_total(v, wheat)} g1={mc_inv.inv_win_item(v, 1)} g3={mc_inv.inv_win_item(v, 3)} bucket_id={bucket} cursor={mc_inv.inv_cursor_count(v)} srv={(*v).n_srv - (*c).tt_n0}\n")
        mc_inv.inv_close_window(cl, v)
    }
    (*c).tt_phase = ph + 1
    (*c).tt_t = now
}

// MCPLAY_TABLE_TEST2=1 (survival; run_inv.sh puts a crafting table at the player's x+1 and gives 8 honey bottles + 2 oak planks), r234:
// planks in grid slots 1 and 4 -> stick x4; Q (THROW) on the result drops it, the grid is used up. Then 2 honey bottles in each of the grid slots 1, 2, 4, 5 -> honey block:
// left click takes it (the 4 glass bottles go into the player inventory, the honey stacks shrink to 1), a hotbar SWAP (key 2) moves the second block there (single bottles ->
// the glass bottles stay in the grid). Expected locally: honey_block 2, glass_bottle 8 (4 of them in the grid), stick 0, planks 0. The server must agree after the window closes.
fn table_test2(c: *mut Ctx) {
    let now: u64 = now_ms()
    if (*c).tt_phase >= 12 { return }
    if (*c).tt_phase > 0 && now - (*c).tt_t < 500 as u64 { return }
    let cl: *mut mc_client.Client = &(*c).cl
    let v: *mut mc_inv.Inv = &(*c).inv
    let ph: i32 = (*c).tt_phase
    let planks: i32 = tt_item(v, "oak_planks")
    let stick: i32 = tt_item(v, "stick")
    let honey: i32 = tt_item(v, "honey_bottle")
    let hblock: i32 = tt_item(v, "honey_block")
    let gb: i32 = tt_item(v, "glass_bottle")
    if ph == 0 {
        if mc_inv.inv_window(v) != 0 && mc_inv.inv_window_slots(v) == 10 && tt_ws(v, planks) >= 0 && tt_ws(v, honey) >= 0 {
            say(f"mcplay: tabletest2 open win={mc_inv.inv_window(v)} slots={mc_inv.inv_window_slots(v)}\n")
            (*c).tt_n0 = (*v).n_srv
        } else {
            if mc_inv.inv_window(v) == 0 && (tt_ws(v, honey) < 0 || tt_ws(v, planks) < 0) { return } // the /give commands have not arrived yet
            if mc_inv.inv_window(v) != 0 { return } // open, items still on the way
            if (*c).tt_tries == 0 { (*c).tt_tries = 1; (*c).tt_t = now; return }
            if now - (*c).tt_t < 1500 as u64 { return }
            (*c).tt_t = now
            (*c).tt_tries = (*c).tt_tries + 1
            if (*c).tt_tries > 12 { (*c).tt_phase = 12; say(f"mcplay: tabletest2 FAIL table did not open\n"); return }
            let bx: i32 = floor_i((*c).pl.x + 1.0)
            let by: i32 = floor_i((*c).pl.y)
            let bz: i32 = floor_i((*c).pl.z)
            mc_play.send_place(cl, bx, by, bz, 1, (*c).seq)
            (*c).seq = (*c).seq + 1
            return
        }
    } else if ph == 1 {
        mc_inv.inv_click(cl, v, tt_ws(v, planks), 0, 0)
        mc_inv.inv_click(cl, v, 1, 1, 0)
        mc_inv.inv_click(cl, v, 4, 1, 0)
    } else if ph == 2 {
        say(f"mcplay: tablepre3 res={mc_inv.inv_win_item(v, 0)}x{mc_inv.inv_win_count(v, 0)} stick={stick} cursor={mc_inv.inv_cursor_count(v)}\n")
    } else if ph == 3 {
        mc_inv.inv_click(cl, v, 0, 0, 4) // Q on the result: the sticks are dropped
    } else if ph == 4 {
        say(f"mcplay: tablethrow res={mc_inv.inv_win_item(v, 0)}x{mc_inv.inv_win_count(v, 0)} stick={tt_total(v, stick)} planks={tt_total(v, planks)} cursor={mc_inv.inv_cursor_item(v)}\n")
    } else if ph == 5 {
        mc_inv.inv_click(cl, v, tt_ws(v, honey), 0, 0)
        var k: i32 = 0
        while k < 2 {
            mc_inv.inv_click(cl, v, 1, 1, 0)
            mc_inv.inv_click(cl, v, 2, 1, 0)
            mc_inv.inv_click(cl, v, 4, 1, 0)
            mc_inv.inv_click(cl, v, 5, 1, 0)
            k = k + 1
        }
    } else if ph == 6 {
        say(f"mcplay: tablepre4 res={mc_inv.inv_win_item(v, 0)}x{mc_inv.inv_win_count(v, 0)} hblock={hblock} g1={mc_inv.inv_win_count(v, 1)} g5={mc_inv.inv_win_count(v, 5)} cursor={mc_inv.inv_cursor_count(v)}\n")
        mc_inv.inv_click(cl, v, 0, 0, 0) // left click: the block to the cursor, 4 bottles into the inventory
    } else if ph == 7 {
        mc_inv.inv_click(cl, v, tt_free_ws(v), 0, 0)
    } else if ph == 8 {
        mc_inv.inv_click(cl, v, 0, 1, 2) // SWAP with hotbar key 2 (slot 37 is free): the second block, single bottles stay in the grid
    } else if ph == 9 {
        say(f"mcplay: tabletest2 res={mc_inv.inv_win_item(v, 0)}x{mc_inv.inv_win_count(v, 0)} hblock={tt_total(v, hblock)} gbottle={tt_total(v, gb)} honey={tt_total(v, honey)} stick={tt_total(v, stick)} planks={tt_total(v, planks)} g1={mc_inv.inv_win_item(v, 1)} gb_id={gb} cursor={mc_inv.inv_cursor_item(v)} srv={(*v).n_srv - (*c).tt_n0}\n")
        mc_inv.inv_close_window(cl, v)
    }
    (*c).tt_phase = ph + 1
    (*c).tt_t = now
}

// MCPLAY_SNEAK_TEST (run_inv.sh): the server puts a chest at the player's x+1 and gives stone. With MCPLAY_FORCE_SNEAK=1 a right click on the chest
// top face must PLACE the stone above it (a Block Change appears, no window); without sneaking it must open the chest (window id != 0).
fn sneak_test(c: *mut Ctx) {
    let now: u64 = now_ms()
    if (*c).st_phase >= 9 { return }
    let v: *mut mc_inv.Inv = &(*c).inv
    if (*c).st_phase == 0 {
        if mc_inv.inv_item(v, 36) < 0 { return }
        if (*c).st_t == 0 as u64 { (*c).st_t = now; return }
        if now - (*c).st_t < 3500 as u64 { return }
        (*c).st_x = floor_i((*c).pl.x + 1.0)
        (*c).st_y = floor_i((*c).pl.y) + 1
        (*c).st_z = floor_i((*c).pl.z)
        (*c).st_phase = 1
    }
    if (*c).st_phase == 1 {
        (*c).st_phase = 2
        (*c).st_t = now
        (*c).seq = (*c).seq + 1
        mc_play.send_place(&(*c).cl, (*c).st_x, (*c).st_y - 1, (*c).st_z, 1, (*c).seq)
        return
    }
    if now - (*c).st_t < 3000 as u64 { return }
    var tn: usize = 0
    let tp: u64 = mc_inv.inv_window_title(v, &tn)
    let title: str = str { p: tp as *u8, n: tn }
    say(f"mcplay: sneaktest sneak={(*c).sneak_sent} win={mc_inv.inv_window(v)} slots={mc_inv.inv_window_slots(v)} cols={mc_inv.inv_window_cols(v)} title={title} item0={mc_inv.inv_win_item(v, 0)} placed={(*c).st_seen} sneak_packets={(*c).n_sneak}\n")
    (*c).st_phase = 9
}

// MCPLAY_CHEST_TEST: the server puts a chest at the player's x+1 (run_inv.sh): right click it, wait for its items, then
// shift click container -> player and player -> container, pick up / put down, drag over four container slots, close.
// Window slots of a 9x3 chest: 0..26 container, 27..53 main inventory, 54..62 hotbar.
fn chest_test(c: *mut Ctx) {
    let now: u64 = now_ms()
    if (*c).ct3_phase >= 9 { return }
    if (*c).ct3_phase > 0 && now - (*c).ct3_t < 500 as u64 { return }
    let cl: *mut mc_client.Client = &(*c).cl
    let v: *mut mc_inv.Inv = &(*c).inv
    let ph: i32 = (*c).ct3_phase
    if ph == 0 {
        // wait until the chest is open and its items arrived (container slot 0 = the stone), re-sending the right click now and then
        if mc_inv.inv_window(v) != 0 && mc_inv.inv_win_item(v, 0) >= 0 && mc_inv.inv_item(v, 36) >= 0 && mc_inv.inv_item(v, 37) >= 0 {
            say(f"mcplay: chesttest open win={mc_inv.inv_window(v)} slots={mc_inv.inv_window_slots(v)}\n")
            if env_flag("MCPLAY_CHEST_UI", false) {
                // real UI test: the script stops here and prints the cell centres, run_inv.sh clicks them with xdotool
                ui_sync(c)
                let s: i32 = mc_hud.hud_scale((*c).w, (*c).h)
                let nn: i32 = mc_inv.inv_window_slots(v)
                var q: i32 = 0
                while q < 8 {
                    var ws: i32 = 0
                    if q == 1 { ws = 5 }
                    if q == 2 { ws = 26 }
                    if q == 3 { ws = 6 }
                    if q == 4 { ws = 7 }
                    if q == 5 { ws = 8 }
                    if q == 6 { ws = nn + 27 }
                    if q == 7 { ws = nn + 28 }
                    say(f"mcplay: chestui cell ws={ws} x={cont_cell_x(c, s, ws) + 9 * s} y={cont_cell_y(c, s, ws) + 9 * s}\n")
                    q = q + 1
                }
                (*c).ct3_phase = 9
                return
            }
        } else {
            if mc_inv.inv_item(v, 37) < 0 { return } // the /give commands have not arrived yet (the chest is set right after them)
            if (*c).ct3_tries == 0 { (*c).ct3_tries = 1; (*c).ct3_t = now; return }
            if now - (*c).ct3_t < 1500 as u64 { return }
            (*c).ct3_t = now
            (*c).ct3_tries = (*c).ct3_tries + 1
            if (*c).ct3_tries > 12 { (*c).ct3_phase = 9; say(f"mcplay: chesttest FAIL chest did not open\n"); return }
            let bx: i32 = floor_i((*c).pl.x + 1.0)
            let by: i32 = floor_i((*c).pl.y)
            let bz: i32 = floor_i((*c).pl.z)
            mc_play.send_place(cl, bx, by, bz, 1, (*c).seq)
            (*c).seq = (*c).seq + 1
            return
        }
    } else if ph == 1 {
        mc_inv.inv_click(cl, v, 0, 0, 1) // shift: container 0 (10 stone) -> merges into the hotbar stone
    } else if ph == 2 {
        mc_inv.inv_click(cl, v, 55, 0, 1) // shift: hotbar dirt -> merges into container slot 1
    } else if ph == 3 {
        mc_inv.inv_click(cl, v, 26, 0, 0) // pick up the 64 stone of container slot 26
    } else if ph == 4 {
        mc_inv.inv_click(cl, v, 5, 0, 0) // put it into container slot 5
    } else if ph == 5 {
        mc_inv.inv_click(cl, v, 54, 0, 0) // pick up the hotbar stone (30)
        mc_inv.inv_drag_begin(cl, v, 0)
        mc_inv.inv_drag_add(cl, v, 10, 0)
        mc_inv.inv_drag_add(cl, v, 11, 0)
        mc_inv.inv_drag_add(cl, v, 12, 0)
        mc_inv.inv_drag_add(cl, v, 13, 0)
    } else if ph == 6 {
        mc_inv.inv_drag_end(cl, v, 0) // 7 each, 2 stay in the hand
    } else if ph == 7 {
        mc_inv.inv_click(cl, v, 54, 0, 0) // the 2 back to the hotbar
    } else if ph == 8 {
        say(f"mcplay: chesttest c1={mc_inv.inv_win_item(v, 1)}x{mc_inv.inv_win_count(v, 1)} c5={mc_inv.inv_win_item(v, 5)}x{mc_inv.inv_win_count(v, 5)} c10={mc_inv.inv_win_count(v, 10)} c13={mc_inv.inv_win_count(v, 13)} c0={mc_inv.inv_win_item(v, 0)} c26={mc_inv.inv_win_item(v, 26)} h0={mc_inv.inv_item(v, 36)}x{mc_inv.inv_count(v, 36)} h1={mc_inv.inv_item(v, 37)} cursor={mc_inv.inv_cursor_item(v)}x{mc_inv.inv_cursor_count(v)} clicks={(*c).inv.n_clicks}\n")
        mc_inv.inv_close_window(cl, v)
    }
    (*c).ct3_phase = ph + 1
    (*c).ct3_t = now
}

fn cont_ui_cell(c: *mut Ctx, s: i32, tag: str, ws: i32) {
    say(f"mcplay: contui cell {tag} x={cont_cell_x(c, s, ws) + 8 * s} y={cont_cell_y(c, s, ws) + 8 * s}\n")
}

fn cont_ui_trade_cells(c: *mut Ctx, s: i32) {
    var row: i32 = 0
    while row < 3 {
        var x: i32 = 0
        var y: i32 = 0
        mc_trade_ui.tui_item_xy(row, mc_trade_ui.TUI_RESULT, &x, &y)
        say(f"mcplay: contui cell trade{row} x={cont_px(c, s) + (x + 8) * s} y={cont_py(c, s) + (y + 8) * s}\n")
        row = row + 1
    }
}

fn cont_ui_interact_nearest(c: *mut Ctx, now: u64) {
    if !(*c).have_pos { return }
    var yaw: f64 = 0.0
    var pitch: f64 = 0.0
    let found: bool = mc_combat.aim_nearest(&(*c).ents, &(*c).reg, (*c).fx.own, (*c).cam.x, (*c).cam.y, (*c).cam.z, 6.0, &yaw, &pitch)
    if !found { return }
    (*c).pl.yaw = yaw
    (*c).pl.pitch = pitch
    if !(*c).tgt_hit { return }
    if (*c).ct3_tries == 0 { (*c).ct3_tries = 1; (*c).ct3_t = now; return }
    if now - (*c).ct3_t < 1500 as u64 { return }
    (*c).ct3_t = now
    (*c).ct3_tries = (*c).ct3_tries + 1
    if (*c).ct3_tries > 12 { (*c).ct3_phase = 9; say(f"mcplay: contui FAIL entity did not open\n"); return }
    interact_target(c)
}

// MCPLAY_CONT_UI=1 (anvil) / 2 (enchanting table) / 3 (chest) / 4 (furnace) / 5 (crafting table) / 6 (villager next to the player): the server puts the block at the player's x+1 (run_inv.sh); right click it and print the cell centres for xdotool
fn cont_ui_test(c: *mut Ctx) {
    if (*c).ct3_phase >= 9 { return }
    let now: u64 = now_ms()
    let v: *mut mc_inv.Inv = &(*c).inv
    let want: i32 = mc_cont_ui.cui_test_kind(env_int("MCPLAY_CONT_UI", 0))
    if ui_cont_open(c) && cont_kind(c) == want {
        ui_sync(c)
        let s: i32 = mc_hud.hud_scale((*c).w, (*c).h)
        let nn: i32 = mc_inv.inv_window_slots(v)
        say(f"mcplay: contui open kind={want} n={nn} scale={s}\n")
        cont_ui_cell(c, s, "ws=0", 0)
        cont_ui_cell(c, s, "ws=1", 1)
        cont_ui_cell(c, s, "ws=2", 2)
        cont_ui_cell(c, s, "hot0", nn + 27)
        cont_ui_cell(c, s, "hot1", nn + 28)
        var i: i32 = 0
        while i < 3 {
            say(f"mcplay: contui cell opt{i} x={cont_px(c, s) + 110 * s} y={cont_py(c, s) + (23 + 19 * i) * s}\n")
            i = i + 1
        }
        var fx: i32 = 0
        var fy: i32 = 0
        var fw: i32 = 0
        if mc_cont_ui.cui_name_field_xy(want, &fx, &fy, &fw) {
            say(f"mcplay: contui cell field x={cont_px(c, s) + (fx + 20) * s} y={cont_py(c, s) + (fy + 4) * s}\n")
        }
        if want == mc_cont_ui.KIND_MERCHANT { cont_ui_trade_cells(c, s) }
        (*c).ct3_phase = 9
        return
    }
    if want == mc_cont_ui.KIND_MERCHANT {
        cont_ui_interact_nearest(c, now)
        return
    }
    if mc_inv.inv_item(v, mc_inv.INV_HOTBAR0) < 0 || mc_inv.inv_item(v, mc_inv.INV_HOTBAR0 + 1) < 0 { return }
    if (*c).ct3_tries == 0 { (*c).ct3_tries = 1; (*c).ct3_t = now; return }
    if now - (*c).ct3_t < 1500 as u64 { return }
    (*c).ct3_t = now
    (*c).ct3_tries = (*c).ct3_tries + 1
    if (*c).ct3_tries > 12 { (*c).ct3_phase = 9; say(f"mcplay: contui FAIL block did not open\n"); return }
    mc_play.send_place(&(*c).cl, floor_i((*c).pl.x + 1.0), floor_i((*c).pl.y), floor_i((*c).pl.z), 1, (*c).seq)
    (*c).seq = (*c).seq + 1
}

fn pick_entity(c: *mut Ctx) {
    (*c).tgt_hit = false
    if !(*c).have_pos { return }
    var block_dist: f64 = 0.0 - 1.0
    if (*c).hit { block_dist = (*c).pk.dist }
    let cam: *mut mc_camera.Camera = &(*c).cam
    (*c).tgt_hit = mc_combat.combat_pick(&(*c).ents, &(*c).reg, (*c).fx.own, (*cam).x, (*cam).y, (*cam).z, (*cam).fx, (*cam).fy, (*cam).fz,
        mc_combat.combat_reach((*c).creative), block_dist, &(*c).tgt)
}

fn attack_target(c: *mut Ctx) {
    (*c).seq = (*c).seq + 1
    let ok: bool = mc_combat.combat_attack(&(*c).combat, &(*c).cl, (*c).tgt.id, (*c).pl.sneaking, (*c).seq, now_ms())
    mc_combat_fx.cfx_attacked(&(*c).cfx, (*c).tgt.id, now_ms())
    if (*c).combat_log { say(f"mcplay: combat attack target={(*c).tgt.id} dist_mm={((*c).tgt.dist * 1000.0) as i64} sent={ok} n={(*c).combat.n_attacks}\n") }
}

fn interact_target(c: *mut Ctx) {
    (*c).seq = (*c).seq + 1
    let ok: bool = mc_combat.combat_interact(&(*c).combat, &(*c).cl, &(*c).tgt, (*c).pl.sneaking, (*c).seq)
    if (*c).combat_log { say(f"mcplay: combat interact target={(*c).tgt.id} sent={ok} n={(*c).combat.n_interacts}\n") }
}

fn pick_face(c: *mut Ctx) -> i32 {
    let f: i32 = mc_play.face_of((*c).pk.nx, (*c).pk.ny, (*c).pk.nz)
    if f < 0 { return 1 }
    return f
}

fn use_held_item(c: *mut Ctx) {
    (*c).seq = (*c).seq + 1
    if (*c).aud { mc_snd_use.su_bucket((*c).ma, &(*c).su, &(*c).reg, mc_inv.inv_held_item(&(*c).inv, (*c).pl.slot), (*c).pl.x, (*c).pl.y + 1.0, (*c).pl.z) }
    let ok: bool = mc_combat.combat_use_item(&(*c).combat, &(*c).cl, (*c).seq, (*c).pl.yaw, (*c).pl.pitch)
    if (*c).combat_log { say(f"mcplay: combat use sent={ok} n={(*c).combat.n_uses}\n") }
}

fn release_held_item(c: *mut Ctx) {
    mc_combat_fx.cfx_use_end(&(*c).cfx)
    let was: bool = (*c).combat.using_item
    let ok: bool = mc_combat.combat_release_use(&(*c).combat, &(*c).cl)
    if (*c).combat_log && was { say(f"mcplay: combat release sent={ok} n={(*c).combat.n_releases}\n") }
}

// MCPLAY_COMBAT_TEST=1 (survival, a cow with NoAI in front of the player, `give <name> snowball 5`): attack twice, interact, use the snowball, release
fn combat_test(c: *mut Ctx) {
    let now: u64 = now_ms()
    let ph: i32 = (*c).cbt_phase
    if ph == 0 && !(*c).tgt_hit {
        var yaw: f64 = 0.0
        var pitch: f64 = 0.0
        if mc_combat.aim_nearest(&(*c).ents, &(*c).reg, (*c).fx.own, (*c).cam.x, (*c).cam.y, (*c).cam.z, 6.0, &yaw, &pitch) {
            (*c).pl.yaw = yaw
            (*c).pl.pitch = pitch
        }
    }
    if ph >= 6 || !(*c).tgt_hit { return }
    if ph == 0 {
        (*c).cbt_phase = 1
        (*c).cbt_t = now
        return
    }
    if now - (*c).cbt_t < 900 as u64 { return }
    if ph == 1 || ph == 2 {
        attack_target(c)
    } else if ph == 3 {
        interact_target(c)
    } else if ph == 4 {
        let want: str = "snowball"
        let sn: i32 = mc_registry.reg_item_by_name(&(*c).reg, want.p as u64, want.n)
        if sn < 0 || mc_inv.inv_held_item(&(*c).inv, (*c).pl.slot) != sn { return }
        use_held_item(c)
    } else if ph == 5 {
        release_held_item(c)
        say(f"mcplay: combat_test done attacks={(*c).combat.n_attacks} interacts={(*c).combat.n_interacts} uses={(*c).combat.n_uses} releases={(*c).combat.n_releases}\n")
    }
    (*c).cbt_phase = ph + 1
    (*c).cbt_t = now
}

fn use_hold_due(c: *mut Ctx, rdown: bool, now: u64) -> bool {
    if !rdown || (*c).tgt_hit { return false }
    let fx: *mut mc_combat_fx.CombatFx = &(*c).cfx
    if (*c).hit {
        let held: i32 = mc_inv.inv_held_item(&(*c).inv, (*c).pl.slot)
        let placeable: bool = held >= 0 && mc_combat.held_is_block(&(*c).reg, held)
        if !placeable && !(*fx).repeats_use { return false }
        return mc_combat_fx.cfx_hold_due((*fx).place_ms, now, mc_combat_fx.HOLD_INTERVAL_MS)
    }
    if !(*fx).repeats_use { return false }
    return mc_combat_fx.cfx_hold_due((*fx).use_ms, now, mc_combat_fx.HOLD_INTERVAL_MS)
}

fn handle_mouse(c: *mut Ctx) {
    if mc_pause.pause_active() { return }
    if (*c).chat.open || (*c).health.dead { return }
    if (*c).show_inv && (*c).have_pos {
        ui_inv_click(c)
        return
    }
    let lmb: bool = mc_keybinds.kb_down(&(*c).kb, &(*c).rw, mc_keybinds.KB_ATTACK)
    let lp: bool = mc_keybinds.kb_pressed(&(*c).kb, &(*c).rw, mc_keybinds.KB_ATTACK)
    let rp: bool = mc_keybinds.kb_pressed(&(*c).kb, &(*c).rw, mc_keybinds.KB_USE)
    let rdown: bool = mc_keybinds.kb_down(&(*c).kb, &(*c).rw, mc_keybinds.KB_USE)
    if !(*c).grab {
        if lp && mc_focus.may_grab(raw.has_focus(&(*c).rw), mc_pause.pause_active(), (*c).chat.open, (*c).show_inv, (*c).health.dead) { grab_mouse(c, true) }
        return
    }
    if !(*c).have_pos { return }
    if (*c).show_inv { return }
    let cl: *mut mc_client.Client = &(*c).cl
    if mc_keybinds.kb_released(&(*c).kb, &(*c).rw, mc_keybinds.KB_USE) { release_held_item(c) }
    let now: u64 = now_ms()
    let atk_hold: bool = lmb && (*c).tgt_hit && mc_combat_fx.cfx_attack_ready(&(*c).cfx, now)
    if (lp || atk_hold) && (*c).tgt_hit { attack_target(c) }
    if lp && !(*c).tgt_hit && (*c).hit && may_break(c) {
        let face: i32 = pick_face(c)
        (*c).seq = (*c).seq + 1
        mc_player_draw.pd_swing(&(*c).pdraw, now_ms()); mc_play.send_swing(cl, (*c).seq)
        mc_play.send_dig(cl, mc_play.DIG_START, (*c).pk.x, (*c).pk.y, (*c).pk.z, face, (*c).seq)
        if instant_break(c) {
            break_local(c, (*c).pk.x, (*c).pk.y, (*c).pk.z)
        } else if dig_time_ms(c, (*c).pk.id) < 0 {
            // unbreakable (bedrock, barrier): the server answers with the block again
        } else if dig_time_ms(c, (*c).pk.id) == 0 {
            (*c).seq = (*c).seq + 1
            mc_play.send_dig(cl, mc_play.DIG_FINISH, (*c).pk.x, (*c).pk.y, (*c).pk.z, face, (*c).seq)
            break_local(c, (*c).pk.x, (*c).pk.y, (*c).pk.z)
        } else {
            (*c).dig_ms = dig_time_ms(c, (*c).pk.id) as u64
            (*c).digging = true
            (*c).dig_x = (*c).pk.x
            (*c).dig_y = (*c).pk.y
            (*c).dig_z = (*c).pk.z
            (*c).dig_t0 = now_ms()
            (*c).dig_state = (*c).pk.id
            mc_dig_progress.dp_start(&(*c).dp, (*c).dig_t0)
            mc_snd_events.sev_dig_reset(&(*c).sev)
        }
    }
    if (*c).digging {
        if (*c).aud {
            mc_snd_events.sev_dig_tick((*c).ma, &(*c).sev, &(*c).reg, (*c).pk.id, (*c).dig_x, (*c).dig_y, (*c).dig_z, now_ms() - (*c).dig_t0)
        }
        let tick_now: u64 = now_ms()
        while mc_dig_progress.dp_owed(&(*c).dp, tick_now) > 0 && !mc_dig_progress.dp_done(&(*c).dp) {
            mc_dig_progress.dp_tick(&(*c).dp, dig_damage_now(c, (*c).dig_state))
        }
        let same: bool = (*c).hit && (*c).pk.x == (*c).dig_x && (*c).pk.y == (*c).dig_y && (*c).pk.z == (*c).dig_z
        let face2: i32 = pick_face(c)
        if !lmb || !same {
            (*c).seq = (*c).seq + 1
            mc_play.send_dig(cl, mc_play.DIG_CANCEL, (*c).dig_x, (*c).dig_y, (*c).dig_z, face2, (*c).seq)
            (*c).digging = false
            mc_dig_progress.dp_stop(&(*c).dp)
        } else if mc_dig_progress.dp_done(&(*c).dp) {
            if env_flag("MCPLAY_DIG_LOG", false) { say(f"mcplay: dig finished ticks={(*c).dp.ticks} planned={(*c).dig_total} ground={(*c).pl.on_ground}\n") }
            (*c).seq = (*c).seq + 1
            mc_play.send_dig(cl, mc_play.DIG_FINISH, (*c).dig_x, (*c).dig_y, (*c).dig_z, face2, (*c).seq)
            break_local(c, (*c).dig_x, (*c).dig_y, (*c).dig_z)
            (*c).digging = false
            mc_dig_progress.dp_stop(&(*c).dp)
        }
    }
    let rfire: bool = rp || use_hold_due(c, rdown, now)
    if rp && (*c).tgt_hit { interact_target(c) }
    let chargeable: bool = (*c).cfx.use_kind != mc_use_bar.USE_NONE
    if rfire && !(*c).tgt_hit && !(*c).hit {
        mc_combat_fx.cfx_mark_use(&(*c).cfx, now)
        use_held_item(c)
        mc_combat_fx.cfx_use_begin(&(*c).cfx, now)
    }
    if rp && !(*c).tgt_hit && (*c).hit && chargeable {
        mc_combat_fx.cfx_mark_use(&(*c).cfx, now)
        use_held_item(c)
        mc_combat_fx.cfx_use_begin(&(*c).cfx, now)
    }
    if rfire && !(*c).tgt_hit && (*c).hit {
        mc_combat_fx.cfx_mark_place(&(*c).cfx, now)
        let face3: i32 = pick_face(c)
        (*c).seq = (*c).seq + 1
        mc_play.send_place(cl, (*c).pk.x, (*c).pk.y, (*c).pk.z, face3, (*c).seq)
        mc_player_draw.pd_swing(&(*c).pdraw, now_ms()); mc_play.send_swing(cl, (*c).seq)
        (*c).n_place = (*c).n_place + 1 as u64
        if env_flag("MCPLAY_DEBUG", false) { say(f"mcplay: dbg place sent at {(*c).pk.x},{(*c).pk.y},{(*c).pk.z} face={face3} player_mm={((*c).pl.x * 1000.0) as i64},{((*c).pl.y * 1000.0) as i64},{((*c).pl.z * 1000.0) as i64} slot={(*c).pl.slot} aud={(*c).aud}\n") }
        var isnd: bool = false
        if (*c).aud && !(*c).pl.sneaking { isnd = mc_snd_use.su_interact((*c).ma, &(*c).su, &(*c).reg, (*c).pk.id, (*c).pk.x, (*c).pk.y, (*c).pk.z) }
        (*c).pend_place = true
        (*c).pend_x = (*c).pk.x + (*c).pk.nx
        (*c).pend_y = (*c).pk.y + (*c).pk.ny
        (*c).pend_z = (*c).pk.z + (*c).pk.nz
        (*c).pend_t = now_ms()
        if (*c).place_id > 0 {
            if (*c).aud && !isnd {
                if mc_audio.mca_block_sound((*c).ma, &(*c).reg, (*c).place_id, mc_audio.ACT_PLACE, (*c).pk.x + (*c).pk.nx, (*c).pk.y + (*c).pk.ny, (*c).pk.z + (*c).pk.nz) != 0 as u32 {
                    (*c).n_snd = (*c).n_snd + 1 as u64
                    (*c).pend_place = false
                }
            }
            mark_air(c, (*c).pk.x + (*c).pk.nx, (*c).pk.y + (*c).pk.ny, (*c).pk.z + (*c).pk.nz, (*c).place_id)
        }
        let held: i32 = mc_inv.inv_held_item(&(*c).inv, (*c).pl.slot)
        if held >= 0 && !mc_combat.held_is_block(&(*c).reg, held) { use_held_item(c) }
    }
}

fn push_str(out: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(out, s.p as u64, s.n)
}

// ---- sound -------------------------------------------------------------------------------------------

// Percent from the environment (-1 = unset).
fn env_pct(name: str) -> i32 {
    if !env.has(name) { return 0 - 1 }
    return env_int(name, 100)
}

fn audio_volumes(c: *mut Ctx) {
    let names: [str; 8] = ["MCPLAY_VOL_MASTER", "MCPLAY_VOL_BLOCKS", "MCPLAY_VOL_AMBIENT", "MCPLAY_VOL_PLAYERS", "MCPLAY_VOL_HOSTILE", "MCPLAY_VOL_NEUTRAL", "MCPLAY_VOL_MUSIC", "MCPLAY_VOL_UI"]
    let cats: [i32; 8] = [mc_audio.CAT_MASTER, mc_audio.CAT_BLOCKS, mc_audio.CAT_AMBIENT, mc_audio.CAT_PLAYERS, mc_audio.CAT_HOSTILE, mc_audio.CAT_NEUTRAL, mc_audio.CAT_MUSIC, mc_audio.CAT_UI]
    var i: usize = 0
    while i < 8 {
        let v: i32 = env_pct(names[i])
        if v >= 0 {
            var f: f32 = (v as f32) / 100.0
            if f > 1.0 { f = 1.0 }
            mc_audio.mca_set_category_volume((*c).ma, cats[i], f)
        }
        i = i + 1
    }
}

// Loads <dir>/bank.json into the context's bank. Returns bank.BANK_OK or an error code.
fn bank_load_dir(c: *mut Ctx, dir: *mut rt.Buf) -> i32 {
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, rt.buf_ptr(dir), rt.buf_len(dir))
    push_str(&path, "/bank.json")
    rt.buf_push(&path, 0 as u8)
    let ps: str = str { p: rt.buf_data(&path), n: rt.buf_len(&path) - 1 }
    let r: i32 = mc_audio.mca_bank_load_file((*c).ma, (*c).bnk, ps)
    rt.buf_free(&path)
    return r
}

// Sound source: sounds=synth|original|both of the pack manager (config `sounds=` / MC_PACK_SOUNDS); synth when packs are off.
fn snd_mode(c: *mut Ctx) -> i32 {
    if !(*c).g.use_res { return mc_packs.SOUNDS_SYNTH }
    return mc_packs.res_sounds_mode(&(*c).g.res)
}

// Pack sounds (sounds.json + OGG of the loaded packs) on top of the bank. Used at start and after every pack hot reload (the bank
// remembers the OGG hashes, so a reload with unchanged files reuses every sample: no leak). Returns the events made, -1 on error.
fn audio_packs_apply(c: *mut Ctx, mode: i32) -> i32 {
    let n: i32 = mc_packsnd.packsnd_apply((*c).ma, (*c).bnk, (*c).eng, &(*c).g.res.stack, mode)
    if n < 0 {
        io.eprint_line("mcplay: pack sounds: bank error -- keeping the old sounds")
    } else {
        say(f"mcplay: pack sounds mode={mode} events={n} samples={engine.engine_sample_count((*c).eng)} total={engine.engine_event_count((*c).eng)}\n")
    }
    return n
}

// T key: after the packs were re-read, rebuild the pack sound events (no-op for sounds=synth or without sound).
// Bank loading needs a stopped audio thread (engine rule): stop, apply (unchanged OGG = same sample, changed = old slot), restart.
fn audio_packs_reload(c: *mut Ctx) {
    let mode: i32 = snd_mode(c)
    if !(*c).aud || mode == mc_packs.SOUNDS_SYNTH { return }
    if (*c).aud_thread { engine.engine_audio_stop((*c).eng) }
    audio_packs_apply(c, mode)
    if (*c).aud_thread {
        (*c).aud_thread = engine.engine_audio_start((*c).eng, (*c).snk, audio_chunk())
        if !(*c).aud_thread { io.eprint_line("mcplay: audio thread did not restart after the pack reload -- running silent") }
    }
}

// O key: pack sounds off (synth) <-> on (config `sounds=` / MC_PACK_SOUNDS, default both). Same rules as the reload: the audio thread is
// stopped around the bank load. Going back to synth reloads the synth bank (its events replace the pack events one by one; the id pool
// is reused, see engine_event_replace); pack-only events stay but nothing maps to them. Back to "on" in mode original (config /
// MC_PACK_SOUNDS=original) clears the event table first (engine_events_clear), so the synth events are really gone: only the pack events
// play, also after a start with sounds=synth or both.
fn audio_sounds_toggle(c: *mut Ctx) {
    let mode: i32 = mc_packs.res_toggle_sounds(&(*c).g.res)
    if (*c).aud_thread { engine.engine_audio_stop((*c).eng) }
    if mode == mc_packs.SOUNDS_SYNTH {
        let r: i32 = audio_load_synth(c)
        if r != bank.BANK_OK { io.eprint_line("mcplay: sounds=synth: synth bank did not load -- keeping the current sounds") }
    } else if mode == mc_packs.SOUNDS_ORIGINAL {
        // original = ONLY the pack events: drop every event (synth + old pack ones) first; the samples stay in the engine and the bank
        // finds them again by hash, so nothing is decoded twice. No pack sound at all -> the synth bank stays (same rule as at start).
        mc_audio.mca_stop_all((*c).ma, 0.0)
        if engine.engine_events_clear((*c).eng) {
            let n: i32 = audio_packs_apply(c, mode)
            if n <= 0 {
                io.eprint_line("mcplay: sounds=original but the packs have no usable sounds -- using the synth bank")
                audio_load_synth(c)
            }
        } else {
            audio_packs_apply(c, mc_packs.SOUNDS_BOTH)
        }
    } else {
        audio_packs_apply(c, mode)
    }
    say(f"mcplay: sounds={mc_packs.res_sounds_name(mode)}\n")
    if (*c).aud_thread {
        (*c).aud_thread = engine.engine_audio_start((*c).eng, (*c).snk, audio_chunk())
        if !(*c).aud_thread { io.eprint_line("mcplay: audio thread did not restart after the sounds switch -- running silent") }
    }
}

// Loads our synth bank (search order below). Returns bank.BANK_OK or an error code.
fn audio_load_synth(c: *mut Ctx) -> i32 {
    // Search order: MCPLAY_SOUNDS (only that), <exe dir>/sounds (the dist package), then the per-user cache dir.
    var r: i32 = bank.BANK_ERR_FILE
    if env.has("MCPLAY_SOUNDS") {
        var dir: rt.Buf = rt.buf_new()
        push_str(&dir, env.get("MCPLAY_SOUNDS"))
        r = bank_load_dir(c, &dir)
        rt.buf_free(&dir)
    } else {
        var exe: rt.Buf = rt.buf_new()
        if platform.plat_exe_path(&exe) {
            // cut the file name: keep everything before the last '/'
            var cut: usize = rt.buf_len(&exe)
            while cut > 0 && rt.buf_at(&exe, cut - 1) != 47 as u8 { cut = cut - 1 }
            if cut > 0 {
                var dir: rt.Buf = rt.buf_new()
                rt.buf_push_bytes(&dir, rt.buf_ptr(&exe), cut)
                push_str(&dir, "sounds")
                r = bank_load_dir(c, &dir)
                rt.buf_free(&dir)
            }
        }
        rt.buf_free(&exe)
        if r != bank.BANK_OK {
            var dir: rt.Buf = rt.buf_new()
            if env.has("HOME") {
                push_str(&dir, env.get("HOME"))
                push_str(&dir, "/.cache/mcplay/sounds")
            } else if env.has("LOCALAPPDATA") {
                // Windows: no HOME; the bank lives under %LOCALAPPDATA%\mcplay\sounds (forward slashes work in Win32 paths)
                push_str(&dir, env.get("LOCALAPPDATA"))
                push_str(&dir, "/mcplay/sounds")
            } else if env.has("USERPROFILE") {
                push_str(&dir, env.get("USERPROFILE"))
                push_str(&dir, "/.cache/mcplay/sounds")
            }
            r = bank_load_dir(c, &dir)
            rt.buf_free(&dir)
        }
    }
    return r
}

// Opens the sink + bank. false = no sound (the game runs on). Called once the Ctx is in place (the engine must not move).
fn audio_start(c: *mut Ctx) -> bool {
    sink.sink_close((*c).snk)
    *(*c).snk = sink.sink_open("mcplay", AUDIO_RATE, 2 as u32)
    if !sink.sink_is_open((*c).snk) {
        io.eprint_line("mcplay: no sound output (no PulseAudio? FIRN_AUDIO=null|file:/x.wav works anywhere) -- running silent")
        return false
    }
    let mode: i32 = snd_mode(c)
    var r: i32 = bank.BANK_ERR_FILE
    if mode != mc_packs.SOUNDS_ORIGINAL { r = audio_load_synth(c) }
    if mode != mc_packs.SOUNDS_SYNTH {
        let n: i32 = audio_packs_apply(c, mode)
        if mode == mc_packs.SOUNDS_ORIGINAL {
            if n > 0 {
                r = bank.BANK_OK
            } else {
                io.eprint_line("mcplay: sounds=original but the packs have no usable sounds -- using the synth bank")
                r = audio_load_synth(c)
            }
        } else if r != bank.BANK_OK && n > 0 {
            r = bank.BANK_OK
        }
    }
    if r != bank.BANK_OK {
        io.eprint_line("mcplay: no sound bank (build one: firnc -o gen tools/sounds/gen/main.fi; ./gen tools/sounds/mc.json <dir>; set MCPLAY_SOUNDS=<dir>) -- running silent")
        sink.sink_close((*c).snk)
        return false
    }
    if (*c).protocol == 763 {
        mc_audio.mca_sound_table_load((*c).ma, mc_snd_v763.SND_BLOB.p as u64, mc_snd_v763.SND_COUNT, mc_snd_v763.SND_FIRST)
    }
    audio_volumes(c)
    mc_audio.mca_set_log((*c).ma, env_flag("MCPLAY_AUDIO_LOG", false))
    // a real device paces itself: audio thread. file/null sinks never wait, so they are fed by wall clock in audio_pump.
    if sink.sink_kind((*c).snk) == sink.KIND_DEVICE {
        (*c).aud_thread = engine.engine_audio_start((*c).eng, (*c).snk, audio_chunk())
        if !(*c).aud_thread { io.eprint_line("mcplay: audio thread did not start -- running silent"); return false }
    }
    (*c).aud_t0 = now_ms()
    return true
}

// Cave mood (MCPLAY_AMBIENT_DARK=1 forces dark, MCPLAY_AMBIENT_X=n runs the mood clock n times faster, for tests): "dark" = something solid within 12 blocks above the head (no sky). ambient.cave 4..16 blocks away after ~60 s of that.
fn audio_ambient(c: *mut Ctx) {
    if !(*c).have_pos || (*c).n_ticks < 20 as u64 { return }
    let bx: i32 = math.floor((*c).pl.x) as i32
    let bz: i32 = math.floor((*c).pl.z) as i32
    let by: i32 = math.floor((*c).pl.y) as i32
    var dark: bool = (*c).amb_dark
    var k: i32 = 2
    while k <= 12 {
        let st: i32 = mc_audio.mca_state_at(&(*c).world, (*c).dim.min_y, bx, by + k, bz)
        if st > 0 { dark = true; break }
        k = k + 1
    }
    // test probe armed / running: the mood keeps collecting (capped just below 1) but nothing fires, so the probe sounds are one contiguous
    // run in the log; the held cave sound comes right after the last probe event
    if (*c).probe && (*c).probe_next != 0 as u64 && (*c).probe_i < 12 {
        if dark && (*c).amb.mood < 0.99 {
            (*c).amb.mood = (*c).amb.mood + 0.016 * (*c).amb_x / 60.0
            if (*c).amb.mood > 0.99 { (*c).amb.mood = 0.99 }
        }
        return
    }
    let h: u32 = mc_audio.mca_ambient_tick((*c).ma, &(*c).amb, dark, 0.016 * (*c).amb_x)
    if h != 0 as u32 { (*c).n_amb = (*c).n_amb + 1 as u64 }
}

// MCPLAY_AUDIO_PROBE=1: after the chunks are in, plays a fixed list of sounds 500 ms apart through the REAL engine/bank/sink
// (block step/break/place/hit/fall, glass, wood, grass, gravel, cave ambience, a mob, UI) so tools/mc/play/audio_check.py can
// find every one of them in the FILE sink dump (use with MCPLAY_AUDIO_LOG=1, no keyboard input).
fn audio_probe(c: *mut Ctx) {
    if !(*c).probe || !(*c).have_pos || (*c).n_chunks < 10 as u64 { return }
    let t: u64 = now_ms()
    if (*c).probe_next == 0 as u64 { (*c).probe_next = t + 800 as u64 }
    if t < (*c).probe_next { return }
    let names: [str; 12] = ["block.stone.step", "block.stone.break", "block.stone.place", "block.stone.hit", "block.stone.fall", "block.glass.break",
        "block.wood.break", "block.grass.step", "block.gravel.step", "ambient.cave", "entity.zombie.ambient", "ui.button.click"]
    let cats: [i32; 12] = [mc_audio.CAT_BLOCKS, mc_audio.CAT_BLOCKS, mc_audio.CAT_BLOCKS, mc_audio.CAT_BLOCKS, mc_audio.CAT_BLOCKS, mc_audio.CAT_BLOCKS,
        mc_audio.CAT_BLOCKS, mc_audio.CAT_BLOCKS, mc_audio.CAT_BLOCKS, mc_audio.CAT_AMBIENT, mc_audio.CAT_HOSTILE, mc_audio.CAT_UI]
    let i: i32 = (*c).probe_i
    if i >= 12 { return }
    (*c).probe_i = i + 1
    (*c).probe_next = t + 500 as u64
    var h: u32 = 0 as u32
    if i == 11 {
        h = mc_audio.mca_play_ui((*c).ma, names[i as usize], 1.0, 1.0)
    } else {
        h = mc_audio.mca_play_at((*c).ma, names[i as usize], cats[i as usize], (*c).pl.x + 2.0, (*c).pl.y, (*c).pl.z, 1.0, 1.0)
    }
    if h != 0 as u32 { (*c).n_snd = (*c).n_snd + 1 as u64 }
}

// Per frame: listener + finished voices; sinks without a clock get exactly the frames of the elapsed time.
fn audio_frame(c: *mut Ctx) {
    if !(*c).aud { return }
    mc_audio.mca_update((*c).ma, &(*c).cam, 0.016)
    audio_ambient(c)
    audio_probe(c)
    if !(*c).aud_thread {
        let t: u64 = now_ms()
        (*c).aud_owed = (*c).aud_owed + ((t - (*c).aud_t0) as f64) * (AUDIO_RATE as f64) / 1000.0
        (*c).aud_t0 = t
        var guard: i32 = 0
        while (*c).aud_owed >= 512.0 && guard < 64 {
            let n: usize = engine.engine_pump((*c).eng, (*c).snk, (*c).aud_owed as usize)
            if n == 0 { break }
            (*c).aud_owed = (*c).aud_owed - (n as f64)
            guard = guard + 1
        }
        (*(*c).ma).log_frame = sink.sink_bytes((*c).snk) / 4 as u64
    }
}

fn audio_stop(c: *mut Ctx) {
    if !(*c).aud { return }
    if (*c).aud_thread { engine.engine_audio_stop((*c).eng) }
    sink.sink_drain((*c).snk)
    let crc: u32 = sink.sink_crc((*c).snk)
    let nb: u64 = sink.sink_bytes((*c).snk)
    let np: u64 = (*(*c).ma).n_played
    let nm: u64 = (*(*c).ma).n_missing
    let ncu: u64 = (*(*c).ma).n_culled
    let ns: u64 = (*c).n_snd
    let npk: u64 = (*c).n_snd_pkt
    say(f"mcplay: audio bytes={nb} crc={crc} sounds={ns} packets={npk} played={np} missing={nm} culled={ncu}\n")
    let es: engine.Stats = engine.engine_stats((*c).eng)
    let pl100: i64 = (es.peak_hold_left * 100.0) as i64
    let pr100: i64 = (es.peak_hold_right * 100.0) as i64
    say(f"mcplay: audio_stats started={es.started} stolen={es.stolen} dropped={es.dropped} cmd_dropped={es.commands_dropped} underruns={es.stream_underruns} peak_l100={pl100} peak_r100={pr100} ambient={(*c).n_amb} probe={(*c).probe_i}\n")
    sink.sink_close((*c).snk)
}

// ---- drawing -----------------------------------------------------------------------------------------

// GL frame: same pass order as draw_frame (sky -> world -> selection box -> tint -> HUD), shown by present.
#[allow_escape]
// Entities: one interpolation step per frame (real time), then the visible ones become box records for the back end `b`.
fn ents_step(c: *mut Ctx) {
    let t: u64 = now_ns()
    var dt: f64 = 0.0
    if (*c).ent_t != 0 as u64 { dt = ((t - (*c).ent_t) as f64) / 1.0e9 }
    (*c).ent_t = t
    (*c).ent_moving = (*c).ent_moving + mc_entity.store_interp(&(*c).ents, dt, ENT_TAU, ENT_SNAP)
}

fn ents_draw(c: *mut Ctx, b: *mut mc_backend.Backend) {
    if !(*c).ents_on || !(*c).have_pos { return }
    mc_entity_draw.entlist_set_hurt(&(*c).entl, &(*c).cfx.tint, now_ms())
    (*c).entl.skip_players = (*c).pdraw_on
    mc_player_draw.pd_sync_use(&(*c).pdraw, (*c).combat.using_item, (*c).cfx.use_kind, now_ms())
    mc_entity_draw.entlist_set_death(&(*c).entl, &(*c).cfx.death)
    mc_entity_draw.entlist_set_backend(&(*c).entl, b)
    mc_entity_draw.entlist_build_reg(&(*c).entl, &(*c).ents, &(*c).cam, ENT_MAX_DIST, ENT_FAR_LOD, &(*c).reg)
    if (*c).pdraw_on { mc_player_draw.pd_remote(&(*c).pdraw, &(*c).entl, &(*c).ents, &(*c).cam, ENT_MAX_DIST, ENT_FAR_LOD, now_ms()) }
    mc_splash_draw.entlist_add_splashes(&(*c).entl, &(*c).splash, &(*c).cam, now_ms())
    mc_snowfall_draw.entlist_add_snowfall(&(*c).entl, &(*c).snowfall, &(*c).cam, now_ms())
    if mc_camera3p.mode_is_third((*c).cam3_mode) {
        let pose: i32 = mc_self_model.pose_of((*c).pl.swimming, (*c).pl.low_pose, (*c).pl.crouched, (*c).pl.sneaking)
        if (*c).pdraw_on {
            mc_player_draw.pd_self(&(*c).pdraw, &(*c).entl, &(*c).icons, &(*c).reg, mc_inv.inv_held_item(&(*c).inv, (*c).pl.slot), (*c).pl.x, (*c).pl.y, (*c).pl.z, (*c).pl.yaw, (*c).pl.pitch,
                pose == mc_self_model.POSE_SNEAK, pose == mc_self_model.POSE_PRONE, now_ms(), 0 as u64, 0 as u64)
        } else {
            mc_self_model.self_add(&(*c).entl, (*c).pl.x, (*c).pl.y, (*c).pl.z, (*c).pl.yaw, pose)
        }
    }
    if (*c).pdraw_on && !mc_camera3p.mode_is_third((*c).cam3_mode) && (*c).hand_on {
        mc_player_draw.pd_hand(&(*c).pdraw, &(*c).entl, &(*c).icons, &(*c).reg, mc_inv.inv_held_item(&(*c).inv, (*c).pl.slot), &(*c).cam, (*c).pl.yaw, now_ms(), 0 as u64, 0 as u64)
    }
    let vis: u32 = (*c).entl.n_in - (*c).entl.n_culled
    if vis > (*c).ent_vis_max { (*c).ent_vis_max = vis }
    if (*c).entl.n_tinted > 0 as u32 { (*c).cfx.n_tint_frames = (*c).cfx.n_tint_frames + 1 as u64 }
    let n: u64 = mc_entity_draw.entlist_draw(&(*c).entl, b)
    if (*c).entl.n_bolts > 0 as u32 && env_flag("MCPLAY_WEATHER_LOG", false) {
        say(f"mcplay: bolt drawn bolts={(*c).entl.n_bolts} boxes={(*c).entl.n_bolt_boxes}\n")
    }
    if n > 0 as u64 {
        (*c).ent_boxes = (*c).ent_boxes + n
        (*c).ent_frames = (*c).ent_frames + 1 as u64
    }
}

const SEL_E: f64 = 0.05 // maximum thickness of the selection box edges on the GL / Vulkan back ends
const SEL_PX: f64 = 1.0 // wanted thickness of those edges on screen in pixels (CPU lines are 1 px)

// World box of the current pick: model bounds when pack models are on (mc_model_pick), else the unit cube of the block.
fn sel_box(c: *mut Ctx) -> mc_model_pick.MpBox {
    var b: mc_model_pick.MpBox = mc_model_pick.MpBox { x0: (*c).pk.x as f64, y0: (*c).pk.y as f64, z0: (*c).pk.z as f64,
        x1: ((*c).pk.x as f64) + 1.0, y1: ((*c).pk.y as f64) + 1.0, z1: ((*c).pk.z as f64) + 1.0 }
    if (*c).models_on { mc_model_pick.mp_pick_box(&(*c).ms, &(*c).pk, &b) }
    return b
}

fn camera_water_fog_rgb(c: *mut Ctx) -> u32 {
    var v: mc_world_view.WorldView = mc_world_view.view_new(&(*c).world, (*c).dim.min_y)
    let bid: i32 = mc_world_view.view_biome(&v, math.floor((*c).cam.x) as i32, math.floor((*c).cam.y) as i32, math.floor((*c).cam.z) as i32)
    return mc_water_fog.wfc_step(&(*c).wfc, mc_biome_fog.bfog_color(bid), now_ms())
}

fn view_fog(c: *mut Ctx, start: f64, end: f64, r: u32, g: u32, b: u32) -> mc_water_fog.ViewFog {
    var water_rgb: u32 = mc_biome_fog.BFOG_DEFAULT
    if (*c).hudp.air.under { water_rgb = camera_water_fog_rgb(c) }
    return mc_water_fog.wfog_view((*c).hudp.air.under, (*c).hudp.air.vision, (*c).sky.daylight, start, end, r, g, b, water_rgb)
}

fn fog_clear(vf: *mut mc_water_fog.ViewFog, dflt: u32) -> u32 {
    if !(*vf).under { return dflt }
    return (255 as u32 << 24 as u32) | ((*vf).b << 16 as u32) | ((*vf).g << 8 as u32) | (*vf).r
}

#[allow_escape]
fn draw_frame_gl(c: *mut Ctx) {
    let view: f64 = far_view(c) as f64
    let fog_start: f64 = view * 16.0 * 0.5
    let fog_end: f64 = view * 16.0 + 8.0
    var vf: mc_water_fog.ViewFog = view_fog(c, fog_start, fog_end, (*c).sky.fr as u32, (*c).sky.fg as u32, (*c).sky.fb as u32)
    let clear: u32 = fog_clear(&vf, (255 as u32 << 24 as u32) | (FOG_B << 16 as u32) | (FOG_G << 8 as u32) | FOG_R)
    var dl: u64 = now_ns()
    gl_scene.scene_frame(&(*c).gsc)
    gl_mc.glbe_set_fog(&(*c).gb, true, vf.start, vf.end, vf.r, vf.g, vf.b)
    (*c).be.begin((*c).be.obj, ((&(*c).cam) as u64), clear)
    dl = mc_prof.prof_lap(mc_prof.PH_PRE, dl)
    if !vf.under { gl_scene.scene_sky(&(*c).gsc, &(*c).cam, &(*c).sky) }
    gl_scene.scene_pass_begin(&(*c).gsc, 0)
    if (*c).light { mc_render_world.wr_set_daylight(&(*c).be, light_day(c)) }
    dl = mc_prof.prof_lap(mc_prof.PH_SKY, dl)
    if (*c).have_pos {
        if (*c).stream_on {
            let ts0: u64 = now_ns()
            let tg: u64 = mc_stream.stream_frame(&(*c).stm, &(*c).world, &(*c).be, &(*c).cam)
            stream_time(c, now_ns() - ts0)
            dl = now_ns()
        } else {
            let ts0: u64 = now_ns()
            mc_render_world.wr_render_b(&(*c).g.wr, &(*c).world, &(*c).be, &(*c).cam, 0 - 1)
            stream_time(c, now_ns() - ts0)
        }
    }
    (*c).be.end((*c).be.obj)
    gl_scene.scene_pass_end(&(*c).gsc, 0)
    dl = mc_prof.prof_lap(mc_prof.PH_END, dl)
    // entity boxes: ONE instanced call through the scene layer, after end (the world is in the depth buffer)
    var ebe: mc_backend.Backend = (*c).be
    gl_scene.scene_attach(&(*c).gsc, &ebe)
    dl = mc_frame_split.fs_lap(mc_frame_split.FS_NONE, mc_prof.PH_POST, dl)
    ents_draw(c, &ebe)
    dl = mc_frame_split.fs_lap(mc_frame_split.FS_ENTD, mc_prof.PH_ENTD, dl)
    if (*c).hit {
        // selection box = 12 thin boxes along the edges of the picked box (model bounds with models, else the unit cube)
        var sb: mc_model_pick.MpBox = sel_box(c)
        var i: i32 = 0
        while i < 12 {
            var se: mc_model_pick.MpEdge = mc_model_pick.MpEdge { cx: 0.0, cy: 0.0, cz: 0.0, sx: 0.0, sy: 0.0, sz: 0.0 }
            mc_model_pick.mp_sel_edge_cam(&sb, &(*c).cam, SEL_PX, SEL_E, i, &se)
            var ee: gl_scene.Ent = gl_scene.ent_new(se.cx, se.cy, se.cz, se.sx, se.sy, se.sz, 0.0, 0 as u32, 0 as u32, 0 as u32)
            gl_scene.scene_ent_add(&(*c).gsc, &ee)
            i = i + 1
        }
    }
    dl = mc_frame_split.fs_lap(mc_frame_split.FS_SELB, mc_prof.PH_SELB, dl)
    gl_scene.scene_ent_flush(&(*c).gsc, &(*c).cam)
    if !(*c).light { gl_scene.scene_tint(&(*c).gsc, &(*c).sky) }
    dl = mc_frame_split.fs_lap(mc_frame_split.FS_ENTF, mc_prof.PH_ENTF, dl)
    var d: mc_hud.HudDebug = mc_hud.hud_debug_new()
    d.fps = (*c).fps
    d.x = (*c).pl.x
    d.y = (*c).pl.y
    d.z = (*c).pl.z
    d.yaw = (*c).pl.yaw
    d.pitch = (*c).pl.pitch
    d.has_block = (*c).hit
    if (*c).hit {
        d.bx = (*c).pk.x
        d.by = (*c).pk.y
        d.bz = (*c).pk.z
        d.id = (*c).pk.id
        d.nx = (*c).pk.nx
        d.ny = (*c).pk.ny
        d.nz = (*c).pk.nz
    }
    var rec: rt.Buf = rt.buf_new()
    mc_hud.hud_record(&rec)
    mc_weather_fx.weather_fx_draw(&(*c).g.r, mc_hud.hud_scale((*c).w, (*c).h), &(*c).weather, now_ms())
    draw_cracks(c, &(*c).g.r)
    hud_base(c, &(*c).g.r, &d)
    draw_inventory(c, &(*c).g.r)
    mc_hud.hud_record(0 as *mut rt.Buf)
    dl = mc_frame_split.fs_lap(mc_frame_split.FS_HUDB, mc_prof.PH_HUDB, dl)
    gl_scene.scene_hud(&(*c).gsc, &rec)
    rt.buf_free(&rec)
    dl = mc_frame_split.fs_lap(mc_frame_split.FS_HUDS, mc_prof.PH_HUDS, dl)
}

fn gl_open_all(c: *mut Ctx, w0: i32, h0: i32) -> bool {
    var o: glwindow.Opts = glwindow.opts_default()
    o.vsync = want_vsync() as i32
    o.full_input = true
    var ok: bool = glwindow.open(&(*c).gw, w0, h0, "mcplay", o)
    if !ok && o.vsync != 0 {
        o.vsync = 0
        ok = glwindow.open(&(*c).gw, w0, h0, "mcplay", o)
    }
    if !ok {
        io.eprint_line("mcplay: GL window failed (no EGL/GLX?)")
        return false
    }
    (*c).wp = &(*c).gw.win
    window.raw_input((*c).wp, true)
    (*c).gb = gl_mc.glbe_open_with(glwindow.take_ctx(&(*c).gw), w0, h0)
    if !(*c).gb.ok {
        io.eprint_line("mcplay: GL back end failed")
        glwindow.close(&(*c).gw)
        return false
    }
    if env.has("MCPLAY_GL_MODE") {
        let gmode: i32 = gl_mc.glbe_set_mode(&(*c).gb, env_int("MCPLAY_GL_MODE", 2))
        say(f"mcplay: gl mode {gmode}\n")
    }
    gl_mc.glbe_set_facecull(&(*c).gb, env_flag("MCPLAY_FACECULL", true))
    gl_mc.glbe_set_split(env_int("MCPLAY_GL_SPLIT", 256))
    let tex_filter: i32 = env_int("MCPLAY_FILTER", 0)
    if tex_filter == 1 { gl_mc.glbe_set_filter(&(*c).gb, true, 1.0) }
    if tex_filter >= 2 { gl_mc.glbe_set_filter(&(*c).gb, true, 8.0) }
    (*c).gsc = gl_scene.scene_open(&(*c).gb)
    if !(*c).gsc.ok || !glshow.show_init(&(*c).sh, gl_mc.glbe_gl(&(*c).gb)) {
        io.eprint_line("mcplay: GL scene layer failed")
        glwindow.close(&(*c).gw)
        return false
    }
    (*c).be = gl_mc.glbe_backend(&(*c).gb)
    (*c).gl = true
    if (*c).g.use_res {
        mc_packs.res_reload_upload(&(*c).g.res, &(*c).be)
    } else {
        (*c).be.upload_atlas((*c).be.obj, ((&(*c).g.atlas) as u64))
    }
    io.print("mcplay: gl renderer=")
    io.print_c(gl_mc.glbe_renderer(&(*c).gb))
    say(f" api={glwindow.api_name(&(*c).gw)} vsync={glwindow.swap_interval_get(&(*c).gw)}\n")
    return true
}

// MCPLAY_GFX=vk
fn want_vk_gfx() -> bool {
    if !env.has("MCPLAY_GFX") { return false }
    let v: str = env.get("MCPLAY_GFX")
    return v.length() == 2 && v.chars(0) == 118 as u8 && v.chars(1) == 107 as u8
}

// MCPLAY_VK_PRESENT=readback: present the read back image through the X11 window instead of a swapchain.
fn want_vk_readback_present() -> bool {
    if !env.has("MCPLAY_VK_PRESENT") { return false }
    let v: str = env.get("MCPLAY_VK_PRESENT")
    return v.length() == 8 && v.chars(0) == 114 as u8
}

// Opens the Vulkan back end for the window size w x h and uploads the atlas / resource pack. false = no Vulkan device (the caller keeps the CPU path).
fn vk_open_be(c: *mut Ctx, w: i32, h: i32) -> bool {
    var cp: str = ""
    if env.has("MCPLAY_VK_CACHE") { cp = env.get("MCPLAY_VK_CACHE") }
    // Present through a swapchain on the window (r195) unless MCPLAY_VK_PRESENT=readback (old path: read back -> X11 image). The swapchain needs the
    // mapped window; without surface support the back end still opens and mcplay presents the read back image.
    var xid: u64 = 0
    if !want_vk_readback_present() && (*c).wp != (0 as *mut window.Window) { xid = backend.r_native(&(*(*c).wp).p) }
    // MCPLAY_VSYNC=0: IMMEDIATE / MAILBOX present mode (uncapped, for benchmarks); default FIFO
    if !vk_mc.vkbe_open_win_v(&(*c).vbk, w, h, cp, xid, 0, want_vsync()) {
        say(f"mcplay: vk back end failed (step {(*c).vbk.step})\n")
        return false
    }
    // readback (a copy + a wait per frame) only without a swapchain, or when MCPLAY_SHOT needs the last frame
    vk_mc.vkbe_set_readback(&(*c).vbk, !vk_mc.vkbe_sc_on(&(*c).vbk) || env.has("MCPLAY_SHOT"))
    (*c).be = vk_mc.vkbe_backend(&(*c).vbk)
    if (*c).g.use_res {
        mc_packs.res_reload_upload(&(*c).g.res, &(*c).be)
    } else {
        (*c).be.upload_atlas((*c).be.obj, ((&(*c).g.atlas) as u64))
    }
    return true
}

// A lost device (failed submit or MCPLAY_VK_LOST_AT): free the stream + meshes, close and re-open the back end (cache file reloaded), upload the atlas again,
// re-announce every loaded column. The window and the world stay. Real device loss is UNTESTED (lavapipe never loses a device): only the simulated path is.
fn vk_recover(c: *mut Ctx) {
    (*c).vk_losses = (*c).vk_losses + 1 as u64
    say(f"mcplay: vk device lost at frame {(*c).n_frames} -- re-opening\n")
    stream_release(c)
    mc_render_world.wr_clear_b(&(*c).g.wr, &(*c).be)
    vk_mc.vkbe_close(&(*c).vbk)
    if !vk_open_be(c, (*c).w, (*c).h) {
        io.eprint_line("mcplay: vk recovery failed -- quitting")
        (*c).closed = true
        return
    }
    if (*c).join { stream_make(c) }
    (*c).vk_recoveries = (*c).vk_recoveries + 1 as u64
}

// Vulkan frame: ONE render pass, same order as the GL path: sky, world, entities (+ selection box), tint, HUD; end submits.
#[allow_escape]
fn draw_frame_vk(c: *mut Ctx) {
    let view: f64 = far_view(c) as f64
    let fog_start: f64 = view * 16.0 * 0.5
    let fog_end: f64 = view * 16.0 + 8.0
    var vf: mc_water_fog.ViewFog = view_fog(c, fog_start, fog_end, (*c).sky.fr as u32, (*c).sky.fg as u32, (*c).sky.fb as u32)
    let clear: u32 = fog_clear(&vf, (255 as u32 << 24 as u32) | (FOG_B << 16 as u32) | (FOG_G << 8 as u32) | FOG_R)
    if (*c).vk_lost_at != 0 as u64 && (*c).n_frames == (*c).vk_lost_at { vk_mc.vkbe_inject_lost(&(*c).vbk) }
    vk_mc.vkbe_set_fog(&(*c).vbk, true, vf.start, vf.end, vf.r, vf.g, vf.b)
    (*c).be.begin((*c).be.obj, ((&(*c).cam) as u64), clear)
    if !vf.under { vk_mc.vkbe_sky(&(*c).vbk, &(*c).cam, &(*c).sky) }
    if (*c).light { mc_render_world.wr_set_daylight(&(*c).be, light_day(c)) }
    if (*c).have_pos {
        let ts0: u64 = now_ns()
        if (*c).stream_on {
            let tg: u64 = mc_stream.stream_frame(&(*c).stm, &(*c).world, &(*c).be, &(*c).cam)
        } else {
            mc_render_world.wr_render_b(&(*c).g.wr, &(*c).world, &(*c).be, &(*c).cam, 0 - 1)
        }
        stream_time(c, now_ns() - ts0)
    }
    ents_draw(c, &(*c).be)
    if (*c).hit {
        // selection box = 12 thin boxes along the edges of the picked box (black), same records as the GL scene layer
        var recs: [f64; 144] = [0.0; 144]
        var sb: mc_model_pick.MpBox = sel_box(c)
        var m: usize = 0
        while m < 12 {
            var se: mc_model_pick.MpEdge = mc_model_pick.MpEdge { cx: 0.0, cy: 0.0, cz: 0.0, sx: 0.0, sy: 0.0, sz: 0.0 }
            mc_model_pick.mp_sel_edge_cam(&sb, &(*c).cam, SEL_PX, SEL_E, m as i32, &se)
            let o: usize = m * 12
            recs[o] = se.cx
            recs[o + 1] = se.cy
            recs[o + 2] = se.cz
            recs[o + 3] = se.sx
            recs[o + 4] = se.sy
            recs[o + 5] = se.sz
            recs[o + 7] = 1.0
            m = m + 1
        }
        let nb: u64 = (*c).be.draw_entities((*c).be.ent_obj, (&recs[0]) as u64, m)
    }
    if !(*c).light { vk_mc.vkbe_tint(&(*c).vbk, &(*c).sky) }
    var d: mc_hud.HudDebug = mc_hud.hud_debug_new()
    d.fps = (*c).fps
    d.x = (*c).pl.x
    d.y = (*c).pl.y
    d.z = (*c).pl.z
    d.yaw = (*c).pl.yaw
    d.pitch = (*c).pl.pitch
    d.has_block = (*c).hit
    if (*c).hit {
        d.bx = (*c).pk.x
        d.by = (*c).pk.y
        d.bz = (*c).pk.z
        d.id = (*c).pk.id
        d.nx = (*c).pk.nx
        d.ny = (*c).pk.ny
        d.nz = (*c).pk.nz
    }
    var rec: rt.Buf = rt.buf_new()
    mc_hud.hud_record(&rec)
    mc_weather_fx.weather_fx_draw(&(*c).g.r, mc_hud.hud_scale((*c).w, (*c).h), &(*c).weather, now_ms())
    draw_cracks(c, &(*c).g.r)
    hud_base(c, &(*c).g.r, &d)
    draw_inventory(c, &(*c).g.r)
    mc_hud.hud_record(0 as *mut rt.Buf)
    vk_mc.vkbe_hud(&(*c).vbk, &rec)
    rt.buf_free(&rec)
    (*c).be.end((*c).be.obj)
    if vk_mc.vkbe_lost(&(*c).vbk) { vk_recover(c) }
}

fn draw_frame(c: *mut Ctx) {
    if (*c).vk {
        draw_frame_vk(c)
        return
    }
    if (*c).gl {
        draw_frame_gl(c)
        return
    }
    let r: *mut mc_raster.Raster = &(*c).g.r
    let view: f64 = far_view(c) as f64
    let fog_start: f64 = view * 16.0 * 0.5
    let fog_end: f64 = view * 16.0 + 8.0
    var vf: mc_water_fog.ViewFog = view_fog(c, fog_start, fog_end, (*c).sky.fr as u32, (*c).sky.fg as u32, (*c).sky.fb as u32)
    mc_raster.raster_set_fog(r, true, fog_start, fog_end, FOG_R, FOG_G, FOG_B)
    let clear: u32 = fog_clear(&vf, (255 as u32 << 24 as u32) | (FOG_B << 16 as u32) | (FOG_G << 8 as u32) | FOG_R)
    mc_raster.backend_begin(r, &(*c).cam, clear)
    if !vf.under { mc_sky.sky_draw(&(*c).sky, r) }
    mc_raster.raster_set_fog(r, true, vf.start, vf.end, vf.r, vf.g, vf.b)
    if (*c).light {
        var be: mc_backend.Backend = mc_backend.backend_cpu(r)
        mc_render_world.wr_set_daylight(&be, light_day(c))
    }
    if (*c).have_pos {
        if (*c).stream_on {
            var sbe: mc_backend.Backend = mc_backend.backend_cpu(r)
            let ts0: u64 = now_ns()
            let tc: u64 = mc_stream.stream_frame(&(*c).stm, &(*c).world, &sbe, &(*c).cam)
            stream_time(c, now_ns() - ts0)
        } else {
            let ts0: u64 = now_ns()
            mc_render_world.wr_render(&(*c).g.wr, &(*c).world, r, &(*c).cam, 0 - 1)
            stream_time(c, now_ns() - ts0)
        }
    }
    var ebe: mc_backend.Backend = mc_backend.backend_cpu(r)
    ents_draw(c, &ebe)
    if !(*c).light { mc_sky.sky_tint_frame(&(*c).sky, r) }
    if (*c).hit {
        if (*c).models_on {
            mc_model_pick.mp_draw_box(r, &(*c).ms, &(*c).pk, BOX_RGBA)
        } else {
            mc_input.input_draw_box(r, (*c).pk.x, (*c).pk.y, (*c).pk.z, BOX_RGBA)
        }
    }
    var d: mc_hud.HudDebug = mc_hud.hud_debug_new()
    d.fps = (*c).fps
    d.x = (*c).pl.x
    d.y = (*c).pl.y
    d.z = (*c).pl.z
    d.yaw = (*c).pl.yaw
    d.pitch = (*c).pl.pitch
    d.has_block = (*c).hit
    if (*c).hit {
        d.bx = (*c).pk.x
        d.by = (*c).pk.y
        d.bz = (*c).pk.z
        d.id = (*c).pk.id
        d.nx = (*c).pk.nx
        d.ny = (*c).pk.ny
        d.nz = (*c).pk.nz
    }
    mc_weather_fx.weather_fx_draw(r, mc_hud.hud_scale((*c).w, (*c).h), &(*c).weather, now_ms())
    draw_cracks(c, r)
    hud_base(c, r, &d)
    draw_inventory(c, r)
}

fn shot_request(c: *mut Ctx) {
    (*c).shot_req = true
    if (*c).vk { vk_mc.vkbe_set_readback(&(*c).vbk, true) }
}

fn shot_take(c: *mut Ctx) {
    if !(*c).shot_req { return }
    if (*c).vk && !(*c).shot_armed {
        (*c).shot_armed = true
        return
    }
    (*c).shot_req = false
    (*c).shot_armed = false
    var be: mc_backend.Backend = cur_be(c)
    let px: u64 = be.present(be.obj)
    var path: rt.Buf = rt.buf_new()
    if mc_shot.shot_save(px, (*c).w, (*c).h, &path) {
        (*c).shot_n = (*c).shot_n + 1
        say(f"mcplay: screenshot saved n={(*c).shot_n} path={rt.buf_str(&path)}\n")
    } else {
        say(f"mcplay: screenshot failed\n")
    }
    rt.buf_free(&path)
    if (*c).vk { vk_mc.vkbe_set_readback(&(*c).vbk, !vk_mc.vkbe_sc_on(&(*c).vbk) || env.has("MCPLAY_SHOT")) }
}

fn present(c: *mut Ctx) {
    shot_take(c)
    if (*c).vk {
        if vk_mc.vkbe_sc_on(&(*c).vbk) { return } // swapchain: end() already presented
        // read back (RGBA, row 0 = top, waits for the newest frame) -> X11 image
        let px: u64 = (*c).be.present((*c).be.obj)
        if px != 0 as u64 {
            mc_present.rgba_to_bgrx(px, (*c).bg, ((*c).w as usize) * ((*c).h as usize))
            window.image((*c).wp, (*c).bg, (*c).w as usize, (*c).h as usize, 0, 0)
        }
        window.present((*c).wp)
        return
    }
    if (*c).gl {
        gl_scene.scene_present_window(&(*c).gsc, &(*c).sh, (*c).w, (*c).h)
        let ps0: u64 = now_ns()
        glwindow.swap(&(*c).gw)
        mc_prof.prof_add(mc_prof.PH_PRESENT_SWAP, now_ns() - ps0)
        return
    }
    mc_present.rgba_to_bgrx((*c).g.r.color, (*c).bg, ((*c).w as usize) * ((*c).h as usize))
    window.image((*c).wp, (*c).bg, (*c).w as usize, (*c).h as usize, 0, 0)
    window.present((*c).wp)
}

// ---- main ----------------------------------------------------------------------------------------------

// ---- log file (windows subsystem build has no console) ------------------------------------------------

// Redirects stdout + stderr (fd 1, 2) into a file. MCPLAY_LOG=<file> forces it; MCPLAY_LOG=- never redirects. Without the
// variable it only happens when fd 1 is dead (a --win-subsystem=windows exe started from a shortcut has no std handle)
// and a per-user dir exists: %LOCALAPPDATA%/mcplay/mcplay.log (Windows) or $HOME/.cache/mcplay/mcplay.log.
fn log_redirect() {
    var path: rt.Buf = rt.buf_new()
    if env.has("MCPLAY_LOG") {
        let v: str = env.get("MCPLAY_LOG")
        if v.n == 0 || (v.n == 1 && rt.ld8(v.p as u64, 0) == 45 as u8) {
            rt.buf_free(&path)
            return
        }
        push_str(&path, v)
    } else {
        var probe: [u8; 1] = [0; 1]
        if syscall(1, 1, (&probe[0]) as i64, 0, 0, 0, 0) >= 0 {
            rt.buf_free(&path)
            return
        }
        var dir: rt.Buf = rt.buf_new()
        if env.has("LOCALAPPDATA") {
            push_str(&dir, env.get("LOCALAPPDATA"))
            push_str(&dir, "/mcplay")
        } else if env.has("HOME") {
            push_str(&dir, env.get("HOME"))
            push_str(&dir, "/.cache/mcplay")
        } else {
            rt.buf_free(&dir)
            rt.buf_free(&path)
            return
        }
        rt.buf_push(&dir, 0 as u8)
        syscall(83, rt.buf_ptr(&dir) as i64, 493, 0, 0, 0, 0)
        rt.buf_free(&dir)
        if env.has("LOCALAPPDATA") {
            push_str(&path, env.get("LOCALAPPDATA"))
            push_str(&path, "/mcplay/mcplay.log")
        } else {
            push_str(&path, env.get("HOME"))
            push_str(&path, "/.cache/mcplay/mcplay.log")
        }
    }
    rt.buf_push(&path, 0 as u8)
    // O_WRONLY|O_CREAT|O_TRUNC (+ the portable O_CLOEXEC bit fs.fi uses), mode 0644
    let fd: i64 = syscall(2, rt.buf_ptr(&path) as i64, 524865, 420, 0, 0, 0)
    rt.buf_free(&path)
    if fd < 0 { return }
    syscall(33, fd, 1, 0, 0, 0, 0)
    syscall(33, fd, 2, 0, 0, 0, 0)
    if fd > 2 { syscall(3, fd, 0, 0, 0, 0, 0) }
}

// MCPLAY_PICK_PROBE="ox,oy,oz,dx,dy,dz[;...]" (thousandths: origin in blocks, direction): rays at the end of the run through the same pick path as the
// mouse (models on: mc_model_pick, else mc_input.input_pick), reach 20. Prints `mcplay: probe models=<0|1> hit=<0|1> x= y= z= n=nx,ny,nz dist_mm= id=` per ray.
fn pick_ray_probe(c: *mut Ctx, v: str) {
    var parts: [i64; 6] = [0; 6]
    var k: usize = 0
    var st: usize = 0
    var i: usize = 0
    while i <= v.length() {
        if i == v.length() || v.chars(i) == 44 as u8 {
            if k < 6 { parts[k] = parse_dec((v.p as u64) + (st as u64), i - st, 0 as i64) }
            k = k + 1
            st = i + 1
        }
        i = i + 1
    }
    if k != 6 {
        io.eprint_line("mcplay: MCPLAY_PICK_PROBE needs ox,oy,oz,dx,dy,dz (thousandths)")
        return
    }
    var pk: mc_input.Pick = mc_input.Pick { x: 0, y: 0, z: 0, nx: 0, ny: 0, nz: 0, dist: 0.0, id: 0 }
    let ox: f64 = (parts[0] as f64) / 1000.0
    let oy: f64 = (parts[1] as f64) / 1000.0
    let oz: f64 = (parts[2] as f64) / 1000.0
    let dx: f64 = (parts[3] as f64) / 1000.0
    let dy: f64 = (parts[4] as f64) / 1000.0
    let dz: f64 = (parts[5] as f64) / 1000.0
    var hit: bool = false
    if (*c).models_on {
        hit = mc_model_pick.mp_pick(&(*c).world, (*c).dim.min_y, &(*c).itb, &(*c).ms, ox, oy, oz, dx, dy, dz, 20.0, &pk)
    } else {
        hit = mc_input.input_pick(&(*c).world, (*c).dim.min_y, &(*c).itb, ox, oy, oz, dx, dy, dz, 20.0, &pk)
    }
    var h: i32 = 0
    if hit { h = 1 }
    var mo: i32 = 0
    if (*c).models_on { mo = 1 }
    say(f"mcplay: probe models={mo} hit={h} x={pk.x} y={pk.y} z={pk.z} n={pk.nx},{pk.ny},{pk.nz} dist_mm={(pk.dist * 1000.0 + 0.5) as i64} id={pk.id}\n")
}

fn pick_probe(c: *mut Ctx) {
    if !env.has("MCPLAY_PICK_PROBE") { return }
    let v: str = env.get("MCPLAY_PICK_PROBE")
    var st: usize = 0
    var i: usize = 0
    while i <= v.length() {
        if i == v.length() || v.chars(i) == 59 as u8 {
            pick_ray_probe(c, str { p: ((v.p as u64) + (st as u64)) as *mut u8, n: i - st })
            st = i + 1
        }
        i = i + 1
    }
}

struct Launch {
    host: u64,
    name: u64,
    port: i64,
    proto: i32,
    view: i32,
    tok: rt.Buf,
    uuid: rt.Buf,
    end_kind: i32,
    end_text: rt.Buf,
}

fn launch_error(ln: *mut Launch, rc: i32, msg: str) -> i32 {
    (*ln).end_kind = END_FAIL
    rt.buf_clear(&(*ln).end_text)
    rt.buf_push_bytes(&(*ln).end_text, msg.p as u64, msg.n)
    return rc
}

fn login_fail_text(c: *mut Ctx, lr: i32, out: *mut rt.Buf) {
    if lr == mc_client.CL_KICKED {
        var raw_text: rt.Buf = rt.buf_new()
        if mc_client.client_kick_text(&(*c).cl, &raw_text) {
            var doc: mc_text.TextDoc = mc_text.text_new()
            if mc_text.text_from_json(&doc, rt.buf_ptr(&raw_text), rt.buf_len(&raw_text), &(*c).chat_net.tr) {
                mc_text.text_plain(&doc, out)
            } else {
                rt.buf_push_bytes(out, rt.buf_ptr(&raw_text), rt.buf_len(&raw_text))
            }
            mc_text.text_free(&doc)
        }
        rt.buf_free(&raw_text)
    }
    if rt.buf_len(out) == 0 {
        let why: str = mc_client.client_error_text(lr)
        rt.buf_push_bytes(out, why.p as u64, why.n)
    }
}

fn launch_fill(ln: *mut Launch, start: u64, argc: usize, s_host: *mut rt.Buf, s_name: *mut rt.Buf, s_port: i32, s_proto: i32, s_view: i32) -> i32 {
    var host: u64 = rt.buf_ptr(s_host)
    var name: u64 = rt.buf_ptr(s_name)
    var port: i64 = s_port as i64
    if argc >= 2 { host = rt.arg_ptr(start, 1) }
    if argc >= 3 {
        let pp: u64 = rt.arg_ptr(start, 2)
        port = parse_dec(pp, rt.c_length(pp), 0 - 1)
    }
    if argc >= 4 { name = rt.arg_ptr(start, 3) }
    if host == 0 as u64 || name == 0 as u64 || rt.c_length(name) == 0 {
        io.eprint_line("mcplay: host or name missing (command line and session file)")
        return launch_error(ln, 2, "Host or name missing")
    }
    if !mc_hostname.host_valid(host, rt.c_length(host)) || port <= 0 || port > 65535 {
        io.eprint_line("mcplay: bad host or port (DNS name or IPv4 expected)")
        return launch_error(ln, 2, "Bad host or port (DNS name or IPv4 expected)")
    }
    (*ln).host = host
    (*ln).name = name
    (*ln).port = port
    (*ln).proto = s_proto
    (*ln).view = s_view
    return 0
}

fn session_free(c: *mut Ctx) {
    stream_release(c)
    mc_audio.mca_set_lazy_pool((*c).ma, 0 as u64, 0)
    if (*c).pool.blk != 0 { jobs.destroy(&(*c).pool) }
    if (*c).vk {
        mc_render_world.wr_free_b(&(*c).g.wr, &(*c).be)
        vk_mc.vkbe_close(&(*c).vbk)
    } else if (*c).gl {
        mc_render_world.wr_free_b(&(*c).g.wr, &(*c).be)
        gl_scene.scene_close(&(*c).gsc)
        gl_mc.glbe_close(&(*c).gb)
    } else {
        mc_render_world.wr_free(&(*c).g.wr, &(*c).g.r)
    }
    mc_model_mesh.ms_free(&(*c).ms)
    if (*c).wp != (0 as *mut window.Window) { window.close_window((*c).wp) }
    mc_entity_draw.entlist_free(&(*c).entl)
    mc_player_draw.pd_free(&(*c).pdraw)
    mc_entity.store_free(&(*c).ents)
    mc_world.world_free(&(*c).world)
    mc_chunk.scratch_free(&(*c).sc)
    mc_client.client_free(&(*c).cl)
    mc_pause.pause_release()
    if (*c).bg != 0 {
        rt.heap_free((*c).bg, ((*c).w as usize) * ((*c).h as usize) * 4)
        (*c).bg = 0
    }
    mc_chat.chat_free(&(*c).chat)
    mc_cont_act.act_free(&(*c).cact)
    mc_trade_ui.tui_free(&(*c).tui)
    mc_chat_net.chat_net_free(&(*c).chat_net)
    mc_chat_ui.chatui_free(&(*c).chat_ui)
    mc_tablist.tab_free(&(*c).tabl)
    mc_inv.inv_free(&(*c).inv)
    mc_health.health_free(&(*c).health)
    mc_hud_play.hp_free(&(*c).hudp)
    mc_inv_ui.iui_free(&(*c).iui)
    mc_cont_ui.cui_free(&(*c).cui)
    mc_creative_ui.crui_free(&(*c).crui)
    mc_item_icon.icons_free(&(*c).icons)
    mc_wlight.wl_free(&(*c).wl)
    mc_audio.mca_free((*c).ma)
    bank.bank_free((*c).bnk)
    engine.engine_free((*c).eng)
    mc_packs.res_free(&(*c).g.res)
    mc_texture.tex_free_tables(&(*c).g.tb)
    mc_raster.raster_free(&(*c).g.r)
    rt.buf_free(&(*c).end_text)
}

fn session_abort(c: *mut Ctx) {
    audio_stop(c)
    session_free(c)
}

#[allow_escape]
fn run_session(start: u64, ln: *mut Launch) -> i32 {
    let host: u64 = (*ln).host
    let name: u64 = (*ln).name
    let port: i64 = (*ln).port
    var view_def: i32 = 6
    if (*ln).view > 0 { view_def = (*ln).view }
    var proto_def: i32 = 763
    if (*ln).proto > 0 { proto_def = (*ln).proto }
    if !env.has("MCPLAY_VIEW") && mc_pause.pause_wanted() {
        let saved_view: i32 = mc_pause.pause_saved_view()
        if saved_view > 0 { view_def = saved_view }
    }
    let view_req: i32 = env_int("MCPLAY_VIEW", view_def)
    let proto: i32 = env_int("MCPLAY_PROTOCOL", proto_def)
    let w0: i32 = env_int("MCPLAY_W", 854)
    let h0: i32 = env_int("MCPLAY_H", 480)
    let vanilla_ok: bool = mc_packs.res_vanilla_wanted(proto)
    let use_res: bool = vanilla_ok || mc_packs.res_env_wanted()
    let run_s: i32 = env_int("MCPLAY_RUN_S", 0)
    let gl_auto: bool = osinfo.is_windows() && !env.has("MCPLAY_GL") && !env.has("MCPLAY_GFX")
    let vk_first: bool = gl_auto && !env_flag("MCPLAY_NO_VK", false)
    let want_gl: bool = env_flag("MCPLAY_GL", gl_auto && !vk_first)
    var gb0: gl_mc.GlBackend = gl_mc.glbe_open_with(glctx.ctx_blank(), 1, 1)
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(proto, &ver) || ver.chunk_format == mc_version.CF_LEGACY_8 {
        io.eprint_line("mcplay: unsupported protocol number")
        return launch_error(ln, 2, "Unsupported protocol number")
    }
    var winner: usize = 0
    var conn: net.Conn = mc_connect.connect_host(host, rt.c_length(host), port as u16, &winner)
    if !net.conn_is_open(&conn) {
        io.eprint_line("mcplay: connect failed")
        return launch_error(ln, 3, "Connection refused or timed out")
    }
    net.set_no_delay(&conn, true) catch false
    let lod_plan: mc_lod_policy.LodPlan = mc_lod_policy.lod_plan(view_req, env_int("MCPLAY_LOD", mc_lod_policy.LOD_UNSET))
    let view: i32 = lod_plan.view
    let lod_n: i32 = lod_plan.lod
    say(f"mcplay: session start view={view} lod={lod_n} protocol={proto}\n")
    // MCPLAY_MODELS: unset / empty = auto (on when resource packs are loaded, also with LOD: models only in the full ring; on every back end; without packs nothing changes),
    // 1 = on (warns and falls back when a condition is missing), 0 = off (full cubes like before r244)
    var models_auto: bool = true
    var models_on: bool = false
    if env.has("MCPLAY_MODELS") {
        let mv: str = env.get("MCPLAY_MODELS")
        if mv.length() > 0 {
            models_auto = false
            models_on = mv.chars(0) == 49 as u8
        }
    }
    if models_auto {
        models_on = use_res
    }
    if models_on && !use_res {
        io.eprint_line("mcplay: MCPLAY_MODELS=1 needs resource packs (MC_PACKS / MC_PACK_CONFIG / MC_PACK_AUTO) -- ignored")
        models_on = false
    }
    // models go through mc_stream (stream_set_models, worker meshing) or, with MCPLAY_STREAM=0, through mc_render_world (g.wr)
    let want_stream: bool = lod_n > 0 || env_flag("MCPLAY_STREAM", true)
    // GL + Firn worker threads (r167): the thread runtime keeps its block behind `gs` in programs linked against glibc
    // (thread.rs use_gs), so glibc's TLS (`fs`) stays intact and GL dispatch / dlopen(libEGL) work next to the mesher threads.
    // Workers never call GL (upload only in `consume` on the render thread).
    // Vulkan too (r199): with the r167 TLS fix the mesher threads run next to libvulkan_lvp (gate tools/mc/play/run_vk.sh checks workers=3 pool=true).
    let n_workers: i32 = env_int("MCPLAY_WORKERS", mc_workers.workers_default())
    var dummy_tb: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    var eng: engine.Engine = engine.engine_new(AUDIO_RATE, 48 as u32)
    var bnk: bank.Bank = bank.bank_new()
    var snk: sink.Sink = sink.sink_open_file("/dev/null", AUDIO_RATE, 2 as u32, false)
    var ma: mc_audio.McAudio = mc_audio.mca_new(&eng)
    mc_audio.mca_set_lazy_sounds(&ma, env_flag("MCPLAY_LAZY_SOUNDS", true), env_int("MCPLAY_LAZY_EAGER_MS", 2000) as u64, env_int("MCPLAY_LAZY_MIN_EVENTS", 256) as usize)
    var c: Ctx = Ctx {
        cl: mc_client.client_new(conn, ver),
        world: mc_world.world_new(),
        sc: mc_chunk.scratch_new(),
        dim: mc_dimension.dim_default_overworld(),
        g: gfx_new(w0, h0, &ver, 0, view, use_res),
        itb: mc_input.InputTables { pick: 0, solid: 0, n: 0 },
        cam: mc_camera.camera_new(w0, h0),
        sky: mc_sky.sky_new(),
        pl: mc_input.player_new(0.0, 0.0, 0.0),
        rw: raw.raw_new(),
        win: window.window_new(), wp: 0 as *mut window.Window, gl: false, vk: false, vbk: vk_mc.vkbe_blank(), vk_lost_at: env_int("MCPLAY_VK_LOST_AT", 0) as u64, vk_losses: 0 as u64, vk_recoveries: 0 as u64, gw: glwindow.glwindow_new(), gb: gb0, gsc: gl_scene.scene_empty(&gb0), sh: glshow.show_new(), be: mc_backend.backend_new(),
        stm: mc_stream.stream_new(0, 1, 1, &dummy_tb, 0 as u64), stream_on: want_stream, models_on: models_on, ms: mc_model_mesh.ms_blank(), stm_live: true, lod: lod_n, pool: jobs.Jobs { blk: 0 }, win_cx: 1000000, win_cz: 1000000, win_n: 0 as u32, n_win: 0 as u64, t_stream: 0 as u64, max_stream: 0 as u64,
        pk: mc_input.Pick { x: 0, y: 0, z: 0, nx: 0, ny: 0, nz: 0, dist: 0.0, id: 0 },
        bg: 0, w: w0, h: h0, view: view, protocol: proto,
        join: false, have_pos: false, last_tp: 0, tp_quiet_until: 0 as u64, grab: false, focus_lost: false, closed: false, resized: false, fullscreen: false, hit: false,
        creative: env_flag("MCPLAY_CREATIVE", true), creative_fixed: env.has("MCPLAY_CREATIVE"),
        acc_dx: 0.0, acc_dy: 0.0, tot_dx: 0.0, tot_dy: 0.0, n_f11: 0, want_fly: false, want_noclip: false, sent_slot: 0 - 1,
        digging: false, dig_x: 0, dig_y: 0, dig_z: 0, dig_t0: 0, dig_ms: env_int("MCPLAY_DIG_MS", 700) as u64, dp: mc_dig_progress.dp_new(), vsync: mc_view_sync.vs_new(view_req, env.has("MCPLAY_VIEW")), dig_state: 0, crk: mc_crack.crack_tex_new(), crk_tried: false, crk_on: env_flag("MCPLAY_CRACK", true), cra: mc_crack_anim.crack_anims_new(), crk_own: 0 as u64, bot: mc_dig_bot.digbot_new(env.has("MCPLAY_BOT_DIG_Y"), env_int("MCPLAY_BOT_DIG_X", 0), env_int("MCPLAY_BOT_DIG_Y", 0), env_int("MCPLAY_BOT_DIG_Z", 0), env_int("MCPLAY_BOT_DIG_MS", 3000) as u64), bot_go: env_str("MCPLAY_BOT_GO_FILE", ""), crk_other: 0 as u64, seq: 0,
        place_id: env_int("MCPLAY_PLACE_ID", 0), ticks_day: env_int("MCPLAY_TICKS", 2000),
        light: env_flag("MCPLAY_LIGHT", true), wl: mc_wlight.wl_new(0, 24), region_done: false, n_region_moves: 0 as u64, day_time: 0, day_fixed: false, n_time: 0,
        aud: false, aud_thread: false, aud_t0: 0, aud_owed: 0.0, aud_muted: false,
        eng: &eng, bnk: &bnk, snk: &snk, ma: &ma, wk: mc_audio.mca_walker_new(), ents: mc_entity.store_new(), reg: ver.registry_of(),
        cam3_mode: env_int("MCPLAY_CAM3P", 0), cam3: mc_camera3p.cam3p_new(),
        ents_on: env_flag("MCPLAY_ENTITIES", true), entl: mc_entity_draw.entlist_new(), pdraw: mc_player_draw.pd_new(), pdraw_on: env_flag("MCPLAY_PLAYER_MODEL", true), hand_on: env_flag("MCPLAY_HAND", true), ent_t: 0 as u64, ent_peak: 0, ent_vis_max: 0 as u32, ent_boxes: 0 as u64,
        ent_frames: 0 as u64, ent_moving: 0 as u64, ent_resets: 0 as u64,
        pend_place: false, pend_x: 0, pend_y: 0, pend_z: 0, pend_t: 0, n_snd: 0, sev: mc_snd_events.sev_new(), su: mc_snd_use.su_new(), n_snd_pkt: 0,
        probe: env_flag("MCPLAY_AUDIO_PROBE", false), probe_i: 0, probe_next: 0 as u64, amb: mc_audio.mca_ambient_new(4242 as i64), amb_x: (env_int("MCPLAY_AMBIENT_X", 1) as f64), amb_dark: env_flag("MCPLAY_AMBIENT_DARK", false), n_amb: 0 as u64,
        n_chunks: 0, n_unload: 0, n_biome_updates: 0, n_bchange: 0, n_mchange: 0, n_dig: 0, n_place: 0, n_ticks: 0, n_frames: 0, n_kick: 0, end_kind: END_QUIT, end_text: rt.buf_new(), fps: 0,
        chat: mc_chat.chat_new(), chat_net: mc_chat_net.chat_net_new(), chat_ui: mc_chat_ui.chatui_new(), tabl: mc_tablist.tab_new(), tab_log: env_flag("MCPLAY_TAB_LOG", false), health: mc_health.health_new(), hudp: mc_hud_play.hp_new(), wfc: mc_water_fog.wfc_new(), icons: mc_item_icon.icons_new(), iui: mc_inv_ui.iui_new(), idrag: mc_inv_drag.idrag_new(), cui: mc_cont_ui.cui_new(), cact: mc_cont_act.act_new(), trades: mc_trade.tr_new(), tui: mc_trade_ui.tui_new(), tact: mc_trade_act.ta_new(), cr: mc_creative.cr_new(), crui: mc_creative_ui.crui_new(), cr_sdrag: false, cr_logged: false, shot_req: false, shot_armed: false, shot_n: 0, kb: load_keybinds(), weather: mc_weather.weather_new(), precip: mc_precip.precip_new(), lightning: mc_lightning.lightning_new(), splash: mc_splash.splash_new(), snowfall: mc_snowfall.snowfall_new(), snow_log_s: 0 as u64, wsnd: mc_weather_snd.wsnd_new(9001 as i64), combat: mc_combat.combat_new(), cfx: mc_combat_fx.cfx_new(), tgt: mc_combat.Target { id: 0 - 1, dist: 0.0, hx: 0.0, hy: 0.0, hz: 0.0 }, tgt_hit: false, combat_log: env_flag("MCPLAY_COMBAT_LOG", false), hud_sig: 0, cbt_phase: 0, cbt_t: 0 as u64, chat_test_done: false, tab_test_done: false, inv: mc_inv.inv_new(), dg: mc_dig_sel.dig_for_protocol(proto), rcp: mc_craft_sel.recipes_for_protocol(proto), ct4_phase: 0, ct4_t: 0 as u64, ct4_src: 0 - 1, ct4_n0: 0 as u32, show_inv: false, cont_ui: false, ui_regrab: false, death_regrab: false, give_done: false, dig_total: 0,
        fx: mc_effect.fx_new(), fx_ticks: 0 - 1, fx_plain: 0 - 1, click_phase: 0, click_t: 0 as u64, click_src: 0 - 1, ct2_phase: 0, ct2_t: 0 as u64, ct2_a: 0 - 1, ct2_b: 0 - 1, ct2_d: 0 - 1, ct3_phase: 0, ct3_t: 0 as u64, ct3_tries: 0, tt_phase: 0, tt_t: 0 as u64, tt_tries: 0, tt_n0: 0 as u32, st_phase: 0, st_t: 0 as u64, st_seen: 0, st_x: 0, st_y: 0, st_z: 0, sneak_sent: false, sprint_sent: false, input_sent: 0 as u32, loaded_sent: false, n_loaded: 0 as u32, loaded_base: 0 as u64, loaded_since: 0 as u64, n_sneak: 0 as u32, ht_phase: 0, ht_t: 0 as u64, ht_a: 0 - 1, ht_b: 0 - 1, ht_n0: 0 as u32, ht_d: [0; 4], last_click_slot: 0 - 1, last_click_t: 0 as u64, last_quick_item: 0 - 1, last_quick_sig: 0,
    }
    if !c.g.ok {
        io.eprint_line("mcplay: this version has no block registry")
        return 5
    }
    if use_res { gfx_packs_load(&c.g, proto) }
    mc_chat_assets.chatassets_load(proto)
    mc_biome_fog.bfog_load(&c.reg)
    if c.models_on {
        c.ms = mc_model_mesh.ms_new(&c.reg, &c.g.res.stack, &c.g.res.ex)
        mc_model_mesh.ms_load_biomes(&c.ms)
        mc_model_mesh.ms_set_blend(&c.ms, env_int("MCPLAY_BIOME_BLEND", 2)) // vanilla biomeBlendRadius (default 2 = 5x5), 0..4
        mc_model_mesh.ms_set_atlas(&c.ms, &c.g.res.atlas)
        mc_model_mesh.ms_set_water_tint(&c.ms, env_int("MCPLAY_WATER_TINT", 1) != 0)
        mc_render_world.wr_set_models(&c.g.wr, (&c.ms) as u64)
        say(f"mcplay: models on (pack blockstates + models, stream={c.stream_on}, lod={c.lod})\n")
    }
    if c.light {
        mc_chunk.scratch_set_keep_light(&c.sc, true)
        light_setup(&c)
    }
    c.itb = pick_tables(&c.g.tb, &c.reg)
    mc_shapes.shapes_fill(&c.reg, c.itb.solid, c.itb.n) // slabs / stairs / carpets / snow: partial shapes (step-up)
    mc_shapes.move_fill(&c.reg, c.pl.mv, 65536) // soul sand / honey / cobweb / berry bush: slowdown kinds (mc_input)
    if env_flag("MCPLAY_AUDIO", true) { c.aud = audio_start(&c) }
    if c.aud { mc_snd_use.su_prewarm(c.ma) }
    c.pl.creative = c.creative
    c.pl.autojump = env_flag("MCPLAY_AUTOJUMP", false)
    c.bg = rt.heap_alloc((w0 as usize) * (h0 as usize) * 4)
    if env_flag("MCPLAY_TRANS", true) {
        // translucent pass (water, glass, ice): second mesh per section, drawn back to front with blending (mc_mesh.F_TRANS);
        // both back ends (CPU mc_raster PASS_TRANS and GL) so the two pictures agree
        mc_render_world.wr_set_translucent(&c.g.wr, true, mc_texture.T_WATER, mc_texture.T_ICE, mc_texture.T_GLASS)
    }
    mc_camera.camera_set_lens(&c.cam, 70.0, 0.05, (wire_view(&c) as f64 + 2.0) * 16.0 * 1.5)
    if mc_pause.pause_wanted() && mc_pause.pause_init_from_cfg() { apply_opts(&c, true) }
    if mc_pause.pause_wanted() { (*mc_pause.pause_opts()).view_actual = view_req }
    c.sky.approx = !env_flag("MCPLAY_SKY_EXACT", false) // approximate glow + gradient (<= 1 level, ~2.5x faster at sunset)
    mc_sky.sky_set_time(&c.sky, c.ticks_day as i64, 0)
    mc_render_world.wr_set_flags(&c.g.wr, mc_mesh.F_GREEDY | mc_opts.opts_look_flags(mc_pause.pause_opts()))
    mc_codec.wire_timeout(&c.cl.w, 100) // login phase: slow (cold) servers answer after 0.5 s and more; 2 ms x 200 waits was too short for 1.21.11 / 26.1
    if !mc_client.client_handshake(&c.cl, host, port as u16, 2) {
        io.eprint_line("mcplay: could not send the handshake")
        return 4
    }
    var lr: i32 = 0
    if rt.buf_len(&(*ln).tok) > 0 {
        // online login with the launcher's account (session file: mc_token + uuid)
        var sess_cl: mc_auth.SessionClient = mc_auth.session_new()
        var acct: mc_client.OnlineAccount = mc_client.account_new("", &sess_cl)
        if !mc_auth.uuid_from_text(rt.buf_ptr(&(*ln).uuid), rt.buf_len(&(*ln).uuid), (&acct.uuid[0]) as u64) {
            io.eprint_line("mcplay: session file has no valid uuid")
            return 5
        }
        if !mc_auth.session_init(&sess_cl) {
            io.eprint_line("mcplay: cannot initialise the session client (TLS)")
            return 5
        }
        mc_auth.session_set_system_trust(&sess_cl, true)
        var s_base: rt.Buf = rt.buf_new()
        if env.get_into("MC_SESSION_BASE", &s_base) && rt.buf_len(&s_base) > 0 {
            mc_auth.session_set_base(&sess_cl, str { p: rt.buf_data(&s_base), n: s_base.len })
        }
        acct.token = str { p: rt.buf_data(&(*ln).tok), n: (*ln).tok.len }
        lr = mc_client.client_login_online(&c.cl, name, &acct, LOGIN_WAITS)
        mc_auth.session_free(&sess_cl)
        rt.buf_free(&s_base)
    } else {
        lr = mc_client.client_login_offline(&c.cl, name, LOGIN_WAITS)
    }
    if lr != 0 {
        say(f"mcplay: login failed ({lr}) net_err={net.conn_error(&c.cl.w.conn)}\n")
        var why: rt.Buf = rt.buf_new()
        login_fail_text(&c, lr, &why)
        session_abort(&c)
        let frc: i32 = launch_error(ln, 5, rt.buf_str(&why))
        rt.buf_free(&why)
        return frc
    }
    mc_codec.wire_timeout(&c.cl.w, 2) // the frame loop must not block on the socket
    if rt.buf_len(&(*ln).uuid) > 0 && env_flag("MCPLAY_SKIN", true) {
        var raw_uuid: [u8; 16] = [0; 16]
        if mc_auth.uuid_from_text(rt.buf_ptr(&(*ln).uuid), rt.buf_len(&(*ln).uuid), (&raw_uuid[0]) as u64) {
            var hex: rt.Buf = rt.buf_new()
            mc_auth.uuid_to_text((&raw_uuid[0]) as u64, false, &hex)
            var own_skin: mc_pskin.Skin = mc_pskin.skin_new()
            if mc_skin_fetch.skin_fetch(rt.buf_str(&hex), &own_skin) {
                mc_player_draw.pd_set_self_skin(&c.pdraw, &own_skin)
                say(f"mcplay: own skin loaded\n")
            } else {
                say(f"mcplay: own skin download failed, default skin\n")
            }
            mc_pskin.skin_free(&own_skin)
            rt.buf_free(&hex)
        }
    }
    // r277: SO_RCVTIMEO(2 ms) is rounded up to the 15.6 ms Windows timer tick -> every idle frame waited a whole tick (all
    // mcplay frames sat at 15.6 ms with world_draw 1.4 ms). poll(0) before each read never waits; MCPLAY_NETPOLL=0 = old behaviour.
    if env_flag("MCPLAY_NETPOLL", true) { mc_codec.wire_poll_gate(&c.cl.w, true) }
    // MCPLAY_TIMERRES=1: timeBeginPeriod(1) (winmm via dynlib; no-op where the DLL does not exist) -- sleeps / waits at 1 ms
    if env_flag("MCPLAY_TIMERRES", false) {
        let hw: u64 = dynlib.open("winmm.dll")
        if hw != 0 as u64 {
            let fp: u64 = dynlib.sym(hw, "timeBeginPeriod")
            if fp != 0 as u64 { dynlib.ci1(fp, 1 as u64) }
        }
    }
    mc_inv.inv_use_registry(&c.inv, &c.reg) // stack limits + armour slots for the click prediction
    mc_inv.inv_use_recipes(&c.inv, &c.rcp) // craft result slot of the 2x2 / 3x3 grid
    // window: full_input BEFORE make so that button releases, motion and raw keys arrive
    var gl_ready: bool = false
    if want_gl {
        gl_ready = gl_open_all(&c, w0, h0)
        if !gl_ready && !gl_auto {
            io.eprint_line("mcplay: run without MCPLAY_GL")
            return 6
        }
    }
    if !gl_ready {
        c.wp = &c.win
        if !window.open_window(c.wp, 0) {
            io.eprint_line("mcplay: cannot open the display")
            return 6
        }
        window.full_input(c.wp, true)
        if !window.make(c.wp, w0 as usize, h0 as usize) {
            io.eprint_line("mcplay: cannot create the window")
            return 6
        }
        window.raw_input(c.wp, true)
        let ttl: str = "mcplay"
        window.title(c.wp, ttl.p as u64, ttl.n)
        window.show_window(c.wp)
        if want_vk_gfx() || gl_auto {
            if vk_open_be(&c, w0, h0) {
                c.vk = true
                io.print("mcplay: gfx=vk device=")
                io.print_c(vk_mc.vkbe_device_name(&c.vbk))
                say(f" cpu_device={vk_mc.vkbe_is_cpu(&c.vbk)}\n")
            } else {
                io.eprint_line("mcplay: gfx=cpu (vk requested but not available)")
            }
        }
    }
    if env_flag("MCPLAY_FULLSCREEN", false) {
        c.fullscreen = true
        window.fullscreen(c.wp, true)
    }
    // mesher threads AFTER every dlopen (libEGL / libGL / audio): a dlopen of a TLS library once Firn threads exist crashes in glibc _dl_update_slotinfo
    if c.stream_on && n_workers > 0 {
        // lock-free ring pool (r192): no lock + heap_alloc per job on the render thread; MCPLAY_JOBS_LOCKED=1 = old locked queue
        if env_flag("MCPLAY_JOBS_LOCKED", false) { c.pool = jobs.create(n_workers as u64) } else { c.pool = jobs.create_lf(n_workers as u64) }
        if c.pool.blk == 0 { io.eprint_line("mcplay: mesher threads did not start -- meshing inline") }
        if c.pool.blk != 0 { mc_audio.mca_set_lazy_pool(c.ma, pool_addr(&c), env_int("MCPLAY_LAZY_SYNC_BYTES", 0) as usize) }
    }
    grab_mouse(&c, true)
    c.sent_slot = 0
    // r197: answer a server teleport with the Teleport Confirm only, the position follows with the next game tick (see do_tick / TP_QUIET_MS)
    if !env_flag("MCPLAY_POS_REPLY", false) { mc_client.client_set_pos_reply(&c.cl, false) }
    let t_start: u64 = now_ms()
    var t_tick: u64 = t_start
    var t_fps: u64 = t_start
    var f_fps: i32 = 0
    var frame_ns: u64 = frame_limit_ns(&c)
    var alive: bool = true
    var tick_dropped: u64 = 0 as u64
    let prog_on: bool = env_flag("MCPLAY_PROGRESS", false)
    var quit_file: str = ""
    if env.has("MCPLAY_QUIT_FILE") { quit_file = env.get("MCPLAY_QUIT_FILE") }
    var last_prog: u64 = 0 as u64
    // r254: MCPLAY_FRAME_STATS=1 records the work time of every frame (ns, without the cap wait) after a 5 s warm-up; p50 / p95 are printed at the end
    let fstats_on: bool = env_flag("MCPLAY_FRAME_STATS", false)
    let fstats_cap: usize = 16384
    var fstats_buf: u64 = 0 as u64
    var fstats_n: usize = 0
    if fstats_on { fstats_buf = rt.heap_alloc(fstats_cap * 8) }
    var prof: mc_prof.Prof = mc_prof.prof_new(env_flag("MCPLAY_PROFILE", false))
    mc_prof.prof_attach(&prof)
    let prof_from_ms: u64 = (env_int("MCPLAY_PROFILE_FROM", 5) as u64) * 1000 as u64
    let spin_step: f64 = (env_int("MCPLAY_SPIN", 0) as f64) * 0.1
    var prof_d0: u64 = 0 as u64
    var prof_t0: u64 = 0 as u64
    var prof_c0: u64 = 0 as u64
    let nb_env_set: bool = env.has("MCPLAY_NET_BUDGET_US")
    let nb_env_us: i32 = env_int("MCPLAY_NET_BUDGET_US", 0)
    mc_frame_split.fs_init()
    var fs_kind: u64 = mc_frame_split.BK_CPU
    if c.gl { fs_kind = mc_frame_split.BK_GL }
    if c.vk { fs_kind = mc_frame_split.BK_VK }
    mc_frame_split.fs_backend(fs_kind, n_workers, view_req)
    while !c.closed && alive {
        let f0: u64 = now_ns()
        var pl: u64 = f0
        pump(&c)
        handle_window(&c)
        view_poll(&c, raw.mouse_down(&c.rw, raw.MB_LEFT))
        pl = mc_prof.prof_lap(mc_prof.PH_PUMP, pl)
        alive = net_drain(&c, 400, mc_net_budget.nb_limit_ns(now_ms(), c.have_pos, nb_env_set, nb_env_us))
        pl = mc_prof.prof_lap(mc_prof.PH_DRAIN, pl)
        sync_position(&c)
        pl = mc_prof.prof_lap(mc_prof.PH_SYNC, pl)
        light_region_tick(&c)
        pl = mc_prof.prof_lap(mc_prof.PH_LREG, pl)
        stream_window_tick(&c)
        pl = mc_prof.prof_lap(mc_prof.PH_WTICK, pl)
        handle_hotbar(&c)
        pl = mc_prof.prof_lap(mc_prof.PH_HOTBAR, pl)
        if c.have_pos && (c.acc_dx != 0.0 || c.acc_dy != 0.0) {
            mc_input.player_look(&c.pl, c.acc_dx, c.acc_dy)
            c.acc_dx = 0.0
            c.acc_dy = 0.0
        }
        let nowm: u64 = now_ms()
        var nt: i32 = 0
        while nowm >= t_tick + TICK_MS && nt < 5 {
            t_tick = t_tick + TICK_MS
            if c.have_pos { do_tick(&c) }
            nt = nt + 1
        }
        if nowm > t_tick + 250 as u64 {
            tick_dropped = tick_dropped + (nowm - t_tick) / TICK_MS
            t_tick = nowm
        }
        pl = mc_prof.prof_lap(mc_prof.PH_TICKS, pl)
        let fs_t1: u64 = now_ns()
        if prog_on && c.n_ticks >= last_prog + 10 as u64 {
            last_prog = c.n_ticks
            say(f"mcplay: progress ticks={c.n_ticks} pos={c.have_pos} chunks={c.n_chunks} fsview={mc_frame_split.fs_get(mc_frame_split.FS_VIEW)} cols={mc_world.world_count(&c.world)} ssec={mc_stream.stream_sections(&c.stm)} view={c.view} lod={c.lod} ground={c.pl.on_ground} y_mm={(c.pl.y * 1000.0) as i64} walked_mm={(c.wk.walked * 1000.0) as i64} steps={c.wk.steps}\n")
        }
        if quit_file.length() > 0 && c.n_frames % 5 as u64 == 0 as u64 && fs.exists(quit_file) { c.closed = true }
        dig_bot_tick(&c)
        if spin_step != 0.0 { c.pl.yaw = c.pl.yaw + spin_step }
        if c.have_pos {
            let pt: f64 = (now_ms() - t_tick) as f64 / (TICK_MS as f64)
            mc_input.player_set_camera_lerp(&c.pl, &c.cam, pt)
            if c.models_on {
                c.hit = mc_model_pick.mp_pick_camera(&c.world, c.dim.min_y, &c.itb, &c.ms, &c.cam, mc_input.player_reach(&c.pl), &c.pk)
            } else {
                c.hit = mc_input.input_pick_camera(&c.world, c.dim.min_y, &c.itb, &c.cam, mc_input.player_reach(&c.pl), &c.pk)
            }
        }
        pl = mc_prof.prof_lap(mc_prof.PH_PICK, pl)
        pick_entity(&c)
        if c.have_pos && mc_camera3p.mode_is_third(c.cam3_mode) {
            var lx: f64 = 0.0
            var ly: f64 = 0.0
            var lz: f64 = 0.0
            let lpt: f64 = (now_ms() - t_tick) as f64 / (TICK_MS as f64)
            mc_input.player_lerp_pos(&c.pl, lpt, &lx, &ly, &lz)
            mc_camera3p.cam3p_apply(&c.cam, &c.world, c.dim.min_y, &c.itb, lx, ly + mc_input.player_lerp_eye(&c.pl, lpt), lz,
                c.pl.yaw, c.pl.pitch, c.cam3_mode, mc_camera3p.CAM_DISTANCE, &c.cam3)
        }
        pl = mc_prof.prof_lap(mc_prof.PH_PICKENT, pl)
        handle_mouse(&c)
        pl = mc_prof.prof_lap(mc_prof.PH_MOUSE, pl)
        let fs_tin: u64 = now_ns()
        audio_frame(&c)
        pl = mc_prof.prof_lap(mc_prof.PH_AUDIO, pl)
        let fs_t2: u64 = now_ns()
        ents_step(&c)
        pl = mc_prof.prof_lap(mc_prof.PH_ENTS, pl)
        let pf1: u64 = now_ns()
        if c.gl {
            prof_d0 = gl_mc.glbe_draws(&c.gb)
            prof_t0 = gl_mc.glbe_tris_submitted(&c.gb)
            prof_c0 = gl_mc.glbe_calls(&c.gb)
        }
        let st0: u64 = c.t_stream
        draw_frame(&c)
        let pf2: u64 = now_ns()
        present(&c)
        let pf3: u64 = now_ns()
        mc_frame_split.fs_frame(fs_t1 - f0, fs_tin - fs_t1, fs_t2 - fs_tin, pf1 - fs_t2, pf2 - pf1, c.t_stream - st0, pf3 - pf2, pf3 - f0)
        mc_frame_split.fs_stream(c.stm.st.cull_us, c.stm.st.submit_us, c.stm.st.upload_us, c.stm.st.draw_us, c.stm.st.visible as u64, c.stm.st.drawn as u64, c.stm.st.pending as u64, c.stm.st.inflight as u64, c.stm.st.drawn_trans as u64)
        if c.gl { mc_frame_split.fs_gl(gl_mc.glbe_draws(&c.gb) - prof_d0, gl_mc.glbe_tris_submitted(&c.gb) - prof_t0, gl_mc.glbe_calls(&c.gb) - prof_c0) }
        if prof.on && nowm - t_start >= prof_from_ms {
            mc_prof.prof_rec(&prof, mc_prof.PH_NET, pf1 - f0)
            mc_prof.prof_rec(&prof, mc_prof.PH_DRAW, pf2 - pf1)
            mc_prof.prof_rec(&prof, mc_prof.PH_WORLD, c.t_stream - st0)
            mc_prof.prof_rec(&prof, mc_prof.PH_PRESENT, pf3 - pf2)
            mc_prof.prof_rec(&prof, mc_prof.PH_FRAME, pf3 - f0)
            mc_prof.prof_rec(&prof, mc_prof.PH_CULL, c.stm.st.cull_us * 1000 as u64)
            mc_prof.prof_rec(&prof, mc_prof.PH_SUBMIT, c.stm.st.submit_us * 1000 as u64)
            mc_prof.prof_rec(&prof, mc_prof.PH_UPLOAD, c.stm.st.upload_us * 1000 as u64)
            mc_prof.prof_rec(&prof, mc_prof.PH_SDRAW, c.stm.st.draw_us * 1000 as u64)
            mc_prof.prof_rec(&prof, mc_prof.PH_VISIBLE, c.stm.st.visible as u64)
            if c.gl {
                mc_prof.prof_rec(&prof, mc_prof.PH_DRAWS, gl_mc.glbe_draws(&c.gb) - prof_d0)
                mc_prof.prof_rec(&prof, mc_prof.PH_TRIS, gl_mc.glbe_tris_submitted(&c.gb) - prof_t0)
                mc_prof.prof_rec(&prof, mc_prof.PH_CALLS, gl_mc.glbe_calls(&c.gb) - prof_c0)
            }
            mc_prof.prof_next(&prof)
        }
        c.n_frames = c.n_frames + 1 as u64
        f_fps = f_fps + 1
        if nowm - t_fps >= 500 as u64 {
            c.fps = (f_fps as u64 * 1000 as u64 / (nowm - t_fps)) as i32
            f_fps = 0
            t_fps = nowm
        }
        if run_s > 0 && nowm - t_start >= (run_s as u64) * 1000 as u64 { c.closed = true }
        let spent: u64 = now_ns() - f0
        if fstats_on && fstats_n < fstats_cap && nowm - t_start >= 5000 as u64 {
            rt.st64(fstats_buf, fstats_n, spent)
            fstats_n = fstats_n + 1
        }
        frame_ns = frame_limit_ns(&c)
        var left_ns: u64 = 0 as u64
        if frame_ns > spent { left_ns = frame_ns - spent }
        while left_ns > 0 as u64 && !c.closed {
            if left_ns >= 1000000 as u64 { window.wait_event(c.wp, (left_ns / 1000000 as u64) as i64) }
            let used_ns: u64 = now_ns() - f0
            if used_ns >= frame_ns { break }
            left_ns = frame_ns - used_ns
        }
    }
    (*ln).end_kind = c.end_kind
    rt.buf_push_bytes(&(*ln).end_text, rt.buf_ptr(&c.end_text), rt.buf_len(&c.end_text))
    if c.stream_on && (c.lod == 0 || env.has("MCPLAY_SHOT_SETTLE")) && c.stm_live && c.have_pos && env.has("MCPLAY_SHOT") {
        // the shot shows the converged picture: let the mesher threads finish, then draw once more
        // r173: the flush frames must NOT draw (no begin/end around them: on the GL path every repeated section submitted a real
        // glMultiDrawElements outside a frame and the shot redraw hung for minutes); only the final draw_frame draws
        var sbe: mc_backend.Backend = cur_be(&c)
        sbe.draw = flush_nop_draw
        let nfl: usize = mc_stream.stream_flush(&c.stm, &c.world, &sbe, &c.cam, 200)
        draw_frame(&c)
        present(&c)
    }
    if fstats_on && fstats_n > 0 {
        mc_perf.perf_sort(fstats_buf, fstats_n)
        say(f"mcplay: frame_stats n={fstats_n} p50_us={mc_perf.perf_percentile(fstats_buf, fstats_n, 5000 as u64) / 1000 as u64} p95_us={mc_perf.perf_percentile(fstats_buf, fstats_n, 9500 as u64) / 1000 as u64} max_us={mc_perf.perf_percentile(fstats_buf, fstats_n, 10000 as u64) / 1000 as u64}\n")
    }
    mc_frame_split.fs_report()
    mc_prof.prof_report(&prof)
    if prof.on && c.gl { gl_scene.scene_print_timers(&c.gsc) }
    audio_stop(&c)
    say(f"mcplay: end frames={c.n_frames} ticks={c.n_ticks} chunks={c.n_chunks} unloads={c.n_unload} biome_updates={c.n_biome_updates} block_updates={c.n_bchange} multi_updates={c.n_mchange} dig={c.n_dig} place={c.n_place} kicked={c.n_kick} alive={alive} loaded={c.n_loaded}\n")
    say(f"mcplay: walk walked_mm={(c.wk.walked * 1000.0) as i64} steps={c.wk.steps} ticks_dropped={tick_dropped}\n")
    say(f"mcplay: gamemode mode={c.health.mode} creative={c.creative} fixed={c.creative_fixed}\n")
    say(f"mcplay: input grab={c.grab} fullscreen={window.is_fullscreen(c.wp)} f11={c.n_f11} raw_dx={c.tot_dx} raw_dy={c.tot_dy} yaw={c.pl.yaw} pitch={c.pl.pitch} win={window.width(c.wp)}x{window.height(c.wp)} dpi={window.dpi(c.wp)}\n")
    say(f"mcplay: inv updates={c.inv.n_updates} bad={c.inv.bad} hotbar={mc_inv.inv_hotbar_item(&c.inv, 0)}x{mc_inv.inv_hotbar_count(&c.inv, 0)},{mc_inv.inv_hotbar_item(&c.inv, 1)}x{mc_inv.inv_hotbar_count(&c.inv, 1)},{mc_inv.inv_hotbar_item(&c.inv, 2)}x{mc_inv.inv_hotbar_count(&c.inv, 2)} dig_ms={c.dig_ms} crack_own={c.crk_own} crack_other={c.crk_other} crack_updates={c.cra.updates} dig_total={c.dig_total} dig_table={c.dg.nblocks}\n")
    say(f"mcplay: fx haste={mc_effect.fx_haste(&c.fx)} fatigue={mc_effect.fx_fatigue(&c.fx)} eff={mc_inv.inv_held_eff(&c.inv, c.pl.slot)} eff0={mc_inv.inv_held_eff(&c.inv, 0)} fx_ticks={c.fx_ticks} plain_ticks={c.fx_plain} clicks={c.inv.n_clicks} cursor={mc_inv.inv_cursor_item(&c.inv)}x{mc_inv.inv_cursor_count(&c.inv)} slot10={mc_inv.inv_count(&c.inv, 10)} slot11={mc_inv.inv_count(&c.inv, 11)}\n")
    if env_int("MCPLAY_CONT_UI", 0) > 0 {
        say(f"mcplay: contui end show_inv={c.show_inv} cont_ui={c.cont_ui} win={mc_inv.inv_window(&c.inv)} grab={c.grab} bad={c.inv.bad}\n")
    }
    if env_flag("MCPLAY_CHEST_UI", false) {
        say(f"mcplay: chestui end show_inv={c.show_inv} cont_ui={c.cont_ui} win={mc_inv.inv_window(&c.inv)} grab={c.grab} bad={c.inv.bad}\n")
    }
    say(f"mcplay: light={c.light} region={c.region_done} region_moves={c.n_region_moves} time_packets={c.n_time} day_time={c.day_time} daylight={c.sky.daylight} weather_events={c.weather.n_events} rain={c.weather.rain} thunder={c.weather.thunder} precip_kind={c.precip.kind} exposure={c.precip.exposure} bolts={c.lightning.n_bolts} rain_snd={c.wsnd.n_rain} bolt_snd={c.wsnd.n_bolts}\n")
    say(f"mcplay: entities count={mc_entity.store_count(&c.ents)} peak={c.ent_peak} players={mc_entity.store_player_count(&c.ents)} spawns={c.ents.spawns} moves={c.ents.moves} teleports={c.ents.teleports} looks={c.ents.looks} destroys={c.ents.destroys} velocities={c.ents.velocities} bad={c.ents.bad} misses={c.ents.misses} dropped={c.ents.dropped} resets={c.ent_resets} on={c.ents_on}\n")
    say(f"mcplay: entities_draw boxes={c.ent_boxes} frames={c.ent_frames} vis_max={c.ent_vis_max} in={c.entl.n_in} culled={c.entl.n_culled} lod={c.entl.n_lod} interp_moving={c.ent_moving}\n")
    if env_flag("MCPLAY_ENT_LIST", false) {
        // up to 16 entities with network and render position (debug / tests)
        var ei: usize = 0
        var shown: i32 = 0
        let ecap: usize = mc_entity.store_slot_cap(&c.ents)
        while ei < ecap && shown < 16 {
            let ee: *mut mc_entity.Entity = mc_entity.store_at(&c.ents, ei)
            ei = ei + 1
            if (ee as u64) == 0 as u64 { continue }
            shown = shown + 1
            say(f"mcplay: ent id={(*ee).id} kind={(*ee).kind} type={(*ee).type_id} x={(*ee).x} y={(*ee).y} z={(*ee).z} rx={(*ee).rx} ry={(*ee).ry} rz={(*ee).rz} yaw={(*ee).yaw}\n")
        }
        say(f"mcplay: cam x={c.cam.x} y={c.cam.y} z={c.cam.z} yaw={c.cam.yaw} pitch={c.cam.pitch} far={c.cam.far} fov={c.cam.fov}\n")
    }
    say(f"mcplay: pos x={c.pl.x as i64} y={c.pl.y as i64} z={c.pl.z as i64} fps={c.fps}\n")
    var rc: i32 = 0
    if c.gl || c.vk {
        let px: u64 = c.be.present(c.be.obj)
        if px != 0 as u64 { rt.mem_copy(c.g.r.color, px, (c.w as usize) * (c.h as usize) * 4) }
    }
    if c.vk && vk_mc.vkbe_sc_on(&c.vbk) {
        // proof of the swapchain path: what the X server shows in the window == the read back colour image of the last frame
        var wdiff: i64 = 0 - 1
        let npx: usize = (c.w as usize) * (c.h as usize)
        let wpx: u64 = rt.heap_alloc(npx * 4)
        let rpx: u64 = c.be.present(c.be.obj)
        if rpx != 0 as u64 && vk_mc.vkbe_window_pixels(&c.vbk, wpx) {
            wdiff = 0
            var wi: usize = 0
            while wi < npx {
                var wk: usize = 0
                while wk < 3 {
                    if rt.ld8(rpx, wi * 4 + wk) != rt.ld8(wpx, wi * 4 + wk) { wdiff = wdiff + 1 }
                    wk = wk + 1
                }
                wi = wi + 1
            }
        }
        rt.heap_free(wpx, npx * 4)
        say(f"mcplay: vk present=swapchain presents={vk_mc.vkbe_sc_stat(&c.vbk, vk_mc.SC_PRESENTS)} skips={vk_mc.vkbe_sc_stat(&c.vbk, vk_mc.SC_SKIPS)} rebuilds={vk_mc.vkbe_sc_stat(&c.vbk, vk_mc.SC_REBUILDS)} out_of_date={vk_mc.vkbe_sc_stat(&c.vbk, vk_mc.SC_OUT_OF_DATE)} suboptimal={vk_mc.vkbe_sc_stat(&c.vbk, vk_mc.SC_SUBOPTIMAL)} format={vk_mc.vkbe_sc_stat(&c.vbk, vk_mc.SC_FORMAT)} window_diff={wdiff} px={npx}\n")
    } else if c.vk {
        io.print("mcplay: vk present=readback\n")
    }
    if c.vk {
        say(f"mcplay: vk frames={vk_mc.vkbe_frames(&c.vbk)} draws={vk_mc.vkbe_draws(&c.vbk)} tris={vk_mc.vkbe_tris(&c.vbk)} lost={c.vk_losses} recovered={c.vk_recoveries} ubo_over={c.vbk.ubo_over} dyn_over={c.vbk.dyn_over}\n")
    }
    if env.has("MCPLAY_SHOT") {
        let sp: str = env.get("MCPLAY_SHOT")
        var pb: rt.Buf = rt.buf_new()
        path_buf(&pb, sp)
        if !mc_raster.raster_write_png(&c.g.r, rt.buf_ptr(&pb)) {
            io.eprint_line("mcplay: cannot write the screenshot")
            rc = 7
        }
        let hb: u64 = rt.heap_alloc(64)
        mc_raster.raster_hash_hex(&c.g.r, hb)
        io.print("mcplay: hash=")
        io.print_bytes(hb, 64)
        io.print("\n")
        rt.heap_free(hb, 64)
        rt.buf_free(&pb)
    }
    say(f"mcplay: world_draw mode={c.stream_on} avg_us={c.t_stream / (c.n_frames + 1 as u64) / 1000 as u64} max_us={c.max_stream / 1000 as u64}\n")
    if c.stream_on {
        let pool_up: bool = c.pool.blk != 0
        say(f"mcplay: stream workers={n_workers} pool={pool_up} avg_us={c.t_stream / (c.n_frames + 1 as u64) / 1000 as u64} max_us={c.max_stream / 1000 as u64} window_ops={c.n_win} cols={c.stm.clive}\n")
        say(f"mcplay: stream sections={mc_stream.stream_sections(&c.stm)} lod_cols={c.stm.st.lod_cols} lod_tris={c.stm.st.lod_tris} lod_todo={c.stm.st.lod_todo} lod_fading={c.stm.st.lod_fading} lod_us={c.stm.st.lod_us}\n")
        stream_release(&c)
    }
    if c.models_on {
        say(f"mcplay: models states={c.ms.nmodel} unmapped={c.ms.unmapped}\n")
    }
    pick_probe(&c)
    session_free(&c)
    return rc
}

#[allow_escape]
fn main(start: u64) -> i32 {
    log_redirect()
    // FleiLauncher hand-off (GDD 5a.2, lib/mc/mc_session.fi): MCPLAY_SESSION_FILE=<file>|- carries host, port, name (+ uuid, mc_token for an
    // online login, protocol, view); command line arguments override it. The file is deleted after reading (MCPLAY_SESSION_KEEP=1 keeps it).
    var sess: rt.Buf = rt.buf_new()
    var s_host: rt.Buf = rt.buf_new()
    var s_name: rt.Buf = rt.buf_new()
    var s_tok: rt.Buf = rt.buf_new()
    var s_uuid: rt.Buf = rt.buf_new()
    var have_sess: bool = false
    var s_port: i32 = 0 - 1
    var s_proto: i32 = 0 - 1
    var s_view: i32 = 0 - 1
    var s_form: i32 = 0
    var s_path: rt.Buf = rt.buf_new()
    if env.get_into("MCPLAY_SESSION_FILE", &s_path) && rt.buf_len(&s_path) > 0 {
        rt.buf_push(&s_path, 0 as u8)
        if !mc_session.session_load(rt.buf_ptr(&s_path), &sess) {
            io.eprint_line("mcplay: cannot read MCPLAY_SESSION_FILE")
            return 2
        }
        have_sess = true
        if !(rt.c_length(rt.buf_ptr(&s_path)) == 1 && rt.ld8(rt.buf_ptr(&s_path), 0) == 45 as u8) && !env_flag("MCPLAY_SESSION_KEEP", false) {
            fs.remove(str { p: rt.buf_data(&s_path), n: rt.buf_len(&s_path) - 1 }) catch false
        }
        let sp: u64 = rt.buf_ptr(&sess)
        let sn: usize = rt.buf_len(&sess)
        if mc_session.session_value(sp, sn, "host", &s_host) { rt.buf_push(&s_host, 0 as u8) }
        if mc_session.session_value(sp, sn, "name", &s_name) { rt.buf_push(&s_name, 0 as u8) }
        mc_session.session_value(sp, sn, "mc_token", &s_tok)
        mc_session.session_value(sp, sn, "uuid", &s_uuid)
        s_port = mc_session.session_int(sp, sn, "port", 0 - 1)
        s_proto = mc_session.session_int(sp, sn, "protocol", 0 - 1)
        s_view = mc_session.session_int(sp, sn, "view", 0 - 1)
        s_form = mc_session.session_int(sp, sn, "form", 0)
        mc_session.session_wipe(&sess)
        rt.buf_free(&sess)
    }
    rt.buf_free(&s_path)
    let argc: usize = rt.arg_count(start)
    if argc == 1 && !have_sess && mc_single.single_wanted() && !mc_single.single_acquire() {
        io.eprint_line("mcplay: already running")
        return 0
    }
    let menu_loop: bool = argc == 1 && (!have_sess || s_form > 0)
    var ln: Launch = Launch { host: 0 as u64, name: 0 as u64, port: 0, proto: 0 - 1, view: 0 - 1, tok: s_tok, uuid: s_uuid, end_kind: END_QUIT, end_text: rt.buf_new() }
    var notice: mc_menu_disc.Notice = mc_menu_disc.notice_new()
    let keep_proto: i32 = s_proto
    let keep_view: i32 = s_view
    var round: i32 = 0
    var rc: i32 = 0
    var again: bool = true
    while again {
        again = false
        ln.end_kind = END_QUIT
        rt.buf_clear(&ln.end_text)
        var ready: bool = true
        if menu_loop {
            let pick: i32 = mc_startscreen_run.startscreen_pick(&s_host, &s_name, &s_port, &s_proto, &s_view, &notice, round == 0)
            if pick == mc_startscreen_run.PICK_CANCELLED {
                rc = 0
                ready = false
            } else if pick != mc_startscreen_run.PICK_OK {
                io.eprint_line("mcplay: cannot open the display")
                rc = 6
                ready = false
            } else {
                if keep_proto > 0 { s_proto = keep_proto }
                if round == 0 && keep_view > 0 { s_view = keep_view }
                have_sess = true
            }
        }
        if ready && !have_sess && argc < 4 {
            io.eprint_line("usage: mcplay <host> <port> <name>   (or MCPLAY_SESSION_FILE=<file>|-; options: environment, see the header of demos/mcplay/main.fi)")
            rc = 2
            ready = false
        }
        if ready {
            rc = launch_fill(&ln, start, argc, &s_host, &s_name, s_port, s_proto, s_view)
            if rc == 0 { rc = run_session(start, &ln) }
            round = round + 1
            if menu_loop && ln.end_kind != END_QUIT {
                mc_menu_disc.notice_clear(&notice)
                if ln.end_kind != END_DISCONNECT {
                    var kind: i32 = mc_menu_disc.NOTICE_LOST
                    if ln.end_kind == END_FAIL { kind = mc_menu_disc.NOTICE_FAILED }
                    if rt.buf_len(&ln.end_text) == 0 {
                        let dd: str = "Disconnected"
                        rt.buf_push_bytes(&ln.end_text, dd.p as u64, dd.n)
                    }
                    mc_menu_disc.notice_set(&notice, kind, rt.buf_ptr(&ln.end_text), rt.buf_len(&ln.end_text))
                    let shown: str = rt.buf_str(&ln.end_text)
                    say(f"mcplay: returning to the title screen: {shown}\n")
                }
                rc = 0
                again = true
            }
        }
    }
    mc_session.session_wipe(&ln.tok)
    rt.buf_free(&ln.tok)
    rt.buf_free(&ln.uuid)
    rt.buf_free(&ln.end_text)
    rt.buf_free(&s_host)
    rt.buf_free(&s_name)
    mc_menu_disc.notice_free(&notice)
    return rc
}
