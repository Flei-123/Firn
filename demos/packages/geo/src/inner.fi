// geo.inner -- PRIVATE. It is not in the 'public' list of
// demos/packages/geo/firn.package and can therefore only be imported INSIDE
// the package 'geo'. Anyone trying from outside gets a message that points
// out where it would have to be released.
export { double }

fn double(a: i32) -> i32 {
    return a + a
}
