// geo — das Hauptmodul des Pakets. Bindet ein oeffentliches ('punkt') und
// ein privates ('innen') Modul desselben Pakets ein; INNERHALB eines Pakets
// gibt es keine Schranke.
import dot
import inner

export { Rect, rect_new, area, extent, corner_sum }

struct Rect { corner: dot.Dot, width: i32, height: i32 }

fn rect_new(x: i32, y: i32, b: i32, h: i32) -> Rect {
    return Rect{ corner: dot.dot_new(x, y), width: b, height: h }
}

fn area(r: Rect) -> i32 {
    return r.width * r.height
}

fn extent(r: Rect) -> i32 {
    // ueber das private Modul: 2*(b+h)
    return inner.double(r.width + r.height)
}

fn corner_sum(r: Rect) -> i32 {
    return dot.sum(r.corner)
}
