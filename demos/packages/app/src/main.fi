// expect_out: 12 14 3
// demos/packages/app — baut mit
//     firnc --paket demos/packages/app
//
// 'geo' und 'text' sind Abhaengigkeiten aus firn.paket; 'geo.punkt' ist ein
// oeffentliches Modul des Pakets 'geo'. 'geo.innen' waere ein Fehler.
import geo
import geo.dot
import text
import help

fn main() -> i32 {
    let r: geo.Rect = geo.rect_new(1, 2, 3, 4)
    text.write_number(geo.area(r))          // 12
    help.sep()
    text.write_number(geo.extent(r))           // 14
    help.sep()
    text.write_number(dot.sum(dot.dot_new(1, 2)))   // 3
    text.write_line()
    return 0
}
