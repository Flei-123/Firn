#!/usr/bin/env firnc-run
// ROUND 84 -- a Firn file that starts like a script.
//
//     chmod +x demos/hello_run.fi
//     ./demos/hello_run.fi
//
// The first line is for the kernel: it starts `firnc-run`, which is
// `firnc run` (tools/run/firnc-run, put it on your PATH). The compiler
// skips that line -- ONLY in line 1, and only when it begins with `#!`.
// `#` is not a comment character in Firn anywhere else.
//
// No `import` on purpose: this way the file runs without $FIRNLIB, exactly
// as a stranger would try it.
fn main() -> i32 {
    var text: [u8; 21] = "hello from a shebang\n"
    syscall(1, 1, (&text[0]) as u64, 21)
    return 0
}
