// SPDX-License-Identifier: MPL-2.0
// demos/pushdemo/main.fi -- NOTIFICATIONS FROM AN OWN TCP CONNECTION.
//
// The smallest program that shows lib/plat/android/push.fi: it opens a
// window (green = the push service was started, red = it was not), starts
// the foreground service towards <host> <port> (argv, default 10.0.2.2 --
// the host machine as seen from the Android emulator -- and 7790) and
// then only waits. Every line the relay sends becomes a notification,
// also after the activity was closed with Back: the service keeps the
// connection. A tap into the window posts a local notification.
//
//   bash tools/android/build.sh demos/pushdemo/main.fi --name "Firn Push" \
//       --package org.firn.pushdemo --push
//   python3 tools/android/relay_test.py 7790     # on the host
//
// Build only for Android: the window backend comes from build.sh, and
// lib/plat/android needs libandroid.
import std.rt
import window.window
import plat.android.push

fn zahl(p: u64) -> u32 {
    var v: u32 = 0
    var i: usize = 0
    while rt.ld8(p, i) >= 48 as u8 && rt.ld8(p, i) <= 57 as u8 {
        v = v * 10 as u32 + (rt.ld8(p, i) - 48 as u8) as u32
        i = i + 1
    }
    return v
}

fn malen(f: *mut window.Window, farbe: u32) {
    let ok: bool = window.fill(f, farbe, 0, 0, window.width(f),
        window.height(f))
    let ok2: bool = window.present(f)
}

fn main(start: u64) -> i32 {
    var std_host: [u8; 9] = "10.0.2.2\0"
    var host: u64 = (&std_host[0]) as u64
    var port: u32 = 7790
    if rt.arg_count(start) >= 2 {
        host = rt.arg_ptr(start, 1)
    }
    if rt.arg_count(start) >= 3 {
        port = zahl(rt.arg_ptr(start, 2))
    }
    var f: window.Window = window.window_new()
    if !window.open_window(&f, 0) {
        return 1
    }
    if !window.make(&f, 360, 640) {
        return 2
    }
    let s: bool = window.show_window(&f)
    let gestartet: bool = push.push_start(host, port)
    var farbe: u32 = 12597547
    if gestartet {
        farbe = 2984535
    }
    var titel: [u8; 10] = "Firn Push\0"
    var text: [u8; 32] = "Dienst gestartet, warte auf TCP\0"
    let n: bool = push.push_notify((&titel[0]) as u64, (&text[0]) as u64)
    malen(&f, farbe)
    var laeuft: bool = true
    while laeuft {
        let w: bool = window.wait_event(&f, -1)
        var k: u32 = window.next_event(&f)
        while k != window.EV_NONE {
            if k == window.EV_CLOSED {
                laeuft = false
            } else if k == window.EV_KEY && window.ev_a(&f) == window.K_ESCAPE {
                laeuft = false
            } else if k == window.EV_EXPOSE || k == window.EV_CONFIGURE {
                malen(&f, farbe)
            } else if k == window.EV_BUTTON {
                var tt: [u8; 16] = "Tipp ins Fenster"
                var t0: [u8; 17] = "Tipp ins Fenster\0"
                let n2: bool = push.push_notify((&titel[0]) as u64,
                    (&t0[0]) as u64)
            }
            k = window.next_event(&f)
        }
    }
    window.close_window(&f)
    return 0
}
