// demos/mcsrv/main.fi -- standalone Minecraft 1.20.1 server in Firn (flat or saved world). Options: --port N --view N --mode N --world DIR --ticks N.

import std.io
import std.args
import std.rt
import std.time
import mc.server.sv_host

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == sv_host.SERVER_KIND { return sv_host.server_main(arg) }
    return 0
}

fn say(f: io.Fmt) {
    io.fmt_print(f)
}

fn main(start: u64) -> i32 {
    var p: args.Cmd = args.cmd("mcsrv", "Firn Minecraft 1.20.1 server")
    args.opt(&p, "--port", args.INT, "25565", "listen port (0 = any)")
    args.opt(&p, "--view", args.INT, "8", "view distance in chunks")
    args.opt(&p, "--mode", args.INT, "1", "game mode (0 survival, 1 creative)")
    args.opt(&p, "--world", args.STR, "", "vanilla world directory to serve (empty = superflat)")
    args.opt(&p, "--ops", args.STR, "*", "operators as Name:level,Name (\"*\" = everyone level 4, empty = nobody)")
    args.opt(&p, "--ticks", args.INT, "0", "stop after this many ticks (0 = run until killed)")
    var r: args.Result = args.parse_argv(&p, start)
    if r.status != args.OK {
        io.print_line(r.text)
        return r.status
    }
    var host: sv_host.Host = sv_host.host_new()
    let want_ticks: u64 = args.get_int(&r, "ticks") as u64
    if !sv_host.host_start(&host, args.get_int(&r, "port") as u16, args.get_int(&r, "view") as i32, args.get_int(&r, "mode") as i32, args.get(&r, "world"), args.get(&r, "ops")) {
        io.eprint_line("mcsrv: cannot start")
        return 1
    }
    let port: u64 = sv_host.host_port(&host) as u64
    say(f"mcsrv: listening on {port}\n")
    while true {
        time.sleep_ms(20 as u64)
        if want_ticks > 0 as u64 && sv_host.host_ticks(&host) >= want_ticks { break }
    }
    let ticks: u64 = sv_host.host_ticks(&host)
    let avg: u64 = sv_host.host_avg_us(&host)
    let tps: u64 = sv_host.host_tps_x100(&host)
    sv_host.host_stop(&host)
    say(f"mcsrv: stopped ticks={ticks} avg_us={avg} tps_x100={tps}\n")
    return 0
}
