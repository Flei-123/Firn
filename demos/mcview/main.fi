import mc.mc_packs
import mc.mc_backend
import mc.vk_mc

const DEFAULT_VIEW: i32 = 6
const DEFAULT_SETTLE_MS: u64 = 3000
const DEFAULT_PROTOCOL: i32 = 763
const LOGIN_WAITS: i32 = 200
const PLAY_TIMEOUT_MS: u64 = 120000
const FOG_R: u32 = 150
const FOG_G: u32 = 190
const FOG_B: u32 = 230
const PF_SKY: u32 = 1
const PF_BOX: u32 = 2
const PF_HUD: u32 = 4
const PF_BAD: u32 = 128
const BOX_RGBA: u32 = 0xFF000000
const DEFAULT_TICKS: i32 = 2000
const DEFAULT_REACH: i32 = 24

fn now_ns() -> u64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return (ts[0] as u64) * 1000000000 as u64 + (ts[1] as u64)
}

fn now_ms() -> u64 {
    return now_ns() / 1000000 as u64
}

fn say(f: io.Fmt) {
    io.fmt_print(f)
}

// signed decimal of the C string at p; fallback on any other character
fn parse_dec(p: u64, n: usize, fallback: i64) -> i64 {
    if n == 0 {
        return fallback
    }
    var neg: bool = false
    var i: usize = 0
    if rt.ld8(p, 0) == 45 as u8 {
        neg = true
        i = 1
    }
    if i >= n {
        return fallback
    }
    var v: i64 = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c < 48 as u8 || c > 57 as u8 {
            return fallback
        }
        v = v * 10 + (c - 48 as u8) as i64
        i = i + 1
    }
    if neg {
        return 0 - v
    }
    return v
}

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == jobs.WORKER_KIND { return jobs.worker_main(arg) }
    return 0
}

fn env_flag(name: str, fallback: bool) -> bool {
    if !env.has(name) {
        return fallback
    }
    let v: str = env.get(name)
    if v.length() == 0 {
        return fallback
    }
    return v.chars(0) == 49 as u8
}

fn env_int(name: str, fallback: i32) -> i32 {
    if !env.has(name) {
        return fallback
    }
    let v: str = env.get(name)
    return parse_dec(v.p as u64, v.length(), fallback as i64) as i32
}

// ---- command line: flags (--sky --box --hud --all) are skipped by argn/argp so the positional layout stays as before

fn c_eq(p: u64, lit: str) -> bool {
    if rt.c_length(p) != lit.n {
        return false
    }
    var k: usize = 0
    while k < lit.n {
        if rt.ld8(p, k) != lit.chars(k) {
            return false
        }
        k = k + 1
    }
    return true
}

fn is_flag(p: u64) -> bool {
    return rt.c_length(p) >= 3 && rt.ld8(p, 0) == 45 as u8 && rt.ld8(p, 1) == 45 as u8 && !c_eq(p, "--replay")
}

fn argn(start: u64) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < rt.arg_count(start) {
        if !is_flag(rt.arg_ptr(start, i)) {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn argp(start: u64, k: usize) -> u64 {
    var n: usize = 0
    var i: usize = 0
    while i < rt.arg_count(start) {
        let p: u64 = rt.arg_ptr(start, i)
        if !is_flag(p) {
            if n == k {
                return p
            }
            n = n + 1
        }
        i = i + 1
    }
    return 0
}

// post-processing flags of the command line; PF_BAD when an unknown flag is present
fn post_flags(start: u64) -> u32 {
    var f: u32 = 0 as u32
    var i: usize = 0
    while i < rt.arg_count(start) {
        let p: u64 = rt.arg_ptr(start, i)
        i = i + 1
        if !is_flag(p) {
            continue
        }
        if c_eq(p, "--sky") {
            f = f | PF_SKY
        } else if c_eq(p, "--box") {
            f = f | PF_BOX
        } else if c_eq(p, "--hud") {
            f = f | PF_HUD
        } else if c_eq(p, "--all") {
            f = f | PF_SKY | PF_BOX | PF_HUD
        } else if pack_flag_at(p) != 0 {
            f = f | 0 as u32 // --pack=<list>: handled by pack_flag
        } else {
            f = f | PF_BAD
        }
    }
    return f
}

// ---- small buffer helpers ---------------------------------------------------------------------------

fn push_lit(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn push_dec(b: *mut rt.Buf, v: i64) {
    rt.buf_push(b, 32 as u8)
    rt.buf_push_dec_i64(b, v)
}

fn push_hex(b: *mut rt.Buf, v: u64) {
    rt.buf_push(b, 32 as u8)
    rt.buf_push_hex_u64(b, v, 1)
}

fn push_f(b: *mut rt.Buf, x: f64) {
    push_hex(b, core.f64_bits(x))
}

// "<dir>/<name>\0" into `out`
fn path_of(out: *mut rt.Buf, dir: u64, name: str) {
    rt.buf_push_bytes(out, dir, rt.c_length(dir))
    rt.buf_push(out, 47 as u8)
    rt.buf_push_bytes(out, name.p as u64, name.n)
    rt.buf_push(out, 0 as u8)
}

fn write_to(dir: u64, name: str, p: u64, n: usize) -> bool {
    var pb: rt.Buf = rt.buf_new()
    path_of(&pb, dir, name)
    let ok: bool = rt.write_file(rt.buf_ptr(&pb), p, n)
    rt.buf_free(&pb)
    return ok
}

// ---- config + world file ------------------------------------------------------------------------------

struct Cfg {
    protocol: i32,
    min_y: i32,
    view: i32, // chunks
    w: i32,
    h: i32,
    flags: u32,
    fog: bool,
    cx: f64, // camera position
    cy: f64,
    cz: f64,
    yaw: f64,
    pitch: f64,
    post: u32, // PF_* flags
    ticks: i32,
    rain: i32,
    fps: i32, // shown by the HUD; < 0 = measured
    reach: i32,
    slot: i32,
}

fn sort_chunks(w: *mut mc_world.World, order: u64) {
    let n: usize = mc_world.world_count(w)
    var i: usize = 0
    while i < n {
        rt.st64(order, i, i as u64)
        i = i + 1
    }
    i = 1
    while i < n {
        let cur: u64 = rt.ld64(order, i)
        let cc: *mut mc_chunk.Chunk = mc_world.world_chunk_at(w, cur as usize)
        var j: usize = i
        while j > 0 {
            let pc: *mut mc_chunk.Chunk = mc_world.world_chunk_at(w, rt.ld64(order, j - 1) as usize)
            if (*pc).x > (*cc).x || ((*pc).x == (*cc).x && (*pc).z > (*cc).z) {
                rt.st64(order, j, rt.ld64(order, j - 1))
                j = j - 1
            } else {
                break
            }
        }
        rt.st64(order, j, cur)
        i = i + 1
    }
}

fn world_text(w: *mut mc_world.World, cfg: *mut Cfg, out: *mut rt.Buf) {
    push_lit(out, "mcworld 1\nprotocol")
    push_dec(out, (*cfg).protocol as i64)
    push_lit(out, "\nmin_y")
    push_dec(out, (*cfg).min_y as i64)
    push_lit(out, "\ncam")
    push_f(out, (*cfg).cx)
    push_f(out, (*cfg).cy)
    push_f(out, (*cfg).cz)
    push_f(out, (*cfg).yaw)
    push_f(out, (*cfg).pitch)
    push_lit(out, "\nview")
    push_dec(out, (*cfg).view as i64)
    push_lit(out, "\nchunks")
    let n: usize = mc_world.world_count(w)
    push_dec(out, n as i64)
    rt.buf_push(out, 10 as u8)
    let order: u64 = rt.heap_alloc(n * 8 + 8)
    sort_chunks(w, order)
    var k: usize = 0
    while k < n {
        let ch: *mut mc_chunk.Chunk = mc_world.world_chunk_at(w, rt.ld64(order, k) as usize)
        k = k + 1
        push_lit(out, "C")
        push_dec(out, (*ch).x as i64)
        push_dec(out, (*ch).z as i64)
        push_dec(out, (*ch).nsec as i64)
        rt.buf_push(out, 10 as u8)
        var s: usize = 0
        while s < (*ch).nsec {
            let sec: *mut mc_chunk.Section = mc_chunk.chunk_section(ch, s)
            if mc_chunk.container_bits(&(*sec).blocks) == 0 as u32 {
                push_lit(out, "U")
                push_dec(out, s as i64)
                push_dec(out, mc_chunk.container_get(&(*sec).blocks, 0) as i64)
                rt.buf_push(out, 10 as u8)
            } else {
                let runs: u64 = rt.heap_alloc(4096 * 16)
                var nr: usize = 0
                var cur: u16 = mc_chunk.container_get(&(*sec).blocks, 0)
                var len: u64 = 1
                var i: usize = 1
                while i < 4096 {
                    let v: u16 = mc_chunk.container_get(&(*sec).blocks, i)
                    if v == cur {
                        len = len + 1 as u64
                    } else {
                        rt.st64(runs, nr * 2, cur as u64)
                        rt.st64(runs, nr * 2 + 1, len)
                        nr = nr + 1
                        cur = v
                        len = 1
                    }
                    i = i + 1
                }
                rt.st64(runs, nr * 2, cur as u64)
                rt.st64(runs, nr * 2 + 1, len)
                nr = nr + 1
                push_lit(out, "R")
                push_dec(out, s as i64)
                push_dec(out, nr as i64)
                var r: usize = 0
                while r < nr {
                    push_dec(out, rt.ld64(runs, r * 2) as i64)
                    push_dec(out, rt.ld64(runs, r * 2 + 1) as i64)
                    r = r + 1
                }
                rt.buf_push(out, 10 as u8)
                rt.heap_free(runs, 4096 * 16)
            }
            s = s + 1
        }
    }
    rt.heap_free(order, n * 8 + 8)
}

// ---- tokenizer for the world file ------------------------------------------------------------------

struct Tok {
    p: u64,
    n: usize,
    i: usize,
    bad: bool,
}

fn tk_skip(t: *mut Tok) {
    while (*t).i < (*t).n {
        let c: u8 = rt.ld8((*t).p, (*t).i)
        if c == 32 as u8 || c == 10 as u8 || c == 13 as u8 || c == 9 as u8 {
            (*t).i = (*t).i + 1
        } else {
            break
        }
    }
}

// next word: start offset into *s, length into *n
fn tk_word(t: *mut Tok, s: *mut usize, n: *mut usize) -> bool {
    tk_skip(t)
    if (*t).i >= (*t).n {
        (*t).bad = true
        return false
    }
    *s = (*t).i
    while (*t).i < (*t).n {
        let c: u8 = rt.ld8((*t).p, (*t).i)
        if c == 32 as u8 || c == 10 as u8 || c == 13 as u8 || c == 9 as u8 {
            break
        }
        (*t).i = (*t).i + 1
    }
    *n = (*t).i - *s
    return true
}

fn tk_is(t: *mut Tok, lit: str) -> bool {
    var s: usize = 0
    var n: usize = 0
    if !tk_word(t, &s, &n) {
        return false
    }
    if n != lit.n {
        (*t).bad = true
        return false
    }
    var k: usize = 0
    while k < n {
        if rt.ld8((*t).p, s + k) != lit.chars(k) {
            (*t).bad = true
            return false
        }
        k = k + 1
    }
    return true
}

fn tk_int(t: *mut Tok) -> i64 {
    var s: usize = 0
    var n: usize = 0
    if !tk_word(t, &s, &n) {
        return 0
    }
    let v: i64 = parse_dec((*t).p + s as u64, n, 0 - 9999999999)
    if v == 0 - 9999999999 {
        (*t).bad = true
        return 0
    }
    return v
}

fn tk_hex(t: *mut Tok) -> u64 {
    var s: usize = 0
    var n: usize = 0
    if !tk_word(t, &s, &n) {
        return 0
    }
    var v: u64 = 0
    var k: usize = 0
    while k < n {
        let c: u8 = rt.ld8((*t).p, s + k)
        var d: u64 = 0
        if c >= 48 as u8 && c <= 57 as u8 {
            d = (c - 48 as u8) as u64
        } else if c >= 97 as u8 && c <= 102 as u8 {
            d = (c - 87 as u8) as u64
        } else {
            (*t).bad = true
            return 0
        }
        v = v * 16 as u64 + d
        k = k + 1
    }
    return v
}

// Parses the world file into `w` + `cfg` (protocol, min_y, camera, view). false on any error.
fn world_parse(blob: u64, n: usize, w: *mut mc_world.World, cfg: *mut Cfg) -> bool {
    var t: Tok = Tok { p: blob, n: n, i: 0, bad: false }
    if !tk_is(&t, "mcworld") || tk_int(&t) != 1 { return false }
    if !tk_is(&t, "protocol") { return false }
    (*cfg).protocol = tk_int(&t) as i32
    if !tk_is(&t, "min_y") { return false }
    (*cfg).min_y = tk_int(&t) as i32
    if !tk_is(&t, "cam") { return false }
    (*cfg).cx = core.bits_f64(tk_hex(&t))
    (*cfg).cy = core.bits_f64(tk_hex(&t))
    (*cfg).cz = core.bits_f64(tk_hex(&t))
    (*cfg).yaw = core.bits_f64(tk_hex(&t))
    (*cfg).pitch = core.bits_f64(tk_hex(&t))
    if !tk_is(&t, "view") { return false }
    (*cfg).view = tk_int(&t) as i32
    if !tk_is(&t, "chunks") { return false }
    let nch: i64 = tk_int(&t)
    if t.bad { return false }
    let ids: u64 = rt.heap_alloc(48 * 4096 * 2)
    var c: i64 = 0
    while c < nch {
        if !tk_is(&t, "C") { return false }
        let cx: i32 = tk_int(&t) as i32
        let cz: i32 = tk_int(&t) as i32
        let nsec: i64 = tk_int(&t)
        if t.bad || nsec < 1 || nsec > 48 { return false }
        var s: i64 = 0
        while s < nsec {
            var ws: usize = 0
            var wn: usize = 0
            if !tk_word(&t, &ws, &wn) || wn != 1 { return false }
            let kind: u8 = rt.ld8(blob, ws)
            let si: i64 = tk_int(&t)
            if t.bad || si != s { return false }
            let base: usize = (s as usize) * 4096
            if kind == 85 as u8 {
                let id: u16 = tk_int(&t) as u16
                var i: usize = 0
                while i < 4096 {
                    rt.st16(ids, base + i, id)
                    i = i + 1
                }
            } else if kind == 82 as u8 {
                let nr: i64 = tk_int(&t)
                var at: usize = 0
                var r: i64 = 0
                while r < nr && !t.bad {
                    let id: u16 = tk_int(&t) as u16
                    let len: i64 = tk_int(&t)
                    if len < 1 || at + (len as usize) > 4096 { return false }
                    var k: i64 = 0
                    while k < len {
                        rt.st16(ids, base + at, id)
                        at = at + 1
                        k = k + 1
                    }
                    r = r + 1
                }
                if at != 4096 { return false }
            } else {
                return false
            }
            if t.bad { return false }
            s = s + 1
        }
        let p: u64 = mc_render_world.wr_make_chunk(cx, cz, nsec as usize, ids)
        if p == 0 || !mc_world.world_put(w, p) { return false }
        c = c + 1
    }
    rt.heap_free(ids, 48 * 4096 * 2)
    return !t.bad
}

// ---- rendering --------------------------------------------------------------------------------------

fn mark_palette(c: *mut mc_chunk.Container, used: u64) {
    if (*c).bits == 0 as u32 {
        rt.st8(used, rt.ld16((*c).pal, 0) as usize, 1 as u8)
        return
    }
    var i: usize = 0
    while i < ((*c).pal_n as usize) {
        let id: u16 = rt.ld16((*c).pal, i)
        if (id as usize) < 32768 {
            rt.st8(used, id as usize, 1 as u8)
        }
        i = i + 1
    }
}

fn hex_of(r: *mut mc_raster.Raster, out: *mut rt.Buf) {
    let h: u64 = rt.heap_alloc(64)
    mc_raster.raster_hash_hex(r, h)
    rt.buf_push_bytes(out, h, 64)
    rt.heap_free(h, 64)
}

fn metric(m: *mut rt.Buf, key: str, v: i64) {
    push_lit(m, "metric ")
    push_lit(m, key)
    rt.buf_push(m, 61 as u8)
    rt.buf_push_dec_i64(m, v)
    rt.buf_push(m, 10 as u8)
}

// Everything the renderer owns: atlas, block tables, rasterizer, world renderer (section mesh cache). Built once; in live mode it
// exists while the packets arrive so that an unload packet can free the meshes of the column.
struct Gfx {
    atlas: mc_texture.Atlas,
    tb: mc_mesh.MeshTables,
    r: mc_raster.Raster,
    wr: mc_render_world.WorldRender,
    ok: bool,
    res: mc_packs.ResMgr, // resource packs (only used when use_res)
    use_res: bool,
    stm_on: bool, // MCVIEW_STREAM=1: the world is drawn by mc_stream (worker meshing) instead of wr_render
    stm_made: bool,
    lod: i32, // plan from mc_lod_policy: LOD radius in chunks (0 = none); the stream draws the full-detail ring of mc_lod_policy.LOD_FULL_RING
    full_view: i32,
    stm: mc_stream.Stream,
    pool: jobs.Jobs,
    vk: bool, // MCVIEW_GFX=vk: the frame is drawn through vk_mc (sky, world, box, tint, HUD in one pass) and read back into the raster colour buffer
    vbk: vk_mc.VkBackend, // opened IN PLACE by gfx_vk_open (never copy a VkBackend after that)
}

// Resource packs are wanted when MC_PACKS / MC_PACK_CONFIG / MC_PACK_AUTO is set or a --pack=a.zip,b.zip flag is given
// (mc_packs.res_setup_env documents the variables). Then the block tables use the extended tile ids (64 + i) and the atlas
// belongs to the ResMgr; without packs everything is exactly as before (python reference hash).
fn pack_flag_at(p: u64) -> u64 {
    if rt.c_length(p) > 7 && rt.ld8(p, 0) == 45 as u8 && rt.ld8(p, 1) == 45 as u8 && rt.ld8(p, 2) == 112 as u8 && rt.ld8(p, 3) == 97 as u8
    && rt.ld8(p, 4) == 99 as u8 && rt.ld8(p, 5) == 107 as u8 && rt.ld8(p, 6) == 61 as u8 {
        return p + 7 as u64
    }
    return 0
}

fn pack_flag(start: u64) -> u64 {
    var i: usize = 0
    while i < rt.arg_count(start) {
        let q: u64 = pack_flag_at(rt.arg_ptr(start, i))
        i = i + 1
        if q != 0 { return q }
    }
    return 0
}

fn gfx_new(w: i32, h: i32, ver: *mut mc_version.Version, min_y: i32, view: i32, use_res: bool) -> Gfx {
    var atlas: mc_texture.Atlas = mc_texture.atlas_default()
    var tb: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    mc_texture.tex_alloc_tables(&tb)
    var reg: mc_registry.Registry = ver.registry_of()
    let ok: bool = mc_registry.registry_ok(&reg)
    var res: mc_packs.ResMgr = mc_packs.res_new()
    if ok {
        if use_res {
            mc_packs.res_build_tables(&res, &reg, &tb)
        } else {
            mc_texture.tex_build_tables(&reg, &tb)
        }
    }
    var r: mc_raster.Raster = mc_raster.raster_new(w, h)
    mc_raster.backend_upload_atlas(&r, &atlas)
    var wr: mc_render_world.WorldRender = mc_render_world.wr_new(min_y, view, &tb)
    var dummy_tb: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    return Gfx { atlas: atlas, tb: tb, r: r, wr: wr, ok: ok, res: res, use_res: use_res,
        stm_on: env_flag("MCVIEW_STREAM", false), stm_made: false, lod: 0, full_view: 0, stm: mc_stream.stream_new(0, 1, 1, &dummy_tb, 0 as u64), pool: jobs.Jobs { blk: 0 }, vk: false, vbk: vk_mc.vkbe_blank() }
}

// The back end that draws: the Vulkan table when MCVIEW_GFX=vk was opened, else the CPU raster.
fn gfx_be(g: *mut Gfx) -> mc_backend.Backend {
    if (*g).vk { return vk_mc.vkbe_backend(&(*g).vbk) }
    return mc_backend.backend_cpu(&(*g).r)
}

fn want_vk_gfx() -> bool {
    if !env.has("MCVIEW_GFX") { return false }
    let v: str = env.get("MCVIEW_GFX")
    return v.length() == 2 && v.chars(0) == 118 as u8 && v.chars(1) == 107 as u8
}

// MCVIEW_GFX=vk: opens the Vulkan back end for the image size (offscreen, no swapchain) and uploads the atlas / packs.
// false = no Vulkan device: the caller keeps the CPU path (message on stderr).
fn gfx_vk_open(g: *mut Gfx, w: i32, h: i32) -> bool {
    if !vk_mc.vkbe_open_win(&(*g).vbk, w, h, "", 0 as u64, 0) {
        io.eprint_line("mcview: gfx=cpu (vk requested but not available)")
        return false
    }
    vk_mc.vkbe_set_readback(&(*g).vbk, true)
    (*g).vk = true
    var be: mc_backend.Backend = vk_mc.vkbe_backend(&(*g).vbk)
    if (*g).use_res {
        mc_packs.res_reload_upload(&(*g).res, &be)
    } else {
        be.upload_atlas(be.obj, ((&(*g).atlas) as u64))
    }
    io.print("mcview: gfx=vk device=")
    io.print_c(vk_mc.vkbe_device_name(&(*g).vbk))
    say(f" cpu_device={vk_mc.vkbe_is_cpu(&(*g).vbk)}\n")
    return true
}

// Frees the world meshes through the Vulkan table, then closes the device (before wr_free).
fn gfx_vk_close(g: *mut Gfx) {
    if !(*g).vk { return }
    var be: mc_backend.Backend = vk_mc.vkbe_backend(&(*g).vbk)
    mc_render_world.wr_clear_b(&(*g).wr, &be)
    vk_mc.vkbe_close(&(*g).vbk)
    (*g).vk = false
}

// Loads the packs (env + optional --pack list) into the manager and uploads the atlas. Warnings go to stderr.
fn gfx_packs_load(g: *mut Gfx, protocol: i32, packs_flag: u64) {
    mc_packs.res_setup_env(&(*g).res, protocol)
    if packs_flag != 0 {
        let s: str = str { p: packs_flag as *mut u8, n: rt.c_length(packs_flag) }
        mc_packs.res_add_list(&(*g).res, s)
    }
    gfx_packs_reload(g)
}

// Hot reload (the live client calls this from its reload key via mc_packs.res_on_key): re-reads the packs, new atlas, upload.
// Block tile ids do not change, so cached meshes stay valid.
fn gfx_packs_reload(g: *mut Gfx) -> i32 {
    var be: mc_backend.Backend = gfx_be(g)
    let n: i32 = mc_packs.res_reload_upload(&(*g).res, &be)
    if mc_packs.res_warn_count(&(*g).res) > 0 {
        let wt: str = mc_packs.res_warn_text(&(*g).res)
        io.eprint_line(wt)
    }
    return n
}

// Animated tiles for game tick `tick` (once per game tick in a live client).
fn gfx_packs_tick(g: *mut Gfx, tick: i64) -> i32 {
    var be: mc_backend.Backend = gfx_be(g)
    return mc_packs.res_tick(&(*g).res, tick, &be)
}

// Pick table for the selection box: a block state is targetable when any face is drawn (so fluids that have a texture are
// targetable too -- vanilla skips them); solid = registry RF_SOLID (full-box collision).
fn pick_tables(tb: *mut mc_mesh.MeshTables, reg: *mut mc_registry.Registry) -> mc_input.InputTables {
    let pk: u64 = rt.heap_alloc(32768)
    let so: u64 = rt.heap_alloc(65536) // u16 per state (shape codes 128 + k)
    var id: usize = 0
    while id < 32768 {
        var any: u8 = 0 as u8
        var f: usize = 0
        while f < 6 {
            if rt.ld16((*tb).tiles, id * 6 + f) != 0 as u16 { any = 1 as u8 }
            f = f + 1
        }
        rt.st8(pk, id, any)
        id = id + 1
    }
    mc_registry.reg_fill_solid(reg, so, 32768)
    return mc_input.InputTables { pick: pk, solid: so, n: 32768 }
}

// MCVIEW_STREAM=1: first use builds the stream (+ MCVIEW_WORKERS mesher threads, default 3), announces every loaded column and
// meshes until nothing is pending (synchronous, so the picture is complete), later frames only draw.
#[allow_escape]
fn stream_world(g: *mut Gfx, w: *mut mc_world.World, cam: *mut mc_camera.Camera, cfg: *mut Cfg) {
    var be: mc_backend.Backend = gfx_be(g)
    if !(*g).stm_made {
        var nw: i32 = env_int("MCVIEW_WORKERS", 3)
        if (*g).vk { nw = 0 } // raw clone threads crash libvulkan_lvp (like mcplay VK)
        var pa: u64 = 0
        if nw > 0 {
            // lock-free ring pool (r192); MCVIEW_JOBS_LOCKED=1 = old locked queue
            if env_int("MCVIEW_JOBS_LOCKED", 0) != 0 { (*g).pool = jobs.create(nw as u64) } else { (*g).pool = jobs.create_lf(nw as u64) }
            if (*g).pool.blk != 0 { pa = ((&(*g).pool) as *mut jobs.Jobs) as u64 }
        }
        var maxn: i32 = 1
        var i: usize = 0
        while i < mc_world.world_count(w) {
            let nsec: i32 = (*mc_world.world_chunk_at(w, i)).nsec as i32
            if nsec > maxn { maxn = nsec }
            i = i + 1
        }
        (*g).stm = mc_stream.stream_new((*cfg).min_y, maxn, (*g).full_view, &(*g).tb, pa)
        (*g).stm_made = true
        if (*g).lod > (*g).full_view { (*g).stm.lod_dist = (*g).lod }
        (*g).stm.nbr_wait = 2 as u32
        (*g).stm.flags = (*cfg).flags
        i = 0
        while i < mc_world.world_count(w) {
            let ch: *mut mc_chunk.Chunk = mc_world.world_chunk_at(w, i)
            let okc: bool = mc_stream.stream_chunk_loaded(&(*g).stm, w, (*ch).x, (*ch).z)
            i = i + 1
        }
        let nf: usize = mc_stream.stream_flush(&(*g).stm, w, &be, cam, 2000)
    }
    let tris: u64 = mc_stream.stream_frame(&(*g).stm, w, &be, cam)
}

// Frees the stream and the mesher threads (before the Gfx goes away).
fn stream_end(g: *mut Gfx) {
    if !(*g).stm_made { return }
    var be: mc_backend.Backend = gfx_be(g)
    mc_stream.stream_free(&(*g).stm, &be)
    (*g).stm_made = false
    if (*g).pool.blk != 0 { jobs.destroy(&(*g).pool) }
}

// Vulkan twin of frame(): same order (sky -> world -> box -> tint -> HUD), one render pass, then the colour image is read back into the raster
// colour buffer so that PNG / hash / view.rgba stay the same code path. The picture is NOT bit equal to the CPU raster (PSNR gate run_vkview.sh).
#[allow_escape]
fn frame_vk(g: *mut Gfx, w: *mut mc_world.World, cam: *mut mc_camera.Camera, cfg: *mut Cfg, sky: *mut mc_sky.Sky,
    itb: *mut mc_input.InputTables, clear: u32, fog_start: f64, fog_end: f64, fps: i32, pk: *mut mc_input.Pick) -> bool {
    let post: u32 = (*cfg).post
    var be: mc_backend.Backend = vk_mc.vkbe_backend(&(*g).vbk)
    var fr: u32 = FOG_R
    var fg: u32 = FOG_G
    var fb: u32 = FOG_B
    if (post & PF_SKY) != 0 as u32 {
        fr = (*sky).fr as u32
        fg = (*sky).fg as u32
        fb = (*sky).fb as u32
    }
    vk_mc.vkbe_set_fog(&(*g).vbk, (*cfg).fog, fog_start, fog_end, fr, fg, fb)
    be.begin(be.obj, ((cam) as u64), clear)
    if (post & PF_SKY) != 0 as u32 {
        vk_mc.vkbe_sky(&(*g).vbk, cam, sky)
    }
    if (*g).stm_on {
        stream_world(g, w, cam, cfg)
    } else {
        mc_render_world.wr_render_b(&(*g).wr, w, &be, cam, 0 - 1)
    }
    var hit: bool = false
    if (post & (PF_BOX | PF_HUD)) != 0 as u32 {
        hit = mc_input.input_pick_camera(w, (*cfg).min_y, itb, cam, (*cfg).reach as f64, pk)
    }
    if (post & PF_BOX) != 0 as u32 && hit {
        // 12 thin boxes along the block edges (the same records as mcplay's VK/GL selection box); black like BOX_RGBA
        var recs: [f64; 144] = [0.0; 144]
        let e: f64 = 0.03
        let bx: f64 = (*pk).x as f64
        let by: f64 = (*pk).y as f64
        let bz: f64 = (*pk).z as f64
        var i: i32 = 0
        var m: usize = 0
        while i < 4 {
            var ox: f64 = 0.0
            var oy: f64 = 0.0
            if (i & 1) != 0 { ox = 1.0 }
            if (i & 2) != 0 { oy = 1.0 }
            var k: usize = 0
            while k < 3 {
                var x: f64 = bx + ox
                var y: f64 = by + oy
                var z: f64 = bz + oy
                var sx: f64 = e
                var sy: f64 = e
                var sz: f64 = e
                if k == 0 { x = bx + 0.5
                    y = by + oy
                    z = bz + ox
                    sx = 1.0 + e }
                if k == 1 { x = bx + ox
                    y = by + 0.5
                    z = bz + oy
                    sy = 1.0 + e }
                if k == 2 { x = bx + ox
                    y = by + oy
                    z = bz + 0.5
                    sz = 1.0 + e }
                let o: usize = m * 12
                recs[o] = x
                recs[o + 1] = y
                recs[o + 2] = z
                recs[o + 3] = sx
                recs[o + 4] = sy
                recs[o + 5] = sz
                recs[o + 7] = 1.0
                m = m + 1
                k = k + 1
            }
            i = i + 1
        }
        let nb: u64 = be.draw_entities(be.ent_obj, (&recs[0]) as u64, m)
    }
    if (post & PF_SKY) != 0 as u32 {
        vk_mc.vkbe_tint(&(*g).vbk, sky)
    }
    var rec: rt.Buf = rt.buf_new()
    if (post & PF_HUD) != 0 as u32 {
        var d: mc_hud.HudDebug = mc_hud.hud_debug_new()
        d.fps = fps
        d.x = (*cam).x
        d.y = (*cam).y
        d.z = (*cam).z
        d.yaw = (*cfg).yaw
        d.pitch = (*cfg).pitch
        d.has_block = hit
        if hit {
            d.bx = (*pk).x
            d.by = (*pk).y
            d.bz = (*pk).z
            d.id = (*pk).id
            d.nx = (*pk).nx
            d.ny = (*pk).ny
            d.nz = (*pk).nz
        }
        mc_hud.hud_record(&rec)
        mc_hud.hud_frame(&(*g).r, mc_hud.hud_scale((*cfg).w, (*cfg).h), mc_hud.HUD_CROSSHAIR | mc_hud.HUD_HOTBAR | mc_hud.HUD_DEBUG,
            (*cfg).slot, &d)
        mc_hud.hud_record(0 as *mut rt.Buf)
        vk_mc.vkbe_hud(&(*g).vbk, &rec)
    }
    rt.buf_free(&rec)
    be.end(be.obj)
    be.read_pixels(be.obj, (*g).r.color)
    return hit
}

// One frame in the fixed order: clear -> sky -> sky fog -> world -> light tint -> selection box -> HUD.
// Returns true when the pick ray hit a block (`pk` is filled then).
fn frame(g: *mut Gfx, w: *mut mc_world.World, cam: *mut mc_camera.Camera, cfg: *mut Cfg, sky: *mut mc_sky.Sky,
    itb: *mut mc_input.InputTables, clear: u32, fog_start: f64, fog_end: f64, fps: i32, pk: *mut mc_input.Pick) -> bool {
    if (*g).vk { return frame_vk(g, w, cam, cfg, sky, itb, clear, fog_start, fog_end, fps, pk) }
    let r: *mut mc_raster.Raster = &(*g).r
    let post: u32 = (*cfg).post
    mc_raster.backend_begin(r, cam, clear)
    if (post & PF_SKY) != 0 as u32 {
        mc_sky.sky_draw(sky, r)
        if (*cfg).fog {
            mc_sky.sky_set_raster_fog(sky, r, fog_start, fog_end)
        }
    }
    if (*g).stm_on {
        stream_world(g, w, cam, cfg)
    } else {
        mc_render_world.wr_render(&(*g).wr, w, r, cam, 0 - 1)
    }
    if (post & PF_SKY) != 0 as u32 {
        mc_sky.sky_tint_frame(sky, r)
    }
    var hit: bool = false
    if (post & (PF_BOX | PF_HUD)) != 0 as u32 {
        hit = mc_input.input_pick_camera(w, (*cfg).min_y, itb, cam, (*cfg).reach as f64, pk)
    }
    if (post & PF_BOX) != 0 as u32 && hit {
        mc_input.input_draw_box(r, (*pk).x, (*pk).y, (*pk).z, BOX_RGBA)
    }
    if (post & PF_HUD) != 0 as u32 {
        var d: mc_hud.HudDebug = mc_hud.hud_debug_new()
        d.fps = fps
        d.x = (*cam).x
        d.y = (*cam).y
        d.z = (*cam).z
        d.yaw = (*cfg).yaw
        d.pitch = (*cfg).pitch
        d.has_block = hit
        if hit {
            d.bx = (*pk).x
            d.by = (*pk).y
            d.bz = (*pk).z
            d.id = (*pk).id
            d.nx = (*pk).nx
            d.ny = (*pk).ny
            d.nz = (*pk).nz
        }
        mc_hud.hud_frame(r, mc_hud.hud_scale((*cfg).w, (*cfg).h), mc_hud.HUD_CROSSHAIR | mc_hud.HUD_HOTBAR | mc_hud.HUD_DEBUG,
            (*cfg).slot, &d)
    }
    return hit
}

// Renders `w` with the camera of `cfg`, writes view.png / view.rgba / view.txt / atlas.bin into `dir`.
// Frame 1 meshes every section (cold cache), frame 2 is the cached frame (must equal frame 1), frame 3 is the final image
// (the HUD shows the measured frame rate there, or MCVIEW_FPS).
fn render(w: *mut mc_world.World, cfg: *mut Cfg, ver: *mut mc_version.Version, dir: u64, g: *mut Gfx) -> i32 {
    if !(*g).ok {
        io.eprint_line("mcview: this version has no block registry")
        return 5
    }
    let far: f64 = ((*cfg).view as f64 + 2.0) * 16.0 * 1.5
    var cam: mc_camera.Camera = mc_camera.camera_new((*cfg).w, (*cfg).h)
    mc_camera.camera_set_pos(&cam, (*cfg).cx, (*cfg).cy, (*cfg).cz)
    mc_camera.camera_set_angles(&cam, (*cfg).yaw, (*cfg).pitch)
    mc_camera.camera_set_lens(&cam, 70.0, 0.05, far)
    mc_camera.camera_update(&cam)

    if want_vk_gfx() && !(*g).vk { let vo: bool = gfx_vk_open(g, (*cfg).w, (*cfg).h) }
    let r: *mut mc_raster.Raster = &(*g).r
    let fog_start: f64 = ((*cfg).view as f64) * 16.0 * 0.5
    let fog_end: f64 = ((*cfg).view as f64) * 16.0 + 8.0
    mc_raster.raster_set_fog(r, (*cfg).fog, fog_start, fog_end, FOG_R, FOG_G, FOG_B)
    let clear: u32 = (255 as u32 << 24 as u32) | (FOG_B << 16 as u32) | (FOG_G << 8 as u32) | FOG_R
    let lod_plan: mc_lod_policy.LodPlan = mc_lod_policy.lod_plan((*cfg).view, env_int("MCVIEW_LOD", mc_lod_policy.LOD_UNSET))
    (*g).full_view = lod_plan.view
    (*g).lod = lod_plan.lod
    if lod_plan.lod > lod_plan.view { (*g).stm_on = true }
    (*g).wr.min_y = (*cfg).min_y
    (*g).wr.dist = (*cfg).view
    mc_render_world.wr_set_flags(&(*g).wr, (*cfg).flags)
    var sky: mc_sky.Sky = mc_sky.sky_new()
    sky.approx = env_flag("MCVIEW_SKY_APPROX", false) // opt-in: <= 1 level off the exact sky (docs/mc/sky.md); default stays bit exact (golden hashes, ref.py)
    mc_sky.sky_set_time(&sky, (*cfg).ticks as i64, (*cfg).rain)
    var pick_reg: mc_registry.Registry = ver.registry_of()
    var itb: mc_input.InputTables = pick_tables(&(*g).tb, &pick_reg)
    var pk: mc_input.Pick = mc_input.Pick { x: 0, y: 0, z: 0, nx: 0, ny: 0, nz: 0, dist: 0.0, id: 0 }

    if (*g).use_res {
        gfx_packs_tick(g, env_int("MCVIEW_PACK_TICK", 0) as i64)
    }
    let t0: u64 = now_ns()
    frame(g, w, &cam, cfg, &sky, &itb, clear, fog_start, fog_end, 0, &pk)
    let t1: u64 = now_ns()
    let st1: mc_render_world.RenderStats = (*g).wr.st
    var h1: rt.Buf = rt.buf_new()
    hex_of(r, &h1)
    // MCVIEW_PACK_RELOAD=1: hot reload between the frames (what the reload key does); the cached frame must still be identical
    if (*g).use_res && env_flag("MCVIEW_PACK_RELOAD", false) {
        gfx_packs_reload(g)
        gfx_packs_tick(g, env_int("MCVIEW_PACK_TICK", 0) as i64)
    }
    frame(g, w, &cam, cfg, &sky, &itb, clear, fog_start, fog_end, 0, &pk)
    let t2: u64 = now_ns()
    var h2: rt.Buf = rt.buf_new()
    hex_of(r, &h2)
    var same: bool = rt.buf_len(&h1) == rt.buf_len(&h2)
    var k: usize = 0
    while same && k < rt.buf_len(&h1) {
        if rt.ld8(rt.buf_ptr(&h1), k) != rt.ld8(rt.buf_ptr(&h2), k) { same = false }
        k = k + 1
    }
    if !same {
        io.eprint_line("mcview: the cached frame differs from the first frame")
        return 6
    }
    let us2: i64 = ((t2 - t1) / 1000 as u64) as i64
    var fps: i32 = (*cfg).fps
    if fps < 0 {
        fps = 0
        if us2 > 0 {
            fps = (1000000 / us2) as i32
        }
    }
    // final image (the third frame only differs from the second one through the frame rate shown by the HUD)
    let t3: u64 = now_ns()
    let hit: bool = frame(g, w, &cam, cfg, &sky, &itb, clear, fog_start, fog_end, fps, &pk)
    let t4: u64 = now_ns()
    var hf: rt.Buf = rt.buf_new()
    hex_of(r, &hf)

    // block tables of every state id that occurs in the world
    let used: u64 = rt.heap_alloc(32768)
    var i: usize = 0
    while i < 32768 {
        rt.st8(used, i, 0 as u8)
        i = i + 1
    }
    var ci: usize = 0
    while ci < mc_world.world_count(w) {
        let ch: *mut mc_chunk.Chunk = mc_world.world_chunk_at(w, ci)
        ci = ci + 1
        var s: usize = 0
        while s < (*ch).nsec {
            mark_palette(&(*mc_chunk.chunk_section(ch, s)).blocks, used)
            s = s + 1
        }
    }

    var txt: rt.Buf = rt.buf_new()
    push_lit(&txt, "mcview 1\nprotocol")
    push_dec(&txt, (*cfg).protocol as i64)
    push_lit(&txt, "\nmin_y")
    push_dec(&txt, (*cfg).min_y as i64)
    push_lit(&txt, "\nsize")
    push_dec(&txt, (*cfg).w as i64)
    push_dec(&txt, (*cfg).h as i64)
    push_lit(&txt, "\ndist")
    push_dec(&txt, (*cfg).view as i64)
    push_lit(&txt, "\nflags")
    push_dec(&txt, (*cfg).flags as i64)
    push_lit(&txt, "\nfog")
    var fo: i64 = 0
    if (*cfg).fog { fo = 1 }
    push_dec(&txt, fo)
    push_f(&txt, fog_start)
    push_f(&txt, fog_end)
    push_hex(&txt, clear as u64)
    push_lit(&txt, "\ncam")
    push_f(&txt, cam.x)
    push_f(&txt, cam.y)
    push_f(&txt, cam.z)
    push_f(&txt, cam.rx)
    push_f(&txt, cam.ry)
    push_f(&txt, cam.rz)
    push_f(&txt, cam.ux)
    push_f(&txt, cam.uy)
    push_f(&txt, cam.uz)
    push_f(&txt, cam.fx)
    push_f(&txt, cam.fy)
    push_f(&txt, cam.fz)
    push_f(&txt, cam.near)
    push_f(&txt, cam.tan_x)
    push_f(&txt, cam.tan_y)
    push_lit(&txt, "\npost")
    push_dec(&txt, (*cfg).post as i64)
    push_dec(&txt, (*cfg).ticks as i64)
    push_dec(&txt, (*cfg).rain as i64)
    push_dec(&txt, (*cfg).reach as i64)
    push_dec(&txt, (*cfg).slot as i64)
    push_hex(&txt, BOX_RGBA as u64)
    if ((*cfg).post & (PF_BOX | PF_HUD)) != 0 as u32 {
        var hi: i64 = 0
        if hit { hi = 1 }
        push_lit(&txt, "\npick")
        push_dec(&txt, hi)
        push_dec(&txt, pk.x as i64)
        push_dec(&txt, pk.y as i64)
        push_dec(&txt, pk.z as i64)
        push_dec(&txt, pk.nx as i64)
        push_dec(&txt, pk.ny as i64)
        push_dec(&txt, pk.nz as i64)
        push_dec(&txt, pk.id as i64)
    }
    push_lit(&txt, "\ndbg")
    push_dec(&txt, fps as i64)
    push_f(&txt, cam.x)
    push_f(&txt, cam.y)
    push_f(&txt, cam.z)
    push_f(&txt, (*cfg).yaw)
    push_f(&txt, (*cfg).pitch)
    push_lit(&txt, "\nhash ")
    rt.buf_push_bytes(&txt, rt.buf_ptr(&hf), rt.buf_len(&hf))
    rt.buf_push(&txt, 10 as u8)
    var nstates: i64 = 0
    i = 0
    while i < 32768 {
        if rt.ld8(used, i) != 0 as u8 {
            push_lit(&txt, "T")
            push_dec(&txt, i as i64)
            push_dec(&txt, rt.ld8((*g).tb.opaque, i) as i64)
            var f: usize = 0
            while f < 6 {
                push_dec(&txt, rt.ld16((*g).tb.tiles, i * 6 + f) as i64)
                f = f + 1
            }
            rt.buf_push(&txt, 10 as u8)
            nstates = nstates + 1
        }
        i = i + 1
    }
    var m: rt.Buf = rt.buf_new()
    let us1: i64 = ((t1 - t0) / 1000 as u64) as i64
    let us4: i64 = ((t4 - t3) / 1000 as u64) as i64
    metric(&m, "frame_cold_ms", us1 / 1000)
    metric(&m, "frame_cached_ms", us2 / 1000)
    metric(&m, "frame_cached_us", us2)
    metric(&m, "frame_final_us", us4)
    metric(&m, "chunks_rendered", st1.chunks as i64)
    metric(&m, "chunks_far", st1.far_chunks as i64)
    metric(&m, "sections_tested", st1.sections as i64)
    metric(&m, "sections_culled", st1.culled as i64)
    metric(&m, "sections_meshed", st1.meshed as i64)
    metric(&m, "sections_drawn", st1.drawn as i64)
    metric(&m, "triangles", st1.tris as i64)
    metric(&m, "pixels_written", (*r).st.pixels as i64)
    var cps: i64 = 0
    var sps: i64 = 0
    if us1 > 0 {
        cps = (st1.chunks as i64) * 1000000 / us1
        sps = (st1.meshed as i64) * 1000000 / us1
    }
    metric(&m, "chunks_per_s", cps)
    metric(&m, "sections_meshed_per_s", sps)
    metric(&m, "world_chunks", mc_world.world_count(w) as i64)
    metric(&m, "state_ids", nstates)
    rt.buf_push_bytes(&txt, rt.buf_ptr(&m), rt.buf_len(&m))

    var ok: bool = write_to(dir, "view.txt", rt.buf_ptr(&txt), rt.buf_len(&txt))
    var ap: *mut mc_texture.Atlas = &(*g).atlas
    if (*g).use_res { ap = &(*g).res.atlas }
    ok = write_to(dir, "atlas.bin", (*ap).px, ((*ap).w as usize) * ((*ap).h as usize) * 4) && ok
    ok = write_to(dir, "view.rgba", mc_raster.backend_present(r), ((*cfg).w as usize) * ((*cfg).h as usize) * 4) && ok
    var pp: rt.Buf = rt.buf_new()
    path_of(&pp, dir, "view.png")
    ok = mc_raster.raster_write_png(r, rt.buf_ptr(&pp)) && ok
    if !ok {
        io.eprint_line("mcview: cannot write the output files")
        return 7
    }
    say(f"metric hash=")
    io.print_bytes(rt.buf_ptr(&hf), rt.buf_len(&hf))
    say(f"\n")
    io.print_bytes(rt.buf_ptr(&m), rt.buf_len(&m))
    return 0
}

// ---- network (live mode) ---------------------------------------------------------------------------

struct Stats {
    t_first: u64,
    t_last: u64,
    chunks: u64,
    bad: u64,
    join: bool,
    unloads: u64,
    dim: mc_dimension.Dimension,
}

fn on_map_chunk(cl: *mut mc_client.Client, sc: *mut mc_chunk.Scratch, w: *mut mc_world.World, st: *mut Stats) {
    let p: u64 = mc_chunk.chunk_alloc()
    if p == 0 {
        (*st).bad = (*st).bad + 1 as u64
        return
    }
    let c: *mut mc_chunk.Chunk = p as *mut mc_chunk.Chunk
    let ok: bool = mc_chunk.chunk_decode_for(&(*cl).ver, mc_client.client_body(cl), sc, c, mc_dimension.dim_sections(&(*st).dim)) catch false
    if !ok || (*c).ground_up == 0 || !mc_world.world_put(w, p) {
        mc_chunk.chunk_release(p)
        (*st).bad = (*st).bad + 1 as u64
        return
    }
    let t: u64 = now_ms()
    if (*st).chunks == 0 as u64 {
        (*st).t_first = t
    }
    (*st).t_last = t
    (*st).chunks = (*st).chunks + 1 as u64
}

// Unload Chunk: two i32 -- x then z up to 1.20.1 (protocol 763), z then x from 1.20.2 (protocol 764); minecraft-data, checked for
// 1.12.2 / 1.20.2 / 1.21.4. The column leaves the world and its cached section meshes are freed.
fn on_unload(cl: *mut mc_client.Client, w: *mut mc_world.World, st: *mut Stats, g: *mut Gfx) {
    let b: *mut bytes.Bytes = mc_client.client_body(cl)
    let first: i32 = bytes.get_i32(b) catch 0
    let second: i32 = bytes.get_i32(b) catch 0
    var cx: i32 = first
    var cz: i32 = second
    if (*cl).ver.protocol >= 764 {
        cx = second
        cz = first
    }
    mc_render_world.wr_drop_chunk(&(*g).wr, &(*g).r, cx, cz)
    if mc_world.world_remove(w, cx, cz) {
        (*st).unloads = (*st).unloads + 1 as u64
    }
}

// Plays until no new chunk arrived for `settle_ms` (after the first one).
fn play_loop(cl: *mut mc_client.Client, sc: *mut mc_chunk.Scratch, w: *mut mc_world.World, st: *mut Stats, settle_ms: u64, view: i32,
    g: *mut Gfx) -> i32 {
    let deadline: u64 = now_ms() + PLAY_TIMEOUT_MS
    var result: i32 = 0 - 100
    var running: bool = true
    while running {
        let now: u64 = now_ms()
        if now > deadline {
            result = 0 - 1
            running = false
        } else if (*st).chunks > 0 as u64 && now - (*st).t_last >= settle_ms {
            result = 0
            running = false
        } else {
            let id: i32 = mc_client.client_next(cl)
            if id == mc_client.CL_TIMEOUT {
            } else if id < 0 {
                result = id
                running = false
            } else if mc_client.client_auto_reply(cl, id) {
            } else if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_JOIN_GAME) {
                if !(*st).join {
                    (*st).join = true
                    mc_dimension.dim_from_join(&(*cl).ver, id, mc_client.client_body(cl), &(*st).dim)
                    (*g).wr.min_y = (*st).dim.min_y
                    mc_client.client_send_settings(cl, view)
                }
            } else if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_MAP_CHUNK) {
                on_map_chunk(cl, sc, w, st)
            } else if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_UNLOAD_CHUNK) {
                on_unload(cl, w, st, g)
            } else if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_KICK_DISCONNECT) {
                result = 0 - 2
                running = false
            }
        }
    }
    return result
}

fn finish_cfg(cfg: *mut Cfg, post: u32) {
    (*cfg).post = post
    (*cfg).ticks = env_int("MCVIEW_TICKS", DEFAULT_TICKS)
    (*cfg).rain = env_int("MCVIEW_RAIN", 0)
    (*cfg).fps = env_int("MCVIEW_FPS", 0 - 1)
    (*cfg).reach = env_int("MCVIEW_REACH", DEFAULT_REACH)
    (*cfg).slot = env_int("MCVIEW_SLOT", 0)
    (*cfg).flags = mc_mesh.F_AO | mc_mesh.F_CULL_SAME
    if env_flag("MCVIEW_GREEDY", false) {
        (*cfg).flags = (*cfg).flags | mc_mesh.F_GREEDY
    }
    (*cfg).fog = env_flag("MCVIEW_FOG", true)
    (*cfg).w = env_int("MCVIEW_W", 640)
    (*cfg).h = env_int("MCVIEW_H", 360)
}

#[allow_escape]
fn main_replay(start: u64) -> i32 {
    let post: u32 = post_flags(start)
    if argn(start) < 4 || (post & PF_BAD) != 0 as u32 {
        io.eprint_line("usage: mcview [--sky] [--box] [--hud] [--all] [--pack=a.zip,b.zip] --replay <out-dir> <world-file> [yaw] [pitch]")
        return 2
    }
    let dir: u64 = argp(start, 2)
    let wpath: u64 = argp(start, 3)
    var blob: rt.Buf = rt.buf_new()
    if !rt.read_file(wpath, &blob) {
        io.eprint_line("mcview: cannot read the world file")
        return 3
    }
    var cfg: Cfg = Cfg { protocol: 0, min_y: 0, view: 0, w: 640, h: 360, flags: 0 as u32, fog: true,
        cx: 0.0, cy: 0.0, cz: 0.0, yaw: 0.0, pitch: 0.0, post: 0 as u32, ticks: 0, rain: 0, fps: 0 - 1, reach: 0, slot: 0 }
    var world: mc_world.World = mc_world.world_new()
    if !world_parse(rt.buf_ptr(&blob), rt.buf_len(&blob), &world, &cfg) {
        io.eprint_line("mcview: bad world file")
        return 4
    }
    if argn(start) > 4 {
        let p: u64 = argp(start, 4)
        cfg.yaw = parse_dec(p, rt.c_length(p), cfg.yaw as i64) as f64
    }
    if argn(start) > 5 {
        let p: u64 = argp(start, 5)
        cfg.pitch = parse_dec(p, rt.c_length(p), cfg.pitch as i64) as f64
    }
    finish_cfg(&cfg, post)
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(cfg.protocol, &ver) {
        io.eprint_line("mcview: no tables for that protocol number")
        return 2
    }
    let pf: u64 = pack_flag(start)
    let use_res: bool = pf != 0 || mc_packs.res_env_wanted()
    var g: Gfx = gfx_new(cfg.w, cfg.h, &ver, cfg.min_y, cfg.view, use_res)
    if use_res { gfx_packs_load(&g, cfg.protocol, pf) }
    let rc: i32 = render(&world, &cfg, &ver, dir, &g)
    stream_end(&g)
    gfx_vk_close(&g)
    mc_render_world.wr_free(&g.wr, &g.r)
    mc_world.world_free(&world)
    return rc
}

fn metric_net(t0: u64, t_login: u64, t_play: u64, st: *mut Stats, wt: *mut rt.Buf) {
    say(f"metric login_ms={t_login - t0}\n")
    say(f"metric first_chunk_ms={(*st).t_first - t0}\n")
    say(f"metric settled_ms={t_play - t0}\n")
    say(f"metric chunk_packets={(*st).chunks}\n")
    say(f"metric chunk_bad={(*st).bad}\n")
    say(f"metric chunk_unloads={(*st).unloads}\n")
    say(f"metric world_file_bytes={rt.buf_len(wt)}\n")
}

#[allow_escape]
fn main(start: u64) -> i32 {
    if argn(start) > 1 {
        let a1: u64 = argp(start, 1)
        if c_eq(a1, "--replay") {
            return main_replay(start)
        }
    }
    let post: u32 = post_flags(start)
    if argn(start) < 5 || (post & PF_BAD) != 0 as u32 {
        io.eprint_line("usage: mcview [--sky] [--box] [--hud] [--all] [--pack=a.zip,b.zip] <host> <port> <name> <out-dir> [view=6] [settle-ms=3000] [yaw=0] [pitch=20] [protocol=763] [up=2]")
        io.eprint_line("       mcview [flags] --replay <out-dir> <world-file> [yaw] [pitch]")
        return 2
    }
    let host: u64 = argp(start, 1)
    let pp: u64 = argp(start, 2)
    let name: u64 = argp(start, 3)
    let dir: u64 = argp(start, 4)
    var view: i32 = DEFAULT_VIEW
    var settle: u64 = DEFAULT_SETTLE_MS
    var yaw: i64 = 0
    var pitch: i64 = 20
    var proto: i32 = DEFAULT_PROTOCOL
    var up: i64 = 2
    if argn(start) > 5 {
        let p: u64 = argp(start, 5)
        view = parse_dec(p, rt.c_length(p), DEFAULT_VIEW as i64) as i32
    }
    if argn(start) > 6 {
        let p: u64 = argp(start, 6)
        settle = parse_dec(p, rt.c_length(p), DEFAULT_SETTLE_MS as i64) as u64
    }
    if argn(start) > 7 {
        let p: u64 = argp(start, 7)
        yaw = parse_dec(p, rt.c_length(p), 0)
    }
    if argn(start) > 8 {
        let p: u64 = argp(start, 8)
        pitch = parse_dec(p, rt.c_length(p), 20)
    }
    if argn(start) > 9 {
        let p: u64 = argp(start, 9)
        proto = parse_dec(p, rt.c_length(p), DEFAULT_PROTOCOL as i64) as i32
    }
    if argn(start) > 10 {
        let p: u64 = argp(start, 10)
        up = parse_dec(p, rt.c_length(p), 2)
    }
    let port: i64 = parse_dec(pp, rt.c_length(pp), 0 - 1)
    if !mc_hostname.host_valid(host, rt.c_length(host)) || port <= 0 || port > 65535 {
        io.eprint_line("mcview: bad host or port")
        return 2
    }
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(proto, &ver) || ver.chunk_format == mc_version.CF_LEGACY_8 {
        io.eprint_line("mcview: unsupported protocol number")
        return 2
    }
    var winner: usize = 0
    var conn: net.Conn = mc_connect.connect_host(host, rt.c_length(host), port as u16, &winner)
    if !net.conn_is_open(&conn) {
        io.eprint_line("mcview: connect failed")
        return 3
    }
    net.set_no_delay(&conn, true) catch false
    var cfg0: Cfg = Cfg { protocol: proto, min_y: 0, view: view, w: 640, h: 360, flags: 0 as u32, fog: true,
        cx: 0.0, cy: 0.0, cz: 0.0, yaw: 0.0, pitch: 0.0, post: 0 as u32, ticks: 0, rain: 0, fps: 0 - 1, reach: 0, slot: 0 }
    finish_cfg(&cfg0, post)
    let pf: u64 = pack_flag(start)
    let use_res: bool = pf != 0 || mc_packs.res_env_wanted()
    var g: Gfx = gfx_new(cfg0.w, cfg0.h, &ver, 0, view, use_res)
    if use_res { gfx_packs_load(&g, proto, pf) }
    var cl: mc_client.Client = mc_client.client_new(conn, ver)
    var world: mc_world.World = mc_world.world_new()
    var sc: mc_chunk.Scratch = mc_chunk.scratch_new()
    var st: Stats = Stats { t_first: 0, t_last: 0, chunks: 0, bad: 0, join: false, unloads: 0, dim: mc_dimension.dim_default_overworld() }
    mc_codec.wire_timeout(&cl.w, 100)
    let t0: u64 = now_ms()
    if !mc_client.client_handshake(&cl, host, port as u16, 2) {
        io.eprint_line("mcview: could not send the handshake")
        return 4
    }
    let lr: i32 = mc_client.client_login_offline(&cl, name, LOGIN_WAITS)
    if lr != 0 {
        say(f"mcview: login failed ({lr})\n")
        return 5
    }
    let t_login: u64 = now_ms()
    let pr: i32 = play_loop(&cl, &sc, &world, &st, settle, view, &g)
    let t_play: u64 = now_ms()
    var px: f64 = 0.0
    var py: f64 = 0.0
    var pz: f64 = 0.0
    let have_pos: bool = mc_client.client_position(&cl, &px, &py, &pz)
    var rc: i32 = 0
    if pr != 0 || st.chunks == 0 as u64 {
        say(f"mcview: play ended with {pr}, chunks {st.chunks}\n")
        rc = 6
    } else if !have_pos {
        io.eprint_line("mcview: the server never sent a player position")
        rc = 6
    }
    if rc == 0 {
        var cfg: Cfg = Cfg { protocol: proto, min_y: st.dim.min_y, view: view, w: 640, h: 360, flags: 0 as u32, fog: true,
            cx: px, cy: py + 1.62 + (up as f64), cz: pz, yaw: yaw as f64, pitch: pitch as f64,
            post: 0 as u32, ticks: 0, rain: 0, fps: 0 - 1, reach: 0, slot: 0 }
        finish_cfg(&cfg, post)
        var wt: rt.Buf = rt.buf_new()
        world_text(&world, &cfg, &wt)
        if !write_to(dir, "world.mcw", rt.buf_ptr(&wt), rt.buf_len(&wt)) {
            io.eprint_line("mcview: cannot write world.mcw")
            rc = 7
        }
        metric_net(t0, t_login, t_play, &st, &wt)
        if rc == 0 {
            rc = render(&world, &cfg, &ver, dir, &g)
        }
        rt.buf_free(&wt)
    }
    stream_end(&g)
    gfx_vk_close(&g)
    mc_render_world.wr_free(&g.wr, &g.r)
    mc_world.world_free(&world)
    mc_chunk.scratch_free(&sc)
    mc_client.client_free(&cl)
    return rc
}
