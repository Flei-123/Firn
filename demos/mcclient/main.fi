// demos/mcclient/main.fi -- a Minecraft Java client without graphics: the FINAL INTEGRATION
// TEST of the libraries in lib/mc (milestone M0).
//
//     mcclient <host-ipv4> <port> <name> <dump-file> [view=4] [idle-ms=2500] [protocol=763]
//
// It joins a real server in OFFLINE mode, decodes every Play packet with the generic schema
// walker, turns the chunk columns into palette sections and writes a world dump with a
// SHA-256 checksum (format: demos/mcclient/DESIGN.md). The program itself is thin glue:
//
//   mc_versions / mc_version   the version object chosen by the protocol number
//   mc_client                  handshake, login (+ configuration phase), keep-alive, teleports
//   mc_codec                   framing, compression, (encryption)
//   mc_schema                  every received Play packet is walked against its generated schema
//   mc_chunk / mc_world        palette sections, chunk store
//   dump.fi                    the canonical dump (test artefact)
//
// ONLINE mode (env): MC_ONLINE=1 logs in with a Microsoft/Minecraft account instead of the offline
// name: MC_ACCOUNT_FILE=<path> (chmod 600, outside any repo; lines `mc_token=...`, `uuid=<32 hex>`,
// `name=...`; the file's name is the login name), MC_SESSION_BASE=<url> (optional, default
// https://sessionserver.mojang.com; plain http only for loopback test mocks). The token is read
// from the file only, never printed, and wiped from memory at the end; errors name the failing
// step without any token value.
//
// Nothing in this file names a packet id or a protocol number except the command line default.

import std.net
import std.bytes
import std.rt
import std.io
import std.env
import mc.mc_auth
import mc.mc_crypto
import mc.mc_codec
import mc.mc_chunk
import mc.mc_world
import mc.mc_client
import mc.mc_dimension
import mc.mc_entity
import mc.mc_schema
import mc.mc_sem
import mc.mc_version
import mc.mc_versions
import dump

const DEFAULT_VIEW: i32 = 4
const DEFAULT_IDLE_MS: u64 = 2500
const DEFAULT_PROTOCOL: i32 = 763
const LOGIN_WAITS: i32 = 200 // x 100 ms receive timeout = 20 s
const PLAY_TIMEOUT_MS: u64 = 90000

const SYS_CLOCK_GETTIME: i64 = 228
const CLOCK_MONOTONIC: i64 = 1

fn now_ms() -> u64 {
    var ts: [i64; 2] = [0; 2]
    syscall(SYS_CLOCK_GETTIME, CLOCK_MONOTONIC, (&ts[0]) as i64, 0, 0, 0, 0)
    return (ts[0] as u64) * 1000 as u64 + (ts[1] as u64) / 1000000 as u64
}

fn parse_dec(p: u64, n: usize, fallback: i64) -> i64 {
    if n == 0 {
        return fallback
    }
    var v: i64 = 0
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c < 48 as u8 || c > 57 as u8 {
            return fallback
        }
        v = v * 10 + (c - 48 as u8) as i64
        i = i + 1
    }
    return v
}

// "a.b.c.d" -> host order u32; 0 on failure (0.0.0.0 is not a valid target)
fn parse_ipv4(p: u64) -> u32 {
    let n: usize = rt.c_length(p)
    var parts: [i64; 4] = [0; 4]
    var k: usize = 0
    var cur: i64 = 0
    var digits: usize = 0
    var i: usize = 0
    while i <= n {
        var c: u8 = 46 as u8
        if i < n {
            c = rt.ld8(p, i)
        }
        if c == 46 as u8 {
            if digits == 0 || k >= 4 || cur > 255 {
                return 0 as u32
            }
            parts[k] = cur
            k = k + 1
            cur = 0
            digits = 0
        } else if c >= 48 as u8 && c <= 57 as u8 {
            cur = cur * 10 + (c - 48 as u8) as i64
            digits = digits + 1
        } else {
            return 0 as u32
        }
        i = i + 1
    }
    if k != 4 {
        return 0 as u32
    }
    return net.ipv4(parts[0] as u8, parts[1] as u8, parts[2] as u8, parts[3] as u8)
}

// t - t0, or -1 when the event never happened (t == 0)
fn rel(t: u64, t0: u64) -> i64 {
    if t == 0 as u64 {
        return 0 - 1
    }
    return (t - t0) as i64
}

fn say(f: io.Fmt) {
    io.fmt_print(f)
}

// ---- online account (MC_ONLINE=1) ------------------------------------------------

// Value of the line `key=value` of the blob [p, n) into `out` (without the line end); false if absent.
fn file_value(p: u64, n: usize, key: str, out: *mut rt.Buf) -> bool {
    var i: usize = 0
    while i < n {
        var e: usize = i
        while e < n && rt.ld8(p, e) != 10 as u8 {
            e = e + 1
        }
        let kn: usize = key.length()
        if e - i > kn && rt.ld8(p, i + kn) == 61 as u8 {
            var same: bool = true
            var k: usize = 0
            while k < kn && same {
                if rt.ld8(p, i + k) != key.chars(k) {
                    same = false
                }
                k = k + 1
            }
            if same {
                var end: usize = e
                if end > i && rt.ld8(p, end - 1) == 13 as u8 {
                    end = end - 1
                }
                rt.buf_push_bytes(out, p + (i + kn + 1) as u64, end - i - kn - 1)
                return true
            }
        }
        i = e + 1
    }
    return false
}

fn wipe_buf(b: *mut rt.Buf) {
    let p: u64 = rt.buf_ptr(b)
    var i: usize = 0
    while i < (*b).cap {
        rt.st8(p, i, 0 as u8)
        i = i + 1
    }
}

fn describe_failure(cl: *mut mc_client.Client, lr: i32, sess: *mut mc_auth.SessionClient) {
    say(f"mcclient: login failed at step: {mc_client.client_error_text(lr)} (code {lr})\n")
    if lr == mc_client.CL_SESSION {
        let jc: i64 = mc_client.client_detail(cl)
        say(f"mcclient: session_join result={mc_auth.join_error_text(jc)} http_status={mc_auth.session_status(sess)} net_error={mc_auth.session_net_error(sess)}\n")
        say(f"mcclient: session server says: {mc_auth.session_error(sess)} / {mc_auth.session_error_message(sess)}\n")
    } else if lr == mc_client.CL_RSA {
        say(f"mcclient: rsa/key error: {mc_crypto.error_name(mc_client.client_detail(cl) as i32)}\n")
    } else if lr == mc_client.CL_KICKED {
        var why: rt.Buf = rt.buf_new()
        if mc_client.client_kick_text(cl, &why) {
            rt.buf_push(&why, 0 as u8)
            say(f"mcclient: server disconnect text: ")
            io.print_bytes(rt.buf_ptr(&why), rt.buf_len(&why) - 1)
            say(f"\n")
        }
        rt.buf_free(&why)
    }
}

struct Stats {
    t_first_chunk: u64,
    t_last_chunk: u64,
    t_join: u64,
    t_last_packet: u64,
    chunks: u64,
    unloads: u64,
    walk_ok: u64,
    walk_fail: u64,
    chunk_bad: u64,
    partial: u64, // section-only updates (groundUp = false) that were not stored
    kicked: bool,
    dim: mc_dimension.Dimension, // from the Join Game packet (default: overworld)
    dim_known: bool,
}

// Stores one decoded column (or counts it as bad / partial). Takes ownership of `p`.
fn store_chunk(w: *mut mc_world.World, st: *mut Stats, p: u64, ok: bool) {
    let c: *mut mc_chunk.Chunk = p as *mut mc_chunk.Chunk
    if ok && (*c).ground_up == 0 {
        // a legacy section update must be MERGED into its column; this client keeps whole columns only
        mc_chunk.chunk_release(p)
        (*st).partial = (*st).partial + 1 as u64
        return
    }
    if !ok || !mc_world.world_put(w, p) {
        mc_chunk.chunk_release(p)
        (*st).chunk_bad = (*st).chunk_bad + 1 as u64
        return
    }
    let t: u64 = now_ms()
    if (*st).chunks == 0 as u64 {
        (*st).t_first_chunk = t
    }
    (*st).t_last_chunk = t
    (*st).chunks = (*st).chunks + 1 as u64
}

fn on_map_chunk(cl: *mut mc_client.Client, sc: *mut mc_chunk.Scratch, w: *mut mc_world.World, st: *mut Stats) {
    let p: u64 = mc_chunk.chunk_alloc()
    if p == 0 {
        (*st).chunk_bad = (*st).chunk_bad + 1 as u64
        return
    }
    let c: *mut mc_chunk.Chunk = p as *mut mc_chunk.Chunk
    let ok: bool = mc_chunk.chunk_decode_for(&(*cl).ver, mc_client.client_body(cl), sc, c, mc_dimension.dim_sections(&(*st).dim)) catch false
    if ok && (*cl).ver.chunk_format == mc_version.CF_LEGACY_8 && mc_chunk.chunk_is_unload_legacy8(c) {
        // 1.8 has no unload packet: an empty ground-up column removes the chunk
        mc_world.world_remove(w, (*c).x, (*c).z)
        mc_chunk.chunk_release(p)
        (*st).unloads = (*st).unloads + 1 as u64
        return
    }
    store_chunk(w, st, p, ok)
}

// 1.8 map_chunk_bulk: several columns in one packet
fn on_map_chunk_bulk(cl: *mut mc_client.Client, sc: *mut mc_chunk.Scratch, w: *mut mc_world.World, st: *mut Stats) {
    var h: mc_chunk.Legacy8Bulk = mc_chunk.Legacy8Bulk { sky: false, n: 0, next: 0, meta: 0 }
    let b: *mut bytes.Bytes = mc_client.client_body(cl)
    if !(mc_chunk.legacy8_bulk_open(b, &h) catch false) {
        (*st).chunk_bad = (*st).chunk_bad + 1 as u64
        mc_chunk.legacy8_bulk_free(&h)
        return
    }
    var i: usize = 0
    while i < h.n {
        let p: u64 = mc_chunk.chunk_alloc()
        if p == 0 {
            (*st).chunk_bad = (*st).chunk_bad + 1 as u64
            mc_chunk.legacy8_bulk_free(&h)
            return
        }
        let ok: bool = mc_chunk.legacy8_bulk_next(b, &h, sc, p as *mut mc_chunk.Chunk) catch false
        store_chunk(w, st, p, ok)
        if !ok {
            mc_chunk.legacy8_bulk_free(&h)
            return // the cursor is lost after a bad column
        }
        i = i + 1
    }
    if !mc_chunk.legacy8_bulk_complete(b, &h) {
        (*st).chunk_bad = (*st).chunk_bad + 1 as u64
    }
    mc_chunk.legacy8_bulk_free(&h)
}

// CF_SECTIONS_19 / CF_LEGACY_8: the sky light arrays exist only in the overworld; Join Game and Respawn say which dimension.
fn set_sky_from_dimension(cl: *mut mc_client.Client, sc: *mut mc_chunk.Scratch, id: i32) {
    if (*cl).ver.chunk_format != mc_version.CF_SECTIONS_19 && (*cl).ver.chunk_format != mc_version.CF_LEGACY_8 {
        return
    }
    let d: i32 = mc_dimension.dim_legacy_id(&(*cl).ver, id, mc_client.client_body(cl))
    if d != 0 - 2 {
        mc_chunk.scratch_set_sky(sc, d == 0)
    }
}

// Returns 0 when it ended by the idle rule (all chunks in), negative otherwise.
fn play_loop(cl: *mut mc_client.Client, sc: *mut mc_chunk.Scratch, w: *mut mc_world.World, es: *mut mc_entity.Store, st: *mut Stats, idle_ms: u64, view: i32) -> i32 {
    let deadline: u64 = now_ms() + PLAY_TIMEOUT_MS
    var result: i32 = 0 - 100
    var running: bool = true
    while running {
        let now: u64 = now_ms()
        if now > deadline {
            result = 0 - 1
            running = false
        } else if (*st).chunks > 0 as u64 && now - (*st).t_last_chunk >= idle_ms {
            result = 0
            running = false
        } else {
            let id: i32 = mc_client.client_next(cl)
            if id == mc_client.CL_TIMEOUT {
                // nothing yet
            } else if id < 0 {
                result = id
                running = false
            } else {
                (*st).t_last_packet = now_ms()
                // 1. the generic schema walk over EVERY packet
                let sch: u64 = (*cl).ver.schema_of(mc_version.ST_PLAY, mc_version.DIR_S2C, id)
                if sch != 0 {
                    let body: *mut bytes.Bytes = mc_client.client_body(cl)
                    let p0: usize = bytes.bytes_pos(body)
                    if mc_schema.walk(sch, body, 0 as *mut rt.Buf) {
                        (*st).walk_ok = (*st).walk_ok + 1 as u64
                    } else {
                        (*st).walk_fail = (*st).walk_fail + 1 as u64
                        if (*st).walk_fail <= 5 as u64 {
                            say(f"walk FAIL id={id}\n")
                        }
                    }
                    bytes.bytes_set_pos(body, p0)
                }
                // 1b. entity tracking (spawn / move / teleport / destroy / player info); the cursor is put back
                mc_entity.entity_on_packet(es, &(*cl).ver, id, mc_client.client_body(cl))
                // 2. the packets this client acts on
                if mc_client.client_auto_reply(cl, id) {
                    // keep alive / teleport / chunk batch answered
                } else if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_JOIN_GAME) {
                    if (*st).t_join == 0 as u64 {
                        (*st).t_join = now_ms()
                        (*st).dim_known = mc_dimension.dim_from_join(&(*cl).ver, id, mc_client.client_body(cl), &(*st).dim)
                        set_sky_from_dimension(cl, sc, id)
                        // Client Information goes out only NOW: sent right after Login Success
                        // (before the first Play packet is read) the vanilla 1.20.1 server drops
                        // the connection with a DecoderException (measured, docs/mc/client.md).
                        mc_client.client_send_settings(cl, view)
                    }
                } else if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_RESPAWN) {
                    set_sky_from_dimension(cl, sc, id)
                } else if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_MAP_CHUNK) {
                    on_map_chunk(cl, sc, w, st)
                } else if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_MAP_CHUNK_BULK) {
                    on_map_chunk_bulk(cl, sc, w, st)
                } else if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_UNLOAD_CHUNK) {
                    (*st).unloads = (*st).unloads + 1 as u64
                } else if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_KICK_DISCONNECT) {
                    (*st).kicked = true
                    result = 0 - 2
                    running = false
                }
            }
        }
    }
    return result
}

fn main(start: u64) -> i32 {
    let t0: u64 = now_ms()
    if rt.arg_count(start) < 5 {
        io.eprint_line("usage: mcclient <host-ipv4> <port> <name> <dump-file> [view=4] [idle-ms=2500] [protocol=763]")
        return 2
    }
    let host: u64 = rt.arg_ptr(start, 1)
    let pp: u64 = rt.arg_ptr(start, 2)
    let name: u64 = rt.arg_ptr(start, 3)
    let out_path: u64 = rt.arg_ptr(start, 4)
    var view: i32 = DEFAULT_VIEW
    var idle_ms: u64 = DEFAULT_IDLE_MS
    var proto: i32 = DEFAULT_PROTOCOL
    if rt.arg_count(start) > 5 {
        let p: u64 = rt.arg_ptr(start, 5)
        view = parse_dec(p, rt.c_length(p), DEFAULT_VIEW as i64) as i32
    }
    if rt.arg_count(start) > 6 {
        let p: u64 = rt.arg_ptr(start, 6)
        idle_ms = parse_dec(p, rt.c_length(p), DEFAULT_IDLE_MS as i64) as u64
    }
    if rt.arg_count(start) > 7 {
        let p: u64 = rt.arg_ptr(start, 7)
        proto = parse_dec(p, rt.c_length(p), DEFAULT_PROTOCOL as i64) as i32
    }
    let port: i64 = parse_dec(pp, rt.c_length(pp), 0 - 1)
    let addr: u32 = parse_ipv4(host)
    if addr == 0 as u32 || port <= 0 || port > 65535 {
        io.eprint_line("mcclient: bad host or port (IPv4 literal expected)")
        return 2
    }
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(proto, &ver) {
        io.eprint_line("mcclient: this build has no tables for that protocol number")
        return 2
    }

    var conn: net.Conn = net.connect_tcp(addr, port as u16) catch net.conn_from_fd(0 - 1)
    if !net.conn_is_open(&conn) {
        io.eprint_line("mcclient: connect failed")
        return 3
    }
    let t_conn: u64 = now_ms()
    net.set_no_delay(&conn, true) catch false

    var cl: mc_client.Client = mc_client.client_new(conn, ver)
    var world: mc_world.World = mc_world.world_new()
    var sc: mc_chunk.Scratch = mc_chunk.scratch_new()
    var ents: mc_entity.Store = mc_entity.store_new()
    var st: Stats = Stats { t_first_chunk: 0, t_last_chunk: 0, t_join: 0, t_last_packet: 0, chunks: 0, unloads: 0,
        walk_ok: 0, walk_fail: 0, chunk_bad: 0, partial: 0, kicked: false, dim: mc_dimension.dim_default_overworld(), dim_known: false }
    mc_codec.wire_timeout(&cl.w, 100)

    // ---- online account (optional)
    var online: bool = false
    var acct_blob: rt.Buf = rt.buf_new()
    var tok: rt.Buf = rt.buf_new()
    var acct_name: rt.Buf = rt.buf_new()
    var base_buf: rt.Buf = rt.buf_new()
    var sess: mc_auth.SessionClient = mc_auth.session_new()
    var acct: mc_client.OnlineAccount = mc_client.account_new("", &sess)
    var login_name: u64 = name
    var rc: i32 = 0
    if env.has("MC_ONLINE") && env.get("MC_ONLINE").length() == 1 && env.get("MC_ONLINE").chars(0) == 49 as u8 {
        online = true
        var path: rt.Buf = rt.buf_new()
        var fail: str = ""
        if !env.get_into("MC_ACCOUNT_FILE", &path) {
            fail = "MC_ONLINE=1 needs MC_ACCOUNT_FILE"
        } else {
            rt.buf_push(&path, 0 as u8)
            if !rt.read_file(rt.buf_ptr(&path), &acct_blob) {
                fail = "cannot read MC_ACCOUNT_FILE"
            }
        }
        rt.buf_free(&path)
        var uuid_txt: rt.Buf = rt.buf_new()
        if fail.length() == 0 {
            let bp: u64 = rt.buf_ptr(&acct_blob)
            let bn: usize = rt.buf_len(&acct_blob)
            if !file_value(bp, bn, "mc_token", &tok) || rt.buf_len(&tok) == 0 {
                fail = "account file has no mc_token line"
            } else if !file_value(bp, bn, "uuid", &uuid_txt) || !mc_auth.uuid_from_text(rt.buf_ptr(&uuid_txt), rt.buf_len(&uuid_txt), (&acct.uuid[0]) as u64) {
                fail = "account file has no valid uuid line"
            } else if !file_value(bp, bn, "name", &acct_name) || rt.buf_len(&acct_name) == 0 {
                fail = "account file has no name line"
            }
        }
        wipe_buf(&acct_blob)
        rt.buf_free(&acct_blob)
        rt.buf_free(&uuid_txt)
        if fail.length() == 0 && !mc_auth.session_init(&sess) {
            fail = "cannot initialise the session client (TLS)"
        }
        if fail.length() > 0 {
            say(f"mcclient: online login setup failed: {fail}\n")
            rc = 8
        } else {
            mc_auth.session_set_system_trust(&sess, true)
            if env.get_into("MC_SESSION_BASE", &base_buf) && rt.buf_len(&base_buf) > 0 {
                mc_auth.session_set_base(&sess, str { p: rt.buf_data(&base_buf), n: base_buf.len })
            }
            acct.token = str { p: rt.buf_data(&tok), n: tok.len }
            rt.buf_push(&acct_name, 0 as u8)
            login_name = rt.buf_ptr(&acct_name)
        }
    }
    if rc == 0 && !mc_client.client_handshake(&cl, host, port as u16, 2) {
        io.eprint_line("mcclient: could not send the handshake")
        rc = 4
    }
    var t_login: u64 = 0
    if rc == 0 {
        var lr: i32 = 0
        if online {
            lr = mc_client.client_login_online(&cl, login_name, &acct, LOGIN_WAITS)
        } else {
            lr = mc_client.client_login_offline(&cl, login_name, LOGIN_WAITS)
        }
        if lr != 0 {
            if online || lr == mc_client.CL_ONLINE_MODE {
                describe_failure(&cl, lr, &sess)
            } else {
                say(f"mcclient: login failed ({lr})\n")
            }
            rc = 5
        }
        t_login = now_ms()
    }
    var t_play: u64 = 0
    if rc == 0 {
        t_play = t_login
        let pr: i32 = play_loop(&cl, &sc, &world, &ents, &st, idle_ms, view)
        if pr != 0 {
            say(f"mcclient: play ended with {pr}\n")
            if st.chunks == 0 as u64 {
                rc = 6
            }
        }
    }

    // ---- dump + metrics
    if st.chunks > 0 as u64 {
        var out: rt.Buf = rt.buf_new()
        var digest: [u8; 32] = [0; 32]
        dump.dump_build_fmt(&world, ver.protocol, ver.chunk_format, &out, (&digest[0]) as u64)
        if !rt.write_file(out_path, rt.buf_ptr(&out), rt.buf_len(&out)) {
            io.eprint_line("mcclient: cannot write the dump file")
            rc = 7
        }
        // entity side file `<dump>.entities` (the chunk dump and its checksum stay untouched)
        var epath: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&epath, out_path, rt.c_length(out_path))
        rt.buf_push_bytes(&epath, ".entities".p as u64, 9)
        rt.buf_push(&epath, 0 as u8)
        var eout: rt.Buf = rt.buf_new()
        mc_entity.entity_dump(&ents, &eout)
        if !rt.write_file(rt.buf_ptr(&epath), rt.buf_ptr(&eout), rt.buf_len(&eout)) {
            io.eprint_line("mcclient: cannot write the entity file")
            rc = 7
        }
        rt.buf_free(&eout)
        rt.buf_free(&epath)
        var hex: rt.Buf = rt.buf_new()
        dump.hex_digest(&hex, (&digest[0]) as u64, 32)
        say(f"metric checksum=")
        io.print_bytes(rt.buf_ptr(&hex), rt.buf_len(&hex))
        say(f"\n")
        rt.buf_free(&hex)
        rt.buf_free(&out)
    }
    let t_end: u64 = now_ms()
    var span: u64 = st.t_last_packet - t_play
    if st.t_last_packet == 0 as u64 || span == 0 as u64 {
        span = 1
    }
    let n_packets: u64 = mc_codec.wire_stat_packets(&cl.w)
    let pps: u64 = n_packets * 1000 as u64 / span
    say(f"metric connect_ms={t_conn - t0}\n")
    say(f"metric login_ms={rel(t_login, t0)}\n")
    say(f"metric join_ms={rel(st.t_join, t0)}\n")
    say(f"metric first_chunk_ms={rel(st.t_first_chunk, t0)}\n")
    say(f"metric total_ms={t_end - t0}\n")
    say(f"metric packets={n_packets}\n")
    say(f"metric bytes_in={mc_codec.wire_stat_in(&cl.w)}\n")
    say(f"metric bytes_decompressed={mc_codec.wire_stat_inflated(&cl.w)}\n")
    say(f"metric compressed_packets={mc_codec.wire_stat_compressed(&cl.w)}\n")
    say(f"metric packets_per_s={pps}\n")
    // the burst in which the chunks arrive and are decoded: first to last chunk packet
    var cspan: u64 = st.t_last_chunk - st.t_first_chunk
    if st.chunks == 0 as u64 || cspan == 0 as u64 {
        cspan = 1
    }
    say(f"metric chunk_span_ms={cspan}\n")
    say(f"metric chunks_per_s={st.chunks * 1000 as u64 / cspan}\n")
    say(f"metric decoded_kb_per_s={mc_codec.wire_stat_inflated(&cl.w) / cspan}\n")
    say(f"metric chunks={mc_world.world_count(&world)}\n")
    say(f"metric chunk_packets={st.chunks}\n")
    say(f"metric chunk_bad={st.chunk_bad}\n")
    say(f"metric unloads={st.unloads}\n")
    say(f"metric partial_chunks={st.partial}\n")
    say(f"metric entities={mc_entity.store_count(&ents)}\n")
    say(f"metric entity_players={mc_entity.store_player_count(&ents)}\n")
    say(f"metric entity_spawns={ents.spawns}\n")
    say(f"metric entity_moves={ents.moves}\n")
    say(f"metric entity_teleports={ents.teleports}\n")
    say(f"metric entity_destroys={ents.destroys}\n")
    say(f"metric entity_misses={ents.misses}\n")
    say(f"metric entity_bad={ents.bad}\n")
    say(f"metric walk_ok={st.walk_ok}\n")
    say(f"metric walk_fail={st.walk_fail}\n")
    say(f"metric dimension_from_join={st.dim_known} min_y={st.dim.min_y} height={st.dim.height}\n")

    mc_entity.store_free(&ents)
    mc_world.world_free(&world)
    mc_chunk.scratch_free(&sc)
    mc_client.client_free(&cl)
    // the token must not outlive the run
    wipe_buf(&tok)
    rt.buf_free(&tok)
    rt.buf_free(&acct_name)
    rt.buf_free(&base_buf)
    mc_auth.session_free(&sess)
    return rc
}
