// demos/kernel/errno.fi -- round K4: ONE list of errors for the whole
// system.
//
// Until this round every file that could fail carried its own copy of the
// numbers: `sys.fi` had nine of them, `elf.fi` translated its own refusals
// into them by hand, and a user program had none at all -- it printed
// whatever negative number came back. Three copies of a list are three
// lists, and the day they disagree is the day an error means two things.
//
// So the numbers live here, once, and they are the numbers of Linux
// x86-64 (`asm-generic/errno-base.h`). That is not politeness towards
// another system: stage 2 of this plan is to run a statically linked Linux
// binary, and such a binary compares the value it gets against ITS list.
// A kernel whose -2 does not mean "no such file" would fail in a way that
// looks like a bug in the program.
//
// The rule the whole kernel follows: a system call returns a RESULT or a
// NEGATIVE error number. `neg` is the one place that makes one, and it
// uses `-%`, because turning 2 into 0xFFFFFFFFFFFFFFFE is a wraparound one
// WANTS -- since round 72 plain `-` is checked and would rightly panic.

export {
    neg, is_error,
    E_PERM, E_NOENT, E_SRCH, E_INTR, E_IO, E_NXIO, E_2BIG, E_NOEXEC,
    E_BADF, E_CHILD, E_AGAIN, E_NOMEM, E_ACCES, E_FAULT, E_BUSY, E_EXIST,
    E_XDEV, E_NODEV, E_NOTDIR, E_ISDIR, E_INVAL, E_NFILE, E_MFILE,
    E_NOTTY, E_FBIG, E_NOSPC, E_SPIPE, E_ROFS, E_MLINK, E_PIPE,
    E_NAMETOOLONG, E_NOSYS, E_NOTEMPTY, E_OVERFLOW, E_RANGE
}

const E_PERM: u64 = 1 // not allowed
const E_NOENT: u64 = 2 // no such file or directory
const E_SRCH: u64 = 3 // no such process
const E_INTR: u64 = 4 // interrupted
const E_IO: u64 = 5 // the device said no
const E_NXIO: u64 = 6 // no such device
const E_2BIG: u64 = 7 // the argument list is too long
const E_NOEXEC: u64 = 8 // not a program of this machine
const E_BADF: u64 = 9 // no such descriptor
const E_CHILD: u64 = 10 // no such child
const E_AGAIN: u64 = 11 // try again
const E_NOMEM: u64 = 12 // out of memory
const E_ACCES: u64 = 13 // the rights do not allow it
const E_FAULT: u64 = 14 // a pointer that is not the caller's
const E_BUSY: u64 = 16
const E_EXIST: u64 = 17 // it is already there
const E_XDEV: u64 = 18
const E_NODEV: u64 = 19
const E_NOTDIR: u64 = 20 // a path component is not a directory
const E_ISDIR: u64 = 21 // it is a directory
const E_INVAL: u64 = 22 // the argument is wrong
const E_NFILE: u64 = 23 // the system's table is full
const E_MFILE: u64 = 24 // this process has no descriptor free
const E_NOTTY: u64 = 25
const E_FBIG: u64 = 27 // the file cannot grow that far
const E_NOSPC: u64 = 28 // the disk is full
const E_SPIPE: u64 = 29 // a pipe cannot be seeked
const E_ROFS: u64 = 30
const E_MLINK: u64 = 31
const E_PIPE: u64 = 32 // written into a pipe nobody reads
const E_RANGE: u64 = 34 // the answer does not fit in the buffer
const E_NAMETOOLONG: u64 = 36
const E_NOSYS: u64 = 38 // no such system call
const E_NOTEMPTY: u64 = 39 // the directory still has entries
const E_OVERFLOW: u64 = 75 // it does not fit into the answer

// The way an error leaves the kernel: the NEGATIVE value in an unsigned
// register. `0 -% e` is the two's complement of it and nothing else --
// which is why `-%` stands here and not `-`.
fn neg(e: u64) -> u64 {
    return 0 -% e
}

// What ring 3 gets back is one register, and the same register carries
// results. The agreement -- the one Unix has kept since 1970 -- is that
// the top 4096 values are errors: a `read` never returns 0xFFFFFFFFFFFFF002
// octets, and a mapping never lands on the last page of the address space.
fn is_error(v: u64) -> bool {
    return v >= (0 -% 4095)
}
