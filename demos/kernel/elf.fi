fn say_text_e(r: u64) {
    var t19: [u8; 22] = "entry on no exec page\0"
    var t20: [u8; 16] = "short disk read\0"
    var t21: [u8; 11] = "no PT_LOAD\0"
    var t22: [u8; 19] = "arguments too long\0"
    var tx: [u8; 8] = "unknown\0"
    if r == R_ENTRY {
        serial.puts((&t19[0]) as u64)
        return
    }
    if r == R_READ {
        serial.puts((&t20[0]) as u64)
        return
    }
    if r == R_NOLOAD {
