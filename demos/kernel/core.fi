// demos/kernel/core.fi — EIN WINZIGER KERNEL, GANZ IN FIRN.
//
// Runde 52. Der Nachweis, dass `profile kernel` etwas bedeutet: diese Datei
// uebersetzt zu einer ELF-OBJEKTDATEI ohne einen einzigen undefinierten
// Namen — kein libc, kein `_start`, kein Systemaufruf, keine Laufzeit.
// `tools/freestanding/run.sh` uebersetzt sie mit BEIDEN Compilern, liest die
// Symboltabelle mit `nm`/`readelf` und bindet das Ergebnis gegen
// `demos/kernel/linker.ld`.
//
// Was drin ist:
//   * serieller Port COM1 ueber `in`/`out` (Inline-Assembler)
//   * VGA-Textpuffer bei 0xB8000 ueber MMIO
//   * ein Interrupt-Einsprungpunkt (`#[interrupt]`, endet mit `iretq`)
//
// Was NICHT drin ist, und warum: eine IDT braucht globale, veraenderliche
// Daten. Die gibt es in Stufe 0 nicht (SPEC §14, Punkt 5: nur `const`).
// Solange das fehlt, kann dieser Kernel seinen eigenen Interrupt-Vektor
// nicht eintragen — die Einsprungfunktion steht bereit, die Tabelle muss
// (noch) von aussen kommen. Ehrlich benannt in docs/RUNDE52.md.

profile kernel

// ------------------------------------------------------------- Port-E/A

fn out8(port: u16, value: u8) {
    asm("out dx, al", in("dx") port, in("al") value)
}

fn in8(port: u16) -> u8 {
    return asm("in al, dx", out("rax"), in("dx") port) as u8
}

// ------------------------------------------------------ Serieller Port

// 0x3F8 = COM1
const COM1: u16 = 1016

fn serial_init() {
    out8(COM1 + 1 as u16, 0 as u8)
    out8(COM1 + 3 as u16, 128 as u8)
    out8(COM1 + 0 as u16, 3 as u8)
    out8(COM1 + 1 as u16, 0 as u8)
    out8(COM1 + 3 as u16, 3 as u8)
    out8(COM1 + 2 as u16, 199 as u8)
    out8(COM1 + 4 as u16, 11 as u8)
}

fn serial_ready() -> bool {
    return (in8(COM1 + 5 as u16) & 32 as u8) != 0 as u8
}

fn serial_char(z: u8) {
    while !serial_ready() {
    }
    out8(COM1, z)
}

fn serial_text(p: u64, n: usize) {
    var i: usize = 0
    while i < n {
        serial_char(*((p + i as u64) as *mut u8))
        i = i + 1
    }
}

// ------------------------------------------------------ VGA-Textpuffer

// 0xB8000
const VGA: u64 = 753664
// 0x0F00 — hellgrau auf schwarz
const ATTR: u16 = 3840
const ZELLEN: usize = 2000

fn vga_cell(i: usize, z: u8) {
    let p: *mut u16 = (VGA + i as u64 * 2) as *mut u16
    __mmio_schreiben16(p, ATTR | z as u16)
}

fn vga_clear() {
    var i: usize = 0
    while i < ZELLEN {
        vga_cell(i, 32 as u8)
        i = i + 1
    }
}

fn vga_text(p: u64, n: usize, line: usize) {
    var i: usize = 0
    while i < n {
        vga_cell(line * 80 + i, *((p + i as u64) as *mut u8))
        i = i + 1
    }
}

// -------------------------------------------------- Interrupt-Einsprung
//
// Eigene Aufrufkonvention: alle Universalregister werden gerettet, der
// Abschluss ist `iretq`. Aufrufen laesst sie sich nicht — der Compiler
// lehnt das mit Zeile und Spalte ab.

#[interrupt]
fn timer_ih() {
    // Lebenszeichen: das Zeichen in der rechten oberen Ecke zaehlt hoch.
    // Der Zaehler steht im Bildspeicher, weil es in Stufe 0 keine globalen
    // veraenderlichen Variablen gibt.
    let p: *mut u16 = (VGA + 158) as *mut u16
    let old: u16 = __mmio_lesen16(p)
    let z: u16 = (old + 1 as u16) & 255 as u16
    __mmio_schreiben16(p, ATTR | z)
    // Ende der Unterbrechung an den ersten PIC (Port 0x20, Befehl 0x20)
    out8(32 as u16, 32 as u8)
}

// ------------------------------------------------------------- Einstieg
//
// Hierhin springt der Bootlader (`ENTRY` in linker.ld). Kein `_start`,
// keine Argumente, keine Rueckkehr.

fn core_start() {
    asm("cli")
    vga_clear()
    serial_init()
    var greeting: [u8; 24] = "FIRN: profile kernel ist"
    var gruss2: [u8; 13] = "freestanding."
    vga_text((&greeting[0]) as u64, 24, 0)
    vga_text((&gruss2[0]) as u64, 12, 1)
    serial_text((&greeting[0]) as u64, 24)
    serial_char(10 as u8)
    serial_text((&gruss2[0]) as u64, 12)
    serial_char(10 as u8)
    while true {
        asm("hlt")
    }
}
