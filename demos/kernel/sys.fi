// demos/kernel/sys.fi -- round 62: the system calls.
//
// Round 59 had two of them, and they were marks: "I am in ring 3", "I am
// coming back". They returned zero, and a zero said nothing. This is the
// table a process really lives on -- and the rule of this file is that
// NOTHING is answered silently:
//
//   * every unknown number gives -ENOSYS, not zero,
//   * every pointer out of ring 3 is checked by the kernel BEFORE it is
//     followed (`proc.user_ok`); a bad one gives -EFAULT,
//   * every descriptor is checked; a bad one gives -EBADF,
//   * every error is a NEGATIVE number, the way Unix has counted since
//     1970, and the user program can tell it apart from a result.
//
// The counter-check to that is a program of its own: `uprog.badptr`
// hands the kernel an address out of the kernel, an address of zero and
// a descriptor of 77 -- and prints the three error codes it gets back.
// A kernel that followed the first pointer would not print anything, it
// would be dead.

import serial
import kstate
import mem
import sched
import proc
import user
import fs
import kbd
import elf
import uio

export {
    entry, neg, E_NOENT, E_BADF, E_CHILD, E_FAULT, E_INVAL, E_NOSYS,
    E_NOEXEC, E_2BIG
}

// The numbers. 1 and 2 are the two marks of round 59 and stay where they
// are, so that the cases of that round keep measuring what they measured.
const SYS_MARK: u64 = 1
const SYS_LEAVE: u64 = 2
const SYS_EXIT: u64 = 10
const SYS_WRITE: u64 = 11
const SYS_READ: u64 = 12
const SYS_GETPID: u64 = 13
const SYS_SLEEP: u64 = 14
const SYS_SPAWN: u64 = 15
const SYS_WAIT: u64 = 16
const SYS_OPEN: u64 = 17
const SYS_CLOSE: u64 = 18
const SYS_UNLINK: u64 = 19
const SYS_LIST: u64 = 20
const SYS_MKDIR: u64 = 21
const SYS_YIELD: u64 = 22
const SYS_STAT: u64 = 23
const SYS_GETPPID: u64 = 24
// ROUND K1: a program off the disk. `exec(path, argv, argc)` -> pid.
const SYS_EXEC: u64 = 25
// ROUND K6: what a userland needs on top of a single program -- a shell
// that redirects, a working directory, a position in a file, and four
// programs that want to know something about the machine. The numbers
// start at 40 and not at 26 because round K4 is filling 26.. with the
// POSIX layer at the same time; every one of them is answered in
// `demos/kernel/uio.fi`.
const SYS_DUP2: u64 = 40
const SYS_SEEK: u64 = 41
const SYS_CHDIR: u64 = 42
const SYS_GETCWD: u64 = 43
const SYS_SYSINFO: u64 = 44
const SYS_PSTAT: u64 = 45
const SYS_KILL: u64 = 46

// The errors, with the numbers of the system everybody knows.
const E_NOENT: u64 = 2 // no such file
const E_BADF: u64 = 9 // no such descriptor
const E_CHILD: u64 = 10 // no such child
const E_2BIG: u64 = 7 // too many arguments, or too long
const E_NOEXEC: u64 = 8 // the file is not a program of this machine
const E_NOMEM: u64 = 12
const E_FAULT: u64 = 14 // a pointer that is not the caller's
const E_EXIST: u64 = 17
const E_NOTDIR: u64 = 20
const E_ISDIR: u64 = 21
const E_INVAL: u64 = 22
const E_MFILE: u64 = 24 // no descriptor free
const E_NOSPC: u64 = 28 // the disk is full
const E_NAMETOOLONG: u64 = 36
const E_NOSYS: u64 = 38 // no such call

const FD_IN: u64 = 0
const FD_OUT: u64 = 1
const FD_ERR: u64 = 2
const FD_FIRST: u64 = 3 // the first real file

const MAX_IO: u64 = 4096

fn neg(e: u64) -> u64 {
    // ROUND 72: an error number is handed back to ring 3 as the NEGATIVE
    // value in an unsigned register -- `0 - 22` is meant to be
    // 0xFFFFFFFFFFFFFFEA and nothing else. That is a wraparound one wants,
    // so `-%` says so; plain `-` would (correctly) panic on it.
    return 0 -% e
}

// ------------------------------------------------------------ the entry

// `KERNEL_SYSCALL` out of isr.s: rdi = number, rsi/rdx/rcx = arguments,
// r8 = the kernel data area. What is returned lands in the user's rax.
fn entry(number: u64, a0: u64, a1: u64, a2: u64, state: u64) -> u64 {
    kstate.add(state, kstate.SYSCALLS, 1)
    if number == SYS_MARK || number == SYS_LEAVE {
        return user.handle(number, a0, state)
    }
    let me: u64 = sched.current(state)
    if number == SYS_EXIT {
        sched.exit_task(state, a0)
        return 0 // not reached
    }
    if number == SYS_WRITE {
        return do_write(state, me, a0, a1, a2)
    }
    if number == SYS_READ {
        return do_read(state, me, a0, a1, a2)
    }
    if number == SYS_GETPID {
        return sched.tget(state, me, sched.T_PID)
    }
    if number == SYS_GETPPID {
        return sched.tget(state, sched.tget(state, me, sched.T_PARENT),
            sched.T_PID)
    }
    if number == SYS_SLEEP {
        if a0 > 60000 {
            return neg(E_INVAL)
        }
        sched.sleep_ticks(state, (a0 + 9) / 10)
        return 0
    }
    if number == SYS_YIELD {
        sched.yield_now(state)
        return 0
    }
    if number == SYS_SPAWN {
        return do_spawn(state, me, a0, a1)
    }
    if number == SYS_WAIT {
        return do_wait(state, me, a0)
    }
    if number == SYS_OPEN {
        return do_open(state, me, a0, a1)
    }
    if number == SYS_CLOSE {
        return do_close(state, me, a0)
    }
    if number == SYS_UNLINK {
        return do_unlink(state, me, a0)
    }
    if number == SYS_LIST {
        return do_list(state, me, a0, a1, a2)
    }
    if number == SYS_MKDIR {
        return do_mkdir(state, me, a0)
    }
    if number == SYS_STAT {
        return do_stat(state, me, a0, a1)
    }
    if number == SYS_EXEC {
        return do_exec(state, me, a0, a1, a2)
    }
    if number == SYS_DUP2 {
        return do_dup2(state, me, a0, a1)
    }
    if number == SYS_SEEK {
        return do_seek(state, me, a0, a1, a2)
    }
    if number == SYS_CHDIR {
        return do_chdir(state, me, a0)
    }
    if number == SYS_GETCWD {
        return do_getcwd(state, me, a0, a1)
    }
    if number == SYS_SYSINFO {
        return uio.sysinfo(state, a0)
    }
    if number == SYS_PSTAT {
        return uio.pstat(state, a0, a1)
    }
    if number == SYS_KILL {
        return uio.kill_pid(state, a0, a1)
    }
    return neg(E_NOSYS)
}

// --------------------------------------------------------- reading in

// One octet out of the address space of the process. The kernel does not
// switch to it -- it walks the tables and reads the frame through the
// identity mapping.
fn peek(state: u64, me: u64, addr: u64) -> u64 {
    let phys: u64 = proc.translate(state, me, addr)
    if phys == 0 {
        return 0
    }
    return kstate.get8(phys)
}

fn poke(state: u64, me: u64, addr: u64, v: u64) -> bool {
    let phys: u64 = proc.translate(state, me, addr)
    if phys == 0 {
        return false
    }
    kstate.set8(phys, v as u8)
    return true
}

// A name out of ring 3 into the kernel's own buffer. Returns the length,
// or an error. Nothing is read that the process does not own.
fn fetch_name(state: u64, me: u64, addr: u64, dst: u64, max: u64) -> u64 {
    if !proc.user_ok(state, me, addr, 1) {
        return neg(E_FAULT)
    }
    var n: u64 = 0
    while n < max {
        if !proc.user_ok(state, me, addr + n, 1) {
            return neg(E_FAULT)
        }
        let c: u64 = peek(state, me, addr + n)
        kstate.set8(dst + n, c as u8)
        if c == 0 {
            return n
        }
        n = n + 1
    }
    return neg(E_NAMETOOLONG)
}

// ------------------------------------------------------------- write

fn do_write(state: u64, me: u64, fd: u64, buf: u64, len: u64) -> u64 {
    if len > MAX_IO {
        return neg(E_INVAL)
    }
    if !proc.user_ok(state, me, buf, len) {
        return neg(E_FAULT)
    }
    // ROUND K6: the three standard descriptors are STATE now
    // (`demos/kernel/uio.fi`). A descriptor that names no inode is the
    // console, and the console is an answer for 1 and 2 only.
    let ino: u64 = res_inode(state, me, fd)
    if ino == 0 {
        if fd == FD_OUT || fd == FD_ERR {
            var k: u64 = 0
            while k < len {
                serial.put(peek(state, me, buf + k) as u8)
                k = k + 1
            }
            return len
        }
        return neg(E_BADF)
    }
    // Through the data area: the file system never sees an address of a
    // process.
    let bounce: u64 = state + kstate.BLOCK_OFF
    var k: u64 = 0
    while k < len {
        kstate.set8(bounce + k, peek(state, me, buf + k) as u8)
        k = k + 1
    }
    let off: u64 = res_offset(state, me, fd)
    let n: u64 = fs.write_at(state, ino, off, bounce, len)
    res_set_offset(state, me, fd, off + n)
    return n
}

// -------------------------------------------------------------- read

fn do_read(state: u64, me: u64, fd: u64, buf: u64, len: u64) -> u64 {
    if len > MAX_IO {
        return neg(E_INVAL)
    }
    if !proc.user_ok(state, me, buf, len) {
        return neg(E_FAULT)
    }
    let ino: u64 = res_inode(state, me, fd)
    if ino == 0 {
        if fd == FD_IN {
            return console_read(state, me, buf, len)
        }
        return neg(E_BADF)
    }
    let bounce: u64 = state + kstate.BLOCK_OFF
    let off: u64 = res_offset(state, me, fd)
    let n: u64 = fs.read_at(state, ino, off, bounce, len)
    var k: u64 = 0
    while k < n {
        if !poke(state, me, buf + k, kstate.get8(bounce + k)) {
            return neg(E_FAULT)
        }
        k = k + 1
    }
    res_set_offset(state, me, fd, off + n)
    return n
}

// The console has TWO sources since round K1, and they are tried in this
// order:
//
//   1. what the boot loader put there (`script=ls;cat /x` in the tests),
//   2. the KEYBOARD, when the run has one.
//
// The script comes first so that every measurement of round 62 keeps
// measuring what it measured; when it is used up and the run was started
// with `nokbd`, the answer is 0, and 0 is the end of the input, not an
// error. Only a run with a real keyboard waits.
fn console_read(state: u64, me: u64, buf: u64, len: u64) -> u64 {
    let n: u64 = script_read(state, me, buf, len)
    if n != 0 {
        return n
    }
    if (kstate.get(state, kstate.MODE) & kstate.M_NOKBD) != 0 {
        return 0
    }
    return keyboard_read(state, me, buf, len)
}

// How long the console waits for a key before it calls the input ended.
// 100 Hz, so four seconds. A shell that waited forever would be right on
// a machine with a person in front of it and wrong in a test run: the
// kernel could never shut itself down, and a measurement that ends in a
// time limit measures nothing. Four seconds is long enough for a person
// to think and short enough for `tools/osum/run.sh` to finish.
const KEY_IDLE: u64 = 400

// A LINE OFF THE KEYBOARD. The producer is the interrupt handler in
// `kbd.fi`, the consumer is this function, and between them lies a ring
// of 64 octets -- so the ring is read with interrupts off and the waiting
// happens with them on. `sleep_ticks` is what turns them back on: it
// hands the processor to the idle task, and IRQ1 arrives there.
//
// Backspace (8) takes the last octet back instead of being one. There is
// no echo here on purpose: `kbd.fi` already reports every key it saw, and
// the shell prints the line it got. A kernel that echoed as well would be
// deciding what a terminal looks like.
fn keyboard_read(state: u64, me: u64, buf: u64, len: u64) -> u64 {
    var n: u64 = 0
    var idle: u64 = 0
    var going: bool = true
    while going {
        let flags: u64 = sched.irq_save()
        let c: u64 = kbd.take(state)
        sched.irq_restore(flags)
        if c == 0 {
            if idle >= KEY_IDLE {
                going = false
            } else {
                idle = idle + 1
                sched.sleep_ticks(state, 1)
            }
        } else {
            idle = 0
            if c == 8 {
                if n > 0 {
                    n = n - 1
                }
            } else {
                if n < len {
                    if !poke(state, me, buf + n, c) {
                        return neg(E_FAULT)
                    }
                    n = n + 1
                }
                if c == 10 {
                    going = false
                }
            }
        }
    }
    return n
}

fn script_read(state: u64, me: u64, buf: u64, len: u64) -> u64 {
    var pos: u64 = kstate.get(state, kstate.CONSOLE_POS)
    let end: u64 = kstate.get(state, kstate.CONSOLE_LEN)
    var n: u64 = 0
    var going: bool = true
    while going {
        if n >= len || pos >= end {
            going = false
        } else {
            let c: u64 = kstate.get8(state + kstate.CONSOLE_OFF + pos)
            pos = pos + 1
            if !poke(state, me, buf + n, c) {
                return neg(E_FAULT)
            }
            n = n + 1
            if c == 10 {
                going = false
            }
        }
    }
    kstate.set(state, kstate.CONSOLE_POS, pos)
    return n
}

// ------------------------------------------------------------- exec

// Eight octets out of the caller's memory, one at a time. A pointer of
// ring 3 may straddle a page boundary, and `peek` is the only reader that
// checks every page it touches.
fn user_word(state: u64, me: u64, addr: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    while i < 8 {
        v = v | (peek(state, me, addr + i) << (i * 8))
        i = i + 1
    }
    return v
}

// `exec(path, argv, argc)` -- a program off the disk, in a process of its
// own. Returns its pid; the caller waits for it with `wait` and gets its
// exit code. Why this is not a Unix `exec` that replaces the caller is
// argued in `demos/kernel/elf.fi`.
//
// Everything the process will need is copied into the KERNEL before a
// single frame is taken: the path and every argument. `elf.spawn` builds
// an address space and pours the file into it, and it may not be holding
// a pointer of ring 3 while it does that -- the caller could be swapped
// out, killed, or simply lying.
fn do_exec(state: u64, me: u64, path: u64, argv: u64, argc: u64) -> u64 {
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(E_NOSYS)
    }
    if argc > proc.MAX_ARGS {
        return neg(E_2BIG)
    }
    let name: u64 = state + kstate.NAME_OFF
    let len: u64 = fetch_path(state, me, path, name, 64)
    if (len >> 63) != 0 {
        return len
    }
    if len == 0 {
        return neg(E_INVAL)
    }
    let abuf: u64 = state + kstate.EARG_OFF
    var at: u64 = 0
    var k: u64 = 0
    while k < argc {
        if !proc.user_ok(state, me, argv + k * 8, 8) {
            return neg(E_FAULT)
        }
        let n: u64 = fetch_name(state, me,
            user_word(state, me, argv + k * 8), abuf + at, 64)
        if (n >> 63) != 0 {
            return n
        }
        at = at + n + 1
        k = k + 1
    }
    let t: u64 = elf.spawn(state, name, abuf, argc, 2)
    if t == 0 {
        let why: u64 = kstate.get(state, kstate.ELF_ERR)
        elf.say_reason(why)
        return neg(elf.errno_of(why))
    }
    return sched.tget(state, t, sched.T_PID)
}

// ------------------------------------------------------ spawn and wait

fn do_spawn(state: u64, me: u64, prog: u64, arg: u64) -> u64 {
    if prog == 0 || prog > 16 {
        return neg(E_INVAL)
    }
    let i: u64 = proc.create(state, prog, arg, 2)
    if i == 0 {
        return neg(E_NOMEM)
    }
    return sched.tget(state, i, sched.T_PID)
}

// The index of a child, or MAX_TASKS. `pid` 0 means: any of them.
fn find_child(state: u64, me: u64, pid: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if sched.tget(state, i, sched.T_STATE) != sched.S_FREE {
            if sched.tget(state, i, sched.T_PARENT) == me {
                if pid == 0 || sched.tget(state, i, sched.T_PID) == pid {
                    return i
                }
            }
        }
        i = i + 1
    }
    return kstate.MAX_TASKS
}

// Waits for a child and returns ITS exit code. A pid that is not a child
// of the caller gives -ECHILD -- the caller does not get to hear about
// somebody else's processes.
fn do_wait(state: u64, me: u64, pid: u64) -> u64 {
    var rounds: u64 = 0
    while rounds < 100000 {
        let child: u64 = find_child(state, me, pid)
        if child >= kstate.MAX_TASKS {
            return neg(E_CHILD)
        }
        if sched.tget(state, child, sched.T_STATE) == sched.S_ZOMBIE {
            let code: u64 = sched.tget(state, child, sched.T_EXIT)
            proc.reap(state, child)
            return code
        }
        sched.tset(state, me, sched.T_WAITPID, pid)
        sched.tset(state, me, sched.T_STATE, sched.S_WAIT)
        sched.schedule(state)
        rounds = rounds + 1
    }
    return neg(E_CHILD)
}

// ------------------------------------------------------- the descriptors

fn fd_inode(state: u64, me: u64, fd: u64) -> u64 {
    if fd < FD_FIRST || fd >= FD_FIRST + sched.FD_SLOTS {
        return 0
    }
    return sched.tget(state, me, sched.T_FD + (fd - FD_FIRST) * 8)
}

fn fd_offset(state: u64, me: u64, fd: u64) -> u64 {
    return sched.tget(state, me, sched.T_FDOFF + (fd - FD_FIRST) * 8)
}

fn fd_set_offset(state: u64, me: u64, fd: u64, off: u64) {
    sched.tset(state, me, sched.T_FDOFF + (fd - FD_FIRST) * 8, off)
}

// ------------------------------------------------------------ the files

// `open(name, create)`. Returns a descriptor from 3 on.
fn do_open(state: u64, me: u64, name: u64, create: u64) -> u64 {
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(E_NOSYS)
    }
    let buf: u64 = state + kstate.NAME_OFF
    let len: u64 = fetch_path(state, me, name, buf, 64)
    if (len >> 63) != 0 {
        return len
    }
    var ino: u64 = fs.path(state, buf)
    if ino == 0 {
        if create == 0 {
            return neg(E_NOENT)
        }
        ino = fs.create_path(state, buf, fs.T_FILE)
        if ino == 0 {
            return neg(E_NOSPC)
        }
    }
    if fs.inode_type(state, ino) == fs.T_DIR {
        return neg(E_ISDIR)
    }
    var slot: u64 = 0
    while slot < sched.FD_SLOTS {
        if sched.tget(state, me, sched.T_FD + slot * 8) == 0 {
            sched.tset(state, me, sched.T_FD + slot * 8, ino)
            sched.tset(state, me, sched.T_FDOFF + slot * 8, 0)
            return FD_FIRST + slot
        }
        slot = slot + 1
    }
    return neg(E_MFILE)
}

fn do_close(state: u64, me: u64, fd: u64) -> u64 {
    // ROUND K6: closing one of the three standard descriptors does not
    // take it away, it gives it back to the console. A shell that has
    // just pointed its own output at a file needs exactly that to get it
    // back afterwards.
    if fd < FD_FIRST {
        uio.set_handle(state, me, fd, 0)
        uio.set_offset(state, me, fd, 0)
        return 0
    }
    if fd_inode(state, me, fd) == 0 {
        return neg(E_BADF)
    }
    sched.tset(state, me, sched.T_FD + (fd - FD_FIRST) * 8, 0)
    sched.tset(state, me, sched.T_FDOFF + (fd - FD_FIRST) * 8, 0)
    return 0
}

fn do_unlink(state: u64, me: u64, name: u64) -> u64 {
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(E_NOSYS)
    }
    let buf: u64 = state + kstate.NAME_OFF
    let len: u64 = fetch_path(state, me, name, buf, 64)
    if (len >> 63) != 0 {
        return len
    }
    if !fs.unlink_path(state, buf) {
        return neg(E_NOENT)
    }
    return 0
}

fn do_mkdir(state: u64, me: u64, name: u64) -> u64 {
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(E_NOSYS)
    }
    let buf: u64 = state + kstate.NAME_OFF
    let len: u64 = fetch_path(state, me, name, buf, 64)
    if (len >> 63) != 0 {
        return len
    }
    if fs.path(state, buf) != 0 {
        return neg(E_EXIST)
    }
    if fs.create_path(state, buf, fs.T_DIR) == 0 {
        return neg(E_NOSPC)
    }
    return 0
}

// The n-th entry of a directory into a buffer of the process: 32 octets,
// the name terminated by a zero. Returns the type, or -ENOENT when there
// is no n-th entry.
fn do_list(state: u64, me: u64, name: u64, index: u64, out: u64) -> u64 {
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(E_NOSYS)
    }
    if !proc.user_ok(state, me, out, 32) {
        return neg(E_FAULT)
    }
    let buf: u64 = state + kstate.NAME_OFF
    let len: u64 = fetch_path(state, me, name, buf, 64)
    if (len >> 63) != 0 {
        return len
    }
    let dir: u64 = fs.path(state, buf)
    if dir == 0 {
        return neg(E_NOENT)
    }
    if fs.inode_type(state, dir) != fs.T_DIR {
        return neg(E_NOTDIR)
    }
    let named: u64 = state + kstate.NAME_OFF + 512
    let ino: u64 = fs.entry_at(state, dir, index, named)
    if ino == 0 {
        return neg(E_NOENT)
    }
    var k: u64 = 0
    while k < 32 {
        if !poke(state, me, out + k, kstate.get8(named + k)) {
            return neg(E_FAULT)
        }
        k = k + 1
    }
    return fs.inode_type(state, ino)
}

// Size of a file in octets, or an error.
fn do_stat(state: u64, me: u64, name: u64, unused: u64) -> u64 {
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(E_NOSYS)
    }
    let buf: u64 = state + kstate.NAME_OFF
    let len: u64 = fetch_path(state, me, name, buf, 64)
    if (len >> 63) != 0 {
        return len
    }
    let ino: u64 = fs.path(state, buf)
    if ino == 0 {
        return neg(E_NOENT)
    }
    return fs.inode_size(state, ino)
}

// ============================================================ round K6
//
// A userland. Everything below is what a SHELL needs of a kernel and a
// single program does not, and the state it works on lies in
// `demos/kernel/uio.fi` -- one slot of 128 octets per task.

// The three standard descriptors and the table of open files, under one
// pair of accessors. Below 3 the handle is inherited by a child; from 3
// on it belongs to the task alone.
fn res_inode(state: u64, me: u64, fd: u64) -> u64 {
    if fd < FD_FIRST {
        return uio.handle(state, me, fd)
    }
    return fd_inode(state, me, fd)
}

fn res_offset(state: u64, me: u64, fd: u64) -> u64 {
    if fd < FD_FIRST {
        return uio.offset(state, me, fd)
    }
    return fd_offset(state, me, fd)
}

fn res_set_offset(state: u64, me: u64, fd: u64, off: u64) {
    if fd < FD_FIRST {
        uio.set_offset(state, me, fd, off)
        return
    }
    fd_set_offset(state, me, fd, off)
}

// A name out of ring 3 that is meant to be a PATH. The difference to
// `fetch_name` is one line and it is the whole of the working directory:
// a name that does not start with a slash is completed with it before
// the file system sees it. `exec` uses this for the program and
// `fetch_name` for the arguments -- an argument is not a path.
fn fetch_path(state: u64, me: u64, addr: u64, dst: u64, max: u64) -> u64 {
    let n: u64 = fetch_name(state, me, addr, dst, max)
    if (n >> 63) != 0 {
        return n
    }
    return uio.resolve(state, me, dst, n)
}

fn fd_valid(state: u64, me: u64, fd: u64) -> bool {
    if fd < FD_FIRST {
        return true
    }
    return fd_inode(state, me, fd) != 0
}

// `dup2(old, new)`: afterwards `new` says what `old` says. The console is
// a handle like any other (inode 0), so `dup2(2, 1)` is how a shell whose
// error output is still the console takes its output back.
fn do_dup2(state: u64, me: u64, old: u64, new: u64) -> u64 {
    if !fd_valid(state, me, old) {
        return neg(E_BADF)
    }
    if new >= FD_FIRST + sched.FD_SLOTS {
        return neg(E_BADF)
    }
    let ino: u64 = res_inode(state, me, old)
    let off: u64 = res_offset(state, me, old)
    if new < FD_FIRST {
        uio.set_handle(state, me, new, ino)
        uio.set_offset(state, me, new, off)
        return new
    }
    sched.tset(state, me, sched.T_FD + (new - FD_FIRST) * 8, ino)
    sched.tset(state, me, sched.T_FDOFF + (new - FD_FIRST) * 8, off)
    return new
}

// `seek(fd, off, whence)`: 0 = from the start, 1 = from here, 2 = from
// the end. The console has no position and is refused. Only a FORWARD
// offset is taken -- a negative one would arrive as a huge unsigned
// number, and the checked arithmetic of round 72 would rightly panic on
// it instead of counting backwards.
fn do_seek(state: u64, me: u64, fd: u64, off: u64, whence: u64) -> u64 {
    let ino: u64 = res_inode(state, me, fd)
    if ino == 0 {
        return neg(E_BADF)
    }
    if off > 0xFFFFFFFF || whence > 2 {
        return neg(E_INVAL)
    }
    var at: u64 = off
    if whence == 1 {
        at = res_offset(state, me, fd) + off
    }
    if whence == 2 {
        at = fs.inode_size(state, ino) + off
    }
    res_set_offset(state, me, fd, at)
    return at
}

fn do_chdir(state: u64, me: u64, name: u64) -> u64 {
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(E_NOSYS)
    }
    let buf: u64 = state + kstate.NAME_OFF
    let len: u64 = fetch_path(state, me, name, buf, 64)
    if (len >> 63) != 0 {
        return len
    }
    return uio.chdir_to(state, me, buf)
}

fn do_getcwd(state: u64, me: u64, out: u64, len: u64) -> u64 {
    let n: u64 = uio.cwd_len(state, me)
    if len <= n {
        return neg(E_INVAL)
    }
    if !proc.user_ok(state, me, out, n + 1) {
        return neg(E_FAULT)
    }
    var i: u64 = 0
    while i < n {
        if !poke(state, me, out + i, uio.cwd_at(state, me, i)) {
            return neg(E_FAULT)
        }
        i = i + 1
    }
    if !poke(state, me, out + n, 0) {
        return neg(E_FAULT)
    }
    return n
}
