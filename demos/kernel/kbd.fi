// demos/kernel/kbd.fi -- round 59: the first real device.
//
// The PS/2 keyboard is the simplest device a PC has, and it is a real
// one: it interrupts (IRQ1 -> vector 33), it has a data port (0x60), and
// it delivers scan codes, not characters. Whoever can read a key can read
// a device.
//
// Scan code set 1, the one every PC still speaks after a reset. Below
// 0x80 a key was pressed, from 0x80 on it was released -- the same code
// with the top bit set. The kernel is only interested in the press.
//
// No shift, no modifiers, no repeat: the table has one entry per code,
// and what has none stays silent. A keyboard driver is a round of its
// own; this is the proof that the interrupt path works.

import serial
import kstate

export { irq, translate, MAX_KEYS }

// How many octets fit into the buffer in the data area.
const MAX_KEYS: u64 = 64

const DATA_PORT: u16 = 0x60

// Vector 33. Reading the data port acknowledges the key to the keyboard
// -- without it the controller delivers nothing more.
fn irq(state: u64) {
    let code: u64 = serial.in8(DATA_PORT) as u64
    if code >= 0x80 {
        return
    }
    let c: u8 = translate(code)
    if c == 0 as u8 {
        return
    }
    kstate.add(state, kstate.KEYS, 1)
    let n: u64 = kstate.get(state, kstate.KEYLEN)
    if n < MAX_KEYS {
        kstate.set8(state + kstate.KEYBUF + n, c)
        kstate.set(state, kstate.KEYLEN, n + 1)
    }
    var label: [u8; 6] = "key: \0"
    serial.puts((&label[0]) as u64)
    if c == 10 as u8 {
        var word: [u8; 8] = "[enter]\0"
        serial.puts((&word[0]) as u64)
    } else {
        serial.put(c)
    }
    serial.nl()
}

// Scan code -> character, 0 = nothing printable. The table covers
// 0x00..0x39; everything above that is a modifier or a function key.
fn translate(code: u64) -> u8 {
    var table: [u8; 58] = "\0\01234567890-=\0\0qwertyuiop[]\n\0asdfghjkl;'`\0\\zxcvbnm,./\0*\0 "
    if code >= 58 {
        return 0 as u8
    }
    return table[code as usize]
}
