// demos/kernel/serial.fi -- round 59: COM1, the kernel's only output.
//
// A kernel without output is a black box. Everything this kernel says --
// boot messages, register dumps of an exception, the tick counter, the
// keys -- goes out here, and `tools/kernel/run.sh` reads it back out of
// QEMU and holds it against expectations.
//
// Port I/O is the one thing that cannot be expressed with pointers:
// `in`/`out` are instructions of their own with an address space of their
// own. Hence inline assembly (round 52, compiler/src/core.rs).

export {
    out8, in8, io_wait,
    init, put, puts, text, nl, hex, hex_digits, hex_width, dec, pad_dec
}

// 0x3F8 = COM1 on every PC that has ever existed
const COM1: u16 = 0x3F8

// ------------------------------------------------------------ port I/O

fn out8(port: u16, value: u8) {
    asm("out dx, al", in("dx") port, in("al") value)
}

fn in8(port: u16) -> u8 {
    return asm("in al, dx", out("rax"), in("dx") port) as u8
}

// A write to the unused port 0x80 costs roughly one bus cycle. The old
// PIC needs that pause between two command bytes.
fn io_wait() {
    out8(0x80 as u16, 0 as u8)
}

// ------------------------------------------------------------- output

fn init() {
    out8(COM1 + 1 as u16, 0x00 as u8) // no interrupts
    out8(COM1 + 3 as u16, 0x80 as u8) // unlock the divisor
    out8(COM1 + 0 as u16, 0x03 as u8) // 38400 baud, low byte
    out8(COM1 + 1 as u16, 0x00 as u8) // high byte
    out8(COM1 + 3 as u16, 0x03 as u8) // 8 bits, no parity, 1 stop bit
    out8(COM1 + 2 as u16, 0xC7 as u8) // FIFO on, cleared, 14 bytes
    out8(COM1 + 4 as u16, 0x0B as u8) // DTR, RTS, OUT2
}

fn ready() -> bool {
    return (in8(COM1 + 5 as u16) & 0x20 as u8) != 0 as u8
}

fn put(c: u8) {
    while !ready() {
    }
    out8(COM1, c)
}

fn nl() {
    put(10 as u8)
}

// A string in the C sense: everything up to the first zero octet. Firn
// has no string type in the kernel profile (that is in the standard
// library, and that one is barred here), so the kernel writes its texts
// as `[u8; n]` with a closing `\0`.
fn puts(p: u64) {
    var i: u64 = 0
    while true {
        let c: u8 = *((p + i) as *mut u8)
        if c == 0 as u8 {
            return
        }
        put(c)
        i = i + 1
    }
}

// n octets, zeros included -- for buffers that are not terminated.
fn text(p: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        put(*((p + i) as *mut u8))
        i = i + 1
    }
}

// ------------------------------------------------------------- numbers

fn digit(d: u64) -> u8 {
    if d < 10 {
        return (48 + d) as u8
    }
    return (87 + d) as u8
}

// `0x` and as many digits as the value needs (at least one).
fn hex(v: u64) {
    hex_width(v, hex_digits(v))
}

// How many hex digits the value needs (1..16).
fn hex_digits(v: u64) -> u64 {
    var w: u64 = 1
    var x: u64 = v >> 4
    while x != 0 {
        w = w + 1
        x = x >> 4
    }
    return w
}

// Exactly `w` hex digits, highest first.
fn hex_width(v: u64, w: u64) {
    put(48 as u8)
    put(120 as u8)
    var i: u64 = w
    while i > 0 {
        i = i - 1
        put(digit((v >> (i * 4)) & 15))
    }
}

fn dec(v: u64) {
    pad_dec(v, 0)
}

// Decimal, padded with blanks up to `width` (0 = no padding).
fn pad_dec(v: u64, width: u64) {
    var buf: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    var x: u64 = v
    if x == 0 {
        buf[0] = 48 as u8
        n = 1
    }
    while x > 0 {
        buf[n as usize] = (48 + x % 10) as u8
        x = x / 10
        n = n + 1
    }
    var pad: u64 = 0
    while pad + n < width {
        put(32 as u8)
        pad = pad + 1
    }
    var i: u64 = n
    while i > 0 {
        i = i - 1
        put(buf[i as usize])
    }
}
