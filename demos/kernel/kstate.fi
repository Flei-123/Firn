// demos/kernel/kstate.fi -- round 59: the kernel's mutable state.
//
// Stage 0 of Firn has NO global mutable variables (SPEC 14, item 5:
// `const` only). A kernel needs some: an IDT, a frame bitmap, a tick
// counter that an interrupt increments while the main loop reads it.
//
// The way out is the one an operating system takes anyway: the state does
// not lie in the language, it lies in a MEMORY REGION whose address is
// handed over. `boot.s` reserves 128 KiB, zeroes them and puts the
// address into a register; `kernel_main` and `trap_entry` both get it. What
// is a global variable elsewhere is here an offset into that region.
//
// Every access goes through `__mmio_read64`/`__mmio_write64`, not through
// an ordinary pointer. That is not decoration: the tick counter is
// changed by an interrupt handler in the middle of the loop that reads
// it. An ordinary load may be hoisted out of the loop by the optimizer
// (`licm.rs`) -- the kernel would then wait forever. MMIO accesses may
// not be moved, merged or removed (round 52).
//
// Division of the region (offsets from the start):
//
//   0x00000  the scalars below
//   0x01000  IDT, 256 gates of 16 octets
//   0x02000  frame bitmap, 16 KiB -> 131072 frames -> 512 MiB
//   0x06000  page table for the split of the user page (4 KiB)
//   0x07000  the second one of those (round 59: code page and stack page)
//   0x08000  the task table, 32 slots of 256 octets (round 62)
//   0x0A000  the trace of the scheduler, 4096 octets (round 62)
//   0x0B000  the console input, 4096 octets (round 62)
//   0x0C000  what a system call copies to and fro (round 62)
//   0x0D000  paths out of ring 3 (round 62)
//   0x0E000  the scratch blocks of the file system (round 62)
//   0x12000  the userland state of a task (round K6)
//   0x13000  free (heap metadata lies in the heap itself)

export {
    TICKS, KEYS, TRAPS, HEAP_BASE, HEAP_END, HEAP_HEAD, BITMAP, BITMAP_FRAMES,
    MEM_TOP, MEM_USABLE, FRAMES_FREE, MODE, VECTORS, KEYLEN, KEYBUF,
    IDTR, GDT, TSS, KERNEL_END, LAST_TRAP,
    CURRENT, TASKS, NEXT_PID, KSTACK_CUR, SWITCHES, TRACE_LEN, KPML4,
    PREEMPT, DISK, DISK_BLOCKS, CONSOLE_POS, CONSOLE_LEN, IDLE, SPAWNS,
    FS_ROOT, FS_READY, KILLED, SYSCALLS, DISK_DEV,
    IDT_OFF, BITMAP_OFF, BITMAP_BYTES, PT_OFF, KDATA_SIZE,
    TASK_OFF, TASK_BYTES, MAX_TASKS, TRACE_OFF, TRACE_MAX,
    CONSOLE_OFF, CONSOLE_MAX, BLOCK_OFF, BLOCK_MAX,
    NAME_OFF, NAME_MAX, FS_OFF, FS_MAX,
    KEYPOS, NX_OK, EXECS, ELF_ERR, ELF_BYTES, ELF_PAGES, ELF_LOADS,
    ELF_OFF, ELF_MAX, EARG_OFF, EARG_MAX, LOAD_OFF, LOAD_MAX,
    UIO_OFF, UIO_MAX,
    M_NOKBD, M_OSUM, M_NOBSS,
    get, set, add, get32, get16, get8, set8
}

// ------------------------------------------------------------- scalars

const TICKS: u64 = 0 // timer interrupts since `sti`
const KEYS: u64 = 8 // keys seen
const TRAPS: u64 = 16 // interrupts of every kind
const HEAP_BASE: u64 = 24
const HEAP_END: u64 = 32
const HEAP_HEAD: u64 = 40 // first block header of the heap
const BITMAP: u64 = 48 // address of the frame bitmap
const BITMAP_FRAMES: u64 = 56 // how many frames it covers
const MEM_TOP: u64 = 64 // highest usable octet + 1
const MEM_USABLE: u64 = 72 // usable octets according to the memory map
const FRAMES_FREE: u64 = 80 // free frames right now
const MODE: u64 = 88 // what the command line asked for
const VECTORS: u64 = 96 // address of the table out of isr.s
const KEYLEN: u64 = 104 // octets in KEYBUF
const IDTR: u64 = 112 // 10 octets: limit + base for `lidt`
const GDT: u64 = 128
const TSS: u64 = 136
const KERNEL_END: u64 = 144
const LAST_TRAP: u64 = 152 // vector of the last interrupt
const KEYBUF: u64 = 256 // 64 octets of collected characters

// Round 62. Everything below belongs to the scheduler, the processes and
// the file system. KSTACK_CUR is the one offset that is not only read in
// Firn: `syscall_entry` in isr.s takes the kernel stack of the current
// task out of it, and the number 344 stands there a second time.
const CURRENT: u64 = 320 // index of the running task
const TASKS: u64 = 328 // how many slots of the table are in use
const NEXT_PID: u64 = 336 // the pid the next task gets
const KSTACK_CUR: u64 = 344 // kernel stack of the current task (isr.s!)
const SWITCHES: u64 = 352 // context switches since the start
const TRACE_LEN: u64 = 360 // octets in the trace
const KPML4: u64 = 368 // the address space of the kernel
const PREEMPT: u64 = 376 // 1 = the timer may switch tasks
const DISK: u64 = 384 // address of the RAM disk
const DISK_BLOCKS: u64 = 392 // its size in blocks
const CONSOLE_POS: u64 = 400 // how much of the console input was read
const CONSOLE_LEN: u64 = 408 // how much of it there is
const IDLE: u64 = 416 // index of the idle task
const SPAWNS: u64 = 424 // processes created
const FS_ROOT: u64 = 432 // inode of the root directory
const FS_READY: u64 = 440 // 1 = a file system is mounted
const KILLED: u64 = 448 // tasks killed by a fault
const SYSCALLS: u64 = 456 // system calls answered
const DISK_DEV: u64 = 464 // 0 = RAM disk, 1 = ATA

// Round K1. The console became a real one -- the keys of `kbd.fi` are a
// ring now, and KEYPOS says how much of it the shell has eaten. The rest
// belongs to the ELF loader.
const KEYPOS: u64 = 472 // keys handed to `read` on descriptor 0
const NX_OK: u64 = 480 // 1 = the processor honours the no-execute bit
const EXECS: u64 = 488 // programs started from the disk
const ELF_ERR: u64 = 496 // why the last load was refused (elf.R_*)
const ELF_BYTES: u64 = 504 // octets of image the last load copied
const ELF_PAGES: u64 = 512 // pages it mapped
const ELF_LOADS: u64 = 520 // PT_LOAD segments it laid down

// --------------------------------------------------------- the regions

const IDT_OFF: u64 = 0x1000
const BITMAP_OFF: u64 = 0x2000
const BITMAP_BYTES: u64 = 0x4000
const PT_OFF: u64 = 0x6000

// Round 62.
const TASK_OFF: u64 = 0x8000 // the task table
const TASK_BYTES: u64 = 256 // one slot
const MAX_TASKS: u64 = 32 // 32 * 256 = 8 KiB
const TRACE_OFF: u64 = 0xA000 // who ran when, one octet per turn
const TRACE_MAX: u64 = 4096
const CONSOLE_OFF: u64 = 0xB000 // what `read` on descriptor 0 delivers
const CONSOLE_MAX: u64 = 4096
const BLOCK_OFF: u64 = 0xC000 // what a system call copies to and fro
const BLOCK_MAX: u64 = 4096
const NAME_OFF: u64 = 0xD000 // paths out of ring 3
const NAME_MAX: u64 = 4096
const FS_OFF: u64 = 0xE000 // the scratch blocks of the file system
const FS_MAX: u64 = 4096

// Round K1. 64 octets of ELF header plus at most sixteen program headers
// of 56 is 960 -- one page holds the whole front of a program file.
const ELF_OFF: u64 = 0xF000 // ELF header and program headers
const ELF_MAX: u64 = 4096
const EARG_OFF: u64 = 0x10000 // the arguments of `exec`, kernel side
const EARG_MAX: u64 = 4096
const LOAD_OFF: u64 = 0x11000 // one page of file data while loading
const LOAD_MAX: u64 = 4096

// Round K6. One slot of 128 octets per task: the three standard
// descriptors, their positions in a file and the working directory
// (`demos/kernel/uio.fi`). 32 tasks make exactly one page.
const UIO_OFF: u64 = 0x12000
const UIO_MAX: u64 = 4096

const KDATA_SIZE: u64 = 0x20000

// ------------------------------------------------------ the command line

// The bits of MODE. Round 62 kept them in `kmain.fi` and other modules
// wrote the number (`user.fi` still tests 2048 by hand); the three that
// round K1 needs are read in three different files, so they live here.
const M_NOKBD: u64 = 256 // no keyboard in this run
const M_OSUM: u64 = 131072 // mount the drive and start /bin/sh from it
const M_NOBSS: u64 = 262144 // counter-check: do NOT zero what the file
// does not fill -- the poison pattern stays visible

// --------------------------------------------------------- the accesses

fn get(state: u64, off: u64) -> u64 {
    return __mmio_read64((state + off) as *mut u64)
}

fn set(state: u64, off: u64, v: u64) {
    __mmio_write64((state + off) as *mut u64, v)
}

// Read, add, write back. NOT atomic -- it does not have to be: the kernel
// runs on one processor, and the only writer of a counter is either the
// interrupt handler or the main loop, never both.
fn add(state: u64, off: u64, v: u64) -> u64 {
    let n: u64 = get(state, off) + v
    set(state, off, n)
    return n
}

fn get32(p: u64) -> u64 {
    return __mmio_read32(p as *mut u32) as u64
}

fn get16(p: u64) -> u64 {
    return __mmio_read16(p as *mut u16) as u64
}

fn get8(p: u64) -> u64 {
    return __mmio_read8(p as *mut u8) as u64
}

fn set8(p: u64, v: u8) {
    __mmio_write8(p as *mut u8, v)
}
