// demos/kernel/user/rm.fi -- round K1: taking a name away.
//
// One system call per argument. What it does NOT do is the point: it
// does not free a block, does not touch a bitmap and does not know that
// an inode exists. `SYS_UNLINK` is the whole of it, and the file system
// is on the other side of that call.

profile kernel

import ulib
import osum.libc.io
import osum.libc.errno

export { u_start }

fn u_start(args: u64) -> u64 {
    var s_err: [u8; 12] = "rm: failed \0"
    var s_use: [u8; 19] = "rm: needs a path\n\0\0"

    let argc: u64 = ulib.arg_count(args)
    if argc < 2 {
        ulib.say((&s_use[0]) as u64)
        return 1
    }
    var gone: u64 = 0
    var k: u64 = 1
    while k < argc {
        let r: u64 = io.unlink(ulib.arg_at(args, k))
        if (r >> 63) != 0 {
            ulib.say((&s_err[0]) as u64)
            ulib.say(ulib.arg_at(args, k))
            ulib.nl()
        } else {
            gone = gone + 1
        }
        k = k + 1
    }
    return gone
}
