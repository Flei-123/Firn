// demos/kernel/user/rm.fi -- round K6: taking a name away.
//
// One system call per argument. What it does NOT do is the point: it
// does not free a block, does not touch a bitmap and does not know that
// an inode exists. `SYS_UNLINK` is the whole of it, and the file system
// is on the other side of that call.
//
// A directory is refused; `rmdir` is the program for that, and a `rm -r`
// that walked a tree would need a path buffer per level.

profile kernel

import ulib

export { u_start }

fn u_start(args: u64) -> u64 {
    var s_err: [u8; 19] = "rm: cannot remove \0"
    var s_dir: [u8; 20] = "rm: is a directory \0"
    var s_use: [u8; 17] = "rm: needs a path\0"
    var opt_f: [u8; 3] = "-f\0"

    let argc: u64 = ulib.arg_count(args)
    var force: bool = false
    var names: u64 = 0
    var k: u64 = 1
    while k < argc {
        if ulib.streq(ulib.arg_at(args, k), (&opt_f[0 as usize]) as u64) {
            force = true
        } else {
            names = names + 1
        }
        k = k + 1
    }
    if names == 0 {
        if force {
            return 0
        }
        ulib.esay_line((&s_use[0 as usize]) as u64, 0)
        return 1
    }
    var code: u64 = 0
    k = 1
    while k < argc {
        let p: u64 = ulib.arg_at(args, k)
        if !ulib.streq(p, (&opt_f[0 as usize]) as u64) {
            if ulib.is_dir(p) {
                if !force {
                    ulib.esay_line((&s_dir[0 as usize]) as u64, p)
                    code = 1
                }
            } else if ulib.bad(ulib.sys(ulib.SYS_UNLINK, p, 0, 0)) {
                if !force {
                    ulib.esay_line((&s_err[0 as usize]) as u64, p)
                    code = 1
                }
            }
        }
        k = k + 1
    }
    return code
}
