// demos/kernel/user/sort.fi -- round K6: the lines in order.
//
// The only program of this userland that has to hold ALL of its input at
// once, and the one that shows what a program without an allocator is:
// 16 KiB of .bss and 256 line starts, and an input that is bigger is
// REFUSED with a word and an exit code instead of being cut silently.
//
// A selection sort over the indices, not over the octets: what moves is
// eight octets per line and not the line.

profile kernel

import ulib

export { u_start }

const SPACE: u64 = 16384
const MAX_LINES: u64 = 256

static mut data: [u8; 16384] = [0 as u8; 16384]
static mut at: [u64; 256] = [0 as u64; 256]
static mut used: u64 = 0
static mut count: u64 = 0
static mut full: u64 = 0

fn u_start(args: u64) -> u64 {
    var s_open: [u8; 19] = "sort: cannot open \0"
    var s_full: [u8; 21] = "sort: too much input\0"
    var opt_r: [u8; 3] = "-r\0"
    let argc: u64 = ulib.arg_count(args)
    var back: bool = false
    var start: u64 = 1
    if argc > 1 && ulib.streq(ulib.arg_at(args, 1), (&opt_r[0 as usize]) as u64) {
        back = true
        start = 2
    }
    var code: u64 = 0
    if start >= argc {
        soak(ulib.IN)
    } else {
        var k: u64 = start
        while k < argc {
            let p: u64 = ulib.arg_at(args, k)
            let fd: u64 = ulib.sys(ulib.SYS_OPEN, p, 0, 0)
            if ulib.bad(fd) {
                ulib.esay_line((&s_open[0 as usize]) as u64, p)
                code = 1
            } else {
                soak(fd)
                ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
            }
            k = k + 1
        }
    }
    if full == 1 {
        ulib.esay_line((&s_full[0 as usize]) as u64, 0)
        return 2
    }
    order(back)
    var i: u64 = 0
    while i < count {
        ulib.say((&data[(at[i as usize]) as usize]) as u64)
        ulib.nl()
        i = i + 1
    }
    return code
}

fn soak(fd: u64) {
    var ctx: [u8; 528] = [0 as u8; 528]
    var line: [u8; 256] = [0 as u8; 256]
    ulib.rd_init((&ctx[0 as usize]) as u64)
    var going: bool = true
    while going {
        let len: u64 = ulib.rd_line(fd, (&ctx[0 as usize]) as u64,
            (&line[0 as usize]) as u64, 256)
        if ulib.bad(len) {
            going = false
        } else if count >= MAX_LINES || used + len + 1 >= SPACE {
            full = 1
            going = false
        } else {
            at[count as usize] = used
            var i: u64 = 0
            while i < len {
                data[(used + i) as usize] = line[i as usize]
                i = i + 1
            }
            data[(used + len) as usize] = 0 as u8
            used = used + len + 1
            count = count + 1
        }
    }
}

fn order(back: bool) {
    var i: u64 = 0
    while i + 1 < count {
        var pick: u64 = i
        var j: u64 = i + 1
        while j < count {
            let r: u64 = ulib.cmp((&data[(at[j as usize]) as usize]) as u64,
                (&data[(at[pick as usize]) as usize]) as u64)
            if !back && r == 1 {
                pick = j
            }
            if back && r == 2 {
                pick = j
            }
            j = j + 1
        }
        let tmp: u64 = at[i as usize]
        at[i as usize] = at[pick as usize]
        at[pick as usize] = tmp
        i = i + 1
    }
}
