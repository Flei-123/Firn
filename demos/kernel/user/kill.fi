// demos/kernel/user/kill.fi -- round K6: ending somebody else's process.
//
// There are no signals in this system: SYS_KILL turns a task into a
// corpse with the code it is given, and whoever is waiting for it is
// woken. Its FRAMES come back when its parent picks it up -- so a `kill`
// without a `wait` afterwards leaves a page table standing, and the shell
// does that `wait` at the end of the run.
//
// 137 is 128 + 9, the number a system with a SIGKILL would leave behind.

profile kernel

import ulib

export { u_start }

fn u_start(args: u64) -> u64 {
    var s_use: [u8; 18] = "kill: needs a pid\0"
    var s_no: [u8; 23] = "kill: no such process \0"
    var opt_c: [u8; 3] = "-c\0"

    let argc: u64 = ulib.arg_count(args)
    var code: u64 = 137
    var at: u64 = 1
    if argc > 2 && ulib.streq(ulib.arg_at(args, 1), (&opt_c[0 as usize]) as u64) {
        code = ulib.to_num(ulib.arg_at(args, 2))
        at = 3
    }
    if argc <= at {
        ulib.esay_line((&s_use[0 as usize]) as u64, 0)
        return 1
    }
    var bad_ones: u64 = 0
    var k: u64 = at
    while k < argc {
        let pid: u64 = ulib.to_num(ulib.arg_at(args, k))
        if ulib.bad(ulib.sys(ulib.SYS_KILL, pid, code, 0)) {
            ulib.esay_line((&s_no[0 as usize]) as u64, ulib.arg_at(args, k))
            bad_ones = bad_ones + 1
        }
        k = k + 1
    }
    if bad_ones > 0 {
        return 1
    }
    return 0
}
