// demos/kernel/user/date.fi -- round K6: the clock of the machine.
//
// The kernel reads the six fields out of the CMOS clock over the ports
// 0x70 and 0x71 (`demos/kernel/uio.fi`); this program only writes them
// down. `-u` asks for the other clock instead: how long the machine has
// been up, in milliseconds, out of the timer that has been counting since
// `sti`.
//
// Two digits per field, and the leading zero is written by hand -- a
// number that says 2026-8-9 is not a date anybody can sort.

profile kernel

import ulib

export { u_start }

fn u_start(args: u64) -> u64 {
    var s_dash: [u8; 2] = "-\0"
    var s_colon: [u8; 2] = ":\0"
    var s_sp: [u8; 2] = " \0"
    var s_up: [u8; 4] = "up \0"
    var s_ms: [u8; 4] = " ms\0"
    var opt_u: [u8; 3] = "-u\0"
    let argc: u64 = ulib.arg_count(args)
    if argc > 1 && ulib.streq(ulib.arg_at(args, 1), (&opt_u[0 as usize]) as u64) {
        ulib.say((&s_up[0 as usize]) as u64)
        ulib.sayu(ulib.sys(ulib.SYS_SYSINFO, ulib.I_UPTIME, 0, 0))
        ulib.say((&s_ms[0 as usize]) as u64)
        ulib.nl()
        return 0
    }
    ulib.sayu(ulib.sys(ulib.SYS_SYSINFO, ulib.I_YEAR, 0, 0))
    ulib.say((&s_dash[0 as usize]) as u64)
    two(ulib.sys(ulib.SYS_SYSINFO, ulib.I_MONTH, 0, 0))
    ulib.say((&s_dash[0 as usize]) as u64)
    two(ulib.sys(ulib.SYS_SYSINFO, ulib.I_DAY, 0, 0))
    ulib.say((&s_sp[0 as usize]) as u64)
    two(ulib.sys(ulib.SYS_SYSINFO, ulib.I_HOUR, 0, 0))
    ulib.say((&s_colon[0 as usize]) as u64)
    two(ulib.sys(ulib.SYS_SYSINFO, ulib.I_MIN, 0, 0))
    ulib.say((&s_colon[0 as usize]) as u64)
    two(ulib.sys(ulib.SYS_SYSINFO, ulib.I_SEC, 0, 0))
    ulib.nl()
    return 0
}

fn two(v: u64) {
    var s_zero: [u8; 2] = "0\0"
    if v < 10 {
        ulib.say((&s_zero[0 as usize]) as u64)
    }
    ulib.sayu(v)
}
