// demos/kernel/user/head.fi -- round K6: the first lines and no more.
//
// Ten lines unless `-n` says otherwise. Without a file it reads its
// input, which is what makes `sort x | head -n 3` a sentence.
//
// A line longer than the buffer is CUT and the rest of it thrown away
// (`ulib.rd_line`): a program with 256 octets of buffer may not be
// talked into writing over its own stack by a file with no newline in it.

profile kernel

import ulib

export { u_start }

fn u_start(args: u64) -> u64 {
    var s_open: [u8; 19] = "head: cannot open \0"
    var opt_n: [u8; 3] = "-n\0"
    let argc: u64 = ulib.arg_count(args)
    var want: u64 = 10
    var at: u64 = 1
    if argc > 2 && ulib.streq(ulib.arg_at(args, 1), (&opt_n[0 as usize]) as u64) {
        want = ulib.to_num(ulib.arg_at(args, 2))
        at = 3
    }
    if argc <= at {
        take(ulib.IN, want)
        return 0
    }
    var code: u64 = 0
    var k: u64 = at
    while k < argc {
        let p: u64 = ulib.arg_at(args, k)
        let fd: u64 = ulib.sys(ulib.SYS_OPEN, p, 0, 0)
        if ulib.bad(fd) {
            ulib.esay_line((&s_open[0 as usize]) as u64, p)
            code = 1
        } else {
            take(fd, want)
            ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
        }
        k = k + 1
    }
    return code
}

fn take(fd: u64, want: u64) {
    var ctx: [u8; 528] = [0 as u8; 528]
    var line: [u8; 256] = [0 as u8; 256]
    ulib.rd_init((&ctx[0 as usize]) as u64)
    var n: u64 = 0
    var going: bool = true
    while going && n < want {
        let len: u64 = ulib.rd_line(fd, (&ctx[0 as usize]) as u64,
            (&line[0 as usize]) as u64, 256)
        if ulib.bad(len) {
            going = false
        } else {
            ulib.put((&line[0 as usize]) as u64, len)
            ulib.nl()
            n = n + 1
        }
    }
}
