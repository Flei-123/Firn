// demos/kernel/user/df.fi -- round K6: how full the disk is.
//
// Every number comes out of the kernel, and none of them out of a
// calculation this program made: the block layer says how many blocks the
// drive has, the bitmap says how many are free, and the inode table says
// how many names there can be. What is left here is the subtraction and
// the columns.

profile kernel

import ulib

export { u_start }

fn u_start(args: u64) -> u64 {
    var s_b: [u8; 14] = "blocks total=\0"
    var s_free: [u8; 7] = " free=\0"
    var s_used: [u8; 7] = " used=\0"
    var s_size: [u8; 7] = " size=\0"
    var s_i: [u8; 14] = "inodes total=\0"
    var s_iu: [u8; 7] = " used=\0"

    let total: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_BLOCKS, 0, 0)
    let free: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_BFREE, 0, 0)
    var used: u64 = 0
    if total > free {
        used = total - free
    }
    ulib.say((&s_b[0 as usize]) as u64)
    ulib.sayu(total)
    ulib.say((&s_free[0 as usize]) as u64)
    ulib.sayu(free)
    ulib.say((&s_used[0 as usize]) as u64)
    ulib.sayu(used)
    ulib.say((&s_size[0 as usize]) as u64)
    ulib.sayu(ulib.sys(ulib.SYS_SYSINFO, ulib.I_BSIZE, 0, 0))
    ulib.nl()
    ulib.say((&s_i[0 as usize]) as u64)
    ulib.sayu(ulib.sys(ulib.SYS_SYSINFO, ulib.I_INODES, 0, 0))
    ulib.say((&s_iu[0 as usize]) as u64)
    ulib.sayu(ulib.sys(ulib.SYS_SYSINFO, ulib.I_IUSED, 0, 0))
    ulib.nl()
    return 0
}
