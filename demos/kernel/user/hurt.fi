// demos/kernel/user/hurt.fi -- round K1: the program that has to die.
//
// A loader that sets the rights of a page WRONG does not fail loudly; it
// fails by letting something through. So this program tries, on purpose,
// the four things a process must not be able to do, one per argument, and
// the measurement is the fault the kernel reports:
//
//   hurt text     store into its own code page   -> #PF err bit 1 (write)
//   hurt stack    execute out of its own stack   -> #PF err bit 4 (fetch)
//   hurt kernel   read kernel memory             -> #PF, present, user
//   hurt wild     touch a page nobody mapped     -> #PF, not present
//
// The error code of a page fault says WHY, and that is the whole point:
//
//   bit 0  the page was there (a rights violation, not a hole)
//   bit 1  it was a write
//   bit 2  it came out of ring 3
//   bit 4  it was an instruction fetch
//
// So `hurt text` has to give 0x7 (there, write, user) -- proof that the
// code page really is read only -- and `hurt stack` 0x15 (there, fetch,
// user) -- proof that the no-execute bit really reached the stack. A run
// in which these lines say something else is a run in which W^X is a
// claim and not a fact.
//
// It never returns. If a line below DOES print, the kernel let something
// through, and `tools/osum/run.sh` fails on exactly that line.

profile kernel

import ulib

export { u_start }

const TEXT: u64 = 0x40100000 // where user.ld puts .text
const KERNEL: u64 = 0x00100000 // the kernel image, identity mapped
const WILD: u64 = 0x40050000 // between the stack and the image

fn u_start(args: u64) -> u64 {
    var c_text: [u8; 5] = "text\0"
    var c_stack: [u8; 6] = "stack\0"
    var c_kernel: [u8; 7] = "kernel\0"
    var c_wild: [u8; 5] = "wild\0"
    var s_none: [u8; 21] = "hurt: nothing to do\n\0"
    var s_text: [u8; 26] = "hurt: WROTE ITS OWN CODE\n\0"
    var s_stack: [u8; 22] = "hurt: STACK RAN\n\0\0\0\0\0\0"
    var s_kernel: [u8; 24] = "hurt: READ THE KERNEL \0\0"
    var s_wild: [u8; 24] = "hurt: READ THE VOID \0\0\0\0"

    let what: u64 = ulib.arg_at(args, 1)
    if what == 0 {
        ulib.say((&s_none[0]) as u64)
        return 0
    }
    if ulib.streq(what, (&c_text[0]) as u64) {
        __mmio_write64(TEXT as *mut u64, 0)
        ulib.say((&s_text[0]) as u64)
        return 1
    }
    if ulib.streq(what, (&c_stack[0]) as u64) {
        // Three octets of stack that look like `ret`, and a call into
        // them. On a stack without the no-execute bit this returns
        // quietly and the line below prints -- which is the failure.
        var code: [u8; 16] = [0 as u8; 16]
        code[0] = 195 as u8 // ret
        asm("call rax", in("rax")(&code[0]) as u64, clobber("memory"))
        ulib.say((&s_stack[0]) as u64)
        return 2
    }
    if ulib.streq(what, (&c_kernel[0]) as u64) {
        ulib.say_line((&s_kernel[0]) as u64,
            __mmio_read64(KERNEL as *mut u64))
        return 3
    }
    if ulib.streq(what, (&c_wild[0]) as u64) {
        ulib.say_line((&s_wild[0]) as u64, __mmio_read64(WILD as *mut u64))
        return 4
    }
    ulib.say((&s_none[0]) as u64)
    return 0
}
