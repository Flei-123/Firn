// demos/kernel/user/sleep.fi -- round K6: doing nothing, on purpose.
//
// `sleep 1` is a second, the way it is everywhere. `sleep -m 50` is fifty
// MILLISECONDS, and that form is here for the measurement: a test that
// waited whole seconds for a background job would spend its time limit on
// waiting. The kernel counts in milliseconds and rounds up to its tick of
// ten (`sys.SYS_SLEEP`), and it refuses more than sixty seconds -- which
// is why a longer wait is a loop here and not a bigger number.

profile kernel

import ulib

export { u_start }

fn u_start(args: u64) -> u64 {
    var s_use: [u8; 22] = "sleep: needs a number\0"
    var opt_m: [u8; 3] = "-m\0"
    let argc: u64 = ulib.arg_count(args)
    var ms: bool = false
    var at: u64 = 1
    if argc > 1 && ulib.streq(ulib.arg_at(args, 1), (&opt_m[0 as usize]) as u64) {
        ms = true
        at = 2
    }
    if argc <= at {
        ulib.esay_line((&s_use[0 as usize]) as u64, 0)
        return 1
    }
    var left: u64 = ulib.to_num(ulib.arg_at(args, at))
    if !ms {
        if left > 3600 {
            left = 3600
        }
        left = left * 1000
    }
    while left > 0 {
        var take: u64 = left
        if take > 30000 {
            take = 30000
        }
        ulib.sleep_ms(take)
        left = left - take
    }
    return 0
}
