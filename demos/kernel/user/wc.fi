// demos/kernel/user/wc.fi -- round K6: three numbers about a file.
//
// Lines, words, octets. A word is what lies between the blanks, and a
// line is what a newline ends -- a file whose last line has no newline
// still counts as a line here, because the octets are there.
//
// With one of `-l`, `-w`, `-c` it prints that one number and nothing
// else, so that `wc -l` in a pipeline is a number and not a table.

profile kernel

import ulib

export { u_start }

fn u_start(args: u64) -> u64 {
    var s_open: [u8; 17] = "wc: cannot open \0"
    var s_sp: [u8; 2] = " \0"
    var opt_l: [u8; 3] = "-l\0"
    var opt_w: [u8; 3] = "-w\0"
    var opt_c: [u8; 3] = "-c\0"
    let argc: u64 = ulib.arg_count(args)
    var only: u64 = 0
    var at: u64 = 1
    var reading: bool = true
    while reading && at < argc {
        let a: u64 = ulib.arg_at(args, at)
        if ulib.streq(a, (&opt_l[0 as usize]) as u64) {
            only = 1
            at = at + 1
        } else if ulib.streq(a, (&opt_w[0 as usize]) as u64) {
            only = 2
            at = at + 1
        } else if ulib.streq(a, (&opt_c[0 as usize]) as u64) {
            only = 3
            at = at + 1
        } else {
            reading = false
        }
    }
    let start: u64 = at
    if start >= argc {
        count(ulib.IN, only, 0, (&s_sp[0 as usize]) as u64)
        return 0
    }
    var code: u64 = 0
    var k: u64 = start
    while k < argc {
        let p: u64 = ulib.arg_at(args, k)
        let fd: u64 = ulib.sys(ulib.SYS_OPEN, p, 0, 0)
        if ulib.bad(fd) {
            ulib.esay_line((&s_open[0 as usize]) as u64, p)
            code = 1
        } else {
            count(fd, only, p, (&s_sp[0 as usize]) as u64)
            ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
        }
        k = k + 1
    }
    return code
}

fn count(fd: u64, only: u64, name: u64, sp: u64) {
    var buf: [u8; 512] = [0 as u8; 512]
    var lines: u64 = 0
    var words: u64 = 0
    var chars: u64 = 0
    var in_word: bool = false
    var partial: bool = false
    var going: bool = true
    while going {
        let n: u64 = ulib.sys(ulib.SYS_READ, fd, (&buf[0 as usize]) as u64, 512)
        if n == 0 || ulib.bad(n) {
            going = false
        } else {
            var i: u64 = 0
            while i < n {
                let c: u64 = (buf[i as usize]) as u64
                chars = chars + 1
                if c == 10 {
                    lines = lines + 1
                    partial = false
                } else {
                    partial = true
                }
                if c == 32 || c == 9 || c == 10 {
                    in_word = false
                } else {
                    if !in_word {
                        words = words + 1
                    }
                    in_word = true
                }
                i = i + 1
            }
        }
    }
    if partial {
        lines = lines + 1
    }
    if only == 1 {
        ulib.sayu(lines)
    } else if only == 2 {
        ulib.sayu(words)
    } else if only == 3 {
        ulib.sayu(chars)
    } else {
        ulib.sayu(lines)
        ulib.say(sp)
        ulib.sayu(words)
        ulib.say(sp)
        ulib.sayu(chars)
    }
    if name != 0 {
        ulib.say(sp)
        ulib.say(name)
    }
    ulib.nl()
}
