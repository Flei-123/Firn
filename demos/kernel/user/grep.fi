// demos/kernel/user/grep.fi -- round K6: the lines that hold a word.
//
// A substring and not a regular expression -- an expression engine is a
// round of its own, and a `grep` that pretended to have one would be
// worse than one that says what it does.
//
// The exit code is the one every script depends on: 0 when something was
// found, 1 when nothing was, 2 when a file could not be read. That is why
// `ls` and `cat` had to stop returning counts in this round.

profile kernel

import ulib

export { u_start }

fn u_start(args: u64) -> u64 {
    var s_open: [u8; 19] = "grep: cannot open \0"
    var s_use: [u8; 22] = "grep: needs a pattern\0"
    var opt_v: [u8; 3] = "-v\0"
    var opt_c: [u8; 3] = "-c\0"
    let argc: u64 = ulib.arg_count(args)
    var invert: bool = false
    var only_count: bool = false
    var at: u64 = 1
    var reading: bool = true
    while reading && at < argc {
        let a: u64 = ulib.arg_at(args, at)
        if ulib.streq(a, (&opt_v[0 as usize]) as u64) {
            invert = true
            at = at + 1
        } else if ulib.streq(a, (&opt_c[0 as usize]) as u64) {
            only_count = true
            at = at + 1
        } else {
            reading = false
        }
    }
    if at >= argc {
        ulib.esay_line((&s_use[0 as usize]) as u64, 0)
        return 2
    }
    let pattern: u64 = ulib.arg_at(args, at)
    at = at + 1
    var hits: u64 = 0
    var code: u64 = 0
    if at >= argc {
        hits = hits + look(ulib.IN, pattern, invert, only_count)
    } else {
        var k: u64 = at
        while k < argc {
            let p: u64 = ulib.arg_at(args, k)
            let fd: u64 = ulib.sys(ulib.SYS_OPEN, p, 0, 0)
            if ulib.bad(fd) {
                ulib.esay_line((&s_open[0 as usize]) as u64, p)
                code = 2
            } else {
                hits = hits + look(fd, pattern, invert, only_count)
                ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
            }
            k = k + 1
        }
    }
    if only_count {
        ulib.sayu(hits)
        ulib.nl()
    }
    if code != 0 {
        return code
    }
    if hits == 0 {
        return 1
    }
    return 0
}

fn look(fd: u64, pattern: u64, invert: bool, only_count: bool) -> u64 {
    var ctx: [u8; 528] = [0 as u8; 528]
    var line: [u8; 256] = [0 as u8; 256]
    ulib.rd_init((&ctx[0 as usize]) as u64)
    var hits: u64 = 0
    var going: bool = true
    while going {
        let len: u64 = ulib.rd_line(fd, (&ctx[0 as usize]) as u64,
            (&line[0 as usize]) as u64, 256)
        if ulib.bad(len) {
            going = false
        } else {
            var got: bool = !ulib.bad(ulib.find((&line[0 as usize]) as u64,
                pattern))
            if invert {
                got = !got
            }
            if got {
                hits = hits + 1
                if !only_count {
                    ulib.put((&line[0 as usize]) as u64, len)
                    ulib.nl()
                }
            }
        }
    }
    return hits
}
