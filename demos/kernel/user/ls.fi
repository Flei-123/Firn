// demos/kernel/user/ls.fi -- round K1: the directory, from outside.
//
// `ls` cannot read a block, cannot see an inode and does not know what a
// directory looks like. It asks: SYS_LIST(path, index, buffer) hands back
// the index-th entry as 32 octets -- inode number, then the name -- and
// the return value is the KIND. A directory therefore gets a slash after
// it, and that is the only interpretation this program makes.
//
// The exit code is the number of entries it found, so that the shell has
// a number to show and `tools/osum/run.sh` a number to check.

profile kernel

import ulib

export { u_start }

fn u_start(args: u64) -> u64 {
    var root: [u8; 2] = "/\0"
    var entry: [u8; 32] = [0 as u8; 32]
    var s_slash: [u8; 2] = "/\0"
    var s_sp: [u8; 2] = " \0"
    var s_err: [u8; 12] = "ls: failed \0"

    var p: u64 = ulib.arg_at(args, 1)
    if p == 0 {
        p = (&root[0]) as u64
    }
    var i: u64 = 0
    var going: bool = true
    while going {
        let kind: u64 = ulib.sys(ulib.SYS_LIST, p, i, (&entry[0]) as u64)
        if (kind >> 63) != 0 {
            if i == 0 {
                ulib.say_line((&s_err[0]) as u64, kind)
                return 1
            }
            going = false
        } else {
            ulib.say((&entry[8]) as u64)
            if kind == 2 {
                ulib.say((&s_slash[0]) as u64)
            }
            ulib.say((&s_sp[0]) as u64)
            i = i + 1
        }
    }
    ulib.nl()
    return i
}
