// demos/kernel/user/ls.fi -- round K1: the directory, from outside.
//
// `ls` cannot read a block, cannot see an inode and does not know what a
// directory looks like. It asks.
//
// ROUND K4 changed HOW it asks. Round K1 had `SYS_LIST(path, index, buf)`,
// one call per entry, and the path re-walked every time. Now the directory
// is OPENED and read with `getdents64` -- one call for as many entries as
// fit in the buffer, in the record shape of Linux:
//
//     +0 d_ino  +8 d_off  +16 d_reclen  +18 d_type  +19 the name
//
// `d_reclen` is what walks the buffer; a reader that assumed a fixed size
// would be wrong at the first long name. The kind still decides the slash,
// and that is the only interpretation this program makes.
//
// The exit code is the number of entries it found, so that the shell has
// a number to show and `tools/osum/run.sh` a number to check.

profile kernel

import ulib
import osum.libc.io

export { u_start }

fn u_start(args: u64) -> u64 {
    var root: [u8; 2] = "/\0"
    var buf: [u8; 512] = [0 as u8; 512]
    var s_slash: [u8; 2] = "/\0"
    var s_sp: [u8; 2] = " \0"
    var s_err: [u8; 12] = "ls: failed \0"

    var p: u64 = ulib.arg_at(args, 1)
    if p == 0 {
        p = (&root[0]) as u64
    }
    let fd: u64 = io.dir_open(p)
    if ulib.failed(fd) {
        ulib.say_line((&s_err[0]) as u64, fd)
        return 1
    }
    var seen: u64 = 0
    var going: bool = true
    while going {
        let n: u64 = io.dir_read(fd, (&buf[0]) as u64, 512)
        if n == 0 || ulib.failed(n) {
            going = false
        } else {
            var at: u64 = 0
            while at < n {
                let rec: u64 = ((&buf[0]) as u64) + at
                ulib.say(io.dir_name(rec))
                if io.dir_kind(rec) == io.DT_DIR {
                    ulib.say((&s_slash[0]) as u64)
                }
                ulib.say((&s_sp[0]) as u64)
                at = at + io.dir_reclen(rec)
                seen = seen + 1
            }
        }
    }
    io.close(fd)
    ulib.nl()
    return seen
}
