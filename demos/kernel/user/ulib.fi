// demos/kernel/user/ulib.fi -- round K1: what a program on the disk has
// instead of a standard library. ROUND K4: it HAS one now. ROUND K6: and
// twenty-three programs use it.
//
// Round K1 wrote this file because there was nothing: no allocator, no
// collector, no libc, no kernel to call into -- the only door out of a
// process was `syscall`, and this file was that door plus the four
// routines needed to say anything at all.
//
// Round K4 built the library that belongs under it (`lib/osum/libc/`), and
// this file is now what it should have been from the start: a THIN LAYER,
// four lines per function, that keeps the names the programs of round K1
// use while everything underneath goes through the libc. Nothing here has
// its own idea of how a number is printed or how long a text is any more.
//
// ROUND K6 ADDED THE SECOND HALF, and it is here and not in the programs
// for one reason: a userland in which `head` and `tail` each carry their
// own idea of what a line is would be twenty-three userlands.
//
// THE CALL NUMBERS BELOW ARE ROUND K4'S -- LINUX'S. Round K6 was written
// against the kernel of round K1, in which `write` was 11 and `open` was
// 17 and a directory was read one entry at a time with a call of its own
// (`SYS_LIST`). None of those numbers exists any more. The NAMES are kept
// so that the programs read the way they were written; what they stand
// for is `lib/osum/libc/kcall.fi`, and where the SHAPE of a call changed
// as well as its number there is a function here instead of a constant:
// `size_of` and `is_dir` for `stat`, `wait_code` for `wait4`, `sleep_ms`
// for `nanosleep`, and `O_MAKE` for the flags of a `>` redirection.
//
// The two rules of round K1 still hold, and `tools/osum/run.sh` still
// checks both on the finished file:
//
//   1. NO UNDEFINED NAME apart from the ones crt.s defines itself.
//   2. EVERY output and every look at the disk is a system call.
//
// The argument block is unchanged. The kernel builds it on the top stack
// page of the process before the first instruction runs
// (`demos/kernel/elf.fi`, `write_args`) and hands its address in rdi:
//
//     +0   argc
//     +8   argv[0] .. argv[argc-1], then a zero
//     +80  the strings themselves, each one ended by a zero

import osum.libc.kcall
import osum.libc.errno
import osum.libc.text
import osum.libc.io

export {
    sys, say, put, sayn, sayu, say_line, nl, length, streq, word, digits,
    arg_count, arg_at, failed,
    SYS_EXIT, SYS_WRITE, SYS_READ, SYS_GETPID, SYS_SPAWN,
    SYS_OPEN, SYS_CLOSE, SYS_UNLINK, SYS_MKDIR,
    SYS_YIELD, SYS_GETPPID, SYS_EXEC,
    SYS_DUP, SYS_DUP2, SYS_SEEK, SYS_CHDIR, SYS_GETCWD, SYS_SYSINFO, SYS_PSTAT,
    SYS_KILL, O_MAKE,
    I_TICKS, I_UPTIME, I_FRAMES_FREE, I_FRAMES_ALL, I_BLOCKS, I_BFREE,
    I_INODES, I_IUSED, I_BSIZE, I_TASKS, I_SYSCALLS, I_VERSION,
    I_YEAR, I_MONTH, I_DAY, I_HOUR, I_MIN, I_SEC,
    P_STATE, P_PID, P_PPID, P_KIND, P_PRIO, P_TICKS, P_EXIT, P_FAULTS,
    bad, eput, esay_line, copy, fill, strcpy, strncpy, strcat, strneq, find,
    to_num, cmp, pad, is_dir, size_of, base_name, wait_code, sleep_ms,
    rd_init, rd_byte, rd_line, RD_SIZE, EOF,
    IN, OUT, ERR
}

// ------------------------------------------------------- the numbers
//
// One name per call, and the value is round K4's. The four that changed
// their SHAPE and not only their number have no constant at all -- there
// is a function further down instead, so that a program cannot reach the
// old shape by accident.

// The numbers themselves and not `kcall.SYS_*`: a `const` of this stage
// may not be initialised from another module's const. `lib/osum/libc/
// kcall.fi` and `demos/kernel/sys.fi` hold the same list, and
// `tools/posix/run.sh` measures that all three agree.
const SYS_READ: u64 = 0
const SYS_WRITE: u64 = 1
const SYS_OPEN: u64 = 2
const SYS_CLOSE: u64 = 3
const SYS_SEEK: u64 = 8 // `lseek`
const SYS_YIELD: u64 = 24
const SYS_DUP: u64 = 32
const SYS_DUP2: u64 = 33
const SYS_GETPID: u64 = 39
const SYS_EXIT: u64 = 60
const SYS_GETCWD: u64 = 79
const SYS_CHDIR: u64 = 80
const SYS_MKDIR: u64 = 83
const SYS_UNLINK: u64 = 87
const SYS_GETPPID: u64 = 110
const SYS_SPAWN: u64 = 1000
const SYS_EXEC: u64 = 1001
// The three of round K6 (`demos/kernel/sys.fi`).
const SYS_SYSINFO: u64 = 1002
const SYS_PSTAT: u64 = 1003
const SYS_KILL: u64 = 1004

// What `>` means as flags. Round K1's `open(path, 1, 0)` meant "make it
// if it is not there"; the second argument is Linux's flag word now, and
// a plain 1 would be O_WRONLY on a file that is neither created nor
// emptied. This is the one place that knows it.
const O_MAKE: u64 = 577 // O_WRONLY | O_CREAT | O_TRUNC

// What `sysinfo` and `pstat` answer, out of `demos/kernel/uio.fi`.
const I_TICKS: u64 = 0
const I_UPTIME: u64 = 1
const I_FRAMES_FREE: u64 = 2
const I_FRAMES_ALL: u64 = 3
const I_BLOCKS: u64 = 4
const I_BFREE: u64 = 5
const I_INODES: u64 = 6
const I_IUSED: u64 = 7
const I_BSIZE: u64 = 8
const I_TASKS: u64 = 9
const I_SYSCALLS: u64 = 10
const I_VERSION: u64 = 11
const I_YEAR: u64 = 12
const I_MONTH: u64 = 13
const I_DAY: u64 = 14
const I_HOUR: u64 = 15
const I_MIN: u64 = 16
const I_SEC: u64 = 17

const P_STATE: u64 = 0
const P_PID: u64 = 1
const P_PPID: u64 = 2
const P_KIND: u64 = 3
const P_PRIO: u64 = 4
const P_TICKS: u64 = 5
const P_EXIT: u64 = 6
const P_FAULTS: u64 = 7

const EOF: u64 = 0xFFFFFFFFFFFFFFFF

const IN: u64 = 0
const OUT: u64 = 1
const ERR: u64 = 2

// ------------------------------------------------------ the system call

// The raw door, kept because the programs of round K1 use it by name and
// because a test of a system call should be able to make one WITHOUT a
// library in between (`/bin/posix` does exactly that for its error cases).
fn sys(number: u64, a0: u64, a1: u64, a2: u64) -> u64 {
    return kcall.sys3(number, a0, a1, a2)
}

// Did a call fail? A negative answer is an error, and the top 4096 values
// are the errors -- the same rule the kernel uses.
fn failed(v: u64) -> bool {
    return errno.is_error(v)
}

// ------------------------------------------------------------- output

// Unbuffered on purpose. `osum.libc.stdio` has the buffered output, and
// what a program of round K1 does is print a line and then possibly walk
// into a page fault (`/bin/hurt`) -- a buffer would swallow exactly the
// line that says what it was about to do.
fn length(p: u64) -> u64 {
    return text.length(p)
}

fn say(p: u64) -> u64 {
    return io.write_text(OUT, p)
}

fn put(p: u64, n: u64) -> u64 {
    return io.write_all(OUT, p, n)
}

fn nl() {
    var s: [u8; 2] = "\n\0"
    say((&s[0]) as u64)
}

fn digits(v: u64, out: u64) -> u64 {
    return text.digits(v, out, true)
}

// A number that may be an error code: the top bit is a minus.
fn sayn(v: u64) {
    var buf: [u8; 26] = [0 as u8; 26]
    let n: u64 = text.digits(v, (&buf[0]) as u64, true)
    put((&buf[0]) as u64, n)
}

// The same without the sign. A value that is not a result of a system call
// is not an error code, and reading its top bit as a minus would turn the
// poison pattern of the loader into a riddle.
fn sayu(v: u64) {
    var buf: [u8; 26] = [0 as u8; 26]
    let n: u64 = text.digits(v, (&buf[0]) as u64, false)
    put((&buf[0]) as u64, n)
}

fn say_line(p: u64, v: u64) {
    say(p)
    sayn(v)
    nl()
}

// ------------------------------------------------------------ strings

fn streq(a: u64, b: u64) -> bool {
    return text.equal(a, b)
}

// The next word of `line` from `at` on into `out`; returns where the word
// ended. Spaces separate, and a word longer than `max` is cut instead of
// running over the buffer.
fn word(line: u64, at: u64, out: u64, max: u64) -> u64 {
    var i: u64 = at
    while *((line + i) as *mut u8) == 32 as u8 {
        i = i + 1
    }
    var n: u64 = 0
    while *((line + i) as *mut u8) != 0 as u8 {
        if *((line + i) as *mut u8) == 32 as u8 {
            __mmio_write8((out + n) as *mut u8, 0 as u8)
            return i
        }
        if n + 1 < max {
            __mmio_write8((out + n) as *mut u8, *((line + i) as *mut u8))
            n = n + 1
        }
        i = i + 1
    }
    __mmio_write8((out + n) as *mut u8, 0 as u8)
    return i
}

// ---------------------------------------------------- the argument block

fn arg_count(args: u64) -> u64 {
    if args == 0 {
        return 0
    }
    return *((args) as *mut u64)
}

fn arg_at(args: u64, i: u64) -> u64 {
    if i >= arg_count(args) {
        return 0
    }
    return *((args + 8 + i * 8) as *mut u64)
}

// ====================================================== round K6: the rest
//
// What twenty-three programs turned out to need more than once.

// A system call answered with an error. The bit pattern is that of a
// negative `i64`, so the top bit is the whole test.
fn bad(v: u64) -> bool {
    return errno.is_error(v)
}

// Anything that went wrong goes to descriptor 2. That is not decoration:
// `cmd > file` moves descriptor 1 and leaves 2 where it was, and a
// program that reported its errors on 1 would write them into the file.
fn eput(p: u64) -> u64 {
    return io.write_text(ERR, p)
}

fn esay_line(p: u64, q: u64) {
    eput(p)
    if q != 0 {
        eput(q)
    }
    var nlc: [u8; 2] = "\n\0"
    eput((&nlc[0]) as u64)
}

fn copy(dst: u64, src: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        __mmio_write8((dst + i) as *mut u8, *((src + i) as *mut u8))
        i = i + 1
    }
}

fn fill(dst: u64, v: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        __mmio_write8((dst + i) as *mut u8, v as u8)
        i = i + 1
    }
}

fn strcpy(dst: u64, src: u64) -> u64 {
    let n: u64 = length(src)
    copy(dst, src, n)
    __mmio_write8((dst + n) as *mut u8, 0 as u8)
    return n
}

// The same with a ceiling, and it is not decoration: a word out of a
// shell line may be two hundred octets long and the buffer it is copied
// into is ninety-six. `strcpy` would write over the stack of the caller,
// and the check would come later, in the kernel, which is too late.
fn strncpy(dst: u64, src: u64, max: u64) -> u64 {
    var n: u64 = 0
    while n + 1 < max && *((src + n) as *mut u8) != 0 as u8 {
        __mmio_write8((dst + n) as *mut u8, *((src + n) as *mut u8))
        n = n + 1
    }
    __mmio_write8((dst + n) as *mut u8, 0 as u8)
    return n
}

fn strcat(dst: u64, src: u64) -> u64 {
    let at: u64 = length(dst)
    return at + strcpy(dst + at, src)
}

fn strneq(a: u64, b: u64, n: u64) -> bool {
    var i: u64 = 0
    while i < n {
        let x: u64 = (*((a + i) as *mut u8)) as u64
        if x != (*((b + i) as *mut u8)) as u64 {
            return false
        }
        if x == 0 {
            return true
        }
        i = i + 1
    }
    return true
}

// Where `needle` stands in `hay`, or EOF. The whole of what `grep` knows
// about patterns -- a regular expression is a round of its own.
fn find(hay: u64, needle: u64) -> u64 {
    let n: u64 = length(needle)
    let h: u64 = length(hay)
    if n == 0 {
        return 0
    }
    if n > h {
        return EOF
    }
    var i: u64 = 0
    while i + n <= h {
        if strneq(hay + i, needle, n) {
            return i
        }
        i = i + 1
    }
    return EOF
}

// A decimal number out of a string. Everything that is not a digit ends
// it; an empty string is 0. Nothing here overflows: the value stops
// growing at 1e18 instead of wrapping, because `*` panics since round 72.
fn to_num(p: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    while *((p + i) as *mut u8) >= 48 as u8 && *((p + i) as *mut u8) <= 57 as u8 {
        if v < 1000000000000000000 {
            v = v * 10 + ((*((p + i) as *mut u8)) as u64 - 48)
        }
        i = i + 1
    }
    return v
}

// Two strings in the order `sort` wants them: 0 equal, 1 a before b,
// 2 b before a. Octet by octet, unsigned -- which is what `LC_ALL=C`
// means on a system that has one.
fn cmp(a: u64, b: u64) -> u64 {
    var i: u64 = 0
    while i < 4096 {
        let x: u64 = (*((a + i) as *mut u8)) as u64
        let y: u64 = (*((b + i) as *mut u8)) as u64
        if x != y {
            if x < y {
                return 1
            }
            return 2
        }
        if x == 0 {
            return 0
        }
        i = i + 1
    }
    return 0
}

// A number in a column of `w` octets, right aligned. `ls -l` and `df`
// are tables, and a table whose columns do not line up is a list.
fn pad(v: u64, w: u64) {
    var buf: [u8; 26] = [0 as u8; 26]
    let n: u64 = digits(v, (&buf[0]) as u64)
    var sp: [u8; 2] = " \0"
    var i: u64 = n
    while i < w {
        say((&sp[0]) as u64)
        i = i + 1
    }
    put((&buf[0]) as u64, n)
}

// ------------------------------------------------ what `stat` answers
//
// ROUND K6 ASKED THE KERNEL TWO QUESTIONS AND GOT TWO CALLS FOR THEM:
// `SYS_STAT(path)` handed back the SIZE of a file and `SYS_LIST(path, 0,
// buf)` failed when the path was not a directory. Round K4 replaced both
// with Linux's `stat`, which fills a structure of 144 octets, and these
// two functions are what is left of the old shape -- the structure is
// filled on the CALLER'S STACK and read here, so that no program has to
// know where `st_mode` lies.

// Three programs have to refuse a directory -- `ls`, `cp` and `cat` --
// and one has to insist on one: `rmdir`. A path that is not there is not
// a directory; the caller that cares about the difference asks `size_of`
// afterwards and gets the real reason.
fn is_dir(path: u64) -> bool {
    let m: u64 = io.stat_mode(path)
    if errno.failed(m) {
        return false
    }
    return io.is_dir_mode(m)
}

// The size of a file, or a negative error. `ls -l` prints it.
fn size_of(path: u64) -> u64 {
    return io.size_of(path)
}

// The last component of a path: `/bin/sh` -> `sh`.
fn base_name(p: u64) -> u64 {
    let n: u64 = length(p)
    var i: u64 = n
    while i > 0 {
        i = i - 1
        if *((p + i) as *mut u8) == 47 as u8 {
            return p + i + 1
        }
    }
    return p
}

// ------------------------------------------------------- and processes
//
// THESE TWO GO STRAIGHT TO `kcall` AND NOT TO `osum.libc.proc`, and the
// reason is a number: `proc.fi` of the libc flushes the buffered output
// before it forks, so it imports `stdio`, which imports the ALLOCATOR --
// and every one of the twenty-six programs would then carry a heap it
// never uses. That was 41392 octets per program and 2235368 for the whole
// userland out of firnc1, against a drive of 2097152. A program that
// wants buffered output imports `osum.libc.stdio` itself.

// What round K1's `SYS_WAIT` gave back in one register: the CODE the child
// left with. Round K4's `wait4` returns the pid and writes a status word
// of four octets, and the code is bits 8..15 of it.
fn wait_code(pid: u64) -> u64 {
    var status: [u64; 1] = [0 as u64; 1]
    let r: u64 = errno.check(kcall.sys4(60 + 1, pid, (&status[0]) as u64,
            0, 0))
    if errno.failed(r) {
        return r
    }
    return (status[0] >> 8) & 255
}

// Milliseconds. Round K1 counted them in a register; `nanosleep` takes a
// `struct timespec` of two words, and this is the one place that builds
// one. More than sixty seconds is refused by the kernel on purpose.
fn sleep_ms(ms: u64) -> u64 {
    var ts: [u64; 2] = [0 as u64; 2]
    ts[0] = ms / 1000
    ts[1] = (ms % 1000) * 1000000
    return errno.check(kcall.sys2(35, (&ts[0]) as u64, 0))
}

// ------------------------------------------------------------ input

// A line at a time out of a descriptor, and the buffer belongs to the
// CALLER: a program on this system has no allocator, so the reader is a
// piece of memory that is handed in. The first sixteen octets are how
// much is in it and how much of that was eaten.
const RD_SIZE: u64 = 528

fn rd_init(ctx: u64) {
    __mmio_write64((ctx) as *mut u64, 0)
    __mmio_write64((ctx + 8) as *mut u64, 0)
}

// The next octet, or 256 at the end of the input. 256 and not 0, because
// 0 is an octet a file may hold.
fn rd_byte(fd: u64, ctx: u64) -> u64 {
    var len: u64 = *((ctx) as *mut u64)
    var pos: u64 = *((ctx + 8) as *mut u64)
    if pos >= len {
        let n: u64 = io.read(fd, ctx + 16, 512)
        if n == 0 || errno.failed(n) {
            return 256
        }
        __mmio_write64((ctx) as *mut u64, n)
        __mmio_write64((ctx + 8) as *mut u64, 0)
        len = n
        pos = 0
    }
    let c: u64 = (*((ctx + 16 + pos) as *mut u8)) as u64
    __mmio_write64((ctx + 8) as *mut u64, pos + 1)
    return c
}

// One line without its newline, zero terminated. Returns its length, or
// EOF when there was not even an empty line left. A line longer than
// `max` is cut and the rest of it is thrown away -- a program with 128
// octets of buffer may not be talked into writing over its own stack.
fn rd_line(fd: u64, ctx: u64, out: u64, max: u64) -> u64 {
    var c: u64 = rd_byte(fd, ctx)
    if c == 256 {
        return EOF
    }
    var n: u64 = 0
    while c != 256 && c != 10 {
        if n + 1 < max {
            __mmio_write8((out + n) as *mut u8, c as u8)
            n = n + 1
        }
        c = rd_byte(fd, ctx)
    }
    __mmio_write8((out + n) as *mut u8, 0 as u8)
    return n
}
