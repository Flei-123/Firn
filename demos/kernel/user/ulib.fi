// demos/kernel/user/ulib.fi -- round K1: what a program on the disk has
// instead of a standard library.
//
// Every program under `demos/kernel/user/` is compiled into an ELF FILE
// OF ITS OWN and lands on the disk, not in the kernel image. It therefore
// has nothing: no allocator, no collector, no libc, no kernel it could
// call into. The only door out of a process is `syscall`, and this file
// is that door plus the four routines that are needed to say anything at
// all.
//
// Two rules, and `tools/osum/run.sh` checks both on the finished file:
//
//   1. NO UNDEFINED NAME apart from the ones crt.s defines itself. What
//      is not here does not exist down here.
//   2. EVERY output and every look at the disk is a system call. The
//      numbers are the ones in `demos/kernel/sys.fi`.
//
// The argument block is the second thing that is new in this round. The
// kernel builds it on the top stack page of the process before the first
// instruction runs (`demos/kernel/elf.fi`, `write_args`) and hands its
// address in rdi:
//
//     +0   argc
//     +8   argv[0] .. argv[argc-1], then a zero
//     +80  the strings themselves, each one ended by a zero
//
// `arg_count` and `arg_at` are the two lines that read it.

export {
    sys, say, put, sayn, sayu, say_line, nl, length, streq, word, digits,
    arg_count, arg_at,
    SYS_EXIT, SYS_WRITE, SYS_READ, SYS_GETPID, SYS_SLEEP, SYS_SPAWN,
    SYS_WAIT, SYS_OPEN, SYS_CLOSE, SYS_UNLINK, SYS_LIST, SYS_MKDIR,
    SYS_YIELD, SYS_STAT, SYS_GETPPID, SYS_EXEC,
    SYS_DUP2, SYS_SEEK, SYS_CHDIR, SYS_GETCWD, SYS_SYSINFO, SYS_PSTAT,
    SYS_KILL,
    I_TICKS, I_UPTIME, I_FRAMES_FREE, I_FRAMES_ALL, I_BLOCKS, I_BFREE,
    I_INODES, I_IUSED, I_BSIZE, I_TASKS, I_SYSCALLS, I_VERSION,
    I_YEAR, I_MONTH, I_DAY, I_HOUR, I_MIN, I_SEC,
    P_STATE, P_PID, P_PPID, P_KIND, P_PRIO, P_TICKS, P_EXIT, P_FAULTS,
    bad, eput, esay_line, copy, fill, strcpy, strncpy, strcat, strneq, find,
    to_num, cmp, pad, is_dir, base_name,
    rd_init, rd_byte, rd_line, RD_SIZE, EOF,
    IN, OUT, ERR
}

const SYS_EXIT: u64 = 10
const SYS_WRITE: u64 = 11
const SYS_READ: u64 = 12
const SYS_GETPID: u64 = 13
const SYS_SLEEP: u64 = 14
const SYS_SPAWN: u64 = 15
const SYS_WAIT: u64 = 16
const SYS_OPEN: u64 = 17
const SYS_CLOSE: u64 = 18
const SYS_UNLINK: u64 = 19
const SYS_LIST: u64 = 20
const SYS_MKDIR: u64 = 21
const SYS_YIELD: u64 = 22
const SYS_STAT: u64 = 23
const SYS_GETPPID: u64 = 24
const SYS_EXEC: u64 = 25

// ROUND K6. The seven calls a userland needs and a single program does
// not (`demos/kernel/uio.fi`): where a descriptor points, where it stands
// in a file, which directory a name is relative to, and three questions
// about the machine that `ps`, `df`, `date` and `uname` may not answer by
// reading a kernel variable.
const SYS_DUP2: u64 = 40
const SYS_SEEK: u64 = 41
const SYS_CHDIR: u64 = 42
const SYS_GETCWD: u64 = 43
const SYS_SYSINFO: u64 = 44
const SYS_PSTAT: u64 = 45
const SYS_KILL: u64 = 46

// The fields of SYS_SYSINFO.
const I_TICKS: u64 = 0
const I_UPTIME: u64 = 1
const I_FRAMES_FREE: u64 = 2
const I_FRAMES_ALL: u64 = 3
const I_BLOCKS: u64 = 4
const I_BFREE: u64 = 5
const I_INODES: u64 = 6
const I_IUSED: u64 = 7
const I_BSIZE: u64 = 8
const I_TASKS: u64 = 9
const I_SYSCALLS: u64 = 10
const I_VERSION: u64 = 11
const I_YEAR: u64 = 12
const I_MONTH: u64 = 13
const I_DAY: u64 = 14
const I_HOUR: u64 = 15
const I_MIN: u64 = 16
const I_SEC: u64 = 17

// The fields of SYS_PSTAT.
const P_STATE: u64 = 0
const P_PID: u64 = 1
const P_PPID: u64 = 2
const P_KIND: u64 = 3
const P_PRIO: u64 = 4
const P_TICKS: u64 = 5
const P_EXIT: u64 = 6
const P_FAULTS: u64 = 7

const IN: u64 = 0
const OUT: u64 = 1
const ERR: u64 = 2

// ------------------------------------------------------ the system call

// rax = number, rdi/rsi/rdx = the three arguments, rax = result.
// `syscall` destroys rcx and r11 -- the processor puts the return address
// and the flags in them.
fn sys(number: u64, a0: u64, a1: u64, a2: u64) -> u64 {
    return asm("syscall", out("rax"), in("rax") number, in("rdi") a0,
        in("rsi") a1, in("rdx") a2, clobber("rcx"), clobber("r11"),
        clobber("memory"))
}

// ------------------------------------------------------------- output

fn length(p: u64) -> u64 {
    var n: u64 = 0
    while *((p + n) as *mut u8) != 0 as u8 {
        n = n + 1
    }
    return n
}

fn say(p: u64) -> u64 {
    return sys(SYS_WRITE, OUT, p, length(p))
}

fn put(p: u64, n: u64) -> u64 {
    return sys(SYS_WRITE, OUT, p, n)
}

fn nl() {
    var s: [u8; 2] = "\n\0"
    say((&s[0]) as u64)
}

// A number without a standard library: the digits come out backwards and
// are turned around. A NEGATIVE result of a system call is an error code,
// and the minus is a REINTERPRETATION, not a subtraction -- what arrives
// is the bit pattern of an `i64` in a `u64` register, and `0 -% v` is the
// two's complement negation. Plain `-` is checked since round 72 and
// would call `osum_panic` for every value this branch ever sees.
fn digits(v: u64, out: u64) -> u64 {
    var value: u64 = v
    var at: u64 = 0
    if (v >> 63) != 0 {
        __mmio_write8(out as *mut u8, 45 as u8)
        at = 1
        value = 0 -% v
    }
    var back: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    if value == 0 {
        back[0] = 48 as u8
        n = 1
    }
    while value > 0 {
        back[n as usize] = (48 + value % 10) as u8
        value = value / 10
        n = n + 1
    }
    var i: u64 = n
    while i > 0 {
        i = i - 1
        __mmio_write8((out + at) as *mut u8, back[i as usize])
        at = at + 1
    }
    __mmio_write8((out + at) as *mut u8, 0 as u8)
    return at
}

fn sayn(v: u64) {
    var buf: [u8; 26] = [0 as u8; 26]
    let n: u64 = digits(v, (&buf[0]) as u64)
    put((&buf[0]) as u64, n)
}

// The same without the sign. A value that is not a result of a system
// call is not an error code, and reading its top bit as a minus would
// turn the poison pattern of the loader into a riddle.
fn sayu(v: u64) {
    var buf: [u8; 26] = [0 as u8; 26]
    var back: [u8; 24] = [0 as u8; 24]
    var value: u64 = v
    var n: u64 = 0
    if value == 0 {
        back[0] = 48 as u8
        n = 1
    }
    while value > 0 {
        back[n as usize] = (48 + value % 10) as u8
        value = value / 10
        n = n + 1
    }
    var at: u64 = 0
    var i: u64 = n
    while i > 0 {
        i = i - 1
        buf[at as usize] = back[i as usize]
        at = at + 1
    }
    put((&buf[0]) as u64, at)
}

fn say_line(p: u64, v: u64) {
    say(p)
    sayn(v)
    nl()
}

// ------------------------------------------------------------ strings

fn streq(a: u64, b: u64) -> bool {
    var i: u64 = 0
    while i < 64 {
        let x: u64 = (*((a + i) as *mut u8)) as u64
        let y: u64 = (*((b + i) as *mut u8)) as u64
        if x != y {
            return false
        }
        if x == 0 {
            return true
        }
        i = i + 1
    }
    return true
}

// The next word of `line` from `at` on into `out`; returns where the word
// ended. Spaces separate, and a word longer than `max` is cut instead of
// running over the buffer.
fn word(line: u64, at: u64, out: u64, max: u64) -> u64 {
    var i: u64 = at
    while *((line + i) as *mut u8) == 32 as u8 {
        i = i + 1
    }
    var n: u64 = 0
    while *((line + i) as *mut u8) != 0 as u8 {
        if *((line + i) as *mut u8) == 32 as u8 {
            __mmio_write8((out + n) as *mut u8, 0 as u8)
            return i
        }
        if n + 1 < max {
            __mmio_write8((out + n) as *mut u8, *((line + i) as *mut u8))
            n = n + 1
        }
        i = i + 1
    }
    __mmio_write8((out + n) as *mut u8, 0 as u8)
    return i
}

// ---------------------------------------------------- the argument block

fn arg_count(args: u64) -> u64 {
    if args == 0 {
        return 0
    }
    return *((args) as *mut u64)
}

fn arg_at(args: u64, i: u64) -> u64 {
    if i >= arg_count(args) {
        return 0
    }
    return *((args + 8 + i * 8) as *mut u64)
}

// ====================================================== round K6: the rest
//
// What twenty-three programs turned out to need more than once. Every one
// of them is here and not in the programs, because a userland in which
// `head` and `tail` each carry their own idea of what a line is would be
// twenty-three userlands.

const EOF: u64 = 0xFFFFFFFFFFFFFFFF

// A system call answered with an error. The bit pattern is that of a
// negative `i64`, so the top bit is the whole test.
fn bad(v: u64) -> bool {
    return (v >> 63) != 0
}

// Anything that went wrong goes to descriptor 2. That is not decoration:
// `cmd > file` moves descriptor 1 and leaves 2 where it was, and a
// program that reported its errors on 1 would write them into the file.
fn eput(p: u64) -> u64 {
    return sys(SYS_WRITE, ERR, p, length(p))
}

fn esay_line(p: u64, q: u64) {
    eput(p)
    if q != 0 {
        eput(q)
    }
    var nlc: [u8; 2] = "\n\0"
    eput((&nlc[0]) as u64)
}

fn copy(dst: u64, src: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        __mmio_write8((dst + i) as *mut u8, *((src + i) as *mut u8))
        i = i + 1
    }
}

fn fill(dst: u64, v: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        __mmio_write8((dst + i) as *mut u8, v as u8)
        i = i + 1
    }
}

fn strcpy(dst: u64, src: u64) -> u64 {
    let n: u64 = length(src)
    copy(dst, src, n)
    __mmio_write8((dst + n) as *mut u8, 0 as u8)
    return n
}

// The same with a ceiling, and it is not decoration: a word out of a
// shell line may be two hundred octets long and the buffer it is copied
// into is ninety-six. `strcpy` would write over the stack of the caller,
// and the check would come later, in the kernel, which is too late.
fn strncpy(dst: u64, src: u64, max: u64) -> u64 {
    var n: u64 = 0
    while n + 1 < max && *((src + n) as *mut u8) != 0 as u8 {
        __mmio_write8((dst + n) as *mut u8, *((src + n) as *mut u8))
        n = n + 1
    }
    __mmio_write8((dst + n) as *mut u8, 0 as u8)
    return n
}

fn strcat(dst: u64, src: u64) -> u64 {
    let at: u64 = length(dst)
    return at + strcpy(dst + at, src)
}

fn strneq(a: u64, b: u64, n: u64) -> bool {
    var i: u64 = 0
    while i < n {
        let x: u64 = (*((a + i) as *mut u8)) as u64
        if x != (*((b + i) as *mut u8)) as u64 {
            return false
        }
        if x == 0 {
            return true
        }
        i = i + 1
    }
    return true
}

// Where `needle` stands in `hay`, or EOF. The whole of what `grep` knows
// about patterns -- a regular expression is a round of its own.
fn find(hay: u64, needle: u64) -> u64 {
    let n: u64 = length(needle)
    let h: u64 = length(hay)
    if n == 0 {
        return 0
    }
    if n > h {
        return EOF
    }
    var i: u64 = 0
    while i + n <= h {
        if strneq(hay + i, needle, n) {
            return i
        }
        i = i + 1
    }
    return EOF
}

// A decimal number out of a string. Everything that is not a digit ends
// it; an empty string is 0. Nothing here overflows: the value stops
// growing at 1e18 instead of wrapping, because `*` panics since round 72.
fn to_num(p: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    while *((p + i) as *mut u8) >= 48 as u8 && *((p + i) as *mut u8) <= 57 as u8 {
        if v < 1000000000000000000 {
            v = v * 10 + ((*((p + i) as *mut u8)) as u64 - 48)
        }
        i = i + 1
    }
    return v
}

// Two strings in the order `sort` wants them: 0 equal, 1 a before b,
// 2 b before a. Octet by octet, unsigned -- which is what `LC_ALL=C`
// means on a system that has one.
fn cmp(a: u64, b: u64) -> u64 {
    var i: u64 = 0
    while i < 4096 {
        let x: u64 = (*((a + i) as *mut u8)) as u64
        let y: u64 = (*((b + i) as *mut u8)) as u64
        if x != y {
            if x < y {
                return 1
            }
            return 2
        }
        if x == 0 {
            return 0
        }
        i = i + 1
    }
    return 0
}

// A number in a column of `w` octets, right aligned. `ls -l` and `df`
// are tables, and a table whose columns do not line up is a list.
fn pad(v: u64, w: u64) {
    var buf: [u8; 26] = [0 as u8; 26]
    let n: u64 = digits(v, (&buf[0]) as u64)
    var sp: [u8; 2] = " \0"
    var i: u64 = n
    while i < w {
        say((&sp[0]) as u64)
        i = i + 1
    }
    put((&buf[0]) as u64, n)
}

// SYS_STAT says how big a file is and SYS_LIST what kind an entry is.
// Neither answers "is this path a directory", and three programs need to
// know: `ls`, `cp` and `cat` all have to refuse one.
fn is_dir(path: u64) -> bool {
    var entry: [u8; 32] = [0 as u8; 32]
    return !bad(sys(SYS_LIST, path, 0, (&entry[0]) as u64))
}

// The last component of a path: `/bin/sh` -> `sh`.
fn base_name(p: u64) -> u64 {
    let n: u64 = length(p)
    var i: u64 = n
    while i > 0 {
        i = i - 1
        if *((p + i) as *mut u8) == 47 as u8 {
            return p + i + 1
        }
    }
    return p
}

// ------------------------------------------------------------ input

// A line at a time out of a descriptor, and the buffer belongs to the
// CALLER: a program on this system has no allocator, so the reader is a
// piece of memory that is handed in. The first sixteen octets are how
// much is in it and how much of that was eaten.
const RD_SIZE: u64 = 528

fn rd_init(ctx: u64) {
    __mmio_write64((ctx) as *mut u64, 0)
    __mmio_write64((ctx + 8) as *mut u64, 0)
}

// The next octet, or 256 at the end of the input. 256 and not 0, because
// 0 is an octet a file may hold.
fn rd_byte(fd: u64, ctx: u64) -> u64 {
    var len: u64 = *((ctx) as *mut u64)
    var pos: u64 = *((ctx + 8) as *mut u64)
    if pos >= len {
        let n: u64 = sys(SYS_READ, fd, ctx + 16, 512)
        if n == 0 || bad(n) {
            return 256
        }
        __mmio_write64((ctx) as *mut u64, n)
        __mmio_write64((ctx + 8) as *mut u64, 0)
        len = n
        pos = 0
    }
    let c: u64 = (*((ctx + 16 + pos) as *mut u8)) as u64
    __mmio_write64((ctx + 8) as *mut u64, pos + 1)
    return c
}

// One line without its newline, zero terminated. Returns its length, or
// EOF when there was not even an empty line left. A line longer than
// `max` is cut and the rest of it is thrown away -- a program with 128
// octets of buffer may not be talked into writing over its own stack.
fn rd_line(fd: u64, ctx: u64, out: u64, max: u64) -> u64 {
    var c: u64 = rd_byte(fd, ctx)
    if c == 256 {
        return EOF
    }
    var n: u64 = 0
    while c != 256 && c != 10 {
        if n + 1 < max {
            __mmio_write8((out + n) as *mut u8, c as u8)
            n = n + 1
        }
        c = rd_byte(fd, ctx)
    }
    __mmio_write8((out + n) as *mut u8, 0 as u8)
    return n
}
