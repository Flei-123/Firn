// demos/kernel/user/ulib.fi -- round K1: what a program on the disk has
// instead of a standard library.
//
// Every program under `demos/kernel/user/` is compiled into an ELF FILE
// OF ITS OWN and lands on the disk, not in the kernel image. It therefore
// has nothing: no allocator, no collector, no libc, no kernel it could
// call into. The only door out of a process is `syscall`, and this file
// is that door plus the four routines that are needed to say anything at
// all.
//
// Two rules, and `tools/osum/run.sh` checks both on the finished file:
//
//   1. NO UNDEFINED NAME apart from the ones crt.s defines itself. What
//      is not here does not exist down here.
//   2. EVERY output and every look at the disk is a system call. The
//      numbers are the ones in `demos/kernel/sys.fi`.
//
// The argument block is the second thing that is new in this round. The
// kernel builds it on the top stack page of the process before the first
// instruction runs (`demos/kernel/elf.fi`, `write_args`) and hands its
// address in rdi:
//
//     +0   argc
//     +8   argv[0] .. argv[argc-1], then a zero
//     +80  the strings themselves, each one ended by a zero
//
// `arg_count` and `arg_at` are the two lines that read it.

export {
    sys, say, put, sayn, sayu, say_line, nl, length, streq, word, digits,
    arg_count, arg_at,
    SYS_EXIT, SYS_WRITE, SYS_READ, SYS_GETPID, SYS_SLEEP, SYS_SPAWN,
    SYS_WAIT, SYS_OPEN, SYS_CLOSE, SYS_UNLINK, SYS_LIST, SYS_MKDIR,
    SYS_YIELD, SYS_STAT, SYS_GETPPID, SYS_EXEC,
    IN, OUT, ERR
}

const SYS_EXIT: u64 = 10
const SYS_WRITE: u64 = 11
const SYS_READ: u64 = 12
const SYS_GETPID: u64 = 13
const SYS_SLEEP: u64 = 14
const SYS_SPAWN: u64 = 15
const SYS_WAIT: u64 = 16
const SYS_OPEN: u64 = 17
const SYS_CLOSE: u64 = 18
const SYS_UNLINK: u64 = 19
const SYS_LIST: u64 = 20
const SYS_MKDIR: u64 = 21
const SYS_YIELD: u64 = 22
const SYS_STAT: u64 = 23
const SYS_GETPPID: u64 = 24
const SYS_EXEC: u64 = 25

const IN: u64 = 0
const OUT: u64 = 1
const ERR: u64 = 2

// ------------------------------------------------------ the system call

// rax = number, rdi/rsi/rdx = the three arguments, rax = result.
// `syscall` destroys rcx and r11 -- the processor puts the return address
// and the flags in them.
fn sys(number: u64, a0: u64, a1: u64, a2: u64) -> u64 {
    return asm("syscall", out("rax"), in("rax") number, in("rdi") a0,
        in("rsi") a1, in("rdx") a2, clobber("rcx"), clobber("r11"),
        clobber("memory"))
}

// ------------------------------------------------------------- output

fn length(p: u64) -> u64 {
    var n: u64 = 0
    while *((p + n) as *mut u8) != 0 as u8 {
        n = n + 1
    }
    return n
}

fn say(p: u64) -> u64 {
    return sys(SYS_WRITE, OUT, p, length(p))
}

fn put(p: u64, n: u64) -> u64 {
    return sys(SYS_WRITE, OUT, p, n)
}

fn nl() {
    var s: [u8; 2] = "\n\0"
    say((&s[0]) as u64)
}

// A number without a standard library: the digits come out backwards and
// are turned around. A NEGATIVE result of a system call is an error code,
// and the minus is a REINTERPRETATION, not a subtraction -- what arrives
// is the bit pattern of an `i64` in a `u64` register, and `0 -% v` is the
// two's complement negation. Plain `-` is checked since round 72 and
// would call `osum_panic` for every value this branch ever sees.
fn digits(v: u64, out: u64) -> u64 {
    var value: u64 = v
    var at: u64 = 0
    if (v >> 63) != 0 {
        __mmio_write8(out as *mut u8, 45 as u8)
        at = 1
        value = 0 -% v
    }
    var back: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    if value == 0 {
        back[0] = 48 as u8
        n = 1
    }
    while value > 0 {
        back[n as usize] = (48 + value % 10) as u8
        value = value / 10
        n = n + 1
    }
    var i: u64 = n
    while i > 0 {
        i = i - 1
        __mmio_write8((out + at) as *mut u8, back[i as usize])
        at = at + 1
    }
    __mmio_write8((out + at) as *mut u8, 0 as u8)
    return at
}

fn sayn(v: u64) {
    var buf: [u8; 26] = [0 as u8; 26]
    let n: u64 = digits(v, (&buf[0]) as u64)
    put((&buf[0]) as u64, n)
}

// The same without the sign. A value that is not a result of a system
// call is not an error code, and reading its top bit as a minus would
// turn the poison pattern of the loader into a riddle.
fn sayu(v: u64) {
    var buf: [u8; 26] = [0 as u8; 26]
    var back: [u8; 24] = [0 as u8; 24]
    var value: u64 = v
    var n: u64 = 0
    if value == 0 {
        back[0] = 48 as u8
        n = 1
    }
    while value > 0 {
        back[n as usize] = (48 + value % 10) as u8
        value = value / 10
        n = n + 1
    }
    var at: u64 = 0
    var i: u64 = n
    while i > 0 {
        i = i - 1
        buf[at as usize] = back[i as usize]
        at = at + 1
    }
    put((&buf[0]) as u64, at)
}

fn say_line(p: u64, v: u64) {
    say(p)
    sayn(v)
    nl()
}

// ------------------------------------------------------------ strings

fn streq(a: u64, b: u64) -> bool {
    var i: u64 = 0
    while i < 64 {
        let x: u64 = (*((a + i) as *mut u8)) as u64
        let y: u64 = (*((b + i) as *mut u8)) as u64
        if x != y {
            return false
        }
        if x == 0 {
            return true
        }
        i = i + 1
    }
    return true
}

// The next word of `line` from `at` on into `out`; returns where the word
// ended. Spaces separate, and a word longer than `max` is cut instead of
// running over the buffer.
fn word(line: u64, at: u64, out: u64, max: u64) -> u64 {
    var i: u64 = at
    while *((line + i) as *mut u8) == 32 as u8 {
        i = i + 1
    }
    var n: u64 = 0
    while *((line + i) as *mut u8) != 0 as u8 {
        if *((line + i) as *mut u8) == 32 as u8 {
            __mmio_write8((out + n) as *mut u8, 0 as u8)
            return i
        }
        if n + 1 < max {
            __mmio_write8((out + n) as *mut u8, *((line + i) as *mut u8))
            n = n + 1
        }
        i = i + 1
    }
    __mmio_write8((out + n) as *mut u8, 0 as u8)
    return i
}

// ---------------------------------------------------- the argument block

fn arg_count(args: u64) -> u64 {
    if args == 0 {
        return 0
    }
    return *((args) as *mut u64)
}

fn arg_at(args: u64, i: u64) -> u64 {
    if i >= arg_count(args) {
        return 0
    }
    return *((args + 8 + i * 8) as *mut u64)
}
