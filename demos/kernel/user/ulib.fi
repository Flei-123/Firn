// demos/kernel/user/ulib.fi -- round K1: what a program on the disk has
// instead of a standard library. ROUND K4: it HAS one now.
//
// Round K1 wrote this file because there was nothing: no allocator, no
// collector, no libc, no kernel to call into -- the only door out of a
// process was `syscall`, and this file was that door plus the four
// routines needed to say anything at all.
//
// Round K4 built the library that belongs under it (`lib/osum/libc/`), and
// this file is now what it should have been from the start: a THIN LAYER,
// four lines per function, that keeps the names the programs of round K1
// use while everything underneath goes through the libc. Nothing here has
// its own idea of how a number is printed or how long a text is any more.
//
// The two rules of round K1 still hold, and `tools/osum/run.sh` still
// checks both on the finished file:
//
//   1. NO UNDEFINED NAME apart from the ones crt.s defines itself.
//   2. EVERY output and every look at the disk is a system call.
//
// The argument block is unchanged. The kernel builds it on the top stack
// page of the process before the first instruction runs
// (`demos/kernel/elf.fi`, `write_args`) and hands its address in rdi:
//
//     +0   argc
//     +8   argv[0] .. argv[argc-1], then a zero
//     +80  the strings themselves, each one ended by a zero

import osum.libc.kcall
import osum.libc.errno
import osum.libc.text
import osum.libc.io

export {
    sys, say, put, sayn, sayu, say_line, nl, length, streq, word, digits,
    arg_count, arg_at, failed,
    IN, OUT, ERR
}

const IN: u64 = 0
const OUT: u64 = 1
const ERR: u64 = 2

// ------------------------------------------------------ the system call

// The raw door, kept because the programs of round K1 use it by name and
// because a test of a system call should be able to make one WITHOUT a
// library in between (`/bin/posix` does exactly that for its error cases).
fn sys(number: u64, a0: u64, a1: u64, a2: u64) -> u64 {
    return kcall.sys3(number, a0, a1, a2)
}

// Did a call fail? A negative answer is an error, and the top 4096 values
// are the errors -- the same rule the kernel uses.
fn failed(v: u64) -> bool {
    return errno.is_error(v)
}

// ------------------------------------------------------------- output

// Unbuffered on purpose. `osum.libc.stdio` has the buffered output, and
// what a program of round K1 does is print a line and then possibly walk
// into a page fault (`/bin/hurt`) -- a buffer would swallow exactly the
// line that says what it was about to do.
fn length(p: u64) -> u64 {
    return text.length(p)
}

fn say(p: u64) -> u64 {
    return io.write_text(OUT, p)
}

fn put(p: u64, n: u64) -> u64 {
    return io.write_all(OUT, p, n)
}

fn nl() {
    var s: [u8; 2] = "\n\0"
    say((&s[0]) as u64)
}

fn digits(v: u64, out: u64) -> u64 {
    return text.digits(v, out, true)
}

// A number that may be an error code: the top bit is a minus.
fn sayn(v: u64) {
    var buf: [u8; 26] = [0 as u8; 26]
    let n: u64 = text.digits(v, (&buf[0]) as u64, true)
    put((&buf[0]) as u64, n)
}

// The same without the sign. A value that is not a result of a system call
// is not an error code, and reading its top bit as a minus would turn the
// poison pattern of the loader into a riddle.
fn sayu(v: u64) {
    var buf: [u8; 26] = [0 as u8; 26]
    let n: u64 = text.digits(v, (&buf[0]) as u64, false)
    put((&buf[0]) as u64, n)
}

fn say_line(p: u64, v: u64) {
    say(p)
    sayn(v)
    nl()
}

// ------------------------------------------------------------ strings

fn streq(a: u64, b: u64) -> bool {
    return text.equal(a, b)
}

// The next word of `line` from `at` on into `out`; returns where the word
// ended. Spaces separate, and a word longer than `max` is cut instead of
// running over the buffer.
fn word(line: u64, at: u64, out: u64, max: u64) -> u64 {
    var i: u64 = at
    while *((line + i) as *mut u8) == 32 as u8 {
        i = i + 1
    }
    var n: u64 = 0
    while *((line + i) as *mut u8) != 0 as u8 {
        if *((line + i) as *mut u8) == 32 as u8 {
            __mmio_write8((out + n) as *mut u8, 0 as u8)
            return i
        }
        if n + 1 < max {
            __mmio_write8((out + n) as *mut u8, *((line + i) as *mut u8))
            n = n + 1
        }
        i = i + 1
    }
    __mmio_write8((out + n) as *mut u8, 0 as u8)
    return i
}

// ---------------------------------------------------- the argument block

fn arg_count(args: u64) -> u64 {
    if args == 0 {
        return 0
    }
    return *((args) as *mut u64)
}

fn arg_at(args: u64, i: u64) -> u64 {
    if i >= arg_count(args) {
        return 0
    }
    return *((args + 8 + i * 8) as *mut u64)
}
