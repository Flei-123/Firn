// demos/kernel/user/rmdir.fi -- round K6: a directory, and only an empty
// one.
//
// The refusal is not in this program: `fs.unlink_path` counts the entries
// and leaves a directory that still holds something standing. What this
// program adds is the check that the path IS a directory -- `rmdir file`
// must not quietly delete a file.

profile kernel

import ulib

export { u_start }

fn u_start(args: u64) -> u64 {
    var s_err: [u8; 22] = "rmdir: cannot remove \0"
    var s_not: [u8; 24] = "rmdir: not a directory \0"
    var s_use: [u8; 20] = "rmdir: needs a path\0"

    let argc: u64 = ulib.arg_count(args)
    if argc < 2 {
        ulib.esay_line((&s_use[0 as usize]) as u64, 0)
        return 1
    }
    var code: u64 = 0
    var k: u64 = 1
    while k < argc {
        let p: u64 = ulib.arg_at(args, k)
        if !ulib.is_dir(p) {
            ulib.esay_line((&s_not[0 as usize]) as u64, p)
            code = 1
        } else if ulib.bad(ulib.sys(ulib.SYS_UNLINK, p, 0, 0)) {
            ulib.esay_line((&s_err[0 as usize]) as u64, p)
            code = 1
        }
        k = k + 1
    }
    return code
}
