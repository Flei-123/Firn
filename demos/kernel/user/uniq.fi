// demos/kernel/user/uniq.fi -- round K6: the same line, once.
//
// ADJACENT lines only, the way it is everywhere: `uniq` after `sort` is
// the pair that makes a set, and a `uniq` that remembered everything
// would need the memory `sort` needs.
//
// `-c` writes how often each line stood there, which is the number a
// count of anything ends in.

profile kernel

import ulib

export { u_start }

fn u_start(args: u64) -> u64 {
    var s_open: [u8; 19] = "uniq: cannot open \0"
    var opt_c: [u8; 3] = "-c\0"
    let argc: u64 = ulib.arg_count(args)
    var counting: bool = false
    var start: u64 = 1
    if argc > 1 && ulib.streq(ulib.arg_at(args, 1), (&opt_c[0 as usize]) as u64) {
        counting = true
        start = 2
    }
    if start >= argc {
        thin(ulib.IN, counting)
        return 0
    }
    let p: u64 = ulib.arg_at(args, start)
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, p, 0, 0)
    if ulib.bad(fd) {
        ulib.esay_line((&s_open[0 as usize]) as u64, p)
        return 1
    }
    thin(fd, counting)
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    return 0
}

fn thin(fd: u64, counting: bool) {
    var ctx: [u8; 528] = [0 as u8; 528]
    var line: [u8; 256] = [0 as u8; 256]
    var held: [u8; 256] = [0 as u8; 256]
    var s_sp: [u8; 2] = " \0"
    ulib.rd_init((&ctx[0 as usize]) as u64)
    var have: bool = false
    var run: u64 = 0
    var going: bool = true
    while going {
        let len: u64 = ulib.rd_line(fd, (&ctx[0 as usize]) as u64,
            (&line[0 as usize]) as u64, 256)
        if ulib.bad(len) {
            going = false
        } else {
            if have && ulib.streq((&line[0 as usize]) as u64,
                (&held[0 as usize]) as u64) {
                run = run + 1
            } else {
                if have {
                    show((&held[0 as usize]) as u64, run, counting,
                        (&s_sp[0 as usize]) as u64)
                }
                ulib.strcpy((&held[0 as usize]) as u64,
                    (&line[0 as usize]) as u64)
                have = true
                run = 1
            }
        }
    }
    if have {
        show((&held[0 as usize]) as u64, run, counting,
            (&s_sp[0 as usize]) as u64)
    }
}

fn show(p: u64, run: u64, counting: bool, sp: u64) {
    if counting {
        ulib.sayu(run)
        ulib.say(sp)
    }
    ulib.say(p)
    ulib.nl()
}
