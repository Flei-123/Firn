// demos/kernel/user/echo.fi -- round K6: the argument block, read back.
//
// The smallest useful program there is, and the one that proves the
// kernel built argc/argv correctly: what the shell split into words has
// to come back out in the same order, separated by single spaces.
//
// It is also the program `tools/osum/run.sh` copies over `/bin/ls` to
// show that the kernel runs the FILE and not a name it knows.
//
// `-n` leaves the newline out, because a shell that writes a file with
// `echo -n x > f` needs a way to say how long the file is.

profile kernel

import ulib

export { u_start }

fn u_start(args: u64) -> u64 {
    var s_sp: [u8; 2] = " \0"
    var opt_n: [u8; 3] = "-n\0"
    let argc: u64 = ulib.arg_count(args)
    var first: u64 = 1
    var newline: bool = true
    if argc > 1 && ulib.streq(ulib.arg_at(args, 1), (&opt_n[0 as usize]) as u64) {
        newline = false
        first = 2
    }
    var i: u64 = first
    while i < argc {
        if i > first {
            ulib.say((&s_sp[0 as usize]) as u64)
        }
        ulib.say(ulib.arg_at(args, i))
        i = i + 1
    }
    if newline {
        ulib.nl()
    }
    return 0
}
