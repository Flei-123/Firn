// demos/kernel/user/tail.fi -- round K6: the last lines.
//
// The difference to `head` is the whole of what a program without an
// allocator has to think about: the last N lines are not known until the
// input has ended, so they are kept in a RING of N slots that the reader
// walks over. Ten lines of 128 octets is what a program with eight pages
// of stack can hold in its .bss without asking anybody.

profile kernel

import ulib

export { u_start }

const SLOTS: u64 = 16
const WIDTH: u64 = 128

static mut ring: [u8; 2048] = [0 as u8; 2048]

fn u_start(args: u64) -> u64 {
    var s_open: [u8; 19] = "tail: cannot open \0"
    var opt_n: [u8; 3] = "-n\0"
    let argc: u64 = ulib.arg_count(args)
    var want: u64 = 10
    var at: u64 = 1
    if argc > 2 && ulib.streq(ulib.arg_at(args, 1), (&opt_n[0 as usize]) as u64) {
        want = ulib.to_num(ulib.arg_at(args, 2))
        at = 3
    }
    if want > SLOTS {
        want = SLOTS
    }
    if want == 0 {
        return 0
    }
    if argc <= at {
        take(ulib.IN, want)
        return 0
    }
    var code: u64 = 0
    var k: u64 = at
    while k < argc {
        let p: u64 = ulib.arg_at(args, k)
        let fd: u64 = ulib.sys(ulib.SYS_OPEN, p, 0, 0)
        if ulib.bad(fd) {
            ulib.esay_line((&s_open[0 as usize]) as u64, p)
            code = 1
        } else {
            take(fd, want)
            ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
        }
        k = k + 1
    }
    return code
}

fn take(fd: u64, want: u64) {
    var ctx: [u8; 528] = [0 as u8; 528]
    var line: [u8; 256] = [0 as u8; 256]
    ulib.rd_init((&ctx[0 as usize]) as u64)
    var seen: u64 = 0
    var going: bool = true
    while going {
        let len: u64 = ulib.rd_line(fd, (&ctx[0 as usize]) as u64,
            (&line[0 as usize]) as u64, 256)
        if ulib.bad(len) {
            going = false
        } else {
            let slot: u64 = seen % want
            var i: u64 = 0
            while i < WIDTH - 1 && i < len {
                ring[(slot * WIDTH + i) as usize] = line[i as usize]
                i = i + 1
            }
            ring[(slot * WIDTH + i) as usize] = 0 as u8
            seen = seen + 1
        }
    }
    var first: u64 = 0
    var count: u64 = seen
    if seen > want {
        first = seen - want
        count = want
    }
    var k: u64 = 0
    while k < count {
        let slot: u64 = (first + k) % want
        ulib.say((&ring[(slot * WIDTH) as usize]) as u64)
        ulib.nl()
        k = k + 1
    }
}
