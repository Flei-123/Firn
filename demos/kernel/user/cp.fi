// demos/kernel/user/cp.fi -- round K6: the same octets under a second
// name.
//
// There is no `link` in this kernel and no `rename`, so a copy is what a
// copy is: read the one, write the other. `cp a b` where b is a
// DIRECTORY writes `b/a`, the way every system does it -- and that is the
// only piece of interpretation in this program.

profile kernel

import ulib

export { u_start }

fn u_start(args: u64) -> u64 {
    var s_use: [u8; 32] = "cp: needs a source and a target\0"
    var s_src: [u8; 17] = "cp: cannot open \0"
    var s_dst: [u8; 18] = "cp: cannot write \0"
    var s_dir: [u8; 20] = "cp: is a directory \0"
    var full: [u8; 128] = [0 as u8; 128]

    let argc: u64 = ulib.arg_count(args)
    if argc < 3 {
        ulib.esay_line((&s_use[0 as usize]) as u64, 0)
        return 1
    }
    let src: u64 = ulib.arg_at(args, 1)
    var dst: u64 = ulib.arg_at(args, 2)
    if ulib.is_dir(src) {
        ulib.esay_line((&s_dir[0 as usize]) as u64, src)
        return 1
    }
    if ulib.is_dir(dst) {
        var sl: [u8; 2] = "/\0"
        ulib.strcpy((&full[0 as usize]) as u64, dst)
        ulib.strcat((&full[0 as usize]) as u64, (&sl[0 as usize]) as u64)
        ulib.strcat((&full[0 as usize]) as u64, ulib.base_name(src))
        dst = (&full[0 as usize]) as u64
    }
    let in_fd: u64 = ulib.sys(ulib.SYS_OPEN, src, 0, 0)
    if ulib.bad(in_fd) {
        ulib.esay_line((&s_src[0 as usize]) as u64, src)
        return 1
    }
    // `>` in the shell truncates by taking the name away first, and a
    // copy has to do the same -- otherwise the tail of a longer file
    // stays standing behind the shorter one.
    ulib.sys(ulib.SYS_UNLINK, dst, 0, 0)
    let out_fd: u64 = ulib.sys(ulib.SYS_OPEN, dst, 1, 0)
    if ulib.bad(out_fd) {
        ulib.esay_line((&s_dst[0 as usize]) as u64, dst)
        ulib.sys(ulib.SYS_CLOSE, in_fd, 0, 0)
        return 1
    }
    var buf: [u8; 512] = [0 as u8; 512]
    var code: u64 = 0
    var going: bool = true
    while going {
        let n: u64 = ulib.sys(ulib.SYS_READ, in_fd,
            (&buf[0 as usize]) as u64, 512)
        if n == 0 || ulib.bad(n) {
            going = false
        } else {
            let w: u64 = ulib.sys(ulib.SYS_WRITE, out_fd,
                (&buf[0 as usize]) as u64, n)
            if ulib.bad(w) || w != n {
                ulib.esay_line((&s_dst[0 as usize]) as u64, dst)
                code = 1
                going = false
            }
        }
    }
    ulib.sys(ulib.SYS_CLOSE, in_fd, 0, 0)
    ulib.sys(ulib.SYS_CLOSE, out_fd, 0, 0)
    return code
}
