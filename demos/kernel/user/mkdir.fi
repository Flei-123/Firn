// demos/kernel/user/mkdir.fi -- round K6: a name that holds names.
//
// SYS_MKDIR does everything: it finds the parent, takes an inode, writes
// `.` and `..` into it and hangs it in. What is left for the program is
// the loop and the error message.

profile kernel

import ulib

export { u_start }

fn u_start(args: u64) -> u64 {
    var s_err: [u8; 22] = "mkdir: cannot create \0"
    var s_use: [u8; 20] = "mkdir: needs a path\0"

    let argc: u64 = ulib.arg_count(args)
    if argc < 2 {
        ulib.esay_line((&s_use[0 as usize]) as u64, 0)
        return 1
    }
    var code: u64 = 0
    var k: u64 = 1
    while k < argc {
        let p: u64 = ulib.arg_at(args, k)
        if ulib.bad(ulib.sys(ulib.SYS_MKDIR, p, 0, 0)) {
            ulib.esay_line((&s_err[0 as usize]) as u64, p)
            code = 1
        }
        k = k + 1
    }
    return code
}
