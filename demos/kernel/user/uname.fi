// demos/kernel/user/uname.fi -- round K6: what this machine is.
//
// The name is in the program, the ROUND is not: `SYS_SYSINFO` answers
// with the number the kernel was built with, so a program that says K6
// while the kernel is K7 cannot happen.

profile kernel

import ulib

export { u_start }

fn u_start(args: u64) -> u64 {
    var s_name: [u8; 5] = "osum\0"
    var s_all: [u8; 12] = "osum firn K\0"
    var s_arch: [u8; 8] = " x86_64\0"
    var opt_a: [u8; 3] = "-a\0"
    let argc: u64 = ulib.arg_count(args)
    if argc > 1 && ulib.streq(ulib.arg_at(args, 1), (&opt_a[0 as usize]) as u64) {
        ulib.say((&s_all[0 as usize]) as u64)
        ulib.sayu(ulib.sys(ulib.SYS_SYSINFO, ulib.I_VERSION, 0, 0))
        ulib.say((&s_arch[0 as usize]) as u64)
        ulib.nl()
        return 0
    }
    ulib.say((&s_name[0 as usize]) as u64)
    ulib.nl()
    return 0
}
