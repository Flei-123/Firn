// demos/kernel/user/hello.fi -- round K1: the smallest program that
// proves the loader did its work.
//
// It is not a toy: every line of it measures one promise of
// `demos/kernel/elf.fi`, and `tools/osum/run.sh` reads the numbers back.
//
//   * ARGUMENTS. It prints argc and every argv it got. A loader that
//     built the block wrongly shows up as a wrong count or as nothing.
//   * .bss IS ZERO. `counted` is an all-zero `static mut` and therefore
//     lands in `.bss` (`compiler/src/statics.rs`): NOBITS, no octet of it
//     is in the file. Whoever zeroes it is the loader, and nobody else.
//     The counter-check is `nobss` on the kernel command line -- the
//     loader then leaves the poison pattern standing and this line
//     prints 12297829382473034410 instead of 0.
//   * .data SURVIVED. `stamp` has a value, lies in `.data` and has to
//     arrive unchanged.
//   * .rodata IS READABLE. `fixed` has no `mut` and lies in `.rodata`,
//     on a page the loader mapped read only.
//   * IT CAN COUNT. Writing to a `static mut` proves the data page really
//     is writable.
//
// The exit code is 40 + argc, so that `wait` in the shell has something
// to show that is not zero.

profile kernel

import ulib

export { u_start }

static mut counted: u64 = 0
static mut stamp: u64 = 3735928559
static fixed: u64 = 424242

fn u_start(args: u64) -> u64 {
    var s_hi: [u8; 12] = "hello: argc\0"
    var s_arg: [u8; 12] = "hello: arg \0"
    var s_bss: [u8; 12] = "hello: bss \0"
    var s_data: [u8; 13] = "hello: data \0"
    var s_ro: [u8; 11] = "hello: ro \0"
    var s_sp: [u8; 2] = " \0"

    let n: u64 = ulib.arg_count(args)
    ulib.say_line((&s_hi[0]) as u64, n)
    var i: u64 = 0
    while i < n {
        ulib.say((&s_arg[0]) as u64)
        ulib.sayn(i)
        ulib.say((&s_sp[0]) as u64)
        ulib.say(ulib.arg_at(args, i))
        ulib.nl()
        i = i + 1
    }
    ulib.say((&s_bss[0]) as u64)
    ulib.sayu(counted)
    ulib.nl()
    counted = counted + 1
    ulib.say((&s_data[0]) as u64)
    ulib.sayu(stamp)
    ulib.nl()
    ulib.say((&s_ro[0]) as u64)
    ulib.sayu(fixed)
    ulib.nl()
    return 40 + n
}
