// demos/kernel/user/cat.fi -- round K6: a file, octet for octet.
//
// Without an argument it copies its INPUT, and that is what makes it a
// part of a pipeline: `cat < a` and `a | cat` are the same program with a
// different descriptor 0, and it cannot tell the difference -- which is
// the whole point of the three standard descriptors being state
// (`demos/kernel/uio.fi`).
//
// Round K1 returned the number of octets it had copied as its exit code.
// This one returns 0 or 1, because `$?` is a shell's business now.

profile kernel

import ulib

export { u_start }

fn u_start(args: u64) -> u64 {
    var s_open: [u8; 18] = "cat: cannot open \0"
    var s_dir: [u8; 21] = "cat: is a directory \0"

    let argc: u64 = ulib.arg_count(args)
    if argc < 2 {
        pour(ulib.IN)
        return 0
    }
    var code: u64 = 0
    var k: u64 = 1
    while k < argc {
        let p: u64 = ulib.arg_at(args, k)
        if ulib.is_dir(p) {
            ulib.esay_line((&s_dir[0 as usize]) as u64, p)
            code = 1
        } else {
            let fd: u64 = ulib.sys(ulib.SYS_OPEN, p, 0, 0)
            if ulib.bad(fd) {
                ulib.esay_line((&s_open[0 as usize]) as u64, p)
                code = 1
            } else {
                pour(fd)
                ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
            }
        }
        k = k + 1
    }
    return code
}

// 512 octets at a time. The kernel takes at most 4096 in one call
// (`sys.MAX_IO`) and the stack of a process is eight pages -- half a
// block is a size that fits both without a thought.
fn pour(fd: u64) {
    var buf: [u8; 512] = [0 as u8; 512]
    var going: bool = true
    while going {
        let n: u64 = ulib.sys(ulib.SYS_READ, fd, (&buf[0 as usize]) as u64, 512)
        if n == 0 || ulib.bad(n) {
            going = false
        } else {
            ulib.put((&buf[0 as usize]) as u64, n)
        }
    }
}
