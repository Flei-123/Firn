// demos/kernel/user/cat.fi -- round K1: a file, octet for octet.
//
// open, read in pieces of 64, write the pieces out, close. Nothing else,
// and in particular no buffer bigger than the stack of a process can
// carry. The exit code is the number of octets it copied -- capped at 250
// so that it stays an exit code and does not become a length.

profile kernel

import ulib
import osum.libc.io

export { u_start }

fn u_start(args: u64) -> u64 {
    var buf: [u8; 64] = [0 as u8; 64]
    var s_err: [u8; 13] = "cat: failed \0"
    var s_use: [u8; 20] = "cat: needs a path\n\0\0"

    let argc: u64 = ulib.arg_count(args)
    if argc < 2 {
        ulib.say((&s_use[0]) as u64)
        return 1
    }
    var total: u64 = 0
    var k: u64 = 1
    while k < argc {
        let fd: u64 = io.open(ulib.arg_at(args, k), 0)
        if (fd >> 63) != 0 {
            ulib.say_line((&s_err[0]) as u64, fd)
            return 2
        }
        var going: bool = true
        while going {
            let n: u64 = io.read(fd, (&buf[0]) as u64, 64)
            if n == 0 || (n >> 63) != 0 {
                going = false
            } else {
                ulib.put((&buf[0]) as u64, n)
                total = total + n
            }
        }
        io.close(fd)
        k = k + 1
    }
    if total > 250 {
        return 250
    }
    return total
}
