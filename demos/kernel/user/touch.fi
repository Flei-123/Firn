// demos/kernel/user/touch.fi -- round K6: a file that is there.
//
// There is no clock on a file in this file system, so `touch` is the half
// of it that is left: a file that was not there is created, and one that
// was is left exactly as it is. `open(path, create)` is the whole
// program.

profile kernel

import ulib

export { u_start }

fn u_start(args: u64) -> u64 {
    var s_err: [u8; 22] = "touch: cannot create \0"
    var s_use: [u8; 20] = "touch: needs a path\0"

    let argc: u64 = ulib.arg_count(args)
    if argc < 2 {
        ulib.esay_line((&s_use[0 as usize]) as u64, 0)
        return 1
    }
    var code: u64 = 0
    var k: u64 = 1
    while k < argc {
        let p: u64 = ulib.arg_at(args, k)
        // O_CREAT without O_TRUNC: `touch` on a file that is there must
        // not empty it. Round K1's second argument was a boolean "make
        // it"; it is Linux's flag word since round K4.
        let fd: u64 = ulib.sys(ulib.SYS_OPEN, p, 65, 0)
        if ulib.bad(fd) {
            ulib.esay_line((&s_err[0 as usize]) as u64, p)
            code = 1
        } else {
            ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
        }
        k = k + 1
    }
    return code
}
