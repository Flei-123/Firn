// demos/kernel/user/true.fi -- round K6: the program that says yes.
//
// It is a FILE on the disk like every other program, and that is the
// point of it: `true` is not a word the shell knows, it is 0 out of an
// ELF file that the loader started. Its counterpart is `/bin/false`.

profile kernel

import ulib

export { u_start }

fn u_start(args: u64) -> u64 {
    return 0
}
