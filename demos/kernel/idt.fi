// demos/kernel/idt.fi -- round 59: descriptor tables, PIC and timer.
//
// Round 52 named it openly: "an IDT needs global, mutable data. Stage 0
// does not have that. As long as that is missing, this kernel cannot
// install its own interrupt vector." With `kstate.fi` the data area is
// there, and this file builds the table -- in Firn, gate by gate.
//
// Three tables are set up here:
//
//   * the IDT: 48 gates that point into `isr.s`, the rest not present.
//     Vector 8 (#DF) gets IST1 -- a stack of its own, because the usual
//     cause of a double fault is precisely a broken rsp.
//   * the TSS: RSP0 for the way back out of ring 3, IST1 for #DF. Its
//     descriptor is written into the GDT that `boot.s` set up.
//   * the two PICs: remapped to 0x20/0x28, because vectors 0..31 belong
//     to the exceptions -- an unmapped PIC delivers the timer as #DF.
//
// Then the PIT ticks at 100 Hz.

import serial
import kstate

export {
    build, tss_install, pic_remap, pic_mask, pic_eoi, pit_init,
    enable, disable, halt, ARMED
}

// How many vectors `isr.s` provides.
const ARMED: u64 = 48

// ------------------------------------------------------------- the IDT

// One gate. `handler` is the entry point out of `isr.s`, `ist` the index
// in the interrupt stack table (0 = keep the current stack), `dpl` the
// ring that may trigger this vector with `int n`.
fn gate(idt: u64, vec: u64, handler: u64, ist: u64, dpl: u64) {
    let sel: u64 = 0x08 // kernel code, see boot.s
    let attr: u64 = 0x8E | (dpl << 5) // present, 64-bit interrupt gate
    var low: u64 = handler & 0xFFFF
    low = low | (sel << 16)
    low = low | (ist << 32)
    low = low | (attr << 40)
    low = low | (((handler >> 16) & 0xFFFF) << 48)
    __mmio_write64((idt + vec * 16) as *mut u64, low)
    __mmio_write64((idt + vec * 16 + 8) as *mut u64, handler >> 32)
}

// The whole table plus `lidt`. Returns the number of armed gates.
fn build(state: u64, vectors: u64) -> u64 {
    let idt: u64 = state + kstate.IDT_OFF
    var v: u64 = 0
    while v < 256 {
        if v < ARMED {
            var ist: u64 = 0
            if v == 8 {
                ist = 1 // #DF on its own stack
            }
            gate(idt, v, __mmio_read64((vectors + v * 8) as *mut u64), ist, 0)
        } else {
            // Not present: a vector without a handler must not jump
            // somewhere random.
            __mmio_write64((idt + v * 16) as *mut u64, 0)
            __mmio_write64((idt + v * 16 + 8) as *mut u64, 0)
        }
        v = v + 1
    }
    // The descriptor for `lidt`: 2 octets of limit, 8 octets of base.
    let idtr: u64 = state + kstate.IDTR
    __mmio_write16(idtr as *mut u16, (256 * 16 - 1) as u16)
    __mmio_write64((idtr + 2) as *mut u64, idt)
    asm("lidt [rax]", in("rax") idtr)
    return ARMED
}

// ------------------------------------------------------------- the TSS

// Writes the TSS descriptor into the GDT (slot 0x30, see boot.s), fills
// the TSS and loads it. `rsp0` is the stack the processor switches to
// when an interrupt arrives in ring 3; `ist1` the one for #DF.
fn tss_install(gdt: u64, tss: u64, rsp0: u64, ist1: u64) {
    // .bss is not necessarily zeroed by a boot loader.
    var i: u64 = 0
    while i < 104 {
        kstate.set8(tss + i, 0 as u8)
        i = i + 1
    }
    __mmio_write64((tss + 4) as *mut u64, rsp0)
    __mmio_write64((tss + 36) as *mut u64, ist1)
    // I/O map base behind the end of the segment = no I/O permission map.
    __mmio_write16((tss + 102) as *mut u16, 104 as u16)

    let limit: u64 = 103 // 104 octets, from 0 counted
    var low: u64 = limit & 0xFFFF
    low = low | ((tss & 0xFFFFFF) << 16)
    low = low | (0x89 << 40) // present, available 64-bit TSS
    low = low | (((limit >> 16) & 0xF) << 48)
    low = low | (((tss >> 24) & 0xFF) << 56)
    __mmio_write64((gdt + 0x30) as *mut u64, low)
    __mmio_write64((gdt + 0x38) as *mut u64, tss >> 32)
    asm("ltr ax", in("ax") 0x30 as u16)
}

// ------------------------------------------------------------- the PICs

const PIC1_CMD: u16 = 0x20
const PIC1_DATA: u16 = 0x21
const PIC2_CMD: u16 = 0xA0
const PIC2_DATA: u16 = 0xA1

// Master to 0x20..0x27, slave to 0x28..0x2F. Without this the timer
// arrives as vector 8 -- as a double fault.
fn pic_remap() {
    serial.out8(PIC1_CMD, 0x11 as u8) // start initialisation, ICW4 follows
    serial.io_wait()
    serial.out8(PIC2_CMD, 0x11 as u8)
    serial.io_wait()
    serial.out8(PIC1_DATA, 0x20 as u8) // ICW2: vector base of the master
    serial.io_wait()
    serial.out8(PIC2_DATA, 0x28 as u8) // ICW2: vector base of the slave
    serial.io_wait()
    serial.out8(PIC1_DATA, 0x04 as u8) // ICW3: slave hangs on IRQ2
    serial.io_wait()
    serial.out8(PIC2_DATA, 0x02 as u8) // ICW3: identity of the slave
    serial.io_wait()
    serial.out8(PIC1_DATA, 0x01 as u8) // ICW4: 8086 mode
    serial.io_wait()
    serial.out8(PIC2_DATA, 0x01 as u8)
    serial.io_wait()
}

// A set bit means: this IRQ stays silent.
fn pic_mask(master: u8, slave: u8) {
    serial.out8(PIC1_DATA, master)
    serial.io_wait()
    serial.out8(PIC2_DATA, slave)
    serial.io_wait()
}

// End of interrupt. Above IRQ7 the slave has to hear it too, otherwise it
// delivers nothing more.
fn pic_eoi(vector: u64) {
    if vector >= 40 {
        serial.out8(PIC2_CMD, 0x20 as u8)
    }
    serial.out8(PIC1_CMD, 0x20 as u8)
}

// -------------------------------------------------------------- the PIT

// Channel 0, mode 3 (square wave), `hz` interrupts per second. The
// counter runs at 1193182 Hz -- a third of the colour carrier of NTSC,
// the reason why every PC still counts in this awkward unit.
fn pit_init(hz: u64) -> u64 {
    let divisor: u64 = 1193182 / hz
    serial.out8(0x43 as u16, 0x36 as u8)
    serial.out8(0x40 as u16, (divisor & 0xFF) as u8)
    serial.out8(0x40 as u16, ((divisor >> 8) & 0xFF) as u8)
    return divisor
}

// ------------------------------------------------------- the flag itself

fn enable() {
    asm("sti")
}

fn disable() {
    asm("cli")
}

// Wait until the next interrupt. `hlt` without `sti` beforehand is the
// classic way to freeze a kernel.
fn halt() {
    asm("hlt")
}
