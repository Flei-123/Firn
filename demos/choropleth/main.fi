// demos/choropleth/main.fi -- A MAP, DRAWN BY FIRN ITSELF.
//
// GeoJSON in, PNG out, in one process and with nothing but this repository:
//
//   1. the file            -> lib/std/io.fi
//   2. GeoJSON -> nodes    -> lib/std/json.fi
//   3. lon/lat -> pixels   -> the projection below
//   4. rings   -> coverage -> lib/font/raster.fi   (the same rasteriser
//                             that fills glyph outlines)
//   5. borders -> outline  -> lib/paint/stroke.fi
//   6. coverage -> pixels  -> lib/paint/canvas.fi
//   7. labels              -> lib/font/ttf.fi + raster
//   8. pixels -> PNG       -> lib/paint/png.fi + lib/std/deflate.fi
//
// ROUND FIRN-LUECKEN -- what this file no longer has to do itself:
//
//   * the map window used to be four FUNCTIONS returning constants,
//     because `const` could not hold a floating point number. It can now.
//   * a border used to be a QUADRILATERAL PER SEGMENT, built here. It is
//     now one call to `paint.stroke`, and the border of Malta -- eleven
//     pixels across -- no longer eats its own fill, because the stroke can
//     be put INSIDE the outline.
//   * every polygon used to open a raster window of its own, computed from
//     its bounding box, because clearing the full window cost more than
//     drawing. The rasteriser now clears only what it wrote, so there is
//     ONE window: the whole picture.
//
// Compile with:
//   firnc -o build/choropleth demos/choropleth/main.fi
import std.io
import std.rt
import std.json
import std.str
import html.mem
import paint.canvas
import paint.png
import paint.stroke
import font.raster
import font.ttf

// ------------------------------------------------------------ the picture
const W: usize = 1540
const TOP: usize = 130
const MAPH: usize = 1385
const H: usize = 1665

// map window in degrees. ROUND FIRN-LUECKEN: four `const f64`. Until this
// round `const` took integers and bools only, so these four numbers had to
// be functions -- and every use of them a call.
const LON0: f64 = -25.0
const LAT1: f64 = 72.0
const SX: f64 = 22.0
const SY: f64 = 35.5

// The border: 0.7 pixels wide, and INSIDE the outline. Centred it would
// take 0.35 pixels off the fill on every side, which is what made Malta
// disappear.
const BORDER: f64 = 0.5
const LEADER: f64 = 1.6
const FIT: f64 = 0.35

const MAXN: usize = 32

struct Table {
    nm_p: [u64; 32],
    nm_n: [usize; 32],
    lb_p: [u64; 32],
    lb_n: [usize; 32],
    price: [f64; 32],
    lon: [f64; 32],
    lat: [f64; 32],
    llon: [f64; 32],
    llat: [f64; 32],
    n: usize,
}

fn table_new() -> Table {
    return Table {
        nm_p: [0; 32], nm_n: [0; 32],
        lb_p: [0; 32], lb_n: [0; 32],
        price: [0.0; 32], lon: [0.0; 32], lat: [0.0; 32],
        llon: [0.0; 32], llat: [0.0; 32],
        n: 0,
    }
}

fn byte_at(p: u64, i: usize) -> u32 {
    return (*((p + i as u64) as *mut u8)) as u32
}

// "-8.25" -> -8.25 . No exponent: the table has none.
fn parse_f64(p: u64, n: usize) -> f64 {
    var i: usize = 0
    var sign: f64 = 1.0
    if n > 0 && byte_at(p, 0) == 45 as u32 {
        sign = 0.0 - 1.0
        i = 1
    }
    var v: f64 = 0.0
    while i < n && byte_at(p, i) != 46 as u32 {
        v = v * 10.0 + ((byte_at(p, i) - 48 as u32) as f64)
        i = i + 1
    }
    if i < n {
        i = i + 1
        var f: f64 = 0.1
        while i < n {
            v = v + ((byte_at(p, i) - 48 as u32) as f64) * f
            f = f * 0.1
            i = i + 1
        }
    }
    return sign * v
}

// One record per line: name|label|price|lon|lat|label-lon|label-lat
fn table_load(t: *mut Table, s: str) {
    let base: u64 = s.p as u64
    let total: usize = s.n
    var i: usize = 0
    while i < total {
        var f_p: [u64; 7] = [0; 7]
        var f_n: [usize; 7] = [0; 7]
        var k: usize = 0
        var start: usize = i
        while i < total && byte_at(base, i) != 10 as u32 {
            if byte_at(base, i) == 124 as u32 {
                if k < 7 {
                    f_p[k] = base + start as u64
                    f_n[k] = i - start
                }
                k = k + 1
                start = i + 1
            }
            i = i + 1
        }
        if k < 7 {
            f_p[k] = base + start as u64
            f_n[k] = i - start
        }
        k = k + 1
        i = i + 1
        if k == 7 && (*t).n < MAXN {
            let j: usize = (*t).n
            (*t).nm_p[j] = f_p[0]
            (*t).nm_n[j] = f_n[0]
            (*t).lb_p[j] = f_p[1]
            (*t).lb_n[j] = f_n[1]
            (*t).price[j] = parse_f64(f_p[2], f_n[2])
            (*t).lon[j] = parse_f64(f_p[3], f_n[3])
            (*t).lat[j] = parse_f64(f_p[4], f_n[4])
            (*t).llon[j] = parse_f64(f_p[5], f_n[5])
            (*t).llat[j] = parse_f64(f_p[6], f_n[6])
            (*t).n = j + 1
        }
    }
}

fn table_find(t: *mut Table, sp: str.Span) -> i64 {
    var i: usize = 0
    while i < (*t).n {
        if (*t).nm_n[i] == sp.n && rt.mem_eq((*t).nm_p[i], sp.p as u64, sp.n) {
            return i as i64
        }
        i = i + 1
    }
    return 0 - 1
}

// ------------------------------------------------------------ the colours
fn mix_ch(a: u32, b: u32, f: f64) -> u32 {
    let v: f64 = (a as f64) + ((b as f64) - (a as f64)) * f
    if v < 0.0 { return 0 as u32 }
    if v > 255.0 { return 255 as u32 }
    return v as u32
}

fn rgb(r: u32, g: u32, b: u32) -> u32 {
    return canvas.color_of(255 as u32, r, g, b)
}

// RdYlGn reversed: 0 = green (cheap), 1 = dark red (dear).
fn ramp(t0: f64) -> u32 {
    var t: f64 = t0
    if t < 0.0 { t = 0.0 }
    if t > 1.0 { t = 1.0 }
    var sr: [u32; 5] = [26, 166, 255, 253, 165]
    var sg: [u32; 5] = [152, 217, 255, 174, 0]
    var sb: [u32; 5] = [80, 106, 191, 97, 38]
    let x: f64 = t * 4.0
    var i: usize = x as usize
    if i > 3 { i = 3 }
    let f: f64 = x - (i as f64)
    return rgb(mix_ch(sr[i], sr[i + 1], f), mix_ch(sg[i], sg[i + 1], f),
        mix_ch(sb[i], sb[i + 1], f))
}

// ------------------------------------------------------------- projection
fn px(lon: f64) -> f64 {
    return (lon - LON0) * SX
}

fn py(lat: f64) -> f64 {
    return (TOP as f64) + (LAT1 - lat) * SY
}

// ------------------------------------------------------------------ text
struct Text {
    f: *mut ttf.Font,
    sc: *mut u8,
    cap: usize,
}

fn text_span_width(tx: *mut Text, p: u64, n: usize, size: f64) -> f64 {
    let f: *mut ttf.Font = (*tx).f
    let scale: f64 = size / (ttf.font_upem(f) as f64)
    var w: f64 = 0.0
    var i: usize = 0
    while i < n {
        let gid: u32 = ttf.font_glyph_for(f, byte_at(p, i))
        w = w + (ttf.font_advance(f, gid) as f64) * scale
        i = i + 1
    }
    return w
}

// The pen sits at (x, y); y is the BASELINE. The window is the whole
// picture -- the rasteriser pays for the letters, not for the page.
fn draw_span(cv: *mut canvas.Canvas, r: *mut raster.Raster, tx: *mut Text,
    p: u64, n: usize, x: f64, y: f64, size: f64, col: u32) {
    let f: *mut ttf.Font = (*tx).f
    let scale: f64 = size / (ttf.font_upem(f) as f64)
    if !raster.raster_begin(r, 0.0, 0.0, W, H) { return }
    var pen: f64 = x
    var i: usize = 0
    while i < n {
        let gid: u32 = ttf.font_glyph_for(f, byte_at(p, i))
        ttf.font_outline(f, gid, r, pen, y, scale, (*tx).sc, (*tx).cap, 0)
        pen = pen + (ttf.font_advance(f, gid) as f64) * scale
        i = i + 1
    }
    raster.raster_finish(r)
    canvas.canvas_fill_raster(cv, r, 0, 0, col)
}

fn draw_text(cv: *mut canvas.Canvas, r: *mut raster.Raster, tx: *mut Text,
    s: str, x: f64, y: f64, size: f64, col: u32) {
    draw_span(cv, r, tx, s.p as u64, s.n, x, y, size, col)
}

// --------------------------------------------------------------- geometry
fn ring_fill(d: *mut json.Json, ring: u32, r: *mut raster.Raster) {
    var pt: u32 = json.json_child(d, ring)
    if pt == json.JSON_NONE { return }
    let fx: f64 = px(json.json_number(d, json.json_child_at(d, pt, 0)))
    let fy: f64 = py(json.json_number(d, json.json_child_at(d, pt, 1)))
    var cx: f64 = fx
    var cy: f64 = fy
    pt = json.json_next(d, pt)
    while pt != json.JSON_NONE {
        let x: f64 = px(json.json_number(d, json.json_child_at(d, pt, 0)))
        let y: f64 = py(json.json_number(d, json.json_child_at(d, pt, 1)))
        raster.raster_line(r, cx, cy, x, y)
        cx = x
        cy = y
        pt = json.json_next(d, pt)
    }
    raster.raster_line(r, cx, cy, fx, fy)
}

// The border of a ring: the ring goes into the stroker, the stroker writes
// ONE outline into the same rasteriser the fill uses. No quadrilateral per
// segment any more -- and therefore no doubly counted coverage on the
// inside of a bend.
fn ring_stroke(d: *mut json.Json, ring: u32, st: *mut stroke.Stroke,
    r: *mut raster.Raster) {
    stroke.stroke_begin(st, true)
    var pt: u32 = json.json_child(d, ring)
    while pt != json.JSON_NONE {
        stroke.stroke_point(st,
            px(json.json_number(d, json.json_child_at(d, pt, 0))),
            py(json.json_number(d, json.json_child_at(d, pt, 1))))
        pt = json.json_next(d, pt)
    }
    stroke.stroke_end(st, r)
}

// Every ring of a feature, whatever the geometry says it is.
fn rings_of(d: *mut json.Json, geom: u32, out: *mut u32, cap: usize)
    -> usize {
    var k_type: [u8; 5] = "type\0"
    var k_coord: [u8; 12] = "coordinates\0"
    var k_poly: [u8; 8] = "Polygon\0"
    let tnode: u32 = json.json_get_c(d, geom, (&k_type[0]) as u64)
    let cnode: u32 = json.json_get_c(d, geom, (&k_coord[0]) as u64)
    if cnode == json.JSON_NONE { return 0 }
    let ts: str.Span = json.json_string(d, tnode)
    var n: usize = 0
    if ts.n == 7 && rt.mem_eq(ts.p as u64, (&k_poly[0]) as u64, 7) {
        var ring: u32 = json.json_child(d, cnode)
        while ring != json.JSON_NONE && n < cap {
            *((out as u64 + (n * 4) as u64) as *mut u32) = ring
            n = n + 1
            ring = json.json_next(d, ring)
        }
        return n
    }
    var poly: u32 = json.json_child(d, cnode)
    while poly != json.JSON_NONE {
        var ring2: u32 = json.json_child(d, poly)
        while ring2 != json.JSON_NONE && n < cap {
            *((out as u64 + (n * 4) as u64) as *mut u32) = ring2
            n = n + 1
            ring2 = json.json_next(d, ring2)
        }
        poly = json.json_next(d, poly)
    }
    return n
}

fn ring_at(out: *mut u32, i: usize) -> u32 {
    return *((out as u64 + (i * 4) as u64) as *mut u32)
}

fn main() -> i32 {
    if !gc_init() { return 1 }

    var geo_path: [u8; 16] = "/tmp/eu.geojson\0"
    var font_path: [u8; 53] =
    "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf\0"
    var out_path: [u8; 18] = "/tmp/firn_map.png\0"

    // ---- 1. the data
    var src: rt.Buf = rt.buf_new()
    if !io.read_file((&geo_path[0]) as u64, &src) {
        io.print_line("choropleth: cannot read the GeoJSON")
        return 2
    }
    var d: json.Json = json.json_new()
    let ok: bool = json.json_parse(&d, rt.buf_ptr(&src), rt.buf_len(&src))
        catch false
    if !ok {
        io.print_line("choropleth: the GeoJSON does not parse")
        return 3
    }

    // ---- 2. the prices (Destatis / EU Commission, 31.08.2026)
    var tab: Table = table_new()
    table_load(&tab, "Denmark|DK 2.52|2.52|9.4|56.1|6.2|58.2\nNetherlands|NL 2.35|2.35|5.4|52.4|0.6|53.4\nGermany|DE 2.24|2.24|10.4|51.2|10.4|51.2\nFinland|FI 2.20|2.20|26.0|63.4|26.0|63.4\nFrance|FR 2.07|2.07|2.2|46.8|2.2|46.8\nGreece|GR 2.05|2.05|22.3|39.6|22.3|39.6\nItaly|IT 2.02|2.02|12.4|42.9|12.4|42.9\nPortugal|PT 2.01|2.01|-8.2|39.6|-8.2|39.6\nBelgium|BE 1.88|1.88|4.5|50.7|-0.6|51.4\nIreland|IE 1.84|1.84|-8.2|53.4|-8.2|53.4\nLatvia|LV 1.84|1.84|25.0|56.9|25.0|56.9\nEstonia|EE 1.81|1.81|25.8|58.9|25.8|58.9\nRomania|RO 1.81|1.81|25.0|45.9|25.0|45.9\nLithuania|LT 1.79|1.79|24.0|55.3|24.0|55.3\nAustria|AT 1.78|1.78|14.3|47.6|14.3|47.6\nLuxembourg|LU 1.75|1.75|6.1|49.8|-0.4|48.3\nSlovakia|SK 1.75|1.75|19.6|48.8|19.6|48.8\nCzechia|CZ 1.74|1.74|15.3|49.9|15.3|49.9\nSpain|ES 1.73|1.73|-3.9|40.2|-3.9|40.2\nCroatia|HR 1.72|1.72|16.4|45.2|20.6|43.4\nHungary|HU 1.64|1.64|19.4|47.1|19.4|47.1\nSlovenia|SI 1.61|1.61|14.8|46.1|10.4|44.2\nCyprus|CY 1.60|1.60|33.2|35.1|33.4|33.6\nBulgaria|BG 1.57|1.57|25.3|42.7|25.3|42.7\nPoland|PL 1.52|1.52|19.3|52.1|19.3|52.1\nSweden|SE 1.47|1.47|15.0|60.4|15.0|60.4\nMalta|MT 1.34|1.34|14.45|35.9|19.2|34.6\n")

    var lo: f64 = 999.0
    var hi: f64 = 0.0
    var i: usize = 0
    while i < tab.n {
        if tab.price[i] < lo { lo = tab.price[i] }
        if tab.price[i] > hi { hi = tab.price[i] }
        i = i + 1
    }

    // ---- 3. the font
    var fbuf: rt.Buf = rt.buf_new()
    if !io.read_file((&font_path[0]) as u64, &fbuf) {
        io.print_line("choropleth: cannot read the font")
        return 4
    }
    var fnt: ttf.Font = ttf.font_new()
    if !ttf.font_init(&fnt, rt.buf_data(&fbuf), rt.buf_len(&fbuf)) {
        io.print_line("choropleth: the font does not open")
        return 5
    }
    let scratch: *mut u8 = mem.heap_alloc(1 << 20)
    var tx: Text = Text { f: &fnt, sc: scratch, cap: 1 << 20 }

    // ---- 4. canvas and rasteriser
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        io.print_line("choropleth: no canvas")
        return 6
    }
    let sea: u32 = rgb(16 as u32, 29 as u32, 43 as u32)
    let land_other: u32 = rgb(36 as u32, 52 as u32, 71 as u32)
    let line: u32 = rgb(14 as u32, 22 as u32, 32 as u32)
    let white: u32 = rgb(255 as u32, 255 as u32, 255 as u32)
    let ink: u32 = rgb(17 as u32, 17 as u32, 17 as u32)
    let grey: u32 = rgb(143 as u32, 163 as u32, 184 as u32)
    canvas.canvas_clear(&cv, rgb(14 as u32, 22 as u32, 32 as u32))
    canvas.canvas_fill_rect(&cv, 0.0, (TOP as f64) - 12.0, W as f64,
        ((TOP + MAPH) as f64) + 12.0, sea)

    var r: raster.Raster = raster.raster_new()
    let need: usize = raster.raster_bytes_needed(W, H)
    let rmem: *mut u8 = mem.heap_alloc(need)
    if rmem as usize == 0 {
        io.print_line("choropleth: no memory for the rasteriser")
        return 7
    }
    raster.raster_attach(&r, rmem, need)

    // The stroker. Its memory is the points of ONE ring; the longest in
    // this file has 4574.
    var st: stroke.Stroke = stroke.stroke_new()
    let snd: usize = stroke.stroke_bytes_needed(8192)
    let smem: *mut u8 = mem.heap_alloc(snd)
    if smem as usize == 0 {
        io.print_line("choropleth: no memory for the stroker")
        return 7
    }
    stroke.stroke_attach(&st, smem, snd)
    stroke.stroke_set_width(&st, BORDER)
    stroke.stroke_set_join(&st, stroke.JOIN_ROUND)
    stroke.stroke_set_align(&st, stroke.ALIGN_INNER)
    // At most half of an island may become border. Malta is seventeen
    // square pixels; without this it would be all border and no colour.
    stroke.stroke_set_fit(&st, FIT)

    // ---- 5. every country
    var k_feat: [u8; 9] = "features\0"
    var k_props: [u8; 11] = "properties\0"
    var k_name: [u8; 8] = "NAME_EN\0"
    var k_geom: [u8; 9] = "geometry\0"

    let root: u32 = json.json_root(&d)
    let feats: u32 = json.json_get_c(&d, root, (&k_feat[0]) as u64)
    let ringcap: usize = 4096
    let rings: *mut u32 = mem.heap_alloc(ringcap * 4) as *mut u32

    var drawn: usize = 0
    var feat: u32 = json.json_child(&d, feats)
    while feat != json.JSON_NONE {
        let props: u32 = json.json_get_c(&d, feat, (&k_props[0]) as u64)
        let geom: u32 = json.json_get_c(&d, feat, (&k_geom[0]) as u64)
        let nsp: str.Span = json.json_string(&d,
            json.json_get_c(&d, props, (&k_name[0]) as u64))
        let idx: i64 = table_find(&tab, nsp)
        var col: u32 = land_other
        if idx >= 0 {
            col = ramp((tab.price[idx as usize] - lo) / (hi - lo))
        }
        let nr: usize = rings_of(&d, geom, rings, ringcap)
        var j: usize = 0
        while j < nr {
            let ring: u32 = ring_at(rings, j)
            j = j + 1
            // One window, the whole picture, for every ring. What a ring
            // costs is what it touches -- that is the rasteriser's job
            // since this round, and no longer this file's.
            if !raster.raster_begin(&r, 0.0, 0.0, W, H) { continue }
            ring_fill(&d, ring, &r)
            raster.raster_finish(&r)
            // Nothing landed in the picture: an island off the window.
            // The rasteriser says so itself -- no bounding box needed.
            if raster.raster_used_y1(&r) == raster.raster_used_y0(&r) {
                continue
            }
            canvas.canvas_fill_raster(&cv, &r, 0, 0, col)
            // The border sits INSIDE the outline, so it takes nothing off
            // the fill of an island eleven pixels across.
            if raster.raster_begin(&r, 0.0, 0.0, W, H) {
                ring_stroke(&d, ring, &st, &r)
                raster.raster_finish(&r)
                canvas.canvas_fill_raster(&cv, &r, 0, 0, line)
            }
            drawn = drawn + 1
        }
        feat = json.json_next(&d, feat)
    }

    // ---- 6. the labels. A country too small for its own label gets the
    // label beside it and a leader line back to the spot it means.
    i = 0
    while i < tab.n {
        let ax: f64 = px(tab.lon[i])
        let ay: f64 = py(tab.lat[i])
        let cx: f64 = px(tab.llon[i])
        let cy: f64 = py(tab.llat[i])
        let wtxt: f64 = text_span_width(&tx, tab.lb_p[i], tab.lb_n[i], 21.0)
        let bx: f64 = cx - wtxt * 0.5
        if ax != cx || ay != cy {
            if raster.raster_begin(&r, 0.0, 0.0, W, H) {
                stroke.stroke_set_width(&st, LEADER)
                stroke.stroke_set_cap(&st, stroke.CAP_ROUND)
                stroke.stroke_line(&st, &r, ax, ay, cx, cy)
                stroke.stroke_set_width(&st, BORDER)
                raster.raster_finish(&r)
                canvas.canvas_fill_raster(&cv, &r, 0, 0, white)
            }
        }
        canvas.canvas_fill_rect(&cv, bx - 6.0, cy - 16.0, bx + wtxt + 6.0,
            cy + 7.0, white)
        draw_span(&cv, &r, &tx, tab.lb_p[i], tab.lb_n[i], bx, cy, 21.0, ink)
        i = i + 1
    }

    // ---- 7. title, legend, source
    draw_text(&cv, &r, &tx, "Benzinpreise in Europa - Super E5 (Euro-Super 95)",
        44.0, 68.0, 38.0, white)
    draw_text(&cv, &r, &tx,
        "EUR je Liter - Stand 31.08.2026 - Quelle: Destatis / EU-Kommission",
        46.0, 100.0, 20.0, grey)

    let lx: f64 = (W as f64) - 520.0
    let ly: f64 = (H as f64) - 78.0
    var s: usize = 0
    while s < 400 {
        let t: f64 = (s as f64) / 399.0
        canvas.canvas_fill_rect(&cv, lx + (s as f64), ly, lx + (s as f64) + 1.0,
            ly + 26.0, ramp(t))
        s = s + 1
    }
    draw_text(&cv, &r, &tx, "1.34", lx - 54.0, ly + 20.0, 20.0, white)
    draw_text(&cv, &r, &tx, "2.52", lx + 410.0, ly + 20.0, 20.0, white)
    draw_text(&cv, &r, &tx, "guenstig", lx, ly - 8.0, 17.0, grey)
    draw_text(&cv, &r, &tx, "teuer", lx + 356.0, ly - 8.0, 17.0, grey)
    draw_text(&cv, &r, &tx,
        "Grau = keine EU-Daten (CH, NO, UK, Balkan)   -   gezeichnet von Firn: GeoJSON, Rasterizer, TrueType, PNG",
        44.0, (H as f64) - 30.0, 17.0, grey)

    // ---- 8. out
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if !png.write_png(&cv, &out) {
        io.print_line("choropleth: PNG failed")
        return 8
    }
    if !io.write_file((&out_path[0]) as u64, mem.buf_ptr(&out) as u64,
        mem.buf_len(&out)) {
        io.print_line("choropleth: cannot write the PNG")
        return 9
    }
    let bytes: usize = mem.buf_len(&out)
    io.fmt_print_line(f"choropleth: {drawn} rings, {bytes} octets -> /tmp/firn_map.png")
    return 0
}
