// SPDX-License-Identifier: MPL-2.0
// demos/fuidemo/main.fi -- A SURFACE THAT USES THE NEW MODULES.
//
// ========================================================= WHY IT EXISTS
//
// lib/fui/flex.fi, lib/fui/anim.fi and lib/fui/effect.fi each have
// a check of their own and a proof image of their own. That proves that
// the calculation is right -- but not that a user builds a
// surface with it. A module that is only called by its own test
// is a test library and not a building block.
//
// So here stands a small application, as one would write it,
// and it uses all three in the NORMAL way:
//
//   * the toolbar and the title row are distributed by
//     `flex.flex_layout`, measured with `render.pref_of` --
//     no hand-calculated x per button;
//   * the transition normal -> hover of a button runs through
//     `anim.Animator`: a tween in the registry, `anim.anim_tick` drives
//     it, and only if it reports `true` is it redrawn. The
//     phases stand side by side in the picture, because a PNG has no time;
//   * the shadow under the dialog comes from
//     `effect.drop_shadow_spread` -- with spread, like the fourth
//     length in CSS `box-shadow`.
//
// The picture comes out in both schemes, light and dark:
//
//     fuidemo <out.png> [light|dark] [<font.ttf>]
//
// It is built by tools/fui/run.sh (section "THE DEMO APPLICATION"),
// so that a break in one of the three modules shows up here and not
// only with the next user.
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.style
import fui.widget
import fui.painter
import fui.render
import fui.layout
import fui.flex
import fui.anim
import fui.effect
import fui.sheet
import fui.scene

const FONTSET_BYTES: usize = 4096
const W: usize = 1000
const H: usize = 500

// The margin of the sheet and the height of the title row.
const PAD: f64 = 24.0
const TITLE_H: f64 = 44.0

// The transition lasts as long as the button in theme.fi: 240 ms is
// the time a mouse needs to really come to a stop.
const HOVER_MS: i64 = 240
const PHASES: usize = 7

// How wide a button is in the transition band and how far the phases
// stand apart. STEP is larger than KW, so nothing overlaps
// -- that is the condition that `pruefe_phasen` re-calculates.
const KW: f64 = 118.0
const KH: f64 = 36.0
const STEP: f64 = 136.0

// A label. The colour comes as a token, so it is readable in light as
// in dark, without a scheme being queried here.
fn label(c: *mut render.Ctx, x: f64, y: f64, w: f64, px: usize, p: u64,
    n: usize, tok: u32) {
    var e: widget.Widget = widget.widget_new(widget.KIND_LABEL)
    widget.w_place(&e, x, y, w, 18.0)
    widget.w_set_text(&e, p, n)
    let s: *mut style.Style = widget.w_style(&e)
    *s = style.style_set_fg(*s, style.color_token(tok))
    *s = style.style_set_font(*s, 0, px)
    *s = style.style_set_pad(*s, 0, 0)
    render.draw_label(c, &e)
}

// THE BRIDGE TO THE MEASURING PROTOCOL. `render.pref_of` measures in f64, the
// flexbox calculates in integers, and the conversion stands exactly once --
// in `flex.flex_item_from_pref`. Here it is only called.
fn item_von_widget(c: *mut render.Ctx, e: *mut widget.Widget,
    line: bool) -> flex.FlexItem {
    var pw: f64 = 0.0
    var ph: f64 = 0.0
    render.pref_of(c, e, &pw, &ph)
    return flex.flex_item_from_pref(pw, ph, line)
}

// Put the children of a distributed row in their place and paint them.
fn set(e: *mut widget.Widget, r: *mut layout.Rect) {
    widget.w_place(e, layout.rect_x(r) as f64, layout.rect_y(r) as f64,
        layout.rect_w(r) as f64, layout.rect_h(r) as f64)
}

// ===================================================== THE TITLE ROW
//
// A flex row across the whole width: the title carries `grow`, so
// it gets all the air and pushes the two buttons to the
// right. That is exactly how it stands in every header bar, and that is exactly what
// flex-grow is for.
fn titelzeile(c: *mut render.Ctx, m: *mut theme.Theme) {
    let f: *mut theme.Colors = theme.theme_colors(m)
    let z: *mut painter.Painter = render.ctx_painter(c)
    painter.surface(z, 0.0, 0.0, W as f64, TITLE_H,
        theme.opaque((*f).surface))
    painter.surface(z, 0.0, TITLE_H - 1.0, W as f64, 1.0,
        theme.opaque((*f).separator))

    var tt: widget.Widget = widget.widget_new(widget.KIND_LABEL)
    var s0: [u8; 18] = "Firn UI -- fuidemo"
    widget.w_set_text(&tt, (&s0[0]) as u64, 18)
    let ts: *mut style.Style = widget.w_style(&tt)
    *ts = style.style_set_font(*ts, 0, 14)
    *ts = style.style_set_pad(*ts, 0, 0)

    var b1: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    var s1: [u8; 4] = "Help"
    widget.w_set_text(&b1, (&s1[0]) as u64, 4)
    var b2: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    var s2: [u8; 8] = "Settings"
    widget.w_set_text(&b2, (&s2[0]) as u64, 8)

    var k: [flex.FlexItem; 3] = [flex.flex_item(0, 0); 3]
    k[0] = item_von_widget(c, &tt, true)
    k[1] = item_von_widget(c, &b1, true)
    k[2] = item_von_widget(c, &b2, true)
    // Only the title grows; the buttons stay as wide as their
    // text was measured.
    flex.item_set_flex(&k[0], 1000, 0, k[0].basis)

    var s: flex.FlexBox = flex.flexbox_new(flex.FLEX_ROW)
    flex.flex_set_padding(&s, 16, 8, 16, 8)
    flex.flex_set_gap(&s, 8, 0)
    flex.flex_set_align_items(&s, flex.AL_CENTER)
    var out: [layout.Rect; 3] = [layout.rect_new(0, 0, 0, 0); 3]
    var gr: [i64; 3] = [0; 3]
    var fz: [i64; 3] = [0; 3]
    flex.flex_layout(&s, layout.rect_new(0, 0, W as i64, TITLE_H as i64),
        (&k[0]) as *mut flex.FlexItem, 3,
        (&out[0]) as *mut layout.Rect, (&gr[0]) as *mut i64,
        (&fz[0]) as *mut i64)

    set(&tt, &out[0])
    render.draw_label(c, &tt)
    set(&b1, &out[1])
    render.draw_button(c, &b1)
    set(&b2, &out[2])
    render.draw_button(c, &b2)
}

// THE RECTANGLES FOR THE COMPARISON. They do not belong to the surface,
// but to the check: what is read is what pass 3 left behind,
// not what pass 4 painted.
fn rechtecke(sc: *mut scene.Scene, bar: usize, rs: *mut layout.Rect) {
    var i: usize = 0
    while i < 5 {
        let b: usize = scene.scene_child_at(sc, bar, i)
        let target: *mut layout.Rect =
        (rs as u64 + (i * layout.rect_stride()) as u64)
        as *mut layout.Rect
        *target =
        layout.rect_new(scene.node_x(sc, b) as i64,
            scene.node_y(sc, b) as i64, scene.node_w(sc, b) as i64,
            scene.node_h(sc, b) as i64)
        i = i + 1
    }
}

// ================================================== THE TOOLBAR
//
// Three buttons on the left, a search field that takes the rest, a button
// on the right -- DESCRIBED and not painted. The tree says WHAT stands there
// (a box of the class `leiste` with five children), the style sheet
// says HOW it looks (raised surface, a point of border, the last
// button in the accent), and lib/fui/scene.fi lets flex.fi calculate. No
// coordinate stands here: no x per button, no `setze` of its own, no
// second distribution loop.
//
// Next to it stands `toolbar_painted` -- the same bar, painted call for
// call, as it stood here until 21.09.2026. It stays for
// two reasons: tools/fui/run.sh (section 19c) counts on it the
// lines that the description saves, and `pruefe_leisten` holds both
// versions against each other rectangle by rectangle. A change
// that moves the picture is thereby noticed before it stands in the proof -- and
// in fact the PNG of this demo is byte for byte the same as before
// the change.
//
// AND THE HONEST NUMBER TO GO WITH IT: here stand 40 lines of code against 52
// painted ones (state of 22.09.2026). Raw that is only a fifth fewer,
// and the reason stands two paragraphs further up: a style sheet for
// ONE bar does not pay for itself -- its two rules count here
// in full. If you look only at the STRUCTURE (section 19d,
// cut B: without texts, without appearance), there are 15 described
// lines against 32 painted ones, so under half. The saving becomes
// fully visible on a PAGE, where the same rules hit header row,
// bar and cards -- tools/fui/gallery9_main.fi describes
// the same bar in 19 lines of tree, and exactly these numbers are
// re-calculated by tools/fui/run.sh (sections 19c and 19d).
//
// AND THE CLAMPING NOW STANDS ON BOTH SIDES. The painted version
// holds the search field with `flex.item_set_bounds(&k[3], 140, 0)` at 140
// points minimum width; the described one says the same with
// `scene.node_set_flexitem(&sc, leiste + 4, 1000, 1000, 140, 0)`, and clamping happens
// in both cases in ONE place -- in flex.fi. Until 21.09.2026
// this node did not exist, and `pruefe_leisten` therefore proved only
// the comfortable case: at a bar width of 952 points the field grows
// far beyond 140 anyway, no clamping applies there. That is why the
// comparison now runs TWICE -- once wide (the clamping stays silent) and
// once at 280 points, where it really applies and the field would otherwise
// shrink to a third of that.
//
// The bottom edge comes back, so that the caller can continue calculating
// instead of writing down the same number a second time; in `rs` the
// bar deposits the five arranged rectangles that the comparison reads.
fn toolbar(c: *mut render.Ctx, x: f64, y: f64, w: f64,
    rs: *mut layout.Rect) -> f64 {
    // >>> LEISTE BESCHRIEBEN
    let h: f64 = 56.0
    var nleiste: [u8; 6] = "leiste"
    var nakzent: [u8; 6] = "akzent"
    let k_bar: u32 = sheet.sheet_name((&nleiste[0]) as u64, 6)
    let k_accent: u32 = sheet.sheet_name((&nakzent[0]) as u64, 6)

    // ---- THE STYLE SHEET. Two rules, selected by class.
    var sh: sheet.Sheet = sheet.sheet_new()
    var s1: style.Style = style.style_new()
    s1 = style.style_set_bg(s1, style.color_token(style.TOK_SURFACE_RAISED))
    s1 = style.style_set_border(s1, style.color_token(style.TOK_BORDER), 1)
    s1 = style.style_set_radius(s1, 10)
    sheet.sheet_rule(&sh, sheet.sel_class(k_bar), s1)
    var s2: style.Style = style.style_new()
    s2 = style.style_set_bg(s2, style.color_token(style.TOK_ACCENT))
    s2 = style.style_set_fg(s2,
        style.color_token(style.TOK_TEXT_ON_ACCENT))
    sheet.sheet_rule(&sh, sheet.sel_class(k_accent), s2)

    // ---- THE TREE. The labels lie here, because a node
    // holds only the pointer to its text -- like every widget of this
    // library.
    var t0: [u8; 3] = "New"
    var t1: [u8; 4] = "Open"
    var t2: [u8; 4] = "Save"
    var t3: [u8; 17] = "Search in project"
    var t4: [u8; 3] = "Run"
    var sc: scene.Scene = scene.scene_new()
    let bar: usize = scene.scene_box(&sc, scene.SCENE_NONE, k_bar,
        flex.FLEX_ROW, flex.JUSTIFY_START, flex.AL_CENTER)
    scene.node_set_space(&sc, bar, 10, 10, 10, 10, 10, 0)
    // The five children: first all equal, then the two exceptions. The
    // nodes lie in the order in which they were created, so
    // at leiste + 1 to leiste + 5 (scene.scene_add hands out slots).
    var j: usize = 0
    while j < 5 {
        let b: usize = scene.scene_add(&sc, bar, scene.N_WIDGET)
        scene.node_set_widget_kind(&sc, b, widget.KIND_BUTTON)
        j = j + 1
    }
    scene.node_set_text(&sc, bar + 1, (&t0[0]) as u64, 3)
    scene.node_set_text(&sc, bar + 2, (&t1[0]) as u64, 4)
    scene.node_set_text(&sc, bar + 3, (&t2[0]) as u64, 4)
    scene.node_set_text(&sc, bar + 4, (&t3[0]) as u64, 17)
    scene.node_set_text(&sc, bar + 5, (&t4[0]) as u64, 3)
    // The search field is a text field and takes the rest; the last button
    // carries the accent -- both are said by the tree, not by a coordinate.
    scene.node_set_widget_kind(&sc, bar + 4, widget.KIND_TEXTBOX)
    scene.node_set_flexitem(&sc, bar + 4, 1000, 1000, 140, 0)
    scene.node_add_class(&sc, bar + 5, k_accent)

    // ---- DIE VIER DURCHGAENGE, IN IHRER REIHENFOLGE
    scene.scene_run(&sc, c, &sh, x, y, w, h)
    // <<< TOOLBAR DESCRIBED
    // IF THE TREE IS NOT COMPLETE, IT SAYS SO HERE. A node
    // that `scene_add` rejected is missing in the picture -- and a
    // return value that nobody looks at is no message.
    // `scene_overflow_reason` sums up the four limits in ONE number;
    // here it is zero, and if one day it no longer is, you read it in the
    // output instead of searching the picture.
    if scene.scene_overflow_reason(&sc) != scene.OF_NONE {
        var wr: rt.Buf = rt.buf_new()
        var wt: [u8; 42] = "fuidemo: Werkzeugleiste unvollstaendig, Gr"
        rt.buf_push_bytes(&wr, (&wt[0]) as u64, 42)
        var wu: [u8; 4] = "und "
        rt.buf_push_bytes(&wr, (&wu[0]) as u64, 4)
        rt.buf_push_dec_i64(&wr, scene.scene_overflow_reason(&sc) as i64)
        rt.buf_push(&wr, 10 as u8)
        rt.write_everything(2, rt.buf_ptr(&wr), rt.buf_len(&wr))
        rt.buf_free(&wr)
    }
    rechtecke(&sc, bar, rs)
    return y + h
}

// THE PAINTED VERSION, NOW ONLY FOR COMPARISON. It stands line for
// line as it worked: background and border by hand, five
// FlexItems measured by hand, a distribution loop of its own, every
// rectangle set itself. It paints in `pruefe_leisten` onto a
// canvas of ITS OWN -- painting twice onto the same one would make the soft
// edges doubly opaque and falsify the proof.
fn toolbar_painted(c: *mut render.Ctx, m: *mut theme.Theme, x: f64,
    y: f64, w: f64, ro: *mut layout.Rect) -> f64 {
    // >>> LEISTE GEMALT
    let f: *mut theme.Colors = theme.theme_colors(m)
    let z: *mut painter.Painter = render.ctx_painter(c)
    let h: f64 = 56.0
    painter.round_rect(z, x, y, w, h, 10.0,
        theme.opaque((*f).surface_raised))
    painter.round_ring(z, x, y, w, h, 10.0, 1.0,
        theme.opaque((*f).border_col))

    var e: [widget.Widget; 5] = [widget.widget_new(widget.KIND_BUTTON); 5]
    var t0: [u8; 3] = "New"
    var t1: [u8; 4] = "Open"
    var t2: [u8; 4] = "Save"
    var t3: [u8; 17] = "Search in project"
    var t4: [u8; 3] = "Run"
    e[3] = widget.widget_new(widget.KIND_TEXTBOX)
    widget.w_set_text(&e[0], (&t0[0]) as u64, 3)
    widget.w_set_text(&e[1], (&t1[0]) as u64, 4)
    widget.w_set_text(&e[2], (&t2[0]) as u64, 4)
    widget.w_set_text(&e[3], (&t3[0]) as u64, 17)
    widget.w_set_text(&e[4], (&t4[0]) as u64, 3)
    // The last button is the one you press: it carries the accent.
    let rs: *mut style.Style = widget.w_style(&e[4])
    *rs = style.style_set_bg(*rs, style.color_token(style.TOK_ACCENT))
    *rs = style.style_set_fg(*rs,
        style.color_token(style.TOK_TEXT_ON_ACCENT))

    var k: [flex.FlexItem; 5] = [flex.flex_item(0, 0); 5]
    var i: usize = 0
    while i < 5 {
        k[i] = item_von_widget(c, &e[i], true)
        i = i + 1
    }
    flex.item_set_flex(&k[3], 1000, 1000, k[3].basis)
    flex.item_set_bounds(&k[3], 140, 0)

    var s: flex.FlexBox = flex.flexbox_new(flex.FLEX_ROW)
    flex.flex_set_padding(&s, 10, 10, 10, 10)
    flex.flex_set_gap(&s, 10, 0)
    flex.flex_set_align_items(&s, flex.AL_CENTER)
    var out: [layout.Rect; 5] = [layout.rect_new(0, 0, 0, 0); 5]
    var gr: [i64; 5] = [0; 5]
    var fz: [i64; 5] = [0; 5]
    flex.flex_layout(&s, layout.rect_new(x as i64, y as i64, w as i64,
            h as i64), (&k[0]) as *mut flex.FlexItem, 5,
        (&out[0]) as *mut layout.Rect, (&gr[0]) as *mut i64,
        (&fz[0]) as *mut i64)
    i = 0
    while i < 5 {
        set(&e[i], &out[i])
        if i == 3 {
            render.draw_widget(c, &e[i])
        } else {
            render.draw_button(c, &e[i])
        }
        i = i + 1
    }
    // <<< TOOLBAR PAINTED
    // From here on it is no longer the bar that stands, but the CHECK: the
    // five arranged rectangles are handed out for `pruefe_leisten`.
    // It stood until 22.09.2026 in the middle of the
    // drawing loop and thereby counted in the line comparison (section
    // 19d) on the painted side -- a line that also exists on the
    // described side as `rechtecke(...)`, and
    // outside its marks. Two sides, two standards: that
    // is exactly the calculation this comparison is written
    // against.
    i = 0
    while i < 5 {
        let ptr: *mut layout.Rect =
        (ro as u64 + (i * layout.rect_stride()) as u64)
        as *mut layout.Rect
        *ptr = out[i]
        i = i + 1
    }
    return y + h
}

// ================================ DESCRIBED == PAINTED, RECTANGLE FOR
//                                  RECTANGLE
//
// THE CHECK THAT CARRIES THE CHANGE. A toolbar that is shorter
// when described but stands there differently would be no
// progress, but a second look. So this check paints
// the OLD version onto a canvas of its own -- same size,
// same theme, same font -- and holds its five rectangles
// against the five that the tree arranged. Whole numbers are compared,
// so the comparison is exact: a deviation of
// one point is a failure.
fn check_bars(m: *mut theme.Theme, fm: u64, x: f64, y: f64, w: f64,
    neu: *mut layout.Rect) -> bool {
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return false
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, W, 300) {
        return false
    }
    painter.painter_set_font(&z, fm)
    var c: render.Ctx = render.ctx_new(m, &z)
    var alt: [layout.Rect; 5] = [layout.rect_new(0, 0, 0, 0); 5]
    toolbar_painted(&c, m, x, y, w, (&alt[0]) as *mut layout.Rect)
    var equal: usize = 0
    var i: usize = 0
    while i < 5 {
        let n: *mut layout.Rect =
        (neu as u64 + (i * layout.rect_stride()) as u64)
        as *mut layout.Rect
        if layout.rect_x(n) == layout.rect_x(&alt[i])
        && layout.rect_y(n) == layout.rect_y(&alt[i])
        && layout.rect_w(n) == layout.rect_w(&alt[i])
        && layout.rect_h(n) == layout.rect_h(&alt[i]) {
            equal = equal + 1
        } else {
            // Whoever lands here wants to see the numbers and not just
            // hear that something is wrong.
            var b: rt.Buf = rt.buf_new()
            var p1: [u8; 16] = "fuidemo: Knoten "
            rt.buf_push_bytes(&b, (&p1[0]) as u64, 16)
            rt.buf_push_dec_i64(&b, i as i64)
            var p2: [u8; 12] = " beschrieben"
            rt.buf_push_bytes(&b, (&p2[0]) as u64, 12)
            four(&b, n)
            var p3: [u8; 7] = " gemalt"
            rt.buf_push_bytes(&b, (&p3[0]) as u64, 7)
            four(&b, &alt[i])
            rt.buf_push(&b, 10 as u8)
            rt.write_everything(2, rt.buf_ptr(&b), rt.buf_len(&b))
            rt.buf_free(&b)
        }
        i = i + 1
    }
    painter.painter_free(&z)
    canvas.canvas_free(&cv)
    if equal != 5 {
        return false
    }
    var ok: rt.Buf = rt.buf_new()
    var g1: [u8; 47] = "fuidemo: Werkzeugleiste beschrieben == gemalt, "
    rt.buf_push_bytes(&ok, (&g1[0]) as u64, 47)
    rt.buf_push_dec_i64(&ok, equal as i64)
    var g2: [u8; 18] = " von 5 Rechtecken\n"
    rt.buf_push_bytes(&ok, (&g2[0]) as u64, 18)
    rt.write_everything(1, rt.buf_ptr(&ok), rt.buf_len(&ok))
    rt.buf_free(&ok)
    return true
}

// ================================ AND THE SAME COMPARISON WHERE THE
//                                  CLAMPING REALLY APPLIES
//
// The bar of the demo is 952 points wide; the search field grows in it
// far beyond its minimum width, and a minimum width that never
// applies proves nothing. So the same bar is arranged a second time
// -- 280 points wide. There the field would without clamping
// shrink to a fraction; with `scene.node_set_bounds` or
// `flex.item_set_bounds` it stays at exactly 140, and both versions
// must still say the same rectangle by rectangle.
//
// Painting is done onto a canvas of ITS OWN: this narrow bar
// belongs to the check and not in the proof.
fn check_bars_narrow(m: *mut theme.Theme, fm: u64,
    width: f64) -> bool {
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return false
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, W, 300) {
        return false
    }
    painter.painter_set_font(&z, fm)
    var c: render.Ctx = render.ctx_new(m, &z)
    var rs: [layout.Rect; 5] = [layout.rect_new(0, 0, 0, 0); 5]
    toolbar(&c, 0.0, 0.0, width, (&rs[0]) as *mut layout.Rect)
    painter.painter_free(&z)
    canvas.canvas_free(&cv)
    // FIRST THE PROOF THAT THE CLAMPING APPLIES AT ALL. If
    // a number other than 140 stands here, the comparison below
    // again measures only the comfortable case -- and a check that
    // rules nothing out is none.
    var b: rt.Buf = rt.buf_new()
    var p1: [u8; 40] = "fuidemo: schmale Leiste, Suchfeld breit "
    rt.buf_push_bytes(&b, (&p1[0]) as u64, 40)
    rt.buf_push_dec_i64(&b, layout.rect_w(&rs[3]))
    var p2: [u8; 15] = " (geklemmt 140)"
    rt.buf_push_bytes(&b, (&p2[0]) as u64, 15)
    rt.buf_push(&b, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
    if layout.rect_w(&rs[3]) != 140 {
        return false
    }
    return check_bars(m, fm, 0.0, 0.0, width,
        (&rs[0]) as *mut layout.Rect)
}

// A rectangle as " x/y/w/h" into a buffer -- four times the same
// line would be four times the same error in the message above.
fn four(b: *mut rt.Buf, r: *mut layout.Rect) {
    rt.buf_push(b, 32 as u8)
    rt.buf_push_dec_i64(b, layout.rect_x(r))
    rt.buf_push(b, 47 as u8)
    rt.buf_push_dec_i64(b, layout.rect_y(r))
    rt.buf_push(b, 47 as u8)
    rt.buf_push_dec_i64(b, layout.rect_w(r))
    rt.buf_push(b, 47 as u8)
    rt.buf_push_dec_i64(b, layout.rect_h(r))
}

// =============================================== THE HOVER TRANSITION
//
// The tween lies in the REGISTRY (`anim.Animator`) and not loose next to
// the button: so a single `anim_tick` drives everything that is currently
// running, and its return value says whether a redraw is needed
// at all. A surface that keeps calculating while the picture is still
// burns power for no reason.
//
// A PNG has no time, so the phases stand side by side. The
// colour, the radius, the border and the offset come from
// `anim.Transition`, the clock from the registry.
fn hover_band(c: *mut render.Ctx, m: *mut theme.Theme, x: f64, y: f64,
    xs: *mut f64) -> usize {
    var e: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    var bt: [u8; 7] = "Publish"
    widget.w_set_text(&e, (&bt[0]) as u64, 7)
    widget.w_place(&e, x, y, KW, KH)

    var g: anim.Animator = anim.animator_new()
    let slot: usize = anim.animator_add(&g,
        anim.anim_new(0, HOVER_MS, 0.0, 1.0,
            anim.easing_named(anim.EASE_OUT)))
    if slot >= anim.ANIM_MAX {
        return 0
    }
    let a: *mut anim.Animation = anim.animator_at(&g, slot)

    var tr: anim.Transition = anim.trans_new(
        anim.widget_target_bg(c, &e, style.STATE_NORMAL),
        anim.widget_target_radius(c, &e, style.STATE_NORMAL),
        anim.widget_target_border(c, &e, style.STATE_NORMAL), 1.0)
    anim.trans_set_duration(&tr, HOVER_MS)
    anim.trans_set_easing(&tr, anim.easing_named(anim.EASE_OUT))
    // OKLab: two greys look the same in both spaces, but
    // an accent that runs across grey becomes pale in the middle in sRGB. The
    // transition at the button therefore takes the better path.
    anim.trans_set_oklab(&tr, true)
    // The target is the hover state; `trans_to_state` fetches its
    // values from the theme and style of the widget, not from numbers here.
    widget.w_set_state_bits(&e, 1 as u32)
    anim.trans_force_widget(&tr, c, &e, 0)

    var painted: usize = 0
    var i: usize = 0
    while i < PHASES {
        let t: i64 = ((i * (HOVER_MS as usize)) / (PHASES - 1)) as i64
        // ONLY IF SOMETHING CHANGES IS IT PAINTED -- and for the first
        // picture anyway: that is the demand-driven redrawing that
        // `anim_tick` offers with its return value.
        let runs: bool = anim.anim_tick(&g, t)
        anim.trans_tick(&tr, t)
        if runs || i == 0 {
            anim.trans_apply(&tr, &e)
            let px: f64 = x + (i as f64) * STEP
            // THE BUTTON RISES ALONG. A colour step from grey to
            // grey is mathematically right, but hardly visible in the picture;
            // a shadow that grows with the same tween
            // makes the progression visible -- and it grows
            // unevenly, because ease-out is fast at the start. The
            // numbers under the phases say the same in percent.
            //
            // THE OPACITY COMES UNCHANGED FROM THE THEME. Here there stood
            // until 21.09.2026 three times
            // `render.shadow_color`, because the then 32/255 under
            // a button of 118 x 36 could no longer be seen. Since
            // `Shape.shadow` stands at 64 (and is justified there),
            // the value of the library also carries under this small
            // shape -- and an application that calculates its shadow
            // to taste is exactly what fUi is meant to take off
            // the applications.
            let v: f64 = anim.anim_value(a, t)
            let sc: u32 = render.shadow_color(c)
            let sa: u32 = (sc >> 24) & 255 as u32
            effect.drop_shadow_spread(render.ctx_painter(c), px,
                y + anim.trans_dy(&tr), KW, KH, 8.0, 0.0,
                1.0 + 4.0 * v, (2.0 + 7.0 * v) as i64, 0.0,
                anim.mix_srgb(0 as u32,
                    (sa << 24) | (sc & 16777215 as u32), v))
            anim.trans_place(&tr, &e, px, y, KW, KH)
            render.draw_button(c, &e)
            *((xs as u64 + (painted * 8) as u64) as *mut f64) = px
            painted = painted + 1
        }
        // The time mark under the phase, plus the progress of the
        // tween in percent: equal time steps, unequal steps
        // in value -- that is exactly ease-out, and you can read it off the picture
        // instead of believing it.
        var lb: rt.Buf = rt.buf_new()
        rt.buf_push_dec_i64(&lb, t)
        var ms: [u8; 7] = " ms -- "
        rt.buf_push_bytes(&lb, (&ms[0]) as u64, 7)
        rt.buf_push_dec_i64(&lb,
            ((anim.anim_value(a, t) * 100.0) + 0.5) as i64)
        var pz: [u8; 1] = "%"
        rt.buf_push_bytes(&lb, (&pz[0]) as u64, 1)
        label(c, x + (i as f64) * STEP, y + KH + 8.0, KW, 11,
            rt.buf_ptr(&lb), rt.buf_len(&lb), style.TOK_TEXT_MUTED)
        rt.buf_free(&lb)
        i = i + 1
    }
    return painted
}

// ========================================================= THE DIALOG
//
// The card stands on the sheet, and what lifts it from it is the
// shadow -- with SPREAD, so that it lies like a halo under the card
// and not like a second rectangle. The button row in it distributes
// the flexbox again: `justify-content: flex-end`, as in every dialog
// since there have been dialogs.
fn dialog(c: *mut render.Ctx, m: *mut theme.Theme, x: f64, y: f64,
    w: f64, h: f64) {
    let f: *mut theme.Colors = theme.theme_colors(m)
    let z: *mut painter.Painter = render.ctx_painter(c)
    let r: f64 = 12.0
    effect.drop_shadow_spread(z, x, y, w, h, r, 0.0, 10.0, 12, 2.0,
        render.shadow_color(c))
    painter.round_rect(z, x, y, w, h, r,
        theme.opaque((*f).surface_raised))
    painter.round_ring(z, x, y, w, h, r, 1.0,
        theme.opaque((*f).border_col))

    var t1: [u8; 20] = "Discard the changes?"
    label(c, x + 20.0, y + 20.0, w - 40.0, 15, (&t1[0]) as u64, 20,
        style.TOK_TEXT)
    var t2: [u8; 42] = "Three files have not been written out yet."
    label(c, x + 20.0, y + 48.0, w - 40.0, 12, (&t2[0]) as u64, 42,
        style.TOK_TEXT_MUTED)

    var e: [widget.Widget; 2] = [widget.widget_new(widget.KIND_BUTTON); 2]
    var c1: [u8; 6] = "Cancel"
    var c2: [u8; 12] = "Discard them"
    widget.w_set_text(&e[0], (&c1[0]) as u64, 6)
    widget.w_set_text(&e[1], (&c2[0]) as u64, 12)
    let as1: *mut style.Style = widget.w_style(&e[1])
    *as1 = style.style_set_bg(*as1, style.color_token(style.TOK_ACCENT))
    *as1 = style.style_set_fg(*as1,
        style.color_token(style.TOK_TEXT_ON_ACCENT))

    var k: [flex.FlexItem; 2] = [flex.flex_item(0, 0); 2]
    k[0] = item_von_widget(c, &e[0], true)
    k[1] = item_von_widget(c, &e[1], true)
    var s: flex.FlexBox = flex.flexbox_new(flex.FLEX_ROW)
    flex.flex_set_padding(&s, 20, 0, 20, 16)
    flex.flex_set_gap(&s, 10, 0)
    flex.flex_set_justify(&s, flex.JUSTIFY_END)
    flex.flex_set_align_items(&s, flex.AL_END)
    var out: [layout.Rect; 2] = [layout.rect_new(0, 0, 0, 0); 2]
    var gr: [i64; 2] = [0; 2]
    var fz: [i64; 2] = [0; 2]
    flex.flex_layout(&s, layout.rect_new(x as i64, (y + h - 60.0) as i64,
            w as i64, 60.0 as i64), (&k[0]) as *mut flex.FlexItem, 2,
        (&out[0]) as *mut layout.Rect, (&gr[0]) as *mut i64,
        (&fz[0]) as *mut i64)
    var i: usize = 0
    while i < 2 {
        set(&e[i], &out[i])
        render.draw_button(c, &e[i])
        i = i + 1
    }
}

// The right card says in words what the picture shows in shapes: which
// function from which module built this page.
fn quellenkarte(c: *mut render.Ctx, m: *mut theme.Theme, x: f64, y: f64,
    w: f64, h: f64) {
    let f: *mut theme.Colors = theme.theme_colors(m)
    let z: *mut painter.Painter = render.ctx_painter(c)
    painter.round_rect(z, x, y, w, h, 12.0,
        theme.opaque((*f).surface_raised))
    painter.round_ring(z, x, y, w, h, 12.0, 1.0,
        theme.opaque((*f).border_col))
    var t: [u8; 25] = "What builds this picture:"
    label(c, x + 20.0, y + 20.0, w - 40.0, 14, (&t[0]) as u64, 25,
        style.TOK_TEXT)
    var l1: [u8; 38] = "flex.flex_layout -- title and tool bar"
    label(c, x + 20.0, y + 52.0, w - 40.0, 12, (&l1[0]) as u64, 38,
        style.TOK_TEXT_MUTED)
    var l2: [u8; 37] = "anim.Animator -- the hover band above"
    label(c, x + 20.0, y + 76.0, w - 40.0, 12, (&l2[0]) as u64, 37,
        style.TOK_TEXT_MUTED)
    var l3: [u8; 43] = "effect.drop_shadow_spread -- under the card"
    label(c, x + 20.0, y + 100.0, w - 40.0, 12, (&l3[0]) as u64, 43,
        style.TOK_TEXT_MUTED)
    var l4: [u8; 42] = "render.pref_of -- every basis was measured"
    label(c, x + 20.0, y + 124.0, w - 40.0, 12, (&l4[0]) as u64, 42,
        style.TOK_TEXT_MUTED)
}

// The phases must not cover each other: whoever paints them on top of one another
// shows only the last and claims there were seven. So it is
// re-calculated that two adjacent positions lie at least one
// button width apart -- in the picture and not on paper.
fn check_phases(xs: *mut f64, n: usize) -> bool {
    if n != PHASES {
        return false
    }
    var i: usize = 1
    while i < n {
        if *((xs as u64 + (i * 8) as u64) as *mut f64) - *(((xs as u64) + ((i - 1) * 8) as u64) as *mut f64) < KW {
            return false
        }
        i = i + 1
    }
    return true
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        var u: [u8; 42] = "fuidemo <out.png> [light|dark] [font.ttf]\n"
        rt.write_everything(2, (&u[0]) as u64, 42)
        return 2
    }
    let path: u64 = rt.arg_ptr(start, 1)
    var dark: bool = true
    if rt.arg_count(start) >= 3 {
        if rt.ld8(rt.arg_ptr(start, 2), 0) == 108 as u8 {
            dark = false
        }
    }
    var fbuf: rt.Buf = rt.buf_new()
    var have: bool = false
    if rt.arg_count(start) >= 4 {
        have = rt.read_file(rt.arg_ptr(start, 3), &fbuf)
    }
    if !have {
        var f1: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
        have = rt.read_file((&f1[0]) as u64, &fbuf)
    }
    let fsp: *mut metrics.FontSet =
    rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    if fsp as usize == 0 {
        return 3
    }
    *fsp = metrics.fontset_new()
    var fm: u64 = 0
    if have {
        if metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
            fm = fsp as u64
        }
    }
    // NO FONT, NO PROOF. A picture without a single
    // letter looks like a picture from afar, and that is exactly how
    // a text-less surface got through the acceptance in OrientOS. A proof without a label proves nothing -- so
    // an error on fd 2 and a return value on which the run
    // gets stuck, instead of writing a silent PNG.
    if fm == 0 {
        var ks: [u8; 59] = "fuidemo: keine Schrift gefunden -- ohne Schrift kein Beleg\n"
        rt.write_everything(2, (&ks[0]) as u64, 59)
        return 9
    }
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return 4
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, W, 300) {
        return 5
    }
    painter.painter_set_font(&z, fm)
    var m: theme.Theme = theme.theme_new(dark)
    var c: render.Ctx = render.ctx_new(&m, &z)
    let f: *mut theme.Colors = theme.theme_colors(&m)
    canvas.canvas_clear(&cv, theme.opaque((*f).base))

    titelzeile(&c, &m)

    var y: f64 = TITLE_H + 24.0
    var h1: [u8; 47] = "Tool bar -- flex.flex_layout, grow on the field"
    label(&c, PAD, y, 700.0, 12, (&h1[0]) as u64, 47,
        style.TOK_TEXT_MUTED)
    y = y + 20.0
    // THE TOOLBAR, DESCRIBED -- and next to it the check that
    // the painted version yields the same five rectangles. If they
    // do not match, no picture is produced: a proof that conceals a change
    // would be worse than none.
    var bar_r: [layout.Rect; 5] = [layout.rect_new(0, 0, 0, 0); 5]
    let bar_b: f64 = (W as f64) - 2.0 * PAD
    let bar_y: f64 = y
    y = toolbar(&c, PAD, y, bar_b,
        (&bar_r[0]) as *mut layout.Rect) + 28.0
    if !check_bars(&m, fm, PAD, bar_y, bar_b,
        (&bar_r[0]) as *mut layout.Rect) {
        var bl: [u8; 49] = "fuidemo: beschrieben und gemalt stehen anders da\n"
        rt.write_everything(2, (&bl[0]) as u64, 49)
        return 11
    }
    // AND THE SAME COMPARISON AT 280 POINTS, where the minimum width of the
    // search field really applies. Without this second pass the
    // check proved only the case in which clamping could happen, but
    // there is nothing to clamp.
    if !check_bars_narrow(&m, fm, 280.0) {
        var bs: [u8; 52] = "fuidemo: die schmale Leiste klemmt nicht wie gemalt\n"
        rt.write_everything(2, (&bs[0]) as u64, 52)
        return 12
    }

    var h2: [u8; 47] = "Hover -- anim.Animator, 240 ms, ease-out, OKLab"
    label(&c, PAD, y, 800.0, 12, (&h2[0]) as u64, 47,
        style.TOK_TEXT_MUTED)
    y = y + 20.0
    var xs: [f64; 7] = [0.0; 7]
    let painted: usize = hover_band(&c, &m, PAD, y,
        (&xs[0]) as *mut f64)
    if !check_phases((&xs[0]) as *mut f64, painted) {
        var bad: [u8; 44] = "fuidemo: the hover phases sit on each other\n"
        rt.write_everything(2, (&bad[0]) as u64, 44)
        return 8
    }
    y = y + KH + 8.0 + 18.0 + 28.0

    let dw: f64 = 460.0
    let dh: f64 = 176.0
    dialog(&c, &m, PAD, y, dw, dh)
    quellenkarte(&c, &m, PAD + dw + 32.0, y,
        (W as f64) - 2.0 * PAD - dw - 32.0, dh)

    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if !png.write_png(&cv, &out) {
        return 6
    }
    var pf: rt.Buf = rt.buf_new()
    var k: usize = 0
    while k < rt.c_length(path) {
        rt.buf_push(&pf, rt.ld8(path, k))
        k = k + 1
    }
    rt.buf_push(&pf, 0 as u8)
    if !rt.write_file(rt.buf_ptr(&pf), mem.buf_ptr(&out) as u64,
        mem.buf_len(&out)) {
        return 7
    }
    var okm: [u8; 8] = "FUIDEMO\n"
    rt.write_everything(1, (&okm[0]) as u64, 8)
    painter.painter_free(&z)
    canvas.canvas_free(&cv)
    return 0
}
