// SPDX-License-Identifier: MPL-2.0
// demos/fuidemo/main.fi -- EINE OBERFLAECHE, DIE DIE NEUEN MODULE BENUTZT.
//
// ========================================================= WARUM ES DAS GIBT
//
// lib/fui/flex.fi, lib/fui/anim.fi und lib/fui/effect.fi haben jedes
// eine eigene Pruefung und ein eigenes Belegbild. Das beweist, dass
// die Rechnung stimmt -- aber nicht, dass ein Anwender damit eine
// Oberflaeche baut. Ein Modul, das nur von seinem eigenen Test
// aufgerufen wird, ist eine Pruefbibliothek und kein Baustein.
//
// Also steht hier eine kleine Anwendung, so wie man sie schreiben
// wuerde, und sie benutzt alle drei auf dem NORMALEN Weg:
//
//   * die Werkzeugleiste und die Titelzeile werden von
//     `flex.flex_layout` verteilt, gemessen mit `render.pref_of` --
//     kein von Hand gerechnetes x je Knopf;
//   * der Uebergang normal -> hover eines Knopfes laeuft ueber
//     `anim.Animator`: ein Tween im Register, `anim.anim_tick` treibt
//     ihn, und nur wenn er `true` meldet, wird neu gezeichnet. Die
//     Phasen stehen nebeneinander im Bild, weil ein PNG keine Zeit hat;
//   * der Schatten unter dem Dialog kommt aus
//     `effect.drop_shadow_spread` -- mit Streuung, wie die vierte
//     Laenge in CSS `box-shadow`.
//
// Das Bild faellt in beiden Schemata an, hell und dunkel:
//
//     fuidemo <out.png> [light|dark] [<font.ttf>]
//
// Gebaut wird es von tools/fui/run.sh (Abschnitt "DIE DEMO-ANWENDUNG"),
// damit ein Bruch in einem der drei Module hier auffliegt und nicht
// erst beim naechsten Anwender.
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.style
import fui.widget
import fui.painter
import fui.render
import fui.layout
import fui.flex
import fui.anim
import fui.effect
import fui.sheet
import fui.scene

const FONTSET_BYTES: usize = 4096
const W: usize = 1000
const H: usize = 500

// Der Rand des Blattes und die Hoehe der Titelzeile.
const PAD: f64 = 24.0
const TITLE_H: f64 = 44.0

// Der Uebergang dauert so lange wie in theme.fi der Knopf: 240 ms sind
// die Zeit, die eine Maus braucht, um wirklich stehen zu bleiben.
const HOVER_MS: i64 = 240
const PHASEN: usize = 7

// Wie breit ein Knopf im Uebergangsband ist und wie weit die Phasen
// auseinander stehen. SCHRITT ist groesser als KW, also ueberlappt
// nichts -- das ist die Bedingung, die `pruefe_phasen` nachrechnet.
const KW: f64 = 118.0
const KH: f64 = 36.0
const SCHRITT: f64 = 136.0

// Eine Beschriftung. Farbe kommt als Token, also ist sie in hell wie
// in dunkel lesbar, ohne dass hier ein Schema abgefragt wird.
fn label(c: *mut render.Ctx, x: f64, y: f64, w: f64, px: usize, p: u64,
    n: usize, tok: u32) {
    var e: widget.Widget = widget.widget_new(widget.KIND_LABEL)
    widget.w_place(&e, x, y, w, 18.0)
    widget.w_set_text(&e, p, n)
    let s: *mut style.Style = widget.w_style(&e)
    *s = style.style_set_fg(*s, style.color_token(tok))
    *s = style.style_set_font(*s, 0, px)
    *s = style.style_set_pad(*s, 0, 0)
    render.draw_label(c, &e)
}

// DIE BRUECKE ZUM MESS-PROTOKOLL. `render.pref_of` misst in f64, die
// Flexbox rechnet ganzzahlig, und die Umrechnung steht genau einmal --
// in `flex.flex_item_from_pref`. Hier wird sie nur aufgerufen.
fn item_von_widget(c: *mut render.Ctx, e: *mut widget.Widget,
    zeile: bool) -> flex.FlexItem {
    var pw: f64 = 0.0
    var ph: f64 = 0.0
    render.pref_of(c, e, &pw, &ph)
    return flex.flex_item_from_pref(pw, ph, zeile)
}

// Die Kinder einer verteilten Zeile an ihren Platz setzen und malen.
fn setze(e: *mut widget.Widget, r: *mut layout.Rect) {
    widget.w_place(e, layout.rect_x(r) as f64, layout.rect_y(r) as f64,
        layout.rect_w(r) as f64, layout.rect_h(r) as f64)
}

// ===================================================== DIE TITELZEILE
//
// Ein Flex-Zeile ueber die ganze Breite: der Titel traegt `grow`, also
// bekommt er die ganze Luft und schiebt die beiden Knoepfe nach
// rechts. Genau so steht es in jeder Kopfleiste, und genau dafuer gibt
// es flex-grow.
fn titelzeile(c: *mut render.Ctx, m: *mut theme.Theme) {
    let f: *mut theme.Colors = theme.theme_colors(m)
    let z: *mut painter.Painter = render.ctx_painter(c)
    painter.surface(z, 0.0, 0.0, W as f64, TITLE_H,
        theme.opaque((*f).surface))
    painter.surface(z, 0.0, TITLE_H - 1.0, W as f64, 1.0,
        theme.opaque((*f).separator))

    var tt: widget.Widget = widget.widget_new(widget.KIND_LABEL)
    var s0: [u8; 18] = "Firn UI -- fuidemo"
    widget.w_set_text(&tt, (&s0[0]) as u64, 18)
    let ts: *mut style.Style = widget.w_style(&tt)
    *ts = style.style_set_font(*ts, 0, 14)
    *ts = style.style_set_pad(*ts, 0, 0)

    var b1: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    var s1: [u8; 4] = "Help"
    widget.w_set_text(&b1, (&s1[0]) as u64, 4)
    var b2: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    var s2: [u8; 8] = "Settings"
    widget.w_set_text(&b2, (&s2[0]) as u64, 8)

    var k: [flex.FlexItem; 3] = [flex.flex_item(0, 0); 3]
    k[0] = item_von_widget(c, &tt, true)
    k[1] = item_von_widget(c, &b1, true)
    k[2] = item_von_widget(c, &b2, true)
    // Nur der Titel waechst; die Knoepfe bleiben so breit, wie ihr
    // Text gemessen wurde.
    flex.item_set_flex(&k[0], 1000, 0, k[0].basis)

    var s: flex.FlexBox = flex.flexbox_new(flex.FLEX_ROW)
    flex.flex_set_padding(&s, 16, 8, 16, 8)
    flex.flex_set_gap(&s, 8, 0)
    flex.flex_set_align_items(&s, flex.AL_CENTER)
    var out: [layout.Rect; 3] = [layout.rect_new(0, 0, 0, 0); 3]
    var gr: [i64; 3] = [0; 3]
    var fz: [i64; 3] = [0; 3]
    flex.flex_layout(&s, layout.rect_new(0, 0, W as i64, TITLE_H as i64),
        (&k[0]) as *mut flex.FlexItem, 3,
        (&out[0]) as *mut layout.Rect, (&gr[0]) as *mut i64,
        (&fz[0]) as *mut i64)

    setze(&tt, &out[0])
    render.draw_label(c, &tt)
    setze(&b1, &out[1])
    render.draw_button(c, &b1)
    setze(&b2, &out[2])
    render.draw_button(c, &b2)
}

// DIE RECHTECKE FUER DEN VERGLEICH. Sie gehoeren nicht zur Oberflaeche,
// sondern zur Pruefung: gelesen wird, was Durchgang 3 hinterlassen hat,
// nicht was Durchgang 4 gemalt hat.
fn rechtecke(sc: *mut scene.Scene, leiste: usize, rs: *mut layout.Rect) {
    var i: usize = 0
    while i < 5 {
        let b: usize = scene.scene_child_at(sc, leiste, i)
        let ziel: *mut layout.Rect =
            (rs as u64 + (i * layout.rect_stride()) as u64)
                as *mut layout.Rect
        *ziel =
            layout.rect_new(scene.node_x(sc, b) as i64,
                scene.node_y(sc, b) as i64, scene.node_w(sc, b) as i64,
                scene.node_h(sc, b) as i64)
        i = i + 1
    }
}

// ================================================== DIE WERKZEUGLEISTE
//
// Drei Knoepfe links, ein Suchfeld das den Rest nimmt, ein Knopf
// rechts -- BESCHRIEBEN und nicht gemalt. Der Baum sagt, WAS dasteht
// (ein Kasten der Klasse `leiste` mit fuenf Kindern), das Stilblatt
// sagt, WIE es aussieht (gehobene Flaeche, ein Punkt Rand, der letzte
// Knopf im Akzent), und lib/fui/scene.fi laesst flex.fi rechnen. Keine
// Koordinate steht hier: kein x je Knopf, kein eigenes `setze`, keine
// zweite Verteilschleife.
//
// Daneben steht `werkzeugleiste_gemalt` -- dieselbe Leiste, Aufruf fuer
// Aufruf gemalt, wie sie bis zum 21.09.2026 hier stand. Sie bleibt aus
// zwei Gruenden: tools/fui/run.sh (Abschnitt 19c) zaehlt an ihr die
// Zeilen, die die Beschreibung spart, und `pruefe_leisten` haelt beide
// Fassungen Rechteck fuer Rechteck gegeneinander. Eine Umstellung, die
// das Bild verschiebt, faellt damit auf, bevor sie im Beleg steht -- und
// tatsaechlich ist das PNG dieser Demo Byte fuer Byte dasselbe wie vor
// der Umstellung.
//
// UND DIE EHRLICHE ZAHL DAZU: hier stehen 55 Zeilen Code gegen 57
// gemalte, also fast gleich viel. Der Grund steht zwei Absaetze weiter
// oben: ein Stilblatt fuer EINE Leiste amortisiert sich nicht. Die
// Ersparnis wird erst auf einer SEITE sichtbar, wo dieselben Regeln
// Kopfzeile, Leiste und Karten treffen -- tools/fui/gallery9_main.fi
// beschreibt dieselbe Leiste in 23 Zeilen Baum, und genau diese beiden
// Zahlen rechnet tools/fui/run.sh (Abschnitt 19c) nach.
//
// UND DIE KLEMMUNG STEHT JETZT AUF BEIDEN SEITEN. Die gemalte Fassung
// haelt das Suchfeld mit `flex.item_set_bounds(&k[3], 140, 0)` bei 140
// Punkten Mindestbreite; die beschriebene sagt dasselbe mit
// `scene.node_set_bounds(&sc, leiste + 4, 140, 0)`, und geklemmt wird
// in beiden Faellen an EINER Stelle -- in flex.fi. Bis zum 21.09.2026
// gab es diesen Knoten nicht, und `pruefe_leisten` belegte darum nur
// den bequemen Fall: bei 952 Punkten Leistenbreite waechst das Feld
// ohnehin weit ueber 140, da greift keine Klemmung. Deshalb laeuft der
// Vergleich jetzt ZWEIMAL -- einmal breit (die Klemmung schweigt) und
// einmal bei 280 Punkten, wo sie wirklich greift und das Feld sonst
// auf ein Drittel davon schrumpfen wuerde.
//
// Zurueck kommt die Unterkante, damit der Aufrufer weiterrechnen kann,
// statt dieselbe Zahl ein zweites Mal hinzuschreiben; in `rs` legt die
// Leiste die fuenf angeordneten Rechtecke ab, die der Vergleich liest.
fn werkzeugleiste(c: *mut render.Ctx, x: f64, y: f64, w: f64,
    rs: *mut layout.Rect) -> f64 {
    // >>> LEISTE BESCHRIEBEN
    let h: f64 = 56.0
    var nleiste: [u8; 6] = "leiste"
    var nakzent: [u8; 6] = "akzent"
    let k_leiste: u32 = sheet.sheet_name((&nleiste[0]) as u64, 6)
    let k_akzent: u32 = sheet.sheet_name((&nakzent[0]) as u64, 6)

    // ---- DAS STILBLATT. Zwei Regeln, nach Klassen ausgewaehlt.
    var sh: sheet.Sheet = sheet.sheet_new()
    var d1: sheet.Decl = sheet.decl_new()
    var s1: style.Style = style.style_new()
    s1 = style.style_set_bg(s1, style.color_token(style.TOK_SURFACE_RAISED))
    s1 = style.style_set_border(s1, style.color_token(style.TOK_BORDER), 1)
    s1 = style.style_set_radius(s1, 10)
    sheet.decl_set_style(&d1, s1)
    sheet.sheet_add(&sh, sheet.sel_class(k_leiste), d1)
    var d2: sheet.Decl = sheet.decl_new()
    var s2: style.Style = style.style_new()
    s2 = style.style_set_bg(s2, style.color_token(style.TOK_ACCENT))
    s2 = style.style_set_fg(s2,
        style.color_token(style.TOK_TEXT_ON_ACCENT))
    sheet.decl_set_style(&d2, s2)
    sheet.sheet_add(&sh, sheet.sel_class(k_akzent), d2)

    // ---- DER BAUM. Die Beschriftungen liegen hier, denn ein Knoten
    // haelt nur den Zeiger auf seinen Text -- wie jedes Widget dieser
    // Bibliothek.
    var t0: [u8; 3] = "New"
    var t1: [u8; 4] = "Open"
    var t2: [u8; 4] = "Save"
    var t3: [u8; 17] = "Search in project"
    var t4: [u8; 3] = "Run"
    var sc: scene.Scene = scene.scene_new()
    let leiste: usize = scene.scene_add(&sc, scene.SCENE_NONE, scene.N_BOX)
    scene.node_add_class(&sc, leiste, k_leiste)
    scene.node_set_flex(&sc, leiste, flex.FLEX_ROW, flex.JUSTIFY_START,
        flex.AL_CENTER)
    scene.node_set_padding(&sc, leiste, 10, 10, 10, 10)
    scene.node_set_gap(&sc, leiste, 10, 0)
    // Die fuenf Kinder: erst alle gleich, dann die zwei Ausnahmen. Die
    // Knoten liegen in der Reihenfolge, in der sie angelegt wurden, also
    // bei leiste + 1 bis leiste + 5 (scene.scene_add gibt Plaetze aus).
    var j: usize = 0
    while j < 5 {
        let b: usize = scene.scene_add(&sc, leiste, scene.N_WIDGET)
        scene.node_set_widget_kind(&sc, b, widget.KIND_BUTTON)
        j = j + 1
    }
    scene.node_set_text(&sc, leiste + 1, (&t0[0]) as u64, 3)
    scene.node_set_text(&sc, leiste + 2, (&t1[0]) as u64, 4)
    scene.node_set_text(&sc, leiste + 3, (&t2[0]) as u64, 4)
    scene.node_set_text(&sc, leiste + 4, (&t3[0]) as u64, 17)
    scene.node_set_text(&sc, leiste + 5, (&t4[0]) as u64, 3)
    // Das Suchfeld ist ein Textfeld und nimmt den Rest; der letzte Knopf
    // traegt den Akzent -- beides sagt der Baum, nicht eine Koordinate.
    scene.node_set_widget_kind(&sc, leiste + 4, widget.KIND_TEXTBOX)
    scene.node_set_grow(&sc, leiste + 4, 1000, 1000)
    scene.node_set_bounds(&sc, leiste + 4, 140, 0)
    scene.node_add_class(&sc, leiste + 5, k_akzent)

    // ---- DIE VIER DURCHGAENGE, IN IHRER REIHENFOLGE
    scene.scene_style(&sc, &sh)
    scene.scene_measure(&sc, c)
    scene.scene_layout(&sc, c, x, y, w, h)
    scene.scene_draw(&sc, c)
    // <<< LEISTE BESCHRIEBEN
    // WENN DER BAUM NICHT VOLLSTAENDIG IST, STEHT ES DA. Ein Knoten,
    // den `scene_add` abgewiesen hat, fehlt im Bild -- und ein
    // Rueckgabewert, den niemand ansieht, ist keine Meldung.
    // `scene_overflow_reason` fasst die vier Schranken in EINER Zahl
    // zusammen; hier ist sie null, und wenn sie das eines Tages nicht
    // mehr ist, liest man es in der Ausgabe statt im Bild zu suchen.
    if scene.scene_overflow_reason(&sc) != scene.OF_NONE {
        var wr: rt.Buf = rt.buf_new()
        var wt: [u8; 42] = "fuidemo: Werkzeugleiste unvollstaendig, Gr"
        rt.buf_push_bytes(&wr, (&wt[0]) as u64, 42)
        var wu: [u8; 4] = "und "
        rt.buf_push_bytes(&wr, (&wu[0]) as u64, 4)
        rt.buf_push_dec_i64(&wr, scene.scene_overflow_reason(&sc) as i64)
        rt.buf_push(&wr, 10 as u8)
        rt.write_everything(2, rt.buf_ptr(&wr), rt.buf_len(&wr))
        rt.buf_free(&wr)
    }
    rechtecke(&sc, leiste, rs)
    return y + h
}

// DIE GEMALTE FASSUNG, NUR NOCH ZUM VERGLEICH. Sie steht Zeile fuer
// Zeile so da, wie sie gearbeitet hat: Grund und Rand von Hand, fuenf
// FlexItems von Hand gemessen, eine eigene Verteilschleife, jedes
// Rechteck selbst gesetzt. Sie malt in `pruefe_leisten` auf eine
// EIGENE Leinwand -- zweimal auf dieselbe zu malen wuerde die weichen
// Kanten doppelt deckend machen und den Beleg verfaelschen.
fn werkzeugleiste_gemalt(c: *mut render.Ctx, m: *mut theme.Theme, x: f64,
    y: f64, w: f64, ro: *mut layout.Rect) -> f64 {
    // >>> LEISTE GEMALT
    let f: *mut theme.Colors = theme.theme_colors(m)
    let z: *mut painter.Painter = render.ctx_painter(c)
    let h: f64 = 56.0
    painter.round_rect(z, x, y, w, h, 10.0,
        theme.opaque((*f).surface_raised))
    painter.round_ring(z, x, y, w, h, 10.0, 1.0,
        theme.opaque((*f).border_col))

    var e: [widget.Widget; 5] = [widget.widget_new(widget.KIND_BUTTON); 5]
    var t0: [u8; 3] = "New"
    var t1: [u8; 4] = "Open"
    var t2: [u8; 4] = "Save"
    var t3: [u8; 17] = "Search in project"
    var t4: [u8; 3] = "Run"
    e[3] = widget.widget_new(widget.KIND_TEXTBOX)
    widget.w_set_text(&e[0], (&t0[0]) as u64, 3)
    widget.w_set_text(&e[1], (&t1[0]) as u64, 4)
    widget.w_set_text(&e[2], (&t2[0]) as u64, 4)
    widget.w_set_text(&e[3], (&t3[0]) as u64, 17)
    widget.w_set_text(&e[4], (&t4[0]) as u64, 3)
    // Der letzte Knopf ist der, den man drueckt: er traegt den Akzent.
    let rs: *mut style.Style = widget.w_style(&e[4])
    *rs = style.style_set_bg(*rs, style.color_token(style.TOK_ACCENT))
    *rs = style.style_set_fg(*rs,
        style.color_token(style.TOK_TEXT_ON_ACCENT))

    var k: [flex.FlexItem; 5] = [flex.flex_item(0, 0); 5]
    var i: usize = 0
    while i < 5 {
        k[i] = item_von_widget(c, &e[i], true)
        i = i + 1
    }
    flex.item_set_flex(&k[3], 1000, 1000, k[3].basis)
    flex.item_set_bounds(&k[3], 140, 0)

    var s: flex.FlexBox = flex.flexbox_new(flex.FLEX_ROW)
    flex.flex_set_padding(&s, 10, 10, 10, 10)
    flex.flex_set_gap(&s, 10, 0)
    flex.flex_set_align_items(&s, flex.AL_CENTER)
    var out: [layout.Rect; 5] = [layout.rect_new(0, 0, 0, 0); 5]
    var gr: [i64; 5] = [0; 5]
    var fz: [i64; 5] = [0; 5]
    flex.flex_layout(&s, layout.rect_new(x as i64, y as i64, w as i64,
        h as i64), (&k[0]) as *mut flex.FlexItem, 5,
        (&out[0]) as *mut layout.Rect, (&gr[0]) as *mut i64,
        (&fz[0]) as *mut i64)
    i = 0
    while i < 5 {
        setze(&e[i], &out[i])
        if i == 3 {
            render.draw_widget(c, &e[i])
        } else {
            render.draw_button(c, &e[i])
        }
        i = i + 1
    }
    // <<< LEISTE GEMALT
    // Ab hier steht nicht mehr die Leiste, sondern die PRUEFUNG: die
    // fuenf angeordneten Rechtecke werden fuer `pruefe_leisten`
    // herausgereicht. Sie stand bis zum 22.09.2026 mitten in der
    // Zeichenschleife und zaehlte damit im Zeilenvergleich (Abschnitt
    // 19d) auf der gemalten Seite mit -- eine Zeile, die es auf der
    // beschriebenen Seite als `rechtecke(...)` ebenfalls gibt, und
    // zwar ausserhalb ihrer Marken. Zwei Seiten, zwei Massstaebe: das
    // ist genau die Rechnung, gegen die dieser Vergleich geschrieben
    // ist.
    i = 0
    while i < 5 {
        let zeiger: *mut layout.Rect =
            (ro as u64 + (i * layout.rect_stride()) as u64)
                as *mut layout.Rect
        *zeiger = out[i]
        i = i + 1
    }
    return y + h
}

// ================================ BESCHRIEBEN == GEMALT, RECHTECK FUER
//                                  RECHTECK
//
// DIE PRUEFUNG, DIE DIE UMSTELLUNG TRAEGT. Eine Werkzeugleiste, die
// beschrieben zwar kuerzer ist, aber anders dasteht, waere kein
// Fortschritt, sondern ein zweites Aussehen. Also malt diese Pruefung
// die ALTE Fassung auf eine eigene Leinwand -- gleiche Groesse,
// gleiches Thema, gleiche Schrift -- und haelt ihre fuenf Rechtecke
// gegen die fuenf, die der Baum angeordnet hat. Verglichen werden
// ganze Zahlen, also ist der Vergleich exakt: eine Abweichung von
// einem Punkt ist ein Fehlschlag.
fn pruefe_leisten(m: *mut theme.Theme, fm: u64, x: f64, y: f64, w: f64,
    neu: *mut layout.Rect) -> bool {
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return false
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, W, 300) {
        return false
    }
    painter.painter_set_font(&z, fm)
    var c: render.Ctx = render.ctx_new(m, &z)
    var alt: [layout.Rect; 5] = [layout.rect_new(0, 0, 0, 0); 5]
    werkzeugleiste_gemalt(&c, m, x, y, w, (&alt[0]) as *mut layout.Rect)
    var gleich: usize = 0
    var i: usize = 0
    while i < 5 {
        let n: *mut layout.Rect =
            (neu as u64 + (i * layout.rect_stride()) as u64)
                as *mut layout.Rect
        if layout.rect_x(n) == layout.rect_x(&alt[i])
            && layout.rect_y(n) == layout.rect_y(&alt[i])
            && layout.rect_w(n) == layout.rect_w(&alt[i])
            && layout.rect_h(n) == layout.rect_h(&alt[i]) {
            gleich = gleich + 1
        } else {
            // Wer hier landet, will die Zahlen sehen und nicht nur
            // hoeren, dass etwas nicht stimmt.
            var b: rt.Buf = rt.buf_new()
            var p1: [u8; 16] = "fuidemo: Knoten "
            rt.buf_push_bytes(&b, (&p1[0]) as u64, 16)
            rt.buf_push_dec_i64(&b, i as i64)
            var p2: [u8; 12] = " beschrieben"
            rt.buf_push_bytes(&b, (&p2[0]) as u64, 12)
            vier(&b, n)
            var p3: [u8; 7] = " gemalt"
            rt.buf_push_bytes(&b, (&p3[0]) as u64, 7)
            vier(&b, &alt[i])
            rt.buf_push(&b, 10 as u8)
            rt.write_everything(2, rt.buf_ptr(&b), rt.buf_len(&b))
            rt.buf_free(&b)
        }
        i = i + 1
    }
    painter.painter_free(&z)
    canvas.canvas_free(&cv)
    if gleich != 5 {
        return false
    }
    var ok: rt.Buf = rt.buf_new()
    var g1: [u8; 47] = "fuidemo: Werkzeugleiste beschrieben == gemalt, "
    rt.buf_push_bytes(&ok, (&g1[0]) as u64, 47)
    rt.buf_push_dec_i64(&ok, gleich as i64)
    var g2: [u8; 18] = " von 5 Rechtecken\n"
    rt.buf_push_bytes(&ok, (&g2[0]) as u64, 18)
    rt.write_everything(1, rt.buf_ptr(&ok), rt.buf_len(&ok))
    rt.buf_free(&ok)
    return true
}

// ================================ UND DERSELBE VERGLEICH DORT, WO DIE
//                                  KLEMMUNG WIRKLICH GREIFT
//
// Die Leiste der Demo ist 952 Punkte breit; das Suchfeld waechst darin
// weit ueber seine Mindestbreite, und eine Mindestbreite, die nie
// greift, belegt nichts. Also wird dieselbe Leiste ein zweites Mal
// angeordnet -- 280 Punkte breit. Dort wuerde das Feld ohne Klemmung
// auf einen Bruchteil schrumpfen; mit `scene.node_set_bounds` bzw.
// `flex.item_set_bounds` bleibt es bei genau 140, und beide Fassungen
// muessen weiterhin Rechteck fuer Rechteck dasselbe sagen.
//
// Gemalt wird dabei auf eine EIGENE Leinwand: diese schmale Leiste
// gehoert zur Pruefung und nicht in den Beleg.
fn pruefe_leisten_schmal(m: *mut theme.Theme, fm: u64,
    breite: f64) -> bool {
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return false
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, W, 300) {
        return false
    }
    painter.painter_set_font(&z, fm)
    var c: render.Ctx = render.ctx_new(m, &z)
    var rs: [layout.Rect; 5] = [layout.rect_new(0, 0, 0, 0); 5]
    werkzeugleiste(&c, 0.0, 0.0, breite, (&rs[0]) as *mut layout.Rect)
    painter.painter_free(&z)
    canvas.canvas_free(&cv)
    // ERST DER NACHWEIS, DASS DIE KLEMMUNG UEBERHAUPT GREIFT. Steht
    // hier eine andere Zahl als 140, misst der Vergleich darunter
    // wieder nur den bequemen Fall -- und eine Pruefung, die nichts
    // ausschliesst, ist keine.
    var b: rt.Buf = rt.buf_new()
    var p1: [u8; 40] = "fuidemo: schmale Leiste, Suchfeld breit "
    rt.buf_push_bytes(&b, (&p1[0]) as u64, 40)
    rt.buf_push_dec_i64(&b, layout.rect_w(&rs[3]))
    var p2: [u8; 15] = " (geklemmt 140)"
    rt.buf_push_bytes(&b, (&p2[0]) as u64, 15)
    rt.buf_push(&b, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
    if layout.rect_w(&rs[3]) != 140 {
        return false
    }
    return pruefe_leisten(m, fm, 0.0, 0.0, breite,
        (&rs[0]) as *mut layout.Rect)
}

// Ein Rechteck als " x/y/w/h" an einen Puffer -- viermal dieselbe
// Zeile waere in der Meldung oben viermal derselbe Fehler.
fn vier(b: *mut rt.Buf, r: *mut layout.Rect) {
    rt.buf_push(b, 32 as u8)
    rt.buf_push_dec_i64(b, layout.rect_x(r))
    rt.buf_push(b, 47 as u8)
    rt.buf_push_dec_i64(b, layout.rect_y(r))
    rt.buf_push(b, 47 as u8)
    rt.buf_push_dec_i64(b, layout.rect_w(r))
    rt.buf_push(b, 47 as u8)
    rt.buf_push_dec_i64(b, layout.rect_h(r))
}

// =============================================== DER HOVER-UEBERGANG
//
// Der Tween liegt im REGISTER (`anim.Animator`) und nicht lose neben
// dem Knopf: so treibt ein einziges `anim_tick` alles, was gerade
// laeuft, und sein Rueckgabewert sagt, ob ueberhaupt neu gezeichnet
// werden muss. Eine Oberflaeche, die bei stehendem Bild weiterrechnet,
// verbrennt Strom ohne Grund.
//
// Ein PNG hat keine Zeit, also stehen die Phasen nebeneinander. Die
// Farbe, der Radius, der Rand und die Verschiebung kommen aus
// `anim.Transition`, die Uhr aus dem Register.
fn hover_band(c: *mut render.Ctx, m: *mut theme.Theme, x: f64, y: f64,
    xs: *mut f64) -> usize {
    var e: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    var bt: [u8; 7] = "Publish"
    widget.w_set_text(&e, (&bt[0]) as u64, 7)
    widget.w_place(&e, x, y, KW, KH)

    var g: anim.Animator = anim.animator_new()
    let slot: usize = anim.animator_add(&g,
        anim.anim_new(0, HOVER_MS, 0.0, 1.0,
            anim.easing_named(anim.EASE_OUT)))
    if slot >= anim.ANIM_MAX {
        return 0
    }
    let a: *mut anim.Animation = anim.animator_at(&g, slot)

    var tr: anim.Transition = anim.trans_new(
        anim.widget_target_bg(c, &e, style.STATE_NORMAL),
        anim.widget_target_radius(c, &e, style.STATE_NORMAL),
        anim.widget_target_border(c, &e, style.STATE_NORMAL), 1.0)
    anim.trans_set_duration(&tr, HOVER_MS)
    anim.trans_set_easing(&tr, anim.easing_named(anim.EASE_OUT))
    // OKLab: zwei Grautoene sehen in beiden Raeumen gleich aus, aber
    // ein Akzent, der ueber Grau laeuft, wird in sRGB in der Mitte
    // fahl. Der Uebergang am Knopf nimmt darum den besseren Weg.
    anim.trans_set_oklab(&tr, true)
    // Das Ziel ist der Hover-Zustand; `trans_to_state` holt seine
    // Werte aus Theme und Style des Widgets, nicht aus Zahlen hier.
    widget.w_set_state_bits(&e, 1 as u32)
    anim.trans_force_widget(&tr, c, &e, 0)

    var gemalt: usize = 0
    var i: usize = 0
    while i < PHASEN {
        let t: i64 = ((i * (HOVER_MS as usize)) / (PHASEN - 1)) as i64
        // NUR WENN SICH ETWAS AENDERT, WIRD GEMALT -- und beim ersten
        // Bild sowieso: das ist das bedarfsgesteuerte Neuzeichnen, das
        // `anim_tick` mit seinem Rueckgabewert anbietet.
        let laeuft: bool = anim.anim_tick(&g, t)
        anim.trans_tick(&tr, t)
        if laeuft || i == 0 {
            anim.trans_apply(&tr, &e)
            let px: f64 = x + (i as f64) * SCHRITT
            // DER KNOPF HEBT SICH MIT. Ein Farbschritt von Grau nach
            // Grau ist rechnerisch richtig, aber am Bild kaum zu
            // sehen; ein Schatten, der mit demselben Tween waechst,
            // macht den Verlauf sichtbar -- und er waechst
            // ungleichmaessig, weil ease-out vorne schnell ist. Die
            // Zahlen unter den Phasen sagen dasselbe in Prozent.
            //
            // DIE DECKUNG KOMMT UNVERAENDERT AUS DEM THEME. Hier stand
            // bis zum 21.09.2026 das Dreifache von
            // `render.shadow_color`, weil die damaligen 32/255 unter
            // einem Knopf von 118 x 36 nicht mehr zu sehen waren. Seit
            // `Shape.shadow` auf 64 steht (und dort begruendet ist),
            // traegt der Wert der Bibliothek auch unter dieser kleinen
            // Form -- und eine Anwendung, die sich ihren Schatten
            // selbst zurechtrechnet, ist genau das, was fUi den
            // Anwendungen abnehmen soll.
            let v: f64 = anim.anim_value(a, t)
            let sc: u32 = render.shadow_color(c)
            let sa: u32 = (sc >> 24) & 255 as u32
            effect.drop_shadow_spread(render.ctx_painter(c), px,
                y + anim.trans_dy(&tr), KW, KH, 8.0, 0.0,
                1.0 + 4.0 * v, (2.0 + 7.0 * v) as i64, 0.0,
                anim.mix_srgb(0 as u32,
                    (sa << 24) | (sc & 16777215 as u32), v))
            anim.trans_place(&tr, &e, px, y, KW, KH)
            render.draw_button(c, &e)
            *((xs as u64 + (gemalt * 8) as u64) as *mut f64) = px
            gemalt = gemalt + 1
        }
        // Die Zeitmarke unter der Phase, dazu der Fortschritt des
        // Tweens in Prozent: gleiche Zeitschritte, ungleiche Schritte
        // im Wert -- genau das ist ease-out, und man kann es am Bild
        // ablesen statt es zu glauben.
        var lb: rt.Buf = rt.buf_new()
        rt.buf_push_dec_i64(&lb, t)
        var ms: [u8; 7] = " ms -- "
        rt.buf_push_bytes(&lb, (&ms[0]) as u64, 7)
        rt.buf_push_dec_i64(&lb,
            ((anim.anim_value(a, t) * 100.0) + 0.5) as i64)
        var pz: [u8; 1] = "%"
        rt.buf_push_bytes(&lb, (&pz[0]) as u64, 1)
        label(c, x + (i as f64) * SCHRITT, y + KH + 8.0, KW, 11,
            rt.buf_ptr(&lb), rt.buf_len(&lb), style.TOK_TEXT_MUTED)
        rt.buf_free(&lb)
        i = i + 1
    }
    return gemalt
}

// ========================================================= DER DIALOG
//
// Die Karte steht auf dem Blatt, und was sie davon abhebt, ist der
// Schatten -- mit STREUUNG, damit er wie ein Hof unter der Karte liegt
// und nicht wie ein zweites Rechteck. Die Knopfzeile darin verteilt
// wieder die Flexbox: `justify-content: flex-end`, wie in jedem
// Dialog seit es Dialoge gibt.
fn dialog(c: *mut render.Ctx, m: *mut theme.Theme, x: f64, y: f64,
    w: f64, h: f64) {
    let f: *mut theme.Colors = theme.theme_colors(m)
    let z: *mut painter.Painter = render.ctx_painter(c)
    let r: f64 = 12.0
    effect.drop_shadow_spread(z, x, y, w, h, r, 0.0, 10.0, 12, 2.0,
        render.shadow_color(c))
    painter.round_rect(z, x, y, w, h, r,
        theme.opaque((*f).surface_raised))
    painter.round_ring(z, x, y, w, h, r, 1.0,
        theme.opaque((*f).border_col))

    var t1: [u8; 20] = "Discard the changes?"
    label(c, x + 20.0, y + 20.0, w - 40.0, 15, (&t1[0]) as u64, 20,
        style.TOK_TEXT)
    var t2: [u8; 42] = "Three files have not been written out yet."
    label(c, x + 20.0, y + 48.0, w - 40.0, 12, (&t2[0]) as u64, 42,
        style.TOK_TEXT_MUTED)

    var e: [widget.Widget; 2] = [widget.widget_new(widget.KIND_BUTTON); 2]
    var c1: [u8; 6] = "Cancel"
    var c2: [u8; 12] = "Discard them"
    widget.w_set_text(&e[0], (&c1[0]) as u64, 6)
    widget.w_set_text(&e[1], (&c2[0]) as u64, 12)
    let as1: *mut style.Style = widget.w_style(&e[1])
    *as1 = style.style_set_bg(*as1, style.color_token(style.TOK_ACCENT))
    *as1 = style.style_set_fg(*as1,
        style.color_token(style.TOK_TEXT_ON_ACCENT))

    var k: [flex.FlexItem; 2] = [flex.flex_item(0, 0); 2]
    k[0] = item_von_widget(c, &e[0], true)
    k[1] = item_von_widget(c, &e[1], true)
    var s: flex.FlexBox = flex.flexbox_new(flex.FLEX_ROW)
    flex.flex_set_padding(&s, 20, 0, 20, 16)
    flex.flex_set_gap(&s, 10, 0)
    flex.flex_set_justify(&s, flex.JUSTIFY_END)
    flex.flex_set_align_items(&s, flex.AL_END)
    var out: [layout.Rect; 2] = [layout.rect_new(0, 0, 0, 0); 2]
    var gr: [i64; 2] = [0; 2]
    var fz: [i64; 2] = [0; 2]
    flex.flex_layout(&s, layout.rect_new(x as i64, (y + h - 60.0) as i64,
        w as i64, 60.0 as i64), (&k[0]) as *mut flex.FlexItem, 2,
        (&out[0]) as *mut layout.Rect, (&gr[0]) as *mut i64,
        (&fz[0]) as *mut i64)
    var i: usize = 0
    while i < 2 {
        setze(&e[i], &out[i])
        render.draw_button(c, &e[i])
        i = i + 1
    }
}

// Die rechte Karte sagt in Worten, was das Bild in Formen zeigt: welche
// Funktion aus welchem Modul diese Seite gebaut hat.
fn quellenkarte(c: *mut render.Ctx, m: *mut theme.Theme, x: f64, y: f64,
    w: f64, h: f64) {
    let f: *mut theme.Colors = theme.theme_colors(m)
    let z: *mut painter.Painter = render.ctx_painter(c)
    painter.round_rect(z, x, y, w, h, 12.0,
        theme.opaque((*f).surface_raised))
    painter.round_ring(z, x, y, w, h, 12.0, 1.0,
        theme.opaque((*f).border_col))
    var t: [u8; 25] = "What builds this picture:"
    label(c, x + 20.0, y + 20.0, w - 40.0, 14, (&t[0]) as u64, 25,
        style.TOK_TEXT)
    var l1: [u8; 38] = "flex.flex_layout -- title and tool bar"
    label(c, x + 20.0, y + 52.0, w - 40.0, 12, (&l1[0]) as u64, 38,
        style.TOK_TEXT_MUTED)
    var l2: [u8; 37] = "anim.Animator -- the hover band above"
    label(c, x + 20.0, y + 76.0, w - 40.0, 12, (&l2[0]) as u64, 37,
        style.TOK_TEXT_MUTED)
    var l3: [u8; 43] = "effect.drop_shadow_spread -- under the card"
    label(c, x + 20.0, y + 100.0, w - 40.0, 12, (&l3[0]) as u64, 43,
        style.TOK_TEXT_MUTED)
    var l4: [u8; 42] = "render.pref_of -- every basis was measured"
    label(c, x + 20.0, y + 124.0, w - 40.0, 12, (&l4[0]) as u64, 42,
        style.TOK_TEXT_MUTED)
}

// Die Phasen duerfen sich nicht ueberdecken: wer sie uebereinander
// malt, zeigt nur die letzte und behauptet, es seien sieben. Also
// wird nachgerechnet, dass zwei benachbarte Lagen mindestens eine
// Knopfbreite auseinander liegen -- im Bild und nicht auf dem Papier.
fn pruefe_phasen(xs: *mut f64, n: usize) -> bool {
    if n != PHASEN {
        return false
    }
    var i: usize = 1
    while i < n {
        if *((xs as u64 + (i * 8) as u64) as *mut f64) - *(((xs as u64) + ((i - 1) * 8) as u64) as *mut f64) < KW {
            return false
        }
        i = i + 1
    }
    return true
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        var u: [u8; 42] = "fuidemo <out.png> [light|dark] [font.ttf]\n"
        rt.write_everything(2, (&u[0]) as u64, 42)
        return 2
    }
    let path: u64 = rt.arg_ptr(start, 1)
    var dark: bool = true
    if rt.arg_count(start) >= 3 {
        if rt.ld8(rt.arg_ptr(start, 2), 0) == 108 as u8 {
            dark = false
        }
    }
    var fbuf: rt.Buf = rt.buf_new()
    var have: bool = false
    if rt.arg_count(start) >= 4 {
        have = rt.read_file(rt.arg_ptr(start, 3), &fbuf)
    }
    if !have {
        var f1: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
        have = rt.read_file((&f1[0]) as u64, &fbuf)
    }
    let fsp: *mut metrics.FontSet =
        rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    if fsp as usize == 0 {
        return 3
    }
    *fsp = metrics.fontset_new()
    var fm: u64 = 0
    if have {
        if metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
            fm = fsp as u64
        }
    }
    // OHNE SCHRIFT KEIN BELEG. Ein Bild ohne einen einzigen
    // Buchstaben sieht von weitem aus wie ein Bild, und genau so ist
    // in OrientOS eine textlose Oberflaeche durch die Abnahme
    // gekommen. Ein Beleg ohne Beschriftung belegt nichts -- also
    // Fehler auf fd 2 und ein Rueckgabewert, an dem der Lauf
    // haengenbleibt, statt ein stummes PNG zu schreiben.
    if fm == 0 {
        var ks: [u8; 59] = "fuidemo: keine Schrift gefunden -- ohne Schrift kein Beleg\n"
        rt.write_everything(2, (&ks[0]) as u64, 59)
        return 9
    }
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return 4
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, W, 300) {
        return 5
    }
    painter.painter_set_font(&z, fm)
    var m: theme.Theme = theme.theme_new(dark)
    var c: render.Ctx = render.ctx_new(&m, &z)
    let f: *mut theme.Colors = theme.theme_colors(&m)
    canvas.canvas_clear(&cv, theme.opaque((*f).base))

    titelzeile(&c, &m)

    var y: f64 = TITLE_H + 24.0
    var h1: [u8; 47] = "Tool bar -- flex.flex_layout, grow on the field"
    label(&c, PAD, y, 700.0, 12, (&h1[0]) as u64, 47,
        style.TOK_TEXT_MUTED)
    y = y + 20.0
    // DIE WERKZEUGLEISTE, BESCHRIEBEN -- und daneben die Pruefung, dass
    // die gemalte Fassung dieselben fuenf Rechtecke liefert. Stimmen sie
    // nicht, entsteht kein Bild: ein Beleg, der eine Umstellung
    // verschweigt, waere schlimmer als keiner.
    var leiste_r: [layout.Rect; 5] = [layout.rect_new(0, 0, 0, 0); 5]
    let leiste_b: f64 = (W as f64) - 2.0 * PAD
    let leiste_y: f64 = y
    y = werkzeugleiste(&c, PAD, y, leiste_b,
        (&leiste_r[0]) as *mut layout.Rect) + 28.0
    if !pruefe_leisten(&m, fm, PAD, leiste_y, leiste_b,
        (&leiste_r[0]) as *mut layout.Rect) {
        var bl: [u8; 49] = "fuidemo: beschrieben und gemalt stehen anders da\n"
        rt.write_everything(2, (&bl[0]) as u64, 49)
        return 11
    }
    // UND DERSELBE VERGLEICH BEI 280 PUNKTEN, wo die Mindestbreite des
    // Suchfeldes wirklich greift. Ohne diesen zweiten Durchgang belegte
    // die Pruefung nur den Fall, in dem geklemmt werden koennte, aber
    // nichts zu klemmen ist.
    if !pruefe_leisten_schmal(&m, fm, 280.0) {
        var bs: [u8; 52] = "fuidemo: die schmale Leiste klemmt nicht wie gemalt\n"
        rt.write_everything(2, (&bs[0]) as u64, 52)
        return 12
    }

    var h2: [u8; 47] = "Hover -- anim.Animator, 240 ms, ease-out, OKLab"
    label(&c, PAD, y, 800.0, 12, (&h2[0]) as u64, 47,
        style.TOK_TEXT_MUTED)
    y = y + 20.0
    var xs: [f64; 7] = [0.0; 7]
    let gemalt: usize = hover_band(&c, &m, PAD, y,
        (&xs[0]) as *mut f64)
    if !pruefe_phasen((&xs[0]) as *mut f64, gemalt) {
        var bad: [u8; 44] = "fuidemo: the hover phases sit on each other\n"
        rt.write_everything(2, (&bad[0]) as u64, 44)
        return 8
    }
    y = y + KH + 8.0 + 18.0 + 28.0

    let dw: f64 = 460.0
    let dh: f64 = 176.0
    dialog(&c, &m, PAD, y, dw, dh)
    quellenkarte(&c, &m, PAD + dw + 32.0, y,
        (W as f64) - 2.0 * PAD - dw - 32.0, dh)

    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if !png.write_png(&cv, &out) {
        return 6
    }
    var pf: rt.Buf = rt.buf_new()
    var k: usize = 0
    while k < rt.c_length(path) {
        rt.buf_push(&pf, rt.ld8(path, k))
        k = k + 1
    }
    rt.buf_push(&pf, 0 as u8)
    if !rt.write_file(rt.buf_ptr(&pf), mem.buf_ptr(&out) as u64,
        mem.buf_len(&out)) {
        return 7
    }
    var okm: [u8; 8] = "FUIDEMO\n"
    rt.write_everything(1, (&okm[0]) as u64, 8)
    painter.painter_free(&z)
    canvas.canvas_free(&cv)
    return 0
}
