// demos/number_check.fi -- a small console application:
// reads an integer from standard input and describes it.
import std.io
import std.rt
import std.num
import std.math

// Cut off surrounding spaces and line breaks.
fn trim(p: u64, n: usize, ap: *mut u64, an: *mut usize) {
    var a: usize = 0
    var e: usize = n
    while a < e && (rt.ld8(p, a) == 32 as u8 || rt.ld8(p, a) == 9 as u8
                    || rt.ld8(p, a) == 10 as u8 || rt.ld8(p, a) == 13 as u8) {
        a = a + 1
    }
    while e > a && (rt.ld8(p, e - 1) == 32 as u8 || rt.ld8(p, e - 1) == 9 as u8
                    || rt.ld8(p, e - 1) == 10 as u8 || rt.ld8(p, e - 1) == 13 as u8) {
        e = e - 1
    }
    *ap = p + a as u64
    *an = e - a
}

fn main() -> i32 {
    var question: [u8; 16] = "Zahl eingeben: \0"
    io.print_c((&question[0]) as u64)

    var ins: rt.Buf = rt.buf_new()
    if !io.read_stdin(&ins) {
        var f1: [u8; 15] = "Eingabe fehlt.\0"
        io.print_c((&f1[0]) as u64)
        io.print_line()
        return 1
    }

    var p: u64 = 0
    var n: usize = 0
    trim(rt.buf_ptr(&ins), rt.buf_len(&ins), &p, &n)

    var x: i64 = 0
    if n == 0 || !num.text_to_i64(p as *mut u8, n, &x) {
        var f2: [u8; 20] = "Das ist keine Zahl.\0"
        io.print_c((&f2[0]) as u64)
        io.print_line()
        return 1
    }

    // --- even / odd
    let even: bool = x % 2 == 0
    // --- sign
    let vz: i64 = math.sign(x)
    // --- magnitude, number of digits
    let abs: u64 = math.abs(x) as u64
    let digits: usize = num.digit_count(abs, 10)
    // --- square
    let square: i64 = x * x
    // --- square root (defined for x >= 0 only)
    let w: f64 = math.sqrt(x as f64)

    io.fmt_print_line(f"Zahl      : {x}")

    if even {
        var t: [u8; 20] = "Parität   : gerade\0"
        io.print_c((&t[0]) as u64)
        io.print_line()
    } else {
        var t2: [u8; 22] = "Parität   : ungerade\0"
        io.print_c((&t2[0]) as u64)
        io.print_line()
    }

    if vz > 0 {
        var t3: [u8; 20] = "Vorzeichen: positiv\0"
        io.print_c((&t3[0]) as u64)
        io.print_line()
    } else {
        if vz < 0 {
            var t4: [u8; 20] = "Vorzeichen: negativ\0"
            io.print_c((&t4[0]) as u64)
        io.print_line()
        } else {
            var t5: [u8; 17] = "Vorzeichen: null\0"
            io.print_c((&t5[0]) as u64)
        io.print_line()
        }
    }

    if x > 100 {
        var t6: [u8; 16] = "Über 100  : ja\0"
        io.print_c((&t6[0]) as u64)
        io.print_line()
    } else {
        var t7: [u8; 18] = "Über 100  : nein\0"
        io.print_c((&t7[0]) as u64)
        io.print_line()
    }

    io.fmt_print_line(f"Stellen   : {digits}")
    io.fmt_print_line(f"Quadrat   : {square}")

    // Square root as floating point text
    var wt: [u8; 13] = "Wurzel    : \0"
    io.print_c((&wt[0]) as u64)
    if x < 0 {
        var kw: [u8; 23] = "nicht reell (Zahl < 0)\0"
        io.print_c((&kw[0]) as u64)
        io.print_line()
    } else {
        var b: num.Bytes = num.Bytes{ ptr: 0 as *mut u8, len: 0, cap: 0 }
        num.write_f64(&b, w)
        io.println(b.ptr as u64, b.len)
        num.bytes_free(&b)
    }

    rt.buf_free(&ins)
    return 0
}
