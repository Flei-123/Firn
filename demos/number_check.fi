// SPDX-License-Identifier: MIT
// demos/number_check.fi -- a small console application:
// reads an integer from standard input and describes it.
//
// ROUND 70: the same program as before -- but in the notation the language
// has had since this round. `str` instead of pointer plus length,
// `io.read_line()` instead of a buffer of one's own, `text.trim()` instead of
// a hand written trim, and `f"..."` for EVERY type instead of `print_c` with
// a byte array counted by hand.
import std.io
import std.str
import std.num
import std.math

fn main() -> i32 {
    if !gc_init() {
        return 1
    }
    io.print_str("Enter a number: ")

    let text: str = io.read_line().trim()
    if text.length() == 0 {
        io.println_str("No input.")
        return 1
    }
    if text == "quit" {
        io.println_str("Goodbye.")
        return 0
    }

    var x: i64 = 0
    if !num.text_to_i64(text.p, text.n, &x) {
        io.println_str("That is not a number.")
        return 1
    }

    let even: bool = x % 2 == 0
    let sign: i64 = math.sign(x)
    let magnitude: u64 = math.abs(x) as u64
    let digits: usize = num.digit_count(magnitude, 10)
    let square: i64 = x * x

    io.fmt_print_line(f"Number    : {x}")
    io.fmt_print_line(f"Even      : {even}")
    io.fmt_print_line(f"Sign      : {sign}")
    io.fmt_print_line(f"Digits    : {digits}")
    io.fmt_print_line(f"Square    : {square}")
    io.fmt_print_line(f"Above 100 : {x > 100}")

    if x < 0 {
        io.println_str("Root      : not real (number < 0)")
    } else {
        io.fmt_print_line(f"Root      : {math.sqrt(x as f64)}")
    }
    return 0
}
