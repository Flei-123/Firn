// SPDX-License-Identifier: MPL-2.0
// demos/formant/daisy_bell.fi -- a formant synthesiser sings "Daisy Bell" (public domain, Harry Dacre, 1892).
//
//     firnc demos/formant/daisy_bell.fi -o daisy_bell
//     ./daisy_bell                         writes daisy_bell.wav (mono, S16, 44100 Hz) in the current directory
//     ./daisy_bell out.wav --rate 22050 --lines 3 --beat 700 --pulse
//     ./daisy_bell --live                  plays through the sound device (audio.sink; FIRN_AUDIO=file:x.wav also works)
//
// Options: --rate N (Hz, default 44100)  --lines N (1 .. 6, default 6)  --beat MS (quarter note, default 800)
//          --pulse (impulse train instead of sawtooth)  --shift X (formant scale: 1.17 woman, 1.3 child, default 1)
//          --live (device instead of file; the file is still written if a path is given)
// Doc: docs/AUDIO-FORMANT.md.
import std.rt
import std.io
import audio.pcm
import audio.sink
import audio.synth_osc
import audio.formant
import audio.formant_seq
import audio.formant_songs

fn cstr(p: u64) -> str {
    return str { p: rt.ptr_of(p), n: rt.c_length(p) }
}

fn starts(s: str, pre: str) -> bool {
    if pre.length() != s.length() { return false }
    return rt.mem_eq(s.p as u64, pre.p as u64, pre.length())
}

fn num(s: str) -> f64 {
    var v: f64 = 0.0
    var frac: f64 = 0.0
    var scale: f64 = 1.0
    var seen_dot: bool = false
    var q: usize = 0
    while q < s.length() {
        let c: u8 = rt.ld8(s.p as u64, q)
        if c == 46 as u8 {
            seen_dot = true
        } else if c >= 48 as u8 && c <= 57 as u8 {
            let d: f64 = (c - 48 as u8) as f64
            if seen_dot {
                scale = scale * 0.1
                frac = frac + d * scale
            } else {
                v = v * 10.0 + d
            }
        }
        q = q + 1
    }
    return v + frac
}

#[allow_escape]
fn main(start: u64) -> i32 {
    var rate: u32 = 44100 as u32
    var lines: i32 = 6
    var beat: f64 = 800.0
    var pulse: bool = false
    var live: bool = false
    var shift: f64 = 1.0
    var path: u64 = 0
    let argc: usize = rt.arg_count(start)
    var i: usize = 1
    while i < argc {
        let a: u64 = rt.arg_ptr(start, i)
        let s: str = cstr(a)
        if starts(s, "--rate") && i + 1 < argc {
            rate = num(cstr(rt.arg_ptr(start, i + 1))) as u32
            i = i + 1
        } else if starts(s, "--lines") && i + 1 < argc {
            lines = num(cstr(rt.arg_ptr(start, i + 1))) as i32
            i = i + 1
        } else if starts(s, "--beat") && i + 1 < argc {
            beat = num(cstr(rt.arg_ptr(start, i + 1)))
            i = i + 1
        } else if starts(s, "--shift") && i + 1 < argc {
            shift = num(cstr(rt.arg_ptr(start, i + 1)))
            i = i + 1
        } else if starts(s, "--pulse") {
            pulse = true
        } else if starts(s, "--live") {
            live = true
        } else {
            path = a
        }
        i = i + 1
    }
    if rate < 8000 as u32 || rate > 192000 as u32 || lines < 1 || beat < 100.0 {
        io.fmt_print(f"usage: daisy_bell [out.wav] [--rate N] [--lines 1..6] [--beat MS] [--pulse] [--shift X] [--live]\n")
        return 2
    }
    var sq: formant_seq.Seq = formant_seq.seq_new(rate)
    sq.shift = shift
    if pulse { sq.source = formant.SRC_PULSE }
    formant_songs.daisy_bell(&sq, beat, lines)
    var n: usize = 0
    let sig: u64 = formant_seq.seq_render(&sq, &n)
    var w: rt.Buf = rt.buf_new()
    let clipped: usize = formant_seq.seq_wav(sig, n, rate, &w)
    if path == 0 && !live {
        path = "daisy_bell.wav\0".p as u64
    }
    if path != 0 {
        if !rt.write_file(path, rt.buf_ptr(&w), rt.buf_len(&w)) {
            io.fmt_print(f"cannot write the file\n")
            return 1
        }
    }
    let crc: u32 = pcm.crc32(rt.buf_ptr(&w) + 44 as u64, n * 2)
    io.fmt_print(f"daisy_bell: {n as i64} samples, {rate as i64} Hz, {clipped as i64} clipped, crc32 {crc as i64}\n")
    if live {
        var sk: sink.Sink = sink.sink_open("Formant Daisy Bell", rate, 1 as u32)
        if sink.sink_is_open(&sk) {
            sink.sink_write(&sk, rt.buf_ptr(&w) + 44 as u64, n)
            sink.sink_drain(&sk)
        } else {
            io.fmt_print(f"no sound device\n")
        }
        sink.sink_close(&sk)
    }
    rt.buf_free(&w)
    synth_osc.sig_free(sig, n)
    formant_seq.seq_free(&sq)
    return 0
}
