// SPDX-License-Identifier: MPL-2.0
// demos/x11demo/main.fi -- THE DESCRIBED PAGE IN A REAL WINDOW.
//
// ===================================================== WHY IT EXISTS
//
// demos/fuidemo paints a surface into a PNG; tools/fui/gallery9_main.fi
// describes a whole page (toolbar, pane box with 28
// rows, cards with switches) and proves it with a picture. Both are
// a PICTURE. This demo is the same page as a PROGRAM: a window on
// an X server, operable with mouse and keyboard, resizable,
// closable cleanly -- and at scale 2 calculated twice as large,
// not stretched.
//
// THE PAGE IS NOT REBUILT. `gallery9_main.fi` next to this file
// is a link to tools/fui/gallery9_main.fi; style sheet
// (`baue_blatt`), tree (`baue_baum`) and texts come from there, call
// for call the same. What is added here is only what a window
// needs: the size from the window instead of from a constant, the
// content height of the list MEASURED instead of written down (it depends on the
// scale), and an action for the button "Starten": the
// progress bar runs up in 1.2 s. That is the one animation with which
// you see that the loop makes pictures only as long as something
// is running -- before and after it stands in `poll`.
//
// ======================================================== HOW IT BUILDS
//
// `import window.window` fetches lib/window/window.fi, and that fetches
// `window.backend` NEXT TO THE ROOT FILE: demos/x11demo/window/backend.fi
// is a link to lib/window/x11.fi. Whoever builds the same demo for Windows
// puts the link to lib/window/win32.fi -- nothing changes
// in this file.
//
//     firnc -o x11demo demos/x11demo/main.fi
//     x11demo [--protokoll] [--dpi=N] [--hell] [--anzeige=N] [--gpu=0]
//
// --protokoll: one line per event, per picture and per state on fd 1
// (for tools/fui/x11live.sh). --dpi=N: the density by hand (otherwise
// Xft.dpi or the millimetres of the screen). Escape or the
// close button of the window manager ends it.
import std.rt
import paint.canvas
import font.metrics
import fui.theme
import fui.style
import fui.widget
import fui.painter
import fui.render
import fui.scene
import fui.sheet
import fui.viewport
import fui.anim
import window.window
import plat.fuiwirt
import plat.fuiwin
import plat.sysfont
import gallery9_main

const FONTSET_BYTES: usize = 4096
const PROGRESS_MS: i64 = 1200

// Everything the page needs, in ONE place -- context and host
// point into it, so it stays where it was created.
struct App {
    sc: scene.Scene,
    v: viewport.Viewport,
    sh: sheet.Sheet,
    m: theme.Theme,
    c: render.Ctx,
    w: fuiwirt.Host,
    g: anim.Animator,
    frame_box: usize,
    launch: usize,
    progress: usize,
    flag: usize,
    kaestchen: usize,
    texts: u64,
    field: u64,
    k_bar: u32,
    k_titel: u32,
    k_karte: u32,
    k_over: u32,
    k_notiz: u32,
    k_list: u32,
    k_line: u32,
    k_even: u32,
    k_accent: u32,
    log: bool,
    // At which scale the tree was built. If the window moves
    // to a screen of different density, it is rebuilt: the width
    // of the pane box is a length of the caller.
    skala: usize,
    // For which window size the nodes were last reported.
    reported_w: usize,
    reported_h: usize,
}

fn px(m: *mut theme.Theme, n: f64) -> f64 {
    return theme.theme_px(m, (n + 0.5) as usize) as f64
}

// The tree from gallery9, with a pane box whose dimensions go through
// the theme (width, bar, padding -- design points).
fn build(app: *mut App) {
    let m: *mut theme.Theme = &(*app).m
    let oy: f64 = viewport.viewport_off_y(&(*app).v)
    (*app).v = viewport.viewport_new(0.0, 0.0, px(m, gallery9_main.LIST_W),
        px(m, 400.0), px(m, gallery9_main.CONTENT_W),
        px(m, gallery9_main.CONTENT_H))
    viewport.viewport_set_bar(&(*app).v, theme.theme_px(m,
            gallery9_main.BAR))
    viewport.viewport_set_inset(&(*app).v, px(m, gallery9_main.PADDING))
    (*app).sh = sheet.sheet_new()
    let spurfarbe: u32 = theme.color_from_token(m, style.TOK_SURFACE)
    let basic_list: u32 = theme.mix(spurfarbe,
        theme.color_from_token(m, style.TOK_TEXT), 500)
    gallery9_main.build_leaf(&(*app).sh, (*app).k_bar, (*app).k_titel,
        (*app).k_karte, (*app).k_over, (*app).k_notiz, (*app).k_list,
        (*app).k_line, (*app).k_even, (*app).k_accent,
        style.color_literal(basic_list))
    (*app).sc = scene.scene_new()
    (*app).frame_box = gallery9_main.build_tree(&(*app).sc, &(*app).v,
        (*app).field, (*app).k_bar, (*app).k_titel, (*app).k_karte,
        (*app).k_over, (*app).k_notiz, (*app).k_list, (*app).k_line,
        (*app).k_even, (*app).k_accent, (*app).texts)
    let sc: *mut scene.Scene = &(*app).sc
    let root: usize = scene.scene_root(sc)
    let bar: usize = scene.scene_child_at(sc, root, 1)
    let body: usize = scene.scene_child_at(sc, root, 2)
    let right: usize = scene.scene_child_at(sc, body, 1)
    let karte2: usize = scene.scene_child_at(sc, right, 1)
    (*app).launch = scene.scene_child_at(sc, bar, 4)
    (*app).kaestchen = scene.scene_child_at(sc, karte2, 1)
    (*app).flag = scene.scene_child_at(sc, karte2, 2)
    (*app).progress = scene.scene_child_at(sc, karte2, 5)
    (*app).skala = theme.theme_scale(m)
    fuiwirt.host_bind(&(*app).w)
}

// Arrange into the window size, the height of the list MEASURED (last
// row bottom minus first top plus twice inner margin), and if it
// has changed, arrange once more -- afterwards the
// scrollbar fits the scale.
fn ordne(app: *mut App, bw: usize, bh: usize) {
    let sc: *mut scene.Scene = &(*app).sc
    scene.scene_style(sc, &(*app).sh)
    scene.scene_measure(sc, &(*app).c)
    scene.scene_layout(sc, &(*app).c, 0.0, 0.0, bw as f64, bh as f64)
    let k: usize = (*app).frame_box
    let n: usize = scene.scene_child_count(sc, k)
    let first: usize = scene.scene_child_at(sc, k, 0)
    let last: usize = scene.scene_child_at(sc, k, n - 1)
    let pad: f64 = theme.theme_px(&(*app).m, 8) as f64
    let h: f64 = scene.node_y(sc, last) + scene.node_h(sc, last)
    -scene.node_y(sc, first) + 2.0 * pad
    if h != viewport.viewport_content_h(&(*app).v) {
        viewport.viewport_set_content(&(*app).v,
            px(&(*app).m, gallery9_main.CONTENT_W), h)
        scene.scene_layout(sc, &(*app).c, 0.0, 0.0, bw as f64, bh as f64)
    }
}

// One line of state for the acceptance run: picture, scroll position, switch,
// tick box, progress, focus, scale.
fn state(app: *mut App, fx: *mut fuiwin.Window) {
    if !(*app).log {
        return
    }
    let sc: *mut scene.Scene = &(*app).sc
    var t: rt.Buf = rt.buf_new()
    var z: [u8; 8] = "zustand "
    rt.buf_push_bytes(&t, (&z[0]) as u64, 8)
    rt.buf_push_dec_i64(&t, (fuiwin.window_images(fx) + 1) as i64)
    rt.buf_push(&t, 32 as u8)
    rt.buf_push_dec_i64(&t, viewport.viewport_off_y(&(*app).v) as i64)
    rt.buf_push(&t, 32 as u8)
    rt.buf_push_dec_i64(&t, widget.w_value(scene.node_widget(sc,
                (*app).flag)))
    rt.buf_push(&t, 32 as u8)
    rt.buf_push_dec_i64(&t, widget.w_value(scene.node_widget(sc,
                (*app).kaestchen)))
    rt.buf_push(&t, 32 as u8)
    rt.buf_push_dec_i64(&t, widget.w_value(scene.node_widget(sc,
                (*app).progress)))
    rt.buf_push(&t, 32 as u8)
    let fk: usize = fuiwirt.host_focus(&(*app).w)
    if fk == fuiwirt.KEINER {
        rt.buf_push_dec_i64(&t, -1)
    } else {
        rt.buf_push_dec_i64(&t, fk as i64)
    }
    rt.buf_push(&t, 32 as u8)
    rt.buf_push_dec_i64(&t, theme.theme_scale(&(*app).m) as i64)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn node_line(app: *mut App, name: u64, nn: usize, i: usize) {
    let sc: *mut scene.Scene = &(*app).sc
    var t: rt.Buf = rt.buf_new()
    var z: [u8; 7] = "knoten "
    rt.buf_push_bytes(&t, (&z[0]) as u64, 7)
    rt.buf_push_bytes(&t, name, nn)
    rt.buf_push(&t, 32 as u8)
    rt.buf_push_dec_i64(&t, scene.node_x(sc, i) as i64)
    rt.buf_push(&t, 32 as u8)
    rt.buf_push_dec_i64(&t, scene.node_y(sc, i) as i64)
    rt.buf_push(&t, 32 as u8)
    rt.buf_push_dec_i64(&t, scene.node_w(sc, i) as i64)
    rt.buf_push(&t, 32 as u8)
    rt.buf_push_dec_i64(&t, scene.node_h(sc, i) as i64)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// Where the controls stand -- once per window size, so that the
// acceptance run (tools/fui/x11live.py) clicks exactly there with xdotool,
// instead of guessing coordinates.
fn node_report(app: *mut App, bw: usize, bh: usize) {
    if !(*app).log || (bw == (*app).reported_w && bh == (*app).reported_h) {
        return
    }
    (*app).reported_w = bw
    (*app).reported_h = bh
    var n1: [u8; 8] = "schalter"
    var n2: [u8; 9] = "kaestchen"
    var n3: [u8; 7] = "starten"
    var n4: [u8; 5] = "liste"
    var n5: [u8; 11] = "fortschritt"
    node_line(app, (&n1[0]) as u64, 8, (*app).flag)
    node_line(app, (&n2[0]) as u64, 9, (*app).kaestchen)
    node_line(app, (&n3[0]) as u64, 7, (*app).launch)
    node_line(app, (&n4[0]) as u64, 5, (*app).frame_box)
    node_line(app, (&n5[0]) as u64, 11, (*app).progress)
}

fn times(ud: u64, fx: *mut fuiwin.Window) {
    let app: *mut App = ud as *mut App
    if theme.theme_scale(&(*app).m) != (*app).skala {
        build(app)
    }
    let cv: *mut canvas.Canvas = fuiwin.window_canvas(fx)
    // The progress stands in the tween as long as there is one.
    if anim.animator_count(&(*app).g) > 0 {
        let a: *mut anim.Animation = anim.animator_at(&(*app).g, 0)
        let value: f64 = anim.anim_value(a, fuiwin.now_ms())
        widget.w_set_value(scene.node_widget(&(*app).sc, (*app).progress),
            value as i64)
    }
    let f: *mut theme.Colors = theme.theme_colors(&(*app).m)
    // painter_clear and not canvas_clear: on a phone the canvas lives on
    // the GPU (lib/plat/fuiwin.fi, fUi tempo stage 2b)
    painter.painter_clear(fuiwin.window_painter(fx), theme.opaque((*f).base))
    ordne(app, fuiwin.window_w(fx), fuiwin.window_h(fx))
    scene.scene_draw(&(*app).sc, &(*app).c)
    node_report(app, fuiwin.window_w(fx), fuiwin.window_h(fx))
    state(app, fx)
}

fn aktion(ud: u64, fx: *mut fuiwin.Window, node: usize) {
    let app: *mut App = ud as *mut App
    if node == (*app).launch {
        anim.animator_clear(&(*app).g)
        let i: usize = anim.animator_add(&(*app).g, anim.anim_new(
                fuiwin.now_ms(), PROGRESS_MS, 0.0, 1000.0,
                anim.easing_named(anim.EASE_OUT)))
        fuiwirt.host_touch(&(*app).w)
    }
}

fn number_after(p: u64, ab: usize) -> usize {
    var v: usize = 0
    var i: usize = ab
    while rt.ld8(p, i) >= 48 as u8 && rt.ld8(p, i) <= 57 as u8 {
        v = v * 10 + (rt.ld8(p, i) - 48 as u8) as usize
        i = i + 1
    }
    return v
}

fn starts(p: u64, lit: u64, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        if rt.ld8(p, i) != rt.ld8(lit, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn main(start: u64) -> i32 {
    var log: bool = false
    var dpi: usize = 0
    var hell: bool = false
    var disp: usize = 0
    var o_log: [u8; 11] = "--protokoll"
    var o_dpi: [u8; 6] = "--dpi="
    var o_hell: [u8; 6] = "--hell"
    var o_anz: [u8; 10] = "--anzeige="
    // --gpu=0: in memory even where the window offers a GPU (to compare)
    var o_gpu: [u8; 7] = "--gpu=0"
    var gpu_aus: bool = false
    var i: usize = 1
    while i < rt.arg_count(start) {
        let a: u64 = rt.arg_ptr(start, i)
        if starts(a, (&o_log[0]) as u64, 11) {
            log = true
        } else if starts(a, (&o_dpi[0]) as u64, 6) {
            dpi = number_after(a, 6)
        } else if starts(a, (&o_hell[0]) as u64, 6) {
            hell = true
        } else if starts(a, (&o_anz[0]) as u64, 10) {
            disp = number_after(a, 10)
        } else if starts(a, (&o_gpu[0]) as u64, 7) {
            gpu_aus = true
        }
        i = i + 1
    }

    // The font: DejaVu as in the gallery, on Android that of the system
    // (lib/plat/sysfont.fi). Without a font no page.
    let fsp: *mut metrics.FontSet =
    rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fsp) {
        var ks: [u8; 32] = "x11demo: keine Schrift (DejaVu)\n"
        rt.write_everything(2, (&ks[0]) as u64, 32)
        return 9
    }

    var fx: fuiwin.Window = fuiwin.window_new()
    fuiwin.window_set_font(&fx, fsp as u64)
    fuiwin.window_log(&fx, log)
    if gpu_aus {
        fuiwin.window_set_gpu(&fx, false)
    }
    if dpi > 0 {
        window.set_dpi(fuiwin.window_window(&fx), dpi)
    }
    // The app lies in THIS frame and no longer moves: context
    // and host point into it. That is why both are set only when it
    // stands in its place.
    var app: App = App { sc: scene.scene_new(),
        v: viewport.viewport_new(0.0, 0.0, 1.0, 1.0, 1.0, 1.0),
        sh: sheet.sheet_new(), m: theme.theme_new(!hell),
        c: render.ctx_new((0 as u64) as *mut theme.Theme,
            (0 as u64) as *mut painter.Painter),
        w: fuiwirt.host_new((0 as u64) as *mut scene.Scene,
            (0 as u64) as *mut render.Ctx),
        g: anim.animator_new(), frame_box: 0, launch: 0, progress: 0,
        flag: 0, kaestchen: 0, texts: rt.heap_alloc(640),
        field: rt.heap_alloc(gallery9_main.LINES * gallery9_main.STEP),
        k_bar: 0, k_titel: 0, k_karte: 0, k_over: 0, k_notiz: 0,
        k_list: 0, k_line: 0, k_even: 0, k_accent: 0, log: log,
        skala: 0, reported_w: 0, reported_h: 0 }
    app.c = render.ctx_new(&app.m, fuiwin.window_painter(&fx))
    app.w = fuiwirt.host_new(&app.sc, &app.c)
    var nleiste: [u8; 6] = "leiste"
    var ntitel: [u8; 5] = "titel"
    var nkarte: [u8; 5] = "karte"
    var nueber: [u8; 5] = "ueber"
    var nnotiz: [u8; 5] = "notiz"
    var nliste: [u8; 5] = "liste"
    var nzeile: [u8; 5] = "zeile"
    var ngerade: [u8; 6] = "gerade"
    var nakzent: [u8; 6] = "akzent"
    app.k_bar = sheet.sheet_name((&nleiste[0]) as u64, 6)
    app.k_titel = sheet.sheet_name((&ntitel[0]) as u64, 5)
    app.k_karte = sheet.sheet_name((&nkarte[0]) as u64, 5)
    app.k_over = sheet.sheet_name((&nueber[0]) as u64, 5)
    app.k_notiz = sheet.sheet_name((&nnotiz[0]) as u64, 5)
    app.k_list = sheet.sheet_name((&nliste[0]) as u64, 5)
    app.k_line = sheet.sheet_name((&nzeile[0]) as u64, 5)
    app.k_even = sheet.sheet_name((&ngerade[0]) as u64, 6)
    app.k_accent = sheet.sheet_name((&nakzent[0]) as u64, 6)
    gallery9_main.write_texts(app.texts)
    gallery9_main.write_lines(app.field)

    // First the window: afterwards the scale of the screen is in the theme, and
    // only then do the dimensions of the pane box have their pixels.
    var titel: [u8; 30] = "fUi -- beschriebene Seite, X11"
    if !fuiwin.window_open(&fx, &app.w, &app.m, disp,
        gallery9_main.W_STD, gallery9_main.H, (&titel[0]) as u64, 30) {
        var ko: [u8; 45] = "x11demo: kein X-Server erreichbar ($DISPLAY)\n"
        rt.write_everything(2, (&ko[0]) as u64, 45)
        return 1
    }
    build(&app)
    fuiwirt.host_set_animator(&app.w, &app.g)
    fuiwin.window_run(&fx, &app.w, &app.m, times, aktion, (&app) as u64)
    fuiwin.window_close(&fx)
    if log {
        var zu: [u8; 12] = "geschlossen\n"
        rt.write_everything(1, (&zu[0]) as u64, 12)
    }
    return 0
}
