// expect_out: {"a": 1, "b": [true, 2.5e-05], "c": {"x": "\u00e4", "y": null}}
// json.dumps(sort_keys=True) in Firn: parse a document and write it back with its keys
// in order -- the canonical form a check script compares or stores.
//
//   print(json.dumps(json.loads(text), sort_keys=True))
//
// `indent=2`, `ensure_ascii=False` or `separators=(",", ":")` are fields of the same options
// value (json_opts_indent(2), flags without JSON_ASCII, json_opts_compact()).
import std.rt
import std.str
import std.json
import std.io

fn main() -> i32 {
    let text: str = "{\"c\": {\"y\": null, \"x\": \"\\u00e4\"}, \"b\": [true, 0.000025], \"a\": 1}"
    var d: json.Json = json.json_new()
    defer json.json_free(&d)
    let ok: bool = json.json_parse(&d, text.p as u64, text.length()) catch false
    if !ok {
        return 1
    }
    var o: json.JsonOpts = json.json_opts_new()
    o.flags = json.JSON_ASCII | json.JSON_SORT_KEYS
    var out: rt.Buf = rt.buf_new()
    defer rt.buf_free(&out)
    if !json.json_write_opts(&d, json.json_root(&d), &out, &o) {
        return 2
    }
    io.print_bytes(rt.buf_ptr(&out), rt.buf_len(&out))
    io.print_line("")
    return 0
}
