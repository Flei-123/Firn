// expect_out: Hallo Welt aus Firn!
// Output without libc: write(1, buf, n) directly as a Linux syscall.
// Firn stage 0 has no strings -- text is a byte array.

fn main() -> i32 {
    var buf: [u8; 22] = [
        72, 97, 108, 108, 111, 32, // "Hallo "
        87, 101, 108, 116, 32, // "Welt "
        97, 117, 115, 32, // "aus "
        70, 105, 114, 110, 33, 10, 0 // "Firn!\n"
    ]
    syscall(1, 1, &buf[0], 21)
    return 0
}
