// expect_exit: 0
// examples/testkit_script.fi -- std.testkit in script style: a program that
// checks a few things, prints `  ok    ...` / `  FAIL  ...` per check and ends
// with the sum and an exit code (0 = all ok). The same file also holds a
// `#[test]` function: `firnc --test examples/testkit_script.fi` is refused
// because of `main`, so the tests of a library live in a file of their own
// (see tools/testkit/cases/suite.fi); here only the script style is shown.
//
//     firnc -o /tmp/demo examples/testkit_script.fi && /tmp/demo
import std.testkit
import std.str

fn triangle(n: i64) -> i64 {
    var s: i64 = 0
    var i: i64 = 1
    while i <= n {
        s = s + i
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    testkit.check(triangle(10) == 55, "the tenth triangle number is 55")
    testkit.check(triangle(0) == 0, "the empty sum is 0")
    testkit.check_detail("a,b".length() == 3, "a text of three octets", "length was wrong")
    testkit.check(0.1 + 0.2 != 0.3, "floating point is not exact")
    // assertions stop the program at the first failure; checks go on
    testkit.assert_near(0.1 + 0.2, 0.3, 1.0e-12)
    testkit.assert_eq_str("firn", "fi" + "rn")
    return testkit.finish()
}
