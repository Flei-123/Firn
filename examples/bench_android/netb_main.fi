// examples/bench_android/netb_main.fi -- host test of netb.fi: NETB_BASE=https://host/dir/ ./netb_main
import std.rt
import std.env
import async.loop
import async.ahttp
import netb

static mut G_LOOP: u64 = 0

fn tick(l: *mut loop.Loop, ud: u64) {
    if !netb.running() { loop.stop(l) }
}

#[allow_escape]
fn main(start: u64) -> i32 {
    var l: loop.Loop = loop.loop_new()
    if !loop.loop_init(&l) { return 2 }
    var ah: ahttp.AClient = ahttp.aclient_new()
    if !ahttp.aclient_init(&ah, &l) { return 3 }
    netb.start((&ah) as u64, env.get("NETB_BASE"))
    let t: u64 = loop.timer_every(&l, 50, tick, 0)
    loop.run(&l)
    return 0
}
