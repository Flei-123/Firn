import fui.sheet
import fui.style
import fui.theme
import fui.lucide
import fui.icons
import fui.render
import fui.widget
import fui.painter
import plat.blog
import plat.intentx
import window.window
import bcpu

const N_ITEMS: usize = 1000
const MAX_ITEMS: usize = 4096
const ROW_PT: usize = 80

// style classes
