const K_OUTLINE: u32 = 2
const K_BAR: u32 = 3
const K_BODY: u32 = 4
const K_BOX: u32 = 5
const K_SPIN: u32 = 6
const K_ENTRY: u32 = 7
const K_NAV: u32 = 8
const K_DIM: u32 = 9
const K_TITLE: u32 = 10
const K_ROOT: u32 = 11
const K_BIG: u32 = 12

const TAB_LIST: usize = 0
const TAB_LAB: usize = 1
const TAB_SET: usize = 2
const S_ANIM: usize = 0
const S_TEXT: usize = 1
const S_NET: usize = 2
const S_CPU: usize = 3

static mut G_A: u64 = 0
static mut G_LOOP: u64 = 0
static mut G_WIN: u64 = 0
static mut G_ITEMS: [i64; 4096] = [0; 4096]
static mut G_NI: usize = 0
static mut G_VIEW: [u32; 4096] = [0 as u32; 4096]
static mut G_NV: usize = 0
static mut G_QUERY: [u8; 64] = [0; 64]
static mut G_QN: usize = 0
static mut G_TAB: usize = 0
static mut G_SECT: usize = 0
static mut G_MODE: usize = 0 // 0 system, 1 light, 2 dark
static mut G_DARK: bool = true
static mut G_P: [usize; 3] = [0; 3]
static mut G_S: [usize; 4] = [0; 4]
static mut G_NAV: [usize; 3] = [0; 3]
static mut G_LIST: usize = 0
static mut G_TEXTLIST: usize = 0
static mut G_FILTER: usize = 0
static mut G_TOGGLE: usize = 0
static mut G_SEG: usize = 0
static mut G_RADIO: [usize; 3] = [0; 3]
static mut G_SPIN_RULE: usize = 0
static mut G_SPIN_NODE: usize = 0
static mut G_FPS: usize = 0
static mut G_FRAMEL: usize = 0
static mut G_NET: [usize; 4] = [0; 4]
static mut G_NET_BTN: usize = 0
static mut G_CPU: [usize; 3] = [0; 3]
static mut G_CPU_BTN: usize = 0
static mut G_T16: u64 = 0
static mut G_TREADY: u64 = 0
static mut G_AUTOSCROLL: bool = false
static mut G_AS_T0: i64 = 0
static mut G_AS_DIR: i64 = 1
static mut G_AS_POS: f64 = 0.0
static mut G_AS_LAST: i64 = 0
static mut G_FPS_T0: i64 = 0
static mut G_FPS_N0: i64 = 0
static mut G_WIN_T0: i64 = 0
static mut G_AHP: u64 = 0
static mut G_NET_RUN: bool = false
static mut G_NET_STEP: usize = 0
static mut G_CPU_LOGGED: i64 = 0
