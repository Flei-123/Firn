// examples/bench_android/cpu_main.fi -- host test of bcpu.fi: runs the nine kernels on the worker thread and prints the checksums.
import std.rt
import std.io
import std.time
import bcpu

fn __thread_work(kind: u64, arg: u64) -> u64 { return bcpu.work(kind, arg) }

fn dec(v: i64) -> str {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&b, v)
    let s: str = __str_copy(str { p: b.ptr as *mut u8, n: b.len })
    rt.buf_free(&b)
    return s
}

fn main(start: u64) -> i32 {
    bcpu.cpu_start()
    var polls: i64 = 0
    while bcpu.cpu_running() {
        polls = polls + 1
        thread_sleep(2 as u64)
    }
    var i: usize = 0
    while i < bcpu.cpu_count() {
        io.println_str(bcpu.cpu_name(i) + "=" + dec(bcpu.cpu_sum(i)))
        i = i + 1
    }
    io.println_str("# wall ms " + bcpu.cpu_log_line(0, 9) + " polls " + dec(polls))
    bcpu.cpu_shutdown()
    return 0
}
