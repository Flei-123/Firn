// examples/bench_android/cpu_main.fi -- host test of bcpu.fi: runs the three tasks in slices and prints the checksums.
import std.rt
import std.io
import bcpu

fn dec(v: i64) -> str {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&b, v)
    let s: str = __str_copy(str { p: b.ptr as *mut u8, n: b.len })
    rt.buf_free(&b)
    return s
}

fn main(start: u64) -> i32 {
    bcpu.cpu_start()
    var slices: i64 = 0
    while bcpu.cpu_step(8000000 as u64) { slices = slices + 1 }
    io.println_str("primes=" + dec(bcpu.cpu_sum(0)))
    io.println_str("sort=" + dec(bcpu.cpu_sum(1)))
    io.println_str("mandel=" + dec(bcpu.cpu_sum(2)))
    io.println_str("# wall ms " + dec(bcpu.cpu_wall_ms(0)) + " " + dec(bcpu.cpu_wall_ms(1)) + " " + dec(bcpu.cpu_wall_ms(2)) + " pure " + dec(bcpu.cpu_pure_ms(0)) + " " + dec(bcpu.cpu_pure_ms(1)) + " " + dec(bcpu.cpu_pure_ms(2)) + " slices " + dec(slices))
    return 0
}
