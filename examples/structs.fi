// expect_exit: 42
// Structs mit verschachtelten Feldern, Array von Structs, Zeiger auf Struct.

struct Point {
    x: i32,
    y: i32,
}

struct Rect {
    lo: Point,
    hi: Point,
}

fn area(r: *Rect) -> i32 {
    let w: i32 = (*r).hi.x - (*r).lo.x
    let h: i32 = (*r).hi.y - (*r).lo.y
    return w * h
}

fn main() -> i32 {
    var r: Rect = Rect { lo: Point { x: 1, y: 2, }, hi: Point { x: 7, y: 8, }, }
    let a: i32 = area(&r) // 6 * 6 = 36

    var ps: [Point; 3] = [
        Point { x: 1, y: 1, },
        Point { x: 2, y: 2, },
        Point { x: 3, y: 3, },
    ]
    var i: usize = 0
    var s: i32 = 0
    while i < 3 {
        s = s + ps[i].x * ps[i].y
        i = i + 1
    } // 1 + 4 + 9 = 14

    // verschachtelter Schreibzugriff ueber Zeiger
    var p: *mut Rect = &r
    (*p).lo.x = 0
    let b: i32 = area(&r) // 7 * 6 = 42

    if a == 36 && s == 14 {
        return b
    }
    return 0
}
