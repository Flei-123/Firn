// expect_out: n=8 mean=4.5 median=3.5 p90=8.6 stdev=3.07 bins=2,4,1,1
// std.stats in a check script: what Python's `statistics.median`,
// `statistics.stdev`, `numpy.percentile` and `numpy.histogram` do in
// OpenPlan's webcheck.py. Python equivalent:
//
//   data = [1, 2, 3, 3, 4, 5, 8, 10]
//   statistics.mean(data), statistics.median(data), numpy.percentile(data, 90),
//   statistics.stdev(data), numpy.histogram(data, bins=4, range=(0, 12))[0]
import std.io
import std.vec
import std.stats
import std.math

// one number as text (whole numbers without a fraction part: 4.5 stays 4.5, 3.0 prints 3)
fn show(x: f64) {
    var f: io.Fmt = io.fmt_new()
    f = io.fmt_f64(f, x)
    io.fmt_print(f)
}

fn main() -> i32 {
    var data: Vec[f64] = vec_new[f64]()
    defer vec_free[f64](&data)
    vec_push[f64](&data, 1.0)
    vec_push[f64](&data, 2.0)
    vec_push[f64](&data, 3.0)
    vec_push[f64](&data, 3.0)
    vec_push[f64](&data, 4.0)
    vec_push[f64](&data, 5.0)
    vec_push[f64](&data, 8.0)
    vec_push[f64](&data, 10.0)
    var counts: Vec[u64] = vec_new[u64]()
    defer vec_free[u64](&counts)
    var i: usize = 0
    while i < 4 {
        vec_push[u64](&counts, 0)
        i = i + 1
    }
    stats.histogram_vec(&data, 4, 0.0, 12.0, vec_elem_ptr[u64](&counts, 0))
    let mean: f64 = stats.mean_vec(&data)
    let median: f64 = stats.median_vec(&data)
    let p90: f64 = stats.percentile_vec(&data, 90.0)
    let sd: f64 = stats.stdev_vec(&data)
    // two decimals for the standard deviation (3.3806...)
    let sd2: f64 = math.round(sd * 100.0) / 100.0
    io.print("n=")
    show(vec_len[f64](&data) as f64)
    io.print(" mean=")
    show(mean)
    io.print(" median=")
    show(median)
    io.print(" p90=")
    show(p90)
    io.print(" stdev=")
    show(sd2)
    io.print(" bins=")
    var k: usize = 0
    while k < 4 {
        if k > 0 {
            io.print(",")
        }
        show(vec_at[u64](&counts, k) as f64)
        k = k + 1
    }
    io.print_line("")
    return 0
}
