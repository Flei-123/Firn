// SPDX-License-Identifier: MPL-2.0
// examples/window -- a window, a colour, a line of text; Esc or the close
// button ends it. X11 on Linux, Win32 on Windows: the backend is chosen at
// build time (lib/window/backend.fi, backend.windows.fi).
//   firnc -o /tmp/win examples/window/main.fi && /tmp/win
//   firnc --target=x86_64-windows --win-subsystem=windows -o win.exe examples/window/main.fi
import window.window

fn paint(f: *mut window.Window) {
    window.fill(f, 0x202833, 0, 0, window.width(f), window.height(f))
    let s: str = "Hello from Firn -- Esc closes"
    window.text(f, 0xffffff, 0x202833, 24, 40, s.p as u64, s.n)
    window.present(f)
}

fn main() -> i32 {
    var f: window.Window = window.window_new()
    if !window.open_window(&f, 0) || !window.make(&f, 480, 200) { return 1 }
    let s: str = "Firn"
    window.title(&f, s.p as u64, s.n)
    window.show_window(&f)
    paint(&f)
    var open: bool = true
    while open {
        window.wait_event(&f, -1)
        var k: u32 = window.next_event(&f)
        while k != window.EV_NONE {
            if k == window.EV_CLOSED { open = false }
            if k == window.EV_KEY && window.ev_a(&f) == window.K_ESCAPE { open = false }
            if k == window.EV_EXPOSE || k == window.EV_CONFIGURE { paint(&f) }
            k = window.next_event(&f)
        }
    }
    window.close_window(&f)
    return 0
}
