// SPDX-License-Identifier: MPL-2.0
// examples/fui/lowlevel/hello_lowlevel.fi -- the tkinter "Test Window"
// (a label in Arial 16, a Close button) written against the fUi API as it
// stood on 29.09.2026, BEFORE lib/fui/app.fi existed. It is kept as the
// honest baseline for docs/fui-quickstart.md: this is what the same window
// costs without the high-level layer. It also needs the symlink
// window/backend.fi -> lib/window/x11.fi next to it.
//
//     firnc -o /tmp/hello_lowlevel examples/fui/lowlevel/hello_lowlevel.fi
import std.rt
import font.metrics
import fui.theme
import fui.style
import fui.painter
import fui.render
import fui.scene
import fui.sheet
import fui.flex
import fui.widget
import window.window
import plat.fuiwirt
import plat.fuiwin
import plat.sysfont

struct App {
    sc: scene.Scene,
    sh: sheet.Sheet,
    m: theme.Theme,
    c: render.Ctx,
    w: fuiwirt.Host,
    close: usize,
    quit: bool,
}

fn paint(ud: u64, fx: *mut fuiwin.Window) {
    let a: *mut App = ud as *mut App
    let f: *mut theme.Colors = theme.theme_colors(&(*a).m)
    painter.painter_clear(fuiwin.window_painter(fx), theme.opaque((*f).base))
    scene.scene_run(&(*a).sc, &(*a).c, &(*a).sh, 0.0, 0.0,
        fuiwin.window_w(fx) as f64, fuiwin.window_h(fx) as f64)
}

fn act(ud: u64, fx: *mut fuiwin.Window, node: usize) {
    let a: *mut App = ud as *mut App
    if node == (*a).close {
        (*a).quit = true
    }
}

fn main() -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        return 9
    }
    var fx: fuiwin.Window = fuiwin.window_new()
    fuiwin.window_set_font(&fx, fs as u64)
    var a: App = App { sc: scene.scene_new(), sh: sheet.sheet_new(),
        m: theme.theme_new(false),
        c: render.ctx_new(0 as u64 as *mut theme.Theme,
            0 as u64 as *mut painter.Painter),
        w: fuiwirt.host_new(0 as u64 as *mut scene.Scene,
            0 as u64 as *mut render.Ctx),
        close: 0, quit: false }
    a.c = render.ctx_new(&a.m, fuiwin.window_painter(&fx))
    a.w = fuiwirt.host_new(&a.sc, &a.c)
    let root: usize = scene.scene_box(&a.sc, scene.SCENE_NONE, 0 as u32,
        flex.FLEX_COLUMN, flex.JUSTIFY_CENTER, flex.AL_CENTER)
    scene.node_set_gap(&a.sc, root, 20, 0)
    let label: usize = scene.scene_add(&a.sc, root, scene.N_TEXT)
    let msg: str = "Hello, this is a test window!"
    scene.node_set_text(&a.sc, label, msg.p as u64, msg.n)
    scene.node_set_id(&a.sc, label, 1 as u32)
    let r: usize = sheet.sheet_rule(&a.sh, sheet.sel_id(1 as u32),
        style.style_set_font(style.style_new(), 0, 16))
    let cl: str = "Close"
    a.close = scene.scene_widget(&a.sc, root, widget.KIND_BUTTON, cl.p as u64,
        cl.n)
    fuiwirt.host_bind(&a.w)
    let t: str = "Test Window"
    if !fuiwin.window_open(&fx, &a.w, &a.m, 0, 400, 250, t.p as u64, t.n) {
        return 1
    }
    while !a.quit {
        let ms: i64 = fuiwirt.host_wait_ms(&a.w)
        if ms != 0 {
            let e: bool = window.wait_event(fuiwin.window_window(&fx), ms)
        }
        if !fuiwin.window_step(&fx, &a.w, &a.m, paint, act, (&a) as u64) {
            a.quit = true
        }
    }
    fuiwin.window_close(&fx)
    return 0
}
