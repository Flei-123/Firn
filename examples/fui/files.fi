// examples/fui/files.fi -- a list of rows with symbols: a file list.
//     firnc -o /tmp/files examples/fui/files.fi
//     firnc --target=wasm32-browser -o files.wasm examples/fui/files.fi
//
// Every row has a symbol, a text, and on the right a detail and a badge. A
// click chooses a row (one at a time) and its handler runs; the row under the
// mouse is highlighted.
import fui.app

static mut LIST: usize = 0
static mut INFO: usize = 0

fn docs(a: *mut app.App) {
    app.set_text(a, INFO, "Documents: 12 items")
}

fn notes(a: *mut app.App) {
    app.set_text(a, INFO, "notes.txt: 2 KB")
}

fn photo(a: *mut app.App) {
    app.set_text(a, INFO, "photo.png: 1.4 MB")
}

fn trash(a: *mut app.App) {
    app.set_text(a, INFO, "Trash: nothing in it")
}

fn main() -> i32 {
    let a: *mut app.App = app.window("Files", 380, 300)
    app.label(a, "Files", 14)
    LIST = app.list(a)
    app.list_item(a, "folder", "Documents", "12 items", "3", docs)
    app.list_item(a, "pencil", "notes.txt", "2 KB", "", notes)
    app.list_item(a, "image", "photo.png", "1.4 MB", "new", photo)
    app.list_item(a, "trash", "Trash", "", "", trash)
    app.end(a)
    INFO = app.label(a, " ", 0)
    return app.run(a)
}
