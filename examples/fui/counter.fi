// examples/fui/counter.fi -- a number and two buttons.
//     firnc -o /tmp/counter examples/fui/counter.fi
//     firnc --target=wasm32-browser -o counter.wasm examples/fui/counter.fi
import fui.app

static mut SHOWN: usize = 0

fn add(a: *mut app.App, d: i64) {
    app.set_number(a, SHOWN, app.number(a, SHOWN) + d)
}

fn plus(a: *mut app.App) {
    add(a, 1)
}

fn minus(a: *mut app.App) {
    add(a, -1)
}

fn main() -> i32 {
    let a: *mut app.App = app.window("Counter", 300, 200)
    SHOWN = app.label(a, "0", 32)
    app.row(a)
    app.button(a, "  -  ", minus)
    app.button(a, "  +  ", plus)
    app.end(a)
    return app.run(a)
}
