// examples/fui/touchpad.fi -- pointers and gestures: what a window hears.
//     firnc -o /tmp/touchpad examples/fui/touchpad.fi
//     firnc --target=wasm32-browser -o touchpad.wasm examples/fui/touchpad.fi
// Touch it (or click it): every pointer has an id, a type and a time; a tap,
// a pan and a pinch are told apart by the arena in lib/fui/event.fi. The
// numbers on the window are the ones the handler sees.
import fui.app
import fui.event

static mut N_DOWN: i64 = 0
static mut MAX_DOWN: i64 = 0
static mut N_TAP: i64 = 0
static mut N_LONG: i64 = 0
static mut PAN_DX: i64 = 0
static mut PINCH: i64 = 100
static mut ANGLE: i64 = 0
static mut LAST_ID: i64 = 0
static mut LAST_TYPE: i64 = 0
static mut N_CANCEL: i64 = 0
static mut IDS_SEEN: i64 = 0
static mut L_DOWN: usize = 0
static mut L_TAP: usize = 0
static mut L_PAN: usize = 0
static mut L_PINCH: usize = 0
static mut L_ID: usize = 0

// What a test (tools/wasm/touchcheck.py) reads back from the page.
#[export_c]
fn touchpad_probe(k: u32) -> i64 {
    if k == 0 as u32 { return N_DOWN }
    if k == 1 as u32 { return MAX_DOWN }
    if k == 2 as u32 { return N_TAP }
    if k == 3 as u32 { return N_LONG }
    if k == 4 as u32 { return PAN_DX }
    if k == 5 as u32 { return PINCH }
    if k == 6 as u32 { return ANGLE }
    if k == 7 as u32 { return LAST_ID }
    if k == 8 as u32 { return LAST_TYPE }
    if k == 9 as u32 { return N_CANCEL }
    if k == 10 as u32 { return IDS_SEEN }
    return 0 - 1
}

fn heard(ud: u64, e: *mut event.Ev) -> u32 {
    let a: *mut app.App = ud as *mut app.App
    let k: u32 = event.ev_kind(e)
    if k == event.EV_POINTER_DOWN {
        N_DOWN = N_DOWN + 1
        if N_DOWN > MAX_DOWN {
            MAX_DOWN = N_DOWN
        }
        LAST_ID = event.ev_pid(e) as i64
        LAST_TYPE = event.ev_ptype(e) as i64
        IDS_SEEN = IDS_SEEN | (1 << (event.ev_pid(e) as i64 % 40))
        app.set_number(a, L_DOWN, N_DOWN)
        app.set_number(a, L_ID, LAST_ID)
    } else if k == event.EV_POINTER_UP {
        N_DOWN = N_DOWN - 1
        app.set_number(a, L_DOWN, N_DOWN)
    } else if k == event.EV_POINTER_CANCEL {
        N_DOWN = N_DOWN - 1
        N_CANCEL = N_CANCEL + 1
        app.set_number(a, L_DOWN, N_DOWN)
    } else if k == event.EV_TAP {
        N_TAP = N_TAP + 1
        app.set_number(a, L_TAP, N_TAP)
    } else if k == event.EV_LONG_PRESS {
        N_LONG = N_LONG + 1
    } else if k == event.EV_PAN_START || k == event.EV_PAN_MOVE {
        PAN_DX = PAN_DX + event.ev_dx(e) as i64
        app.set_number(a, L_PAN, PAN_DX)
    } else if k == event.EV_PINCH_START || k == event.EV_PINCH_MOVE {
        PINCH = (event.ev_scale(e) * 100.0) as i64
        ANGLE = event.ev_angle(e) as i64
        app.set_number(a, L_PINCH, PINCH)
    }
    return event.H_GO
}

fn main() -> i32 {
    let a: *mut app.App = app.window("Touch pad", 360, 420)
    app.label(a, "Touch me", 20)
    app.row(a)
    app.label(a, "down", 14)
    L_DOWN = app.label(a, "0", 14)
    app.end(a)
    app.row(a)
    app.label(a, "taps", 14)
    L_TAP = app.label(a, "0", 14)
    app.end(a)
    app.row(a)
    app.label(a, "pan x", 14)
    L_PAN = app.label(a, "0", 14)
    app.end(a)
    app.row(a)
    app.label(a, "pinch %", 14)
    L_PINCH = app.label(a, "100", 14)
    app.end(a)
    app.row(a)
    app.label(a, "pointer id", 14)
    L_ID = app.label(a, "0", 14)
    app.end(a)
    app.on(a, app.root(a), event.EV_POINTER_ALL | event.EV_PAN_ALL
        | event.EV_PINCH_ALL | event.ev_bit(event.EV_TAP)
        | event.ev_bit(event.EV_LONG_PRESS), heard)
    return app.run(a)
}
