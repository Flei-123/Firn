// examples/fui/context.fi -- right click, long press, menu key: ONE menu.
//     firnc -o /tmp/context examples/fui/context.fi
//     firnc --target=wasm32-browser -o context.wasm examples/fui/context.fi
//
// A list of files and a note field. Right-click a row (or press and hold on
// a touch screen, or focus the list and press the menu key / Shift+F10): the
// actions of the row come up; right-click the note field: Undo, Cut, Copy,
// Paste ... come up -- written once in lib/fui/ctxstd.fi, found by the
// field's widget kind. The same actions have shortcuts (Ctrl+O, Del) and sit
// on the action bus manifest (action.act_manifest).
import fui.app
import fui.action
import fui.ctxmenu

static mut LIST: usize = 0
static mut INFO: usize = 0
static mut A_OPEN: usize = 0
static mut A_RENAME: usize = 0
static mut A_DELETE: usize = 0
static mut A_NEW: usize = 0
static mut A_HIDDEN: usize = 0
static mut SHOW_HIDDEN: bool = false
static mut A_SORT_NAME: usize = 0
static mut A_SORT_SIZE: usize = 0
static mut SORT_BY_SIZE: bool = false

fn do_open(ud: u64, cx: *mut action.ActCtx) {
    app.set_text(ud as *mut app.App, INFO, "Open")
}

fn do_rename(ud: u64, cx: *mut action.ActCtx) {
    app.set_text(ud as *mut app.App, INFO, "Rename")
}

fn do_delete(ud: u64, cx: *mut action.ActCtx) {
    app.set_text(ud as *mut app.App, INFO, "Delete (critical: a human says yes on the bus)")
}

fn do_new(ud: u64, cx: *mut action.ActCtx) {
    app.set_text(ud as *mut app.App, INFO, "New file")
}

fn do_hidden(ud: u64, cx: *mut action.ActCtx) {
    SHOW_HIDDEN = !SHOW_HIDDEN
    app.set_text(ud as *mut app.App, INFO, "Hidden files toggled")
}

fn hidden_state(ud: u64, cx: *mut action.ActCtx) -> u32 {
    if SHOW_HIDDEN { return action.CHK_ON }
    return action.CHK_OFF
}

fn do_sort_name(ud: u64, cx: *mut action.ActCtx) {
    SORT_BY_SIZE = false
    app.set_text(ud as *mut app.App, INFO, "Sorted by name")
}

fn do_sort_size(ud: u64, cx: *mut action.ActCtx) {
    SORT_BY_SIZE = true
    app.set_text(ud as *mut app.App, INFO, "Sorted by size")
}

fn sort_name_state(ud: u64, cx: *mut action.ActCtx) -> u32 {
    if SORT_BY_SIZE { return action.CHK_OFF }
    return action.CHK_ON
}

fn sort_size_state(ud: u64, cx: *mut action.ActCtx) -> u32 {
    if SORT_BY_SIZE { return action.CHK_ON }
    return action.CHK_OFF
}

// What a row offers (the node `list` and everything under it).
fn row_menu(ud: u64, pc: *mut ctxmenu.ProviderCtx) {
    let e1: usize = ctxmenu.pc_add(pc, A_OPEN)
    let e2: usize = ctxmenu.pc_add(pc, A_RENAME)
    let e3: usize = ctxmenu.pc_add(pc, A_DELETE)
}

// What the whole window offers, wherever you click.
fn window_menu(ud: u64, pc: *mut ctxmenu.ProviderCtx) {
    let e1: usize = ctxmenu.pc_add(pc, A_NEW)
    let e2: usize = ctxmenu.pc_add(pc, A_HIDDEN)
    let sub: usize = ctxmenu.pc_submenu(pc, "&Sort by", action.ICON_NONE, action.G_VIEW)
    let e3: usize = ctxmenu.pc_add_to(pc, sub, A_SORT_NAME)
    let e4: usize = ctxmenu.pc_add_to(pc, sub, A_SORT_SIZE)
}

fn main() -> i32 {
    let a: *mut app.App = app.window("Context menus", 420, 360)
    app.label(a, "Files", 14)
    LIST = app.list(a)
    app.list_item(a, "folder", "Documents", "12 items", "", row_none)
    app.list_item(a, "pencil", "notes.txt", "2 KB", "", row_none)
    app.list_item(a, "image", "photo.png", "1.4 MB", "", row_none)
    app.end(a)
    app.entry(a, "a note (right click me)")
    INFO = app.label(a, " ", 0)

    A_OPEN = app.action_add(a, "open", "&Open", do_open)
    action.act_set_group(app.actions(a), A_OPEN, action.G_PRIMARY)
    action.act_set_shortcut(app.actions(a), A_OPEN, 79 as u32, action.MOD_CTRL)
    A_RENAME = app.action_add(a, "rename", "Rena&me", do_rename)
    A_DELETE = app.action_add(a, "delete", "&Delete", do_delete)
    action.act_danger(app.actions(a), A_DELETE)
    action.act_set_shortcut(app.actions(a), A_DELETE, action.SK_DELETE, 0 as u32)
    A_NEW = app.action_add(a, "new", "&New file", do_new)
    action.act_set_group(app.actions(a), A_NEW, action.G_VIEW)
    A_HIDDEN = app.action_add(a, "hidden", "Show &hidden files", do_hidden)
    action.act_set_group(app.actions(a), A_HIDDEN, action.G_VIEW)
    action.act_set_check(app.actions(a), A_HIDDEN, hidden_state)

    A_SORT_NAME = app.action_add(a, "sortname", "By &name", do_sort_name)
    action.act_set_radio(app.actions(a), A_SORT_NAME, sort_name_state)
    A_SORT_SIZE = app.action_add(a, "sortsize", "By &size", do_sort_size)
    action.act_set_radio(app.actions(a), A_SORT_SIZE, sort_size_state)

    app.on_context(a, LIST, row_menu)
    app.on_context_global(a, window_menu)
    app.std_edit(a)
    return app.run(a)
}

fn row_none(a: *mut app.App) {
}
