// examples/fui/form.fi -- an input form: two text fields and a button.
//     firnc -o /tmp/form examples/fui/form.fi
//     firnc --target=wasm32-browser -o form.wasm examples/fui/form.fi
import fui.app

static mut NAME: usize = 0
static mut MAIL: usize = 0
static mut OUT: usize = 0

fn send(a: *mut app.App) {
    if app.text(a, NAME).n == 0 {
        app.set_text(a, OUT, "Please enter your name.")
        return
    }
    app.set_text(a, OUT, "Thanks, ")
    app.append_text(a, OUT, app.text(a, NAME))
    app.append_text(a, OUT, "! We will write to ")
    app.append_text(a, OUT, app.text(a, MAIL))
}

fn clear(a: *mut app.App) {
    app.set_text(a, NAME, "")
    app.set_text(a, MAIL, "")
    app.set_text(a, OUT, " ")
}

fn main() -> i32 {
    let a: *mut app.App = app.window("Sign up", 420, 300)
    app.label(a, "Sign up for the newsletter", 14)
    NAME = app.entry(a, "Your name")
    MAIL = app.entry(a, "you@example.com")
    app.row(a)
    app.button(a, "Send", send)
    app.button(a, "Clear", clear)
    app.end(a)
    OUT = app.label(a, " ", 0)
    return app.run(a)
}
