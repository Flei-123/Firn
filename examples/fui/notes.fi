// examples/fui/notes.fi -- a text area: several lines, wrapping, scrolling.
//     firnc -o /tmp/notes examples/fui/notes.fi
//     firnc --target=wasm32-browser -o notes.wasm examples/fui/notes.fi
//
// Enter is a line break, the arrow keys, Home / End, PageUp / PageDown and the
// mouse (click, drag, double click, wheel) work as in any editor.
import fui.app

static mut BOX: usize = 0
static mut INFO: usize = 0

fn count(a: *mut app.App) {
    app.set_number(a, INFO, app.text(a, BOX).n as i64)
    app.append_text(a, INFO, " characters")
}

fn clear(a: *mut app.App) {
    app.set_text(a, BOX, "")
    app.set_text(a, INFO, " ")
}

fn main() -> i32 {
    let a: *mut app.App = app.window("Notes", 420, 360)
    BOX = app.textarea(a, "Notes", 6)
    app.row(a)
    app.button(a, "Count", count)
    app.button(a, "Clear", clear)
    app.end(a)
    INFO = app.label(a, " ", 0)
    return app.run(a)
}
