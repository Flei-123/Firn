import scene3d.vec3
import scene3d.quat
import scene3d.mesh
import scene3d.material
import scene3d.scene

export { hex, solid, glass, put, put_rot, put_at, group, child_group }

fn hex(c: u32) -> vec3.V3 {
    return vec3.rgb_hex(c)
}

fn solid(sc: *mut scene.Scene, c: u32, metal: f64, rough: f64) -> i32 {
    return scene.scene_add_material(sc, material.mat_standard(hex(c), metal, rough))
}

fn glass(sc: *mut scene.Scene, c: u32, opacity: f64) -> i32 {
    return scene.scene_add_material(sc, material.mat_glass(hex(c), opacity))
}

fn group(sc: *mut scene.Scene) -> i32 {
    return scene.scene_add_node(sc, 0 - 1)
}

fn child_group(sc: *mut scene.Scene, parent: i32, x: f64, y: f64, z: f64) -> i32 {
    let id: i32 = scene.scene_add_node(sc, parent)
    scene.node_set_pos(scene.scene_node(sc, id), vec3.v3(x, y, z))
    return id
}

fn put(sc: *mut scene.Scene, parent: i32, m: mesh.Mesh, mat: i32, x: f64, y: f64, z: f64) -> i32 {
    let mid: i32 = scene.scene_add_mesh(sc, m)
    let id: i32 = scene.scene_add_mesh_node(sc, parent, mid, mat)
    scene.node_set_pos(scene.scene_node(sc, id), vec3.v3(x, y, z))
    scene.node_set_sort_group(scene.scene_node(sc, id), 1)
    return id
}

fn put_rot(sc: *mut scene.Scene, parent: i32, m: mesh.Mesh, mat: i32, x: f64, y: f64, z: f64, rx: f64, ry: f64, rz: f64) -> i32 {
    let id: i32 = put(sc, parent, m, mat, x, y, z)
    scene.node_set_euler(scene.scene_node(sc, id), rx, ry, rz)
    return id
}

fn put_at(sc: *mut scene.Scene, parent: i32, mesh_id: i32, mat: i32, x: f64, y: f64, z: f64) -> i32 {
    let id: i32 = scene.scene_add_mesh_node(sc, parent, mesh_id, mat)
    scene.node_set_pos(scene.scene_node(sc, id), vec3.v3(x, y, z))
    scene.node_set_sort_group(scene.scene_node(sc, id), 1)
    return id
}
