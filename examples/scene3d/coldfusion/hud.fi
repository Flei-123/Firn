import scene3d.vec3
import scene3d.surface
import scene3d.ov_px
import scene3d.ov_shapes
import scene3d.overlay
import timeline

export { draw_title, draw_hud, draw_final, draw_clock }

fn centered(ov: *mut overlay.Overlay, dst: *mut surface.Surface, y: f64, size: f64, col: u32, text: str, bold: bool) {
    let w: f64 = overlay.ov_text_width_ex(ov, size, text, bold)
    overlay.ov_text_ex(ov, dst, ((*dst).w as f64 - w) * 0.5, y, size, col, text, true, bold)
}

fn draw_title(ov: *mut overlay.Overlay, dst: *mut surface.Surface, t: f64) {
    let a: f64 = timeline.title_alpha(t)
    if a <= 0.0 { return }
    let w: f64 = (*dst).w as f64
    let h: f64 = (*dst).h as f64
    ov_shapes.ov_round_rect(dst, w * 0.5 - 520.0, h * 0.5 - 120.0, 1040.0, 200.0, 18.0,
        ov_px.color_fade(ov_px.rgba(10, 16, 30, 190), a), ov_px.color_fade(ov_px.rgba(120, 170, 255, 255), a), 2.0)
    centered(ov, dst, h * 0.5 - 30.0, 72.0, ov_px.color_fade(ov_px.rgba(255, 255, 255, 255), a), "Kalte Fusion?", true)
    centered(ov, dst, h * 0.5 + 20.0, 28.0, ov_px.color_fade(ov_px.rgba(190, 215, 255, 255), a),
        "Kalorimeter-Aufbau mit D₂O, Pd-Kathode und Pt-Anode", false)
    centered(ov, dst, h * 0.5 + 56.0, 22.0, ov_px.color_fade(ov_px.rgba(160, 180, 210, 255), a),
        "Wie misst man die Energiebilanz?", false)
}

fn row(ov: *mut overlay.Overlay, dst: *mut surface.Surface, x: f64, y: f64, a: f64, col: u32, text: str, bold: bool) {
    overlay.ov_text_ex(ov, dst, x, y, 19.0, ov_px.color_fade(col, a), text, false, bold)
}

fn draw_hud(ov: *mut overlay.Overlay, dst: *mut surface.Surface, t: f64) {
    let a: f64 = timeline.hud_alpha(t)
    if a <= 0.0 { return }
    let pw: f64 = 440.0
    let ph: f64 = 236.0
    let px: f64 = (*dst).w as f64 - pw - 24.0
    let py: f64 = (*dst).h as f64 - ph - 24.0
    ov_shapes.ov_round_rect(dst, px, py, pw, ph, 12.0, ov_px.color_fade(ov_px.rgba(12, 18, 32, 215), a),
        ov_px.color_fade(ov_px.rgba(120, 170, 255, 255), a), 1.5)
    let white: u32 = ov_px.rgba(240, 245, 255, 255)
    let gold: u32 = ov_px.rgba(255, 200, 90, 255)
    let green: u32 = ov_px.rgba(120, 230, 150, 255)
    let blue: u32 = ov_px.rgba(120, 190, 255, 255)
    let x: f64 = px + 18.0
    let pi: str = timeline.fmt_comma(timeline.p_in(t), 2)
    let pg: str = timeline.fmt_comma(timeline.p_gas(t), 2)
    let ph2: str = timeline.fmt_comma(timeline.p_heat(t), 2)
    let po: str = timeline.fmt_comma(timeline.p_out(t), 2)
    let ta: str = timeline.fmt_comma(timeline.t_aus(t), 1)
    let sp: str = timeline.fmt_comma(timeline.surplus(t), 2)
    row(ov, dst, x, py + 32.0, a, gold, "Energiebilanz", true)
    row(ov, dst, x, py + 62.0, a, white, "P_ein = U·I = 3,20 V × 0,500 A = " + pi + " W", false)
    row(ov, dst, x, py + 88.0, a, white, "P_Gas = 1,54 V × I = " + pg + " W", false)
    row(ov, dst, x, py + 114.0, a, blue, "Wärme erwartet = " + ph2 + " W", true)
    row(ov, dst, x, py + 146.0, a, white, "Fluss 0,2 g/s   T_ein 18,0 °C   T_aus " + ta + " °C", false)
    row(ov, dst, x, py + 172.0, a, white, "P_aus = 0,2 × 4,18 × ΔT = " + po + " W", false)
    row(ov, dst, x, py + 206.0, a, green, "Überschuss ≈ " + sp + " W", true)
}

fn draw_final(ov: *mut overlay.Overlay, dst: *mut surface.Surface, t: f64) {
    let a: f64 = timeline.final_alpha(t)
    if a <= 0.0 { return }
    let w: f64 = (*dst).w as f64
    ov_shapes.ov_round_rect(dst, w * 0.5 - 430.0, 40.0, 860.0, 130.0, 16.0,
        ov_px.color_fade(ov_px.rgba(10, 16, 30, 200), a), ov_px.color_fade(ov_px.rgba(255, 150, 70, 255), a), 2.0)
    centered(ov, dst, 98.0, 52.0, ov_px.color_fade(ov_px.rgba(255, 225, 160, 255), a), "Kontrolle nicht vergessen", true)
    centered(ov, dst, 140.0, 24.0, ov_px.color_fade(ov_px.rgba(210, 225, 250, 255), a),
        "Heizwiderstand mit 0,83 W eichen: gleiche Anzeige = kein Überschuss", false)
}

fn draw_clock(ov: *mut overlay.Overlay, dst: *mut surface.Surface, t: f64) {
    let a: f64 = vec3.clamp01(timeline.ramp(t, 3.0, 4.0))
    if a <= 0.0 { return }
    let s: str = "t = " + timeline.fmt_comma(t, 1) + " s"
    overlay.ov_text_ex(ov, dst, 24.0, (*dst).h as f64 - 26.0, 18.0, ov_px.color_fade(ov_px.rgba(220, 230, 250, 255), a * 0.8), s, true, false)
}
