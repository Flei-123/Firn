import scene3d.scene
import scene3d.overlay
import hoses

export { Demo, demo_blank, GROUPS }

const GROUPS: i32 = 18

struct Demo {
    sc: scene.Scene,
    hs: hoses.Hoses,
    ov: *mut overlay.Overlay,
    grp: [i32; 18],
    tex_psu: i32,
    tex_lap: i32,
    mat_heater: i32,
    mat_ring: i32,
    mat_led: i32,
    light_heater: i32,
    cup_water: i32,
    flow_in_first: i32,
    flow_in_count: i32,
    flow_out_first: i32,
    flow_out_count: i32,
    bub_first: i32,
    bub_count: i32,
    thermo_col: i32,
    heater_halo: i32,
}

fn demo_blank(sc: scene.Scene, hs: hoses.Hoses, ov: *mut overlay.Overlay) -> Demo {
    return Demo {
        sc: sc, hs: hs, ov: ov, grp: [0; 18],
        tex_psu: 0, tex_lap: 0, mat_heater: 0, mat_ring: 0, mat_led: 0, light_heater: 0, cup_water: 0,
        flow_in_first: 0, flow_in_count: 0, flow_out_first: 0, flow_out_count: 0,
        bub_first: 0, bub_count: 0, thermo_col: 0, heater_halo: 0,
    }
}
