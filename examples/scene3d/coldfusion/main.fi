import std.io
import jobs.jobs
import scene3d.video
import scene3d.video_opts
import scene3d.surface
import frame
import timeline

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == jobs.WORKER_KIND {
        return jobs.worker_main(arg)
    }
    return 0
}

fn frame_cb(ctx: u64, index: u64, t: f64, out: *mut surface.Surface) {
    let s: *mut frame.Show = ctx as *mut frame.Show
    frame.render_at(s, t, out)
}

fn main(start: u64) -> i32 {
    if !gc_init() { return 1 }
    var o: video_opts.VideoOpts = video_opts.video_opts_default()
    o.duration = timeline.DURATION
    o.out = "coldfusion.mp4"
    let pr: i32 = video_opts.video_parse_args(&o, "coldfusion", "cold fusion calorimeter explainer", start)
    if pr >= 0 { return pr }
    var show: frame.Show = frame.show_new(o.width, o.height, o.ss, o.threads)
    var rc: i32 = 0
    let sp: *mut frame.Show = &show
    let ctx: u64 = sp as u64
    if o.has_still {
        rc = video.video_still(&o, frame_cb, ctx)
    } else {
        rc = video.video_run(&o, frame_cb, ctx)
    }
    frame.show_free(&show)
    return rc
}
