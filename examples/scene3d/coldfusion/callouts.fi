import scene3d.vec3
import scene3d.camera
import scene3d.surface
import scene3d.ov_px
import scene3d.overlay
import scene3d.labels
import timeline

export { LABEL_COUNT, draw_labels }

const LABEL_COUNT: i32 = 21

struct LabelDef { part: i32, x: f64, y: f64, z: f64, text: str }

fn def(i: i32) -> LabelDef {
    if i == 0 { return LabelDef { part: 0, x: 40.0, y: 0.0, z: 30.0, text: "Labortisch" } }
    if i == 1 { return LabelDef { part: 1, x: -13.0, y: 22.0, z: 13.0, text: "Styropor-Box\nIsolierung, vorne offen" } }
    if i == 2 { return LabelDef { part: 2, x: 8.8, y: 14.0, z: 2.0, text: "Kühlmantel\nGlas mit Wasser" } }
    if i == 3 { return LabelDef { part: 3, x: 4.2, y: 7.0, z: 2.0, text: "Becherglas\nmit D₂O" } }
    if i == 4 { return LabelDef { part: 4, x: 0.0, y: 19.5, z: 0.0, text: "Pd-Kathode\nPalladium-Draht" } }
    if i == 5 { return LabelDef { part: 5, x: -2.4, y: 12.0, z: 0.0, text: "Pt-Anode\nPlatin-Helix, 8 Windungen" } }
    if i == 6 { return LabelDef { part: 6, x: 3.2, y: 13.2, z: 3.0, text: "Heizwiderstand\nzur Kalibrierung" } }
    if i == 7 { return LabelDef { part: 7, x: -3.2, y: 24.0, z: 1.8, text: "Thermometer" } }
    if i == 8 { return LabelDef { part: 8, x: 4.0, y: 24.2, z: 0.5, text: "Gummistopfen\nund Gasabzug" } }
    if i == 9 { return LabelDef { part: 9, x: 24.0, y: 9.0, z: -6.0, text: "Blasenzähler\nmisst das Gas" } }
    if i == 10 { return LabelDef { part: 10, x: -38.0, y: 12.0, z: -3.0, text: "Wasservorrat" } }
    if i == 11 { return LabelDef { part: 10, x: -27.0, y: 7.5, z: 6.0, text: "Pumpe" } }
    if i == 12 { return LabelDef { part: 11, x: -17.0, y: 2.6, z: 5.5, text: "Zulaufschlauch" } }
    if i == 13 { return LabelDef { part: 11, x: 17.0, y: 22.5, z: 1.5, text: "Ablaufschlauch" } }
    if i == 14 { return LabelDef { part: 12, x: -15.0, y: 2.8, z: 5.5, text: "Temperaturfühler\nT_ein" } }
    if i == 15 { return LabelDef { part: 12, x: 22.0, y: 19.0, z: 4.0, text: "Temperaturfühler\nT_aus" } }
    if i == 16 { return LabelDef { part: 13, x: 30.0, y: 12.0, z: 8.0, text: "Messbecher\nauf Waage" } }
    if i == 17 { return LabelDef { part: 14, x: -46.0, y: 9.0, z: 24.0, text: "Labornetzteil\n3,20 V / 0,500 A" } }
    if i == 18 { return LabelDef { part: 15, x: -20.0, y: 18.0, z: 14.0, text: "Kabel rot/schwarz\nzum Stopfen" } }
    if i == 19 { return LabelDef { part: 16, x: -28.0, y: 1.2, z: 30.0, text: "Datenlogger" } }
    if i == 20 { return LabelDef { part: 17, x: -8.0, y: 13.0, z: 17.0, text: "Laptop\nTemperaturkurve" } }
    return LabelDef { part: 17, x: 0.0, y: 0.0, z: 0.0, text: "" }
}

fn draw_labels(ov: *mut overlay.Overlay, dst: *mut surface.Surface, cam: *mut camera.Camera, t: f64) {
    overlay.overlay_frame_begin(ov)
    var st: labels.LabelStyle = labels.label_style()
    st.size = 20.0
    var i: i32 = 0
    while i < 21 {
        let df: LabelDef = def(i)
        let a: f64 = timeline.label_alpha(df.part, t)
        if a > 0.0 {
            labels.ov_label(ov, dst, cam, vec3.v3(df.x, df.y, df.z), df.text, st, a)
        }
        i = i + 1
    }
}
