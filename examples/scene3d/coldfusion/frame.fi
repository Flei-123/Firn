import scene3d.vec3
import scene3d.camera
import scene3d.surface
import scene3d.scene
import scene3d.light
import scene3d.tonemap
import scene3d.overlay
import scene3d.render
import util
import demo
import hoses
import parts_lab
import parts_chain
import parts_desk
import fx
import rig
import screens
import hud
import callouts
import timeline

export { Show, show_new, show_free, render_at }

struct Show {
    d: demo.Demo,
    rd: render.Renderer,
}

fn show_new(w: i32, h: i32, ss: i32, threads: i32) -> Show {
    var sc: scene.Scene = scene.scene_new()
    sc.bg_top = util.hex(0x0c1220)
    sc.bg_bottom = util.hex(0x2a3550)
    scene.scene_set_tonemap(&sc, tonemap.TONEMAP_FILMIC)
    scene.scene_set_share_shading(&sc, true)
    scene.scene_set_exposure_ev(&sc, 0.0)
    sc.hemi_sky = vec3.v3(0.42, 0.46, 0.56)
    sc.hemi_ground = vec3.v3(0.18, 0.16, 0.14)
    var d: demo.Demo = demo.demo_blank(sc, hoses.hoses_build(), overlay.overlay_default())
    parts_lab.make_groups(&d)
    parts_lab.build_table(&d)
    parts_lab.build_box(&d)
    parts_lab.build_jacket(&d)
    parts_lab.build_beaker(&d)
    parts_lab.build_cathode(&d)
    parts_lab.build_anode(&d)
    parts_lab.build_heater(&d)
    parts_lab.build_thermo(&d)
    parts_lab.build_stopper(&d)
    parts_chain.build_counter(&d)
    parts_chain.build_pump(&d)
    parts_chain.build_hoses(&d)
    parts_chain.build_probes(&d)
    parts_chain.build_scale(&d)
    parts_desk.build_psu(&d)
    parts_desk.build_logger(&d)
    parts_desk.build_laptop(&d)
    fx.build_flow(&d)
    fx.build_bubbles(&d)
    var key: light.Light = light.light_dir(vec3.v3(0.5, 1.0, 0.9), vec3.v3(1.0, 0.96, 0.9), 1.15)
    light.light_set_shadow(&key, 1024, 0.004, 1.0)
    scene.scene_add_light(&d.sc, key)
    scene.scene_add_light(&d.sc, light.light_dir(vec3.v3(-1.0, 0.35, 0.6), vec3.v3(0.7, 0.8, 1.0), 0.45))
    return Show { d: d, rd: render.renderer_new(w, h, ss, threads) }
}

fn show_free(s: *mut Show) {
    render.renderer_free(&(*s).rd)
    scene.scene_free(&(*s).d.sc)
    hoses.hoses_free(&(*s).d.hs)
    overlay.overlay_free((*s).d.ov)
}

fn render_at(s: *mut Show, t: f64, out: *mut surface.Surface) {
    let d: *mut demo.Demo = &(*s).d
    fx.apply_parts(d, t)
    fx.apply_flow(d, t)
    fx.apply_bubbles(d, t)
    fx.apply_dynamics(d, t)
    screens.draw_psu((*d).ov, scene.scene_texture(&(*d).sc, (*d).tex_psu), t)
    screens.draw_laptop((*d).ov, scene.scene_texture(&(*d).sc, (*d).tex_lap), t)
    scene.scene_update(&(*d).sc)
    var cam: camera.Camera = rig.cam_at(t, (*out).w, (*out).h)
    render.render(&(*s).rd, &(*d).sc, &cam, out)
    callouts.draw_labels((*d).ov, out, &cam, t)
    hud.draw_title((*d).ov, out, t)
    hud.draw_hud((*d).ov, out, t)
    hud.draw_final((*d).ov, out, t)
    hud.draw_clock((*d).ov, out, t)
}
