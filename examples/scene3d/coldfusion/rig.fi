import scene3d.vec3
import scene3d.camera

export { cam_at, KEY_COUNT }

const KEY_COUNT: i32 = 14

struct Key { t: f64, px: f64, py: f64, pz: f64, tx: f64, ty: f64, tz: f64, fov: f64 }

fn key(i: i32) -> Key {
    if i == 0 { return Key { t: 0.0, px: 34.0, py: 36.0, pz: 92.0, tx: 0.0, ty: 9.0, tz: 0.0, fov: 38.0 } }
    if i == 1 { return Key { t: 4.5, px: 14.0, py: 46.0, pz: 86.0, tx: 0.0, ty: 12.0, tz: 0.0, fov: 38.0 } }
    if i == 2 { return Key { t: 6.2, px: 9.0, py: 25.0, pz: 45.0, tx: 0.0, ty: 15.0, tz: 0.0, fov: 30.0 } }
    if i == 3 { return Key { t: 12.6, px: -8.0, py: 25.0, pz: 43.0, tx: 0.0, ty: 15.0, tz: 0.0, fov: 30.0 } }
    if i == 4 { return Key { t: 15.5, px: -2.0, py: 40.0, pz: 88.0, tx: -8.0, ty: 9.0, tz: 4.0, fov: 48.0 } }
    if i == 5 { return Key { t: 26.0, px: 6.0, py: 42.0, pz: 86.0, tx: -2.0, ty: 9.0, tz: 4.0, fov: 48.0 } }
    if i == 6 { return Key { t: 28.5, px: 7.0, py: 21.0, pz: 33.0, tx: 0.0, ty: 13.0, tz: 0.0, fov: 34.0 } }
    if i == 7 { return Key { t: 36.0, px: -6.0, py: 20.0, pz: 31.0, tx: 0.0, ty: 13.0, tz: 0.0, fov: 34.0 } }
    if i == 8 { return Key { t: 39.0, px: -2.0, py: 38.0, pz: 94.0, tx: -2.0, ty: 8.0, tz: 2.0, fov: 46.0 } }
    if i == 9 { return Key { t: 48.0, px: 6.0, py: 36.0, pz: 92.0, tx: -2.0, ty: 8.0, tz: 2.0, fov: 46.0 } }
    return Key { t: 99.0, px: 6.0, py: 36.0, pz: 92.0, tx: -2.0, ty: 8.0, tz: 2.0, fov: 46.0 }
}

fn mixf(a: f64, b: f64, u: f64) -> f64 {
    return a + (b - a) * u
}

fn cam_at(t: f64, w: i32, h: i32) -> camera.Camera {
    var c: camera.Camera = camera.cam_new(w, h)
    var i: i32 = 0
    while i < 9 && key(i + 1).t <= t { i = i + 1 }
    let a: Key = key(i)
    let b: Key = key(i + 1)
    var u: f64 = 0.0
    if b.t > a.t { u = vec3.smootherstep(vec3.clamp01((t - a.t) / (b.t - a.t))) }
    c.pos = vec3.v3(mixf(a.px, b.px, u), mixf(a.py, b.py, u), mixf(a.pz, b.pz, u))
    c.target = vec3.v3(mixf(a.tx, b.tx, u), mixf(a.ty, b.ty, u), mixf(a.tz, b.tz, u))
    c.fov = mixf(a.fov, b.fov, u)
    c.near = 2.0
    c.far = 400.0
    return c
}
