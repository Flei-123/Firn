import std.math
import std.vec
import scene3d.vec3
import scene3d.surface
import scene3d.ov_px
import scene3d.ov_shapes
import scene3d.overlay
import timeline

export { PSU_W, PSU_H, LAP_W, LAP_H, draw_psu, draw_laptop }

const PSU_W: i32 = 256
const PSU_H: i32 = 128
const LAP_W: i32 = 512
const LAP_H: i32 = 320

fn draw_psu(ov: *mut overlay.Overlay, dst: *mut surface.Surface, t: f64) {
    let lv: f64 = timeline.power_level(t)
    surface.surface_clear(dst, ov_px.rgba(8, 24, 14, 255))
    ov_shapes.ov_round_rect(dst, 3.0, 3.0, 250.0, 122.0, 8.0, ov_px.rgba(10, 34, 20, 255), ov_px.rgba(60, 120, 80, 255), 2.0)
    let volt: str = timeline.fmt_comma(timeline.VOLT * lv, 2)
    let amp: str = timeline.fmt_comma(timeline.AMP * lv, 3)
    let green: u32 = ov_px.rgba(90, 255, 140, 255)
    overlay.ov_text_ex(ov, dst, 18.0, 52.0, 42.0, green, volt + " V", false, true)
    overlay.ov_text_ex(ov, dst, 18.0, 106.0, 42.0, green, amp + " A", false, true)
}

fn draw_laptop(ov: *mut overlay.Overlay, dst: *mut surface.Surface, t: f64) {
    surface.surface_clear(dst, ov_px.rgba(14, 18, 30, 255))
    overlay.ov_text_ex(ov, dst, 14.0, 26.0, 20.0, ov_px.rgba(220, 230, 250, 255), "Datenlogger: Temperatur", false, true)
    let px: f64 = 52.0
    let py: f64 = 50.0
    let pw: f64 = 440.0
    let ph: f64 = 220.0
    ov_shapes.ov_fill_rect(dst, px, py, pw, ph, ov_px.rgba(22, 28, 44, 255))
    var gy: i32 = 0
    while gy <= 4 {
        let yy: f64 = py + ph * (gy as f64) / 4.0
        ov_shapes.ov_line(dst, px, yy, px + pw, yy, 1.0, ov_px.rgba(60, 70, 96, 255))
        gy = gy + 1
    }
    overlay.ov_text_ex(ov, dst, 8.0, py + 6.0, 14.0, ov_px.rgba(170, 185, 215, 255), "19,5", false, false)
    overlay.ov_text_ex(ov, dst, 8.0, py + ph * 0.5 + 6.0, 14.0, ov_px.rgba(170, 185, 215, 255), "18,5", false, false)
    overlay.ov_text_ex(ov, dst, 8.0, py + ph + 6.0, 14.0, ov_px.rgba(170, 185, 215, 255), "17,5", false, false)
    let n: i32 = 96
    let frac: f64 = vec3.clamp01(t / timeline.DURATION)
    var cnt: i32 = ((n as f64) * frac) as i32
    if cnt < 2 { cnt = 2 }
    var yin: vec.Vec[f64] = vec.vec_new[f64]()
    var yout: vec.Vec[f64] = vec.vec_new[f64]()
    var i: i32 = 0
    while i < cnt {
        let ts: f64 = timeline.DURATION * (i as f64) / ((n - 1) as f64)
        vec.vec_push[f64](&yin, timeline.T_IN + 0.012 * math.sin(ts * 9.0))
        vec.vec_push[f64](&yout, timeline.t_aus(ts) + 0.012 * math.sin(ts * 7.0 + 1.0))
        i = i + 1
    }
    let wpart: f64 = pw * (((cnt - 1) as f64) / ((n - 1) as f64))
    ov_shapes.ov_plot(dst, px, py, wpart, ph, &yin, 17.5, 19.5, 2.5, ov_px.rgba(90, 170, 255, 255))
    ov_shapes.ov_plot(dst, px, py, wpart, ph, &yout, 17.5, 19.5, 2.5, ov_px.rgba(255, 150, 60, 255))
    vec.vec_free[f64](&yin)
    vec.vec_free[f64](&yout)
    overlay.ov_text_ex(ov, dst, px + 8.0, py + ph + 24.0, 15.0, ov_px.rgba(90, 170, 255, 255), "T_ein", false, false)
    overlay.ov_text_ex(ov, dst, px + 80.0, py + ph + 24.0, 15.0, ov_px.rgba(255, 150, 60, 255),
        "T_aus " + timeline.fmt_comma(timeline.t_aus(t), 1) + " °C", false, false)
}
