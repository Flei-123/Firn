import scene3d.vec3
import scene3d.mesh
import scene3d.geom
import scene3d.curve
import scene3d.material
import scene3d.scene
import scene3d.light
import util
import demo

export { make_groups, build_table, build_box, build_jacket, build_beaker, build_cathode, build_anode, build_heater, build_thermo, build_stopper }

fn build_table(d: *mut demo.Demo) {
    let sc: *mut scene.Scene = &(*d).sc
    let g: i32 = (*d).grp[0]
    let wood: i32 = util.solid(sc, 0x9a7650, 0.0, 0.7)
    let dark: i32 = util.solid(sc, 0x2b3038, 0.2, 0.5)
    util.put(sc, g, geom.geom_box(130.0, 4.0, 82.0), wood, 0.0, -2.0, 0.0)
    let leg: mesh.Mesh = geom.geom_box(5.0, 40.0, 5.0)
    let lid: i32 = scene.scene_add_mesh(sc, leg)
    util.put_at(sc, g, lid, dark, -60.0, -24.0, -35.0)
    util.put_at(sc, g, lid, dark, 60.0, -24.0, -35.0)
    util.put_at(sc, g, lid, dark, -60.0, -24.0, 35.0)
    util.put_at(sc, g, lid, dark, 60.0, -24.0, 35.0)
    util.put(sc, g, geom.geom_plane(500.0, 400.0, 1, 1), util.solid(sc, 0x1c222c, 0.0, 0.9), 0.0, -44.0, 0.0)
}

fn build_box(d: *mut demo.Demo) {
    let sc: *mut scene.Scene = &(*d).sc
    let g: i32 = (*d).grp[1]
    let m: i32 = scene.scene_add_material(sc, material.mat_with_opacity(material.mat_standard(util.hex(0xf3f5f9), 0.0, 0.95), 0.32))
    util.put(sc, g, geom.geom_box_open(26.0, 28.0, 26.0, 1.5), m, 0.0, 14.0, 0.0)
}

fn build_jacket(d: *mut demo.Demo) {
    let sc: *mut scene.Scene = &(*d).sc
    let g: i32 = (*d).grp[2]
    let gl: i32 = util.glass(sc, 0xdfeeff, 0.16)
    let wm: i32 = scene.scene_add_material(sc, material.mat_with_opacity(material.mat_glass(util.hex(0x2a74e0), 0.4), 0.34))
    util.put(sc, g, geom.geom_cylinder(9.0, 9.0, 21.0, 56, true), gl, 0.0, 12.5, 0.0)
    util.put(sc, g, geom.geom_cylinder(9.0, 9.0, 0.4, 56, false), gl, 0.0, 2.2, 0.0)
    util.put(sc, g, geom.geom_cylinder(8.75, 8.75, 19.4, 56, false), wm, 0.0, 12.2, 0.0)
    let nozzle: i32 = util.glass(sc, 0xdfeeff, 0.3)
    util.put_rot(sc, g, geom.geom_cylinder(0.9, 0.9, 3.0, 16, false), nozzle, -9.4, 4.2, 0.6, 0.0, 0.0, 1.5707963)
    util.put_rot(sc, g, geom.geom_cylinder(0.9, 0.9, 3.0, 16, false), nozzle, 9.4, 20.5, 0.4, 0.0, 0.0, 1.5707963)
}

fn build_beaker(d: *mut demo.Demo) {
    let sc: *mut scene.Scene = &(*d).sc
    let g: i32 = (*d).grp[3]
    let gl: i32 = util.glass(sc, 0xf0f8ff, 0.2)
    let wm: i32 = scene.scene_add_material(sc, material.mat_with_opacity(material.mat_glass(util.hex(0x20d6c8), 0.45), 0.5))
    util.put(sc, g, geom.geom_cylinder(5.0, 5.0, 18.5, 48, true), gl, 0.0, 13.25, 0.0)
    util.put(sc, g, geom.geom_cylinder(5.0, 5.0, 0.4, 48, false), gl, 0.0, 4.2, 0.0)
    util.put(sc, g, geom.geom_cylinder(4.8, 4.8, 15.0, 48, false), wm, 0.0, 11.9, 0.0)
}

fn build_cathode(d: *mut demo.Demo) {
    let sc: *mut scene.Scene = &(*d).sc
    let g: i32 = (*d).grp[4]
    let silver: i32 = util.solid(sc, 0xd8dce2, 0.9, 0.25)
    util.put(sc, g, geom.geom_cylinder(0.2, 0.2, 20.0, 12, false), silver, 0.0, 16.0, 0.0)
}

fn build_anode(d: *mut demo.Demo) {
    let sc: *mut scene.Scene = &(*d).sc
    let g: i32 = (*d).grp[5]
    let plat: i32 = util.solid(sc, 0xb9bfc9, 1.0, 0.3)
    var hx: curve.Curve = curve.curve_helix(vec3.v3(0.0, 13.0, 0.0), 2.4, 1.1, 8.0, 20)
    util.put(sc, g, geom.geom_tube(&hx, 0.14, 320, 8, true), plat, 0.0, 0.0, 0.0)
    curve.curve_free(&hx)
    util.put(sc, g, geom.geom_cylinder(0.14, 0.14, 8.8, 8, false), plat, 2.4, 21.8, 0.0)
}

fn build_heater(d: *mut demo.Demo) {
    let sc: *mut scene.Scene = &(*d).sc
    let g: i32 = (*d).grp[6]
    (*d).mat_heater = scene.scene_add_material(sc, material.mat_standard(util.hex(0x7a4a2a), 0.0, 0.6))
    (*d).mat_ring = scene.scene_add_material(sc, material.mat_standard(util.hex(0xd02020), 0.0, 0.5))
    let lead: i32 = util.solid(sc, 0xc0c4cc, 0.9, 0.3)
    util.put(sc, g, geom.geom_cylinder(0.9, 0.9, 8.0, 24, false), (*d).mat_heater, 3.2, 11.0, 2.2)
    let ring: mesh.Mesh = geom.geom_torus(0.95, 0.2, 8, 24)
    let rid: i32 = scene.scene_add_mesh(sc, ring)
    util.put_at(sc, g, rid, (*d).mat_ring, 3.2, 8.8, 2.2)
    util.put_at(sc, g, rid, (*d).mat_ring, 3.2, 11.0, 2.2)
    util.put_at(sc, g, rid, (*d).mat_ring, 3.2, 13.2, 2.2)
    util.put(sc, g, geom.geom_cylinder(0.12, 0.12, 11.0, 8, false), lead, 3.0, 20.5, 2.2)
    util.put(sc, g, geom.geom_cylinder(0.12, 0.12, 11.0, 8, false), lead, 3.4, 20.5, 2.2)
    let hm: i32 = scene.scene_add_material(sc, material.mat_with_opacity(material.mat_emissive(util.hex(0xff7a1a), 3.0), 0.5))
    (*d).heater_halo = util.put(sc, g, geom.geom_sphere(1.0, 16, 12), hm, 3.2, 11.0, 2.2)
    scene.node_set_scale(scene.scene_node(sc, (*d).heater_halo), vec3.v3(2.4, 5.2, 2.4))
    scene.node_set_visible(scene.scene_node(sc, (*d).heater_halo), false)
    (*d).light_heater = scene.scene_add_light(sc, light.light_point(vec3.v3(3.2, 11.0, 4.0), vec3.v3(1.0, 0.45, 0.15), 0.0, 30.0))
}

fn build_thermo(d: *mut demo.Demo) {
    let sc: *mut scene.Scene = &(*d).sc
    let g: i32 = (*d).grp[7]
    let gl: i32 = util.glass(sc, 0xf4faff, 0.28)
    let red: i32 = scene.scene_add_material(sc, material.mat_emissive(util.hex(0xe02020), 0.6))
    util.put(sc, g, geom.geom_cylinder(0.38, 0.38, 21.0, 16, false), gl, -3.2, 15.5, 1.8)
    (*d).thermo_col = util.put(sc, g, geom.geom_cylinder(0.14, 0.14, 1.0, 8, false), red, -3.2, 13.0, 1.8)
    scene.node_set_scale(scene.scene_node(sc, (*d).thermo_col), vec3.v3(1.0, 14.0, 1.0))
}

fn build_stopper(d: *mut demo.Demo) {
    let sc: *mut scene.Scene = &(*d).sc
    let g: i32 = (*d).grp[8]
    let rub: i32 = util.solid(sc, 0x8a3b24, 0.0, 0.95)
    let tube: i32 = util.glass(sc, 0xdde6ee, 0.4)
    util.put(sc, g, geom.geom_cylinder(4.5, 4.1, 2.8, 40, false), rub, 0.0, 23.5, 0.0)
    util.put(sc, g, geom.geom_cylinder(0.5, 0.5, 2.0, 12, false), tube, 1.6, 25.8, -1.8)
}

fn make_groups(d: *mut demo.Demo) {
    var i: i32 = 0
    while i < demo.GROUPS {
        (*d).grp[i as usize] = util.group(&(*d).sc)
        i = i + 1
    }
}
