import scene3d.vec3
import scene3d.curve

export { Hoses, hoses_build, hoses_free }

struct Hoses {
    inflow: curve.Curve,
    outflow: curve.Curve,
    gas: curve.Curve,
    red: curve.Curve,
    black: curve.Curve,
    probe_in: curve.Curve,
    probe_out: curve.Curve,
}

fn add3(c: *mut curve.Curve, x: f64, y: f64, z: f64) {
    curve.curve_add(c, vec3.v3(x, y, z))
}

fn hoses_build() -> Hoses {
    var inflow: curve.Curve = curve.curve_new()
    add3(&inflow, -34.0, 3.6, -6.0)
    add3(&inflow, -30.0, 3.4, -2.0)
    add3(&inflow, -27.0, 4.6, 2.0)
    add3(&inflow, -22.0, 3.2, 5.5)
    add3(&inflow, -17.0, 2.6, 5.5)
    add3(&inflow, -12.0, 3.4, 3.0)
    add3(&inflow, -9.4, 4.2, 0.6)
    curve.curve_build(&inflow)
    var outflow: curve.Curve = curve.curve_new()
    add3(&outflow, 9.4, 20.5, 0.4)
    add3(&outflow, 12.5, 22.0, 0.0)
    add3(&outflow, 17.0, 22.5, 1.5)
    add3(&outflow, 22.0, 19.0, 4.0)
    add3(&outflow, 26.5, 15.0, 7.0)
    add3(&outflow, 29.5, 14.2, 8.0)
    add3(&outflow, 30.0, 11.0, 8.0)
    curve.curve_build(&outflow)
    var gas: curve.Curve = curve.curve_new()
    add3(&gas, 1.6, 26.6, -1.8)
    add3(&gas, 2.6, 27.0, -3.0)
    add3(&gas, 8.0, 26.8, -5.0)
    add3(&gas, 14.0, 25.0, -7.0)
    add3(&gas, 21.0, 20.0, -9.0)
    add3(&gas, 24.0, 15.0, -9.0)
    add3(&gas, 24.0, 10.0, -9.0)
    add3(&gas, 24.0, 3.0, -9.0)
    curve.curve_build(&gas)
    var red: curve.Curve = curve.curve_new()
    add3(&red, -43.0, 9.8, 24.0)
    add3(&red, -34.0, 13.0, 21.0)
    add3(&red, -20.0, 18.0, 14.0)
    add3(&red, -8.0, 23.0, 7.0)
    add3(&red, 0.0, 26.4, 2.4)
    add3(&red, 2.4, 26.2, 0.4)
    curve.curve_build(&red)
    var black: curve.Curve = curve.curve_new()
    add3(&black, -40.0, 9.8, 24.0)
    add3(&black, -32.0, 12.0, 20.5)
    add3(&black, -18.0, 17.0, 14.0)
    add3(&black, -5.0, 24.0, 6.0)
    add3(&black, 0.0, 26.1, 0.3)
    curve.curve_build(&black)
    var probe_in: curve.Curve = curve.curve_new()
    add3(&probe_in, -17.0, 3.2, 5.5)
    add3(&probe_in, -20.0, 2.0, 14.0)
    add3(&probe_in, -24.0, 1.0, 24.0)
    add3(&probe_in, -27.5, 1.2, 29.5)
    curve.curve_build(&probe_in)
    var probe_out: curve.Curve = curve.curve_new()
    add3(&probe_out, 22.0, 19.8, 4.0)
    add3(&probe_out, 23.0, 10.0, 12.0)
    add3(&probe_out, 16.0, 2.0, 35.0)
    add3(&probe_out, -4.0, 1.2, 36.0)
    add3(&probe_out, -22.0, 1.2, 33.0)
    add3(&probe_out, -26.0, 1.2, 31.0)
    curve.curve_build(&probe_out)
    return Hoses { inflow: inflow, outflow: outflow, gas: gas, red: red, black: black, probe_in: probe_in, probe_out: probe_out }
}

fn hoses_free(h: *mut Hoses) {
    curve.curve_free(&(*h).inflow)
    curve.curve_free(&(*h).outflow)
    curve.curve_free(&(*h).gas)
    curve.curve_free(&(*h).red)
    curve.curve_free(&(*h).black)
    curve.curve_free(&(*h).probe_in)
    curve.curve_free(&(*h).probe_out)
}
