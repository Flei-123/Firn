import std.math
import std.io
import scene3d.vec3

export {
    DURATION, FPS, POWER_ON, T_IN, VOLT, AMP, P_GAS_FACTOR, FLOW,
    PART_COUNT, part_start, part_progress, ramp, power_level, t_aus, delta_t, p_in, p_gas, p_heat, p_out, surplus,
    title_alpha, final_alpha, heater_glow, hud_alpha, label_alpha, fmt_comma,
}

const DURATION: f64 = 48.0
const FPS: f64 = 25.0
const POWER_ON: f64 = 26.5
const T_IN: f64 = 18.0
const VOLT: f64 = 3.2
const AMP: f64 = 0.5
const P_GAS_FACTOR: f64 = 1.54
const FLOW: f64 = 0.2
const PART_COUNT: i32 = 18

fn part_start(i: i32) -> f64 {
    if i == 0 { return 3.0 }
    if i == 1 { return 4.0 }
    if i == 2 { return 5.0 }
    if i == 3 { return 6.2 }
    if i == 4 { return 7.3 }
    if i == 5 { return 8.4 }
    if i == 6 { return 9.5 }
    if i == 7 { return 10.6 }
    if i == 8 { return 14.2 }
    if i == 9 { return 15.4 }
    if i == 10 { return 16.6 }
    if i == 11 { return 17.8 }
    if i == 12 { return 19.0 }
    if i == 13 { return 20.2 }
    if i == 14 { return 21.4 }
    if i == 15 { return 22.6 }
    if i == 16 { return 23.8 }
    return 25.0
}

fn ramp(t: f64, a: f64, b: f64) -> f64 {
    if b <= a { if t >= b { return 1.0 } return 0.0 }
    return vec3.clamp01((t - a) / (b - a))
}

fn part_progress(i: i32, t: f64) -> f64 {
    let s: f64 = part_start(i)
    return vec3.smootherstep(ramp(t, s, s + 1.0))
}

fn label_alpha(i: i32, t: f64) -> f64 {
    let s: f64 = part_start(i) + 0.55
    let a: f64 = ramp(t, s, s + 0.4)
    let b: f64 = 1.0 - ramp(t, s + 3.6, s + 4.1)
    return a * b
}

fn power_level(t: f64) -> f64 {
    return vec3.smoothstep(ramp(t, POWER_ON, POWER_ON + 0.6))
}

fn delta_t(t: f64) -> f64 {
    if t < POWER_ON { return 0.0 }
    let x: f64 = (t - POWER_ON) / 3.4
    return 1.0 - math.exp(0.0 - x)
}

fn t_aus(t: f64) -> f64 {
    return T_IN + delta_t(t) * 1.0
}

fn p_in(t: f64) -> f64 {
    return VOLT * AMP * power_level(t)
}

fn p_gas(t: f64) -> f64 {
    return P_GAS_FACTOR * AMP * power_level(t)
}

fn p_heat(t: f64) -> f64 {
    return p_in(t) - p_gas(t)
}

fn p_out(t: f64) -> f64 {
    return FLOW * 4.18 * (t_aus(t) - T_IN) * power_level(t)
}

fn surplus(t: f64) -> f64 {
    return p_out(t) - p_heat(t)
}

fn title_alpha(t: f64) -> f64 {
    return 1.0 - ramp(t, 2.2, 3.4)
}

fn final_alpha(t: f64) -> f64 {
    return ramp(t, 41.5, 42.7)
}

fn hud_alpha(t: f64) -> f64 {
    return ramp(t, POWER_ON + 2.0, POWER_ON + 3.0)
}

fn heater_glow(t: f64) -> f64 {
    let g: f64 = ramp(t, 42.0, 43.5)
    return g * (0.8 + 0.2 * math.sin(t * 5.0))
}

fn fmt_comma(x: f64, dec: i32) -> str {
    var v: f64 = x
    var neg: bool = false
    if v < 0.0 { neg = true; v = 0.0 - v }
    var scale: i64 = 1
    for i in 0..dec { scale = scale * 10 }
    let n: i64 = (v * (scale as f64) + 0.5) as i64
    let whole: i64 = n / scale
    let frac: i64 = n - whole * scale
    var s: str = io.fmt_string(f"{whole}")
    if dec > 0 {
        var z: str = ""
        var lim: i64 = scale / 10
        while lim > 1 && frac < lim {
            z = z + "0"
            lim = lim / 10
        }
        if frac == 0 {
            var zz: str = ""
            for k in 0..dec { zz = zz + "0" }
            s = s + "," + zz
        } else {
            s = s + "," + z + io.fmt_string(f"{frac}")
        }
    }
    if neg && n != 0 { s = "-" + s }
    return s
}
