import scene3d.vec3
import scene3d.mesh
import scene3d.geom
import scene3d.material
import scene3d.scene
import util
import demo
import screens

export { build_psu, build_logger, build_laptop }

const HALF_PI: f64 = 1.5707963267948966

fn build_psu(d: *mut demo.Demo) {
    let sc: *mut scene.Scene = &(*d).sc
    let g: i32 = (*d).grp[14]
    let body: i32 = util.solid(sc, 0x4a525e, 0.3, 0.55)
    let panel: i32 = util.solid(sc, 0x2a2f38, 0.2, 0.6)
    let knob: i32 = util.solid(sc, 0xc9ccd2, 0.8, 0.3)
    let red: i32 = util.solid(sc, 0xd01818, 0.2, 0.4)
    let blk: i32 = util.solid(sc, 0x14161a, 0.2, 0.4)
    (*d).tex_psu = scene.scene_add_texture(sc, screens.PSU_W, screens.PSU_H)
    let tm: i32 = scene.scene_add_material(sc, material.mat_textured((*d).tex_psu))
    util.put(sc, g, geom.geom_box(16.0, 9.0, 14.0), body, -46.0, 4.5, 20.0)
    util.put(sc, g, geom.geom_box(15.0, 7.5, 0.3), panel, -46.0, 4.4, 27.1)
    util.put_rot(sc, g, geom.geom_plane(9.0, 4.5, 1, 1), tm, -46.0, 5.9, 27.3, HALF_PI, 0.0, 0.0)
    util.put_rot(sc, g, geom.geom_cylinder(1.2, 1.2, 1.0, 20, false), knob, -50.0, 2.2, 27.5, HALF_PI, 0.0, 0.0)
    util.put_rot(sc, g, geom.geom_cylinder(1.2, 1.2, 1.0, 20, false), knob, -42.0, 2.2, 27.5, HALF_PI, 0.0, 0.0)
    util.put(sc, g, geom.geom_cylinder(0.6, 0.6, 0.8, 12, false), red, -43.0, 9.4, 24.0)
    util.put(sc, g, geom.geom_cylinder(0.6, 0.6, 0.8, 12, false), blk, -40.0, 9.4, 24.0)
}

fn build_logger(d: *mut demo.Demo) {
    let sc: *mut scene.Scene = &(*d).sc
    let g: i32 = (*d).grp[16]
    let pcb: i32 = util.solid(sc, 0x0f6b32, 0.1, 0.5)
    let chip: i32 = util.solid(sc, 0x16181c, 0.2, 0.4)
    let pin: i32 = util.solid(sc, 0xd0b060, 0.9, 0.3)
    let yel: i32 = util.solid(sc, 0xffd21a, 0.0, 0.5)
    (*d).mat_led = scene.scene_add_material(sc, material.mat_emissive(util.hex(0x30ff60), 1.2))
    util.put(sc, g, geom.geom_box(14.0, 0.8, 9.0), pcb, -28.0, 0.4, 30.0)
    util.put(sc, g, geom.geom_box(3.6, 0.7, 3.6), chip, -30.5, 1.15, 29.0)
    util.put(sc, g, geom.geom_box(2.4, 0.6, 2.4), chip, -25.5, 1.1, 31.5)
    util.put(sc, g, geom.geom_box(1.6, 0.8, 4.0), yel, -33.5, 1.2, 30.0)
    util.put(sc, g, geom.geom_box(1.6, 0.8, 4.0), yel, -33.5, 1.2, 33.0)
    util.put(sc, g, geom.geom_box(6.0, 0.4, 0.5), pin, -28.0, 1.0, 26.6)
    util.put(sc, g, geom.geom_box(0.8, 0.5, 0.8), (*d).mat_led, -22.5, 1.1, 27.5)
}

fn build_laptop(d: *mut demo.Demo) {
    let sc: *mut scene.Scene = &(*d).sc
    let g: i32 = (*d).grp[17]
    let shell: i32 = util.solid(sc, 0x9aa1ab, 0.7, 0.35)
    let keys: i32 = util.solid(sc, 0x20242c, 0.2, 0.6)
    (*d).tex_lap = scene.scene_add_texture(sc, screens.LAP_W, screens.LAP_H)
    let tm: i32 = scene.scene_add_material(sc, material.mat_textured((*d).tex_lap))
    util.put(sc, g, geom.geom_box(22.0, 1.2, 15.0), shell, -8.0, 0.6, 24.0)
    util.put(sc, g, geom.geom_box(18.0, 0.2, 7.0), keys, -8.0, 1.25, 26.0)
    let hinge: i32 = util.child_group(sc, g, -8.0, 1.2, 17.0)
    scene.node_set_euler(scene.scene_node(sc, hinge), 0.0 - 0.26, 0.0, 0.0)
    util.put(sc, hinge, geom.geom_box(22.0, 14.0, 0.6), shell, 0.0, 7.0, 0.0)
    util.put_rot(sc, hinge, geom.geom_plane(20.5, 12.8, 1, 1), tm, 0.0, 7.1, 0.33, HALF_PI, 0.0, 0.0)
}
