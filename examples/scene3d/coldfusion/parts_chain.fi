import scene3d.vec3
import scene3d.mesh
import scene3d.geom
import scene3d.curve
import scene3d.material
import scene3d.scene
import util
import demo

export { build_counter, build_pump, build_hoses, build_probes, build_scale }

fn build_counter(d: *mut demo.Demo) {
    let sc: *mut scene.Scene = &(*d).sc
    let g: i32 = (*d).grp[9]
    let gl: i32 = util.glass(sc, 0xe6f2ff, 0.2)
    let wm: i32 = scene.scene_add_material(sc, material.mat_with_opacity(material.mat_glass(util.hex(0x4aa0e8), 0.4), 0.45))
    let cap: i32 = util.solid(sc, 0x2a2e36, 0.1, 0.7)
    util.put(sc, g, geom.geom_cylinder(3.2, 3.2, 11.0, 32, true), gl, 24.0, 5.5, -9.0)
    util.put(sc, g, geom.geom_cylinder(3.0, 3.0, 6.0, 32, false), wm, 24.0, 3.3, -9.0)
    util.put(sc, g, geom.geom_cylinder(3.4, 3.4, 1.2, 32, false), cap, 24.0, 11.4, -9.0)
}

fn build_pump(d: *mut demo.Demo) {
    let sc: *mut scene.Scene = &(*d).sc
    let g: i32 = (*d).grp[10]
    let body: i32 = util.solid(sc, 0x3b6ea8, 0.2, 0.5)
    let dark: i32 = util.solid(sc, 0x20242c, 0.3, 0.5)
    let gl: i32 = util.glass(sc, 0xe6f2ff, 0.2)
    let wm: i32 = scene.scene_add_material(sc, material.mat_with_opacity(material.mat_glass(util.hex(0x2a74e0), 0.4), 0.45))
    util.put(sc, g, geom.geom_box(8.0, 7.0, 8.0), body, -27.0, 3.5, 3.0)
    util.put(sc, g, geom.geom_cylinder(2.2, 2.2, 3.0, 24, false), dark, -27.0, 8.5, 3.0)
    util.put(sc, g, geom.geom_cylinder(6.0, 6.0, 14.0, 40, true), gl, -38.0, 7.0, -6.0)
    util.put(sc, g, geom.geom_cylinder(6.0, 6.0, 0.4, 40, false), gl, -38.0, 0.2, -6.0)
    util.put(sc, g, geom.geom_cylinder(5.8, 5.8, 11.0, 40, false), wm, -38.0, 5.7, -6.0)
}

fn hose_mat(sc: *mut scene.Scene, c: u32, o: f64) -> i32 {
    return scene.scene_add_material(sc, material.mat_with_opacity(material.mat_glass(util.hex(c), o), o))
}

fn build_hoses(d: *mut demo.Demo) {
    let sc: *mut scene.Scene = &(*d).sc
    let clear: i32 = hose_mat(sc, 0xcfe0ee, 0.35)
    util.put(sc, (*d).grp[11], geom.geom_tube(&(*d).hs.inflow, 0.62, 90, 10, true), clear, 0.0, 0.0, 0.0)
    util.put(sc, (*d).grp[11], geom.geom_tube(&(*d).hs.outflow, 0.62, 90, 10, true), clear, 0.0, 0.0, 0.0)
    util.put(sc, (*d).grp[8], geom.geom_tube(&(*d).hs.gas, 0.5, 90, 10, true), clear, 0.0, 0.0, 0.0)
    let red: i32 = util.solid(sc, 0xd01818, 0.0, 0.5)
    let blk: i32 = util.solid(sc, 0x14161a, 0.0, 0.5)
    util.put(sc, (*d).grp[15], geom.geom_tube(&(*d).hs.red, 0.28, 90, 8, true), red, 0.0, 0.0, 0.0)
    util.put(sc, (*d).grp[15], geom.geom_tube(&(*d).hs.black, 0.28, 90, 8, true), blk, 0.0, 0.0, 0.0)
}

fn build_probes(d: *mut demo.Demo) {
    let sc: *mut scene.Scene = &(*d).sc
    let g: i32 = (*d).grp[12]
    let yel: i32 = scene.scene_add_material(sc, material.mat_emissive(util.hex(0xffd21a), 0.35))
    let cyl: mesh.Mesh = geom.geom_cylinder(1.0, 1.0, 3.0, 20, false)
    let cid: i32 = scene.scene_add_mesh(sc, cyl)
    let a: vec3.V3 = curve.curve_point_at_len(&(*d).hs.inflow, 0.55 * curve.curve_length(&(*d).hs.inflow))
    let b: vec3.V3 = curve.curve_point_at_len(&(*d).hs.outflow, 0.5 * curve.curve_length(&(*d).hs.outflow))
    let n1: i32 = util.put_at(sc, g, cid, yel, a.x, a.y, a.z)
    let n2: i32 = util.put_at(sc, g, cid, yel, b.x, b.y, b.z)
    scene.node_set_euler(scene.scene_node(sc, n1), 0.0, 0.0, 1.5707963)
    scene.node_set_euler(scene.scene_node(sc, n2), 0.0, 0.0, 0.9)
    util.put(sc, g, geom.geom_tube(&(*d).hs.probe_in, 0.16, 70, 6, true), yel, 0.0, 0.0, 0.0)
    util.put(sc, g, geom.geom_tube(&(*d).hs.probe_out, 0.16, 70, 6, true), yel, 0.0, 0.0, 0.0)
}

fn build_scale(d: *mut demo.Demo) {
    let sc: *mut scene.Scene = &(*d).sc
    let g: i32 = (*d).grp[13]
    let gray: i32 = util.solid(sc, 0xc6cbd2, 0.3, 0.5)
    let gl: i32 = util.glass(sc, 0xeef6ff, 0.22)
    let wm: i32 = scene.scene_add_material(sc, material.mat_with_opacity(material.mat_glass(util.hex(0x2a74e0), 0.4), 0.55))
    let scr: i32 = scene.scene_add_material(sc, material.mat_emissive(util.hex(0x60ff90), 0.5))
    util.put(sc, g, geom.geom_box(15.0, 3.0, 15.0), gray, 30.0, 1.5, 8.0)
    util.put(sc, g, geom.geom_box(5.0, 1.0, 0.4), scr, 30.0, 1.6, 15.7)
    util.put(sc, g, geom.geom_cylinder(4.0, 4.0, 11.0, 32, true), gl, 30.0, 8.5, 8.0)
    util.put(sc, g, geom.geom_cylinder(4.0, 4.0, 0.3, 32, false), gl, 30.0, 3.15, 8.0)
    (*d).cup_water = util.put(sc, g, geom.geom_cylinder(3.8, 3.8, 1.0, 32, false), wm, 30.0, 3.4, 8.0)
}
