import std.math
import scene3d.vec3
import scene3d.geom
import scene3d.curve
import scene3d.material
import std.vec
import scene3d.scene
import scene3d.light
import util
import demo
import timeline

export { build_flow, build_bubbles, apply_flow, apply_bubbles, apply_parts, apply_dynamics, FLOW_N, BUBBLE_N }

const FLOW_N: i32 = 18
const BUBBLE_N: i32 = 46
const CATH_N: i32 = 20
const ANODE_N: i32 = 20
const BUB_LOW: f64 = 7.0
const BUB_H: f64 = 12.4

fn wrap(x: f64, period: f64) -> f64 {
    return x - math.floor(x / period) * period
}

fn fract(x: f64) -> f64 {
    return x - math.floor(x)
}

fn build_flow(d: *mut demo.Demo) {
    let sc: *mut scene.Scene = &(*d).sc
    let sph: i32 = scene.scene_add_mesh(sc, geom.geom_sphere(0.4, 12, 8))
    let blue: i32 = scene.scene_add_material(sc, material.mat_emissive(util.hex(0x2f8cff), 1.4))
    let orange: i32 = scene.scene_add_material(sc, material.mat_emissive(util.hex(0xff8a1f), 1.4))
    (*d).flow_in_first = scene.scene_node_count(sc)
    (*d).flow_in_count = FLOW_N
    var k: i32 = 0
    while k < FLOW_N {
        let id: i32 = util.put_at(sc, 0 - 1, sph, blue, 0.0, 0.0, 0.0)
        scene.node_set_visible(scene.scene_node(sc, id), false)
        k = k + 1
    }
    (*d).flow_out_first = scene.scene_node_count(sc)
    (*d).flow_out_count = FLOW_N
    k = 0
    while k < FLOW_N {
        let id: i32 = util.put_at(sc, 0 - 1, sph, orange, 0.0, 0.0, 0.0)
        scene.node_set_visible(scene.scene_node(sc, id), false)
        k = k + 1
    }
}

fn place_flow(d: *mut demo.Demo, first: i32, c: *mut curve.Curve, t: f64, speed: f64) {
    let sc: *mut scene.Scene = &(*d).sc
    let lv: f64 = timeline.power_level(t)
    let len: f64 = curve.curve_length(c)
    var k: i32 = 0
    while k < FLOW_N {
        let nd: *mut scene.Node = scene.scene_node(sc, first + k)
        let s: f64 = wrap((t - timeline.POWER_ON) * speed + (k as f64) * len / (FLOW_N as f64), len)
        let edge: f64 = vec3.clamp01(vec3.minf(s, len - s) / 2.5)
        let sz: f64 = edge * lv
        scene.node_set_visible(nd, sz > 0.02 && t > timeline.POWER_ON)
        scene.node_set_pos(nd, curve.curve_point_at_len(c, s))
        scene.node_set_scale(nd, vec3.v3(sz, sz, sz))
        k = k + 1
    }
}

fn apply_flow(d: *mut demo.Demo, t: f64) {
    place_flow(d, (*d).flow_in_first, &(*d).hs.inflow, t, 11.0)
    place_flow(d, (*d).flow_out_first, &(*d).hs.outflow, t, 11.0)
}

fn build_bubbles(d: *mut demo.Demo) {
    let sc: *mut scene.Scene = &(*d).sc
    let sph: i32 = scene.scene_add_mesh(sc, geom.geom_sphere(0.32, 10, 7))
    let bm: i32 = scene.scene_add_material(sc, material.mat_with_opacity(material.mat_glass(util.hex(0xf4fbff), 0.6), 0.7))
    (*d).bub_first = scene.scene_node_count(sc)
    (*d).bub_count = BUBBLE_N
    var k: i32 = 0
    while k < BUBBLE_N {
        let id: i32 = util.put_at(sc, 0 - 1, sph, bm, 0.0, 0.0, 0.0)
        scene.node_set_visible(scene.scene_node(sc, id), false)
        k = k + 1
    }
}

fn bubble_state(k: i32, tt: f64, h: *mut f64) -> f64 {
    let ph: f64 = fract((k as f64) * 0.618034)
    let sp: f64 = 3.2 + 2.6 * fract((k as f64) * 0.37 + 0.1)
    *h = wrap(tt * sp + ph * BUB_H, BUB_H)
    return ph
}

fn apply_bubbles(d: *mut demo.Demo, t: f64) {
    let sc: *mut scene.Scene = &(*d).sc
    let lv: f64 = timeline.power_level(t)
    let tt: f64 = t - timeline.POWER_ON
    var k: i32 = 0
    while k < BUBBLE_N {
        let nd: *mut scene.Node = scene.scene_node(sc, (*d).bub_first + k)
        var h: f64 = 0.0
        var ph: f64 = bubble_state(k, tt, &h)
        var x: f64 = 0.0
        var y: f64 = 0.0
        var z: f64 = 0.0
        var sz: f64 = 0.0
        var show: bool = tt > 0.0
        if k < CATH_N {
            let a: f64 = (k as f64) * 2.399 + tt * 0.7
            x = 0.55 * math.cos(a)
            z = 0.55 * math.sin(a)
            y = BUB_LOW + h
            sz = 0.45 + 0.75 * h / BUB_H
        } else if k < CATH_N + ANODE_N {
            let a: f64 = (k as f64) * 2.399 + tt * 0.5
            let r: f64 = 2.1 + 0.9 * ph
            x = r * math.cos(a)
            z = r * math.sin(a)
            y = BUB_LOW + h
            sz = 0.5 + 0.8 * h / BUB_H
        } else {
            let j: i32 = k - CATH_N - ANODE_N
            let hh: f64 = wrap(tt * 2.2 + (j as f64) * 0.37, 2.3)
            x = 24.0 + 0.8 * math.sin((j as f64) * 1.9 + tt)
            z = -9.0 + 0.8 * math.cos((j as f64) * 1.9 + tt)
            y = 3.2 + hh
            sz = 0.7
            show = tt > 1.5
        }
        sz = sz * lv
        scene.node_set_visible(nd, show && sz > 0.02)
        scene.node_set_pos(nd, vec3.v3(x, y, z))
        scene.node_set_scale(nd, vec3.v3(sz, sz, sz))
        k = k + 1
    }
}

fn fly_off(i: i32) -> vec3.V3 {
    if i == 0 { return vec3.v3(0.0, -30.0, 0.0) }
    if i == 10 { return vec3.v3(-30.0, 14.0, 0.0) }
    if i == 14 || i == 16 { return vec3.v3(0.0, 14.0, 40.0) }
    if i == 9 || i == 13 || i == 17 { return vec3.v3(30.0, 14.0, 0.0) }
    return vec3.v3(0.0, 34.0, 0.0)
}

fn apply_parts(d: *mut demo.Demo, t: f64) {
    var i: i32 = 0
    while i < demo.GROUPS {
        let p: f64 = timeline.part_progress(i, t)
        let nd: *mut scene.Node = scene.scene_node(&(*d).sc, (*d).grp[i as usize])
        scene.node_set_visible(nd, p > 0.002)
        scene.node_set_opacity(nd, p)
        scene.node_set_pos(nd, vec3.v3_scale(fly_off(i), 1.0 - p))
        i = i + 1
    }
}

fn apply_dynamics(d: *mut demo.Demo, t: f64) {
    let sc: *mut scene.Scene = &(*d).sc
    let g: f64 = timeline.heater_glow(t)
    let hm: *mut material.Material = scene.scene_material(sc, (*d).mat_heater)
    (*hm).emissive = vec3.v3(6.0 * g, 1.6 * g, 0.2 * g)
    let rm: *mut material.Material = scene.scene_material(sc, (*d).mat_ring)
    (*rm).emissive = vec3.v3(6.0 * g, 0.4 * g, 0.1 * g)
    let lm: *mut material.Material = scene.scene_material(sc, (*d).mat_led)
    (*lm).emissive = vec3.v3_scale(vec3.v3(0.2, 1.4, 0.3), 0.4 + 0.6 * vec3.absf(math.sin(t * 6.0)))
    var li: *mut light.Light = vec.vec_elem_ptr[light.Light](&(*sc).lights, (*d).light_heater as usize)
    (*li).intensity = 2.2 * g
    let hn: *mut scene.Node = scene.scene_node(sc, (*d).heater_halo)
    scene.node_set_visible(hn, g > 0.02)
    scene.node_set_opacity(hn, 0.55 * g)
    let cup: f64 = 0.05 + 4.2 * vec3.clamp01((t - timeline.POWER_ON) / 21.5) * timeline.power_level(t)
    let cn: *mut scene.Node = scene.scene_node(sc, (*d).cup_water)
    scene.node_set_scale(cn, vec3.v3(1.0, cup, 1.0))
    scene.node_set_pos(cn, vec3.v3(30.0, 3.3 + cup * 0.5, 8.0))
    scene.node_set_visible(cn, t > timeline.POWER_ON)
    let th: f64 = 14.0 + 1.6 * timeline.delta_t(t)
    let tn: *mut scene.Node = scene.scene_node(sc, (*d).thermo_col)
    scene.node_set_scale(tn, vec3.v3(1.0, th, 1.0))
    scene.node_set_pos(tn, vec3.v3(-3.2, 6.0 + th * 0.5, 1.8))
}
