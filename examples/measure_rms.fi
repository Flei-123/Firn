// expect_exit: 0
// examples/measure_rms.fi -- the classic measurement program: read a file of
// "name value" lines into an array of structs, compute the RMS, print a table.
// The C++ version needs fopen_s, fscanf, sqrt from <cmath> and printf; here
// every step is a method on a value, with no import.
struct Sample {
    name: str,
    value: f64,
}

fn load(path: str) -> Vec[Sample] {
    var samples: Vec[Sample] = Vec[Sample].new()
    let text: str = fs.read_text(path) catch ""
    let lines: Vec[str] = text.trim().split("\n")
    var i: usize = 0
    while i < lines.len() {
        let fields: Vec[str] = lines[i].trim().split(" ")
        if fields.len() == 2 {
            samples.push(Sample { name: fields[0], value: parse.to_f64(fields[1]) catch 0.0 })
        }
        i = i + 1
    }
    return samples
}

fn rms(samples: Vec[Sample]) -> f64 {
    var sum: f64 = 0.0
    var i: usize = 0
    while i < samples.len() {
        sum = sum + samples[i].value * samples[i].value
        i = i + 1
    }
    return (sum / samples.len() as f64).sqrt()
}

fn main() -> i32 {
    let path: str = "/tmp/firn_measure_rms.txt"
    fs.write_text(path, "ch1 3.0\nch2 4.0\nch3 0.0 \n\nbad\nch4 5.0\n") catch 0
    let samples: Vec[Sample] = load(path)
    println(f"{samples.len()} samples")
    var i: usize = 0
    while i < samples.len() {
        println(f"{samples[i].name.pad_right(6)}{samples[i].value:.2f}")
        i = i + 1
    }
    let r: f64 = rms(samples)
    println(f"RMS = {r:.3f}")
    fs.remove(path) catch false
    if r.round() != 4.0 { return 1 }
    return 0
}
