// SPDX-License-Identifier: MPL-2.0
// examples/codehub/web.fi -- THE CODEHUB PAGE IN A BROWSER. The page is
// examples/codehub/codehub.fi, the same file the native build paints;
// here lib/plat/web.fi (application mode) gives it a <canvas>, the
// pointer, the wheel and a clock.
//
//     firnc --opt-level=release-fast --target=wasm32-browser \
//         -o examples/codehub/site/codehub.wasm examples/codehub/web.fi
//
// examples/codehub/site/index.html loads it with demos/webdemo/firn.js and
// three faces: DejaVu Sans (main), DejaVu Sans Mono and DejaVu Sans Bold
// (data-fonts, lib/plat/web.fi web_font_extra slots 0 and 1).
//
// Pointer positions arrive in CSS pixels (application mode) and go to the
// page in device pixels. A finger that moves scrolls the page.
import std.rt
import plat.web
import fui.theme
import fui.render
import fui.painter
import codehub

static mut G_PG: u64 = 0
static mut G_NOW: i64 = 0
static mut G_TOUCH: bool = false
static mut G_TY: f64 = 0.0

fn page(w: *mut web.Web) -> *mut codehub.Page {
    if G_PG == 0 {
        let pg: *mut codehub.Page = codehub.page_new(web.web_theme(w),
            web.web_font(w))
        if pg as u64 == 0 {
            return pg
        }
        let ok: bool = codehub.page_theme(pg)
        G_PG = pg as u64
    }
    let pg2: *mut codehub.Page = G_PG as *mut codehub.Page
    // the painter is made anew with every new size: the faces go into
    // its slots again (cheap -- two stores)
    codehub.page_set_fonts(pg2, render.ctx_painter(web.web_ctx(w)),
        web.web_font_extra(w, 0), web.web_font_extra(w, 1))
    return pg2
}

fn paint(ud: u64, w: *mut web.Web) -> bool {
    let pg: *mut codehub.Page = page(w)
    if pg as u64 == 0 {
        return false
    }
    codehub.page_frame(pg, web.web_ctx(w), web.web_width(w),
        web.web_height(w), G_NOW)
    return true
}

fn scale(w: *mut web.Web) -> f64 {
    return (web.web_scale(w) as f64) / 1000.0
}

fn event(ud: u64, w: *mut web.Web, e: *mut web.WebEvent) -> bool {
    let pg: *mut codehub.Page = page(w)
    if pg as u64 == 0 {
        return false
    }
    let k: u32 = (*e).kind
    let s: f64 = scale(w)
    if k == web.WE_TICK {
        G_NOW = (*e).ms as i64
        return codehub.page_busy(pg, G_NOW)
    }
    if k == web.WE_RESIZE {
        return true
    }
    var ch: bool = false
    let x: f64 = (*e).x * s
    let y: f64 = (*e).y * s
    let touch: bool = ((*e).mods & web.MOD_TOUCH) != 0 as u32
    if k == web.WE_MOVE {
        if G_TOUCH && touch {
            ch = codehub.page_wheel(pg, G_TY - y)
            G_TY = y
        }
        ch = codehub.page_pointer(pg, codehub.PTR_MOVE, x, y, G_NOW) || ch
    } else if k == web.WE_DOWN {
        G_TOUCH = touch
        G_TY = y
        ch = codehub.page_pointer(pg, codehub.PTR_DOWN, x, y, G_NOW)
    } else if k == web.WE_UP {
        G_TOUCH = false
        ch = codehub.page_pointer(pg, codehub.PTR_UP, x, y, G_NOW)
    } else if k == web.WE_LEAVE {
        G_TOUCH = false
        ch = codehub.page_pointer(pg, codehub.PTR_LEAVE, x, y, G_NOW)
    } else if k == web.WE_WHEEL {
        ch = codehub.page_wheel(pg, (*e).dy * s)
    }
    if k == web.WE_MOVE || k == web.WE_LEAVE {
        if codehub.page_hover(pg) != codehub.HOT_N {
            web.web_cursor(web.CURSOR_POINTER)
        } else {
            web.web_cursor(web.CURSOR_DEFAULT)
        }
    }
    return ch
}

// THE STOPWATCH FOR THE BROWSER (tools: examples/codehub/check_web.cjs):
// `n` whole frames, painted and not shown -- the caller times the call
// with performance.now(). Returns the frames painted.
#[export_c]
fn codehub_bench(n: u32) -> u32 {
    let w: *mut web.Web = web.web_the()
    if w as u64 == 0 || G_PG == 0 {
        return 0 as u32
    }
    var i: u32 = 0 as u32
    while i < n {
        G_NOW = G_NOW + 16
        let p: bool = paint(0, w)
        i = i + 1 as u32
    }
    return n
}

// Where hot target `i` stands, in CSS pixels (for the browser test).
#[export_c]
fn codehub_hot_x(i: u32) -> f64 {
    var x: f64 = -1.0
    var y: f64 = -1.0
    if G_PG != 0 {
        let ok: bool = codehub.page_hot_centre(G_PG as *mut codehub.Page,
            i as usize, &x, &y)
    }
    return x / scale(web.web_the())
}

#[export_c]
fn codehub_hot_y(i: u32) -> f64 {
    var x: f64 = -1.0
    var y: f64 = -1.0
    if G_PG != 0 {
        let ok: bool = codehub.page_hot_centre(G_PG as *mut codehub.Page,
            i as usize, &x, &y)
    }
    return y / scale(web.web_the())
}

// The still cache off (0: every node painted every frame -- the worst case
// for the stopwatch) or on (1). Paints once, so the bakes are done before
// the caller starts timing.
#[export_c]
fn codehub_still(on: u32) -> u32 {
    let w: *mut web.Web = web.web_the()
    if w as u64 == 0 || G_PG == 0 {
        return 0 as u32
    }
    codehub.page_set_still_cache(G_PG as *mut codehub.Page, on != 0 as u32)
    let p: bool = paint(0, w)
    return 1 as u32
}

fn main() -> i32 {
    if !web.web_app(0, paint, event) {
        return 3
    }
    return 0
}
