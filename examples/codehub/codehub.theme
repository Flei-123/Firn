# codehub.theme -- black ground, red accent (examples/codehub).
# A bordered widget never has the fill of the ground it sits on (the fUi
# fill rule, tools/fui/themefile_main.fi): the button is a step lighter than
# the raised card, the focused field a step darker than the page.
name = CodeHub Dark
mode = dark
shape = osum
accent = #E11D2E
text_on_accent = #FFFFFF
base = #0E1014
surface = #15181D
surface_raised = #1B1F26
button = #222730
button_hover = #2A303A
button_active = #353C49
field = #111419
field_focus = #08090C
border = #2C323B
separator = #22272F
text = #F4F5F7
text_muted = #A9AFB9
text_disabled = #8A919C
error = #FF6B6B
warning = #F5C04A
success = #3DDC84
