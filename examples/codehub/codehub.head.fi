// SPDX-License-Identifier: MPL-2.0
// examples/codehub/codehub.fi -- A MODERN LANDING PAGE, PAINTED BY fUi.
//
// ================================================================ WHAT
//
// Justin, 29.09.2026: "can fUi/Firn do a page like the start page of a
// modern code platform?" -- black ground, a red accent, a header with logo,
// links and a sign-in, a two-line headline (white / red), a paragraph, a
// red and a dark button, a row of ticks, a terminal card with window dots
// and git output in a monospace face, red light in the background, a
// jagged mountain silhouette (SVG), and a bar of four figures at the foot.
// The name, the logo and every text of this page are its own ("CodeHub");
// nothing is copied from a real brand.
//
// ONE FILE, TWO PLATFORMS. This module knows no window and no browser: it
// gets a painter, a theme and a size and paints one frame
// (`page_frame`), and it hears the pointer and the wheel as numbers
// (`page_pointer`, `page_wheel`). examples/codehub/main.fi puts it into an
// X11 window (lib/plat/fuiwin.fi) or into a PNG; examples/codehub/web.fi
// puts it into a <canvas> (lib/plat/web.fi, application mode). The same
// lines paint both.
//
// ================================================================ HOW
//
// LAYOUT IS THE SCENE. Every frame the tree is described anew (scene_reset
// + about 70 nodes -- cheaper than finding out what changed) with the
// stylesheet of this frame, then fUi's four passes: style, measure, lay
// out, draw. Flexbox does the columns, the centring and the wrapping of
// the tick row and of the four tiles on a phone.
//
// RESPONSIVE. Below 1000 design points of usable width the hero stacks
// (text over terminal), the header drops its two links, the tiles go
// two by two, and the headline takes the size at which "Made in Austria."
// fits the column (measured with the bold face -- the fluid type a CSS page
// writes as clamp()). The paragraph and the terminal lines are wrapped by
// fUi's own line breaker (painter.run_line_count / run_draw_wrapped); the
// page only asks how many lines they need at this width.
//
// THREE FACES. The theme's font, a monospace one (slot 1) for the terminal
// and a bold one (slot 2) for headline, buttons and figures -- chosen by
// the style's font_id (style.style_set_font(s, id, px), painter font
// slots, lib/fui/render.fi font_enter). A missing face falls back to the
// main font (bold then comes out synthetic).
//
// THE BACKGROUND IS BAKED. Red light (effect.glow_ground, dithered), a
// faint grid, the mountains (SVG, lib/svg through fui/uisvg), and the two
// glass panels (card, figures: effect.glass_area over what lies below,
// effect.rrect_shadow under them) are painted once per size into a canvas
// of their own; a frame copies the visible band of it and paints only
// what can change on top: texts, buttons, hover. That is what keeps a
// 1996 x 1211 frame inside 16 ms on one core.
//
// MOTION. The hero fades in and rises (staggered, ease-out), the terminal
// types itself, and every button, link and tile answers the pointer on a
// spring (anim.easing_spring): the red button glows up, the dark one gets
// a red rim, a link grows its underline, a tile lights. Nothing moves when
// nothing happens -- `page_busy` says when the host may sleep.
import std.rt
import paint.canvas
import fui.theme
import fui.style
import fui.widget
import fui.painter
import fui.render
import fui.flex
import fui.sheet
import fui.scene
import fui.effect
import fui.uisvg
import fui.uiimage
import fui.anim
import fui.themefile

export {
    Page, page_size, page_new, page_theme, page_theme_error, page_set_fonts,
    page_frame, page_pointer, page_wheel, page_busy, page_height,
    page_scroll, page_set_scroll, page_bakes, page_hover, page_hot_centre, page_check,
    PTR_MOVE, PTR_LEAVE, PTR_DOWN, PTR_UP,
    FONT_MONO, FONT_BOLD, HOT_N,
}

// pointer kinds of page_pointer
const PTR_MOVE: u32 = 1
const PTR_LEAVE: u32 = 2
const PTR_DOWN: u32 = 3
const PTR_UP: u32 = 4

const FONT_MONO: usize = 1
const FONT_BOLD: usize = 2

// ---------------------------------------------------------------- colours
const C_RED: u32 = 0xE11D2E // #E11D2E -- the button, the accent
const C_RED_HI: u32 = 0xF2414B // #F2414B -- red TEXT on black
const C_WHITE: u32 = 0xF4F5F7 // #F4F5F7
const C_MUTED: u32 = 0xA9AFB9 // #A9AFB9
const C_DIM: u32 = 0x8B93A2 // #8B93A2 -- terminal output
const C_GREEN: u32 = 0x3DDC84 // #3DDC84
const C_BASE: u32 = 0x0E1014 // #0E1014
const C_PILL_T: u32 = 0xD6D9DE // #D6D9DE

// ------------------------------------------------------------ hot targets
const HOT_N: usize = 10
const H_LINK1: usize = 0
const H_LINK2: usize = 1
const H_LOGIN: usize = 2
const H_BTN1: usize = 3
const H_BTN2: usize = 4
const H_TILE0: usize = 5 // .. 8
const H_LOGO: usize = 9

// ---------------------------------------------------------- style classes
// Plain numbers: a class is compared, never printed.
const K_BRAND: u32 = 101
const K_LINK: u32 = 102
const K_LOGIN: u32 = 103
const K_PILL: u32 = 104
const K_H1: u32 = 105
const K_H1R: u32 = 106
const K_SUB: u32 = 107
const K_BTN: u32 = 108
const K_TICK: u32 = 109
const K_CHECK: u32 = 110
const K_TTITLE: u32 = 111
const K_TPROMPT: u32 = 112
const K_TCMD: u32 = 113
const K_TOUT: u32 = 114
const K_TOK: u32 = 115
const K_STATV: u32 = 116
const K_STATC: u32 = 117

const LINES_T: usize = 7 // terminal lines
const TYPE_START: i64 = 700 // ms after the start: the terminal begins
const TYPE_MS: i64 = 22 // one typed character
const INTRO_MS: i64 = 900
