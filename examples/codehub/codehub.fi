// ================================================================ THE PAGE
struct Page {
    sc: scene.Scene,
    sh: sheet.Sheet,
    m: u64, // *mut theme.Theme, the host's
    fm: u64,
    fm_mono: u64,
    fm_bold: u64,
    logo: uisvg.Icon,
    hills: uisvg.Icon,
    login: uisvg.Icon,
    tf: themefile.ThemeFile,
    theme_ok: bool,
    // the baked background (see the head of this file): fUi's layer.Bake
    bk: layer.Bake,
    rest: bool, // the still content (scene_draw_still) is baked in as well
    rests: usize,
    no_rest: bool, // page_set_still_cache(false): always paint everything
    // what can be pointed at
    hot: [usize; 10],
    ha: [anim.Animation; 10],
    hto: [f64; 10],
    pressed: usize,
    px: f64,
    py: f64,
    inside: bool,
    // time, scroll, size
    t0: i64,
    started: bool,
    now: i64,
    scroll: f64,
    sa: anim.Animation,
    sa_on: bool,
    page_h: f64,
    view_h: f64,
    s: f64,
    // nodes the painters need
    card: usize,
    panel: usize,
    cursor_node: usize,
    mono_px: f64,
    lp: [u64; 7],
    ln: [usize; 7],
    lk: [u32; 7],
}

fn page_blank() -> Page {
    return Page {
        sc: scene.scene_new(), sh: sheet.sheet_new(), m: 0, fm: 0,
        fm_mono: 0, fm_bold: 0,
        logo: uisvg.icon_new(), hills: uisvg.icon_new(),
        login: uisvg.icon_new(), tf: themefile.themefile_new(),
        theme_ok: false,
        bk: layer.bake_new(), rest: false, rests: 0, no_rest: false,
        hot: [scene.SCENE_NONE; 10],
        ha: [anim.anim_new(0, 1, 0.0, 0.0, anim.easing_linear()); 10],
        hto: [0.0; 10], pressed: HOT_N, px: 0.0, py: 0.0, inside: false,
        t0: 0, started: false, now: 0, scroll: 0.0,
        sa: anim.anim_new(0, 1, 0.0, 0.0, anim.easing_linear()), sa_on: false,
        page_h: 0.0, view_h: 0.0, s: 1.0,
        card: scene.SCENE_NONE, panel: scene.SCENE_NONE,
        cursor_node: scene.SCENE_NONE, mono_px: 14.0,
        lp: [0 as u64; 7], ln: [0; 7], lk: [0 as u32; 7],
    }
}

// How big a Page is -- measured, as lib/plat/web.fi measures its Web.
fn page_size() -> usize {
    var probe: [Page; 2] = [page_blank(); 2]
    return ((&probe[1]) as usize) - ((&probe[0]) as usize)
}

// A page on the heap. `m` is the host's theme (its scale is the device
// ratio), `fm` the main font set. 0 when there is no memory.
fn page_new(m: *mut theme.Theme, fm: u64) -> *mut Page {
    let p: u64 = rt.heap_alloc(page_size())
    if p == 0 {
        return (0 as u64) as *mut Page
    }
    let pg: *mut Page = p as *mut Page
    *pg = page_blank()
    (*pg).m = m as u64
    (*pg).fm = fm
    return pg
}

// THE THEME: examples/codehub/codehub.theme, compiled in, read by
// lib/fui/themefile.fi -- checked for contrast before it is applied. The
// scale of the host's theme survives (the file starts from a built-in set).
fn page_theme(pg: *mut Page) -> bool {
    let m: *mut theme.Theme = (*pg).m as *mut theme.Theme
    let k: usize = theme.theme_scale(m)
    (*pg).theme_ok = themefile.themefile_apply(m, (&THEME_TXT[0]) as u64,
        THEME_TXT_N, &(*pg).tf)
    theme.theme_set_scale(m, k)
    return (*pg).theme_ok
}

// Why the theme file was refused (themefile.ERR_*), 0 = applied.
fn page_theme_error(pg: *mut Page) -> u32 {
    return themefile.themefile_err(&(*pg).tf)
}

// The monospace and the bold face (0 = none), into the painter's slots.
fn page_set_fonts(pg: *mut Page, z: *mut painter.Painter, mono: u64,
    bold: u64) {
    (*pg).fm_mono = mono
    (*pg).fm_bold = bold
    painter.painter_set_font_slot(z, FONT_MONO, mono)
    painter.painter_set_font_slot(z, FONT_BOLD, bold)
}

fn page_height(pg: *mut Page) -> f64 { return (*pg).page_h }
fn page_scroll(pg: *mut Page) -> f64 { return (*pg).scroll }
fn page_bakes(pg: *mut Page) -> usize { return layer.bake_count(&(*pg).bk) }
fn page_set_scroll(pg: *mut Page, y: f64) {
    (*pg).scroll = y
    (*pg).sa_on = false
}

// ================================================================ HELPERS
fn fmin(a: f64, b: f64) -> f64 {
    if a < b {
        return a
    }
    return b
}

fn fmax(a: f64, b: f64) -> f64 {
    if a > b {
        return a
    }
    return b
}

fn ffloor(v: f64) -> f64 {
    let t: f64 = (v as i64) as f64
    if t > v {
        return t - 1.0
    }
    return t
}

fn ease_out(t: f64) -> f64 {
    let u: f64 = 1.0 - t
    return 1.0 - u * u * u
}

// The intro of one group: 0 before `delay`, 1 after INTRO_MS more.
fn intro(pg: *mut Page, delay: i64) -> f64 {
    let t: i64 = (*pg).now - (*pg).t0 - delay
    if t <= 0 {
        return 0.0
    }
    if t >= INTRO_MS {
        return 1.0
    }
    return ease_out((t as f64) / (INTRO_MS as f64))
}

// Two colours mixed (straight sRGB), opaque. anim.mix_srgb weighs the
// channels by alpha, so both go in opaque and the alpha comes off again.
fn mixc(a: u32, b: u32, t: f64) -> u32 {
    return anim.mix_srgb(theme.opaque(a), theme.opaque(b), t)
    &16777215 as u32
}

fn argb(a: f64, rgb: u32) -> u32 {
    var k: f64 = a
    if k < 0.0 {
        k = 0.0
    }
    if k > 1.0 {
        k = 1.0
    }
    var ai: u32 = (k * 255.0 + 0.5) as u32
    if ai == 0 as u32 {
        ai = 1 as u32 // alpha 0 would mean "opaque" to the painter
    }
    return (ai << 24) | (rgb & 16777215 as u32)
}

// ud of a painter: the page, and in the top octet which hot target.
fn pack(pg: *mut Page, i: usize) -> u64 {
    return (pg as u64) | ((i as u64) << 56)
}

fn unpack_page(ud: u64) -> *mut Page {
    return (ud & 72057594037927935) as *mut Page
}

fn unpack_i(ud: u64) -> usize {
    return (ud >> 56) as usize
}

// The width of a text in DEVICE pixels, in face `fid` (0 = main).
fn text_w(pg: *mut Page, z: *mut painter.Painter, fid: usize, px: f64,
    p: u64, n: usize) -> f64 {
    let old: u64 = painter.painter_font(z)
    let f: u64 = painter.painter_font_slot(z, fid)
    if f != 0 {
        painter.painter_set_font(z, f)
    }
    var r: painter.TextRun = painter.run_new(px)
    if fid == FONT_BOLD && f == 0 {
        r = painter.run_set_weight(r, 700)
    }
    let w: f64 = painter.run_width(z, &r, p, n)
    painter.painter_set_font(z, old)
    return w
}

fn hover_of(pg: *mut Page, i: usize) -> f64 {
    return anim.anim_value(&(*pg).ha[i], (*pg).now)
}

// ================================================================ STYLES
fn rule(sh: *mut sheet.Sheet, k: u32, fid: usize, px: usize, fg: u32,
    bold: bool, fake_bold: bool, align: u32, lh: usize) {
    var st: style.Style = style.style_new()
    st = style.style_set_font(st, fid, px)
    st = style.style_set_fg(st, style.color_literal(fg))
    if bold && fake_bold {
        st = style.style_set_weight(st, style.WEIGHT_BOLD)
    }
    st = style.style_set_align(st, align)
    st = style.style_set_pad(st, 0, 0)
    if lh != 0 {
        st = style.style_set_line_height_px(st, lh)
    }
    sheet.sheet_rule(sh, sheet.sel_class(k), st)
}

// The headline: bold, a FLUID size (clamp(26, base + k vw, max)), tight
// lines and letters pulled together a little -- both follow `h1`, the size
// the view gives today.
fn rule_fluid(sh: *mut sheet.Sheet, k: u32, fg: u32, fake_bold: bool,
    h1: f64, base: i64, vw_pm: usize, max: f64) {
    var st: style.Style = style.style_new()
    st = style.style_set_font(st, FONT_BOLD, max as usize)
    st = style.style_set_font_fluid(st, 26, base, vw_pm, max as usize)
    st = style.style_set_fg(st, style.color_literal(fg))
    if fake_bold {
        st = style.style_set_weight(st, style.WEIGHT_BOLD)
    }
    st = style.style_set_pad(st, 0, 0)
    st = style.style_set_line_height_px(st, (h1 * 1.1) as usize)
    st = style.style_set_tracking(st, 0 - ((h1 / 30.0) as i64))
    sheet.sheet_rule(sh, sheet.sel_class(k), st)
}

// A headline: bold, tight lines, letters pulled together a little.
fn rule_track(sh: *mut sheet.Sheet, k: u32, fid: usize, px: usize, fg: u32,
    fake_bold: bool, lh: usize, track: i64) {
    var st: style.Style = style.style_new()
    st = style.style_set_font(st, fid, px)
    st = style.style_set_fg(st, style.color_literal(fg))
    if fake_bold {
        st = style.style_set_weight(st, style.WEIGHT_BOLD)
    }
    st = style.style_set_pad(st, 0, 0)
    st = style.style_set_line_height_px(st, lh)
    st = style.style_set_tracking(st, track)
    sheet.sheet_rule(sh, sheet.sel_class(k), st)
}

// ================================================================ THE TREE
fn add_text(sc: *mut scene.Scene, parent: usize, k: u32, p: u64,
    n: usize) -> usize {
    let t: usize = scene.scene_add(sc, parent, scene.N_TEXT)
    scene.node_add_class(sc, t, k)
    scene.node_set_text(sc, t, p, n)
    return t
}

fn add_box(sc: *mut scene.Scene, parent: usize, dir: u32, justify: u32,
    al: u32) -> usize {
    let b: usize = scene.scene_add(sc, parent, scene.N_BOX)
    scene.node_set_flex(sc, b, dir, justify, al)
    return b
}

fn add_space(sc: *mut scene.Scene, parent: usize, h: f64) {
    let b: usize = scene.scene_add(sc, parent, scene.N_BOX)
    scene.node_set_size(sc, b, 1.0, h)
}

// THE INTRO OF A GROUP: fUi fades the whole subtree as one picture
// (scene.node_set_opacity) and lets it rise into its place
// (scene.node_set_offset) -- nothing around it moves.
fn rise_in(sc: *mut scene.Scene, i: usize, p: f64) {
    scene.node_set_opacity(sc, i, p)
    scene.node_set_offset(sc, i, 0.0, (1.0 - p) * 26.0)
}

// A button's face as a style: surface, radius, and a glow under it
// (style.SF_BOX_SHADOW) -- the hover spring changes the numbers.
fn rule_btn(sh: *mut sheet.Sheet, k: u32, bg: u32, rim: u32, glow: f64,
    hv: f64) {
    var st: style.Style = style.style_new()
    st = style.style_set_bg(st, style.color_literal(bg))
    st = style.style_set_radius(st, 10)
    st = style.style_set_pad(st, 0, 0)
    if rim != 0 as u32 {
        st = style.style_set_border(st, style.color_literal(rim), 1)
    }
    if glow > 0.0 {
        st = style.style_set_box_shadow(st, (4.0 + 6.0 * hv) as i64,
            (12.0 + 18.0 * hv) as usize, style.color_literal(C_RED),
            ((0.30 + 0.35 * hv) * 255.0) as usize)
    }
    sheet.sheet_rule(sh, sheet.sel_class(k), st)
}

// When the terminal shows how much of line `i` (octets). Commands are
// typed, output arrives a line at a time.
fn typed(pg: *mut Page, i: usize) -> usize {
    let t: i64 = (*pg).now - (*pg).t0 - TYPE_START
    var at: i64 = 0
    var j: usize = 0
    while j < LINES_T {
        var dur: i64 = 140
        if (*pg).lk[j] == 0 as u32 {
            dur = ((*pg).ln[j] as i64) * TYPE_MS + 320
        }
        if j == i {
            if t < at {
                return 0
            }
            if (*pg).lk[j] == 0 as u32 {
                let k: i64 = (t - at) / TYPE_MS
                if k >= (*pg).ln[j] as i64 {
                    return (*pg).ln[j]
                }
                return k as usize
            }
            return (*pg).ln[j]
        }
        at = at + dur
        j = j + 1
    }
    return 0
}

fn type_end(pg: *mut Page) -> i64 {
    var at: i64 = TYPE_START
    var j: usize = 0
    while j < LINES_T {
        if (*pg).lk[j] == 0 as u32 {
            at = at + ((*pg).ln[j] as i64) * TYPE_MS + 320
        } else {
            at = at + 140
        }
        j = j + 1
    }
    return at
}

fn set_lines(pg: *mut Page) {
    (*pg).lp[0] = (&T_L0[0]) as u64
    (*pg).ln[0] = T_L0_N
    (*pg).lk[0] = 0 as u32
    (*pg).lp[1] = (&T_L1[0]) as u64
    (*pg).ln[1] = T_L1_N
    (*pg).lk[1] = 0 as u32
    (*pg).lp[2] = (&T_L2[0]) as u64
    (*pg).ln[2] = T_L2_N
    (*pg).lk[2] = 1 as u32
    (*pg).lp[3] = (&T_L3[0]) as u64
    (*pg).ln[3] = T_L3_N
    (*pg).lk[3] = 1 as u32
    (*pg).lp[4] = (&T_L4[0]) as u64
    (*pg).ln[4] = T_L4_N
    (*pg).lk[4] = 1 as u32
    (*pg).lp[5] = (&T_L5[0]) as u64
    (*pg).ln[5] = T_L5_N
    (*pg).lk[5] = 1 as u32
    (*pg).lp[6] = (&T_L6[0]) as u64
    (*pg).ln[6] = T_L6_N
    (*pg).lk[6] = 2 as u32
}

fn check_item(sc: *mut scene.Scene, parent: usize, p: u64, n: usize) {
    let it: usize = add_box(sc, parent, flex.FLEX_ROW, flex.JUSTIFY_START,
        flex.AL_CENTER)
    scene.node_set_gap(sc, it, 6, 0)
    let a: usize = add_text(sc, it, K_TICK, (&T_TICK[0]) as u64, T_TICK_N)
    let b: usize = add_text(sc, it, K_CHECK, p, n)
}

fn tile(pg: *mut Page, z: *mut painter.Painter, sc: *mut scene.Scene,
    parent: usize, i: usize, tw: f64, th: f64, vp: u64, vn: usize, cp: u64,
    cn: usize, narrow: bool) {
    let s: f64 = (*pg).s
    let t: usize = add_box(sc, parent, flex.FLEX_COLUMN, flex.JUSTIFY_CENTER,
        flex.AL_CENTER)
    scene.node_set_size(sc, t, tw, th)
    scene.node_set_padding(sc, t, 12, 0, 12, 0)
    scene.node_set_gap(sc, t, 4, 0)
    scene.node_set_draw(sc, t, pack(pg, H_TILE0 + i), draw_tile)
    (*pg).hot[H_TILE0 + i] = t
    let v: usize = add_text(sc, t, K_STATV, vp, vn)
    // a paragraph: fUi breaks it at the tile's inner width
    let c: usize = add_text(sc, t, K_STATC, cp, cn)
    scene.node_set_text_wrap(sc, c, 4)
}

// THE WHOLE PAGE, described for this width. `z` is only asked for widths.
fn describe(pg: *mut Page, z: *mut painter.Painter, w: usize) {
    let sc: *mut scene.Scene = &(*pg).sc
    let s: f64 = (*pg).s
    let css_w: f64 = (w as f64) / s
    var pad: f64 = 28.0
    if css_w < 700.0 {
        pad = 18.0
    }
    let avail: f64 = fmin(css_w - 2.0 * pad, 1200.0)
    let wide: bool = avail >= 1000.0
    let fake_bold: bool = (*pg).fm_bold == 0
    var k: usize = 0
    while k < HOT_N {
        (*pg).hot[k] = scene.SCENE_NONE
        k = k + 1
    }
    set_lines(pg)

    // ---- the measures of this width
    var left_w: f64 = avail
    var card_w: f64 = fmin(avail, 640.0)
    if wide {
        left_w = fmin(560.0, avail * 0.48)
        card_w = fmin(620.0, avail - left_w - 64.0)
    }
    // the headline: a FLUID size (style.style_set_font_fluid, CSS
    // clamp(min, base + k vw, max)) that keeps "Made in Austria." inside
    // its column. k comes from the face: how wide the line is at 100 px.
    let w100: f64 = text_w(pg, z, FONT_BOLD, 100.0 * s,
        (&T_H2[0]) as u64, T_H2_N) / s
    let fit: f64 = 97.0 / w100 // px of headline per px of column
    var h1max: f64 = 72.0
    var col_k: f64 = 1.0 // the column's width = col_k * (vw - 2 pad)
    if wide {
        h1max = fmin(72.0, ffloor(560.0 * fit))
        col_k = 0.48
    } else {
        h1max = 60.0
    }
    let vw_pm: usize = ffloor(fit * col_k * 1000.0) as usize
    let h1_base: i64 = 0 - ((2.0 * pad * fit * col_k) as i64) - 1
    scene.scene_set_view(sc, css_w)
    let h1: f64 = style.style_fluid_px_of(26, h1_base, vw_pm,
        h1max as usize, css_w as usize) as f64
    var sub_px: f64 = 19.0
    var sub_lh: f64 = 30.0
    var mono: f64 = 14.0
    var mono_lh: f64 = 23.0
    if !wide {
        sub_px = 16.0
        sub_lh = 25.0
        mono = 12.0
        mono_lh = 20.0
    }
    (*pg).mono_px = mono

    // ---- the stylesheet of this frame; the intro fades whole groups
    let p_pill: f64 = intro(pg, 0)
    let p_head: f64 = intro(pg, 90)
    let p_sub: f64 = intro(pg, 200)
    let p_btn: f64 = intro(pg, 310)
    let p_chk: f64 = intro(pg, 420)
    (*pg).sh = sheet.sheet_new()
    let sh: *mut sheet.Sheet = &(*pg).sh
    let L: u32 = style.ALIGN_LEFT
    let CE: u32 = style.ALIGN_CENTER
    rule(sh, K_BRAND, FONT_BOLD, 18, C_WHITE, true, fake_bold, L, 0)
    rule(sh, K_LINK, 0, 15, C_MUTED, false, false, L, 0)
    rule(sh, K_LOGIN, 0, 15, C_WHITE, false, false, L, 0)
    rule(sh, K_PILL, 0, 13, C_PILL_T, false, false, L, 0)
    rule_fluid(sh, K_H1, C_WHITE, fake_bold, h1, h1_base, vw_pm, h1max)
    rule_fluid(sh, K_H1R, C_RED_HI, fake_bold, h1, h1_base, vw_pm, h1max)
    rule(sh, K_SUB, 0, sub_px as usize, 12764876, false, false, L,
        sub_lh as usize)
    rule(sh, K_BTN, FONT_BOLD, 16, 16777215, true, fake_bold, CE, 0)
    rule(sh, K_TICK, 0, 14, C_RED_HI, false, false, L, 0)
    rule(sh, K_CHECK, 0, 14, C_MUTED, false, false, L, 0)
    // the two buttons: red with a glow that grows, dark with a rim that
    // turns red; pressed is darker
    let hv1: f64 = fmax(0.0, hover_of(pg, H_BTN1))
    var c1: u32 = mixc(C_RED, 16726860, fmin(hv1, 1.2) * 0.7)
    if (*pg).pressed == H_BTN1 && hv1 > 0.5 {
        c1 = mixc(c1, 10358556, 0.5)
    }
    rule_btn(sh, K_B1, c1, 0 as u32, 1.0, hv1)
    let hv2: f64 = fmin(fmax(0.0, hover_of(pg, H_BTN2)), 1.0)
    var c2: u32 = mixc(1448222, 2106669, hv2)
    if (*pg).pressed == H_BTN2 && hv2 > 0.5 {
        c2 = 1119256
    }
    rule_btn(sh, K_B2, c2, mixc(3817287, C_RED, hv2), 0.0, 0.0)
    rule(sh, K_TTITLE, 0, 12, 8028298, false, false, CE, 0)
    rule(sh, K_TPROMPT, FONT_MONO, mono as usize, C_RED_HI, false, false, L,
        mono_lh as usize)
    rule(sh, K_TCMD, FONT_MONO, mono as usize, C_WHITE, false, false, L,
        mono_lh as usize)
    rule(sh, K_TOUT, FONT_MONO, mono as usize, C_DIM, false, false, L,
        mono_lh as usize)
    rule(sh, K_TOK, FONT_MONO, mono as usize, C_GREEN, false, false, L,
        mono_lh as usize)
    var sv: usize = 30
    if !wide {
        sv = 24
    }
    rule(sh, K_STATV, FONT_BOLD, sv, C_RED_HI, true, fake_bold, CE, 0)
    var scap: usize = 13
    var scap_lh: usize = 18
    if !wide {
        scap = 12
        scap_lh = 16
    }
    rule(sh, K_STATC, 0, scap, C_MUTED, false, false, CE, scap_lh)

    // ---- the tree
    scene.scene_reset(sc)
    let root: usize = add_box(sc, scene.SCENE_NONE, flex.FLEX_COLUMN,
        flex.JUSTIFY_START, flex.AL_STRETCH)

    // the header: logo, name, links | sign in
    let hd: usize = add_box(sc, root, flex.FLEX_ROW, flex.JUSTIFY_START,
        flex.AL_CENTER)
    scene.node_set_padding(sc, hd, pad as i64, 3, pad as i64, 0)
    if wide {
        scene.node_set_gap(sc, hd, 28, 0)
    } else {
        scene.node_set_gap(sc, hd, 12, 0)
    }
    scene.node_set_size(sc, hd, 0.0, 62.0)
    let logo: usize = scene.scene_add(sc, hd, scene.N_BOX)
    scene.node_set_size(sc, logo, 30.0, 30.0)
    scene.node_set_draw(sc, logo, pack(pg, 0), draw_logo)
    let brand: usize = add_text(sc, hd, K_BRAND, (&T_BRAND[0]) as u64,
        T_BRAND_N)
    if wide {
        let l1: usize = add_text(sc, hd, K_LINK, (&T_LINK1[0]) as u64,
            T_LINK1_N)
        scene.node_set_draw(sc, l1, pack(pg, H_LINK1), draw_link)
        (*pg).hot[H_LINK1] = l1
        let l2: usize = add_text(sc, hd, K_LINK, (&T_LINK2[0]) as u64,
            T_LINK2_N)
        scene.node_set_draw(sc, l2, pack(pg, H_LINK2), draw_link)
        (*pg).hot[H_LINK2] = l2
    }
    let spring_box: usize = scene.scene_add(sc, hd, scene.N_BOX)
    scene.node_set_grow(sc, spring_box, 1000, 1000)
    let lg: usize = add_box(sc, hd, flex.FLEX_ROW, flex.JUSTIFY_START,
        flex.AL_CENTER)
    scene.node_set_gap(sc, lg, 8, 0)
    scene.node_set_size(sc, lg, 0.0, 40.0)
    let ic: usize = scene.scene_add(sc, lg, scene.N_BOX)
    scene.node_set_size(sc, ic, 18.0, 18.0)
    scene.node_set_draw(sc, ic, pack(pg, 0), draw_login_icon)
    let lt: usize = add_text(sc, lg, K_LOGIN, (&T_LOGIN[0]) as u64, T_LOGIN_N)
    scene.node_set_draw(sc, lt, pack(pg, H_LOGIN), draw_link)
    (*pg).hot[H_LOGIN] = lg

    // the hero: text column | terminal (stacked when narrow)
    // a third of the spare height above the hero, two thirds below it
    let above: usize = scene.scene_add(sc, root, scene.N_BOX)
    scene.node_set_size(sc, above, 1.0, 1.0)
    scene.node_set_grow(sc, above, 350, 0)
    let hero: usize = scene.scene_add(sc, root, scene.N_BOX)
    if wide {
        scene.node_set_flex(sc, hero, flex.FLEX_ROW, flex.JUSTIFY_CENTER,
            flex.AL_CENTER)
        scene.node_set_padding(sc, hero, pad as i64, 64, pad as i64, 40)
        scene.node_set_gap(sc, hero, 64, 0)
    } else {
        scene.node_set_flex(sc, hero, flex.FLEX_COLUMN, flex.JUSTIFY_START,
            flex.AL_CENTER)
        scene.node_set_padding(sc, hero, pad as i64, 30, pad as i64, 36)
        scene.node_set_gap(sc, hero, 36, 0)
    }

    let left: usize = add_box(sc, hero, flex.FLEX_COLUMN, flex.JUSTIFY_START,
        flex.AL_START)
    scene.node_set_padding(sc, left, 0, 0, 0, 26)
    scene.node_set_size(sc, left, left_w, 0.0)

    let pill: usize = add_box(sc, left, flex.FLEX_ROW, flex.JUSTIFY_START,
        flex.AL_CENTER)
    scene.node_set_padding(sc, pill, 12, 0, 14, 0)
    scene.node_set_gap(sc, pill, 8, 0)
    scene.node_set_size(sc, pill, 0.0, 30.0)
    scene.node_set_draw(sc, pill, pack(pg, 0), draw_pill)
    let dot: usize = scene.scene_add(sc, pill, scene.N_BOX)
    scene.node_set_size(sc, dot, 8.0, 8.0)
    scene.node_set_draw(sc, dot, pack(pg, 0), draw_dot)
    let pt: usize = add_text(sc, pill, K_PILL, (&T_PILL[0]) as u64, T_PILL_N)
    rise_in(sc, pill, p_pill)
    add_space(sc, left, 22.0)
    let hg: usize = add_box(sc, left, flex.FLEX_COLUMN, flex.JUSTIFY_START,
        flex.AL_START)
    let a1: usize = add_text(sc, hg, K_H1, (&T_H1[0]) as u64, T_H1_N)
    let a2: usize = add_text(sc, hg, K_H1R, (&T_H2[0]) as u64, T_H2_N)
    rise_in(sc, hg, p_head)
    add_space(sc, left, 16.0)
    // a paragraph: fUi breaks it at the column and sizes it
    let sub: usize = add_text(sc, left, K_SUB, (&T_SUB[0]) as u64, T_SUB_N)
    scene.node_set_text_wrap(sc, sub, 12)
    rise_in(sc, sub, p_sub)
    add_space(sc, left, 30.0)

    let br: usize = add_box(sc, left, flex.FLEX_ROW, flex.JUSTIFY_START,
        flex.AL_CENTER)
    scene.node_set_wrap(sc, br, flex.WRAP_WRAP)
    scene.node_set_gap(sc, br, 12, 12)
    scene.node_set_size(sc, br, left_w, 0.0)
    let b1: usize = add_box(sc, br, flex.FLEX_ROW, flex.JUSTIFY_CENTER,
        flex.AL_CENTER)
    scene.node_add_class(sc, b1, K_B1)
    scene.node_set_padding(sc, b1, 22, 0, 22, 0)
    scene.node_set_size(sc, b1, 0.0, 48.0)
    scene.node_set_draw(sc, b1, pack(pg, H_BTN1), draw_btn)
    (*pg).hot[H_BTN1] = b1
    let b1t: usize = add_text(sc, b1, K_BTN, (&T_BTN1[0]) as u64, T_BTN1_N)
    let b2: usize = add_box(sc, br, flex.FLEX_ROW, flex.JUSTIFY_CENTER,
        flex.AL_CENTER)
    scene.node_add_class(sc, b2, K_B2)
    scene.node_set_padding(sc, b2, 22, 0, 22, 0)
    scene.node_set_size(sc, b2, 0.0, 48.0)
    scene.node_set_draw(sc, b2, pack(pg, H_BTN2), draw_btn)
    (*pg).hot[H_BTN2] = b2
    let b2t: usize = add_text(sc, b2, K_BTN, (&T_BTN2[0]) as u64, T_BTN2_N)
    rise_in(sc, br, p_btn)
    add_space(sc, left, 28.0)

    // the ticks: wrapped by flexbox, which also counts the lines for the
    // height (flex.flex_measure_cross_wrap)
    let ck: usize = add_box(sc, left, flex.FLEX_ROW, flex.JUSTIFY_START,
        flex.AL_CENTER)
    scene.node_set_wrap(sc, ck, flex.WRAP_WRAP)
    scene.node_set_gap(sc, ck, 18, 10)
    scene.node_set_size(sc, ck, left_w, 0.0)
    check_item(sc, ck, (&T_C0[0]) as u64, T_C0_N)
    check_item(sc, ck, (&T_C1[0]) as u64, T_C1_N)
    check_item(sc, ck, (&T_C2[0]) as u64, T_C2_N)
    check_item(sc, ck, (&T_C3[0]) as u64, T_C3_N)
    check_item(sc, ck, (&T_C4[0]) as u64, T_C4_N)
    rise_in(sc, ck, p_chk)

    // the terminal card: its glass is baked, its text is live
    let card: usize = add_box(sc, hero, flex.FLEX_COLUMN, flex.JUSTIFY_START,
        flex.AL_STRETCH)
    scene.node_set_size(sc, card, card_w, 0.0)
    (*pg).card = card
    let top: usize = add_box(sc, card, flex.FLEX_ROW, flex.JUSTIFY_CENTER,
        flex.AL_CENTER)
    scene.node_set_size(sc, top, 0.0, 40.0)
    scene.node_set_padding(sc, top, 70, 0, 70, 0)
    let tt: usize = add_text(sc, top, K_TTITLE, (&T_TTITLE[0]) as u64,
        T_TTITLE_N)
    let body: usize = add_box(sc, card, flex.FLEX_COLUMN, flex.JUSTIFY_START,
        flex.AL_STRETCH)
    scene.node_set_padding(sc, body, 20, 16, 20, 20)
    scene.node_set_gap(sc, body, 2, 0)
    (*pg).cursor_node = scene.SCENE_NONE
    let done: bool = (*pg).now - (*pg).t0 >= type_end(pg)
    // Every line is a PARAGRAPH that RESERVES its whole text
    // (scene.node_set_text_reserve): fUi breaks and sizes it for what will
    // be typed, so the card keeps its size while the terminal types.
    var li: usize = 0
    while li < LINES_T {
        let vis: usize = typed(pg, li)
        let p: u64 = (*pg).lp[li]
        let n: usize = (*pg).ln[li]
        if (*pg).lk[li] == 0 as u32 {
            let row: usize = add_box(sc, body, flex.FLEX_ROW,
                flex.JUSTIFY_START, flex.AL_START)
            scene.node_set_gap(sc, row, 10, 0)
            let pr: usize = add_text(sc, row, K_TPROMPT,
                (&T_PROMPT[0]) as u64, T_PROMPT_N)
            let cm: usize = add_text(sc, row, K_TCMD, p, vis)
            scene.node_set_text_reserve(sc, cm, p, n)
            scene.node_set_text_wrap(sc, cm, 6)
            scene.node_set_grow(sc, cm, 1000, 1000)
            if vis > 0 && vis < n {
                (*pg).cursor_node = cm
                scene.node_set_draw(sc, cm, pack(pg, 0), draw_cursor)
            }
        } else {
            var cls: u32 = K_TOUT
            if (*pg).lk[li] == 2 as u32 {
                cls = K_TOK
            }
            let o: usize = add_text(sc, body, cls, p, vis)
            scene.node_set_text_reserve(sc, o, p, n)
            scene.node_set_text_wrap(sc, o, 6)
        }
        li = li + 1
    }
    // the prompt that waits -- with its cursor once everything is typed
    let last: usize = add_box(sc, body, flex.FLEX_ROW, flex.JUSTIFY_START,
        flex.AL_START)
    scene.node_set_gap(sc, last, 10, 0)
    let lp: usize = add_text(sc, last, K_TPROMPT, (&T_PROMPT[0]) as u64,
        T_PROMPT_N)
    let lc: usize = add_text(sc, last, K_TCMD, (&T_PROMPT[0]) as u64, 0)
    scene.node_set_text_reserve(sc, lc, (&T_PROMPT[0]) as u64, T_PROMPT_N)
    scene.node_set_grow(sc, lc, 1000, 1000)
    if done {
        (*pg).cursor_node = lc
        scene.node_set_draw(sc, lc, pack(pg, 0), draw_cursor)
    } else {
        scene.node_set_text(sc, lp, (&T_PROMPT[0]) as u64, 0)
        scene.node_set_text_reserve(sc, lp, (&T_PROMPT[0]) as u64,
            T_PROMPT_N)
    }

    // what is left of the window goes between the hero and the figures --
    // the mountains stand there
    let gap_box: usize = scene.scene_add(sc, root, scene.N_BOX)
    scene.node_set_size(sc, gap_box, 1.0, 24.0)
    scene.node_set_grow(sc, gap_box, 650, 0)

    // the four figures in one glass bar (two by two when narrow)
    let foot: usize = add_box(sc, root, flex.FLEX_ROW, flex.JUSTIFY_CENTER,
        flex.AL_START)
    scene.node_set_padding(sc, foot, pad as i64, 0, pad as i64, 40)
    var cols: f64 = 4.0
    var th: f64 = 104.0
    if !wide {
        cols = 2.0
        th = 100.0
    }
    let tw: f64 = ffloor(fmin(1060.0, avail) / cols)
    let panel: usize = add_box(sc, foot, flex.FLEX_ROW, flex.JUSTIFY_START,
        flex.AL_START)
    scene.node_set_wrap(sc, panel, flex.WRAP_WRAP)
    scene.node_set_size(sc, panel, tw * cols, th * (4.0 / cols))
    (*pg).panel = panel
    tile(pg, z, sc, panel, 0, tw, th, (&T_S0V[0]) as u64, T_S0V_N,
        (&T_S0C[0]) as u64, T_S0C_N, !wide)
    tile(pg, z, sc, panel, 1, tw, th, (&T_S1V[0]) as u64, T_S1V_N,
        (&T_S1C[0]) as u64, T_S1C_N, !wide)
    tile(pg, z, sc, panel, 2, tw, th, (&T_S2V[0]) as u64, T_S2V_N,
        (&T_S2C[0]) as u64, T_S2C_N, !wide)
    tile(pg, z, sc, panel, 3, tw, th, (&T_S3V[0]) as u64, T_S3V_N,
        (&T_S3C[0]) as u64, T_S3C_N, !wide)
    // what answers the pointer is LIVE: left out of the baked still
    // picture, painted every frame on top of it (scene_draw_live)
    k = 0
    while k < HOT_N {
        scene.node_set_live(sc, (*pg).hot[k], true)
        k = k + 1
    }
}

// ================================================================ PAINTERS
// Each runs after its node's own paint and before its children
// (scene.node_set_draw). Rectangles are device pixels.

fn draw_logo(ud: u64, c: *mut render.Ctx, e: *mut widget.Widget) {
    let pg: *mut Page = unpack_page(ud)
    let w: usize = (widget.w_w(e) + 0.5) as usize
    let h: usize = (widget.w_h(e) + 0.5) as usize
    if uisvg.icon_render(&(*pg).logo, (&SVG_LOGO[0]) as u64, SVG_LOGO_N, w, h,
        0 as u32, 0) {
        var im: uiimage.Image = uisvg.icon_view(&(*pg).logo)
        uiimage.image_draw_rect(render.ctx_painter(c), &im, widget.w_x(e),
            widget.w_y(e), w as f64, h as f64, 0 as u32)
    }
}

fn draw_login_icon(ud: u64, c: *mut render.Ctx, e: *mut widget.Widget) {
    let pg: *mut Page = unpack_page(ud)
    let w: usize = (widget.w_w(e) + 0.5) as usize
    let h: usize = (widget.w_h(e) + 0.5) as usize
    if uisvg.icon_render(&(*pg).login, (&SVG_LOGIN[0]) as u64, SVG_LOGIN_N,
        w, h, 0 as u32, 0) {
        var im: uiimage.Image = uisvg.icon_view(&(*pg).login)
        uiimage.image_draw_rect(render.ctx_painter(c), &im, widget.w_x(e),
            widget.w_y(e), w as f64, h as f64, 0 as u32)
    }
}

// A link: its underline grows from the left on the hover spring.
fn draw_link(ud: u64, c: *mut render.Ctx, e: *mut widget.Widget) {
    let pg: *mut Page = unpack_page(ud)
    let hv: f64 = hover_of(pg, unpack_i(ud))
    if hv <= 0.01 {
        return
    }
    let s: f64 = (*pg).s
    let z: *mut painter.Painter = render.ctx_painter(c)
    let y: f64 = widget.w_y(e) + widget.w_h(e) + 3.0 * s
    painter.round_rect(z, widget.w_x(e), y, widget.w_w(e) * fmin(hv, 1.0),
        2.0 * s, 1.0 * s, theme.opaque(C_RED))
}

fn draw_pill(ud: u64, c: *mut render.Ctx, e: *mut widget.Widget) {
    let pg: *mut Page = unpack_page(ud)
    let p: f64 = 1.0
    let s: f64 = (*pg).s
    let z: *mut painter.Painter = render.ctx_painter(c)
    let x: f64 = widget.w_x(e)
    let y: f64 = widget.w_y(e)
    let w: f64 = widget.w_w(e)
    let h: f64 = widget.w_h(e)
    painter.round_rect(z, x, y, w, h, h / 2.0, argb(0.05 * p, 16777215))
    painter.round_ring(z, x, y, w, h, h / 2.0, 1.0 * s,
        argb(0.16 * p, 16777215))
}

fn draw_dot(ud: u64, c: *mut render.Ctx, e: *mut widget.Widget) {
    let pg: *mut Page = unpack_page(ud)
    let p: f64 = 1.0
    let s: f64 = (*pg).s
    let z: *mut painter.Painter = render.ctx_painter(c)
    let x: f64 = widget.w_x(e)
    let y: f64 = widget.w_y(e)
    let w: f64 = widget.w_w(e)
    painter.round_rect(z, x - 3.0 * s, y - 3.0 * s, w + 6.0 * s, w + 6.0 * s,
        (w + 6.0 * s) / 2.0, argb(0.22 * p, C_GREEN))
    painter.round_rect(z, x, y, w, w, w / 2.0, argb(p, C_GREEN))
}

// The red button's face, glow and rim are its style (rule_btn); what
// is left is a hairline of light on its top edge.
fn draw_btn(ud: u64, c: *mut render.Ctx, e: *mut widget.Widget) {
    let pg: *mut Page = unpack_page(ud)
    let i: usize = unpack_i(ud)
    if i != H_BTN1 {
        return
    }
    let hv: f64 = fmax(0.0, hover_of(pg, i))
    let s: f64 = (*pg).s
    let z: *mut painter.Painter = render.ctx_painter(c)
    let r: f64 = 10.0 * s
    painter.round_rect(z, widget.w_x(e) + r, widget.w_y(e) + 1.0 * s,
        widget.w_w(e) - 2.0 * r, 1.0 * s, 0.0,
        argb(0.18 + 0.12 * hv, 16777215))
}

// A tile of the figure bar: a light and a red line that grow on hover.
fn draw_tile(ud: u64, c: *mut render.Ctx, e: *mut widget.Widget) {
    let pg: *mut Page = unpack_page(ud)
    let hv: f64 = fmin(fmax(0.0, hover_of(pg, unpack_i(ud))), 1.0)
    if hv <= 0.01 {
        return
    }
    let s: f64 = (*pg).s
    let z: *mut painter.Painter = render.ctx_painter(c)
    let x: f64 = widget.w_x(e)
    let y: f64 = widget.w_y(e)
    let w: f64 = widget.w_w(e)
    let h: f64 = widget.w_h(e)
    painter.round_rect(z, x + 6.0 * s, y + 6.0 * s, w - 12.0 * s,
        h - 12.0 * s, 10.0 * s, argb(0.06 * hv, 16777215))
    let lw: f64 = w * 0.5 * hv
    painter.round_rect(z, x + (w - lw) / 2.0, y + 8.0 * s, lw, 2.0 * s,
        1.0 * s, theme.opaque(C_RED))
}

// The terminal's block cursor, after the typed text.
fn draw_cursor(ud: u64, c: *mut render.Ctx, e: *mut widget.Widget) {
    let pg: *mut Page = unpack_page(ud)
    let s: f64 = (*pg).s
    let z: *mut painter.Painter = render.ctx_painter(c)
    let px: f64 = (*pg).mono_px * s
    let tw: f64 = text_w(pg, z, FONT_MONO, px, widget.w_text(e),
        widget.w_text_len(e))
    if tw + px > widget.w_w(e) {
        return
    }
    let cw: f64 = text_w(pg, z, FONT_MONO, px, (&T_PROMPT[0]) as u64, 1)
    let lh: f64 = widget.w_h(e) / (widget.w_text_lines(e) as f64)
    painter.round_rect(z, widget.w_x(e) + tw + 1.0 * s,
        widget.w_y(e) + (lh - px * 1.2) / 2.0, cw, px * 1.25, 1.0 * s,
        argb(0.8, C_WHITE))
}

// ================================================================ BACKGROUND
fn spot(sp: *mut f64, i: usize, x: f64, y: f64, rx: f64, ry: f64,
    k: f64, r: f64, g: f64, b: f64) {
    let q: u64 = sp as u64 + (i * 64) as u64
    *(q as *mut f64) = x
    *((q + 8) as *mut f64) = y
    *((q + 16) as *mut f64) = rx
    *((q + 24) as *mut f64) = ry
    *((q + 32) as *mut f64) = k
    *((q + 40) as *mut f64) = r
    *((q + 48) as *mut f64) = g
    *((q + 56) as *mut f64) = b
}

// The ground of the whole page into `z`, the page's top at `oy`. `cr` and
// `pr` are the card's and the bar's rectangles in PAGE coordinates.
fn paint_ground(pg: *mut Page, z: *mut painter.Painter, w: f64, ph: f64,
    oy: f64, cr: *mut f64, pr: *mut f64) {
    let s: f64 = (*pg).s
    let css_w: f64 = w / s
    // 1. red light: two corners, the foot, a breath behind the terminal
    var sp: [f64; 32] = [0.0; 32]
    let cx: f64 = *cr
    let cy: f64 = *((cr as u64 + 8) as *mut f64)
    let cw: f64 = *((cr as u64 + 16) as *mut f64)
    let ch: f64 = *((cr as u64 + 24) as *mut f64)
    spot(&sp[0], 0, 0.06 * w, oy - 40.0 * s, fmax(0.55 * w, 420.0 * s),
        620.0 * s, 0.55, 118.0, 16.0, 32.0)
    spot(&sp[0], 1, 0.97 * w, oy + 40.0 * s, fmax(0.45 * w, 360.0 * s),
        560.0 * s, 0.45, 108.0, 14.0, 30.0)
    spot(&sp[0], 2, 0.5 * w, oy + ph - 150.0 * s, 0.8 * w, 300.0 * s, 0.42,
        140.0, 20.0, 38.0)
    spot(&sp[0], 3, cx + cw / 2.0, oy + cy + ch / 2.0, cw, ch * 1.3, 0.20,
        150.0, 24.0, 40.0)
    effect.glow_ground(z, 0.0, oy, w, ph, 1183510, C_BASE, (&sp[0]) as u64, 4)
    // 2. a faint grid, fading out downwards in three bands
    let step: f64 = 64.0 * s
    var gy: f64 = 0.0
    while gy < ph * 0.7 {
        var a: f64 = 0.035
        if gy > ph * 0.35 {
            a = 0.02
        }
        painter.round_rect(z, 0.0, oy + gy, w, 1.0 * s, 0.0, argb(a, 16777215))
        gy = gy + step
    }
    var gx: f64 = ffloor((w - ffloor(w / step) * step) / 2.0)
    while gx < w {
        painter.round_rect(z, gx, oy, 1.0 * s, ph * 0.7, 0.0,
            argb(0.028, 16777215))
        gx = gx + step
    }
    // 3. the red line on top and the rule under the header
    painter.round_rect(z, 0.0, oy, w, 3.0 * s, 0.0, theme.opaque(C_RED))
    painter.round_rect(z, 0.0, oy + 62.0 * s, w, 1.0 * s, 0.0,
        argb(0.45, C_RED))
    // 4. the mountains (SVG), on the foot of the page
    // the mountains take the lower half of the window (300..620 points);
    // on a phone they stand above the figure bar
    var hh: f64 = fmin(fmax((*pg).view_h / s * 0.5, 300.0), 620.0) * s
    if css_w < 1000.0 {
        hh = 420.0 * s
    }
    let iw: usize = (w + 0.5) as usize
    let ih: usize = (hh + 0.5) as usize
    if uisvg.icon_render(&(*pg).hills, (&SVG_HILLS[0]) as u64, SVG_HILLS_N,
        iw, ih, 0 as u32, 0) {
        var im: uiimage.Image = uisvg.icon_view(&(*pg).hills)
        uiimage.image_draw_rect(z, &im, 0.0, oy + ph - hh, iw as f64,
            ih as f64, 0 as u32)
    }
    // 5. the terminal: shadow, glass, rim, the bar with its three dots
    let y0: f64 = oy + cy
    let r: f64 = 12.0 * s
    effect.rrect_shadow(z, cx, y0, cw, ch, r, 18.0 * s, 42.0 * s,
        argb(0.62, 0))
    let g1: bool = effect.glass_area(z, cx, y0, cw, ch, r, (16.0 * s) as i64,
        argb(0.84, 1316636), 1.25)
    painter.round_ring(z, cx, y0, cw, ch, r, 1.0 * s, argb(0.13, 16777215))
    painter.round_rect(z, cx + 1.0 * s, y0 + 40.0 * s, cw - 2.0 * s, 1.0 * s,
        0.0, argb(0.08, 16777215))
    painter.round_rect(z, cx + 18.0 * s, y0 + 14.0 * s, 12.0 * s, 12.0 * s,
        6.0 * s, theme.opaque(16736087))
    painter.round_rect(z, cx + 38.0 * s, y0 + 14.0 * s, 12.0 * s, 12.0 * s,
        6.0 * s, theme.opaque(16694318))
    painter.round_rect(z, cx + 58.0 * s, y0 + 14.0 * s, 12.0 * s, 12.0 * s,
        6.0 * s, theme.opaque(2672704))
    // 6. the figure bar: shadow, glass, rim, the rules between the tiles
    let px0: f64 = *pr
    let py0: f64 = oy + *((pr as u64 + 8) as *mut f64)
    let pw: f64 = *((pr as u64 + 16) as *mut f64)
    let pht: f64 = *((pr as u64 + 24) as *mut f64)
    let r2: f64 = 14.0 * s
    effect.rrect_shadow(z, px0, py0, pw, pht, r2, 14.0 * s, 36.0 * s,
        argb(0.55, 0))
    let g2: bool = effect.glass_area(z, px0, py0, pw, pht, r2,
        (14.0 * s) as i64, argb(0.80, 1712166), 1.2)
    painter.round_ring(z, px0, py0, pw, pht, r2, 1.0 * s,
        argb(0.10, 16777215))
    if css_w >= 1000.0 {
        var k: usize = 1
        while k < 4 {
            painter.round_rect(z, px0 + ffloor(pw * (k as f64) / 4.0),
                py0 + 18.0 * s, 1.0 * s, pht - 36.0 * s, 0.0,
                argb(0.08, 16777215))
            k = k + 1
        }
    } else {
        painter.round_rect(z, px0 + ffloor(pw / 2.0), py0 + 14.0 * s,
            1.0 * s, pht - 28.0 * s, 0.0, argb(0.08, 16777215))
        painter.round_rect(z, px0 + 14.0 * s, py0 + ffloor(pht / 2.0),
            pw - 28.0 * s, 1.0 * s, 0.0, argb(0.08, 16777215))
    }
}

// The key of the baked ground: size and the two glass panels.
fn ground_key(w: usize, ph: usize, cr: *mut f64, pr: *mut f64) -> u64 {
    var key: u64 = (w as u64) * 1000003 + (ph as u64) * 7919
    var i: usize = 0
    while i < 4 {
        let a: f64 = *((cr as u64 + (i * 8) as u64) as *mut f64)
        let b: f64 = *((pr as u64 + (i * 8) as u64) as *mut f64)
        key = key * 31 + ((a * 4.0 + 100000.0) as u64)
        key = key * 37 + ((b * 4.0 + 100000.0) as u64)
        i = i + 1
    }
    return key
}

// ================================================================ A FRAME
// Paints the page into the painter's canvas (w x h device pixels). The
// canvas need not be cleared: the ground covers every pixel.
fn page_frame(pg: *mut Page, c: *mut render.Ctx, w: usize, h: usize,
    now: i64) {
    let m: *mut theme.Theme = (*pg).m as *mut theme.Theme
    let z: *mut painter.Painter = render.ctx_painter(c)
    if !(*pg).started {
        (*pg).started = true
        (*pg).t0 = now
    }
    (*pg).now = now
    (*pg).s = (theme.theme_scale(m) as f64) / 1000.0
    (*pg).view_h = h as f64
    let sc: *mut scene.Scene = &(*pg).sc
    describe(pg, z, w)
    scene.scene_style(sc, &(*pg).sh)
    scene.scene_measure(sc, c)
    let root: usize = scene.scene_root(sc)
    var ph: f64 = ffloor(scene.node_pref_h(sc, root) + 0.5)
    if ph < h as f64 {
        ph = h as f64
    }
    (*pg).page_h = ph
    if (*pg).sa_on {
        (*pg).scroll = anim.anim_value(&(*pg).sa, now)
        if anim.anim_done(&(*pg).sa, now) {
            (*pg).sa_on = false
        }
    }
    let maxs: f64 = ph - (h as f64)
    if (*pg).scroll > maxs {
        (*pg).scroll = maxs
    }
    if (*pg).scroll < 0.0 {
        (*pg).scroll = 0.0
    }
    let sy: f64 = ffloor((*pg).scroll + 0.5)
    scene.scene_layout(sc, c, 0.0, 0.0 - sy, w as f64, ph)
    // a paragraph that got another width than it guessed (the first frame,
    // a new size) changed the page's height: lay it out once more for that
    if scene.scene_reflows(sc) > 0 {
        var ph2: f64 = ffloor(scene.node_pref_h(sc, root) + 0.5)
        if ph2 < h as f64 {
            ph2 = h as f64
        }
        if ph2 != ph {
            ph = ph2
            (*pg).page_h = ph
            scene.scene_layout(sc, c, 0.0, 0.0 - sy, w as f64, ph)
        }
    }
    // the glass panels in page coordinates
    var cr: [f64; 4] = [0.0; 4]
    var pr: [f64; 4] = [0.0; 4]
    let cn: usize = (*pg).card
    cr[0] = scene.node_x(sc, cn)
    cr[1] = scene.node_y(sc, cn) + sy
    cr[2] = scene.node_w(sc, cn)
    cr[3] = scene.node_h(sc, cn)
    let pn: usize = (*pg).panel
    pr[0] = scene.node_x(sc, pn)
    pr[1] = scene.node_y(sc, pn) + sy
    pr[2] = scene.node_w(sc, pn)
    pr[3] = scene.node_h(sc, pn)
    // THE GROUND IS BAKED (layer.Bake) at the page's full height, once per
    // size; a frame copies the visible band of it.
    let bk: *mut layer.Bake = &(*pg).bk
    let key: u64 = ground_key(w, ph as usize, &cr[0], &pr[0])
    if !layer.bake_valid(bk, w, ph as usize, key) {
        (*pg).rest = false
        if layer.bake_start(bk, w, ph as usize, key, theme.opaque(C_BASE), z) {
            paint_ground(pg, layer.bake_painter(bk), w as f64, ph, 0.0,
                &cr[0], &pr[0])
        }
    }
    let baked: bool = layer.bake_valid(bk, w, ph as usize, key)
    if baked && !(*pg).rest && !(*pg).no_rest && page_still(pg, now) {
        // AT REST nothing but the live nodes can change any more: the
        // rest of the page goes into the bake too (scene_draw_still, laid
        // out at the page's top), and a frame is the copy plus
        // scene_draw_live
        scene.scene_layout(sc, c, 0.0, 0.0, w as f64, ph)
        var cb: render.Ctx = render.ctx_new(m, layer.bake_painter(bk))
        scene.scene_draw_still(sc, &cb)
        (*pg).rest = true
        (*pg).rests = (*pg).rests + 1
        scene.scene_layout(sc, c, 0.0, 0.0 - sy, w as f64, ph)
    }
    var copied: bool = false
    if baked {
        copied = layer.bake_copy_to(bk, z, sy as usize, h)
    }
    if !copied {
        // (out of memory, or a canvas of another width): paint it all
        (*pg).rest = false
        paint_ground(pg, z, w as f64, ph, 0.0 - sy, &cr[0], &pr[0])
    }
    if copied && (*pg).rest {
        scene.scene_draw_live(sc, c)
    } else {
        scene.scene_draw(sc, c)
    }
}

// Is everything but the hot parts still? (the intro and the typing over)
fn page_still(pg: *mut Page, now: i64) -> bool {
    return now - (*pg).t0 >= type_end(pg) + 50
    && now - (*pg).t0 >= 420 + INTRO_MS + 50
}

// Bake the still content at rest (true, the default) or paint every node
// every frame (false -- the worst case, for the stopwatch).
fn page_set_still_cache(pg: *mut Page, on: bool) {
    (*pg).no_rest = !on
    // the ground is baked anew, without the still content in it
    layer.bake_free(&(*pg).bk)
    (*pg).rest = false
}

// How often the still content was baked (a new size bakes it again).
fn page_rests(pg: *mut Page) -> usize { return (*pg).rests }

// ================================================================ INPUT
fn retarget(pg: *mut Page, i: usize, to: f64, now: i64) {
    if (*pg).hto[i] == to {
        return
    }
    let cur: f64 = anim.anim_value(&(*pg).ha[i], now)
    (*pg).ha[i] = anim.anim_new(now, 560, cur, to,
        anim.easing_spring(1.0, 170.0, 15.0))
    (*pg).hto[i] = to
}

fn hit_hot(pg: *mut Page, x: f64, y: f64) -> usize {
    let sc: *mut scene.Scene = &(*pg).sc
    var i: usize = 0
    while i < HOT_N {
        let n: usize = (*pg).hot[i]
        if n != scene.SCENE_NONE {
            let nx: f64 = scene.node_x(sc, n)
            let ny: f64 = scene.node_y(sc, n)
            if x >= nx && y >= ny && x < nx + scene.node_w(sc, n)
            && y < ny + scene.node_h(sc, n) {
                return i
            }
        }
        i = i + 1
    }
    return HOT_N
}

// The hot target under the pointer (HOT_N = none).
fn page_hover(pg: *mut Page) -> usize {
    if !(*pg).inside {
        return HOT_N
    }
    return hit_hot(pg, (*pg).px, (*pg).py)
}

// The pointer, in device pixels. true = paint again.
fn page_pointer(pg: *mut Page, kind: u32, x: f64, y: f64, now: i64) -> bool {
    (*pg).px = x
    (*pg).py = y
    (*pg).inside = kind != PTR_LEAVE
    var hit: usize = HOT_N
    if (*pg).inside {
        hit = hit_hot(pg, x, y)
    }
    var changed: bool = false
    var i: usize = 0
    while i < HOT_N {
        var to: f64 = 0.0
        if i == hit {
            to = 1.0
        }
        if (*pg).hto[i] != to {
            retarget(pg, i, to, now)
            changed = true
        }
        i = i + 1
    }
    if kind == PTR_DOWN {
        (*pg).pressed = hit
        changed = true
    }
    if kind == PTR_UP || kind == PTR_LEAVE {
        if kind == PTR_UP && hit == H_BTN2 && (*pg).pressed == H_BTN2 {
            // "Projekte entdecken": glide down to the figures
            let target: f64 = (*pg).page_h - (*pg).view_h
            (*pg).sa = anim.anim_new(now, 700, (*pg).scroll, target,
                anim.easing_named(anim.EASE_IN_OUT))
            (*pg).sa_on = true
        }
        if (*pg).pressed != HOT_N {
            changed = true
        }
        (*pg).pressed = HOT_N
    }
    return changed
}

// The wheel, device pixels (positive = down). true = it scrolled.
fn page_wheel(pg: *mut Page, dy: f64) -> bool {
    let old: f64 = (*pg).scroll
    var y: f64 = old + dy
    let maxs: f64 = (*pg).page_h - (*pg).view_h
    if y > maxs {
        y = maxs
    }
    if y < 0.0 {
        y = 0.0
    }
    (*pg).sa_on = false
    (*pg).scroll = y
    return y != old
}

// Does anything still move? (intro, typing, a spring, the glide)
fn page_busy(pg: *mut Page, now: i64) -> bool {
    if !(*pg).started {
        return true
    }
    if now - (*pg).t0 < type_end(pg) + 50 {
        return true
    }
    if now - (*pg).t0 < 420 + INTRO_MS + 50 {
        return true
    }
    if (*pg).sa_on {
        return true
    }
    var i: usize = 0
    while i < HOT_N {
        if !anim.anim_done(&(*pg).ha[i], now) {
            return true
        }
        i = i + 1
    }
    return false
}

// The middle of hot target `i` as it was laid out last (for tests and the
// hover pictures). false when the target is not on the page.
fn page_hot_centre(pg: *mut Page, i: usize, x: *mut f64, y: *mut f64) -> bool {
    if i >= HOT_N {
        return false
    }
    let n: usize = (*pg).hot[i]
    if n == scene.SCENE_NONE {
        return false
    }
    let sc: *mut scene.Scene = &(*pg).sc
    *x = scene.node_x(sc, n) + scene.node_w(sc, n) / 2.0
    *y = scene.node_y(sc, n) + scene.node_h(sc, n) / 2.0
    return true
}

// The scene's own guards after the last frame: 0 = every node got its
// room and kept its size while drawing (scene_overflow_reason, and 1000
// more when a size drifted while painting).
fn page_check(pg: *mut Page) -> u32 {
    var r: u32 = scene.scene_overflow_reason(&(*pg).sc)
    if scene.scene_size_drift(&(*pg).sc) != 0 {
        r = r + 1000 as u32
    }
    return r
}
