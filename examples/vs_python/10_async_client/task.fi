import std.rt
import std.io
import std.env
import async.loop
import async.ahttp

fn done(r: *mut ahttp.Request, ud: u64) {
    *(ud as *mut u64) = ahttp.areq_status(r) as u64
    *((ud + 8) as *mut u64) = ahttp.areq_body_len(r) as u64
}

#[allow_escape]
fn main() -> i32 {
    var l: loop.Loop = loop.loop_new()
    loop.loop_init(&l)
    var a: ahttp.AClient = ahttp.aclient_new()
    ahttp.aclient_init(&a, &l)
    var res: [u64; 40] = [0; 40]
    let base: str = "http://127.0.0.1:" + env.get("VSPY_PORT")
    for i in 0..20 {
        ahttp.aclient_get_str(&a, io.fmt_string(f"{base}/n/{i}"), 5000, done, (&res[2 * i as usize]) as u64)
    }
    loop.run(&l)
    for i in 0..20 {
        io.fmt_print_line(f"/n/{i} {res[2 * i as usize]} {res[2 * i as usize + 1]}")
    }
    return 0
}
