import std.vec
import std.io
import std.env
import async.ahttp

fn main() -> i32 {
    let base: str = "http://127.0.0.1:" + env.get("VSPY_PORT")
    var urls: Vec[str] = vec_new[str]()
    for i in 0..20 {
        vec_push[str](&urls, io.fmt_string(f"{base}/n/{i}"))
    }
    var res: Vec[ahttp.Got] = vec_new[ahttp.Got]()
    ahttp.get_all(&urls, &res, 5000)
    for i in 0..20 {
        let g: *mut ahttp.Got = vec_elem_ptr[ahttp.Got](&res, i as usize)
        io.fmt_print_line(f"/n/{i} {(*g).status} {ahttp.got_body(g).n}")
    }
    return 0
}
