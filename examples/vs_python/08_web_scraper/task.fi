import std.rt
import std.io
import std.textfmt
import html.soup

fn main() -> i32 {
    var page: io.Text = io.read_file_text("page.html")
    var d: soup.Doc = soup.doc_new()
    defer soup.doc_free(&d)
    if !soup.parse(&d, str { p: rt.buf_data(&page.b), n: rt.buf_len(&page.b) }) {
        return 1
    }
    var out: rt.Buf = rt.buf_new()
    textfmt.put(&out, "title: ")
    textfmt.put(&out, soup.text(&d, soup.select_one(&d, "title")))
    rt.buf_push(&out, 10 as u8)
    let hits: soup.Hits = soup.select(&d, "div.item > a[href]")
    var i: usize = 0
    while i < soup.count(hits) {
        let a: soup.El = soup.at(hits, i)
        textfmt.pad_right(&out, soup.attr(&d, a, "href"), 6)
        textfmt.put(&out, soup.text(&d, a))
        rt.buf_push(&out, 10 as u8)
        i = i + 1
    }
    io.print_bytes(rt.buf_ptr(&out), rt.buf_len(&out))
    return 0
}
