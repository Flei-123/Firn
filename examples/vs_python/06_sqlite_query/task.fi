import std.rt
import std.io
import std.textfmt
import db.dberr
import db.dbcore as dc
import db.sqlite as sq

fn run() -> DbError!i32 {
    let con: *mut dc.Db = try sq.db_open("shop.db", sq.OPEN_READWRITE)
    try sq.db_begin(con)
    let ins: *mut dc.Stmt = try sq.db_prepare(con, "INSERT INTO orders(customer_id, amount) VALUES (?, ?)")
    try sq.stmt_bind_int(ins, 1, 2)
    try sq.stmt_bind_real(ins, 2, 99.5)
    try sq.stmt_step(ins)
    sq.stmt_finalize(ins)
    let q: *mut dc.Stmt = try sq.db_prepare(con, "SELECT c.name, c.city, COUNT(*), SUM(o.amount) FROM customers c JOIN orders o ON o.customer_id = c.id GROUP BY c.id HAVING SUM(o.amount) > ? ORDER BY SUM(o.amount) DESC, c.name")
    try sq.stmt_bind_int(q, 1, 100)
    var out: rt.Buf = rt.buf_new()
    while sq.stmt_step(q) catch false {
        textfmt.pad_right(&out, sq.stmt_column_text(q, 0), 6)
        textfmt.pad_right(&out, sq.stmt_column_text(q, 1), 10)
        textfmt.pad_left_i64(&out, sq.stmt_column_int(q, 2), 3)
        textfmt.pad_left_fixed(&out, sq.stmt_column_real(q, 3), 1, 9)
        rt.buf_push(&out, 10 as u8)
    }
    sq.stmt_finalize(q)
    let rowid: i64 = sq.db_last_insert_rowid(con)
    io.print_bytes(rt.buf_ptr(&out), rt.buf_len(&out))
    io.fmt_print_line(f"rowid {rowid}")
    try sq.db_rollback(con)
    sq.db_close(con)
    return 0
}

fn main() -> i32 {
    return run() catch 1
}
