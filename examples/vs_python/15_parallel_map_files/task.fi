import std.io
import std.rt
import std.fs
import std.fsx
import std.hashfile
import std.vec
import jobs.jobs

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == jobs.WORKER_KIND {
        return jobs.worker_main(arg)
    }
    return 0
}

struct Row {
    hex: [u8; 64],
    lines: u64,
}

fn path_of(root: str, i: u64) -> str {
    return io.fmt_string(f"{root}/file{i / 10}{i % 10}.txt")
}

fn digest(p: *str, out: *mut Row) {
    let d: str = hashfile.hash_file_hex(*p, hashfile.HASH_SHA256) catch "?"
    rt.mem_copy((&(*out).hex[0]) as u64, d.p as u64, 64)
    var data: rt.Buf = rt.buf_new()
    fs.read_file(*p, &data) catch 0
    for k in 0..rt.buf_len(&data) {
        if rt.buf_at(&data, k) == 10 {
            (*out).lines = (*out).lines + 1
        }
    }
    rt.buf_free(&data)
}

#[allow_escape]
fn run() -> FsError!bool {
    var dir: fsx.TempDir = try fsx.temp_dir("vspy15_")
    defer fsx.temp_dir_drop(&dir)
    let root: str = fsx.temp_dir_path(&dir)
    var paths: Vec[str] = vec_new[str]()
    for i in 0..40 {
        var b: rt.Buf = rt.buf_new()
        for j in 0..(i + 1) * 50 {
            io.fmt_content(f"line {i} {j}\n", &b)
        }
        try fs.write_file(path_of(root, i as u64), rt.buf_ptr(&b), rt.buf_len(&b))
        rt.buf_free(&b)
        vec_push[str](&paths, path_of(root, i as u64))
    }
    var pool: jobs.Jobs = jobs.create(3)
    var rows: Vec[Row] = vec_new[Row]()
    jobs_map_files[Row](&pool, &paths, digest, &rows)
    jobs.destroy(&pool)
    for i in 0..40 as usize {
        let r: Row = *vec_elem_ptr[Row](&rows, i)
        let d: str = str { p: &r.hex[0], n: 64 }
        io.fmt_print_line(f"file{i / 10}{i % 10}.txt {d} {r.lines}")
    }
    return true
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    let ok: bool = run() catch | e | false
    if !ok { io.eprint_line("run failed") }
    return 0
}
