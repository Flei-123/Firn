import std.io
import std.rt
import std.fs
import std.fsx
import std.hashfile
import jobs.jobs

struct Ctx {
    root: str,
    hex: [u8; 2560],
    lines: [u64; 40],
}

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == jobs.WORKER_KIND {
        return jobs.worker_main(arg)
    }
    return 0
}

fn path_of(root: str, i: u64) -> str {
    return io.fmt_string(f"{root}/file{i / 10}{i % 10}.txt")
}

fn work(ctx: u64, lo: u64, hi: u64) {
    let c: *mut Ctx = ctx as *mut Ctx
    var i: u64 = lo
    while i < hi {
        let p: str = path_of((*c).root, i)
        let d: str = hashfile.hash_file_hex(p, hashfile.HASH_SHA256) catch "?"
        rt.mem_copy((&(*c).hex[(i * 64) as usize]) as u64, d.p as u64, 64)
        var data: rt.Buf = rt.buf_new()
        fs.read_file(p, &data) catch 0
        var n: usize = 0
        for k in 0..rt.buf_len(&data) {
            if rt.buf_at(&data, k) == 10 {
                n = n + 1
            }
        }
        (*c).lines[i as usize] = n as u64
        rt.buf_free(&data)
        i = i + 1
    }
}

#[allow_escape]
fn run() -> FsError!bool {
    var dir: fsx.TempDir = try fsx.temp_dir("vspy15_")
    defer fsx.temp_dir_drop(&dir)
    var c: Ctx = Ctx { root: fsx.temp_dir_path(&dir), hex: [0; 2560], lines: [0; 40] }
    for i in 0..40 {
        var b: rt.Buf = rt.buf_new()
        for j in 0..(i + 1) * 50 {
            io.fmt_content(f"line {i} {j}\n", &b)
        }
        try fs.write_file(path_of(c.root, i as u64), rt.buf_ptr(&b), rt.buf_len(&b))
        rt.buf_free(&b)
    }
    var pool: jobs.Jobs = jobs.create(3)
    jobs.parallel_each(&pool, 40, work, (&c) as u64)
    jobs.destroy(&pool)
    for i in 0..40 as usize {
        let d: str = str { p: &c.hex[i * 64], n: 64 }
        io.fmt_print_line(f"file{i / 10}{i % 10}.txt {d} {c.lines[i]}")
    }
    return true
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    let ok: bool = run() catch | e | false
    if !ok { io.eprint_line("run failed") }
    return 0
}
