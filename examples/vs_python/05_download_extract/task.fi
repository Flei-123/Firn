import std.rt
import std.io
import std.env
import std.fs
import std.fsx
import std.safefs
import std.extract
import appkit.fetch

struct Dir { root: str, kind: str }

fn show(path: str, kind: u8, ctx: u64) -> i32 {
    if kind == fs.KIND_FILE {
        let size: u64 = (fs.stat(path) catch | e | fs.FileInfo { kind: 0, mode: 0, size: 0, mtime_ns: 0 }).size
        let d: *mut Dir = ctx as *mut Dir
        io.fmt_print_line(f"{(*d).kind} {fsx.relpath(path, (*d).root)} {size}")
    }
    return fsx.WALK_CONTINUE
}

fn grab(base: str, name: str, kind: str, tmp: str) {
    var body: rt.Buf = rt.buf_new()
    var status: u32 = 0
    fetch.fetch_get_mem(base + "/" + name, 1 << 20, 5000, false, &body, &status)
    fs.write_file(tmp + "/" + name, rt.buf_ptr(&body), rt.buf_len(&body)) catch 0
    var d: Dir = Dir { root: tmp + "/" + kind, kind: kind }
    extract.extract_archive(tmp + "/" + name, d.root) catch | e | safefs.ExtractStats { files: 0, dirs: 0, links: 0, bytes: 0 }
    fsx.walk(d.root, show, (&d) as u64) catch 0
}

fn run() -> FsError!bool {
    var tmp: fsx.TempDir = try fsx.temp_dir("vspy_")
    defer fsx.temp_dir_drop(&tmp)
    let base: str = "http://127.0.0.1:" + env.get("VSPY_PORT")
    grab(base, "pkg.zip", "zip", fsx.temp_dir_path(&tmp))
    grab(base, "pkg.tar.gz", "tgz", fsx.temp_dir_path(&tmp))
    return true
}

fn main() -> i32 {
    return if run() catch | e | false { 0 } else { 1 }
}
