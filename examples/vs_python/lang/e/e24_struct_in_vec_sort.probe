import std.vec
struct P { age: i32 }
fn by_age(a: *P, b: *P) -> bool { return (*a).age < (*b).age }
fn main() -> i32 {
    var v: Vec[P] = vec_new[P]()
    let a = vec_push[P](&v, P { age: 9 })
    let b = vec_push[P](&v, P { age: 3 })
    vec_sort_by[P](&v, by_age)
    return vec_at[P](&v, 0).age
}
