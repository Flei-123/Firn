import std.vec
fn lt(a: *i32, b: *i32) -> bool { return *a < *b }
fn main() -> i32 {
    var v: Vec[i32] = vec_new[i32]()
    let a = vec_push[i32](&v, 3)
    let b = vec_push[i32](&v, 1)
    let c = vec_push[i32](&v, 2)
    vec_sort_by[i32](&v, lt)
    var s = 0
    var i: usize = 0
    while i < vec_len[i32](&v) { s = s * 10 + vec_at[i32](&v, i); i = i + 1 }
    return s
}
