import std.io
import std.num

error ParseError { Bad }

fn parse(s: str) -> ParseError!i64 {
    let r = num.parse_i64(s)
    if !r.ok { return ParseError::Bad }
    return r.value
}

fn main() -> i32 {
    let inputs: [str; 3] = ["12", "x", "7"]
    for s in inputs {
        io.fmt_print_line(f"{parse(s) catch -1}")
    }
    return 0
}
