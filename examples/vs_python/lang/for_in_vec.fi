// `for x in vec` / `for c in str` (r664). Python: `for x in v:`.
import std.io
import std.vec

fn main() -> i32 {
    var v: Vec[i32] = vec_new[i32]()
    vec_push[i32](&v, 4)
    vec_push[i32](&v, 5)
    var sum: i32 = 0
    for x in v {
        sum += x
    }
    let word: str = "hey"
    var h: u32 = 0
    for c in word {
        h = h * 31 + c as u32
    }
    io.print_line(io.fmt_string(f"{sum} {h}"))
    vec_free[i32](&v)
    return 0
}
