import std.io
import std.vec

struct P { name: str, age: i32 }

fn by_age(a: *P, b: *P) -> bool { return (*a).age < (*b).age }

fn main() -> i32 {
    var ps: Vec[P] = vec_new[P]()
    defer vec_free[P](&ps)
    let ok = vec_push[P](&ps, P { name: "ann", age: 31 }) && vec_push[P](&ps, P { name: "bob", age: 25 }) && vec_push[P](&ps, P { name: "cy", age: 40 })
    vec_sort_by[P](&ps, by_age)
    var total = 0
    var i: usize = 0
    while i < vec_len[P](&ps) {
        let p = *vec_elem_ptr[P](&ps, i)
        io.fmt_print_line(f"{p.name} {p.age}")
        total = total + p.age
        i = i + 1
    }
    io.fmt_print_line(f"{total}")
    return 0
}
