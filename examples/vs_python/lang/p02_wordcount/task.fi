import std.io
import std.dict
import std.str
import std.vec

fn main() -> i32 {
    if !gc_init() { return 1 }
    var d: Dict[i32] = dict_new[i32]()
    var it = str.divisor_whitespace("to be or not to be that is the question to be")
    var w: str = ""
    while str.divisor_next(&it, &w) { dict_inc[i32](&d, w, 1) }
    var top: Vec[DictItem[i32]] = vec_new[DictItem[i32]]()
    dict_top[i32](&d, 3, &top)
    for k in 0..vec_len[DictItem[i32]](&top) {
        let e = *vec_elem_ptr[DictItem[i32]](&top, k)
        io.fmt_print_line(f"{e.key} {e.val}")
    }
    var ks: Vec[str] = vec_new[str]()
    dict_keys_sorted[i32](&d, &ks)
    for k in 0..vec_len[str](&ks) {
        if k > 0 { io.print(",") }
        io.print(*vec_elem_ptr[str](&ks, k))
    }
    io.new_line()
    return 0
}
