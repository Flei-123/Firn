import std.io
import std.map
import std.str
import std.vec

struct E { w: str, n: i32 }

fn before(a: *E, b: *E) -> bool {
    if (*a).n != (*b).n { return (*a).n > (*b).n }
    return str.compare((*a).w, (*b).w) < 0
}

fn alpha(a: *E, b: *E) -> bool { return str.compare((*a).w, (*b).w) < 0 }

fn main() -> i32 {
    let text: str = "to be or not to be that is the question to be"
    var counts: BMap[i32] = bmap_new[i32]()
    defer bmap_free[i32](&counts)
    var d = str.divisor_whitespace(text)
    var w: str = ""
    while str.divisor_next(&d, &w) {
        bmap_increase[i32](&counts, w.p as u64, w.n, 1)
    }
    var es: Vec[E] = vec_new[E]()
    defer vec_free[E](&es)
    var i = bmap_first[i32](&counts)
    while i != bmap_cap[i32](&counts) {
        let ok = vec_push[E](&es, E { w: bmap_key_span[i32](&counts, i), n: bmap_slot_value[i32](&counts, i) })
        i = bmap_next[i32](&counts, i + 1)
    }
    vec_sort_by[E](&es, before)
    var k: usize = 0
    while k < 3 {
        let e = *vec_elem_ptr[E](&es, k)
        io.fmt_print_line(f"{e.w} {e.n}")
        k = k + 1
    }
    vec_sort_by[E](&es, alpha)
    k = 0
    while k < vec_len[E](&es) {
        if k > 0 { io.print(",") }
        io.print((*vec_elem_ptr[E](&es, k)).w)
        k = k + 1
    }
    io.new_line()
    return 0
}
