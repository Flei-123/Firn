import std.rt
import std.io
import std.net
import std.env
import ws.ws

fn chat() -> WsError!bool {
    var c: ws.Client = ws.client_new()
    try ws.connect(&c, net.ADDR_LOCAL, env.get_int("VSPY_PORT", 0) as u16, "127.0.0.1", "/chat")
    var msg: rt.Buf = rt.buf_new()
    let texts: [str; 3] = ["hello", "firn", "bye"]
    for i in 0..3 {
        ws.send_text(&c, texts[i as usize])
        try ws.recv(&c, &msg)
        io.print_line(rt.buf_str(&msg))
    }
    ws.close(&c, 1000)
    return true
}

fn main() -> i32 {
    return if chat() catch | e | false { 0 } else { 1 }
}
