import std.rt
import std.io
import std.csv
import std.json
import std.jsonstr
import std.textfmt
import std.num
import std.str
import std.pystr
import std.vec
import std.vecfn
import std.dict
import std.pycoll

struct Agg {
    name: str,
    manager: str,
    n: i64,
    sum: f64,
}

fn total(a: *Agg) -> f64 { return (*a).sum }

#[allow_fp]
fn main() -> i32 {
    if !gc_init() { return 1 }
    var jd: json.Json = json.json_new()
    let regions: str = pystr.read_text("regions.json")
    let sales: str = pystr.read_text("sales.csv")
    let jok: bool = json.json_parse(&jd, regions.p as u64, regions.n) catch false
    var t: csv.Table = csv.table_parse(sales.p, sales.n)
    if !jok || csv.table_error(&t) != csv.E_NONE { return 1 }
    var byname: Dict[Agg] = dict_new[Agg]()
    for row in 0..csv.rows(&t) {
        let region: str = csv.cell(&t, row, "region")
        let cell: str = csv.cell(&t, row, "amount")
        let amount: f64 = num.f64_or(num.parse_f64(str.span(cell.p, cell.n)), 0.0)
        let m: u32 = jsonstr.get(&jd, json.json_root(&jd), region)
        let a: *mut Agg = dict_ref[Agg](&byname, region, Agg { name: region, manager: jsonstr.string(&jd, jsonstr.get(&jd, m, "manager")), n: 0, sum: 0.0 })
        (*a).n = (*a).n + 1
        (*a).sum = (*a).sum + amount
    }
    var aggs: Vec[Agg] = vec_new[Agg]()
    dict_values[Agg](&byname, &aggs)
    sort_key_f64[Agg](&aggs, total, true)
    io.print_line("region   manager   n       sum      avg")
    var raw: rt.Buf = rt.buf_new()
    var w: json.JsonWriter = json.jw_new(&raw, false)
    json.jw_begin_object(&w)
    for i in 0..vec_len[Agg](&aggs) {
        let a: Agg = vec_item[Agg](&aggs, i)
        let avg: f64 = a.sum / (a.n as f64)
        io.fmt_print_line(f"{a.name:<9}{a.manager:<8}{a.n:>3}{a.sum:>10.2f}{avg:>9.2f}")
        jsonstr.key(&w, a.name)
        json.jw_begin_object(&w)
        jsonstr.key(&w, "avg")
        json.jw_number(&w, textfmt.round_to(avg, 2))
        jsonstr.key(&w, "manager")
        jsonstr.value(&w, a.manager)
        jsonstr.key(&w, "n")
        json.jw_int(&w, a.n)
        jsonstr.key(&w, "sum")
        json.jw_number(&w, textfmt.round_to(a.sum, 2))
        json.jw_end(&w)
    }
    json.jw_end(&w)
    var rep: rt.Buf = rt.buf_new()
    jsonstr.dumps(&raw, 2, true, &rep)
    rt.buf_push(&rep, 10 as u8)
    io.write_file_text("out.json", str { p: rt.buf_data(&rep), n: rt.buf_len(&rep) })
    io.print_bytes(rt.buf_ptr(&rep), rt.buf_len(&rep))
    return 0
}
