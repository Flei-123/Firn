import std.rt
import std.io
import std.csv
import std.json
import std.jsonstr
import std.textfmt
import std.text
import std.num
import std.str

struct Agg {
    name: str,
    manager: str,
    n: i64,
    sum: f64,
}

fn manager_of(d: *mut json.Json, region: str) -> str {
    let m: u32 = jsonstr.get(d, json.json_root(d), region)
    return jsonstr.string(d, jsonstr.get(d, m, "manager"))
}

#[allow_fp]
fn main() -> i32 {
    var jt: io.Text = io.read_file_text("regions.json")
    var jd: json.Json = json.json_new()
    let jok: bool = json.json_parse(&jd, rt.buf_ptr(&jt.b), rt.buf_len(&jt.b)) catch false
    var ct: io.Text = io.read_file_text("sales.csv")
    var t: csv.Table = csv.table_parse(rt.buf_data(&ct.b), rt.buf_len(&ct.b))
    if !jok || csv.table_error(&t) != csv.E_NONE {
        return 1
    }

    var aggs: [Agg; 16] = [Agg { name: "", manager: "", n: 0, sum: 0.0 }; 16]
    var na: usize = 0
    var row: usize = 0
    while row < csv.rows(&t) {
        let region: str = csv.cell(&t, row, "region")
        let amount: f64 = num.f64_or(num.parse_f64(str.span(csv.cell(&t, row, "amount").p, csv.cell(&t, row, "amount").n)), 0.0)
        var k: usize = 0
        while k < na && !aggs[k].name.equal(region) {
            k = k + 1
        }
        if k == na {
            aggs[k] = Agg { name: region, manager: manager_of(&jd, region), n: 0, sum: 0.0 }
            na = na + 1
        }
        aggs[k].n = aggs[k].n + 1
        aggs[k].sum = aggs[k].sum + amount
        row = row + 1
    }
    // sort by sum, descending (insertion sort)
    var i: usize = 1
    while i < na {
        var j: usize = i
        while j > 0 && aggs[j - 1].sum < aggs[j].sum {
            let tmp: Agg = aggs[j]
            aggs[j] = aggs[j - 1]
            aggs[j - 1] = tmp
            j = j - 1
        }
        i = i + 1
    }

    var out: rt.Buf = rt.buf_new()
    textfmt.pad_right(&out, "region", 9)
    textfmt.pad_right(&out, "manager", 8)
    textfmt.pad_left(&out, "n", 3)
    textfmt.pad_left(&out, "sum", 10)
    textfmt.pad_left(&out, "avg", 9)
    rt.buf_push(&out, 10 as u8)
    var raw: rt.Buf = rt.buf_new()
    var w: json.JsonWriter = json.jw_new(&raw, false)
    json.jw_begin_object(&w)
    i = 0
    while i < na {
        let a: Agg = aggs[i]
        let avg: f64 = a.sum / (a.n as f64)
        textfmt.pad_right(&out, a.name, 9)
        textfmt.pad_right(&out, a.manager, 8)
        textfmt.pad_left_i64(&out, a.n, 3)
        textfmt.pad_left_fixed(&out, a.sum, 2, 10)
        textfmt.pad_left_fixed(&out, avg, 2, 9)
        rt.buf_push(&out, 10 as u8)
        jsonstr.key(&w, a.name)
        json.jw_begin_object(&w)
        jsonstr.key(&w, "avg")
        json.jw_number(&w, textfmt.round_to(avg, 2))
        jsonstr.key(&w, "manager")
        jsonstr.value(&w, a.manager)
        jsonstr.key(&w, "n")
        json.jw_int(&w, a.n)
        jsonstr.key(&w, "sum")
        json.jw_number(&w, textfmt.round_to(a.sum, 2))
        json.jw_end(&w)
        i = i + 1
    }
    json.jw_end(&w)
    var rep: rt.Buf = rt.buf_new()
    jsonstr.dumps(&raw, 2, true, &rep)
    rt.buf_push(&rep, 10 as u8)
    io.write_file_text("out.json", str { p: rt.buf_data(&rep), n: rt.buf_len(&rep) })
    io.print_bytes(rt.buf_ptr(&out), rt.buf_len(&out))
    io.print_bytes(rt.buf_ptr(&rep), rt.buf_len(&rep))
    return 0
}
