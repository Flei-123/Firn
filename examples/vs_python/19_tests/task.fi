import std.testkit
import std.rt
import std.text
import money

const PRICES: str = "0.40,2.5,12" // fixture: a price list

fn assert_cents(s: str, cents: i64) { // assert helper
    testkit.context(s)
    testkit.assert_eq_i64(money.parse_cents(s), cents)
}

fn assert_fmt(cents: i64, want: str) { // assert helper
    var b: rt.Buf = rt.buf_new()
    money.format_cents(cents, &b)
    testkit.assert_eq_bytes(rt.buf_ptr(&b), rt.buf_len(&b), want.p as u64, want.n)
    rt.buf_free(&b)
}

#[test]
fn parse_valid() {
    assert_cents("12.34", 1234)
    assert_cents("5", 500)
    assert_cents("5.5", 550)
    assert_cents("0.05", 5)
}

#[test]
fn parse_invalid() {
    var i: usize = 0
    while i < 6 {
        let s: str = text.field(",abc,1.234,1..2,.5,-3", ",", i)
        testkit.context(s)
        testkit.assert_eq_i64(money.parse_cents(s), -1)
        i = i + 1
    }
}

#[test]
fn format() {
    assert_fmt(0, "0.00")
    assert_fmt(5, "0.05")
    assert_fmt(1234, "12.34")
    assert_fmt(100000, "1000.00")
}

#[test]
fn roundtrip() {
    var i: usize = 0
    while i < 3 {
        let c: i64 = money.parse_cents(text.field(PRICES, ",", i))
        var b: rt.Buf = rt.buf_new()
        money.format_cents(c, &b)
        testkit.assert_eq_i64(money.parse_cents(str { p: rt.buf_ptr(&b) as *mut u8, n: rt.buf_len(&b) }), c)
        rt.buf_free(&b)
        i = i + 1
    }
}

#[test]
fn vat() {
    testkit.assert_eq_i64(money.add_vat(1000, 20), 1200)
    testkit.assert_eq_i64(money.add_vat(999, 20), 1199)
    testkit.assert_eq_i64(money.add_vat(1, 20), 1)
    testkit.assert_eq_i64(money.add_vat(0, 20), 0)
}

#[test]
fn vat_zero_percent_is_identity() {
    var i: usize = 0
    while i < 3 {
        let c: i64 = money.parse_cents(text.field(PRICES, ",", i))
        testkit.assert_eq_i64(money.add_vat(c, 0), c)
        i = i + 1
    }
}

fn share_sum(total: i64, n: i64) -> i64 {
    var sum: i64 = 0
    var i: i64 = 0
    while i < n {
        sum = sum + money.share(total, n, i)
        i = i + 1
    }
    return sum
}

#[test]
fn share_sums_to_total() {
    testkit.assert_eq_i64(share_sum(100, 3), 100)
    testkit.assert_eq_i64(share_sum(1, 5), 1)
    testkit.assert_eq_i64(share_sum(999, 7), 999)
    testkit.assert_eq_i64(share_sum(0, 4), 0)
}

#[test]
fn share_differs_by_at_most_one_cent() {
    var lo: i64 = money.share(1000, 7, 0)
    var hi: i64 = lo
    var i: i64 = 1
    while i < 7 {
        let p: i64 = money.share(1000, 7, i)
        if p < lo { lo = p }
        if p > hi { hi = p }
        i = i + 1
    }
    testkit.assert_true(hi - lo <= 1, "shares differ by more than one cent")
}
