import std.testkit
import std.rt
import std.text
import money

const PRICES: str = "0.40,2.5,12" // fixture: a price list

fn vat20(c: i64) -> i64 { return money.add_vat(c, 20) }
fn vat0(c: i64) -> i64 { return money.add_vat(c, 0) }
fn zero_vat(price: str, ctx: u64) { testkit.assert_eq_i64(vat0(money.parse_cents(price)), money.parse_cents(price)) }

fn roundtrip_one(price: str, ctx: u64) {
    let c: i64 = money.parse_cents(price)
    var b: rt.Buf = rt.buf_new()
    money.format_cents(c, &b)
    testkit.assert_eq_i64(money.parse_cents(str { p: rt.buf_ptr(&b) as *mut u8, n: rt.buf_len(&b) }), c)
    rt.buf_free(&b)
}

fn share_sum(total: i64, n: i64) -> i64 {
    var sum: i64 = 0
    for i in 0..n { sum = sum + money.share(total, n, i) }
    return sum
}

#[test]
fn parse_valid() { testkit.table_str_i64(money.parse_cents, "12.34=1234,5=500,5.5=550,0.05=5") }

#[test]
fn parse_invalid() { testkit.table_str_i64(money.parse_cents, "=-1,abc=-1,1.234=-1,1..2=-1,.5=-1,-3=-1") }

#[test]
fn format() { testkit.table_i64_str(money.format_cents, "0=0.00,5=0.05,1234=12.34,100000=1000.00") }

#[test]
fn roundtrip() { testkit.each_field(PRICES, ",", roundtrip_one, 0) }

#[test]
fn vat_zero_percent_is_identity() { testkit.each_field(PRICES, ",", zero_vat, 0) }

#[test]
fn vat() { testkit.table_i64_i64(vat20, "1000=1200,999=1199,1=1,0=0") }

#[test]
fn share_sums_to_total() {
    testkit.assert_eq_i64(share_sum(100, 3), 100)
    testkit.assert_eq_i64(share_sum(1, 5), 1)
    testkit.assert_eq_i64(share_sum(999, 7), 999)
    testkit.assert_eq_i64(share_sum(0, 4), 0)
}

#[test]
fn share_differs_by_at_most_one_cent() {
    var lo: i64 = money.share(1000, 7, 0)
    var hi: i64 = lo
    for i in 1 as i64..7 as i64 {
        let p: i64 = money.share(1000, 7, i)
        if p < lo { lo = p }
        if p > hi { hi = p }
    }
    testkit.assert_true(hi - lo <= 1, "shares differ by more than one cent")
}
