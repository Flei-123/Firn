// Module under test: money in cents.
import std.rt

export { parse_cents, format_cents, add_vat, share }

// "12.34" -> 1234, "5" -> 500, "5.5" -> 550; -1 when invalid
fn parse_cents(s: str) -> i64 {
    var whole: i64 = 0
    var frac: i64 = 0
    var fd: usize = 0
    var dot: bool = false
    var i: usize = 0
    if s.n == 0 { return -1 }
    while i < s.n {
        let ch: u8 = *(s.p + i)
        if ch == 46 {
            if dot || i == 0 { return -1 }
            dot = true
        } else if ch >= 48 && ch <= 57 {
            if dot {
                if fd == 2 { return -1 }
                frac = frac * 10 + (ch - 48) as i64
                fd = fd + 1
            } else {
                whole = whole * 10 + (ch - 48) as i64
            }
        } else {
            return -1
        }
        i = i + 1
    }
    if fd == 1 { frac = frac * 10 }
    return whole * 100 + frac
}

fn format_cents(c: i64, out: *mut rt.Buf) {
    rt.buf_push_dec_u64(out, (c / 100) as u64)
    rt.buf_push(out, 46)
    if c % 100 < 10 { rt.buf_push(out, 48) }
    rt.buf_push_dec_u64(out, (c % 100) as u64)
}

fn add_vat(c: i64, pct: i64) -> i64 {
    return (c * (100 + pct) + 50) / 100
}

// part i of c split into n shares that differ by at most one cent
fn share(c: i64, n: i64, i: i64) -> i64 {
    if i < c % n { return c / n + 1 }
    return c / n
}
