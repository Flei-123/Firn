import std.io
import std.env
import mail.mail

fn main() -> i32 {
    var m: mail.Mail = mail.message("alice@example.com", "bob@example.com", "Report", "Hello Bob,\nthe report is attached.\n")
    mail.attach(&m, "report.csv", "text/csv", "id,qty\n1,3\n2,5\n")
    if mail.send("127.0.0.1", env.get_int("VSPY_PORT", 25) as u16, &m) {
        io.print_line("sent")
    }
    return 0
}
