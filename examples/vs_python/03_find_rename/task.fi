import std.io
import std.rt
import std.vec
import std.fs
import std.fsx
import std.glob

static mut ZEROS: [u8; 4096] = [0; 4096]

struct Query {
    pat: str,
    min_size: u64,
    max_mtime_ns: i64,
    found: Vec[str],
}

fn visit(path: str, kind: u8, ctx: u64) -> i32 {
    let q: *mut Query = ctx as *mut Query
    if kind != fs.KIND_FILE || !glob.matches((*q).pat, fs.path_name(path)) {
        return fsx.WALK_CONTINUE
    }
    let st: fs.FileInfo = fs.stat(path) catch | e | fs.FileInfo { kind: 0 as u8, mode: 0 as u32, size: 0 as u64, mtime_ns: 0 }
    if st.size >= (*q).min_size && st.mtime_ns < (*q).max_mtime_ns {
        vec_push[str](&(*q).found, __str_copy(path))
    }
    return fsx.WALK_CONTINUE
}

fn find(root: str, pat: str, min_size: u64, max_mtime_ns: i64) -> Vec[str] {
    var q: Query = Query { pat: pat, min_size: min_size, max_mtime_ns: max_mtime_ns, found: vec_new[str]() }
    fsx.walk(root, visit, (&q) as u64) catch 0
    return q.found
}

fn rename_all(root: str, files: *mut Vec[str], prefix: str, dry_run: bool) -> FsError!bool {
    for i in 0..vec_len[str](files) {
        let p: str = *vec_elem_ptr[str](files, i)
        let new: str = fs.path_join(fs.path_parent(p), prefix + fs.path_name(p).without_suffix(".txt") + ".md")
        var verb: str = "rename"
        if dry_run {
            verb = "would rename"
        }
        let from: str = fsx.relpath(p, root)
        let to: str = fsx.relpath(new, root)
        io.fmt_print_line(f"{verb} {from} -> {to}")
        if !dry_run {
            try fs.rename(p, new)
        }
    }
    return true
}

#[allow_escape]
fn run() -> FsError!bool {
    var d: fsx.TempDir = try fsx.temp_dir("vspy03_")
    defer fsx.temp_dir_drop(&d)
    let root: str = fsx.temp_dir_path(&d)
    for i in 0..24 {
        let dir: str = io.fmt_string(f"{root}/d{i % 4}/s{i % 3}")
        try fs.mkdir_all(dir)
        var ext: str = "txt"
        if i % 4 == 1 {
            ext = "log"
        } else if i % 4 == 3 {
            ext = "md"
        }
        let p: str = io.fmt_string(f"{dir}/f{i / 10}{i % 10}.{ext}")
        try fs.write_file(p, (&ZEROS[0]) as u64, (i * 100) as usize)
        try fs.set_mtime(p, 1000000 + (i * 1000) as i64, true)
    }
    var files: Vec[str] = find(root, "*.txt", 500, 1015000 * 1000000000)
    try rename_all(root, &files, "old_", true)
    try rename_all(root, &files, "old_", false)
    let left: Vec[str] = find(root, "*.txt", 0, 4000000000000000000)
    let olds: Vec[str] = find(root, "old_*.md", 0, 4000000000000000000)
    io.fmt_print_line(f"{vec_len[str](&files)} renamed, {vec_len[str](&left)} txt left, {vec_len[str](&olds)} old_*.md")
    return true
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    let ok: bool = run() catch | e | false
    if !ok { io.eprint_line("failed") }
    return 0
}
