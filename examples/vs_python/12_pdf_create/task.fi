import std.io
import std.fs
import std.rt
import std.text
import jpeg.jpeg
import pdf.pdf

const PARA: str = "Firn compiles to small native programs and ships its own libraries for images, documents, networking and user interfaces. This report was written by one short program without any third party package."
const ROWS: str = "Fruit,Weight,Price;Apple,120,0.40;Banana,150,0.25;Cherry,8,0.10"

fn say(d: *mut pdf.Pdf, f: u32, size: f64, x: f64, y: f64, s: str) {
    pdf.pdf_text(d, f, size, x, y, s) catch false
}

// greedy word wrap by measured width; returns the y below the last line
fn paragraph(d: *mut pdf.Pdf, f: u32, x: f64, y0: f64, width: f64, s: str) -> f64 {
    var line: str = ""
    var y: f64 = y0
    var i: usize = 0
    while text.field(s, " ", i).n > 0 {
        let word: str = text.field(s, " ", i)
        var cand: str = word
        if line.n > 0 { cand = line + " " + word }
        if line.n > 0 && pdf.pdf_text_width(d, f, 11.0, cand) > width {
            say(d, f, 11.0, x, y, line)
            y = y + 5.5
            cand = word
        }
        line = cand
        i = i + 1
    }
    say(d, f, 11.0, x, y, line)
    return y + 5.5
}

fn main() -> i32 {
    var font: rt.Buf = rt.buf_new()
    let _n: usize = fs.read_file("../../../tests/data/fonts/FirnSans.ttf", &font) catch 0
    var raw: rt.Buf = rt.buf_new()
    let _m: usize = fs.read_file("photo.jpg", &raw) catch 0
    var im: jpeg.JpegImage = jpeg.jpeg_image_new()
    jpeg.jpeg_decode(rt.buf_ptr(&raw), rt.buf_len(&raw), &im) catch false
    var out: rt.Buf = rt.buf_new()
    var opts: pdf.PdfOptions = pdf.pdf_options_default()
    opts.title = "Quarterly Report"
    var d: pdf.Pdf = pdf.pdf_new(&out, opts)
    let f: u32 = pdf.pdf_font_load(&d, rt.buf_ptr(&font), rt.buf_len(&font)) catch 0 as u32
    pdf.pdf_page_begin(&d, 210.0, 297.0)
    say(&d, f, 22.0, 18.0, 26.0, "Quarterly Report")
    paragraph(&d, f, 18.0, 38.0, 174.0, PARA)
    var r: usize = 0
    while text.field(ROWS, ";", r).n > 0 {
        let row: str = text.field(ROWS, ";", r)
        var k: usize = 0
        while text.field(row, ",", k).n > 0 {
            let x: f64 = 18.0 + (k as f64) * 42.0
            let y: f64 = 82.0 + (r as f64) * 8.5
            pdf.pdf_rect(&d, x, y, 42.0, 8.5)
            pdf.pdf_stroke(&d)
            say(&d, f, 11.0, x + 2.0, y + 6.0, text.field(row, ",", k))
            k = k + 1
        }
        r = r + 1
    }
    pdf.pdf_image_rgba(&d, rt.buf_ptr(&im.px), im.w, im.h, 18.0, 125.0, 84.0, 63.0) catch false
    pdf.pdf_page_end(&d)
    pdf.pdf_page_begin(&d, 210.0, 297.0)
    say(&d, f, 16.0, 18.0, 26.0, "Page 2")
    say(&d, f, 11.0, 18.0, 36.0, "Second page: the data is in the table on page 1.")
    pdf.pdf_page_end(&d)
    pdf.pdf_finish(&d) catch 0
    fs.write_file("out.pdf", rt.buf_ptr(&out), rt.buf_len(&out)) catch 0
    io.fmt_print_line(f"pages {pdf.pdf_page_count(&d)}")
    io.fmt_print_line(f"image {im.w}x{im.h}")
    return 0
}
