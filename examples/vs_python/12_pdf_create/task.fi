import std.io
import std.fs
import std.rt
import pdf.pdfflow

const PARA: str = "Firn compiles to small native programs and ships its own libraries for images, documents, networking and user interfaces. This report was written by one short program without any third party package."

fn main() -> i32 {
    var font: rt.Buf = rt.buf_new()
    var photo: rt.Buf = rt.buf_new()
    fs.read_file("../../../tests/data/fonts/FirnSans.ttf", &font) catch 0
    fs.read_file("photo.jpg", &photo) catch 0
    var out: rt.Buf = rt.buf_new()
    var fl: pdfflow.Flow = pdfflow.flow_new(&out, rt.buf_ptr(&font), rt.buf_len(&font), "Quarterly Report")
    pdfflow.heading(&fl, "Quarterly Report")
    pdfflow.paragraph(&fl, PARA)
    pdfflow.table(&fl, "Fruit,Weight,Price;Apple,120,0.40;Banana,150,0.25;Cherry,8,0.10", ";", ",", true)
    pdfflow.image_jpeg(&fl, rt.buf_ptr(&photo), rt.buf_len(&photo), 84.0)
    pdfflow.page_break(&fl)
    pdfflow.heading(&fl, "Page 2")
    pdfflow.paragraph(&fl, "Second page: the data is in the table on page 1.")
    pdfflow.finish(&fl)
    fs.write_file("out.pdf", rt.buf_ptr(&out), rt.buf_len(&out)) catch 0
    io.fmt_print_line(f"pages {pdfflow.page_count(&fl)}")
    io.fmt_print_line(f"image {fl.img_w}x{fl.img_h}")
    return 0
}
