import std.io
import paint.draw

const W: f64 = 160.0
const H: f64 = 120.0
const R: f64 = 5.0
const PW: f64 = 30.0
const PH: f64 = 6.0
const PY: f64 = 108.0

fn clamp(v: f64, lo: f64, hi: f64) -> f64 {
    if v < lo { return lo }
    if v > hi { return hi }
    return v
}

fn main() -> i32 {
    var bx: f64 = 20.0
    var by: f64 = 30.0
    var vx: f64 = 3.25
    var vy: f64 = 2.5
    var px: f64 = 0.0
    var hits: i64 = 0
    var misses: i64 = 0
    var bounces: i64 = 0
    var frame: i64 = 0
    while frame < 120 {
        bx = bx + vx
        by = by + vy
        if bx < R || bx > W - R {
            bx = clamp(bx, R, W - R)
            vx = -vx
            bounces = bounces + 1
        }
        if by < R {
            by = R
            vy = -vy
            bounces = bounces + 1
        }
        px = px + clamp(clamp(bx - PW / 2.0, 0.0, W - PW) - px, -3.0, 3.0)
        if vy > 0.0 && PY <= by + R && by - R <= PY + PH && px <= bx && bx <= px + PW {
            by = PY - R
            vy = -vy
            hits = hits + 1
        } else if by > H + R {
            by = 30.0
            misses = misses + 1
        }
        frame = frame + 1
    }
    var d: draw.Draw = draw.new(160, 120, draw.rgb(20, 20, 40))
    draw.rect(&d, px, PY, PW, PH, draw.rgb(230, 230, 230))
    draw.circle(&d, bx, by, R, draw.rgb(255, 200, 0))
    draw.save(&d, "out.ppm")
    io.fmt_print_line(f"frames {frame}")
    io.fmt_print_line(f"hits {hits} misses {misses} bounces {bounces}")
    io.fmt_print_line(f"ball {(bx * 100.0) as i64} {(by * 100.0) as i64} paddle {(px * 100.0) as i64}")
    return 0
}
