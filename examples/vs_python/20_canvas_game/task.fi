import std.io
import std.fs
import std.rt
import html.mem
import paint.canvas
import paint.png
import fui.painter

const W: f64 = 160.0
const H: f64 = 120.0
const R: f64 = 5.0
const PW: f64 = 30.0
const PH: f64 = 6.0
const PY: f64 = 108.0

fn clamp(v: f64, lo: f64, hi: f64) -> f64 {
    if v < lo { return lo }
    if v > hi { return hi }
    return v
}

fn main() -> i32 {
    var bx: f64 = 20.0
    var by: f64 = 30.0
    var vx: f64 = 3.25
    var vy: f64 = 2.5
    var px: f64 = 0.0
    var hits: i64 = 0
    var misses: i64 = 0
    var bounces: i64 = 0
    var frame: i64 = 0
    while frame < 120 {
        bx = bx + vx
        by = by + vy
        if bx < R || bx > W - R {
            bx = clamp(bx, R, W - R)
            vx = -vx
            bounces = bounces + 1
        }
        if by < R {
            by = R
            vy = -vy
            bounces = bounces + 1
        }
        px = px + clamp(clamp(bx - PW / 2.0, 0.0, W - PW) - px, -3.0, 3.0)
        if vy > 0.0 && PY <= by + R && by - R <= PY + PH && px <= bx && bx <= px + PW {
            by = PY - R
            vy = -vy
            hits = hits + 1
        } else if by > H + R {
            by = 30.0
            misses = misses + 1
        }
        frame = frame + 1
    }
    var cv: canvas.Canvas = canvas.canvas_new()
    canvas.canvas_init(&cv, 160, 120)
    var z: painter.Painter = painter.painter_new()
    painter.painter_init(&z, &cv, 160, 120)
    canvas.canvas_clear(&cv, canvas.color_of(255, 20, 20, 40))
    painter.round_rect(&z, px, PY, PW, PH, 0.0, canvas.color_of(255, 230, 230, 230))
    painter.round_rect(&z, bx - R, by - R, 2.0 * R, 2.0 * R, R, canvas.color_of(255, 255, 200, 0))
    var out: mem.Buf = mem.buf_new()
    png.write_ppm(&cv, &out)
    fs.write_file("out.ppm", mem.buf_ptr(&out) as u64, mem.buf_len(&out)) catch 0
    io.fmt_print_line(f"frames {frame}")
    io.fmt_print_line(f"hits {hits} misses {misses} bounces {bounces}")
    io.fmt_print_line(f"ball {(bx * 100.0) as i64} {(by * 100.0) as i64} paddle {(px * 100.0) as i64}")
    return 0
}
