import std.io
import std.args

fn main() -> i32 {
    if !gc_init() { return 1 }
    var p: args.Cmd = args.cmd("tool", "item tool")
    let add: *mut args.Cmd = args.sub(&p, "add", "add an item")
    args.opt(add, "--name", args.STR | args.REQUIRED, "", "item name")
    args.opt(add, "--count", args.INT, "1", "how many")
    args.opt(add, "-v,--verbose", args.FLAG, "", "verbose output")
    let rm: *mut args.Cmd = args.sub(&p, "rm", "remove an item")
    args.pos(rm, "id", args.INT, "item id")
    args.opt(rm, "--force", args.FLAG, "", "no questions")
    let lines: [str; 10] = ["add --name X --count 3 -v", "add --name Y", "rm 7 --force", "add --name Z --count abc",
        "add", "frob", "add --name Q --bogus", "rm", "add --help", "--help"]
    for line in lines {
        io.print_line("$ tool " + line)
        var r: args.Result = args.parse_words(&p, line)
        if r.status != args.OK {
            io.print_line(r.text)
        } else if r.cmd == "add" {
            let name: str = args.get(&r, "name")
            let count: i64 = args.get_int(&r, "count")
            let verbose: bool = args.is_set(&r, "verbose")
            io.fmt_print_line(f"add name={name} count={count} verbose={verbose}")
        } else {
            let id: i64 = args.get_int(&r, "id")
            let force: bool = args.is_set(&r, "force")
            io.fmt_print_line(f"rm id={id} force={force}")
        }
    }
    return 0
}
