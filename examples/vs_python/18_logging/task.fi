import std.io
import std.fs
import std.fsx
import std.log
import std.pystr

fn show(path: str, kind: u8, ctx: u64) -> i32 {
    if kind == fs.KIND_FILE {
        io.fmt_print_line(f"== {fs.path_name(path)}")
        io.print(pystr.read_text(path))
    }
    return fsx.WALK_CONTINUE
}

#[allow_escape]
fn run() -> FsError!bool {
    var d: fsx.TempDir = try fsx.temp_dir("vspy18_")
    defer fsx.temp_dir_drop(&d)
    var lg: log.Logging = log.logging(log.INFO, "%(asctime)s %(levelname)-8s %(name)s: %(message)s")
    log.add_file(&lg, fsx.temp_dir_path(&d) + "/app.log", log.NOTSET, 250, 2)
    log.add_stream(&lg, level: log.WARNING)
    log.set_level(&lg, "app.db", log.DEBUG)
    log.debug(&lg, "app", "hidden")
    log.info(&lg, "app", "start 1")
    log.debug(&lg, "app.db", "query select 1")
    log.warning(&lg, "app", "slow")
    log.err(&lg, "app.db", "failed: x")
    for i in 0..10 {
        log.infof(&lg, "app", f"event {i}")
    }
    log.close(&lg)
    try fsx.walk(fsx.temp_dir_path(&d), show, 0)
    return true
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    let ok: bool = run() catch | e | false
    if !ok { io.eprint_line("failed") }
    return 0
}
