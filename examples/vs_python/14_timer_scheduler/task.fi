import std.io
import async.loop

static mut EV: [u8; 64] = [0; 64]
static mut N: usize = 0
static mut HB: u64 = 0

fn mark(l: *mut loop.Loop, ud: u64) {
    EV[N] = ud as u8
    N = N + 1
}

fn cancel_b(l: *mut loop.Loop, ud: u64) {
    loop.timer_cancel(l, HB)
}

fn halt(l: *mut loop.Loop, ud: u64) {
    loop.stop(l)
}

fn main() -> i32 {
    var l: loop.Loop = loop.loop_new()
    loop.loop_init(&l)
    loop.timer_every(&l, 50, mark, 97)
    HB = loop.timer_every(&l, 70, mark, 98)
    loop.timer_every(&l, 110, mark, 99)
    loop.timer_after(&l, 175, mark, 111)
    loop.timer_after(&l, 230, cancel_b, 0)
    loop.timer_after(&l, 385, halt, 0)
    loop.run(&l)
    var counts: [u32; 4] = [0; 4]
    var i: usize = 0
    while i < N {
        if i > 0 {
            io.print(" ")
        }
        io.print(str { p: &EV[i], n: 1 })
        var k: usize = 3
        if EV[i] != 111 {
            k = (EV[i] - 97) as usize
        }
        counts[k] = counts[k] + 1
        i = i + 1
    }
    io.new_line()
    io.fmt_print_line(f"a={counts[0]} b={counts[1]} c={counts[2]} o={counts[3]}")
    return 0
}
