import std.io
import std.fs
import std.rt
import jpeg.jpeg
import paint.png
import pack.icons

fn main() -> i32 {
    var raw: rt.Buf = rt.buf_new()
    let _n: usize = fs.read_file("in.jpg", &raw) catch 0
    var im: jpeg.JpegImage = jpeg.jpeg_image_new()
    jpeg.jpeg_decode(rt.buf_ptr(&raw), rt.buf_len(&raw), &im) catch false
    let w: usize = (im.w / 2) as usize
    let h: usize = (im.h / 2) as usize
    var small: rt.Buf = rt.buf_new()
    icons.resample(rt.buf_ptr(&im.px), im.w as usize, im.h as usize, &small, w, h)
    var out: rt.Buf = rt.buf_new()
    icons.png_encode(rt.buf_ptr(&small), w, h, &out)
    fs.write_file("out.png", rt.buf_ptr(&out), rt.buf_len(&out)) catch 0
    var back: png.Image = png.image_new()
    png.decode_png(rt.buf_ptr(&out), rt.buf_len(&out), &back)
    io.fmt_print_line(f"in {im.w}x{im.h}")
    io.fmt_print_line(f"out {png.image_width(&back)}x{png.image_height(&back)}")
    return 0
}
