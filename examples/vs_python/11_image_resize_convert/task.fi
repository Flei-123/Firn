import std.io
import image.picture

fn main() -> i32 {
    var im: picture.Picture = picture.open("in.jpg")
    var small: picture.Picture = picture.resized(&im, picture.width(&im) / 2, picture.height(&im) / 2)
    picture.save(&small, "out.png")
    var back: picture.Picture = picture.open("out.png")
    io.fmt_print_line(f"in {picture.width(&im)}x{picture.height(&im)}")
    io.fmt_print_line(f"out {picture.width(&back)}x{picture.height(&back)}")
    return 0
}
