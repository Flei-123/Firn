import regex.regex
import regex.pyre
import std.io
import std.dict
import std.pystr
import std.vec
import std.vecfn

fn main() -> i32 {
    if !gc_init() { return 1 }
    let text: str = pystr.read_text("notes.txt")
    var found: Vec[str] = vec_new[str]()

    var mail: regex.Regex = pyre.compile("[\\w.]+@[\\w.]+\\.[a-z]{2,}", 0)
    pyre.findall(&mail, text, &found)
    pystr.sorted_set(&found)
    io.fmt_print_line(f"emails: {vec_len[str](&found)}")
    for i in 0..vec_len[str](&found) { io.fmt_print_line(f"  {vec_item[str](&found, i)}") }

    var day: regex.Regex = pyre.compile("\\d{4}-\\d{2}-\\d{2}", 0)
    pyre.findall(&day, text, &found)
    let dates: str = pystr.join(&found, " ")
    io.fmt_print_line(f"dates: {dates}")

    var line: regex.Regex = pyre.compile("^(\\S+ \\S+) \\[(\\w+)\\] (\\w+): (.*)$", regex.REGEX_MULTILINE)
    var levels: Dict[i32] = dict_new[i32]()
    var it: pyre.Finditer = pyre.finditer_new(&line, text)
    var m: regex.Match = regex.match_new()
    while pyre.finditer_next(&it, &m) {
        let level: str = regex.match_group_text(&m, text, 2)
        dict_inc[i32](&levels, level, 1)
        if level == "ERROR" {
            let ts: str = regex.match_group_text(&m, text, 1)
            let mod: str = regex.match_group_text(&m, text, 3)
            let msg: str = regex.match_group_text(&m, text, 4)
            io.fmt_print_line(f"error at {ts} in {mod}: {msg}")
        }
    }
    vec_clear[str](&found)
    dict_keys_sorted[i32](&levels, &found)
    io.print("levels:")
    for i in 0..vec_len[str](&found) {
        let k: str = vec_item[str](&found, i)
        io.fmt_print(f" {k}={dict_get[i32](&levels, k)}")
    }
    io.print_line("")

    pystr.splitlines(text, &found)
    var ymd: regex.Regex = pyre.compile("(\\d{4})-(\\d{2})-(\\d{2})", 0)
    io.print_line(pyre.sub(&ymd, "\\3.\\2.\\1", vec_item[str](&found, vec_len[str](&found) - 1)))

    var word: regex.Regex = pyre.compile("[a-z]+", 0)
    pyre.findall(&word, pystr.lower(text), &found)
    io.fmt_print_line(f"words: {vec_len[str](&found)}")
    var counts: Dict[i32] = dict_new[i32]()
    for i in 0..vec_len[str](&found) { dict_inc[i32](&counts, vec_item[str](&found, i), 1) }
    var top: Vec[DictItem[i32]] = vec_new[DictItem[i32]]()
    dict_top[i32](&counts, 10, &top)
    for i in 0..vec_len[DictItem[i32]](&top) {
        let w: DictItem[i32] = vec_item[DictItem[i32]](&top, i)
        io.fmt_print_line(f"{pystr.ljust(w.key, 10, 32 as u8)}{w.val}")
    }
    return 0
}
