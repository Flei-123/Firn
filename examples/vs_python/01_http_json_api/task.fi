import std.rt
import std.io
import std.net
import std.json
import http.server as srv
import net.web

struct Store {
    items: rt.Buf, // the stored items, joined by ", "
    count: u32,
}

fn on_items(r: *mut srv.Req) {
    let st: *mut Store = srv.userdata(r) as *mut Store
    let b: *mut rt.Buf = &(*st).items
    if srv.path(r) != "/items" {
        srv.reply(r, 404, "application/json", "{\"error\": \"not found\"}")
    } else if srv.method(r) == "GET" {
        srv.reply(r, 200, "application/json", "[" + rt.buf_str(b) + "]")
    } else {
        var d: json.Json = json.json_new()
        let ok: bool = json.json_parse(&d, srv.body(r).p as u64, srv.body(r).n) catch false
        if !ok {
            srv.reply(r, 400, "application/json", "{\"error\": \"bad json\"}")
            return
        }
        if (*st).count > 0 as u32 { rt.buf_push_bytes(b, ", ".p as u64, 2) }
        rt.buf_push_bytes(b, srv.body(r).p as u64, srv.body(r).n)
        srv.reply(r, 201, "application/json", "{\"id\": " + io.fmt_string(f"{(*st).count}") + "}")
        (*st).count = (*st).count + 1 as u32
    }
}

fn __thread_work(kind: u64, arg: u64) -> u64 {
    return srv.serve_main(arg)
}

fn call(base: str, path: str, data: str) {
    var out: rt.Buf = rt.buf_new()
    let st: u32 = if data.n == 0 { web.get(base + path, &out) } else { web.post_json(base + path, data, &out) }
    io.fmt_print_line(f"{st} {rt.buf_str(&out)}")
}

#[allow_escape]
fn main() -> i32 {
    var store: Store = Store { items: rt.buf_new(), count: 0 as u32 }
    var app: srv.App = srv.app(0)
    app.addr = net.ADDR_LOCAL
    srv.set_quiet(&app, true)
    srv.set_userdata(&app, (&store) as u64)
    srv.route(&app, "/items", on_items)
    srv.route(&app, "/nope", on_items)
    let th: u64 = srv.serve_background(&app)
    let base: str = io.fmt_string(f"http://127.0.0.1:{srv.port(&app)}")
    call(base, "/items", "{\"name\": \"apple\", \"qty\": 3}")
    call(base, "/items", "{\"name\": \"pear\", \"qty\": 5}")
    call(base, "/items", "")
    call(base, "/nope", "")
    call(base, "/items", "{oops")
    srv.stop_wait(&app, th)
    return 0
}
