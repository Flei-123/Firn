import fui.app
import fui.vlist
import std.text

static mut LIST: usize = 0
static mut NAME: usize = 0

fn row(ud: u64, i: usize, r: *mut vlist.VRow) {
    vlist.vrow_text(r, *vec_elem_ptr[str](ud as *mut Vec[str], i))
}

fn add(a: *mut app.App) {
    let items: *mut Vec[str] = app.data(a) as *mut Vec[str]
    if app.text(a, NAME).n > 0 {
        vec_push[str](items, text.dup(app.text(a, NAME)))
        app.vlist_set_count(a, LIST, vec_len[str](items))
        app.set_text(a, NAME, "")
    }
}

#[allow_escape]
fn main() -> i32 {
    var items: Vec[str] = vec_new[str]()
    let a: *mut app.App = app.window("Items", 320, 300)
    app.set_data(a, (&items) as u64)
    LIST = app.vlist_new(a, "Items", 300, 160, 0, row, (&items) as u64)
    NAME = app.entry(a, "New item")
    app.button(a, "Add", add)
    return app.run(a)
}
