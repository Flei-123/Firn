import std.rt
import std.json
import fui.app
import fui.appctl
import fui.appshot
import fui.lay
import fui.skin
import fui.jsontree
import fui.tsvtable
import fui.vlist

static mut TP: u64 = 0
static mut TREE: usize = 0
static mut SEARCH: usize = 0
static mut LIST: usize = 0
static mut COUNT: usize = 0

fn tt() -> *mut tsvtable.Tsv { return TP as *mut tsvtable.Tsv }

fn cell(ud: u64, i: usize, r: *mut vlist.VRow) {
    if (*r).col == 1 {
        tsvtable.put_size(r, tsvtable.tsv_num(tt(), tsvtable.tsv_row_of(tt(), i), 1))
    } else {
        tsvtable.tsv_put(tt(), i, (*r).col, r)
    }
}

fn refresh(a: *mut app.App) {
    app.vlist_set_count(a, LIST, tsvtable.tsv_shown(tt()))
    app.set_number(a, COUNT, tsvtable.tsv_shown(tt()) as i64)
}

fn on_search(a: *mut app.App, id: usize) {
    tsvtable.tsv_filter(tt(), 0, 0, app.text(a, SEARCH))
    refresh(a)
}

fn on_tree(a: *mut app.App, id: usize) {
    var s: str = appctl.tree_label(a, TREE, appctl.tree_selected(a, TREE))
    if appctl.tree_selected(a, TREE) == 0 {
        s = ""
    }
    tsvtable.tsv_filter(tt(), 1, 4, s)
    refresh(a)
}

fn on_sort(a: *mut app.App, id: usize, col: usize) {
    let v: *mut vlist.Vlist = app.vlist_model(a, LIST)
    tsvtable.tsv_sort(tt(), vlist.vl_sort_col(v), vlist.vl_sort_desc(v))
    app.vlist_changed(a, LIST)
}

fn main(start: u64) -> i32 {
    var buf: rt.Buf = rt.buf_new()
    TP = rt.heap_alloc(1024)
    *tt() = tsvtable.tsv_new()
    let doc: *mut json.Json = rt.heap_alloc(256) as *mut json.Json
    *doc = json.json_new()
    appshot.load_data(start, "files.tsv", &buf)
    tsvtable.tsv_load(tt(), &buf)
    tsvtable.tsv_set_numeric(tt(), 2)
    var js: rt.Buf = rt.buf_new()
    appshot.load_data(start, "tree.json", &js)
    let ok: bool = json.json_parse(doc, rt.buf_ptr(&js), rt.buf_len(&js)) catch false
    let a: *mut app.App = app.window("Files", 1100, 700)
    skin.install(a)
    lay.page(a)
    let page: usize = lay.hbox(a)
    lay.grow(a, page, 1000)
    let side: usize = lay.vbox(a)
    skin.add(a, side, skin.K_SIDE)
    lay.size(a, side, 240, 0)
    lay.pad_all(a, side, 12)
    TREE = appctl.tree(a, "Folders", 216, 600, on_tree)
    jsontree.fill(a, TREE, doc, json.json_root(doc), "name", "children", 1)
    app.end(a)
    let main_col: usize = lay.vbox(a)
    lay.grow(a, main_col, 1000)
    lay.pad_all(a, main_col, 16)
    lay.gap(a, main_col, 12, 12)
    SEARCH = app.entry(a, "Search files")
    app.on_edit(a, on_search)
    LIST = app.vlist_new(a, "Files", 800, 560, tsvtable.tsv_shown(tt()), cell, 0)
    skin.add(a, LIST, skin.K_PANEL)
    lay.grow(a, LIST, 1000)
    lay.fill_w(a, LIST)
    appshot.bench_target(LIST)
    app.vlist_select(a, LIST, 0)
    app.vlist_on_sort(a, LIST, on_sort)
    let v: *mut vlist.Vlist = app.vlist_model(a, LIST)
    vlist.vl_set_columns(v, 4)
    vlist.vl_set_col_title(v, 0, "Name")
    vlist.vl_set_col_title(v, 1, "Size")
    vlist.vl_set_col_title(v, 2, "Modified")
    vlist.vl_set_col_title(v, 3, "Type")
    vlist.vl_set_col_width(v, 0, 360.0)
    vlist.vl_set_col_width(v, 1, 110.0)
    vlist.vl_set_col_width(v, 2, 170.0)
    let status: usize = lay.hbox(a)
    lay.gap(a, status, 6, 0)
    lay.label(a, "Items:", 0)
    COUNT = lay.label(a, "0", 0)
    app.end(a)
    app.end(a)
    app.end(a)
    refresh(a)
    return appshot.finish(a, start, 1100, 700)
}
