import std.rt
import fui.filemodel

export { Fm, st, init, MAX_CRUMBS, MODEL_BYTES, CRUMB_SEGMENTS }

const MODEL_BYTES: usize = 512
const MAX_CRUMBS: usize = 8
const CRUMB_SEGMENTS: usize = 7

struct Fm {
    model: *mut filemodel.Model,
    list: usize,
    side: usize,
    preview: usize,
    status: usize,
    crumbs: [usize; 8],
    ancestors: usize,
    folders: usize,
    note: rt.Buf,
    target: rt.Buf,
    prompt: rt.Buf,
    home: rt.Buf,
    sample: bool,
}

static mut FM: u64 = 0

fn st() -> *mut Fm {
    return FM as *mut Fm
}

fn init(sample: bool) {
    let s: *mut Fm = rt.heap_alloc(1024) as *mut Fm
    FM = s as u64
    let m: *mut filemodel.Model = rt.heap_alloc(MODEL_BYTES) as *mut filemodel.Model
    filemodel.model_init(m)
    (*s).model = m
    (*s).list = 0
    (*s).side = 0
    (*s).preview = 0
    (*s).status = 0
    var i: usize = 0
    while i < MAX_CRUMBS {
        (*s).crumbs[i] = 0
        i = i + 1
    }
    (*s).ancestors = 0
    (*s).folders = 0
    (*s).note = rt.buf_new()
    (*s).target = rt.buf_new()
    (*s).prompt = rt.buf_new()
    (*s).home = rt.buf_new()
    (*s).sample = sample
}
