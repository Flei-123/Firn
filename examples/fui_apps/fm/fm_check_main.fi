import std.rt
import fui.app
import fui.appctl
import fui.filemodel
import fui.fsbackend
import fm_ui
import fm_state
import fm_files
import fm_nav
import fm_ops
import fm_path
import fm_side

static mut BAD: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn same(a: str, b: str) -> bool {
    return a.n == b.n && rt.mem_eq(a.p as u64, b.p as u64, a.n)
}

fn model() -> *mut filemodel.Model {
    return (*fm_state.st()).model
}

fn path() -> str {
    return filemodel.model_path(model())
}

fn count() -> usize {
    return filemodel.model_count(model())
}

fn name_at(row: usize) -> str {
    return filemodel.model_name(model(), fm_files.entry_at(row))
}

fn preview(a: *mut app.App) -> str {
    return app.text(a, (*fm_state.st()).preview)
}

fn test_navigation(a: *mut app.App) {
    check(same(path(), "/home/guest") && count() == 5, "start: sample home with 5 entries")
    check(same(name_at(0), "Documents") && same(name_at(3), "hello.fi"), "start: folders first, then files by name")
    check(fm_nav.go(a, "/home/guest/Documents") && count() == 4, "go: folder opens")
    check(same(name_at(0), "Archive"), "go: sub folder listed first")
    check(fm_path.segment_count(path()) == 3, "path: three segments")
    fm_nav.up(a)
    check(same(path(), "/home/guest"), "up: parent folder")
    check(!fm_nav.go(a, "/nowhere") && same(path(), "/home/guest"), "go: missing folder keeps the old one")
    check(!fm_nav.go(a, "/etc/hosts") && same(path(), "/home/guest"), "go: file is not a folder")
    fm_nav.go(a, "/")
    fm_nav.up(a)
    check(same(path(), "/"), "up: root stays root")
    fm_nav.go(a, "/home/guest/Documents/../Pictures")
    check(same(path(), "/home/guest/Pictures"), "go: dot-dot is resolved")
    check(fm_side.row_count() == 4, "side: path chain + no sub folders")
    var out: rt.Buf = rt.buf_new()
    fm_side.row_path(2, &out)
    check(same(rt.buf_str(&out), "/home/guest"), "side: row path of an ancestor")
    rt.buf_free(&out)
}

fn test_sort_and_preview(a: *mut app.App) {
    fm_nav.go(a, "/home/guest/Documents")
    filemodel.model_set_sort(model(), filemodel.SORT_SIZE, true)
    fm_nav.reload(a, "")
    check(same(name_at(1), "report.txt"), "sort: size descending puts the biggest file first")
    filemodel.model_set_sort(model(), filemodel.SORT_NAME, false)
    fm_nav.reload(a, "notes.md")
    check(same(name_at(fm_nav.selected_row(a)), "notes.md"), "reload: keeps the chosen name")
    fm_nav.pick_row(a, fm_nav.selected_row(a))
    check(rt.mem_eq(preview(a).p as u64, "# Meeting".p as u64, 9), "preview: text file")
    fm_nav.pick_row(a, 0)
    check(same(preview(a), "Folder"), "preview: folder")
}

fn test_operations(a: *mut app.App) {
    fm_nav.go(a, "/home/guest/Documents")
    let before: usize = count()
    fm_ops.new_folder(a)
    check(appctl.dialog_open(a), "new: dialog opens")
    appctl.dialog_answer(a, appctl.ANS_OK)
    check(count() == before + 1 && same(name_at(fm_nav.selected_row(a)), "New folder"), "new: folder created and chosen")
    fm_ops.new_folder(a)
    appctl.dialog_answer(a, appctl.ANS_OK)
    check(count() == before + 1, "new: same name is refused")
    fm_ops.rename_selected(a)
    check(appctl.dialog_open(a), "rename: dialog opens")
    appctl.dialog_answer(a, appctl.ANS_CANCEL)
    check(count() == before + 1 && same(name_at(fm_nav.selected_row(a)), "New folder"), "rename: cancel changes nothing")
    fm_ops.delete_selected(a)
    check(appctl.dialog_open(a), "delete: asks first")
    appctl.dialog_answer(a, appctl.ANS_CANCEL)
    check(count() == before + 1, "delete: cancel keeps the folder")
    fm_ops.delete_selected(a)
    appctl.dialog_answer(a, appctl.ANS_OK)
    check(count() == before, "delete: confirmed")
    fm_nav.reload(a, "Archive")
    fm_ops.delete_selected(a)
    appctl.dialog_answer(a, appctl.ANS_OK)
    check(count() == before, "delete: folder with content is refused")
    check(fm_ops.status_text(9, "x") == "Name already exists" && fm_ops.status_text(0, "ok") == "ok", "status texts")
}

fn test_open_and_keys(a: *mut app.App) {
    fm_nav.go(a, "/home/guest")
    fm_nav.open_row(a, 0)
    check(same(path(), "/home/guest/Documents"), "open: folder navigates")
    fm_nav.go(a, "/home/guest")
    fm_nav.reload(a, "readme.md")
    fm_nav.open_row(a, fm_nav.selected_row(a))
    check(same(path(), "/home/guest"), "open: file keeps the folder")
    check(same(preview(a), "# Welcome to Files\n"), "open: file preview")
    check(fsbackend.memory_tree_active() && fsbackend.can_mutate(), "backend: sample tree is writable")
}

fn main(start: u64) -> i32 {
    let a: *mut app.App = fm_ui.build(start)
    test_navigation(a)
    test_sort_and_preview(a)
    test_operations(a)
    test_open_and_keys(a)
    if BAD > 0 {
        say("FAILED\n")
        return 1
    }
    say("fm: all ok\n")
    return 0
}
