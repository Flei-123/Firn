import std.rt
import fui.appshot
import fui.memtree

export { load, FILLER_LINE }

const SEED_FILE: str = "fm_seed.txt"
const TAB: u8 = 9
const NEWLINE: u8 = 10
const SLASH: u8 = 47
const AT: u8 = 64
const FILLER_LINE: str = "The quick brown fox jumps over the lazy dog.\n"

fn make_parents(path: str) {
    var at: usize = 1
    while at < path.n {
        if rt.ld8(path.p as u64, at) == SLASH {
            memtree.make_dir(str { p: path.p, n: at })
        }
        at = at + 1
    }
}

fn filler(count: usize, out: *mut rt.Buf) {
    while rt.buf_len(out) < count {
        rt.buf_push_bytes(out, FILLER_LINE.p as u64, FILLER_LINE.n)
    }
    rt.buf_set_len(out, count)
}

fn parse_count(s: str) -> usize {
    var v: usize = 0
    var i: usize = 1
    while i < s.n {
        v = v * 10 + (rt.ld8(s.p as u64, i) - 48 as u8) as usize
        i = i + 1
    }
    return v
}

fn add_line(line: str) {
    var tab: usize = 0
    while tab < line.n && rt.ld8(line.p as u64, tab) != TAB {
        tab = tab + 1
    }
    let path: str = str { p: line.p, n: tab }
    make_parents(path)
    if path.n > 0 && rt.ld8(path.p as u64, path.n - 1) == SLASH {
        memtree.make_dir(str { p: path.p, n: path.n - 1 })
        return
    }
    var body: rt.Buf = rt.buf_new()
    let content: str = str { p: (line.p as u64 + tab as u64 + 1) as *mut u8, n: line.n - tab - 1 }
    if tab >= line.n {
        rt.buf_free(&body)
        return
    }
    if content.n > 0 && rt.ld8(content.p as u64, 0) == AT {
        filler(parse_count(content), &body)
    } else {
        rt.buf_push_bytes(&body, content.p as u64, content.n)
        rt.buf_push(&body, NEWLINE)
    }
    memtree.write_file(path, rt.buf_ptr(&body), rt.buf_len(&body))
    rt.buf_free(&body)
}

fn load(start: u64) -> bool {
    memtree.reset()
    var raw: rt.Buf = rt.buf_new()
    if !appshot.load_data(start, SEED_FILE, &raw) {
        rt.buf_free(&raw)
        return false
    }
    var from: usize = 0
    var i: usize = 0
    while i <= rt.buf_len(&raw) {
        if i == rt.buf_len(&raw) || rt.ld8(rt.buf_ptr(&raw), i) == NEWLINE {
            if i > from {
                add_line(str { p: (rt.buf_ptr(&raw) + from as u64) as *mut u8, n: i - from })
            }
            from = i + 1
        }
        i = i + 1
    }
    rt.buf_free(&raw)
    return true
}
