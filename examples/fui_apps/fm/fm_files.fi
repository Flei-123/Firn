import std.rt
import fui.vlist
import fui.lucide
import fui.filemodel
import fm_state

export { cell, entry_at, selected_view, COL_NAME, COL_SIZE, COL_DATE }

const COL_NAME: usize = 0
const COL_SIZE: usize = 1
const COL_DATE: usize = 2

fn model() -> *mut filemodel.Model {
    return (*fm_state.st()).model
}

fn entry_at(view_row: usize) -> *mut filemodel.Entry {
    let m: *mut filemodel.Model = model()
    return filemodel.model_ent(m, filemodel.model_view_ent(m, view_row))
}

fn selected_view(row: usize) -> usize {
    if row >= filemodel.model_count(model()) {
        return filemodel.NONE
    }
    return row
}

fn icon_of(e: *mut filemodel.Entry) -> i64 {
    if (*e).dir {
        return lucide.FOLDER
    }
    if (*e).icon == filemodel.IC_IMAGE {
        return lucide.IMAGE
    }
    if (*e).icon == filemodel.IC_ARCHIVE {
        return lucide.PACKAGE
    }
    if (*e).icon == filemodel.IC_LINK {
        return lucide.LINK
    }
    return lucide.FILE_TEXT
}

fn cell(ud: u64, i: usize, r: *mut vlist.VRow) {
    let m: *mut filemodel.Model = model()
    let e: *mut filemodel.Entry = entry_at(i)
    if (*r).col == COL_NAME {
        vlist.vrow_text(r, filemodel.model_name(m, e))
        (*r).icon = icon_of(e)
        return
    }
    var text: rt.Buf = rt.buf_new()
    if (*r).col == COL_SIZE {
        if !(*e).dir {
            filemodel.fmt_size((*e).size, &text)
        }
    } else {
        filemodel.fmt_date(m, (*e).mtime, &text)
    }
    vlist.vrow_bytes(r, rt.buf_ptr(&text), rt.buf_len(&text))
    rt.buf_free(&text)
}
