import std.rt
import fui.filemodel

export { child_path, ancestor_path, segment_count, segment_name }

const SLASH: u8 = 47

fn child_path(dir: str, name: str, out: *mut rt.Buf) {
    rt.buf_clear(out)
    rt.buf_push_bytes(out, dir.p as u64, dir.n)
    if !(dir.n > 0 && rt.ld8(dir.p as u64, dir.n - 1) == SLASH) {
        rt.buf_push(out, SLASH)
    }
    rt.buf_push_bytes(out, name.p as u64, name.n)
}

fn segment_count(path: str) -> usize {
    var start: usize = 0
    var end: usize = 0
    var n: usize = 0
    while filemodel.path_split(path, n, &start, &end) {
        n = n + 1
    }
    return n
}

fn segment_name(path: str, k: usize) -> str {
    var start: usize = 0
    var end: usize = 0
    if !filemodel.path_split(path, k, &start, &end) {
        return ""
    }
    return str { p: (path.p as u64 + start as u64) as *mut u8, n: end - start }
}

fn ancestor_path(path: str, depth: usize, out: *mut rt.Buf) {
    rt.buf_clear(out)
    rt.buf_push(out, SLASH)
    var start: usize = 0
    var end: usize = 0
    var k: usize = 0
    while k < depth && filemodel.path_split(path, k, &start, &end) {
        if k > 0 {
            rt.buf_push(out, SLASH)
        }
        rt.buf_push_bytes(out, path.p as u64 + start as u64, end - start)
        k = k + 1
    }
}
