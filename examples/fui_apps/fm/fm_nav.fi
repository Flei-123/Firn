import std.rt
import fui.app
import fui.filemodel
import fui.fsbackend
import fui.services
import fui.vlist
import fm_state
import fm_path
import fm_files
import fm_side
import fm_crumbs
import fm_preview

export { go, up, reload, open_row, note, refresh_status, selected_row, pick_row }

const LAST_OPEN_KEY: str = "fm.last_open"
const SEPARATOR: str = "  |  "
const NO_ROW: usize = 4294967295

fn model() -> *mut filemodel.Model {
    return (*fm_state.st()).model
}

fn selected_row(a: *mut app.App) -> usize {
    let row: usize = app.vlist_selected(a, (*fm_state.st()).list)
    return fm_files.selected_view(row)
}

fn push_dec(out: *mut rt.Buf, v: usize) {
    rt.buf_push_dec_i64(out, v as i64)
}

fn refresh_status(a: *mut app.App) {
    let s: *mut fm_state.Fm = fm_state.st()
    var text: rt.Buf = rt.buf_new()
    push_dec(&text, filemodel.model_count((*s).model))
    rt.buf_push_bytes(&text, " items".p as u64, 6)
    let row: usize = selected_row(a)
    if row != filemodel.NONE {
        let e: *mut filemodel.Entry = fm_files.entry_at(row)
        rt.buf_push_bytes(&text, SEPARATOR.p as u64, SEPARATOR.n)
        filemodel.push_str(&text, filemodel.model_name((*s).model, e))
        if !(*e).dir {
            rt.buf_push(&text, 32 as u8)
            filemodel.fmt_size((*e).size, &text)
        }
    }
    let label: str = fsbackend.backend_label()
    rt.buf_push_bytes(&text, SEPARATOR.p as u64, SEPARATOR.n)
    rt.buf_push_bytes(&text, label.p as u64, label.n)
    if rt.buf_len(&(*s).note) > 0 {
        rt.buf_push_bytes(&text, SEPARATOR.p as u64, SEPARATOR.n)
        rt.buf_push_bytes(&text, rt.buf_ptr(&(*s).note), rt.buf_len(&(*s).note))
    }
    app.set_text(a, (*s).status, rt.buf_str(&text))
    rt.buf_free(&text)
}

fn note(a: *mut app.App, text: str) {
    let s: *mut fm_state.Fm = fm_state.st()
    rt.buf_clear(&(*s).note)
    rt.buf_push_bytes(&(*s).note, text.p as u64, text.n)
    refresh_status(a)
}

fn show(a: *mut app.App, select: usize) {
    let s: *mut fm_state.Fm = fm_state.st()
    app.vlist_set_count(a, (*s).list, filemodel.model_count((*s).model))
    app.vlist_changed(a, (*s).list)
    app.vlist_select(a, (*s).list, select)
    fm_side.recount()
    app.vlist_set_count(a, (*s).side, fm_side.row_count())
    app.vlist_changed(a, (*s).side)
    app.vlist_select(a, (*s).side, (*s).ancestors - 1)
    fm_crumbs.update(a)
    fm_preview.update(a, select)
    refresh_status(a)
}

fn go(a: *mut app.App, target: str) -> bool {
    var norm: rt.Buf = rt.buf_new()
    filemodel.path_normalize(target, &norm)
    let err: i32 = filemodel.model_open((*fm_state.st()).model, rt.buf_str(&norm))
    rt.buf_free(&norm)
    if err != filemodel.ERR_NONE {
        note(a, filemodel.errno_text(err))
        return false
    }
    rt.buf_clear(&(*fm_state.st()).note)
    show(a, 0)
    return true
}

fn up(a: *mut app.App) {
    let path: str = filemodel.model_path(model())
    let depth: usize = fm_path.segment_count(path)
    if depth == 0 {
        return
    }
    var parent: rt.Buf = rt.buf_new()
    fm_path.ancestor_path(path, depth - 1, &parent)
    go(a, rt.buf_str(&parent))
    rt.buf_free(&parent)
}

fn reload(a: *mut app.App, select_name: str) {
    let m: *mut filemodel.Model = model()
    var keep: rt.Buf = rt.buf_new()
    var path: rt.Buf = rt.buf_new()
    filemodel.push_str(&keep, select_name)
    filemodel.push_str(&path, filemodel.model_path(m))
    let err: i32 = filemodel.model_open(m, rt.buf_str(&path))
    var row: usize = 0
    if err == filemodel.ERR_NONE && rt.buf_len(&keep) > 0 {
        row = filemodel.model_find_name(m, rt.buf_str(&keep))
        if row == filemodel.NONE {
            row = 0
        }
    }
    show(a, row)
    rt.buf_free(&keep)
    rt.buf_free(&path)
}

fn pick_row(a: *mut app.App, row: usize) {
    fm_preview.update(a, row)
    refresh_status(a)
}

fn open_row(a: *mut app.App, row: usize) {
    if fm_files.selected_view(row) == filemodel.NONE {
        return
    }
    let m: *mut filemodel.Model = model()
    let e: *mut filemodel.Entry = fm_files.entry_at(row)
    var full: rt.Buf = rt.buf_new()
    fm_path.child_path(filemodel.model_path(m), filemodel.model_name(m, e), &full)
    if (*e).dir {
        go(a, rt.buf_str(&full))
    } else {
        services.store_set(LAST_OPEN_KEY, rt.buf_ptr(&full), rt.buf_len(&full))
        pick_row(a, row)
        note(a, "Opened")
    }
    rt.buf_free(&full)
}
