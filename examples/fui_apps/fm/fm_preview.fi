import std.rt
import fui.app
import fui.filemodel
import fui.fsbackend
import fm_state
import fm_path
import fm_files

export { update }

const PREVIEW_BYTES: usize = 2000
const PREVIEW_FILE_LIMIT: u64 = 1048576
const SNIFF_BYTES: usize = 512
const CONTINUATION_MASK: u8 = 192
const CONTINUATION: u8 = 128

fn looks_binary(buf: *mut rt.Buf) -> bool {
    var n: usize = rt.buf_len(buf)
    if n > SNIFF_BYTES {
        n = SNIFF_BYTES
    }
    var i: usize = 0
    while i < n {
        if rt.ld8(rt.buf_ptr(buf), i) == 0 as u8 {
            return true
        }
        i = i + 1
    }
    return false
}

fn text_cut(buf: *mut rt.Buf) -> str {
    var n: usize = rt.buf_len(buf)
    if n > PREVIEW_BYTES {
        n = PREVIEW_BYTES
        while n > 0 && (rt.ld8(rt.buf_ptr(buf), n) & CONTINUATION_MASK) == CONTINUATION {
            n = n - 1
        }
    }
    return str { p: rt.buf_data(buf), n: n }
}

fn show_file(a: *mut app.App, full: str, size: u64) {
    let s: *mut fm_state.Fm = fm_state.st()
    if size > PREVIEW_FILE_LIMIT {
        app.set_text(a, (*s).preview, "File too large to preview.")
        return
    }
    var body: rt.Buf = rt.buf_new()
    if !fsbackend.read_file(full, &body) {
        app.set_text(a, (*s).preview, "Cannot read this file.")
    } else if looks_binary(&body) {
        app.set_text(a, (*s).preview, "Binary file.")
    } else {
        app.set_text(a, (*s).preview, text_cut(&body))
    }
    rt.buf_free(&body)
}

fn update(a: *mut app.App, row: usize) {
    let s: *mut fm_state.Fm = fm_state.st()
    if fm_files.selected_view(row) == filemodel.NONE {
        app.set_text(a, (*s).preview, "")
        return
    }
    let e: *mut filemodel.Entry = fm_files.entry_at(row)
    if (*e).dir {
        app.set_text(a, (*s).preview, "Folder")
        return
    }
    var full: rt.Buf = rt.buf_new()
    fm_path.child_path(filemodel.model_path((*s).model), filemodel.model_name((*s).model, e), &full)
    show_file(a, rt.buf_str(&full), (*e).size)
    rt.buf_free(&full)
}
