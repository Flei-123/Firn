import std.rt
import fui.app
import fui.appctl
import fui.appshot
import fui.editor
import fui.filemodel
import fui.fsbackend
import fui.homedir
import fui.lay
import fui.skin
import fui.vlist
import services.svc
import fm_state
import fm_files
import fm_side
import fm_crumbs
import fm_nav
import fm_ops
import fm_seed

export { build, WINDOW_W, WINDOW_H }

const WINDOW_W: usize = 1100
const WINDOW_H: usize = 700
const SIDE_W: i64 = 220
const PAD: i64 = 12
const SAMPLE_HOME: str = "/home/guest"
const ROOT: str = "/"

fn on_up(a: *mut app.App) { fm_nav.up(a) }

fn on_refresh(a: *mut app.App) {
    fm_nav.reload(a, "")
}

fn on_crumb(a: *mut app.App) {
    var path: rt.Buf = rt.buf_new()
    fm_crumbs.path_of_slot(app.activated(a), &path)
    fm_nav.go(a, rt.buf_str(&path))
    rt.buf_free(&path)
}

fn on_new(a: *mut app.App) { fm_ops.new_folder(a) }
fn on_rename(a: *mut app.App) { fm_ops.rename_selected(a) }
fn on_delete(a: *mut app.App) { fm_ops.delete_selected(a) }

fn on_list_pick(a: *mut app.App, id: usize, row: usize) { fm_nav.pick_row(a, row) }
fn on_list_open(a: *mut app.App, id: usize, row: usize) { fm_nav.open_row(a, row) }

fn on_side_pick(a: *mut app.App, id: usize, row: usize) {
    var path: rt.Buf = rt.buf_new()
    fm_side.row_path(row, &path)
    fm_nav.go(a, rt.buf_str(&path))
    rt.buf_free(&path)
}

fn on_sort(a: *mut app.App, id: usize, col: usize) {
    let s: *mut fm_state.Fm = fm_state.st()
    let v: *mut vlist.Vlist = app.vlist_model(a, (*s).list)
    filemodel.model_set_sort((*s).model, vlist.vl_sort_col(v) as i32, vlist.vl_sort_desc(v))
    fm_nav.reload(a, "")
}

fn on_key(a: *mut app.App, key: u32, mods: u32) -> bool {
    if appctl.dialog_open(a) {
        return false
    }
    if key == editor.KEY_BACKSPACE {
        fm_nav.up(a)
        return true
    }
    if key == editor.KEY_DELETE {
        fm_ops.delete_selected(a)
        return true
    }
    return false
}

fn toolbar(a: *mut app.App) {
    let s: *mut fm_state.Fm = fm_state.st()
    let bar: usize = lay.hbox(a)
    lay.gap(a, bar, 6, 0)
    app.button(a, "Up", on_up)
    app.button(a, "Refresh", on_refresh)
    var i: usize = 0
    while i < fm_state.MAX_CRUMBS {
        (*s).crumbs[i] = app.button(a, "/", on_crumb)
        i = i + 1
    }
    app.end(a)
}

fn columns(a: *mut app.App) {
    let v: *mut vlist.Vlist = app.vlist_model(a, (*fm_state.st()).list)
    vlist.vl_set_columns(v, 3)
    vlist.vl_set_col_title(v, 0, "Name")
    vlist.vl_set_col_title(v, 1, "Size")
    vlist.vl_set_col_title(v, 2, "Modified")
    vlist.vl_set_col_width(v, 0, 360.0)
    vlist.vl_set_col_width(v, 1, 110.0)
    vlist.vl_set_col_width(v, 2, 170.0)
}

fn sidebar(a: *mut app.App) {
    let s: *mut fm_state.Fm = fm_state.st()
    let side: usize = lay.vbox(a)
    skin.add(a, side, skin.K_SIDE)
    lay.size(a, side, SIDE_W, 0)
    lay.pad_all(a, side, PAD)
    (*s).side = app.vlist_new(a, "Folders", 196, 560, 0, fm_side.cell, 0)
    lay.grow(a, (*s).side, 1000)
    app.vlist_on_pick(a, (*s).side, on_side_pick)
    app.vlist_on_activate(a, (*s).side, on_side_pick)
    app.end(a)
}

fn main_column(a: *mut app.App) {
    let s: *mut fm_state.Fm = fm_state.st()
    let col: usize = lay.vbox(a)
    lay.grow(a, col, 1000)
    lay.pad_all(a, col, PAD)
    lay.gap(a, col, PAD, PAD)
    toolbar(a)
    (*s).list = app.vlist_new(a, "Files", 800, 400, 0, fm_files.cell, 0)
    skin.add(a, (*s).list, skin.K_PANEL)
    lay.grow(a, (*s).list, 1000)
    lay.fill_w(a, (*s).list)
    columns(a)
    app.vlist_on_pick(a, (*s).list, on_list_pick)
    app.vlist_on_activate(a, (*s).list, on_list_open)
    app.vlist_on_sort(a, (*s).list, on_sort)
    (*s).preview = app.textarea(a, "Preview", 6)
    lay.fill_w(a, (*s).preview)
    actions(a)
    app.end(a)
}

fn actions(a: *mut app.App) {
    let bar: usize = lay.hbox(a)
    lay.gap(a, bar, 6, 0)
    app.button(a, "New folder", on_new)
    app.button(a, "Rename", on_rename)
    app.button(a, "Delete", on_delete)
    (*fm_state.st()).status = lay.label(a, "", 0)
    app.end(a)
}

fn use_sample(start: u64) -> bool {
    return appshot.has_flag(start, "--sample") || appshot.opt_value(start, "--shot") != 0 || !svc.has(svc.CAP_DIR_LIST)
}

fn start_path(sample: bool) -> str {
    if sample {
        return SAMPLE_HOME
    }
    let home: str = homedir.home_dir()
    if home.n > 0 {
        return home
    }
    return ROOT
}

fn build(start: u64) -> *mut app.App {
    let sample: bool = use_sample(start)
    fm_state.init(sample)
    fsbackend.use_memory_tree(sample)
    if sample {
        fm_seed.load(start)
        filemodel.model_set_offset((*fm_state.st()).model, 0)
    }
    let a: *mut app.App = app.window("Files", WINDOW_W, WINDOW_H)
    skin.install(a)
    lay.page(a)
    let page: usize = lay.hbox(a)
    lay.grow(a, page, 1000)
    sidebar(a)
    main_column(a)
    app.end(a)
    app.on_key(a, on_key)
    if !fm_nav.go(a, start_path(sample)) {
        fm_nav.go(a, ROOT)
    }
    return a
}
