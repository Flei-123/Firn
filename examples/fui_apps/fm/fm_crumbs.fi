import std.rt
import fui.app
import fui.lay
import fui.filemodel
import fm_state
import fm_path

export { update, path_of_slot, is_crumb }

const ROOT_LABEL: str = "/"

fn first_segment(total: usize) -> usize {
    if total > fm_state.CRUMB_SEGMENTS {
        return total - fm_state.CRUMB_SEGMENTS
    }
    return 0
}

fn slot_of(node: usize) -> usize {
    let s: *mut fm_state.Fm = fm_state.st()
    var i: usize = 0
    while i < fm_state.MAX_CRUMBS {
        if (*s).crumbs[i] == node {
            return i
        }
        i = i + 1
    }
    return fm_state.MAX_CRUMBS
}

fn is_crumb(node: usize) -> bool {
    return slot_of(node) < fm_state.MAX_CRUMBS
}

fn path_of_slot(node: usize, out: *mut rt.Buf) {
    let path: str = filemodel.model_path((*fm_state.st()).model)
    let slot: usize = slot_of(node)
    if slot == 0 {
        fm_path.ancestor_path(path, 0, out)
        return
    }
    fm_path.ancestor_path(path, first_segment(fm_path.segment_count(path)) + slot, out)
}

fn update(a: *mut app.App) {
    let s: *mut fm_state.Fm = fm_state.st()
    let path: str = filemodel.model_path((*s).model)
    let total: usize = fm_path.segment_count(path)
    let first: usize = first_segment(total)
    app.set_text(a, (*s).crumbs[0], ROOT_LABEL)
    var slot: usize = 1
    while slot < fm_state.MAX_CRUMBS {
        let seg: usize = first + slot - 1
        let used: bool = seg < total
        lay.hidden(a, (*s).crumbs[slot], !used)
        if used {
            app.set_text(a, (*s).crumbs[slot], fm_path.segment_name(path, seg))
        }
        slot = slot + 1
    }
}
