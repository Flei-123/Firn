import std.rt
import fui.vlist
import fui.lucide
import fui.filemodel
import fm_state
import fm_path

export { cell, recount, row_path, row_count }

const INDENT: str = "  "

fn model() -> *mut filemodel.Model {
    return (*fm_state.st()).model
}

fn row_count() -> usize {
    return (*fm_state.st()).ancestors + (*fm_state.st()).folders
}

fn recount() {
    let m: *mut filemodel.Model = model()
    let s: *mut fm_state.Fm = fm_state.st()
    (*s).ancestors = fm_path.segment_count(filemodel.model_path(m)) + 1
    var dirs: usize = 0
    var k: usize = 0
    while k < filemodel.model_count(m) {
        if (*filemodel.model_ent(m, filemodel.model_view_ent(m, k))).dir {
            dirs = dirs + 1
        }
        k = k + 1
    }
    (*s).folders = dirs
}

fn folder_name(j: usize) -> str {
    let m: *mut filemodel.Model = model()
    var seen: usize = 0
    var k: usize = 0
    while k < filemodel.model_count(m) {
        let e: *mut filemodel.Entry = filemodel.model_ent(m, filemodel.model_view_ent(m, k))
        if (*e).dir {
            if seen == j {
                return filemodel.model_name(m, e)
            }
            seen = seen + 1
        }
        k = k + 1
    }
    return ""
}

fn row_path(i: usize, out: *mut rt.Buf) {
    let m: *mut filemodel.Model = model()
    let anc: usize = (*fm_state.st()).ancestors
    if i < anc {
        fm_path.ancestor_path(filemodel.model_path(m), i, out)
        return
    }
    fm_path.child_path(filemodel.model_path(m), folder_name(i - anc), out)
}

fn cell(ud: u64, i: usize, r: *mut vlist.VRow) {
    let m: *mut filemodel.Model = model()
    let anc: usize = (*fm_state.st()).ancestors
    var depth: usize = i
    var name: str = "/"
    if i >= anc {
        depth = anc
        name = folder_name(i - anc)
    } else if i > 0 {
        name = fm_path.segment_name(filemodel.model_path(m), i - 1)
    }
    var text: rt.Buf = rt.buf_new()
    var d: usize = 0
    while d < depth {
        rt.buf_push_bytes(&text, INDENT.p as u64, INDENT.n)
        d = d + 1
    }
    rt.buf_push_bytes(&text, name.p as u64, name.n)
    vlist.vrow_bytes(r, rt.buf_ptr(&text), rt.buf_len(&text))
    rt.buf_free(&text)
    (*r).icon = lucide.FOLDER
    if i + 1 == anc {
        (*r).icon = lucide.FOLDER_OPEN
    }
}
