import std.rt
import fui.app
import fui.appctl
import fui.filemodel
import fui.fsbackend
import services.svc
import services.svcmut
import fm_state
import fm_path
import fm_files
import fm_nav

export { new_folder, rename_selected, delete_selected, status_text }

const READ_ONLY: str = "This location is read-only"
const SELECT_FIRST: str = "Select an item first"

fn status_text(code: i32, done: str) -> str {
    if code == svc.OK { return done }
    if code == svc.EXISTS { return "Name already exists" }
    if code == svc.NOT_EMPTY { return "Folder is not empty" }
    if code == svc.DENIED { return "Permission denied" }
    if code == svc.NOT_FOUND { return "Not found" }
    if code == svc.NOT_DIR { return "Not a folder" }
    if code == svc.INVALID { return "Invalid name" }
    if code == svc.NO_BACKEND { return READ_ONLY }
    return "Failed"
}

fn dir_path(name: str, out: *mut rt.Buf) {
    fm_path.child_path(filemodel.model_path((*fm_state.st()).model), name, out)
}

fn writable(a: *mut app.App) -> bool {
    if fsbackend.can_mutate() {
        return true
    }
    fm_nav.note(a, READ_ONLY)
    return false
}

fn selected_name(a: *mut app.App, out: *mut rt.Buf) -> bool {
    let row: usize = fm_nav.selected_row(a)
    if row == filemodel.NONE {
        fm_nav.note(a, SELECT_FIRST)
        return false
    }
    let m: *mut filemodel.Model = (*fm_state.st()).model
    filemodel.push_str(out, filemodel.model_name(m, fm_files.entry_at(row)))
    return true
}

fn finish(a: *mut app.App, code: i32, done: str, select: str) {
    fm_nav.reload(a, select)
    fm_nav.note(a, status_text(code, done))
}

fn on_new_answer(a: *mut app.App, ans: u32) {
    if ans != appctl.ANS_OK {
        return
    }
    let name: str = appctl.dialog_text(a)
    var full: rt.Buf = rt.buf_new()
    var code: i32 = svc.INVALID
    if svcmut.valid_name(name) {
        dir_path(name, &full)
        code = fsbackend.make_dir(rt.buf_str(&full))
    }
    finish(a, code, "Folder created", name)
    rt.buf_free(&full)
}

fn on_rename_answer(a: *mut app.App, ans: u32) {
    if ans != appctl.ANS_OK {
        return
    }
    let s: *mut fm_state.Fm = fm_state.st()
    let name: str = appctl.dialog_text(a)
    var from: rt.Buf = rt.buf_new()
    var to: rt.Buf = rt.buf_new()
    var code: i32 = svc.INVALID
    if svcmut.valid_name(name) {
        dir_path(rt.buf_str(&(*s).target), &from)
        dir_path(name, &to)
        code = fsbackend.rename(rt.buf_str(&from), rt.buf_str(&to))
    }
    finish(a, code, "Renamed", name)
    rt.buf_free(&from)
    rt.buf_free(&to)
}

fn on_delete_answer(a: *mut app.App, ans: u32) {
    if ans != appctl.ANS_OK {
        return
    }
    let s: *mut fm_state.Fm = fm_state.st()
    var full: rt.Buf = rt.buf_new()
    dir_path(rt.buf_str(&(*s).target), &full)
    let code: i32 = fsbackend.remove(rt.buf_str(&full))
    finish(a, code, "Deleted", "")
    rt.buf_free(&full)
}

fn new_folder(a: *mut app.App) {
    if writable(a) {
        appctl.input(a, "New folder", "Folder name", "New folder", on_new_answer)
    }
}

fn rename_selected(a: *mut app.App) {
    let s: *mut fm_state.Fm = fm_state.st()
    rt.buf_clear(&(*s).target)
    if writable(a) && selected_name(a, &(*s).target) {
        appctl.input(a, "Rename", "New name", rt.buf_str(&(*s).target), on_rename_answer)
    }
}

fn delete_selected(a: *mut app.App) {
    let s: *mut fm_state.Fm = fm_state.st()
    rt.buf_clear(&(*s).target)
    if !(writable(a) && selected_name(a, &(*s).target)) {
        return
    }
    rt.buf_clear(&(*s).prompt)
    filemodel.push_str(&(*s).prompt, "Delete ")
    filemodel.push_str(&(*s).prompt, rt.buf_str(&(*s).target))
    filemodel.push_str(&(*s).prompt, "?")
    appctl.confirm(a, "Delete", rt.buf_str(&(*s).prompt), on_delete_answer)
}
