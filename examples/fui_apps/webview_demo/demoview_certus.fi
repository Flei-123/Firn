import fui.webview_types
import embed.webview_fui

export { Holder, holder_new, holder_init, holder_backend, LABEL, PAGE }

const LABEL: str = "Embedded page (Certus Glass)"
const PAGE: str = "<!doctype html><html><head><title>Certus page</title></head><body style=\"margin:0;background:#f4f6fb;font-family:sans-serif\"><h1 style=\"margin:16px\">Rendered by Certus Glass</h1><p style=\"margin:16px\">This page is painted by the embedded engine into a fUi window.</p><div style=\"margin:16px;height:60px;background:#2b6cb0\"></div><a href=\"/next\" style=\"display:block;margin:16px\">A link</a><input type=\"text\" style=\"display:block;margin:16px;width:240px;height:30px\"></body></html>"

struct Holder {
    adapter: webview_fui.GlassAdapter,
}

fn __gc_finalize(kind: u64, p: *mut u8) {
}

fn holder_init() -> bool {
    return gc_init()
}

fn holder_new() -> Holder {
    return Holder { adapter: webview_fui.adapter_new() }
}

fn holder_backend(h: *mut Holder) -> webview_types.Backend {
    return webview_fui.adapter_backend(&(*h).adapter)
}
