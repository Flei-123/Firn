import fui.webview_types
import fui.webview_stub

export { Holder, holder_new, holder_init, holder_backend, LABEL, PAGE }

const LABEL: str = "Embedded page (stub backend)"
const PAGE: str = "fUi WebView demo page"

struct Holder {
    stub: *mut webview_stub.Stub,
}

fn holder_init() -> bool {
    return true
}

fn holder_new() -> Holder {
    return Holder { stub: webview_stub.stub_new(0 as u32) }
}

fn holder_backend(h: *mut Holder) -> webview_types.Backend {
    return webview_stub.stub_backend((*h).stub)
}
