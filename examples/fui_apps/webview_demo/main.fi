import std.rt
import fui.app
import fui.appshot
import fui.webview
import fui.webview_types
import fui.webview_stub
import fui.webview_node

const WINDOW_W: usize = 760
const WINDOW_H: usize = 520
const VIEW_W: usize = 720
const VIEW_H: usize = 440
const STATE_BYTES: usize = 4096
const PAGE: str = "fUi WebView demo page"

fn main(start: u64) -> i32 {
    let a: *mut app.App = app.window("WebView demo", WINDOW_W, WINDOW_H)
    let wv: *mut webview.WebView = rt.heap_alloc(STATE_BYTES) as *mut webview.WebView
    let node: *mut webview_node.WvNode = rt.heap_alloc(STATE_BYTES) as *mut webview_node.WvNode
    *wv = webview.webview_new()
    *node = webview_node.wvnode_new(wv)
    let stub: *mut webview_stub.Stub = webview_stub.stub_new(0 as u32)
    var backend: webview_types.Backend = webview_stub.stub_backend(stub)
    if !webview.webview_open(wv, &backend, VIEW_W as u32, VIEW_H as u32) {
        return 2
    }
    webview.webview_load(wv, PAGE.p as u64, PAGE.n, webview_types.LOAD_HTML)
    app.label(a, "Embedded page (stub backend)", 14)
    webview_node.wvnode_attach(a, node, VIEW_W, VIEW_H)
    return appshot.finish(a, start, WINDOW_W, WINDOW_H)
}
