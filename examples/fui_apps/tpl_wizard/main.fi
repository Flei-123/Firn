import ds_icons_set
import fui.ds_settings
import fui.ds_tpl_wizard
import fui.editor
import fui.kit
import fui.kitform
import fui.ds_icons
import fui.ds_icons_names
import fui.render

static mut PANEL: u64 = 0
static mut NAME: u64 = 0
static mut MAIL: u64 = 0
static mut FX: f64 = 0.0
static mut FY: f64 = 0.0
static mut FW: f64 = 0.0

fn panel() -> *mut ds_settings.Panel { return PANEL as *mut ds_settings.Panel }
fn name() -> *mut kit.Search { return NAME as *mut kit.Search }
fn mail() -> *mut kit.Search { return MAIL as *mut kit.Search }

fn draw(ud: u64, c: *mut render.Ctx, step: usize, x: f64, y: f64, w: f64, h: f64, px: f64, py: f64) {
    if step == 1 {
        let p: *mut ds_settings.Panel = panel()
        ds_settings.begin(p, c, x, y, w, px, py)
        ds_settings.row_combo(p, c, 1, ds_icons.gid(ds_icons_names.GLOBE), "Language", "", "English|Deutsch|Francais")
        ds_settings.row_combo(p, c, 2, ds_icons.gid(ds_icons_names.CLOCK), "Time zone", "", "UTC|Berlin|New York")
        ds_settings.row_toggle(p, c, 3, ds_icons.gid(ds_icons_names.WIFI_1), "Connect to Wi-Fi", "Use the network Home")
        ds_settings.end(p, c)
    }
    if step == 2 {
        FX = x
        FY = y
        FW = w
        let a: f64 = kitform.field_draw(c, name(), x, y, w, "Name", "Your name", "", true)
        kitform.field_draw(c, mail(), x, y + a, w, "Email", "name@example.com", "", true)
    }
}

fn press(ud: u64, step: usize, x: f64, y: f64) -> bool {
    if step == 1 { ds_settings.click(panel(), x, y) }
    if step == 2 {
        let c: *mut render.Ctx = ds_tpl_wizard.ctx(ds_tpl_wizard.wp(ud))
        let a: bool = kitform.field_press(c, name(), FX, FY, FW, x, y, 0 as u64)
        let b: bool = kitform.field_press(c, mail(), FX, FY + kit.ln(c, 82), FW, x, y, 0 as u64)
        if !a { kit.search_focus(name(), false) }
        if !b { kit.search_focus(mail(), false) }
    }
    return true
}

fn key(ud: u64, step: usize, k: u32, mods: u32) -> bool {
    if step == 2 && kit.search_has_focus(name()) { return kit.search_key(name(), k, mods) != editor.RES_PASS }
    if step == 2 && kit.search_has_focus(mail()) { return kit.search_key(mail(), k, mods) != editor.RES_PASS }
    if step == 1 { return ds_settings.key(panel(), k, mods) }
    return false
}

fn text(ud: u64, step: usize, cp: u32, mods: u32) -> bool {
    if step == 2 && kit.search_has_focus(name()) { return kit.search_char(name(), cp, mods) != editor.RES_PASS }
    if step == 2 && kit.search_has_focus(mail()) { return kit.search_char(mail(), cp, mods) != editor.RES_PASS }
    return false
}

fn can_next(ud: u64, step: usize) -> bool { return step != 2 || kit.search_text_len(name()) > 0 }

fn finish(ud: u64) {}

fn main(start: u64) -> i32 {
    ds_icons_set.install()
    PANEL = ds_settings.panel_new() as u64
    NAME = kitform.field_new() as u64
    MAIL = kitform.field_new() as u64
    kit.search_set_text(name(), "Alex")
    let w: *mut ds_tpl_wizard.Wiz = ds_tpl_wizard.new("Setup", draw, can_next, finish, 0)
    (*w).ud = w as u64
    ds_settings.set_val(panel(), 3, 1)
    ds_tpl_wizard.on_input(w, press, key, text)
    ds_tpl_wizard.welcome(w, ds_icons.gid(ds_icons_names.SPARKLE), "Welcome", "Let's set up your device.|It only takes a minute.")
    ds_tpl_wizard.step(w, "Choose your region", "Pick language and time zone.")
    ds_tpl_wizard.step(w, "Who are you?", "We use this for your account.")
    ds_tpl_wizard.step(w, "All set", "Your device is ready to use.")
    return ds_tpl_wizard.run(start, w, 1100, 700)
}
