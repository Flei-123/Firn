import std.rt
import paint.canvas
import gal_ui
import fui.ds_combo
import fui.ds_crumb
import fui.ds_iconbtn
import fui.ds_icons_full
import fui.ds_navview
import fui.ds_tokens
import fui.editor
import fui.kit
import fui.kitcolor
import fui.lucide
import fui.painter
import fui.render
import fui.style
import fui.theme

const MAX_PAGES: usize = 20
const B_PREV: usize = 1
const B_NEXT: usize = 2
const B_THEME: usize = 3

static mut ACCENT: usize = 0
static mut DARK: bool = true
static mut VIEW_BOTTOM: f64 = 0.0

fn is_dark() -> bool { return DARK }
fn view_bottom() -> f64 { return VIEW_BOTTOM }

struct Entry {
    icon: i64,
    title: str,
    group: str,
    hosted: bool,
    pane: bool,
    footer: bool,
    paint: fn(u64, *mut render.Ctx, f64, f64, f64, f64, f64, f64) -> f64,
    press: fn(u64, f64, f64),
    key: fn(u64, u32, u32) -> bool,
    text: fn(u64, u32, u32) -> bool,
    wheel: fn(u64, f64, f64, f64, f64) -> bool,
    pointer: fn(u64, u32, f64, f64) -> bool,
    ud: u64,
}

struct Host {
    e: [Entry; 20],
    n: usize,
    page: usize,
    scroll: f64,
    content_h: f64,
    view_h: f64,
    foot_y: f64,
    nav: u64,
    crumb: u64,
    btns: u64,
    accent: u64,
    ctx: u64,
    crumb_buf: [u8; 192],
}

fn hp(ud: u64) -> *mut Host { return ud as *mut Host }
fn nav_of(g: *mut Host) -> *mut ds_navview.NavView { return (*g).nav as *mut ds_navview.NavView }
fn crumb_of(g: *mut Host) -> *mut ds_crumb.Crumbs { return (*g).crumb as *mut ds_crumb.Crumbs }
fn btns_of(g: *mut Host) -> *mut ds_iconbtn.Btns { return (*g).btns as *mut ds_iconbtn.Btns }
fn accent_of(g: *mut Host) -> *mut ds_combo.Combo { return (*g).accent as *mut ds_combo.Combo }
fn ctx_of(g: *mut Host) -> *mut render.Ctx { return (*g).ctx as *mut render.Ctx }

fn no_paint(ud: u64, c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, px: f64, py: f64) -> f64 { return 0.0 }
fn no_press(ud: u64, x: f64, y: f64) {}
fn no_key(ud: u64, k: u32, mods: u32) -> bool { return false }
fn no_wheel(ud: u64, px: f64, py: f64, dx: f64, dy: f64) -> bool { return false }
fn no_pointer(ud: u64, kind: u32, x: f64, y: f64) -> bool { return false }

fn host_new(accent: usize, dark: bool) -> *mut Host {
    let g: *mut Host = rt.heap_alloc(1 << 16) as *mut Host
    (*g).n = 0
    (*g).page = 0
    (*g).scroll = 0.0
    (*g).content_h = 0.0
    (*g).view_h = 0.0
    (*g).foot_y = 0.0
    (*g).nav = rt.heap_alloc(1 << 13)
    *nav_of(g) = ds_navview.nv_new()
    (*g).crumb = ds_crumb.crumbs_new() as u64
    (*g).btns = ds_iconbtn.btns_new() as u64
    (*g).accent = ds_combo.combo_new() as u64
    ds_combo.set_items(accent_of(g), "Blue|Teal|Green|Orange|Red|Pink|Purple|Gray")
    ds_combo.set_value(accent_of(g), accent as i64)
    (*g).ctx = 0
    ACCENT = accent
    DARK = dark
    return g
}

fn add(g: *mut Host, group: str, icon: i64, title: str, hosted: bool, footer: bool, paint: fn(u64, *mut render.Ctx, f64, f64, f64, f64, f64, f64) -> f64, ud: u64) -> *mut Entry {
    let e: *mut Entry = &(*g).e[(*g).n]
    (*e).icon = icon
    (*e).title = title
    (*e).group = group
    (*e).hosted = hosted
    (*e).pane = false
    (*e).footer = footer
    (*e).paint = paint
    (*e).press = no_press
    (*e).key = no_key
    (*e).text = no_key
    (*e).wheel = no_wheel
    (*e).pointer = no_pointer
    (*e).ud = ud
    (*g).n = (*g).n + 1
    if footer {
        ds_navview.add_footer(nav_of(g), icon, title)
    } else {
        ds_navview.add(nav_of(g), icon, title)
    }
    return e
}

fn add_pane(g: *mut Host, group: str, icon: i64, title: str, paint: fn(u64, *mut render.Ctx, f64, f64, f64, f64, f64, f64) -> f64, ud: u64) -> *mut Entry {
    let e: *mut Entry = add(g, group, icon, title, false, true, paint, ud)
    (*e).pane = true
    return e
}

fn skin(m: *mut theme.Theme, dark: bool) {
    ds_icons_full.install()
    ds_tokens.apply(m, dark, ACCENT)
    ds_tokens.set_accent(m, ACCENT)
    kitcolor.set_accent(ds_tokens.accent_color(ACCENT, dark))
}

fn retheme(g: *mut Host) {
    let m: *mut theme.Theme = render.ctx_theme(ctx_of(g))
    kitcolor.kit_theme(m, DARK)
    skin(m, DARK)
}

fn goto_page(g: *mut Host, i: usize) {
    if i >= (*g).n { return }
    (*g).page = i
    (*g).scroll = 0.0
    (*g).content_h = 0.0
    ds_navview.select(nav_of(g), i)
}

fn footer_h(c: *mut render.Ctx) -> f64 { return kit.ln(c, 56) }

fn push_str(g: *mut Host, n: usize, s: str) -> usize {
    var o: usize = n
    var i: usize = 0
    while i < s.n && o < 190 {
        (*g).crumb_buf[o] = rt.ld8(s.p as u64, i)
        o = o + 1
        i = i + 1
    }
    return o
}

fn crumb_list(g: *mut Host) -> str {
    let e: *mut Entry = &(*g).e[(*g).page]
    var n: usize = push_str(g, 0, "Gallery|")
    n = push_str(g, n, (*e).group)
    n = push_str(g, n, "|")
    n = push_str(g, n, (*e).title)
    return str { p: ((&(*g).crumb_buf[0]) as u64) as *mut u8, n: n }
}

fn paint_footer(g: *mut Host, c: *mut render.Ctx, w: f64, y: f64, h: f64, px: f64, py: f64) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    painter.surface(z, 0.0, y, w, h, gal_ui.paint(c, ds_tokens.C_SURFACE))
    painter.surface(z, 0.0, y, w, 1.0, gal_ui.paint(c, ds_tokens.C_SEPARATOR))
    let pad: f64 = kit.ln(c, 12)
    var hx: f64 = px
    var hy: f64 = py
    if py < y {
        hx = 0.0 - 1.0
        hy = 0.0 - 1.0
    }
    let b: *mut ds_iconbtn.Btns = btns_of(g)
    let bs: f64 = kit.ln(c, 40)
    let by: f64 = y + (h - bs) / 2.0
    var x: f64 = w - pad - bs
    ds_iconbtn.begin(b, c, hx, hy)
    var tg: i64 = lucide.SUN
    var tn: str = "Switch to light theme"
    if !DARK {
        tg = lucide.MOON
        tn = "Switch to dark theme"
    }
    ds_iconbtn.add(b, c, B_THEME, x, by, tg, tn, false, true)
    x = x - bs
    ds_iconbtn.add(b, c, B_NEXT, x, by, lucide.ARROW_RIGHT, "Next page", false, (*g).page + 1 < (*g).n)
    x = x - bs
    ds_iconbtn.add(b, c, B_PREV, x, by, lucide.ARROW_LEFT, "Previous page", false, (*g).page > 0)
    ds_iconbtn.end(b, c)
    var aw: f64 = kit.ln(c, 168)
    x = x - pad - aw
    let ah: f64 = ds_combo.draw(accent_of(g), c, x, y + (h - kit.ln(c, 38)) / 2.0, aw, "Accent", "Accent", hx, hy, y + h)
    let cw: f64 = x - pad * 2.0
    let k: *mut ds_crumb.Crumbs = crumb_of(g)
    ds_crumb.begin(k, c, pad, y + (h - kit.ln(c, 32)) / 2.0, cw, hx, hy)
    ds_crumb.draw(k, c, crumb_list(g))
    ds_crumb.end(k, c)
}

fn paint(ud: u64, c: *mut render.Ctx, w: f64, h: f64, px: f64, py: f64) {
    let g: *mut Host = hp(ud)
    (*g).ctx = c as u64
    let fh: f64 = footer_h(c)
    let ah: f64 = h - fh
    (*g).foot_y = ah
    let z: *mut painter.Painter = render.ctx_painter(c)
    painter.surface(z, 0.0, 0.0, w, h, gal_ui.paint(c, ds_tokens.C_BASE))
    let e: *mut Entry = &(*g).e[(*g).page]
    var hx: f64 = px
    var hy: f64 = py
    if py >= ah {
        hx = 0.0 - 1.0
        hy = 0.0 - 1.0
    }
    if (*e).hosted {
        ((*e).paint)((*e).ud, c, 0.0, 0.0, w, ah, hx, hy)
        paint_footer(g, c, w, ah, fh, px, py)
        ds_combo.end(accent_of(g), c)
        return
    }
    let v: *mut ds_navview.NavView = nav_of(g)
    ds_navview.layout(v, c, 0.0, 0.0, w, ah)
    ds_navview.select(v, (*g).page)
    ds_navview.draw(v, c, hx, hy)
    let cx: f64 = ds_navview.content_x(v)
    let cy: f64 = ds_navview.content_y(v)
    let cw: f64 = ds_navview.content_w(v)
    let ch: f64 = ds_navview.content_h(v)
    (*g).view_h = ch
    var room: f64 = (*g).content_h - ch
    if room < 0.0 { room = 0.0 }
    if (*g).scroll > room { (*g).scroll = room }
    if (*g).scroll < 0.0 { (*g).scroll = 0.0 }
    if (*e).pane {
        var qx: f64 = hx
        var qy: f64 = hy
        if !gal_ui.inside(hx, hy, cx, cy, cw, ch) {
            qx = 0.0 - 1.0
            qy = 0.0 - 1.0
        }
        VIEW_BOTTOM = cy + ch
        let cvp: *mut canvas.Canvas = painter.painter_canvas(z)
        let pushed_pane: bool = canvas.clip_push_rect(cvp, cx, cy, cx + cw, cy + ch)
        ((*e).paint)((*e).ud, c, cx, cy, cw, ch, qx, qy)
        if pushed_pane { canvas.clip_pop(cvp) }
        ds_navview.draw_overlay(v, c, hx, hy)
        paint_footer(g, c, w, ah, fh, px, py)
        ds_combo.end(accent_of(g), c)
        return
    }
    let pad: f64 = kit.ln(c, 32)
    var iw: f64 = cw - pad * 2.0
    if iw > kit.ln(c, 960) { iw = kit.ln(c, 960) }
    var cpx: f64 = hx
    var cpy: f64 = hy
    if !gal_ui.inside(hx, hy, cx, cy, cw, ch) {
        cpx = 0.0 - 1.0
        cpy = 0.0 - 1.0
    }
    let cv: *mut canvas.Canvas = painter.painter_canvas(z)
    VIEW_BOTTOM = cy + ch
    let pushed: bool = canvas.clip_push_rect(cv, cx, cy, cx + cw, cy + ch)
    let used: f64 = ((*e).paint)((*e).ud, c, cx + pad, cy - (*g).scroll + kit.ln(c, 24), iw, ch, cpx, cpy)
    (*g).content_h = used + kit.ln(c, 48)
    if pushed { canvas.clip_pop(cv) }
    ds_navview.draw_overlay(v, c, hx, hy)
    paint_footer(g, c, w, ah, fh, px, py)
    ds_combo.end(accent_of(g), c)
}

fn apply_accent(g: *mut Host) {
    let v: i64 = ds_combo.value(accent_of(g))
    if v < 0 as i64 || (v as usize) == ACCENT { return }
    ACCENT = v as usize
    retheme(g)
}

fn footer_press(g: *mut Host, x: f64, y: f64) {
    let b: *mut ds_iconbtn.Btns = btns_of(g)
    let id: usize = ds_iconbtn.click(b, x, y)
    if id == B_PREV && (*g).page > 0 { goto_page(g, (*g).page - 1) }
    if id == B_NEXT && (*g).page + 1 < (*g).n { goto_page(g, (*g).page + 1) }
    if id == B_THEME {
        DARK = !DARK
        retheme(g)
    }
    if id != gal_ui.NONE { return }
    if ds_combo.press(accent_of(g), x, y) {
        apply_accent(g)
        return
    }
    let seg: usize = ds_crumb.click(crumb_of(g), x, y)
    if seg == 0 { goto_page(g, 0) }
}

fn press(ud: u64, x: f64, y: f64) {
    let g: *mut Host = hp(ud)
    let c: *mut render.Ctx = ctx_of(g)
    if ds_combo.is_open(accent_of(g)) {
        ds_combo.press(accent_of(g), x, y)
        apply_accent(g)
        return
    }
    if y >= (*g).foot_y {
        footer_press(g, x, y)
        return
    }
    ds_combo.blur(accent_of(g))
    let e: *mut Entry = &(*g).e[(*g).page]
    if (*e).hosted {
        ((*e).press)((*e).ud, x, y)
        return
    }
    let v: *mut ds_navview.NavView = nav_of(g)
    let ev: u32 = ds_navview.press(v, x, y)
    if ev == ds_navview.EV_SELECT {
        goto_page(g, ds_navview.selected(v))
        return
    }
    if ev != ds_navview.EV_NONE { return }
    ((*e).press)((*e).ud, x, y)
}

fn key(ud: u64, k: u32, mods: u32) -> bool {
    let g: *mut Host = hp(ud)
    let cb: *mut ds_combo.Combo = accent_of(g)
    if ds_combo.is_open(cb) {
        let used: bool = ds_combo.key(cb, k, mods)
        apply_accent(g)
        return used
    }
    let e: *mut Entry = &(*g).e[(*g).page]
    if ((*e).key)((*e).ud, k, mods) { return true }
    if (*e).hosted { return false }
    if (*e).pane {
        let vv: *mut ds_navview.NavView = nav_of(g)
        let evp: u32 = ds_navview.key(vv, k, mods)
        if evp == ds_navview.EV_SELECT { goto_page(g, ds_navview.selected(vv)) }
        return evp != ds_navview.EV_NONE
    }
    if k == editor.KEY_PGDN { (*g).scroll = (*g).scroll + (*g).view_h * 0.9 }
    else if k == editor.KEY_PGUP { (*g).scroll = (*g).scroll - (*g).view_h * 0.9 }
    else if k == editor.KEY_HOME { (*g).scroll = 0.0 }
    else if k == editor.KEY_END { (*g).scroll = (*g).content_h }
    else {
        let v: *mut ds_navview.NavView = nav_of(g)
        let ev: u32 = ds_navview.key(v, k, mods)
        if ev == ds_navview.EV_SELECT { goto_page(g, ds_navview.selected(v)) }
        return ev != ds_navview.EV_NONE
    }
    return true
}

fn text(ud: u64, cp: u32, mods: u32) -> bool {
    let g: *mut Host = hp(ud)
    let cb: *mut ds_combo.Combo = accent_of(g)
    if ds_combo.is_open(cb) {
        let used: bool = ds_combo.text(cb, cp, mods)
        apply_accent(g)
        return used
    }
    let e: *mut Entry = &(*g).e[(*g).page]
    return ((*e).text)((*e).ud, cp, mods)
}

fn wheel(ud: u64, px: f64, py: f64, dx: f64, dy: f64) -> bool {
    let g: *mut Host = hp(ud)
    let e: *mut Entry = &(*g).e[(*g).page]
    if ds_combo.is_open(accent_of(g)) {
        ds_combo.wheel(accent_of(g), dy as i64)
        return true
    }
    if ((*e).wheel)((*e).ud, px, py, dx, dy) { return true }
    if (*e).hosted || (*e).pane { return false }
    (*g).scroll = (*g).scroll + dy * kit.ln(ctx_of(g), 48)
    return true
}

fn pointer(ud: u64, kind: u32, x: f64, y: f64) -> bool {
    let g: *mut Host = hp(ud)
    let e: *mut Entry = &(*g).e[(*g).page]
    return ((*e).pointer)((*e).ud, kind, x, y)
}

fn set_dark(g: *mut Host, dark: bool) {
    if DARK == dark { return }
    DARK = dark
    retheme(g)
}
