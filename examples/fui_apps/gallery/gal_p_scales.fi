import gal_host
import gal_ui
import fui.ds_tokens
import fui.lucide
import fui.painter
import fui.render

fn type_name(i: usize) -> str {
    let names: [str; 8] = ["Caption", "Body", "Body strong", "Body large", "Subtitle", "Title", "Title large", "Display"]
    return names[i]
}

fn type_role(i: usize) -> usize {
    let roles: [usize; 8] = [ds_tokens.T_CAPTION, ds_tokens.T_BODY, ds_tokens.T_BODY_STRONG, ds_tokens.T_BODY_LARGE,
        ds_tokens.T_SUBTITLE, ds_tokens.T_TITLE, ds_tokens.T_TITLE_LARGE, ds_tokens.T_DISPLAY]
    return roles[i]
}

fn paint_type(ud: u64, c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, px: f64, py: f64) -> f64 {
    var cy: f64 = y
    cy = cy + gal_ui.heading(c, x, cy, "Typography")
    cy = cy + gal_ui.note(c, x, cy, w, "Type ramp: size, line height and weight of every text role.")
    let muted: u32 = gal_ui.paint(c, ds_tokens.C_TEXT_MUTED)
    let c1: f64 = x + w - gal_ui.pt(c, 220)
    let c2: f64 = x + w - gal_ui.pt(c, 140)
    let c3: f64 = x + w - gal_ui.pt(c, 60)
    gal_ui.caption(c, c1, cy, 0.0, "Size")
    gal_ui.caption(c, c2, cy, 0.0, "Line")
    gal_ui.caption(c, c3, cy, 0.0, "Weight")
    cy = cy + gal_ui.pt(c, 28)
    var i: usize = 0
    while i < 8 {
        let role: usize = type_role(i)
        let t: ds_tokens.TypeTok = ds_tokens.type_of(gal_ui.th(c), role)
        let lh: f64 = t.line as f64
        gal_ui.text(c, x, cy, role, gal_ui.paint(c, ds_tokens.C_TEXT), type_name(i), c1 - x - gal_ui.pt(c, 12))
        gal_ui.num(c, c1, cy + (lh - gal_ui.line_h(c, ds_tokens.T_BODY)) / 2.0, ds_tokens.T_BODY, muted, t.size as i64)
        gal_ui.num(c, c2, cy + (lh - gal_ui.line_h(c, ds_tokens.T_BODY)) / 2.0, ds_tokens.T_BODY, muted, t.line as i64)
        gal_ui.num(c, c3, cy + (lh - gal_ui.line_h(c, ds_tokens.T_BODY)) / 2.0, ds_tokens.T_BODY, muted, t.weight as i64)
        cy = cy + lh + gal_ui.space(c, ds_tokens.SP_M)
        i = i + 1
    }
    return cy - y
}

fn space_name(i: usize) -> str {
    let names: [str; 14] = ["None", "XXS", "XS", "Snudge", "S", "M nudge", "M", "L", "XL", "XXL", "XXXL", "Huge", "Huger", "Max"]
    return names[i]
}

fn radius_name(i: usize) -> str {
    let names: [str; 8] = ["None", "Small", "Control", "Field", "Card", "Flyout", "Window", "Pill"]
    return names[i]
}

fn paint_layout(ud: u64, c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, px: f64, py: f64) -> f64 {
    let z: *mut painter.Painter = render.ctx_painter(c)
    var cy: f64 = y
    cy = cy + gal_ui.heading(c, x, cy, "Spacing and radii")
    cy = cy + gal_ui.note(c, x, cy, w, "Every gap and corner in the library comes from these scales.")
    cy = cy + gal_ui.section(c, x, cy, w, "Spacing")
    var i: usize = 0
    while i < (ds_tokens.SP_MAX + 1) {
        let s: f64 = gal_ui.space(c, i)
        let rh: f64 = gal_ui.pt(c, 24)
        gal_ui.text(c, x, cy, ds_tokens.T_BODY, gal_ui.paint(c, ds_tokens.C_TEXT), space_name(i), gal_ui.pt(c, 96))
        gal_ui.num(c, x + gal_ui.pt(c, 104), cy, ds_tokens.T_BODY, gal_ui.paint(c, ds_tokens.C_TEXT_MUTED), s as i64)
        if s > 0.0 { painter.round_rect(z, x + gal_ui.pt(c, 160), cy + gal_ui.pt(c, 4), s, rh - gal_ui.pt(c, 8), gal_ui.pt(c, 2), gal_ui.paint(c, ds_tokens.C_ACCENT)) }
        cy = cy + rh
        i = i + 1
    }
    cy = cy + gal_ui.section(c, x, cy, w, "Radii")
    let gap: f64 = gal_ui.space(c, ds_tokens.SP_L)
    let bw: f64 = gal_ui.pt(c, 96)
    let bh: f64 = gal_ui.pt(c, 64)
    var per: usize = ((w + gap) / (bw + gap)) as usize
    if per < 1 { per = 1 }
    i = 0
    while i < ds_tokens.RAD_COUNT {
        let bx: f64 = x + (bw + gap) * ((i % per) as f64)
        let by: f64 = cy + (bh + gal_ui.pt(c, 52)) * ((i / per) as f64)
        var r: f64 = gal_ui.radius(c, i)
        if r > bh / 2.0 { r = bh / 2.0 }
        painter.round_rect(z, bx, by, bw, bh, r, gal_ui.paint(c, ds_tokens.C_BORDER))
        painter.round_rect(z, bx + 1.0, by + 1.0, bw - 2.0, bh - 2.0, r, gal_ui.paint(c, ds_tokens.C_CARD))
        gal_ui.text(c, bx, by + bh + gal_ui.pt(c, 4), ds_tokens.T_CAPTION, gal_ui.paint(c, ds_tokens.C_TEXT), radius_name(i), bw)
        gal_ui.num(c, bx, by + bh + gal_ui.pt(c, 22), ds_tokens.T_CAPTION, gal_ui.paint(c, ds_tokens.C_TEXT_MUTED), gal_ui.radius(c, i) as i64)
        i = i + 1
    }
    let rows: usize = (ds_tokens.RAD_COUNT + per - 1) / per
    return cy - y + (bh + gal_ui.pt(c, 52)) * (rows as f64)
}

fn motion_name(i: usize) -> str {
    let names: [str; 14] = ["Press", "Hover", "Focus", "Fade", "Expand", "Collapse", "Flyout open", "Flyout close", "Dialog open", "Dialog close", "Slide", "Page", "Toast in", "Toast out"]
    return names[i]
}

fn ease_name(x1: usize) -> str {
    if x1 == 330 { return "Standard" }
    if x1 == 100 { return "Decelerate" }
    if x1 == 900 { return "Accelerate" }
    return "Linear"
}

fn bezier(a: f64, b: f64, t: f64) -> f64 {
    let u: f64 = 1.0 - t
    return 3.0 * u * u * t * a + 3.0 * u * t * t * b + t * t * t
}

fn curve(c: *mut render.Ctx, x: f64, y: f64, s: f64, m: ds_tokens.MotionTok) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    painter.round_rect(z, x, y, s, s, gal_ui.pt(c, 4), gal_ui.paint(c, ds_tokens.C_FIELD))
    let n: usize = 24
    var i: usize = 0
    let d: f64 = gal_ui.pt(c, 2)
    while i <= n {
        let t: f64 = (i as f64) / (n as f64)
        let bx: f64 = bezier((m.x1 as f64) / 1000.0, (m.x2 as f64) / 1000.0, t)
        let by: f64 = bezier((m.y1 as f64) / 1000.0, (m.y2 as f64) / 1000.0, t)
        painter.round_rect(z, x + bx * (s - d), y + (1.0 - by) * (s - d), d, d, d / 2.0, gal_ui.paint(c, ds_tokens.C_ACCENT))
        i = i + 1
    }
}

fn paint_motion(ud: u64, c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, px: f64, py: f64) -> f64 {
    let z: *mut painter.Painter = render.ctx_painter(c)
    var cy: f64 = y
    cy = cy + gal_ui.heading(c, x, cy, "Elevation and motion")
    cy = cy + gal_ui.note(c, x, cy, w, "Five shadow levels and the motion roles with their easing curves.")
    cy = cy + gal_ui.section(c, x, cy, w, "Elevation")
    let gap: f64 = gal_ui.pt(c, 32)
    let cw: f64 = gal_ui.pt(c, 120)
    let ch: f64 = gal_ui.pt(c, 80)
    var per: usize = ((w + gap) / (cw + gap)) as usize
    if per < 1 { per = 1 }
    var i: usize = 0
    while i < 5 {
        let ex: f64 = x + (cw + gap) * ((i % per) as f64) + gal_ui.pt(c, 8)
        let ey: f64 = cy + gal_ui.pt(c, 8) + (ch + gap + gal_ui.pt(c, 20)) * ((i / per) as f64)
        let r: f64 = gal_ui.radius(c, ds_tokens.RAD_CARD)
        render.draw_elevation_at(c, ex, ey, cw - gal_ui.pt(c, 16), ch, r, i)
        gal_ui.card(c, ex, ey, cw - gal_ui.pt(c, 16), ch)
        gal_ui.text(c, ex + gal_ui.pt(c, 12), ey + gal_ui.pt(c, 8), ds_tokens.T_BODY_STRONG, gal_ui.paint(c, ds_tokens.C_TEXT), "Level", 0.0)
        gal_ui.num(c, ex + gal_ui.pt(c, 60), ey + gal_ui.pt(c, 8), ds_tokens.T_BODY_STRONG, gal_ui.paint(c, ds_tokens.C_TEXT), i as i64)
        gal_ui.num(c, ex + gal_ui.pt(c, 12), ey + gal_ui.pt(c, 40), ds_tokens.T_CAPTION, gal_ui.paint(c, ds_tokens.C_TEXT_MUTED), ds_tokens.elevation(gal_ui.th(c), i).blur as i64)
        i = i + 1
    }
    let erows: usize = (5 + per - 1) / per
    cy = cy + (ch + gap + gal_ui.pt(c, 20)) * (erows as f64)
    cy = cy + gal_ui.section(c, x, cy, w, "Motion")
    let cs: f64 = gal_ui.pt(c, 40)
    let barx: f64 = x + gal_ui.pt(c, 200)
    var barw: f64 = w - gal_ui.pt(c, 200) - cs - gal_ui.pt(c, 24)
    if barw < gal_ui.pt(c, 80) { barw = gal_ui.pt(c, 80) }
    i = 0
    while i < ds_tokens.M_COUNT {
        let m: ds_tokens.MotionTok = ds_tokens.motion(gal_ui.th(c), i)
        let rh: f64 = cs + gal_ui.pt(c, 8)
        gal_ui.text(c, x, cy + (cs - gal_ui.line_h(c, ds_tokens.T_BODY)) / 2.0, ds_tokens.T_BODY, gal_ui.paint(c, ds_tokens.C_TEXT), motion_name(i), gal_ui.pt(c, 120))
        gal_ui.num(c, x + gal_ui.pt(c, 124), cy + (cs - gal_ui.line_h(c, ds_tokens.T_CAPTION)) / 2.0, ds_tokens.T_CAPTION, gal_ui.paint(c, ds_tokens.C_TEXT_MUTED), m.ms as i64)
        var bl: f64 = barw * (m.ms as f64) / 300.0
        if bl < 1.0 { bl = 1.0 }
        painter.round_rect(z, barx, cy + cs / 2.0 - gal_ui.pt(c, 3), bl, gal_ui.pt(c, 6), gal_ui.pt(c, 3), gal_ui.paint(c, ds_tokens.C_ACCENT))
        curve(c, x + w - cs, cy, cs, m)
        cy = cy + rh
        i = i + 1
    }
    return cy - y
}

fn register(g: *mut gal_host.Host) {
    gal_host.add(g, "Foundations", lucide.FILE_TEXT, "Typography", false, false, paint_type, 0)
    gal_host.add(g, "Foundations", lucide.LAYOUT_GRID, "Spacing and radii", false, false, paint_layout, 0)
    gal_host.add(g, "Foundations", lucide.LAYERS, "Elevation and motion", false, false, paint_motion, 0)
}
