import std.rt
import gal_host
import gal_ui
import fui.ds_crumb
import fui.ds_iconbtn
import fui.ds_settings
import fui.ds_tokens
import fui.lucide
import fui.render

struct Rows {
    panel: u64,
    locked: u64,
}

fn rp(ud: u64) -> *mut Rows { return ud as *mut Rows }
fn panel_of(r: *mut Rows) -> *mut ds_settings.Panel { return (*r).panel as *mut ds_settings.Panel }
fn locked_of(r: *mut Rows) -> *mut ds_settings.Panel { return (*r).locked as *mut ds_settings.Panel }

fn paint(ud: u64, c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, px: f64, py: f64) -> f64 {
    let r: *mut Rows = rp(ud)
    var cy: f64 = y
    cy = cy + gal_ui.heading(c, x, cy, "Settings rows")
    cy = cy + gal_ui.note(c, x, cy, w, "One row per setting: title, optional description, one control.")
    cy = cy + gal_ui.section(c, x, cy, w, "Row kinds")
    let p: *mut ds_settings.Panel = panel_of(r)
    ds_settings.begin(p, c, x, cy, w, px, py)
    ds_settings.row_plain(p, c, 1, lucide.INFO, "Plain row", "Shows information only")
    ds_settings.row_chevron(p, c, 2, lucide.FOLDER, "Chevron row", "Opens another page")
    ds_settings.row_value(p, c, 3, lucide.HARD_DRIVE, "Value row", "", "42 GB", true)
    ds_settings.row_toggle(p, c, 4, lucide.WIFI, "Toggle row", "Turns a feature on or off")
    ds_settings.row_combo(p, c, 5, lucide.GLOBE, "Combo row", "", "English|Deutsch|Francais")
    ds_settings.row_slider(p, c, 6, lucide.SUN, "Slider row", "", 0, 100, "%")
    ds_settings.row_button(p, c, 7, lucide.TRASH, "Button row", "Runs an action", "Clear")
    ds_settings.group_begin(p, c, 8, lucide.SETTINGS, "Expandable group", "Folds its rows away", ds_settings.body_height(c, 2, 0))
    ds_settings.row_toggle(p, c, 9, lucide.BELL, "First option", "")
    ds_settings.row_toggle(p, c, 10, lucide.LOCK, "Second option", "")
    ds_settings.group_end(p, c)
    ds_settings.end(p, c)
    cy = ds_settings.y_end(p) - 0.0
    cy = cy + gal_ui.section(c, x, cy, w, "Disabled")
    let q: *mut ds_settings.Panel = locked_of(r)
    ds_settings.begin(q, c, x, cy, w, px, py)
    ds_settings.row_toggle(q, c, 1, lucide.LOCK, "Managed by your organisation", "This setting cannot be changed")
    ds_settings.row_slider(q, c, 2, lucide.SUN, "Locked slider", "", 0, 100, "%")
    ds_settings.end(q, c)
    cy = ds_settings.y_end(q)
    return cy - y
}

fn press(ud: u64, x: f64, y: f64) {
    let r: *mut Rows = rp(ud)
    ds_settings.click(panel_of(r), x, y)
    ds_settings.click(locked_of(r), x, y)
}

fn key(ud: u64, k: u32, mods: u32) -> bool {
    let r: *mut Rows = rp(ud)
    if ds_settings.key(panel_of(r), k, mods) { return true }
    return ds_settings.key(locked_of(r), k, mods)
}

fn text(ud: u64, cp: u32, mods: u32) -> bool {
    return ds_settings.text(panel_of(rp(ud)), cp, mods)
}

fn pointer(ud: u64, kind: u32, x: f64, y: f64) -> bool {
    ds_settings.pointer(panel_of(rp(ud)), kind, x, y)
    return true
}

struct Bars {
    btns: u64,
    wide: u64,
    narrow: u64,
}

fn bp(ud: u64) -> *mut Bars { return ud as *mut Bars }

fn paint_bars(ud: u64, c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, px: f64, py: f64) -> f64 {
    let b: *mut Bars = bp(ud)
    var cy: f64 = y
    cy = cy + gal_ui.heading(c, x, cy, "Buttons and breadcrumb")
    cy = cy + gal_ui.note(c, x, cy, w, "Icon buttons replace text arrows for navigation. A breadcrumb folds into a menu when it runs out of room.")
    cy = cy + gal_ui.section(c, x, cy, w, "Icon buttons")
    let ib: *mut ds_iconbtn.Btns = (*b).btns as *mut ds_iconbtn.Btns
    ds_iconbtn.begin(ib, c, px, py)
    var bx: f64 = x
    let step: f64 = gal_ui.pt(c, 44)
    ds_iconbtn.add(ib, c, 1, bx, cy, ds_iconbtn.back_glyph(), "Back", false, true)
    bx = bx + step
    ds_iconbtn.add(ib, c, 2, bx, cy, ds_iconbtn.forward_glyph(), "Forward", false, true)
    bx = bx + step
    ds_iconbtn.add(ib, c, 3, bx, cy, lucide.REFRESH_CW, "Refresh", false, true)
    bx = bx + step
    ds_iconbtn.add(ib, c, 4, bx, cy, ds_iconbtn.more_glyph(), "More", false, true)
    bx = bx + step
    ds_iconbtn.add(ib, c, 5, bx, cy, ds_iconbtn.close_glyph(), "Close", false, false)
    bx = bx + step + gal_ui.pt(c, 16)
    ds_iconbtn.add(ib, c, 6, bx, cy, lucide.SETTINGS, "Settings", true, true)
    bx = bx + gal_ui.pt(c, 56)
    ds_iconbtn.add(ib, c, 7, bx, cy, lucide.PLAY, "Play", true, false)
    ds_iconbtn.end(ib, c)
    cy = cy + gal_ui.pt(c, 64)
    cy = cy + gal_ui.section(c, x, cy, w, "Breadcrumb")
    let k1: *mut ds_crumb.Crumbs = (*b).wide as *mut ds_crumb.Crumbs
    ds_crumb.begin(k1, c, x, cy, w, px, py)
    cy = cy + ds_crumb.draw(k1, c, "Home|Projects|Design|Gallery|Components") + gal_ui.pt(c, 16)
    ds_crumb.end(k1, c)
    gal_ui.caption(c, x, cy, w, "Narrow: the first segments fold into a menu")
    cy = cy + gal_ui.pt(c, 24)
    let k2: *mut ds_crumb.Crumbs = (*b).narrow as *mut ds_crumb.Crumbs
    ds_crumb.begin(k2, c, x, cy, gal_ui.pt(c, 280), px, py)
    cy = cy + ds_crumb.draw(k2, c, "Home|Projects|Design|Gallery|Components") + gal_ui.pt(c, 16)
    ds_crumb.end(k2, c)
    return cy - y + gal_ui.pt(c, 120)
}

fn press_bars(ud: u64, x: f64, y: f64) {
    let b: *mut Bars = bp(ud)
    ds_iconbtn.click((*b).btns as *mut ds_iconbtn.Btns, x, y)
    ds_crumb.click((*b).wide as *mut ds_crumb.Crumbs, x, y)
    ds_crumb.click((*b).narrow as *mut ds_crumb.Crumbs, x, y)
}

fn key_bars(ud: u64, k: u32, mods: u32) -> bool {
    let b: *mut Bars = bp(ud)
    if ds_iconbtn.key((*b).btns as *mut ds_iconbtn.Btns, k, mods) { return true }
    if ds_crumb.key((*b).wide as *mut ds_crumb.Crumbs, k, mods) { return true }
    return ds_crumb.key((*b).narrow as *mut ds_crumb.Crumbs, k, mods)
}

fn register(g: *mut gal_host.Host) {
    let r: *mut Rows = rt.heap_alloc(64) as *mut Rows
    (*r).panel = ds_settings.panel_new() as u64
    (*r).locked = ds_settings.panel_new() as u64
    ds_settings.set_val(panel_of(r), 4, 1)
    ds_settings.set_val(panel_of(r), 6, 60)
    ds_settings.set_val(panel_of(r), 9, 1)
    ds_settings.set_val(locked_of(r), 1, 1)
    ds_settings.set_val(locked_of(r), 2, 35)
    ds_settings.set_enabled(locked_of(r), 1, false)
    ds_settings.set_enabled(locked_of(r), 2, false)
    let e: *mut gal_host.Entry = gal_host.add(g, "Controls", lucide.SLIDERS_HORIZONTAL, "Settings rows", false, false, paint, r as u64)
    (*e).press = press
    (*e).key = key
    (*e).text = text
    (*e).pointer = pointer
    let b: *mut Bars = rt.heap_alloc(64) as *mut Bars
    (*b).btns = ds_iconbtn.btns_new() as u64
    (*b).wide = ds_crumb.crumbs_new() as u64
    (*b).narrow = ds_crumb.crumbs_new() as u64
    let f: *mut gal_host.Entry = gal_host.add(g, "Controls", lucide.APP_WINDOW, "Buttons", false, false, paint_bars, b as u64)
    (*f).press = press_bars
    (*f).key = key_bars
}
