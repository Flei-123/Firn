import fui.ds_tokens
import fui.kit
import fui.painter
import fui.render
import fui.theme

const NONE: usize = 18446744073709551615

fn th(c: *mut render.Ctx) -> *mut theme.Theme { return render.ctx_theme(c) }
fn paint(c: *mut render.Ctx, role: usize) -> u32 { return ds_tokens.paint(th(c), role) }
fn pt(c: *mut render.Ctx, n: usize) -> f64 { return kit.ln(c, n) }
fn space(c: *mut render.Ctx, role: usize) -> f64 { return ds_tokens.space(th(c), role) as f64 }
fn radius(c: *mut render.Ctx, role: usize) -> f64 { return ds_tokens.radius(th(c), role) as f64 }

fn unscale(c: *mut render.Ctx, v: usize) -> f64 {
    let s: usize = theme.theme_text_scale(th(c))
    return (v as f64) * 1000.0 / (s as f64)
}

fn line_h(c: *mut render.Ctx, role: usize) -> f64 { return ds_tokens.type_of(th(c), role).line as f64 }

fn text(c: *mut render.Ctx, x: f64, y: f64, role: usize, col: u32, s: str, max_w: f64) -> f64 {
    let t: ds_tokens.TypeTok = ds_tokens.type_of(th(c), role)
    return kit.draw_label(c, x, y, t.line as f64, unscale(c, t.size), t.weight, col, s, max_w)
}

fn text_w(c: *mut render.Ctx, role: usize, s: str) -> f64 {
    let t: ds_tokens.TypeTok = ds_tokens.type_of(th(c), role)
    return kit.text_width(c, unscale(c, t.size), t.weight, s)
}

fn fmt_num(v: i64, buf: *mut [u8; 24]) -> usize {
    var tmp: [u8; 24] = [0 as u8; 24]
    var n: usize = 0
    var u: u64 = v as u64
    if v < 0 as i64 { u = (0 as i64 - v) as u64 }
    if u == 0 as u64 {
        tmp[0] = 48 as u8
        n = 1
    }
    while u > 0 as u64 {
        tmp[n] = (48 as u64 + u % 10 as u64) as u8
        u = u / 10 as u64
        n = n + 1
    }
    var o: usize = 0
    if v < 0 as i64 {
        (*buf)[0] = 45 as u8
        o = 1
    }
    var i: usize = 0
    while i < n {
        (*buf)[o + i] = tmp[n - 1 - i]
        i = i + 1
    }
    return o + n
}

#[allow_escape]
fn num(c: *mut render.Ctx, x: f64, y: f64, role: usize, col: u32, v: i64) -> f64 {
    var buf: [u8; 24] = [0 as u8; 24]
    let n: usize = fmt_num(v, &buf)
    return text(c, x, y, role, col, str { p: ((&buf[0]) as u64) as *mut u8, n: n }, 0.0)
}

fn heading(c: *mut render.Ctx, x: f64, y: f64, s: str) -> f64 {
    text(c, x, y, ds_tokens.T_TITLE, paint(c, ds_tokens.C_TEXT), s, 0.0)
    return line_h(c, ds_tokens.T_TITLE) + space(c, ds_tokens.SP_M)
}

fn note(c: *mut render.Ctx, x: f64, y: f64, w: f64, s: str) -> f64 {
    text(c, x, y, ds_tokens.T_BODY, paint(c, ds_tokens.C_TEXT_MUTED), s, w)
    return line_h(c, ds_tokens.T_BODY) + space(c, ds_tokens.SP_L)
}

fn section(c: *mut render.Ctx, x: f64, y: f64, w: f64, s: str) -> f64 {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let top: f64 = y + space(c, ds_tokens.SP_M)
    text(c, x, top, ds_tokens.T_SUBTITLE, paint(c, ds_tokens.C_TEXT), s, w)
    let ly: f64 = top + line_h(c, ds_tokens.T_SUBTITLE) + space(c, ds_tokens.SP_XS)
    painter.surface(z, x, ly, w, 1.0, paint(c, ds_tokens.C_SEPARATOR))
    return ly + 1.0 + space(c, ds_tokens.SP_M) - y
}

fn caption(c: *mut render.Ctx, x: f64, y: f64, w: f64, s: str) -> f64 {
    text(c, x, y, ds_tokens.T_CAPTION, paint(c, ds_tokens.C_TEXT_MUTED), s, w)
    return line_h(c, ds_tokens.T_CAPTION)
}

fn card(c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let r: f64 = radius(c, ds_tokens.RAD_CARD)
    painter.round_rect(z, x, y, w, h, r, paint(c, ds_tokens.C_CARD_BORDER))
    painter.round_rect(z, x + 1.0, y + 1.0, w - 2.0, h - 2.0, r, paint(c, ds_tokens.C_CARD))
}

fn inside(px: f64, py: f64, x: f64, y: f64, w: f64, h: f64) -> bool {
    return px >= x && px < x + w && py >= y && py < y + h
}
