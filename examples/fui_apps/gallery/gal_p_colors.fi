import gal_host
import gal_ui
import fui.ds_tokens
import fui.lucide
import fui.painter
import fui.render

fn role_name(i: usize) -> str {
    let names: [str; 34] = ["Base", "Surface", "Raised", "Button", "Button hover", "Button pressed", "Field", "Field focus", "Border", "Separator",
        "Text", "Text muted", "Text disabled", "Text on accent", "Accent", "Selection", "Selection text", "Error", "Warning", "Success",
        "Accent hover", "Accent pressed", "Accent text", "Focus ring", "Card", "Card border", "Info", "Info background", "Success background",
        "Warning background", "Error background", "Subtle hover", "Subtle pressed", "Scrim"]
    return names[i]
}

fn paint(ud: u64, c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, px: f64, py: f64) -> f64 {
    let z: *mut painter.Painter = render.ctx_painter(c)
    var cy: f64 = y
    cy = cy + gal_ui.heading(c, x, cy, "Colours")
    cy = cy + gal_ui.note(c, x, cy, w, "Semantic roles of the active theme. Switch light, dark and accent in the footer.")
    let gap: f64 = gal_ui.space(c, ds_tokens.SP_M)
    var cols: usize = (w / gal_ui.pt(c, 168)) as usize
    if cols < 1 { cols = 1 }
    let tw: f64 = (w - gap * ((cols - 1) as f64)) / (cols as f64)
    let chip: f64 = gal_ui.pt(c, 48)
    let th: f64 = chip + gal_ui.pt(c, 28)
    var i: usize = 0
    while i < ds_tokens.C_COUNT {
        let col: usize = i % cols
        let row: usize = i / cols
        let tx: f64 = x + (tw + gap) * (col as f64)
        let ty: f64 = cy + (th + gap) * (row as f64)
        let r: f64 = gal_ui.radius(c, ds_tokens.RAD_CONTROL)
        painter.round_rect(z, tx, ty, tw, chip, r, gal_ui.paint(c, ds_tokens.C_BORDER))
        painter.round_rect(z, tx + 1.0, ty + 1.0, tw - 2.0, chip - 2.0, r, gal_ui.paint(c, ds_tokens.C_BASE))
        painter.round_rect(z, tx + 1.0, ty + 1.0, tw - 2.0, chip - 2.0, r, gal_ui.paint(c, i))
        gal_ui.text(c, tx, ty + chip + gal_ui.pt(c, 4), ds_tokens.T_CAPTION, gal_ui.paint(c, ds_tokens.C_TEXT), role_name(i), tw)
        i = i + 1
    }
    let rows: usize = (ds_tokens.C_COUNT + cols - 1) / cols
    return cy - y + (th + gap) * (rows as f64)
}

fn register(g: *mut gal_host.Host) {
    gal_host.add(g, "Foundations", lucide.SPARKLES, "Colours", false, false, paint, 0)
}
