import std.rt
import gal_host
import gal_ui
import fui.ds_appcard
import fui.ds_listdetail
import fui.ds_navview
import fui.ds_tokens
import fui.ds_vgrid
import fui.lucide
import fui.painter
import fui.render

struct Cards {
    k: [ds_appcard.Card; 5],
}

fn cp(ud: u64) -> *mut Cards { return ud as *mut Cards }

fn state_name(i: usize) -> str {
    let names: [str; 5] = ["Install", "Open", "Update", "Installing", "Unavailable"]
    return names[i]
}

fn paint_cards(ud: u64, c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, px: f64, py: f64) -> f64 {
    let s: *mut Cards = cp(ud)
    var cy: f64 = y
    cy = cy + gal_ui.heading(c, x, cy, "App cards")
    cy = cy + gal_ui.note(c, x, cy, w, "One state button per card: install, open, update, progress or unavailable.")
    let ph: f64 = ds_appcard.preferred_h(c)
    let gap: f64 = gal_ui.space(c, ds_tokens.SP_L)
    var per: usize = ((w + gap) / (gal_ui.pt(c, 280) + gap)) as usize
    if per < 1 { per = 1 }
    let cw: f64 = (w - gap * ((per - 1) as f64)) / (per as f64)
    var i: usize = 0
    while i < 5 {
        let tx: f64 = x + (cw + gap) * ((i % per) as f64)
        let ty: f64 = cy + (ph + gap + gal_ui.pt(c, 24)) * ((i / per) as f64)
        gal_ui.caption(c, tx, ty, cw, state_name(i))
        ds_appcard.draw(&(*s).k[i], c, tx, ty + gal_ui.pt(c, 24), cw, ph, lucide.PACKAGE, "Notes", "Productivity", "4.8 stars", px, py)
        i = i + 1
    }
    let rows: usize = (5 + per - 1) / per
    return cy - y + (ph + gap + gal_ui.pt(c, 24)) * (rows as f64)
}

fn press_cards(ud: u64, x: f64, y: f64) {
    let s: *mut Cards = cp(ud)
    var i: usize = 0
    while i < 5 {
        ds_appcard.click(&(*s).k[i], x, y)
        i = i + 1
    }
}

fn key_cards(ud: u64, k: u32, mods: u32) -> bool {
    let s: *mut Cards = cp(ud)
    var i: usize = 0
    while i < 5 {
        if ds_appcard.key(&(*s).k[i], k, mods) != ds_appcard.ACT_NONE { return true }
        i = i + 1
    }
    return false
}

struct Navs {
    compact: ds_navview.NavView,
    minimal: ds_navview.NavView,
}

fn np(ud: u64) -> *mut Navs { return ud as *mut Navs }

fn nav_fill(v: *mut ds_navview.NavView) {
    ds_navview.add(v, lucide.HOUSE, "Home")
    ds_navview.add(v, lucide.PACKAGE, "Apps")
    ds_navview.add(v, lucide.DOWNLOAD, "Downloads")
    ds_navview.add_footer(v, lucide.SETTINGS, "Settings")
    ds_navview.select(v, 1)
}

fn demo(c: *mut render.Ctx, v: *mut ds_navview.NavView, x: f64, y: f64, w: f64, h: f64, px: f64, py: f64) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    painter.surface(z, x, y, w, h, gal_ui.paint(c, ds_tokens.C_BASE))
    ds_navview.layout(v, c, x, y, w, h)
    ds_navview.draw(v, c, px, py)
    gal_ui.text(c, ds_navview.content_x(v) + gal_ui.pt(c, 16), ds_navview.content_y(v) + gal_ui.pt(c, 16), ds_tokens.T_SUBTITLE, gal_ui.paint(c, ds_tokens.C_TEXT), ds_navview.label_at(v, ds_navview.selected(v)), 0.0)
    ds_navview.draw_overlay(v, c, px, py)
}

fn paint_navs(ud: u64, c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, px: f64, py: f64) -> f64 {
    let s: *mut Navs = np(ud)
    var cy: f64 = y
    cy = cy + gal_ui.heading(c, x, cy, "Navigation")
    cy = cy + gal_ui.note(c, x, cy, w, "The pane adapts to the width. This window uses the expanded mode.")
    cy = cy + gal_ui.section(c, x, cy, w, "Compact")
    var cw: f64 = gal_ui.pt(c, 720)
    if cw > w { cw = w }
    let dh: f64 = gal_ui.pt(c, 240)
    demo(c, &(*s).compact, x, cy, cw, dh, px, py)
    cy = cy + dh
    cy = cy + gal_ui.section(c, x, cy, w, "Minimal")
    var mw: f64 = gal_ui.pt(c, 400)
    if mw > w { mw = w }
    demo(c, &(*s).minimal, x, cy, mw, dh, px, py)
    cy = cy + dh
    return cy - y
}

fn press_navs(ud: u64, x: f64, y: f64) {
    let s: *mut Navs = np(ud)
    ds_navview.press(&(*s).compact, x, y)
    ds_navview.press(&(*s).minimal, x, y)
}

struct Lists {
    ld: ds_listdetail.ListDetail,
    grid: ds_vgrid.Grid,
    cards: [ds_appcard.Card; 64],
}

fn lp(ud: u64) -> *mut Lists { return ud as *mut Lists }

fn paint_lists(ud: u64, c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, px: f64, py: f64) -> f64 {
    let s: *mut Lists = lp(ud)
    var cy: f64 = y
    cy = cy + gal_ui.heading(c, x, cy, "List and grid")
    cy = cy + gal_ui.note(c, x, cy, w, "A list with a detail pane, and a virtual grid that only draws what is visible.")
    cy = cy + gal_ui.section(c, x, cy, w, "List and detail")
    let dh: f64 = gal_ui.pt(c, 300)
    let l: *mut ds_listdetail.ListDetail = &(*s).ld
    ds_listdetail.layout(l, c, x, cy, w, dh)
    ds_listdetail.begin_list(l, c, "Items")
    let g: *mut ds_vgrid.Grid = ds_listdetail.list_of(l)
    var i: usize = ds_vgrid.first(g)
    while i < ds_vgrid.end_index(g) {
        ds_listdetail.row_draw(l, c, i, lucide.FILE_TEXT, "Document", "Edited today", px, py)
        i = i + 1
    }
    ds_listdetail.finish_list(l, c)
    ds_listdetail.draw_chrome(l, c, "Document", px, py)
    if ds_listdetail.detail_visible(l) {
        gal_ui.text(c, ds_listdetail.detail_x(l) + gal_ui.pt(c, 16), ds_listdetail.detail_y(l) + gal_ui.pt(c, 16), ds_tokens.T_SUBTITLE, gal_ui.paint(c, ds_tokens.C_TEXT), "Document", 0.0)
        gal_ui.num(c, ds_listdetail.detail_x(l) + gal_ui.pt(c, 140), ds_listdetail.detail_y(l) + gal_ui.pt(c, 16), ds_tokens.T_SUBTITLE, gal_ui.paint(c, ds_tokens.C_TEXT), ds_vgrid.selected(g) as i64)
    }
    cy = cy + dh
    cy = cy + gal_ui.section(c, x, cy, w, "Virtual grid")
    let gh: f64 = gal_ui.pt(c, 360)
    let vg: *mut ds_vgrid.Grid = &(*s).grid
    ds_vgrid.set_cell(vg, 240, ds_appcard.preferred_h(c) as usize, 12)
    ds_vgrid.layout(vg, c, x, cy, w, gh)
    ds_vgrid.begin(vg, c, "Apps")
    var r: [f64; 4] = [0.0; 4]
    i = ds_vgrid.first(vg)
    let e: usize = ds_vgrid.end_index(vg)
    while i < e {
        ds_vgrid.cell_rect(vg, i, &r)
        ds_appcard.set_state(&(*s).cards[i % 64], (i % 3) as u32)
        ds_appcard.draw(&(*s).cards[i % 64], c, r[0], r[1], r[2], r[3], lucide.PACKAGE, "Application", "Publisher", "4.8 stars", px, py)
        i = i + 1
    }
    ds_vgrid.finish(vg, c)
    cy = cy + gh
    return cy - y
}

fn press_lists(ud: u64, x: f64, y: f64) {
    let s: *mut Lists = lp(ud)
    ds_listdetail.press(&(*s).ld, x, y)
    ds_vgrid.press(&(*s).grid, x, y)
}

fn pointer_lists(ud: u64, kind: u32, x: f64, y: f64) -> bool {
    let s: *mut Lists = lp(ud)
    ds_listdetail.release(&(*s).ld)
    ds_vgrid.release(&(*s).grid)
    return true
}

fn key_lists(ud: u64, k: u32, mods: u32) -> bool {
    let s: *mut Lists = lp(ud)
    if ds_listdetail.key(&(*s).ld, k, mods) != ds_listdetail.EV_NONE { return true }
    return ds_vgrid.key(&(*s).grid, k, mods)
}

fn register(g: *mut gal_host.Host) {
    let a: *mut Cards = rt.heap_alloc(1 << 16) as *mut Cards
    var i: usize = 0
    while i < 5 {
        (*a).k[i] = ds_appcard.card_new()
        ds_appcard.set_state(&(*a).k[i], i as u32)
        i = i + 1
    }
    ds_appcard.set_progress(&(*a).k[3], 420 as i64)
    let e: *mut gal_host.Entry = gal_host.add(g, "Catalog", lucide.PACKAGE, "App cards", false, false, paint_cards, a as u64)
    (*e).press = press_cards
    (*e).key = key_cards
    let n: *mut Navs = rt.heap_alloc(1 << 17) as *mut Navs
    (*n).compact = ds_navview.nv_new()
    (*n).minimal = ds_navview.nv_new()
    nav_fill(&(*n).compact)
    nav_fill(&(*n).minimal)
    let f: *mut gal_host.Entry = gal_host.add(g, "Catalog", lucide.MENU, "Navigation", false, false, paint_navs, n as u64)
    (*f).press = press_navs
    let s: *mut Lists = rt.heap_alloc(1 << 20) as *mut Lists
    (*s).ld = ds_listdetail.ld_new()
    ds_listdetail.set_count(&(*s).ld, 40)
    (*s).grid = ds_vgrid.grid_new()
    ds_vgrid.set_count(&(*s).grid, 5000)
    i = 0
    while i < 64 {
        (*s).cards[i] = ds_appcard.card_new()
        i = i + 1
    }
    let q: *mut gal_host.Entry = gal_host.add(g, "Catalog", lucide.LIST, "List and grid", false, false, paint_lists, s as u64)
    (*q).press = press_lists
    (*q).pointer = pointer_lists
    (*q).key = key_lists
}

