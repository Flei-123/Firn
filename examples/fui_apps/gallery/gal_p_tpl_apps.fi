import gal_host
import fui.ds_icons
import fui.ds_icons_names
import fui.ds_tpl_demo_files
import fui.ds_tpl_demo_store
import fui.ds_tpl_files
import fui.ds_tpl_store
import fui.render

fn pane_store(ud: u64, c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, px: f64, py: f64) -> f64 {
    ds_tpl_store.paint_in(ud, c, x, y, w, h, px, py)
    return 0.0
}

fn pane_files(ud: u64, c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, px: f64, py: f64) -> f64 {
    ds_tpl_files.paint_in(ud, c, x, y, w, h, px, py)
    return 0.0
}

fn register(g: *mut gal_host.Host) {
    let s: *mut ds_tpl_store.Store = ds_tpl_store.store_new(ds_tpl_demo_store.spec())
    let a: *mut gal_host.Entry = gal_host.add_pane(g, "Templates", ds_icons.gid(ds_icons_names.APPS), "Store template", pane_store, s as u64)
    (*a).press = ds_tpl_store.press
    (*a).key = ds_tpl_store.key
    (*a).text = ds_tpl_store.text
    (*a).wheel = ds_tpl_store.wheel
    (*a).pointer = ds_tpl_store.pointer
    let f: *mut ds_tpl_files.Files = ds_tpl_files.files_new(ds_tpl_demo_files.spec())
    ds_tpl_files.go(f, 0, true)
    let b: *mut gal_host.Entry = gal_host.add_pane(g, "Templates", ds_icons.gid(ds_icons_names.FOLDER), "Files template", pane_files, f as u64)
    (*b).press = ds_tpl_files.press
    (*b).key = ds_tpl_files.key
    (*b).text = ds_tpl_files.text
    (*b).wheel = ds_tpl_files.wheel
    (*b).pointer = ds_tpl_files.pointer
}
