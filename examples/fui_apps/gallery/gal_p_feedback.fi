import std.rt
import gal_host
import gal_ui
import fui.ds_combo
import fui.ds_fbtok
import fui.ds_infobar
import fui.ds_swatch
import fui.ds_toast
import fui.ds_tokens
import fui.lucide
import fui.render

const NOW_MS: i64 = 2000
const STAGE_PT: usize = 250

struct Feedback {
    bars: [u64; 4],
    feed: u64,
}

fn fb(ud: u64) -> *mut Feedback { return ud as *mut Feedback }
fn feed_of(f: *mut Feedback) -> *mut ds_toast.Feed { return (*f).feed as *mut ds_toast.Feed }
fn bar_of(f: *mut Feedback, i: usize) -> *mut ds_infobar.Bar { return (*f).bars[i] as *mut ds_infobar.Bar }

fn paint(ud: u64, c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, px: f64, py: f64) -> f64 {
    let f: *mut Feedback = fb(ud)
    var cy: f64 = y
    cy = cy + gal_ui.heading(c, x, cy, "Feedback")
    cy = cy + gal_ui.note(c, x, cy, w, "Info bars stay in the page. Toasts appear in the corner and pause while you read them.")
    cy = cy + gal_ui.section(c, x, cy, w, "Info bar")
    let gap: f64 = gal_ui.space(c, ds_tokens.SP_S)
    cy = cy + ds_infobar.draw(bar_of(f, 0), c, x, cy, w, ds_fbtok.INFO, "Update ready", "Restart to finish installing.", "Restart", true, px, py) + gap
    cy = cy + ds_infobar.draw(bar_of(f, 1), c, x, cy, w, ds_fbtok.SUCCESS, "Saved", "Your profile was stored.", "", true, px, py) + gap
    cy = cy + ds_infobar.draw(bar_of(f, 2), c, x, cy, w, ds_fbtok.WARNING, "Low disk space", "Only 2 GB are left on this drive.", "Clean up", true, px, py) + gap
    cy = cy + ds_infobar.draw(bar_of(f, 3), c, x, cy, w, ds_fbtok.ERROR, "Upload failed", "The server did not answer. Check the network and try again.", "Retry", true, px, py) + gap
    cy = cy + gal_ui.section(c, x, cy, w, "Toast")
    let sh: f64 = gal_ui.pt(c, STAGE_PT)
    gal_ui.card(c, x, cy, w, sh)
    ds_toast.draw(feed_of(f), c, x + w, cy + sh, NOW_MS)
    cy = cy + sh
    return cy - y
}

fn press(ud: u64, x: f64, y: f64) {
    let f: *mut Feedback = fb(ud)
    var i: usize = 0
    while i < 4 {
        ds_infobar.press(bar_of(f, i), x, y)
        i = i + 1
    }
}

fn key(ud: u64, k: u32, mods: u32) -> bool {
    let f: *mut Feedback = fb(ud)
    var i: usize = 0
    while i < 4 {
        if ds_infobar.key(bar_of(f, i), k, mods) != ds_infobar.EV_NONE { return true }
        i = i + 1
    }
    return false
}

struct Pickers {
    swatch: u64,
    combo: u64,
    fruit: u64,
}

fn pk(ud: u64) -> *mut Pickers { return ud as *mut Pickers }
fn swatch_of(p: *mut Pickers) -> *mut ds_swatch.Swatch { return (*p).swatch as *mut ds_swatch.Swatch }
fn combo_of(p: *mut Pickers) -> *mut ds_combo.Combo { return (*p).combo as *mut ds_combo.Combo }
fn fruit_of(p: *mut Pickers) -> *mut ds_combo.Combo { return (*p).fruit as *mut ds_combo.Combo }

fn paint_pickers(ud: u64, c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, px: f64, py: f64) -> f64 {
    let p: *mut Pickers = pk(ud)
    var cy: f64 = y
    cy = cy + gal_ui.heading(c, x, cy, "Pickers")
    cy = cy + gal_ui.note(c, x, cy, w, "Pick a colour from the palette or type your own. Pick an item from a searchable list.")
    cy = cy + gal_ui.section(c, x, cy, w, "Colour swatch")
    cy = cy + ds_swatch.draw(swatch_of(p), c, x, cy, w, "Accent colour", px, py) + gal_ui.pt(c, 16)
    cy = cy + gal_ui.section(c, x, cy, w, "Combo box")
    var cw: f64 = gal_ui.pt(c, 240)
    if cw > w { cw = w }
    let vb: f64 = gal_host.view_bottom()
    cy = cy + ds_combo.draw(combo_of(p), c, x, cy, cw, "Fruit", "Search fruit", px, py, vb) + gal_ui.pt(c, 220)
    ds_combo.end(combo_of(p), c)
    return cy - y
}

fn press_pickers(ud: u64, x: f64, y: f64) {
    let p: *mut Pickers = pk(ud)
    ds_swatch.press(swatch_of(p), x, y)
    ds_combo.press(combo_of(p), x, y)
}

fn key_pickers(ud: u64, k: u32, mods: u32) -> bool {
    let p: *mut Pickers = pk(ud)
    if ds_combo.key(combo_of(p), k, mods) { return true }
    return ds_swatch.key(swatch_of(p), k, mods)
}

fn text_pickers(ud: u64, cp: u32, mods: u32) -> bool {
    let p: *mut Pickers = pk(ud)
    if ds_combo.text(combo_of(p), cp, mods) { return true }
    return ds_swatch.text(swatch_of(p), cp, mods)
}

fn wheel_pickers(ud: u64, px: f64, py: f64, dx: f64, dy: f64) -> bool {
    let p: *mut Pickers = pk(ud)
    if !ds_combo.is_open(combo_of(p)) { return false }
    ds_combo.wheel(combo_of(p), dy as i64)
    return true
}

fn register(g: *mut gal_host.Host) {
    let f: *mut Feedback = rt.heap_alloc(256) as *mut Feedback
    var i: usize = 0
    while i < 4 {
        (*f).bars[i] = ds_infobar.bar_new() as u64
        i = i + 1
    }
    (*f).feed = ds_toast.feed_new() as u64
    ds_toast.push(feed_of(f), ds_fbtok.INFO, "Saved", "Profile stored", "Undo", 1000, 3600000)
    ds_toast.push(feed_of(f), ds_fbtok.WARNING, "Battery", "15 percent left", "", 1000, 3600000)
    ds_toast.push(feed_of(f), ds_fbtok.ERROR, "Failed", "Disk full", "Details", 1000, 3600000)
    let e: *mut gal_host.Entry = gal_host.add(g, "Controls", lucide.INFO, "Feedback", false, false, paint, f as u64)
    (*e).press = press
    (*e).key = key
    let p: *mut Pickers = rt.heap_alloc(64) as *mut Pickers
    (*p).swatch = ds_swatch.swatch_new() as u64
    (*p).combo = ds_combo.combo_new() as u64
    ds_swatch.set_custom(swatch_of(p), true)
    ds_swatch.set_rgb(swatch_of(p), 0x0078d4 as u32)
    ds_combo.set_items(combo_of(p), "Apple|Apricot|Banana|Blueberry|Cherry|Grape|Lemon|Mango|Orange|Peach|Pear|Plum")
    let q: *mut gal_host.Entry = gal_host.add(g, "Controls", lucide.PUZZLE, "Pickers", false, false, paint_pickers, p as u64)
    (*q).press = press_pickers
    (*q).key = key_pickers
    (*q).text = text_pickers
    (*q).wheel = wheel_pickers
}
