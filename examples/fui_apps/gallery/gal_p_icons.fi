import gal_host
import gal_ui
import fui.ds_icons
import fui.ds_tokens
import fui.lucide
import fui.painter
import fui.render

fn sheet(c: *mut render.Ctx, x: f64, y: f64, w: f64, count: i64, filled: bool) -> f64 {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let tw: f64 = gal_ui.pt(c, 112)
    let th: f64 = gal_ui.pt(c, 72)
    var per: usize = (w / tw) as usize
    if per < 1 { per = 1 }
    var i: i64 = 0
    while i < count {
        let col: usize = (i as usize) % per
        let row: usize = (i as usize) / per
        let tx: f64 = x + tw * (col as f64)
        let ty: f64 = y + th * (row as f64)
        let s: f64 = gal_ui.pt(c, 24)
        ds_icons.draw_id(render.ctx_painter(c), i, tx + (tw - s) / 2.0, ty + gal_ui.pt(c, 8), s, gal_ui.paint(c, ds_tokens.C_TEXT), filled)
        let nw: f64 = gal_ui.text_w(c, ds_tokens.T_CAPTION, ds_icons.name_of(i))
        var nx: f64 = tx + (tw - nw) / 2.0
        if nx < tx { nx = tx }
        gal_ui.text(c, nx, ty + gal_ui.pt(c, 40), ds_tokens.T_CAPTION, gal_ui.paint(c, ds_tokens.C_TEXT_MUTED), ds_icons.name_of(i), tw - gal_ui.pt(c, 4))
        i = i + 1
    }
    let rows: usize = ((count as usize) + per - 1) / per
    return th * (rows as f64)
}

fn paint(ud: u64, c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, px: f64, py: f64) -> f64 {
    var cy: f64 = y
    cy = cy + gal_ui.heading(c, x, cy, "Icons")
    cy = cy + gal_ui.note(c, x, cy, w, "Fluent System Icons, three raster grades, regular and filled.")
    cy = cy + gal_ui.section(c, x, cy, w, "Regular")
    cy = cy + sheet(c, x, cy, w, ds_icons.count(), false)
    cy = cy + gal_ui.section(c, x, cy, w, "Filled")
    cy = cy + sheet(c, x, cy, w, 24, true)
    return cy - y
}

fn register(g: *mut gal_host.Host) {
    gal_host.add(g, "Foundations", lucide.IMAGE, "Icons", false, false, paint, 0)
}
