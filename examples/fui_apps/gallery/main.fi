import gal_host
import gal_p_catalog
import gal_p_colors
import gal_p_feedback
import gal_p_icons
import gal_p_rows
import gal_p_scales
import gal_p_tpl
import gal_p_tpl_apps
import std.rt
import fui.screen

fn arg_num(start: u64, name: str, fallback: usize) -> usize {
    let a: u64 = screen.arg_after(start, name)
    if a == 0 { return fallback }
    var v: usize = 0
    var i: usize = 0
    while rt.ld8(a, i) >= 48 as u8 && rt.ld8(a, i) <= 57 as u8 {
        v = v * 10 + (rt.ld8(a, i) - 48 as u8) as usize
        i = i + 1
    }
    return v
}

fn main(start: u64) -> i32 {
    var dark: bool = true
    let t: u64 = screen.arg_after(start, "--theme")
    if t != 0 && rt.ld8(t, 0) == 108 as u8 { dark = false }
    let g: *mut gal_host.Host = gal_host.host_new(arg_num(start, "--accent", 0), dark)
    gal_p_colors.register(g)
    gal_p_scales.register(g)
    gal_p_icons.register(g)
    gal_p_rows.register(g)
    gal_p_feedback.register(g)
    gal_p_catalog.register(g)
    gal_p_tpl.register(g)
    gal_p_tpl_apps.register(g)
    gal_host.goto_page(g, arg_num(start, "--page", 0))
    return screen.run_full(start, "Design system gallery", 1200, 900, g as u64, gal_host.paint, gal_host.press, gal_host.key, gal_host.text, gal_host.wheel, gal_host.pointer, gal_host.skin)
}
