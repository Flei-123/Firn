import std.rt
import gal_host
import gal_ui
import fui.ds_settings
import fui.ds_tpl_settings
import fui.ds_tpl_wizard
import fui.editor
import fui.kit
import fui.kitform
import fui.lucide
import fui.render

static mut HOST: u64 = 0
static mut WPANEL: u64 = 0
static mut WNAME: u64 = 0
static mut WMAIL: u64 = 0
static mut WFX: f64 = 0.0
static mut WFY: f64 = 0.0
static mut WFW: f64 = 0.0

fn paint_settings(ud: u64, c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, px: f64, py: f64) -> f64 {
    ds_tpl_settings.paint(ud, c, w, h, px, py)
    return 0.0
}

fn paint_wizard(ud: u64, c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, px: f64, py: f64) -> f64 {
    ds_tpl_wizard.paint(ud, c, w, h, px, py)
    return 0.0
}

fn on_apply(ud: u64, id: usize, v: i64) {
    if id == 1 { gal_host.set_dark(HOST as *mut gal_host.Host, v == 1) }
}

fn on_fire(ud: u64, id: usize) {}

fn build_settings() -> *mut ds_tpl_settings.Tpl {
    let t: *mut ds_tpl_settings.Tpl = ds_tpl_settings.new("Settings", on_apply, on_fire, 0)
    (*t).ud = t as u64
    ds_tpl_settings.page(t, lucide.MONITOR, "System")
    ds_tpl_settings.section(t, "Display")
    ds_tpl_settings.toggle(t, 1, lucide.MOON, "Dark mode", "Switch the whole app instantly")
    ds_tpl_settings.combo(t, 2, lucide.GLOBE, "Language", "", "English|Deutsch|Francais")
    ds_tpl_settings.slider(t, 3, lucide.SUN, "Brightness", "", 0, 100, "%")
    ds_tpl_settings.section(t, "Power")
    ds_tpl_settings.toggle(t, 4, lucide.CLOCK, "Sleep when idle", "Save energy after 10 minutes")
    ds_tpl_settings.link(t, 5, lucide.HARD_DRIVE, "Storage", "Manage disks and cleanup")
    ds_tpl_settings.page(t, lucide.WIFI, "Network")
    ds_tpl_settings.section(t, "Connection")
    ds_tpl_settings.toggle(t, 6, lucide.WIFI, "Wi-Fi", "Connected to Home")
    ds_tpl_settings.value(t, 7, lucide.GLOBE, "Proxy", "", "Off")
    ds_tpl_settings.button(t, 8, lucide.SETTINGS, "Network reset", "Forget all saved networks", "Reset")
    ds_tpl_settings.page(t, lucide.LOCK, "Privacy")
    ds_tpl_settings.section(t, "Permissions")
    ds_tpl_settings.toggle(t, 9, lucide.BELL, "Notifications", "Allow apps to notify you")
    ds_tpl_settings.toggle(t, 10, lucide.USERS, "Diagnostics", "Send anonymous usage data")
    if gal_host.is_dark() { ds_tpl_settings.set(t, 1, 1) }
    ds_tpl_settings.set(t, 3, 70)
    ds_tpl_settings.set(t, 6, 1)
    ds_tpl_settings.set(t, 9, 1)
    return t
}

fn wpanel() -> *mut ds_settings.Panel { return WPANEL as *mut ds_settings.Panel }
fn wname() -> *mut kit.Search { return WNAME as *mut kit.Search }
fn wmail() -> *mut kit.Search { return WMAIL as *mut kit.Search }

fn wizard_draw(ud: u64, c: *mut render.Ctx, step: usize, x: f64, y: f64, w: f64, h: f64, px: f64, py: f64) {
    if step == 1 {
        let p: *mut ds_settings.Panel = wpanel()
        ds_settings.begin(p, c, x, y, w, px, py)
        ds_settings.row_combo(p, c, 1, lucide.GLOBE, "Language", "", "English|Deutsch|Francais")
        ds_settings.row_combo(p, c, 2, lucide.CLOCK, "Time zone", "", "UTC|Berlin|New York")
        ds_settings.row_toggle(p, c, 3, lucide.WIFI, "Connect to Wi-Fi", "Use the network Home")
        ds_settings.end(p, c)
    }
    if step == 2 {
        WFX = x
        WFY = y
        WFW = w
        let a: f64 = kitform.field_draw(c, wname(), x, y, w, "Name", "Your name", "", true)
        kitform.field_draw(c, wmail(), x, y + a, w, "Email", "name@example.com", "", true)
    }
}

fn wizard_press(ud: u64, step: usize, x: f64, y: f64) -> bool {
    if step == 1 { ds_settings.click(wpanel(), x, y) }
    if step == 2 {
        let c: *mut render.Ctx = ds_tpl_wizard.ctx(ds_tpl_wizard.wp(ud))
        let a: bool = kitform.field_press(c, wname(), WFX, WFY, WFW, x, y, 0 as u64)
        let b: bool = kitform.field_press(c, wmail(), WFX, WFY + kit.ln(c, 82), WFW, x, y, 0 as u64)
        if !a { kit.search_focus(wname(), false) }
        if !b { kit.search_focus(wmail(), false) }
    }
    return true
}

fn wizard_key(ud: u64, step: usize, k: u32, mods: u32) -> bool {
    if step == 2 && kit.search_has_focus(wname()) { return kit.search_key(wname(), k, mods) != editor.RES_PASS }
    if step == 2 && kit.search_has_focus(wmail()) { return kit.search_key(wmail(), k, mods) != editor.RES_PASS }
    if step == 1 { return ds_settings.key(wpanel(), k, mods) }
    return false
}

fn wizard_text(ud: u64, step: usize, cp: u32, mods: u32) -> bool {
    if step == 2 && kit.search_has_focus(wname()) { return kit.search_char(wname(), cp, mods) != editor.RES_PASS }
    if step == 2 && kit.search_has_focus(wmail()) { return kit.search_char(wmail(), cp, mods) != editor.RES_PASS }
    return false
}

fn wizard_can_next(ud: u64, step: usize) -> bool { return step != 2 || kit.search_text_len(wname()) > 0 }

fn wizard_finish(ud: u64) {
    gal_host.goto_page(HOST as *mut gal_host.Host, 0)
}

fn build_wizard() -> *mut ds_tpl_wizard.Wiz {
    WPANEL = ds_settings.panel_new() as u64
    WNAME = kitform.field_new() as u64
    WMAIL = kitform.field_new() as u64
    kit.search_set_text(wname(), "Alex")
    let w: *mut ds_tpl_wizard.Wiz = ds_tpl_wizard.new("Setup", wizard_draw, wizard_can_next, wizard_finish, 0)
    (*w).ud = w as u64
    ds_settings.set_val(wpanel(), 3, 1)
    ds_tpl_wizard.on_input(w, wizard_press, wizard_key, wizard_text)
    ds_tpl_wizard.welcome(w, lucide.SPARKLES, "Welcome", "Let's set up your device.|It only takes a minute.")
    ds_tpl_wizard.step(w, "Choose your region", "Pick language and time zone.")
    ds_tpl_wizard.step(w, "Who are you?", "We use this for your account.")
    ds_tpl_wizard.step(w, "All set", "Your device is ready to use.")
    return w
}

fn register(g: *mut gal_host.Host) {
    HOST = g as u64
    let t: *mut ds_tpl_settings.Tpl = build_settings()
    let e: *mut gal_host.Entry = gal_host.add(g, "Templates", lucide.SETTINGS, "Settings template", true, true, paint_settings, t as u64)
    (*e).press = ds_tpl_settings.press
    (*e).key = ds_tpl_settings.key
    (*e).text = ds_tpl_settings.text
    (*e).wheel = ds_tpl_settings.wheel
    (*e).pointer = ds_tpl_settings.pointer
    let w: *mut ds_tpl_wizard.Wiz = build_wizard()
    let f: *mut gal_host.Entry = gal_host.add(g, "Templates", lucide.ROCKET, "Setup wizard template", true, true, paint_wizard, w as u64)
    (*f).press = ds_tpl_wizard.press
    (*f).key = ds_tpl_wizard.key
    (*f).text = ds_tpl_wizard.text
    (*f).pointer = ds_tpl_wizard.pointer
}
