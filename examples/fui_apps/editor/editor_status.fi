// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.str
import fui.app
import fui.lay
import highlight.highlight
import editor_state

export { build, refresh, language_of, set_name }

const NO_NAME: str = "untitled"
const UTF8_CONT_MASK: u8 = 192
const UTF8_CONT: u8 = 128

fn build(a: *mut app.App) {
    let bar: usize = lay.hbox(a)
    lay.gap(a, bar, 16, 0)
    lay.pad_all(a, bar, 8)
    (*editor_state.st()).name = lay.label(a, NO_NAME, 0)
    lay.grow(a, (*editor_state.st()).name, 1000)
    (*editor_state.st()).dirty_mark = lay.label(a, " ", 0)
    (*editor_state.st()).pos = lay.label(a, "Ln 1, Col 1", 0)
    app.end(a)
}

fn base_name(path: str) -> str {
    let cut: usize = str.find_char_back(str.span(path.p, path.n), 47 as u8)
    if cut == str.npos() {
        return path
    }
    return str { p: (path.p as u64 + cut as u64 + 1) as *mut u8, n: path.n - cut - 1 }
}

fn extension_of(path: str) -> str {
    let dot: usize = str.find_char_back(str.span(path.p, path.n), 46 as u8)
    if dot == str.npos() {
        return ""
    }
    return str { p: (path.p as u64 + dot as u64 + 1) as *mut u8, n: path.n - dot - 1 }
}

fn language_of(path: str) -> str {
    let lang: u32 = highlight.hl_language(extension_of(path))
    if lang == highlight.HL_NONE {
        return "plain text"
    }
    return highlight.hl_language_name(lang)
}

fn set_name(a: *mut app.App, path: str) {
    var b: rt.Buf = rt.buf_new()
    if path.n == 0 {
        rt.buf_push_bytes(&b, NO_NAME.p as u64, NO_NAME.n)
    } else {
        let base: str = base_name(path)
        rt.buf_push_bytes(&b, base.p as u64, base.n)
    }
    rt.buf_push_bytes(&b, "  |  ".p as u64, 5)
    let lang: str = language_of(path)
    rt.buf_push_bytes(&b, lang.p as u64, lang.n)
    app.set_text(a, (*editor_state.st()).name, rt.buf_str(&b))
    rt.buf_free(&b)
}

fn column_of(text: str, caret: usize) -> usize {
    var col: usize = 1
    var i: usize = caret
    while i > 0 {
        let b: u8 = *((text.p as u64 + (i - 1) as u64) as *mut u8)
        if b == 10 as u8 {
            return col
        }
        if (b & UTF8_CONT_MASK) != UTF8_CONT {
            col = col + 1
        }
        i = i - 1
    }
    return col
}

fn line_of(text: str, caret: usize) -> usize {
    var line: usize = 1
    var i: usize = 0
    while i < caret {
        if *((text.p as u64 + i as u64) as *mut u8) == 10 as u8 {
            line = line + 1
        }
        i = i + 1
    }
    return line
}

fn show_position(a: *mut app.App, text: str, caret: usize) {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b, "Ln ".p as u64, 3)
    rt.buf_push_dec_i64(&b, line_of(text, caret) as i64)
    rt.buf_push_bytes(&b, ", Col ".p as u64, 6)
    rt.buf_push_dec_i64(&b, column_of(text, caret) as i64)
    app.set_text(a, (*editor_state.st()).pos, rt.buf_str(&b))
    rt.buf_free(&b)
}

fn refresh(a: *mut app.App) -> bool {
    let s: *mut editor_state.Ed = editor_state.st()
    let text: str = app.text(a, (*s).text)
    var caret: usize = 0
    var anchor: usize = 0
    let ok: bool = app.text_caret(a, (*s).text, &caret, &anchor)
    var changed: bool = false
    if caret != (*s).last_caret || text.n != (*s).last_len {
        (*s).last_caret = caret
        (*s).last_len = text.n
        show_position(a, text, caret)
        changed = true
    }
    if (*s).dirty != (*s).last_dirty {
        (*s).last_dirty = (*s).dirty
        if (*s).dirty {
            app.set_text(a, (*s).dirty_mark, "modified")
        } else {
            app.set_text(a, (*s).dirty_mark, " ")
        }
        changed = true
    }
    return changed
}
