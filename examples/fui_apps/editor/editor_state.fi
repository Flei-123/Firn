import std.rt
import fui.app

export { Ed, st, init, TEXT_CAP, PEND_NONE, PEND_NEW, PEND_OPEN, PEND_QUIT }

const TEXT_CAP: usize = 262144
const PEND_NONE: u32 = 0
const PEND_NEW: u32 = 1
const PEND_OPEN: u32 = 2
const PEND_QUIT: u32 = 3

struct Ed {
    text: usize,
    pos: usize,
    name: usize,
    dirty_mark: usize,
    find_bar: usize,
    find_entry: usize,
    replace_entry: usize,
    path: rt.Buf,
    dirty: bool,
    pending: u32,
    waiting: bool,
    last_caret: usize,
    last_len: usize,
    last_dirty: bool,
}

static mut G_ED: u64 = 0

fn init() {
    G_ED = rt.heap_alloc(512)
    (*st()).path = rt.buf_new()
    (*st()).pending = PEND_NONE
    (*st()).last_caret = 4294967295
    (*st()).last_len = 4294967295
}

fn st() -> *mut Ed {
    return G_ED as *mut Ed
}
