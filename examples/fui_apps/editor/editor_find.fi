import std.rt
import std.str
import fui.app
import fui.appctl
import fui.lay
import editor_state

export { build, show, hide, find_next, find_prev, replace_one, replace_all, go_to_line }

const BAR_GAP: i64 = 8
const BAR_PAD: i64 = 8

fn build(a: *mut app.App) {
    let s: *mut editor_state.Ed = editor_state.st()
    let bar: usize = lay.hbox(a)
    (*s).find_bar = bar
    lay.gap(a, bar, BAR_GAP, 0)
    lay.pad_all(a, bar, 8)
    (*s).find_entry = app.entry(a, "Find")
    (*s).replace_entry = app.entry(a, "Replace with")
    app.button(a, "Next", next_click)
    app.button(a, "Previous", prev_click)
    app.button(a, "Replace", replace_click)
    app.button(a, "Replace all", replace_all_click)
    app.button(a, "Close", close_click)
    app.end(a)
    collapse(a, bar)
}

fn collapse(a: *mut app.App, id: usize) {
    lay.hidden(a, id, true)
    lay.size(a, id, 0, 0)
    lay.pad_all(a, id, 0)
    lay.max_w(a, id, 1)
    lay.max_h(a, id, 1)
    lay.grow(a, id, 0)
}

fn reveal(a: *mut app.App, id: usize) {
    lay.hidden(a, id, false)
    lay.pad_all(a, id, BAR_PAD)
    lay.max_w(a, id, 0)
    lay.max_h(a, id, 0)
}

fn next_click(a: *mut app.App) { find_next(a) }
fn prev_click(a: *mut app.App) { find_prev(a) }
fn replace_click(a: *mut app.App) { replace_one(a) }
fn replace_all_click(a: *mut app.App) { replace_all(a) }
fn close_click(a: *mut app.App) { hide(a) }

fn show(a: *mut app.App) {
    let s: *mut editor_state.Ed = editor_state.st()
    reveal(a, (*s).find_bar)
    app.set_focus(a, (*s).find_entry)
}

fn hide(a: *mut app.App) {
    let s: *mut editor_state.Ed = editor_state.st()
    collapse(a, (*s).find_bar)
    app.set_focus(a, (*s).text)
}

fn select_range(a: *mut app.App, from: usize, to: usize) {
    let s: *mut editor_state.Ed = editor_state.st()
    app.set_text_caret(a, (*s).text, from, to)
    app.set_focus(a, (*s).text)
}

fn caret_pair(a: *mut app.App, caret: *mut usize, anchor: *mut usize) {
    let s: *mut editor_state.Ed = editor_state.st()
    let ok: bool = app.text_caret(a, (*s).text, caret, anchor)
}

fn find_next(a: *mut app.App) -> bool {
    let s: *mut editor_state.Ed = editor_state.st()
    let needle: str = app.text(a, (*s).find_entry)
    if needle.n == 0 {
        return false
    }
    let body: str = app.text(a, (*s).text)
    var caret: usize = 0
    var anchor: usize = 0
    caret_pair(a, &caret, &anchor)
    var from: usize = caret
    if anchor > from {
        from = anchor
    }
    var at: usize = str.find_ab(body, needle, from)
    if at == str.npos() {
        at = str.find_ab(body, needle, 0)
    }
    if at == str.npos() {
        return false
    }
    select_range(a, at, at + needle.n)
    return true
}

fn find_prev(a: *mut app.App) -> bool {
    let s: *mut editor_state.Ed = editor_state.st()
    let needle: str = app.text(a, (*s).find_entry)
    if needle.n == 0 {
        return false
    }
    let body: str = app.text(a, (*s).text)
    var caret: usize = 0
    var anchor: usize = 0
    caret_pair(a, &caret, &anchor)
    var upto: usize = caret
    if anchor < upto {
        upto = anchor
    }
    var at: usize = str.find_back(str { p: body.p, n: upto }, needle)
    if at == str.npos() {
        at = str.find_back(body, needle)
    }
    if at == str.npos() {
        return false
    }
    select_range(a, at, at + needle.n)
    return true
}

fn selection_is_match(a: *mut app.App, needle: str) -> bool {
    let s: *mut editor_state.Ed = editor_state.st()
    let body: str = app.text(a, (*s).text)
    var caret: usize = 0
    var anchor: usize = 0
    caret_pair(a, &caret, &anchor)
    var lo: usize = caret
    var hi: usize = anchor
    if lo > hi {
        lo = anchor
        hi = caret
    }
    if hi - lo != needle.n || needle.n == 0 {
        return false
    }
    return rt.mem_eq((body.p as u64 + lo as u64), needle.p as u64, needle.n)
}

fn replace_one(a: *mut app.App) {
    let s: *mut editor_state.Ed = editor_state.st()
    let needle: str = app.text(a, (*s).find_entry)
    if !selection_is_match(a, needle) {
        find_next(a)
        return
    }
    let body: str = app.text(a, (*s).text)
    let with: str = app.text(a, (*s).replace_entry)
    var caret: usize = 0
    var anchor: usize = 0
    caret_pair(a, &caret, &anchor)
    var lo: usize = caret
    if anchor < lo {
        lo = anchor
    }
    var out: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&out, body.p as u64, lo)
    rt.buf_push_bytes(&out, with.p as u64, with.n)
    rt.buf_push_bytes(&out, body.p as u64 + (lo + needle.n) as u64, body.n - lo - needle.n)
    app.set_text(a, (*s).text, rt.buf_str(&out))
    rt.buf_free(&out)
    (*s).dirty = true
    select_range(a, lo + with.n, lo + with.n)
    find_next(a)
}

fn replace_all(a: *mut app.App) {
    let s: *mut editor_state.Ed = editor_state.st()
    let needle: str = app.text(a, (*s).find_entry)
    if needle.n == 0 {
        return
    }
    let body: str = app.text(a, (*s).text)
    let with: str = app.text(a, (*s).replace_entry)
    var out: rt.Buf = rt.buf_new()
    var from: usize = 0
    var count: usize = 0
    while true {
        let at: usize = str.find_ab(body, needle, from)
        if at == str.npos() {
            break
        }
        rt.buf_push_bytes(&out, body.p as u64 + from as u64, at - from)
        rt.buf_push_bytes(&out, with.p as u64, with.n)
        from = at + needle.n
        count = count + 1
    }
    rt.buf_push_bytes(&out, body.p as u64 + from as u64, body.n - from)
    if count > 0 && rt.buf_len(&out) < editor_state.TEXT_CAP {
        app.set_text(a, (*s).text, rt.buf_str(&out))
        (*s).dirty = true
    }
    rt.buf_free(&out)
}

fn offset_of_line(body: str, line: usize) -> usize {
    var at: usize = 0
    var n: usize = 1
    while n < line && at < body.n {
        if *((body.p as u64 + at as u64) as *mut u8) == 10 as u8 {
            n = n + 1
        }
        at = at + 1
    }
    return at
}

fn go_to_line(a: *mut app.App, line: usize) {
    let s: *mut editor_state.Ed = editor_state.st()
    let at: usize = offset_of_line(app.text(a, (*s).text), line)
    select_range(a, at, at)
}
