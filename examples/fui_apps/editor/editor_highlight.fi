import std.rt
import std.vec
import highlight.highlight
import fui.app
import fui.render
import fui.style
import fui.syntaxcolor
import fui.textarea
import fui.theme
import editor_state

export { install, set_language }

const MAX_BYTES: usize = 65536
const OPAQUE_MASK: u32 = 16777215

struct Hl {
    spans: Vec[highlight.HlSpan],
    marker: highlight.Highlighter,
    lang: u32,
    rev: u64,
    len: usize,
    fresh: bool,
}

static mut G_HL: u64 = 0

fn hl() -> *mut Hl {
    return G_HL as *mut Hl
}

fn set_language(lang: u32) {
    (*hl()).lang = lang
    (*hl()).fresh = false
}

fn retokenize(p: u64, n: usize, rev: u64) {
    let h: *mut Hl = hl()
    vec_clear[highlight.HlSpan](&(*h).spans)
    if (*h).lang != highlight.HL_NONE && n > 0 && n <= MAX_BYTES {
        let ok: bool = highlight.hl_tokenize(&(*h).marker, (*h).lang, p, n, &(*h).spans)
    }
    (*h).rev = rev
    (*h).len = n
    (*h).fresh = true
}

fn span_index(pos: usize) -> usize {
    let spans: *mut Vec[highlight.HlSpan] = &(*hl()).spans
    var lo: usize = 0
    var hi: usize = vec_len[highlight.HlSpan](spans)
    while lo + 1 < hi {
        let mid: usize = (lo + hi) / 2
        if (*vec_elem_ptr[highlight.HlSpan](spans, mid)).start <= pos {
            lo = mid
        } else {
            hi = mid
        }
    }
    return lo
}

fn tint(ctx: u64, rc: u64, p: u64, n: usize, rev: u64, pos: usize, end: *mut usize) -> u32 {
    let h: *mut Hl = hl()
    if !(*h).fresh || (*h).rev != rev || (*h).len != n {
        retokenize(p, n, rev)
    }
    let count: usize = vec_len[highlight.HlSpan](&(*h).spans)
    if count == 0 {
        *end = n
        return 0 as u32
    }
    let s: *mut highlight.HlSpan = vec_elem_ptr[highlight.HlSpan](&(*h).spans, span_index(pos))
    *end = (*s).start + (*s).len
    if (*s).kind == highlight.TK_PLAIN {
        return 0 as u32
    }
    let c: *mut render.Ctx = rc as *mut render.Ctx
    let ground: u32 = render.color_of(c, style.color_token(style.TOK_SURFACE)) & OPAQUE_MASK
    return theme.opaque(syntaxcolor.syntax_color(render.ctx_theme(c), (*s).kind, ground))
}

fn install(a: *mut app.App) {
    G_HL = rt.heap_alloc(256)
    (*hl()).spans = vec_new[highlight.HlSpan]()
    (*hl()).marker = highlight.hl_new()
    (*hl()).lang = highlight.HL_NONE
    textarea.ta_set_tint(app.lines_of(a, (*editor_state.st()).text), 0, tint)
}
