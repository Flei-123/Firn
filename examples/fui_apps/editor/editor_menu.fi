import fui.app
import fui.action
import fui.appctl
import fui.editor
import fui.lay
import editor_state
import editor_files
import editor_find

export { build }

const KEY_N: u32 = 78
const KEY_O: u32 = 79
const KEY_S: u32 = 83
const KEY_Q: u32 = 81
const KEY_F: u32 = 70
const KEY_G: u32 = 71
const KEY_Z: u32 = 90
const KEY_Y: u32 = 89
const KEY_X: u32 = 88
const KEY_C: u32 = 67
const KEY_V: u32 = 86
const KEY_A: u32 = 65
const CH_Z: u32 = 122
const CH_Y: u32 = 121
const CH_X: u32 = 120
const CH_C: u32 = 99
const CH_V: u32 = 118
const CH_A: u32 = 97
const TOOLBAR_GAP: i64 = 6

fn edit_op(a: *mut app.App, ch: u32) {
    app.set_focus(a, (*editor_state.st()).text)
    let used: bool = app.app_char(a as u64, ch, editor.MOD_CTRL)
}

fn do_undo(a: *mut app.App) { edit_op(a, CH_Z) }
fn do_redo(a: *mut app.App) { edit_op(a, CH_Y) }
fn do_cut(a: *mut app.App) { edit_op(a, CH_X) }
fn do_copy(a: *mut app.App) { edit_op(a, CH_C) }
fn do_paste(a: *mut app.App) { edit_op(a, CH_V) }
fn do_select_all(a: *mut app.App) { edit_op(a, CH_A) }
fn do_find(a: *mut app.App) { editor_find.show(a) }
fn do_quit(a: *mut app.App) { editor_files.answer_discard(a, editor_state.PEND_QUIT) }

fn goto_answer(a: *mut app.App, ans: u32) {
    if ans != appctl.ANS_OK {
        return
    }
    let t: str = appctl.dialog_text(a)
    var n: usize = 0
    var i: usize = 0
    while i < t.n {
        let d: u8 = *((t.p as u64 + i as u64) as *mut u8)
        if d >= 48 as u8 && d <= 57 as u8 && n < 100000000 {
            n = n * 10 + (d - 48 as u8) as usize
        }
        i = i + 1
    }
    editor_find.go_to_line(a, n)
}

fn do_goto(a: *mut app.App) {
    let ok: bool = appctl.input(a, "Go to line", "Line number", "1", goto_answer)
}

fn on_new(a: *mut app.App, act: usize) { editor_files.request_new(a) }
fn on_open(a: *mut app.App, act: usize) { editor_files.request_open(a) }
fn on_save(a: *mut app.App, act: usize) { editor_files.request_save(a) }
fn on_save_as(a: *mut app.App, act: usize) { editor_files.request_save_as(a) }
fn on_quit(a: *mut app.App, act: usize) { do_quit(a) }
fn on_undo(a: *mut app.App, act: usize) { do_undo(a) }
fn on_redo(a: *mut app.App, act: usize) { do_redo(a) }
fn on_cut(a: *mut app.App, act: usize) { do_cut(a) }
fn on_copy(a: *mut app.App, act: usize) { do_copy(a) }
fn on_paste(a: *mut app.App, act: usize) { do_paste(a) }
fn on_select_all(a: *mut app.App, act: usize) { do_select_all(a) }
fn on_find(a: *mut app.App, act: usize) { do_find(a) }
fn on_goto(a: *mut app.App, act: usize) { do_goto(a) }

fn item(a: *mut app.App, m: usize, id: str, label: str, key: u32, mods: u32, f: fn(*mut app.App, usize)) {
    let act: usize = appctl.menu_item(a, m, id, label, f)
    if key != 0 as u32 {
        appctl.menu_shortcut(a, act, key, mods)
    }
}

fn file_menu(a: *mut app.App) {
    let m: usize = appctl.menu(a, "&File")
    item(a, m, "file.new", "&New", KEY_N, action.MOD_CTRL, on_new)
    item(a, m, "file.open", "&Open...", KEY_O, action.MOD_CTRL, on_open)
    item(a, m, "file.save", "&Save", KEY_S, action.MOD_CTRL, on_save)
    item(a, m, "file.save_as", "Save &as...", KEY_S, action.MOD_CTRL | action.MOD_SHIFT, on_save_as)
    let sep: bool = appctl.menu_sep(a, m)
    item(a, m, "file.quit", "&Quit", KEY_Q, action.MOD_CTRL, on_quit)
}

fn edit_menu(a: *mut app.App) {
    let m: usize = appctl.menu(a, "&Edit")
    item(a, m, "edit.undo", "&Undo", 0 as u32, 0 as u32, on_undo)
    item(a, m, "edit.redo", "&Redo", 0 as u32, 0 as u32, on_redo)
    let sep: bool = appctl.menu_sep(a, m)
    item(a, m, "edit.cut", "Cu&t", 0 as u32, 0 as u32, on_cut)
    item(a, m, "edit.copy", "&Copy", 0 as u32, 0 as u32, on_copy)
    item(a, m, "edit.paste", "&Paste", 0 as u32, 0 as u32, on_paste)
    item(a, m, "edit.select_all", "Select &all", 0 as u32, 0 as u32, on_select_all)
    let sep2: bool = appctl.menu_sep(a, m)
    item(a, m, "edit.find", "&Find...", KEY_F, action.MOD_CTRL, on_find)
    item(a, m, "edit.goto", "&Go to line...", KEY_G, action.MOD_CTRL, on_goto)
}

fn toolbar(a: *mut app.App) {
    let bar: usize = lay.hbox(a)
    lay.gap(a, bar, TOOLBAR_GAP, 0)
    lay.pad_all(a, bar, 6)
    app.button(a, "New", editor_files.request_new)
    app.button(a, "Open", editor_files.request_open)
    app.button(a, "Save", editor_files.request_save)
    app.button(a, "Undo", do_undo)
    app.button(a, "Redo", do_redo)
    app.button(a, "Find", do_find)
    app.end(a)
}

fn build(a: *mut app.App) {
    let bar: usize = appctl.menubar(a)
    lay.justify(a, bar, lay.JU_START)
    file_menu(a)
    edit_menu(a)
    appctl.menubar_end(a)
    toolbar(a)
}
