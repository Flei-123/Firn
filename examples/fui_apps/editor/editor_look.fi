import fui.app
import fui.face
import fui.skin
import fui.style
import fui.textarea
import editor_state

export { apply }

const CLASS_MONO: u32 = 9201
const MONO_PX: usize = 13

fn apply(a: *mut app.App) {
    app.use_mono_face(a)
    let text: usize = (*editor_state.st()).text
    skin.rule(a, CLASS_MONO, style.style_set_font(style.style_new(), face.MONO_SLOT, MONO_PX))
    skin.add(a, text, CLASS_MONO)
    textarea.ta_set_gutter(app.lines_of(a, text), true)
}
