import std.rt
import fui.app
import fui.appctl
import fui.appshot
import fui.lay
import fui.skin
import editor_state
import editor_menu
import editor_find
import editor_status
import editor_files
import editor_highlight

export { build, tick, WINDOW_W, WINDOW_H }

const SAMPLE: str = "editor_sample.fi"
const WINDOW_W: usize = 1100
const WINDOW_H: usize = 700
const POLL_MS: i64 = 100

fn on_edit(a: *mut app.App, id: usize) {
    if id == (*editor_state.st()).text {
        editor_files.set_dirty(true)
    }
}

fn tick(ud: u64, now: i64) -> bool {
    let a: *mut app.App = ud as *mut app.App
    let polled: bool = editor_files.poll(a)
    let shown: bool = editor_status.refresh(a)
    return polled || shown
}

fn wait(ud: u64, now: i64) -> i64 {
    return POLL_MS
}

fn load_sample(a: *mut app.App, start: u64) {
    var body: rt.Buf = rt.buf_new()
    if appshot.load_data(start, SAMPLE, &body) {
        editor_files.load_text(a, SAMPLE, rt.buf_ptr(&body), rt.buf_len(&body))
    }
    rt.buf_free(&body)
}

fn build(start: u64) -> *mut app.App {
    editor_state.init()
    let a: *mut app.App = app.window("Editor", WINDOW_W, WINDOW_H)
    skin.install(a)
    app.set_data(a, 0)
    lay.page(a)
    let page: usize = lay.vbox(a)
    lay.grow(a, page, 1000)
    editor_menu.build(a)
    editor_find.build(a)
    let text: usize = app.textarea_big(a, "Document", 24, editor_state.TEXT_CAP)
    (*editor_state.st()).text = text
    lay.grow(a, text, 1000)
    lay.fill_w(a, text)
    editor_status.build(a)
    app.end(a)
    editor_highlight.install(a)
    app.std_edit(a)
    app.on_edit(a, on_edit)
    app.set_extra_wake(a, a as u64, tick, wait)
    load_sample(a, start)
    let shown: bool = editor_status.refresh(a)
    return a
}
