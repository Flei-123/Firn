// SPDX-License-Identifier: MPL-2.0
// examples/fui_apps/notes/main.fi -- Markdown notes: note list, text editor, live preview.
//   notes [--theme light|dark] [--shot out.png]
// The editor + preview is lib/fui/mdedit.fi; this file only lays out the three columns and the list.
import std.rt
import fui.kit
import fui.kitapp
import fui.kitback
import fui.kittabs
import fui.preset
import fui.kitdata
import fui.mdedit
import fui.painter
import fui.render
import fui.screen
import fui.screenext
import fui.kitscroll
import fui.screenanim
import fui.style

static mut ME: u64 = 0
static mut DOC: u64 = 0
static mut SEL: usize = 0
static mut CTX: u64 = 0
static mut NOW: u64 = 0
static mut CW: f64 = 1100.0
static mut DETAIL: bool = false
static mut PREVIEW: usize = 0
static mut LS: kitscroll.Scroll = kitscroll.Scroll { pos: 0.0, max: 0.0, step: 48.0 }

const TABS: str = "Edit|Preview"

fn me() -> *mut mdedit.MdEd { return ME as *mut mdedit.MdEd }
fn notes() -> u32 { return kitdata.get(DOC as *mut kitdata.Doc, kitdata.root(DOC as *mut kitdata.Doc), "notes") }
fn field(i: usize, k: str) -> str { return kitdata.text(DOC as *mut kitdata.Doc, kitdata.get(DOC as *mut kitdata.Doc, kitdata.at(DOC as *mut kitdata.Doc, notes(), i), k)) }

fn list_draw(c: *mut render.Ctx, sw: f64, h: f64, px: f64, py: f64) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    painter.surface(z, 0.0, 0.0, sw, h, kit.tokc(c, style.TOK_SURFACE))
    painter.surface(z, sw - kit.ln(c, 1), 0.0, kit.ln(c, 1), h, kit.tokc(c, style.TOK_SEPARATOR))
    kitscroll.scroll_fit(&LS, kit.ln(c, 65) + kit.ln(c, 52) * (kitdata.count(DOC as *mut kitdata.Doc, notes()) as f64), h, kit.ln(c, 48))
    var i: usize = 0
    while i < kitdata.count(DOC as *mut kitdata.Doc, notes()) {
        let y: f64 = kit.ln(c, 55) + kit.ln(c, 52) * (i as f64) - LS.pos
        let x: f64 = kit.ln(c, 10)
        let ht: f64 = screenanim.hover(c, x, y, px >= x && px < sw - x && py >= y && py < y + kit.ln(c, 52))
        if i == SEL {
            painter.round_rect(z, x, y, sw - 2.0 * x, kit.ln(c, 52), kit.ln(c, 9), kit.tokc(c, style.TOK_BUTTON))
        } else if ht > 0.0 {
            painter.round_rect(z, x, y, sw - 2.0 * x, kit.ln(c, 52), kit.ln(c, 9), kit.with_alpha(kit.tokc(c, style.TOK_BUTTON), (ht * 255.0) as u32))
        }
        var tok: u32 = style.TOK_TEXT_MUTED
        if i == SEL {
            tok = style.TOK_TEXT
            painter.surface(z, x, y + kit.ln(c, 4), kit.ln(c, 3), kit.ln(c, 44), kit.tokc(c, style.TOK_ACCENT))
        }
        kitapp.text(c, x + kit.ln(c, 12), y + kit.ln(c, 8), kit.ln(c, 22), 14, 400, tok, field(i, "title"))
        kitapp.text(c, x + kit.ln(c, 12), y + kit.ln(c, 30), kit.ln(c, 16), 11, 400, style.TOK_TEXT_DISABLED, str { p: field(i, "modified").p, n: 10 })
        i = i + 1
    }
    if LS.pos > 0.0 { painter.surface(z, 0.0, 0.0, sw - kit.ln(c, 1), kit.ln(c, 55), kit.tokc(c, style.TOK_SURFACE)) }
    kitapp.text(c, kit.ln(c, 20), kit.ln(c, 18), kit.ln(c, 26), 18, 700, style.TOK_TEXT, "Notes")
}

fn paint(ud: u64, c: *mut render.Ctx, w: f64, h: f64, px: f64, py: f64) {
    CTX = c as u64
    CW = w
    let z: *mut painter.Painter = render.ctx_painter(c)
    if kittabs.compact(c, w) {
        paint_compact(c, w, h, px, py)
        return
    }
    let sw: f64 = kit.ln(c, 230)
    let cw: f64 = (w - sw) / 2.0
    list_draw(c, sw, h, px, py)
    mdedit.editor_draw(c, me(), sw, 0.0, cw, h)
    painter.surface(z, sw + cw - kit.ln(c, 1), 0.0, kit.ln(c, 1), h, kit.tokc(c, style.TOK_SEPARATOR))
    mdedit.preview_draw(c, me(), sw + cw, 0.0, w - sw - cw, h)
    screenanim.veil(c, sw, 0.0, w - sw, h, screenanim.page(c, SEL as i64))
}

fn paint_compact(c: *mut render.Ctx, w: f64, h: f64, px: f64, py: f64) {
    if !DETAIL {
        list_draw(c, w, h, px, py)
        return
    }
    let bh: f64 = kitback.bar_height(c)
    let top: f64 = bh + kittabs.tabs_height(c)
    painter.surface(render.ctx_painter(c), 0.0, 0.0, w, h, kit.tokc(c, style.TOK_BASE))
    if PREVIEW == 0 {
        mdedit.editor_draw(c, me(), 0.0, top, w, h - top)
    } else {
        mdedit.preview_draw(c, me(), 0.0, top, w, h - top)
    }
    kitback.bar_draw(c, "Notes", kitback.bar_hit(c, 0.0, 0.0, px, py), 0.0, 0.0, w)
    kittabs.tabs_draw(c, TABS, 0, PREVIEW, kittabs.tabs_hit(c, TABS, 0, 0.0, bh, w, px, py), 0.0, bh, w)
    screenanim.veil(c, 0.0, top, w, h - top, screenanim.page(c, SEL as i64 * 2 + PREVIEW as i64))
}

fn leave_detail(c: *mut render.Ctx) {
    DETAIL = false
    mdedit.press(c, me(), 0.0 - 1.0, 0.0 - 1.0, NOW)
}

fn back_wanted(ud: u64) -> bool { return DETAIL && kittabs.compact(CTX as *mut render.Ctx, CW) }
fn back_go(ud: u64) { leave_detail(CTX as *mut render.Ctx) }

fn press_compact(c: *mut render.Ctx, x: f64, y: f64) {
    let bh: f64 = kitback.bar_height(c)
    if !DETAIL {
        let i: usize = ((y - kit.ln(c, 55) + LS.pos) / kit.ln(c, 52)) as usize
        if y >= kit.ln(c, 55) && i < kitdata.count(DOC as *mut kitdata.Doc, notes()) {
            SEL = i
            mdedit.open(me(), i)
            DETAIL = true
            PREVIEW = 0
        }
        return
    }
    if kitback.bar_hit(c, 0.0, 0.0, x, y) {
        leave_detail(c)
        return
    }
    let t: usize = kittabs.tabs_hit(c, TABS, 0, 0.0, bh, CW, x, y)
    if t != kit.NONE {
        PREVIEW = t
        if t != 0 { mdedit.press(c, me(), 0.0 - 1.0, 0.0 - 1.0, NOW) }
        return
    }
    if PREVIEW == 0 { mdedit.press(c, me(), x, y, NOW) }
}

fn press(ud: u64, x: f64, y: f64) {
    let c: *mut render.Ctx = CTX as *mut render.Ctx
    NOW = NOW + 1000000
    if kittabs.compact(c, CW) {
        press_compact(c, x, y)
        return
    }
    let i: usize = ((y - kit.ln(c, 55) + LS.pos) / kit.ln(c, 52)) as usize
    if x < kit.ln(c, 230) && y >= kit.ln(c, 55) && i < kitdata.count(DOC as *mut kitdata.Doc, notes()) {
        SEL = i
        mdedit.open(me(), i)
    }
    mdedit.press(c, me(), x, y, NOW)
}

fn region(x: f64) -> usize {
    let c: *mut render.Ctx = CTX as *mut render.Ctx
    if kittabs.compact(c, CW) {
        if !DETAIL { return 0 }
        return 1 + PREVIEW
    }
    let sw: f64 = kit.ln(c, 230)
    if x < sw { return 0 }
    if x < sw + (CW - sw) / 2.0 { return 1 }
    return 2
}

fn wheel(ud: u64, px: f64, py: f64, dx: f64, dy: f64) -> bool {
    let r: usize = region(px)
    if r == 0 { return kitscroll.scroll_by(&LS, dy) }
    if r == 1 { mdedit.wheel_editor(me(), dy) } else { mdedit.wheel_preview(me(), dy) }
    return true
}

fn pan(ud: u64, x: f64, y: f64, dy: f64) -> bool {
    let r: usize = region(x)
    if r == 0 { return kitscroll.scroll_pan(&LS, dy) }
    if r == 1 { mdedit.pan_editor(me(), dy) } else { mdedit.pan_preview(me(), dy) }
    return true
}

fn key(ud: u64, k: u32, mods: u32) -> bool { return mdedit.key(me(), k, mods) }
fn text(ud: u64, cp: u32, mods: u32) -> bool { return mdedit.char(me(), cp, mods) }

fn main(start: u64) -> i32 {
    DOC = kitdata.load("notes_list.json") as u64
    ME = mdedit.new() as u64
    var i: usize = 0
    while i < kitdata.count(DOC as *mut kitdata.Doc, notes()) {
        if field(i, "file").n > 0 { mdedit.load(me(), i, "notes.md") } else { mdedit.put(me(), i, "# ", field(i, "title"), "\n\nEmpty note.") }
        i = i + 1
    }
    mdedit.open(me(), 0)
    if screen.has_arg(start, "--open") != 0 { DETAIL = true }
    if screen.has_arg(start, "--preview") != 0 { DETAIL = true; PREVIEW = 1 }
    let ex: screenext.Extras = screenext.extras_back(screenext.extras_pan(screenext.extras_blank(), pan), back_wanted, back_go)
    return screen.run_ext(start, "Notes", 1100, 700, 0, paint, press, key, text, wheel, screen.no_pointer, ex, preset.studio)
}
