import std.rt
import fui.appshot
import fui.termwstate
import term.pty
import term.termloop
import term.termpty
import term_sample

export { open_backend }

const DEFAULT_SHELL: str = "/bin/sh\0"

fn shell_blob(start: u64, out: *mut rt.Buf) -> str {
    let arg: u64 = appshot.opt_value(start, "--shell")
    if arg == 0 as u64 { return DEFAULT_SHELL }
    rt.buf_push_bytes(out, arg, rt.c_length(arg))
    rt.buf_push(out, 0 as u8)
    return rt.buf_str(out)
}

fn scripted_wanted(start: u64) -> bool {
    return appshot.has_flag(start, "--script") || appshot.opt_value(start, "--shot") != 0 as u64 || !pty.pty_supported()
}

fn open_scripted(tw: *mut termwstate.TermWidget) -> bool {
    let l: *mut termloop.Loop = termloop.loop_new(true)
    termloop.loop_push(l, term_sample.SESSION)
    termwstate.tw_set_backend(tw, termloop.loop_backend(l))
    return true
}

fn open_pty(tw: *mut termwstate.TermWidget, start: u64, cols: usize, rows: usize) -> bool {
    var blob: rt.Buf = rt.buf_new()
    let link: *mut termpty.PtyLink = termpty.ptylink_open(shell_blob(start, &blob), cols, rows)
    rt.buf_free(&blob)
    if link == 0 as *mut termpty.PtyLink { return false }
    termwstate.tw_set_backend(tw, termpty.ptylink_backend(link))
    return true
}

fn open_backend(tw: *mut termwstate.TermWidget, start: u64, cols: usize, rows: usize) -> bool {
    if scripted_wanted(start) { return open_scripted(tw) }
    return open_pty(tw, start, cols, rows)
}
