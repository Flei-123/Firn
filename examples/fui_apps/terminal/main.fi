import fui.app
import fui.appshot
import fui.termwidget
import fui.termwstate
import term_backend

const WINDOW_W: usize = 900
const WINDOW_H: usize = 560
const VIEW_W: usize = 892
const VIEW_H: usize = 550
const START_COLS: usize = 80
const START_ROWS: usize = 24
const SCROLLBACK: usize = 2000
const EXIT_NO_BACKEND: i32 = 2

fn main(start: u64) -> i32 {
    let a: *mut app.App = app.window("Terminal", WINDOW_W, WINDOW_H)
    let tw: *mut termwstate.TermWidget = termwstate.tw_new(START_COLS, START_ROWS, SCROLLBACK)
    if !term_backend.open_backend(tw, start, START_COLS, START_ROWS) { return EXIT_NO_BACKEND }
    app.set_root_pad(a, 4)
    termwidget.tw_attach(a, tw, VIEW_W, VIEW_H)
    return appshot.finish(a, start, WINDOW_W, WINDOW_H)
}
