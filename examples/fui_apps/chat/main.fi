// examples/fui_apps/chat/main.fi -- messenger (contacts, search, bubbles, date separators, autoscroll, input).
//   chat [--theme light|dark] [--shot out.png]
// The messenger itself is lib/fui/kitchat.fi; this file only loads data/chat.json into it.
import fui.kitchat
import fui.preset
import fui.kitdata
import fui.screen

fn main(start: u64) -> i32 {
    let d: *mut kitdata.Doc = kitdata.load("chat.json")
    let z: *mut kitchat.Chat = kitchat.chat_new()
    let cl: u32 = kitdata.get(d, kitdata.root(d), "contacts")
    var i: usize = 0
    while i < kitdata.count(d, cl) {
        let n: u32 = kitdata.at(d, cl, i)
        kitchat.add_contact(z, kitdata.text(d, kitdata.get(d, n, "name")), kitdata.text(d, kitdata.get(d, n, "initials")),
            kitchat.hex_color(kitdata.text(d, kitdata.get(d, n, "color"))), kitdata.num(d, kitdata.get(d, n, "unread")) as u32)
        i = i + 1
    }
    let ml: u32 = kitdata.get(d, kitdata.root(d), "messages")
    i = 0
    while i < kitdata.count(d, ml) {
        let n: u32 = kitdata.at(d, ml, i)
        kitchat.add_msg(z, (kitdata.num(d, kitdata.get(d, n, "contact")) - 1) as usize, kitdata.flag(d, kitdata.get(d, n, "from_me")),
            kitdata.text(d, kitdata.get(d, n, "text")), kitdata.text(d, kitdata.get(d, n, "ts")))
        i = i + 1
    }
    kitchat.select(z, (kitdata.num(d, kitdata.get(d, kitdata.root(d), "selected")) - 1) as usize)
    kitchat.list_scroll_arg(z, start)
    if screen.has_arg(start, "--open") != 0 { kitchat.show_detail(z, true) }
    return screen.run_wheel(start, "Chat", 1100, 700, z as u64, kitchat.chat_paint, kitchat.chat_press, kitchat.chat_key,
        kitchat.chat_text, kitchat.chat_wheel, preset.messenger)
}
