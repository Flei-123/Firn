import std.rt

const GREETING: str = "hello, editor"

fn square(n: i64) -> i64 {
    return n * n
}

fn main() -> i32 {
    var total: i64 = 0
    var i: i64 = 1
    while i <= 10 {
        total = total + square(i)
        i = i + 1
    }
    rt.write_everything(1, GREETING.p as u64, GREETING.n)
    return 0
}
