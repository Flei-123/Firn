// SPDX-License-Identifier: MPL-2.0
// examples/fui_apps/dash/main.fi -- Dashboard: 4 KPI cards, line / bar / donut charts, event table, range switch.
// Data: data/metrics.json.   dash [--theme light|dark] [--shot out.png]
import fui.kit
import fui.kitapp
import fui.kitchart
import fui.kitcolor
import fui.kitdata
import fui.painter
import fui.render
import fui.screen
import fui.style
import fui.theme
import std.math

static mut DOC: u64 = 0
static mut RANGE: usize = 2
static mut SEG_X: f64 = 0.0
static mut SEG_Y: f64 = 0.0
static mut SEG_W: f64 = 0.0
static mut SEG_H: f64 = 0.0

fn doc() -> *mut kitdata.Doc { return DOC as *mut kitdata.Doc }

// --- tiny string builder over a stack buffer ---------------------------------------------------
fn put(b: *mut [u8; 96], n: usize, s: str) -> usize {
    var k: usize = n
    var i: usize = 0
    while i < s.n && k < 96 {
        (*b)[k] = *((s.p as u64 + i as u64) as *mut u8)
        k = k + 1
        i = i + 1
    }
    return k
}

fn put_uint(b: *mut [u8; 96], n: usize, v: u64, sep: bool) -> usize {
    var d: [u8; 24] = [0 as u8; 24]
    let m: usize = kit.fmt_uint(v, &d)
    var k: usize = n
    var i: usize = 0
    while i < m && k < 96 {
        if sep && i > 0 && (m - i) % 3 == 0 {
            (*b)[k] = 44 as u8
            k = k + 1
        }
        (*b)[k] = d[i]
        k = k + 1
        i = i + 1
    }
    return k
}

// v with one decimal ("3.8"), v >= 0
fn put_dec(b: *mut [u8; 96], n: usize, v: f64) -> usize {
    let tenths: u64 = (v * 10.0 + 0.5) as u64
    var k: usize = put_uint(b, n, tenths / 10, false)
    (*b)[k] = 46 as u8
    k = k + 1
    return put_uint(b, k, tenths % 10, false)
}

fn sub(b: *mut [u8; 96], n: usize) -> str { return str { p: (&(*b)[0]) as *mut u8, n: n } }

fn range_text(i: usize) -> str {
    let rs: u32 = kitdata.get(doc(), kitdata.root(doc()), "ranges")
    return kitdata.text(doc(), kitdata.at(doc(), rs, i))
}

fn range_days(i: usize) -> usize {
    if i == 0 { return 7 }
    if i == 1 { return 30 }
    return 90
}

fn dark(c: *mut render.Ctx) -> bool { return theme.theme_is_dark(render.ctx_theme(c)) }

fn series(c: *mut render.Ctx, i: usize) -> u32 {
    return series_rgb(c, i) | (4278190080 as u32)
}

fn series_rgb(c: *mut render.Ctx, i: usize) -> u32 {
    if dark(c) {
        if i == 0 { return 0x6c8cff as u32 }
        if i == 1 { return 0x3ddc84 as u32 }
        if i == 2 { return 0xffb14c as u32 }
        return 0xff6b8a as u32
    }
    if i == 0 { return 0x4a6ef0 as u32 }
    if i == 1 { return 0x16b765 as u32 }
    if i == 2 { return 0xf0961c as u32 }
    return 0xe8486a as u32
}

fn t(c: *mut render.Ctx, x: f64, y: f64, h: f64, size: usize, weight: usize, tok: u32, s: str) -> f64 {
    return kitapp.text(c, x, y, h, size, weight, tok, s)
}

#[allow_escape]
fn header(c: *mut render.Ctx, w: f64) {
    let x0: f64 = kit.ln(c, 28)
    let y0: f64 = kit.ln(c, 22)
    t(c, x0, y0, kit.ln(c, 30), 22, 700, style.TOK_TEXT, "Dashboard")
    var b: [u8; 96] = [0 as u8; 96]
    var n: usize = put(&b, 0, "Overview of the last ")
    n = put(&b, n, range_text(RANGE))
    t(c, x0, y0 + kit.ln(c, 30), kit.ln(c, 18), 13, 400, style.TOK_TEXT_MUTED, sub(&b, n))
    let bw: f64 = kit.ln(c, 56)
    let tot: f64 = bw * 3.0 + kit.ln(c, 6)
    SEG_W = tot
    SEG_H = kit.ln(c, 38)
    SEG_X = w - kit.ln(c, 28) - tot
    SEG_Y = y0 + kit.ln(c, 2)
    let z: *mut painter.Painter = render.ctx_painter(c)
    painter.round_rect(z, SEG_X, SEG_Y, SEG_W, SEG_H, kit.ln(c, 10), kit.tokc(c, style.TOK_BORDER))
    painter.round_rect(z, SEG_X + 1.0, SEG_Y + 1.0, SEG_W - 2.0, SEG_H - 2.0, kit.ln(c, 10), kit.tokc(c, style.TOK_SURFACE))
    var i: usize = 0
    while i < 3 {
        let bx: f64 = SEG_X + kit.ln(c, 3) + (i as f64) * bw
        var tok: u32 = style.TOK_TEXT_MUTED
        if i == RANGE {
            painter.round_rect(z, bx, SEG_Y + kit.ln(c, 3), bw, SEG_H - kit.ln(c, 6), kit.ln(c, 7), kit.accent_gfx(c, style.TOK_SURFACE))
            tok = style.TOK_TEXT_ON_ACCENT
        }
        let tw: f64 = kit.text_width(c, kit.ln(c, 13), 600, range_text(i))
        t(c, bx + (bw - tw) / 2.0, SEG_Y + kit.ln(c, 3), SEG_H - kit.ln(c, 6), 13, 600, tok, range_text(i))
        i = i + 1
    }
}

#[allow_escape]
fn kpis(c: *mut render.Ctx, y: f64, w: f64, h: f64) {
    let gap: f64 = kit.ln(c, 14)
    let cw: f64 = (w - gap * 3.0) / 4.0
    let list: u32 = kitdata.get(doc(), kitdata.root(doc()), "kpis")
    var i: usize = 0
    while i < 4 {
        let k: u32 = kitdata.at(doc(), list, i)
        let x: f64 = kit.ln(c, 28) + (cw + gap) * (i as f64)
        kitapp.card_draw(c, x, y, cw, h, false)
        let px: f64 = x + kit.ln(c, 18)
        t(c, px, y + kit.ln(c, 14), kit.ln(c, 16), 11, 600, style.TOK_TEXT_DISABLED, kitdata.text(doc(), kitdata.get(doc(), k, "name")))
        let v: f64 = kitdata.float(doc(), kitdata.get(doc(), k, "value"))
        let unit: str = kitdata.text(doc(), kitdata.get(doc(), k, "unit"))
        var b: [u8; 96] = [0 as u8; 96]
        var n: usize = 0
        if unit.n == 3 { n = put(&b, 0, "EUR ") }
        if unit.n == 1 {
            n = put_dec(&b, 0, v)
            n = put(&b, n, "%")
        } else {
            n = put_uint(&b, n, v as u64, true)
        }
        t(c, px, y + kit.ln(c, 30), kit.ln(c, 34), 26, 700, style.TOK_TEXT, sub(&b, n))
        let dl: f64 = kitdata.float(doc(), kitdata.get(doc(), k, "delta_pct"))
        var tok: u32 = style.TOK_SUCCESS
        var b2: [u8; 96] = [0 as u8; 96]
        var n2: usize = put(&b2, 0, "+")
        var av: f64 = dl
        if dl < 0.0 {
            tok = style.TOK_ERROR
            n2 = put(&b2, 0, "-")
            av = 0.0 - dl
        }
        n2 = put_dec(&b2, n2, av)
        n2 = put(&b2, n2, "%")
        t(c, px, y + kit.ln(c, 64), kit.ln(c, 18), 13, 600, tok, sub(&b2, n2))
        i = i + 1
    }
}

fn card_title(c: *mut render.Ctx, x: f64, y: f64, s: str) {
    t(c, x + kit.ln(c, 18), y + kit.ln(c, 14), kit.ln(c, 20), 14, 600, style.TOK_TEXT, s)
}

fn line_chart(c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64) {
    kitapp.card_draw(c, x, y, w, h, false)
    card_title(c, x, y, "Revenue")
    let all: u32 = kitdata.get(doc(), kitdata.root(doc()), "line_90d")
    let total: usize = kitdata.count(doc(), all)
    var cnt: usize = range_days(RANGE)
    if cnt > total { cnt = total }
    let cx: f64 = x + kit.ln(c, 18)
    let cy: f64 = y + kit.ln(c, 44)
    let cw: f64 = w - kit.ln(c, 36)
    let ch: f64 = h - kit.ln(c, 44) - kit.ln(c, 16)
    var mx: f64 = 0.0
    var mn: f64 = 1.0e18
    var i: usize = 0
    while i < cnt {
        let v: f64 = kitdata.float(doc(), kitdata.get(doc(), kitdata.at(doc(), all, total - cnt + i), "value"))
        if v > mx { mx = v }
        if v < mn { mn = v }
        i = i + 1
    }
    mx = mx * 1.05
    mn = mn * 0.95
    let z: *mut painter.Painter = render.ctx_painter(c)
    var g: usize = 0
    while g < 4 {
        painter.surface(z, cx, cy + (ch / 3.0) * (g as f64) - (if g == 3 { 1.0 } else { 0.0 }), cw, 1.0, kit.tokc(c, style.TOK_SEPARATOR))
        g = g + 1
    }
    var xs: [f64; 512] = [0.0; 512]
    var ys: [f64; 512] = [0.0; 512]
    i = 0
    while i < cnt {
        let v: f64 = kitdata.float(doc(), kitdata.get(doc(), kitdata.at(doc(), all, total - cnt + i), "value"))
        xs[i] = cx + cw * (i as f64) / ((cnt - 1) as f64)
        ys[i] = cy + ch - ((v - mn) / (mx - mn)) * ch
        i = i + 1
    }
    var ax: [f64; 512] = [0.0; 512]
    var ay: [f64; 512] = [0.0; 512]
    i = 0
    while i < cnt {
        ax[i] = xs[i]
        ay[i] = ys[i]
        i = i + 1
    }
    ax[cnt] = xs[cnt - 1]
    ay[cnt] = cy + ch
    ax[cnt + 1] = xs[0]
    ay[cnt + 1] = cy + ch
    kitchart.fill_poly(c, &ax, &ay, cnt + 2, kit.with_alpha(series(c, 0), 46 as u32))
    kitchart.polyline(c, &xs, &ys, cnt, kit.ln(c, 2), series(c, 0))
}

#[allow_escape]
fn donut(c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64) {
    kitapp.card_draw(c, x, y, w, h, false)
    card_title(c, x, y, "Sources")
    let list: u32 = kitdata.get(doc(), kitdata.root(doc()), "donut")
    var tot: f64 = 0.0
    var i: usize = 0
    while i < 4 {
        tot = tot + kitdata.float(doc(), kitdata.get(doc(), kitdata.at(doc(), list, i), "share"))
        i = i + 1
    }
    let r: f64 = kit.ln(c, 52)
    let cx: f64 = x + kit.ln(c, 18) + r
    let cy: f64 = y + kit.ln(c, 44) + (h - kit.ln(c, 60)) / 2.0
    var a0: f64 = 0.0 - math.PI() / 2.0
    i = 0
    while i < 4 {
        let sh: f64 = kitdata.float(doc(), kitdata.get(doc(), kitdata.at(doc(), list, i), "share"))
        let a1: f64 = a0 + (sh / tot) * 2.0 * math.PI()
        kitchart.sector(c, cx, cy, r - kit.ln(c, 16), r, a0, a1, series(c, i))
        a0 = a1
        i = i + 1
    }
    let lx: f64 = cx + r + kit.ln(c, 18)
    let ly: f64 = cy - kit.ln(c, 46)
    let z: *mut painter.Painter = render.ctx_painter(c)
    i = 0
    while i < 4 {
        let e: u32 = kitdata.at(doc(), list, i)
        let yy: f64 = ly + (kit.ln(c, 24)) * (i as f64)
        painter.round_rect(z, lx, yy + kit.ln(c, 6), kit.ln(c, 9), kit.ln(c, 9), kit.ln(c, 3), series(c, i))
        let lw: f64 = t(c, lx + kit.ln(c, 15), yy, kit.ln(c, 20), 13, 400, style.TOK_TEXT_MUTED, kitdata.text(doc(), kitdata.get(doc(), e, "label")))
        var b: [u8; 96] = [0 as u8; 96]
        var n: usize = put_uint(&b, 0, kitdata.num(doc(), kitdata.get(doc(), e, "share")) as u64, false)
        n = put(&b, n, "%")
        t(c, lx + kit.ln(c, 15) + lw + kit.ln(c, 6), yy, kit.ln(c, 20), 13, 700, style.TOK_TEXT, sub(&b, n))
        i = i + 1
    }
}

fn bars(c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64) {
    kitapp.card_draw(c, x, y, w, h, false)
    card_title(c, x, y, "Monthly orders")
    let list: u32 = kitdata.get(doc(), kitdata.root(doc()), "bars_12")
    let n: usize = kitdata.count(doc(), list)
    var mx: f64 = 1.0
    var i: usize = 0
    while i < n {
        let v: f64 = kitdata.float(doc(), kitdata.get(doc(), kitdata.at(doc(), list, i), "value"))
        if v > mx { mx = v }
        i = i + 1
    }
    let gap: f64 = kit.ln(c, 10)
    let cx: f64 = x + kit.ln(c, 18)
    let cw: f64 = w - kit.ln(c, 36)
    let bw: f64 = (cw - gap * ((n - 1) as f64)) / (n as f64)
    let base: f64 = y + h - kit.ln(c, 34)
    let top: f64 = y + kit.ln(c, 44)
    let z: *mut painter.Painter = render.ctx_painter(c)
    i = 0
    while i < n {
        let e: u32 = kitdata.at(doc(), list, i)
        let v: f64 = kitdata.float(doc(), kitdata.get(doc(), e, "value"))
        let bh: f64 = (base - top) * v / mx
        let bx: f64 = cx + (bw + gap) * (i as f64)
        painter.round_rect(z, bx, base - bh, bw, bh, kit.ln(c, 5), kit.with_alpha(series(c, 1), 230 as u32))
        let lab: str = kitdata.text(doc(), kitdata.get(doc(), e, "label"))
        let lw: f64 = kit.text_width(c, kit.ln(c, 10), 400, lab)
        t(c, bx + (bw - lw) / 2.0, base + kit.ln(c, 6), kit.ln(c, 16), 10, 400, style.TOK_TEXT_DISABLED, lab)
        i = i + 1
    }
}

fn events(c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64) {
    kitapp.card_draw(c, x, y, w, h, false)
    card_title(c, x, y, "Recent events")
    let list: u32 = kitdata.get(doc(), kitdata.root(doc()), "events")
    let z: *mut painter.Painter = render.ctx_painter(c)
    let rh: f64 = (h - kit.ln(c, 52)) / 8.0
    var i: usize = 0
    while i < 8 {
        let e: u32 = kitdata.at(doc(), list, i)
        let ry: f64 = y + kit.ln(c, 44) + rh * (i as f64)
        if i > 0 {
            painter.surface(z, x + kit.ln(c, 18), ry, w - kit.ln(c, 36), 1.0, kit.tokc(c, style.TOK_SEPARATOR))
        }
        let ts: str = kitdata.text(doc(), kitdata.get(doc(), e, "ts"))
        t(c, x + kit.ln(c, 18), ry, rh, 12, 400, style.TOK_TEXT_DISABLED, str { p: (ts.p as u64 + 11) as *mut u8, n: 5 })
        t(c, x + kit.ln(c, 70), ry, rh, 12, 400, style.TOK_TEXT_MUTED, kitdata.text(doc(), kitdata.get(doc(), e, "text")))
        i = i + 1
    }
}

fn paint(ud: u64, c: *mut render.Ctx, w: f64, h: f64, px: f64, py: f64) {
    let m: f64 = kit.ln(c, 28)
    let cw: f64 = w - m * 2.0
    header(c, w)
    let ky: f64 = kit.ln(c, 86)
    let kh: f64 = kit.ln(c, 88)
    kpis(c, ky, cw, kh)
    let gap: f64 = kit.ln(c, 14)
    let y1: f64 = ky + kh + kit.ln(c, 16)
    let avail: f64 = h - kit.ln(c, 22) - y1 - kit.ln(c, 16)
    let h1: f64 = avail / 2.05
    let h2: f64 = avail - h1
    let wide: f64 = (cw - gap) * 2.0 / 3.0
    let narrow: f64 = cw - gap - wide
    line_chart(c, m, y1, wide, h1)
    donut(c, m + wide + gap, y1, narrow, h1)
    let y2: f64 = y1 + h1 + kit.ln(c, 16)
    bars(c, m, y2, wide, h2)
    events(c, m + wide + gap, y2, narrow, h2)
}

fn press(ud: u64, x: f64, y: f64) {
    if x >= SEG_X && x < SEG_X + SEG_W && y >= SEG_Y && y < SEG_Y + SEG_H {
        var i: usize = (((x - SEG_X) / SEG_W) * 3.0) as usize
        if i > 2 { i = 2 }
        RANGE = i
    }
}

fn key(ud: u64, k: u32, mods: u32) -> bool { return false }

fn main(start: u64) -> i32 {
    DOC = kitdata.load("/root/jarvis/data/staff_scratch/uivgl/data/metrics.json") as u64
    return screen.run(start, "Dashboard", 1100, 700, 0, paint, press, key, kitcolor.navy)
}
