// examples/fui_apps/dash/main.fi -- Dashboard: KPI cards, area / bar / donut charts with hover tips, event table, range switch.
//   dash [--theme light|dark] [--shot out.png]      data: data/metrics.json
// The parts are lib/fui/kitdash.fi (page, header, KPI, cards) and lib/fui/kitplot.fi (charts); this file only wires the data.
import std.rt
import fui.kit
import fui.kitdash
import fui.kitdata
import fui.kitfmt
import fui.kitplot
import fui.render
import fui.screen

struct App {
    d: *mut kitdata.Doc,
    sg: kitdash.Seg,
}

fn list(a: *mut App, key: str) -> u32 {
    return kitdata.get((*a).d, kitdata.root((*a).d), key)
}

fn range_text(a: *mut App) -> str {
    return kitdata.text((*a).d, kitdata.at((*a).d, list(a, "ranges"), (*a).sg.on))
}

fn paint(ud: u64, c: *mut render.Ctx, w: f64, h: f64, px: f64, py: f64) {
    let a: *mut App = ud as *mut App
    let d: *mut kitdata.Doc = (*a).d
    let p: kitdash.Page = kitdash.page(c, w, h, kit.ln(c, 40), kit.ln(c, 98), 1.0, 1.05)
    let sx: f64 = p.m + p.wide + p.gap
    kitdash.head_draw(c, &(*a).sg, d, list(a, "ranges"), p, w, "Dashboard", kitfmt.join("Overview of the last ", range_text(a)))
    kitdash.kpi_row(c, d, list(a, "kpis"), p, w)
    let rev: kitplot.Ser = kitplot.ser_fmt(kitplot.ser(d, list(a, "line_90d"), "value", "date"), "EUR ", "", 0)
    var cnt: usize = kitfmt.leading_uint(range_text(a)) as usize
    if cnt > rev.n { cnt = rev.n }
    let r: kitdash.Box = kitdash.card_body(c, p.m, p.y1, p.wide, p.h1, "Revenue")
    kitplot.area_draw(c, r.x, r.y, r.w, r.h, rev, rev.n - cnt, cnt, kitplot.series_col(c, 0), px, py)
    let s: kitdash.Box = kitdash.card_body(c, sx, p.y1, p.narrow, p.h1, "Sources")
    kitplot.donut_legend_draw(c, s.x, s.y, s.w, s.h, kitplot.ser_fmt(kitplot.ser(d, list(a, "donut"), "share", "label"), "", "%", 0), kit.ln(c, 130))
    let o: kitdash.Box = kitdash.card_body(c, p.m, p.y2, p.wide, p.h2, "Monthly orders")
    kitplot.bars_draw(c, o.x, o.y, o.w, o.h, kitplot.ser(d, list(a, "bars_12"), "value", "label"), kitplot.series_col(c, 1), px, py)
    kitdash.table_card(c, sx, p.y2, p.narrow, p.h2, "Recent events", d, list(a, "events"), "ts", 11, 5, "text")
}

fn press(ud: u64, x: f64, y: f64) {
    let a: *mut App = ud as *mut App
    let i: i64 = kitdash.seg_hit(&(*a).sg, x, y)
    if i >= 0 as i64 { (*a).sg.on = i as usize }
}

fn key(ud: u64, k: u32, mods: u32) -> bool { return false }

fn main(start: u64) -> i32 {
    let a: *mut App = rt.heap_alloc(512) as *mut App
    (*a).d = kitdata.load("/root/jarvis/data/staff_scratch/uivgl/data/metrics.json")
    (*a).sg = kitdash.seg_new()
    (*a).sg.on = 2
    return screen.run(start, "Dashboard", 1100, 700, a as u64, paint, press, key, kitdash.skin)
}
