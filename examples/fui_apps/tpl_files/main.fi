import fui.ds_icons
import fui.ds_icons_names
import fui.ds_tpl_files
import fui.ds_tpl_files_model
import fui.kitform
import std.rt

const NODE_NAMES: str = "Home|Documents|Pictures|Music|Projects|Reports|Holiday|Empty|Archive"
static mut PARENTS: [i64; 9] = [0 as i64; 9]
const FILE_NAMES: str = "notes.txt|budget.xlsx|summary.pdf|todo.md|logo.png|song.mp3|clip.mp4|main.fi|readme.md|backup.zip|invoice.pdf|plan.docx"
static mut FILE_SIZES: [i64; 12] = [0 as i64; 12]
const DATES: str = "2026-10-02|2026-09-14|2026-08-30|2026-10-21|2026-07-04|2026-06-18|2026-05-09|2026-10-28|2026-10-29|2026-03-12|2026-04-22|2026-02-01"

fn parent(ud: u64, node: i64) -> i64 { return PARENTS[node as usize] }

fn name_of(ud: u64, node: i64) -> str { return kitform.nth(NODE_NAMES, node as usize) }

fn children(node: i64, k: usize) -> i64 {
    var seen: usize = 0
    var i: usize = 1
    while i < 9 {
        if PARENTS[i] == node {
            if seen == k { return i as i64 }
            seen = seen + 1
        }
        i = i + 1
    }
    return 0 - 1
}

fn dir_count(node: i64) -> usize {
    var n: usize = 0
    var i: usize = 1
    while i < 9 {
        if PARENTS[i] == node { n = n + 1 }
        i = i + 1
    }
    return n
}

fn file_count(node: i64) -> usize {
    if node == 7 { return 0 }
    if node == 5 { return 4 }
    if node == 6 { return 5 }
    return 12 - (node as usize) % 5
}

fn count(ud: u64, node: i64) -> usize { return dir_count(node) + file_count(node) }

fn icon_for(name: str) -> i64 {
    if ends(name, ".png") { return ds_icons.gid(ds_icons_names.IMAGE) }
    if ends(name, ".mp3") { return ds_icons.gid(ds_icons_names.MUSIC) }
    if ends(name, ".mp4") { return ds_icons.gid(ds_icons_names.VIDEO) }
    if ends(name, ".fi") { return ds_icons.gid(ds_icons_names.CODE) }
    if ends(name, ".pdf") { return ds_icons.gid(ds_icons_names.DOCUMENT_PDF) }
    if ends(name, ".zip") { return ds_icons.gid(ds_icons_names.FOLDER_ZIP) }
    if ends(name, ".txt") || ends(name, ".md") { return ds_icons.gid(ds_icons_names.DOCUMENT_TEXT) }
    return ds_icons.gid(ds_icons_names.DOCUMENT)
}

fn entry(ud: u64, node: i64, i: usize, out: *mut ds_tpl_files_model.Entry) {
    let nd: usize = dir_count(node)
    if i < nd {
        let id: i64 = children(node, i)
        *out = ds_tpl_files_model.Entry { name: kitform.nth(NODE_NAMES, id as usize), id: id, size: 0 as i64, modified: kitform.nth(DATES, id as usize), icon: 0 - 1 }
        return
    }
    let k: usize = (i - nd + (node as usize) * 3) % 12
    let name: str = kitform.nth(FILE_NAMES, k)
    *out = ds_tpl_files_model.Entry { name: name, id: 0 - 1, size: FILE_SIZES[k], modified: kitform.nth(DATES, k), icon: icon_for(name) }
}

fn ends(s: str, suffix: str) -> bool {
    if s.n < suffix.n { return false }
    var i: usize = 0
    while i < suffix.n {
        if rt.ld8(s.p as u64, s.n - suffix.n + i) != rt.ld8(suffix.p as u64, i) { return false }
        i = i + 1
    }
    return true
}

fn init() {
    let p: [i64; 9] = [0 - 1, 0, 0, 0, 1, 4, 2, 1, 1]
    let z: [i64; 12] = [2048, 184320, 1572864, 912, 640000, 5242880, 31457280, 4300, 1200, 8388608, 96000, 52000]
    var i: usize = 0
    while i < 9 {
        PARENTS[i] = p[i]
        i = i + 1
    }
    i = 0
    while i < 12 {
        FILE_SIZES[i] = z[i]
        i = i + 1
    }
}

fn main(start: u64) -> i32 {
    init()
    let spec: ds_tpl_files_model.Spec = ds_tpl_files_model.Spec { ud: 0, title: "Files", places: "Home|Documents|Pictures|Music",
        place_nodes: [0, 1, 2, 3, 0, 0, 0, 0],
        place_icons: [ds_icons.gid(ds_icons_names.HOME), ds_icons.gid(ds_icons_names.DOCUMENT), ds_icons.gid(ds_icons_names.IMAGE), ds_icons.gid(ds_icons_names.MUSIC), 0, 0, 0, 0],
        root: 0, parent: parent, name_of: name_of, count: count, entry: entry }
    return ds_tpl_files.files_run(start, "Files", spec)
}
