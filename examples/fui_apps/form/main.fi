// SPDX-License-Identifier: MPL-2.0
// examples/fui_apps/form/main.fi -- 4-step wizard (Person, Address, Payment, Summary) with validation.
//   form [--theme light|dark] [--shot out.png] [--step 1..4] [--fill] [--invalid]
// The wizard itself is lib/fui/kitform.fi (fields, steps, validation); this file only says WHAT is asked.
import std.rt
import fui.kit
import fui.preset
import fui.kitdata
import fui.kitform
import fui.datadir
import fui.screen

const KEYS: str = "first_name|last_name|email|street|zip|city|card_holder|card_number|card_exp"

fn main(start: u64) -> i32 {
    let z: *mut kitform.Wiz = kitform.wiz_new("Person|Address|Payment|Summary",
        "First name|Last name|Email|Street|ZIP|City|Card holder|Card number|Expiry",
        "Justin|Muster|you@example.com|Main street 1|6020|Innsbruck|Name on card|4111 1111 1111 1111|MM/YY",
        "224413431", "001020034")
    let d: *mut kitdata.Doc = kitdata.load(datadir.file("form.json"))
    var set: str = "valid"
    if screen.has_arg(start, "--invalid") != 0 { set = "invalid"; (*z).show = true }
    if screen.has_arg(start, "--fill") != 0 || (*z).show {
        var i: usize = 0
        while i < 9 {
            kit.search_set_text(kitform.wf(z, i), kitdata.text(d, kitdata.get(d, kitdata.get(d, kitdata.root(d), set), kitform.nth(KEYS, i))))
            i = i + 1
        }
    }
    let sp: u64 = screen.arg_after(start, "--step")
    if sp != 0 { (*z).step = (rt.ld8(sp, 0) - 49 as u8) as usize }
    return screen.run_text(start, "Form", 1100, 700, z as u64, kitform.wiz_paint, kitform.wiz_press, kitform.wiz_key, kitform.wiz_text, preset.studio)
}
