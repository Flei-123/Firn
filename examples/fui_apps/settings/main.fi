// SPDX-License-Identifier: MPL-2.0
// examples/fui_apps/settings/main.fi -- settings: 5 pages, toggles, sliders, drop-down, radio, colours, text fields; light/dark live.
//   settings [--theme light|dark] [--shot out.png] [--page 1..5] [--open]
// The controls are lib/fui/kitset.fi; this file only says WHICH settings exist (values from data/settings.json).
import std.rt
import fui.kit
import fui.kitapp
import fui.preset
import fui.palette
import fui.kitdata
import fui.kitform
import fui.kitset
import fui.kitspec
import fui.kittabs
import fui.painter
import fui.render
import fui.screen
import fui.screenanim
import fui.style

const PAL: str = "#3ddc84|#5b8cff|#ff8a4c|#c06bff|#ff5d7a"
const THEMES: str = "dark|light"
const PAGES: str = "|General|Appearance|Account|Network|Advanced"
const SPEC: str = "p\ns~0~general.language~Language~~English|Deutsch|Francais|Espanol\nt~1~general.autostart~Start with system~Launch automatically on login\nt~2~general.notifications~Notifications\nt~3~general.auto_update~Automatic updates\np\nr~4~appearance.theme~Theme~Switches live~dark|light\nc~5~appearance.accent~Accent color~~#3ddc84|#5b8cff|#ff8a4c|#c06bff|#ff5d7a\nl~6~appearance.font_size~Font size~~10~22~px\nt~7~appearance.animations~Animations\nl~8~appearance.scale_pct~UI scale~~75~150~%\np\nf~9~account.username~Username\nf~10~account.email~Email\nf~11~account.display_name~Display name\np\nt~12~network.proxy_enabled~Use proxy\nf~13~network.proxy_host~Proxy host\nf~14~network.proxy_port~Proxy port\nr~15~network.mode~Connection mode~~auto|manual|offline\np\nt~16~advanced.debug_log~Debug log\nl~17~advanced.cache_mb~Cache size~~0~2048~MB\nt~18~advanced.telemetry~Telemetry"

static mut S: u64 = 0
static mut NAV: u64 = 0
static mut PAGE: usize = 1
static mut LOOK: i64 = 0 - 1
static mut CW: f64 = 1100.0

fn st() -> *mut kitset.Set { return S as *mut kitset.Set }
fn items() -> *mut kit.NavItem { return NAV as *mut kit.NavItem }

fn load(d: *mut kitdata.Doc) {
    kitspec.bind(st(), d, SPEC)
    NAV = rt.heap_alloc(1024)
    var k: usize = 0
    while k < 6 {
        *kit.nav_at(items(), k) = kit.NavItem { icon: kit.ICON_NONE, label: kitform.nth(PAGES, k), badge: 0, header: k == 0 }
        k = k + 1
    }
}

fn paint(ud: u64, c: *mut render.Ctx, w: f64, h: f64, px: f64, py: f64) {
    let look: i64 = kitset.val(st(), 4) * 8 + kitset.val(st(), 5)
    if look != LOOK {
        LOOK = look
        preset.look(render.ctx_theme(c), palette.STUDIO, kitset.val(st(), 4) == 0, kitset.hex(kitform.nth(PAL, kitset.val(st(), 5) as usize)))
    }
    painter.surface(render.ctx_painter(c), 0.0, 0.0, w, h, kit.tokc(c, style.TOK_BASE))
    CW = w
    let cp: bool = kittabs.compact(c, w)
    var nw: f64 = kit.ln(c, 230)
    var top: f64 = 0.0
    var pad: f64 = kit.ln(c, 44)
    var ty: f64 = kit.ln(c, 28)
    if cp {
        nw = 0.0
        top = kittabs.tabs_height(c)
        pad = kit.ln(c, 16)
        ty = top + kit.ln(c, 14)
        kittabs.tabs_draw(c, PAGES, 1, PAGE, kittabs.tabs_hit(c, PAGES, 1, 0.0, 0.0, w, px, py), 0.0, 0.0, w)
    } else {
        kit.nav_draw(c, items(), 6, PAGE, kit.nav_hit(c, items(), 6, 0.0, 0.0, nw, false, px, py), false, 0.0, 0.0, nw, h, false)
        kitapp.heading_text(c, kit.ln(c, 24), kit.ln(c, 21), kit.ln(c, 28), 18, "Settings")
    }
    let pt: f64 = screenanim.page(c, PAGE as i64 * 2 + kitset.val(st(), 4))
    let dy: f64 = screenanim.rise(c, pt)
    kitapp.heading_text(c, nw + pad, ty + dy, kit.ln(c, 32), 22, kitform.nth(PAGES, PAGE))
    kitset.begin(st(), c, nw + pad, ty + kit.ln(c, 46) + dy, w - nw - pad * 2.0, px, py)
    kitspec.page_draw(st(), c, SPEC, PAGE)
    kitset.end(st(), c)
    screenanim.veil(c, nw, top, w - nw, h - top, pt)
}

fn press(ud: u64, x: f64, y: f64) {
    let c: *mut render.Ctx = (*st()).ctx as *mut render.Ctx
    var i: usize = kit.NONE
    if kittabs.compact(c, CW) {
        i = kittabs.tabs_hit(c, PAGES, 1, 0.0, 0.0, CW, x, y)
    } else {
        i = kit.nav_hit(c, items(), 6, 0.0, 0.0, kit.ln(c, 230), false, x, y)
    }
    if i != kit.NONE && i > 0 {
        PAGE = i
        kitset.reset(st())
    } else {
        kitset.press(st(), x, y)
    }
}

fn key(ud: u64, k: u32, mods: u32) -> bool { return kitset.key(st(), k, mods) }

fn text(ud: u64, cp: u32, mods: u32) -> bool { return kitset.text(st(), cp, mods) }

fn pointer(ud: u64, kind: u32, x: f64, y: f64) -> bool { return kitset.pointer(st(), kind, x, y) }

fn main(start: u64) -> i32 {
    S = kitset.set_new() as u64
    load(kitdata.load("settings.json"))
    let t: u64 = screen.arg_after(start, "--theme")
    if t != 0 { kitset.set_val(st(), 4, (rt.ld8(t, 0) == 108 as u8) as i64) }
    let p: u64 = screen.arg_after(start, "--page")
    if p != 0 { PAGE = (rt.ld8(p, 0) - 48 as u8) as usize }
    if screen.has_arg(start, "--open") != 0 { (*st()).open = 0 }
    return screen.run_full(start, "Settings", 1100, 700, 0, paint, press, key, text, screen.no_wheel, pointer, preset.studio)
}
