// SPDX-License-Identifier: MPL-2.0
// examples/fui_apps/settings/main.fi -- settings: 5 pages, toggles, sliders, drop-down, radio, colours, text fields; light/dark live.
//   settings [--theme light|dark] [--shot out.png] [--page 1..5] [--open]
// The controls are lib/fui/kitset.fi; this file only says WHICH settings exist (values from data/settings.json).
import std.rt
import fui.kit
import fui.kitapp
import fui.preset
import fui.palette
import fui.kitdata
import fui.kitform
import fui.kitset
import fui.painter
import fui.render
import fui.screen
import fui.style

const PATHS: str = "general.language|general.autostart|general.notifications|general.auto_update|appearance.theme|appearance.accent|appearance.font_size|appearance.animations|appearance.scale_pct|account.username|account.email|account.display_name|network.proxy_enabled|network.proxy_host|network.proxy_port|network.mode|advanced.debug_log|advanced.cache_mb|advanced.telemetry"
const PAL: str = "#3ddc84|#5b8cff|#ff8a4c|#c06bff|#ff5d7a"
const LANGS: str = "English|Deutsch|Francais|Espanol"
const MODES: str = "auto|manual|offline"
const THEMES: str = "dark|light"
const PAGES: str = "|General|Appearance|Account|Network|Advanced"

static mut S: u64 = 0
static mut NAV: u64 = 0
static mut PAGE: usize = 1
static mut LOOK: i64 = 0 - 1

fn st() -> *mut kitset.Set { return S as *mut kitset.Set }
fn items() -> *mut kit.NavItem { return NAV as *mut kit.NavItem }

fn load(d: *mut kitdata.Doc) {
    var i: usize = 0
    while i < 19 {
        let n: u32 = kitdata.path(d, kitform.nth(PATHS, i))
        kitset.set_val(st(), i, kitdata.value(d, n))
        if i == 9 || i == 10 || i == 11 || i == 13 || i == 14 { kitset.set_text(st(), i, kitdata.text(d, n)) }
        i = i + 1
    }
    kitset.set_val(st(), 0, kitset.index_of(LANGS, kitdata.text(d, kitdata.path(d, "general.language"))))
    kitset.set_val(st(), 4, kitset.index_of(THEMES, kitdata.text(d, kitdata.path(d, "appearance.theme"))))
    kitset.set_val(st(), 5, kitset.index_of(PAL, kitdata.text(d, kitdata.path(d, "appearance.accent"))))
    kitset.set_val(st(), 15, kitset.index_of(MODES, kitdata.text(d, kitdata.path(d, "network.mode"))))
    NAV = rt.heap_alloc(1024)
    var k: usize = 0
    while k < 6 {
        *kit.nav_at(items(), k) = kit.NavItem { icon: kit.ICON_NONE, label: kitform.nth(PAGES, k), badge: 0, header: k == 0 }
        k = k + 1
    }
}

fn paint(ud: u64, c: *mut render.Ctx, w: f64, h: f64, px: f64, py: f64) {
    let look: i64 = kitset.val(st(), 4) * 8 + kitset.val(st(), 5)
    if look != LOOK {
        LOOK = look
        preset.look(render.ctx_theme(c), palette.STUDIO, kitset.val(st(), 4) == 0, kitset.hex(kitform.nth(PAL, kitset.val(st(), 5) as usize)))
    }
    painter.surface(render.ctx_painter(c), 0.0, 0.0, w, h, kit.tokc(c, style.TOK_BASE))
    let nw: f64 = kit.ln(c, 230)
    kit.nav_draw(c, items(), 6, PAGE, kit.nav_hit(c, items(), 6, 0.0, 0.0, nw, false, px, py), false, 0.0, 0.0, nw, h, false)
    kitapp.text(c, kit.ln(c, 24), kit.ln(c, 12), kit.ln(c, 28), 18, 700, style.TOK_TEXT, "Settings")
    kitapp.text(c, nw + kit.ln(c, 44), kit.ln(c, 28), kit.ln(c, 32), 22, 700, style.TOK_TEXT, kitform.nth(PAGES, PAGE))
    kitset.begin(st(), c, nw + kit.ln(c, 44), kit.ln(c, 72), w - nw - kit.ln(c, 88), px, py)
    if PAGE == 1 {
        kitset.row_select(st(), c, 0, "Language", LANGS)
        kitset.row_toggle(st(), c, 1, "Start with system", "Launch automatically on login")
        kitset.row_toggle(st(), c, 2, "Notifications", "")
        kitset.row_toggle(st(), c, 3, "Automatic updates", "")
    }
    if PAGE == 2 {
        kitset.row_radio(st(), c, 4, "Theme", "Switches live", THEMES)
        kitset.row_colors(st(), c, 5, "Accent color", PAL)
        kitset.row_slider(st(), c, 6, "Font size", 10, 22, "px")
        kitset.row_toggle(st(), c, 7, "Animations", "")
        kitset.row_slider(st(), c, 8, "UI scale", 75, 150, "%")
    }
    if PAGE == 3 {
        kitset.row_field(st(), c, 9, "Username", "")
        kitset.row_field(st(), c, 10, "Email", "")
        kitset.row_field(st(), c, 11, "Display name", "")
    }
    if PAGE == 4 {
        kitset.row_toggle(st(), c, 12, "Use proxy", "")
        kitset.row_field(st(), c, 13, "Proxy host", "")
        kitset.row_field(st(), c, 14, "Proxy port", "")
        kitset.row_radio(st(), c, 15, "Connection mode", "", MODES)
    }
    if PAGE == 5 {
        kitset.row_toggle(st(), c, 16, "Debug log", "")
        kitset.row_slider(st(), c, 17, "Cache size", 0, 2048, "MB")
        kitset.row_toggle(st(), c, 18, "Telemetry", "")
    }
    kitset.end(st(), c)
}

fn press(ud: u64, x: f64, y: f64) {
    let c: *mut render.Ctx = (*st()).ctx as *mut render.Ctx
    let i: usize = kit.nav_hit(c, items(), 6, 0.0, 0.0, kit.ln(c, 230), false, x, y)
    if i != kit.NONE && i > 0 {
        PAGE = i
        kitset.reset(st())
    } else {
        kitset.press(st(), x, y)
    }
}

fn key(ud: u64, k: u32, mods: u32) -> bool { return kitset.key(st(), k, mods) }

fn text(ud: u64, cp: u32, mods: u32) -> bool { return kitset.text(st(), cp, mods) }

fn pointer(ud: u64, kind: u32, x: f64, y: f64) -> bool { return kitset.pointer(st(), kind, x, y) }

fn main(start: u64) -> i32 {
    S = kitset.set_new() as u64
    load(kitdata.load("/root/jarvis/data/staff_scratch/uivgl/data/settings.json"))
    let t: u64 = screen.arg_after(start, "--theme")
    if t != 0 { kitset.set_val(st(), 4, (rt.ld8(t, 0) == 108 as u8) as i64) }
    let p: u64 = screen.arg_after(start, "--page")
    if p != 0 { PAGE = (rt.ld8(p, 0) - 48 as u8) as usize }
    if screen.has_arg(start, "--open") != 0 { (*st()).open = 0 }
    return screen.run_full(start, "Settings", 1100, 700, 0, paint, press, key, text, screen.no_wheel, pointer, preset.studio)
}
