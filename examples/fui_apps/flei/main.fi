// examples/fui_apps/flei/main.fi -- FleiLauncher home screen (visual only, fake data from data/profiles.json).
//   flei [--theme light|dark] [--shot out.png]
import fui.kit
import fui.kitcolor
import fui.kitapp
import fui.kitdata
import fui.lucide
import fui.render
import fui.screen
import fui.style

static mut NAV: usize = 0
static mut DOC: u64 = 0

fn loader_glyph(l: str) -> i64 {
    if l.n == 6 && *(l.p) == 102 as u8 { return lucide.WRENCH }
    if l.n == 5 && *(l.p) == 113 as u8 { return lucide.LAYOUT_GRID }
    if l.n == 7 { return lucide.BOX }
    return lucide.PACKAGE
}

fn loader_col(l: str) -> u32 {
    if l.n == 6 { return 0xc8a45c as u32 }
    if l.n == 5 { return 0x9b5bd6 as u32 }
    if l.n == 7 { return 0x5aa9e6 as u32 }
    return 0xc47f42 as u32
}

fn paint(ud: u64, c: *mut render.Ctx, w: f64, h: f64, px: f64, py: f64) {
    let d: *mut kitdata.Doc = DOC as *mut kitdata.Doc
    let bar: f64 = kit.ln(c, 44)
    let nw: f64 = kit.ln(c, 218)
    kitapp.titlebar_draw(c, w, bar, "Flei", "Launcher")
    var items: [kit.NavItem; 6] = [kit.NavItem { icon: lucide.HOUSE, label: "Home", badge: 0, header: false }; 6]
    items[1] = kit.NavItem { icon: lucide.STAR, label: "Mods", badge: 0, header: false }
    items[2] = kit.NavItem { icon: lucide.REFRESH_CW, label: "Server sync", badge: 0, header: false }
    items[3] = kit.NavItem { icon: lucide.USERS, label: "Friends", badge: 2, header: false }
    items[4] = kit.NavItem { icon: lucide.WRENCH, label: "Mod Creator", badge: 0, header: false }
    items[5] = kit.NavItem { icon: lucide.SETTINGS, label: "Settings", badge: 0, header: false }
    kit.nav_draw(c, (&items[0]) as *mut kit.NavItem, 6, NAV, kit.NONE, false, 0.0, bar, nw, h - bar, false)
    kitapp.account_draw(c, kit.ln(c, 12), h - kit.ln(c, 74), nw - kit.ln(c, 24), kit.ln(c, 56), "Justin", "Offline", false)
    let x0: f64 = nw + kit.ln(c, 34)
    let cw: f64 = w - x0 - kit.ln(c, 34)
    kitapp.heading_draw(c, x0, bar + kit.ln(c, 28), "Your profiles", "Pick a profile and start playing.", "Total playtime: 208h 0m")
    kitapp.select_draw(c, w - kit.ln(c, 440), bar + kit.ln(c, 37), kit.ln(c, 180), kit.ln(c, 36), "Last created", false)
    kit.button_draw(c, w - kit.ln(c, 252), bar + kit.ln(c, 36), kit.ln(c, 90), kit.ln(c, 38), "Import", kit.ICON_NONE, kit.BTN_SECONDARY, 0 as u32)
    kit.button_draw(c, w - kit.ln(c, 150), bar + kit.ln(c, 30), kit.ln(c, 116), kit.ln(c, 48), "+ New profile", kit.ICON_NONE, kit.BTN_PRIMARY, 0 as u32)
    let gap: f64 = kit.ln(c, 14)
    let cols: usize = kitapp.grid_cols(cw, kit.ln(c, 210), gap)
    let tw: f64 = (cw - gap * ((cols - 1) as f64)) / (cols as f64)
    let list: u32 = kitdata.get(d, kitdata.root(d), "profiles")
    var i: usize = 0
    while i < kitdata.count(d, list) {
        let p: u32 = kitdata.at(d, list, i)
        let cx: f64 = x0 + ((i % cols) as f64) * (tw + gap)
        let cy: f64 = bar + kit.ln(c, 112) + ((i / cols) as f64) * (kit.ln(c, 152) + gap)
        let hov: bool = px >= cx && px < cx + tw && py >= cy && py < cy + kit.ln(c, 152)
        kitapp.info_card_draw(c, cx, cy, tw, kit.ln(c, 152), hov, i as u32, loader_glyph(kitdata.text(d, kitdata.get(d, p, "loader"))),
            loader_col(kitdata.text(d, kitdata.get(d, p, "loader"))), kitdata.text(d, kitdata.get(d, p, "name")), kitdata.text(d, kitdata.get(d, p, "mc_version")), "Edit", "Delete")
        i = i + 1
    }
}

fn press(ud: u64, x: f64, y: f64) {}

fn key(ud: u64, k: u32, mods: u32) -> bool { return false }

fn main(start: u64) -> i32 {
    DOC = kitdata.load("/root/jarvis/data/staff_scratch/uivgl/data/profiles.json") as u64
    return screen.run(start, "FleiLauncher", 1100, 700, 0, paint, press, key, kitcolor.navy)
}
