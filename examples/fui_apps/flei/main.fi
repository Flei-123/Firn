// examples/fui_apps/flei/main.fi -- FleiLauncher home screen (visual only, fake data from data/profiles.json).
//   flei [--theme light|dark] [--shot out.png]
import fui.kit
import fui.preset
import fui.kitapp
import fui.kitdata
import fui.kitfx
import fui.kitscroll
import fui.kittabs
import fui.lucide
import fui.render
import fui.screen
import fui.style

static mut NAV: usize = 0
static mut DOC: u64 = 0
static mut SC: kitscroll.Scroll = kitscroll.Scroll { pos: 0.0, max: 0.0, step: 48.0 }

const TABS: str = "Home|Mods|Sync|Friends|Creator|Settings"

fn loader_glyph(l: str) -> i64 {
    if kitfx.str_eq(l, "fabric") { return lucide.LOADER_FABRIC }
    if kitfx.str_eq(l, "forge") { return lucide.LOADER_FORGE }
    if kitfx.str_eq(l, "quilt") { return lucide.LOADER_QUILT }
    return lucide.LOADER_VANILLA
}

fn loader_col(l: str) -> u32 {
    if kitfx.str_eq(l, "fabric") { return 0xc8a45c as u32 }
    if kitfx.str_eq(l, "forge") { return 0xc47f42 as u32 }
    if kitfx.str_eq(l, "quilt") { return 0x9b5bd6 as u32 }
    return 0x5aa9e6 as u32
}

// "MC 1.21.4 - 0.16.9": the version of the loader as the mock of the original derives it (nothing for vanilla)
fn meta_line(mc: str, l: str) -> str {
    let a: str = kitfx.cat3("MC ", mc, "")
    if kitfx.str_eq(l, "fabric") { return kitfx.cat3(a, " · ", "0.16.9") }
    if kitfx.str_eq(l, "forge") { return kitfx.cat3(a, " · ", "47.3.0") }
    if kitfx.str_eq(l, "quilt") { return kitfx.cat3(a, " · ", "0.29.1") }
    return a
}

fn profile_cards(c: *mut render.Ctx, d: *mut kitdata.Doc, x0: f64, y0: f64, cw: f64, cols: usize, px: f64, py: f64) -> f64 {
    let gap: f64 = kit.ln(c, 14)
    let tw: f64 = (cw - gap * ((cols - 1) as f64)) / (cols as f64)
    let ch: f64 = kit.ln(c, 155)
    let list: u32 = kitdata.get(d, kitdata.root(d), "profiles")
    let n: usize = kitdata.count(d, list)
    var i: usize = 0
    while i < n {
        let p: u32 = kitdata.at(d, list, i)
        let cx: f64 = x0 + ((i % cols) as f64) * (tw + gap)
        let cy: f64 = y0 + ((i / cols) as f64) * (ch + gap)
        let hov: bool = px >= cx && px < cx + tw && py >= cy && py < cy + ch
        kitapp.info_card_draw(c, cx, cy, tw, ch, hov, i as u32, loader_glyph(kitdata.text(d, kitdata.get(d, p, "loader"))),
            loader_col(kitdata.text(d, kitdata.get(d, p, "loader"))), kitdata.text(d, kitdata.get(d, p, "name")), meta_line(kitdata.text(d, kitdata.get(d, p, "mc_version")), kitdata.text(d, kitdata.get(d, p, "loader"))), "Edit", "Delete")
        i = i + 1
    }
    return y0 + (((n + cols - 1) / cols) as f64) * (ch + gap) - gap
}

fn paint_wide(c: *mut render.Ctx, d: *mut kitdata.Doc, w: f64, h: f64, px: f64, py: f64) {
    let bar: f64 = kit.ln(c, 44)
    let nw: f64 = kit.ln(c, 218)
    kitapp.titlebar_draw(c, w, bar, "Flei", "Launcher")
    var items: [kit.NavItem; 6] = [kit.NavItem { icon: lucide.HOUSE, label: "Home", badge: 0, header: false }; 6]
    items[1] = kit.NavItem { icon: lucide.STAR, label: "Mods", badge: 0, header: false }
    items[2] = kit.NavItem { icon: lucide.REFRESH_CW, label: "Server sync", badge: 0, header: false }
    items[3] = kit.NavItem { icon: lucide.USERS, label: "Friends", badge: 0, header: false }
    items[4] = kit.NavItem { icon: lucide.WRENCH, label: "Mod Creator", badge: 0, header: false }
    items[5] = kit.NavItem { icon: lucide.SETTINGS, label: "Settings", badge: 0, header: false }
    kit.nav_draw(c, (&items[0]) as *mut kit.NavItem, 6, NAV, kit.NONE, false, 0.0, bar, nw, h - bar, false)
    kitapp.account_draw(c, kit.ln(c, 12), h - kit.ln(c, 74), nw - kit.ln(c, 25), kit.ln(c, 56), "Justin", "Offline", false)
    let x0: f64 = nw + kit.ln(c, 34)
    let cw: f64 = w - x0 - kit.ln(c, 34)
    kitapp.heading_draw(c, x0, bar + kit.ln(c, 24), "Your profiles", "Pick a profile and start playing.", "Total playtime: 208h 0m")
    kitapp.select_draw(c, w - kit.ln(c, 382), bar + kit.ln(c, 37), kit.ln(c, 166), kit.ln(c, 36), "Last created", false)
    kitfx.button_flat_draw(c, w - kit.ln(c, 206), bar + kit.ln(c, 36), kit.ln(c, 82), kit.ln(c, 39), "Import", false)
    kitfx.button_glow_draw(c, w - kit.ln(c, 114), bar + kit.ln(c, 28), kit.ln(c, 80), kit.ln(c, 52), "+ New", "profile", false)
    let cols: usize = kitapp.grid_cols(cw, kit.ln(c, 210), kit.ln(c, 14))
    profile_cards(c, d, x0, bar + kit.ln(c, 112), cw, cols, px, py)
}

fn paint_narrow(c: *mut render.Ctx, d: *mut kitdata.Doc, w: f64, h: f64, px: f64, py: f64) {
    let bar: f64 = kit.ln(c, 44)
    let top: f64 = bar + kittabs.tabs_height(c)
    let m: f64 = kit.ln(c, 16)
    let cw: f64 = w - m * 2.0
    let hy: f64 = top + kit.ln(c, 16) - SC.pos
    kitapp.heading_draw(c, m, hy, "Your profiles", "Pick a profile and start playing.", "Total playtime: 208h 0m")
    let ry: f64 = hy + kit.ln(c, 72)
    let gap: f64 = kit.ln(c, 8)
    let nb: f64 = kit.ln(c, 80)
    let ib: f64 = kit.ln(c, 82)
    kitapp.select_draw(c, m, ry + kit.ln(c, 9), cw - nb - ib - gap * 2.0, kit.ln(c, 36), "Last created", false)
    kitfx.button_flat_draw(c, w - m - nb - gap - ib, ry + kit.ln(c, 8), ib, kit.ln(c, 39), "Import", false)
    kitfx.button_glow_draw(c, w - m - nb, ry, nb, kit.ln(c, 52), "+ New", "profile", false)
    let end: f64 = profile_cards(c, d, m, ry + kit.ln(c, 68), cw, 1, px, py)
    let ay: f64 = end + kit.ln(c, 14)
    kitapp.account_draw(c, m, ay, cw, kit.ln(c, 56), "Justin", "Offline", false)
    kitscroll.scroll_fit(&SC, ay + kit.ln(c, 56) + m + SC.pos, h, kit.ln(c, 48))
    kitapp.titlebar_draw(c, w, bar, "Flei", "Launcher")
    kittabs.tabs_draw(c, TABS, 0, NAV, kittabs.tabs_hit(c, TABS, 0, 0.0, bar, w, px, py), 0.0, bar, w)
}

fn paint(ud: u64, c: *mut render.Ctx, w: f64, h: f64, px: f64, py: f64) {
    let d: *mut kitdata.Doc = DOC as *mut kitdata.Doc
    kitfx.ground_draw(c, 0.0, 0.0, w, h, 0x1bd96a as u32, 0x2b78ff as u32)
    if kittabs.compact(c, w) {
        paint_narrow(c, d, w, h, px, py)
    } else {
        paint_wide(c, d, w, h, px, py)
    }
}

fn press(ud: u64, x: f64, y: f64) {}

fn key(ud: u64, k: u32, mods: u32) -> bool { return false }

fn wheel(ud: u64, px: f64, py: f64, dx: f64, dy: f64) -> bool { return kitscroll.scroll_by(&SC, dy) }

fn main(start: u64) -> i32 {
    kitapp.set_picture(kitfx.pic_load("default-profile.jpg"))
    kitapp.set_logo(kitfx.pic_load("logo-green.webp"))
    DOC = kitdata.load("profiles.json") as u64
    kitscroll.scroll_arg(&SC, start)
    return screen.run_wheel(start, "FleiLauncher", 1100, 700, 0, paint, press, key, key, wheel, preset.launcher)
}
