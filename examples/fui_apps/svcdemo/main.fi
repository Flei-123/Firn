import std.rt
import fui.app
import fui.appshot
import fui.services

const WIDTH: usize = 640
const HEIGHT: usize = 520
const STORE_KEY: str = "demo-counter"
const SAVE_NAME: str = "svcdemo.txt"
const SAVE_TEXT: str = "saved by svcdemo"
const OPEN_FILTERS: str = "Text|*.txt;*.md|All files|*"
const WAKE_MS: i64 = 50
const DIGITS: str = "0123456789"

static mut STATUS: usize = 0
static mut DETAIL: usize = 0

fn show(a: *mut app.App, status: str, detail: str) {
    app.set_text(a, STATUS, status)
    app.set_text(a, DETAIL, detail)
}

fn on_open(a: *mut app.App) {
    if !services.open_request("Open a file", OPEN_FILTERS) {
        show(a, "File open: no backend", "")
        return
    }
    show(a, "File open: waiting", "")
}

fn on_save(a: *mut app.App) {
    if services.save_request("Save a file", SAVE_NAME, SAVE_TEXT.p as u64, SAVE_TEXT.n) {
        show(a, "File save: requested", SAVE_NAME)
        return
    }
    show(a, "File save: no backend", "")
}

fn on_copy(a: *mut app.App) {
    if services.clip_copy("copied by svcdemo") {
        show(a, "Clipboard: copied", "copied by svcdemo")
        return
    }
    show(a, "Clipboard: no backend", "")
}

fn on_paste(a: *mut app.App) {
    if !services.clip_request() {
        show(a, "Clipboard: no backend", "")
        return
    }
    show(a, "Clipboard: waiting", "")
}

fn on_dialog(a: *mut app.App) {
    let answer: i32 = services.message(services.KIND_INFO, "Services demo", "Hello from svcdemo", services.BTNS_OK)
    if answer == services.ANS_OK {
        show(a, "Dialog: closed with OK", "")
        return
    }
    show(a, "Dialog: unavailable", "")
}

fn on_confirm(a: *mut app.App) {
    if services.confirm("Services demo", "Proceed?") {
        show(a, "Confirm: yes", "")
        return
    }
    show(a, "Confirm: no or unavailable", "")
}

fn digit_value(p: u64) -> i64 {
    var i: i64 = 0
    while i < 10 {
        if rt.mem_eq(p, DIGITS.p as u64 + i as u64, 1) {
            return i
        }
        i = i + 1
    }
    return 0
}

fn bump_counter(a: *mut app.App) {
    var out: rt.Buf = rt.buf_new()
    var count: i64 = 0
    if services.store_get(STORE_KEY, &out) && rt.buf_len(&out) == 1 {
        count = digit_value(rt.buf_ptr(&out))
    }
    rt.buf_free(&out)
    count = (count + 1) % 10
    let digit: str = str { p: DIGITS.p + count as usize, n: 1 }
    if !services.store_set(STORE_KEY, digit.p as u64, digit.n) {
        show(a, "Storage: failed", "")
        return
    }
    app.set_number(a, DETAIL, count)
    app.set_text(a, STATUS, "Storage: counter saved")
}

fn on_list(a: *mut app.App) {
    var out: rt.Buf = rt.buf_new()
    if services.list_dir("/", &out) {
        show(a, "Directory: listed", "entries returned")
    } else {
        show(a, "Directory: not available", "")
    }
    rt.buf_free(&out)
}

fn drain(a: *mut app.App) -> bool {
    var ev: services.SvcEvent = services.event_new()
    var changed: bool = false
    while services.next(&ev) {
        changed = true
        if ev.kind == services.EV_OPENED {
            show(a, "File open: done", rt.buf_str(&ev.name))
        }
        if ev.kind == services.EV_SAVED {
            show(a, "File save: done", rt.buf_str(&ev.name))
        }
        if ev.kind == services.EV_CLIP {
            show(a, "Clipboard: pasted", rt.buf_str(&ev.data))
        }
    }
    services.event_free(&ev)
    return changed
}

static mut APP: u64 = 0

fn wake_tick(ud: u64, now: i64) -> bool {
    return drain(APP as *mut app.App)
}

fn wake_wait(ud: u64, now: i64) -> i64 {
    return WAKE_MS
}

fn main(start: u64) -> i32 {
    let a: *mut app.App = app.window("Services demo", WIDTH, HEIGHT)
    APP = a as u64
    app.label(a, "Services demo", 24)
    STATUS = app.label(a, "Ready", 16)
    DETAIL = app.label(a, "-", 14)
    app.button(a, "Open file", on_open)
    app.button(a, "Save file", on_save)
    app.button(a, "Copy text", on_copy)
    app.button(a, "Paste text", on_paste)
    app.button(a, "Message", on_dialog)
    app.button(a, "Confirm", on_confirm)
    app.button(a, "Count in storage", bump_counter)
    app.button(a, "List directory", on_list)
    app.set_extra_wake(a, 0, wake_tick, wake_wait)
    return appshot.finish(a, start, WIDTH, HEIGHT)
}
