import fui.ds_tpl_settings
import fui.lucide
import fui.render

fn on_apply(ud: u64, id: usize, v: i64) {
    if id == 1 {
        let t: *mut ds_tpl_settings.Tpl = ds_tpl_settings.tp(ud)
        ds_tpl_settings.skin(render.ctx_theme(ds_tpl_settings.ctx(t)), v == 1)
    }
}

fn on_fire(ud: u64, id: usize) {}

fn main(start: u64) -> i32 {
    let t: *mut ds_tpl_settings.Tpl = ds_tpl_settings.new("Settings", on_apply, on_fire, 0)
    (*t).ud = t as u64
    ds_tpl_settings.page(t, lucide.MONITOR, "System")
    ds_tpl_settings.section(t, "Display")
    ds_tpl_settings.toggle(t, 1, lucide.MOON, "Dark mode", "Switch the whole app instantly")
    ds_tpl_settings.combo(t, 2, lucide.GLOBE, "Language", "", "English|Deutsch|Francais")
    ds_tpl_settings.slider(t, 3, lucide.SUN, "Brightness", "", 0, 100, "%")
    ds_tpl_settings.section(t, "Power")
    ds_tpl_settings.toggle(t, 4, lucide.CLOCK, "Sleep when idle", "Save energy after 10 minutes")
    ds_tpl_settings.link(t, 5, lucide.HARD_DRIVE, "Storage", "Manage disks and cleanup")
    ds_tpl_settings.page(t, lucide.WIFI, "Network")
    ds_tpl_settings.section(t, "Connection")
    ds_tpl_settings.toggle(t, 6, lucide.WIFI, "Wi-Fi", "Connected to Home")
    ds_tpl_settings.value(t, 7, lucide.GLOBE, "Proxy", "", "Off")
    ds_tpl_settings.button(t, 8, lucide.SETTINGS, "Network reset", "Forget all saved networks", "Reset")
    ds_tpl_settings.page(t, lucide.LOCK, "Privacy")
    ds_tpl_settings.section(t, "Permissions")
    ds_tpl_settings.toggle(t, 9, lucide.BELL, "Notifications", "Allow apps to notify you")
    ds_tpl_settings.toggle(t, 10, lucide.USERS, "Diagnostics", "Send anonymous usage data")
    ds_tpl_settings.set(t, 1, 0)
    ds_tpl_settings.set(t, 3, 70)
    ds_tpl_settings.set(t, 6, 1)
    ds_tpl_settings.set(t, 9, 1)
    return ds_tpl_settings.run(start, t, 1100, 700)
}
