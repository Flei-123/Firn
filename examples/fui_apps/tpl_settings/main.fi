import ds_icons_set
import fui.ds_tpl_settings
import fui.ds_icons
import fui.ds_icons_names
import fui.render

fn on_apply(ud: u64, id: usize, v: i64) {
    if id == 1 {
        let t: *mut ds_tpl_settings.Tpl = ds_tpl_settings.tp(ud)
        ds_tpl_settings.skin(render.ctx_theme(ds_tpl_settings.ctx(t)), v == 1)
    }
}

fn ico(id: i64) -> i64 { return ds_icons.gid(id) }

fn on_fire(ud: u64, id: usize) {}

fn main(start: u64) -> i32 {
    ds_icons_set.install()
    let t: *mut ds_tpl_settings.Tpl = ds_tpl_settings.new("Settings", on_apply, on_fire, 0)
    (*t).ud = t as u64
    ds_tpl_settings.page(t, ico(ds_icons_names.DISPLAY), "System")
    ds_tpl_settings.section(t, "Display")
    ds_tpl_settings.toggle(t, 1, ico(ds_icons_names.MOON), "Dark mode", "Switch the whole app instantly")
    ds_tpl_settings.combo(t, 2, ico(ds_icons_names.GLOBE), "Language", "", "English|Deutsch|Francais")
    ds_tpl_settings.slider(t, 3, ico(ds_icons_names.BRIGHTNESS), "Brightness", "", 0, 100, "%")
    ds_tpl_settings.section(t, "Power")
    ds_tpl_settings.toggle(t, 4, ico(ds_icons_names.CLOCK), "Sleep when idle", "Save energy after 10 minutes")
    ds_tpl_settings.link(t, 5, ico(ds_icons_names.HARD_DRIVE), "Storage", "Manage disks and cleanup")
    ds_tpl_settings.page(t, ico(ds_icons_names.WIFI_1), "Network")
    ds_tpl_settings.section(t, "Connection")
    ds_tpl_settings.toggle(t, 6, ico(ds_icons_names.WIFI_1), "Wi-Fi", "Connected to Home")
    ds_tpl_settings.value(t, 7, ico(ds_icons_names.GLOBE), "Proxy", "", "Off")
    ds_tpl_settings.button(t, 8, ico(ds_icons_names.SETTINGS), "Network reset", "Forget all saved networks", "Reset")
    ds_tpl_settings.page(t, ico(ds_icons_names.LOCK), "Privacy")
    ds_tpl_settings.section(t, "Permissions")
    ds_tpl_settings.toggle(t, 9, ico(ds_icons_names.NOTIFICATION), "Notifications", "Allow apps to notify you")
    ds_tpl_settings.toggle(t, 10, ico(ds_icons_names.USER), "Diagnostics", "Send anonymous usage data")
    ds_tpl_settings.page(t, ico(ds_icons_names.PERSONALIZE), "Personalization")
    ds_tpl_settings.section(t, "Colors")
    ds_tpl_settings.swatch(t, 11, "Accent color", "")
    ds_tpl_settings.set(t, 1, 0)
    ds_tpl_settings.set(t, 3, 70)
    ds_tpl_settings.set(t, 6, 1)
    ds_tpl_settings.set(t, 9, 1)
    return ds_tpl_settings.run(start, t, 1100, 700)
}
