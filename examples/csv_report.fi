// expect_exit: 0
// examples/csv_report.fi -- std.csv: read an order list, add it up per part,
// write the result as CSV. What a 30 line Python script with `csv.DictReader`
// and `csv.writer` does, in Firn.
//
// In a real program the text comes from a file (fs.read_file) or the cells are
// streamed from stdin with csv.reader_fd(0); here it is embedded so that the
// example runs anywhere.
import std.rt
import std.str
import std.csv

fn number(s: str) -> i64 {
    var v: i64 = 0
    var i: usize = 0
    while i < s.n {
        let c: u8 = *(s.p + i)
        if c < 48 as u8 || c > 57 as u8 {
            return v
        }
        v = v * 10 + (c - 48 as u8) as i64
        i = i + 1
    }
    return v
}

fn main() -> i32 {
    var text: str = "part,qty,devices\r\nbreaker 16A,4,\"-F1, -F2, -F3, -F4\"\r\ncontactor 9A,2,\"-K1, -K2\"\r\n\r\nmotor,1,-M1\r\nbreaker 16A,2,-F5\r\n"
    var t: csv.Table = csv.table_parse(text.p, text.n)
    if csv.table_error(&t) != csv.E_NONE {
        return 1
    }

    // total quantity of "breaker 16A" over all rows
    var total: i64 = 0
    var row: usize = 0
    while row < csv.rows(&t) {
        if csv.cell(&t, row, "part").equal("breaker 16A") {
            total = total + number(csv.cell(&t, row, "qty"))
        }
        row = row + 1
    }

    // the report: part;qty, with ';' as a German spreadsheet wants it
    var out: rt.Buf = rt.buf_new()
    var w: csv.Writer = csv.writer(&out)
    csv.set_writer_delimiter(&w, 59 as u8)
    csv.set_terminator(&w, "\n")
    csv.put(&w, "part")
    csv.put(&w, "devices")
    csv.end_row(&w)
    row = 0
    while row < csv.rows(&t) {
        csv.put(&w, csv.cell(&t, row, "part"))
        csv.put(&w, csv.cell(&t, row, "devices"))
        csv.end_row(&w)
        row = row + 1
    }
    rt.write_everything(1, rt.buf_ptr(&out), rt.buf_len(&out))
    rt.buf_free(&out)
    csv.table_free(&t)

    var line: rt.Buf = rt.buf_new()
    var label: str = "breakers in total: "
    rt.buf_push_bytes(&line, label.p as u64, label.n)
    rt.buf_push_dec_i64(&line, total)
    rt.buf_push(&line, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&line), rt.buf_len(&line))
    rt.buf_free(&line)
    if total != 6 {
        return 2
    }
    return 0
}
