// expect_exit: 1
// Bubblesort auf einem Array fester Groesse.
// Rueckgabe 1 = sortiert und Reihenfolge stimmt, 0 = kaputt.

fn main() -> i32 {
    var a: [i32; 8] = [5, 3, 9, 1, 7, 2, 8, 4]
    var n: usize = 8

    var i: usize = 0
    while i < n {
        var j: usize = 0
        while j + 1 < n - i {
            if a[j] > a[j + 1] {
                let t: i32 = a[j]
                a[j] = a[j + 1]
                a[j + 1] = t
            }
            j = j + 1
        }
        i = i + 1
    }

    // Pruefen: aufsteigend und Summe unveraendert.
    var ok: i32 = 1
    var k: usize = 0
    var sum: i32 = 0
    while k < n {
        sum = sum + a[k]
        if k > 0 {
            if a[k - 1] > a[k] {
                ok = 0
            }
        }
        k = k + 1
    }
    if sum != 39 {
        ok = 0
    }
    if a[0] != 1 {
        ok = 0
    }
    if a[7] != 9 {
        ok = 0
    }
    return ok
}
