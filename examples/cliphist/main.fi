// SPDX-License-Identifier: MPL-2.0
// examples/cliphist/main.fi -- clipboard history window (Win+V style).
//
//     cliphist_app [history-file]
//
// Watches the system clipboard, keeps the last 25 entries, Ctrl+Shift+V shows / hides the window, a click on a row
// puts the entry back on the clipboard. With a file argument the history is stored there (opt-in, mode 0600, never
// entries flagged sensitive). Without it nothing touches the disk.
//   std.cliphist (history, watcher) + fui.cliphistview (window) + fui.looppump (timer and window in ONE thread).
import std.rt
import async.loop
import std.cliphist
import fui.app
import fui.looppump
import fui.cliphistview

// `#[allow_escape]`: history, watcher and loop live as long as `app.run`, which is all of main.
#[allow_escape]
fn main(start: u64) -> i32 {
    var l: loop.Loop = loop.loop_new()
    if !loop.loop_init(&l) {
        return 2
    }
    var h: cliphist.History = cliphist.hist_new()
    var w: cliphist.Watcher = cliphist.watch_new()
    if rt.arg_count(start) >= 2 {
        let pp: u64 = rt.arg_ptr(start, 1)
        let path: str = str { p: pp as *mut u8, n: rt.c_length(pp) }
        let n: i64 = cliphist.load(&h, path)
        let on: bool = cliphist.persist_enable(&h, path)
    }
    let a: *mut app.App = app.window("Clipboard", 360, 420)
    let built: bool = cliphistview.view_build(a, &h, &w)
    if !built {
        return 3
    }
    app.set_window_hooks(a, 0, cliphistview.view_on_opened, cliphistview.view_on_hotkey)
    looppump.attach(a, &l)
    let started: bool = cliphist.watch_start(&w, &h, &l, 400)
    let auto: bool = cliphistview.view_autorefresh(&l, 200)
    return app.run(a)
}
