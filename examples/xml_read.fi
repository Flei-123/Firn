// expect_out: project=Demo tasks=3 hours=19 done=Design,Test
// examples/xml_read.fi -- std.xml: read a small XML file the way a Python
// script does with xml.etree: find children, read attributes and text.
import std.xml
import std.rt
import std.io

fn dec(s: str) -> usize {
    var v: usize = 0
    var i: usize = 0
    while i < s.n {
        v = v * 10 + (rt.ld8(s.p as u64, i) - 48 as u8) as usize
        i = i + 1
    }
    return v
}

fn put(out: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(out, s.p as u64, s.n)
}

fn main() -> i32 {
    let text: str = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<project name=\"Demo\">\n  <!-- three tasks -->\n  <task hours=\"8\" done=\"yes\"><title>Design</title></task>\n  <task hours=\"5\"><title>Build &amp; ship</title></task>\n  <task hours=\"6\" done=\"yes\"><title>Test</title></task>\n</project>"
    var d: xml.Doc = xml.doc_new()
    defer xml.doc_free(&d)
    let ok: bool = xml.parse_str(&d, text) catch false
    if !ok {
        return 1
    }
    let root: u32 = xml.root(&d)
    var out: rt.Buf = rt.buf_new()
    defer rt.buf_free(&out)
    put(&out, "project=")
    put(&out, xml.attr(&d, root, "name"))
    var tasks: usize = 0
    var hours: usize = 0
    var done: rt.Buf = rt.buf_new()
    defer rt.buf_free(&done)
    var t: u32 = xml.child(&d, root, "task")
    while t != xml.NONE {
        tasks = tasks + 1
        hours = hours + dec(xml.attr(&d, t, "hours"))
        if xml.attr(&d, t, "done") == "yes" {
            if rt.buf_len(&done) > 0 {
                rt.buf_push(&done, 44 as u8)
            }
            put(&done, xml.text(&d, xml.child(&d, t, "title")))
        }
        t = xml.next_named(&d, t, "task")
    }
    put(&out, " tasks=")
    rt.buf_push_dec_u64(&out, tasks as u64)
    put(&out, " hours=")
    rt.buf_push_dec_u64(&out, hours as u64)
    put(&out, " done=")
    rt.buf_push_bytes(&out, rt.buf_ptr(&done), rt.buf_len(&done))
    io.print_line_bytes(rt.buf_ptr(&out), rt.buf_len(&out))
    return 0
}
