// expect_exit: 0
// examples/fsx_script.fi -- std.fsx in a script: a temporary directory that
// removes itself, a tree copied into it (without the files that match the
// ignore list), a walk over the result and relative paths. The directory is
// gone when `main` ends -- `defer` runs on every way out of `work`.
//
//     firnc -o /tmp/demo examples/fsx_script.fi && /tmp/demo
import std.fsx
import std.fs
import std.rt
import std.testkit

fn note(p: str, kind: u8, ctx: u64) -> i32 {
    let n: *mut usize = ctx as *mut usize
    if kind == fs.KIND_FILE {
        *n = *n + 1
    }
    return fsx.WALK_CONTINUE
}

fn work() -> FsError!bool {
    var d: fsx.TempDir = try fsx.temp_dir("fsx_demo_")
    defer fsx.temp_dir_drop(&d)
    let w: str = fsx.temp_dir_path(&d)
    // a small source tree
    try fs.mkdir_all(w + "/src/docs")
    try fs.write_file(w + "/src/main.fi", "fn main() {}\n".p as u64, 13)
    try fs.write_file(w + "/src/docs/readme.md", "# demo\n".p as u64, 7)
    try fs.write_file(w + "/src/build.tmp", "junk".p as u64, 4)
    try fs.symlink("docs/readme.md", w + "/src/readme")
    // copy it without *.tmp; the link stays a link
    let n: usize = try fsx.copy_tree(w + "/src", w + "/copy", "*.tmp")
    testkit.check(n == 4, "four entries copied (main.fi, docs, readme.md, the link)")
    testkit.check(fsx.relpath(w + "/copy/docs/readme.md", w) == "copy/docs/readme.md", "relpath below the work directory")
    testkit.check(fsx.relpath(w + "/src", w + "/copy/docs") == "../../src", "relpath upwards")
    testkit.check(!fs.exists(w + "/copy/build.tmp"), "the ignored file is not there")
    testkit.check((fs.readlink(w + "/copy/readme") catch "?") == "docs/readme.md", "the link was copied as a link")
    var files: usize = 0
    try fsx.walk(w + "/copy", note, (&files) as u64)
    testkit.check(files == 2, "the walk sees two regular files")
    testkit.check((fsx.copy_file(w + "/copy/main.fi", w + "/main2.fi") catch 0) == 13, "copy_file copies 13 octets")
    testkit.check(fsx.normpath("a//b/./c/../d") == "a/b/d", "normpath")
    return true
}

fn main() -> i32 {
    testkit.check(work() catch | e | false, "the work function ran without an error")
    return testkit.finish()
}
