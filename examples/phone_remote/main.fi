// examples/phone_remote -- steer this computer's mouse from a phone.
// firnc -o phone_remote examples/phone_remote/main.fi && ./phone_remote
import std.io
import std.text
import http.server as http
import input.input

const PAGE: str = __include_str("index.html")

fn on_message(w: *mut http.Ws, msg: str) {
    let cmd: str = text.field(msg, ",", 0)
    let a: i32 = text.int32(text.field(msg, ",", 1))
    let b: i32 = text.int32(text.field(msg, ",", 2))
    if cmd == "move" { input.mouse_move(a, b) }
    if cmd == "click" { input.click() }
    if cmd == "rclick" { input.right_click() }
    if cmd == "scroll" { input.scroll(a) }
    if cmd == "vol+" { input.volume_up() }
    if cmd == "vol-" { input.volume_down() }
    if cmd == "mute" { input.mute() }
    if cmd == "play" { input.play_pause() }
}

fn main() -> i32 {
    if !input.ready() {
        io.print_line(input.error_text())
        return 1
    }
    var app: http.App = http.app(8080)
    http.pair(&app) // pairing: only the phone that opened the printed URL gets in
    http.route_text(&app, "/", "text/html; charset=utf-8", PAGE)
    http.route_ws(&app, "/ws", on_message)
    io.fmt_print_line(f"Open on the phone: {http.url(&app)}")
    return http.serve(&app)
}
