// SPDX-License-Identifier: MPL-2.0
// examples/jarvis_android/jtokens.fi -- design tokens of the JARVIS mobile web app (jarvis.fleitec.com, public/style.css), as constants.
//
// ONE place for every number the app takes over from the web UI. Names follow the CSS variables of `:root` (theme "fleitec", the
// default) in /root/jarvis/public/style.css. Lengths are CSS px = fUi design points. Blends of `rgba(255,255,255,a)` over the
// page ground are precomputed (the comment shows the CSS). The web app has NO light theme: the LIGHT set is derived (same hues,
// same radii) and exists because the system / settings can ask for it.
//
// DARK (CSS :root)
//   --bg #0c0e1f   --bg-sidebar #0a0b18   --panel #15172b   --txt #e9ebf5   --dim #9aa0bb
//   --accent #2f86ff   --accent2 #36c5ff   --warn #ff5d5d   --ok #2ee6a6   --user-grad #1b2447 -> #2a4488
//   --line rgba(255,255,255,.08)   --field-line rgba(255,255,255,.14)   --field-bg rgba(255,255,255,.05)   --bg-hover rgba(255,255,255,.06)
// SHAPE  --radius-sm 8   --radius 12   --radius-card 16   --radius-pill 999   user bubble 18 (bottom-right 6)
// TYPE   body 14 px on phones (@media max-width 760px), brand 16 px / 800 / letter-spacing 2 px, pill 12 px
// SIZES  header min-height 56, composer buttons 38 x 38 round, composer panel padding 8 / 10, margin 12
export {
    D_BG, D_SIDEBAR, D_PANEL, D_PANEL_UP, D_TXT, D_DIM, D_ACCENT, D_ACCENT2, D_WARN, D_OK, D_LINE, D_FIELD_LINE, D_FIELD_BG, D_HOVER, D_PRESS, D_BUBBLE, D_BUBBLE_END, D_SEL,
    L_BG, L_SIDEBAR, L_PANEL, L_PANEL_UP, L_TXT, L_DIM, L_ACCENT, L_WARN, L_OK, L_LINE, L_FIELD_LINE, L_FIELD_BG, L_HOVER, L_PRESS, L_BUBBLE, L_SEL,
    R_SM, R_MD, R_CARD, R_PILL, R_BUBBLE, FONT_BODY, FONT_SMALL, FONT_BRAND, FONT_TAB, FONT_TITLE, FONT_VAL, HEADER_H, ICON_BTN, COMPOSER_PAD_X, COMPOSER_PAD_Y, PAGE_MARGIN, TRACK_BRAND,
}

// ---- dark (theme "fleitec")
const D_BG: u32 = 0x0c0e1f
const D_SIDEBAR: u32 = 0x0a0b18
const D_PANEL: u32 = 0x15172b
const D_PANEL_UP: u32 = 0x1b1e36      // a card lifted off the panel
const D_TXT: u32 = 0xe9ebf5
const D_DIM: u32 = 0x9aa0bb
const D_ACCENT: u32 = 0x2f86ff
const D_ACCENT2: u32 = 0x36c5ff
const D_WARN: u32 = 0xff5d5d
const D_OK: u32 = 0x2ee6a6
const D_LINE: u32 = 0x1f2131          // rgba(255,255,255,.08) over --bg
const D_FIELD_LINE: u32 = 0x2e303e    // rgba(255,255,255,.14) over --bg
const D_FIELD_BG: u32 = 0x212336      // rgba(255,255,255,.05) over --panel
const D_HOVER: u32 = 0x232538         // rgba(255,255,255,.06) over --panel
const D_PRESS: u32 = 0x101226
const D_BUBBLE: u32 = 0x1b2447        // start of --user-grad (135deg #1b2447 -> #2a4488)
const D_BUBBLE_END: u32 = 0x2a4488
const D_SEL: u32 = 0x264f9a

// ---- light (derived; the web app has none)
const L_BG: u32 = 0xf4f6fc
const L_SIDEBAR: u32 = 0xeaeef8
const L_PANEL: u32 = 0xffffff
const L_PANEL_UP: u32 = 0xf8f9fd
const L_TXT: u32 = 0x14172b
const L_DIM: u32 = 0x5b6280
const L_ACCENT: u32 = 0x2f86ff
const L_WARN: u32 = 0xd6453f
const L_OK: u32 = 0x12915f
const L_LINE: u32 = 0xe0e4f0
const L_FIELD_LINE: u32 = 0xcdd3e6
const L_FIELD_BG: u32 = 0xeef1f9
const L_HOVER: u32 = 0xe8ecf7
const L_PRESS: u32 = 0xdce2f2
const L_BUBBLE: u32 = 0xdce7ff
const L_SEL: u32 = 0xbcd5ff

// ---- shape and size (design points)
const R_SM: usize = 8
const R_MD: usize = 12
const R_CARD: usize = 16
const R_PILL: usize = 999
const R_BUBBLE: usize = 18
const FONT_BODY: usize = 14
const FONT_SMALL: usize = 12
const FONT_BRAND: usize = 16
const FONT_TAB: usize = 11
const FONT_TITLE: usize = 16
const FONT_VAL: usize = 15
const HEADER_H: usize = 56
const ICON_BTN: usize = 38
const COMPOSER_PAD_X: usize = 10
const COMPOSER_PAD_Y: usize = 8
const PAGE_MARGIN: usize = 12
const TRACK_BRAND: i64 = 2
