// SPDX-License-Identifier: MPL-2.0
// examples/jarvis_android/jsetui.fi -- page building blocks of the settings, sign-in and list pages, shaped like the mobile web app
// (public/style.css): a CARD per section with a small letter-spaced caps heading and ROWS (label left, value right), left aligned.
//
//   install_rules(a)          the style rules (called once from jtheme.install_rules)
//   page(a) -> id             the column of a page: full width, from the top, 12 pt between its cards. Close with `app.end`.
//   card(a, heading) -> id    a section card with its heading; the rows that follow stand in it. Close with `app.end`.
//   row(a, label) -> id       a line "label ........ value": returns the VALUE node (a label the caller fills); the line is closed.
//   text_row(a, text) -> id   a quiet full-width line (hints, status)
//   chip_row(a) -> id         a wrapping line of chips; close with `app.end`
//   primary(a, text, cb) -> id  the wide accent button (.btn.primary)
//
// Everything here is plain fUi nodes (fui.app + fui.applay); no new widget kinds.
import fui.app
import fui.scene
import fui.flex
import fui.style
import fui.sheet
import fui.applay
import jtokens

export { install_rules, page, card, row, text_row, chip_row, primary, K_SET_CARD, K_SET_HEAD, K_SET_LABEL, K_SET_VALUE, K_SET_HINT, K_PRIMARY, K_LOGIN_BRAND, K_SET_PAGE, K_SET_ERR, K_INPUT, input }

const K_SET_CARD: u32 = 40
const K_SET_HEAD: u32 = 41
const K_SET_LABEL: u32 = 42
const K_SET_VALUE: u32 = 43
const K_SET_HINT: u32 = 44
const K_PRIMARY: u32 = 45
const K_LOGIN_BRAND: u32 = 46
const K_SET_PAGE: u32 = 47
const K_SET_ERR: u32 = 48
const K_INPUT: u32 = 49

const CARD_PAD_X: i64 = 14
const CARD_PAD_Y: i64 = 12
const ROW_GAP: i64 = 10
const CARD_GAP: i64 = 12

fn rule(a: *mut app.App, k: u32, st: style.Style) {
    let r: usize = sheet.sheet_rule(&(*a).sh, sheet.sel_class(k), st)
}

fn tok(t: u32) -> u32 { return style.color_token(t) }

fn install_rules(a: *mut app.App) {
    // a section card (.card): panel, hairline, radius 16
    var st: style.Style = style.style_new()
    st = style.style_set_bg(st, tok(style.TOK_SURFACE))
    st = style.style_set_border(st, tok(style.TOK_SEPARATOR), 1)
    st = style.style_set_radius(st, jtokens.R_CARD)
    rule(a, K_SET_CARD, st)
    // the heading of a card (.sec-h): accent, 11 px, bold, wide tracking (the texts are written in capitals)
    st = style.style_new()
    st = style.style_set_fg(st, tok(style.TOK_ACCENT))
    st = style.style_set_font(st, 0, jtokens.FONT_TAB)
    st = style.style_set_weight(st, 700 as u32)
    st = style.style_set_tracking(st, 2)
    rule(a, K_SET_HEAD, st)
    // row label: muted 14 px
    st = style.style_new()
    st = style.style_set_fg(st, tok(style.TOK_TEXT_MUTED))
    st = style.style_set_font(st, 0, jtokens.FONT_BODY)
    st = style.style_set_align(st, style.ALIGN_LEFT)
    rule(a, K_SET_LABEL, st)
    // row value: text colour, bold 14 px
    st = style.style_new()
    st = style.style_set_fg(st, tok(style.TOK_TEXT))
    st = style.style_set_font(st, 0, jtokens.FONT_BODY)
    st = style.style_set_weight(st, 700 as u32)
    st = style.style_set_align(st, style.ALIGN_RIGHT)
    rule(a, K_SET_VALUE, st)
    // hint / status: muted 12 px
    st = style.style_new()
    st = style.style_set_fg(st, tok(style.TOK_TEXT_MUTED))
    st = style.style_set_font(st, 0, jtokens.FONT_SMALL)
    st = style.style_set_align(st, style.ALIGN_LEFT)
    rule(a, K_SET_HINT, st)
    // primary button (.btn.primary): accent ground, dark-on-accent text, bold, radius 12
    st = style.style_new()
    st = style.style_set_bg(st, tok(style.TOK_ACCENT))
    st = style.style_set_fg(st, jtokens.D_BG) // the web button has dark text on the blue
    st = style.style_set_border(st, tok(style.TOK_ACCENT), 0)
    st = style.style_set_radius(st, jtokens.R_MD)
    st = style.style_set_pad(st, 14, 12)
    st = style.style_set_font(st, 0, jtokens.FONT_BODY + 1)
    st = style.style_set_weight(st, 700 as u32)
    rule(a, K_PRIMARY, st)
    // the brand of the sign-in card (.auth-brand): accent, 26 px, heavy, wide tracking
    st = style.style_new()
    st = style.style_set_fg(st, tok(style.TOK_ACCENT))
    st = style.style_set_font(st, 0, 26)
    st = style.style_set_weight(st, 800 as u32)
    st = style.style_set_tracking(st, 4)
    rule(a, K_LOGIN_BRAND, st)
    // error / status line under a form: warning colour, 12 px
    st = style.style_new()
    st = style.style_set_fg(st, tok(style.TOK_ERROR))
    st = style.style_set_font(st, 0, jtokens.FONT_SMALL)
    st = style.style_set_align(st, style.ALIGN_LEFT)
    rule(a, K_SET_ERR, st)
    // text field of a form (.auth input): darker than the card, hairline, radius 10
    st = style.style_new()
    st = style.style_set_bg(st, tok(style.TOK_BASE))
    st = style.style_set_border(st, tok(style.TOK_BORDER), 1)
    st = style.style_set_radius(st, 10)
    st = style.style_set_pad(st, 12, 9)
    st = style.style_set_font(st, 0, jtokens.FONT_BODY)
    rule(a, K_INPUT, st)
    // the page ground
    st = style.style_new()
    st = style.style_set_bg(st, tok(style.TOK_BASE))
    rule(a, K_SET_PAGE, st)
}

fn cls(a: *mut app.App, n: usize, k: u32) {
    if n == app.NONE { return }
    scene.node_add_class(app.app_scene(a), n, k)
}

// the column of a page: full width, from the top
fn page(a: *mut app.App) -> usize {
    let p: usize = applay.vstack(a)
    applay.gap(a, p, CARD_GAP, CARD_GAP)
    return p
}

// a section card: heading, then the rows (a column that keeps 10 pt between its rows)
fn card(a: *mut app.App, heading: str) -> usize {
    let c: usize = applay.vstack(a)
    cls(a, c, K_SET_CARD)
    applay.pad(a, c, CARD_PAD_X, CARD_PAD_Y, CARD_PAD_X, CARD_PAD_Y)
    applay.gap(a, c, ROW_GAP, ROW_GAP)
    if heading.n > 0 {
        let h: usize = app.label(a, heading, 0)
        cls(a, h, K_SET_HEAD)
        applay.align_start(a, h)
    }
    return c
}

// "label ........ value": the label takes the room, the value stands at the right edge. Returns the value node.
fn row(a: *mut app.App, label: str) -> usize {
    applay.hline(a)
    let l: usize = app.label(a, label, 0)
    cls(a, l, K_SET_LABEL)
    applay.grow(a, l, 1)
    let v: usize = app.label(a, "", 0)
    cls(a, v, K_SET_VALUE)
    app.end(a)
    return v
}

// a quiet line over the full width
fn text_row(a: *mut app.App, text: str) -> usize {
    let h: usize = app.label(a, text, 0)
    cls(a, h, K_SET_HINT)
    return h
}

// a wrapping line of chips from the left
fn chip_row(a: *mut app.App) -> usize {
    return applay.hrow(a)
}

// the wide accent button
fn primary(a: *mut app.App, text: str, cb: fn(*mut app.App)) -> usize {
    let b: usize = app.button(a, text, cb)
    cls(a, b, K_PRIMARY)
    applay.stretch(a, b)
    return b
}

// a form field: as wide as its container, form look
fn input(a: *mut app.App, hint: str) -> usize {
    let e: usize = app.entry(a, hint)
    cls(a, e, K_INPUT)
    app.set_width(a, e, 60)
    applay.stretch(a, e)
    return e
}
