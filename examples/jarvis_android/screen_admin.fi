// SPDX-License-Identifier: MPL-2.0
// examples/jarvis_android/screen_admin.fi -- the Admin page (admins only): users, limits, server status, logs.
// The menu entry (Settings > Admin) exists only after GET /api/m/me said admin == true; every /api/m/admin/* call is checked by the
// server again (403 for non-admins), so a hidden button is never the protection. An older server (404) = no admin page.
// Data: jarvisapi.AK_ADM_* answers are rendered to text lines (parse_admin_text) and shown in one list.
import std.rt
import std.time
import fui.app
import fui.vlist
import net.jarvisapi
import jshell
import jtheme
import jlist
import jtexts
import fui.applay

export { screen_admin_build, screen_admin_refresh, admin_api, admin_tick, admin_reset }

const SEC_USERS: usize = 0
const SEC_LIMITS: usize = 1
const SEC_SERVER: usize = 2
const SEC_LOGS: usize = 3
const ME_EVERY_MS: i64 = 300000
const LIVE_EVERY_MS: i64 = 10000

static mut G_LIST: usize = 0
static mut G_STAND: usize = 0
static mut G_LROW: usize = 0
static mut G_SEC: usize = 0
static mut G_TEXT: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }
static mut G_LINES: usize = 0
static mut G_SEEN: u64 = 0
static mut G_VER: u64 = 1
static mut G_NEXT_MS: i64 = 0
static mut G_ME_NEXT_MS: i64 = 0
static mut G_ME_FLIGHT: bool = false
static mut G_SUB: i64 = 0
static mut G_SLOTS: i64 = 0
static mut G_LOOP: bool = false
static mut G_ERR: i64 = 0

fn sec_kind(sec: usize) -> u32 {
    if sec == SEC_USERS { return jarvisapi.AK_ADM_USERS }
    if sec == SEC_LIMITS { return jarvisapi.AK_ADM_LIMITS }
    if sec == SEC_SERVER { return jarvisapi.AK_ADM_SERVER }
    return jarvisapi.AK_ADM_LOGS
}

fn sec_path(sec: usize) -> str {
    if sec == SEC_USERS { return "/api/m/admin/users" }
    if sec == SEC_LIMITS { return "/api/m/admin/limits" }
    if sec == SEC_SERVER { return "/api/m/admin/server" }
    return "/api/m/admin/logs?lines=80"
}

// one request for the shown section (the answer comes to admin_api)
fn ask() {
    G_NEXT_MS = time.now_unix_ms() + LIVE_EVERY_MS
    let ok: bool = jarvisapi.ja_get_abs(jshell.api(), sec_kind(G_SEC), sec_path(G_SEC), "")
}

fn select(sec: usize) {
    G_SEC = sec
    rt.buf_clear(&G_TEXT)
    G_LINES = 0
    G_ERR = 0
    G_VER = G_VER + 1
    ask()
}

fn on_users(a: *mut app.App) { select(SEC_USERS) }
fn on_limits(a: *mut app.App) { select(SEC_LIMITS) }
fn on_server(a: *mut app.App) { select(SEC_SERVER) }
fn on_logs(a: *mut app.App) { select(SEC_LOGS) }
fn on_reload(a: *mut app.App) { ask() }

fn on_sub_dec(a: *mut app.App) { if G_SUB > 1 { let ok: bool = jarvisapi.ja_admin_limit_set(jshell.api(), "maxSubworkers", G_SUB - 1) } }
fn on_sub_inc(a: *mut app.App) { if G_SUB < 50 { let ok: bool = jarvisapi.ja_admin_limit_set(jshell.api(), "maxSubworkers", G_SUB + 1) } }
fn on_slot_dec(a: *mut app.App) { if G_SLOTS > 1 { let ok: bool = jarvisapi.ja_admin_limit_set(jshell.api(), "heavySlots", G_SLOTS - 1) } }
fn on_slot_inc(a: *mut app.App) { if G_SLOTS < 64 { let ok: bool = jarvisapi.ja_admin_limit_set(jshell.api(), "heavySlots", G_SLOTS + 1) } }
fn on_loop(a: *mut app.App) {
    var v: i64 = 1
    if G_LOOP { v = 0 }
    let ok: bool = jarvisapi.ja_admin_limit_set(jshell.api(), "autoLoop", v)
}

// the i-th text line (start offset and length); false = no such line
fn line_at(i: usize, start: *mut usize, len: *mut usize) -> bool {
    var k: usize = 0
    var pos: usize = 0
    while pos < G_TEXT.len {
        var e: usize = pos
        while e < G_TEXT.len && rt.ld8(G_TEXT.ptr as u64, e) != 10 as u8 { e = e + 1 }
        if k == i {
            *start = pos
            *len = e - pos
            return true
        }
        k = k + 1
        pos = e + 1
    }
    return false
}

fn rows(ud: u64, i: usize, out: *mut vlist.VRow) {
    var st: usize = 0
    var ln: usize = 0
    if !line_at(i, &st, &ln) { return }
    jlist.put(out, str { p: (G_TEXT.ptr as u64 + st as u64) as *mut u8, n: ln })
    vlist.vrow_sub(out, " ")
}

fn count_lines() -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < G_TEXT.len {
        if rt.ld8(G_TEXT.ptr as u64, i) == 10 as u8 { n = n + 1 }
        i = i + 1
    }
    return n
}

fn screen_admin_build(a: *mut app.App) {
    let ttl: usize = app.label(a, jtexts.t("adm.title"), 0)
    jtheme.style_node(a, ttl, jtheme.K_TITLE)
    applay.align_start(a, ttl)
    G_STAND = app.label(a, jtexts.t("ls.loading"), 11)
    applay.align_start(a, G_STAND)
    jtheme.style_node(a, G_STAND, jtheme.K_DIM)
    applay.hrow(a)
    jtheme.style_node(a, app.button(a, jtexts.t("adm.users"), on_users), jtheme.K_CHIP)
    jtheme.style_node(a, app.button(a, jtexts.t("adm.limits"), on_limits), jtheme.K_CHIP)
    jtheme.style_node(a, app.button(a, jtexts.t("adm.server"), on_server), jtheme.K_CHIP)
    jtheme.style_node(a, app.button(a, jtexts.t("adm.logs"), on_logs), jtheme.K_CHIP)
    app.end(a)
    G_LROW = applay.vstack(a)
    applay.gap(a, G_LROW, 4, 4)
    applay.hrow(a)
    jtheme.style_node(a, app.button(a, jtexts.t("adm.sub") + " -", on_sub_dec), jtheme.K_CHIP)
    jtheme.style_node(a, app.button(a, jtexts.t("adm.sub") + " +", on_sub_inc), jtheme.K_CHIP)
    app.end(a)
    applay.hrow(a)
    jtheme.style_node(a, app.button(a, jtexts.t("adm.slots") + " -", on_slot_dec), jtheme.K_CHIP)
    jtheme.style_node(a, app.button(a, jtexts.t("adm.slots") + " +", on_slot_inc), jtheme.K_CHIP)
    jtheme.style_node(a, app.button(a, jtexts.t("adm.loop"), on_loop), jtheme.K_CHIP)
    app.end(a)
    app.end(a)
    G_LIST = app.vlist_new(a, "Admin", 340, 120, 0, rows, 0)
    jtheme.style_node(a, G_LIST, jtheme.K_PLAIN)
    applay.stretch(a, G_LIST)
    app.vlist_set_row_pt(a, G_LIST, jlist.CARD_PT / 2)
    jlist.fit_pt(a, G_LIST, 0, 1, 8, jlist.CARD_PT / 2)
    jlist.flex_list(a, G_LIST, 60)
    jlist.pull_add(G_LIST, on_reload)
    jlist.pull_install(a)
    applay.hrow(a)
    jtheme.style_node(a, app.button(a, jtexts.t("ls.reload"), on_reload), jtheme.K_CHIP)
    app.end(a)
}

fn screen_admin_refresh(a: *mut app.App) {
    // not (or no longer) an admin: leave the page, nothing to show
    if !jshell.is_admin() {
        jshell.request_tab(jshell.TAB_CHAT)
        return
    }
    if time.now_unix_ms() >= G_NEXT_MS && (G_SEC == SEC_SERVER || G_SEC == SEC_LOGS || G_LINES == 0) { ask() }
    jshell.set_shown(a, G_LROW, G_SEC == SEC_LIMITS, 0)
    if G_VER != G_SEEN {
        G_SEEN = G_VER
        G_LINES = count_lines()
        app.vlist_set_count(a, G_LIST, G_LINES)
        app.vlist_changed(a, G_LIST)
        jlist.fit_pt(a, G_LIST, G_LINES, 1, 8, jlist.CARD_PT / 2)
        app.vlist_set_row_pt(a, G_LIST, jlist.CARD_PT / 2)
        jshell.set_shown_list(a, G_LIST, G_LINES > 0)
        if G_ERR == 403 {
            app.set_text(a, G_STAND, jtexts.t("adm.denied"))
        } else if G_ERR != 0 {
            app.set_text(a, G_STAND, jtexts.t("adm.failed") + " (" + jshell.dec(G_ERR) + ")")
        } else if G_LINES == 0 {
            app.set_text(a, G_STAND, jtexts.t("ls.loading"))
        } else {
            app.set_text(a, G_STAND, "")
        }
        jshell.set_shown(a, G_STAND, G_LINES == 0 || G_ERR != 0, 0)
    }
}

// true = ours
fn admin_api(x: *mut jarvisapi.Api, kind: u32, status: i64) -> bool {
    if kind == jarvisapi.AK_M_ME {
        G_ME_FLIGHT = false
        if status == 200 {
            jshell.set_admin(jarvisapi.parse_me_admin(jarvisapi.ja_body_ptr(x), jarvisapi.ja_body_len(x)))
            G_ME_NEXT_MS = time.now_unix_ms() + ME_EVERY_MS
        } else if status == 404 || status == 403 {
            jshell.set_admin(false) // an older server: no admin page
            G_ME_NEXT_MS = time.now_unix_ms() + ME_EVERY_MS
        } else {
            G_ME_NEXT_MS = time.now_unix_ms() + 15000 // network trouble: ask again soon, keep the old answer
        }
        return true
    }
    if kind == jarvisapi.AK_ADM_LIMIT_SET {
        if status == 200 { ask() } else { G_ERR = status; G_VER = G_VER + 1 }
        return true
    }
    if kind != jarvisapi.AK_ADM_USERS && kind != jarvisapi.AK_ADM_LIMITS && kind != jarvisapi.AK_ADM_SERVER && kind != jarvisapi.AK_ADM_LOGS { return false }
    if kind != sec_kind(G_SEC) { return true } // the answer of a section that is no longer shown
    if status == 200 {
        var b: rt.Buf = rt.buf_new()
        if jarvisapi.parse_admin_text(kind, jarvisapi.ja_body_ptr(x), jarvisapi.ja_body_len(x), &b) {
            rt.buf_clear(&G_TEXT)
            rt.buf_push_bytes(&G_TEXT, b.ptr as u64, b.len)
            G_ERR = 0
        } else {
            G_ERR = 502
        }
        rt.buf_free(&b)
        if kind == jarvisapi.AK_ADM_LIMITS {
            let ok: bool = jarvisapi.parse_admin_limits(jarvisapi.ja_body_ptr(x), jarvisapi.ja_body_len(x), &G_SUB, &G_SLOTS, &G_LOOP)
        }
    } else {
        G_ERR = status
        if status == 403 { jshell.set_admin(false) }
        rt.buf_clear(&G_TEXT)
    }
    G_VER = G_VER + 1
    return true
}

// every tick while signed in: ask the server who we are (admin or not) now and then
fn admin_tick(signed_in: bool) {
    if !signed_in || G_ME_FLIGHT { return }
    if time.now_unix_ms() < G_ME_NEXT_MS { return }
    G_ME_NEXT_MS = time.now_unix_ms() + 15000
    if jarvisapi.ja_get_abs(jshell.api(), jarvisapi.AK_M_ME, "/api/m/me", "") { G_ME_FLIGHT = true }
}

// sign-out: forget everything (the next account may be a normal user)
fn admin_reset() {
    jshell.set_admin(false)
    G_ME_NEXT_MS = 0
    G_ME_FLIGHT = false
    G_NEXT_MS = 0
    G_SEC = SEC_USERS
    rt.buf_clear(&G_TEXT)
    G_LINES = 0
    G_ERR = 0
    G_VER = G_VER + 1
}
