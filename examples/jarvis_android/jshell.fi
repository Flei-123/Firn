// SPDX-License-Identifier: MPL-2.0
// examples/jarvis_android/jshell.fi -- shared state and helpers of the JARVIS Android app.
//
// THE SCREEN CONTRACT (for the screens other chats fill in, roadmap A5):
//   file     examples/jarvis_android/screen_<name>.fi   (names: chat, leitstand, tasks, devices, settings)
//   build    fn screen_<name>_build(a: *mut app.App)    called ONCE with the page's column open: add widgets with app.*
//   refresh  fn screen_<name>_refresh(a: *mut app.App)  called when the tab is shown and every 2 s while it stays visible
//   shared   jshell.jc() is the JARVIS client (net.jarvisc), jshell.app_ui() the window, jshell.settings() the saved settings.
// A window has 128 nodes and 8 text fields in total (fui.app limits); the shell uses 5 text fields.
import std.rt
import async.loop
import net.jarvisc
import net.jarvisapi
import fui.app
import fui.scene
import fui.flex
import appkit.update
import appkit.config
import window.window
import appkit.stage
import jtheme
import jtokens
import fui.theme
import appkit.log

export {
    mark_once, set_app, app_ui, set_jc, jc, set_api, api, set_loop, loop_of, set_win, win, set_updater, updater, settings, settings_save,
    dec, fill, fill_stretch, set_shown, set_shown_flex, set_shown_list, status_line, status_line2, set_status, request_sidebar, take_sidebar, request_tab, take_tab, cfg_get, cfg_set, theme_mode, set_theme_mode, set_preset, apply_theme, theme_guard,
    request_logout, take_logout, request_dev, take_dev, server_base, set_dev_server, set_base_override, dev_server_set, push_allowed, push_allow, SERVICE, DEFAULT_BASE, SCREEN_PAD, TAB_CHAT, TAB_LEITSTAND, TAB_TASKS, TAB_DEVICES, TAB_SETTINGS, TAB_COUNT, TAB_ADMIN, PAGE_COUNT, is_admin, set_admin, admin_open, font_switched_mark, font_switched_take,
}

const SERVICE: str = "jarvis-android"
const DEFAULT_BASE: str = "https://jarvis.fleitec.com"
const SCREEN_PAD: i64 = 8
const TAB_CHAT: usize = 0
const TAB_LEITSTAND: usize = 1
const TAB_TASKS: usize = 2
const TAB_DEVICES: usize = 3
const TAB_SETTINGS: usize = 4
const TAB_COUNT: usize = 5
const TAB_ADMIN: usize = 5 // a page without a tab-bar button (Settings > Admin; admins only)
const PAGE_COUNT: usize = 6

static mut G_APP: u64 = 0
static mut G_JC: u64 = 0
static mut G_LOOP: u64 = 0
static mut G_API: u64 = 0
static mut G_WIN: u64 = 0
static mut G_UPD: u64 = 0
static mut G_STATUS: usize = 0
static mut G_OVR_P: u64 = 0
static mut G_OVR_N: usize = 0
static mut G_SEEN: [u8; 512] = [0; 512]
static mut G_SEEN_N: usize = 0

// one stage line per name and run (crash diagnosis, jcrash.fi): the second call with the same name does nothing
fn mark_once(name: str) {
    var i: usize = 0
    while i < G_SEEN_N {
        var e: usize = i
        while e < G_SEEN_N && rt.ld8((&G_SEEN[0]) as u64, e) != 10 as u8 { e = e + 1 }
        if e - i == name.n {
            var k: usize = 0
            var same: bool = true
            while k < name.n {
                if rt.ld8((&G_SEEN[0]) as u64, i + k) != rt.ld8(name.p as u64, k) {
                    same = false
                    break
                }
                k = k + 1
            }
            if same { return }
        }
        i = e + 1
    }
    if G_SEEN_N + name.n + 1 <= 512 {
        rt.mem_copy((&G_SEEN[0]) as u64 + G_SEEN_N as u64, name.p as u64, name.n)
        G_SEEN[G_SEEN_N + name.n] = 10 as u8
        G_SEEN_N = G_SEEN_N + name.n + 1
    }
    stage.stage_mark(name)
}

fn set_app(a: *mut app.App) { G_APP = a as u64 }
fn app_ui() -> *mut app.App { return G_APP as *mut app.App }
fn set_jc(c: *mut jarvisc.Jc) { G_JC = c as u64 }
fn jc() -> *mut jarvisc.Jc { return G_JC as *mut jarvisc.Jc }
fn set_api(x: *mut jarvisapi.Api) { G_API = x as u64 }
fn api() -> *mut jarvisapi.Api { return G_API as *mut jarvisapi.Api }
fn set_loop(l: *mut loop.Loop) { G_LOOP = l as u64 }
fn loop_of() -> *mut loop.Loop { return G_LOOP as *mut loop.Loop }
fn set_win(w: u64) { G_WIN = w }
fn win() -> *mut window.Window { return G_WIN as *mut window.Window }
fn set_updater(u: *mut update.Updater) { G_UPD = u as u64 }
fn updater() -> *mut update.Updater { return G_UPD as *mut update.Updater }
fn settings() -> *mut config.Config { return update.update_settings(updater()) }
fn settings_save() { let ok: bool = update.update_save_settings(updater()) }

// the one-line status under the header (connection, thinking, tool name)
fn status_line(id: usize) { G_STATUS = id }
// a second place for the same text (the chat tab shows it in its composer, not in the header: the web chat has no status pill)
static mut G_STATUS2: usize = 0
fn status_line2(id: usize) { G_STATUS2 = id }
// The header pill is one short word (web .pill): a long activity text ("<tool> opened ...") is cut at `max` bytes (never inside a
// UTF-8 sequence) and ends with "...".
const PILL_MAX: usize = 16
fn clip_pill(s: str, max: usize) -> str {
    if s.n <= max { return s }
    var n: usize = max
    while n > 0 && ((*((s.p as u64 + n as u64) as *mut u8)) & 192 as u8) == 128 as u8 { n = n - 1 }
    return (str { p: s.p, n: n }) + "..."
}

fn set_status(s: str) {
    if G_STATUS2 != 0 && G_STATUS2 != app.NONE {
        if s == "online" { app.set_text(app_ui(), G_STATUS2, "") } else { app.set_text(app_ui(), G_STATUS2, s) }
    }
    if G_STATUS != app.NONE {
        app.set_text(app_ui(), G_STATUS, clip_pill(s, PILL_MAX))

        let sc: *mut scene.Scene = app.app_scene(app_ui())
        if s == "online" {
            let r: bool = scene.node_add_class(sc, G_STATUS, jtheme.K_PILL_OK)
        } else {
            let r: bool = scene.node_remove_class(sc, G_STATUS, jtheme.K_PILL_OK)
        }
    }
}

fn dec(v: i64) -> str {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&b, v)
    let s: str = __str_copy(str { p: b.ptr as *mut u8, n: b.len })
    rt.buf_free(&b)
    return s
}

// a node fills the room of its container (width: stretch, height: grow)
fn fill(a: *mut app.App, n: usize) {
    if n == app.NONE { return }
    let sc: *mut scene.Scene = app.app_scene(a)
    scene.node_set_align_self(sc, n, flex.AL_STRETCH)
    scene.node_set_grow(sc, n, 1, 1)
}

// a node is as wide as its container, as high as it needs
fn fill_stretch(a: *mut app.App, n: usize) {
    if n == app.NONE { return }
    scene.node_set_align_self(app.app_scene(a), n, flex.AL_STRETCH)
}

fn cfg_get(key: str, dflt: str) -> str {
    var b: rt.Buf = rt.buf_new()
    let ok: bool = config.get_str(settings(), key, dflt, &b)
    let s: str = __str_copy(str { p: b.ptr as *mut u8, n: b.len })
    rt.buf_free(&b)
    return s
}

fn cfg_set(key: str, v: str) {
    let ok: bool = config.set_str(settings(), key, v)
    settings_save()
}

// ---- the server: ONE fixed address. A person never types it. Order: the start argument (tests: args.txt on Android), the
// developer address (hidden: 7 taps on the logo, Settings > Advanced), DEFAULT_BASE.
fn set_base_override(b: str) {
    let c: str = __str_copy(b)
    G_OVR_P = c.p as u64
    G_OVR_N = c.n
}

fn dev_server_set() -> bool { return cfg_get("dev.server_url", "").n > 0 || G_OVR_N > 0 }

fn server_base() -> str {
    if G_OVR_N > 0 { return str { p: G_OVR_P as *mut u8, n: G_OVR_N } }
    let d: str = cfg_get("dev.server_url", "")
    if d.n > 0 { return d }
    return DEFAULT_BASE
}

// "" = back to the default
fn set_dev_server(u: str) { cfg_set("dev.server_url", u) }

// ---- push permission: the notification dialog of Android comes only after the person saw the short explanation once
fn push_allowed() -> bool { return cfg_get("perm.notif.asked", "") == "1" }
fn push_allow() { cfg_set("perm.notif.asked", "1") }

// a49: the preset of the server theme ("fleitec" | "claude"); stored, applied at once when it changed
fn set_preset(id: str) {
    var want: str = "fleitec"
    if id == "claude" { want = "claude" }
    if cfg_get("ui.preset", "fleitec") == want { return }
    cfg_set("ui.preset", want)
    apply_theme()
}

// "system" | "dark" | "light"
fn theme_mode() -> str { return cfg_get("ui.theme", "dark") }
fn set_theme_mode(m: str) {
    cfg_set("ui.theme", m)
    apply_theme()
}

// the system switch is what the window reports (window.dark); a manual choice wins over it. Without an answer: dark (the web app's look).
fn apply_theme() {
    let m: str = theme_mode()
    var dark: bool = true
    if m == "light" {
        dark = false
    } else if m == "dark" {
        dark = true
    } else if G_WIN != 0 && window.theme_known(win()) {
        dark = window.dark(win())
    }
    jtheme.set_preset(cfg_get("ui.preset", "fleitec"))
    app.set_dark(app_ui(), dark)
    jtheme.apply_colors(app_ui(), dark)
    jtheme.page_bg_apply(app_ui(), dark)
    G_THEME_DARK = dark
    G_THEME_SET = true
    var dark_n: i64 = 0
    if dark { dark_n = 1 }
    let f: *mut theme.Colors = theme.theme_colors(app.app_theme(app_ui()))
    log.log_info("theme", "applied dark=" + dec(dark_n) + " base=" + dec((*f).base as i64) + " accent=" + dec((*f).accent as i64))
}

static mut G_THEME_DARK: bool = true
static mut G_THEME_SET: bool = false
static mut G_THEME_FIXES: i64 = 0

// The window host calls theme_set_dark on every system theme event (Android sends them after start, on resume and on a
// configuration change). That rebuilds the stock grey set and throws the web palette away (r136). Cheap compare, 100 ms:
// if the base colour is not ours any more, write the palette again.
fn theme_guard() {
    if !G_THEME_SET { return }
    let f: *mut theme.Colors = theme.theme_colors(app.app_theme(app_ui()))
    var want: u32 = jtokens.L_BG
    if G_THEME_DARK { want = jtheme.dark_base() }
    if (*f).base == want { return }
    G_THEME_FIXES = G_THEME_FIXES + 1
    log.log_info("theme", "palette was reset by the host (base=" + dec((*f).base as i64) + "), writing it again, fix " + dec(G_THEME_FIXES))
    jtheme.apply_colors(app_ui(), G_THEME_DARK)
}

// ---- sign-out request: the settings tab sets it, main.fi's tick acts on it (it owns the pages)
static mut G_LOGOUT: bool = false
fn request_logout() { G_LOGOUT = true }
fn take_logout() -> bool {
    let r: bool = G_LOGOUT
    G_LOGOUT = false
    return r
}

// the hamburger of the chat header asks main.fi to open the chat list; the sliders icon asks for a tab (Settings)
static mut G_SIDEBAR: bool = false
fn request_sidebar() { G_SIDEBAR = true }
fn take_sidebar() -> bool {
    let r: bool = G_SIDEBAR
    G_SIDEBAR = false
    return r
}
static mut G_TAB_REQ: i64 = -1
fn request_tab(i: usize) { G_TAB_REQ = i as i64 }
fn take_tab() -> i64 {
    let r: i64 = G_TAB_REQ
    G_TAB_REQ = -1
    return r
}

// Settings > Advanced: sign out and open the developer panel of the sign-in page
static mut G_DEV: bool = false
fn request_dev() { G_DEV = true }
fn take_dev() -> bool {
    let r: bool = G_DEV
    G_DEV = false
    return r
}

// Show or remove a node. fUi's `hidden` is CSS visibility (the node still takes room), so a removed node also gets a main
// size limit of 1 px and no growth; shown again it grows like `fill` (grow 1) or not (grow 0).
fn set_shown(a: *mut app.App, n: usize, shown: bool, grow: i64) {
    if n == app.NONE { return }
    let sc: *mut scene.Scene = app.app_scene(a)
    scene.node_set_hidden(sc, n, !shown)
    if shown {
        scene.node_set_flexitem(sc, n, grow, grow, 0, 0)
    } else {
        scene.node_set_flexitem(sc, n, 0, 0, 0, 1)
    }
}

// Like set_shown for a node that must GIVE ROOM when the content is higher than the screen (a tab page, the main column): shrink
// 1000 (per mille, 1 = nothing) and a minimum of 1 pt, so the flexbox may squeeze it below its measured height. Without this a
// page with many cards pushed the tab bar out of the window (a42).
fn set_shown_flex(a: *mut app.App, n: usize, shown: bool) {
    if n == app.NONE { return }
    let sc: *mut scene.Scene = app.app_scene(a)
    scene.node_set_hidden(sc, n, !shown)
    if shown {
        scene.node_set_flexitem(sc, n, 1000, 1000, 1, 0)
    } else {
        scene.node_set_flexitem(sc, n, 0, 0, 0, 1)
    }
}

// Show or remove a LIST card: it keeps its own height but may be squeezed (shrink 1000) down to 60 pt, so the page never grows over
// the tab bar; the list scrolls inside its card.
fn set_shown_list(a: *mut app.App, n: usize, shown: bool) {
    if n == app.NONE { return }
    let sc: *mut scene.Scene = app.app_scene(a)
    scene.node_set_hidden(sc, n, !shown)
    if shown {
        scene.node_set_flexitem(sc, n, 0, 1000, 60, 0)
    } else {
        scene.node_set_flexitem(sc, n, 0, 0, 0, 1)
    }
}

// ---- Admin: the server tells (GET /api/m/me -> admin); the menu entry exists only for admins. The server checks every /api/m/admin/* call again (403).
static mut G_ADMIN: bool = false
fn is_admin() -> bool { return G_ADMIN }
fn set_admin(on: bool) { G_ADMIN = on }
fn admin_open() { if G_ADMIN { request_tab(TAB_ADMIN) } }

// a65: the text face changed live (jfont): views with cached line layout (chat markdown) must lay out again, else the stale
// word widths cut the last letter of words drawn with the new face.
static mut G_FONT_SWITCHED: bool = false

fn font_switched_mark() {
    G_FONT_SWITCHED = true
}

fn font_switched_take() -> bool {
    let f: bool = G_FONT_SWITCHED
    G_FONT_SWITCHED = false
    return f
}
