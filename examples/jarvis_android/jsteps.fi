fn hidden(name: str) -> bool {
    return name == "ToolSearch" || name == "ask_user" || name == "say"
}

// a new pending group; the thoughts in front of the first tool call (PT_N) belong to it. `tool` = it comes with a tool / folded text (the turn has a group)
fn open_group_x(tool: bool) {
    if PEND != 999999 { return }
    if G_N >= MAXG { return }
    G_FIRST[G_N] = S_N - PT_N
    G_CNT[G_N] = PT_N
    G_OPEN[G_N] = 0
    PT_N = 0
    PEND = G_N
    G_N = G_N + 1
    if tool { TURN_GRP = true }
}

fn open_group() { open_group_x(true) }

// one new step in the pending group; returns its index or 999999 (full / hidden)
fn add_step(name: str, arg: str, tid: str) -> usize {
    if hidden(name) || S_N >= MAXS { return 999999 }
    open_group()
    if PEND == 999999 { return 999999 }
    let i: usize = S_N
    S_N = S_N + 1
    S_NAME_O[i] = pool_add(name)
    S_NAME_N[i] = name.n
    var an: usize = arg.n
    if an > ARG_CAP { an = ARG_CAP }
    S_ARG_O[i] = pool_add(str { p: arg.p, n: an })
    S_ARG_N[i] = an
    S_TID_O[i] = pool_add(tid)
    S_TID_N[i] = tid.n
    S_RES_O[i] = 0
    S_RES_N[i] = 0
    S_ST[i] = 0 as u8
    S_FULL[i] = 0 as u8
    S_DET[i] = 0 as u8
    S_CUT[i] = 0 - 1
    S_SECS[i] = 0
    G_CNT[PEND] = G_CNT[PEND] + 1
    return i
}

fn set_result(i: usize, text: str, ok: i64) {
    var n: usize = text.n
    var cut: bool = false
    if n > RES_CAP {
        n = RES_CAP
        while n > 0 && (rt.ld8(text.p as u64, n) & 192 as u8) == 128 as u8 { n = n - 1 }
        cut = true
    }
    S_RES_O[i] = pool_add(str { p: text.p, n: n })
    S_RES_N[i] = n
    if cut {
        let m: str = "\n..."
        rt.buf_push_bytes(&POOL, m.p as u64, m.n)
        S_RES_N[i] = n + m.n
    }
    if ok == 0 { S_ST[i] = 2 as u8 } else { S_ST[i] = 1 as u8 }
}

fn new_turn() { TURN_GRP = false }

fn turn_has_group() -> bool { return TURN_GRP }

// text of the AI between two tool calls: goes into the pending group as a dim line block (web: .folded-text); blank text is dropped
fn add_text(text: str) {
    var a: usize = 0
    var e: usize = text.n
    while a < e && (rt.ld8(text.p as u64, a) == 32 as u8 || rt.ld8(text.p as u64, a) == 10 as u8 || rt.ld8(text.p as u64, a) == 13 as u8 || rt.ld8(text.p as u64, a) == 9 as u8) { a = a + 1 }
    while e > a && (rt.ld8(text.p as u64, e - 1) == 32 as u8 || rt.ld8(text.p as u64, e - 1) == 10 as u8 || rt.ld8(text.p as u64, e - 1) == 13 as u8 || rt.ld8(text.p as u64, e - 1) == 9 as u8) { e = e - 1 }
    if e <= a || S_N >= MAXS { return }
    open_group()
    if PEND == 999999 { return }
    var n: usize = e - a
    if n > TEXT_CAP {
        n = TEXT_CAP
        while n > 0 && (rt.ld8(text.p as u64, a + n) & 192 as u8) == 128 as u8 { n = n - 1 }
    }
    let i: usize = S_N
    S_N = S_N + 1
    S_NAME_O[i] = 0
    S_NAME_N[i] = 0
    S_ARG_O[i] = 0
    S_ARG_N[i] = 0
    S_TID_O[i] = 0
    S_TID_N[i] = 0
    S_RES_O[i] = pool_add(str { p: ((text.p as u64) + a as u64) as *mut u8, n: n })
    S_RES_N[i] = n
    S_ST[i] = 4 as u8
    S_FULL[i] = 0 as u8
    S_DET[i] = 0 as u8
    S_CUT[i] = 0 - 1
    S_SECS[i] = 0
    G_CNT[PEND] = G_CNT[PEND] + 1
}

// live: a tool call started (JE_TOOL)
fn tool_start(name: str, arg: str, tid: str) {
    let i: usize = add_step(name, arg, tid)
}

// live: its output arrived (JE_TOOL_RESULT; ok 1 / 0). Matched by call id, newest first.
fn tool_result(tid: str, text: str, ok: i64) {
    if tid.n == 0 { return }
    var k: usize = S_N
    var seen: usize = 0
    while k > 0 && seen < 96 {
        k = k - 1
        seen = seen + 1
        if S_TID_N[k] == tid.n && S_ST[k] == 0 as u8 && rt.mem_eq(((POOL.ptr as u64) + S_TID_O[k] as u64), tid.p as u64, tid.n) {
            set_result(k, text, ok)
            return
        }
    }
}

// history: a finished step (ok 1 / 0, 2 = no output stored)
fn hist_tool(name: str, arg: str, text: str, ok: i64, cut: i64) {
    let i: usize = add_step(name, arg, "")
    if i == 999999 { return }
    if arg.n == 0 { S_CUT[i] = cut }
    if ok == 2 {
        S_ST[i] = 3 as u8
    } else {
        set_result(i, text, ok)
    }
}


// ---- thoughts (web: .think-block). Before the first tool call of a turn they wait in PT_N (no group yet; the first tool adopts them, so
// the group lands UNDER the leading text); after it they go straight into the pending group.

// a step for a thought, in the group (the turn has tool steps) or in front of the first group (PT_N)
fn add_thought_step() -> usize {
    if S_N >= MAXS { return 999999 }
    var grp: bool = TURN_GRP || PEND != 999999
    if grp {
        open_group_x(true)
        if PEND == 999999 { return 999999 }
    }
    let i: usize = S_N
    S_N = S_N + 1
    S_NAME_O[i] = 0
    S_NAME_N[i] = 0
    S_ARG_O[i] = 0
    S_ARG_N[i] = 0
    S_TID_O[i] = 0
    S_TID_N[i] = 0
    S_RES_O[i] = 0
    S_RES_N[i] = 0
    S_ST[i] = 5 as u8
    S_FULL[i] = 0 as u8
    S_DET[i] = 0 as u8
    S_CUT[i] = 0 - 1
    S_SECS[i] = 0
    if grp { G_CNT[PEND] = G_CNT[PEND] + 1 } else { PT_N = PT_N + 1 }
    return i
}

fn trim_cap(text: str, cap: usize) -> str {
    var a: usize = 0
    var e: usize = text.n
    while a < e && (rt.ld8(text.p as u64, a) == 32 as u8 || rt.ld8(text.p as u64, a) == 10 as u8 || rt.ld8(text.p as u64, a) == 13 as u8 || rt.ld8(text.p as u64, a) == 9 as u8) { a = a + 1 }
    while e > a && (rt.ld8(text.p as u64, e - 1) == 32 as u8 || rt.ld8(text.p as u64, e - 1) == 10 as u8 || rt.ld8(text.p as u64, e - 1) == 13 as u8 || rt.ld8(text.p as u64, e - 1) == 9 as u8) { e = e - 1 }
    var n: usize = e - a
    if n > cap {
        n = cap
        while n > 0 && (rt.ld8(text.p as u64, a + n) & 192 as u8) == 128 as u8 { n = n - 1 }
    }
    return str { p: ((text.p as u64) + a as u64) as *mut u8, n: n }
}

// history: a finished thought (role "thinking"): text + how long it took (genMs)
fn hist_think(text: str, gen_ms: i64) {
    let i: usize = add_thought_step()
    if i == 999999 { return }
    let tx: str = trim_cap(text, TEXT_CAP)
    S_RES_O[i] = pool_add(tx)
    S_RES_N[i] = tx.n
    var secs: i64 = 0
    if gen_ms > 0 { secs = (gen_ms + 500) / 1000 }
    S_SECS[i] = secs
}

// live: a piece of the reasoning (JE_THINKING); `now` = unix ms. The first piece starts the thought.
fn think_live(piece: str, now: i64) {
    if LIVE_I == 999999 {
        let i: usize = add_thought_step()
        if i == 999999 { return }
        LIVE_I = i
        LIVE_T0 = now
        rt.buf_clear(&LIVE_TXT)
        S_ST[i] = 6 as u8
        S_DET[i] = 1 as u8
        VG_OPEN = true
    }
    if LIVE_TXT.len < 3 * TEXT_CAP { rt.buf_push_bytes(&LIVE_TXT, piece.p as u64, piece.n) }
}

fn think_running() -> bool { return LIVE_I != 999999 }

// live: the reasoning is over (the answer / a tool call / the end follows): the thought is kept and folded. true = something changed.
fn think_end(now: i64) -> bool {
    if LIVE_I == 999999 { return false }
    let i: usize = LIVE_I
    LIVE_I = 999999
    let tx: str = trim_cap(str { p: LIVE_TXT.ptr as *mut u8, n: LIVE_TXT.len }, TEXT_CAP)
    S_RES_O[i] = pool_add(tx)
    S_RES_N[i] = tx.n
    var secs: i64 = (now - LIVE_T0 + 500) / 1000
    if secs < 0 { secs = 0 }
    S_SECS[i] = secs
    S_ST[i] = 5 as u8
    S_DET[i] = 0 as u8
    rt.buf_clear(&LIVE_TXT)
    VG_OPEN = false
    return true
}

// web keepBotVisible(): text between two tool calls that stays a visible answer (a question, several lines, a list / heading / code / table,
// or longer than 200 characters); a short transition line ("I look at the commits:") is folded into the steps instead
fn keep_visible(text: str) -> bool {
    let t: str = trim_cap(text, 100000000)
    if t.n == 0 { return false }
    let b: u64 = t.p as u64
    var lines: usize = 0
    var chars: usize = 0
    var ls: bool = true // at the start of a line (blanks skipped)
    var i: usize = 0
    var line_has: bool = false
    while i < t.n {
        let c: u8 = rt.ld8(b, i)
        if (c & 192 as u8) != 128 as u8 { chars = chars + 1 }
        if c == 63 as u8 { return true } // ?
        if c == 239 as u8 && i + 2 < t.n && rt.ld8(b, i + 1) == 188 as u8 && rt.ld8(b, i + 2) == 159 as u8 { return true } // fullwidth ?
        if c == 10 as u8 {
            if line_has { lines = lines + 1 }
            line_has = false
            ls = true
        } else if c == 32 as u8 || c == 9 as u8 || c == 13 as u8 {
            // blanks do not start a line
        } else {
            line_has = true
            if ls {
                ls = false
                var c1: u8 = 0 as u8
                var c2: u8 = 0 as u8
                if i + 1 < t.n { c1 = rt.ld8(b, i + 1) }
                if i + 2 < t.n { c2 = rt.ld8(b, i + 2) }
                if (c == 45 as u8 || c == 42 as u8 || c == 43 as u8 || c == 62 as u8) && (c1 == 32 as u8 || c1 == 9 as u8) { return true } // - * + > then a blank
                if c == 124 as u8 { return true } // |
                if c == 96 as u8 && c1 == 96 as u8 && c2 == 96 as u8 { return true } // ```
                if c == 35 as u8 {
                    var h: usize = 0
                    while i + h < t.n && rt.ld8(b, i + h) == 35 as u8 { h = h + 1 }
                    if h <= 6 && i + h < t.n && (rt.ld8(b, i + h) == 32 as u8 || rt.ld8(b, i + h) == 9 as u8) { return true }
                }
                if c >= 48 as u8 && c <= 57 as u8 {
                    var d: usize = 0
                    while i + d < t.n && rt.ld8(b, i + d) >= 48 as u8 && rt.ld8(b, i + d) <= 57 as u8 { d = d + 1 }
                    if i + d + 1 < t.n && (rt.ld8(b, i + d) == 46 as u8 || rt.ld8(b, i + d) == 41 as u8) && (rt.ld8(b, i + d + 1) == 32 as u8 || rt.ld8(b, i + d + 1) == 9 as u8) { return true }
                }
            }
        }
        i = i + 1
    }
    if line_has { lines = lines + 1 }
    if lines >= 2 { return true }
    return chars > 200
}

// a tapped step with a cut input: the __cut index to fetch (jarvisc.jc_input), or -1; asked once
fn take_fetch() -> i64 {
    let v: i64 = FETCH
    FETCH = 0 - 1
    return v
}

// the full input arrived (JE_INPUT): the short argument of every step cut at `n`
fn set_cut_arg(n: i64, arg: str) {
    var k: usize = 0
    while k < S_N {
        if S_CUT[k] == n {
            S_CUT[k] = 0 - 1
            var an: usize = arg.n
            if an > ARG_CAP { an = ARG_CAP }
            S_ARG_O[k] = pool_add(str { p: arg.p, n: an })
            S_ARG_N[k] = an
        }
        k = k + 1
    }
}

// the pending group becomes a placeholder in `buf` at byte `pos` (everything behind moves up). The thoughts of a turn without a tool call
// (waiting in PT_N) become a group of their own, but only when `all`.
fn flush_x(buf: *mut rt.Buf, pos: usize, all: bool) {
    if PEND == 999999 && all && PT_N > 0 && LIVE_I == 999999 { open_group_x(false) }
    if PEND == 999999 { return }
    let g: usize = PEND
    PEND = 999999
    var at: usize = pos
    if at > (*buf).len { at = (*buf).len }
    var tail: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&tail, ((*buf).ptr as u64) + at as u64, (*buf).len - at)
    (*buf).len = at
    if at > 0 { put(buf, "\n\n") }
    rt.buf_push(buf, 2 as u8)
    rt.buf_push_dec_i64(buf, g as i64)
    rt.buf_push(buf, 3 as u8)
    put(buf, "\n\n")
    rt.buf_push_bytes(buf, tail.ptr as u64, tail.len)
    rt.buf_free(&tail)
}

fn flush_at(buf: *mut rt.Buf, pos: usize) { flush_x(buf, pos, true) }

fn flush(buf: *mut rt.Buf) { flush_x(buf, (*buf).len, true) }

// only the group of tool steps (a text that stays visible between two tool calls); thoughts before the first tool call wait for it
fn flush_group_at(buf: *mut rt.Buf, pos: usize) { flush_x(buf, pos, false) }

// ---- rendering

// markdown-safe copy of `n` bytes, at most `cap` of them (cut at a character border): control characters and line breaks
// become blanks, characters that would start markdown get a backslash
fn put_esc(b: *mut rt.Buf, p: u64, n: usize, cap: usize) {
    var m: usize = n
    var cut: bool = false
    if m > cap {
        m = cap
        while m > 0 && (rt.ld8(p, m) & 192 as u8) == 128 as u8 { m = m - 1 }
        cut = true
    }
    var i: usize = 0
    while i < m {
        var c: u8 = rt.ld8(p, i)
        if c < 32 as u8 { c = 32 as u8 }
        if c == 92 as u8 || c == 96 as u8 || c == 42 as u8 || c == 95 as u8 || c == 91 as u8 || c == 93 as u8 || c == 60 as u8 || c == 62 as u8 || c == 35 as u8 || c == 124 as u8 || c == 126 as u8 || c == 38 as u8 || c == 33 as u8 {
            rt.buf_push(b, 92 as u8)
        }
        rt.buf_push(b, c)
        i = i + 1
    }
    if cut { put(b, "...") }
}

fn put_clean(b: *mut rt.Buf, p: u64, n: usize) {
    // backticks would end the fence; control characters are dropped
    var i: usize = 0
    while i < n {
        var c: u8 = rt.ld8(p, i)
        if c == 96 as u8 { c = 39 as u8 }
        if c == 13 as u8 { i = i + 1 }
        else if c < 32 as u8 && c != 10 as u8 && c != 9 as u8 { i = i + 1 }
        else {
            rt.buf_push(b, c)
            i = i + 1
        }
    }
}

// one tool row: [Tool name](chip:<i>) (err:<i> = a failed call, drawn red); the view paints the wrench in front. A tap shows / hides its detail
// (the argument + the output, like the web's tool detail). `last` = ends the line with a hard break so the rows stack tight (web: .tool rows).
fn render_chip(out: *mut rt.Buf, i: usize, tight: bool) {
    put(out, "[")
    let nm: str = label(pool_str(S_NAME_O[i], S_NAME_N[i]))
    put_esc(out, nm.p as u64, nm.n, 80)
    if S_ST[i] == 2 as u8 { put(out, "](err:") } else { put(out, "](chip:") }
    rt.buf_push_dec_i64(out, i as i64)
    put(out, ")")
    if S_ST[i] == 0 as u8 { put(out, " ...") }
    if tight { put(out, "  \n") } else { put(out, "\n\n") }
}

// the argument of a step as a code block (shown with the detail)
fn render_arg(out: *mut rt.Buf, i: usize) {
    if S_ARG_N[i] == 0 { return }
    put(out, "`````\n")
    put_clean(out, (POOL.ptr as u64) + S_ARG_O[i] as u64, S_ARG_N[i])
    put(out, "\n`````\n\n")
}

// the output of a step as a code block (at most LINES lines, LINES_FULL after "more")
fn render_out(out: *mut rt.Buf, i: usize) {
    if S_ST[i] == 0 as u8 { return }
    if S_RES_N[i] == 0 { return }
    var lim: usize = LINES
    if S_FULL[i] != 0 as u8 { lim = LINES_FULL }
    let base: u64 = (POOL.ptr as u64) + S_RES_O[i] as u64
    let n: usize = S_RES_N[i]
    var k: usize = 0
    var lines: usize = 0
    var end: usize = n
    var total: usize = 0
    // count the lines, find the byte where line `lim` ends
    while k < n {
        if rt.ld8(base, k) == 10 as u8 {
            lines = lines + 1
            if lines == lim && end == n { end = k }
        }
        k = k + 1
    }
    total = lines + 1
    if n > 0 && rt.ld8(base, n - 1) == 10 as u8 { total = lines }
    while end > 0 && (rt.ld8(base, end - 1) == 10 as u8 || rt.ld8(base, end - 1) == 13 as u8) { end = end - 1 }
    put(out, "`````\n")
    put_clean(out, base, end)
    put(out, "\n`````\n\n")
    if total > lim {
        put(out, "[... ")
        rt.buf_push_dec_i64(out, (total - lim) as i64)
        put(out, " weitere Zeilen](more:") // english: ok
        rt.buf_push_dec_i64(out, i as i64)
        put(out, ")\n\n")
    } else if S_FULL[i] != 0 as u8 && total > LINES {
        put(out, "[weniger](more:") // english: ok
        rt.buf_push_dec_i64(out, i as i64)
        put(out, ")\n\n")
    }
}

// `tmp` as a rail block quote (markdownview: first child = thematic break = a thin vertical line, dim text), like the web's .tool-group-body
fn emit_rail(out: *mut rt.Buf, tmp: *mut rt.Buf) {
    put(out, "> ***\n>\n")
    let base: u64 = (*tmp).ptr as u64
    let n: usize = (*tmp).len
    var i: usize = 0
    while i < n {
        var e: usize = i
        while e < n && rt.ld8(base, e) != 10 as u8 { e = e + 1 }
        if e > i {
            put(out, "> ")
            rt.buf_push_bytes(out, base + i as u64, e - i)
        } else {
            put(out, ">")
        }
        put(out, "\n")
        i = e + 1
    }
    put(out, "\n")
}

static mut NB: [u8; 24] = [0; 24] // the group size as text (the argument of steps.n)

fn group_label(out: *mut rt.Buf, n: usize) {
    var len: usize = 0
    var m: usize = n
    if m == 0 { NB[0] = 48 as u8
        len = 1 }
    var tmp: [u8; 24] = [0; 24]
    var k: usize = 0
    while m > 0 && k < 20 { tmp[k] = (48 + m % 10) as u8
        k = k + 1
        m = m / 10 }
    while k > 0 { k = k - 1
        NB[len] = tmp[k]
        len = len + 1 }
    if n == 1 {
        put(out, jtexts.t("steps.one"))
    } else {
        put(out, jtexts.t1("steps.n", "n", str { p: (&NB[0]) as *mut u8, n: len }))
    }
}

// the text of a thought as markdown-safe lines (every line break stays one); the rail dims it
fn put_thought(out: *mut rt.Buf, i: usize) {
    var p: u64 = (POOL.ptr as u64) + S_RES_O[i] as u64
    var n: usize = S_RES_N[i]
    if S_ST[i] == 6 as u8 {
        p = LIVE_TXT.ptr as u64
        n = LIVE_TXT.len
        let t: str = trim_cap(str { p: p as *mut u8, n: n }, TEXT_CAP)
        p = t.p as u64
        n = t.n
    }
    var k: usize = 0
    while k < n {
        var c: u8 = rt.ld8(p, k)
        if c == 10 as u8 {
            put(out, "  \n")
        } else if c == 13 as u8 || (c < 32 as u8 && c != 9 as u8) {
            // dropped
        } else {
            if c == 9 as u8 { c = 32 as u8 }
            if c == 92 as u8 || c == 96 as u8 || c == 42 as u8 || c == 95 as u8 || c == 91 as u8 || c == 93 as u8 || c == 60 as u8 || c == 62 as u8 || c == 35 as u8 || c == 124 as u8 || c == 126 as u8 || c == 38 as u8 || c == 33 as u8 {
                rt.buf_push(out, 92 as u8)
            }
            rt.buf_push(out, c)
        }
        k = k + 1
    }
    put(out, "\n\n")
}

// "Nachgedacht · 8s" / "Denkt nach..." (web: .think-lbl)
fn put_think_label(out: *mut rt.Buf, i: usize) {
    if S_ST[i] == 6 as u8 {
        put(out, jtexts.t("think.live"))
        return
    }
    put(out, jtexts.t("think.done"))
    if S_SECS[i] > 0 {
        put(out, " · ")
        rt.buf_push_dec_i64(out, S_SECS[i])
        put(out, "s")
    }
}

// a thought inside a group: the head row (bulb + label + chevron, no pill) and, when open, its text
fn render_thought(out: *mut rt.Buf, i: usize, tight: bool) {
    put(out, "[")
    put_think_label(out, i)
    if S_DET[i] != 0 as u8 { put(out, "](thro:") } else { put(out, "](thr:") }
    rt.buf_push_dec_i64(out, i as i64)
    put(out, ")")
    if S_DET[i] != 0 as u8 {
        put(out, "\n\n")
        put_thought(out, i)
    } else if tight {
        put(out, "  \n")
    } else {
        put(out, "\n\n")
    }
}

fn is_tool_step(i: usize) -> bool { return S_ST[i] != 4 as u8 && S_ST[i] != 5 as u8 && S_ST[i] != 6 as u8 }

fn render_group(out: *mut rt.Buf, g: usize) {
    var f: usize = 0
    var n: usize = 0
    if g == VG {
        n = PT_N
        f = S_N - PT_N
    } else {
        if g >= G_N { return }
        n = G_CNT[g]
        f = G_FIRST[g]
    }
    if n == 0 { return }
    var run: bool = false
    var nt: usize = 0 // thoughts
    var nf: usize = 0 // folded texts
    var nl: usize = 0 // tool steps
    var k: usize = 0
    while k < n {
        if S_ST[f + k] == 0 as u8 { run = true }
        if S_ST[f + k] == 5 as u8 || S_ST[f + k] == 6 as u8 { nt = nt + 1 } else if S_ST[f + k] == 4 as u8 { nf = nf + 1 } else { nl = nl + 1 }
        k = k + 1
    }
    // exactly one tool call: no pill, just its row (web: .tool-group.single)
    if n == 1 && is_tool_step(f) {
        render_chip(out, f, false)
        if S_DET[f] != 0 as u8 {
            render_arg(out, f)
            render_out(out, f)
        }
        return
    }
    // only reasoning (no tool, no folded text): the pill says "Nachgedacht" with a bulb, the open group shows the thoughts without heads
    let only_thought: bool = nl == 0 && nt >= 1 && nf == 0
    var open: bool = G_OPEN[0] != 0 as u8
    if g == VG { open = VG_OPEN } else { open = G_OPEN[g] != 0 as u8 }
    put(out, "[")
    if only_thought {
        if S_ST[f + n - 1] == 6 as u8 { put(out, jtexts.t("think.live")) } else { put(out, jtexts.t("think.done")) }
    } else {
        group_label(out, n)
        if run && g == PEND { put(out, " ...") }
    }
    if only_thought {
        if open { put(out, "](thinko:g") } else { put(out, "](think:g") }
    } else {
        if open { put(out, "](stepo:") } else { put(out, "](step:") }
    }
    rt.buf_push_dec_i64(out, g as i64)
    put(out, ")\n\n")
    if !open { return }
    var tmp: rt.Buf = rt.buf_new()
    k = 0
    while k < n {
        let i: usize = f + k
        if S_ST[i] == 4 as u8 {
            rt.buf_push_bytes(&tmp, (POOL.ptr as u64) + S_RES_O[i] as u64, S_RES_N[i])
            put(&tmp, "\n\n")
        } else if S_ST[i] == 5 as u8 || S_ST[i] == 6 as u8 {
            if only_thought {
                put_thought(&tmp, i)
            } else {
                var tightt: bool = false
                if S_DET[i] == 0 as u8 && k + 1 < n && S_ST[i + 1] != 4 as u8 { tightt = true }
                render_thought(&tmp, i, tightt)
            }
        } else {
            // rows stack tight (hard break) unless a detail block or a text follows
            var tight: bool = false
            if S_DET[i] == 0 as u8 && k + 1 < n && S_ST[i + 1] != 4 as u8 { tight = true }
            render_chip(&tmp, i, tight)
            if S_DET[i] != 0 as u8 {
                render_arg(&tmp, i)
                render_out(&tmp, i)
            }
        }
        k = k + 1
    }
    emit_rail(out, &tmp)
    rt.buf_free(&tmp)
}

// blank line before a group, so its pill never sticks to the text in front
fn sep(out: *mut rt.Buf) {
    if (*out).len == 0 { return }
    if (*out).len >= 2 && rt.ld8((*out).ptr as u64, (*out).len - 1) == 10 as u8 && rt.ld8((*out).ptr as u64, (*out).len - 2) == 10 as u8 { return }
    put(out, "\n\n")
}

// the markdown source of the view: `src` (G_CHAT) with every placeholder expanded and the pending group inserted at `live_at`
fn compose(src: *mut rt.Buf, live_at: usize, out: *mut rt.Buf) {
    rt.buf_clear(out)
    let base: u64 = (*src).ptr as u64
    let n: usize = (*src).len
    var live_done: bool = PEND == 999999 && PT_N == 0
    var live_g: usize = PEND
    if PEND == 999999 { live_g = VG }
    var i: usize = 0
    var from: usize = 0
    while i < n {
        if !live_done && i == live_at {
            rt.buf_push_bytes(out, base + from as u64, i - from)
            from = i
            sep(out)
            render_group(out, live_g)
            live_done = true
        }
        if rt.ld8(base, i) == 2 as u8 {
            rt.buf_push_bytes(out, base + from as u64, i - from)
            var j: usize = i + 1
            var g: usize = 0
            while j < n && rt.ld8(base, j) != 3 as u8 {
                let d: u8 = rt.ld8(base, j)
                if d >= 48 as u8 && d <= 57 as u8 && g < 100000000 { g = g * 10 + (d - 48 as u8) as usize }
                j = j + 1
            }
            sep(out)
            render_group(out, g)
            i = j + 1
            from = i
        } else {
            i = i + 1
        }
    }
    rt.buf_push_bytes(out, base + from as u64, n - from)
    if !live_done {
        sep(out)
        render_group(out, live_g)
    }
}

// a tapped link of the view: true = it was ours (step:<g> toggles a group, chip:/err:<step> shows / hides a step's output,
// more:<step> shows more / fewer lines, thr:<step> a thought, think:g<g> a group of thoughts), re-render
fn on_link(p: u64, n: usize) -> bool {
    var kind: u8 = 0 as u8
    var skip: usize = 5
    if n > 5 && rt.mem_eq(p, "step:".p as u64, 5) { kind = 1 as u8 }
    if n > 6 && rt.mem_eq(p, "stepo:".p as u64, 6) {
        kind = 1 as u8
        skip = 6
    }
    if n > 5 && rt.mem_eq(p, "more:".p as u64, 5) { kind = 2 as u8 }
    if n > 5 && rt.mem_eq(p, "chip:".p as u64, 5) { kind = 3 as u8 }
    if n > 4 && rt.mem_eq(p, "err:".p as u64, 4) {
        kind = 3 as u8
        skip = 4
    }
    if n > 4 && rt.mem_eq(p, "thr:".p as u64, 4) {
        kind = 4 as u8
        skip = 4
    }
    if n > 5 && rt.mem_eq(p, "thro:".p as u64, 5) {
        kind = 4 as u8
        skip = 5
    }
    if n > 7 && rt.mem_eq(p, "think:g".p as u64, 7) {
        kind = 1 as u8
        skip = 7
    }
    if n > 8 && rt.mem_eq(p, "thinko:g".p as u64, 8) {
        kind = 1 as u8
        skip = 8
    }
    if kind == 0 as u8 { return false }
    var v: usize = 0
    var i: usize = skip
    while i < n {
        let d: u8 = rt.ld8(p, i)
        if d >= 48 as u8 && d <= 57 as u8 && v < 100000000 { v = v * 10 + (d - 48 as u8) as usize }
        i = i + 1
    }
    if kind == 1 as u8 {
        if v == VG {
            VG_OPEN = !VG_OPEN
            return true
        }
        if v >= G_N { return false }
        if G_OPEN[v] == 0 as u8 { G_OPEN[v] = 1 as u8 } else { G_OPEN[v] = 0 as u8 }
        return true
    }
    if v >= S_N { return false }
    if kind == 3 as u8 || kind == 4 as u8 {
        if S_DET[v] == 0 as u8 {
            S_DET[v] = 1 as u8
            // a cut input is fetched when the detail opens (web: showToolDetail loads /input/<n>)
            if kind == 3 as u8 && S_CUT[v] >= 0 && S_ARG_N[v] == 0 { FETCH = S_CUT[v] }
        } else {
            S_DET[v] = 0 as u8
        }
        return true
    }
    if S_FULL[v] == 0 as u8 { S_FULL[v] = 1 as u8 } else { S_FULL[v] = 0 as u8 }
    return true
}
