// SPDX-License-Identifier: MPL-2.0
// examples/jarvis_android/jsteps.fi -- the collapsible TOOL STEPS under an answer (web: .tool-group, "N Schritte" + one row per call).
// The chat is ONE markdown view (screen_chat.fi, G_CHAT). A step group sits in G_CHAT as a placeholder  (byte 2) <group> (byte 3)  and is
// expanded only when the view's source is composed (compose): collapsed = one link line "> 3 Schritte" (target step:<g>),
// open = "v 3 Schritte" + per step "**Tool name** `short argument`" + the output as a code block (monospace, cut to LINES lines,
// "... N more lines" = link more:<step> shows more). A failed call gets a red "error" word (link target err:, drawn in the
// error colour by fui.markdownview). The open/closed state lives HERE per group, so a re-render never resets it.
// LIVE: JE_TOOL starts a step in the pending group, JE_TOOL_RESULT fills it; the pending group is shown at the start of the
// answer being streamed (compose gets that byte position) and becomes a placeholder in G_CHAT when the answer is done (flush).
// HISTORY: JE_HIST_TOOL steps collect into the pending group, flush puts it in front of the next message.
// Hidden like in the web app: ToolSearch, ask_user, say. Text is German, like the web app (labels = public/i18n.js tool.*).
import std.rt
import jtexts

export { room, reset, tool_start, tool_result, hist_tool, add_text, new_turn, turn_has_group, flush, flush_at, flush_group_at, compose, on_link, has_pending, hidden, keep_visible, hist_think, think_live, think_end, think_running, take_fetch, set_cut_arg }

const MAXS: usize = 4096 // steps kept (more are dropped)
const MAXG: usize = 1024 // groups kept
const RES_CAP: usize = 6000 // bytes of one output kept
const LINES: usize = 10 // output lines shown while a step is "short"
const LINES_FULL: usize = 80 // ... after "more"
const ARG_CAP: usize = 160
const TEXT_CAP: usize = 6000 // bytes of one folded text kept

static mut POOL: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }
static mut S_N: usize = 0
static mut S_NAME_O: [usize; 4096] = [0; 4096]
static mut S_NAME_N: [usize; 4096] = [0; 4096]
static mut S_ARG_O: [usize; 4096] = [0; 4096]
static mut S_ARG_N: [usize; 4096] = [0; 4096]
static mut S_RES_O: [usize; 4096] = [0; 4096]
static mut S_RES_N: [usize; 4096] = [0; 4096]
static mut S_TID_O: [usize; 4096] = [0; 4096]
static mut S_TID_N: [usize; 4096] = [0; 4096]
static mut S_ST: [u8; 4096] = [0; 4096] // 0 running (no result yet), 1 ok, 2 failed, 3 done without stored output, 4 = folded text of the AI between two tool calls (its text is in RES)
static mut S_FULL: [u8; 4096] = [0; 4096]
static mut S_DET: [u8; 4096] = [0; 4096] // the output of the step is shown (tap on its pill); a thought: its text is shown
static mut S_CUT: [i64; 4096] = [0; 4096] // the history sent the input only as {__cut: n} (n >= 0): fetched when the detail is opened; -1 = whole / fetched
static mut S_SECS: [i64; 4096] = [0; 4096] // a thought: how many seconds it took
static mut G_N: usize = 0
static mut G_FIRST: [usize; 1024] = [0; 1024]
static mut G_CNT: [usize; 1024] = [0; 1024]
static mut G_OPEN: [u8; 1024] = [0; 1024]
static mut PEND: usize = 999999 // the group being filled (none = 999999)
static mut TURN_GRP: bool = false // the answer being streamed already has a group (its later text is folded into the steps)
static mut PT_N: usize = 0 // thoughts of the turn BEFORE its first tool call: steps at the end of S_*, in no group yet (web: pendingThinks); the first tool adopts them
static mut VG_OPEN: bool = false // the live "Denkt nach" pill (the pending thoughts as a virtual group) is open
static mut LIVE_I: usize = 999999 // the thought being streamed (S_ST 6), none = 999999
static mut LIVE_T0: i64 = 0
static mut LIVE_TXT: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }
static mut FETCH: i64 = 0 - 1 // a tapped step with a cut input: the __cut index the screen has to fetch (take_fetch)
const VG: usize = 1024 // the group id of the virtual live group

fn put(b: *mut rt.Buf, s: str) { rt.buf_push_bytes(b, s.p as u64, s.n) }

fn pool_add(s: str) -> usize {
    let o: usize = POOL.len
    rt.buf_push_bytes(&POOL, s.p as u64, s.n)
    return o
}

fn pool_str(o: usize, n: usize) -> str { return str { p: ((POOL.ptr as u64) + o as u64) as *mut u8, n: n } }

// forget everything (a new chat is opened / the view is cleared)
fn reset() {
    rt.buf_clear(&POOL)
    S_N = 0
    G_N = 0
    PEND = 999999
    TURN_GRP = false
    PT_N = 0
    LIVE_I = 999999
    FETCH = 0 - 1
    rt.buf_clear(&LIVE_TXT)
}

fn has_pending() -> bool { return PEND != 999999 || PT_N > 0 }

// a64: room for another page of history (steps / groups kept are capped)
fn room() -> bool { return S_N + 300 < MAXS && G_N + 40 < MAXG }

