# examples/jarvis_android/locale/en.opmsg -- texts of the JARVIS app in English (login, permissions, tabs).
@lang en

login.title = FLEITEC
login.tagline = One account for all FleiTec apps.
login.user = Username or e-mail
login.password = Password
login.show = Show
login.hide = Hide
login.submit = Sign in
login.busy = Signing in ...
login.fid = Sign in with JARVIS account
login.fid-soon = Coming soon.
login.empty = Please enter username and password.
login.empty-user = Please enter the username.
login.empty-pass = Please enter the password.
login.err-password = Wrong username or password.
login.err-offline = No network. Please check the internet connection.
login.err-server-down = The server cannot be reached. Please try again later.
login.err-timeout = The server does not answer. Please try again.
login.err-dns = The server address was not found. Please check the internet connection.
login.err-tls-roots = This device has no trusted certificates for the secure connection.
login.err-tls = The secure connection to the server failed.
login.err-server = The server has a problem ({code}). Please try again later.
login.err-limit = Too many attempts. Please wait a moment.
login.err-answer = The server's answer was unexpected.
login.expired = The session has expired. Please sign in again.
login.out = You are signed out.

dev.title = Developer
