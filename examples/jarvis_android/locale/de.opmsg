# examples/jarvis_android/locale/de.opmsg -- Texte der JARVIS-App auf Deutsch (Login, Berechtigungen, Tabs).
@lang de

login.title = FLEITEC
login.tagline = Ein Konto für alle FleiTec-Anwendungen.
login.user = Benutzername oder E-Mail
login.password = Passwort
login.show = Anzeigen
login.hide = Verbergen
login.submit = Anmelden
login.busy = Anmeldung läuft ...
login.fid = Mit JARVIS-Konto anmelden
login.fid-soon = Kommt bald.
login.empty = Bitte Benutzername und Passwort eingeben.
login.empty-user = Bitte den Benutzernamen eingeben.
login.empty-pass = Bitte das Passwort eingeben.
login.err-password = Benutzername oder Passwort stimmt nicht.
login.err-offline = Kein Netz. Bitte die Internetverbindung prüfen.
login.err-server-down = Der Server ist nicht erreichbar. Bitte später nochmal versuchen.
login.err-timeout = Der Server antwortet nicht. Bitte nochmal versuchen.
login.err-dns = Die Server-Adresse wurde nicht gefunden. Bitte die Internetverbindung prüfen.
login.err-tls-roots = Dieses Gerät hat keine vertrauenswürdigen Zertifikate für die sichere Verbindung.
login.err-tls = Die sichere Verbindung zum Server ist fehlgeschlagen.
login.err-server = Der Server hat ein Problem ({code}). Bitte später nochmal versuchen.
login.err-limit = Zu viele Versuche. Bitte kurz warten.
login.err-answer = Die Antwort des Servers war unerwartet.
login.expired = Die Sitzung ist abgelaufen. Bitte neu anmelden.
login.out = Du bist abgemeldet.

