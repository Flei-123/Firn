// examples/jarvis_android/jicons.fi -- Lucide vector icon painted over a (text-less) button, like the web composer's icon buttons.
import fui.app
import fui.scene
import fui.render
import fui.widget
import fui.style
import fui.icons
import fui.listrow
import jshell

export { put, MODE_MUTED, MODE_ONACCENT }

const MODE_MUTED: u64 = 0
const MODE_ONACCENT: u64 = 1
const ICON_PT: f64 = 20.0

// ud = (mode << 32) | icon id
fn paint(ud: u64, c: *mut render.Ctx, e: *mut widget.Widget) {
    let a: *mut app.App = jshell.app_ui()
    let sc: *mut scene.Scene = app.app_scene(a)
    let n: usize = scene.scene_node_of(sc, e)
    let id: i64 = (ud & 0xffffffff) as i64
    var col: u32 = style.color_token(style.TOK_TEXT_MUTED)
    if (ud >> 32) == MODE_ONACCENT { col = style.color_token(style.TOK_TEXT_ON_ACCENT) }
    let x: f64 = scene.node_x(sc, n) + (scene.node_w(sc, n) - ICON_PT) / 2.0
    let y: f64 = scene.node_y(sc, n) + (scene.node_h(sc, n) - ICON_PT) / 2.0
    icons.icon_pt(c, id, x, y, ICON_PT, col)
}

// paint the Lucide icon `name` centred on `node` (call again to swap the icon)
fn put(a: *mut app.App, node: usize, name: str, mode: u64) {
    if node == app.NONE { return }
    let id: i64 = listrow.icon_named(name)
    scene.node_set_draw(app.app_scene(a), node, (mode << 32) | (id as u64), paint)
}
