// examples/jarvis_android/jicons.fi -- Lucide vector icon painted over a (text-less) button, like the web composer's icon buttons.
import fui.app
import fui.scene
import fui.render
import fui.widget
import fui.style
import fui.icons
import fui.listrow

export { put }

const ICON_PT: usize = 20

// ud = icon id; colour = the button's own text colour (muted flat button, white on the accent send button)
fn paint(ud: u64, c: *mut render.Ctx, e: *mut widget.Widget) {
    let col: u32 = render.color_of(c, style.resolve_fg(widget.w_styleset(e), widget.w_state(e), style.color_token(style.TOK_TEXT)))
    let side: f64 = render.len_of(c, ICON_PT)
    icons.icon_stroke(render.ctx_painter(c), ud as i64,
        widget.w_x(e) + (widget.w_w(e) - side) * 0.5, widget.w_y(e) + (widget.w_h(e) - side) * 0.5,
        side, col, icons.STROKE_DEFAULT)
}

// paint the Lucide icon `name` centred on `node` (call again to swap the icon)
fn put(a: *mut app.App, node: usize, name: str) {
    if node == app.NONE { return }
    let id: i64 = listrow.icon_named(name)
    scene.node_set_draw(app.app_scene(a), node, id as u64, paint)
}
