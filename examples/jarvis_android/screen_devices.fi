// examples/jarvis_android/screen_devices.fi -- PLACEHOLDER for the "Devices (Geraete)" tab (roadmap A5 fills it).
//
// Contract (see jshell.fi): screen_devices_build(a) runs once with this tab's column open, screen_devices_refresh(a) runs when
// the tab is shown and every 2 s while it stays visible. Data comes from lib/net/jarvisapi.fi (A1) over /api/m/* (A2).
import fui.app
import jshell

export { screen_devices_build, screen_devices_refresh }

static mut G_INFO: usize = 0

fn screen_devices_build(a: *mut app.App) {
    let t: usize = app.label(a, "Devices (Geraete)", 16)
    G_INFO = app.label(a, "coming soon", 12)
}

fn screen_devices_refresh(a: *mut app.App) {
}
