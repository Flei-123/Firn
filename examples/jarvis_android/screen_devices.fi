// SPDX-License-Identifier: MPL-2.0
// examples/jarvis_android/screen_devices.fi -- the "Dev" tab: the PCs / laptops of the user with a connected helper
// (GET /api/remote/devices), online or not. Pull down to refresh; offline the last list is shown with its age.
import std.rt
import std.vec
import fui.app
import fui.vlist
import net.jarvisapi
import jshell
import jtheme
import jdata
import jlist

export { screen_devices_build, screen_devices_refresh }

static mut G_LIST: usize = 0
static mut G_STAND: usize = 0
static mut G_SEEN: u64 = 0
static mut G_SEEN_STAND: u64 = 0

// rows: the detailed list (name, type, online) when the server sends it, else the plain names
fn device_count() -> usize {
    if !jdata.has_devices() { return 0 }
    let n: usize = vec_len[jarvisapi.DeviceRow](&(*jdata.devices()).rows)
    if n > 0 { return n }
    return vec_len[str](&(*jdata.devices()).names)
}

fn rows(ud: u64, i: usize, out: *mut vlist.VRow) {
    if i >= device_count() { return }
    if vec_len[jarvisapi.DeviceRow](&(*jdata.devices()).rows) > 0 {
        let d: *mut jarvisapi.DeviceRow = vec_elem_ptr[jarvisapi.DeviceRow](&(*jdata.devices()).rows, i)
        if (*d).online { jlist.put(out, "* ") } else { jlist.put(out, "- ") }
        jlist.put(out, (*d).name)
        if (*d).kind.n > 0 { vlist.vrow_detail(out, (*d).kind) }
    } else {
        jlist.put(out, "* ")
        jlist.put(out, *vec_elem_ptr[str](&(*jdata.devices()).names, i))
    }
}

fn on_reload(a: *mut app.App) {
    jdata.refresh_devices(true)
    jdata.set_note("refreshing ...")
}

fn screen_devices_build(a: *mut app.App) {
    G_STAND = app.label(a, "Loading ...", 11)
    jtheme.style_node(a, G_STAND, jtheme.K_DIM)
    jshell.fill_stretch(a, G_STAND)
    G_LIST = app.vlist_new(a, "Devices", 340, 360, 0, rows, 0)
    jtheme.style_node(a, G_LIST, jtheme.K_CARD)
    jshell.fill_stretch(a, G_LIST)
    app.vlist_set_row_pt(a, G_LIST, jlist.ROW_PT)
    jlist.pull_add(G_LIST, on_reload)
    jlist.pull_install(a)
    jtheme.style_node(a, app.button(a, "Reload", on_reload), jtheme.K_CHIP)
}

fn screen_devices_refresh(a: *mut app.App) {
    jdata.refresh_devices(false)
    var changed: bool = false
    if jdata.ver_devices() != G_SEEN {
        G_SEEN = jdata.ver_devices()
        changed = true
        app.vlist_set_count(a, G_LIST, device_count())
        app.vlist_changed(a, G_LIST)
    }
    if changed || jdata.ver_stand() != G_SEEN_STAND {
        G_SEEN_STAND = jdata.ver_stand()
        var s: str = jdata.stand_text(jdata.K_DEVICES)
        if jdata.status_note().n > 0 { s = s + "  -  " + jdata.status_note() }
        app.set_text(a, G_STAND, s)
    }
}
