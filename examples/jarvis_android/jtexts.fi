// examples/jarvis_android/jtexts.fi -- the app's own texts (locale/de.opmsg, locale/en.opmsg) on top of appkit.texts.
// The app is always German (like the web app): init selects "de"; en.opmsg stays as the fallback catalog. Keys: login.*, dev.*, perm.*, tab.*, main.*.
import appkit.texts

export { init, t, t1, tp }

const DE: str = __include_str("locale/de.opmsg")
const EN: str = __include_str("locale/en.opmsg")

// once at start, before the first text is asked for
fn init() {
    let a: bool = texts.tr_register("de", DE)
    let b: bool = texts.tr_register("en", EN)
    let c: bool = texts.tr_select("de") // the app is German whatever the system language says (the web app is German)
}

fn t(key: str) -> str { return texts.tr(key) }
fn t1(key: str, name: str, value: str) -> str { return texts.tr1(key, name, value) }

// a64: a text that must STAY valid (an entry's hint keeps the pointer): a private copy of the catalog text. t() may hand out a transient
// buffer; the hint of the chat composer showed leftovers of other texts ("Medium5") on the device.
fn tp(key: str) -> str { return __str_copy(texts.tr(key)) }
