// SPDX-License-Identifier: MPL-2.0
// examples/jarvis_android/jadmin.fi -- the admin tabs' wire side: JSON answers of the web admin routes (/api/admin/*, /api/accounts)
// -> flat records, and a tiny request builder. The routes are the SAME ones the web UI uses (the session cookie of the app is
// accepted there), so no server change is needed.
// Record format: fields joined by \x01, records ended by \x02. Fields are RAW values (flags "0"/"1", numbers, server words); the
// screen turns them into localized card texts. Field meaning per tab is documented at each parser.
import std.rt
import std.str
import std.json
import std.time
import net.jarvisapi

export {
    AK_TAB_GET, AK_TAB_POST, G_NONE_INT,
    parse_users, parse_invites, parse_usage_rates, parse_insights, parse_mcp, parse_provider_one, parse_or_models, parse_guard, parse_imp_token, parse_me_imp, parse_accounts, parse_devices, parse_models, parse_providers, parse_pve, parse_rights, parse_prompt,
    spec_clear, spec_add, post_spec, rec_count, rec_field, level_name, LV_NONE, LV_READ, LV_WRITE, LV_SHELL,
}

const AK_TAB_GET: u32 = 60 // GET of an admin tab (key = the tab id)
const AK_TAB_POST: u32 = 61 // POST of an admin action (key = the tab id)
const G_NONE_INT: i64 = 0 - 1
const LV_NONE: usize = 0
const LV_READ: usize = 1
const LV_WRITE: usize = 2
const LV_SHELL: usize = 3

static mut G_SPEC: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }
static mut G_REQ: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }

// ---------------------------------------------------------------- JSON helpers

fn view(s: str.Span) -> str {
    return str { p: s.p, n: s.n }
}

fn gs(d: *mut json.Json, o: u32, name: str) -> str {
    if o == json.JSON_NONE || json.json_kind(d, o) != json.JSON_OBJECT { return "" }
    let n: u32 = json.json_get(d, o, name.p as u64, name.n)
    if n == json.JSON_NONE || json.json_kind(d, n) != json.JSON_STRING { return "" }
    return view(json.json_string(d, n))
}

// a number member, or `none` when missing / not a number
fn gn(d: *mut json.Json, o: u32, name: str, none: i64) -> i64 {
    if o == json.JSON_NONE || json.json_kind(d, o) != json.JSON_OBJECT { return none }
    let n: u32 = json.json_get(d, o, name.p as u64, name.n)
    if n == json.JSON_NONE || json.json_kind(d, n) != json.JSON_NUMBER { return none }
    if json.json_is_int(d, n) { return json.json_int(d, n) }
    let f: f64 = json.json_number(d, n)
    if f != f || f > 9.0e18 || f < -9.0e18 { return none }
    return f as i64
}

fn gb(d: *mut json.Json, o: u32, name: str) -> bool {
    if o == json.JSON_NONE || json.json_kind(d, o) != json.JSON_OBJECT { return false }
    let n: u32 = json.json_get(d, o, name.p as u64, name.n)
    return n != json.JSON_NONE && json.json_kind(d, n) == json.JSON_TRUE
}

fn gc(d: *mut json.Json, o: u32, name: str, kind: u8) -> u32 {
    if o == json.JSON_NONE || json.json_kind(d, o) != json.JSON_OBJECT { return json.JSON_NONE }
    let n: u32 = json.json_get(d, o, name.p as u64, name.n)
    if n == json.JSON_NONE || json.json_kind(d, n) != kind { return json.JSON_NONE }
    return n
}

fn open_doc(d: *mut json.Json, p: u64, n: usize) -> bool {
    if p == 0 || n == 0 { return false }
    let ok: bool = json.json_parse(d, p, n) catch false
    if !ok || json.json_kind(d, json.json_root(d)) != json.JSON_OBJECT { return false }
    return true
}

fn put(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn fs(out: *mut rt.Buf, s: str) {
    put(out, s)
    rt.buf_push(out, 1 as u8)
}

fn fi(out: *mut rt.Buf, v: i64) {
    rt.buf_push_dec_i64(out, v)
    rt.buf_push(out, 1 as u8)
}

fn fb(out: *mut rt.Buf, v: bool) {
    if v { put(out, "1") } else { put(out, "0") }
    rt.buf_push(out, 1 as u8)
}

fn rend(out: *mut rt.Buf) {
    rt.buf_push(out, 2 as u8)
}

// ---------------------------------------------------------------- record access (shared by the screen)

fn rec_count(b: *mut rt.Buf) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < (*b).len {
        if rt.ld8((*b).ptr as u64, i) == 2 as u8 { n = n + 1 }
        i = i + 1
    }
    return n
}

// field f of record r ("" when missing); a view into the buffer
fn rec_field(b: *mut rt.Buf, r: usize, f: usize) -> str {
    var k: usize = 0
    var i: usize = 0
    var st: usize = 0
    while i < (*b).len && k < r {
        if rt.ld8((*b).ptr as u64, i) == 2 as u8 {
            k = k + 1
            st = i + 1
        }
        i = i + 1
    }
    if k != r { return "" }
    var fk: usize = 0
    var fb0: usize = st
    var j: usize = st
    while j < (*b).len {
        let ch: u8 = rt.ld8((*b).ptr as u64, j)
        if ch == 1 as u8 || ch == 2 as u8 {
            if fk == f { return str { p: ((*b).ptr as u64 + fb0 as u64) as *mut u8, n: j - fb0 } }
            if ch == 2 as u8 { return "" }
            fk = fk + 1
            fb0 = j + 1
        }
        j = j + 1
    }
    return ""
}

fn level_name(l: usize) -> str {
    if l == LV_READ { return "read" }
    if l == LV_WRITE { return "write" }
    if l == LV_SHELL { return "shell" }
    return ""
}

// ---------------------------------------------------------------- parsers

// users: id, name, admin, email, online, push, me
fn parse_users(p: u64, n: usize, out: *mut rt.Buf) -> bool {
    var d: json.Json = json.json_new()
    var ok: bool = false
    if open_doc(&d, p, n) {
        let root: u32 = json.json_root(&d)
        let me: str = __str_copy(gs(&d, root, "me"))
        let us: u32 = gc(&d, root, "users", json.JSON_ARRAY)
        if us != json.JSON_NONE {
            ok = true
            var e: u32 = json.json_child(&d, us)
            while e != json.JSON_NONE {
                if json.json_kind(&d, e) == json.JSON_OBJECT {
                    let id: str = gs(&d, e, "id")
                    fs(out, id)
                    fs(out, gs(&d, e, "username"))
                    fb(out, gb(&d, e, "admin"))
                    fs(out, gs(&d, e, "email"))
                    fb(out, gb(&d, e, "online"))
                    fb(out, gb(&d, e, "hasPush"))
                    fb(out, id.n > 0 && id == me)
                    rend(out)
                }
                e = json.json_next(&d, e)
            }
        }
    }
    json.json_free(&d)
    return ok
}

// invites: code, note, status (server word), createdBy, usedByName, days left (-1 = no expiry), -
// meta: permanent code \x01 active(0|1)
fn parse_invites(p: u64, n: usize, out: *mut rt.Buf, meta: *mut rt.Buf) -> bool {
    var d: json.Json = json.json_new()
    var ok: bool = false
    if open_doc(&d, p, n) {
        let root: u32 = json.json_root(&d)
        rt.buf_clear(meta)
        fs(meta, gs(&d, root, "dauercode"))
        fb(meta, gb(&d, root, "dauercodeAktiv"))
        let arr: u32 = gc(&d, root, "invites", json.JSON_ARRAY)
        if arr != json.JSON_NONE {
            ok = true
            let now: i64 = time.now_unix_ms()
            var e: u32 = json.json_child(&d, arr)
            while e != json.JSON_NONE {
                if json.json_kind(&d, e) == json.JSON_OBJECT {
                    fs(out, gs(&d, e, "code"))
                    fs(out, gs(&d, e, "note"))
                    fs(out, gs(&d, e, "status"))
                    fs(out, gs(&d, e, "createdBy"))
                    fs(out, gs(&d, e, "usedByName"))
                    let exp: i64 = gn(&d, e, "expiresAt", 0 - 1)
                    if exp < 0 { fi(out, 0 - 1) } else { fi(out, (exp - now) / 86400000) }
                    fs(out, "")
                    rend(out)
                }
                e = json.json_next(&d, e)
            }
        }
    }
    json.json_free(&d)
    return ok
}

// accounts: id, label, active, disabled, mode, free % (-1), 5h % (-1), 7d % (-1), runs, blocked
fn parse_accounts(p: u64, n: usize, out: *mut rt.Buf) -> bool {
    var d: json.Json = json.json_new()
    var ok: bool = false
    if open_doc(&d, p, n) {
        let root: u32 = json.json_root(&d)
        let arr: u32 = gc(&d, root, "accounts", json.JSON_ARRAY)
        if arr != json.JSON_NONE {
            ok = true
            let now: i64 = time.now_unix_ms()
            var e: u32 = json.json_child(&d, arr)
            while e != json.JSON_NONE {
                if json.json_kind(&d, e) == json.JSON_OBJECT {
                    fs(out, gs(&d, e, "id"))
                    fs(out, gs(&d, e, "label"))
                    fb(out, gb(&d, e, "active"))
                    fb(out, gb(&d, e, "disabled"))
                    fs(out, gs(&d, e, "mode"))
                    fi(out, gn(&d, e, "free", 0 - 1))
                    let rate: u32 = gc(&d, e, "rate", json.JSON_OBJECT)
                    fi(out, gn(&d, gc(&d, rate, "fiveHour", json.JSON_OBJECT), "util", 0 - 1))
                    fi(out, gn(&d, gc(&d, rate, "sevenDay", json.JSON_OBJECT), "util", 0 - 1))
                    fi(out, gn(&d, e, "runs", 0))
                    fb(out, gn(&d, e, "blockedUntil", 0) > now)
                    rend(out)
                }
                e = json.json_next(&d, e)
            }
        }
    }
    json.json_free(&d)
    return ok
}

// devices: uid, name, username, own, borrowed
fn parse_devices(p: u64, n: usize, out: *mut rt.Buf) -> bool {
    var d: json.Json = json.json_new()
    var ok: bool = false
    if open_doc(&d, p, n) {
        let arr: u32 = gc(&d, json.json_root(&d), "devices", json.JSON_ARRAY)
        if arr != json.JSON_NONE {
            ok = true
            var e: u32 = json.json_child(&d, arr)
            while e != json.JSON_NONE {
                if json.json_kind(&d, e) == json.JSON_OBJECT {
                    fs(out, gs(&d, e, "uid"))
                    fs(out, gs(&d, e, "name"))
                    fs(out, gs(&d, e, "username"))
                    fb(out, gb(&d, e, "own"))
                    fb(out, gb(&d, e, "borrowed"))
                    rend(out)
                }
                e = json.json_next(&d, e)
            }
        }
    }
    json.json_free(&d)
    return ok
}

fn in_array(d: *mut json.Json, arr: u32, s: str) -> bool {
    if arr == json.JSON_NONE { return false }
    var e: u32 = json.json_child(d, arr)
    while e != json.JSON_NONE {
        if json.json_kind(d, e) == json.JSON_STRING && view(json.json_string(d, e)) == s { return true }
        e = json.json_next(d, e)
    }
    return false
}

// models: alias, enabled(0|1)
// meta: default model \x01 default effort \x01 effort list joined by ","
fn parse_models(p: u64, n: usize, out: *mut rt.Buf, meta: *mut rt.Buf) -> bool {
    var d: json.Json = json.json_new()
    var ok: bool = false
    if open_doc(&d, p, n) {
        let root: u32 = json.json_root(&d)
        rt.buf_clear(meta)
        fs(meta, gs(&d, root, "defaultModel"))
        fs(meta, gs(&d, root, "defaultEffort"))
        let ef: u32 = gc(&d, root, "efforts", json.JSON_ARRAY)
        if ef != json.JSON_NONE {
            var x: u32 = json.json_child(&d, ef)
            var first: bool = true
            while x != json.JSON_NONE {
                if json.json_kind(&d, x) == json.JSON_STRING {
                    if !first { put(meta, ",") }
                    first = false
                    put(meta, view(json.json_string(&d, x)))
                }
                x = json.json_next(&d, x)
            }
        }
        rt.buf_push(meta, 1 as u8)
        let all: u32 = gc(&d, root, "all", json.JSON_ARRAY)
        let en: u32 = gc(&d, root, "enabled", json.JSON_ARRAY)
        if all != json.JSON_NONE {
            ok = true
            var e: u32 = json.json_child(&d, all)
            while e != json.JSON_NONE {
                if json.json_kind(&d, e) == json.JSON_STRING {
                    let al: str = view(json.json_string(&d, e))
                    fs(out, al)
                    fb(out, in_array(&d, en, al))
                    rend(out)
                }
                e = json.json_next(&d, e)
            }
        }
    }
    json.json_free(&d)
    return ok
}

// providers + pve keys share one layout: id, label, flag (key set | key active), text (masked key | fingerprint), source, -, kind ("P"|"K")
fn parse_providers(p: u64, n: usize, out: *mut rt.Buf) -> bool {
    var d: json.Json = json.json_new()
    var ok: bool = false
    if open_doc(&d, p, n) {
        let arr: u32 = gc(&d, json.json_root(&d), "providers", json.JSON_ARRAY)
        if arr != json.JSON_NONE {
            ok = true
            var e: u32 = json.json_child(&d, arr)
            while e != json.JSON_NONE {
                if json.json_kind(&d, e) == json.JSON_OBJECT {
                    fs(out, gs(&d, e, "provider"))
                    fs(out, gs(&d, e, "label"))
                    fb(out, gb(&d, e, "set"))
                    fs(out, gs(&d, e, "obscured"))
                    fs(out, gs(&d, e, "source"))
                    fs(out, "")
                    fs(out, "P")
                    rend(out)
                }
                e = json.json_next(&d, e)
            }
        }
    }
    json.json_free(&d)
    return ok
}

fn parse_pve(p: u64, n: usize, out: *mut rt.Buf) -> bool {
    var d: json.Json = json.json_new()
    var ok: bool = false
    if open_doc(&d, p, n) {
        let root: u32 = json.json_root(&d)
        let arr: u32 = gc(&d, root, "keys", json.JSON_ARRAY)
        if arr != json.JSON_NONE {
            ok = true
            var e: u32 = json.json_child(&d, arr)
            while e != json.JSON_NONE {
                if json.json_kind(&d, e) == json.JSON_OBJECT {
                    fs(out, gs(&d, e, "id"))
                    fs(out, gs(&d, e, "label"))
                    fb(out, gb(&d, e, "active"))
                    fs(out, gs(&d, e, "fp"))
                    fs(out, gs(&d, e, "type"))
                    fs(out, "")
                    fs(out, "K")
                    rend(out)
                }
                e = json.json_next(&d, e)
            }
        }
    }
    json.json_free(&d)
    return ok
}

fn level_of(s: str) -> usize {
    if s == "read" { return LV_READ }
    if s == "write" { return LV_WRITE }
    if s == "shell" { return LV_SHELL }
    return LV_NONE
}

// rights of the user_idx-th NON-admin user: project, level (0..3), uid, username
// meta: number of non-admin users \x01
fn parse_rights(p: u64, n: usize, out: *mut rt.Buf, meta: *mut rt.Buf, user_idx: usize) -> bool {
    var d: json.Json = json.json_new()
    var ok: bool = false
    if open_doc(&d, p, n) {
        let root: u32 = json.json_root(&d)
        let projs: u32 = gc(&d, root, "projects", json.JSON_ARRAY)
        let us: u32 = gc(&d, root, "users", json.JSON_ARRAY)
        if projs != json.JSON_NONE && us != json.JSON_NONE {
            ok = true
            var count: i64 = 0
            var u: u32 = json.json_child(&d, us)
            while u != json.JSON_NONE {
                if json.json_kind(&d, u) == json.JSON_OBJECT && !gb(&d, u, "admin") {
                    if count as usize == user_idx {
                        let rp: u32 = gc(&d, gc(&d, u, "rights", json.JSON_OBJECT), "projects", json.JSON_OBJECT)
                        let uid: str = gs(&d, u, "id")
                        let uname: str = gs(&d, u, "username")
                        var pr: u32 = json.json_child(&d, projs)
                        while pr != json.JSON_NONE {
                            if json.json_kind(&d, pr) == json.JSON_STRING {
                                let name: str = view(json.json_string(&d, pr))
                                var lv: usize = LV_NONE
                                if rp != json.JSON_NONE { lv = level_of(gs(&d, rp, name)) }
                                fs(out, name)
                                fi(out, lv as i64)
                                fs(out, uid)
                                fs(out, uname)
                                rend(out)
                            }
                            pr = json.json_next(&d, pr)
                        }
                    }
                    count = count + 1
                }
                u = json.json_next(&d, u)
            }
            rt.buf_clear(meta)
            fi(meta, count)
        }
    }
    json.json_free(&d)
    return ok
}


// ---------------------------------------------------------------- a67: usage / MCP / OpenRouter / guard

// usage rates (GET /api/usage-all {rates:{claude,moonshot}}): label, 5h % (-1), 7d % (-1), provider key, extra (balance text), "R"
fn parse_usage_rates(p: u64, n: usize, out: *mut rt.Buf) -> bool {
    var d: json.Json = json.json_new()
    var ok: bool = false
    if open_doc(&d, p, n) {
        let rs: u32 = gc(&d, json.json_root(&d), "rates", json.JSON_OBJECT)
        if rs != json.JSON_NONE {
            ok = true
            var e: u32 = json.json_child(&d, rs)
            while e != json.JSON_NONE {
                if json.json_kind(&d, e) == json.JSON_OBJECT {
                    let key: str = view(json.json_key(&d, e))
                    var label: str = gs(&d, e, "label")
                    if label.n == 0 { label = key }
                    fs(out, label)
                    fi(out, gn(&d, gc(&d, e, "fiveHour", json.JSON_OBJECT), "util", 0 - 1))
                    fi(out, gn(&d, gc(&d, e, "sevenDay", json.JSON_OBJECT), "util", 0 - 1))
                    fs(out, key)
                    fs(out, gs(&d, e, "subscription"))
                    fs(out, "R")
                    rend(out)
                }
                e = json.json_next(&d, e)
            }
        }
    }
    json.json_free(&d)
    return ok
}

// usage insights (GET /api/usage-insights?win=day|week): ONE summary record: tag, turns, in, out, cache read, "S"; with `chats` the
// top chats follow: title, share %, turns, in + cache read, kind, "C"
fn parse_insights(p: u64, n: usize, out: *mut rt.Buf, tag: str, chats: bool) -> bool {
    var d: json.Json = json.json_new()
    var ok: bool = false
    if open_doc(&d, p, n) {
        let root: u32 = json.json_root(&d)
        let t: u32 = gc(&d, root, "totals", json.JSON_OBJECT)
        if t != json.JSON_NONE {
            ok = true
            fs(out, tag)
            fi(out, gn(&d, t, "turns", 0))
            fi(out, gn(&d, t, "in", 0))
            fi(out, gn(&d, t, "out", 0))
            fi(out, gn(&d, t, "cr", 0))
            fs(out, "S")
            rend(out)
            let tc: u32 = gc(&d, root, "topChats", json.JSON_ARRAY)
            if chats && tc != json.JSON_NONE {
                var e: u32 = json.json_child(&d, tc)
                while e != json.JSON_NONE {
                    if json.json_kind(&d, e) == json.JSON_OBJECT {
                        var title: str = gs(&d, e, "title")
                        if title.n == 0 { title = gs(&d, e, "cid") }
                        fs(out, title)
                        fi(out, gn(&d, e, "pct", 0))
                        fi(out, gn(&d, e, "turns", 0))
                        fi(out, gn(&d, e, "in", 0) + gn(&d, e, "cr", 0))
                        fs(out, gs(&d, e, "kind"))
                        fs(out, "C")
                        rend(out)
                    }
                    e = json.json_next(&d, e)
                }
            }
        }
    }
    json.json_free(&d)
    return ok
}

fn join_names(d: *mut json.Json, arr: u32, out: *mut rt.Buf) {
    if arr == json.JSON_NONE { return }
    var first: bool = true
    var e: u32 = json.json_child(d, arr)
    while e != json.JSON_NONE {
        if json.json_kind(d, e) == json.JSON_STRING {
            if !first { put(out, ",") }
            first = false
            put(out, view(json.json_string(d, e)))
        }
        e = json.json_next(d, e)
    }
}

// MCP servers (GET /api/admin/mcp {servers[], invalid[]}): name, transport, summary, enabled, admin only, note, "M" | for invalid ones: name, "", error, 0, 0, "", "X"
fn parse_mcp(p: u64, n: usize, out: *mut rt.Buf) -> bool {
    var d: json.Json = json.json_new()
    var ok: bool = false
    if open_doc(&d, p, n) {
        let root: u32 = json.json_root(&d)
        let sv: u32 = gc(&d, root, "servers", json.JSON_ARRAY)
        if sv != json.JSON_NONE {
            ok = true
            var e: u32 = json.json_child(&d, sv)
            while e != json.JSON_NONE {
                if json.json_kind(&d, e) == json.JSON_OBJECT {
                    fs(out, gs(&d, e, "name"))
                    fs(out, gs(&d, e, "transport"))
                    fs(out, gs(&d, e, "summary"))
                    fb(out, gb(&d, e, "enabled"))
                    fb(out, gb(&d, e, "admin_only"))
                    fs(out, gs(&d, e, "note"))
                    fs(out, "M")
                    rend(out)
                }
                e = json.json_next(&d, e)
            }
            let bad: u32 = gc(&d, root, "invalid", json.JSON_ARRAY)
            if bad != json.JSON_NONE {
                var b: u32 = json.json_child(&d, bad)
                while b != json.JSON_NONE {
                    if json.json_kind(&d, b) == json.JSON_OBJECT {
                        fs(out, gs(&d, b, "name"))
                        fs(out, "")
                        fs(out, gs(&d, b, "error"))
                        fs(out, "0")
                        fs(out, "0")
                        fs(out, "")
                        fs(out, "X")
                        rend(out)
                    }
                    b = json.json_next(&d, b)
                }
            }
        }
    }
    json.json_free(&d)
    return ok
}

// the one provider row `name` of /api/admin/providers: label, key set (0|1), masked key, source, "", "P"
fn parse_provider_one(p: u64, n: usize, out: *mut rt.Buf, name: str) -> bool {
    var d: json.Json = json.json_new()
    var ok: bool = false
    if open_doc(&d, p, n) {
        let arr: u32 = gc(&d, json.json_root(&d), "providers", json.JSON_ARRAY)
        if arr != json.JSON_NONE {
            ok = true
            var e: u32 = json.json_child(&d, arr)
            while e != json.JSON_NONE {
                if json.json_kind(&d, e) == json.JSON_OBJECT && gs(&d, e, "provider") == name {
                    fs(out, gs(&d, e, "label"))
                    fb(out, gb(&d, e, "set"))
                    fs(out, gs(&d, e, "obscured"))
                    fs(out, gs(&d, e, "source"))
                    fs(out, "")
                    fs(out, "P")
                    rend(out)
                }
                e = json.json_next(&d, e)
            }
        }
    }
    json.json_free(&d)
    return ok
}

fn contains_ci(hay: str, needle: str) -> bool {
    if needle.n == 0 { return true }
    if needle.n > hay.n { return false }
    var i: usize = 0
    while i + needle.n <= hay.n {
        var k: usize = 0
        while k < needle.n {
            var a: u8 = rt.ld8(hay.p as u64, i + k)
            var b: u8 = rt.ld8(needle.p as u64, k)
            if a >= 65 as u8 && a <= 90 as u8 { a = a + 32 as u8 }
            if b >= 65 as u8 && b <= 90 as u8 { b = b + 32 as u8 }
            if a != b { break }
            k = k + 1
        }
        if k == needle.n { return true }
        i = i + 1
    }
    return false
}

// price per token -> cents per 1M tokens (-1 = none)
fn cents_per_m(d: *mut json.Json, o: u32, name: str) -> i64 {
    if o == json.JSON_NONE || json.json_kind(d, o) != json.JSON_OBJECT { return 0 - 1 }
    let n: u32 = json.json_get(d, o, name.p as u64, name.n)
    if n == json.JSON_NONE || json.json_kind(d, n) != json.JSON_NUMBER { return 0 - 1 }
    let f: f64 = json.json_number(d, n)
    if f != f || f < 0.0 || f > 1.0e6 { return 0 - 1 }
    return (f * 1.0e8 + 0.5) as i64
}

// OpenRouter catalog (GET /api/admin/openrouter-models {models[]}), at most `max` models whose id or name contains `query`:
// id, name, context (tokens), in cents/1M, out cents/1M, flags "R"easoning "E"ffort "V"ision, "O"
fn parse_or_models(p: u64, n: usize, out: *mut rt.Buf, query: str, max: usize) -> bool {
    var d: json.Json = json.json_new()
    var ok: bool = false
    if open_doc(&d, p, n) {
        let arr: u32 = gc(&d, json.json_root(&d), "models", json.JSON_ARRAY)
        if arr != json.JSON_NONE {
            ok = true
            var cnt: usize = 0
            var e: u32 = json.json_child(&d, arr)
            while e != json.JSON_NONE && cnt < max {
                if json.json_kind(&d, e) == json.JSON_OBJECT {
                    let id: str = gs(&d, e, "id")
                    let nm: str = gs(&d, e, "name")
                    if contains_ci(id, query) || contains_ci(nm, query) {
                        fs(out, id)
                        fs(out, nm)
                        fi(out, gn(&d, e, "ctx", 0))
                        // the catalog stores the prices as plain members `prompt` / `completion` (per token)
                        fi(out, cents_per_m(&d, e, "prompt"))
                        fi(out, cents_per_m(&d, e, "completion"))
                        var fl: rt.Buf = rt.buf_new()
                        if gb(&d, e, "reasoning") { put(&fl, "R") }
                        if gb(&d, e, "effort") { put(&fl, "E") }
                        if gb(&d, e, "vision") { put(&fl, "V") }
                        fs(out, str { p: fl.ptr as *mut u8, n: fl.len })
                        rt.buf_free(&fl)
                        fs(out, "O")
                        rend(out)
                        cnt = cnt + 1
                    }
                }
                e = json.json_next(&d, e)
            }
        }
    }
    json.json_free(&d)
    return ok
}

// model guard (GET /api/models/new {pending[], aliases[], lastCheck}); first record: last check (ISO, T -> space, 16 chars) , number pending, "", "", "", "G";
// then one record per pending item: label, kind, "prev -> id", alias, family, "N"
fn parse_guard(p: u64, n: usize, out: *mut rt.Buf) -> bool {
    var d: json.Json = json.json_new()
    var ok: bool = false
    if open_doc(&d, p, n) {
        let root: u32 = json.json_root(&d)
        let pl: u32 = gc(&d, root, "pending", json.JSON_ARRAY)
        ok = true
        var lc: str = gs(&d, root, "lastCheck")
        if lc.n > 16 { lc = str { p: lc.p, n: 16 } }
        var k: usize = 0
        if pl != json.JSON_NONE { k = json.json_count(&d, pl) }
        var l: rt.Buf = rt.buf_new()
        var i: usize = 0
        while i < lc.n {
            let ch: u8 = rt.ld8(lc.p as u64, i)
            if ch == 84 as u8 { rt.buf_push(&l, 32 as u8) } else { rt.buf_push(&l, ch) }
            i = i + 1
        }
        fs(out, str { p: l.ptr as *mut u8, n: l.len })
        rt.buf_free(&l)
        fi(out, k as i64)
        fs(out, "")
        fs(out, "")
        fs(out, "")
        fs(out, "G")
        rend(out)
        if pl != json.JSON_NONE {
            var e: u32 = json.json_child(&d, pl)
            while e != json.JSON_NONE {
                if json.json_kind(&d, e) == json.JSON_OBJECT {
                    fs(out, gs(&d, e, "label"))
                    fs(out, gs(&d, e, "kind"))
                    var ch: rt.Buf = rt.buf_new()
                    if gs(&d, e, "prevId").n > 0 {
                        put(&ch, gs(&d, e, "prevId"))
                        put(&ch, " -> ")
                    }
                    put(&ch, gs(&d, e, "id"))
                    fs(out, str { p: ch.ptr as *mut u8, n: ch.len })
                    rt.buf_free(&ch)
                    fs(out, gs(&d, e, "alias"))
                    fs(out, gs(&d, e, "family"))
                    fs(out, "N")
                    rend(out)
                }
                e = json.json_next(&d, e)
            }
        }
    }
    json.json_free(&d)
    return ok
}

// impersonation answer: the session token (app flavour of the route) -> `out` gets a COPY; returns the user name via `name_out`
fn parse_imp_token(p: u64, n: usize, out: *mut rt.Buf, name_out: *mut rt.Buf) -> bool {
    var d: json.Json = json.json_new()
    var ok: bool = false
    if open_doc(&d, p, n) {
        let root: u32 = json.json_root(&d)
        let tk: str = gs(&d, root, "token")
        if tk.n > 0 {
            ok = true
            rt.buf_clear(out)
            put(out, tk)
            rt.buf_clear(name_out)
            put(name_out, gs(&d, root, "username"))
        }
    }
    json.json_free(&d)
    return ok
}

// GET /api/m/me: the admin account we are impersonating from ("" = not impersonating) -> `out` gets impName
fn parse_me_imp(p: u64, n: usize, out: *mut rt.Buf) -> bool {
    var d: json.Json = json.json_new()
    var imp: bool = false
    if open_doc(&d, p, n) {
        let root: u32 = json.json_root(&d)
        rt.buf_clear(out)
        let nm: str = gs(&d, root, "impName")
        if nm.n > 0 { imp = true; put(out, nm) }
    }
    json.json_free(&d)
    return imp
}

// the admin prompt text (a COPY is written to `out`)
fn parse_prompt(p: u64, n: usize, out: *mut rt.Buf) -> bool {
    var d: json.Json = json.json_new()
    var ok: bool = false
    if open_doc(&d, p, n) {
        ok = true
        put(out, gs(&d, json.json_root(&d), "prompt"))
    }
    json.json_free(&d)
    return ok
}

// ---------------------------------------------------------------- request builder
// spec item: name \x02 type \x02 value, items joined by \x01. Types: s string, b bool ("1"), i integer, n null, a array of strings (values joined by \x03).

fn spec_clear() {
    rt.buf_clear(&G_SPEC)
}

fn spec_add(name: str, ty: str, val: str) {
    if G_SPEC.len > 0 { rt.buf_push(&G_SPEC, 1 as u8) }
    put(&G_SPEC, name)
    rt.buf_push(&G_SPEC, 2 as u8)
    put(&G_SPEC, ty)
    rt.buf_push(&G_SPEC, 2 as u8)
    put(&G_SPEC, val)
}

fn atoi(s: str) -> i64 {
    var v: i64 = 0
    var neg: bool = false
    var i: usize = 0
    while i < s.n {
        let ch: u8 = rt.ld8(s.p as u64, i)
        if ch == 45 as u8 { neg = true } else if ch >= 48 as u8 && ch <= 57 as u8 { v = v * 10 + (ch - 48 as u8) as i64 }
        i = i + 1
    }
    if neg { return 0 - v }
    return v
}

// split s at the first byte `sep` from `start`; returns the end index (== s.n when none)
fn find(s: str, start: usize, sep: u8) -> usize {
    var i: usize = start
    while i < s.n && rt.ld8(s.p as u64, i) != sep { i = i + 1 }
    return i
}

fn sub(s: str, a: usize, b: usize) -> str {
    return str { p: (s.p as u64 + a as u64) as *mut u8, n: b - a }
}

// POST the collected spec as a JSON object to `path` (absolute server path) -> AK_TAB_POST (key = tab id)
fn post_spec(api: *mut jarvisapi.Api, path: str, key: str) -> bool {
    rt.buf_clear(&G_REQ)
    var w: json.JsonWriter = json.jw_new(&G_REQ, false)
    json.jw_begin_object(&w)
    let sp: str = str { p: G_SPEC.ptr as *mut u8, n: G_SPEC.len }
    var pos: usize = 0
    while pos < sp.n {
        var e: usize = find(sp, pos, 1 as u8)
        let item: str = sub(sp, pos, e)
        let c1: usize = find(item, 0, 2 as u8)
        let c2: usize = find(item, c1 + 1, 2 as u8)
        if c1 < item.n && c2 < item.n {
            let name: str = sub(item, 0, c1)
            let ty: str = sub(item, c1 + 1, c2)
            let val: str = sub(item, c2 + 1, item.n)
            json.jw_key(&w, name.p as u64, name.n)
            if ty == "s" {
                json.jw_string(&w, val.p as u64, val.n)
            } else if ty == "b" {
                json.jw_bool(&w, val == "1")
            } else if ty == "i" {
                json.jw_int(&w, atoi(val))
            } else if ty == "a" {
                json.jw_begin_array(&w)
                var q: usize = 0
                while q < val.n {
                    let qe: usize = find(val, q, 3 as u8)
                    let one: str = sub(val, q, qe)
                    if one.n > 0 { json.jw_string(&w, one.p as u64, one.n) }
                    q = qe + 1
                }
                json.jw_end(&w)
            } else {
                json.jw_null(&w)
            }
        }
        pos = e + 1
    }
    json.jw_end(&w)
    json.jw_free(&w)
    return jarvisapi.ja_post_abs(api, AK_TAB_POST, path, key, G_REQ.ptr, G_REQ.len)
}
