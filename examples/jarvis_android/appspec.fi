// examples/jarvis_android/appspec.fi -- who the JARVIS Android app is (appkit AppSpec).
//
// App id de.fleitec.jarvis (store name), Android package org.fleitec.jarvis. The build follows the TEST channel
// of the Orient store only; nothing here publishes anything. Environment overrides (set by tools/android/jarvis_build.sh):
//   FIRN_APP_VERSION   version (default 0.1.0)      FIRN_APP_CHANNEL   update channel (default "test")
//   FIRN_APP_STORE     store address                 FIRN_APP_BUILD     store build id
// STORE_KEY is the TRUST ANCHOR: the Ed25519 public key of https://store.fleitec.com (taken from /srv/store/oeffentlich.key).
import appkit.appinfo

const NAME: str = "JARVIS"
const ID: str = "de.fleitec.jarvis"
const VENDOR: str = "FleiTec"
const ANDROID_ID: str = "org.fleitec.jarvis"
const VERSION: str = __env_or("FIRN_APP_VERSION", "0.1.0")
const CHANNEL: str = __env_or("FIRN_APP_CHANNEL", "test")
const STORE_URL: str = __env_or("FIRN_APP_STORE", "https://store.fleitec.com/")
const STORE_KEY: str = "33f41a31ce341fc7d441406233bf10f82ca82940b956bb5eaa46bd6047aa2f5b"

export { spec, NAME, ID, VERSION }

fn spec() -> appinfo.AppSpec {
    return appinfo.AppSpec { id: ID, name: NAME, vendor: VENDOR, version: VERSION,
        build: 0, channel: CHANNEL, store_url: STORE_URL, store_key: STORE_KEY,
        android_id: ANDROID_ID }
}
