static mut G_LOGIN: usize = 0
static mut G_MAIN: usize = 0
static mut G_P0: usize = 0
static mut G_P1: usize = 0
static mut G_P2: usize = 0
static mut G_P3: usize = 0
static mut G_P4: usize = 0
static mut G_P5: usize = 0 // the Admin page (no tab-bar button)
static mut G_BAR: usize = 0
static mut G_SIDEBAR: usize = 0
static mut G_NOTICE: usize = 0
static mut G_CRASH: usize = 0
static mut G_CRASH_ON: bool = false
static mut G_TAB: usize = 0
static mut G_HDR: usize = 0 // the JARVIS header row + hairline (other tabs)
static mut G_HSEP: usize = 0
static mut G_CHDR: usize = 0 // the chat header (screen_chat_build_header), the chat tab only
static mut G_TICKS: u64 = 0
static mut G_LOGGED_IN: bool = false
static mut G_HIST: [usize; 8] = [0; 8] // tabs left by a tap, newest last: the Android Back key walks back through them
static mut G_HIST_N: usize = 0
static mut G_NOHIST: bool = false // show_tab was called by Back: do not record

fn __thread_work(kind: u64, arg: u64) -> u64 {
    return update.thread_dispatch(kind, arg)
}

fn page_node(i: usize) -> usize {
    if i == 0 { return G_P0 }
    if i == 1 { return G_P1 }
    if i == 2 { return G_P2 }
    if i == 3 { return G_P3 }
    if i == 5 { return G_P5 }
    return G_P4
}

static mut G_DEV_WARM: bool = false // the background fetch of the Devices list ran once

fn refresh_tab(a: *mut app.App, i: usize) {
    if i == jshell.TAB_CHAT { screen_chat.screen_chat_refresh(a) }
    else if i == jshell.TAB_LEITSTAND { screen_leitstand.screen_leitstand_refresh(a) }
    else if i == jshell.TAB_TASKS { screen_tasks.screen_tasks_refresh(a) }
    else if i == jshell.TAB_DEVICES { screen_devices.screen_devices_refresh(a) }
    else if i == jshell.TAB_ADMIN { screen_admin.screen_admin_refresh(a) }
    else { screen_settings.screen_settings_refresh(a) }
}

fn hist_push(t: usize) {
    if G_HIST_N > 0 && G_HIST[G_HIST_N - 1] == t { return }
    if G_HIST_N == 8 {
        var k: usize = 1
        while k < 8 {
            G_HIST[k - 1] = G_HIST[k]
            k = k + 1
        }
        G_HIST_N = 7
    }
    G_HIST[G_HIST_N] = t
    G_HIST_N = G_HIST_N + 1
}

fn show_tab(a: *mut app.App, i: usize) {
    if i != G_TAB && !G_NOHIST { hist_push(G_TAB) }
    let sc: *mut scene.Scene = app.app_scene(a)
    var k: usize = 0
    while k < jshell.PAGE_COUNT {
        jshell.set_shown_flex(a, page_node(k), k == i)
        // a hidden page keeps its padding as room (flex): without this the shown page starts ~60 dp under the header (A40 note)
        if k == i {
            if k == 0 { scene.node_set_padding(sc, page_node(k), 12, 0, 12, 10) }
            else { scene.node_set_padding(sc, page_node(k), 12, 0, 12, 8) }
        } else {
            scene.node_set_padding(sc, page_node(k), 0, 0, 0, 0)
        }
        k = k + 1
    }
    G_TAB = i
    jshell.set_shown(a, G_HDR, i != 0, 0)
    jshell.set_shown(a, G_HSEP, i != 0, 0)
    jshell.set_shown(a, G_CHDR, i == 0, 0)
    var tj: usize = 0
    while tj < jshell.TAB_COUNT {
        jtheme.set_tab_on(a, G_TABN[tj], tj == i || (i == jshell.TAB_ADMIN && tj == jshell.TAB_SETTINGS))
        tj = tj + 1
    }
    refresh_tab(a, i)
}

fn on_hdr_menu(a: *mut app.App) { screen_sidebar.sidebar_open(a) }

fn tab0(a: *mut app.App) { show_tab(a, 0) }
fn tab1(a: *mut app.App) { show_tab(a, 1) }
fn tab2(a: *mut app.App) { show_tab(a, 2) }
fn tab3(a: *mut app.App) { show_tab(a, 3) }
fn tab4(a: *mut app.App) { show_tab(a, 4) }

fn show_login(a: *mut app.App, on: bool) {
    if G_CRASH_ON {
        G_LOGGED_IN = !on
        return
    }
    if on { screen_sidebar.sidebar_close(a) }
    jshell.set_shown(a, G_LOGIN, on, 0)
    jshell.set_shown_flex(a, G_MAIN, !on)
    jshell.set_shown(a, G_NOTICE, false, 0)
    G_LOGGED_IN = !on
}

// The note before Android's notification question (once): the main page waits behind it.
fn show_notice(a: *mut app.App, on: bool) {
    if G_CRASH_ON { return }
    jshell.set_shown(a, G_NOTICE, on, 0)
    jshell.set_shown_flex(a, G_MAIN, !on)
}

// The crash report page (jcrash.fi) covers everything else until it is closed.
fn show_crash(a: *mut app.App, on: bool) {
    G_CRASH_ON = on
    jshell.set_shown(a, G_CRASH, on, 1)
    if on {
        jshell.set_shown(a, G_LOGIN, false, 0)
        jshell.set_shown_flex(a, G_MAIN, false)
        jshell.set_shown(a, G_NOTICE, false, 0)
        stage.stage_mark("crash_page_shown")
        return
    }
    show_login(a, !G_LOGGED_IN)
    if G_LOGGED_IN && !jshell.push_allowed() { show_notice(a, true) }
}

fn on_crash_close(a: *mut app.App) {
    jcrash.on_close_clear()
    stage.stage_mark("crash_page_closed")
    show_crash(a, false)
}

fn notice_done(a: *mut app.App, allow: bool) {
    show_notice(a, false)
    if allow {
        jshell.push_allow()
        jshell.mark_once("push_setup")
        jpush.setup()
    }
}

fn on_notice_ok(a: *mut app.App) { notice_done(a, true) }
fn on_notice_later(a: *mut app.App) { notice_done(a, false) }

// signed in (fresh or restored): the main page, or the note first when the person has not seen it yet
fn enter_app(a: *mut app.App) {
    jshell.mark_once("enter_app")
    show_login(a, false)
    show_tab(a, 0)
    if !jshell.push_allowed() { show_notice(a, true) }
}

fn on_login(a: *mut app.App) { screen_login.screen_login_enter(a) }

// back to the sign-in page: the session is gone (sign-out, expired). `msg` is the word shown there.
fn to_login(msg: str) {
    let a: *mut app.App = jshell.app_ui()
    jarvisc.jc_forget(jshell.jc(), jshell.SERVICE)
    jarvisc.jc_disconnect(jshell.jc())
    screen_chat.chat_clear()
    jpush.stop()
    jfont.jfont_reset()
    jmeta.jmeta_reset()
    screen_admin.admin_reset()
    jdata.forget_all()
    screen_login.screen_login_reset()
    show_login(a, true)
    screen_login.screen_login_error(msg)
}

fn logout() { to_login(jtexts.t("login.out")) }

// ---- JARVIS events: sign-in first, everything else belongs to the chat tab
fn on_event(c: *mut jarvisc.Jc, ud: u64, kind: u32, arg: i64) {
    let a: *mut app.App = jshell.app_ui()
    if kind == jarvisc.JE_LOGIN {
        screen_login.screen_login_result(arg, jarvisc.jc_net_layer(c) as i64)
        if arg == 200 {
            let saved: bool = jarvisc.jc_save(c, jshell.SERVICE)
            if !saved { log.log_warn("main", "session token could not be saved: the next start asks to sign in again") }
            jarvisapi.ja_use_jc(jshell.api(), c)
            screen_login.screen_login_reset()
            jcrash.on_login()
            jshell.mark_once("login_ok")
            enter_app(a)
            jshell.set_status(jtexts.t("main.connecting"))
            let ok: bool = jarvisc.jc_connect(c)
        }
        return
    }
    if (kind == jarvisc.JE_HTTP_ERR && arg == 401) || (kind == jarvisc.JE_NETERR && jarvisc.jc_ws_status(c) == 401) {
        to_login(jtexts.t("login.expired"))
        return
    }
    if kind == jarvisc.JE_OPEN { jshell.mark_once("ws_open") }
    if kind == jarvisc.JE_INFO { jshell.mark_once("info_event") }
    screen_chat.screen_chat_event(c, kind, arg)
}

// REST answers (speech to text, later the conversation list): the chat tab takes them
fn on_api(x: *mut jarvisapi.Api, ud: u64, kind: u32, status: i64) {
    if jcrash.on_api(kind, status) { return }
    if status == 401 && G_LOGGED_IN {
        to_login(jtexts.t("login.expired"))
        return
    }
    let st_me: bool = screen_settings.screen_settings_api(x, kind, status)
    if st_me { return }
    if kind == jarvisapi.AK_ME && status == 200 {
        // a restored session has no user name yet: /api/me tells it (More > Account > User)
        if jarvisc.jc_user_from_json(jshell.jc(), jarvisapi.ja_body_ptr(x), jarvisapi.ja_body_len(x)) {
            let saved: bool = jarvisc.jc_save(jshell.jc(), jshell.SERVICE)
        }
        return
    }
    if screen_sidebar.sidebar_api(x, kind, status) { return }
    if jfont.jfont_api(x, kind, status) { return }
    if jmeta.jmeta_api(x, kind, status) { return }
    if screen_admin.admin_api(x, kind, status) { return }
    screen_chat.screen_chat_api(x, kind, status)
}

// 100 ms: the microphone buffer and the speech engine want the program's own thread, at least every 200 ms
fn fast_tick(l: *mut loop.Loop, ud: u64) {
    if !G_FIRST_FRAME && app.frame_stat(app.FS_FRAMES) > 0 {
        G_FIRST_FRAME = true
        stage.stage_mark("first_frame")
    }
    watch_front()
    lay.scroll_sync(jshell.app_ui()) // the More page is a scroll area: hand it its content size
    jshell.theme_guard()
    screen_sidebar.sidebar_tick(jshell.app_ui())
    backkey.back_hold(back_wanted())
    if backkey.back_take() {
        go_back(jshell.app_ui())
        backkey.back_hold(back_wanted())
    }
    voiceio.vio_poll()
    screen_chat.screen_chat_voice_tick(jshell.app_ui())
    kb_tick(jshell.app_ui())
    looppump.quiet_done() // a56: a tick that edited nothing paints no frame
}

// a48: the keyboard. The window is not resized and the insets stay 0 on the device (adjustResize alone does nothing for this native
// surface), so the app asks Android where the visible part of the window ends (getWindowVisibleDisplayFrame). The part under the keyboard
// becomes extra bottom padding (the composer lies right above the keyboard) and the tab bar is hidden while the keyboard is up.
static mut G_VB_MAX: i64 = 0 // the largest visible bottom seen = keyboard closed
static mut G_RH_MAX: i64 = 0 // window height with the keyboard closed
static mut G_KB: i64 = 0 // keyboard height now (device px), 0 = closed
static mut G_KB_PAD: i64 = 0 // extra bottom padding now: the part of the keyboard the system did NOT cut off the window
fn kb_tick(a: *mut app.App) {
    if G_BAR == 0 { return }
    let vb: i64 = kbd.kbd_visible_bottom() as i64
    if vb <= 0 { return }
    let sc: *mut scene.Scene = app.app_scene(a)
    let rh: i64 = scene.node_h(sc, app.root(a)) as i64
    if vb > G_VB_MAX { G_VB_MAX = vb }
    var ovl: i64 = G_VB_MAX - vb
    if ovl < 200 { ovl = 0 }
    if ovl == 0 { G_RH_MAX = rh } else if rh > G_RH_MAX { G_RH_MAX = rh }
    // the system may shrink the window by itself (adjustResize): only the rest needs padding
    var pad: i64 = ovl - (G_RH_MAX - rh)
    if pad < 100 { pad = 0 }
    if ovl == G_KB && pad == G_KB_PAD { return }
    var base: f64 = app.inset(a, 3) - (G_KB_PAD as f64)
    if base < 0.0 { base = 0.0 }
    G_KB = ovl
    G_KB_PAD = pad
    app.set_insets(a, app.inset(a, 0), app.inset(a, 1), app.inset(a, 2), base + (pad as f64))
    scene.node_set_hidden(sc, G_BAR, ovl > 0)
}

fn on_key(a: *mut app.App, key: u32, mods: u32) -> bool {
    if key != editor.KEY_ENTER { return false }
    if !G_LOGGED_IN { return screen_login.screen_login_enter(a) }
    if G_TAB == jshell.TAB_CHAT {
        return screen_chat.screen_chat_enter(a)
    }
    return false
}

fn opened(ud: u64, w: u64) {
    stage.stage_mark("window_opened")
    jshell.set_win(w)
    jshell.apply_theme()
}

// every 5 s with painted frames: how long painting took (budget 16 ms per frame at 60 Hz); the E2E check reads this line
fn log_frames() {
    if G_TICKS % 5 as u64 != 0 as u64 { return }
    let n: i64 = app.frame_stat(app.FS_FRAMES)
    if n == 0 { return }
    log.log_info("frames", "n=" + jshell.dec(n) + " avg_us=" + jshell.dec(app.frame_stat(app.FS_AVG_US)) + " max_us=" +
        jshell.dec(app.frame_stat(app.FS_MAX_US)) + " over16ms=" + jshell.dec(app.frame_stat(app.FS_SLOW)) +
        " iv_p95_us=" + jshell.dec(app.frame_stat(app.FS_IV_P95_US)) + " iv_max_us=" + jshell.dec(app.frame_stat(app.FS_IV_MAX_US)) +
        " hz=" + jshell.dec(app.refresh_hz(jshell.app_ui())) + " ph_us=" + jshell.dec(app.frame_phase(0)) + "/" + jshell.dec(app.frame_phase(1)) +
        "/" + jshell.dec(app.frame_phase(2)) + "/" + jshell.dec(app.frame_phase(3)) + "/" + jshell.dec(app.frame_phase(4)) + "/" +
        jshell.dec(app.frame_phase(5)) + "/" + jshell.dec(app.frame_phase(6)) + "/" + jshell.dec(app.frame_phase(7)) +
        " bg=" + jshell.dec(painter.bgcache_stat(0)) + "/" + jshell.dec(painter.bgcache_stat(1)) + "/" + jshell.dec(painter.bgcache_stat(2)) + "/" +
        jshell.dec(painter.bgcache_stat(3)) + " fit=" + jshell.dec(app.fit_stat(0)) + "/" + jshell.dec(app.fit_stat(1)))
    app.frame_stats_reset()
    log_geom()
}

// The tab bar must lie fully inside the window on every tab (a42: it was pushed out by a tall page). The line is what the e2e test reads.
fn log_geom() {
    if !G_LOGGED_IN { return }
    let a: *mut app.App = jshell.app_ui()
    let sc: *mut scene.Scene = app.app_scene(a)
    let rh: f64 = scene.node_h(sc, app.root(a))
    let by: f64 = scene.node_y(sc, G_BAR)
    let bh: f64 = scene.node_h(sc, G_BAR)
    var ok: str = "0"
    if bh > 1.0 && by + bh <= rh + 1.0 { ok = "1" }
    log.log_info("geom", "tab=" + jshell.dec(G_TAB as i64) + " bar_y=" + jshell.dec(by as i64) + " bar_h=" + jshell.dec(bh as i64) + " root_h=" + jshell.dec(rh as i64) + " bar_visible=" + ok + " kb=" + jshell.dec(G_KB) + " kbpad=" + jshell.dec(G_KB_PAD) + " vbmax=" + jshell.dec(G_VB_MAX) + " inset_b=" + jshell.dec(app.inset(a, 3) as i64) + " inset_t=" + jshell.dec(app.inset(a, 1) as i64) + screen_chat.screen_chat_geom(a))
}

static mut G_TABN: [usize; 5] = [0 as usize; 5]
static mut G_FIRST_FRAME: bool = false
static mut G_WAS_FRONT: bool = true
static mut G_LAUNCH_DONE: bool = false

// the window came back to the front (a tap on a push notification, or the launcher): open the chat the tap meant (jpush.pending_take)
// -- and once after the sign-in: a start by a tap on a notification carries its chat id in the intent (jpush.launch_take)
// foreground <-> background, every 100 ms: a run whose last stage is `bg` was not a crash (Android may kill a background process any time)
static mut G_FRONT_SEEN: i64 = -1
fn watch_front() {
    if jshell.win() as u64 == 0 { return }
    var f: i64 = 0
    if window.in_front(jshell.win()) { f = 1 }
    if f == G_FRONT_SEEN { return }
    G_FRONT_SEEN = f
    if f == 1 { stage.stage_mark("fg") } else { stage.stage_mark("bg") }
    if f == 1 { jdata.invalidate_all() } // a48: back in front = reload the lists now (Boss: workers were stale)
    // a run that ends in the background is no crash: the next start writes no report (r120a)
    crash.crash_set_background(f == 0)
}

fn follow_push(a: *mut app.App) {
    if jshell.win() as u64 == 0 { return }
    let front: bool = window.in_front(jshell.win())
    let came: bool = front && !G_WAS_FRONT
    if front != G_WAS_FRONT {
        var fv: i64 = 0
        if front { fv = 1 }
        log.log_info("push", "window front " + jshell.dec(fv))
    }
    G_WAS_FRONT = front
    if front && !came { jpush.settle() }
    var cid: str = ""
    // a tap while the app is open delivers a NEW intent only with org.firn.FirnMain (onNewIntent, singleTop); the plain activity has none:
    // then jpush.tap_open below (the notification is gone without a swipe mark) finds the chat
    if G_LOGGED_IN && (!G_LAUNCH_DONE || (front && !came)) {
        G_LAUNCH_DONE = true
        cid = jpush.launch_take()
    }
    if cid.n == 0 && came && G_LOGGED_IN { cid = jpush.pending_take() }
    // the app is open and a notification of ours vanished without a swipe: it was tapped (plain activity, no onNewIntent)
    if cid.n == 0 && front && !came && G_LOGGED_IN { cid = jpush.tap_open() }
    if cid.n == 0 { return }
    log.log_info("push", "tap opens chat " + cid + " (" + jpush.last_source() + ")")
    show_tab(a, jshell.TAB_CHAT)
    screen_chat.screen_chat_open_cid(a, cid)
}

// ---- the store check: not at start, not while somebody is busy with the app.
// It is asynchronous now (appkit.update_async), but it still costs a TLS
// handshake per file on this one thread, so it waits for calm: signed in and
// in front for UPDATE_CALM_MS, or on the sign-in page for UPDATE_CALM_LOGIN_MS
// (nobody types a password that long). One try per run; a failed one is
// asked again at the next start (check.last is only set by a good one).
const UPDATE_CALM_MS: i64 = 30000
const UPDATE_CALM_LOGIN_MS: i64 = 90000
static mut G_CALM_T0: i64 = 0
static mut G_CALM_FRONT: bool = false
static mut G_CALM_IN: bool = false
static mut G_UPD_TRIED: bool = false

fn update_schedule() {
    if G_UPD_TRIED || jshell.win() as u64 == 0 { return }
    let now: i64 = loop.mono_ms()
    let front: bool = window.in_front(jshell.win())
    if G_CALM_T0 == 0 || front != G_CALM_FRONT || G_LOGGED_IN != G_CALM_IN {
        G_CALM_T0 = now
        G_CALM_FRONT = front
        G_CALM_IN = G_LOGGED_IN
        return
    }
    if !front { return }
    var need: i64 = UPDATE_CALM_LOGIN_MS
    if G_LOGGED_IN { need = UPDATE_CALM_MS }
    if now - G_CALM_T0 < need { return }
    G_UPD_TRIED = true
    if !update.update_auto_due(jshell.updater()) { return }
    log.log_info("update", "store check starts (calm for " + jshell.dec(now - G_CALM_T0) + " ms)")
    let ok: bool = update.update_start(jshell.updater(), update.OP_CHECK, update.RUN_AUTO)
}

fn tick(l: *mut loop.Loop, ud: u64) {
    let a: *mut app.App = jshell.app_ui()
    G_TICKS = G_TICKS + 1 as u64
    let p: bool = update.update_poll(jshell.updater())
    if G_TICKS == 2 as u64 { jshell.apply_theme() } // after the window applied the system's choice
    if jshell.take_logout() { logout() }
    if jshell.take_dev() {
        to_login("")
        screen_login.screen_login_open_dev()
    }
    // chat header hook: the sliders open a tab (the hamburger opens the sidebar directly)
    let want_tab: i64 = jshell.take_tab()
    if want_tab >= 0 { show_tab(a, want_tab as usize) }
    jpush.tick()
    jcrash.tick()
    jfont.jfont_tick(G_LOGGED_IN)
    jmeta.jmeta_tick(G_LOGGED_IN)
    screen_admin.admin_tick(G_LOGGED_IN)
    follow_push(a)
    log_frames()
    if G_LOGGED_IN && G_TICKS % 2 as u64 == 0 as u64 { refresh_tab(a, G_TAB) }
    screen_sidebar.sidebar_refresh(a)
    update_schedule()
    // the Devices list is fetched once in the background (a few seconds after sign-in) so the tab opens with data, not "Loading"
    if G_LOGGED_IN && !G_DEV_WARM && G_TICKS >= 4 as u64 {
        G_DEV_WARM = true
        jdata.refresh_devices(false)
    }
    if G_TICKS == 3 as u64 { stage.stage_mark("alive_3s") }
    if G_TICKS == 6 as u64 { update.update_mark_healthy(jshell.updater()) }
    looppump.quiet_done() // a63: a 1 s tick that edited nothing paints no frame (idle repaints)
}

// More page: drag = scroll, lift with speed = run-out (lay's first scroll area is the More page)
fn on_pan_more(ud: u64, e: *mut event.Ev) -> u32 {
    let k: u32 = event.ev_kind(e)
    if k == event.EV_PAN_MOVE {
        lay.scroll_pan(0, event.ev_dy(e))
        return event.H_STOP
    }
    if k == event.EV_PAN_END { log.log_info("pan", "more end") }
    if k == event.EV_PAN_END && event.ev_fling(e) {
        lay.scroll_fling(0, event.ev_vy(e), event.ev_time(e))
        return event.H_STOP
    }
    return event.H_GO
}

// sidebar handlers: open the picked chat / a new chat / the user line (More tab); each closes the drawer and shows the chat
fn sb_open_chat(a: *mut app.App) {
    screen_chat.screen_chat_open_cid(a, screen_sidebar.sidebar_picked_cid())
    screen_sidebar.sidebar_close(a)
    show_tab(a, jshell.TAB_CHAT)
}

fn sb_new_chat(a: *mut app.App) {
    screen_chat.screen_chat_new(a)
    screen_sidebar.sidebar_close(a)
    show_tab(a, jshell.TAB_CHAT)
}

fn sb_user(a: *mut app.App) {
    screen_sidebar.sidebar_close(a)
    show_tab(a, jshell.TAB_SETTINGS)
}

// Android Back: close what is open, else go back one page; only on the root (chat tab, nothing open) Back leaves the app (the system does it).
fn back_wanted() -> bool {
    if !G_LOGGED_IN || G_CRASH_ON { return false }
    return screen_sidebar.sidebar_is_open() || screen_chat.screen_chat_viewer_open() || G_HIST_N > 0 || G_TAB != jshell.TAB_CHAT
}

fn go_back(a: *mut app.App) {
    if !G_LOGGED_IN || G_CRASH_ON { return }
    if screen_chat.screen_chat_viewer_back() { return }
    if screen_sidebar.sidebar_back(a) {
        log.log_info("back", "closed sidebar step: " + screen_sidebar.sidebar_dump())
        return
    }
    G_NOHIST = true
    if G_HIST_N > 0 {
        G_HIST_N = G_HIST_N - 1
        show_tab(a, G_HIST[G_HIST_N])
    } else if G_TAB != jshell.TAB_CHAT {
        show_tab(a, jshell.TAB_CHAT)
    }
    G_NOHIST = false
    log.log_info("back", "tab=" + jshell.dec(G_TAB as i64))
}

fn build_ui(a: *mut app.App) {
    let sc: *mut scene.Scene = app.app_scene(a)
    // login page, then the note about notifications (shown once after the first sign-in)
    G_LOGIN = screen_login.screen_login_build(a)
    G_NOTICE = app.column(a)
    scene.node_set_flex(sc, G_NOTICE, flex.FLEX_COLUMN, flex.JUSTIFY_CENTER, flex.AL_STRETCH)
    scene.node_set_padding(sc, G_NOTICE, 16, 12, 16, 12)
    jshell.fill_stretch(a, G_NOTICE)
    let nc: usize = jsetui.card(a, "")
    applay.pad(a, nc, 24, 26, 24, 26)
    applay.gap(a, nc, 12, 12)
    let n0: usize = app.label(a, jtexts.t("perm.notif-title"), 0)
    jtheme.style_node(a, n0, jtheme.K_TITLE)
    let n1: usize = app.label(a, jtexts.t("perm.notif-text"), 0)
    jtheme.style_node(a, n1, jsetui.K_SET_LABEL)
    jsetui.primary(a, jtexts.t("perm.notif-ok"), on_notice_ok)
    let later: usize = app.button(a, jtexts.t("perm.notif-later"), on_notice_later)
    jtheme.style_node(a, later, jtheme.K_CHIP)
    applay.align_start(a, later)
    app.end(a)
    app.end(a)
    // main page: header, five tab pages, tab bar
    G_MAIN = app.column(a)
    jshell.fill(a, G_MAIN)
    scene.node_add_class(sc, G_MAIN, jtheme.K_PAGEGLOW)
    // the five tab pages are children of this column: a gap between them would be paid for by every HIDDEN page (4 x ~10 pt of air)
    scene.node_set_gap(sc, G_MAIN, 0, 0)
    let hr: usize = app.row(a)
    jshell.fill_stretch(a, hr)
    scene.node_set_padding(sc, hr, 8, 8, 8, 8)
    scene.node_set_gap(sc, hr, 2, 2)
    // same hamburger as the chat header (web header .icon-btn): the other pages open the sidebar the same way
    let hmenu: usize = app.button(a, "", on_hdr_menu)
    jtheme.style_node(a, hmenu, jtheme.K_HDRBTN)
    jicons.put(a, hmenu, "menu")
    let h: usize = app.label(a, jtexts.t("main.title"), 0)
    jtheme.style_node(a, h, jtheme.K_BRAND)
    let hsp: usize = app.spacer(a, 1, 1)
    scene.node_set_grow(sc, hsp, 1, 0)
    let st: usize = app.label(a, "", 0)
    jtheme.style_node(a, st, jtheme.K_PILL)
    // the pill gives room before the hamburger / brand are pushed out
    scene.node_set_flexitem(sc, st, 0, 1000, 1, 0)
    jshell.status_line(st)
    app.end(a)
    let hsep: usize = app.separator(a)
    G_HDR = hr
    G_HSEP = hsep
    G_CHDR = screen_chat.screen_chat_build_header(a)
    G_P0 = app.column(a)
    jshell.fill(a, G_P0)
    screen_chat.screen_chat_build(a)
    app.end(a)
    G_P1 = app.column(a)
    screen_leitstand.screen_leitstand_build(a)
    app.end(a)
    G_P2 = app.column(a)
    screen_tasks.screen_tasks_build(a)
    app.end(a)
    G_P3 = app.column(a)
    screen_devices.screen_devices_build(a)
    app.end(a)
    G_P4 = app.column(a)
    // More: the cards are higher than a small screen, so the page scrolls (touch pan: jlist.pan_*), the tab bar stays
    let sv: usize = lay.scroll_v(a)
    screen_settings.screen_settings_build(a)
    app.end(a)
    app.end(a)
    G_P5 = app.column(a)
    screen_admin.screen_admin_build(a)
    app.end(a)
    // a finger drag on the More page scrolls it (the router lets a pan win over a tap, so a swipe never presses a button)
    let pb: bool = app.on(a, G_P4, event.EV_PAN_ALL, on_pan_more)
    // the list pages start at the top (a column centres its children by default)
    scene.node_set_padding(sc, G_P0, 12, 0, 12, 10)
    var pk: usize = 1
    while pk < jshell.PAGE_COUNT {
        jshell.fill_stretch(a, page_node(pk))
        // node_set_flex builds a NEW flexbox (padding and gap are gone): padding and gap come AFTER it
        scene.node_set_flex(sc, page_node(pk), flex.FLEX_COLUMN, flex.JUSTIFY_START, flex.AL_STRETCH)
        scene.node_set_padding(sc, page_node(pk), 12, 0, 12, 8)
        scene.node_set_gap(sc, page_node(pk), 8, 8)
        pk = pk + 1
    }
    let bar: usize = app.row(a)
    G_BAR = bar
    jshell.fill_stretch(a, bar)
    scene.node_set_gap(sc, bar, 2, 2)
    scene.node_set_padding(sc, bar, 6, 4, 6, 4)
    jtheme.style_node(a, bar, jtheme.K_BAR)
    G_TABN[0] = app.button(a, jtexts.t("tab.chat"), tab0)
    G_TABN[1] = app.button(a, jtexts.t("tab.board"), tab1)
    G_TABN[2] = app.button(a, jtexts.t("tab.tasks"), tab2)
    G_TABN[3] = app.button(a, jtexts.t("tab.devices"), tab3)
    G_TABN[4] = app.button(a, jtexts.t("tab.more"), tab4)
    var tk: usize = 0
    while tk < jshell.TAB_COUNT {
        jtheme.style_node(a, G_TABN[tk], jtheme.K_TAB)
        scene.node_set_grow(sc, G_TABN[tk], 1, 1)
        tk = tk + 1
    }
    app.end(a)
    app.end(a)
    G_SIDEBAR = screen_sidebar.sidebar_build(a, G_MAIN)
    screen_sidebar.sidebar_set_handlers(a, sb_open_chat, sb_new_chat, sb_user)
    G_CRASH = jcrash.build(a, on_crash_close)
    jshell.set_shown(a, G_CRASH, false, 1)
    show_login(a, true)
    jshell.set_shown(a, G_NOTICE, false, 0)
    var k: usize = 1
    while k < jshell.PAGE_COUNT {
        jshell.set_shown(a, page_node(k), false, 0)
        scene.node_set_padding(sc, page_node(k), 0, 0, 0, 0)
        k = k + 1
    }
}

#[allow_escape]
fn main(start: u64) -> i32 {
    platform.plat_init(start)
    if !appinfo.appinfo_init(appspec.spec()) { return 2 }
    jcrash.init()
    let u: *mut update.Updater = update.update_new()
    if !update.update_init(u) { return 2 }
    update.update_boot(u)
    stage.stage_mark("update_boot")
    jshell.set_updater(u)
    var logdir: rt.Buf = rt.buf_new()
    platform.plat_dir(platform.DIR_LOG, appinfo.app_id(), appinfo.app_vendor(), &logdir)
    log.log_open(util.buf_to_str_copy(&logdir), "app", log.LOG_INFO, 524288, 3)
    rt.buf_free(&logdir)
    log.log_info("main", "start " + appinfo.app_name() + " " + appinfo.app_version())
    crash.crash_begin()
    stage.stage_mark("crash_begin")

    jtexts.init()
    // Android has no HOME and no machine id: the session token lives in the app's private data directory (std.secret app-dir mode)
    if platform.plat_swap_kind() == platform.SWAP_INSTALLER {
        var sdir: rt.Buf = rt.buf_new()
        if platform.plat_dir(platform.DIR_DATA, appinfo.app_id(), appinfo.app_vendor(), &sdir) {
            let used: bool = secret.secret_use_dir(util.buf_to_str_copy(&sdir))
            if !used { log.log_warn("main", "secret dir refused") }
        }
        rt.buf_free(&sdir)
    }
    // tests give the address of a fake server as the one argument; people never see an address
    if rt.arg_count(start) >= 2 {
        let bp: u64 = rt.arg_ptr(start, 1)
        jshell.set_base_override(str { p: bp as *mut u8, n: rt.c_length(bp) })
        // a test run (args.txt): the checks stop the app in the foreground, that is no crash. A third word `crashpage` keeps the page armed.
        stage.stage_mark("test_run")
        if rt.arg_count(start) >= 3 {
            let cp: u64 = rt.arg_ptr(start, 2)
            let word: str = str { p: cp as *mut u8, n: rt.c_length(cp) }
            if word == "crashpage" { stage.stage_mark("crashpage_armed") }
        }
    }
    let base: str = jshell.server_base()
    var l: loop.Loop = loop.loop_new()
    if !loop.loop_init(&l) { return 2 }
    jshell.set_loop(&l)
    stage.stage_mark("window_create")
    jfont.jfont_boot() // the saved face (system | inter | grotesk | mono) must be known before the window loads its font
    let a: *mut app.App = app.window("JARVIS", 360, 640)
    stage.stage_mark("window_created")
    jshell.set_app(a)
    let r: usize = app.root(a)
    scene.node_set_gap(app.app_scene(a), r, 0, 0)
    scene.node_set_padding(app.app_scene(a), r, 0, 0, 0, 0)
    jtheme.install_rules(a)
    scene.node_add_class(app.app_scene(a), r, jtheme.K_PAGEBG)
    jsetui.install_rules(a)
    screen_sidebar.sidebar_install_rules(a)
    jshell.apply_theme()
    app.frame_stats_on(true)
    build_ui(a)
    stage.stage_mark("ui_built")
    app.on_key(a, on_key)
    app.set_window_hooks(a, 0, opened, hotkey_none)
    looppump.attach(a, &l)
    let upd_ok: bool = update_async.install(u, &l)
    let c: *mut jarvisc.Jc = jarvisc.jc_new(&l, on_event, 0)
    jshell.set_jc(c)
    jshell.set_api(jarvisapi.ja_new(&l, on_api, 0))
    jarvisc.jc_set_base(c, base)
    var tzid: str = tzinfo.tz_id() // the zone of the device; Vienna when it is not known
    if tzid.n == 0 { tzid = "Europe/Vienna" }
    jarvisc.jc_set_tz(c, tzid)
    jarvisc.jc_set_dev(c, "firn-android")
    if jarvisc.jc_restore(c, jshell.SERVICE) {
        jarvisapi.ja_use_jc(jshell.api(), c)
        enter_app(a)
        jshell.set_status(jtexts.t("main.connecting"))
        let ok: bool = jarvisc.jc_connect(c)
    } else {
        log.log_info("main", "no saved session: sign-in page")
    }
    if jcrash.have_report() { show_crash(a, true) }
    stage.stage_mark("loop_attached")
    let th: u64 = loop.timer_every(&l, 1000, tick, 0)
    let fh: u64 = loop.timer_every(&l, 100, fast_tick, 0)
    let rc: i32 = app.run(a)
    stage.stage_mark("clean_exit")
    crash.crash_end()
    log.log_close()
    return rc
}

fn hotkey_none(ud: u64, id: u32) {
}
