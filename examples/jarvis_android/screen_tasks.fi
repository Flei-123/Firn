// SPDX-License-Identifier: MPL-2.0
// examples/jarvis_android/screen_tasks.fi -- the "Tasks" tab: tasks and reminders of the user (list, add, done, remove).
//
// Add: type the text; a reminder time can follow after an '@' in ISO form, e.g. `call grandpa @2026-10-18T09:00`. The server
// rolls repeats by itself. "!" in front of a row = overdue, "[x]" = done. Pull down on the list (or Reload) to refresh; offline the
// last list is shown with its age. HONEST: on today's server.js "add" is not a route yet (the answer is the list WITHOUT the new
// task); the mobile route of the server worker (docs/ANDROID-APP-API.md, POST /api/m/tasks) fixes that via `ja_set_path`.
import std.rt
import std.vec
import fui.app
import fui.vlist
import net.jarvisapi
import jshell
import jtheme
import jdata
import jlist

export { screen_tasks_build, screen_tasks_refresh }

static mut G_LIST: usize = 0
static mut G_STAND: usize = 0
static mut G_IN: usize = 0
static mut G_SEEN: u64 = 0
static mut G_SEEN_STAND: u64 = 0

fn task_count() -> usize {
    if !jdata.has_tasks() { return 0 }
    return vec_len[jarvisapi.TaskRow](&(*jdata.tasks()).rows)
}

fn task_at(i: usize) -> *mut jarvisapi.TaskRow {
    return vec_elem_ptr[jarvisapi.TaskRow](&(*jdata.tasks()).rows, i)
}

fn rows(ud: u64, i: usize, out: *mut vlist.VRow) {
    if i >= task_count() { return }
    let t: *mut jarvisapi.TaskRow = task_at(i)
    if (*t).done { jlist.put(out, "[x] ") }
    else if (*t).overdue { jlist.put(out, "! ") }
    jlist.put(out, (*t).text)
    if (*t).due.n > 0 { vlist.vrow_detail(out, (*t).due) }
}

// the id the server knows the task by
fn ref_of(t: *mut jarvisapi.TaskRow) -> str {
    if (*t).id.n > 0 { return __str_copy((*t).id) }
    return jshell.dec((*t).id_n)
}

fn selected(a: *mut app.App) -> usize {
    let s: usize = app.vlist_selected(a, G_LIST)
    if s == app.NONE || s >= task_count() { return app.NONE }
    return s
}

fn on_add(a: *mut app.App) {
    let raw: str = __str_copy(app.text(a, G_IN))
    if raw.n == 0 { return }
    // split at the last '@': text before, reminder time after
    var at: usize = raw.n
    var i: usize = 0
    while i < raw.n {
        if *((raw.p as u64 + i as u64) as *mut u8) == 64 as u8 { at = i }
        i = i + 1
    }
    var text: str = raw
    var due: str = ""
    if at < raw.n {
        text = str { p: raw.p, n: at }
        due = str { p: (raw.p as u64 + at as u64 + 1 as u64) as *mut u8, n: raw.n - at - 1 }
    }
    // trim spaces around both parts
    while text.n > 0 && *((text.p as u64 + text.n as u64 - 1 as u64) as *mut u8) == 32 as u8 { text = str { p: text.p, n: text.n - 1 } }
    while due.n > 0 && *(due.p as *mut u8) == 32 as u8 { due = str { p: (due.p as u64 + 1 as u64) as *mut u8, n: due.n - 1 } }
    if text.n == 0 { return }
    if jdata.task_add(text, due) {
        app.set_text(a, G_IN, "")
        jdata.set_note("saving ...")
    } else {
        jdata.set_note("not sent")
    }
}

fn on_done(a: *mut app.App) {
    let s: usize = selected(a)
    if s == app.NONE { jdata.set_note("select a task first"); return }
    let ok: bool = jdata.task_complete(ref_of(task_at(s)))
    jdata.set_note("marking done ...")
}

fn on_remove(a: *mut app.App) {
    let s: usize = selected(a)
    if s == app.NONE { jdata.set_note("select a task first"); return }
    let ok: bool = jdata.task_remove(ref_of(task_at(s)))
    jdata.set_note("removing ...")
}

fn on_reload(a: *mut app.App) {
    jdata.refresh_tasks(true)
    jdata.set_note("refreshing ...")
}

fn screen_tasks_build(a: *mut app.App) {
    G_STAND = app.label(a, "Loading ...", 11)
    jtheme.style_node(a, G_STAND, jtheme.K_DIM)
    jshell.fill_stretch(a, G_STAND)
    G_LIST = app.vlist_new(a, "Tasks", 340, 300, 0, rows, 0)
    jtheme.style_node(a, G_LIST, jtheme.K_CARD)
    jshell.fill_stretch(a, G_LIST)
    app.vlist_set_row_pt(a, G_LIST, jlist.ROW_PT)
    jlist.pull_add(G_LIST, on_reload)
    jlist.pull_install(a)
    app.row(a)
    G_IN = app.entry(a, "New task  (text @ISO time)")
    app.set_width(a, G_IN, 230)
    jtheme.style_node(a, app.button(a, "Add", on_add), jtheme.K_CHIP)
    app.end(a)
    app.row(a)
    jtheme.style_node(a, app.button(a, "Done", on_done), jtheme.K_CHIP)
    jtheme.style_node(a, app.button(a, "Remove", on_remove), jtheme.K_CHIP)
    jtheme.style_node(a, app.button(a, "Reload", on_reload), jtheme.K_CHIP)
    app.end(a)
}

fn screen_tasks_refresh(a: *mut app.App) {
    jdata.refresh_tasks(false)
    var changed: bool = false
    if jdata.ver_tasks() != G_SEEN {
        G_SEEN = jdata.ver_tasks()
        changed = true
        app.vlist_set_count(a, G_LIST, task_count())
        app.vlist_changed(a, G_LIST)
    }
    if changed || jdata.ver_stand() != G_SEEN_STAND {
        G_SEEN_STAND = jdata.ver_stand()
        var s: str = jdata.stand_text(jdata.K_TASKS)
        if jdata.status_note().n > 0 { s = s + "  -  " + jdata.status_note() }
        app.set_text(a, G_STAND, s)
    }
}
