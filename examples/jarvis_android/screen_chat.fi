export {
    screen_chat_build, screen_chat_refresh, screen_chat_event, screen_chat_api, screen_chat_voice_tick, screen_chat_enter, screen_chat_in_node, chat_clear,
    chat_view_tick, screen_chat_geom, screen_chat_open_cid, screen_chat_build_header, screen_chat_set_usage, screen_chat_set_usage_info, screen_chat_set_model, screen_chat_set_models, screen_chat_new, screen_chat_viewer_back, screen_chat_viewer_open, screen_chat_cycle_model, screen_chat_cycle_effort, screen_chat_cur_model, screen_chat_cur_effort,
}

static mut G_SPK: usize = 0 // header speaker icon (accent while the spoken answer is on)
static mut G_MODEL: usize = 0 // header: the model pill
static mut G_HROW: usize = 0 // header: the row (pill + icons); its width decides how much of the model name fits
static mut G_PILL_FULL: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 } // the full pill text ("Claude Sonnet 5.5 Medium")
static mut G_PILL_SHOWN: i64 = -1 // which form the pill shows: 0 full, 1 without the "Claude " prefix
// model dropdown (the pill opens it): rows come from GET /api/m/models (net.jarvisapi parse_model_list)
const MODEL_ROWS: usize = 8
const EFFORT_CHIPS: usize = 5
static mut G_DD: usize = 0 // the panel under the header
static mut G_DD_OPEN: bool = false
static mut G_MROW: [usize; 8] = [0; 8]
static mut G_EROW: [usize; 5] = [0; 5]
static mut G_EFF_ROW: usize = 0
static mut G_MN: usize = 0 // models listed
static mut G_EN: usize = 0 // efforts listed
static mut G_ROWS: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 } // "alias \x01 label \x01 effort(0|1)\n" per model
static mut G_EFFS: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 } // "low\nmedium\n..."
static mut G_CUR_M: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }
static mut G_CUR_E: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }

// copy button under every answer: the byte range of each answer in G_CHAT (the n-th meta line of the view belongs to answer n)
const ANS_MAX: usize = 512
static mut G_ANS_S: [usize; 512] = [0; 512]
static mut G_ANS_E: [usize; 512] = [0; 512]
static mut G_ANS_N: usize = 0
static mut G_COPIED_IDX: usize = 9999999
static mut G_COPIED_UNTIL: i64 = 0
static mut G_COPY_ICON: i64 = -1
static mut G_CHECK_ICON: i64 = -1
const COPY_PT: usize = 16
const ICON_GAP_PT: usize = 16 // space between the copy / speak / retry icons of the meta line
static mut G_SPEAK_ICON: i64 = -1
static mut G_RETRY_ICON: i64 = -1
static mut G_LAST_USER: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 } // the last message of the person (Retry sends it again)

static mut G_SPIN: usize = 0 // composer: busy marker (shown while an answer is being made)
static mut G_SENT_MS: i64 = 0 // when the last message went out (the meta line under the answer shows how long it took)
static mut G_USE_A: i64 = -1 // usage strip: percent of the 5 h window, -1 = unknown
static mut G_USE_B: i64 = -1 // usage strip: percent of the week window
static mut G_USE_NAME: usize = 0 // usage strip: the provider name label ("Claude" / "Kimi")
static mut G_USE_PROV: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }
static mut G_USE_R5: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 } // ISO reset time of the 5 h window ("" = unknown)
static mut G_USE_R7: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }
const INFO_LINES: usize = 6
// the info panel (answer details / usage details) is DRAWN over the top of the chat view (paint_info): it takes no layout room, so
// the composer and the usage strip never move when it opens
static mut G_INFO_ON: bool = false
static mut G_INFO_N: usize = 0
static mut G_INFO_BUF: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }
static mut G_INFO_OFF: [usize; 6] = [0; 6]
static mut G_INFO_LEN: [usize; 6] = [0; 6]
static mut G_ANS_DUR: [i64; 512] = [0; 512] // per answer: run time (ms, 0 = unknown), time it finished (ms, 0 = unknown), model label (pool offset / length)
static mut G_ANS_FIN: [i64; 512] = [0; 512]
static mut G_ANS_MO: [usize; 512] = [0; 512]
static mut G_ANS_ML: [usize; 512] = [0; 512]
static mut G_ANS_POOL: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }
static mut G_USE_PA: usize = 0
static mut G_USE_PB: usize = 0
static mut G_VIEW_H: f64 = 0.0
static mut G_AT_BOTTOM: bool = true
static mut G_MD: u64 = 0
static mut G_NODE: usize = 0
static mut G_IN: usize = 0
static mut G_COPY: usize = 0
static mut G_PHOTO: usize = 0
static mut G_FOLLOW: bool = true
static mut G_ANS_AT: usize = 0
static mut G_SPLIT: usize = 0 // where the tool step group of the streamed answer sits: behind the text said before the first tool call
static mut G_TXT_AT: usize = 0 // start of the streamed text not yet folded into the steps (text between two tool calls goes into the group)
static mut G_HELD: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 } // history: the last answer text, held until we know whether a tool call follows (then it is folded into the steps)
static mut G_HELD_ON: bool = false
static mut G_HELD_DUR: i64 = 0
static mut G_HELD_AT: i64 = 0
static mut G_HIST_ASKED: bool = false
static mut G_BUSY: bool = false
static mut G_MIC: usize = 0
static mut G_VOICE: bool = false
static mut G_STT_WAIT: bool = false
static mut G_REC: bool = false
static mut G_PHOTO_N: usize = 0
static mut G_CHAT: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }
static mut G_PHOTO_BUF: u64 = 0 // PHOTO_CAP octets; G_FILE_BUF (FILE_CAP) is made at the first file
static mut G_FILE_BUF: u64 = 0
static mut G_UPLOADING: bool = false
static mut G_PENDING: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 } // the text waiting for its upload
static mut G_DL_BUSY: bool = false
static mut G_DL_NAME: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }
static mut G_DL_MIME: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }
static mut G_DL_QUEUE: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 } // waiting files: url \x01 name \x01 mime \n per file
static mut G_LIMIT_SET: bool = false
static mut G_VIEW_ON: bool = false // the full-screen picture is open (drawn over the chat view)
static mut G_VIEW_URL: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }
static mut G_ATT_ROW: usize = 0 // the Photo / File buttons under "+"
static mut G_ATT_KIND: i64 = 0 // what waits in G_PHOTO_BUF: 0 photo, 1 file
static mut G_PICKING: i64 = -1 // the picker that is open: 0 photo, 1 file, -1 none
static mut G_ATT_NAME: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }
static mut G_ATT_MIME: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }

const PHOTO_CAP: usize = 3145728 // the picker hands out JPEGs up to this size (window.pick_set_limit)
const FILE_CAP: usize = 20971520 // a file up to this size (the limit of POST /api/m/upload); the buffer is made at the first file

fn mdv() -> *mut markdownview.MdView { return G_MD as *mut markdownview.MdView }

static mut G_VIEW: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 } // the source of the view: G_CHAT with the tool step groups expanded (jsteps)

fn chat_changed() {
    jsteps.compose(&G_CHAT, G_SPLIT, &G_VIEW)
    markdownview.mdv_set_markdown(mdv(), str { p: G_VIEW.ptr as *mut u8, n: G_VIEW.len }, doc.opts_default())
    G_FOLLOW = true
}

// a tap on a link of the view: the tool step headers / "more lines" toggle (jsteps); the view keeps its scroll position
fn on_md_link(ud: u64, p: u64, n: usize) {
    if jsteps.on_link(p, n) {
        let off: f64 = markdownview.mdv_offset(mdv())
        chat_changed()
        G_FOLLOW = false
        markdownview.mdv_set_offset(mdv(), off)
        return
    }
    on_link(ud, p, n)
}

fn chat_add(s: str) {
    rt.buf_push_bytes(&G_CHAT, s.p as u64, s.n)
    chat_changed()
}

// ---- meta line under an answer: "28s · 20:15" (duration of the run, time it finished; a date is added when it was not today)
fn two_digits(v: i64) -> str {
    if v < 10 { return "0" + jshell.dec(v) }
    return jshell.dec(v)
}

fn dur_text(ms: i64) -> str {
    let secs: i64 = (ms + 500) / 1000
    if secs < 60 { return jshell.dec(secs) + "s" }
    let m: i64 = secs / 60
    if m < 60 {
        if secs % 60 == 0 { return jshell.dec(m) + "m" }
        return jshell.dec(m) + "m " + jshell.dec(secs % 60) + "s"
    }
    if m % 60 == 0 { return jshell.dec(m / 60) + "h" }
    return jshell.dec(m / 60) + "h " + jshell.dec(m % 60) + "m"
}

fn clock_text(ms: i64) -> str {
    let off: i64 = screen_sidebar.local_offset_min(ms) * 60000
    let d: time.DateTime = time.civil_from_unix(ms + off)
    let now: i64 = time.now_unix_ms()
    let n: time.DateTime = time.civil_from_unix(now + screen_sidebar.local_offset_min(now) * 60000)
    let hm: str = two_digits(d.hour as i64) + ":" + two_digits(d.minute as i64)
    if d.year == n.year && d.month == n.month && d.day == n.day { return hm }
    return two_digits(d.day as i64) + "." + two_digits(d.month as i64) + ". " + hm
}

// dur_ms <= 0 = unknown, at_ms <= 0 = unknown (fallback "Jarvis")
fn meta_text(dur_ms: i64, at_ms: i64) -> str {
    if dur_ms > 0 && at_ms > 0 { return dur_text(dur_ms) + " · " + clock_text(at_ms) }
    if dur_ms > 0 { return dur_text(dur_ms) }
    if at_ms > 0 { return clock_text(at_ms) }
    return "Jarvis"
}

// "genMs,at" of a history answer (jarvisc jc_id) -> run time and finish time in ms (0 = the server did not store it)
fn parse_hist_id(id: str, dur: *mut i64, at: *mut i64) {
    var i: usize = 0
    var a: i64 = 0
    var b: i64 = 0
    var second: bool = false
    while i < id.n {
        let ch: u8 = rt.ld8(id.p as u64, i)
        if ch == 44 as u8 { second = true }
        else if ch >= 48 as u8 && ch <= 57 as u8 {
            if second { b = b * 10 + (ch - 48 as u8) as i64 } else { a = a * 10 + (ch - 48 as u8) as i64 }
        }
        i = i + 1
    }
    *dur = a
    *at = b
}

// an assistant answer + its meta line (the line carries the action icons, see paint_copy_icons; a tap on the line opens the details)
// dur_ms / at_ms <= 0 = unknown; model = label of the model that answered ("" = unknown)
fn chat_add_answer(text: str, dur_ms: i64, at_ms: i64, model: str) {
    let meta: str = meta_text(dur_ms, at_ms)
    let s: usize = G_CHAT.len
    rt.buf_push_bytes(&G_CHAT, text.p as u64, text.n)
    if G_ANS_N < ANS_MAX {
        G_ANS_S[G_ANS_N] = s
        G_ANS_E[G_ANS_N] = G_CHAT.len
        G_ANS_DUR[G_ANS_N] = dur_ms
        G_ANS_FIN[G_ANS_N] = at_ms
        G_ANS_MO[G_ANS_N] = G_ANS_POOL.len
        G_ANS_ML[G_ANS_N] = model.n
        rt.buf_push_bytes(&G_ANS_POOL, model.p as u64, model.n)
    }
    G_ANS_N = G_ANS_N + 1
    rt.buf_push_bytes(&G_CHAT, "\n\n###### ".p as u64, 9)
    rt.buf_push_bytes(&G_CHAT, meta.p as u64, meta.n)
    rt.buf_push_bytes(&G_CHAT, "\n\n".p as u64, 2)
    chat_changed()
}

// plain text (no meta line, no copy icons): the words said before the first tool call
fn chat_add_plain(text: str) {
    rt.buf_push_bytes(&G_CHAT, text.p as u64, text.n)
    rt.buf_push_bytes(&G_CHAT, "\n\n".p as u64, 2)
    chat_changed()
}

// history: the held answer text becomes a real answer (the group collected before it comes first)
fn release_held() {
    if !G_HELD_ON { return }
    G_HELD_ON = false
    jsteps.flush(&G_CHAT)
    chat_add_answer(__str_copy(str { p: G_HELD.ptr as *mut u8, n: G_HELD.len }), G_HELD_DUR, G_HELD_AT, "")
}

// live: the text streamed since the last tool call goes into the steps (web: the bot text between tools is folded)
fn fold_text() {
    if G_CHAT.len > G_TXT_AT {
        jsteps.add_text(str { p: ((G_CHAT.ptr as u64) + G_TXT_AT as u64) as *mut u8, n: G_CHAT.len - G_TXT_AT })
        G_CHAT.len = G_TXT_AT
    }
}

// a message of the person: a block quote, which the markdown view draws as the web app's blue bubble at the right edge (mdv_set_bubble)
fn chat_add_user(t: str) {
    rt.buf_clear(&G_LAST_USER)
    rt.buf_push_bytes(&G_LAST_USER, t.p as u64, t.n)
    rt.buf_push_bytes(&G_CHAT, "> ".p as u64, 2)
    var i: usize = 0
    var from: usize = 0
    while i < t.n {
        if rt.ld8(t.p as u64, i) == 10 as u8 {
            rt.buf_push_bytes(&G_CHAT, (t.p as u64) + from as u64, i + 1 - from)
            rt.buf_push_bytes(&G_CHAT, "> ".p as u64, 2)
            from = i + 1
        }
        i = i + 1
    }
    if t.n > from { rt.buf_push_bytes(&G_CHAT, (t.p as u64) + from as u64, t.n - from) }
    rt.buf_push_bytes(&G_CHAT, "\n\n".p as u64, 2)
    chat_changed()
}

fn chat_clear() {
    G_VIEW_ON = false
    jimg.reset()
    G_ANS_N = 0
    rt.buf_clear(&G_ANS_POOL)
    jsteps.reset()
    G_HELD_ON = false
    G_SPLIT = 0
    G_TXT_AT = 0
    rt.buf_clear(&G_CHAT)
    chat_changed()
    G_HIST_ASKED = false
}

// the markdown view drew itself into the node's rectangle (set in the draw hook)
fn draw_chat(ud: u64, c: *mut render.Ctx, e: *mut widget.Widget) {
    let a: *mut app.App = jshell.app_ui()
    let sc: *mut scene.Scene = app.app_scene(a)
    let n: usize = scene.scene_node_of(sc, e)
    let v: *mut markdownview.MdView = mdv()
    // the view got shorter or taller (keyboard opened / closed, composer grew): a reader at the end stays at the end
    if G_VIEW_H > 0.0 && scene.node_h(sc, n) != G_VIEW_H && G_AT_BOTTOM { G_FOLLOW = true }
    markdownview.mdv_set_rect(v, scene.node_x(sc, n), scene.node_y(sc, n), scene.node_w(sc, n), scene.node_h(sc, n))
    markdownview.mdv_paint(v, c)
    if G_FOLLOW {
        G_FOLLOW = false
        markdownview.mdv_set_offset(v, markdownview.mdv_content_height(v))
        markdownview.mdv_paint(v, c)
    }
    G_VIEW_H = scene.node_h(sc, n)
    G_AT_BOTTOM = markdownview.mdv_offset(v) + G_VIEW_H + render.len_of(c, 24) >= markdownview.mdv_content_height(v)
    paint_copy_icons(c, scene.node_x(sc, n), scene.node_y(sc, n), scene.node_h(sc, n))
    if !G_AT_BOTTOM { paint_chip(c, scene.node_x(sc, n), scene.node_y(sc, n), scene.node_w(sc, n)) }
    if G_INFO_ON { paint_info(c, scene.node_x(sc, n), scene.node_y(sc, n), scene.node_w(sc, n)) }
    if G_VIEW_ON { paint_viewer(c, scene.node_x(sc, n), scene.node_y(sc, n), scene.node_w(sc, n), scene.node_h(sc, n)) }
}

// ---- full-screen picture: black ground over the chat view, the picture fitted into it, a round close button top right;
// a tap anywhere (or Android Back, screen_chat_viewer_back) closes it. Never Back on the root.
fn view_close_rect(c: *mut render.Ctx, x: f64, y: f64, w: f64, cx: *mut f64, cy: *mut f64, cs: *mut f64) {
    let s: f64 = render.len_of(c, 40)
    *cs = s
    *cx = x + w - s - render.len_of(c, 12)
    *cy = y + render.len_of(c, 12)
}

fn paint_viewer(c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let f: *mut theme.Colors = theme.theme_colors(render.ctx_theme(c))
    painter.round_rect(z, x, y, w, h, 0.0, 0xFF000000 as u32)
    var px: u64 = 0
    var iw: usize = 0
    var ih: usize = 0
    if !jimg.lookup(G_VIEW_URL.ptr, G_VIEW_URL.len, &px, &iw, &ih) {
        G_VIEW_ON = false
        return
    }
    var sc: f64 = w / (iw as f64)
    let sh: f64 = h / (ih as f64)
    if sh < sc { sc = sh }
    let dw: f64 = (iw as f64) * sc
    let dh: f64 = (ih as f64) * sc
    var im: uiimage.Image = uiimage.image_wrap(px, iw, ih, 0)
    uiimage.image_draw_rect(z, &im, x + (w - dw) * 0.5, y + (h - dh) * 0.5, dw, dh, 0)
    var cx: f64 = 0.0
    var cy: f64 = 0.0
    var cs: f64 = 0.0
    view_close_rect(c, x, y, w, &cx, &cy, &cs)
    painter.round_rect(z, cx, cy, cs, cs, cs * 0.5, (*f).surface)
    let isz: f64 = render.len_of(c, 22)
    icons.icon_stroke(z, listrow.icon_named("x"), cx + (cs - isz) * 0.5, cy + (cs - isz) * 0.5, isz, (*f).text, icons.STROKE_DEFAULT)
}

// Android Back: closes the picture first (true = consumed)
fn screen_chat_viewer_back() -> bool {
    if G_VIEW_ON {
        G_VIEW_ON = false
        return true
    }
    if G_INFO_ON {
        G_INFO_ON = false
        return true
    }
    return false
}

fn screen_chat_viewer_open() -> bool { return G_VIEW_ON || G_INFO_ON } // the info card counts: Back closes it first

// composer position for the geom log line (keyboard diagnosis)
fn screen_chat_geom(a: *mut app.App) -> str {
    let sc: *mut scene.Scene = app.app_scene(a)
    if G_IN == 0 { return "" }
    return " in_y=" + jshell.dec(scene.node_y(sc, G_IN) as i64) + " in_h=" + jshell.dec(scene.node_h(sc, G_IN) as i64)
}

// a tap on a picture of the chat: ready = full screen, failed = ask again, loading = nothing
fn on_image_tap(ud: u64, p: u64, n: usize, st: u32) {
    if st == markdownview.IMG_READY {
        rt.buf_clear(&G_VIEW_URL)
        rt.buf_push_bytes(&G_VIEW_URL, p, n)
        G_VIEW_ON = true
    } else if st == markdownview.IMG_FAILED {
        jimg.retry(p, n)
        jshell.set_status(jtexts.t("chat.img-reload"))
    }
}

fn ends_ci(s: str, ext: str) -> bool {
    if s.n < ext.n { return false }
    var i: usize = 0
    while i < ext.n {
        var a: u8 = rt.ld8(s.p as u64, s.n - ext.n + i)
        if a >= 65 as u8 && a <= 90 as u8 { a = a + 32 as u8 }
        if a != rt.ld8(ext.p as u64, i) { return false }
        i = i + 1
    }
    return true
}

fn mime_of(name: str) -> str {
    if ends_ci(name, ".pdf") { return "application/pdf" }
    if ends_ci(name, ".png") { return "image/png" }
    if ends_ci(name, ".jpg") || ends_ci(name, ".jpeg") { return "image/jpeg" }
    if ends_ci(name, ".gif") { return "image/gif" }
    if ends_ci(name, ".webp") { return "image/webp" }
    if ends_ci(name, ".txt") || ends_ci(name, ".log") || ends_ci(name, ".md") { return "text/plain" }
    if ends_ci(name, ".json") { return "application/json" }
    if ends_ci(name, ".csv") { return "text/csv" }
    if ends_ci(name, ".zip") { return "application/zip" }
    if ends_ci(name, ".mp3") { return "audio/mpeg" }
    if ends_ci(name, ".mp4") { return "video/mp4" }
    if ends_ci(name, ".apk") { return "application/vnd.android.package-archive" }
    if ends_ci(name, ".docx") { return "application/vnd.openxmlformats-officedocument.wordprocessingml.document" }
    if ends_ci(name, ".xlsx") { return "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" }
    if ends_ci(name, ".pptx") { return "application/vnd.openxmlformats-officedocument.presentationml.presentation" }
    return "application/octet-stream"
}

// a link of the chat: a file of the server (/file/.., /img/..) is fetched and opened; an https address opens in the browser
#[allow_escape]
fn on_link(ud: u64, p: u64, n: usize) {
    let url: str = __str_copy(str { p: p as *mut u8, n: n })
    if url.n > 6 && (rt.ld8(url.p as u64, 0) == 47 as u8) {
        var q: usize = url.n
        var i: usize = 0
        while i < url.n {
            if rt.ld8(url.p as u64, i) == 63 as u8 { q = i; i = url.n }
            i = i + 1
        }
        var s: usize = q
        while s > 0 && rt.ld8(url.p as u64, s - 1) != 47 as u8 { s = s - 1 }
        let name: str = __str_copy(str { p: (url.p as u64 + s as u64) as *mut u8, n: q - s })
        var full: str = url
        if q == url.n { full = url + "?dl=1" }
        jshell.set_status(name + " ...")
        queue_download(full, name, mime_of(name))
        return
    }
    if !fileio.fio_open_url(url) { jshell.set_status(jtexts.t("chat.link-bad")) }
}

// ---- action icons right of the meta line of each answer (web: the footer buttons): 0 copy, 1 speak, 2 retry (last answer only)
const ACT_COPY: usize = 0
const ACT_SPEAK: usize = 1
const ACT_RETRY: usize = 2
const ACT_NONE: usize = 9999999

// is icon k shown under answer i? (Retry: only the newest answer, only while nothing is running, only when there is a message to send again)
fn act_shown(i: usize, k: usize) -> bool {
    if k != ACT_RETRY { return true }
    return i + 1 == G_ANS_N && !G_BUSY && G_LAST_USER.len > 0
}

// window rectangle of icon k of answer i (right of its meta line); false = no such line / icon or not fully inside the view
fn act_rect(c: *mut render.Ctx, i: usize, k: usize, ny: f64, nh: f64, rx: *mut f64, ry: *mut f64, rs: *mut f64) -> bool {
    var x: f64 = 0.0
    var y: f64 = 0.0
    var w: f64 = 0.0
    var h: f64 = 0.0
    if i >= G_ANS_N || i >= ANS_MAX || !act_shown(i, k) { return false }
    if !markdownview.mdv_meta_rect(mdv(), i, &x, &y, &w, &h) { return false }
    let side: f64 = render.len_of(c, COPY_PT)
    *rs = side
    *rx = x + w + render.len_of(c, 8) + (side + render.len_of(c, ICON_GAP_PT)) * k as f64
    *ry = y + (h - side) * 0.5
    return *ry >= ny && *ry + side <= ny + nh
}

fn paint_copy_icons(c: *mut render.Ctx, nx: f64, ny: f64, nh: f64) {
    if G_COPY_ICON < 0 {
        G_COPY_ICON = listrow.icon_named("copy")
        G_CHECK_ICON = listrow.icon_named("check")
        G_SPEAK_ICON = listrow.icon_named("volume-2")
        G_RETRY_ICON = listrow.icon_named("refresh-cw")
    }
    let f: *mut theme.Colors = theme.theme_colors(render.ctx_theme(c))
    let now: i64 = time.now_unix_ms()
    var i: usize = 0
    let shown: usize = markdownview.mdv_meta_count(mdv())
    while i < shown {
        var k: usize = 0
        while k < 3 {
            var rx: f64 = 0.0
            var ry: f64 = 0.0
            var rs: f64 = 0.0
            if act_rect(c, i, k, ny, nh, &rx, &ry, &rs) {
                var id: i64 = G_COPY_ICON
                var col: u32 = (*f).text_muted
                if k == ACT_SPEAK { id = G_SPEAK_ICON }
                if k == ACT_RETRY { id = G_RETRY_ICON }
                if k == ACT_COPY && i == G_COPIED_IDX && now < G_COPIED_UNTIL {
                    id = G_CHECK_ICON
                    col = (*f).accent
                }
                jicons.draw_at(c, id, rx, ry, rs, col)
            }
            k = k + 1
        }
        i = i + 1
    }
}

// the icon the tap (window coordinates) hit: answer * 4 + icon, else ACT_NONE
fn act_hit(a: *mut app.App, tx: f64, ty: f64) -> usize {
    let sc: *mut scene.Scene = app.app_scene(a)
    let c: *mut render.Ctx = app.app_ctx(a)
    let mv: f64 = render.len_of(c, 10)
    let mh: f64 = render.len_of(c, ICON_GAP_PT) * 0.5 // sideways: half the gap, so neighbours do not overlap
    var i: usize = 0
    let shown: usize = markdownview.mdv_meta_count(mdv())
    while i < shown {
        var k: usize = 0
        while k < 3 {
            var rx: f64 = 0.0
            var ry: f64 = 0.0
            var rs: f64 = 0.0
            if act_rect(c, i, k, scene.node_y(sc, G_NODE), scene.node_h(sc, G_NODE), &rx, &ry, &rs) {
                if tx >= rx - mh && tx <= rx + rs + mh && ty >= ry - mv && ty <= ry + rs + mv { return i * 4 + k }
            }
            k = k + 1
        }
        i = i + 1
    }
    return ACT_NONE
}

// copy answer i to the system clipboard (window.clipboard_set = ClipboardManager on Android)
fn copy_answer(i: usize) {
    if i >= ANS_MAX || i >= G_ANS_N { return }
    let s: usize = G_ANS_S[i]
    let e: usize = G_ANS_E[i]
    if e <= s || e > G_CHAT.len { return }
    if clip_write((G_CHAT.ptr as u64) + s as u64, e - s) {
        G_COPIED_IDX = i
        G_COPIED_UNTIL = time.now_unix_ms() + 1500
        jshell.set_status("Kopiert")
    } else {
        jshell.set_status("Kopieren fehlgeschlagen")
    }
}

// read answer i aloud (Android: the system speech output behind plat.voiceio); a second tap on the same icon while it speaks is not special-cased: it restarts
fn speak_answer(i: usize) {
    if i >= ANS_MAX || i >= G_ANS_N { return }
    let s: usize = G_ANS_S[i]
    let e: usize = G_ANS_E[i]
    if e <= s || e > G_CHAT.len { return }
    voiceio.vio_say_stop()
    let txt: str = __str_copy(str { p: ((G_CHAT.ptr as u64) + s as u64) as *mut u8, n: e - s })
    if !voiceio.vio_say(txt) { jshell.set_status(jtexts.t("chat.no-speech")) }
}

// send the last message of the person again
fn retry_last(a: *mut app.App) {
    if G_BUSY || G_LAST_USER.len == 0 { return }
    let t: str = __str_copy(str { p: G_LAST_USER.ptr as *mut u8, n: G_LAST_USER.len })
    send_text(a, t)
}

// ---- info panel (under the header, like the model dropdown; fUi has no overlays): answer details and usage details
// "19.10.2026 20:15" in local time
fn stamp_text(ms: i64) -> str {
    let d: time.DateTime = time.civil_from_unix(ms + screen_sidebar.local_offset_min(ms) * 60000)
    return two_digits(d.day as i64) + "." + two_digits(d.month as i64) + "." + jshell.dec(d.year as i64) + " " + two_digits(d.hour as i64) + ":" + two_digits(d.minute as i64)
}

// ISO 8601 text -> epoch ms, 0 when it does not parse
fn iso_ms(s: str) -> i64 {
    if s.n == 0 { return 0 }
    let t: time.DateTime = time.parse_iso8601(s) catch | e | time.DateTime { year: 0, month: 0 as u32, day: 0 as u32, hour: 0 as u32, minute: 0 as u32, second: 0 as u32, ms: 0 as u32, offset_min: 0 as i32 }
    if t.year == 0 { return 0 }
    return time.unix_from_civil(t)
}

fn info_clear(a: *mut app.App) {
    rt.buf_clear(&G_INFO_BUF)
    G_INFO_N = 0
}

fn info_line(a: *mut app.App, i: usize, text: str) {
    if G_INFO_N >= INFO_LINES { return }
    G_INFO_OFF[G_INFO_N] = G_INFO_BUF.len
    G_INFO_LEN[G_INFO_N] = text.n
    rt.buf_push_bytes(&G_INFO_BUF, text.p as u64, text.n)
    G_INFO_N = G_INFO_N + 1
}

fn info_close(a: *mut app.App) { G_INFO_ON = false }

fn info_open(a: *mut app.App) {
    if G_DD_OPEN { dd_show(a, false) }
    G_INFO_ON = true
}

// the card and its close chip in window pixels (a41 overlay: the card hangs from the top edge of the chat view)
fn info_rects(c: *mut render.Ctx, nx: f64, ny: f64, nw: f64, r: *mut [f64; 8]) {
    let m: f64 = render.len_of(c, 8)
    let pad: f64 = render.len_of(c, 12)
    let title_h: f64 = render.len_of(c, 28)
    let line_h: f64 = render.len_of(c, 22)
    let chip_h: f64 = render.len_of(c, 40)
    var h: f64 = pad + chip_h + pad + render.len_of(c, 8)
    if G_INFO_N > 0 { h = h + title_h + line_h * ((G_INFO_N - 1) as f64) }
    (*r)[0] = nx + m
    (*r)[1] = ny + m
    (*r)[2] = nw - m * 2.0
    (*r)[3] = h
    (*r)[4] = nx + m + pad
    (*r)[5] = ny + m + h - pad - chip_h
    (*r)[6] = render.len_of(c, 112)
    (*r)[7] = chip_h
}

fn paint_info(c: *mut render.Ctx, nx: f64, ny: f64, nw: f64) {
    var r: [f64; 8] = [0.0; 8]
    info_rects(c, nx, ny, nw, &r)
    let z: *mut painter.Painter = render.ctx_painter(c)
    let f: *mut theme.Colors = theme.theme_colors(render.ctx_theme(c))
    let rad: f64 = render.len_of(c, 14)
    let pad: f64 = render.len_of(c, 12)
    painter.round_rect(z, r[0], r[1], r[2], r[3], rad, (*f).separator)
    painter.round_rect(z, r[0] + 1.0, r[1] + 1.0, r[2] - 2.0, r[3] - 2.0, rad - 1.0, theme.opaque((*f).surface))
    var y: f64 = r[1] + pad
    var i: usize = 0
    while i < G_INFO_N {
        var lh: f64 = render.len_of(c, 22)
        var px: usize = 13
        var wt: u32 = 400 as u32
        var fg: u32 = style.color_token(style.TOK_TEXT_MUTED)
        if i == 0 {
            lh = render.len_of(c, 28)
            px = 17
            wt = 600 as u32
            fg = style.color_token(style.TOK_TEXT)
        }
        wave3.cell_text_weight(c, (G_INFO_BUF.ptr as u64) + G_INFO_OFF[i] as u64, G_INFO_LEN[i], r[0] + pad, y, r[2] - pad * 2.0, lh, fg, style.ALIGN_LEFT, px, wt)
        y = y + lh
        i = i + 1
    }
    let cr: f64 = r[7] * 0.5
    painter.round_rect(z, r[4], r[5], r[6], r[7], cr, (*f).separator)
    painter.round_rect(z, r[4] + 1.0, r[5] + 1.0, r[6] - 2.0, r[7] - 2.0, cr - 1.0, theme.opaque((*f).base))
    let lbl: str = jtexts.t("info.close")
    wave3.cell_text_weight(c, lbl.p as u64, lbl.n, r[4], r[5], r[6], r[7], style.color_token(style.TOK_TEXT), style.ALIGN_CENTER, 14, 400 as u32)
}

// a tap while the card is open: the close chip or anything outside the card closes it, a tap on the card itself does nothing
fn info_tap(a: *mut app.App, tx: f64, ty: f64) {
    let sc: *mut scene.Scene = app.app_scene(a)
    let c: *mut render.Ctx = app.app_ctx(a)
    var r: [f64; 8] = [0.0; 8]
    info_rects(c, scene.node_x(sc, G_NODE), scene.node_y(sc, G_NODE), scene.node_w(sc, G_NODE), &r)
    let m: f64 = render.len_of(c, 6)
    let on_chip: bool = tx >= r[4] - m && tx <= r[4] + r[6] + m && ty >= r[5] - m && ty <= r[5] + r[7] + m
    let on_card: bool = tx >= r[0] && tx <= r[0] + r[2] && ty >= r[1] && ty <= r[1] + r[3]
    if on_chip || !on_card { G_INFO_ON = false }
}

// the details of answer i: duration, start and end, model, length (the API carries no token counts or costs)
fn show_answer_info(a: *mut app.App, i: usize) {
    if i >= ANS_MAX || i >= G_ANS_N { return }
    info_clear(a)
    var n: usize = 0
    info_line(a, n, jtexts.t("info.answer"))
    n = n + 1
    if G_ANS_DUR[i] > 0 {
        info_line(a, n, jtexts.t1("info.dur", "value", dur_text(G_ANS_DUR[i])))
        n = n + 1
    }
    if G_ANS_FIN[i] > 0 {
        if G_ANS_DUR[i] > 0 {
            info_line(a, n, jtexts.t1("info.start", "value", stamp_text(G_ANS_FIN[i] - G_ANS_DUR[i])))
            n = n + 1
        }
        info_line(a, n, jtexts.t1("info.done", "value", stamp_text(G_ANS_FIN[i])))
        n = n + 1
    }
    if G_ANS_ML[i] > 0 && G_ANS_MO[i] + G_ANS_ML[i] <= G_ANS_POOL.len {
        info_line(a, n, jtexts.t1("info.model", "value", __str_copy(str { p: ((G_ANS_POOL.ptr as u64) + G_ANS_MO[i] as u64) as *mut u8, n: G_ANS_ML[i] })))
        n = n + 1
    }
    // characters (UTF-8 lead bytes) of the answer text
    var chars: i64 = 0
    var k: usize = G_ANS_S[i]
    while k < G_ANS_E[i] && k < G_CHAT.len {
        let b: u8 = rt.ld8(G_CHAT.ptr as u64, k)
        if (b & 192 as u8) != 128 as u8 { chars = chars + 1 }
        k = k + 1
    }
    info_line(a, n, jtexts.t1("info.chars", "value", jshell.dec(chars)))
    info_open(a)
}

fn pct_text(p: i64) -> str {
    if p < 0 { return "-" }
    return jshell.dec(p) + "%"
}

// the usage details: the two percentages, when each window resets (local time), the provider like the web
fn on_usage_tap_ev(ud: u64, e: *mut event.Ev) -> u32 {
    on_usage_tap(jshell.app_ui())
    return event.H_STOP
}

fn on_usage_tap(a: *mut app.App) {
    info_clear(a)
    if G_USE_A < 0 && G_USE_B < 0 {
        info_line(a, 0, jtexts.t("use.none"))
        info_open(a)
        return
    }
    var name: str = jtexts.t("chat.usage-name")
    if G_USE_PROV.len > 0 { name = __str_copy(str { p: G_USE_PROV.ptr as *mut u8, n: G_USE_PROV.len }) }
    var n: usize = 0
    info_line(a, n, jtexts.t1("use.title", "value", name))
    n = n + 1
    if G_USE_A >= 0 {
        info_line(a, n, jtexts.t1("use.p5", "value", pct_text(G_USE_A)))
        n = n + 1
        let r5: i64 = iso_ms(str { p: G_USE_R5.ptr as *mut u8, n: G_USE_R5.len })
        if r5 > 0 {
            info_line(a, n, jtexts.t1("use.r5", "value", stamp_text(r5)))
            n = n + 1
        }
    }
    if G_USE_B >= 0 {
        info_line(a, n, jtexts.t1("use.p7", "value", pct_text(G_USE_B)))
        n = n + 1
        let r7: i64 = iso_ms(str { p: G_USE_R7.ptr as *mut u8, n: G_USE_R7.len })
        if r7 > 0 {
            info_line(a, n, jtexts.t1("use.r7", "value", stamp_text(r7)))
            n = n + 1
        }
    }
    info_open(a)
}

// the meta line (rectangle of its text) the tap hit, else ACT_NONE
fn meta_hit(a: *mut app.App, tx: f64, ty: f64) -> usize {
    let c: *mut render.Ctx = app.app_ctx(a)
    let mv: f64 = render.len_of(c, 8)
    var i: usize = 0
    let shown: usize = markdownview.mdv_meta_count(mdv())
    while i < shown && i < G_ANS_N && i < ANS_MAX {
        var x: f64 = 0.0
        var y: f64 = 0.0
        var w: f64 = 0.0
        var h: f64 = 0.0
        if markdownview.mdv_meta_rect(mdv(), i, &x, &y, &w, &h) {
            if tx >= x - mv && tx <= x + w + mv && ty >= y - mv && ty <= y + h + mv { return i }
        }
        i = i + 1
    }
    return ACT_NONE
}

// the round "scroll to the end" chip at the top centre of the view (web: the arrow chip above the messages)
const CHIP_PT: usize = 32
fn chip_rect(c: *mut render.Ctx, x: f64, y: f64, w: f64, rx: *mut f64, ry: *mut f64, rs: *mut f64) {
    let side: f64 = render.len_of(c, CHIP_PT)
    *rs = side
    *rx = x + (w - side) * 0.5
    *ry = y + render.len_of(c, 6)
}

fn paint_chip(c: *mut render.Ctx, x: f64, y: f64, w: f64) {
    var cx: f64 = 0.0
    var cy: f64 = 0.0
    var cs: f64 = 0.0
    chip_rect(c, x, y, w, &cx, &cy, &cs)
    let f: *mut theme.Colors = theme.theme_colors(render.ctx_theme(c))
    let z: *mut painter.Painter = render.ctx_painter(c)
    painter.round_rect(z, cx, cy, cs, cs, cs * 0.5, (*f).separator)
    painter.round_rect(z, cx + 1.0, cy + 1.0, cs - 2.0, cs - 2.0, cs * 0.5 - 1.0, (*f).surface)
    let isz: f64 = render.len_of(c, 18)
    icons.icon_stroke(z, listrow.icon_named("chevron-down"), cx + (cs - isz) * 0.5, cy + (cs - isz) * 0.5, isz, (*f).text_muted, icons.STROKE_DEFAULT)
}

// true when the tap (window coordinates) hits the chip
fn chip_hit(a: *mut app.App, tx: f64, ty: f64) -> bool {
    if G_AT_BOTTOM { return false }
    let sc: *mut scene.Scene = app.app_scene(a)
    let c: *mut render.Ctx = app.app_ctx(a)
    var cx: f64 = 0.0
    var cy: f64 = 0.0
    var cs: f64 = 0.0
    chip_rect(c, scene.node_x(sc, G_NODE), scene.node_y(sc, G_NODE), scene.node_w(sc, G_NODE), &cx, &cy, &cs)
    let m: f64 = render.len_of(c, 8)
    return tx >= cx - m && tx <= cx + cs + m && ty >= cy - m && ty <= cy + cs + m
}

fn clip_write(p: u64, n: usize) -> bool {
    if cliptext.clip_put(p, n) { return true } // Android: ClipboardManager (window.clipboard_set is not connected there)
    if jshell.win() as u64 == 0 { return false }
    return window.clipboard_set(jshell.win(), "text/plain", p, n)
}

// true when the point (window coordinates) lies on the chat view
fn screen_chat_in_node(x: f64, y: f64) -> bool {
    let sc: *mut scene.Scene = app.app_scene(jshell.app_ui())
    return x >= scene.node_x(sc, G_NODE) && x < scene.node_x(sc, G_NODE) + scene.node_w(sc, G_NODE)
    && y >= scene.node_y(sc, G_NODE) && y < scene.node_y(sc, G_NODE) + scene.node_h(sc, G_NODE)
}

fn on_touch(ud: u64, e: *mut event.Ev) -> u32 {
    let a: *mut app.App = ud as *mut app.App
    let k: u32 = event.ev_kind(e)
    let v: *mut markdownview.MdView = mdv()
    if G_VIEW_ON {
        // the full-screen picture takes every gesture; a tap closes it
        if k == event.EV_TAP { G_VIEW_ON = false }
        return event.H_STOP
    }
    if G_INFO_ON && k == event.EV_TAP {
        info_tap(a, event.ev_x(e), event.ev_y(e))
        return event.H_STOP
    }
    if k == event.EV_PAN_MOVE {
        markdownview.mdv_touch_pan(v, event.ev_dx(e), event.ev_dy(e))
        return event.H_STOP
    }
    if k == event.EV_PAN_END && event.ev_fling(e) {
        markdownview.mdv_touch_fling(v, event.ev_vx(e), event.ev_vy(e), event.ev_time(e))
        return event.H_STOP
    }
    if k == event.EV_TAP {
        if chip_hit(a, event.ev_x(e), event.ev_y(e)) {
            G_FOLLOW = true
            markdownview.mdv_set_offset(v, markdownview.mdv_content_height(v))
            return event.H_STOP
        }
        let ci: usize = act_hit(a, event.ev_x(e), event.ev_y(e))
        if ci != ACT_NONE {
            if ci % 4 == ACT_COPY { copy_answer(ci / 4) }
            else if ci % 4 == ACT_SPEAK { speak_answer(ci / 4) }
            else { retry_last(a) }
            return event.H_STOP
        }
        let mi: usize = meta_hit(a, event.ev_x(e), event.ev_y(e))
        if mi != ACT_NONE {
            show_answer_info(a, mi)
            return event.H_STOP
        }
        let t: bool = markdownview.mdv_touch_tap(v, app.app_ctx(a), event.ev_x(e), event.ev_y(e))
        sel_changed(a)
        return event.H_STOP
    }
    if k == event.EV_LONG_PRESS {
        let t: bool = markdownview.mdv_touch_long(v, app.app_ctx(a), event.ev_x(e), event.ev_y(e))
        sel_changed(a)
        return event.H_STOP
    }
    return event.H_GO
}

// the Copy button is visible while text is selected
fn sel_changed(a: *mut app.App) {
    jshell.set_shown(a, G_COPY, markdownview.mdv_has_selection(mdv()), 0)
}

fn on_copy(a: *mut app.App) {
    let ok: bool = markdownview.mdv_copy(mdv())
    markdownview.mdv_clear_selection(mdv())
    sel_changed(a)
    jshell.set_status("Kopiert")
}

fn on_new(a: *mut app.App) {
    jarvisc.jc_new_chat(jshell.jc())
    chat_clear()
    G_PHOTO_N = 0
    app.set_text(a, G_PHOTO, "")
    jshell.set_status("Neuer Chat")
}

// ---- voice: microphone -> WAV -> /api/stt -> input line; speech output of the answers
fn on_voice(a: *mut app.App) {
    G_VOICE = !G_VOICE
    if G_VOICE {
        jtheme.style_node(a, G_SPK, jtheme.K_ICONBTN_ON)
        jicons.put(a, G_SPK, "volume-2")
        jshell.set_status(jtexts.t("chat.voice-on"))
    } else {
        let r: bool = scene.node_remove_class(app.app_scene(a), G_SPK, jtheme.K_ICONBTN_ON)
        jicons.put(a, G_SPK, "volume-x")
        jshell.set_status(jtexts.t("chat.voice-off"))
        voiceio.vio_say_stop()
    }
}

// header hooks: the hamburger (main.fi opens the chat list), the model pill, the sliders (Settings tab)
fn on_menu(a: *mut app.App) { screen_sidebar.sidebar_open(a) }
fn on_noop(a: *mut app.App) { }

// ---- model dropdown: the pill (or its chevron) opens a panel under the header with the enabled models and the effort levels
// line `idx` of buf `b` (up to the next newline) and its field `f` (fields are split by byte 1); "" when missing. A view into `b`.
fn line_field(b: *mut rt.Buf, idx: usize, f: usize) -> str {
    let p: u64 = (*b).ptr
    let n: usize = (*b).len
    var i: usize = 0
    var ln: usize = 0
    while ln < idx && i < n {
        if rt.ld8(p, i) == 10 as u8 { ln = ln + 1 }
        i = i + 1
    }
    var e: usize = i
    while e < n && rt.ld8(p, e) != 10 as u8 { e = e + 1 }
    var fs: usize = i
    var fi: usize = 0
    while fi < f && fs < e {
        if rt.ld8(p, fs) == 1 as u8 { fi = fi + 1 }
        fs = fs + 1
    }
    if fi < f { return "" }
    var fe: usize = fs
    while fe < e && rt.ld8(p, fe) != 1 as u8 { fe = fe + 1 }
    return str { p: (p + fs as u64) as *mut u8, n: fe - fs }
}

fn count_lines(b: *mut rt.Buf) -> usize {
    var k: usize = 0
    var i: usize = 0
    while i < (*b).len {
        if rt.ld8((*b).ptr, i) == 10 as u8 { k = k + 1 }
        i = i + 1
    }
    return k
}

fn buf_is(b: *mut rt.Buf, s: str) -> bool {
    return (*b).len == s.n && s.n > 0 && rt.mem_eq((*b).ptr, s.p as u64, s.n)
}

fn buf_set(b: *mut rt.Buf, s: str) {
    rt.buf_clear(b)
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

// "medium" -> "Medium"
fn cap_first(s: str) -> str {
    if s.n == 0 { return s }
    var b: rt.Buf = rt.buf_new()
    var c0: u8 = *(s.p)
    if c0 >= 97 as u8 && c0 <= 122 as u8 { c0 = c0 - 32 as u8 }
    rt.buf_push(&b, c0)
    rt.buf_push_bytes(&b, (s.p + 1) as u64, s.n - 1)
    let r: str = __str_copy(str { p: b.ptr as *mut u8, n: b.len })
    rt.buf_free(&b)
    return r
}

fn chip_on(a: *mut app.App, n: usize, on: bool) {
    if n == app.NONE { return }
    let sc: *mut scene.Scene = app.app_scene(a)
    let r: bool = scene.node_remove_class(sc, n, jtheme.K_CHIP_ON)
    if on { let q: bool = scene.node_add_class(sc, n, jtheme.K_CHIP_ON) }
}

// does the current model take an effort level (the 3rd field of its row)?
fn cur_has_effort() -> bool {
    var i: usize = 0
    while i < G_MN {
        if buf_is(&G_CUR_M, line_field(&G_ROWS, i, 0)) { return line_field(&G_ROWS, i, 2) == "1" }
        i = i + 1
    }
    return true
}

// the pill text: "Claude Sonnet 5.5 Medium" like the web
fn pill_text() -> str {
    var i: usize = 0
    while i < G_MN {
        if buf_is(&G_CUR_M, line_field(&G_ROWS, i, 0)) {
            var t: str = __str_copy(line_field(&G_ROWS, i, 1))
            if G_CUR_E.len > 0 && cur_has_effort() {
                t = t + " " + cap_first(__str_copy(str { p: G_CUR_E.ptr as *mut u8, n: G_CUR_E.len }))
            }
            return t
        }
        i = i + 1
    }
    return ""
}

fn refresh_dd(a: *mut app.App) {
    var i: usize = 0
    while i < MODEL_ROWS {
        let n: usize = G_MROW[i]
        if i < G_MN {
            app.set_text(a, n, line_field(&G_ROWS, i, 1))
            chip_on(a, n, buf_is(&G_CUR_M, line_field(&G_ROWS, i, 0)))
            jshell.set_shown(a, n, true, 0)
        } else {
            jshell.set_shown(a, n, false, 0)
        }
        i = i + 1
    }
    let eff: bool = cur_has_effort() && G_EN > 0
    var j: usize = 0
    while j < EFFORT_CHIPS {
        let n: usize = G_EROW[j]
        if j < G_EN && eff {
            let name: str = line_field(&G_EFFS, j, 0)
            app.set_text(a, n, cap_first(name))
            chip_on(a, n, buf_is(&G_CUR_E, name))
            jshell.set_shown(a, n, true, 0)
        } else {
            jshell.set_shown(a, n, false, 0)
        }
        j = j + 1
    }
    jshell.set_shown(a, G_EFF_ROW, eff, 0)
    let t: str = pill_text()
    if t.n > 0 {
        buf_set(&G_PILL_FULL, t)
        G_PILL_SHOWN = -1
        fit_pill(a)
    }
}

// the pill shows "Claude Sonnet 5.5 Medium" when it fits between the hamburger and the icons, else "Sonnet 5.5 Medium" (the effort
// level must stay readable; the vendor prefix is the first thing to go). Called when the text changes and every refresh (rotation / resize).
fn fit_pill(a: *mut app.App) {
    if G_PILL_FULL.len == 0 || G_MODEL == 0 { return }
    let sc: *mut scene.Scene = app.app_scene(a)
    let c: *mut render.Ctx = app.app_ctx(a)
    let full: str = str { p: G_PILL_FULL.ptr as *mut u8, n: G_PILL_FULL.len }
    var form: i64 = 0
    let rw: f64 = scene.node_w(sc, G_HROW)
    if rw > 0.0 {
        // row width - row padding - 4 icon buttons - the narrow chevron - the pill's own padding
        let fixed: f64 = render.len_of(c, 16 + 4 * jtokens.ICON_BTN + 26 + 12)
        let need: f64 = kit.text_width(c, jtokens.FONT_BODY as f64, 600, full)
        if need > rw - fixed { form = 1 }
    }
    if form == G_PILL_SHOWN { return }
    G_PILL_SHOWN = form
    var shown: str = full
    if form == 1 && full.n > 7 && rt.mem_eq(full.p as u64, "Claude ".p as u64, 7) {
        shown = __str_copy(str { p: ((full.p as u64) + 7) as *mut u8, n: full.n - 7 })
    }
    app.set_text(a, G_MODEL, shown)
}

fn dd_show(a: *mut app.App, on: bool) {
    G_DD_OPEN = on
    if on { G_INFO_ON = false }
    jshell.set_shown(a, G_DD, on, 0)
}

fn on_model(a: *mut app.App) {
    if G_MN == 0 {
        jshell.set_status(jtexts.t("chat.model-note"))
        return
    }
    dd_show(a, !G_DD_OPEN)
}

// the list arrived (jmeta.jmeta_api): rows / efforts / stored choice; an empty list = an older server, the pill stays a plain label
fn screen_chat_set_models(a: *mut app.App, rows: str, efforts: str, cur_model: str, cur_effort: str) {
    buf_set(&G_ROWS, rows)
    buf_set(&G_EFFS, efforts)
    buf_set(&G_CUR_M, cur_model)
    buf_set(&G_CUR_E, cur_effort)
    G_MN = count_lines(&G_ROWS)
    if G_MN > MODEL_ROWS { G_MN = MODEL_ROWS }
    G_EN = count_lines(&G_EFFS)
    if G_EN > EFFORT_CHIPS { G_EN = EFFORT_CHIPS }
    if G_DD == 0 { return }
    if G_MN == 0 { dd_show(a, false) }
    refresh_dd(a)
}

fn cycle_idx(b: *mut rt.Buf, cur: *mut rt.Buf, n: usize) -> usize {
    var i: usize = 0
    while i < n {
        if buf_is(cur, line_field(b, i, 0)) { return (i + 1) % n }
        i = i + 1
    }
    return 0
}

// settings screen: next model / next effort
fn screen_chat_cycle_model(a: *mut app.App) {
    if G_MN > 0 { pick_model(a, cycle_idx(&G_ROWS, &G_CUR_M, G_MN)) }
}
fn screen_chat_cycle_effort(a: *mut app.App) {
    if G_EN > 0 { pick_effort(a, cycle_idx(&G_EFFS, &G_CUR_E, G_EN)) }
}
fn screen_chat_cur_model() -> str { return str { p: G_CUR_M.ptr as *mut u8, n: G_CUR_M.len } }
fn screen_chat_cur_effort() -> str { return str { p: G_CUR_E.ptr as *mut u8, n: G_CUR_E.len } }

// a model was tapped: store it (POST) and tell the open socket (the web app's "/model <alias>" command)
fn pick_model(a: *mut app.App, i: usize) {
    if i >= G_MN { return }
    let alias: str = __str_copy(line_field(&G_ROWS, i, 0))
    buf_set(&G_CUR_M, alias)
    let b1: bool = jarvisapi.ja_models_set(jshell.api(), alias, "")
    jarvisc.jc_send(jshell.jc(), "/model " + alias)
    refresh_dd(a)
    if !cur_has_effort() { dd_show(a, false) }
}

fn pick_effort(a: *mut app.App, j: usize) {
    if j >= G_EN { return }
    let name: str = __str_copy(line_field(&G_EFFS, j, 0))
    buf_set(&G_CUR_E, name)
    let b1: bool = jarvisapi.ja_models_set(jshell.api(), "", name)
    jarvisc.jc_send(jshell.jc(), "/effort " + name)
    refresh_dd(a)
    dd_show(a, false)
}

fn pm0(a: *mut app.App) { pick_model(a, 0) }
fn pm1(a: *mut app.App) { pick_model(a, 1) }
fn pm2(a: *mut app.App) { pick_model(a, 2) }
fn pm3(a: *mut app.App) { pick_model(a, 3) }
fn pm4(a: *mut app.App) { pick_model(a, 4) }
fn pm5(a: *mut app.App) { pick_model(a, 5) }
fn pm6(a: *mut app.App) { pick_model(a, 6) }
fn pm7(a: *mut app.App) { pick_model(a, 7) }
fn pe0(a: *mut app.App) { pick_effort(a, 0) }
fn pe1(a: *mut app.App) { pick_effort(a, 1) }
fn pe2(a: *mut app.App) { pick_effort(a, 2) }
fn pe3(a: *mut app.App) { pick_effort(a, 3) }
fn pe4(a: *mut app.App) { pick_effort(a, 4) }

// the panel node tree (hidden until the pill is tapped): one chip per model, one row of effort chips
fn build_dropdown(a: *mut app.App) {
    let sc: *mut scene.Scene = app.app_scene(a)
    let dd: usize = app.column(a)
    G_DD = dd
    scene.node_set_flex(sc, dd, flex.FLEX_COLUMN, flex.JUSTIFY_START, flex.AL_STRETCH)
    scene.node_set_gap(sc, dd, 4, 4)
    scene.node_set_padding(sc, dd, 10, 8, 10, 8)
    jshell.fill_stretch(a, dd)
    jtheme.style_node(a, dd, jtheme.K_LIST)
    G_MROW[0] = app.button(a, "", pm0)
    G_MROW[1] = app.button(a, "", pm1)
    G_MROW[2] = app.button(a, "", pm2)
    G_MROW[3] = app.button(a, "", pm3)
    G_MROW[4] = app.button(a, "", pm4)
    G_MROW[5] = app.button(a, "", pm5)
    G_MROW[6] = app.button(a, "", pm6)
    G_MROW[7] = app.button(a, "", pm7)
    let er: usize = app.row(a)
    G_EFF_ROW = er
    scene.node_set_flex(sc, er, flex.FLEX_ROW, flex.JUSTIFY_START, flex.AL_CENTER)
    scene.node_set_gap(sc, er, 4, 4)
    jshell.fill_stretch(a, er)
    G_EROW[0] = app.button(a, "", pe0)
    G_EROW[1] = app.button(a, "", pe1)
    G_EROW[2] = app.button(a, "", pe2)
    G_EROW[3] = app.button(a, "", pe3)
    G_EROW[4] = app.button(a, "", pe4)
    app.end(a)
    app.end(a)
    var i: usize = 0
    while i < MODEL_ROWS {
        jtheme.style_node(a, G_MROW[i], jtheme.K_CHIP)
        jshell.set_shown(a, G_MROW[i], false, 0)
        i = i + 1
    }
    var j: usize = 0
    while j < EFFORT_CHIPS {
        jtheme.style_node(a, G_EROW[j], jtheme.K_CHIP)
        jshell.set_shown(a, G_EROW[j], false, 0)
        j = j + 1
    }
    jshell.set_shown(a, G_EFF_ROW, false, 0)
    jshell.set_shown(a, dd, false, 0)
}
fn on_sliders(a: *mut app.App) { jshell.request_tab(jshell.TAB_SETTINGS) }

// the busy marker in the composer (an answer is being made)
fn set_busy(a: *mut app.App, on: bool) {
    G_BUSY = on
    jshell.set_shown(a, G_SPIN, on, 0)
}


// the model pill: web dropdown text ("Claude Sonnet 5.5 Medium") from GET /api/m/models; "" keeps the placeholder
fn screen_chat_set_model(a: *mut app.App, label: str) {
    if label.n > 0 && G_MODEL != 0 {
        buf_set(&G_PILL_FULL, label)
        G_PILL_SHOWN = -1
        fit_pill(a)
    }
}

// provider name + reset times of the usage strip (GET /api/m/usage): the name replaces the fixed "Claude"
fn screen_chat_set_usage_info(a: *mut app.App, name: str, reset5: str, reset7: str) {
    buf_set(&G_USE_PROV, name)
    buf_set(&G_USE_R5, reset5)
    buf_set(&G_USE_R7, reset7)
    if name.n > 0 && G_USE_NAME != 0 { app.set_text(a, G_USE_NAME, name) }
}

// usage strip under the composer (web .usage-dock): percent of the 5 h window and of the week, -1 = unknown
fn screen_chat_set_usage(a: *mut app.App, p5: i64, p7: i64) {
    G_USE_A = p5
    G_USE_B = p7
    if p5 < 0 { app.set_text(a, G_USE_PA, "-") } else { app.set_text(a, G_USE_PA, jshell.dec(p5) + "%") }
    if p7 < 0 { app.set_text(a, G_USE_PB, "-") } else { app.set_text(a, G_USE_PB, jshell.dec(p7) + "%") }
}

// ud 0 = 5 h track, 1 = week track: track + fill (web .usage-track / .usage-fill; warn from 70 %, crit from 90 %)
fn draw_usage(ud: u64, c: *mut render.Ctx, e: *mut widget.Widget) {
    let x: f64 = widget.w_x(e)
    let w: f64 = widget.w_w(e)
    let h: f64 = render.len_of(c, jtokens.USAGE_TRACK_H)
    let y: f64 = widget.w_y(e) + (widget.w_h(e) - h) * 0.5
    let f: *mut theme.Colors = theme.theme_colors(render.ctx_theme(c))
    let z: *mut painter.Painter = render.ctx_painter(c)
    painter.round_rect(z, x, y, w, h, h * 0.5, (*f).field)
    var p: i64 = G_USE_A
    if ud == 1 { p = G_USE_B }
    if p > 100 { p = 100 }
    if p > 0 {
        var col: u32 = (*f).accent
        if p >= 90 { col = (*f).err_col } else if p >= 70 { col = (*f).warning }
        painter.round_rect(z, x, y, w * (p as f64) / 100.0, h, h * 0.5, col)
    }
}

fn on_mic(a: *mut app.App) {
    if G_STT_WAIT {
        jshell.set_status("Wandle Sprache um ...")
        return
    }
    let r: i32 = voiceio.vio_mic_toggle()
    if r == voiceio.VIO_STARTED {
        G_REC = true
        jicons.put(a, G_MIC, "square")
        jshell.set_status(jtexts.t("chat.rec-on"))
    } else if r == voiceio.VIO_STOPPED {
        G_REC = false
        jicons.put(a, G_MIC, "mic")
        if jarvisapi.ja_stt(jshell.api(), voiceio.vio_mic_wav(), voiceio.vio_mic_wav_len(), "audio/wav", "de") {
            G_STT_WAIT = true
            jshell.set_status("Wandle Sprache um ...")
        } else {
            voiceio.vio_mic_free()
            jshell.set_status("Sprach-Upload fehlgeschlagen")
        }
    } else if r == voiceio.VIO_PERMISSION {
        jshell.set_status(jtexts.t("perm.mic"))
    } else {
        G_REC = false
        jicons.put(a, G_MIC, "mic")
        jshell.set_status(voiceio.vio_error_text())
    }
}

// the transcription arrives (the audio buffer is free again); status 200 + {"text": ...}
fn screen_chat_api(x: *mut jarvisapi.Api, kind: u32, status: i64) {
    if kind == jarvisapi.AK_PUSH_REG {
        jshell.mark_once("pio_keep_begin")
        jpush.on_api(x, status)
        jshell.mark_once("pio_keep_done")
        return
    }
    if kind == jarvisapi.AK_UPLOAD {
        upload_done(x, status)
        return
    }
    if kind == jarvisapi.AK_DOWNLOAD {
        download_done(x, status)
        return
    }
    if kind != jarvisapi.AK_STT { return }
    G_STT_WAIT = false
    voiceio.vio_mic_free()
    let a: *mut app.App = jshell.app_ui()
    if status != 200 {
        jshell.set_status("Spracherkennung fehlgeschlagen (" + jshell.dec(status) + ")")
        return
    }
    let t: str = jarvisapi.parse_text_field(jarvisapi.ja_body_ptr(x), jarvisapi.ja_body_len(x), "text")
    if t.n == 0 {
        jshell.set_status(jtexts.t("chat.rec-none"))
        return
    }
    let old: str = __str_copy(app.text(a, G_IN))
    if old.n > 0 {
        app.set_text(a, G_IN, old + " " + t)
    } else {
        app.set_text(a, G_IN, t)
    }
    jshell.set_status(jtexts.t("chat.rec-heard") + " " + t)
}

// 100 ms: the level of the microphone as status while recording
fn screen_chat_voice_tick(a: *mut app.App) {
    if G_REC && !voiceio.vio_mic_recording() {
        G_REC = false
        jicons.put(a, G_MIC, "mic")
    }
}

// "+" shows (or hides) the two choices
fn on_attach(a: *mut app.App) {
    G_ATT_SHOWN = !G_ATT_SHOWN
    jshell.set_shown(a, G_ATT_ROW, G_ATT_SHOWN, 0)
}

static mut G_ATT_SHOWN: bool = false

fn att_hide(a: *mut app.App) {
    G_ATT_SHOWN = false
    jshell.set_shown(a, G_ATT_ROW, false, 0)
}

fn on_photo(a: *mut app.App) {
    att_hide(a)
    if G_UPLOADING {
        jshell.set_status(jtexts.t("chat.uploading"))
        return
    }
    if jshell.win() as u64 != 0 && !G_LIMIT_SET {
        G_LIMIT_SET = window.pick_set_limit(jshell.win(), PHOTO_CAP)
    }
    if jshell.win() as u64 == 0 || !window.pick_image(jshell.win()) {
        jshell.set_status(jtexts.t("chat.no-photo-picker"))
        return
    }
    G_PICKING = 0
}

fn on_file(a: *mut app.App) {
    att_hide(a)
    if G_UPLOADING {
        jshell.set_status(jtexts.t("chat.uploading"))
        return
    }
    if G_FILE_BUF == 0 { G_FILE_BUF = rt.heap_alloc(FILE_CAP) }
    if G_FILE_BUF == 0 || jshell.win() as u64 == 0 || !window.pick_file(jshell.win()) {
        jshell.set_status(jtexts.t("chat.no-file-picker"))
        return
    }
    G_PICKING = 1
}

// the picker answered with a file: octets + "<name>\0<mime>\0"
fn file_picked(a: *mut app.App) {
    var n: usize = 0
    var meta: [u8; 640] = [0 as u8; 640]
    if !window.pick_file_take(jshell.win(), G_FILE_BUF, FILE_CAP, &n, (&meta[0]) as u64, 640) { return }
    var nl: usize = 0
    while nl < 600 && meta[nl] != 0 as u8 { nl = nl + 1 }
    var ml: usize = 0
    while nl + 1 + ml < 639 && meta[nl + 1 + ml] != 0 as u8 { ml = ml + 1 }
    rt.buf_clear(&G_ATT_NAME)
    if nl == 0 {
        rt.buf_push_bytes(&G_ATT_NAME, "file".p as u64, 4)
    } else {
        rt.buf_push_bytes(&G_ATT_NAME, (&meta[0]) as u64, nl)
    }
    rt.buf_clear(&G_ATT_MIME)
    if ml == 0 {
        rt.buf_push_bytes(&G_ATT_MIME, "application/octet-stream".p as u64, 24)
    } else {
        rt.buf_push_bytes(&G_ATT_MIME, (&meta[nl + 1]) as u64, ml)
    }
    G_ATT_KIND = 1
    G_PHOTO_N = n
    app.set_text(a, G_PHOTO, jtexts.t("chat.file-word") + " " + __str_copy(str { p: G_ATT_NAME.ptr as *mut u8, n: G_ATT_NAME.len }) + ", " + jshell.dec((n / 1024) as i64) + " kB")
}

fn send_now(a: *mut app.App) {
    let t: str = __str_copy(app.text(a, G_IN))
    if t.n == 0 { return }
    if G_UPLOADING {
        jshell.set_status(jtexts.t("chat.uploading"))
        return
    }
    if G_PHOTO_N > 0 {
        // upload first; the text goes out with the server path when the answer is here (upload_done)
        var name: str = "photo_" + jshell.dec(time.now_unix_ms()) + ".jpg"
        var mime: str = "image/jpeg"
        var buf: u64 = G_PHOTO_BUF
        if G_ATT_KIND == 1 {
            name = __str_copy(str { p: G_ATT_NAME.ptr as *mut u8, n: G_ATT_NAME.len })
            mime = __str_copy(str { p: G_ATT_MIME.ptr as *mut u8, n: G_ATT_MIME.len })
            buf = G_FILE_BUF
        }
        rt.buf_clear(&G_PENDING)
        rt.buf_push_bytes(&G_PENDING, t.p as u64, t.n)
        if jarvisapi.ja_upload(jshell.api(), name, mime, buf, G_PHOTO_N, jarvisc.jc_cid(jshell.jc())) {
            G_UPLOADING = true
            jshell.set_status("Lade hoch ...")
        } else {
            jshell.set_status(jtexts.t("chat.upload-fail"))
        }
        return
    }
    send_text(a, t)
}

fn send_text(a: *mut app.App, t: str) {
    chat_add_user(t)
    G_ANS_AT = G_CHAT.len
    G_SPLIT = G_CHAT.len
    G_TXT_AT = G_CHAT.len
    jsteps.new_turn()
    G_SENT_MS = time.now_unix_ms()
    set_busy(a, true)
    jarvisc.jc_send(jshell.jc(), t)
    app.set_text(a, G_IN, "")
    jshell.set_status("Gesendet")
}

// the upload answered: put the server file into the message so the model finds it (docs/ANDROID-APP-API.md, POST /api/m/upload)
fn upload_done(x: *mut jarvisapi.Api, status: i64) {
    let a: *mut app.App = jshell.app_ui()
    G_UPLOADING = false
    var up: jarvisapi.Uploaded = jarvisapi.uploaded_new()
    if status != 200 || !jarvisapi.parse_upload(jarvisapi.ja_body_ptr(x), jarvisapi.ja_body_len(x), &up) {
        jarvisapi.uploaded_free(&up)
        jshell.set_status("Upload fehlgeschlagen (" + jshell.dec(status) + ")")
        return
    }
    let t: str = __str_copy(str { p: G_PENDING.ptr as *mut u8, n: G_PENDING.len })
    var kind: str = "photo"
    if G_ATT_KIND == 1 { kind = "file" }
    var full: str = t + "\n\n[" + kind + " " + up.name + " (" + jshell.dec(up.size / 1024) + " kB) on the server: " + up.path + "]"
    if up.path.n == 0 { full = t + "\n\n[" + kind + " " + up.name + ": " + up.url + "]" }
    jarvisapi.uploaded_free(&up)
    G_PHOTO_N = 0
    app.set_text(a, G_PHOTO, "")
    send_text(a, full)
}

// ---- files from the assistant: ja_download -> plat.fileio (save into Downloads/Jarvis, open in another app)
fn start_download(url: str, name: str, mime: str) {
    rt.buf_clear(&G_DL_NAME)
    rt.buf_push_bytes(&G_DL_NAME, name.p as u64, name.n)
    rt.buf_clear(&G_DL_MIME)
    rt.buf_push_bytes(&G_DL_MIME, mime.p as u64, mime.n)
    if jarvisapi.ja_download(jshell.api(), url) {
        G_DL_BUSY = true
        jshell.set_status("Empfange " + name + " ...")
    } else {
        jshell.set_status(jtexts.t("chat.link-bad") + " " + name)
        next_download()
    }
}

fn queue_download(url: str, name: str, mime: str) {
    if url.n == 0 { return }
    if !G_DL_BUSY {
        start_download(url, name, mime)
        return
    }
    rt.buf_push_bytes(&G_DL_QUEUE, url.p as u64, url.n)
    rt.buf_push(&G_DL_QUEUE, 1 as u8)
    rt.buf_push_bytes(&G_DL_QUEUE, name.p as u64, name.n)
    rt.buf_push(&G_DL_QUEUE, 1 as u8)
    rt.buf_push_bytes(&G_DL_QUEUE, mime.p as u64, mime.n)
    rt.buf_push(&G_DL_QUEUE, 10 as u8)
}

// the first queued file (a line "url \x01 name \x01 mime") starts, the rest stays
fn next_download() {
    G_DL_BUSY = false
    if G_DL_QUEUE.len == 0 { return }
    let q: str = __str_copy(str { p: G_DL_QUEUE.ptr as *mut u8, n: G_DL_QUEUE.len })
    var end: usize = 0
    while end < q.n && *((q.p as u64 + end as u64) as *mut u8) != 10 as u8 { end = end + 1 }
    var f1: usize = 0
    while f1 < end && *((q.p as u64 + f1 as u64) as *mut u8) != 1 as u8 { f1 = f1 + 1 }
    var f2: usize = f1 + 1
    while f2 < end && *((q.p as u64 + f2 as u64) as *mut u8) != 1 as u8 { f2 = f2 + 1 }
    rt.buf_clear(&G_DL_QUEUE)
    if end + 1 < q.n { rt.buf_push_bytes(&G_DL_QUEUE, q.p as u64 + end as u64 + 1 as u64, q.n - end - 1) }
    if f2 >= end { return }
    start_download(str { p: q.p, n: f1 }, str { p: (q.p as u64 + f1 as u64 + 1 as u64) as *mut u8, n: f2 - f1 - 1 },
        str { p: (q.p as u64 + f2 as u64 + 1 as u64) as *mut u8, n: end - f2 - 1 })
}

fn download_done(x: *mut jarvisapi.Api, status: i64) {
    let name: str = __str_copy(str { p: G_DL_NAME.ptr as *mut u8, n: G_DL_NAME.len })
    let mime: str = __str_copy(str { p: G_DL_MIME.ptr as *mut u8, n: G_DL_MIME.len })
    if status == 200 && jarvisapi.ja_body_len(x) > 0 {
        if fileio.fio_open(jarvisapi.ja_body_ptr(x), jarvisapi.ja_body_len(x), name, mime) {
            jshell.set_status(name + " " + jtexts.t("chat.opened"))
        } else {
            jshell.set_status(name + " " + jtexts.t("chat.received"))
        }
    } else {
        jshell.set_status(jtexts.t("chat.file-word") + " " + name + " " + jtexts.t("chat.failed") + " (" + jshell.dec(status) + ")")
    }
    next_download()
}


// the sidebar's "+"
fn screen_chat_new(a: *mut app.App) { on_new(a) }

// a notification brought the app back: open the chat of its event (main.fi)
fn screen_chat_open_cid(a: *mut app.App, cid: str) {
    if cid.n == 0 { return }
    jarvisc.jc_set_cid(jshell.jc(), cid)
    let saved: bool = jarvisc.jc_save(jshell.jc(), jshell.SERVICE)
    chat_clear()
    G_PHOTO_N = 0
    app.set_text(a, G_PHOTO, "")
    G_HIST_ASKED = true
    let h: bool = jarvisc.jc_history(jshell.jc())
    jshell.set_status(jtexts.t("chat.opening-push"))
}


fn on_send(a: *mut app.App) { send_now(a) }

// Enter in the input field is a line break (a text area, like the web app on a phone): the round button sends
fn screen_chat_enter(a: *mut app.App) -> bool {
    return false
}

// the header of the chat tab (web <header>: hamburger, model pill, speaker, microphone, sliders) with its hairline; main.fi shows
// it on the chat tab only and hides the JARVIS header there
fn screen_chat_build_header(a: *mut app.App) -> usize {
    let sc: *mut scene.Scene = app.app_scene(a)
    let col: usize = app.column(a)
    scene.node_set_flex(sc, col, flex.FLEX_COLUMN, flex.JUSTIFY_START, flex.AL_STRETCH)
    scene.node_set_gap(sc, col, 0, 0)
    jshell.fill_stretch(a, col)
    let row: usize = app.row(a)
    scene.node_set_flex(sc, row, flex.FLEX_ROW, flex.JUSTIFY_START, flex.AL_CENTER)
    scene.node_set_gap(sc, row, 0, 0)
    scene.node_set_padding(sc, row, 8, 8, 8, 8)
    jshell.fill_stretch(a, row)
    G_HROW = row
    let menu: usize = app.button(a, "", on_menu)
    jtheme.style_node(a, menu, jtheme.K_HDRBTN)
    jicons.put(a, menu, "menu")
    let model: usize = app.button(a, jtexts.t("chat.model"), on_model)
    G_MODEL = model
    jtheme.style_node(a, model, jtheme.K_MODEL)
    // the pill gives room (shrink 1000 per mille): on a narrow screen the long label shrinks instead of pushing speaker / mic / sliders out of the window
    scene.node_set_flexitem(sc, model, 0, 1000, 1, 0)
    let chev: usize = app.button(a, "", on_model)
    jtheme.style_node(a, chev, jtheme.K_HDRBTN)
    jicons.put(a, chev, "chevron-down")
    scene.node_set_bounds(sc, chev, 26, 26) // narrower than the other icon buttons: the room goes to the model name
    let sp: usize = app.spacer(a, 1, 1)
    scene.node_set_grow(sc, sp, 1, 0)
    G_SPK = app.button(a, "", on_voice)
    jtheme.style_node(a, G_SPK, jtheme.K_HDRBTN)
    jicons.put(a, G_SPK, "volume-x")
    G_MIC = app.button(a, "", on_mic)
    jtheme.style_node(a, G_MIC, jtheme.K_HDRBTN)
    jicons.put(a, G_MIC, "mic")
    let sl: usize = app.button(a, "", on_sliders)
    jtheme.style_node(a, sl, jtheme.K_HDRBTN)
    jicons.put(a, sl, "sliders-horizontal")
    app.end(a)
    let sep: usize = app.separator(a)
    build_dropdown(a)
    app.end(a)
    return col
}

fn screen_chat_build(a: *mut app.App) {
    var md: markdownview.MdView = markdownview.mdv_new()
    let box: u64 = rt.heap_alloc(8192)
    G_MD = box
    *(box as *mut markdownview.MdView) = md
    markdownview.mdv_set_background(mdv(), 4294967295) // no own ground: the page gradient shows through (markdownview.NIL)
    markdownview.mdv_set_clipboard(mdv(), clip_write)
    markdownview.mdv_set_image_cb(mdv(), 0, jimg.on_image)
    markdownview.mdv_set_image_tap_cb(mdv(), 0, on_image_tap)
    markdownview.mdv_set_link_cb(mdv(), 0, on_md_link)
    G_PHOTO_BUF = rt.heap_alloc(PHOTO_CAP)
    let sc: *mut scene.Scene = app.app_scene(a)
    G_COPY = app.button(a, jtexts.t("chat.copy"), on_copy)
    jtheme.style_node(a, G_COPY, jtheme.K_CHIP)
    applay.align_start(a, G_COPY)
    jshell.set_shown(a, G_COPY, false, 0)
    G_NODE = app.custom(a, widget.KIND_TILE, 340, 300)
    jshell.fill(a, G_NODE)
    // the chat view gives room first (shrink 1000, minimum 1 pt): when the header grows (model list) the composer and the usage
    // strip stay at the bottom, only this view gets shorter
    scene.node_set_flexitem(sc, G_NODE, 1, 1000, 1, 0)
    jtheme.style_node(a, G_NODE, jtheme.K_PLAIN)
    scene.node_set_draw(app.app_scene(a), G_NODE, 0, draw_chat)
    let b: bool = app.on(a, G_NODE, event.EV_PAN_ALL | event.ev_bit(event.EV_TAP) | event.ev_bit(event.EV_LONG_PRESS), on_touch)
    G_PHOTO = app.label(a, "", 11)
    G_ATT_ROW = app.row(a)
    app.button(a, jtexts.t("chat.photo"), on_photo)
    app.button(a, jtexts.t("chat.file"), on_file)
    app.end(a)
    jshell.set_shown(a, G_ATT_ROW, false, 0)
    // the composer card (web footer): the text area on top, below it the paperclip, the busy marker + status, the round send button
    let comp: usize = app.column(a)
    scene.node_set_flex(sc, comp, flex.FLEX_COLUMN, flex.JUSTIFY_START, flex.AL_STRETCH)
    scene.node_set_gap(sc, comp, 2, 2)
    // the style padding is not part of the layout: without it the children touch the 1-px border and paint over it
    scene.node_set_padding(sc, comp, 8, 6, 8, 6)
    jshell.fill_stretch(a, comp)
    jtheme.style_node(a, comp, jtheme.K_COMPOSER)
    G_IN = app.textarea_auto(a, jtexts.t("chat.message"), 1, 5) // one row when empty, grows to 5, then scrolls (web #input)
    jtheme.style_node(a, G_IN, jtheme.K_FIELD)
    jshell.fill_stretch(a, G_IN)
    let low: usize = app.row(a)
    scene.node_set_flex(sc, low, flex.FLEX_ROW, flex.JUSTIFY_START, flex.AL_CENTER)
    scene.node_set_gap(sc, low, 4, 4)
    jshell.fill_stretch(a, low)
    let att: usize = app.button(a, "", on_attach)
    jtheme.style_node(a, att, jtheme.K_ICONBTN)
    jicons.put(a, att, "paperclip")
    G_SPIN = app.button(a, "", on_noop)
    jtheme.style_node(a, G_SPIN, jtheme.K_ICONBTN)
    jicons.put(a, G_SPIN, "loader-circle")
    jshell.set_shown(a, G_SPIN, false, 0)
    let st: usize = app.label(a, "", 0)
    jtheme.style_node(a, st, jtheme.K_META)
    scene.node_set_grow(sc, st, 1, 1)
    jshell.status_line2(st)
    let snd: usize = app.button(a, "", on_send)
    jtheme.style_node(a, snd, jtheme.K_SEND)
    jicons.put(a, snd, "arrow-up")
    app.end(a)
    app.end(a)
    // usage strip (web .usage-dock): "Claude [bar] 12 % [bar] 54 %"; the numbers come from screen_chat_set_usage
    let use: usize = app.row(a)
    scene.node_set_flex(sc, use, flex.FLEX_ROW, flex.JUSTIFY_CENTER, flex.AL_CENTER)
    scene.node_set_gap(sc, use, 7, 7)
    scene.node_set_padding(sc, use, 0, 6, 0, 2)
    jshell.fill_stretch(a, use)
    let un: usize = app.label(a, jtexts.t("chat.usage-name"), 0)
    G_USE_NAME = un
    jtheme.style_node(a, un, jtheme.K_META)
    let ta: usize = app.custom(a, widget.KIND_TILE, jtokens.USAGE_TRACK_W, 12)
    // K_PLAIN: no tile ground / frame of its own -- draw_usage paints the ONE bar (track + fill); before, the tile's own (larger,
    // translucent) ground lay around the real bar
    jtheme.style_node(a, ta, jtheme.K_PLAIN)
    scene.node_set_draw(sc, ta, 0, draw_usage)
    G_USE_PA = app.label(a, "-", 0)
    jtheme.style_node(a, G_USE_PA, jtheme.K_META)
    app.set_width(a, G_USE_PA, 30)
    let tb: usize = app.custom(a, widget.KIND_TILE, jtokens.USAGE_TRACK_W, 12)
    jtheme.style_node(a, tb, jtheme.K_PLAIN)
    scene.node_set_draw(sc, tb, 1, draw_usage)
    G_USE_PB = app.label(a, "-", 0)
    jtheme.style_node(a, G_USE_PB, jtheme.K_META)
    app.set_width(a, G_USE_PB, 30)
    app.end(a)
    // a tap anywhere on the strip opens the usage details
    let tap1: bool = app.on(a, use, event.ev_bit(event.EV_TAP), on_usage_tap_ev)
    let tap2: bool = app.on(a, un, event.ev_bit(event.EV_TAP), on_usage_tap_ev)
    let tap3: bool = app.on(a, ta, event.ev_bit(event.EV_TAP), on_usage_tap_ev)
    let tap4: bool = app.on(a, tb, event.ev_bit(event.EV_TAP), on_usage_tap_ev)
    let tap5: bool = app.on(a, G_USE_PA, event.ev_bit(event.EV_TAP), on_usage_tap_ev)
    let tap6: bool = app.on(a, G_USE_PB, event.ev_bit(event.EV_TAP), on_usage_tap_ev)
}

// animation + a picked photo, polled from the 2 s tick and from the frame timer
fn chat_view_tick(now_ms: i64) {
    if jimg.take_changed() { markdownview.mdv_invalidate(mdv()) } // a picture arrived / failed: lay out again
    let t: bool = markdownview.mdv_tick(mdv(), now_ms)
}

fn screen_chat_refresh(a: *mut app.App) {
    jshell.mark_once("first_chat_draw")
    if jshell.win() as u64 == 0 { return }
    fit_pill(a)
    let st: i32 = window.pick_poll(jshell.win())
    if st == 2 && G_PICKING == 1 {
        G_PICKING = -1
        file_picked(a)
    } else if st == 2 {
        G_PICKING = -1
        var n: usize = 0
        var w: usize = 0
        var h: usize = 0
        if window.pick_take(jshell.win(), G_PHOTO_BUF, PHOTO_CAP, &n, &w, &h) {
            G_ATT_KIND = 0
            G_PHOTO_N = n
            app.set_text(a, G_PHOTO, "Foto " + jshell.dec(w as i64) + "x" + jshell.dec(h as i64) + ", " + jshell.dec((n / 1024) as i64) + " kB")
        }
    } else if st == 4 {
        if G_PICKING == 1 && window.pick_file_too_big(jshell.win()) {
            jshell.set_status(jtexts.t("chat.too-big"))
        } else {
            jshell.set_status(jtexts.t("chat.unreadable"))
        }
        G_PICKING = -1
    } else if st == 3 || st == 0 {
        if st == 3 { G_PICKING = -1 }
    }
    sel_changed(a)
}

// ---- events from net.jarvisc (history, streamed answer, tools)
fn screen_chat_event(c: *mut jarvisc.Jc, kind: u32, arg: i64) {
    if kind == jarvisc.JE_OPEN {
        jshell.set_status("online")
        jshell.mark_once("push_setup")
        jpush.setup()
        if !G_HIST_ASKED && jarvisc.jc_cid(c) != "" {
            G_HIST_ASKED = true
            let h: bool = jarvisc.jc_history(c)
        }
    } else if kind == jarvisc.JE_CONVERSATION {
        // keep the chat id: the next start opens the same chat (jc_restore reads it)
        let saved: bool = jarvisc.jc_save(c, jshell.SERVICE)
    } else if kind == jarvisc.JE_CLOSE || kind == jarvisc.JE_NETERR {
        jshell.set_status("Offline - verbinde neu")
    } else if kind == jarvisc.JE_HIST_TOOL {
        if G_HELD_ON {
            G_HELD_ON = false
            if jsteps.has_pending() {
                jsteps.add_text(str { p: G_HELD.ptr as *mut u8, n: G_HELD.len })
            } else {
                chat_add_plain(__str_copy(str { p: G_HELD.ptr as *mut u8, n: G_HELD.len }))
            }
        }
        jsteps.hist_tool(jarvisc.jc_text(c), jarvisc.jc_options(c), jarvisc.jc_result(c), arg)
    } else if kind == jarvisc.JE_HIST {
        release_held()
        if arg == 1 {
            jsteps.flush(&G_CHAT)
            chat_add_user(jarvisc.jc_text(c))
        } else {
            var hd: i64 = 0
            var ha: i64 = 0
            parse_hist_id(jarvisc.jc_id(c), &hd, &ha)
            let hc: str = jarvisc.jc_clean(jarvisc.jc_text(c))
            rt.buf_clear(&G_HELD)
            rt.buf_push_bytes(&G_HELD, hc.p as u64, hc.n)
            G_HELD_ON = true
            G_HELD_DUR = hd
            G_HELD_AT = ha
        }
    } else if kind == jarvisc.JE_HIST_END {
        release_held()
        jsteps.flush(&G_CHAT)
        chat_changed()
        // the history is in: the pill "opening the chat ..." (open from a notification / the list) must not stay (r141)
        if arg == 1 { jshell.set_status(jtexts.t("chat.thinking")) } else { jshell.set_status("online") }
    } else if kind == jarvisc.JE_TOKEN {
        chat_add(jarvisc.jc_text(c))
    } else if kind == jarvisc.JE_THINKING {
        jshell.set_status(jtexts.t("chat.thinking"))
    } else if kind == jarvisc.JE_TOOL {
        jshell.set_status("Werkzeug: " + jarvisc.jc_text(c))
        if !jsteps.hidden(jarvisc.jc_text(c)) {
            if !jsteps.turn_has_group() {
                // the first tool call: the words said before it stay above the steps
                G_SPLIT = G_CHAT.len
                G_TXT_AT = G_CHAT.len
            } else {
                fold_text()
            }
        }
        jsteps.tool_start(jarvisc.jc_text(c), jarvisc.jc_options(c), jarvisc.jc_id(c))
        chat_changed()
    } else if kind == jarvisc.JE_TOOL_RESULT {
        jsteps.tool_result(jarvisc.jc_id(c), jarvisc.jc_result(c), arg)
        chat_changed()
    } else if kind == jarvisc.JE_FILE {
        let fname: str = __str_copy(jarvisc.jc_text(c))
        // a card the person can tap again: "[File: name](url)"
        var card: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&card, "\n\n[File: ".p as u64, 9)
        jarvisc.md_label(&card, fname.p as u64, fname.n)
        rt.buf_push_bytes(&card, "](".p as u64, 2)
        let furl: str = __str_copy(jarvisc.jc_id(c))
        jarvisc.md_target(&card, furl.p as u64, furl.n)
        rt.buf_push_bytes(&card, ")\n\n".p as u64, 3)
        chat_add(__str_copy(str { p: card.ptr as *mut u8, n: card.len }))
        rt.buf_free(&card)
        // a48: no auto-open; the card above opens the file on a tap (on_link)
    } else if kind == jarvisc.JE_ERROR {
        jsteps.flush_at(&G_CHAT, G_SPLIT)
        chat_add("\n\n**error:** " + jarvisc.jc_text(c) + "\n\n")
        set_busy(jshell.app_ui(), false)
    } else if kind == jarvisc.JE_DONE {
        // cut the ">STATUS:" line the server appends to an answer
        var intro: str = ""
        var from: usize = G_ANS_AT
        if jsteps.turn_has_group() && G_SPLIT >= G_ANS_AT && G_TXT_AT >= G_SPLIT && G_TXT_AT <= G_CHAT.len {
            intro = __str_copy(str { p: ((G_CHAT.ptr as u64) + G_ANS_AT as u64) as *mut u8, n: G_SPLIT - G_ANS_AT })
            from = G_TXT_AT
        }
        let ans: str = __str_copy(str { p: ((G_CHAT.ptr as u64) + from as u64) as *mut u8, n: G_CHAT.len - from })
        G_CHAT.len = G_ANS_AT
        let clean: str = jarvisc.jc_clean(ans)
        if intro.n > 0 { chat_add_plain(intro) }
        jsteps.flush(&G_CHAT)
        G_SPLIT = G_CHAT.len
        G_TXT_AT = G_CHAT.len
        var dur: i64 = 0
        let fin: i64 = time.now_unix_ms()
        if G_SENT_MS > 0 {
            dur = fin - G_SENT_MS
            G_SENT_MS = 0
        }
        chat_add_answer(clean, dur, fin, __str_copy(str { p: G_PILL_FULL.ptr as *mut u8, n: G_PILL_FULL.len }))
        if G_VOICE && !voiceio.vio_say(clean) {
            jshell.set_status(jtexts.t("chat.no-speech"))
        }
        set_busy(jshell.app_ui(), false)
        jshell.set_status("online")
    }
}
