// SPDX-License-Identifier: MPL-2.0
// examples/jarvis_android/screen_chat.fi -- the chat tab: streaming markdown view, input line, new chat, copy, photo.
//
// Events come from net.jarvisc (token / done / tool / thinking / error / history); main.fi forwards them to
// screen_chat_event. The view is fui.markdownview in a custom node: touch pan + fling scroll it, a tap follows a link, a long
// press selects the word under the finger and shows the Copy button (mdv_copy -> system clipboard). The input line is a
// fui.app entry: IME (Gboard), caret, selection and copy/paste come from fui.app / lib/android/inputmethod.fi.
// Voice (lib/plat/voiceio.fi): the Mic button records (tap again to stop), the WAV goes to POST /api/stt through net.jarvisapi and
// the text lands in the input line; the "Voice" button switches the spoken answer on (every finished answer is read out).
// Chats button: the conversation list (jdata.refresh_convs, a vlist) replaces the chat view; a tap on a row opens that chat.
// Attachment: "+" shows Photo / File. Photo: the gallery or camera (up to 3 MB JPEG); File: ANY file of the system's file picker
// (up to 20 MB, name + mime type kept). Send uploads it (POST /api/m/upload, raw) and then sends the text with the server path of
// the file, so the model can read it. Files the assistant sends (JE_FILE) are fetched (ja_download) and opened (plat.fileio).
import std.rt
import fui.app
import fui.render
import fui.scene
import fui.widget
import fui.style
import fui.event
import fui.markdownview
import markdown.doc
import net.jarvisc
import net.jarvisapi
import plat.voiceio
import plat.fileio
import fui.vlist
import std.vec
import std.time
import window.window
import jshell
import jpush
import jtexts
import jdata
import jlist

export {
    screen_chat_build, screen_chat_refresh, screen_chat_event, screen_chat_api, screen_chat_voice_tick, screen_chat_enter, screen_chat_in_node, chat_clear,
    chat_view_tick, screen_chat_open_cid,
}

static mut G_MD: u64 = 0
static mut G_NODE: usize = 0
static mut G_IN: usize = 0
static mut G_COPY: usize = 0
static mut G_PHOTO: usize = 0
static mut G_FOLLOW: bool = true
static mut G_ANS_AT: usize = 0
static mut G_HIST_ASKED: bool = false
static mut G_BUSY: bool = false
static mut G_MIC: usize = 0
static mut G_VOICE_BTN: usize = 0
static mut G_VOICE: bool = false
static mut G_STT_WAIT: bool = false
static mut G_REC: bool = false
static mut G_PHOTO_N: usize = 0
static mut G_CHAT: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }
static mut G_PHOTO_BUF: u64 = 0 // PHOTO_CAP octets; G_FILE_BUF (FILE_CAP) is made at the first file
static mut G_FILE_BUF: u64 = 0
static mut G_LIST: usize = 0
static mut G_LIST_ON: bool = false
static mut G_LIST_SEEN: u64 = 0
static mut G_UPLOADING: bool = false
static mut G_PENDING: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 } // the text waiting for its upload
static mut G_DL_BUSY: bool = false
static mut G_DL_NAME: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }
static mut G_DL_MIME: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }
static mut G_DL_QUEUE: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 } // waiting files: url \x01 name \x01 mime \n per file
static mut G_LIMIT_SET: bool = false
static mut G_ATT_ROW: usize = 0 // the Photo / File buttons under "+"
static mut G_ATT_KIND: i64 = 0 // what waits in G_PHOTO_BUF: 0 photo, 1 file
static mut G_PICKING: i64 = -1 // the picker that is open: 0 photo, 1 file, -1 none
static mut G_ATT_NAME: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }
static mut G_ATT_MIME: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }

const PHOTO_CAP: usize = 3145728 // the picker hands out JPEGs up to this size (window.pick_set_limit)
const FILE_CAP: usize = 20971520 // a file up to this size (the limit of POST /api/m/upload); the buffer is made at the first file

fn mdv() -> *mut markdownview.MdView { return G_MD as *mut markdownview.MdView }

fn chat_changed() {
    markdownview.mdv_set_markdown(mdv(), str { p: G_CHAT.ptr as *mut u8, n: G_CHAT.len }, doc.opts_default())
    G_FOLLOW = true
}

fn chat_add(s: str) {
    rt.buf_push_bytes(&G_CHAT, s.p as u64, s.n)
    chat_changed()
}

fn chat_clear() {
    rt.buf_clear(&G_CHAT)
    chat_changed()
    G_HIST_ASKED = false
}

// the markdown view drew itself into the node's rectangle (set in the draw hook)
fn draw_chat(ud: u64, c: *mut render.Ctx, e: *mut widget.Widget) {
    let a: *mut app.App = jshell.app_ui()
    let sc: *mut scene.Scene = app.app_scene(a)
    let n: usize = scene.scene_node_of(sc, e)
    let v: *mut markdownview.MdView = mdv()
    markdownview.mdv_set_rect(v, scene.node_x(sc, n), scene.node_y(sc, n), scene.node_w(sc, n), scene.node_h(sc, n))
    markdownview.mdv_paint(v, c)
    if G_FOLLOW {
        G_FOLLOW = false
        markdownview.mdv_set_offset(v, markdownview.mdv_content_height(v))
        markdownview.mdv_paint(v, c)
    }
}

fn clip_write(p: u64, n: usize) -> bool {
    if jshell.win() as u64 == 0 { return false }
    return window.clipboard_set(jshell.win(), "text/plain", p, n)
}

// true when the point (window coordinates) lies on the chat view
fn screen_chat_in_node(x: f64, y: f64) -> bool {
    let sc: *mut scene.Scene = app.app_scene(jshell.app_ui())
    return x >= scene.node_x(sc, G_NODE) && x < scene.node_x(sc, G_NODE) + scene.node_w(sc, G_NODE)
    && y >= scene.node_y(sc, G_NODE) && y < scene.node_y(sc, G_NODE) + scene.node_h(sc, G_NODE)
}

fn on_touch(ud: u64, e: *mut event.Ev) -> u32 {
    let a: *mut app.App = ud as *mut app.App
    let k: u32 = event.ev_kind(e)
    let v: *mut markdownview.MdView = mdv()
    if k == event.EV_PAN_MOVE {
        markdownview.mdv_touch_pan(v, event.ev_dx(e), event.ev_dy(e))
        return event.H_STOP
    }
    if k == event.EV_PAN_END && event.ev_fling(e) {
        markdownview.mdv_touch_fling(v, event.ev_vx(e), event.ev_vy(e), event.ev_time(e))
        return event.H_STOP
    }
    if k == event.EV_TAP {
        let t: bool = markdownview.mdv_touch_tap(v, app.app_ctx(a), event.ev_x(e), event.ev_y(e))
        sel_changed(a)
        return event.H_STOP
    }
    if k == event.EV_LONG_PRESS {
        let t: bool = markdownview.mdv_touch_long(v, app.app_ctx(a), event.ev_x(e), event.ev_y(e))
        sel_changed(a)
        return event.H_STOP
    }
    return event.H_GO
}

// the Copy button is visible while text is selected
fn sel_changed(a: *mut app.App) {
    jshell.set_shown(a, G_COPY, markdownview.mdv_has_selection(mdv()), 0)
}

fn on_copy(a: *mut app.App) {
    let ok: bool = markdownview.mdv_copy(mdv())
    markdownview.mdv_clear_selection(mdv())
    sel_changed(a)
    jshell.set_status("copied")
}

fn on_new(a: *mut app.App) {
    jarvisc.jc_new_chat(jshell.jc())
    chat_clear()
    show_list(a, false)
    G_PHOTO_N = 0
    app.set_text(a, G_PHOTO, "")
    jshell.set_status("new chat")
}

// ---- voice: microphone -> WAV -> /api/stt -> input line; speech output of the answers
fn on_voice(a: *mut app.App) {
    G_VOICE = !G_VOICE
    if G_VOICE {
        app.set_text(a, G_VOICE_BTN, "Voice on")
    } else {
        app.set_text(a, G_VOICE_BTN, "Voice off")
        voiceio.vio_say_stop()
    }
}

fn on_mic(a: *mut app.App) {
    if G_STT_WAIT {
        jshell.set_status("transcribing ...")
        return
    }
    let r: i32 = voiceio.vio_mic_toggle()
    if r == voiceio.VIO_STARTED {
        G_REC = true
        app.set_text(a, G_MIC, "Stop")
        jshell.set_status("recording - tap Stop")
    } else if r == voiceio.VIO_STOPPED {
        G_REC = false
        app.set_text(a, G_MIC, "Mic")
        if jarvisapi.ja_stt(jshell.api(), voiceio.vio_mic_wav(), voiceio.vio_mic_wav_len(), "audio/wav", "de") {
            G_STT_WAIT = true
            jshell.set_status("transcribing ...")
        } else {
            voiceio.vio_mic_free()
            jshell.set_status("speech upload failed")
        }
    } else if r == voiceio.VIO_PERMISSION {
        jshell.set_status(jtexts.t("perm.mic"))
    } else {
        G_REC = false
        app.set_text(a, G_MIC, "Mic")
        jshell.set_status(voiceio.vio_error_text())
    }
}

// the transcription arrives (the audio buffer is free again); status 200 + {"text": ...}
fn screen_chat_api(x: *mut jarvisapi.Api, kind: u32, status: i64) {
    if kind == jarvisapi.AK_PUSH_REG {
        jpush.on_api(x, status)
        return
    }
    if kind == jarvisapi.AK_UPLOAD {
        upload_done(x, status)
        return
    }
    if kind == jarvisapi.AK_DOWNLOAD {
        download_done(x, status)
        return
    }
    if kind != jarvisapi.AK_STT { return }
    G_STT_WAIT = false
    voiceio.vio_mic_free()
    let a: *mut app.App = jshell.app_ui()
    if status != 200 {
        jshell.set_status("speech to text failed (" + jshell.dec(status) + ")")
        return
    }
    let t: str = jarvisapi.parse_text_field(jarvisapi.ja_body_ptr(x), jarvisapi.ja_body_len(x), "text")
    if t.n == 0 {
        jshell.set_status("nothing understood")
        return
    }
    let old: str = __str_copy(app.text(a, G_IN))
    if old.n > 0 {
        app.set_text(a, G_IN, old + " " + t)
    } else {
        app.set_text(a, G_IN, t)
    }
    jshell.set_status("heard: " + t)
}

// 100 ms: the level of the microphone as status while recording
fn screen_chat_voice_tick(a: *mut app.App) {
    if G_REC && !voiceio.vio_mic_recording() {
        G_REC = false
        app.set_text(a, G_MIC, "Mic")
    }
}

// "+" shows (or hides) the two choices
fn on_attach(a: *mut app.App) {
    G_ATT_SHOWN = !G_ATT_SHOWN
    jshell.set_shown(a, G_ATT_ROW, G_ATT_SHOWN, 0)
}

static mut G_ATT_SHOWN: bool = false

fn att_hide(a: *mut app.App) {
    G_ATT_SHOWN = false
    jshell.set_shown(a, G_ATT_ROW, false, 0)
}

fn on_photo(a: *mut app.App) {
    att_hide(a)
    if G_UPLOADING {
        jshell.set_status("upload running ...")
        return
    }
    if jshell.win() as u64 != 0 && !G_LIMIT_SET {
        G_LIMIT_SET = window.pick_set_limit(jshell.win(), PHOTO_CAP)
    }
    if jshell.win() as u64 == 0 || !window.pick_image(jshell.win()) {
        jshell.set_status("no photo picker on this system")
        return
    }
    G_PICKING = 0
}

fn on_file(a: *mut app.App) {
    att_hide(a)
    if G_UPLOADING {
        jshell.set_status("upload running ...")
        return
    }
    if G_FILE_BUF == 0 { G_FILE_BUF = rt.heap_alloc(FILE_CAP) }
    if G_FILE_BUF == 0 || jshell.win() as u64 == 0 || !window.pick_file(jshell.win()) {
        jshell.set_status("no file picker on this system")
        return
    }
    G_PICKING = 1
}

// the picker answered with a file: octets + "<name>\0<mime>\0"
fn file_picked(a: *mut app.App) {
    var n: usize = 0
    var meta: [u8; 640] = [0 as u8; 640]
    if !window.pick_file_take(jshell.win(), G_FILE_BUF, FILE_CAP, &n, (&meta[0]) as u64, 640) { return }
    var nl: usize = 0
    while nl < 600 && meta[nl] != 0 as u8 { nl = nl + 1 }
    var ml: usize = 0
    while nl + 1 + ml < 639 && meta[nl + 1 + ml] != 0 as u8 { ml = ml + 1 }
    rt.buf_clear(&G_ATT_NAME)
    if nl == 0 {
        rt.buf_push_bytes(&G_ATT_NAME, "file".p as u64, 4)
    } else {
        rt.buf_push_bytes(&G_ATT_NAME, (&meta[0]) as u64, nl)
    }
    rt.buf_clear(&G_ATT_MIME)
    if ml == 0 {
        rt.buf_push_bytes(&G_ATT_MIME, "application/octet-stream".p as u64, 24)
    } else {
        rt.buf_push_bytes(&G_ATT_MIME, (&meta[nl + 1]) as u64, ml)
    }
    G_ATT_KIND = 1
    G_PHOTO_N = n
    app.set_text(a, G_PHOTO, "file " + __str_copy(str { p: G_ATT_NAME.ptr as *mut u8, n: G_ATT_NAME.len }) + ", " + jshell.dec((n / 1024) as i64) + " kB")
}

fn send_now(a: *mut app.App) {
    let t: str = __str_copy(app.text(a, G_IN))
    if t.n == 0 { return }
    if G_UPLOADING {
        jshell.set_status("upload running ...")
        return
    }
    if G_PHOTO_N > 0 {
        // upload first; the text goes out with the server path when the answer is here (upload_done)
        var name: str = "photo_" + jshell.dec(time.now_unix_ms()) + ".jpg"
        var mime: str = "image/jpeg"
        var buf: u64 = G_PHOTO_BUF
        if G_ATT_KIND == 1 {
            name = __str_copy(str { p: G_ATT_NAME.ptr as *mut u8, n: G_ATT_NAME.len })
            mime = __str_copy(str { p: G_ATT_MIME.ptr as *mut u8, n: G_ATT_MIME.len })
            buf = G_FILE_BUF
        }
        rt.buf_clear(&G_PENDING)
        rt.buf_push_bytes(&G_PENDING, t.p as u64, t.n)
        if jarvisapi.ja_upload(jshell.api(), name, mime, buf, G_PHOTO_N, jarvisc.jc_cid(jshell.jc())) {
            G_UPLOADING = true
            jshell.set_status("uploading ...")
        } else {
            jshell.set_status("upload not possible")
        }
        return
    }
    send_text(a, t)
}

fn send_text(a: *mut app.App, t: str) {
    chat_add("**You:** " + t + "\n\n**JARVIS:** ")
    G_ANS_AT = G_CHAT.len
    G_BUSY = true
    jarvisc.jc_send(jshell.jc(), t)
    app.set_text(a, G_IN, "")
    jshell.set_status("sent")
}

// the upload answered: put the server file into the message so the model finds it (docs/ANDROID-APP-API.md, POST /api/m/upload)
fn upload_done(x: *mut jarvisapi.Api, status: i64) {
    let a: *mut app.App = jshell.app_ui()
    G_UPLOADING = false
    var up: jarvisapi.Uploaded = jarvisapi.uploaded_new()
    if status != 200 || !jarvisapi.parse_upload(jarvisapi.ja_body_ptr(x), jarvisapi.ja_body_len(x), &up) {
        jarvisapi.uploaded_free(&up)
        jshell.set_status("upload failed (" + jshell.dec(status) + ")")
        return
    }
    let t: str = __str_copy(str { p: G_PENDING.ptr as *mut u8, n: G_PENDING.len })
    var kind: str = "photo"
    if G_ATT_KIND == 1 { kind = "file" }
    var full: str = t + "\n\n[" + kind + " " + up.name + " (" + jshell.dec(up.size / 1024) + " kB) on the server: " + up.path + "]"
    if up.path.n == 0 { full = t + "\n\n[" + kind + " " + up.name + ": " + up.url + "]" }
    jarvisapi.uploaded_free(&up)
    G_PHOTO_N = 0
    app.set_text(a, G_PHOTO, "")
    send_text(a, full)
}

// ---- files from the assistant: ja_download -> plat.fileio (save into Downloads/Jarvis, open in another app)
fn start_download(url: str, name: str, mime: str) {
    rt.buf_clear(&G_DL_NAME)
    rt.buf_push_bytes(&G_DL_NAME, name.p as u64, name.n)
    rt.buf_clear(&G_DL_MIME)
    rt.buf_push_bytes(&G_DL_MIME, mime.p as u64, mime.n)
    if jarvisapi.ja_download(jshell.api(), url) {
        G_DL_BUSY = true
        jshell.set_status("receiving " + name + " ...")
    } else {
        jshell.set_status("file link not usable: " + name)
        next_download()
    }
}

fn queue_download(url: str, name: str, mime: str) {
    if url.n == 0 { return }
    if !G_DL_BUSY {
        start_download(url, name, mime)
        return
    }
    rt.buf_push_bytes(&G_DL_QUEUE, url.p as u64, url.n)
    rt.buf_push(&G_DL_QUEUE, 1 as u8)
    rt.buf_push_bytes(&G_DL_QUEUE, name.p as u64, name.n)
    rt.buf_push(&G_DL_QUEUE, 1 as u8)
    rt.buf_push_bytes(&G_DL_QUEUE, mime.p as u64, mime.n)
    rt.buf_push(&G_DL_QUEUE, 10 as u8)
}

// the first queued file (a line "url \x01 name \x01 mime") starts, the rest stays
fn next_download() {
    G_DL_BUSY = false
    if G_DL_QUEUE.len == 0 { return }
    let q: str = __str_copy(str { p: G_DL_QUEUE.ptr as *mut u8, n: G_DL_QUEUE.len })
    var end: usize = 0
    while end < q.n && *((q.p as u64 + end as u64) as *mut u8) != 10 as u8 { end = end + 1 }
    var f1: usize = 0
    while f1 < end && *((q.p as u64 + f1 as u64) as *mut u8) != 1 as u8 { f1 = f1 + 1 }
    var f2: usize = f1 + 1
    while f2 < end && *((q.p as u64 + f2 as u64) as *mut u8) != 1 as u8 { f2 = f2 + 1 }
    rt.buf_clear(&G_DL_QUEUE)
    if end + 1 < q.n { rt.buf_push_bytes(&G_DL_QUEUE, q.p as u64 + end as u64 + 1 as u64, q.n - end - 1) }
    if f2 >= end { return }
    start_download(str { p: q.p, n: f1 }, str { p: (q.p as u64 + f1 as u64 + 1 as u64) as *mut u8, n: f2 - f1 - 1 },
        str { p: (q.p as u64 + f2 as u64 + 1 as u64) as *mut u8, n: end - f2 - 1 })
}

fn download_done(x: *mut jarvisapi.Api, status: i64) {
    let name: str = __str_copy(str { p: G_DL_NAME.ptr as *mut u8, n: G_DL_NAME.len })
    let mime: str = __str_copy(str { p: G_DL_MIME.ptr as *mut u8, n: G_DL_MIME.len })
    if status == 200 && jarvisapi.ja_body_len(x) > 0 {
        if fileio.fio_open(jarvisapi.ja_body_ptr(x), jarvisapi.ja_body_len(x), name, mime) {
            jshell.set_status("opened " + name + " (saved in Downloads/Jarvis)")
        } else {
            jshell.set_status("received " + name + " but could not open it")
        }
    } else {
        jshell.set_status("file " + name + " failed (" + jshell.dec(status) + ")")
    }
    next_download()
}

// ---- conversation list
fn conv_count() -> usize {
    if !jdata.has_convs() { return 0 }
    return vec_len[jarvisapi.ConvRow](&(*jdata.convs()).rows)
}

fn conv_at(i: usize) -> *mut jarvisapi.ConvRow {
    return vec_elem_ptr[jarvisapi.ConvRow](&(*jdata.convs()).rows, i)
}

fn conv_rows(ud: u64, i: usize, out: *mut vlist.VRow) {
    if i >= conv_count() { return }
    let c: *mut jarvisapi.ConvRow = conv_at(i)
    if (*c).fav { jlist.put(out, "* ") }
    if (*c).kind == "worker" { jlist.put(out, "[w] ") }
    jlist.put(out, (*c).title)
}

fn show_list(a: *mut app.App, on: bool) {
    G_LIST_ON = on
    jshell.set_shown(a, G_LIST, on, 1)
    jshell.set_shown(a, G_NODE, !on, 1)
    if on {
        jdata.refresh_convs(true)
        jshell.set_status("choose a chat")
    }
}

fn on_chats(a: *mut app.App) { show_list(a, !G_LIST_ON) }

// a tap on a row: this chat is the current one, its last turns load
fn on_conv_pick(a: *mut app.App, id: usize, row: usize) {
    if row >= conv_count() { return }
    let c: *mut jarvisapi.ConvRow = conv_at(row)
    let cid: str = __str_copy((*c).id)
    if cid.n == 0 { return }
    jarvisc.jc_set_cid(jshell.jc(), cid)
    let saved: bool = jarvisc.jc_save(jshell.jc(), jshell.SERVICE)
    chat_clear()
    G_PHOTO_N = 0
    app.set_text(a, G_PHOTO, "")
    show_list(a, false)
    G_HIST_ASKED = true
    let h: bool = jarvisc.jc_history(jshell.jc())
    jshell.set_status("opening " + __str_copy((*c).title))
}

// a notification brought the app back: open the chat of its event (main.fi)
fn screen_chat_open_cid(a: *mut app.App, cid: str) {
    if cid.n == 0 { return }
    jarvisc.jc_set_cid(jshell.jc(), cid)
    let saved: bool = jarvisc.jc_save(jshell.jc(), jshell.SERVICE)
    chat_clear()
    G_PHOTO_N = 0
    app.set_text(a, G_PHOTO, "")
    show_list(a, false)
    G_HIST_ASKED = true
    let h: bool = jarvisc.jc_history(jshell.jc())
    jshell.set_status("opening the chat of the notification")
}

fn on_conv_reload(a: *mut app.App) {
    jdata.refresh_convs(true)
}

fn on_send(a: *mut app.App) { send_now(a) }

// Enter in the input line sends
fn screen_chat_enter(a: *mut app.App) -> bool {
    if app.focus(a) != G_IN { return false }
    send_now(a)
    return true
}

fn screen_chat_build(a: *mut app.App) {
    var md: markdownview.MdView = markdownview.mdv_new()
    let box: u64 = rt.heap_alloc(8192)
    G_MD = box
    *(box as *mut markdownview.MdView) = md
    markdownview.mdv_set_background(mdv(), style.TOK_BASE)
    markdownview.mdv_set_clipboard(mdv(), clip_write)
    G_PHOTO_BUF = rt.heap_alloc(PHOTO_CAP)
    app.row(a)
    app.button(a, "New", on_new)
    app.button(a, "Chats", on_chats)
    G_VOICE_BTN = app.button(a, "Voice off", on_voice)
    G_COPY = app.button(a, "Copy", on_copy)
    jshell.set_shown(a, G_COPY, false, 0)
    app.end(a)
    G_NODE = app.custom(a, widget.KIND_TILE, 340, 300)
    jshell.fill(a, G_NODE)
    scene.node_set_draw(app.app_scene(a), G_NODE, 0, draw_chat)
    let b: bool = app.on(a, G_NODE, event.EV_PAN_ALL | event.ev_bit(event.EV_TAP) | event.ev_bit(event.EV_LONG_PRESS), on_touch)
    G_LIST = app.vlist_new(a, "Chats", 340, 300, 0, conv_rows, 0)
    jshell.fill(a, G_LIST)
    app.vlist_set_row_pt(a, G_LIST, jlist.ROW_PT)
    app.vlist_on_pick(a, G_LIST, on_conv_pick)
    jlist.pull_add(G_LIST, on_conv_reload)
    jlist.pull_install(a)
    jshell.set_shown(a, G_LIST, false, 0)
    G_PHOTO = app.label(a, "", 11)
    G_ATT_ROW = app.row(a)
    app.button(a, "Photo", on_photo)
    app.button(a, "File", on_file)
    app.end(a)
    jshell.set_shown(a, G_ATT_ROW, false, 0)
    app.row(a)
    app.button(a, "+", on_attach)
    G_IN = app.entry(a, "Message")
    app.set_width(a, G_IN, 140)
    G_MIC = app.button(a, "Mic", on_mic)
    app.button(a, "Send", on_send)
    app.end(a)
}

// animation + a picked photo, polled from the 2 s tick and from the frame timer
fn chat_view_tick(now_ms: i64) {
    let t: bool = markdownview.mdv_tick(mdv(), now_ms)
}

fn screen_chat_refresh(a: *mut app.App) {
    if jshell.win() as u64 == 0 { return }
    let st: i32 = window.pick_poll(jshell.win())
    if st == 2 && G_PICKING == 1 {
        G_PICKING = -1
        file_picked(a)
    } else if st == 2 {
        G_PICKING = -1
        var n: usize = 0
        var w: usize = 0
        var h: usize = 0
        if window.pick_take(jshell.win(), G_PHOTO_BUF, PHOTO_CAP, &n, &w, &h) {
            G_ATT_KIND = 0
            G_PHOTO_N = n
            app.set_text(a, G_PHOTO, "photo " + jshell.dec(w as i64) + "x" + jshell.dec(h as i64) + ", " + jshell.dec((n / 1024) as i64) + " kB")
        }
    } else if st == 4 {
        if G_PICKING == 1 && window.pick_file_too_big(jshell.win()) {
            jshell.set_status("file is over 20 MB")
        } else {
            jshell.set_status("could not read the file")
        }
        G_PICKING = -1
    } else if st == 3 || st == 0 {
        if st == 3 { G_PICKING = -1 }
    }
    sel_changed(a)
    if G_LIST_ON && jdata.ver_convs() != G_LIST_SEEN {
        G_LIST_SEEN = jdata.ver_convs()
        app.vlist_set_count(a, G_LIST, conv_count())
        app.vlist_changed(a, G_LIST)
    }
}

// ---- events from net.jarvisc (history, streamed answer, tools)
fn screen_chat_event(c: *mut jarvisc.Jc, kind: u32, arg: i64) {
    if kind == jarvisc.JE_OPEN {
        jshell.set_status("online")
        jpush.setup()
        if !G_HIST_ASKED && jarvisc.jc_cid(c) != "" {
            G_HIST_ASKED = true
            let h: bool = jarvisc.jc_history(c)
        }
    } else if kind == jarvisc.JE_CONVERSATION {
        // keep the chat id: the next start opens the same chat (jc_restore reads it)
        let saved: bool = jarvisc.jc_save(c, jshell.SERVICE)
    } else if kind == jarvisc.JE_CLOSE || kind == jarvisc.JE_NETERR {
        jshell.set_status("offline - reconnecting")
    } else if kind == jarvisc.JE_HIST {
        if arg == 1 {
            chat_add("**You:** " + jarvisc.jc_text(c) + "\n\n")
        } else {
            chat_add("**JARVIS:** " + jarvisc.jc_clean(jarvisc.jc_text(c)) + "\n\n")
        }
    } else if kind == jarvisc.JE_TOKEN {
        chat_add(jarvisc.jc_text(c))
    } else if kind == jarvisc.JE_THINKING {
        jshell.set_status("thinking ...")
    } else if kind == jarvisc.JE_TOOL {
        jshell.set_status("tool: " + jarvisc.jc_text(c))
    } else if kind == jarvisc.JE_FILE {
        let fname: str = __str_copy(jarvisc.jc_text(c))
        chat_add("**file:** " + fname + "\n\n")
        queue_download(__str_copy(jarvisc.jc_id(c)), fname, __str_copy(jarvisc.jc_options(c)))
    } else if kind == jarvisc.JE_ERROR {
        chat_add("\n\n**error:** " + jarvisc.jc_text(c) + "\n\n")
    } else if kind == jarvisc.JE_DONE {
        // cut the ">STATUS:" line the server appends to an answer
        let ans: str = __str_copy(str { p: ((G_CHAT.ptr as u64) + G_ANS_AT as u64) as *mut u8, n: G_CHAT.len - G_ANS_AT })
        G_CHAT.len = G_ANS_AT
        let clean: str = jarvisc.jc_clean(ans)
        chat_add(clean + "\n\n")
        if G_VOICE && !voiceio.vio_say(clean) {
            jshell.set_status("voice output not possible")
        }
        G_BUSY = false
        jshell.set_status("online")
    }
}
