// SPDX-License-Identifier: MPL-2.0
// examples/jarvis_android/jask.fi -- the question card of the chat (web askUserCard / askConfirm in public/app.js):
//   * JE_ASK     ask_user question with up to 6 options (one tap answers; no options = type the answer in the composer)
//   * JE_CONFIRM permission prompt with Allow / Deny
// The card is a panel between the chat view and the composer; it takes no room while hidden.
//
//   ask_build(a)                once, inside the chat column (after the chat view)
//   ask_question(a, q, opts)    show a question; opts = labels split by '\n'
//   ask_confirm(a, prompt)      show a permission prompt
//   ask_end(a)                  hide the card (answered, cancelled, turn over)
//   ask_wants_text() -> bool    a question without options is open: the next composer text is the answer
//   ask_text_answer(a, text)    send that text as the answer
import std.rt
import fui.app
import fui.scene
import fui.flex
import fui.style
import net.jarvisc
import jshell
import jtheme
import jtexts

export { ask_build, ask_question, ask_confirm, ask_end, ask_wants_text, ask_text_answer, ask_open }

const MAX_OPTS: usize = 6

static mut G_PANEL: usize = 0
static mut G_Q: usize = 0
static mut G_HINT: usize = 0
static mut G_OPT: [usize; 6] = [0; 6]
static mut G_ROW: usize = 0
static mut G_ALLOW: usize = 0
static mut G_DENY: usize = 0
static mut G_MODE: usize = 0 // 0 hidden, 1 question with options, 2 question for typing, 3 permission prompt
static mut G_OPTS: u64 = 0 // rt.Buf of the option labels (byte 10 between them)
static mut G_NOPT: usize = 0

fn optbuf() -> *mut rt.Buf { return G_OPTS as *mut rt.Buf }

// label i of the stored options ("" when missing); a view into the buffer
fn opt_at(i: usize) -> str {
    let b: *mut rt.Buf = optbuf()
    var k: usize = 0
    var st: usize = 0
    var j: usize = 0
    while j <= (*b).len {
        if j == (*b).len || rt.ld8((*b).ptr, j) == 10 as u8 {
            if k == i { return str { p: (((*b).ptr + st as u64)) as *mut u8, n: j - st } }
            k = k + 1
            st = j + 1
        }
        j = j + 1
    }
    return ""
}

fn pick(a: *mut app.App, i: usize) {
    if G_MODE != 1 || i >= G_NOPT { return }
    let label: str = __str_copy(opt_at(i))
    jarvisc.jc_answer(jshell.jc(), label)
    ask_end(a)
    jshell.set_status(jtexts.t("ask.sent"))
}
fn p0(a: *mut app.App) { pick(a, 0) }
fn p1(a: *mut app.App) { pick(a, 1) }
fn p2(a: *mut app.App) { pick(a, 2) }
fn p3(a: *mut app.App) { pick(a, 3) }
fn p4(a: *mut app.App) { pick(a, 4) }
fn p5(a: *mut app.App) { pick(a, 5) }

fn on_allow(a: *mut app.App) {
    if G_MODE != 3 { return }
    jarvisc.jc_confirm(jshell.jc(), true)
    ask_end(a)
}
fn on_deny(a: *mut app.App) {
    if G_MODE != 3 { return }
    jarvisc.jc_confirm(jshell.jc(), false)
    ask_end(a)
}

fn ask_build(a: *mut app.App) {
    let sc: *mut scene.Scene = app.app_scene(a)
    if G_OPTS == 0 {
        let bx: u64 = rt.heap_alloc(64)
        *(bx as *mut rt.Buf) = rt.buf_new()
        G_OPTS = bx
    }
    let p: usize = app.column(a)
    G_PANEL = p
    scene.node_set_flex(sc, p, flex.FLEX_COLUMN, flex.JUSTIFY_START, flex.AL_STRETCH)
    scene.node_set_gap(sc, p, 4, 4)
    scene.node_set_padding(sc, p, 10, 8, 10, 8)
    jshell.fill_stretch(a, p)
    jtheme.style_node(a, p, jtheme.K_LIST)
    G_Q = app.label(a, "", 0)
    app.set_text_align(a, G_Q, style.ALIGN_LEFT)
    G_HINT = app.label(a, "", 11)
    app.set_text_align(a, G_HINT, style.ALIGN_LEFT)
    jtheme.style_node(a, G_HINT, jtheme.K_META)
    G_OPT[0] = app.button(a, "", p0)
    G_OPT[1] = app.button(a, "", p1)
    G_OPT[2] = app.button(a, "", p2)
    G_OPT[3] = app.button(a, "", p3)
    G_OPT[4] = app.button(a, "", p4)
    G_OPT[5] = app.button(a, "", p5)
    let r: usize = app.row(a)
    G_ROW = r
    scene.node_set_flex(sc, r, flex.FLEX_ROW, flex.JUSTIFY_START, flex.AL_CENTER)
    scene.node_set_gap(sc, r, 6, 6)
    jshell.fill_stretch(a, r)
    G_ALLOW = app.button(a, jtexts.t("ask.allow"), on_allow)
    G_DENY = app.button(a, jtexts.t("ask.deny"), on_deny)
    app.end(a)
    app.end(a)
    var i: usize = 0
    while i < MAX_OPTS {
        jtheme.style_node(a, G_OPT[i], jtheme.K_CHIP)
        i = i + 1
    }
    jtheme.style_node(a, G_ALLOW, jtheme.K_CHIP_ON)
    jtheme.style_node(a, G_DENY, jtheme.K_CHIP)
    ask_end(a)
}

fn show_all(a: *mut app.App, mode: usize, q: str, hint: str) {
    G_MODE = mode
    app.set_text(a, G_Q, q)
    app.set_text(a, G_HINT, hint)
    jshell.set_shown(a, G_HINT, hint.n > 0, 0)
    var i: usize = 0
    while i < MAX_OPTS {
        let on: bool = mode == 1 && i < G_NOPT
        if on { app.set_text(a, G_OPT[i], opt_at(i)) }
        jshell.set_shown(a, G_OPT[i], on, 0)
        i = i + 1
    }
    jshell.set_shown(a, G_ROW, mode == 3, 0)
    jshell.set_shown(a, G_PANEL, mode != 0, 0)
}

fn ask_question(a: *mut app.App, q: str, opts: str) {
    if G_PANEL == 0 { return }
    rt.buf_clear(optbuf())
    rt.buf_push_bytes(optbuf(), opts.p as u64, opts.n)
    var n: usize = 0
    if opts.n > 0 {
        n = 1
        var j: usize = 0
        while j < opts.n {
            if rt.ld8(opts.p as u64, j) == 10 as u8 { n = n + 1 }
            j = j + 1
        }
    }
    G_NOPT = n
    if n > MAX_OPTS { G_NOPT = MAX_OPTS }
    if n == 0 {
        show_all(a, 2, q, jtexts.t("ask.type"))
    } else {
        show_all(a, 1, q, "")
    }
}

fn ask_confirm(a: *mut app.App, prompt: str) {
    if G_PANEL == 0 { return }
    G_NOPT = 0
    show_all(a, 3, prompt, jtexts.t("ask.confirm"))
}

fn ask_end(a: *mut app.App) {
    if G_PANEL == 0 { return }
    G_MODE = 0
    G_NOPT = 0
    jshell.set_shown(a, G_PANEL, false, 0)
}

fn ask_open() -> bool { return G_MODE != 0 }
fn ask_wants_text() -> bool { return G_MODE == 2 }

fn ask_text_answer(a: *mut app.App, text: str) {
    if G_MODE != 2 { return }
    jarvisc.jc_answer(jshell.jc(), text)
    ask_end(a)
    jshell.set_status(jtexts.t("ask.sent"))
}
