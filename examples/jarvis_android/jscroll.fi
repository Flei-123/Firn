// SPDX-License-Identifier: MPL-2.0
// examples/jarvis_android/jscroll.fi -- scroll areas for the form pages (memory editor, admin prompt, needs card, tasks): a lay.scroll_v
// area per page slot + the touch pan / fling handler for it. The index of an area depends on the build order of the pages, so every slot
// remembers the index lay gave it. Focused fields inside an area are scrolled into view by main.kb_reveal (lay.scroll_reveal).
import fui.app
import fui.lay
import fui.event
import jshell

export { open, node, show, SL_MEM, SL_ADMIN, SL_NEEDS, SL_TASKS }

const NONE: usize = 4294967295
const SL_MEM: usize = 0
const SL_ADMIN: usize = 1
const SL_NEEDS: usize = 2
const SL_TASKS: usize = 3
static mut S_K: [usize; 4] = [4294967295; 4]

fn pan(slot: usize, e: *mut event.Ev) -> u32 {
    let k: usize = S_K[slot]
    if k == NONE { return event.H_GO }
    let kind: u32 = event.ev_kind(e)
    if kind == event.EV_PAN_MOVE {
        lay.scroll_pan(k, event.ev_dy(e))
        return event.H_STOP
    }
    if kind == event.EV_PAN_END && event.ev_fling(e) {
        lay.scroll_fling(k, event.ev_vy(e), event.ev_time(e))
        return event.H_STOP
    }
    return event.H_GO
}

fn pan0(ud: u64, e: *mut event.Ev) -> u32 { return pan(0, e) }
fn pan1(ud: u64, e: *mut event.Ev) -> u32 { return pan(1, e) }
fn pan2(ud: u64, e: *mut event.Ev) -> u32 { return pan(2, e) }
fn pan3(ud: u64, e: *mut event.Ev) -> u32 { return pan(3, e) }

// Open a scroll area for `slot` inside the current container; returns the inner column (close with app.end), app.NONE when full.
fn open(a: *mut app.App, slot: usize) -> usize {
    let inner: usize = lay.scroll_v(a)
    if inner == NONE || slot >= 4 { return inner }
    let k: usize = lay.scroll_last()
    S_K[slot] = k
    lay.scroll_set_bar(k, 0) // no scrollbar strip (like the web mobile page)
    let vn: usize = lay.scroll_node(k)
    var ok: bool = false
    if slot == 0 { ok = app.on(a, vn, event.EV_PAN_ALL, pan0) }
    if slot == 1 { ok = app.on(a, vn, event.EV_PAN_ALL, pan1) }
    if slot == 2 { ok = app.on(a, vn, event.EV_PAN_ALL, pan2) }
    if slot == 3 { ok = app.on(a, vn, event.EV_PAN_ALL, pan3) }
    return inner
}

// The viewport node of the slot (app.NONE before open): show / hide the whole area with it.
fn node(slot: usize) -> usize {
    if slot >= 4 || S_K[slot] == NONE { return NONE }
    return lay.scroll_node(S_K[slot])
}

// Show or remove the whole area: shown it takes the room left in its column (and gives it up when the page shrinks).
fn show(a: *mut app.App, slot: usize, on: bool) {
    jshell.set_shown_flex(a, node(slot), on)
}
