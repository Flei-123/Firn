// examples/jarvis_android/screen_settings.fi -- the settings tab: theme (system / dark / light), update check
// against the Orient store (channel, installed + available version, release notes, a channel switch when the store offers
// more than one channel for this app), notifications, advanced (developer server panel), sign out.
import std.rt
import fui.app
import fui.scene
import appkit.appinfo
import appkit.update
import appkit.platform
import appkit.util
import jshell
import fui.applay
import jtheme
import jsetui
import jpush
import jtexts
import net.jarvisc
import net.jarvisapi
import screen_chat

export { screen_settings_build, screen_settings_refresh, screen_settings_api, screen_settings_set_admin }

static mut G_THEME: usize = 0
static mut G_UPD_ST: usize = 0
static mut G_UPD_INFO: usize = 0
static mut G_UPD_CH: usize = 0
static mut G_NOTES: usize = 0
static mut G_USER: usize = 0
static mut G_NOTE: [usize; 8] = [0; 8] // line 0: heading, 1..7: the release notes, one label per line (a label has no line breaks)
static mut G_CHAN: usize = 0
static mut G_PUSH: usize = 0
static mut G_INSTALL: usize = 0
static mut G_ADMIN_BTN: usize = 0 // Settings > Admin: only after /api/m/me said admin
static mut G_ME_N: u64 = 0
static mut G_MODEL_B: usize = 0
static mut G_EFFORT_B: usize = 0
static mut G_PERSONA_B: usize = 0
static mut G_SW: [usize; 5] = [0; 5]
static mut G_ADMIN_CARD: usize = 0
static mut G_ADMIN_NOTE: usize = 0
static mut G_FLAGS: u32 = 0
static mut G_PERS: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }
static mut G_PERSONAS: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }
static mut G_SET_N: u64 = 0
static mut G_SET_OK: bool = false
static mut G_IS_ADMIN: bool = false

// Advanced: the server address is not a setting for people. This opens the sign-in page with the developer panel.
fn on_advanced(a: *mut app.App) { jshell.request_dev() }
fn on_admin(a: *mut app.App) { jshell.admin_open() }

fn theme_label(a: *mut app.App) {
    let m: str = jshell.theme_mode()
    if m == "dark" { app.set_text(a, G_THEME, jtexts.t("set.look-dark")) }
    else if m == "light" { app.set_text(a, G_THEME, jtexts.t("set.look-light")) }
    else { app.set_text(a, G_THEME, jtexts.t("set.look-system")) }
}
fn on_sys(a: *mut app.App) { jshell.set_theme_mode("system"); theme_label(a) }
fn on_dark(a: *mut app.App) { jshell.set_theme_mode("dark"); theme_label(a) }
fn on_light(a: *mut app.App) { jshell.set_theme_mode("light"); theme_label(a) }

fn on_check(a: *mut app.App) {
    let ok: bool = update.update_start(jshell.updater(), update.OP_CHECK, update.RUN_AUTO)
}

fn on_install(a: *mut app.App) {
    let u: *mut update.Updater = jshell.updater()
    let s: *mut update.Status = update.update_status(u)
    if (*s).phase == update.PH_AVAILABLE {
        let ok: bool = update.update_start(u, update.OP_FETCH, update.RUN_AUTO)
    } else if (*s).phase == update.PH_READY {
        var none: util.Args = util.args_new()
        let rc: u32 = update.update_apply(u, &none)
        util.args_free(&none)
        if rc == platform.AP_OK {
            app.quit(a)
        }
    }
}

// The catalog says "stabil"; the screen says it in the app language.
fn channel_title(c: str) -> str {
    if c == "stabil" { return jtexts.t("set.stable") }
    return c
}

// The name after `cur` in `names` (one space between names), wrapping to the first; "" when there are fewer than two names.
fn next_channel(names: str, cur: str) -> str {
    var first: str = str { p: names.p, n: 0 }
    var after: str = first
    var have_first: bool = false
    var take: bool = false
    var got: bool = false
    var count: usize = 0
    var st: usize = 0
    var i: usize = 0
    while i <= names.n {
        if i == names.n || rt.ld8(names.p as u64, i) == 32 as u8 {
            if i > st {
                let tok: str = str { p: ((names.p as u64) + st as u64) as *mut u8, n: i - st }
                count = count + 1
                if !have_first {
                    first = tok
                    have_first = true
                }
                if take && !got {
                    after = tok
                    got = true
                }
                take = tok == cur
            }
            st = i + 1
        }
        i = i + 1
    }
    if count < 2 { return "" }
    if got { return __str_copy(after) }
    return __str_copy(first)
}

// switch to the next channel the store offers and look again
fn on_channel(a: *mut app.App) {
    let u: *mut update.Updater = jshell.updater()
    let s: *mut update.Status = update.update_status(u)
    let nx: str = next_channel(update.status_channels(s), appinfo.app_channel())
    if nx.n == 0 { return }
    if update.update_set_channel(u, nx) {
        let ok: bool = update.update_start(u, update.OP_CHECK, update.RUN_AUTO)
    }
}

fn on_logout(a: *mut app.App) { jshell.request_logout() }

// A short German reason for the Status row (the long English text stays in app.log); it must fit next to the label.
fn err_short(e: u64) -> str {
    if e == update.UE_NETWORK { return jtexts.t("upd.e1") }
    if e == update.UE_SIGNATURE { return jtexts.t("upd.e2") }
    if e == update.UE_ENTRY { return jtexts.t("upd.e3") }
    if e == update.UE_CATALOG { return jtexts.t("upd.e4") }
    if e == update.UE_NOT_FOUND { return jtexts.t("upd.e5") }
    if e == update.UE_PLATFORM { return jtexts.t("upd.e6") }
    if e == update.UE_HASH { return jtexts.t("upd.e7") }
    if e == update.UE_SIZE { return jtexts.t("upd.e8") }
    if e == update.UE_DISK { return jtexts.t("upd.e9") }
    if e == update.UE_WRITABLE { return jtexts.t("upd.e10") }
    if e == update.UE_APPLY { return jtexts.t("upd.e11") }
    if e == update.UE_WORKER { return jtexts.t("upd.e12") }
    if e == update.UE_CANCELLED { return jtexts.t("upd.e13") }
    if e == update.UE_CONFIG { return jtexts.t("upd.e14") }
    if e == update.UE_UNSUPPORTED { return jtexts.t("upd.e15") }
    if e == update.UE_VERSION { return jtexts.t("upd.e16") }
    if e == update.UE_FLOOR { return jtexts.t("upd.e17") }
    if e == update.UE_MAGIC { return jtexts.t("upd.e18") }
    return jtexts.t("upd.e0")
}

fn phase_text(s: *mut update.Status) -> str {
    let p: u64 = (*s).phase
    if p == update.PH_CHECKING { return jtexts.t("upd.checking") }
    if p == update.PH_UPTODATE { return jtexts.t("upd.uptodate") }
    if p == update.PH_AVAILABLE { return jtexts.t1("upd.available", "v", update.status_version(s)) }
    if p == update.PH_DOWNLOADING { return jtexts.t("upd.downloading") }
    if p == update.PH_VERIFYING { return jtexts.t("upd.verifying") }
    if p == update.PH_READY { return jtexts.t1("upd.ready", "v", update.status_version(s)) }
    if p == update.PH_APPLYING { return jtexts.t("upd.applying") }
    if p == update.PH_DONE_INSTALLER { return jtexts.t("upd.installer") }
    if p == update.PH_ERROR { return err_short((*s).err) }
    if p == update.PH_UNSUPPORTED { return jtexts.t("upd.unsupported") }
    return jtexts.t("upd.idle")
}

fn set_note_line(a: *mut app.App, k: usize, line: str) {
    app.set_text(a, G_NOTE[k], line)
    jshell.set_shown(a, G_NOTE[k], line.n > 0, 0)
}

// The release notes of the build the channel points at (the offered one, or the installed one when up to date): a heading
// and the lines of the notes, at most seven.
fn show_notes(a: *mut app.App, s: *mut update.Status) {
    var n: str = update.status_notes(s)
    if (*s).phase == update.PH_CHECKING { n = str { p: n.p, n: 0 } }
    if n.n == 0 {
        jshell.set_shown(a, G_NOTES, false, 0)
        var z: usize = 0
        while z < 8 {
            set_note_line(a, z, "")
            z = z + 1
        }
        return
    }
    jshell.set_shown(a, G_NOTES, true, 0)
    set_note_line(a, 0, jtexts.t1("upd.whatsnew", "v", update.status_version(s)))
    var k: usize = 1
    var st: usize = 0
    var i: usize = 0
    while i <= n.n && k < 8 {
        if i == n.n || rt.ld8(n.p as u64, i) == 10 as u8 {
            if i > st {
                set_note_line(a, k, str { p: ((n.p as u64) + st as u64) as *mut u8, n: i - st })
                k = k + 1
            }
            st = i + 1
        }
        i = i + 1
    }
    while k < 8 {
        set_note_line(a, k, "")
        k = k + 1
    }
}

// ---------------------------------------------------------------- model, persona, switches (GET/POST /api/settings)

fn sw_name(i: usize) -> str {
    if i == 0 { return "autoConfirm" }
    if i == 1 { return "deepMode" }
    if i == 2 { return "expMode" }
    if i == 3 { return "learnMode" }
    return "planMode"
}

fn sw_label(i: usize) -> str {
    if i == 0 { return jtexts.t("set.sw-auto") }
    if i == 1 { return jtexts.t("set.sw-deep") }
    if i == 2 { return jtexts.t("set.sw-exp") }
    if i == 3 { return jtexts.t("set.sw-learn") }
    return jtexts.t("set.sw-plan")
}

fn sw_toggle(a: *mut app.App, i: usize) {
    if !G_SET_OK { return }
    let bit: u32 = (1 as u32) << (i as u32)
    let on: bool = (G_FLAGS & bit) == (0 as u32)
    if on { G_FLAGS = G_FLAGS | bit } else { G_FLAGS = G_FLAGS & ~bit }
    let ok: bool = jarvisapi.ja_settings_set_bool(jshell.api(), sw_name(i), on)
    show_settings(a)
}
fn on_sw0(a: *mut app.App) { sw_toggle(a, 0) }
fn on_sw1(a: *mut app.App) { sw_toggle(a, 1) }
fn on_sw2(a: *mut app.App) { sw_toggle(a, 2) }
fn on_sw3(a: *mut app.App) { sw_toggle(a, 3) }
fn on_sw4(a: *mut app.App) { sw_toggle(a, 4) }

fn on_model_next(a: *mut app.App) { screen_chat.screen_chat_cycle_model(a) }
fn on_effort_next(a: *mut app.App) { screen_chat.screen_chat_cycle_effort(a) }

// persona ids: jarvis, normal, then the user's personas ("id\x01name\n" lines)
fn persona_count() -> usize {
    var n: usize = 2
    var i: usize = 0
    while i < G_PERSONAS.len {
        if rt.ld8(G_PERSONAS.ptr, i) == 10 as u8 { n = n + 1 }
        i = i + 1
    }
    return n
}

// field f (0 = id, 1 = name) of persona k (k >= 2 -> custom line k-2)
fn persona_field(k: usize, f: usize) -> str {
    if k == 0 { if f == 0 { return "jarvis" } else { return jtexts.t("set.persona-jarvis") } }
    if k == 1 { if f == 0 { return "normal" } else { return jtexts.t("set.persona-normal") } }
    var line: usize = 0
    var st: usize = 0
    var i: usize = 0
    while i < G_PERSONAS.len {
        if rt.ld8(G_PERSONAS.ptr, i) == 10 as u8 {
            if line == k - 2 {
                var sep: usize = st
                while sep < i && rt.ld8(G_PERSONAS.ptr, sep) != 1 as u8 { sep = sep + 1 }
                if f == 0 { return str { p: ((G_PERSONAS.ptr) + st as u64) as *mut u8, n: sep - st } }
                if sep < i { return str { p: ((G_PERSONAS.ptr) + (sep + 1) as u64) as *mut u8, n: i - sep - 1 } }
                return ""
            }
            line = line + 1
            st = i + 1
        }
        i = i + 1
    }
    return ""
}

fn persona_cur() -> usize {
    let n: usize = persona_count()
    var k: usize = 0
    while k < n {
        let id: str = persona_field(k, 0)
        if G_PERS.len == id.n && id.n > 0 && rt.mem_eq(G_PERS.ptr, id.p as u64, id.n) { return k }
        k = k + 1
    }
    return 0
}

fn on_persona_next(a: *mut app.App) {
    if !G_SET_OK { return }
    let n: usize = persona_count()
    let nx: usize = (persona_cur() + 1) % n
    let id: str = __str_copy(persona_field(nx, 0))
    rt.buf_clear(&G_PERS)
    rt.buf_push_bytes(&G_PERS, id.p as u64, id.n)
    let ok: bool = jarvisapi.ja_settings_set_str(jshell.api(), "personality", id)
    show_settings(a)
}

fn show_settings(a: *mut app.App) {
    var i: usize = 0
    while i < 5 {
        let bit: u32 = (1 as u32) << (i as u32)
        var st: str = jtexts.t("set.sw-off")
        if (G_FLAGS & bit) != (0 as u32) { st = jtexts.t("set.sw-on") }
        app.set_text(a, G_SW[i], sw_label(i) + ": " + st)
        i = i + 1
    }
    app.set_text(a, G_PERSONA_B, jtexts.t1("set.persona-btn", "name", persona_field(persona_cur(), 1)))
}

fn show_model(a: *mut app.App) {
    let m: str = screen_chat.screen_chat_cur_model()
    let e: str = screen_chat.screen_chat_cur_effort()
    if m.n == 0 {
        app.set_text(a, G_MODEL_B, jtexts.t("set.model-none"))
    } else {
        app.set_text(a, G_MODEL_B, jtexts.t1("set.model-btn", "name", m))
    }
    jshell.set_shown(a, G_EFFORT_B, e.n > 0, 0)
    if e.n > 0 { app.set_text(a, G_EFFORT_B, jtexts.t1("set.effort-btn", "name", e)) }
}

fn screen_settings_set_admin(a: *mut app.App, admin: bool) {
    G_IS_ADMIN = admin
    jshell.set_shown(a, G_ADMIN_CARD, admin, 0)
}

// the admin area: a later step (the routes /api/m/admin/* exist on the server); for now a stub line
fn admin_open(a: *mut app.App) {
    app.set_text(a, G_ADMIN_NOTE, jtexts.t("set.admin-soon"))
}

// true = ours
fn screen_settings_api(x: *mut jarvisapi.Api, kind: u32, status: i64) -> bool {
    if kind == jarvisapi.AK_ME {
        if status == 200 { screen_settings_set_admin(jshell.app_ui(), jarvisapi.parse_admin(jarvisapi.ja_body_ptr(x), jarvisapi.ja_body_len(x))) }
        return false // main.fi keeps the user name
    }
    if kind == jarvisapi.AK_SETTINGS || kind == jarvisapi.AK_SETTINGS_SET {
        if status == 200 {
            var f: u32 = 0 as u32
            rt.buf_clear(&G_PERS)
            rt.buf_clear(&G_PERSONAS)
            if jarvisapi.parse_settings(jarvisapi.ja_body_ptr(x), jarvisapi.ja_body_len(x), &f, &G_PERS, &G_PERSONAS) {
                G_FLAGS = f
                G_SET_OK = true
                show_settings(jshell.app_ui())
            }
        } else if kind == jarvisapi.AK_SETTINGS_SET {
            G_SET_N = 0 // not stored: read the real state again soon
        }
        return true
    }
    return false
}

fn screen_settings_build(a: *mut app.App) {
    jsetui.page(a)
    // MODELL + PERSOENLICHKEIT
    jsetui.card(a, jtexts.t("set.model"))
    jsetui.chip_row(a)
    G_MODEL_B = app.button(a, jtexts.t("set.model-none"), on_model_next)
    jtheme.style_node(a, G_MODEL_B, jtheme.K_CHIP)
    G_EFFORT_B = app.button(a, "", on_effort_next)
    jtheme.style_node(a, G_EFFORT_B, jtheme.K_CHIP)
    app.end(a)
    app.end(a)
    jsetui.card(a, jtexts.t("set.persona"))
    jsetui.chip_row(a)
    G_PERSONA_B = app.button(a, jtexts.t1("set.persona-btn", "name", "-"), on_persona_next)
    jtheme.style_node(a, G_PERSONA_B, jtheme.K_CHIP)
    app.end(a)
    app.end(a)
    // SCHALTER
    jsetui.card(a, jtexts.t("set.switches"))
    jsetui.chip_row(a)
    G_SW[0] = app.button(a, "", on_sw0)
    G_SW[1] = app.button(a, "", on_sw1)
    G_SW[2] = app.button(a, "", on_sw2)
    G_SW[3] = app.button(a, "", on_sw3)
    G_SW[4] = app.button(a, "", on_sw4)
    var q: usize = 0
    while q < 5 {
        jtheme.style_node(a, G_SW[q], jtheme.K_CHIP)
        q = q + 1
    }
    app.end(a)
    app.end(a)
    // ERSCHEINUNGSBILD
    jsetui.card(a, jtexts.t("set.look"))
    G_THEME = jsetui.row(a, jtexts.t("set.look-theme"))
    theme_label(a)
    jsetui.chip_row(a)
    jtheme.style_node(a, app.button(a, jtexts.t("set.look-system"), on_sys), jtheme.K_CHIP)
    jtheme.style_node(a, app.button(a, jtexts.t("set.look-dark"), on_dark), jtheme.K_CHIP)
    jtheme.style_node(a, app.button(a, jtexts.t("set.look-light"), on_light), jtheme.K_CHIP)
    app.end(a)
    app.end(a)
    // UPDATES
    jsetui.card(a, jtexts.t("set.upd"))
    G_UPD_INFO = jsetui.row(a, jtexts.t("set.installed"))
    G_UPD_CH = jsetui.row(a, jtexts.t("set.channel"))
    G_UPD_ST = jsetui.row(a, jtexts.t("set.status"))
    G_NOTES = applay.vstack(a)
    applay.gap(a, G_NOTES, 4, 4)
    var k: usize = 0
    while k < 8 {
        G_NOTE[k] = jsetui.text_row(a, "")
        k = k + 1
    }
    app.end(a)
    jsetui.chip_row(a)
    jtheme.style_node(a, app.button(a, jtexts.t("set.check"), on_check), jtheme.K_CHIP)
    G_INSTALL = app.button(a, jtexts.t("set.install"), on_install)
    jtheme.style_node(a, G_INSTALL, jtheme.K_CHIP)
    G_CHAN = app.button(a, jtexts.t("set.channel"), on_channel)
    jtheme.style_node(a, G_CHAN, jtheme.K_CHIP)
    app.end(a)
    app.end(a)
    // BENACHRICHTIGUNGEN
    jsetui.card(a, jtexts.t("set.notif"))
    G_PUSH = jsetui.row(a, jtexts.t("set.push"))
    app.end(a)
    // KONTO
    jsetui.card(a, jtexts.t("set.account"))
    G_USER = jsetui.row(a, jtexts.t("set.user"))
    let sv: usize = jsetui.row(a, jtexts.t("set.server"))
    app.set_text(a, sv, jshell.server_base())
    jsetui.chip_row(a)
    jtheme.style_node(a, app.button(a, jtexts.t("set.logout"), on_logout), jtheme.K_CHIP)
    jtheme.style_node(a, app.button(a, jtexts.t("settings.advanced"), on_advanced), jtheme.K_CHIP)
    G_ADMIN_BTN = app.button(a, jtexts.t("adm.open"), on_admin)
    jtheme.style_node(a, G_ADMIN_BTN, jtheme.K_CHIP)
    jshell.set_shown(a, G_ADMIN_BTN, false, 0)
    app.end(a)
    app.end(a)
    // ADMIN (only when /api/me says admin)
    G_ADMIN_CARD = jsetui.card(a, jtexts.t("set.admin"))
    jsetui.chip_row(a)
    jtheme.style_node(a, app.button(a, jtexts.t("set.admin-open"), admin_open), jtheme.K_CHIP)
    app.end(a)
    G_ADMIN_NOTE = jsetui.text_row(a, "")
    app.end(a)
    jshell.set_shown(a, G_ADMIN_CARD, false, 0)
    // APP
    jsetui.card(a, jtexts.t("set.about"))
    let ver: usize = jsetui.row(a, jtexts.t("set.version"))
    app.set_text(a, ver, appinfo.app_version())
    app.end(a)
    app.end(a)
}

fn screen_settings_refresh(a: *mut app.App) {
    let s: *mut update.Status = update.update_status(jshell.updater())
    app.set_text(a, G_UPD_INFO, appinfo.app_version())
    app.set_text(a, G_UPD_CH, channel_title(appinfo.app_channel()))
    app.set_text(a, G_UPD_ST, phase_text(s))
    app.set_text(a, G_USER, jarvisc.jc_user(jshell.jc()))
    // a restored session (token only) has no name: ask /api/me now and then until it is there
    if jarvisc.jc_user(jshell.jc()).n == 0 {
        G_ME_N = G_ME_N + 1
        if G_ME_N % 8 == 1 { let m: bool = jarvisapi.ja_me(jshell.api()) }
    }
    show_notes(a, s)
    show_model(a)
    G_SET_N = G_SET_N + 1
    if G_SET_N % 40 == 1 {
        let g: bool = jarvisapi.ja_settings_get(jshell.api())
        if G_SET_N == 1 { let m2: bool = jarvisapi.ja_me(jshell.api()) }
    }
    let nx: str = next_channel(update.status_channels(s), appinfo.app_channel())
    jshell.set_shown(a, G_CHAN, nx.n > 0, 0)
    if nx.n > 0 { app.set_text(a, G_CHAN, jtexts.t1("set.channel-btn", "name", channel_title(nx))) }
    app.set_text(a, G_PUSH, jpush.state_text())
    jshell.set_shown(a, G_ADMIN_BTN, jshell.is_admin(), 0)
    jshell.set_shown(a, G_INSTALL, (*s).phase == update.PH_AVAILABLE || (*s).phase == update.PH_READY, 0)
}
