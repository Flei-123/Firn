// SPDX-License-Identifier: MPL-2.0
// examples/jarvis_android/screen_settings.fi -- the settings tab: theme (system / dark / light), update check
// against the Orient store (channel, installed + available version, release notes, a channel switch when the store offers
// more than one channel for this app), notifications, advanced (developer server panel), sign out.
import std.rt
import fui.app
import fui.scene
import appkit.appinfo
import appkit.update
import appkit.platform
import appkit.util
import jshell
import fui.applay
import jtheme
import jsetui
import jpush
import jtexts
import net.jarvisc

export { screen_settings_build, screen_settings_refresh }

static mut G_THEME: usize = 0
static mut G_UPD_ST: usize = 0
static mut G_UPD_INFO: usize = 0
static mut G_UPD_CH: usize = 0
static mut G_NOTES: usize = 0
static mut G_USER: usize = 0
static mut G_NOTE: [usize; 8] = [0; 8] // line 0: heading, 1..7: the release notes, one label per line (a label has no line breaks)
static mut G_CHAN: usize = 0
static mut G_PUSH: usize = 0
static mut G_INSTALL: usize = 0

// Advanced: the server address is not a setting for people. This opens the sign-in page with the developer panel.
fn on_advanced(a: *mut app.App) { jshell.request_dev() }

fn theme_label(a: *mut app.App) {
    let m: str = jshell.theme_mode()
    if m == "dark" { app.set_text(a, G_THEME, jtexts.t("set.look-dark")) }
    else if m == "light" { app.set_text(a, G_THEME, jtexts.t("set.look-light")) }
    else { app.set_text(a, G_THEME, jtexts.t("set.look-system")) }
}
fn on_sys(a: *mut app.App) { jshell.set_theme_mode("system"); theme_label(a) }
fn on_dark(a: *mut app.App) { jshell.set_theme_mode("dark"); theme_label(a) }
fn on_light(a: *mut app.App) { jshell.set_theme_mode("light"); theme_label(a) }

fn on_check(a: *mut app.App) {
    let ok: bool = update.update_start(jshell.updater(), update.OP_CHECK, update.RUN_AUTO)
}

fn on_install(a: *mut app.App) {
    let u: *mut update.Updater = jshell.updater()
    let s: *mut update.Status = update.update_status(u)
    if (*s).phase == update.PH_AVAILABLE {
        let ok: bool = update.update_start(u, update.OP_FETCH, update.RUN_AUTO)
    } else if (*s).phase == update.PH_READY {
        var none: util.Args = util.args_new()
        let rc: u32 = update.update_apply(u, &none)
        util.args_free(&none)
        if rc == platform.AP_OK {
            app.quit(a)
        }
    }
}

// The catalog says "stabil"; the screen says it in the app language.
fn channel_title(c: str) -> str {
    if c == "stabil" { return jtexts.t("set.stable") }
    return c
}

// The name after `cur` in `names` (one space between names), wrapping to the first; "" when there are fewer than two names.
fn next_channel(names: str, cur: str) -> str {
    var first: str = str { p: names.p, n: 0 }
    var after: str = first
    var have_first: bool = false
    var take: bool = false
    var got: bool = false
    var count: usize = 0
    var st: usize = 0
    var i: usize = 0
    while i <= names.n {
        if i == names.n || rt.ld8(names.p as u64, i) == 32 as u8 {
            if i > st {
                let tok: str = str { p: ((names.p as u64) + st as u64) as *mut u8, n: i - st }
                count = count + 1
                if !have_first {
                    first = tok
                    have_first = true
                }
                if take && !got {
                    after = tok
                    got = true
                }
                take = tok == cur
            }
            st = i + 1
        }
        i = i + 1
    }
    if count < 2 { return "" }
    if got { return __str_copy(after) }
    return __str_copy(first)
}

// switch to the next channel the store offers and look again
fn on_channel(a: *mut app.App) {
    let u: *mut update.Updater = jshell.updater()
    let s: *mut update.Status = update.update_status(u)
    let nx: str = next_channel(update.status_channels(s), appinfo.app_channel())
    if nx.n == 0 { return }
    if update.update_set_channel(u, nx) {
        let ok: bool = update.update_start(u, update.OP_CHECK, update.RUN_AUTO)
    }
}

fn on_logout(a: *mut app.App) { jshell.request_logout() }

fn phase_text(s: *mut update.Status) -> str {
    let p: u64 = (*s).phase
    if p == update.PH_CHECKING { return jtexts.t("upd.checking") }
    if p == update.PH_UPTODATE { return jtexts.t("upd.uptodate") }
    if p == update.PH_AVAILABLE { return jtexts.t1("upd.available", "v", update.status_version(s)) }
    if p == update.PH_DOWNLOADING { return jtexts.t("upd.downloading") }
    if p == update.PH_VERIFYING { return jtexts.t("upd.verifying") }
    if p == update.PH_READY { return jtexts.t1("upd.ready", "v", update.status_version(s)) }
    if p == update.PH_APPLYING { return jtexts.t("upd.applying") }
    if p == update.PH_DONE_INSTALLER { return jtexts.t("upd.installer") }
    if p == update.PH_ERROR { return jtexts.t1("upd.error", "e", update.status_error(s)) }
    if p == update.PH_UNSUPPORTED { return jtexts.t("upd.unsupported") }
    return jtexts.t("upd.idle")
}

fn set_note_line(a: *mut app.App, k: usize, line: str) {
    app.set_text(a, G_NOTE[k], line)
    jshell.set_shown(a, G_NOTE[k], line.n > 0, 0)
}

// The release notes of the build the channel points at (the offered one, or the installed one when up to date): a heading
// and the lines of the notes, at most seven.
fn show_notes(a: *mut app.App, s: *mut update.Status) {
    var n: str = update.status_notes(s)
    if (*s).phase == update.PH_CHECKING { n = str { p: n.p, n: 0 } }
    if n.n == 0 {
        jshell.set_shown(a, G_NOTES, false, 0)
        var z: usize = 0
        while z < 8 {
            set_note_line(a, z, "")
            z = z + 1
        }
        return
    }
    jshell.set_shown(a, G_NOTES, true, 0)
    set_note_line(a, 0, jtexts.t1("upd.whatsnew", "v", update.status_version(s)))
    var k: usize = 1
    var st: usize = 0
    var i: usize = 0
    while i <= n.n && k < 8 {
        if i == n.n || rt.ld8(n.p as u64, i) == 10 as u8 {
            if i > st {
                set_note_line(a, k, str { p: ((n.p as u64) + st as u64) as *mut u8, n: i - st })
                k = k + 1
            }
            st = i + 1
        }
        i = i + 1
    }
    while k < 8 {
        set_note_line(a, k, "")
        k = k + 1
    }
}

fn screen_settings_build(a: *mut app.App) {
    jsetui.page(a)
    // ERSCHEINUNGSBILD
    jsetui.card(a, jtexts.t("set.look"))
    G_THEME = jsetui.row(a, jtexts.t("set.look-theme"))
    theme_label(a)
    jsetui.chip_row(a)
    jtheme.style_node(a, app.button(a, jtexts.t("set.look-system"), on_sys), jtheme.K_CHIP)
    jtheme.style_node(a, app.button(a, jtexts.t("set.look-dark"), on_dark), jtheme.K_CHIP)
    jtheme.style_node(a, app.button(a, jtexts.t("set.look-light"), on_light), jtheme.K_CHIP)
    app.end(a)
    app.end(a)
    // UPDATES
    jsetui.card(a, jtexts.t("set.upd"))
    G_UPD_INFO = jsetui.row(a, jtexts.t("set.installed"))
    G_UPD_CH = jsetui.row(a, jtexts.t("set.channel"))
    G_UPD_ST = jsetui.row(a, jtexts.t("set.status"))
    G_NOTES = applay.vstack(a)
    applay.gap(a, G_NOTES, 4, 4)
    var k: usize = 0
    while k < 8 {
        G_NOTE[k] = jsetui.text_row(a, "")
        k = k + 1
    }
    app.end(a)
    jsetui.chip_row(a)
    jtheme.style_node(a, app.button(a, jtexts.t("set.check"), on_check), jtheme.K_CHIP)
    G_INSTALL = app.button(a, jtexts.t("set.install"), on_install)
    jtheme.style_node(a, G_INSTALL, jtheme.K_CHIP)
    G_CHAN = app.button(a, jtexts.t("set.channel"), on_channel)
    jtheme.style_node(a, G_CHAN, jtheme.K_CHIP)
    app.end(a)
    app.end(a)
    // BENACHRICHTIGUNGEN
    jsetui.card(a, jtexts.t("set.notif"))
    G_PUSH = jsetui.row(a, jtexts.t("set.push"))
    app.end(a)
    // KONTO
    jsetui.card(a, jtexts.t("set.account"))
    G_USER = jsetui.row(a, jtexts.t("set.user"))
    let sv: usize = jsetui.row(a, jtexts.t("set.server"))
    app.set_text(a, sv, jshell.server_base())
    jsetui.chip_row(a)
    jtheme.style_node(a, app.button(a, jtexts.t("set.logout"), on_logout), jtheme.K_CHIP)
    jtheme.style_node(a, app.button(a, jtexts.t("settings.advanced"), on_advanced), jtheme.K_CHIP)
    app.end(a)
    app.end(a)
    // APP
    jsetui.card(a, jtexts.t("set.about"))
    let ver: usize = jsetui.row(a, jtexts.t("set.version"))
    app.set_text(a, ver, appinfo.app_version())
    app.end(a)
    app.end(a)
}

fn screen_settings_refresh(a: *mut app.App) {
    let s: *mut update.Status = update.update_status(jshell.updater())
    app.set_text(a, G_UPD_INFO, appinfo.app_version())
    app.set_text(a, G_UPD_CH, channel_title(appinfo.app_channel()))
    app.set_text(a, G_UPD_ST, phase_text(s))
    app.set_text(a, G_USER, jarvisc.jc_user(jshell.jc()))
    show_notes(a, s)
    let nx: str = next_channel(update.status_channels(s), appinfo.app_channel())
    jshell.set_shown(a, G_CHAN, nx.n > 0, 0)
    if nx.n > 0 { app.set_text(a, G_CHAN, jtexts.t1("set.channel-btn", "name", channel_title(nx))) }
    app.set_text(a, G_PUSH, jpush.state_text())
    jshell.set_shown(a, G_INSTALL, (*s).phase == update.PH_AVAILABLE || (*s).phase == update.PH_READY, 0)
}
