// SPDX-License-Identifier: MPL-2.0
// examples/jarvis_android/jlist.fi -- helpers shared by the list screens: building a row text without allocating (the row source
// runs for every visible row in every frame) and PULL-TO-REFRESH for fui virtual lists.
//
// Pull-to-refresh: fui.app has ONE pointer hook; jlist owns it. A finger (or mouse) that goes down on a registered list while the
// list is scrolled to the top and is released more than PULL_PX lower than it started calls the list's refresh function. The
// list itself keeps handling the same touch (the hook never swallows it).
import std.rt
import fui.app
import fui.scene
import fui.vlist
import plat.fuiwirt

export { put, put_dec, pull_add, pull_install, pull_pending, fit, fit_pt, ROW_PT, CARD_PT, PULL_PX }

const ROW_PT: usize = 36
// a project card row (title, bar, stand line, next step, open question)
const CARD_PT: usize = 104
const PULL_PX: f64 = 70.0
const SLOTS: usize = 4

static mut G_NODE: [usize; 4] = [0; 4]
static mut G_CB: u64 = 0

struct Cbs {
    f: [fn(*mut app.App); 4],
}
static mut G_COUNT: usize = 0
static mut G_DOWN: usize = 4
static mut G_Y0: f64 = 0.0
static mut G_PENDING: u64 = 0

fn cb_none(a: *mut app.App) {}

// The list card is as high as its rows (between `lo` and `hi` rows), not a fixed block: an empty or short list leaves no void.
fn fit(a: *mut app.App, n: usize, count: usize, lo: usize, hi: usize) {
    if n == app.NONE { return }
    var r: usize = count
    if r < lo { r = lo }
    if r > hi { r = hi }
    scene.node_set_size(app.app_scene(a), n, 340.0, (r * ROW_PT + 2) as f64)
}

// like fit, rows of `pt` design points
fn fit_pt(a: *mut app.App, n: usize, count: usize, lo: usize, hi: usize, pt: usize) {
    if n == app.NONE { return }
    var r: usize = count
    if r < lo { r = lo }
    if r > hi { r = hi }
    scene.node_set_size(app.app_scene(a), n, 340.0, (r * pt + 2) as f64)
}

// append `s` to the row's cell text (cut at the cell size)
fn put(out: *mut vlist.VRow, s: str) {
    var i: usize = 0
    var n: usize = (*out).n
    while i < s.n && n < vlist.VROW_TEXT {
        (*out).text[n] = *((s.p as u64 + i as u64) as *mut u8)
        n = n + 1
        i = i + 1
    }
    (*out).n = n
}

fn put_dec(out: *mut vlist.VRow, v: i64) {
    var tmp: [u8; 24] = [0; 24]
    var k: usize = 0
    var x: i64 = v
    var neg: bool = false
    if x < 0 {
        neg = true
        x = 0 - x
    }
    if x == 0 {
        tmp[0] = 48 as u8
        k = 1
    }
    while x > 0 && k < 22 {
        tmp[k] = (48 + (x % 10)) as u8
        x = x / 10
        k = k + 1
    }
    var n: usize = (*out).n
    if neg && n < vlist.VROW_TEXT {
        (*out).text[n] = 45 as u8
        n = n + 1
    }
    while k > 0 && n < vlist.VROW_TEXT {
        k = k - 1
        (*out).text[n] = tmp[k]
        n = n + 1
    }
    (*out).n = n
}

fn fire(a: *mut app.App, slot: usize) {
    G_PENDING = G_PENDING + 1 as u64
    if G_CB == 0 { return }
    let f: fn(*mut app.App) = (*(G_CB as *mut Cbs)).f[slot]
    f(a)
}

// how many pulls happened (a screen can show "refreshing")
fn pull_pending() -> u64 { return G_PENDING }

fn inside(a: *mut app.App, slot: usize, x: f64, y: f64) -> bool {
    let sc: *mut scene.Scene = app.app_scene(a)
    let n: usize = G_NODE[slot]
    if scene.node_h(sc, n) < 40.0 { return false } // a list on a hidden page has no room
    return x >= scene.node_x(sc, n) && x < scene.node_x(sc, n) + scene.node_w(sc, n)
    && y >= scene.node_y(sc, n) && y < scene.node_y(sc, n) + scene.node_h(sc, n)
}

fn at_top(a: *mut app.App, slot: usize) -> bool {
    let v: *mut vlist.Vlist = app.vlist_model(a, G_NODE[slot])
    if v as u64 == 0 { return false }
    return vlist.vl_scroll_y(v) < 1.0
}

fn hook(a: *mut app.App, kind: u32, x: f64, y: f64) -> bool {
    if kind == fuiwirt.HOOK_DOWN {
        G_DOWN = SLOTS
        var k: usize = 0
        while k < G_COUNT {
            if inside(a, k, x, y) && at_top(a, k) {
                G_DOWN = k
                G_Y0 = y
            }
            k = k + 1
        }
    } else if kind == fuiwirt.HOOK_UP {
        if G_DOWN < SLOTS && y - G_Y0 > PULL_PX {
            let s: usize = G_DOWN
            G_DOWN = SLOTS
            fire(a, s)
        }
        G_DOWN = SLOTS
    }
    return false
}

fn pull_install(a: *mut app.App) {
    app.on_pointer(a, hook)
}

// register a list node; `f` runs on a pull (it should force a refresh)
fn pull_add(list: usize, f: fn(*mut app.App)) {
    if G_COUNT >= SLOTS { return }
    if G_CB == 0 {
        G_CB = rt.heap_alloc(64)
        *(G_CB as *mut Cbs) = Cbs { f: [cb_none; 4] }
    }
    G_NODE[G_COUNT] = list
    (*(G_CB as *mut Cbs)).f[G_COUNT] = f
    G_COUNT = G_COUNT + 1
}
