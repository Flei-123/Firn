// SPDX-License-Identifier: MPL-2.0
// examples/jarvis_android/screen_login.fi -- the sign-in page of the JARVIS app: logo, user, password (Show/Hide), "Sign in".
//
// The server is NOT a field: jshell.server_base() (https://jarvis.fleitec.com, or the hidden developer address). The developer
// panel opens with 7 taps on the logo (and from Settings > Advanced through screen_login_open_dev); it has the address and a
// reset to the default. Keyboard: the first field's action key says "Next" (Enter moves to the password), Enter in the
// password signs in. All texts come from jtexts (locale/*.opmsg). Errors are words, never codes: login_error_key maps the
// answer of net.jarvisc (JE_LOGIN arg: HTTP status, 0 = no answer, plus jc_net_layer for the reason) to a text key.
import std.rt
import net.jarvisc
import fui.app
import fui.scene
import fui.flex
import fui.applay
import jshell
import jtheme
import jsetui
import jtexts

export {
    screen_login_build, screen_login_enter, screen_login_result, screen_login_reset, screen_login_error, screen_login_open_dev,
    screen_login_fid_enable, login_error_key,
}

const TAPS_FOR_DEV: i64 = 7

static mut G_ROOT: usize = 0
static mut G_USER: usize = 0
static mut G_PASS: usize = 0
static mut G_SHOW: usize = 0
static mut G_SUBMIT: usize = 0
static mut G_ERR: usize = 0
static mut G_FID: usize = 0
static mut G_DEV: usize = 0
static mut G_URL: usize = 0
static mut G_DEV_ST: usize = 0
static mut G_TAPS: i64 = 0
static mut G_VISIBLE: bool = false
static mut G_BUSY: bool = false

// the text key for a failed sign-in; "" = it worked. `status` is JE_LOGIN's arg, `layer` = jc_net_layer (only used when
// status == 0: 2 dns, 3 tcp, 4 tls-noroots, 5 tls-cert, 6 tls-other, 7 timeout; 0/other = "no answer").
fn login_error_key(status: i64, layer: i64) -> str {
    if status == 200 { return "" }
    if status == 0 {
        if layer == 2 { return "login.err-dns" }
        if layer == 3 { return "login.err-server-down" }
        if layer == 4 { return "login.err-tls-roots" }
        if layer == 5 || layer == 6 { return "login.err-tls" }
        if layer == 7 { return "login.err-timeout" }
        return "login.err-server-down"
    }
    if status == 401 || status == 403 { return "login.err-password" }
    if status == 429 { return "login.err-limit" }
    if status == 502 { return "login.err-answer" }
    return "login.err-server"
}

fn screen_login_error(s: str) {
    let a: *mut app.App = jshell.app_ui()
    app.set_text(a, G_ERR, s)
}

fn set_busy(b: bool) {
    G_BUSY = b
    let a: *mut app.App = jshell.app_ui()
    if b {
        app.set_text(a, G_ERR, jtexts.t("login.busy"))
    }
}

fn on_title(a: *mut app.App) {
    G_TAPS = G_TAPS + 1
    if G_TAPS >= TAPS_FOR_DEV {
        G_TAPS = 0
        screen_login_open_dev()
    }
}

fn on_show(a: *mut app.App) {
    G_VISIBLE = !G_VISIBLE
    app.set_secret(a, G_PASS, !G_VISIBLE)
    if G_VISIBLE {
        app.set_text(a, G_SHOW, jtexts.t("login.hide"))
    } else {
        app.set_text(a, G_SHOW, jtexts.t("login.show"))
    }
}

// the user typed both: go (empty fields get a word, not a request)
fn submit(a: *mut app.App) {
    if G_BUSY { return }
    let user: str = __str_copy(app.text(a, G_USER))
    let pw: str = __str_copy(app.text(a, G_PASS))
    if user.n == 0 && pw.n == 0 {
        screen_login_error(jtexts.t("login.empty"))
        app.set_focus(a, G_USER)
        return
    }
    if user.n == 0 {
        screen_login_error(jtexts.t("login.empty-user"))
        app.set_focus(a, G_USER)
        return
    }
    if pw.n == 0 {
        screen_login_error(jtexts.t("login.empty-pass"))
        app.set_focus(a, G_PASS)
        return
    }
    jarvisc.jc_set_base(jshell.jc(), jshell.server_base())
    if jarvisc.jc_login(jshell.jc(), user, pw) {
        set_busy(true)
    } else {
        screen_login_error(jtexts.t("login.err-offline"))
    }
}

fn on_submit(a: *mut app.App) { submit(a) }

// Enter / the keyboard's action key; true = used. First field: on to the password. Password: sign in.
fn screen_login_enter(a: *mut app.App) -> bool {
    if app.focus(a) == G_USER {
        app.set_focus(a, G_PASS)
        return true
    }
    submit(a)
    return true
}

// JE_LOGIN arrived (any answer): stop the busy state; the caller handles success, this words the failures
fn screen_login_result(status: i64, layer: i64) {
    G_BUSY = false
    let k: str = login_error_key(status, layer)
    if k.n == 0 {
        screen_login_error("")
    } else if status >= 500 && status != 502 {
        screen_login_error(jtexts.t1(k, "code", jshell.dec(status)))
    } else if k == "login.err-server" {
        screen_login_error(jtexts.t1(k, "code", jshell.dec(status)))
    } else {
        screen_login_error(jtexts.t(k))
    }
}

// back to a clean page (after sign-out, expired session, success)
fn screen_login_reset() {
    let a: *mut app.App = jshell.app_ui()
    G_BUSY = false
    G_TAPS = 0
    app.set_text(a, G_PASS, "")
    if G_VISIBLE { on_show(a) }
}

fn on_fid(a: *mut app.App) { screen_login_error(jtexts.t("login.fid-soon")) }

// the hook for "Sign in with JARVIS account" (Fleitec-ID, device code): the button exists but is hidden until it is enabled
fn screen_login_fid_enable(on: bool) {
    jshell.set_shown(jshell.app_ui(), G_FID, on, 0)
}

fn dev_status(s: str) { app.set_text(jshell.app_ui(), G_DEV_ST, s) }

fn on_dev_save(a: *mut app.App) {
    var u: str = __str_copy(app.text(a, G_URL))
    var n: usize = u.n
    while n > 0 && *(u.p + n - 1) == 47 as u8 { n = n - 1 }
    u = str { p: u.p, n: n }
    let https: bool = n > 8 && str { p: u.p, n: 8 } == "https://"
    let http: bool = n > 7 && str { p: u.p, n: 7 } == "http://"
    if !https && !http {
        dev_status(jtexts.t("dev.bad-url"))
        return
    }
    jshell.set_dev_server(__str_copy(u))
    dev_status(jtexts.t("dev.saved"))
}

fn on_dev_reset(a: *mut app.App) {
    jshell.set_dev_server("")
    app.set_text(a, G_URL, jshell.DEFAULT_BASE)
    dev_status(jtexts.t1("dev.reset-done", "url", jshell.DEFAULT_BASE))
}

// show the developer panel (7 taps on the logo; Settings > Advanced)
fn screen_login_open_dev() {
    let a: *mut app.App = jshell.app_ui()
    app.set_text(a, G_URL, jshell.server_base())
    dev_status("")
    jshell.set_shown(a, G_DEV, true, 0)
}

// the page; the caller shows/hides the returned node. Opens and closes its own column.
// Shape of the web sign-in card: brand, tagline, fields, wide primary button, all from the left edge.
fn screen_login_build(a: *mut app.App) -> usize {
    G_ROOT = app.column(a)
    let sc: *mut scene.Scene = app.app_scene(a)
    scene.node_set_flex(sc, G_ROOT, flex.FLEX_COLUMN, flex.JUSTIFY_CENTER, flex.AL_STRETCH)
    scene.node_set_padding(sc, G_ROOT, 16, 12, 16, 12)
    jshell.fill_stretch(a, G_ROOT)
    let cd: usize = jsetui.card(a, "")
    applay.pad(a, cd, 24, 26, 24, 26)
    applay.gap(a, cd, 12, 12)
    let title: usize = app.label(a, jtexts.t("login.title"), 0)
    jtheme.style_node(a, title, jsetui.K_LOGIN_BRAND)
    applay.align_start(a, title)
    app.node_set_click(a, title, on_title)
    let tag: usize = app.label(a, jtexts.t("login.tagline"), 0)
    jtheme.style_node(a, tag, jsetui.K_SET_LABEL)
    applay.align_start(a, tag)
    app.spacer(a, 1, 6)
    G_USER = jsetui.input(a, jtexts.t("login.user"))
    app.set_ime_next(a, G_USER, true)
    applay.hline(a)
    G_PASS = jsetui.input(a, jtexts.t("login.password"))
    applay.grow(a, G_PASS, 1)
    app.set_secret(a, G_PASS, true)
    G_SHOW = app.button(a, jtexts.t("login.show"), on_show)
    jtheme.style_node(a, G_SHOW, jtheme.K_CHIP)
    app.end(a)
    G_SUBMIT = jsetui.primary(a, jtexts.t("login.submit"), on_submit)
    G_FID = app.button(a, jtexts.t("login.fid"), on_fid)
    jtheme.style_node(a, G_FID, jtheme.K_CHIP)
    G_ERR = app.label(a, "", 0)
    jtheme.style_node(a, G_ERR, jsetui.K_SET_ERR)
    applay.align_start(a, G_ERR)
    G_DEV = applay.vstack(a)
    let dt: usize = app.label(a, jtexts.t("dev.title"), 0)
    jtheme.style_node(a, dt, jsetui.K_SET_HEAD)
    applay.align_start(a, dt)
    G_URL = jsetui.input(a, jtexts.t("dev.url"))
    applay.hrow(a)
    jtheme.style_node(a, app.button(a, jtexts.t("dev.save"), on_dev_save), jtheme.K_CHIP)
    jtheme.style_node(a, app.button(a, jtexts.t("dev.reset"), on_dev_reset), jtheme.K_CHIP)
    app.end(a)
    G_DEV_ST = app.label(a, "", 0)
    jtheme.style_node(a, G_DEV_ST, jsetui.K_SET_HINT)
    applay.align_start(a, G_DEV_ST)
    app.end(a)
    app.end(a)
    app.end(a)
    jshell.set_shown(a, G_FID, false, 0)
    jshell.set_shown(a, G_DEV, false, 0)
    return G_ROOT
}
