// examples/jarvis_android/screen_leitstand.fi -- PLACEHOLDER for the "Leitstand (project command center)" tab (roadmap A5 fills it).
//
// Contract (see jshell.fi): screen_leitstand_build(a) runs once with this tab's column open, screen_leitstand_refresh(a) runs when
// the tab is shown and every 2 s while it stays visible. Data comes from lib/net/jarvisapi.fi (A1) over /api/m/* (A2).
import fui.app
import jshell

export { screen_leitstand_build, screen_leitstand_refresh }

static mut G_INFO: usize = 0

fn screen_leitstand_build(a: *mut app.App) {
    let t: usize = app.label(a, "Leitstand (project command center)", 16)
    G_INFO = app.label(a, "coming soon", 12)
}

fn screen_leitstand_refresh(a: *mut app.App) {
}
