// SPDX-License-Identifier: MPL-2.0
// examples/jarvis_android/screen_leitstand.fi -- the "Board" tab (project command center). Three modes on ONE virtual list:
//   Projects  every project with its roadmap stand (done / total, %), open needs; tap = details in the reader
//   Needs     open questions; tap = details + answer buttons (screen_needs.fi)
//   Workers   the orchestrator chat and the worker chats of /api/command-center; tap = the chat as Markdown (screen_workerchat.fi)
// Above the list: a one-line server summary (host, load, memory, disk) and the "stand" hint ("Live" / "Offline - as of 5 min ago").
// Pull-to-refresh on the list forces all requests; everything else refreshes at most every 15 s (jdata). Offline: the cache answers.
import std.rt
import std.vec
import fui.app
import fui.vlist
import fui.render
import fui.scene
import fui.widget
import fui.theme
import fui.style
import fui.painter
import jtheme
import net.jarvisapi
import jshell
import jdata
import jlist
import jtexts
import fui.applay
import fui.vlistview
import screen_zentrale
import screen_needs
import screen_workerchat

export { screen_leitstand_build, screen_leitstand_refresh, leitstand_set_page }

const MODE_PROJECTS: usize = 0
const MODE_NEEDS: usize = 1
const MODE_WORKERS: usize = 2
const MODE_CENTRE: usize = 3 // the web command centre (default)

static mut G_MODE: usize = 3
static mut G_B_CC: usize = 0
static mut G_LIST: usize = 0
static mut G_STAND: usize = 0
static mut G_SUM: usize = 0
static mut G_NEEDBOX: usize = 0
static mut G_EMPTY: usize = 0
static mut G_B_PROJ: usize = 0
static mut G_B_NEEDS: usize = 0
static mut G_B_WORK: usize = 0
static mut G_SEEN_PROJ: u64 = 0
static mut G_SEEN_NEEDS: u64 = 0
static mut G_SEEN_CENTER: u64 = 0
static mut G_SEEN_STAND: u64 = 0
static mut G_SEEN_MODE: usize = 99
static mut G_MD: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }

// the worker rows: row 0 = the orchestrator chat when there is one
fn worker_count() -> usize {
    if !jdata.has_center() { return 0 }
    var n: usize = vec_len[jarvisapi.WorkerRow](&(*jdata.center()).workers)
    if (*jdata.center()).orch_id.n > 0 { n = n + 1 }
    return n
}

fn worker_at(i: usize) -> *mut jarvisapi.WorkerRow {
    var k: usize = i
    if (*jdata.center()).orch_id.n > 0 { k = i - 1 }
    return vec_elem_ptr[jarvisapi.WorkerRow](&(*jdata.center()).workers, k)
}

fn project_count() -> usize {
    if !jdata.has_projects() { return 0 }
    return vec_len[jarvisapi.ProjectRow](&(*jdata.projects()).rows)
}

fn project_at(i: usize) -> *mut jarvisapi.ProjectRow {
    return vec_elem_ptr[jarvisapi.ProjectRow](&(*jdata.projects()).rows, i)
}

fn list_count() -> usize {
    if G_MODE == MODE_CENTRE { return screen_zentrale.z_count() }
    if G_MODE == MODE_PROJECTS { return project_count() }
    if G_MODE == MODE_NEEDS { return screen_needs.needs_count() }
    return worker_count()
}

fn rows(ud: u64, i: usize, out: *mut vlist.VRow) {
    if G_MODE == MODE_CENTRE { screen_zentrale.z_row(i, out); return }
    if G_MODE == MODE_PROJECTS {
        if i >= project_count() { return }
        let p: *mut jarvisapi.ProjectRow = project_at(i)
        // the web project card: name + accent percent, bar, "done/total done - open", next step, open questions
        jlist.put(out, (*p).name)
        var pct: str = jshell.dec((*p).pct) + "%"
        let dn: usize = pct.n
        var k: usize = 0
        while k < dn && k < 48 {
            (*out).detail[k] = *((pct.p as u64 + k as u64) as *mut u8)
            k = k + 1
        }
        (*out).dn = k
        (*out).bar = (*p).pct
        vlist.vrow_sub(out, jshell.dec((*p).done) + "/" + jshell.dec((*p).total) + " " + jtexts.t("bd.card-done") + " - " + jshell.dec((*p).open) + " " + jtexts.t("bd.d-open"))
        if (*p).next.n > 0 { vlist.vrow_sub2(out, jtexts.t("bd.card-where") + "  " + (*p).next) }
        if (*p).needs > 0 { vlist.vrow_sub3(out, jshell.dec((*p).needs) + " " + jtexts.t("bd.card-q")) }
    } else if G_MODE == MODE_NEEDS {
        screen_needs.needs_row(i, out)
    } else {
        if i >= worker_count() { return }
        if i == 0 && (*jdata.center()).orch_id.n > 0 {
            jlist.put(out, "# ")
            jlist.put(out, (*jdata.center()).orch_title)
            return
        }
        let w: *mut jarvisapi.WorkerRow = worker_at(i)
        if (*w).running { jlist.put(out, "> ") } else { jlist.put(out, "  ") }
        jlist.put(out, (*w).title)
    }
}

fn put(s: str) { rt.buf_push_bytes(&G_MD, s.p as u64, s.n) }

fn project_detail(i: usize) {
    rt.buf_clear(&G_MD)
    if i >= project_count() { put(jtexts.t("bd.pick-project")) }
    else {
        let p: *mut jarvisapi.ProjectRow = project_at(i)
        put("## ")
        put((*p).name)
        put("\n\n**" + jtexts.t("bd.d-status") + ":** ")
        put((*p).status)
        put("  \n**" + jtexts.t("bd.d-roadmap") + ":** ")
        put(jshell.dec((*p).done))
        put(" / ")
        put(jshell.dec((*p).total))
        put(" (")
        put(jshell.dec((*p).pct))
        put("%), " + jtexts.t("bd.d-open") + " ")
        put(jshell.dec((*p).open))
        put("  \n**" + jtexts.t("bd.d-needs") + ":** ")
        put(jshell.dec((*p).needs))
        if (*p).goal.n > 0 {
            put("\n\n**" + jtexts.t("bd.d-goal") + ":** ")
            put((*p).goal)
        }
        if (*p).next.n > 0 {
            put("\n\n**" + jtexts.t("bd.d-next") + ":** ")
            put((*p).next)
        }
        if (*p).updated.n > 0 {
            put("\n\n_" + jtexts.t("bd.d-updated") + " ")
            put((*p).updated)
            put("_")
        }
    }
    screen_workerchat.wc_show_text(str { p: G_MD.ptr as *mut u8, n: G_MD.len })
}

fn picked(a: *mut app.App, id: usize, row: usize) {
    if G_MODE == MODE_CENTRE {
        if screen_zentrale.z_is_head(row) { force_all() }
        return
    }
    if G_MODE == MODE_PROJECTS {
        if row < project_count() { G_BAR_PCT = (*project_at(row)).pct; G_BAR_PICKED = true }
        project_detail(row)
    } else if G_MODE == MODE_NEEDS {
        screen_needs.needs_select(a, row)
    } else if row < worker_count() {
        if row == 0 && (*jdata.center()).orch_id.n > 0 {
            screen_workerchat.wc_show_chat((*jdata.center()).orch_id, (*jdata.center()).orch_title)
        } else {
            let w: *mut jarvisapi.WorkerRow = worker_at(row)
            screen_workerchat.wc_show_chat((*w).id, (*w).title)
        }
    }
}

// the "Braucht dich" box: shown in the projects mode while questions are open (title + up to two of them)
fn needbox_sync(a: *mut app.App) {
    let n: usize = screen_needs.needs_count()
    let show: bool = G_MODE == MODE_PROJECTS && n > 0
    jshell.set_shown(a, G_NEEDBOX, show, 0)
    if !show { return }
    var t: str = jtexts.t("bd.needbox") + " (" + jshell.dec(n as i64) + ")"
    var k: usize = 0
    while k < n && k < 2 {
        t = t + "\n" + jdata.need_str(k, 1) + ": " + jdata.need_str(k, 3)
        k = k + 1
    }
    app.set_text(a, G_NEEDBOX, t)
}

// the page column of this tab (main.fi): a hidden node still takes its flex gap there, so the centre mode (4 hidden helper nodes
// above the list) runs the page with gap 0 and spaces the visible rows with margins
static mut G_PAGE: usize = 0
static mut G_STANDROW: usize = 0
static mut G_CHIPROW: usize = 0
fn leitstand_set_page(n: usize) { G_PAGE = n }

fn page_gap(a: *mut app.App) {
    let sc: *mut scene.Scene = app.app_scene(a)
    if G_MODE == MODE_CENTRE {
        scene.node_set_gap(sc, G_PAGE, 0, 0)
        scene.node_set_margin(sc, G_STANDROW, 0, 8, 0, 0)
        scene.node_set_margin(sc, G_LIST, 0, 8, 0, 0)
    } else {
        scene.node_set_gap(sc, G_PAGE, 8, 8)
        scene.node_set_margin(sc, G_STANDROW, 0, 0, 0, 0)
        scene.node_set_margin(sc, G_LIST, 0, 0, 0, 0)
    }
}

fn redraw(a: *mut app.App) {
    if G_MODE == MODE_CENTRE { screen_zentrale.z_build() }
    app.vlist_set_count(a, G_LIST, list_count())
    app.vlist_changed(a, G_LIST)
    let any: bool = list_count() > 0
    var loaded: bool = jdata.has_projects()
    if G_MODE == MODE_WORKERS || G_MODE == MODE_CENTRE { loaded = jdata.has_center() }
    jshell.set_shown_list(a, G_LIST, any)
    if G_MODE == MODE_CENTRE { scene.node_set_flexitem(app.app_scene(a), G_LIST, 1000, 1000, 60, 0) }
    screen_workerchat.wc_set_shown(a, G_MODE != MODE_CENTRE)
    jshell.set_shown(a, G_SUM, G_MODE != MODE_CENTRE, 0)
    jshell.set_shown(a, G_EMPTY, !any && loaded, 0)
    if G_MODE == MODE_PROJECTS { app.set_text(a, G_EMPTY, jtexts.t("bd.empty-projects")) }
    else if G_MODE == MODE_NEEDS { app.set_text(a, G_EMPTY, jtexts.t("bd.empty-needs")) }
    else if G_MODE == MODE_CENTRE { app.set_text(a, G_EMPTY, jtexts.t("bd.empty-centre")) }
    else { app.set_text(a, G_EMPTY, jtexts.t("bd.empty-workers")) }
    needbox_sync(a)
    let sc: *mut scene.Scene = app.app_scene(a)
    page_gap(a)
    let rc: bool = scene.node_remove_class(sc, G_LIST, jtheme.K_CARD)
    let rp: bool = scene.node_remove_class(sc, G_LIST, jtheme.K_PLAIN)
    if G_MODE != MODE_PROJECTS && G_MODE != MODE_CENTRE { let ac: bool = scene.node_add_class(sc, G_LIST, jtheme.K_CARD) }
    else { let ap: bool = scene.node_add_class(sc, G_LIST, jtheme.K_PLAIN) }
    // the web mobile centre has no scrollbar strip: both page edges of the cards are equal (default strip 12 pt)
    if G_MODE == MODE_CENTRE { app.vlist_set_bar_pt(a, G_LIST, 0) } else { app.vlist_set_bar_pt(a, G_LIST, 12) }
    if G_MODE == MODE_CENTRE {
        app.vlist_set_row_pt(a, G_LIST, screen_zentrale.ST_PT)
        jlist.fit_pt(a, G_LIST, list_count(), 1, 80, screen_zentrale.ST_PT)
    } else if G_MODE == MODE_PROJECTS {
        app.vlist_set_row_pt(a, G_LIST, jlist.CARD_PT)
        jlist.fit_pt(a, G_LIST, list_count(), 1, 4, jlist.CARD_PT)
    } else {
        app.vlist_set_row_pt(a, G_LIST, jlist.ROW_PT)
        jlist.fit(a, G_LIST, list_count(), 1, 5)
    }
}

fn set_chip_on(a: *mut app.App, n: usize, on: bool) {
    let sc: *mut scene.Scene = app.app_scene(a)
    let r: bool = scene.node_remove_class(sc, n, jtheme.K_CHIP_ON)
    if on { let q: bool = scene.node_add_class(sc, n, jtheme.K_CHIP_ON) }
}

// roadmap bar (.bar): 6 pt track in the field colour, accent fill, share of the first project (or the picked one)
static mut G_BAR: usize = 0
static mut G_BAR_PCT: i64 = 0
static mut G_BAR_PICKED: bool = false
fn draw_bar(ud: u64, c: *mut render.Ctx, e: *mut widget.Widget) {
    let x: f64 = widget.w_x(e)
    let w: f64 = widget.w_w(e)
    let h: f64 = render.len_of(c, 6)
    let y: f64 = widget.w_y(e) + (widget.w_h(e) - h) * 0.5
    let f: *mut theme.Colors = theme.theme_colors(render.ctx_theme(c))
    painter.round_rect(render.ctx_painter(c), x, y, w, h, h * 0.5, (*f).field)
    var p: i64 = G_BAR_PCT
    if p > 100 { p = 100 }
    if p > 0 {
        painter.round_rect(render.ctx_painter(c), x, y, w * (p as f64) / 100.0, h, h * 0.5, (*f).accent)
    }
}

fn mode_texts(a: *mut app.App) {
    set_chip_on(a, G_B_CC, G_MODE == MODE_CENTRE)
    app.set_text(a, G_B_CC, jtexts.t("bd.centre"))
    set_chip_on(a, G_B_PROJ, G_MODE == MODE_PROJECTS)
    set_chip_on(a, G_B_NEEDS, G_MODE == MODE_NEEDS)
    set_chip_on(a, G_B_WORK, G_MODE == MODE_WORKERS)
    app.set_text(a, G_B_PROJ, jtexts.t("bd.projects") + " (" + jshell.dec(project_count() as i64) + ")")
    app.set_text(a, G_B_NEEDS, jtexts.t("bd.needs") + " (" + jshell.dec(screen_needs.needs_count() as i64) + ")")
    app.set_text(a, G_B_WORK, jtexts.t("bd.workers") + " (" + jshell.dec(worker_count() as i64) + ")")
}

fn set_mode(a: *mut app.App, m: usize) {
    G_MODE = m
    G_SEEN_MODE = m
    screen_needs.needs_show(a, m == MODE_NEEDS)
    if m == MODE_CENTRE { screen_workerchat.wc_show_text("") }
    else if m == MODE_PROJECTS { screen_workerchat.wc_show_text(jtexts.t("bd.pick-project")) }
    else if m == MODE_NEEDS { screen_workerchat.wc_show_text(jtexts.t("bd.pick-need")) }
    else { screen_workerchat.wc_show_text(jtexts.t("bd.pick-worker")) }
    redraw(a)
    mode_texts(a)
    screen_leitstand_refresh(a)
}

fn on_centre(a: *mut app.App) { set_mode(a, MODE_CENTRE) }
fn on_projects(a: *mut app.App) { set_mode(a, MODE_PROJECTS) }
fn on_needs(a: *mut app.App) { set_mode(a, MODE_NEEDS) }
fn on_workers(a: *mut app.App) { set_mode(a, MODE_WORKERS) }

fn force_all() {
    jdata.refresh_center(true)
    jdata.refresh_projects(true)
    screen_workerchat.wc_force()
    jdata.set_note(jtexts.t("ls.refreshing"))
}

fn on_pull(a: *mut app.App) { force_all() }
fn on_reload(a: *mut app.App) { force_all() }

fn screen_leitstand_build(a: *mut app.App) {
    // like the web board: the mode chips at the left, one dim hint line, the server summary, the bar, the card list, the reader
    applay.hrow(a)
    G_B_CC = app.button(a, jtexts.t("bd.centre"), on_centre)
    jtheme.style_node(a, G_B_CC, jtheme.K_CHIP)
    G_B_PROJ = app.button(a, jtexts.t("bd.projects"), on_projects)
    G_B_NEEDS = app.button(a, jtexts.t("bd.needs"), on_needs)
    G_B_WORK = app.button(a, jtexts.t("bd.workers"), on_workers)
    jtheme.style_node(a, G_B_PROJ, jtheme.K_CHIP)
    jtheme.style_node(a, G_B_NEEDS, jtheme.K_CHIP)
    jtheme.style_node(a, G_B_WORK, jtheme.K_CHIP)
    app.end(a)
    G_STANDROW = applay.hline(a)
    G_STAND = app.label(a, jtexts.t("ls.loading"), 11)
    jtheme.style_node(a, G_STAND, jtheme.K_DIM)
    app.set_text_align(a, G_STAND, style.ALIGN_LEFT) // a64: the hint stood centred in its grown box = a big gap at the left edge
    applay.grow(a, G_STAND, 1)
    jtheme.style_node(a, app.button(a, jtexts.t("ls.reload"), on_reload), jtheme.K_CHIP)
    app.end(a)
    G_SUM = app.label(a, "", 11)
    jtheme.style_node(a, G_SUM, jtheme.K_DIM)
    applay.align_start(a, G_SUM)
    G_BAR = app.custom(a, widget.KIND_TILE, 340, 1)
    applay.stretch(a, G_BAR)
    scene.node_set_draw(app.app_scene(a), G_BAR, 0, draw_bar)
    jshell.set_shown(a, G_BAR, false, 0)
    // the web "Braucht dich" box above the project cards: the first open questions, a tap opens the Needs list
    G_NEEDBOX = app.label(a, "", 0)
    jtheme.style_node(a, G_NEEDBOX, jtheme.K_NEEDBOX)
    app.set_text_align(a, G_NEEDBOX, style.ALIGN_LEFT)
    applay.stretch(a, G_NEEDBOX)
    app.node_set_click(a, G_NEEDBOX, on_needs)
    jshell.set_shown(a, G_NEEDBOX, false, 0)
    G_EMPTY = app.label(a, jtexts.t("bd.empty-projects"), 0)
    applay.align_start(a, G_EMPTY)
    jtheme.style_node(a, G_EMPTY, jtheme.K_EMPTY)
    jshell.set_shown(a, G_EMPTY, false, 0)
    vlistview.vv_set_custom_row(screen_zentrale.z_hook)
    G_LIST = app.vlist_new(a, "Board", 340, 120, 0, rows, 0)
    jtheme.style_node(a, G_LIST, jtheme.K_CARD)
    applay.stretch(a, G_LIST)
    app.vlist_set_row_pt(a, G_LIST, jlist.ROW_PT)
    jlist.fit(a, G_LIST, 0, 1, 5)
    jlist.flex_list(a, G_LIST, 60)
    app.vlist_on_pick(a, G_LIST, picked)
    jlist.pull_add(G_LIST, on_pull)
    jlist.pull_install(a)
    screen_needs.needs_build(a)
    screen_workerchat.wc_build(a)
    screen_workerchat.wc_show_text("")
    screen_workerchat.wc_set_shown(a, false)
}

fn summary() -> str {
    if !jdata.has_center() { return "" }
    let c: *mut jarvisapi.Center = jdata.center()
    var s: str = (*c).host + "  " + jtexts.t("bd.sum-load") + " " + jshell.dec(((*c).load1 * 10.0) as i64 / 10)
    if (*c).load1 < 10.0 { s = s + "." + jshell.dec(((*c).load1 * 10.0) as i64 % 10) }
    if (*c).mem_total > 0 { s = s + "  RAM " + jshell.dec((*c).mem_free * 100 / (*c).mem_total) + "%" }
    if (*c).disk_total > 0 { s = s + "  Disk " + jshell.dec((*c).disk_free * 100 / (*c).disk_total) + "% " + jtexts.t("bd.sum-free") }
    return s
}

fn stand_slot() -> usize {
    if G_MODE == MODE_WORKERS || G_MODE == MODE_CENTRE { return jdata.K_CENTER }
    if G_MODE == MODE_NEEDS { return jdata.K_NEED }
    return jdata.K_PROJECTS
}

fn screen_leitstand_refresh(a: *mut app.App) {
    if G_MODE != MODE_PROJECTS { G_BAR_PCT = 0; G_BAR_PICKED = false }
    else if !G_BAR_PICKED && project_count() > 0 { G_BAR_PCT = (*project_at(0)).pct }
    jdata.refresh_projects(false)
    jdata.refresh_center(false)
    screen_workerchat.wc_refresh()
    var changed: bool = false
    if jdata.ver_projects() != G_SEEN_PROJ { G_SEEN_PROJ = jdata.ver_projects(); changed = true }
    if jdata.ver_needs() != G_SEEN_NEEDS {
        G_SEEN_NEEDS = jdata.ver_needs()
        changed = true
        screen_needs.needs_sync(a)
    }
    if jdata.ver_center() != G_SEEN_CENTER {
        G_SEEN_CENTER = jdata.ver_center()
        changed = true
        app.set_text(a, G_SUM, summary())
    }
    if changed {
        redraw(a)
        mode_texts(a)
    }
    if jdata.ver_stand() != G_SEEN_STAND || changed {
        G_SEEN_STAND = jdata.ver_stand()
        var s: str = jdata.stand_text(stand_slot())
        if jdata.status_note().n > 0 { s = s + "  -  " + jdata.status_note() }
        app.set_text(a, G_STAND, s)
    }
}

