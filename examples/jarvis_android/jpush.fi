// SPDX-License-Identifier: MPL-2.0
// examples/jarvis_android/jpush.fi -- push notifications of the JARVIS app, ONLY over HTTPS on port 443 (no TCP relay, no clear
// text token): the phone asks the server in a LONG POLL (GET /api/m/push/poll?since=N&wait=25, docs/ANDROID-APP-API.md section 2)
// with its session cookie over TLS, and shows ONE notification per event (plat.pushio). A foreground service without a relay
// connection (pio_keep) keeps the process alive while the window is away, so the poll goes on in the background.
//
// setup() runs once per start after the chat connection is open: POST /api/m/push/register (an older server answers 404 -> no push,
// state PS_NONE). The push token of that answer is NOT used: the TCP relay (port 7781, hello line with the token in clear text) is
// never started. tick() (1 s) keeps ONE poll open; an error retries after RETRY_MS. The last event id is kept in the settings
// ("push.since") so a restart shows what came in meanwhile (the server keeps 12 h); the very first start only learns the id.
import std.rt
import std.time
import std.vec
import net.jarvisapi
import plat.pushio
import appkit.log
import window.window
import jshell

export { pending_take, tap_open, launch_take, last_source, settle, setup, on_api, stop, state, state_text, tick, polling, events_seen, PS_IDLE, PS_ASKED, PS_ON, PS_NONE, PS_TLS, PS_FAILED }

const PS_IDLE: i64 = 0
const PS_ASKED: i64 = 1
const PS_ON: i64 = 2
const PS_NONE: i64 = 3 // the server has no push registration (older version)
const PS_TLS: i64 = 4 // kept for the settings screen; the relay is not used any more
const PS_FAILED: i64 = 5

const WAIT_S: i64 = 25
const POLL_TIMEOUT_MS: i64 = 70000
const RETRY_MS: i64 = 5000

static mut G_STATE: i64 = 0
static mut G_POLL: u64 = 0 // the Api of the long poll (it is open almost all the time, so it has its own)
static mut G_INFLIGHT: bool = false
static mut G_RETRY_AT: i64 = 0
static mut G_SINCE: i64 = 0
static mut G_LEARN: bool = false // no stored id yet: the first answer only sets the id
static mut G_SEEN: i64 = 0 // events turned into notifications (for the end-to-end check and the settings page)

// WHICH CHAT A TAP MEANS. Three ways, the first that answers wins:
//   1. the intent: every notification of an event with a chat id is posted KEYED (pushio.pio_notify_cid) and carries the chat id as an
//      intent extra; a start by a tap on it reads it (pushio.pio_launch_cid, launch_take);
//   2. the status bar: the chat ids of the keyed notifications are kept in SLOTS (slot = key); when the window comes back, the slot
//      whose notification is GONE (auto-cancel on tap) is the tapped one -- the newest such slot (settle() frees the slots of
//      notifications that went away while the window was on screen, so a swiped one is not mistaken for a tap);
//   3. the guess: the chat of the newest event that came in while the window was not on screen (at most PENDING_MS old).
// A tap while the app is OPEN starts nothing (plain NativeActivity, no onNewIntent): the keyed notification is simply GONE. A swipe is told
// to the service by the notification's deleteIntent (pushio.pio_dismissed); a slot that is gone for GONE_GRACE_MS WITHOUT that mark was
// tapped (tap_open) -- the app is in front already, only the chat has to switch.
const PENDING_MS: i64 = 900000
const PENDING_CAP: usize = 96
const SLOTS: usize = 8
static mut G_PEND: [u8; 96] = [0; 96]
static mut G_PEND_N: usize = 0
static mut G_PEND_AT: i64 = 0
static mut G_SRC: i64 = 0 // where the last chat id came from: 1 intent extra, 2 status bar (the notification that is gone), 3 guess
static mut G_SLOT_CID: [u8; 768] = [0; 768] // SLOTS x PENDING_CAP
static mut G_SLOT_N: [usize; 8] = [0; 8]
static mut G_SLOT_AT: [i64; 8] = [0; 8]
static mut G_SLOT_GONE: [i64; 8] = [0; 8] // when the notification of the slot was first seen gone (0 = it is shown)
const GONE_GRACE_MS: i64 = 1200 // the swipe mark of the system reaches the service within this time

fn pending_set(cid: str) {
    if cid.n == 0 || cid.n > PENDING_CAP { return }
    var i: usize = 0
    while i < cid.n {
        G_PEND[i] = *((cid.p as u64 + i as u64) as *mut u8)
        i = i + 1
    }
    G_PEND_N = cid.n
    G_PEND_AT = time.now_unix_ms()
}

fn slot_cid(i: usize) -> str {
    return __str_copy(str { p: (&G_SLOT_CID[i * PENDING_CAP]) as u64 as *mut u8, n: G_SLOT_N[i] })
}

// the slot (= notification key) of a chat: the one it has, else a free one, else the oldest
fn slot_of(cid: str) -> usize {
    var free: usize = SLOTS
    var oldest: usize = 0
    var i: usize = 0
    while i < SLOTS {
        if G_SLOT_N[i] == cid.n && cid.n > 0 && slot_cid(i) == cid { return i }
        if G_SLOT_N[i] == 0 && free == SLOTS { free = i }
        if G_SLOT_AT[i] < G_SLOT_AT[oldest] { oldest = i }
        i = i + 1
    }
    if free != SLOTS { return free }
    return oldest
}

fn slot_put(i: usize, cid: str) {
    var k: usize = 0
    while k < cid.n {
        G_SLOT_CID[i * PENDING_CAP + k] = *((cid.p as u64 + k as u64) as *mut u8)
        k = k + 1
    }
    G_SLOT_N[i] = cid.n
    G_SLOT_AT[i] = time.now_unix_ms()
}

// 0 = free slot (or its notification was swiped away / cancelled: freed here), 1 = the notification is in the status bar (or unknown),
// 2 = it is gone WITHOUT a swipe mark = tapped (or taken away by the group summary)
fn slot_state(i: usize, now: i64) -> i64 {
    if G_SLOT_N[i] == 0 { return 0 }
    let shown: i32 = pushio.pio_shown(i as u64)
    if shown != 0 {
        G_SLOT_GONE[i] = 0
        return 1
    }
    if pushio.pio_dismissed(i as u64) == 1 {
        log.log_info("push", "slot " + jshell.dec(i as i64) + " swiped away")
        G_SLOT_N[i] = 0
        G_SLOT_GONE[i] = 0
        return 0
    }
    if G_SLOT_GONE[i] == 0 {
        G_SLOT_GONE[i] = now
        log.log_info("push", "slot " + jshell.dec(i as i64) + " gone (no swipe mark) cid " + slot_cid(i))
    }
    return 2
}

// 1 s tick while the window is on screen: frees the slots of swiped notifications
fn settle() {
    let now: i64 = time.now_unix_ms()
    var i: usize = 0
    while i < SLOTS {
        let st: i64 = slot_state(i, now)
        i = i + 1
    }
}

// 1 s tick while the window is in front: the chat of a notification that was TAPPED (gone for GONE_GRACE_MS without a swipe mark),
// "" = none. The newest such slot wins; every gone slot is freed (a tap on the group summary takes the messages with it).
fn tap_open() -> str {
    let now: i64 = time.now_unix_ms()
    var best: usize = SLOTS
    var i: usize = 0
    while i < SLOTS {
        if slot_state(i, now) == 2 && now - G_SLOT_GONE[i] >= GONE_GRACE_MS && now - G_SLOT_AT[i] <= PENDING_MS {
            if best == SLOTS || G_SLOT_AT[i] > G_SLOT_AT[best] { best = i }
        }
        i = i + 1
    }
    if best == SLOTS { return "" }
    let cid: str = slot_cid(best)
    i = 0
    while i < SLOTS {
        if G_SLOT_N[i] > 0 && G_SLOT_GONE[i] > 0 && now - G_SLOT_GONE[i] >= GONE_GRACE_MS { G_SLOT_N[i] = 0; G_SLOT_GONE[i] = 0 }
        i = i + 1
    }
    G_PEND_N = 0
    G_SRC = 2
    return cid
}

// a tap on the notification of chat `cid` was handled (by any way): its slot must not be found AGAIN as a "tapped" slot later
// (a gone slot whose tap came through the intent was taken for a second tap when the window came back after the next notification)
fn slot_free_cid(cid: str) {
    if cid.n == 0 { return }
    var i: usize = 0
    while i < SLOTS {
        if G_SLOT_N[i] == cid.n && slot_cid(i) == cid && pushio.pio_shown(i as u64) == 0 {
            G_SLOT_N[i] = 0
            G_SLOT_GONE[i] = 0
        }
        i = i + 1
    }
}

// the chat id of a start by a tap ("" = none; once)
fn launch_take() -> str {
    let c: str = pushio.pio_launch_cid()
    if c.n > 0 {
        G_SRC = 1
        slot_free_cid(c)
        G_PEND_N = 0
    }
    return c
}

fn last_source() -> str {
    if G_SRC == 1 { return "intent" }
    if G_SRC == 2 { return "status bar" }
    return "guess"
}

// "" when no chat is meant; taking clears it. Called when the window came back to the front.
fn pending_take() -> str {
    let now: i64 = time.now_unix_ms()
    var from_intent: str = pushio.pio_launch_cid()
    var best: usize = SLOTS
    var i: usize = 0
    while i < SLOTS {
        if now - G_SLOT_AT[i] <= PENDING_MS && slot_state(i, now) == 2 {
            if best == SLOTS || G_SLOT_AT[i] > G_SLOT_AT[best] { best = i }
        }
        i = i + 1
    }
    var tapped: str = ""
    if best != SLOTS { tapped = slot_cid(best) }
    // every slot whose notification is gone is free again
    i = 0
    while i < SLOTS {
        if G_SLOT_N[i] > 0 && G_SLOT_GONE[i] > 0 { G_SLOT_N[i] = 0; G_SLOT_GONE[i] = 0 }
        i = i + 1
    }
    if from_intent.n > 0 {
        G_PEND_N = 0
        G_SRC = 1
        return from_intent
    }
    if tapped.n > 0 {
        G_PEND_N = 0
        G_SRC = 2
        return tapped
    }
    G_SRC = 3
    if G_PEND_N == 0 { return "" }
    let n: usize = G_PEND_N
    G_PEND_N = 0
    if now - G_PEND_AT > PENDING_MS { return "" }
    return __str_copy(str { p: (&G_PEND[0]) as u64 as *mut u8, n: n })
}

fn state() -> i64 { return G_STATE }
fn polling() -> bool { return G_STATE == PS_ON }
fn events_seen() -> i64 { return G_SEEN }

fn state_text() -> str {
    if G_STATE == PS_IDLE { return "push: not started" }
    if G_STATE == PS_ASKED { return "push: registering ..." }
    if G_STATE == PS_ON { return "push: on (HTTPS 443, " + jshell.dec(G_SEEN) + " seen)" }
    if G_STATE == PS_NONE { return "push: the server has no push route yet" }
    if G_STATE == PS_TLS { return "push: relay not used (HTTPS only)" }
    return "push: failed"
}

fn parse_dec(s: str) -> i64 {
    var v: i64 = 0
    var i: usize = 0
    while i < s.n {
        let c: u8 = *((s.p as u64 + i as u64) as *mut u8)
        if c < 48 as u8 || c > 57 as u8 { return 0 }
        v = v * 10 + (c as i64 - 48)
        i = i + 1
    }
    return v
}

// once per start (and again after sign-out / sign-in)
fn setup() {
    // not before the person saw the short note about the notification question (main.fi, jshell.push_allowed)
    if G_STATE != PS_IDLE || !pushio.pio_available() || !jshell.push_allowed() { return }
    if jarvisapi.ja_push_register(jshell.api(), "android-app", "android") {
        G_STATE = PS_ASKED
    }
}

fn stop() {
    pushio.pio_stop()
    G_STATE = PS_IDLE
    G_SINCE = 0
}

fn poll_api() -> *mut jarvisapi.Api {
    if G_POLL == 0 {
        let x: *mut jarvisapi.Api = jarvisapi.ja_new(jshell.loop_of(), on_poll, 0)
        jarvisapi.ja_set_timeout(x, POLL_TIMEOUT_MS)
        G_POLL = x as u64
    }
    return G_POLL as *mut jarvisapi.Api
}

fn ask() {
    if G_STATE != PS_ON || G_INFLIGHT { return }
    let x: *mut jarvisapi.Api = poll_api()
    jarvisapi.ja_use_jc(x, jshell.jc()) // token and base can change with a new sign-in
    var wait: i64 = WAIT_S
    if G_LEARN { wait = 0 }
    if jarvisapi.ja_push_poll(x, G_SINCE, wait) {
        G_INFLIGHT = true
    } else {
        G_RETRY_AT = time.now_unix_ms() + RETRY_MS
    }
}

// 1 s, from main.fi: keeps exactly one poll open
fn tick() {
    if G_STATE != PS_ON || G_INFLIGHT { return }
    if time.now_unix_ms() < G_RETRY_AT { return }
    ask()
}

fn show(e: *mut jarvisapi.PushEvent) {
    var title: str = (*e).title
    if title.n == 0 { title = "JARVIS" }
    var posted: bool = false
    let cid: str = (*e).cid
    if cid.n > 0 && cid.n <= PENDING_CAP {
        let k: usize = slot_of(cid)
        posted = pushio.pio_notify_cid(k as u64, title, (*e).body, cid)
        if posted {
            let stale: i32 = pushio.pio_dismissed(k as u64) // a swipe mark of the notification this one replaced must not count for the new one
            slot_put(k, cid)
            G_SLOT_GONE[k] = 0
        }
    } else {
        posted = pushio.pio_notify(title, (*e).body)
    }
    if posted {
        G_SEEN = G_SEEN + 1
        if jshell.win() as u64 != 0 && !window.in_front(jshell.win()) {
            // an event without a chat id is the newest one: a tap on it must not open an older event's chat (the guess)
            if cid.n == 0 { G_PEND_N = 0 } else { pending_set(cid) }
        }
    }
}

// the answer of the long poll
fn on_poll(x: *mut jarvisapi.Api, ud: u64, kind: u32, status: i64) {
    G_INFLIGHT = false
    if kind != jarvisapi.AK_PUSH_POLL { return }
    if G_STATE != PS_ON { return }
    if status != 200 {
        // 401: the session is dead (the chat connection shows the sign-in page); anything else: the net is down
        G_RETRY_AT = time.now_unix_ms() + RETRY_MS
        return
    }
    var ev: jarvisapi.PushEvents = jarvisapi.pushevents_new()
    if !jarvisapi.parse_push_events(jarvisapi.ja_body_ptr(x), jarvisapi.ja_body_len(x), &ev) {
        jarvisapi.pushevents_free(&ev)
        G_RETRY_AT = time.now_unix_ms() + RETRY_MS
        return
    }
    let n: usize = vec_len[jarvisapi.PushEvent](&ev.rows)
    var i: usize = 0
    while i < n {
        let e: *mut jarvisapi.PushEvent = vec_elem_ptr[jarvisapi.PushEvent](&ev.rows, i)
        if !G_LEARN && (*e).id > G_SINCE { show(e) }
        i = i + 1
    }
    var last: i64 = ev.last
    if n > 0 {
        let l: *mut jarvisapi.PushEvent = vec_elem_ptr[jarvisapi.PushEvent](&ev.rows, n - 1)
        if (*l).id > last { last = (*l).id }
    }
    jarvisapi.pushevents_free(&ev)
    G_LEARN = false
    if last != G_SINCE {
        G_SINCE = last
        jshell.cfg_set("push.since", jshell.dec(last))
        jshell.settings_save()
    }
    // a quiet poll (nothing new) went through the whole wait: ask again at once; a fast answer must not spin
    G_RETRY_AT = time.now_unix_ms() + 200
}

// the answer of ja_push_register (AK_PUSH_REG)
fn on_api(x: *mut jarvisapi.Api, status: i64) {
    if G_STATE != PS_ASKED { return }
    if status == 404 { G_STATE = PS_NONE; return }
    if status != 200 { G_STATE = PS_FAILED; return }
    // a service without a relay connection keeps the process; the poll itself is tick() above
    if !pushio.pio_keep() {
        G_STATE = PS_FAILED
        return
    }
    G_SINCE = parse_dec(jshell.cfg_get("push.since", ""))
    G_LEARN = G_SINCE == 0
    G_RETRY_AT = 0
    G_STATE = PS_ON
    log.log_info("push", "long poll over HTTPS started, since " + jshell.dec(G_SINCE))
    ask()
}
