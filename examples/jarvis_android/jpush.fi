// SPDX-License-Identifier: MPL-2.0
// examples/jarvis_android/jpush.fi -- push notifications of the JARVIS app: register this phone at the server
// (POST /api/m/push/register, docs/ANDROID-APP-API.md section 2) and start the relay connection (plat.pushio: foreground service,
// own TCP relay, no Firebase) with the hello line "HELLO <pushToken> 1".
//
// setup() runs once per start after the chat connection is open; the answer arrives in on_api (called from screen_chat_api).
// An older server answers 404 -> no push (state PS_NONE, said in the status line). A relay with TLS needs a key pin that
// plat.pushio does not take yet -> not started (state PS_TLS). The Android notification permission is asked by the first start.
import std.rt
import net.jarvisapi
import plat.pushio
import appkit.log
import jshell

export { setup, on_api, stop, state, state_text, PS_IDLE, PS_ASKED, PS_ON, PS_NONE, PS_TLS, PS_FAILED }

const PS_IDLE: i64 = 0
const PS_ASKED: i64 = 1
const PS_ON: i64 = 2
const PS_NONE: i64 = 3 // the server has no push registration (older version)
const PS_TLS: i64 = 4
const PS_FAILED: i64 = 5

static mut G_STATE: i64 = 0

fn state() -> i64 { return G_STATE }

fn state_text() -> str {
    if G_STATE == PS_IDLE { return "push: not started" }
    if G_STATE == PS_ASKED { return "push: registering ..." }
    if G_STATE == PS_ON { return "push: on" }
    if G_STATE == PS_NONE { return "push: the server has no push route yet" }
    if G_STATE == PS_TLS { return "push: relay wants TLS (not supported yet)" }
    return "push: failed"
}

// once per start (and again after sign-out / sign-in)
fn setup() {
    if G_STATE != PS_IDLE || !pushio.pio_available() { return }
    if jarvisapi.ja_push_register(jshell.api(), "android-app", "android") {
        G_STATE = PS_ASKED
    }
}

fn stop() {
    pushio.pio_stop()
    G_STATE = PS_IDLE
}

// the answer of ja_push_register (AK_PUSH_REG)
fn on_api(x: *mut jarvisapi.Api, status: i64) {
    if G_STATE != PS_ASKED { return }
    if status == 404 { G_STATE = PS_NONE; return }
    if status != 200 { G_STATE = PS_FAILED; return }
    var r: jarvisapi.PushReg = jarvisapi.pushreg_new()
    if !jarvisapi.parse_push_register(jarvisapi.ja_body_ptr(x), jarvisapi.ja_body_len(x), &r) {
        jarvisapi.pushreg_free(&r)
        G_STATE = PS_FAILED
        return
    }
    if r.tls {
        G_STATE = PS_TLS
    } else if r.hello && pushio.pio_start(r.host, r.port, "HELLO " + r.token + " 1") {
        G_STATE = PS_ON
        log.log_info("push", "relay " + r.host + ":" + jshell.dec(r.port) + " started")
    } else {
        G_STATE = PS_FAILED
    }
    jarvisapi.pushreg_free(&r)
}
