// SPDX-License-Identifier: MPL-2.0
// examples/jarvis_android/jmeta.fi -- the two small server facts of the chat screen: the usage strip (GET /api/m/usage, p5 / p7)
// and the model pill (GET /api/m/models, current label + effort). Asked every minute while signed in; an older server
// (404 / 503) leaves "-" and the placeholder, nothing else changes.
import std.time
import net.jarvisapi
import std.rt
import fui.app
import screen_chat
import jshell

export { jmeta_tick, jmeta_api, jmeta_reset }

const EVERY_MS: i64 = 60000

static mut G_NEXT_MS: i64 = 0
static mut G_FLIGHT: i64 = 0

fn jmeta_reset() {
    G_NEXT_MS = 0
}

fn jmeta_tick(signed_in: bool) {
    if !signed_in || G_FLIGHT > 0 { return }
    let now: i64 = time.now_unix_ms()
    if now < G_NEXT_MS { return }
    G_NEXT_MS = now + EVERY_MS
    if jarvisapi.ja_get_abs(jshell.api(), jarvisapi.AK_USAGE, "/api/m/usage", "") { G_FLIGHT = G_FLIGHT + 1 }
    if jarvisapi.ja_get_abs(jshell.api(), jarvisapi.AK_MODELS, "/api/m/models", "") { G_FLIGHT = G_FLIGHT + 1 }
}

// true = ours
fn jmeta_api(x: *mut jarvisapi.Api, kind: u32, status: i64) -> bool {
    if kind == jarvisapi.AK_USAGE {
        if G_FLIGHT > 0 { G_FLIGHT = G_FLIGHT - 1 }
        if status == 200 {
            var p5: i64 = -1
            var p7: i64 = -1
            if jarvisapi.parse_usage(jarvisapi.ja_body_ptr(x), jarvisapi.ja_body_len(x), &p5, &p7) {
                var nm: rt.Buf = rt.buf_new()
                var r5: rt.Buf = rt.buf_new()
                var r7: rt.Buf = rt.buf_new()
                let info: bool = jarvisapi.parse_usage_info(jarvisapi.ja_body_ptr(x), jarvisapi.ja_body_len(x), &nm, &r5, &r7)
                screen_chat.screen_chat_set_usage_info(jshell.app_ui(), str { p: nm.ptr as *mut u8, n: nm.len }, str { p: r5.ptr as *mut u8, n: r5.len }, str { p: r7.ptr as *mut u8, n: r7.len })
                rt.buf_free(&nm)
                rt.buf_free(&r5)
                rt.buf_free(&r7)
                screen_chat.screen_chat_set_usage(jshell.app_ui(), p5, p7)
            }
        }
        return true
    }
    if kind == jarvisapi.AK_MODELS {
        if G_FLIGHT > 0 { G_FLIGHT = G_FLIGHT - 1 }
        if status == 200 {
            var b: rt.Buf = rt.buf_new()
            if jarvisapi.parse_model_label(jarvisapi.ja_body_ptr(x), jarvisapi.ja_body_len(x), &b) {
                screen_chat.screen_chat_set_model(jshell.app_ui(), __str_copy(str { p: b.ptr as *mut u8, n: b.len }))
            }
            rt.buf_free(&b)
            // the dropdown list (an empty list = no dropdown, the pill stays a plain label)
            var rows: rt.Buf = rt.buf_new()
            var effs: rt.Buf = rt.buf_new()
            var cm: rt.Buf = rt.buf_new()
            var ce: rt.Buf = rt.buf_new()
            var ct: rt.Buf = rt.buf_new()
            let has: bool = jarvisapi.parse_model_list(jarvisapi.ja_body_ptr(x), jarvisapi.ja_body_len(x), &rows, &effs, &cm, &ce, &ct)
            screen_chat.screen_chat_set_models(jshell.app_ui(), str { p: rows.ptr as *mut u8, n: rows.len }, str { p: effs.ptr as *mut u8, n: effs.len },
                str { p: cm.ptr as *mut u8, n: cm.len }, str { p: ce.ptr as *mut u8, n: ce.len }, str { p: ct.ptr as *mut u8, n: ct.len })
            rt.buf_free(&rows)
            rt.buf_free(&effs)
            rt.buf_free(&cm)
            rt.buf_free(&ce)
            rt.buf_free(&ct)
        }
        return true
    }
    if kind == jarvisapi.AK_MODEL_SET {
        // 200 = stored; anything else: say so and read the real choice again at the next tick
        if status != 200 {
            jshell.set_status("Modellwahl nicht gespeichert (" + jshell.dec(status) + ")") // english: ok
            G_NEXT_MS = 0
        }
        return true
    }
    return false
}
