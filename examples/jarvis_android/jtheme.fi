// SPDX-License-Identifier: MPL-2.0
// examples/jarvis_android/jtheme.fi -- the look of the JARVIS app = the look of the mobile web app (tokens: jtokens.fi).
//
// apply_colors(a, dark)  writes the web palette + shape into the fUi theme (call after app.set_dark; jshell.apply_theme does).
// install_rules(a)       ONCE after the window exists: style-sheet rules for the classes below (header, pills, tabs, composer).
// style(a, node, K_*)    puts one of the classes on a node.
// set_tab_on(a, node, on) tab bar: the active tab is accent coloured.
import fui.app
import fui.scene
import fui.style
import fui.sheet
import fui.theme
import fui.markdownview
import jtokens

export {
    apply_colors, install_rules, style_node, set_tab_on, K_BRAND, K_PILL, K_TAB, K_TAB_ON, K_BAR, K_COMPOSER, K_ICONBTN, K_SEND, K_FIELD, K_CHIP, K_HDR, K_PILL_OK, K_CARD, K_DIM, K_CHIP_ON,
}

const K_BRAND: u32 = 1
const K_PILL: u32 = 2
const K_TAB: u32 = 3
const K_TAB_ON: u32 = 4
const K_BAR: u32 = 5
const K_COMPOSER: u32 = 6
const K_ICONBTN: u32 = 7
const K_SEND: u32 = 8
const K_FIELD: u32 = 9
const K_CHIP: u32 = 10
const K_HDR: u32 = 11
const K_PILL_OK: u32 = 12
const K_CARD: u32 = 13
const K_DIM: u32 = 14
const K_CHIP_ON: u32 = 15

fn apply_colors(a: *mut app.App, dark: bool) {
    let m: *mut theme.Theme = app.app_theme(a)
    let f: *mut theme.Colors = theme.theme_colors(m)
    if dark {
        (*f).base = jtokens.D_BG
        (*f).surface = jtokens.D_PANEL
        (*f).surface_raised = jtokens.D_PANEL_UP
        (*f).button = jtokens.D_PANEL
        (*f).button_hover = jtokens.D_HOVER
        (*f).button_active = jtokens.D_PRESS
        (*f).field = jtokens.D_FIELD_BG
        (*f).field_focus = jtokens.D_FIELD_BG
        (*f).border_col = jtokens.D_FIELD_LINE
        (*f).separator = jtokens.D_LINE
        (*f).text = jtokens.D_TXT
        (*f).text_muted = jtokens.D_DIM
        (*f).text_disabled = jtokens.D_DIM
        (*f).text_on_accent = 0xffffff
        (*f).accent = jtokens.D_ACCENT
        (*f).selection = jtokens.D_SEL
        (*f).selection_text = jtokens.D_TXT
        (*f).err_col = jtokens.D_WARN
        (*f).warning = 0xffb020
        (*f).success = jtokens.D_OK
        markdownview.mdv_set_bubble(jtokens.D_BUBBLE, jtokens.R_BUBBLE)
    } else {
        (*f).base = jtokens.L_BG
        (*f).surface = jtokens.L_PANEL
        (*f).surface_raised = jtokens.L_PANEL_UP
        (*f).button = jtokens.L_PANEL
        (*f).button_hover = jtokens.L_HOVER
        (*f).button_active = jtokens.L_PRESS
        (*f).field = jtokens.L_FIELD_BG
        (*f).field_focus = jtokens.L_FIELD_BG
        (*f).border_col = jtokens.L_FIELD_LINE
        (*f).separator = jtokens.L_LINE
        (*f).text = jtokens.L_TXT
        (*f).text_muted = jtokens.L_DIM
        (*f).text_disabled = jtokens.L_DIM
        (*f).text_on_accent = 0xffffff
        (*f).accent = jtokens.L_ACCENT
        (*f).selection = jtokens.L_SEL
        (*f).selection_text = jtokens.L_TXT
        (*f).err_col = jtokens.L_WARN
        (*f).warning = 0xb26a00
        (*f).success = jtokens.L_OK
        markdownview.mdv_set_bubble(jtokens.L_BUBBLE, jtokens.R_BUBBLE)
    }
    var s: theme.Shape = theme.shape_fluent()
    s.r_window = jtokens.R_CARD
    s.r_panel = jtokens.R_CARD
    s.r_button = jtokens.R_MD
    s.r_field = jtokens.R_MD
    s.font = jtokens.FONT_BODY
    s.pad_x = 14
    s.pad_y = 8
    s.gap = 8
    s.focus_w = 0 // no keyboard focus ring after a touch (the web UI has none on taps)
    s.ctrl_h = 38
    s.row = 48
    theme.theme_set_shape(m, &s)
}

fn rule(a: *mut app.App, k: u32, st: style.Style) {
    let r: usize = sheet.sheet_rule(&(*a).sh, sheet.sel_class(k), st)
}

fn tok(t: u32) -> u32 { return style.color_token(t) }

fn install_rules(a: *mut app.App) {
    // brand: accent, heavy, letter-spaced (.brand)
    var st: style.Style = style.style_new()
    st = style.style_set_fg(st, tok(style.TOK_ACCENT))
    st = style.style_set_font(st, 0, jtokens.FONT_BRAND)
    st = style.style_set_weight(st, 800 as u32)
    st = style.style_set_tracking(st, jtokens.TRACK_BRAND)
    rule(a, K_BRAND, st)
    // status pill (.pill): outline, round, muted
    st = style.style_new()
    st = style.style_set_fg(st, tok(style.TOK_TEXT_MUTED))
    st = style.style_set_font(st, 0, jtokens.FONT_SMALL)
    st = style.style_set_border(st, tok(style.TOK_SEPARATOR), 1)
    st = style.style_set_radius(st, jtokens.R_PILL)
    st = style.style_set_pad(st, 10, 4)
    rule(a, K_PILL, st)
    // online: green pill (.pill.ok)
    st = style.style_new()
    st = style.style_set_fg(st, tok(style.TOK_SUCCESS))
    st = style.style_set_border(st, tok(style.TOK_SUCCESS), 1)
    rule(a, K_PILL_OK, st)
    // header row
    st = style.style_new()
    st = style.style_set_bg(st, tok(style.TOK_BASE))
    rule(a, K_HDR, st)
    // chip buttons (.chip / pills above the chat): outline, round
    st = style.style_new()
    st = style.style_set_bg(st, tok(style.TOK_BASE))
    st = style.style_set_fg(st, tok(style.TOK_TEXT))
    st = style.style_set_border(st, tok(style.TOK_SEPARATOR), 1)
    st = style.style_set_radius(st, jtokens.R_PILL)
    st = style.style_set_pad(st, 12, 5)
    st = style.style_set_font(st, 0, jtokens.FONT_SMALL)
    rule(a, K_CHIP, st)
    // active chip (mode switch): accent outline + text
    st = style.style_new()
    st = style.style_set_fg(st, tok(style.TOK_ACCENT))
    st = style.style_set_border(st, tok(style.TOK_ACCENT), 1)
    rule(a, K_CHIP_ON, st)
    // list card (.card): panel, hairline, radius 16
    st = style.style_new()
    st = style.style_set_bg(st, tok(style.TOK_SURFACE))
    st = style.style_set_border(st, tok(style.TOK_SEPARATOR), 1)
    st = style.style_set_radius(st, jtokens.R_CARD)
    rule(a, K_CARD, st)
    // quiet status text (.dim)
    st = style.style_new()
    st = style.style_set_fg(st, tok(style.TOK_TEXT_MUTED))
    st = style.style_set_font(st, 0, jtokens.FONT_SMALL)
    rule(a, K_DIM, st)
    // bottom tab bar: the sidebar ground, flat items
    st = style.style_new()
    st = style.style_set_bg(st, tok(style.TOK_SURFACE))
    rule(a, K_BAR, st)
    st = style.style_new()
    st = style.style_set_bg(st, tok(style.TOK_SURFACE))
    st = style.style_set_fg(st, tok(style.TOK_TEXT_MUTED))
    st = style.style_set_border(st, tok(style.TOK_SURFACE), 0)
    st = style.style_set_radius(st, jtokens.R_MD)
    st = style.style_set_pad(st, 6, 8)
    st = style.style_set_font(st, 0, jtokens.FONT_TAB + 1)
    rule(a, K_TAB, st)
    st = style.style_new()
    st = style.style_set_fg(st, tok(style.TOK_ACCENT))
    st = style.style_set_bg(st, tok(style.TOK_SURFACE))
    rule(a, K_TAB_ON, st)
    // composer (footer): panel, hairline, 16 radius, shadow
    st = style.style_new()
    st = style.style_set_bg(st, tok(style.TOK_SURFACE))
    st = style.style_set_border(st, tok(style.TOK_SEPARATOR), 1)
    st = style.style_set_radius(st, jtokens.R_CARD)
    st = style.style_set_pad(st, jtokens.COMPOSER_PAD_X, jtokens.COMPOSER_PAD_Y)
    st = style.style_set_box_shadow(st, 4, 16, 0x000000, 60)
    rule(a, K_COMPOSER, st)
    // round 38 px icon-like buttons (#attach, mic): flat, muted
    st = style.style_new()
    st = style.style_set_bg(st, tok(style.TOK_SURFACE))
    st = style.style_set_fg(st, tok(style.TOK_TEXT_MUTED))
    st = style.style_set_border(st, tok(style.TOK_SURFACE), 0)
    st = style.style_set_radius(st, 19)
    st = style.style_set_size(st, 52, jtokens.ICON_BTN)
    rule(a, K_ICONBTN, st)
    // #send: round, accent
    st = style.style_new()
    st = style.style_set_bg(st, tok(style.TOK_ACCENT))
    st = style.style_set_fg(st, tok(style.TOK_TEXT_ON_ACCENT))
    st = style.style_set_border(st, tok(style.TOK_ACCENT), 0)
    st = style.style_set_radius(st, 19)
    st = style.style_set_size(st, 64, jtokens.ICON_BTN)
    rule(a, K_SEND, st)
    // #input: no frame inside the composer
    st = style.style_new()
    st = style.style_set_bg(st, tok(style.TOK_SURFACE))
    st = style.style_set_border(st, tok(style.TOK_SURFACE), 0)
    rule(a, K_FIELD, st)
}

fn style_node(a: *mut app.App, n: usize, k: u32) {
    if n == app.NONE { return }
    scene.node_add_class(app.app_scene(a), n, k)
}

fn set_tab_on(a: *mut app.App, n: usize, on: bool) {
    if n == app.NONE { return }
    let sc: *mut scene.Scene = app.app_scene(a)
    if on {
        scene.node_add_class(sc, n, K_TAB_ON)
    } else {
        let r: bool = scene.node_remove_class(sc, n, K_TAB_ON)
    }
}
