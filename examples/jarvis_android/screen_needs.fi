// SPDX-License-Identifier: MPL-2.0
// examples/jarvis_android/screen_needs.fi -- the "Needs" part of the Leitstand tab: open questions of the projects ("braucht
// Justin"), shown as list rows (rows come from jdata), details in the Markdown reader, answered with ONE tap on an option button
// (up to 4) or with a free text. The answer goes to POST /api/projects/<id>/needs {action:"answer"}; the server wakes the asking
// chat. screen_leitstand.fi owns the list; this file owns the rows, the detail text and the answer buttons.
import std.rt
import fui.app
import fui.vlist
import jshell
import jtheme
import jdata
import jlist
import jtexts
import fui.applay
import screen_workerchat

export { needs_build, needs_row, needs_count, needs_select, needs_show, needs_sync, needs_selected, needs_detail }

static mut G_BOX: usize = 0
static mut G_B0: usize = 0
static mut G_B1: usize = 0
static mut G_B2: usize = 0
static mut G_B3: usize = 0
static mut G_IN: usize = 0
static mut G_SEL: usize = 4294967295
static mut G_MD: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }

const NONE: usize = 4294967295

fn needs_count() -> usize { return jdata.needs_count() }
fn needs_selected() -> usize { return G_SEL }

// one list row: "<project>: <question>"
fn needs_row(i: usize, out: *mut vlist.VRow) {
    jlist.put(out, jdata.need_str(i, 1))
    jlist.put(out, ": ")
    jlist.put(out, jdata.need_str(i, 3))
}

fn put(s: str) { rt.buf_push_bytes(&G_MD, s.p as u64, s.n) }

// Markdown of one need (the reader shows it)
fn needs_detail(i: usize) -> str {
    rt.buf_clear(&G_MD)
    if i >= jdata.needs_count() {
        put(jtexts.t("nd.none"))
        return str { p: G_MD.ptr as *mut u8, n: G_MD.len }
    }
    put("**")
    put(jdata.need_str(i, 1))
    put("**\n\n")
    put(jdata.need_str(i, 3))
    put("\n\n")
    var k: usize = 0
    while k < 4 && jdata.need_option(i, k).n > 0 {
        put("- ")
        put(jdata.need_option(i, k))
        put("\n")
        k = k + 1
    }
    if k == 0 { put(jtexts.t("nd.free")) }
    return str { p: G_MD.ptr as *mut u8, n: G_MD.len }
}

fn set_button(a: *mut app.App, b: usize, i: usize, k: usize) {
    let t: str = jdata.need_option(i, k)
    if t.n > 0 { app.set_text(a, b, t) }
    jshell.set_shown(a, b, t.n > 0, 0)
}

// the answer box follows the selection (hidden without one)
fn needs_sync(a: *mut app.App) {
    let ok: bool = G_SEL != NONE && G_SEL < jdata.needs_count()
    if !ok { G_SEL = NONE }
    jshell.set_shown(a, G_BOX, ok, 0)
    if !ok { return }
    set_button(a, G_B0, G_SEL, 0)
    set_button(a, G_B1, G_SEL, 1)
    set_button(a, G_B2, G_SEL, 2)
    set_button(a, G_B3, G_SEL, 3)
}

fn needs_select(a: *mut app.App, i: usize) {
    G_SEL = i
    needs_sync(a)
    screen_workerchat.wc_show_text(needs_detail(i))
}

// the box is only there while the needs mode is active
fn needs_show(a: *mut app.App, on: bool) {
    if on { needs_sync(a) } else { jshell.set_shown(a, G_BOX, false, 0) }
}

fn send(a: *mut app.App, answer: str) {
    if G_SEL == NONE || answer.n == 0 { return }
    let ok: bool = jdata.answer_need(G_SEL, __str_copy(answer))
    if !ok {
        jdata.set_note(jtexts.t("nd.not-sent"))
        return
    }
    jdata.set_note(jtexts.t("nd.sending"))
    app.set_text(a, G_IN, "")
    G_SEL = NONE
    needs_sync(a)
    screen_workerchat.wc_show_text(jtexts.t("nd.sent"))
}

fn on_opt0(a: *mut app.App) { send(a, jdata.need_option(G_SEL, 0)) }
fn on_opt1(a: *mut app.App) { send(a, jdata.need_option(G_SEL, 1)) }
fn on_opt2(a: *mut app.App) { send(a, jdata.need_option(G_SEL, 2)) }
fn on_opt3(a: *mut app.App) { send(a, jdata.need_option(G_SEL, 3)) }
fn on_free(a: *mut app.App) { send(a, app.text(a, G_IN)) }

fn needs_build(a: *mut app.App) {
    // answer box: option chips wrap from the left, the own-answer field takes the full width
    G_BOX = applay.vstack(a)
    applay.hrow(a)
    G_B0 = app.button(a, "", on_opt0)
    jtheme.style_node(a, G_B0, jtheme.K_CHIP)
    G_B1 = app.button(a, "", on_opt1)
    jtheme.style_node(a, G_B1, jtheme.K_CHIP)
    G_B2 = app.button(a, "", on_opt2)
    jtheme.style_node(a, G_B2, jtheme.K_CHIP)
    G_B3 = app.button(a, "", on_opt3)
    jtheme.style_node(a, G_B3, jtheme.K_CHIP)
    app.end(a)
    applay.hline(a)
    G_IN = app.entry(a, jtexts.t("nd.own"))
    applay.field_fill(a, G_IN)
    jtheme.style_node(a, app.button(a, jtexts.t("nd.send"), on_free), jtheme.K_CHIP)
    app.end(a)
    app.end(a)
    jshell.set_shown(a, G_BOX, false, 0)
}
