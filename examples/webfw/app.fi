import std.rt
import std.io
import std.json
import webfw.wf_types
import webfw.wf_web
import webfw.wf_ctx
import webfw.wf_cors
import webfw.wf_limit
import webfw.wf_compress
import webfw.wf_auth
import webfw.wf_session
import webfw.wf_tpl
import webfw.wf_text

const PAGE: str = "<h1>Hello {{who}}</h1>{{#if admin}}<p>admin</p>{{else}}<p>guest</p>{{/if}}<ul>{{#each items}}<li>{{.}}</li>{{/each}}</ul>"

fn home(c: *mut wf_types.Ctx) {
    var d = wf_tpl.tpl_new()
    wf_tpl.tpl_set(&d, "who", wf_ctx.query(c, "who"))
    wf_tpl.tpl_set(&d, "admin", wf_ctx.query(c, "admin"))
    wf_tpl.tpl_list_push(&d, "items", "one & two")
    wf_tpl.tpl_list_push(&d, "items", "<three>")
    wf_ctx.html(c, 200, wf_tpl.render_str(PAGE, &d))
    wf_tpl.tpl_free(&d)
}

fn hello(c: *mut wf_types.Ctx) {
    wf_ctx.text(c, 200, "hello " + wf_ctx.param(c, "name"))
}

fn user(c: *mut wf_types.Ctx) {
    var w = wf_ctx.json_out(c, 200)
    json.jw_begin_object(&w)
    json.jw_key(&w, "id".p as u64, 2)
    json.jw_string(&w, wf_ctx.param(c, "id").p as u64, wf_ctx.param(c, "id").n)
    json.jw_end(&w)
    json.jw_free(&w)
}

fn create_user(c: *mut wf_types.Ctx) {
    if !wf_ctx.json_in(c) {
        wf_ctx.json_error(c, 400, "bad json")
        return
    }
    let name: str = wf_ctx.json_str(c, "name")
    var w = wf_ctx.json_out(c, 201)
    json.jw_begin_object(&w)
    json.jw_key(&w, "name".p as u64, 4)
    json.jw_string(&w, name.p as u64, name.n)
    json.jw_key(&w, "age".p as u64, 3)
    json.jw_int(&w, wf_ctx.json_int(c, "age", 0 - 1))
    json.jw_end(&w)
    json.jw_free(&w)
}

fn query_echo(c: *mut wf_types.Ctx) {
    wf_ctx.text(c, 200, wf_ctx.query(c, "a") + "|" + wf_ctx.query(c, "b"))
}

fn form_echo(c: *mut wf_types.Ctx) {
    wf_ctx.text(c, 200, wf_ctx.form(c, "x") + "|" + wf_ctx.form(c, "y"))
}

fn cookies(c: *mut wf_types.Ctx) {
    wf_ctx.set_cookie(c, "seen", "yes please", 3600, true)
    wf_ctx.text(c, 200, "old=" + wf_ctx.cookie(c, "seen"))
}

fn counter(c: *mut wf_types.Ctx) {
    let cur: str = wf_session.session_get(c, "n")
    wf_session.session_set(c, "n", cur + "x")
    wf_ctx.text(c, 200, io.fmt_string(f"{cur.n + 1}"))
}

fn logout(c: *mut wf_types.Ctx) {
    wf_session.session_destroy(c)
    wf_ctx.text(c, 200, "bye")
}

fn big(c: *mut wf_types.Ctx) {
    var b: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < 400 {
        rt.buf_push_bytes(&b, "the quick brown fox jumps over the lazy dog\n".p as u64, 44)
        i = i + 1
    }
    wf_ctx.text(c, 200, rt.buf_str(&b))
    rt.buf_free(&b)
}

fn echo(c: *mut wf_types.Ctx) {
    wf_ctx.text(c, 200, wf_ctx.method(c) + " " + wf_ctx.path(c) + " " + wf_ctx.body(c))
}

fn jump(c: *mut wf_types.Ctx) {
    wf_ctx.redirect(c, 302, "/hello/redirected")
}

fn boom(c: *mut wf_types.Ctx) {
    wf_ctx.status_error(c, 422, "teapot")
}

fn secret(c: *mut wf_types.Ctx) {
    wf_ctx.json_raw(c, 200, "{\"secret\": 42}")
}

fn check_auth(c: *mut wf_types.Ctx) -> bool {
    var user: str = ""
    var pass: str = ""
    if wf_auth.basic_credentials(c, &user, &pass) { return user == "admin" && pass == "pw" }
    return wf_auth.bearer_token(c) == "tok"
}

fn stop(c: *mut wf_types.Ctx) {
    wf_ctx.text(c, 200, "bye")
    wf_web.stop_now(c)
}

fn mark_v1(c: *mut wf_types.Ctx) -> bool {
    wf_ctx.set_header(c, "X-Group", "v1")
    return true
}

fn arg_text(start: u64, k: usize) -> str {
    let p: u64 = rt.arg_ptr(start, k)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn main(start: u64) -> i32 {
    var port: u64 = 0
    wf_text.parse_u64(arg_text(start, 1), &port)
    var w: wf_types.Web = wf_web.web_new(port as u16)
    wf_web.set_quiet(&w, true)
    wf_web.get(&w, "/", home)
    wf_web.get(&w, "/hello/:name", hello)
    wf_web.get(&w, "/users/:id", user)
    wf_web.post(&w, "/users", create_user)
    wf_web.get(&w, "/q", query_echo)
    wf_web.post(&w, "/form", form_echo)
    wf_web.get(&w, "/cookies", cookies)
    wf_web.get(&w, "/session", counter)
    wf_web.get(&w, "/logout", logout)
    wf_web.get(&w, "/big", big)
    wf_web.any(&w, "/echo/*rest", echo)
    wf_web.get(&w, "/jump", jump)
    wf_web.get(&w, "/boom", boom)
    wf_web.get(&w, "/stop", stop)
    var api = wf_web.group(&w, "/api")
    wf_web.group_use(&api, wf_auth.require_auth)
    wf_web.g_get(&api, "/secret", secret)
    var v1 = wf_web.sub(&api, "/v1")
    wf_web.group_use(&v1, mark_v1)
    wf_web.g_get(&v1, "/secret", secret)
    wf_auth.set_auth_hook(&w, "example", check_auth)
    wf_cors.enable_cors(&w, "http://example.test", "GET, POST, PUT, DELETE", "Content-Type, Authorization", 600 as u32)
    wf_compress.enable_compress(&w, 256, 3 as u32)
    wf_session.enable_sessions(&w, "example-secret-key", 3600)
    if rt.arg_count(start) > 2 { wf_web.mount_static(&w, "/static", arg_text(start, 2)) }
    if rt.arg_count(start) > 3 { wf_limit.enable_rate_limit(&w, 5 as u32, 60000) }
    io.print_line(wf_web.url(&w))
    return wf_web.serve(&w)
}
