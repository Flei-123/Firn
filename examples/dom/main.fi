// SPDX-License-Identifier: MPL-2.0
// examples/dom -- a web page built from Firn through the DOM (lib/web/dom.fi):
// a counter button and a small to-do list. No canvas, real HTML elements.
//   firnc --target=wasm32-browser -o examples/dom/app.wasm examples/dom/main.fi
//   cp lib/web/dom.js examples/dom/ && python3 -m http.server -d examples/dom
import web.dom
import std.io

static mut G_COUNT: i64 = 0
static mut G_LIST: u32 = 0
static mut G_INPUT: u32 = 0

fn clicked(ud: u64, h: u32) {
    G_COUNT = G_COUNT + 1
    dom.set_text_f(h, f"clicked {G_COUNT} times")
}

fn add_item(ud: u64, h: u32) {
    let t: str = dom.value(G_INPUT)
    if t.n == 0 { return }
    let li: u32 = dom.create("li")
    dom.set_text(li, t)
    dom.append(G_LIST, li)
    dom.release(li)
    dom.set_value(G_INPUT, "")
}

fn key(ud: u64, h: u32) {
    if dom.event_key() == "Enter" { add_item(ud, h) }
}

fn main() -> i32 {
    let body: u32 = dom.query("body")
    let h1: u32 = dom.create("h1")
    dom.set_text(h1, "Firn -> DOM")
    dom.append(body, h1)

    let b: u32 = dom.create("button")
    dom.set_attr(b, "id", "count")
    dom.set_text(b, "clicked 0 times")
    dom.append(body, b)
    dom.on(b, "click", clicked, 0)

    let row: u32 = dom.create("p")
    dom.append(body, row)
    G_INPUT = dom.create("input")
    dom.set_attr(G_INPUT, "id", "todo")
    dom.set_attr(G_INPUT, "placeholder", "to do ...")
    dom.append(row, G_INPUT)
    let add: u32 = dom.create("button")
    dom.set_attr(add, "id", "add")
    dom.set_text(add, "add")
    dom.append(row, add)
    dom.on(add, "click", add_item, 0)
    dom.on(G_INPUT, "keydown", key, 0)

    G_LIST = dom.create("ul")
    dom.set_attr(G_LIST, "id", "list")
    dom.set_style(G_LIST, "font-family", "sans-serif")
    dom.append(body, G_LIST)

    dom.set_attr(body, "data-ua", dom.eval("navigator.userAgent.split(' ')[0]"))
    return 0
}
