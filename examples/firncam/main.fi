// SPDX-License-Identifier: MPL-2.0
// examples/firncam -- FirnCam app: GPU preview in an immediate-mode fUi screen (examples/firncam/ui.fi), mode bar
// (PHOTO = auto HDR burst, NIGHT, PORTRAIT, DOC scan + PDF, STACK = focus stack, VIDEO, RAW = DNG), manual sliders
// (ISO / exposure / focus), lens chips, flip, flash, tap to focus, zoom. The processing of a shot (photo.camjob:
// merge, tone, bokeh, scan, JPEG encode) runs on a job thread with a progress bar; the result goes to MediaStore.
// Everything about the device comes from the CameraCharacteristics (lib/plat/android/camera.fi).
//   bash tools/android/build.sh examples/firncam/main.fi --camera --name FirnCam --package org.firn.cam
//
// Loop (one turn per frame): permission/scan -> job step -> pointers + events -> gestures (kittouch) -> ui_update
// -> commands out of the UI (ui_take) run on the camera -> newest preview frame to the GPU (camview, the reader is
// drained every turn) -> camview_render into the preview rectangle -> painter: camview_draw + ui_draw.
import plat.fuishell
import window.window
import window.pointers
import fui.kittouch
import fui.camview
import fui.painter
import gpu.campreview
import plat.android.camera
import plat.android.display
import plat.android.dngwrite
import photo.meta
import photo.camjob
import photo.focus
import photo.par
import jobs.jobs
import std.rt
import std.math
import android.ndk
import plat.android.focusplan
import ui

// Writes decimal `v` into dst (zero terminated), returns the length.
fn put_int(dst: u64, v: i64) -> usize {
    var tmp: [u8; 24] = [0 as u8; 24]
    var n: usize = 0
    var x: i64 = v
    if x < 0 { x = 0 - x }
    if x == 0 { tmp[0] = 48 as u8; n = 1 }
    while x > 0 {
        tmp[n] = (48 + (x % 10)) as u8
        x = x / 10
        n = n + 1
    }
    var o: usize = 0
    if v < 0 { *(dst as *mut u8) = 45 as u8; o = 1 }
    var i: usize = 0
    while i < n {
        *((dst + (o + i) as u64) as *mut u8) = tmp[n - 1 - i]
        i = i + 1
    }
    *((dst + (o + n) as u64) as *mut u8) = 0 as u8
    return o + n
}

const JOB_KIND: u64 = 77
// Zoom photos: true = RAW burst + digital zoom in photo.camjob (centre window, full resolution demosaic, Lanczos,
// burst merge); false = the camera service crops a JPEG stream (old path). Only a real phone can confirm that the
// RAW stream is NOT cropped by CONTROL_ZOOM_RATIO (Camera2 contract) - if a device crops it, set this to false.
const ZOOM_RAW_CROP: bool = true
const JOB_STACK: usize = 16 * 1024 * 1024 // job thread stack

// The job thread is a bionic pthread that attaches to the Firn runtime (thread_attach): a raw-clone thread of
// thread_start shares bionic's thread pointer and crashes the app on Android.
extern fn pthread_create(tid: u64, attr: u64, start: u64, arg: u64) -> i32;
extern fn usleep(us: u32) -> i32;
extern fn pthread_attr_init(attr: u64) -> i32;
extern fn pthread_attr_setstacksize(attr: u64, n: usize) -> i32;
extern fn pthread_attr_setdetachstate(attr: u64, state: i32) -> i32;
const BUDGET: usize = 400 * 1024 * 1024 // capture buffer budget of one shot

const M_PHOTO: i32 = 0
const M_NIGHT: i32 = 1
const M_PORTRAIT: i32 = 2
const M_DOC: i32 = 3
const M_STACK: i32 = 4
const M_VIDEO: i32 = 5
const M_RAW: i32 = 6

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == jobs.WORKER_KIND { return jobs.worker_main(arg) }
    if kind == JOB_KIND { return camjob.job_entry(arg) }
    return 0
}

struct App {
    nlens: i32,
    lens: i32,
    mode: i32,
    manual: bool,
    sl: [i32; 3], // slider positions 0..1000: ISO, exposure, focus
    kind: i32,
    ready: bool,
    status: [u8; 64],
    st_new: bool, // the status text changed (main loop hands it to the UI)
    info: camera.CamInfo,
    shots: i32,
    recording: bool,
    job: camjob.Job,
    busy: bool,
    th: u64,
    cbuf: u64, // capture buffer of the running job
    ccap: usize,
    fbuf: u64, // FrameInfo array of the running job
    stamp0: i64,
    tattr: [u64; 16], // pthread_attr_t
    ttid: u64,
    wreq: u64, // job requests counter the job thread watches
    stage: i32, // 0 idle, 1 capturing (UI thread, one frame per loop), 2 processing (job thread)
    cap_n: i32,
    cap_i: i32,
    cap_at: usize,
    steps: [f32; 16], // focus diopters of a focus stack
    bs: [u64; 16], // start of each captured frame
    flash: i32, // user flash: 0 off, 1 auto, 2 on
    fl_last: i32, // flash mode last given to the camera (camera.FLASH_*), -1 = unknown
    disp: i32, // display rotation in degrees
    thumb: u64, // last saved photo, THUMB x THUMB premultiplied RGBA
    pthumb: u64, // rolling thumbnail of the preview
    sthumb: u64, // snapshot taken when the shutter is pressed
    tkey: u64,
    have_thumb: bool,
    have_p: bool,
    have_s: bool,
    nframe: u64,
    lfac: [i32; 16], // facing of each scanned lens
    lmm: [f32; 16], // 35 mm equivalent of each scanned lens
    main_lens: [i32; 3], // lens nearest 26 mm by facing (0 front, 1 back, 2 external), -1 none
    chip_idx: [i32; 6],
    chip_x10: [i32; 6],
    chip_opt: [i32; 6], // 1 = a lens of that zoom factor exists (optical), 0 = digital crop
    foc1: f32, // focal length (mm) the camera reports at zoom 1 (0 = unknown); another value later = the lens switched
    nchip: i32,
    learn_x10: i32, // zoom x10 at which the camera service was seen to switch to another physical lens (0 = none seen)
    learn_lens: i32, // scan index of the lens the sweep ran on
    swept: bool,
    sw_n: i32,
    sw_z: [i32; 16], // sweep log: zoom x10, focal x100 mm, crop width, active physical id
    sw_f: [i32; 16],
    sw_cw: [i32; 16],
    sw_ph: [[u8; 16]; 16],
    ph1: [u8; 16], // ACTIVE_PHYSICAL_ID seen at zoom 1 ("" = the device reports none)
    can_flip: bool,
    cpu: u64, // CPU fallback picture (BGRX)
    cpu_cap: usize,
    pend_zoom: f64, // zoom asked this turn (< 0 = none)
    zr: f32, // CONTROL_ZOOM_RATIO of the open lens (camera_open resets it to 1; do_zoom sets it again)
    pend_sl: [i32; 3], // slider values asked this turn (-1 = none)
}

fn set_status(a: *mut App, s: str) {
    var i: usize = 0
    while i < s.n && i < 63 {
        (*a).status[i] = *((s.p as u64 + i as u64) as *mut u8)
        i = i + 1
    }
    (*a).status[i] = 0 as u8
    (*a).st_new = true
}

fn status_str(a: *mut App) -> str {
    var n: usize = 0
    while n < 63 && (*a).status[n] != 0 as u8 { n = n + 1 }
    var s: str = ""
    s.p = (&(*a).status[0]) as u64 as *mut u8
    s.n = n
    return s
}

// ---------------------------------------------------------------- what this lens can do
fn has_raw(a: *mut App) -> bool {
    return ((*a).info.caps & camera.CAP_RAW) != 0 as u32 && (*a).info.raw_w > 0
}

fn raw_frame_bytes(a: *mut App) -> usize {
    return ((*a).info.raw_w as usize) * ((*a).info.raw_h as usize) * 2 + 4096
}

// RAW bursts only when at least 3 frames fit the budget (huge sensors fall back to JPEG)
fn raw_burst_ok(a: *mut App) -> bool {
    return has_raw(a) && raw_frame_bytes(a) * 3 <= BUDGET
}

fn has_man_sensor(a: *mut App) -> bool {
    return ((*a).info.caps & camera.CAP_MANUAL_SENSOR) != 0 as u32 && (*a).info.iso_max > 0 && (*a).info.exp_max_ns > 0 as i64
}

fn has_man_focus(a: *mut App) -> bool {
    return ((*a).info.caps & camera.CAP_MANUAL_FOCUS) != 0 as u32 && (*a).info.min_focus_d > 0.0f
}

fn mode_ok(a: *mut App, m: i32) -> bool {
    if m == M_STACK { return has_man_focus(a) && (*a).info.min_focus_d >= 1.0f } // a real focus range, else nothing to stack
    if m == M_VIDEO { return (*a).info.vid_w > 0 }
    if m == M_RAW { return has_raw(a) }
    return true
}

// visible modes in bar order; returns the count
fn visible(a: *mut App, out: *mut [i32; 8]) -> i32 {
    var n: i32 = 0
    var m: i32 = 0
    while m <= M_RAW {
        if mode_ok(a, m) { (*out)[n as usize] = m; n = n + 1 }
        m = m + 1
    }
    return n
}

fn man_ok(a: *mut App) -> bool {
    return (has_man_sensor(a) || has_man_focus(a)) && ((*a).mode == M_PHOTO || (*a).mode == M_RAW)
}

// session kind for the current mode / lens
fn want_kind(a: *mut App) -> i32 {
    let m: i32 = (*a).mode
    if m == M_RAW { if has_raw(a) { return camera.KIND_RAW } else { return camera.KIND_JPEG } }
    if m == M_VIDEO { return camera.KIND_JPEG }
    if (*a).manual && m == M_PHOTO { return camera.KIND_JPEG }
    // RAW_SENSOR streams are NOT cropped by SCALER_CROP_REGION / ZOOM_RATIO (Camera2 contract): a zoomed RAW burst
    // would come out at the wide field of view. The JPEG stream is cropped and scaled by the camera service.
    if (*a).zr > 1.05f && m != M_RAW && !ZOOM_RAW_CROP { return camera.KIND_JPEG }
    if (*a).flash > 0 && m == M_PHOTO { return camera.KIND_JPEG } // a flash shot is one frame
    if raw_burst_ok(a) { return camera.KIND_RAW }
    return camera.KIND_JPEG
}

fn open_lens(a: *mut App, idx: i32) {
    camera.camera_close()
    (*a).ready = false
    if !camera.camera_info(idx, &(*a).info) { set_status(a, "NO INFO"); return }
    (*a).lens = idx
    if !mode_ok(a, (*a).mode) { (*a).mode = M_PHOTO }
    if !man_ok(a) { (*a).manual = false }
    let e: i32 = camera.camera_open(idx)
    if e != camera.E_OK { set_status(a, "OPEN FAILED"); return }
    let s: i32 = camera.camera_start(want_kind(a))
    if s != camera.E_OK { set_status(a, "SESSION FAILED"); return }
    (*a).kind = camera.camera_kind()
    (*a).zr = 1.0f // camera_open reset the zoom
    (*a).ready = true
    (*a).fl_last = 0 - 1
    apply_manual(a)
    let fe: i32 = apply_flash(a)
    rebuild_chips(a)
    set_status(a, "READY")
}

fn stamp() -> i64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 0, (&ts[0]) as i64, 0, 0, 0, 0)
    return ts[0]
}

// ---------------------------------------------------------------- manual sliders
fn man_iso(a: *mut App) -> i32 {
    let lo: f64 = if (*a).info.iso_min > 0 { (*a).info.iso_min as f64 } else { 50.0 }
    let hi: f64 = (*a).info.iso_max as f64
    return (lo * math.powf(hi / lo, ((*a).sl[0] as f64) / 1000.0) + 0.5) as i32
}

fn man_exp(a: *mut App) -> i64 {
    let lo: f64 = (*a).info.exp_min_ns as f64
    var hi: f64 = (*a).info.exp_max_ns as f64
    if hi > 500000000.0 { hi = 500000000.0 }
    if lo <= 0.0 || hi <= lo { return (*a).info.exp_min_ns }
    return (lo * math.powf(hi / lo, ((*a).sl[1] as f64) / 1000.0)) as i64
}

fn man_focus(a: *mut App) -> f32 {
    return (*a).info.min_focus_d * ((*a).sl[2] as f32) / 1000.0f
}

fn apply_manual(a: *mut App) {
    if !(*a).ready || !(*a).manual { return }
    var e: i64 = 0
    var iso: i32 = 0
    var fd: f32 = 0.0f - 1.0f
    if has_man_sensor(a) { e = man_exp(a); iso = man_iso(a) }
    if has_man_focus(a) { fd = man_focus(a) }
    camera.camera_set_manual(e, iso, fd)
}

// rows that exist: 0 ISO, 1 EXP, 2 FOCUS -> packed list; returns the count
fn rows_of(a: *mut App, out: *mut [i32; 3]) -> i32 {
    var n: i32 = 0
    if has_man_sensor(a) { (*out)[0] = 0; (*out)[1] = 1; n = 2 }
    if has_man_focus(a) { (*out)[n as usize] = 2; n = n + 1 }
    return n
}

// ---------------------------------------------------------------- saving names
fn name_into(dst: u64, prefix: str, ext: str) -> usize {
    var o: usize = 0
    var i: usize = 0
    while i < prefix.n { *((dst + o as u64) as *mut u8) = *((prefix.p as u64 + i as u64) as *mut u8); o = o + 1; i = i + 1 }
    o = o + put_int(dst + o as u64, stamp())
    i = 0
    while i < ext.n { *((dst + o as u64) as *mut u8) = *((ext.p as u64 + i as u64) as *mut u8); o = o + 1; i = i + 1 }
    *((dst + o as u64) as *mut u8) = 0 as u8
    return o
}

fn report(a: *mut App, r: i32, ok_txt: str, priv_txt: str) {
    if r == 1 || r == 2 { commit_thumb(a) }
    if r == 1 { set_status(a, ok_txt) } else if r == 2 { set_status(a, priv_txt) } else { set_status(a, "SAVE FAILED") }
}

// ---------------------------------------------------------------- plain single shot (RAW -> DNG, JPEG as the camera made it)
fn shoot_plain(a: *mut App) {
    if !(*a).ready { return }
    let cap: usize = if (*a).kind == camera.KIND_RAW { raw_frame_bytes(a) } else { 24 * 1024 * 1024 }
    let buf: u64 = camera.camera_alloc(cap)
    if buf == 0 { set_status(a, "NO MEMORY"); return }
    var fi: camera.FrameInfo = camera.zero_frame()
    var exp_l: [i64; 1] = [0 as i64; 1]
    var foc_l: [f32; 1] = [0.0f; 1]
    var ep: u64 = 0
    var fp: u64 = 0
    var iso: i32 = 0
    if (*a).manual {
        if has_man_sensor(a) { exp_l[0] = man_exp(a); iso = man_iso(a); ep = (&exp_l[0]) as u64 }
        if has_man_focus(a) { foc_l[0] = man_focus(a); fp = (&foc_l[0]) as u64 }
    }
    if (*a).flash > 0 && ((*a).mode == M_PHOTO || (*a).mode == M_RAW) { let fp2: i32 = camera.camera_flash_prepare() }
    let n: i32 = camera.camera_capture(1, ep, fp, iso, buf, cap, &fi)
    if n < 1 {
        set_status(a, "CAPTURE FAILED")
        camera.camera_free(buf, cap)
        return
    }
    var name: [u8; 48] = [0 as u8; 48]
    (*a).shots = (*a).shots + 1
    if fi.kind == camera.KIND_RAW {
        var m: meta.SensorMeta = meta.meta_default()
        camera.camera_meta(fi.slot, &m)
        var ex: dngwrite.DngExtra = dngwrite.dng_extra_default()
        camera.camera_dng_extra(fi.slot, &ex)
        let dcap: usize = dngwrite.dng_max_size(fi.w as u32, fi.h as u32)
        let dbuf: u64 = camera.camera_alloc(dcap)
        if dbuf == 0 { set_status(a, "NO MEMORY"); camera.camera_free(buf, cap); return }
        let dn: usize = dngwrite.dng_write(dbuf, dcap, buf + fi.offset as u64, fi.w as u32, fi.h as u32, &m, &ex)
        name_into((&name[0]) as u64, "IMG_", ".dng")
        let mime: str = "image/x-adobe-dng\0"
        let r: i32 = if dn > 0 { camera.camera_save(dbuf, dn, (&name[0]) as u64, mime.p as u64) } else { 0 }
        camera.camera_free(dbuf, dcap)
        report(a, r, "SAVED DNG", "SAVED DNG PRIVATE")
    } else if fi.kind == camera.KIND_JPEG {
        name_into((&name[0]) as u64, "IMG_", ".jpg")
        let mime: str = "image/jpeg\0"
        let r: i32 = camera.camera_save(buf + fi.offset as u64, fi.size, (&name[0]) as u64, mime.p as u64)
        report(a, r, "SAVED JPG", "SAVED JPG PRIVATE")
    } else {
        set_status(a, "YUV NOT SAVED")
    }
    camera.camera_free(buf, cap)
}

// ---------------------------------------------------------------- processed shot: capture, then the job thread
fn exif_orientation(deg: i32) -> i32 {
    if deg == 90 { return 6 }
    if deg == 180 { return 3 }
    if deg == 270 { return 8 }
    return 1
}

fn want_frames(a: *mut App, raw: bool, steps: *mut [f32; 16]) -> i32 {
    let m: i32 = (*a).mode
    if m == M_PHOTO { return if raw { 6 } else { 4 } }
    if m == M_NIGHT { return if raw { 10 } else { 6 } }
    if m == M_PORTRAIT { return 3 }
    if m == M_DOC { return 2 }
    // focus stack: steps from the lens' focus range
    var mt: meta.SensorMeta = meta.meta_default()
    camera.camera_meta(0 - 1, &mt)
    return focus.plan_focus(&mt, 0.0f, (*a).info.min_focus_d, 8, &(*steps)[0])
}

// UI side, step 1: plan the shot, allocate; the frames are taken one per UI iteration (step_capture)
fn start_job(a: *mut App) {
    if !(*a).ready || (*a).busy { return }
    let raw: bool = (*a).kind == camera.KIND_RAW
    let ji: *mut camera.CamInfo = &(*a).info
    let fb: usize = if raw { raw_frame_bytes(a) } else { (((*ji).jpeg_w as usize) * ((*ji).jpeg_h as usize) * 3) / 4 + 1048576 }
    var n: i32 = want_frames(a, raw, &(*a).steps)
    while n > 1 && (n as usize) * fb > BUDGET { n = n - 1 }
    if (*a).mode == M_STACK && n < 2 { set_status(a, "NO FOCUS RANGE"); return }
    if n > 16 { n = 16 }
    let cap: usize = fb * (n as usize)
    let buf: u64 = camera.camera_alloc(cap)
    let fra: u64 = camera.camera_alloc(camera.sizeof_frame() * 16)
    if buf == 0 || fra == 0 {
        if buf != 0 { camera.camera_free(buf, cap) }
        if fra != 0 { camera.camera_free(fra, camera.sizeof_frame() * 16) }
        set_status(a, "NO MEMORY")
        return
    }
    camjob.job_free(&(*a).job)
    (*a).job = camjob.job_new()
    if (*a).fl_last > 0 { let f0: i32 = camera.camera_set_flash(camera.FLASH_OFF); (*a).fl_last = camera.FLASH_OFF } // a series never fires the flash
    (*a).cbuf = buf
    (*a).ccap = cap
    (*a).fbuf = fra
    (*a).cap_n = n
    (*a).cap_i = 0
    (*a).cap_at = 0
    (*a).stage = 1
    (*a).busy = true
    set_status(a, "CAPTURING")
}

fn release_capture(a: *mut App) {
    if (*a).cbuf != 0 { camera.camera_free((*a).cbuf, (*a).ccap) }
    if (*a).fbuf != 0 { camera.camera_free((*a).fbuf, camera.sizeof_frame() * 16) }
    (*a).cbuf = 0
    (*a).fbuf = 0
    let fe: i32 = apply_flash(a)
}

// one frame per call (a capture is a few hundred ms; the UI keeps drawing between frames)
fn step_capture(a: *mut App) {
    let fptr: *mut camera.FrameInfo = (*a).fbuf as *mut camera.FrameInfo
    let k: i32 = (*a).cap_i
    let fk: *mut camera.FrameInfo = camera.frame_at(fptr, k)
    var fp: u64 = 0
    if (*a).mode == M_STACK { fp = (&(*a).steps[k as usize]) as u64 }
    let c: i32 = camera.camera_capture(1, 0, fp, 0, (*a).cbuf + (*a).cap_at as u64, (*a).ccap - (*a).cap_at, fk)
    if c >= 1 {
        (*a).bs[k as usize] = (*a).cbuf + (*a).cap_at as u64
        (*a).cap_at = (*a).cap_at + (*fk).offset + (*fk).size
        (*a).cap_i = k + 1
        (*a).job.progress = (((k + 1) * 25 / (*a).cap_n) as u64)
    }
    if c < 1 || (*a).cap_i >= (*a).cap_n {
        if (*a).cap_i < 1 {
            release_capture(a)
            set_status(a, "CAPTURE FAILED")
            (*a).busy = false
            (*a).stage = 0
            return
        }
        begin_process(a)
    }
}

// step 2: hand the frames to the job thread
fn begin_process(a: *mut App) {
    let ji: *mut camera.CamInfo = &(*a).info
    let fptr: *mut camera.FrameInfo = (*a).fbuf as *mut camera.FrameInfo
    (*a).job.mode = (*a).mode
    (*a).job.orientation = exif_orientation((*ji).orientation)
    (*a).job.zoom = 1.0f
    if ZOOM_RAW_CROP && (*a).kind == camera.KIND_RAW && (*a).zr > 1.05f { (*a).job.zoom = (*a).zr }
    var mt: meta.SensorMeta = meta.meta_default()
    camera.camera_meta((*fptr).slot, &mt)
    (*a).job.meta = mt
    var i: i32 = 0
    while i < (*a).cap_i {
        let f: *mut camera.FrameInfo = camera.frame_at(fptr, i)
        var kind: i32 = camjob.SHOT_JPEG
        if (*f).kind == camera.KIND_RAW { kind = camjob.SHOT_RAW }
        if (*f).kind != camera.KIND_YUV {
            camjob.job_add_shot(&(*a).job, kind, (*f).w, (*f).h, (*a).bs[i as usize] + (*f).offset as u64, (*f).size, (*f).exposure_ns, (*f).iso)
        }
        i = i + 1
    }
    (*a).stage = 2
    set_status(a, "PROCESSING")
    if (*a).ttid == 0 {
        pthread_attr_init((&(*a).tattr[0]) as u64)
        pthread_attr_setstacksize((&(*a).tattr[0]) as u64, JOB_STACK)
        pthread_attr_setdetachstate((&(*a).tattr[0]) as u64, 1)
        let rc: i32 = pthread_create((&(*a).ttid) as u64, (&(*a).tattr[0]) as u64, ndk.code_of_thread(thread_job_main), a as u64)
        if rc != 0 { (*a).ttid = 0 }
    }
    if (*a).ttid == 0 {
        camjob.job_entry((&(*a).job) as u64) // no thread: run here
    } else {
        __atomic_add((&(*a).wreq) as *mut u64, 1)
    }
}

// The job thread lives as long as the app: it attaches to the Firn runtime once and never detaches (leaving a
// thread that detached crashes the process on Android). Between jobs it sleeps in host mode (counted as blocked).
fn thread_job_main(arg: u64) -> u64 {
    let a: *mut App = arg as *mut App
    if !thread_attach() { return 0 }
    var seen: u64 = 0
    while true {
        let want: u64 = __atomic_add((&(*a).wreq) as *mut u64, 0)
        if want != seen {
            seen = want
            thread_blocking_out()
            camjob.job_entry((&(*a).job) as u64)
            thread_blocking_an()
        } else {
            usleep(20000 as u32)
        }
    }
    return 0
}

// UI side of a finished job: save, release, report
fn poll_job(a: *mut App) {
    if !(*a).busy { return }
    if (*a).stage == 1 { step_capture(a); return }
    if !camjob.job_finished(&(*a).job) { return }
    var name: [u8; 48] = [0 as u8; 48]
    if (*a).job.ok {
        name_into((&name[0]) as u64, "IMG_", ".jpg")
        let mime: str = "image/jpeg\0"
        let r: i32 = camera.camera_save((*a).job.out, (*a).job.out_n, (&name[0]) as u64, mime.p as u64)
        if (*a).job.have_pdf {
            var pn: [u8; 48] = [0 as u8; 48]
            name_into((&pn[0]) as u64, "SCAN_", ".pdf")
            let pm: str = "application/pdf\0"
            camera.camera_save_doc(rt.buf_ptr(&(*a).job.pdf), rt.buf_len(&(*a).job.pdf), (&pn[0]) as u64, pm.p as u64)
        }
        (*a).shots = (*a).shots + 1
        report(a, r, "SAVED", "SAVED PRIVATE")
    } else {
        set_status(a, "PROCESSING FAILED")
    }
    camjob.job_free(&(*a).job)
    release_capture(a)
    (*a).stage = 0
    (*a).busy = false
}

// plain single frame: RAW -> DNG, manual photo, or a photo with flash (one frame fires the flash)
fn plain_shot(a: *mut App) -> bool {
    let m: i32 = (*a).mode
    return m == M_RAW || (m == M_PHOTO && ((*a).manual || (*a).flash > 0))
}

fn shoot(a: *mut App) {
    if (*a).busy { return }
    if plain_shot(a) { shoot_plain(a); return }
    start_job(a)
}

fn toggle_video(a: *mut App) {
    if !(*a).ready || (*a).info.vid_w <= 0 { return }
    if (*a).recording {
        let ok: bool = camera.camera_video_stop()
        (*a).recording = false
        open_lens(a, (*a).lens)
        if ok { commit_thumb(a) }
        if ok { set_status(a, "VIDEO SAVED") } else { set_status(a, "VIDEO FAILED") }
        return
    }
    snap_thumb(a)
    var name: [u8; 48] = [0 as u8; 48]
    name_into((&name[0]) as u64, "VID_", ".mp4")
    let r: i32 = camera.camera_video_start((&name[0]) as u64)
    if r == camera.E_OK {
        (*a).recording = true
        set_status(a, "RECORDING")
    } else {
        set_status(a, "VIDEO START FAILED")
        open_lens(a, (*a).lens)
    }
}

// ---------------------------------------------------------------- flash
// The camera flash mode for the user's choice and the current mode. The flash fires for single frames only
// (photo, RAW); in VIDEO "on" is the torch; every other mode keeps it off.
fn apply_flash(a: *mut App) -> i32 {
    if !(*a).ready { return camera.E_STATE }
    var m: i32 = camera.FLASH_OFF
    let md: i32 = (*a).mode
    if md == M_PHOTO || md == M_RAW {
        if (*a).flash == 1 { m = camera.FLASH_AUTO } else if (*a).flash == 2 { m = camera.FLASH_ON }
    } else if md == M_VIDEO && (*a).flash == 2 {
        m = camera.FLASH_TORCH
    }
    if m == (*a).fl_last { return camera.E_OK }
    if m == camera.FLASH_OFF && (*a).fl_last < 0 { (*a).fl_last = camera.FLASH_OFF; return camera.E_OK }
    let e: i32 = camera.camera_set_flash(m)
    if e == camera.E_OK { (*a).fl_last = m }
    return e
}

// ---------------------------------------------------------------- thumbnails
const THUMB: i32 = 128
const THUMB_BYTES: usize = 128 * 128 * 4

fn copy_bytes(dst: u64, src: u64, n: usize) {
    var o: usize = 0
    while o + 8 <= n {
        *((dst + o as u64) as *mut u64) = *((src + o as u64) as *mut u64)
        o = o + 8
    }
}

// the picture of the shutter press becomes the "last photo" only when it was saved
fn snap_thumb(a: *mut App) {
    (*a).have_s = false
    if (*a).have_p && (*a).sthumb != 0 && (*a).pthumb != 0 {
        copy_bytes((*a).sthumb, (*a).pthumb, THUMB_BYTES)
        (*a).have_s = true
    }
}

fn commit_thumb(a: *mut App) {
    if (*a).have_s && (*a).thumb != 0 && (*a).sthumb != 0 {
        copy_bytes((*a).thumb, (*a).sthumb, THUMB_BYTES)
        (*a).tkey = (*a).tkey + 1
        (*a).have_thumb = true
        (*a).have_s = false
    }
}

// ---------------------------------------------------------------- lenses
// Lens facts of the scan list (facing, 35 mm equivalent) and the main lens of each facing (nearest to 26 mm).
fn scan_lenses(a: *mut App) {
    var i: i32 = 0
    (*a).main_lens = [0 - 1, 0 - 1, 0 - 1]
    var best: [f32; 3] = [1000.0f; 3]
    var tmp: camera.CamInfo = camera.zero_info()
    while i < (*a).nlens && i < 16 {
        (*a).lfac[i as usize] = 0 - 1
        (*a).lmm[i as usize] = 0.0f
        if camera.camera_info(i, &tmp) {
            (*a).lfac[i as usize] = tmp.facing
            (*a).lmm[i as usize] = tmp.equiv_mm
            let f: i32 = tmp.facing
            if f >= 0 && f < 3 {
                var d: f32 = tmp.equiv_mm - 26.0f
                if tmp.equiv_mm <= 0.0f { d = 500.0f }
                if d < 0.0f { d = 0.0f - d }
                if d < best[f as usize] {
                    best[f as usize] = d
                    (*a).main_lens[f as usize] = i
                }
            }
        }
        i = i + 1
    }
    (*a).can_flip = (*a).main_lens[0] >= 0 && (*a).main_lens[1] >= 0
}

// Zoom chips of the open camera: the lens factors (0.6x ultra wide, 1x main, tele when the app can see it) plus digital
// stops (2x, 5x, ...) as far as the zoom range of the camera reaches. A tap picks the lens / the ratio (C_STOP).
fn rebuild_chips(a: *mut App) {
    (*a).nchip = 0
    (*a).foc1 = 0.0f
    (*a).ph1[0] = 0 as u8
    var ox: [i32; 8] = [0; 8]
    var oo: [i32; 8] = [0; 8]
    let n: i32 = camera.camera_zoom_stops((&ox[0]) as u64, (&oo[0]) as u64, 6)
    var i: i32 = 0
    while i < n && i < 6 {
        (*a).chip_x10[i as usize] = ox[i as usize]
        (*a).chip_opt[i as usize] = oo[i as usize]
        i = i + 1
    }
    var cnt: i32 = i
    // a tele lens the id list hides but the service switches to (seen by the sweep): an optical stop at its switch zoom
    if (*a).learn_x10 > 0 && (*a).lens == (*a).learn_lens {
        cnt = focusplan.learned_stop((&(*a).chip_x10[0]) as u64, (&(*a).chip_opt[0]) as u64, cnt, 6, (*a).learn_x10)
    }
    i = 0
    while i < cnt { (*a).chip_idx[i as usize] = (*a).lens; i = i + 1 }
    (*a).nchip = cnt
}

// ---------------------------------------------------------------- diagnostics
fn put_f10(dst: u64, v: f32) -> usize {
    return put_int(dst, ((v * 10.0f) + 0.5f) as i64)
}

fn same16(x: *mut [u8; 16], y: *mut [u8; 16]) -> bool {
    var i: usize = 0
    while i < 16 {
        if (*x)[i] != (*y)[i] { return false }
        if (*x)[i] == 0 as u8 { return true }
        i = i + 1
    }
    return true
}

fn put_hex(dst: u64, v: u32) -> usize {
    var i: usize = 0
    var sh: i32 = 28
    var started: bool = false
    while sh >= 0 {
        let d: u32 = (v / pow16(sh)) % (16 as u32)
        if d != (0 as u32) || started || sh == 0 {
            started = true
            *((dst + i as u64) as *mut u8) = (if d < (10 as u32) { 48 + d } else { 87 + d }) as u8
            i = i + 1
        }
        sh = sh - 4
    }
    return i
}

fn pow16(sh: i32) -> u32 {
    var r: u32 = 1
    var k: i32 = 0
    while k < sh { r = r * (2 as u32); k = k + 1 }
    return r
}

// Waits until the newest capture result reports zoom ratio z (max 700 ms), then for `frames` more results (max 700 ms).
fn wait_zoom(z: f32, frames: i64) {
    var waited: i32 = 0
    while waited < 700 {
        let r: f32 = camera.camera_applied_zoom()
        if r > z * 0.98f && r < z * 1.02f { break }
        usleep(20000 as u32)
        waited = waited + 20
    }
    let c0: i64 = camera.camera_result_count()
    waited = 0
    while waited < 700 && camera.camera_result_count() < c0 + frames {
        usleep(20000 as u32)
        waited = waited + 20
    }
}

// Sets the zoom ratio z10/10 on the open lens, waits for the service to apply it, and logs what the capture result says
// (focal length, ACTIVE_PHYSICAL_ID, crop width) into sweep slot `slot`.
fn sweep_set(a: *mut App, slot: i32, z10: i32) {
    let z: f32 = (z10 as f32) / 10.0f
    let e: i32 = camera.camera_set_zoom(z)
    wait_zoom(z, 8)
    let sl: usize = slot as usize
    (*a).sw_z[sl] = z10
    (*a).sw_f[sl] = (camera.camera_active_focal() * 100.0f + 0.5f) as i32
    let pn: usize = camera.camera_result_phys((&(*a).sw_ph[sl][0]) as u64)
    var cr: [i32; 4] = [0; 4]
    camera.camera_result_crop((&cr[0]) as u64)
    (*a).sw_cw[sl] = cr[2]
    if slot >= (*a).sw_n { (*a).sw_n = slot + 1 }
}

// True when sweep slot `slot` shows another physical lens than slot 0 (zoom 1): a different ACTIVE_PHYSICAL_ID, or a
// focal length more than 8 % off.
fn sweep_differs(a: *mut App, slot: i32) -> bool {
    let sl: usize = slot as usize
    if (*a).sw_ph[sl][0] != 0 as u8 && (*a).sw_ph[0][0] != 0 as u8 && !same16(&(*a).sw_ph[sl], &(*a).sw_ph[0]) { return true }
    let f0: i32 = (*a).sw_f[0]
    let f1: i32 = (*a).sw_f[sl]
    if f0 > 0 && f1 > 0 {
        var d: i32 = f1 - f0
        if d < 0 { d = 0 - d }
        if d * 100 > 8 * f0 { return true }
    }
    return false
}

// Once per run, on the back logical camera: finds out whether the camera SERVICE switches to another physical lens (a tele
// that the id list hides) at higher zoom. Steps 1x, 2x, 3x, 5x, 8x; at the first step that shows another lens a bisection
// down to 0.1x finds the switch zoom (a.learn_x10 -> an optical chip, r641). Restores zoom 1 at the end. ~3 s, blocks the UI.
fn sweep_zoom(a: *mut App) {
    if (*a).swept || !(*a).ready { return }
    (*a).swept = true
    if (*a).info.facing != 1 || ((*a).info.caps & camera.CAP_LOGICAL) == 0 as u32 { return }
    var zmin: f32 = 0.0f
    var zmax: f32 = 0.0f
    camera.camera_zoom_range(&zmin, &zmax)
    if zmax < 2.0f { return }
    (*a).sw_n = 0
    sweep_set(a, 0, 10)
    var coarse: [i32; 6] = [20, 30, 50, 80, 100, 0]
    var slot: i32 = 1
    var same_z: i32 = 10
    var diff_z: i32 = 0
    var i: usize = 0
    while coarse[i] > 0 && slot < 14 {
        if (coarse[i] as f32) > zmax * 10.0f + 0.5f { break }
        sweep_set(a, slot, coarse[i])
        if sweep_differs(a, slot) { diff_z = coarse[i]; slot = slot + 1; break }
        same_z = coarse[i]
        slot = slot + 1
        i = i + 1
    }
    if diff_z > 0 {
        var guard: i32 = 0
        while guard < 6 && slot < 16 {
            let m: i32 = focusplan.switch_between(same_z, diff_z)
            if m == 0 { break }
            sweep_set(a, slot, m)
            if sweep_differs(a, slot) { diff_z = m } else { same_z = m }
            slot = slot + 1
            guard = guard + 1
        }
        (*a).learn_x10 = diff_z
        (*a).learn_lens = (*a).lens
    }
    let e: i32 = camera.camera_set_zoom(1.0f)
    (*a).zr = 1.0f
    wait_zoom(1.0f, 4)
    (*a).foc1 = 0.0f
    (*a).ph1[0] = 0 as u8
}

// Appends "word=" and a number.
fn put_kv(dst: u64, k: str, v: i64) -> usize {
    var n: usize = put_str(dst, k)
    n = n + put_int(dst + n as u64, v)
    return n
}

// Writes what the app sees of the cameras to Download/FirnCam/firncam-cameras<ts>.txt (no adb needed):
//  cam    every scan entry (public id or physical id of a logical camera): focal lengths (x10 mm), 35 mm equivalents, sizes
//  probe  getCameraCharacteristics on ids 0..19, listed or not (error codes shown): hidden physical cameras, caps, max-res
//  sweep  the zoom sweep: focal length / ACTIVE_PHYSICAL_ID / crop width per zoom step (does the service switch to a tele?)
//  tags   characteristics tags of the sensor / scaler / logical-camera / vendor sections of each scan entry (tag:type:count:value)
//  open   the zoom range and chip row of the open camera, the learned tele switch
fn save_cam_dump(a: *mut App) {
    var buf: [u8; 20000] = [0 as u8; 20000]
    let p: u64 = (&buf[0]) as u64
    var n: usize = 0
    n = n + put_str(p + n as u64, "firncam 0.6 dump\n")
    var i: i32 = 0
    var id: [u8; 48] = [0 as u8; 48]
    while i < (*a).nlens && i < 16 && n < 3400 {
        let par: i32 = camera.camera_entry_id(i, (&id[0]) as u64)
        n = n + put_str(p + n as u64, "cam ")
        n = n + put_int(p + n as u64, i as i64)
        n = n + put_str(p + n as u64, " id=")
        var k: usize = 0
        while k < 40 && id[k] != 0 as u8 { *((p + n as u64) as *mut u8) = id[k]; n = n + 1; k = k + 1 }
        n = n + put_kv(p + n as u64, " parent=", par as i64)
        var ci: camera.CamInfo = camera.zero_info()
        if camera.camera_info(i, &ci) {
            n = n + put_kv(p + n as u64, " facing=", ci.facing as i64)
            n = n + put_kv(p + n as u64, " logical=", if (ci.caps & camera.CAP_LOGICAL) != 0 as u32 { 1 } else { 0 })
            n = n + put_str(p + n as u64, " focal_x10=")
            n = n + put_f10(p + n as u64, ci.focal_mm)
            n = n + put_kv(p + n as u64, " nfocal=", ci.focal_count as i64)
            n = n + put_str(p + n as u64, " equiv_x10=")
            n = n + put_f10(p + n as u64, ci.equiv_mm)
            n = n + put_kv(p + n as u64, " preview=", ci.prev_w as i64)
            n = n + put_kv(p + n as u64, " raw=", ci.raw_w as i64)
        } else {
            n = n + put_str(p + n as u64, " UNREADABLE (hidden physical id, no characteristics for apps)")
        }
        *((p + n as u64) as *mut u8) = 10 as u8
        n = n + 1
        i = i + 1
    }
    // probe every small id number: a physical camera the id list does not show may still answer
    var pr: [i32; 16] = [0; 16]
    i = 0
    while i < 20 && n < 7000 {
        let rc: i32 = camera.camera_probe_id(i, (&pr[0]) as u64)
        n = n + put_kv(p + n as u64, "probe id=", i as i64)
        n = n + put_kv(p + n as u64, " rc=", rc as i64)
        if rc == 0 {
            n = n + put_kv(p + n as u64, " facing=", pr[1] as i64)
            n = n + put_kv(p + n as u64, " hw=", pr[2] as i64)
            n = n + put_kv(p + n as u64, " caps=", pr[3] as i64)
            n = n + put_str(p + n as u64, "(1raw 2man 4logical 8ultrahires 16burst)")
            n = n + put_kv(p + n as u64, " focal_x100=", pr[4] as i64)
            n = n + put_kv(p + n as u64, " nfocal=", pr[5] as i64)
            n = n + put_kv(p + n as u64, " jpeg=", pr[6] as i64)
            n = n + put_kv(p + n as u64, "x", pr[7] as i64)
            n = n + put_kv(p + n as u64, " raw=", pr[8] as i64)
            n = n + put_kv(p + n as u64, "x", pr[9] as i64)
            n = n + put_kv(p + n as u64, " active=", pr[10] as i64)
            n = n + put_kv(p + n as u64, "x", pr[11] as i64)
            n = n + put_kv(p + n as u64, " maxres=", pr[12] as i64)
            n = n + put_kv(p + n as u64, "x", pr[13] as i64)
            n = n + put_kv(p + n as u64, " sync=", pr[14] as i64)
            n = n + put_kv(p + n as u64, " physbytes=", pr[15] as i64)
        }
        *((p + n as u64) as *mut u8) = 10 as u8
        n = n + 1
        i = i + 1
    }
    n = n + put_str(p + n as u64, "concurrent_camera_ids: not readable from the NDK (Java-only API)\n")
    // the zoom sweep
    i = 0
    while i < (*a).sw_n && i < 16 {
        n = n + put_kv(p + n as u64, "sweep z_x10=", (*a).sw_z[i as usize] as i64)
        n = n + put_kv(p + n as u64, " focal_x100=", (*a).sw_f[i as usize] as i64)
        n = n + put_str(p + n as u64, " active_phys=")
        var k: usize = 0
        while k < 15 && (*a).sw_ph[i as usize][k] != 0 as u8 { *((p + n as u64) as *mut u8) = (*a).sw_ph[i as usize][k]; n = n + 1; k = k + 1 }
        n = n + put_kv(p + n as u64, " crop_w=", (*a).sw_cw[i as usize] as i64)
        *((p + n as u64) as *mut u8) = 10 as u8
        n = n + 1
        i = i + 1
    }
    n = n + put_kv(p + n as u64, "learned_switch_x10=", (*a).learn_x10 as i64)
    n = n + put_kv(p + n as u64, " on_lens=", (*a).learn_lens as i64)
    *((p + n as u64) as *mut u8) = 10 as u8
    n = n + 1
    // tags of each scan entry: sections 13 scaler, 15 sensor info, 26 logical camera, >= 0x80000000 vendor
    var tg: [i32; 1024] = [0; 1024]
    var e: i32 = 0
    while e < (*a).nlens && e < 8 && n < 18000 {
        let nt: i32 = camera.camera_tags(e, (&tg[0]) as u64, 256)
        n = n + put_kv(p + n as u64, "tags cam=", e as i64)
        n = n + put_kv(p + n as u64, " total=", nt as i64)
        n = n + put_str(p + n as u64, ":")
        var j: i32 = 0
        while j < nt && n < 19500 {
            let tag: u32 = *((&tg[(j * 4) as usize]) as *mut u32)
            let sec: u32 = tag / (65536 as u32)
            if sec == (13 as u32) || sec == (15 as u32) || sec == (26 as u32) || tag >= (2147483648 as u32) {
                n = n + put_str(p + n as u64, " ")
                n = n + put_hex(p + n as u64, tag)
                n = n + put_kv(p + n as u64, ":", tg[(j * 4 + 1) as usize] as i64)
                n = n + put_kv(p + n as u64, ":", tg[(j * 4 + 2) as usize] as i64)
                n = n + put_kv(p + n as u64, ":", tg[(j * 4 + 3) as usize] as i64)
            }
            j = j + 1
        }
        *((p + n as u64) as *mut u8) = 10 as u8
        n = n + 1
        e = e + 1
    }
    var zmin: f32 = 0.0f
    var zmax: f32 = 0.0f
    camera.camera_zoom_range(&zmin, &zmax)
    n = n + put_kv(p + n as u64, "open lens=", (*a).lens as i64)
    n = n + put_str(p + n as u64, " zoom_range_x10=")
    n = n + put_f10(p + n as u64, zmin)
    n = n + put_str(p + n as u64, "..")
    n = n + put_f10(p + n as u64, zmax)
    n = n + put_str(p + n as u64, " chips=")
    i = 0
    while i < (*a).nchip {
        n = n + put_int(p + n as u64, (*a).chip_x10[i as usize] as i64)
        if (*a).chip_opt[i as usize] == 1 { n = n + put_str(p + n as u64, "o ") } else { n = n + put_str(p + n as u64, "d ") }
        i = i + 1
    }
    *((p + n as u64) as *mut u8) = 10 as u8
    n = n + 1
    var name: [u8; 48] = [0 as u8; 48]
    let nn: usize = name_into((&name[0]) as u64, "firncam-cameras", ".txt")
    let mime: str = "text/plain\0"
    let r: i32 = camera.camera_save_doc(p, n, (&name[0]) as u64, mime.p as u64)
}

// ---------------------------------------------------------------- state -> UI
fn put_str(dst: u64, s: str) -> usize {
    var i: usize = 0
    while i < s.n { *((dst + i as u64) as *mut u8) = *((s.p as u64 + i as u64) as *mut u8); i = i + 1 }
    return s.n
}

// the label of a manual row (max 23 octets)
fn row_text(a: *mut App, kind: i32, dst: *mut [u8; 24]) -> usize {
    let p: u64 = (&(*dst)[0]) as u64
    var ln: usize = 0
    if kind == 0 {
        ln = put_str(p, "ISO ")
        ln = ln + put_int(p + ln as u64, man_iso(a) as i64)
    } else if kind == 1 {
        ln = put_str(p, "1/")
        let e: i64 = man_exp(a)
        var d: i64 = 1000000000 / (if e > 0 { e } else { 1 })
        if d < 1 { d = 1 }
        ln = ln + put_int(p + ln as u64, d)
        ln = ln + put_str(p + ln as u64, " S")
    } else {
        let fd: f32 = man_focus(a)
        if fd < 0.05f {
            ln = put_str(p, "FOCUS INF")
        } else {
            ln = put_str(p, "FOCUS ")
            ln = ln + put_int(p + ln as u64, (100.0f / fd) as i64)
            ln = ln + put_str(p + ln as u64, " CM")
        }
    }
    return ln
}

// 0 = at 1x / unknown, 1 = the picture is a digital crop, 2 = another lens serves the zoom (optical). A logical camera
// that switches its physical lens reports that lens's focal length in every result; the one seen at ratio 1 is the base.
fn zoom_mode(a: *mut App) -> i32 {
    if !(*a).ready { return 0 }
    let f: f32 = camera.camera_active_focal()
    let r: f32 = camera.camera_get_zoom()
    if f > 0.0f && (*a).foc1 <= 0.0f && r > 0.98f && r < 1.02f { (*a).foc1 = f }
    if r > 0.98f && r < 1.02f && (*a).ph1[0] == 0 as u8 { let q0: usize = camera.camera_result_phys((&(*a).ph1[0]) as u64) }
    let zf: f32 = camera.camera_zoom_factor()
    if zf > 0.95f && zf < 1.05f { return 0 }
    if zf < 0.95f { return 2 }
    var ph: [u8; 16] = [0 as u8; 16]
    let pn: usize = camera.camera_result_phys((&ph[0]) as u64)
    if pn > 0 && (*a).ph1[0] != 0 as u8 && !same16(&ph, &(*a).ph1) { return 2 }
    if f > 0.0f && (*a).foc1 > 0.0f {
        let q: f32 = f / (*a).foc1
        if q > 1.15f || q < 0.87f { return 2 }
    }
    if r <= 1.05f { return 2 }
    return 1
}

fn sync_ui(a: *mut App, u: *mut ui.Ui) {
    var vis: [i32; 8] = [0; 8]
    let nv: i32 = visible(a, &vis)
    var i: i32 = 0
    while i < nv { (*u).modes[i as usize] = vis[i as usize]; i = i + 1 }
    (*u).nmodes = nv
    (*u).mode = (*a).mode
    (*u).man_ok = man_ok(a) && (*a).ready
    (*u).manual = (*a).manual && (*a).ready
    var rows: [i32; 3] = [0; 3]
    let nr: i32 = if (*a).ready { rows_of(a, &rows) } else { 0 }
    (*u).nrows = nr
    i = 0
    while i < nr {
        (*u).rows[i as usize] = rows[i as usize]
        (*u).row_n[i as usize] = row_text(a, rows[i as usize], &(*u).row_txt[i as usize])
        i = i + 1
    }
    i = 0
    (*u).nchips = (*a).nchip
    while i < (*a).nchip {
        (*u).chips[i as usize].idx = (*a).chip_idx[i as usize]
        (*u).chips[i as usize].x10 = (*a).chip_x10[i as usize]
        (*u).chips[i as usize].opt = (*a).chip_opt[i as usize]
        (*u).chips[i as usize].sel = false
        i = i + 1
    }
    (*u).can_flip = (*a).can_flip
    (*u).busy = (*a).busy
    (*u).recording = (*a).recording
    if (*a).busy {
        (*u).progress = camjob.job_progress(&(*a).job) as i32
    } else {
        (*u).progress = 0
    }
    if (*a).have_thumb {
        (*u).thumb_px = (*a).thumb
        (*u).thumb_w = THUMB
        (*u).thumb_h = THUMB
        (*u).thumb_key = (*a).tkey
    }
    if (*a).st_new {
        (*a).st_new = false
        ui.ui_status(u, status_str(a))
    }
}

// ---------------------------------------------------------------- commands from the UI
// Tap on the preview (fx, fy in 0..1 of the preview rectangle) -> point of the upright sensor picture.
fn do_focus(a: *mut App, fx: f64, fy: f64, pvw: i32, pvh: i32) {
    if !(*a).ready || (*a).recording { return }
    var sw: i32 = 0
    var sh: i32 = 0
    camera.camera_stream_size(1, &sw, &sh)
    if sw <= 0 || sh <= 0 { return }
    let front: bool = camera.camera_is_front()
    let sens: i32 = camera.camera_sensor_rotation()
    let rot: i32 = campreview.cp_rotation(sens, (*a).disp, front)
    var pl: campreview.Plan = campreview.Plan { crop: [0.0; 4], m: [0.0; 4], t: [0.0; 2], quad: [1.0; 2], rot: 0 }
    campreview.cp_plan(sw, sh, rot, front, pvw, pvh, true, &pl)
    var sx: f64 = 0.0
    var sy: f64 = 0.0
    campreview.cp_map(&pl, fx, fy, &sx, &sy)
    // sensor point -> the picture rotated by the lens orientation only (what camera_focus_at takes; no mirror)
    var up: campreview.Plan = campreview.Plan { crop: [0.0; 4], m: [0.0; 4], t: [0.0; 2], quad: [1.0; 2], rot: 0 }
    campreview.cp_plan(sw, sh, sens, false, 1, 1, true, &up)
    let dx: f64 = sx - up.t[0]
    let dy: f64 = sy - up.t[1]
    let nx: f64 = up.m[0] * dx + up.m[2] * dy
    let ny: f64 = up.m[1] * dx + up.m[3] * dy
    let e: i32 = camera.camera_focus_at(nx as f32, ny as f32, false, true)
    if e == camera.E_UNSUPPORTED { set_status(a, "NO AUTOFOCUS") }
}

// Pinch / double tap: zoom in the user scale (1.0 = main lens). The camera zooms (ratio, lens choice); only when
// it cannot, the preview shader crops digitally. After a real zoom the shader zoom stays at 1.
fn do_zoom(a: *mut App, cv: *mut camview.CamView, z: f64) {
    if !(*a).ready {
        camview.camview_zoom(cv, z)
        return
    }
    var ratio: f32 = z as f32
    let lens: i32 = camera.camera_zoom_lens(z as f32, &ratio)
    (*a).zr = ratio
    if lens >= 0 && lens != (*a).lens && lens < 16 && (*a).lfac[lens as usize] == (*a).info.facing && !(*a).recording && !(*a).busy {
        open_lens(a, lens)
    }
    let e: i32 = camera.camera_set_zoom(ratio)
    if e == camera.E_OK {
        (*a).zr = ratio
        camview.camview_zoom(cv, 1.0)
        // crossing 1.05x changes the still stream kind (RAW burst <-> JPEG): rebuild the session, keep the ratio
        if (*a).ready && want_kind(a) != (*a).kind && !(*a).recording && !(*a).busy {
            let keep: f32 = camera.camera_get_zoom()
            open_lens(a, (*a).lens)
            let e2: i32 = camera.camera_set_zoom(keep)
            (*a).zr = keep
        }
    } else {
        camview.camview_zoom(cv, z)
    }
}

fn reset_zoom(a: *mut App, u: *mut ui.Ui, cv: *mut camview.CamView) {
    camview.camview_zoom(cv, 1.0)
    var z: f64 = 1.0
    if (*a).ready { z = camera.camera_zoom_factor() as f64 }
    ui.ui_set_zoom(u, z)
}

fn change_mode(a: *mut App, nm: i32) {
    if nm == (*a).mode { return }
    (*a).mode = nm
    if !man_ok(a) { (*a).manual = false }
    if want_kind(a) != (*a).kind || nm == M_VIDEO || (*a).fl_last > 0 {
        open_lens(a, (*a).lens)
    } else {
        apply_manual(a)
        let fe: i32 = apply_flash(a)
    }
}

fn flip_lens(a: *mut App) {
    let want: i32 = if (*a).info.facing == 1 { 0 } else { 1 }
    let idx: i32 = (*a).main_lens[want as usize]
    if idx >= 0 { open_lens(a, idx) }
}

fn run_cmd(a: *mut App, u: *mut ui.Ui, cv: *mut camview.CamView, c: *mut ui.Cmd, pvw: i32, pvh: i32) {
    let k: i32 = (*c).kind
    if k == ui.C_SHOT {
        if (*a).mode == M_VIDEO {
            toggle_video(a)
        } else if !(*a).recording && !(*a).busy {
            snap_thumb(a)
            shoot(a)
        }
    } else if k == ui.C_MODE {
        if !(*a).recording && !(*a).busy {
            change_mode(a, (*c).a)
            reset_zoom(a, u, cv)
        }
    } else if k == ui.C_LENS {
        if !(*a).recording && !(*a).busy && (*c).a >= 0 && (*c).a < (*a).nlens {
            open_lens(a, (*c).a)
            reset_zoom(a, u, cv)
        }
    } else if k == ui.C_STOP {
        if !(*a).busy {
            let sz: f64 = ((*c).a as f64) / 10.0
            do_zoom(a, cv, sz)
            ui.ui_set_zoom(u, sz)
        }
    } else if k == ui.C_FLIP {
        if !(*a).recording && !(*a).busy {
            flip_lens(a)
            reset_zoom(a, u, cv)
        }
    } else if k == ui.C_FLASH {
        (*a).flash = (*c).a
        if want_kind(a) != (*a).kind && !(*a).recording && !(*a).busy {
            open_lens(a, (*a).lens)
        } else {
            let e: i32 = apply_flash(a)
            if e == camera.E_UNSUPPORTED {
                (*a).flash = 0
                (*u).flash = 0
                (*a).fl_last = camera.FLASH_OFF
                set_status(a, "NO FLASH")
            }
        }
    } else if k == ui.C_MAN {
        if !(*a).recording && !(*a).busy && man_ok(a) {
            (*a).manual = !(*a).manual
            if (*a).manual {
                if want_kind(a) != (*a).kind { open_lens(a, (*a).lens) } else { apply_manual(a) }
            } else if want_kind(a) != (*a).kind {
                open_lens(a, (*a).lens)
            } else {
                let e: i32 = camera.camera_set_auto()
            }
        }
    } else if k == ui.C_SLIDER {
        if (*c).a >= 0 && (*c).a < 3 {
            (*a).sl[(*c).a as usize] = (*c).b
            (*a).pend_sl[(*c).a as usize] = (*c).b
        }
    } else if k == ui.C_ZOOM {
        (*a).pend_zoom = (*c).f
    } else if k == ui.C_FOCUS {
        do_focus(a, (*c).f, (*c).g, pvw, pvh)
    } else if k == ui.C_GALLERY {
        if !camera.camera_open_gallery() { set_status(a, "NO GALLERY APP") }
    }
}

// ---------------------------------------------------------------- log (adb logcat -s firncam)
#[no_gc]
#[link_name(__android_log_write)]
extern fn log_write(prio: i32, tag: u64, text: u64) -> i32;

#[link_name(__system_property_get)]
extern fn sys_prop_get(name: u64, value: u64) -> i32;

// `adb shell setprop debug.firncam.cpu 1` forces the CPU preview path (test of the no-GPU fallback).
fn cpu_forced() -> bool {
    var v: [u8; 96] = [0 as u8; 96]
    let name: str = "debug.firncam.cpu\0"
    let n: i32 = sys_prop_get(name.p as u64, (&v[0]) as u64)
    return n > 0 && v[0] == 49 as u8
}

fn log_stats(ui_n: i64, cam_n: i64, ms: i64, w: i32, h: i32, rot: i32, gpu: bool) {
    var b: [u8; 128] = [0 as u8; 128]
    let p: u64 = (&b[0]) as u64
    var n: usize = put_str(p, "ui_fps=")
    n = n + put_int(p + n as u64, ui_n * 1000 / ms)
    n = n + put_str(p + n as u64, " cam_fps=")
    n = n + put_int(p + n as u64, cam_n * 1000 / ms)
    n = n + put_str(p + n as u64, " preview=")
    n = n + put_int(p + n as u64, w as i64)
    n = n + put_str(p + n as u64, "x")
    n = n + put_int(p + n as u64, h as i64)
    n = n + put_str(p + n as u64, " rot=")
    n = n + put_int(p + n as u64, rot as i64)
    if gpu { n = n + put_str(p + n as u64, " gpu") } else { n = n + put_str(p + n as u64, " cpu") }
    let tag: str = "firncam\0"
    let r: i32 = log_write(4, tag.p as u64, p)
}

fn display_deg() -> i32 {
    let d: i32 = display.display_rotation()
    if d < 0 { return 0 }
    return d
}

#[allow_escape]
fn main() -> i32 {
    var s: fuishell.Shell = fuishell.shell_new()
    if !fuishell.shell_open(&s, "FirnCam", 480, 800) { return 1 }
    let f: *mut window.Window = fuishell.shell_window(&s)
    let nthreads: u64 = par.init(3) // pool workers are raw-clone threads; the runtime keeps bionic's thread pointer

    var a: App = App {
        nlens: 0, lens: 0, mode: M_PHOTO, manual: false, sl: [500, 500, 0], kind: 0, ready: false,
        status: [0 as u8; 64], st_new: false, info: camera.zero_info(), shots: 0, recording: false,
        job: camjob.job_new(), busy: false, th: 0, cbuf: 0, ccap: 0, fbuf: 0, stamp0: 0, tattr: [0; 16], ttid: 0, wreq: 0,
        stage: 0, cap_n: 0, cap_i: 0, cap_at: 0, steps: [0.0f; 16], bs: [0; 16],
        flash: 0, fl_last: 0 - 1, disp: 0, thumb: 0, pthumb: 0, sthumb: 0, tkey: 0, have_thumb: false, have_p: false,
        have_s: false, nframe: 0, lfac: [0 - 1; 16], lmm: [0.0f; 16], main_lens: [0 - 1; 3], chip_idx: [0; 6],
        chip_x10: [10; 6], chip_opt: [0; 6], foc1: 0.0f, nchip: 0, learn_x10: 0, learn_lens: 0 - 1, swept: false, sw_n: 0, sw_z: [0; 16], sw_f: [0; 16], sw_cw: [0; 16], sw_ph: [[0 as u8; 16]; 16], ph1: [0 as u8; 16], can_flip: false, cpu: 0, cpu_cap: 0, pend_zoom: 0.0 - 1.0, zr: 1.0f, pend_sl: [0 - 1; 3],
    }
    a.thumb = camera.camera_alloc(THUMB_BYTES)
    a.pthumb = camera.camera_alloc(THUMB_BYTES)
    a.sthumb = camera.camera_alloc(THUMB_BYTES)
    if a.thumb == 0 || a.pthumb == 0 || a.sthumb == 0 { return 2 }
    var u: ui.Ui = ui.ui_new()
    var cv: camview.CamView = camview.camview_new()
    var tg: kittouch.Touch = kittouch.tg_new()
    var pf: camera.PreviewFrame = camera.preview_frame_new()
    var gen: u32 = 0 as u32
    a.disp = display_deg()
    set_status(&a, "NO PERMISSION")
    var asked: bool = false
    var open: bool = true
    var turn: i64 = 0
    var scan_wait: i64 = 0
    var t_log: i64 = fuishell.shell_now_ms()
    var n_ui: i64 = 0
    var n_cam: i64 = 0
    var pvx: i32 = 0
    var pvy: i32 = 0
    var pvw: i32 = 0
    var pvh: i32 = 0
    var rot: i32 = 0
    while open {
        turn = turn + 1
        let now: i64 = fuishell.shell_now_ms()
        if !a.ready && a.nlens == 0 && turn >= scan_wait {
            scan_wait = turn + 60
            if camera.camera_permission() == 1 {
                a.nlens = camera.camera_scan()
                if a.nlens > 0 {
                    scan_lenses(&a)
                    let first: i32 = if a.main_lens[1] >= 0 { a.main_lens[1] } else { 0 }
                    open_lens(&a, first)
                    reset_zoom(&a, &u, &cv)
                    sweep_zoom(&a)
                    rebuild_chips(&a)
                    reset_zoom(&a, &u, &cv)
                    save_cam_dump(&a)
                } else {
                    set_status(&a, "NO CAMERA")
                }
            } else if !asked {
                asked = true
                camera.camera_request_permission()
            }
        }
        poll_job(&a)
        if gen != fuishell.shell_gen(&s) {
            // the GPU was (re)started: the preview's GL objects are new
            gen = fuishell.shell_gen(&s)
            if fuishell.shell_gpu_on(&s) && !cpu_forced() { let go: bool = camview.camview_open(&cv, fuishell.shell_gl(&s)) }
        }
        if turn % 90 == 0 { a.disp = display_deg() }

        // ---- input
        sync_ui(&a, &u)
        ui.ui_prepare(&u, fuishell.shell_w(&s) as i32, fuishell.shell_h(&s) as i32, fuishell.shell_dp(&s), now)
        window.wait_event(f, 8)
        var pr: pointers.Pointer = pointers.ptr_blank()
        while window.next_pointer(f, (&pr) as u64) {
            ui.ui_pointer(&u, &pr)
            kittouch.tg_feed(&tg, &pr)
        }
        var k: u32 = window.next_event(f)
        while k != window.EV_NONE {
            if k == window.EV_CLOSED { open = false }
            if k == window.EV_KEY && window.ev_a(f) == window.K_ESCAPE { open = false }
            if k == window.EV_CONFIGURE {
                if !fuishell.shell_resize(&s) { return 3 }
                a.disp = display_deg()
            }
            k = window.next_event(f)
        }
        let tk: bool = kittouch.tg_tick(&tg, now)
        var ge: kittouch.Gesture = kittouch.gesture_blank()
        while kittouch.tg_next(&tg, &ge) {
            ui.ui_gesture(&u, &ge)
        }
        ui.ui_update(&u)

        // ---- commands (the zoom and the sliders only once per turn: a pinch makes dozens)
        ui.ui_preview_rect(&u, &pvx, &pvy, &pvw, &pvh)
        a.pend_zoom = 0.0 - 1.0
        a.pend_sl = [0 - 1; 3]
        var cm: ui.Cmd = ui.Cmd { kind: 0, a: 0, b: 0, f: 0.0, g: 0.0 }
        while ui.ui_take(&u, &cm) {
            run_cmd(&a, &u, &cv, &cm, pvw, pvh)
        }
        if a.pend_zoom > 0.0 { do_zoom(&a, &cv, a.pend_zoom) }
        if a.pend_sl[0] >= 0 || a.pend_sl[1] >= 0 || a.pend_sl[2] >= 0 { apply_manual(&a) }
        // a lens or mode change may have moved the preview rectangle: ask again
        sync_ui(&a, &u)
        ui.ui_preview_rect(&u, &pvx, &pvy, &pvw, &pvh)

        // ---- the camera picture
        var mirror: bool = false
        if a.ready {
            mirror = camera.camera_is_front()
            rot = campreview.cp_rotation(camera.camera_sensor_rotation(), a.disp, mirror)
            if camview.camview_on(&cv) {
                let got: i32 = camera.camera_preview_acquire(&pf)
                if got == 1 {
                    n_cam = n_cam + 1
                    a.nframe = a.nframe + 1
                    let fed: bool = camview.camview_feed(&cv, pf.w, pf.h, pf.yp, pf.ys, pf.up, pf.vp, pf.us, pf.vs, pf.ups)
                    if a.nframe % 12 == 1 {
                        if camview.camview_thumb(pf.w, pf.h, pf.yp, pf.ys, pf.up, pf.vp, pf.us, pf.vs, pf.ups, rot, mirror, a.pthumb, THUMB, THUMB, 20.0) {
                            a.have_p = true
                        }
                    }
                    camera.camera_preview_release(&pf)
                } else if got < 0 {
                    camera.camera_preview_release(&pf)
                }
            } else if pvw > 0 && pvh > 0 {
                // no GPU: CPU picture of the preview rectangle (BGRX, upright)
                let need: usize = (pvw as usize) * (pvh as usize) * 4
                if a.cpu_cap < need {
                    if a.cpu != 0 { camera.camera_free(a.cpu, a.cpu_cap) }
                    a.cpu = camera.camera_alloc(need)
                    a.cpu_cap = if a.cpu != 0 { need } else { 0 }
                }
                if a.cpu != 0 && camera.camera_preview_bgrx(a.cpu, pvw, pvh, rot, mirror) == 1 {
                    n_cam = n_cam + 1
                    let cp: bool = camview.camview_cpu(&cv, a.cpu, pvw, pvh)
                }
            }
        }
        if camview.camview_on(&cv) && pvw > 0 && pvh > 0 {
            let rr: bool = camview.camview_render(&cv, pvw, pvh, rot, mirror)
        }

        // ---- draw
        fuishell.shell_begin(&s)
        let z: *mut painter.Painter = fuishell.shell_painter(&s)
        painter.painter_clear(z, 0xFF000000 as u32)
        let drawn: bool = camview.camview_draw(&cv, z, fuishell.shell_gpu(&s), pvx as f64, pvy as f64, pvw as f64, pvh as f64)
        ui.ui_draw(&u, z)
        fuishell.shell_end(&s)
        n_ui = n_ui + 1
        if now - t_log >= 3000 {
            log_stats(n_ui, n_cam, now - t_log, pvw, pvh, rot, camview.camview_on(&cv))
            t_log = now
            n_ui = 0
            n_cam = 0
        }
    }
    if a.recording { let okv: bool = camera.camera_video_stop() }
    camera.camera_close()
    par.shutdown()
    fuishell.shell_close(&s)
    return 0
}
