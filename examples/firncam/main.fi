// SPDX-License-Identifier: MPL-2.0
// examples/firncam -- FirnCam app: GPU preview in an immediate-mode fUi screen (examples/firncam/ui.fi), mode bar
// (PHOTO = auto HDR burst, NIGHT, PORTRAIT, DOC scan + PDF, STACK = focus stack, VIDEO, RAW = DNG), manual sliders
// (ISO / exposure / focus), lens chips, flip, flash, tap to focus, zoom. The processing of a shot (photo.camjob:
// merge, tone, bokeh, scan, JPEG encode) runs on a job thread with a progress bar; the result goes to MediaStore.
// Everything about the device comes from the CameraCharacteristics (lib/plat/android/camera.fi).
//   bash tools/android/build.sh examples/firncam/main.fi --camera --name FirnCam --package org.firn.firncam \
//        --icon-res examples/firncam/res     (launcher icon: adaptive + monochrome + PNG fallback, made by
//        python3 -I examples/firncam/res_src/gen_icon.py examples/firncam/res)
//
// Loop (one turn per frame): permission/scan -> job step -> pointers + events -> gestures (kittouch) -> ui_update
// -> commands out of the UI (ui_take) run on the camera -> newest preview frame to the GPU (camview, the reader is
// drained every turn) -> camview_render into the preview rectangle -> painter: camview_draw + ui_draw.
import plat.fuishell
import window.window
import window.pointers
import fui.kittouch
import fui.camview
import fui.painter
import gpu.campreview
import plat.android.camera
import plat.android.display
import plat.android.dngwrite
import photo.meta
import photo.camjob
import photo.focus
import photo.par
import jobs.jobs
import std.rt
import std.math
import android.ndk
import android.activity
import plat.android.focusplan
import ui

// Writes decimal `v` into dst (zero terminated), returns the length.
fn put_int(dst: u64, v: i64) -> usize {
    var tmp: [u8; 24] = [0 as u8; 24]
    var n: usize = 0
    var x: i64 = v
    if x < 0 { x = 0 - x }
    if x == 0 { tmp[0] = 48 as u8; n = 1 }
    while x > 0 {
        tmp[n] = (48 + (x % 10)) as u8
        x = x / 10
        n = n + 1
    }
    var o: usize = 0
    if v < 0 { *(dst as *mut u8) = 45 as u8; o = 1 }
    var i: usize = 0
    while i < n {
        *((dst + (o + i) as u64) as *mut u8) = tmp[n - 1 - i]
        i = i + 1
    }
    *((dst + (o + n) as u64) as *mut u8) = 0 as u8
    return o + n
}

const JOB_KIND: u64 = 77
// Zoom photos: true = RAW burst + digital zoom in photo.camjob (centre window, full resolution demosaic, Lanczos,
// burst merge); false = the camera service crops a JPEG stream (old path). Only a real phone can confirm that the
// RAW stream is NOT cropped by CONTROL_ZOOM_RATIO (Camera2 contract) - if a device crops it, set this to false.
const ZOOM_RAW_CROP: bool = true
const JOB_STACK: usize = 16 * 1024 * 1024 // job thread stack

// The job thread is a bionic pthread that attaches to the Firn runtime (thread_attach): a raw-clone thread of
// thread_start shares bionic's thread pointer and crashes the app on Android.
extern fn pthread_create(tid: u64, attr: u64, start: u64, arg: u64) -> i32;
extern fn usleep(us: u32) -> i32;
extern fn pthread_attr_init(attr: u64) -> i32;
extern fn pthread_attr_setstacksize(attr: u64, n: usize) -> i32;
extern fn pthread_attr_setdetachstate(attr: u64, state: i32) -> i32;
const BUDGET: usize = 400 * 1024 * 1024 // capture buffer budget of one shot

// phases of the UI thread (see the loop-gap log): what ran when a turn of the main loop took long
const P_IDLE: i32 = 0
const P_SCAN: i32 = 1
const P_OPEN: i32 = 2
const P_SWEEP: i32 = 3
const P_DUMP: i32 = 4
const P_CAPTURE: i32 = 5
const P_SAVE: i32 = 6
const P_ZOOM: i32 = 7
const P_CHIPS: i32 = 8
const P_PREVIEW: i32 = 9
const P_DRAW: i32 = 12
const P_UI: i32 = 11 // ui layout / input of the main loop
const P_GL: i32 = 10 // GL context + shaders of the preview (ms on a GPU, seconds on a software GL emulator)
const GAP_WARN_MS: i64 = 100 // a turn of the main loop longer than this is logged

// The camera worker thread (r655): everything that blocks without JNI (session open/close, capture waits, DNG/JPEG encoding,
// burst merge) runs there, ONE operation at a time. JNI calls (permission, MediaStore save, MediaRecorder) stay on the UI
// thread: on x86-64 ART puts its thread pointer into `gs`, which Firn uses for the thread block of an attached thread. The UI thread posts an operation (wop != W_NONE),
// keeps drawing, and finishes it (worker_tick) when the worker is done. While wop != W_NONE the camera belongs to the worker:
// the UI thread only reads the preview, it does not open, close, zoom or re-arm the camera.
const W_NONE: i32 = 0
const W_OPEN: i32 = 1 // close + open + session of lens warg (also after a video stop / failed video start)
const W_SHOT: i32 = 2 // burst capture -> job (merge, encode) -> save
const W_PLAIN: i32 = 3 // one frame -> (DNG) -> save
const W_VSTART: i32 = 4
const W_VSTOP: i32 = 5
// result of an operation (wstat)
const WS_OK: i32 = 0
const WS_NO_INFO: i32 = 1
const WS_OPEN_FAILED: i32 = 2
const WS_SESSION_FAILED: i32 = 3
const WS_NO_MEMORY: i32 = 4
const WS_CAPTURE_FAILED: i32 = 5
const WS_ABORTED: i32 = 6
const WS_PROCESS_FAILED: i32 = 7
const WS_YUV: i32 = 8
const WS_VSTART_FAILED: i32 = 9
const REOPEN_MS: i64 = 1500 // earliest retry of a camera that was lost (app in the background)

const M_PHOTO: i32 = 0
const M_NIGHT: i32 = 1
const M_PORTRAIT: i32 = 2
const M_DOC: i32 = 3
const M_STACK: i32 = 4
const M_VIDEO: i32 = 5
const M_RAW: i32 = 6

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == jobs.WORKER_KIND { return jobs.worker_main(arg) }
    if kind == JOB_KIND { return camjob.job_entry(arg) }
    return 0
}

struct App {
    nlens: i32,
    lens: i32,
    mode: i32,
    manual: bool,
    sl: [i32; 3], // slider positions 0..1000: ISO, exposure, focus
    kind: i32,
    ready: bool,
    status: [u8; 64],
    st_new: bool, // the status text changed (main loop hands it to the UI)
    info: camera.CamInfo,
    shots: i32,
    recording: bool,
    job: camjob.Job,
    busy: bool,
    th: u64,
    cbuf: u64, // capture buffer of the running job
    ccap: usize,
    fbuf: u64, // FrameInfo array of the running job
    stamp0: i64,
    tattr: [u64; 16], // pthread_attr_t
    ttid: u64,
    wreq: u64, // job requests counter the job thread watches
    stage: i32, // 0 idle, 1 capturing (UI thread, one frame per loop), 2 processing (job thread)
    cap_n: i32,
    cap_i: i32,
    cap_at: usize,
    steps: [f32; 16], // focus diopters of a focus stack
    bs: [u64; 16], // start of each captured frame
    flash: i32, // user flash: 0 off, 1 auto, 2 on
    fl_last: i32, // flash mode last given to the camera (camera.FLASH_*), -1 = unknown
    disp: i32, // display rotation in degrees
    thumb: u64, // last saved photo, THUMB x THUMB premultiplied RGBA
    pthumb: u64, // rolling thumbnail of the preview
    sthumb: u64, // snapshot taken when the shutter is pressed
    tkey: u64,
    have_thumb: bool,
    have_p: bool,
    have_s: bool,
    nframe: u64,
    lfac: [i32; 16], // facing of each scanned lens
    lmm: [f32; 16], // 35 mm equivalent of each scanned lens
    main_lens: [i32; 3], // lens nearest 26 mm by facing (0 front, 1 back, 2 external), -1 none
    chip_idx: [i32; 6],
    chip_x10: [i32; 6],
    chip_opt: [i32; 6], // 1 = a lens of that zoom factor exists (optical), 0 = digital crop
    foc1: f32, // focal length (mm) the camera reports at zoom 1 (0 = unknown); another value later = the lens switched
    nchip: i32,
    learn_x10: i32, // zoom x10 at which the camera service was seen to switch to another physical lens (0 = none seen)
    learn_lens: i32, // scan index of the lens the sweep ran on
    swept: bool, // the sweep ran, was cached, or was cancelled: not started again in this run
    sw_n: i32,
    sw_z: [i32; 16], // sweep log: zoom x10, focal x100 mm, crop width, active physical id
    sw_f: [i32; 16],
    sw_cw: [i32; 16],
    sw_ph: [[u8; 16]; 16],
    ph1: [u8; 16], // ACTIVE_PHYSICAL_ID seen at zoom 1 ("" = the device reports none)
    can_flip: bool,
    cpu: u64, // CPU fallback picture (BGRX)
    cpu_cap: usize,
    pend_zoom: f64, // zoom asked this turn (< 0 = none)
    zr: f32, // CONTROL_ZOOM_RATIO of the open lens (camera_open resets it to 1; do_zoom sets it again)
    pend_sl: [i32; 3], // slider values asked this turn (-1 = none)
    phase: i32, // what the UI thread is doing right now (P_*), for the loop-gap log
    ph_t0: i64, // when that section started (ms)
    slow_ms: i64, // the longest section of this turn so far
    slow_phase: i32,
    gap_max: i64, // longest gap between two loop turns since the last stats line (ms)
    gap_phase: i32, // phase of that longest gap
    gap_all: i64, // longest gap since the start
    bt_state: i32, // BT_*: startup work state machine
    bt_at: i64, // earliest time (ms) the next startup step may run
    sw_run: i32, // 1 = the zoom sweep is running
    sw_stage: i32, // 0 first sample, 1 coarse steps, 2 bisection, 3 back to zoom 1
    sw_sub: i32, // 0 set the zoom, 1 wait until applied, 2 wait for results
    sw_z10: i32, // zoom x10 of the current step
    sw_t0: i64,
    sw_c0: i64, // result count when the zoom was applied
    sw_ci: i32,
    sw_same: i32,
    sw_diff: i32,
    sw_guard: i32,
    cache_hit: bool, // the sweep result came from the cache file
    dbuf: u64, // camera dump text under construction
    dn: usize,
    dstage: i32,
    didx: i32,
    wop: i32, // W_*: the operation the worker thread runs (W_NONE = idle). Set by the UI thread before the post.
    wdone: u64, // completed operations (the worker adds 1 after each); wdone == wreq = the worker is idle
    wabort: u64, // 1 = the worker stops the running operation at the next safe point
    warg: i32, // W_OPEN: the lens index
    wstat: i32, // WS_*: how the operation ended
    wsave: i32, // save result (0 failed, 1 MediaStore, 2 private file, -1 nothing saved)
    wtxt: i32, // what was saved: 0 processed JPEG, 1 camera JPEG, 2 DNG
    wres: i32, // video start result
    wseen: i32, // stage the status text shows
    wt0: i64, // when the operation was posted (ms)
    o_keep: f32, // zoom ratio to put back after the open (0 = reset to 1x)
    o_first: bool, // the open is the first one of the run (starts the boot work afterwards)
    defer_lens: i32, // lens to open after the running shot was aborted (-1 none)
    lost_at: i64, // when a lost camera was last reopened
    vok: bool, // video stop result
    wname: [u8; 48], // file name for the worker (video)
    pexp: i64, // plain shot: manual exposure / iso / focus snapshot taken at the shutter press
    piso: i32,
    pfoc: f32,
    phave_e: bool,
    phave_f: bool,
    pflash: bool,
    sbuf: u64, // buffers the worker leaves for the UI thread to save (JNI) and free
    scap: usize,
    sdbuf: u64,
    sdcap: usize,
    sptr: u64,
    sn: usize,
}

fn set_status(a: *mut App, s: str) {
    var i: usize = 0
    while i < s.n && i < 63 {
        (*a).status[i] = *((s.p as u64 + i as u64) as *mut u8)
        i = i + 1
    }
    (*a).status[i] = 0 as u8
    (*a).st_new = true
}

fn status_str(a: *mut App) -> str {
    var n: usize = 0
    while n < 63 && (*a).status[n] != 0 as u8 { n = n + 1 }
    var s: str = ""
    s.p = (&(*a).status[0]) as u64 as *mut u8
    s.n = n
    return s
}

// ---------------------------------------------------------------- what this lens can do
fn has_raw(a: *mut App) -> bool {
    return ((*a).info.caps & camera.CAP_RAW) != 0 as u32 && (*a).info.raw_w > 0
}

fn raw_frame_bytes(a: *mut App) -> usize {
    return ((*a).info.raw_w as usize) * ((*a).info.raw_h as usize) * 2 + 4096
}

// RAW bursts only when at least 3 frames fit the budget (huge sensors fall back to JPEG)
fn raw_burst_ok(a: *mut App) -> bool {
    return has_raw(a) && raw_frame_bytes(a) * 3 <= BUDGET
}

fn has_man_sensor(a: *mut App) -> bool {
    return ((*a).info.caps & camera.CAP_MANUAL_SENSOR) != 0 as u32 && (*a).info.iso_max > 0 && (*a).info.exp_max_ns > 0 as i64
}

fn has_man_focus(a: *mut App) -> bool {
    return ((*a).info.caps & camera.CAP_MANUAL_FOCUS) != 0 as u32 && (*a).info.min_focus_d > 0.0f
}

fn mode_ok(a: *mut App, m: i32) -> bool {
    if m == M_STACK { return has_man_focus(a) && (*a).info.min_focus_d >= 1.0f } // a real focus range, else nothing to stack
    if m == M_VIDEO { return (*a).info.vid_w > 0 }
    if m == M_RAW { return has_raw(a) }
    return true
}

fn man_ok(a: *mut App) -> bool {
    return (has_man_sensor(a) || has_man_focus(a)) && ((*a).mode == M_PHOTO || (*a).mode == M_RAW)
}

// session kind for the current mode / lens
fn want_kind(a: *mut App) -> i32 {
    let m: i32 = (*a).mode
    if m == M_RAW { if has_raw(a) { return camera.KIND_RAW } else { return camera.KIND_JPEG } }
    if m == M_VIDEO { return camera.KIND_JPEG }
    if (*a).manual && m == M_PHOTO { return camera.KIND_JPEG }
    // RAW_SENSOR streams are NOT cropped by SCALER_CROP_REGION / ZOOM_RATIO (Camera2 contract): a zoomed RAW burst
    // would come out at the wide field of view. The JPEG stream is cropped and scaled by the camera service.
    if (*a).zr > 1.05f && m != M_RAW && !ZOOM_RAW_CROP { return camera.KIND_JPEG }
    if (*a).flash > 0 && m == M_PHOTO { return camera.KIND_JPEG } // a flash shot is one frame
    if raw_burst_ok(a) { return camera.KIND_RAW }
    return camera.KIND_JPEG
}

// The camera belongs to the worker thread while an operation runs: nothing here may touch it.
fn locked(a: *mut App) -> bool {
    return (*a).busy || (*a).wop != W_NONE
}

fn worker_abort(a: *mut App) {
    __atomic_add((&(*a).wabort) as *mut u64, 1)
}

fn worker_aborted(a: *mut App) -> bool {
    return __atomic_add((&(*a).wabort) as *mut u64, 0) != (0 as u64)
}

// UI side: closes the running camera and opens lens idx on the worker thread (up to a second or more on a phone). The
// camera is not ready until worker_tick finished it. keep > 0: that zoom ratio is put back afterwards, else zoom 1x.
fn open_lens_keep(a: *mut App, idx: i32, keep: f32) {
    if (*a).wop != W_NONE { return }
    if camera.camera_permission() != 1 { set_status(a, "NO PERMISSION"); return } // JNI: UI thread only (see camera_open_granted)
    sweep_abort(a, false) // the camera is closed below: nothing to restore
    (*a).ready = false
    (*a).warg = idx
    (*a).o_keep = keep
    (*a).wop = W_OPEN
    set_status(a, "OPENING")
    worker_post(a)
}

fn open_lens(a: *mut App, idx: i32) {
    open_lens_keep(a, idx, 0.0f)
}

// worker thread: close, open, session, manual/flash controls, zoom chips
fn work_open(a: *mut App) {
    let idx: i32 = (*a).warg
    (*a).wstat = WS_OK
    thread_blocking_an()
    camera.camera_close()
    var ni: camera.CamInfo = camera.zero_info()
    let got: bool = camera.camera_info(idx, &ni)
    thread_blocking_out()
    if !got { (*a).wstat = WS_NO_INFO; return }
    (*a).info = ni
    (*a).lens = idx
    if !mode_ok(a, (*a).mode) { (*a).mode = M_PHOTO }
    if !man_ok(a) { (*a).manual = false }
    thread_blocking_an()
    let e: i32 = camera.camera_open_granted(idx)
    thread_blocking_out()
    if e != camera.E_OK { (*a).wstat = WS_OPEN_FAILED; return }
    let wk: i32 = want_kind(a)
    thread_blocking_an()
    let s: i32 = camera.camera_start(wk)
    thread_blocking_out()
    if s != camera.E_OK { (*a).wstat = WS_SESSION_FAILED; return }
    (*a).kind = camera.camera_kind()
    (*a).zr = 1.0f // camera_open reset the zoom
    (*a).fl_last = 0 - 1
    if (*a).manual { apply_manual_now(a) }
    let fe: i32 = apply_flash_now(a)
    rebuild_chips(a)
}

// UI side of an open: hand the camera back
fn finish_open(a: *mut App, u: *mut ui.Ui, cv: *mut camview.CamView, now: i64) {
    let keep: f32 = (*a).o_keep
    let first: bool = (*a).o_first
    (*a).o_keep = 0.0f
    (*a).o_first = false
    (*a).wop = W_NONE
    let st: i32 = (*a).wstat
    if st == WS_OK {
        (*a).ready = true
        (*a).lost_at = 0
        set_status(a, "READY")
        if keep > 0.0f {
            let ez: i32 = camera.camera_set_zoom(keep)
            (*a).zr = keep
        } else {
            reset_zoom(a, u, cv)
        }
    } else if st == WS_NO_INFO {
        set_status(a, "NO INFO")
    } else if st == WS_OPEN_FAILED {
        set_status(a, "OPEN FAILED")
    } else {
        set_status(a, "SESSION FAILED")
    }
    if first {
        mark(a, P_CHIPS)
        boot_begin(a, now)
        reset_zoom(a, u, cv)
    }
}

fn stamp() -> i64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 0, (&ts[0]) as i64, 0, 0, 0, 0)
    return ts[0]
}

// ---------------------------------------------------------------- manual sliders
fn man_iso(a: *mut App) -> i32 {
    let lo: f64 = if (*a).info.iso_min > 0 { (*a).info.iso_min as f64 } else { 50.0 }
    let hi: f64 = (*a).info.iso_max as f64
    return (lo * math.powf(hi / lo, ((*a).sl[0] as f64) / 1000.0) + 0.5) as i32
}

fn man_exp(a: *mut App) -> i64 {
    let lo: f64 = (*a).info.exp_min_ns as f64
    var hi: f64 = (*a).info.exp_max_ns as f64
    if hi > 500000000.0 { hi = 500000000.0 }
    if lo <= 0.0 || hi <= lo { return (*a).info.exp_min_ns }
    return (lo * math.powf(hi / lo, ((*a).sl[1] as f64) / 1000.0)) as i64
}

fn man_focus(a: *mut App) -> f32 {
    return (*a).info.min_focus_d * ((*a).sl[2] as f32) / 1000.0f
}

fn apply_manual(a: *mut App) {
    if !(*a).ready || !(*a).manual { return }
    apply_manual_now(a)
}

fn apply_manual_now(a: *mut App) {
    var e: i64 = 0
    var iso: i32 = 0
    var fd: f32 = 0.0f - 1.0f
    if has_man_sensor(a) { e = man_exp(a); iso = man_iso(a) }
    if has_man_focus(a) { fd = man_focus(a) }
    camera.camera_set_manual(e, iso, fd)
}

// rows that exist: 0 ISO, 1 EXP, 2 FOCUS -> packed list; returns the count
fn rows_of(a: *mut App, out: *mut [i32; 3]) -> i32 {
    var n: i32 = 0
    if has_man_sensor(a) { (*out)[0] = 0; (*out)[1] = 1; n = 2 }
    if has_man_focus(a) { (*out)[n as usize] = 2; n = n + 1 }
    return n
}

// ---------------------------------------------------------------- saving names
fn name_into(dst: u64, prefix: str, ext: str) -> usize {
    var o: usize = 0
    var i: usize = 0
    while i < prefix.n { *((dst + o as u64) as *mut u8) = *((prefix.p as u64 + i as u64) as *mut u8); o = o + 1; i = i + 1 }
    o = o + put_int(dst + o as u64, stamp())
    i = 0
    while i < ext.n { *((dst + o as u64) as *mut u8) = *((ext.p as u64 + i as u64) as *mut u8); o = o + 1; i = i + 1 }
    *((dst + o as u64) as *mut u8) = 0 as u8
    return o
}

fn report(a: *mut App, r: i32, ok_txt: str, priv_txt: str) {
    if r == 1 || r == 2 { commit_thumb(a) }
    if r == 1 { set_status(a, ok_txt) } else if r == 2 { set_status(a, priv_txt) } else { set_status(a, "SAVE FAILED") }
}

// ---------------------------------------------------------------- plain single shot (RAW -> DNG, JPEG as the camera made it)
// UI side: snapshot the manual values, post the shot to the worker
fn start_plain(a: *mut App) {
    if !(*a).ready || locked(a) { return }
    (*a).phave_e = false
    (*a).phave_f = false
    (*a).piso = 0
    if (*a).manual {
        if has_man_sensor(a) { (*a).pexp = man_exp(a); (*a).piso = man_iso(a); (*a).phave_e = true }
        if has_man_focus(a) { (*a).pfoc = man_focus(a); (*a).phave_f = true }
    }
    (*a).pflash = (*a).flash > 0 && ((*a).mode == M_PHOTO || (*a).mode == M_RAW)
    set_shot_rotation(a)
    (*a).wabort = 0
    (*a).wsave = 0 - 1
    (*a).wstat = WS_OK
    (*a).wtxt = 0
    (*a).wseen = 1
    (*a).wop = W_PLAIN
    (*a).busy = true
    set_status(a, "CAPTURING")
    worker_post(a)
}

// worker thread: capture one frame, make the DNG when it is RAW, save
fn work_plain(a: *mut App) {
    (*a).wstat = WS_OK
    (*a).wsave = 0 - 1
    let cap: usize = if (*a).kind == camera.KIND_RAW { raw_frame_bytes(a) } else { 24 * 1024 * 1024 }
    let buf: u64 = camera.camera_alloc(cap)
    if buf == 0 { (*a).wstat = WS_NO_MEMORY; return }
    var fi: camera.FrameInfo = camera.zero_frame()
    var exp_l: [i64; 1] = [0 as i64; 1]
    var foc_l: [f32; 1] = [0.0f; 1]
    var ep: u64 = 0
    var fp: u64 = 0
    let iso: i32 = (*a).piso
    if (*a).phave_e { exp_l[0] = (*a).pexp; ep = (&exp_l[0]) as u64 }
    if (*a).phave_f { foc_l[0] = (*a).pfoc; fp = (&foc_l[0]) as u64 }
    if worker_aborted(a) { (*a).wstat = WS_ABORTED; camera.camera_free(buf, cap); return }
    thread_blocking_an()
    if (*a).pflash { let fp2: i32 = camera.camera_flash_prepare() }
    let n: i32 = camera.camera_capture(1, ep, fp, iso, buf, cap, &fi)
    thread_blocking_out()
    if n < 1 {
        (*a).wstat = WS_CAPTURE_FAILED
        camera.camera_free(buf, cap)
        return
    }
    (*a).shots = (*a).shots + 1
    (*a).sbuf = buf
    (*a).scap = cap
    (*a).sdbuf = 0
    (*a).sdcap = 0
    if fi.kind == camera.KIND_RAW {
        var m: meta.SensorMeta = meta.meta_default()
        camera.camera_meta(fi.slot, &m)
        var ex: dngwrite.DngExtra = dngwrite.dng_extra_default()
        camera.camera_dng_extra(fi.slot, &ex)
        let dcap: usize = dngwrite.dng_max_size(fi.w as u32, fi.h as u32)
        let dbuf: u64 = camera.camera_alloc(dcap)
        if dbuf == 0 { (*a).wstat = WS_NO_MEMORY; return }
        let dn: usize = dngwrite.dng_write(dbuf, dcap, buf + fi.offset as u64, fi.w as u32, fi.h as u32, &m, &ex)
        (*a).sdbuf = dbuf
        (*a).sdcap = dcap
        (*a).sptr = dbuf
        (*a).sn = dn
        (*a).wtxt = 2
    } else if fi.kind == camera.KIND_JPEG {
        (*a).sptr = buf + fi.offset as u64
        (*a).sn = fi.size
        (*a).wtxt = 1
    } else {
        (*a).wstat = WS_YUV
    }
}

// UI side: the JNI part of a save (MediaStore) and freeing of the worker's buffers
fn save_plain_result(a: *mut App) {
    var name: [u8; 48] = [0 as u8; 48]
    if (*a).wtxt == 2 {
        name_into((&name[0]) as u64, "IMG_", ".dng")
        let mime: str = "image/x-adobe-dng\0"
        (*a).wsave = if (*a).sn > 0 { camera.camera_save((*a).sptr, (*a).sn, (&name[0]) as u64, mime.p as u64) } else { 0 }
    } else if (*a).wtxt == 1 {
        name_into((&name[0]) as u64, "IMG_", ".jpg")
        let mime: str = "image/jpeg\0"
        (*a).wsave = camera.camera_save((*a).sptr, (*a).sn, (&name[0]) as u64, mime.p as u64)
    }
    if (*a).sdbuf != 0 { camera.camera_free((*a).sdbuf, (*a).sdcap) }
    if (*a).sbuf != 0 { camera.camera_free((*a).sbuf, (*a).scap) }
    (*a).sdbuf = 0
    (*a).sbuf = 0
}

// ---------------------------------------------------------------- processed shot: capture, then the job thread
// EXIF tag from SENSOR_ORIENTATION and the screen rotation at the moment of the shot (camjob.capture_orientation)
fn exif_orientation(sensor: i32, disp: i32, front: bool) -> i32 {
    return camjob.capture_orientation(sensor, disp, front)
}

// the turn that makes the sensor picture upright for the current screen rotation (HAL JPEG EXIF, camjob tag)
fn set_shot_rotation(a: *mut App) {
    let front: bool = (*a).info.facing == 0
    camera.camera_set_jpeg_rotation(campreview.cp_rotation((*a).info.orientation, (*a).disp, front))
}

fn want_frames(a: *mut App, raw: bool, steps: *mut [f32; 16]) -> i32 {
    let m: i32 = (*a).mode
    if m == M_PHOTO { return 4 } // RAW photos are merged at the full 16:9 window (9.4 MP float): 4 frames bound the memory
    if m == M_NIGHT { return if raw { 10 } else { 6 } }
    if m == M_PORTRAIT { return 3 }
    if m == M_DOC { return 2 }
    // focus stack: steps from the lens' focus range
    var mt: meta.SensorMeta = meta.meta_default()
    camera.camera_meta(0 - 1, &mt)
    return focus.plan_focus(&mt, 0.0f, (*a).info.min_focus_d, 8, &(*steps)[0])
}

// UI side: plan the shot, allocate, post it to the worker thread (work_shot takes the frames)
fn start_job(a: *mut App) {
    if !(*a).ready || locked(a) { return }
    let raw: bool = (*a).kind == camera.KIND_RAW
    let ji: *mut camera.CamInfo = &(*a).info
    let fb: usize = if raw { raw_frame_bytes(a) } else { (((*ji).jpeg_w as usize) * ((*ji).jpeg_h as usize) * 3) / 4 + 1048576 }
    var n: i32 = want_frames(a, raw, &(*a).steps)
    while n > 1 && (n as usize) * fb > BUDGET { n = n - 1 }
    if (*a).mode == M_STACK && n < 2 { set_status(a, "NO FOCUS RANGE"); return }
    if n > 16 { n = 16 }
    let cap: usize = fb * (n as usize)
    let buf: u64 = camera.camera_alloc(cap)
    let fra: u64 = camera.camera_alloc(camera.sizeof_frame() * 16)
    if buf == 0 || fra == 0 {
        if buf != 0 { camera.camera_free(buf, cap) }
        if fra != 0 { camera.camera_free(fra, camera.sizeof_frame() * 16) }
        set_status(a, "NO MEMORY")
        return
    }
    camjob.job_free(&(*a).job)
    (*a).job = camjob.job_new()
    if (*a).fl_last > 0 { let f0: i32 = camera.camera_set_flash(camera.FLASH_OFF); (*a).fl_last = camera.FLASH_OFF } // a series never fires the flash
    (*a).cbuf = buf
    (*a).ccap = cap
    (*a).fbuf = fra
    (*a).cap_n = n
    (*a).cap_i = 0
    (*a).cap_at = 0
    (*a).stage = 1
    (*a).busy = true
    set_shot_rotation(a)
    (*a).wabort = 0
    (*a).wsave = 0 - 1
    (*a).wstat = WS_OK
    (*a).wtxt = 0
    (*a).wseen = 1
    (*a).wop = W_SHOT
    set_status(a, "CAPTURING")
    worker_post(a)
}

fn release_capture(a: *mut App) {
    if (*a).cbuf != 0 { camera.camera_free((*a).cbuf, (*a).ccap) }
    if (*a).fbuf != 0 { camera.camera_free((*a).fbuf, camera.sizeof_frame() * 16) }
    (*a).cbuf = 0
    (*a).fbuf = 0
    let fe: i32 = apply_flash(a)
}

// worker thread: the frames of the burst, one camera_capture each (the abort flag is checked between them), then the job
// (merge + encode, long) and the save. Nothing here runs on the UI thread.
fn work_shot(a: *mut App) {
    (*a).wstat = WS_OK
    (*a).wsave = 0 - 1
    let fptr: *mut camera.FrameInfo = (*a).fbuf as *mut camera.FrameInfo
    while (*a).cap_i < (*a).cap_n {
        if worker_aborted(a) { break }
        let k: i32 = (*a).cap_i
        let fk: *mut camera.FrameInfo = camera.frame_at(fptr, k)
        var fp: u64 = 0
        if (*a).mode == M_STACK { fp = (&(*a).steps[k as usize]) as u64 }
        let dst: u64 = (*a).cbuf + (*a).cap_at as u64
        let room: usize = (*a).ccap - (*a).cap_at
        thread_blocking_an()
        let c: i32 = camera.camera_capture(1, 0, fp, 0, dst, room, fk)
        thread_blocking_out()
        if c < 1 { break }
        (*a).bs[k as usize] = dst
        (*a).cap_at = (*a).cap_at + (*fk).offset + (*fk).size
        (*a).cap_i = k + 1
        (*a).job.progress = (((k + 1) * 25 / (*a).cap_n) as u64)
    }
    if worker_aborted(a) { (*a).wstat = WS_ABORTED; return }
    if (*a).cap_i < 1 { (*a).wstat = WS_CAPTURE_FAILED; return }
    fill_job(a)
    (*a).stage = 2
    camjob.job_entry((&(*a).job) as u64)
    if !(*a).job.ok { (*a).wstat = WS_PROCESS_FAILED; return }
    if worker_aborted(a) { (*a).wstat = WS_ABORTED; return }
    (*a).wtxt = 0
    (*a).shots = (*a).shots + 1
}

// UI side: the JNI part of a burst result
fn save_job_result(a: *mut App) {
    var name: [u8; 48] = [0 as u8; 48]
    name_into((&name[0]) as u64, "IMG_", ".jpg")
    let mime: str = "image/jpeg\0"
    (*a).wsave = camera.camera_save((*a).job.out, (*a).job.out_n, (&name[0]) as u64, mime.p as u64)
    if (*a).job.have_pdf {
        var pn: [u8; 48] = [0 as u8; 48]
        name_into((&pn[0]) as u64, "SCAN_", ".pdf")
        let pm: str = "application/pdf\0"
        camera.camera_save_doc(rt.buf_ptr(&(*a).job.pdf), rt.buf_len(&(*a).job.pdf), (&pn[0]) as u64, pm.p as u64)
    }
}

// the job description from the captured frames (worker thread)
fn fill_job(a: *mut App) {
    let ji: *mut camera.CamInfo = &(*a).info
    let fptr: *mut camera.FrameInfo = (*a).fbuf as *mut camera.FrameInfo
    (*a).job.mode = (*a).mode
    (*a).job.orientation = exif_orientation((*ji).orientation, (*a).disp, (*ji).facing == 0)
    (*a).job.zoom = 1.0f
    // wide picture at full sensor resolution like the system camera: 16:9 window, up to 9.5 MP (4096 x 2304 on a 4096 x 3072 RAW)
    (*a).job.aw = 0
    (*a).job.ah = 0
    (*a).job.max_px = 3300000
    if (*a).mode == M_PHOTO && (*a).kind == camera.KIND_RAW {
        (*a).job.aw = 16
        (*a).job.ah = 9
        (*a).job.max_px = 9500000
    }
    if ZOOM_RAW_CROP && (*a).kind == camera.KIND_RAW && (*a).zr > 1.05f { (*a).job.zoom = (*a).zr }
    var mt: meta.SensorMeta = meta.meta_default()
    camera.camera_meta((*fptr).slot, &mt)
    (*a).job.meta = mt
    var i: i32 = 0
    while i < (*a).cap_i {
        let f: *mut camera.FrameInfo = camera.frame_at(fptr, i)
        var kind: i32 = camjob.SHOT_JPEG
        if (*f).kind == camera.KIND_RAW { kind = camjob.SHOT_RAW }
        if (*f).kind != camera.KIND_YUV {
            camjob.job_add_shot(&(*a).job, kind, (*f).w, (*f).h, (*a).bs[i as usize] + (*f).offset as u64, (*f).size, (*f).exposure_ns, (*f).iso)
        }
        i = i + 1
    }
}

// ---------------------------------------------------------------- the worker thread
// The worker is a bionic pthread that attaches to the Firn runtime once (a raw-clone thread of thread_start shares bionic's
// thread pointer and crashes the app on Android) and never detaches. Between operations it sleeps in host mode (blocked).
fn worker_dispatch(a: *mut App) {
    let op: i32 = (*a).wop
    if op == W_OPEN {
        work_open(a)
    } else if op == W_SHOT {
        work_shot(a)
    } else if op == W_PLAIN {
        work_plain(a)
    }
}

fn thread_job_main(arg: u64) -> u64 {
    let a: *mut App = arg as *mut App
    if !thread_attach() { return 0 }
    var seen: u64 = 0
    while true {
        let want: u64 = __atomic_add((&(*a).wreq) as *mut u64, 0)
        if want != seen {
            seen = want
            thread_blocking_out()
            worker_dispatch(a)
            __atomic_add((&(*a).wdone) as *mut u64, 1)
            thread_blocking_an()
        } else {
            usleep(10000 as u32)
        }
    }
    return 0
}

// UI side: start the operation a.wop on the worker (the thread is created on the first use; without a thread it runs here)
fn worker_post(a: *mut App) {
    (*a).wt0 = fuishell.shell_now_ms()
    if (*a).ttid == 0 {
        pthread_attr_init((&(*a).tattr[0]) as u64)
        pthread_attr_setstacksize((&(*a).tattr[0]) as u64, JOB_STACK)
        pthread_attr_setdetachstate((&(*a).tattr[0]) as u64, 1)
        let rc: i32 = pthread_create((&(*a).ttid) as u64, (&(*a).tattr[0]) as u64, ndk.code_of_thread(thread_job_main), a as u64)
        if rc != 0 { (*a).ttid = 0 }
    }
    __atomic_add((&(*a).wreq) as *mut u64, 1)
    if (*a).ttid == 0 {
        worker_dispatch(a)
        __atomic_add((&(*a).wdone) as *mut u64, 1)
    }
}

fn worker_idle(a: *mut App) -> bool {
    return __atomic_add((&(*a).wdone) as *mut u64, 0) == __atomic_add((&(*a).wreq) as *mut u64, 0)
}

// leaving the app: stop the running operation and wait (bounded) so the camera is not closed under it
fn worker_stop(a: *mut App) {
    if (*a).wop == W_NONE { return }
    worker_abort(a)
    var waited: i32 = 0
    while !worker_idle(a) && waited < 600 {
        usleep(20000 as u32)
        waited = waited + 1
    }
}

fn log_work(op: i32, stat: i32, ms: i64) {
    var b: [u8; 64] = [0 as u8; 64]
    let p: u64 = (&b[0]) as u64
    var n: usize = put_str(p, "work op=")
    n = n + put_int(p + n as u64, op as i64)
    n = n + put_str(p + n as u64, " stat=")
    n = n + put_int(p + n as u64, stat as i64)
    n = n + put_str(p + n as u64, " ms=")
    n = n + put_int(p + n as u64, ms)
    let tag: str = "firncam\0"
    let r: i32 = log_write(4, tag.p as u64, p)
}

// UI side of a finished shot: report, release, hand the camera back
fn finish_shot(a: *mut App) {
    let st: i32 = (*a).wstat
    let op: i32 = (*a).wop
    if op == W_PLAIN {
        if st == WS_OK { save_plain_result(a) } else if (*a).sbuf != 0 {
            if (*a).sdbuf != 0 { camera.camera_free((*a).sdbuf, (*a).sdcap) }
            camera.camera_free((*a).sbuf, (*a).scap)
            (*a).sdbuf = 0
            (*a).sbuf = 0
        }
    } else if st == WS_OK {
        save_job_result(a)
    }
    if st == WS_OK {
        if (*a).wtxt == 2 {
            report(a, (*a).wsave, "SAVED DNG", "SAVED DNG PRIVATE")
        } else if (*a).wtxt == 1 {
            report(a, (*a).wsave, "SAVED JPG", "SAVED JPG PRIVATE")
        } else {
            report(a, (*a).wsave, "SAVED", "SAVED PRIVATE")
        }
    } else if st == WS_NO_MEMORY {
        set_status(a, "NO MEMORY")
    } else if st == WS_CAPTURE_FAILED {
        set_status(a, "CAPTURE FAILED")
    } else if st == WS_ABORTED {
        set_status(a, "SHOT CANCELLED")
    } else if st == WS_PROCESS_FAILED {
        set_status(a, "PROCESSING FAILED")
    } else if st == WS_YUV {
        set_status(a, "YUV NOT SAVED")
    }
    if op == W_SHOT {
        camjob.job_free(&(*a).job)
        release_capture(a)
    }
    (*a).stage = 0
    (*a).busy = false
    (*a).wop = W_NONE
}

// UI side, once per turn: follow the running operation and finish it when the worker is done
fn worker_tick(a: *mut App, u: *mut ui.Ui, cv: *mut camview.CamView, now: i64) {
    if (*a).wop == W_NONE { return }
    if !worker_idle(a) {
        if (*a).wop == W_SHOT && (*a).stage != (*a).wseen {
            (*a).wseen = (*a).stage
            if (*a).stage == 2 { set_status(a, "PROCESSING") }
        }
        return
    }
    let op: i32 = (*a).wop
    log_work(op, (*a).wstat, now - (*a).wt0)
    if op == W_OPEN {
        mark(a, P_OPEN)
        finish_open(a, u, cv, now)
    } else {
        mark(a, P_SAVE)
        finish_shot(a)
    }
    // a lens switch asked while a shot ran: the shot was aborted, now the lens opens
    if (*a).defer_lens >= 0 && (*a).wop == W_NONE {
        let d: i32 = (*a).defer_lens
        (*a).defer_lens = 0 - 1
        open_lens(a, d)
    }
}

// plain single frame: RAW -> DNG, manual photo, or a photo with flash (one frame fires the flash)
fn plain_shot(a: *mut App) -> bool {
    let m: i32 = (*a).mode
    return m == M_RAW || (m == M_PHOTO && ((*a).manual || (*a).flash > 0))
}

fn shoot(a: *mut App) {
    if locked(a) { return }
    sweep_abort(a, true) // a photo at the sweep's zoom would be wrong
    if plain_shot(a) { start_plain(a); return }
    start_job(a)
}

// video: MediaRecorder is JNI and stays on the UI thread; the session rebuild after it goes to the worker (open_lens)
fn toggle_video(a: *mut App) {
    if !(*a).ready || (*a).info.vid_w <= 0 || (*a).wop != W_NONE { return }
    sweep_abort(a, true)
    if (*a).recording {
        let ok: bool = camera.camera_video_stop()
        (*a).recording = false
        (*a).vok = ok
        open_lens(a, (*a).lens)
        if ok { commit_thumb(a) }
        if ok { set_status(a, "VIDEO SAVED") } else { set_status(a, "VIDEO FAILED") }
        return
    }
    snap_thumb(a)
    var name: [u8; 48] = [0 as u8; 48]
    name_into((&name[0]) as u64, "VID_", ".mp4")
    let r: i32 = camera.camera_video_start((&name[0]) as u64)
    if r == camera.E_OK {
        (*a).recording = true
        set_status(a, "RECORDING")
    } else {
        set_status(a, "VIDEO START FAILED")
        open_lens(a, (*a).lens)
    }
}

// ---------------------------------------------------------------- flash
// The camera flash mode for the user's choice and the current mode. The flash fires for single frames only
// (photo, RAW); in VIDEO "on" is the torch; every other mode keeps it off.
fn apply_flash(a: *mut App) -> i32 {
    if !(*a).ready { return camera.E_STATE }
    return apply_flash_now(a)
}

// without the ready check: the worker applies the flash while the lens is not yet released to the UI
fn apply_flash_now(a: *mut App) -> i32 {
    var m: i32 = camera.FLASH_OFF
    let md: i32 = (*a).mode
    if md == M_PHOTO || md == M_RAW {
        if (*a).flash == 1 { m = camera.FLASH_AUTO } else if (*a).flash == 2 { m = camera.FLASH_ON }
    } else if md == M_VIDEO && (*a).flash == 2 {
        m = camera.FLASH_TORCH
    }
    if m == (*a).fl_last { return camera.E_OK }
    if m == camera.FLASH_OFF && (*a).fl_last < 0 { (*a).fl_last = camera.FLASH_OFF; return camera.E_OK }
    let e: i32 = camera.camera_set_flash(m)
    if e == camera.E_OK { (*a).fl_last = m }
    return e
}

// ---------------------------------------------------------------- thumbnails
const THUMB: i32 = 128
const THUMB_BYTES: usize = 128 * 128 * 4

fn copy_bytes(dst: u64, src: u64, n: usize) {
    var o: usize = 0
    while o + 8 <= n {
        *((dst + o as u64) as *mut u64) = *((src + o as u64) as *mut u64)
        o = o + 8
    }
}

// the picture of the shutter press becomes the "last photo" only when it was saved
fn snap_thumb(a: *mut App) {
    (*a).have_s = false
    if (*a).have_p && (*a).sthumb != 0 && (*a).pthumb != 0 {
        copy_bytes((*a).sthumb, (*a).pthumb, THUMB_BYTES)
        (*a).have_s = true
    }
}

fn commit_thumb(a: *mut App) {
    if (*a).have_s && (*a).thumb != 0 && (*a).sthumb != 0 {
        copy_bytes((*a).thumb, (*a).sthumb, THUMB_BYTES)
        (*a).tkey = (*a).tkey + 1
        (*a).have_thumb = true
        (*a).have_s = false
    }
}

// ---------------------------------------------------------------- lenses
// Lens facts of the scan list (facing, 35 mm equivalent) and the main lens of each facing (nearest to 26 mm).
fn scan_lenses(a: *mut App) {
    var i: i32 = 0
    (*a).main_lens = [0 - 1, 0 - 1, 0 - 1]
    var best: [f32; 3] = [1000.0f; 3]
    var tmp: camera.CamInfo = camera.zero_info()
    while i < (*a).nlens && i < 16 {
        (*a).lfac[i as usize] = 0 - 1
        (*a).lmm[i as usize] = 0.0f
        if camera.camera_info(i, &tmp) {
            (*a).lfac[i as usize] = tmp.facing
            (*a).lmm[i as usize] = tmp.equiv_mm
            let f: i32 = tmp.facing
            if f >= 0 && f < 3 {
                var d: f32 = tmp.equiv_mm - 26.0f
                if tmp.equiv_mm <= 0.0f { d = 500.0f }
                if d < 0.0f { d = 0.0f - d }
                if d < best[f as usize] {
                    best[f as usize] = d
                    (*a).main_lens[f as usize] = i
                }
            }
        }
        i = i + 1
    }
    (*a).can_flip = (*a).main_lens[0] >= 0 && (*a).main_lens[1] >= 0
}

// Zoom chips of the open camera: the lens factors (0.6x ultra wide, 1x main, tele when the app can see it) plus digital
// stops (2x, 5x, ...) as far as the zoom range of the camera reaches. A tap picks the lens / the ratio (C_STOP).
fn rebuild_chips(a: *mut App) {
    (*a).nchip = 0
    (*a).foc1 = 0.0f
    (*a).ph1[0] = 0 as u8
    var ox: [i32; 8] = [0; 8]
    var oo: [i32; 8] = [0; 8]
    let n: i32 = camera.camera_zoom_stops((&ox[0]) as u64, (&oo[0]) as u64, 6)
    var i: i32 = 0
    while i < n && i < 6 {
        (*a).chip_x10[i as usize] = ox[i as usize]
        (*a).chip_opt[i as usize] = oo[i as usize]
        i = i + 1
    }
    var cnt: i32 = i
    // a tele lens the id list hides but the service switches to (seen by the sweep): an optical stop at its switch zoom
    if (*a).learn_x10 > 0 && (*a).lens == (*a).learn_lens {
        cnt = focusplan.learned_stop((&(*a).chip_x10[0]) as u64, (&(*a).chip_opt[0]) as u64, cnt, 6, (*a).learn_x10)
    }
    i = 0
    while i < cnt { (*a).chip_idx[i as usize] = (*a).lens; i = i + 1 }
    (*a).nchip = cnt
}

// ---------------------------------------------------------------- diagnostics
fn put_f10(dst: u64, v: f32) -> usize {
    return put_int(dst, ((v * 10.0f) + 0.5f) as i64)
}

fn same16(x: *mut [u8; 16], y: *mut [u8; 16]) -> bool {
    var i: usize = 0
    while i < 16 {
        if (*x)[i] != (*y)[i] { return false }
        if (*x)[i] == 0 as u8 { return true }
        i = i + 1
    }
    return true
}

fn put_hex(dst: u64, v: u32) -> usize {
    var i: usize = 0
    var sh: i32 = 28
    var started: bool = false
    while sh >= 0 {
        let d: u32 = (v / pow16(sh)) % (16 as u32)
        if d != (0 as u32) || started || sh == 0 {
            started = true
            *((dst + i as u64) as *mut u8) = (if d < (10 as u32) { 48 + d } else { 87 + d }) as u8
            i = i + 1
        }
        sh = sh - 4
    }
    return i
}

fn pow16(sh: i32) -> u32 {
    var r: u32 = 1
    var k: i32 = 0
    while k < sh { r = r * (2 as u32); k = k + 1 }
    return r
}

// Logs what the newest capture result says (focal length, ACTIVE_PHYSICAL_ID, crop width) into sweep slot `slot`.
fn sweep_record(a: *mut App, slot: i32, z10: i32) {
    let sl: usize = slot as usize
    (*a).sw_z[sl] = z10
    (*a).sw_f[sl] = (camera.camera_active_focal() * 100.0f + 0.5f) as i32
    let pn: usize = camera.camera_result_phys((&(*a).sw_ph[sl][0]) as u64)
    var cr: [i32; 4] = [0; 4]
    camera.camera_result_crop((&cr[0]) as u64)
    (*a).sw_cw[sl] = cr[2]
    if slot >= (*a).sw_n { (*a).sw_n = slot + 1 }
}

// True when sweep slot `slot` shows another physical lens than slot 0 (zoom 1): a different ACTIVE_PHYSICAL_ID, or a
// focal length more than 8 % off.
fn sweep_differs(a: *mut App, slot: i32) -> bool {
    let sl: usize = slot as usize
    if (*a).sw_ph[sl][0] != 0 as u8 && (*a).sw_ph[0][0] != 0 as u8 && !same16(&(*a).sw_ph[sl], &(*a).sw_ph[0]) { return true }
    let f0: i32 = (*a).sw_f[0]
    let f1: i32 = (*a).sw_f[sl]
    if f0 > 0 && f1 > 0 {
        var d: i32 = f1 - f0
        if d < 0 { d = 0 - d }
        if d * 100 > 8 * f0 { return true }
    }
    return false
}

// Appends "word=" and a number.
fn put_kv(dst: u64, k: str, v: i64) -> usize {
    var n: usize = put_str(dst, k)
    n = n + put_int(dst + n as u64, v)
    return n
}

// ---------------------------------------------------------------- startup work, one bounded step per loop turn
// The main loop is the thread that reads Android's input queue: 5 s without reading a touch event is an ANR. So nothing
// here sleeps or loops over slow calls. The zoom sweep and the camera dump are state machines that do ONE small step per
// turn and wait by looking at the clock across turns. A zoom command, a lens change, the shutter or video abort the sweep
// (sweep_abort) and the user's action wins.
const BT_IDLE: i32 = 0
const BT_WAIT: i32 = 1 // the preview settles for BOOT_DELAY_MS, then the sweep starts
const BT_SWEEP: i32 = 2
const BT_DUMP: i32 = 3
const BT_DONE: i32 = 4
const BOOT_DELAY_MS: i64 = 1200
const SW_WAIT_MS: i64 = 700 // longest wait for the zoom to be applied / for the results after it
const DUMP_CAP: usize = 20000

#[link_name(open)]
extern fn libc_open(path: u64, flags: i32, mode: u32) -> i32;
#[link_name(read)]
extern fn libc_read(fd: i32, p: u64, n: usize) -> i64;
#[link_name(write)]
extern fn libc_write(fd: i32, p: u64, n: usize) -> i64;
#[link_name(close)]
extern fn libc_close(fd: i32) -> i32;

// Result cache of the zoom sweep: <app data dir>/firncam-learned.txt = "<key>|<learned switch zoom x10>\n". The key names the
// app version and the camera (id, zoom range, focal length, RAW width, number of scan entries): another phone, another
// camera app version or another zoom range = another key = the sweep runs again. 0 = swept, no tele switch found.
fn cache_path(dst: u64) -> bool {
    let d: u64 = activity.activity_data_path()
    if d == 0 as u64 { return false }
    var n: usize = 0
    while n < 400 && *((d + n as u64) as *mut u8) != 0 as u8 {
        *((dst + n as u64) as *mut u8) = *((d + n as u64) as *mut u8)
        n = n + 1
    }
    n = n + put_str(dst + n as u64, "/firncam-learned.txt")
    *((dst + n as u64) as *mut u8) = 0 as u8
    return true
}

fn cache_key(a: *mut App, dst: u64) -> usize {
    var zmin: f32 = 0.0f
    var zmax: f32 = 0.0f
    camera.camera_zoom_range(&zmin, &zmax)
    var n: usize = put_str(dst, "firncam-")
    n = n + put_str(dst + n as u64, "0.8")
    n = n + put_str(dst + n as u64, " id=")
    var k: usize = 0
    while k < 40 && (*a).info.id[k] != 0 as u8 {
        *((dst + n as u64) as *mut u8) = (*a).info.id[k]
        n = n + 1
        k = k + 1
    }
    n = n + put_str(dst + n as u64, " z=")
    n = n + put_f10(dst + n as u64, zmin)
    n = n + put_str(dst + n as u64, "..")
    n = n + put_f10(dst + n as u64, zmax)
    n = n + put_kv(dst + n as u64, " n=", (*a).nlens as i64)
    n = n + put_str(dst + n as u64, " f=")
    n = n + put_f10(dst + n as u64, (*a).info.focal_mm)
    n = n + put_kv(dst + n as u64, " raw=", (*a).info.raw_w as i64)
    return n
}

// The learned switch zoom x10 of the cache (0 = none), -1 = no cache for this camera.
fn cache_load(a: *mut App) -> i32 {
    var path: [u8; 512] = [0 as u8; 512]
    if !cache_path((&path[0]) as u64) { return 0 - 1 }
    let fd: i32 = libc_open((&path[0]) as u64, 0, 0 as u32)
    if fd < 0 { return 0 - 1 }
    var buf: [u8; 512] = [0 as u8; 512]
    let rn: i64 = libc_read(fd, (&buf[0]) as u64, 500)
    let cl: i32 = libc_close(fd)
    if rn <= 0 { return 0 - 1 }
    var key: [u8; 300] = [0 as u8; 300]
    let kn: usize = cache_key(a, (&key[0]) as u64)
    let got: usize = rn as usize
    if kn >= 280 || got < kn + 2 { return 0 - 1 }
    var i: usize = 0
    while i < kn {
        if buf[i] != key[i] { return 0 - 1 }
        i = i + 1
    }
    if buf[kn] != 124 as u8 { return 0 - 1 }
    var v: i32 = 0
    var j: usize = kn + 1
    while j < got && buf[j] >= 48 as u8 && buf[j] <= 57 as u8 {
        v = v * 10 + (buf[j] as i32) - 48
        j = j + 1
    }
    return v
}

fn cache_store(a: *mut App) {
    var path: [u8; 512] = [0 as u8; 512]
    if !cache_path((&path[0]) as u64) { return }
    var buf: [u8; 320] = [0 as u8; 320]
    let p: u64 = (&buf[0]) as u64
    var n: usize = cache_key(a, p)
    if n >= 280 { return }
    *((p + n as u64) as *mut u8) = 124 as u8
    n = n + 1
    n = n + put_int(p + n as u64, (*a).learn_x10 as i64)
    *((p + n as u64) as *mut u8) = 10 as u8
    n = n + 1
    let fd: i32 = libc_open((&path[0]) as u64, 577, 420 as u32)
    if fd < 0 { return }
    let w: i64 = libc_write(fd, p, n)
    let cl: i32 = libc_close(fd)
}

// After the first lens is open: take a cached sweep result when there is one, else plan the sweep and the dump.
fn boot_begin(a: *mut App, now: i64) {
    (*a).bt_state = BT_DONE
    if !(*a).ready { return }
    var zmin: f32 = 0.0f
    var zmax: f32 = 0.0f
    camera.camera_zoom_range(&zmin, &zmax)
    let eligible: bool = sweep_forced() || ((*a).info.facing == 1 && ((*a).info.caps & camera.CAP_LOGICAL) != 0 as u32)
    var need: bool = eligible && zmax >= 2.0f
    var hit: bool = false
    if need && !sweep_forced() {
        let c: i32 = cache_load(a)
        if c >= 0 {
            hit = true
            need = false
            (*a).swept = true
            (*a).cache_hit = true
            if c > 0 {
                (*a).learn_x10 = c
                (*a).learn_lens = (*a).lens
            }
            rebuild_chips(a)
        }
    }
    (*a).bt_at = now + BOOT_DELAY_MS
    if need { (*a).bt_state = BT_WAIT } else if hit { (*a).bt_state = BT_DONE } else { (*a).bt_state = BT_DUMP }
}

// One step per loop turn; waits while a photo/video is going on.
fn boot_tick(a: *mut App, u: *mut ui.Ui, cv: *mut camview.CamView, now: i64) {
    let st: i32 = (*a).bt_state
    if st == BT_IDLE || st == BT_DONE { return }
    if !(*a).ready || (*a).busy || (*a).recording { return }
    if now < (*a).bt_at { return }
    if st == BT_WAIT {
        sweep_begin(a)
    } else if st == BT_SWEEP {
        mark(a, P_SWEEP)
        sweep_tick(a, u, cv, now)
    } else {
        mark(a, P_DUMP)
        dump_tick(a)
    }
}

// ---------------------------------------------------------------- zoom sweep (state machine)
// Does the camera SERVICE switch to another physical lens (a tele the id list hides) at higher zoom? Steps 1x, 2x, 3x, 5x,
// 8x, 10x; at the first step that shows another lens a bisection down to 0.1x finds the switch zoom (a.learn_x10 -> an
// optical chip, r641). Restores zoom 1 at the end and caches the result. A step = set the zoom (sw_sub 0), wait until the
// result reports it (1), wait for 8 more results (2).
fn sweep_begin(a: *mut App) {
    (*a).sw_run = 1
    (*a).sw_n = 0
    (*a).sw_stage = 0
    (*a).sw_z10 = 10
    (*a).sw_sub = 0
    (*a).sw_ci = 0
    (*a).sw_same = 10
    (*a).sw_diff = 0
    (*a).sw_guard = 0
    (*a).bt_state = BT_SWEEP
    set_status(a, "LENS SCAN")
}

fn sweep_tick(a: *mut App, u: *mut ui.Ui, cv: *mut camview.CamView, now: i64) {
    let z: f32 = ((*a).sw_z10 as f32) / 10.0f
    if (*a).sw_sub == 0 {
        let e: i32 = camera.camera_set_zoom(z)
        if e != camera.E_OK { sweep_finish(a, u, cv, false); return }
        (*a).sw_sub = 1
        (*a).sw_t0 = now
        return
    }
    if (*a).sw_sub == 1 {
        let r: f32 = camera.camera_applied_zoom()
        if (r > z * 0.98f && r < z * 1.02f) || now - (*a).sw_t0 >= SW_WAIT_MS {
            (*a).sw_c0 = camera.camera_result_count()
            (*a).sw_sub = 2
            (*a).sw_t0 = now
        }
        return
    }
    var need: i64 = 8
    if (*a).sw_stage == 3 { need = 4 }
    if camera.camera_result_count() >= (*a).sw_c0 + need || now - (*a).sw_t0 >= SW_WAIT_MS {
        sweep_measured(a, u, cv)
    }
}

// The zoom of the current step is applied and its results are in: log them and plan the next step.
fn sweep_measured(a: *mut App, u: *mut ui.Ui, cv: *mut camview.CamView) {
    let st: i32 = (*a).sw_stage
    if st == 3 { sweep_finish(a, u, cv, true); return }
    let slot: i32 = (*a).sw_n
    sweep_record(a, slot, (*a).sw_z10)
    if st == 0 {
        (*a).sw_stage = 1
        (*a).sw_ci = 0
        sweep_next_coarse(a)
        return
    }
    if st == 1 {
        if sweep_differs(a, slot) {
            (*a).sw_diff = (*a).sw_z10
            (*a).sw_guard = 0
            (*a).sw_stage = 2
            sweep_next_bisect(a)
            return
        }
        (*a).sw_same = (*a).sw_z10
        (*a).sw_ci = (*a).sw_ci + 1
        sweep_next_coarse(a)
        return
    }
    if sweep_differs(a, slot) { (*a).sw_diff = (*a).sw_z10 } else { (*a).sw_same = (*a).sw_z10 }
    (*a).sw_guard = (*a).sw_guard + 1
    sweep_next_bisect(a)
}

fn sweep_next_coarse(a: *mut App) {
    var coarse: [i32; 5] = [20, 30, 50, 80, 100]
    var zmin: f32 = 0.0f
    var zmax: f32 = 0.0f
    camera.camera_zoom_range(&zmin, &zmax)
    let ci: i32 = (*a).sw_ci
    if ci >= 5 || (*a).sw_n >= 14 { sweep_restore(a); return }
    if (coarse[ci as usize] as f32) > zmax * 10.0f + 0.5f { sweep_restore(a); return }
    (*a).sw_z10 = coarse[ci as usize]
    (*a).sw_sub = 0
}

fn sweep_next_bisect(a: *mut App) {
    let m: i32 = focusplan.switch_between((*a).sw_same, (*a).sw_diff)
    if m == 0 || (*a).sw_guard >= 6 || (*a).sw_n >= 16 {
        (*a).learn_x10 = (*a).sw_diff
        (*a).learn_lens = (*a).lens
        sweep_restore(a)
        return
    }
    (*a).sw_z10 = m
    (*a).sw_sub = 0
}

fn sweep_restore(a: *mut App) {
    (*a).sw_stage = 3
    (*a).sw_z10 = 10
    (*a).sw_sub = 0
    (*a).zr = 1.0f
}

// Done (complete = every step ran): chips with the learned tele, zoom 1 on the screen, result into the cache, dump next.
fn sweep_finish(a: *mut App, u: *mut ui.Ui, cv: *mut camview.CamView, complete: bool) {
    (*a).sw_run = 0
    (*a).swept = true
    (*a).foc1 = 0.0f
    (*a).ph1[0] = 0 as u8
    rebuild_chips(a)
    reset_zoom(a, u, cv)
    if complete { cache_store(a) }
    (*a).bt_state = BT_DUMP
    if !(*a).busy { set_status(a, "READY") }
}

// The user (or the system) wants the camera: stop the sweep now. restore = put the zoom back to 1 (the camera stays open);
// without it the caller sets the zoom itself (zoom command) or closes the camera (lens change). No retry in this run and
// no cache entry: the next start sweeps again.
fn sweep_abort(a: *mut App, restore: bool) {
    if (*a).bt_state == BT_WAIT {
        (*a).bt_state = BT_DUMP
        (*a).swept = true
        return
    }
    if (*a).sw_run == 0 { return }
    (*a).sw_run = 0
    (*a).swept = true
    (*a).foc1 = 0.0f
    (*a).ph1[0] = 0 as u8
    (*a).bt_state = BT_DUMP
    if restore && (*a).ready {
        let e: i32 = camera.camera_set_zoom(1.0f)
        (*a).zr = 1.0f
    }
    if !(*a).busy { set_status(a, "READY") }
}

// ---------------------------------------------------------------- camera dump (state machine)
// Writes what the app sees of the cameras to Download/FirnCam/firncam-cameras<ts>.txt (no adb needed), one step per turn
// (every getCameraCharacteristics of a vendor camera service can take 50-300 ms), once per cache miss:
//  cam    every scan entry (public id or physical id of a logical camera): focal lengths (x10 mm), 35 mm equivalents, sizes
//  probe  getCameraCharacteristics on ids 0..19, listed or not (error codes shown): hidden physical cameras, caps, max-res
//  sweep  the zoom sweep: focal length / ACTIVE_PHYSICAL_ID / crop width per zoom step (does the service switch to a tele?)
//  tags   characteristics tags of the sensor / scaler / logical-camera / vendor sections of each scan entry (tag:type:count:value)
//  open   the zoom range and chip row of the open camera, the learned tele switch
fn dump_tick(a: *mut App) {
    if (*a).dbuf == 0 {
        (*a).dbuf = camera.camera_alloc(DUMP_CAP)
        if (*a).dbuf == 0 { (*a).bt_state = BT_DONE; return }
        (*a).dn = put_str((*a).dbuf, "firncam ")
        (*a).dn = (*a).dn + put_str((*a).dbuf + (*a).dn as u64, "0.8")
        (*a).dn = (*a).dn + put_str((*a).dbuf + (*a).dn as u64, " dump\n")
        (*a).dn = (*a).dn + put_kv((*a).dbuf + (*a).dn as u64, "ui_max_gap_ms_so_far=", (*a).gap_all)
        (*a).dn = (*a).dn + put_str((*a).dbuf + (*a).dn as u64, "\n")
        (*a).dstage = 0
        (*a).didx = 0
        return
    }
    let p: u64 = (*a).dbuf
    var n: usize = (*a).dn
    let ds: i32 = (*a).dstage
    if ds == 0 {
        let i: i32 = (*a).didx
        if i < (*a).nlens && i < 16 && n < 3400 {
            var id: [u8; 48] = [0 as u8; 48]
            let par: i32 = camera.camera_entry_id(i, (&id[0]) as u64)
            n = n + put_str(p + n as u64, "cam ")
            n = n + put_int(p + n as u64, i as i64)
            n = n + put_str(p + n as u64, " id=")
            var k: usize = 0
            while k < 40 && id[k] != 0 as u8 { *((p + n as u64) as *mut u8) = id[k]; n = n + 1; k = k + 1 }
            n = n + put_kv(p + n as u64, " parent=", par as i64)
            var ci: camera.CamInfo = camera.zero_info()
            if camera.camera_info(i, &ci) {
                n = n + put_kv(p + n as u64, " facing=", ci.facing as i64)
                n = n + put_kv(p + n as u64, " logical=", if (ci.caps & camera.CAP_LOGICAL) != 0 as u32 { 1 } else { 0 })
                n = n + put_str(p + n as u64, " focal_x10=")
                n = n + put_f10(p + n as u64, ci.focal_mm)
                n = n + put_kv(p + n as u64, " nfocal=", ci.focal_count as i64)
                n = n + put_str(p + n as u64, " equiv_x10=")
                n = n + put_f10(p + n as u64, ci.equiv_mm)
                n = n + put_kv(p + n as u64, " preview=", ci.prev_w as i64)
                n = n + put_kv(p + n as u64, " raw=", ci.raw_w as i64)
            } else {
                n = n + put_str(p + n as u64, " UNREADABLE (hidden physical id, no characteristics for apps)")
            }
            *((p + n as u64) as *mut u8) = 10 as u8
            n = n + 1
            (*a).didx = i + 1
        } else {
            (*a).dstage = 1
            (*a).didx = 0
        }
    } else if ds == 1 {
        // probe every small id number: a physical camera the id list does not show may still answer
        let i: i32 = (*a).didx
        if i < 20 && n < 7000 {
            var pr: [i32; 16] = [0; 16]
            let rc: i32 = camera.camera_probe_id(i, (&pr[0]) as u64)
            n = n + put_kv(p + n as u64, "probe id=", i as i64)
            n = n + put_kv(p + n as u64, " rc=", rc as i64)
            if rc == 0 {
                n = n + put_kv(p + n as u64, " facing=", pr[1] as i64)
                n = n + put_kv(p + n as u64, " hw=", pr[2] as i64)
                n = n + put_kv(p + n as u64, " caps=", pr[3] as i64)
                n = n + put_str(p + n as u64, "(1raw 2man 4logical 8ultrahires 16burst)")
                n = n + put_kv(p + n as u64, " focal_x100=", pr[4] as i64)
                n = n + put_kv(p + n as u64, " nfocal=", pr[5] as i64)
                n = n + put_kv(p + n as u64, " jpeg=", pr[6] as i64)
                n = n + put_kv(p + n as u64, "x", pr[7] as i64)
                n = n + put_kv(p + n as u64, " raw=", pr[8] as i64)
                n = n + put_kv(p + n as u64, "x", pr[9] as i64)
                n = n + put_kv(p + n as u64, " active=", pr[10] as i64)
                n = n + put_kv(p + n as u64, "x", pr[11] as i64)
                n = n + put_kv(p + n as u64, " maxres=", pr[12] as i64)
                n = n + put_kv(p + n as u64, "x", pr[13] as i64)
                n = n + put_kv(p + n as u64, " sync=", pr[14] as i64)
                n = n + put_kv(p + n as u64, " physbytes=", pr[15] as i64)
            }
            *((p + n as u64) as *mut u8) = 10 as u8
            n = n + 1
            (*a).didx = i + 1
        } else {
            n = n + put_str(p + n as u64, "concurrent_camera_ids: not readable from the NDK (Java-only API)\n")
            // the zoom sweep
            var i2: i32 = 0
            while i2 < (*a).sw_n && i2 < 16 {
                n = n + put_kv(p + n as u64, "sweep z_x10=", (*a).sw_z[i2 as usize] as i64)
                n = n + put_kv(p + n as u64, " focal_x100=", (*a).sw_f[i2 as usize] as i64)
                n = n + put_str(p + n as u64, " active_phys=")
                var k: usize = 0
                while k < 15 && (*a).sw_ph[i2 as usize][k] != 0 as u8 { *((p + n as u64) as *mut u8) = (*a).sw_ph[i2 as usize][k]; n = n + 1; k = k + 1 }
                n = n + put_kv(p + n as u64, " crop_w=", (*a).sw_cw[i2 as usize] as i64)
                *((p + n as u64) as *mut u8) = 10 as u8
                n = n + 1
                i2 = i2 + 1
            }
            n = n + put_kv(p + n as u64, "learned_switch_x10=", (*a).learn_x10 as i64)
            n = n + put_kv(p + n as u64, " on_lens=", (*a).learn_lens as i64)
            n = n + put_kv(p + n as u64, " sweep_cache_hit=", if (*a).cache_hit { 1 } else { 0 })
            *((p + n as u64) as *mut u8) = 10 as u8
            n = n + 1
            (*a).dstage = 2
            (*a).didx = 0
        }
    } else if ds == 2 {
        // tags of each scan entry: sections 13 scaler, 15 sensor info, 26 logical camera, >= 0x80000000 vendor
        let e: i32 = (*a).didx
        if e < (*a).nlens && e < 8 && n < 18000 {
            var tg: [i32; 1024] = [0; 1024]
            let nt: i32 = camera.camera_tags(e, (&tg[0]) as u64, 256)
            n = n + put_kv(p + n as u64, "tags cam=", e as i64)
            n = n + put_kv(p + n as u64, " total=", nt as i64)
            n = n + put_str(p + n as u64, ":")
            var j: i32 = 0
            while j < nt && n < 19500 {
                let tag: u32 = *((&tg[(j * 4) as usize]) as *mut u32)
                let sec: u32 = tag / (65536 as u32)
                if sec == (13 as u32) || sec == (15 as u32) || sec == (26 as u32) || tag >= (2147483648 as u32) {
                    n = n + put_str(p + n as u64, " ")
                    n = n + put_hex(p + n as u64, tag)
                    n = n + put_kv(p + n as u64, ":", tg[(j * 4 + 1) as usize] as i64)
                    n = n + put_kv(p + n as u64, ":", tg[(j * 4 + 2) as usize] as i64)
                    n = n + put_kv(p + n as u64, ":", tg[(j * 4 + 3) as usize] as i64)
                }
                j = j + 1
            }
            *((p + n as u64) as *mut u8) = 10 as u8
            n = n + 1
            (*a).didx = e + 1
        } else {
            (*a).dstage = 3
        }
    } else {
        var zmin: f32 = 0.0f
        var zmax: f32 = 0.0f
        camera.camera_zoom_range(&zmin, &zmax)
        n = n + put_kv(p + n as u64, "open lens=", (*a).lens as i64)
        n = n + put_str(p + n as u64, " zoom_range_x10=")
        n = n + put_f10(p + n as u64, zmin)
        n = n + put_str(p + n as u64, "..")
        n = n + put_f10(p + n as u64, zmax)
        n = n + put_str(p + n as u64, " chips=")
        var i: i32 = 0
        while i < (*a).nchip {
            n = n + put_int(p + n as u64, (*a).chip_x10[i as usize] as i64)
            if (*a).chip_opt[i as usize] == 1 { n = n + put_str(p + n as u64, "o ") } else { n = n + put_str(p + n as u64, "d ") }
            i = i + 1
        }
        *((p + n as u64) as *mut u8) = 10 as u8
        n = n + 1
        var name: [u8; 48] = [0 as u8; 48]
        let nn: usize = name_into((&name[0]) as u64, "firncam-cameras", ".txt")
        let mime: str = "text/plain\0"
        mark(a, P_SAVE)
        let r: i32 = camera.camera_save_doc(p, n, (&name[0]) as u64, mime.p as u64)
        camera.camera_free(p, DUMP_CAP)
        (*a).dbuf = 0
        (*a).bt_state = BT_DONE
    }
    (*a).dn = n
}

// ---------------------------------------------------------------- state -> UI
fn put_str(dst: u64, s: str) -> usize {
    var i: usize = 0
    while i < s.n { *((dst + i as u64) as *mut u8) = *((s.p as u64 + i as u64) as *mut u8); i = i + 1 }
    return s.n
}

// the label of a manual row (max 23 octets)
fn row_text(a: *mut App, kind: i32, dst: *mut [u8; 24]) -> usize {
    let p: u64 = (&(*dst)[0]) as u64
    var ln: usize = 0
    if kind == 0 {
        ln = put_str(p, "ISO ")
        ln = ln + put_int(p + ln as u64, man_iso(a) as i64)
    } else if kind == 1 {
        ln = put_str(p, "1/")
        let e: i64 = man_exp(a)
        var d: i64 = 1000000000 / (if e > 0 { e } else { 1 })
        if d < 1 { d = 1 }
        ln = ln + put_int(p + ln as u64, d)
        ln = ln + put_str(p + ln as u64, " S")
    } else {
        let fd: f32 = man_focus(a)
        if fd < 0.05f {
            ln = put_str(p, "FOCUS INF")
        } else {
            ln = put_str(p, "FOCUS ")
            ln = ln + put_int(p + ln as u64, (100.0f / fd) as i64)
            ln = ln + put_str(p + ln as u64, " CM")
        }
    }
    return ln
}

// 0 = at 1x / unknown, 1 = the picture is a digital crop, 2 = another lens serves the zoom (optical). A logical camera
// that switches its physical lens reports that lens's focal length in every result; the one seen at ratio 1 is the base.
fn zoom_mode(a: *mut App) -> i32 {
    if !(*a).ready { return 0 }
    let f: f32 = camera.camera_active_focal()
    let r: f32 = camera.camera_get_zoom()
    if f > 0.0f && (*a).foc1 <= 0.0f && r > 0.98f && r < 1.02f { (*a).foc1 = f }
    if r > 0.98f && r < 1.02f && (*a).ph1[0] == 0 as u8 { let q0: usize = camera.camera_result_phys((&(*a).ph1[0]) as u64) }
    let zf: f32 = camera.camera_zoom_factor()
    if zf > 0.95f && zf < 1.05f { return 0 }
    if zf < 0.95f { return 2 }
    var ph: [u8; 16] = [0 as u8; 16]
    let pn: usize = camera.camera_result_phys((&ph[0]) as u64)
    if pn > 0 && (*a).ph1[0] != 0 as u8 && !same16(&ph, &(*a).ph1) { return 2 }
    if f > 0.0f && (*a).foc1 > 0.0f {
        let q: f32 = f / (*a).foc1
        if q > 1.15f || q < 0.87f { return 2 }
    }
    if r <= 1.05f { return 2 }
    return 1
}

fn sync_ui(a: *mut App, u: *mut ui.Ui) {
    // every mode is a tab (Xiaomi-style bar); the ones this device cannot do are dimmed and not selectable
    var i: i32 = 0
    while i <= M_RAW {
        (*u).modes[i as usize] = i
        (*u).moff[i as usize] = 0
        if !mode_ok(a, i) { (*u).moff[i as usize] = 1 }
        i = i + 1
    }
    (*u).nmodes = M_RAW + 1
    (*u).mode = (*a).mode
    (*u).man_ok = man_ok(a) && (*a).ready
    (*u).manual = (*a).manual && (*a).ready
    var rows: [i32; 3] = [0; 3]
    let nr: i32 = if (*a).ready { rows_of(a, &rows) } else { 0 }
    (*u).nrows = nr
    i = 0
    while i < nr {
        (*u).rows[i as usize] = rows[i as usize]
        (*u).row_n[i as usize] = row_text(a, rows[i as usize], &(*u).row_txt[i as usize])
        i = i + 1
    }
    i = 0
    let nch: i32 = if (*a).wop == W_OPEN { 0 } else { (*a).nchip } // the worker rebuilds the chips during an open
    (*u).nchips = nch
    while i < nch {
        (*u).chips[i as usize].idx = (*a).chip_idx[i as usize]
        (*u).chips[i as usize].x10 = (*a).chip_x10[i as usize]
        (*u).chips[i as usize].opt = (*a).chip_opt[i as usize]
        (*u).chips[i as usize].sel = false
        i = i + 1
    }
    (*u).can_flip = (*a).can_flip
    (*u).busy = (*a).busy
    (*u).recording = (*a).recording
    if (*a).busy && (*a).wop == W_SHOT {
        (*u).progress = camjob.job_progress(&(*a).job) as i32
    } else {
        (*u).progress = 0
    }
    if (*a).have_thumb {
        (*u).thumb_px = (*a).thumb
        (*u).thumb_w = THUMB
        (*u).thumb_h = THUMB
        (*u).thumb_key = (*a).tkey
    }
    if (*a).st_new {
        (*a).st_new = false
        ui.ui_status(u, status_str(a))
    }
}

// ---------------------------------------------------------------- commands from the UI
// Tap on the preview (fx, fy in 0..1 of the preview rectangle) -> point of the upright sensor picture.
fn do_focus(a: *mut App, fx: f64, fy: f64, pvw: i32, pvh: i32) {
    if !(*a).ready || (*a).recording { return }
    var sw: i32 = 0
    var sh: i32 = 0
    camera.camera_stream_size(1, &sw, &sh)
    if sw <= 0 || sh <= 0 { return }
    let front: bool = camera.camera_is_front()
    let sens: i32 = camera.camera_sensor_rotation()
    let rot: i32 = campreview.cp_rotation(sens, (*a).disp, front)
    var pl: campreview.Plan = campreview.Plan { crop: [0.0; 4], m: [0.0; 4], t: [0.0; 2], quad: [1.0; 2], rot: 0 }
    campreview.cp_plan(sw, sh, rot, front, pvw, pvh, true, &pl)
    var sx: f64 = 0.0
    var sy: f64 = 0.0
    campreview.cp_map(&pl, fx, fy, &sx, &sy)
    // sensor point -> the picture rotated by the lens orientation only (what camera_focus_at takes; no mirror)
    var up: campreview.Plan = campreview.Plan { crop: [0.0; 4], m: [0.0; 4], t: [0.0; 2], quad: [1.0; 2], rot: 0 }
    campreview.cp_plan(sw, sh, sens, false, 1, 1, true, &up)
    let dx: f64 = sx - up.t[0]
    let dy: f64 = sy - up.t[1]
    let nx: f64 = up.m[0] * dx + up.m[2] * dy
    let ny: f64 = up.m[1] * dx + up.m[3] * dy
    let e: i32 = camera.camera_focus_at(nx as f32, ny as f32, false, true)
    if e == camera.E_UNSUPPORTED { set_status(a, "NO AUTOFOCUS") }
}

// Pinch / double tap: zoom in the user scale (1.0 = main lens). The camera zooms (ratio, lens choice); only when
// it cannot, the preview shader crops digitally. After a real zoom the shader zoom stays at 1.
fn do_zoom(a: *mut App, cv: *mut camview.CamView, z: f64) {
    sweep_abort(a, false) // the user's zoom wins; it is applied below
    if !(*a).ready || (*a).wop != W_NONE {
        camview.camview_zoom(cv, z)
        return
    }
    var ratio: f32 = z as f32
    if locked(a) {
        camview.camview_zoom(cv, z)
        return
    }
    let lens: i32 = camera.camera_zoom_lens(z as f32, &ratio)
    (*a).zr = ratio
    if lens >= 0 && lens != (*a).lens && lens < 16 && (*a).lfac[lens as usize] == (*a).info.facing && !(*a).recording {
        // another lens: the worker opens it, then the ratio is put back
        open_lens_keep(a, lens, ratio)
        camview.camview_zoom(cv, 1.0)
        return
    }
    let e: i32 = camera.camera_set_zoom(ratio)
    if e == camera.E_OK {
        (*a).zr = ratio
        camview.camview_zoom(cv, 1.0)
        // crossing 1.05x changes the still stream kind (RAW burst <-> JPEG): rebuild the session, keep the ratio
        if (*a).ready && want_kind(a) != (*a).kind && !(*a).recording {
            open_lens_keep(a, (*a).lens, ratio)
        }
    } else {
        camview.camview_zoom(cv, z)
    }
}

fn reset_zoom(a: *mut App, u: *mut ui.Ui, cv: *mut camview.CamView) {
    camview.camview_zoom(cv, 1.0)
    var z: f64 = 1.0
    if (*a).ready { z = camera.camera_zoom_factor() as f64 }
    ui.ui_set_zoom(u, z)
}

fn change_mode(a: *mut App, nm: i32) {
    if nm == (*a).mode || locked(a) { return }
    (*a).mode = nm
    if !man_ok(a) { (*a).manual = false }
    if want_kind(a) != (*a).kind || nm == M_VIDEO || (*a).fl_last > 0 {
        open_lens(a, (*a).lens)
    } else {
        apply_manual(a)
        let fe: i32 = apply_flash(a)
    }
}

// A lens switch: now when the camera is free; while a shot runs the shot is aborted (no leak: worker_tick releases its
// buffers) and the lens opens right after it.
fn request_lens(a: *mut App, idx: i32) {
    if (*a).wop == W_NONE {
        open_lens(a, idx)
    } else if (*a).wop == W_SHOT || (*a).wop == W_PLAIN {
        (*a).defer_lens = idx
        worker_abort(a)
    }
}

fn flip_lens(a: *mut App) {
    let want: i32 = if (*a).info.facing == 1 { 0 } else { 1 }
    let idx: i32 = (*a).main_lens[want as usize]
    if idx >= 0 { request_lens(a, idx) }
}

fn run_cmd(a: *mut App, u: *mut ui.Ui, cv: *mut camview.CamView, c: *mut ui.Cmd, pvw: i32, pvh: i32) {
    let k: i32 = (*c).kind
    if k == ui.C_SHOT {
        if (*a).mode == M_VIDEO {
            toggle_video(a)
        } else if !(*a).recording && !locked(a) {
            snap_thumb(a)
            shoot(a)
        }
    } else if k == ui.C_MODE {
        if !(*a).recording && !locked(a) {
            change_mode(a, (*c).a)
            reset_zoom(a, u, cv)
        }
    } else if k == ui.C_LENS {
        if !(*a).recording && (*c).a >= 0 && (*c).a < (*a).nlens {
            request_lens(a, (*c).a)
            reset_zoom(a, u, cv)
        }
    } else if k == ui.C_STOP {
        if !locked(a) {
            let sz: f64 = ((*c).a as f64) / 10.0
            do_zoom(a, cv, sz)
            ui.ui_set_zoom(u, sz)
        }
    } else if k == ui.C_FLIP {
        if !(*a).recording {
            flip_lens(a)
            reset_zoom(a, u, cv)
        }
    } else if k == ui.C_FLASH {
        (*a).flash = (*c).a
        if locked(a) {
            // a shot or an open runs: the flash is applied by the next open / shot
        } else if want_kind(a) != (*a).kind && !(*a).recording {
            open_lens(a, (*a).lens)
        } else {
            let e: i32 = apply_flash(a)
            if e == camera.E_UNSUPPORTED {
                (*a).flash = 0
                (*u).flash = 0
                (*a).fl_last = camera.FLASH_OFF
                set_status(a, "NO FLASH")
            }
        }
    } else if k == ui.C_MAN {
        if !(*a).recording && !locked(a) && man_ok(a) {
            (*a).manual = !(*a).manual
            if (*a).manual {
                if want_kind(a) != (*a).kind { open_lens(a, (*a).lens) } else { apply_manual(a) }
            } else if want_kind(a) != (*a).kind {
                open_lens(a, (*a).lens)
            } else {
                let e: i32 = camera.camera_set_auto()
            }
        }
    } else if k == ui.C_SLIDER {
        if (*c).a >= 0 && (*c).a < 3 {
            (*a).sl[(*c).a as usize] = (*c).b
            (*a).pend_sl[(*c).a as usize] = (*c).b
        }
    } else if k == ui.C_ZOOM {
        (*a).pend_zoom = (*c).f
    } else if k == ui.C_FOCUS {
        do_focus(a, (*c).f, (*c).g, pvw, pvh)
    } else if k == ui.C_GALLERY {
        if !camera.camera_open_gallery() { set_status(a, "NO GALLERY APP") }
    }
}

// ---------------------------------------------------------------- log (adb logcat -s firncam)
#[no_gc]
#[link_name(__android_log_write)]
extern fn log_write(prio: i32, tag: u64, text: u64) -> i32;

#[link_name(__system_property_get)]
extern fn sys_prop_get(name: u64, value: u64) -> i32;

// `adb shell setprop debug.firncam.cpu 1` forces the CPU preview path (test of the no-GPU fallback).
fn cpu_forced() -> bool {
    return prop_is_one("debug.firncam.cpu\0")
}

fn prop_is_one(name: str) -> bool {
    var v: [u8; 96] = [0 as u8; 96]
    let n: i32 = sys_prop_get(name.p as u64, (&v[0]) as u64)
    return n > 0 && v[0] == 49 as u8
}

// `adb shell setprop debug.firncam.sweep 1` runs the zoom sweep on any back camera on every start (test of the UI-thread
// gap gate: an emulator camera is not a logical multi camera, so the sweep would not run there otherwise).
fn sweep_forced() -> bool {
    return prop_is_one("debug.firncam.sweep\0")
}

// A new section of the main loop starts: the one that ran so far is timed, and the longest section of the turn is kept
// (slow_phase) -- the gap log names the section that blocked, not just the last one that started.
fn mark(a: *mut App, ph: i32) {
    let t: i64 = fuishell.shell_now_ms()
    let d: i64 = t - (*a).ph_t0
    if d > (*a).slow_ms { (*a).slow_ms = d; (*a).slow_phase = (*a).phase }
    (*a).phase = ph
    (*a).ph_t0 = t
}

// One line per main-loop turn that took longer than GAP_WARN_MS: the UI thread was blocked (an input queue that is not
// read for 5 s is an ANR). phase = what ran (P_*).
fn log_gap(ms: i64, phase: i32, phase_ms: i64) {
    var b: [u8; 96] = [0 as u8; 96]
    let p: u64 = (&b[0]) as u64
    var n: usize = put_str(p, "gap ms=")
    n = n + put_int(p + n as u64, ms)
    n = n + put_str(p + n as u64, " phase=")
    n = n + put_int(p + n as u64, phase as i64)
    n = n + put_str(p + n as u64, " phase_ms=")
    n = n + put_int(p + n as u64, phase_ms)
    let tag: str = "firncam\0"
    let r: i32 = log_write(4, tag.p as u64, p)
}

fn log_stats(ui_n: i64, cam_n: i64, ms: i64, w: i32, h: i32, rot: i32, gpu: bool, gap_max: i64, gap_phase: i32) {
    var b: [u8; 224] = [0 as u8; 224]
    let p: u64 = (&b[0]) as u64
    var n: usize = put_str(p, "ui_fps=")
    n = n + put_int(p + n as u64, ui_n * 1000 / ms)
    n = n + put_str(p + n as u64, " cam_fps=")
    n = n + put_int(p + n as u64, cam_n * 1000 / ms)
    n = n + put_str(p + n as u64, " preview=")
    n = n + put_int(p + n as u64, w as i64)
    n = n + put_str(p + n as u64, "x")
    n = n + put_int(p + n as u64, h as i64)
    n = n + put_str(p + n as u64, " rot=")
    n = n + put_int(p + n as u64, rot as i64)
    if gpu { n = n + put_str(p + n as u64, " gpu") } else { n = n + put_str(p + n as u64, " cpu") }
    n = n + put_str(p + n as u64, " max_gap=")
    n = n + put_int(p + n as u64, gap_max)
    n = n + put_str(p + n as u64, " gap_phase=")
    n = n + put_int(p + n as u64, gap_phase as i64)
    var ex: [i64; 2] = [0; 2]
    if camera.camera_last_exposure(&ex) {
        n = n + put_str(p + n as u64, " exp_us=")
        n = n + put_int(p + n as u64, ex[0] / 1000)
        n = n + put_str(p + n as u64, " iso=")
        n = n + put_int(p + n as u64, ex[1])
    }
    let tag: str = "firncam\0"
    let r: i32 = log_write(4, tag.p as u64, p)
}

fn display_deg() -> i32 {
    let d: i32 = display.display_rotation()
    if d < 0 { return 0 }
    return d
}

#[allow_escape]
fn main() -> i32 {
    var s: fuishell.Shell = fuishell.shell_new()
    if !fuishell.shell_open(&s, "FirnCam", 480, 800) { return 1 }
    let f: *mut window.Window = fuishell.shell_window(&s)
    let nthreads: u64 = par.init(3) // pool workers are raw-clone threads; the runtime keeps bionic's thread pointer

    var a: App = App {
        nlens: 0, lens: 0, mode: M_PHOTO, manual: false, sl: [500, 500, 0], kind: 0, ready: false,
        status: [0 as u8; 64], st_new: false, info: camera.zero_info(), shots: 0, recording: false,
        job: camjob.job_new(), busy: false, th: 0, cbuf: 0, ccap: 0, fbuf: 0, stamp0: 0, tattr: [0; 16], ttid: 0, wreq: 0,
        stage: 0, cap_n: 0, cap_i: 0, cap_at: 0, steps: [0.0f; 16], bs: [0; 16],
        flash: 0, fl_last: 0 - 1, disp: 0, thumb: 0, pthumb: 0, sthumb: 0, tkey: 0, have_thumb: false, have_p: false,
        have_s: false, nframe: 0, lfac: [0 - 1; 16], lmm: [0.0f; 16], main_lens: [0 - 1; 3], chip_idx: [0; 6],
        phase: 0, ph_t0: 0, slow_ms: 0, slow_phase: 0, gap_max: 0, gap_phase: 0, gap_all: 0, bt_state: 0, bt_at: 0, sw_run: 0, sw_stage: 0, sw_sub: 0, sw_z10: 10,
        sw_t0: 0, sw_c0: 0, sw_ci: 0, sw_same: 10, sw_diff: 0, sw_guard: 0, cache_hit: false, dbuf: 0, dn: 0, dstage: 0, didx: 0,
        wop: 0, wdone: 0, wabort: 0, warg: 0, wstat: 0, wsave: 0 - 1, wtxt: 0, wres: 0, wseen: 0, wt0: 0, o_keep: 0.0f, o_first: false,
        defer_lens: 0 - 1, lost_at: 0, vok: false, wname: [0 as u8; 48], pexp: 0, piso: 0, pfoc: 0.0f, phave_e: false, phave_f: false,
        pflash: false, sbuf: 0, scap: 0, sdbuf: 0, sdcap: 0, sptr: 0, sn: 0,
        chip_x10: [10; 6], chip_opt: [0; 6], foc1: 0.0f, nchip: 0, learn_x10: 0, learn_lens: 0 - 1, swept: false, sw_n: 0, sw_z: [0; 16], sw_f: [0; 16], sw_cw: [0; 16], sw_ph: [[0 as u8; 16]; 16], ph1: [0 as u8; 16], can_flip: false, cpu: 0, cpu_cap: 0, pend_zoom: 0.0 - 1.0, zr: 1.0f, pend_sl: [0 - 1; 3],
    }
    a.thumb = camera.camera_alloc(THUMB_BYTES)
    a.pthumb = camera.camera_alloc(THUMB_BYTES)
    a.sthumb = camera.camera_alloc(THUMB_BYTES)
    if a.thumb == 0 || a.pthumb == 0 || a.sthumb == 0 { return 2 }
    var u: ui.Ui = ui.ui_new()
    var cv: camview.CamView = camview.camview_new()
    var tg: kittouch.Touch = kittouch.tg_new()
    var pf: camera.PreviewFrame = camera.preview_frame_new()
    var gen: u32 = 0 as u32
    a.disp = display_deg()
    set_status(&a, "NO PERMISSION")
    var asked: bool = false
    var open: bool = true
    var turn: i64 = 0
    var scan_wait: i64 = 0
    var t_log: i64 = fuishell.shell_now_ms()
    var prev_ms: i64 = 0
    var n_all: i64 = 0 // frames drawn since the start
    var n_ui: i64 = 0
    var n_cam: i64 = 0
    var pvx: i32 = 0
    var pvy: i32 = 0
    var pvw: i32 = 0
    var pvh: i32 = 0
    var rot: i32 = 0
    while open {
        turn = turn + 1
        let now: i64 = fuishell.shell_now_ms()
        mark(&a, P_IDLE) // closes the section that ran last
        if prev_ms > 0 {
            let gap: i64 = now - prev_ms
            if gap > a.gap_max { a.gap_max = gap; a.gap_phase = a.slow_phase }
            if gap > a.gap_all { a.gap_all = gap }
            if gap >= GAP_WARN_MS { log_gap(gap, a.slow_phase, a.slow_ms) }
        }
        prev_ms = now
        a.slow_ms = 0
        a.slow_phase = P_IDLE
        a.ph_t0 = fuishell.shell_now_ms()
        // the scan waits for the first frames: they create the GL objects (seconds on a software GL) and a block here would add up
        if !a.ready && a.nlens == 0 && turn >= scan_wait && n_all >= 4 {
            scan_wait = turn + 60
            if camera.camera_permission() == 1 {
                mark(&a, P_SCAN)
                a.nlens = camera.camera_scan()
                if a.nlens > 0 {
                    scan_lenses(&a)
                    let first: i32 = if a.main_lens[1] >= 0 { a.main_lens[1] } else { 0 }
                    mark(&a, P_OPEN)
                    a.o_first = true // worker_tick starts the boot work when the camera is open
                    open_lens(&a, first)
                } else {
                    set_status(&a, "NO CAMERA")
                }
            } else if !asked {
                asked = true
                camera.camera_request_permission()
            }
        }
        worker_tick(&a, &u, &cv, now)
        // the camera was taken away (app in the background): open it again, at most every REOPEN_MS
        let gone: bool = (a.ready && !camera.camera_is_open()) || (!a.ready && a.lost_at > 0)
        if gone && a.wop == W_NONE && !a.recording && now - a.lost_at >= REOPEN_MS {
            a.lost_at = now
            open_lens(&a, a.lens)
        }
        if n_all >= 6 { boot_tick(&a, &u, &cv, now) }
        if gen != fuishell.shell_gen(&s) {
            // the GPU was (re)started: the surface is new (pause / resume). A running shot is cancelled, not left half done.
            if a.wop == W_SHOT || a.wop == W_PLAIN { worker_abort(&a) }
            gen = fuishell.shell_gen(&s)
            mark(&a, P_GL)
            if fuishell.shell_gpu_on(&s) && !cpu_forced() { let go: bool = camview.camview_open(&cv, fuishell.shell_gl(&s)) }
        }
        if turn % 90 == 0 { a.disp = display_deg() }

        // ---- input
        mark(&a, P_UI)
        sync_ui(&a, &u)
        ui.ui_prepare(&u, fuishell.shell_w(&s) as i32, fuishell.shell_h(&s) as i32, fuishell.shell_dp(&s), now)
        window.wait_event(f, 8)
        var pr: pointers.Pointer = pointers.ptr_blank()
        while window.next_pointer(f, (&pr) as u64) {
            ui.ui_pointer(&u, &pr)
            kittouch.tg_feed(&tg, &pr)
        }
        var k: u32 = window.next_event(f)
        while k != window.EV_NONE {
            if k == window.EV_CLOSED { open = false }
            if k == window.EV_KEY && window.ev_a(f) == window.K_ESCAPE { open = false }
            if k == window.EV_CONFIGURE {
                mark(&a, P_GL) // the GL surface is rebuilt
                if !fuishell.shell_resize(&s) { return 3 }
                a.disp = display_deg()
            }
            k = window.next_event(f)
        }
        let tk: bool = kittouch.tg_tick(&tg, now)
        var ge: kittouch.Gesture = kittouch.gesture_blank()
        while kittouch.tg_next(&tg, &ge) {
            ui.ui_gesture(&u, &ge)
        }
        ui.ui_update(&u)

        // ---- commands (the zoom and the sliders only once per turn: a pinch makes dozens)
        ui.ui_preview_rect(&u, &pvx, &pvy, &pvw, &pvh)
        a.pend_zoom = 0.0 - 1.0
        a.pend_sl = [0 - 1; 3]
        var cm: ui.Cmd = ui.Cmd { kind: 0, a: 0, b: 0, f: 0.0, g: 0.0 }
        while ui.ui_take(&u, &cm) {
            mark(&a, P_ZOOM)
            run_cmd(&a, &u, &cv, &cm, pvw, pvh)
        }
        if a.pend_zoom > 0.0 { mark(&a, P_ZOOM); do_zoom(&a, &cv, a.pend_zoom) }
        if a.pend_sl[0] >= 0 || a.pend_sl[1] >= 0 || a.pend_sl[2] >= 0 { apply_manual(&a) }
        // a lens or mode change may have moved the preview rectangle: ask again
        sync_ui(&a, &u)
        ui.ui_preview_rect(&u, &pvx, &pvy, &pvw, &pvh)

        // ---- the camera picture
        // the first frames create the GL objects and compile the shaders (seconds on a software GL, ms on a GPU)
        if n_all < 4 { mark(&a, P_GL) } else { mark(&a, P_PREVIEW) }
        var mirror: bool = false
        if a.ready {
            mirror = camera.camera_is_front()
            rot = campreview.cp_rotation(camera.camera_sensor_rotation(), a.disp, mirror)
            if camview.camview_on(&cv) {
                let got: i32 = camera.camera_preview_acquire(&pf)
                if got == 1 {
                    n_cam = n_cam + 1
                    a.nframe = a.nframe + 1
                    let fed: bool = camview.camview_feed(&cv, pf.w, pf.h, pf.yp, pf.ys, pf.up, pf.vp, pf.us, pf.vs, pf.ups)
                    if a.nframe % 12 == 1 {
                        if camview.camview_thumb(pf.w, pf.h, pf.yp, pf.ys, pf.up, pf.vp, pf.us, pf.vs, pf.ups, rot, mirror, a.pthumb, THUMB, THUMB, 20.0) {
                            a.have_p = true
                        }
                    }
                    camera.camera_preview_release(&pf)
                } else if got < 0 {
                    camera.camera_preview_release(&pf)
                }
            } else if pvw > 0 && pvh > 0 {
                // no GPU: CPU picture of the preview rectangle (BGRX, upright)
                let need: usize = (pvw as usize) * (pvh as usize) * 4
                if a.cpu_cap < need {
                    if a.cpu != 0 { camera.camera_free(a.cpu, a.cpu_cap) }
                    a.cpu = camera.camera_alloc(need)
                    a.cpu_cap = if a.cpu != 0 { need } else { 0 }
                }
                if a.cpu != 0 && camera.camera_preview_bgrx(a.cpu, pvw, pvh, rot, mirror) == 1 {
                    n_cam = n_cam + 1
                    let cp: bool = camview.camview_cpu(&cv, a.cpu, pvw, pvh)
                }
            }
        }
        if camview.camview_on(&cv) && pvw > 0 && pvh > 0 {
            let rr: bool = camview.camview_render(&cv, pvw, pvh, rot, mirror)
        }

        // ---- draw
        // glyph atlas / painter shaders are built by the first draws (software GL: seconds) -> counted as GL warm-up
        if n_all < 30 { mark(&a, P_GL) } else { mark(&a, P_DRAW) }
        fuishell.shell_begin(&s)
        let z: *mut painter.Painter = fuishell.shell_painter(&s)
        painter.painter_clear(z, 0xFF000000 as u32)
        let drawn: bool = camview.camview_draw(&cv, z, fuishell.shell_gpu(&s), pvx as f64, pvy as f64, pvw as f64, pvh as f64)
        ui.ui_draw(&u, z)
        fuishell.shell_end(&s)
        n_ui = n_ui + 1
        n_all = n_all + 1
        if now - t_log >= 3000 {
            log_stats(n_ui, n_cam, now - t_log, pvw, pvh, rot, camview.camview_on(&cv), a.gap_max, a.gap_phase)
            a.gap_max = 0
            t_log = now
            n_ui = 0
            n_cam = 0
        }
    }
    worker_stop(&a)
    if a.recording { let okv: bool = camera.camera_video_stop() }
    camera.camera_close()
    par.shutdown()
    fuishell.shell_close(&s)
    return 0
}
