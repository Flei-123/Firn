// SPDX-License-Identifier: MPL-2.0
// examples/firncam -- FirnCam app: preview, mode bar (PHOTO = auto HDR burst, NIGHT, PORTRAIT, DOC scan + PDF,
// STACK = focus stack, VIDEO, RAW = DNG), manual sliders (ISO / exposure / focus), lens switch. The processing
// of a shot (photo.camjob: merge, tone, bokeh, scan, JPEG encode) runs on a job thread with a progress bar;
// the result goes to MediaStore as JPEG. Modes and sliders only appear when the lens can do them.
// Everything about the device comes from the CameraCharacteristics (lib/plat/android/camera.fi).
//   bash tools/android/build.sh examples/firncam/main.fi --camera --name FirnCam --package org.firn.cam
// The UI is drawn into one BGRX buffer with a tiny built-in bitmap font (the Android window layer has
// no system text), then shown with window.image.
import window.window
import plat.android.camera
import plat.android.dngwrite
import photo.meta
import photo.camjob
import photo.focus
import photo.par
import jobs.jobs
import std.rt
import std.math
import android.ndk

static GLYPHS: [u8; 1652] = ""

const FIRST_GLYPH: u32 = 32
const GLYPH_COUNT: u32 = 59

fn hexv(c: u8) -> u32 {
    let v: u32 = c as u32
    if v >= 97 { return v - 87 }
    return v - 48
}

fn glyph_row(ch: u32, row: u32) -> u32 {
    var c: u32 = ch
    if c >= 97 && c <= 122 { c = c - 32 }
    if c < FIRST_GLYPH || c >= FIRST_GLYPH + GLYPH_COUNT { c = 63 }
    let at: usize = (((c - FIRST_GLYPH) * 28 + row * 2) as usize)
    return hexv(GLYPHS[at]) * 16 + hexv(GLYPHS[at + 1])
}

fn px_rect(buf: u64, bw: i32, bh: i32, x0: i32, y0: i32, w: i32, h: i32, col: u32) {
    var y: i32 = y0
    while y < y0 + h {
        if y >= 0 && y < bh {
            var x: i32 = x0
            while x < x0 + w {
                if x >= 0 && x < bw {
                    *((buf + (((y * bw + x) * 4) as u64)) as *mut u32) = col
                }
                x = x + 1
            }
        }
        y = y + 1
    }
}

fn draw_text(buf: u64, bw: i32, bh: i32, x0: i32, y0: i32, sc: i32, col: u32, s: str) {
    var i: usize = 0
    while i < s.n {
        let ch: u32 = (*((s.p as u64 + i as u64) as *mut u8)) as u32
        var row: u32 = 0
        while row < 14 {
            let bits: u32 = glyph_row(ch, row)
            var cx: u32 = 0
            while cx < 8 {
                if ((bits >> (7 - cx)) & 1) != 0 {
                    px_rect(buf, bw, bh, x0 + (i as i32) * 8 * sc + (cx as i32) * sc, y0 + (row as i32) * sc, sc, sc, col)
                }
                cx = cx + 1
            }
            row = row + 1
        }
        i = i + 1
    }
}

fn text_w(s: str, sc: i32) -> i32 { return (s.n as i32) * 8 * sc }

// Writes decimal `v` into dst (zero terminated), returns the length.
fn put_int(dst: u64, v: i64) -> usize {
    var tmp: [u8; 24] = [0 as u8; 24]
    var n: usize = 0
    var x: i64 = v
    if x < 0 { x = 0 - x }
    if x == 0 { tmp[0] = 48 as u8; n = 1 }
    while x > 0 {
        tmp[n] = (48 + (x % 10)) as u8
        x = x / 10
        n = n + 1
    }
    var o: usize = 0
    if v < 0 { *(dst as *mut u8) = 45 as u8; o = 1 }
    var i: usize = 0
    while i < n {
        *((dst + (o + i) as u64) as *mut u8) = tmp[n - 1 - i]
        i = i + 1
    }
    *((dst + (o + n) as u64) as *mut u8) = 0 as u8
    return o + n
}

const JOB_KIND: u64 = 77
const JOB_STACK: usize = 16 * 1024 * 1024    // job thread stack

// The job thread is a bionic pthread that attaches to the Firn runtime (thread_attach): a raw-clone thread of
// thread_start shares bionic's thread pointer and crashes the app on Android.
extern fn pthread_create(tid: u64, attr: u64, start: u64, arg: u64) -> i32;
extern fn usleep(us: u32) -> i32;
extern fn pthread_attr_init(attr: u64) -> i32;
extern fn pthread_attr_setstacksize(attr: u64, n: usize) -> i32;
extern fn pthread_attr_setdetachstate(attr: u64, state: i32) -> i32;
const BUDGET: usize = 400 * 1024 * 1024    // capture buffer budget of one shot

const M_PHOTO: i32 = 0
const M_NIGHT: i32 = 1
const M_PORTRAIT: i32 = 2
const M_DOC: i32 = 3
const M_STACK: i32 = 4
const M_VIDEO: i32 = 5
const M_RAW: i32 = 6

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == jobs.WORKER_KIND { return jobs.worker_main(arg) }
    if kind == JOB_KIND { return camjob.job_entry(arg) }
    return 0
}

struct App {
    w: i32,
    h: i32,
    scr: u64,
    prev: u64,
    pw: i32,
    ph: i32,
    nlens: i32,
    lens: i32,
    mode: i32,
    manual: bool,
    sl: [i32; 3],          // slider positions 0..1000: ISO, exposure, focus
    drag: i32,             // slider row being dragged, -1 none
    kind: i32,
    ready: bool,
    status: [u8; 64],
    info: camera.CamInfo,
    shots: i32,
    recording: bool,
    job: camjob.Job,
    busy: bool,
    th: u64,
    cbuf: u64,             // capture buffer of the running job
    ccap: usize,
    fbuf: u64,             // FrameInfo array of the running job
    stamp0: i64,
    tattr: [u64; 16],      // pthread_attr_t
    ttid: u64,
    wreq: u64,             // job requests counter the job thread watches
    stage: i32,            // 0 idle, 1 capturing (UI thread, one frame per loop), 2 processing (job thread)
    cap_n: i32,
    cap_i: i32,
    cap_at: usize,
    steps: [f32; 16],      // focus diopters of a focus stack
    bs: [u64; 16],         // start of each captured frame
}

fn set_status(a: *mut App, s: str) {
    var i: usize = 0
    while i < s.n && i < 63 {
        (*a).status[i] = *((s.p as u64 + i as u64) as *mut u8)
        i = i + 1
    }
    (*a).status[i] = 0 as u8
}

fn status_str(a: *mut App) -> str {
    var n: usize = 0
    while n < 63 && (*a).status[n] != 0 as u8 { n = n + 1 }
    var s: str = ""
    s.p = (&(*a).status[0]) as u64 as *mut u8
    s.n = n
    return s
}

// ---------------------------------------------------------------- what this lens can do
fn has_raw(a: *mut App) -> bool {
    return ((*a).info.caps & camera.CAP_RAW) != 0 as u32 && (*a).info.raw_w > 0
}

fn raw_frame_bytes(a: *mut App) -> usize {
    return ((*a).info.raw_w as usize) * ((*a).info.raw_h as usize) * 2 + 4096
}

// RAW bursts only when at least 3 frames fit the budget (huge sensors fall back to JPEG)
fn raw_burst_ok(a: *mut App) -> bool {
    return has_raw(a) && raw_frame_bytes(a) * 3 <= BUDGET
}

fn has_man_sensor(a: *mut App) -> bool {
    return ((*a).info.caps & camera.CAP_MANUAL_SENSOR) != 0 as u32 && (*a).info.iso_max > 0 && (*a).info.exp_max_ns > 0 as i64
}

fn has_man_focus(a: *mut App) -> bool {
    return ((*a).info.caps & camera.CAP_MANUAL_FOCUS) != 0 as u32 && (*a).info.min_focus_d > 0.0f
}

fn mode_ok(a: *mut App, m: i32) -> bool {
    if m == M_STACK { return has_man_focus(a) && (*a).info.min_focus_d >= 1.0f }    // a real focus range, else nothing to stack
    if m == M_VIDEO { return (*a).info.vid_w > 0 }
    if m == M_RAW { return has_raw(a) }
    return true
}

// visible modes in bar order; returns the count
fn visible(a: *mut App, out: *mut [i32; 8]) -> i32 {
    var n: i32 = 0
    var m: i32 = 0
    while m <= M_RAW {
        if mode_ok(a, m) { (*out)[n as usize] = m; n = n + 1 }
        m = m + 1
    }
    return n
}

fn man_ok(a: *mut App) -> bool {
    return (has_man_sensor(a) || has_man_focus(a)) && ((*a).mode == M_PHOTO || (*a).mode == M_RAW)
}

// session kind for the current mode / lens
fn want_kind(a: *mut App) -> i32 {
    let m: i32 = (*a).mode
    if m == M_RAW { if has_raw(a) { return camera.KIND_RAW } else { return camera.KIND_JPEG } }
    if m == M_VIDEO { return camera.KIND_JPEG }
    if (*a).manual && m == M_PHOTO { return camera.KIND_JPEG }
    if raw_burst_ok(a) { return camera.KIND_RAW }
    return camera.KIND_JPEG
}

fn open_lens(a: *mut App, idx: i32) {
    camera.camera_close()
    (*a).ready = false
    if !camera.camera_info(idx, &(*a).info) { set_status(a, "NO INFO"); return }
    (*a).lens = idx
    if !mode_ok(a, (*a).mode) { (*a).mode = M_PHOTO }
    if !man_ok(a) { (*a).manual = false }
    let e: i32 = camera.camera_open(idx)
    if e != camera.E_OK { set_status(a, "OPEN FAILED"); return }
    let s: i32 = camera.camera_start(want_kind(a))
    if s != camera.E_OK { set_status(a, "SESSION FAILED"); return }
    (*a).kind = camera.camera_kind()
    (*a).ready = true
    apply_manual(a)
    set_status(a, "READY")
}

fn stamp() -> i64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 0, (&ts[0]) as i64, 0, 0, 0, 0)
    return ts[0]
}

// ---------------------------------------------------------------- manual sliders
fn man_iso(a: *mut App) -> i32 {
    let lo: f64 = if (*a).info.iso_min > 0 { (*a).info.iso_min as f64 } else { 50.0 }
    let hi: f64 = (*a).info.iso_max as f64
    return (lo * math.powf(hi / lo, ((*a).sl[0] as f64) / 1000.0) + 0.5) as i32
}

fn man_exp(a: *mut App) -> i64 {
    let lo: f64 = (*a).info.exp_min_ns as f64
    var hi: f64 = (*a).info.exp_max_ns as f64
    if hi > 500000000.0 { hi = 500000000.0 }
    if lo <= 0.0 || hi <= lo { return (*a).info.exp_min_ns }
    return (lo * math.powf(hi / lo, ((*a).sl[1] as f64) / 1000.0)) as i64
}

fn man_focus(a: *mut App) -> f32 {
    return (*a).info.min_focus_d * ((*a).sl[2] as f32) / 1000.0f
}

fn apply_manual(a: *mut App) {
    if !(*a).ready || !(*a).manual { return }
    var e: i64 = 0
    var iso: i32 = 0
    var fd: f32 = 0.0f - 1.0f
    if has_man_sensor(a) { e = man_exp(a); iso = man_iso(a) }
    if has_man_focus(a) { fd = man_focus(a) }
    camera.camera_set_manual(e, iso, fd)
}

// rows that exist: 0 ISO, 1 EXP, 2 FOCUS -> packed list; returns the count
fn rows_of(a: *mut App, out: *mut [i32; 3]) -> i32 {
    var n: i32 = 0
    if has_man_sensor(a) { (*out)[0] = 0; (*out)[1] = 1; n = 2 }
    if has_man_focus(a) { (*out)[n as usize] = 2; n = n + 1 }
    return n
}

// ---------------------------------------------------------------- saving names
fn name_into(dst: u64, prefix: str, ext: str) -> usize {
    var o: usize = 0
    var i: usize = 0
    while i < prefix.n { *((dst + o as u64) as *mut u8) = *((prefix.p as u64 + i as u64) as *mut u8); o = o + 1; i = i + 1 }
    o = o + put_int(dst + o as u64, stamp())
    i = 0
    while i < ext.n { *((dst + o as u64) as *mut u8) = *((ext.p as u64 + i as u64) as *mut u8); o = o + 1; i = i + 1 }
    *((dst + o as u64) as *mut u8) = 0 as u8
    return o
}

fn report(a: *mut App, r: i32, ok_txt: str, priv_txt: str) {
    if r == 1 { set_status(a, ok_txt) } else if r == 2 { set_status(a, priv_txt) } else { set_status(a, "SAVE FAILED") }
}

// ---------------------------------------------------------------- plain single shot (RAW -> DNG, JPEG as the camera made it)
fn shoot_plain(a: *mut App) {
    if !(*a).ready { return }
    let cap: usize = if (*a).kind == camera.KIND_RAW { raw_frame_bytes(a) } else { 24 * 1024 * 1024 }
    let buf: u64 = camera.camera_alloc(cap)
    if buf == 0 { set_status(a, "NO MEMORY"); return }
    var fi: camera.FrameInfo = camera.zero_frame()
    var exp_l: [i64; 1] = [0 as i64; 1]
    var foc_l: [f32; 1] = [0.0f; 1]
    var ep: u64 = 0
    var fp: u64 = 0
    var iso: i32 = 0
    if (*a).manual {
        if has_man_sensor(a) { exp_l[0] = man_exp(a); iso = man_iso(a); ep = (&exp_l[0]) as u64 }
        if has_man_focus(a) { foc_l[0] = man_focus(a); fp = (&foc_l[0]) as u64 }
    }
    let n: i32 = camera.camera_capture(1, ep, fp, iso, buf, cap, &fi)
    if n < 1 {
        set_status(a, "CAPTURE FAILED")
        camera.camera_free(buf, cap)
        return
    }
    var name: [u8; 48] = [0 as u8; 48]
    (*a).shots = (*a).shots + 1
    if fi.kind == camera.KIND_RAW {
        var m: meta.SensorMeta = meta.meta_default()
        camera.camera_meta(fi.slot, &m)
        var ex: dngwrite.DngExtra = dngwrite.dng_extra_default()
        camera.camera_dng_extra(fi.slot, &ex)
        let dcap: usize = dngwrite.dng_max_size(fi.w as u32, fi.h as u32)
        let dbuf: u64 = camera.camera_alloc(dcap)
        if dbuf == 0 { set_status(a, "NO MEMORY"); camera.camera_free(buf, cap); return }
        let dn: usize = dngwrite.dng_write(dbuf, dcap, buf + fi.offset as u64, fi.w as u32, fi.h as u32, &m, &ex)
        name_into((&name[0]) as u64, "IMG_", ".dng")
        let mime: str = "image/x-adobe-dng\0"
        let r: i32 = if dn > 0 { camera.camera_save(dbuf, dn, (&name[0]) as u64, mime.p as u64) } else { 0 }
        camera.camera_free(dbuf, dcap)
        report(a, r, "SAVED DNG", "SAVED DNG PRIVATE")
    } else if fi.kind == camera.KIND_JPEG {
        name_into((&name[0]) as u64, "IMG_", ".jpg")
        let mime: str = "image/jpeg\0"
        let r: i32 = camera.camera_save(buf + fi.offset as u64, fi.size, (&name[0]) as u64, mime.p as u64)
        report(a, r, "SAVED JPG", "SAVED JPG PRIVATE")
    } else {
        set_status(a, "YUV NOT SAVED")
    }
    camera.camera_free(buf, cap)
}

// ---------------------------------------------------------------- processed shot: capture, then the job thread
fn exif_orientation(deg: i32) -> i32 {
    if deg == 90 { return 6 }
    if deg == 180 { return 3 }
    if deg == 270 { return 8 }
    return 1
}

fn want_frames(a: *mut App, raw: bool, steps: *mut [f32; 16]) -> i32 {
    let m: i32 = (*a).mode
    if m == M_PHOTO { return if raw { 6 } else { 4 } }
    if m == M_NIGHT { return if raw { 10 } else { 6 } }
    if m == M_PORTRAIT { return 3 }
    if m == M_DOC { return 2 }
    // focus stack: steps from the lens' focus range
    var mt: meta.SensorMeta = meta.meta_default()
    camera.camera_meta(0 - 1, &mt)
    return focus.plan_focus(&mt, 0.0f, (*a).info.min_focus_d, 8, &(*steps)[0])
}

// UI side, step 1: plan the shot, allocate; the frames are taken one per UI iteration (step_capture)
fn start_job(a: *mut App) {
    if !(*a).ready || (*a).busy { return }
    let raw: bool = (*a).kind == camera.KIND_RAW
    let ji: *mut camera.CamInfo = &(*a).info
    let fb: usize = if raw { raw_frame_bytes(a) } else { (((*ji).jpeg_w as usize) * ((*ji).jpeg_h as usize) * 3) / 4 + 1048576 }
    var n: i32 = want_frames(a, raw, &(*a).steps)
    while n > 1 && (n as usize) * fb > BUDGET { n = n - 1 }
    if (*a).mode == M_STACK && n < 2 { set_status(a, "NO FOCUS RANGE"); return }
    if n > 16 { n = 16 }
    let cap: usize = fb * (n as usize)
    let buf: u64 = camera.camera_alloc(cap)
    let fra: u64 = camera.camera_alloc(camera.sizeof_frame() * 16)
    if buf == 0 || fra == 0 {
        if buf != 0 { camera.camera_free(buf, cap) }
        if fra != 0 { camera.camera_free(fra, camera.sizeof_frame() * 16) }
        set_status(a, "NO MEMORY")
        return
    }
    camjob.job_free(&(*a).job)
    (*a).job = camjob.job_new()
    (*a).cbuf = buf
    (*a).ccap = cap
    (*a).fbuf = fra
    (*a).cap_n = n
    (*a).cap_i = 0
    (*a).cap_at = 0
    (*a).stage = 1
    (*a).busy = true
    set_status(a, "CAPTURING")
}

fn release_capture(a: *mut App) {
    if (*a).cbuf != 0 { camera.camera_free((*a).cbuf, (*a).ccap) }
    if (*a).fbuf != 0 { camera.camera_free((*a).fbuf, camera.sizeof_frame() * 16) }
    (*a).cbuf = 0
    (*a).fbuf = 0
}

// one frame per call (a capture is a few hundred ms; the UI keeps drawing between frames)
fn step_capture(a: *mut App) {
    let fptr: *mut camera.FrameInfo = (*a).fbuf as *mut camera.FrameInfo
    let k: i32 = (*a).cap_i
    let fk: *mut camera.FrameInfo = camera.frame_at(fptr, k)
    var fp: u64 = 0
    if (*a).mode == M_STACK { fp = (&(*a).steps[k as usize]) as u64 }
    let c: i32 = camera.camera_capture(1, 0, fp, 0, (*a).cbuf + (*a).cap_at as u64, (*a).ccap - (*a).cap_at, fk)
    if c >= 1 {
        (*a).bs[k as usize] = (*a).cbuf + (*a).cap_at as u64
        (*a).cap_at = (*a).cap_at + (*fk).offset + (*fk).size
        (*a).cap_i = k + 1
        (*a).job.progress = (((k + 1) * 25 / (*a).cap_n) as u64)
    }
    if c < 1 || (*a).cap_i >= (*a).cap_n {
        if (*a).cap_i < 1 {
            release_capture(a)
            set_status(a, "CAPTURE FAILED")
            (*a).busy = false
            (*a).stage = 0
            return
        }
        begin_process(a)
    }
}

// step 2: hand the frames to the job thread
fn begin_process(a: *mut App) {
    let ji: *mut camera.CamInfo = &(*a).info
    let fptr: *mut camera.FrameInfo = (*a).fbuf as *mut camera.FrameInfo
    (*a).job.mode = (*a).mode
    (*a).job.orientation = exif_orientation((*ji).orientation)
    var mt: meta.SensorMeta = meta.meta_default()
    camera.camera_meta((*fptr).slot, &mt)
    (*a).job.meta = mt
    var i: i32 = 0
    while i < (*a).cap_i {
        let f: *mut camera.FrameInfo = camera.frame_at(fptr, i)
        var kind: i32 = camjob.SHOT_JPEG
        if (*f).kind == camera.KIND_RAW { kind = camjob.SHOT_RAW }
        if (*f).kind != camera.KIND_YUV {
            camjob.job_add_shot(&(*a).job, kind, (*f).w, (*f).h, (*a).bs[i as usize] + (*f).offset as u64, (*f).size, (*f).exposure_ns, (*f).iso)
        }
        i = i + 1
    }
    (*a).stage = 2
    set_status(a, "PROCESSING")
    if (*a).ttid == 0 {
        pthread_attr_init((&(*a).tattr[0]) as u64)
        pthread_attr_setstacksize((&(*a).tattr[0]) as u64, JOB_STACK)
        pthread_attr_setdetachstate((&(*a).tattr[0]) as u64, 1)
        let rc: i32 = pthread_create((&(*a).ttid) as u64, (&(*a).tattr[0]) as u64, ndk.code_of_thread(thread_job_main), a as u64)
        if rc != 0 { (*a).ttid = 0 }
    }
    if (*a).ttid == 0 {
        camjob.job_entry((&(*a).job) as u64)    // no thread: run here
    } else {
        __atomic_add((&(*a).wreq) as *mut u64, 1)
    }
}

// The job thread lives as long as the app: it attaches to the Firn runtime once and never detaches (leaving a
// thread that detached crashes the process on Android). Between jobs it sleeps in host mode (counted as blocked).
fn thread_job_main(arg: u64) -> u64 {
    let a: *mut App = arg as *mut App
    if !thread_attach() { return 0 }
    var seen: u64 = 0
    while true {
        let want: u64 = __atomic_add((&(*a).wreq) as *mut u64, 0)
        if want != seen {
            seen = want
            thread_blocking_out()
            camjob.job_entry((&(*a).job) as u64)
            thread_blocking_an()
        } else {
            usleep(20000 as u32)
        }
    }
    return 0
}

// UI side of a finished job: save, release, report
fn poll_job(a: *mut App) {
    if !(*a).busy { return }
    if (*a).stage == 1 { step_capture(a); return }
    if !camjob.job_finished(&(*a).job) { return }
    var name: [u8; 48] = [0 as u8; 48]
    if (*a).job.ok {
            name_into((&name[0]) as u64, "IMG_", ".jpg")
        let mime: str = "image/jpeg\0"
        let r: i32 = camera.camera_save((*a).job.out, (*a).job.out_n, (&name[0]) as u64, mime.p as u64)
        if (*a).job.have_pdf {
            var pn: [u8; 48] = [0 as u8; 48]
            name_into((&pn[0]) as u64, "SCAN_", ".pdf")
            let pm: str = "application/pdf\0"
            camera.camera_save_doc(rt.buf_ptr(&(*a).job.pdf), rt.buf_len(&(*a).job.pdf), (&pn[0]) as u64, pm.p as u64)
        }
        (*a).shots = (*a).shots + 1
            report(a, r, "SAVED", "SAVED PRIVATE")
    } else {
        set_status(a, "PROCESSING FAILED")
    }
    camjob.job_free(&(*a).job)
    release_capture(a)
    (*a).stage = 0
    (*a).busy = false
}

fn shoot(a: *mut App) {
    if (*a).busy { return }
    let m: i32 = (*a).mode
    if m == M_RAW || ((*a).manual && m == M_PHOTO) { shoot_plain(a); return }
    start_job(a)
}

fn toggle_video(a: *mut App) {
    if !(*a).ready || (*a).info.vid_w <= 0 { return }
    if (*a).recording {
        let ok: bool = camera.camera_video_stop()
        (*a).recording = false
        open_lens(a, (*a).lens)
        if ok { set_status(a, "VIDEO SAVED") } else { set_status(a, "VIDEO FAILED") }
        return
    }
    var name: [u8; 48] = [0 as u8; 48]
    name_into((&name[0]) as u64, "VID_", ".mp4")
    let r: i32 = camera.camera_video_start((&name[0]) as u64)
    if r == camera.E_OK {
        (*a).recording = true
        set_status(a, "RECORDING")
    } else {
        set_status(a, "VIDEO START FAILED")
        open_lens(a, (*a).lens)
    }
}

// ---------------------------------------------------------------- drawing
fn button(a: *mut App, x: i32, y: i32, w: i32, h: i32, bg: u32, label: str, sc: i32) {
    px_rect((*a).scr, (*a).w, (*a).h, x, y, w, h, bg)
    draw_text((*a).scr, (*a).w, (*a).h, x + (w - text_w(label, sc)) / 2, y + (h - 14 * sc) / 2, sc, 0xffffff, label)
}

fn bar_top(a: *mut App) -> i32 { return (*a).h - (*a).h / 7 }

fn msc(a: *mut App) -> i32 { return if (*a).w >= 900 { 2 } else { 1 } }

fn mode_bar_h(a: *mut App) -> i32 { return 14 * msc(a) + 18 }

fn row_h(a: *mut App) -> i32 { return 14 * msc(a) + 16 }

fn mode_label(m: i32) -> str {
    if m == M_PHOTO { return "PHOTO" }
    if m == M_NIGHT { return "NIGHT" }
    if m == M_PORTRAIT { return "PORTR" }
    if m == M_DOC { return "DOC" }
    if m == M_STACK { return "STACK" }
    if m == M_VIDEO { return "VIDEO" }
    return "RAW"
}

// top of the area above the button bar that the preview may use
fn preview_bottom(a: *mut App) -> i32 {
    var rows: [i32; 3] = [0; 3]
    var h: i32 = bar_top(a) - mode_bar_h(a)
    if (*a).manual { h = h - rows_of(a, &rows) * row_h(a) }
    return h
}

fn buf_str(b: *mut [u8; 48], n: usize) -> str {
    var s: str = ""
    s.p = (&(*b)[0]) as u64 as *mut u8
    s.n = n
    return s
}

fn put_str(dst: u64, s: str) -> usize {
    var i: usize = 0
    while i < s.n { *((dst + i as u64) as *mut u8) = *((s.p as u64 + i as u64) as *mut u8); i = i + 1 }
    return s.n
}

fn draw_sliders(a: *mut App, sc: i32) {
    var rows: [i32; 3] = [0; 3]
    let nr: i32 = rows_of(a, &rows)
    let w: i32 = (*a).w
    let rh: i32 = row_h(a)
    var y: i32 = bar_top(a) - mode_bar_h(a) - nr * rh
    var i: i32 = 0
    while i < nr {
        let r: i32 = rows[i as usize]
        px_rect((*a).scr, w, (*a).h, 0, y, w, rh, 0x181818)
        var line: [u8; 48] = [0 as u8; 48]
        var ln: usize = 0
        if r == 0 {
            ln = put_str((&line[0]) as u64, "ISO ")
            ln = ln + put_int((&line[0]) as u64 + ln as u64, man_iso(a) as i64)
        } else if r == 1 {
            ln = put_str((&line[0]) as u64, "EXP 1/")
            let e: i64 = man_exp(a)
            var d: i64 = 1000000000 / (if e > 0 { e } else { 1 })
            if d < 1 { d = 1 }
            ln = ln + put_int((&line[0]) as u64 + ln as u64, d)
        } else {
            ln = put_str((&line[0]) as u64, "FOCUS ")
            let fd: f32 = man_focus(a)
            if fd < 0.05f {
                ln = ln + put_str((&line[0]) as u64 + ln as u64, "INF")
            } else {
                ln = ln + put_int((&line[0]) as u64 + ln as u64, (100.0f / fd) as i64)
                ln = ln + put_str((&line[0]) as u64 + ln as u64, "CM")
            }
        }
        draw_text((*a).scr, w, (*a).h, 8, y + 8, sc, 0xffd060, buf_str(&line, ln))
        // track starts right of the label
        let tx: i32 = 8 + 14 * 8 * sc
        let tw: i32 = w - tx - 12
        px_rect((*a).scr, w, (*a).h, tx, y + rh / 2 - 2, tw, 4, 0x606060)
        let kx: i32 = tx + tw * (*a).sl[r as usize] / 1000
        px_rect((*a).scr, w, (*a).h, kx - 5, y + 4, 10, rh - 8, 0xe0e0e0)
        y = y + rh
        i = i + 1
    }
}

fn draw(a: *mut App, f: *mut window.Window) {
    let w: i32 = (*a).w
    let h: i32 = (*a).h
    px_rect((*a).scr, w, h, 0, 0, w, h, 0x101010)
    let bt: i32 = bar_top(a)
    let pb: i32 = preview_bottom(a)
    if (*a).ready {
        var sw: i32 = 0
        var sh: i32 = 0
        camera.camera_stream_size(1, &sw, &sh)
        let rot: i32 = (*a).info.orientation
        var dw: i32 = sw
        var dh: i32 = sh
        if rot == 90 || rot == 270 { dw = sh; dh = sw }
        if dw > 0 && dh > 0 {
            var tw: i32 = w
            var th: i32 = w * dh / dw
            if th > pb { th = pb; tw = pb * dw / dh }
            if tw != (*a).pw || th != (*a).ph {
                (*a).pw = tw
                (*a).ph = th
            }
            camera.camera_preview_bgrx((*a).prev, tw, th, rot, (*a).info.facing == 0)
            let ox: i32 = (w - tw) / 2
            let oy: i32 = (pb - th) / 2
            var y: i32 = 0
            while y < th {
                var x: i32 = 0
                while x < tw {
                    *((((*a).scr) + (((oy + y) * w + ox + x) * 4) as u64) as *mut u32) = *((((*a).prev) + ((y * tw + x) * 4) as u64) as *mut u32)
                    x = x + 1
                }
                y = y + 1
            }
        }
    }
    let sc: i32 = if w >= 900 { 3 } else { 2 }
    draw_text((*a).scr, w, h, 12, 10, sc, 0xffffff, status_str(a))
    var line: [u8; 48] = [0 as u8; 48]
    var ln: usize = put_str((&line[0]) as u64, "LENS ")
    ln = ln + put_int((&line[0]) as u64 + ln as u64, ((*a).lens + 1) as i64)
    line[ln] = 47 as u8; ln = ln + 1
    ln = ln + put_int((&line[0]) as u64 + ln as u64, (*a).nlens as i64)
    line[ln] = 32 as u8; ln = ln + 1
    ln = ln + put_int((&line[0]) as u64 + ln as u64, ((*a).info.equiv_mm + 0.5f) as i64)
    ln = ln + put_str((&line[0]) as u64 + ln as u64, "MM")
    draw_text((*a).scr, w, h, 12, 10 + 16 * sc, sc, 0xffd060, buf_str(&line, ln))
    if (*a).busy {
        let p: i32 = camjob.job_progress(&(*a).job) as i32
        px_rect((*a).scr, w, h, 12, 10 + 32 * sc, w - 24, 12, 0x404040)
        px_rect((*a).scr, w, h, 12, 10 + 32 * sc, (w - 24) * p / 100, 12, 0x2a8a3a)
    }
    if (*a).manual && (*a).ready { draw_sliders(a, msc(a)) }
    // mode bar: visible modes + MAN
    var vis: [i32; 8] = [0; 8]
    let nv: i32 = visible(a, &vis)
    var cells: i32 = nv
    if man_ok(a) { cells = cells + 1 }
    let mh: i32 = mode_bar_h(a)
    let my: i32 = bt - mh
    let cw: i32 = if cells > 0 { w / cells } else { w }
    var c: i32 = 0
    while c < cells {
        var label: str = "MAN"
        var col: u32 = 0x202020
        if c < nv {
            label = mode_label(vis[c as usize])
            if vis[c as usize] == (*a).mode { col = 0x2a5a8a }
        } else if (*a).manual {
            col = 0x2a8a3a
        }
        button(a, c * cw + 1, my, cw - 2, mh, col, label, msc(a))
        c = c + 1
    }
    // buttons: LENS | SHOT / REC
    let by: i32 = bt + 10
    let bh: i32 = h - bt - 20
    let bw: i32 = (w - 30) / 3
    button(a, 10, by, bw, bh, 0x304060, "LENS", sc)
    var col2: u32 = 0xb03030
    var lab2: str = "SHOT"
    if (*a).mode == M_VIDEO {
        lab2 = "REC"
        if (*a).recording { col2 = 0xd01010; lab2 = "STOP" }
    }
    if (*a).busy { col2 = 0x505050; lab2 = "WAIT" }
    button(a, 20 + bw, by, w - 30 - bw, bh, col2, lab2, sc)
    window.image(f, (*a).scr, w as usize, h as usize, 0, 0)
    window.present(f)
}

// hit codes: 1 LENS, 3 action, 20+i mode cell i, 40 MAN, 50+r slider row r (value in *val, 0..1000), 0 nothing
fn hit(a: *mut App, x: i32, y: i32, val: *mut i32) -> i32 {
    let bt: i32 = bar_top(a)
    if y >= bt {
        if x < 10 + (((*a).w - 30) / 3) + 5 { return 1 }
        return 3
    }
    let mh: i32 = mode_bar_h(a)
    if y >= bt - mh {
        var vis: [i32; 8] = [0; 8]
        let nv: i32 = visible(a, &vis)
        var cells: i32 = nv
        if man_ok(a) { cells = cells + 1 }
        if cells == 0 { return 0 }
        let c: i32 = x * cells / (*a).w
        if c < nv { return 20 + c }
        return 40
    }
    if (*a).manual {
        var rows: [i32; 3] = [0; 3]
        let nr: i32 = rows_of(a, &rows)
        let rh: i32 = row_h(a)
        let top: i32 = bt - mh - nr * rh
        if y >= top {
            let i: i32 = (y - top) / rh
            let tx: i32 = 8 + 14 * 8 * msc(a)
            let tw: i32 = (*a).w - tx - 12
            var v: i32 = (x - tx) * 1000 / tw
            if v < 0 { v = 0 }
            if v > 1000 { v = 1000 }
            *val = v
            return 50 + rows[i as usize]
        }
    }
    return 0
}

fn set_slider(a: *mut App, row: i32, v: i32) {
    (*a).sl[row as usize] = v
    apply_manual(a)
}

#[allow_escape]
fn main() -> i32 {
    var f: window.Window = window.window_new()
    if !window.open_window(&f, 0) || !window.make(&f, 480, 800) { return 1 }
    window.full_input(&f, true)
    window.show_window(&f)

    var a: App = App {
        w: window.width(&f) as i32, h: window.height(&f) as i32, scr: 0, prev: 0, pw: 0, ph: 0,
        nlens: 0, lens: 0, mode: M_PHOTO, manual: false, sl: [500, 500, 0], drag: 0 - 1, kind: 0, ready: false,
        status: [0 as u8; 64], info: camera.zero_info(), shots: 0, recording: false,
        job: camjob.job_new(), busy: false, th: 0, cbuf: 0, ccap: 0, fbuf: 0, stamp0: 0, tattr: [0; 16], ttid: 0, wreq: 0, stage: 0, cap_n: 0, cap_i: 0, cap_at: 0, steps: [0.0f; 16], bs: [0; 16],
    }
    a.scr = camera.camera_alloc((a.w * a.h * 4) as usize)
    a.prev = camera.camera_alloc((a.w * a.h * 4) as usize)
    if a.scr == 0 || a.prev == 0 { return 2 }
    set_status(&a, "NO PERMISSION")
    var asked: bool = false
    var open: bool = true
    while open {
        if !a.ready && a.nlens == 0 {
            if camera.camera_permission() == 1 {
                a.nlens = camera.camera_scan()
                if a.nlens > 0 { open_lens(&a, 0) } else { set_status(&a, "NO CAMERA") }
            } else if !asked {
                asked = true
                camera.camera_request_permission()
            }
        }
        poll_job(&a)
        window.wait_event(&f, 30)
        var k: u32 = window.next_event(&f)
        while k != window.EV_NONE {
            if k == window.EV_CLOSED { open = false }
            if k == window.EV_KEY && window.ev_a(&f) == window.K_ESCAPE { open = false }
            if k == window.EV_CONFIGURE {
                let nw: i32 = window.width(&f) as i32
                let nh: i32 = window.height(&f) as i32
                if nw != a.w || nh != a.h {
                    camera.camera_free(a.scr, (a.w * a.h * 4) as usize)
                    camera.camera_free(a.prev, (a.w * a.h * 4) as usize)
                    a.w = nw
                    a.h = nh
                    a.scr = camera.camera_alloc((nw * nh * 4) as usize)
                    a.prev = camera.camera_alloc((nw * nh * 4) as usize)
                }
            }
            if k == window.EV_RELEASE { a.drag = 0 - 1 }
            if k == window.EV_MOTION && a.drag >= 0 {
                var v: i32 = 0
                // re-use the hit test on the dragged row's track: keep y inside the row
                let z: i32 = hit(&a, window.ev_x(&f) as i32, window.ev_y(&f) as i32, &v)
                if z == 50 + a.drag { set_slider(&a, a.drag, v) }
            }
            if k == window.EV_BUTTON && window.ev_a(&f) == window.BTN_LEFT {
                var v: i32 = 0
                let z: i32 = hit(&a, window.ev_x(&f) as i32, window.ev_y(&f) as i32, &v)
                if z == 1 && a.nlens > 0 && !a.recording && !a.busy { open_lens(&a, (a.lens + 1) % a.nlens) }
                if z == 3 && !a.busy {
                    if a.mode == M_VIDEO { toggle_video(&a) } else if !a.recording { draw(&a, &f); shoot(&a) }
                }
                if z >= 20 && z < 40 && !a.recording && !a.busy {
                    var vis: [i32; 8] = [0; 8]
                    let nv: i32 = visible(&a, &vis)
                    if z - 20 < nv {
                        let nm: i32 = vis[(z - 20) as usize]
                        if nm != a.mode {
                            a.mode = nm
                            if !man_ok(&a) { a.manual = false }
                            open_lens(&a, a.lens)
                        }
                    }
                }
                if z == 40 && !a.recording && !a.busy {
                    a.manual = !a.manual
                    open_lens(&a, a.lens)
                }
                if z >= 50 && z < 60 {
                    a.drag = z - 50
                    set_slider(&a, z - 50, v)
                }
            }
            k = window.next_event(&f)
        }
        draw(&a, &f)
    }
    if a.recording { let okv: bool = camera.camera_video_stop() }
    camera.camera_close()
    par.shutdown()
    window.close_window(&f)
    return 0
}
