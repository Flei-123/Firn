// expect_exit: 0
// examples/glob_find.fi -- std.glob: "all .fi files below src, but not the
// hidden ones", the one-liner `glob.glob("src/**/*.fi", recursive=True)` of
// Python (or `find src -name '*.fi'`).
//
// The example builds a tiny tree in a temp directory first so that it runs
// anywhere; a real program just calls glob.expand_opts with its pattern.
import std.rt
import std.str
import std.fs
import std.glob

fn path(base: str, rel: str, out: *mut rt.Buf) {
    rt.buf_push_bytes(out, base.p as u64, base.n)
    rt.buf_push(out, 47 as u8)
    rt.buf_push_bytes(out, rel.p as u64, rel.n)
}

fn make(base: str, rel: str, is_dir: bool) {
    var p: rt.Buf = rt.buf_new()
    path(base, rel, &p)
    let s: str = str { p: rt.buf_data(&p), n: rt.buf_len(&p) }
    if is_dir {
        fs.mkdir_all(s) catch false
    } else {
        fs.write_file(s, "x".p as u64, 1) catch 0
    }
    rt.buf_free(&p)
}

fn main() -> i32 {
    var base: rt.Buf = rt.buf_new()
    var prefix: str = "/tmp/firn-glob-example-"
    rt.buf_push_bytes(&base, prefix.p as u64, prefix.n)
    rt.buf_push_dec_i64(&base, syscall(39, 0, 0, 0, 0, 0, 0))
    let root: str = str { p: rt.buf_data(&base), n: rt.buf_len(&base) }
    make(root, "src/net", true)
    make(root, "src/.cache", true)
    make(root, "src/main.fi", false)
    make(root, "src/net/tcp.fi", false)
    make(root, "src/net/notes.txt", false)
    make(root, "src/.cache/old.fi", false)

    // every .fi file below src, hidden directories left out
    var out: rt.Buf = rt.buf_new()
    let n: usize = glob.expand_in(root, "src/**/*.fi", glob.GLOB_RECURSIVE, &out)
    var i: usize = 0
    while i < n {
        let name: str = glob.nth(&out, i)
        rt.write_everything(1, name.p as u64, name.n)
        rt.write_everything(1, "\n".p as u64, 1)
        i = i + 1
    }
    rt.buf_free(&out)
    fs.remove_tree(root) catch false
    rt.buf_free(&base)
    if n != 2 {
        return 1
    }
    return 0
}
