// examples/fui_controls/main.fi -- a settings window with the standard controls of fui.appctl.
import fui.app
import fui.appctl
import plat.fuiwinvk

static mut INFO: usize = 0

fn changed(a: *mut app.App, id: usize) {
    app.set_text(a, INFO, "changed")
}

fn close(a: *mut app.App) {
    app.quit(a)
}

fn main() -> i32 {
    let a: *mut app.App = app.window("Settings", 520, 640)
    // FUI_GPU=1: fUi painted on Vulkan (opt-in; no Vulkan or any failure = the CPU painter, nothing else changes)
    app.set_pre_open(a, fuiwinvk.pre_open_env)
    let dark: usize = appctl.checkbox(a, "Dark mode", false, changed)
    let note: usize = appctl.toggle(a, "Notifications", true, changed)
    let small: usize = appctl.radio(a, 1, "Small text", true, changed)
    let large: usize = appctl.radio(a, 1, "Large text", false, changed)
    let vol: usize = appctl.slider(a, "Volume", 0, 100, 40, changed)
    let dl: usize = appctl.progress(a, "Download", 0, 100, 60)
    let cnt: usize = appctl.spinbox(a, "Copies", 1, 99, 1, 1, changed)
    let lang: usize = appctl.dropdown(a, "Language", changed)
    let o1: bool = appctl.dropdown_add(a, lang, "English")
    let o2: bool = appctl.dropdown_add(a, lang, "Deutsch")
    let tb: usize = appctl.tabs(a)
    let t1: usize = appctl.tab(a, tb, "General", changed)
    let t2: usize = appctl.tab(a, tb, "Advanced", changed)
    appctl.tabs_end(a)
    let p1: usize = appctl.tab_page(a, tb)
    app.label(a, "General settings", 0)
    app.end(a)
    let p2: usize = appctl.tab_page(a, tb)
    app.label(a, "Advanced settings", 0)
    app.end(a)
    let ex: usize = appctl.expander(a, "More", false, changed)
    let eb: usize = appctl.expander_body(a, ex)
    app.label(a, "Hidden until opened", 0)
    app.end(a)
    INFO = app.label(a, " ", 0)
    app.button(a, "Close", close)
    return app.run(a)
}
