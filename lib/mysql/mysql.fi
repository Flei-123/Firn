// SPDX-License-Identifier: MPL-2.0
import std.rt
import net.transport as tr
import mysql.mywire as w
import mysql.myrows as rows
import mysql.mybin as bin
import mysql.mylink as lk
import mysql.myauth as au

export {
    My, my_new, my_free, my_connect, my_is_open, my_close, my_error, my_error_code,
    my_query, my_prepare, my_exec_stmt, my_close_stmt, my_ping,
    TLS_OFF, TLS_REQUIRE,
}

type My = lk.My

const TLS_OFF: u32 = 0
const TLS_REQUIRE: u32 = 1

fn my_new() -> My { return lk.my_new() }
fn my_free(c: *mut My) { lk.my_free(c) }
fn my_is_open(c: *mut My) -> bool { return lk.my_is_open(c) }
fn my_error(c: *mut My) -> str { return lk.my_error(c) }
fn my_error_code(c: *mut My) -> u32 { return lk.my_error_code(c) }

fn my_connect(c: *mut My, addr: u32, port: u16, user: str, password: str, database: str,
    tls_mode: u32, host: str, roots: u64, rn: usize, now: u64) -> bool {
    rt.buf_clear(&(*c).err)
    (*c).err_code = 0
    if !tr.tp_connect(&(*c).tp, addr, port) {
        lk.set_error(c, "tcp connect failed")
        return false
    }
    (*c).seq = 0
    if !lk.read_packet(c) || !au.parse_handshake(c) {
        lk.set_error(c, "bad server handshake")
        return false
    }
    var want: u32 = w.CAP_LONG_PASSWORD | w.CAP_PROTOCOL_41 | w.CAP_TRANSACTIONS | w.CAP_SECURE_CONNECTION
    | w.CAP_PLUGIN_AUTH | w.CAP_PLUGIN_AUTH_LENENC
    if database.n > 0 { want = want | w.CAP_CONNECT_WITH_DB }
    if tls_mode == TLS_REQUIRE { want = want | w.CAP_SSL }
    if (want & w.CAP_SSL) != 0 && ((*c).caps & w.CAP_SSL) == 0 {
        lk.set_error(c, "server does not offer TLS")
        return false
    }
    (*c).caps = want
    if tls_mode == TLS_REQUIRE && !au.start_tls(c, host, roots, rn, now) { return false }
    if !au.send_response(c, user, password, database, tls_mode == TLS_REQUIRE) { return false }
    if !au.auth_loop(c, password) { return false }
    (*c).open = true
    return true
}

fn my_close(c: *mut My) {
    if (*c).open {
        lk.command(c, 1 as u8, 0, 0)
        (*c).open = false
    }
}

fn my_ping(c: *mut My) -> bool {
    if !lk.command(c, 14 as u8, 0, 0) || !lk.read_packet(c) { return false }
    return rt.ld8((*c).pkt.ptr, 0) == 0 as u8
}

fn read_columns(c: *mut My, r: *mut rows.MyResult, count: usize) -> bool {
    var i: usize = 0
    while i < count {
        if !lk.read_packet(c) { return false }
        let p: u64 = (*c).pkt.ptr
        let n: usize = (*c).pkt.len
        var pos: usize = 0
        var k: usize = 0
        var len: u64 = 0
        var name_at: usize = 0
        var name_len: usize = 0
        while k < 6 {
            if !w.read_lenenc(p, n, &pos, &len) || len > (n - pos) as u64 { return lk.protocol_error(c) }
            if k == 4 {
                name_at = pos
                name_len = len as usize
            }
            pos = pos + len as usize
            k = k + 1
        }
        if pos + 13 > n { return lk.protocol_error(c) }
        rows.add_column(r, p + name_at as u64, name_len, rt.ld8(p, pos + 7) as u32, w.ld16le(p, pos + 8))
        i = i + 1
    }
    return true
}

fn read_result_set(c: *mut My, r: *mut rows.MyResult, ncols: usize, binary: bool) -> bool {
    if !read_columns(c, r, ncols) { return false }
    if ncols > 0 && (!lk.read_packet(c) || !lk.is_eof(c)) { return lk.protocol_error(c) }
    while true {
        if !lk.read_packet(c) { return false }
        if lk.is_eof(c) { return true }
        if rt.ld8((*c).pkt.ptr, 0) == 255 as u8 {
            lk.parse_err(c)
            return false
        }
        var ok: bool = false
        if binary {
            ok = bin.decode_binary_row(r, (*c).pkt.ptr, (*c).pkt.len)
        } else {
            ok = bin.decode_text_row(r, (*c).pkt.ptr, (*c).pkt.len)
        }
        if !ok {
            lk.set_error(c, "malformed row")
            (*c).open = false
            return false
        }
    }
    return false
}

fn read_response(c: *mut My, r: *mut rows.MyResult, binary: bool) -> bool {
    rows.result_clear(r)
    rt.buf_clear(&(*c).err)
    (*c).err_code = 0
    if !lk.read_packet(c) {
        lk.set_error(c, "connection lost")
        return false
    }
    let kind: u8 = rt.ld8((*c).pkt.ptr, 0)
    if kind == 255 as u8 {
        lk.parse_err(c)
        return false
    }
    if kind == 0 as u8 { return lk.parse_ok(c, r) || lk.protocol_error(c) }
    if kind == 251 as u8 { return lk.protocol_error(c) }
    var pos: usize = 0
    var ncols: u64 = 0
    if !w.read_lenenc((*c).pkt.ptr, (*c).pkt.len, &pos, &ncols) || ncols > 4096 { return lk.protocol_error(c) }
    return read_result_set(c, r, ncols as usize, binary)
}

fn my_query(c: *mut My, sql: str, r: *mut rows.MyResult) -> bool {
    if !lk.command(c, 3 as u8, sql.p as u64, sql.n) { return false }
    return read_response(c, r, false)
}

fn skip_defs(c: *mut My, count: usize) -> bool {
    if count == 0 { return true }
    var i: usize = 0
    while i < count + 1 {
        if !lk.read_packet(c) { return false }
        i = i + 1
    }
    return true
}

fn my_prepare(c: *mut My, sql: str, nparams: *mut usize) -> i64 {
    if !lk.command(c, 22 as u8, sql.p as u64, sql.n) || !lk.read_packet(c) { return 0 - 1 }
    let p: u64 = (*c).pkt.ptr
    if rt.ld8(p, 0) == 255 as u8 {
        lk.parse_err(c)
        return 0 - 1
    }
    if (*c).pkt.len < 12 || rt.ld8(p, 0) != 0 as u8 {
        lk.protocol_error(c)
        return 0 - 1
    }
    let id: u32 = w.ld32le(p, 1)
    let ncols: usize = w.ld16le(p, 5) as usize
    let np: usize = w.ld16le(p, 7) as usize
    *nparams = np
    if !skip_defs(c, np) || !skip_defs(c, ncols) { return 0 - 1 }
    return id as i64
}

fn my_exec_stmt(c: *mut My, id: u32, q: *mut rows.MyParams, r: *mut rows.MyResult) -> bool {
    var b: rt.Buf = rt.buf_new()
    w.put_u32le(&b, id)
    rt.buf_push(&b, 0 as u8)
    w.put_u32le(&b, 1)
    let count: usize = (*q).count
    if count > 0 {
        let nb: usize = (count + 7) / 8
        let bm: usize = b.len
        var i: usize = 0
        while i < nb {
            rt.buf_push(&b, 0 as u8)
            i = i + 1
        }
        rt.buf_push(&b, 1 as u8)
        i = 0
        while i < count {
            rt.buf_push(&b, 253 as u8)
            rt.buf_push(&b, 0 as u8)
            i = i + 1
        }
        var at: usize = 0
        i = 0
        while i < count {
            let isnull: bool = rt.ld8((*q).data.ptr, at) != 0 as u8
            let len: usize = w.ld32le((*q).data.ptr, at + 1) as usize
            if isnull {
                rt.st8(b.ptr, bm + i / 8, rt.ld8(b.ptr, bm + i / 8) | (1 << (i % 8) as u8))
            } else {
                w.put_lenstr(&b, (*q).data.ptr + (at + 5) as u64, len)
            }
            at = at + 5 + len
            i = i + 1
        }
    }
    let sent: bool = lk.command(c, 23 as u8, b.ptr, b.len)
    rt.buf_free(&b)
    if !sent { return false }
    return read_response(c, r, true)
}

fn my_close_stmt(c: *mut My, id: u32) -> bool {
    var b: rt.Buf = rt.buf_new()
    w.put_u32le(&b, id)
    let ok: bool = lk.command(c, 25 as u8, b.ptr, b.len)
    rt.buf_free(&b)
    return ok
}
