// SPDX-License-Identifier: MPL-2.0
import std.rt
import mysql.mywire as w

export {
    MyResult, MyParams, result_new, result_free, result_clear, result_nrows, result_ncols,
    result_col_name, result_col_type, result_col_flags, result_value, result_affected, result_insert_id,
    params_new, params_free, params_clear, params_text, params_null,
    add_column, add_row_start, add_cell, add_null_cell, finish_row,
    TYPE_TINY, TYPE_SHORT, TYPE_LONG, TYPE_FLOAT, TYPE_DOUBLE, TYPE_TIMESTAMP, TYPE_LONGLONG,
    TYPE_INT24, TYPE_DATE, TYPE_TIME, TYPE_DATETIME, TYPE_YEAR, FLAG_UNSIGNED,
}

const TYPE_TINY: u32 = 1
const TYPE_SHORT: u32 = 2
const TYPE_LONG: u32 = 3
const TYPE_FLOAT: u32 = 4
const TYPE_DOUBLE: u32 = 5
const TYPE_TIMESTAMP: u32 = 7
const TYPE_LONGLONG: u32 = 8
const TYPE_INT24: u32 = 9
const TYPE_DATE: u32 = 10
const TYPE_TIME: u32 = 11
const TYPE_DATETIME: u32 = 12
const TYPE_YEAR: u32 = 13
const FLAG_UNSIGNED: u32 = 32
const NULL_CELL: u32 = 4294967295

struct MyResult {
    ncols: usize,
    nrows: usize,
    names: rt.Buf,
    types: rt.Buf,
    data: rt.Buf,
    rows: rt.Buf,
    affected: u64,
    insert_id: u64,
}

struct MyParams {
    count: usize,
    data: rt.Buf,
}

fn result_new() -> MyResult {
    return MyResult { ncols: 0, nrows: 0, names: rt.buf_new(), types: rt.buf_new(),
        data: rt.buf_new(), rows: rt.buf_new(), affected: 0, insert_id: 0 }
}

fn result_clear(r: *mut MyResult) {
    (*r).ncols = 0
    (*r).nrows = 0
    (*r).affected = 0
    (*r).insert_id = 0
    rt.buf_clear(&(*r).names)
    rt.buf_clear(&(*r).types)
    rt.buf_clear(&(*r).data)
    rt.buf_clear(&(*r).rows)
}

fn result_free(r: *mut MyResult) {
    rt.buf_free(&(*r).names)
    rt.buf_free(&(*r).types)
    rt.buf_free(&(*r).data)
    rt.buf_free(&(*r).rows)
}

fn result_nrows(r: *mut MyResult) -> usize { return (*r).nrows }
fn result_ncols(r: *mut MyResult) -> usize { return (*r).ncols }
fn result_affected(r: *mut MyResult) -> u64 { return (*r).affected }
fn result_insert_id(r: *mut MyResult) -> u64 { return (*r).insert_id }

fn add_column(r: *mut MyResult, name: u64, n: usize, ctype: u32, flags: u32) {
    rt.buf_push_bytes(&(*r).names, name, n)
    rt.buf_push(&(*r).names, 0 as u8)
    w.put_u32le(&(*r).types, ctype | (flags << 8))
    (*r).ncols = (*r).ncols + 1
}

fn result_col_type(r: *mut MyResult, col: usize) -> u32 {
    return rt.ld32((*r).types.ptr, col) & 255
}

fn result_col_flags(r: *mut MyResult, col: usize) -> u32 {
    return rt.ld32((*r).types.ptr, col) >> 8
}

fn result_col_name(r: *mut MyResult, col: usize) -> str {
    var at: usize = 0
    var i: usize = 0
    while i < col {
        while rt.ld8((*r).names.ptr, at) != 0 as u8 { at = at + 1 }
        at = at + 1
        i = i + 1
    }
    var e: usize = at
    while rt.ld8((*r).names.ptr, e) != 0 as u8 { e = e + 1 }
    return str { p: ((*r).names.ptr + at as u64) as *mut u8, n: e - at }
}

fn add_row_start(r: *mut MyResult) -> usize {
    return (*r).rows.len
}

fn add_cell(r: *mut MyResult, p: u64, n: usize) {
    w.put_u32le(&(*r).rows, (*r).data.len as u32)
    w.put_u32le(&(*r).data, n as u32)
    rt.buf_push_bytes(&(*r).data, p, n)
}

fn add_null_cell(r: *mut MyResult) {
    w.put_u32le(&(*r).rows, (*r).data.len as u32)
    w.put_u32le(&(*r).data, NULL_CELL)
}

fn finish_row(r: *mut MyResult) {
    (*r).nrows = (*r).nrows + 1
}

fn result_value(r: *mut MyResult, row: usize, col: usize, p: *mut u64, n: *mut usize) -> bool {
    if row >= (*r).nrows || col >= (*r).ncols { return false }
    let at: usize = rt.ld32((*r).rows.ptr, row * (*r).ncols + col) as usize
    let len: u32 = rt.ld32((*r).data.ptr + at as u64, 0)
    if len == NULL_CELL { return false }
    *p = (*r).data.ptr + (at + 4) as u64
    *n = len as usize
    return true
}

fn params_new() -> MyParams {
    return MyParams { count: 0, data: rt.buf_new() }
}

fn params_free(q: *mut MyParams) { rt.buf_free(&(*q).data) }

fn params_clear(q: *mut MyParams) {
    (*q).count = 0
    rt.buf_clear(&(*q).data)
}

fn params_text(q: *mut MyParams, p: u64, n: usize) {
    rt.buf_push(&(*q).data, 0 as u8)
    w.put_u32le(&(*q).data, n as u32)
    rt.buf_push_bytes(&(*q).data, p, n)
    (*q).count = (*q).count + 1
}

fn params_null(q: *mut MyParams) {
    rt.buf_push(&(*q).data, 1 as u8)
    w.put_u32le(&(*q).data, 0)
    (*q).count = (*q).count + 1
}
