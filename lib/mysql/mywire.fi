// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.crypto.sha1
import std.crypto.sha256

export {
    put_u16le, put_u32le, put_u64le, put_lenenc, put_cstr, put_lenstr, ld16le, ld32le, ld64le,
    read_lenenc, native_scramble, sha2_scramble,
    CAP_LONG_PASSWORD, CAP_CONNECT_WITH_DB, CAP_PROTOCOL_41, CAP_SSL, CAP_TRANSACTIONS,
    CAP_SECURE_CONNECTION, CAP_PLUGIN_AUTH, CAP_PLUGIN_AUTH_LENENC, MAX_PACKET,
}

const CAP_LONG_PASSWORD: u32 = 1
const CAP_CONNECT_WITH_DB: u32 = 8
const CAP_PROTOCOL_41: u32 = 512
const CAP_SSL: u32 = 2048
const CAP_TRANSACTIONS: u32 = 8192
const CAP_SECURE_CONNECTION: u32 = 32768
const CAP_PLUGIN_AUTH: u32 = 524288
const CAP_PLUGIN_AUTH_LENENC: u32 = 2097152
const MAX_PACKET: usize = 16777215

fn put_u16le(out: *mut rt.Buf, v: u32) {
    rt.buf_push(out, (v & 255) as u8)
    rt.buf_push(out, ((v >> 8) & 255) as u8)
}

fn put_u32le(out: *mut rt.Buf, v: u32) {
    put_u16le(out, v & 65535)
    put_u16le(out, v >> 16)
}

fn put_u64le(out: *mut rt.Buf, v: u64) {
    put_u32le(out, (v & 4294967295) as u32)
    put_u32le(out, (v >> 32) as u32)
}

fn put_lenenc(out: *mut rt.Buf, v: u64) {
    if v < 251 {
        rt.buf_push(out, v as u8)
    } else if v < 65536 {
        rt.buf_push(out, 252 as u8)
        put_u16le(out, v as u32)
    } else if v < 16777216 {
        rt.buf_push(out, 253 as u8)
        put_u16le(out, (v & 65535) as u32)
        rt.buf_push(out, (v >> 16) as u8)
    } else {
        rt.buf_push(out, 254 as u8)
        put_u64le(out, v)
    }
}

fn put_cstr(out: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(out, s.p as u64, s.n)
    rt.buf_push(out, 0 as u8)
}

fn put_lenstr(out: *mut rt.Buf, p: u64, n: usize) {
    put_lenenc(out, n as u64)
    rt.buf_push_bytes(out, p, n)
}

fn ld16le(p: u64, at: usize) -> u32 {
    return (rt.ld8(p, at) as u32) | ((rt.ld8(p, at + 1) as u32) << 8)
}

fn ld32le(p: u64, at: usize) -> u32 {
    return ld16le(p, at) | (ld16le(p, at + 2) << 16)
}

fn ld64le(p: u64, at: usize) -> u64 {
    return (ld32le(p, at) as u64) | ((ld32le(p, at + 4) as u64) << 32)
}

fn read_lenenc(p: u64, n: usize, pos: *mut usize, out: *mut u64) -> bool {
    if *pos >= n { return false }
    let b: u32 = rt.ld8(p, *pos) as u32
    if b < 251 {
        *out = b as u64
        *pos = *pos + 1
        return true
    }
    var w: usize = 0
    if b == 252 { w = 2 }
    if b == 253 { w = 3 }
    if b == 254 { w = 8 }
    if w == 0 || *pos + 1 + w > n { return false }
    var v: u64 = 0
    var i: usize = 0
    while i < w {
        v = v | ((rt.ld8(p, *pos + 1 + i) as u64) << ((i * 8) as u64))
        i = i + 1
    }
    *out = v
    *pos = *pos + 1 + w
    return true
}

fn native_scramble(pw: str, salt: u64, out: u64) {
    var h1: [u8; 20] = [0; 20]
    var h2: [u8; 20] = [0; 20]
    var h3: [u8; 20] = [0; 20]
    sha1.sha1(pw.p as u64, pw.n, (&h1[0]) as u64)
    sha1.sha1((&h1[0]) as u64, 20, (&h2[0]) as u64)
    var s: sha1.Sha1 = sha1.sha1_new()
    sha1.sha1_update(&s, salt, 20)
    sha1.sha1_update(&s, (&h2[0]) as u64, 20)
    sha1.sha1_final(&s, (&h3[0]) as u64)
    var i: usize = 0
    while i < 20 {
        rt.st8(out, i, h1[i] ^ h3[i])
        i = i + 1
    }
}

fn sha2_scramble(pw: str, salt: u64, out: u64) {
    var h1: [u8; 32] = [0; 32]
    var h2: [u8; 32] = [0; 32]
    var h3: [u8; 32] = [0; 32]
    sha256.sha256(pw.p as u64, pw.n, (&h1[0]) as u64)
    sha256.sha256((&h1[0]) as u64, 32, (&h2[0]) as u64)
    var s: sha256.Sha256 = sha256.sha256_new()
    sha256.sha256_update(&s, (&h2[0]) as u64, 32)
    sha256.sha256_update(&s, salt, 20)
    sha256.sha256_final(&s, (&h3[0]) as u64)
    var i: usize = 0
    while i < 32 {
        rt.st8(out, i, h1[i] ^ h3[i])
        i = i + 1
    }
}
