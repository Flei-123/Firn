// SPDX-License-Identifier: MPL-2.0
// lib/ws/ws.fi -- WebSocket (RFC 6455): the frame codec both sides share,
// and a blocking CLIENT (ws:// and wss://).
//
// The SERVER side lives in lib/http/server.fi, because a WebSocket starts
// life as an HTTP request (the Upgrade) and then shares the server's poll
// loop with every other connection. It uses the codec from here.
//
//     var c: ws.Client = ws.client_new()
//     ws.connect(&c, net.ipv4(127, 0, 0, 1), 8080, "localhost", "/ws") catch |e| ...
//     ws.send_text(&c, "hello")
//     var msg: rt.Buf = rt.buf_new()
//     let op: u32 = ws.recv(&c, &msg) catch |e| ...     // OP_TEXT / OP_BINARY / OP_CLOSE
//     ws.close(&c, 1000)
//
// WHAT THE CODEC CHECKS (each is a close code, RFC 6455 7.4.1):
//   1002  reserved bits set, an unknown opcode, a control frame that is
//         fragmented or longer than 125 octets, a continuation without a
//         message, a new message inside a fragmented one, a 64-bit length
//         with its top bit set, a close frame of length 1 or with a code
//         that must not appear on the wire
//   1007  text (or a close reason) that is not UTF-8 -- checked as the
//         octets arrive, so a broken sequence fails at once
//   1009  a message longer than the limit the receiver set
//
// The NON-BLOCKING client (reconnect with backoff, keep-alive pings, the
// closing handshake with a timeout, fragmentation, wss:// on the event loop)
// is lib/async/wsc.fi; it uses this codec. `backoff_ms` below is shared.
import std.rt
import std.str
import std.net
import std.base64
import std.crypto.sha1
import std.crypto.random
import tls.tls
import tls.x509

export {
    Frame, Utf8, Client, WsError,
    frame_new, parse_frame, write_frame, unmask, accept_key, close_code_ok,
    utf8_new, utf8_feed, utf8_complete,
    client_new, connect, connect_tls, send_text, send_binary, send_ping, recv,
    close, close_code, is_open, client_free,
    // round ASYNC
    send_fragmented, backoff_ms, close_timeout, send_close_frame,
    OP_CONT, OP_TEXT, OP_BINARY, OP_CLOSE, OP_PING, OP_PONG,
    PARSE_MORE, PARSE_OK, PARSE_ERROR,
}

const OP_CONT: u32 = 0
const OP_TEXT: u32 = 1
const OP_BINARY: u32 = 2
const OP_CLOSE: u32 = 8
const OP_PING: u32 = 9
const OP_PONG: u32 = 10

const PARSE_MORE: i32 = 0
const PARSE_OK: i32 = 1
const PARSE_ERROR: i32 = -1

error WsError {
    Io, // the socket failed
    Closed, // the peer went away
    Handshake, // the server did not answer 101 with the right accept key
    Protocol, // a frame broke RFC 6455
    TooLarge, // a message above the limit
    Tls, // the TLS layer refused (wss://)
}

// ------------------------------------------------------------ The frame

struct Frame {
    fin: bool,
    rsv: u32,
    op: u32,
    masked: bool,
    mask: [u8; 4],
    hlen: usize, // header octets (2..14)
    plen: u64, // payload octets
    err: u32, // the close code when parse_frame says PARSE_ERROR
}

fn frame_new() -> Frame {
    return Frame { fin: false, rsv: 0, op: 0, masked: false, mask: [0; 4],
        hlen: 0, plen: 0, err: 0 }
}

// Reads a frame HEADER from p[0..n). PARSE_MORE: not enough octets yet.
// PARSE_ERROR: `f.err` holds the close code. The payload is not touched.
fn parse_frame(p: u64, n: usize, f: *mut Frame) -> i32 {
    if n < 2 { return PARSE_MORE }
    let b0: u32 = rt.ld8(p, 0) as u32
    let b1: u32 = rt.ld8(p, 1) as u32
    (*f).fin = (b0 & 128) != 0
    (*f).rsv = (b0 >> 4) & 7
    (*f).op = b0 & 15
    (*f).masked = (b1 & 128) != 0
    var len: u64 = (b1 & 127) as u64
    var h: usize = 2
    if len == 126 {
        if n < 4 { return PARSE_MORE }
        len = ((rt.ld8(p, 2) as u64) << 8) | (rt.ld8(p, 3) as u64)
        h = 4
    } else if len == 127 {
        if n < 10 { return PARSE_MORE }
        len = 0
        var i: usize = 0
        while i < 8 {
            len = (len << 8) | (rt.ld8(p, 2 + i) as u64)
            i = i + 1
        }
        h = 10
        if (len >> 63) != 0 {
            (*f).err = 1002
            return PARSE_ERROR
        }
    }
    if (*f).masked {
        if n < h + 4 { return PARSE_MORE }
        var i: usize = 0
        while i < 4 {
            (*f).mask[i] = rt.ld8(p, h + i)
            i = i + 1
        }
        h = h + 4
    }
    (*f).hlen = h
    (*f).plen = len
    if (*f).rsv != 0 {
        (*f).err = 1002
        return PARSE_ERROR
    }
    let op: u32 = (*f).op
    if (op > 2 && op < 8) || op > 10 {
        (*f).err = 1002
        return PARSE_ERROR
    }
    if op >= 8 && (!(*f).fin || len > 125) {
        (*f).err = 1002
        return PARSE_ERROR
    }
    return PARSE_OK
}

// XORs p[0..n) with the mask, starting at mask position `at`.
fn unmask(p: u64, n: usize, mask: u64, at: usize) {
    var i: usize = 0
    while i < n {
        rt.st8(p, i, rt.ld8(p, i) ^ rt.ld8(mask, (at + i) & 3))
        i = i + 1
    }
}

// One whole frame into `out`. `mask` = 0: unmasked (server to client).
fn write_frame(out: *mut rt.Buf, op: u32, fin: bool, p: u64, n: usize, mask: u64) {
    var b0: u32 = op
    if fin { b0 = b0 | 128 }
    rt.buf_push(out, b0 as u8)
    var mb: u32 = 0
    if mask != 0 { mb = 128 }
    if n < 126 {
        rt.buf_push(out, (mb | n as u32) as u8)
    } else if n < 65536 {
        rt.buf_push(out, (mb | 126) as u8)
        rt.buf_push(out, ((n >> 8) & 255) as u8)
        rt.buf_push(out, (n & 255) as u8)
    } else {
        rt.buf_push(out, (mb | 127) as u8)
        var i: usize = 0
        while i < 8 {
            let sh: u64 = ((7 - i) * 8) as u64
            rt.buf_push(out, (((n as u64) >> sh) & 255) as u8)
            i = i + 1
        }
    }
    if mask != 0 {
        rt.buf_push_bytes(out, mask, 4)
    }
    let at: usize = (*out).len
    rt.buf_push_bytes(out, p, n)
    if mask != 0 {
        unmask((*out).ptr + at as u64, n, mask, 0)
    }
}

// Sec-WebSocket-Accept = base64(SHA-1(key + GUID)), 28 characters.
fn accept_key(key: str, out: *mut rt.Buf) {
    let guid: str = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
    var s: sha1.Sha1 = sha1.sha1_new()
    sha1.sha1_update(&s, key.p as u64, key.n)
    sha1.sha1_update(&s, guid.p as u64, guid.n)
    var d: [u8; 20] = [0; 20]
    sha1.sha1_final(&s, (&d[0]) as u64)
    base64.encode((&d[0]) as u64, 20, out)
}

// May this code appear in a close frame on the wire? (RFC 6455 7.4)
fn close_code_ok(c: u32) -> bool {
    if c >= 1000 && c <= 1003 { return true }
    if c >= 1007 && c <= 1011 { return true }
    return c >= 3000 && c <= 4999
}

// ------------------------------------------------------------ UTF-8

// A streaming check (Unicode 15, table 3-7): the state survives the end
// of a fragment, so a code point split across two frames is fine and a
// wrong octet fails the moment it arrives.
struct Utf8 {
    need: u32, // continuation octets still expected
    lo: u32, // bounds of the NEXT octet
    hi: u32,
}

fn utf8_new() -> Utf8 {
    return Utf8 { need: 0, lo: 128, hi: 191 }
}

fn utf8_feed(u: *mut Utf8, p: u64, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        let b: u32 = rt.ld8(p, i) as u32
        i = i + 1
        if (*u).need == 0 {
            if b < 128 { continue }
            (*u).lo = 128
            (*u).hi = 191
            if b >= 194 && b <= 223 {
                (*u).need = 1
            } else if b >= 224 && b <= 239 {
                (*u).need = 2
                if b == 224 { (*u).lo = 160 }
                if b == 237 { (*u).hi = 159 }
            } else if b >= 240 && b <= 244 {
                (*u).need = 3
                if b == 240 { (*u).lo = 144 }
                if b == 244 { (*u).hi = 143 }
            } else {
                return false
            }
        } else {
            if b < (*u).lo || b > (*u).hi { return false }
            (*u).lo = 128
            (*u).hi = 191
            (*u).need = (*u).need - 1
        }
    }
    return true
}

fn utf8_complete(u: *mut Utf8) -> bool {
    return (*u).need == 0
}

// ------------------------------------------------------------ The client

struct Client {
    conn: net.Conn,
    secure: bool,
    t: tls.Tls,
    store: x509.Store,
    inb: rt.Buf,
    inpos: usize,
    open: bool,
    close_code: u32,
    max: usize,
}

fn client_new() -> Client {
    return Client { conn: net.conn_from_fd(0 - 1), secure: false, t: tls.tls_new(),
        store: x509.store_new(), inb: rt.buf_new(), inpos: 0, open: false,
        close_code: 0, max: 16777216 }
}

fn client_free(c: *mut Client) {
    if (*c).secure { tls.tls_free(&(*c).t) }
    x509.store_free(&(*c).store)
    rt.buf_free(&(*c).inb)
    if net.conn_is_open(&(*c).conn) { net.close(&(*c).conn) }
}

fn is_open(c: *mut Client) -> bool { return (*c).open }
fn close_code(c: *mut Client) -> u32 { return (*c).close_code }

fn raw_write(c: *mut Client, p: u64, n: usize) -> bool {
    if (*c).secure {
        let ok: bool = tls.tls_write(&(*c).t, p, n) catch false
        return ok
    }
    let k: usize = net.write_all(&(*c).conn, p, n) catch 0
    return k == n
}

// More octets into `inb`. False at the end of the stream or on an error.
fn raw_fill(c: *mut Client) -> bool {
    if (*c).inpos > 0 && (*c).inpos == (*c).inb.len {
        rt.buf_clear(&(*c).inb)
        (*c).inpos = 0
    }
    let have: usize = (*c).inb.len
    rt.buf_reserve(&(*c).inb, have + 16384)
    var k: usize = 0
    if (*c).secure {
        k = tls.tls_read(&(*c).t, (*c).inb.ptr + have as u64, 16384) catch 0
    } else {
        k = net.read(&(*c).conn, (*c).inb.ptr + have as u64, 16384) catch 0
    }
    if k == 0 { return false }
    rt.buf_set_len(&(*c).inb, have + k)
    return true
}

fn push_str(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn handshake(c: *mut Client, host: str, path: str) -> WsError!bool {
    var nonce: [u8; 16] = [0; 16]
    if !random.random_bytes((&nonce[0]) as u64, 16) { return WsError::Io }
    var key: rt.Buf = rt.buf_new()
    base64.encode((&nonce[0]) as u64, 16, &key)
    var req: rt.Buf = rt.buf_new()
    push_str(&req, "GET ")
    push_str(&req, path)
    push_str(&req, " HTTP/1.1\r\nHost: ")
    push_str(&req, host)
    push_str(&req, "\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: ")
    rt.buf_push_bytes(&req, key.ptr, key.len)
    push_str(&req, "\r\n\r\n")
    let sent: bool = raw_write(c, req.ptr, req.len)
    rt.buf_free(&req)
    if !sent {
        rt.buf_free(&key)
        return WsError::Io
    }
    // the response header block
    var end: usize = 0
    while end == 0 {
        var i: usize = 0
        while i + 4 <= (*c).inb.len {
            if rt.ld8((*c).inb.ptr, i) == 13 as u8 && rt.ld8((*c).inb.ptr, i + 1) == 10 as u8
            && rt.ld8((*c).inb.ptr, i + 2) == 13 as u8 && rt.ld8((*c).inb.ptr, i + 3) == 10 as u8 {
                end = i + 4
                break
            }
            i = i + 1
        }
        if end == 0 {
            if (*c).inb.len > 16384 || !raw_fill(c) {
                rt.buf_free(&key)
                return WsError::Handshake
            }
        }
    }
    let head: str = str { p: (*c).inb.ptr as *mut u8, n: end }
    var want: rt.Buf = rt.buf_new()
    accept_key(str { p: key.ptr as *mut u8, n: key.len }, &want)
    rt.buf_free(&key)
    let ok101: bool = head.starts_with("HTTP/1.1 101")
    // "sec-websocket-accept:" case-insensitively, then compare the value
    var found: bool = false
    var i: usize = 0
    let name: str = "sec-websocket-accept:"
    while i + name.n <= head.n && !found {
        var same: bool = true
        var k: usize = 0
        while k < name.n {
            var ch: u8 = *(head.p + i + k)
            if ch >= 65 as u8 && ch <= 90 as u8 { ch = ch + 32 as u8 }
            if ch != *(name.p + k) {
                same = false
                break
            }
            k = k + 1
        }
        if same {
            var v: usize = i + name.n
            while v < head.n && *(head.p + v) == 32 as u8 { v = v + 1 }
            found = v + want.len <= head.n
            && rt.mem_eq((head.p + v) as u64, want.ptr, want.len)
        }
        i = i + 1
    }
    rt.buf_free(&want)
    (*c).inpos = end
    if !ok101 || !found { return WsError::Handshake }
    (*c).open = true
    return true
}

// ws:// -- a numeric IPv4 address, the Host header, the path.
fn connect(c: *mut Client, addr: u32, port: u16, host: str, path: str) -> WsError!bool {
    var err: i64 = 0
    (*c).conn = net.connect_tcp_err(addr, port, &err) catch net.conn_from_fd(0 - 1)
    if !net.conn_is_open(&(*c).conn) { return WsError::Io }
    let nd: bool = net.set_no_delay(&(*c).conn, true) catch false
    return handshake(c, host, path)
}

// wss:// -- TLS 1.3 first (lib/tls/tls.fi), the certificate checked
// against the PEM roots in `roots` and the name `host` at time `now`
// (seconds since 1970).
fn connect_tls(c: *mut Client, addr: u32, port: u16, host: str, path: str,
    roots: u64, rn: usize, now: u64) -> WsError!bool {
    var err: i64 = 0
    (*c).conn = net.connect_tcp_err(addr, port, &err) catch net.conn_from_fd(0 - 1)
    if !net.conn_is_open(&(*c).conn) { return WsError::Io }
    let nd: bool = net.set_no_delay(&(*c).conn, true) catch false
    x509.store_load_pem(&(*c).store, roots, rn)
    if !tls.tls_init(&(*c).t, &(*c).conn, &(*c).store, host.p as u64, host.n, now) {
        return WsError::Tls
    }
    (*c).secure = true
    let ok: bool = tls.tls_handshake(&(*c).t) catch false
    if !ok { return WsError::Tls }
    return handshake(c, host, path)
}

fn send_frame(c: *mut Client, op: u32, p: u64, n: usize) -> bool {
    if !(*c).open { return false }
    var mask: [u8; 4] = [0; 4]
    if !random.random_bytes((&mask[0]) as u64, 4) { return false }
    var out: rt.Buf = rt.buf_new()
    write_frame(&out, op, true, p, n, (&mask[0]) as u64)
    let ok: bool = raw_write(c, out.ptr, out.len)
    rt.buf_free(&out)
    return ok
}

fn send_text(c: *mut Client, s: str) -> bool {
    return send_frame(c, OP_TEXT, s.p as u64, s.n)
}

fn send_binary(c: *mut Client, p: u64, n: usize) -> bool {
    return send_frame(c, OP_BINARY, p, n)
}

fn send_ping(c: *mut Client, p: u64, n: usize) -> bool {
    return send_frame(c, OP_PING, p, n)
}

// Starts the closing handshake with `code`, reads until the peer's close
// (or the end of the stream) and closes the socket.
fn close(c: *mut Client, code: u32) {
    if (*c).open {
        var b: [u8; 2] = [0, 0]
        b[0] = ((code >> 8) & 255) as u8
        b[1] = (code & 255) as u8
        send_frame(c, OP_CLOSE, (&b[0]) as u64, 2)
        var scratch: rt.Buf = rt.buf_new()
        var guard: usize = 0
        while (*c).open && guard < 64 {
            let op: u32 = recv(c, &scratch) catch 0
            if op == 0 || op == OP_CLOSE { break }
            guard = guard + 1
        }
        rt.buf_free(&scratch)
        (*c).open = false
    }
    if (*c).secure { tls.tls_close(&(*c).t) }
    if net.conn_is_open(&(*c).conn) { net.close(&(*c).conn) }
}

// The next whole MESSAGE into `out` (cleared first). Pings are answered
// and pongs dropped on the way. Returns OP_TEXT, OP_BINARY or OP_CLOSE
// (then `close_code` holds the peer's code and the close is answered).
fn recv(c: *mut Client, out: *mut rt.Buf) -> WsError!u32 {
    rt.buf_clear(out)
    var in_msg: bool = false
    var mop: u32 = 0
    var u: Utf8 = utf8_new()
    while true {
        var f: Frame = frame_new()
        let base: u64 = (*c).inb.ptr + (*c).inpos as u64
        let have: usize = (*c).inb.len - (*c).inpos
        let r: i32 = parse_frame(base, have, &f)
        if r == PARSE_ERROR { return WsError::Protocol }
        if r == PARSE_MORE || (have as u64) < (f.hlen as u64) + f.plen {
            if !raw_fill(c) {
                (*c).open = false
                return WsError::Closed
            }
            continue
        }
        if f.masked { return WsError::Protocol } // a server never masks
        let pl: usize = f.plen as usize
        let pp: u64 = base + f.hlen as u64
        (*c).inpos = (*c).inpos + f.hlen + pl
        if f.op == OP_PING {
            send_frame(c, OP_PONG, pp, pl)
            continue
        }
        if f.op == OP_PONG { continue }
        if f.op == OP_CLOSE {
            (*c).close_code = 1005
            if pl >= 2 {
                (*c).close_code = ((rt.ld8(pp, 0) as u32) << 8) | (rt.ld8(pp, 1) as u32)
            }
            if (*c).open {
                var b: [u8; 2] = [3, 232]
                send_frame(c, OP_CLOSE, (&b[0]) as u64, 2)
                (*c).open = false
            }
            return OP_CLOSE
        }
        if f.op == OP_CONT {
            if !in_msg { return WsError::Protocol }
        } else {
            if in_msg { return WsError::Protocol }
            in_msg = true
            mop = f.op
        }
        if (*out).len + pl > (*c).max { return WsError::TooLarge }
        rt.buf_push_bytes(out, pp, pl)
        if mop == OP_TEXT && !utf8_feed(&u, pp, pl) { return WsError::Protocol }
        if f.fin {
            if mop == OP_TEXT && !utf8_complete(&u) { return WsError::Protocol }
            return mop
        }
    }
    return WsError::Protocol
}

// ------------------------------------------------------------ Round ASYNC

// One message in fragments of at most `frag` octets (a TEXT or BINARY frame
// without FIN, then CONTINUATION frames, the last with FIN). A message that
// fits in one fragment is a single frame. Control frames (pings) may be
// sent between calls; they must not be sent between fragments of ONE call
// and cannot be -- the fragments leave in one write.
fn send_fragmented(c: *mut Client, op: u32, p: u64, n: usize, frag: usize) -> bool {
    if !(*c).open { return false }
    if op != OP_TEXT && op != OP_BINARY { return false }
    if frag == 0 || n <= frag {
        return send_frame(c, op, p, n)
    }
    var out: rt.Buf = rt.buf_new()
    var at: usize = 0
    var first: bool = true
    while at < n {
        var k: usize = n - at
        if k > frag { k = frag }
        var mask: [u8; 4] = [0; 4]
        if !random.random_bytes((&mask[0]) as u64, 4) {
            rt.buf_free(&out)
            return false
        }
        var fop: u32 = OP_CONT
        if first { fop = op }
        write_frame(&out, fop, at + k == n, p + at as u64, k, (&mask[0]) as u64)
        first = false
        at = at + k
    }
    let ok: bool = raw_write(c, out.ptr, out.len)
    rt.buf_free(&out)
    return ok
}

// A close frame (code, no reason) without waiting for the answer.
fn send_close_frame(c: *mut Client, code: u32) -> bool {
    var b: [u8; 2] = [0, 0]
    b[0] = ((code >> 8) & 255) as u8
    b[1] = (code & 255) as u8
    return send_frame(c, OP_CLOSE, (&b[0]) as u64, 2)
}

// `close`, but the peer gets at most `ms` milliseconds to answer (the plain
// `close` waits for as long as the socket lets it). The socket timeout is
// set on the connection, so this holds for plain and TLS connections alike.
fn close_timeout(c: *mut Client, code: u32, ms: u64) {
    if net.conn_is_open(&(*c).conn) {
        net.set_timeout(&(*c).conn, ms) catch false
    }
    close(c, code)
}

// Delay before reconnect attempt number `attempt` (0 = the first retry):
// base * 2^attempt, capped, then spread by +-20 % with `rnd` (any u32;
// callers pass random bytes) so that a thousand clients that lost the same
// server do not return in the same millisecond.
fn backoff_ms(attempt: u32, base: i64, cap: i64, rnd: u32) -> i64 {
    var d: i64 = base
    var i: u32 = 0
    while i < attempt && d < cap {
        d = d * 2
        i = i + 1
    }
    if d > cap { d = cap }
    // factor 0.8 .. 1.2 in steps of 1/1000
    let f: i64 = 800 + (rnd % 401) as i64
    d = d * f / 1000
    if d < 1 { d = 1 }
    return d
}
