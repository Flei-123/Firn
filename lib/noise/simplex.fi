// SPDX-License-Identifier: MPL-2.0
// lib/noise/simplex.fi -- 2D/3D simplex noise (Gustavson, public domain) with a random origin offset and a caller supplied permutation.
import std.math
import noise.jnum
import noise.gradient

export { Simplex, simplex_new, simplex_swap, simplex_value2, simplex_value3 }

struct Simplex {
    p: [u8; 256],
    xo: f64,
    yo: f64,
    zo: f64,
}

fn simplex_new(xo: f64, yo: f64, zo: f64) -> Simplex {
    var n: Simplex = Simplex { p: [0; 256], xo: xo, yo: yo, zo: zo }
    var i: usize = 0
    while i < 256 {
        n.p[i] = i as u8
        i = i + 1
    }
    return n
}

fn simplex_swap(n: *mut Simplex, i: i32, j: i32) {
    let t: u8 = (*n).p[i as usize]
    (*n).p[i as usize] = (*n).p[j as usize]
    (*n).p[j as usize] = t
}

fn perm(n: *Simplex, i: i32) -> i32 {
    return (*n).p[(i & 255) as usize] as i32
}

#[allow_fp]
fn corner(gi: i32, x: f64, y: f64, z: f64, base: f64) -> f64 {
    var d1: f64 = base - x * x - y * y - z * z
    if d1 < 0.0 {
        return 0.0
    }
    d1 = d1 * d1
    return d1 * d1 * gradient.grad_dot(gi, x, y, z)
}

#[allow_fp]
fn simplex_value2(n: *Simplex, x: f64, y: f64) -> f64 {
    let sqrt3: f64 = math.sqrt(3.0)
    let f2: f64 = 0.5 * (sqrt3 - 1.0)
    let g2: f64 = (3.0 - sqrt3) / 6.0
    let d0: f64 = (x + y) * f2
    let i: i32 = jnum.floor_i32(x + d0)
    let j: i32 = jnum.floor_i32(y + d0)
    let d1: f64 = ((i +% j) as f64) * g2
    let d2: f64 = (i as f64) - d1
    let d3: f64 = (j as f64) - d1
    let d4: f64 = x - d2
    let d5: f64 = y - d3
    var k: i32 = 0
    var l: i32 = 1
    if d4 > d5 {
        k = 1
        l = 0
    }
    let d6: f64 = d4 - (k as f64) + g2
    let d7: f64 = d5 - (l as f64) + g2
    let d8: f64 = d4 - 1.0 + 2.0 * g2
    let d9: f64 = d5 - 1.0 + 2.0 * g2
    let i1: i32 = i & 255
    let j1: i32 = j & 255
    let k1: i32 = perm(n, i1 +% perm(n, j1)) % 12
    let l1: i32 = perm(n, i1 +% k +% perm(n, j1 +% l)) % 12
    let i2: i32 = perm(n, i1 +% 1 +% perm(n, j1 +% 1)) % 12
    let d10: f64 = corner(k1, d4, d5, 0.0, 0.5)
    let d11: f64 = corner(l1, d6, d7, 0.0, 0.5)
    let d12: f64 = corner(i2, d8, d9, 0.0, 0.5)
    return 70.0 * (d10 + d11 + d12)
}

#[allow_fp]
fn simplex_value3(n: *Simplex, x: f64, y: f64, z: f64) -> f64 {
    let d0: f64 = 0.3333333333333333
    let d1: f64 = (x + y + z) * d0
    let i: i32 = jnum.floor_i32(x + d1)
    let j: i32 = jnum.floor_i32(y + d1)
    let k: i32 = jnum.floor_i32(z + d1)
    let d2: f64 = 0.16666666666666666
    let d3: f64 = ((i +% j +% k) as f64) * d2
    let d4: f64 = (i as f64) - d3
    let d5: f64 = (j as f64) - d3
    let d6: f64 = (k as f64) - d3
    let d7: f64 = x - d4
    let d8: f64 = y - d5
    let d9: f64 = z - d6
    var l: i32 = 0
    var i1: i32 = 0
    var j1: i32 = 0
    var k1: i32 = 0
    var l1: i32 = 0
    var i2: i32 = 0
    if d7 >= d8 {
        if d8 >= d9 {
            l = 1
            k1 = 1
            l1 = 1
        } else if d7 >= d9 {
            l = 1
            k1 = 1
            i2 = 1
        } else {
            j1 = 1
            k1 = 1
            i2 = 1
        }
    } else if d8 < d9 {
        j1 = 1
        l1 = 1
        i2 = 1
    } else if d7 < d9 {
        i1 = 1
        l1 = 1
        i2 = 1
    } else {
        i1 = 1
        k1 = 1
        l1 = 1
    }
    let d10: f64 = d7 - (l as f64) + d2
    let d11: f64 = d8 - (i1 as f64) + d2
    let d12: f64 = d9 - (j1 as f64) + d2
    let d13: f64 = d7 - (k1 as f64) + 0.3333333333333333
    let d14: f64 = d8 - (l1 as f64) + 0.3333333333333333
    let d15: f64 = d9 - (i2 as f64) + 0.3333333333333333
    let d16: f64 = d7 - 1.0 + 0.5
    let d17: f64 = d8 - 1.0 + 0.5
    let d18: f64 = d9 - 1.0 + 0.5
    let j2: i32 = i & 255
    let k2: i32 = j & 255
    let l2: i32 = k & 255
    let i3: i32 = perm(n, j2 +% perm(n, k2 +% perm(n, l2))) % 12
    let j3: i32 = perm(n, j2 +% l +% perm(n, k2 +% i1 +% perm(n, l2 +% j1))) % 12
    let k3: i32 = perm(n, j2 +% k1 +% perm(n, k2 +% l1 +% perm(n, l2 +% i2))) % 12
    let l3: i32 = perm(n, j2 +% 1 +% perm(n, k2 +% 1 +% perm(n, l2 +% 1))) % 12
    let d19: f64 = corner(i3, d7, d8, d9, 0.6)
    let d20: f64 = corner(j3, d10, d11, d12, 0.6)
    let d21: f64 = corner(k3, d13, d14, d15, 0.6)
    let d22: f64 = corner(l3, d16, d17, d18, 0.6)
    return 32.0 * (d19 + d20 + d21 + d22)
}
