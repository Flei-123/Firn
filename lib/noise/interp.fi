// SPDX-License-Identifier: MPL-2.0
// lib/noise/interp.fi -- interpolation helpers of gradient noise (fixed evaluation order, no fused multiply-add).
export { lerp, lerp2, lerp3, smoothstep, smoothstep_derivative, inverse_lerp, clamped_lerp, clamped_map }

#[allow_fp]
fn lerp(t: f64, a: f64, b: f64) -> f64 {
    return a + t * (b - a)
}

#[allow_fp]
fn lerp2(t1: f64, t2: f64, v00: f64, v10: f64, v01: f64, v11: f64) -> f64 {
    return lerp(t2, lerp(t1, v00, v10), lerp(t1, v01, v11))
}

#[allow_fp]
fn lerp3(t1: f64, t2: f64, t3: f64, v000: f64, v100: f64, v010: f64, v110: f64, v001: f64, v101: f64, v011: f64, v111: f64) -> f64 {
    return lerp(t3, lerp2(t1, t2, v000, v100, v010, v110), lerp2(t1, t2, v001, v101, v011, v111))
}

#[allow_fp]
fn smoothstep(x: f64) -> f64 {
    return x * x * x * (x * (x * 6.0 - 15.0) + 10.0)
}

#[allow_fp]
fn smoothstep_derivative(x: f64) -> f64 {
    return 30.0 * x * x * (x - 1.0) * (x - 1.0)
}

#[allow_fp]
fn inverse_lerp(t: f64, a: f64, b: f64) -> f64 {
    return (t - a) / (b - a)
}

#[allow_fp]
fn clamped_lerp(a: f64, b: f64, t: f64) -> f64 {
    if t < 0.0 {
        return a
    }
    if t > 1.0 {
        return b
    }
    return lerp(t, a, b)
}

#[allow_fp]
fn clamped_map(v: f64, in_min: f64, in_max: f64, out_min: f64, out_max: f64) -> f64 {
    return clamped_lerp(out_min, out_max, inverse_lerp(v, in_min, in_max))
}
