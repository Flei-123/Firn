// SPDX-License-Identifier: MPL-2.0
// lib/noise/psimplex.fi -- octave stack over simplex noise (legacy biome temperature).
import noise.jnum
import noise.simplex

export { PerlinSimplex, psimplex_empty, psimplex_set, psimplex_finish, psimplex_value }

struct PerlinSimplex {
    count: i32,
    has: [bool; 32],
    lv: [simplex.Simplex; 32],
    highest_input: f64,
    highest_value: f64,
}

fn psimplex_empty(count: i32) -> PerlinSimplex {
    let z: simplex.Simplex = simplex.simplex_new(0.0, 0.0, 0.0)
    return PerlinSimplex { count: count, has: [false; 32], lv: [z; 32], highest_input: 1.0, highest_value: 1.0 }
}

fn psimplex_set(p: *mut PerlinSimplex, k: i32, level: simplex.Simplex) {
    (*p).has[k as usize] = true
    (*p).lv[k as usize] = level
}

#[allow_fp]
fn psimplex_finish(p: *mut PerlinSimplex, top: i32) {
    (*p).highest_input = jnum.pow2_i32(top)
    (*p).highest_value = 1.0 / (jnum.pow2_i32((*p).count) - 1.0)
}

#[allow_fp]
fn psimplex_value(p: *PerlinSimplex, x: f64, y: f64, use_offsets: bool) -> f64 {
    var acc: f64 = 0.0
    var f_in: f64 = (*p).highest_input
    var f_val: f64 = (*p).highest_value
    var i: i32 = 0
    while i < (*p).count {
        if (*p).has[i as usize] {
            var ox: f64 = 0.0
            var oy: f64 = 0.0
            if use_offsets {
                ox = (*p).lv[i as usize].xo
                oy = (*p).lv[i as usize].yo
            }
            acc = acc + simplex.simplex_value2(&(*p).lv[i as usize], x * f_in + ox, y * f_in + oy) * f_val
        }
        f_in = f_in / 2.0
        f_val = f_val * 2.0
        i = i + 1
    }
    return acc
}
