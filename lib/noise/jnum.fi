// lib/noise/jnum.fi -- Java numeric conversions: saturating (int)/(long) casts and floor.
import std.rt

export { d2i, d2l, floor_i32, floor_i64, pow2_i32 }

#[allow_fp]
fn d2i(v: f64) -> i32 {
    if v != v {
        return 0
    }
    if v >= 2147483647.0 {
        return 2147483647
    }
    if v <= -2147483648.0 {
        return -2147483647 - 1
    }
    return v as i32
}

#[allow_fp]
fn d2l(v: f64) -> i64 {
    if v != v {
        return 0
    }
    if v >= 9223372036854775807.0 {
        return 9223372036854775807
    }
    if v <= -9223372036854775808.0 {
        return -9223372036854775807 - 1
    }
    return v as i64
}

#[allow_fp]
fn floor_i32(v: f64) -> i32 {
    let i: i32 = d2i(v)
    if v < (i as f64) && i > -2147483647 - 1 {
        return i -% 1
    }
    return i
}

#[allow_fp]
fn floor_i64(v: f64) -> i64 {
    let i: i64 = d2l(v)
    if v < (i as f64) && i > -9223372036854775807 - 1 {
        return i -% 1
    }
    return i
}

#[allow_fp]
fn pow2_i32(e: i32) -> f64 {
    var r: f64 = 1.0
    var k: i32 = e
    while k > 0 {
        r = r * 2.0
        k = k - 1
    }
    while k < 0 {
        r = r / 2.0
        k = k + 1
    }
    return r
}
