// SPDX-License-Identifier: MPL-2.0
// lib/noise/gradient.fi -- the 16 edge gradients of improved/simplex noise, packed 2 bits per entry (0, 1, -1).
export { grad_dot, grad_comp }

const GRAD_X: u32 = 553687449
const GRAD_Y: u32 = 2576941221
const GRAD_Z: u32 = 2225448192

fn unpack(packed: u32, h: i32) -> i32 {
    let c: u32 = (packed >> ((h & 15) * 2) as u32) & 3 as u32
    return ((c & 1 as u32) as i32) - ((c >> 1 as u32) as i32)
}

fn grad_comp(axis: i32, h: i32) -> i32 {
    if axis == 0 {
        return unpack(GRAD_X, h)
    }
    if axis == 1 {
        return unpack(GRAD_Y, h)
    }
    return unpack(GRAD_Z, h)
}

#[allow_fp]
fn grad_dot(h: i32, x: f64, y: f64, z: f64) -> f64 {
    return (unpack(GRAD_X, h) as f64) * x + (unpack(GRAD_Y, h) as f64) * y + (unpack(GRAD_Z, h) as f64) * z
}
