// SPDX-License-Identifier: MPL-2.0
// lib/noise/gradient.fi -- the 16 edge gradients of improved/simplex noise, packed 2 bits per entry (two's complement: 0, 1, -1).
export { grad_dot, grad_comp }

const GRAD_X: i32 = 822140381
const GRAD_Y: i32 = -572718859
const GRAD_Z: i32 = -990513920

fn unpack(packed: i32, h: i32) -> i32 {
    return (packed << (30 - (h & 15) * 2)) >> 30
}

fn grad_comp(axis: i32, h: i32) -> i32 {
    if axis == 0 {
        return unpack(GRAD_X, h)
    }
    if axis == 1 {
        return unpack(GRAD_Y, h)
    }
    return unpack(GRAD_Z, h)
}

#[allow_fp]
fn grad_dot(h: i32, x: f64, y: f64, z: f64) -> f64 {
    return (unpack(GRAD_X, h) as f64) * x + (unpack(GRAD_Y, h) as f64) * y + (unpack(GRAD_Z, h) as f64) * z
}
