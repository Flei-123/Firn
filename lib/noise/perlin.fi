// SPDX-License-Identifier: MPL-2.0
// lib/noise/perlin.fi -- octave stacks over improved noise: fractal Perlin, the two-stack "normal" noise and
// the old blended terrain noise. Octave noises are created by the caller (they need the random generator).
import noise.jnum
import noise.interp
import noise.improved

export {
    MAX_OCTAVES, Perlin, Normal, Blended, perlin_empty, perlin_set, perlin_finish, perlin_value, perlin_value_smear,
    perlin_max_broken, perlin_octave, perlin_octave_has, perlin_wrap, normal_finish, normal_value, blended_new, blended_value,
}

const MAX_OCTAVES: i32 = 32
const WRAP_RANGE: f64 = 33554432.0

struct Perlin {
    count: i32,
    first_octave: i32,
    has: [bool; 32],
    amp: [f64; 32],
    lv: [improved.Improved; 32],
    lowest_input: f64,
    lowest_value: f64,
    max_value: f64,
}

#[allow_fp]
fn perlin_empty(first_octave: i32, count: i32) -> Perlin {
    let z: improved.Improved = improved.improved_new(0.0, 0.0, 0.0)
    return Perlin {
        count: count, first_octave: first_octave, has: [false; 32], amp: [0.0; 32], lv: [z; 32],
        lowest_input: 1.0, lowest_value: 1.0, max_value: 0.0,
    }
}

fn perlin_set(p: *mut Perlin, k: i32, amplitude: f64, level: improved.Improved) {
    (*p).amp[k as usize] = amplitude
    (*p).has[k as usize] = true
    (*p).lv[k as usize] = level
}

#[allow_fp]
fn edge_value(p: *Perlin, d: f64) -> f64 {
    var acc: f64 = 0.0
    var f: f64 = (*p).lowest_value
    var i: i32 = 0
    while i < (*p).count {
        if (*p).has[i as usize] {
            acc = acc + (*p).amp[i as usize] * d * f
        }
        f = f / 2.0
        i = i + 1
    }
    return acc
}

#[allow_fp]
fn perlin_finish(p: *mut Perlin) {
    let j: i32 = 0 - (*p).first_octave
    let i: i32 = (*p).count
    (*p).lowest_input = jnum.pow2_i32(0 - j)
    (*p).lowest_value = jnum.pow2_i32(i - 1) / (jnum.pow2_i32(i) - 1.0)
    (*p).max_value = edge_value(p, 2.0)
}

#[allow_fp]
fn perlin_wrap(v: f64) -> f64 {
    return v - (jnum.floor_i64(v / WRAP_RANGE + 0.5) as f64) * WRAP_RANGE
}

#[allow_fp]
fn perlin_value_smear(p: *Perlin, x: f64, y: f64, z: f64, y_scale: f64, y_max: f64) -> f64 {
    var acc: f64 = 0.0
    var f_in: f64 = (*p).lowest_input
    var f_val: f64 = (*p).lowest_value
    var i: i32 = 0
    while i < (*p).count {
        if (*p).has[i as usize] {
            let d: f64 = improved.improved_noise_smear(&(*p).lv[i as usize], perlin_wrap(x * f_in), perlin_wrap(y * f_in), perlin_wrap(z * f_in), y_scale * f_in, y_max * f_in)
            acc = acc + (*p).amp[i as usize] * d * f_val
        }
        f_in = f_in * 2.0
        f_val = f_val / 2.0
        i = i + 1
    }
    return acc
}

#[allow_fp]
fn perlin_value(p: *Perlin, x: f64, y: f64, z: f64) -> f64 {
    return perlin_value_smear(p, x, y, z, 0.0, 0.0)
}

#[allow_fp]
fn perlin_max_broken(p: *Perlin, y_scale: f64) -> f64 {
    return edge_value(p, y_scale + 2.0)
}

fn perlin_octave(p: *Perlin, i: i32) -> *improved.Improved {
    return &(*p).lv[((*p).count - 1 - i) as usize]
}

fn perlin_octave_has(p: *Perlin, i: i32) -> bool {
    return (*p).has[((*p).count - 1 - i) as usize]
}

struct Normal {
    first: Perlin,
    second: Perlin,
    value_factor: f64,
    max_value: f64,
}

#[allow_fp]
fn normal_finish(n: *mut Normal) {
    var lo: i32 = 2147483647
    var hi: i32 = -2147483647 - 1
    var i: i32 = 0
    while i < (*n).first.count {
        if (*n).first.amp[i as usize] != 0.0 {
            if i < lo {
                lo = i
            }
            if i > hi {
                hi = i
            }
        }
        i = i + 1
    }
    let dev: f64 = 0.1 * (1.0 + 1.0 / ((hi - lo + 1) as f64))
    (*n).value_factor = 0.16666666666666666 / dev
    (*n).max_value = ((*n).first.max_value + (*n).second.max_value) * (*n).value_factor
}

#[allow_fp]
fn normal_value(n: *Normal, x: f64, y: f64, z: f64) -> f64 {
    let a: f64 = perlin_value(&(*n).first, x, y, z)
    let b: f64 = perlin_value(&(*n).second, x * 1.0181268882175227, y * 1.0181268882175227, z * 1.0181268882175227)
    return (a + b) * (*n).value_factor
}

struct Blended {
    min_limit: Perlin,
    max_limit: Perlin,
    main: Perlin,
    xz_multiplier: f64,
    y_multiplier: f64,
    xz_factor: f64,
    y_factor: f64,
    smear_multiplier: f64,
    max_value: f64,
}

#[allow_fp]
fn blended_new(min_limit: Perlin, max_limit: Perlin, main: Perlin, xz_scale: f64, y_scale: f64, xz_factor: f64, y_factor: f64, smear: f64) -> Blended {
    let ym: f64 = 684.412 * y_scale
    var b: Blended = Blended {
        min_limit: min_limit, max_limit: max_limit, main: main, xz_multiplier: 684.412 * xz_scale, y_multiplier: ym,
        xz_factor: xz_factor, y_factor: y_factor, smear_multiplier: smear, max_value: 0.0,
    }
    b.max_value = perlin_max_broken(&b.min_limit, ym)
    return b
}

#[allow_fp]
fn blended_value(b: *Blended, bx: i32, by: i32, bz: i32) -> f64 {
    let d0: f64 = (bx as f64) * (*b).xz_multiplier
    let d1: f64 = (by as f64) * (*b).y_multiplier
    let d2: f64 = (bz as f64) * (*b).xz_multiplier
    let d3: f64 = d0 / (*b).xz_factor
    let d4: f64 = d1 / (*b).y_factor
    let d5: f64 = d2 / (*b).xz_factor
    let d6: f64 = (*b).y_multiplier * (*b).smear_multiplier
    let d7: f64 = d6 / (*b).y_factor
    var d8: f64 = 0.0
    var d9: f64 = 0.0
    var d10: f64 = 0.0
    var d11: f64 = 1.0
    var i: i32 = 0
    while i < 8 {
        if perlin_octave_has(&(*b).main, i) {
            d10 = d10 + improved.improved_noise_smear(perlin_octave(&(*b).main, i), perlin_wrap(d3 * d11), perlin_wrap(d4 * d11), perlin_wrap(d5 * d11), d7 * d11, d4 * d11) / d11
        }
        d11 = d11 / 2.0
        i = i + 1
    }
    let d16: f64 = (d10 / 10.0 + 1.0) / 2.0
    let hi_clamp: bool = d16 >= 1.0
    let lo_clamp: bool = d16 <= 0.0
    d11 = 1.0
    var j: i32 = 0
    while j < 16 {
        let d12: f64 = perlin_wrap(d0 * d11)
        let d13: f64 = perlin_wrap(d1 * d11)
        let d14: f64 = perlin_wrap(d2 * d11)
        let d15: f64 = d6 * d11
        if !hi_clamp {
            if perlin_octave_has(&(*b).min_limit, j) {
                d8 = d8 + improved.improved_noise_smear(perlin_octave(&(*b).min_limit, j), d12, d13, d14, d15, d1 * d11) / d11
            }
        }
        if !lo_clamp {
            if perlin_octave_has(&(*b).max_limit, j) {
                d9 = d9 + improved.improved_noise_smear(perlin_octave(&(*b).max_limit, j), d12, d13, d14, d15, d1 * d11) / d11
            }
        }
        d11 = d11 / 2.0
        j = j + 1
    }
    return interp.clamped_lerp(d8 / 512.0, d9 / 512.0, d16) / 128.0
}
