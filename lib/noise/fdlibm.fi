// lib/noise/fdlibm.fi -- fdlibm natural logarithm (the algorithm of java.lang.StrictMath.log), bit exact.
import std.math

export { fd_log }

const TWO54: f64 = 18014398509481984.0
const LN2_HI: f64 = 0.693147180369123816490
const LN2_LO: f64 = 0.000000000190821492927058770002
const LG1: f64 = 0.6666666666666735130
const LG2: f64 = 0.3999999999940941908
const LG3: f64 = 0.2857142874366239149
const LG4: f64 = 0.2222219843214978396
const LG5: f64 = 0.1818357216161805012
const LG6: f64 = 0.1531383769920937332
const LG7: f64 = 0.1479819860511658591

fn hi_word(x: f64) -> i32 {
    return (math.math_bits(x) >> 32) as% i32
}

fn with_hi(x: f64, high: i32) -> f64 {
    let h: u32 = high as% u32
    return math.math_f64((math.math_bits(x) & 0xffffffff) | ((h as u64) << 32))
}

#[allow_fp]
fn fd_log(x0: f64) -> f64 {
    var x: f64 = x0
    var hx: i32 = hi_word(x)
    let lx: u32 = math.math_bits(x) as% u32
    var k: i32 = 0
    if hx < 0x00100000 {
        if (((hx & 0x7fffffff) as% u32) | lx) == 0 as u32 {
            return 0.0 - math.INF()
        }
        if hx < 0 {
            return math.NAN()
        }
        k = k - 54
        x = x * TWO54
        hx = hi_word(x)
    }
    if hx >= 0x7ff00000 {
        return x + x
    }
    k = k + ((hx >> 20) - 1023)
    hx = hx & 0x000fffff
    let i0: i32 = (hx + 0x95f64) & 0x100000
    x = with_hi(x, hx | (i0 ^ 0x3ff00000))
    k = k + (i0 >> 20)
    let f: f64 = x - 1.0
    if (0x000fffff & (2 + hx)) < 3 {
        if f == 0.0 {
            if k == 0 {
                return 0.0
            }
            let dk: f64 = k as f64
            return dk * LN2_HI + dk * LN2_LO
        }
        let r: f64 = f * f * (0.5 - 0.33333333333333333 * f)
        if k == 0 {
            return f - r
        }
        let dk: f64 = k as f64
        return dk * LN2_HI - ((r - dk * LN2_LO) - f)
    }
    let s: f64 = f / (2.0 + f)
    let dk: f64 = k as f64
    let z: f64 = s * s
    var i: i32 = hx - 0x6147a
    let w: f64 = z * z
    let j: i32 = 0x6b851 - hx
    let t1: f64 = w * (LG2 + w * (LG4 + w * LG6))
    let t2: f64 = z * (LG1 + w * (LG3 + w * (LG5 + w * LG7)))
    i = i | j
    let r: f64 = t2 + t1
    if i > 0 {
        let hfsq: f64 = 0.5 * f * f
        if k == 0 {
            return f - (hfsq - s * (hfsq + r))
        }
        return dk * LN2_HI - ((hfsq - (s * (hfsq + r) + dk * LN2_LO)) - f)
    }
    if k == 0 {
        return f - s * (f - r)
    }
    return dk * LN2_HI - ((s * (f - r) - dk * LN2_LO) - f)
}
