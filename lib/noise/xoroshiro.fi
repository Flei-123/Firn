// SPDX-License-Identifier: MPL-2.0
// lib/noise/xoroshiro.fi -- Xoroshiro128++ (Blackman/Vigna, public domain) and the Stafford variant 13 mixer.
export { Xoro, GOLDEN_RATIO_64, SILVER_RATIO_64, xoro_new, xoro_next, mix_stafford13 }

const GOLDEN_RATIO_64: u64 = 0x9e3779b97f4a7c15
const SILVER_RATIO_64: u64 = 0x6a09e667f3bcc909

struct Xoro {
    lo: u64,
    hi: u64,
}

fn rotl64(x: u64, k: u32) -> u64 {
    return (x << k) | (x >> (64 as u32 - k))
}

fn xoro_new(lo: u64, hi: u64) -> Xoro {
    if (lo | hi) == 0 as u64 {
        return Xoro { lo: GOLDEN_RATIO_64, hi: SILVER_RATIO_64 }
    }
    return Xoro { lo: lo, hi: hi }
}

fn xoro_next(g: *mut Xoro) -> u64 {
    let l: u64 = (*g).lo
    let h0: u64 = (*g).hi
    let r: u64 = rotl64(l +% h0, 17 as u32) +% l
    let h: u64 = h0 ^ l
    (*g).lo = rotl64(l, 49 as u32) ^ h ^ (h << 21)
    (*g).hi = rotl64(h, 28 as u32)
    return r
}

fn mix_stafford13(v: u64) -> u64 {
    var z: u64 = v
    z = (z ^ (z >> 30)) *% 0xbf58476d1ce4e5b9
    z = (z ^ (z >> 27)) *% 0x94d049bb133111eb
    return z ^ (z >> 31)
}
