// SPDX-License-Identifier: MPL-2.0
// lib/noise/improved.fi -- Perlin's improved noise with a random origin offset and the y-smear parameters.
// The permutation and offsets are supplied by the caller (identity table, then swaps).
import noise.jnum
import noise.interp
import noise.gradient

export { Improved, improved_new, improved_swap, improved_noise, improved_noise_smear, improved_noise_deriv }

struct Improved {
    p: [u8; 256],
    xo: f64,
    yo: f64,
    zo: f64,
}

fn improved_new(xo: f64, yo: f64, zo: f64) -> Improved {
    var n: Improved = Improved { p: [0; 256], xo: xo, yo: yo, zo: zo }
    var i: usize = 0
    while i < 256 {
        n.p[i] = i as u8
        i = i + 1
    }
    return n
}

fn improved_swap(n: *mut Improved, i: i32, j: i32) {
    let t: u8 = (*n).p[i as usize]
    (*n).p[i as usize] = (*n).p[j as usize]
    (*n).p[j as usize] = t
}

fn perm(n: *Improved, i: i32) -> i32 {
    return (*n).p[(i & 255) as usize] as i32
}

#[allow_fp]
fn sample_lerp(n: *Improved, gx: i32, gy: i32, gz: i32, dx: f64, dy: f64, dz: f64, dy_orig: f64) -> f64 {
    let i: i32 = perm(n, gx)
    let j: i32 = perm(n, gx +% 1)
    let k: i32 = perm(n, i +% gy)
    let l: i32 = perm(n, i +% gy +% 1)
    let i1: i32 = perm(n, j +% gy)
    let j1: i32 = perm(n, j +% gy +% 1)
    let d0: f64 = gradient.grad_dot(perm(n, k +% gz), dx, dy, dz)
    let d1: f64 = gradient.grad_dot(perm(n, i1 +% gz), dx - 1.0, dy, dz)
    let d2: f64 = gradient.grad_dot(perm(n, l +% gz), dx, dy - 1.0, dz)
    let d3: f64 = gradient.grad_dot(perm(n, j1 +% gz), dx - 1.0, dy - 1.0, dz)
    let d4: f64 = gradient.grad_dot(perm(n, k +% gz +% 1), dx, dy, dz - 1.0)
    let d5: f64 = gradient.grad_dot(perm(n, i1 +% gz +% 1), dx - 1.0, dy, dz - 1.0)
    let d6: f64 = gradient.grad_dot(perm(n, l +% gz +% 1), dx, dy - 1.0, dz - 1.0)
    let d7: f64 = gradient.grad_dot(perm(n, j1 +% gz +% 1), dx - 1.0, dy - 1.0, dz - 1.0)
    return interp.lerp3(interp.smoothstep(dx), interp.smoothstep(dy_orig), interp.smoothstep(dz), d0, d1, d2, d3, d4, d5, d6, d7)
}

#[allow_fp]
fn improved_noise_smear(n: *Improved, x: f64, y: f64, z: f64, y_scale: f64, y_max: f64) -> f64 {
    let d0: f64 = x + (*n).xo
    let d1: f64 = y + (*n).yo
    let d2: f64 = z + (*n).zo
    let i: i32 = jnum.floor_i32(d0)
    let j: i32 = jnum.floor_i32(d1)
    let k: i32 = jnum.floor_i32(d2)
    let d3: f64 = d0 - (i as f64)
    let d4: f64 = d1 - (j as f64)
    let d5: f64 = d2 - (k as f64)
    var d6: f64 = 0.0
    if y_scale != 0.0 {
        var d7: f64 = d4
        if y_max >= 0.0 && y_max < d4 {
            d7 = y_max
        }
        d6 = (jnum.floor_i32(d7 / y_scale + 0.00000010000000116860974) as f64) * y_scale
    }
    return sample_lerp(n, i, j, k, d3, d4 - d6, d5, d4)
}

#[allow_fp]
fn improved_noise(n: *Improved, x: f64, y: f64, z: f64) -> f64 {
    return improved_noise_smear(n, x, y, z, 0.0, 0.0)
}

#[allow_fp]
fn improved_noise_deriv(n: *Improved, x: f64, y: f64, z: f64, out: *mut [f64; 3]) -> f64 {
    let d0: f64 = x + (*n).xo
    let d1: f64 = y + (*n).yo
    let d2: f64 = z + (*n).zo
    let gx: i32 = jnum.floor_i32(d0)
    let gy: i32 = jnum.floor_i32(d1)
    let gz: i32 = jnum.floor_i32(d2)
    let dx: f64 = d0 - (gx as f64)
    let dy: f64 = d1 - (gy as f64)
    let dz: f64 = d2 - (gz as f64)
    let i: i32 = perm(n, gx)
    let j: i32 = perm(n, gx +% 1)
    let k: i32 = perm(n, i +% gy)
    let l: i32 = perm(n, i +% gy +% 1)
    let i1: i32 = perm(n, j +% gy)
    let j1: i32 = perm(n, j +% gy +% 1)
    let h1: i32 = perm(n, k +% gz)
    let h2: i32 = perm(n, i1 +% gz)
    let h3: i32 = perm(n, l +% gz)
    let h4: i32 = perm(n, j1 +% gz)
    let h5: i32 = perm(n, k +% gz +% 1)
    let h6: i32 = perm(n, i1 +% gz +% 1)
    let h7: i32 = perm(n, l +% gz +% 1)
    let h8: i32 = perm(n, j1 +% gz +% 1)
    let d00: f64 = gradient.grad_dot(h1, dx, dy, dz)
    let d01: f64 = gradient.grad_dot(h2, dx - 1.0, dy, dz)
    let d02: f64 = gradient.grad_dot(h3, dx, dy - 1.0, dz)
    let d03: f64 = gradient.grad_dot(h4, dx - 1.0, dy - 1.0, dz)
    let d04: f64 = gradient.grad_dot(h5, dx, dy, dz - 1.0)
    let d05: f64 = gradient.grad_dot(h6, dx - 1.0, dy, dz - 1.0)
    let d06: f64 = gradient.grad_dot(h7, dx, dy - 1.0, dz - 1.0)
    let d07: f64 = gradient.grad_dot(h8, dx - 1.0, dy - 1.0, dz - 1.0)
    let sx: f64 = interp.smoothstep(dx)
    let sy: f64 = interp.smoothstep(dy)
    let sz: f64 = interp.smoothstep(dz)
    let g0: f64 = interp.lerp3(sx, sy, sz, gradient.grad_comp(0, h1) as f64, gradient.grad_comp(0, h2) as f64, gradient.grad_comp(0, h3) as f64, gradient.grad_comp(0, h4) as f64, gradient.grad_comp(0, h5) as f64, gradient.grad_comp(0, h6) as f64, gradient.grad_comp(0, h7) as f64, gradient.grad_comp(0, h8) as f64)
    let g1: f64 = interp.lerp3(sx, sy, sz, gradient.grad_comp(1, h1) as f64, gradient.grad_comp(1, h2) as f64, gradient.grad_comp(1, h3) as f64, gradient.grad_comp(1, h4) as f64, gradient.grad_comp(1, h5) as f64, gradient.grad_comp(1, h6) as f64, gradient.grad_comp(1, h7) as f64, gradient.grad_comp(1, h8) as f64)
    let g2: f64 = interp.lerp3(sx, sy, sz, gradient.grad_comp(2, h1) as f64, gradient.grad_comp(2, h2) as f64, gradient.grad_comp(2, h3) as f64, gradient.grad_comp(2, h4) as f64, gradient.grad_comp(2, h5) as f64, gradient.grad_comp(2, h6) as f64, gradient.grad_comp(2, h7) as f64, gradient.grad_comp(2, h8) as f64)
    let c0: f64 = interp.lerp2(sy, sz, d01 - d00, d03 - d02, d05 - d04, d07 - d06)
    let c1: f64 = interp.lerp2(sz, sx, d02 - d00, d06 - d04, d03 - d01, d07 - d05)
    let c2: f64 = interp.lerp2(sx, sy, d04 - d00, d05 - d01, d06 - d02, d07 - d03)
    (*out)[0] = (*out)[0] + (g0 + interp.smoothstep_derivative(dx) * c0)
    (*out)[1] = (*out)[1] + (g1 + interp.smoothstep_derivative(dy) * c1)
    (*out)[2] = (*out)[2] + (g2 + interp.smoothstep_derivative(dz) * c2)
    return interp.lerp3(sx, sy, sz, d00, d01, d02, d03, d04, d05, d06, d07)
}
