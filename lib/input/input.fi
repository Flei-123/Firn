// SPDX-License-Identifier: MPL-2.0
// lib/input/input.fi -- move the mouse, click, scroll, press keys and the
// media keys of THIS machine. One interface; the backend underneath is
// Linux /dev/uinput (lib/input/uinput.fi) or Windows SendInput
// (lib/input/sendinput.fi), chosen at build time (see lib/input/backend.fi).
//
//     import input.input
//     input.mouse_move(12, -4)
//     input.click()
//     input.scroll(-1)
//     input.key_tap(input.KEY_ENTER)
//     input.volume_up()
//     if !input.ready() { io.eprint_line(input.error_text()) }
//
// THE KEY CODES are Linux's (linux/input-event-codes.h) on every system:
// one vocabulary for the caller; the Windows backend translates them to
// virtual-key codes.
//
// HONEST
// I1 `type_text` maps ASCII to keys of a US layout. On a German (QWERTZ)
//    layout "y" and "z" and most punctuation come out as other characters;
//    use `key_tap` with codes when the layout matters.
// I2 Relative motion goes through the system's pointer acceleration, like
//    a real mouse; the pixels moved are not exactly dx/dy.
import input.backend

export {
    ready, error_text, backend_name, close,
    mouse_move, mouse_button, click, right_click, middle_click, scroll, scroll_h,
    key, key_tap, key_combo, type_text,
    volume_up, volume_down, mute, play_pause, next_track, prev_track,
    BTN_LEFT, BTN_RIGHT, BTN_MIDDLE,
    KEY_ESC, KEY_BACKSPACE, KEY_TAB, KEY_ENTER, KEY_LEFTCTRL, KEY_LEFTSHIFT,
    KEY_LEFTALT, KEY_LEFTMETA, KEY_SPACE, KEY_UP, KEY_DOWN, KEY_LEFT, KEY_RIGHT,
    KEY_HOME, KEY_END, KEY_PAGEUP, KEY_PAGEDOWN, KEY_DELETE, KEY_F5, KEY_F11,
    KEY_MUTE, KEY_VOLUMEDOWN, KEY_VOLUMEUP, KEY_NEXTSONG, KEY_PLAYPAUSE,
    KEY_PREVIOUSSONG, KEY_A, KEY_C, KEY_V, KEY_Z,
}

const BTN_LEFT: u32 = 272
const BTN_RIGHT: u32 = 273
const BTN_MIDDLE: u32 = 274

const KEY_ESC: u32 = 1
const KEY_BACKSPACE: u32 = 14
const KEY_TAB: u32 = 15
const KEY_ENTER: u32 = 28
const KEY_LEFTCTRL: u32 = 29
const KEY_LEFTSHIFT: u32 = 42
const KEY_LEFTALT: u32 = 56
const KEY_SPACE: u32 = 57
const KEY_F5: u32 = 63
const KEY_F11: u32 = 87
const KEY_HOME: u32 = 102
const KEY_UP: u32 = 103
const KEY_PAGEUP: u32 = 104
const KEY_LEFT: u32 = 105
const KEY_RIGHT: u32 = 106
const KEY_END: u32 = 107
const KEY_DOWN: u32 = 108
const KEY_PAGEDOWN: u32 = 109
const KEY_DELETE: u32 = 111
const KEY_MUTE: u32 = 113
const KEY_VOLUMEDOWN: u32 = 114
const KEY_VOLUMEUP: u32 = 115
const KEY_LEFTMETA: u32 = 125
const KEY_NEXTSONG: u32 = 163
const KEY_PLAYPAUSE: u32 = 164
const KEY_PREVIOUSSONG: u32 = 165
const KEY_A: u32 = 30
const KEY_C: u32 = 46
const KEY_V: u32 = 47
const KEY_Z: u32 = 44

// Can input be produced? (Opens the backend on first use.)
fn ready() -> bool { return backend.be_open() }

// Why not, in words -- "" when it works.
fn error_text() -> str { return backend.be_error() }

fn backend_name() -> str { return backend.be_name() }

fn close() { backend.be_close() }

fn mouse_move(dx: i32, dy: i32) -> bool { return backend.be_rel(dx, dy, 0, 0) }

fn mouse_button(b: u32, down: bool) -> bool { return backend.be_button(b, down) }

fn click() -> bool {
    return backend.be_button(BTN_LEFT, true) && backend.be_button(BTN_LEFT, false)
}

fn right_click() -> bool {
    return backend.be_button(BTN_RIGHT, true) && backend.be_button(BTN_RIGHT, false)
}

fn middle_click() -> bool {
    return backend.be_button(BTN_MIDDLE, true) && backend.be_button(BTN_MIDDLE, false)
}

// One notch per unit; positive = away from the user (up).
fn scroll(notches: i32) -> bool { return backend.be_rel(0, 0, notches, 0) }

fn scroll_h(notches: i32) -> bool { return backend.be_rel(0, 0, 0, notches) }

fn key(code: u32, down: bool) -> bool { return backend.be_key(code, down) }

fn key_tap(code: u32) -> bool {
    return backend.be_key(code, true) && backend.be_key(code, false)
}

// modifier held while `code` is tapped: key_combo(KEY_LEFTCTRL, KEY_C)
fn key_combo(modifier: u32, code: u32) -> bool {
    let a: bool = backend.be_key(modifier, true)
    let b: bool = key_tap(code)
    let c: bool = backend.be_key(modifier, false)
    return a && b && c
}

fn volume_up() -> bool { return key_tap(KEY_VOLUMEUP) }
fn volume_down() -> bool { return key_tap(KEY_VOLUMEDOWN) }
fn mute() -> bool { return key_tap(KEY_MUTE) }
fn play_pause() -> bool { return key_tap(KEY_PLAYPAUSE) }
fn next_track() -> bool { return key_tap(KEY_NEXTSONG) }
fn prev_track() -> bool { return key_tap(KEY_PREVIOUSSONG) }

// US layout: the key of an ASCII character; bit 9 set = with Shift.
// 0 = no key for it.
fn ascii_key(c: u8) -> u32 {
    var letters: [u8; 26] = [30, 48, 46, 32, 18, 33, 34, 35, 23, 36, 37, 38, 50,
        49, 24, 25, 16, 19, 31, 20, 22, 47, 17, 45, 21, 44]
    if c >= 97 as u8 && c <= 122 as u8 { return letters[(c - 97 as u8) as usize] as u32 }
    if c >= 65 as u8 && c <= 90 as u8 { return (letters[(c - 65 as u8) as usize] as u32) | 512 }
    if c >= 49 as u8 && c <= 57 as u8 { return (c - 47 as u8) as u32 } // 1..9 -> 2..10
    if c == 48 as u8 { return 11 }
    if c == 32 as u8 { return KEY_SPACE }
    if c == 10 as u8 { return KEY_ENTER }
    if c == 9 as u8 { return KEY_TAB }
    // unshifted punctuation
    if c == 45 as u8 { return 12 } // -
    if c == 61 as u8 { return 13 } // =
    if c == 91 as u8 { return 26 } // [
    if c == 93 as u8 { return 27 } // ]
    if c == 59 as u8 { return 39 } // ;
    if c == 39 as u8 { return 40 } // '
    if c == 96 as u8 { return 41 } // `
    if c == 92 as u8 { return 43 } // backslash
    if c == 44 as u8 { return 51 } // ,
    if c == 46 as u8 { return 52 } // .
    if c == 47 as u8 { return 53 } // /
    // shifted
    if c == 33 as u8 { return 2 | 512 } // !
    if c == 64 as u8 { return 3 | 512 } // @
    if c == 35 as u8 { return 4 | 512 } // #
    if c == 36 as u8 { return 5 | 512 } // $
    if c == 37 as u8 { return 6 | 512 } // %
    if c == 94 as u8 { return 7 | 512 } // ^
    if c == 38 as u8 { return 8 | 512 } // &
    if c == 42 as u8 { return 9 | 512 } // *
    if c == 40 as u8 { return 10 | 512 } // (
    if c == 41 as u8 { return 11 | 512 } // )
    if c == 95 as u8 { return 12 | 512 } // _
    if c == 43 as u8 { return 13 | 512 } // +
    if c == 123 as u8 { return 26 | 512 } // {
    if c == 125 as u8 { return 27 | 512 } // }
    if c == 58 as u8 { return 39 | 512 } // :
    if c == 34 as u8 { return 40 | 512 } // "
    if c == 126 as u8 { return 41 | 512 } // ~
    if c == 124 as u8 { return 43 | 512 } // |
    if c == 60 as u8 { return 51 | 512 } // <
    if c == 62 as u8 { return 52 | 512 } // >
    if c == 63 as u8 { return 53 | 512 } // ?
    return 0
}

// Types ASCII text (see I1). Characters without a key are skipped; the
// result says whether every character had one.
fn type_text(s: str) -> bool {
    var all: bool = true
    var i: usize = 0
    while i < s.n {
        let k: u32 = ascii_key(*(s.p + i))
        if k == 0 {
            all = false
        } else if (k & 512) != 0 {
            key_combo(KEY_LEFTSHIFT, k & 511)
        } else {
            key_tap(k)
        }
        i = i + 1
    }
    return all
}
