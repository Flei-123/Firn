// SPDX-License-Identifier: MPL-2.0
// lib/input/rawdev.fi -- input.rawdev: the keyboard and the mouse straight from /dev/input/event* (Linux), no window.
//
//     var rd: rawdev.RawDev = rawdev.rawdev_new()
//     rawdev.rawdev_open(&rd)                       // opens every keyboard and mouse node it may read
//     loop { raw.raw_begin(&r); rawdev.rawdev_pump(&rd, &r); raw.raw_end(&r); ... }
//
// The events go through raw.raw_feed_ev into the SAME state machine as the window events (input.raw), so key_down /
// key_pressed / mouse_dx work the same. No focus is needed: you see every key pressed anywhere -- which is why the
// kernel wants group `input` (or root) for the nodes; `rawdev_denied` counts nodes that said no. Hot-plug: inotify on
// /dev/input, rescan when something appears. Read only: nothing is grabbed (EVIOCGRAB is not used) and nothing is sent.
// The Windows twin (rawdev.windows.fi) is an honest stub: there the window layer's raw_input does this job.
// NOT proven on real devices (the build machine has no /dev/input): tests/2797 feeds the read path through a pipe.
import std.rt
import input.evdev
import input.raw

export { RawDev, rawdev_new, rawdev_open, rawdev_close, rawdev_pump, rawdev_attach, rawdev_count, rawdev_denied, rawdev_classify, rawdev_name }

const MAXDEV: usize = 16

struct RawDev {
    fd: [i64; 16],
    node: [u32; 16],
    n: usize,
    ino: i64,
    settle: i64,
    denied: u64,
}

fn rawdev_name() -> str { return "evdev" }

fn rawdev_new() -> RawDev {
    return RawDev { fd: [0 - 1; 16], node: [0 as u32; 16], n: 0, ino: 0 - 1, settle: 0, denied: 0 as u64 }
}

fn rawdev_count(d: *mut RawDev) -> usize { return (*d).n }
fn rawdev_denied(d: *mut RawDev) -> u64 { return (*d).denied }

// 1 = keyboard (KEY_A + KEY_SPACE + KEY_ENTER), 2 = mouse (REL_X + REL_Y + BTN_LEFT), 0 = neither (pads are left to input.pad)
fn rawdev_classify(fd: i64) -> u32 {
    var types: [u8; 8] = [0 as u8; 8]
    if !evdev.ev_bits(fd, 0 as u32, (&types[0]) as u64, 8) {
        return 0 as u32
    }
    let tp: u64 = (&types[0]) as u64
    if !evdev.bit_test(tp, evdev.EV_KEY) {
        return 0 as u32
    }
    var keys: [u8; 96] = [0 as u8; 96]
    if !evdev.ev_bits(fd, evdev.EV_KEY, (&keys[0]) as u64, 96) {
        return 0 as u32
    }
    let kp: u64 = (&keys[0]) as u64
    if evdev.bit_test(kp, 30 as u32) && evdev.bit_test(kp, 57 as u32) && evdev.bit_test(kp, 28 as u32) {
        return 1 as u32
    }
    if evdev.bit_test(tp, evdev.EV_REL) && evdev.bit_test(kp, evdev.BTN_LEFT) {
        var rel: [u8; 2] = [0 as u8; 2]
        if evdev.ev_bits(fd, evdev.EV_REL, (&rel[0]) as u64, 2) && evdev.bit_test((&rel[0]) as u64, 0 as u32) && evdev.bit_test((&rel[0]) as u64, 1 as u32) {
            return 2 as u32
        }
    }
    return 0 as u32
}

fn has_node(d: *mut RawDev, node: u32) -> bool {
    var i: usize = 0
    while i < (*d).n {
        if (*d).node[i] == node { return true }
        i = i + 1
    }
    return false
}

// take an already open descriptor (a pipe in the tests) as a source; false when the table is full
fn rawdev_attach(d: *mut RawDev, fd: i64, node: u32) -> bool {
    if (*d).n >= MAXDEV {
        return false
    }
    (*d).fd[(*d).n] = fd
    (*d).node[(*d).n] = node
    (*d).n = (*d).n + 1
    return true
}

fn scan(d: *mut RawDev) {
    var nodes: [u32; 64] = [0 as u32; 64]
    var pre: [u8; 6] = "event\0"
    let n: usize = evdev.ev_list((&pre[0]) as u64, 5, (&nodes[0]) as u64, 64)
    var i: usize = 0
    while i < n {
        if !has_node(d, nodes[i]) {
            let fd: i64 = evdev.ev_open(nodes[i])
            if fd < 0 {
                if fd == 0 - 13 { (*d).denied = (*d).denied + 1 as u64 }
            } else if rawdev_classify(fd) != 0 as u32 && rawdev_attach(d, fd, nodes[i]) {
                // kept
            } else {
                evdev.ev_close(fd)
            }
        }
        i = i + 1
    }
}

// opens inotify and scans; true when at least one source is open
fn rawdev_open(d: *mut RawDev) -> bool {
    (*d).ino = evdev.inotify_open()
    if (*d).ino >= 0 && !evdev.inotify_watch((*d).ino) {
        evdev.ev_close((*d).ino)
        (*d).ino = 0 - 1
    }
    scan(d)
    return (*d).n > 0
}

fn rawdev_close(d: *mut RawDev) {
    var i: usize = 0
    while i < (*d).n {
        evdev.ev_close((*d).fd[i])
        i = i + 1
    }
    (*d).n = 0
    if (*d).ino >= 0 {
        evdev.ev_close((*d).ino)
        (*d).ino = 0 - 1
    }
}

fn drop_at(d: *mut RawDev, i: usize) {
    evdev.ev_close((*d).fd[i])
    var k: usize = i
    while k + 1 < (*d).n {
        (*d).fd[k] = (*d).fd[k + 1]
        (*d).node[k] = (*d).node[k + 1]
        k = k + 1
    }
    (*d).n = (*d).n - 1
}

// read everything pending from every source into the state machine (call between raw_begin and raw_end)
fn rawdev_pump(d: *mut RawDev, r: *mut raw.Raw) {
    if (*d).ino >= 0 && evdev.inotify_drain((*d).ino) {
        (*d).settle = 20
        scan(d)
    }
    if (*d).settle > 0 {
        (*d).settle = (*d).settle - 1
        if (*d).settle == 0 { scan(d) }
    }
    let buf: u64 = rt.heap_alloc(4096)
    var i: usize = 0
    while i < (*d).n {
        var gone: bool = false
        var rounds: usize = 0
        var running: bool = true
        while running && rounds < 16 {
            let n: i64 = evdev.ev_read((*d).fd[i], buf, 4080)
            if n == evdev.ERR_AGAIN {
                running = false
            } else if n <= 0 {
                gone = true
                running = false
            } else {
                var o: usize = 0
                while o + 24 <= n as usize {
                    let q: u64 = buf + o as u64
                    let us: u32 = ((rt.ld64(q, 0) % 4294 as u64) * 1000000 as u64 + rt.ld64(q, 1)) as u32
                    raw.raw_feed_ev(r, rt.ld16(q, 8) as u32, rt.ld16(q, 9) as u32, evcast(rt.ld32(q, 5)), us)
                    o = o + 24
                }
            }
            rounds = rounds + 1
        }
        if gone {
            drop_at(d, i)
        } else {
            i = i + 1
        }
    }
    rt.heap_free(buf, 4096)
}

fn evcast(v: u32) -> i32 {
    let w: i64 = v as i64
    if w >= 2147483648 {
        return (w - 4294967296) as i32
    }
    return w as i32
}
