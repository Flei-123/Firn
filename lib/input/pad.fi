// lib/input/pad.fi -- input.pad: GAMEPADS, the front door.
//
//     import input.pad
//     import input.padcore
//     import input.padset
//
//     var set: padset.PadSet = pad.pad_new()
//     pad.pad_open(&set)                     // inotify + first scan (Windows: loads XInput)
//     while running {
//         pad.pad_poll(&set)                 // hot-plug + read every device, non blocking
//         var i: usize = 0
//         while i < padset.MAXPADS {
//             if padset.padset_active(&set, i) {
//                 let p: *mut padcore.Pad = padset.padset_pad(&set, i)
//                 if padcore.pad_pressed(p, padcore.PB_A) { jump() }
//                 move(padcore.pad_axis(p, padcore.PA_LX), padcore.pad_axis(p, padcore.PA_LY))
//             }
//             i = i + 1
//         }
//         pad.pad_frame(&set)                // clears pressed / released for the next frame
//     }
//     pad.pad_close(&set)
//
// RUMBLE (r434): a slot that can vibrate says so, then
//     if pad.pad_rumble_supported(&set, i) { pad.pad_rumble(&set, i, 1.0, 0.3, 400) }   // big motor, small motor, ms
//     pad.pad_rumble_stop(&set, i)               // also stopped when the pad is closed / unplugged
//     pad.pad_rumble_gain(&set, i, 0.5)          // master gain 0..1 of the pad
// Linux: evdev force feedback (FF_RUMBLE; the node must open read+write, needs the `input` group / a uaccess rule). Windows: XInputSetState.
// joydev (and a pad evdev opened read only, or without FF_RUMBLE) answers false: no rumble, say so. Duration: ms 0 = the longest (65.5 s).
//
// Layers: padcore (pure: evdev / joydev / XInput -> the logical SDL gamepad, mappings, deadzones, event ring),
// padset (slots + the SDL GameControllerDB), padsys (Linux evdev + joydev + inotify; the Windows twin is XInput).
// pad_db_load adds a gamecontrollerdb.txt; without a line for a device the kernel's gamepad codes are used.
// See docs/INPUT.md for what is proven (fake byte streams through a pipe) and what is not (real pads).
import input.padcore
import input.padset
import input.padsys
import input.padff

export {
    pad_new, pad_open, pad_poll, pad_frame, pad_close, pad_backend, pad_db_load, pad_db_text,
    pad_rumble_supported, pad_rumble, pad_rumble_stop, pad_rumble_gain,
}

fn pad_new() -> padset.PadSet { return padset.padset_new() }
fn pad_open(s: *mut padset.PadSet) -> bool { return padsys.sys_open(s) }
fn pad_poll(s: *mut padset.PadSet) { padsys.sys_poll(s) }
fn pad_frame(s: *mut padset.PadSet) { padset.padset_begin(s) }
fn pad_close(s: *mut padset.PadSet) { padsys.sys_close(s) }
fn pad_backend() -> str { return padsys.sys_name() }
// add a gamecontrollerdb.txt (path 0-terminated); applies to pads found AFTER the call (call it before pad_open)
fn pad_db_load(s: *mut padset.PadSet, path: u64) -> bool { return padset.padset_db_load(s, path) }
fn pad_db_text(s: *mut padset.PadSet, text: u64, n: usize) { padset.padset_db_add(s, text, n) }

// can this slot rumble? (false for joydev, a read-only node, a pad without FF_RUMBLE, an empty slot)
fn pad_rumble_supported(s: *mut padset.PadSet, i: usize) -> bool { return padsys.sys_rumble_supported(s, i) }
// strong = the big (low frequency) motor, weak = the small one, 0.0 .. 1.0 each; both 0 = stop. true = sent to the device.
fn pad_rumble(s: *mut padset.PadSet, i: usize, strong: f64, weak: f64, ms: u32) -> bool {
    return padsys.sys_rumble(s, i, padff.ff_scale(strong), padff.ff_scale(weak), ms)
}
fn pad_rumble_stop(s: *mut padset.PadSet, i: usize) -> bool { return padsys.sys_rumble_stop(s, i) }
fn pad_rumble_gain(s: *mut padset.PadSet, i: usize, gain: f64) -> bool { return padsys.sys_rumble_gain(s, i, padff.ff_scale(gain)) }
