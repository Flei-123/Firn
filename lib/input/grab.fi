// SPDX-License-Identifier: MPL-2.0
// lib/input/grab.fi -- the relative mouse grab of a first-person camera, one place for it.
//
//     grab.grab_start(&w)            // invisible cursor, pointer kept in the window, deltas from the raw motion
//     ... raw.raw_pump(&r, &w) each frame -> raw.mouse_dx / mouse_dy
//     grab.grab_stop(&w)             // e.g. on Escape or focus loss
//
// X11: pointer grab + XInput2 RawMotion (unaccelerated), fallback warp-to-centre with the warp-echo fix.
// Windows: ClipCursor + RegisterRawInputDevices / WM_INPUT, fallback the position against the middle.
// Cursor shape / visibility: window.cursor_shape, CURSOR_HIDDEN. See docs/INPUT.md for what was proven.
import window.window

export { grab_start, grab_stop, grab_raw, grab_prefer_warp, hide_cursor, show_cursor }

fn grab_start(w: *mut window.Window) -> bool { return window.cursor_mode(w, window.CURSOR_CAPTURED) }
fn grab_stop(w: *mut window.Window) { window.cursor_mode(w, window.CURSOR_NORMAL) }
// is the grab read through the system's raw motion (true) or the warp fallback (false)?
fn grab_raw(w: *mut window.Window) -> bool { return window.cursor_is_raw(w) }
// force the warp-to-centre fallback (or allow raw again) for the NEXT grab_start
fn grab_prefer_warp(w: *mut window.Window, on: bool) { window.cursor_raw(w, !on) }
fn hide_cursor(w: *mut window.Window) -> bool { return window.cursor_mode(w, window.CURSOR_HIDDEN) }
fn show_cursor(w: *mut window.Window) -> bool { return window.cursor_mode(w, window.CURSOR_NORMAL) }
