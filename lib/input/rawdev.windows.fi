// lib/input/rawdev.windows.fi -- input.rawdev on WINDOWS: an honest stub. There is no /dev/input; reading keys and
// mouse motion is window.raw_input (WM_KEYUP + RegisterRawInputDevices / WM_INPUT in lib/window). rawdev_open
// returns false, nothing is ever pumped. Same surface as lib/input/rawdev.fi.
import std.rt
import input.raw

export { RawDev, rawdev_new, rawdev_open, rawdev_close, rawdev_pump, rawdev_attach, rawdev_count, rawdev_denied, rawdev_name }

struct RawDev {
    n: usize,
}

fn rawdev_name() -> str { return "none (Windows: use window.raw_input)" }
fn rawdev_new() -> RawDev { return RawDev { n: 0 } }
fn rawdev_open(d: *mut RawDev) -> bool { return false }
fn rawdev_close(d: *mut RawDev) { }
fn rawdev_pump(d: *mut RawDev, r: *mut raw.Raw) { }
fn rawdev_attach(d: *mut RawDev, fd: i64, node: u32) -> bool { return false }
fn rawdev_count(d: *mut RawDev) -> usize { return 0 }
fn rawdev_denied(d: *mut RawDev) -> u64 { return 0 as u64 }
