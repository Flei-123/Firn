// lib/input/backend.windows.fi -- the input backend a Windows build gets.
//
// The compiler takes this file instead of lib/input/backend.fi when it
// builds for x86_64-windows (compiler/src/modules.rs, `module_path`): the
// same six functions, over SendInput from user32.dll.
import input.sendinput

export { be_open, be_close, be_error, be_rel, be_button, be_key, be_name }

fn be_name() -> str { return "SendInput" }
fn be_open() -> bool { return sendinput.open() }
fn be_close() { sendinput.close() }
fn be_error() -> str { return sendinput.error_text() }
fn be_rel(dx: i32, dy: i32, wheel: i32, hwheel: i32) -> bool {
    return sendinput.rel(dx, dy, wheel, hwheel)
}
fn be_button(code: u32, down: bool) -> bool { return sendinput.button(code, down) }
fn be_key(code: u32, down: bool) -> bool { return sendinput.key(code, down) }
