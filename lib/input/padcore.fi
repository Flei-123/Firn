// SPDX-License-Identifier: MPL-2.0
// lib/input/padcore.fi -- input.padcore: the DEVICE INDEPENDENT part of the gamepad support.
//
// Everything here is pure: bytes / numbers in, state out. No syscall, no library. That is what the tests drive
// (tests/2794: fake evdev / joydev byte streams through a pipe, random streams against a naive model).
//
//   evdev bytes (struct input_event, 24 octets) --pad_feed_evdev-->  \
//   joydev bytes (struct js_event, 8 octets)    --pad_feed_joydev--->  > Pad  -- pad_update -->  logical gamepad
//   XInput state                                --pad_feed_xinput-->  /      (16 buttons + 6 axes, edges, events)
//
// THE LOGICAL GAMEPAD is SDL's: buttons a b x y back guide start leftstick rightstick leftshoulder rightshoulder
// dpup dpdown dpleft dpright misc1 (bit PB_* in `buttons`), axes leftx lefty rightx righty (-1..1, y down is +1)
// and lefttrigger righttrigger (0..1). A MAPPING says which physical button / axis / hat feeds which logical slot.
// Two sources of mappings:
//   * pad_apply_sdl: one line of the SDL GameControllerDB ("guid,name,a:b0,leftx:a0,dpup:h0.1,lefttrigger:+a2,...").
//     Indices are SDL's EVDEV order: buttons = key codes from BTN_JOYSTICK (0x120) up to KEY_MAX, then 0..0x11f;
//     axes = ABS_* codes ascending WITHOUT the hat axes (0x10..0x17); hats = ABS_HATnX/Y pairs.
//   * pad_apply_default: the Linux kernel's own gamepad codes (BTN_SOUTH ... ABS_RX), what xpad and hid-playstation
//     report. A device without a database entry still works that way.
// DEADZONE: radial for the two sticks (the pair is one vector), a plain threshold for the triggers.
// NOT proven against real hardware: the layouts of real pads (only the kernel's documented codes are used).
import std.rt

export {
    s32, s16, u32_of_i32, Pad, pad_new, pad_reset, pad_set_identity, pad_set_name, pad_add_key, pad_finish_keys, pad_set_abs,
    pad_apply_default, pad_apply_sdl, pad_clear_map, pad_set_deadzone, pad_begin, pad_update,
    pad_feed_evdev, pad_feed_evdev_one, pad_feed_joydev, pad_feed_xinput, pad_js_maps,
    pad_down, pad_pressed, pad_released, pad_axis, pad_hat, pad_raw_axis, pad_key_down, pad_has_key, pad_has_abs,
    pad_event_next, pad_event_push, pad_event_force, pad_sdl_guid, pad_key_index, pad_abs_index, pad_norm, pad_mapped,
    PB_A, PB_B, PB_X, PB_Y, PB_BACK, PB_GUIDE, PB_START, PB_LSTICK, PB_RSTICK, PB_LSHOULDER, PB_RSHOULDER,
    PB_DUP, PB_DDOWN, PB_DLEFT, PB_DRIGHT, PB_MISC, PB_COUNT,
    PA_LX, PA_LY, PA_RX, PA_RY, PA_LT, PA_RT, PA_COUNT,
    HAT_UP, HAT_RIGHT, HAT_DOWN, HAT_LEFT,
    PE_BUTTON_DOWN, PE_BUTTON_UP, PE_AXIS, PE_CONNECTED, PE_DISCONNECTED,
    EVT_SYN, EVT_KEY, EVT_ABS, ABS_X, ABS_Y, ABS_Z, ABS_RX, ABS_RY, ABS_RZ, ABS_HAT0X, ABS_HAT0Y, ABS_HAT3Y,
    BTN_SOUTH, BTN_EAST, BTN_NORTH, BTN_WEST, BTN_TL, BTN_TR, BTN_SELECT, BTN_START, BTN_MODE, BTN_THUMBL, BTN_THUMBR,
    BTN_JOYSTICK, BTN_GAMEPAD, KEY_MAX_CODE,
}

const PB_A: usize = 0
const PB_B: usize = 1
const PB_X: usize = 2
const PB_Y: usize = 3
const PB_BACK: usize = 4
const PB_GUIDE: usize = 5
const PB_START: usize = 6
const PB_LSTICK: usize = 7
const PB_RSTICK: usize = 8
const PB_LSHOULDER: usize = 9
const PB_RSHOULDER: usize = 10
const PB_DUP: usize = 11
const PB_DDOWN: usize = 12
const PB_DLEFT: usize = 13
const PB_DRIGHT: usize = 14
const PB_MISC: usize = 15
const PB_COUNT: usize = 16
const PA_LX: usize = 0
const PA_LY: usize = 1
const PA_RX: usize = 2
const PA_RY: usize = 3
const PA_LT: usize = 4
const PA_RT: usize = 5
const PA_COUNT: usize = 6
const SLOTS: usize = 22 // 16 buttons then 6 axes

const HAT_UP: u8 = 1
const HAT_RIGHT: u8 = 2
const HAT_DOWN: u8 = 4
const HAT_LEFT: u8 = 8

// pad events
const PE_BUTTON_DOWN: u32 = 1
const PE_BUTTON_UP: u32 = 2
const PE_AXIS: u32 = 3
const PE_CONNECTED: u32 = 4
const PE_DISCONNECTED: u32 = 5

// linux/input-event-codes.h
const EVT_SYN: u32 = 0
const EVT_KEY: u32 = 1
const EVT_ABS: u32 = 3
const ABS_X: u32 = 0
const ABS_Y: u32 = 1
const ABS_Z: u32 = 2
const ABS_RX: u32 = 3
const ABS_RY: u32 = 4
const ABS_RZ: u32 = 5
const ABS_HAT0X: u32 = 16
const ABS_HAT0Y: u32 = 17
const ABS_HAT3Y: u32 = 23
const BTN_SOUTH: u32 = 304
const BTN_EAST: u32 = 305
const BTN_NORTH: u32 = 307
const BTN_WEST: u32 = 308
const BTN_TL: u32 = 310
const BTN_TR: u32 = 311
const BTN_SELECT: u32 = 314
const BTN_START: u32 = 315
const BTN_MODE: u32 = 316
const BTN_THUMBL: u32 = 317
const BTN_THUMBR: u32 = 318
const BTN_JOYSTICK: u32 = 288
const BTN_GAMEPAD: u32 = 304
const KEY_MAX_CODE: u32 = 767

// source kinds in a mapping slot
const SK_NONE: u8 = 0
const SK_KEY: u8 = 1 // a physical button, code = key code
const SK_ABS: u8 = 2 // a physical axis, code = ABS code
const SK_HAT: u8 = 3 // a hat direction, code = hat number, mask = HAT_*

const MAXKEYS: usize = 128
const EVQ: usize = 64

struct Pad {
    bus: u32,
    vendor: u32,
    product: u32,
    version: u32,
    name: [u8; 64],
    name_len: usize,
    // buttons: SDL order list, state per list index
    nkeys: usize,
    key_code: [u32; 128],
    key_down: [u8; 128],
    // axes by ABS code (0..63)
    abs_mask: u64,
    abs_min: [i32; 64],
    abs_max: [i32; 64],
    abs_flat: [i32; 64],
    abs_val: [i32; 64],
    // joydev: index -> code (JSIOCGBTNMAP / JSIOCGAXMAP)
    js_nbtn: usize,
    js_btn: [u32; 128],
    js_nax: usize,
    js_ax: [u32; 64],
    // mapping
    map_kind: [u8; 22],
    map_code: [u32; 22],
    map_mask: [u8; 22],
    map_half: [u8; 22], // 0 whole axis, 1 positive half, 2 negative half
    map_inv: [u8; 22],
    mapped: bool, // mapped by an SDL line (false: kernel default)
    direct: bool, // XInput: values arrive already logical
    // config
    dz_stick: f64,
    dz_trig: f64,
    // logical state
    buttons: u32,
    pressed: u32,
    released: u32,
    axes: [f64; 6],
    sent_axes: [f64; 6],
    // events
    ev_kind: [u8; 64],
    ev_idx: [u8; 64],
    ev_val: [f64; 64],
    ev_head: usize,
    ev_tail: usize,
    ev_lost: u64,
    // evdev SYN_DROPPED: events up to the next SYN_REPORT are garbage
    dropped: bool,
}

fn pad_new() -> Pad {
    return Pad { bus: 0, vendor: 0, product: 0, version: 0, name: [0 as u8; 64], name_len: 0,
        nkeys: 0, key_code: [0 as u32; 128], key_down: [0 as u8; 128],
        abs_mask: 0, abs_min: [0 as i32; 64], abs_max: [0 as i32; 64], abs_flat: [0 as i32; 64], abs_val: [0 as i32; 64],
        js_nbtn: 0, js_btn: [0 as u32; 128], js_nax: 0, js_ax: [0 as u32; 64],
        map_kind: [0 as u8; 22], map_code: [0 as u32; 22], map_mask: [0 as u8; 22], map_half: [0 as u8; 22], map_inv: [0 as u8; 22],
        mapped: false, direct: false, dz_stick: 0.15, dz_trig: 0.05,
        buttons: 0 as u32, pressed: 0 as u32, released: 0 as u32, axes: [0.0; 6], sent_axes: [0.0; 6],
        ev_kind: [0 as u8; 64], ev_idx: [0 as u8; 64], ev_val: [0.0; 64], ev_head: 0, ev_tail: 0, ev_lost: 0, dropped: false }
}

// forget the device (keeps the config: deadzones)
fn pad_reset(p: *mut Pad) {
    let a: f64 = (*p).dz_stick
    let b: f64 = (*p).dz_trig
    *p = pad_new()
    (*p).dz_stick = a
    (*p).dz_trig = b
}

fn pad_set_identity(p: *mut Pad, bus: u32, vendor: u32, product: u32, version: u32) {
    (*p).bus = bus
    (*p).vendor = vendor
    (*p).product = product
    (*p).version = version
}

fn pad_set_name(p: *mut Pad, s: u64, n: usize) {
    var i: usize = 0
    while i < n && i < 63 {
        (*p).name[i] = rt.ld8(s, i)
        i = i + 1
    }
    (*p).name[i] = 0 as u8
    (*p).name_len = i
}

fn pad_set_deadzone(p: *mut Pad, stick: f64, trigger: f64) {
    (*p).dz_stick = stick
    (*p).dz_trig = trigger
}

// ---- the device description -----------------------------------------------------------------------------------
// Add the key codes the device has (any order), then pad_finish_keys sorts them into SDL's order.
fn pad_add_key(p: *mut Pad, code: u32) {
    if (*p).nkeys >= MAXKEYS || code > KEY_MAX_CODE {
        return
    }
    var i: usize = 0
    while i < (*p).nkeys {
        if (*p).key_code[i] == code {
            return
        }
        i = i + 1
    }
    (*p).key_code[(*p).nkeys] = code
    (*p).key_down[(*p).nkeys] = 0 as u8
    (*p).nkeys = (*p).nkeys + 1
}

// SDL order: BTN_JOYSTICK..KEY_MAX ascending first, then 0..BTN_JOYSTICK-1 ascending (insertion sort on a rank)
fn key_rank(c: u32) -> u32 {
    if c >= BTN_JOYSTICK {
        return c - BTN_JOYSTICK
    }
    return c + 1000
}

fn pad_finish_keys(p: *mut Pad) {
    var i: usize = 1
    while i < (*p).nkeys {
        let v: u32 = (*p).key_code[i]
        var j: usize = i
        while j > 0 && key_rank((*p).key_code[j - 1]) > key_rank(v) {
            (*p).key_code[j] = (*p).key_code[j - 1]
            j = j - 1
        }
        (*p).key_code[j] = v
        i = i + 1
    }
}

fn pad_set_abs(p: *mut Pad, code: u32, min: i32, max: i32, flat: i32, val: i32) {
    if code >= 64 as u32 {
        return
    }
    let c: usize = code as usize
    (*p).abs_mask = (*p).abs_mask | ((1 as u64) << (code as u64))
    (*p).abs_min[c] = min
    (*p).abs_max[c] = max
    (*p).abs_flat[c] = flat
    (*p).abs_val[c] = val
}

fn pad_has_abs(p: *mut Pad, code: u32) -> bool {
    return code < 64 as u32 && ((*p).abs_mask >> (code as u64)) & (1 as u64) != (0 as u64)
}

// index of a key code in SDL order, or -1
fn pad_key_index(p: *mut Pad, code: u32) -> i64 {
    var i: usize = 0
    while i < (*p).nkeys {
        if (*p).key_code[i] == code {
            return i as i64
        }
        i = i + 1
    }
    return 0 - 1
}

fn pad_has_key(p: *mut Pad, code: u32) -> bool {
    return pad_key_index(p, code) >= 0
}

fn is_hat_code(c: u32) -> bool {
    return c >= ABS_HAT0X && c <= ABS_HAT3Y
}

// SDL axis index n -> ABS code (the n-th present non-hat axis ascending), or 999
fn pad_abs_index(p: *mut Pad, n: usize) -> u32 {
    var seen: usize = 0
    var c: u32 = 0
    while c < 64 as u32 {
        if pad_has_abs(p, c) && !is_hat_code(c) {
            if seen == n {
                return c
            }
            seen = seen + 1
        }
        c = c + 1 as u32
    }
    return 999 as u32
}

// ---- joydev maps -------------------------------------------------------------------------------------------------
// js_btn[i] / js_ax[i]: the key / ABS code of joydev's button / axis number i
fn pad_js_maps(p: *mut Pad, nbtn: usize, btn: u64, nax: usize, ax: u64) {
    var i: usize = 0
    (*p).js_nbtn = 0
    while i < nbtn && i < MAXKEYS {
        (*p).js_btn[i] = rt.ld16(btn, i) as u32
        (*p).js_nbtn = i + 1
        i = i + 1
    }
    i = 0
    (*p).js_nax = 0
    while i < nax && i < 64 {
        (*p).js_ax[i] = rt.ld8(ax, i) as u32
        (*p).js_nax = i + 1
        i = i + 1
    }
}

// ---- mappings --------------------------------------------------------------------------------------------------
fn pad_clear_map(p: *mut Pad) {
    var i: usize = 0
    while i < SLOTS {
        (*p).map_kind[i] = SK_NONE
        (*p).map_code[i] = 0 as u32
        (*p).map_mask[i] = 0 as u8
        (*p).map_half[i] = 0 as u8
        (*p).map_inv[i] = 0 as u8
        i = i + 1
    }
    (*p).mapped = false
}

fn map_key(p: *mut Pad, slot: usize, code: u32) {
    (*p).map_kind[slot] = SK_KEY
    (*p).map_code[slot] = code
}
fn map_abs(p: *mut Pad, slot: usize, code: u32) {
    (*p).map_kind[slot] = SK_ABS
    (*p).map_code[slot] = code
}
fn map_hat(p: *mut Pad, slot: usize, hat: u32, mask: u8) {
    (*p).map_kind[slot] = SK_HAT
    (*p).map_code[slot] = hat
    (*p).map_mask[slot] = mask
}

// the kernel's documented gamepad layout (xpad, hid-playstation, hid-nintendo ...)
fn pad_apply_default(p: *mut Pad) {
    pad_clear_map(p)
    map_key(p, PB_A, BTN_SOUTH)
    map_key(p, PB_B, BTN_EAST)
    map_key(p, PB_X, BTN_NORTH)
    map_key(p, PB_Y, BTN_WEST)
    map_key(p, PB_LSHOULDER, BTN_TL)
    map_key(p, PB_RSHOULDER, BTN_TR)
    map_key(p, PB_BACK, BTN_SELECT)
    map_key(p, PB_START, BTN_START)
    map_key(p, PB_GUIDE, BTN_MODE)
    map_key(p, PB_LSTICK, BTN_THUMBL)
    map_key(p, PB_RSTICK, BTN_THUMBR)
    map_hat(p, PB_DUP, 0 as u32, HAT_UP)
    map_hat(p, PB_DDOWN, 0 as u32, HAT_DOWN)
    map_hat(p, PB_DLEFT, 0 as u32, HAT_LEFT)
    map_hat(p, PB_DRIGHT, 0 as u32, HAT_RIGHT)
    map_abs(p, PB_COUNT + PA_LX, ABS_X)
    map_abs(p, PB_COUNT + PA_LY, ABS_Y)
    map_abs(p, PB_COUNT + PA_RX, ABS_RX)
    map_abs(p, PB_COUNT + PA_RY, ABS_RY)
    map_abs(p, PB_COUNT + PA_LT, ABS_Z)
    map_abs(p, PB_COUNT + PA_RT, ABS_RZ)
    (*p).mapped = false
}

fn is_digit(c: u8) -> bool { return c >= 48 as u8 && c <= 57 as u8 }

// does the text [s, s+n) at `at` start with the word `w` (a 0-terminated array pointer)?
fn starts(s: u64, n: usize, at: usize, w: u64) -> bool {
    var i: usize = 0
    while rt.ld8(w, i) != 0 as u8 {
        if at + i >= n || rt.ld8(s, at + i) != rt.ld8(w, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// slot of an SDL element name at s[at..end), or 99
fn slot_of(s: u64, at: usize, end: usize) -> usize {
    var names: [u8; 157] = "a\0b\0x\0y\0back\0guide\0start\0leftstick\0rightstick\0leftshoulder\0rightshoulder\0dpup\0dpdown\0dpleft\0dpright\0misc1\0leftx\0lefty\0rightx\0righty\0lefttrigger\0righttrigger\0"
    var slot: usize = 0
    var off: usize = 0
    while slot < SLOTS {
        // compare s[at..end) with the word at names[off]
        var k: usize = 0
        var same: bool = true
        while same {
            let a: u8 = names[off + k]
            let have: bool = at + k < end
            if a == 0 as u8 {
                if have {
                    same = false
                }
                break
            }
            if !have || rt.ld8(s, at + k) != a {
                same = false
            }
            k = k + 1
        }
        if same {
            return slot
        }
        while names[off] != 0 as u8 {
            off = off + 1
        }
        off = off + 1
        slot = slot + 1
    }
    return 99
}

fn parse_uint(s: u64, at: usize, end: usize, out: *mut usize) -> usize {
    var i: usize = at
    var v: usize = 0
    while i < end && is_digit(rt.ld8(s, i)) {
        v = v * 10 + (rt.ld8(s, i) - 48 as u8) as usize
        i = i + 1
    }
    *out = v
    return i
}

fn hexv(c: u8) -> i64 {
    if c >= 48 as u8 && c <= 57 as u8 { return (c - 48 as u8) as i64 }
    if c >= 97 as u8 && c <= 102 as u8 { return (c - 97 as u8) as i64 + 10 }
    if c >= 65 as u8 && c <= 70 as u8 { return (c - 65 as u8) as i64 + 10 }
    return 0 - 1
}

// SDL GUID (Linux) of the device: bus, crc (0), vendor, 0, product, 0, version, 0, 0, 0 -- little endian u16 each.
// out: 33 octets (hex + 0)
fn pad_sdl_guid(p: *mut Pad, out: u64) {
    var w: [u32; 8] = [0 as u32; 8]
    w[0] = (*p).bus
    w[1] = 0 as u32
    w[2] = (*p).vendor
    w[3] = 0 as u32
    w[4] = (*p).product
    w[5] = 0 as u32
    w[6] = (*p).version
    w[7] = 0 as u32
    var hexd: [u8; 17] = "0123456789abcdef\0"
    var i: usize = 0
    var o: usize = 0
    while i < 8 {
        let lo: u32 = w[i] & 255 as u32
        let hi: u32 = (w[i] >> 8 as u32) & 255 as u32
        rt.st8(out, o, hexd[(lo >> 4 as u32) as usize])
        rt.st8(out, o + 1, hexd[(lo & 15 as u32) as usize])
        rt.st8(out, o + 2, hexd[(hi >> 4 as u32) as usize])
        rt.st8(out, o + 3, hexd[(hi & 15 as u32) as usize])
        o = o + 4
        i = i + 1
    }
    rt.st8(out, o, 0 as u8)
}

// Apply ONE SDL GameControllerDB line. Returns false when the line is not a mapping at all
// (comment, too short, a platform other than Linux). Unknown element names are ignored like SDL does;
// an index the device does not have leaves that slot unmapped.
fn pad_apply_sdl(p: *mut Pad, s: u64, n: usize) -> bool {
    // guid (32 hex) ',' name ','
    if n < 34 {
        return false
    }
    var i: usize = 0
    while i < 32 {
        if hexv(rt.ld8(s, i)) < 0 {
            return false
        }
        i = i + 1
    }
    if rt.ld8(s, 32) != 44 as u8 {
        return false
    }
    // the platform field, when there is one, must be Linux
    var plat: [u8; 10] = "platform:\0"
    var q: usize = 33
    while q + 9 < n {
        if rt.ld8(s, q - 1) == 44 as u8 && starts(s, n, q, (&plat[0]) as u64) {
            var lx: [u8; 6] = "Linux\0"
            if !starts(s, n, q + 9, (&lx[0]) as u64) {
                return false
            }
        }
        q = q + 1
    }
    pad_clear_map(p)
    // skip the name
    var pos: usize = 33
    while pos < n && rt.ld8(s, pos) != 44 as u8 {
        pos = pos + 1
    }
    pos = pos + 1
    while pos < n {
        // element ':' source ','
        var e: usize = pos
        while e < n && rt.ld8(s, e) != 58 as u8 && rt.ld8(s, e) != 44 as u8 {
            e = e + 1
        }
        if e >= n || rt.ld8(s, e) != 58 as u8 {
            // junk without ':' -- skip to the next comma
            while pos < n && rt.ld8(s, pos) != 44 as u8 {
                pos = pos + 1
            }
            pos = pos + 1
            continue
        }
        let slot: usize = slot_of(s, pos, e)
        var v: usize = e + 1
        var vend: usize = v
        while vend < n && rt.ld8(s, vend) != 44 as u8 {
            vend = vend + 1
        }
        if slot < SLOTS {
            apply_source(p, slot, s, v, vend)
        }
        pos = vend + 1
    }
    (*p).mapped = true
    return true
}

// source: [+|-] (b<N> | a<N> | h<H>.<mask>) [~]
fn apply_source(p: *mut Pad, slot: usize, s: u64, at: usize, end: usize) {
    var i: usize = at
    var half: u8 = 0 as u8
    if i < end && rt.ld8(s, i) == 43 as u8 {
        half = 1 as u8
        i = i + 1
    } else if i < end && rt.ld8(s, i) == 45 as u8 {
        half = 2 as u8
        i = i + 1
    }
    if i >= end {
        return
    }
    let t: u8 = rt.ld8(s, i)
    var num: usize = 0
    if t == 98 as u8 { // b
        let j: usize = parse_uint(s, i + 1, end, &num)
        let code: u32 = key_code_at(p, num)
        if j > i + 1 && code != 0 as u32 {
            map_key(p, slot, code)
        }
        return
    }
    if t == 97 as u8 { // a
        let j: usize = parse_uint(s, i + 1, end, &num)
        let code: u32 = pad_abs_index(p, num)
        if j > i + 1 && code != 999 as u32 {
            map_abs(p, slot, code)
            (*p).map_half[slot] = half
            if j < end && rt.ld8(s, j) == 126 as u8 {
                (*p).map_inv[slot] = 1 as u8
            }
        }
        return
    }
    if t == 104 as u8 { // h<hat>.<mask>
        let j: usize = parse_uint(s, i + 1, end, &num)
        if j < end && rt.ld8(s, j) == 46 as u8 {
            var mask: usize = 0
            let k: usize = parse_uint(s, j + 1, end, &mask)
            if k > j + 1 && num < 4 {
                map_hat(p, slot, num as u32, mask as u8)
            }
        }
    }
}

// key code of SDL button index n; 0 when out of range
fn key_code_at(p: *mut Pad, n: usize) -> u32 {
    if n < (*p).nkeys {
        return (*p).key_code[n]
    }
    return 0 as u32
}

fn pad_mapped(p: *mut Pad) -> bool { return (*p).mapped }

// ---- the physical state ---------------------------------------------------------------------------------------
// Normalise a raw axis value to -1..1 over its reported range. A range of zero reads 0.
fn pad_norm(p: *mut Pad, code: u32) -> f64 {
    if code >= 64 as u32 {
        return 0.0
    }
    let c: usize = code as usize
    let lo: i64 = (*p).abs_min[c] as i64
    let hi: i64 = (*p).abs_max[c] as i64
    if hi <= lo {
        return 0.0
    }
    let v: i64 = (*p).abs_val[c] as i64
    var r: f64 = (2.0 * ((v - lo) as f64)) / ((hi - lo) as f64) - 1.0
    if r > 1.0 { r = 1.0 }
    if r < 0.0 - 1.0 { r = 0.0 - 1.0 }
    return r
}

fn pad_raw_axis(p: *mut Pad, code: u32) -> i32 {
    if code >= 64 as u32 { return 0 as i32 }
    return (*p).abs_val[code as usize]
}

fn pad_key_down(p: *mut Pad, code: u32) -> bool {
    let i: i64 = pad_key_index(p, code)
    return i >= 0 && (*p).key_down[i as usize] != 0 as u8
}

// the hat n as a mask of HAT_*
fn pad_hat(p: *mut Pad, n: u32) -> u8 {
    if n > 3 as u32 {
        return 0 as u8
    }
    var m: u8 = 0 as u8
    let cx: u32 = ABS_HAT0X + n * 2 as u32
    let cy: u32 = cx + 1 as u32
    if pad_has_abs(p, cx) {
        let x: i32 = (*p).abs_val[cx as usize]
        if x < 0 as i32 { m = m | HAT_LEFT }
        if x > 0 as i32 { m = m | HAT_RIGHT }
    }
    if pad_has_abs(p, cy) {
        let y: i32 = (*p).abs_val[cy as usize]
        if y < 0 as i32 { m = m | HAT_UP }
        if y > 0 as i32 { m = m | HAT_DOWN }
    }
    return m
}

// a mapped analog source as a value in -1..1 (inversion and half ranges applied); `trigger`: 0..1
fn src_value(p: *mut Pad, slot: usize, trigger: bool) -> f64 {
    let k: u8 = (*p).map_kind[slot]
    if k == SK_NONE {
        return 0.0
    }
    if k == SK_KEY {
        if pad_key_down(p, (*p).map_code[slot]) { return 1.0 }
        return 0.0
    }
    if k == SK_HAT {
        if (pad_hat(p, (*p).map_code[slot]) & (*p).map_mask[slot]) != 0 as u8 { return 1.0 }
        return 0.0
    }
    let code: u32 = (*p).map_code[slot]
    var v: f64 = pad_norm(p, code)
    if (*p).map_inv[slot] != 0 as u8 {
        v = 0.0 - v
    }
    let h: u8 = (*p).map_half[slot]
    if h == 1 as u8 {
        if v < 0.0 { v = 0.0 }
        return v
    }
    if h == 2 as u8 {
        v = 0.0 - v
        if v < 0.0 { v = 0.0 }
        return v
    }
    if trigger {
        return (v + 1.0) * 0.5
    }
    return v
}

fn src_button(p: *mut Pad, slot: usize) -> bool {
    let k: u8 = (*p).map_kind[slot]
    if k == SK_KEY { return pad_key_down(p, (*p).map_code[slot]) }
    if k == SK_HAT { return (pad_hat(p, (*p).map_code[slot]) & (*p).map_mask[slot]) != 0 as u8 }
    if k == SK_ABS {
        let v: f64 = src_value(p, slot, false)
        // a whole-range axis used as a button: pressed past half travel on the positive side
        if (*p).map_half[slot] == 0 as u8 { return v > 0.5 }
        return v > 0.5
    }
    return false
}

fn clamp1(v: f64) -> f64 {
    if v > 1.0 { return 1.0 }
    if v < 0.0 - 1.0 { return 0.0 - 1.0 }
    return v
}

// radial deadzone of a stick vector
fn radial(x: f64, y: f64, dz: f64, out: *mut [f64; 2]) {
    let m: f64 = __sqrt(x * x + y * y)
    if m <= dz || m == 0.0 {
        (*out)[0] = 0.0
        (*out)[1] = 0.0
        return
    }
    var scale: f64 = (m - dz) / (1.0 - dz) / m
    if m > 1.0 {
        scale = (1.0 - dz) / (1.0 - dz) / m
    }
    (*out)[0] = x * scale
    (*out)[1] = y * scale
}

// ---- the event ring ---------------------------------------------------------------------------------------------
fn pad_event_push(p: *mut Pad, kind: u32, idx: u32, val: f64) {
    let next: usize = ((*p).ev_head + 1) % EVQ
    if next == (*p).ev_tail {
        (*p).ev_lost = (*p).ev_lost + 1 as u64 // full: the newest is dropped, counted
        return
    }
    (*p).ev_kind[(*p).ev_head] = kind as u8
    (*p).ev_idx[(*p).ev_head] = idx as u8
    (*p).ev_val[(*p).ev_head] = val
    (*p).ev_head = next
}

// like pad_event_push but connect / disconnect must never be lost: when the ring is full the OLDEST event goes
fn pad_event_force(p: *mut Pad, kind: u32, idx: u32, val: f64) {
    let next: usize = ((*p).ev_head + 1) % EVQ
    if next == (*p).ev_tail {
        (*p).ev_tail = ((*p).ev_tail + 1) % EVQ
        (*p).ev_lost = (*p).ev_lost + 1 as u64
    }
    pad_event_push(p, kind, idx, val)
}

// pops the oldest event: kind (0 = none), index and value in out[0], out[1] (value as f64 in out_v)
fn pad_event_next(p: *mut Pad, out_idx: *mut u32, out_v: *mut f64) -> u32 {
    if (*p).ev_tail == (*p).ev_head {
        return 0 as u32
    }
    let k: u32 = (*p).ev_kind[(*p).ev_tail] as u32
    *out_idx = (*p).ev_idx[(*p).ev_tail] as u32
    *out_v = (*p).ev_val[(*p).ev_tail]
    (*p).ev_tail = ((*p).ev_tail + 1) % EVQ
    return k
}

// ---- frame handling -----------------------------------------------------------------------------------------------
// a new frame: the edges are cleared, the held state stays
fn pad_begin(p: *mut Pad) {
    (*p).pressed = 0 as u32
    (*p).released = 0 as u32
}

// recompute the logical gamepad from the physical state (called at every SYN_REPORT) and queue the changes
fn pad_update(p: *mut Pad) {
    if (*p).direct {
        return // XInput: pad_feed_xinput already set it
    }
    var nb: u32 = 0 as u32
    var b: usize = 0
    while b < PB_COUNT {
        if src_button(p, b) {
            nb = nb | ((1 as u32) << (b as u32))
        }
        b = b + 1
    }
    var raw: [f64; 6] = [0.0; 6]
    raw[PA_LX] = src_value(p, PB_COUNT + PA_LX, false)
    raw[PA_LY] = src_value(p, PB_COUNT + PA_LY, false)
    raw[PA_RX] = src_value(p, PB_COUNT + PA_RX, false)
    raw[PA_RY] = src_value(p, PB_COUNT + PA_RY, false)
    raw[PA_LT] = src_value(p, PB_COUNT + PA_LT, true)
    raw[PA_RT] = src_value(p, PB_COUNT + PA_RT, true)
    var tmp: [f64; 2] = [0.0; 2]
    radial(raw[PA_LX], raw[PA_LY], (*p).dz_stick, &tmp)
    var out: [f64; 6] = [0.0; 6]
    out[PA_LX] = clamp1(tmp[0])
    out[PA_LY] = clamp1(tmp[1])
    radial(raw[PA_RX], raw[PA_RY], (*p).dz_stick, &tmp)
    out[PA_RX] = clamp1(tmp[0])
    out[PA_RY] = clamp1(tmp[1])
    var t: usize = PA_LT
    while t <= PA_RT {
        var v: f64 = raw[t]
        if v < (*p).dz_trig {
            v = 0.0
        } else {
            v = (v - (*p).dz_trig) / (1.0 - (*p).dz_trig)
        }
        if v > 1.0 { v = 1.0 }
        out[t] = v
        t = t + 1
    }
    commit(p, nb, &out)
}

fn commit(p: *mut Pad, nb: u32, out: *mut [f64; 6]) {
    let old: u32 = (*p).buttons
    let went_down: u32 = nb & (old ^ 0xffffffff as u32)
    let went_up: u32 = old & (nb ^ 0xffffffff as u32)
    (*p).pressed = (*p).pressed | went_down
    (*p).released = (*p).released | went_up
    var b: usize = 0
    while b < PB_COUNT {
        let m: u32 = (1 as u32) << (b as u32)
        if (went_down & m) != 0 as u32 { pad_event_push(p, PE_BUTTON_DOWN, b as u32, 1.0) }
        if (went_up & m) != 0 as u32 { pad_event_push(p, PE_BUTTON_UP, b as u32, 0.0) }
        b = b + 1
    }
    (*p).buttons = nb
    var a: usize = 0
    while a < PA_COUNT {
        (*p).axes[a] = (*out)[a]
        if (*p).sent_axes[a] != (*out)[a] {
            (*p).sent_axes[a] = (*out)[a]
            pad_event_push(p, PE_AXIS, a as u32, (*out)[a])
        }
        a = a + 1
    }
}

fn pad_down(p: *mut Pad, b: usize) -> bool { return b < PB_COUNT && ((*p).buttons >> (b as u32)) & (1 as u32) != (0 as u32) }
fn pad_pressed(p: *mut Pad, b: usize) -> bool { return b < PB_COUNT && ((*p).pressed >> (b as u32)) & (1 as u32) != (0 as u32) }
fn pad_released(p: *mut Pad, b: usize) -> bool { return b < PB_COUNT && ((*p).released >> (b as u32)) & (1 as u32) != (0 as u32) }
fn pad_axis(p: *mut Pad, a: usize) -> f64 { if a < PA_COUNT { return (*p).axes[a] } return 0.0 }

// ---- feeding ------------------------------------------------------------------------------------------------------
// One evdev event as numbers (type, code, value). SYN_REPORT (code 0) commits; SYN_DROPPED (code 3) discards
// everything up to the next SYN_REPORT (the caller should re-read the device state).
fn pad_feed_evdev_one(p: *mut Pad, t: u32, code: u32, value: i32) {
    if t == EVT_SYN {
        if code == 3 as u32 {
            (*p).dropped = true
            return
        }
        if code == 0 as u32 {
            if (*p).dropped {
                (*p).dropped = false
                return
            }
            pad_update(p)
        }
        return
    }
    if (*p).dropped {
        return
    }
    if t == EVT_KEY {
        let i: i64 = pad_key_index(p, code)
        if i >= 0 && value != 2 as i32 { // 2 = auto-repeat
            if value != 0 as i32 {
                (*p).key_down[i as usize] = 1 as u8
            } else {
                (*p).key_down[i as usize] = 0 as u8
            }
        }
        return
    }
    if t == EVT_ABS {
        if code < 64 as u32 && pad_has_abs(p, code) {
            (*p).abs_val[code as usize] = value
        }
        return
    }
}

// n octets of struct input_event (24 octets each, 64 bit kernel): returns the octets used (whole events only)
fn pad_feed_evdev(p: *mut Pad, buf: u64, n: usize) -> usize {
    var o: usize = 0
    while o + 24 <= n {
        let t: u32 = rt.ld16(buf + o as u64, 8) as u32
        let c: u32 = rt.ld16(buf + o as u64, 9) as u32
        let v: i32 = s32(rt.ld32(buf + o as u64, 5))
        pad_feed_evdev_one(p, t, c, v)
        o = o + 24
    }
    return o
}

// n octets of struct js_event (8 octets: u32 time, i16 value, u8 type, u8 number); the INIT flag 0x80 is ignored
// as a flag (the initial state arrives as ordinary events). Every event is committed at once (joydev has no SYN).
fn pad_feed_joydev(p: *mut Pad, buf: u64, n: usize) -> usize {
    var o: usize = 0
    while o + 8 <= n {
        let q: u64 = buf + o as u64
        let v: i32 = s16(rt.ld16(q, 2))
        let t: u8 = rt.ld8(q, 6) & 127 as u8
        let num: usize = rt.ld8(q, 7) as usize
        if t == 1 as u8 && num < (*p).js_nbtn {
            pad_feed_evdev_one(p, EVT_KEY, (*p).js_btn[num], v)
            pad_update(p)
        } else if t == 2 as u8 && num < (*p).js_nax {
            pad_feed_evdev_one(p, EVT_ABS, (*p).js_ax[num], v)
            pad_update(p)
        }
        o = o + 8
    }
    return o
}

// XInput state: buttons mask (XINPUT_GAMEPAD_*), triggers 0..255, sticks -32768..32767 (y up in XInput, flipped here)
fn pad_feed_xinput(p: *mut Pad, buttons: u32, lt: u32, rt_: u32, lx: i32, ly: i32, rx: i32, ry: i32) {
    (*p).direct = true
    var nb: u32 = 0 as u32
    if (buttons & 0x1000 as u32) != 0 as u32 { nb = nb | ((1 as u32) << (PB_A as u32)) }
    if (buttons & 0x2000 as u32) != 0 as u32 { nb = nb | ((1 as u32) << (PB_B as u32)) }
    if (buttons & 0x4000 as u32) != 0 as u32 { nb = nb | ((1 as u32) << (PB_X as u32)) }
    if (buttons & 0x8000 as u32) != 0 as u32 { nb = nb | ((1 as u32) << (PB_Y as u32)) }
    if (buttons & 0x20 as u32) != 0 as u32 { nb = nb | ((1 as u32) << (PB_BACK as u32)) }
    if (buttons & 0x400 as u32) != 0 as u32 { nb = nb | ((1 as u32) << (PB_GUIDE as u32)) }
    if (buttons & 0x10 as u32) != 0 as u32 { nb = nb | ((1 as u32) << (PB_START as u32)) }
    if (buttons & 0x40 as u32) != 0 as u32 { nb = nb | ((1 as u32) << (PB_LSTICK as u32)) }
    if (buttons & 0x80 as u32) != 0 as u32 { nb = nb | ((1 as u32) << (PB_RSTICK as u32)) }
    if (buttons & 0x100 as u32) != 0 as u32 { nb = nb | ((1 as u32) << (PB_LSHOULDER as u32)) }
    if (buttons & 0x200 as u32) != 0 as u32 { nb = nb | ((1 as u32) << (PB_RSHOULDER as u32)) }
    if (buttons & 0x1 as u32) != 0 as u32 { nb = nb | ((1 as u32) << (PB_DUP as u32)) }
    if (buttons & 0x2 as u32) != 0 as u32 { nb = nb | ((1 as u32) << (PB_DDOWN as u32)) }
    if (buttons & 0x4 as u32) != 0 as u32 { nb = nb | ((1 as u32) << (PB_DLEFT as u32)) }
    if (buttons & 0x8 as u32) != 0 as u32 { nb = nb | ((1 as u32) << (PB_DRIGHT as u32)) }
    var out: [f64; 6] = [0.0; 6]
    var tmp: [f64; 2] = [0.0; 2]
    radial(xi_axis(lx), 0.0 - xi_axis(ly), (*p).dz_stick, &tmp)
    out[PA_LX] = clamp1(tmp[0])
    out[PA_LY] = clamp1(tmp[1])
    radial(xi_axis(rx), 0.0 - xi_axis(ry), (*p).dz_stick, &tmp)
    out[PA_RX] = clamp1(tmp[0])
    out[PA_RY] = clamp1(tmp[1])
    var l: f64 = (lt as f64) / 255.0
    var r: f64 = (rt_ as f64) / 255.0
    if l < (*p).dz_trig { l = 0.0 } else { l = (l - (*p).dz_trig) / (1.0 - (*p).dz_trig) }
    if r < (*p).dz_trig { r = 0.0 } else { r = (r - (*p).dz_trig) / (1.0 - (*p).dz_trig) }
    out[PA_LT] = l
    out[PA_RT] = r
    commit(p, nb, &out)
}

// -32768..32767 -> -1..1 (the negative side divides by 32768, the positive by 32767)
fn xi_axis(v: i32) -> f64 {
    if v < 0 as i32 {
        return clamp1((v as f64) / 32768.0)
    }
    return clamp1((v as f64) / 32767.0)
}

// two's complement reinterpretation (the casts are range checked, so no `as`)
fn s32(v: u32) -> i32 {
    let w: i64 = v as i64
    if w >= 2147483648 {
        return (w - 4294967296) as i32
    }
    return w as i32
}

fn s16(v: u16) -> i32 {
    let w: i64 = v as i64
    if w >= 32768 {
        return (w - 65536) as i32
    }
    return w as i32
}

fn u32_of_i32(v: i32) -> u32 {
    let w: i64 = v as i64
    if w < 0 {
        return (w + 4294967296) as u32
    }
    return w as u32
}
