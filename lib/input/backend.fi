// SPDX-License-Identifier: MPL-2.0
// lib/input/backend.fi -- the input backend a Linux build gets.
//
// lib/input/input.fi imports `input.backend`. The module search looks
// NEXT TO THE ROOT FILE first and in $FIRNLIB last (compiler/src/modules.rs,
// the same mechanism lib/window/window.fi uses): a Windows build puts an
// `input/backend.fi` beside its root that forwards to lib/input/sendinput.fi
// (tools/input/build-windows.sh does that); every other build ends up
// here, at /dev/uinput.
import input.uinput

export { be_open, be_close, be_error, be_rel, be_button, be_key, be_name }

fn be_name() -> str { return "uinput" }
fn be_open() -> bool { return uinput.open() }
fn be_close() { uinput.close() }
fn be_error() -> str { return uinput.error_text() }
fn be_rel(dx: i32, dy: i32, wheel: i32, hwheel: i32) -> bool {
    return uinput.rel(dx, dy, wheel, hwheel)
}
fn be_button(code: u32, down: bool) -> bool { return uinput.button(code, down) }
fn be_key(code: u32, down: bool) -> bool { return uinput.key(code, down) }
