// SPDX-License-Identifier: MPL-2.0
// lib/input/padff.fi -- input.padff: RUMBLE (force feedback) as bytes -- PURE, no syscall, no library.
//
// Linux evdev force feedback (what SDL's rumble does): the device must be opened O_RDWR; a rumble effect is uploaded once with
// ioctl(EVIOCSFF, &ff_effect) (the kernel picks the id when it is -1 and writes it back), played / stopped by WRITING an
// input_event { type EV_FF, code = effect id, value = 1 / 0 }, the master gain is an input_event { EV_FF, FF_GAIN, 0..65535 },
// and the effect is erased again with ioctl(EVIOCRMFF, id). This file builds exactly those byte blocks (layout of the 64 bit
// kernel's struct ff_effect, 48 octets, and struct input_event, 24 octets) and the ioctl numbers; lib/input/padsys.fi sends them.
// The Windows twin (XInputSetState) needs none of it but the scaling `ff_scale`.
//
//   struct ff_effect (offsets in octets): u16 type @0, i16 id @2, u16 direction @4, ff_trigger { u16 button @6, u16 interval @8 },
//   ff_replay { u16 length @10, u16 delay @12 }, the union @16 (8 aligned: ff_periodic_effect holds a pointer; size 32);
//   ff_rumble_effect { u16 strong_magnitude @16, u16 weak_magnitude @18 }.
import std.rt

export {
    ff_scale, ff_rumble_effect, ff_event, ff_clamp_ms,
    FF_EFFECT_BYTES, EVENT_BYTES, EV_FF, FF_RUMBLE, FF_GAIN, FF_MAX, FF_MAX_LENGTH,
    EVIOCSFF, EVIOCRMFF, ff_ioc_bits,
}

const FF_EFFECT_BYTES: usize = 48
const EVENT_BYTES: usize = 24
const EV_FF: u32 = 21 // 0x15
const FF_RUMBLE: u32 = 80 // 0x50
const FF_GAIN: u32 = 96 // 0x60
const FF_MAX: u32 = 127 // 0x7f
const FF_MAX_LENGTH: u32 = 65535 // replay.length is a u16: the longest effect (65.5 s)

// _IOW('E', 0x80, struct ff_effect) and _IOW('E', 0x81, int), as in <linux/input.h> on a 64 bit kernel
const EVIOCSFF: i64 = 1076905344 // 0x40304580
const EVIOCRMFF: i64 = 1074021761 // 0x40044581

// EVIOCGBIT(EV_FF, 16): which force feedback codes the device has (FF_MAX / 8 + 1 = 16 octets). _IOC(read, 'E', 0x20 + ev, len)
fn ff_ioc_bits() -> i64 {
    return (2 << 30) | (16 << 16) | (69 << 8) | (32 + 21)
}

// 0.0 .. 1.0 -> 0 .. 65535 (clamped; NaN -> 0)
fn ff_scale(x: f64) -> u32 {
    if !(x > 0.0) {
        return 0 as u32
    }
    if x >= 1.0 {
        return 65535 as u32
    }
    return (x * 65535.0 + 0.5) as u32
}

// milliseconds -> replay.length: 0 (or too long) = the longest the kernel takes; callers that want "until stopped" call again
fn ff_clamp_ms(ms: u32) -> u32 {
    if ms == 0 as u32 || ms > FF_MAX_LENGTH {
        return FF_MAX_LENGTH
    }
    return ms
}

// the 48 octets of a rumble effect. id < 0 = "give me a new one" (-1 on the wire). strong = the low frequency (big) motor.
fn ff_rumble_effect(out: u64, id: i32, strong: u32, weak: u32, ms: u32) {
    var i: usize = 0
    while i < 6 {
        rt.st64(out, i, 0 as u64)
        i = i + 1
    }
    rt.st16(out, 0, FF_RUMBLE as u16)
    var wire: u32 = 65535 as u32
    if id >= 0 {
        wire = id as u32
    }
    rt.st16(out, 1, wire as u16)
    rt.st16(out, 5, ff_clamp_ms(ms) as u16) // replay.length @10
    rt.st16(out, 8, strong as u16) // @16
    rt.st16(out, 9, weak as u16) // @18
}

// one struct input_event of type EV_FF (the time is left 0: the kernel does not read it on write)
fn ff_event(out: u64, code: u32, value: u32) {
    rt.st64(out, 0, 0 as u64)
    rt.st64(out, 1, 0 as u64)
    rt.st16(out, 8, EV_FF as u16)
    rt.st16(out, 9, code as u16)
    rt.st32(out, 5, value)
}
