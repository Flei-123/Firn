// SPDX-License-Identifier: MPL-2.0
// lib/input/textcore.fi -- input.textcore: the DEVICE INDEPENDENT part of text input (preedit, commit, compose, caret rect).
//
// Everything here is pure: numbers / code points in, state and events out. No syscall, no library. That is what
// tests/2810 drives (tables, dead keys, Compose sequences, preedit edits, UTF-8 / UTF-16, random streams against a model).
//
//   platform IME (XIM callbacks, Windows IMM, Android InputConnection) --text_preedit_*, text_commit-->  \
//   keysyms of a plain keyboard                                        --text_key------------------->  > Text -->  events
//                                                                                                        (TE_*) + preedit
// THE EVENTS (text_event_next), strictly in the order they happened:
//   TE_PREEDIT_BEGIN   the pre-edit text went from empty to something
//   TE_PREEDIT         the pre-edit text / caret / segments changed (read them with text_preedit_*)
//   TE_PREEDIT_END     the pre-edit text went away WITHOUT being committed (cancel)
//   TE_COMMIT          final text, `cp[0..n]` (at most EVCP = 32 code points per event, longer commits are split in order).
//                      A commit while a pre-edit text stands first sends TE_PREEDIT_END.
// THE PRE-EDIT TEXT is code points (<= MAXPRE) + one FEEDBACK word per code point (XIM's bits, FB_*) + a caret (code point
// index). Segments are runs of equal class: SEG_INPUT (plain / underline), SEG_CONVERTED, SEG_TARGET (the clause being
// converted: reverse / highlight).
// THE COMPOSE ENGINE (text_key) is the fallback for keyboards without an IME:
//   * dead keys (keysym 0xFE50..): dead + base letter = the precomposed letter (Unicode NFC), dead + dead / space = the
//     spacing accent, dead + something unknown = accent then the letter. While waiting, the accent stands in the pre-edit text.
//   * Compose key (Multi_key, 0xFF20) + 2 or 3 ASCII keys from the X11 Compose file (composedata.fi); an exact match commits at
//     once, a still possible longer match waits, anything else cancels (the keys are swallowed).
//   * Escape / BackSpace cancel; modifier keys change nothing; Ctrl / Alt cancel and pass.
// NOT proven against any real IME: only the logic here and the glue with fake data.
import std.rt
import input.composedata

export {
    Text, TextEvent, text_new, text_reset, text_set_active, text_active,
    text_preedit_set, text_preedit_replace, text_preedit_caret, text_preedit_commit, text_preedit_cancel, text_commit,
    text_commit_utf8, text_preedit_set_utf8,
    text_preedit_len, text_preedit_cp, text_preedit_fb, text_preedit_caret_pos, text_preedit_seg_count, text_preedit_seg,
    text_preedit_utf8, text_preedit_caret_bytes, text_composing,
    text_key, text_event_next, text_events_lost, text_set_spot, text_spot_take, text_spot,
    text_set_surrounding, text_clear_surrounding, text_surround_known, text_surround_len, text_surround_cursor,
    text_surround_anchor, text_surround_base, text_surround_text, text_surround_cursor_cp, text_surround_cursor_utf16,
    text_delete_surrounding, SURMAX, SU_BYTES, SU_UTF16, SU_CP, TE_DELETE_SURROUNDING,
    utf8_decode, utf8_encode, utf16_decode, keysym_cp, dead_index, is_modifier_keysym, fb_class, fb_of_imm_attr,
    dead_lookup, seq_lookup,
    TE_NONE, TE_PREEDIT_BEGIN, TE_PREEDIT, TE_PREEDIT_END, TE_COMMIT,
    KR_PASS, KR_EAT, KR_COMMIT,
    FB_REVERSE, FB_UNDERLINE, FB_HIGHLIGHT, FB_PRIMARY, FB_SECONDARY, FB_TERTIARY,
    SEG_INPUT, SEG_CONVERTED, SEG_TARGET, MAXPRE, EVCP, EVQ,
    KS_MULTI_KEY, KS_ESCAPE, KS_BACKSPACE, MOD_SHIFT, MOD_CTRL, MOD_ALT,
}

const TE_NONE: u32 = 0
const TE_PREEDIT_BEGIN: u32 = 1
const TE_PREEDIT: u32 = 2
const TE_PREEDIT_END: u32 = 3
const TE_COMMIT: u32 = 4
// the IME wants text around the caret deleted: cp[0] = octets before the caret, cp[1] = octets after it (see text_delete_surrounding)
const TE_DELETE_SURROUNDING: u32 = 5

// text_key results
const KR_PASS: u32 = 0 // not for the engine: handle the key as usual
const KR_EAT: u32 = 1 // swallowed (pre-edit text changed or cancelled)
const KR_COMMIT: u32 = 2 // swallowed and a TE_COMMIT is queued

// XIMFeedback bits
const FB_REVERSE: u32 = 1
const FB_UNDERLINE: u32 = 2
const FB_HIGHLIGHT: u32 = 4
const FB_PRIMARY: u32 = 8
const FB_SECONDARY: u32 = 16
const FB_TERTIARY: u32 = 32

const SEG_INPUT: u32 = 0
const SEG_CONVERTED: u32 = 1
const SEG_TARGET: u32 = 2

const MAXPRE: usize = 256
const EVCP: usize = 32
const EVQ: usize = 128
const SURMAX: usize = 1024
// units of text_delete_surrounding: octets (Wayland), UTF-16 units (Android), code points
const SU_BYTES: u32 = 0
const SU_UTF16: u32 = 1
const SU_CP: u32 = 2

const KS_MULTI_KEY: u32 = 65312 // 0xFF20
const KS_ESCAPE: u32 = 65307
const KS_BACKSPACE: u32 = 65288
const MOD_SHIFT: u32 = 1
const MOD_CTRL: u32 = 4
const MOD_ALT: u32 = 8

struct Text {
    on: bool,
    pre: [u32; 256],
    fb: [u32; 256],
    pn: usize,
    caret: usize,
    // compose engine: 0 idle, 1 dead key waiting (cdead), 2 Compose-key sequence (ck[0..cn])
    cmode: u32,
    cdead: u32,
    ck: [u32; 3],
    cn: usize,
    // text cursor rectangle (window pixels), reported to the IME
    sx: i32,
    sy: i32,
    sw: i32,
    sh: i32,
    spot_dirty: bool,
    // event ring
    q_kind: [u8; 128],
    q_n: [u8; 128],
    q_cp: [u32; 4096],
    q_head: usize,
    q_tail: usize,
    q_lost: u64,
    // surrounding text (set by the text field, read by IMEs: Android getTextBeforeCursor, Wayland text-input surrounding_text)
    sur: [u8; 1024],
    sur_n: usize,
    sur_cur: usize,
    sur_anc: usize,
    sur_base: usize,
    sur_on: bool,
}

struct TextEvent {
    kind: u32,
    n: usize,
    cp: [u32; 32],
}

fn text_new() -> Text {
    return Text { on: true, pre: [0 as u32; 256], fb: [0 as u32; 256], pn: 0, caret: 0,
        cmode: 0 as u32, cdead: 0 as u32, ck: [0 as u32; 3], cn: 0,
        sx: 0 as i32, sy: 0 as i32, sw: 0 as i32, sh: 0 as i32, spot_dirty: false,
        q_kind: [0 as u8; 128], q_n: [0 as u8; 128], q_cp: [0 as u32; 4096], q_head: 0, q_tail: 0, q_lost: 0,
        sur: [0 as u8; 1024], sur_n: 0, sur_cur: 0, sur_anc: 0, sur_base: 0, sur_on: false }
}

// ---- UTF helpers -------------------------------------------------------------------------------------------------

// Append the UTF-8 of `cp` at `out` (4 octets of room); returns the octet count (1..4). A surrogate or a value above
// U+10FFFF is written as U+FFFD.
fn utf8_encode(cp0: u32, out: u64) -> usize {
    var cp: u32 = cp0
    if cp > 1114111 as u32 || (cp >= 55296 as u32 && cp <= 57343 as u32) {
        cp = 65533 as u32
    }
    if cp < 128 as u32 {
        rt.st8(out, 0, cp as u8)
        return 1
    }
    if cp < 2048 as u32 {
        rt.st8(out, 0, (192 as u32 | (cp >> 6 as u32)) as u8)
        rt.st8(out, 1, (128 as u32 | (cp & 63 as u32)) as u8)
        return 2
    }
    if cp < 65536 as u32 {
        rt.st8(out, 0, (224 as u32 | (cp >> 12 as u32)) as u8)
        rt.st8(out, 1, (128 as u32 | ((cp >> 6 as u32) & 63 as u32)) as u8)
        rt.st8(out, 2, (128 as u32 | (cp & 63 as u32)) as u8)
        return 3
    }
    rt.st8(out, 0, (240 as u32 | (cp >> 18 as u32)) as u8)
    rt.st8(out, 1, (128 as u32 | ((cp >> 12 as u32) & 63 as u32)) as u8)
    rt.st8(out, 2, (128 as u32 | ((cp >> 6 as u32) & 63 as u32)) as u8)
    rt.st8(out, 3, (128 as u32 | (cp & 63 as u32)) as u8)
    return 4
}

// Decode `n` octets of UTF-8 at `p` into at most `cap` code points at `out` (u32 array). Every ill-formed octet (stray
// continuation, overlong form, surrogate, > U+10FFFF, truncated sequence) becomes ONE U+FFFD. Returns the count.
fn utf8_decode(p: u64, n: usize, out: u64, cap: usize) -> usize {
    var i: usize = 0
    var m: usize = 0
    while i < n && m < cap {
        let b: u32 = rt.ld8(p, i) as u32
        var need: usize = 0
        var cp: u32 = 0 as u32
        var lo: u32 = 0 as u32
        if b < 128 as u32 {
            rt.st32(out, m, b)
            m = m + 1
            i = i + 1
            continue
        } else if b >= 194 as u32 && b <= 223 as u32 {
            need = 1
            cp = b & 31 as u32
            lo = 128 as u32
        } else if b >= 224 as u32 && b <= 239 as u32 {
            need = 2
            cp = b & 15 as u32
            lo = 2048 as u32
        } else if b >= 240 as u32 && b <= 244 as u32 {
            need = 3
            cp = b & 7 as u32
            lo = 65536 as u32
        } else {
            rt.st32(out, m, 65533 as u32)
            m = m + 1
            i = i + 1
            continue
        }
        var ok: bool = true
        if i + need >= n {
            ok = false
        }
        var k: usize = 1
        while ok && k <= need {
            let c: u32 = rt.ld8(p, i + k) as u32
            if (c & 192 as u32) != 128 as u32 {
                ok = false
            } else {
                cp = (cp << 6 as u32) | (c & 63 as u32)
            }
            k = k + 1
        }
        if ok && (cp < lo || cp > 1114111 as u32 || (cp >= 55296 as u32 && cp <= 57343 as u32)) {
            ok = false
        }
        if ok {
            rt.st32(out, m, cp)
            m = m + 1
            i = i + need + 1
        } else {
            rt.st32(out, m, 65533 as u32)
            m = m + 1
            i = i + 1
        }
    }
    return m
}

// UTF-16 (u16 array at `p`, `n` units) -> code points; an unpaired surrogate becomes U+FFFD.
fn utf16_decode(p: u64, n: usize, out: u64, cap: usize) -> usize {
    var i: usize = 0
    var m: usize = 0
    while i < n && m < cap {
        let u: u32 = rt.ld16(p, i) as u32
        if u >= 55296 as u32 && u <= 56319 as u32 {
            if i + 1 < n {
                let v: u32 = rt.ld16(p, i + 1) as u32
                if v >= 56320 as u32 && v <= 57343 as u32 {
                    rt.st32(out, m, 65536 as u32 + ((u - 55296 as u32) << 10 as u32) + (v - 56320 as u32))
                    m = m + 1
                    i = i + 2
                    continue
                }
            }
            rt.st32(out, m, 65533 as u32)
        } else if u >= 56320 as u32 && u <= 57343 as u32 {
            rt.st32(out, m, 65533 as u32)
        } else {
            rt.st32(out, m, u)
        }
        m = m + 1
        i = i + 1
    }
    return m
}

// ---- keysyms -----------------------------------------------------------------------------------------------------

// Keysym -> code point of a character key (0 = not a character): Latin-1 and the 0x01000000 Unicode range.
fn keysym_cp(ks: u32) -> u32 {
    if ks >= 32 as u32 && ks <= 126 as u32 {
        return ks
    }
    if ks >= 160 as u32 && ks <= 255 as u32 {
        return ks
    }
    if ks >= 16777216 as u32 && ks <= 17891327 as u32 {
        return ks - 16777216 as u32
    }
    return 0 as u32
}

// Dead key keysym -> index into composedata (0..15), 16 = not a dead key.
fn dead_index(ks: u32) -> u32 {
    var i: usize = 0
    while i < 16 {
        if composedata.DEAD_SYM[i] == ks {
            return i as u32
        }
        i = i + 1
    }
    return 16 as u32
}

// Shift / Ctrl / Alt / Super / Lock / ISO level and group shifts / Mode_switch / Num_Lock: keys that make no character.
fn is_modifier_keysym(ks: u32) -> bool {
    if ks >= 65505 as u32 && ks <= 65518 as u32 {
        return true
    }
    if ks >= 65025 as u32 && ks <= 65043 as u32 {
        return true
    }
    return ks == 65406 as u32 || ks == 65407 as u32
}

// ---- compose tables ----------------------------------------------------------------------------------------------

fn dead_lookup(d: u32, cp: u32) -> u32 {
    let key: u32 = d * 2097152 as u32 + cp
    var lo: usize = 0
    var hi: usize = composedata.DEAD_N
    while lo < hi {
        let mid: usize = (lo + hi) / 2
        if composedata.DEAD_KEY[mid] < key {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    if lo < composedata.DEAD_N && composedata.DEAD_KEY[lo] == key {
        return composedata.DEAD_RES[lo]
    }
    return 0 as u32
}

// first index with SEQ_KEY >= key
fn seq_lower(key: u32) -> usize {
    var lo: usize = 0
    var hi: usize = composedata.SEQ_N
    while lo < hi {
        let mid: usize = (lo + hi) / 2
        if composedata.SEQ_KEY[mid] < key {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo
}

fn seq_lookup(key: u32) -> u32 {
    let i: usize = seq_lower(key)
    if i < composedata.SEQ_N && composedata.SEQ_KEY[i] == key {
        return composedata.SEQ_RES[i]
    }
    return 0 as u32
}

// does any sequence have a key in [lo, hi)?
fn seq_any(lo: u32, hi: u32) -> bool {
    let i: usize = seq_lower(lo)
    return i < composedata.SEQ_N && composedata.SEQ_KEY[i] < hi
}

// ---- the event ring ----------------------------------------------------------------------------------------------

fn q_push(t: *mut Text, kind: u32, p: u64, n: usize) {
    let next: usize = ((*t).q_head + 1) % EVQ
    if next == (*t).q_tail {
        (*t).q_tail = ((*t).q_tail + 1) % EVQ
        (*t).q_lost = (*t).q_lost + 1 as u64
    }
    let h: usize = (*t).q_head
    (*t).q_kind[h] = kind as u8
    (*t).q_n[h] = n as u8
    var i: usize = 0
    while i < n {
        (*t).q_cp[h * 32 + i] = rt.ld32(p, i)
        i = i + 1
    }
    (*t).q_head = next
}

// Next event, 0 (TE_NONE) if the queue is empty.
fn text_event_next(t: *mut Text, ev: *mut TextEvent) -> u32 {
    if (*t).q_tail == (*t).q_head {
        return TE_NONE
    }
    let h: usize = (*t).q_tail
    (*ev).kind = (*t).q_kind[h] as u32
    (*ev).n = (*t).q_n[h] as usize
    var i: usize = 0
    while i < (*ev).n {
        (*ev).cp[i] = (*t).q_cp[h * 32 + i]
        i = i + 1
    }
    (*t).q_tail = ((*t).q_tail + 1) % EVQ
    return (*ev).kind
}

// events lost because the consumer did not keep up (the oldest go)
fn text_events_lost(t: *mut Text) -> u64 { return (*t).q_lost }

// ---- the pre-edit text -------------------------------------------------------------------------------------------

fn text_preedit_len(t: *mut Text) -> usize { return (*t).pn }
fn text_preedit_cp(t: *mut Text, i: usize) -> u32 {
    if i >= (*t).pn { return 0 as u32 }
    return (*t).pre[i]
}
fn text_preedit_fb(t: *mut Text, i: usize) -> u32 {
    if i >= (*t).pn { return 0 as u32 }
    return (*t).fb[i]
}
fn text_preedit_caret_pos(t: *mut Text) -> usize { return (*t).caret }
// a dead key or a Compose sequence is waiting
fn text_composing(t: *mut Text) -> bool { return (*t).cmode != 0 as u32 }

// feedback bits -> segment class
fn fb_class(f: u32) -> u32 {
    if (f & (FB_REVERSE | FB_HIGHLIGHT)) != 0 as u32 {
        return SEG_TARGET
    }
    if (f & (FB_PRIMARY | FB_SECONDARY | FB_TERTIARY)) != 0 as u32 {
        return SEG_CONVERTED
    }
    return SEG_INPUT
}

// Windows ATTR_* (ImmGetCompositionString GCS_COMPATTR) -> feedback bits.
//   0 ATTR_INPUT  1 ATTR_TARGET_CONVERTED  2 ATTR_CONVERTED  3 ATTR_TARGET_NOTCONVERTED  4 ATTR_INPUT_ERROR
//   5 ATTR_FIXEDCONVERTED
fn fb_of_imm_attr(a: u32) -> u32 {
    if a == 1 as u32 { return FB_HIGHLIGHT | FB_UNDERLINE }
    if a == 2 as u32 { return FB_PRIMARY | FB_UNDERLINE }
    if a == 3 as u32 { return FB_REVERSE }
    if a == 4 as u32 { return FB_TERTIARY | FB_UNDERLINE }
    if a == 5 as u32 { return FB_SECONDARY }
    return FB_UNDERLINE
}

// number of segments (runs of equal class); 0 for an empty pre-edit text
fn text_preedit_seg_count(t: *mut Text) -> usize {
    if (*t).pn == 0 { return 0 }
    var n: usize = 1
    var i: usize = 1
    while i < (*t).pn {
        if fb_class((*t).fb[i]) != fb_class((*t).fb[i - 1]) {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// segment `k`: code point range [start, end) and class; false if k is out of range
fn text_preedit_seg(t: *mut Text, k: usize, start: *mut usize, end: *mut usize, class: *mut u32) -> bool {
    if (*t).pn == 0 { return false }
    var seg: usize = 0
    var s: usize = 0
    var i: usize = 1
    while i <= (*t).pn {
        if i == (*t).pn || fb_class((*t).fb[i]) != fb_class((*t).fb[i - 1]) {
            if seg == k {
                *start = s
                *end = i
                *class = fb_class((*t).fb[s])
                return true
            }
            seg = seg + 1
            s = i
        }
        i = i + 1
    }
    return false
}

// the pre-edit text as UTF-8 into `out` (cap octets); returns the octet count (truncated at a code point border)
fn text_preedit_utf8(t: *mut Text, out: u64, cap: usize) -> usize {
    var m: usize = 0
    var i: usize = 0
    var tmp: [u8; 4] = [0 as u8; 4]
    while i < (*t).pn {
        let k: usize = utf8_encode((*t).pre[i], (&tmp[0]) as u64)
        if m + k > cap { break }
        var j: usize = 0
        while j < k {
            rt.st8(out, m + j, tmp[j])
            j = j + 1
        }
        m = m + k
        i = i + 1
    }
    return m
}

// the caret as an octet offset into text_preedit_utf8 (for fUi's editor_ime_preedit(p, n, cur))
fn text_preedit_caret_bytes(t: *mut Text) -> usize {
    var m: usize = 0
    var i: usize = 0
    var tmp: [u8; 4] = [0 as u8; 4]
    while i < (*t).caret && i < (*t).pn {
        m = m + utf8_encode((*t).pre[i], (&tmp[0]) as u64)
        i = i + 1
    }
    return m
}

// events for a pre-edit change: was = old length
fn pre_notify(t: *mut Text, was: usize) {
    var none: [u32; 1] = [0 as u32; 1]
    let p: u64 = (&none[0]) as u64
    if was == 0 && (*t).pn > 0 {
        q_push(t, TE_PREEDIT_BEGIN, p, 0)
        q_push(t, TE_PREEDIT, p, 0)
    } else if was > 0 && (*t).pn == 0 {
        q_push(t, TE_PREEDIT_END, p, 0)
    } else if (*t).pn > 0 {
        q_push(t, TE_PREEDIT, p, 0)
    }
}

// XIM's replace: code points [first, first+len) of the pre-edit text become `cps[0..n]` (feedback `fbs[0..n]`, 0 = all
// FB_UNDERLINE); the caret becomes `caret`. Everything is clamped; the text never grows past MAXPRE.
fn text_preedit_replace(t: *mut Text, first0: usize, len0: usize, cps: u64, n0: usize, fbs: u64, caret: usize) {
    let was: usize = (*t).pn
    var first: usize = first0
    if first > (*t).pn { first = (*t).pn }
    var len: usize = len0
    if len > (*t).pn - first { len = (*t).pn - first }
    var n: usize = n0
    if (*t).pn - len + n > MAXPRE {
        n = MAXPRE - ((*t).pn - len)
    }
    let tail: usize = (*t).pn - first - len
    // move the tail (the arrays are small; copy through a temporary so the overlap is no problem)
    var tmp_c: [u32; 256] = [0 as u32; 256]
    var tmp_f: [u32; 256] = [0 as u32; 256]
    var i: usize = 0
    while i < tail {
        tmp_c[i] = (*t).pre[first + len + i]
        tmp_f[i] = (*t).fb[first + len + i]
        i = i + 1
    }
    i = 0
    while i < n {
        (*t).pre[first + i] = rt.ld32(cps, i)
        if fbs == 0 as u64 {
            (*t).fb[first + i] = FB_UNDERLINE
        } else {
            (*t).fb[first + i] = rt.ld32(fbs, i)
        }
        i = i + 1
    }
    i = 0
    while i < tail {
        (*t).pre[first + n + i] = tmp_c[i]
        (*t).fb[first + n + i] = tmp_f[i]
        i = i + 1
    }
    (*t).pn = first + n + tail
    if caret > (*t).pn {
        (*t).caret = (*t).pn
    } else {
        (*t).caret = caret
    }
    pre_notify(t, was)
}

// the whole pre-edit text at once (Windows, Android, Wayland): `fbs` may be 0
fn text_preedit_set(t: *mut Text, cps: u64, n: usize, fbs: u64, caret: usize) {
    text_preedit_replace(t, 0, MAXPRE, cps, n, fbs, caret)
}

fn text_preedit_set_utf8(t: *mut Text, p: u64, n: usize, caret_cp: usize) {
    var buf: [u32; 256] = [0 as u32; 256]
    let m: usize = utf8_decode(p, n, (&buf[0]) as u64, MAXPRE)
    text_preedit_set(t, (&buf[0]) as u64, m, 0 as u64, caret_cp)
}

// move the caret only (XIM caret callback, Windows GCS_CURSORPOS)
fn text_preedit_caret(t: *mut Text, pos: usize) {
    if (*t).pn == 0 { return }
    if pos > (*t).pn {
        (*t).caret = (*t).pn
    } else {
        (*t).caret = pos
    }
    var none: [u32; 1] = [0 as u32; 1]
    q_push(t, TE_PREEDIT, (&none[0]) as u64, 0)
}

fn clear_compose(t: *mut Text) {
    (*t).cmode = 0 as u32
    (*t).cdead = 0 as u32
    (*t).cn = 0
}

// drop the pre-edit text without committing it (also ends a waiting dead key / Compose sequence)
fn text_preedit_cancel(t: *mut Text) {
    let was: usize = (*t).pn
    (*t).pn = 0
    (*t).caret = 0
    clear_compose(t)
    pre_notify(t, was)
}

// queue a commit (split into events of EVCP code points); the pre-edit text goes away first
fn text_commit(t: *mut Text, cps: u64, n: usize) {
    let was: usize = (*t).pn
    (*t).pn = 0
    (*t).caret = 0
    clear_compose(t)
    pre_notify(t, was)
    var i: usize = 0
    while i < n {
        var k: usize = n - i
        if k > EVCP { k = EVCP }
        q_push(t, TE_COMMIT, cps + (i * 4) as u64, k)
        i = i + k
    }
}

fn text_commit_utf8(t: *mut Text, p: u64, n: usize) {
    var buf: [u32; 512] = [0 as u32; 512]
    var done: usize = 0
    // long strings in pieces of at most 512 code points; a piece may split a multi-octet sequence only at a border we find
    while done < n {
        var chunk: usize = n - done
        if chunk > 512 { chunk = 512 }
        // do not cut inside a sequence
        if done + chunk < n {
            while chunk > 1 && (rt.ld8(p, done + chunk) & 192 as u8) == 128 as u8 {
                chunk = chunk - 1
            }
        }
        let m: usize = utf8_decode(p + done as u64, chunk, (&buf[0]) as u64, 512)
        text_commit(t, (&buf[0]) as u64, m)
        done = done + chunk
    }
}

// "finish composing" (Android finishComposingText, Windows CPS_COMPLETE): the pre-edit text becomes the commit
fn text_preedit_commit(t: *mut Text) {
    if (*t).pn == 0 { return }
    var buf: [u32; 256] = [0 as u32; 256]
    var i: usize = 0
    let n: usize = (*t).pn
    while i < n {
        buf[i] = (*t).pre[i]
        i = i + 1
    }
    text_commit(t, (&buf[0]) as u64, n)
}

// The text input field lost / got the focus: off drops everything pending.
fn text_set_active(t: *mut Text, on: bool) {
    if !on {
        text_preedit_cancel(t)
    }
    (*t).on = on
}

fn text_active(t: *mut Text) -> bool { return (*t).on }

fn text_reset(t: *mut Text) {
    text_preedit_cancel(t)
}

// ---- the text cursor rectangle -------------------------------------------------------------------------------------

// where the caret is, in window pixels (the IME puts its candidate window below it)
fn text_set_spot(t: *mut Text, x: i32, y: i32, w: i32, h: i32) {
    if (*t).sx != x || (*t).sy != y || (*t).sw != w || (*t).sh != h {
        (*t).sx = x
        (*t).sy = y
        (*t).sw = w
        (*t).sh = h
        (*t).spot_dirty = true
    }
}

fn text_spot(t: *mut Text, out: *mut [i32; 4]) {
    (*out)[0] = (*t).sx
    (*out)[1] = (*t).sy
    (*out)[2] = (*t).sw
    (*out)[3] = (*t).sh
}

// true once per change: the platform layer forwards the rectangle to the IME
fn text_spot_take(t: *mut Text, out: *mut [i32; 4]) -> bool {
    if !(*t).spot_dirty { return false }
    (*t).spot_dirty = false
    text_spot(t, out)
    return true
}

// ---- surrounding text ----------------------------------------------------------------------------------------------
//
// The text field tells the Text what stands around the caret (WITHOUT the pre-edit text): `text_set_surrounding(p, n, cursor,
// anchor)` with the whole field text as UTF-8 and octet offsets. At most SURMAX octets are kept: a window around the caret that
// starts and ends on code point borders (text_surround_base = octet offset of the window in the field). An IME that wants to delete
// text around the caret (Android deleteSurroundingText, Wayland delete_surrounding_text) calls text_delete_surrounding; the
// result is the event TE_DELETE_SURROUNDING (octets before / after the caret) that the field applies to its own buffer.

fn is_cont(b: u8) -> bool { return (b & 192 as u8) == 128 as u8 }

fn text_clear_surrounding(t: *mut Text) {
    (*t).sur_on = false
    (*t).sur_n = 0
    (*t).sur_cur = 0
    (*t).sur_anc = 0
    (*t).sur_base = 0
}

fn text_set_surrounding(t: *mut Text, p: u64, n: usize, cursor0: usize, anchor0: usize) {
    var cursor: usize = cursor0
    var anchor: usize = anchor0
    if cursor > n { cursor = n }
    if anchor > n { anchor = n }
    var a: usize = 0
    var b: usize = n
    if n > SURMAX {
        if cursor > SURMAX / 2 { a = cursor - SURMAX / 2 }
        b = a + SURMAX
        if b > n {
            b = n
            a = n - SURMAX
        }
        while a < n && is_cont(rt.ld8(p, a)) { a = a + 1 }
        while b > a && b < n && is_cont(rt.ld8(p, b)) { b = b - 1 }
    }
    if cursor < a { cursor = a }
    if cursor > b { cursor = b }
    if anchor < a { anchor = a }
    if anchor > b { anchor = b }
    var i: usize = 0
    while i < b - a {
        (*t).sur[i] = rt.ld8(p, a + i)
        i = i + 1
    }
    (*t).sur_n = b - a
    (*t).sur_cur = cursor - a
    (*t).sur_anc = anchor - a
    (*t).sur_base = a
    (*t).sur_on = true
}

fn text_surround_known(t: *mut Text) -> bool { return (*t).sur_on }
fn text_surround_len(t: *mut Text) -> usize { return (*t).sur_n }
fn text_surround_cursor(t: *mut Text) -> usize { return (*t).sur_cur }
fn text_surround_anchor(t: *mut Text) -> usize { return (*t).sur_anc }
fn text_surround_base(t: *mut Text) -> usize { return (*t).sur_base }

// copy the window (at most cap octets) to `out`; returns the octet count
fn text_surround_text(t: *mut Text, out: u64, cap: usize) -> usize {
    var n: usize = (*t).sur_n
    if n > cap { n = cap }
    var i: usize = 0
    while i < n {
        rt.st8(out, i, (*t).sur[i])
        i = i + 1
    }
    return n
}

// units from the window start to the cursor, as code points / UTF-16 units
fn units_before(t: *mut Text, utf16: bool) -> usize {
    var u: usize = 0
    var i: usize = 0
    while i < (*t).sur_cur {
        let b: u8 = (*t).sur[i]
        if !is_cont(b) {
            u = u + 1
            if utf16 && b >= 240 as u8 { u = u + 1 }
        }
        i = i + 1
    }
    return u
}
fn text_surround_cursor_cp(t: *mut Text) -> usize { return units_before(t, false) }
fn text_surround_cursor_utf16(t: *mut Text) -> usize { return units_before(t, true) }

fn seq_len(b: u8) -> usize {
    if b < 128 as u8 { return 1 }
    if b >= 240 as u8 { return 4 }
    if b >= 224 as u8 { return 3 }
    if b >= 192 as u8 { return 2 }
    return 1
}

// The IME wants `before` units deleted before the caret and `after` units behind it (units: SU_*). Clamped to the known window and
// never cut inside a code point (a UTF-16 pair that does not fit stays). Queues TE_DELETE_SURROUNDING with the octet counts and
// returns true if something is to be deleted. Without known surrounding text only SU_BYTES works (taken as asked).
fn text_delete_surrounding(t: *mut Text, before: usize, after: usize, unit: u32) -> bool {
    var nb: usize = 0
    var na: usize = 0
    if !(*t).sur_on {
        if unit != SU_BYTES { return false }
        nb = before
        na = after
    } else if unit == SU_BYTES {
        nb = before
        if nb > (*t).sur_cur { nb = (*t).sur_cur }
        while nb > 0 && is_cont((*t).sur[(*t).sur_cur - nb]) { nb = nb - 1 }
        na = after
        if na > (*t).sur_n - (*t).sur_cur { na = (*t).sur_n - (*t).sur_cur }
        while na > 0 && (*t).sur_cur + na < (*t).sur_n && is_cont((*t).sur[(*t).sur_cur + na]) { na = na - 1 }
    } else {
        var i: usize = (*t).sur_cur
        var count: usize = 0
        while i > 0 && count < before {
            var j: usize = i - 1
            while j > 0 && is_cont((*t).sur[j]) { j = j - 1 }
            var need: usize = 1
            if unit == SU_UTF16 && (*t).sur[j] >= 240 as u8 { need = 2 }
            if count + need > before { break }
            count = count + need
            i = j
        }
        nb = (*t).sur_cur - i
        var k: usize = (*t).sur_cur
        count = 0
        while k < (*t).sur_n && count < after {
            let l: usize = seq_len((*t).sur[k])
            var need2: usize = 1
            if unit == SU_UTF16 && l == 4 { need2 = 2 }
            if count + need2 > after || k + l > (*t).sur_n { break }
            count = count + need2
            k = k + l
        }
        na = k - (*t).sur_cur
    }
    if nb == 0 && na == 0 { return false }
    var ev: [u32; 2] = [0 as u32; 2]
    ev[0] = nb as u32
    ev[1] = na as u32
    q_push(t, TE_DELETE_SURROUNDING, (&ev[0]) as u64, 2)
    // the cached window follows the deletion, so a second request sees the new text
    if (*t).sur_on {
        let c: usize = (*t).sur_cur
        var w: usize = c - nb
        var r: usize = c + na
        while r < (*t).sur_n {
            (*t).sur[w] = (*t).sur[r]
            w = w + 1
            r = r + 1
        }
        (*t).sur_n = w
        (*t).sur_cur = c - nb
        (*t).sur_anc = (*t).sur_cur
    }
    return true
}

// ---- the compose engine --------------------------------------------------------------------------------------------

// show the typed part of a sequence / the spacing accent as pre-edit text
fn compose_show(t: *mut Text, cps: u64, n: usize) {
    let was: usize = (*t).pn
    var i: usize = 0
    while i < n {
        (*t).pre[i] = rt.ld32(cps, i)
        (*t).fb[i] = FB_UNDERLINE
        i = i + 1
    }
    (*t).pn = n
    (*t).caret = n
    pre_notify(t, was)
}

fn commit_one(t: *mut Text, a: u32) {
    var b: [u32; 2] = [0 as u32; 2]
    b[0] = a
    text_commit(t, (&b[0]) as u64, 1)
}

fn commit_two(t: *mut Text, a: u32, c: u32) {
    var b: [u32; 2] = [0 as u32; 2]
    b[0] = a
    b[1] = c
    text_commit(t, (&b[0]) as u64, 2)
}

fn start_dead(t: *mut Text, d: u32) {
    var b: [u32; 1] = [0 as u32; 1]
    b[0] = composedata.DEAD_SPACING[d as usize]
    (*t).cmode = 1 as u32
    (*t).cdead = d
    compose_show(t, (&b[0]) as u64, 1)
}

// One key press for the engine: `ks` = the keysym WITH modifiers applied (what the layout gives), `mods` = MOD_* bits.
// KR_PASS: not ours (a plain character with nothing pending, a non-character key with nothing pending, modifiers). KR_EAT:
// swallowed. KR_COMMIT: swallowed and a TE_COMMIT is queued (read it with text_event_next).
fn text_key(t: *mut Text, ks: u32, mods: u32) -> u32 {
    if !(*t).on {
        return KR_PASS
    }
    if is_modifier_keysym(ks) {
        return KR_PASS
    }
    let cm: u32 = (*t).cmode
    let held: bool = (mods & (MOD_CTRL | MOD_ALT)) != 0 as u32
    if cm == 0 as u32 {
        if held {
            return KR_PASS
        }
        let d: u32 = dead_index(ks)
        if d < 16 as u32 {
            start_dead(t, d)
            return KR_EAT
        }
        if ks == KS_MULTI_KEY {
            (*t).cmode = 2 as u32
            (*t).cn = 0
            return KR_EAT
        }
        return KR_PASS
    }
    if ks == KS_ESCAPE || ks == KS_BACKSPACE {
        text_preedit_cancel(t)
        return KR_EAT
    }
    if held {
        text_preedit_cancel(t)
        return KR_PASS
    }
    let cp: u32 = keysym_cp(ks)
    if cm == 1 as u32 {
        let d: u32 = (*t).cdead
        let sp: u32 = composedata.DEAD_SPACING[d as usize]
        let d2: u32 = dead_index(ks)
        if d2 < 16 as u32 {
            if d2 == d {
                commit_one(t, sp)
                return KR_COMMIT
            }
            // another accent: the first one stays as a spacing letter, the new one waits
            commit_one(t, sp)
            start_dead(t, d2)
            return KR_COMMIT
        }
        if cp == 0 as u32 {
            // a key without a character (arrows, Return ...): the accent is typed as it is, the key goes on
            commit_one(t, sp)
            return KR_PASS
        }
        if cp == 32 as u32 {
            commit_one(t, sp)
            return KR_COMMIT
        }
        let r: u32 = dead_lookup(d, cp)
        if r != 0 as u32 {
            commit_one(t, r)
        } else {
            commit_two(t, sp, cp)
        }
        return KR_COMMIT
    }
    // Compose-key sequence
    if cp < 32 as u32 || cp > 126 as u32 {
        text_preedit_cancel(t)
        if cp == 0 as u32 && dead_index(ks) >= 16 as u32 {
            return KR_PASS
        }
        return KR_EAT
    }
    if (*t).cn >= 3 {
        text_preedit_cancel(t)
        return KR_EAT
    }
    (*t).ck[(*t).cn] = cp
    (*t).cn = (*t).cn + 1
    let k1: u32 = (*t).ck[0]
    var k2: u32 = 0 as u32
    var k3: u32 = 0 as u32
    if (*t).cn >= 2 { k2 = (*t).ck[1] }
    if (*t).cn >= 3 { k3 = (*t).ck[2] }
    let key: u32 = (k1 << 14 as u32) | (k2 << 7 as u32) | k3
    if (*t).cn >= 2 {
        let r: u32 = seq_lookup(key)
        if r != 0 as u32 {
            commit_one(t, r)
            return KR_COMMIT
        }
    }
    var more: bool = false
    if (*t).cn == 1 {
        more = seq_any(k1 << 14 as u32, (k1 + 1 as u32) << 14 as u32)
    } else if (*t).cn == 2 {
        more = seq_any(key + 1 as u32, key + 128 as u32)
    }
    if more {
        var b: [u32; 3] = [0 as u32; 3]
        b[0] = (*t).ck[0]
        b[1] = (*t).ck[1]
        b[2] = (*t).ck[2]
        let n: usize = (*t).cn
        compose_show(t, (&b[0]) as u64, n)
        return KR_EAT
    }
    text_preedit_cancel(t)
    return KR_EAT
}
