import docview.pdf.pdffonts_data

export { face_ptr, face_len, FACE_COUNT }

const FACE_COUNT: usize = 11

#[no_gc]
fn face_ptr(i: usize) -> u64 {
    if i >= FACE_COUNT {
        return 0
    }
    return pdffonts_data.pdffont_ptr(i)
}

#[no_gc]
fn face_len(i: usize) -> usize {
    if i >= FACE_COUNT {
        return 0
    }
    return pdffonts_data.pdffont_len(i)
}
