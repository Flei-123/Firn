// SPDX-License-Identifier: MPL-2.0
export {
    KIND_UNKNOWN, KIND_PDF, KIND_DOCX, KIND_XLSX, KIND_PPTX, KIND_ODT, KIND_ZIP,
    KIND_PNG, KIND_JPEG, KIND_WEBP, KIND_GIF, KIND_JXL, KIND_AVIF, KIND_SVG,
    KIND_MP3, KIND_OGG, KIND_OPUS, KIND_FLAC, KIND_WAV, KIND_M4A, KIND_MP4, KIND_WEBM,
    KIND_MARKDOWN, KIND_TEXT, KIND_CODE, KIND_COUNT,
    FAMILY_UNKNOWN, FAMILY_DOCUMENT, FAMILY_IMAGE, FAMILY_AUDIO, FAMILY_VIDEO, FAMILY_TEXT,
    kind_name, kind_family,
}

const KIND_UNKNOWN: u32 = 0
const KIND_PDF: u32 = 1
const KIND_DOCX: u32 = 2
const KIND_XLSX: u32 = 3
const KIND_PPTX: u32 = 4
const KIND_ODT: u32 = 5
const KIND_ZIP: u32 = 6
const KIND_PNG: u32 = 7
const KIND_JPEG: u32 = 8
const KIND_WEBP: u32 = 9
const KIND_GIF: u32 = 10
const KIND_JXL: u32 = 11
const KIND_AVIF: u32 = 12
const KIND_SVG: u32 = 13
const KIND_MP3: u32 = 14
const KIND_OGG: u32 = 15
const KIND_OPUS: u32 = 16
const KIND_FLAC: u32 = 17
const KIND_WAV: u32 = 18
const KIND_M4A: u32 = 19
const KIND_MP4: u32 = 20
const KIND_WEBM: u32 = 21
const KIND_MARKDOWN: u32 = 22
const KIND_TEXT: u32 = 23
const KIND_CODE: u32 = 24
const KIND_COUNT: u32 = 25

const FAMILY_UNKNOWN: u32 = 0
const FAMILY_DOCUMENT: u32 = 1
const FAMILY_IMAGE: u32 = 2
const FAMILY_AUDIO: u32 = 3
const FAMILY_VIDEO: u32 = 4
const FAMILY_TEXT: u32 = 5

fn kind_name(k: u32) -> str {
    if k == KIND_PDF { return "pdf" }
    if k == KIND_DOCX { return "docx" }
    if k == KIND_XLSX { return "xlsx" }
    if k == KIND_PPTX { return "pptx" }
    if k == KIND_ODT { return "odt" }
    if k == KIND_ZIP { return "zip" }
    if k == KIND_PNG { return "png" }
    if k == KIND_JPEG { return "jpeg" }
    if k == KIND_WEBP { return "webp" }
    if k == KIND_GIF { return "gif" }
    if k == KIND_JXL { return "jxl" }
    if k == KIND_AVIF { return "avif" }
    if k == KIND_SVG { return "svg" }
    if k == KIND_MP3 { return "mp3" }
    if k == KIND_OGG { return "ogg" }
    if k == KIND_OPUS { return "opus" }
    if k == KIND_FLAC { return "flac" }
    if k == KIND_WAV { return "wav" }
    if k == KIND_M4A { return "m4a" }
    if k == KIND_MP4 { return "mp4" }
    if k == KIND_WEBM { return "webm" }
    if k == KIND_MARKDOWN { return "markdown" }
    if k == KIND_TEXT { return "text" }
    if k == KIND_CODE { return "code" }
    return "unknown"
}

fn kind_family(k: u32) -> u32 {
    if k >= KIND_PDF && k <= KIND_ODT { return FAMILY_DOCUMENT }
    if k >= KIND_PNG && k <= KIND_SVG { return FAMILY_IMAGE }
    if k >= KIND_MP3 && k <= KIND_M4A { return FAMILY_AUDIO }
    if k == KIND_MP4 || k == KIND_WEBM { return FAMILY_VIDEO }
    if k >= KIND_MARKDOWN && k <= KIND_CODE { return FAMILY_TEXT }
    return FAMILY_UNKNOWN
}
