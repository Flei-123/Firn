// SPDX-License-Identifier: MPL-2.0
import std.rt

export { resample_rgba }

fn lerp_channel(a: u32, b: u32, c: u32, d: u32, fx: u32, fy: u32) -> u32 {
    let top: u32 = a * (256 as u32 - fx) + b * fx
    let bot: u32 = c * (256 as u32 - fx) + d * fx
    return (top * (256 as u32 - fy) + bot * fy) >> 16
}

fn resample_rgba(src: u64, sw: usize, sh: usize, out: *mut rt.Buf, dw: usize, dh: usize) -> bool {
    if src == 0 || sw == 0 || sh == 0 || dw == 0 || dh == 0 || (dw as u64) * (dh as u64) > 67108864 {
        return false
    }
    rt.buf_reserve(out, dw * dh * 4)
    var y: usize = 0
    while y < dh {
        let fy: u64 = ((y as u64) * 2 + 1) * (sh as u64) * 128 / (dh as u64)
        var sy: u64 = 0
        if fy >= 128 { sy = fy - 128 }
        var y0: usize = (sy >> 8) as usize
        let wy: u32 = (sy & 255 as u64) as u32
        if y0 >= sh { y0 = sh - 1 }
        var y1: usize = y0 + 1
        if y1 >= sh { y1 = sh - 1 }
        var x: usize = 0
        while x < dw {
            let fx: u64 = ((x as u64) * 2 + 1) * (sw as u64) * 128 / (dw as u64)
            var sx: u64 = 0
            if fx >= 128 { sx = fx - 128 }
            var x0: usize = (sx >> 8) as usize
            let wx: u32 = (sx & 255 as u64) as u32
            if x0 >= sw { x0 = sw - 1 }
            var x1: usize = x0 + 1
            if x1 >= sw { x1 = sw - 1 }
            var ch: usize = 0
            while ch < 4 {
                let a: u32 = rt.ld8(src, (y0 * sw + x0) * 4 + ch) as u32
                let b: u32 = rt.ld8(src, (y0 * sw + x1) * 4 + ch) as u32
                let c: u32 = rt.ld8(src, (y1 * sw + x0) * 4 + ch) as u32
                let d: u32 = rt.ld8(src, (y1 * sw + x1) * 4 + ch) as u32
                rt.buf_push(out, lerp_channel(a, b, c, d, wx, wy) as u8)
                ch++
            }
            x++
        }
        y++
    }
    return rt.buf_len(out) == dw * dh * 4
}
