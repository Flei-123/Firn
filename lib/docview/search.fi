// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.vec
import docview.doc

export { Hit, search_run, hit_after, hit_before, SEARCH_MAX_HITS }

const SEARCH_MAX_HITS: usize = 10000

struct Hit {
    page: usize,
    off: usize,
    len: usize,
}

fn fold(c: u8) -> u8 {
    if c >= 65 as u8 && c <= 90 as u8 {
        return c + 32 as u8
    }
    return c
}

fn matches_at(p: u64, n: usize, at: usize, q: str) -> bool {
    var k: usize = 0
    while k < q.n {
        if fold(rt.ld8(p, at + k)) != fold(rt.ld8(q.p as u64, k)) {
            return false
        }
        k++
    }
    return at + q.n <= n
}

fn search_page(p: u64, n: usize, q: str, page: usize, out: *mut Vec[Hit]) {
    var i: usize = 0
    while i + q.n <= n && vec_len[Hit](out) < SEARCH_MAX_HITS {
        if matches_at(p, n, i, q) {
            vec_push[Hit](out, Hit { page: page, off: i, len: q.n })
            i = i + q.n
        } else {
            i++
        }
    }
}

fn search_run(d: *mut doc.Doc, query: str, out: *mut Vec[Hit]) -> usize {
    vec_clear[Hit](out)
    if query.n == 0 || !doc.doc_ok(d) {
        return 0
    }
    var buf: rt.Buf = rt.buf_new()
    let pages: usize = doc.doc_pages(d)
    var pg: usize = 0
    while pg < pages && vec_len[Hit](out) < SEARCH_MAX_HITS {
        rt.buf_clear(&buf)
        if doc.doc_text(d, pg, &buf) {
            search_page(rt.buf_ptr(&buf), rt.buf_len(&buf), query, pg, out)
        }
        pg++
    }
    rt.buf_free(&buf)
    return vec_len[Hit](out)
}

fn hit_after(hits: *mut Vec[Hit], page: usize, off: usize) -> i64 {
    let n: usize = vec_len[Hit](hits)
    if n == 0 {
        return -1
    }
    var i: usize = 0
    while i < n {
        let h: *mut Hit = vec_elem_ptr[Hit](hits, i)
        if (*h).page > page || ((*h).page == page && (*h).off > off) {
            return i as i64
        }
        i++
    }
    return 0
}

fn hit_before(hits: *mut Vec[Hit], page: usize, off: usize) -> i64 {
    let n: usize = vec_len[Hit](hits)
    if n == 0 {
        return -1
    }
    var i: usize = n
    while i > 0 {
        i--
        let h: *mut Hit = vec_elem_ptr[Hit](hits, i)
        if (*h).page < page || ((*h).page == page && (*h).off < off) {
            return i as i64
        }
    }
    return (n - 1) as i64
}
