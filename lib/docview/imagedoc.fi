// SPDX-License-Identifier: MPL-2.0
import std.rt
import docview.obj
import image.picture
import docview.registry
import docview.kinds

export { image_ops, image_install_png, image_install_jpeg, image_install_webp, image_install_gif }

const IMAGE_MAX_SIDE: i32 = 16384

struct ImageDoc {
    pic: picture.Picture,
}

fn image_open(p: u64, n: usize) -> u64 {
    let im: picture.Picture = picture.from_bytes(p, n)
    var keep: picture.Picture = im
    if !picture.ok(&keep) {
        picture.free(&keep)
        return 0
    }
    let raw: u64 = obj.obj_alloc[ImageDoc]()
    if raw == 0 {
        picture.free(&keep)
        return 0
    }
    (*(raw as *mut ImageDoc)).pic = keep
    return raw
}

fn image_pages(h: u64) -> usize {
    return 1
}

fn image_size(h: u64, page: usize, w: *mut i32, hh: *mut i32) -> bool {
    let d: *mut ImageDoc = h as *mut ImageDoc
    *w = picture.width(&(*d).pic) as i32
    *hh = picture.height(&(*d).pic) as i32
    return true
}

fn scaled_side(v: usize, scale: f64) -> i32 {
    var s: f64 = (v as f64) * scale + 0.5
    if s < 1.0 {
        s = 1.0
    }
    if s > (IMAGE_MAX_SIDE as f64) {
        s = IMAGE_MAX_SIDE as f64
    }
    return s as i32
}

fn image_render(h: u64, page: usize, scale: f64, out: *mut rt.Buf, w: *mut i32, hh: *mut i32) -> bool {
    let d: *mut ImageDoc = h as *mut ImageDoc
    let tw: i32 = scaled_side(picture.width(&(*d).pic), scale)
    let th: i32 = scaled_side(picture.height(&(*d).pic), scale)
    var rs: picture.Picture = picture.resized(&(*d).pic, tw as usize, th as usize)
    if !picture.ok(&rs) {
        picture.free(&rs)
        return false
    }
    rt.buf_push_bytes(out, picture.pixels(&rs), (tw as usize) * (th as usize) * 4)
    picture.free(&rs)
    *w = tw
    *hh = th
    return true
}

fn image_text(h: u64, page: usize, out: *mut rt.Buf) -> bool {
    return false
}

fn image_free(h: u64) {
    let d: *mut ImageDoc = h as *mut ImageDoc
    picture.free(&(*d).pic)
    obj.obj_free[ImageDoc](h)
}

fn image_ops() -> registry.DocOps {
    var o: registry.DocOps = registry.ops_empty()
    o.open = image_open
    o.pages = image_pages
    o.page_size = image_size
    o.render = image_render
    o.text = image_text
    o.free = image_free
    return o
}

fn image_install_png() {
    registry.register("image.png", kinds.KIND_PNG, image_ops())
}

fn image_install_jpeg() {
    registry.register("image.jpeg", kinds.KIND_JPEG, image_ops())
}

fn image_install_webp() {
    registry.register("image.webp", kinds.KIND_WEBP, image_ops())
}

fn image_install_gif() {
    registry.register("image.gif", kinds.KIND_GIF, image_ops())
}
