// SPDX-License-Identifier: MPL-2.0
import std.rt
import docview.obj
import docview.registry
import docview.kinds

export { FlowDoc, flow_ops, flow_install_text, flow_install_code, flow_install_markdown, FLOW_CELL_W, FLOW_CELL_H, flow_lines }

const FLOW_CELL_W: i32 = 8
const FLOW_CELL_H: i32 = 16
const FLOW_MAX_BYTES: usize = 67108864

struct FlowDoc {
    src: rt.Buf,
    lines: usize,
    cols: usize,
}

fn flow_lines(h: u64) -> usize {
    return (*(h as *mut FlowDoc)).lines
}

fn flow_open(p: u64, n: usize) -> u64 {
    if n > FLOW_MAX_BYTES {
        return 0
    }
    let raw: u64 = obj.obj_alloc[FlowDoc]()
    if raw == 0 {
        return 0
    }
    let d: *mut FlowDoc = raw as *mut FlowDoc
    (*d).src = rt.buf_new()
    rt.buf_push_bytes(&(*d).src, p, n)
    var lines: usize = 1
    var cols: usize = 0
    var widest: usize = 0
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c == 10 as u8 {
            lines++
            cols = 0
        } else {
            if (c & 192 as u8) != 128 as u8 {
                cols++
                if cols > widest {
                    widest = cols
                }
            }
        }
        i++
    }
    (*d).lines = lines
    (*d).cols = widest
    return raw
}

fn flow_pages(h: u64) -> usize {
    return 1
}

fn flow_size(h: u64, page: usize, w: *mut i32, hh: *mut i32) -> bool {
    let d: *mut FlowDoc = h as *mut FlowDoc
    var cols: usize = (*d).cols
    if cols > 4096 {
        cols = 4096
    }
    var lines: usize = (*d).lines
    if lines > 1048576 {
        lines = 1048576
    }
    *w = (cols as i32) * FLOW_CELL_W
    *hh = (lines as i32) * FLOW_CELL_H
    return true
}

fn flow_render(h: u64, page: usize, scale: f64, out: *mut rt.Buf, w: *mut i32, hh: *mut i32) -> bool {
    return false
}

fn flow_text(h: u64, page: usize, out: *mut rt.Buf) -> bool {
    let d: *mut FlowDoc = h as *mut FlowDoc
    rt.buf_push_bytes(out, rt.buf_ptr(&(*d).src), rt.buf_len(&(*d).src))
    return true
}

fn flow_free(h: u64) {
    let d: *mut FlowDoc = h as *mut FlowDoc
    rt.buf_free(&(*d).src)
    obj.obj_free[FlowDoc](h)
}

fn flow_ops() -> registry.DocOps {
    var o: registry.DocOps = registry.ops_empty()
    o.open = flow_open
    o.pages = flow_pages
    o.page_size = flow_size
    o.render = flow_render
    o.text = flow_text
    o.free = flow_free
    return o
}

fn flow_install_text() {
    registry.register("flow.text", kinds.KIND_TEXT, flow_ops())
}

fn flow_install_code() {
    registry.register("flow.code", kinds.KIND_CODE, flow_ops())
}

fn flow_install_markdown() {
    registry.register("flow.markdown", kinds.KIND_MARKDOWN, flow_ops())
}
