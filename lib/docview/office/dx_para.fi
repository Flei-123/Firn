import std.rt
import std.xml
import std.vec
import docview.office.ooxml
import docview.office.dx_props
import docview.office.dx_pr
import docview.office.dx_style
import docview.office.dx_num
import docview.office.dx_model
import docview.office.dx_ctx
import docview.office.dx_inline

export { parse_para }

fn parse_para(c: *mut dx_ctx.Ctx, d: *mut dx_model.Docx, x: *mut xml.Doc, p: u32) -> u32 {
    var rp: dx_props.RunProps = dx_props.rp_unset()
    var pp: dx_props.ParaProps = dx_props.pp_unset()
    let ppr: u32 = ooxml.child_l(x, p, "pPr")
    var sid: str = ""
    if ppr != xml.NONE {
        let ps: u32 = ooxml.child_l(x, ppr, "pStyle")
        if ps != xml.NONE {
            sid = ooxml.attr_l(x, ps, "val")
        }
    }
    dx_style.resolve_para(&(*c).st, sid, &rp, &pp)
    dx_pr.read_ppr(x, ppr, &pp)
    var label: rt.Buf = rt.buf_new()
    defer rt.buf_free(&label)
    var info: dx_num.LabelInfo = dx_num.LabelInfo { left: 0, hang: 0, ok: false }
    if pp.num_id > 0 {
        info = dx_num.numbering_label(&(*c).nm, pp.num_id, pp.ilvl, &label)
    }
    if info.ok {
        if pp.left == dx_props.UNSET_T {
            pp.left = info.left
        }
        if pp.first == dx_props.UNSET_T {
            pp.first = 0 - info.hang
        }
    }
    dx_props.pp_finish(&pp)
    var finished: dx_props.RunProps = rp
    dx_props.rp_finish(&finished)
    if vec_len_paras(d) >= dx_model.MAX_PARAS {
        (*d).truncated = true
        return dx_model.NIL
    }
    let idx: u32 = dx_model.new_para(d, pp)
    let pa: *mut dx_model.Para = dx_model.para_at(d, idx)
    (*pa).base_rp = finished
    if info.ok {
        (*pa).has_label = true
        (*pa).lab_off = dx_model.pool_add(d, rt.buf_ptr(&label), rt.buf_len(&label))
        (*pa).lab_n = rt.buf_len(&label) as u32
        (*pa).lab_left = info.left
        (*pa).lab_hang = info.hang
    }
    var st: dx_inline.ParaState = dx_inline.para_state_new(idx, rp)
    dx_inline.parse_inline(c, d, x, p, &st, 0)
    let pb: *mut dx_model.Para = dx_model.para_at(d, idx)
    (*pb).rcount = (vec_len_runs(d) as u32) - (*pb).rfirst
    return idx
}

fn vec_len_paras(d: *mut dx_model.Docx) -> usize {
    return vec_len[dx_model.Para](&(*d).paras)
}

fn vec_len_runs(d: *mut dx_model.Docx) -> usize {
    return vec_len[dx_model.Run](&(*d).runs)
}
