// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.vec
import docview.office.dx_props

export {
    Run, Para, Cell, Row, Table, Block, BList, Sect, HeaderFooter, Image, Docx,
    R_TEXT, R_TAB, R_BREAK, R_IMAGE, R_FIELD, BR_LINE, BR_PAGE, BR_COLUMN, FLD_PAGE, FLD_NUMPAGES,
    B_PARA, B_TABLE, NIL, MAX_RUNS, MAX_PARAS, MAX_CELLS,
    docx_new, docx_free, pool_add, pool_str, blist_new, blist_push, block_add,
    new_para, new_table, new_row, new_cell, new_image, new_hf, new_sect,
    para_at, table_at, row_at, cell_at, block_at, sect_at, hf_at, image_at, run_at, run_add, runs_of,
    tw_to_px,
}

const NIL: u32 = 4294967295
const R_TEXT: u32 = 0
const R_TAB: u32 = 1
const R_BREAK: u32 = 2
const R_IMAGE: u32 = 3
const R_FIELD: u32 = 4
const BR_LINE: i64 = 0
const BR_PAGE: i64 = 1
const BR_COLUMN: i64 = 2
const FLD_PAGE: i64 = 1
const FLD_NUMPAGES: i64 = 2
const B_PARA: u32 = 0
const B_TABLE: u32 = 1
const MAX_RUNS: usize = 4000000
const MAX_PARAS: usize = 1500000
const MAX_CELLS: usize = 1500000

struct Run {
    kind: u32,
    rp: dx_props.RunProps,
    toff: u32,
    tn: u32,
    a: i64,
    w: f64,
    h: f64,
}

struct Para {
    pp: dx_props.ParaProps,
    rfirst: u32,
    rcount: u32,
    lab_off: u32,
    lab_n: u32,
    base_rp: dx_props.RunProps,
    lab_left: i32,
    lab_hang: i32,
    has_label: bool,
}

struct Block {
    kind: u32,
    idx: u32,
    next: u32,
    sect: u32,
}

struct BList {
    head: u32,
    tail: u32,
}

struct Cell {
    span: i32,
    vmerge: i32,
    width: i32,
    shade: u32,
    bt: dx_props.Border,
    bl: dx_props.Border,
    bb: dx_props.Border,
    br: dx_props.Border,
    blocks: BList,
    next: u32,
}

struct Row {
    height: i32,
    exact: bool,
    header: bool,
    cells_head: u32,
    cells_tail: u32,
    next: u32,
}

struct Table {
    tp: dx_props.TblProps,
    goff: u32,
    gn: u32,
    rows_head: u32,
    rows_tail: u32,
}

struct Sect {
    w: i32,
    h: i32,
    ml: i32,
    mr: i32,
    mt: i32,
    mb: i32,
    header_dist: i32,
    footer_dist: i32,
    hdr_default: i32,
    hdr_first: i32,
    ftr_default: i32,
    ftr_first: i32,
    title_pg: bool,
    new_page: bool,
}

struct HeaderFooter {
    name_off: u32,
    name_n: u32,
    blocks: BList,
}

struct Image {
    name_off: u32,
    name_n: u32,
}

struct Docx {
    pool: rt.Buf,
    runs: Vec[Run],
    paras: Vec[Para],
    blocks: Vec[Block],
    tables: Vec[Table],
    rows: Vec[Row],
    cells: Vec[Cell],
    grid: Vec[i32],
    sects: Vec[Sect],
    hfs: Vec[HeaderFooter],
    images: Vec[Image],
    body: BList,
    truncated: bool,
}

fn docx_new() -> Docx {
    return Docx { pool: rt.buf_new(), runs: vec_new[Run](), paras: vec_new[Para](), blocks: vec_new[Block](),
        tables: vec_new[Table](), rows: vec_new[Row](), cells: vec_new[Cell](), grid: vec_new[i32](),
        sects: vec_new[Sect](), hfs: vec_new[HeaderFooter](), images: vec_new[Image](),
        body: blist_new(), truncated: false }
}

fn docx_free(d: *mut Docx) {
    rt.buf_free(&(*d).pool)
    vec_free[Run](&(*d).runs)
    vec_free[Para](&(*d).paras)
    vec_free[Block](&(*d).blocks)
    vec_free[Table](&(*d).tables)
    vec_free[Row](&(*d).rows)
    vec_free[Cell](&(*d).cells)
    vec_free[i32](&(*d).grid)
    vec_free[Sect](&(*d).sects)
    vec_free[HeaderFooter](&(*d).hfs)
    vec_free[Image](&(*d).images)
}

fn tw_to_px(tw: i32) -> f64 {
    return (tw as f64) / 15.0
}

fn pool_add(d: *mut Docx, p: u64, n: usize) -> u32 {
    let off: usize = rt.buf_len(&(*d).pool)
    rt.buf_push_bytes(&(*d).pool, p, n)
    return off as u32
}

fn pool_str(d: *mut Docx, off: u32, n: u32) -> str {
    return str { p: rt.ptr_of(rt.buf_ptr(&(*d).pool) + (off as u64)), n: n as usize }
}

fn blist_new() -> BList {
    return BList { head: NIL, tail: NIL }
}

fn block_at(d: *mut Docx, i: u32) -> *mut Block {
    return vec_elem_ptr[Block](&(*d).blocks, i as usize)
}

fn blist_push(d: *mut Docx, l: *mut BList, b: u32) {
    if (*l).tail == NIL {
        (*l).head = b
    } else {
        (*block_at(d, (*l).tail)).next = b
    }
    (*l).tail = b
}

fn block_add(d: *mut Docx, l: *mut BList, kind: u32, idx: u32, sect: u32) -> u32 {
    let i: u32 = vec_len[Block](&(*d).blocks) as u32
    vec_push[Block](&(*d).blocks, Block { kind: kind, idx: idx, next: NIL, sect: sect })
    blist_push(d, l, i)
    return i
}

fn para_at(d: *mut Docx, i: u32) -> *mut Para { return vec_elem_ptr[Para](&(*d).paras, i as usize) }
fn table_at(d: *mut Docx, i: u32) -> *mut Table { return vec_elem_ptr[Table](&(*d).tables, i as usize) }
fn row_at(d: *mut Docx, i: u32) -> *mut Row { return vec_elem_ptr[Row](&(*d).rows, i as usize) }
fn cell_at(d: *mut Docx, i: u32) -> *mut Cell { return vec_elem_ptr[Cell](&(*d).cells, i as usize) }
fn sect_at(d: *mut Docx, i: u32) -> *mut Sect { return vec_elem_ptr[Sect](&(*d).sects, i as usize) }
fn hf_at(d: *mut Docx, i: u32) -> *mut HeaderFooter { return vec_elem_ptr[HeaderFooter](&(*d).hfs, i as usize) }
fn image_at(d: *mut Docx, i: u32) -> *mut Image { return vec_elem_ptr[Image](&(*d).images, i as usize) }
fn run_at(d: *mut Docx, i: u32) -> *mut Run { return vec_elem_ptr[Run](&(*d).runs, i as usize) }

fn runs_of(d: *mut Docx, p: *mut Para, k: u32) -> *mut Run {
    return run_at(d, (*p).rfirst + k)
}

fn run_add(d: *mut Docx, r: Run) -> bool {
    if vec_len[Run](&(*d).runs) >= MAX_RUNS {
        (*d).truncated = true
        return false
    }
    return vec_push[Run](&(*d).runs, r)
}

fn new_para(d: *mut Docx, pp: dx_props.ParaProps) -> u32 {
    let i: u32 = vec_len[Para](&(*d).paras) as u32
    vec_push[Para](&(*d).paras, Para { pp: pp, rfirst: vec_len[Run](&(*d).runs) as u32, rcount: 0 as u32,
        lab_off: 0 as u32, lab_n: 0 as u32, base_rp: dx_props.rp_unset(), lab_left: 0, lab_hang: 0, has_label: false })
    return i
}

fn new_table(d: *mut Docx, tp: dx_props.TblProps) -> u32 {
    let i: u32 = vec_len[Table](&(*d).tables) as u32
    vec_push[Table](&(*d).tables, Table { tp: tp, goff: vec_len[i32](&(*d).grid) as u32, gn: 0 as u32,
        rows_head: NIL, rows_tail: NIL })
    return i
}

fn new_row(d: *mut Docx, t: u32) -> u32 {
    let i: u32 = vec_len[Row](&(*d).rows) as u32
    vec_push[Row](&(*d).rows, Row { height: 0, exact: false, header: false, cells_head: NIL, cells_tail: NIL, next: NIL })
    let tb: *mut Table = table_at(d, t)
    if (*tb).rows_tail == NIL {
        (*tb).rows_head = i
    } else {
        (*row_at(d, (*tb).rows_tail)).next = i
    }
    (*tb).rows_tail = i
    return i
}

fn new_cell(d: *mut Docx, r: u32) -> u32 {
    let i: u32 = vec_len[Cell](&(*d).cells) as u32
    vec_push[Cell](&(*d).cells, Cell { span: 1, vmerge: 0, width: 0, shade: 0 as u32,
        bt: dx_props.border_unset(), bl: dx_props.border_unset(), bb: dx_props.border_unset(), br: dx_props.border_unset(),
        blocks: blist_new(), next: NIL })
    let rw: *mut Row = row_at(d, r)
    if (*rw).cells_tail == NIL {
        (*rw).cells_head = i
    } else {
        (*cell_at(d, (*rw).cells_tail)).next = i
    }
    (*rw).cells_tail = i
    return i
}

fn new_image(d: *mut Docx, name: str) -> u32 {
    var i: usize = 0
    let n: usize = vec_len[Image](&(*d).images)
    while i < n {
        let im: *mut Image = image_at(d, i as u32)
        if pool_str(d, (*im).name_off, (*im).name_n) == name {
            return i as u32
        }
        i = i + 1
    }
    let off: u32 = pool_add(d, name.p as u64, name.n)
    vec_push[Image](&(*d).images, Image { name_off: off, name_n: name.n as u32 })
    return n as u32
}

fn new_hf(d: *mut Docx, name: str) -> u32 {
    var i: usize = 0
    let n: usize = vec_len[HeaderFooter](&(*d).hfs)
    while i < n {
        let h: *mut HeaderFooter = hf_at(d, i as u32)
        if pool_str(d, (*h).name_off, (*h).name_n) == name {
            return i as u32
        }
        i = i + 1
    }
    let off: u32 = pool_add(d, name.p as u64, name.n)
    vec_push[HeaderFooter](&(*d).hfs, HeaderFooter { name_off: off, name_n: name.n as u32, blocks: blist_new() })
    return n as u32
}

fn new_sect(d: *mut Docx) -> u32 {
    let i: u32 = vec_len[Sect](&(*d).sects) as u32
    vec_push[Sect](&(*d).sects, Sect { w: 11906, h: 16838, ml: 1440, mr: 1440, mt: 1440, mb: 1440,
        header_dist: 708, footer_dist: 708, hdr_default: -1, hdr_first: -1, ftr_default: -1, ftr_first: -1,
        title_pg: false, new_page: true })
    return i
}
