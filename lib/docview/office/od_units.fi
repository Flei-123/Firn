import std.rt
import docview.office.ooxml

export { parse_num, len_tw, len_f, percent, color, rest_of, clamp_i, token }

fn clamp_i(v: i64, lo: i64, hi: i64) -> i64 {
    if v < lo { return lo }
    if v > hi { return hi }
    return v
}

fn parse_num(s: str, end: *mut usize) -> f64 {
    var i: usize = 0
    var sign: f64 = 1.0
    if i < s.n && rt.ld8(s.p as u64, i) == (45 as u8) {
        sign = -1.0
        i = i + 1
    } else if i < s.n && rt.ld8(s.p as u64, i) == (43 as u8) {
        i = i + 1
    }
    var v: f64 = 0.0
    var digits: usize = 0
    while i < s.n {
        let c: u8 = rt.ld8(s.p as u64, i)
        if c < (48 as u8) || c > (57 as u8) {
            break
        }
        v = v * 10.0 + ((c - (48 as u8)) as f64)
        i = i + 1
        digits = digits + 1
    }
    if i < s.n && rt.ld8(s.p as u64, i) == (46 as u8) {
        i = i + 1
        var scale: f64 = 0.1
        while i < s.n {
            let c2: u8 = rt.ld8(s.p as u64, i)
            if c2 < (48 as u8) || c2 > (57 as u8) {
                break
            }
            v = v + ((c2 - (48 as u8)) as f64) * scale
            scale = scale / 10.0
            i = i + 1
            digits = digits + 1
        }
    }
    if digits == 0 {
        *end = 0
        return 0.0
    }
    if v > 1000000000.0 { v = 1000000000.0 }
    *end = i
    return sign * v
}

fn rest_of(s: str, at: usize) -> str {
    return str { p: rt.ptr_of((s.p as u64) + (at as u64)), n: s.n - at }
}

fn len_f(s: str, dflt: f64) -> f64 {
    if s.n == 0 {
        return dflt
    }
    var e: usize = 0
    let v: f64 = parse_num(s, &e)
    if e == 0 {
        return dflt
    }
    let u: str = rest_of(s, e)
    if u == "cm" { return v * 566.929 }
    if u == "mm" { return v * 56.6929 }
    if u == "in" { return v * 1440.0 }
    if u == "pt" { return v * 20.0 }
    if u == "pc" { return v * 240.0 }
    if u == "px" { return v * 15.0 }
    if u.n == 0 { return v * 20.0 }
    return dflt
}

fn len_tw(s: str, dflt: i64) -> i64 {
    if s.n == 0 {
        return dflt
    }
    let f: f64 = len_f(s, -123456789.0)
    if f == -123456789.0 {
        return dflt
    }
    var r: f64 = f
    if r > 200000000.0 { r = 200000000.0 }
    if r < -200000000.0 { r = -200000000.0 }
    if r < 0.0 {
        return 0 - ((0.5 - r) as i64)
    }
    return (r + 0.5) as i64
}

fn percent(s: str) -> f64 {
    if s.n < 2 || rt.ld8(s.p as u64, s.n - 1) != (37 as u8) {
        return -1.0
    }
    var e: usize = 0
    let v: f64 = parse_num(str { p: s.p, n: s.n - 1 }, &e)
    if e == 0 || e != s.n - 1 {
        return -1.0
    }
    return v
}

fn color(s: str) -> u32 {
    if s.n != 7 || rt.ld8(s.p as u64, 0) != (35 as u8) {
        return 0 as u32
    }
    var v: u32 = 0
    var i: usize = 1
    while i < 7 {
        var h: i32 = -1
        let c: u8 = rt.ld8(s.p as u64, i)
        if c >= (48 as u8) && c <= (57 as u8) {
            h = (c - (48 as u8)) as i32
        } else if c >= (97 as u8) && c <= (102 as u8) {
            h = (c - (97 as u8)) as i32 + 10
        } else if c >= (65 as u8) && c <= (70 as u8) {
            h = (c - (65 as u8)) as i32 + 10
        }
        if h < 0 {
            return 0 as u32
        }
        v = (v << 4 as u32) | (h as u32)
        i = i + 1
    }
    let r: u32 = (v >> 16 as u32) & 255 as u32
    let g: u32 = (v >> 8 as u32) & 255 as u32
    let b: u32 = v & 255 as u32
    return 0xFF000000 as u32 | (b << 16 as u32) | (g << 8 as u32) | r
}

fn token(s: str, from: usize, out: *mut str) -> usize {
    var i: usize = from
    while i < s.n && rt.ld8(s.p as u64, i) == (32 as u8) {
        i = i + 1
    }
    let start: usize = i
    while i < s.n && rt.ld8(s.p as u64, i) != (32 as u8) {
        i = i + 1
    }
    *out = str { p: rt.ptr_of((s.p as u64) + (start as u64)), n: i - start }
    return i
}
