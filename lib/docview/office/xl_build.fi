import std.rt
import std.xml
import std.vec
import docview.office.ooxml
import docview.office.dx_props
import docview.office.dx_model
import docview.office.xl_pool
import docview.office.xl_style
import docview.office.xl_sheet
import docview.office.xl_cellval
import docview.office.xl_cellout
import docview.office.xl_ref

export { BuildCtx, build_table, MAX_XCELLS }

const MAX_XCELLS: usize = 400000

struct BuildCtx {
    d: *mut dx_model.Docx,
    x: *mut xml.Doc,
    st: *mut xl_style.XlStyles,
    sst: *mut xl_pool.Pool,
    info: *mut xl_sheet.SheetInfo,
    date1904: bool,
    sect: u32,
    ti: u32,
}

struct RowState {
    nv: usize,
    vis: [i32; 256],
    pref: [i32; 257],
    vtw: [i32; 256],
    vrem: [i32; 256],
    vspan: [i32; 256],
    org_cs: [i32; 256],
    org_rs: [i32; 256],
    cells: [u32; 256],
    count: usize,
}

fn rs_new() -> RowState {
    return RowState { nv: 0, vis: [0 as i32; 256], pref: [0 as i32; 257], vtw: [0 as i32; 256], vrem: [0 as i32; 256],
        vspan: [0 as i32; 256], org_cs: [0 as i32; 256], org_rs: [0 as i32; 256], cells: [xml.NONE; 256], count: 0 }
}

fn setup_cols(c: *mut BuildCtx, rs: *mut RowState) {
    let info: *mut xl_sheet.SheetInfo = (*c).info
    let total: usize = ((*info).c1 - (*info).c0 + 1) as usize
    var k: usize = 0
    (*rs).pref[0] = 0
    while k < total {
        if !xl_sheet.col_hidden(info, k) {
            (*rs).vis[(*rs).nv] = k as i32
            (*rs).vtw[(*rs).nv] = xl_sheet.col_tw(info, k)
            (*rs).nv = (*rs).nv + 1
        }
        (*rs).pref[k + 1] = (*rs).nv as i32
        k = k + 1
    }
}

fn span_tw(rs: *mut RowState, k: usize, n: usize) -> i32 {
    var w: i64 = 0
    var j: usize = 0
    while j < n && k + j < (*rs).nv {
        w = w + ((*rs).vtw[k + j] as i64)
        j = j + 1
    }
    if w > 200000 {
        w = 200000
    }
    return w as i32
}

fn blank_cell_blocks(c: *mut BuildCtx, bl: *mut dx_model.BList) {
    xl_cellout.emit_cell_para((*c).d, (*c).st, (0 as u64) as *mut xl_style.Xf, xl_cellval.CK_EMPTY, "", (*c).sect, bl)
}

fn xf_of(c: *mut BuildCtx, node: u32) -> *mut xl_style.Xf {
    if node == xml.NONE {
        return (0 as u64) as *mut xl_style.Xf
    }
    let si: i64 = ooxml.attr_i64((*c).x, node, "s", 0)
    if si < 0 || (si as usize) >= vec_len[xl_style.Xf](&(*(*c).st).xfs) {
        return (0 as u64) as *mut xl_style.Xf
    }
    return xl_style.xf_at((*c).st, si as usize)
}

fn emit_cell(c: *mut BuildCtx, rs: *mut RowState, ri: u32, k: usize, cs: usize, node: u32, vmerge: i32) {
    let d: *mut dx_model.Docx = (*c).d
    let ci: u32 = dx_model.new_cell(d, ri)
    let ce: *mut dx_model.Cell = dx_model.cell_at(d, ci)
    (*ce).span = cs as i32
    (*ce).width = span_tw(rs, k, cs)
    (*ce).vmerge = vmerge
    var bl: dx_model.BList = dx_model.blist_new()
    if vmerge == 2 {
        blank_cell_blocks(c, &bl)
        (*dx_model.cell_at(d, ci)).blocks = bl
        return
    }
    let xf: *mut xl_style.Xf = xf_of(c, node)
    xl_cellout.apply_cell_style((*c).st, xf, ce)
    var text: rt.Buf = rt.buf_new()
    defer rt.buf_free(&text)
    var kind: i32 = xl_cellval.CK_EMPTY
    if node != xml.NONE {
        kind = xl_cellval.cell_value((*c).x, node, (*c).st, (*c).sst, xf, (*c).date1904, &text)
    }
    xl_cellout.emit_cell_para(d, (*c).st, xf, kind, rt.buf_str(&text), (*c).sect, &bl)
    (*dx_model.cell_at(d, ci)).blocks = bl
}

fn load_row_cells(c: *mut BuildCtx, rs: *mut RowState, row: u32) {
    var k: usize = 0
    while k < 256 {
        (*rs).cells[k] = xml.NONE
        k = k + 1
    }
    if row == xml.NONE {
        return
    }
    let info: *mut xl_sheet.SheetInfo = (*c).info
    var coli: i32 = -1
    var cn: u32 = ooxml.first_el((*c).x, row)
    while cn != xml.NONE {
        if ooxml.is_el((*c).x, cn, "c") {
            var cr: i32 = 0
            var cc: i32 = 0
            if xl_ref.parse_ref(ooxml.attr_l((*c).x, cn, "r"), &cr, &cc) {
                coli = cc
            } else {
                coli = coli + 1
            }
            let rel: i32 = coli - (*info).c0
            if rel >= 0 && rel < 256 {
                (*rs).cells[rel as usize] = cn
            }
        }
        cn = ooxml.next_el((*c).x, cn)
    }
}

fn activate_merges(c: *mut BuildCtx, rs: *mut RowState, r: i32, heads: *mut Vec[i32], nexts: *mut Vec[i32]) {
    var k: usize = 0
    while k < 256 {
        (*rs).org_cs[k] = 0
        (*rs).org_rs[k] = 0
        k = k + 1
    }
    let info: *mut xl_sheet.SheetInfo = (*c).info
    let slot: i32 = r - (*info).r0
    if slot < 0 || (slot as usize) >= vec_len[i32](heads) {
        return
    }
    var m: i32 = *vec_elem_ptr[i32](heads, slot as usize)
    while m >= 0 {
        let mg: *mut xl_sheet.Merge = vec_elem_ptr[xl_sheet.Merge](&(*info).merges, m as usize)
        var rc1: i32 = (*mg).c1 - (*info).c0
        var rc2: i32 = (*mg).c2 - (*info).c0
        if rc1 >= 0 && rc1 < 256 {
            if rc2 > 255 { rc2 = 255 }
            var tot: i32 = (*info).c1 - (*info).c0
            if rc2 > tot { rc2 = tot }
            let cs: i32 = (*rs).pref[(rc2 + 1) as usize] - (*rs).pref[rc1 as usize]
            var rows: i32 = (*mg).r2 - (*mg).r1 + 1
            if (*mg).r2 > (*info).r1 {
                rows = (*info).r1 - (*mg).r1 + 1
            }
            if cs >= 1 {
                (*rs).org_cs[rc1 as usize] = cs
                (*rs).org_rs[rc1 as usize] = rows
            }
        }
        m = *vec_elem_ptr[i32](nexts, m as usize)
    }
}

fn emit_row(c: *mut BuildCtx, rs: *mut RowState, r: i32, row: u32, heads: *mut Vec[i32], nexts: *mut Vec[i32]) {
    let d: *mut dx_model.Docx = (*c).d
    if vec_len[dx_model.Cell](&(*d).cells) >= xl_build_cell_cap() {
        (*d).truncated = true
        return
    }
    let info: *mut xl_sheet.SheetInfo = (*c).info
    activate_merges(c, rs, r, heads, nexts)
    load_row_cells(c, rs, row)
    let ri: u32 = dx_model.new_row(d, (*c).ti)
    if row != xml.NONE {
        let ht: str = ooxml.attr_l((*c).x, row, "ht")
        var hv: f64 = 0.0
        if ht.n > 0 && xl_ref.parse_f64(ht, &hv) && hv > 0.0 && hv < 409.0 {
            (*dx_model.row_at(d, ri)).height = (hv * 20.0) as i32
            let ch: str = ooxml.attr_l((*c).x, row, "customHeight")
            (*dx_model.row_at(d, ri)).exact = ch == "1" || ch == "true"
        }
    } else if (*info).def_row_tw > 0 {
        (*dx_model.row_at(d, ri)).height = (*info).def_row_tw
    }
    var k: usize = 0
    while k < (*rs).nv {
        let rc: usize = (*rs).vis[k] as usize
        if (*rs).vrem[k] > 0 && (*rs).vspan[k] > 0 {
            let sp: usize = (*rs).vspan[k] as usize
            emit_cell(c, rs, ri, k, sp, xml.NONE, 2)
            var j: usize = 0
            while j < sp && k + j < (*rs).nv {
                (*rs).vrem[k + j] = (*rs).vrem[k + j] - 1
                j = j + 1
            }
            if (*rs).vrem[k] <= 0 {
                (*rs).vspan[k] = 0
            }
            k = k + sp
        } else if (*rs).org_cs[rc] > 0 {
            var sp2: usize = (*rs).org_cs[rc] as usize
            if k + sp2 > (*rs).nv {
                sp2 = (*rs).nv - k
            }
            var vm: i32 = 0
            if (*rs).org_rs[rc] > 1 {
                vm = 1
                var j2: usize = 0
                while j2 < sp2 {
                    (*rs).vrem[k + j2] = (*rs).org_rs[rc] - 1
                    j2 = j2 + 1
                }
                (*rs).vspan[k] = sp2 as i32
            }
            emit_cell(c, rs, ri, k, sp2, (*rs).cells[rc], vm)
            k = k + sp2
        } else {
            emit_cell(c, rs, ri, k, 1, (*rs).cells[rc], 0)
            k = k + 1
        }
    }
}

fn xl_build_cell_cap() -> usize {
    return MAX_XCELLS
}

fn grid_border() -> dx_props.Border {
    return dx_props.Border { sz: 4, color: 0xFFD4D4D4 as u32 }
}

fn index_merges(info: *mut xl_sheet.SheetInfo, heads: *mut Vec[i32], nexts: *mut Vec[i32]) {
    let nrows: i32 = (*info).r1 - (*info).r0 + 1
    var i: i32 = 0
    while i < nrows {
        vec_push[i32](heads, -1)
        i = i + 1
    }
    let n: usize = vec_len[xl_sheet.Merge](&(*info).merges)
    var m: usize = 0
    while m < n {
        let mg: *mut xl_sheet.Merge = vec_elem_ptr[xl_sheet.Merge](&(*info).merges, m)
        let slot: i32 = (*mg).r1 - (*info).r0
        if slot >= 0 && slot < nrows {
            vec_push[i32](nexts, *vec_elem_ptr[i32](heads, slot as usize))
            *vec_elem_ptr[i32](heads, slot as usize) = m as i32
        } else {
            vec_push[i32](nexts, -1)
        }
        m = m + 1
    }
}

fn build_table(c: *mut BuildCtx, sd: u32, list: *mut dx_model.BList) -> bool {
    let info: *mut xl_sheet.SheetInfo = (*c).info
    if !(*info).has_cells {
        return false
    }
    let d: *mut dx_model.Docx = (*c).d
    var rs: RowState = rs_new()
    setup_cols(c, &rs)
    if rs.nv == 0 {
        return false
    }
    var tp: dx_props.TblProps = dx_props.tbl_unset()
    if (*info).gridlines {
        tp.top = grid_border()
        tp.left = grid_border()
        tp.bottom = grid_border()
        tp.right = grid_border()
        tp.inner_h = grid_border()
        tp.inner_v = grid_border()
    }
    tp.mar_left = 60
    tp.mar_right = 60
    tp.mar_top = 15
    tp.mar_bottom = 15
    tp.align = dx_props.ALIGN_LEFT
    let ti: u32 = dx_model.new_table(d, tp)
    (*c).ti = ti
    var i: usize = 0
    while i < rs.nv {
        vec_push[i32](&(*d).grid, rs.vtw[i])
        i = i + 1
    }
    (*dx_model.table_at(d, ti)).gn = rs.nv as u32
    dx_model.block_add(d, list, dx_model.B_TABLE, ti, (*c).sect)
    var heads: Vec[i32] = vec_new[i32]()
    defer vec_free[i32](&heads)
    var nexts: Vec[i32] = vec_new[i32]()
    defer vec_free[i32](&nexts)
    index_merges(info, &heads, &nexts)
    var next_r: i32 = (*info).r0
    var rowi: i32 = -1
    var row: u32 = ooxml.first_el((*c).x, sd)
    while row != xml.NONE && next_r <= (*info).r1 {
        if ooxml.is_el((*c).x, row, "row") {
            let rr: i64 = ooxml.attr_i64((*c).x, row, "r", 0)
            if rr > 0 {
                rowi = (rr - 1) as i32
            } else {
                rowi = rowi + 1
            }
            if rowi >= (*info).r0 && rowi <= (*info).r1 {
                while next_r < rowi {
                    emit_row(c, &rs, next_r, xml.NONE, &heads, &nexts)
                    next_r = next_r + 1
                }
                if next_r == rowi {
                    let hid: str = ooxml.attr_l((*c).x, row, "hidden")
                    if hid == "1" || hid == "true" {
                        activate_merges(c, &rs, next_r, &heads, &nexts)
                    } else {
                        emit_row(c, &rs, rowi, row, &heads, &nexts)
                    }
                    next_r = next_r + 1
                }
            }
        }
        row = ooxml.next_el((*c).x, row)
    }
    while next_r <= (*info).r1 && vec_len[dx_model.Cell](&(*d).cells) < MAX_XCELLS {
        emit_row(c, &rs, next_r, xml.NONE, &heads, &nexts)
        next_r = next_r + 1
    }
    return true
}
