import std.vec
import docview.office.dx_model
import docview.office.dx_lay
import docview.office.dx_prim
import docview.office.dx_tlay

export { install, geo_set }

fn geo_set(l: *mut dx_lay.Lay, w: f64, h: f64, left: f64, width: f64, top: f64, bottom: f64) {
    (*l).geo = dx_lay.PageGeo { w: w, h: h, left: left, width: width, top: top, bottom: bottom }
}

fn axis(rel: i32, off: f64, align: i32, size: f64, page_span: f64, margin_base: f64, margin_span: f64, local: f64) -> f64 {
    var base: f64 = local
    var span: f64 = size
    if rel == dx_model.REL_PAGE {
        base = 0.0
        span = page_span
    } else if rel == dx_model.REL_MARGIN {
        base = margin_base
        span = margin_span
    }
    if align == 0 { return base }
    if align == 1 { return base + (span - size) / 2.0 }
    if align == 2 { return base + span - size }
    return base + off
}

fn place_float(l: *mut dx_lay.Lay, f: *mut dx_model.Float, x0: f64, width: f64, oy: f64, sink: *mut Vec[dx_prim.Prim], hf: u32) {
    let g: *mut dx_lay.PageGeo = &(*l).geo
    let x: f64 = axis((*f).hrel, (*f).hoff, (*f).halign, (*f).w, (*g).w, (*g).left, (*g).width, x0)
    let y: f64 = axis((*f).vrel, (*f).voff, (*f).valign, (*f).h, (*g).h, (*g).top, (*g).bottom - (*g).top, oy)
    let fl: u32 = hf | dx_prim.F_FLOAT
    if (*f).fill != 0 as u32 {
        var rp: dx_prim.Prim = dx_prim.prim_rect((*f).fill, x, y, (*f).w, (*f).h)
        rp.flags = fl
        vec_push[dx_prim.Prim](sink, rp)
    }
    if (*f).img >= 0 {
        var ip: dx_prim.Prim = dx_prim.prim_image((*f).img as i64, x, y, (*f).w, (*f).h)
        ip.flags = fl
        vec_push[dx_prim.Prim](sink, ip)
    }
    if (*f).blocks.head != dx_model.NIL {
        var inner: f64 = (*f).w - (*f).ins_l - (*f).ins_r
        if inner < 8.0 { inner = 8.0 }
        var inner_lay: dx_lay.Lay = dx_lay.lay_new((*l).d, (*l).fonts)
        defer dx_lay.lay_free(&inner_lay)
        inner_lay.cur_page = (*l).cur_page
        inner_lay.total = (*l).total
        let n0: usize = vec_len[dx_prim.Prim](sink)
        dx_tlay.lay_flow(&inner_lay, &(*f).blocks, x + (*f).ins_l, inner, sink, fl)
        dx_prim.prims_shift(sink, n0, 0.0, y + (*f).ins_t)
    }
}

fn float_hook(l: *mut dx_lay.Lay, pi: u32, x0: f64, width: f64, oy: f64, sink: *mut Vec[dx_prim.Prim], hf: u32, behind: bool) {
    let d: *mut dx_model.Docx = (*l).d
    if vec_len[dx_model.Float](&(*d).floats) == 0 {
        return
    }
    let pa: *mut dx_model.Para = dx_model.para_at(d, pi)
    var k: u32 = 0
    while k < (*pa).rcount {
        let r: *mut dx_model.Run = dx_model.run_at(d, (*pa).rfirst + k)
        if (*r).kind == dx_model.R_FLOAT && (*r).a >= 0 {
            let f: *mut dx_model.Float = dx_model.float_at(d, (*r).a as u32)
            if (*f).behind == behind {
                place_float(l, f, x0, width, oy, sink, hf)
            }
        }
        k = k + 1
    }
}

fn install(l: *mut dx_lay.Lay) {
    (*l).hook = float_hook
}
