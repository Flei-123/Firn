// SPDX-License-Identifier: MPL-2.0
import std.rt
import docview.office.dx_prim

export { paint_shape, crop_rgba }

fn inside_ellipse(px: f64, py: f64, x: f64, y: f64, w: f64, h: f64) -> bool {
    let rx: f64 = w / 2.0
    let ry: f64 = h / 2.0
    if rx <= 0.0 || ry <= 0.0 {
        return false
    }
    let dx: f64 = (px - (x + rx)) / rx
    let dy: f64 = (py - (y + ry)) / ry
    return dx * dx + dy * dy <= 1.0
}

fn inside_round(px: f64, py: f64, x: f64, y: f64, w: f64, h: f64, r: f64) -> bool {
    if w <= 0.0 || h <= 0.0 || px < x || py < y || px > x + w || py > y + h {
        return false
    }
    var cx: f64 = px
    var cy: f64 = py
    if px < x + r {
        cx = x + r
    } else if px > x + w - r {
        cx = x + w - r
    }
    if py < y + r {
        cy = y + r
    } else if py > y + h - r {
        cy = y + h - r
    }
    let dx: f64 = px - cx
    let dy: f64 = py - cy
    return dx * dx + dy * dy <= r * r
}

fn mix_ch(a: u32, b: u32, t: f64, sh: u32) -> u32 {
    let ca: f64 = ((a >> sh) & (255 as u32)) as f64
    let cb: f64 = ((b >> sh) & (255 as u32)) as f64
    return (ca + (cb - ca) * t + 0.5) as u32
}

fn mix_col(a: u32, b: u32, t: f64) -> u32 {
    var k: f64 = t
    if k < 0.0 { k = 0.0 }
    if k > 1.0 { k = 1.0 }
    return (0xFF000000 as u32) | (mix_ch(a, b, k, 16 as u32) << (16 as u32)) | (mix_ch(a, b, k, 8 as u32) << (8 as u32)) | mix_ch(a, b, k, 0 as u32)
}

fn covered(geo: i32, px: f64, py: f64, x: f64, y: f64, w: f64, h: f64, r: f64, lw: f64) -> bool {
    if geo == 1 {
        return inside_ellipse(px, py, x, y, w, h)
    }
    if geo == 2 {
        return inside_round(px, py, x, y, w, h, r)
    }
    if geo == 3 {
        return inside_ellipse(px, py, x, y, w, h) && !inside_ellipse(px, py, x + lw, y + lw, w - 2.0 * lw, h - 2.0 * lw)
    }
    if geo == 4 {
        var ir: f64 = r - lw
        if ir < 0.0 { ir = 0.0 }
        return inside_round(px, py, x, y, w, h, r) && !inside_round(px, py, x + lw, y + lw, w - 2.0 * lw, h - 2.0 * lw, ir)
    }
    return px >= x && py >= y && px <= x + w && py <= y + h
}

fn paint_shape(dst: u64, dw: i32, dh: i32, p: *mut dx_prim.Prim, scale: f64) {
    let x: f64 = ((*p).x as f64) * scale
    let y: f64 = ((*p).y as f64) * scale
    let w: f64 = ((*p).w as f64) * scale
    let h: f64 = ((*p).h as f64) * scale
    if w < 0.5 || h < 0.5 || w > 16384.0 || h > 16384.0 {
        return
    }
    let geo: i32 = (*p).a & 15
    let grad: i32 = ((*p).a >> 4) & 15
    let r: f64 = (((*p).off as f64) / 16.0) * scale
    var lw: f64 = ((*p).size as f64) * scale
    if lw < 1.0 { lw = 1.0 }
    var x0: i64 = x as i64
    var y0: i64 = y as i64
    var x1: i64 = (x + w + 1.0) as i64
    var y1: i64 = (y + h + 1.0) as i64
    if x0 < 0 { x0 = 0 }
    if y0 < 0 { y0 = 0 }
    if x1 > (dw as i64) { x1 = dw as i64 }
    if y1 > (dh as i64) { y1 = dh as i64 }
    var yy: i64 = y0
    while yy < y1 {
        var xx: i64 = x0
        let fy: f64 = (yy as f64) + 0.5
        while xx < x1 {
            let fx: f64 = (xx as f64) + 0.5
            if covered(geo, fx, fy, x, y, w, h, r, lw) {
                var col: u32 = (*p).color
                if grad == 1 {
                    col = mix_col((*p).color, (*p).face, (fy - y) / h)
                } else if grad == 2 {
                    col = mix_col((*p).color, (*p).face, (fx - x) / w)
                }
                rt.st32(dst, (yy as usize) * (dw as usize) + (xx as usize), col)
            }
            xx = xx + 1
        }
        yy = yy + 1
    }
}

fn crop_rgba(src: u64, w: usize, h: usize, crop: u32, out: *mut rt.Buf, ow: *mut usize, oh: *mut usize) -> bool {
    let l: usize = ((crop & (255 as u32)) as usize) * w / 255
    let t: usize = (((crop >> (8 as u32)) & (255 as u32)) as usize) * h / 255
    let rr: usize = (((crop >> (16 as u32)) & (255 as u32)) as usize) * w / 255
    let b: usize = (((crop >> (24 as u32)) & (255 as u32)) as usize) * h / 255
    if l + rr + 1 >= w || t + b + 1 >= h {
        return false
    }
    let cw: usize = w - l - rr
    let ch: usize = h - t - b
    rt.buf_reserve(out, cw * ch * 4)
    rt.buf_set_len(out, cw * ch * 4)
    let dp: u64 = rt.buf_ptr(out)
    var y: usize = 0
    while y < ch {
        var x: usize = 0
        while x < cw {
            rt.st32(dp, y * cw + x, rt.ld32(src, (t + y) * w + l + x))
            x = x + 1
        }
        y = y + 1
    }
    *ow = cw
    *oh = ch
    return true
}
