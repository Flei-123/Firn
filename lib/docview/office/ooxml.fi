// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.xml

export {
    local_name, is_el, child_l, next_l, first_el, next_el, attr_l, has_attr_l,
    parse_i64, attr_i64, attr_u32_hex, on_off, str_eq_ci, starts_with, ends_with,
    el_count,
}

fn local_name(s: str) -> str {
    var i: usize = s.n
    while i > 0 {
        if rt.ld8(s.p as u64, i - 1) == 58 as u8 {
            return str { p: rt.ptr_of((s.p as u64) + (i as u64)), n: s.n - i }
        }
        i = i - 1
    }
    return s
}

fn is_el(d: *mut xml.Doc, n: u32, name: str) -> bool {
    if n == xml.NONE {
        return false
    }
    if xml.kind(d, n) != xml.ELEMENT {
        return false
    }
    return local_name(xml.name(d, n)) == name
}

fn first_el(d: *mut xml.Doc, n: u32) -> u32 {
    if n == xml.NONE {
        return xml.NONE
    }
    var c: u32 = xml.first(d, n)
    while c != xml.NONE {
        if xml.kind(d, c) == xml.ELEMENT {
            return c
        }
        c = xml.next(d, c)
    }
    return xml.NONE
}

fn next_el(d: *mut xml.Doc, n: u32) -> u32 {
    var c: u32 = xml.next(d, n)
    while c != xml.NONE {
        if xml.kind(d, c) == xml.ELEMENT {
            return c
        }
        c = xml.next(d, c)
    }
    return xml.NONE
}

fn child_l(d: *mut xml.Doc, n: u32, name: str) -> u32 {
    var c: u32 = first_el(d, n)
    while c != xml.NONE {
        if is_el(d, c, name) {
            return c
        }
        c = next_el(d, c)
    }
    return xml.NONE
}

fn next_l(d: *mut xml.Doc, n: u32, name: str) -> u32 {
    var c: u32 = next_el(d, n)
    while c != xml.NONE {
        if is_el(d, c, name) {
            return c
        }
        c = next_el(d, c)
    }
    return xml.NONE
}

fn el_count(d: *mut xml.Doc, n: u32) -> usize {
    var k: usize = 0
    var c: u32 = first_el(d, n)
    while c != xml.NONE {
        k = k + 1
        c = next_el(d, c)
    }
    return k
}

fn attr_l(d: *mut xml.Doc, n: u32, name: str) -> str {
    if n == xml.NONE {
        return ""
    }
    var k: usize = 0
    let cnt: usize = xml.attr_count(d, n)
    while k < cnt {
        if local_name(xml.attr_name(d, n, k)) == name {
            return xml.attr_value(d, n, k)
        }
        k = k + 1
    }
    return ""
}

fn has_attr_l(d: *mut xml.Doc, n: u32, name: str) -> bool {
    if n == xml.NONE {
        return false
    }
    var k: usize = 0
    let cnt: usize = xml.attr_count(d, n)
    while k < cnt {
        if local_name(xml.attr_name(d, n, k)) == name {
            return true
        }
        k = k + 1
    }
    return false
}

fn parse_i64(s: str, dflt: i64) -> i64 {
    if s.n == 0 {
        return dflt
    }
    var i: usize = 0
    var neg: bool = false
    var c: u8 = rt.ld8(s.p as u64, 0)
    if c == 45 as u8 {
        neg = true
        i = 1
    }
    if i >= s.n {
        return dflt
    }
    var v: i64 = 0
    while i < s.n {
        c = rt.ld8(s.p as u64, i)
        if c < 48 as u8 || c > 57 as u8 {
            if c == 46 as u8 {
                break
            }
            return dflt
        }
        if v < 100000000000 {
            v = v * 10 + ((c - 48 as u8) as i64)
        }
        i = i + 1
    }
    if v > 2000000000 {
        v = 2000000000
    }
    if neg {
        return 0 - v
    }
    return v
}

fn attr_i64(d: *mut xml.Doc, n: u32, name: str, dflt: i64) -> i64 {
    return parse_i64(attr_l(d, n, name), dflt)
}

fn hex_val(c: u8) -> i32 {
    if c >= 48 as u8 && c <= 57 as u8 {
        return (c - 48 as u8) as i32
    }
    if c >= 97 as u8 && c <= 102 as u8 {
        return (c - 97 as u8) as i32 + 10
    }
    if c >= 65 as u8 && c <= 70 as u8 {
        return (c - 65 as u8) as i32 + 10
    }
    return -1
}

fn attr_u32_hex(d: *mut xml.Doc, n: u32, name: str, dflt: u32) -> u32 {
    let s: str = attr_l(d, n, name)
    if s.n != 6 {
        return dflt
    }
    var v: u32 = 0
    var i: usize = 0
    while i < 6 {
        let h: i32 = hex_val(rt.ld8(s.p as u64, i))
        if h < 0 {
            return dflt
        }
        v = (v << 4 as u32) | (h as u32)
        i = i + 1
    }
    let r: u32 = (v >> 16 as u32) & 255 as u32
    let g: u32 = (v >> 8 as u32) & 255 as u32
    let b: u32 = v & 255 as u32
    return 0xFF000000 as u32 | (b << 16 as u32) | (g << 8 as u32) | r
}

fn lower_c(c: u8) -> u8 {
    if c >= 65 as u8 && c <= 90 as u8 {
        return c + 32 as u8
    }
    return c
}

fn str_eq_ci(a: str, b: str) -> bool {
    if a.n != b.n {
        return false
    }
    var i: usize = 0
    while i < a.n {
        if lower_c(rt.ld8(a.p as u64, i)) != lower_c(rt.ld8(b.p as u64, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

fn starts_with(s: str, pre: str) -> bool {
    if pre.n > s.n {
        return false
    }
    return rt.mem_eq(s.p as u64, pre.p as u64, pre.n)
}

fn ends_with(s: str, suf: str) -> bool {
    if suf.n > s.n {
        return false
    }
    return rt.mem_eq((s.p as u64) + ((s.n - suf.n) as u64), suf.p as u64, suf.n)
}

fn on_off(d: *mut xml.Doc, n: u32) -> i32 {
    if n == xml.NONE {
        return -1
    }
    let v: str = attr_l(d, n, "val")
    if v.n == 0 {
        return 1
    }
    if v == "0" || v == "false" || v == "off" || v == "none" {
        return 0
    }
    return 1
}
