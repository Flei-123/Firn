// SPDX-License-Identifier: MPL-2.0
import std.rt

export { parse_ref, parse_range, parse_f64 }

fn parse_ref(s: str, row: *mut i32, col: *mut i32) -> bool {
    var i: usize = 0
    var c: i64 = 0
    while i < s.n {
        var ch: u8 = rt.ld8(s.p as u64, i)
        if ch >= (97 as u8) && ch <= (122 as u8) {
            ch = ch - (32 as u8)
        }
        if ch < (65 as u8) || ch > (90 as u8) {
            break
        }
        if c < 100000 {
            c = c * 26 + ((ch - (64 as u8)) as i64)
        }
        i = i + 1
    }
    if i == 0 || i >= s.n {
        return false
    }
    var r: i64 = 0
    var digits: usize = 0
    while i < s.n {
        let d: u8 = rt.ld8(s.p as u64, i)
        if d < (48 as u8) || d > (57 as u8) {
            return false
        }
        if r < 100000000 {
            r = r * 10 + ((d - (48 as u8)) as i64)
        }
        digits = digits + 1
        i = i + 1
    }
    if digits == 0 || r < 1 || c < 1 || c > 16384 || r > 1048576 {
        return false
    }
    *row = (r - 1) as i32
    *col = (c - 1) as i32
    return true
}

fn parse_range(s: str, r1: *mut i32, c1: *mut i32, r2: *mut i32, c2: *mut i32) -> bool {
    var k: usize = 0
    while k < s.n && rt.ld8(s.p as u64, k) != (58 as u8) {
        k = k + 1
    }
    let a: str = str { p: s.p, n: k }
    if !parse_ref(a, r1, c1) {
        return false
    }
    if k >= s.n {
        *r2 = *r1
        *c2 = *c1
        return true
    }
    let b: str = str { p: rt.ptr_of((s.p as u64) + ((k + 1) as u64)), n: s.n - k - 1 }
    if !parse_ref(b, r2, c2) {
        return false
    }
    if *r2 < *r1 || *c2 < *c1 {
        return false
    }
    return true
}

fn parse_f64(s: str, out: *mut f64) -> bool {
    var i: usize = 0
    while i < s.n && rt.ld8(s.p as u64, i) == (32 as u8) {
        i = i + 1
    }
    var neg: bool = false
    if i < s.n && (rt.ld8(s.p as u64, i) == (45 as u8) || rt.ld8(s.p as u64, i) == (43 as u8)) {
        neg = rt.ld8(s.p as u64, i) == (45 as u8)
        i = i + 1
    }
    var mant: u64 = 0
    var exp10: i32 = 0
    var seen: bool = false
    var dot: bool = false
    var sig: i32 = 0
    while i < s.n {
        let c: u8 = rt.ld8(s.p as u64, i)
        if c == (46 as u8) && !dot {
            dot = true
        } else if c >= (48 as u8) && c <= (57 as u8) {
            seen = true
            if sig < 18 {
                mant = mant * 10 + ((c - (48 as u8)) as u64)
                if mant > 0 {
                    sig = sig + 1
                }
                if dot {
                    exp10 = exp10 - 1
                }
            } else if !dot {
                exp10 = exp10 + 1
            }
        } else {
            break
        }
        i = i + 1
    }
    if !seen {
        return false
    }
    if i < s.n && (rt.ld8(s.p as u64, i) == (69 as u8) || rt.ld8(s.p as u64, i) == (101 as u8)) {
        i = i + 1
        var eneg: bool = false
        if i < s.n && (rt.ld8(s.p as u64, i) == (45 as u8) || rt.ld8(s.p as u64, i) == (43 as u8)) {
            eneg = rt.ld8(s.p as u64, i) == (45 as u8)
            i = i + 1
        }
        var e: i32 = 0
        while i < s.n {
            let c2: u8 = rt.ld8(s.p as u64, i)
            if c2 < (48 as u8) || c2 > (57 as u8) {
                break
            }
            if e < 10000 {
                e = e * 10 + ((c2 - (48 as u8)) as i32)
            }
            i = i + 1
        }
        if eneg {
            exp10 = exp10 - e
        } else {
            exp10 = exp10 + e
        }
    }
    var v: f64 = mant as f64
    var k: i32 = exp10
    if k > 400 { k = 400 }
    if k < -400 { k = -400 }
    while k > 0 {
        v = v * 10.0
        k = k - 1
    }
    var div: f64 = 1.0
    while k < 0 {
        div = div * 10.0
        k = k + 1
        if div > 1.0e300 {
            v = v / div
            div = 1.0
        }
    }
    v = v / div
    if neg {
        v = 0.0 - v
    }
    *out = v
    return true
}
