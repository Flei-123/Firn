import std.xml
import docview.office.ooxml
import docview.office.dx_model
import docview.office.od_units
import docview.office.od_ctx
import docview.office.od_body

export { read_page, master_part }

fn find_named(x: *mut xml.Doc, parent: u32, tag: str, name: str) -> u32 {
    var c: u32 = ooxml.first_el(x, parent)
    while c != xml.NONE {
        if ooxml.is_el(x, c, tag) && ooxml.attr_l(x, c, "name") == name {
            return c
        }
        c = ooxml.next_el(x, c)
    }
    return xml.NONE
}

fn master_part(x: *mut xml.Doc, root: u32) -> u32 {
    let ms: u32 = ooxml.child_l(x, root, "master-styles")
    if ms == xml.NONE {
        return xml.NONE
    }
    return ooxml.child_l(x, ms, "master-page")
}

fn read_page(c: *mut od_ctx.OdCtx, d: *mut dx_model.Docx, x: *mut xml.Doc, root: u32) {
    let s: *mut dx_model.Sect = dx_model.sect_at(d, 0)
    let master: u32 = master_part(x, root)
    if master == xml.NONE {
        (*c).text_w = (*s).w - (*s).ml - (*s).mr
        return
    }
    let autos: u32 = ooxml.child_l(x, root, "automatic-styles")
    let pl: u32 = find_named(x, autos, "page-layout", ooxml.attr_l(x, master, "page-layout-name"))
    if pl != xml.NONE {
        let pr: u32 = ooxml.child_l(x, pl, "page-layout-properties")
        if pr != xml.NONE {
            (*s).w = od_units.clamp_i(od_units.len_tw(ooxml.attr_l(x, pr, "page-width"), 11906), 1440, 31680) as i32
            (*s).h = od_units.clamp_i(od_units.len_tw(ooxml.attr_l(x, pr, "page-height"), 16838), 1440, 31680) as i32
            let m: str = ooxml.attr_l(x, pr, "margin")
            var dm: i64 = 1134
            if m.n > 0 {
                dm = od_units.len_tw(m, 1134)
            }
            (*s).ml = od_units.clamp_i(od_units.len_tw(ooxml.attr_l(x, pr, "margin-left"), dm), 0, ((*s).w / 3) as i64) as i32
            (*s).mr = od_units.clamp_i(od_units.len_tw(ooxml.attr_l(x, pr, "margin-right"), dm), 0, ((*s).w / 3) as i64) as i32
            (*s).mt = od_units.clamp_i(od_units.len_tw(ooxml.attr_l(x, pr, "margin-top"), dm), 0, ((*s).h / 3) as i64) as i32
            (*s).mb = od_units.clamp_i(od_units.len_tw(ooxml.attr_l(x, pr, "margin-bottom"), dm), 0, ((*s).h / 3) as i64) as i32
            (*s).header_dist = (*s).mt
            (*s).footer_dist = (*s).mb
        }
    }
    (*c).text_w = (*s).w - (*s).ml - (*s).mr
    let hn: u32 = ooxml.child_l(x, master, "header")
    if hn != xml.NONE {
        let hi: u32 = dx_model.new_hf(d, "odt:header")
        var bl: dx_model.BList = dx_model.blist_new()
        od_body.parse_blocks(c, d, x, hn, &bl, 1)
        (*dx_model.hf_at(d, hi)).blocks = bl
        (*s).hdr_default = hi as i32
    }
    let fnode: u32 = ooxml.child_l(x, master, "footer")
    if fnode != xml.NONE {
        let fi: u32 = dx_model.new_hf(d, "odt:footer")
        var bl2: dx_model.BList = dx_model.blist_new()
        od_body.parse_blocks(c, d, x, fnode, &bl2, 1)
        (*dx_model.hf_at(d, fi)).blocks = bl2
        (*s).ftr_default = fi as i32
    }
}
