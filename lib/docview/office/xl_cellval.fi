import std.rt
import std.xml
import docview.office.ooxml
import docview.office.xl_pool
import docview.office.xl_sst
import docview.office.xl_style
import docview.office.xl_ref
import docview.office.xl_numfmt
import docview.office.xl_general

export { CK_EMPTY, CK_TEXT, CK_NUMBER, CK_FLAG, cell_value }

const CK_EMPTY: i32 = 0
const CK_TEXT: i32 = 1
const CK_NUMBER: i32 = 2
const CK_FLAG: i32 = 3

fn cell_value(x: *mut xml.Doc, c: u32, st: *mut xl_style.XlStyles, sst: *mut xl_pool.Pool, xf: *mut xl_style.Xf,
    date1904: bool, out: *mut rt.Buf) -> i32 {
    let t: str = ooxml.attr_l(x, c, "t")
    let vn: u32 = ooxml.child_l(x, c, "v")
    if t == "inlineStr" {
        xl_sst.collect_text(x, ooxml.child_l(x, c, "is"), out)
        if rt.buf_len(out) == 0 {
            return CK_EMPTY
        }
        return CK_TEXT
    }
    if vn == xml.NONE {
        return CK_EMPTY
    }
    let v: str = xml.text(x, vn)
    if v.n == 0 {
        return CK_EMPTY
    }
    if t == "s" {
        let idx: i64 = ooxml.parse_i64(v, -1)
        if idx < 0 {
            return CK_EMPTY
        }
        let s: str = xl_pool.pool_get(sst, idx as usize)
        rt.buf_push_bytes(out, s.p as u64, s.n)
        return CK_TEXT
    }
    if t == "str" || t == "d" {
        rt.buf_push_bytes(out, v.p as u64, v.n)
        return CK_TEXT
    }
    if t == "b" {
        if v == "1" {
            rt.buf_push_bytes(out, "TRUE".p as u64, 4)
        } else {
            rt.buf_push_bytes(out, "FALSE".p as u64, 5)
        }
        return CK_FLAG
    }
    if t == "e" {
        rt.buf_push_bytes(out, v.p as u64, v.n)
        return CK_FLAG
    }
    var num: f64 = 0.0
    if !xl_ref.parse_f64(v, &num) {
        rt.buf_push_bytes(out, v.p as u64, v.n)
        return CK_TEXT
    }
    if (xf as u64) == 0 {
        xl_general.general(num, out)
    } else {
        xl_numfmt.format_value(xl_style.xf_code(st, xf), num, date1904, out)
    }
    return CK_NUMBER
}
