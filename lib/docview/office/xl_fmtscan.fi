// SPDX-License-Identifier: MPL-2.0
import std.rt

export { Sections, split_sections, lit_item, is_date_section, lower, matches_at, section_slice, trim_str }

struct Sections {
    n: usize,
    st: [usize; 4],
    ln: [usize; 4],
}

fn lower(c: u8) -> u8 {
    if c >= (65 as u8) && c <= (90 as u8) {
        return c + (32 as u8)
    }
    return c
}

fn byte(s: str, i: usize) -> u8 {
    return rt.ld8(s.p as u64, i)
}

fn section_slice(s: str, off: usize, n: usize) -> str {
    return str { p: rt.ptr_of((s.p as u64) + (off as u64)), n: n }
}

fn trim_str(s: str) -> str {
    var a: usize = 0
    var b: usize = s.n
    while a < b && byte(s, a) == (32 as u8) {
        a = a + 1
    }
    while b > a && byte(s, b - 1) == (32 as u8) {
        b = b - 1
    }
    return section_slice(s, a, b - a)
}

fn matches_at(s: str, i: usize, word: str) -> bool {
    if i + word.n > s.n {
        return false
    }
    var k: usize = 0
    while k < word.n {
        if lower(byte(s, i + k)) != lower(byte(word, k)) {
            return false
        }
        k = k + 1
    }
    return true
}

fn split_sections(code: str, out: *mut Sections) {
    (*out).n = 0
    var start: usize = 0
    var i: usize = 0
    var quoted: bool = false
    var bracket: bool = false
    while i <= code.n {
        var cut: bool = false
        if i == code.n {
            cut = true
        } else {
            let c: u8 = byte(code, i)
            if quoted {
                if c == (34 as u8) { quoted = false }
            } else if bracket {
                if c == (93 as u8) { bracket = false }
            } else if c == (34 as u8) {
                quoted = true
            } else if c == (91 as u8) {
                bracket = true
            } else if c == (92 as u8) || c == (95 as u8) {
                i = i + 1
            } else if c == (59 as u8) {
                cut = true
            }
        }
        if cut {
            if (*out).n < 4 {
                (*out).st[(*out).n] = start
                (*out).ln[(*out).n] = i - start
                (*out).n = (*out).n + 1
            }
            start = i + 1
        }
        i = i + 1
    }
}

fn lit_item(s: str, i: usize, out: *mut rt.Buf) -> usize {
    let c: u8 = byte(s, i)
    if c == (34 as u8) {
        var j: usize = i + 1
        while j < s.n && byte(s, j) != (34 as u8) {
            rt.buf_push(out, byte(s, j))
            j = j + 1
        }
        return j + 1
    }
    if c == (92 as u8) {
        if i + 1 < s.n {
            rt.buf_push(out, byte(s, i + 1))
        }
        return i + 2
    }
    if c == (95 as u8) {
        rt.buf_push(out, 32 as u8)
        return i + 2
    }
    if c == (42 as u8) {
        return i + 2
    }
    if c == (91 as u8) {
        var j2: usize = i + 1
        while j2 < s.n && byte(s, j2) != (93 as u8) {
            j2 = j2 + 1
        }
        if i + 1 < s.n && byte(s, i + 1) == (36 as u8) {
            var k: usize = i + 2
            while k < j2 && byte(s, k) != (45 as u8) {
                rt.buf_push(out, byte(s, k))
                k = k + 1
            }
        }
        return j2 + 1
    }
    return i
}

fn is_date_section(s: str) -> bool {
    var tmp: rt.Buf = rt.buf_new()
    defer rt.buf_free(&tmp)
    var i: usize = 0
    while i < s.n {
        let c: u8 = byte(s, i)
        if c == (91 as u8) {
            if i + 1 < s.n {
                let n1: u8 = lower(byte(s, i + 1))
                if n1 == (104 as u8) || n1 == (109 as u8) || n1 == (115 as u8) {
                    return true
                }
            }
        }
        let j: usize = lit_item(s, i, &tmp)
        if j != i {
            i = j
        } else {
            let l: u8 = lower(c)
            if l == (121 as u8) || l == (100 as u8) || l == (104 as u8) || l == (109 as u8) || l == (115 as u8) {
                return true
            }
            i = i + 1
        }
    }
    return false
}
