import std.rt
import docview.office.xl_digits

export { general }

fn general(v: f64, out: *mut rt.Buf) {
    if v != v {
        xl_digits.push_str(out, "#NUM!")
        return
    }
    if v == 0.0 {
        rt.buf_push(out, 48 as u8)
        return
    }
    var a: f64 = v
    if v < 0.0 {
        rt.buf_push(out, 45 as u8)
        a = 0.0 - v
    }
    if a >= 1.0e11 || a < 1.0e-4 {
        xl_digits.push_sci(out, a, 5, 2, 0)
        return
    }
    var dec: i32 = 9
    if a >= 1.0 {
        var n: i32 = 1
        var t: f64 = a
        while t >= 10.0 {
            t = t / 10.0
            n = n + 1
        }
        dec = 10 - n
        if dec < 0 {
            dec = 0
        }
    }
    if !xl_digits.push_fixed(out, a, dec, false, 1, 0) {
        xl_digits.push_sci(out, a, 5, 2, 0)
    }
}
