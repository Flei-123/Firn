import docview.registry
import docview.kinds
import docview.lazy
import docview.office.dx_ops
import docview.office.pp_load

export { pptx_ops, pptx_install, pptx_install_lazy }

fn pptx_open(p: u64, n: usize) -> u64 {
    return dx_ops.open_with(p, n, pp_load.pptx_load)
}

fn pptx_ops() -> registry.DocOps {
    return dx_ops.view_ops(pptx_open)
}

fn pptx_install() {
    registry.register("pptx.native", kinds.KIND_PPTX, pptx_ops())
}

fn pptx_install_lazy() {
    lazy.lazy_register("pptx.native", kinds.KIND_PPTX, pptx_install)
}
