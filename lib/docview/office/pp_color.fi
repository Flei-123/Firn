import std.rt
import std.xml
import docview.office.ooxml
import docview.office.xl_color

export { Palette, palette_new, palette_set_map, color_in, tint_of }

struct Palette {
    th: xl_color.Theme,
    map: [i32; 4],
}

fn palette_new() -> Palette {
    return Palette { th: xl_color.theme_new(), map: [0 as i32, 1 as i32, 2 as i32, 3 as i32] }
}

fn slot_of(name: str) -> i32 {
    if name == "lt1" { return 0 }
    if name == "dk1" { return 1 }
    if name == "lt2" { return 2 }
    if name == "dk2" { return 3 }
    return -1
}

fn palette_set_map(p: *mut Palette, x: *mut xml.Doc, map: u32) {
    if map == xml.NONE {
        return
    }
    let a: i32 = slot_of(ooxml.attr_l(x, map, "bg1"))
    let b: i32 = slot_of(ooxml.attr_l(x, map, "tx1"))
    let c: i32 = slot_of(ooxml.attr_l(x, map, "bg2"))
    let d: i32 = slot_of(ooxml.attr_l(x, map, "tx2"))
    if a >= 0 { (*p).map[0] = a }
    if b >= 0 { (*p).map[1] = b }
    if c >= 0 { (*p).map[2] = c }
    if d >= 0 { (*p).map[3] = d }
}

fn scheme_slot(p: *mut Palette, name: str) -> i32 {
    if name == "bg1" { return (*p).map[0] }
    if name == "tx1" { return (*p).map[1] }
    if name == "bg2" { return (*p).map[2] }
    if name == "tx2" { return (*p).map[3] }
    if name == "lt1" { return 0 }
    if name == "dk1" { return 1 }
    if name == "lt2" { return 2 }
    if name == "dk2" { return 3 }
    if name == "hlink" { return 10 }
    if name == "folHlink" { return 11 }
    if ooxml.starts_with(name, "accent") && name.n == 7 {
        let k: i32 = (rt.ld8(name.p as u64, 6) as i32) - 49
        if k >= 0 && k < 6 {
            return 4 + k
        }
    }
    return -1
}

fn chan(c: u32, sh: u32) -> f64 {
    return (((c >> sh) & 255 as u32) as f64) / 255.0
}

fn clamp01(v: f64) -> f64 {
    if v < 0.0 { return 0.0 }
    if v > 1.0 { return 1.0 }
    return v
}

fn hue_chan(p: f64, q: f64, t0: f64) -> f64 {
    var t: f64 = t0
    if t < 0.0 { t = t + 1.0 }
    if t > 1.0 { t = t - 1.0 }
    if t < 1.0 / 6.0 { return p + (q - p) * 6.0 * t }
    if t < 0.5 { return q }
    if t < 2.0 / 3.0 { return p + (q - p) * (2.0 / 3.0 - t) * 6.0 }
    return p
}

fn adjust_lum(col: u32, mul: f64, add: f64) -> u32 {
    let r: f64 = chan(col, 0 as u32)
    let g: f64 = chan(col, 8 as u32)
    let b: f64 = chan(col, 16 as u32)
    var mx: f64 = r
    if g > mx { mx = g }
    if b > mx { mx = b }
    var mn: f64 = r
    if g < mn { mn = g }
    if b < mn { mn = b }
    var l: f64 = (mx + mn) / 2.0
    var h: f64 = 0.0
    var s: f64 = 0.0
    let dlt: f64 = mx - mn
    if dlt > 0.0 {
        if l > 0.5 {
            s = dlt / (2.0 - mx - mn)
        } else {
            s = dlt / (mx + mn)
        }
        if mx == r {
            h = (g - b) / dlt
            if g < b { h = h + 6.0 }
        } else if mx == g {
            h = (b - r) / dlt + 2.0
        } else {
            h = (r - g) / dlt + 4.0
        }
        h = h / 6.0
    }
    l = clamp01(l * mul + add)
    var nr: f64 = l
    var ng: f64 = l
    var nb: f64 = l
    if s > 0.0 {
        var q: f64 = l + s - l * s
        if l < 0.5 {
            q = l * (1.0 + s)
        }
        let pp: f64 = 2.0 * l - q
        nr = hue_chan(pp, q, h + 1.0 / 3.0)
        ng = hue_chan(pp, q, h)
        nb = hue_chan(pp, q, h - 1.0 / 3.0)
    }
    let ri: u32 = (nr * 255.0 + 0.5) as u32
    let gi: u32 = (ng * 255.0 + 0.5) as u32
    let bi: u32 = (nb * 255.0 + 0.5) as u32
    return 0xFF000000 as u32 | (bi << 16 as u32) | (gi << 8 as u32) | ri
}

fn mix_white(col: u32, k: f64) -> u32 {
    let r: u32 = ((chan(col, 0 as u32) * k + (1.0 - k)) * 255.0 + 0.5) as u32
    let g: u32 = ((chan(col, 8 as u32) * k + (1.0 - k)) * 255.0 + 0.5) as u32
    let b: u32 = ((chan(col, 16 as u32) * k + (1.0 - k)) * 255.0 + 0.5) as u32
    return 0xFF000000 as u32 | (b << 16 as u32) | (g << 8 as u32) | r
}

fn mix_black(col: u32, k: f64) -> u32 {
    let r: u32 = (chan(col, 0 as u32) * k * 255.0 + 0.5) as u32
    let g: u32 = (chan(col, 8 as u32) * k * 255.0 + 0.5) as u32
    let b: u32 = (chan(col, 16 as u32) * k * 255.0 + 0.5) as u32
    return 0xFF000000 as u32 | (b << 16 as u32) | (g << 8 as u32) | r
}

fn pct(x: *mut xml.Doc, n: u32) -> f64 {
    return (ooxml.attr_i64(x, n, "val", 100000) as f64) / 100000.0
}

fn base_color(p: *mut Palette, x: *mut xml.Doc, c: u32) -> u32 {
    if ooxml.is_el(x, c, "srgbClr") {
        let v: u32 = ooxml.attr_u32_hex(x, c, "val", 0 as u32)
        return v
    }
    if ooxml.is_el(x, c, "sysClr") {
        let v: u32 = ooxml.attr_u32_hex(x, c, "lastClr", 0 as u32)
        return v
    }
    if ooxml.is_el(x, c, "schemeClr") {
        let s: i32 = scheme_slot(p, ooxml.attr_l(x, c, "val"))
        if s >= 0 && s < 12 {
            return (*p).th.c[s as usize]
        }
        return 0 as u32
    }
    if ooxml.is_el(x, c, "prstClr") {
        let v: str = ooxml.attr_l(x, c, "val")
        if v == "white" { return xl_color.pack_rgb(0xFFFFFF as u32) }
        if v == "red" { return xl_color.pack_rgb(0xFF0000 as u32) }
        if v == "green" { return xl_color.pack_rgb(0x008000 as u32) }
        if v == "blue" { return xl_color.pack_rgb(0x0000FF as u32) }
        if v == "yellow" { return xl_color.pack_rgb(0xFFFF00 as u32) }
        if v == "gray" { return xl_color.pack_rgb(0x808080 as u32) }
        return xl_color.pack_rgb(0x000000 as u32)
    }
    return 0 as u32
}

fn color_node(p: *mut Palette, x: *mut xml.Doc, c: u32) -> u32 {
    var col: u32 = base_color(p, x, c)
    if col == 0 as u32 {
        return 0 as u32
    }
    var mul: f64 = 1.0
    var add: f64 = 0.0
    var m: u32 = ooxml.first_el(x, c)
    while m != xml.NONE {
        if ooxml.is_el(x, m, "lumMod") {
            mul = pct(x, m)
        } else if ooxml.is_el(x, m, "lumOff") {
            add = pct(x, m)
        } else if ooxml.is_el(x, m, "tint") {
            col = mix_white(col, pct(x, m))
        } else if ooxml.is_el(x, m, "shade") {
            col = mix_black(col, pct(x, m))
        }
        m = ooxml.next_el(x, m)
    }
    if mul != 1.0 || add != 0.0 {
        col = adjust_lum(col, mul, add)
    }
    return col
}

fn color_in(p: *mut Palette, x: *mut xml.Doc, holder: u32) -> u32 {
    if holder == xml.NONE {
        return 0 as u32
    }
    let c: u32 = ooxml.first_el(x, holder)
    if c == xml.NONE {
        return 0 as u32
    }
    if ooxml.is_el(x, c, "gsLst") {
        return color_node(p, x, ooxml.first_el(x, ooxml.first_el(x, c)))
    }
    return color_node(p, x, c)
}

fn tint_of(col: u32, k: f64) -> u32 {
    return mix_white(col, k)
}
