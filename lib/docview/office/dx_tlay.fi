import std.rt
import std.vec
import docview.office.dx_props
import docview.office.dx_model
import docview.office.dx_lay
import docview.office.dx_prim
import docview.office.dx_play

export { Geo, geo_new, geo_free, table_geo, lay_row, lay_flow, lay_table, row_count, DEFAULT_MAR_LR }

const DEFAULT_MAR_LR: i32 = 108

struct Geo {
    cols: Vec[f64],
    ncols: usize,
    x0: f64,
    total: f64,
    mar_l: f64,
    mar_r: f64,
    mar_t: f64,
    mar_b: f64,
}

struct CellRec {
    ci: u32,
    col: u32,
    span: u32,
    s: u32,
    e: u32,
    h: f64,
}

fn geo_new() -> Geo {
    return Geo { cols: vec_new[f64](), ncols: 0, x0: 0.0, total: 0.0, mar_l: 7.2, mar_r: 7.2, mar_t: 0.0, mar_b: 0.0 }
}

fn geo_free(g: *mut Geo) {
    vec_free[f64](&(*g).cols)
}

fn row_count(d: *mut dx_model.Docx, ti: u32) -> usize {
    var n: usize = 0
    var r: u32 = (*dx_model.table_at(d, ti)).rows_head
    while r != dx_model.NIL {
        n = n + 1
        r = (*dx_model.row_at(d, r)).next
    }
    return n
}

fn row_cols(d: *mut dx_model.Docx, ri: u32) -> usize {
    var n: usize = 0
    var c: u32 = (*dx_model.row_at(d, ri)).cells_head
    while c != dx_model.NIL {
        var s: i32 = (*dx_model.cell_at(d, c)).span
        if s < 1 { s = 1 }
        n = n + (s as usize)
        c = (*dx_model.cell_at(d, c)).next
    }
    return n
}

fn grid_widths(d: *mut dx_model.Docx, ti: u32, out: *mut Vec[f64]) {
    let t: *mut dx_model.Table = dx_model.table_at(d, ti)
    var i: u32 = 0
    while i < (*t).gn {
        vec_push[f64](out, ((*vec_elem_ptr[i32](&(*d).grid, ((*t).goff + i) as usize)) as f64) / 15.0)
        i = i + 1
    }
    if (*t).gn > 0 {
        return
    }
    var maxc: usize = 0
    var r: u32 = (*t).rows_head
    while r != dx_model.NIL {
        let n: usize = row_cols(d, r)
        if n > maxc { maxc = n }
        r = (*dx_model.row_at(d, r)).next
    }
    if maxc > 64 { maxc = 64 }
    var k: usize = 0
    while k < maxc {
        vec_push[f64](out, 0.0)
        k = k + 1
    }
    if maxc == 0 {
        return
    }
    var first: u32 = (*t).rows_head
    var c: u32 = (*dx_model.row_at(d, first)).cells_head
    var col: usize = 0
    while c != dx_model.NIL && col < maxc {
        let ce: *mut dx_model.Cell = dx_model.cell_at(d, c)
        var s: usize = (*ce).span as usize
        if s < 1 { s = 1 }
        let w: f64 = ((*ce).width as f64) / 15.0
        var j: usize = 0
        while j < s && col + j < maxc {
            *vec_elem_ptr[f64](out, col + j) = w / (s as f64)
            j = j + 1
        }
        col = col + s
        c = (*ce).next
    }
}

fn table_geo(l: *mut dx_lay.Lay, ti: u32, x0: f64, avail: f64, g: *mut Geo) {
    let d: *mut dx_model.Docx = (*l).d
    let t: *mut dx_model.Table = dx_model.table_at(d, ti)
    vec_clear[f64](&(*g).cols)
    var w: Vec[f64] = vec_new[f64]()
    defer vec_free[f64](&w)
    grid_widths(d, ti, &w)
    var n: usize = vec_len[f64](&w)
    if n > 512 { n = 512 }
    var sum: f64 = 0.0
    var zero: usize = 0
    var i: usize = 0
    while i < n {
        let v: f64 = *vec_elem_ptr[f64](&w, i)
        sum = sum + v
        if v < 1.0 { zero = zero + 1 }
        i = i + 1
    }
    if n == 0 {
        n = 1
        vec_push[f64](&w, avail)
        sum = avail
    } else if zero > 0 || sum < 1.0 {
        var eq: f64 = avail / (n as f64)
        i = 0
        while i < n {
            *vec_elem_ptr[f64](&w, i) = eq
            i = i + 1
        }
        sum = avail
    }
    var scale: f64 = 1.0
    if sum > avail && avail > 8.0 {
        scale = avail / sum
    }
    (*g).ncols = n
    var acc: f64 = 0.0
    vec_push[f64](&(*g).cols, 0.0)
    i = 0
    while i < n {
        acc = acc + (*vec_elem_ptr[f64](&w, i)) * scale
        vec_push[f64](&(*g).cols, acc)
        i = i + 1
    }
    (*g).total = acc
    var indent: f64 = 0.0
    if (*t).tp.indent != dx_props.UNSET_T {
        indent = ((*t).tp.indent as f64) / 15.0
    }
    var ox: f64 = indent
    if (*t).tp.align == dx_props.ALIGN_CENTER {
        ox = (avail - acc) / 2.0
    } else if (*t).tp.align == dx_props.ALIGN_RIGHT {
        ox = avail - acc
    }
    if ox < 0.0 { ox = 0.0 }
    (*g).x0 = x0 + ox
    var ml: i32 = (*t).tp.mar_left
    var mr: i32 = (*t).tp.mar_right
    var mt: i32 = (*t).tp.mar_top
    var mb: i32 = (*t).tp.mar_bottom
    if ml == dx_props.UNSET_T { ml = DEFAULT_MAR_LR }
    if mr == dx_props.UNSET_T { mr = DEFAULT_MAR_LR }
    if mt == dx_props.UNSET_T { mt = 0 }
    if mb == dx_props.UNSET_T { mb = 0 }
    (*g).mar_l = ((ml as f64) / 15.0)
    (*g).mar_r = ((mr as f64) / 15.0)
    (*g).mar_t = ((mt as f64) / 15.0)
    (*g).mar_b = ((mb as f64) / 15.0)
}

fn border_px(b: dx_props.Border) -> f64 {
    if b.sz <= 0 {
        return 0.0
    }
    var t: f64 = (b.sz as f64) / 6.0
    if t < 1.0 { t = 1.0 }
    return t
}

fn pick(cell_b: dx_props.Border, table_b: dx_props.Border) -> dx_props.Border {
    if cell_b.sz >= 0 {
        return cell_b
    }
    return table_b
}

fn push_border(sink: *mut Vec[dx_prim.Prim], b: dx_props.Border, x: f64, y: f64, w: f64, h: f64, hf: u32) {
    if border_px(b) <= 0.0 {
        return
    }
    var p: dx_prim.Prim = dx_prim.prim_rect(b.color, x, y, w, h)
    p.flags = hf
    vec_push[dx_prim.Prim](sink, p)
}

fn draw_cell_borders(t: *mut dx_model.Table, ce: *mut dx_model.Cell, first_row: bool, last_row: bool, col: usize,
    span: usize, ncols: usize, x: f64, y: f64, w: f64, h: f64, sink: *mut Vec[dx_prim.Prim], hf: u32) {
    var tp_top: dx_props.Border = (*t).tp.inner_h
    if first_row { tp_top = (*t).tp.top }
    var tp_bot: dx_props.Border = (*t).tp.inner_h
    if last_row { tp_bot = (*t).tp.bottom }
    var tp_left: dx_props.Border = (*t).tp.inner_v
    if col == 0 { tp_left = (*t).tp.left }
    var tp_right: dx_props.Border = (*t).tp.inner_v
    if col + span >= ncols { tp_right = (*t).tp.right }
    let bt: dx_props.Border = pick((*ce).bt, tp_top)
    let bb: dx_props.Border = pick((*ce).bb, tp_bot)
    let bl: dx_props.Border = pick((*ce).bl, tp_left)
    let br: dx_props.Border = pick((*ce).br, tp_right)
    let tt: f64 = border_px(bt)
    let tb: f64 = border_px(bb)
    let tl: f64 = border_px(bl)
    let tr: f64 = border_px(br)
    push_border(sink, bt, x, y - tt / 2.0, w, tt, hf)
    push_border(sink, bb, x, y + h - tb / 2.0, w, tb, hf)
    push_border(sink, bl, x - tl / 2.0, y, tl, h, hf)
    push_border(sink, br, x + w - tr / 2.0, y, tr, h, hf)
}

fn lay_row(l: *mut dx_lay.Lay, ti: u32, ri: u32, g: *mut Geo, y: f64, sink: *mut Vec[dx_prim.Prim], hf: u32,
    first_row: bool, last_row: bool) -> f64 {
    let d: *mut dx_model.Docx = (*l).d
    let t: *mut dx_model.Table = dx_model.table_at(d, ti)
    var scratch: Vec[dx_prim.Prim] = vec_new[dx_prim.Prim]()
    defer vec_free[dx_prim.Prim](&scratch)
    var recs: Vec[CellRec] = vec_new[CellRec]()
    defer vec_free[CellRec](&recs)
    var col: usize = 0
    var row_h: f64 = 0.0
    var c: u32 = (*dx_model.row_at(d, ri)).cells_head
    while c != dx_model.NIL && col < (*g).ncols {
        let ce: *mut dx_model.Cell = dx_model.cell_at(d, c)
        var span: usize = (*ce).span as usize
        if span < 1 { span = 1 }
        if col + span > (*g).ncols { span = (*g).ncols - col }
        let cw: f64 = *vec_elem_ptr[f64](&(*g).cols, col + span) - *vec_elem_ptr[f64](&(*g).cols, col)
        var inner: f64 = cw - (*g).mar_l - (*g).mar_r
        if inner < 8.0 { inner = 8.0 }
        let s: usize = vec_len[dx_prim.Prim](&scratch)
        var h: f64 = 0.0
        if (*ce).vmerge != 2 && vec_len[dx_prim.Prim](&scratch) < dx_prim.MAX_PRIMS {
            h = lay_flow(l, &(*ce).blocks, 0.0, inner, &scratch, hf)
        }
        let e: usize = vec_len[dx_prim.Prim](&scratch)
        vec_push[CellRec](&recs, CellRec { ci: c, col: col as u32, span: span as u32, s: s as u32, e: e as u32, h: h })
        if h + (*g).mar_t + (*g).mar_b > row_h {
            row_h = h + (*g).mar_t + (*g).mar_b
        }
        col = col + span
        c = (*ce).next
    }
    let rw: *mut dx_model.Row = dx_model.row_at(d, ri)
    let want: f64 = ((*rw).height as f64) / 15.0
    if (*rw).exact && want > 0.0 {
        row_h = want
    } else if want > row_h {
        row_h = want
    }
    if row_h < 1.0 {
        row_h = 1.0
    }
    var k: usize = 0
    let nr: usize = vec_len[CellRec](&recs)
    while k < nr {
        let rc: *mut CellRec = vec_elem_ptr[CellRec](&recs, k)
        let ce2: *mut dx_model.Cell = dx_model.cell_at(d, (*rc).ci)
        let cx: f64 = (*g).x0 + *vec_elem_ptr[f64](&(*g).cols, (*rc).col as usize)
        let cw2: f64 = *vec_elem_ptr[f64](&(*g).cols, ((*rc).col + (*rc).span) as usize) - *vec_elem_ptr[f64](&(*g).cols, (*rc).col as usize)
        if (*ce2).shade != 0 as u32 {
            var sp: dx_prim.Prim = dx_prim.prim_rect((*ce2).shade, cx, y, cw2, row_h)
            sp.flags = hf
            vec_push[dx_prim.Prim](sink, sp)
        }
        dx_prim.prims_move(sink, &scratch, (*rc).s as usize, ((*rc).e - (*rc).s) as usize, cx + (*g).mar_l, y + (*g).mar_t)
        draw_cell_borders(t, ce2, first_row, last_row, (*rc).col as usize, (*rc).span as usize, (*g).ncols, cx, y, cw2,
            row_h, sink, hf)
        k = k + 1
    }
    return row_h
}

fn lay_table(l: *mut dx_lay.Lay, ti: u32, x0: f64, avail: f64, y: f64, sink: *mut Vec[dx_prim.Prim], hf: u32) -> f64 {
    let d: *mut dx_model.Docx = (*l).d
    var g: Geo = geo_new()
    defer geo_free(&g)
    table_geo(l, ti, x0, avail, &g)
    var acc: f64 = 0.0
    var r: u32 = (*dx_model.table_at(d, ti)).rows_head
    var first: bool = true
    while r != dx_model.NIL {
        let nx: u32 = (*dx_model.row_at(d, r)).next
        if vec_len[dx_prim.Prim](sink) >= dx_prim.MAX_PRIMS {
            break
        }
        acc = acc + lay_row(l, ti, r, &g, y + acc, sink, hf, first, nx == dx_model.NIL)
        first = false
        r = nx
    }
    return acc
}

fn lay_flow(l: *mut dx_lay.Lay, bl: *mut dx_model.BList, x0: f64, width: f64, sink: *mut Vec[dx_prim.Prim], hf: u32) -> f64 {
    let d: *mut dx_model.Docx = (*l).d
    var y: f64 = 0.0
    var b: u32 = (*bl).head
    while b != dx_model.NIL {
        if vec_len[dx_prim.Prim](sink) >= dx_prim.MAX_PRIMS {
            break
        }
        let blk: *mut dx_model.Block = dx_model.block_at(d, b)
        if (*blk).kind == dx_model.B_PARA {
            let pi: u32 = (*blk).idx
            let before: f64 = ((*dx_model.para_at(d, pi)).pp.before as f64) / 15.0
            let after: f64 = ((*dx_model.para_at(d, pi)).pp.after as f64) / 15.0
            let h: f64 = dx_play.para_break(l, pi, width)
            y = y + before
            dx_play.para_emit(l, pi, x0, width, 0, vec_len[dx_lay.LineRec](&(*l).lines), y, sink, hf)
            y = y + h + after
        } else {
            y = y + lay_table(l, (*blk).idx, x0, width, y, sink, hf)
        }
        b = (*dx_model.block_at(d, b)).next
    }
    return y
}
