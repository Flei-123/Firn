import std.rt
import std.vec
import docview.office.dx_props
import docview.office.dx_model
import docview.office.dx_lay
import docview.office.dx_prim
import docview.office.dx_play
import docview.office.dx_gap
import docview.office.dx_tgeo

export { lay_row, lay_flow, lay_table }

const MAX_GROUP_ROWS: usize = 64

struct CellRec {
    ci: u32,
    col: u32,
    span: u32,
    row_k: u32,
    rows: u32,
    alive: bool,
    s: u32,
    e: u32,
    h: f64,
}

struct RowRec {
    ri: u32,
    h: f64,
}

fn find_open(recs: *mut Vec[CellRec], col: usize) -> i64 {
    var i: usize = vec_len[CellRec](recs)
    while i > 0 {
        i = i - 1
        let r: *mut CellRec = vec_elem_ptr[CellRec](recs, i)
        if (*r).alive && (*r).col == (col as u32) {
            return i as i64
        }
    }
    return -1
}

fn lay_cells(l: *mut dx_lay.Lay, ri: u32, k: u32, g: *mut dx_tgeo.Geo, hf: u32, scratch: *mut Vec[dx_prim.Prim],
    recs: *mut Vec[CellRec]) -> usize {
    let d: *mut dx_model.Docx = (*l).d
    var matched: usize = 0
    var col: usize = 0
    var c: u32 = (*dx_model.row_at(d, ri)).cells_head
    var i: usize = vec_len[CellRec](recs)
    while i > 0 {
        i = i - 1
        let r: *mut CellRec = vec_elem_ptr[CellRec](recs, i)
        if (*r).alive && (*r).row_k + (*r).rows < k {
            (*r).alive = false
        }
    }
    while c != dx_model.NIL && col < (*g).ncols {
        let ce: *mut dx_model.Cell = dx_model.cell_at(d, c)
        var span: usize = (*ce).span as usize
        if span < 1 { span = 1 }
        if col + span > (*g).ncols { span = (*g).ncols - col }
        if (*ce).vmerge == 2 {
            let oi: i64 = find_open(recs, col)
            if oi >= 0 {
                let orc: *mut CellRec = vec_elem_ptr[CellRec](recs, oi as usize)
                (*orc).rows = k - (*orc).row_k + (1 as u32)
                matched = matched + 1
                col = col + span
                c = (*ce).next
                continue
            }
        }
        let cw: f64 = *vec_elem_ptr[f64](&(*g).cols, col + span) - *vec_elem_ptr[f64](&(*g).cols, col)
        var inner: f64 = cw - (*g).mar_l - (*g).mar_r
        if inner < 8.0 { inner = 8.0 }
        let s: usize = vec_len[dx_prim.Prim](scratch)
        var h: f64 = 0.0
        if (*ce).vmerge != 2 && s < dx_prim.MAX_PRIMS {
            h = lay_flow(l, &(*ce).blocks, 0.0, inner, scratch, hf)
        }
        let e: usize = vec_len[dx_prim.Prim](scratch)
        vec_push[CellRec](recs, CellRec { ci: c, col: col as u32, span: span as u32, row_k: k, rows: 1 as u32,
            alive: (*ce).vmerge == 1, s: s as u32, e: e as u32, h: h })
        col = col + span
        c = (*ce).next
    }
    return matched
}

fn lay_row(l: *mut dx_lay.Lay, ti: u32, ri: u32, g: *mut dx_tgeo.Geo, y: f64, sink: *mut Vec[dx_prim.Prim], hf: u32,
    first_row: bool, next_out: *mut u32) -> f64 {
    let d: *mut dx_model.Docx = (*l).d
    let t: *mut dx_model.Table = dx_model.table_at(d, ti)
    var scratch: Vec[dx_prim.Prim] = vec_new[dx_prim.Prim]()
    defer vec_free[dx_prim.Prim](&scratch)
    var recs: Vec[CellRec] = vec_new[CellRec]()
    defer vec_free[CellRec](&recs)
    var rows: Vec[RowRec] = vec_new[RowRec]()
    defer vec_free[RowRec](&rows)
    var r: u32 = ri
    var k: u32 = 0
    var after: u32 = dx_model.NIL
    while r != dx_model.NIL {
        let save_recs: usize = vec_len[CellRec](&recs)
        let save_prims: usize = vec_len[dx_prim.Prim](&scratch)
        let matched: usize = lay_cells(l, r, k, g, hf, &scratch, &recs)
        if k > 0 && matched == 0 {
            vec_shorten[CellRec](&recs, save_recs)
            vec_shorten[dx_prim.Prim](&scratch, save_prims)
            after = r
            break
        }
        vec_push[RowRec](&rows, RowRec { ri: r, h: 0.0 })
        after = (*dx_model.row_at(d, r)).next
        var any_alive: bool = false
        var q: usize = 0
        while q < vec_len[CellRec](&recs) {
            let rc: *mut CellRec = vec_elem_ptr[CellRec](&recs, q)
            if (*rc).alive && (*rc).row_k + (*rc).rows == k + (1 as u32) {
                any_alive = true
            }
            q = q + 1
        }
        if !any_alive || (k as usize) + 1 >= MAX_GROUP_ROWS {
            break
        }
        r = after
        k = k + 1
    }
    *next_out = after
    let nrows: usize = vec_len[RowRec](&rows)
    var q2: usize = 0
    while q2 < vec_len[CellRec](&recs) {
        let rc2: *mut CellRec = vec_elem_ptr[CellRec](&recs, q2)
        if (*rc2).rows == (1 as u32) {
            let rr: *mut RowRec = vec_vec_row(&rows, (*rc2).row_k as usize)
            if (*rc2).h + (*g).mar_t + (*g).mar_b > (*rr).h {
                (*rr).h = (*rc2).h + (*g).mar_t + (*g).mar_b
            }
        }
        q2 = q2 + 1
    }
    var k2: usize = 0
    while k2 < nrows {
        let rr2: *mut RowRec = vec_vec_row(&rows, k2)
        let rw: *mut dx_model.Row = dx_model.row_at(d, (*rr2).ri)
        let want: f64 = ((*rw).height as f64) / 15.0
        if (*rw).exact && want > 0.0 {
            (*rr2).h = want
        } else if want > (*rr2).h {
            (*rr2).h = want
        }
        if (*rr2).h < 1.0 {
            (*rr2).h = 1.0
        }
        k2 = k2 + 1
    }
    q2 = 0
    while q2 < vec_len[CellRec](&recs) {
        let rc3: *mut CellRec = vec_elem_ptr[CellRec](&recs, q2)
        if (*rc3).rows > (1 as u32) {
            let last_k: usize = ((*rc3).row_k + (*rc3).rows - (1 as u32)) as usize
            var have: f64 = 0.0
            var m: usize = (*rc3).row_k as usize
            while m <= last_k {
                have = have + (*vec_vec_row(&rows, m)).h
                m = m + 1
            }
            let need: f64 = (*rc3).h + (*g).mar_t + (*g).mar_b
            if need > have {
                (*vec_vec_row(&rows, last_k)).h = (*vec_vec_row(&rows, last_k)).h + (need - have)
            }
        }
        q2 = q2 + 1
    }
    var total: f64 = 0.0
    k2 = 0
    while k2 < nrows {
        total = total + (*vec_vec_row(&rows, k2)).h
        k2 = k2 + 1
    }
    let table_end: bool = after == dx_model.NIL
    var qi: usize = 0
    while qi < vec_len[CellRec](&recs) {
        let rc4: *mut CellRec = vec_elem_ptr[CellRec](&recs, qi)
        let ce2: *mut dx_model.Cell = dx_model.cell_at(d, (*rc4).ci)
        var off: f64 = 0.0
        var mm: usize = 0
        while mm < ((*rc4).row_k as usize) {
            off = off + (*vec_vec_row(&rows, mm)).h
            mm = mm + 1
        }
        var ch: f64 = 0.0
        while mm < ((*rc4).row_k + (*rc4).rows) as usize {
            ch = ch + (*vec_vec_row(&rows, mm)).h
            mm = mm + 1
        }
        let cx: f64 = (*g).x0 + *vec_elem_ptr[f64](&(*g).cols, (*rc4).col as usize)
        let cw2: f64 = *vec_elem_ptr[f64](&(*g).cols, ((*rc4).col + (*rc4).span) as usize) - *vec_elem_ptr[f64](&(*g).cols, (*rc4).col as usize)
        if (*ce2).shade != 0 as u32 {
            var sp: dx_prim.Prim = dx_prim.prim_rect((*ce2).shade, cx, y + off, cw2, ch)
            sp.flags = hf
            vec_push[dx_prim.Prim](sink, sp)
        }
        dx_prim.prims_move(sink, &scratch, (*rc4).s as usize, ((*rc4).e - (*rc4).s) as usize, cx + (*g).mar_l, y + off + (*g).mar_t)
        dx_tgeo.draw_cell_borders(t, ce2, first_row && (*rc4).row_k == (0 as u32),
            table_end && (*rc4).row_k + (*rc4).rows == (nrows as u32), (*rc4).col as usize, (*rc4).span as usize,
            (*g).ncols, cx, y + off, cw2, ch, sink, hf)
        qi = qi + 1
    }
    return total
}

fn vec_vec_row(rows: *mut Vec[RowRec], i: usize) -> *mut RowRec {
    return vec_elem_ptr[RowRec](rows, i)
}

fn lay_table(l: *mut dx_lay.Lay, ti: u32, x0: f64, avail: f64, y: f64, sink: *mut Vec[dx_prim.Prim], hf: u32) -> f64 {
    let d: *mut dx_model.Docx = (*l).d
    var g: dx_tgeo.Geo = dx_tgeo.geo_new()
    defer dx_tgeo.geo_free(&g)
    dx_tgeo.table_geo(l, ti, x0, avail, &g)
    var acc: f64 = 0.0
    var r: u32 = (*dx_model.table_at(d, ti)).rows_head
    var first: bool = true
    while r != dx_model.NIL {
        if vec_len[dx_prim.Prim](sink) >= dx_prim.MAX_PRIMS {
            break
        }
        var nx: u32 = dx_model.NIL
        acc = acc + lay_row(l, ti, r, &g, y + acc, sink, hf, first, &nx)
        first = false
        r = nx
    }
    return acc
}

fn lay_flow(l: *mut dx_lay.Lay, bl: *mut dx_model.BList, x0: f64, width: f64, sink: *mut Vec[dx_prim.Prim], hf: u32) -> f64 {
    let d: *mut dx_model.Docx = (*l).d
    var y: f64 = 0.0
    var b: u32 = (*bl).head
    var prev: u32 = dx_model.NIL
    while b != dx_model.NIL {
        if vec_len[dx_prim.Prim](sink) >= dx_prim.MAX_PRIMS {
            break
        }
        let blk: *mut dx_model.Block = dx_model.block_at(d, b)
        if (*blk).kind == dx_model.B_PARA {
            let pi: u32 = (*blk).idx
            var before: f64 = ((*dx_model.para_at(d, pi)).pp.before as f64) / 15.0
            var after: f64 = ((*dx_model.para_at(d, pi)).pp.after as f64) / 15.0
            if dx_gap.before_zero(d, prev, b) {
                before = 0.0
            }
            if dx_gap.after_zero(d, b, (*blk).next) {
                after = 0.0
            }
            let h: f64 = dx_play.para_break(l, pi, width)
            y = y + before
            let hook: dx_lay.ParaHook = (*l).hook
            hook(l, pi, x0, width, y, sink, hf, true)
            dx_play.para_emit(l, pi, x0, width, 0, vec_len[dx_lay.LineRec](&(*l).lines), y, sink, hf)
            hook(l, pi, x0, width, y, sink, hf, false)
            y = y + h + after
        } else {
            y = y + lay_table(l, (*blk).idx, x0, width, y, sink, hf)
        }
        prev = b
        b = (*dx_model.block_at(d, b)).next
    }
    return y
}
