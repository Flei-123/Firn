import std.rt
import docview.office.opc
import docview.office.dx_style
import docview.office.dx_num

export { Ctx, ctx_new, ctx_free, MAX_DEPTH, MAX_TABLE_DEPTH, MAX_SECTS }

const MAX_DEPTH: i32 = 48
const MAX_TABLE_DEPTH: i32 = 6
const MAX_SECTS: usize = 5000

struct Ctx {
    pk: *mut opc.Package,
    st: dx_style.Styles,
    nm: dx_num.Numbering,
    rels: *mut opc.Rels,
    sect_idx: u32,
    table_depth: i32,
    instr: rt.Buf,
}

fn ctx_new(pk: *mut opc.Package) -> Ctx {
    return Ctx { pk: pk, st: dx_style.styles_new(), nm: dx_num.numbering_new(), rels: 0 as *mut opc.Rels,
        sect_idx: 0 as u32, table_depth: 0, instr: rt.buf_new() }
}

fn ctx_free(c: *mut Ctx) {
    dx_style.styles_free(&(*c).st)
    dx_num.numbering_free(&(*c).nm)
    rt.buf_free(&(*c).instr)
}
