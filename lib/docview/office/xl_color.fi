// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.xml
import docview.office.ooxml

export { Theme, theme_new, theme_load, color_of, pack_rgb }

struct Theme {
    c: [u32; 12],
}

fn pack_rgb(v: u32) -> u32 {
    let r: u32 = (v >> 16 as u32) & 255 as u32
    let g: u32 = (v >> 8 as u32) & 255 as u32
    let b: u32 = v & 255 as u32
    return 0xFF000000 as u32 | (b << 16 as u32) | (g << 8 as u32) | r
}

fn theme_new() -> Theme {
    return Theme { c: [
        pack_rgb(0xFFFFFF as u32), pack_rgb(0x000000 as u32), pack_rgb(0xE7E6E6 as u32), pack_rgb(0x44546A as u32),
        pack_rgb(0x4472C4 as u32), pack_rgb(0xED7D31 as u32), pack_rgb(0xA5A5A5 as u32), pack_rgb(0xFFC000 as u32),
        pack_rgb(0x5B9BD5 as u32), pack_rgb(0x70AD47 as u32), pack_rgb(0x0563C1 as u32), pack_rgb(0x954F72 as u32)] }
}

fn hex6(s: str, at: usize) -> u32 {
    var v: u32 = 0
    var i: usize = 0
    while i < 6 {
        let c: u8 = rt.ld8(s.p as u64, at + i)
        var h: u32 = 0
        if c >= (48 as u8) && c <= (57 as u8) {
            h = (c - (48 as u8)) as u32
        } else if c >= (97 as u8) && c <= (102 as u8) {
            h = ((c - (97 as u8)) as u32) + 10
        } else if c >= (65 as u8) && c <= (70 as u8) {
            h = ((c - (65 as u8)) as u32) + 10
        }
        v = (v << 4 as u32) | h
        i = i + 1
    }
    return v
}

fn rgb_attr(s: str) -> u32 {
    if s.n == 8 {
        return pack_rgb(hex6(s, 2))
    }
    if s.n == 6 {
        return pack_rgb(hex6(s, 0))
    }
    return 0 as u32
}

fn theme_load(t: *mut Theme, x: *mut xml.Doc) {
    let root: u32 = xml.root(x)
    let te: u32 = ooxml.child_l(x, root, "themeElements")
    let cs: u32 = ooxml.child_l(x, te, "clrScheme")
    var k: usize = 0
    var c: u32 = ooxml.first_el(x, cs)
    while c != xml.NONE && k < 12 {
        let inner: u32 = ooxml.first_el(x, c)
        var v: u32 = 0
        if inner != xml.NONE {
            if ooxml.is_el(x, inner, "srgbClr") {
                v = rgb_attr(ooxml.attr_l(x, inner, "val"))
            } else {
                v = rgb_attr(ooxml.attr_l(x, inner, "lastClr"))
            }
        }
        if v != 0 as u32 {
            var slot: usize = k
            if k == 0 { slot = 1 }
            if k == 1 { slot = 0 }
            if k == 2 { slot = 3 }
            if k == 3 { slot = 2 }
            (*t).c[slot] = v
        }
        k = k + 1
        c = ooxml.next_el(x, c)
    }
}

fn indexed(i: i64) -> u32 {
    let tbl: str = ""
    if i == 64 { return pack_rgb(0 as u32) }
    if i == 65 { return pack_rgb(0xFFFFFF as u32) }
    var k: i64 = i
    if k < 0 || k >= 64 {
        return 0xFF000000 as u32
    }
    if k < 8 {
        k = k + 8
    }
    let off: usize = ((k - 8) as usize) * 6
    if off + 6 > tbl.n {
        return 0xFF000000 as u32
    }
    return pack_rgb(hex6(tbl, off))
}

fn tint_channel(c: u32, tint: f64) -> u32 {
    var v: f64 = c as f64
    if tint > 0.0 {
        v = v + (255.0 - v) * tint
    } else {
        v = v * (1.0 + tint)
    }
    if v < 0.0 { v = 0.0 }
    if v > 255.0 { v = 255.0 }
    return (v + 0.5) as u32
}

fn apply_tint(col: u32, tint: f64) -> u32 {
    let r: u32 = tint_channel(col & 255 as u32, tint)
    let g: u32 = tint_channel((col >> 8 as u32) & 255 as u32, tint)
    let b: u32 = tint_channel((col >> 16 as u32) & 255 as u32, tint)
    return 0xFF000000 as u32 | (b << 16 as u32) | (g << 8 as u32) | r
}

fn parse_tint(s: str) -> f64 {
    if s.n == 0 {
        return 0.0
    }
    var i: usize = 0
    var neg: bool = false
    if rt.ld8(s.p as u64, 0) == (45 as u8) {
        neg = true
        i = 1
    }
    var v: f64 = 0.0
    var scale: f64 = 0.0
    while i < s.n {
        let c: u8 = rt.ld8(s.p as u64, i)
        if c == (46 as u8) {
            scale = 1.0
        } else if c >= (48 as u8) && c <= (57 as u8) {
            let dgt: f64 = ((c - (48 as u8)) as f64)
            if scale == 0.0 {
                v = v * 10.0 + dgt
            } else {
                scale = scale / 10.0
                v = v + dgt * scale
            }
        } else {
            break
        }
        i = i + 1
    }
    if neg {
        return 0.0 - v
    }
    return v
}

fn color_of(x: *mut xml.Doc, n: u32, t: *mut Theme) -> u32 {
    if n == xml.NONE {
        return 0 as u32
    }
    var col: u32 = 0
    let rgb: str = ooxml.attr_l(x, n, "rgb")
    if rgb.n > 0 {
        col = rgb_attr(rgb)
    } else if ooxml.has_attr_l(x, n, "indexed") {
        col = indexed(ooxml.attr_i64(x, n, "indexed", 0))
    } else if ooxml.has_attr_l(x, n, "theme") {
        let ti: i64 = ooxml.attr_i64(x, n, "theme", 0)
        if ti >= 0 && ti < 12 {
            col = (*t).c[ti as usize]
        }
    }
    if col != 0 as u32 {
        let tint: f64 = parse_tint(ooxml.attr_l(x, n, "tint"))
        if tint != 0.0 {
            col = apply_tint(col, tint)
        }
    }
    return col
}
