import std.rt
import std.xml
import docview.office.ooxml
import docview.office.dx_model
import docview.office.dx_ctx
import docview.office.dx_drawutil

export { parse_anchor, parse_vml_box }

fn float_new() -> dx_model.Float {
    return dx_model.Float { img: -1, w: 96.0, h: 96.0, hrel: dx_model.REL_MARGIN, vrel: dx_model.REL_PARA, hoff: 0.0,
        voff: 0.0, halign: -1, valign: -1, behind: false, fill: 0 as u32, ins_l: 9.6, ins_t: 4.8, ins_r: 9.6, ins_b: 4.8,
        tx_node: xml.NONE, blocks: dx_model.blist_new(), vtext: 0, line: 0 as u32, line_w: 0.0 }
}

fn rel_of(v: str, horizontal: bool) -> i32 {
    if v == "page" {
        return dx_model.REL_PAGE
    }
    if horizontal {
        if v == "character" {
            return dx_model.REL_PARA
        }
        return dx_model.REL_MARGIN
    }
    if v == "paragraph" || v == "line" || v == "insideMargin" {
        return dx_model.REL_PARA
    }
    return dx_model.REL_MARGIN
}

fn align_of(v: str) -> i32 {
    if v == "left" || v == "top" || v == "inside" {
        return 0
    }
    if v == "center" {
        return 1
    }
    if v == "right" || v == "bottom" || v == "outside" {
        return 2
    }
    return -1
}

fn read_axis(x: *mut xml.Doc, anc: u32, tag: str, horizontal: bool, rel: *mut i32, off: *mut f64, align: *mut i32) {
    let pn: u32 = ooxml.child_l(x, anc, tag)
    if pn == xml.NONE {
        return
    }
    *rel = rel_of(ooxml.attr_l(x, pn, "relativeFrom"), horizontal)
    let po: u32 = ooxml.child_l(x, pn, "posOffset")
    if po != xml.NONE {
        *off = dx_drawutil.emu_px(ooxml.parse_i64(xml.text(x, po), 0))
    }
    let al: u32 = ooxml.child_l(x, pn, "align")
    if al != xml.NONE {
        *align = align_of(xml.text(x, al))
    }
}

fn inset_px(x: *mut xml.Doc, n: u32, name: str, dflt: i64) -> f64 {
    var v: f64 = dx_drawutil.emu_px(ooxml.attr_i64(x, n, name, dflt))
    if v < 0.0 { v = 0.0 }
    if v > 400.0 { v = 400.0 }
    return v
}

fn read_fill(x: *mut xml.Doc, wsp: u32) -> u32 {
    let sp: u32 = ooxml.child_l(x, wsp, "spPr")
    if sp == xml.NONE {
        return 0 as u32
    }
    let sf: u32 = ooxml.child_l(x, sp, "solidFill")
    if sf == xml.NONE {
        return 0 as u32
    }
    let clr: u32 = ooxml.child_l(x, sf, "srgbClr")
    if clr == xml.NONE {
        return 0 as u32
    }
    return ooxml.attr_u32_hex(x, clr, "val", 0 as u32)
}

fn parse_anchor(c: *mut dx_ctx.Ctx, d: *mut dx_model.Docx, x: *mut xml.Doc, anc: u32) -> u32 {
    var f: dx_model.Float = float_new()
    let bd: str = ooxml.attr_l(x, anc, "behindDoc")
    f.behind = bd == "1" || bd == "true"
    let ext: u32 = ooxml.child_l(x, anc, "extent")
    if ext != xml.NONE {
        f.w = dx_drawutil.clampf(dx_drawutil.emu_px(ooxml.attr_i64(x, ext, "cx", 914400)), 1.0, 30000.0)
        f.h = dx_drawutil.clampf(dx_drawutil.emu_px(ooxml.attr_i64(x, ext, "cy", 914400)), 1.0, 30000.0)
    }
    read_axis(x, anc, "positionH", true, &f.hrel, &f.hoff, &f.halign)
    read_axis(x, anc, "positionV", false, &f.vrel, &f.voff, &f.valign)
    let blip: u32 = dx_drawutil.find_desc(x, anc, "blip", 0)
    if blip != xml.NONE {
        var part: rt.Buf = rt.buf_new()
        defer rt.buf_free(&part)
        if dx_drawutil.rel_part(c, ooxml.attr_l(x, blip, "embed"), &part) {
            f.img = dx_model.new_image(d, rt.buf_str(&part)) as i32
        }
    } else {
        let wsp: u32 = dx_drawutil.find_desc(x, anc, "wsp", 0)
        if wsp != xml.NONE {
            f.fill = read_fill(x, wsp)
            let tx: u32 = dx_drawutil.find_desc(x, wsp, "txbxContent", 0)
            if tx != xml.NONE {
                f.tx_node = tx
                let bp: u32 = ooxml.child_l(x, wsp, "bodyPr")
                if bp != xml.NONE {
                    f.ins_l = inset_px(x, bp, "lIns", 91440)
                    f.ins_t = inset_px(x, bp, "tIns", 45720)
                    f.ins_r = inset_px(x, bp, "rIns", 91440)
                    f.ins_b = inset_px(x, bp, "bIns", 45720)
                }
            }
        }
    }
    if f.img < 0 && f.tx_node == xml.NONE && f.fill == 0 as u32 {
        return dx_model.NIL
    }
    return dx_model.new_float(d, f)
}

fn vml_rel(st: str, key: str, horizontal: bool) -> i32 {
    if dx_drawutil.style_has(st, key) {
        return dx_model.REL_PAGE
    }
    if horizontal {
        return dx_model.REL_MARGIN
    }
    return dx_model.REL_PARA
}

fn parse_vml_box(c: *mut dx_ctx.Ctx, d: *mut dx_model.Docx, x: *mut xml.Doc, pc: u32) -> u32 {
    let tx: u32 = dx_drawutil.find_desc(x, pc, "txbxContent", 0)
    if tx == xml.NONE {
        return dx_model.NIL
    }
    var sh: u32 = dx_drawutil.find_desc(x, pc, "shape", 0)
    if sh == xml.NONE {
        sh = dx_drawutil.find_desc(x, pc, "rect", 0)
    }
    if sh == xml.NONE {
        return dx_model.NIL
    }
    let st: str = ooxml.attr_l(x, sh, "style")
    if !dx_drawutil.style_has(st, "position:absolute") {
        return dx_model.NIL
    }
    var f: dx_model.Float = float_new()
    f.w = dx_drawutil.clampf(dx_drawutil.style_len(st, "width:", 96.0), 1.0, 30000.0)
    f.h = dx_drawutil.clampf(dx_drawutil.style_len(st, "height:", 96.0), 1.0, 30000.0)
    f.hoff = dx_drawutil.clampf(dx_drawutil.style_len(st, "margin-left:", 0.0), -100000.0, 100000.0)
    f.voff = dx_drawutil.clampf(dx_drawutil.style_len(st, "margin-top:", 0.0), -100000.0, 100000.0)
    f.hrel = vml_rel(st, "mso-position-horizontal-relative:page", true)
    f.vrel = vml_rel(st, "mso-position-vertical-relative:page", false)
    if dx_drawutil.style_has(st, "mso-position-vertical-relative:margin") {
        f.vrel = dx_model.REL_MARGIN
    }
    f.behind = dx_drawutil.style_has(st, "z-index:-")
    f.tx_node = tx
    return dx_model.new_float(d, f)
}
