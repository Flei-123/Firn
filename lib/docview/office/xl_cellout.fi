import std.rt
import std.vec
import docview.office.dx_props
import docview.office.dx_model
import docview.office.dx_runs
import docview.office.xl_style
import docview.office.xl_cellval

export { emit_cell_para, apply_cell_style }

fn run_props(f: *mut xl_style.XFont, bold_extra: bool) -> dx_props.RunProps {
    var rp: dx_props.RunProps = dx_props.rp_unset()
    rp.size_hp = (*f).size_hp
    if (*f).bold || bold_extra {
        rp.bold = 1
    }
    if (*f).italic {
        rp.italic = 1
    }
    if (*f).underline {
        rp.underline = dx_props.UL_SINGLE
    }
    if (*f).strike {
        rp.strike = 1
    }
    if (*f).mono {
        rp.mono = 1
    }
    rp.color = (*f).color
    dx_props.rp_finish(&rp)
    return rp
}

fn is_hex(c: u8) -> bool {
    return (c >= (48 as u8) && c <= (57 as u8)) || (c >= (97 as u8) && c <= (102 as u8)) || (c >= (65 as u8) && c <= (70 as u8))
}

fn escape_len(s: str, i: usize) -> usize {
    if i + 7 <= s.n && rt.ld8(s.p as u64, i) == (95 as u8) && rt.ld8(s.p as u64, i + 1) == (120 as u8)
        && rt.ld8(s.p as u64, i + 6) == (95 as u8) {
        var k: usize = 2
        while k < 6 {
            if !is_hex(rt.ld8(s.p as u64, i + k)) {
                return 0
            }
            k = k + 1
        }
        if rt.ld8(s.p as u64, i + 2) == (48 as u8) && rt.ld8(s.p as u64, i + 3) == (48 as u8) && rt.ld8(s.p as u64, i + 4) == (48 as u8) {
            let l: u8 = rt.ld8(s.p as u64, i + 5)
            if l == (100 as u8) || l == (68 as u8) || l == (97 as u8) || l == (65 as u8) {
                return 7
            }
        }
    }
    return 0
}

fn emit_text(d: *mut dx_model.Docx, para: u32, rp: *mut dx_props.RunProps, s: str) {
    var seg: rt.Buf = rt.buf_new()
    defer rt.buf_free(&seg)
    var i: usize = 0
    while i < s.n {
        let c: u8 = rt.ld8(s.p as u64, i)
        let esc: usize = escape_len(s, i)
        if esc > 0 {
            i = i + esc
        } else if c == (10 as u8) {
            dx_runs.emit_text(d, para, rp, rt.buf_ptr(&seg), rt.buf_len(&seg))
            rt.buf_clear(&seg)
            dx_runs.emit_simple(d, rp, dx_model.R_BREAK, dx_model.BR_LINE, 0.0, 0.0)
            i = i + 1
        } else if c == (13 as u8) || (c < (32 as u8) && c != (9 as u8)) {
            i = i + 1
        } else if c == (9 as u8) {
            rt.buf_push(&seg, 32 as u8)
            i = i + 1
        } else {
            rt.buf_push(&seg, c)
            i = i + 1
        }
    }
    dx_runs.emit_text(d, para, rp, rt.buf_ptr(&seg), rt.buf_len(&seg))
}

fn emit_cell_para(d: *mut dx_model.Docx, st: *mut xl_style.XlStyles, xf: *mut xl_style.Xf, kind: i32, text: str,
    sect: u32, bl: *mut dx_model.BList) {
    var f: *mut xl_style.XFont = xl_style.font_at(st, 0)
    if (xf as u64) != 0 {
        f = xl_style.font_at(st, (*xf).font)
    }
    var pp: dx_props.ParaProps = dx_props.pp_unset()
    var align: i32 = -1
    if (xf as u64) != 0 {
        align = (*xf).halign
    }
    if align < 0 {
        if kind == xl_cellval.CK_NUMBER {
            align = dx_props.ALIGN_RIGHT
        } else if kind == xl_cellval.CK_FLAG {
            align = dx_props.ALIGN_CENTER
        } else {
            align = dx_props.ALIGN_LEFT
        }
    }
    pp.align = align
    if (xf as u64) != 0 && (*xf).indent > 0 {
        if align == dx_props.ALIGN_RIGHT {
            pp.right = (*xf).indent * 180
        } else if align == dx_props.ALIGN_LEFT {
            pp.left = (*xf).indent * 180
        }
    }
    dx_props.pp_finish(&pp)
    var rp: dx_props.RunProps = run_props(f, false)
    let idx: u32 = dx_model.new_para(d, pp)
    (*dx_model.para_at(d, idx)).base_rp = rp
    emit_text(d, idx, &rp, text)
    let pb: *mut dx_model.Para = dx_model.para_at(d, idx)
    (*pb).rcount = (vec_len_runs(d) as u32) - (*pb).rfirst
    dx_model.block_add(d, bl, dx_model.B_PARA, idx, sect)
}

fn vec_len_runs(d: *mut dx_model.Docx) -> usize {
    return vec_len[dx_model.Run](&(*d).runs)
}

fn apply_cell_style(st: *mut xl_style.XlStyles, xf: *mut xl_style.Xf, ce: *mut dx_model.Cell) {
    if (xf as u64) == 0 {
        return
    }
    (*ce).shade = xl_style.fill_at(st, (*xf).fill)
    let b: *mut xl_style.XBorder = xl_style.border_at(st, (*xf).border)
    (*ce).bt = (*b).top
    (*ce).bl = (*b).left
    (*ce).bb = (*b).bottom
    (*ce).br = (*b).right
}
