import std.rt
import std.xml
import docview.office.ooxml
import docview.office.dx_props
import docview.office.pp_color
import docview.office.pp_ctx

export { Bullet, bullet_new, lvl_node, read_rpr, read_ppr, read_bullet, chain_props, BK_NONE, BK_CHAR, BK_AUTO, BK_INHERIT }

const BK_INHERIT: i32 = 0
const BK_NONE: i32 = 1
const BK_CHAR: i32 = 2
const BK_AUTO: i32 = 3

struct Bullet {
    kind: i32,
    ch: [u8; 8],
    chn: usize,
    auto: i32,
    start: i32,
}

fn bullet_new() -> Bullet {
    return Bullet { kind: BK_INHERIT, ch: [0 as u8; 8], chn: 0, auto: 0, start: 1 }
}

fn lvl_name(l: i32) -> str {
    if l == 0 { return "lvl1pPr" }
    if l == 1 { return "lvl2pPr" }
    if l == 2 { return "lvl3pPr" }
    if l == 3 { return "lvl4pPr" }
    if l == 4 { return "lvl5pPr" }
    if l == 5 { return "lvl6pPr" }
    if l == 6 { return "lvl7pPr" }
    if l == 7 { return "lvl8pPr" }
    return "lvl9pPr"
}

fn lvl_node(x: *mut xml.Doc, list: u32, l: i32) -> u32 {
    if list == xml.NONE {
        return xml.NONE
    }
    return ooxml.child_l(x, list, lvl_name(l))
}

fn fill_color(c: *mut pp_ctx.Ctx, x: *mut xml.Doc, holder: u32) -> u32 {
    let sf: u32 = ooxml.child_l(x, holder, "solidFill")
    if sf == xml.NONE {
        return 0 as u32
    }
    return pp_color.color_in(&(*c).pal, x, sf)
}

fn read_rpr(c: *mut pp_ctx.Ctx, x: *mut xml.Doc, n: u32, rp: *mut dx_props.RunProps) {
    if n == xml.NONE {
        return
    }
    let sz: i64 = ooxml.attr_i64(x, n, "sz", 0)
    if sz > 0 {
        (*rp).size_hp = (sz / 50) as i32
    }
    if ooxml.has_attr_l(x, n, "b") {
        let v: str = ooxml.attr_l(x, n, "b")
        if v == "1" || v == "true" { (*rp).bold = 1 } else { (*rp).bold = 0 }
    }
    if ooxml.has_attr_l(x, n, "i") {
        let v: str = ooxml.attr_l(x, n, "i")
        if v == "1" || v == "true" { (*rp).italic = 1 } else { (*rp).italic = 0 }
    }
    if ooxml.has_attr_l(x, n, "u") {
        if ooxml.attr_l(x, n, "u") == "none" { (*rp).underline = 0 } else { (*rp).underline = dx_props.UL_SINGLE }
    }
    if ooxml.has_attr_l(x, n, "strike") {
        if ooxml.attr_l(x, n, "strike") == "noStrike" { (*rp).strike = 0 } else { (*rp).strike = 1 }
    }
    if ooxml.has_attr_l(x, n, "cap") {
        if ooxml.attr_l(x, n, "cap") == "all" { (*rp).caps = 1 } else { (*rp).caps = 0 }
    }
    if ooxml.has_attr_l(x, n, "baseline") {
        let b: i64 = ooxml.attr_i64(x, n, "baseline", 0)
        if b > 0 {
            (*rp).vert = dx_props.VA_SUPER
        } else if b < 0 {
            (*rp).vert = dx_props.VA_SUB
        } else {
            (*rp).vert = dx_props.VA_BASE
        }
    }
    let col: u32 = fill_color(c, x, n)
    if col != 0 as u32 {
        (*rp).color = col
    }
    let lat: u32 = ooxml.child_l(x, n, "latin")
    if lat != xml.NONE {
        let tf: str = ooxml.attr_l(x, lat, "typeface")
        if ooxml.starts_with(tf, "Courier") || ooxml.starts_with(tf, "Consolas") || ooxml.starts_with(tf, "Lucida Console") {
            (*rp).mono = 1
        }
    }
}

fn spacing_twips(x: *mut xml.Doc, n: u32, dflt_line: i32) -> i32 {
    let pts: u32 = ooxml.child_l(x, n, "spcPts")
    if pts != xml.NONE {
        return (ooxml.attr_i64(x, pts, "val", 0) / 5) as i32
    }
    let pc: u32 = ooxml.child_l(x, n, "spcPct")
    if pc != xml.NONE {
        return ((ooxml.attr_i64(x, pc, "val", 0) * (dflt_line as i64)) / 100000) as i32
    }
    return dx_props.UNSET_T
}

fn read_ppr(x: *mut xml.Doc, n: u32, pp: *mut dx_props.ParaProps) {
    if n == xml.NONE {
        return
    }
    if ooxml.has_attr_l(x, n, "algn") {
        let a: str = ooxml.attr_l(x, n, "algn")
        if a == "ctr" {
            (*pp).align = dx_props.ALIGN_CENTER
        } else if a == "r" {
            (*pp).align = dx_props.ALIGN_RIGHT
        } else if a == "just" || a == "dist" {
            (*pp).align = dx_props.ALIGN_JUSTIFY
        } else {
            (*pp).align = dx_props.ALIGN_LEFT
        }
    }
    if ooxml.has_attr_l(x, n, "marL") {
        (*pp).left = (ooxml.attr_i64(x, n, "marL", 0) / 635) as i32
    }
    if ooxml.has_attr_l(x, n, "marR") {
        (*pp).right = (ooxml.attr_i64(x, n, "marR", 0) / 635) as i32
    }
    if ooxml.has_attr_l(x, n, "indent") {
        (*pp).first = (ooxml.attr_i64(x, n, "indent", 0) / 635) as i32
    }
    let ls: u32 = ooxml.child_l(x, n, "lnSpc")
    if ls != xml.NONE {
        let pts: u32 = ooxml.child_l(x, ls, "spcPts")
        if pts != xml.NONE {
            (*pp).line = (ooxml.attr_i64(x, pts, "val", 0) / 5) as i32
            (*pp).rule = dx_props.RULE_EXACT
        } else {
            let pc: u32 = ooxml.child_l(x, ls, "spcPct")
            if pc != xml.NONE {
                (*pp).line = ((ooxml.attr_i64(x, pc, "val", 100000) * 240) / 100000) as i32
                (*pp).rule = dx_props.RULE_AUTO
            }
        }
    }
    let sb: u32 = ooxml.child_l(x, n, "spcBef")
    if sb != xml.NONE {
        let v: i32 = spacing_twips(x, sb, 240)
        if v != dx_props.UNSET_T { (*pp).before = v }
    }
    let sa: u32 = ooxml.child_l(x, n, "spcAft")
    if sa != xml.NONE {
        let v: i32 = spacing_twips(x, sa, 240)
        if v != dx_props.UNSET_T { (*pp).after = v }
    }
}

fn auto_code(t: str) -> i32 {
    if t == "arabicParenR" { return 1 }
    if t == "arabicParenBoth" { return 2 }
    if t == "alphaLcPeriod" { return 3 }
    if t == "alphaUcPeriod" { return 4 }
    if t == "alphaLcParenR" { return 5 }
    if t == "alphaUcParenR" { return 6 }
    return 0
}

fn read_bullet(x: *mut xml.Doc, n: u32, b: *mut Bullet) {
    if n == xml.NONE {
        return
    }
    if ooxml.child_l(x, n, "buNone") != xml.NONE {
        (*b).kind = BK_NONE
    }
    let bc: u32 = ooxml.child_l(x, n, "buChar")
    if bc != xml.NONE {
        let s: str = ooxml.attr_l(x, bc, "char")
        if s.n > 0 {
            var k: usize = 0
            while k < s.n && k < 8 {
                (*b).ch[k] = rt.ld8(s.p as u64, k)
                k = k + 1
            }
            (*b).chn = k
            (*b).kind = BK_CHAR
        }
    }
    let ba: u32 = ooxml.child_l(x, n, "buAutoNum")
    if ba != xml.NONE {
        (*b).kind = BK_AUTO
        (*b).auto = auto_code(ooxml.attr_l(x, ba, "type"))
        (*b).start = ooxml.attr_i64(x, ba, "startAt", 1) as i32
    }
}

fn chain_props(c: *mut pp_ctx.Ctx, ch: *mut pp_ctx.Chain, lvl: i32, rp: *mut dx_props.RunProps, pp: *mut dx_props.ParaProps,
    b: *mut Bullet) {
    var i: usize = (*ch).count
    while i > 0 {
        i = i - 1
        let lk: pp_ctx.Link = (*ch).items[i]
        let ln: u32 = lvl_node(lk.x, lk.n, lvl)
        if ln != xml.NONE {
            read_ppr(lk.x, ln, pp)
            read_bullet(lk.x, ln, b)
            read_rpr(c, lk.x, ooxml.child_l(lk.x, ln, "defRPr"), rp)
        }
    }
}
