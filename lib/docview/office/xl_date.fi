import std.rt

export { DateParts, split_serial, month_name, day_name }

struct DateParts {
    year: i64,
    month: i64,
    day: i64,
    wday: i64,
    hour: i64,
    minute: i64,
    second: i64,
    frac_ms: i64,
}

fn civil_from_days(z0: i64, out: *mut DateParts) {
    let z: i64 = z0 + 719468
    var era: i64 = z / 146097
    if z < 0 {
        era = (z - 146096) / 146097
    }
    let doe: i64 = z - era * 146097
    let yoe: i64 = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    var y: i64 = yoe + era * 400
    let doy: i64 = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp: i64 = (5 * doy + 2) / 153
    let d: i64 = doy - (153 * mp + 2) / 5 + 1
    var m: i64 = mp + 3
    if mp >= 10 {
        m = mp - 9
    }
    if m <= 2 {
        y = y + 1
    }
    (*out).year = y
    (*out).month = m
    (*out).day = d
}

fn split_serial(v: f64, date1904: bool, out: *mut DateParts) -> bool {
    if v < 0.0 || v > 2958465.99999 {
        return false
    }
    var days: i64 = v as i64
    var secs_f: f64 = (v - (days as f64)) * 86400.0 + 0.5
    var secs: i64 = secs_f as i64
    if secs >= 86400 {
        days = days + 1
        secs = secs - 86400
    }
    (*out).hour = secs / 3600
    (*out).minute = (secs % 3600) / 60
    (*out).second = secs % 60
    (*out).frac_ms = 0
    var z: i64 = 0
    if date1904 {
        z = days - 24107
    } else if days >= 61 {
        z = days - 25569
    } else if days == 60 {
        (*out).year = 1900
        (*out).month = 2
        (*out).day = 29
        (*out).wday = 3
        return true
    } else {
        z = days - 25568
    }
    civil_from_days(z, out)
    var w: i64 = (z + 4) % 7
    if w < 0 {
        w = w + 7
    }
    (*out).wday = w
    return true
}

fn cut(s: str, off: usize, n: usize) -> str {
    return str { p: rt.ptr_of((s.p as u64) + (off as u64)), n: n }
}

fn month_name(m: i64, full: bool) -> str {
    let abbr: str = "JanFebMarAprMayJunJulAugSepOctNovDec"
    let idx: usize = ((m - 1) as usize) * 3
    if m < 1 || m > 12 {
        return ""
    }
    if !full {
        return cut(abbr, idx, 3)
    }
    if m == 1 { return "January" }
    if m == 2 { return "February" }
    if m == 3 { return "March" }
    if m == 4 { return "April" }
    if m == 5 { return "May" }
    if m == 6 { return "June" }
    if m == 7 { return "July" }
    if m == 8 { return "August" }
    if m == 9 { return "September" }
    if m == 10 { return "October" }
    if m == 11 { return "November" }
    return "December"
}

fn day_name(w: i64, full: bool) -> str {
    let abbr: str = "SunMonTueWedThuFriSat"
    if w < 0 || w > 6 {
        return ""
    }
    if !full {
        return cut(abbr, (w as usize) * 3, 3)
    }
    if w == 0 { return "Sunday" }
    if w == 1 { return "Monday" }
    if w == 2 { return "Tuesday" }
    if w == 3 { return "Wednesday" }
    if w == 4 { return "Thursday" }
    if w == 5 { return "Friday" }
    return "Saturday"
}
