// SPDX-License-Identifier: MPL-2.0
import std.xml
import std.vec
import docview.office.ooxml
import docview.office.xl_ref

export { Merge, SheetInfo, MAX_XCOLS, MAX_XROWS, info_new, info_free, info_read, col_hidden, col_tw }

const MAX_XCOLS: usize = 256
const MAX_XROWS: i32 = 20000
const MAX_MERGES: usize = 20000

struct Merge {
    r1: i32,
    c1: i32,
    r2: i32,
    c2: i32,
}

struct SheetInfo {
    r0: i32,
    r1: i32,
    c0: i32,
    c1: i32,
    has_cells: bool,
    colw: [i32; 256],
    colhide: [bool; 256],
    merges: Vec[Merge],
    gridlines: bool,
    def_col_tw: i32,
    def_row_tw: i32,
    landscape: bool,
}

fn info_new() -> SheetInfo {
    return SheetInfo { r0: 0, r1: -1, c0: 0, c1: -1, has_cells: false, colw: [0 as i32; 256], colhide: [false; 256],
        merges: vec_new[Merge](), gridlines: true, def_col_tw: 960, def_row_tw: 0, landscape: true }
}

fn info_free(s: *mut SheetInfo) {
    vec_free[Merge](&(*s).merges)
}

fn col_hidden(s: *mut SheetInfo, k: usize) -> bool {
    return (*s).colhide[k]
}

fn col_tw(s: *mut SheetInfo, k: usize) -> i32 {
    if (*s).colw[k] > 0 {
        return (*s).colw[k]
    }
    return (*s).def_col_tw
}

fn width_to_tw(w: f64) -> i32 {
    if w <= 0.0 {
        return 0
    }
    var px: f64 = (w * 7.0 + 5.0) * 1.2
    if px > 2000.0 {
        px = 2000.0
    }
    return (px * 15.0) as i32
}

fn num_attr(x: *mut xml.Doc, n: u32, name: str, dflt: f64) -> f64 {
    let s: str = ooxml.attr_l(x, n, name)
    if s.n == 0 {
        return dflt
    }
    var v: f64 = 0.0
    if xl_ref.parse_f64(s, &v) {
        return v
    }
    return dflt
}

fn is_true(x: *mut xml.Doc, n: u32, name: str) -> bool {
    let s: str = ooxml.attr_l(x, n, name)
    return s == "1" || s == "true"
}

fn read_cols(x: *mut xml.Doc, cols: u32, s: *mut SheetInfo) {
    var c: u32 = ooxml.first_el(x, cols)
    while c != xml.NONE {
        if ooxml.is_el(x, c, "col") {
            let mn: i64 = ooxml.attr_i64(x, c, "min", 1)
            let mx: i64 = ooxml.attr_i64(x, c, "max", mn)
            let w: i32 = width_to_tw(num_attr(x, c, "width", 0.0))
            let hid: bool = is_true(x, c, "hidden")
            var k: i64 = mn
            while k <= mx && k <= 16384 {
                let rel: i64 = k - 1 - ((*s).c0 as i64)
                if rel >= 0 && rel < (MAX_XCOLS as i64) {
                    if w > 0 {
                        (*s).colw[rel as usize] = w
                    }
                    (*s).colhide[rel as usize] = hid
                }
                k = k + 1
            }
        }
        c = ooxml.next_el(x, c)
    }
}

fn cell_counts(x: *mut xml.Doc, c: u32) -> bool {
    if ooxml.child_l(x, c, "v") != xml.NONE || ooxml.child_l(x, c, "is") != xml.NONE {
        return true
    }
    return ooxml.attr_i64(x, c, "s", 0) > 0
}

fn scan_extents(x: *mut xml.Doc, sd: u32, s: *mut SheetInfo) {
    var rmin: i32 = 2000000
    var rmax: i32 = -1
    var cmin: i32 = 2000000
    var cmax: i32 = -1
    var rowi: i32 = -1
    var row: u32 = ooxml.first_el(x, sd)
    while row != xml.NONE {
        if ooxml.is_el(x, row, "row") {
            let rr: i64 = ooxml.attr_i64(x, row, "r", 0)
            if rr > 0 {
                rowi = (rr - 1) as i32
            } else {
                rowi = rowi + 1
            }
            var coli: i32 = -1
            var any: bool = false
            var c: u32 = ooxml.first_el(x, row)
            while c != xml.NONE {
                if ooxml.is_el(x, c, "c") {
                    var cr: i32 = 0
                    var cc: i32 = 0
                    if xl_ref.parse_ref(ooxml.attr_l(x, c, "r"), &cr, &cc) {
                        coli = cc
                    } else {
                        coli = coli + 1
                    }
                    if cell_counts(x, c) {
                        any = true
                        if coli < cmin { cmin = coli }
                        if coli > cmax { cmax = coli }
                    }
                }
                c = ooxml.next_el(x, c)
            }
            if any {
                if rowi < rmin { rmin = rowi }
                if rowi > rmax { rmax = rowi }
            }
        }
        row = ooxml.next_el(x, row)
    }
    if rmax >= 0 && cmax >= 0 {
        (*s).has_cells = true
        (*s).r0 = rmin
        (*s).r1 = rmax
        (*s).c0 = cmin
        (*s).c1 = cmax
    }
}

fn read_merges(x: *mut xml.Doc, mc: u32, s: *mut SheetInfo) {
    var m: u32 = ooxml.first_el(x, mc)
    while m != xml.NONE {
        if ooxml.is_el(x, m, "mergeCell") && vec_len[Merge](&(*s).merges) < MAX_MERGES {
            var a: i32 = 0
            var b: i32 = 0
            var c: i32 = 0
            var d: i32 = 0
            if xl_ref.parse_range(ooxml.attr_l(x, m, "ref"), &a, &b, &c, &d) {
                if c > a || d > b {
                    vec_push[Merge](&(*s).merges, Merge { r1: a, c1: b, r2: c, c2: d })
                }
            }
        }
        m = ooxml.next_el(x, m)
    }
}

fn info_read(x: *mut xml.Doc, s: *mut SheetInfo) -> u32 {
    let root: u32 = xml.root(x)
    let sd: u32 = ooxml.child_l(x, root, "sheetData")
    scan_extents(x, sd, s)
    if (*s).has_cells {
        if (*s).c1 - (*s).c0 + 1 > (MAX_XCOLS as i32) {
            (*s).c1 = (*s).c0 + (MAX_XCOLS as i32) - 1
        }
        if (*s).r1 - (*s).r0 + 1 > MAX_XROWS {
            (*s).r1 = (*s).r0 + MAX_XROWS - 1
        }
    }
    let fp: u32 = ooxml.child_l(x, root, "sheetFormatPr")
    if fp != xml.NONE {
        let dw: f64 = num_attr(x, fp, "defaultColWidth", 0.0)
        if dw > 0.0 {
            (*s).def_col_tw = width_to_tw(dw)
        } else {
            let bw: f64 = num_attr(x, fp, "baseColWidth", 8.0)
            (*s).def_col_tw = width_to_tw(bw + 0.43)
        }
        let dh: f64 = num_attr(x, fp, "defaultRowHeight", 0.0)
        if dh > 0.0 && dh < 400.0 {
            (*s).def_row_tw = (dh * 20.0) as i32
        }
    }
    let views: u32 = ooxml.child_l(x, root, "sheetViews")
    let sv: u32 = ooxml.child_l(x, views, "sheetView")
    if sv != xml.NONE && ooxml.attr_l(x, sv, "showGridLines") == "0" {
        (*s).gridlines = false
    }
    read_cols(x, ooxml.child_l(x, root, "cols"), s)
    read_merges(x, ooxml.child_l(x, root, "mergeCells"), s)
    let ps: u32 = ooxml.child_l(x, root, "pageSetup")
    if ps != xml.NONE && ooxml.attr_l(x, ps, "orientation") == "portrait" {
        (*s).landscape = false
    }
    return sd
}
