import std.rt
import docview.office.opc
import docview.office.od_style
import docview.office.od_list

export { OdCtx, ctx_new, MAX_DEPTH, MAX_TABLE_DEPTH, MAX_COLS, MAX_ROW_REPEAT }

const MAX_DEPTH: i32 = 40
const MAX_TABLE_DEPTH: i32 = 6
const MAX_COLS: usize = 256
const MAX_ROW_REPEAT: i64 = 60

struct OdCtx {
    od: *mut od_style.OdStyles,
    ls: *mut od_list.Lists,
    pk: *mut opc.Package,
    sect_idx: u32,
    table_depth: i32,
    text_w: i32,
}

fn ctx_new(od: *mut od_style.OdStyles, ls: *mut od_list.Lists, pk: *mut opc.Package) -> OdCtx {
    return OdCtx { od: od, ls: ls, pk: pk, sect_idx: 0 as u32, table_depth: 0, text_w: 9000 }
}
