import std.rt
import docview.office.xl_general
import docview.office.xl_fmtscan
import docview.office.xl_fmtnum
import docview.office.xl_fmtdate

export { builtin_code, is_date_code, format_value }

fn builtin_code(id: i64) -> str {
    if id == 0 { return "General" }
    if id == 1 { return "0" }
    if id == 2 { return "0.00" }
    if id == 3 { return "#,##0" }
    if id == 4 { return "#,##0.00" }
    if id == 9 { return "0%" }
    if id == 10 { return "0.00%" }
    if id == 11 { return "0.00E+00" }
    if id == 14 { return "yyyy-mm-dd" }
    if id == 15 { return "d-mmm-yy" }
    if id == 16 { return "d-mmm" }
    if id == 17 { return "mmm-yy" }
    if id == 18 { return "h:mm AM/PM" }
    if id == 19 { return "h:mm:ss AM/PM" }
    if id == 20 { return "h:mm" }
    if id == 21 { return "h:mm:ss" }
    if id == 22 { return "yyyy-mm-dd h:mm" }
    if id == 37 { return "#,##0;(#,##0)" }
    if id == 38 { return "#,##0;[Red](#,##0)" }
    if id == 39 { return "#,##0.00;(#,##0.00)" }
    if id == 40 { return "#,##0.00;[Red](#,##0.00)" }
    if id == 45 { return "mm:ss" }
    if id == 46 { return "[h]:mm:ss" }
    if id == 47 { return "mm:ss.0" }
    if id == 48 { return "##0.0E+0" }
    if id == 49 { return "@" }
    return "General"
}

fn is_date_code(code: str) -> bool {
    var secs: xl_fmtscan.Sections = xl_fmtscan.Sections { n: 0, st: [0 as usize; 4], ln: [0 as usize; 4] }
    xl_fmtscan.split_sections(code, &secs)
    if secs.n == 0 {
        return false
    }
    return xl_fmtscan.is_date_section(xl_fmtscan.section_slice(code, secs.st[0], secs.ln[0]))
}

fn format_value(code: str, v: f64, date1904: bool, out: *mut rt.Buf) {
    var secs: xl_fmtscan.Sections = xl_fmtscan.Sections { n: 0, st: [0 as usize; 4], ln: [0 as usize; 4] }
    xl_fmtscan.split_sections(code, &secs)
    if secs.n == 0 {
        xl_general.general(v, out)
        return
    }
    var pick: usize = 0
    var a: f64 = v
    var neg_auto: bool = false
    if v < 0.0 {
        if secs.n >= 2 {
            pick = 1
            a = 0.0 - v
        } else {
            neg_auto = true
            a = 0.0 - v
        }
    } else if v == 0.0 && secs.n >= 3 {
        pick = 2
    }
    let sec: str = xl_fmtscan.trim_str(xl_fmtscan.section_slice(code, secs.st[pick], secs.ln[pick]))
    if sec.n == 0 || sec == "@" || xl_fmtscan.matches_at(sec, 0, "general") {
        xl_general.general(v, out)
        return
    }
    if xl_fmtscan.is_date_section(sec) {
        if v < 0.0 {
            xl_general.general(v, out)
            return
        }
        xl_fmtdate.format_date(sec, v, date1904, out)
        return
    }
    if neg_auto {
        rt.buf_push(out, 45 as u8)
    }
    xl_fmtnum.format_numeric(sec, a, out)
}
