// SPDX-License-Identifier: MPL-2.0
import std.rt

export { push_cp, next_cp, is_space_cp, is_cjk_cp, is_break_after, upper_cp, push_upper }

fn push_cp(out: *mut rt.Buf, cp: u32) {
    if cp < 128 as u32 {
        rt.buf_push(out, cp as u8)
        return
    }
    if cp < 2048 as u32 {
        rt.buf_push(out, (192 as u32 | (cp >> 6 as u32)) as u8)
        rt.buf_push(out, (128 as u32 | (cp & 63 as u32)) as u8)
        return
    }
    if cp < 65536 as u32 {
        rt.buf_push(out, (224 as u32 | (cp >> 12 as u32)) as u8)
        rt.buf_push(out, (128 as u32 | ((cp >> 6 as u32) & 63 as u32)) as u8)
        rt.buf_push(out, (128 as u32 | (cp & 63 as u32)) as u8)
        return
    }
    rt.buf_push(out, (240 as u32 | ((cp >> 18 as u32) & 7 as u32)) as u8)
    rt.buf_push(out, (128 as u32 | ((cp >> 12 as u32) & 63 as u32)) as u8)
    rt.buf_push(out, (128 as u32 | ((cp >> 6 as u32) & 63 as u32)) as u8)
    rt.buf_push(out, (128 as u32 | (cp & 63 as u32)) as u8)
}

fn next_cp(p: u64, n: usize, i: usize, len: *mut usize) -> u32 {
    let c: u32 = rt.ld8(p, i) as u32
    *len = 1
    if c < 128 as u32 {
        return c
    }
    var need: usize = 0
    var cp: u32 = 0
    if c >= 240 as u32 && c < 248 as u32 {
        need = 3
        cp = c & 7 as u32
    } else if c >= 224 as u32 {
        need = 2
        cp = c & 15 as u32
    } else if c >= 192 as u32 {
        need = 1
        cp = c & 31 as u32
    } else {
        return 0xFFFD as u32
    }
    if i + need >= n {
        return 0xFFFD as u32
    }
    var k: usize = 1
    while k <= need {
        let b: u32 = rt.ld8(p, i + k) as u32
        if (b & 192 as u32) != 128 as u32 {
            return 0xFFFD as u32
        }
        cp = (cp << 6 as u32) | (b & 63 as u32)
        k = k + 1
    }
    *len = need + 1
    return cp
}

fn is_space_cp(cp: u32) -> bool {
    return cp == 32 as u32 || cp == 160 as u32 || cp == 0x2009 as u32 || cp == 0x2002 as u32 || cp == 0x2003 as u32 || cp == 0x3000 as u32
}

fn is_cjk_cp(cp: u32) -> bool {
    return (cp >= 0x3040 as u32 && cp <= 0x30FF as u32) || (cp >= 0x3400 as u32 && cp <= 0x4DBF as u32)
        || (cp >= 0x4E00 as u32 && cp <= 0x9FFF as u32) || (cp >= 0xAC00 as u32 && cp <= 0xD7AF as u32)
        || (cp >= 0xF900 as u32 && cp <= 0xFAFF as u32) || (cp >= 0xFF00 as u32 && cp <= 0xFFEF as u32)
}

fn is_break_after(cp: u32) -> bool {
    return cp == 45 as u32 || cp == 0x2010 as u32 || cp == 0x2013 as u32 || cp == 0x2014 as u32
}

fn upper_cp(cp: u32) -> u32 {
    if cp >= 97 as u32 && cp <= 122 as u32 {
        return cp - 32 as u32
    }
    if cp >= 0xE0 as u32 && cp <= 0xFE as u32 && cp != 0xF7 as u32 {
        return cp - 32 as u32
    }
    if cp == 0xFF as u32 {
        return 0x178 as u32
    }
    if cp >= 0x3B1 as u32 && cp <= 0x3C9 as u32 && cp != 0x3C2 as u32 {
        return cp - 32 as u32
    }
    if cp >= 0x430 as u32 && cp <= 0x44F as u32 {
        return cp - 32 as u32
    }
    if cp >= 0x450 as u32 && cp <= 0x45F as u32 {
        return cp - 80 as u32
    }
    return cp
}

fn push_upper(out: *mut rt.Buf, p: u64, n: usize) {
    var i: usize = 0
    while i < n {
        var l: usize = 1
        let cp: u32 = next_cp(p, n, i, &l)
        push_cp(out, upper_cp(cp))
        i = i + l
    }
}
