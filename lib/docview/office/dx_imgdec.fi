import std.rt
import std.vec

export { DecodeFn, imgdec_set, imgdec_run, imgdec_installed }

type DecodeFn = fn(u64, usize, *mut rt.Buf, *mut usize, *mut usize) -> bool

struct DecodeSlot {
    f: DecodeFn,
}

static mut G_SLOTS: Vec[DecodeSlot] = Vec[DecodeSlot] { ptr: 0, len: 0, cap: 0 }

fn imgdec_set(f: DecodeFn) {
    if vec_len[DecodeSlot](&G_SLOTS) == 0 {
        vec_push[DecodeSlot](&G_SLOTS, DecodeSlot { f: f })
        return
    }
    (*vec_elem_ptr[DecodeSlot](&G_SLOTS, 0)).f = f
}

fn imgdec_installed() -> bool {
    return vec_len[DecodeSlot](&G_SLOTS) > 0
}

fn imgdec_run(src: u64, n: usize, out: *mut rt.Buf, w: *mut usize, h: *mut usize) -> bool {
    if vec_len[DecodeSlot](&G_SLOTS) == 0 {
        return false
    }
    return ((*vec_elem_ptr[DecodeSlot](&G_SLOTS, 0)).f)(src, n, out, w, h)
}
