import std.rt
import docview.office.dx_imgdec
import fui.uiimage
import fui.uiimagedec

export { decode_rgba, install_images }

fn decode_rgba(src: u64, n: usize, out: *mut rt.Buf, w: *mut usize, h: *mut usize) -> bool {
    var dec: uiimagedec.Decoded = uiimagedec.decoded_new()
    defer uiimagedec.decoded_free(&dec)
    var view: uiimage.Image = uiimage.image_new()
    if !uiimagedec.image_from_bytes(src, n, &dec, &view) {
        return false
    }
    if view.w == 0 || view.h == 0 || view.px == 0 {
        return false
    }
    var stride: usize = view.stride
    if stride == 0 {
        stride = view.w * 4
    }
    let total: usize = view.w * view.h * 4
    rt.buf_reserve(out, total)
    rt.buf_set_len(out, total)
    let dp: u64 = rt.buf_ptr(out)
    var y: usize = 0
    while y < view.h {
        var x: usize = 0
        while x < view.w {
            rt.st32(dp, y * view.w + x, rt.ld32(view.px + ((y * stride) as u64), x))
            x = x + 1
        }
        y = y + 1
    }
    *w = view.w
    *h = view.h
    return true
}

fn install_images() {
    dx_imgdec.imgdec_set(decode_rgba)
}
