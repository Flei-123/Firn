import std.rt
import std.xml
import docview.office.opc
import docview.office.ooxml
import docview.office.dx_model
import docview.office.od_ctx
import docview.office.od_style
import docview.office.od_list
import docview.office.od_body
import docview.office.od_page

export { odt_load }

fn load_style_part(od: *mut od_style.OdStyles, ls: *mut od_list.Lists, x: *mut xml.Doc, root: u32) {
    od_style.od_load_styles(od, x, ooxml.child_l(x, root, "styles"))
    od_style.od_load_styles(od, x, ooxml.child_l(x, root, "automatic-styles"))
    od_list.lists_load(ls, x, ooxml.child_l(x, root, "styles"))
    od_list.lists_load(ls, x, ooxml.child_l(x, root, "automatic-styles"))
}

fn odt_load(pk: *mut opc.Package, d: *mut dx_model.Docx) -> bool {
    var od: od_style.OdStyles = od_style.od_new()
    defer od_style.od_free(&od)
    var ls: od_list.Lists = od_list.lists_new()
    defer od_list.lists_free(&ls)
    var c: od_ctx.OdCtx = od_ctx.ctx_new(&od, &ls, pk)
    dx_model.new_sect(d)
    var raw_s: rt.Buf = rt.buf_new()
    defer rt.buf_free(&raw_s)
    var xs: xml.Doc = xml.doc_new()
    defer xml.doc_free(&xs)
    if opc.pkg_read_xml(pk, "styles.xml", &raw_s, &xs) {
        let rs: u32 = xml.root(&xs)
        load_style_part(&od, &ls, &xs, rs)
        od_page.read_page(&c, d, &xs, rs)
    }
    var raw: rt.Buf = rt.buf_new()
    defer rt.buf_free(&raw)
    var x: xml.Doc = xml.doc_new()
    defer xml.doc_free(&x)
    if !opc.pkg_read_xml(pk, "content.xml", &raw, &x) {
        return false
    }
    let root: u32 = xml.root(&x)
    od_style.od_load_styles(&od, &x, ooxml.child_l(&x, root, "automatic-styles"))
    od_list.lists_load(&ls, &x, ooxml.child_l(&x, root, "automatic-styles"))
    let body: u32 = ooxml.child_l(&x, root, "body")
    let text: u32 = ooxml.child_l(&x, body, "text")
    if body == xml.NONE || text == xml.NONE {
        return false
    }
    var bl: dx_model.BList = dx_model.blist_new()
    od_body.parse_blocks(&c, d, &x, text, &bl, 0)
    (*d).body = bl
    return true
}
