import std.rt
import std.xml
import std.vec
import docview.office.opc
import docview.office.ooxml
import docview.office.dx_style
import docview.office.dx_num
import docview.office.dx_model
import docview.office.dx_ctx
import docview.office.dx_body
import docview.office.dx_sect

export { docx_load }

#[allow_escape]
fn load_header_footer(c: *mut dx_ctx.Ctx, d: *mut dx_model.Docx, k: u32) {
    let h: *mut dx_model.HeaderFooter = dx_model.hf_at(d, k)
    let part: str = dx_model.pool_str(d, (*h).name_off, (*h).name_n)
    var raw: rt.Buf = rt.buf_new()
    defer rt.buf_free(&raw)
    var x: xml.Doc = xml.doc_new()
    defer xml.doc_free(&x)
    if !opc.pkg_read_xml((*c).pk, part, &raw, &x) {
        return
    }
    var rels: opc.Rels = opc.rels_new()
    defer opc.rels_free(&rels)
    opc.rels_load((*c).pk, part, &rels)
    let saved: *mut opc.Rels = (*c).rels
    (*c).rels = &rels
    var bl: dx_model.BList = dx_model.blist_new()
    dx_body.parse_blocks(c, d, &x, xml.root(&x), &bl, 1)
    (*c).rels = saved
    (*dx_model.hf_at(d, k)).blocks = bl
}

fn load_side_part(c: *mut dx_ctx.Ctx, rels: *mut opc.Rels, suffix: str, numbering: bool) {
    let i: i64 = opc.rels_find_type(rels, suffix)
    if i < 0 {
        return
    }
    let part: str = opc.rels_target(rels, i as usize)
    if numbering {
        dx_num.numbering_load((*c).pk, part, &(*c).nm)
    } else {
        dx_style.styles_load((*c).pk, part, &(*c).st)
    }
}

fn docx_load(pk: *mut opc.Package, d: *mut dx_model.Docx) -> bool {
    var c: dx_ctx.Ctx = dx_ctx.ctx_new(pk)
    defer dx_ctx.ctx_free(&c)
    var main_part: rt.Buf = rt.buf_new()
    defer rt.buf_free(&main_part)
    if !opc.pkg_main_part(pk, &main_part) {
        return false
    }
    let part: str = rt.buf_str(&main_part)
    var rels: opc.Rels = opc.rels_new()
    defer opc.rels_free(&rels)
    opc.rels_load(pk, part, &rels)
    c.rels = &rels
    load_side_part(&c, &rels, "/styles", false)
    load_side_part(&c, &rels, "/numbering", true)
    var raw: rt.Buf = rt.buf_new()
    defer rt.buf_free(&raw)
    var x: xml.Doc = xml.doc_new()
    defer xml.doc_free(&x)
    if !opc.pkg_read_xml(pk, part, &raw, &x) {
        return false
    }
    let body: u32 = ooxml.child_l(&x, xml.root(&x), "body")
    if body == xml.NONE {
        return false
    }
    c.sect_idx = dx_model.new_sect(d)
    var bl: dx_model.BList = dx_model.blist_new()
    dx_body.parse_blocks(&c, d, &x, body, &bl, 0)
    (*d).body = bl
    dx_sect.inherit_sections(d)
    var k: usize = 0
    while k < vec_len[dx_model.HeaderFooter](&(*d).hfs) {
        load_header_footer(&c, d, k as u32)
        k = k + 1
    }
    return true
}
