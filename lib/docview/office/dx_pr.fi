import std.rt
import std.xml
import docview.office.ooxml
import docview.office.dx_props

export {
    read_rpr, read_ppr, read_tblpr, read_border, read_border_named, read_shd, contains_ci, parse_color_name,
}

fn contains_ci(s: str, needle: str) -> bool {
    if needle.n > s.n {
        return false
    }
    var i: usize = 0
    while i + needle.n <= s.n {
        let sub: str = str { p: rt.ptr_of((s.p as u64) + (i as u64)), n: needle.n }
        if ooxml.str_eq_ci(sub, needle) {
            return true
        }
        i = i + 1
    }
    return false
}

fn is_mono_name(s: str) -> bool {
    return contains_ci(s, "courier") || contains_ci(s, "consolas") || contains_ci(s, "mono")
        || contains_ci(s, "menlo") || contains_ci(s, "lucida console") || contains_ci(s, "monaco")
        || contains_ci(s, "cascadia") || contains_ci(s, "typewriter")
}

fn is_serif_name(s: str) -> bool {
    if contains_ci(s, "sans") {
        return false
    }
    return contains_ci(s, "times") || contains_ci(s, "serif") || contains_ci(s, "cambria") || contains_ci(s, "georgia")
        || contains_ci(s, "garamond") || contains_ci(s, "palatino") || contains_ci(s, "book") || contains_ci(s, "minion")
        || contains_ci(s, "century") || contains_ci(s, "roman")
}

fn parse_color_name(s: str) -> u32 {
    if s == "yellow" { return 0xFF00FFFF as u32 }
    if s == "green" { return 0xFF00FF00 as u32 }
    if s == "cyan" { return 0xFFFFFF00 as u32 }
    if s == "magenta" { return 0xFFFF00FF as u32 }
    if s == "blue" { return 0xFFFF0000 as u32 }
    if s == "red" { return 0xFF0000FF as u32 }
    if s == "lightGray" { return 0xFFC0C0C0 as u32 }
    if s == "darkGray" { return 0xFF808080 as u32 }
    if s == "white" { return 0xFFFFFFFF as u32 }
    if s == "darkYellow" { return 0xFF008080 as u32 }
    if s == "darkGreen" { return 0xFF008000 as u32 }
    if s == "darkCyan" { return 0xFF808000 as u32 }
    if s == "darkMagenta" { return 0xFF800080 as u32 }
    if s == "darkBlue" { return 0xFF800000 as u32 }
    if s == "darkRed" { return 0xFF000080 as u32 }
    return 0 as u32
}

fn read_shd(x: *mut xml.Doc, n: u32) -> u32 {
    if n == xml.NONE {
        return 0 as u32
    }
    return ooxml.attr_u32_hex(x, n, "fill", 0 as u32)
}

fn read_rpr(x: *mut xml.Doc, rpr: u32, out: *mut dx_props.RunProps) {
    if rpr == xml.NONE {
        return
    }
    var c: u32 = ooxml.first_el(x, rpr)
    while c != xml.NONE {
        let nm: str = ooxml.local_name(xml.name(x, c))
        if nm == "b" {
            (*out).bold = ooxml.on_off(x, c)
        } else if nm == "i" {
            (*out).italic = ooxml.on_off(x, c)
        } else if nm == "u" {
            let v: str = ooxml.attr_l(x, c, "val")
            if v == "none" || v == "0" {
                (*out).underline = 0
            } else if v == "double" {
                (*out).underline = 2
            } else {
                (*out).underline = 1
            }
        } else if nm == "strike" || nm == "dstrike" {
            (*out).strike = ooxml.on_off(x, c)
        } else if nm == "caps" || nm == "smallCaps" {
            (*out).caps = ooxml.on_off(x, c)
        } else if nm == "color" {
            let col: u32 = ooxml.attr_u32_hex(x, c, "val", 0 as u32)
            if col != 0 as u32 {
                (*out).color = col
            }
        } else if nm == "sz" {
            let hp: i64 = ooxml.attr_i64(x, c, "val", 0)
            if hp > 0 && hp < 4000 {
                (*out).size_hp = hp as i32
            }
        } else if nm == "vertAlign" {
            let v2: str = ooxml.attr_l(x, c, "val")
            if v2 == "superscript" {
                (*out).vert = dx_props.VA_SUPER
            } else if v2 == "subscript" {
                (*out).vert = dx_props.VA_SUB
            } else {
                (*out).vert = dx_props.VA_BASE
            }
        } else if nm == "rFonts" {
            var f: str = ooxml.attr_l(x, c, "ascii")
            if f.n == 0 {
                f = ooxml.attr_l(x, c, "hAnsi")
            }
            if f.n > 0 {
                if is_mono_name(f) {
                    (*out).mono = 1
                } else if is_serif_name(f) {
                    (*out).mono = 2
                } else {
                    (*out).mono = 0
                }
            }
        } else if nm == "shd" {
            let s: u32 = read_shd(x, c)
            if s != 0 as u32 {
                (*out).shade = s
            }
        } else if nm == "highlight" {
            let h: u32 = parse_color_name(ooxml.attr_l(x, c, "val"))
            if h != 0 as u32 {
                (*out).shade = h
            }
        }
        c = ooxml.next_el(x, c)
    }
}

fn clamp_tw(v: i64) -> i32 {
    if v > 200000 { return 200000 }
    if v < -200000 { return -200000 }
    return v as i32
}

fn read_ppr(x: *mut xml.Doc, ppr: u32, out: *mut dx_props.ParaProps) {
    if ppr == xml.NONE {
        return
    }
    var c: u32 = ooxml.first_el(x, ppr)
    while c != xml.NONE {
        let nm: str = ooxml.local_name(xml.name(x, c))
        if nm == "jc" {
            let v: str = ooxml.attr_l(x, c, "val")
            if v == "center" {
                (*out).align = dx_props.ALIGN_CENTER
            } else if v == "right" || v == "end" {
                (*out).align = dx_props.ALIGN_RIGHT
            } else if v == "both" || v == "distribute" || v == "justify" {
                (*out).align = dx_props.ALIGN_JUSTIFY
            } else {
                (*out).align = dx_props.ALIGN_LEFT
            }
        } else if nm == "ind" {
            if ooxml.has_attr_l(x, c, "left") {
                (*out).left = clamp_tw(ooxml.attr_i64(x, c, "left", 0))
            } else if ooxml.has_attr_l(x, c, "start") {
                (*out).left = clamp_tw(ooxml.attr_i64(x, c, "start", 0))
            }
            if ooxml.has_attr_l(x, c, "right") {
                (*out).right = clamp_tw(ooxml.attr_i64(x, c, "right", 0))
            } else if ooxml.has_attr_l(x, c, "end") {
                (*out).right = clamp_tw(ooxml.attr_i64(x, c, "end", 0))
            }
            if ooxml.has_attr_l(x, c, "firstLine") {
                (*out).first = clamp_tw(ooxml.attr_i64(x, c, "firstLine", 0))
            }
            if ooxml.has_attr_l(x, c, "hanging") {
                (*out).first = 0 - clamp_tw(ooxml.attr_i64(x, c, "hanging", 0))
            }
        } else if nm == "spacing" {
            if ooxml.has_attr_l(x, c, "before") {
                (*out).before = clamp_tw(ooxml.attr_i64(x, c, "before", 0))
            }
            if ooxml.has_attr_l(x, c, "after") {
                (*out).after = clamp_tw(ooxml.attr_i64(x, c, "after", 0))
            }
            if ooxml.has_attr_l(x, c, "line") {
                (*out).line = clamp_tw(ooxml.attr_i64(x, c, "line", 240))
            }
            let r: str = ooxml.attr_l(x, c, "lineRule")
            if r == "exact" {
                (*out).rule = dx_props.RULE_EXACT
            } else if r == "atLeast" {
                (*out).rule = dx_props.RULE_ATLEAST
            } else if r == "auto" {
                (*out).rule = dx_props.RULE_AUTO
            }
        } else if nm == "keepNext" {
            (*out).keep_next = ooxml.on_off(x, c)
        } else if nm == "keepLines" {
            (*out).keep_lines = ooxml.on_off(x, c)
        } else if nm == "pageBreakBefore" {
            (*out).page_break_before = ooxml.on_off(x, c)
        } else if nm == "contextualSpacing" {
            (*out).ctx_space = ooxml.on_off(x, c)
        } else if nm == "outlineLvl" {
            (*out).outline = ooxml.attr_i64(x, c, "val", 9) as i32
        } else if nm == "shd" {
            let s: u32 = read_shd(x, c)
            if s != 0 as u32 {
                (*out).shade = s
            }
        } else if nm == "numPr" {
            let il: u32 = ooxml.child_l(x, c, "ilvl")
            let ni: u32 = ooxml.child_l(x, c, "numId")
            if il != xml.NONE {
                (*out).ilvl = ooxml.attr_i64(x, il, "val", 0) as i32
            }
            if ni != xml.NONE {
                (*out).num_id = ooxml.attr_i64(x, ni, "val", 0) as i32
            }
        } else if nm == "tabs" {
            var t: u32 = ooxml.first_el(x, c)
            var k: i32 = 0
            while t != xml.NONE && (k as usize) < dx_props.MAX_TABS {
                if ooxml.is_el(x, t, "tab") {
                    let v3: str = ooxml.attr_l(x, t, "val")
                    if v3 != "clear" {
                        var kind: i32 = dx_props.TAB_LEFT
                        if v3 == "center" {
                            kind = dx_props.TAB_CENTER
                        } else if v3 == "right" || v3 == "end" {
                            kind = dx_props.TAB_RIGHT
                        }
                        (*out).tabs[k as usize] = dx_props.TabStop { pos: clamp_tw(ooxml.attr_i64(x, t, "pos", 0)), kind: kind }
                        k = k + 1
                    }
                }
                t = ooxml.next_el(x, t)
            }
            (*out).ntabs = k
        }
        c = ooxml.next_el(x, c)
    }
}

fn read_border(x: *mut xml.Doc, n: u32) -> dx_props.Border {
    if n == xml.NONE {
        return dx_props.border_unset()
    }
    let v: str = ooxml.attr_l(x, n, "val")
    if v == "nil" || v == "none" || v.n == 0 {
        return dx_props.Border { sz: 0, color: 0xFF000000 as u32 }
    }
    var sz: i64 = ooxml.attr_i64(x, n, "sz", 4)
    if sz < 2 { sz = 2 }
    if sz > 96 { sz = 96 }
    var col: u32 = ooxml.attr_u32_hex(x, n, "color", 0xFF000000 as u32)
    return dx_props.Border { sz: sz as i32, color: col }
}

fn read_border_named(x: *mut xml.Doc, parent: u32, a: str, b: str) -> dx_props.Border {
    var n: u32 = ooxml.child_l(x, parent, a)
    if n == xml.NONE {
        n = ooxml.child_l(x, parent, b)
    }
    return read_border(x, n)
}

fn read_tblpr(x: *mut xml.Doc, tpr: u32, out: *mut dx_props.TblProps) {
    if tpr == xml.NONE {
        return
    }
    let bs: u32 = ooxml.child_l(x, tpr, "tblBorders")
    if bs != xml.NONE {
        var o: dx_props.TblProps = dx_props.tbl_unset()
        o.top = read_border_named(x, bs, "top", "top")
        o.left = read_border_named(x, bs, "left", "start")
        o.bottom = read_border_named(x, bs, "bottom", "bottom")
        o.right = read_border_named(x, bs, "right", "end")
        o.inner_h = read_border_named(x, bs, "insideH", "insideH")
        o.inner_v = read_border_named(x, bs, "insideV", "insideV")
        dx_props.tbl_apply(out, &o)
    }
    let cm: u32 = ooxml.child_l(x, tpr, "tblCellMar")
    if cm != xml.NONE {
        var n: u32 = ooxml.child_l(x, cm, "left")
        if n == xml.NONE { n = ooxml.child_l(x, cm, "start") }
        if n != xml.NONE { (*out).mar_left = clamp_tw(ooxml.attr_i64(x, n, "w", 108)) }
        n = ooxml.child_l(x, cm, "right")
        if n == xml.NONE { n = ooxml.child_l(x, cm, "end") }
        if n != xml.NONE { (*out).mar_right = clamp_tw(ooxml.attr_i64(x, n, "w", 108)) }
        n = ooxml.child_l(x, cm, "top")
        if n != xml.NONE { (*out).mar_top = clamp_tw(ooxml.attr_i64(x, n, "w", 0)) }
        n = ooxml.child_l(x, cm, "bottom")
        if n != xml.NONE { (*out).mar_bottom = clamp_tw(ooxml.attr_i64(x, n, "w", 0)) }
    }
    let jc: u32 = ooxml.child_l(x, tpr, "jc")
    if jc != xml.NONE {
        let v: str = ooxml.attr_l(x, jc, "val")
        if v == "center" {
            (*out).align = dx_props.ALIGN_CENTER
        } else if v == "right" || v == "end" {
            (*out).align = dx_props.ALIGN_RIGHT
        } else {
            (*out).align = dx_props.ALIGN_LEFT
        }
    }
    let ti: u32 = ooxml.child_l(x, tpr, "tblInd")
    if ti != xml.NONE {
        (*out).indent = clamp_tw(ooxml.attr_i64(x, ti, "w", 0))
    }
}
