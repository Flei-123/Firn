import std.rt
import std.vec
import docview.office.dx_props
import docview.office.dx_model
import docview.office.dx_lay
import docview.office.dx_prim

export { emit_lines }

struct Span {
    on: bool,
    x0: f64,
    x1: f64,
    y: f64,
    h: f64,
    color: u32,
}

fn span_new() -> Span {
    return Span { on: false, x0: 0.0, x1: 0.0, y: 0.0, h: 0.0, color: 0 as u32 }
}

fn span_flush(s: *mut Span, sink: *mut Vec[dx_prim.Prim], hf: u32) {
    if (*s).on && (*s).x1 > (*s).x0 {
        var p: dx_prim.Prim = dx_prim.prim_rect((*s).color, (*s).x0, (*s).y, (*s).x1 - (*s).x0, (*s).h)
        p.flags = hf
        vec_push[dx_prim.Prim](sink, p)
    }
    (*s).on = false
}

fn span_add(s: *mut Span, sink: *mut Vec[dx_prim.Prim], hf: u32, x0: f64, x1: f64, y: f64, h: f64, color: u32) {
    if (*s).on && (*s).color == color && (*s).y == y && (*s).h == h && x0 <= (*s).x1 + 0.5 {
        (*s).x1 = x1
        return
    }
    span_flush(s, sink, hf)
    (*s).on = true
    (*s).x0 = x0
    (*s).x1 = x1
    (*s).y = y
    (*s).h = h
    (*s).color = color
}

fn thick(px: f64) -> f64 {
    var t: f64 = px / 16.0
    if t < 1.0 {
        t = 1.0
    }
    return t
}

fn shade_pass(l: *mut dx_lay.Lay, ln: *mut dx_lay.LineRec, x0: f64, ly: f64, sink: *mut Vec[dx_prim.Prim], hf: u32) {
    var sp: Span = span_new()
    var i: u32 = (*ln).i0
    while i < (*ln).i1 {
        let it: *mut dx_lay.Item = vec_elem_ptr[dx_lay.Item](&(*l).items, i as usize)
        let st: *mut dx_lay.RStyle = &(*vec_elem_ptr[dx_lay.Atom](&(*l).atoms, (*it).atom as usize)).st
        if (*st).shade != 0 as u32 {
            span_add(&sp, sink, hf, x0 + (*it).x, x0 + (*it).x + (*it).w, ly, (*ln).h, (*st).shade)
        } else {
            span_flush(&sp, sink, hf)
        }
        i = i + 1
    }
    span_flush(&sp, sink, hf)
}

fn emit_line(l: *mut dx_lay.Lay, ln: *mut dx_lay.LineRec, x0: f64, ly: f64, para_first: *mut bool,
    sink: *mut Vec[dx_prim.Prim], hf: u32) {
    shade_pass(l, ln, x0, ly, sink, hf)
    var ul: Span = span_new()
    var ul2: Span = span_new()
    var stk: Span = span_new()
    var line_first: bool = true
    let basey: f64 = ly + (*ln).base
    var i: u32 = (*ln).i0
    while i < (*ln).i1 {
        let it: *mut dx_lay.Item = vec_elem_ptr[dx_lay.Item](&(*l).items, i as usize)
        let at: *mut dx_lay.Atom = vec_elem_ptr[dx_lay.Atom](&(*l).atoms, (*it).atom as usize)
        let st: *mut dx_lay.RStyle = &(*at).st
        let x: f64 = x0 + (*it).x
        let by: f64 = basey + (*st).shift
        let k: u32 = (*at).kind
        if (*st).ul != 0 && k != dx_lay.A_TAB && k != dx_lay.A_IMAGE {
            let t: f64 = thick((*st).px)
            span_add(&ul, sink, hf, x, x + (*it).w, by + (*st).px * 0.12, t, (*st).color)
            if (*st).ul == 2 {
                span_add(&ul2, sink, hf, x, x + (*it).w, by + (*st).px * 0.12 + t * 2.0, t, (*st).color)
            }
        } else {
            span_flush(&ul, sink, hf)
            span_flush(&ul2, sink, hf)
        }
        if (*st).strike && k != dx_lay.A_TAB && k != dx_lay.A_IMAGE {
            span_add(&stk, sink, hf, x, x + (*it).w, by - (*st).px * 0.28, thick((*st).px), (*st).color)
        } else {
            span_flush(&stk, sink, hf)
        }
        if k == dx_lay.A_WORD || k == dx_lay.A_FIELD {
            var fl: u32 = hf
            if (*st).caps { fl = fl | dx_prim.F_CAPS }
            if ((*it).flags & dx_lay.AF_LABEL) != 0 as u32 { fl = fl | dx_prim.F_LABEL }
            if ((*it).flags & dx_lay.AF_SPACE_BEFORE) != 0 as u32 { fl = fl | dx_prim.F_SPACE }
            if ((*it).flags & dx_lay.AF_JOIN) != 0 as u32 { fl = fl | dx_prim.F_JOIN }
            if *para_first {
                fl = fl | dx_prim.F_PARA
                *para_first = false
            } else if line_first {
                fl = fl | dx_prim.F_LINE
            }
            line_first = false
            if k == dx_lay.A_WORD {
                vec_push[dx_prim.Prim](sink, dx_prim.prim_text((*st).face, (*st).color, (*it).off, (*it).n, x, by, (*it).w, (*st).px, fl))
            } else {
                vec_push[dx_prim.Prim](sink, dx_prim.prim_field((*st).face, (*st).color, (*at).off as i64, x, by, (*it).w, (*st).px, fl))
            }
        } else if k == dx_lay.A_IMAGE {
            var ip: dx_prim.Prim = dx_prim.prim_image((*at).img as i64, x, basey - (*at).h, (*it).w, (*at).h)
            ip.flags = hf
            vec_push[dx_prim.Prim](sink, ip)
        }
        i = i + 1
    }
    span_flush(&ul, sink, hf)
    span_flush(&ul2, sink, hf)
    span_flush(&stk, sink, hf)
}

fn emit_lines(l: *mut dx_lay.Lay, pi: u32, x0: f64, width: f64, from: usize, to: usize, oy: f64,
    sink: *mut Vec[dx_prim.Prim], hf: u32) {
    if from >= to {
        return
    }
    let pa: *mut dx_model.Para = dx_model.para_at((*l).d, pi)
    let top: *mut dx_lay.LineRec = vec_elem_ptr[dx_lay.LineRec](&(*l).lines, from)
    let last: *mut dx_lay.LineRec = vec_elem_ptr[dx_lay.LineRec](&(*l).lines, to - 1)
    if (*pa).pp.shade != 0 as u32 {
        var lx: f64 = ((*pa).pp.left as f64) / 15.0
        if lx < 0.0 { lx = 0.0 }
        var rx: f64 = width - ((*pa).pp.right as f64) / 15.0
        if rx > width { rx = width }
        if rx > lx {
            var sp: dx_prim.Prim = dx_prim.prim_rect((*pa).pp.shade, x0 + lx, oy, rx - lx, (*last).y + (*last).h - (*top).y)
            sp.flags = hf
            vec_push[dx_prim.Prim](sink, sp)
        }
    }
    var para_first: bool = from == 0
    var k: usize = from
    while k < to {
        let ln: *mut dx_lay.LineRec = vec_elem_ptr[dx_lay.LineRec](&(*l).lines, k)
        emit_line(l, ln, x0, oy + ((*ln).y - (*top).y), &para_first, sink, hf)
        k = k + 1
    }
}
