import std.rt
import std.xml
import docview.office.ooxml
import docview.office.xl_pool

export { sst_load, collect_text }

fn collect_text(x: *mut xml.Doc, n: u32, out: *mut rt.Buf) {
    var c: u32 = ooxml.first_el(x, n)
    while c != xml.NONE {
        if ooxml.is_el(x, c, "t") {
            xml.text_all(x, c, out)
        } else if ooxml.is_el(x, c, "r") {
            collect_text(x, c, out)
        }
        c = ooxml.next_el(x, c)
    }
}

fn sst_load(x: *mut xml.Doc, p: *mut xl_pool.Pool) {
    let root: u32 = xml.root(x)
    var tmp: rt.Buf = rt.buf_new()
    defer rt.buf_free(&tmp)
    var si: u32 = ooxml.first_el(x, root)
    while si != xml.NONE {
        if ooxml.is_el(x, si, "si") {
            rt.buf_clear(&tmp)
            collect_text(x, si, &tmp)
            if !xl_pool.pool_add_buf(p, &tmp) {
                return
            }
        }
        si = ooxml.next_el(x, si)
    }
}
