import docview.registry
import docview.kinds
import docview.lazy
import docview.office.dx_ops
import docview.office.xl_load

export { xlsx_ops, xlsx_install, xlsx_install_lazy }

fn xlsx_open(p: u64, n: usize) -> u64 {
    return dx_ops.open_with(p, n, xl_load.xlsx_load)
}

fn xlsx_ops() -> registry.DocOps {
    return dx_ops.view_ops(xlsx_open)
}

fn xlsx_install() {
    registry.register("xlsx.native", kinds.KIND_XLSX, xlsx_ops())
}

fn xlsx_install_lazy() {
    lazy.lazy_register("xlsx.native", kinds.KIND_XLSX, xlsx_install)
}
