// SPDX-License-Identifier: MPL-2.0
import std.rt
import docview.obj
import docview.registry
import docview.kinds
import docview.lazy
import docview.office.opc
import docview.office.dx_load
import docview.office.dx_view
import docview.office.dx_page
import docview.office.dx_paint
import docview.office.dx_text
import std.vec

export { docx_ops, docx_install, docx_install_lazy }

fn docx_open(p: u64, n: usize) -> u64 {
    let raw: u64 = obj.obj_alloc[dx_view.DocView]()
    if raw == 0 {
        return 0
    }
    let v: *mut dx_view.DocView = raw as *mut dx_view.DocView
    dx_view.view_init(v)
    if !opc.pkg_open(&(*v).pk, p, n) || !dx_load.docx_load(&(*v).pk, &(*v).d) {
        dx_view.view_free(v)
        obj.obj_free[dx_view.DocView](raw)
        return 0
    }
    dx_page.paginate(v)
    return raw
}

fn docx_pages(h: u64) -> usize {
    let v: *mut dx_view.DocView = h as *mut dx_view.DocView
    return vec_len[dx_view.PageRec](&(*v).pages)
}

fn docx_size(h: u64, page: usize, w: *mut i32, hh: *mut i32) -> bool {
    let v: *mut dx_view.DocView = h as *mut dx_view.DocView
    if page >= vec_len[dx_view.PageRec](&(*v).pages) {
        return false
    }
    let rec: *mut dx_view.PageRec = dx_view.page_at(v, page)
    *w = ((*rec).w + 0.5) as i32
    *hh = ((*rec).h + 0.5) as i32
    return true
}

fn docx_render(h: u64, page: usize, scale: f64, out: *mut rt.Buf, w: *mut i32, hh: *mut i32) -> bool {
    return dx_paint.render_page(h as *mut dx_view.DocView, page, scale, out, w, hh)
}

fn docx_text(h: u64, page: usize, out: *mut rt.Buf) -> bool {
    return dx_text.page_text(h as *mut dx_view.DocView, page, out)
}

fn docx_free(h: u64) {
    dx_view.view_free(h as *mut dx_view.DocView)
    obj.obj_free[dx_view.DocView](h)
}

fn docx_ops() -> registry.DocOps {
    var o: registry.DocOps = registry.ops_empty()
    o.open = docx_open
    o.pages = docx_pages
    o.page_size = docx_size
    o.render = docx_render
    o.text = docx_text
    o.free = docx_free
    return o
}

fn docx_install() {
    registry.register("docx.native", kinds.KIND_DOCX, docx_ops())
}

fn docx_install_lazy() {
    lazy.lazy_register("docx.native", kinds.KIND_DOCX, docx_install)
}
