// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.vec

export { Pool, POOL_MAX, pool_new, pool_free, pool_add, pool_add_buf, pool_get, pool_count }

const POOL_MAX: usize = 100663296

struct Pool {
    buf: rt.Buf,
    offs: Vec[u32],
    lens: Vec[u32],
}

fn pool_new() -> Pool {
    return Pool { buf: rt.buf_new(), offs: vec_new[u32](), lens: vec_new[u32]() }
}

fn pool_free(p: *mut Pool) {
    rt.buf_free(&(*p).buf)
    vec_free[u32](&(*p).offs)
    vec_free[u32](&(*p).lens)
}

fn pool_count(p: *mut Pool) -> usize {
    return vec_len[u32](&(*p).offs)
}

fn pool_add(p: *mut Pool, s: str) -> bool {
    if rt.buf_len(&(*p).buf) + s.n > POOL_MAX {
        return false
    }
    let off: usize = rt.buf_len(&(*p).buf)
    rt.buf_push_bytes(&(*p).buf, s.p as u64, s.n)
    vec_push[u32](&(*p).offs, off as u32)
    vec_push[u32](&(*p).lens, s.n as u32)
    return true
}

fn pool_add_buf(p: *mut Pool, b: *mut rt.Buf) -> bool {
    return pool_add(p, rt.buf_str(b))
}

fn pool_get(p: *mut Pool, i: usize) -> str {
    if i >= vec_len[u32](&(*p).offs) {
        return ""
    }
    let off: u32 = *vec_elem_ptr[u32](&(*p).offs, i)
    let n: u32 = *vec_elem_ptr[u32](&(*p).lens, i)
    return str { p: rt.ptr_of(rt.buf_ptr(&(*p).buf) + (off as u64)), n: n as usize }
}
