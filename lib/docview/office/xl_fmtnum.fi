// SPDX-License-Identifier: MPL-2.0
import std.rt
import docview.office.xl_digits
import docview.office.xl_general
import docview.office.xl_fmtscan

export { format_numeric }

struct NumSpec {
    group: bool,
    scale: i32,
    percent: bool,
    min_int: i32,
    dec: i32,
    min_frac: i32,
    sci: i32,
    placeholders: i32,
}

fn is_ph(c: u8) -> bool {
    return c == (48 as u8) || c == (35 as u8) || c == (63 as u8)
}

fn byte(s: str, i: usize) -> u8 {
    return rt.ld8(s.p as u64, i)
}

fn comma_is_group(s: str, i: usize) -> bool {
    var j: usize = i
    while j < s.n && byte(s, j) == (44 as u8) {
        j = j + 1
    }
    return j < s.n && is_ph(byte(s, j))
}

fn analyse(s: str) -> NumSpec {
    var sp: NumSpec = NumSpec { group: false, scale: 0, percent: false, min_int: 0, dec: 0, min_frac: 0, sci: 0, placeholders: 0 }
    var tmp: rt.Buf = rt.buf_new()
    defer rt.buf_free(&tmp)
    var in_frac: bool = false
    var i: usize = 0
    while i < s.n {
        let j: usize = xl_fmtscan.lit_item(s, i, &tmp)
        if j != i {
            i = j
        } else {
            let c: u8 = byte(s, i)
            if is_ph(c) {
                sp.placeholders = sp.placeholders + 1
                if in_frac {
                    sp.dec = sp.dec + 1
                    if c != (35 as u8) {
                        sp.min_frac = sp.dec
                    }
                } else if c != (35 as u8) {
                    sp.min_int = sp.min_int + 1
                }
                i = i + 1
            } else if c == (44 as u8) {
                if sp.placeholders > 0 && !in_frac {
                    if comma_is_group(s, i) {
                        sp.group = true
                    } else {
                        sp.scale = sp.scale + 1
                    }
                }
                i = i + 1
            } else if c == (46 as u8) {
                if !in_frac && (sp.placeholders > 0 || (i + 1 < s.n && is_ph(byte(s, i + 1)))) {
                    in_frac = true
                }
                i = i + 1
            } else if c == (37 as u8) {
                sp.percent = true
                i = i + 1
            } else if (c == (69 as u8) || c == (101 as u8)) && i + 1 < s.n && (byte(s, i + 1) == (43 as u8) || byte(s, i + 1) == (45 as u8)) {
                var k: usize = i + 2
                while k < s.n && byte(s, k) == (48 as u8) {
                    k = k + 1
                }
                sp.sci = (k - i - 2) as i32
                if sp.sci < 1 {
                    sp.sci = 1
                }
                i = k
            } else {
                i = i + 1
            }
        }
    }
    return sp
}

fn number_text(sp: *mut NumSpec, a0: f64, out: *mut rt.Buf) {
    var a: f64 = a0
    if (*sp).percent {
        a = a * 100.0
    }
    var k: i32 = 0
    while k < (*sp).scale {
        a = a / 1000.0
        k = k + 1
    }
    if (*sp).sci > 0 {
        xl_digits.push_sci(out, a, (*sp).dec, (*sp).sci, (*sp).min_frac)
        return
    }
    if !xl_digits.push_fixed(out, a, (*sp).dec, (*sp).group, (*sp).min_int, (*sp).min_frac) {
        xl_general.general(a, out)
    }
}

fn format_numeric(s: str, a: f64, out: *mut rt.Buf) {
    var sp: NumSpec = analyse(s)
    if sp.placeholders == 0 && sp.sci == 0 {
        var i0: usize = 0
        while i0 < s.n {
            let j0: usize = xl_fmtscan.lit_item(s, i0, out)
            if j0 != i0 {
                i0 = j0
            } else {
                let c0: u8 = byte(s, i0)
                if c0 != (37 as u8) && c0 != (64 as u8) {
                    rt.buf_push(out, c0)
                }
                i0 = i0 + 1
            }
        }
        return
    }
    var num: rt.Buf = rt.buf_new()
    defer rt.buf_free(&num)
    number_text(&sp, a, &num)
    var emitted: bool = false
    var in_frac: bool = false
    var i: usize = 0
    while i < s.n {
        let j: usize = xl_fmtscan.lit_item(s, i, out)
        if j != i {
            i = j
        } else {
            let c: u8 = byte(s, i)
            if is_ph(c) {
                if !emitted {
                    rt.buf_push_bytes(out, rt.buf_ptr(&num), rt.buf_len(&num))
                    emitted = true
                }
                i = i + 1
            } else if c == (44 as u8) {
                i = i + 1
            } else if c == (46 as u8) {
                if emitted || (i + 1 < s.n && is_ph(byte(s, i + 1))) {
                    in_frac = true
                } else {
                    rt.buf_push(out, c)
                }
                i = i + 1
            } else if (c == (69 as u8) || c == (101 as u8)) && sp.sci > 0 && i + 1 < s.n && (byte(s, i + 1) == (43 as u8) || byte(s, i + 1) == (45 as u8)) {
                var k: usize = i + 2
                while k < s.n && byte(s, k) == (48 as u8) {
                    k = k + 1
                }
                i = k
            } else if c == (64 as u8) {
                i = i + 1
            } else {
                rt.buf_push(out, c)
                i = i + 1
            }
        }
    }
    if !emitted {
        rt.buf_push_bytes(out, rt.buf_ptr(&num), rt.buf_len(&num))
    }
}
