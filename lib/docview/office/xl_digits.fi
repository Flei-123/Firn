// SPDX-License-Identifier: MPL-2.0
import std.rt

export { pow10_f, pow10_u, push_int, push_fixed, push_sci, push_str }

fn push_str(out: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(out, s.p as u64, s.n)
}

fn pow10_f(n: i32) -> f64 {
    var r: f64 = 1.0
    var i: i32 = 0
    while i < n {
        r = r * 10.0
        i = i + 1
    }
    return r
}

fn pow10_u(n: i32) -> u64 {
    var r: u64 = 1
    var i: i32 = 0
    while i < n && i < 19 {
        r = r * 10
        i = i + 1
    }
    return r
}

fn push_int(out: *mut rt.Buf, v: u64, group: bool, min_digits: i32) {
    var digits: [u8; 24] = [0 as u8; 24]
    var n: usize = 0
    var x: u64 = v
    while x > 0 && n < 24 {
        digits[n] = ((x % 10) as u8) + (48 as u8)
        x = x / 10
        n = n + 1
    }
    while (n as i32) < min_digits && n < 24 {
        digits[n] = 48 as u8
        n = n + 1
    }
    var i: usize = n
    while i > 0 {
        rt.buf_push(out, digits[i - 1])
        if group && i > 1 && ((i - 1) % 3) == 0 {
            rt.buf_push(out, 44 as u8)
        }
        i = i - 1
    }
}

fn push_fixed(out: *mut rt.Buf, a: f64, dec: i32, group: bool, min_int: i32, min_frac: i32) -> bool {
    let scale: f64 = pow10_f(dec)
    let x: f64 = a * scale * 1.000000000001 + 0.5
    if x >= 9.0e18 {
        return false
    }
    let r: u64 = x as u64
    let p: u64 = pow10_u(dec)
    let ip: u64 = r / p
    var fp: u64 = r % p
    push_int(out, ip, group, min_int)
    if dec == 0 {
        return true
    }
    var fd: [u8; 20] = [48 as u8; 20]
    var k: i32 = dec - 1
    while k >= 0 {
        fd[k as usize] = ((fp % 10) as u8) + (48 as u8)
        fp = fp / 10
        k = k - 1
    }
    var keep: i32 = dec
    while keep > min_frac && fd[(keep - 1) as usize] == (48 as u8) {
        keep = keep - 1
    }
    if keep > 0 {
        rt.buf_push(out, 46 as u8)
        var j: i32 = 0
        while j < keep {
            rt.buf_push(out, fd[j as usize])
            j = j + 1
        }
    }
    return true
}

fn push_sci(out: *mut rt.Buf, a: f64, dec: i32, exp_digits: i32, min_frac: i32) {
    if a == 0.0 {
        push_fixed(out, 0.0, dec, false, 1, min_frac)
        push_str(out, "E+")
        push_int(out, 0, false, exp_digits)
        return
    }
    var e: i32 = 0
    var m: f64 = a
    while m >= 10.0 && e < 330 {
        m = m / 10.0
        e = e + 1
    }
    while m < 1.0 && e > -330 {
        m = m * 10.0
        e = e - 1
    }
    let lim: f64 = 10.0 - 0.5 / pow10_f(dec)
    if m >= lim {
        m = m / 10.0
        e = e + 1
    }
    push_fixed(out, m, dec, false, 1, min_frac)
    rt.buf_push(out, 69 as u8)
    var ea: i32 = e
    if e < 0 {
        rt.buf_push(out, 45 as u8)
        ea = 0 - e
    } else {
        rt.buf_push(out, 43 as u8)
    }
    push_int(out, ea as u64, false, exp_digits)
}
