import std.rt
import std.vec
import docview.office.dx_model
import docview.office.dx_prim
import docview.office.dx_lay
import docview.office.dx_view

export { page_text }

fn page_text(v: *mut dx_view.DocView, pi: usize, out: *mut rt.Buf) -> bool {
    if pi >= vec_len[dx_view.PageRec](&(*v).pages) {
        return false
    }
    let rec: *mut dx_view.PageRec = dx_view.page_at(v, pi)
    var pending: u8 = 0 as u8
    var i: u32 = (*rec).first
    let end: u32 = (*rec).first + (*rec).count
    while i < end {
        let p: *mut dx_prim.Prim = vec_elem_ptr[dx_prim.Prim](&(*v).prims, i as usize)
        i = i + (1 as u32)
        if (*p).kind != dx_prim.P_TEXT {
            continue
        }
        let fl: u32 = (*p).flags
        if (fl & dx_prim.F_HF) != 0 as u32 {
            continue
        }
        if (fl & dx_prim.F_PARA) != 0 as u32 {
            pending = 10 as u8
        } else if pending == (0 as u8) {
            if (fl & dx_prim.F_SPACE) != 0 as u32 {
                pending = 32 as u8
            } else if (fl & dx_prim.F_LINE) != 0 as u32 && (fl & dx_prim.F_JOIN) == 0 as u32 {
                pending = 32 as u8
            }
        }
        if (fl & dx_prim.F_LABEL) != 0 as u32 {
            continue
        }
        if pending != (0 as u8) && rt.buf_len(out) > 0 {
            rt.buf_push(out, pending)
        }
        pending = 0 as u8
        rt.buf_push_bytes(out, rt.buf_ptr(&(*v).d.pool) + ((*p).off as u64), (*p).n as usize)
    }
    return true
}
