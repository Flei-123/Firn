import std.rt
import std.vec
import docview.office.dx_model
import docview.office.dx_prim
import docview.office.dx_lay
import docview.office.dx_view
import docview.office.dx_page

export { page_text, page_text_body }

fn walk(v: *mut dx_view.DocView, prims: *mut Vec[dx_prim.Prim], from: usize, to: usize, hf_part: bool, fields: bool,
    num: i64, out: *mut rt.Buf, pending: *mut u8) {
    var i: usize = from
    while i < to {
        let p: *mut dx_prim.Prim = vec_elem_ptr[dx_prim.Prim](prims, i)
        i = i + 1
        let is_field: bool = (*p).kind == dx_prim.P_FIELD
        if (*p).kind != dx_prim.P_TEXT && !(fields && is_field) {
            continue
        }
        let fl: u32 = (*p).flags
        if !hf_part && (fl & dx_prim.F_HF) != 0 as u32 {
            continue
        }
        if (fl & dx_prim.F_PARA) != 0 as u32 {
            *pending = 10 as u8
        } else if *pending == (0 as u8) {
            if (fl & dx_prim.F_SPACE) != 0 as u32 {
                *pending = 32 as u8
            } else if (fl & dx_prim.F_LINE) != 0 as u32 && (fl & dx_prim.F_JOIN) == 0 as u32 {
                *pending = 32 as u8
            }
        }
        if (fl & dx_prim.F_LABEL) != 0 as u32 {
            continue
        }
        if *pending != (0 as u8) && rt.buf_len(out) > 0 {
            rt.buf_push(out, *pending)
        }
        *pending = 0 as u8
        if is_field {
            var n: i64 = num
            if (*p).a == (dx_model.FLD_NUMPAGES as i32) {
                n = vec_len[dx_view.PageRec](&(*v).pages) as i64
            }
            rt.buf_push_dec_i64(out, n)
        } else {
            rt.buf_push_bytes(out, rt.buf_ptr(&(*v).d.pool) + ((*p).off as u64), (*p).n as usize)
        }
    }
}

fn page_text_body(v: *mut dx_view.DocView, pi: usize, out: *mut rt.Buf) -> bool {
    if pi >= vec_len[dx_view.PageRec](&(*v).pages) {
        return false
    }
    let rec: *mut dx_view.PageRec = dx_view.page_at(v, pi)
    var pending: u8 = 0 as u8
    walk(v, &(*v).prims, (*rec).first as usize, ((*rec).first + (*rec).count) as usize, false, false, (*rec).num, out, &pending)
    return true
}

fn page_text(v: *mut dx_view.DocView, pi: usize, out: *mut rt.Buf) -> bool {
    if pi >= vec_len[dx_view.PageRec](&(*v).pages) {
        return false
    }
    let rec: *mut dx_view.PageRec = dx_view.page_at(v, pi)
    var hf: Vec[dx_prim.Prim] = vec_new[dx_prim.Prim]()
    defer vec_free[dx_prim.Prim](&hf)
    let header_end: usize = dx_page.hf_prims(v, pi, &hf)
    var pending: u8 = 0 as u8
    walk(v, &hf, 0, header_end, true, true, (*rec).num, out, &pending)
    walk(v, &(*v).prims, (*rec).first as usize, ((*rec).first + (*rec).count) as usize, false, true, (*rec).num, out, &pending)
    walk(v, &hf, header_end, vec_len[dx_prim.Prim](&hf), true, true, (*rec).num, out, &pending)
    return true
}
