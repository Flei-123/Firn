import std.rt
import std.vec
import std.xml
import docview.office.opc
import docview.office.ooxml
import docview.office.dx_model
import docview.office.pp_slide

export { pptx_load }

const MAX_SLIDES: usize = 500
const SIZE_MAX_TW: i32 = 31680
const SIZE_MIN_TW: i32 = 1440

fn clamp_tw(v: i64, dflt: i32) -> i32 {
    var t: i64 = v / 635
    if t <= 0 {
        return dflt
    }
    if t < (SIZE_MIN_TW as i64) {
        t = SIZE_MIN_TW as i64
    }
    if t > (SIZE_MAX_TW as i64) {
        t = SIZE_MAX_TW as i64
    }
    return t as i32
}

fn pptx_load(pk: *mut opc.Package, d: *mut dx_model.Docx) -> bool {
    var main_part: rt.Buf = rt.buf_new()
    defer rt.buf_free(&main_part)
    if !opc.pkg_main_part(pk, &main_part) {
        return false
    }
    let main: str = rt.buf_str(&main_part)
    var rels: opc.Rels = opc.rels_new()
    defer opc.rels_free(&rels)
    opc.rels_load(pk, main, &rels)
    var raw: rt.Buf = rt.buf_new()
    defer rt.buf_free(&raw)
    var px: xml.Doc = xml.doc_new()
    defer xml.doc_free(&px)
    if !opc.pkg_read_xml(pk, main, &raw, &px) {
        return false
    }
    let root: u32 = xml.root(&px)
    let sz: u32 = ooxml.child_l(&px, root, "sldSz")
    var parts: pp_slide.SlideParts = pp_slide.SlideParts { pk: pk, px: &px,
        defaults: ooxml.child_l(&px, root, "defaultTextStyle"), page_w: 14400, page_h: 10800 }
    if sz != xml.NONE {
        parts.page_w = clamp_tw(ooxml.attr_i64(&px, sz, "cx", 9144000), 14400)
        parts.page_h = clamp_tw(ooxml.attr_i64(&px, sz, "cy", 6858000), 10800)
    }
    let ids: u32 = ooxml.child_l(&px, root, "sldIdLst")
    var list: dx_model.BList = dx_model.blist_new()
    var loaded: usize = 0
    var n: u32 = ooxml.first_el(&px, ids)
    while n != xml.NONE && loaded < MAX_SLIDES {
        if ooxml.is_el(&px, n, "sldId") {
            let ri: i64 = opc.rels_find_id(&rels, xml.attr(&px, n, "r:id"))
            if ri >= 0 && !opc.rels_external(&rels, ri as usize) {
                if pp_slide.load_slide(&parts, d, opc.rels_target(&rels, ri as usize), &list) {
                    loaded = loaded + 1
                }
            }
        }
        n = ooxml.next_el(&px, n)
    }
    if loaded == 0 {
        return false
    }
    (*d).body = list
    return true
}
