import std.rt
import font.ttf
import font.fallback
import font.raster
import docview.pdf.pdffonts_data
import docview.office.dx_props

export {
    Fonts, fonts_zero, fonts_init, fonts_free, face_of, text_width, face_ascent, face_descent, face_lead, paint_text,
    px_of_hp, FACE_COUNT,
}

const FACE_COUNT: usize = 11
const FACE_SERIF: usize = 0
const FACE_SANS: usize = 4
const FACE_MONO: usize = 8

struct Fonts {
    font: [ttf.Font; 11],
    chain: [fallback.Chain; 11],
    have: [u32; 11],
    ctx: fallback.PaintCtx,
    ready: bool,
}

fn fonts_zero() -> Fonts {
    return Fonts { font: [ttf.font_new(); 11], chain: [fallback.Chain { n: 0, fonts: [0 as *mut ttf.Font; 6], kind: [0; 6], gb: 0 }; 11], have: [0 as u32; 11],
        ctx: fallback.PaintCtx { ra: raster.raster_new(), rbuf: 0, rcap: 0, scratch: 0, straight: false }, ready: false }
}

fn fonts_init(f: *mut Fonts) {
    var base: fallback.Chain = fallback.chain_new()
    var i: usize = 0
    while i < FACE_COUNT {
        (*f).font[i] = ttf.font_new()
        (*f).have[i] = 0 as u32
        (*f).chain[i] = base
        (*f).chain[i].n = 0
        if ttf.font_init(&(*f).font[i], pdffonts_data.pdffont_ptr(i) as *mut u8, pdffonts_data.pdffont_len(i)) {
            (*f).have[i] = 1 as u32
            fallback.chain_add(&(*f).chain[i], &(*f).font[i], fallback.K_LATIN)
        }
        i = i + 1
    }
    (*f).ctx = fallback.ctx_new()
    (*f).ready = true
}

fn fonts_free(f: *mut Fonts) {
    if !(*f).ready {
        return
    }
    fallback.chain_free(&(*f).chain[0])
    fallback.ctx_free(&(*f).ctx)
    (*f).ready = false
}

fn face_of(rp: *mut dx_props.RunProps) -> usize {
    let b: bool = (*rp).bold != 0
    let it: bool = (*rp).italic != 0
    if (*rp).mono == 1 {
        if b {
            return FACE_MONO + 1
        }
        if it {
            return FACE_MONO + 2
        }
        return FACE_MONO
    }
    var base: usize = FACE_SANS
    if (*rp).mono == 2 {
        base = FACE_SERIF
    }
    if b && it {
        return base + 3
    }
    if b {
        return base + 1
    }
    if it {
        return base + 2
    }
    return base
}

fn usable(f: *mut Fonts, face: usize) -> usize {
    if face < FACE_COUNT && (*f).have[face] != 0 as u32 {
        return face
    }
    return FACE_SANS
}

fn px_of_hp(hp: i32) -> f64 {
    return (hp as f64) * 2.0 / 3.0
}

fn text_width(f: *mut Fonts, face: usize, p: u64, n: usize, px: f64) -> f64 {
    if n == 0 {
        return 0.0
    }
    return fallback.chain_width(&(*f).chain[usable(f, face)], p, n, px)
}

fn face_ascent(f: *mut Fonts, face: usize, px: f64) -> f64 {
    let ft: *mut ttf.Font = &(*f).font[usable(f, face)]
    return (ttf.font_ascent(ft) as f64) * px / (ttf.font_upem(ft) as f64)
}

fn face_descent(f: *mut Fonts, face: usize, px: f64) -> f64 {
    let ft: *mut ttf.Font = &(*f).font[usable(f, face)]
    var d: i32 = ttf.font_descent(ft)
    if d < 0 {
        d = 0 - d
    }
    return (d as f64) * px / (ttf.font_upem(ft) as f64)
}

fn face_lead(f: *mut Fonts, face: usize, px: f64) -> f64 {
    let ft: *mut ttf.Font = &(*f).font[usable(f, face)]
    var d: i32 = ttf.font_descent(ft)
    if d < 0 {
        d = 0 - d
    }
    let total: i32 = ttf.font_ascent(ft) + d + ttf.font_line_gap(ft)
    return (total as f64) * px / (ttf.font_upem(ft) as f64)
}

fn paint_text(f: *mut Fonts, face: usize, p: u64, n: usize, px: f64, x: f64, base: f64, color: u32,
    dst: u64, dw: i32, dh: i32) -> f64 {
    if n == 0 {
        return 0.0
    }
    return fallback.chain_paint(&(*f).ctx, &(*f).chain[usable(f, face)], p, n, px, x, base, color, 0 as u32, dst, dw, dh)
}
