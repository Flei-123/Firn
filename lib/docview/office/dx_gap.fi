import std.rt
import docview.office.dx_model

export { before_zero, after_zero, style_hash }

fn style_hash(s: str) -> u32 {
    var h: u32 = 2166136261 as u32
    var i: usize = 0
    while i < s.n {
        h = (h ^ (rt.ld8(s.p as u64, i) as u32)) *% (16777619 as u32)
        i = i + 1
    }
    return h
}

fn same_style(d: *mut dx_model.Docx, a: u32, b: u32) -> bool {
    if a == dx_model.NIL || b == dx_model.NIL {
        return false
    }
    let ba: *mut dx_model.Block = dx_model.block_at(d, a)
    let bb: *mut dx_model.Block = dx_model.block_at(d, b)
    if (*ba).kind != dx_model.B_PARA || (*bb).kind != dx_model.B_PARA {
        return false
    }
    return (*dx_model.para_at(d, (*ba).idx)).style_key == (*dx_model.para_at(d, (*bb).idx)).style_key
}

fn before_zero(d: *mut dx_model.Docx, prev: u32, cur: u32) -> bool {
    if (*dx_model.para_at(d, (*dx_model.block_at(d, cur)).idx)).pp.ctx_space != 1 {
        return false
    }
    return same_style(d, prev, cur)
}

fn after_zero(d: *mut dx_model.Docx, cur: u32, next: u32) -> bool {
    if (*dx_model.para_at(d, (*dx_model.block_at(d, cur)).idx)).pp.ctx_space != 1 {
        return false
    }
    return same_style(d, cur, next)
}
