import std.rt
import std.vec
import docview.obj
import docview.registry
import docview.office.opc
import docview.office.dx_model
import docview.office.dx_view
import docview.office.dx_fonts
import docview.office.dx_page
import docview.office.dx_paint
import docview.office.dx_text
import docview.office.dx_float

export { LoadFn, open_with, view_ops }

type LoadFn = fn(*mut opc.Package, *mut dx_model.Docx) -> bool

fn open_with(p: u64, n: usize, load: LoadFn) -> u64 {
    let raw: u64 = obj.obj_alloc[dx_view.DocView]()
    if raw == 0 {
        return 0
    }
    let v: *mut dx_view.DocView = raw as *mut dx_view.DocView
    dx_view.view_init(v)
    if !dx_fonts.fonts_any(&(*v).fonts) {
        dx_view.view_free(v)
        obj.obj_free[dx_view.DocView](raw)
        return 0
    }
    dx_float.install(&(*v).lay)
    if !opc.pkg_open(&(*v).pk, p, n) || !load(&(*v).pk, &(*v).d) {
        dx_view.view_free(v)
        obj.obj_free[dx_view.DocView](raw)
        return 0
    }
    dx_page.paginate(v)
    return raw
}

fn view_pages(h: u64) -> usize {
    let v: *mut dx_view.DocView = h as *mut dx_view.DocView
    return vec_len[dx_view.PageRec](&(*v).pages)
}

fn view_size(h: u64, page: usize, w: *mut i32, hh: *mut i32) -> bool {
    let v: *mut dx_view.DocView = h as *mut dx_view.DocView
    if page >= vec_len[dx_view.PageRec](&(*v).pages) {
        return false
    }
    let rec: *mut dx_view.PageRec = dx_view.page_at(v, page)
    *w = ((*rec).w + 0.5) as i32
    *hh = ((*rec).h + 0.5) as i32
    return true
}

fn view_render(h: u64, page: usize, scale: f64, out: *mut rt.Buf, w: *mut i32, hh: *mut i32) -> bool {
    return dx_paint.render_page(h as *mut dx_view.DocView, page, scale, out, w, hh)
}

fn view_text(h: u64, page: usize, out: *mut rt.Buf) -> bool {
    return dx_text.page_text(h as *mut dx_view.DocView, page, out)
}

fn view_free(h: u64) {
    dx_view.view_free(h as *mut dx_view.DocView)
    obj.obj_free[dx_view.DocView](h)
}

fn view_ops(open: registry.OpenFn) -> registry.DocOps {
    var o: registry.DocOps = registry.ops_empty()
    o.open = open
    o.pages = view_pages
    o.page_size = view_size
    o.render = view_render
    o.text = view_text
    o.free = view_free
    return o
}
