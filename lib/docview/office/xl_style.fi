import std.rt
import std.xml
import std.vec
import docview.office.ooxml
import docview.office.dx_props
import docview.office.dx_pr
import docview.office.xl_color
import docview.office.xl_pool
import docview.office.xl_numfmt

export { styles_finish, XFont, XBorder, Xf, XlStyles, styles_new, styles_free, styles_load, xf_at, font_at, fill_at, border_at, xf_code, MAX_XF }

const MAX_XF: usize = 65536

struct XFont {
    size_hp: i32,
    bold: bool,
    italic: bool,
    underline: bool,
    strike: bool,
    mono: bool,
    color: u32,
}

struct XBorder {
    left: dx_props.Border,
    right: dx_props.Border,
    top: dx_props.Border,
    bottom: dx_props.Border,
}

struct Xf {
    numfmt: i32,
    font: i32,
    fill: i32,
    border: i32,
    halign: i32,
    wrap: bool,
    indent: i32,
    date: bool,
}

struct XlStyles {
    fonts: Vec[XFont],
    fills: Vec[u32],
    borders: Vec[XBorder],
    xfs: Vec[Xf],
    fmt_ids: Vec[i32],
    fmt_codes: xl_pool.Pool,
    theme: xl_color.Theme,
}

fn styles_new() -> XlStyles {
    return XlStyles { fonts: vec_new[XFont](), fills: vec_new[u32](), borders: vec_new[XBorder](), xfs: vec_new[Xf](),
        fmt_ids: vec_new[i32](), fmt_codes: xl_pool.pool_new(), theme: xl_color.theme_new() }
}

fn styles_free(s: *mut XlStyles) {
    vec_free[XFont](&(*s).fonts)
    vec_free[u32](&(*s).fills)
    vec_free[XBorder](&(*s).borders)
    vec_free[Xf](&(*s).xfs)
    vec_free[i32](&(*s).fmt_ids)
    xl_pool.pool_free(&(*s).fmt_codes)
}

fn xf_at(s: *mut XlStyles, i: usize) -> *mut Xf {
    return vec_elem_ptr[Xf](&(*s).xfs, i)
}

fn font_at(s: *mut XlStyles, i: i32) -> *mut XFont {
    var k: usize = 0
    if i >= 0 && (i as usize) < vec_len[XFont](&(*s).fonts) {
        k = i as usize
    }
    return vec_elem_ptr[XFont](&(*s).fonts, k)
}

fn styles_finish(s: *mut XlStyles) {
    if vec_len[XFont](&(*s).fonts) == 0 {
        vec_push[XFont](&(*s).fonts, XFont { size_hp: 22, bold: false, italic: false, underline: false, strike: false, mono: false, color: 0 as u32 })
    }
    if vec_len[XBorder](&(*s).borders) == 0 {
        vec_push[XBorder](&(*s).borders, XBorder { left: dx_props.border_unset(), right: dx_props.border_unset(),
            top: dx_props.border_unset(), bottom: dx_props.border_unset() })
    }
}

fn fill_at(s: *mut XlStyles, i: i32) -> u32 {
    if i < 0 || (i as usize) >= vec_len[u32](&(*s).fills) {
        return 0 as u32
    }
    return *vec_elem_ptr[u32](&(*s).fills, i as usize)
}

fn border_at(s: *mut XlStyles, i: i32) -> *mut XBorder {
    var k: usize = 0
    if i >= 0 && (i as usize) < vec_len[XBorder](&(*s).borders) {
        k = i as usize
    }
    return vec_elem_ptr[XBorder](&(*s).borders, k)
}

fn flag(x: *mut xml.Doc, n: u32) -> bool {
    if n == xml.NONE {
        return false
    }
    let v: str = ooxml.attr_l(x, n, "val")
    return !(v == "0" || v == "false")
}

fn read_font(s: *mut XlStyles, x: *mut xml.Doc, n: u32) -> XFont {
    var f: XFont = XFont { size_hp: 22, bold: false, italic: false, underline: false, strike: false, mono: false, color: 0 as u32 }
    f.bold = flag(x, ooxml.child_l(x, n, "b"))
    f.italic = flag(x, ooxml.child_l(x, n, "i"))
    f.strike = flag(x, ooxml.child_l(x, n, "strike"))
    let u: u32 = ooxml.child_l(x, n, "u")
    if u != xml.NONE {
        f.underline = ooxml.attr_l(x, u, "val") != "none"
    }
    let sz: u32 = ooxml.child_l(x, n, "sz")
    if sz != xml.NONE {
        let v: i64 = ooxml.attr_i64(x, sz, "val", 11)
        if v >= 1 && v <= 400 {
            f.size_hp = (v * 2) as i32
        }
    }
    let nm: u32 = ooxml.child_l(x, n, "name")
    if nm != xml.NONE {
        f.mono = dx_pr.is_mono_name(ooxml.attr_l(x, nm, "val"))
    }
    f.color = xl_color.color_of(x, ooxml.child_l(x, n, "color"), &(*s).theme)
    return f
}

fn border_side(s: *mut XlStyles, x: *mut xml.Doc, n: u32) -> dx_props.Border {
    if n == xml.NONE {
        return dx_props.border_unset()
    }
    let st: str = ooxml.attr_l(x, n, "style")
    if st.n == 0 || st == "none" {
        return dx_props.border_unset()
    }
    var sz: i32 = 4
    if st == "hair" { sz = 2 }
    if st == "medium" || st == "mediumDashed" || st == "mediumDashDot" || st == "mediumDashDotDot" || st == "slantDashDot" { sz = 8 }
    if st == "double" { sz = 12 }
    if st == "thick" { sz = 16 }
    var col: u32 = xl_color.color_of(x, ooxml.child_l(x, n, "color"), &(*s).theme)
    if col == 0 as u32 {
        col = 0xFF000000 as u32
    }
    return dx_props.Border { sz: sz, color: col }
}

fn read_border(s: *mut XlStyles, x: *mut xml.Doc, n: u32) -> XBorder {
    var l: u32 = ooxml.child_l(x, n, "left")
    if l == xml.NONE { l = ooxml.child_l(x, n, "start") }
    var r: u32 = ooxml.child_l(x, n, "right")
    if r == xml.NONE { r = ooxml.child_l(x, n, "end") }
    return XBorder { left: border_side(s, x, l), right: border_side(s, x, r),
        top: border_side(s, x, ooxml.child_l(x, n, "top")), bottom: border_side(s, x, ooxml.child_l(x, n, "bottom")) }
}

fn read_fill(s: *mut XlStyles, x: *mut xml.Doc, n: u32) -> u32 {
    let pf: u32 = ooxml.child_l(x, n, "patternFill")
    if pf == xml.NONE {
        return 0 as u32
    }
    let pt: str = ooxml.attr_l(x, pf, "patternType")
    if pt == "none" || pt == "gray125" || pt.n == 0 {
        return 0 as u32
    }
    var c: u32 = xl_color.color_of(x, ooxml.child_l(x, pf, "fgColor"), &(*s).theme)
    if c == 0 as u32 && pt == "solid" {
        c = xl_color.color_of(x, ooxml.child_l(x, pf, "bgColor"), &(*s).theme)
    }
    return c
}

fn halign_of(v: str) -> i32 {
    if v == "left" { return dx_props.ALIGN_LEFT }
    if v == "center" || v == "centerContinuous" { return dx_props.ALIGN_CENTER }
    if v == "right" { return dx_props.ALIGN_RIGHT }
    if v == "justify" || v == "distributed" { return dx_props.ALIGN_JUSTIFY }
    return -1
}

fn fmt_code(s: *mut XlStyles, id: i32) -> str {
    var i: usize = 0
    let n: usize = vec_len[i32](&(*s).fmt_ids)
    while i < n {
        if *vec_elem_ptr[i32](&(*s).fmt_ids, i) == id {
            return xl_pool.pool_get(&(*s).fmt_codes, i)
        }
        i = i + 1
    }
    return xl_numfmt.builtin_code(id as i64)
}

fn xf_code(s: *mut XlStyles, xf: *mut Xf) -> str {
    return fmt_code(s, (*xf).numfmt)
}

fn read_xf(s: *mut XlStyles, x: *mut xml.Doc, n: u32) -> Xf {
    var xf: Xf = Xf { numfmt: ooxml.attr_i64(x, n, "numFmtId", 0) as i32, font: ooxml.attr_i64(x, n, "fontId", 0) as i32,
        fill: ooxml.attr_i64(x, n, "fillId", 0) as i32, border: ooxml.attr_i64(x, n, "borderId", 0) as i32,
        halign: -1, wrap: false, indent: 0, date: false }
    let al: u32 = ooxml.child_l(x, n, "alignment")
    if al != xml.NONE {
        xf.halign = halign_of(ooxml.attr_l(x, al, "horizontal"))
        let w: str = ooxml.attr_l(x, al, "wrapText")
        xf.wrap = w == "1" || w == "true"
        xf.indent = ooxml.attr_i64(x, al, "indent", 0) as i32
    }
    if xf.font < 0 || (xf.font as usize) >= vec_len[XFont](&(*s).fonts) {
        xf.font = 0
    }
    if xf.border < 0 || (xf.border as usize) >= vec_len[XBorder](&(*s).borders) {
        xf.border = 0
    }
    xf.date = xl_numfmt.is_date_code(fmt_code(s, xf.numfmt))
    return xf
}

fn styles_load(s: *mut XlStyles, x: *mut xml.Doc) {
    let root: u32 = xml.root(x)
    let nf: u32 = ooxml.child_l(x, root, "numFmts")
    var c: u32 = ooxml.first_el(x, nf)
    while c != xml.NONE {
        if ooxml.is_el(x, c, "numFmt") {
            if xl_pool.pool_add(&(*s).fmt_codes, ooxml.attr_l(x, c, "formatCode")) {
                vec_push[i32](&(*s).fmt_ids, ooxml.attr_i64(x, c, "numFmtId", 0) as i32)
            }
        }
        c = ooxml.next_el(x, c)
    }
    let fs: u32 = ooxml.child_l(x, root, "fonts")
    c = ooxml.first_el(x, fs)
    while c != xml.NONE {
        if ooxml.is_el(x, c, "font") && vec_len[XFont](&(*s).fonts) < 4096 {
            vec_push[XFont](&(*s).fonts, read_font(s, x, c))
        }
        c = ooxml.next_el(x, c)
    }
    if vec_len[XFont](&(*s).fonts) == 0 {
        vec_push[XFont](&(*s).fonts, read_font(s, x, xml.NONE))
    }
    let fl: u32 = ooxml.child_l(x, root, "fills")
    c = ooxml.first_el(x, fl)
    while c != xml.NONE {
        if ooxml.is_el(x, c, "fill") && vec_len[u32](&(*s).fills) < 4096 {
            vec_push[u32](&(*s).fills, read_fill(s, x, c))
        }
        c = ooxml.next_el(x, c)
    }
    let bs: u32 = ooxml.child_l(x, root, "borders")
    c = ooxml.first_el(x, bs)
    while c != xml.NONE {
        if ooxml.is_el(x, c, "border") && vec_len[XBorder](&(*s).borders) < 4096 {
            vec_push[XBorder](&(*s).borders, read_border(s, x, c))
        }
        c = ooxml.next_el(x, c)
    }
    if vec_len[XBorder](&(*s).borders) == 0 {
        vec_push[XBorder](&(*s).borders, read_border(s, x, xml.NONE))
    }
    let xs: u32 = ooxml.child_l(x, root, "cellXfs")
    c = ooxml.first_el(x, xs)
    while c != xml.NONE {
        if ooxml.is_el(x, c, "xf") && vec_len[Xf](&(*s).xfs) < MAX_XF {
            vec_push[Xf](&(*s).xfs, read_xf(s, x, c))
        }
        c = ooxml.next_el(x, c)
    }
}
