import std.xml
import std.vec
import docview.office.dx_model
import docview.office.dx_ctx
import docview.office.dx_body

export { load_pending }

fn load_pending(c: *mut dx_ctx.Ctx, d: *mut dx_model.Docx, x: *mut xml.Doc) {
    var i: usize = 0
    let n: usize = vec_len[dx_model.Float](&(*d).floats)
    while i < n {
        let node: u32 = (*dx_model.float_at(d, i as u32)).tx_node
        if node != xml.NONE {
            (*dx_model.float_at(d, i as u32)).tx_node = xml.NONE
            var bl: dx_model.BList = dx_model.blist_new()
            (*c).float_depth = (*c).float_depth + 1
            dx_body.parse_blocks(c, d, x, node, &bl, 1)
            (*c).float_depth = (*c).float_depth - 1
            (*dx_model.float_at(d, i as u32)).blocks = bl
        }
        i = i + 1
    }
}
