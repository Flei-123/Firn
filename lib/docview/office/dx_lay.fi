import std.rt
import std.vec
import docview.office.dx_props
import docview.office.dx_model
import docview.office.dx_fonts
import docview.office.dx_utf8

export {
    Atom, Item, LineRec, Lay, RStyle, A_WORD, A_SPACE, A_TAB, A_BREAK, A_PBREAK, A_IMAGE, A_FIELD,
    AF_SPACE_BEFORE, AF_LABEL, AF_LABEL_TAB, AF_JOIN, AF_GLUE,
    lay_new, lay_free, run_style, measure, pool_ptr, px_of_tw, field_width,
}

const A_WORD: u32 = 0
const A_SPACE: u32 = 1
const A_TAB: u32 = 2
const A_BREAK: u32 = 3
const A_PBREAK: u32 = 4
const A_IMAGE: u32 = 5
const A_FIELD: u32 = 6

const AF_SPACE_BEFORE: u32 = 1
const AF_LABEL: u32 = 2
const AF_LABEL_TAB: u32 = 4
const AF_JOIN: u32 = 8
const AF_GLUE: u32 = 16

struct RStyle {
    face: usize,
    px: f64,
    shift: f64,
    asc: f64,
    desc: f64,
    lead: f64,
    color: u32,
    shade: u32,
    ul: i32,
    strike: bool,
    caps: bool,
}

struct Atom {
    kind: u32,
    run: u32,
    off: u32,
    n: u32,
    flags: u32,
    w: f64,
    h: f64,
    img: i32,
    st: RStyle,
}

struct Item {
    atom: u32,
    off: u32,
    n: u32,
    flags: u32,
    w: f64,
    x: f64,
}

struct LineRec {
    i0: u32,
    i1: u32,
    y: f64,
    h: f64,
    base: f64,
    pbreak: bool,
}

struct Lay {
    d: *mut dx_model.Docx,
    fonts: *mut dx_fonts.Fonts,
    atoms: Vec[Atom],
    items: Vec[Item],
    lines: Vec[LineRec],
    tmp: rt.Buf,
    cur_page: i64,
    total: i64,
    para_h: f64,
    pbreak_last: bool,
}

fn lay_new(d: *mut dx_model.Docx, f: *mut dx_fonts.Fonts) -> Lay {
    return Lay { d: d, fonts: f, atoms: vec_new[Atom](), items: vec_new[Item](), lines: vec_new[LineRec](),
        tmp: rt.buf_new(), cur_page: 0, total: 0, para_h: 0.0, pbreak_last: false }
}

fn lay_free(l: *mut Lay) {
    vec_free[Atom](&(*l).atoms)
    vec_free[Item](&(*l).items)
    vec_free[LineRec](&(*l).lines)
    rt.buf_free(&(*l).tmp)
}

fn px_of_tw(tw: i32) -> f64 {
    return (tw as f64) / 15.0
}

fn pool_ptr(l: *mut Lay, off: u32) -> u64 {
    return rt.buf_ptr(&(*(*l).d).pool) + (off as u64)
}

fn run_style(l: *mut Lay, rp: *mut dx_props.RunProps, out: *mut RStyle) {
    var px: f64 = dx_fonts.px_of_hp((*rp).size_hp)
    var shift: f64 = 0.0
    if (*rp).vert == dx_props.VA_SUPER {
        shift = 0.0 - px * 0.33
        px = px * 0.65
    } else if (*rp).vert == dx_props.VA_SUB {
        shift = px * 0.14
        px = px * 0.65
    }
    let face: usize = dx_fonts.face_of(rp)
    (*out).face = face
    (*out).px = px
    (*out).shift = shift
    (*out).asc = dx_fonts.face_ascent((*l).fonts, face, px) - shift
    (*out).desc = dx_fonts.face_descent((*l).fonts, face, px) + shift
    (*out).lead = dx_fonts.face_lead((*l).fonts, face, px)
    (*out).color = (*rp).color
    (*out).shade = (*rp).shade
    (*out).ul = (*rp).underline
    (*out).strike = (*rp).strike != 0
    (*out).caps = (*rp).caps != 0
}

fn measure(l: *mut Lay, face: usize, px: f64, caps: bool, p: u64, n: usize) -> f64 {
    if caps {
        rt.buf_clear(&(*l).tmp)
        dx_utf8.push_upper(&(*l).tmp, p, n)
        return dx_fonts.text_width((*l).fonts, face, rt.buf_ptr(&(*l).tmp), rt.buf_len(&(*l).tmp), px)
    }
    return dx_fonts.text_width((*l).fonts, face, p, n, px)
}

fn digits_of(v: i64) -> i64 {
    var n: i64 = 1
    var x: i64 = v
    while x >= 10 {
        x = x / 10
        n = n + 1
    }
    return n
}

fn field_width(l: *mut Lay, kind: i64, face: usize, px: f64) -> f64 {
    var v: i64 = 99
    if kind == dx_model.FLD_PAGE && (*l).cur_page > 0 {
        v = (*l).cur_page
    } else if kind == dx_model.FLD_NUMPAGES && (*l).total > 0 {
        v = (*l).total
    }
    let zero: [u8; 1] = "0"
    let dw: f64 = dx_fonts.text_width((*l).fonts, face, (&zero[0]) as u64, 1, px)
    return dw * (digits_of(v) as f64)
}
