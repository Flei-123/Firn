import docview.registry
import docview.kinds
import docview.lazy
import docview.office.dx_ops
import docview.office.od_load

export { odt_ops, odt_install, odt_install_lazy }

fn odt_open(p: u64, n: usize) -> u64 {
    return dx_ops.open_with(p, n, od_load.odt_load)
}

fn odt_ops() -> registry.DocOps {
    return dx_ops.view_ops(odt_open)
}

fn odt_install() {
    registry.register("odt.native", kinds.KIND_ODT, odt_ops())
}

fn odt_install_lazy() {
    lazy.lazy_register("odt.native", kinds.KIND_ODT, odt_install)
}
