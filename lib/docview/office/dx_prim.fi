// SPDX-License-Identifier: MPL-2.0
import std.vec

export {
    Prim, P_TEXT, P_RECT, P_IMAGE, P_FIELD,
    F_PARA, F_CELL, F_LINE, F_SPACE, F_LABEL, F_CAPS, F_ROW, F_ITALIC,
    MAX_PRIMS, prim_text, prim_rect, prim_image, prim_field, prims_shift, prims_move,
}

const P_TEXT: u32 = 0
const P_RECT: u32 = 1
const P_IMAGE: u32 = 2
const P_FIELD: u32 = 3
const F_PARA: u32 = 1
const F_CELL: u32 = 2
const F_LINE: u32 = 4
const F_SPACE: u32 = 8
const F_LABEL: u32 = 16
const F_CAPS: u32 = 32
const F_ROW: u32 = 64
const F_ITALIC: u32 = 128
const MAX_PRIMS: usize = 3000000

struct Prim {
    kind: u32,
    flags: u32,
    face: u32,
    color: u32,
    off: u32,
    n: u32,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    size: f32,
    a: i32,
}

fn prim_text(face: usize, color: u32, off: u32, n: u32, x: f64, y: f64, w: f64, size: f64, flags: u32) -> Prim {
    return Prim { kind: P_TEXT, flags: flags, face: face as u32, color: color, off: off, n: n,
        x: x as f32, y: y as f32, w: w as f32, h: 0.0 as f32, size: size as f32, a: 0 }
}

fn prim_field(face: usize, color: u32, kind: i64, x: f64, y: f64, w: f64, size: f64, flags: u32) -> Prim {
    return Prim { kind: P_FIELD, flags: flags, face: face as u32, color: color, off: 0 as u32, n: 0 as u32,
        x: x as f32, y: y as f32, w: w as f32, h: 0.0 as f32, size: size as f32, a: kind as i32 }
}

fn prim_rect(color: u32, x: f64, y: f64, w: f64, h: f64) -> Prim {
    return Prim { kind: P_RECT, flags: 0 as u32, face: 0 as u32, color: color, off: 0 as u32, n: 0 as u32,
        x: x as f32, y: y as f32, w: w as f32, h: h as f32, size: 0.0 as f32, a: 0 }
}

fn prim_image(idx: i64, x: f64, y: f64, w: f64, h: f64) -> Prim {
    return Prim { kind: P_IMAGE, flags: 0 as u32, face: 0 as u32, color: 0 as u32, off: 0 as u32, n: 0 as u32,
        x: x as f32, y: y as f32, w: w as f32, h: h as f32, size: 0.0 as f32, a: idx as i32 }
}

fn prims_shift(v: *mut Vec[Prim], from: usize, dx: f64, dy: f64) {
    var i: usize = from
    let n: usize = vec_len[Prim](v)
    while i < n {
        let p: *mut Prim = vec_elem_ptr[Prim](v, i)
        (*p).x = (*p).x + (dx as f32)
        (*p).y = (*p).y + (dy as f32)
        i = i + 1
    }
}

fn prims_move(dst: *mut Vec[Prim], src: *mut Vec[Prim], from: usize, count: usize, dx: f64, dy: f64) {
    var i: usize = 0
    while i < count {
        var p: Prim = *vec_elem_ptr[Prim](src, from + i)
        p.x = p.x + (dx as f32)
        p.y = p.y + (dy as f32)
        vec_push[Prim](dst, p)
        i = i + 1
    }
}
