// SPDX-License-Identifier: MPL-2.0
export {
    RunProps, ParaProps, Border, TblProps, TabStop,
    UNSET_T, ALIGN_LEFT, ALIGN_CENTER, ALIGN_RIGHT, ALIGN_JUSTIFY,
    RULE_AUTO, RULE_EXACT, RULE_ATLEAST,
    UL_NONE, UL_SINGLE, UL_DOUBLE,
    VA_BASE, VA_SUPER, VA_SUB, TAB_LEFT, TAB_CENTER, TAB_RIGHT, MAX_TABS,
    rp_unset, rp_apply, rp_eq, rp_finish, pp_unset, pp_apply, pp_finish,
    border_none, tbl_unset, tbl_apply, border_unset,
}

const UNSET_T: i32 = -1000000000
const ALIGN_LEFT: i32 = 0
const ALIGN_CENTER: i32 = 1
const ALIGN_RIGHT: i32 = 2
const ALIGN_JUSTIFY: i32 = 3
const RULE_AUTO: i32 = 0
const RULE_EXACT: i32 = 1
const RULE_ATLEAST: i32 = 2
const UL_NONE: i32 = 0
const UL_SINGLE: i32 = 1
const UL_DOUBLE: i32 = 2
const VA_BASE: i32 = 0
const VA_SUPER: i32 = 1
const VA_SUB: i32 = 2
const TAB_LEFT: i32 = 0
const TAB_CENTER: i32 = 1
const TAB_RIGHT: i32 = 2
const MAX_TABS: usize = 8

struct RunProps {
    size_hp: i32,
    bold: i32,
    italic: i32,
    underline: i32,
    strike: i32,
    vert: i32,
    mono: i32,
    caps: i32,
    color: u32,
    shade: u32,
}

struct TabStop {
    pos: i32,
    kind: i32,
}

struct ParaProps {
    align: i32,
    left: i32,
    right: i32,
    first: i32,
    before: i32,
    after: i32,
    line: i32,
    rule: i32,
    keep_next: i32,
    keep_lines: i32,
    page_break_before: i32,
    num_id: i32,
    ilvl: i32,
    outline: i32,
    ctx_space: i32,
    shade: u32,
    ntabs: i32,
    tabs: [TabStop; 8],
}

struct Border {
    sz: i32,
    color: u32,
}

struct TblProps {
    top: Border,
    left: Border,
    bottom: Border,
    right: Border,
    inner_h: Border,
    inner_v: Border,
    mar_left: i32,
    mar_right: i32,
    mar_top: i32,
    mar_bottom: i32,
    align: i32,
    indent: i32,
}

fn rp_unset() -> RunProps {
    return RunProps { size_hp: 0, bold: -1, italic: -1, underline: -1, strike: -1, vert: -1, mono: -1, caps: -1,
        color: 0 as u32, shade: 0 as u32 }
}

fn rp_apply(base: *mut RunProps, over: *mut RunProps) {
    if (*over).size_hp > 0 { (*base).size_hp = (*over).size_hp }
    if (*over).bold >= 0 { (*base).bold = (*over).bold }
    if (*over).italic >= 0 { (*base).italic = (*over).italic }
    if (*over).underline >= 0 { (*base).underline = (*over).underline }
    if (*over).strike >= 0 { (*base).strike = (*over).strike }
    if (*over).vert >= 0 { (*base).vert = (*over).vert }
    if (*over).mono >= 0 { (*base).mono = (*over).mono }
    if (*over).caps >= 0 { (*base).caps = (*over).caps }
    if (*over).color != 0 as u32 { (*base).color = (*over).color }
    if (*over).shade != 0 as u32 { (*base).shade = (*over).shade }
}

fn rp_eq(a: *mut RunProps, b: *mut RunProps) -> bool {
    return (*a).size_hp == (*b).size_hp && (*a).bold == (*b).bold && (*a).italic == (*b).italic
        && (*a).underline == (*b).underline && (*a).strike == (*b).strike && (*a).vert == (*b).vert
        && (*a).mono == (*b).mono && (*a).caps == (*b).caps && (*a).color == (*b).color && (*a).shade == (*b).shade
}

fn rp_finish(p: *mut RunProps) {
    if (*p).size_hp <= 0 { (*p).size_hp = 22 }
    if (*p).size_hp > 1584 { (*p).size_hp = 1584 }
    if (*p).bold < 0 { (*p).bold = 0 }
    if (*p).italic < 0 { (*p).italic = 0 }
    if (*p).underline < 0 { (*p).underline = 0 }
    if (*p).strike < 0 { (*p).strike = 0 }
    if (*p).vert < 0 { (*p).vert = 0 }
    if (*p).mono < 0 { (*p).mono = 0 }
    if (*p).caps < 0 { (*p).caps = 0 }
    if (*p).color == 0 as u32 { (*p).color = 0xFF000000 as u32 }
}

fn pp_unset() -> ParaProps {
    return ParaProps { align: -1, left: UNSET_T, right: UNSET_T, first: UNSET_T, before: UNSET_T, after: UNSET_T,
        line: UNSET_T, rule: -1, keep_next: -1, keep_lines: -1, page_break_before: -1, num_id: -1, ilvl: -1,
        outline: -1, ctx_space: -1, shade: 0 as u32, ntabs: 0,
        tabs: [TabStop { pos: 0, kind: 0 }; 8] }
}

fn pp_apply(base: *mut ParaProps, over: *mut ParaProps) {
    if (*over).align >= 0 { (*base).align = (*over).align }
    if (*over).left != UNSET_T { (*base).left = (*over).left }
    if (*over).right != UNSET_T { (*base).right = (*over).right }
    if (*over).first != UNSET_T { (*base).first = (*over).first }
    if (*over).before != UNSET_T { (*base).before = (*over).before }
    if (*over).after != UNSET_T { (*base).after = (*over).after }
    if (*over).line != UNSET_T { (*base).line = (*over).line }
    if (*over).rule >= 0 { (*base).rule = (*over).rule }
    if (*over).keep_next >= 0 { (*base).keep_next = (*over).keep_next }
    if (*over).keep_lines >= 0 { (*base).keep_lines = (*over).keep_lines }
    if (*over).page_break_before >= 0 { (*base).page_break_before = (*over).page_break_before }
    if (*over).num_id >= 0 { (*base).num_id = (*over).num_id }
    if (*over).ilvl >= 0 { (*base).ilvl = (*over).ilvl }
    if (*over).outline >= 0 { (*base).outline = (*over).outline }
    if (*over).ctx_space >= 0 { (*base).ctx_space = (*over).ctx_space }
    if (*over).shade != 0 as u32 { (*base).shade = (*over).shade }
    if (*over).ntabs > 0 {
        (*base).ntabs = (*over).ntabs
        var i: usize = 0
        while i < MAX_TABS {
            (*base).tabs[i] = (*over).tabs[i]
            i = i + 1
        }
    }
}

fn pp_finish(p: *mut ParaProps) {
    if (*p).align < 0 { (*p).align = ALIGN_LEFT }
    if (*p).left == UNSET_T { (*p).left = 0 }
    if (*p).right == UNSET_T { (*p).right = 0 }
    if (*p).first == UNSET_T { (*p).first = 0 }
    if (*p).before == UNSET_T { (*p).before = 0 }
    if (*p).after == UNSET_T { (*p).after = 0 }
    if (*p).line == UNSET_T { (*p).line = 240 }
    if (*p).rule < 0 { (*p).rule = RULE_AUTO }
    if (*p).keep_next < 0 { (*p).keep_next = 0 }
    if (*p).keep_lines < 0 { (*p).keep_lines = 0 }
    if (*p).page_break_before < 0 { (*p).page_break_before = 0 }
    if (*p).num_id < 0 { (*p).num_id = 0 }
    if (*p).ilvl < 0 { (*p).ilvl = 0 }
    if (*p).ctx_space < 0 { (*p).ctx_space = 0 }
}

fn border_unset() -> Border {
    return Border { sz: -1, color: 0 as u32 }
}

fn border_none() -> Border {
    return Border { sz: 0, color: 0xFF000000 as u32 }
}

fn tbl_unset() -> TblProps {
    return TblProps { top: border_unset(), left: border_unset(), bottom: border_unset(), right: border_unset(),
        inner_h: border_unset(), inner_v: border_unset(), mar_left: UNSET_T, mar_right: UNSET_T,
        mar_top: UNSET_T, mar_bottom: UNSET_T, align: -1, indent: UNSET_T }
}

fn border_apply(base: *mut Border, over: *mut Border) {
    if (*over).sz >= 0 {
        (*base).sz = (*over).sz
        (*base).color = (*over).color
    }
}

fn tbl_apply(base: *mut TblProps, over: *mut TblProps) {
    border_apply(&(*base).top, &(*over).top)
    border_apply(&(*base).left, &(*over).left)
    border_apply(&(*base).bottom, &(*over).bottom)
    border_apply(&(*base).right, &(*over).right)
    border_apply(&(*base).inner_h, &(*over).inner_h)
    border_apply(&(*base).inner_v, &(*over).inner_v)
    if (*over).mar_left != UNSET_T { (*base).mar_left = (*over).mar_left }
    if (*over).mar_right != UNSET_T { (*base).mar_right = (*over).mar_right }
    if (*over).mar_top != UNSET_T { (*base).mar_top = (*over).mar_top }
    if (*over).mar_bottom != UNSET_T { (*base).mar_bottom = (*over).mar_bottom }
    if (*over).align >= 0 { (*base).align = (*over).align }
    if (*over).indent != UNSET_T { (*base).indent = (*over).indent }
}
