import std.rt
import std.vec
import docview.office.opc
import docview.office.dx_model
import docview.office.dx_fonts
import docview.office.dx_lay
import docview.office.dx_prim

export { PageRec, ImgSlot, DocView, view_init, view_free, page_at, IMG_NEW, IMG_OK, IMG_BAD }

const IMG_NEW: i32 = 0
const IMG_OK: i32 = 1
const IMG_BAD: i32 = 2

struct PageRec {
    first: u32,
    count: u32,
    sect: u32,
    hdr: i32,
    ftr: i32,
    w: f64,
    h: f64,
    left: f64,
    width: f64,
}

struct ImgSlot {
    state: i32,
    px: rt.Buf,
    w: usize,
    h: usize,
}

struct DocView {
    pk: opc.Package,
    d: dx_model.Docx,
    fonts: dx_fonts.Fonts,
    lay: dx_lay.Lay,
    prims: Vec[dx_prim.Prim],
    pages: Vec[PageRec],
    hf_h: Vec[f64],
    imgs: Vec[ImgSlot],
    tbuf: rt.Buf,
}

fn view_init(v: *mut DocView) {
    (*v).pk = opc.pkg_new()
    (*v).d = dx_model.docx_new()
    (*v).fonts = dx_fonts.fonts_zero()
    dx_fonts.fonts_init(&(*v).fonts)
    (*v).lay = dx_lay.lay_new(&(*v).d, &(*v).fonts)
    (*v).prims = vec_new[dx_prim.Prim]()
    (*v).pages = vec_new[PageRec]()
    (*v).hf_h = vec_new[f64]()
    (*v).imgs = vec_new[ImgSlot]()
    (*v).tbuf = rt.buf_new()
}

fn view_free(v: *mut DocView) {
    var i: usize = 0
    let n: usize = vec_len[ImgSlot](&(*v).imgs)
    while i < n {
        rt.buf_free(&(*vec_elem_ptr[ImgSlot](&(*v).imgs, i)).px)
        i = i + 1
    }
    vec_free[ImgSlot](&(*v).imgs)
    vec_free[f64](&(*v).hf_h)
    vec_free[PageRec](&(*v).pages)
    vec_free[dx_prim.Prim](&(*v).prims)
    dx_lay.lay_free(&(*v).lay)
    dx_fonts.fonts_free(&(*v).fonts)
    dx_model.docx_free(&(*v).d)
    opc.pkg_free(&(*v).pk)
    rt.buf_free(&(*v).tbuf)
}

fn page_at(v: *mut DocView, i: usize) -> *mut PageRec {
    return vec_elem_ptr[PageRec](&(*v).pages, i)
}
