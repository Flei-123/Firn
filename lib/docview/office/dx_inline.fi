import std.rt
import std.xml
import docview.office.opc
import docview.office.ooxml
import docview.office.dx_props
import docview.office.dx_pr
import docview.office.dx_style
import docview.office.dx_model
import docview.office.dx_ctx
import docview.office.dx_utf8

export { ParaState, parse_inline, para_state_new }

struct ParaState {
    para: u32,
    base: dx_props.RunProps,
    fdepth: i32,
    fkind: [i64; 8],
    fphase: [i32; 8],
    fsup: [i32; 8],
}

fn para_state_new(para: u32, base: dx_props.RunProps) -> ParaState {
    return ParaState { para: para, base: base, fdepth: 0, fkind: [0 as i64; 8], fphase: [0; 8], fsup: [0; 8] }
}

fn suppressed(ps: *mut ParaState) -> bool {
    var i: i32 = 0
    while i < (*ps).fdepth && i < 8 {
        if (*ps).fsup[i as usize] != 0 {
            return true
        }
        if (*ps).fphase[i as usize] == 0 {
            return true
        }
        i = i + 1
    }
    return false
}

fn emit_text(d: *mut dx_model.Docx, ps: *mut ParaState, rp: *mut dx_props.RunProps, p: u64, n: usize) {
    if n == 0 {
        return
    }
    let pool_len: usize = rt.buf_len(&(*d).pool)
    let nruns: usize = vec_len[dx_model.Run](&(*d).runs)
    let pa: *mut dx_model.Para = dx_model.para_at(d, (*ps).para)
    if nruns > ((*pa).rfirst as usize) {
        let last: *mut dx_model.Run = dx_model.run_at(d, (nruns - 1) as u32)
        if (*last).kind == dx_model.R_TEXT && ((*last).toff as usize) + ((*last).tn as usize) == pool_len && dx_props.rp_eq(&(*last).rp, rp) {
            rt.buf_push_bytes(&(*d).pool, p, n)
            (*last).tn = (*last).tn + (n as u32)
            return
        }
    }
    let off: u32 = dx_model.pool_add(d, p, n)
    dx_model.run_add(d, dx_model.Run { kind: dx_model.R_TEXT, rp: *rp, toff: off, tn: n as u32, a: 0, w: 0.0, h: 0.0 })
}

fn emit_simple(d: *mut dx_model.Docx, rp: *mut dx_props.RunProps, kind: u32, a: i64, w: f64, h: f64) {
    dx_model.run_add(d, dx_model.Run { kind: kind, rp: *rp, toff: 0 as u32, tn: 0 as u32, a: a, w: w, h: h })
}

fn find_desc(x: *mut xml.Doc, n: u32, name: str, depth: i32) -> u32 {
    if depth > 14 || n == xml.NONE {
        return xml.NONE
    }
    var c: u32 = ooxml.first_el(x, n)
    while c != xml.NONE {
        if ooxml.is_el(x, c, name) {
            return c
        }
        let r: u32 = find_desc(x, c, name, depth + 1)
        if r != xml.NONE {
            return r
        }
        c = ooxml.next_el(x, c)
    }
    return xml.NONE
}

fn clampf(v: f64, lo: f64, hi: f64) -> f64 {
    if v < lo { return lo }
    if v > hi { return hi }
    return v
}

fn rel_part(c: *mut dx_ctx.Ctx, rid: str, out: *mut rt.Buf) -> bool {
    if rid.n == 0 {
        return false
    }
    let i: i64 = opc.rels_find_id((*c).rels, rid)
    if i < 0 {
        return false
    }
    if opc.rels_external((*c).rels, i as usize) {
        return false
    }
    let t: str = opc.rels_target((*c).rels, i as usize)
    rt.buf_push_bytes(out, t.p as u64, t.n)
    return true
}

fn parse_drawing(c: *mut dx_ctx.Ctx, d: *mut dx_model.Docx, x: *mut xml.Doc, dr: u32, rp: *mut dx_props.RunProps) {
    let ext: u32 = find_desc(x, dr, "extent", 0)
    var w: f64 = 96.0
    var h: f64 = 96.0
    if ext != xml.NONE {
        w = clampf((ooxml.attr_i64(x, ext, "cx", 914400) as f64) / 9525.0, 1.0, 30000.0)
        h = clampf((ooxml.attr_i64(x, ext, "cy", 914400) as f64) / 9525.0, 1.0, 30000.0)
    }
    let blip: u32 = find_desc(x, dr, "blip", 0)
    var idx: i64 = -1
    if blip != xml.NONE {
        var part: rt.Buf = rt.buf_new()
        defer rt.buf_free(&part)
        if rel_part(c, ooxml.attr_l(x, blip, "embed"), &part) {
            idx = dx_model.new_image(d, rt.buf_str(&part)) as i64
        }
    } else {
        let gf: u32 = find_desc(x, dr, "wsp", 0)
        if gf != xml.NONE {
            return
        }
    }
    emit_simple(d, rp, dx_model.R_IMAGE, idx, w, h)
}

fn style_len(s: str, key: str, dflt: f64) -> f64 {
    var i: usize = 0
    while i + key.n < s.n {
        if rt.mem_eq((s.p as u64) + (i as u64), key.p as u64, key.n) {
            var j: usize = i + key.n
            var v: f64 = 0.0
            var frac: f64 = 0.0
            var scale: f64 = 0.1
            var seen_dot: bool = false
            while j < s.n {
                let ch: u8 = rt.ld8(s.p as u64, j)
                if ch >= 48 as u8 && ch <= 57 as u8 {
                    if seen_dot {
                        frac = frac + ((ch - 48 as u8) as f64) * scale
                        scale = scale * 0.1
                    } else {
                        v = v * 10.0 + ((ch - 48 as u8) as f64)
                    }
                } else if ch == 46 as u8 {
                    seen_dot = true
                } else {
                    break
                }
                j = j + 1
            }
            v = v + frac
            if j + 1 < s.n {
                let u0: u8 = rt.ld8(s.p as u64, j)
                let u1: u8 = rt.ld8(s.p as u64, j + 1)
                if u0 == 112 as u8 && u1 == 116 as u8 {
                    return v * 96.0 / 72.0
                }
                if u0 == 105 as u8 && u1 == 110 as u8 {
                    return v * 96.0
                }
                if u0 == 99 as u8 && u1 == 109 as u8 {
                    return v * 96.0 / 2.54
                }
            }
            return v
        }
        i = i + 1
    }
    return dflt
}

fn parse_pict(c: *mut dx_ctx.Ctx, d: *mut dx_model.Docx, x: *mut xml.Doc, pc: u32, rp: *mut dx_props.RunProps) {
    let im: u32 = find_desc(x, pc, "imagedata", 0)
    if im == xml.NONE {
        return
    }
    var w: f64 = 96.0
    var h: f64 = 96.0
    let sh: u32 = find_desc(x, pc, "shape", 0)
    if sh != xml.NONE {
        let st: str = ooxml.attr_l(x, sh, "style")
        w = clampf(style_len(st, "width:", 96.0), 1.0, 30000.0)
        h = clampf(style_len(st, "height:", 96.0), 1.0, 30000.0)
    }
    var part: rt.Buf = rt.buf_new()
    defer rt.buf_free(&part)
    var idx: i64 = -1
    if rel_part(c, ooxml.attr_l(x, im, "id"), &part) {
        idx = dx_model.new_image(d, rt.buf_str(&part)) as i64
    }
    emit_simple(d, rp, dx_model.R_IMAGE, idx, w, h)
}

fn field_kind(instr: str) -> i64 {
    var i: usize = 0
    while i < instr.n && rt.ld8(instr.p as u64, i) == 32 as u8 {
        i = i + 1
    }
    var j: usize = i
    while j < instr.n && rt.ld8(instr.p as u64, j) != 32 as u8 {
        j = j + 1
    }
    let w: str = str { p: rt.ptr_of((instr.p as u64) + (i as u64)), n: j - i }
    if ooxml.str_eq_ci(w, "PAGE") {
        return dx_model.FLD_PAGE
    }
    if ooxml.str_eq_ci(w, "NUMPAGES") || ooxml.str_eq_ci(w, "SECTIONPAGES") {
        return dx_model.FLD_NUMPAGES
    }
    return 0
}

fn hex_digit(ch: u8) -> i32 {
    if ch >= 48 as u8 && ch <= 57 as u8 { return (ch - 48 as u8) as i32 }
    if ch >= 97 as u8 && ch <= 102 as u8 { return (ch - 97 as u8) as i32 + 10 }
    if ch >= 65 as u8 && ch <= 70 as u8 { return (ch - 65 as u8) as i32 + 10 }
    return -1
}

fn parse_fldchar(c: *mut dx_ctx.Ctx, d: *mut dx_model.Docx, ps: *mut ParaState, ty: str, rp: *mut dx_props.RunProps) {
    if ty == "begin" {
        if (*ps).fdepth < 8 {
            let k: usize = (*ps).fdepth as usize
            (*ps).fkind[k] = 0
            (*ps).fphase[k] = 0
            (*ps).fsup[k] = 0
        }
        (*ps).fdepth = (*ps).fdepth + 1
        rt.buf_clear(&(*c).instr)
    } else if ty == "separate" {
        if (*ps).fdepth > 0 && (*ps).fdepth <= 8 {
            let k2: usize = ((*ps).fdepth - 1) as usize
            let kind: i64 = field_kind(rt.buf_str(&(*c).instr))
            (*ps).fkind[k2] = kind
            (*ps).fphase[k2] = 1
            if kind != 0 {
                (*ps).fsup[k2] = 1
                if !suppressed_except(ps, k2) {
                    emit_simple(d, rp, dx_model.R_FIELD, kind, 0.0, 0.0)
                }
            }
        }
    } else if ty == "end" {
        if (*ps).fdepth > 0 {
            (*ps).fdepth = (*ps).fdepth - 1
        }
    }
}

fn suppressed_except(ps: *mut ParaState, k: usize) -> bool {
    var i: usize = 0
    while i < k {
        if (*ps).fsup[i] != 0 || (*ps).fphase[i] == 0 {
            return true
        }
        i = i + 1
    }
    return false
}

fn parse_run_children(c: *mut dx_ctx.Ctx, d: *mut dx_model.Docx, x: *mut xml.Doc, r: u32, ps: *mut ParaState,
    rp: *mut dx_props.RunProps, depth: i32) {
    if depth > 6 {
        return
    }
    var ch: u32 = ooxml.first_el(x, r)
    while ch != xml.NONE {
        let nm: str = ooxml.local_name(xml.name(x, ch))
        if nm == "fldChar" {
            parse_fldchar(c, d, ps, ooxml.attr_l(x, ch, "fldCharType"), rp)
        } else if nm == "instrText" {
            if (*ps).fdepth > 0 && rt.buf_len(&(*c).instr) < 4096 {
                var tmp: rt.Buf = rt.buf_new()
                defer rt.buf_free(&tmp)
                xml.text_all(x, ch, &tmp)
                rt.buf_push_bytes(&(*c).instr, rt.buf_ptr(&tmp), rt.buf_len(&tmp))
            }
        } else if nm == "AlternateContent" {
            let choice: u32 = ooxml.child_l(x, ch, "Choice")
            if choice != xml.NONE {
                parse_run_children(c, d, x, choice, ps, rp, depth + 1)
            }
        } else if !suppressed(ps) {
            if nm == "t" {
                let s: str = xml.text(x, ch)
                emit_text(d, ps, rp, s.p as u64, s.n)
            } else if nm == "tab" {
                emit_simple(d, rp, dx_model.R_TAB, 0, 0.0, 0.0)
            } else if nm == "br" {
                let ty: str = ooxml.attr_l(x, ch, "type")
                var kind: i64 = dx_model.BR_LINE
                if ty == "page" {
                    kind = dx_model.BR_PAGE
                } else if ty == "column" {
                    kind = dx_model.BR_COLUMN
                }
                emit_simple(d, rp, dx_model.R_BREAK, kind, 0.0, 0.0)
            } else if nm == "cr" {
                emit_simple(d, rp, dx_model.R_BREAK, dx_model.BR_LINE, 0.0, 0.0)
            } else if nm == "noBreakHyphen" {
                emit_text(d, ps, rp, "-".p as u64, 1)
            } else if nm == "sym" {
                let hx: str = ooxml.attr_l(x, ch, "char")
                var cp: u32 = 0
                var k: usize = 0
                while k < hx.n && k < 6 {
                    let hv: i32 = hex_digit(rt.ld8(hx.p as u64, k))
                    if hv >= 0 {
                        cp = (cp << 4 as u32) | (hv as u32)
                    }
                    k = k + 1
                }
                if cp >= 0xF000 as u32 && cp <= 0xF0FF as u32 {
                    cp = 0x2022 as u32
                }
                if cp != 0 as u32 {
                    var tmp2: rt.Buf = rt.buf_new()
                    defer rt.buf_free(&tmp2)
                    dx_utf8.push_cp(&tmp2, cp)
                    emit_text(d, ps, rp, rt.buf_ptr(&tmp2), rt.buf_len(&tmp2))
                }
            } else if nm == "drawing" {
                parse_drawing(c, d, x, ch, rp)
            } else if nm == "pict" || nm == "object" {
                parse_pict(c, d, x, ch, rp)
            }
        }
        ch = ooxml.next_el(x, ch)
    }
}

fn parse_run(c: *mut dx_ctx.Ctx, d: *mut dx_model.Docx, x: *mut xml.Doc, r: u32, ps: *mut ParaState) {
    var rp: dx_props.RunProps = (*ps).base
    let rpr: u32 = ooxml.child_l(x, r, "rPr")
    if rpr != xml.NONE {
        let rs: u32 = ooxml.child_l(x, rpr, "rStyle")
        if rs != xml.NONE {
            dx_style.resolve_char(&(*c).st, ooxml.attr_l(x, rs, "val"), &rp)
        }
        dx_pr.read_rpr(x, rpr, &rp)
    }
    dx_props.rp_finish(&rp)
    parse_run_children(c, d, x, r, ps, &rp, 0)
}

fn parse_inline(c: *mut dx_ctx.Ctx, d: *mut dx_model.Docx, x: *mut xml.Doc, parent: u32, ps: *mut ParaState, depth: i32) {
    if depth > dx_ctx.MAX_DEPTH {
        return
    }
    var ch: u32 = ooxml.first_el(x, parent)
    while ch != xml.NONE {
        let nm: str = ooxml.local_name(xml.name(x, ch))
        if nm == "r" {
            parse_run(c, d, x, ch, ps)
        } else if nm == "hyperlink" || nm == "smartTag" || nm == "ins" || nm == "customXml" || nm == "bdo" || nm == "moveTo" || nm == "dir" {
            parse_inline(c, d, x, ch, ps, depth + 1)
        } else if nm == "sdt" {
            let sc: u32 = ooxml.child_l(x, ch, "sdtContent")
            if sc != xml.NONE {
                parse_inline(c, d, x, sc, ps, depth + 1)
            }
        } else if nm == "fldSimple" {
            let kind: i64 = field_kind(ooxml.attr_l(x, ch, "instr"))
            if kind != 0 {
                var rp: dx_props.RunProps = (*ps).base
                dx_props.rp_finish(&rp)
                if !suppressed(ps) {
                    emit_simple(d, &rp, dx_model.R_FIELD, kind, 0.0, 0.0)
                }
            } else {
                parse_inline(c, d, x, ch, ps, depth + 1)
            }
        }
        ch = ooxml.next_el(x, ch)
    }
}
