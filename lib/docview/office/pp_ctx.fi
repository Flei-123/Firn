import std.rt
import std.vec
import std.xml
import docview.office.opc
import docview.office.dx_model
import docview.office.pp_color

export { Ctx, Frame, Link, Chain, MAX_CHAIN, ctx_new, chain_clear, chain_push, frame_root, frame_rect_x, frame_rect_y }

const MAX_CHAIN: usize = 8

struct Link {
    x: *mut xml.Doc,
    n: u32,
}

struct Chain {
    items: [Link; 8],
    count: usize,
}

struct Frame {
    ox: f64,
    oy: f64,
    sx: f64,
    sy: f64,
}

struct Ctx {
    d: *mut dx_model.Docx,
    pk: *mut opc.Package,
    pal: pp_color.Palette,
    sx: *mut xml.Doc,
    lx: *mut xml.Doc,
    mx: *mut xml.Doc,
    px: *mut xml.Doc,
    l_tree: u32,
    m_tree: u32,
    m_styles: u32,
    defaults: u32,
    rels: *mut opc.Rels,
    sect: u32,
    floats: Vec[u32],
    font_scale: f64,
    slide_no: i64,
    depth: i32,
    font_color: u32,
    force_bold: bool,
}

fn ctx_new() -> Ctx {
    return Ctx { d: 0 as *mut dx_model.Docx, pk: 0 as *mut opc.Package, pal: pp_color.palette_new(),
        sx: 0 as *mut xml.Doc, lx: 0 as *mut xml.Doc, mx: 0 as *mut xml.Doc, px: 0 as *mut xml.Doc,
        l_tree: xml.NONE, m_tree: xml.NONE, m_styles: xml.NONE, defaults: xml.NONE, rels: 0 as *mut opc.Rels,
        sect: 0 as u32, floats: vec_new[u32](), font_scale: 1.0, slide_no: 0, depth: 0, font_color: 0 as u32, force_bold: false }
}

fn chain_clear(c: *mut Chain) {
    (*c).count = 0
}

fn chain_push(c: *mut Chain, x: *mut xml.Doc, n: u32) {
    if n == xml.NONE || (*c).count >= MAX_CHAIN {
        return
    }
    (*c).items[(*c).count] = Link { x: x, n: n }
    (*c).count = (*c).count + 1
}

fn frame_root() -> Frame {
    return Frame { ox: 0.0, oy: 0.0, sx: 1.0 / 9525.0, sy: 1.0 / 9525.0 }
}

fn frame_rect_x(f: *mut Frame, v: f64) -> f64 {
    return (*f).ox + v * (*f).sx
}

fn frame_rect_y(f: *mut Frame, v: f64) -> f64 {
    return (*f).oy + v * (*f).sy
}
