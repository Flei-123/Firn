// SPDX-License-Identifier: MPL-2.0
import std.xml
import docview.office.ooxml
import docview.office.pp_ctx

export { Geo, geo_new, read_xfrm, ph_node, ph_kind, find_ph, geo_frame, group_frame, chain_attr, PH_NONE, PH_TITLE, PH_BODY, PH_OTHER }

const PH_NONE: i32 = 0
const PH_TITLE: i32 = 1
const PH_BODY: i32 = 2
const PH_OTHER: i32 = 3

struct Geo {
    has: bool,
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    cx: f64,
    cy: f64,
    cw: f64,
    ch: f64,
}

fn geo_new() -> Geo {
    return Geo { has: false, x: 0.0, y: 0.0, w: 0.0, h: 0.0, cx: 0.0, cy: 0.0, cw: 0.0, ch: 0.0 }
}

fn read_xfrm(x: *mut xml.Doc, holder: u32, g: *mut Geo) {
    let xf: u32 = ooxml.child_l(x, holder, "xfrm")
    if xf == xml.NONE {
        return
    }
    let off: u32 = ooxml.child_l(x, xf, "off")
    let ext: u32 = ooxml.child_l(x, xf, "ext")
    if off == xml.NONE || ext == xml.NONE {
        return
    }
    (*g).x = ooxml.attr_i64(x, off, "x", 0) as f64
    (*g).y = ooxml.attr_i64(x, off, "y", 0) as f64
    (*g).w = ooxml.attr_i64(x, ext, "cx", 0) as f64
    (*g).h = ooxml.attr_i64(x, ext, "cy", 0) as f64
    (*g).cx = (*g).x
    (*g).cy = (*g).y
    (*g).cw = (*g).w
    (*g).ch = (*g).h
    let co: u32 = ooxml.child_l(x, xf, "chOff")
    let ce: u32 = ooxml.child_l(x, xf, "chExt")
    if co != xml.NONE && ce != xml.NONE {
        (*g).cx = ooxml.attr_i64(x, co, "x", 0) as f64
        (*g).cy = ooxml.attr_i64(x, co, "y", 0) as f64
        (*g).cw = ooxml.attr_i64(x, ce, "cx", 0) as f64
        (*g).ch = ooxml.attr_i64(x, ce, "cy", 0) as f64
    }
    (*g).has = true
}

fn geo_frame(fr: *mut pp_ctx.Frame, g: *mut Geo, px: *mut f64, py: *mut f64, pw: *mut f64, ph: *mut f64) {
    *px = pp_ctx.frame_rect_x(fr, (*g).x)
    *py = pp_ctx.frame_rect_y(fr, (*g).y)
    *pw = (*g).w * (*fr).sx
    *ph = (*g).h * (*fr).sy
}

fn group_frame(fr: *mut pp_ctx.Frame, g: *mut Geo) -> pp_ctx.Frame {
    var kx: f64 = 1.0
    var ky: f64 = 1.0
    if (*g).cw > 0.0 { kx = (*g).w / (*g).cw }
    if (*g).ch > 0.0 { ky = (*g).h / (*g).ch }
    return pp_ctx.Frame { ox: (*fr).ox + (*fr).sx * ((*g).x - (*g).cx * kx), oy: (*fr).oy + (*fr).sy * ((*g).y - (*g).cy * ky),
        sx: (*fr).sx * kx, sy: (*fr).sy * ky }
}

fn ph_node(x: *mut xml.Doc, sp: u32) -> u32 {
    var nv: u32 = ooxml.child_l(x, sp, "nvSpPr")
    if nv == xml.NONE {
        nv = ooxml.child_l(x, sp, "nvPicPr")
    }
    if nv == xml.NONE {
        nv = ooxml.child_l(x, sp, "nvGraphicFramePr")
    }
    if nv == xml.NONE {
        return xml.NONE
    }
    return ooxml.child_l(x, ooxml.child_l(x, nv, "nvPr"), "ph")
}

fn norm_type(t: str) -> str {
    if t == "" || t == "obj" || t == "subTitle" || t == "tbl" || t == "chart" || t == "pic" || t == "media" || t == "clipArt" {
        return "body"
    }
    if t == "ctrTitle" {
        return "title"
    }
    return t
}

fn ph_kind(x: *mut xml.Doc, ph: u32) -> i32 {
    if ph == xml.NONE {
        return PH_NONE
    }
    let t: str = norm_type(ooxml.attr_l(x, ph, "type"))
    if t == "title" {
        return PH_TITLE
    }
    if t == "body" {
        return PH_BODY
    }
    return PH_OTHER
}

fn find_ph(x: *mut xml.Doc, tree: u32, ph: u32, px: *mut xml.Doc) -> u32 {
    if tree == xml.NONE || ph == xml.NONE {
        return xml.NONE
    }
    let want_t: str = norm_type(ooxml.attr_l(px, ph, "type"))
    let want_i: str = ooxml.attr_l(px, ph, "idx")
    var by_type: u32 = xml.NONE
    var s: u32 = ooxml.first_el(x, tree)
    while s != xml.NONE {
        let h: u32 = ph_node(x, s)
        if h != xml.NONE {
            if want_i.n > 0 && ooxml.attr_l(x, h, "idx") == want_i {
                return s
            }
            if by_type == xml.NONE && norm_type(ooxml.attr_l(x, h, "type")) == want_t {
                by_type = s
            }
        }
        s = ooxml.next_el(x, s)
    }
    return by_type
}

fn chain_attr(ch: *mut pp_ctx.Chain, name: str) -> str {
    var i: usize = 0
    while i < (*ch).count {
        let lk: pp_ctx.Link = (*ch).items[i]
        if ooxml.has_attr_l(lk.x, lk.n, name) {
            return ooxml.attr_l(lk.x, lk.n, name)
        }
        i = i + 1
    }
    return ""
}
