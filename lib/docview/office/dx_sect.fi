import std.xml
import std.vec
import docview.office.opc
import docview.office.ooxml
import docview.office.dx_model
import docview.office.dx_ctx

export { read_sectpr, inherit_sections }

fn clamp(v: i64, lo: i64, hi: i64) -> i32 {
    if v < lo { return lo as i32 }
    if v > hi { return hi as i32 }
    return v as i32
}

fn hf_index(c: *mut dx_ctx.Ctx, d: *mut dx_model.Docx, x: *mut xml.Doc, sp: u32, tag: str, typ: str) -> i32 {
    if (*c).rels == (0 as *mut opc.Rels) {
        return -1
    }
    var n: u32 = ooxml.child_l(x, sp, tag)
    while n != xml.NONE {
        var t: str = ooxml.attr_l(x, n, "type")
        if t.n == 0 {
            t = "default"
        }
        if t == typ {
            let i: i64 = opc.rels_find_id((*c).rels, ooxml.attr_l(x, n, "id"))
            if i >= 0 {
                return dx_model.new_hf(d, opc.rels_target((*c).rels, i as usize)) as i32
            }
        }
        n = ooxml.next_l(x, n, tag)
    }
    return -1
}

fn read_sectpr(c: *mut dx_ctx.Ctx, d: *mut dx_model.Docx, x: *mut xml.Doc, sp: u32, si: u32) {
    var w: i32 = 11906
    var h: i32 = 16838
    var ml: i32 = 1440
    var mr: i32 = 1440
    var mt: i32 = 1440
    var mb: i32 = 1440
    var hd: i32 = 708
    var fd: i32 = 708
    let sz: u32 = ooxml.child_l(x, sp, "pgSz")
    if sz != xml.NONE {
        w = clamp(ooxml.attr_i64(x, sz, "w", 11906), 1440, 31680)
        h = clamp(ooxml.attr_i64(x, sz, "h", 16838), 1440, 31680)
    }
    let mg: u32 = ooxml.child_l(x, sp, "pgMar")
    if mg != xml.NONE {
        ml = clamp(ooxml.attr_i64(x, mg, "left", 1440), 0, (w as i64) / 3)
        mr = clamp(ooxml.attr_i64(x, mg, "right", 1440), 0, (w as i64) / 3)
        mt = clamp(ooxml.attr_i64(x, mg, "top", 1440), 0, (h as i64) / 3)
        mb = clamp(ooxml.attr_i64(x, mg, "bottom", 1440), 0, (h as i64) / 3)
        hd = clamp(ooxml.attr_i64(x, mg, "header", 708), 0, (h as i64) / 3)
        fd = clamp(ooxml.attr_i64(x, mg, "footer", 708), 0, (h as i64) / 3)
    }
    let hdr_def: i32 = hf_index(c, d, x, sp, "headerReference", "default")
    let hdr_first: i32 = hf_index(c, d, x, sp, "headerReference", "first")
    let ftr_def: i32 = hf_index(c, d, x, sp, "footerReference", "default")
    let ftr_first: i32 = hf_index(c, d, x, sp, "footerReference", "first")
    var np: bool = true
    let ty: u32 = ooxml.child_l(x, sp, "type")
    if ty != xml.NONE && ooxml.attr_l(x, ty, "val") == "continuous" {
        np = false
    }
    let s: *mut dx_model.Sect = dx_model.sect_at(d, si)
    (*s).w = w
    (*s).h = h
    (*s).ml = ml
    (*s).mr = mr
    (*s).mt = mt
    (*s).mb = mb
    (*s).header_dist = hd
    (*s).footer_dist = fd
    (*s).hdr_default = hdr_def
    (*s).hdr_first = hdr_first
    (*s).ftr_default = ftr_def
    (*s).ftr_first = ftr_first
    (*s).title_pg = ooxml.child_l(x, sp, "titlePg") != xml.NONE
    (*s).new_page = np
}

fn inherit_sections(d: *mut dx_model.Docx) {
    var i: usize = 1
    let n: usize = vec_len_sects(d)
    while i < n {
        let prev: *mut dx_model.Sect = dx_model.sect_at(d, (i - 1) as u32)
        let cur: *mut dx_model.Sect = dx_model.sect_at(d, i as u32)
        if (*cur).hdr_default < 0 { (*cur).hdr_default = (*prev).hdr_default }
        if (*cur).hdr_first < 0 { (*cur).hdr_first = (*prev).hdr_first }
        if (*cur).ftr_default < 0 { (*cur).ftr_default = (*prev).ftr_default }
        if (*cur).ftr_first < 0 { (*cur).ftr_first = (*prev).ftr_first }
        i = i + 1
    }
}

fn vec_len_sects(d: *mut dx_model.Docx) -> usize {
    return vec_len[dx_model.Sect](&(*d).sects)
}
