import docview.office.dx_lay
import docview.office.dx_brk
import docview.office.dx_emit
import docview.office.dx_prim
import std.vec

export { para_break, para_emit }

fn para_break(l: *mut dx_lay.Lay, pi: u32, width: f64) -> f64 {
    dx_brk.break_lines(l, pi, width)
    return (*l).para_h
}

fn para_emit(l: *mut dx_lay.Lay, pi: u32, x0: f64, width: f64, from: usize, to: usize, oy: f64,
    sink: *mut Vec[dx_prim.Prim], hf: u32) {
    dx_emit.emit_lines(l, pi, x0, width, from, to, oy, sink, hf)
}
