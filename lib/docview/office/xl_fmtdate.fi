import std.rt
import docview.office.xl_digits
import docview.office.xl_date
import docview.office.xl_fmtscan

export { format_date }

fn byte(s: str, i: usize) -> u8 {
    return rt.ld8(s.p as u64, i)
}

fn run_len(s: str, i: usize) -> usize {
    let c: u8 = xl_fmtscan.lower(byte(s, i))
    var j: usize = i
    while j < s.n && xl_fmtscan.lower(byte(s, j)) == c {
        j = j + 1
    }
    return j - i
}

fn has_ampm(s: str) -> bool {
    var i: usize = 0
    while i < s.n {
        if xl_fmtscan.matches_at(s, i, "am/pm") || xl_fmtscan.matches_at(s, i, "a/p") {
            return true
        }
        i = i + 1
    }
    return false
}

fn next_letter(s: str, from: usize) -> u8 {
    var i: usize = from
    while i < s.n {
        let c: u8 = xl_fmtscan.lower(byte(s, i))
        if c >= (97 as u8) && c <= (122 as u8) {
            return c
        }
        i = i + 1
    }
    return 0 as u8
}

fn push_pad(out: *mut rt.Buf, v: i64, width: usize) {
    var m: i64 = v
    if m < 0 {
        m = 0
    }
    xl_digits.push_int(out, m as u64, false, width as i32)
}

fn elapsed(s: str, i: usize, v: f64, out: *mut rt.Buf) -> usize {
    var j: usize = i + 1
    let c: u8 = xl_fmtscan.lower(byte(s, j))
    var n: usize = 0
    while j < s.n && xl_fmtscan.lower(byte(s, j)) == c {
        n = n + 1
        j = j + 1
    }
    while j < s.n && byte(s, j) != (93 as u8) {
        j = j + 1
    }
    var unit: f64 = 24.0
    if c == (109 as u8) {
        unit = 1440.0
    } else if c == (115 as u8) {
        unit = 86400.0
    }
    let total: f64 = v * unit + 0.5
    var t: i64 = 0
    if total > 0.0 && total < 9.0e15 {
        t = total as i64
    }
    push_pad(out, t, n)
    return j + 1
}

fn format_date(s: str, v: f64, date1904: bool, out: *mut rt.Buf) {
    var dp: xl_date.DateParts = xl_date.DateParts { year: 0, month: 0, day: 0, wday: 0, hour: 0, minute: 0, second: 0, frac_ms: 0 }
    if !xl_date.split_serial(v, date1904, &dp) {
        xl_digits.push_str(out, "########")
        return
    }
    let ampm: bool = has_ampm(s)
    var prev: u8 = 0 as u8
    var i: usize = 0
    while i < s.n {
        var handled: bool = false
        if byte(s, i) == (91 as u8) && i + 1 < s.n {
            let n1: u8 = xl_fmtscan.lower(byte(s, i + 1))
            if n1 == (104 as u8) || n1 == (109 as u8) || n1 == (115 as u8) {
                i = elapsed(s, i, v, out)
                prev = n1
                handled = true
            }
        }
        var j: usize = i
        if !handled {
            j = xl_fmtscan.lit_item(s, i, out)
        }
        if handled {
        } else if j != i {
            i = j
        } else {
            let c: u8 = byte(s, i)
            let l: u8 = xl_fmtscan.lower(c)
            if false {
            } else if xl_fmtscan.matches_at(s, i, "am/pm") {
                if dp.hour >= 12 {
                    xl_digits.push_str(out, "PM")
                } else {
                    xl_digits.push_str(out, "AM")
                }
                i = i + 5
            } else if xl_fmtscan.matches_at(s, i, "a/p") {
                if dp.hour >= 12 {
                    rt.buf_push(out, 80 as u8)
                } else {
                    rt.buf_push(out, 65 as u8)
                }
                i = i + 3
            } else if l == (121 as u8) {
                let n: usize = run_len(s, i)
                if n >= 3 {
                    push_pad(out, dp.year, 4)
                } else {
                    push_pad(out, dp.year % 100, 2)
                }
                i = i + n
                prev = l
            } else if l == (109 as u8) {
                let n2: usize = run_len(s, i)
                let minute: bool = prev == (104 as u8) || next_letter(s, i + n2) == (115 as u8)
                if minute {
                    push_pad(out, dp.minute, n2)
                } else if n2 >= 5 {
                    xl_digits.push_str(out, xl_date.month_name(dp.month, true))
                } else if n2 == 4 {
                    xl_digits.push_str(out, xl_date.month_name(dp.month, true))
                } else if n2 == 3 {
                    xl_digits.push_str(out, xl_date.month_name(dp.month, false))
                } else {
                    push_pad(out, dp.month, n2)
                }
                i = i + n2
                prev = l
            } else if l == (100 as u8) {
                let n3: usize = run_len(s, i)
                if n3 >= 4 {
                    xl_digits.push_str(out, xl_date.day_name(dp.wday, true))
                } else if n3 == 3 {
                    xl_digits.push_str(out, xl_date.day_name(dp.wday, false))
                } else {
                    push_pad(out, dp.day, n3)
                }
                i = i + n3
                prev = l
            } else if l == (104 as u8) {
                let n4: usize = run_len(s, i)
                var h: i64 = dp.hour
                if ampm {
                    h = h % 12
                    if h == 0 {
                        h = 12
                    }
                }
                push_pad(out, h, n4)
                i = i + n4
                prev = l
            } else if l == (115 as u8) {
                let n5: usize = run_len(s, i)
                push_pad(out, dp.second, n5)
                i = i + n5
                prev = l
            } else {
                rt.buf_push(out, c)
                i = i + 1
            }
        }
    }
}
