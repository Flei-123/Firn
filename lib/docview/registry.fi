import std.rt
import std.vec

export {
    OpenFn, PagesFn, SizeFn, RenderFn, TextFn, FreeFn, DocOps, Opener,
    ops_empty, register, unregister, find_by_kind, find_by_name, opener_count, opener_at,
    registry_reset, has_kind,
}

type OpenFn = fn(u64, usize) -> u64
type PagesFn = fn(u64) -> usize
type SizeFn = fn(u64, usize, *mut i32, *mut i32) -> bool
type RenderFn = fn(u64, usize, f64, *mut rt.Buf, *mut i32, *mut i32) -> bool
type TextFn = fn(u64, usize, *mut rt.Buf) -> bool
type FreeFn = fn(u64)

struct DocOps {
    open: OpenFn,
    pages: PagesFn,
    page_size: SizeFn,
    render: RenderFn,
    text: TextFn,
    free: FreeFn,
}

struct Opener {
    name: str,
    kind: u32,
    ops: DocOps,
}

static mut openers: Vec[Opener] = Vec[Opener] { ptr: 0, len: 0, cap: 0 }

fn stub_open(p: u64, n: usize) -> u64 {
    return 0
}

fn stub_pages(h: u64) -> usize {
    return 0
}

fn stub_size(h: u64, page: usize, w: *mut i32, hh: *mut i32) -> bool {
    return false
}

fn stub_render(h: u64, page: usize, scale: f64, out: *mut rt.Buf, w: *mut i32, hh: *mut i32) -> bool {
    return false
}

fn stub_text(h: u64, page: usize, out: *mut rt.Buf) -> bool {
    return false
}

fn stub_free(h: u64) {
}

fn ops_empty() -> DocOps {
    return DocOps { open: stub_open, pages: stub_pages, page_size: stub_size,
        render: stub_render, text: stub_text, free: stub_free }
}

fn same_name(a: str, b: str) -> bool {
    if a.n != b.n {
        return false
    }
    return rt.mem_eq(a.p as u64, b.p as u64, a.n)
}

fn index_of(name: str) -> i64 {
    var i: usize = 0
    while i < vec_len[Opener](&openers) {
        let o: *mut Opener = vec_elem_ptr[Opener](&openers, i)
        if same_name((*o).name, name) {
            return i as i64
        }
        i++
    }
    return -1
}

fn register(name: str, kind: u32, ops: DocOps) -> bool {
    let at: i64 = index_of(name)
    let entry: Opener = Opener { name: name, kind: kind, ops: ops }
    if at >= 0 {
        return vec_set[Opener](&openers, at as usize, entry)
    }
    return vec_push[Opener](&openers, entry)
}

fn unregister(name: str) -> bool {
    let at: i64 = index_of(name)
    if at < 0 {
        return false
    }
    let last: usize = vec_len[Opener](&openers) - 1
    if at as usize != last {
        let moved: Opener = *vec_elem_ptr[Opener](&openers, last)
        vec_set[Opener](&openers, at as usize, moved)
    }
    vec_shorten[Opener](&openers, last)
    return true
}

fn find_by_kind(kind: u32) -> *mut Opener {
    var i: usize = vec_len[Opener](&openers)
    while i > 0 {
        i--
        let o: *mut Opener = vec_elem_ptr[Opener](&openers, i)
        if (*o).kind == kind {
            return o
        }
    }
    return 0 as *mut Opener
}

fn find_by_name(name: str) -> *mut Opener {
    let at: i64 = index_of(name)
    if at < 0 {
        return 0 as *mut Opener
    }
    return vec_elem_ptr[Opener](&openers, at as usize)
}

fn has_kind(kind: u32) -> bool {
    return (find_by_kind(kind) as u64) != 0
}

fn opener_count() -> usize {
    return vec_len[Opener](&openers)
}

fn opener_at(i: usize) -> *mut Opener {
    if i >= vec_len[Opener](&openers) {
        return 0 as *mut Opener
    }
    return vec_elem_ptr[Opener](&openers, i)
}

fn registry_reset() {
    vec_clear[Opener](&openers)
}
