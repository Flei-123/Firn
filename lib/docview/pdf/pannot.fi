// SPDX-License-Identifier: MPL-2.0
// PDF annotations: links, highlights, ink, stamps and their appearance data.
import html.mem
import rt.rt
import docview.pdf.pobj
import docview.pdf.pdoc

export {
    Annot, AnnotList,
    an_load, an_free, an_count, an_at,
    an_subtype, an_rect, an_flags, an_obj, an_ap,
    an_color, an_quad_count, an_quad_at, an_ink_count, an_ink_at,
    an_contents, an_author, an_border_width, an_opacity,
    an_visible,
    ST_UNKNOWN, ST_WIDGET, ST_HIGHLIGHT, ST_TEXT, ST_LINK,
    ST_SQUARE, ST_CIRCLE, ST_FREETEXT, ST_INK, ST_UNDERLINE,
    ST_STRIKEOUT, ST_SQUIGGLY, ST_STAMP, ST_POPUP,
    F_HIDDEN, F_PRINT, F_NOVIEW,
    R_LLX, R_LLY, R_URX, R_URY,
    MAX_ANNOTS,
}

const ST_UNKNOWN: u32 = 0
const ST_WIDGET: u32 = 1
const ST_HIGHLIGHT: u32 = 2
const ST_TEXT: u32 = 3
const ST_LINK: u32 = 4
const ST_SQUARE: u32 = 5
const ST_CIRCLE: u32 = 6
const ST_FREETEXT: u32 = 7
const ST_INK: u32 = 8
const ST_UNDERLINE: u32 = 9
const ST_STRIKEOUT: u32 = 10
const ST_SQUIGGLY: u32 = 11
const ST_STAMP: u32 = 12
const ST_POPUP: u32 = 13

const F_HIDDEN: u32 = 2
const F_PRINT: u32 = 4
const F_NOVIEW: u32 = 32

const R_LLX: usize = 0
const R_LLY: usize = 1
const R_URX: usize = 2
const R_URY: usize = 3

const MAX_ANNOTS: usize = 4096
const MAX_CHAIN: usize = 64

#[no_gc]
fn sz_annot() -> usize {
    var probe: [Annot; 2] = [Annot {
        obj: 0, num: 0, subtype: 0, flags: 0,
        rect: [0.0; 4], ap: 0, col: [0.0; 4], ic: [0.0; 4],
        quads: 0, inks: 0, contents: 0, autor: 0, bw: 0.0, ca: 0.0 }; 2]
    return ((&probe[1]) as u64 - (&probe[0]) as u64) as usize
}

#[no_gc]
fn sz_list() -> usize {
    var probe: [AnnotList; 2] = [AnnotList {
        d: 0 as *mut pdoc.Doc, a: 0 as *mut Annot, n: 0, cap: 0 }; 2]
    return ((&probe[1]) as u64 - (&probe[0]) as u64) as usize
}

struct Annot {
    obj: u32,
    num: u32,
    subtype: u32,
    flags: u32,
    rect: [f64; 4],
    ap: u32,
    col: [f64; 4],
    ic: [f64; 4],
    quads: u32,
    inks: u32,
    contents: u32,
    autor: u32,
    bw: f64,
    ca: f64,
}

struct AnnotList {
    d: *mut pdoc.Doc,
    a: *mut Annot,
    n: usize,
    cap: usize,
}

#[no_gc]
fn ld8(p: u64, i: usize) -> u8 {
    return *((p + i as u64) as *mut u8)
}

#[no_gc]
fn subtype_von(ar: *mut pobj.Arena, h: u32) -> u32 {
    var n1: [u8; 6] = "Widget"
    if pobj.o_name_eq(ar, h, (&n1[0]) as u64, 6) {
        return ST_WIDGET
    }
    var n2: [u8; 9] = "Highlight"
    if pobj.o_name_eq(ar, h, (&n2[0]) as u64, 9) {
        return ST_HIGHLIGHT
    }
    var n3: [u8; 4] = "Text"
    if pobj.o_name_eq(ar, h, (&n3[0]) as u64, 4) {
        return ST_TEXT
    }
    var n4: [u8; 4] = "Link"
    if pobj.o_name_eq(ar, h, (&n4[0]) as u64, 4) {
        return ST_LINK
    }
    var n5: [u8; 6] = "Square"
    if pobj.o_name_eq(ar, h, (&n5[0]) as u64, 6) {
        return ST_SQUARE
    }
    var n6: [u8; 6] = "Circle"
    if pobj.o_name_eq(ar, h, (&n6[0]) as u64, 6) {
        return ST_CIRCLE
    }
    var n7: [u8; 8] = "FreeText"
    if pobj.o_name_eq(ar, h, (&n7[0]) as u64, 8) {
        return ST_FREETEXT
    }
    var n8: [u8; 3] = "Ink"
    if pobj.o_name_eq(ar, h, (&n8[0]) as u64, 3) {
        return ST_INK
    }
    var n9: [u8; 9] = "Underline"
    if pobj.o_name_eq(ar, h, (&n9[0]) as u64, 9) {
        return ST_UNDERLINE
    }
    var n10: [u8; 9] = "StrikeOut"
    if pobj.o_name_eq(ar, h, (&n10[0]) as u64, 9) {
        return ST_STRIKEOUT
    }
    var n11: [u8; 8] = "Squiggly"
    if pobj.o_name_eq(ar, h, (&n11[0]) as u64, 8) {
        return ST_SQUIGGLY
    }
    var n12: [u8; 5] = "Stamp"
    if pobj.o_name_eq(ar, h, (&n12[0]) as u64, 5) {
        return ST_STAMP
    }
    var n13: [u8; 5] = "Popup"
    if pobj.o_name_eq(ar, h, (&n13[0]) as u64, 5) {
        return ST_POPUP
    }
    return ST_UNKNOWN
}

fn ap_waehlen(d: *mut pdoc.Doc, an: u32) -> u32 {
    let ar: *mut pobj.Arena = &(*d).ar
    var apn: [u8; 2] = "AP"
    let ap: u32 = pdoc.doc_dict_get(d, an, (&apn[0]) as u64, 2)
    if ap == 0 as u32 {
        return 0 as u32
    }
    var nn: [u8; 1] = "N"
    var n: u32 = pdoc.doc_dict_get(d, ap, (&nn[0]) as u64, 1)
    if n == 0 as u32 {
        return 0 as u32
    }
    if pobj.o_kind(ar, n) == pobj.T_STREAM {
        return n
    }
    if pobj.o_kind(ar, n) != pobj.T_DICT {
        return 0 as u32
    }
    var asn: [u8; 2] = "AS"
    let as_h: u32 = pdoc.doc_dict_get(d, an, (&asn[0]) as u64, 2)
    if as_h != 0 as u32 && pobj.o_kind(ar, as_h) == pobj.T_NAME {
        let p: u64 = pobj.o_str_ptr(ar, as_h)
        let ln: usize = pobj.o_str_len(ar, as_h)
        let got: u32 = pdoc.doc_dict_get(d, n, p, ln)
        if got != 0 as u32 && pobj.o_kind(ar, got) == pobj.T_STREAM {
            return got
        }
        return 0 as u32
    }
    if pobj.o_dict_len(ar, n) == 1 {
        let only: u32 = pdoc.doc_resolve(d, pobj.o_dict_val(ar, n, 0))
        if pobj.o_kind(ar, only) == pobj.T_STREAM {
            return only
        }
    }
    return 0 as u32
}

fn rect_read(d: *mut pdoc.Doc, h: u32, out: *mut f64) -> bool {
    let ar: *mut pobj.Arena = &(*d).ar
    if pobj.o_kind(ar, h) != pobj.T_ARR || pobj.o_arr_len(ar, h) < 4 {
        return false
    }
    var i: usize = 0
    while i < 4 {
        let e: u32 = pdoc.doc_resolve(d, pobj.o_arr_at(ar, h, i))
        if !pobj.o_is_num(ar, e) {
            return false
        }
        *((out as u64 + (i * 8) as u64) as *mut f64) = pobj.o_num(ar, e)
        i = i + 1
    }
    let x0: f64 = *((out as u64) as *mut f64)
    let y0: f64 = *((out as u64 + 8) as *mut f64)
    let x1: f64 = *((out as u64 + 16) as *mut f64)
    let y1: f64 = *((out as u64 + 24) as *mut f64)
    if x0 > x1 {
        *((out as u64) as *mut f64) = x1
        *((out as u64 + 16) as *mut f64) = x0
    }
    if y0 > y1 {
        *((out as u64 + 8) as *mut f64) = y1
        *((out as u64 + 24) as *mut f64) = y0
    }
    return true
}

fn color_read(d: *mut pdoc.Doc, h: u32, out: *mut f64) -> bool {
    let ar: *mut pobj.Arena = &(*d).ar
    *((out as u64 + 24) as *mut f64) = 0.0
    if pobj.o_kind(ar, h) != pobj.T_ARR {
        return false
    }
    var cnt: usize = pobj.o_arr_len(ar, h)
    if cnt > 4 {
        cnt = 4
    }
    var i: usize = 0
    while i < cnt {
        let e: u32 = pdoc.doc_resolve(d, pobj.o_arr_at(ar, h, i))
        var v: f64 = 0.0
        if pobj.o_is_num(ar, e) {
            v = pobj.o_num(ar, e)
        }
        if v < 0.0 {
            v = 0.0
        }
        if v > 1.0 {
            v = 1.0
        }
        *((out as u64 + (i * 8) as u64) as *mut f64) = v
        i = i + 1
    }
    *((out as u64 + 24) as *mut f64) = cnt as f64
    return cnt > 0
}

fn width_read(d: *mut pdoc.Doc, an: u32) -> f64 {
    let ar: *mut pobj.Arena = &(*d).ar
    var bsn: [u8; 2] = "BS"
    let bs: u32 = pdoc.doc_dict_get(d, an, (&bsn[0]) as u64, 2)
    if bs != 0 as u32 && pobj.o_kind(ar, bs) == pobj.T_DICT {
        var wn: [u8; 1] = "W"
        let w: u32 = pdoc.doc_dict_get(d, bs, (&wn[0]) as u64, 1)
        if pobj.o_is_num(ar, w) {
            let v: f64 = pobj.o_num(ar, w)
            if v >= 0.0 {
                return v
            }
        }
    }
    var bn: [u8; 6] = "Border"
    let b: u32 = pdoc.doc_dict_get(d, an, (&bn[0]) as u64, 6)
    if b != 0 as u32 && pobj.o_kind(ar, b) == pobj.T_ARR &&
        pobj.o_arr_len(ar, b) >= 3 {
        let w: u32 = pdoc.doc_resolve(d, pobj.o_arr_at(ar, b, 2))
        if pobj.o_is_num(ar, w) {
            let v: f64 = pobj.o_num(ar, w)
            if v >= 0.0 {
                return v
            }
        }
    }
    return 1.0
}

#[no_gc]
fn grow(l: *mut AnnotList, br: usize) -> bool {
    if (*l).n + br <= (*l).cap {
        return true
    }
    var neu: usize = (*l).cap * 2
    if neu < 16 {
        neu = 16
    }
    while neu < (*l).n + br {
        neu = neu * 2
    }
    if neu > MAX_ANNOTS {
        neu = MAX_ANNOTS
    }
    if (*l).n + br > neu {
        return false
    }
    let gr: usize = neu * sz_annot()
    let np: *mut u8 = mem.heap_alloc(gr)
    if np as u64 == 0 {
        return false
    }
    if (*l).a as u64 != 0 {
        mem.mem_copy(np, (*l).a as *mut u8, (*l).n * sz_annot())
        mem.heap_free((*l).a as *mut u8, (*l).cap * sz_annot())
    }
    (*l).a = np as *mut Annot
    (*l).cap = neu
    return true
}

fn a_read(l: *mut AnnotList, roh: u32) -> bool {
    let d: *mut pdoc.Doc = (*l).d
    let ar: *mut pobj.Arena = &(*d).ar
    var num: u32 = 0
    var h: u32 = roh
    if pobj.o_kind(ar, h) == pobj.T_REF {
        num = pobj.o_int(ar, h) as u32
        h = pdoc.doc_resolve(d, h)
    }
    if h == 0 as u32 || pobj.o_kind(ar, h) != pobj.T_DICT {
        return false
    }
    if !grow(l, 1) {
        return false
    }
    let a: *mut Annot = ((*l).a as u64 + ((*l).n * sz_annot()) as u64) as *mut Annot
    (*a).obj = h
    (*a).num = num
    var stn: [u8; 7] = "Subtype"
    let st: u32 = pdoc.doc_dict_get(d, h, (&stn[0]) as u64, 7)
    (*a).subtype = subtype_von(ar, st)
    var fln: [u8; 1] = "F"
    (*a).flags = pdoc.doc_int(d, h, (&fln[0]) as u64, 1, 0) as u32
    var rn: [u8; 4] = "Rect"
    let rh: u32 = pdoc.doc_dict_get(d, h, (&rn[0]) as u64, 4)
    if !rect_read(d, rh, &((*a).rect[0])) {
        (*a).rect[0] = 0.0
        (*a).rect[1] = 0.0
        (*a).rect[2] = 0.0
        (*a).rect[3] = 0.0
    }
    (*a).ap = ap_waehlen(d, h)
    var cn: [u8; 1] = "C"
    color_read(d, pdoc.doc_dict_get(d, h, (&cn[0]) as u64, 1), &((*a).col[0]))
    var icn: [u8; 2] = "IC"
    color_read(d, pdoc.doc_dict_get(d, h, (&icn[0]) as u64, 2), &((*a).ic[0]))
    var qn: [u8; 10] = "QuadPoints"
    (*a).quads = pdoc.doc_dict_get(d, h, (&qn[0]) as u64, 10)
    if pobj.o_kind(ar, (*a).quads) != pobj.T_ARR {
        (*a).quads = 0 as u32
    }
    var iln: [u8; 7] = "InkList"
    (*a).inks = pdoc.doc_dict_get(d, h, (&iln[0]) as u64, 7)
    if pobj.o_kind(ar, (*a).inks) != pobj.T_ARR {
        (*a).inks = 0 as u32
    }
    var con: [u8; 8] = "Contents"
    (*a).contents = pdoc.doc_dict_get(d, h, (&con[0]) as u64, 8)
    if pobj.o_kind(ar, (*a).contents) != pobj.T_STR {
        (*a).contents = 0 as u32
    }
    var tn: [u8; 1] = "T"
    (*a).autor = pdoc.doc_dict_get(d, h, (&tn[0]) as u64, 1)
    if pobj.o_kind(ar, (*a).autor) != pobj.T_STR {
        (*a).autor = 0 as u32
    }
    (*a).bw = width_read(d, h)
    var can: [u8; 2] = "CA"
    (*a).ca = pdoc.doc_num(d, h, (&can[0]) as u64, 2, 1.0)
    if (*a).ca < 0.0 {
        (*a).ca = 0.0
    }
    if (*a).ca > 1.0 {
        (*a).ca = 1.0
    }
    (*l).n = (*l).n + 1
    return true
}

fn an_load(d: *mut pdoc.Doc, pg: usize) -> *mut AnnotList {
    let l: *mut AnnotList = mem.heap_alloc(sz_list()) as *mut AnnotList
    if l as u64 == 0 {
        return 0 as *mut AnnotList
    }
    (*l).d = d
    (*l).a = 0 as *mut Annot
    (*l).n = 0
    (*l).cap = 0
    let page: u32 = pdoc.doc_page(d, pg)
    if page == 0 as u32 {
        return l
    }
    let ar: *mut pobj.Arena = &(*d).ar
    var an: [u8; 6] = "Annots"
    let arr: u32 = pdoc.doc_dict_get(d, page, (&an[0]) as u64, 6)
    if arr == 0 as u32 || pobj.o_kind(ar, arr) != pobj.T_ARR {
        return l
    }
    var cnt: usize = pobj.o_arr_len(ar, arr)
    if cnt > MAX_ANNOTS {
        cnt = MAX_ANNOTS
    }
    var i: usize = 0
    while i < cnt {
        a_read(l, pobj.o_arr_at(ar, arr, i))
        i = i + 1
    }
    return l
}

fn an_free(l: *mut AnnotList) {
    if l as u64 == 0 {
        return
    }
    if (*l).a as u64 != 0 {
        mem.heap_free((*l).a as *mut u8, (*l).cap * sz_annot())
    }
    mem.heap_free(l as *mut u8, sz_list())
}

#[no_gc]
fn an_count(l: *mut AnnotList) -> usize {
    if l as u64 == 0 {
        return 0
    }
    return (*l).n
}

#[no_gc]
fn an_at(l: *mut AnnotList, i: usize) -> *mut Annot {
    if l as u64 == 0 || i >= (*l).n {
        return 0 as *mut Annot
    }
    return ((*l).a as u64 + (i * sz_annot()) as u64) as *mut Annot
}

#[no_gc]
fn an_subtype(a: *mut Annot) -> u32 {
    if a as u64 == 0 {
        return ST_UNKNOWN
    }
    return (*a).subtype
}

#[no_gc]
fn an_flags(a: *mut Annot) -> u32 {
    if a as u64 == 0 {
        return 0
    }
    return (*a).flags
}

#[no_gc]
fn an_obj(a: *mut Annot) -> u32 {
    if a as u64 == 0 {
        return 0 as u32
    }
    return (*a).obj
}

#[no_gc]
fn an_ap(a: *mut Annot) -> u32 {
    if a as u64 == 0 {
        return 0 as u32
    }
    return (*a).ap
}

#[no_gc]
fn an_rect(a: *mut Annot, i: usize) -> f64 {
    if a as u64 == 0 || i > 3 {
        return 0.0
    }
    return (*a).rect[i]
}

#[no_gc]
fn an_color(a: *mut Annot, art: u32, i: usize) -> f64 {
    if a as u64 == 0 || i > 3 {
        return 0.0
    }
    if art == 1 {
        return (*a).ic[i]
    }
    return (*a).col[i]
}

#[no_gc]
fn an_border_width(a: *mut Annot) -> f64 {
    if a as u64 == 0 {
        return 1.0
    }
    return (*a).bw
}

#[no_gc]
fn an_opacity(a: *mut Annot) -> f64 {
    if a as u64 == 0 {
        return 1.0
    }
    return (*a).ca
}

#[no_gc]
fn an_contents(a: *mut Annot) -> u32 {
    if a as u64 == 0 {
        return 0 as u32
    }
    return (*a).contents
}

#[no_gc]
fn an_author(a: *mut Annot) -> u32 {
    if a as u64 == 0 {
        return 0 as u32
    }
    return (*a).autor
}

fn an_quad_count(l: *mut AnnotList, a: *mut Annot) -> usize {
    if l as u64 == 0 || a as u64 == 0 || (*a).quads == 0 as u32 {
        return 0
    }
    return pobj.o_arr_len(&(*(*l).d).ar, (*a).quads) / 8
}

fn an_quad_at(l: *mut AnnotList, a: *mut Annot, q: usize, i: usize) -> f64 {
    if l as u64 == 0 || a as u64 == 0 || (*a).quads == 0 as u32 || i > 7 {
        return 0.0
    }
    let d: *mut pdoc.Doc = (*l).d
    let ar: *mut pobj.Arena = &(*d).ar
    let idx: usize = q * 8 + i
    if idx >= pobj.o_arr_len(ar, (*a).quads) {
        return 0.0
    }
    let e: u32 = pdoc.doc_resolve(d, pobj.o_arr_at(ar, (*a).quads, idx))
    if !pobj.o_is_num(ar, e) {
        return 0.0
    }
    return pobj.o_num(ar, e)
}

fn an_ink_count(l: *mut AnnotList, a: *mut Annot) -> usize {
    if l as u64 == 0 || a as u64 == 0 || (*a).inks == 0 as u32 {
        return 0
    }
    return pobj.o_arr_len(&(*(*l).d).ar, (*a).inks)
}

fn an_ink_at(l: *mut AnnotList, a: *mut Annot, s: usize, pt: usize,
             xy: usize) -> f64 {
    if l as u64 == 0 || a as u64 == 0 || (*a).inks == 0 as u32 {
        return 0.0 - 1.0e300
    }
    let d: *mut pdoc.Doc = (*l).d
    let ar: *mut pobj.Arena = &(*d).ar
    if s >= pobj.o_arr_len(ar, (*a).inks) {
        return 0.0 - 1.0e300
    }
    let str_h: u32 = pdoc.doc_resolve(d, pobj.o_arr_at(ar, (*a).inks, s))
    if pobj.o_kind(ar, str_h) != pobj.T_ARR {
        return 0.0 - 1.0e300
    }
    let idx: usize = pt * 2 + xy
    if idx >= pobj.o_arr_len(ar, str_h) {
        return 0.0 - 1.0e300
    }
    let e: u32 = pdoc.doc_resolve(d, pobj.o_arr_at(ar, str_h, idx))
    if !pobj.o_is_num(ar, e) {
        return 0.0 - 1.0e300
    }
    return pobj.o_num(ar, e)
}

#[no_gc]
fn an_visible(a: *mut Annot) -> bool {
    if a as u64 == 0 {
        return false
    }
    if (*a).subtype == ST_POPUP {
        return false
    }
    if ((*a).flags & F_HIDDEN) != 0 {
        return false
    }
    if ((*a).flags & F_NOVIEW) != 0 {
        return false
    }
    if (*a).rect[2] - (*a).rect[0] <= 0.0 {
        return false
    }
    if (*a).rect[3] - (*a).rect[1] <= 0.0 {
        return false
    }
    return true
}
