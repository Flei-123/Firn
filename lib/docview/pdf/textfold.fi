// SPDX-License-Identifier: MPL-2.0
// case folding and substring search over UTF-8 text for PDF search.
import html.mem

export { fold_cp, utf8_next, find_all }

fn fold_cp(u: u32) -> u32 {
    if u == 9 || u == 10 || u == 13 || u == 160 {
        return 32
    }
    if u >= 65 && u <= 90 {
        return u + 32
    }
    if u < 192 {
        return u
    }
    if u >= 192 && u <= 222 && u != 215 {
        return u + 32
    }
    if u >= 256 && u <= 311 {
        if (u & 1) == 0 {
            return u + 1
        }
        return u
    }
    if u >= 313 && u <= 328 {
        if (u & 1) == 1 {
            return u + 1
        }
        return u
    }
    if u >= 330 && u <= 375 {
        if (u & 1) == 0 {
            return u + 1
        }
        return u
    }
    if u >= 913 && u <= 937 && u != 930 {
        return u + 32
    }
    if u >= 1040 && u <= 1071 {
        return u + 32
    }
    if u >= 1024 && u <= 1039 {
        return u + 80
    }
    return u
}

fn utf8_next(p: *mut u8, n: usize, at: usize, len: *mut usize) -> u32 {
    let c: u32 = (*((p as u64 + at as u64) as *mut u8)) as u32
    *len = 1
    if c >= 240 && at + 3 < n {
        *len = 4
        return ((c & 7) << 18) | ((((*((p as u64 + (at + 1) as u64) as *mut u8)) as u32) & 63) << 12) |
        ((((*((p as u64 + (at + 2) as u64) as *mut u8)) as u32) & 63) << 6) |
        (((*((p as u64 + (at + 3) as u64) as *mut u8)) as u32) & 63)
    }
    if c >= 224 && at + 2 < n {
        *len = 3
        return ((c & 15) << 12) | ((((*((p as u64 + (at + 1) as u64) as *mut u8)) as u32) & 63) << 6) |
        (((*((p as u64 + (at + 2) as u64) as *mut u8)) as u32) & 63)
    }
    if c >= 192 && at + 1 < n {
        *len = 2
        return ((c & 31) << 6) | (((*((p as u64 + (at + 1) as u64) as *mut u8)) as u32) & 63)
    }
    return c
}

fn decode_folded(p: *mut u8, n: usize, out: *mut mem.Buf) {
    var at: usize = 0
    while at < n {
        var len: usize = 1
        let u: u32 = utf8_next(p, n, at, &len)
        let f: u32 = fold_cp(u)
        mem.buf_push(out, (f & 255) as u8)
        mem.buf_push(out, ((f >> 8) & 255) as u8)
        mem.buf_push(out, ((f >> 16) & 255) as u8)
        mem.buf_push(out, ((f >> 24) & 255) as u8)
        at = at + len
    }
}

fn cp_at(b: *mut mem.Buf, i: usize) -> u32 {
    let p: u64 = mem.buf_ptr(b) as u64 + (i * 4) as u64
    return (*(p as *mut u8)) as u32 | (((*((p + 1) as *mut u8)) as u32) << 8) |
    (((*((p + 2) as *mut u8)) as u32) << 16) | (((*((p + 3) as *mut u8)) as u32) << 24)
}

fn find_all(text: *mut u8, tn: usize, query: *mut u8, qn: usize, out: *mut mem.Buf) -> usize {
    var t: mem.Buf = mem.buf_new()
    var q: mem.Buf = mem.buf_new()
    mem.buf_init(&t)
    mem.buf_init(&q)
    decode_folded(text, tn, &t)
    decode_folded(query, qn, &q)
    let tc: usize = mem.buf_len(&t) / 4
    let qc: usize = mem.buf_len(&q) / 4
    var found: usize = 0
    if qc > 0 && tc >= qc {
        var i: usize = 0
        while i + qc <= tc {
            var k: usize = 0
            while k < qc && cp_at(&t, i + k) == cp_at(&q, k) {
                k = k + 1
            }
            if k == qc {
                mem.buf_push(out, (i & 255) as u8)
                mem.buf_push(out, ((i >> 8) & 255) as u8)
                mem.buf_push(out, ((i >> 16) & 255) as u8)
                mem.buf_push(out, ((i >> 24) & 255) as u8)
                found = found + 1
                i = i + qc
            } else {
                i = i + 1
            }
        }
    }
    mem.buf_free(&t)
    mem.buf_free(&q)
    return found
}
