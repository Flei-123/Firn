// SPDX-License-Identifier: MPL-2.0
import std.rt
import html.mem
import docview.obj
import docview.registry
import docview.kinds
import docview.lazy
import docview.pdf.pdf

export { pdf_ops, pdf_install, pdf_install_lazy }

fn pdf_doc_open(p: u64, n: usize) -> u64 {
    let raw: u64 = obj.obj_alloc[pdf.Pdf]()
    if raw == 0 {
        return 0
    }
    let d: *mut pdf.Pdf = raw as *mut pdf.Pdf
    *d = pdf.pdf_new()
    if !pdf.pdf_open(d, p, n) {
        pdf.pdf_free(d)
        obj.obj_free[pdf.Pdf](raw)
        return 0
    }
    return raw
}

fn pdf_doc_pages(h: u64) -> usize {
    return pdf.pdf_pages(h as *mut pdf.Pdf)
}

fn round_side(v: f64) -> i32 {
    var s: f64 = v + 0.5
    if s < 1.0 {
        s = 1.0
    }
    return s as i32
}

fn pdf_doc_size(h: u64, page: usize, w: *mut i32, hh: *mut i32) -> bool {
    var fw: f64 = 0.0
    var fh: f64 = 0.0
    if !pdf.pdf_page_size(h as *mut pdf.Pdf, page, &fw, &fh) {
        return false
    }
    *w = round_side(fw)
    *hh = round_side(fh)
    return true
}

fn pdf_doc_render(h: u64, page: usize, scale: f64, out: *mut rt.Buf, w: *mut i32, hh: *mut i32) -> bool {
    let d: *mut pdf.Pdf = h as *mut pdf.Pdf
    if !pdf.pdf_render(d, page, scale) {
        return false
    }
    let pw: usize = pdf.pdf_pixel_width(d)
    let ph: usize = pdf.pdf_pixel_height(d)
    rt.buf_push_bytes(out, pdf.pdf_pixels(d), pw * ph * 4)
    *w = pw as i32
    *hh = ph as i32
    return true
}

fn pdf_doc_text(h: u64, page: usize, out: *mut rt.Buf) -> bool {
    var t: mem.Buf = mem.buf_new()
    if !pdf.pdf_text(h as *mut pdf.Pdf, page, &t) {
        mem.buf_free(&t)
        return false
    }
    rt.buf_push_bytes(out, mem.buf_ptr(&t) as u64, mem.buf_len(&t))
    mem.buf_free(&t)
    return true
}

fn pdf_doc_free(h: u64) {
    let d: *mut pdf.Pdf = h as *mut pdf.Pdf
    pdf.pdf_free(d)
    obj.obj_free[pdf.Pdf](h)
}

fn pdf_ops() -> registry.DocOps {
    var o: registry.DocOps = registry.ops_empty()
    o.open = pdf_doc_open
    o.pages = pdf_doc_pages
    o.page_size = pdf_doc_size
    o.render = pdf_doc_render
    o.text = pdf_doc_text
    o.free = pdf_doc_free
    return o
}

fn pdf_install() {
    registry.register("pdf.native", kinds.KIND_PDF, pdf_ops())
}

fn pdf_install_lazy() {
    lazy.lazy_register("pdf.native", kinds.KIND_PDF, pdf_install)
}
