// SPDX-License-Identifier: MPL-2.0
// PDF axial and radial shadings: colour table from the shading function and per-pixel painting through a coverage mask.
import html.mem
import std.math
import paint.canvas
import docview.pdf.pobj
import docview.pdf.pdoc
import docview.pdf.pfunc
import docview.pdf.prast
import docview.pdf.pmesh

export {
    Shade, SH_LUT,
    sh_new, sh_load, sh_free, sh_invert, sh_paint, sh_paint_mesh,
}

const SH_LUT: usize = 257
const SH_MAXC: usize = 8

struct Shade {
    stype: u32,
    c: [f64; 6],
    t0: f64,
    t1: f64,
    ext0: bool,
    ext1: bool,
    nc: usize,
    lutc: *mut f64,
    hasbox: bool,
    box_: [f64; 4],
    mesh: pmesh.Mesh,
    hasfn: bool,
}

fn sh_new() -> Shade {
    return Shade { stype: 0, c: [0.0; 6], t0: 0.0, t1: 1.0, ext0: false,
        ext1: false, nc: 0, lutc: 0 as *mut f64, hasbox: false,
        box_: [0.0; 4], mesh: pmesh.mesh_new(), hasfn: false }
}

fn sh_free(s: *mut Shade) {
    pmesh.mesh_free(&(*s).mesh)
    if (*s).lutc as usize != 0 {
        mem.heap_free((*s).lutc as *mut u8, SH_LUT * (*s).nc * 8)
        (*s).lutc = 0 as *mut f64
    }
}

fn sh_load(d: *mut pdoc.Doc, sh: u32, s: *mut Shade, ncs: usize) -> bool {
    let ar: *mut pobj.PdfArena = &(*d).ar
    if pobj.o_kind(ar, sh) != pobj.T_DICT && pobj.o_kind(ar, sh) != pobj.T_STREAM {
        return false
    }
    var nst: [u8; 11] = "ShadingType"
    var ncd: [u8; 6] = "Coords"
    var ndm: [u8; 6] = "Domain"
    var nex: [u8; 6] = "Extend"
    var nfn: [u8; 8] = "Function"
    var nbb: [u8; 4] = "BBox"
    let st: i64 = pdoc.doc_int(d, sh, (&nst[0]) as u64, 11, 0)
    if st >= 4 && st <= 7 {
        return sh_load_mesh(d, sh, s, st, ncs)
    }
    if st != 2 && st != 3 {
        return false
    }
    (*s).stype = st as u32
    var need: usize = 4
    if st == 3 {
        need = 6
    }
    if pfunc.pf_nums(d, sh, (&ncd[0]) as u64, 6, (&(*s).c[0]) as *mut f64, 6) < need {
        return false
    }
    var dm: [f64; 2] = [0.0, 1.0]
    pfunc.pf_nums(d, sh, (&ndm[0]) as u64, 6, (&dm[0]) as *mut f64, 2)
    (*s).t0 = dm[0]
    (*s).t1 = dm[1]
    let ea: u32 = pdoc.doc_dict_get(d, sh, (&nex[0]) as u64, 6)
    if pobj.o_kind(ar, ea) == pobj.T_ARR && pobj.o_arr_len(ar, ea) >= 2 {
        (*s).ext0 = pobj.o_bool(ar, pdoc.doc_resolve(d, pobj.o_arr_at(ar, ea, 0)))
        (*s).ext1 = pobj.o_bool(ar, pdoc.doc_resolve(d, pobj.o_arr_at(ar, ea, 1)))
    }
    (*s).hasbox = pfunc.pf_nums(d, sh, (&nbb[0]) as u64, 4,
        (&(*s).box_[0]) as *mut f64, 4) >= 4
    return sh_build_lut(d, sh, s)
}

fn sh_build_lut(d: *mut pdoc.Doc, sh: u32, s: *mut Shade) -> bool {
    let ar: *mut pobj.PdfArena = &(*d).ar
    var nfn: [u8; 8] = "Function"
    let fo: u32 = pdoc.doc_dict_get(d, sh, (&nfn[0]) as u64, 8)
    var fs: pfunc.PFuncSet = pfunc.pf_set_new()
    if !pfunc.pf_set_init(&fs) {
        pfunc.pf_set_free(&fs)
        return false
    }
    var ids: [i32; 8] = [-1; 8]
    var nf: usize = 0
    if pobj.o_kind(ar, fo) == pobj.T_ARR {
        var i: usize = 0
        while i < pobj.o_arr_len(ar, fo) && nf < SH_MAXC {
            ids[nf] = pfunc.pf_parse(d, &fs, pobj.o_arr_at(ar, fo, i), 0)
            if ids[nf] < 0 {
                pfunc.pf_set_free(&fs)
                return false
            }
            nf = nf + 1
            i = i + 1
        }
    } else {
        ids[0] = pfunc.pf_parse(d, &fs, fo, 0)
        if ids[0] < 0 {
            pfunc.pf_set_free(&fs)
            return false
        }
        nf = 1
    }
    var nc: usize = 0
    var q: usize = 0
    while q < nf {
        nc = nc + pfunc.pf_nout(&fs, ids[q])
        q = q + 1
    }
    if nc == 0 || nc > SH_MAXC {
        pfunc.pf_set_free(&fs)
        return false
    }
    let lut: *mut f64 = mem.heap_alloc(SH_LUT * nc * 8) as *mut f64
    if lut as usize == 0 {
        pfunc.pf_set_free(&fs)
        return false
    }
    (*s).lutc = lut
    (*s).nc = nc
    var i: usize = 0
    while i < SH_LUT {
        let t: f64 = (*s).t0 + ((*s).t1 - (*s).t0) * (i as f64) / 256.0
        var inp: [f64; 4] = [t, 0.0, 0.0, 0.0]
        var outv: [f64; 8] = [0.0; 8]
        var col: usize = 0
        var f: usize = 0
        while f < nf {
            let got: usize = pfunc.pf_eval(&fs, ids[f], (&inp[0]) as *mut f64,
                (&outv[0]) as *mut f64)
            var j: usize = 0
            while j < got && col < nc {
                *((lut as u64 + ((i * nc + col) * 8) as u64) as *mut f64) = outv[j]
                col = col + 1
                j = j + 1
            }
            f = f + 1
        }
        i = i + 1
    }
    pfunc.pf_set_free(&fs)
    return true
}

fn sh_load_mesh(d: *mut pdoc.Doc, sh: u32, s: *mut Shade, st: i64, ncs: usize) -> bool {
    let ar: *mut pobj.PdfArena = &(*d).ar
    (*s).stype = st as u32
    var nfn: [u8; 8] = "Function"
    let fo: u32 = pdoc.doc_dict_get(d, sh, (&nfn[0]) as u64, 8)
    let fk: u32 = pobj.o_kind(ar, fo)
    let hasfn: bool = fk == pobj.T_ARR || fk == pobj.T_DICT || fk == pobj.T_STREAM
    var tr: [f64; 2] = [0.0, 1.0]
    if !pmesh.mesh_load(d, sh, &(*s).mesh, st, ncs, hasfn, (&tr[0]) as *mut f64) {
        return false
    }
    (*s).t0 = tr[0]
    (*s).t1 = tr[1]
    (*s).hasfn = hasfn
    if hasfn {
        return sh_build_lut(d, sh, s)
    }
    return true
}

fn sh_invert(m: *mut f64, o: *mut f64) -> bool {
    let a: f64 = *((m as u64) as *mut f64)
    let b: f64 = *((m as u64 + 8) as *mut f64)
    let c: f64 = *((m as u64 + 16) as *mut f64)
    let d: f64 = *((m as u64 + 24) as *mut f64)
    let e: f64 = *((m as u64 + 32) as *mut f64)
    let f: f64 = *((m as u64 + 40) as *mut f64)
    let det: f64 = a * d - b * c
    if det > -0.000000000001 && det < 0.000000000001 {
        return false
    }
    let ia: f64 = d / det
    let ib: f64 = 0.0 - b / det
    let ic: f64 = 0.0 - c / det
    let id: f64 = a / det
    *((o as u64) as *mut f64) = ia
    *((o as u64 + 8) as *mut f64) = ib
    *((o as u64 + 16) as *mut f64) = ic
    *((o as u64 + 24) as *mut f64) = id
    *((o as u64 + 32) as *mut f64) = 0.0 - (e * ia + f * ic)
    *((o as u64 + 40) as *mut f64) = 0.0 - (e * ib + f * id)
    return true
}

fn sh_axial_t(s: *mut Shade, x: f64, y: f64, t: *mut f64) -> bool {
    let dx: f64 = (*s).c[2] - (*s).c[0]
    let dy: f64 = (*s).c[3] - (*s).c[1]
    let den: f64 = dx * dx + dy * dy
    if den == 0.0 {
        return false
    }
    var u: f64 = ((x - (*s).c[0]) * dx + (y - (*s).c[1]) * dy) / den
    if u < 0.0 {
        if !(*s).ext0 {
            return false
        }
        u = 0.0
    }
    if u > 1.0 {
        if !(*s).ext1 {
            return false
        }
        u = 1.0
    }
    *t = u
    return true
}

fn sh_radial_ok(s: *mut Shade, u: f64, t: *mut f64) -> bool {
    let r: f64 = (*s).c[2] + u * ((*s).c[5] - (*s).c[2])
    if r < 0.0 {
        return false
    }
    if u < 0.0 {
        if !(*s).ext0 {
            return false
        }
        *t = 0.0
        return true
    }
    if u > 1.0 {
        if !(*s).ext1 {
            return false
        }
        *t = 1.0
        return true
    }
    *t = u
    return true
}

fn sh_radial_t(s: *mut Shade, x: f64, y: f64, t: *mut f64) -> bool {
    let dx: f64 = (*s).c[3] - (*s).c[0]
    let dy: f64 = (*s).c[4] - (*s).c[1]
    let r0: f64 = (*s).c[2]
    let dr: f64 = (*s).c[5] - r0
    let px: f64 = x - (*s).c[0]
    let py: f64 = y - (*s).c[1]
    let a: f64 = dx * dx + dy * dy - dr * dr
    let b: f64 = px * dx + py * dy + r0 * dr
    let c: f64 = px * px + py * py - r0 * r0
    if a > -0.000000000001 && a < 0.000000000001 {
        if b > -0.000000000001 && b < 0.000000000001 {
            return false
        }
        return sh_radial_ok(s, c / (2.0 * b), t)
    }
    let disc: f64 = b * b - a * c
    if disc < 0.0 {
        return false
    }
    let q: f64 = math.sqrt(disc)
    var s1: f64 = (b + q) / a
    var s2: f64 = (b - q) / a
    if s1 < s2 {
        let tmp: f64 = s1
        s1 = s2
        s2 = tmp
    }
    if sh_radial_ok(s, s1, t) {
        return true
    }
    return sh_radial_ok(s, s2, t)
}

fn sh_paint(s: *mut Shade, cv: *mut canvas.Canvas, mask: *mut prast.Mask,
    x0: usize, y0: usize, x1: usize, y1: usize, inv: *mut f64, lut: *mut u32,
    bg: u32, hasbg: bool, alpha: f64) {
    var y: usize = y0
    while y < y1 {
        var x: usize = x0
        while x < x1 {
            let cov: f64 = prast.mask_at(mask, x, y) * alpha
            if cov > 0.0016 {
                let fx: f64 = (x as f64) + 0.5
                let fy: f64 = (y as f64) + 0.5
                let sx: f64 = *((inv as u64) as *mut f64) * fx +
                *((inv as u64 + 16) as *mut f64) * fy + *((inv as u64 + 32) as *mut f64)
                let sy: f64 = *((inv as u64 + 8) as *mut f64) * fx +
                *((inv as u64 + 24) as *mut f64) * fy + *((inv as u64 + 40) as *mut f64)
                var inside: bool = true
                if (*s).hasbox {
                    var bx0: f64 = (*s).box_[0]
                    var bx1: f64 = (*s).box_[2]
                    var by0: f64 = (*s).box_[1]
                    var by1: f64 = (*s).box_[3]
                    if bx0 > bx1 {
                        let tt: f64 = bx0
                        bx0 = bx1
                        bx1 = tt
                    }
                    if by0 > by1 {
                        let tt: f64 = by0
                        by0 = by1
                        by1 = tt
                    }
                    inside = sx >= bx0 && sx <= bx1 && sy >= by0 && sy <= by1
                }
                if inside {
                    var t: f64 = 0.0
                    var ok: bool = false
                    if (*s).stype == 2 {
                        ok = sh_axial_t(s, sx, sy, &t)
                    } else {
                        ok = sh_radial_t(s, sx, sy, &t)
                    }
                    if ok {
                        var idx: usize = (t * 256.0 + 0.5) as usize
                        if idx > 256 {
                            idx = 256
                        }
                        canvas.canvas_blend(cv, x, y,
                            *((lut as u64 + (idx * 4) as u64) as *mut u32), cov)
                    }
                    if !ok && hasbg {
                        canvas.canvas_blend(cv, x, y, bg, cov)
                    }
                }
            }
            x = x + 1
        }
        y = y + 1
    }
}

fn sh_paint_mesh(s: *mut Shade, cv: *mut canvas.Canvas, mask: *mut prast.Mask,
    x0: usize, y0: usize, x1: usize, y1: usize, fm: *mut f64, lut: *mut u32,
    vcol: *mut u32, bg: u32, hasbg: bool, alpha: f64) {
    if hasbg {
        var y: usize = y0
        while y < y1 {
            var x: usize = x0
            while x < x1 {
                let cov: f64 = prast.mask_at(mask, x, y) * alpha
                if cov > 0.0016 {
                    canvas.canvas_blend(cv, x, y, bg, cov)
                }
                x = x + 1
            }
            y = y + 1
        }
    }
    pmesh.mesh_paint(&(*s).mesh, cv, mask, x0, y0, x1, y1, fm, lut, vcol,
        (*s).hasfn, (*s).t0, (*s).t1, alpha)
}
