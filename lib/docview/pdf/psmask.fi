import paint.canvas
import docview.pdf.prast

export {
    sm_build,
}

fn sm_build(cv: *mut canvas.Canvas, clip: *mut prast.Mask, luma: bool) -> prast.Mask {
    let w: usize = canvas.canvas_width(cv)
    let h: usize = canvas.canvas_height(cv)
    let m: prast.Mask = prast.mask_new(w, h, 0 as u8)
    if m.p as usize == 0 {
        return m
    }
    var y: usize = 0
    while y < h {
        var x: usize = 0
        while x < w {
            let px: u32 = canvas.canvas_get(cv, x, y)
            var v: u32 = canvas.color_a(px)
            if luma {
                v = (77 as u32 * canvas.color_r(px) + 151 as u32 * canvas.color_g(px) +
                    28 as u32 * canvas.color_b(px)) >> 8
            }
            if v > 255 as u32 {
                v = 255
            }
            var f: f64 = (v as f64) * prast.mask_at(clip, x, y)
            if f > 255.0 {
                f = 255.0
            }
            *((m.p as u64 + (y * w + x) as u64) as *mut u8) = (f + 0.5) as u8
            x = x + 1
        }
        y = y + 1
    }
    return m
}
