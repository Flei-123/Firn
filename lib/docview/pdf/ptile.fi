// SPDX-License-Identifier: MPL-2.0
// PDF tiling patterns: paints a rendered pattern cell through a coverage mask by inverse mapping every device pixel.
import std.math
import paint.canvas
import docview.pdf.prast

export {
    tile_paint,
}

fn tile_paint(cell: *mut canvas.Canvas, cv: *mut canvas.Canvas,
    mask: *mut prast.Mask, x0: usize, y0: usize, x1: usize, y1: usize,
    inv: *mut f64, bx: f64, by: f64, xs: f64, ys: f64, alpha: f64) {
    let cw: usize = canvas.canvas_width(cell)
    let ch: usize = canvas.canvas_height(cell)
    if cw == 0 || ch == 0 || xs <= 0.0 || ys <= 0.0 {
        return
    }
    var y: usize = y0
    while y < y1 {
        var x: usize = x0
        while x < x1 {
            let cov: f64 = prast.mask_at(mask, x, y) * alpha
            if cov > 0.0016 {
                let fx: f64 = (x as f64) + 0.5
                let fy: f64 = (y as f64) + 0.5
                let u: f64 = *((inv as u64) as *mut f64) * fx +
                *((inv as u64 + 16) as *mut f64) * fy + *((inv as u64 + 32) as *mut f64)
                let v: f64 = *((inv as u64 + 8) as *mut f64) * fx +
                *((inv as u64 + 24) as *mut f64) * fy + *((inv as u64 + 40) as *mut f64)
                var gu: f64 = (u - bx) / xs
                var gv: f64 = (v - by) / ys
                gu = gu - math.floor(gu)
                gv = gv - math.floor(gv)
                var cx: usize = (gu * (cw as f64)) as usize
                var cy: usize = (gv * (ch as f64)) as usize
                if cx >= cw {
                    cx = cw - 1
                }
                if cy >= ch {
                    cy = ch - 1
                }
                let px: u32 = canvas.canvas_get(cell, cx, cy)
                let a: u32 = canvas.color_a(px)
                if a > 0 as u32 {
                    var r: u32 = canvas.color_r(px) * 255 as u32 / a
                    var g: u32 = canvas.color_g(px) * 255 as u32 / a
                    var b: u32 = canvas.color_b(px) * 255 as u32 / a
                    if r > 255 as u32 {
                        r = 255
                    }
                    if g > 255 as u32 {
                        g = 255
                    }
                    if b > 255 as u32 {
                        b = 255
                    }
                    canvas.canvas_blend(cv, x, y,
                        canvas.color_of(255, r, g, b),
                        cov * (a as f64) / 255.0)
                }
            }
            x = x + 1
        }
        y = y + 1
    }
}
