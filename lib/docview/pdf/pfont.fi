// SPDX-License-Identifier: MPL-2.0
// PDF fonts: widths, encodings, ToUnicode and the built-in substitute faces.
import html.mem
import rt.rt
import docview.pdf.pobj
import docview.pdf.pdoc
import docview.pdf.std14_data
import font.ttf
import docview.pdf.pdffonts_data

export {
    FontHold, PFont,
    fonthold_new, fonthold_load_mem, fonthold_face, fonthold_count,
    pfont_new, pfont_load,
    pf_width, pf_unicode, pf_face, pf_bytes, pf_ok, pf_type3,
    pf_is_space, pf_glyph,
    FACE_SERIF, FACE_SERIF_B, FACE_SERIF_I, FACE_SERIF_BI,
    FACE_SANS, FACE_SANS_B, FACE_SANS_I, FACE_SANS_BI,
    FACE_MONO, FACE_MONO_B, FACE_MONO_I,
    FACE_COUNT,
}

const FACE_SERIF: usize = 0
const FACE_SERIF_B: usize = 1
const FACE_SERIF_I: usize = 2
const FACE_SERIF_BI: usize = 3
const FACE_SANS: usize = 4
const FACE_SANS_B: usize = 5
const FACE_SANS_I: usize = 6
const FACE_SANS_BI: usize = 7
const FACE_MONO: usize = 8
const FACE_MONO_B: usize = 9
const FACE_MONO_I: usize = 10
const FACE_COUNT: usize = 11

struct FontHold {
    f: [ttf.Font; 11],
    buf: [rt.Buf; 11],
    have: [u32; 11],
    n: usize,
}

struct PFont {
    dict: u32,
    ok: u32,
    type0: u32,
    type3: u32,
    face: usize,
    base14: i32,
    dw: f64,
    missing: f64,
    w: [f64; 256],
    u: [u32; 256],
    warr: u32,
    tu_lo: [u32; 1024],
    tu_hi: [u32; 1024],
    tu_dst: [u32; 1024],
    tu_n: usize,
}

#[no_gc]
fn ld8(p: u64, i: usize) -> u8 {
    return *((p + i as u64) as *mut u8)
}

fn fonthold_new() -> FontHold {
    return FontHold { f: [ttf.font_new(); 11], buf: [rt.buf_new(); 11],
        have: [0 as u32; 11], n: 0 }
}

#[no_gc]
fn fonthold_count(fh: *mut FontHold) -> usize {
    return (*fh).n
}

#[no_gc]
fn fonthold_face(fh: *mut FontHold, i: usize) -> *mut ttf.Font {
    var k: usize = i
    if k >= FACE_COUNT || (*fh).have[k] == 0 as u32 {
        k = 0
    }
    return &(*fh).f[k]
}

fn fonthold_load_mem(fh: *mut FontHold) {
    var i: usize = 0
    while i < FACE_COUNT {
        if ttf.font_init(&(*fh).f[i], pdffonts_data.pdffont_ptr(i) as *mut u8,
            pdffonts_data.pdffont_len(i)) {
            (*fh).have[i] = 1
            (*fh).n = (*fh).n + 1
        }
        i = i + 1
    }
}

#[no_gc]
fn pfont_new() -> PFont {
    return PFont { dict: 0, ok: 0, type0: 0, type3: 0, face: FACE_SERIF,
        base14: -1, dw: 1000.0, missing: 0.0,
        w: [0.0; 256], u: [0 as u32; 256], warr: 0,
        tu_lo: [0 as u32; 1024], tu_hi: [0 as u32; 1024],
        tu_dst: [0 as u32; 1024], tu_n: 0 }
}

#[no_gc]
fn pf_ok(p: *mut PFont) -> bool {
    return (*p).ok != 0 as u32
}

#[no_gc]
fn pf_type3(p: *mut PFont) -> bool {
    return (*p).type3 != 0 as u32
}

#[no_gc]
fn pf_face(p: *mut PFont) -> usize {
    return (*p).face
}

#[no_gc]
fn pf_bytes(p: *mut PFont) -> usize {
    if (*p).type0 != 0 as u32 {
        return 2
    }
    return 1
}

#[no_gc]
fn pf_is_space(p: *mut PFont, code: u32) -> bool {
    return (*p).type0 == 0 as u32 && code == 32 as u32
}

fn pf_width(d: *mut pdoc.Doc, p: *mut PFont, code: u32) -> f64 {
    if (*p).type0 == 0 as u32 {
        if code < 256 as u32 {
            return (*p).w[code as usize]
        }
        return (*p).missing
    }
    if (*p).warr == 0 as u32 {
        return (*p).dw
    }
    let ar: *mut pobj.Arena = doc_arena(d)
    let n: usize = pobj.o_arr_len(ar, (*p).warr)
    var i: usize = 0
    while i + 1 < n {
        let first: u32 = pdoc.doc_resolve(d, pobj.o_arr_at(ar, (*p).warr, i))
        let c1: i64 = pobj.o_int(ar, first)
        let second: u32 = pdoc.doc_resolve(d,
            pobj.o_arr_at(ar, (*p).warr, i + 1))
        if pobj.o_kind(ar, second) == pobj.T_ARR {
            let m: usize = pobj.o_arr_len(ar, second)
            if (code as i64) >= c1 && (code as i64) < c1 + (m as i64) {
                return pobj.o_num(ar, pdoc.doc_resolve(d,
                    pobj.o_arr_at(ar, second, (code as usize) - (c1 as usize))))
            }
            i = i + 2
        } else {
            if i + 2 >= n {
                break
            }
            let c2: i64 = pobj.o_int(ar, second)
            let wv: f64 = pobj.o_num(ar, pdoc.doc_resolve(d,
                pobj.o_arr_at(ar, (*p).warr, i + 2)))
            if (code as i64) >= c1 && (code as i64) <= c2 {
                return wv
            }
            i = i + 3
        }
    }
    return (*p).dw
}

#[no_gc]
fn tu_lookup(p: *mut PFont, code: u32) -> u32 {
    var i: usize = 0
    while i < (*p).tu_n {
        if code >= (*p).tu_lo[i] && code <= (*p).tu_hi[i] {
            return (*p).tu_dst[i] + (code - (*p).tu_lo[i])
        }
        i = i + 1
    }
    return 0
}

#[no_gc]
fn pf_unicode(p: *mut PFont, code: u32) -> u32 {
    if (*p).type0 != 0 as u32 {
        return tu_lookup(p, code)
    }
    if code < 256 as u32 {
        return (*p).u[code as usize]
    }
    return 0
}

#[no_gc]
fn pf_glyph(fh: *mut FontHold, p: *mut PFont, code: u32) -> u32 {
    let u: u32 = pf_unicode(p, code)
    if u == 0 as u32 {
        return 0
    }
    return ttf.font_glyph_for(fonthold_face(fh, (*p).face), u)
}

fn doc_arena(d: *mut pdoc.Doc) -> *mut pobj.Arena {
    return &(*d).ar
}

#[no_gc]
fn name_has(ar: *mut pobj.Arena, h: u32, lit: u64, n: usize) -> bool {
    let p: u64 = pobj.o_str_ptr(ar, h)
    let m: usize = pobj.o_str_len(ar, h)
    if m < n {
        return false
    }
    var i: usize = 0
    while i + n <= m {
        var same: bool = true
        var k: usize = 0
        while k < n {
            let a: u8 = low(ld8(p, i + k))
            let b: u8 = low(ld8(lit, k))
            if a != b {
                same = false
            }
            k = k + 1
        }
        if same {
            return true
        }
        i = i + 1
    }
    return false
}

#[no_gc]
fn low(c: u8) -> u8 {
    if c >= 65 as u8 && c <= 90 as u8 {
        return c + 32 as u8
    }
    return c
}

#[no_gc]
fn base14_of(ar: *mut pobj.Arena, h: u32) -> i32 {
    var p: u64 = pobj.o_str_ptr(ar, h)
    var n: usize = pobj.o_str_len(ar, h)
    if n == 0 {
        return -1
    }
    var i: usize = 0
    while i < n {
        if ld8(p, i) == 43 as u8 {
            p = p + (i + 1) as u64
            n = n - (i + 1)
            i = 0
        } else {
            i = i + 1
        }
    }
    var tab: [u8; 195] = "Courier|Courier-Bold|Courier-Oblique|Courier-BoldOblique|Helvetica|Helvetica-Bold|Helvetica-Oblique|Helvetica-BoldOblique|Times-Roman|Times-Bold|Times-Italic|Times-BoldItalic|Symbol|ZapfDingbats|"
    var idx: i32 = 0
    var s: usize = 0
    var k: usize = 0
    while k < 195 {
        if tab[k] == 124 as u8 {
            if k - s == n {
                var same: bool = true
                var q: usize = 0
                while q < n {
                    if low(tab[s + q]) != low(ld8(p, q)) {
                        same = false
                    }
                    q = q + 1
                }
                if same {
                    return idx
                }
            }
            idx = idx + 1
            s = k + 1
        }
        k = k + 1
    }
    return -1
}

fn pick_face(d: *mut pdoc.Doc, fd: u32, base: u32) -> usize {
    let ar: *mut pobj.Arena = doc_arena(d)
    var mono: bool = false
    var serif: bool = true
    var bold: bool = false
    var ital: bool = false
    var fl: [u8; 5] = "Flags"
    let flags: i64 = pdoc.doc_int(d, fd, (&fl[0]) as u64, 5, 0)
    if (flags & 1) != 0 {
        mono = true
    }
    if (flags & 2) != 0 {
        serif = true
    } else if flags != 0 {
        serif = false
    }
    if (flags & 64) != 0 {
        ital = true
    }
    var sv: [u8; 5] = "StemV"
    if pdoc.doc_num(d, fd, (&sv[0]) as u64, 5, 0.0) >= 120.0 {
        bold = true
    }
    var wgt: [u8; 10] = "FontWeight"
    if pdoc.doc_num(d, fd, (&wgt[0]) as u64, 10, 0.0) >= 600.0 {
        bold = true
    }
    var t_bold: [u8; 4] = "bold"
    var t_blk: [u8; 5] = "black"
    var t_ital: [u8; 6] = "italic"
    var t_obl: [u8; 7] = "oblique"
    var t_mono: [u8; 4] = "mono"
    var t_cour: [u8; 7] = "courier"
    var t_times: [u8; 5] = "times"
    var t_serif: [u8; 5] = "serif"
    var t_arial: [u8; 5] = "arial"
    var t_helv: [u8; 4] = "helv"
    var t_sans: [u8; 4] = "sans"
    if base != 0 as u32 {
        if name_has(ar, base, (&t_bold[0]) as u64, 4) ||
        name_has(ar, base, (&t_blk[0]) as u64, 5) {
            bold = true
        }
        if name_has(ar, base, (&t_ital[0]) as u64, 6) ||
        name_has(ar, base, (&t_obl[0]) as u64, 7) {
            ital = true
        }
        if name_has(ar, base, (&t_mono[0]) as u64, 4) ||
        name_has(ar, base, (&t_cour[0]) as u64, 7) {
            mono = true
        }
        if name_has(ar, base, (&t_arial[0]) as u64, 5) ||
        name_has(ar, base, (&t_helv[0]) as u64, 4) ||
        name_has(ar, base, (&t_sans[0]) as u64, 4) {
            serif = false
        }
        if name_has(ar, base, (&t_times[0]) as u64, 5) ||
        name_has(ar, base, (&t_serif[0]) as u64, 5) {
            serif = true
        }
    }
    if mono {
        if bold {
            return FACE_MONO_B
        }
        if ital {
            return FACE_MONO_I
        }
        return FACE_MONO
    }
    if serif {
        if bold && ital {
            return FACE_SERIF_BI
        }
        if bold {
            return FACE_SERIF_B
        }
        if ital {
            return FACE_SERIF_I
        }
        return FACE_SERIF
    }
    if bold && ital {
        return FACE_SANS_BI
    }
    if bold {
        return FACE_SANS_B
    }
    if ital {
        return FACE_SANS_I
    }
    return FACE_SANS
}

#[no_gc]
fn face_for_base14(k: i32) -> usize {
    if k < 4 {
        if k == 1 {
            return FACE_MONO_B
        }
        if k == 2 {
            return FACE_MONO_I
        }
        if k == 3 {
            return FACE_MONO_B
        }
        return FACE_MONO
    }
    if k < 8 {
        if k == 5 {
            return FACE_SANS_B
        }
        if k == 6 {
            return FACE_SANS_I
        }
        if k == 7 {
            return FACE_SANS_BI
        }
        return FACE_SANS
    }
    if k < 12 {
        if k == 9 {
            return FACE_SERIF_B
        }
        if k == 10 {
            return FACE_SERIF_I
        }
        if k == 11 {
            return FACE_SERIF_BI
        }
        return FACE_SERIF
    }
    return FACE_SERIF
}

fn pfont_load(d: *mut pdoc.Doc, dict: u32, p: *mut PFont) -> bool {
    let ar: *mut pobj.Arena = doc_arena(d)
    *p = pfont_new()
    (*p).dict = dict
    if pobj.o_kind(ar, dict) != pobj.T_DICT {
        return false
    }
    var stn: [u8; 7] = "Subtype"
    var bfn: [u8; 8] = "BaseFont"
    var t0: [u8; 5] = "Type0"
    var t3: [u8; 5] = "Type3"
    let st: u32 = pdoc.doc_dict_get(d, dict, (&stn[0]) as u64, 7)
    let base: u32 = pdoc.doc_dict_get(d, dict, (&bfn[0]) as u64, 8)
    var work: u32 = dict
    if pobj.o_name_eq(ar, st, (&t0[0]) as u64, 5) {
        (*p).type0 = 1
        var dfn: [u8; 15] = "DescendantFonts"
        let df: u32 = pdoc.doc_dict_get(d, dict, (&dfn[0]) as u64, 15)
        if pobj.o_kind(ar, df) == pobj.T_ARR && pobj.o_arr_len(ar, df) > 0 {
            work = pdoc.doc_resolve(d, pobj.o_arr_at(ar, df, 0))
        }
        var dwn: [u8; 2] = "DW"
        (*p).dw = pdoc.doc_num(d, work, (&dwn[0]) as u64, 2, 1000.0)
        var wn: [u8; 1] = "W"
        (*p).warr = pdoc.doc_dict_get(d, work, (&wn[0]) as u64, 1)
    }
    if pobj.o_name_eq(ar, st, (&t3[0]) as u64, 5) {
        (*p).type3 = 1
    }
    (*p).base14 = base14_of(ar, base)
    var fdn: [u8; 14] = "FontDescriptor"
    let fd: u32 = pdoc.doc_dict_get(d, work, (&fdn[0]) as u64, 14)
    if (*p).base14 >= 0 {
        (*p).face = face_for_base14((*p).base14)
    } else {
        (*p).face = pick_face(d, fd, base)
    }
    var mwn: [u8; 12] = "MissingWidth"
    (*p).missing = pdoc.doc_num(d, fd, (&mwn[0]) as u64, 12, 0.0)
    load_tounicode(d, dict, p)
    if (*p).type0 != 0 as u32 {
        (*p).ok = 1
        return true
    }
    var enc_id: u32 = std14_data.ENC_STD
    if (*p).base14 == 12 {
        enc_id = std14_data.ENC_SYM
    } else if (*p).base14 == 13 {
        enc_id = std14_data.ENC_ZAPF
    }
    var stt: [u8; 8] = "TrueType"
    if pobj.o_name_eq(ar, st, (&stt[0]) as u64, 8) {
        enc_id = std14_data.ENC_WIN
    }
    var en: [u8; 8] = "Encoding"
    let eh: u32 = pdoc.doc_dict_get(d, dict, (&en[0]) as u64, 8)
    var diffs: u32 = 0
    var wa: [u8; 15] = "WinAnsiEncoding"
    var ma: [u8; 16] = "MacRomanEncoding"
    var sa: [u8; 16] = "StandardEncoding"
    if pobj.o_kind(ar, eh) == pobj.T_NAME {
        if pobj.o_name_eq(ar, eh, (&wa[0]) as u64, 15) {
            enc_id = std14_data.ENC_WIN
        } else if pobj.o_name_eq(ar, eh, (&ma[0]) as u64, 16) {
            enc_id = std14_data.ENC_MAC
        } else if pobj.o_name_eq(ar, eh, (&sa[0]) as u64, 15) {
            enc_id = std14_data.ENC_STD
        }
    } else if pobj.o_kind(ar, eh) == pobj.T_DICT {
        var ben: [u8; 12] = "BaseEncoding"
        let bh: u32 = pdoc.doc_dict_get(d, eh, (&ben[0]) as u64, 12)
        if pobj.o_name_eq(ar, bh, (&wa[0]) as u64, 15) {
            enc_id = std14_data.ENC_WIN
        } else if pobj.o_name_eq(ar, bh, (&ma[0]) as u64, 16) {
            enc_id = std14_data.ENC_MAC
        } else if pobj.o_name_eq(ar, bh, (&sa[0]) as u64, 15) {
            enc_id = std14_data.ENC_STD
        }
        var dn2: [u8; 11] = "Differences"
        diffs = pdoc.doc_dict_get(d, eh, (&dn2[0]) as u64, 11)
    }
    var c: usize = 0
    while c < 256 {
        (*p).u[c] = std14_data.enc_unicode(enc_id, c)
        c = c + 1
    }
    if pobj.o_kind(ar, diffs) == pobj.T_ARR {
        let n: usize = pobj.o_arr_len(ar, diffs)
        var cur: i64 = 0
        var i: usize = 0
        while i < n {
            let it: u32 = pdoc.doc_resolve(d, pobj.o_arr_at(ar, diffs, i))
            if pobj.o_is_num(ar, it) {
                cur = pobj.o_int(ar, it)
            } else if pobj.o_kind(ar, it) == pobj.T_NAME {
                if cur >= 0 && cur < 256 {
                    let k: i32 = std14_data.std14_name_index(
                        pobj.o_str_ptr(ar, it), pobj.o_str_len(ar, it))
                    var uni: u32 = 0
                    if k >= 0 {
                        uni = std14_data.std14_name_unicode(k as usize)
                    } else {
                        uni = uni_from_name(pobj.o_str_ptr(ar, it),
                            pobj.o_str_len(ar, it))
                    }
                    (*p).u[cur as usize] = uni
                }
                cur = cur + 1
            }
            i = i + 1
        }
    }
    var fcn: [u8; 9] = "FirstChar"
    var wsn: [u8; 6] = "Widths"
    let first: i64 = pdoc.doc_int(d, dict, (&fcn[0]) as u64, 9, 0)
    let wh: u32 = pdoc.doc_dict_get(d, dict, (&wsn[0]) as u64, 6)
    var have_widths: bool = false
    if pobj.o_kind(ar, wh) == pobj.T_ARR && pobj.o_arr_len(ar, wh) > 0 {
        have_widths = true
        let n: usize = pobj.o_arr_len(ar, wh)
        var c2: usize = 0
        while c2 < 256 {
            (*p).w[c2] = (*p).missing
            c2 = c2 + 1
        }
        var i2: usize = 0
        while i2 < n {
            let code: i64 = first + (i2 as i64)
            if code >= 0 && code < 256 {
                (*p).w[code as usize] = pobj.o_num(ar,
                    pdoc.doc_resolve(d, pobj.o_arr_at(ar, wh, i2)))
            }
            i2 = i2 + 1
        }
    }
    if !have_widths {
        var b14: usize = 4
        if (*p).base14 >= 0 {
            b14 = (*p).base14 as usize
        }
        var c3: usize = 0
        while c3 < 256 {
            (*p).w[c3] = std14_data.std14_width(b14, c3) as f64
            c3 = c3 + 1
        }
    }
    (*p).ok = 1
    return true
}

#[no_gc]
fn hex_str(p: u64, n: usize, at: *mut usize, val: *mut u32,
    nchar: *mut usize) -> bool {
    var i: usize = *at
    while i < n && ld8(p, i) != 60 as u8 {
        if ld8(p, i) == 101 as u8 {
            return false
        }
        i = i + 1
    }
    if i >= n {
        return false
    }
    i = i + 1
    var v: u32 = 0
    var digits: usize = 0
    while i < n && ld8(p, i) != 62 as u8 {
        let h: i32 = hexv(ld8(p, i))
        if h >= 0 {
            if digits < 4 {
                v = v * 16 + (h as u32)
            }
            digits = digits + 1
        }
        i = i + 1
    }
    *at = i + 1
    *val = v
    *nchar = digits
    return true
}

fn load_tounicode(d: *mut pdoc.Doc, dict: u32, p: *mut PFont) {
    let ar: *mut pobj.Arena = doc_arena(d)
    var tun: [u8; 9] = "ToUnicode"
    let th: u32 = pdoc.doc_dict_get(d, dict, (&tun[0]) as u64, 9)
    if pobj.o_kind(ar, th) != pobj.T_STREAM {
        return
    }
    var b: rt.Buf = rt.buf_new()
    if !pdoc.doc_stream(d, th, &b) {
        rt.buf_free(&b)
        return
    }
    let s: u64 = rt.buf_ptr(&b)
    let n: usize = rt.buf_len(&b)
    var bc: [u8; 11] = "beginbfchar"
    var br: [u8; 12] = "beginbfrange"
    var i: usize = 0
    while i + 11 <= n && (*p).tu_n < 1024 {
        if ld8(s, i) == 98 as u8 {
            if i + 12 <= n && match_lit(s, i, (&br[0]) as u64, 12) {
                i = read_bfrange(s, n, i + 12, p)
                continue
            }
            if match_lit(s, i, (&bc[0]) as u64, 11) {
                i = read_bfchar(s, n, i + 11, p)
                continue
            }
        }
        i = i + 1
    }
    rt.buf_free(&b)
    if (*p).type0 == 0 as u32 {
        var c: usize = 0
        while c < 256 {
            let u: u32 = tu_lookup(p, c as u32)
            if u != 0 as u32 {
                (*p).u[c] = u
            }
            c = c + 1
        }
    }
}

#[no_gc]
fn match_lit(p: u64, at: usize, lit: u64, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        if ld8(p, at + i) != ld8(lit, i) {
            return false
        }
        i = i + 1
    }
    return true
}

#[no_gc]
fn add_range(p: *mut PFont, lo: u32, hi: u32, dst: u32) {
    if (*p).tu_n >= 1024 || dst == 0 as u32 {
        return
    }
    var h: u32 = hi
    if h < lo {
        h = lo
    }
    if h - lo > 65535 as u32 {
        h = lo + 65535 as u32
    }
    let k: usize = (*p).tu_n
    (*p).tu_lo[k] = lo
    (*p).tu_hi[k] = h
    (*p).tu_dst[k] = dst
    (*p).tu_n = k + 1
}

#[no_gc]
fn read_bfchar(s: u64, n: usize, at: usize, p: *mut PFont) -> usize {
    var i: usize = at
    var guard: usize = 0
    while i < n && guard < 200000 {
        guard = guard + 1
        var src: u32 = 0
        var nd: usize = 0
        var j: usize = i
        if !hex_str(s, n, &j, &src, &nd) {
            return skip_to_end(s, n, i)
        }
        var dstv: u32 = 0
        var nd2: usize = 0
        if !hex_str(s, n, &j, &dstv, &nd2) {
            return skip_to_end(s, n, i)
        }
        add_range(p, src, src, dstv)
        i = j
        if (*p).tu_n >= 1024 {
            return skip_to_end(s, n, i)
        }
    }
    return i
}

#[no_gc]
fn read_bfrange(s: u64, n: usize, at: usize, p: *mut PFont) -> usize {
    var i: usize = at
    var guard: usize = 0
    while i < n && guard < 200000 {
        guard = guard + 1
        var lo: u32 = 0
        var hi: u32 = 0
        var dstv: u32 = 0
        var nd: usize = 0
        var j: usize = i
        if !hex_str(s, n, &j, &lo, &nd) {
            return skip_to_end(s, n, i)
        }
        if !hex_str(s, n, &j, &hi, &nd) {
            return skip_to_end(s, n, i)
        }
        var k: usize = j
        while k < n && (ld8(s, k) == 32 as u8 || ld8(s, k) == 10 as u8 ||
        ld8(s, k) == 13 as u8 || ld8(s, k) == 9 as u8) {
            k = k + 1
        }
        if k < n && ld8(s, k) == 91 as u8 {
            var c: u32 = lo
            var m: usize = k + 1
            while m < n && ld8(s, m) != 93 as u8 && c <= hi {
                var v: u32 = 0
                var q: usize = m
                if !hex_str(s, n, &q, &v, &nd) {
                    m = n
                } else {
                    add_range(p, c, c, v)
                    c = c + 1 as u32
                    m = q
                }
            }
            while m < n && ld8(s, m) != 93 as u8 {
                m = m + 1
            }
            i = m + 1
        } else {
            if !hex_str(s, n, &j, &dstv, &nd) {
                return skip_to_end(s, n, i)
            }
            add_range(p, lo, hi, dstv)
            i = j
        }
        if (*p).tu_n >= 1024 {
            return skip_to_end(s, n, i)
        }
    }
    return i
}

#[no_gc]
fn skip_to_end(s: u64, n: usize, at: usize) -> usize {
    var i: usize = at
    var e: [u8; 5] = "endbf"
    while i + 5 <= n {
        if ld8(s, i) == 101 as u8 && match_lit(s, i, (&e[0]) as u64, 5) {
            return i + 5
        }
        i = i + 1
    }
    return n
}

#[no_gc]
fn uni_from_name(p: u64, n: usize) -> u32 {
    if n >= 7 && ld8(p, 0) == 117 as u8 && ld8(p, 1) == 110 as u8 &&
    ld8(p, 2) == 105 as u8 {
        var v: u32 = 0
        var i: usize = 3
        while i < 7 {
            let h: i32 = hexv(ld8(p, i))
            if h < 0 {
                return 0
            }
            v = v * 16 + (h as u32)
            i = i + 1
        }
        return v
    }
    if n >= 5 && n <= 7 && ld8(p, 0) == 117 as u8 {
        var v2: u32 = 0
        var i2: usize = 1
        while i2 < n {
            let h: i32 = hexv(ld8(p, i2))
            if h < 0 {
                return 0
            }
            v2 = v2 * 16 + (h as u32)
            i2 = i2 + 1
        }
        return v2
    }
    return 0
}

#[no_gc]
fn hexv(c: u8) -> i32 {
    if c >= 48 as u8 && c <= 57 as u8 {
        return (c as i32) - 48
    }
    if c >= 97 as u8 && c <= 102 as u8 {
        return (c as i32) - 87
    }
    if c >= 65 as u8 && c <= 70 as u8 {
        return (c as i32) - 55
    }
    return -1
}
