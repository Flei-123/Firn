// SPDX-License-Identifier: MPL-2.0
// PDF stream filters: Flate with predictors, ASCIIHex, ASCII85, RunLength, LZW.
import rt.rt
import std.deflate

export {
    F_NONE, F_FLATE, F_AHX, F_A85, F_RL, F_LZW, F_DCT, F_JPX, F_CCITT,
    F_JBIG2, F_CRYPT, F_UNKNOWN,
    filter_id, filter_is_image,
    f_flate, f_ahx, f_a85, f_rl, f_lzw, predict,
}

const F_NONE: u32 = 0
const F_FLATE: u32 = 1
const F_AHX: u32 = 2
const F_A85: u32 = 3
const F_RL: u32 = 4
const F_LZW: u32 = 5
const F_DCT: u32 = 6
const F_JPX: u32 = 7
const F_CCITT: u32 = 8
const F_JBIG2: u32 = 9
const F_CRYPT: u32 = 10
const F_UNKNOWN: u32 = 11

#[no_gc]
fn ld8(p: u64, i: usize) -> u8 {
    return *((p + i as u64) as *mut u8)
}

#[no_gc]
fn eq(p: u64, n: usize, lit: u64, m: usize) -> bool {
    if n != m {
        return false
    }
    var i: usize = 0
    while i < n {
        if ld8(p, i) != ld8(lit, i) {
            return false
        }
        i = i + 1
    }
    return true
}

#[no_gc]
fn filter_id(name: u64, n: usize) -> u32 {
    var a: [u8; 11] = "FlateDecode"
    var b: [u8; 14] = "ASCIIHexDecode"
    var c: [u8; 13] = "ASCII85Decode"
    var d: [u8; 15] = "RunLengthDecode"
    var e: [u8; 9] = "LZWDecode"
    var f: [u8; 9] = "DCTDecode"
    var g: [u8; 9] = "JPXDecode"
    var h: [u8; 14] = "CCITTFaxDecode"
    var i2: [u8; 11] = "JBIG2Decode"
    var j: [u8; 5] = "Crypt"
    var k: [u8; 2] = "Fl"
    var l: [u8; 3] = "AHx"
    var m: [u8; 3] = "A85"
    var o: [u8; 2] = "RL"
    var p2: [u8; 3] = "LZW"
    var q: [u8; 3] = "DCT"
    if eq(name, n, (&a[0]) as u64, 11) || eq(name, n, (&k[0]) as u64, 2) {
        return F_FLATE
    }
    if eq(name, n, (&b[0]) as u64, 14) || eq(name, n, (&l[0]) as u64, 3) {
        return F_AHX
    }
    if eq(name, n, (&c[0]) as u64, 13) || eq(name, n, (&m[0]) as u64, 3) {
        return F_A85
    }
    if eq(name, n, (&d[0]) as u64, 15) || eq(name, n, (&o[0]) as u64, 2) {
        return F_RL
    }
    if eq(name, n, (&e[0]) as u64, 9) || eq(name, n, (&p2[0]) as u64, 3) {
        return F_LZW
    }
    if eq(name, n, (&f[0]) as u64, 9) || eq(name, n, (&q[0]) as u64, 3) {
        return F_DCT
    }
    if eq(name, n, (&g[0]) as u64, 9) {
        return F_JPX
    }
    if eq(name, n, (&h[0]) as u64, 14) {
        return F_CCITT
    }
    if eq(name, n, (&i2[0]) as u64, 11) {
        return F_JBIG2
    }
    if eq(name, n, (&j[0]) as u64, 5) {
        return F_CRYPT
    }
    return F_UNKNOWN
}

#[no_gc]
fn filter_is_image(id: u32) -> bool {
    return id == F_DCT || id == F_JPX || id == F_CCITT || id == F_JBIG2
}

fn f_flate(src: u64, n: usize, out: *mut rt.Buf) -> usize {
    if n == 0 {
        return 0
    }
    let before: usize = rt.buf_len(out)
    var s: usize = 0
    while s < n && (ld8(src, s) == 10 as u8 || ld8(src, s) == 13 as u8 ||
    ld8(src, s) == 32 as u8 || ld8(src, s) == 9 as u8) {
        s = s + 1
    }
    if s >= n {
        return 0
    }
    let got: usize = deflate.zlib_decompress(src + s as u64, n - s, out)
    catch 0
    if got > 0 {
        return got
    }
    if rt.buf_len(out) > before {
        return rt.buf_len(out) - before
    }
    rt.buf_set_len(out, before)
    let raw: usize = deflate.inflate(src + s as u64, n - s, out) catch 0
    if raw > 0 {
        return raw
    }
    if rt.buf_len(out) > before {
        return rt.buf_len(out) - before
    }
    rt.buf_set_len(out, before)
    if n - s > 1 {
        let g2: usize = deflate.zlib_decompress(src + (s + 1) as u64,
            n - s - 1, out) catch 0
        if g2 > 0 {
            return g2
        }
        if rt.buf_len(out) > before {
            return rt.buf_len(out) - before
        }
    }
    rt.buf_set_len(out, before)
    return 0
}

#[no_gc]
fn hexv(c: u8) -> i32 {
    if c >= 48 as u8 && c <= 57 as u8 {
        return (c as i32) - 48
    }
    if c >= 97 as u8 && c <= 102 as u8 {
        return (c as i32) - 87
    }
    if c >= 65 as u8 && c <= 70 as u8 {
        return (c as i32) - 55
    }
    return -1
}

fn f_ahx(src: u64, n: usize, out: *mut rt.Buf) -> usize {
    let before: usize = rt.buf_len(out)
    var half: i32 = -1
    var i: usize = 0
    while i < n {
        let c: u8 = ld8(src, i)
        if c == 62 as u8 {
            break
        }
        let v: i32 = hexv(c)
        if v >= 0 {
            if half < 0 {
                half = v
            } else {
                rt.buf_push(out, ((half * 16 + v) as u32) as u8)
                half = -1
            }
        }
        i = i + 1
    }
    if half >= 0 {
        rt.buf_push(out, ((half * 16) as u32) as u8)
    }
    return rt.buf_len(out) - before
}

fn f_a85(src: u64, n: usize, out: *mut rt.Buf) -> usize {
    let before: usize = rt.buf_len(out)
    var tup: u64 = 0
    var cnt: usize = 0
    var i: usize = 0
    if n >= 2 && ld8(src, 0) == 60 as u8 && ld8(src, 1) == 126 as u8 {
        i = 2
    }
    while i < n {
        let c: u8 = ld8(src, i)
        if c == 126 as u8 {
            break
        }
        if c == 122 as u8 && cnt == 0 {
            rt.buf_push(out, 0 as u8)
            rt.buf_push(out, 0 as u8)
            rt.buf_push(out, 0 as u8)
            rt.buf_push(out, 0 as u8)
            i = i + 1
            continue
        }
        if c >= 33 as u8 && c <= 117 as u8 {
            tup = tup * 85 + ((c as u64) - 33)
            cnt = cnt + 1
            if cnt == 5 {
                rt.buf_push(out, ((tup >> 24) & 255) as u8)
                rt.buf_push(out, ((tup >> 16) & 255) as u8)
                rt.buf_push(out, ((tup >> 8) & 255) as u8)
                rt.buf_push(out, (tup & 255) as u8)
                tup = 0
                cnt = 0
            }
        }
        i = i + 1
    }
    if cnt > 1 {
        var k: usize = cnt
        while k < 5 {
            tup = tup * 85 + 84
            k = k + 1
        }
        var w: usize = 0
        while w < cnt - 1 {
            rt.buf_push(out, ((tup >> ((3 - w) * 8) as u64) & 255) as u8)
            w = w + 1
        }
    }
    return rt.buf_len(out) - before
}

fn f_rl(src: u64, n: usize, out: *mut rt.Buf) -> usize {
    let before: usize = rt.buf_len(out)
    var i: usize = 0
    while i < n {
        let l: u32 = ld8(src, i) as u32
        i = i + 1
        if l == 128 as u32 {
            break
        }
        if l < 128 as u32 {
            var k: usize = 0
            while k <= (l as usize) && i < n {
                rt.buf_push(out, ld8(src, i))
                i = i + 1
                k = k + 1
            }
        } else {
            if i >= n {
                break
            }
            let v: u8 = ld8(src, i)
            i = i + 1
            var k2: usize = 0
            while k2 < 257 - (l as usize) {
                rt.buf_push(out, v)
                k2 = k2 + 1
            }
        }
    }
    return rt.buf_len(out) - before
}

fn f_lzw(src: u64, n: usize, out: *mut rt.Buf, early: u32) -> usize {
    let before: usize = rt.buf_len(out)
    var prev: [u32; 4096] = [0 as u32; 4096]
    var last: [u8; 4096] = [0 as u8; 4096]
    var lenv: [u32; 4096] = [0 as u32; 4096]
    var i: usize = 0
    while i < 256 {
        prev[i] = 4096 as u32
        last[i] = i as u8
        lenv[i] = 1 as u32
        i = i + 1
    }
    var next: usize = 258
    var width: usize = 9
    var bitpos: usize = 0
    var oldcode: i32 = -1
    var stack: [u8; 4096] = [0 as u8; 4096]
    let bits: usize = n * 8
    var guard: usize = 0
    while bitpos + width <= bits && guard < 20000000 {
        guard = guard + 1
        var code: u32 = 0
        var b: usize = 0
        while b < width {
            let bit: usize = bitpos + b
            let v: u32 = ((ld8(src, bit / 8) as u32) >> (7 - (bit % 8)) as u32)
            & 1 as u32
            code = (code << 1) | v
            b = b + 1
        }
        bitpos = bitpos + width
        if code == 256 as u32 {
            next = 258
            width = 9
            oldcode = -1
            continue
        }
        if code == 257 as u32 {
            break
        }
        var emit: u32 = code
        var first_extra: bool = false
        if code as usize >= next {
            if oldcode < 0 {
                break
            }
            emit = oldcode as u32
            first_extra = true
        }
        var sp: usize = 0
        var cur: u32 = emit
        var walk: usize = 0
        while cur < 4096 as u32 && walk < 4096 {
            stack[sp] = last[cur as usize]
            sp = sp + 1
            let pv: u32 = prev[cur as usize]
            if pv >= 4096 as u32 {
                break
            }
            cur = pv
            walk = walk + 1
        }
        var k: usize = sp
        while k > 0 {
            k = k - 1
            rt.buf_push(out, stack[k])
        }
        if first_extra {
            rt.buf_push(out, stack[sp - 1])
        }
        if oldcode >= 0 && next < 4096 {
            prev[next] = oldcode as u32
            last[next] = stack[sp - 1]
            lenv[next] = lenv[oldcode as usize] + 1 as u32
            next = next + 1
        }
        oldcode = code as i32
        var limit: usize = next
        if early != 0 as u32 {
            limit = next + 1
        }
        if limit > 511 && width == 9 {
            width = 10
        }
        if limit > 1023 && width == 10 {
            width = 11
        }
        if limit > 2047 && width == 11 {
            width = 12
        }
    }
    return rt.buf_len(out) - before
}

fn predict(buf: *mut rt.Buf, from: usize, pred: u32, colors: usize,
    bpc: usize, columns: usize) -> bool {
    if pred < 2 as u32 {
        return true
    }
    if colors == 0 || bpc == 0 || columns == 0 {
        return false
    }
    if colors > 32 || bpc > 16 || columns > 1000000 {
        return false
    }
    let bpp_bits: usize = colors * bpc
    var bpp: usize = bpp_bits / 8
    if bpp == 0 {
        bpp = 1
    }
    let rowlen: usize = (columns * colors * bpc + 7) / 8
    let p: u64 = rt.buf_ptr(buf)
    let total: usize = rt.buf_len(buf) - from
    if pred == 2 as u32 {
        if bpc != 8 {
            return true
        }
        var y: usize = 0
        while (y + 1) * rowlen <= total {
            let row: u64 = p + (from + y * rowlen) as u64
            var x: usize = colors
            while x < rowlen {
                let v: u32 = (ld8(row, x) as u32) + (ld8(row, x - colors) as u32)
                *((row + x as u64) as *mut u8) = (v & 255 as u32) as u8
                x = x + 1
            }
            y = y + 1
        }
        return true
    }
    let stride: usize = rowlen + 1
    let rows: usize = total / stride
    var y2: usize = 0
    var w: usize = from
    while y2 < rows {
        let rp: u64 = p + (from + y2 * stride) as u64
        let f: u32 = ld8(rp, 0) as u32
        var x: usize = 0
        while x < rowlen {
            let cur: u32 = ld8(rp, 1 + x) as u32
            var a: u32 = 0
            if x >= bpp {
                a = (*((p + (w + x - bpp) as u64) as *mut u8)) as u32
            }
            var b: u32 = 0
            if y2 > 0 {
                b = (*((p + (w - rowlen + x) as u64) as *mut u8)) as u32
            }
            var c: u32 = 0
            if y2 > 0 && x >= bpp {
                c = (*((p + (w - rowlen + x - bpp) as u64) as *mut u8)) as u32
            }
            var v: u32 = cur
            if f == 1 as u32 {
                v = (cur + a) & 255 as u32
            } else if f == 2 as u32 {
                v = (cur + b) & 255 as u32
            } else if f == 3 as u32 {
                v = (cur + (a + b) / 2) & 255 as u32
            } else if f == 4 as u32 {
                v = (cur + paeth(a as i32, b as i32, c as i32)) & 255 as u32
            }
            *((p + (w + x) as u64) as *mut u8) = v as u8
            x = x + 1
        }
        w = w + rowlen
        y2 = y2 + 1
    }
    rt.buf_set_len(buf, w)
    return true
}

#[no_gc]
fn paeth(a: i32, b: i32, c: i32) -> u32 {
    let pp: i32 = a + b - c
    var pa: i32 = pp - a
    if pa < 0 {
        pa = 0 - pa
    }
    var pb: i32 = pp - b
    if pb < 0 {
        pb = 0 - pb
    }
    var pc: i32 = pp - c
    if pc < 0 {
        pc = 0 - pc
    }
    if pa <= pb && pa <= pc {
        return a as u32
    }
    if pb <= pc {
        return b as u32
    }
    return c as u32
}
