#[no_gc]
fn pdffont_ptr(i: usize) -> u64 {
    return ((&PDFFONT_DATA[0]) as u64) + (PDFFONT_OFF[i] as u64)
}

#[no_gc]
fn pdffont_len(i: usize) -> usize {
    return PDFFONT_OFF[i + 1] - PDFFONT_OFF[i]
}
