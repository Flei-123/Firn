import std.rt
import docview.dvdoc

export { PageHash, page_hash, page_hash_line }

struct PageHash {
    ok: bool,
    kind: u32,
    pages: usize,
    w: i32,
    h: i32,
    ink: u64,
    hash: u64,
    text: u64,
}

fn page_hash(p: u64, n: usize, page: usize) -> PageHash {
    var r: PageHash = PageHash { ok: false, kind: 0 as u32, pages: 0, w: 0, h: 0, ink: 0 as u64, hash: 0 as u64, text: 0 as u64 }
    var d: dvdoc.Doc = dvdoc.doc_open(p, n)
    if !dvdoc.doc_ok(&d) {
        return r
    }
    r.kind = dvdoc.doc_kind(&d)
    r.pages = dvdoc.doc_pages(&d)
    var px: rt.Buf = rt.buf_new()
    if dvdoc.doc_render(&d, page, 1.0, &px, &r.w, &r.h) {
        var h: u64 = 14695981039346656037 as u64
        var i: usize = 0
        let len: usize = rt.buf_len(&px)
        while i < len {
            let v: u8 = rt.buf_at(&px, i)
            h = (h ^ (v as u64)) *% (1099511628211 as u64)
            if i % 4 == 0 && v < (250 as u8) {
                r.ink = r.ink + (1 as u64)
            }
            i = i + 1
        }
        r.hash = h
        r.ok = true
    }
    var tx: rt.Buf = rt.buf_new()
    if dvdoc.doc_text(&d, page, &tx) {
        var t: u64 = 14695981039346656037 as u64
        var k: usize = 0
        while k < rt.buf_len(&tx) {
            t = (t ^ (rt.buf_at(&tx, k) as u64)) *% (1099511628211 as u64)
            k = k + 1
        }
        r.text = t
    }
    rt.buf_free(&tx)
    rt.buf_free(&px)
    dvdoc.doc_free(&d)
    return r
}

fn page_hash_line(r: *mut PageHash, out: *mut rt.Buf) {
    rt.buf_push_dec_u64(out, (*r).kind as u64)
    rt.buf_push(out, 124 as u8)
    rt.buf_push_dec_u64(out, (*r).pages as u64)
    rt.buf_push(out, 124 as u8)
    rt.buf_push_dec_i64(out, (*r).w as i64)
    rt.buf_push(out, 124 as u8)
    rt.buf_push_dec_i64(out, (*r).h as i64)
    rt.buf_push(out, 124 as u8)
    rt.buf_push_dec_u64(out, (*r).ink)
    rt.buf_push(out, 124 as u8)
    rt.buf_push_hex_u64(out, (*r).hash, 16)
    rt.buf_push(out, 124 as u8)
    rt.buf_push_hex_u64(out, (*r).text, 16)
}
