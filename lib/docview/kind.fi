import highlight.highlight
import docview.dvbytes
import docview.kinds
import docview.magic
import docview.container

export { sniff, sniff_name, code_language, is_markdown_name }

fn is_markdown_name(name: str) -> bool {
    return dvbytes.ext_is(name, "md") || dvbytes.ext_is(name, "markdown") || dvbytes.ext_is(name, "mdown")
}

fn code_language(name: str) -> u32 {
    let l: u32 = highlight.hl_language(dvbytes.ext_of(name))
    if l == highlight.HL_MARKDOWN {
        return highlight.HL_NONE
    }
    return l
}

fn text_kind(name: str) -> u32 {
    if is_markdown_name(name) {
        return kinds.KIND_MARKDOWN
    }
    if code_language(name) != highlight.HL_NONE {
        return kinds.KIND_CODE
    }
    return kinds.KIND_TEXT
}

fn sniff(p: u64, n: usize, name: str) -> u32 {
    if n == 0 {
        return text_kind(name)
    }
    if container.is_zip(p, n) {
        return container.sniff_zip(p, n, name)
    }
    let m: u32 = magic.sniff_magic(p, n)
    if m != kinds.KIND_UNKNOWN {
        return m
    }
    if magic.looks_like_svg(p, n) {
        return kinds.KIND_SVG
    }
    if magic.looks_like_text(p, n) {
        return text_kind(name)
    }
    return kinds.KIND_UNKNOWN
}

fn sniff_name(name: str) -> u32 {
    if dvbytes.ext_is(name, "svg") { return kinds.KIND_SVG }
    return text_kind(name)
}
