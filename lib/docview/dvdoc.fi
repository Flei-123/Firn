// SPDX-License-Identifier: MPL-2.0
import std.rt
import docview.registry
import docview.kind
import docview.kinds
import docview.lazy

export {
    Doc, doc_empty, doc_open, doc_open_named, doc_open_kind, doc_ok, doc_kind, doc_family,
    doc_is_flow, doc_pages, doc_page_size, doc_render, doc_text, doc_free,
}

struct Doc {
    ok: bool,
    kind: u32,
    handle: u64,
    ops: registry.DocOps,
    pages: usize,
}

fn doc_empty() -> Doc {
    return Doc { ok: false, kind: kinds.KIND_UNKNOWN, handle: 0, ops: registry.ops_empty(), pages: 0 }
}

fn doc_open_kind(p: u64, n: usize, k: u32) -> Doc {
    var d: Doc = doc_empty()
    d.kind = k
    lazy.lazy_ensure_kind(k)
    let o: *mut registry.Opener = registry.find_by_kind(k)
    if (o as u64) == 0 {
        return d
    }
    let open: registry.OpenFn = (*o).ops.open
    let h: u64 = open(p, n)
    if h == 0 {
        return d
    }
    d.ops = (*o).ops
    d.handle = h
    d.ok = true
    let pages: registry.PagesFn = d.ops.pages
    d.pages = pages(h)
    return d
}

fn doc_open_named(p: u64, n: usize, name: str) -> Doc {
    return doc_open_kind(p, n, kind.sniff(p, n, name))
}

fn doc_open(p: u64, n: usize) -> Doc {
    return doc_open_named(p, n, "")
}

fn doc_ok(d: *mut Doc) -> bool {
    return (*d).ok
}

fn doc_kind(d: *mut Doc) -> u32 {
    return (*d).kind
}

fn doc_family(d: *mut Doc) -> u32 {
    return kinds.kind_family((*d).kind)
}

fn doc_is_flow(d: *mut Doc) -> bool {
    return kinds.kind_family((*d).kind) == kinds.FAMILY_TEXT
}

fn doc_pages(d: *mut Doc) -> usize {
    if !(*d).ok {
        return 0
    }
    return (*d).pages
}

fn doc_page_size(d: *mut Doc, page: usize, w: *mut i32, h: *mut i32) -> bool {
    *w = 0
    *h = 0
    if !(*d).ok || page >= (*d).pages {
        return false
    }
    let f: registry.SizeFn = (*d).ops.page_size
    return f((*d).handle, page, w, h)
}

fn doc_render(d: *mut Doc, page: usize, scale: f64, out: *mut rt.Buf, w: *mut i32, h: *mut i32) -> bool {
    *w = 0
    *h = 0
    rt.buf_clear(out)
    if !(*d).ok || page >= (*d).pages || !(scale > 0.0) {
        return false
    }
    let f: registry.RenderFn = (*d).ops.render
    return f((*d).handle, page, scale, out, w, h)
}

fn doc_text(d: *mut Doc, page: usize, out: *mut rt.Buf) -> bool {
    if !(*d).ok || page >= (*d).pages {
        return false
    }
    let f: registry.TextFn = (*d).ops.text
    return f((*d).handle, page, out)
}

fn doc_free(d: *mut Doc) {
    if (*d).ok {
        let f: registry.FreeFn = (*d).ops.free
        f((*d).handle)
    }
    (*d).ok = false
    (*d).handle = 0
    (*d).pages = 0
}
