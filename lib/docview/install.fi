import docview.lazy
import docview.kinds
import docview.flowdoc
import docview.imagedoc

export { install_builtin }

fn install_builtin() {
    lazy.lazy_register("flow.text", kinds.KIND_TEXT, flowdoc.flow_install_text)
    lazy.lazy_register("flow.code", kinds.KIND_CODE, flowdoc.flow_install_code)
    lazy.lazy_register("flow.markdown", kinds.KIND_MARKDOWN, flowdoc.flow_install_markdown)
    lazy.lazy_register("image.png", kinds.KIND_PNG, imagedoc.image_install_png)
    lazy.lazy_register("image.jpeg", kinds.KIND_JPEG, imagedoc.image_install_jpeg)
    lazy.lazy_register("image.webp", kinds.KIND_WEBP, imagedoc.image_install_webp)
    lazy.lazy_register("image.gif", kinds.KIND_GIF, imagedoc.image_install_gif)
}
