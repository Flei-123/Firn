// SPDX-License-Identifier: MPL-2.0
import std.rt

export { at, starts_with, starts_at, find_in, ext_of, ext_is, lower }

fn at(p: u64, n: usize, i: usize) -> u32 {
    if i >= n {
        return 256 as u32
    }
    return rt.ld8(p, i) as u32
}

fn lower(c: u8) -> u8 {
    if c >= 65 as u8 && c <= 90 as u8 {
        return c + 32 as u8
    }
    return c
}

fn starts_at(p: u64, n: usize, off: usize, tag: str) -> bool {
    if off + tag.n > n {
        return false
    }
    return rt.mem_eq(p + off as u64, tag.p as u64, tag.n)
}

fn starts_with(p: u64, n: usize, tag: str) -> bool {
    return starts_at(p, n, 0, tag)
}

fn find_in(p: u64, n: usize, limit: usize, tag: str) -> bool {
    var end: usize = n
    if limit < end {
        end = limit
    }
    if tag.n == 0 || end < tag.n {
        return false
    }
    var i: usize = 0
    while i + tag.n <= end {
        if rt.ld8(p, i) == rt.ld8(tag.p as u64, 0) && rt.mem_eq(p + i as u64, tag.p as u64, tag.n) {
            return true
        }
        i++
    }
    return false
}

fn ext_of(name: str) -> str {
    var i: usize = name.n
    while i > 0 {
        i--
        let c: u8 = rt.ld8(name.p as u64, i)
        if c == 46 as u8 {
            return str { p: (name.p as u64 + i as u64 + 1) as *mut u8, n: name.n - i - 1 }
        }
        if c == 47 as u8 || c == 92 as u8 {
            break
        }
    }
    return str { p: name.p, n: 0 }
}

fn ext_is(name: str, want: str) -> bool {
    let e: str = ext_of(name)
    if e.n != want.n {
        return false
    }
    var i: usize = 0
    while i < e.n {
        if lower(rt.ld8(e.p as u64, i)) != rt.ld8(want.p as u64, i) {
            return false
        }
        i++
    }
    return true
}
