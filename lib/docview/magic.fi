import docview.dvbytes
import docview.kinds

export { sniff_magic, looks_like_svg, looks_like_text, mp3_frame_ok }

fn mp3_frame_ok(p: u64, n: usize, off: usize) -> bool {
    let b1: u32 = dvbytes.at(p, n, off + 1)
    let b2: u32 = dvbytes.at(p, n, off + 2)
    if dvbytes.at(p, n, off) != 255 as u32 || b1 == 256 as u32 || b2 == 256 as u32 {
        return false
    }
    if (b1 & 224 as u32) != 224 as u32 {
        return false
    }
    if ((b1 >> 3) & 3 as u32) == 1 as u32 || ((b1 >> 1) & 3 as u32) == 0 as u32 {
        return false
    }
    if (b2 >> 4) == 15 as u32 || ((b2 >> 2) & 3 as u32) == 3 as u32 {
        return false
    }
    return true
}

fn brand_kind(p: u64, n: usize) -> u32 {
    if dvbytes.starts_at(p, n, 8, "avif") || dvbytes.starts_at(p, n, 8, "avis") {
        return kinds.KIND_AVIF
    }
    if dvbytes.starts_at(p, n, 8, "M4A ") || dvbytes.starts_at(p, n, 8, "M4B ") || dvbytes.starts_at(p, n, 8, "M4P ") {
        return kinds.KIND_M4A
    }
    if dvbytes.starts_at(p, n, 8, "heic") || dvbytes.starts_at(p, n, 8, "heix") || dvbytes.starts_at(p, n, 8, "mif1") {
        return kinds.KIND_UNKNOWN
    }
    return kinds.KIND_MP4
}

fn riff_kind(p: u64, n: usize) -> u32 {
    if dvbytes.starts_at(p, n, 8, "WEBP") { return kinds.KIND_WEBP }
    if dvbytes.starts_at(p, n, 8, "WAVE") { return kinds.KIND_WAV }
    return kinds.KIND_UNKNOWN
}

fn ogg_kind(p: u64, n: usize) -> u32 {
    if dvbytes.find_in(p, n, 80, "OpusHead") {
        return kinds.KIND_OPUS
    }
    return kinds.KIND_OGG
}

fn sniff_magic(p: u64, n: usize) -> u32 {
    if n < 4 {
        return kinds.KIND_UNKNOWN
    }
    if (dvbytes.at(p, n, 0) == 137 as u32 && dvbytes.starts_at(p, n, 1, "PNG")) { return kinds.KIND_PNG }
    if dvbytes.at(p, n, 0) == 255 as u32 && dvbytes.at(p, n, 1) == 216 as u32 && dvbytes.at(p, n, 2) == 255 as u32 {
        return kinds.KIND_JPEG
    }
    if dvbytes.starts_with(p, n, "GIF8") { return kinds.KIND_GIF }
    if dvbytes.starts_with(p, n, "RIFF") { return riff_kind(p, n) }
    if dvbytes.find_in(p, n, 1024, "%PDF-") && (dvbytes.starts_with(p, n, "%PDF-") || dvbytes.find_in(p, n, 1024, "\n%PDF-")) {
        return kinds.KIND_PDF
    }
    if dvbytes.at(p, n, 0) == 255 as u32 && dvbytes.at(p, n, 1) == 10 as u32 { return kinds.KIND_JXL }
    if dvbytes.starts_with(p, n, "\x00\x00\x00\x0cJXL ") { return kinds.KIND_JXL }
    if dvbytes.starts_at(p, n, 4, "ftyp") { return brand_kind(p, n) }
    if dvbytes.starts_with(p, n, "OggS") { return ogg_kind(p, n) }
    if dvbytes.starts_with(p, n, "fLaC") { return kinds.KIND_FLAC }
    if (dvbytes.at(p, n, 0) == 26 as u32 && dvbytes.at(p, n, 1) == 69 as u32 && dvbytes.at(p, n, 2) == 223 as u32 && dvbytes.at(p, n, 3) == 163 as u32) { return kinds.KIND_WEBM }
    if dvbytes.starts_with(p, n, "ID3") { return kinds.KIND_MP3 }
    if mp3_frame_ok(p, n, 0) { return kinds.KIND_MP3 }
    return kinds.KIND_UNKNOWN
}

fn looks_like_svg(p: u64, n: usize) -> bool {
    var i: usize = 0
    if (dvbytes.at(p, n, 0) == 239 as u32 && dvbytes.at(p, n, 1) == 187 as u32 && dvbytes.at(p, n, 2) == 191 as u32) {
        i = 3
    }
    while i < n && i < 64 {
        let c: u32 = dvbytes.at(p, n, i)
        if c == 32 as u32 || c == 9 as u32 || c == 10 as u32 || c == 13 as u32 {
            i++
        } else {
            break
        }
    }
    if dvbytes.starts_at(p, n, i, "<svg") {
        return true
    }
    if dvbytes.starts_at(p, n, i, "<?xml") || dvbytes.starts_at(p, n, i, "<!DOCTYPE svg") {
        return dvbytes.find_in(p, n, 4096, "<svg")
    }
    return false
}

fn looks_like_text(p: u64, n: usize) -> bool {
    var end: usize = n
    if end > 4096 {
        end = 4096
    }
    var i: usize = 0
    while i < end {
        let c: u32 = dvbytes.at(p, n, i)
        if c == 0 as u32 {
            return false
        }
        if c < 32 as u32 && c != 9 as u32 && c != 10 as u32 && c != 13 as u32 && c != 12 as u32 && c != 27 as u32 {
            return false
        }
        i++
    }
    return true
}
