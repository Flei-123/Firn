// SPDX-License-Identifier: MPL-2.0
import std.vec
import docview.doc

export {
    Strip, strip_new, strip_free, strip_build, strip_fit_zoom, strip_visible, strip_page_at, strip_y_of,
    strip_clamp_zoom, ZOOM_MIN, ZOOM_MAX,
}

const ZOOM_MIN: f64 = 0.1
const ZOOM_MAX: f64 = 8.0

struct Strip {
    ys: Vec[f64],
    ws: Vec[f64],
    hs: Vec[f64],
    total: f64,
    maxw: f64,
    zoom: f64,
    gap: f64,
    pad: f64,
}

fn strip_new() -> Strip {
    return Strip { ys: vec_new[f64](), ws: vec_new[f64](), hs: vec_new[f64](), total: 0.0, maxw: 0.0,
        zoom: 1.0, gap: 12.0, pad: 12.0 }
}

fn strip_free(s: *mut Strip) {
    vec_free[f64](&(*s).ys)
    vec_free[f64](&(*s).ws)
    vec_free[f64](&(*s).hs)
}

fn strip_clamp_zoom(z: f64) -> f64 {
    if !(z >= ZOOM_MIN) { return ZOOM_MIN }
    if z > ZOOM_MAX { return ZOOM_MAX }
    return z
}

fn strip_build(d: *mut doc.Doc, zoom: f64, gap: f64, pad: f64, s: *mut Strip) {
    vec_clear[f64](&(*s).ys)
    vec_clear[f64](&(*s).ws)
    vec_clear[f64](&(*s).hs)
    (*s).zoom = strip_clamp_zoom(zoom)
    (*s).gap = gap
    (*s).pad = pad
    (*s).maxw = 0.0
    var y: f64 = pad
    let n: usize = doc.doc_pages(d)
    var i: usize = 0
    while i < n {
        var w: i32 = 0
        var h: i32 = 0
        doc.doc_page_size(d, i, &w, &h)
        if w < 1 { w = 1 }
        if h < 1 { h = 1 }
        let sw: f64 = (w as f64) * (*s).zoom
        let sh: f64 = (h as f64) * (*s).zoom
        vec_push[f64](&(*s).ys, y)
        vec_push[f64](&(*s).ws, sw)
        vec_push[f64](&(*s).hs, sh)
        if sw > (*s).maxw { (*s).maxw = sw }
        y = y + sh + gap
        i++
    }
    (*s).total = y - gap + pad
    if n == 0 {
        (*s).total = 2.0 * pad
    }
}

fn strip_fit_zoom(d: *mut doc.Doc, view_w: f64, pad: f64) -> f64 {
    var widest: i32 = 1
    let n: usize = doc.doc_pages(d)
    var i: usize = 0
    while i < n {
        var w: i32 = 0
        var h: i32 = 0
        doc.doc_page_size(d, i, &w, &h)
        if w > widest { widest = w }
        i++
    }
    return strip_clamp_zoom((view_w - 2.0 * pad) / (widest as f64))
}

fn strip_y_of(s: *mut Strip, page: usize) -> f64 {
    if page >= vec_len[f64](&(*s).ys) {
        return 0.0
    }
    return (*vec_elem_ptr[f64](&(*s).ys, page))
}

fn strip_page_at(s: *mut Strip, y: f64) -> usize {
    let n: usize = vec_len[f64](&(*s).ys)
    if n == 0 {
        return 0
    }
    var lo: usize = 0
    var hi: usize = n
    while lo + 1 < hi {
        let mid: usize = (lo + hi) / 2
        if (*vec_elem_ptr[f64](&(*s).ys, mid)) <= y {
            lo = mid
        } else {
            hi = mid
        }
    }
    return lo
}

fn strip_visible(s: *mut Strip, scroll: f64, view_h: f64, first: *mut usize, last: *mut usize) -> bool {
    let n: usize = vec_len[f64](&(*s).ys)
    *first = 0
    *last = 0
    if n == 0 {
        return false
    }
    var a: usize = strip_page_at(s, scroll)
    let b: usize = strip_page_at(s, scroll + view_h)
    if (*vec_elem_ptr[f64](&(*s).ys, a)) + (*vec_elem_ptr[f64](&(*s).hs, a)) < scroll && a + 1 < n {
        a++
    }
    *first = a
    *last = b
    if *last < *first {
        *last = *first
    }
    return true
}
