// SPDX-License-Identifier: MPL-2.0
import std.vec
import std.rt
import docview.registry
import docview.bytes

export { LazyEntry, lazy_register, lazy_ensure_kind, lazy_ensure_name, lazy_count, lazy_reset }

type InitFn = fn()

struct LazyEntry {
    name: str,
    kind: u32,
    init: InitFn,
    loaded: bool,
}

static mut table: Vec[LazyEntry] = Vec[LazyEntry] { ptr: 0, len: 0, cap: 0 }

fn same(a: str, b: str) -> bool {
    return a.n == b.n && rt_eq(a, b)
}

fn rt_eq(a: str, b: str) -> bool {
    return bytes.starts_with(a.p as u64, a.n, b)
}

fn lazy_register(name: str, kind: u32, init: InitFn) -> bool {
    var i: usize = 0
    while i < vec_len[LazyEntry](&table) {
        let e: *mut LazyEntry = vec_elem_ptr[LazyEntry](&table, i)
        if same((*e).name, name) {
            (*e).kind = kind
            (*e).init = init
            (*e).loaded = false
            return true
        }
        i++
    }
    return vec_push[LazyEntry](&table, LazyEntry { name: name, kind: kind, init: init, loaded: false })
}

fn run_entry(e: *mut LazyEntry) {
    if !(*e).loaded {
        (*e).loaded = true
        let f: InitFn = (*e).init
        f()
    }
}

fn lazy_ensure_kind(kind: u32) -> bool {
    var i: usize = 0
    while i < vec_len[LazyEntry](&table) {
        let e: *mut LazyEntry = vec_elem_ptr[LazyEntry](&table, i)
        if (*e).kind == kind {
            run_entry(e)
        }
        i++
    }
    return registry.has_kind(kind)
}

fn lazy_ensure_name(name: str) -> bool {
    var i: usize = 0
    while i < vec_len[LazyEntry](&table) {
        let e: *mut LazyEntry = vec_elem_ptr[LazyEntry](&table, i)
        if same((*e).name, name) {
            run_entry(e)
            return true
        }
        i++
    }
    return false
}

fn lazy_count() -> usize {
    return vec_len[LazyEntry](&table)
}

fn lazy_reset() {
    vec_clear[LazyEntry](&table)
}
