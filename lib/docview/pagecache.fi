// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.vec
import docview.doc

export { Entry, PageCache, cache_new, cache_free, cache_clear, cache_get, cache_count, cache_renders }

struct Entry {
    page: usize,
    key: u32,
    w: i32,
    h: i32,
    px: rt.Buf,
    stamp: u64,
}

struct PageCache {
    entries: Vec[Entry],
    cap: usize,
    clock: u64,
    renders: u64,
}

fn cache_new(cap: usize) -> PageCache {
    var c: usize = cap
    if c < 1 { c = 1 }
    return PageCache { entries: vec_new[Entry](), cap: c, clock: 0, renders: 0 }
}

fn cache_clear(c: *mut PageCache) {
    var i: usize = 0
    while i < vec_len[Entry](&(*c).entries) {
        rt.buf_free(&(*vec_elem_ptr[Entry](&(*c).entries, i)).px)
        i++
    }
    vec_clear[Entry](&(*c).entries)
}

fn cache_free(c: *mut PageCache) {
    cache_clear(c)
    vec_free[Entry](&(*c).entries)
}

fn cache_count(c: *mut PageCache) -> usize {
    return vec_len[Entry](&(*c).entries)
}

fn cache_renders(c: *mut PageCache) -> u64 {
    return (*c).renders
}

fn key_of(scale: f64) -> u32 {
    var k: f64 = scale * 1000.0 + 0.5
    if k < 1.0 { k = 1.0 }
    if k > 4000000000.0 { k = 4000000000.0 }
    return k as u32
}

fn find(c: *mut PageCache, page: usize, key: u32) -> i64 {
    var i: usize = 0
    while i < vec_len[Entry](&(*c).entries) {
        let e: *mut Entry = vec_elem_ptr[Entry](&(*c).entries, i)
        if (*e).page == page && (*e).key == key {
            return i as i64
        }
        i++
    }
    return -1
}

fn oldest(c: *mut PageCache) -> usize {
    var best: usize = 0
    var i: usize = 1
    while i < vec_len[Entry](&(*c).entries) {
        if (*vec_elem_ptr[Entry](&(*c).entries, i)).stamp < (*vec_elem_ptr[Entry](&(*c).entries, best)).stamp {
            best = i
        }
        i++
    }
    return best
}

fn cache_get(c: *mut PageCache, d: *mut doc.Doc, page: usize, scale: f64) -> *mut Entry {
    let key: u32 = key_of(scale)
    (*c).clock = (*c).clock + 1
    let at: i64 = find(c, page, key)
    if at >= 0 {
        let e: *mut Entry = vec_elem_ptr[Entry](&(*c).entries, at as usize)
        (*e).stamp = (*c).clock
        return e
    }
    var px: rt.Buf = rt.buf_new()
    var w: i32 = 0
    var h: i32 = 0
    if !doc.doc_render(d, page, scale, &px, &w, &h) {
        rt.buf_free(&px)
        return 0 as *mut Entry
    }
    (*c).renders = (*c).renders + 1
    let fresh: Entry = Entry { page: page, key: key, w: w, h: h, px: px, stamp: (*c).clock }
    if vec_len[Entry](&(*c).entries) >= (*c).cap {
        let o: usize = oldest(c)
        let old: *mut Entry = vec_elem_ptr[Entry](&(*c).entries, o)
        rt.buf_free(&(*old).px)
        *old = fresh
        return old
    }
    vec_push[Entry](&(*c).entries, fresh)
    return vec_elem_ptr[Entry](&(*c).entries, vec_len[Entry](&(*c).entries) - 1)
}
