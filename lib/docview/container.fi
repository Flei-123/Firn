import zip.zip
import docview.dvbytes
import docview.kinds

export { sniff_zip, is_zip }

fn is_zip(p: u64, n: usize) -> bool {
    return dvbytes.starts_with(p, n, "PK\x03\x04") || dvbytes.starts_with(p, n, "PK\x05\x06")
}

fn kind_of_entries(z: *mut zip.ZipReader, name: str) -> u32 {
    if zip.zip_find(z, "word/document.xml") >= 0 { return kinds.KIND_DOCX }
    if zip.zip_find(z, "xl/workbook.xml") >= 0 { return kinds.KIND_XLSX }
    if zip.zip_find(z, "ppt/presentation.xml") >= 0 { return kinds.KIND_PPTX }
    if zip.zip_find(z, "content.xml") >= 0 && zip.zip_find(z, "mimetype") >= 0 {
        if !dvbytes.ext_is(name, "ods") && !dvbytes.ext_is(name, "odp") {
            return kinds.KIND_ODT
        }
    }
    return kinds.KIND_ZIP
}

fn sniff_zip(p: u64, n: usize, name: str) -> u32 {
    var z: zip.ZipReader = zip.zip_reader_open(p, n) catch | e | (zip.zip_reader_empty())
    let kind: u32 = kind_of_entries(&z, name)
    zip.zip_reader_free(&z)
    return kind
}
