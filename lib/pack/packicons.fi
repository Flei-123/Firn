// SPDX-License-Identifier: MPL-2.0
// lib/pack/icons.fi -- the formats of an application icon, written in Firn:
// a PNG encoder, a resampler, Windows .ico and macOS .icns containers.
//
// WHERE THE PIXELS COME FROM is not here: tools/pack/icons.fi draws an SVG
// with lib/svg (every size from the vector, sharp) or reads a PNG with
// lib/paint/png.fi and resamples it with `resample` below. This file takes
// STRAIGHT (not premultiplied) RGBA octets, 4 per pixel, R G B A.
//
//   png_encode(rgba, w, h, out)       RGBA 8 bit, filter "Sub", zlib level 6
//   resample(src, sw, sh, dst, dw, dh) premultiplied tent filter: sharp
//                                      down, smooth up, no halo at the edge
//   iconset_new / iconset_add          PNG files by pixel size
//   ico_build(set, out)                .ico: PNG-compressed entries, 16..256
//   icns_build(set, out)               .icns: PNG entries (icp4..ic14)
//
// WHY PNG INSIDE .ico: since Windows Vista an icon directory entry may hold
// a whole PNG file, and 256x256 MUST (the old BMP form would be 256 KiB
// uncompressed). Windows XP does not read them; Firn's Windows target is 10+.
//
// WHY PNG INSIDE .icns: macOS 10.7+ reads `icp4/icp5/icp6` (16/32/64) and
// `ic07..ic14` (128..1024, and the @2x forms) as PNG data; the older
// run-length RGB forms are not written.
import std.rt
import std.deflate

export {
    png_encode, resample,
    IconSet, iconset_new, iconset_free, iconset_add, iconset_count, iconset_size,
    iconset_find, ico_build, icns_build, fit_square,
}

const SET_MAX: usize = 24

struct IconSet {
    n: usize,
    size: [u32; 24],
    off: [usize; 24],
    len: [usize; 24],
    blob: rt.Buf,
}

fn iconset_new() -> IconSet {
    return IconSet { n: 0, size: [0 as u32; 24], off: [0; 24], len: [0; 24], blob: rt.buf_new() }
}

fn iconset_free(s: *mut IconSet) {
    rt.buf_free(&(*s).blob)
    (*s).n = 0
}

fn iconset_count(s: *mut IconSet) -> usize {
    return (*s).n
}

fn iconset_size(s: *mut IconSet, i: usize) -> u32 {
    return (*s).size[i]
}

// the index of the entry with this pixel size, or -1
fn iconset_find(s: *mut IconSet, size: u32) -> i64 {
    var i: usize = 0
    while i < (*s).n {
        if (*s).size[i] == size {
            return i as i64
        }
        i = i + 1
    }
    return -1
}

// A PNG file of size x size pixels. A size twice is refused.
fn iconset_add(s: *mut IconSet, size: u32, png: u64, n: usize) -> bool {
    if (*s).n >= SET_MAX || iconset_find(s, size) >= 0 {
        return false
    }
    let i: usize = (*s).n
    (*s).size[i] = size
    (*s).off[i] = rt.buf_len(&(*s).blob)
    (*s).len[i] = n
    rt.buf_push_bytes(&(*s).blob, png, n)
    (*s).n = i + 1
    return true
}

// ------------------------------------------------------------------ bytes

fn le16(b: *mut rt.Buf, v: u32) {
    rt.buf_push(b, (v & 255 as u32) as u8)
    rt.buf_push(b, ((v >> 8) & 255 as u32) as u8)
}

fn le32(b: *mut rt.Buf, v: u32) {
    le16(b, v & 65535 as u32)
    le16(b, v >> 16)
}

fn be32(b: *mut rt.Buf, v: u32) {
    rt.buf_push(b, ((v >> 24) & 255 as u32) as u8)
    rt.buf_push(b, ((v >> 16) & 255 as u32) as u8)
    rt.buf_push(b, ((v >> 8) & 255 as u32) as u8)
    rt.buf_push(b, (v & 255 as u32) as u8)
}

fn tag(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, 4)
}

// ------------------------------------------------------------------- PNG

fn png_chunk(out: *mut rt.Buf, name: str, p: u64, n: usize) {
    be32(out, n as u32)
    let start: usize = rt.buf_len(out)
    tag(out, name)
    rt.buf_push_bytes(out, p, n)
    be32(out, deflate.crc32(rt.buf_ptr(out) + start as u64, 4 + n))
}

// RGBA straight, 8 bit; false when the size is zero or the compressor fails
fn png_encode(rgba: u64, w: usize, h: usize, out: *mut rt.Buf) -> bool {
    if w == 0 || h == 0 {
        return false
    }
    let stride: usize = w * 4
    var raw: rt.Buf = rt.buf_new()
    rt.buf_reserve(&raw, (stride + 1) * h)
    var y: usize = 0
    while y < h {
        rt.buf_push(&raw, 1 as u8) // filter Sub
        var i: usize = 0
        while i < stride {
            let cur: u32 = rt.ld8(rgba, y * stride + i) as u32
            var left: u32 = 0 as u32
            if i >= 4 {
                left = rt.ld8(rgba, y * stride + i - 4) as u32
            }
            rt.buf_push(&raw, ((cur + 256 as u32 - left) & 255 as u32) as u8)
            i = i + 1
        }
        y = y + 1
    }
    var z: rt.Buf = rt.buf_new()
    let zn: usize = deflate.zlib_compress(rt.buf_ptr(&raw), rt.buf_len(&raw), 6, &z) catch 0
    rt.buf_free(&raw)
    if zn == 0 {
        rt.buf_free(&z)
        return false
    }
    let sig: [u8; 8] = [137 as u8, 80 as u8, 78 as u8, 71 as u8, 13 as u8, 10 as u8, 26 as u8, 10 as u8]
    var k: usize = 0
    while k < 8 {
        rt.buf_push(out, sig[k])
        k = k + 1
    }
    var ihdr: rt.Buf = rt.buf_new()
    be32(&ihdr, w as u32)
    be32(&ihdr, h as u32)
    rt.buf_push(&ihdr, 8 as u8)
    rt.buf_push(&ihdr, 6 as u8)
    rt.buf_push(&ihdr, 0 as u8)
    rt.buf_push(&ihdr, 0 as u8)
    rt.buf_push(&ihdr, 0 as u8)
    png_chunk(out, "IHDR", rt.buf_ptr(&ihdr), 13)
    png_chunk(out, "IDAT", rt.buf_ptr(&z), rt.buf_len(&z))
    png_chunk(out, "IEND", 0 as u64, 0)
    rt.buf_free(&ihdr)
    rt.buf_free(&z)
    return true
}

// -------------------------------------------------------------- resampling

fn fmax(a: f64, b: f64) -> f64 {
    if a > b { return a }
    return b
}

fn fabs(a: f64) -> f64 {
    if a < 0.0 { return 0.0 - a }
    return a
}

fn px_f(p: u64, i: usize) -> f64 {
    return rt.ld8(p, i) as f64
}

// One output pixel needs the source pixels within `support` of its centre,
// weighted by a tent (triangle) of that half width, and the colour channels
// weighted by alpha as well (premultiplied averaging) -- so that a
// transparent pixel's hidden colour never leaks into the edge.
// Down: support = scale (a tent as wide as the step: an area filter).
// Up: support = 1 (bilinear).
fn resample(src: u64, sw: usize, sh: usize, dst: *mut rt.Buf, dw: usize, dh: usize) -> bool {
    if sw == 0 || sh == 0 || dw == 0 || dh == 0 {
        return false
    }
    rt.buf_clear(dst)
    rt.buf_reserve(dst, dw * dh * 4)
    let sx: f64 = (sw as f64) / (dw as f64)
    let sy: f64 = (sh as f64) / (dh as f64)
    let supx: f64 = fmax(1.0, sx)
    let supy: f64 = fmax(1.0, sy)
    var dy: usize = 0
    while dy < dh {
        let cy: f64 = ((dy as f64) + 0.5) * sy
        var y0: i64 = (cy - supy) as i64
        if cy - supy < 0.0 { y0 = 0 }
        var y1: i64 = (cy + supy) as i64 + 1
        if y1 > sh as i64 { y1 = sh as i64 }
        var dx: usize = 0
        while dx < dw {
            let cx: f64 = ((dx as f64) + 0.5) * sx
            var x0: i64 = (cx - supx) as i64
            if cx - supx < 0.0 { x0 = 0 }
            var x1: i64 = (cx + supx) as i64 + 1
            if x1 > sw as i64 { x1 = sw as i64 }
            var wr: f64 = 0.0
            var wg: f64 = 0.0
            var wb: f64 = 0.0
            var wa: f64 = 0.0
            var wsum: f64 = 0.0
            var yy: i64 = y0
            while yy < y1 {
                let ty: f64 = 1.0 - (fabs(((yy as f64) + 0.5) - cy) / supy)
                if ty > 0.0 {
                    var xx: i64 = x0
                    while xx < x1 {
                        let tx: f64 = 1.0 - (fabs(((xx as f64) + 0.5) - cx) / supx)
                        if tx > 0.0 {
                            let w: f64 = tx * ty
                            let o: usize = ((yy as usize) * sw + (xx as usize)) * 4
                            let a: f64 = px_f(src, o + 3)
                            wr = wr + w * a * px_f(src, o)
                            wg = wg + w * a * px_f(src, o + 1)
                            wb = wb + w * a * px_f(src, o + 2)
                            wa = wa + w * a
                            wsum = wsum + w
                        }
                        xx = xx + 1
                    }
                }
                yy = yy + 1
            }
            var r: f64 = 0.0
            var g: f64 = 0.0
            var b: f64 = 0.0
            var a2: f64 = 0.0
            if wsum > 0.0 {
                a2 = wa / wsum
            }
            if wa > 0.0 {
                r = wr / wa
                g = wg / wa
                b = wb / wa
            }
            rt.buf_push(dst, clamp8(r))
            rt.buf_push(dst, clamp8(g))
            rt.buf_push(dst, clamp8(b))
            rt.buf_push(dst, clamp8(a2))
            dx = dx + 1
        }
        dy = dy + 1
    }
    return true
}

fn clamp8(v: f64) -> u8 {
    if v <= 0.0 { return 0 as u8 }
    if v >= 255.0 { return 255 as u8 }
    return (v + 0.5) as u8
}

// Centre a w x h picture on a transparent square of side max(w, h).
// Returns the side; `out` receives side*side*4 octets.
fn fit_square(src: u64, w: usize, h: usize, out: *mut rt.Buf) -> usize {
    var side: usize = w
    if h > side { side = h }
    rt.buf_clear(out)
    rt.buf_reserve(out, side * side * 4)
    let ox: usize = (side - w) / 2
    let oy: usize = (side - h) / 2
    var y: usize = 0
    while y < side {
        var x: usize = 0
        while x < side {
            if x >= ox && x < ox + w && y >= oy && y < oy + h {
                let o: usize = ((y - oy) * w + (x - ox)) * 4
                rt.buf_push(out, rt.ld8(src, o))
                rt.buf_push(out, rt.ld8(src, o + 1))
                rt.buf_push(out, rt.ld8(src, o + 2))
                rt.buf_push(out, rt.ld8(src, o + 3))
            } else {
                rt.buf_push(out, 0 as u8)
                rt.buf_push(out, 0 as u8)
                rt.buf_push(out, 0 as u8)
                rt.buf_push(out, 0 as u8)
            }
            x = x + 1
        }
        y = y + 1
    }
    return side
}

// -------------------------------------------------------------------- ICO

// Windows icon: ICONDIR + one ICONDIRENTRY per size (<= 256) + the PNGs.
// False when no entry is small enough.
fn ico_build(s: *mut IconSet, out: *mut rt.Buf) -> bool {
    var order: [usize; 24] = [0; 24]
    var cnt: usize = 0
    var i: usize = 0
    while i < (*s).n {
        if (*s).size[i] <= 256 as u32 {
            order[cnt] = i
            cnt = cnt + 1
        }
        i = i + 1
    }
    if cnt == 0 {
        return false
    }
    // ascending by size (insertion sort)
    var a: usize = 1
    while a < cnt {
        let v: usize = order[a]
        var b: usize = a
        while b > 0 && (*s).size[order[b - 1]] > (*s).size[v] {
            order[b] = order[b - 1]
            b = b - 1
        }
        order[b] = v
        a = a + 1
    }
    rt.buf_clear(out)
    le16(out, 0 as u32)
    le16(out, 1 as u32)
    le16(out, cnt as u32)
    var off: usize = 6 + cnt * 16
    var k: usize = 0
    while k < cnt {
        let e: usize = order[k]
        let sz: u32 = (*s).size[e]
        var wb: u32 = sz
        if sz == 256 as u32 { wb = 0 as u32 }
        rt.buf_push(out, wb as u8)
        rt.buf_push(out, wb as u8)
        rt.buf_push(out, 0 as u8) // colours
        rt.buf_push(out, 0 as u8)
        le16(out, 1 as u32) // planes
        le16(out, 32 as u32) // bits per pixel
        le32(out, (*s).len[e] as u32)
        le32(out, off as u32)
        off = off + (*s).len[e]
        k = k + 1
    }
    k = 0
    while k < cnt {
        let e: usize = order[k]
        rt.buf_push_bytes(out, rt.buf_ptr(&(*s).blob) + (*s).off[e] as u64, (*s).len[e])
        k = k + 1
    }
    return true
}

// ------------------------------------------------------------------- ICNS

fn icns_entry(out: *mut rt.Buf, s: *mut IconSet, name: str, size: u32) {
    let i: i64 = iconset_find(s, size)
    if i < 0 {
        return
    }
    let e: usize = i as usize
    tag(out, name)
    be32(out, (8 + (*s).len[e]) as u32)
    rt.buf_push_bytes(out, rt.buf_ptr(&(*s).blob) + (*s).off[e] as u64, (*s).len[e])
}

// macOS icon: 'icns', the total length, then (type, length, PNG) per entry.
// False when none of the sizes 16..1024 is in the set.
fn icns_build(s: *mut IconSet, out: *mut rt.Buf) -> bool {
    rt.buf_clear(out)
    tag(out, "icns")
    be32(out, 0 as u32)
    icns_entry(out, s, "icp4", 16 as u32)
    icns_entry(out, s, "icp5", 32 as u32)
    icns_entry(out, s, "icp6", 64 as u32)
    icns_entry(out, s, "ic07", 128 as u32)
    icns_entry(out, s, "ic08", 256 as u32)
    icns_entry(out, s, "ic09", 512 as u32)
    icns_entry(out, s, "ic10", 1024 as u32)
    icns_entry(out, s, "ic11", 32 as u32) // 16x16 @2x
    icns_entry(out, s, "ic12", 64 as u32) // 32x32 @2x
    icns_entry(out, s, "ic13", 256 as u32) // 128x128 @2x
    icns_entry(out, s, "ic14", 512 as u32) // 256x256 @2x
    if rt.buf_len(out) == 8 {
        return false
    }
    let total: usize = rt.buf_len(out)
    let p: u64 = rt.buf_ptr(out)
    rt.st8(p, 4, ((total >> 24) & 255) as u8)
    rt.st8(p, 5, ((total >> 16) & 255) as u8)
    rt.st8(p, 6, ((total >> 8) & 255) as u8)
    rt.st8(p, 7, (total & 255) as u8)
    return true
}
