export { broadcast_font_change, available }

extern fn SendMessageTimeoutW(hwnd: i64, msg: i64, wparam: i64, lparam: i64, flags: i64,
    timeout: i64, result: u64) -> i64;

const HWND_BROADCAST: i64 = 65535
const WM_FONTCHANGE: i64 = 29
const SMTO_ABORTIFHUNG: i64 = 2
const TIMEOUT_MS: i64 = 1500

fn available() -> bool {
    return true
}

fn broadcast_font_change() -> bool {
    var result: i64 = 0
    let r: i64 = SendMessageTimeoutW(HWND_BROADCAST, WM_FONTCHANGE, 0, 0, SMTO_ABORTIFHUNG,
        TIMEOUT_MS, (&result) as u64)
    return r != 0
}
