// SPDX-License-Identifier: MPL-2.0
// lib/pack/installed.fi -- what an installed program tells the system after
// it updated itself: the version in "Apps & features".
//
// A program installed by the Firn installer (lib/pack/install.fi) has an
// entry under HKCU\Software\Microsoft\Windows\CurrentVersion\Uninstall\<id>.
// appkit replaces the program file in place, so the entry's DisplayVersion
// would stay at the old number; `sync_version` rewrites it. Call it once per
// start after `update_mark_healthy` (templates/app/src/ui.fi does):
//
//     installed.sync_version(appinfo.app_id(), appinfo.app_version())
//
// It does nothing -- and costs one failed registry open -- when there is no
// such entry (a portable copy, a program that was never installed), and
// nothing at all off Windows (lib/pack/winreg.fi answers false).
import pack.winreg

export { sync_version }

const UNINSTALL_ROOT: str = "Software/Microsoft/Windows/CurrentVersion/Uninstall/"

fn sync_version(id: str, version: str) -> bool {
    let key: str = UNINSTALL_ROOT + id
    if !winreg.reg_key_exists(key) {
        return false
    }
    return winreg.reg_set_string(key, "DisplayVersion", version)
}
