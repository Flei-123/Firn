import std.rt
import std.fs
import std.process
import appkit.platform
import appkit.util

export { env_get, parent_of, write_bytes, write_text, read_text, remove_quiet, spawn_detached, spawn_hidden }

fn env_get(name: str) -> str {
    var b: rt.Buf = rt.buf_new()
    var r: str = ""
    if platform.plat_env_get(name, &b) && rt.buf_len(&b) > 0 {
        r = util.buf_to_str_copy(&b)
    }
    rt.buf_free(&b)
    return r
}

fn parent_of(path: str) -> str {
    let i: usize = util.rfind_byte(path, 47 as u8)
    if i >= path.n {
        return ""
    }
    return str { p: path.p, n: i }
}

fn write_bytes(path: str, p: u64, n: usize) -> bool {
    let dir: str = parent_of(path)
    if dir.n > 0 {
        fs.mkdir_all(dir) catch false
    }
    let w: usize = fs.write_file(path, p, n) catch 0
    return w == n
}

fn write_text(path: str, text: str) -> bool {
    return write_bytes(path, text.p as u64, text.n)
}

fn read_text(path: str) -> str {
    var b: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(path, &b) catch 0
    var r: str = ""
    if n > 0 {
        r = util.buf_to_str_copy(&b)
    }
    rt.buf_free(&b)
    return r
}

fn remove_quiet(path: str) -> bool {
    if !fs.exists(path) {
        return true
    }
    return fs.remove(path) catch false
}

fn spawn_fail(e: ProcError, failed: *mut bool) -> process.Child {
    *failed = true
    return process.Child { pid: 0, h: 0, in_fd: -1, out_fd: -1, err_fd: -1,
        done: true, code: 0, sig: 0, own: false }
}

fn spawn_with(program: str, arg1: str, arg2: str, cwd: str, hidden: bool) -> bool {
    var c: process.Command = process.command(program)
    if arg1.n > 0 {
        process.add_arg(&c, arg1)
    }
    if arg2.n > 0 {
        process.add_arg(&c, arg2)
    }
    if cwd.n > 0 {
        process.set_cwd(&c, cwd)
    }
    process.set_detach(&c, true)
    if hidden {
        process.set_no_window(&c, true)
    }
    var failed: bool = false
    process.spawn(&c) catch | e | (spawn_fail(e, &failed))
    process.command_free(&c)
    return !failed
}

fn spawn_detached(program: str, arg1: str, arg2: str, cwd: str) -> bool {
    return spawn_with(program, arg1, arg2, cwd, false)
}

fn spawn_hidden(program: str, arg1: str, arg2: str) -> bool {
    return spawn_with(program, arg1, arg2, "", true)
}
