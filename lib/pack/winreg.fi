// SPDX-License-Identifier: MPL-2.0
// lib/pack/winreg.fi -- the Windows registry (HKEY_CURRENT_USER), the part
// an installer needs: write a string or a number, read them, delete a key.
//
// THIS FILE IS THE NON-WINDOWS TWIN: every call answers false. The compiler
// picks lib/pack/winreg.windows.fi for `--target=x86_64-windows` (the module
// twin rule, compiler/src/modules.rs); both export the same names, so a
// program that imports `pack.winreg` builds for either and the installer's
// logic can be run (and tested) on Linux with the registry steps skipped.
//
// KEYS are paths below HKCU with backslashes or slashes
// (`Software\Microsoft\Windows\CurrentVersion\Uninstall\myapp`). Values are
// UTF-8 here and UTF-16 in the registry.
import std.rt

export {
    reg_available, reg_set_string, reg_set_expand, reg_set_dword,
    reg_get_string, reg_get_dword, reg_delete_tree, reg_key_exists, shell_changed,
}

fn reg_available() -> bool {
    return false
}

fn reg_set_string(key: str, name: str, value: str) -> bool {
    return false
}

fn reg_set_expand(key: str, name: str, value: str) -> bool {
    return false
}

fn reg_set_dword(key: str, name: str, value: u32) -> bool {
    return false
}

// the value appended to `out` (UTF-8); false when there is none
fn reg_get_string(key: str, name: str, out: *mut rt.Buf) -> bool {
    return false
}

fn reg_get_dword(key: str, name: str, out: *mut u32) -> bool {
    return false
}

// remove the key and everything below it; true when it is gone afterwards
fn reg_delete_tree(key: str) -> bool {
    return false
}

fn reg_key_exists(key: str) -> bool {
    return false
}

// tell Explorer that shortcuts changed (SHChangeNotify SHCNE_ASSOCCHANGED); no-op here
fn shell_changed() {
}
