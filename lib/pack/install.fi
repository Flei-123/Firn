// SPDX-License-Identifier: MPL-2.0
// lib/pack/install.fi -- what a Windows installer does, as a state machine
// a window (or a console) can drive one step at a time, and the uninstaller.
//
//   var in: install.Installer = install.inst_new(&log)
//   install.inst_open(&in, exe_p, exe_n, "C:/Apps/My App", true, true)   // checks the payload
//   while install.inst_step(&in) < install.PH_DONE { draw(install.inst_permille(&in)) }
//
// WHAT AN INSTALL IS (all of it in the user's profile, no administrator):
//   1. the payload zip (payload.fi) is checked: trailer, length, SHA-256;
//      every name is judged before the first byte is written (std.safefs:
//      no `..`, no drive letters, no reserved device names, no duplicates)
//   2. the files are written one entry per step into the install directory
//      (default %LOCALAPPDATA%\Programs\<name>); a file that is in use makes
//      the step fail with the file's name
//   3. files an OLDER install of the same program had and this one does not
//      are removed (upgrade in place); data outside the directory is never
//      touched
//   4. `uninstall.exe` = this installer without payload is written next to
//      the program; `.pack/install.txt` lists every file, folder and
//      shortcut that was made -- the uninstaller removes exactly those
//   5. shortcuts (.lnk, lib/pack/lnk.fi) in the Start Menu and optionally on
//      the Desktop; Explorer is told (SHChangeNotify) -- Windows only
//   6. HKCU\Software\Microsoft\Windows\CurrentVersion\Uninstall\<id>: the
//      "Apps & features" entry (DisplayName, DisplayVersion, Publisher,
//      InstallLocation, DisplayIcon, UninstallString, QuietUninstallString,
//      EstimatedSize, InstallDate, NoModify, NoRepair) -- Windows only
//
// UPDATES (appkit): the program lives in a folder the user owns, so
// appkit's rename-based self-update works there unchanged; after an update
// `sync_version` rewrites DisplayVersion so "Apps & features" is right.
//
// UNINSTALL. A running program cannot delete itself on Windows, so
// `uninstall.exe` copies itself to the temp folder and starts that copy
// (`/uninstall-stage2 <dir>`); the copy removes everything, then asks cmd.exe
// to delete the copy once it has ended. Only what `install.txt` lists is
// removed; a folder that still holds other files stays.
//
// NOT SEEN ON A REAL WINDOWS (Wine only): the sequence is tested under Wine
// (tools/pack/test_windows.sh), including the registry entry and the removal.
import std.rt
import std.fs
import std.osinfo
import std.safefs
import std.time
import std.process
import zip.zip
import appkit.util
import appkit.platform
import pack.lnk
import pack.winreg
import pack.payload

export {
    Logger, logger_new, logline,
    Installer, inst_new, inst_open, inst_begin, inst_step, inst_permille, inst_error, inst_free, inst_launch,
    PH_EXTRACT, PH_FINISH, PH_DONE, PH_FAILED,
    default_dir, manifest_field, uninstall_run, uninstall_start, sync_version, winpath, fpath, uninstall_key, current_install_dir,
}

const PH_EXTRACT: u32 = 0
const PH_FINISH: u32 = 1
const PH_DONE: u32 = 2
const PH_FAILED: u32 = 3

const UNINSTALL_ROOT: str = "Software/Microsoft/Windows/CurrentVersion/Uninstall/"
const SHELL_FOLDERS: str = "Software/Microsoft/Windows/CurrentVersion/Explorer/Shell Folders"

// ------------------------------------------------------------------- log

// Lines kept in memory and written to a file after every line (a crash
// leaves everything up to it). path "" = no file.
struct Logger {
    path: str,
    text: rt.Buf,
}

fn logger_new(path: str) -> Logger {
    return Logger { path: path, text: rt.buf_new() }
}

fn logline(l: *mut Logger, msg: str) {
    rt.buf_push_bytes(&(*l).text, msg.p as u64, msg.n)
    rt.buf_push(&(*l).text, 10 as u8)
    if (*l).path.n > 0 {
        fs.write_file((*l).path, rt.buf_ptr(&(*l).text), rt.buf_len(&(*l).text)) catch 0
    }
}

// ----------------------------------------------------------------- paths

fn replace_byte(s: str, from: u8, to: u8) -> str {
    var b: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < s.n {
        var c: u8 = rt.ld8(s.p as u64, i)
        if c == from {
            c = to
        }
        rt.buf_push(&b, c)
        i = i + 1
    }
    let r: str = util.buf_to_str_copy(&b)
    rt.buf_free(&b)
    return r
}

// forward slashes -> backslashes (what Windows shows and the registry holds)
fn winpath(s: str) -> str {
    return replace_byte(s, 47 as u8, 92 as u8)
}

// backslashes -> forward slashes (what std.fs and this library use inside)
fn fpath(s: str) -> str {
    var t: str = replace_byte(s, 92 as u8, 47 as u8)
    while t.n > 1 && rt.ld8(t.p as u64, t.n - 1) == 47 as u8 {
        t = str { p: t.p, n: t.n - 1 }
    }
    return t
}

fn env(name: str) -> str {
    var b: rt.Buf = rt.buf_new()
    var r: str = ""
    if platform.plat_env_get(name, &b) && rt.buf_len(&b) > 0 {
        r = util.buf_to_str_copy(&b)
    }
    rt.buf_free(&b)
    return r
}

fn default_dir(inf: *mut payload.Info) -> str {
    if osinfo.is_windows() {
        let la: str = env("LOCALAPPDATA")
        if la.n > 0 {
            return fpath(la) + "/Programs/" + (*inf).name
        }
        let up: str = env("USERPROFILE")
        if up.n > 0 {
            return fpath(up) + "/AppData/Local/Programs/" + (*inf).name
        }
        return "C:/Programs/" + (*inf).name
    }
    let h: str = env("HOME")
    if h.n > 0 {
        return h + "/.local/share/" + (*inf).id
    }
    return "/tmp/" + (*inf).id
}

fn uninstall_key(id: str) -> str {
    return UNINSTALL_ROOT + id
}

// Start Menu\Programs / Desktop of this user, forward slashes; "" if unknown.
// The registry knows where a redirected (OneDrive) desktop is; the
// environment is the fallback.
fn shell_folder(value_name: str) -> str {
    var b: rt.Buf = rt.buf_new()
    var r: str = ""
    if winreg.reg_get_string(SHELL_FOLDERS, value_name, &b) && rt.buf_len(&b) > 0 {
        r = fpath(util.buf_to_str_copy(&b))
    }
    rt.buf_free(&b)
    if r.n > 0 {
        return r
    }
    if value_name == "Programs" {
        let ad: str = env("APPDATA")
        if ad.n > 0 {
            return fpath(ad) + "/Microsoft/Windows/Start Menu/Programs"
        }
    } else {
        let up: str = env("USERPROFILE")
        if up.n > 0 {
            return fpath(up) + "/Desktop"
        }
    }
    return ""
}

// ------------------------------------------------------------- installer

struct Installer {
    lg: *mut Logger,
    info: payload.Info,
    pl: payload.Payload,
    exe_p: u64,
    exe_n: usize,
    dir: str,
    desktop: bool,
    startmenu: bool,
    launch: bool,
    registry: bool,
    z: zip.ZipReader,
    walker: safefs.SfWalker,
    count: usize,
    idx: usize,
    phase: u32,
    err: str,
    done_bytes: u64,
    total_bytes: u64,
    manifest: rt.Buf,    // the new install.txt, built while extracting
    old: rt.Buf,         // the previous install.txt (upgrade), or empty
    warnings: usize,
    opened: bool,
}

fn inst_new(lg: *mut Logger) -> Installer {
    return Installer { lg: lg, info: payload.Info { id: "", name: "", version: "", vendor: "",
        exe: "", icon: "", url: "", desktop: true, launch: true },
        pl: payload.Payload { off: 0, len: 0 }, exe_p: 0 as u64, exe_n: 0, dir: "", desktop: true,
        startmenu: true, launch: true, registry: true, z: zip.zip_reader_empty(),
        walker: safefs.sf_walker_new(""), count: 0, idx: 0, phase: PH_FAILED, err: "",
        done_bytes: 0 as u64, total_bytes: 0 as u64, manifest: rt.buf_new(), old: rt.buf_new(),
        warnings: 0, opened: false }
}

fn inst_free(ins: *mut Installer) {
    if (*ins).opened {
        zip.zip_reader_free(&(*ins).z)
        (*ins).opened = false
    }
    rt.buf_free(&(*ins).manifest)
    rt.buf_free(&(*ins).old)
}

fn inst_error(ins: *mut Installer) -> str {
    return (*ins).err
}

fn fail(ins: *mut Installer, msg: str) -> bool {
    (*ins).err = msg
    (*ins).phase = PH_FAILED
    logline((*ins).lg, "ERROR " + msg)
    return false
}

fn zr_fail(e: ZipError, failed: *mut bool) -> zip.ZipReader {
    *failed = true
    return zip.zip_reader_empty()
}

fn zn_fail(e: ZipError, failed: *mut bool) -> usize {
    *failed = true
    return 0
}

fn ae_fail(e: ArchiveError, failed: *mut bool) -> bool {
    *failed = true
    return false
}

fn fs_fail(e: FsError, failed: *mut bool) -> bool {
    *failed = true
    return false
}

fn fs_fail_n(e: FsError, failed: *mut bool) -> usize {
    *failed = true
    return 0
}

// Check the payload of exe p[0, n) and open it; nothing is written yet.
// `ins.dir` is the default directory afterwards; `inst_begin` takes the real one.
fn inst_open(ins: *mut Installer, exe_p: u64, exe_n: usize, desktop: bool, startmenu: bool) -> bool {
    (*ins).exe_p = exe_p
    (*ins).exe_n = exe_n
    if !payload.payload_find(exe_p, exe_n, &(*ins).pl) {
        return fail(ins, "this installer carries no intact payload (missing, truncated or damaged)")
    }
    let zp: u64 = exe_p + (*ins).pl.off as u64
    if !payload.info_from_payload(zp, (*ins).pl.len, &(*ins).info) {
        return fail(ins, "the payload has no valid .pack/info (id, name, version, exe)")
    }
    (*ins).desktop = desktop
    (*ins).startmenu = startmenu
    (*ins).launch = (*ins).info.launch
    (*ins).dir = default_dir(&(*ins).info)
    var failed: bool = false
    (*ins).z = zip.zip_reader_open(zp, (*ins).pl.len) catch | e | (zr_fail(e, &failed))
    if failed {
        return fail(ins, "the payload is not a readable zip archive")
    }
    (*ins).opened = true
    (*ins).count = zip.zip_entry_count(&(*ins).z)
    let windows: bool = osinfo.is_windows()
    // pass 1: the names (the zip reader already refused ".." and duplicates)
    var seen: str = ""
    var i: usize = 0
    var exe_found: bool = false
    var total: u64 = 0 as u64
    while i < (*ins).count {
        let nm: str = safefs.sf_trim_slash(safefs.sf_clean(zip.zip_entry_name(&(*ins).z, i)))
        if nm.n > 0 {
            if !safefs.sf_name_ok(nm, windows) {
                return fail(ins, "the payload has a name that is not allowed: " + nm)
            }
            if zip.zip_entry_is_symlink(&(*ins).z, i) {
                return fail(ins, "the payload has a symbolic link: " + nm)
            }
            if nm == (*ins).info.exe && !zip.zip_entry_is_dir(&(*ins).z, i) {
                exe_found = true
            }
            total = total + zip.zip_entry_size(&(*ins).z, i)
        }
        i = i + 1
    }
    if !exe_found {
        return fail(ins, "the payload does not contain the program " + (*ins).info.exe)
    }
    (*ins).total_bytes = total
    (*ins).phase = PH_EXTRACT
    return true
}

// Create the directory, look for an older install, write the list's head.
// `dir` "" = the default. After this `inst_step` does the work.
fn inst_begin(ins: *mut Installer, dir: str) -> bool {
    var failed: bool = false
    if dir.n > 0 {
        (*ins).dir = fpath(dir)
    }
    logline((*ins).lg, "install " + (*ins).info.name + " " + (*ins).info.version + " into " + (*ins).dir)
    fs.mkdir_all((*ins).dir) catch | e2 | (fs_fail(e2, &failed))
    if failed {
        return fail(ins, "cannot create " + (*ins).dir)
    }
    (*ins).walker = safefs.sf_walker_new((*ins).dir)
    // an earlier install of the same program: remember its list
    rt.buf_clear(&(*ins).old)
    fs.read_file((*ins).dir + "/.pack/install.txt", &(*ins).old) catch 0
    (*ins).phase = PH_EXTRACT
    (*ins).idx = 0
    rt.buf_clear(&(*ins).manifest)
    util.buf_push_str(&(*ins).manifest, "pack=1\nid=" + (*ins).info.id + "\nversion=" + (*ins).info.version +
        "\nname=" + (*ins).info.name + "\ndir=" + (*ins).dir + "\n")
    return true
}

// 0..1000
fn inst_permille(ins: *mut Installer) -> u32 {
    if (*ins).phase >= PH_DONE {
        return 1000 as u32
    }
    if (*ins).phase == PH_FINISH {
        return 950 as u32
    }
    if (*ins).total_bytes == 0 as u64 {
        return 0 as u32
    }
    return (((*ins).done_bytes * 900 as u64) / (*ins).total_bytes) as u32
}

fn manifest_add(ins: *mut Installer, kind: str, name: str) {
    util.buf_push_str(&(*ins).manifest, kind + " " + name + "\n")
}

// one zip entry per step
fn step_extract(ins: *mut Installer) -> u32 {
    if (*ins).idx >= (*ins).count {
        (*ins).phase = PH_FINISH
        return PH_FINISH
    }
    let k: usize = (*ins).idx
    (*ins).idx = k + 1
    let rel: str = safefs.sf_trim_slash(safefs.sf_clean(zip.zip_entry_name(&(*ins).z, k)))
    if rel.n == 0 {
        return PH_EXTRACT
    }
    var failed: bool = false
    if zip.zip_entry_is_dir(&(*ins).z, k) {
        safefs.sf_make_dir(&(*ins).walker, rel, 493 as u32) catch | ae | (ae_fail(ae, &failed))
        if failed {
            fail(ins, "cannot create the folder " + rel)
            return PH_FAILED
        }
        manifest_add(ins, "d", rel)
        return PH_EXTRACT
    }
    var content: rt.Buf = rt.buf_new()
    zip.zip_extract(&(*ins).z, k, &content) catch | e | (zn_fail(e, &failed))
    if failed {
        rt.buf_free(&content)
        fail(ins, "the payload entry is damaged: " + rel)
        return PH_FAILED
    }
    safefs.sf_write_file(&(*ins).walker, rel, rt.buf_ptr(&content), rt.buf_len(&content),
        420 as u32, true) catch | ae2 | (ae_fail(ae2, &failed))
    if failed {
        rt.buf_free(&content)
        fail(ins, "cannot write " + rel + " (is the program running?)")
        return PH_FAILED
    }
    (*ins).done_bytes = (*ins).done_bytes + rt.buf_len(&content) as u64
    rt.buf_free(&content)
    manifest_add(ins, "f", rel)
    return PH_EXTRACT
}

// does the text hold the whole line `line`?
fn has_line(text: *mut rt.Buf, line: str) -> bool {
    let p: u64 = rt.buf_ptr(text)
    let n: usize = rt.buf_len(text)
    var at: usize = 0
    while at < n {
        var e: usize = at
        while e < n && rt.ld8(p, e) != 10 as u8 {
            e = e + 1
        }
        if e - at == line.n && rt.mem_eq(p + at as u64, line.p as u64, line.n) {
            return true
        }
        at = e + 1
    }
    return false
}

// walk the lines of a manifest: kind is the first byte, rest after the space
fn nth_line(text: *mut rt.Buf, idx: usize, out: *mut str) -> bool {
    let p: u64 = rt.buf_ptr(text)
    let n: usize = rt.buf_len(text)
    var at: usize = 0
    var k: usize = 0
    while at < n {
        var e: usize = at
        while e < n && rt.ld8(p, e) != 10 as u8 {
            e = e + 1
        }
        if k == idx {
            var len: usize = e - at
            if len > 0 && rt.ld8(p, at + len - 1) == 13 as u8 {
                len = len - 1
            }
            *out = str { p: (p + at as u64) as *mut u8, n: len }
            return true
        }
        k = k + 1
        at = e + 1
    }
    return false
}

fn remove_old(ins: *mut Installer) {
    var i: usize = 0
    var line: str = ""
    while nth_line(&(*ins).old, i, &line) {
        if line.n > 2 && rt.ld8(line.p as u64, 0) == 102 as u8 && rt.ld8(line.p as u64, 1) == 32 as u8 {
            if !has_line(&(*ins).manifest, line) {
                let rel: str = str { p: (line.p as u64 + 2 as u64) as *mut u8, n: line.n - 2 }
                let r: bool = fs.remove((*ins).dir + "/" + rel) catch false
                logline((*ins).lg, "removed " + rel + " (not in this version)")
            }
        }
        i = i + 1
    }
}

fn make_shortcut(ins: *mut Installer, folder: str, what: str) -> bool {
    if folder.n == 0 {
        logline((*ins).lg, "WARN no " + what + " folder known")
        return false
    }
    let target: str = (*ins).dir + "/" + (*ins).info.exe
    var s: lnk.LnkSpec = lnk.lnk_spec(target)
    s.workdir = (*ins).dir
    s.desc = (*ins).info.name
    if (*ins).info.icon.n > 0 {
        s.icon = (*ins).dir + "/" + (*ins).info.icon
    } else {
        s.icon = target
    }
    var out: rt.Buf = rt.buf_new()
    if !lnk.lnk_build(&out, &s) {
        rt.buf_free(&out)
        logline((*ins).lg, "WARN cannot describe " + what + " shortcut for " + target)
        return false
    }
    fs.mkdir_all(folder) catch false
    let path: str = folder + "/" + (*ins).info.name + ".lnk"
    let w: usize = fs.write_file(path, rt.buf_ptr(&out), rt.buf_len(&out)) catch 0
    let ok: bool = w == rt.buf_len(&out)
    rt.buf_free(&out)
    if ok {
        manifest_add(ins, "s", path)
        logline((*ins).lg, "shortcut " + path)
    } else {
        logline((*ins).lg, "WARN cannot write " + path)
    }
    return ok
}

fn dec(v: u64) -> str {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&b, v)
    let s: str = util.buf_to_str_copy(&b)
    rt.buf_free(&b)
    return s
}

fn date_yyyymmdd() -> str {
    let t: time.DateTime = time.civil_from_unix(time.now_unix_ms())
    var b: rt.Buf = rt.buf_new()
    util.push_dec_pad(&b, t.year as u64, 4)
    util.push_dec_pad(&b, t.month as u64, 2)
    util.push_dec_pad(&b, t.day as u64, 2)
    let s: str = util.buf_to_str_copy(&b)
    rt.buf_free(&b)
    return s
}

fn write_registry(ins: *mut Installer) -> bool {
    let key: str = uninstall_key((*ins).info.id)
    let dirw: str = winpath((*ins).dir)
    var icon: str = dirw + "\\" + winpath((*ins).info.exe)
    if (*ins).info.icon.n > 0 {
        icon = dirw + "\\" + winpath((*ins).info.icon)
    }
    var ok: bool = winreg.reg_set_string(key, "DisplayName", (*ins).info.name)
    ok = winreg.reg_set_string(key, "DisplayVersion", (*ins).info.version) && ok
    if (*ins).info.vendor.n > 0 {
        ok = winreg.reg_set_string(key, "Publisher", (*ins).info.vendor) && ok
    }
    ok = winreg.reg_set_string(key, "InstallLocation", dirw) && ok
    ok = winreg.reg_set_string(key, "DisplayIcon", icon) && ok
    ok = winreg.reg_set_string(key, "UninstallString", "\"" + dirw + "\\uninstall.exe\" /uninstall") && ok
    ok = winreg.reg_set_string(key, "QuietUninstallString", "\"" + dirw + "\\uninstall.exe\" /uninstall /S") && ok
    if (*ins).info.url.n > 0 {
        ok = winreg.reg_set_string(key, "URLInfoAbout", (*ins).info.url) && ok
    }
    ok = winreg.reg_set_string(key, "InstallDate", date_yyyymmdd()) && ok
    ok = winreg.reg_set_dword(key, "EstimatedSize", (((*ins).total_bytes + 1023 as u64) / 1024 as u64) as u32) && ok
    ok = winreg.reg_set_dword(key, "NoModify", 1 as u32) && ok
    ok = winreg.reg_set_dword(key, "NoRepair", 1 as u32) && ok
    return ok
}

fn step_finish(ins: *mut Installer) -> u32 {
    var failed: bool = false
    remove_old(ins)
    // uninstall.exe: this installer without the payload and the trailer
    let un: usize = fs.write_file((*ins).dir + "/uninstall.exe", (*ins).exe_p, (*ins).pl.off) catch 0
    if un != (*ins).pl.off {
        logline((*ins).lg, "WARN cannot write uninstall.exe")
        (*ins).warnings = (*ins).warnings + 1
    } else {
        manifest_add(ins, "f", "uninstall.exe")
    }
    if osinfo.is_windows() {
        if (*ins).startmenu {
            if !make_shortcut(ins, shell_folder("Programs"), "Start Menu") {
                (*ins).warnings = (*ins).warnings + 1
            }
        }
        if (*ins).desktop {
            if !make_shortcut(ins, shell_folder("Desktop"), "Desktop") {
                (*ins).warnings = (*ins).warnings + 1
            }
        }
        winreg.shell_changed()
    }
    manifest_add(ins, "d", ".pack")
    manifest_add(ins, "f", ".pack/install.txt")
    fs.mkdir_all((*ins).dir + "/.pack") catch | e | (fs_fail(e, &failed))
    let mw: usize = fs.write_file((*ins).dir + "/.pack/install.txt", rt.buf_ptr(&(*ins).manifest),
        rt.buf_len(&(*ins).manifest)) catch | e2 | (fs_fail_n(e2, &failed))
    if failed || mw != rt.buf_len(&(*ins).manifest) {
        fail(ins, "cannot write the list of installed files")
        return PH_FAILED
    }
    if (*ins).registry && osinfo.is_windows() {
        if write_registry(ins) {
            logline((*ins).lg, "registry " + uninstall_key((*ins).info.id))
        } else {
            logline((*ins).lg, "WARN the Apps & features entry could not be written")
            (*ins).warnings = (*ins).warnings + 1
        }
    }
    (*ins).phase = PH_DONE
    logline((*ins).lg, "done, " + dec((*ins).warnings as u64) + " warnings")
    return PH_DONE
}

// One unit of work; returns the phase afterwards.
fn inst_step(ins: *mut Installer) -> u32 {
    if (*ins).phase == PH_EXTRACT {
        return step_extract(ins)
    }
    if (*ins).phase == PH_FINISH {
        return step_finish(ins)
    }
    return (*ins).phase
}

// Start the installed program (detached). The caller decides when.
fn inst_launch(ins: *mut Installer) -> bool {
    var c: process.Command = process.command((*ins).dir + "/" + (*ins).info.exe)
    process.set_cwd(&c, (*ins).dir)
    process.set_detach(&c, true)
    var failed: bool = false
    process.spawn(&c) catch | e | (spawn_fail(e, &failed))
    process.command_free(&c)
    return !failed
}

fn spawn_fail(e: ProcError, failed: *mut bool) -> process.Child {
    *failed = true
    return process.Child { pid: 0, h: 0, in_fd: -1, out_fd: -1, err_fd: -1,
        done: true, code: 0, sig: 0, own: false }
}

// ------------------------------------------------------------ after update

// appkit: the program was updated in place; make "Apps & features" show the
// new version. Quiet when the program was not installed by this installer.
fn sync_version(id: str, version: str) -> bool {
    let key: str = uninstall_key(id)
    if !winreg.reg_key_exists(key) {
        return false
    }
    return winreg.reg_set_string(key, "DisplayVersion", version)
}

// the directory of the install the registry knows for `id` ("" if none)
fn current_install_dir(id: str) -> str {
    var b: rt.Buf = rt.buf_new()
    var r: str = ""
    if winreg.reg_get_string(uninstall_key(id), "InstallLocation", &b) {
        r = fpath(util.buf_to_str_copy(&b))
    }
    rt.buf_free(&b)
    return r
}

// -------------------------------------------------------------- uninstall

fn same_dir(a: str, b: str) -> bool {
    if a.n != b.n {
        return false
    }
    var i: usize = 0
    while i < a.n {
        var x: u8 = rt.ld8(a.p as u64, i)
        var y: u8 = rt.ld8(b.p as u64, i)
        if x >= 65 as u8 && x <= 90 as u8 { x = x + 32 as u8 }
        if y >= 65 as u8 && y <= 90 as u8 { y = y + 32 as u8 }
        if x != y {
            return false
        }
        i = i + 1
    }
    return true
}

// the directory part of a path (forward slashes)
fn parent_of(p: str) -> str {
    let i: usize = util.rfind_byte(p, 47 as u8)
    if i >= p.n {
        return "."
    }
    return str { p: p.p, n: i }
}

fn manifest_field(text: *mut rt.Buf, key: str) -> str {
    return field_of(text, key)
}

fn field_of(text: *mut rt.Buf, key: str) -> str {
    var i: usize = 0
    var line: str = ""
    while nth_line(text, i, &line) {
        if line.n > key.n + 1 && util.starts_with(line, key) && rt.ld8(line.p as u64, key.n) == 61 as u8 {
            return __str_copy(str { p: (line.p as u64 + (key.n + 1) as u64) as *mut u8, n: line.n - key.n - 1 })
        }
        i = i + 1
    }
    return ""
}

// depth-first order for removing folders: longer paths first
fn remove_dirs(dir: str, text: *mut rt.Buf, lg: *mut Logger) {
    var pass: usize = 0
    // up to 8 rounds: a round removes the folders that are empty now
    while pass < 8 {
        var i: usize = 0
        var line: str = ""
        var any: bool = false
        while nth_line(text, i, &line) {
            if line.n > 2 && rt.ld8(line.p as u64, 0) == 100 as u8 && rt.ld8(line.p as u64, 1) == 32 as u8 {
                let rel: str = str { p: (line.p as u64 + 2 as u64) as *mut u8, n: line.n - 2 }
                if fs.is_dir(dir + "/" + rel) {
                    let ok: bool = fs.remove(dir + "/" + rel) catch false
                    if ok { any = true }
                }
            }
            i = i + 1
        }
        if !any {
            return
        }
        pass = pass + 1
    }
}

// The real work, run from a copy outside the install directory (or from
// anywhere when the program is not inside it). Returns 0, or 1 on error.
fn uninstall_work(dir: str, lg: *mut Logger) -> u32 {
    var text: rt.Buf = rt.buf_new()
    let got: usize = fs.read_file(dir + "/.pack/install.txt", &text) catch 0
    if got == 0 {
        logline(lg, "ERROR no .pack/install.txt in " + dir + " -- nothing to uninstall")
        rt.buf_free(&text)
        return 1 as u32
    }
    let id: str = field_of(&text, "id")
    logline(lg, "uninstall " + id + " from " + dir)
    var i: usize = 0
    var line: str = ""
    var removed: usize = 0
    while nth_line(&text, i, &line) {
        if line.n > 2 && rt.ld8(line.p as u64, 1) == 32 as u8 {
            let k: u8 = rt.ld8(line.p as u64, 0)
            let rest: str = str { p: (line.p as u64 + 2 as u64) as *mut u8, n: line.n - 2 }
            if k == 102 as u8 {
                let ok: bool = fs.remove(dir + "/" + rest) catch false
                if ok { removed = removed + 1 }
            } else if k == 115 as u8 {
                // a shortcut: an absolute path
                fs.remove(rest) catch false
            }
        }
        i = i + 1
    }
    remove_dirs(dir, &text, lg)
    // the directory itself, when nothing else of the user's is in it
    fs.remove(dir) catch false
    if osinfo.is_windows() && id.n > 0 {
        winreg.reg_delete_tree(uninstall_key(id))
        winreg.shell_changed()
    }
    logline(lg, "removed " + dec(removed as u64) + " files")
    rt.buf_free(&text)
    return 0 as u32
}

// uninstall.exe /uninstall [/S]: stage 1 (inside the install directory)
// copies itself away and starts stage 2; `args` are what stage 2 gets.
// `self_path` = this program, forward slashes. `stage2_dir` != "" means this
// IS stage 2. `wait` = wait for stage 2 (silent mode). Returns the exit code.
fn uninstall_run(self_path: str, dir: str, stage2: bool, wait: bool, lg: *mut Logger) -> u32 {
    if stage2 || !same_dir(parent_of(self_path), dir) {
        let rc: u32 = uninstall_work(dir, lg)
        if stage2 && rc == 0 as u32 {
            // cmd.exe deletes this copy, the uninstaller of the install directory and the
            // directory once both have ended: a batch file, because the quoting of paths with
            // blanks is plain there (the file ends by deleting itself)
            var tmp2: str = env("TEMP")
            if tmp2.n == 0 {
                tmp2 = parent_of(self_path)
            }
            let bat: str = fpath(tmp2) + "/pack-clean-" + dec(platform.plat_self_pid() as u64) + ".cmd"
            // the window of stage 1 may still be open: retry for up to two minutes
            let up: str = winpath(dir) + "\\uninstall.exe"
            let script: str = "@echo off\r\nset n=0\r\n:retry\r\nping -n 2 127.0.0.1 >nul\r\ndel /f /q \"" +
                winpath(self_path) + "\" >nul 2>&1\r\ndel /f /q \"" + up + "\" >nul 2>&1\r\nif exist \"" + up +
                "\" (\r\n  set /a n+=1\r\n  if %n% lss 120 goto retry\r\n)\r\nrmdir \"" + winpath(dir) +
                "\" >nul 2>&1\r\n(goto) 2>nul & del /f /q \"%~f0\"\r\n"
            let w: usize = fs.write_file(bat, script.p as u64, script.n) catch 0
            if w == script.n {
                var c: process.Command = process.command("cmd.exe")
                process.add_arg(&c, "/c")
                process.add_arg(&c, winpath(bat))
                process.set_detach(&c, true)
                process.set_no_window(&c, true)
                var failed: bool = false
                process.spawn(&c) catch | e | (spawn_fail(e, &failed))
                process.command_free(&c)
                if failed {
                    logline(lg, "WARN cannot start the clean-up batch")
                }
            } else {
                logline(lg, "WARN cannot write " + bat)
            }
        }
        return rc
    }
    // stage 1: a copy in the temp folder, started; in silent mode we wait for it
    var ch: process.Child = process.Child { pid: 0, h: 0, in_fd: -1, out_fd: -1, err_fd: -1,
        done: true, code: 0, sig: 0, own: false }
    if !uninstall_start(self_path, dir, wait, lg, &ch) {
        return 1 as u32
    }
    if wait {
        let code: i32 = process.wait(&ch)
        process.close(&ch)
        return code as u32
    }
    process.close(&ch)
    return 0 as u32
}

// Stage 1 on its own (the window uses it and watches the child): copy this
// program into the temp folder and start the copy as stage 2.
fn uninstall_start(self_path: str, dir: str, silent: bool, lg: *mut Logger, ch: *mut process.Child) -> bool {
    var tmp: str = env("TEMP")
    if tmp.n == 0 {
        tmp = env("TMP")
    }
    if tmp.n == 0 {
        tmp = dir
    }
    tmp = fpath(tmp)
    let copy: str = tmp + "/pack-uninstall-" + dec(platform.plat_self_pid() as u64) + ".exe"
    if !platform.plat_file_copy(self_path, copy) {
        logline(lg, "ERROR cannot copy the uninstaller to " + copy)
        return false
    }
    var c2: process.Command = process.command(copy)
    process.add_arg(&c2, "/uninstall-stage2")
    process.add_arg(&c2, dir)
    process.add_arg(&c2, "/S")
    if (*lg).path.n > 0 {
        process.add_arg(&c2, "--log")
        process.add_arg(&c2, (*lg).path)
    }
    var failed2: bool = false
    *ch = process.spawn(&c2) catch | e | (spawn_fail(e, &failed2))
    process.command_free(&c2)
    if failed2 {
        logline(lg, "ERROR cannot start the uninstaller copy")
        return false
    }
    logline(lg, "stage 2 started: " + copy)
    return true
}
