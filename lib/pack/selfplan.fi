// SPDX-License-Identifier: MPL-2.0
import std.rt
import appkit.util

export {
    PlanEnv, SelfPlan, plan_env_new, plan_build, same_path, to_slashes, to_backslashes,
    plan_manifest_text, manifest_field, UNINSTALL_FLAG, STAGE2_FLAG, DELETE_DATA_FLAG, KEEP_DATA_FLAG,
}

const UNINSTALL_FLAG: str = "--uninstall"
const STAGE2_FLAG: str = "--uninstall-stage2"
const DELETE_DATA_FLAG: str = "--delete-data"
const KEEP_DATA_FLAG: str = "--keep-data"
const UNINSTALL_ROOT: str = "Software/Microsoft/Windows/CurrentVersion/Uninstall/"
const BYTE_SLASH: u8 = 47 as u8
const BYTE_BACKSLASH: u8 = 92 as u8
const BYTE_LF: u8 = 10 as u8

struct PlanEnv {
    windows: bool,
    local_appdata: str,
    programs_dir: str,
    desktop_dir: str,
    home: str,
    data_home: str,
}

struct SelfPlan {
    windows: bool,
    id: str,
    name: str,
    vendor: str,
    version: str,
    dir: str,
    exe: str,
    exe_file: str,
    start_link: str,
    desktop_link: str,
    icon_file: str,
    state_file: str,
    state_dir: str,
    registry_key: str,
    uninstall_command: str,
    owns_dir: bool,
}

fn plan_env_new(windows: bool) -> PlanEnv {
    return PlanEnv { windows: windows, local_appdata: "", programs_dir: "", desktop_dir: "", home: "", data_home: "" }
}

fn map_bytes(s: str, from: u8, to: u8) -> str {
    var b: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < s.n {
        var c: u8 = rt.ld8(s.p as u64, i)
        if c == from {
            c = to
        }
        rt.buf_push(&b, c)
        i = i + 1
    }
    let r: str = util.buf_to_str_copy(&b)
    rt.buf_free(&b)
    return r
}

fn to_backslashes(s: str) -> str {
    return map_bytes(s, BYTE_SLASH, BYTE_BACKSLASH)
}

fn to_slashes(s: str) -> str {
    var t: str = map_bytes(s, BYTE_BACKSLASH, BYTE_SLASH)
    while t.n > 1 && rt.ld8(t.p as u64, t.n - 1) == BYTE_SLASH {
        t = str { p: t.p, n: t.n - 1 }
    }
    return t
}

fn lower_byte(c: u8) -> u8 {
    if c >= 65 as u8 && c <= 90 as u8 {
        return c + 32 as u8
    }
    return c
}

fn same_path(a: str, b: str, ignore_case: bool) -> bool {
    let x: str = to_slashes(a)
    let y: str = to_slashes(b)
    if x.n != y.n {
        return false
    }
    var i: usize = 0
    while i < x.n {
        var p: u8 = rt.ld8(x.p as u64, i)
        var q: u8 = rt.ld8(y.p as u64, i)
        if ignore_case {
            p = lower_byte(p)
            q = lower_byte(q)
        }
        if p != q {
            return false
        }
        i = i + 1
    }
    return true
}

fn plan_windows(p: *mut SelfPlan, env: *mut PlanEnv) {
    (*p).dir = to_slashes((*env).local_appdata) + "/Programs/" + (*p).name
    (*p).exe_file = (*p).id + ".exe"
    (*p).exe = (*p).dir + "/" + (*p).exe_file
    (*p).start_link = to_slashes((*env).programs_dir) + "/" + (*p).name + ".lnk"
    (*p).desktop_link = to_slashes((*env).desktop_dir) + "/" + (*p).name + ".lnk"
    (*p).icon_file = ""
    (*p).state_dir = (*p).dir + "/.pack"
    (*p).state_file = (*p).state_dir + "/install.txt"
    (*p).registry_key = UNINSTALL_ROOT + (*p).id
    (*p).uninstall_command = "\"" + to_backslashes((*p).exe) + "\" " + UNINSTALL_FLAG
    (*p).owns_dir = true
}

fn plan_linux(p: *mut SelfPlan, env: *mut PlanEnv) {
    let home: str = to_slashes((*env).home)
    var data_home: str = to_slashes((*env).data_home)
    if data_home.n == 0 {
        data_home = home + "/.local/share"
    }
    (*p).dir = home + "/.local/bin"
    (*p).exe_file = (*p).id
    (*p).exe = (*p).dir + "/" + (*p).exe_file
    (*p).start_link = data_home + "/applications/" + (*p).id + ".desktop"
    (*p).desktop_link = home + "/Desktop/" + (*p).name + ".desktop"
    (*p).icon_file = data_home + "/icons/hicolor/256x256/apps/" + (*p).id + ".png"
    (*p).state_dir = data_home + "/" + (*p).id
    (*p).state_file = (*p).state_dir + "/install.txt"
    (*p).registry_key = ""
    (*p).uninstall_command = "\"" + (*p).exe + "\" " + UNINSTALL_FLAG
    (*p).owns_dir = false
}

fn plan_build(env: *mut PlanEnv, id: str, name: str, vendor: str, version: str) -> SelfPlan {
    var p: SelfPlan = SelfPlan { windows: (*env).windows, id: id, name: name, vendor: vendor, version: version,
        dir: "", exe: "", exe_file: "", start_link: "", desktop_link: "", icon_file: "", state_file: "",
        state_dir: "", registry_key: "", uninstall_command: "", owns_dir: false }
    if (*env).windows {
        plan_windows(&p, env)
    } else {
        plan_linux(&p, env)
    }
    return p
}

fn plan_manifest_text(p: *mut SelfPlan) -> str {
    return "pack=1\nid=" + (*p).id + "\nname=" + (*p).name + "\nversion=" + (*p).version + "\ndir=" + (*p).dir + "\nexe=" + (*p).exe + "\n"
}

fn manifest_field(text: str, key: str) -> str {
    var at: usize = 0
    while at < text.n {
        var e: usize = at
        while e < text.n && rt.ld8(text.p as u64, e) != BYTE_LF {
            e = e + 1
        }
        let line: str = str { p: (text.p as u64 + at as u64) as *mut u8, n: e - at }
        if line.n > key.n && util.starts_with(line, key) && rt.ld8(line.p as u64, key.n) == 61 as u8 {
            var v: str = str { p: (line.p as u64 + (key.n + 1) as u64) as *mut u8, n: line.n - key.n - 1 }
            if v.n > 0 && rt.ld8(v.p as u64, v.n - 1) == 13 as u8 {
                v = str { p: v.p, n: v.n - 1 }
            }
            return __str_copy(v)
        }
        at = e + 1
    }
    return ""
}
