// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.fs

export { PqSrc, pq_src_new, pq_src_file, pq_src_close, pq_src_mem, pq_src_read, pq_src_read_buf }

const SYS_LSEEK: i64 = 8
const SYS_READ: i64 = 0

struct PqSrc {
    read_at: fn(u64, u64, u64, usize) -> bool,
    ud: u64,
    size: u64,
}

fn file_read_at(ud: u64, off: u64, dest: u64, n: usize) -> bool {
    let fd: i64 = ud as i64
    if syscall(SYS_LSEEK, fd, off as i64, 0, 0, 0, 0) < 0 {
        return false
    }
    var done: usize = 0
    while done < n {
        let r: i64 = syscall(SYS_READ, fd, (dest + done as u64) as i64, (n - done) as i64, 0, 0, 0)
        if r <= 0 {
            return false
        }
        done = done + r as usize
    }
    return true
}

fn pq_src_new() -> PqSrc {
    return PqSrc { read_at: file_read_at, ud: 0, size: 0 }
}

fn pq_src_file(path: str, out: *mut PqSrc) -> bool {
    let fd: i64 = fs.open_read(path) catch | e | (0 - 1)
    if fd < 0 {
        return false
    }
    let size: i64 = syscall(SYS_LSEEK, fd, 0, 2, 0, 0, 0)
    if size < 0 {
        fs.close_fd(fd)
        return false
    }
    (*out).read_at = file_read_at
    (*out).ud = fd as u64
    (*out).size = size as u64
    return true
}

fn pq_src_close(s: *mut PqSrc) {
    if (*s).ud != 0 && (*s).size != 0xFFFFFFFFFFFFFFFF {
        fs.close_fd((*s).ud as i64)
    }
    (*s).ud = 0
}

struct MemSrc {
    p: u64,
    n: usize,
}

fn mem_read_at(ud: u64, off: u64, dest: u64, n: usize) -> bool {
    let m: *mut MemSrc = ud as *mut MemSrc
    if off > (*m).n as u64 || n as u64 > (*m).n as u64 - off {
        return false
    }
    rt.mem_copy(dest, (*m).p + off, n)
    return true
}

fn mem_obj_alloc[T]() -> u64 {
    return rt.heap_alloc(size_of[T]())
}

fn pq_src_mem(p: u64, n: usize, out: *mut PqSrc) -> bool {
    let h: u64 = mem_obj_alloc[MemSrc]()
    if h == 0 {
        return false
    }
    let m: *mut MemSrc = h as *mut MemSrc
    (*m).p = p
    (*m).n = n
    (*out).read_at = mem_read_at
    (*out).ud = h
    (*out).size = n as u64
    return true
}

fn pq_src_read(s: *mut PqSrc, off: u64, dest: u64, n: usize) -> bool {
    if n == 0 {
        return true
    }
    if off > (*s).size || n as u64 > (*s).size - off {
        return false
    }
    let f: fn(u64, u64, u64, usize) -> bool = (*s).read_at
    return f((*s).ud, off, dest, n)
}

fn pq_src_read_buf(s: *mut PqSrc, off: u64, n: usize, out: *mut rt.Buf) -> bool {
    rt.buf_clear(out)
    rt.buf_reserve(out, n + 16)
    if (*out).cap < n + 16 {
        return false
    }
    if !pq_src_read(s, off, (*out).ptr, n) {
        return false
    }
    (*out).len = n
    return true
}
