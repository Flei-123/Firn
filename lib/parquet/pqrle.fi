import std.rt
import compress.common

export { rle_read, bit_width_for, unpack_bits }

fn bit_width_for(maxv: u32) -> u32 {
    var w: u32 = 0
    var v: u32 = maxv
    while v > 0 {
        w = w + 1
        v = v >> 1
    }
    return w
}

fn unpack_bits(src: u64, srclen: usize, count: usize, width: u32, out: u64, at: usize) -> bool {
    if width == 0 {
        var z: usize = 0
        while z < count {
            rt.st32(out, at + z, 0)
            z = z + 1
        }
        return true
    }
    if width > 32 {
        return false
    }
    let need: u64 = (count as u64 * width as u64 + 7) / 8
    if need > srclen as u64 {
        return false
    }
    let mask: u64 = (1 << width as u64) - 1
    var acc: u64 = 0
    var nbits: u32 = 0
    var ip: usize = 0
    var i: usize = 0
    while i < count {
        while nbits < width {
            acc = acc | ((rt.ld8(src, ip) as u64) << nbits as u64)
            ip = ip + 1
            nbits = nbits + 8
        }
        rt.st32(out, at + i, (acc & mask) as u32)
        acc = acc >> width as u64
        nbits = nbits - width
        i = i + 1
    }
    return true
}

fn rle_read(src: u64, n: usize, width: u32, count: usize, out: u64) -> bool {
    if width > 32 {
        return false
    }
    var ip: usize = 0
    var done: usize = 0
    let vbytes: usize = ((width + 7) / 8) as usize
    while done < count {
        var h: u64 = 0
        var shift: u64 = 0
        while true {
            if ip >= n || shift > 35 {
                return false
            }
            let b: u64 = rt.ld8(src, ip) as u64
            ip = ip + 1
            h = h | ((b & 127) << shift)
            if b < 128 {
                break
            }
            shift = shift + 7
        }
        if h & 1 == 0 {
            var run: u64 = h >> 1
            if n - ip < vbytes {
                return false
            }
            var v: u32 = 0
            var k: usize = 0
            while k < vbytes {
                v = v | ((rt.ld8(src, ip + k) as u32) << (8 * k as u32))
                k = k + 1
            }
            ip = ip + vbytes
            if run > (count - done) as u64 {
                run = (count - done) as u64
            }
            var j: u64 = 0
            while j < run {
                rt.st32(out, done + j as usize, v)
                j = j + 1
            }
            done = done + run as usize
        } else {
            let groups: u64 = h >> 1
            let total: u64 = groups * 8
            let nbytes: u64 = groups * width as u64
            if nbytes > (n - ip) as u64 {
                return false
            }
            var take: usize = total as usize
            if take > count - done {
                take = count - done
            }
            if !unpack_bits(src + ip as u64, nbytes as usize, take, width, out, done) {
                return false
            }
            ip = ip + nbytes as usize
            done = done + take
        }
    }
    return true
}
