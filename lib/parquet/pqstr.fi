// SPDX-License-Identifier: MPL-2.0
import std.rt
import compress.common

export { StrCol, strcol_new, strcol_free, strcol_clear, strcol_push, strcol_push_null, strcol_len, strcol_ptr, strcol_size,
    strcol_is_null, strcol_count, push_u64, push_u32, ld_u64, ld_u32 }

struct StrCol {
    data: rt.Buf,
    offs: rt.Buf,
    nulls: rt.Buf,
    n: usize,
}

fn push_u64(b: *mut rt.Buf, v: u64) -> bool {
    if !common.buf_ensure(b, (*b).len + 8) {
        return false
    }
    rt.st64((*b).ptr, (*b).len / 8, v)
    (*b).len = (*b).len + 8
    return true
}

fn push_u32(b: *mut rt.Buf, v: u32) -> bool {
    if !common.buf_ensure(b, (*b).len + 4) {
        return false
    }
    common.st32le((*b).ptr, (*b).len, v)
    (*b).len = (*b).len + 4
    return true
}

fn ld_u64(b: *mut rt.Buf, i: usize) -> u64 {
    return rt.ld64((*b).ptr, i)
}

fn ld_u32(b: *mut rt.Buf, i: usize) -> u32 {
    return rt.ld32((*b).ptr, i)
}

fn strcol_new() -> StrCol {
    var c: StrCol = StrCol { data: rt.buf_new(), offs: rt.buf_new(), nulls: rt.buf_new(), n: 0 }
    push_u64(&c.offs, 0)
    return c
}

fn strcol_free(c: *mut StrCol) {
    rt.buf_free(&(*c).data)
    rt.buf_free(&(*c).offs)
    rt.buf_free(&(*c).nulls)
    (*c).n = 0
}

fn strcol_clear(c: *mut StrCol) {
    rt.buf_clear(&(*c).data)
    rt.buf_clear(&(*c).offs)
    rt.buf_clear(&(*c).nulls)
    (*c).n = 0
    push_u64(&(*c).offs, 0)
}

fn strcol_push(c: *mut StrCol, p: u64, n: usize) -> bool {
    if n > 0 && !common.buf_append_bytes(&(*c).data, p, n) {
        return false
    }
    if !push_u64(&(*c).offs, (*c).data.len as u64) {
        return false
    }
    (*c).n = (*c).n + 1
    return true
}

fn strcol_push_null(c: *mut StrCol) -> bool {
    if !strcol_push(c, 0, 0) {
        return false
    }
    if !common.buf_ensure(&(*c).nulls, (*c).n) {
        return false
    }
    while (*c).nulls.len < (*c).n - 1 {
        rt.buf_push(&(*c).nulls, 0 as u8)
    }
    rt.buf_push(&(*c).nulls, 1 as u8)
    return true
}

fn strcol_count(c: *mut StrCol) -> usize {
    return (*c).n
}

fn strcol_size(c: *mut StrCol) -> usize {
    return (*c).data.len
}

fn strcol_is_null(c: *mut StrCol, i: usize) -> bool {
    if i >= (*c).nulls.len {
        return false
    }
    return rt.ld8((*c).nulls.ptr, i) != 0
}

fn strcol_ptr(c: *mut StrCol, i: usize) -> u64 {
    return (*c).data.ptr + ld_u64(&(*c).offs, i)
}

fn strcol_len(c: *mut StrCol, i: usize) -> usize {
    return (ld_u64(&(*c).offs, i + 1) - ld_u64(&(*c).offs, i)) as usize
}
