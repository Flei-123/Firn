import std.rt
import compress.common
import compress.snappy
import compress.zstd
import compress.gzip
import compress.lz4

export { pq_decompress, CODEC_NONE, CODEC_SNAPPY, CODEC_GZIP, CODEC_ZSTD, CODEC_LZ4_RAW, codec_supported }

const CODEC_NONE: u64 = 0
const CODEC_SNAPPY: u64 = 1
const CODEC_GZIP: u64 = 2
const CODEC_ZSTD: u64 = 6
const CODEC_LZ4_RAW: u64 = 7
const BAD: usize = 18446744073709551615

fn codec_supported(codec: u64) -> bool {
    return codec == CODEC_NONE || codec == CODEC_SNAPPY || codec == CODEC_GZIP || codec == CODEC_ZSTD || codec == CODEC_LZ4_RAW
}

fn pq_decompress(codec: u64, src: u64, n: usize, want: usize, out: *mut rt.Buf) -> bool {
    rt.buf_clear(out)
    var got: usize = BAD
    if codec == CODEC_SNAPPY {
        got = snappy.snappy_decompress(src, n, want, out) catch | e | (BAD)
    } else if codec == CODEC_GZIP {
        got = gzip.gz_decompress_limited(src, n, gzip.GZ_AUTO, want, out) catch | e | (BAD)
    } else if codec == CODEC_ZSTD {
        got = zstd.zstd_decompress_limited(src, n, want, out) catch | e | (BAD)
    } else if codec == CODEC_LZ4_RAW {
        got = lz4.lz4_block_decompress(src, n, want, out) catch | e | (BAD)
    }
    return got == want && rt.buf_len(out) == want
}
