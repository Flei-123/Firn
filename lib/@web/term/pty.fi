import std.rt

export { Pty, pty_open, pty_read, pty_write, pty_resize, pty_alive, pty_close, pty_supported }

struct Pty {
    fd: i64,
    pid: i64,
    exited: bool,
}

fn pty_supported() -> bool { return false }

fn pty_open(p: *mut Pty, argv: str, cols: usize, rows: usize) -> bool {
    (*p).fd = 0 - 1
    (*p).pid = 0 - 1
    (*p).exited = true
    return false
}

fn pty_read(p: *mut Pty, buf: u64, cap: usize) -> i64 { return 0 - 1 }

fn pty_write(p: *mut Pty, buf: u64, n: usize) -> bool { return false }

fn pty_resize(p: *mut Pty, cols: usize, rows: usize) -> bool { return false }

fn pty_alive(p: *mut Pty) -> bool { return false }

fn pty_close(p: *mut Pty) {}
