import std.rt
import plat.web

export { set, call }

struct Tap {
    f: fn(*mut web.WebEvent) -> bool,
}

static mut G_TAP: u64 = 0

fn set(f: fn(*mut web.WebEvent) -> bool) {
    if G_TAP == 0 as u64 {
        G_TAP = rt.heap_alloc(16)
    }
    (*(G_TAP as *mut Tap)).f = f
}

fn call(e: *mut web.WebEvent) -> bool {
    if G_TAP == 0 as u64 {
        return false
    }
    let f: fn(*mut web.WebEvent) -> bool = (*(G_TAP as *mut Tap)).f
    return f(e)
}
