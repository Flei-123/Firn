import std.rt
import std.clipboard
import plat.web
import plat.webdialog
import plat.webdownload
import plat.host
import fui.svcq
import fui.svctap

export { pick_open, pick_save, clip_request, store_get, store_set }

const STORE_CAP: usize = 262144
const NOTIFY_PREFIX: str = "notify"
const COLOR_NAME: str = "color"

fn pick_open(title: str, filters: str) -> bool {
    svctap.set(feed)
    return webdialog.web_dialog_file(filters, false)
}

fn pick_save(title: str, name: str, mime: str, p: u64, n: usize) -> bool {
    var status: u32 = 0 as u32
    if webdownload.web_download(name, mime, p, n) {
        status = 1 as u32
    }
    return svcq.push(svcq.EV_SAVED, status, name, 0, 0)
}

fn clip_request() -> bool {
    svctap.set(feed)
    clipboard.paste_text_request()
    return true
}

fn store_get(key: str, out: *mut rt.Buf) -> bool {
    let at: usize = rt.buf_len(out)
    if !rt.buf_reserve(out, at + STORE_CAP) {
        return false
    }
    let n: usize = host.store_get(key.p as u64, key.n, rt.buf_ptr(out) + at as u64, STORE_CAP)
    if n == 0 || n > STORE_CAP {
        return false
    }
    rt.buf_set_len(out, at + n)
    return true
}

fn store_set(key: str, p: u64, n: usize) -> bool {
    host.store_set(key.p as u64, key.n, p, n)
    return true
}

fn is_file_answer(e: *mut web.WebEvent) -> bool {
    let q: str = str { p: (*e).q as *mut u8, n: (*e).qn }
    if q.n == COLOR_NAME.n && rt.mem_eq(q.p as u64, COLOR_NAME.p as u64, q.n) {
        return false
    }
    if q.n >= NOTIFY_PREFIX.n && rt.mem_eq(q.p as u64, NOTIFY_PREFIX.p as u64, NOTIFY_PREFIX.n) {
        return false
    }
    return true
}

fn feed(e: *mut web.WebEvent) -> bool {
    if (*e).kind == web.WE_CLIP {
        return svcq.push(svcq.EV_CLIP, (*e).status, "", (*e).p, (*e).n)
    }
    if (*e).kind != web.WE_DIALOG || !is_file_answer(e) {
        return false
    }
    if (*e).status == 2 as u32 {
        return true
    }
    let name: str = str { p: (*e).q as *mut u8, n: (*e).qn }
    return svcq.push(svcq.EV_OPENED, (*e).status, name, (*e).p, (*e).n)
}
