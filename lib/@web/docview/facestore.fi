import std.rt
import plat.webfaces

export { face_ptr, face_len, FACE_COUNT }

const FACE_COUNT: usize = 11

static mut G_PTR: [u64; 11] = [0 as u64; 11]
static mut G_LEN: [usize; 11] = [0; 11]
static mut G_TRIED: [u32; 11] = [0 as u32; 11]

fn load(i: usize) {
    if G_TRIED[i] != 0 as u32 {
        return
    }
    G_TRIED[i] = 1 as u32
    let n: usize = webfaces.web_face_size(i)
    if n == 0 {
        return
    }
    let p: u64 = rt.heap_alloc(n)
    if p == 0 {
        return
    }
    if webfaces.web_face_read(i, p, n) != n {
        rt.heap_free(p, n)
        return
    }
    G_PTR[i] = p
    G_LEN[i] = n
}

fn face_ptr(i: usize) -> u64 {
    if i >= FACE_COUNT {
        return 0
    }
    load(i)
    return G_PTR[i]
}

fn face_len(i: usize) -> usize {
    if i >= FACE_COUNT {
        return 0
    }
    load(i)
    return G_LEN[i]
}
