import std.rt
import std.str
import std.dialog
import std.clipboard
import plat.web
import plat.webdialog
import plat.webdownload
import services.svc

export {
    os_name, os_caps, os_open_requests, os_host_event, from_web_event,
    os_file_open, os_file_save, os_clip_copy, os_clip_paste, os_message, os_confirm,
}

const END_WITH_FILES: u32 = 2
const ANSWER_THERE: u32 = 1

static mut g_file_id: u32 = 0
static mut g_clip_id: u32 = 0
static mut g_file_items: u32 = 0

fn os_name() -> str {
    return "web"
}

fn os_caps() -> u32 {
    return svc.CAP_FILE_OPEN | svc.CAP_FILE_SAVE | svc.CAP_CLIP_WRITE | svc.CAP_CLIP_READ | svc.CAP_DIALOG
    | svc.CAP_STORAGE | svc.CAP_ASYNC_HOST
}

fn os_open_requests() -> usize {
    var n: usize = 0
    if g_file_id != 0 as u32 { n = n + 1 }
    if g_clip_id != 0 as u32 { n = n + 1 }
    return n
}

fn not_a_file(q: str) -> bool {
    return q == "color" || q == "notify-click" || q == "notify-close"
}

fn file_event(status: u32, index: u32, q: str, p: u64, n: usize) -> bool {
    if g_file_id == 0 as u32 || not_a_file(q) {
        return false
    }
    if q.length() > 0 {
        svc.push_reply(g_file_id, svc.OP_FILE_ITEM, svc.OK, index, q, p, n)
        g_file_items = g_file_items + 1 as u32
        return true
    }
    var s: i32 = svc.CANCELED
    if status == END_WITH_FILES {
        s = svc.OK
    }
    svc.push_reply(g_file_id, svc.OP_FILE_END, s, g_file_items, "", 0, 0)
    g_file_id = 0 as u32
    g_file_items = 0 as u32
    return true
}

fn clip_event(status: u32, q: str, p: u64, n: usize) -> bool {
    if g_clip_id == 0 as u32 {
        return false
    }
    if status == ANSWER_THERE {
        svc.push_reply(g_clip_id, svc.OP_CLIP_TEXT, svc.OK, 0 as u32, q, p, n)
    } else {
        svc.push_reply(g_clip_id, svc.OP_CLIP_TEXT, svc.NOT_FOUND, 0 as u32, q, 0, 0)
    }
    g_clip_id = 0 as u32
    return true
}

fn os_host_event(kind: u32, status: u32, id: u32, q: str, p: u64, n: usize) -> bool {
    if kind == svc.HOST_DIALOG {
        return file_event(status, id, q, p, n)
    }
    if kind == svc.HOST_CLIP {
        return clip_event(status, q, p, n)
    }
    return false
}

fn from_web_event(e: *mut web.WebEvent) -> bool {
    let q: str = str { p: (*e).q as *mut u8, n: (*e).qn }
    return os_host_event((*e).kind, (*e).status, (*e).id, q, (*e).p, (*e).n)
}

fn ok_or_failed(ok: bool) -> i32 {
    if ok {
        return svc.OK
    }
    return svc.FAILED
}

fn os_file_open(accept: str, multiple: bool, id: *mut u32) -> i32 {
    if g_file_id != 0 as u32 {
        return svc.BUSY
    }
    if !webdialog.web_dialog_file(accept, multiple) {
        return svc.FAILED
    }
    g_file_id = svc.next_id()
    g_file_items = 0 as u32
    *id = g_file_id
    return svc.OK
}

fn os_file_save(name: str, mime: str, p: u64, n: usize) -> i32 {
    var m: str = mime
    if m.length() == 0 {
        m = "application/octet-stream"
    }
    return ok_or_failed(webdownload.web_download(name, m, p, n))
}

fn os_clip_copy(s: str) -> i32 {
    return ok_or_failed(clipboard.copy_text(s))
}

fn os_clip_paste(id: *mut u32) -> i32 {
    if g_clip_id != 0 as u32 {
        return svc.BUSY
    }
    clipboard.paste_text_request()
    g_clip_id = svc.next_id()
    *id = g_clip_id
    return svc.OK
}

fn end_status(r: i32) -> i32 {
    if r >= dialog.OK && r <= dialog.FAILED {
        return r
    }
    return svc.FAILED
}

fn os_message(kind: i32, title: str, text: str, buttons: i32, answer: *mut i32) -> i32 {
    return end_status(dialog.message(kind, title, text, buttons, answer))
}

fn os_confirm(title: str, text: str, yes: *mut bool) -> i32 {
    return end_status(dialog.confirm(title, text, yes))
}
