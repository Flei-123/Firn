import std.rt
import std.str
import services.svc
import services.svcdir

export { tree_begin, tree_add, tree_commit, tree_discard, tree_count, tree_list }

const SLASH: u8 = 47 as u8
const ENTRY_LIMIT: usize = 100000

static mut g_live: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }
static mut g_live_count: usize = 0
static mut g_next: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }
static mut g_next_count: usize = 0

fn tree_begin() {
    rt.buf_clear(&g_next)
    g_next_count = 0
}

fn tree_discard() {
    rt.buf_clear(&g_next)
    g_next_count = 0
}

fn tree_commit() {
    rt.buf_clear(&g_live)
    rt.buf_push_bytes(&g_live, rt.buf_ptr(&g_next), rt.buf_len(&g_next))
    g_live_count = g_next_count
    tree_discard()
}

fn tree_count() -> usize {
    return g_live_count
}

fn tree_add(relative: str, is_dir: bool, size: u64, mtime_ns: i64) -> bool {
    if relative.length() == 0 || g_next_count >= ENTRY_LIMIT {
        return false
    }
    var full: rt.Buf = rt.buf_new()
    rt.buf_push(&full, SLASH)
    rt.buf_push_bytes(&full, relative.p as u64, relative.length())
    var e: svcdir.DirEntry = svcdir.entry_new()
    e.name = rt.buf_str(&full)
    e.is_dir = is_dir
    e.size = size
    e.mtime_ns = mtime_ns
    let ok: bool = svcdir.push_entry(&g_next, &e)
    rt.buf_free(&full)
    if ok {
        g_next_count = g_next_count + 1
    }
    return ok
}

fn last_slash(name: str) -> usize {
    var i: usize = name.length()
    while i > 0 {
        i = i - 1
        if rt.ld8(name.p as u64, i) == SLASH {
            return i
        }
    }
    return 0
}

fn trimmed(path: str) -> str {
    var n: usize = path.length()
    while n > 1 && rt.ld8(path.p as u64, n - 1) == SLASH {
        n = n - 1
    }
    return str { p: path.p, n: n }
}

fn parent_of(name: str) -> str {
    let at: usize = last_slash(name)
    if at == 0 {
        return "/"
    }
    return str { p: name.p, n: at }
}

fn base_of(name: str) -> str {
    let at: usize = last_slash(name)
    return str { p: (name.p as u64 + (at + 1) as u64) as *mut u8, n: name.length() - at - 1 }
}

fn tree_list(path: str, out: *mut rt.Buf) -> i32 {
    let dirpath: str = trimmed(path)
    if dirpath.length() == 0 || rt.ld8(dirpath.p as u64, 0) != SLASH {
        return svc.NOT_FOUND
    }
    var found: bool = dirpath == "/"
    var pos: usize = 0
    var e: svcdir.DirEntry = svcdir.entry_new()
    while svcdir.next_entry(&g_live, &pos, &e) {
        if e.name == dirpath {
            if !e.is_dir {
                return svc.NOT_DIR
            }
            found = true
        } else if parent_of(e.name) == dirpath {
            var child: svcdir.DirEntry = e
            child.name = base_of(e.name)
            svcdir.push_entry(out, &child)
        }
    }
    if !found {
        return svc.NOT_FOUND
    }
    return svc.OK
}
