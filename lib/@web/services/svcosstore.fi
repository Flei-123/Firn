import std.rt
import std.str
import plat.host
import services.svc

export { os_store_get, os_store_set, os_store_remove }

const READ_CAP: usize = 65537

fn full_key(key: str, out: *mut rt.Buf) {
    let pre: str = "firn.svc."
    rt.buf_push_bytes(out, pre.p as u64, pre.length())
    let app: str = svc.app_name()
    rt.buf_push_bytes(out, app.p as u64, app.length())
    rt.buf_push(out, 46 as u8)
    rt.buf_push_bytes(out, key.p as u64, key.length())
}

fn os_store_get(key: str, out: *mut rt.Buf) -> i32 {
    var k: rt.Buf = rt.buf_new()
    full_key(key, &k)
    var v: rt.Buf = rt.buf_new()
    rt.buf_reserve(&v, READ_CAP)
    let n: usize = host.store_get(rt.buf_ptr(&k), rt.buf_len(&k), rt.buf_ptr(&v), READ_CAP)
    var s: i32 = svc.NOT_FOUND
    if n >= READ_CAP {
        s = svc.FAILED
    } else if n > 0 {
        rt.buf_push_bytes(out, rt.buf_ptr(&v), n)
        s = svc.OK
    }
    rt.buf_free(&v)
    rt.buf_free(&k)
    return s
}

fn os_store_set(key: str, value: str) -> i32 {
    var k: rt.Buf = rt.buf_new()
    full_key(key, &k)
    host.store_set(rt.buf_ptr(&k), rt.buf_len(&k), value.p as u64, value.length())
    rt.buf_free(&k)
    return svc.OK
}

fn os_store_remove(key: str) -> i32 {
    return os_store_set(key, "")
}
