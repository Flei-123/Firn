import std.rt
import std.str
import plat.webdir
import services.svc
import services.svcwebtree

export { os_dir_list, os_dir_pick, os_dir_event, os_dir_pending }

const RECORD_SIZE: usize = 16
const NS_PER_MS: i64 = 1000000

static mut g_pick_id: u32 = 0
static mut g_pick_root: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }

fn os_dir_list(path: str, out: *mut rt.Buf) -> i32 {
    return svcwebtree.tree_list(path, out)
}

fn os_dir_pending() -> usize {
    if g_pick_id != 0 as u32 {
        return 1
    }
    return 0
}

fn os_dir_pick(id: *mut u32) -> i32 {
    if g_pick_id != 0 as u32 {
        return svc.BUSY
    }
    svcwebtree.tree_begin()
    rt.buf_clear(&g_pick_root)
    if !webdir.web_dialog_dir() {
        return svc.FAILED
    }
    g_pick_id = svc.next_id()
    *id = g_pick_id
    return svc.OK
}

fn is_root(q: str) -> bool {
    for i in 0..q.length() {
        if rt.ld8(q.p as u64, i) == 47 as u8 {
            return false
        }
    }
    return true
}

fn add_item(is_dir: bool, q: str, p: u64, n: usize) {
    var size: u64 = 0 as u64
    var mtime_ns: i64 = 0
    if n >= RECORD_SIZE {
        size = rt.ld64(p, 0)
        mtime_ns = rt.ld64(p, 1) as i64 * NS_PER_MS
    }
    svcwebtree.tree_add(q, is_dir, size, mtime_ns)
    if is_dir && is_root(q) && rt.buf_len(&g_pick_root) == 0 {
        rt.buf_push(&g_pick_root, 47 as u8)
        rt.buf_push_bytes(&g_pick_root, q.p as u64, q.length())
    }
}

fn finish(status: i32, count: u32) {
    if status == svc.OK {
        svcwebtree.tree_commit()
    } else {
        svcwebtree.tree_discard()
    }
    svc.push_reply(g_pick_id, svc.OP_DIR_PICKED, status, count, rt.buf_str(&g_pick_root), 0, 0)
    g_pick_id = 0 as u32
}

fn os_dir_event(status: u32, id: u32, q: str, p: u64, n: usize) -> bool {
    if g_pick_id == 0 as u32 {
        return false
    }
    if status == svc.DIALOG_DIR_ITEM {
        add_item(id != 0 as u32, q, p, n)
        return true
    }
    if status == svc.DIALOG_DIR_END {
        finish(svc.OK, id)
        return true
    }
    if status == svc.DIALOG_DIR_CANCEL {
        finish(svc.CANCELED, 0 as u32)
        return true
    }
    return false
}
