// SPDX-License-Identifier: MPL-2.0
// lib/@web/std/clipboard.fi -- std.clipboard in the browser (wasm32-browser; the
// compiler picks this file instead of lib/std/clipboard.fi). The same names
// as everywhere, on plat.webclip (navigator.clipboard).
//
// WRITING works like the page's other clipboard calls: the browser allows it
// only while the page handles a user gesture (a key press, a click). `copy_text`
// and `copy_png` answer false when this browser has no clipboard API at all;
// when it refuses the write itself, the host keeps the data for the page's own
// next read.
//
// READING IS ASYNCHRONOUS: the browser asks the user for permission and
// answers later. So `paste_text` / `paste_png` / `has_text` / `has_png` answer
// false here ("not available synchronously") and never block. Use the request
// and read the answer as an event, as lib/plat/webclip.fi describes:
//
//     clipboard.paste_text_request()        // later: web.WE_CLIP, e.q = the type,
//     clipboard.paste_png_request()         // e.p / e.n = the data, e.status 1 = there
//
// `clear` writes an empty text; `serve` does nothing; `backend_name` is "web".
//
// HONEST
// W1  Not run in a browser by this round: the file is only compiled for
//     wasm32-browser (the host calls are lib/plat/webclip.fi's, which has its
//     own browser test through demos/webdemo/firn.js).

import std.rt
import std.str
import plat.webclip

export {
    copy_text, paste_text, has_text, clear,
    copy_png, paste_png, has_png,
    paste_text_request, paste_png_request,
    serve, backend_name,
}

fn has_png_magic(p: u64, n: usize) -> bool {
    if n < 8 {
        return false
    }
    return rt.ld8(p, 0) == 0x89 as u8 && rt.ld8(p, 1) == 0x50 as u8 && rt.ld8(p, 2) == 0x4E as u8
    && rt.ld8(p, 3) == 0x47 as u8 && rt.ld8(p, 4) == 0x0D as u8 && rt.ld8(p, 5) == 0x0A as u8
    && rt.ld8(p, 6) == 0x1A as u8 && rt.ld8(p, 7) == 0x0A as u8
}

fn copy_text(s: str) -> bool {
    return webclip.web_clip_write("text/plain;charset=utf-8", s.p as u64, s.length())
}

fn paste_text(out: *mut rt.Buf) -> bool {
    return false
}

fn has_text() -> bool {
    return false
}

fn clear() -> bool {
    return webclip.web_clip_write("text/plain;charset=utf-8", 0, 0)
}

fn copy_png(p: u64, n: usize) -> bool {
    if !has_png_magic(p, n) {
        return false
    }
    return webclip.web_clip_write("image/png", p, n)
}

fn paste_png(out: *mut rt.Buf) -> bool {
    return false
}

fn has_png() -> bool {
    return false
}

// Asks for the clipboard's text; the answer arrives as web.WE_CLIP.
fn paste_text_request() {
    webclip.web_clip_read("text/plain;charset=utf-8")
}

fn paste_png_request() {
    webclip.web_clip_read("image/png")
}

fn serve(ms: i64) {
}

fn backend_name() -> str {
    return "web"
}
