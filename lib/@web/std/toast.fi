// SPDX-License-Identifier: MPL-2.0
// lib/@web/std/toast.fi -- std.toast in the browser (wasm32-browser; the compiler picks this file instead of
// lib/std/toast.fi). The same names as everywhere, on the Notification API through plat.webdialog.
//
// The browser asks the user for permission at the first notification, and only inside a user gesture (a key press,
// a click): that first `send` answers 0 and starts the question; send again after the answer. Clicks and closes are
// EVENTS of the page, not polled: give the page's WE_DIALOG event to `from_web_event`.
//
//     if toast.from_web_event(e, &ev) && ev.kind == toast.EV_ACTION { ... ev.id ... toast.last_key() == "default" ... }
//
// `poll` and `dispatch` answer false here; `capabilities` and `server_name` say nothing.

import std.rt
import std.str
import plat.web
import plat.webdialog

export {
    Options, Event,
    options, open, send, show, close, poll, dispatch, last_key, capabilities, ready, shutdown, server_name,
    from_web_event,
    EV_NONE, EV_ACTION, EV_CLOSED,
    CLOSED_EXPIRED, CLOSED_DISMISSED, CLOSED_BY_CALL, CLOSED_UNDEFINED,
    URGENCY_DEFAULT, URGENCY_LOW, URGENCY_NORMAL, URGENCY_CRITICAL,
    TIMEOUT_DEFAULT, TIMEOUT_NEVER,
}

const EV_NONE: u32 = 0
const EV_ACTION: u32 = 1
const EV_CLOSED: u32 = 2

const CLOSED_EXPIRED: u32 = 1
const CLOSED_DISMISSED: u32 = 2
const CLOSED_BY_CALL: u32 = 3
const CLOSED_UNDEFINED: u32 = 4

const URGENCY_DEFAULT: i32 = -1
const URGENCY_LOW: i32 = 0
const URGENCY_NORMAL: i32 = 1
const URGENCY_CRITICAL: i32 = 2

const TIMEOUT_DEFAULT: i32 = -1
const TIMEOUT_NEVER: i32 = 0

struct Options {
    icon: str, // an image URL; "" = none
    actions: str, // not used by the Notification API of a page (only a service worker has actions)
    category: str, // becomes the notification's tag: a new one with the same tag replaces the old
    urgency: i32,
    timeout_ms: i32,
    replaces: u32,
}

struct Event {
    kind: u32,
    id: u32,
    reason: u32,
}

fn options() -> Options {
    return Options { icon: "", actions: "", category: "", urgency: URGENCY_DEFAULT, timeout_ms: TIMEOUT_DEFAULT,
        replaces: 0 as u32 }
}

fn open(app: str) -> bool {
    return true
}

fn ready() -> bool {
    return true
}

fn send(title: str, body: str, opts: *mut Options) -> u32 {
    return webdialog.web_notify(title, body, (*opts).icon, (*opts).category)
}

fn show(title: str, body: str) -> u32 {
    var o: Options = options()
    return send(title, body, &o)
}

fn close(id: u32) -> bool {
    return webdialog.web_notify_close(id)
}

fn poll(ms: i64, ev: *mut Event) -> bool {
    return false
}

fn dispatch(ms: i64, on_click: fn(u64, u32, str), ud: u64) -> bool {
    return false
}

fn last_key() -> str {
    return "default"
}

fn capabilities(out: *mut rt.Buf) -> usize {
    return 0
}

fn server_name(out: *mut rt.Buf) -> bool {
    return false
}

fn shutdown() {
}

// The page's WE_DIALOG event as a notification event: a click is EV_ACTION (key "default"), a close EV_CLOSED
// (reason CLOSED_UNDEFINED: a page is not told who closed it). false = the event is not about a notification.
fn from_web_event(e: *mut web.WebEvent, ev: *mut Event) -> bool {
    if (*e).kind != web.WE_DIALOG || (*e).qn == 0 {
        return false
    }
    let name: str = str { p: (*e).q as *mut u8, n: (*e).qn }
    if name == "notify-click" {
        (*ev).kind = EV_ACTION
        (*ev).id = (*e).id
        (*ev).reason = 0 as u32
        return true
    }
    if name == "notify-close" {
        (*ev).kind = EV_CLOSED
        (*ev).id = (*e).id
        (*ev).reason = CLOSED_UNDEFINED
        return true
    }
    return false
}
