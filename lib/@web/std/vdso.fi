// SPDX-License-Identifier: MPL-2.0
// lib/@web/std/vdso.fi -- std.vdso in the browser (wasm32-browser; the
// compiler picks this file instead of lib/std/vdso.fi). There is no vDSO and
// no /proc: the clock is the host's, through the system call 228.

export { clock_gettime, active }

const VD_SYS_CLOCK_GETTIME: i64 = 228

fn clock_gettime(clock: i64, ts: u64) -> i64 {
    return syscall(VD_SYS_CLOCK_GETTIME, clock, ts as i64, 0, 0, 0, 0)
}

// There is no vDSO here.
fn active() -> bool {
    return false
}
