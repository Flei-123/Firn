// SPDX-License-Identifier: MPL-2.0
// lib/@web/std/dialogos.fi -- the operating system half of std.dialog in the browser (wasm32-browser; the compiler
// picks this file instead of lib/std/dialogos.fi). Use `std.dialog`, not this file.
//
// MESSAGE BOXES are synchronous in a page: `alert` (OK) and `confirm` (OK/Cancel, Yes/No). There is no three button
// box (Yes/No/Cancel answers NO_BACKEND) and the page may not show boxes at all (an iframe without permission).
//
// FILES, FOLDERS, COLOURS AND FONTS cannot be synchronous: the browser shows an <input type=file> / <input type=color>
// and answers later, and only inside a user gesture. So here they answer NO_BACKEND. A page that wants them calls
// the requests of lib/plat/webdialog.fi (`web_dialog_color`, `web_dialog_file`) and reads the answer as the event
// web.WE_DIALOG -- docs/DIALOG.md, "Browser". A browser hands over a file's NAME and CONTENT, never its path.

import std.rt
import std.str
import plat.webdialog

export { os_name, os_file, os_color, os_font, os_message }

const OK: i32 = 0
const NO_BACKEND: i32 = 2

fn os_name() -> str {
    return "web"
}

fn os_file(mode: i32, title: str, dir: str, name: str, filters: str, out: *mut rt.Buf) -> i32 {
    return NO_BACKEND
}

fn os_color(title: str, initial: u32, out: *mut u32) -> i32 {
    return NO_BACKEND
}

fn os_font(title: str, family: str, size: u32, out_family: *mut rt.Buf, out_size: *mut u32, out_flags: *mut u32) -> i32 {
    return NO_BACKEND
}

fn os_message(kind: i32, title: str, text: str, buttons: i32, answer: *mut i32) -> i32 {
    let a: i32 = webdialog.web_dialog_message(kind, title, text, buttons)
    if a == 0 {
        return NO_BACKEND
    }
    *answer = a
    return OK
}
