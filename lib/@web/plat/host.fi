import plat.web
import plat.webclip

export {
    fetch, stream_open, stream_close, navigate, location,
    store_get, store_set,
    keyboard, edit_mode, edit_wrap, edit_set,
    tz_offset, tz_reset, wake_in, dark, font_extra,
    clip_write, clip_read, backend_name,
}

fn backend_name() -> str { return "web" }

fn fetch(id: u32, method: u64, mn: usize, url: u64, un: usize, body: u64, bn: usize) {
    web.web_fetch(id, method, mn, url, un, body, bn)
}

fn stream_open(url: u64, un: usize) {
    web.web_stream_open(url, un)
}

fn stream_close() {
    web.web_stream_close()
}

fn navigate(url: u64, un: usize) {
    web.web_navigate(url, un)
}

fn location(out: u64, cap: usize) -> usize {
    return web.web_location(out, cap)
}

fn store_get(key: u64, kn: usize, out: u64, cap: usize) -> usize {
    return web.web_store_get(key, kn, out, cap)
}

fn store_set(key: u64, kn: usize, v: u64, vn: usize) {
    web.web_store_set(key, kn, v, vn)
}

fn keyboard(show: bool, x: f64, y: f64, fw: f64, fh: f64) {
    web.web_keyboard(show, x, y, fw, fh)
}

fn edit_mode(on: bool, font: f64, line: f64, left: f64, top: f64, right: f64) {
    web.web_edit_mode(on, font, line, left, top, right)
}

fn edit_wrap(wrap: bool) {
    web.web_edit_wrap(wrap)
}

fn edit_set(p: u64, n: usize, cur: usize, anc: usize, scroll: f64) {
    web.web_edit_set(p, n, cur, anc, scroll)
}

fn tz_offset(stamp: u64) -> i64 {
    return web.web_tz_offset(stamp)
}

fn tz_reset() {
    web.web_tz_reset()
}

fn wake_in(ms: f64) {
    web.web_wake_in(web.web_the(), ms)
}

fn dark() -> bool {
    return web.web_dark(web.web_the())
}

fn font_extra(slot: usize) -> u64 {
    return web.web_font_extra(web.web_the(), slot)
}

fn clip_write(mime: str, p: u64, n: usize) -> bool {
    return webclip.web_clip_write(mime, p, n)
}

fn clip_read(mime: str) {
    webclip.web_clip_read(mime)
}
