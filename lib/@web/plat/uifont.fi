import font.metrics
import plat.web

export { FACE_COUNT, face_weight, load_face, family_dir, load_mono }

const FACE_COUNT: usize = 4
const MONO_SLOT: usize = 4

fn face_weight(i: usize) -> usize {
    if i == 0 { return 400 }
    if i == 1 { return 500 }
    if i == 2 { return 600 }
    return 700
}

fn take(slot: usize, fs: *mut metrics.FontSet) -> bool {
    let f: u64 = web.web_font_extra(web.web_the(), slot)
    if f == 0 { return false }
    *fs = *(f as *mut metrics.FontSet)
    return true
}

fn family_dir() -> bool {
    return web.web_font_extra(web.web_the(), 0) != 0
}

fn load_face(face: usize, fs: *mut metrics.FontSet) -> bool {
    if face >= FACE_COUNT { return false }
    return take(face, fs)
}

fn load_mono(fs: *mut metrics.FontSet) -> bool {
    return take(MONO_SLOT, fs)
}
