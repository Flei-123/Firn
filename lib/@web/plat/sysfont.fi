import std.rt
import font.metrics
import plat.web

export { sysfont_load_bold, sysfont_load, sysfont_load_ui, sysfont_path }

fn sysfont_load(fs: *mut metrics.FontSet) -> bool {
    let page: *mut web.Web = web.web_the()
    if page as u64 == 0 { return false }
    let f: u64 = web.web_font(page)
    if f == 0 { return false }
    *fs = *(f as *mut metrics.FontSet)
    return true
}

fn sysfont_load_ui(fs: *mut metrics.FontSet) -> bool {
    return sysfont_load(fs)
}

fn sysfont_load_bold(fs: *mut metrics.FontSet) -> bool {
    return false
}

fn sysfont_path(out: *mut rt.Buf) -> bool {
    return false
}
