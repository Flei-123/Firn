import fui.render
import fui.theme
import fui.painter
import plat.web
import plat.webfont
import plat.webgpu
import plat.hostev

export {
    app, ctx, theme_of, css_width, css_height, want_frame, cursor, damage,
    transitions, fade_busy, set_keep, set_opaque, on_demand, use_gpu,
    gpu_enable, font_apply, backend_name,
}

static mut G_PAINT: fn(u64, u64) -> bool = 0 as fn(u64, u64) -> bool
static mut G_EVENT: fn(u64, u64, *mut hostev.HostEvent) -> bool = 0 as fn(u64, u64, *mut hostev.HostEvent) -> bool

fn backend_name() -> str { return "web" }

fn paint_bridge(ud: u64, w: *mut web.Web) -> bool {
    let f: fn(u64, u64) -> bool = G_PAINT
    return f(ud, w as u64)
}

fn event_bridge(ud: u64, w: *mut web.Web, e: *mut hostev.HostEvent) -> bool {
    let f: fn(u64, u64, *mut hostev.HostEvent) -> bool = G_EVENT
    return f(ud, w as u64, e)
}

fn app(ud: u64, paint: fn(u64, u64) -> bool,
    event: fn(u64, u64, *mut hostev.HostEvent) -> bool) -> bool {
    G_PAINT = paint
    G_EVENT = event
    return web.web_app(ud, paint_bridge, event_bridge)
}

fn ctx(w: u64) -> *mut render.Ctx { return web.web_ctx(w as *mut web.Web) }

fn theme_of(w: u64) -> *mut theme.Theme { return web.web_theme(w as *mut web.Web) }

fn css_width(w: u64) -> usize { return web.web_css_width(w as *mut web.Web) }

fn css_height(w: u64) -> usize { return web.web_css_height(w as *mut web.Web) }

fn want_frame(w: u64) { web.web_want_frame(w as *mut web.Web) }

fn cursor(kind: u32) { web.web_cursor(kind) }

fn damage(w: u64, x: f64, y: f64, dw: f64, dh: f64) {
    web.web_damage(w as *mut web.Web, x, y, dw, dh)
}

fn transitions(w: u64) -> bool { return web.web_transitions(w as *mut web.Web) }

fn fade_busy(w: u64) -> bool { return web.web_fade_busy(w as *mut web.Web) }

fn set_keep(on: bool) { web.web_set_keep(on) }

fn set_opaque(on: bool) { web.web_set_opaque(on) }

fn on_demand(on: bool) { web.web_on_demand(on) }

fn use_gpu(on: bool) { web.web_use_gpu(on) }

fn gpu_enable() { webgpu.web_gpu_enable() }

fn font_apply(z: *mut painter.Painter) -> bool { return webfont.web_font_apply(z) }
