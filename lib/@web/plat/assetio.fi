// SPDX-License-Identifier: MPL-2.0
import std.rt

export { read }

const SLOTS: usize = 16

static mut G_NAME: [u64; 16] = [0 as u64; 16]
static mut G_NAME_LEN: [usize; 16] = [0; 16]
static mut G_DATA: [u64; 16] = [0 as u64; 16]
static mut G_DATA_LEN: [usize; 16] = [0; 16]
static mut G_COUNT: usize = 0

#[export_c]
fn firn_web_asset(np: u32, nn: u32, p: u32, n: u32) -> u32 {
    if G_COUNT >= SLOTS { return 0 as u32 }
    G_NAME[G_COUNT] = np as u64
    G_NAME_LEN[G_COUNT] = nn as usize
    G_DATA[G_COUNT] = p as u64
    G_DATA_LEN[G_COUNT] = n as usize
    G_COUNT = G_COUNT + 1
    return 1 as u32
}

fn same(i: usize, name: str) -> bool {
    if G_NAME_LEN[i] != name.n { return false }
    var k: usize = 0
    while k < name.n {
        if rt.ld8(G_NAME[i], k) != rt.ld8(name.p as u64, k) { return false }
        k = k + 1
    }
    return true
}

fn read(name: str, out: *mut rt.Buf) -> bool {
    var i: usize = 0
    while i < G_COUNT {
        if same(i, name) {
            rt.buf_push_bytes(out, G_DATA[i], G_DATA_LEN[i])
            return true
        }
        i = i + 1
    }
    return false
}
