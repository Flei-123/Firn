// lib/osum/libc/errno.fi -- round K4: the error of the last call.
//
// A system call answers with a result or with a NEGATIVE number, and that
// is the honest interface -- but it is not the one a C program is written
// against. There a call returns -1 and the reason lies in `errno`, and
// half the code ever written for Unix reads:
//
//     fd = open(path, O_RDONLY);
//     if (fd < 0) { if (errno == ENOENT) ... }
//
// So this file does the split, in exactly one place: `check` turns every
// answer of the kernel into a result or into -1 with `last` set. Nothing
// above this file ever compares a return value against 0xFFFFFFFFFFFFFFFE
// again.
//
// The numbers are the ones in `demos/kernel/errno.fi`, and
// `tools/posix/run.sh` compares the two lists mechanically -- two copies
// of a list are two lists, and the day they disagree an error means two
// things.

export {
    check, failed, errno, clear, is_error, negated,
    E_PERM, E_NOENT, E_SRCH, E_INTR, E_IO, E_NXIO, E_2BIG, E_NOEXEC,
    E_BADF, E_CHILD, E_AGAIN, E_NOMEM, E_ACCES, E_FAULT, E_BUSY, E_EXIST,
    E_XDEV, E_NODEV, E_NOTDIR, E_ISDIR, E_INVAL, E_NFILE, E_MFILE,
    E_NOTTY, E_FBIG, E_NOSPC, E_SPIPE, E_ROFS, E_MLINK, E_PIPE,
    E_NAMETOOLONG, E_NOSYS, E_NOTEMPTY, E_OVERFLOW, E_RANGE
}

const E_PERM: u64 = 1
const E_NOENT: u64 = 2
const E_SRCH: u64 = 3
const E_INTR: u64 = 4
const E_IO: u64 = 5
const E_NXIO: u64 = 6
const E_2BIG: u64 = 7
const E_NOEXEC: u64 = 8
const E_BADF: u64 = 9
const E_CHILD: u64 = 10
const E_AGAIN: u64 = 11
const E_NOMEM: u64 = 12
const E_ACCES: u64 = 13
const E_FAULT: u64 = 14
const E_BUSY: u64 = 16
const E_EXIST: u64 = 17
const E_XDEV: u64 = 18
const E_NODEV: u64 = 19
const E_NOTDIR: u64 = 20
const E_ISDIR: u64 = 21
const E_INVAL: u64 = 22
const E_NFILE: u64 = 23
const E_MFILE: u64 = 24
const E_NOTTY: u64 = 25
const E_FBIG: u64 = 27
const E_NOSPC: u64 = 28
const E_SPIPE: u64 = 29
const E_ROFS: u64 = 30
const E_MLINK: u64 = 31
const E_PIPE: u64 = 32
const E_RANGE: u64 = 34 // the answer does not fit in the buffer
const E_NAMETOOLONG: u64 = 36
const E_NOSYS: u64 = 38
const E_NOTEMPTY: u64 = 39
const E_OVERFLOW: u64 = 75

// The reason for the last refusal. A `static mut` of the PROGRAM, so it
// lands in its `.bss` -- and the ELF loader of round K1 zeroes that, which
// is why `errno` is 0 before the first call and not a poison pattern.
static mut last: u64 = 0

// The top 4096 values are errors: no call ever returns that many octets,
// and no mapping lands on the last page of the address space. The same
// rule the kernel uses (`demos/kernel/errno.fi`, `is_error`).
fn is_error(v: u64) -> bool {
    return v >= (0 -% 4095)
}

// The positive number behind a negative answer. `0 -% v` is the two's
// complement and a wraparound one wants -- plain `-` is checked since
// round 72 and would panic on every single error.
fn negated(v: u64) -> u64 {
    return 0 -% v
}

// THE ONE PLACE. Everything above hands its raw answer through here.
fn check(v: u64) -> u64 {
    if is_error(v) {
        last = negated(v)
        return 0 -% 1
    }
    return v
}

// Did the last call fail? For a caller that has the result in its hand:
// `if libc.failed(r) { ... }`.
fn failed(v: u64) -> bool {
    return v == (0 -% 1)
}

fn errno() -> u64 {
    return last
}

fn clear() {
    last = 0
}
