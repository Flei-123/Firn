// lib/osum/libc/text.fi -- round K4: what `<string.h>` is, in Firn.
//
// A program on the disk has no library at all: no allocator, no
// collector, no runtime (`tools/osum/run.sh` checks that on the finished
// file). It still needs the six functions every C program uses in its
// first ten lines, and they are these.
//
// THE NAMES ARE NOT THE C NAMES, and that is deliberate. `tools/osum/run.sh`
// proves that no HOST libc was linked in by looking for `malloc`, `printf`,
// `memcpy` and `mmap` in the symbol table of every program. A function of
// our own carrying one of those names would make that proof worthless --
// so what is `strlen` there is `length` here, `memcpy` is `copy`,
// `strcmp` is `equal`. The behaviour is the C one; only the name says
// which system it came from.

export {
    length, equal, equal_n, copy_text, find, digits, number, is_space,
    is_digit, upper, lower
}

// `strlen`.
fn length(p: u64) -> u64 {
    var n: u64 = 0
    while *((p + n) as *mut u8) != 0 as u8 {
        n = n + 1
    }
    return n
}

// `strcmp` == 0.
fn equal(a: u64, b: u64) -> bool {
    var i: u64 = 0
    var going: bool = true
    while going {
        let x: u64 = (*((a + i) as *mut u8)) as u64
        let y: u64 = (*((b + i) as *mut u8)) as u64
        if x != y {
            return false
        }
        if x == 0 {
            going = false
        }
        i = i + 1
    }
    return true
}

// `strncmp` == 0.
fn equal_n(a: u64, b: u64, n: u64) -> bool {
    var i: u64 = 0
    while i < n {
        let x: u64 = (*((a + i) as *mut u8)) as u64
        let y: u64 = (*((b + i) as *mut u8)) as u64
        if x != y {
            return false
        }
        if x == 0 {
            return true
        }
        i = i + 1
    }
    return true
}

// `strlcpy`: at most `max` octets INCLUDING the zero, and the zero is
// always written. Returns how many octets of text arrived.
fn copy_text(dst: u64, src: u64, max: u64) -> u64 {
    if max == 0 {
        return 0
    }
    var n: u64 = 0
    var going: bool = true
    while going {
        if n + 1 >= max {
            going = false
        } else {
            let c: u64 = (*((src + n) as *mut u8)) as u64
            if c == 0 {
                going = false
            } else {
                __mmio_write8((dst + n) as *mut u8, c as u8)
                n = n + 1
            }
        }
    }
    __mmio_write8((dst + n) as *mut u8, 0 as u8)
    return n
}

// `strchr`: the offset of the octet, or the length when it is not there.
fn find(p: u64, c: u64) -> u64 {
    var i: u64 = 0
    var going: bool = true
    while going {
        let v: u64 = (*((p + i) as *mut u8)) as u64
        if v == 0 {
            going = false
        } else {
            if v == c {
                return i
            }
            i = i + 1
        }
    }
    return i
}

// A number into text, with a sign when the top bit says so -- a result of
// a system call is an `i64` in a `u64` register. Returns the length.
//
// The minus is a REINTERPRETATION, not a subtraction: `0 -% v` is the
// two's complement negation, and plain `-` is checked since round 72 and
// would call `osum_panic` for every negative value this ever sees.
fn digits(v: u64, out: u64, signed: bool) -> u64 {
    var value: u64 = v
    var at: u64 = 0
    if signed {
        if (v >> 63) != 0 {
            __mmio_write8(out as *mut u8, 45 as u8)
            at = 1
            value = 0 -% v
        }
    }
    var back: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    if value == 0 {
        back[0] = 48 as u8
        n = 1
    }
    while value > 0 {
        back[n as usize] = (48 + value % 10) as u8
        value = value / 10
        n = n + 1
    }
    var i: u64 = n
    while i > 0 {
        i = i - 1
        __mmio_write8((out + at) as *mut u8, back[i as usize])
        at = at + 1
    }
    __mmio_write8((out + at) as *mut u8, 0 as u8)
    return at
}

// Text into a number, `atoi` without the sign. Stops at the first octet
// that is not a digit.
fn number(p: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    var going: bool = true
    while going {
        let c: u64 = (*((p + i) as *mut u8)) as u64
        if c < 48 || c > 57 {
            going = false
        } else {
            v = v * 10 + (c - 48)
            i = i + 1
        }
    }
    return v
}

fn is_space(c: u64) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13
}

fn is_digit(c: u64) -> bool {
    return c >= 48 && c <= 57
}

fn upper(c: u64) -> u64 {
    if c >= 97 && c <= 122 {
        return c - 32
    }
    return c
}

fn lower(c: u64) -> u64 {
    if c >= 65 && c <= 90 {
        return c + 32
    }
    return c
}
