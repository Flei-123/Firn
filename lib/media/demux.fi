import std.rt
import media.mp4
import media.webm

export {
    Demux, demux_new, demux_free, demux_open, demux_format, demux_ntracks,
    demux_track_kind, demux_track_codec, demux_track_width, demux_track_height, demux_track_hz, demux_track_channels,
    demux_track_cfg, demux_track_cfg_len, demux_track_duration_us, demux_find_track,
    demux_nsamples, demux_sample_off, demux_sample_size, demux_sample_pts_us, demux_sample_dts_us, demux_sample_sync,
    demux_seek_sync, demux_duration_us, demux_track_skip_us,
    FMT_NONE, FMT_MP4, FMT_WEBM,
    TK_NONE, TK_AUDIO, TK_VIDEO,
    CODEC_UNKNOWN, CODEC_H264, CODEC_VP8, CODEC_VP9, CODEC_AV1, CODEC_AAC, CODEC_OPUS, CODEC_VORBIS, CODEC_OTHER,
}

const FMT_NONE: i32 = 0
const FMT_MP4: i32 = 1
const FMT_WEBM: i32 = 2

const TK_NONE: i32 = 0
const TK_AUDIO: i32 = 1
const TK_VIDEO: i32 = 2

const CODEC_UNKNOWN: i32 = 0
const CODEC_H264: i32 = 1
const CODEC_VP8: i32 = 2
const CODEC_VP9: i32 = 3
const CODEC_AV1: i32 = 4
const CODEC_AAC: i32 = 10
const CODEC_OPUS: i32 = 11
const CODEC_VORBIS: i32 = 12
const CODEC_OTHER: i32 = 99

struct Demux {
    fmt: i32,
    mp4: mp4.Mp4,
    webm: webm.Webm,
}

fn demux_new() -> Demux {
    return Demux { fmt: FMT_NONE, mp4: mp4.mp4_new(), webm: webm.webm_new() }
}

fn demux_free(d: *mut Demux) {
    if (*d).fmt == FMT_MP4 {
        mp4.mp4_free(&(*d).mp4)
    }
    if (*d).fmt == FMT_WEBM {
        webm.webm_free(&(*d).webm)
    }
    (*d).fmt = FMT_NONE
}

fn demux_open(d: *mut Demux, data: u64, len: usize) -> i32 {
    if webm.webm_sniff(data, len) != 0 {
        if webm.webm_parse(&(*d).webm, data, len) != 0 {
            webm.webm_free(&(*d).webm)
            (*d).webm = webm.webm_new()
            return -1
        }
        (*d).fmt = FMT_WEBM
        return 0
    }
    if mp4.mp4_parse(&(*d).mp4, data, len) != 0 {
        mp4.mp4_free(&(*d).mp4)
        (*d).mp4 = mp4.mp4_new()
        return -1
    }
    (*d).fmt = FMT_MP4
    return 0
}

fn demux_format(d: *mut Demux) -> i32 {
    return (*d).fmt
}

fn demux_ntracks(d: *mut Demux) -> i32 {
    if (*d).fmt == FMT_MP4 {
        return mp4.mp4_ntracks(&(*d).mp4)
    }
    if (*d).fmt == FMT_WEBM {
        return webm.webm_ntracks(&(*d).webm)
    }
    return 0
}

fn demux_track_kind(d: *mut Demux, t: i32) -> i32 {
    if t < 0 || t >= demux_ntracks(d) {
        return TK_NONE
    }
    var k: u32 = 0
    if (*d).fmt == FMT_MP4 {
        k = mp4.mp4_kind(&(*d).mp4, t)
    }
    if (*d).fmt == FMT_WEBM {
        k = webm.webm_kind(&(*d).webm, t)
    }
    if k == 1 {
        return TK_AUDIO
    }
    if k == 2 {
        return TK_VIDEO
    }
    return TK_NONE
}

fn mp4_codec_id(c: u32) -> i32 {
    if c == 0x61766331 || c == 0x61766333 {
        return CODEC_H264
    }
    if c == 0x6D703461 {
        return CODEC_AAC
    }
    if c == 0x4F707573 || c == 0x6F707573 {
        return CODEC_OPUS
    }
    if c == 0x76703038 {
        return CODEC_VP8
    }
    if c == 0x76703039 {
        return CODEC_VP9
    }
    if c == 0x61763031 {
        return CODEC_AV1
    }
    return CODEC_OTHER
}

fn webm_codec_id(c: u32) -> i32 {
    if c == webm.CODEC_VP8 {
        return CODEC_VP8
    }
    if c == webm.CODEC_VP9 {
        return CODEC_VP9
    }
    if c == webm.CODEC_AV1 {
        return CODEC_AV1
    }
    if c == webm.CODEC_OPUS {
        return CODEC_OPUS
    }
    if c == webm.CODEC_VORBIS {
        return CODEC_VORBIS
    }
    return CODEC_OTHER
}

fn demux_track_codec(d: *mut Demux, t: i32) -> i32 {
    if t < 0 || t >= demux_ntracks(d) {
        return CODEC_UNKNOWN
    }
    if (*d).fmt == FMT_MP4 {
        return mp4_codec_id(mp4.mp4_codec(&(*d).mp4, t))
    }
    if (*d).fmt == FMT_WEBM {
        return webm_codec_id(webm.webm_codec(&(*d).webm, t))
    }
    return CODEC_UNKNOWN
}

fn demux_track_width(d: *mut Demux, t: i32) -> u32 {
    if t < 0 || t >= demux_ntracks(d) {
        return 0
    }
    if (*d).fmt == FMT_MP4 {
        return mp4.mp4_width(&(*d).mp4, t)
    }
    return webm.webm_width(&(*d).webm, t)
}

fn demux_track_height(d: *mut Demux, t: i32) -> u32 {
    if t < 0 || t >= demux_ntracks(d) {
        return 0
    }
    if (*d).fmt == FMT_MP4 {
        return mp4.mp4_height(&(*d).mp4, t)
    }
    return webm.webm_height(&(*d).webm, t)
}

fn demux_track_hz(d: *mut Demux, t: i32) -> u32 {
    if t < 0 || t >= demux_ntracks(d) {
        return 0
    }
    if (*d).fmt == FMT_MP4 {
        return mp4.mp4_hz(&(*d).mp4, t)
    }
    return webm.webm_hz(&(*d).webm, t)
}

fn demux_track_channels(d: *mut Demux, t: i32) -> u32 {
    if t < 0 || t >= demux_ntracks(d) {
        return 0
    }
    if (*d).fmt == FMT_MP4 {
        return mp4.mp4_channels(&(*d).mp4, t)
    }
    return webm.webm_channels(&(*d).webm, t)
}

fn demux_track_cfg(d: *mut Demux, t: i32) -> u64 {
    if t < 0 || t >= demux_ntracks(d) {
        return 0
    }
    if (*d).fmt == FMT_MP4 {
        return mp4.mp4_cfg(&(*d).mp4, t)
    }
    return webm.webm_cfg(&(*d).webm, t)
}

fn demux_track_cfg_len(d: *mut Demux, t: i32) -> usize {
    if t < 0 || t >= demux_ntracks(d) {
        return 0
    }
    if (*d).fmt == FMT_MP4 {
        return mp4.mp4_cfg_len(&(*d).mp4, t)
    }
    return webm.webm_cfg_len(&(*d).webm, t)
}

fn demux_find_track(d: *mut Demux, kind: i32) -> i32 {
    var t: i32 = 0
    let n: i32 = demux_ntracks(d)
    while t < n {
        if demux_track_kind(d, t) == kind {
            return t
        }
        t = t + 1
    }
    return -1
}

fn demux_nsamples(d: *mut Demux, t: i32) -> usize {
    if t < 0 || t >= demux_ntracks(d) {
        return 0
    }
    if (*d).fmt == FMT_MP4 {
        return mp4.mp4_count(&(*d).mp4, t)
    }
    return webm.webm_count(&(*d).webm, t)
}

fn demux_sample_off(d: *mut Demux, t: i32, i: usize) -> u64 {
    if i >= demux_nsamples(d, t) {
        return 0
    }
    if (*d).fmt == FMT_MP4 {
        return mp4.mp4_off(&(*d).mp4, t, i)
    }
    return webm.webm_off(&(*d).webm, t, i)
}

fn demux_sample_size(d: *mut Demux, t: i32, i: usize) -> u32 {
    if i >= demux_nsamples(d, t) {
        return 0
    }
    if (*d).fmt == FMT_MP4 {
        return mp4.mp4_size(&(*d).mp4, t, i)
    }
    return webm.webm_size(&(*d).webm, t, i)
}

fn demux_sample_sync(d: *mut Demux, t: i32, i: usize) -> bool {
    if i >= demux_nsamples(d, t) {
        return false
    }
    if (*d).fmt == FMT_MP4 {
        return mp4.mp4_sync(&(*d).mp4, t, i) != 0
    }
    return webm.webm_sync(&(*d).webm, t, i) != 0
}

fn ticks_to_us(v: i64, scale: u32) -> i64 {
    if scale == 0 {
        return 0
    }
    return (v * 1000000) / (scale as i64)
}

fn demux_sample_dts_us(d: *mut Demux, t: i32, i: usize) -> i64 {
    if i >= demux_nsamples(d, t) {
        return 0
    }
    if (*d).fmt == FMT_MP4 {
        var v: i64 = mp4.mp4_dts(&(*d).mp4, t, i) as i64
        if mp4.mp4_skip(&(*d).mp4, t) > 0 {
            v = v - mp4.mp4_skip(&(*d).mp4, t)
        }
        return ticks_to_us(v, mp4.mp4_timescale(&(*d).mp4, t))
    }
    return ticks_to_us(webm.webm_pts(&(*d).webm, t, i), webm.webm_timescale(&(*d).webm, t)) - demux_track_skip_us(d, t)
}

fn demux_sample_pts_us(d: *mut Demux, t: i32, i: usize) -> i64 {
    if i >= demux_nsamples(d, t) {
        return 0
    }
    if (*d).fmt == FMT_MP4 {
        var v: i64 = (mp4.mp4_dts(&(*d).mp4, t, i) as i64) + (mp4.mp4_cts(&(*d).mp4, t, i) as i64)
        if mp4.mp4_skip(&(*d).mp4, t) > 0 {
            v = v - mp4.mp4_skip(&(*d).mp4, t)
        }
        return ticks_to_us(v, mp4.mp4_timescale(&(*d).mp4, t))
    }
    return ticks_to_us(webm.webm_pts(&(*d).webm, t, i), webm.webm_timescale(&(*d).webm, t)) - demux_track_skip_us(d, t)
}

fn samples_span_us(d: *mut Demux, t: i32) -> i64 {
    let n: usize = demux_nsamples(d, t)
    if n < 2 {
        return 0
    }
    var hi: i64 = demux_sample_pts_us(d, t, 0)
    var lo: i64 = hi
    var i: usize = 1
    while i < n {
        let v: i64 = demux_sample_pts_us(d, t, i)
        if v > hi {
            hi = v
        }
        if v < lo {
            lo = v
        }
        i = i + 1
    }
    let span: i64 = hi - lo
    return span + span / ((n - 1) as i64)
}

fn demux_track_duration_us(d: *mut Demux, t: i32) -> i64 {
    if t < 0 || t >= demux_ntracks(d) {
        return 0
    }
    var v: i64 = 0
    if (*d).fmt == FMT_MP4 {
        v = ticks_to_us(mp4.mp4_duration(&(*d).mp4, t) as i64, mp4.mp4_timescale(&(*d).mp4, t))
    }
    if (*d).fmt == FMT_WEBM {
        v = ticks_to_us(webm.webm_duration(&(*d).webm) as i64, webm.webm_timescale(&(*d).webm, t))
    }
    if v == 0 {
        return samples_span_us(d, t)
    }
    return v
}

fn demux_duration_us(d: *mut Demux) -> i64 {
    var best: i64 = 0
    var t: i32 = 0
    let n: i32 = demux_ntracks(d)
    while t < n {
        let v: i64 = demux_track_duration_us(d, t)
        if v > best {
            best = v
        }
        t = t + 1
    }
    return best
}

fn demux_seek_sync(d: *mut Demux, t: i32, target_us: i64) -> usize {
    let n: usize = demux_nsamples(d, t)
    var best: usize = 0
    var i: usize = 0
    while i < n {
        if demux_sample_sync(d, t, i) {
            if demux_sample_pts_us(d, t, i) > target_us {
                return best
            }
            best = i
        }
        i = i + 1
    }
    return best
}

fn demux_track_skip_us(d: *mut Demux, t: i32) -> i64 {
    if t < 0 || t >= demux_ntracks(d) {
        return 0
    }
    if (*d).fmt == FMT_MP4 {
        let k: i64 = mp4.mp4_skip(&(*d).mp4, t)
        if k <= 0 {
            return 0
        }
        return ticks_to_us(k, mp4.mp4_timescale(&(*d).mp4, t))
    }
    return (webm.webm_delay_ns(&(*d).webm, t) / 1000) as i64
}
