// SPDX-License-Identifier: MPL-2.0
import std.time

export {
    Clock, clock_new, clock_set_rate, clock_reset, clock_advance, clock_set_latency, clock_pause, clock_resume,
    clock_use_wall, clock_samples, clock_seconds, clock_millis, clock_is_paused, clock_rate,
}

struct Clock {
    rate: u32,
    written: u64,
    latency: u64,
    base: u64,
    wall: bool,
    wall_start: u64,
    wall_pause: u64,
    paused: bool,
}

fn clock_new(rate: u32) -> Clock {
    return Clock { rate: rate, written: 0 as u64, latency: 0 as u64, base: 0 as u64, wall: false,
        wall_start: 0 as u64, wall_pause: 0 as u64, paused: false }
}

fn clock_set_rate(c: *mut Clock, rate: u32) {
    (*c).rate = rate
}

fn clock_rate(c: *mut Clock) -> u32 {
    return (*c).rate
}

fn clock_reset(c: *mut Clock, at_sample: u64) {
    (*c).base = at_sample
    (*c).written = 0 as u64
    (*c).wall_start = time.monotonic_ns()
    (*c).wall_pause = 0 as u64
}

fn clock_advance(c: *mut Clock, frames: u64) {
    (*c).written = (*c).written + frames
}

fn clock_set_latency(c: *mut Clock, frames: u64) {
    (*c).latency = frames
}

fn clock_use_wall(c: *mut Clock, on: bool) {
    if on && !(*c).wall {
        (*c).wall_start = time.monotonic_ns()
    }
    (*c).wall = on
}

fn clock_pause(c: *mut Clock) {
    if (*c).paused {
        return
    }
    if (*c).wall {
        (*c).wall_pause = time.monotonic_ns()
    }
    (*c).paused = true
}

fn clock_resume(c: *mut Clock) {
    if !(*c).paused {
        return
    }
    if (*c).wall {
        (*c).wall_start = (*c).wall_start + (time.monotonic_ns() - (*c).wall_pause)
    }
    (*c).paused = false
}

fn clock_is_paused(c: *mut Clock) -> bool {
    return (*c).paused
}

fn clock_samples(c: *mut Clock) -> u64 {
    if (*c).wall {
        var t: u64 = time.monotonic_ns()
        if (*c).paused {
            t = (*c).wall_pause
        }
        let el: u64 = t - (*c).wall_start
        return (*c).base + el / 1000000 as u64 * ((*c).rate as u64) / 1000 as u64
            + (el % 1000000 as u64) * ((*c).rate as u64) / 1000000000 as u64
    }
    if (*c).written <= (*c).latency {
        return (*c).base
    }
    return (*c).base + (*c).written - (*c).latency
}

fn clock_seconds(c: *mut Clock) -> f64 {
    if (*c).rate == 0 as u32 {
        return 0.0
    }
    return (clock_samples(c) as f64) / ((*c).rate as f64)
}

fn clock_millis(c: *mut Clock) -> u64 {
    if (*c).rate == 0 as u32 {
        return 0 as u64
    }
    return clock_samples(c) * 1000 as u64 / ((*c).rate as u64)
}
