// SPDX-License-Identifier: MPL-2.0
import std.rt

export {
    ebml_byte, ebml_id, ebml_size, ebml_uint, ebml_u32, ebml_i64, ebml_sint16, ebml_float, ebml_vint_len,
    ebml_vint_value, ebml_signed_delta, SIZE_UNKNOWN,
}

const SIZE_UNKNOWN: u64 = 18446744073709551615

fn ebml_byte(d: u64, o: usize) -> u32 {
    return (rt.ld8(d, o)) as u32
}

fn ebml_vint_len(b: u32) -> usize {
    var m: u32 = 0x80
    var l: usize = 1
    while l <= 8 {
        if (b & m) != 0 {
            return l
        }
        m = m >> 1
        l = l + 1
    }
    return 0
}

fn ebml_vint_value(d: u64, pos: usize, len: usize) -> u64 {
    var v: u64 = (ebml_byte(d, pos) & (((0xFF as u32) >> (len as u32)))) as u64
    var i: usize = 1
    while i < len {
        v = (v << 8) | (ebml_byte(d, pos + i) as u64)
        i = i + 1
    }
    return v
}

fn ebml_id(d: u64, pos: usize, end: usize, id: *mut u32, len: *mut usize) -> i32 {
    if pos >= end {
        return 0
    }
    let l: usize = ebml_vint_len(ebml_byte(d, pos))
    if l == 0 || l > 4 {
        return -1
    }
    if pos + l > end {
        return 0
    }
    var v: u32 = 0
    var i: usize = 0
    while i < l {
        v = (v << 8) | ebml_byte(d, pos + i)
        i = i + 1
    }
    *id = v
    *len = l
    return 1
}

fn ebml_size(d: u64, pos: usize, end: usize, size: *mut u64, len: *mut usize) -> i32 {
    if pos >= end {
        return 0
    }
    let l: usize = ebml_vint_len(ebml_byte(d, pos))
    if l == 0 {
        return -1
    }
    if pos + l > end {
        return 0
    }
    var v: u64 = ebml_vint_value(d, pos, l)
    var all: u64 = 1
    all = (all << ((l * 7) as u64)) - 1
    if v == all {
        v = SIZE_UNKNOWN
    }
    *size = v
    *len = l
    return 1
}

fn ebml_uint(d: u64, pos: usize, n: usize) -> u64 {
    var v: u64 = 0
    var i: usize = 0
    while i < n && i < 8 {
        v = (v << 8) | (ebml_byte(d, pos + i) as u64)
        i = i + 1
    }
    return v
}

fn ebml_u32(d: u64, pos: usize, n: usize) -> u32 {
    let v: u64 = ebml_uint(d, pos, n)
    if v > 4294967295 as u64 {
        return 4294967295
    }
    return v as u32
}

fn ebml_i64(d: u64, pos: usize, n: usize) -> i64 {
    let v: u64 = ebml_uint(d, pos, n)
    if v > 9223372036854775807 as u64 {
        return 9223372036854775807
    }
    return v as i64
}

fn ebml_sint16(d: u64, pos: usize) -> i32 {
    let v: u32 = (ebml_byte(d, pos) << 8) | ebml_byte(d, pos + 1)
    if v >= 32768 {
        return (v as i32) - 65536
    }
    return v as i32
}

fn ebml_float(d: u64, pos: usize, n: usize) -> f64 {
    if n != 4 && n != 8 {
        return 0.0
    }
    var tmp: [u8; 8] = [0 as u8; 8]
    var i: usize = 0
    while i < n {
        tmp[i] = rt.ld8(d, pos + n - 1 - i)
        i = i + 1
    }
    let p: u64 = (&tmp[0]) as u64
    if n == 4 {
        let f: f32 = *(p as *mut f32)
        return f as f64
    }
    return *(p as *mut f64)
}

fn ebml_signed_delta(raw: u64, len: usize) -> i64 {
    var bias: u64 = 1
    bias = (bias << ((len * 7 - 1) as u64)) - 1
    return (raw as i64) - (bias as i64)
}
