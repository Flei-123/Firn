import std.rt
import std.math
import media.audio.aac.aac_tables
import media.audio.aac.aac_bits
import media.audio.aac.aac_huff
import media.audio.aac.aac_state
import media.audio.aac.aac_win

export { aac_adts_frame, aac_channels, aac_config, aac_config_adts, aac_free, aac_hz, aac_init, aac_new, aac_reset }

fn aac_new() -> aac_state.Aac {
    var d: aac_state.Aac = aac_state.Aac {
        sr_idx: 4, hz: 44100, ch: 2,
        br: aac_state.Br { buf: 0, pos: 0, end: 0 },
        ready: 0, trie: 0, trie_total: 0, trie_off: [0; 12],
        pow43: 0, gain_tab: 0,
        win_sine_l: 0, win_sine_s: 0, win_kbd_l: 0, win_kbd_s: 0,
        tw_pre_l: 0, tw_post_l: 0, tw_pre_s: 0, tw_post_s: 0,
        fft_cos_l: 0, fft_sin_l: 0, fft_cos_s: 0, fft_sin_s: 0,
        overlap: 0, prev_shape: [0; 2], quant: 0, spec: 0, tmp: 0, tmp2: 0,
        ics: [aac_state.ics_new(); 2], ms_present: 0, rng: 0x1f2e3d4c,
        out_pcm: 0, out_n: 0, elems: 0,
    }
    return d
}

fn aac_init(d: *mut aac_state.Aac) {
    if (*d).trie != 0 {
        return
    }

    var total: usize = 0
    var cbi: usize = 0
    while cbi < 12 {
        var nsym: usize = 121
        if cbi > 0 {
            nsym = (aac_tables.aac_cb_off(cbi) - aac_tables.aac_cb_off(cbi - 1)) as% usize
        }
        (*d).trie_off[cbi] = total as% u32
        total = total + 2 * (nsym + 2)
        cbi = cbi + 1
    }
    (*d).trie_total = total
    (*d).trie = aac_state.heap_zero(total * 4)
    var next: i32 = 1
    var s: usize = 0
    while s < 121 {
        aac_huff.trie_add((*d).trie, (*d).trie_off[0] as% usize, &next, s, aac_tables.aac_sf_codes(s), aac_tables.aac_sf_bits(s) as% u32)
        s = s + 1
    }
    cbi = 1
    while cbi < 12 {
        next = 1
        let o0: usize = aac_tables.aac_cb_off(cbi - 1) as% usize
        let o1: usize = aac_tables.aac_cb_off(cbi) as% usize
        var k: usize = o0
        while k < o1 {
            aac_huff.trie_add((*d).trie, (*d).trie_off[cbi] as% usize, &next, k - o0,
                aac_tables.aac_codes(k) as% u32, aac_tables.aac_bits(k) as% u32)
            k = k + 1
        }
        cbi = cbi + 1
    }

    (*d).pow43 = aac_state.heap_zero(8192 * 4)
    var q: usize = 0
    while q < 8192 {
        aac_state.stf((*d).pow43, q, math.powf(q as f64, 4.0 / 3.0) as f32)
        q = q + 1
    }
    (*d).gain_tab = aac_state.heap_zero(256 * 4)
    var g: usize = 0
    while g < 256 {
        aac_state.stf((*d).gain_tab, g, math.powf(2.0, (((g as f64) - 100.0) * 0.25)) as f32)
        g = g + 1
    }

    (*d).win_sine_l = aac_state.heap_zero(aac_state.FRAME * 4)
    (*d).win_sine_s = aac_state.heap_zero(aac_state.SHORT * 4)
    (*d).win_kbd_l = aac_state.heap_zero(aac_state.FRAME * 4)
    (*d).win_kbd_s = aac_state.heap_zero(aac_state.SHORT * 4)
    var n: usize = 0
    while n < aac_state.FRAME {
        aac_state.stf((*d).win_sine_l, n, math.sin(3.14159265358979323846 * ((n as f64) + 0.5) / 2048.0) as f32)
        n = n + 1
    }
    n = 0
    while n < aac_state.SHORT {
        aac_state.stf((*d).win_sine_s, n, math.sin(3.14159265358979323846 * ((n as f64) + 0.5) / 256.0) as f32)
        n = n + 1
    }
    aac_win.kbd_window((*d).win_kbd_l, aac_state.FRAME, 4.0)
    aac_win.kbd_window((*d).win_kbd_s, aac_state.SHORT, 6.0)
    (*d).tw_pre_l = aac_state.heap_zero(aac_state.FRAME * 4)
    (*d).tw_post_l = aac_state.heap_zero(aac_state.FRAME * 4)
    (*d).fft_cos_l = aac_state.heap_zero(aac_state.FRAME * 2)
    (*d).fft_sin_l = aac_state.heap_zero(aac_state.FRAME * 2)
    aac_win.make_twiddles(aac_state.FRAME, (*d).tw_pre_l, (*d).tw_post_l, (*d).fft_cos_l, (*d).fft_sin_l)
    (*d).tw_pre_s = aac_state.heap_zero(aac_state.SHORT * 4)
    (*d).tw_post_s = aac_state.heap_zero(aac_state.SHORT * 4)
    (*d).fft_cos_s = aac_state.heap_zero(aac_state.SHORT * 2)
    (*d).fft_sin_s = aac_state.heap_zero(aac_state.SHORT * 2)
    aac_win.make_twiddles(aac_state.SHORT, (*d).tw_pre_s, (*d).tw_post_s, (*d).fft_cos_s, (*d).fft_sin_s)
    (*d).overlap = aac_state.heap_zero(2 * aac_state.FRAME * 4)
    (*d).quant = aac_state.heap_zero(2 * aac_state.FRAME * 4)
    (*d).spec = aac_state.heap_zero(2 * aac_state.FRAME * 4)
    (*d).tmp = aac_state.heap_zero(65536)
    (*d).tmp2 = aac_state.heap_zero(4 * aac_state.FRAME * 4)
}

fn aac_free(d: *mut aac_state.Aac) {
    if (*d).trie == 0 {
        return
    }
    rt.heap_free((*d).trie, (*d).trie_total * 4)
    rt.heap_free((*d).pow43, 8192 * 4)
    rt.heap_free((*d).gain_tab, 256 * 4)
    rt.heap_free((*d).win_sine_l, aac_state.FRAME * 4)
    rt.heap_free((*d).win_sine_s, aac_state.SHORT * 4)
    rt.heap_free((*d).win_kbd_l, aac_state.FRAME * 4)
    rt.heap_free((*d).win_kbd_s, aac_state.SHORT * 4)
    rt.heap_free((*d).tw_pre_l, aac_state.FRAME * 4)
    rt.heap_free((*d).tw_post_l, aac_state.FRAME * 4)
    rt.heap_free((*d).fft_cos_l, aac_state.FRAME * 2)
    rt.heap_free((*d).fft_sin_l, aac_state.FRAME * 2)
    rt.heap_free((*d).tw_pre_s, aac_state.SHORT * 4)
    rt.heap_free((*d).tw_post_s, aac_state.SHORT * 4)
    rt.heap_free((*d).fft_cos_s, aac_state.SHORT * 2)
    rt.heap_free((*d).fft_sin_s, aac_state.SHORT * 2)
    rt.heap_free((*d).overlap, 2 * aac_state.FRAME * 4)
    rt.heap_free((*d).quant, 2 * aac_state.FRAME * 4)
    rt.heap_free((*d).spec, 2 * aac_state.FRAME * 4)
    rt.heap_free((*d).tmp, 65536)
    rt.heap_free((*d).tmp2, 4 * aac_state.FRAME * 4)
}

fn aac_reset(d: *mut aac_state.Aac) {
    if (*d).overlap != 0 {
        rt.mem_set((*d).overlap, 0 as% u8, 2 * aac_state.FRAME * 4)
    }
    (*d).prev_shape[0] = 0
    (*d).prev_shape[1] = 0
}

fn aac_channels(d: *mut aac_state.Aac) -> u32 {
    return (*d).ch
}

fn aac_hz(d: *mut aac_state.Aac) -> u32 {
    return (*d).hz
}

fn sr_of_idx(i: u32) -> u32 {
    if i == 0 { return 96000 }
    if i == 1 { return 88200 }
    if i == 2 { return 64000 }
    if i == 3 { return 48000 }
    if i == 4 { return 44100 }
    if i == 5 { return 32000 }
    if i == 6 { return 24000 }
    if i == 7 { return 22050 }
    if i == 8 { return 16000 }
    if i == 9 { return 12000 }
    if i == 10 { return 11025 }
    if i == 11 { return 8000 }
    if i == 12 { return 7350 }
    return 0
}

fn aac_config(d: *mut aac_state.Aac, asc: u64, n: usize) -> i32 {
    if n < 2 {
        return 2
    }
    var b: aac_state.Br = aac_state.Br { buf: asc, pos: 0, end: (n * 8) as% i32 }
    var aot: u32 = aac_bits.br_get(&b, 5)
    if aot == 31 {
        aot = 32 + aac_bits.br_get(&b, 6)
    }
    var sfi: u32 = aac_bits.br_get(&b, 4)
    var hz: u32 = 0
    if sfi == 15 {
        hz = aac_bits.br_get(&b, 24)
        sfi = 4

        var i: u32 = 0
        while i < 13 {
            if sr_of_idx(i) == hz {
                sfi = i
            }
            i = i + 1
        }
    } else {
        hz = sr_of_idx(sfi)
    }
    let chcfg: u32 = aac_bits.br_get(&b, 4)
    if aot == 5 || aot == 29 {

        let ext: u32 = aac_bits.br_get(&b, 4)
        if ext == 15 {
            aac_bits.br_get(&b, 24)
        }
        aot = aac_bits.br_get(&b, 5)
        if aot == 31 {
            aot = 32 + aac_bits.br_get(&b, 6)
        }
    }
    if aot != 2 {
        return 1
    }
    let frame_len_flag: u32 = aac_bits.br_get(&b, 1)
    if frame_len_flag != 0 {
        return 1
    }
    if sfi > 12 || hz == 0 {
        return 2
    }
    aac_init(d)
    (*d).sr_idx = sfi
    (*d).hz = hz
    if chcfg == 1 {
        (*d).ch = 1
    } else {
        if chcfg >= 2 && chcfg <= 7 {
            (*d).ch = 2
        } else {
            return 1
        }
    }
    (*d).ready = 1
    return 0
}

fn aac_adts_frame(p: u64, n: usize, sr_idx: *mut u32, chcfg: *mut u32, hdr_len: *mut usize) -> usize {
    if n < 7 {
        return 0
    }
    if aac_state.ldb(p, 0) != 0xFF {
        return 0
    }
    if (aac_state.ldb(p, 1) & 0xF6) != 0xF0 {
        return 0
    }
    let prot_absent: u32 = aac_state.ldb(p, 1) & 1
    let aot_m1: u32 = (aac_state.ldb(p, 2) >> 6) & 3
    let sfi: u32 = (aac_state.ldb(p, 2) >> 2) & 15
    let cc: u32 = ((aac_state.ldb(p, 2) & 1) << 2) | (aac_state.ldb(p, 3) >> 6)
    let flen: usize = (((aac_state.ldb(p, 3) & 3) << 11) | (aac_state.ldb(p, 4) << 3) | (aac_state.ldb(p, 5) >> 5)) as% usize
    if sfi > 12 || aot_m1 != 1 {
        return 0
    }
    var hl: usize = 7
    if prot_absent == 0 {
        hl = 9
    }
    if flen < hl {
        return 0
    }
    *sr_idx = sfi
    *chcfg = cc
    *hdr_len = hl
    return flen
}

fn aac_config_adts(d: *mut aac_state.Aac, sr_idx: u32, chcfg: u32) -> i32 {
    if sr_idx > 12 {
        return 2
    }
    aac_init(d)
    (*d).sr_idx = sr_idx
    (*d).hz = sr_of_idx(sr_idx)
    if chcfg == 1 {
        (*d).ch = 1
    } else {
        if chcfg >= 2 && chcfg <= 7 {
            (*d).ch = 2
        } else {
            return 1
        }
    }
    (*d).ready = 1
    return 0
}
