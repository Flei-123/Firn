import std.rt
import std.math
import media.audio.aac.aac_state

export { kbd_window, make_twiddles }

fn bessel_i0(x: f64) -> f64 {
    var sum: f64 = 1.0
    var term: f64 = 1.0
    var k: f64 = 1.0
    while k < 60.0 {
        term = term * (x / (2.0 * k)) * (x / (2.0 * k))
        sum = sum + term
        k = k + 1.0
    }
    return sum
}

fn kbd_window(out: u64, l: usize, alpha: f64) {

    let cum: u64 = aac_state.heap_zero((l + 2) * 8)
    var total: f64 = 0.0
    var j: usize = 0
    while j <= l {
        let r: f64 = (2.0 * (j as f64)) / (l as f64) - 1.0
        var arg: f64 = 1.0 - r * r
        if arg < 0.0 {
            arg = 0.0
        }
        let w: f64 = bessel_i0(3.14159265358979323846 * alpha * math.sqrt(arg))
        total = total + w
        *((cum + (j * 8) as% u64) as *mut f64) = total
        j = j + 1
    }
    var n: usize = 0
    while n < l {
        let c: f64 = *((cum + (n * 8) as% u64) as *mut f64)
        aac_state.stf(out, n, math.sqrt(c / total) as f32)
        n = n + 1
    }
    rt.heap_free(cum, (l + 2) * 8)
}

fn make_twiddles(m: usize, pre: u64, post: u64, fc: u64, fs: u64) {

    let h: usize = m / 2
    var k: usize = 0
    while k < h {
        let a: f64 = 3.14159265358979323846 * ((4 * k + 1) as f64) / ((4 * m) as f64)
        aac_state.stf(pre, 2 * k, math.cos(a) as f32)
        aac_state.stf(pre, 2 * k + 1, (0.0 - math.sin(a)) as f32)
        let b: f64 = 3.14159265358979323846 * (k as f64) / (m as f64)
        aac_state.stf(post, 2 * k, math.cos(b) as f32)
        aac_state.stf(post, 2 * k + 1, (0.0 - math.sin(b)) as f32)
        let c: f64 = 6.28318530717958647692 * (k as f64) / (h as f64)
        aac_state.stf(fc, k, math.cos(c) as f32)
        aac_state.stf(fs, k, (0.0 - math.sin(c)) as f32)
        k = k + 1
    }
}
