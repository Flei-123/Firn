import media.audio.aac.aac_tables
import media.audio.aac.aac_sect
import media.audio.aac.aac_state

export { tns }

fn tns(d: *mut aac_state.Aac, c: usize) {
    let sp: u64 = (*d).spec + (c * aac_state.FRAME * 4) as% u64
    var maxb: u32 = 0
    if (*d).ics[c].seq == aac_state.EIGHT_SHORT {
        maxb = aac_tables.aac_tns_max_short((*d).sr_idx as% usize) as% u32
    } else {
        maxb = aac_tables.aac_tns_max_long((*d).sr_idx as% usize) as% u32
    }
    var w: u32 = 0
    while w < (*d).ics[c].nwin {
        if (*d).ics[c].tns_n[w as% usize] != 0 {
            var bottom: u32 = (*d).ics[c].nswb
            var f: u32 = 0
            while f < (*d).ics[c].tns_n[w as% usize] {
                let fi: usize = (w * 3 + f) as% usize
                let top: u32 = bottom
                var len: u32 = (*d).ics[c].tns_len[fi]
                if len > top {
                    len = top
                }
                bottom = top - len
                var order: u32 = (*d).ics[c].tns_ord[fi]
                if order > 20 {
                    order = 20
                }
                if order != 0 {

                    let mapi: usize = (((*d).ics[c].tns_cmp[fi] * 2 + (*d).ics[c].tns_res[w as% usize]) * 16) as% usize
                    let lpc: u64 = (*d).tmp2
                    let bb: u64 = (*d).tmp2 + 256

                    aac_state.stf(lpc, 0, 1.0)
                    var m: u32 = 1
                    while m <= order {
                        let ci: u32 = (*d).ics[c].tns_coef[fi * 20 + ((m - 1) as% usize)]
                        let kcoef: f32 = 0.0 - aac_tables.aac_tns_map(mapi + (ci as% usize))
                        aac_state.stf(lpc, m as% usize, kcoef)
                        var i: u32 = 1
                        while i < m {
                            aac_state.stf(bb, i as% usize, aac_state.ldf(lpc, i as% usize) + kcoef * aac_state.ldf(lpc, (m - i) as% usize))
                            i = i + 1
                        }
                        i = 1
                        while i < m {
                            aac_state.stf(lpc, i as% usize, aac_state.ldf(bb, i as% usize))
                            i = i + 1
                        }
                        m = m + 1
                    }

                    var s_b: u32 = bottom
                    var e_b: u32 = top
                    if s_b > maxb {
                        s_b = maxb
                    }
                    if e_b > maxb {
                        e_b = maxb
                    }
                    if s_b > (*d).ics[c].max_sfb {
                        s_b = (*d).ics[c].max_sfb
                    }
                    if e_b > (*d).ics[c].max_sfb {
                        e_b = (*d).ics[c].max_sfb
                    }
                    let start: u32 = aac_sect.swb_off(d, c, s_b)
                    let end: u32 = aac_sect.swb_off(d, c, e_b)
                    if end > start {
                        var wbase: u32 = 0
                        if (*d).ics[c].seq == aac_state.EIGHT_SHORT {
                            wbase = w * 128
                        }

                        let st: u64 = (*d).tmp2 + 512
                        var z: u32 = 0
                        while z < 24 {
                            aac_state.stf(st, z as% usize, 0.0)
                            z = z + 1
                        }
                        var n: u32 = 0
                        let size: u32 = end - start
                        while n < size {
                            var pos: u32 = 0
                            if (*d).ics[c].tns_dir[fi] != 0 {
                                pos = wbase + end - 1 - n
                            } else {
                                pos = wbase + start + n
                            }
                            var y: f32 = aac_state.ldf(sp, pos as% usize)
                            var j: u32 = 0
                            while j < order {
                                y = y - aac_state.ldf(lpc, (j + 1) as% usize) * aac_state.ldf(st, j as% usize)
                                j = j + 1
                            }

                            var j2: u32 = order
                            while j2 > 1 {
                                aac_state.stf(st, (j2 - 1) as% usize, aac_state.ldf(st, (j2 - 2) as% usize))
                                j2 = j2 - 1
                            }
                            aac_state.stf(st, 0, y)
                            aac_state.stf(sp, pos as% usize, y)
                            n = n + 1
                        }
                    }
                }
                f = f + 1
            }
        }
        w = w + 1
    }
}
