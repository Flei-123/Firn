// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.math
import media.audio.aac.aac_tables

export {
    Aac, aac_new, aac_init, aac_free, aac_reset, aac_config, aac_config_adts, aac_decode, aac_adts_frame,
    aac_channels, aac_hz,
}

const FRAME: usize = 1024
const SHORT: usize = 128

const ONLY_LONG: u32 = 0
const LONG_START: u32 = 1
const EIGHT_SHORT: u32 = 2
const LONG_STOP: u32 = 3

const ID_SCE: u32 = 0
const ID_CPE: u32 = 1
const ID_CCE: u32 = 2
const ID_LFE: u32 = 3
const ID_DSE: u32 = 4
const ID_PCE: u32 = 5
const ID_FIL: u32 = 6
const ID_END: u32 = 7

const ZERO_HCB: u8 = 0
const NOISE_HCB: u8 = 13
const INTENSITY_HCB2: u8 = 14
const INTENSITY_HCB: u8 = 15

struct Br {
    buf: u64,
    pos: i32,
    end: i32,
}

struct AacIcs {
    seq: u32,
    shape: u32,
    max_sfb: u32,
    ngroups: u32,
    glen: [u32; 8],
    nwin: u32,
    nswb: u32,
    gain: i32,
    cb: [u8; 512],
    sf: [i32; 512],
    ms: [u8; 512],
    pulse_n: u32,
    pulse_start: u32,
    pulse_off: [u32; 4],
    pulse_amp: [u32; 4],
    tns_n: [u32; 8],
    tns_res: [u32; 8],
    tns_len: [u32; 24],
    tns_ord: [u32; 24],
    tns_dir: [u32; 24],
    tns_cmp: [u32; 24],
    tns_coef: [u32; 480],
}

struct Aac {
    sr_idx: u32,
    hz: u32,
    ch: u32,
    br: Br,
    ready: i32,
    trie: u64,
    trie_total: usize,
    trie_off: [u32; 12],
    pow43: u64,
    gain_tab: u64,
    win_sine_l: u64,
    win_sine_s: u64,
    win_kbd_l: u64,
    win_kbd_s: u64,
    tw_pre_l: u64,
    tw_post_l: u64,
    tw_pre_s: u64,
    tw_post_s: u64,
    fft_cos_l: u64,
    fft_sin_l: u64,
    fft_cos_s: u64,
    fft_sin_s: u64,
    overlap: u64,
    prev_shape: [u32; 2],
    quant: u64,
    spec: u64,
    tmp: u64,
    tmp2: u64,
    ics: [AacIcs; 2],
    ms_present: u32,
    rng: u32,
    out_pcm: u64,
    out_n: i32,
    elems: i32,
}

fn ics_new() -> AacIcs {
    return AacIcs { seq: 0, shape: 0, max_sfb: 0, ngroups: 1, glen: [0; 8], nwin: 1, nswb: 0, gain: 0,
        cb: [0 as% u8; 512], sf: [0; 512], ms: [0 as% u8; 512],
        pulse_n: 0, pulse_start: 0, pulse_off: [0; 4], pulse_amp: [0; 4],
        tns_n: [0; 8], tns_res: [0; 8], tns_len: [0; 24], tns_ord: [0; 24], tns_dir: [0; 24],
        tns_cmp: [0; 24], tns_coef: [0; 480] }
}

fn ldf(p: u64, i: usize) -> f32 {
    return *((p + (i * 4) as% u64) as *mut f32)
}

fn stf(p: u64, i: usize, v: f32) {
    *((p + (i * 4) as% u64) as *mut f32) = v
}

fn ldi(p: u64, i: usize) -> i32 {
    return *((p + (i * 4) as% u64) as *mut i32)
}

fn sti(p: u64, i: usize, v: i32) {
    *((p + (i * 4) as% u64) as *mut i32) = v
}

fn ldb(p: u64, i: usize) -> u32 {
    return (*((p + i as% u64) as *mut u8)) as% u32
}

fn br_get(b: *mut Br, n: i32) -> u32 {
    if n > 64 {
        return br_get(b, n - 64)
    }
    let pos: i32 = (*b).pos
    if pos > (*b).end + 100000 {

        return 0
    }
    (*b).pos = pos + n
    var r: u64 = 0
    if pos + n <= (*b).end {
        if n != 0 {
            let sh: i32 = pos & 7
            let p: u64 = (*b).buf +% ((pos >> 3) as% u64)
            let need: i32 = sh + n
            var v: u64 = (ldb(p, 0) as% u64) << 32
            if need > 8 {
                v = v | ((ldb(p, 1) as% u64) << 24)
            }
            if need > 16 {
                v = v | ((ldb(p, 2) as% u64) << 16)
            }
            if need > 24 {
                v = v | ((ldb(p, 3) as% u64) << 8)
            }
            if need > 32 {
                v = v | (ldb(p, 4) as% u64)
            }
            r = (v >> ((40 - need) as% u64)) & ((1 << (n as% u64)) - 1)
        }
    }
    return r as% u32
}

fn br_get1(b: *mut Br) -> u32 {
    return br_get(b, 1)
}

fn br_left(b: *mut Br) -> i32 {
    return (*b).end - (*b).pos
}

fn heap_zero(n: usize) -> u64 {
    let p: u64 = rt.heap_alloc(n)
    rt.mem_set(p, 0 as% u8, n)
    return p
}

fn trie_add(t: u64, base: usize, next: *mut i32, sym: usize, code: u32, len: u32) {
    var node: i32 = 0
    var i: u32 = 0
    while i < len {
        let bit: u32 = (code >> (len - 1 - i)) & 1
        let slot: usize = base + (node as% usize) * 2 + (bit as% usize)
        if i == len - 1 {
            sti(t, slot, -((sym as% i32) + 1))
        } else {
            var v: i32 = ldi(t, slot)
            if v <= 0 {
                v = *next
                *next = *next + 1
                sti(t, slot, v)
            }
            node = v
        }
        i = i + 1
    }
}

fn bessel_i0(x: f64) -> f64 {
    var sum: f64 = 1.0
    var term: f64 = 1.0
    var k: f64 = 1.0
    while k < 60.0 {
        term = term * (x / (2.0 * k)) * (x / (2.0 * k))
        sum = sum + term
        k = k + 1.0
    }
    return sum
}

fn kbd_window(out: u64, l: usize, alpha: f64) {

    let cum: u64 = heap_zero((l + 2) * 8)
    var total: f64 = 0.0
    var j: usize = 0
    while j <= l {
        let r: f64 = (2.0 * (j as f64)) / (l as f64) - 1.0
        var arg: f64 = 1.0 - r * r
        if arg < 0.0 {
            arg = 0.0
        }
        let w: f64 = bessel_i0(3.14159265358979323846 * alpha * math.sqrt(arg))
        total = total + w
        *((cum + (j * 8) as% u64) as *mut f64) = total
        j = j + 1
    }
    var n: usize = 0
    while n < l {
        let c: f64 = *((cum + (n * 8) as% u64) as *mut f64)
        stf(out, n, math.sqrt(c / total) as f32)
        n = n + 1
    }
    rt.heap_free(cum, (l + 2) * 8)
}

fn make_twiddles(m: usize, pre: u64, post: u64, fc: u64, fs: u64) {

    let h: usize = m / 2
    var k: usize = 0
    while k < h {
        let a: f64 = 3.14159265358979323846 * ((4 * k + 1) as f64) / ((4 * m) as f64)
        stf(pre, 2 * k, math.cos(a) as f32)
        stf(pre, 2 * k + 1, (0.0 - math.sin(a)) as f32)
        let b: f64 = 3.14159265358979323846 * (k as f64) / (m as f64)
        stf(post, 2 * k, math.cos(b) as f32)
        stf(post, 2 * k + 1, (0.0 - math.sin(b)) as f32)
        let c: f64 = 6.28318530717958647692 * (k as f64) / (h as f64)
        stf(fc, k, math.cos(c) as f32)
        stf(fs, k, (0.0 - math.sin(c)) as f32)
        k = k + 1
    }
}

fn aac_new() -> Aac {
    var d: Aac = Aac {
        sr_idx: 4, hz: 44100, ch: 2,
        br: Br { buf: 0, pos: 0, end: 0 },
        ready: 0, trie: 0, trie_total: 0, trie_off: [0; 12],
        pow43: 0, gain_tab: 0,
        win_sine_l: 0, win_sine_s: 0, win_kbd_l: 0, win_kbd_s: 0,
        tw_pre_l: 0, tw_post_l: 0, tw_pre_s: 0, tw_post_s: 0,
        fft_cos_l: 0, fft_sin_l: 0, fft_cos_s: 0, fft_sin_s: 0,
        overlap: 0, prev_shape: [0; 2], quant: 0, spec: 0, tmp: 0, tmp2: 0,
        ics: [ics_new(); 2], ms_present: 0, rng: 0x1f2e3d4c,
        out_pcm: 0, out_n: 0, elems: 0,
    }
    return d
}

fn aac_init(d: *mut Aac) {
    if (*d).trie != 0 {
        return
    }

    var total: usize = 0
    var cbi: usize = 0
    while cbi < 12 {
        var nsym: usize = 121
        if cbi > 0 {
            nsym = (aac_tables.aac_cb_off(cbi) - aac_tables.aac_cb_off(cbi - 1)) as% usize
        }
        (*d).trie_off[cbi] = total as% u32
        total = total + 2 * (nsym + 2)
        cbi = cbi + 1
    }
    (*d).trie_total = total
    (*d).trie = heap_zero(total * 4)
    var next: i32 = 1
    var s: usize = 0
    while s < 121 {
        trie_add((*d).trie, (*d).trie_off[0] as% usize, &next, s, aac_tables.aac_sf_codes(s), aac_tables.aac_sf_bits(s) as% u32)
        s = s + 1
    }
    cbi = 1
    while cbi < 12 {
        next = 1
        let o0: usize = aac_tables.aac_cb_off(cbi - 1) as% usize
        let o1: usize = aac_tables.aac_cb_off(cbi) as% usize
        var k: usize = o0
        while k < o1 {
            trie_add((*d).trie, (*d).trie_off[cbi] as% usize, &next, k - o0,
                aac_tables.aac_codes(k) as% u32, aac_tables.aac_bits(k) as% u32)
            k = k + 1
        }
        cbi = cbi + 1
    }

    (*d).pow43 = heap_zero(8192 * 4)
    var q: usize = 0
    while q < 8192 {
        stf((*d).pow43, q, math.powf(q as f64, 4.0 / 3.0) as f32)
        q = q + 1
    }
    (*d).gain_tab = heap_zero(256 * 4)
    var g: usize = 0
    while g < 256 {
        stf((*d).gain_tab, g, math.powf(2.0, (((g as f64) - 100.0) * 0.25)) as f32)
        g = g + 1
    }

    (*d).win_sine_l = heap_zero(FRAME * 4)
    (*d).win_sine_s = heap_zero(SHORT * 4)
    (*d).win_kbd_l = heap_zero(FRAME * 4)
    (*d).win_kbd_s = heap_zero(SHORT * 4)
    var n: usize = 0
    while n < FRAME {
        stf((*d).win_sine_l, n, math.sin(3.14159265358979323846 * ((n as f64) + 0.5) / 2048.0) as f32)
        n = n + 1
    }
    n = 0
    while n < SHORT {
        stf((*d).win_sine_s, n, math.sin(3.14159265358979323846 * ((n as f64) + 0.5) / 256.0) as f32)
        n = n + 1
    }
    kbd_window((*d).win_kbd_l, FRAME, 4.0)
    kbd_window((*d).win_kbd_s, SHORT, 6.0)
    (*d).tw_pre_l = heap_zero(FRAME * 4)
    (*d).tw_post_l = heap_zero(FRAME * 4)
    (*d).fft_cos_l = heap_zero(FRAME * 2)
    (*d).fft_sin_l = heap_zero(FRAME * 2)
    make_twiddles(FRAME, (*d).tw_pre_l, (*d).tw_post_l, (*d).fft_cos_l, (*d).fft_sin_l)
    (*d).tw_pre_s = heap_zero(SHORT * 4)
    (*d).tw_post_s = heap_zero(SHORT * 4)
    (*d).fft_cos_s = heap_zero(SHORT * 2)
    (*d).fft_sin_s = heap_zero(SHORT * 2)
    make_twiddles(SHORT, (*d).tw_pre_s, (*d).tw_post_s, (*d).fft_cos_s, (*d).fft_sin_s)
    (*d).overlap = heap_zero(2 * FRAME * 4)
    (*d).quant = heap_zero(2 * FRAME * 4)
    (*d).spec = heap_zero(2 * FRAME * 4)
    (*d).tmp = heap_zero(65536)
    (*d).tmp2 = heap_zero(4 * FRAME * 4)
}

fn aac_free(d: *mut Aac) {
    if (*d).trie == 0 {
        return
    }
    rt.heap_free((*d).trie, (*d).trie_total * 4)
    rt.heap_free((*d).pow43, 8192 * 4)
    rt.heap_free((*d).gain_tab, 256 * 4)
    rt.heap_free((*d).win_sine_l, FRAME * 4)
    rt.heap_free((*d).win_sine_s, SHORT * 4)
    rt.heap_free((*d).win_kbd_l, FRAME * 4)
    rt.heap_free((*d).win_kbd_s, SHORT * 4)
    rt.heap_free((*d).tw_pre_l, FRAME * 4)
    rt.heap_free((*d).tw_post_l, FRAME * 4)
    rt.heap_free((*d).fft_cos_l, FRAME * 2)
    rt.heap_free((*d).fft_sin_l, FRAME * 2)
    rt.heap_free((*d).tw_pre_s, SHORT * 4)
    rt.heap_free((*d).tw_post_s, SHORT * 4)
    rt.heap_free((*d).fft_cos_s, SHORT * 2)
    rt.heap_free((*d).fft_sin_s, SHORT * 2)
    rt.heap_free((*d).overlap, 2 * FRAME * 4)
    rt.heap_free((*d).quant, 2 * FRAME * 4)
    rt.heap_free((*d).spec, 2 * FRAME * 4)
    rt.heap_free((*d).tmp, 65536)
    rt.heap_free((*d).tmp2, 4 * FRAME * 4)
}

fn aac_reset(d: *mut Aac) {
    if (*d).overlap != 0 {
        rt.mem_set((*d).overlap, 0 as% u8, 2 * FRAME * 4)
    }
    (*d).prev_shape[0] = 0
    (*d).prev_shape[1] = 0
}

fn aac_channels(d: *mut Aac) -> u32 {
    return (*d).ch
}

fn aac_hz(d: *mut Aac) -> u32 {
    return (*d).hz
}

fn sr_of_idx(i: u32) -> u32 {
    if i == 0 { return 96000 }
    if i == 1 { return 88200 }
    if i == 2 { return 64000 }
    if i == 3 { return 48000 }
    if i == 4 { return 44100 }
    if i == 5 { return 32000 }
    if i == 6 { return 24000 }
    if i == 7 { return 22050 }
    if i == 8 { return 16000 }
    if i == 9 { return 12000 }
    if i == 10 { return 11025 }
    if i == 11 { return 8000 }
    if i == 12 { return 7350 }
    return 0
}

fn aac_config(d: *mut Aac, asc: u64, n: usize) -> i32 {
    if n < 2 {
        return 2
    }
    var b: Br = Br { buf: asc, pos: 0, end: (n * 8) as% i32 }
    var aot: u32 = br_get(&b, 5)
    if aot == 31 {
        aot = 32 + br_get(&b, 6)
    }
    var sfi: u32 = br_get(&b, 4)
    var hz: u32 = 0
    if sfi == 15 {
        hz = br_get(&b, 24)
        sfi = 4

        var i: u32 = 0
        while i < 13 {
            if sr_of_idx(i) == hz {
                sfi = i
            }
            i = i + 1
        }
    } else {
        hz = sr_of_idx(sfi)
    }
    let chcfg: u32 = br_get(&b, 4)
    if aot == 5 || aot == 29 {

        let ext: u32 = br_get(&b, 4)
        if ext == 15 {
            br_get(&b, 24)
        }
        aot = br_get(&b, 5)
        if aot == 31 {
            aot = 32 + br_get(&b, 6)
        }
    }
    if aot != 2 {
        return 1
    }
    let frame_len_flag: u32 = br_get(&b, 1)
    if frame_len_flag != 0 {
        return 1
    }
    if sfi > 12 || hz == 0 {
        return 2
    }
    aac_init(d)
    (*d).sr_idx = sfi
    (*d).hz = hz
    if chcfg == 1 {
        (*d).ch = 1
    } else {
        if chcfg >= 2 && chcfg <= 7 {
            (*d).ch = 2
        } else {
            return 1
        }
    }
    (*d).ready = 1
    return 0
}

fn aac_adts_frame(p: u64, n: usize, sr_idx: *mut u32, chcfg: *mut u32, hdr_len: *mut usize) -> usize {
    if n < 7 {
        return 0
    }
    if ldb(p, 0) != 0xFF {
        return 0
    }
    if (ldb(p, 1) & 0xF6) != 0xF0 {
        return 0
    }
    let prot_absent: u32 = ldb(p, 1) & 1
    let aot_m1: u32 = (ldb(p, 2) >> 6) & 3
    let sfi: u32 = (ldb(p, 2) >> 2) & 15
    let cc: u32 = ((ldb(p, 2) & 1) << 2) | (ldb(p, 3) >> 6)
    let flen: usize = (((ldb(p, 3) & 3) << 11) | (ldb(p, 4) << 3) | (ldb(p, 5) >> 5)) as% usize
    if sfi > 12 || aot_m1 != 1 {
        return 0
    }
    var hl: usize = 7
    if prot_absent == 0 {
        hl = 9
    }
    if flen < hl {
        return 0
    }
    *sr_idx = sfi
    *chcfg = cc
    *hdr_len = hl
    return flen
}

fn aac_config_adts(d: *mut Aac, sr_idx: u32, chcfg: u32) -> i32 {
    if sr_idx > 12 {
        return 2
    }
    aac_init(d)
    (*d).sr_idx = sr_idx
    (*d).hz = sr_of_idx(sr_idx)
    if chcfg == 1 {
        (*d).ch = 1
    } else {
        if chcfg >= 2 && chcfg <= 7 {
            (*d).ch = 2
        } else {
            return 1
        }
    }
    (*d).ready = 1
    return 0
}

fn huff_sym(d: *mut Aac, cbi: usize) -> i32 {
    var node: i32 = 0
    let base: usize = (*d).trie_off[cbi] as% usize
    var guard: i32 = 0
    var res: i32 = -1
    var go: i32 = 1
    while go != 0 {
        let bit: u32 = br_get1(&(*d).br)
        let v: i32 = ldi((*d).trie, base + (node as% usize) * 2 + (bit as% usize))
        if v < 0 {
            res = -(v + 1)
            go = 0
        } else {
            if v == 0 {
                go = 0
            } else {
                node = v
            }
        }
        guard = guard + 1
        if guard > 24 {
            go = 0
        }
    }
    return res
}

fn read_ics_info(d: *mut Aac, c: usize) -> i32 {
    br_get1(&(*d).br)
    (*d).ics[c].seq = br_get(&(*d).br, 2)
    (*d).ics[c].shape = br_get1(&(*d).br)
    if (*d).ics[c].seq == EIGHT_SHORT {
        (*d).ics[c].max_sfb = br_get(&(*d).br, 4)
        let grouping: u32 = br_get(&(*d).br, 7)
        (*d).ics[c].nwin = 8
        (*d).ics[c].nswb = aac_tables.aac_num_swb_short((*d).sr_idx as% usize) as% u32
        (*d).ics[c].ngroups = 1
        (*d).ics[c].glen[0] = 1
        var i: u32 = 0
        while i < 7 {
            if ((grouping >> (6 - i)) & 1) == 0 {
                (*d).ics[c].ngroups = (*d).ics[c].ngroups + 1
                (*d).ics[c].glen[((*d).ics[c].ngroups - 1) as% usize] = 1
            } else {
                (*d).ics[c].glen[((*d).ics[c].ngroups - 1) as% usize] = (*d).ics[c].glen[((*d).ics[c].ngroups - 1) as% usize] + 1
            }
            i = i + 1
        }
    } else {
        (*d).ics[c].max_sfb = br_get(&(*d).br, 6)
        (*d).ics[c].nwin = 1
        (*d).ics[c].ngroups = 1
        (*d).ics[c].glen[0] = 1
        (*d).ics[c].nswb = aac_tables.aac_num_swb_long((*d).sr_idx as% usize) as% u32
        let pred: u32 = br_get1(&(*d).br)
        if pred != 0 {
            return 1
        }
    }
    if (*d).ics[c].max_sfb > (*d).ics[c].nswb {
        return 2
    }
    return 0
}

fn swb_off(d: *mut Aac, c: usize, sfb: u32) -> u32 {
    if (*d).ics[c].seq == EIGHT_SHORT {
        return aac_tables.aac_swb_short(((*d).sr_idx as% usize) * 16 + sfb as% usize) as% u32
    }
    return aac_tables.aac_swb_long(((*d).sr_idx as% usize) * 64 + sfb as% usize) as% u32
}

fn read_section_data(d: *mut Aac, c: usize) -> i32 {
    var bits: i32 = 5
    if (*d).ics[c].seq == EIGHT_SHORT {
        bits = 3
    }
    let esc: u32 = (1 << (bits as% u32)) - 1
    var g: u32 = 0
    while g < (*d).ics[c].ngroups {
        var k: u32 = 0
        while k < (*d).ics[c].max_sfb {
            let cb: u32 = br_get(&(*d).br, 4)
            if cb == 12 {
                return 1
            }
            var len: u32 = 0
            var incr: u32 = br_get(&(*d).br, bits)
            while incr == esc {
                len = len + esc
                incr = br_get(&(*d).br, bits)
                if br_left(&(*d).br) < 0 {
                    return 2
                }
            }
            len = len + incr
            if len == 0 || k + len > (*d).ics[c].max_sfb || br_left(&(*d).br) < 0 {
                return 2
            }
            var s: u32 = k
            while s < k + len {
                (*d).ics[c].cb[(g * 64 + s) as% usize] = cb as% u8
                s = s + 1
            }
            k = k + len
        }
        g = g + 1
    }
    return 0
}

fn read_scale_factors(d: *mut Aac, c: usize) -> i32 {
    var sf: i32 = (*d).ics[c].gain
    var is_pos: i32 = 0
    var noise: i32 = (*d).ics[c].gain - 90
    var first_noise: i32 = 1
    var g: u32 = 0
    while g < (*d).ics[c].ngroups {
        var s: u32 = 0
        while s < (*d).ics[c].max_sfb {
            let idx: usize = (g * 64 + s) as% usize
            let cb: u32 = (*d).ics[c].cb[idx] as% u32
            if cb == 0 {
                (*d).ics[c].sf[idx] = 0
            } else {
                if cb == (INTENSITY_HCB as% u32) || cb == (INTENSITY_HCB2 as% u32) {
                    let t: i32 = huff_sym(d, 0)
                    if t < 0 {
                        return 1
                    }
                    is_pos = is_pos + (t - 60)
                    (*d).ics[c].sf[idx] = is_pos
                } else {
                    if cb == (NOISE_HCB as% u32) {
                        if first_noise != 0 {
                            first_noise = 0
                            noise = noise + ((br_get(&(*d).br, 9) as% i32) - 256)
                        } else {
                            let t2: i32 = huff_sym(d, 0)
                            if t2 < 0 {
                                return 1
                            }
                            noise = noise + (t2 - 60)
                        }
                        (*d).ics[c].sf[idx] = noise
                    } else {
                        let t3: i32 = huff_sym(d, 0)
                        if t3 < 0 {
                            return 1
                        }
                        sf = sf + (t3 - 60)
                        if sf < 0 || sf > 255 {
                            return 2
                        }
                        (*d).ics[c].sf[idx] = sf
                    }
                }
            }
            s = s + 1
        }
        g = g + 1
    }
    return 0
}

fn read_pulse(d: *mut Aac, c: usize) -> i32 {
    (*d).ics[c].pulse_n = br_get(&(*d).br, 2) + 1
    (*d).ics[c].pulse_start = br_get(&(*d).br, 6)
    var i: u32 = 0
    while i < (*d).ics[c].pulse_n {
        (*d).ics[c].pulse_off[i as% usize] = br_get(&(*d).br, 5)
        (*d).ics[c].pulse_amp[i as% usize] = br_get(&(*d).br, 4)
        i = i + 1
    }
    if (*d).ics[c].seq == EIGHT_SHORT {
        return 1
    }
    if (*d).ics[c].pulse_start > (*d).ics[c].nswb {
        return 2
    }
    return 0
}

fn read_tns(d: *mut Aac, c: usize) -> i32 {
    var nbits: i32 = 2
    var lbits: i32 = 6
    var obits: i32 = 5
    if (*d).ics[c].seq == EIGHT_SHORT {
        nbits = 1
        lbits = 4
        obits = 3
    }
    var w: u32 = 0
    while w < (*d).ics[c].nwin {
        (*d).ics[c].tns_n[w as% usize] = br_get(&(*d).br, nbits)
        if (*d).ics[c].tns_n[w as% usize] != 0 {
            (*d).ics[c].tns_res[w as% usize] = br_get1(&(*d).br)
            var f: u32 = 0
            while f < (*d).ics[c].tns_n[w as% usize] {
                let fi: usize = (w * 3 + f) as% usize
                (*d).ics[c].tns_len[fi] = br_get(&(*d).br, lbits)
                (*d).ics[c].tns_ord[fi] = br_get(&(*d).br, obits)
                if (*d).ics[c].tns_ord[fi] > 20 {
                    return 1
                }
                if (*d).ics[c].tns_ord[fi] != 0 {
                    (*d).ics[c].tns_dir[fi] = br_get1(&(*d).br)
                    (*d).ics[c].tns_cmp[fi] = br_get1(&(*d).br)
                    let cbits: i32 = 3 + ((*d).ics[c].tns_res[w as% usize] as% i32) - ((*d).ics[c].tns_cmp[fi] as% i32)
                    var i: u32 = 0
                    while i < (*d).ics[c].tns_ord[fi] {
                        (*d).ics[c].tns_coef[fi * 20 + (i as% usize)] = br_get(&(*d).br, cbits)
                        i = i + 1
                    }
                }
                f = f + 1
            }
        }
        w = w + 1
    }
    return 0
}

fn read_spectral(d: *mut Aac, c: usize) -> i32 {
    let q: u64 = (*d).quant + (c * FRAME * 4) as% u64
    rt.mem_set(q, 0 as% u8, FRAME * 4)
    var first_win: u32 = 0
    var g: u32 = 0
    while g < (*d).ics[c].ngroups {
        var s: u32 = 0
        while s < (*d).ics[c].max_sfb {
            let cb: u32 = (*d).ics[c].cb[(g * 64 + s) as% usize] as% u32
            if cb != 0 && cb < 13 {
                let o0: u32 = swb_off(d, c, s)
                let width: u32 = swb_off(d, c, s + 1) - o0
                var win: u32 = 0
                while win < (*d).ics[c].glen[g as% usize] {
                    var base: u32 = o0
                    if (*d).ics[c].seq == EIGHT_SHORT {
                        base = (first_win + win) * 128 + o0
                    }
                    var bin: u32 = 0
                    if cb < 5 {

                        while bin < width {
                            let sym: i32 = huff_sym(d, cb as% usize)
                            if sym < 0 {
                                return 1
                            }
                            var v0: i32 = sym / 27
                            var v1: i32 = (sym / 9) % 3
                            var v2: i32 = (sym / 3) % 3
                            var v3: i32 = sym % 3
                            if cb < 3 {
                                v0 = v0 - 1
                                v1 = v1 - 1
                                v2 = v2 - 1
                                v3 = v3 - 1
                            } else {
                                if v0 != 0 && br_get1(&(*d).br) != 0 {
                                    v0 = -v0
                                }
                                if v1 != 0 && br_get1(&(*d).br) != 0 {
                                    v1 = -v1
                                }
                                if v2 != 0 && br_get1(&(*d).br) != 0 {
                                    v2 = -v2
                                }
                                if v3 != 0 && br_get1(&(*d).br) != 0 {
                                    v3 = -v3
                                }
                            }
                            sti(q, (base + bin) as% usize, v0)
                            sti(q, (base + bin + 1) as% usize, v1)
                            sti(q, (base + bin + 2) as% usize, v2)
                            sti(q, (base + bin + 3) as% usize, v3)
                            bin = bin + 4
                        }
                    } else {

                        var mod_: i32 = 9
                        var off: i32 = 4
                        var signed: i32 = 1
                        if cb == 7 || cb == 8 {
                            mod_ = 8
                            off = 0
                            signed = 0
                        }
                        if cb == 9 || cb == 10 {
                            mod_ = 13
                            off = 0
                            signed = 0
                        }
                        if cb == 11 {
                            mod_ = 17
                            off = 0
                            signed = 0
                        }
                        if cb == 6 {
                            signed = 1
                        }
                        while bin < width {
                            let sym2: i32 = huff_sym(d, cb as% usize)
                            if sym2 < 0 {
                                return 1
                            }
                            var a: i32 = sym2 / mod_ - off
                            var b: i32 = sym2 % mod_ - off
                            if signed == 0 {
                                if a != 0 && br_get1(&(*d).br) != 0 {
                                    a = -a
                                }
                                if b != 0 && br_get1(&(*d).br) != 0 {
                                    b = -b
                                }
                                if cb == 11 {
                                    if a == 16 || a == -16 {
                                        a = read_escape(d, a)
                                    }
                                    if b == 16 || b == -16 {
                                        b = read_escape(d, b)
                                    }
                                }
                            }
                            sti(q, (base + bin) as% usize, a)
                            sti(q, (base + bin + 1) as% usize, b)
                            bin = bin + 2
                        }
                    }
                    if br_left(&(*d).br) < 0 {
                        return 2
                    }
                    win = win + 1
                }
            }
            s = s + 1
        }
        first_win = first_win + (*d).ics[c].glen[g as% usize]
        g = g + 1
    }
    return 0
}

fn read_escape(d: *mut Aac, v: i32) -> i32 {
    var i: i32 = 4
    var go: i32 = 1
    while go != 0 {
        if i >= 16 {
            go = 0
        } else {
            if br_get1(&(*d).br) == 0 {
                go = 0
            } else {
                i = i + 1
            }
        }
    }
    if i >= 16 {
        return v
    }
    let off: i32 = br_get(&(*d).br, i) as% i32
    let j: i32 = off | (1 << (i as% u32))
    if v < 0 {
        return -j
    }
    return j
}

fn read_ics(d: *mut Aac, c: usize, common: i32) -> i32 {
    (*d).ics[c].gain = br_get(&(*d).br, 8) as% i32
    if common == 0 {
        let r0: i32 = read_ics_info(d, c)
        if r0 != 0 {
            return r0
        }
    }
    var i: usize = 0
    while i < 512 {
        (*d).ics[c].cb[i] = 0 as% u8
        (*d).ics[c].sf[i] = 0
        i = i + 1
    }
    let r1: i32 = read_section_data(d, c)
    if r1 != 0 {
        return r1
    }
    let r2: i32 = read_scale_factors(d, c)
    if r2 != 0 {
        return r2
    }
    (*d).ics[c].pulse_n = 0
    if br_get1(&(*d).br) != 0 {
        let r3: i32 = read_pulse(d, c)
        if r3 != 0 {
            return r3
        }
    }
    var w: usize = 0
    while w < 8 {
        (*d).ics[c].tns_n[w] = 0
        w = w + 1
    }
    var tns_present: i32 = 0
    if br_get1(&(*d).br) != 0 {
        tns_present = 1
        let r4: i32 = read_tns(d, c)
        if r4 != 0 {
            return r4
        }
    }
    if br_get1(&(*d).br) != 0 {
        return 1
    }
    let r5: i32 = read_spectral(d, c)
    if r5 != 0 {
        return r5
    }

    if (*d).ics[c].pulse_n > 0 {
        let q: u64 = (*d).quant + (c * FRAME * 4) as% u64
        var pos: u32 = swb_off(d, c, (*d).ics[c].pulse_start)
        var p: u32 = 0
        while p < (*d).ics[c].pulse_n {
            pos = pos + (*d).ics[c].pulse_off[p as% usize]
            if pos < 1024 {
                let cur: i32 = ldi(q, pos as% usize)
                let amp: i32 = (*d).ics[c].pulse_amp[p as% usize] as% i32
                if cur > 0 {
                    sti(q, pos as% usize, cur + amp)
                } else {
                    sti(q, pos as% usize, cur - amp)
                }
            }
            p = p + 1
        }
    }
    return 0
}

fn next_rand(d: *mut Aac) -> u32 {

    (*d).rng = 1664525 as% u32 *% (*d).rng +% 1013904223 as% u32
    return (*d).rng
}

fn dequant(d: *mut Aac, c: usize) {
    let q: u64 = (*d).quant + (c * FRAME * 4) as% u64
    let sp: u64 = (*d).spec + (c * FRAME * 4) as% u64
    rt.mem_set(sp, 0 as% u8, FRAME * 4)
    var first_win: u32 = 0
    var g: u32 = 0
    while g < (*d).ics[c].ngroups {
        var s: u32 = 0
        while s < (*d).ics[c].max_sfb {
            let idx: usize = (g * 64 + s) as% usize
            let cb: u32 = (*d).ics[c].cb[idx] as% u32
            let o0: u32 = swb_off(d, c, s)
            let width: u32 = swb_off(d, c, s + 1) - o0
            var win: u32 = 0
            while win < (*d).ics[c].glen[g as% usize] {
                var base: u32 = o0
                if (*d).ics[c].seq == EIGHT_SHORT {
                    base = (first_win + win) * 128 + o0
                }
                if cb != 0 && cb < 13 {
                    var sf: i32 = (*d).ics[c].sf[idx]
                    if sf < 0 {
                        sf = 0
                    }
                    if sf > 255 {
                        sf = 255
                    }
                    let gain: f32 = ldf((*d).gain_tab, sf as% usize)
                    var k: u32 = 0
                    while k < width {
                        let v: i32 = ldi(q, (base + k) as% usize)
                        if v != 0 {
                            var a: i32 = v
                            if a < 0 {
                                a = -a
                            }
                            var mag: f32 = 0.0
                            if a < 8192 {
                                mag = ldf((*d).pow43, a as% usize)
                            } else {
                                mag = math.powf(a as f64, 4.0 / 3.0) as f32
                            }
                            if v < 0 {
                                stf(sp, (base + k) as% usize, -(mag * gain))
                            } else {
                                stf(sp, (base + k) as% usize, mag * gain)
                            }
                        }
                        k = k + 1
                    }
                } else {
                    if cb == (NOISE_HCB as% u32) {

                        var nsf: i32 = (*d).ics[c].sf[idx]
                        if nsf < -100 {
                            nsf = -100
                        }
                        if nsf > 155 {
                            nsf = 155
                        }
                        var energy: f64 = 0.0
                        var k2: u32 = 0
                        while k2 < width {
                            let r: i32 = next_rand(d) as% i32
                            let rf: f32 = r as f32
                            stf(sp, (base + k2) as% usize, rf)
                            energy = energy + (rf as f64) * (rf as f64)
                            k2 = k2 + 1
                        }
                        if energy > 0.0 {
                            let sc: f32 = ((1.0 / math.sqrt(energy)) * math.powf(2.0, 0.25 * (nsf as f64))) as f32
                            var k3: u32 = 0
                            while k3 < width {
                                stf(sp, (base + k3) as% usize, ldf(sp, (base + k3) as% usize) * sc)
                                k3 = k3 + 1
                            }
                        }
                    }
                }
                win = win + 1
            }
            s = s + 1
        }
        first_win = first_win + (*d).ics[c].glen[g as% usize]
        g = g + 1
    }
}

fn stereo(d: *mut Aac) {
    let l: u64 = (*d).spec
    let r: u64 = (*d).spec + (FRAME * 4) as% u64
    var first_win: u32 = 0
    var g: u32 = 0
    while g < (*d).ics[0].ngroups {
        var s: u32 = 0
        while s < (*d).ics[0].max_sfb {
            let idx: usize = (g * 64 + s) as% usize
            let cb0: u32 = (*d).ics[0].cb[idx] as% u32
            let cb1: u32 = (*d).ics[1].cb[idx] as% u32
            let o0: u32 = swb_off(d, 0, s)
            let width: u32 = swb_off(d, 0, s + 1) - o0
            var win: u32 = 0
            while win < (*d).ics[0].glen[g as% usize] {
                var base: u32 = o0
                if (*d).ics[0].seq == EIGHT_SHORT {
                    base = (first_win + win) * 128 + o0
                }
                if cb1 == (INTENSITY_HCB as% u32) || cb1 == (INTENSITY_HCB2 as% u32) {

                    var sign: f32 = 1.0
                    if cb1 == (INTENSITY_HCB2 as% u32) {
                        sign = -1.0
                    }
                    if (*d).ms_present == 1 && (*d).ics[0].ms[idx] != 0 {
                        sign = -sign
                    }
                    let sc: f32 = (math.powf(0.5, 0.25 * (((*d).ics[1].sf[idx]) as f64)) as f32) * sign
                    var k: u32 = 0
                    while k < width {
                        stf(r, (base + k) as% usize, ldf(l, (base + k) as% usize) * sc)
                        k = k + 1
                    }
                } else {
                    var use_ms: i32 = 0
                    if (*d).ms_present == 2 {
                        use_ms = 1
                    }
                    if (*d).ms_present == 1 && (*d).ics[0].ms[idx] != 0 {
                        use_ms = 1
                    }
                    if cb0 >= 13 || cb1 >= 13 {
                        use_ms = 0
                    }
                    if use_ms != 0 {
                        var k2: u32 = 0
                        while k2 < width {
                            let a: f32 = ldf(l, (base + k2) as% usize)
                            let b: f32 = ldf(r, (base + k2) as% usize)
                            stf(l, (base + k2) as% usize, a + b)
                            stf(r, (base + k2) as% usize, a - b)
                            k2 = k2 + 1
                        }
                    }
                }
                win = win + 1
            }
            s = s + 1
        }
        first_win = first_win + (*d).ics[0].glen[g as% usize]
        g = g + 1
    }
}

fn tns(d: *mut Aac, c: usize) {
    let sp: u64 = (*d).spec + (c * FRAME * 4) as% u64
    var maxb: u32 = 0
    if (*d).ics[c].seq == EIGHT_SHORT {
        maxb = aac_tables.aac_tns_max_short((*d).sr_idx as% usize) as% u32
    } else {
        maxb = aac_tables.aac_tns_max_long((*d).sr_idx as% usize) as% u32
    }
    var w: u32 = 0
    while w < (*d).ics[c].nwin {
        if (*d).ics[c].tns_n[w as% usize] != 0 {
            var bottom: u32 = (*d).ics[c].nswb
            var f: u32 = 0
            while f < (*d).ics[c].tns_n[w as% usize] {
                let fi: usize = (w * 3 + f) as% usize
                let top: u32 = bottom
                var len: u32 = (*d).ics[c].tns_len[fi]
                if len > top {
                    len = top
                }
                bottom = top - len
                var order: u32 = (*d).ics[c].tns_ord[fi]
                if order > 20 {
                    order = 20
                }
                if order != 0 {

                    let mapi: usize = (((*d).ics[c].tns_cmp[fi] * 2 + (*d).ics[c].tns_res[w as% usize]) * 16) as% usize
                    let lpc: u64 = (*d).tmp2
                    let bb: u64 = (*d).tmp2 + 256

                    stf(lpc, 0, 1.0)
                    var m: u32 = 1
                    while m <= order {
                        let ci: u32 = (*d).ics[c].tns_coef[fi * 20 + ((m - 1) as% usize)]
                        let kcoef: f32 = 0.0 - aac_tables.aac_tns_map(mapi + (ci as% usize))
                        stf(lpc, m as% usize, kcoef)
                        var i: u32 = 1
                        while i < m {
                            stf(bb, i as% usize, ldf(lpc, i as% usize) + kcoef * ldf(lpc, (m - i) as% usize))
                            i = i + 1
                        }
                        i = 1
                        while i < m {
                            stf(lpc, i as% usize, ldf(bb, i as% usize))
                            i = i + 1
                        }
                        m = m + 1
                    }

                    var s_b: u32 = bottom
                    var e_b: u32 = top
                    if s_b > maxb {
                        s_b = maxb
                    }
                    if e_b > maxb {
                        e_b = maxb
                    }
                    if s_b > (*d).ics[c].max_sfb {
                        s_b = (*d).ics[c].max_sfb
                    }
                    if e_b > (*d).ics[c].max_sfb {
                        e_b = (*d).ics[c].max_sfb
                    }
                    let start: u32 = swb_off(d, c, s_b)
                    let end: u32 = swb_off(d, c, e_b)
                    if end > start {
                        var wbase: u32 = 0
                        if (*d).ics[c].seq == EIGHT_SHORT {
                            wbase = w * 128
                        }

                        let st: u64 = (*d).tmp2 + 512
                        var z: u32 = 0
                        while z < 24 {
                            stf(st, z as% usize, 0.0)
                            z = z + 1
                        }
                        var n: u32 = 0
                        let size: u32 = end - start
                        while n < size {
                            var pos: u32 = 0
                            if (*d).ics[c].tns_dir[fi] != 0 {
                                pos = wbase + end - 1 - n
                            } else {
                                pos = wbase + start + n
                            }
                            var y: f32 = ldf(sp, pos as% usize)
                            var j: u32 = 0
                            while j < order {
                                y = y - ldf(lpc, (j + 1) as% usize) * ldf(st, j as% usize)
                                j = j + 1
                            }

                            var j2: u32 = order
                            while j2 > 1 {
                                stf(st, (j2 - 1) as% usize, ldf(st, (j2 - 2) as% usize))
                                j2 = j2 - 1
                            }
                            stf(st, 0, y)
                            stf(sp, pos as% usize, y)
                            n = n + 1
                        }
                    }
                }
                f = f + 1
            }
        }
        w = w + 1
    }
}

fn fft(buf: u64, h: usize, fc: u64, fs: u64) {

    var j: usize = 0
    var i: usize = 0
    while i < h - 1 {
        if i < j {
            let ar: f32 = ldf(buf, 2 * i)
            let ai: f32 = ldf(buf, 2 * i + 1)
            stf(buf, 2 * i, ldf(buf, 2 * j))
            stf(buf, 2 * i + 1, ldf(buf, 2 * j + 1))
            stf(buf, 2 * j, ar)
            stf(buf, 2 * j + 1, ai)
        }
        var m: usize = h >> 1
        while m >= 1 && (j & m) != 0 {
            j = j ^ m
            m = m >> 1
        }
        j = j | m
        i = i + 1
    }
    var len: usize = 2
    while len <= h {
        let half: usize = len / 2
        let step: usize = h / len
        var s: usize = 0
        while s < h {
            var k: usize = 0
            while k < half {
                let wr: f32 = ldf(fc, k * step)
                let wi: f32 = ldf(fs, k * step)
                let xr: f32 = ldf(buf, 2 * (s + k + half))
                let xi: f32 = ldf(buf, 2 * (s + k + half) + 1)
                let tr: f32 = xr * wr - xi * wi
                let ti: f32 = xr * wi + xi * wr
                let ur: f32 = ldf(buf, 2 * (s + k))
                let ui: f32 = ldf(buf, 2 * (s + k) + 1)
                stf(buf, 2 * (s + k), ur + tr)
                stf(buf, 2 * (s + k) + 1, ui + ti)
                stf(buf, 2 * (s + k + half), ur - tr)
                stf(buf, 2 * (s + k + half) + 1, ui - ti)
                k = k + 1
            }
            s = s + len
        }
        len = len * 2
    }
}

fn imdct(d: *mut Aac, m: usize, coef: u64, out: u64) {
    var pre: u64 = (*d).tw_pre_l
    var post: u64 = (*d).tw_post_l
    var fc: u64 = (*d).fft_cos_l
    var fs: u64 = (*d).fft_sin_l
    if m == SHORT {
        pre = (*d).tw_pre_s
        post = (*d).tw_post_s
        fc = (*d).fft_cos_s
        fs = (*d).fft_sin_s
    }
    let h: usize = m / 2
    let t: u64 = (*d).tmp2 + 1024
    var k: usize = 0
    while k < h {
        let xr: f32 = ldf(coef, 2 * k)
        let xi: f32 = ldf(coef, m - 1 - 2 * k)
        let cr: f32 = ldf(pre, 2 * k)
        let ci: f32 = ldf(pre, 2 * k + 1)
        stf(t, 2 * k, xr * cr - xi * ci)
        stf(t, 2 * k + 1, xr * ci + xi * cr)
        k = k + 1
    }
    fft(t, h, fc, fs)

    let y: u64 = (*d).tmp2 + 1024 + (m * 4) as% u64
    let sc: f32 = 1.0 / (m as f32)
    k = 0
    while k < h {
        let tr: f32 = ldf(t, 2 * k)
        let ti: f32 = ldf(t, 2 * k + 1)
        let pr: f32 = ldf(post, 2 * k)
        let pi: f32 = ldf(post, 2 * k + 1)
        stf(y, 2 * k, (tr * pr - ti * pi) * sc)
        stf(y, m - 1 - 2 * k, (0.0 - (tr * pi + ti * pr)) * sc)
        k = k + 1
    }

    let hh: usize = m / 2
    var n: usize = 0
    while n < 2 * m {
        if n < hh {
            stf(out, n, ldf(y, hh + n))
        } else {
            if n < 3 * hh {
                stf(out, n, 0.0 - ldf(y, 3 * hh - 1 - n))
            } else {
                stf(out, n, 0.0 - ldf(y, n - 3 * hh))
            }
        }
        n = n + 1
    }
}

fn wrise(d: *mut Aac, shape: u32, long: i32, n: usize) -> f32 {
    if long != 0 {
        if shape != 0 {
            return ldf((*d).win_kbd_l, n)
        }
        return ldf((*d).win_sine_l, n)
    }
    if shape != 0 {
        return ldf((*d).win_kbd_s, n)
    }
    return ldf((*d).win_sine_s, n)
}

fn filterbank(d: *mut Aac, c: usize, out: u64) {
    let sp: u64 = (*d).spec + (c * FRAME * 4) as% u64
    let ov: u64 = (*d).overlap + (c * FRAME * 4) as% u64
    let buf: u64 = (*d).tmp
    let seq: u32 = (*d).ics[c].seq
    let shape: u32 = (*d).ics[c].shape
    let pshape: u32 = (*d).prev_shape[c]
    var n: usize = 0
    if seq != EIGHT_SHORT {
        imdct(d, FRAME, sp, buf)

        n = 0
        while n < 2048 {
            var w: f32 = 1.0
            if n < 1024 {

                if seq == LONG_STOP {
                    if n < 448 {
                        w = 0.0
                    } else {
                        if n < 576 {
                            w = wrise(d, pshape, 0, n - 448)
                        } else {
                            w = 1.0
                        }
                    }
                } else {
                    w = wrise(d, pshape, 1, n)
                }
            } else {

                let r: usize = 2047 - n
                if seq == LONG_START {
                    if n < 1472 {
                        w = 1.0
                    } else {
                        if n < 1600 {
                            w = wrise(d, shape, 0, 2047 - n - 448)
                        } else {
                            w = 0.0
                        }
                    }
                } else {
                    w = wrise(d, shape, 1, r)
                }
            }
            stf(buf, n, ldf(buf, n) * w)
            n = n + 1
        }
        n = 0
        while n < 1024 {
            stf(out, n, ldf(buf, n) + ldf(ov, n))
            stf(ov, n, ldf(buf, 1024 + n))
            n = n + 1
        }
    } else {

        let acc: u64 = (*d).tmp + 8192
        rt.mem_set(acc, 0 as% u8, 2048 * 4)
        let one: u64 = (*d).tmp + 16384
        var wnd: usize = 0
        while wnd < 8 {
            imdct(d, SHORT, sp + (wnd * 128 * 4) as% u64, one)
            var lshape: u32 = shape
            if wnd == 0 {
                lshape = pshape
            }
            n = 0
            while n < 256 {
                var w: f32 = 0.0
                if n < 128 {
                    w = wrise(d, lshape, 0, n)
                } else {
                    w = wrise(d, shape, 0, 255 - n)
                }
                let at: usize = 448 + wnd * 128 + n
                stf(acc, at, ldf(acc, at) + ldf(one, n) * w)
                n = n + 1
            }
            wnd = wnd + 1
        }
        n = 0
        while n < 1024 {
            stf(out, n, ldf(acc, n) + ldf(ov, n))
            stf(ov, n, ldf(acc, 1024 + n))
            n = n + 1
        }
    }
    (*d).prev_shape[c] = shape
}

fn write_pcm(d: *mut Aac, c: usize, ch_total: u32, pcm: u64, src: u64) {
    var n: usize = 0
    while n < 1024 {
        var v: f32 = ldf(src, n)
        if v > 32767.0 {
            v = 32767.0
        }
        if v < -32768.0 {
            v = -32768.0
        }
        var iv: i32 = 0
        if v >= 0.0 {
            iv = (v + 0.5) as i32
        } else {
            iv = (v - 0.5) as i32
        }
        *((pcm + (((n * (ch_total as% usize)) + c) * 2) as% u64) as *mut i16) = iv as% i16
        n = n + 1
    }
}

fn process_sce(d: *mut Aac, pcm: u64, first: i32) -> i32 {
    let r: i32 = read_ics(d, 0, 0)
    if r != 0 {
        return r
    }
    dequant(d, 0)
    tns(d, 0)
    let out: u64 = (*d).tmp + 32768
    filterbank(d, 0, out)
    if first != 0 {
        write_pcm(d, 0, (*d).ch, pcm, out)
        if (*d).ch == 2 {
            write_pcm(d, 1, 2, pcm, out)
        }
    }
    return 0
}

fn process_cpe(d: *mut Aac, pcm: u64, first: i32) -> i32 {
    let common: u32 = br_get1(&(*d).br)
    (*d).ms_present = 0
    if common != 0 {
        let r0: i32 = read_ics_info(d, 0)
        if r0 != 0 {
            return r0
        }

        (*d).ics[1].seq = (*d).ics[0].seq
        (*d).ics[1].shape = (*d).ics[0].shape
        (*d).ics[1].max_sfb = (*d).ics[0].max_sfb
        (*d).ics[1].ngroups = (*d).ics[0].ngroups
        (*d).ics[1].nwin = (*d).ics[0].nwin
        (*d).ics[1].nswb = (*d).ics[0].nswb
        var i: usize = 0
        while i < 8 {
            (*d).ics[1].glen[i] = (*d).ics[0].glen[i]
            i = i + 1
        }
        (*d).ms_present = br_get(&(*d).br, 2)
        if (*d).ms_present == 3 {
            return 1
        }
        i = 0
        while i < 512 {
            (*d).ics[0].ms[i] = 0 as% u8
            i = i + 1
        }
        if (*d).ms_present == 1 {
            var g: u32 = 0
            while g < (*d).ics[0].ngroups {
                var s: u32 = 0
                while s < (*d).ics[0].max_sfb {
                    (*d).ics[0].ms[(g * 64 + s) as% usize] = br_get1(&(*d).br) as% u8
                    s = s + 1
                }
                g = g + 1
            }
        }
    }
    let r1: i32 = read_ics(d, 0, common as% i32)
    if r1 != 0 {
        return r1
    }
    let r2: i32 = read_ics(d, 1, common as% i32)
    if r2 != 0 {
        return r2
    }
    dequant(d, 0)
    dequant(d, 1)
    if common != 0 {
        stereo(d)
    }
    tns(d, 0)
    tns(d, 1)
    let out0: u64 = (*d).tmp + 32768
    let out1: u64 = (*d).tmp + 32768 + 8192
    filterbank(d, 0, out0)
    filterbank(d, 1, out1)
    if first != 0 {
        if (*d).ch == 2 {
            write_pcm(d, 0, 2, pcm, out0)
            write_pcm(d, 1, 2, pcm, out1)
        } else {

            var n: usize = 0
            while n < 1024 {
                stf(out0, n, (ldf(out0, n) + ldf(out1, n)) * 0.5)
                n = n + 1
            }
            write_pcm(d, 0, 1, pcm, out0)
        }
    }
    return 0
}

fn aac_decode(d: *mut Aac, data: u64, n: usize, pcm: u64) -> i32 {
    if (*d).ready == 0 {
        return 0
    }
    (*d).br.buf = data
    (*d).br.pos = 0
    (*d).br.end = (n * 8) as% i32
    rt.mem_set(pcm, 0 as% u8, 1024 * ((*d).ch as% usize) * 2)
    var elems: i32 = 0
    var err: i32 = 0
    var go: i32 = 1
    while go != 0 {
        if br_left(&(*d).br) < 3 {
            go = 0
        } else {
            let id: u32 = br_get(&(*d).br, 3)
            if id == ID_END {
                go = 0
            } else {
                if id == ID_SCE || id == ID_LFE {
                    br_get(&(*d).br, 4)
                    var first: i32 = 0
                    if elems == 0 {
                        first = 1
                    }
                    err = process_sce(d, pcm, first)
                    elems = elems + 1
                } else {
                    if id == ID_CPE {
                        br_get(&(*d).br, 4)
                        var first2: i32 = 0
                        if elems == 0 {
                            first2 = 1
                        }
                        err = process_cpe(d, pcm, first2)
                        elems = elems + 1
                    } else {
                        if id == ID_DSE {
                            br_get(&(*d).br, 4)
                            let align: u32 = br_get1(&(*d).br)
                            var cnt: u32 = br_get(&(*d).br, 8)
                            if cnt == 255 {
                                cnt = cnt + br_get(&(*d).br, 8)
                            }
                            if align != 0 {
                                (*d).br.pos = ((*d).br.pos + 7) & (0 - 8)
                            }
                            (*d).br.pos = (*d).br.pos + ((cnt * 8) as% i32)
                        } else {
                            if id == ID_FIL {
                                var cnt2: u32 = br_get(&(*d).br, 4)
                                if cnt2 == 15 {
                                    cnt2 = cnt2 + br_get(&(*d).br, 8) - 1
                                }
                                (*d).br.pos = (*d).br.pos + ((cnt2 * 8) as% i32)
                            } else {

                                err = 1
                            }
                        }
                    }
                }
                if err != 0 {
                    go = 0
                }
            }
        }
    }
    if err != 0 || elems == 0 {

        rt.mem_set(pcm, 0 as% u8, 1024 * ((*d).ch as% usize) * 2)
        return 0
    }
    return 1024
}
