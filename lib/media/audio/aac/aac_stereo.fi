import std.math
import media.audio.aac.aac_sect
import media.audio.aac.aac_state

export { stereo }

fn stereo(d: *mut aac_state.Aac) {
    let l: u64 = (*d).spec
    let r: u64 = (*d).spec + (aac_state.FRAME * 4) as% u64
    var first_win: u32 = 0
    var g: u32 = 0
    while g < (*d).ics[0].ngroups {
        var s: u32 = 0
        while s < (*d).ics[0].max_sfb {
            let idx: usize = (g * 64 + s) as% usize
            let cb0: u32 = (*d).ics[0].cb[idx] as% u32
            let cb1: u32 = (*d).ics[1].cb[idx] as% u32
            let o0: u32 = aac_sect.swb_off(d, 0, s)
            let width: u32 = aac_sect.swb_off(d, 0, s + 1) - o0
            var win: u32 = 0
            while win < (*d).ics[0].glen[g as% usize] {
                var base: u32 = o0
                if (*d).ics[0].seq == aac_state.EIGHT_SHORT {
                    base = (first_win + win) * 128 + o0
                }
                if cb1 == (aac_state.INTENSITY_HCB as% u32) || cb1 == (aac_state.INTENSITY_HCB2 as% u32) {

                    var sign: f32 = 1.0
                    if cb1 == (aac_state.INTENSITY_HCB2 as% u32) {
                        sign = -1.0
                    }
                    if (*d).ms_present == 1 && (*d).ics[0].ms[idx] != 0 {
                        sign = -sign
                    }
                    let sc: f32 = (math.powf(0.5, 0.25 * (((*d).ics[1].sf[idx]) as f64)) as f32) * sign
                    var k: u32 = 0
                    while k < width {
                        aac_state.stf(r, (base + k) as% usize, aac_state.ldf(l, (base + k) as% usize) * sc)
                        k = k + 1
                    }
                } else {
                    var use_ms: i32 = 0
                    if (*d).ms_present == 2 {
                        use_ms = 1
                    }
                    if (*d).ms_present == 1 && (*d).ics[0].ms[idx] != 0 {
                        use_ms = 1
                    }
                    if cb0 >= 13 || cb1 >= 13 {
                        use_ms = 0
                    }
                    if use_ms != 0 {
                        var k2: u32 = 0
                        while k2 < width {
                            let a: f32 = aac_state.ldf(l, (base + k2) as% usize)
                            let b: f32 = aac_state.ldf(r, (base + k2) as% usize)
                            aac_state.stf(l, (base + k2) as% usize, a + b)
                            aac_state.stf(r, (base + k2) as% usize, a - b)
                            k2 = k2 + 1
                        }
                    }
                }
                win = win + 1
            }
            s = s + 1
        }
        first_win = first_win + (*d).ics[0].glen[g as% usize]
        g = g + 1
    }
}
