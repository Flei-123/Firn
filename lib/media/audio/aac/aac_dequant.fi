import std.rt
import std.math
import media.audio.aac.aac_sect
import media.audio.aac.aac_state

export { dequant }

fn next_rand(d: *mut aac_state.Aac) -> u32 {

    (*d).rng = 1664525 as% u32 *% (*d).rng +% 1013904223 as% u32
    return (*d).rng
}

fn dequant(d: *mut aac_state.Aac, c: usize) {
    let q: u64 = (*d).quant + (c * aac_state.FRAME * 4) as% u64
    let sp: u64 = (*d).spec + (c * aac_state.FRAME * 4) as% u64
    rt.mem_set(sp, 0 as% u8, aac_state.FRAME * 4)
    var first_win: u32 = 0
    var g: u32 = 0
    while g < (*d).ics[c].ngroups {
        var s: u32 = 0
        while s < (*d).ics[c].max_sfb {
            let idx: usize = (g * 64 + s) as% usize
            let cb: u32 = (*d).ics[c].cb[idx] as% u32
            let o0: u32 = aac_sect.swb_off(d, c, s)
            let width: u32 = aac_sect.swb_off(d, c, s + 1) - o0
            var win: u32 = 0
            while win < (*d).ics[c].glen[g as% usize] {
                var base: u32 = o0
                if (*d).ics[c].seq == aac_state.EIGHT_SHORT {
                    base = (first_win + win) * 128 + o0
                }
                if cb != 0 && cb < 13 {
                    var sf: i32 = (*d).ics[c].sf[idx]
                    if sf < 0 {
                        sf = 0
                    }
                    if sf > 255 {
                        sf = 255
                    }
                    let gain: f32 = aac_state.ldf((*d).gain_tab, sf as% usize)
                    var k: u32 = 0
                    while k < width {
                        let v: i32 = aac_state.ldi(q, (base + k) as% usize)
                        if v != 0 {
                            var a: i32 = v
                            if a < 0 {
                                a = -a
                            }
                            var mag: f32 = 0.0
                            if a < 8192 {
                                mag = aac_state.ldf((*d).pow43, a as% usize)
                            } else {
                                mag = math.powf(a as f64, 4.0 / 3.0) as f32
                            }
                            if v < 0 {
                                aac_state.stf(sp, (base + k) as% usize, -(mag * gain))
                            } else {
                                aac_state.stf(sp, (base + k) as% usize, mag * gain)
                            }
                        }
                        k = k + 1
                    }
                } else {
                    if cb == (aac_state.NOISE_HCB as% u32) {

                        var nsf: i32 = (*d).ics[c].sf[idx]
                        if nsf < -100 {
                            nsf = -100
                        }
                        if nsf > 155 {
                            nsf = 155
                        }
                        var energy: f64 = 0.0
                        var k2: u32 = 0
                        while k2 < width {
                            let r: i32 = next_rand(d) as% i32
                            let rf: f32 = r as f32
                            aac_state.stf(sp, (base + k2) as% usize, rf)
                            energy = energy + (rf as f64) * (rf as f64)
                            k2 = k2 + 1
                        }
                        if energy > 0.0 {
                            let sc: f32 = ((1.0 / math.sqrt(energy)) * math.powf(2.0, 0.25 * (nsf as f64))) as f32
                            var k3: u32 = 0
                            while k3 < width {
                                aac_state.stf(sp, (base + k3) as% usize, aac_state.ldf(sp, (base + k3) as% usize) * sc)
                                k3 = k3 + 1
                            }
                        }
                    }
                }
                win = win + 1
            }
            s = s + 1
        }
        first_win = first_win + (*d).ics[c].glen[g as% usize]
        g = g + 1
    }
}
