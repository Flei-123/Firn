import media.audio.aac.aac_bits
import media.audio.aac.aac_state

export { huff_sym, trie_add }

fn trie_add(t: u64, base: usize, next: *mut i32, sym: usize, code: u32, len: u32) {
    var node: i32 = 0
    var i: u32 = 0
    while i < len {
        let bit: u32 = (code >> (len - 1 - i)) & 1
        let slot: usize = base + (node as% usize) * 2 + (bit as% usize)
        if i == len - 1 {
            aac_state.sti(t, slot, -((sym as% i32) + 1))
        } else {
            var v: i32 = aac_state.ldi(t, slot)
            if v <= 0 {
                v = *next
                *next = *next + 1
                aac_state.sti(t, slot, v)
            }
            node = v
        }
        i = i + 1
    }
}

fn huff_sym(d: *mut aac_state.Aac, cbi: usize) -> i32 {
    var node: i32 = 0
    let base: usize = (*d).trie_off[cbi] as% usize
    var guard: i32 = 0
    var res: i32 = -1
    var go: i32 = 1
    while go != 0 {
        let bit: u32 = aac_bits.br_get1(&(*d).br)
        let v: i32 = aac_state.ldi((*d).trie, base + (node as% usize) * 2 + (bit as% usize))
        if v < 0 {
            res = -(v + 1)
            go = 0
        } else {
            if v == 0 {
                go = 0
            } else {
                node = v
            }
        }
        guard = guard + 1
        if guard > 24 {
            go = 0
        }
    }
    return res
}
