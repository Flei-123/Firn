import std.rt
import media.audio.aac.aac_bits
import media.audio.aac.aac_huff
import media.audio.aac.aac_sect
import media.audio.aac.aac_state

export { read_ics }

fn read_spectral(d: *mut aac_state.Aac, c: usize) -> i32 {
    let q: u64 = (*d).quant + (c * aac_state.FRAME * 4) as% u64
    rt.mem_set(q, 0 as% u8, aac_state.FRAME * 4)
    var first_win: u32 = 0
    var g: u32 = 0
    while g < (*d).ics[c].ngroups {
        var s: u32 = 0
        while s < (*d).ics[c].max_sfb {
            let cb: u32 = (*d).ics[c].cb[(g * 64 + s) as% usize] as% u32
            if cb != 0 && cb < 13 {
                let o0: u32 = aac_sect.swb_off(d, c, s)
                let width: u32 = aac_sect.swb_off(d, c, s + 1) - o0
                var win: u32 = 0
                while win < (*d).ics[c].glen[g as% usize] {
                    var base: u32 = o0
                    if (*d).ics[c].seq == aac_state.EIGHT_SHORT {
                        base = (first_win + win) * 128 + o0
                    }
                    var bin: u32 = 0
                    if cb < 5 {

                        while bin < width {
                            let sym: i32 = aac_huff.huff_sym(d, cb as% usize)
                            if sym < 0 {
                                return 1
                            }
                            var v0: i32 = sym / 27
                            var v1: i32 = (sym / 9) % 3
                            var v2: i32 = (sym / 3) % 3
                            var v3: i32 = sym % 3
                            if cb < 3 {
                                v0 = v0 - 1
                                v1 = v1 - 1
                                v2 = v2 - 1
                                v3 = v3 - 1
                            } else {
                                if v0 != 0 && aac_bits.br_get1(&(*d).br) != 0 {
                                    v0 = -v0
                                }
                                if v1 != 0 && aac_bits.br_get1(&(*d).br) != 0 {
                                    v1 = -v1
                                }
                                if v2 != 0 && aac_bits.br_get1(&(*d).br) != 0 {
                                    v2 = -v2
                                }
                                if v3 != 0 && aac_bits.br_get1(&(*d).br) != 0 {
                                    v3 = -v3
                                }
                            }
                            aac_state.sti(q, (base + bin) as% usize, v0)
                            aac_state.sti(q, (base + bin + 1) as% usize, v1)
                            aac_state.sti(q, (base + bin + 2) as% usize, v2)
                            aac_state.sti(q, (base + bin + 3) as% usize, v3)
                            bin = bin + 4
                        }
                    } else {

                        var mod_: i32 = 9
                        var off: i32 = 4
                        var signed: i32 = 1
                        if cb == 7 || cb == 8 {
                            mod_ = 8
                            off = 0
                            signed = 0
                        }
                        if cb == 9 || cb == 10 {
                            mod_ = 13
                            off = 0
                            signed = 0
                        }
                        if cb == 11 {
                            mod_ = 17
                            off = 0
                            signed = 0
                        }
                        if cb == 6 {
                            signed = 1
                        }
                        while bin < width {
                            let sym2: i32 = aac_huff.huff_sym(d, cb as% usize)
                            if sym2 < 0 {
                                return 1
                            }
                            var a: i32 = sym2 / mod_ - off
                            var b: i32 = sym2 % mod_ - off
                            if signed == 0 {
                                if a != 0 && aac_bits.br_get1(&(*d).br) != 0 {
                                    a = -a
                                }
                                if b != 0 && aac_bits.br_get1(&(*d).br) != 0 {
                                    b = -b
                                }
                                if cb == 11 {
                                    if a == 16 || a == -16 {
                                        a = read_escape(d, a)
                                    }
                                    if b == 16 || b == -16 {
                                        b = read_escape(d, b)
                                    }
                                }
                            }
                            aac_state.sti(q, (base + bin) as% usize, a)
                            aac_state.sti(q, (base + bin + 1) as% usize, b)
                            bin = bin + 2
                        }
                    }
                    if aac_bits.br_left(&(*d).br) < 0 {
                        return 2
                    }
                    win = win + 1
                }
            }
            s = s + 1
        }
        first_win = first_win + (*d).ics[c].glen[g as% usize]
        g = g + 1
    }
    return 0
}

fn read_escape(d: *mut aac_state.Aac, v: i32) -> i32 {
    var i: i32 = 4
    var go: i32 = 1
    while go != 0 {
        if i >= 16 {
            go = 0
        } else {
            if aac_bits.br_get1(&(*d).br) == 0 {
                go = 0
            } else {
                i = i + 1
            }
        }
    }
    if i >= 16 {
        return v
    }
    let off: i32 = aac_bits.br_get(&(*d).br, i) as% i32
    let j: i32 = off | (1 << (i as% u32))
    if v < 0 {
        return -j
    }
    return j
}

fn read_ics(d: *mut aac_state.Aac, c: usize, common: i32) -> i32 {
    (*d).ics[c].gain = aac_bits.br_get(&(*d).br, 8) as% i32
    if common == 0 {
        let r0: i32 = aac_sect.read_ics_info(d, c)
        if r0 != 0 {
            return r0
        }
    }
    var i: usize = 0
    while i < 512 {
        (*d).ics[c].cb[i] = 0 as% u8
        (*d).ics[c].sf[i] = 0
        i = i + 1
    }
    let r1: i32 = aac_sect.read_section_data(d, c)
    if r1 != 0 {
        return r1
    }
    let r2: i32 = aac_sect.read_scale_factors(d, c)
    if r2 != 0 {
        return r2
    }
    (*d).ics[c].pulse_n = 0
    if aac_bits.br_get1(&(*d).br) != 0 {
        let r3: i32 = aac_sect.read_pulse(d, c)
        if r3 != 0 {
            return r3
        }
    }
    var w: usize = 0
    while w < 8 {
        (*d).ics[c].tns_n[w] = 0
        w = w + 1
    }
    var tns_present: i32 = 0
    if aac_bits.br_get1(&(*d).br) != 0 {
        tns_present = 1
        let r4: i32 = aac_sect.read_tns(d, c)
        if r4 != 0 {
            return r4
        }
    }
    if aac_bits.br_get1(&(*d).br) != 0 {
        return 1
    }
    let r5: i32 = read_spectral(d, c)
    if r5 != 0 {
        return r5
    }

    if (*d).ics[c].pulse_n > 0 {
        let q: u64 = (*d).quant + (c * aac_state.FRAME * 4) as% u64
        var pos: u32 = aac_sect.swb_off(d, c, (*d).ics[c].pulse_start)
        var p: u32 = 0
        while p < (*d).ics[c].pulse_n {
            pos = pos + (*d).ics[c].pulse_off[p as% usize]
            if pos < 1024 {
                let cur: i32 = aac_state.ldi(q, pos as% usize)
                let amp: i32 = (*d).ics[c].pulse_amp[p as% usize] as% i32
                if cur > 0 {
                    aac_state.sti(q, pos as% usize, cur + amp)
                } else {
                    aac_state.sti(q, pos as% usize, cur - amp)
                }
            }
            p = p + 1
        }
    }
    return 0
}
