import std.rt

export { Aac, Br, EIGHT_SHORT, FRAME, ID_CPE, ID_DSE, ID_END, ID_FIL, ID_LFE, ID_SCE, INTENSITY_HCB, INTENSITY_HCB2, LONG_START, LONG_STOP, NOISE_HCB, SHORT, heap_zero, ics_new, ldb, ldf, ldi, stf, sti }

const FRAME: usize = 1024

const SHORT: usize = 128

const ONLY_LONG: u32 = 0

const LONG_START: u32 = 1

const EIGHT_SHORT: u32 = 2

const LONG_STOP: u32 = 3

const ID_SCE: u32 = 0

const ID_CPE: u32 = 1

const ID_CCE: u32 = 2

const ID_LFE: u32 = 3

const ID_DSE: u32 = 4

const ID_PCE: u32 = 5

const ID_FIL: u32 = 6

const ID_END: u32 = 7

const ZERO_HCB: u8 = 0

const NOISE_HCB: u8 = 13

const INTENSITY_HCB2: u8 = 14

const INTENSITY_HCB: u8 = 15

struct Br {
    buf: u64,
    pos: i32,
    end: i32,
}

struct AacIcs {
    seq: u32,
    shape: u32,
    max_sfb: u32,
    ngroups: u32,
    glen: [u32; 8],
    nwin: u32,
    nswb: u32,
    gain: i32,
    cb: [u8; 512],
    sf: [i32; 512],
    ms: [u8; 512],
    pulse_n: u32,
    pulse_start: u32,
    pulse_off: [u32; 4],
    pulse_amp: [u32; 4],
    tns_n: [u32; 8],
    tns_res: [u32; 8],
    tns_len: [u32; 24],
    tns_ord: [u32; 24],
    tns_dir: [u32; 24],
    tns_cmp: [u32; 24],
    tns_coef: [u32; 480],
}

struct Aac {
    sr_idx: u32,
    hz: u32,
    ch: u32,
    br: Br,
    ready: i32,
    trie: u64,
    trie_total: usize,
    trie_off: [u32; 12],
    pow43: u64,
    gain_tab: u64,
    win_sine_l: u64,
    win_sine_s: u64,
    win_kbd_l: u64,
    win_kbd_s: u64,
    tw_pre_l: u64,
    tw_post_l: u64,
    tw_pre_s: u64,
    tw_post_s: u64,
    fft_cos_l: u64,
    fft_sin_l: u64,
    fft_cos_s: u64,
    fft_sin_s: u64,
    overlap: u64,
    prev_shape: [u32; 2],
    quant: u64,
    spec: u64,
    tmp: u64,
    tmp2: u64,
    ics: [AacIcs; 2],
    ms_present: u32,
    rng: u32,
    out_pcm: u64,
    out_n: i32,
    elems: i32,
}

fn ics_new() -> AacIcs {
    return AacIcs { seq: 0, shape: 0, max_sfb: 0, ngroups: 1, glen: [0; 8], nwin: 1, nswb: 0, gain: 0,
        cb: [0 as% u8; 512], sf: [0; 512], ms: [0 as% u8; 512],
        pulse_n: 0, pulse_start: 0, pulse_off: [0; 4], pulse_amp: [0; 4],
        tns_n: [0; 8], tns_res: [0; 8], tns_len: [0; 24], tns_ord: [0; 24], tns_dir: [0; 24],
        tns_cmp: [0; 24], tns_coef: [0; 480] }
}

fn ldf(p: u64, i: usize) -> f32 {
    return *((p + (i * 4) as% u64) as *mut f32)
}

fn stf(p: u64, i: usize, v: f32) {
    *((p + (i * 4) as% u64) as *mut f32) = v
}

fn ldi(p: u64, i: usize) -> i32 {
    return *((p + (i * 4) as% u64) as *mut i32)
}

fn sti(p: u64, i: usize, v: i32) {
    *((p + (i * 4) as% u64) as *mut i32) = v
}

fn ldb(p: u64, i: usize) -> u32 {
    return (*((p + i as% u64) as *mut u8)) as% u32
}

fn heap_zero(n: usize) -> u64 {
    let p: u64 = rt.heap_alloc(n)
    rt.mem_set(p, 0 as% u8, n)
    return p
}
