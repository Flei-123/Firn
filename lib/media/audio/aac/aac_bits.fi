import media.audio.aac.aac_state

export { br_get, br_get1, br_left }

fn br_get(b: *mut aac_state.Br, n: i32) -> u32 {
    if n > 64 {
        return br_get(b, n - 64)
    }
    let pos: i32 = (*b).pos
    if pos > (*b).end + 100000 {

        return 0
    }
    (*b).pos = pos + n
    var r: u64 = 0
    if pos + n <= (*b).end {
        if n != 0 {
            let sh: i32 = pos & 7
            let p: u64 = (*b).buf +% ((pos >> 3) as% u64)
            let need: i32 = sh + n
            var v: u64 = (aac_state.ldb(p, 0) as% u64) << 32
            if need > 8 {
                v = v | ((aac_state.ldb(p, 1) as% u64) << 24)
            }
            if need > 16 {
                v = v | ((aac_state.ldb(p, 2) as% u64) << 16)
            }
            if need > 24 {
                v = v | ((aac_state.ldb(p, 3) as% u64) << 8)
            }
            if need > 32 {
                v = v | (aac_state.ldb(p, 4) as% u64)
            }
            r = (v >> ((40 - need) as% u64)) & ((1 << (n as% u64)) - 1)
        }
    }
    return r as% u32
}

fn br_get1(b: *mut aac_state.Br) -> u32 {
    return br_get(b, 1)
}

fn br_left(b: *mut aac_state.Br) -> i32 {
    return (*b).end - (*b).pos
}
