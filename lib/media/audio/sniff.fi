import std.rt
import media.audio.source
import media.audio.mp3_hdr

export { sniff_format, id3_size }

fn b(d: u64, n: usize, i: usize) -> u32 {
    if i >= n {
        return 0 as u32
    }
    return rt.ld8(d, i) as u32
}

fn tag4(d: u64, n: usize, i: usize, a: u32, c: u32, e: u32, f: u32) -> bool {
    return b(d, n, i) == a && b(d, n, i + 1) == c && b(d, n, i + 2) == e && b(d, n, i + 3) == f
}

fn id3_size(d: u64, n: usize) -> usize {
    if n >= 10 && tag4(d, n, 0, 73 as u32, 68 as u32, 51 as u32, b(d, n, 3)) {
        return 10 + (((b(d, n, 6) & 127 as u32) << 21) | ((b(d, n, 7) & 127 as u32) << 14)
            | ((b(d, n, 8) & 127 as u32) << 7) | (b(d, n, 9) & 127 as u32)) as usize
    }
    return 0
}

fn ogg_kind(d: u64, n: usize) -> u32 {
    if n < 28 {
        return source.FMT_UNKNOWN
    }
    let segs: usize = b(d, n, 26) as usize
    let at: usize = 27 + segs
    if tag4(d, n, at, 79 as u32, 112 as u32, 117 as u32, 115 as u32) && tag4(d, n, at + 4, 72 as u32, 101 as u32, 97 as u32, 100 as u32) {
        return source.FMT_OPUS
    }
    if b(d, n, at) == 1 as u32 && tag4(d, n, at + 1, 118 as u32, 111 as u32, 114 as u32, 98 as u32) {
        return source.FMT_VORBIS
    }
    return source.FMT_UNKNOWN
}

fn is_mp3_at(d: u64, n: usize, at: usize) -> bool {
    if at + 4 > n {
        return false
    }
    return mp3_hdr.mp3_hdr_ok(d + at as u64)
}

fn is_adts_at(d: u64, n: usize, at: usize) -> bool {
    if at + 7 > n {
        return false
    }
    if b(d, n, at) != 255 as u32 || (b(d, n, at + 1) & 246 as u32) != 240 as u32 {
        return false
    }
    let sf: u32 = (b(d, n, at + 2) >> 2) & 15 as u32
    return sf < 13 as u32
}

fn adts_len(d: u64, n: usize, at: usize) -> usize {
    return (((b(d, n, at + 3) & 3 as u32) << 11) | (b(d, n, at + 4) << 3) | (b(d, n, at + 5) >> 5)) as usize
}

fn chain_adts(d: u64, n: usize, at: usize) -> bool {
    var p: usize = at
    var k: i32 = 0
    while k < 3 {
        if !is_adts_at(d, n, p) {
            return k > 0 && p >= n
        }
        let l: usize = adts_len(d, n, p)
        if l < 7 {
            return false
        }
        p = p + l
        k = k + 1
    }
    return true
}

fn sniff_format(d: u64, n: usize) -> u32 {
    if n < 4 {
        return source.FMT_UNKNOWN
    }
    if tag4(d, n, 0, 82 as u32, 73 as u32, 70 as u32, 70 as u32) || tag4(d, n, 0, 82 as u32, 70 as u32, 54 as u32, 52 as u32) {
        if tag4(d, n, 8, 87 as u32, 65 as u32, 86 as u32, 69 as u32) {
            return source.FMT_WAV
        }
        return source.FMT_UNKNOWN
    }
    if tag4(d, n, 0, 102 as u32, 76 as u32, 97 as u32, 67 as u32) {
        return source.FMT_FLAC
    }
    if tag4(d, n, 0, 79 as u32, 103 as u32, 103 as u32, 83 as u32) {
        return ogg_kind(d, n)
    }
    if tag4(d, n, 4, 102 as u32, 116 as u32, 121 as u32, 112 as u32) {
        return source.FMT_AAC_M4A
    }
    var at: usize = id3_size(d, n)
    if at > 0 {
        if tag4(d, n, at, 102 as u32, 76 as u32, 97 as u32, 67 as u32) {
            return source.FMT_FLAC
        }
    }
    var skip: usize = 0
    while skip < 4096 && at + skip + 4 <= n {
        let p: usize = at + skip
        if is_mp3_at(d, n, p) {
            let l: usize = mp3_hdr.mp3_hdr_len(d + p as u64)
            if l > 0 && is_mp3_at(d, n, p + l) {
                return source.FMT_MP3
            }
            if l > 0 && p + l >= n {
                return source.FMT_MP3
            }
        }
        if chain_adts(d, n, p) {
            return source.FMT_AAC_ADTS
        }
        skip = skip + 1
    }
    return source.FMT_UNKNOWN
}
