import std.rt
import media.demux
import media.audio.source
import media.audio.bytes
import media.audio.ogg_index
import media.audio.pktplay
import media.audio.opus_play

export { register, OpusSrc }

struct OpusSrc {
    play: opus_play.OpusPlay,
    ogg: ogg_index.Ogg,
    dm: demux.Demux,
    is_ogg: bool,
}

fn open_ogg(s: *mut OpusSrc, d: u64, n: usize) -> bool {
    if ogg_index.ogg_open(&(*s).ogg, d, n) != 0 {
        return false
    }
    let cnt: usize = ogg_index.ogg_count(&(*s).ogg)
    if cnt < 3 {
        return false
    }
    if !opus_play.play_open(&(*s).play, ogg_index.ogg_pkt(&(*s).ogg, 0), ogg_index.ogg_len(&(*s).ogg, 0), cnt - 2) {
        return false
    }
    var i: usize = 2
    while i < cnt {
        opus_play.play_set_packet(&(*s).play, i - 2, ogg_index.ogg_pkt(&(*s).ogg, i), ogg_index.ogg_len(&(*s).ogg, i))
        i = i + 1
    }
    opus_play.play_start(&(*s).play, ogg_index.ogg_last_granule(&(*s).ogg))
    return true
}

fn open_webm(s: *mut OpusSrc, d: u64, n: usize) -> bool {
    if demux.demux_open(&(*s).dm, d, n) != 0 {
        return false
    }
    let t: i32 = demux.demux_find_track(&(*s).dm, demux.TK_AUDIO)
    if t < 0 || demux.demux_track_codec(&(*s).dm, t) != demux.CODEC_OPUS {
        return false
    }
    let cnt: usize = demux.demux_nsamples(&(*s).dm, t)
    if cnt == 0 {
        return false
    }
    if !opus_play.play_open(&(*s).play, demux.demux_track_cfg(&(*s).dm, t), demux.demux_track_cfg_len(&(*s).dm, t), cnt) {
        return false
    }
    var i: usize = 0
    while i < cnt {
        let off: u64 = demux.demux_sample_off(&(*s).dm, t, i)
        let sz: usize = demux.demux_sample_size(&(*s).dm, t, i) as usize
        if off == 0 as u64 || off + (sz as u64) > (n as u64) {
            opus_play.play_set_packet(&(*s).play, i, d, 0)
        } else {
            opus_play.play_set_packet(&(*s).play, i, d + off, sz)
        }
        i = i + 1
    }
    opus_play.play_start_trim(&(*s).play, demux.demux_discard_ns(&(*s).dm))
    return true
}

fn release(s: *mut OpusSrc) {
    opus_play.play_free(&(*s).play)
    if (*s).is_ogg {
        ogg_index.ogg_free(&(*s).ogg)
    } else {
        demux.demux_free(&(*s).dm)
    }
}

fn opus_open(d: u64, n: usize) -> u64 {
    if n < 32 {
        return 0 as u64
    }
    let h: u64 = source.obj_new[OpusSrc]()
    if h == 0 as u64 {
        return 0 as u64
    }
    let s: *mut OpusSrc = h as *mut OpusSrc
    (*s).play = opus_play.play_new()
    (*s).ogg = ogg_index.ogg_new()
    (*s).dm = demux.demux_new()
    (*s).is_ogg = bytes.le32(d, 0) == 0x5367674F as u32
    var ok: bool = false
    if (*s).is_ogg {
        ok = open_ogg(s, d, n)
    } else {
        ok = open_webm(s, d, n)
    }
    if !ok {
        release(s)
        source.obj_free[OpusSrc](h)
        return 0 as u64
    }
    return h
}

fn opus_info(h: u64, i: *mut source.AudioInfo) {
    let s: *mut OpusSrc = h as *mut OpusSrc
    (*i).channels = (*s).play.head.channels as u32
    (*i).rate = opus_play.OPUS_RATE
    (*i).bits = 32 as u32
    (*i).frames = pktplay.pp_total(&(*s).play.pp)
    (*i).known_length = pktplay.pp_known(&(*s).play.pp)
    (*i).seekable = true
}

fn opus_read(h: u64, dst: u64, frames: usize) -> i64 {
    let s: *mut OpusSrc = h as *mut OpusSrc
    return pktplay.pp_read_f32(&(*s).play.pp, dst, frames)
}

fn opus_seek(h: u64, frame: u64) -> bool {
    let s: *mut OpusSrc = h as *mut OpusSrc
    return pktplay.pp_seek(&(*s).play.pp, frame)
}

fn opus_close(h: u64) {
    let s: *mut OpusSrc = h as *mut OpusSrc
    release(s)
    source.obj_free[OpusSrc](h)
}

fn register(r: *mut source.Registry) -> bool {
    return source.registry_add(r, source.Codec { id: source.FMT_OPUS, open: opus_open, info: opus_info,
        read: opus_read, seek: opus_seek, close: opus_close })
}
