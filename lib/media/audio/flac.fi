// SPDX-License-Identifier: MPL-2.0
import std.rt
import media.audio.source
import media.audio.flac_dec

export { register, FlacSrc }

struct FlacSrc {
    f: flac_dec.Flac,
    pend: usize,
    pend_off: usize,
    skip_left: u64,
    remaining: u64,
    scale: f32,
}

fn flac_open_src(d: u64, n: usize) -> u64 {
    let h: u64 = source.obj_new[FlacSrc]()
    if h == 0 as u64 {
        return 0 as u64
    }
    let s: *mut FlacSrc = h as *mut FlacSrc
    (*s).f = flac_dec.flac_new()
    if flac_dec.flac_open(&(*s).f, d, n) != 0 {
        flac_dec.flac_free(&(*s).f)
        source.obj_free[FlacSrc](h)
        return 0 as u64
    }
    let bps: u32 = flac_dec.flac_bps(&(*s).f)
    var sc: f32 = 1.0
    var k: u32 = 1 as u32
    while k < bps {
        sc = sc * 2.0
        k = k + 1 as u32
    }
    (*s).scale = sc
    (*s).remaining = flac_dec.flac_total(&(*s).f)
    return h
}

fn flac_info_src(h: u64, i: *mut source.AudioInfo) {
    let s: *mut FlacSrc = h as *mut FlacSrc
    (*i).channels = flac_dec.flac_channels(&(*s).f)
    (*i).rate = flac_dec.flac_hz(&(*s).f)
    (*i).bits = flac_dec.flac_bps(&(*s).f)
    (*i).frames = flac_dec.flac_total(&(*s).f)
    (*i).known_length = (*i).frames > 0 as u64
    (*i).seekable = true
}

fn next_block(s: *mut FlacSrc) -> bool {
    var bad: i32 = 0
    while bad < 64 {
        let n: i32 = flac_dec.flac_next(&(*s).f)
        if n == 0 {
            return false
        }
        if n > 0 {
            var cnt: usize = n as usize
            var drop: usize = cnt
            if (*s).skip_left < (cnt as u64) {
                drop = (*s).skip_left as usize
            }
            (*s).skip_left = (*s).skip_left - (drop as u64)
            (*s).pend = cnt - drop
            (*s).pend_off = drop
            return true
        }
        bad = bad + 1
    }
    return false
}

fn flac_read_src(h: u64, dst: u64, frames: usize) -> i64 {
    let s: *mut FlacSrc = h as *mut FlacSrc
    let ch: usize = flac_dec.flac_channels(&(*s).f) as usize
    var out: usize = 0
    while out < frames {
        if (*s).pend == 0 {
            if !next_block(s) {
                break
            }
            continue
        }
        var k: usize = (*s).pend
        if k > frames - out {
            k = frames - out
        }
        var c: usize = 0
        while c < ch {
            let p: u64 = flac_dec.flac_chan(&(*s).f, c)
            var i: usize = 0
            while i < k {
                let v: i32 = *((p + (((*s).pend_off + i) * 4) as u64) as *mut i32)
                *((dst + (((out + i) * ch + c) * 4) as u64) as *mut f32) = (v as f32) / (*s).scale
                i = i + 1
            }
            c = c + 1
        }
        (*s).pend = (*s).pend - k
        (*s).pend_off = (*s).pend_off + k
        out = out + k
    }
    return out as i64
}

fn flac_seek_src(h: u64, frame: u64) -> bool {
    let s: *mut FlacSrc = h as *mut FlacSrc
    let total: u64 = flac_dec.flac_total(&(*s).f)
    if total > 0 as u64 && frame > total {
        return false
    }
    let start: u64 = flac_dec.flac_seek(&(*s).f, frame)
    (*s).skip_left = frame - start
    (*s).pend = 0
    (*s).pend_off = 0
    return true
}

fn flac_close_src(h: u64) {
    let s: *mut FlacSrc = h as *mut FlacSrc
    flac_dec.flac_free(&(*s).f)
    source.obj_free[FlacSrc](h)
}

fn register(r: *mut source.Registry) -> bool {
    return source.registry_add(r, source.Codec { id: source.FMT_FLAC, open: flac_open_src, info: flac_info_src,
        read: flac_read_src, seek: flac_seek_src, close: flac_close_src })
}
