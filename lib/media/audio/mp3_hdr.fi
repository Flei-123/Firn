// SPDX-License-Identifier: MPL-2.0
import std.rt

export { mp3_hdr_ok, mp3_hdr_len, mp3_hdr_hz, mp3_hdr_channels, mp3_hdr_samples, mp3_hdr_same }

fn bitrate_kbps(v1: bool, idx: usize) -> u32 {
    var t1: [u16; 15] = [0, 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320]
    var t2: [u16; 15] = [0, 8, 16, 24, 32, 40, 48, 56, 64, 80, 96, 112, 128, 144, 160]
    if v1 {
        return t1[idx] as u32
    }
    return t2[idx] as u32
}

fn base_hz(idx: usize) -> u32 {
    var t: [u16; 3] = [44100, 48000, 32000]
    return t[idx] as u32
}

fn hb(p: u64, i: usize) -> u32 {
    return rt.ld8(p, i) as u32
}

fn version(p: u64) -> u32 {
    return (hb(p, 1) >> 3) & 3 as u32
}

fn mp3_hdr_ok(p: u64) -> bool {
    if hb(p, 0) != 255 as u32 || (hb(p, 1) & 224 as u32) != 224 as u32 {
        return false
    }
    if version(p) == 1 as u32 || ((hb(p, 1) >> 1) & 3 as u32) != 1 as u32 {
        return false
    }
    if (hb(p, 2) >> 4) == 15 as u32 || (hb(p, 2) >> 4) == 0 as u32 || ((hb(p, 2) >> 2) & 3 as u32) == 3 as u32 {
        return false
    }
    return true
}

fn mp3_hdr_hz(p: u64) -> u32 {
    let v: u32 = version(p)
    var hz: u32 = base_hz(((hb(p, 2) >> 2) & 3 as u32) as usize)
    if v == 2 as u32 {
        hz = hz / 2 as u32
    } else if v == 0 as u32 {
        hz = hz / 4 as u32
    }
    return hz
}

fn mp3_hdr_channels(p: u64) -> u32 {
    if ((hb(p, 3) >> 6) & 3 as u32) == 3 as u32 {
        return 1 as u32
    }
    return 2 as u32
}

fn mp3_hdr_samples(p: u64) -> u32 {
    if version(p) == 3 as u32 {
        return 1152 as u32
    }
    return 576 as u32
}

fn mp3_hdr_len(p: u64) -> usize {
    if !mp3_hdr_ok(p) {
        return 0
    }
    let idx: usize = (hb(p, 2) >> 4) as usize
    var br: u32 = 0 as u32
    var mul: u32 = 144 as u32
    if version(p) == 3 as u32 {
        br = bitrate_kbps(true, idx)
    } else {
        br = bitrate_kbps(false, idx)
        mul = 72 as u32
    }
    let hz: u32 = mp3_hdr_hz(p)
    if hz == 0 as u32 {
        return 0
    }
    let pad: u32 = (hb(p, 2) >> 1) & 1 as u32
    return ((mul * br * 1000 as u32) / hz + pad) as usize
}

fn mp3_hdr_same(a: u64, b: u64) -> bool {
    return hb(a, 1) == hb(b, 1) && (hb(a, 2) & 12 as u32) == (hb(b, 2) & 12 as u32) && mp3_hdr_channels(a) == mp3_hdr_channels(b)
}
