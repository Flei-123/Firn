import std.rt

export {
    Ogg, ogg_new, ogg_free, ogg_open, ogg_count, ogg_pkt, ogg_len, ogg_granule, ogg_last_granule,
    ogg_build, ogg_add, ogg_reserve,
}

struct Ogg {
    data: u64,
    len: usize,
    pk: u64,
    pk_cap: usize,
    off: u64,
    plen: u64,
    gp: u64,
    n: usize,
    cap: usize,
    serial: u32,
    last_gp: i64,
    ready: i32,
}

fn ogg_new() -> Ogg {
    return Ogg { data: 0, len: 0, pk: 0, pk_cap: 0, off: 0, plen: 0, gp: 0, n: 0, cap: 0, serial: 0, last_gp: -1, ready: 0 }
}

fn ogg_free(o: *mut Ogg) {
    if (*o).pk != 0 {
        rt.heap_free((*o).pk, (*o).pk_cap + 16)
    }
    if (*o).off != 0 {
        rt.heap_free((*o).off, (*o).cap * 4 + 16)
        rt.heap_free((*o).plen, (*o).cap * 4 + 16)
        rt.heap_free((*o).gp, (*o).cap * 8 + 16)
    }
    (*o).pk = 0
    (*o).off = 0
    (*o).plen = 0
    (*o).gp = 0
    (*o).n = 0
    (*o).ready = 0
}

fn ogg_count(o: *mut Ogg) -> usize { return (*o).n }
fn ogg_last_granule(o: *mut Ogg) -> i64 { return (*o).last_gp }

fn ld8(p: u64, i: usize) -> u32 {
    return (*((p + i as% u64) as *mut u8)) as% u32
}

fn ld32le(p: u64, i: usize) -> u32 {
    return ld8(p, i) | (ld8(p, i + 1) << 8) | (ld8(p, i + 2) << 16) | (ld8(p, i + 3) << 24)
}

fn ld64le(p: u64, i: usize) -> i64 {
    return ((ld32le(p, i) as% u64) | ((ld32le(p, i + 4) as% u64) << 32)) as% i64
}

fn ogg_pkt(o: *mut Ogg, i: usize) -> u64 {
    return (*o).pk + (*(((*o).off + (i * 4) as% u64) as *mut u32)) as% u64
}

fn ogg_len(o: *mut Ogg, i: usize) -> usize {
    return (*(((*o).plen + (i * 4) as% u64) as *mut u32)) as% usize
}

fn ogg_granule(o: *mut Ogg, i: usize) -> i64 {
    return *(((*o).gp + (i * 8) as% u64) as *mut i64)
}

fn walk(o: *mut Ogg, fill: i32) -> usize {
    let d: u64 = (*o).data
    let n: usize = (*o).len
    var pos: usize = 0
    var count: usize = 0
    var wr: usize = 0
    var cur_len: usize = 0
    var cur_start: usize = 0
    var have_serial: i32 = 0
    var go: i32 = 1
    var dropping: i32 = 0
    while go != 0 {
        if pos + 27 > n {
            go = 0
        } else if ld32le(d, pos) != 0x5367674F {

            pos = pos + 1
        } else {
            let htype: u32 = ld8(d, pos + 5)
            let gran: i64 = ld64le(d, pos + 6)
            let ser: u32 = ld32le(d, pos + 14)
            let nseg: usize = ld8(d, pos + 26) as% usize
            if pos + 27 + nseg > n {
                go = 0
            } else {
                var body: usize = 0
                var s: usize = 0
                while s < nseg {
                    body = body + (ld8(d, pos + 27 + s) as% usize)
                    s = s + 1
                }
                var take: i32 = 1
                if have_serial == 0 {
                    if (htype & 2) == 0 as% u32 {
                        take = 0
                    } else {
                        (*o).serial = ser
                        have_serial = 1
                    }
                } else if ser != (*o).serial {
                    take = 0
                    if (htype & 2) != 0 as% u32 {

                        if count > 3 {
                            go = 0
                        }
                    }
                }
                if go != 0 && take != 0 && pos + 27 + nseg + body <= n {
                    var dp: usize = pos + 27 + nseg
                    if (htype & 1) != 0 as% u32 && cur_len == 0 && count == 0 {
                        dropping = 1
                    }
                    s = 0
                    while s < nseg {
                        let lv: usize = ld8(d, pos + 27 + s) as% usize
                        if fill != 0 && dropping == 0 {
                            rt.mem_copy((*o).pk + wr as% u64, d + dp as% u64, lv)
                            wr = wr + lv
                        }
                        cur_len = cur_len + lv
                        dp = dp + lv
                        if lv < 255 {

                            if dropping != 0 {
                                dropping = 0
                            } else {
                                if fill != 0 {
                                    *(((*o).off + (count * 4) as% u64) as *mut u32) = cur_start as% u32
                                    *(((*o).plen + (count * 4) as% u64) as *mut u32) = cur_len as% u32
                                    var g: i64 = 0 - 1
                                    if s + 1 == nseg {
                                        g = gran
                                    }
                                    *(((*o).gp + (count * 8) as% u64) as *mut i64) = g
                                }
                                count = count + 1
                            }
                            cur_start = wr
                            cur_len = 0
                        }
                        s = s + 1
                    }
                    if (htype & 4) != 0 as% u32 && gran >= 0 {
                        (*o).last_gp = gran
                    }
                    pos = pos + 27 + nseg + body
                } else if go != 0 {

                    pos = pos + 27 + nseg + body
                }
            }
        }
    }
    return count
}

fn ogg_open(o: *mut Ogg, d: u64, n: usize) -> i32 {
    if n < 28 || ld32le(d, 0) != 0x5367674F {
        return 1
    }
    (*o).data = d
    (*o).len = n
    (*o).last_gp = 0 - 1
    let cnt: usize = walk(o, 0)
    if cnt == 0 {
        return 2
    }
    (*o).cap = cnt
    (*o).pk_cap = n
    (*o).pk = rt.heap_alloc(n + 16)
    (*o).off = rt.heap_alloc(cnt * 4 + 16)
    (*o).plen = rt.heap_alloc(cnt * 4 + 16)
    (*o).gp = rt.heap_alloc(cnt * 8 + 16)
    if (*o).pk == 0 || (*o).off == 0 || (*o).plen == 0 || (*o).gp == 0 {
        return 3
    }
    (*o).last_gp = 0 - 1
    (*o).n = walk(o, 1)
    (*o).ready = 1
    return 0
}

fn ogg_build(o: *mut Ogg, count: usize, bytes: usize) -> i32 {
    if count == 0 {
        return 2
    }
    (*o).cap = count
    (*o).pk_cap = bytes
    (*o).pk = rt.heap_alloc(bytes + 16)
    (*o).off = rt.heap_alloc(count * 4 + 16)
    (*o).plen = rt.heap_alloc(count * 4 + 16)
    (*o).gp = rt.heap_alloc(count * 8 + 16)
    if (*o).pk == 0 || (*o).off == 0 || (*o).plen == 0 || (*o).gp == 0 {
        return 3
    }
    (*o).n = 0
    (*o).last_gp = 0 - 1
    return 0
}

fn ogg_add(o: *mut Ogg, p: u64, len: usize) -> i32 {
    var wr: usize = 0
    if (*o).n > 0 {
        let k: usize = (*o).n - 1
        wr = (*(((*o).off + (k * 4) as% u64) as *mut u32)) as% usize + ogg_len(o, k)
    }
    if (*o).n >= (*o).cap || wr + len > (*o).pk_cap {
        return 1
    }
    rt.mem_copy((*o).pk + wr as% u64, p, len)
    *(((*o).off + ((*o).n * 4) as% u64) as *mut u32) = wr as% u32
    *(((*o).plen + ((*o).n * 4) as% u64) as *mut u32) = len as% u32
    *(((*o).gp + ((*o).n * 8) as% u64) as *mut i64) = 0 - 1
    (*o).n = (*o).n + 1
    (*o).ready = 1
    return 0
}

fn ogg_used(o: *mut Ogg) -> usize {
    if (*o).n == 0 {
        return 0
    }
    let k: usize = (*o).n - 1
    return (*(((*o).off + (k * 4) as% u64) as *mut u32)) as% usize + ogg_len(o, k)
}

fn ogg_reserve(o: *mut Ogg, count: usize, bytes: usize) -> i32 {
    if (*o).off == 0 {
        return ogg_build(o, count + 64, bytes + 4096)
    }
    let used: usize = ogg_used(o)
    var ncap: usize = (*o).cap
    var nbytes: usize = (*o).pk_cap
    if (*o).n + count > ncap {
        ncap = (*o).n + count + (*o).cap
    }
    if used + bytes > nbytes {
        nbytes = used + bytes + (*o).pk_cap
    }
    if ncap == (*o).cap && nbytes == (*o).pk_cap {
        return 0
    }
    let npk: u64 = rt.heap_alloc(nbytes + 16)
    let noff: u64 = rt.heap_alloc(ncap * 4 + 16)
    let nlen: u64 = rt.heap_alloc(ncap * 4 + 16)
    let ngp: u64 = rt.heap_alloc(ncap * 8 + 16)
    if npk == 0 || noff == 0 || nlen == 0 || ngp == 0 {
        return 3
    }
    if used > 0 {
        rt.mem_copy(npk, (*o).pk, used)
    }
    if (*o).n > 0 {
        rt.mem_copy(noff, (*o).off, (*o).n * 4)
        rt.mem_copy(nlen, (*o).plen, (*o).n * 4)
        rt.mem_copy(ngp, (*o).gp, (*o).n * 8)
    }
    rt.heap_free((*o).pk, (*o).pk_cap + 16)
    rt.heap_free((*o).off, (*o).cap * 4 + 16)
    rt.heap_free((*o).plen, (*o).cap * 4 + 16)
    rt.heap_free((*o).gp, (*o).cap * 8 + 16)
    (*o).pk = npk
    (*o).off = noff
    (*o).plen = nlen
    (*o).gp = ngp
    (*o).cap = ncap
    (*o).pk_cap = nbytes
    return 0
}
