// SPDX-License-Identifier: MPL-2.0
import std.rt
import media.audio.source
import media.audio.bytes

export { register, WavSrc }

const K_PCM: u32 = 1
const K_FLOAT: u32 = 3
const K_ALAW: u32 = 6
const K_MULAW: u32 = 7

struct WavSrc {
    data: u64,
    n: usize,
    off: usize,
    len: usize,
    channels: u32,
    rate: u32,
    bits: u32,
    kind: u32,
    bpf: usize,
    pos: u64,
}

fn le16(d: u64, n: usize, i: usize) -> u32 {
    if i + 2 > n {
        return 0 as u32
    }
    return bytes.le16(d, i)
}

fn le32(d: u64, n: usize, i: usize) -> u32 {
    if i + 4 > n {
        return 0 as u32
    }
    return bytes.le32(d, i)
}

fn wav_open(d: u64, n: usize) -> u64 {
    if n < 12 {
        return 0 as u64
    }
    let h: u64 = source.obj_new[WavSrc]()
    if h == 0 as u64 {
        return 0 as u64
    }
    let w: *mut WavSrc = h as *mut WavSrc
    (*w).data = d
    (*w).n = n
    var have_fmt: bool = false
    var have_data: bool = false
    var p: usize = 12
    while p + 8 <= n && !have_data {
        let id: u32 = le32(d, n, p)
        let sz: usize = le32(d, n, p + 4) as usize
        let body: usize = p + 8
        if id == 544501094 as u32 {
            if sz < 16 || body + 16 > n {
                source.obj_free[WavSrc](h)
                return 0 as u64
            }
            var tag: u32 = le16(d, n, body)
            (*w).channels = le16(d, n, body + 2)
            (*w).rate = le32(d, n, body + 4)
            (*w).bits = le16(d, n, body + 14)
            if tag == 65534 as u32 && sz >= 26 {
                tag = le16(d, n, body + 24)
            }
            (*w).kind = tag
            have_fmt = true
        } else if id == 1635017060 as u32 {
            if !have_fmt {
                source.obj_free[WavSrc](h)
                return 0 as u64
            }
            var l: usize = sz
            if body + l > n || sz == 4294967295 as usize {
                l = n - body
            }
            (*w).off = body
            (*w).len = l
            have_data = true
        }
        p = body + sz + (sz & 1)
    }
    if !have_fmt || !have_data || (*w).channels == 0 as u32 || (*w).channels > 32 as u32 || (*w).rate == 0 as u32 {
        source.obj_free[WavSrc](h)
        return 0 as u64
    }
    let k: u32 = (*w).kind
    let b: u32 = (*w).bits
    var ok: bool = false
    if k == K_PCM && (b == 8 as u32 || b == 16 as u32 || b == 24 as u32 || b == 32 as u32) {
        ok = true
    }
    if k == K_FLOAT && (b == 32 as u32 || b == 64 as u32) {
        ok = true
    }
    if (k == K_ALAW || k == K_MULAW) && b == 8 as u32 {
        ok = true
    }
    if !ok {
        source.obj_free[WavSrc](h)
        return 0 as u64
    }
    (*w).bpf = ((b / 8 as u32) * (*w).channels) as usize
    (*w).len = (*w).len - (*w).len % (*w).bpf
    return h
}

fn wav_info(h: u64, i: *mut source.AudioInfo) {
    let w: *mut WavSrc = h as *mut WavSrc
    (*i).channels = (*w).channels
    (*i).rate = (*w).rate
    (*i).bits = (*w).bits
    (*i).frames = ((*w).len / (*w).bpf) as u64
    (*i).known_length = true
    (*i).seekable = true
}

fn alaw(v: u32) -> f32 {
    let x: u32 = v ^ 85 as u32
    let seg: u32 = (x >> 4) & 7 as u32
    var t: i32 = ((x & 15 as u32) << 4) as i32
    if seg == 0 as u32 {
        t = t + 8
    } else {
        t = (t + 264) << ((seg - 1 as u32))
    }
    if (x & 128 as u32) == 0 as u32 {
        t = 0 - t
    }
    return (t as f32) / 32768.0
}

fn mulaw(v: u32) -> f32 {
    let x: u32 = (255 as u32) - v
    var t: i32 = (((x & 15 as u32) << 3) + 132) as i32
    t = (t << ((x >> 4) & 7 as u32)) - 132
    if (x & 128 as u32) != 0 as u32 {
        t = 0 - t
    }
    return (t as f32) / 32768.0
}

fn one(w: *mut WavSrc, p: u64) -> f32 {
    let b: u32 = (*w).bits
    if (*w).kind == K_FLOAT {
        if b == 32 as u32 {
            return *(p as *mut f32)
        }
        return (*(p as *mut f64)) as f32
    }
    if (*w).kind == K_ALAW {
        return alaw(rt.ld8(p, 0) as u32)
    }
    if (*w).kind == K_MULAW {
        return mulaw(rt.ld8(p, 0) as u32)
    }
    if b == 8 as u32 {
        return (((rt.ld8(p, 0) as i32) - 128) as f32) / 128.0
    }
    if b == 16 as u32 {
        var s: i32 = bytes.le16(p, 0) as i32
        if s >= 32768 {
            s = s - 65536
        }
        return (s as f32) / 32768.0
    }
    if b == 24 as u32 {
        var s: i32 = ((rt.ld8(p, 0) as i32) | ((rt.ld8(p, 1) as i32) << 8) | ((rt.ld8(p, 2) as i32) << 16))
        if s >= 8388608 {
            s = s - 16777216
        }
        return (s as f32) / 8388608.0
    }
    var s: i64 = bytes.le32(p, 0) as i64
    if s >= 2147483648 {
        s = s - 4294967296
    }
    return (s as f32) / 2147483648.0
}

fn wav_read(h: u64, dst: u64, frames: usize) -> i64 {
    let w: *mut WavSrc = h as *mut WavSrc
    let total: u64 = ((*w).len / (*w).bpf) as u64
    if (*w).pos >= total {
        return 0
    }
    var k: usize = frames
    if (k as u64) > total - (*w).pos {
        k = (total - (*w).pos) as usize
    }
    let ch: usize = (*w).channels as usize
    let sw: usize = ((*w).bits / 8 as u32) as usize
    var src: u64 = (*w).data + ((*w).off as u64) + (*w).pos * ((*w).bpf as u64)
    var i: usize = 0
    var o: usize = 0
    while i < k * ch {
        *((dst + (o * 4) as u64) as *mut f32) = one(w, src)
        src = src + sw as u64
        o = o + 1
        i = i + 1
    }
    (*w).pos = (*w).pos + k as u64
    return k as i64
}

fn wav_seek(h: u64, frame: u64) -> bool {
    let w: *mut WavSrc = h as *mut WavSrc
    let total: u64 = ((*w).len / (*w).bpf) as u64
    if frame > total {
        return false
    }
    (*w).pos = frame
    return true
}

fn wav_close(h: u64) {
    source.obj_free[WavSrc](h)
}

fn register(r: *mut source.Registry) -> bool {
    return source.registry_add(r, source.Codec { id: source.FMT_WAV, open: wav_open, info: wav_info, read: wav_read,
        seek: wav_seek, close: wav_close })
}
