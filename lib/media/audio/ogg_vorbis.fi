// SPDX-License-Identifier: MPL-2.0
import std.rt
import media.audio.source
import media.audio.bytes
import ton.vorbis_stream

export { register, VorbisSrc }

struct VorbisSrc {
    s: *mut vorbis_stream.VStream,
    ud: u64,
    total: u64,
    known: bool,
}

fn last_granule(d: u64, n: usize) -> i64 {
    var p: usize = n
    var lim: usize = 0
    if n > 262144 {
        lim = n - 262144
    }
    while p > lim + 27 {
        p = p - 1
        if bytes.u8_at(d, p) == 79 as u32 && bytes.u8_at(d, p + 1) == 103 as u32 && bytes.u8_at(d, p + 2) == 103 as u32
            && bytes.u8_at(d, p + 3) == 83 as u32 && p + 14 <= n {
            return bytes.le64(d, p + 6) as i64
        }
    }
    return 0 - 1
}

fn vorbis_open(d: u64, n: usize) -> u64 {
    if n < 64 {
        return 0 as u64
    }
    let h: u64 = source.src_new[VorbisSrc]()
    if h == 0 as u64 {
        return 0 as u64
    }
    let v: *mut VorbisSrc = h as *mut VorbisSrc
    let src: vorbis_stream.VsSource = vorbis_stream.vs_source_mem(d, n)
    (*v).ud = src.ud
    (*v).s = vorbis_stream.vs_open(src)
    if (*v).s as u64 == 0 as u64 {
        rt.heap_free((*v).ud, 24)
        source.src_free[VorbisSrc](h)
        return 0 as u64
    }
    let g: i64 = last_granule(d, n)
    if g > 0 {
        (*v).total = g as u64
        (*v).known = true
    }
    return h
}

fn vorbis_info(h: u64, i: *mut source.AudioInfo) {
    let v: *mut VorbisSrc = h as *mut VorbisSrc
    (*i).channels = vorbis_stream.vs_channels((*v).s) as u32
    (*i).rate = vorbis_stream.vs_rate((*v).s) as u32
    (*i).bits = 32 as u32
    (*i).frames = (*v).total
    (*i).known_length = (*v).known
    (*i).seekable = true
}

fn vorbis_read(h: u64, dst: u64, frames: usize) -> i64 {
    let v: *mut VorbisSrc = h as *mut VorbisSrc
    let r: i64 = vorbis_stream.vs_read_f32((*v).s, dst, frames)
    if r == vorbis_stream.VS_LINK {
        return 0
    }
    return r
}

fn vorbis_seek(h: u64, frame: u64) -> bool {
    let v: *mut VorbisSrc = h as *mut VorbisSrc
    return vorbis_stream.vs_seek((*v).s, frame as i64) == 0
}

fn vorbis_close(h: u64) {
    let v: *mut VorbisSrc = h as *mut VorbisSrc
    vorbis_stream.vs_close((*v).s)
    rt.heap_free((*v).ud, 24)
    source.src_free[VorbisSrc](h)
}

fn register(r: *mut source.Registry) -> bool {
    return source.registry_add(r, source.Codec { id: source.FMT_VORBIS, open: vorbis_open, info: vorbis_info,
        read: vorbis_read, seek: vorbis_seek, close: vorbis_close })
}
