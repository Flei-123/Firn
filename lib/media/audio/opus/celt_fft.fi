import media.audio.opus.celt_fix
import media.audio.opus.celt_synth_tables

export { celt_mdct_backward }

fn smul(d: i32, t: i32) -> i32 {
    return celt_fix.mul16_32_q15(t, d)
}

fn rd(p: u64, k: i32) -> i32 {
    return celt_fix.ld32(p, k)
}

fn wr(p: u64, k: i32, v: i32) {
    celt_fix.st32(p, k, v)
}

fn tw(i: i32, part: i32) -> i32 {
    return celt_fix.ld16(celt_synth_tables.celt_fft_tw_addr(), 2 * i + part)
}

fn bfly2(f: u64, n: i32) {
    var i: i32 = 0
    while i < n {
        let b: i32 = 16 * i
        let a0r: i32 = rd(f, b)
        let a0i: i32 = rd(f, b + 1)
        let t0r: i32 = rd(f, b + 8)
        let t0i: i32 = rd(f, b + 9)
        wr(f, b + 8, a0r -% t0r)
        wr(f, b + 9, a0i -% t0i)
        wr(f, b, a0r +% t0r)
        wr(f, b + 1, a0i +% t0i)
        let s1r: i32 = rd(f, b + 10)
        let s1i: i32 = rd(f, b + 11)
        let tr1: i32 = smul(s1r +% s1i, 23170)
        let ti1: i32 = smul(s1i -% s1r, 23170)
        let a1r: i32 = rd(f, b + 2)
        let a1i: i32 = rd(f, b + 3)
        wr(f, b + 10, a1r -% tr1)
        wr(f, b + 11, a1i -% ti1)
        wr(f, b + 2, a1r +% tr1)
        wr(f, b + 3, a1i +% ti1)
        let s2r: i32 = rd(f, b + 12)
        let s2i: i32 = rd(f, b + 13)
        let a2r: i32 = rd(f, b + 4)
        let a2i: i32 = rd(f, b + 5)
        wr(f, b + 12, a2r -% s2i)
        wr(f, b + 13, a2i +% s2r)
        wr(f, b + 4, a2r +% s2i)
        wr(f, b + 5, a2i -% s2r)
        let s3r: i32 = rd(f, b + 14)
        let s3i: i32 = rd(f, b + 15)
        let tr3: i32 = smul(s3i -% s3r, 23170)
        let ti3: i32 = smul(0 -% (s3i +% s3r), 23170)
        let a3r: i32 = rd(f, b + 6)
        let a3i: i32 = rd(f, b + 7)
        wr(f, b + 14, a3r -% tr3)
        wr(f, b + 15, a3i -% ti3)
        wr(f, b + 6, a3r +% tr3)
        wr(f, b + 7, a3i +% ti3)
        i = i + 1
    }
}

fn bfly4(f: u64, fstride: i32, m: i32, n: i32, mm: i32) {
    var i: i32 = 0
    if m == 1 {
        while i < n {
            let b: i32 = 8 * i
            let f0r: i32 = rd(f, b)
            let f0i: i32 = rd(f, b + 1)
            let f2r: i32 = rd(f, b + 4)
            let f2i: i32 = rd(f, b + 5)
            let s0r: i32 = f0r -% f2r
            let s0i: i32 = f0i -% f2i
            let g0r: i32 = f0r +% f2r
            let g0i: i32 = f0i +% f2i
            let f1r: i32 = rd(f, b + 2)
            let f1i: i32 = rd(f, b + 3)
            let f3r: i32 = rd(f, b + 6)
            let f3i: i32 = rd(f, b + 7)
            let s1r: i32 = f1r +% f3r
            let s1i: i32 = f1i +% f3i
            wr(f, b + 4, g0r -% s1r)
            wr(f, b + 5, g0i -% s1i)
            wr(f, b, g0r +% s1r)
            wr(f, b + 1, g0i +% s1i)
            let d1r: i32 = f1r -% f3r
            let d1i: i32 = f1i -% f3i
            wr(f, b + 2, s0r +% d1i)
            wr(f, b + 3, s0i -% d1r)
            wr(f, b + 6, s0r -% d1i)
            wr(f, b + 7, s0i +% d1r)
            i = i + 1
        }
        return
    }
    while i < n {
        let beg: i32 = i * mm
        var j: i32 = 0
        while j < m {
            let o0: i32 = 2 * (beg + j)
            let o1: i32 = o0 + 2 * m
            let o2: i32 = o0 + 4 * m
            let o3: i32 = o0 + 6 * m
            let t1: i32 = j * fstride
            let t2: i32 = j * fstride * 2
            let t3: i32 = j * fstride * 3
            let x1r: i32 = rd(f, o1)
            let x1i: i32 = rd(f, o1 + 1)
            let x2r: i32 = rd(f, o2)
            let x2i: i32 = rd(f, o2 + 1)
            let x3r: i32 = rd(f, o3)
            let x3i: i32 = rd(f, o3 + 1)
            let s0r: i32 = smul(x1r, tw(t1, 0)) -% smul(x1i, tw(t1, 1))
            let s0i: i32 = smul(x1r, tw(t1, 1)) +% smul(x1i, tw(t1, 0))
            let s1r: i32 = smul(x2r, tw(t2, 0)) -% smul(x2i, tw(t2, 1))
            let s1i: i32 = smul(x2r, tw(t2, 1)) +% smul(x2i, tw(t2, 0))
            let s2r: i32 = smul(x3r, tw(t3, 0)) -% smul(x3i, tw(t3, 1))
            let s2i: i32 = smul(x3r, tw(t3, 1)) +% smul(x3i, tw(t3, 0))
            let f0r: i32 = rd(f, o0)
            let f0i: i32 = rd(f, o0 + 1)
            let s5r: i32 = f0r -% s1r
            let s5i: i32 = f0i -% s1i
            let g0r: i32 = f0r +% s1r
            let g0i: i32 = f0i +% s1i
            let s3r: i32 = s0r +% s2r
            let s3i: i32 = s0i +% s2i
            let s4r: i32 = s0r -% s2r
            let s4i: i32 = s0i -% s2i
            wr(f, o2, g0r -% s3r)
            wr(f, o2 + 1, g0i -% s3i)
            wr(f, o0, g0r +% s3r)
            wr(f, o0 + 1, g0i +% s3i)
            wr(f, o1, s5r +% s4i)
            wr(f, o1 + 1, s5i -% s4r)
            wr(f, o3, s5r -% s4i)
            wr(f, o3 + 1, s5i +% s4r)
            j = j + 1
        }
        i = i + 1
    }
}

fn bfly3(f: u64, fstride: i32, m: i32, n: i32, mm: i32) {
    var i: i32 = 0
    while i < n {
        let beg: i32 = i * mm
        var k: i32 = 0
        while k < m {
            let o0: i32 = 2 * (beg + k)
            let o1: i32 = o0 + 2 * m
            let o2: i32 = o0 + 4 * m
            let t1: i32 = k * fstride
            let t2: i32 = k * fstride * 2
            let x1r: i32 = rd(f, o1)
            let x1i: i32 = rd(f, o1 + 1)
            let x2r: i32 = rd(f, o2)
            let x2i: i32 = rd(f, o2 + 1)
            let s1r: i32 = smul(x1r, tw(t1, 0)) -% smul(x1i, tw(t1, 1))
            let s1i: i32 = smul(x1r, tw(t1, 1)) +% smul(x1i, tw(t1, 0))
            let s2r: i32 = smul(x2r, tw(t2, 0)) -% smul(x2i, tw(t2, 1))
            let s2i: i32 = smul(x2r, tw(t2, 1)) +% smul(x2i, tw(t2, 0))
            let s3r: i32 = s1r +% s2r
            let s3i: i32 = s1i +% s2i
            let s0r: i32 = smul(s1r -% s2r, 0 - 28378)
            let s0i: i32 = smul(s1i -% s2i, 0 - 28378)
            let f0r: i32 = rd(f, o0)
            let f0i: i32 = rd(f, o0 + 1)
            let h1r: i32 = f0r -% (s3r >> 1)
            let h1i: i32 = f0i -% (s3i >> 1)
            wr(f, o0, f0r +% s3r)
            wr(f, o0 + 1, f0i +% s3i)
            wr(f, o2, h1r +% s0i)
            wr(f, o2 + 1, h1i -% s0r)
            wr(f, o1, h1r -% s0i)
            wr(f, o1 + 1, h1i +% s0r)
            k = k + 1
        }
        i = i + 1
    }
}

fn bfly5(f: u64, fstride: i32, m: i32, n: i32, mm: i32) {
    let yar: i32 = 10126
    let yai: i32 = 0 - 31164
    let ybr: i32 = 0 - 26510
    let ybi: i32 = 0 - 19261
    var i: i32 = 0
    while i < n {
        let beg: i32 = i * mm
        var u: i32 = 0
        while u < m {
            let o0: i32 = 2 * (beg + u)
            let o1: i32 = o0 + 2 * m
            let o2: i32 = o0 + 4 * m
            let o3: i32 = o0 + 6 * m
            let o4: i32 = o0 + 8 * m
            let t1: i32 = u * fstride
            let t2: i32 = 2 * u * fstride
            let t3: i32 = 3 * u * fstride
            let t4: i32 = 4 * u * fstride
            let s0r: i32 = rd(f, o0)
            let s0i: i32 = rd(f, o0 + 1)
            let x1r: i32 = rd(f, o1)
            let x1i: i32 = rd(f, o1 + 1)
            let x2r: i32 = rd(f, o2)
            let x2i: i32 = rd(f, o2 + 1)
            let x3r: i32 = rd(f, o3)
            let x3i: i32 = rd(f, o3 + 1)
            let x4r: i32 = rd(f, o4)
            let x4i: i32 = rd(f, o4 + 1)
            let s1r: i32 = smul(x1r, tw(t1, 0)) -% smul(x1i, tw(t1, 1))
            let s1i: i32 = smul(x1r, tw(t1, 1)) +% smul(x1i, tw(t1, 0))
            let s2r: i32 = smul(x2r, tw(t2, 0)) -% smul(x2i, tw(t2, 1))
            let s2i: i32 = smul(x2r, tw(t2, 1)) +% smul(x2i, tw(t2, 0))
            let s3r: i32 = smul(x3r, tw(t3, 0)) -% smul(x3i, tw(t3, 1))
            let s3i: i32 = smul(x3r, tw(t3, 1)) +% smul(x3i, tw(t3, 0))
            let s4r: i32 = smul(x4r, tw(t4, 0)) -% smul(x4i, tw(t4, 1))
            let s4i: i32 = smul(x4r, tw(t4, 1)) +% smul(x4i, tw(t4, 0))
            let s7r: i32 = s1r +% s4r
            let s7i: i32 = s1i +% s4i
            let s10r: i32 = s1r -% s4r
            let s10i: i32 = s1i -% s4i
            let s8r: i32 = s2r +% s3r
            let s8i: i32 = s2i +% s3i
            let s9r: i32 = s2r -% s3r
            let s9i: i32 = s2i -% s3i
            wr(f, o0, s0r +% (s7r +% s8r))
            wr(f, o0 + 1, s0i +% (s7i +% s8i))
            let s5r: i32 = s0r +% (smul(s7r, yar) +% smul(s8r, ybr))
            let s5i: i32 = s0i +% (smul(s7i, yar) +% smul(s8i, ybr))
            let s6r: i32 = smul(s10i, yai) +% smul(s9i, ybi)
            let s6i: i32 = 0 -% (smul(s10r, yai) +% smul(s9r, ybi))
            wr(f, o1, s5r -% s6r)
            wr(f, o1 + 1, s5i -% s6i)
            wr(f, o4, s5r +% s6r)
            wr(f, o4 + 1, s5i +% s6i)
            let s11r: i32 = s0r +% (smul(s7r, ybr) +% smul(s8r, yar))
            let s11i: i32 = s0i +% (smul(s7i, ybr) +% smul(s8i, yar))
            let s12r: i32 = smul(s9i, yai) -% smul(s10i, ybi)
            let s12i: i32 = smul(s10r, ybi) -% smul(s9r, yai)
            wr(f, o2, s11r +% s12r)
            wr(f, o2 + 1, s11i +% s12i)
            wr(f, o3, s11r -% s12r)
            wr(f, o3 + 1, s11i -% s12i)
            u = u + 1
        }
        i = i + 1
    }
}

fn nfactors(shift: i32) -> i32 {
    if shift == 0 { return 5 }
    if shift == 3 { return 3 }
    return 4
}

fn factor_p(shift: i32, l: i32) -> i32 {
    let t: [i32; 20] = [5, 3, 4, 2, 4, 5, 3, 4, 4, 0, 5, 3, 2, 4, 0, 5, 3, 4, 0, 0]
    return t[(shift * 5 + l) as% usize]
}

fn factor_m(shift: i32, l: i32) -> i32 {
    let t: [i32; 20] = [96, 32, 8, 4, 1, 48, 16, 4, 1, 0, 24, 8, 4, 1, 0, 12, 4, 1, 0, 0]
    return t[(shift * 5 + l) as% usize]
}

fn fft_impl(shift: i32, f: u64) {
    let l: i32 = nfactors(shift)
    var fstride: [i32; 6] = [0; 6]
    fstride[0] = 1
    var k: i32 = 0
    while k < l {
        fstride[(k + 1) as% usize] = fstride[k as% usize] * factor_p(shift, k)
        k = k + 1
    }
    var m: i32 = factor_m(shift, l - 1)
    var i: i32 = l - 1
    while i >= 0 {
        var m2: i32 = 1
        if i != 0 { m2 = factor_m(shift, i - 1) }
        let p: i32 = factor_p(shift, i)
        let fs: i32 = fstride[i as% usize]
        if p == 2 { bfly2(f, fs) }
        if p == 4 { bfly4(f, fs << (shift as% u32), m, fs, m2) }
        if p == 3 { bfly3(f, fs << (shift as% u32), m, fs, m2) }
        if p == 5 { bfly5(f, fs << (shift as% u32), m, fs, m2) }
        m = m2
        i = i - 1
    }
}

fn bitrev_off(shift: i32) -> i32 {
    if shift == 0 { return 0 }
    if shift == 1 { return 480 }
    if shift == 2 { return 720 }
    return 840
}

fn trig_ld(i: i32) -> i32 {
    return celt_fix.ld16(celt_synth_tables.celt_mdct_trig_addr(), i)
}

fn celt_mdct_backward(inp: u64, out: u64, window: u64, overlap: i32, shift: i32, stride: i32) {
    var n: i32 = 1920
    var toff: i32 = 0
    var s: i32 = 0
    while s < shift {
        n = n >> 1
        toff = toff + n
        s = s + 1
    }
    let n2: i32 = n >> 1
    let n4: i32 = n >> 2
    let br: u64 = celt_synth_tables.celt_bitrev_addr()
    let yp: u64 = out +% ((overlap >> 1) as% u64) *% 4
    var i: i32 = 0
    var xp1: i32 = 0
    var xp2: i32 = stride * (n2 - 1)
    while i < n4 {
        let rev: i32 = celt_fix.ld16(br, bitrev_off(shift) + i)
        let t0: i32 = trig_ld(toff + i)
        let t1: i32 = trig_ld(toff + n4 + i)
        let a2: i32 = celt_fix.ld32(inp, xp2)
        let a1: i32 = celt_fix.ld32(inp, xp1)
        let yr: i32 = smul(a2, t0) +% smul(a1, t1)
        let yi: i32 = smul(a1, t0) -% smul(a2, t1)
        celt_fix.st32(yp, 2 * rev + 1, yr)
        celt_fix.st32(yp, 2 * rev, yi)
        xp1 = xp1 + 2 * stride
        xp2 = xp2 - 2 * stride
        i = i + 1
    }
    fft_impl(shift, yp)
    var q0: i32 = 0
    var q1: i32 = n2 - 2
    i = 0
    while i < ((n4 + 1) >> 1) {
        var re: i32 = celt_fix.ld32(yp, q0 + 1)
        var im: i32 = celt_fix.ld32(yp, q0)
        var t0: i32 = trig_ld(toff + i)
        var t1: i32 = trig_ld(toff + n4 + i)
        let yr: i32 = smul(re, t0) +% smul(im, t1)
        let yi: i32 = smul(re, t1) -% smul(im, t0)
        re = celt_fix.ld32(yp, q1 + 1)
        im = celt_fix.ld32(yp, q1)
        celt_fix.st32(yp, q0, yr)
        celt_fix.st32(yp, q1 + 1, yi)
        t0 = trig_ld(toff + n4 - i - 1)
        t1 = trig_ld(toff + n2 - i - 1)
        let yr2: i32 = smul(re, t0) +% smul(im, t1)
        let yi2: i32 = smul(re, t1) -% smul(im, t0)
        celt_fix.st32(yp, q1, yr2)
        celt_fix.st32(yp, q0 + 1, yi2)
        q0 = q0 + 2
        q1 = q1 - 2
        i = i + 1
    }
    var xi: i32 = overlap - 1
    var yi2: i32 = 0
    var w1: i32 = 0
    var w2: i32 = overlap - 1
    i = 0
    while i < (overlap >> 1) {
        let x1: i32 = celt_fix.ld32(out, xi)
        let x2: i32 = celt_fix.ld32(out, yi2)
        let wa: i32 = celt_fix.ld16(window, w1)
        let wb: i32 = celt_fix.ld16(window, w2)
        celt_fix.st32(out, yi2, celt_fix.mul16_32_q15(wb, x2) -% celt_fix.mul16_32_q15(wa, x1))
        celt_fix.st32(out, xi, celt_fix.mul16_32_q15(wa, x2) +% celt_fix.mul16_32_q15(wb, x1))
        yi2 = yi2 + 1
        xi = xi - 1
        w1 = w1 + 1
        w2 = w2 - 1
        i = i + 1
    }
}
