// SPDX-License-Identifier: MPL-2.0
import std.rt
import media.audio.opus.celt_fix

export {
    SilkDec, silk_dec_new, silk_dec_free, silk_dec_reset, silk_dec_reset_side, silk_dec_set_fs, is_wb,
    TYPE_NO_VOICE, TYPE_UNVOICED, TYPE_VOICED, CODE_INDEPENDENTLY, CODE_INDEPENDENTLY_NO_LTP_SCALING, CODE_CONDITIONALLY,
    MAX_FRAME_LENGTH, MAX_SUB_FRAME_LENGTH, MAX_LPC_ORDER, MAX_NB_SUBFR, LTP_ORDER
}

const TYPE_NO_VOICE: i32 = 0
const TYPE_UNVOICED: i32 = 1
const TYPE_VOICED: i32 = 2
const CODE_INDEPENDENTLY: i32 = 0
const CODE_INDEPENDENTLY_NO_LTP_SCALING: i32 = 1
const CODE_CONDITIONALLY: i32 = 2
const MAX_FRAME_LENGTH: i32 = 320
const MAX_SUB_FRAME_LENGTH: i32 = 80
const MAX_LPC_ORDER: i32 = 16
const MAX_NB_SUBFR: i32 = 4
const LTP_ORDER: i32 = 5
const OUT_BUF_LEN: i32 = 480
const SCRATCH_I32: i32 = 3072

struct SilkDec {
    fs_khz: i32,
    nb_subfr: i32,
    frame_length: i32,
    subfr_length: i32,
    ltp_mem_length: i32,
    lpc_order: i32,
    first_frame_after_reset: i32,
    prev_gain_q16: i32,
    last_gain_index: i32,
    lag_prev: i32,
    prev_signal_type: i32,
    ec_prev_signal_type: i32,
    ec_prev_lag_index: i32,
    signal_type: i32,
    quant_offset_type: i32,
    nlsf_interp_coef_q2: i32,
    lag_index: i32,
    contour_index: i32,
    per_index: i32,
    ltp_scale_index: i32,
    seed: i32,
    rand_seed: i32,
    frames_per_packet: i32,
    ltp_scale_q14: i32,
    lbrr_flag: i32,
    gains_idx: u64,
    nlsf_idx: u64,
    ltp_idx: u64,
    vad_flags: u64,
    lbrr_flags: u64,
    prev_nlsf: u64,
    pulses: u64,
    exc: u64,
    lpc_buf: u64,
    out_buf: u64,
    scratch: u64,
    gains_q16: u64,
    pitch_l: u64,
    pred_coef: u64,
    ltp_coef: u64,
    nlsf_cur: u64,
    nlsf_mid: u64,
    ltp_s16: u64,
    ltp_q15: u64,
    res_q14: u64,
    lpc_q14: u64,
    frame_buf: u64,
}

fn is_wb(d: *mut SilkDec) -> i32 {
    if (*d).fs_khz == 16 { return 1 }
    return 0
}

fn zero32(p: u64, n: i32) {
    var i: i32 = 0
    while i < n {
        celt_fix.st32(p, i, 0)
        i = i + 1
    }
}

fn silk_dec_new() -> SilkDec {
    var d: SilkDec = SilkDec {
        fs_khz: 0, nb_subfr: 4, frame_length: 0, subfr_length: 0, ltp_mem_length: 0, lpc_order: 0, first_frame_after_reset: 1,
        prev_gain_q16: 65536, last_gain_index: 10, lag_prev: 100, prev_signal_type: 0, ec_prev_signal_type: 0, ec_prev_lag_index: 0,
        signal_type: 0, quant_offset_type: 0, nlsf_interp_coef_q2: 0, lag_index: 0, contour_index: 0, per_index: 0, ltp_scale_index: 0,
        seed: 0, rand_seed: 0, frames_per_packet: 1, ltp_scale_q14: 0, lbrr_flag: 0,
        gains_idx: rt.heap_alloc(64), nlsf_idx: rt.heap_alloc(96), ltp_idx: rt.heap_alloc(32), vad_flags: rt.heap_alloc(16),
        lbrr_flags: rt.heap_alloc(16), prev_nlsf: rt.heap_alloc(96), pulses: rt.heap_alloc(1024), exc: rt.heap_alloc(1408),
        lpc_buf: rt.heap_alloc(96), out_buf: rt.heap_alloc(2048), scratch: rt.heap_alloc((SCRATCH_I32 * 4 + 64) as% usize),
        gains_q16: rt.heap_alloc(16), pitch_l: rt.heap_alloc(16), pred_coef: rt.heap_alloc(64), ltp_coef: rt.heap_alloc(48),
        nlsf_cur: rt.heap_alloc(32), nlsf_mid: rt.heap_alloc(32), ltp_s16: rt.heap_alloc(640), ltp_q15: rt.heap_alloc(2560),
        res_q14: rt.heap_alloc(320), lpc_q14: rt.heap_alloc(384), frame_buf: rt.heap_alloc(680) }
    silk_dec_reset(&d)
    return d
}

fn silk_dec_reset(d: *mut SilkDec) {
    zero32((*d).gains_idx, 16)
    zero32((*d).nlsf_idx, 24)
    zero32((*d).ltp_idx, 8)
    zero32((*d).vad_flags, 4)
    zero32((*d).lbrr_flags, 4)
    zero32((*d).prev_nlsf, 24)
    zero32((*d).pulses, 256)
    zero32((*d).exc, 352)
    zero32((*d).lpc_buf, 24)
    zero32((*d).out_buf, 512)
    zero32((*d).scratch, SCRATCH_I32)
    zero32((*d).gains_q16, 4)
    zero32((*d).pitch_l, 4)
    zero32((*d).pred_coef, 16)
    zero32((*d).ltp_coef, 12)
    zero32((*d).nlsf_cur, 8)
    zero32((*d).nlsf_mid, 8)
    zero32((*d).ltp_s16, 160)
    zero32((*d).ltp_q15, 640)
    zero32((*d).res_q14, 80)
    zero32((*d).lpc_q14, 96)
    zero32((*d).frame_buf, 170)
    (*d).lbrr_flag = 0
    (*d).ltp_scale_q14 = 0
    (*d).fs_khz = 0
    (*d).frame_length = 0
    (*d).first_frame_after_reset = 1
    (*d).prev_gain_q16 = 65536
    (*d).last_gain_index = 10
    (*d).lag_prev = 100
    (*d).prev_signal_type = 0
    (*d).ec_prev_signal_type = 0
    (*d).ec_prev_lag_index = 0
    (*d).rand_seed = 0
}

fn silk_dec_reset_side(d: *mut SilkDec) {
    zero32((*d).out_buf, 512)
    zero32((*d).lpc_buf, 16)
    (*d).lag_prev = 100
    (*d).last_gain_index = 10
    (*d).prev_signal_type = TYPE_NO_VOICE
    (*d).first_frame_after_reset = 1
}

fn silk_dec_set_fs(d: *mut SilkDec, fs_khz: i32) {
    (*d).subfr_length = 5 * fs_khz
    let frame_length: i32 = (*d).nb_subfr * (*d).subfr_length
    if (*d).fs_khz != fs_khz || frame_length != (*d).frame_length {
        if (*d).fs_khz != fs_khz {
            (*d).ltp_mem_length = 20 * fs_khz
            if fs_khz == 16 {
                (*d).lpc_order = 16
            } else {
                (*d).lpc_order = 10
            }
            (*d).first_frame_after_reset = 1
            (*d).lag_prev = 100
            (*d).last_gain_index = 10
            (*d).prev_signal_type = TYPE_NO_VOICE
            zero32((*d).out_buf, 512)
            zero32((*d).lpc_buf, 24)
        }
        (*d).fs_khz = fs_khz
        (*d).frame_length = frame_length
    }
}

fn silk_dec_free(d: *mut SilkDec) {
    rt.heap_free((*d).gains_idx, 64)
    rt.heap_free((*d).nlsf_idx, 96)
    rt.heap_free((*d).ltp_idx, 32)
    rt.heap_free((*d).vad_flags, 16)
    rt.heap_free((*d).lbrr_flags, 16)
    rt.heap_free((*d).prev_nlsf, 96)
    rt.heap_free((*d).pulses, 1024)
    rt.heap_free((*d).exc, 1408)
    rt.heap_free((*d).lpc_buf, 96)
    rt.heap_free((*d).out_buf, 2048)
    rt.heap_free((*d).scratch, (SCRATCH_I32 * 4 + 64) as% usize)
    rt.heap_free((*d).gains_q16, 16)
    rt.heap_free((*d).pitch_l, 16)
    rt.heap_free((*d).pred_coef, 64)
    rt.heap_free((*d).ltp_coef, 48)
    rt.heap_free((*d).nlsf_cur, 32)
    rt.heap_free((*d).nlsf_mid, 32)
    rt.heap_free((*d).ltp_s16, 640)
    rt.heap_free((*d).ltp_q15, 2560)
    rt.heap_free((*d).res_q14, 320)
    rt.heap_free((*d).lpc_q14, 384)
    rt.heap_free((*d).frame_buf, 680)
}
