import media.audio.opus.silk_nlsf_tables

export { cb_order, cb_cb1_icdf, cb_cb2_icdf, cb_select, cb_pred, cb_cb1, cb_wght, cb_delta_min }

fn cb_order(wb: i32) -> i32 {
    if wb != 0 { return 16 }
    return 10
}

fn cb_cb1_icdf(wb: i32) -> u64 {
    if wb != 0 { return silk_nlsf_tables.silk_nlsf_wb_cb1_icdf_addr() }
    return silk_nlsf_tables.silk_nlsf_nb_cb1_icdf_addr()
}

fn cb_cb2_icdf(wb: i32) -> u64 {
    if wb != 0 { return silk_nlsf_tables.silk_nlsf_wb_cb2_icdf_addr() }
    return silk_nlsf_tables.silk_nlsf_nb_cb2_icdf_addr()
}

fn cb_select(wb: i32) -> u64 {
    if wb != 0 { return silk_nlsf_tables.silk_nlsf_wb_select_addr() }
    return silk_nlsf_tables.silk_nlsf_nb_select_addr()
}

fn cb_pred(wb: i32) -> u64 {
    if wb != 0 { return silk_nlsf_tables.silk_nlsf_wb_pred_addr() }
    return silk_nlsf_tables.silk_nlsf_nb_pred_addr()
}

fn cb_cb1(wb: i32) -> u64 {
    if wb != 0 { return silk_nlsf_tables.silk_nlsf_wb_cb1_addr() }
    return silk_nlsf_tables.silk_nlsf_nb_cb1_addr()
}

fn cb_wght(wb: i32) -> u64 {
    if wb != 0 { return silk_nlsf_tables.silk_nlsf_wb_wght_addr() }
    return silk_nlsf_tables.silk_nlsf_nb_wght_addr()
}

fn cb_delta_min(wb: i32) -> u64 {
    if wb != 0 { return silk_nlsf_tables.silk_nlsf_wb_delta_min_addr() }
    return silk_nlsf_tables.silk_nlsf_nb_delta_min_addr()
}
