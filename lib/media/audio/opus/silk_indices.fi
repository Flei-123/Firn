import media.audio.opus.opus
import media.audio.opus.celt_fix
import media.audio.opus.silk_tables
import media.audio.opus.silk_nlsf_tables
import media.audio.opus.silk_nlsf_cb
import media.audio.opus.silk_state

export { silk_decode_indices, silk_nlsf_unpack }

fn silk_nlsf_unpack(wb: i32, cb1_index: i32, ec_ix: u64, pred_q8: u64) {
    let order: i32 = silk_nlsf_cb.cb_order(wb)
    let sel: u64 = silk_nlsf_cb.cb_select(wb) +% ((cb1_index *% order / 2) as% u64)
    let pred: u64 = silk_nlsf_cb.cb_pred(wb)
    var i: i32 = 0
    while i < order {
        let entry: i32 = celt_fix.ldb(sel, i >> 1)
        celt_fix.st32(ec_ix, i, ((entry >> 1) & 7) * 9)
        celt_fix.stb(pred_q8, i, celt_fix.ldb(pred, i + (entry & 1) * (order - 1)))
        celt_fix.st32(ec_ix, i + 1, ((entry >> 5) & 7) * 9)
        celt_fix.stb(pred_q8, i + 1, celt_fix.ldb(pred, i + ((entry >> 4) & 1) * (order - 1) + 1))
        i = i + 2
    }
}

fn pitch_lag_low_bits_icdf(fs_khz: i32) -> u64 {
    if fs_khz == 16 { return silk_tables.silk_uniform8_icdf_addr() }
    if fs_khz == 12 { return silk_tables.silk_uniform6_icdf_addr() }
    return silk_tables.silk_uniform4_icdf_addr()
}

fn pitch_contour_icdf(fs_khz: i32, nb_subfr: i32) -> u64 {
    if fs_khz == 8 {
        if nb_subfr == 4 { return silk_nlsf_tables.silk_pitch_contour_nb_icdf_addr() }
        return silk_nlsf_tables.silk_pitch_contour10_nb_icdf_addr()
    }
    if nb_subfr == 4 { return silk_nlsf_tables.silk_pitch_contour_icdf_addr() }
    return silk_nlsf_tables.silk_pitch_contour10_icdf_addr()
}

fn gain_icdf(signal_type: i32) -> u64 {
    return silk_tables.silk_gain_icdf_addr() +% ((signal_type *% 8) as% u64)
}

fn ltp_gain_icdf(per_index: i32) -> u64 {
    if per_index == 0 { return silk_nlsf_tables.silk_ltp_gain_icdf0_addr() }
    if per_index == 1 { return silk_nlsf_tables.silk_ltp_gain_icdf1_addr() }
    return silk_nlsf_tables.silk_ltp_gain_icdf2_addr()
}

fn silk_decode_indices(d: *mut silk_state.SilkDec, e: *mut opus.Ec, frame_index: i32, decode_lbrr: i32, cond_coding: i32) {
    var ix: i32 = 0
    if decode_lbrr != 0 || celt_fix.ld32((*d).vad_flags, frame_index) != 0 {
        ix = opus.ec_icdf(e, silk_tables.silk_type_vad_icdf_addr(), 8) + 2
    } else {
        ix = opus.ec_icdf(e, silk_tables.silk_type_novad_icdf_addr(), 8)
    }
    (*d).signal_type = ix >> 1
    (*d).quant_offset_type = ix & 1
    if cond_coding == silk_state.CODE_CONDITIONALLY {
        celt_fix.st32((*d).gains_idx, 0, opus.ec_icdf(e, silk_tables.silk_delta_gain_icdf_addr(), 8))
    } else {
        var g: i32 = opus.ec_icdf(e, gain_icdf((*d).signal_type), 8) << 3
        g = g + opus.ec_icdf(e, silk_tables.silk_uniform8_icdf_addr(), 8)
        celt_fix.st32((*d).gains_idx, 0, g)
    }
    var i: i32 = 1
    while i < (*d).nb_subfr {
        celt_fix.st32((*d).gains_idx, i, opus.ec_icdf(e, silk_tables.silk_delta_gain_icdf_addr(), 8))
        i = i + 1
    }
    let wb: i32 = silk_state.is_wb(d)
    let order: i32 = silk_nlsf_cb.cb_order(wb)
    let cb1: i32 = opus.ec_icdf(e, silk_nlsf_cb.cb_cb1_icdf(wb) +% ((((*d).signal_type >> 1) *% 32) as% u64), 8)
    celt_fix.st32((*d).nlsf_idx, 0, cb1)
    var ec_ix: [i32; 16] = [0; 16]
    var pred_q8: [u8; 16] = [0; 16]
    silk_nlsf_unpack(wb, cb1, (&ec_ix[0]) as u64, (&pred_q8[0]) as u64)
    i = 0
    while i < order {
        var v: i32 = opus.ec_icdf(e, silk_nlsf_cb.cb_cb2_icdf(wb) +% (ec_ix[i as% usize] as% u64), 8)
        if v == 0 {
            v = v - opus.ec_icdf(e, silk_tables.silk_nlsf_ext_icdf_addr(), 8)
        } else if v == 8 {
            v = v + opus.ec_icdf(e, silk_tables.silk_nlsf_ext_icdf_addr(), 8)
        }
        celt_fix.st32((*d).nlsf_idx, i + 1, v - 4)
        i = i + 1
    }
    if (*d).nb_subfr == 4 {
        (*d).nlsf_interp_coef_q2 = opus.ec_icdf(e, silk_tables.silk_nlsf_interp_icdf_addr(), 8)
    } else {
        (*d).nlsf_interp_coef_q2 = 4
    }
    if (*d).signal_type == silk_state.TYPE_VOICED {
        var absolute: i32 = 1
        if cond_coding == silk_state.CODE_CONDITIONALLY && (*d).ec_prev_signal_type == silk_state.TYPE_VOICED {
            var delta: i32 = opus.ec_icdf(e, silk_nlsf_tables.silk_pitch_delta_icdf_addr(), 8)
            if delta > 0 {
                delta = delta - 9
                (*d).lag_index = (*d).ec_prev_lag_index + delta
                absolute = 0
            }
        }
        if absolute != 0 {
            (*d).lag_index = opus.ec_icdf(e, silk_nlsf_tables.silk_pitch_lag_icdf_addr(), 8) * ((*d).fs_khz >> 1)
            (*d).lag_index = (*d).lag_index + opus.ec_icdf(e, pitch_lag_low_bits_icdf((*d).fs_khz), 8)
        }
        (*d).ec_prev_lag_index = (*d).lag_index
        (*d).contour_index = opus.ec_icdf(e, pitch_contour_icdf((*d).fs_khz, (*d).nb_subfr), 8)
        (*d).per_index = opus.ec_icdf(e, silk_nlsf_tables.silk_ltp_per_icdf_addr(), 8)
        var k: i32 = 0
        while k < (*d).nb_subfr {
            celt_fix.st32((*d).ltp_idx, k, opus.ec_icdf(e, ltp_gain_icdf((*d).per_index), 8))
            k = k + 1
        }
        if cond_coding == silk_state.CODE_INDEPENDENTLY {
            (*d).ltp_scale_index = opus.ec_icdf(e, silk_tables.silk_ltp_scale_icdf_addr(), 8)
        } else {
            (*d).ltp_scale_index = 0
        }
    }
    (*d).ec_prev_signal_type = (*d).signal_type
    (*d).seed = opus.ec_icdf(e, silk_tables.silk_uniform4_icdf_addr(), 8)
}
