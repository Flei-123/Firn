import media.audio.opus.celt_fix
import media.audio.opus.celt_synth_tables

export { smooth_fade }

fn smooth_fade(in1: u64, in2: u64, out: u64, overlap: i32, channels: i32) {
    let window: u64 = celt_synth_tables.celt_window_addr()
    var c: i32 = 0
    while c < channels {
        var i: i32 = 0
        while i < overlap {
            let wi: i32 = celt_fix.ld16(window, i)
            let w: i32 = celt_fix.mul16_16_q15(wi, wi)
            let idx: i32 = i * channels + c
            let v: i32 = celt_fix.shr32(celt_fix.mul16_16(w, celt_fix.ld16(in2, idx)) + (32767 - w) * celt_fix.ld16(in1, idx), 15)
            celt_fix.st16(out, idx, v)
            i = i + 1
        }
        c = c + 1
    }
}
