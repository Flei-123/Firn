import media.audio.opus.celt_fix
import media.audio.opus.silk_math
import media.audio.opus.silk_tables

export { silk_nlsf2a, silk_lpc_fit, silk_bwexpander_32, silk_lpc_inv_pred_gain }

const QA: i32 = 16
const QA_INV: i32 = 24
const A_LIMIT: i32 = 16773022
const MIN_INV_GAIN_Q30: i32 = 107374
const MAX_STABILIZE_ITERATIONS: i32 = 16
const CHIRP_Q16: i32 = 65470

fn silk_bwexpander_32(ar: u64, d: i32, chirp0: i32) {
    var chirp: i32 = chirp0
    let minus_one: i32 = chirp - 65536
    var i: i32 = 0
    while i < d - 1 {
        celt_fix.st32(ar, i, silk_math.smulww(chirp, celt_fix.ld32(ar, i)))
        chirp = chirp +% silk_math.rshift_round(chirp *% minus_one, 16)
        i = i + 1
    }
    celt_fix.st32(ar, d - 1, silk_math.smulww(chirp, celt_fix.ld32(ar, d - 1)))
}

fn silk_lpc_fit(a_out: u64, a_in: u64, qout: i32, qin: i32, d: i32) {
    var i: i32 = 0
    var at: i32 = 0
    while i < 10 {
        var maxabs: i32 = 0
        var k: i32 = 0
        while k < d {
            let absval: i32 = silk_math.abs32(celt_fix.ld32(a_in, k))
            if absval > maxabs {
                maxabs = absval
                at = k
            }
            k = k + 1
        }
        maxabs = silk_math.rshift_round(maxabs, qin - qout)
        if maxabs > 32767 {
            if maxabs > 163838 { maxabs = 163838 }
            let num: i32 = (maxabs - 32767) << 14
            let den: i32 = (maxabs * (at + 1)) >> 2
            silk_bwexpander_32(a_in, d, CHIRP_Q16 - num / den)
        } else {
            break
        }
        i = i + 1
    }
    var k: i32 = 0
    if i == 10 {
        while k < d {
            let v: i32 = silk_math.sat16(silk_math.rshift_round(celt_fix.ld32(a_in, k), qin - qout))
            celt_fix.st16(a_out, k, v)
            celt_fix.st32(a_in, k, silk_math.shl32(v, qin - qout))
            k = k + 1
        }
    } else {
        while k < d {
            celt_fix.st16(a_out, k, silk_math.rshift_round(celt_fix.ld32(a_in, k), qin - qout))
            k = k + 1
        }
    }
}

fn mul32_frac_q(a: i32, b: i32, q: i32) -> i32 {
    return silk_math.rshift_round64((a as% i64) * (b as% i64), q) as% i32
}

fn inv_gain_qa(a: u64, order: i32) -> i32 {
    var inv_gain_q30: i32 = 1073741824
    var k: i32 = order - 1
    while k > 0 {
        let ak: i32 = celt_fix.ld32(a, k)
        if ak > A_LIMIT || ak < 0 - A_LIMIT { return 0 }
        let rc_q31: i32 = 0 -% silk_math.shl32(ak, 31 - QA_INV)
        let rc_mult1_q30: i32 = 1073741824 -% silk_math.smmul(rc_q31, rc_q31)
        inv_gain_q30 = silk_math.shl32(silk_math.smmul(inv_gain_q30, rc_mult1_q30), 2)
        if inv_gain_q30 < MIN_INV_GAIN_Q30 { return 0 }
        let mult2q: i32 = 32 - silk_math.clz32(silk_math.abs32(rc_mult1_q30))
        let rc_mult2: i32 = silk_math.inverse32_varq(rc_mult1_q30, mult2q + 30)
        var n: i32 = 0
        while n < ((k + 1) >> 1) {
            let tmp1: i32 = celt_fix.ld32(a, n)
            let tmp2: i32 = celt_fix.ld32(a, k - n - 1)
            var t64: i64 = silk_math.rshift_round64((silk_math.sub_sat32(tmp1, mul32_frac_q(tmp2, rc_q31, 31)) as% i64) * (rc_mult2 as% i64), mult2q)
            if t64 > 2147483647 || t64 < 0 - 2147483648 { return 0 }
            celt_fix.st32(a, n, t64 as% i32)
            t64 = silk_math.rshift_round64((silk_math.sub_sat32(tmp2, mul32_frac_q(tmp1, rc_q31, 31)) as% i64) * (rc_mult2 as% i64), mult2q)
            if t64 > 2147483647 || t64 < 0 - 2147483648 { return 0 }
            celt_fix.st32(a, k - n - 1, t64 as% i32)
            n = n + 1
        }
        k = k - 1
    }
    let a0: i32 = celt_fix.ld32(a, 0)
    if a0 > A_LIMIT || a0 < 0 - A_LIMIT { return 0 }
    let rc_q31: i32 = 0 -% silk_math.shl32(a0, 31 - QA_INV)
    let rc_mult1_q30: i32 = 1073741824 -% silk_math.smmul(rc_q31, rc_q31)
    inv_gain_q30 = silk_math.shl32(silk_math.smmul(inv_gain_q30, rc_mult1_q30), 2)
    if inv_gain_q30 < MIN_INV_GAIN_Q30 { return 0 }
    return inv_gain_q30
}

fn silk_lpc_inv_pred_gain(a_q12: u64, order: i32) -> i32 {
    var tmp: [i32; 16] = [0; 16]
    var dc: i32 = 0
    var k: i32 = 0
    while k < order {
        let v: i32 = celt_fix.ld16(a_q12, k)
        dc = dc +% v
        tmp[k as% usize] = silk_math.shl32(v, QA_INV - 12)
        k = k + 1
    }
    if dc >= 4096 { return 0 }
    return inv_gain_qa((&tmp[0]) as u64, order)
}

fn find_poly(out: u64, clsf: u64, dd: i32) {
    celt_fix.st32(out, 0, 1 << QA)
    celt_fix.st32(out, 1, 0 -% celt_fix.ld32(clsf, 0))
    var k: i32 = 1
    while k < dd {
        let ftmp: i32 = celt_fix.ld32(clsf, 2 * k)
        let first: i32 = silk_math.rshift_round64((ftmp as% i64) * (celt_fix.ld32(out, k) as% i64), QA) as% i32
        celt_fix.st32(out, k + 1, silk_math.shl32(celt_fix.ld32(out, k - 1), 1) -% first)
        var n: i32 = k
        while n > 1 {
            let t: i32 = silk_math.rshift_round64((ftmp as% i64) * (celt_fix.ld32(out, n - 1) as% i64), QA) as% i32
            celt_fix.st32(out, n, celt_fix.ld32(out, n) +% (celt_fix.ld32(out, n - 2) -% t))
            n = n - 1
        }
        celt_fix.st32(out, 1, celt_fix.ld32(out, 1) -% ftmp)
        k = k + 1
    }
}

fn ordering(d: i32, k: i32) -> i32 {
    var o16: [u8; 16] = [0, 15, 8, 7, 4, 11, 12, 3, 2, 13, 10, 5, 6, 9, 14, 1]
    var o10: [u8; 10] = [0, 9, 6, 3, 4, 5, 8, 1, 2, 7]
    if d == 16 { return o16[k as% usize] as% i32 }
    return o10[k as% usize] as% i32
}

fn silk_nlsf2a(a_q12: u64, nlsf: u64, d: i32) {
    var cos_qa: [i32; 16] = [0; 16]
    var p: [i32; 9] = [0; 9]
    var q: [i32; 9] = [0; 9]
    var a32: [i32; 16] = [0; 16]
    let cos_tab: u64 = silk_tables.silk_lsf_cos_addr()
    var k: i32 = 0
    while k < d {
        let n: i32 = celt_fix.ld16(nlsf, k)
        let f_int: i32 = n >> 8
        let f_frac: i32 = n - (f_int << 8)
        let cos_val: i32 = celt_fix.ld16(cos_tab, f_int)
        let delta: i32 = celt_fix.ld16(cos_tab, f_int + 1) - cos_val
        cos_qa[ordering(d, k) as% usize] = silk_math.rshift_round((cos_val << 8) + delta * f_frac, 20 - QA)
        k = k + 1
    }
    let dd: i32 = d >> 1
    let cq: u64 = (&cos_qa[0]) as u64
    find_poly((&p[0]) as u64, cq, dd)
    find_poly((&q[0]) as u64, cq + 4, dd)
    k = 0
    while k < dd {
        let ptmp: i32 = p[(k + 1) as% usize] +% p[k as% usize]
        let qtmp: i32 = q[(k + 1) as% usize] -% q[k as% usize]
        a32[k as% usize] = (0 -% qtmp) -% ptmp
        a32[(d - k - 1) as% usize] = qtmp -% ptmp
        k = k + 1
    }
    let a32p: u64 = (&a32[0]) as u64
    silk_lpc_fit(a_q12, a32p, 12, QA + 1, d)
    var i: i32 = 0
    while i < MAX_STABILIZE_ITERATIONS && silk_lpc_inv_pred_gain(a_q12, d) == 0 {
        silk_bwexpander_32(a32p, d, 65536 - (2 << i))
        k = 0
        while k < d {
            celt_fix.st16(a_q12, k, silk_math.rshift_round(a32[k as% usize], QA + 1 - 12))
            k = k + 1
        }
        i = i + 1
    }
}
