import media.audio.opus.celt_fix
import media.audio.opus.celt_math
import media.audio.opus.celt_tables
import media.audio.opus.celt_vq

export { denormalise_bands, anti_collapse, comb_filter, deemphasis, sat_sig }

const SIG_SAT: i32 = 300000000

fn eb(i: i32) -> i32 {
    return celt_tables.celt_ebands(i as% usize) as% i32
}

fn denormalise_bands(x: u64, freq: u64, band_log_e: u64, start0: i32, end0: i32, m: i32, silence: i32) {
    let n: i32 = m * 120
    var start: i32 = start0
    var end: i32 = end0
    var bound: i32 = m * eb(end)
    if silence != 0 {
        bound = 0
        start = 0
        end = 0
    }
    var j: i32 = 0
    while j < m * eb(start) {
        celt_fix.st32(freq, j, 0)
        j = j + 1
    }
    var i: i32 = start
    while i < end {
        j = m * eb(i)
        let band_end: i32 = m * eb(i + 1)
        let lg: i32 = celt_fix.sat16(celt_fix.ld16(band_log_e, i) + ((celt_tables.celt_emeans(i as% usize) as% i32) << 6))
        var shift: i32 = 16 - (lg >> 10)
        var g: i32 = 0
        if shift > 31 {
            shift = 0
        } else {
            g = celt_math.celt_exp2_frac(lg & 1023)
        }
        if shift < 0 {
            if shift <= 0 - 2 {
                g = 16384
                shift = 0 - 2
            }
            while j < band_end {
                celt_fix.st32(freq, j, celt_fix.shl32(celt_fix.mul16_16(celt_fix.ld16(x, j), g), 0 - shift))
                j = j + 1
            }
        } else {
            while j < band_end {
                celt_fix.st32(freq, j, celt_fix.shr32(celt_fix.mul16_16(celt_fix.ld16(x, j), g), shift))
                j = j + 1
            }
        }
        i = i + 1
    }
    j = bound
    while j < n {
        celt_fix.st32(freq, j, 0)
        j = j + 1
    }
}

fn anti_collapse(x_: u64, masks: u64, lm: i32, chans: i32, size: i32, start: i32, end: i32, log_e: u64, prev1_log_e: u64, prev2_log_e: u64,
        pulses: u64, seed0: u32) {
    var seed: u32 = seed0
    var i: i32 = start
    while i < end {
        let n0: i32 = eb(i + 1) - eb(i)
        let depth: i32 = (celt_fix.celt_udiv((1 + celt_fix.ld32(pulses, i)) as% u32, n0 as% u32) as% i32) >> lm
        let thresh32: i32 = celt_math.celt_exp2(celt_fix.i16c(0 - celt_fix.i16c(depth << 7))) >> 1
        let thresh: i32 = celt_fix.mul16_32_q15(16384, celt_fix.imin(32767, thresh32))
        var t: i32 = n0 << lm
        let shift: i32 = celt_math.celt_ilog2(t) >> 1
        t = celt_fix.shl32(t, (7 - shift) << 1)
        let sqrt_1: i32 = celt_math.celt_rsqrt_norm(t)
        var c: i32 = 0
        while c < chans {
            var prev1: i32 = celt_fix.ld16(prev1_log_e, c * 21 + i)
            var prev2: i32 = celt_fix.ld16(prev2_log_e, c * 21 + i)
            if chans == 1 {
                prev1 = celt_fix.imax(prev1, celt_fix.ld16(prev1_log_e, 21 + i))
                prev2 = celt_fix.imax(prev2, celt_fix.ld16(prev2_log_e, 21 + i))
            }
            var ediff: i32 = celt_fix.ld16(log_e, c * 21 + i) - celt_fix.imin(prev1, prev2)
            ediff = celt_fix.imax(0, ediff)
            var r: i32 = 0
            if ediff < 16384 {
                let r32: i32 = celt_math.celt_exp2(celt_fix.i16c(0 - ediff)) >> 1
                r = celt_fix.i16c(2 * celt_fix.imin(16383, r32))
            }
            if lm == 3 {
                r = celt_fix.mul16_16_q14(23170, celt_fix.imin(23169, r))
            }
            r = celt_fix.imin(thresh, r) >> 1
            r = celt_fix.mul16_16_q15(sqrt_1, r) >> shift
            let xb: u64 = x_ +% ((c *% size + (eb(i) << lm)) as% u64) *% 2
            var renormalize: i32 = 0
            var k: i32 = 0
            while k < (1 << lm) {
                if (celt_fix.ldb(masks, i * chans + c) & (1 << k)) == 0 {
                    var j: i32 = 0
                    while j < n0 {
                        seed = celt_vq.lcg_rand(seed)
                        if (seed & 32768) != 0 {
                            celt_fix.st16(xb, (j << lm) + k, r)
                        } else {
                            celt_fix.st16(xb, (j << lm) + k, 0 - r)
                        }
                        j = j + 1
                    }
                    renormalize = 1
                }
                k = k + 1
            }
            if renormalize != 0 {
                celt_vq.renormalise_vector(xb, n0 << lm, 32767)
            }
            c = c + 1
        }
        i = i + 1
    }
}

fn gain_at(tapset: i32, k: i32) -> i32 {
    if tapset == 0 {
        if k == 0 { return 10048 }
        if k == 1 { return 7112 }
        return 4248
    }
    if tapset == 1 {
        if k == 0 { return 15200 }
        if k == 1 { return 8784 }
        return 0
    }
    if k == 0 { return 26208 }
    if k == 1 { return 3280 }
    return 0
}

fn sat_sig(v: i32) -> i32 {
    if v > SIG_SAT { return SIG_SAT }
    if v < 0 - SIG_SAT { return 0 - SIG_SAT }
    return v
}

fn comb_filter_const(y: u64, x: u64, t: i32, n: i32, g10: i32, g11: i32, g12: i32) {
    var x4: i32 = celt_fix.ld32(x, 0 - t - 2)
    var x3: i32 = celt_fix.ld32(x, 0 - t - 1)
    var x2: i32 = celt_fix.ld32(x, 0 - t)
    var x1: i32 = celt_fix.ld32(x, 0 - t + 1)
    var i: i32 = 0
    while i < n {
        let x0: i32 = celt_fix.ld32(x, i - t + 2)
        var v: i32 = celt_fix.ld32(x, i) +% celt_fix.mul16_32_q15(g10, x2) +% celt_fix.mul16_32_q15(g11, x1 +% x3) +% celt_fix.mul16_32_q15(g12, x0 +% x4)
        v = sat_sig(v)
        celt_fix.st32(y, i, v)
        x4 = x3
        x3 = x2
        x2 = x1
        x1 = x0
        i = i + 1
    }
}

fn comb_filter(y: u64, x: u64, t0_in: i32, t1_in: i32, n: i32, g0: i32, g1: i32, tapset0: i32, tapset1: i32, window: u64, overlap0: i32) {
    if g0 == 0 && g1 == 0 {
        if x != y {
            var q: i32 = 0
            while q < n {
                celt_fix.st32(y, q, celt_fix.ld32(x, q))
                q = q + 1
            }
        }
        return
    }
    let t0: i32 = celt_fix.imax(t0_in, 15)
    let t1: i32 = celt_fix.imax(t1_in, 15)
    let g00: i32 = celt_fix.mul16_16_p15(g0, gain_at(tapset0, 0))
    let g01: i32 = celt_fix.mul16_16_p15(g0, gain_at(tapset0, 1))
    let g02: i32 = celt_fix.mul16_16_p15(g0, gain_at(tapset0, 2))
    let g10: i32 = celt_fix.mul16_16_p15(g1, gain_at(tapset1, 0))
    let g11: i32 = celt_fix.mul16_16_p15(g1, gain_at(tapset1, 1))
    let g12: i32 = celt_fix.mul16_16_p15(g1, gain_at(tapset1, 2))
    var x1: i32 = celt_fix.ld32(x, 0 - t1 + 1)
    var x2: i32 = celt_fix.ld32(x, 0 - t1)
    var x3: i32 = celt_fix.ld32(x, 0 - t1 - 1)
    var x4: i32 = celt_fix.ld32(x, 0 - t1 - 2)
    var overlap: i32 = overlap0
    if g0 == g1 && t0 == t1 && tapset0 == tapset1 { overlap = 0 }
    var i: i32 = 0
    while i < overlap {
        let x0: i32 = celt_fix.ld32(x, i - t1 + 2)
        let w: i32 = celt_fix.ld16(window, i)
        let f: i32 = celt_fix.mul16_16_q15(w, w)
        let h0: i32 = 32767 - f
        var v: i32 = celt_fix.ld32(x, i)
        v = v +% celt_fix.mul16_32_q15(celt_fix.mul16_16_q15(h0, g00), celt_fix.ld32(x, i - t0))
        v = v +% celt_fix.mul16_32_q15(celt_fix.mul16_16_q15(h0, g01), celt_fix.ld32(x, i - t0 + 1) +% celt_fix.ld32(x, i - t0 - 1))
        v = v +% celt_fix.mul16_32_q15(celt_fix.mul16_16_q15(h0, g02), celt_fix.ld32(x, i - t0 + 2) +% celt_fix.ld32(x, i - t0 - 2))
        v = v +% celt_fix.mul16_32_q15(celt_fix.mul16_16_q15(f, g10), x2)
        v = v +% celt_fix.mul16_32_q15(celt_fix.mul16_16_q15(f, g11), x1 +% x3)
        v = v +% celt_fix.mul16_32_q15(celt_fix.mul16_16_q15(f, g12), x0 +% x4)
        celt_fix.st32(y, i, sat_sig(v))
        x4 = x3
        x3 = x2
        x2 = x1
        x1 = x0
        i = i + 1
    }
    if g1 == 0 {
        if x != y {
            var q: i32 = overlap
            while q < n {
                celt_fix.st32(y, q, celt_fix.ld32(x, q))
                q = q + 1
            }
        }
        return
    }
    comb_filter_const(y +% (i as% u64) *% 4, x +% (i as% u64) *% 4, t1, n - i, g10, g11, g12)
}

fn deemphasis(x: u64, pcm: u64, n: i32, chans: i32, c: i32, coef0: i32, mem: u64, accum: i32) {
    var m: i32 = celt_fix.ld32(mem, c)
    var j: i32 = 0
    while j < n {
        let tmp: i32 = celt_fix.ld32(x, j) +% m
        m = celt_fix.mul16_32_q15(coef0, tmp)
        var v: i32 = celt_fix.sig2word16(tmp)
        if accum != 0 { v = celt_fix.sat16(celt_fix.ld16(pcm, j * chans + c) + v) }
        celt_fix.st16(pcm, j * chans + c, v)
        j = j + 1
    }
    celt_fix.st32(mem, c, m)
}
