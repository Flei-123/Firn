// SPDX-License-Identifier: MPL-2.0
export {
    smulwb, smlawb, smulww, smlaww, smmul, smulbb, smlabb, rshift_round, rshift_round64, clz32, abs32, shl32, limit32,
    add_sat32, sub_sat32, lshift_sat32, sat16, add_sat16, log2lin, inverse32_varq, div32_varq, rand_next, ror32
}

const INT32_MAX: i32 = 2147483647
const INT32_MIN: i32 = 0 - 2147483647 - 1

fn smulwb(a: i32, b: i32) -> i32 {
    return (((a as% i64) * ((b as% i16) as% i64)) >> 16) as% i32
}

fn smlawb(a: i32, b: i32, c: i32) -> i32 {
    return a +% smulwb(b, c)
}

fn smulww(a: i32, b: i32) -> i32 {
    return (((a as% i64) * (b as% i64)) >> 16) as% i32
}

fn smlaww(a: i32, b: i32, c: i32) -> i32 {
    return a +% smulww(b, c)
}

fn smmul(a: i32, b: i32) -> i32 {
    return (((a as% i64) * (b as% i64)) >> 32) as% i32
}

fn smulbb(a: i32, b: i32) -> i32 {
    return ((a as% i16) as% i32) * ((b as% i16) as% i32)
}

fn smlabb(a: i32, b: i32, c: i32) -> i32 {
    return a +% (((b as% i16) as% i32) * ((c as% i16) as% i32))
}

fn rshift_round(a: i32, s: i32) -> i32 {
    if s == 1 {
        return (a >> 1) +% (a & 1)
    }
    return ((a >> (s - 1)) +% 1) >> 1
}

fn rshift_round64(a: i64, s: i32) -> i64 {
    if s == 1 {
        return (a >> 1) + (a & 1)
    }
    return ((a >> (s - 1)) + 1) >> 1
}

fn clz32(x: i32) -> i32 {
    var v: u32 = x as% u32
    if v == 0 {
        return 32
    }
    var n: i32 = 0
    while (v & 0x80000000) == 0 {
        v = v << 1
        n = n + 1
    }
    return n
}

fn abs32(a: i32) -> i32 {
    if a > 0 {
        return a
    }
    return 0 -% a
}

fn shl32(a: i32, s: i32) -> i32 {
    return ((a as% u32) << (s as% u32)) as% i32
}

fn limit32(a: i32, l1: i32, l2: i32) -> i32 {
    if l1 > l2 {
        if a > l1 { return l1 }
        if a < l2 { return l2 }
        return a
    }
    if a > l2 { return l2 }
    if a < l1 { return l1 }
    return a
}

fn add_sat32(a: i32, b: i32) -> i32 {
    let s: u32 = (a as% u32) +% (b as% u32)
    if (s & 0x80000000) == 0 {
        if (((a & b) as% u32) & 0x80000000) != 0 {
            return INT32_MIN
        }
        return a +% b
    }
    if (((a | b) as% u32) & 0x80000000) == 0 {
        return INT32_MAX
    }
    return a +% b
}

fn sub_sat32(a: i32, b: i32) -> i32 {
    let s: u32 = (a as% u32) -% (b as% u32)
    if (s & 0x80000000) == 0 {
        if (((a as% u32) & ((b as% u32) ^ 0x80000000) & 0x80000000)) != 0 {
            return INT32_MIN
        }
        return a -% b
    }
    if ((((a as% u32) ^ 0x80000000) & (b as% u32) & 0x80000000)) != 0 {
        return INT32_MAX
    }
    return a -% b
}

fn lshift_sat32(a: i32, s: i32) -> i32 {
    return shl32(limit32(a, INT32_MIN >> s, INT32_MAX >> s), s)
}

fn sat16(a: i32) -> i32 {
    if a > 32767 { return 32767 }
    if a < 0 - 32768 { return 0 - 32768 }
    return a
}

fn add_sat16(a: i32, b: i32) -> i32 {
    return sat16(a +% b)
}

fn ror32(a: i32, rot: i32) -> i32 {
    let x: u32 = a as% u32
    if rot == 0 {
        return a
    }
    if rot < 0 {
        let m: u32 = (0 - rot) as% u32
        return ((x << m) | (x >> (32 - m))) as% i32
    }
    let r: u32 = rot as% u32
    return ((x << (32 - r)) | (x >> r)) as% i32
}

fn log2lin(in_log_q7: i32) -> i32 {
    if in_log_q7 < 0 {
        return 0
    }
    if in_log_q7 >= 3967 {
        return INT32_MAX
    }
    var out: i32 = shl32(1, in_log_q7 >> 7)
    let frac: i32 = in_log_q7 & 127
    let t: i32 = smlawb(frac, smulbb(frac, 128 - frac), 0 - 174)
    if in_log_q7 < 2048 {
        out = out +% ((out *% t) >> 7)
    } else {
        out = out +% ((out >> 7) *% t)
    }
    return out
}

fn inverse32_varq(b32: i32, qres: i32) -> i32 {
    let b_headrm: i32 = clz32(abs32(b32)) - 1
    let b32_nrm: i32 = shl32(b32, b_headrm)
    let b32_inv: i32 = (INT32_MAX >> 2) / (b32_nrm >> 16)
    var result: i32 = shl32(b32_inv, 16)
    let err_q32: i32 = shl32((1 << 29) -% smulwb(b32_nrm, b32_inv), 3)
    result = smlaww(result, err_q32, b32_inv)
    let lshift: i32 = 61 - b_headrm - qres
    if lshift <= 0 {
        return lshift_sat32(result, 0 - lshift)
    }
    if lshift < 32 {
        return result >> lshift
    }
    return 0
}

fn div32_varq(a32: i32, b32: i32, qres: i32) -> i32 {
    let a_headrm: i32 = clz32(abs32(a32)) - 1
    var a32_nrm: i32 = shl32(a32, a_headrm)
    let b_headrm: i32 = clz32(abs32(b32)) - 1
    let b32_nrm: i32 = shl32(b32, b_headrm)
    let b32_inv: i32 = (INT32_MAX >> 2) / (b32_nrm >> 16)
    var result: i32 = smulwb(a32_nrm, b32_inv)
    a32_nrm = a32_nrm -% shl32(smmul(b32_nrm, result), 3)
    result = smlawb(result, a32_nrm, b32_inv)
    let lshift: i32 = 29 + a_headrm - b_headrm - qres
    if lshift < 0 {
        return lshift_sat32(result, 0 - lshift)
    }
    if lshift < 32 {
        return result >> lshift
    }
    return 0
}

fn rand_next(seed: i32) -> i32 {
    return (907633515 as% u32 +% ((seed as% u32) *% (196314165 as% u32))) as% i32
}
