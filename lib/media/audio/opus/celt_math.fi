// SPDX-License-Identifier: MPL-2.0
import media.audio.opus.celt_fix

export {
    add16, sub16, vshr32, celt_ilog2, celt_rcp, celt_div, frac_div32, celt_rsqrt_norm, celt_sqrt, celt_cos_norm,
    celt_exp2, celt_exp2_frac, celt_log2, frac_mul16, bitexact_cos, bitexact_log2tan
}

fn add16(a: i32, b: i32) -> i32 {
    return celt_fix.i16c(a + b)
}

fn sub16(a: i32, b: i32) -> i32 {
    return celt_fix.i16c(a - b)
}

fn vshr32(a: i32, s: i32) -> i32 {
    if s > 0 { return a >> s }
    return celt_fix.shl32(a, 0 - s)
}

fn celt_ilog2(x: i32) -> i32 {
    return celt_fix.ilog2_32(x as% u32)
}

fn q15(a: i32, b: i32) -> i32 {
    return celt_fix.mul16_16_q15(a, b)
}

fn p15(a: i32, b: i32) -> i32 {
    return celt_fix.mul16_16_p15(a, b)
}

fn celt_rcp(x: i32) -> i32 {
    let i: i32 = celt_ilog2(x)
    let n: i32 = celt_fix.i16c(vshr32(x, i - 15) - 32768)
    var r: i32 = add16(30840, q15(0 - 15420, n))
    r = sub16(r, q15(r, add16(q15(r, n), add16(r, 0 - 32768))))
    r = sub16(r, add16(1, q15(r, add16(q15(r, n), add16(r, 0 - 32768)))))
    return vshr32(r, i - 16)
}

fn celt_div(a: i32, b: i32) -> i32 {
    return celt_fix.mul32_32_q31(a, celt_rcp(b))
}

fn round16(x: i32, a: i32) -> i32 {
    return celt_fix.i16c(celt_fix.pshr32(x, a))
}

fn frac_div32(a0: i32, b0: i32) -> i32 {
    let shift: i32 = celt_ilog2(b0) - 29
    let a: i32 = vshr32(a0, shift)
    let b: i32 = vshr32(b0, shift)
    let rcp: i32 = round16(celt_rcp(round16(b, 16)), 3)
    var result: i32 = celt_fix.mul16_32_q15(rcp, a)
    let rem: i32 = celt_fix.pshr32(a, 2) -% celt_fix.mul32_32_q31(result, b)
    result = result +% celt_fix.shl32(celt_fix.mul16_32_q15(rcp, rem), 2)
    if result >= 536870912 { return 2147483647 }
    if result <= 0 - 536870912 { return 0 - 2147483647 }
    return celt_fix.shl32(result, 2)
}

fn celt_rsqrt_norm(x: i32) -> i32 {
    let n: i32 = celt_fix.i16c(x - 32768)
    let r: i32 = add16(23557, q15(n, add16(0 - 13490, q15(n, 6713))))
    let r2: i32 = q15(r, r)
    let y: i32 = celt_fix.i16c(sub16(add16(q15(r2, n), r2), 16384) << 1)
    return add16(r, q15(r, q15(y, sub16(q15(y, 12288), 16384))))
}

fn celt_sqrt(x0: i32) -> i32 {
    if x0 == 0 { return 0 }
    if x0 >= 1073741824 { return 32767 }
    let k: i32 = (celt_ilog2(x0) >> 1) - 7
    let x: i32 = vshr32(x0, 2 * k)
    let n: i32 = celt_fix.i16c(x - 32768)
    var rt: i32 = q15(n, 0 - 664)
    rt = add16(1699, rt)
    rt = add16(0 - 3011, q15(n, rt))
    rt = add16(11561, q15(n, rt))
    rt = add16(23175, q15(n, rt))
    return vshr32(rt, 7 - k)
}

fn cos_pi_2(x: i32) -> i32 {
    let x2: i32 = p15(x, x)
    let t3: i32 = (0 - 7651) + p15(x2, 8277 + p15(0 - 626, x2))
    var v: i32 = (32767 - x2) + p15(x2, t3)
    if v > 32766 { v = 32766 }
    return add16(1, v)
}

fn celt_cos_norm(x0: i32) -> i32 {
    var x: i32 = x0 & 131071
    if x > 65536 { x = 131072 - x }
    if (x & 32767) != 0 {
        if x < 32768 { return cos_pi_2(x) }
        return 0 - cos_pi_2(65536 - x)
    }
    if (x & 65535) != 0 { return 0 }
    if (x & 131071) != 0 { return 0 - 32767 }
    return 32767
}

fn celt_exp2_frac(x: i32) -> i32 {
    let frac: i32 = celt_fix.i16c(x << 4)
    return add16(16383, q15(frac, add16(22804, q15(frac, add16(14819, q15(10204, frac))))))
}

fn celt_exp2(x: i32) -> i32 {
    let integer: i32 = x >> 10
    if integer > 14 { return 2130706432 }
    if integer < 0 - 15 { return 0 }
    let frac: i32 = celt_exp2_frac(x - celt_fix.i16c(integer << 10))
    return vshr32(frac, 0 - integer - 2)
}

fn celt_log2(x: i32) -> i32 {
    if x == 0 { return 0 - 32767 }
    let i: i32 = celt_ilog2(x)
    let n: i32 = celt_fix.i16c(vshr32(x, i - 15) - 32768 - 16384)
    let c0: i32 = (0 - 6801) + (1 << 3)
    let frac: i32 = add16(c0, q15(n, add16(15746, q15(n, add16(0 - 5217, q15(n, add16(2545, q15(n, 0 - 1401))))))))
    return celt_fix.i16c((i - 13) << 10) + (frac >> 4)
}

fn frac_mul16(a: i32, b: i32) -> i32 {
    return (16384 + celt_fix.mul16_16(a, b)) >> 15
}

fn bitexact_cos(x: i32) -> i32 {
    var x2: i32 = (4096 + x * x) >> 13
    let t1: i32 = frac_mul16(0 - 626, x2)
    let t2: i32 = frac_mul16(x2, 8277 + t1)
    let t3: i32 = frac_mul16(x2, (0 - 7651) + t2)
    x2 = celt_fix.i16c((32767 - x2) + t3)
    return 1 + x2
}

fn bitexact_log2tan(isin0: i32, icos0: i32) -> i32 {
    let lc: i32 = celt_ilog2(icos0) + 1
    let ls: i32 = celt_ilog2(isin0) + 1
    let icos: i32 = icos0 << (15 - lc)
    let isin: i32 = isin0 << (15 - ls)
    return (ls - lc) * 2048 + frac_mul16(isin, frac_mul16(isin, 0 - 2597) + 7932) - frac_mul16(icos, frac_mul16(icos, 0 - 2597) + 7932)
}
