import media.audio.opus.opus
import media.audio.opus.celt_fix
import media.audio.opus.silk_tables

export { silk_decode_pulses }

fn shell_child(e: *mut opus.Ec, p: i32, table: u64) -> i32 {
    if p > 0 {
        return opus.ec_icdf(e, table +% (silk_tables.silk_shell_offsets(p as% usize) as% u64), 8)
    }
    return 0
}

fn shell_decode(e: *mut opus.Ec, out: u64, total: i32) {
    let t0: u64 = silk_tables.silk_shell0_addr()
    let t1: u64 = silk_tables.silk_shell1_addr()
    let t2: u64 = silk_tables.silk_shell2_addr()
    let t3: u64 = silk_tables.silk_shell3_addr()
    var p3: [i32; 2] = [0; 2]
    var p2: [i32; 4] = [0; 4]
    var p1: [i32; 8] = [0; 8]
    p3[0] = shell_child(e, total, t3)
    p3[1] = total - p3[0]
    p2[0] = shell_child(e, p3[0], t2)
    p2[1] = p3[0] - p2[0]
    p1[0] = shell_child(e, p2[0], t1)
    p1[1] = p2[0] - p1[0]
    var a: i32 = shell_child(e, p1[0], t0)
    celt_fix.st16(out, 0, a)
    celt_fix.st16(out, 1, p1[0] - a)
    a = shell_child(e, p1[1], t0)
    celt_fix.st16(out, 2, a)
    celt_fix.st16(out, 3, p1[1] - a)
    p1[2] = shell_child(e, p2[1], t1)
    p1[3] = p2[1] - p1[2]
    a = shell_child(e, p1[2], t0)
    celt_fix.st16(out, 4, a)
    celt_fix.st16(out, 5, p1[2] - a)
    a = shell_child(e, p1[3], t0)
    celt_fix.st16(out, 6, a)
    celt_fix.st16(out, 7, p1[3] - a)
    p2[2] = shell_child(e, p3[1], t2)
    p2[3] = p3[1] - p2[2]
    p1[4] = shell_child(e, p2[2], t1)
    p1[5] = p2[2] - p1[4]
    a = shell_child(e, p1[4], t0)
    celt_fix.st16(out, 8, a)
    celt_fix.st16(out, 9, p1[4] - a)
    a = shell_child(e, p1[5], t0)
    celt_fix.st16(out, 10, a)
    celt_fix.st16(out, 11, p1[5] - a)
    p1[6] = shell_child(e, p2[3], t1)
    p1[7] = p2[3] - p1[6]
    a = shell_child(e, p1[6], t0)
    celt_fix.st16(out, 12, a)
    celt_fix.st16(out, 13, p1[6] - a)
    a = shell_child(e, p1[7], t0)
    celt_fix.st16(out, 14, a)
    celt_fix.st16(out, 15, p1[7] - a)
}

fn decode_signs(e: *mut opus.Ec, pulses: u64, length: i32, signal_type: i32, quant_offset_type: i32, sums: u64) {
    var icdf: [u8; 2] = [0; 2]
    let base: i32 = 7 * (quant_offset_type + 2 * signal_type)
    let nblocks: i32 = (length + 8) >> 4
    var i: i32 = 0
    while i < nblocks {
        let p: i32 = celt_fix.ld32(sums, i)
        if p > 0 {
            var idx: i32 = p & 31
            if idx > 6 { idx = 6 }
            icdf[0] = silk_tables.silk_sign_icdf((base + idx) as% usize)
            var j: i32 = 0
            while j < 16 {
                let v: i32 = celt_fix.ld16(pulses, i * 16 + j)
                if v > 0 {
                    let s: i32 = 2 * opus.ec_icdf(e, (&icdf[0]) as u64, 8) - 1
                    celt_fix.st16(pulses, i * 16 + j, v * s)
                }
                j = j + 1
            }
        }
        i = i + 1
    }
}

fn silk_decode_pulses(e: *mut opus.Ec, pulses: u64, scratch: u64, signal_type: i32, quant_offset_type: i32, frame_length: i32) {
    let rate_level: i32 = opus.ec_icdf(e, silk_tables.silk_rate_levels_icdf_addr() +% (((signal_type >> 1) *% 9) as% u64), 8)
    var iter: i32 = frame_length >> 4
    if iter * 16 < frame_length { iter = iter + 1 }
    let sums: u64 = scratch
    let shifts: u64 = scratch + 128
    let cdf: u64 = silk_tables.silk_pulses_icdf_addr() +% ((rate_level *% 18) as% u64)
    let ext: u64 = silk_tables.silk_pulses_icdf_addr() +% ((9 *% 18) as% u64)
    var i: i32 = 0
    while i < iter {
        var n: i32 = 0
        var s: i32 = opus.ec_icdf(e, cdf, 8)
        while s == 17 {
            n = n + 1
            var off: u64 = 0
            if n == 10 { off = 1 }
            s = opus.ec_icdf(e, ext + off, 8)
        }
        celt_fix.st32(sums, i, s)
        celt_fix.st32(shifts, i, n)
        i = i + 1
    }
    i = 0
    while i < iter {
        if celt_fix.ld32(sums, i) > 0 {
            shell_decode(e, pulses +% ((i *% 32) as% u64), celt_fix.ld32(sums, i))
        } else {
            var k: i32 = 0
            while k < 16 {
                celt_fix.st16(pulses, i * 16 + k, 0)
                k = k + 1
            }
        }
        i = i + 1
    }
    i = 0
    while i < iter {
        let nls: i32 = celt_fix.ld32(shifts, i)
        if nls > 0 {
            var k: i32 = 0
            while k < 16 {
                var q: i32 = celt_fix.ld16(pulses, i * 16 + k)
                var j: i32 = 0
                while j < nls {
                    q = (q << 1) + opus.ec_icdf(e, silk_tables.silk_lsb_icdf_addr(), 8)
                    j = j + 1
                }
                celt_fix.st16(pulses, i * 16 + k, q)
                k = k + 1
            }
            celt_fix.st32(sums, i, celt_fix.ld32(sums, i) | (nls << 5))
        }
        i = i + 1
    }
    decode_signs(e, pulses, frame_length, signal_type, quant_offset_type, sums)
}
