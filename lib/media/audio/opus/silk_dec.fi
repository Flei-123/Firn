import media.audio.opus.opus
import media.audio.opus.celt_fix
import media.audio.opus.silk_tables
import media.audio.opus.silk_state
import media.audio.opus.silk_indices
import media.audio.opus.silk_pulses
import media.audio.opus.silk_params
import media.audio.opus.silk_core

export { silk_dec_setup, silk_dec_read_vad, silk_dec_read_lbrr_flags, silk_dec_skip_lbrr, silk_dec_decode }

fn silk_dec_setup(d: *mut silk_state.SilkDec, payload_ms: i32) {
    (*d).frames_per_packet = 1
    (*d).nb_subfr = 4
    if payload_ms <= 10 {
        (*d).nb_subfr = 2
    } else if payload_ms == 40 {
        (*d).frames_per_packet = 2
    } else if payload_ms == 60 {
        (*d).frames_per_packet = 3
    }
}

fn silk_dec_skip_lbrr(d: *mut silk_state.SilkDec, e: *mut opus.Ec, i: i32) {
    if celt_fix.ld32((*d).lbrr_flags, i) != 0 {
        var cond: i32 = silk_state.CODE_INDEPENDENTLY
        if i > 0 && celt_fix.ld32((*d).lbrr_flags, i - 1) != 0 { cond = silk_state.CODE_CONDITIONALLY }
        silk_indices.silk_decode_indices(d, e, i, 1, cond)
        silk_pulses.silk_decode_pulses(e, (*d).pulses, (*d).scratch, (*d).signal_type, (*d).quant_offset_type, (*d).frame_length)
    }
}

fn silk_dec_read_vad(d: *mut silk_state.SilkDec, e: *mut opus.Ec) {
    var i: i32 = 0
    while i < (*d).frames_per_packet {
        celt_fix.st32((*d).vad_flags, i, opus.ec_bit_logp(e, 1))
        i = i + 1
    }
    (*d).lbrr_flag = opus.ec_bit_logp(e, 1)
}

fn silk_dec_read_lbrr_flags(d: *mut silk_state.SilkDec, e: *mut opus.Ec) {
    let frames: i32 = (*d).frames_per_packet
    var i: i32 = 0
    while i < 3 {
        celt_fix.st32((*d).lbrr_flags, i, 0)
        i = i + 1
    }
    if (*d).lbrr_flag == 0 { return }
    if frames == 1 {
        celt_fix.st32((*d).lbrr_flags, 0, 1)
        return
    }
    var sym: i32 = 0
    if frames == 2 {
        sym = opus.ec_icdf(e, silk_tables.silk_lbrr2_icdf_addr(), 8) + 1
    } else {
        sym = opus.ec_icdf(e, silk_tables.silk_lbrr3_icdf_addr(), 8) + 1
    }
    i = 0
    while i < frames {
        celt_fix.st32((*d).lbrr_flags, i, (sym >> i) & 1)
        i = i + 1
    }
}

fn silk_dec_decode(d: *mut silk_state.SilkDec, e: *mut opus.Ec, frame_index: i32, cond: i32) -> i32 {
    let fl: i32 = (*d).frame_length
    let tmp: u64 = (*d).frame_buf
    silk_indices.silk_decode_indices(d, e, frame_index, 0, cond)
    silk_pulses.silk_decode_pulses(e, (*d).pulses, (*d).scratch, (*d).signal_type, (*d).quant_offset_type, fl)
    silk_params.silk_decode_parameters(d, cond)
    silk_core.silk_decode_core(d, tmp + 4)
    let mv: i32 = (*d).ltp_mem_length - fl
    var i: i32 = 0
    while i < mv {
        celt_fix.st16((*d).out_buf, i, celt_fix.ld16((*d).out_buf, i + fl))
        i = i + 1
    }
    i = 0
    while i < fl {
        celt_fix.st16((*d).out_buf, mv + i, celt_fix.ld16(tmp, 2 + i))
        i = i + 1
    }
    (*d).prev_signal_type = (*d).signal_type
    (*d).first_frame_after_reset = 0
    (*d).lag_prev = celt_fix.ld32((*d).pitch_l, (*d).nb_subfr - 1)
    return fl
}
