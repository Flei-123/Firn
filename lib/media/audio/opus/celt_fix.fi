// SPDX-License-Identifier: MPL-2.0
export {
    ld16, st16, ld32, st32, ldb, stb,
    add32, sub32, neg32, mul16_32_q15, mul16_32_q16, mul16_16, mul16_16_q15, mul16_16_p15, mul16_16_q14, mul16_16_p14,
    mul16_16_q13, mul16_16_q11, mul32_32_q31, mul32_32_q16, pshr32, shr32, shl32, sat16, sig2word16, imin, imax, iabs, i16c, isqrt32,
    ilog2_32, celt_zlog2, celt_udiv, celt_sudiv
}

fn ld16(p: u64, i: i32) -> i32 {
    return (*((p +% (i as% u64) *% 2) as *mut i16)) as% i32
}

fn st16(p: u64, i: i32, v: i32) {
    *((p +% (i as% u64) *% 2) as *mut i16) = v as% i16
}

fn ld32(p: u64, i: i32) -> i32 {
    return *((p +% (i as% u64) *% 4) as *mut i32)
}

fn st32(p: u64, i: i32, v: i32) {
    *((p +% (i as% u64) *% 4) as *mut i32) = v
}

fn ldb(p: u64, i: i32) -> i32 {
    return (*((p +% (i as% u64)) as *mut u8)) as% i32
}

fn stb(p: u64, i: i32, v: i32) {
    *((p +% (i as% u64)) as *mut u8) = v as% u8
}

fn add32(a: i32, b: i32) -> i32 {
    return a +% b
}

fn sub32(a: i32, b: i32) -> i32 {
    return a -% b
}

fn neg32(a: i32) -> i32 {
    return 0 -% a
}

fn mul16_32_q15(a: i32, b: i32) -> i32 {
    return (((a as% i64) * (b as% i64)) >> 15) as% i32
}

fn mul16_32_q16(a: i32, b: i32) -> i32 {
    return (((a as% i64) * (b as% i64)) >> 16) as% i32
}

fn mul32_32_q31(a: i32, b: i32) -> i32 {
    return (((a as% i64) * (b as% i64)) >> 31) as% i32
}

fn mul32_32_q16(a: i32, b: i32) -> i32 {
    return (((a as% i64) * (b as% i64)) >> 16) as% i32
}

fn mul16_16(a: i32, b: i32) -> i32 {
    return (a as% i16 as% i32) * (b as% i16 as% i32)
}

fn mul16_16_q15(a: i32, b: i32) -> i32 {
    return mul16_16(a, b) >> 15
}

fn mul16_16_p15(a: i32, b: i32) -> i32 {
    return (16384 + mul16_16(a, b)) >> 15
}

fn mul16_16_q14(a: i32, b: i32) -> i32 {
    return mul16_16(a, b) >> 14
}

fn mul16_16_p14(a: i32, b: i32) -> i32 {
    return (8192 + mul16_16(a, b)) >> 14
}

fn mul16_16_q13(a: i32, b: i32) -> i32 {
    return mul16_16(a, b) >> 13
}

fn mul16_16_q11(a: i32, b: i32) -> i32 {
    return mul16_16(a, b) >> 11
}

fn pshr32(a: i32, s: i32) -> i32 {
    return (a +% ((1 << s) >> 1)) >> s
}

fn shr32(a: i32, s: i32) -> i32 {
    return a >> s
}

fn shl32(a: i32, s: i32) -> i32 {
    return ((a as% u32) << (s as% u32)) as% i32
}

fn sat16(x: i32) -> i32 {
    if x > 32767 { return 32767 }
    if x < 0 - 32768 { return 0 - 32768 }
    return x
}

fn sig2word16(x: i32) -> i32 {
    return sat16(pshr32(x, 12))
}

fn i16c(x: i32) -> i32 {
    return x as% i16 as% i32
}

fn imin(a: i32, b: i32) -> i32 {
    if a < b { return a }
    return b
}

fn imax(a: i32, b: i32) -> i32 {
    if a > b { return a }
    return b
}

fn iabs(a: i32) -> i32 {
    if a < 0 { return 0 - a }
    return a
}

fn ilog2_32(x: u32) -> i32 {
    var n: i32 = 0
    var v: u32 = x
    while v > 1 {
        v = v >> 1
        n = n + 1
    }
    return n
}

fn celt_zlog2(x: i32) -> i32 {
    if x <= 0 { return 0 }
    return ilog2_32(x as% u32)
}

fn celt_udiv(n: u32, d: u32) -> u32 {
    return n / d
}

fn celt_sudiv(n: i32, d: i32) -> i32 {
    return n / d
}

fn isqrt32(val0: u32) -> u32 {
    var val: u32 = val0
    var g: u32 = 0
    var bshift: i32 = ilog2_32(val) >> 1
    var b: u32 = 1 << (bshift as% u32)
    while bshift >= 0 {
        let t: u32 = ((g << 1) + b) << (bshift as% u32)
        if t <= val {
            g = g + b
            val = val - t
        }
        b = b >> 1
        bshift = bshift - 1
    }
    return g
}
