import media.audio.opus.celt_fix
import media.audio.opus.celt_post
import media.audio.opus.celt_fft
import media.audio.opus.celt_synth_tables

export { celt_synthesis }

const SYNTH_OVERLAP: i32 = 120
const SYNTH_SHORT_MDCT: i32 = 120
const SYNTH_MAX_LM: i32 = 3

fn copy32(dst: u64, src: u64, n: i32) {
    var i: i32 = 0
    while i < n {
        celt_fix.st32(dst, i, celt_fix.ld32(src, i))
        i = i + 1
    }
}

fn imdct_blocks(freq: u64, out: u64, blocks: i32, block_len: i32, shift: i32) {
    let window: u64 = celt_synth_tables.celt_window_addr()
    var b: i32 = 0
    while b < blocks {
        celt_fft.celt_mdct_backward(freq +% (b as% u64) *% 4, out +% ((block_len *% b) as% u64) *% 4, window, SYNTH_OVERLAP, shift, blocks)
        b = b + 1
    }
}

fn celt_synthesis(x: u64, out0: u64, out1: u64, old_e: u64, start: i32, eff_end: i32, chans: i32, out_chans: i32, is_transient: i32, lm: i32, silence: i32) {
    let m: i32 = 1 << lm
    let n: i32 = SYNTH_SHORT_MDCT << lm
    var blocks: i32 = 1
    var block_len: i32 = n
    var shift: i32 = SYNTH_MAX_LM - lm
    if is_transient != 0 {
        blocks = m
        block_len = SYNTH_SHORT_MDCT
        shift = SYNTH_MAX_LM
    }
    var freq_store: [i32; 960] = [0; 960]
    let freq: u64 = (&freq_store[0]) as u64
    if out_chans == 2 && chans == 1 {
        celt_post.denormalise_bands(x, freq, old_e, start, eff_end, m, silence)
        let freq2: u64 = out1 +% ((SYNTH_OVERLAP / 2) as% u64) *% 4
        copy32(freq2, freq, n)
        imdct_blocks(freq2, out0, blocks, block_len, shift)
        imdct_blocks(freq, out1, blocks, block_len, shift)
    } else if out_chans == 1 && chans == 2 {
        let freq2: u64 = out0 +% ((SYNTH_OVERLAP / 2) as% u64) *% 4
        celt_post.denormalise_bands(x, freq, old_e, start, eff_end, m, silence)
        celt_post.denormalise_bands(x +% (n as% u64) *% 2, freq2, old_e + 42, start, eff_end, m, silence)
        var i: i32 = 0
        while i < n {
            celt_fix.st32(freq, i, (celt_fix.ld32(freq, i) >> 1) +% (celt_fix.ld32(freq2, i) >> 1))
            i = i + 1
        }
        imdct_blocks(freq, out0, blocks, block_len, shift)
    } else {
        var c: i32 = 0
        while c < out_chans {
            var out: u64 = out0
            if c == 1 { out = out1 }
            celt_post.denormalise_bands(x +% ((c *% n) as% u64) *% 2, freq, old_e +% ((c *% 21) as% u64) *% 2, start, eff_end, m, silence)
            imdct_blocks(freq, out, blocks, block_len, shift)
            c = c + 1
        }
    }
    var c2: i32 = 0
    while c2 < out_chans {
        var out2: u64 = out0
        if c2 == 1 { out2 = out1 }
        var i2: i32 = 0
        while i2 < n {
            celt_fix.st32(out2, i2, celt_post.sat_sig(celt_fix.ld32(out2, i2)))
            i2 = i2 + 1
        }
        c2 = c2 + 1
    }
}
