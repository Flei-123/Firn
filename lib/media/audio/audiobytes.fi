import std.rt

export { u8_at, le16, le24, le32, le64, be16, be24, be32, be64, f32_at }

fn u8_at(p: u64, o: usize) -> u32 {
    return rt.ld8(p, o) as u32
}

fn le16(p: u64, o: usize) -> u32 {
    return (rt.ld8(p, o) as u32) | ((rt.ld8(p, o + 1) as u32) << 8)
}

fn le24(p: u64, o: usize) -> u32 {
    return le16(p, o) | ((rt.ld8(p, o + 2) as u32) << 16)
}

fn le32(p: u64, o: usize) -> u32 {
    return le16(p, o) | (le16(p, o + 2) << 16)
}

fn le64(p: u64, o: usize) -> u64 {
    return (le32(p, o) as u64) | ((le32(p, o + 4) as u64) << 32)
}

fn be16(p: u64, o: usize) -> u32 {
    return ((rt.ld8(p, o) as u32) << 8) | (rt.ld8(p, o + 1) as u32)
}

fn be24(p: u64, o: usize) -> u32 {
    return (be16(p, o) << 8) | (rt.ld8(p, o + 2) as u32)
}

fn be32(p: u64, o: usize) -> u32 {
    return (be16(p, o) << 16) | be16(p, o + 2)
}

fn be64(p: u64, o: usize) -> u64 {
    return ((be32(p, o) as u64) << 32) | (be32(p, o + 4) as u64)
}

fn f32_at(p: u64, o: usize) -> f32 {
    return *((p + o as u64) as *mut f32)
}
