// SPDX-License-Identifier: MPL-2.0
export {
    Scale, scale_new, scale_setup, scale_x, scale_y, scale_mv_col, scale_mv_row, clamp_mv_col, clamp_mv_row,
    round_mv_q4, round_mv_q2, NO_SCALE,
}

const NO_SCALE: i64 = 16384

struct Scale {
    xfp: i64,
    yfp: i64,
    xstep: i64,
    ystep: i64,
    valid: bool,
    scaled: bool,
}

fn scale_new() -> Scale {
    return Scale { xfp: NO_SCALE, yfp: NO_SCALE, xstep: 16, ystep: 16, valid: true, scaled: false }
}

fn scale_x(sf: *Scale, v: i64) -> i64 {
    return (v * (*sf).xfp) >> 14
}

fn scale_y(sf: *Scale, v: i64) -> i64 {
    return (v * (*sf).yfp) >> 14
}

fn scale_setup(sf: *mut Scale, ref_w: i64, ref_h: i64, w: i64, h: i64) -> bool {
    if !(2 * w >= ref_w && 2 * h >= ref_h && w <= 16 * ref_w && h <= 16 * ref_h) {
        (*sf).valid = false
        (*sf).scaled = false
        (*sf).xfp = 0 - 1
        (*sf).yfp = 0 - 1
        (*sf).xstep = 16
        (*sf).ystep = 16
        return false
    }
    (*sf).valid = true
    (*sf).xfp = (ref_w << 14) / w
    (*sf).yfp = (ref_h << 14) / h
    (*sf).xstep = scale_x(sf, 16)
    (*sf).ystep = scale_y(sf, 16)
    (*sf).scaled = (*sf).xfp != NO_SCALE || (*sf).yfp != NO_SCALE
    return true
}

fn scale_mv_col(sf: *Scale, mv_col: i64, x: i64) -> i64 {
    return scale_x(sf, mv_col) + (scale_x(sf, x << 4) & 15)
}

fn scale_mv_row(sf: *Scale, mv_row: i64, y: i64) -> i64 {
    return scale_y(sf, mv_row) + (scale_y(sf, y << 4) & 15)
}

fn clamp_axis(v: i64, lo: i64, hi: i64) -> i64 {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

fn clamp_mv_col(mv_col: i64, ss_x: i64, bw: i64, mb_to_left: i64, mb_to_right: i64) -> i64 {
    let mul: i64 = 1 << ((1 - ss_x) as u64)
    let spel_left: i64 = (4 + bw) << 4
    let spel_right: i64 = spel_left - 16
    let v: i64 = ((mv_col * mul) << 48) >> 48
    return clamp_axis(v, mb_to_left * mul - spel_left, mb_to_right * mul + spel_right)
}

fn clamp_mv_row(mv_row: i64, ss_y: i64, bh: i64, mb_to_top: i64, mb_to_bottom: i64) -> i64 {
    let mul: i64 = 1 << ((1 - ss_y) as u64)
    let spel_top: i64 = (4 + bh) << 4
    let spel_bottom: i64 = spel_top - 16
    let v: i64 = ((mv_row * mul) << 48) >> 48
    return clamp_axis(v, mb_to_top * mul - spel_top, mb_to_bottom * mul + spel_bottom)
}

fn round_mv_q4(v: i64) -> i64 {
    if v < 0 {
        return (v - 2) / 4
    }
    return (v + 2) / 4
}

fn round_mv_q2(v: i64) -> i64 {
    if v < 0 {
        return (v - 1) / 2
    }
    return (v + 1) / 2
}
