import media.video.vp9.vp9mem

export { Mv, mv_new, mv_row, mv_col, set_mv, bmi_row, bmi_col, set_bmi, mv_equal }

fn mv_row(mi: u64, which: i64) -> i64 {
    return vp9mem.ldi16(mi, 8 + (which * 2) as usize)
}

fn mv_col(mi: u64, which: i64) -> i64 {
    return vp9mem.ldi16(mi, 9 + (which * 2) as usize)
}

fn set_mv(mi: u64, which: i64, row: i64, col: i64) {
    vp9mem.sti16(mi, 8 + (which * 2) as usize, row)
    vp9mem.sti16(mi, 9 + (which * 2) as usize, col)
}

fn bmi_row(mi: u64, blk: i64, which: i64) -> i64 {
    return vp9mem.ldi16(mi, 12 + (blk * 4 + which * 2) as usize)
}

fn bmi_col(mi: u64, blk: i64, which: i64) -> i64 {
    return vp9mem.ldi16(mi, 13 + (blk * 4 + which * 2) as usize)
}

fn set_bmi(mi: u64, blk: i64, which: i64, row: i64, col: i64) {
    vp9mem.sti16(mi, 12 + (blk * 4 + which * 2) as usize, row)
    vp9mem.sti16(mi, 13 + (blk * 4 + which * 2) as usize, col)
}

fn mv_equal(r0: i64, c0: i64, r1: i64, c1: i64) -> bool {
    return r0 == r1 && c0 == c1
}

struct Mv {
    row: i64,
    col: i64,
}

fn mv_new() -> Mv {
    return Mv { row: 0, col: 0 }
}
