import media.video.vp9.vp9mem
import media.video.vp9.vp9cospi

export { idct8, iadst8 }

fn idct8(inp: u64, out: u64) {
    var step1: [i64; 8] = [0; 8]
    var step2: [i64; 8] = [0; 8]
    var temp1: i64 = 0
    var temp2: i64 = 0
    step1[0] = vp9mem.ldi(inp, 0)
    step1[2] = vp9mem.ldi(inp, 4)
    step1[1] = vp9mem.ldi(inp, 2)
    step1[3] = vp9mem.ldi(inp, 6)
    temp1 = vp9mem.ldi(inp, 1) * vp9cospi.COSPI_28_64 - vp9mem.ldi(inp, 7) * vp9cospi.COSPI_4_64
    temp2 = vp9mem.ldi(inp, 1) * vp9cospi.COSPI_4_64 + vp9mem.ldi(inp, 7) * vp9cospi.COSPI_28_64
    step1[4] = (vp9mem.rs(temp1))
    step1[7] = (vp9mem.rs(temp2))
    temp1 = vp9mem.ldi(inp, 5) * vp9cospi.COSPI_12_64 - vp9mem.ldi(inp, 3) * vp9cospi.COSPI_20_64
    temp2 = vp9mem.ldi(inp, 5) * vp9cospi.COSPI_20_64 + vp9mem.ldi(inp, 3) * vp9cospi.COSPI_12_64
    step1[5] = (vp9mem.rs(temp1))
    step1[6] = (vp9mem.rs(temp2))
    temp1 = (step1[0] + step1[2]) * vp9cospi.COSPI_16_64
    temp2 = (step1[0] - step1[2]) * vp9cospi.COSPI_16_64
    step2[0] = (vp9mem.rs(temp1))
    step2[1] = (vp9mem.rs(temp2))
    temp1 = step1[1] * vp9cospi.COSPI_24_64 - step1[3] * vp9cospi.COSPI_8_64
    temp2 = step1[1] * vp9cospi.COSPI_8_64 + step1[3] * vp9cospi.COSPI_24_64
    step2[2] = (vp9mem.rs(temp1))
    step2[3] = (vp9mem.rs(temp2))
    step2[4] = (step1[4] + step1[5])
    step2[5] = (step1[4] - step1[5])
    step2[6] = (-step1[6] + step1[7])
    step2[7] = (step1[6] + step1[7])
    step1[0] = (step2[0] + step2[3])
    step1[1] = (step2[1] + step2[2])
    step1[2] = (step2[1] - step2[2])
    step1[3] = (step2[0] - step2[3])
    step1[4] = step2[4]
    temp1 = (step2[6] - step2[5]) * vp9cospi.COSPI_16_64
    temp2 = (step2[5] + step2[6]) * vp9cospi.COSPI_16_64
    step1[5] = (vp9mem.rs(temp1))
    step1[6] = (vp9mem.rs(temp2))
    step1[7] = step2[7]
    vp9mem.sti(out, 0, (step1[0] + step1[7]))
    vp9mem.sti(out, 1, (step1[1] + step1[6]))
    vp9mem.sti(out, 2, (step1[2] + step1[5]))
    vp9mem.sti(out, 3, (step1[3] + step1[4]))
    vp9mem.sti(out, 4, (step1[3] - step1[4]))
    vp9mem.sti(out, 5, (step1[2] - step1[5]))
    vp9mem.sti(out, 6, (step1[1] - step1[6]))
    vp9mem.sti(out, 7, (step1[0] - step1[7]))
}

fn iadst8(inp: u64, out: u64) {
    var s0: i64 = 0
    var s1: i64 = 0
    var s2: i64 = 0
    var s3: i64 = 0
    var s4: i64 = 0
    var s5: i64 = 0
    var s6: i64 = 0
    var s7: i64 = 0
    var x0: i64 = vp9mem.ldi(inp, 7)
    var x1: i64 = vp9mem.ldi(inp, 0)
    var x2: i64 = vp9mem.ldi(inp, 5)
    var x3: i64 = vp9mem.ldi(inp, 2)
    var x4: i64 = vp9mem.ldi(inp, 3)
    var x5: i64 = vp9mem.ldi(inp, 4)
    var x6: i64 = vp9mem.ldi(inp, 1)
    var x7: i64 = vp9mem.ldi(inp, 6)
    s0 = (vp9cospi.COSPI_2_64 * x0 + vp9cospi.COSPI_30_64 * x1)
    s1 = (vp9cospi.COSPI_30_64 * x0 - vp9cospi.COSPI_2_64 * x1)
    s2 = (vp9cospi.COSPI_10_64 * x2 + vp9cospi.COSPI_22_64 * x3)
    s3 = (vp9cospi.COSPI_22_64 * x2 - vp9cospi.COSPI_10_64 * x3)
    s4 = (vp9cospi.COSPI_18_64 * x4 + vp9cospi.COSPI_14_64 * x5)
    s5 = (vp9cospi.COSPI_14_64 * x4 - vp9cospi.COSPI_18_64 * x5)
    s6 = (vp9cospi.COSPI_26_64 * x6 + vp9cospi.COSPI_6_64 * x7)
    s7 = (vp9cospi.COSPI_6_64 * x6 - vp9cospi.COSPI_26_64 * x7)
    x0 = (vp9mem.rs(s0 + s4))
    x1 = (vp9mem.rs(s1 + s5))
    x2 = (vp9mem.rs(s2 + s6))
    x3 = (vp9mem.rs(s3 + s7))
    x4 = (vp9mem.rs(s0 - s4))
    x5 = (vp9mem.rs(s1 - s5))
    x6 = (vp9mem.rs(s2 - s6))
    x7 = (vp9mem.rs(s3 - s7))
    s0 = x0
    s1 = x1
    s2 = x2
    s3 = x3
    s4 = (vp9cospi.COSPI_8_64 * x4 + vp9cospi.COSPI_24_64 * x5)
    s5 = (vp9cospi.COSPI_24_64 * x4 - vp9cospi.COSPI_8_64 * x5)
    s6 = (-vp9cospi.COSPI_24_64 * x6 + vp9cospi.COSPI_8_64 * x7)
    s7 = (vp9cospi.COSPI_8_64 * x6 + vp9cospi.COSPI_24_64 * x7)
    x0 = (s0 + s2)
    x1 = (s1 + s3)
    x2 = (s0 - s2)
    x3 = (s1 - s3)
    x4 = (vp9mem.rs(s4 + s6))
    x5 = (vp9mem.rs(s5 + s7))
    x6 = (vp9mem.rs(s4 - s6))
    x7 = (vp9mem.rs(s5 - s7))
    s2 = (vp9cospi.COSPI_16_64 * (x2 + x3))
    s3 = (vp9cospi.COSPI_16_64 * (x2 - x3))
    s6 = (vp9cospi.COSPI_16_64 * (x6 + x7))
    s7 = (vp9cospi.COSPI_16_64 * (x6 - x7))
    x2 = (vp9mem.rs(s2))
    x3 = (vp9mem.rs(s3))
    x6 = (vp9mem.rs(s6))
    x7 = (vp9mem.rs(s7))
    vp9mem.sti(out, 0, (x0))
    vp9mem.sti(out, 1, (-x4))
    vp9mem.sti(out, 2, (x6))
    vp9mem.sti(out, 3, (-x2))
    vp9mem.sti(out, 4, (x3))
    vp9mem.sti(out, 5, (-x7))
    vp9mem.sti(out, 6, (x5))
    vp9mem.sti(out, 7, (-x1))
}
