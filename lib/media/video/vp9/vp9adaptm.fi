import media.video.vp9.vp9mem
import media.video.vp9.vp9state
import media.video.vp9.vp9defp
import media.video.vp9.vp9cnt
import media.video.vp9.vp9mvdef
import media.video.vp9.vp9adapt

export { adapt_mode, adapt_mv }

const SAT: i64 = 20
const UPD: i64 = 128

const T_INTRA: usize = 0
const T_PART: usize = 18
const T_INTER: usize = 24
const T_INTERP: usize = 30
const T_JOINT: usize = 34
const T_CLASS: usize = 40
const T_CLASS0: usize = 60
const T_FP: usize = 62

static TREES: [i8; 68] = [
    0, 2, -9, 4, -1, 6, 8, 12, -2, 10, -4, -5, -3, 14, -8, 16, -6, -7,
    0, 2, -1, 4, -2, -3,
    -2, 2, 0, 4, -1, -3,
    0, 2, -1, -2,
    0, 2, -1, 4, -2, -3,
    0, 2, -1, 4, 6, 8, -2, -3, 10, 12, -4, -5, -6, 14, 16, 18, -7, -8, -9, -10,
    0, -1,
    0, 2, -1, 4, -2, -3,
]

fn merge2(pre: u64, fc: u64, pi: usize, cnt: u64, ci: usize) {
    vp9mem.st8(fc, pi, vp9adapt.merge_prob(vp9mem.ld8(pre, pi), vp9mem.ld32(cnt, ci), vp9mem.ld32(cnt, ci + 1), SAT, UPD))
}

fn merge_tree(tb: usize, i: usize, pre: u64, fc: u64, poff: usize, cnt: u64, coff: usize) -> i64 {
    let l: i64 = TREES[tb + i] as i64
    var lc: i64 = 0
    if l <= 0 {
        lc = vp9mem.ld32(cnt, coff + (0 - l) as usize)
    } else {
        lc = merge_tree(tb, l as usize, pre, fc, poff, cnt, coff)
    }
    let r: i64 = TREES[tb + i + 1] as i64
    var rc: i64 = 0
    if r <= 0 {
        rc = vp9mem.ld32(cnt, coff + (0 - r) as usize)
    } else {
        rc = merge_tree(tb, r as usize, pre, fc, poff, cnt, coff)
    }
    let pi: usize = poff + (i >> 1)
    vp9mem.st8(fc, pi, vp9adapt.merge_prob(vp9mem.ld8(pre, pi), lc, rc, SAT, UPD))
    return lc + rc
}

fn merge_ct(pre: u64, fc: u64, pi: usize, c0: i64, c1: i64) {
    vp9mem.st8(fc, pi, vp9adapt.merge_prob(vp9mem.ld8(pre, pi), c0, c1, SAT, UPD))
}

fn adapt_tx(pre: u64, fc: u64, cnt: u64) {
    var c: usize = 0
    while c < 2 {
        let b8: usize = vp9cnt.N_TX8 + c * 2
        merge_ct(pre, fc, vp9defp.P_TX8 + c, vp9mem.ld32(cnt, b8), vp9mem.ld32(cnt, b8 + 1))
        let b16: usize = vp9cnt.N_TX16 + c * 3
        let a0: i64 = vp9mem.ld32(cnt, b16)
        let a1: i64 = vp9mem.ld32(cnt, b16 + 1)
        let a2: i64 = vp9mem.ld32(cnt, b16 + 2)
        merge_ct(pre, fc, vp9defp.P_TX16 + c * 2, a0, a1 + a2)
        merge_ct(pre, fc, vp9defp.P_TX16 + c * 2 + 1, a1, a2)
        let b32: usize = vp9cnt.N_TX32 + c * 4
        let e0: i64 = vp9mem.ld32(cnt, b32)
        let e1: i64 = vp9mem.ld32(cnt, b32 + 1)
        let e2: i64 = vp9mem.ld32(cnt, b32 + 2)
        let e3: i64 = vp9mem.ld32(cnt, b32 + 3)
        merge_ct(pre, fc, vp9defp.P_TX32 + c * 3, e0, e1 + e2 + e3)
        merge_ct(pre, fc, vp9defp.P_TX32 + c * 3 + 1, e1, e2 + e3)
        merge_ct(pre, fc, vp9defp.P_TX32 + c * 3 + 2, e2, e3)
        c = c + 1
    }
}

fn adapt_mode(f: *mut vp9state.Vp9) {
    let pre: u64 = (*f).saved + ((*f).ctx_idx as usize * vp9state.PROB_LEN) as u64
    let fc: u64 = (*f).fc
    let cnt: u64 = (*f).counts
    var i: usize = 0
    while i < 4 {
        merge2(pre, fc, vp9defp.P_INTRA_INTER + i, cnt, vp9cnt.N_INTRA_INTER + i * 2)
        i = i + 1
    }
    i = 0
    while i < 5 {
        merge2(pre, fc, vp9defp.P_COMP_INTER + i, cnt, vp9cnt.N_COMP_INTER + i * 2)
        merge2(pre, fc, vp9defp.P_COMP_REF + i, cnt, vp9cnt.N_COMP_REF + i * 2)
        merge2(pre, fc, vp9defp.P_SINGLE_REF + i * 2, cnt, vp9cnt.N_SINGLE_REF + i * 4)
        merge2(pre, fc, vp9defp.P_SINGLE_REF + i * 2 + 1, cnt, vp9cnt.N_SINGLE_REF + i * 4 + 2)
        i = i + 1
    }
    i = 0
    while i < 7 {
        merge_tree(T_INTER, 0, pre, fc, vp9defp.P_INTER_MODE + i * 3, cnt, vp9cnt.N_INTER_MODE + i * 4)
        i = i + 1
    }
    i = 0
    while i < 4 {
        merge_tree(T_INTRA, 0, pre, fc, vp9defp.P_YMODE + i * 9, cnt, vp9cnt.N_YMODE + i * 10)
        i = i + 1
    }
    i = 0
    while i < 10 {
        merge_tree(T_INTRA, 0, pre, fc, vp9defp.P_UVMODE + i * 9, cnt, vp9cnt.N_UVMODE + i * 10)
        i = i + 1
    }
    i = 0
    while i < 16 {
        merge_tree(T_PART, 0, pre, fc, vp9defp.P_PART + i * 3, cnt, vp9cnt.N_PART + i * 4)
        i = i + 1
    }
    if (*f).interp == 4 {
        i = 0
        while i < 4 {
            merge_tree(T_INTERP, 0, pre, fc, vp9defp.P_INTERP + i * 2, cnt, vp9cnt.N_INTERP + i * 3)
            i = i + 1
        }
    }
    if (*f).tx_mode == 4 {
        adapt_tx(pre, fc, cnt)
    }
    i = 0
    while i < 3 {
        merge2(pre, fc, vp9defp.P_SKIP + i, cnt, vp9cnt.N_SKIP + i * 2)
        i = i + 1
    }
}

fn adapt_mv(f: *mut vp9state.Vp9) {
    let pre: u64 = (*f).saved + ((*f).ctx_idx as usize * vp9state.PROB_LEN) as u64
    let fc: u64 = (*f).fc
    let cnt: u64 = (*f).counts
    merge_tree(T_JOINT, 0, pre, fc, vp9defp.P_MV_JOINT, cnt, vp9cnt.N_MV_JOINT)
    var comp: usize = 0
    while comp < 2 {
        var pb: usize = vp9defp.P_MV_COMP0
        if comp == 1 {
            pb = vp9defp.P_MV_COMP1
        }
        let cb: usize = vp9cnt.N_MV_COMP + comp * vp9mvdef.MVC_STRIDE
        merge2(pre, fc, pb + vp9mvdef.MVP_SIGN, cnt, cb + vp9mvdef.MVC_SIGN)
        merge_tree(T_CLASS, 0, pre, fc, pb + vp9mvdef.MVP_CLASSES, cnt, cb + vp9mvdef.MVC_CLASSES)
        merge_tree(T_CLASS0, 0, pre, fc, pb + vp9mvdef.MVP_CLASS0, cnt, cb + vp9mvdef.MVC_CLASS0)
        var j: usize = 0
        while j < 10 {
            merge2(pre, fc, pb + vp9mvdef.MVP_BITS + j, cnt, cb + vp9mvdef.MVC_BITS + j * 2)
            j = j + 1
        }
        j = 0
        while j < 2 {
            merge_tree(T_FP, 0, pre, fc, pb + vp9mvdef.MVP_CLASS0_FP + j * 3, cnt, cb + vp9mvdef.MVC_CLASS0_FP + j * 4)
            j = j + 1
        }
        merge_tree(T_FP, 0, pre, fc, pb + vp9mvdef.MVP_FP, cnt, cb + vp9mvdef.MVC_FP)
        if (*f).allow_hp {
            merge2(pre, fc, pb + vp9mvdef.MVP_CLASS0_HP, cnt, cb + vp9mvdef.MVC_CLASS0_HP)
            merge2(pre, fc, pb + vp9mvdef.MVP_HP, cnt, cb + vp9mvdef.MVC_HP)
        }
        comp = comp + 1
    }
}
