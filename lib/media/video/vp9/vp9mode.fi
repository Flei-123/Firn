import media.video.vp8.vp8bool
import media.video.vp9.vp9mem
import media.video.vp9.vp9state
import media.video.vp9.vp9defp
import media.video.vp9.vp9cnt
import media.video.vp9.vp9kfp
import media.video.vp9.vp9blk

export { read_intra_frame_info, cnt_add, read_partition }

fn cnt_add(f: *mut vp9state.Vp9, idx: usize) {
    vp9mem.st32((*f).counts, idx, vp9mem.ld32((*f).counts, idx) + 1)
}

fn read_intra_mode(d: *mut vp8bool.BD, p: u64) -> i64 {
    if vp8bool.bd_get(d, vp9mem.ld8(p, 0)) == 0 {
        return 0
    }
    if vp8bool.bd_get(d, vp9mem.ld8(p, 1)) == 0 {
        return 9
    }
    if vp8bool.bd_get(d, vp9mem.ld8(p, 2)) == 0 {
        return 1
    }
    if vp8bool.bd_get(d, vp9mem.ld8(p, 3)) == 0 {
        if vp8bool.bd_get(d, vp9mem.ld8(p, 4)) == 0 {
            return 2
        }
        if vp8bool.bd_get(d, vp9mem.ld8(p, 5)) == 0 {
            return 4
        }
        return 5
    }
    if vp8bool.bd_get(d, vp9mem.ld8(p, 6)) == 0 {
        return 3
    }
    if vp8bool.bd_get(d, vp9mem.ld8(p, 7)) == 0 {
        return 8
    }
    if vp8bool.bd_get(d, vp9mem.ld8(p, 8)) == 0 {
        return 6
    }
    return 7
}

fn read_partition(f: *mut vp9state.Vp9, row: i64, col: i64, has_rows: bool, has_cols: bool, n8l2: i64) -> i64 {
    let d: *mut vp8bool.BD = &(*f).td
    let above: i64 = (vp9mem.ld8((*f).above_part, col as usize) >> (n8l2 as u64)) & 1
    let left: i64 = (vp9mem.ld8((*f).left_part, (row & 7) as usize) >> (n8l2 as u64)) & 1
    let ctx: i64 = left * 2 + above + n8l2 * 4
    var p: u64 = vp9kfp.kf_part_addr() + (ctx * 3) as u64
    if !(*f).key && !(*f).intra_only {
        p = (*f).fc + (vp9defp.P_PART + (ctx * 3) as usize) as u64
    }
    var part: i64 = 3
    if has_rows && has_cols {
        if vp8bool.bd_get(d, vp9mem.ld8(p, 0)) == 0 {
            part = 0
        } else if vp8bool.bd_get(d, vp9mem.ld8(p, 1)) == 0 {
            part = 1
        } else if vp8bool.bd_get(d, vp9mem.ld8(p, 2)) == 0 {
            part = 2
        }
    } else if !has_rows && has_cols {
        if vp8bool.bd_get(d, vp9mem.ld8(p, 1)) == 0 {
            part = 1
        }
    } else if has_rows && !has_cols {
        if vp8bool.bd_get(d, vp9mem.ld8(p, 2)) == 0 {
            part = 2
        }
    }
    if !(*f).parallel {
        cnt_add(f, vp9cnt.N_PART + (ctx * 4 + part) as usize)
    }
    return part
}

fn read_segment_id(f: *mut vp9state.Vp9) -> i64 {
    let d: *mut vp8bool.BD = &(*f).td
    let b0: i64 = vp8bool.bd_get(d, (*f).seg_tree[0])
    let b1: i64 = vp8bool.bd_get(d, (*f).seg_tree[(1 + b0) as usize])
    let b2: i64 = vp8bool.bd_get(d, (*f).seg_tree[(3 + 2 * b0 + b1) as usize])
    return b0 * 4 + b1 * 2 + b2
}

fn block_mode_above(f: *mut vp9state.Vp9, mi: u64, above_mi: u64, have_above: bool, b: i64) -> i64 {
    if b >= 2 {
        return vp9mem.ld8(mi, vp9state.MI_YMODE + (b - 2) as usize)
    }
    if !have_above {
        return 0
    }
    return vp9mem.ld8(above_mi, vp9state.MI_YMODE + (b + 2) as usize)
}

fn block_mode_left(f: *mut vp9state.Vp9, mi: u64, left_mi: u64, have_left: bool, b: i64) -> i64 {
    if b == 1 || b == 3 {
        return vp9mem.ld8(mi, vp9state.MI_YMODE + (b - 1) as usize)
    }
    if !have_left {
        return 0
    }
    return vp9mem.ld8(left_mi, vp9state.MI_YMODE + (b + 1) as usize)
}

fn tx_ctx(f: *mut vp9state.Vp9, above_mi: u64, left_mi: u64, have_above: bool, have_left: bool, maxtx: i64) -> i64 {
    var a: i64 = maxtx
    var l: i64 = maxtx
    if have_above && vp9mem.ld8(above_mi, vp9state.MI_SKIP) == 0 {
        a = vp9mem.ld8(above_mi, vp9state.MI_TX)
    }
    if have_left && vp9mem.ld8(left_mi, vp9state.MI_SKIP) == 0 {
        l = vp9mem.ld8(left_mi, vp9state.MI_TX)
    }
    if !have_left {
        l = a
    }
    if !have_above {
        a = l
    }
    if a + l > maxtx {
        return 1
    }
    return 0
}

fn read_tx_size(f: *mut vp9state.Vp9, above_mi: u64, left_mi: u64, have_above: bool, have_left: bool, bsize: i64) -> i64 {
    let d: *mut vp8bool.BD = &(*f).td
    let maxtx: i64 = vp9blk.max_tx(bsize)
    var biggest: i64 = (*f).tx_mode
    if biggest > 3 {
        biggest = 3
    }
    if (*f).tx_mode == 4 && bsize >= 3 {
        let ctx: i64 = tx_ctx(f, above_mi, left_mi, have_above, have_left, maxtx)
        let fc: u64 = (*f).fc
        var tx: i64 = 0
        if maxtx == 1 {
            tx = vp8bool.bd_get(d, vp9mem.ld8(fc, vp9defp.P_TX8 + ctx as usize))
            if !(*f).parallel {
                cnt_add(f, vp9cnt.N_TX8 + (ctx * 2 + tx) as usize)
            }
        } else if maxtx == 2 {
            let p: usize = vp9defp.P_TX16 + (ctx * 2) as usize
            tx = vp8bool.bd_get(d, vp9mem.ld8(fc, p))
            if tx != 0 {
                tx = tx + vp8bool.bd_get(d, vp9mem.ld8(fc, p + 1))
            }
            if !(*f).parallel {
                cnt_add(f, vp9cnt.N_TX16 + (ctx * 3 + tx) as usize)
            }
        } else {
            let p: usize = vp9defp.P_TX32 + (ctx * 3) as usize
            tx = vp8bool.bd_get(d, vp9mem.ld8(fc, p))
            if tx != 0 {
                tx = tx + vp8bool.bd_get(d, vp9mem.ld8(fc, p + 1))
                if tx != 1 {
                    tx = tx + vp8bool.bd_get(d, vp9mem.ld8(fc, p + 2))
                }
            }
            if !(*f).parallel {
                cnt_add(f, vp9cnt.N_TX32 + (ctx * 4 + tx) as usize)
            }
        }
        return tx
    }
    return vp9mem.imin(maxtx, biggest)
}

fn read_intra_frame_info(f: *mut vp9state.Vp9, mi: u64, row: i64, col: i64, bsize: i64, x_mis: i64, y_mis: i64) {
    let d: *mut vp8bool.BD = &(*f).td
    let have_above: bool = row > 0
    let have_left: bool = col > (*f).tile_c0
    var above_mi: u64 = 0
    var left_mi: u64 = 0
    if have_above {
        above_mi = vp9state.mi_ptr(f, row - 1, col)
    }
    if have_left {
        left_mi = vp9state.mi_ptr(f, row, col - 1)
    }
    let stride: i64 = (*f).sb_cols * 8
    var seg: i64 = 0
    if (*f).seg_on {
        if !(*f).seg_map {
            var y: i64 = 0
            while y < y_mis {
                var x: i64 = 0
                while x < x_mis {
                    let idx: usize = ((row + y) * stride + col + x) as usize
                    vp9mem.st8((*f).seg_cur, idx, vp9mem.ld8((*f).seg_last, idx))
                    x = x + 1
                }
                y = y + 1
            }
        } else {
            seg = read_segment_id(f)
            var y: i64 = 0
            while y < y_mis {
                var x: i64 = 0
                while x < x_mis {
                    vp9mem.st8((*f).seg_cur, ((row + y) * stride + col + x) as usize, seg)
                    x = x + 1
                }
                y = y + 1
            }
        }
    }
    var skip: i64 = 0
    if (*f).seg_on && (*f).seg_en[(seg * 4 + 3) as usize] == 1 {
        skip = 1
    } else {
        var sctx: i64 = 0
        if have_above {
            sctx = sctx + vp9mem.ld8(above_mi, vp9state.MI_SKIP)
        }
        if have_left {
            sctx = sctx + vp9mem.ld8(left_mi, vp9state.MI_SKIP)
        }
        skip = vp8bool.bd_get(d, vp9mem.ld8((*f).fc, vp9defp.P_SKIP + sctx as usize))
        if !(*f).parallel {
            cnt_add(f, vp9cnt.N_SKIP + (sctx * 2 + skip) as usize)
        }
    }
    let tx: i64 = read_tx_size(f, above_mi, left_mi, have_above, have_left, bsize)
    vp9mem.st8(mi, vp9state.MI_BSIZE, bsize)
    vp9mem.st8(mi, vp9state.MI_TX, tx)
    vp9mem.st8(mi, vp9state.MI_SKIP, skip)
    vp9mem.st8(mi, vp9state.MI_SEG, seg)
    vp9mem.st8(mi, vp9state.MI_REF0, 0)
    vp9mem.st8(mi, vp9state.MI_REF1, 0)
    let kfy: u64 = vp9kfp.kf_y_addr()
    if bsize >= 3 {
        let a: i64 = block_mode_above(f, mi, above_mi, have_above, 0)
        let l: i64 = block_mode_left(f, mi, left_mi, have_left, 0)
        let m: i64 = read_intra_mode(d, kfy + ((a * 10 + l) * 9) as u64)
        var i: usize = 0
        while i < 4 {
            vp9mem.st8(mi, vp9state.MI_YMODE + i, m)
            i = i + 1
        }
        vp9mem.st8(mi, vp9state.MI_MODE, m)
    } else {
        let w4: i64 = vp9blk.bw4(bsize)
        let h4: i64 = vp9blk.bh4(bsize)
        var last: i64 = 0
        var idy: i64 = 0
        while idy < 2 {
            var idx: i64 = 0
            while idx < 2 {
                let b: i64 = idy * 2 + idx
                let a: i64 = block_mode_above(f, mi, above_mi, have_above, b)
                let l: i64 = block_mode_left(f, mi, left_mi, have_left, b)
                let m: i64 = read_intra_mode(d, kfy + ((a * 10 + l) * 9) as u64)
                vp9mem.st8(mi, vp9state.MI_YMODE + b as usize, m)
                if h4 == 2 {
                    vp9mem.st8(mi, vp9state.MI_YMODE + (b + 2) as usize, m)
                }
                if w4 == 2 {
                    vp9mem.st8(mi, vp9state.MI_YMODE + (b + 1) as usize, m)
                }
                last = m
                idx = idx + w4
            }
            idy = idy + h4
        }
        vp9mem.st8(mi, vp9state.MI_MODE, last)
    }
    let ym: i64 = vp9mem.ld8(mi, vp9state.MI_MODE)
    let uv: i64 = read_intra_mode(d, vp9kfp.kf_uv_addr() + (ym * 9) as u64)
    vp9mem.st8(mi, vp9state.MI_UV, uv)
}
