import media.video.vp9.vp9mem
import media.video.vp9.vp9cospi

export { idct16, iadst16 }

fn idct16(inp: u64, out: u64) {
    var step1: [i64; 16] = [0; 16]
    var step2: [i64; 16] = [0; 16]
    var temp1: i64 = 0
    var temp2: i64 = 0
    step1[0] = vp9mem.ldi(inp, 0)
    step1[1] = vp9mem.ldi(inp, 8)
    step1[2] = vp9mem.ldi(inp, 4)
    step1[3] = vp9mem.ldi(inp, 12)
    step1[4] = vp9mem.ldi(inp, 2)
    step1[5] = vp9mem.ldi(inp, 10)
    step1[6] = vp9mem.ldi(inp, 6)
    step1[7] = vp9mem.ldi(inp, 14)
    step1[8] = vp9mem.ldi(inp, 1)
    step1[9] = vp9mem.ldi(inp, 9)
    step1[10] = vp9mem.ldi(inp, 5)
    step1[11] = vp9mem.ldi(inp, 13)
    step1[12] = vp9mem.ldi(inp, 3)
    step1[13] = vp9mem.ldi(inp, 11)
    step1[14] = vp9mem.ldi(inp, 7)
    step1[15] = vp9mem.ldi(inp, 15)
    step2[0] = step1[0]
    step2[1] = step1[1]
    step2[2] = step1[2]
    step2[3] = step1[3]
    step2[4] = step1[4]
    step2[5] = step1[5]
    step2[6] = step1[6]
    step2[7] = step1[7]
    temp1 = step1[8] * vp9cospi.COSPI_30_64 - step1[15] * vp9cospi.COSPI_2_64
    temp2 = step1[8] * vp9cospi.COSPI_2_64 + step1[15] * vp9cospi.COSPI_30_64
    step2[8] = (vp9mem.rs(temp1))
    step2[15] = (vp9mem.rs(temp2))
    temp1 = step1[9] * vp9cospi.COSPI_14_64 - step1[14] * vp9cospi.COSPI_18_64
    temp2 = step1[9] * vp9cospi.COSPI_18_64 + step1[14] * vp9cospi.COSPI_14_64
    step2[9] = (vp9mem.rs(temp1))
    step2[14] = (vp9mem.rs(temp2))
    temp1 = step1[10] * vp9cospi.COSPI_22_64 - step1[13] * vp9cospi.COSPI_10_64
    temp2 = step1[10] * vp9cospi.COSPI_10_64 + step1[13] * vp9cospi.COSPI_22_64
    step2[10] = (vp9mem.rs(temp1))
    step2[13] = (vp9mem.rs(temp2))
    temp1 = step1[11] * vp9cospi.COSPI_6_64 - step1[12] * vp9cospi.COSPI_26_64
    temp2 = step1[11] * vp9cospi.COSPI_26_64 + step1[12] * vp9cospi.COSPI_6_64
    step2[11] = (vp9mem.rs(temp1))
    step2[12] = (vp9mem.rs(temp2))
    step1[0] = step2[0]
    step1[1] = step2[1]
    step1[2] = step2[2]
    step1[3] = step2[3]
    temp1 = step2[4] * vp9cospi.COSPI_28_64 - step2[7] * vp9cospi.COSPI_4_64
    temp2 = step2[4] * vp9cospi.COSPI_4_64 + step2[7] * vp9cospi.COSPI_28_64
    step1[4] = (vp9mem.rs(temp1))
    step1[7] = (vp9mem.rs(temp2))
    temp1 = step2[5] * vp9cospi.COSPI_12_64 - step2[6] * vp9cospi.COSPI_20_64
    temp2 = step2[5] * vp9cospi.COSPI_20_64 + step2[6] * vp9cospi.COSPI_12_64
    step1[5] = (vp9mem.rs(temp1))
    step1[6] = (vp9mem.rs(temp2))
    step1[8] = (step2[8] + step2[9])
    step1[9] = (step2[8] - step2[9])
    step1[10] = (-step2[10] + step2[11])
    step1[11] = (step2[10] + step2[11])
    step1[12] = (step2[12] + step2[13])
    step1[13] = (step2[12] - step2[13])
    step1[14] = (-step2[14] + step2[15])
    step1[15] = (step2[14] + step2[15])
    temp1 = (step1[0] + step1[1]) * vp9cospi.COSPI_16_64
    temp2 = (step1[0] - step1[1]) * vp9cospi.COSPI_16_64
    step2[0] = (vp9mem.rs(temp1))
    step2[1] = (vp9mem.rs(temp2))
    temp1 = step1[2] * vp9cospi.COSPI_24_64 - step1[3] * vp9cospi.COSPI_8_64
    temp2 = step1[2] * vp9cospi.COSPI_8_64 + step1[3] * vp9cospi.COSPI_24_64
    step2[2] = (vp9mem.rs(temp1))
    step2[3] = (vp9mem.rs(temp2))
    step2[4] = (step1[4] + step1[5])
    step2[5] = (step1[4] - step1[5])
    step2[6] = (-step1[6] + step1[7])
    step2[7] = (step1[6] + step1[7])
    step2[8] = step1[8]
    step2[15] = step1[15]
    temp1 = -step1[9] * vp9cospi.COSPI_8_64 + step1[14] * vp9cospi.COSPI_24_64
    temp2 = step1[9] * vp9cospi.COSPI_24_64 + step1[14] * vp9cospi.COSPI_8_64
    step2[9] = (vp9mem.rs(temp1))
    step2[14] = (vp9mem.rs(temp2))
    temp1 = -step1[10] * vp9cospi.COSPI_24_64 - step1[13] * vp9cospi.COSPI_8_64
    temp2 = -step1[10] * vp9cospi.COSPI_8_64 + step1[13] * vp9cospi.COSPI_24_64
    step2[10] = (vp9mem.rs(temp1))
    step2[13] = (vp9mem.rs(temp2))
    step2[11] = step1[11]
    step2[12] = step1[12]
    step1[0] = (step2[0] + step2[3])
    step1[1] = (step2[1] + step2[2])
    step1[2] = (step2[1] - step2[2])
    step1[3] = (step2[0] - step2[3])
    step1[4] = step2[4]
    temp1 = (step2[6] - step2[5]) * vp9cospi.COSPI_16_64
    temp2 = (step2[5] + step2[6]) * vp9cospi.COSPI_16_64
    step1[5] = (vp9mem.rs(temp1))
    step1[6] = (vp9mem.rs(temp2))
    step1[7] = step2[7]
    step1[8] = (step2[8] + step2[11])
    step1[9] = (step2[9] + step2[10])
    step1[10] = (step2[9] - step2[10])
    step1[11] = (step2[8] - step2[11])
    step1[12] = (-step2[12] + step2[15])
    step1[13] = (-step2[13] + step2[14])
    step1[14] = (step2[13] + step2[14])
    step1[15] = (step2[12] + step2[15])
    step2[0] = (step1[0] + step1[7])
    step2[1] = (step1[1] + step1[6])
    step2[2] = (step1[2] + step1[5])
    step2[3] = (step1[3] + step1[4])
    step2[4] = (step1[3] - step1[4])
    step2[5] = (step1[2] - step1[5])
    step2[6] = (step1[1] - step1[6])
    step2[7] = (step1[0] - step1[7])
    step2[8] = step1[8]
    step2[9] = step1[9]
    temp1 = (-step1[10] + step1[13]) * vp9cospi.COSPI_16_64
    temp2 = (step1[10] + step1[13]) * vp9cospi.COSPI_16_64
    step2[10] = (vp9mem.rs(temp1))
    step2[13] = (vp9mem.rs(temp2))
    temp1 = (-step1[11] + step1[12]) * vp9cospi.COSPI_16_64
    temp2 = (step1[11] + step1[12]) * vp9cospi.COSPI_16_64
    step2[11] = (vp9mem.rs(temp1))
    step2[12] = (vp9mem.rs(temp2))
    step2[14] = step1[14]
    step2[15] = step1[15]
    vp9mem.sti(out, 0, (step2[0] + step2[15]))
    vp9mem.sti(out, 1, (step2[1] + step2[14]))
    vp9mem.sti(out, 2, (step2[2] + step2[13]))
    vp9mem.sti(out, 3, (step2[3] + step2[12]))
    vp9mem.sti(out, 4, (step2[4] + step2[11]))
    vp9mem.sti(out, 5, (step2[5] + step2[10]))
    vp9mem.sti(out, 6, (step2[6] + step2[9]))
    vp9mem.sti(out, 7, (step2[7] + step2[8]))
    vp9mem.sti(out, 8, (step2[7] - step2[8]))
    vp9mem.sti(out, 9, (step2[6] - step2[9]))
    vp9mem.sti(out, 10, (step2[5] - step2[10]))
    vp9mem.sti(out, 11, (step2[4] - step2[11]))
    vp9mem.sti(out, 12, (step2[3] - step2[12]))
    vp9mem.sti(out, 13, (step2[2] - step2[13]))
    vp9mem.sti(out, 14, (step2[1] - step2[14]))
    vp9mem.sti(out, 15, (step2[0] - step2[15]))
}

fn iadst16(inp: u64, out: u64) {
    var s0: i64 = 0
    var s1: i64 = 0
    var s2: i64 = 0
    var s3: i64 = 0
    var s4: i64 = 0
    var s5: i64 = 0
    var s6: i64 = 0
    var s7: i64 = 0
    var s8: i64 = 0
    var s9: i64 = 0
    var s10: i64 = 0
    var s11: i64 = 0
    var s12: i64 = 0
    var s13: i64 = 0
    var s14: i64 = 0
    var s15: i64 = 0
    var x0: i64 = vp9mem.ldi(inp, 15)
    var x1: i64 = vp9mem.ldi(inp, 0)
    var x2: i64 = vp9mem.ldi(inp, 13)
    var x3: i64 = vp9mem.ldi(inp, 2)
    var x4: i64 = vp9mem.ldi(inp, 11)
    var x5: i64 = vp9mem.ldi(inp, 4)
    var x6: i64 = vp9mem.ldi(inp, 9)
    var x7: i64 = vp9mem.ldi(inp, 6)
    var x8: i64 = vp9mem.ldi(inp, 7)
    var x9: i64 = vp9mem.ldi(inp, 8)
    var x10: i64 = vp9mem.ldi(inp, 5)
    var x11: i64 = vp9mem.ldi(inp, 10)
    var x12: i64 = vp9mem.ldi(inp, 3)
    var x13: i64 = vp9mem.ldi(inp, 12)
    var x14: i64 = vp9mem.ldi(inp, 1)
    var x15: i64 = vp9mem.ldi(inp, 14)
    s0 = x0 * vp9cospi.COSPI_1_64 + x1 * vp9cospi.COSPI_31_64
    s1 = x0 * vp9cospi.COSPI_31_64 - x1 * vp9cospi.COSPI_1_64
    s2 = x2 * vp9cospi.COSPI_5_64 + x3 * vp9cospi.COSPI_27_64
    s3 = x2 * vp9cospi.COSPI_27_64 - x3 * vp9cospi.COSPI_5_64
    s4 = x4 * vp9cospi.COSPI_9_64 + x5 * vp9cospi.COSPI_23_64
    s5 = x4 * vp9cospi.COSPI_23_64 - x5 * vp9cospi.COSPI_9_64
    s6 = x6 * vp9cospi.COSPI_13_64 + x7 * vp9cospi.COSPI_19_64
    s7 = x6 * vp9cospi.COSPI_19_64 - x7 * vp9cospi.COSPI_13_64
    s8 = x8 * vp9cospi.COSPI_17_64 + x9 * vp9cospi.COSPI_15_64
    s9 = x8 * vp9cospi.COSPI_15_64 - x9 * vp9cospi.COSPI_17_64
    s10 = x10 * vp9cospi.COSPI_21_64 + x11 * vp9cospi.COSPI_11_64
    s11 = x10 * vp9cospi.COSPI_11_64 - x11 * vp9cospi.COSPI_21_64
    s12 = x12 * vp9cospi.COSPI_25_64 + x13 * vp9cospi.COSPI_7_64
    s13 = x12 * vp9cospi.COSPI_7_64 - x13 * vp9cospi.COSPI_25_64
    s14 = x14 * vp9cospi.COSPI_29_64 + x15 * vp9cospi.COSPI_3_64
    s15 = x14 * vp9cospi.COSPI_3_64 - x15 * vp9cospi.COSPI_29_64
    x0 = (vp9mem.rs(s0 + s8))
    x1 = (vp9mem.rs(s1 + s9))
    x2 = (vp9mem.rs(s2 + s10))
    x3 = (vp9mem.rs(s3 + s11))
    x4 = (vp9mem.rs(s4 + s12))
    x5 = (vp9mem.rs(s5 + s13))
    x6 = (vp9mem.rs(s6 + s14))
    x7 = (vp9mem.rs(s7 + s15))
    x8 = (vp9mem.rs(s0 - s8))
    x9 = (vp9mem.rs(s1 - s9))
    x10 = (vp9mem.rs(s2 - s10))
    x11 = (vp9mem.rs(s3 - s11))
    x12 = (vp9mem.rs(s4 - s12))
    x13 = (vp9mem.rs(s5 - s13))
    x14 = (vp9mem.rs(s6 - s14))
    x15 = (vp9mem.rs(s7 - s15))
    s0 = x0
    s1 = x1
    s2 = x2
    s3 = x3
    s4 = x4
    s5 = x5
    s6 = x6
    s7 = x7
    s8 = x8 * vp9cospi.COSPI_4_64 + x9 * vp9cospi.COSPI_28_64
    s9 = x8 * vp9cospi.COSPI_28_64 - x9 * vp9cospi.COSPI_4_64
    s10 = x10 * vp9cospi.COSPI_20_64 + x11 * vp9cospi.COSPI_12_64
    s11 = x10 * vp9cospi.COSPI_12_64 - x11 * vp9cospi.COSPI_20_64
    s12 = -x12 * vp9cospi.COSPI_28_64 + x13 * vp9cospi.COSPI_4_64
    s13 = x12 * vp9cospi.COSPI_4_64 + x13 * vp9cospi.COSPI_28_64
    s14 = -x14 * vp9cospi.COSPI_12_64 + x15 * vp9cospi.COSPI_20_64
    s15 = x14 * vp9cospi.COSPI_20_64 + x15 * vp9cospi.COSPI_12_64
    x0 = (s0 + s4)
    x1 = (s1 + s5)
    x2 = (s2 + s6)
    x3 = (s3 + s7)
    x4 = (s0 - s4)
    x5 = (s1 - s5)
    x6 = (s2 - s6)
    x7 = (s3 - s7)
    x8 = (vp9mem.rs(s8 + s12))
    x9 = (vp9mem.rs(s9 + s13))
    x10 = (vp9mem.rs(s10 + s14))
    x11 = (vp9mem.rs(s11 + s15))
    x12 = (vp9mem.rs(s8 - s12))
    x13 = (vp9mem.rs(s9 - s13))
    x14 = (vp9mem.rs(s10 - s14))
    x15 = (vp9mem.rs(s11 - s15))
    s0 = x0
    s1 = x1
    s2 = x2
    s3 = x3
    s4 = x4 * vp9cospi.COSPI_8_64 + x5 * vp9cospi.COSPI_24_64
    s5 = x4 * vp9cospi.COSPI_24_64 - x5 * vp9cospi.COSPI_8_64
    s6 = -x6 * vp9cospi.COSPI_24_64 + x7 * vp9cospi.COSPI_8_64
    s7 = x6 * vp9cospi.COSPI_8_64 + x7 * vp9cospi.COSPI_24_64
    s8 = x8
    s9 = x9
    s10 = x10
    s11 = x11
    s12 = x12 * vp9cospi.COSPI_8_64 + x13 * vp9cospi.COSPI_24_64
    s13 = x12 * vp9cospi.COSPI_24_64 - x13 * vp9cospi.COSPI_8_64
    s14 = -x14 * vp9cospi.COSPI_24_64 + x15 * vp9cospi.COSPI_8_64
    s15 = x14 * vp9cospi.COSPI_8_64 + x15 * vp9cospi.COSPI_24_64
    x0 = (s0 + s2)
    x1 = (s1 + s3)
    x2 = (s0 - s2)
    x3 = (s1 - s3)
    x4 = (vp9mem.rs(s4 + s6))
    x5 = (vp9mem.rs(s5 + s7))
    x6 = (vp9mem.rs(s4 - s6))
    x7 = (vp9mem.rs(s5 - s7))
    x8 = (s8 + s10)
    x9 = (s9 + s11)
    x10 = (s8 - s10)
    x11 = (s9 - s11)
    x12 = (vp9mem.rs(s12 + s14))
    x13 = (vp9mem.rs(s13 + s15))
    x14 = (vp9mem.rs(s12 - s14))
    x15 = (vp9mem.rs(s13 - s15))
    s2 = (-vp9cospi.COSPI_16_64) * (x2 + x3)
    s3 = vp9cospi.COSPI_16_64 * (x2 - x3)
    s6 = vp9cospi.COSPI_16_64 * (x6 + x7)
    s7 = vp9cospi.COSPI_16_64 * (-x6 + x7)
    s10 = vp9cospi.COSPI_16_64 * (x10 + x11)
    s11 = vp9cospi.COSPI_16_64 * (-x10 + x11)
    s14 = (-vp9cospi.COSPI_16_64) * (x14 + x15)
    s15 = vp9cospi.COSPI_16_64 * (x14 - x15)
    x2 = (vp9mem.rs(s2))
    x3 = (vp9mem.rs(s3))
    x6 = (vp9mem.rs(s6))
    x7 = (vp9mem.rs(s7))
    x10 = (vp9mem.rs(s10))
    x11 = (vp9mem.rs(s11))
    x14 = (vp9mem.rs(s14))
    x15 = (vp9mem.rs(s15))
    vp9mem.sti(out, 0, (x0))
    vp9mem.sti(out, 1, (-x8))
    vp9mem.sti(out, 2, (x12))
    vp9mem.sti(out, 3, (-x4))
    vp9mem.sti(out, 4, (x6))
    vp9mem.sti(out, 5, (x14))
    vp9mem.sti(out, 6, (x10))
    vp9mem.sti(out, 7, (x2))
    vp9mem.sti(out, 8, (x3))
    vp9mem.sti(out, 9, (x11))
    vp9mem.sti(out, 10, (x15))
    vp9mem.sti(out, 11, (x7))
    vp9mem.sti(out, 12, (x5))
    vp9mem.sti(out, 13, (-x13))
    vp9mem.sti(out, 14, (x9))
    vp9mem.sti(out, 15, (-x1))
}
