import media.video.vp8.vp8bool
import media.video.vp9.vp9mem
import media.video.vp9.vp9defp
import media.video.vp9.vp9cnt

export {
    Vp9, Buf9, vp9_new, vp9_release, buf_alloc, buf_release, vp9_setup, mi_ptr, MI_SIZE, MI_BSIZE, MI_TX, MI_SKIP,
    MI_SEG, MI_MODE, MI_REF0, MI_REF1, MI_FILTER, MI_UV, MI_YMODE, MI_MV, PROB_LEN, COUNT_LEN, FRAME_POOL,
}

const MI_SIZE: usize = 64
const MI_BSIZE: usize = 0
const MI_TX: usize = 1
const MI_SKIP: usize = 2
const MI_SEG: usize = 3
const MI_REF0: usize = 4
const MI_REF1: usize = 5
const MI_FILTER: usize = 6
const MI_UV: usize = 7
const MI_YMODE: usize = 8
const MI_MODE: usize = 12
const MI_MV: usize = 16
const PROB_LEN: usize = 2048
const COUNT_LEN: usize = 3400 * 4
const FRAME_POOL: usize = 10

struct Buf9 {
    y: u64,
    u: u64,
    v: u64,
    ys: i64,
    uvs: i64,
    w: i64,
    h: i64,
    ay: i64,
    ah: i64,
    cap_y: usize,
    cap_uv: usize,
}

struct Vp9 {
    ready: bool,
    w: i64,
    h: i64,
    mi_cols: i64,
    mi_rows: i64,
    sb_cols: i64,
    sb_rows: i64,
    last_w: i64,
    last_h: i64,
    key: bool,
    intra_only: bool,
    show: bool,
    error_res: bool,
    reset_ctx: i64,
    refresh_flags: i64,
    ref_idx: [i64; 3],
    sign_bias: [i64; 4],
    allow_hp: bool,
    interp: i64,
    refresh_ctx: bool,
    parallel: bool,
    ctx_idx: i64,
    lf_level: i64,
    lf_sharp: i64,
    lf_delta_en: bool,
    ref_delta: [i64; 4],
    mode_delta: [i64; 2],
    base_q: i64,
    dq_ydc: i64,
    dq_uvdc: i64,
    dq_uvac: i64,
    lossless: bool,
    seg_on: bool,
    seg_map: bool,
    seg_temporal: bool,
    seg_abs: bool,
    seg_tree: [i64; 7],
    seg_pred: [i64; 3],
    seg_en: [i64; 32],
    seg_data: [i64; 32],
    tile_cols_log2: i64,
    tile_rows_log2: i64,
    hdr_size: i64,
    tx_mode: i64,
    ref_mode: i64,
    comp_fixed: i64,
    comp_var0: i64,
    comp_var1: i64,
    show_existing: i64,
    fc: u64,
    saved: u64,
    counts: u64,
    pool: [Buf9; 10],
    slot: [i64; 8],
    cur: i64,
    mi: u64,
    prev_mi: u64,
    mi_bytes: usize,
    seg_cur: u64,
    seg_last: u64,
    seg_bytes: usize,
    above_part: u64,
    left_part: u64,
    above_nz: u64,
    left_nz: u64,
    above_seg: u64,
    left_seg: u64,
    above_bytes: usize,
    coefs: u64,
    scratch: u64,
    edge: u64,
    tok_cache: u64,
    dq: [i64; 32],
    last_show: bool,
    last_intra_only: bool,
    d0: vp8bool.BD,
    td: vp8bool.BD,
    out_buf: i64,
    tile_c0: i64,
    tile_c1: i64,
    last_key: bool,
}

fn buf_empty() -> Buf9 {
    return Buf9 { y: 0, u: 0, v: 0, ys: 0, uvs: 0, w: 0, h: 0, ay: 0, ah: 0, cap_y: 0, cap_uv: 0 }
}

fn vp9_new() -> Vp9 {
    return Vp9 {
        ready: false, w: 0, h: 0, mi_cols: 0, mi_rows: 0, sb_cols: 0, sb_rows: 0, last_w: 0, last_h: 0,
        key: false, intra_only: false, show: false, error_res: false, reset_ctx: 0, refresh_flags: 0,
        ref_idx: [0; 3], sign_bias: [0; 4], allow_hp: false, interp: 0, refresh_ctx: false, parallel: false,
        ctx_idx: 0, lf_level: 0, lf_sharp: 0, lf_delta_en: false, ref_delta: [1, 0, 0 - 1, 0 - 1], mode_delta: [0; 2],
        base_q: 0, dq_ydc: 0, dq_uvdc: 0, dq_uvac: 0, lossless: false, seg_on: false, seg_map: false,
        seg_temporal: false, seg_abs: false, seg_tree: [255; 7], seg_pred: [255; 3], seg_en: [0; 32], seg_data: [0; 32],
        tile_cols_log2: 0, tile_rows_log2: 0, hdr_size: 0, tx_mode: 0, ref_mode: 0, comp_fixed: 0, comp_var0: 0,
        comp_var1: 0, show_existing: 0 - 1, fc: 0, saved: 0, counts: 0,
        pool: [buf_empty(); 10], slot: [0 - 1; 8], cur: 0, mi: 0, prev_mi: 0, mi_bytes: 0, seg_cur: 0, seg_last: 0,
        seg_bytes: 0, above_part: 0, left_part: 0, above_nz: 0, left_nz: 0, above_seg: 0, left_seg: 0, above_bytes: 0,
        coefs: 0, scratch: 0, edge: 0, tok_cache: 0, dq: [0; 32], last_show: false, last_intra_only: false,
        d0: vp8bool.bd_new(), td: vp8bool.bd_new(), out_buf: 0 - 1, tile_c0: 0, tile_c1: 0, last_key: false,
    }
}

fn buf_release(b: *mut Buf9) {
    vp9mem.free((*b).y, (*b).cap_y)
    vp9mem.free((*b).u, (*b).cap_uv)
    vp9mem.free((*b).v, (*b).cap_uv)
    (*b).y = 0
    (*b).u = 0
    (*b).v = 0
    (*b).cap_y = 0
    (*b).cap_uv = 0
}

fn buf_alloc(b: *mut Buf9, w: i64, h: i64) -> bool {
    let aw: i64 = (w + 63) / 64 * 64
    let ah: i64 = (h + 63) / 64 * 64
    let ys: i64 = aw + 16
    let uvs: i64 = aw / 2 + 16
    let cy: usize = (ys * (ah + 2)) as usize
    let cuv: usize = (uvs * (ah / 2 + 2)) as usize
    if (*b).cap_y != cy || (*b).cap_uv != cuv {
        buf_release(b)
        (*b).y = vp9mem.alloc(cy)
        (*b).u = vp9mem.alloc(cuv)
        (*b).v = vp9mem.alloc(cuv)
        (*b).cap_y = cy
        (*b).cap_uv = cuv
        if (*b).y == 0 || (*b).u == 0 || (*b).v == 0 {
            buf_release(b)
            return false
        }
    }
    vp9mem.zero((*b).y, cy)
    vp9mem.zero((*b).u, cuv)
    vp9mem.zero((*b).v, cuv)
    (*b).ys = ys
    (*b).uvs = uvs
    (*b).w = w
    (*b).h = h
    (*b).ay = aw
    (*b).ah = ah
    return true
}

fn vp9_release(f: *mut Vp9) {
    var i: usize = 0
    while i < 10 {
        buf_release(&(*f).pool[i])
        i = i + 1
    }
    vp9mem.free((*f).fc, PROB_LEN)
    vp9mem.free((*f).saved, PROB_LEN * 4)
    vp9mem.free((*f).counts, COUNT_LEN)
    vp9mem.free((*f).mi, (*f).mi_bytes)
    vp9mem.free((*f).prev_mi, (*f).mi_bytes)
    vp9mem.free((*f).seg_cur, (*f).seg_bytes)
    vp9mem.free((*f).seg_last, (*f).seg_bytes)
    vp9mem.free((*f).above_part, (*f).above_bytes)
    vp9mem.free((*f).left_part, 16)
    vp9mem.free((*f).above_nz, (*f).above_bytes * 3)
    vp9mem.free((*f).left_nz, 48)
    vp9mem.free((*f).above_seg, (*f).above_bytes)
    vp9mem.free((*f).left_seg, 16)
    vp9mem.free((*f).coefs, 4096)
    vp9mem.free((*f).scratch, 8192)
    vp9mem.free((*f).edge, 512)
    vp9mem.free((*f).tok_cache, 1024)
    (*f).fc = 0
    (*f).saved = 0
    (*f).counts = 0
    (*f).mi = 0
    (*f).prev_mi = 0
    (*f).seg_cur = 0
    (*f).seg_last = 0
    (*f).above_part = 0
    (*f).left_part = 0
    (*f).above_nz = 0
    (*f).left_nz = 0
    (*f).above_seg = 0
    (*f).left_seg = 0
    (*f).coefs = 0
    (*f).scratch = 0
    (*f).edge = 0
    (*f).tok_cache = 0
    (*f).ready = false
}

fn vp9_setup(f: *mut Vp9, w: i64, h: i64) -> bool {
    if w <= 0 || h <= 0 || w * h > 16777216 {
        return false
    }
    vp9mem.free((*f).mi, (*f).mi_bytes)
    vp9mem.free((*f).prev_mi, (*f).mi_bytes)
    vp9mem.free((*f).seg_cur, (*f).seg_bytes)
    vp9mem.free((*f).seg_last, (*f).seg_bytes)
    vp9mem.free((*f).above_part, (*f).above_bytes)
    vp9mem.free((*f).above_nz, (*f).above_bytes * 3)
    vp9mem.free((*f).above_seg, (*f).above_bytes)
    (*f).w = w
    (*f).h = h
    (*f).mi_cols = (w + 7) / 8
    (*f).mi_rows = (h + 7) / 8
    (*f).sb_cols = ((*f).mi_cols + 7) / 8
    (*f).sb_rows = ((*f).mi_rows + 7) / 8
    let cells: i64 = ((*f).sb_cols * 8) * ((*f).sb_rows * 8)
    (*f).mi_bytes = (cells as usize) * MI_SIZE
    (*f).seg_bytes = cells as usize
    (*f).above_bytes = ((*f).sb_cols * 16 + 16) as usize
    (*f).mi = vp9mem.alloc((*f).mi_bytes)
    (*f).prev_mi = vp9mem.alloc((*f).mi_bytes)
    (*f).seg_cur = vp9mem.alloc((*f).seg_bytes)
    (*f).seg_last = vp9mem.alloc((*f).seg_bytes)
    (*f).above_part = vp9mem.alloc((*f).above_bytes)
    (*f).above_nz = vp9mem.alloc((*f).above_bytes * 3)
    (*f).above_seg = vp9mem.alloc((*f).above_bytes)
    if (*f).fc == 0 {
        (*f).fc = vp9mem.alloc(PROB_LEN)
        (*f).saved = vp9mem.alloc(PROB_LEN * 4)
        (*f).counts = vp9mem.alloc(COUNT_LEN)
        (*f).left_part = vp9mem.alloc(16)
        (*f).left_nz = vp9mem.alloc(48)
        (*f).left_seg = vp9mem.alloc(16)
        (*f).coefs = vp9mem.alloc(4096)
        (*f).scratch = vp9mem.alloc(8192)
        (*f).edge = vp9mem.alloc(512)
        (*f).tok_cache = vp9mem.alloc(1024)
    }
    if (*f).mi == 0 || (*f).prev_mi == 0 || (*f).seg_cur == 0 || (*f).seg_last == 0 || (*f).above_part == 0
    || (*f).above_nz == 0 || (*f).above_seg == 0 || (*f).fc == 0 || (*f).saved == 0 || (*f).counts == 0
    || (*f).left_part == 0 || (*f).left_nz == 0 || (*f).left_seg == 0 || (*f).coefs == 0 || (*f).scratch == 0
    || (*f).edge == 0 || (*f).tok_cache == 0 {
        vp9_release(f)
        return false
    }
    vp9mem.zero((*f).mi, (*f).mi_bytes)
    vp9mem.zero((*f).prev_mi, (*f).mi_bytes)
    vp9mem.zero((*f).seg_cur, (*f).seg_bytes)
    vp9mem.zero((*f).seg_last, (*f).seg_bytes)
    vp9mem.zero((*f).coefs, 4096)
    (*f).ready = true
    return true
}

fn mi_ptr(f: *mut Vp9, row: i64, col: i64) -> u64 {
    return (*f).mi + ((row * ((*f).sb_cols * 8) + col) as usize * MI_SIZE) as u64
}
