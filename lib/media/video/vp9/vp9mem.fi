import std.rt

export { alloc, copy, ld8o, clip255, free, iabs, imax, imin, ld16, ld32, ld8, ldi, ldi16, rs, st16, st32, st8, sti, sti16, zero }

#[no_gc]
fn ld8(p: u64, i: usize) -> i64 {
    return (*((p + i as u64) as *mut u8)) as i64
}

#[no_gc]
fn ld8o(p: u64, off: i64) -> i64 {
    let a: u64 = ((p as i64) + off) as u64
    return (*(a as *mut u8)) as i64
}

#[no_gc]
fn st8(p: u64, i: usize, v: i64) {
    *((p + i as u64) as *mut u8) = (v & 255) as u8
}

#[no_gc]
fn ld16(p: u64, i: usize) -> i64 {
    return (*((p + (i * 2) as u64) as *mut u16)) as i64
}

#[no_gc]
fn st16(p: u64, i: usize, v: i64) {
    *((p + (i * 2) as u64) as *mut u16) = (v & 65535) as u16
}

#[no_gc]
fn ldi16(p: u64, i: usize) -> i64 {
    return (*((p + (i * 2) as u64) as *mut i16)) as i64
}

#[no_gc]
fn sti16(p: u64, i: usize, v: i64) {
    *((p + (i * 2) as u64) as *mut i16) = v as i16
}

#[no_gc]
fn ld32(p: u64, i: usize) -> i64 {
    return (*((p + (i * 4) as u64) as *mut u32)) as i64
}

#[no_gc]
fn st32(p: u64, i: usize, v: i64) {
    *((p + (i * 4) as u64) as *mut u32) = (v & 4294967295) as u32
}

#[no_gc]
fn ldi(p: u64, i: usize) -> i64 {
    return (*((p + (i * 4) as u64) as *mut i32)) as i64
}

#[no_gc]
fn sti(p: u64, i: usize, v: i64) {
    *((p + (i * 4) as u64) as *mut i32) = v as i32
}

fn alloc(n: usize) -> u64 {
    return rt.heap_alloc(n) as u64
}

fn free(p: u64, n: usize) {
    if p != 0 {
        rt.heap_free(p, n)
    }
}

fn zero(p: u64, n: usize) {
    var i: usize = 0
    while i + 8 <= n {
        *((p + i as u64) as *mut u64) = 0
        i = i + 8
    }
    while i < n {
        *((p + i as u64) as *mut u8) = 0 as u8
        i = i + 1
    }
}

fn clip255(v: i64) -> i64 {
    if v < 0 {
        return 0
    }
    if v > 255 {
        return 255
    }
    return v
}

fn iabs(v: i64) -> i64 {
    if v < 0 {
        return 0 - v
    }
    return v
}

fn imin(a: i64, b: i64) -> i64 {
    if a < b {
        return a
    }
    return b
}

fn imax(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    }
    return b
}

fn rs(x: i64) -> i64 {
    return (x + 8192) >> 14
}

fn copy(dst: u64, src: u64, n: usize) {
    var i: usize = 0
    while i + 8 <= n {
        *((dst + i as u64) as *mut u64) = *((src + i as u64) as *mut u64)
        i = i + 8
    }
    while i < n {
        *((dst + i as u64) as *mut u8) = *((src + i as u64) as *mut u8)
        i = i + 1
    }
}
