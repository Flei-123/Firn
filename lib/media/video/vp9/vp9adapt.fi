import media.video.vp9.vp9mem
import media.video.vp9.vp9state
import media.video.vp9.vp9defp
import media.video.vp9.vp9cnt

export { merge_prob, adapt_coef }

fn merge_prob(pre: i64, c0: i64, c1: i64, sat: i64, upd: i64) -> i64 {
    let den: i64 = c0 + c1
    var prob: i64 = 128
    if den != 0 {
        prob = (c0 * 256 + den / 2) / den
        if prob > 255 {
            prob = 255
        }
        if prob < 1 {
            prob = 1
        }
    }
    let count: i64 = vp9mem.imin(den, sat)
    let factor: i64 = upd * count / sat
    return (pre * (256 - factor) + prob * factor + 128) / 256
}

fn adapt_coef(f: *mut vp9state.Vp9) {
    var upd: i64 = 112
    if !(*f).key && !(*f).intra_only && (*f).last_key {
        upd = 128
    }
    let sat: i64 = 24
    let pre: u64 = (*f).saved + ((*f).ctx_idx as usize * vp9state.PROB_LEN) as u64
    let fc: u64 = (*f).fc
    let cnt: u64 = (*f).counts
    var grp: usize = 0
    while grp < 16 {
        var band: usize = 0
        while band < 6 {
            var nctx: usize = 6
            if band == 0 {
                nctx = 3
            }
            var ctx: usize = 0
            while ctx < nctx {
                let cell: usize = grp * 36 + band * 6 + ctx
                let cb: usize = vp9cnt.N_COEF + cell * 4
                let n0: i64 = vp9mem.ld32(cnt, cb)
                let n1: i64 = vp9mem.ld32(cnt, cb + 1)
                let n2: i64 = vp9mem.ld32(cnt, cb + 2)
                let neob: i64 = vp9mem.ld32(cnt, cb + 3)
                let eobb: i64 = vp9mem.ld32(cnt, vp9cnt.N_EOBB + cell)
                let pi: usize = vp9defp.P_COEF + cell * 3
                vp9mem.st8(fc, pi, merge_prob(vp9mem.ld8(pre, pi), neob, eobb - neob, sat, upd))
                vp9mem.st8(fc, pi + 1, merge_prob(vp9mem.ld8(pre, pi + 1), n0, n1 + n2, sat, upd))
                vp9mem.st8(fc, pi + 2, merge_prob(vp9mem.ld8(pre, pi + 2), n1, n2, sat, upd))
                ctx = ctx + 1
            }
            band = band + 1
        }
        grp = grp + 1
    }
}
