import media.video.vp8.vp8bool
import media.video.vp9.vp9mem
import media.video.vp9.vp9state
import media.video.vp9.vp9defp
import media.video.vp9.vp9cnt
import media.video.vp9.vp9entp
import media.video.vp9.vp9scan

export { scan_addr, nb_addr, tok_block }

static CAT1: [u8; 1] = [159]
static CAT2: [u8; 2] = [165, 145]
static CAT3: [u8; 3] = [173, 148, 140]
static CAT4: [u8; 4] = [176, 155, 140, 135]
static CAT5: [u8; 5] = [180, 157, 141, 134, 130]

fn scan_addr(tx: i64, tt: i64) -> u64 {
    if tx == 0 {
        if tt == 1 {
            return vp9scan.scan_row_4x4_addr()
        }
        if tt == 2 {
            return vp9scan.scan_col_4x4_addr()
        }
        return vp9scan.scan_default_4x4_addr()
    }
    if tx == 1 {
        if tt == 1 {
            return vp9scan.scan_row_8x8_addr()
        }
        if tt == 2 {
            return vp9scan.scan_col_8x8_addr()
        }
        return vp9scan.scan_default_8x8_addr()
    }
    if tx == 2 {
        if tt == 1 {
            return vp9scan.scan_row_16x16_addr()
        }
        if tt == 2 {
            return vp9scan.scan_col_16x16_addr()
        }
        return vp9scan.scan_default_16x16_addr()
    }
    return vp9scan.scan_default_32x32_addr()
}

fn nb_addr(tx: i64, tt: i64) -> u64 {
    if tx == 0 {
        if tt == 1 {
            return vp9scan.nb_row_4x4_addr()
        }
        if tt == 2 {
            return vp9scan.nb_col_4x4_addr()
        }
        return vp9scan.nb_default_4x4_addr()
    }
    if tx == 1 {
        if tt == 1 {
            return vp9scan.nb_row_8x8_addr()
        }
        if tt == 2 {
            return vp9scan.nb_col_8x8_addr()
        }
        return vp9scan.nb_default_8x8_addr()
    }
    if tx == 2 {
        if tt == 1 {
            return vp9scan.nb_row_16x16_addr()
        }
        if tt == 2 {
            return vp9scan.nb_col_16x16_addr()
        }
        return vp9scan.nb_default_16x16_addr()
    }
    return vp9scan.nb_default_32x32_addr()
}

fn cnt_inc(f: *mut vp9state.Vp9, idx: usize) {
    vp9mem.st32((*f).counts, idx, vp9mem.ld32((*f).counts, idx) + 1)
}

fn read_extra(d: *mut vp8bool.BD, probs: u64, n: i64) -> i64 {
    var v: i64 = 0
    var i: i64 = 0
    while i < n {
        v = (v << 1) | vp8bool.bd_get(d, vp9mem.ld8(probs, i as usize))
        i = i + 1
    }
    return v
}

fn tok_block(f: *mut vp9state.Vp9, plane: usize, is_inter: usize, tx: i64, tt: i64, ctx_in: i64, dq0: i64, dq1: i64, count: bool) -> i64 {
    let d: *mut vp8bool.BD = &(*f).td
    let scan: u64 = scan_addr(tx, tt)
    let nb: u64 = nb_addr(tx, tt)
    let max_eob: i64 = 16 << ((tx << 1) as u64)
    let ptype: usize = if plane > 0 { 1 } else { 0 }
    let pbase: usize = vp9defp.P_COEF + (((tx as usize) * 4 + ptype * 2 + is_inter) * 36) * 3
    let cbase: usize = vp9cnt.N_COEF + (((tx as usize) * 4 + ptype * 2 + is_inter) * 36) * 4
    let ebase: usize = vp9cnt.N_EOBB + ((tx as usize) * 4 + ptype * 2 + is_inter) * 36
    let fc: u64 = (*f).fc
    let cache: u64 = (*f).tok_cache
    let coefs: u64 = (*f).coefs
    var bands: u64 = vp9entp.band8_addr()
    if tx == 0 {
        bands = vp9entp.band4_addr()
    }
    let shift: i64 = if tx == 3 { 1 } else { 0 }
    var dqv: i64 = dq0
    var ctx: i64 = ctx_in
    var c: i64 = 0
    while c < max_eob {
        var band: i64 = vp9mem.ld8(bands, c as usize)
        var pi: usize = pbase + ((band as usize) * 6 + ctx as usize) * 3
        if count {
            cnt_inc(f, ebase + (band as usize) * 6 + ctx as usize)
        }
        if vp8bool.bd_get(d, vp9mem.ld8(fc, pi)) == 0 {
            if count {
                cnt_inc(f, cbase + ((band as usize) * 6 + ctx as usize) * 4 + 3)
            }
            break
        }
        var hit_end: bool = false
        while vp8bool.bd_get(d, vp9mem.ld8(fc, pi + 1)) == 0 {
            if count {
                cnt_inc(f, cbase + ((band as usize) * 6 + ctx as usize) * 4)
            }
            dqv = dq1
            vp9mem.st8(cache, vp9mem.ld16(scan, c as usize) as usize, 0)
            c = c + 1
            if c >= max_eob {
                hit_end = true
                break
            }
            ctx = (1 + vp9mem.ld8(cache, vp9mem.ld16(nb, (2 * c) as usize) as usize) + vp9mem.ld8(cache, vp9mem.ld16(nb, (2 * c + 1) as usize) as usize)) >> 1
            band = vp9mem.ld8(bands, c as usize)
            pi = pbase + ((band as usize) * 6 + ctx as usize) * 3
        }
        if hit_end {
            return c
        }
        let pos: usize = vp9mem.ld16(scan, c as usize) as usize
        var v: i64 = 0
        if vp8bool.bd_get(d, vp9mem.ld8(fc, pi + 2)) == 1 {
            let par: u64 = vp9entp.pareto_addr() + ((vp9mem.ld8(fc, pi + 2) - 1) * 8) as u64
            if count {
                cnt_inc(f, cbase + ((band as usize) * 6 + ctx as usize) * 4 + 2)
            }
            var val: i64 = 0
            if vp8bool.bd_get(d, vp9mem.ld8(par, 0)) == 1 {
                if vp8bool.bd_get(d, vp9mem.ld8(par, 3)) == 1 {
                    vp9mem.st8(cache, pos, 5)
                    if vp8bool.bd_get(d, vp9mem.ld8(par, 5)) == 1 {
                        if vp8bool.bd_get(d, vp9mem.ld8(par, 7)) == 1 {
                            val = 67 + read_extra(d, vp9entp.cat6_addr(), 14)
                        } else {
                            val = 35 + read_extra(d, (&CAT5[0]) as u64, 5)
                        }
                    } else if vp8bool.bd_get(d, vp9mem.ld8(par, 6)) == 1 {
                        val = 19 + read_extra(d, (&CAT4[0]) as u64, 4)
                    } else {
                        val = 11 + read_extra(d, (&CAT3[0]) as u64, 3)
                    }
                } else {
                    vp9mem.st8(cache, pos, 4)
                    if vp8bool.bd_get(d, vp9mem.ld8(par, 4)) == 1 {
                        val = 7 + read_extra(d, (&CAT2[0]) as u64, 2)
                    } else {
                        val = 5 + read_extra(d, (&CAT1[0]) as u64, 1)
                    }
                }
                v = (val * dqv) >> (shift as u64)
            } else {
                if vp8bool.bd_get(d, vp9mem.ld8(par, 1)) == 1 {
                    vp9mem.st8(cache, pos, 3)
                    v = ((3 + vp8bool.bd_get(d, vp9mem.ld8(par, 2))) * dqv) >> (shift as u64)
                } else {
                    vp9mem.st8(cache, pos, 2)
                    v = (2 * dqv) >> (shift as u64)
                }
            }
        } else {
            if count {
                cnt_inc(f, cbase + ((band as usize) * 6 + ctx as usize) * 4 + 1)
            }
            vp9mem.st8(cache, pos, 1)
            v = dqv >> (shift as u64)
        }
        if vp8bool.bd_get(d, 128) == 1 {
            v = 0 - v
        }
        vp9mem.sti(coefs, pos, v)
        c = c + 1
        ctx = (1 + vp9mem.ld8(cache, vp9mem.ld16(nb, (2 * c) as usize) as usize) + vp9mem.ld8(cache, vp9mem.ld16(nb, (2 * c + 1) as usize) as usize)) >> 1
        dqv = dq1
    }
    return c
}
