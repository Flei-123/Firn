import media.video.vp8.vp8bool
import media.video.vp9.vp9mem
import media.video.vp9.vp9state
import media.video.vp9.vp9defp
import media.video.vp9.vp9cnt
import media.video.vp9.vp9mvdef
import media.video.vp9.vp9mvmi
import media.video.vp9.vp9mode

export { read_mv, read_mv_component, mv_valid, read_inter_mode_tree, read_interp_tree }

fn comp_probs(f: *mut vp9state.Vp9, comp: i64) -> u64 {
    return (*f).fc + (vp9defp.P_MV_COMP0 + (comp as usize) * vp9mvdef.MVP_STRIDE) as u64
}

fn read_tree3(d: *mut vp8bool.BD, p: u64, base: usize) -> i64 {
    if vp8bool.bd_get(d, vp9mem.ld8(p, base)) == 0 {
        return 0
    }
    if vp8bool.bd_get(d, vp9mem.ld8(p, base + 1)) == 0 {
        return 1
    }
    return 2 + vp8bool.bd_get(d, vp9mem.ld8(p, base + 2))
}

fn read_mv_class(d: *mut vp8bool.BD, p: u64) -> i64 {
    let b: usize = vp9mvdef.MVP_CLASSES
    if vp8bool.bd_get(d, vp9mem.ld8(p, b)) == 0 {
        return 0
    }
    if vp8bool.bd_get(d, vp9mem.ld8(p, b + 1)) == 0 {
        return 1
    }
    if vp8bool.bd_get(d, vp9mem.ld8(p, b + 2)) == 0 {
        return 2 + vp8bool.bd_get(d, vp9mem.ld8(p, b + 3))
    }
    if vp8bool.bd_get(d, vp9mem.ld8(p, b + 4)) == 0 {
        return 4 + vp8bool.bd_get(d, vp9mem.ld8(p, b + 5))
    }
    if vp8bool.bd_get(d, vp9mem.ld8(p, b + 6)) == 0 {
        return 6
    }
    if vp8bool.bd_get(d, vp9mem.ld8(p, b + 7)) == 0 {
        return 7 + vp8bool.bd_get(d, vp9mem.ld8(p, b + 8))
    }
    return 9 + vp8bool.bd_get(d, vp9mem.ld8(p, b + 9))
}

fn read_mv_component(f: *mut vp9state.Vp9, comp: i64, usehp: bool) -> i64 {
    let d: *mut vp8bool.BD = &(*f).td
    let p: u64 = comp_probs(f, comp)
    let sign: i64 = vp8bool.bd_get(d, vp9mem.ld8(p, vp9mvdef.MVP_SIGN))
    let cls: i64 = read_mv_class(d, p)
    var dd: i64 = 0
    var mag: i64 = 0
    var fr: i64 = 0
    if cls == 0 {
        dd = vp8bool.bd_get(d, vp9mem.ld8(p, vp9mvdef.MVP_CLASS0))
        fr = read_tree3(d, p, vp9mvdef.MVP_CLASS0_FP + (dd * 3) as usize)
    } else {
        var i: i64 = 0
        while i < cls {
            dd = dd | (vp8bool.bd_get(d, vp9mem.ld8(p, vp9mvdef.MVP_BITS + i as usize)) << i)
            i = i + 1
        }
        mag = 2 << (cls + 2)
        fr = read_tree3(d, p, vp9mvdef.MVP_FP)
    }
    var hp: i64 = 1
    if usehp {
        if cls == 0 {
            hp = vp8bool.bd_get(d, vp9mem.ld8(p, vp9mvdef.MVP_CLASS0_HP))
        } else {
            hp = vp8bool.bd_get(d, vp9mem.ld8(p, vp9mvdef.MVP_HP))
        }
    }
    mag = mag + ((dd << 3) | (fr << 1) | hp) + 1
    if sign != 0 {
        return 0 - mag
    }
    return mag
}

fn mv_class_of(z: i64) -> i64 {
    if z >= 8192 {
        return 10
    }
    var v: i64 = z >> 3
    var c: i64 = 0
    while v > 1 {
        v = v >> 1
        c = c + 1
    }
    return c
}

fn count_component(f: *mut vp9state.Vp9, comp: i64, v: i64) {
    let base: usize = vp9cnt.N_MV_COMP + (comp as usize) * vp9mvdef.MVC_STRIDE
    var s: usize = 0
    if v < 0 {
        s = 1
    }
    let z: i64 = vp9mem.iabs(v) - 1
    let c: i64 = mv_class_of(z)
    var o: i64 = z
    if c > 0 {
        o = z - (2 << (c + 2))
    }
    let dd: i64 = o >> 3
    let fr: usize = ((o >> 1) & 3) as usize
    let e: usize = (o & 1) as usize
    vp9mode.cnt_add(f, base + vp9mvdef.MVC_SIGN + s)
    vp9mode.cnt_add(f, base + vp9mvdef.MVC_CLASSES + c as usize)
    if c == 0 {
        vp9mode.cnt_add(f, base + vp9mvdef.MVC_CLASS0 + dd as usize)
        vp9mode.cnt_add(f, base + vp9mvdef.MVC_CLASS0_FP + (dd as usize) * 4 + fr)
        vp9mode.cnt_add(f, base + vp9mvdef.MVC_CLASS0_HP + e)
    } else {
        var i: i64 = 0
        while i < c {
            vp9mode.cnt_add(f, base + vp9mvdef.MVC_BITS + (i as usize) * 2 + ((dd >> i) & 1) as usize)
            i = i + 1
        }
        vp9mode.cnt_add(f, base + vp9mvdef.MVC_FP + fr)
        vp9mode.cnt_add(f, base + vp9mvdef.MVC_HP + e)
    }
}

fn count_mv(f: *mut vp9state.Vp9, drow: i64, dcol: i64) {
    var joint: usize = 0
    if drow != 0 && dcol != 0 {
        joint = 3
    } else if drow != 0 {
        joint = 2
    } else if dcol != 0 {
        joint = 1
    }
    vp9mode.cnt_add(f, vp9cnt.N_MV_JOINT + joint)
    if drow != 0 {
        count_component(f, 0, drow)
    }
    if dcol != 0 {
        count_component(f, 1, dcol)
    }
}

fn mv_valid(row: i64, col: i64) -> bool {
    return row > 0 - 16384 && row < 16384 && col > 0 - 16384 && col < 16384
}

fn read_mv(f: *mut vp9state.Vp9, out: *mut vp9mvmi.Mv, ref_row: i64, ref_col: i64) -> bool {
    let d: *mut vp8bool.BD = &(*f).td
    let joint: i64 = read_tree3(d, (*f).fc, vp9defp.P_MV_JOINT)
    let usehp: bool = (*f).allow_hp && (vp9mem.iabs(ref_row) >> 3) < 8 && (vp9mem.iabs(ref_col) >> 3) < 8
    var drow: i64 = 0
    var dcol: i64 = 0
    if joint == 2 || joint == 3 {
        drow = read_mv_component(f, 0, usehp)
    }
    if joint == 1 || joint == 3 {
        dcol = read_mv_component(f, 1, usehp)
    }
    if !(*f).parallel {
        count_mv(f, drow, dcol)
    }
    (*out).row = ref_row + drow
    (*out).col = ref_col + dcol
    return mv_valid((*out).row, (*out).col)
}

fn read_inter_mode_tree(f: *mut vp9state.Vp9, ctx: i64) -> i64 {
    let d: *mut vp8bool.BD = &(*f).td
    let p: u64 = (*f).fc + (vp9defp.P_INTER_MODE + (ctx * 3) as usize) as u64
    var off: i64 = 2
    if vp8bool.bd_get(d, vp9mem.ld8(p, 0)) != 0 {
        if vp8bool.bd_get(d, vp9mem.ld8(p, 1)) == 0 {
            off = 0
        } else if vp8bool.bd_get(d, vp9mem.ld8(p, 2)) == 0 {
            off = 1
        } else {
            off = 3
        }
    }
    if !(*f).parallel {
        vp9mode.cnt_add(f, vp9cnt.N_INTER_MODE + (ctx * 4 + off) as usize)
    }
    return 10 + off
}

fn read_interp_tree(f: *mut vp9state.Vp9, ctx: i64) -> i64 {
    let d: *mut vp8bool.BD = &(*f).td
    let p: u64 = (*f).fc + (vp9defp.P_INTERP + (ctx * 2) as usize) as u64
    var t: i64 = 0
    if vp8bool.bd_get(d, vp9mem.ld8(p, 0)) != 0 {
        t = 1 + vp8bool.bd_get(d, vp9mem.ld8(p, 1))
    }
    if !(*f).parallel {
        vp9mode.cnt_add(f, vp9cnt.N_INTERP + (ctx * 3 + t) as usize)
    }
    return t
}
