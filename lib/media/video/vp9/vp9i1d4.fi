import media.video.vp9.vp9mem
import media.video.vp9.vp9cospi

export { idct4, iadst4 }

fn idct4(inp: u64, out: u64) {
    var step: [i64; 4] = [0; 4]
    var temp1: i64 = 0
    var temp2: i64 = 0
    temp1 = (vp9mem.ldi(inp, 0) + vp9mem.ldi(inp, 2)) * vp9cospi.COSPI_16_64
    temp2 = (vp9mem.ldi(inp, 0) - vp9mem.ldi(inp, 2)) * vp9cospi.COSPI_16_64
    step[0] = (vp9mem.rs(temp1))
    step[1] = (vp9mem.rs(temp2))
    temp1 = vp9mem.ldi(inp, 1) * vp9cospi.COSPI_24_64 - vp9mem.ldi(inp, 3) * vp9cospi.COSPI_8_64
    temp2 = vp9mem.ldi(inp, 1) * vp9cospi.COSPI_8_64 + vp9mem.ldi(inp, 3) * vp9cospi.COSPI_24_64
    step[2] = (vp9mem.rs(temp1))
    step[3] = (vp9mem.rs(temp2))
    vp9mem.sti(out, 0, (step[0] + step[3]))
    vp9mem.sti(out, 1, (step[1] + step[2]))
    vp9mem.sti(out, 2, (step[1] - step[2]))
    vp9mem.sti(out, 3, (step[0] - step[3]))
}

fn iadst4(inp: u64, out: u64) {
    var s0: i64 = 0
    var s1: i64 = 0
    var s2: i64 = 0
    var s3: i64 = 0
    var s4: i64 = 0
    var s5: i64 = 0
    var s6: i64 = 0
    var s7: i64 = 0
    var x0: i64 = vp9mem.ldi(inp, 0)
    var x1: i64 = vp9mem.ldi(inp, 1)
    var x2: i64 = vp9mem.ldi(inp, 2)
    var x3: i64 = vp9mem.ldi(inp, 3)
    s0 = vp9cospi.SINPI_1_9 * x0
    s1 = vp9cospi.SINPI_2_9 * x0
    s2 = vp9cospi.SINPI_3_9 * x1
    s3 = vp9cospi.SINPI_4_9 * x2
    s4 = vp9cospi.SINPI_1_9 * x2
    s5 = vp9cospi.SINPI_2_9 * x3
    s6 = vp9cospi.SINPI_4_9 * x3
    s7 = (x0 - x2 + x3)
    s0 = s0 + s3 + s5
    s1 = s1 - s4 - s6
    s3 = s2
    s2 = vp9cospi.SINPI_3_9 * s7
    vp9mem.sti(out, 0, (vp9mem.rs(s0 + s3)))
    vp9mem.sti(out, 1, (vp9mem.rs(s1 + s3)))
    vp9mem.sti(out, 2, (vp9mem.rs(s2)))
    vp9mem.sti(out, 3, (vp9mem.rs(s0 + s1 - s3)))
}
