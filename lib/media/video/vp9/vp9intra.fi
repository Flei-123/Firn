import media.video.vp9.vp9mem

export { intra_predict }

fn avg2(a: i64, b: i64) -> i64 {
    return (a + b + 1) >> 1
}

fn avg3(a: i64, b: i64, c: i64) -> i64 {
    return (a + 2 * b + c + 2) >> 2
}

fn put(dst: u64, stride: i64, x: i64, y: i64, v: i64) {
    vp9mem.st8(dst + (y * stride + x) as u64, 0, v)
}

fn get(dst: u64, stride: i64, x: i64, y: i64) -> i64 {
    return vp9mem.ld8(dst + (y * stride + x) as u64, 0)
}

fn fill(dst: u64, stride: i64, bs: i64, v: i64) {
    var y: i64 = 0
    while y < bs {
        var x: i64 = 0
        while x < bs {
            put(dst, stride, x, y, v)
            x = x + 1
        }
        y = y + 1
    }
}

fn pred_dc(dst: u64, stride: i64, bs: i64, above: u64, left: u64, have_left: bool, have_up: bool) {
    var sum: i64 = 0
    var i: i64 = 0
    if have_up {
        while i < bs {
            sum = sum + vp9mem.ld8o(above, i)
            i = i + 1
        }
    }
    i = 0
    if have_left {
        while i < bs {
            sum = sum + vp9mem.ld8o(left, i)
            i = i + 1
        }
    }
    var v: i64 = 128
    if have_left && have_up {
        v = (sum + bs) / (2 * bs)
    } else if have_left || have_up {
        v = (sum + (bs >> 1)) / bs
    }
    fill(dst, stride, bs, v)
}

fn pred_v(dst: u64, stride: i64, bs: i64, above: u64) {
    var y: i64 = 0
    while y < bs {
        var x: i64 = 0
        while x < bs {
            put(dst, stride, x, y, vp9mem.ld8o(above, x))
            x = x + 1
        }
        y = y + 1
    }
}

fn pred_h(dst: u64, stride: i64, bs: i64, left: u64) {
    var y: i64 = 0
    while y < bs {
        var x: i64 = 0
        while x < bs {
            put(dst, stride, x, y, vp9mem.ld8o(left, y))
            x = x + 1
        }
        y = y + 1
    }
}

fn pred_tm(dst: u64, stride: i64, bs: i64, above: u64, left: u64) {
    let tl: i64 = vp9mem.ld8o(above, 0 - 1)
    var y: i64 = 0
    while y < bs {
        var x: i64 = 0
        while x < bs {
            put(dst, stride, x, y, vp9mem.clip255(vp9mem.ld8o(left, y) + vp9mem.ld8o(above, x) - tl))
            x = x + 1
        }
        y = y + 1
    }
}

fn pred_d45(dst: u64, stride: i64, bs: i64, above: u64) {
    if bs == 4 {
        var y: i64 = 0
        while y < 4 {
            var x: i64 = 0
            while x < 4 {
                let k: i64 = x + y
                if k == 6 {
                    put(dst, stride, x, y, vp9mem.ld8o(above, 7))
                } else {
                    put(dst, stride, x, y, avg3(vp9mem.ld8o(above, k), vp9mem.ld8o(above, k + 1), vp9mem.ld8o(above, k + 2)))
                }
                x = x + 1
            }
            y = y + 1
        }
        return
    }
    let ar: i64 = vp9mem.ld8o(above, bs - 1)
    var x: i64 = 0
    while x < bs - 1 {
        put(dst, stride, x, 0, avg3(vp9mem.ld8o(above, x), vp9mem.ld8o(above, x + 1), vp9mem.ld8o(above, x + 2)))
        x = x + 1
    }
    put(dst, stride, bs - 1, 0, ar)
    var r: i64 = 1
    var size: i64 = bs - 2
    while r < bs {
        var c: i64 = 0
        while c < size {
            put(dst, stride, c, r, get(dst, stride, c + r, 0))
            c = c + 1
        }
        while c < bs {
            put(dst, stride, c, r, ar)
            c = c + 1
        }
        r = r + 1
        size = size - 1
    }
}

fn pred_d63(dst: u64, stride: i64, bs: i64, above: u64) {
    if bs == 4 {
        let a: i64 = vp9mem.ld8o(above, 0)
        let b: i64 = vp9mem.ld8o(above, 1)
        let c: i64 = vp9mem.ld8o(above, 2)
        let d: i64 = vp9mem.ld8o(above, 3)
        let e: i64 = vp9mem.ld8o(above, 4)
        let f: i64 = vp9mem.ld8o(above, 5)
        let g: i64 = vp9mem.ld8o(above, 6)
        put(dst, stride, 0, 0, avg2(a, b))
        put(dst, stride, 1, 0, avg2(b, c))
        put(dst, stride, 0, 2, avg2(b, c))
        put(dst, stride, 2, 0, avg2(c, d))
        put(dst, stride, 1, 2, avg2(c, d))
        put(dst, stride, 3, 0, avg2(d, e))
        put(dst, stride, 2, 2, avg2(d, e))
        put(dst, stride, 3, 2, avg2(e, f))
        put(dst, stride, 0, 1, avg3(a, b, c))
        put(dst, stride, 1, 1, avg3(b, c, d))
        put(dst, stride, 0, 3, avg3(b, c, d))
        put(dst, stride, 2, 1, avg3(c, d, e))
        put(dst, stride, 1, 3, avg3(c, d, e))
        put(dst, stride, 3, 1, avg3(d, e, f))
        put(dst, stride, 2, 3, avg3(d, e, f))
        put(dst, stride, 3, 3, avg3(e, f, g))
        return
    }
    var c: i64 = 0
    while c < bs {
        put(dst, stride, c, 0, avg2(vp9mem.ld8o(above, c), vp9mem.ld8o(above, c + 1)))
        put(dst, stride, c, 1, avg3(vp9mem.ld8o(above, c), vp9mem.ld8o(above, c + 1), vp9mem.ld8o(above, c + 2)))
        c = c + 1
    }
    var r: i64 = 2
    var size: i64 = bs - 2
    let last: i64 = vp9mem.ld8o(above, bs - 1)
    while r < bs {
        var k: i64 = 0
        while k < bs {
            if k < size {
                put(dst, stride, k, r, get(dst, stride, k + (r >> 1), 0))
                put(dst, stride, k, r + 1, get(dst, stride, k + (r >> 1), 1))
            } else {
                put(dst, stride, k, r, last)
                put(dst, stride, k, r + 1, last)
            }
            k = k + 1
        }
        r = r + 2
        size = size - 1
    }
}

fn pred_d117(dst: u64, stride: i64, bs: i64, above: u64, left: u64) {
    var c: i64 = 0
    while c < bs {
        put(dst, stride, c, 0, avg2(vp9mem.ld8o(above, c - 1), vp9mem.ld8o(above, c)))
        c = c + 1
    }
    put(dst, stride, 0, 1, avg3(vp9mem.ld8o(left, 0), vp9mem.ld8o(above, 0 - 1), vp9mem.ld8o(above, 0)))
    c = 1
    while c < bs {
        put(dst, stride, c, 1, avg3(vp9mem.ld8o(above, c - 2), vp9mem.ld8o(above, c - 1), vp9mem.ld8o(above, c)))
        c = c + 1
    }
    put(dst, stride, 0, 2, avg3(vp9mem.ld8o(above, 0 - 1), vp9mem.ld8o(left, 0), vp9mem.ld8o(left, 1)))
    var r: i64 = 3
    while r < bs {
        put(dst, stride, 0, r, avg3(vp9mem.ld8o(left, r - 3), vp9mem.ld8o(left, r - 2), vp9mem.ld8o(left, r - 1)))
        r = r + 1
    }
    r = 2
    while r < bs {
        c = 1
        while c < bs {
            put(dst, stride, c, r, get(dst, stride, c - 1, r - 2))
            c = c + 1
        }
        r = r + 1
    }
}

fn pred_d135(dst: u64, stride: i64, bs: i64, above: u64, left: u64, border: u64) {
    var i: i64 = 0
    while i < bs - 2 {
        vp9mem.st8(border, i as usize, avg3(vp9mem.ld8o(left, bs - 3 - i), vp9mem.ld8o(left, bs - 2 - i), vp9mem.ld8o(left, bs - 1 - i)))
        i = i + 1
    }
    vp9mem.st8(border, (bs - 2) as usize, avg3(vp9mem.ld8o(above, 0 - 1), vp9mem.ld8o(left, 0), vp9mem.ld8o(left, 1)))
    vp9mem.st8(border, (bs - 1) as usize, avg3(vp9mem.ld8o(left, 0), vp9mem.ld8o(above, 0 - 1), vp9mem.ld8o(above, 0)))
    vp9mem.st8(border, bs as usize, avg3(vp9mem.ld8o(above, 0 - 1), vp9mem.ld8o(above, 0), vp9mem.ld8o(above, 1)))
    i = 0
    while i < bs - 2 {
        vp9mem.st8(border, (bs + 1 + i) as usize, avg3(vp9mem.ld8o(above, i), vp9mem.ld8o(above, i + 1), vp9mem.ld8o(above, i + 2)))
        i = i + 1
    }
    i = 0
    while i < bs {
        var c: i64 = 0
        while c < bs {
            put(dst, stride, c, i, vp9mem.ld8(border, (bs - 1 - i + c) as usize))
            c = c + 1
        }
        i = i + 1
    }
}

fn pred_d153(dst: u64, stride: i64, bs: i64, above: u64, left: u64) {
    put(dst, stride, 0, 0, avg2(vp9mem.ld8o(above, 0 - 1), vp9mem.ld8o(left, 0)))
    var r: i64 = 1
    while r < bs {
        put(dst, stride, 0, r, avg2(vp9mem.ld8o(left, r - 1), vp9mem.ld8o(left, r)))
        r = r + 1
    }
    put(dst, stride, 1, 0, avg3(vp9mem.ld8o(left, 0), vp9mem.ld8o(above, 0 - 1), vp9mem.ld8o(above, 0)))
    put(dst, stride, 1, 1, avg3(vp9mem.ld8o(above, 0 - 1), vp9mem.ld8o(left, 0), vp9mem.ld8o(left, 1)))
    r = 2
    while r < bs {
        put(dst, stride, 1, r, avg3(vp9mem.ld8o(left, r - 2), vp9mem.ld8o(left, r - 1), vp9mem.ld8o(left, r)))
        r = r + 1
    }
    var c: i64 = 0
    while c < bs - 2 {
        put(dst, stride, 2 + c, 0, avg3(vp9mem.ld8o(above, c - 1), vp9mem.ld8o(above, c), vp9mem.ld8o(above, c + 1)))
        c = c + 1
    }
    r = 1
    while r < bs {
        c = 0
        while c < bs - 2 {
            put(dst, stride, 2 + c, r, get(dst, stride, c, r - 1))
            c = c + 1
        }
        r = r + 1
    }
}

fn pred_d207(dst: u64, stride: i64, bs: i64, left: u64) {
    var r: i64 = 0
    while r < bs - 1 {
        put(dst, stride, 0, r, avg2(vp9mem.ld8o(left, r), vp9mem.ld8o(left, r + 1)))
        r = r + 1
    }
    put(dst, stride, 0, bs - 1, vp9mem.ld8o(left, bs - 1))
    r = 0
    while r < bs - 2 {
        put(dst, stride, 1, r, avg3(vp9mem.ld8o(left, r), vp9mem.ld8o(left, r + 1), vp9mem.ld8o(left, r + 2)))
        r = r + 1
    }
    put(dst, stride, 1, bs - 2, avg3(vp9mem.ld8o(left, bs - 2), vp9mem.ld8o(left, bs - 1), vp9mem.ld8o(left, bs - 1)))
    put(dst, stride, 1, bs - 1, vp9mem.ld8o(left, bs - 1))
    var c: i64 = 0
    while c < bs - 2 {
        put(dst, stride, 2 + c, bs - 1, vp9mem.ld8o(left, bs - 1))
        c = c + 1
    }
    r = bs - 2
    while r >= 0 {
        c = 0
        while c < bs - 2 {
            put(dst, stride, 2 + c, r, get(dst, stride, c, r + 1))
            c = c + 1
        }
        r = r - 1
    }
}

fn intra_predict(dst: u64, stride: i64, mode: i64, bs: i64, above: u64, left: u64, have_left: bool, have_up: bool, border: u64) {
    if mode == 0 {
        pred_dc(dst, stride, bs, above, left, have_left, have_up)
    } else if mode == 1 {
        pred_v(dst, stride, bs, above)
    } else if mode == 2 {
        pred_h(dst, stride, bs, left)
    } else if mode == 3 {
        pred_d45(dst, stride, bs, above)
    } else if mode == 4 {
        pred_d135(dst, stride, bs, above, left, border)
    } else if mode == 5 {
        pred_d117(dst, stride, bs, above, left)
    } else if mode == 6 {
        pred_d153(dst, stride, bs, above, left)
    } else if mode == 7 {
        pred_d207(dst, stride, bs, left)
    } else if mode == 8 {
        pred_d63(dst, stride, bs, above)
    } else {
        pred_tm(dst, stride, bs, above, left)
    }
}
