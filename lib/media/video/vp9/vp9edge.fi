import media.video.vp9.vp9mem
import media.video.vp9.vp9state
import media.video.vp9.vp9intra

export { predict_intra }

fn predict_intra(f: *mut vp9state.Vp9, base: u64, stride: i64, mode: i64, tx: i64, x0: i64, y0: i64,
    have_left: bool, have_top: bool, have_right: bool, fw: i64, fh: i64) {
    let bs: i64 = 4 << (tx as u64)
    let edge: u64 = (*f).edge
    let left: u64 = edge
    let above: u64 = edge + 128
    let border: u64 = edge + 256
    let dst: u64 = ((base as i64) + y0 * stride + x0) as u64
    if have_left {
        var i: i64 = 0
        while i < bs {
            var y: i64 = y0 + i
            if y > fh - 1 {
                y = fh - 1
            }
            vp9mem.st8(left, i as usize, vp9mem.ld8o(base, y * stride + x0 - 1))
            i = i + 1
        }
    } else {
        var i: i64 = 0
        while i < bs {
            vp9mem.st8(left, i as usize, 129)
            i = i + 1
        }
    }
    if have_top {
        var n: i64 = vp9mem.imin(bs, fw - x0)
        if bs == 4 && have_right {
            n = vp9mem.imin(2 * bs, fw - x0)
        }
        let row: i64 = (y0 - 1) * stride + x0
        var i: i64 = 0
        while i < n {
            vp9mem.st8(above, i as usize, vp9mem.ld8o(base, row + i))
            i = i + 1
        }
        let last: i64 = vp9mem.ld8(above, (n - 1) as usize)
        while i < 2 * bs {
            vp9mem.st8(above, i as usize, last)
            i = i + 1
        }
        var corner: i64 = 129
        if have_left {
            corner = vp9mem.ld8o(base, row - 1)
        }
        vp9mem.st8(above - 1, 0, corner)
    } else {
        var i: i64 = 0
        while i < 2 * bs {
            vp9mem.st8(above, i as usize, 127)
            i = i + 1
        }
        vp9mem.st8(above - 1, 0, 127)
    }
    vp9intra.intra_predict(dst, stride, mode, bs, above, left, have_left, have_top, border)
}
