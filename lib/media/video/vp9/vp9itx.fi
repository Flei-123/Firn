import media.video.vp9.vp9mem
import media.video.vp9.vp9i1d4
import media.video.vp9.vp9i1d8
import media.video.vp9.vp9i1d16
import media.video.vp9.vp9i1d32

export { ITX_SCRATCH, itx_add, iwht_add }

const ITX_SCRATCH: usize = 4608

fn line_1d(tx_size: i64, adst: bool, inp: u64, out: u64) {
    if tx_size == 0 {
        if adst {
            vp9i1d4.iadst4(inp, out)
        } else {
            vp9i1d4.idct4(inp, out)
        }
        return
    }
    if tx_size == 1 {
        if adst {
            vp9i1d8.iadst8(inp, out)
        } else {
            vp9i1d8.idct8(inp, out)
        }
        return
    }
    if tx_size == 2 {
        if adst {
            vp9i1d16.iadst16(inp, out)
        } else {
            vp9i1d16.idct16(inp, out)
        }
        return
    }
    vp9i1d32.idct32(inp, out)
}

fn itx_add(coefs: u64, dest: u64, stride: i64, tx_size: i64, tx_type: i64, scr: u64) {
    let n: usize = (4 << (tx_size as u64)) as usize
    let rows_adst: bool = tx_type == 2 || tx_type == 3
    let cols_adst: bool = tx_type == 1 || tx_type == 3
    var shift: i64 = 6
    if tx_size == 0 {
        shift = 4
    }
    if tx_size == 1 {
        shift = 5
    }
    let tin: u64 = scr + 4096
    let tout: u64 = scr + 4352
    var i: usize = 0
    while i < n {
        line_1d(tx_size, rows_adst, coefs + (i * n * 4) as u64, scr + (i * n * 4) as u64)
        i = i + 1
    }
    let rnd: i64 = 1 << ((shift - 1) as u64)
    i = 0
    while i < n {
        var j: usize = 0
        while j < n {
            vp9mem.sti(tin, j, vp9mem.ldi(scr, j * n + i))
            j = j + 1
        }
        line_1d(tx_size, cols_adst, tin, tout)
        j = 0
        while j < n {
            let a: u64 = dest + ((j as i64) * stride) as u64 + i as u64
            let v: i64 = vp9mem.ld8(a, 0) + ((vp9mem.ldi(tout, j) + rnd) >> (shift as u64))
            vp9mem.st8(a, 0, vp9mem.clip255(v))
            j = j + 1
        }
        i = i + 1
    }
}

fn iwht_add(coefs: u64, dest: u64, stride: i64, scr: u64) {
    var i: usize = 0
    while i < 4 {
        var a1: i64 = vp9mem.ldi(coefs, i * 4) >> 2
        var c1: i64 = vp9mem.ldi(coefs, i * 4 + 1) >> 2
        var d1: i64 = vp9mem.ldi(coefs, i * 4 + 2) >> 2
        var b1: i64 = vp9mem.ldi(coefs, i * 4 + 3) >> 2
        a1 = a1 + c1
        d1 = d1 - b1
        let e1: i64 = (a1 - d1) >> 1
        b1 = e1 - b1
        c1 = e1 - c1
        a1 = a1 - b1
        d1 = d1 + c1
        vp9mem.sti(scr, i * 4, a1)
        vp9mem.sti(scr, i * 4 + 1, b1)
        vp9mem.sti(scr, i * 4 + 2, c1)
        vp9mem.sti(scr, i * 4 + 3, d1)
        i = i + 1
    }
    i = 0
    while i < 4 {
        var a1: i64 = vp9mem.ldi(scr, i)
        var c1: i64 = vp9mem.ldi(scr, 4 + i)
        var d1: i64 = vp9mem.ldi(scr, 8 + i)
        var b1: i64 = vp9mem.ldi(scr, 12 + i)
        a1 = a1 + c1
        d1 = d1 - b1
        let e1: i64 = (a1 - d1) >> 1
        b1 = e1 - b1
        c1 = e1 - c1
        a1 = a1 - b1
        d1 = d1 + c1
        let p: u64 = dest + i as u64
        vp9mem.st8(p, 0, vp9mem.clip255(vp9mem.ld8(p, 0) + a1))
        vp9mem.st8(p, stride as usize, vp9mem.clip255(vp9mem.ld8(p, stride as usize) + b1))
        vp9mem.st8(p, (stride * 2) as usize, vp9mem.clip255(vp9mem.ld8(p, (stride * 2) as usize) + c1))
        vp9mem.st8(p, (stride * 3) as usize, vp9mem.clip255(vp9mem.ld8(p, (stride * 3) as usize) + d1))
        i = i + 1
    }
}
