import media.video.vp9.vp9mem

export { sf_count, sf_frame_size, sf_frame_offset }

fn index_len(data: u64, size: usize) -> usize {
    if size == 0 {
        return 0
    }
    let marker: i64 = vp9mem.ld8(data, size - 1)
    if (marker & 224) != 192 {
        return 0
    }
    let frames: usize = ((marker & 7) + 1) as usize
    let mag: usize = (((marker >> 3) & 3) + 1) as usize
    let total: usize = 2 + mag * frames
    if size < total {
        return 0
    }
    if vp9mem.ld8(data, size - total) != marker {
        return 0
    }
    return total
}

fn sf_count(data: u64, size: usize) -> i64 {
    if index_len(data, size) == 0 {
        return 1
    }
    return (vp9mem.ld8(data, size - 1) & 7) + 1
}

fn sf_frame_size(data: u64, size: usize, i: i64) -> usize {
    let total: usize = index_len(data, size)
    if total == 0 {
        return size
    }
    let marker: i64 = vp9mem.ld8(data, size - 1)
    let mag: usize = (((marker >> 3) & 3) + 1) as usize
    let base: usize = size - total + 1 + (i as usize) * mag
    var v: usize = 0
    var k: usize = 0
    while k < mag {
        v = v | ((vp9mem.ld8(data, base + k) as usize) << ((k * 8) as u64))
        k = k + 1
    }
    return v
}

fn sf_frame_offset(data: u64, size: usize, i: i64) -> usize {
    var off: usize = 0
    var k: i64 = 0
    while k < i {
        off = off + sf_frame_size(data, size, k)
        k = k + 1
    }
    return off
}
