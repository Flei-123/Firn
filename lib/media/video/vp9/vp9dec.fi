import media.video.vp9.vp9mem
import media.video.vp9.vp9state
import media.video.vp9.vp9hdr
import media.video.vp9.vp9tile
import media.video.vp9.vp9lf
import media.video.vp9.vp9adapt
import media.video.vp9.vp9adaptm

export { dec_frame, dec_yuv_size, dec_copy_yuv420, DEC_SHOWN, DEC_HIDDEN, DEC_ERR, DEC_UNSUPPORTED }

const DEC_SHOWN: i64 = 0
const DEC_HIDDEN: i64 = 1
const DEC_ERR: i64 = 0 - 1
const DEC_UNSUPPORTED: i64 = 0 - 2

fn pick_buf(f: *mut vp9state.Vp9) -> i64 {
    var i: i64 = 0
    while i < 10 {
        var used: bool = false
        var s: usize = 0
        while s < 8 {
            if (*f).slot[s] == i {
                used = true
            }
            s = s + 1
        }
        if !used {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

fn swap_seg_maps(f: *mut vp9state.Vp9) {
    let t: u64 = (*f).seg_cur
    (*f).seg_cur = (*f).seg_last
    (*f).seg_last = t
}

fn dec_frame(f: *mut vp9state.Vp9, data: u64, size: usize) -> i64 {
    if size == 0 {
        return (0 - 11)
    }
    (*f).last_key = (*f).key
    var hdr_end: i64 = 0
    let rc: i64 = vp9hdr.hdr_parse(f, data, size, &hdr_end)
    if rc == vp9hdr.HDR_SHOW_EXISTING {
        let slot: i64 = (*f).slot[(*f).show_existing as usize]
        if slot < 0 {
            return (0 - 12)
        }
        (*f).out_buf = slot
        return DEC_SHOWN
    }
    if rc == vp9hdr.HDR_UNSUPPORTED {
        return DEC_UNSUPPORTED
    }
    if rc != vp9hdr.HDR_OK {
        return (0 - 13)
    }
    if (*f).hdr_size <= 0 || (hdr_end as usize) + ((*f).hdr_size as usize) > size {
        return (0 - 14)
    }
    let cur: i64 = pick_buf(f)
    if cur < 0 {
        return (0 - 15)
    }
    (*f).cur = cur
    if !vp9state.buf_alloc(&(*f).pool[cur as usize], (*f).w, (*f).h) {
        return (0 - 16)
    }
    if !vp9hdr.hdr_compressed(f, data + hdr_end as u64, (*f).hdr_size as usize) {
        return (0 - 17)
    }
    vp9mem.zero((*f).counts, vp9state.COUNT_LEN)
    let tstart: usize = (hdr_end as usize) + ((*f).hdr_size as usize)
    if !vp9tile.decode_tiles(f, data + tstart as u64, size - tstart) {
        return (0 - 18)
    }
    vp9lf.lf_frame(f)
    if !(*f).error_res && !(*f).parallel {
        vp9adapt.adapt_coef(f)
        if !(*f).key && !(*f).intra_only {
            vp9adaptm.adapt_mode(f)
            vp9adaptm.adapt_mv(f)
        }
    }
    if (*f).refresh_ctx {
        vp9mem.copy((*f).saved + ((*f).ctx_idx as usize * vp9state.PROB_LEN) as u64, (*f).fc, vp9state.PROB_LEN)
    }
    var i: usize = 0
    while i < 8 {
        if ((*f).refresh_flags >> (i as u64)) & 1 == 1 {
            (*f).slot[i] = cur
        }
        i = i + 1
    }
    if (*f).seg_on {
        swap_seg_maps(f)
    }
    let t: u64 = (*f).mi
    (*f).mi = (*f).prev_mi
    (*f).prev_mi = t
    if (*f).show {
        (*f).out_buf = cur
        return DEC_SHOWN
    }
    return DEC_HIDDEN
}

fn dec_yuv_size(f: *mut vp9state.Vp9) -> usize {
    let cw: i64 = ((*f).w + 1) / 2
    let ch: i64 = ((*f).h + 1) / 2
    return ((*f).w * (*f).h + 2 * cw * ch) as usize
}

fn copy_plane(dst: u64, src: u64, stride: i64, w: i64, h: i64) {
    var y: i64 = 0
    while y < h {
        vp9mem.copy(dst + (y * w) as u64, src + (y * stride) as u64, w as usize)
        y = y + 1
    }
}

fn dec_copy_yuv420(f: *mut vp9state.Vp9, dst: u64) {
    let b: *mut vp9state.Buf9 = &(*f).pool[(*f).out_buf as usize]
    let w: i64 = (*b).w
    let h: i64 = (*b).h
    let cw: i64 = (w + 1) / 2
    let ch: i64 = (h + 1) / 2
    copy_plane(dst, (*b).y, (*b).ys, w, h)
    copy_plane(dst + (w * h) as u64, (*b).u, (*b).uvs, cw, ch)
    copy_plane(dst + (w * h + cw * ch) as u64, (*b).v, (*b).uvs, cw, ch)
}
