import media.video.vp9.vp9mem
import media.video.vp9.vp9ftab

export { tap, tap_base, KERNEL_EIGHTTAP, KERNEL_SMOOTH, KERNEL_SHARP, KERNEL_BILINEAR }

const KERNEL_EIGHTTAP: i64 = 0
const KERNEL_SMOOTH: i64 = 1
const KERNEL_SHARP: i64 = 2
const KERNEL_BILINEAR: i64 = 3

fn tap_base(kernel: i64, phase: i64) -> usize {
    return ((kernel * 16 + phase) * 8) as usize
}

fn tap(base: usize, t: usize) -> i64 {
    return vp9mem.ld16(vp9ftab.filt_addr(), base + t) - 128
}
