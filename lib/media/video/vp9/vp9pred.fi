import media.video.vp9.vp9mem
import media.video.vp9.vp9state

export {
    intra_inter_ctx, comp_inter_ctx, comp_ref_ctx, single_ref_p1_ctx, single_ref_p2_ctx, interp_ctx, seg_pred_ctx,
}

fn rf(mi: u64, n: i64) -> i64 {
    if n == 0 {
        return vp9mem.ld8(mi, vp9state.MI_REF0)
    }
    return vp9mem.ld8(mi, vp9state.MI_REF1)
}

fn is_inter(mi: u64) -> bool {
    return vp9mem.ld8(mi, vp9state.MI_REF0) > 0
}

fn has_second(mi: u64) -> bool {
    return vp9mem.ld8(mi, vp9state.MI_REF1) > 0
}

fn b2i(b: bool) -> i64 {
    if b {
        return 1
    }
    return 0
}

fn intra_inter_ctx(ab: u64, lf: u64) -> i64 {
    if ab != 0 && lf != 0 {
        let ai: bool = !is_inter(ab)
        let li: bool = !is_inter(lf)
        if ai && li {
            return 3
        }
        return b2i(ai || li)
    }
    if ab != 0 || lf != 0 {
        var e: u64 = ab
        if ab == 0 {
            e = lf
        }
        return 2 * b2i(!is_inter(e))
    }
    return 0
}

fn comp_inter_ctx(f: *mut vp9state.Vp9, ab: u64, lf: u64) -> i64 {
    let fixed: i64 = (*f).comp_fixed
    if ab != 0 && lf != 0 {
        if !has_second(ab) && !has_second(lf) {
            return b2i(rf(ab, 0) == fixed) ^ b2i(rf(lf, 0) == fixed)
        } else if !has_second(ab) {
            return 2 + b2i(rf(ab, 0) == fixed || !is_inter(ab))
        } else if !has_second(lf) {
            return 2 + b2i(rf(lf, 0) == fixed || !is_inter(lf))
        }
        return 4
    }
    if ab != 0 || lf != 0 {
        var e: u64 = ab
        if ab == 0 {
            e = lf
        }
        if !has_second(e) {
            return b2i(rf(e, 0) == fixed)
        }
        return 3
    }
    return 1
}

fn comp_ref_ctx(f: *mut vp9state.Vp9, ab: u64, lf: u64) -> i64 {
    let fix_idx: i64 = (*f).sign_bias[(*f).comp_fixed as usize]
    let var_idx: i64 = 1 - fix_idx
    let v0: i64 = (*f).comp_var0
    let v1: i64 = (*f).comp_var1
    let fixed: i64 = (*f).comp_fixed
    if ab != 0 && lf != 0 {
        let ai: bool = !is_inter(ab)
        let li: bool = !is_inter(lf)
        if ai && li {
            return 2
        } else if ai || li {
            var e: u64 = ab
            if ai {
                e = lf
            }
            if !has_second(e) {
                return 1 + 2 * b2i(rf(e, 0) != v1)
            }
            return 1 + 2 * b2i(rf(e, var_idx) != v1)
        }
        let l_sg: bool = !has_second(lf)
        let a_sg: bool = !has_second(ab)
        var vrfa: i64 = rf(ab, var_idx)
        if a_sg {
            vrfa = rf(ab, 0)
        }
        var vrfl: i64 = rf(lf, var_idx)
        if l_sg {
            vrfl = rf(lf, 0)
        }
        if vrfa == vrfl && v1 == vrfa {
            return 0
        } else if l_sg && a_sg {
            if (vrfa == fixed && vrfl == v0) || (vrfl == fixed && vrfa == v0) {
                return 4
            } else if vrfa == vrfl {
                return 3
            }
            return 1
        } else if l_sg || a_sg {
            var vrfc: i64 = vrfl
            if l_sg {
                vrfc = vrfa
            }
            var rfs: i64 = vrfl
            if a_sg {
                rfs = vrfa
            }
            if vrfc == v1 && rfs != v1 {
                return 1
            } else if rfs == v1 && vrfc != v1 {
                return 2
            }
            return 4
        } else if vrfa == vrfl {
            return 4
        }
        return 2
    }
    if ab != 0 || lf != 0 {
        var e: u64 = ab
        if ab == 0 {
            e = lf
        }
        if !is_inter(e) {
            return 2
        }
        if has_second(e) {
            return 4 * b2i(rf(e, var_idx) != v1)
        }
        return 3 * b2i(rf(e, 0) != v1)
    }
    return 2
}

fn has_ref(mi: u64, r: i64) -> bool {
    return rf(mi, 0) == r || rf(mi, 1) == r
}

fn single_ref_p1_ctx(ab: u64, lf: u64) -> i64 {
    if ab != 0 && lf != 0 {
        let ai: bool = !is_inter(ab)
        let li: bool = !is_inter(lf)
        if ai && li {
            return 2
        } else if ai || li {
            var e: u64 = ab
            if ai {
                e = lf
            }
            if !has_second(e) {
                return 4 * b2i(rf(e, 0) == 1)
            }
            return 1 + b2i(has_ref(e, 1))
        }
        let a2: bool = has_second(ab)
        let l2: bool = has_second(lf)
        if a2 && l2 {
            return 1 + b2i(has_ref(ab, 1) || has_ref(lf, 1))
        } else if a2 || l2 {
            var rfs: i64 = rf(lf, 0)
            if !a2 {
                rfs = rf(ab, 0)
            }
            var cm: u64 = lf
            if a2 {
                cm = ab
            }
            if rfs == 1 {
                return 3 + b2i(has_ref(cm, 1))
            }
            return b2i(has_ref(cm, 1))
        }
        return 2 * b2i(rf(ab, 0) == 1) + 2 * b2i(rf(lf, 0) == 1)
    }
    if ab != 0 || lf != 0 {
        var e: u64 = ab
        if ab == 0 {
            e = lf
        }
        if !is_inter(e) {
            return 2
        }
        if !has_second(e) {
            return 4 * b2i(rf(e, 0) == 1)
        }
        return 1 + b2i(has_ref(e, 1))
    }
    return 2
}

fn single_ref_p2_ctx(ab: u64, lf: u64) -> i64 {
    if ab != 0 && lf != 0 {
        let ai: bool = !is_inter(ab)
        let li: bool = !is_inter(lf)
        if ai && li {
            return 2
        } else if ai || li {
            var e: u64 = ab
            if ai {
                e = lf
            }
            if !has_second(e) {
                if rf(e, 0) == 1 {
                    return 3
                }
                return 4 * b2i(rf(e, 0) == 2)
            }
            return 1 + 2 * b2i(has_ref(e, 2))
        }
        let a2: bool = has_second(ab)
        let l2: bool = has_second(lf)
        let a0: i64 = rf(ab, 0)
        let a1: i64 = rf(ab, 1)
        let l0: i64 = rf(lf, 0)
        let l1: i64 = rf(lf, 1)
        if a2 && l2 {
            if a0 == l0 && a1 == l1 {
                return 3 * b2i(a0 == 2 || a1 == 2 || l0 == 2 || l1 == 2)
            }
            return 2
        } else if a2 || l2 {
            var rfs: i64 = l0
            if !a2 {
                rfs = a0
            }
            var crf1: i64 = l0
            var crf2: i64 = l1
            if a2 {
                crf1 = a0
                crf2 = a1
            }
            if rfs == 2 {
                return 3 + b2i(crf1 == 2 || crf2 == 2)
            } else if rfs == 3 {
                return b2i(crf1 == 2 || crf2 == 2)
            }
            return 1 + 2 * b2i(crf1 == 2 || crf2 == 2)
        }
        if a0 == 1 && l0 == 1 {
            return 3
        } else if a0 == 1 || l0 == 1 {
            var edge0: i64 = a0
            if a0 == 1 {
                edge0 = l0
            }
            return 4 * b2i(edge0 == 2)
        }
        return 2 * b2i(a0 == 2) + 2 * b2i(l0 == 2)
    }
    if ab != 0 || lf != 0 {
        var e: u64 = ab
        if ab == 0 {
            e = lf
        }
        if !is_inter(e) || (rf(e, 0) == 1 && !has_second(e)) {
            return 2
        } else if !has_second(e) {
            return 4 * b2i(rf(e, 0) == 2)
        }
        return 3 * b2i(has_ref(e, 2))
    }
    return 2
}

fn filter_of(mi: u64) -> i64 {
    if mi == 0 || !is_inter(mi) {
        return 3
    }
    return vp9mem.ld8(mi, vp9state.MI_FILTER)
}

fn interp_ctx(ab: u64, lf: u64) -> i64 {
    let l: i64 = filter_of(lf)
    let a: i64 = filter_of(ab)
    if l == a {
        return l
    } else if l == 3 {
        return a
    } else if a == 3 {
        return l
    }
    return 3
}

fn seg_pred_ctx(ab: u64, lf: u64) -> i64 {
    var c: i64 = 0
    if ab != 0 {
        c = c + vp9mem.ld8(ab, 13)
    }
    if lf != 0 {
        c = c + vp9mem.ld8(lf, 13)
    }
    return c
}
