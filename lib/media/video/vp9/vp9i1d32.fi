    vp9mem.sti(out, 28, (step1[3] - step1[28]))
    vp9mem.sti(out, 29, (step1[2] - step1[29]))
    vp9mem.sti(out, 30, (step1[1] - step1[30]))
    vp9mem.sti(out, 31, (step1[0] - step1[31]))
}
