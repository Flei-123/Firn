import media.video.vp9.vp9mem
import media.video.vp9.vp9state
import media.video.vp9.vp9blk
import media.video.vp9.vp9scale
import media.video.vp9.vp9mc

export { mc_inter_block, MV_BMI0 }

const MV_BMI0: usize = 24

fn buf_plane(b: *vp9state.Buf9, plane: usize) -> u64 {
    if plane == 0 {
        return (*b).y
    }
    if plane == 1 {
        return (*b).u
    }
    return (*b).v
}

fn mv_row_at(mi: u64, off: usize) -> i64 {
    return vp9mem.ldi16(mi, off / 2)
}

fn mv_col_at(mi: u64, off: usize) -> i64 {
    return vp9mem.ldi16(mi, off / 2 + 1)
}

fn bmi_off(b: usize, r: usize) -> usize {
    return MV_BMI0 + b * 8 + r * 4
}

fn avg4_row(mi: u64, r: usize) -> i64 {
    return vp9scale.round_mv_q4(mv_row_at(mi, bmi_off(0, r)) + mv_row_at(mi, bmi_off(1, r)) + mv_row_at(mi, bmi_off(2, r)) + mv_row_at(mi, bmi_off(3, r)))
}

fn avg4_col(mi: u64, r: usize) -> i64 {
    return vp9scale.round_mv_q4(mv_col_at(mi, bmi_off(0, r)) + mv_col_at(mi, bmi_off(1, r)) + mv_col_at(mi, bmi_off(2, r)) + mv_col_at(mi, bmi_off(3, r)))
}

fn mc_inter_block(mc: *vp9mc.Mc, f: *mut vp9state.Vp9, mi_row: i64, mi_col: i64) -> bool {
    let mi: u64 = vp9state.mi_ptr(f, mi_row, mi_col)
    let bsize: i64 = vp9blk.mi_bsize(mi)
    let ref0: i64 = vp9mem.ld8(mi, vp9state.MI_REF0)
    let ref1: i64 = vp9mem.ld8(mi, vp9state.MI_REF1)
    let kernel: i64 = vp9mem.ld8(mi, vp9state.MI_FILTER)
    let bw8: i64 = vp9blk.bw8(bsize)
    let bh8: i64 = vp9blk.bh8(bsize)
    let sub8: bool = bsize < 3
    let cur: *mut vp9state.Buf9 = &(*f).pool[(*f).cur as usize]
    var pos: vp9mc.McPos = vp9mc.McPos { mi_x: 0, mi_y: 0, to_left: 0, to_right: 0, to_top: 0, to_bottom: 0, kernel: 0 }
    vp9mc.mcpos_set(&pos, mi_row, mi_col, bw8, bh8, (*f).mi_rows, (*f).mi_cols, kernel)
    var nref: usize = 1
    if ref1 > 0 {
        nref = 2
    }
    var r: usize = 0
    while r < nref {
        var frame: i64 = ref0
        if r == 1 {
            frame = ref1
        }
        let slot_i: i64 = (*f).slot[(*f).ref_idx[(frame - 1) as usize] as usize]
        if slot_i < 0 {
            return false
        }
        let rb: *vp9state.Buf9 = &(*f).pool[slot_i as usize]
        var sf: vp9scale.Scale = vp9scale.scale_new()
        if !vp9scale.scale_setup(&sf, (*rb).w, (*rb).h, (*f).w, (*f).h) {
            return false
        }
        let avg: bool = r == 1
        var plane: usize = 0
        while plane < 3 {
            var ss: i64 = 0
            var stride: i64 = (*rb).ys
            var cwid: i64 = (*rb).w
            var chei: i64 = (*rb).h
            var dstride: i64 = (*cur).ys
            if plane > 0 {
                ss = 1
                stride = (*rb).uvs
                cwid = ((*rb).w + 1) >> 1
                chei = ((*rb).h + 1) >> 1
                dstride = (*cur).uvs
            }
            let rp: vp9mc.RefPlane = vp9mc.RefPlane { p: buf_plane(rb, plane), stride: stride, cw: cwid, ch: chei }
            let dorg: u64 = buf_plane(cur, plane) + (((mi_row * 8) >> (ss as u64)) * dstride + ((mi_col * 8) >> (ss as u64))) as u64
            let n4w: i64 = (bw8 * 2) >> (ss as u64)
            let n4h: i64 = (bh8 * 2) >> (ss as u64)
            if sub8 {
                var i: usize = 0
                var by: i64 = 0
                while by < n4h {
                    var bx: i64 = 0
                    while bx < n4w {
                        var mvr: i64 = 0
                        var mvc: i64 = 0
                        if ss == 0 {
                            mvr = mv_row_at(mi, bmi_off(i, r))
                            mvc = mv_col_at(mi, bmi_off(i, r))
                        } else {
                            mvr = avg4_row(mi, r)
                            mvc = avg4_col(mi, r)
                        }
                        vp9mc.mc_build(mc, &sf, &rp, &pos, dorg, dstride, ss, ss, n4w * 4, n4h * 4, bx * 4, by * 4, 4, 4, mvr, mvc, avg)
                        i = i + 1
                        bx = bx + 1
                    }
                    by = by + 1
                }
            } else {
                let mvr: i64 = mv_row_at(mi, 16 + r * 4)
                let mvc: i64 = mv_col_at(mi, 16 + r * 4)
                vp9mc.mc_build(mc, &sf, &rp, &pos, dorg, dstride, ss, ss, n4w * 4, n4h * 4, 0, 0, n4w * 4, n4h * 4, mvr, mvc, avg)
            }
            plane = plane + 1
        }
        r = r + 1
    }
    return true
}
