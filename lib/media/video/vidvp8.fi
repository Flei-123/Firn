import docview.obj
import media.demux
import media.video.convert
import media.video.vidops
import media.video.vp8.vp8dec
import media.video.vp8.vp8state

export { vvp8_ops }

struct Vp8Source {
    dm: demux.Demux,
    dec: vp8state.Vp8,
    track: i32,
    data: u64,
    next: usize,
    count: usize,
    open: bool,
}

fn h_create() -> u64 {
    let raw: u64 = obj.obj_alloc[Vp8Source]()
    if raw == 0 as u64 {
        return raw
    }
    *(raw as *mut Vp8Source) = Vp8Source { dm: demux.demux_new(), dec: vp8state.vp8_new(), track: -1, data: 0, next: 0, count: 0, open: false }
    return raw
}

fn h_destroy(h: u64) {
    if h != 0 as u64 {
        obj.obj_free[Vp8Source](h)
    }
}

fn h_open(h: u64, data: u64, n: usize) -> i32 {
    let vs: *mut Vp8Source = h as *mut Vp8Source
    if demux.demux_open(&(*vs).dm, data, n) != 0 {
        return vidops.VO_ERR_FORMAT
    }
    let t: i32 = demux.demux_find_track(&(*vs).dm, demux.TK_VIDEO)
    if t < 0 {
        return vidops.VO_ERR_FORMAT
    }
    if demux.demux_track_codec(&(*vs).dm, t) != demux.CODEC_VP8 {
        return vidops.VO_ERR_UNSUPPORTED
    }
    (*vs).track = t
    (*vs).data = data
    (*vs).count = demux.demux_nsamples(&(*vs).dm, t)
    (*vs).open = true
    return vidops.VO_OK
}

fn h_close(h: u64) {
    let vs: *mut Vp8Source = h as *mut Vp8Source
    vp8state.vp8_release(&(*vs).dec)
    demux.demux_free(&(*vs).dm)
    (*vs).open = false
}

fn h_width(h: u64) -> u32 {
    let vs: *mut Vp8Source = h as *mut Vp8Source
    return demux.demux_track_width(&(*vs).dm, (*vs).track)
}

fn h_height(h: u64) -> u32 {
    let vs: *mut Vp8Source = h as *mut Vp8Source
    return demux.demux_track_height(&(*vs).dm, (*vs).track)
}

fn h_duration(h: u64) -> i64 {
    let vs: *mut Vp8Source = h as *mut Vp8Source
    return demux.demux_track_duration_us(&(*vs).dm, (*vs).track)
}

fn h_fps(h: u64) -> u32 {
    let vs: *mut Vp8Source = h as *mut Vp8Source
    let dur: i64 = h_duration(h)
    if dur <= 0 || (*vs).count == 0 {
        return 0
    }
    return (((*vs).count as i64) * 1000000000 / dur) as u32
}

fn h_bytes(h: u64) -> usize {
    return (h_width(h) as usize) * (h_height(h) as usize) * 4
}

fn h_next(h: u64, out: u64, pts: *mut i64) -> i32 {
    let vs: *mut Vp8Source = h as *mut Vp8Source
    if !(*vs).open {
        return vidops.VO_ERR_UNSUPPORTED
    }
    while (*vs).next < (*vs).count {
        let i: usize = (*vs).next
        (*vs).next = i + 1
        let rc: i64 = vp8dec.dec_frame(&(*vs).dec, (*vs).data + demux.demux_sample_off(&(*vs).dm, (*vs).track, i),
            demux.demux_sample_size(&(*vs).dm, (*vs).track, i) as usize)
        if rc != vp8dec.DEC_OK && rc != vp8dec.DEC_NEED_KEY {
            return vidops.VO_ERR_DECODE
        }
        if rc == vp8dec.DEC_OK && (*vs).dec.show {
            let d: *mut vp8state.Vp8 = &(*vs).dec
            if (*d).w != (h_width(h) as i64) || (*d).h != (h_height(h) as i64) {
                return vidops.VO_ERR_DECODE
            }
            convert.yuv420_to_rgba(vp8state.plane_y(d, (*d).cur), vp8state.plane_u(d, (*d).cur), vp8state.plane_v(d, (*d).cur),
                (*d).ys as usize, (*d).uvs as usize, (*d).w as usize, (*d).h as usize, 6, out)
            *pts = demux.demux_sample_pts_us(&(*vs).dm, (*vs).track, i)
            return 1
        }
    }
    return vidops.VO_END
}

fn h_seek(h: u64, t: i64) -> i64 {
    let vs: *mut Vp8Source = h as *mut Vp8Source
    let k: usize = demux.demux_seek_sync(&(*vs).dm, (*vs).track, t)
    (*vs).next = k
    return demux.demux_sample_pts_us(&(*vs).dm, (*vs).track, k)
}

fn vvp8_ops() -> vidops.VideoOps {
    return vidops.VideoOps { create: h_create, destroy: h_destroy, open: h_open, close: h_close, width: h_width,
        height: h_height, fps_milli: h_fps, rgba_bytes: h_bytes, duration_us: h_duration, next_frame: h_next,
        seek: h_seek }
}
