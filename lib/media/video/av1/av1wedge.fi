import media.video.vp9.vp9mem
import media.video.av1.av1tabmask

export { wedge_obl_new, wedge_obl_free, wedge_mask, smooth_mask, smooth_mask_dims, wedge_supported, OBL_BYTES }

const OBL_BYTES: usize = 98304

fn oidx(neg: i64, dir: i64, off: i64) -> usize {
    return (((neg * 6 + dir) * 4096) + off) as usize
}

fn put(obl: u64, neg: i64, dir: i64, off: i64, v: i64) {
    vp9mem.st16(obl, oidx(neg, dir, off), v)
}

fn get(obl: u64, neg: i64, dir: i64, off: i64) -> i64 {
    return vp9mem.ld16(obl, oidx(neg, dir, off))
}

fn copy_shifted(obl: u64, src: u64, dir: i64, row: i64, shift: i64) {
    let base: i64 = row * 64
    if shift >= 0 {
        var i: i64 = 0
        while i < 64 - shift {
            put(obl, 0, dir, base + shift + i, vp9mem.ldi16(src, i as usize))
            i = i + 1
        }
        i = 0
        while i < shift {
            put(obl, 0, dir, base + i, vp9mem.ldi16(src, 0))
            i = i + 1
        }
    } else {
        let n: i64 = 0 - shift
        var i: i64 = 0
        while i < 64 - n {
            put(obl, 0, dir, base + i, vp9mem.ldi16(src, (n + i) as usize))
            i = i + 1
        }
        i = 0
        while i < n {
            put(obl, 0, dir, base + 64 - n + i, vp9mem.ldi16(src, 63))
            i = i + 1
        }
    }
}

fn wedge_obl_new() -> u64 {
    let obl: u64 = vp9mem.alloc(OBL_BYTES)
    vp9mem.zero(obl, OBL_BYTES)
    let odd: u64 = av1tabmask.wedge_master_odd_addr()
    let even: u64 = av1tabmask.wedge_master_even_addr()
    let vert: u64 = av1tabmask.wedge_master_vert_addr()
    var shift: i64 = 16
    var i: i64 = 0
    while i < 64 {
        copy_shifted(obl, even, 3, i, shift)
        shift = shift - 1
        copy_shifted(obl, odd, 3, i + 1, shift)
        var k: i64 = 0
        while k < 64 {
            let v: i64 = vp9mem.ldi16(vert, k as usize)
            put(obl, 0, 1, i * 64 + k, v)
            put(obl, 0, 1, (i + 1) * 64 + k, v)
            k = k + 1
        }
        i = i + 2
    }
    i = 0
    while i < 64 {
        var j: i64 = 0
        while j < 64 {
            let msk: i64 = get(obl, 0, 3, i * 64 + j)
            put(obl, 0, 2, j * 64 + i, msk)
            put(obl, 0, 4, i * 64 + 63 - j, 64 - msk)
            put(obl, 0, 5, (63 - j) * 64 + i, 64 - msk)
            put(obl, 1, 3, i * 64 + j, 64 - msk)
            put(obl, 1, 2, j * 64 + i, 64 - msk)
            put(obl, 1, 4, i * 64 + 63 - j, msk)
            put(obl, 1, 5, (63 - j) * 64 + i, msk)
            let mx: i64 = get(obl, 0, 1, i * 64 + j)
            put(obl, 0, 0, j * 64 + i, mx)
            put(obl, 1, 1, i * 64 + j, 64 - mx)
            put(obl, 1, 0, j * 64 + i, 64 - mx)
            j = j + 1
        }
        i = i + 1
    }
    return obl
}

fn wedge_obl_free(obl: u64) {
    vp9mem.free(obl, OBL_BYTES)
}

fn wedge_supported(bs: i64) -> bool {
    let w: i64 = vp9mem.ldi16(av1tabmask.blk_w_addr(), bs as usize)
    let h: i64 = vp9mem.ldi16(av1tabmask.blk_h_addr(), bs as usize)
    if w < 8 || h < 8 || w > 32 || h > 32 {
        return false
    }
    return w * 4 >= h && h * 4 >= w
}

fn wedge_mask(obl: u64, bs: i64, widx: i64, neg: i64, out: u64) {
    let bw: i64 = vp9mem.ldi16(av1tabmask.blk_w_addr(), bs as usize)
    let bh: i64 = vp9mem.ldi16(av1tabmask.blk_h_addr(), bs as usize)
    let book: i64 = vp9mem.ldi16(av1tabmask.wedge_book_of_addr(), bs as usize)
    let cb: u64 = av1tabmask.wedge_codebook_addr()
    let cbi: usize = ((book * 16 + widx) * 3) as usize
    let dir: i64 = vp9mem.ldi16(cb, cbi)
    let woff: i64 = (vp9mem.ldi16(cb, cbi + 1) * bw) >> 3
    let hoff: i64 = (vp9mem.ldi16(cb, cbi + 2) * bh) >> 3
    let flip: i64 = vp9mem.ldi16(av1tabmask.wedge_signflip_addr(), (bs * 16 + widx) as usize)
    let which: i64 = neg ^ flip
    let row_off: i64 = 32 - hoff
    let col_off: i64 = 32 - woff
    var r: i64 = 0
    while r < bh {
        var c: i64 = 0
        while c < bw {
            vp9mem.sti16(out, (r * bw + c) as usize, get(obl, which, dir, (row_off + r) * 64 + col_off + c))
            c = c + 1
        }
        r = r + 1
    }
}

fn smooth_mask(bs: i64, mode: i64, out: u64) {
    let bw: i64 = vp9mem.ldi16(av1tabmask.blk_w_addr(), bs as usize)
    let bh: i64 = vp9mem.ldi16(av1tabmask.blk_h_addr(), bs as usize)
    smooth_mask_dims(bw, bh, mode, out)
}

fn smooth_mask_dims(bw: i64, bh: i64, mode: i64, out: u64) {
    var mx: i64 = bw
    if bh > mx {
        mx = bh
    }
    let scale: i64 = 128 / mx
    let wt: u64 = av1tabmask.ii_weights_addr()
    var i: i64 = 0
    while i < bh {
        var j: i64 = 0
        while j < bw {
            var v: i64 = 32
            if mode == 1 {
                v = vp9mem.ldi16(wt, (i * scale) as usize)
            }
            if mode == 2 {
                v = vp9mem.ldi16(wt, (j * scale) as usize)
            }
            if mode == 3 {
                var m: i64 = i
                if j < i {
                    m = j
                }
                v = vp9mem.ldi16(wt, (m * scale) as usize)
            }
            vp9mem.sti16(out, (i * bw + j) as usize, v)
            j = j + 1
        }
        i = i + 1
    }
}
