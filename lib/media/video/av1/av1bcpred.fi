import media.video.vp9.vp9mem
import media.video.av1.av1blkst
import media.video.av1.av1blkdat
import media.video.av1.av1frame

export { predict_intrabc }

fn round2(v: i64, n: i64) -> i64 {
    if n == 0 {
        return v
    }
    return (v + (1 << ((n - 1) as u64))) >> (n as u64)
}

fn clip_idx(v: i64, last: i64) -> i64 {
    if v < 0 {
        return 0
    }
    if v > last {
        return last
    }
    return v
}

fn horizontal(buf: u64, stride: i64, y: i64, ix: i64, fx: i64, last_x: i64, round0: i64) -> i64 {
    let a: i64 = vp9mem.ld16(buf, (y * stride + clip_idx(ix, last_x)) as usize)
    if fx == 0 {
        return round2(a * 128, round0)
    }
    let b: i64 = vp9mem.ld16(buf, (y * stride + clip_idx(ix + 1, last_x)) as usize)
    return round2(a * (128 - 8 * fx) + b * 8 * fx, round0)
}

fn predict_plane(td: *mut av1blkst.TileDec, f: *mut av1frame.Frame, plane: i64) {
    let p: usize = plane as usize
    let buf: u64 = (*f).planes[p]
    let stride: i64 = (*f).strides[p]
    var sx: i64 = 0
    var sy: i64 = 0
    if plane > 0 {
        sx = (*td).ss_x
        sy = (*td).ss_y
    }
    let plane_sz: i64 = av1blkdat.subsampled_size((*td).mi_size, sx, sy)
    let w: i64 = av1blkdat.bw_px(plane_sz)
    let h: i64 = av1blkdat.bh_px(plane_sz)
    let base_x: i64 = ((*td).mi_col >> (sx as u64)) * 4
    let base_y: i64 = ((*td).mi_row >> (sy as u64)) * 4
    let px0: i64 = (base_x << 4) + ((2 * (*td).mv_col) >> (sx as u64))
    let py0: i64 = (base_y << 4) + ((2 * (*td).mv_row) >> (sy as u64))
    let fx: i64 = px0 & 15
    let fy: i64 = py0 & 15
    let last_x: i64 = (((*td).mi_cols * 4 + sx) >> (sx as u64)) - 1
    let last_y: i64 = (((*td).mi_rows * 4 + sy) >> (sy as u64)) - 1
    var round0: i64 = 3
    var round1: i64 = 11
    if (*td).bit_depth == 12 {
        round0 = 5
        round1 = 9
    }
    let max_v: i64 = (1 << ((*td).bit_depth as u64)) - 1
    var r: i64 = 0
    while r < h {
        let iy: i64 = (py0 >> 4) + r
        let y0: i64 = clip_idx(iy, last_y)
        let y1: i64 = clip_idx(iy + 1, last_y)
        var c: i64 = 0
        while c < w {
            let ix: i64 = (px0 >> 4) + c
            let i0: i64 = horizontal(buf, stride, y0, ix, fx, last_x, round0)
            var v: i64 = 0
            if fy == 0 {
                v = round2(i0 * 128, round1)
            } else {
                let i1: i64 = horizontal(buf, stride, y1, ix, fx, last_x, round0)
                v = round2(i0 * (128 - 8 * fy) + i1 * 8 * fy, round1)
            }
            if v < 0 {
                v = 0
            }
            if v > max_v {
                v = max_v
            }
            vp9mem.st16(buf, ((base_y + r) * stride + base_x + c) as usize, v)
            c = c + 1
        }
        r = r + 1
    }
}

fn predict_intrabc(td: *mut av1blkst.TileDec, f: *mut av1frame.Frame) {
    predict_plane(td, f, 0)
    if (*td).has_chroma != 0 {
        predict_plane(td, f, 1)
        predict_plane(td, f, 2)
    }
}
