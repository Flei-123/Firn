import media.video.vp9.vp9mem
import media.video.av1.av1ipm
import media.video.av1.av1mc
import media.video.av1.av1tabmask

export { overlap_len, mask_offset, blend_above, blend_left }

fn overlap_len(block_dim: i64, sub: i64) -> i64 {
    var d: i64 = block_dim
    if d > 64 {
        d = 64
    }
    return (d >> 1) >> (sub as u64)
}

fn mask_offset(len: i64) -> i64 {
    return len - 1
}

fn blend_above(dst: u64, dst_stride: i64, src: u64, src_stride: i64, w: i64, overlap: i64) {
    let masks: u64 = av1tabmask.obmc_masks_addr()
    let off: i64 = mask_offset(overlap)
    var i: i64 = 0
    while i < overlap {
        let m: i64 = vp9mem.ldi16(masks, (off + i) as usize)
        var j: i64 = 0
        while j < w {
            let cur: i64 = av1ipm.ld(dst, i * dst_stride + j)
            let nb: i64 = av1ipm.ld(src, i * src_stride + j)
            av1ipm.st(dst, i * dst_stride + j, av1mc.round2s(m * cur + (64 - m) * nb, 6))
            j = j + 1
        }
        i = i + 1
    }
}

fn blend_left(dst: u64, dst_stride: i64, src: u64, src_stride: i64, h: i64, overlap: i64) {
    let masks: u64 = av1tabmask.obmc_masks_addr()
    let off: i64 = mask_offset(overlap)
    var i: i64 = 0
    while i < h {
        var j: i64 = 0
        while j < overlap {
            let m: i64 = vp9mem.ldi16(masks, (off + j) as usize)
            let cur: i64 = av1ipm.ld(dst, i * dst_stride + j)
            let nb: i64 = av1ipm.ld(src, i * src_stride + j)
            av1ipm.st(dst, i * dst_stride + j, av1mc.round2s(m * cur + (64 - m) * nb, 6))
            j = j + 1
        }
        i = i + 1
    }
}
