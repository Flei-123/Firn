import media.video.av1.av1itxm
import media.video.av1.av1idct8
import media.video.av1.av1idct16
import media.video.av1.av1idct32
import media.video.av1.av1idct64
import media.video.av1.av1iadst

export { line_1d, iadst4, iident, KIND_DCT, KIND_ADST, KIND_IDENT }

const KIND_DCT: i64 = 0
const KIND_ADST: i64 = 1
const KIND_IDENT: i64 = 3

fn iadst4(inp: u64, out: u64) {
    let x0: i64 = av1itxm.li(inp, 0)
    let x1: i64 = av1itxm.li(inp, 1)
    let x2: i64 = av1itxm.li(inp, 2)
    let x3: i64 = av1itxm.li(inp, 3)
    if (x0 | x1 | x2 | x3) == 0 {
        av1itxm.si(out, 0, 0)
        av1itxm.si(out, 1, 0)
        av1itxm.si(out, 2, 0)
        av1itxm.si(out, 3, 0)
        return
    }
    let s0: i64 = 1321 * x0
    let s1: i64 = 2482 * x0
    let s2: i64 = 3344 * x1
    let s3: i64 = 3803 * x2
    let s4: i64 = 1321 * x2
    let s5: i64 = 2482 * x3
    let s6: i64 = 3803 * x3
    let s7: i64 = (x0 - x2) + x3
    let t0: i64 = s0 + s3 + s5
    let t1: i64 = s1 - s4 - s6
    let t3: i64 = s2
    let t2: i64 = 3344 * s7
    av1itxm.si(out, 0, av1itxm.rsh(t0 + t3, 12))
    av1itxm.si(out, 1, av1itxm.rsh(t1 + t3, 12))
    av1itxm.si(out, 2, av1itxm.rsh(t2, 12))
    av1itxm.si(out, 3, av1itxm.rsh(t0 + t1 - t3, 12))
}

fn iident(inp: u64, out: u64, n: usize) {
    var i: usize = 0
    while i < n {
        let v: i64 = av1itxm.li(inp, i)
        if n == 4 {
            av1itxm.si(out, i, av1itxm.rsh(5793 * v, 12))
        }
        if n == 8 {
            av1itxm.si(out, i, v * 2)
        }
        if n == 16 {
            av1itxm.si(out, i, av1itxm.rsh(11586 * v, 12))
        }
        if n == 32 {
            av1itxm.si(out, i, v * 4)
        }
        i = i + 1
    }
}

fn line_1d(kind: i64, log2n: i64, inp: u64, out: u64, stp: u64, r: i64) {
    if kind == KIND_IDENT {
        iident(inp, out, (1 << (log2n as u64)) as usize)
        return
    }
    if kind == KIND_ADST {
        if log2n == 2 {
            iadst4(inp, out)
        }
        if log2n == 3 {
            av1iadst.iadst8(inp, out, stp, r)
        }
        if log2n == 4 {
            av1iadst.iadst16(inp, out, stp, r)
        }
        return
    }
    if log2n == 2 {
        av1idct8.idct4(inp, out, stp, r)
    }
    if log2n == 3 {
        av1idct8.idct8(inp, out, stp, r)
    }
    if log2n == 4 {
        av1idct16.idct16(inp, out, stp, r)
    }
    if log2n == 5 {
        av1idct32.idct32(inp, out, stp, r)
    }
    if log2n == 6 {
        av1idct64.idct64(inp, out, stp, r)
    }
}
