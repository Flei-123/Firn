import media.video.av1.av1blkst
import media.video.av1.av1blkdat
import media.video.av1.av1cdfidx

export { read_block_tx_size, find_tx_size }

const MAX_VARTX_DEPTH: i64 = 2
const TX_MODE_SELECT: i64 = 2

fn find_tx_size(w: i64, h: i64) -> i64 {
    var t: i64 = 0
    while t < 19 {
        if av1blkdat.tx_w(t) == w && av1blkdat.tx_h(t) == h {
            return t
        }
        t = t + 1
    }
    return 0 - 1
}

fn above_tx_width(td: *mut av1blkst.TileDec, row: i64, col: i64) -> i64 {
    if row == (*td).mi_row {
        if (*td).avail_u == 0 {
            return 64
        }
        if av1blkst.mi_get(td, (*td).skip_a, row - 1, col) != 0 && av1blkst.mi_get(td, (*td).inter_a, row - 1, col) != 0 {
            return av1blkdat.bw_px(av1blkst.mi_get(td, (*td).mi_size_a, row - 1, col))
        }
    }
    return av1blkdat.tx_w(av1blkst.mi_get(td, (*td).itx_a, row - 1, col))
}

fn left_tx_height(td: *mut av1blkst.TileDec, row: i64, col: i64) -> i64 {
    if col == (*td).mi_col {
        if (*td).avail_l == 0 {
            return 64
        }
        if av1blkst.mi_get(td, (*td).skip_a, row, col - 1) != 0 && av1blkst.mi_get(td, (*td).inter_a, row, col - 1) != 0 {
            return av1blkdat.bh_px(av1blkst.mi_get(td, (*td).mi_size_a, row, col - 1))
        }
    }
    return av1blkdat.tx_h(av1blkst.mi_get(td, (*td).itx_a, row, col - 1))
}

fn fill_inter_tx_sizes(td: *mut av1blkst.TileDec, row: i64, col: i64, w4: i64, h4: i64, tx: i64) {
    var i: i64 = 0
    while i < h4 {
        var j: i64 = 0
        while j < w4 {
            if row + i < (*td).mi_rows && col + j < (*td).mi_cols {
                av1blkst.mi_set(td, (*td).itx_a, row + i, col + j, tx)
            }
            j = j + 1
        }
        i = i + 1
    }
}

fn tx_depth_ctx(td: *mut av1blkst.TileDec, max_rect: i64) -> i64 {
    let r: i64 = (*td).mi_row
    let c: i64 = (*td).mi_col
    var above: i64 = 0
    var left: i64 = 0
    if (*td).avail_u != 0 {
        var aw: i64 = above_tx_width(td, r, c)
        if av1blkst.mi_get(td, (*td).inter_a, r - 1, c) != 0 {
            aw = av1blkdat.bw_px(av1blkst.mi_get(td, (*td).mi_size_a, r - 1, c))
        }
        if aw >= av1blkdat.tx_w(max_rect) {
            above = 1
        }
    }
    if (*td).avail_l != 0 {
        var lh: i64 = left_tx_height(td, r, c)
        if av1blkst.mi_get(td, (*td).inter_a, r, c - 1) != 0 {
            lh = av1blkdat.bh_px(av1blkst.mi_get(td, (*td).mi_size_a, r, c - 1))
        }
        if lh >= av1blkdat.tx_h(max_rect) {
            left = 1
        }
    }
    return above + left
}

fn read_tx_size(td: *mut av1blkst.TileDec, allow_select: bool) {
    let ms: i64 = (*td).mi_size
    if (*td).lossless != 0 {
        (*td).tx_size = av1blkdat.TX_4X4
        return
    }
    let max_rect: i64 = av1blkdat.max_tx_rect(ms)
    (*td).tx_size = max_rect
    if ms == av1blkdat.BLOCK_4X4 || !allow_select || (*(*td).fh).tx_mode != TX_MODE_SELECT {
        return
    }
    let cat: i64 = av1blkdat.max_tx_depth(ms) - 1
    var n: i64 = 3
    if cat == 0 {
        n = 2
    }
    let ctx: i64 = tx_depth_ctx(td, max_rect)
    var depth: i64 = av1blkst.rd_sym(td, av1cdfidx.CDF_TX_SIZE + (cat * 12 + ctx * 4) as usize, n)
    while depth > 0 {
        (*td).tx_size = av1blkdat.split_tx((*td).tx_size)
        depth = depth - 1
    }
}

fn txfm_split_ctx(td: *mut av1blkst.TileDec, row: i64, col: i64, tx: i64) -> i64 {
    var above: i64 = 0
    var left: i64 = 0
    if above_tx_width(td, row, col) < av1blkdat.tx_w(tx) {
        above = 1
    }
    if left_tx_height(td, row, col) < av1blkdat.tx_h(tx) {
        left = 1
    }
    var size: i64 = av1blkdat.bw_px((*td).mi_size)
    let bh: i64 = av1blkdat.bh_px((*td).mi_size)
    if bh > size {
        size = bh
    }
    if size > 64 {
        size = 64
    }
    let max_tx: i64 = find_tx_size(size, size)
    var far: i64 = 0
    if av1blkdat.tx_sqr_up(tx) != max_tx {
        far = 1
    }
    return far * 3 + (4 - max_tx) * 6 + above + left
}

fn read_var_tx_size(td: *mut av1blkst.TileDec, row: i64, col: i64, tx: i64, depth: i64) {
    if row >= (*td).mi_rows || col >= (*td).mi_cols {
        return
    }
    var split: i64 = 0
    if tx != av1blkdat.TX_4X4 && depth != MAX_VARTX_DEPTH {
        split = av1blkst.rd_sym(td, av1cdfidx.CDF_TXFM_PARTITION + (txfm_split_ctx(td, row, col, tx) * 3) as usize, 2)
    }
    let w4: i64 = av1blkdat.tx_w(tx) >> 2
    let h4: i64 = av1blkdat.tx_h(tx) >> 2
    if split == 1 {
        let sub: i64 = av1blkdat.split_tx(tx)
        let step_w: i64 = av1blkdat.tx_w(sub) >> 2
        let step_h: i64 = av1blkdat.tx_h(sub) >> 2
        var i: i64 = 0
        while i < h4 {
            var j: i64 = 0
            while j < w4 {
                read_var_tx_size(td, row + i, col + j, sub, depth + 1)
                j = j + step_w
            }
            i = i + step_h
        }
    } else {
        fill_inter_tx_sizes(td, row, col, w4, h4, tx)
        (*td).tx_size = tx
    }
}

fn read_block_tx_size(td: *mut av1blkst.TileDec) {
    let ms: i64 = (*td).mi_size
    if (*(*td).fh).tx_mode == TX_MODE_SELECT && ms > av1blkdat.BLOCK_4X4 && (*td).is_inter != 0 && (*td).skip == 0 && (*td).lossless == 0 {
        let max_rect: i64 = av1blkdat.max_tx_rect(ms)
        let step_w: i64 = av1blkdat.tx_w(max_rect) >> 2
        let step_h: i64 = av1blkdat.tx_h(max_rect) >> 2
        var row: i64 = (*td).mi_row
        while row < (*td).mi_row + (*td).bh4 {
            var col: i64 = (*td).mi_col
            while col < (*td).mi_col + (*td).bw4 {
                read_var_tx_size(td, row, col, max_rect, 0)
                col = col + step_w
            }
            row = row + step_h
        }
        return
    }
    read_tx_size(td, (*td).skip == 0 || (*td).is_inter == 0)
    fill_inter_tx_sizes(td, (*td).mi_row, (*td).mi_col, (*td).bw4, (*td).bh4, (*td).tx_size)
}
