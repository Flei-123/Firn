// SPDX-License-Identifier: MPL-2.0
export { li, si, cl, btf, rsh }

#[no_gc]
fn li(p: u64, i: usize) -> i64 {
    return (*((p + (i * 4) as u64) as *mut i32)) as i64
}

#[no_gc]
fn si(p: u64, i: usize, v: i64) {
    *((p + (i * 4) as u64) as *mut i32) = v as% i32
}

#[no_gc]
fn cl(x: i64, bits: i64) -> i64 {
    let hi: i64 = (1 << ((bits - 1) as u64)) - 1
    let lo: i64 = 0 - hi - 1
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}

#[no_gc]
fn btf(w0: i64, a: i64, w1: i64, b: i64) -> i64 {
    return (w0 * a + w1 * b + 2048) >> 12
}

#[no_gc]
fn rsh(x: i64, bits: i64) -> i64 {
    if bits == 0 {
        return x
    }
    return (x + (1 << ((bits - 1) as u64))) >> (bits as u64)
}
