export { lv, lv_set, txb_skip_ctx_luma, txb_skip_ctx_chroma, dc_sign_ctx, base_ctx, base_eob_ctx, br_ctx }

#[no_gc]
fn lv(p: u64, i: i64) -> i64 {
    return (*((p + (i * 4) as u64) as *mut i32)) as i64
}

#[no_gc]
fn lv_set(p: u64, i: i64, v: i64) {
    *((p + (i * 4) as u64) as *mut i32) = v as i32
}

#[no_gc]
fn cb(p: u64, i: i64) -> i64 {
    return (*((p + i as u64) as *mut u8)) as i64
}

fn txb_skip_ctx_luma(above: u64, left: u64, x4: i64, y4: i64, w4: i64, h4: i64, max_x4: i64, max_y4: i64, full_block: bool) -> i64 {
    var top: i64 = 0
    var lft: i64 = 0
    var k: i64 = 0
    while k < w4 {
        if x4 + k < max_x4 {
            let v: i64 = cb(above, x4 + k)
            if v > top {
                top = v
            }
        }
        k = k + 1
    }
    k = 0
    while k < h4 {
        if y4 + k < max_y4 {
            let v: i64 = cb(left, y4 + k)
            if v > lft {
                lft = v
            }
        }
        k = k + 1
    }
    if full_block {
        return 0
    }
    if top == 0 && lft == 0 {
        return 1
    }
    var mx: i64 = top
    var mn: i64 = lft
    if lft > top {
        mx = lft
        mn = top
    }
    if top == 0 || lft == 0 {
        if mx > 3 {
            return 3
        }
        return 2
    }
    if mx <= 3 {
        return 4
    }
    if mn <= 3 {
        return 5
    }
    return 6
}

fn txb_skip_ctx_chroma(above: u64, above_dc: u64, left: u64, left_dc: u64, x4: i64, y4: i64, w4: i64, h4: i64, max_x4: i64, max_y4: i64, bigger: bool) -> i64 {
    var a: i64 = 0
    var l: i64 = 0
    var k: i64 = 0
    while k < w4 {
        if x4 + k < max_x4 {
            a = a | cb(above, x4 + k) | cb(above_dc, x4 + k)
        }
        k = k + 1
    }
    k = 0
    while k < h4 {
        if y4 + k < max_y4 {
            l = l | cb(left, y4 + k) | cb(left_dc, y4 + k)
        }
        k = k + 1
    }
    var ctx: i64 = 7
    if a != 0 {
        ctx = ctx + 1
    }
    if l != 0 {
        ctx = ctx + 1
    }
    if bigger {
        ctx = ctx + 3
    }
    return ctx
}

fn dc_sign_ctx(above_dc: u64, left_dc: u64, x4: i64, y4: i64, w4: i64, h4: i64, max_x4: i64, max_y4: i64) -> i64 {
    var s: i64 = 0
    var k: i64 = 0
    while k < w4 {
        if x4 + k < max_x4 {
            let v: i64 = cb(above_dc, x4 + k)
            if v == 1 {
                s = s - 1
            }
            if v == 2 {
                s = s + 1
            }
        }
        k = k + 1
    }
    k = 0
    while k < h4 {
        if y4 + k < max_y4 {
            let v: i64 = cb(left_dc, y4 + k)
            if v == 1 {
                s = s - 1
            }
            if v == 2 {
                s = s + 1
            }
        }
        k = k + 1
    }
    if s < 0 {
        return 1
    }
    if s > 0 {
        return 2
    }
    return 0
}

fn at3(q: u64, h: i64, w: i64, r: i64, c: i64) -> i64 {
    if r >= h || c >= w {
        return 0
    }
    let v: i64 = lv(q, c * h + r)
    if v > 3 {
        return 3
    }
    return v
}

fn off_2d(w: i64, h: i64, row: i64, col: i64) -> i64 {
    if w < h && row < 2 {
        return 11
    }
    if w > h && col < 2 {
        return 16
    }
    let s: i64 = row + col
    if s < 2 {
        return 1
    }
    if s < 4 {
        return 6
    }
    return 21
}

fn base_ctx(q: u64, h: i64, w: i64, bhl: i64, pos: i64, cls: i64, tx_w: i64, tx_h: i64) -> i64 {
    let row: i64 = pos & (h - 1)
    let col: i64 = pos >> (bhl as u64)
    var mag: i64 = at3(q, h, w, row, col + 1) + at3(q, h, w, row + 1, col)
    if cls == 0 {
        mag = mag + at3(q, h, w, row + 1, col + 1) + at3(q, h, w, row, col + 2) + at3(q, h, w, row + 2, col)
    }
    if cls == 1 {
        mag = mag + at3(q, h, w, row, col + 2) + at3(q, h, w, row, col + 3) + at3(q, h, w, row, col + 4)
    }
    if cls == 2 {
        mag = mag + at3(q, h, w, row + 2, col) + at3(q, h, w, row + 3, col) + at3(q, h, w, row + 4, col)
    }
    var ctx: i64 = (mag + 1) >> 1
    if ctx > 4 {
        ctx = 4
    }
    if cls == 0 {
        if pos == 0 {
            return 0
        }
        return ctx + off_2d(tx_w, tx_h, row, col)
    }
    var idx: i64 = col
    if cls == 2 {
        idx = row
    }
    if idx > 2 {
        idx = 2
    }
    return ctx + 26 + 5 * idx
}

fn base_eob_ctx(h: i64, w: i64, c: i64) -> i64 {
    if c == 0 {
        return 0
    }
    let area: i64 = h * w
    if c <= area / 8 {
        return 1
    }
    if c <= area / 4 {
        return 2
    }
    return 3
}

fn at15(q: u64, h: i64, w: i64, r: i64, c: i64) -> i64 {
    if r >= h || c >= w {
        return 0
    }
    return lv(q, c * h + r)
}

fn br_ctx(q: u64, h: i64, w: i64, bhl: i64, pos: i64, cls: i64) -> i64 {
    let row: i64 = pos & (h - 1)
    let col: i64 = pos >> (bhl as u64)
    var mag: i64 = at15(q, h, w, row, col + 1) + at15(q, h, w, row + 1, col)
    if cls == 0 {
        mag = mag + at15(q, h, w, row + 1, col + 1)
    }
    if cls == 1 {
        mag = mag + at15(q, h, w, row, col + 2)
    }
    if cls == 2 {
        mag = mag + at15(q, h, w, row + 2, col)
    }
    mag = (mag + 1) >> 1
    if mag > 6 {
        mag = 6
    }
    if pos == 0 {
        return mag
    }
    if cls == 0 && row < 2 && col < 2 {
        return mag + 7
    }
    if cls == 1 && col == 0 {
        return mag + 7
    }
    if cls == 2 && row == 0 {
        return mag + 7
    }
    return mag + 14
}
