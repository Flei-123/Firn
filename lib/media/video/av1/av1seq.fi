// SPDX-License-Identifier: MPL-2.0
import media.video.av1.av1br
import media.video.av1.av1mem

export { seq_new, seq_free, SeqHdr, seq_parse, SEQ_OK, SEQ_ERR, SELECT_SCREEN_CONTENT_TOOLS, SELECT_INTEGER_MV }

const SEQ_OK: i64 = 0
const SEQ_ERR: i64 = 0 - 1
const SELECT_SCREEN_CONTENT_TOOLS: i64 = 2
const SELECT_INTEGER_MV: i64 = 2

struct SeqHdr {
    seq_profile: i64,
    still_picture: i64,
    reduced_still_picture_header: i64,
    timing_info_present_flag: i64,
    num_units_in_display_tick: i64,
    time_scale: i64,
    equal_picture_interval: i64,
    num_ticks_per_picture_minus_1: i64,
    decoder_model_info_present_flag: i64,
    buffer_delay_length_minus_1: i64,
    num_units_in_decoding_tick: i64,
    buffer_removal_time_length_minus_1: i64,
    frame_presentation_time_length_minus_1: i64,
    initial_display_delay_present_flag: i64,
    operating_points_cnt_minus_1: i64,
    operating_point_idc: [i64; 32],
    seq_level_idx: [i64; 32],
    seq_tier: [i64; 32],
    decoder_model_present_for_this_op: [i64; 32],
    decoder_buffer_delay: [i64; 32],
    encoder_buffer_delay: [i64; 32],
    low_delay_mode_flag: [i64; 32],
    initial_display_delay_present_for_this_op: [i64; 32],
    initial_display_delay_minus_1: [i64; 32],
    operating_point_idc_sel: i64,
    frame_width_bits_minus_1: i64,
    frame_height_bits_minus_1: i64,
    max_frame_width_minus_1: i64,
    max_frame_height_minus_1: i64,
    frame_id_numbers_present_flag: i64,
    delta_frame_id_length_minus_2: i64,
    additional_frame_id_length_minus_1: i64,
    use_128x128_superblock: i64,
    enable_filter_intra: i64,
    enable_intra_edge_filter: i64,
    enable_interintra_compound: i64,
    enable_masked_compound: i64,
    enable_warped_motion: i64,
    enable_dual_filter: i64,
    enable_order_hint: i64,
    enable_jnt_comp: i64,
    enable_ref_frame_mvs: i64,
    seq_choose_screen_content_tools: i64,
    seq_force_screen_content_tools: i64,
    seq_choose_integer_mv: i64,
    seq_force_integer_mv: i64,
    order_hint_bits: i64,
    enable_superres: i64,
    enable_cdef: i64,
    enable_restoration: i64,
    high_bitdepth: i64,
    twelve_bit: i64,
    bit_depth: i64,
    mono_chrome: i64,
    num_planes: i64,
    color_description_present_flag: i64,
    color_primaries: i64,
    transfer_characteristics: i64,
    matrix_coefficients: i64,
    color_range: i64,
    subsampling_x: i64,
    subsampling_y: i64,
    chroma_sample_position: i64,
    separate_uv_delta_q: i64,
    film_grain_params_present: i64,
}

fn color_config(r: *mut av1br.BR, s: *mut SeqHdr) -> i64 {
    (*s).high_bitdepth = av1br.rd_bit(r, "high_bitdepth")
    (*s).twelve_bit = 0
    if (*s).seq_profile == 2 && (*s).high_bitdepth == 1 {
        (*s).twelve_bit = av1br.rd_bit(r, "twelve_bit")
        if (*s).twelve_bit == 1 {
            (*s).bit_depth = 12
        } else {
            (*s).bit_depth = 10
        }
    } else if (*s).high_bitdepth == 1 {
        (*s).bit_depth = 10
    } else {
        (*s).bit_depth = 8
    }
    if (*s).seq_profile == 1 {
        (*s).mono_chrome = 0
    } else {
        (*s).mono_chrome = av1br.rd_bit(r, "mono_chrome")
    }
    (*s).num_planes = 3
    if (*s).mono_chrome == 1 {
        (*s).num_planes = 1
    }
    (*s).color_description_present_flag = av1br.rd_bit(r, "color_description_present_flag")
    if (*s).color_description_present_flag == 1 {
        (*s).color_primaries = av1br.rd(r, 8, "color_primaries")
        (*s).transfer_characteristics = av1br.rd(r, 8, "transfer_characteristics")
        (*s).matrix_coefficients = av1br.rd(r, 8, "matrix_coefficients")
    } else {
        (*s).color_primaries = 2
        (*s).transfer_characteristics = 2
        (*s).matrix_coefficients = 2
    }
    if (*s).mono_chrome == 1 {
        (*s).color_range = av1br.rd_bit(r, "color_range")
        (*s).subsampling_x = 1
        (*s).subsampling_y = 1
        (*s).chroma_sample_position = 0
        (*s).separate_uv_delta_q = 0
        return SEQ_OK
    }
    if (*s).color_primaries == 1 && (*s).transfer_characteristics == 13 && (*s).matrix_coefficients == 0 {
        (*s).color_range = 1
        (*s).subsampling_x = 0
        (*s).subsampling_y = 0
    } else {
        (*s).color_range = av1br.rd_bit(r, "color_range")
        if (*s).seq_profile == 0 {
            (*s).subsampling_x = 1
            (*s).subsampling_y = 1
        } else if (*s).seq_profile == 1 {
            (*s).subsampling_x = 0
            (*s).subsampling_y = 0
        } else if (*s).bit_depth == 12 {
            (*s).subsampling_x = av1br.rd_bit(r, "subsampling_x")
            if (*s).subsampling_x == 1 {
                (*s).subsampling_y = av1br.rd_bit(r, "subsampling_y")
            } else {
                (*s).subsampling_y = 0
            }
        } else {
            (*s).subsampling_x = 1
            (*s).subsampling_y = 0
        }
        if (*s).subsampling_x == 1 && (*s).subsampling_y == 1 {
            (*s).chroma_sample_position = av1br.rd(r, 2, "chroma_sample_position")
        }
    }
    (*s).separate_uv_delta_q = av1br.rd_bit(r, "separate_uv_delta_q")
    return SEQ_OK
}

fn op_points(r: *mut av1br.BR, s: *mut SeqHdr) {
    (*s).timing_info_present_flag = av1br.rd_bit(r, "timing_info_present_flag")
    (*s).decoder_model_info_present_flag = 0
    if (*s).timing_info_present_flag == 1 {
        (*s).num_units_in_display_tick = av1br.rd(r, 32, "num_units_in_display_tick")
        (*s).time_scale = av1br.rd(r, 32, "time_scale")
        (*s).equal_picture_interval = av1br.rd_bit(r, "equal_picture_interval")
        if (*s).equal_picture_interval == 1 {
            (*s).num_ticks_per_picture_minus_1 = av1br.rd_uvlc(r, "num_ticks_per_picture_minus_1")
        }
        (*s).decoder_model_info_present_flag = av1br.rd_bit(r, "decoder_model_info_present_flag")
        if (*s).decoder_model_info_present_flag == 1 {
            (*s).buffer_delay_length_minus_1 = av1br.rd(r, 5, "buffer_delay_length_minus_1")
            (*s).num_units_in_decoding_tick = av1br.rd(r, 32, "num_units_in_decoding_tick")
            (*s).buffer_removal_time_length_minus_1 = av1br.rd(r, 5, "buffer_removal_time_length_minus_1")
            (*s).frame_presentation_time_length_minus_1 = av1br.rd(r, 5, "frame_presentation_time_length_minus_1")
        }
    }
    (*s).initial_display_delay_present_flag = av1br.rd_bit(r, "initial_display_delay_present_flag")
    (*s).operating_points_cnt_minus_1 = av1br.rd(r, 5, "operating_points_cnt_minus_1")
    var i: i64 = 0
    while i <= (*s).operating_points_cnt_minus_1 {
        let k: usize = i as usize
        (*s).operating_point_idc[k] = av1br.rd(r, 12, "operating_point_idc")
        (*s).seq_level_idx[k] = av1br.rd(r, 5, "seq_level_idx")
        if (*s).seq_level_idx[k] > 7 {
            (*s).seq_tier[k] = av1br.rd_bit(r, "seq_tier")
        } else {
            (*s).seq_tier[k] = 0
        }
        if (*s).decoder_model_info_present_flag == 1 {
            (*s).decoder_model_present_for_this_op[k] = av1br.rd_bit(r, "decoder_model_present_for_this_op")
            if (*s).decoder_model_present_for_this_op[k] == 1 {
                let n: i64 = (*s).buffer_delay_length_minus_1 + 1
                (*s).decoder_buffer_delay[k] = av1br.rd(r, n, "decoder_buffer_delay")
                (*s).encoder_buffer_delay[k] = av1br.rd(r, n, "encoder_buffer_delay")
                (*s).low_delay_mode_flag[k] = av1br.rd_bit(r, "low_delay_mode_flag")
            }
        } else {
            (*s).decoder_model_present_for_this_op[k] = 0
        }
        if (*s).initial_display_delay_present_flag == 1 {
            (*s).initial_display_delay_present_for_this_op[k] = av1br.rd_bit(r, "initial_display_delay_present_for_this_op")
            if (*s).initial_display_delay_present_for_this_op[k] == 1 {
                (*s).initial_display_delay_minus_1[k] = av1br.rd(r, 4, "initial_display_delay_minus_1")
            }
        }
        i = i + 1
    }
}

fn seq_defaults(s: *mut SeqHdr) {
    var i: usize = 0
    while i < 32 {
        (*s).operating_point_idc[i] = 0
        (*s).seq_level_idx[i] = 0
        (*s).seq_tier[i] = 0
        (*s).decoder_model_present_for_this_op[i] = 0
        (*s).decoder_buffer_delay[i] = 0
        (*s).encoder_buffer_delay[i] = 0
        (*s).low_delay_mode_flag[i] = 0
        (*s).initial_display_delay_present_for_this_op[i] = 0
        (*s).initial_display_delay_minus_1[i] = 0
        i = i + 1
    }
    (*s).timing_info_present_flag = 0
    (*s).decoder_model_info_present_flag = 0
    (*s).equal_picture_interval = 0
    (*s).initial_display_delay_present_flag = 0
    (*s).operating_points_cnt_minus_1 = 0
    (*s).frame_id_numbers_present_flag = 0
    (*s).enable_interintra_compound = 0
    (*s).enable_masked_compound = 0
    (*s).enable_warped_motion = 0
    (*s).enable_dual_filter = 0
    (*s).enable_order_hint = 0
    (*s).enable_jnt_comp = 0
    (*s).enable_ref_frame_mvs = 0
    (*s).seq_force_screen_content_tools = SELECT_SCREEN_CONTENT_TOOLS
    (*s).seq_force_integer_mv = SELECT_INTEGER_MV
    (*s).order_hint_bits = 0
    (*s).chroma_sample_position = 0
}

fn seq_parse(r: *mut av1br.BR, s: *mut SeqHdr) -> i64 {
    seq_defaults(s)
    (*s).seq_profile = av1br.rd(r, 3, "seq_profile")
    (*s).still_picture = av1br.rd_bit(r, "still_picture")
    (*s).reduced_still_picture_header = av1br.rd_bit(r, "reduced_still_picture_header")
    if (*s).reduced_still_picture_header == 1 {
        (*s).seq_level_idx[0] = av1br.rd(r, 5, "seq_level_idx")
    } else {
        op_points(r, s)
    }
    (*s).operating_point_idc_sel = (*s).operating_point_idc[0]
    (*s).frame_width_bits_minus_1 = av1br.rd(r, 4, "frame_width_bits_minus_1")
    (*s).frame_height_bits_minus_1 = av1br.rd(r, 4, "frame_height_bits_minus_1")
    (*s).max_frame_width_minus_1 = av1br.rd(r, (*s).frame_width_bits_minus_1 + 1, "max_frame_width_minus_1")
    (*s).max_frame_height_minus_1 = av1br.rd(r, (*s).frame_height_bits_minus_1 + 1, "max_frame_height_minus_1")
    if (*s).reduced_still_picture_header == 0 {
        (*s).frame_id_numbers_present_flag = av1br.rd_bit(r, "frame_id_numbers_present_flag")
    }
    if (*s).frame_id_numbers_present_flag == 1 {
        (*s).delta_frame_id_length_minus_2 = av1br.rd(r, 4, "delta_frame_id_length_minus_2")
        (*s).additional_frame_id_length_minus_1 = av1br.rd(r, 3, "additional_frame_id_length_minus_1")
    }
    (*s).use_128x128_superblock = av1br.rd_bit(r, "use_128x128_superblock")
    (*s).enable_filter_intra = av1br.rd_bit(r, "enable_filter_intra")
    (*s).enable_intra_edge_filter = av1br.rd_bit(r, "enable_intra_edge_filter")
    if (*s).reduced_still_picture_header == 0 {
        (*s).enable_interintra_compound = av1br.rd_bit(r, "enable_interintra_compound")
        (*s).enable_masked_compound = av1br.rd_bit(r, "enable_masked_compound")
        (*s).enable_warped_motion = av1br.rd_bit(r, "enable_warped_motion")
        (*s).enable_dual_filter = av1br.rd_bit(r, "enable_dual_filter")
        (*s).enable_order_hint = av1br.rd_bit(r, "enable_order_hint")
        if (*s).enable_order_hint == 1 {
            (*s).enable_jnt_comp = av1br.rd_bit(r, "enable_jnt_comp")
            (*s).enable_ref_frame_mvs = av1br.rd_bit(r, "enable_ref_frame_mvs")
        }
        (*s).seq_choose_screen_content_tools = av1br.rd_bit(r, "seq_choose_screen_content_tools")
        if (*s).seq_choose_screen_content_tools == 1 {
            (*s).seq_force_screen_content_tools = SELECT_SCREEN_CONTENT_TOOLS
        } else {
            (*s).seq_force_screen_content_tools = av1br.rd_bit(r, "seq_force_screen_content_tools")
        }
        if (*s).seq_force_screen_content_tools > 0 {
            (*s).seq_choose_integer_mv = av1br.rd_bit(r, "seq_choose_integer_mv")
            if (*s).seq_choose_integer_mv == 1 {
                (*s).seq_force_integer_mv = SELECT_INTEGER_MV
            } else {
                (*s).seq_force_integer_mv = av1br.rd_bit(r, "seq_force_integer_mv")
            }
        } else {
            (*s).seq_force_integer_mv = SELECT_INTEGER_MV
        }
        if (*s).enable_order_hint == 1 {
            (*s).order_hint_bits = av1br.rd(r, 3, "order_hint_bits_minus_1") + 1
        }
    }
    (*s).enable_superres = av1br.rd_bit(r, "enable_superres")
    (*s).enable_cdef = av1br.rd_bit(r, "enable_cdef")
    (*s).enable_restoration = av1br.rd_bit(r, "enable_restoration")
    color_config(r, s)
    (*s).film_grain_params_present = av1br.rd_bit(r, "film_grain_params_present")
    if !av1br.br_ok(r) {
        return SEQ_ERR
    }
    return SEQ_OK
}

fn seq_new() -> *mut SeqHdr {
    return av1mem.av1_zalloc[SeqHdr]()
}

fn seq_free(s: *mut SeqHdr) {
    av1mem.av1_zfree[SeqHdr](s)
}
