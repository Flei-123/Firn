import media.video.av1.av1ipm
import media.video.av1.av1blkst
import media.video.av1.av1blkdat
import media.video.av1.av1frame
import media.video.av1.av1mvmi
import media.video.av1.av1mcmask
import media.video.av1.av1obmc
import media.video.av1.av1interdef
import media.video.av1.av1intercore

export { obmc_plane }

fn min_i(a: i64, b: i64) -> i64 {
    if a < b {
        return a
    }
    return b
}

fn limit_of(bn: i64) -> i64 {
    var l: i64 = 0
    while (1 << (l as u64)) < bn {
        l = l + 1
    }
    return min_i(4, l)
}

fn obmc_plane(ic: *mut av1intercore.InterCtx, td: *mut av1blkst.TileDec, f: *mut av1frame.Frame, plane: i64) {
    var sx: i64 = 0
    var sy: i64 = 0
    if plane > 0 {
        sx = (*td).ss_x
        sy = (*td).ss_y
    }
    let p: usize = plane as usize
    let buf: u64 = (*f).planes[p]
    let stride: i64 = (*f).strides[p]
    let bd: i64 = (*td).bit_depth
    if (*td).avail_u != 0 && av1blkdat.subsampled_size((*td).mi_size, sx, sy) >= av1blkdat.BLOCK_8X8 {
        var x4: i64 = (*td).mi_col
        var count: i64 = 0
        let lim: i64 = limit_of((*td).bw4)
        let xend: i64 = min_i((*td).mi_cols, (*td).mi_col + (*td).bw4)
        while count < lim && x4 < xend {
            let cr: i64 = (*td).mi_row - 1
            let cc: i64 = x4 | 1
            let csz: i64 = av1blkst.mi_get(td, (*td).mi_size_a, cr, cc)
            let step4: i64 = av1interdef.clip3(2, 16, av1blkdat.bw4(csz))
            if av1mvmi.ref_get(td, cr, cc, 0) > 0 {
                count = count + 1
                let pw: i64 = (min_i((*td).bw4, step4) * 4) >> (sx as u64)
                let ph: i64 = av1obmc.overlap_len((*td).bh4 * 4, sy)
                let px: i64 = (x4 * 4) >> (sx as u64)
                let py: i64 = ((*td).mi_row * 4) >> (sy as u64)
                av1intercore.predict_ref(ic, td, plane, px, py, pw, ph, cr, cc, 0, 0, false, (*ic).out0)
                av1mcmask.single_to_plane((*ic).out0, pw, ph, (*ic).pix, pw, bd)
                av1obmc.blend_above(buf + ((py * stride + px) * 2) as u64, stride, (*ic).pix, pw, pw, ph)
            }
            x4 = x4 + step4
        }
    }
    if (*td).avail_l != 0 {
        var y4: i64 = (*td).mi_row
        var count: i64 = 0
        let lim: i64 = limit_of((*td).bh4)
        let yend: i64 = min_i((*td).mi_rows, (*td).mi_row + (*td).bh4)
        while count < lim && y4 < yend {
            let cc: i64 = (*td).mi_col - 1
            let cr: i64 = y4 | 1
            let csz: i64 = av1blkst.mi_get(td, (*td).mi_size_a, cr, cc)
            let step4: i64 = av1interdef.clip3(2, 16, av1blkdat.bh4(csz))
            if av1mvmi.ref_get(td, cr, cc, 0) > 0 {
                count = count + 1
                let pw: i64 = av1obmc.overlap_len((*td).bw4 * 4, sx)
                let ph: i64 = (min_i((*td).bh4, step4) * 4) >> (sy as u64)
                let px: i64 = ((*td).mi_col * 4) >> (sx as u64)
                let py: i64 = (y4 * 4) >> (sy as u64)
                av1intercore.predict_ref(ic, td, plane, px, py, pw, ph, cr, cc, 0, 0, false, (*ic).out0)
                av1mcmask.single_to_plane((*ic).out0, pw, ph, (*ic).pix, pw, bd)
                av1obmc.blend_left(buf + ((py * stride + px) * 2) as u64, stride, (*ic).pix, pw, ph, pw)
            }
            y4 = y4 + step4
        }
    }
}
