import media.video.vp9.vp9mem
import media.video.av1.av1blkst
import media.video.av1.av1fhdr
import media.video.av1.av1frame
import media.video.av1.av1ipm
import media.video.av1.av1tabsr

export { superres_upscale }

fn upscale_plane(td: *mut av1blkst.TileDec, f: *mut av1frame.Frame, plane: i64) {
    let fh: *mut av1fhdr.FrameHdr = (*td).fh
    var sx: i64 = 0
    var sy: i64 = 0
    if plane > 0 {
        sx = (*td).ss_x
        sy = (*td).ss_y
    }
    let down_w: i64 = ((*fh).frame_width + sx) >> (sx as u64)
    let up_w: i64 = ((*fh).upscaled_width + sx) >> (sx as u64)
    let plane_h: i64 = ((*fh).frame_height + sy) >> (sy as u64)
    let step: i64 = ((down_w << 14) + up_w / 2) / up_w
    let err: i64 = up_w * step - (down_w << 14)
    let num: i64 = 0 - ((up_w - down_w) << 13) + up_w / 2
    let x0: i64 = (num / up_w + 128 - err / 2) & 16383
    let max_x: i64 = (((*td).mi_cols * 4) >> (sx as u64)) - 1
    let stride: i64 = (*f).strides[plane as usize]
    let buf: u64 = (*f).planes[plane as usize]
    let tmp_n: usize = (max_x + 1) as usize * 2
    let tmp: u64 = vp9mem.alloc(tmp_n)
    let maxv: i64 = (1 << ((*td).bit_depth as u64)) - 1
    var y: i64 = 0
    while y < plane_h {
        var k: i64 = 0
        while k <= max_x {
            av1ipm.st(tmp, k, av1ipm.ld(buf, y * stride + k))
            k = k + 1
        }
        var x: i64 = 0
        while x < up_w {
            let src_x: i64 = 0 - 16384 + x0 + x * step
            let px: i64 = src_x >> 14
            let sub: i64 = (src_x & 16383) >> 8
            var sum: i64 = 0
            k = 0
            while k < 8 {
                let sxk: i64 = av1ipm.imax(0, av1ipm.imin(max_x, px + k - 3))
                sum = sum + av1ipm.ld(tmp, sxk) * (av1tabsr.UPSCALE_FILTER[(sub * 8 + k) as usize] as i64)
                k = k + 1
            }
            av1ipm.st(buf, y * stride + x, av1ipm.imax(0, av1ipm.imin(maxv, (sum + 64) >> 7)))
            x = x + 1
        }
        y = y + 1
    }
    vp9mem.free(tmp, tmp_n)
}

fn superres_upscale(td: *mut av1blkst.TileDec, f: *mut av1frame.Frame) {
    var plane: i64 = 0
    while plane < (*td).num_planes {
        upscale_plane(td, f, plane)
        plane = plane + 1
    }
}
