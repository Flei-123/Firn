import media.video.av1.av1blkst
import media.video.av1.av1blkdat
import media.video.av1.av1cdfidx
import media.video.av1.av1fhdr
import media.video.av1.av1palette
import media.video.av1.av1interdef
import media.video.av1.av1interctx
import media.video.av1.av1interref
import media.video.av1.av1intermode
import media.video.av1.av1intermm
import media.video.av1.av1modeinfo
import media.video.av1.av1intermv

export { inter_frame_mode_info, store_inter_mi }

fn predicted_segment_id(td: *mut av1blkst.TileDec) -> i64 {
    if (*td).prev_seg_a == 0 {
        return 0
    }
    var xm: i64 = (*td).mi_cols - (*td).mi_col
    if (*td).bw4 < xm {
        xm = (*td).bw4
    }
    var ym: i64 = (*td).mi_rows - (*td).mi_row
    if (*td).bh4 < ym {
        ym = (*td).bh4
    }
    var seg: i64 = 7
    var y: i64 = 0
    while y < ym {
        var x: i64 = 0
        while x < xm {
            let v: i64 = av1blkst.mi_get(td, (*td).prev_seg_a, (*td).mi_row + y, (*td).mi_col + x)
            if v < seg {
                seg = v
            }
            x = x + 1
        }
        y = y + 1
    }
    return seg
}

fn seg_pred_ctx(td: *mut av1blkst.TileDec) -> i64 {
    var c: i64 = 0
    if (*td).avail_u != 0 {
        c = c + av1blkst.mi_get(td, (*td).segpred_a, (*td).mi_row - 1, (*td).mi_col)
    }
    if (*td).avail_l != 0 {
        c = c + av1blkst.mi_get(td, (*td).segpred_a, (*td).mi_row, (*td).mi_col - 1)
    }
    return c
}

fn inter_segment_id(td: *mut av1blkst.TileDec, pre_skip: bool) {
    let fh: *mut av1fhdr.FrameHdr = (*td).fh
    if (*fh).segmentation_enabled == 0 {
        (*td).segment_id = 0
        return
    }
    let pred: i64 = predicted_segment_id(td)
    if (*fh).segmentation_update_map == 0 {
        (*td).segment_id = pred
        return
    }
    if pre_skip && (*fh).seg_id_pre_skip == 0 {
        (*td).segment_id = 0
        return
    }
    if !pre_skip && (*td).skip != 0 {
        (*td).seg_pred = 0
        av1modeinfo.read_segment_id(td)
        return
    }
    if (*fh).segmentation_temporal_update == 1 {
        let sp: i64 = av1blkst.rd_sym(td, av1cdfidx.CDF_SEGMENT_PRED + (seg_pred_ctx(td) * 3) as usize, 2)
        (*td).seg_pred = sp
        if sp == 1 {
            (*td).segment_id = pred
        } else {
            av1modeinfo.read_segment_id(td)
        }
        return
    }
    av1modeinfo.read_segment_id(td)
}

fn read_skip_mode(td: *mut av1blkst.TileDec) {
    let fh: *mut av1fhdr.FrameHdr = (*td).fh
    (*td).skip_mode = 0
    if av1modeinfo.seg_feature_active(td, av1modeinfo.SEG_LVL_SKIP) || av1modeinfo.seg_feature_active(td, av1interref.SEG_LVL_REF_FRAME) {
        return
    }
    if av1modeinfo.seg_feature_active(td, av1interref.SEG_LVL_GLOBALMV) || (*fh).skip_mode_present == 0 {
        return
    }
    if (*td).bw4 < 2 || (*td).bh4 < 2 {
        return
    }
    (*td).skip_mode = av1blkst.rd_sym(td, av1cdfidx.CDF_SKIP_MODE + (av1interctx.ctx_skip_mode(td) * 3) as usize, 2)
}

fn read_is_inter(td: *mut av1blkst.TileDec) {
    let fh: *mut av1fhdr.FrameHdr = (*td).fh
    if (*td).skip_mode != 0 {
        (*td).is_inter = 1
    } else if av1modeinfo.seg_feature_active(td, av1interref.SEG_LVL_REF_FRAME) {
        (*td).is_inter = 0
        if (*fh).feature_data[((*td).segment_id * 8 + av1interref.SEG_LVL_REF_FRAME) as usize] != av1interdef.INTRA_FRAME {
            (*td).is_inter = 1
        }
    } else if av1modeinfo.seg_feature_active(td, av1interref.SEG_LVL_GLOBALMV) {
        (*td).is_inter = 1
    } else {
        (*td).is_inter = av1blkst.rd_sym(td, av1cdfidx.CDF_INTRA_INTER + (av1interctx.ctx_intra_inter(td) * 3) as usize, 2)
    }
}

fn reset_intra_fields(td: *mut av1blkst.TileDec) {
    (*td).pal_size_y = 0
    (*td).pal_size_uv = 0
    (*td).cfl_u = 0
    (*td).cfl_v = 0
    (*td).angle_y = 0
    (*td).angle_uv = 0
    (*td).use_filter_intra = 0
    (*td).uv_mode = av1blkdat.DC_PRED
}

fn reset_inter_fields(td: *mut av1blkst.TileDec) {
    (*td).interintra = 0
    (*td).interintra_mode = 0
    (*td).wedge_interintra = 0
    (*td).wedge_index = 0
    (*td).wedge_sign = 0
    (*td).mask_type = 0
    (*td).motion_mode = av1interdef.MM_SIMPLE
    (*td).comp_group_idx = 0
    (*td).compound_idx = 0
    (*td).compound_type = av1interdef.CT_AVERAGE
    (*td).interp_filter[0] = 0
    (*td).interp_filter[1] = 0
    (*td).num_samples = 0
    (*td).overlappable = 0
    (*td).ref_mv_idx = 0
    var k: usize = 0
    while k < 4 {
        (*td).mvs[k] = 0
        k = k + 1
    }
    (*td).mv_row = 0
    (*td).mv_col = 0
}

fn intra_block_mode_info(td: *mut av1blkst.TileDec) {
    (*td).ref_frame[0] = av1interdef.INTRA_FRAME
    (*td).ref_frame[1] = av1interdef.NONE_FRAME
    reset_intra_fields(td)
    reset_inter_fields(td)
    let g: i64 = av1interdef.size_group((*td).mi_size)
    (*td).y_mode = av1blkst.rd_sym(td, av1cdfidx.CDF_IF_Y_MODE + (g * 14) as usize, 13)
    (*td).angle_y = av1modeinfo.read_angle(td, (*td).y_mode)
    if (*td).has_chroma != 0 {
        av1modeinfo.read_uv_mode(td)
        (*td).angle_uv = av1modeinfo.read_angle(td, (*td).uv_mode)
    }
    av1palette.palette_mode_info(td)
    av1modeinfo.read_filter_intra(td)
}

fn inter_block_mode_info(td: *mut av1blkst.TileDec) {
    reset_intra_fields(td)
    reset_inter_fields(td)
    av1interref.read_ref_frames(td)
    let is_compound: bool = (*td).ref_frame[1] > av1interdef.INTRA_FRAME
    av1intermode.read_inter_modes(td)
    av1intermm.read_interintra(td, is_compound)
    av1intermm.read_motion_mode(td, is_compound)
    av1intermm.read_compound_type(td, is_compound)
    av1intermm.read_interp_filters(td)
}

fn inter_frame_mode_info(td: *mut av1blkst.TileDec) -> i64 {
    let fh: *mut av1fhdr.FrameHdr = (*td).fh
    (*td).use_intrabc = 0
    (*td).skip = 0
    (*td).skip_mode = 0
    (*td).seg_pred = 0
    inter_segment_id(td, true)
    read_skip_mode(td)
    if (*td).skip_mode != 0 {
        (*td).skip = 1
    } else {
        av1modeinfo.read_skip(td)
    }
    if (*fh).seg_id_pre_skip == 0 {
        inter_segment_id(td, false)
    }
    (*td).lossless = (*fh).lossless_array[(*td).segment_id as usize]
    av1modeinfo.read_cdef(td)
    av1modeinfo.read_delta_qindex(td)
    av1modeinfo.read_delta_lf(td)
    (*td).read_deltas = 0
    read_is_inter(td)
    if (*td).is_inter != 0 {
        inter_block_mode_info(td)
    } else {
        intra_block_mode_info(td)
    }
    return av1blkst.TD_OK
}

fn store_inter_mi(td: *mut av1blkst.TileDec) {
    var y: i64 = 0
    while y < (*td).bh4 {
        var x: i64 = 0
        while x < (*td).bw4 {
            let r: i64 = (*td).mi_row + y
            let c: i64 = (*td).mi_col + x
            if r < (*td).mi_rows && c < (*td).mi_cols {
                let mi: i64 = r * (*td).mi_cols + c
                av1blkst.st((*td).ref_a, mi * 2, (*td).ref_frame[0] + 1)
                av1blkst.st((*td).ref_a, mi * 2 + 1, (*td).ref_frame[1] + 1)
                av1blkst.st((*td).skipmode_a, mi, (*td).skip_mode)
                av1blkst.st((*td).segpred_a, mi, (*td).seg_pred)
                av1blkst.st((*td).cgrp_a, mi, (*td).comp_group_idx)
                av1blkst.st((*td).cidx_a, mi, (*td).compound_idx)
                av1blkst.st((*td).interp_a, mi * 2, (*td).interp_filter[0])
                av1blkst.st((*td).interp_a, mi * 2 + 1, (*td).interp_filter[1])
                av1blkst.st((*td).wr_a, mi, 1)
                var k: i64 = 0
                while k < 4 {
                    av1intermv.mv_store(td, r, c, k >> 1, k & 1, (*td).mvs[k as usize])
                    k = k + 1
                }
            }
            x = x + 1
        }
        y = y + 1
    }
}
