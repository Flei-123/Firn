import media.video.av1.av1seq

export { rel_dist }

fn rel_dist(s: *mut av1seq.SeqHdr, a: i64, b: i64) -> i64 {
    if (*s).enable_order_hint == 0 {
        return 0
    }
    var diff: i64 = a - b
    let m: i64 = 1 << (((*s).order_hint_bits - 1) as u64)
    diff = (diff & (m - 1)) - (diff & m)
    return diff
}
