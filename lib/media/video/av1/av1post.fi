import media.video.av1.av1blkst
import media.video.av1.av1fhdr
import media.video.av1.av1frame
import media.video.av1.av1lf
import media.video.av1.av1cdef
import media.video.av1.av1lrfilt
import media.video.av1.av1superres

export { post_frame }

fn post_frame(td: *mut av1blkst.TileDec, f: *mut av1frame.Frame) {
    let fh: *mut av1fhdr.FrameHdr = (*td).fh
    av1lf.lf_frame(td, f)
    var cd: *mut av1frame.Frame = f
    let do_cdef: bool = av1cdef.cdef_active(td)
    if do_cdef {
        cd = av1frame.frame_clone(f)
        av1cdef.cdef_frame(td, f, cd)
    }
    if (*fh).use_superres != 0 {
        av1superres.superres_upscale(td, f)
        if cd != f {
            av1superres.superres_upscale(td, cd)
        }
    }
    if (*fh).uses_lr != 0 {
        let out: *mut av1frame.Frame = av1frame.frame_clone(cd)
        av1lrfilt.lr_frame(td, f, cd, out)
        av1frame.frame_copy_into(f, out)
        av1frame.frame_release(out)
    } else if do_cdef {
        av1frame.frame_copy_into(f, cd)
    }
    if do_cdef {
        av1frame.frame_release(cd)
    }
}
