import media.video.av1.av1blkst
import media.video.av1.av1mvmi
import media.video.av1.av1mvglob
import media.video.av1.av1mvscan
import media.video.av1.av1mvtemp
import media.video.av1.av1mvextra

export { find_mv_stack, store_mi_mv, stack_row, stack_col }

const REF_CAT_LEVEL: i64 = 640

fn store_mi_mv(td: *mut av1blkst.TileDec, row: i64, col: i64) {
    av1mvmi.store_mi_mv(td, row, col)
}

fn stack_row(td: *mut av1blkst.TileDec, idx: i64) -> i64 {
    return av1mvmi.stack_row(td, idx)
}

fn stack_col(td: *mut av1blkst.TileDec, idx: i64) -> i64 {
    return av1mvmi.stack_col(td, idx)
}

fn swap_entries(td: *mut av1blkst.TileDec, a: i64, b: i64) {
    let w: i64 = (*td).stack_w[a as usize]
    (*td).stack_w[a as usize] = (*td).stack_w[b as usize]
    (*td).stack_w[b as usize] = w
    var k: i64 = 0
    while k < 4 {
        let v: i64 = (*td).stack_mv[(a * 4 + k) as usize]
        (*td).stack_mv[(a * 4 + k) as usize] = (*td).stack_mv[(b * 4 + k) as usize]
        (*td).stack_mv[(b * 4 + k) as usize] = v
        k = k + 1
    }
}

fn sort_range(td: *mut av1blkst.TileDec, start: i64, end_in: i64) {
    var end: i64 = end_in
    while end > start {
        var new_end: i64 = start
        var idx: i64 = start + 1
        while idx < end {
            if (*td).stack_w[(idx - 1) as usize] < (*td).stack_w[idx as usize] {
                swap_entries(td, idx - 1, idx)
                new_end = idx
            }
            idx = idx + 1
        }
        end = new_end
    }
}


fn take_flag(ms: *mut [i64; 24], idx: usize) -> i64 {
    let v: i64 = (*ms)[idx]
    (*ms)[idx] = 0
    return v
}

fn find_mv_stack(td: *mut av1blkst.TileDec) {
    var ms: [i64; 24] = [0; 24]
    let p: *mut [i64; 24] = &ms
    var k: usize = 0
    while k < 32 {
        (*td).stack_mv[k] = 0
        k = k + 1
    }
    k = 0
    while k < 8 {
        (*td).stack_w[k] = 0
        k = k + 1
    }
    (*td).num_mv_found = 0
    av1mvglob.setup_global_mv(td)
    av1mvscan.scan_row(td, p, 0 - 1)
    var above: i64 = take_flag(p, av1mvmi.SC_FOUND)
    av1mvscan.scan_col(td, p, 0 - 1)
    var left: i64 = take_flag(p, av1mvmi.SC_FOUND)
    if (*td).bw4 <= 16 && (*td).bh4 <= 16 {
        av1mvscan.scan_point(td, p, 0 - 1, (*td).bw4)
    }
    if take_flag(p, av1mvmi.SC_FOUND) != 0 {
        above = 1
    }
    let close: i64 = above + left
    let nearest: i64 = (*td).num_mv_found
    let num_new: i64 = (*p)[av1mvmi.SC_NEW]
    var idx: i64 = 0
    while idx < nearest {
        (*td).stack_w[idx as usize] = (*td).stack_w[idx as usize] + REF_CAT_LEVEL
        idx = idx + 1
    }
    if (*(*td).fh).use_ref_frame_mvs != 0 && (*td).ref_frame[0] > 0 {
        av1mvtemp.temporal_process(td, p)
    }
    av1mvscan.scan_point(td, p, 0 - 1, 0 - 1)
    if take_flag(p, av1mvmi.SC_FOUND) != 0 {
        above = 1
    }
    av1mvscan.scan_row(td, p, 0 - 3)
    if take_flag(p, av1mvmi.SC_FOUND) != 0 {
        above = 1
    }
    av1mvscan.scan_col(td, p, 0 - 3)
    if take_flag(p, av1mvmi.SC_FOUND) != 0 {
        left = 1
    }
    if (*td).bh4 > 1 {
        av1mvscan.scan_row(td, p, 0 - 5)
    }
    if take_flag(p, av1mvmi.SC_FOUND) != 0 {
        above = 1
    }
    if (*td).bw4 > 1 {
        av1mvscan.scan_col(td, p, 0 - 5)
    }
    if take_flag(p, av1mvmi.SC_FOUND) != 0 {
        left = 1
    }
    sort_range(td, 0, nearest)
    sort_range(td, nearest, (*td).num_mv_found)
    if (*td).num_mv_found < 2 {
        av1mvextra.extra_search(td, p)
    }
    av1mvextra.mode_context(td, p, above, left, close, num_new)
    av1mvextra.clamp_stack(td)
}
