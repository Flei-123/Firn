import media.video.av1.av1fg
import media.video.av1.av1mem

export { FrameHdr, fhdr_new, fhdr_free, fhdr_zero, KEY_FRAME, INTER_FRAME, INTRA_ONLY_FRAME, SWITCH_FRAME, PRIMARY_REF_NONE }

const KEY_FRAME: i64 = 0
const INTER_FRAME: i64 = 1
const INTRA_ONLY_FRAME: i64 = 2
const SWITCH_FRAME: i64 = 3
const PRIMARY_REF_NONE: i64 = 7

struct FrameHdr {
    show_existing_frame: i64,
    frame_to_show_map_idx: i64,
    display_frame_id: i64,
    frame_type: i64,
    frame_is_intra: i64,
    show_frame: i64,
    showable_frame: i64,
    error_resilient_mode: i64,
    disable_cdf_update: i64,
    allow_screen_content_tools: i64,
    force_integer_mv: i64,
    current_frame_id: i64,
    frame_size_override_flag: i64,
    order_hint: i64,
    primary_ref_frame: i64,
    buffer_removal_time_present_flag: i64,
    refresh_frame_flags: i64,
    ref_order_hint: [i64; 8],
    allow_intrabc: i64,
    frame_refs_short_signaling: i64,
    last_frame_idx: i64,
    gold_frame_idx: i64,
    ref_frame_idx: [i64; 7],
    allow_high_precision_mv: i64,
    interpolation_filter: i64,
    is_motion_mode_switchable: i64,
    use_ref_frame_mvs: i64,
    order_hints: [i64; 8],
    ref_frame_sign_bias: [i64; 8],
    disable_frame_end_update_cdf: i64,
    frame_width: i64,
    frame_height: i64,
    upscaled_width: i64,
    render_width: i64,
    render_height: i64,
    use_superres: i64,
    superres_denom: i64,
    mi_cols: i64,
    mi_rows: i64,
    tile_cols: i64,
    tile_rows: i64,
    tile_cols_log2: i64,
    tile_rows_log2: i64,
    mi_col_starts: [i64; 65],
    mi_row_starts: [i64; 65],
    context_update_tile_id: i64,
    tile_size_bytes: i64,
    base_q_idx: i64,
    delta_q_y_dc: i64,
    delta_q_u_dc: i64,
    delta_q_u_ac: i64,
    delta_q_v_dc: i64,
    delta_q_v_ac: i64,
    using_qmatrix: i64,
    qm_y: i64,
    qm_u: i64,
    qm_v: i64,
    segmentation_enabled: i64,
    segmentation_update_map: i64,
    segmentation_temporal_update: i64,
    segmentation_update_data: i64,
    feature_enabled: [i64; 64],
    feature_data: [i64; 64],
    seg_id_pre_skip: i64,
    last_active_seg_id: i64,
    delta_q_present: i64,
    delta_q_res: i64,
    delta_lf_present: i64,
    delta_lf_res: i64,
    delta_lf_multi: i64,
    coded_lossless: i64,
    all_lossless: i64,
    lossless_array: [i64; 8],
    loop_filter_level: [i64; 4],
    loop_filter_sharpness: i64,
    loop_filter_delta_enabled: i64,
    loop_filter_ref_deltas: [i64; 8],
    loop_filter_mode_deltas: [i64; 2],
    cdef_damping: i64,
    cdef_bits: i64,
    cdef_y_pri_strength: [i64; 8],
    cdef_y_sec_strength: [i64; 8],
    cdef_uv_pri_strength: [i64; 8],
    cdef_uv_sec_strength: [i64; 8],
    frame_restoration_type: [i64; 3],
    uses_lr: i64,
    loop_restoration_size: [i64; 3],
    tx_mode: i64,
    reference_select: i64,
    skip_mode_present: i64,
    skip_mode_frame: [i64; 2],
    allow_warped_motion: i64,
    reduced_tx_set: i64,
    gm_type: [i64; 8],
    gm_params: [i64; 48],
    prev_gm_params: [i64; 48],
    film_grain: av1fg.FilmGrain,
    header_bits: i64,
}

fn fhdr_new() -> *mut FrameHdr {
    return av1mem.av1_zalloc[FrameHdr]()
}

fn fhdr_free(f: *mut FrameHdr) {
    av1mem.av1_zfree[FrameHdr](f)
}

fn fhdr_zero(f: *mut FrameHdr) {
    av1mem.av1_zero[FrameHdr](f)
}
