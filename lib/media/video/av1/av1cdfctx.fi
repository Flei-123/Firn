// SPDX-License-Identifier: MPL-2.0
import std.rt
import media.video.vp9.vp9mem
import media.video.av1.av1cdfidx
import media.video.av1.av1cdfdn
import media.video.av1.av1cdfq0
import media.video.av1.av1cdfq1
import media.video.av1.av1cdfq2
import media.video.av1.av1cdfq3
import media.video.av1.av1cdfcn

export { CdfState, cdf_alloc, cdf_free, cdf_at, cdf_copy, cdf_init_default, cdf_init_coef, cdf_clear_counters, cdf_q_class, cdfs_new, cdfs_free, cdfs_begin_frame, cdfs_begin_tile, cdfs_end_tile, cdfs_end_frame, cdfs_save_slot, cdfs_load_slot }

struct CdfState {
    frame: u64,
    tile: u64,
    saved: u64,
    slots: [u64; 8],
}

fn cdf_alloc() -> u64 {
    let n: usize = av1cdfidx.CDF_ALL * 2
    let p: u64 = rt.heap_alloc(n)
    vp9mem.zero(p, n)
    return p
}

fn cdf_free(p: u64) {
    if p != 0 {
        rt.heap_free(p, av1cdfidx.CDF_ALL * 2)
    }
}

fn cdf_at(block: u64, offset: usize) -> u64 {
    return block + (offset * 2) as u64
}

fn cdf_copy(dst: u64, src: u64) {
    vp9mem.copy(dst, src, av1cdfidx.CDF_ALL * 2)
}

fn cdf_init_default(block: u64) {
    vp9mem.copy(block, av1cdfdn.cdf_default_addr(), av1cdfidx.CDF_DEFAULT_TOTAL * 2)
}

fn cdf_q_class(base_q_idx: i64) -> i64 {
    if base_q_idx <= 20 {
        return 0
    }
    if base_q_idx <= 60 {
        return 1
    }
    if base_q_idx <= 120 {
        return 2
    }
    return 3
}

fn cdf_init_coef(block: u64, base_q_idx: i64) {
    let q: i64 = cdf_q_class(base_q_idx)
    var src: u64 = av1cdfq0.cdf_coef_q0_addr()
    if q == 1 {
        src = av1cdfq1.cdf_coef_q1_addr()
    }
    if q == 2 {
        src = av1cdfq2.cdf_coef_q2_addr()
    }
    if q == 3 {
        src = av1cdfq3.cdf_coef_q3_addr()
    }
    vp9mem.copy(cdf_at(block, av1cdfidx.CDF_COEF_BASE), src, av1cdfidx.CDF_COEF_TOTAL * 2)
}

fn cdf_clear_counters(block: u64) {
    let pos: u64 = av1cdfcn.cdf_counter_pos_addr()
    var i: usize = 0
    while i < av1cdfidx.CDF_COUNTERS {
        vp9mem.st16(block, vp9mem.ld32(pos, i) as usize, 0)
        i = i + 1
    }
}

fn cdfs_new() -> CdfState {
    return CdfState { frame: cdf_alloc(), tile: cdf_alloc(), saved: cdf_alloc(), slots: [0, 0, 0, 0, 0, 0, 0, 0] }
}

fn cdfs_free(st: *mut CdfState) {
    cdf_free((*st).frame)
    cdf_free((*st).tile)
    cdf_free((*st).saved)
    var i: usize = 0
    while i < 8 {
        cdf_free((*st).slots[i])
        (*st).slots[i] = 0
        i = i + 1
    }
    (*st).frame = 0
    (*st).tile = 0
    (*st).saved = 0
}

fn cdfs_begin_frame(st: *mut CdfState, primary_ref_none: bool, slot: usize, base_q_idx: i64) -> bool {
    if primary_ref_none {
        cdf_init_default((*st).frame)
        cdf_init_coef((*st).frame, base_q_idx)
        return true
    }
    if slot >= 8 || (*st).slots[slot] == 0 {
        return false
    }
    cdf_copy((*st).frame, (*st).slots[slot])
    return true
}

fn cdfs_begin_tile(st: *mut CdfState) {
    cdf_copy((*st).tile, (*st).frame)
}

fn cdfs_end_tile(st: *mut CdfState, tile_num: i64, update_tile_id: i64) {
    if tile_num == update_tile_id {
        cdf_copy((*st).saved, (*st).tile)
    }
}

fn cdfs_end_frame(st: *mut CdfState, disable_frame_end_update: bool) {
    if disable_frame_end_update {
        return
    }
    cdf_clear_counters((*st).saved)
    cdf_copy((*st).frame, (*st).saved)
}

fn cdfs_save_slot(st: *mut CdfState, slot: usize) {
    if (*st).slots[slot] == 0 {
        (*st).slots[slot] = cdf_alloc()
    }
    cdf_copy((*st).slots[slot], (*st).frame)
}

fn cdfs_load_slot(st: *mut CdfState, slot: usize) -> bool {
    if (*st).slots[slot] == 0 {
        return false
    }
    cdf_copy((*st).frame, (*st).slots[slot])
    return true
}
