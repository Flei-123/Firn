import media.video.vp9.vp9mem
import media.video.av1.av1ipm
import media.video.av1.av1lrsrc

export { wiener_rect }

fn make_filter(unit: u64, base: i64, f: u64) {
    var sum: i64 = 0
    var i: i64 = 0
    while i < 3 {
        let c: i64 = av1lrsrc.lr_unit_val(unit, base + i)
        av1ipm.st64(f, i, c)
        av1ipm.st64(f, 6 - i, c)
        sum = sum + c
        i = i + 1
    }
    av1ipm.st64(f, 3, 128 - 2 * sum)
}

fn wiener_rect(c: *mut av1lrsrc.LrCtx, unit: u64, x: i64, y: i64, w: i64, h: i64) {
    let bd: i64 = (*c).bit_depth
    var round0: i64 = 3
    var round1: i64 = 11
    if bd == 12 {
        round0 = 5
        round1 = 9
    }
    let fb: u64 = vp9mem.alloc(112)
    make_filter(unit, 2, fb)
    make_filter(unit, 5, fb + 56)
    let tmp_n: usize = ((h + 6) * w) as usize * 8
    let tmp: u64 = vp9mem.alloc(tmp_n)
    let offset: i64 = 1 << ((bd + 7 - round0 - 1) as u64)
    let limit: i64 = (1 << ((bd + 8 - round0) as u64)) - 1
    var r: i64 = 0
    while r < h + 6 {
        var cc: i64 = 0
        while cc < w {
            var s: i64 = 0
            var t: i64 = 0
            while t < 7 {
                s = s + av1ipm.ld64(fb + 56, t) * av1lrsrc.lr_sample(c, x + cc + t - 3, y + r - 3)
                t = t + 1
            }
            var v: i64 = (s + (1 << ((round0 - 1) as u64))) >> (round0 as u64)
            v = av1ipm.imax(0 - offset, av1ipm.imin(limit - offset, v))
            av1ipm.st64(tmp, r * w + cc, v)
            cc = cc + 1
        }
        r = r + 1
    }
    let maxv: i64 = (1 << (bd as u64)) - 1
    let out: u64 = (*(*c).out).planes[(*c).plane as usize]
    r = 0
    while r < h {
        var cc: i64 = 0
        while cc < w {
            var s: i64 = 0
            var t: i64 = 0
            while t < 7 {
                s = s + av1ipm.ld64(fb, t) * av1ipm.ld64(tmp, (r + t) * w + cc)
                t = t + 1
            }
            let v: i64 = (s + (1 << ((round1 - 1) as u64))) >> (round1 as u64)
            av1ipm.st(out, (y + r) * (*c).stride + x + cc, av1ipm.imax(0, av1ipm.imin(maxv, v)))
            cc = cc + 1
        }
        r = r + 1
    }
    vp9mem.free(tmp, tmp_n)
    vp9mem.free(fb, 112)
}
