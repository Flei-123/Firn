import std.rt
import media.video.vp9.vp9mem
import media.video.av1.av1mem
import media.video.av1.av1ipm

export { Frame, frame_new, frame_retain, frame_release, frame_append }

struct Frame {
    planes: [u64; 3],
    strides: [i64; 3],
    rows: [i64; 3],
    num_planes: i64,
    bit_depth: i64,
    ss_x: i64,
    ss_y: i64,
    width: i64,
    height: i64,
    refs: i64,
}

fn align_up(v: i64, a: i64) -> i64 {
    return (v + a - 1) / a * a
}

fn frame_new(width: i64, height: i64, mi_cols: i64, mi_rows: i64, ss_x: i64, ss_y: i64, num_planes: i64, bit_depth: i64) -> *mut Frame {
    let f: *mut Frame = av1mem.av1_zalloc[Frame]()
    (*f).num_planes = num_planes
    (*f).bit_depth = bit_depth
    (*f).ss_x = ss_x
    (*f).ss_y = ss_y
    (*f).width = width
    (*f).height = height
    (*f).refs = 1
    let pw: i64 = align_up(mi_cols * 4, 128) + 64
    let ph: i64 = align_up(mi_rows * 4, 128) + 64
    var p: usize = 0
    while p < 3 {
        if (p as i64) < num_planes {
            var sx: i64 = 0
            var sy: i64 = 0
            if p > 0 {
                sx = ss_x
                sy = ss_y
            }
            (*f).strides[p] = pw >> (sx as u64)
            (*f).rows[p] = ph >> (sy as u64)
            let n: usize = ((*f).strides[p] * (*f).rows[p]) as usize * 2 + 64
            (*f).planes[p] = vp9mem.alloc(n)
            vp9mem.zero((*f).planes[p], n)
        }
        p = p + 1
    }
    return f
}

fn frame_destroy(f: *mut Frame) {
    var p: usize = 0
    while p < 3 {
        if (*f).planes[p] != 0 {
            let n: usize = ((*f).strides[p] * (*f).rows[p]) as usize * 2 + 64
            vp9mem.free((*f).planes[p], n)
        }
        p = p + 1
    }
    av1mem.av1_zfree[Frame](f)
}

fn frame_retain(f: *mut Frame) -> *mut Frame {
    (*f).refs = (*f).refs + 1
    return f
}

fn frame_release(f: *mut Frame) {
    (*f).refs = (*f).refs - 1
    if (*f).refs <= 0 {
        frame_destroy(f)
    }
}

fn frame_append(f: *mut Frame, out: *mut rt.Buf) {
    var p: usize = 0
    while p < (*f).num_planes as usize {
        var w: i64 = (*f).width
        var h: i64 = (*f).height
        if p > 0 {
            w = (w + (*f).ss_x) >> ((*f).ss_x as u64)
            h = (h + (*f).ss_y) >> ((*f).ss_y as u64)
        }
        var y: i64 = 0
        while y < h {
            var x: i64 = 0
            while x < w {
                let v: i64 = av1ipm.ld((*f).planes[p], y * (*f).strides[p] + x)
                rt.buf_push(out, (v & 255) as u8)
                if (*f).bit_depth > 8 {
                    rt.buf_push(out, ((v >> 8) & 255) as u8)
                }
                x = x + 1
            }
            y = y + 1
        }
        p = p + 1
    }
}
