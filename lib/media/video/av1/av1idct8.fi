import media.video.av1.av1itxm

export { idct4, idct8 }

fn idct4(inp: u64, out: u64, stp: u64, r: i64) {
    av1itxm.si(out, 0, av1itxm.li(inp, 0))
    av1itxm.si(out, 1, av1itxm.li(inp, 2))
    av1itxm.si(out, 2, av1itxm.li(inp, 1))
    av1itxm.si(out, 3, av1itxm.li(inp, 3))
    av1itxm.si(stp, 0, av1itxm.btf(2896, av1itxm.li(out, 0), 2896, av1itxm.li(out, 1)))
    av1itxm.si(stp, 1, av1itxm.btf(2896, av1itxm.li(out, 0), -2896, av1itxm.li(out, 1)))
    av1itxm.si(stp, 2, av1itxm.btf(1567, av1itxm.li(out, 2), -3784, av1itxm.li(out, 3)))
    av1itxm.si(stp, 3, av1itxm.btf(3784, av1itxm.li(out, 2), 1567, av1itxm.li(out, 3)))
    av1itxm.si(out, 0, av1itxm.cl(av1itxm.li(stp, 0) + av1itxm.li(stp, 3), r))
    av1itxm.si(out, 1, av1itxm.cl(av1itxm.li(stp, 1) + av1itxm.li(stp, 2), r))
    av1itxm.si(out, 2, av1itxm.cl(av1itxm.li(stp, 1) - av1itxm.li(stp, 2), r))
    av1itxm.si(out, 3, av1itxm.cl(av1itxm.li(stp, 0) - av1itxm.li(stp, 3), r))
}

fn idct8(inp: u64, out: u64, stp: u64, r: i64) {
    av1itxm.si(out, 0, av1itxm.li(inp, 0))
    av1itxm.si(out, 1, av1itxm.li(inp, 4))
    av1itxm.si(out, 2, av1itxm.li(inp, 2))
    av1itxm.si(out, 3, av1itxm.li(inp, 6))
    av1itxm.si(out, 4, av1itxm.li(inp, 1))
    av1itxm.si(out, 5, av1itxm.li(inp, 5))
    av1itxm.si(out, 6, av1itxm.li(inp, 3))
    av1itxm.si(out, 7, av1itxm.li(inp, 7))
    av1itxm.si(stp, 0, av1itxm.li(out, 0))
    av1itxm.si(stp, 1, av1itxm.li(out, 1))
    av1itxm.si(stp, 2, av1itxm.li(out, 2))
    av1itxm.si(stp, 3, av1itxm.li(out, 3))
    av1itxm.si(stp, 4, av1itxm.btf(799, av1itxm.li(out, 4), -4017, av1itxm.li(out, 7)))
    av1itxm.si(stp, 5, av1itxm.btf(3406, av1itxm.li(out, 5), -2276, av1itxm.li(out, 6)))
    av1itxm.si(stp, 6, av1itxm.btf(2276, av1itxm.li(out, 5), 3406, av1itxm.li(out, 6)))
    av1itxm.si(stp, 7, av1itxm.btf(4017, av1itxm.li(out, 4), 799, av1itxm.li(out, 7)))
    av1itxm.si(out, 0, av1itxm.btf(2896, av1itxm.li(stp, 0), 2896, av1itxm.li(stp, 1)))
    av1itxm.si(out, 1, av1itxm.btf(2896, av1itxm.li(stp, 0), -2896, av1itxm.li(stp, 1)))
    av1itxm.si(out, 2, av1itxm.btf(1567, av1itxm.li(stp, 2), -3784, av1itxm.li(stp, 3)))
    av1itxm.si(out, 3, av1itxm.btf(3784, av1itxm.li(stp, 2), 1567, av1itxm.li(stp, 3)))
    av1itxm.si(out, 4, av1itxm.cl(av1itxm.li(stp, 4) + av1itxm.li(stp, 5), r))
    av1itxm.si(out, 5, av1itxm.cl(av1itxm.li(stp, 4) - av1itxm.li(stp, 5), r))
    av1itxm.si(out, 6, av1itxm.cl((0 - av1itxm.li(stp, 6)) + av1itxm.li(stp, 7), r))
    av1itxm.si(out, 7, av1itxm.cl(av1itxm.li(stp, 6) + av1itxm.li(stp, 7), r))
    av1itxm.si(stp, 0, av1itxm.cl(av1itxm.li(out, 0) + av1itxm.li(out, 3), r))
    av1itxm.si(stp, 1, av1itxm.cl(av1itxm.li(out, 1) + av1itxm.li(out, 2), r))
    av1itxm.si(stp, 2, av1itxm.cl(av1itxm.li(out, 1) - av1itxm.li(out, 2), r))
    av1itxm.si(stp, 3, av1itxm.cl(av1itxm.li(out, 0) - av1itxm.li(out, 3), r))
    av1itxm.si(stp, 4, av1itxm.li(out, 4))
    av1itxm.si(stp, 5, av1itxm.btf(-2896, av1itxm.li(out, 5), 2896, av1itxm.li(out, 6)))
    av1itxm.si(stp, 6, av1itxm.btf(2896, av1itxm.li(out, 5), 2896, av1itxm.li(out, 6)))
    av1itxm.si(stp, 7, av1itxm.li(out, 7))
    av1itxm.si(out, 0, av1itxm.cl(av1itxm.li(stp, 0) + av1itxm.li(stp, 7), r))
    av1itxm.si(out, 1, av1itxm.cl(av1itxm.li(stp, 1) + av1itxm.li(stp, 6), r))
    av1itxm.si(out, 2, av1itxm.cl(av1itxm.li(stp, 2) + av1itxm.li(stp, 5), r))
    av1itxm.si(out, 3, av1itxm.cl(av1itxm.li(stp, 3) + av1itxm.li(stp, 4), r))
    av1itxm.si(out, 4, av1itxm.cl(av1itxm.li(stp, 3) - av1itxm.li(stp, 4), r))
    av1itxm.si(out, 5, av1itxm.cl(av1itxm.li(stp, 2) - av1itxm.li(stp, 5), r))
    av1itxm.si(out, 6, av1itxm.cl(av1itxm.li(stp, 1) - av1itxm.li(stp, 6), r))
    av1itxm.si(out, 7, av1itxm.cl(av1itxm.li(stp, 0) - av1itxm.li(stp, 7), r))
}
