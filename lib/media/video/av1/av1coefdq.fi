import media.video.vp9.vp9mem
import media.video.av1.av1blkst
import media.video.av1.av1blkdat
import media.video.av1.av1fhdr
import media.video.av1.av1tabq
import media.video.av1.av1tabqm0
import media.video.av1.av1tabqm1
import media.video.av1.av1tabqm2

export { get_qidx, dc_quant, ac_quant, qm_addr, dq_value, dq_shift }

fn clip255(v: i64) -> i64 {
    if v < 0 {
        return 0
    }
    if v > 255 {
        return 255
    }
    return v
}

fn get_qidx(td: *mut av1blkst.TileDec, ignore_delta: bool) -> i64 {
    let fh: *mut av1fhdr.FrameHdr = (*td).fh
    let seg: i64 = (*td).segment_id
    let use_delta: bool = !ignore_delta && (*fh).delta_q_present == 1
    if (*fh).segmentation_enabled != 0 && (*fh).feature_enabled[(seg * 8) as usize] == 1 {
        let data: i64 = (*fh).feature_data[(seg * 8) as usize]
        var q: i64 = (*fh).base_q_idx + data
        if use_delta {
            q = (*td).cur_q + data
        }
        return clip255(q)
    }
    if use_delta {
        return (*td).cur_q
    }
    return (*fh).base_q_idx
}

fn bd_index(td: *mut av1blkst.TileDec) -> i64 {
    return ((*td).bit_depth - 8) >> 1
}

fn dc_quant(td: *mut av1blkst.TileDec, plane: i64) -> i64 {
    let fh: *mut av1fhdr.FrameHdr = (*td).fh
    var d: i64 = (*fh).delta_q_y_dc
    if plane == 1 {
        d = (*fh).delta_q_u_dc
    }
    if plane == 2 {
        d = (*fh).delta_q_v_dc
    }
    return vp9mem.ld16(av1tabq.dc_q_addr(bd_index(td)), clip255(get_qidx(td, false) + d) as usize)
}

fn ac_quant(td: *mut av1blkst.TileDec, plane: i64) -> i64 {
    let fh: *mut av1fhdr.FrameHdr = (*td).fh
    var d: i64 = 0
    if plane == 1 {
        d = (*fh).delta_q_u_ac
    }
    if plane == 2 {
        d = (*fh).delta_q_v_ac
    }
    return vp9mem.ld16(av1tabq.ac_q_addr(bd_index(td)), clip255(get_qidx(td, false) + d) as usize)
}

fn level_addr(level: i64) -> u64 {
    if level == 0 {
        return av1tabqm0.qm_level0_addr()
    }
    if level == 1 {
        return av1tabqm0.qm_level1_addr()
    }
    if level == 2 {
        return av1tabqm0.qm_level2_addr()
    }
    if level == 3 {
        return av1tabqm0.qm_level3_addr()
    }
    if level == 4 {
        return av1tabqm0.qm_level4_addr()
    }
    if level == 5 {
        return av1tabqm1.qm_level5_addr()
    }
    if level == 6 {
        return av1tabqm1.qm_level6_addr()
    }
    if level == 7 {
        return av1tabqm1.qm_level7_addr()
    }
    if level == 8 {
        return av1tabqm1.qm_level8_addr()
    }
    if level == 9 {
        return av1tabqm1.qm_level9_addr()
    }
    if level == 10 {
        return av1tabqm2.qm_level10_addr()
    }
    if level == 11 {
        return av1tabqm2.qm_level11_addr()
    }
    if level == 12 {
        return av1tabqm2.qm_level12_addr()
    }
    if level == 13 {
        return av1tabqm2.qm_level13_addr()
    }
    return av1tabqm2.qm_level14_addr()
}

fn qm_addr(td: *mut av1blkst.TileDec, plane: i64, tx_size: i64, tx_type: i64) -> u64 {
    let fh: *mut av1fhdr.FrameHdr = (*td).fh
    if (*fh).using_qmatrix == 0 || (*td).lossless != 0 || tx_type >= 9 {
        return 0
    }
    var level: i64 = (*fh).qm_y
    if plane == 1 {
        level = (*fh).qm_u
    }
    if plane == 2 {
        level = (*fh).qm_v
    }
    if level >= 15 {
        return 0
    }
    var base: u64 = level_addr(level)
    if plane > 0 {
        base = base + 3344
    }
    return base + av1blkdat.qm_offset(tx_size) as u64
}

fn dq_shift(tx_size: i64) -> i64 {
    let pels: i64 = av1blkdat.tx_w(tx_size) * av1blkdat.tx_h(tx_size)
    var s: i64 = 0
    if pels > 256 {
        s = 1
    }
    if pels > 1024 {
        s = 2
    }
    return s
}

fn dq_value(level: i64, neg: bool, pos: i64, dcq: i64, acq: i64, qm: u64, shift: i64, bit_depth: i64) -> i64 {
    var q: i64 = acq
    if pos == 0 {
        q = dcq
    }
    if qm != 0 {
        let m: i64 = vp9mem.ld8(qm, pos as usize)
        q = (m * q + 16) >> 5
    }
    var dq: i64 = (level * q) & 16777215
    dq = dq >> (shift as u64)
    if neg {
        dq = 0 - dq
    }
    let hi: i64 = (1 << ((7 + bit_depth) as u64)) - 1
    if dq > hi {
        return hi
    }
    if dq < 0 - hi - 1 {
        return 0 - hi - 1
    }
    return dq
}
