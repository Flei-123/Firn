import media.video.av1.av1blkst
import media.video.av1.av1blkdat
import media.video.av1.av1cdfidx
import media.video.av1.av1mvref

export { intrabc_mode_info }

const MV_INTRABC_CONTEXT: i64 = 1
const INTRABC_DELAY_PIXELS: i64 = 256

fn read_mv_component(td: *mut av1blkst.TileDec, ctx: i64, comp: i64) -> i64 {
    let sign: i64 = av1blkst.rd_sym(td, av1cdfidx.CDF_MV_SIGN + (ctx * 6 + comp * 3) as usize, 2)
    let cls: i64 = av1blkst.rd_sym(td, av1cdfidx.CDF_MV_CLASSES + (ctx * 24 + comp * 12) as usize, 11)
    var mag: i64 = 0
    if cls == 0 {
        let bit: i64 = av1blkst.rd_sym(td, av1cdfidx.CDF_MV_CLASS0 + (ctx * 6 + comp * 3) as usize, 2)
        mag = ((bit << 3) | 7) + 1
    } else {
        var d: i64 = 0
        var i: i64 = 0
        while i < cls {
            let bit: i64 = av1blkst.rd_sym(td, av1cdfidx.CDF_MV_BITS + (ctx * 60 + comp * 30 + i * 3) as usize, 2)
            d = d | (bit << (i as u64))
            i = i + 1
        }
        mag = (2 << ((cls + 2) as u64)) + ((d << 3) | 7) + 1
    }
    if sign == 1 {
        return 0 - mag
    }
    return mag
}

fn default_pred_mv(td: *mut av1blkst.TileDec) {
    var sb4: i64 = 16
    if (*td).sb128 != 0 {
        sb4 = 32
    }
    if (*td).mi_row - sb4 < (*td).mi_row_start {
        (*td).mv_row = 0
        (*td).mv_col = 0 - (sb4 * 4 + INTRABC_DELAY_PIXELS) * 8
    } else {
        (*td).mv_row = 0 - sb4 * 4 * 8
        (*td).mv_col = 0
    }
}

fn select_pred_mv(td: *mut av1blkst.TileDec) {
    (*td).mv_row = av1mvref.stack_row(td, 0)
    (*td).mv_col = av1mvref.stack_col(td, 0)
    if (*td).mv_row == 0 && (*td).mv_col == 0 {
        (*td).mv_row = av1mvref.stack_row(td, 1)
        (*td).mv_col = av1mvref.stack_col(td, 1)
    }
    if (*td).mv_row == 0 && (*td).mv_col == 0 {
        default_pred_mv(td)
    }
}

fn intrabc_mode_info(td: *mut av1blkst.TileDec) -> i64 {
    (*td).is_inter = 1
    (*td).y_mode = av1blkdat.DC_PRED
    (*td).uv_mode = av1blkdat.DC_PRED
    (*td).pal_size_y = 0
    (*td).pal_size_uv = 0
    (*td).cfl_u = 0
    (*td).cfl_v = 0
    (*td).angle_y = 0
    (*td).angle_uv = 0
    (*td).use_filter_intra = 0
    (*td).n_intrabc = (*td).n_intrabc + 1
    av1mvref.find_mv_stack(td)
    select_pred_mv(td)
    let joint: i64 = av1blkst.rd_sym(td, av1cdfidx.CDF_MV_JOINTS + (MV_INTRABC_CONTEXT * 5) as usize, 4)
    if joint == 2 || joint == 3 {
        (*td).mv_row = (*td).mv_row + read_mv_component(td, MV_INTRABC_CONTEXT, 0)
    }
    if joint == 1 || joint == 3 {
        (*td).mv_col = (*td).mv_col + read_mv_component(td, MV_INTRABC_CONTEXT, 1)
    }
    return av1blkst.TD_OK
}
