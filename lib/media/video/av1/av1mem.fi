import std.rt
import media.video.vp9.vp9mem

export { av1_zalloc, av1_zfree, av1_zero }

fn av1_zalloc[T]() -> *mut T {
    let n: usize = size_of[T]()
    let p: u64 = rt.heap_alloc(n)
    vp9mem.zero(p, n)
    return p as *mut T
}

fn av1_zfree[T](p: *mut T) {
    rt.heap_free(p as u64, size_of[T]())
}

fn av1_zero[T](p: *mut T) {
    vp9mem.zero(p as u64, size_of[T]())
}
