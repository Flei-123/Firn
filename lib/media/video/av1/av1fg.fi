// SPDX-License-Identifier: MPL-2.0
import media.video.av1.av1br
import media.video.av1.av1seq

export { FilmGrain, fg_reset, fg_parse }

struct FilmGrain {
    apply_grain: i64,
    grain_seed: i64,
    update_grain: i64,
    film_grain_params_ref_idx: i64,
    num_y_points: i64,
    point_y_value: [i64; 16],
    point_y_scaling: [i64; 16],
    chroma_scaling_from_luma: i64,
    num_cb_points: i64,
    point_cb_value: [i64; 16],
    point_cb_scaling: [i64; 16],
    num_cr_points: i64,
    point_cr_value: [i64; 16],
    point_cr_scaling: [i64; 16],
    grain_scaling_minus_8: i64,
    ar_coeff_lag: i64,
    ar_coeffs_y_plus_128: [i64; 24],
    ar_coeffs_cb_plus_128: [i64; 25],
    ar_coeffs_cr_plus_128: [i64; 25],
    ar_coeff_shift_minus_6: i64,
    grain_scale_shift: i64,
    cb_mult: i64,
    cb_luma_mult: i64,
    cb_offset: i64,
    cr_mult: i64,
    cr_luma_mult: i64,
    cr_offset: i64,
    overlap_flag: i64,
    clip_to_restricted_range: i64,
}

fn fg_reset(g: *mut FilmGrain) {
    (*g).apply_grain = 0
    (*g).grain_seed = 0
    (*g).update_grain = 0
    (*g).film_grain_params_ref_idx = 0
    (*g).num_y_points = 0
    (*g).chroma_scaling_from_luma = 0
    (*g).num_cb_points = 0
    (*g).num_cr_points = 0
    (*g).grain_scaling_minus_8 = 0
    (*g).ar_coeff_lag = 0
    (*g).ar_coeff_shift_minus_6 = 0
    (*g).grain_scale_shift = 0
    (*g).cb_mult = 0
    (*g).cb_luma_mult = 0
    (*g).cb_offset = 0
    (*g).cr_mult = 0
    (*g).cr_luma_mult = 0
    (*g).cr_offset = 0
    (*g).overlap_flag = 0
    (*g).clip_to_restricted_range = 0
    var i: usize = 0
    while i < 16 {
        (*g).point_y_value[i] = 0
        (*g).point_y_scaling[i] = 0
        (*g).point_cb_value[i] = 0
        (*g).point_cb_scaling[i] = 0
        (*g).point_cr_value[i] = 0
        (*g).point_cr_scaling[i] = 0
        i = i + 1
    }
    i = 0
    while i < 25 {
        if i < 24 {
            (*g).ar_coeffs_y_plus_128[i] = 0
        }
        (*g).ar_coeffs_cb_plus_128[i] = 0
        (*g).ar_coeffs_cr_plus_128[i] = 0
        i = i + 1
    }
}

fn fg_parse(r: *mut av1br.BR, g: *mut FilmGrain, s: *mut av1seq.SeqHdr, frame_type: i64, show_frame: i64, showable_frame: i64) -> i64 {
    if (*s).film_grain_params_present == 0 || (show_frame == 0 && showable_frame == 0) {
        fg_reset(g)
        return 0
    }
    (*g).apply_grain = av1br.rd_bit(r, "apply_grain")
    if (*g).apply_grain == 0 {
        fg_reset(g)
        return 0
    }
    (*g).grain_seed = av1br.rd(r, 16, "grain_seed")
    if frame_type == 1 {
        (*g).update_grain = av1br.rd_bit(r, "update_grain")
    } else {
        (*g).update_grain = 1
    }
    if (*g).update_grain == 0 {
        (*g).film_grain_params_ref_idx = av1br.rd(r, 3, "film_grain_params_ref_idx")
        return 1
    }
    (*g).num_y_points = av1br.rd(r, 4, "num_y_points")
    if (*g).num_y_points > 14 {
        return 0 - 1
    }
    var i: usize = 0
    while (i as i64) < (*g).num_y_points {
        (*g).point_y_value[i] = av1br.rd(r, 8, "point_y_value")
        (*g).point_y_scaling[i] = av1br.rd(r, 8, "point_y_scaling")
        i = i + 1
    }
    if (*s).mono_chrome == 1 {
        (*g).chroma_scaling_from_luma = 0
    } else {
        (*g).chroma_scaling_from_luma = av1br.rd_bit(r, "chroma_scaling_from_luma")
    }
    if (*s).mono_chrome == 1 || (*g).chroma_scaling_from_luma == 1 || ((*s).subsampling_x == 1 && (*s).subsampling_y == 1 && (*g).num_y_points == 0) {
        (*g).num_cb_points = 0
        (*g).num_cr_points = 0
    } else {
        (*g).num_cb_points = av1br.rd(r, 4, "num_cb_points")
        if (*g).num_cb_points > 10 {
            return 0 - 1
        }
        i = 0
        while (i as i64) < (*g).num_cb_points {
            (*g).point_cb_value[i] = av1br.rd(r, 8, "point_cb_value")
            (*g).point_cb_scaling[i] = av1br.rd(r, 8, "point_cb_scaling")
            i = i + 1
        }
        (*g).num_cr_points = av1br.rd(r, 4, "num_cr_points")
        if (*g).num_cr_points > 10 {
            return 0 - 1
        }
        i = 0
        while (i as i64) < (*g).num_cr_points {
            (*g).point_cr_value[i] = av1br.rd(r, 8, "point_cr_value")
            (*g).point_cr_scaling[i] = av1br.rd(r, 8, "point_cr_scaling")
            i = i + 1
        }
    }
    (*g).grain_scaling_minus_8 = av1br.rd(r, 2, "grain_scaling_minus_8")
    (*g).ar_coeff_lag = av1br.rd(r, 2, "ar_coeff_lag")
    let num_pos_luma: i64 = 2 * (*g).ar_coeff_lag * ((*g).ar_coeff_lag + 1)
    var num_pos_chroma: i64 = num_pos_luma
    if (*g).num_y_points > 0 {
        num_pos_chroma = num_pos_luma + 1
        i = 0
        while (i as i64) < num_pos_luma {
            (*g).ar_coeffs_y_plus_128[i] = av1br.rd(r, 8, "ar_coeffs_y_plus_128")
            i = i + 1
        }
    }
    if (*g).chroma_scaling_from_luma == 1 || (*g).num_cb_points > 0 {
        i = 0
        while (i as i64) < num_pos_chroma {
            (*g).ar_coeffs_cb_plus_128[i] = av1br.rd(r, 8, "ar_coeffs_cb_plus_128")
            i = i + 1
        }
    }
    if (*g).chroma_scaling_from_luma == 1 || (*g).num_cr_points > 0 {
        i = 0
        while (i as i64) < num_pos_chroma {
            (*g).ar_coeffs_cr_plus_128[i] = av1br.rd(r, 8, "ar_coeffs_cr_plus_128")
            i = i + 1
        }
    }
    (*g).ar_coeff_shift_minus_6 = av1br.rd(r, 2, "ar_coeff_shift_minus_6")
    (*g).grain_scale_shift = av1br.rd(r, 2, "grain_scale_shift")
    if (*g).num_cb_points > 0 {
        (*g).cb_mult = av1br.rd(r, 8, "cb_mult")
        (*g).cb_luma_mult = av1br.rd(r, 8, "cb_luma_mult")
        (*g).cb_offset = av1br.rd(r, 9, "cb_offset")
    }
    if (*g).num_cr_points > 0 {
        (*g).cr_mult = av1br.rd(r, 8, "cr_mult")
        (*g).cr_luma_mult = av1br.rd(r, 8, "cr_luma_mult")
        (*g).cr_offset = av1br.rd(r, 9, "cr_offset")
    }
    (*g).overlap_flag = av1br.rd_bit(r, "overlap_flag")
    (*g).clip_to_restricted_range = av1br.rd_bit(r, "clip_to_restricted_range")
    return 0
}
