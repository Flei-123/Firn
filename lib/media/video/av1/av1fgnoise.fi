// SPDX-License-Identifier: MPL-2.0
import media.video.av1.av1fg
import media.video.av1.av1fgsyn
import media.video.av1.av1ipm

export { stripe_gen, noise_at }

fn clip3(lo: i64, hi: i64, v: i64) -> i64 {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

fn blend5(lo: i64, hi: i64, a: i64, wa: i64, b: i64, wb: i64) -> i64 {
    return clip3(lo, hi, (a * wa + b * wb + 16) >> 5)
}

fn tpl_at(t: *mut av1fgsyn.GrainTpl, plane: i64, idx: i64) -> i64 {
    if plane == 0 {
        return (*t).luma[idx as usize]
    }
    if plane == 1 {
        return (*t).cb[idx as usize]
    }
    return (*t).cr[idx as usize]
}

fn write_block(t: *mut av1fgsyn.GrainTpl, overlap: bool, buf: u64, plane: i64, sx: i64, sy: i64, x: i64, off_x: i64, off_y: i64, sw: i64) {
    var tw: i64 = av1fgsyn.TPL_LUMA_W
    if plane > 0 {
        tw = (*t).chroma_w
    }
    var po_x: i64 = 9 + off_x * 2
    if sx == 1 {
        po_x = 6 + off_x
    }
    var po_y: i64 = 9 + off_y * 2
    if sy == 1 {
        po_y = 6 + off_y
    }
    let rows: i64 = 34 >> (sy as u64)
    let cols: i64 = 34 >> (sx as u64)
    let lo: i64 = (*t).grain_min
    let hi: i64 = (*t).grain_max
    var i: i64 = 0
    while i < rows {
        var j: i64 = 0
        while j < cols {
            var g: i64 = tpl_at(t, plane, (po_y + i) * tw + po_x + j)
            if sx == 0 {
                let at: i64 = i * sw + x * 2 + j
                if j < 2 && overlap && x > 0 {
                    let old: i64 = av1ipm.ld64(buf, at)
                    if j == 0 {
                        g = blend5(lo, hi, old, 27, g, 17)
                    } else {
                        g = blend5(lo, hi, old, 17, g, 27)
                    }
                }
                av1ipm.st64(buf, at, g)
            } else {
                let at: i64 = i * sw + x + j
                if j == 0 && overlap && x > 0 {
                    let old: i64 = av1ipm.ld64(buf, at)
                    g = blend5(lo, hi, old, 23, g, 22)
                }
                av1ipm.st64(buf, at, g)
            }
            j = j + 1
        }
        i = i + 1
    }
}

fn stripe_gen(t: *mut av1fgsyn.GrainTpl, g: *mut av1fg.FilmGrain, bufs: *mut [u64; 3], num_planes: i64, ssx: i64, ssy: i64, n: i64, width: i64, sw: i64) {
    (*t).rng = (*g).grain_seed
    (*t).rng = (*t).rng ^ (((n * 37 + 178) & 255) << 8)
    (*t).rng = (*t).rng ^ ((n * 173 + 105) & 255)
    var x: i64 = 0
    while x < (width + 1) / 2 {
        let r: i64 = av1fgsyn.grain_rand(t, 8)
        let off_x: i64 = r >> 4
        let off_y: i64 = r & 15
        var p: i64 = 0
        while p < num_planes {
            var sx: i64 = 0
            var sy: i64 = 0
            if p > 0 {
                sx = ssx
                sy = ssy
            }
            write_block(t, (*g).overlap_flag == 1, (*bufs)[p as usize], p, sx, sy, x, off_x, off_y, sw)
            p = p + 1
        }
        x = x + 16
    }
}

fn noise_at(t: *mut av1fgsyn.GrainTpl, g: *mut av1fg.FilmGrain, cur: u64, prev: u64, n: i64, i: i64, x: i64, sy: i64, sw: i64) -> i64 {
    let noise: i64 = av1ipm.ld64(cur, i * sw + x)
    if n == 0 || (*g).overlap_flag == 0 {
        return noise
    }
    let lo: i64 = (*t).grain_min
    let hi: i64 = (*t).grain_max
    if sy == 0 {
        if i < 2 {
            let old: i64 = av1ipm.ld64(prev, (i + 32) * sw + x)
            if i == 0 {
                return blend5(lo, hi, old, 27, noise, 17)
            }
            return blend5(lo, hi, old, 17, noise, 27)
        }
    } else {
        if i < 1 {
            let old: i64 = av1ipm.ld64(prev, (i + 16) * sw + x)
            return blend5(lo, hi, old, 23, noise, 22)
        }
    }
    return noise
}
