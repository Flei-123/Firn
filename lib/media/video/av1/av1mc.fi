import media.video.vp9.vp9mem
import media.video.av1.av1ipm
import media.video.av1.av1tabfilt

export { round2s, round2_signed, filter_type_index, scale_factor, start_pos, step_size, round0_of, round1_of, post_round_of, predict_block, SCRATCH_ELEMS, OUT_ELEMS }

const SCRATCH_ELEMS: i64 = 270 * 128
const OUT_ELEMS: i64 = 128 * 128

#[no_gc]
fn round2s(v: i64, n: i64) -> i64 {
    if n == 0 {
        return v
    }
    return (v + (1 << ((n - 1) as u64))) >> (n as u64)
}

#[no_gc]
fn round2_signed(v: i64, n: i64) -> i64 {
    if v >= 0 {
        return round2s(v, n)
    }
    return 0 - round2s(0 - v, n)
}

#[no_gc]
fn filter_type_index(t: i64, size: i64) -> i64 {
    if size <= 4 {
        if t == 0 || t == 2 {
            return 4
        }
        if t == 1 {
            return 5
        }
    }
    return t
}

#[no_gc]
fn scale_factor(ref_dim: i64, cur_dim: i64) -> i64 {
    return ((ref_dim << 14) + cur_dim / 2) / cur_dim
}

#[no_gc]
fn start_pos(pos: i64, mv: i64, sub: i64, scale: i64) -> i64 {
    let orig: i64 = (pos << 4) + ((2 * mv) >> (sub as u64)) + 8
    let base: i64 = orig * scale - (8 << 14)
    return round2_signed(base, 8) + 32
}

#[no_gc]
fn step_size(scale: i64) -> i64 {
    return round2_signed(scale, 4)
}

#[no_gc]
fn round0_of(bd: i64) -> i64 {
    if bd == 12 {
        return 5
    }
    return 3
}

#[no_gc]
fn round1_of(bd: i64, compound: i64) -> i64 {
    if compound != 0 {
        return 7
    }
    if bd == 12 {
        return 9
    }
    return 11
}

#[no_gc]
fn post_round_of(bd: i64) -> i64 {
    return 14 - round0_of(bd) - 7
}

#[no_gc]
fn clip_i(v: i64, hi: i64) -> i64 {
    if v < 0 {
        return 0
    }
    if v > hi {
        return hi
    }
    return v
}

fn predict_block(ref_buf: u64, stride: i64, last_x: i64, last_y: i64, start_x: i64, start_y: i64, step_x: i64, step_y: i64, w: i64, h: i64, ftx: i64, fty: i64, bd: i64, compound: i64, scratch: u64, out: u64) {
    let tab: u64 = av1tabfilt.subpel_filters_addr()
    let fxi: i64 = filter_type_index(ftx, w)
    let fyi: i64 = filter_type_index(fty, h)
    let round0: i64 = round0_of(bd)
    let round1: i64 = round1_of(bd, compound)
    let frac_y: i64 = start_y & 1023
    let inter_h: i64 = (((h - 1) * step_y + frac_y) >> 10) + 8
    let row0: i64 = (start_y >> 10) - 3
    var r: i64 = 0
    while r < inter_h {
        let yy: i64 = clip_i(row0 + r, last_y)
        let rbase: i64 = yy * stride
        var c: i64 = 0
        while c < w {
            let pos: i64 = start_x + step_x * c
            let ix: i64 = (pos >> 10) - 3
            let fb: i64 = (fxi * 16 + ((pos & 1023) >> 6)) * 8
            var sum: i64 = 0
            var t: i64 = 0
            while t < 8 {
                sum = sum + vp9mem.ldi16(tab, (fb + t) as usize) * av1ipm.ld(ref_buf, rbase + clip_i(ix + t, last_x))
                t = t + 1
            }
            av1ipm.st64(scratch, r * w + c, round2s(sum, round0))
            c = c + 1
        }
        r = r + 1
    }
    r = 0
    while r < h {
        let yp: i64 = frac_y + step_y * r
        let ib: i64 = yp >> 10
        let fb: i64 = (fyi * 16 + ((yp & 1023) >> 6)) * 8
        var c: i64 = 0
        while c < w {
            var sum: i64 = 0
            var t: i64 = 0
            while t < 8 {
                sum = sum + vp9mem.ldi16(tab, (fb + t) as usize) * av1ipm.ld64(scratch, (ib + t) * w + c)
                t = t + 1
            }
            av1ipm.st64(out, r * w + c, round2s(sum, round1))
            c = c + 1
        }
        r = r + 1
    }
}
