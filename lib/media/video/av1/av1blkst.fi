import std.rt
import media.video.vp9.vp9mem
import media.video.av1.av1sym
import media.video.av1.av1seq
import media.video.av1.av1fhdr
import media.video.av1.av1mem

export {
    TileDec, TD_OK, TD_ERR, TD_UNSUPPORTED, td_new, td_free, td_setup_frame, td_noop_hook,
    ld, st, mi_get, mi_set, rd_sym,
}

const TD_OK: i64 = 0
const TD_ERR: i64 = 0 - 1
const TD_UNSUPPORTED: i64 = 0 - 2

struct TileDec {
    seq: *mut av1seq.SeqHdr,
    fh: *mut av1fhdr.FrameHdr,
    sym: av1sym.Sym,
    cdf: u64,
    err: i64,
    mi_rows: i64,
    mi_cols: i64,
    ss_x: i64,
    ss_y: i64,
    num_planes: i64,
    bit_depth: i64,
    sb128: i64,
    mi_row_start: i64,
    mi_row_end: i64,
    mi_col_start: i64,
    mi_col_end: i64,
    mi_size_a: u64,
    skip_a: u64,
    seg_a: u64,
    ymode_a: u64,
    inter_a: u64,
    txs_a: u64,
    paly_a: u64,
    paluv_a: u64,
    palc_a: u64,
    dlf_a: u64,
    lftx_a: u64,
    txtype_a: u64,
    cdef_a: u64,
    cdef_stride: i64,
    mi_count: i64,
    above_level: [u64; 3],
    above_dc: [u64; 3],
    left_level: [u64; 3],
    left_dc: [u64; 3],
    cur_q: i64,
    delta_lf: [i64; 4],
    read_deltas: i64,
    ref_sgr: [i64; 6],
    ref_wiener: [i64; 18],
    lr_units: [u64; 3],
    lr_rows: [i64; 3],
    lr_cols: [i64; 3],
    mi_row: i64,
    mi_col: i64,
    mi_size: i64,
    bw4: i64,
    bh4: i64,
    has_chroma: i64,
    avail_u: i64,
    avail_l: i64,
    avail_uc: i64,
    avail_lc: i64,
    skip: i64,
    segment_id: i64,
    lossless: i64,
    is_inter: i64,
    use_intrabc: i64,
    y_mode: i64,
    uv_mode: i64,
    angle_y: i64,
    angle_uv: i64,
    cfl_u: i64,
    cfl_v: i64,
    pal_size_y: i64,
    pal_size_uv: i64,
    pal_y: [i64; 8],
    pal_u: [i64; 8],
    pal_v: [i64; 8],
    use_filter_intra: i64,
    filter_intra_mode: i64,
    tx_size: i64,
    cdef_idx_cur: i64,
    map_y: u64,
    map_uv: u64,
    map_uv_stride: i64,
    quant: u64,
    dequant: u64,
    qm_level: i64,
    ev_plane: i64,
    ev_x: i64,
    ev_y: i64,
    ev_tx_size: i64,
    ev_tx_type: i64,
    ev_eob: i64,
    ev_palette: i64,
    ev_tw: i64,
    ev_th: i64,
    ev_x4: i64,
    ev_y4: i64,
    hook_ctx: u64,
    hook_tx: fn(u64, u64),
    n_blocks: i64,
    n_tx: i64,
    n_coefs: i64,
    n_palette: i64,
    n_cfl: i64,
    n_filter_intra: i64,
    n_skip: i64,
    n_eob_sum: i64,
    n_lr: i64,
}

fn td_noop_hook(ctx: u64, td: u64) {
}

fn td_new() -> *mut TileDec {
    let td: *mut TileDec = av1mem.av1_zalloc[TileDec]()
    (*td).hook_tx = td_noop_hook
    (*td).sym = av1sym.sym_new()
    (*td).quant = vp9mem.alloc(1024 * 4 + 64)
    (*td).dequant = vp9mem.alloc(1024 * 4 + 64)
    (*td).map_y = vp9mem.alloc(128 * 128)
    (*td).map_uv = vp9mem.alloc(128 * 128)
    return td
}

fn free_arrays(td: *mut TileDec) {
    let n: usize = (*td).mi_count as usize
    if (*td).mi_size_a != 0 {
        vp9mem.free((*td).mi_size_a, n)
        vp9mem.free((*td).skip_a, n)
        vp9mem.free((*td).seg_a, n)
        vp9mem.free((*td).ymode_a, n)
        vp9mem.free((*td).inter_a, n)
        vp9mem.free((*td).txs_a, n)
        vp9mem.free((*td).paly_a, n)
        vp9mem.free((*td).paluv_a, n)
        vp9mem.free((*td).dlf_a, n * 4)
        vp9mem.free((*td).lftx_a, n * 3)
        vp9mem.free((*td).txtype_a, n)
        vp9mem.free((*td).cdef_a, (*td).cdef_stride as usize * 64)
        var p: usize = 0
        while p < 3 {
            vp9mem.free((*td).above_level[p], ((*td).mi_cols + 64) as usize)
            vp9mem.free((*td).above_dc[p], ((*td).mi_cols + 64) as usize)
            vp9mem.free((*td).left_level[p], ((*td).mi_rows + 64) as usize)
            vp9mem.free((*td).left_dc[p], ((*td).mi_rows + 64) as usize)
            vp9mem.free((*td).lr_units[p], ((*td).lr_rows[p] * (*td).lr_cols[p]) as usize * 40)
            p = p + 1
        }
    }
    if (*td).palc_a != 0 {
        vp9mem.free((*td).palc_a, n * 32)
        (*td).palc_a = 0
    }
    (*td).mi_size_a = 0
}

fn td_free(td: *mut TileDec) {
    free_arrays(td)
    vp9mem.free((*td).quant, 1024 * 4 + 64)
    vp9mem.free((*td).dequant, 1024 * 4 + 64)
    vp9mem.free((*td).map_y, 128 * 128)
    vp9mem.free((*td).map_uv, 128 * 128)
    av1mem.av1_zfree[TileDec](td)
}

fn count_units(unit: i64, size: i64) -> i64 {
    var n: i64 = (size + (unit >> 1)) / unit
    if n < 1 {
        n = 1
    }
    return n
}

fn td_setup_frame(td: *mut TileDec, seq: *mut av1seq.SeqHdr, fh: *mut av1fhdr.FrameHdr) {
    free_arrays(td)
    (*td).seq = seq
    (*td).fh = fh
    (*td).mi_rows = (*fh).mi_rows
    (*td).mi_cols = (*fh).mi_cols
    (*td).ss_x = (*seq).subsampling_x
    (*td).ss_y = (*seq).subsampling_y
    (*td).num_planes = (*seq).num_planes
    (*td).bit_depth = (*seq).bit_depth
    (*td).sb128 = (*seq).use_128x128_superblock
    let n: i64 = (*td).mi_rows * (*td).mi_cols
    (*td).mi_count = n
    let nu: usize = n as usize
    (*td).mi_size_a = vp9mem.alloc(nu)
    (*td).skip_a = vp9mem.alloc(nu)
    (*td).seg_a = vp9mem.alloc(nu)
    (*td).ymode_a = vp9mem.alloc(nu)
    (*td).inter_a = vp9mem.alloc(nu)
    (*td).txs_a = vp9mem.alloc(nu)
    (*td).paly_a = vp9mem.alloc(nu)
    (*td).paluv_a = vp9mem.alloc(nu)
    (*td).dlf_a = vp9mem.alloc(nu * 4)
    (*td).lftx_a = vp9mem.alloc(nu * 3)
    (*td).txtype_a = vp9mem.alloc(nu)
    vp9mem.zero((*td).mi_size_a, nu)
    vp9mem.zero((*td).skip_a, nu)
    vp9mem.zero((*td).seg_a, nu)
    vp9mem.zero((*td).ymode_a, nu)
    vp9mem.zero((*td).inter_a, nu)
    vp9mem.zero((*td).txs_a, nu)
    vp9mem.zero((*td).paly_a, nu)
    vp9mem.zero((*td).paluv_a, nu)
    vp9mem.zero((*td).dlf_a, nu * 4)
    vp9mem.zero((*td).lftx_a, nu * 3)
    vp9mem.zero((*td).txtype_a, nu)
    (*td).cdef_stride = (*td).mi_cols / 16 + 4
    let cn: usize = (*td).cdef_stride as usize * 64
    (*td).cdef_a = vp9mem.alloc(cn)
    vp9mem.zero((*td).cdef_a, cn)
    if (*fh).allow_screen_content_tools != 0 {
        (*td).palc_a = vp9mem.alloc(nu * 32)
        vp9mem.zero((*td).palc_a, nu * 32)
    }
    var p: usize = 0
    while p < 3 {
        (*td).above_level[p] = vp9mem.alloc(((*td).mi_cols + 64) as usize)
        (*td).above_dc[p] = vp9mem.alloc(((*td).mi_cols + 64) as usize)
        (*td).left_level[p] = vp9mem.alloc(((*td).mi_rows + 64) as usize)
        (*td).left_dc[p] = vp9mem.alloc(((*td).mi_rows + 64) as usize)
        var sx: i64 = 0
        var sy: i64 = 0
        if p > 0 {
            sx = (*td).ss_x
            sy = (*td).ss_y
        }
        var rows: i64 = 0
        var cols: i64 = 0
        (*td).lr_rows[p] = 1
        (*td).lr_cols[p] = 1
        if (*fh).frame_restoration_type[p] != 0 && (p as i64) < (*td).num_planes {
            let unit: i64 = (*fh).loop_restoration_size[p]
            rows = count_units(unit, ((*fh).frame_height + sy) >> (sy as u64))
            cols = count_units(unit, ((*fh).upscaled_width + sx) >> (sx as u64))
            (*td).lr_rows[p] = rows
            (*td).lr_cols[p] = cols
        }
        let un: usize = ((*td).lr_rows[p] * (*td).lr_cols[p]) as usize * 40
        (*td).lr_units[p] = vp9mem.alloc(un)
        vp9mem.zero((*td).lr_units[p], un)
        p = p + 1
    }
}

#[no_gc]
fn ld(p: u64, i: i64) -> i64 {
    return (*((p + i as u64) as *mut u8)) as i64
}

#[no_gc]
fn st(p: u64, i: i64, v: i64) {
    *((p + i as u64) as *mut u8) = (v & 255) as u8
}

fn mi_get(td: *mut TileDec, arr: u64, row: i64, col: i64) -> i64 {
    return ld(arr, row * (*td).mi_cols + col)
}

fn mi_set(td: *mut TileDec, arr: u64, row: i64, col: i64, v: i64) {
    st(arr, row * (*td).mi_cols + col, v)
}

fn rd_sym(td: *mut TileDec, off: usize, n: i64) -> i64 {
    var base: u64 = (*td).cdf
    base = base + (off * 2) as u64
    return av1sym.sym_read(&(*td).sym, base, n)
}
