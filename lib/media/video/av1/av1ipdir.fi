import media.video.av1.av1ipm
import media.video.av1.av1tabintra

export { dr_pred, edge_strength, filter_edge, filter_corner, upsample_edge, use_upsample }

fn deriv(i: i64) -> i64 {
    let p: u64 = av1tabintra.dr_intra_derivative_addr()
    return (*((p + (i * 2) as u64) as *mut u16)) as i64
}

fn get_dx(angle: i64) -> i64 {
    if angle > 0 && angle < 90 {
        return deriv(angle)
    }
    return deriv(180 - angle)
}

fn get_dy(angle: i64) -> i64 {
    if angle > 90 && angle < 180 {
        return deriv(angle - 90)
    }
    return deriv(270 - angle)
}

fn z1(dst: u64, stride: i64, bw: i64, bh: i64, above: u64, up: i64, dx: i64) {
    let max_base_x: i64 = ((bw + bh) - 1) << (up as u64)
    let frac_bits: i64 = 6 - up
    let base_inc: i64 = 1 << (up as u64)
    var x: i64 = dx
    var r: i64 = 0
    while r < bh {
        var base: i64 = x >> (frac_bits as u64)
        let shift: i64 = ((x << (up as u64)) & 63) >> 1
        if base >= max_base_x {
            var i: i64 = r
            while i < bh {
                av1ipm.fill_px(dst, i * stride, bw, av1ipm.ld(above, max_base_x))
                i = i + 1
            }
            return
        }
        var c: i64 = 0
        while c < bw {
            if base < max_base_x {
                let val: i64 = av1ipm.ld(above, base) * (32 - shift) + av1ipm.ld(above, base + 1) * shift
                av1ipm.st(dst, r * stride + c, (val + 16) >> 5)
            } else {
                av1ipm.st(dst, r * stride + c, av1ipm.ld(above, max_base_x))
            }
            base = base + base_inc
            c = c + 1
        }
        x = x + dx
        r = r + 1
    }
}

fn z2(dst: u64, stride: i64, bw: i64, bh: i64, above: u64, left: u64, upa: i64, upl: i64, dx: i64, dy: i64) {
    let min_base_x: i64 = 0 - (1 << (upa as u64))
    let frac_x: i64 = 6 - upa
    let frac_y: i64 = 6 - upl
    var r: i64 = 0
    while r < bh {
        var c: i64 = 0
        while c < bw {
            var val: i64 = 0
            let y0: i64 = r + 1
            let x0: i64 = (c << 6) - y0 * dx
            let base_x: i64 = x0 >> (frac_x as u64)
            if base_x >= min_base_x {
                let shift: i64 = ((x0 * (1 << (upa as u64))) & 63) >> 1
                val = av1ipm.ld(above, base_x) * (32 - shift) + av1ipm.ld(above, base_x + 1) * shift
            } else {
                let x1: i64 = c + 1
                let y1: i64 = (r << 6) - x1 * dy
                let base_y: i64 = y1 >> (frac_y as u64)
                let shift: i64 = ((y1 * (1 << (upl as u64))) & 63) >> 1
                val = av1ipm.ld(left, base_y) * (32 - shift) + av1ipm.ld(left, base_y + 1) * shift
            }
            av1ipm.st(dst, r * stride + c, (val + 16) >> 5)
            c = c + 1
        }
        r = r + 1
    }
}

fn z3(dst: u64, stride: i64, bw: i64, bh: i64, left: u64, up: i64, dy: i64) {
    let max_base_y: i64 = (bw + bh - 1) << (up as u64)
    let frac_bits: i64 = 6 - up
    let base_inc: i64 = 1 << (up as u64)
    var y: i64 = dy
    var c: i64 = 0
    while c < bw {
        var base: i64 = y >> (frac_bits as u64)
        let shift: i64 = ((y << (up as u64)) & 63) >> 1
        var r: i64 = 0
        while r < bh {
            if base < max_base_y {
                let val: i64 = av1ipm.ld(left, base) * (32 - shift) + av1ipm.ld(left, base + 1) * shift
                av1ipm.st(dst, r * stride + c, (val + 16) >> 5)
            } else {
                while r < bh {
                    av1ipm.st(dst, r * stride + c, av1ipm.ld(left, max_base_y))
                    r = r + 1
                }
                break
            }
            base = base + base_inc
            r = r + 1
        }
        y = y + dy
        c = c + 1
    }
}

fn dr_pred(dst: u64, stride: i64, bw: i64, bh: i64, above: u64, left: u64, upa: i64, upl: i64, angle: i64) {
    if angle > 0 && angle < 90 {
        z1(dst, stride, bw, bh, above, upa, get_dx(angle))
        return
    }
    if angle > 90 && angle < 180 {
        z2(dst, stride, bw, bh, above, left, upa, upl, get_dx(angle), get_dy(angle))
        return
    }
    z3(dst, stride, bw, bh, left, upl, get_dy(angle))
}

fn edge_strength(bs0: i64, bs1: i64, delta: i64, kind: i64) -> i64 {
    let d: i64 = av1ipm.iabs(delta)
    let wh: i64 = bs0 + bs1
    var s: i64 = 0
    if kind == 0 {
        if wh <= 8 {
            if d >= 56 {
                s = 1
            }
        } else {
            if wh <= 16 {
                if d >= 40 {
                    s = 1
                }
            } else {
                if wh <= 24 {
                    if d >= 8 {
                        s = 1
                    }
                    if d >= 16 {
                        s = 2
                    }
                    if d >= 32 {
                        s = 3
                    }
                } else {
                    if wh <= 32 {
                        if d >= 1 {
                            s = 1
                        }
                        if d >= 4 {
                            s = 2
                        }
                        if d >= 32 {
                            s = 3
                        }
                    } else {
                        if d >= 1 {
                            s = 3
                        }
                    }
                }
            }
        }
    } else {
        if wh <= 8 {
            if d >= 40 {
                s = 1
            }
            if d >= 64 {
                s = 2
            }
        } else {
            if wh <= 16 {
                if d >= 20 {
                    s = 1
                }
                if d >= 48 {
                    s = 2
                }
            } else {
                if wh <= 24 {
                    if d >= 4 {
                        s = 3
                    }
                } else {
                    if d >= 1 {
                        s = 3
                    }
                }
            }
        }
    }
    return s
}

fn kernel(filt: i64, j: i64) -> i64 {
    if filt == 0 {
        if j == 1 || j == 3 {
            return 4
        }
        if j == 2 {
            return 8
        }
        return 0
    }
    if filt == 1 {
        if j == 1 || j == 3 {
            return 5
        }
        if j == 2 {
            return 6
        }
        return 0
    }
    if j == 0 || j == 4 {
        return 2
    }
    return 4
}

fn filter_edge(p: u64, sz: i64, strength: i64, tmp: u64) {
    if strength == 0 {
        return
    }
    let filt: i64 = strength - 1
    var i: i64 = 0
    while i < sz {
        av1ipm.st(tmp, i, av1ipm.ld(p, i))
        i = i + 1
    }
    i = 1
    while i < sz {
        var s: i64 = 0
        var j: i64 = 0
        while j < 5 {
            var k: i64 = i - 2 + j
            if k < 0 {
                k = 0
            }
            if k > sz - 1 {
                k = sz - 1
            }
            s = s + av1ipm.ld(tmp, k) * kernel(filt, j)
            j = j + 1
        }
        av1ipm.st(p, i, (s + 8) >> 4)
        i = i + 1
    }
}

fn filter_corner(above: u64, left: u64) {
    let s: i64 = (av1ipm.ld(left, 0) * 5 + av1ipm.ld(above, 0 - 1) * 6 + av1ipm.ld(above, 0) * 5 + 8) >> 4
    av1ipm.st(above, 0 - 1, s)
    av1ipm.st(left, 0 - 1, s)
}

fn upsample_edge(p: u64, sz: i64, bd: i64, tmp: u64) {
    av1ipm.st(tmp, 0, av1ipm.ld(p, 0 - 1))
    av1ipm.st(tmp, 1, av1ipm.ld(p, 0 - 1))
    var i: i64 = 0
    while i < sz {
        av1ipm.st(tmp, i + 2, av1ipm.ld(p, i))
        i = i + 1
    }
    av1ipm.st(tmp, sz + 2, av1ipm.ld(p, sz - 1))
    av1ipm.st(p, 0 - 2, av1ipm.ld(tmp, 0))
    i = 0
    while i < sz {
        var s: i64 = 0 - av1ipm.ld(tmp, i) + 9 * av1ipm.ld(tmp, i + 1) + 9 * av1ipm.ld(tmp, i + 2) - av1ipm.ld(tmp, i + 3)
        s = av1ipm.clip_px((s + 8) >> 4, bd)
        av1ipm.st(p, 2 * i - 1, s)
        av1ipm.st(p, 2 * i, av1ipm.ld(tmp, i + 2))
        i = i + 1
    }
}

fn use_upsample(bs0: i64, bs1: i64, delta: i64, kind: i64) -> bool {
    let d: i64 = av1ipm.iabs(delta)
    let wh: i64 = bs0 + bs1
    if d == 0 || d >= 40 {
        return false
    }
    if kind == 1 {
        return wh <= 8
    }
    return wh <= 16
}
