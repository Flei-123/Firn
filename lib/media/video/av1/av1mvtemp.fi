import media.video.av1.av1blkst
import media.video.av1.av1fhdr
import media.video.av1.av1mfmv
import media.video.av1.av1mvmi
import media.video.av1.av1mvglob

export { temporal_process, add_tpl_ref_mv }

fn absv(v: i64) -> i64 {
    if v < 0 {
        return 0 - v
    }
    return v
}

fn add_tpl_ref_mv(td: *mut av1blkst.TileDec, ms: *mut [i64; 24], delta_row: i64, delta_col: i64) {
    let mv_row: i64 = ((*td).mi_row + delta_row) | 1
    let mv_col: i64 = ((*td).mi_col + delta_col) | 1
    if !av1mvmi.is_inside(td, mv_row, mv_col) {
        return
    }
    let x8: i64 = mv_col >> 1
    let y8: i64 = mv_row >> 1
    let origin: bool = delta_row == 0 && delta_col == 0
    if origin {
        (*ms)[av1mvmi.SC_ZERO] = 1
    }
    let m: *mut av1mfmv.MotionField = (*td).mfld as *mut av1mfmv.MotionField
    let compound: bool = av1mvmi.td_compound(td)
    let rf0: i64 = (*td).ref_frame[0]
    if av1mfmv.mfld_at(m, rf0, y8, x8, 0) == av1mfmv.MFLD_INVALID {
        return
    }
    let fh: *mut av1fhdr.FrameHdr = (*td).fh
    let r0: i64 = av1mvglob.lower_comp(fh, av1mfmv.mfld_at(m, rf0, y8, x8, 0))
    let c0: i64 = av1mvglob.lower_comp(fh, av1mfmv.mfld_at(m, rf0, y8, x8, 1))
    var r1: i64 = 0
    var c1: i64 = 0
    if compound {
        let rf1: i64 = (*td).ref_frame[1]
        if av1mfmv.mfld_at(m, rf1, y8, x8, 0) == av1mfmv.MFLD_INVALID {
            return
        }
        r1 = av1mvglob.lower_comp(fh, av1mfmv.mfld_at(m, rf1, y8, x8, 0))
        c1 = av1mvglob.lower_comp(fh, av1mfmv.mfld_at(m, rf1, y8, x8, 1))
    }
    if origin {
        var far: bool = absv(r0 - (*td).global_mv[0]) >= 16 || absv(c0 - (*td).global_mv[1]) >= 16
        if compound {
            far = far || absv(r1 - (*td).global_mv[2]) >= 16 || absv(c1 - (*td).global_mv[3]) >= 16
        }
        if far {
            (*ms)[av1mvmi.SC_ZERO] = 1
        } else {
            (*ms)[av1mvmi.SC_ZERO] = 0
        }
    }
    av1mvmi.stack_add(td, compound, r0, c0, r1, c1, 2)
}

fn check_sb_border(td: *mut av1blkst.TileDec, delta_row: i64, delta_col: i64) -> bool {
    let row: i64 = ((*td).mi_row & 15) + delta_row
    let col: i64 = ((*td).mi_col & 15) + delta_col
    return row >= 0 && row < 16 && col >= 0 && col < 16
}

fn temporal_process(td: *mut av1blkst.TileDec, ms: *mut [i64; 24]) {
    let bw4: i64 = (*td).bw4
    let bh4: i64 = (*td).bh4
    var step_w: i64 = 2
    if bw4 >= 16 {
        step_w = 4
    }
    var step_h: i64 = 2
    if bh4 >= 16 {
        step_h = 4
    }
    var lim_h: i64 = bh4
    if lim_h > 16 {
        lim_h = 16
    }
    var lim_w: i64 = bw4
    if lim_w > 16 {
        lim_w = 16
    }
    var dr: i64 = 0
    while dr < lim_h {
        var dc: i64 = 0
        while dc < lim_w {
            add_tpl_ref_mv(td, ms, dr, dc)
            dc = dc + step_w
        }
        dr = dr + step_h
    }
    if bh4 >= 2 && bh4 < 16 && bw4 >= 2 && bw4 < 16 {
        if check_sb_border(td, bh4, 0 - 2) {
            add_tpl_ref_mv(td, ms, bh4, 0 - 2)
        }
        if check_sb_border(td, bh4, bw4) {
            add_tpl_ref_mv(td, ms, bh4, bw4)
        }
        if check_sb_border(td, bh4 - 2, bw4) {
            add_tpl_ref_mv(td, ms, bh4 - 2, bw4)
        }
    }
}
