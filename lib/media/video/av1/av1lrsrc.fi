import media.video.av1.av1frame
import media.video.av1.av1ipm

export { LrCtx, lr_sample, lr_unit_val }

struct LrCtx {
    cdef: *mut av1frame.Frame,
    pre: *mut av1frame.Frame,
    out: *mut av1frame.Frame,
    plane: i64,
    stride: i64,
    end_x: i64,
    end_y: i64,
    stripe_start: i64,
    stripe_end: i64,
    bit_depth: i64,
}

fn lr_sample(c: *mut LrCtx, x0: i64, y0: i64) -> i64 {
    var x: i64 = x0
    var y: i64 = y0
    if x > (*c).end_x {
        x = (*c).end_x
    }
    if x < 0 {
        x = 0
    }
    if y > (*c).end_y {
        y = (*c).end_y
    }
    if y < 0 {
        y = 0
    }
    let p: usize = (*c).plane as usize
    if y < (*c).stripe_start {
        y = av1ipm.imax((*c).stripe_start - 2, y)
        return av1ipm.ld((*(*c).pre).planes[p], y * (*c).stride + x)
    }
    if y > (*c).stripe_end {
        y = av1ipm.imin((*c).stripe_end + 2, y)
        return av1ipm.ld((*(*c).pre).planes[p], y * (*c).stride + x)
    }
    return av1ipm.ld((*(*c).cdef).planes[p], y * (*c).stride + x)
}

fn lr_unit_val(unit: u64, k: i64) -> i64 {
    var v: i64 = (*((unit + k as u64) as *mut u8)) as i64
    if v > 127 {
        v = v - 256
    }
    return v
}
