import media.video.av1.av1fhdr
import media.video.av1.av1frame

export { refs_valid }

fn refs_valid(slots: *mut [u64; 8], fh: *mut av1fhdr.FrameHdr, cur: *mut av1frame.Frame) -> bool {
    var k: i64 = 0
    while k < 7 {
        let rf: u64 = (*slots)[(*fh).ref_frame_idx[k as usize] as usize]
        if rf == 0 {
            return false
        }
        let r: *mut av1frame.Frame = rf as *mut av1frame.Frame
        if (*r).bit_depth != (*cur).bit_depth || (*r).ss_x != (*cur).ss_x || (*r).ss_y != (*cur).ss_y || (*r).num_planes != (*cur).num_planes {
            return false
        }
        if 2 * (*fh).frame_width < (*r).width || 2 * (*fh).frame_height < (*r).height {
            return false
        }
        if (*fh).frame_width > 16 * (*r).width || (*fh).frame_height > 16 * (*r).height {
            return false
        }
        k = k + 1
    }
    return true
}
