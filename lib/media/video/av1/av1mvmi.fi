// SPDX-License-Identifier: MPL-2.0
import media.video.vp9.vp9mem
import media.video.av1.av1blkst

export {
    MAX_STACK, SC_FOUND, SC_NEW, SC_ZERO, SC_ID_COUNT, SC_DIFF_COUNT, SC_ID_MVS, SC_DIFF_MVS, SC_SIZE,
    ref_get, ref_set, mv_get, mv_set, store_mi_mv, stack_row, stack_col, stack_row1, stack_col1,
    stack_find, stack_add, td_compound, is_inside,
}

const MAX_STACK: i64 = 8
const SC_FOUND: usize = 0
const SC_NEW: usize = 1
const SC_ZERO: usize = 2
const SC_ID_COUNT: usize = 4
const SC_DIFF_COUNT: usize = 6
const SC_ID_MVS: usize = 8
const SC_DIFF_MVS: usize = 16
const SC_SIZE: usize = 24

fn ref_get(td: *mut av1blkst.TileDec, row: i64, col: i64, list: i64) -> i64 {
    let v: i64 = vp9mem.ld8((*td).ref_a, ((row * (*td).mi_cols + col) * 2 + list) as usize)
    if v >= 128 {
        return v - 256
    }
    return v
}

fn ref_set(td: *mut av1blkst.TileDec, row: i64, col: i64, list: i64, v: i64) {
    vp9mem.st8((*td).ref_a, ((row * (*td).mi_cols + col) * 2 + list) as usize, v & 255)
}

fn mv_get(td: *mut av1blkst.TileDec, row: i64, col: i64, list: i64, comp: i64) -> i64 {
    return vp9mem.ldi16((*td).mv_a, ((row * (*td).mi_cols + col) * 4 + list * 2 + comp) as usize)
}

fn mv_set(td: *mut av1blkst.TileDec, row: i64, col: i64, list: i64, comp: i64, v: i64) {
    vp9mem.sti16((*td).mv_a, ((row * (*td).mi_cols + col) * 4 + list * 2 + comp) as usize, v)
}

fn store_mi_mv(td: *mut av1blkst.TileDec, row: i64, col: i64) {
    var r0: i64 = 0
    var c0: i64 = 0
    var r1: i64 = 0
    var c1: i64 = 0
    var f0: i64 = 0
    var f1: i64 = 0 - 1
    if (*td).use_intrabc != 0 {
        r0 = (*td).mv_row
        c0 = (*td).mv_col
    } else if (*td).is_inter != 0 {
        r0 = (*td).mvs[0]
        c0 = (*td).mvs[1]
        r1 = (*td).mvs[2]
        c1 = (*td).mvs[3]
        f0 = (*td).ref_frame[0]
        f1 = (*td).ref_frame[1]
    }
    mv_set(td, row, col, 0, 0, r0)
    mv_set(td, row, col, 0, 1, c0)
    mv_set(td, row, col, 1, 0, r1)
    mv_set(td, row, col, 1, 1, c1)
    ref_set(td, row, col, 0, f0)
    ref_set(td, row, col, 1, f1)
    av1blkst.st((*td).wr_a, row * (*td).mi_cols + col, 1)
}

fn stack_row(td: *mut av1blkst.TileDec, idx: i64) -> i64 {
    return (*td).stack_mv[(idx * 4) as usize]
}

fn stack_col(td: *mut av1blkst.TileDec, idx: i64) -> i64 {
    return (*td).stack_mv[(idx * 4 + 1) as usize]
}

fn stack_row1(td: *mut av1blkst.TileDec, idx: i64) -> i64 {
    return (*td).stack_mv[(idx * 4 + 2) as usize]
}

fn stack_col1(td: *mut av1blkst.TileDec, idx: i64) -> i64 {
    return (*td).stack_mv[(idx * 4 + 3) as usize]
}

fn td_compound(td: *mut av1blkst.TileDec) -> bool {
    return (*td).ref_frame[1] > 0
}

fn is_inside(td: *mut av1blkst.TileDec, r: i64, c: i64) -> bool {
    return c >= (*td).mi_col_start && c < (*td).mi_col_end && r >= (*td).mi_row_start && r < (*td).mi_row_end
}

fn stack_find(td: *mut av1blkst.TileDec, compound: bool, r0: i64, c0: i64, r1: i64, c1: i64) -> i64 {
    var idx: i64 = 0
    while idx < (*td).num_mv_found {
        if stack_row(td, idx) == r0 && stack_col(td, idx) == c0 {
            if !compound || (stack_row1(td, idx) == r1 && stack_col1(td, idx) == c1) {
                return idx
            }
        }
        idx = idx + 1
    }
    return 0 - 1
}

fn stack_add(td: *mut av1blkst.TileDec, compound: bool, r0: i64, c0: i64, r1: i64, c1: i64, weight: i64) {
    let idx: i64 = stack_find(td, compound, r0, c0, r1, c1)
    if idx >= 0 {
        (*td).stack_w[idx as usize] = (*td).stack_w[idx as usize] + weight
    } else if (*td).num_mv_found < MAX_STACK {
        let n: i64 = (*td).num_mv_found
        (*td).stack_mv[(n * 4) as usize] = r0
        (*td).stack_mv[(n * 4 + 1) as usize] = c0
        (*td).stack_mv[(n * 4 + 2) as usize] = r1
        (*td).stack_mv[(n * 4 + 3) as usize] = c1
        (*td).stack_w[n as usize] = weight
        (*td).num_mv_found = n + 1
    }
}
