import media.video.av1.av1blkst
import media.video.av1.av1fhdr
import media.video.av1.av1frame
import media.video.av1.av1ipm
import media.video.av1.av1lr
import media.video.av1.av1lrsrc
import media.video.av1.av1lrw
import media.video.av1.av1lrsgr

export { lr_frame }

fn run_rect(c: *mut av1lrsrc.LrCtx, unit: u64, x: i64, y: i64, w: i64, h: i64) {
    let t: i64 = av1blkst.ld(unit, 0)
    if t == av1lr.RESTORE_WIENER {
        av1lrw.wiener_rect(c, unit, x, y, w, h)
    } else if t == av1lr.RESTORE_SGRPROJ {
        av1lrsgr.sgr_rect(c, unit, x, y, w, h)
    }
}

fn lr_plane(td: *mut av1blkst.TileDec, c: *mut av1lrsrc.LrCtx, plane: i64) {
    let fh: *mut av1fhdr.FrameHdr = (*td).fh
    var sx: i64 = 0
    var sy: i64 = 0
    if plane > 0 {
        sx = (*td).ss_x
        sy = (*td).ss_y
    }
    let plane_w: i64 = ((*fh).upscaled_width + sx) >> (sx as u64)
    let plane_h: i64 = ((*fh).frame_height + sy) >> (sy as u64)
    let unit_size: i64 = (*fh).loop_restoration_size[plane as usize]
    let unit_rows: i64 = (*td).lr_rows[plane as usize]
    let unit_cols: i64 = (*td).lr_cols[plane as usize]
    let stripe_h: i64 = 64 >> (sy as u64)
    let off: i64 = 8 >> (sy as u64)
    (*c).plane = plane
    (*c).stride = (*(*c).cdef).strides[plane as usize]
    (*c).end_x = plane_w - 1
    (*c).end_y = plane_h - 1
    var n: i64 = 0
    while n * stripe_h - off < plane_h {
        let start: i64 = n * stripe_h - off
        let y0: i64 = av1ipm.imax(0, start)
        let y1: i64 = av1ipm.imin(plane_h, start + stripe_h)
        (*c).stripe_start = start
        (*c).stripe_end = start + stripe_h - 1
        let urow: i64 = av1ipm.imin(unit_rows - 1, (y0 + off) / unit_size)
        var uc: i64 = 0
        while uc < unit_cols {
            let x0: i64 = uc * unit_size
            var x1: i64 = x0 + unit_size
            if uc == unit_cols - 1 {
                x1 = plane_w
            }
            let unit: u64 = (*td).lr_units[plane as usize] + ((urow * unit_cols + uc) * av1lr.LR_UNIT_BYTES) as u64
            run_rect(c, unit, x0, y0, x1 - x0, y1 - y0)
            uc = uc + 1
        }
        n = n + 1
    }
}

fn lr_frame(td: *mut av1blkst.TileDec, pre: *mut av1frame.Frame, cdef: *mut av1frame.Frame, out: *mut av1frame.Frame) {
    let fh: *mut av1fhdr.FrameHdr = (*td).fh
    var c: av1lrsrc.LrCtx = av1lrsrc.LrCtx { cdef: cdef, pre: pre, out: out, plane: 0, stride: 0, end_x: 0, end_y: 0, stripe_start: 0, stripe_end: 0, bit_depth: (*td).bit_depth }
    var plane: i64 = 0
    while plane < (*td).num_planes {
        if (*fh).frame_restoration_type[plane as usize] != av1lr.RESTORE_NONE {
            lr_plane(td, &c, plane)
        }
        plane = plane + 1
    }
}
