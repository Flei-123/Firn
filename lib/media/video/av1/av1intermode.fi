import media.video.av1.av1blkst
import media.video.av1.av1cdfidx
import media.video.av1.av1interdef
import media.video.av1.av1interctx
import media.video.av1.av1intermv
import media.video.av1.av1modeinfo
import media.video.av1.av1interref
import media.video.av1.av1mvref

export { read_inter_modes, drl_ctx, compound_mode_ctx }

const REF_CAT_LEVEL: i64 = 640

static COMP_MODE_CTX_MAP: [u8; 15] = [0, 1, 1, 1, 1, 1, 2, 3, 4, 4, 4, 4, 5, 6, 7]

fn compound_mode_ctx(mode_ctx: i64) -> i64 {
    let newmv: i64 = mode_ctx & 7
    let refmv: i64 = (mode_ctx >> 4) & 15
    var n: i64 = newmv
    if n > 4 {
        n = 4
    }
    return COMP_MODE_CTX_MAP[((refmv >> 1) * 5 + n) as usize] as i64
}

fn drl_ctx(td: *mut av1blkst.TileDec, idx: i64) -> i64 {
    let a: bool = (*td).stack_w[idx as usize] >= REF_CAT_LEVEL
    let b: bool = (*td).stack_w[(idx + 1) as usize] >= REF_CAT_LEVEL
    if a && b {
        return 0
    }
    if a {
        return 1
    }
    if !b {
        return 2
    }
    return 0
}

fn read_drl(td: *mut av1blkst.TileDec, first: i64, last: i64) {
    var idx: i64 = first
    while idx < last {
        if (*td).num_mv_found > idx + 1 {
            let drl: i64 = av1blkst.rd_sym(td, av1cdfidx.CDF_DRL + (drl_ctx(td, idx) * 3) as usize, 2)
            if drl == 0 {
                (*td).ref_mv_idx = idx
                return
            }
            (*td).ref_mv_idx = idx + 1
        }
        idx = idx + 1
    }
}

fn read_single_mode(td: *mut av1blkst.TileDec) -> i64 {
    let ctx: i64 = (*td).mode_ctx
    if av1blkst.rd_sym(td, av1cdfidx.CDF_NEWMV + ((ctx & 7) * 3) as usize, 2) == 0 {
        return av1interdef.NEWMV
    }
    if av1blkst.rd_sym(td, av1cdfidx.CDF_ZEROMV + (((ctx >> 3) & 1) * 3) as usize, 2) == 0 {
        return av1interdef.GLOBALMV
    }
    if av1blkst.rd_sym(td, av1cdfidx.CDF_REFMV + (((ctx >> 4) & 15) * 3) as usize, 2) == 0 {
        return av1interdef.NEARESTMV
    }
    return av1interdef.NEARMV
}

fn read_inter_modes(td: *mut av1blkst.TileDec) {
    let is_compound: bool = (*td).ref_frame[1] > av1interdef.INTRA_FRAME
    av1mvref.find_mv_stack(td)
    if (*td).skip_mode != 0 {
        (*td).y_mode = av1interdef.NEAREST_NEARESTMV
    } else if av1modeinfo.seg_feature_active(td, av1modeinfo.SEG_LVL_SKIP) || av1modeinfo.seg_feature_active(td, av1interref.SEG_LVL_GLOBALMV) {
        (*td).y_mode = av1interdef.GLOBALMV
    } else if is_compound {
        let cm: i64 = av1blkst.rd_sym(td, av1cdfidx.CDF_INTER_COMPOUND_MODE + (compound_mode_ctx((*td).mode_ctx) * 9) as usize, 8)
        (*td).y_mode = av1interdef.NEAREST_NEARESTMV + cm
    } else {
        (*td).y_mode = read_single_mode(td)
    }
    (*td).ref_mv_idx = 0
    let m: i64 = (*td).y_mode
    if m == av1interdef.NEWMV || m == av1interdef.NEW_NEWMV {
        read_drl(td, 0, 2)
    } else if av1interdef.has_nearmv(m) {
        (*td).ref_mv_idx = 1
        read_drl(td, 1, 3)
    }
    av1intermv.assign_mv(td, is_compound)
}
