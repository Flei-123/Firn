import media.video.av1.av1blkst
import media.video.av1.av1blkdat
import media.video.av1.av1cdfidx
import media.video.av1.av1sym
import media.video.av1.av1fhdr
import media.video.av1.av1palette
import media.video.av1.av1intrabc

export { intra_frame_mode_info }

const SEG_LVL_SKIP: i64 = 6
const DELTA_ABS_ESCAPE: i64 = 3

fn lit(td: *mut av1blkst.TileDec, n: i64) -> i64 {
    return av1sym.sym_literal(&(*td).sym, n)
}

fn seg_feature_active(td: *mut av1blkst.TileDec, feature: i64) -> bool {
    let fh: *mut av1fhdr.FrameHdr = (*td).fh
    return (*fh).segmentation_enabled == 1 && (*fh).feature_enabled[((*td).segment_id * 8 + feature) as usize] == 1
}

fn neg_deinterleave(diff: i64, ref: i64, max: i64) -> i64 {
    if ref == 0 {
        return diff
    }
    if ref >= max - 1 {
        return max - diff - 1
    }
    if 2 * ref < max {
        if diff <= 2 * ref {
            if (diff & 1) != 0 {
                return ref + ((diff + 1) >> 1)
            }
            return ref - (diff >> 1)
        }
        return diff
    }
    if diff <= 2 * (max - ref - 1) {
        if (diff & 1) != 0 {
            return ref + ((diff + 1) >> 1)
        }
        return ref - (diff >> 1)
    }
    return max - (diff + 1)
}

fn read_segment_id(td: *mut av1blkst.TileDec) {
    let fh: *mut av1fhdr.FrameHdr = (*td).fh
    let r: i64 = (*td).mi_row
    let c: i64 = (*td).mi_col
    var prev_ul: i64 = 0 - 1
    var prev_u: i64 = 0 - 1
    var prev_l: i64 = 0 - 1
    if (*td).avail_u != 0 && (*td).avail_l != 0 {
        prev_ul = av1blkst.mi_get(td, (*td).seg_a, r - 1, c - 1)
    }
    if (*td).avail_u != 0 {
        prev_u = av1blkst.mi_get(td, (*td).seg_a, r - 1, c)
    }
    if (*td).avail_l != 0 {
        prev_l = av1blkst.mi_get(td, (*td).seg_a, r, c - 1)
    }
    var pred: i64 = 0
    if prev_u == 0 - 1 {
        if prev_l != 0 - 1 {
            pred = prev_l
        }
    } else if prev_l == 0 - 1 {
        pred = prev_u
    } else if prev_ul == prev_u {
        pred = prev_u
    } else {
        pred = prev_l
    }
    if (*td).skip != 0 {
        (*td).segment_id = pred
        return
    }
    var ctx: i64 = 0
    if prev_ul < 0 {
        ctx = 0
    } else if prev_ul == prev_u && prev_ul == prev_l {
        ctx = 2
    } else if prev_ul == prev_u || prev_ul == prev_l || prev_u == prev_l {
        ctx = 1
    }
    var v: i64 = av1blkst.rd_sym(td, av1cdfidx.CDF_SPATIAL_PRED_SEG_TREE + (ctx * 9) as usize, 8)
    v = neg_deinterleave(v, pred, (*fh).last_active_seg_id + 1)
    if v < 0 {
        v = 0
    }
    if v > (*fh).last_active_seg_id {
        v = (*fh).last_active_seg_id
    }
    (*td).segment_id = v
}

fn intra_segment_id(td: *mut av1blkst.TileDec) {
    let fh: *mut av1fhdr.FrameHdr = (*td).fh
    if (*fh).segmentation_enabled == 1 {
        read_segment_id(td)
    } else {
        (*td).segment_id = 0
    }
    (*td).lossless = (*fh).lossless_array[(*td).segment_id as usize]
}

fn read_skip(td: *mut av1blkst.TileDec) {
    let fh: *mut av1fhdr.FrameHdr = (*td).fh
    if (*fh).seg_id_pre_skip == 1 && seg_feature_active(td, SEG_LVL_SKIP) {
        (*td).skip = 1
        return
    }
    var ctx: i64 = 0
    if (*td).avail_u != 0 {
        ctx = ctx + av1blkst.mi_get(td, (*td).skip_a, (*td).mi_row - 1, (*td).mi_col)
    }
    if (*td).avail_l != 0 {
        ctx = ctx + av1blkst.mi_get(td, (*td).skip_a, (*td).mi_row, (*td).mi_col - 1)
    }
    (*td).skip = av1blkst.rd_sym(td, av1cdfidx.CDF_SKIP_TXFM + (ctx * 3) as usize, 2)
}

fn read_cdef(td: *mut av1blkst.TileDec) {
    let fh: *mut av1fhdr.FrameHdr = (*td).fh
    if (*td).skip != 0 || (*fh).coded_lossless == 1 || (*(*td).seq).enable_cdef == 0 || (*fh).allow_intrabc == 1 {
        return
    }
    let r: i64 = (*td).mi_row >> 4
    let c: i64 = (*td).mi_col >> 4
    if av1blkst.ld((*td).cdef_a, r * (*td).cdef_stride + c) != 255 {
        return
    }
    let v: i64 = lit(td, (*fh).cdef_bits)
    var y: i64 = 0
    while y < ((*td).bh4 + 15) >> 4 {
        var x: i64 = 0
        while x < ((*td).bw4 + 15) >> 4 {
            av1blkst.st((*td).cdef_a, (r + y) * (*td).cdef_stride + c + x, v)
            x = x + 1
        }
        y = y + 1
    }
}

fn sb_size(td: *mut av1blkst.TileDec) -> i64 {
    if (*td).sb128 != 0 {
        return av1blkdat.BLOCK_128X128
    }
    return av1blkdat.BLOCK_64X64
}

fn read_delta_amount(td: *mut av1blkst.TileDec, off: usize) -> i64 {
    var abs: i64 = av1blkst.rd_sym(td, off, 4)
    if abs == DELTA_ABS_ESCAPE {
        let n: i64 = lit(td, 3) + 1
        abs = lit(td, n) + (1 << (n as u64)) + 1
    }
    if abs != 0 && lit(td, 1) == 1 {
        return 0 - abs
    }
    return abs
}

fn read_delta_qindex(td: *mut av1blkst.TileDec) {
    let fh: *mut av1fhdr.FrameHdr = (*td).fh
    if (*td).mi_size == sb_size(td) && (*td).skip != 0 {
        return
    }
    if (*td).read_deltas == 0 {
        return
    }
    let d: i64 = read_delta_amount(td, av1cdfidx.CDF_DELTA_Q)
    if d != 0 {
        var q: i64 = (*td).cur_q + (d << ((*fh).delta_q_res as u64))
        if q < 1 {
            q = 1
        }
        if q > 255 {
            q = 255
        }
        (*td).cur_q = q
    }
}

fn read_delta_lf(td: *mut av1blkst.TileDec) {
    let fh: *mut av1fhdr.FrameHdr = (*td).fh
    if (*td).mi_size == sb_size(td) && (*td).skip != 0 {
        return
    }
    if (*td).read_deltas == 0 || (*fh).delta_lf_present == 0 {
        return
    }
    var count: i64 = 1
    if (*fh).delta_lf_multi == 1 {
        count = 4
        if (*td).num_planes == 1 {
            count = 2
        }
    }
    var i: i64 = 0
    while i < count {
        var off: usize = av1cdfidx.CDF_DELTA_LF
        if (*fh).delta_lf_multi == 1 {
            off = av1cdfidx.CDF_DELTA_LF_MULTI + (i * 5) as usize
        }
        let d: i64 = read_delta_amount(td, off)
        if d != 0 {
            var v: i64 = (*td).delta_lf[i as usize] + (d << ((*fh).delta_lf_res as u64))
            if v < 0 - 63 {
                v = 0 - 63
            }
            if v > 63 {
                v = 63
            }
            (*td).delta_lf[i as usize] = v
        }
        i = i + 1
    }
}

fn read_angle(td: *mut av1blkst.TileDec, mode: i64) -> i64 {
    if (*td).mi_size >= av1blkdat.BLOCK_8X8 && av1blkdat.is_directional(mode) {
        return av1blkst.rd_sym(td, av1cdfidx.CDF_ANGLE_DELTA + ((mode - 1) * 8) as usize, 7) - 3
    }
    return 0
}

fn read_cfl_alphas(td: *mut av1blkst.TileDec) {
    let signs: i64 = av1blkst.rd_sym(td, av1cdfidx.CDF_CFL_SIGN, 8)
    let sign_u: i64 = (signs + 1) / 3
    let sign_v: i64 = (signs + 1) % 3
    (*td).cfl_u = 0
    (*td).cfl_v = 0
    if sign_u != 0 {
        let ctx: i64 = (sign_u - 1) * 3 + sign_v
        var a: i64 = 1 + av1blkst.rd_sym(td, av1cdfidx.CDF_CFL_ALPHA + (ctx * 17) as usize, 16)
        if sign_u == 1 {
            a = 0 - a
        }
        (*td).cfl_u = a
    }
    if sign_v != 0 {
        let ctx: i64 = (sign_v - 1) * 3 + sign_u
        var a: i64 = 1 + av1blkst.rd_sym(td, av1cdfidx.CDF_CFL_ALPHA + (ctx * 17) as usize, 16)
        if sign_v == 1 {
            a = 0 - a
        }
        (*td).cfl_v = a
    }
    (*td).n_cfl = (*td).n_cfl + 1
}

fn cfl_allowed(td: *mut av1blkst.TileDec) -> i64 {
    let ms: i64 = (*td).mi_size
    if (*td).lossless != 0 {
        if av1blkdat.subsampled_size(ms, (*td).ss_x, (*td).ss_y) == av1blkdat.BLOCK_4X4 {
            return 1
        }
        return 0
    }
    if av1blkdat.bw_px(ms) <= 32 && av1blkdat.bh_px(ms) <= 32 {
        return 1
    }
    return 0
}

fn read_filter_intra(td: *mut av1blkst.TileDec) {
    (*td).use_filter_intra = 0
    let ms: i64 = (*td).mi_size
    if (*(*td).seq).enable_filter_intra == 0 || (*td).y_mode != av1blkdat.DC_PRED || (*td).pal_size_y != 0 {
        return
    }
    if av1blkdat.bw_px(ms) > 32 || av1blkdat.bh_px(ms) > 32 {
        return
    }
    (*td).use_filter_intra = av1blkst.rd_sym(td, av1cdfidx.CDF_FILTER_INTRA + (ms * 3) as usize, 2)
    if (*td).use_filter_intra == 1 {
        (*td).filter_intra_mode = av1blkst.rd_sym(td, av1cdfidx.CDF_FILTER_INTRA_MODE, 5)
        (*td).n_filter_intra = (*td).n_filter_intra + 1
    }
}

fn read_y_mode(td: *mut av1blkst.TileDec) {
    var above: i64 = av1blkdat.DC_PRED
    var left: i64 = av1blkdat.DC_PRED
    if (*td).avail_u != 0 {
        above = av1blkst.mi_get(td, (*td).ymode_a, (*td).mi_row - 1, (*td).mi_col)
    }
    if (*td).avail_l != 0 {
        left = av1blkst.mi_get(td, (*td).ymode_a, (*td).mi_row, (*td).mi_col - 1)
    }
    let off: i64 = av1blkdat.intra_mode_ctx(above) * 70 + av1blkdat.intra_mode_ctx(left) * 14
    (*td).y_mode = av1blkst.rd_sym(td, av1cdfidx.CDF_KF_Y_MODE + off as usize, 13)
}

fn read_uv_mode(td: *mut av1blkst.TileDec) {
    let cfl: i64 = cfl_allowed(td)
    var n: i64 = 13
    if cfl == 1 {
        n = 14
    }
    let off: i64 = cfl * 195 + (*td).y_mode * 15
    (*td).uv_mode = av1blkst.rd_sym(td, av1cdfidx.CDF_UV_MODE + off as usize, n)
    if (*td).uv_mode == av1blkdat.UV_CFL {
        read_cfl_alphas(td)
    }
}

fn intra_frame_mode_info(td: *mut av1blkst.TileDec) -> i64 {
    let fh: *mut av1fhdr.FrameHdr = (*td).fh
    (*td).skip = 0
    if (*fh).seg_id_pre_skip == 1 {
        intra_segment_id(td)
    }
    read_skip(td)
    if (*fh).seg_id_pre_skip == 0 {
        intra_segment_id(td)
    }
    read_cdef(td)
    read_delta_qindex(td)
    read_delta_lf(td)
    (*td).read_deltas = 0
    (*td).use_intrabc = 0
    (*td).mv_row = 0
    (*td).mv_col = 0
    if (*fh).allow_intrabc == 1 {
        (*td).use_intrabc = av1blkst.rd_sym(td, av1cdfidx.CDF_INTRABC, 2)
    }
    if (*td).use_intrabc == 1 {
        return av1intrabc.intrabc_mode_info(td)
    }
    (*td).is_inter = 0
    (*td).pal_size_y = 0
    (*td).pal_size_uv = 0
    (*td).cfl_u = 0
    (*td).cfl_v = 0
    (*td).angle_uv = 0
    (*td).uv_mode = av1blkdat.DC_PRED
    read_y_mode(td)
    (*td).angle_y = read_angle(td, (*td).y_mode)
    if (*td).has_chroma != 0 {
        read_uv_mode(td)
        (*td).angle_uv = read_angle(td, (*td).uv_mode)
    }
    av1palette.palette_mode_info(td)
    read_filter_intra(td)
    return av1blkst.TD_OK
}
