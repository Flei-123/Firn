import media.video.av1.av1ipm

export { pred_cfl }

fn log2i(n: i64) -> i64 {
    var l: i64 = 0
    while (1 << (l as u64)) < n {
        l = l + 1
    }
    return l
}

fn pred_cfl(luma: u64, luma_stride: i64, luma_x: i64, luma_y: i64, max_w: i64, max_h: i64, dst: u64, stride: i64, w: i64, h: i64, sub_x: i64, sub_y: i64, alpha: i64, bd: i64, tmp: u64) {
    var sum: i64 = 0
    var i: i64 = 0
    while i < h {
        var ly: i64 = luma_y + (i << (sub_y as u64))
        ly = av1ipm.imin(ly, max_h - (1 << (sub_y as u64)))
        var j: i64 = 0
        while j < w {
            var lx: i64 = luma_x + (j << (sub_x as u64))
            lx = av1ipm.imin(lx, max_w - (1 << (sub_x as u64)))
            var t: i64 = 0
            var dy: i64 = 0
            while dy <= sub_y {
                var dx: i64 = 0
                while dx <= sub_x {
                    t = t + av1ipm.ld(luma, (ly + dy) * luma_stride + lx + dx)
                    dx = dx + 1
                }
                dy = dy + 1
            }
            let v: i64 = t << ((3 - sub_x - sub_y) as u64)
            av1ipm.st(tmp, i * w + j, v)
            sum = sum + v
            j = j + 1
        }
        i = i + 1
    }
    let sh: i64 = log2i(w) + log2i(h)
    let avg: i64 = (sum + (1 << ((sh - 1) as u64))) >> (sh as u64)
    i = 0
    while i < h {
        var j: i64 = 0
        while j < w {
            let x: i64 = alpha * (av1ipm.ld(tmp, i * w + j) - avg)
            var s: i64 = (x + 32) >> 6
            if x < 0 {
                s = 0 - (((0 - x) + 32) >> 6)
            }
            let a: i64 = i * stride + j
            av1ipm.st(dst, a, av1ipm.clip_px(av1ipm.ld(dst, a) + s, bd))
            j = j + 1
        }
        i = i + 1
    }
}
