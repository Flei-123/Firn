// SPDX-License-Identifier: MPL-2.0
export {
    bw4, bh4, bw_log2, bh_log2, bw_px, bh_px, sq_index, part_subsize, part_symbols, subsampled_size, size_from_dims,
    tx_w, tx_h, tx_w_log2, tx_h_log2, tx_sqr, tx_sqr_up, tx_adjusted, max_tx_rect, split_tx, max_tx_depth,
    intra_mode_ctx, mode_to_txfm, tx_class, qm_offset, is_directional, filter_intra_dir,
    BLOCK_4X4, BLOCK_8X8, BLOCK_64X64, BLOCK_128X128, BLOCK_INVALID,
    DC_PRED, V_PRED, H_PRED, D67_PRED, UV_CFL, PAETH_PRED,
    TX_4X4, TX_8X8, TX_16X16, TX_32X32, TX_64X64, TX_16X64, TX_64X16,
}

const BLOCK_4X4: i64 = 0
const BLOCK_8X8: i64 = 3
const BLOCK_64X64: i64 = 12
const BLOCK_128X128: i64 = 15
const BLOCK_INVALID: i64 = 22
const DC_PRED: i64 = 0
const V_PRED: i64 = 1
const H_PRED: i64 = 2
const D67_PRED: i64 = 8
const PAETH_PRED: i64 = 12
const UV_CFL: i64 = 13
const TX_4X4: i64 = 0
const TX_8X8: i64 = 1
const TX_16X16: i64 = 2
const TX_32X32: i64 = 3
const TX_64X64: i64 = 4
const TX_16X64: i64 = 17
const TX_64X16: i64 = 18

static W4: [u8; 22] = [1, 1, 2, 2, 2, 4, 4, 4, 8, 8, 8, 16, 16, 16, 32, 32, 1, 4, 2, 8, 4, 16]
static H4: [u8; 22] = [1, 2, 1, 2, 4, 2, 4, 8, 4, 8, 16, 8, 16, 32, 16, 32, 4, 1, 8, 2, 16, 4]
static WL: [u8; 22] = [0, 0, 1, 1, 1, 2, 2, 2, 3, 3, 3, 4, 4, 4, 5, 5, 0, 2, 1, 3, 2, 4]
static HL: [u8; 22] = [0, 1, 0, 1, 2, 1, 2, 3, 2, 3, 4, 3, 4, 5, 4, 5, 2, 0, 3, 1, 4, 2]

static SUB_NONE: [u8; 6] = [0, 3, 6, 9, 12, 15]
static SUB_HORZ: [u8; 6] = [22, 2, 5, 8, 11, 14]
static SUB_VERT: [u8; 6] = [22, 1, 4, 7, 10, 13]
static SUB_SPLIT: [u8; 6] = [22, 0, 3, 6, 9, 12]
static SUB_HORZ_AB: [u8; 6] = [22, 22, 5, 8, 11, 14]
static SUB_VERT_AB: [u8; 6] = [22, 22, 4, 7, 10, 13]
static SUB_HORZ4: [u8; 6] = [22, 22, 17, 19, 21, 22]
static SUB_VERT4: [u8; 6] = [22, 22, 16, 18, 20, 22]

static TXW: [u8; 19] = [4, 8, 16, 32, 64, 4, 8, 8, 16, 16, 32, 32, 64, 4, 16, 8, 32, 16, 64]
static TXH: [u8; 19] = [4, 8, 16, 32, 64, 8, 4, 16, 8, 32, 16, 64, 32, 16, 4, 32, 8, 64, 16]
static TXWL: [u8; 19] = [2, 3, 4, 5, 6, 2, 3, 3, 4, 4, 5, 5, 6, 2, 4, 3, 5, 4, 6]
static TXHL: [u8; 19] = [2, 3, 4, 5, 6, 3, 2, 4, 3, 5, 4, 6, 5, 4, 2, 5, 3, 6, 4]
static TXSQR: [u8; 19] = [0, 1, 2, 3, 4, 0, 0, 1, 1, 2, 2, 3, 3, 0, 0, 1, 1, 2, 2]
static TXSQRUP: [u8; 19] = [0, 1, 2, 3, 4, 1, 1, 2, 2, 3, 3, 4, 4, 2, 2, 3, 3, 4, 4]
static TXADJ: [u8; 19] = [0, 1, 2, 3, 3, 5, 6, 7, 8, 9, 10, 3, 3, 13, 14, 15, 16, 9, 10]
static MAXTX: [u8; 22] = [0, 5, 6, 1, 7, 8, 2, 9, 10, 3, 11, 12, 4, 4, 4, 4, 13, 14, 15, 16, 17, 18]
static SPLITTX: [u8; 19] = [0, 0, 1, 2, 3, 0, 0, 1, 1, 2, 2, 3, 3, 5, 6, 7, 8, 9, 10]
static MAXDEPTH: [u8; 22] = [0, 1, 1, 1, 2, 2, 2, 3, 3, 3, 4, 4, 4, 4, 4, 4, 2, 2, 3, 3, 4, 4]
static MODECTX: [u8; 13] = [0, 1, 2, 3, 4, 4, 4, 4, 3, 0, 1, 2, 0]
static MODETXFM: [u8; 14] = [0, 1, 2, 0, 3, 1, 2, 2, 1, 3, 1, 2, 3, 0]
static QMOFF: [u16; 19] = [0, 16, 80, 336, 336, 1360, 1392, 1424, 1552, 1680, 2192, 336, 336, 2704, 2768, 2832, 3088, 1680, 2192]
static FIDIR: [u8; 5] = [0, 1, 2, 6, 0]

fn bw4(b: i64) -> i64 {
    return W4[b as usize] as i64
}

fn bh4(b: i64) -> i64 {
    return H4[b as usize] as i64
}

fn bw_log2(b: i64) -> i64 {
    return WL[b as usize] as i64
}

fn bh_log2(b: i64) -> i64 {
    return HL[b as usize] as i64
}

fn bw_px(b: i64) -> i64 {
    return (W4[b as usize] as i64) * 4
}

fn bh_px(b: i64) -> i64 {
    return (H4[b as usize] as i64) * 4
}

fn sq_index(b: i64) -> i64 {
    if b == 0 {
        return 0
    }
    if b == 3 {
        return 1
    }
    if b == 6 {
        return 2
    }
    if b == 9 {
        return 3
    }
    if b == 12 {
        return 4
    }
    if b == 15 {
        return 5
    }
    return 0 - 1
}

fn part_subsize(p: i64, b: i64) -> i64 {
    let s: i64 = sq_index(b)
    if s < 0 {
        return BLOCK_INVALID
    }
    let i: usize = s as usize
    if p == 0 {
        return SUB_NONE[i] as i64
    }
    if p == 1 {
        return SUB_HORZ[i] as i64
    }
    if p == 2 {
        return SUB_VERT[i] as i64
    }
    if p == 3 {
        return SUB_SPLIT[i] as i64
    }
    if p == 4 || p == 5 {
        return SUB_HORZ_AB[i] as i64
    }
    if p == 6 || p == 7 {
        return SUB_VERT_AB[i] as i64
    }
    if p == 8 {
        return SUB_HORZ4[i] as i64
    }
    return SUB_VERT4[i] as i64
}

fn part_symbols(bsl: i64) -> i64 {
    if bsl == 1 {
        return 4
    }
    if bsl == 5 {
        return 8
    }
    return 10
}

fn size_from_dims(w4: i64, h4: i64) -> i64 {
    var b: i64 = 0
    while b < 22 {
        if bw4(b) == w4 && bh4(b) == h4 {
            return b
        }
        b = b + 1
    }
    return BLOCK_INVALID
}

fn subsampled_size(b: i64, ssx: i64, ssy: i64) -> i64 {
    var w: i64 = bw4(b) >> (ssx as u64)
    var h: i64 = bh4(b) >> (ssy as u64)
    if w < 1 {
        w = 1
    }
    if h < 1 {
        h = 1
    }
    return size_from_dims(w, h)
}

fn tx_w(t: i64) -> i64 {
    return TXW[t as usize] as i64
}

fn tx_h(t: i64) -> i64 {
    return TXH[t as usize] as i64
}

fn tx_w_log2(t: i64) -> i64 {
    return TXWL[t as usize] as i64
}

fn tx_h_log2(t: i64) -> i64 {
    return TXHL[t as usize] as i64
}

fn tx_sqr(t: i64) -> i64 {
    return TXSQR[t as usize] as i64
}

fn tx_sqr_up(t: i64) -> i64 {
    return TXSQRUP[t as usize] as i64
}

fn tx_adjusted(t: i64) -> i64 {
    return TXADJ[t as usize] as i64
}

fn max_tx_rect(b: i64) -> i64 {
    return MAXTX[b as usize] as i64
}

fn split_tx(t: i64) -> i64 {
    return SPLITTX[t as usize] as i64
}

fn max_tx_depth(b: i64) -> i64 {
    return MAXDEPTH[b as usize] as i64
}

fn intra_mode_ctx(m: i64) -> i64 {
    return MODECTX[m as usize] as i64
}

fn mode_to_txfm(m: i64) -> i64 {
    return MODETXFM[m as usize] as i64
}

fn tx_class(t: i64) -> i64 {
    if t == 10 || t == 12 || t == 14 {
        return 2
    }
    if t == 11 || t == 13 || t == 15 {
        return 1
    }
    return 0
}

fn qm_offset(t: i64) -> i64 {
    return QMOFF[t as usize] as i64
}

fn is_directional(m: i64) -> bool {
    return m >= 1 && m <= 8
}

fn filter_intra_dir(m: i64) -> i64 {
    return FIDIR[m as usize] as i64
}
