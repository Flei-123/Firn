import media.video.av1.av1blkst
import media.video.av1.av1cdfidx
import media.video.av1.av1fhdr
import media.video.av1.av1interdef

export { read_mv_component, read_mv_diff, mv_load, mv_store, assign_mv, stack_mv_at }

fn read_mv_component(td: *mut av1blkst.TileDec, ctx: i64, comp: i64) -> i64 {
    let fh: *mut av1fhdr.FrameHdr = (*td).fh
    let sign: i64 = av1blkst.rd_sym(td, av1cdfidx.CDF_MV_SIGN + (ctx * 6 + comp * 3) as usize, 2)
    let cls: i64 = av1blkst.rd_sym(td, av1cdfidx.CDF_MV_CLASSES + (ctx * 24 + comp * 12) as usize, 11)
    var mag: i64 = 0
    var fr: i64 = 3
    var hp: i64 = 1
    if cls == 0 {
        let bit: i64 = av1blkst.rd_sym(td, av1cdfidx.CDF_MV_CLASS0 + (ctx * 6 + comp * 3) as usize, 2)
        if (*fh).force_integer_mv == 0 {
            fr = av1blkst.rd_sym(td, av1cdfidx.CDF_MV_CLASS0_FP + (ctx * 20 + comp * 10 + bit * 5) as usize, 4)
        }
        if (*fh).allow_high_precision_mv != 0 {
            hp = av1blkst.rd_sym(td, av1cdfidx.CDF_MV_CLASS0_HP + (ctx * 6 + comp * 3) as usize, 2)
        }
        mag = ((bit << 3) | (fr << 1) | hp) + 1
    } else {
        var d: i64 = 0
        var i: i64 = 0
        while i < cls {
            let bit: i64 = av1blkst.rd_sym(td, av1cdfidx.CDF_MV_BITS + (ctx * 60 + comp * 30 + i * 3) as usize, 2)
            d = d | (bit << (i as u64))
            i = i + 1
        }
        if (*fh).force_integer_mv == 0 {
            fr = av1blkst.rd_sym(td, av1cdfidx.CDF_MV_FP + (ctx * 10 + comp * 5) as usize, 4)
        }
        if (*fh).allow_high_precision_mv != 0 {
            hp = av1blkst.rd_sym(td, av1cdfidx.CDF_MV_HP + (ctx * 6 + comp * 3) as usize, 2)
        }
        mag = (2 << ((cls + 2) as u64)) + ((d << 3) | (fr << 1) | hp) + 1
    }
    if sign == 1 {
        return 0 - mag
    }
    return mag
}

fn read_mv_diff(td: *mut av1blkst.TileDec, ctx: i64, out_row: *mut i64, out_col: *mut i64) {
    *out_row = 0
    *out_col = 0
    let joint: i64 = av1blkst.rd_sym(td, av1cdfidx.CDF_MV_JOINTS + (ctx * 5) as usize, 4)
    if joint == 2 || joint == 3 {
        *out_row = read_mv_component(td, ctx, 0)
    }
    if joint == 1 || joint == 3 {
        *out_col = read_mv_component(td, ctx, 1)
    }
}

fn mv_load(td: *mut av1blkst.TileDec, row: i64, col: i64, list: i64, comp: i64) -> i64 {
    let base: i64 = (row * (*td).mi_cols + col) * 8 + list * 4 + comp * 2
    var v: i64 = av1blkst.ld((*td).mv_a, base) + (av1blkst.ld((*td).mv_a, base + 1) << 8)
    if v >= 32768 {
        v = v - 65536
    }
    return v
}

fn mv_store(td: *mut av1blkst.TileDec, row: i64, col: i64, list: i64, comp: i64, v: i64) {
    let base: i64 = (row * (*td).mi_cols + col) * 8 + list * 4 + comp * 2
    av1blkst.st((*td).mv_a, base, v & 255)
    av1blkst.st((*td).mv_a, base + 1, (v >> 8) & 255)
}

fn stack_mv_at(td: *mut av1blkst.TileDec, pos: i64, list: i64, comp: i64) -> i64 {
    return (*td).stack_mv[(pos * 4 + list * 2 + comp) as usize]
}

fn assign_mv(td: *mut av1blkst.TileDec, is_compound: bool) {
    var n: i64 = 1
    if is_compound {
        n = 2
    }
    var i: i64 = 0
    while i < n {
        let comp_mode: i64 = av1interdef.mode_part((*td).y_mode, i)
        var pred_r: i64 = 0
        var pred_c: i64 = 0
        if comp_mode == av1interdef.GLOBALMV {
            pred_r = (*td).global_mv[(i * 2) as usize]
            pred_c = (*td).global_mv[(i * 2 + 1) as usize]
        } else {
            var pos: i64 = (*td).ref_mv_idx
            if comp_mode == av1interdef.NEARESTMV {
                pos = 0
            }
            if comp_mode == av1interdef.NEWMV && (*td).num_mv_found <= 1 {
                pos = 0
            }
            pred_r = stack_mv_at(td, pos, i, 0)
            pred_c = stack_mv_at(td, pos, i, 1)
        }
        if comp_mode == av1interdef.NEWMV {
            var dr: i64 = 0
            var dc: i64 = 0
            read_mv_diff(td, 0, &dr, &dc)
            pred_r = pred_r + dr
            pred_c = pred_c + dc
        }
        (*td).mvs[(i * 2) as usize] = pred_r
        (*td).mvs[(i * 2 + 1) as usize] = pred_c
        i = i + 1
    }
    if !is_compound {
        (*td).mvs[2] = 0
        (*td).mvs[3] = 0
    }
    (*td).mv_row = (*td).mvs[0]
    (*td).mv_col = (*td).mvs[1]
}
