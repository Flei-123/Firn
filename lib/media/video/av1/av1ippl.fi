import media.video.av1.av1ipm
import media.video.av1.av1tabintra

export { pred_dc, pred_v, pred_h, pred_paeth, pred_smooth, pred_smooth_v, pred_smooth_h, pred_const }

fn sm_weight(lg: i64, i: i64) -> i64 {
    var off: i64 = 0
    if lg == 3 {
        off = 4
    }
    if lg == 4 {
        off = 12
    }
    if lg == 5 {
        off = 28
    }
    if lg == 6 {
        off = 60
    }
    let p: u64 = av1tabintra.smooth_weights_addr()
    return (*((p + (off + i) as u64) as *mut u8)) as i64
}

fn ilog2(n: i64) -> i64 {
    var l: i64 = 0
    while (1 << (l as u64)) < n {
        l = l + 1
    }
    return l
}

fn pred_const(dst: u64, stride: i64, w: i64, h: i64, v: i64) {
    var r: i64 = 0
    while r < h {
        av1ipm.fill_px(dst, r * stride, w, v)
        r = r + 1
    }
}

fn pred_v(dst: u64, stride: i64, w: i64, h: i64, above: u64) {
    var r: i64 = 0
    while r < h {
        var c: i64 = 0
        while c < w {
            av1ipm.st(dst, r * stride + c, av1ipm.ld(above, c))
            c = c + 1
        }
        r = r + 1
    }
}

fn pred_h(dst: u64, stride: i64, w: i64, h: i64, left: u64) {
    var r: i64 = 0
    while r < h {
        av1ipm.fill_px(dst, r * stride, w, av1ipm.ld(left, r))
        r = r + 1
    }
}

fn pred_dc(dst: u64, stride: i64, w: i64, h: i64, above: u64, left: u64, have_left: bool, have_above: bool, bd: i64) {
    var sum: i64 = 0
    var cnt: i64 = 0
    var i: i64 = 0
    if have_above {
        while i < w {
            sum = sum + av1ipm.ld(above, i)
            i = i + 1
        }
        cnt = cnt + w
    }
    if have_left {
        i = 0
        while i < h {
            sum = sum + av1ipm.ld(left, i)
            i = i + 1
        }
        cnt = cnt + h
    }
    var v: i64 = 128 << ((bd - 8) as u64)
    if cnt > 0 {
        v = (sum + (cnt >> 1)) / cnt
    }
    pred_const(dst, stride, w, h, v)
}

fn pred_paeth(dst: u64, stride: i64, w: i64, h: i64, above: u64, left: u64) {
    let tl: i64 = av1ipm.ld(above, 0 - 1)
    var r: i64 = 0
    while r < h {
        var c: i64 = 0
        while c < w {
            let l: i64 = av1ipm.ld(left, r)
            let t: i64 = av1ipm.ld(above, c)
            let base: i64 = l + t - tl
            let pl: i64 = av1ipm.iabs(base - l)
            let pt: i64 = av1ipm.iabs(base - t)
            let ptl: i64 = av1ipm.iabs(base - tl)
            var v: i64 = tl
            if pl <= pt && pl <= ptl {
                v = l
            } else {
                if pt <= ptl {
                    v = t
                }
            }
            av1ipm.st(dst, r * stride + c, v)
            c = c + 1
        }
        r = r + 1
    }
}

fn pred_smooth(dst: u64, stride: i64, w: i64, h: i64, above: u64, left: u64) {
    let lw: i64 = ilog2(w)
    let lh: i64 = ilog2(h)
    let below: i64 = av1ipm.ld(left, h - 1)
    let right: i64 = av1ipm.ld(above, w - 1)
    var r: i64 = 0
    while r < h {
        var c: i64 = 0
        while c < w {
            let wh: i64 = sm_weight(lh, r)
            let ww: i64 = sm_weight(lw, c)
            let p: i64 = wh * av1ipm.ld(above, c) + (256 - wh) * below + ww * av1ipm.ld(left, r) + (256 - ww) * right
            av1ipm.st(dst, r * stride + c, (p + 256) >> 9)
            c = c + 1
        }
        r = r + 1
    }
}

fn pred_smooth_v(dst: u64, stride: i64, w: i64, h: i64, above: u64, left: u64) {
    let lh: i64 = ilog2(h)
    let below: i64 = av1ipm.ld(left, h - 1)
    var r: i64 = 0
    while r < h {
        var c: i64 = 0
        while c < w {
            let wh: i64 = sm_weight(lh, r)
            let p: i64 = wh * av1ipm.ld(above, c) + (256 - wh) * below
            av1ipm.st(dst, r * stride + c, (p + 128) >> 8)
            c = c + 1
        }
        r = r + 1
    }
}

fn pred_smooth_h(dst: u64, stride: i64, w: i64, h: i64, above: u64, left: u64) {
    let lw: i64 = ilog2(w)
    let right: i64 = av1ipm.ld(above, w - 1)
    var r: i64 = 0
    while r < h {
        var c: i64 = 0
        while c < w {
            let ww: i64 = sm_weight(lw, c)
            let p: i64 = ww * av1ipm.ld(left, r) + (256 - ww) * right
            av1ipm.st(dst, r * stride + c, (p + 128) >> 8)
            c = c + 1
        }
        r = r + 1
    }
}
