import media.video.av1.av1blkst
import media.video.av1.av1blkdat
import media.video.av1.av1interdef
import media.video.av1.av1interctx
import media.video.av1.av1mvmi
import media.video.av1.av1warpsamp

export { find_warp_samples, has_overlappable_candidates }

fn inside(td: *mut av1blkst.TileDec, r: i64, c: i64) -> bool {
    return c >= (*td).mi_col_start && c < (*td).mi_col_end && r >= (*td).mi_row_start && r < (*td).mi_row_end
}

fn get_field(ctx: u64, field: i64, row: i64, col: i64) -> i64 {
    let td: *mut av1blkst.TileDec = ctx as *mut av1blkst.TileDec
    let r: i64 = (*td).mi_row + row
    let c: i64 = (*td).mi_col + col
    if field == av1warpsamp.FIELD_REF0 {
        return av1mvmi.ref_get(td, r, c, 0)
    }
    if field == av1warpsamp.FIELD_REF1 {
        return av1mvmi.ref_get(td, r, c, 1)
    }
    if field == av1warpsamp.FIELD_W4 {
        return av1blkdat.bw4(av1blkst.mi_get(td, (*td).mi_size_a, r, c))
    }
    if field == av1warpsamp.FIELD_H4 {
        return av1blkdat.bh4(av1blkst.mi_get(td, (*td).mi_size_a, r, c))
    }
    if field == av1warpsamp.FIELD_MV_ROW {
        return av1mvmi.mv_get(td, r, c, 0, 0)
    }
    return av1mvmi.mv_get(td, r, c, 0, 1)
}

fn top_right_avail(td: *mut av1blkst.TileDec) -> i64 {
    var mx: i64 = (*td).bw4
    if (*td).bh4 > mx {
        mx = (*td).bh4
    }
    if mx > 16 {
        return 0
    }
    let r: i64 = (*td).mi_row - 1
    let c: i64 = (*td).mi_col + (*td).bw4
    if !inside(td, r, c) {
        return 0
    }
    if av1blkst.mi_get(td, (*td).wr_a, r, c) == 0 {
        return 0
    }
    return 1
}

fn find_warp_samples(td: *mut av1blkst.TileDec) {
    var pts: [i64; 16] = [0; 16]
    var inref: [i64; 16] = [0; 16]
    let pp: u64 = (&pts) as u64
    let pi: u64 = (&inref) as u64
    (*td).num_samples = 0
    let np: i64 = av1warpsamp.find_samples(get_field, td as u64, (*td).mi_row, (*td).mi_col, (*td).bw4, (*td).bh4, (*td).mi_rows, (*td).mi_cols, (*td).avail_u, (*td).avail_l, top_right_avail(td), (*td).ref_frame[0], pp, pi)
    if np == 0 {
        return
    }
    var n: i64 = 1
    if np > 1 {
        n = av1warpsamp.select_samples((*td).mvs[0], (*td).mvs[1], pp, pi, np, av1blkdat.bw_px((*td).mi_size), av1blkdat.bh_px((*td).mi_size))
    }
    var i: i64 = 0
    while i < n {
        (*td).samples[(i * 4) as usize] = pts[(i * 2 + 1) as usize]
        (*td).samples[(i * 4 + 1) as usize] = pts[(i * 2) as usize]
        (*td).samples[(i * 4 + 2) as usize] = inref[(i * 2 + 1) as usize]
        (*td).samples[(i * 4 + 3) as usize] = inref[(i * 2) as usize]
        i = i + 1
    }
    (*td).num_samples = n
}

fn has_overlappable_candidates(td: *mut av1blkst.TileDec) -> bool {
    if (*td).avail_u != 0 {
        var lim: i64 = (*td).mi_col + (*td).bw4
        if (*td).mi_cols < lim {
            lim = (*td).mi_cols
        }
        var x: i64 = (*td).mi_col
        while x < lim {
            var x5: i64 = x | 1
            if x5 >= (*td).mi_cols {
                x5 = (*td).mi_cols - 1
            }
            if av1interctx.nb_ref(td, (*td).mi_row - 1, x5, 0) > av1interdef.INTRA_FRAME {
                return true
            }
            x = x + 2
        }
    }
    if (*td).avail_l != 0 {
        var lim: i64 = (*td).mi_row + (*td).bh4
        if (*td).mi_rows < lim {
            lim = (*td).mi_rows
        }
        var y: i64 = (*td).mi_row
        while y < lim {
            var y5: i64 = y | 1
            if y5 >= (*td).mi_rows {
                y5 = (*td).mi_rows - 1
            }
            if av1interctx.nb_ref(td, y5, (*td).mi_col - 1, 0) > av1interdef.INTRA_FRAME {
                return true
            }
            y = y + 2
        }
    }
    return false
}
