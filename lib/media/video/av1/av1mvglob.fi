import media.video.av1.av1blkst
import media.video.av1.av1blkdat
import media.video.av1.av1fhdr

export { lower_comp, setup_global_mv, round2signed }

const GM_TRANSLATION: i64 = 1
const WARP_PREC: i64 = 16

fn round2signed(x: i64, n: i64) -> i64 {
    let h: i64 = 1 << ((n - 1) as u64)
    if x >= 0 {
        return (x + h) >> (n as u64)
    }
    return 0 - ((h - x) >> (n as u64))
}

fn lower_comp(fh: *mut av1fhdr.FrameHdr, v: i64) -> i64 {
    if (*fh).allow_high_precision_mv != 0 {
        return v
    }
    if (*fh).force_integer_mv != 0 {
        var a: i64 = v
        if a < 0 {
            a = 0 - a
        }
        let a_int: i64 = (a + 3) >> 3
        if v > 0 {
            return a_int << 3
        }
        return 0 - (a_int << 3)
    }
    if (v & 1) != 0 {
        if v > 0 {
            return v - 1
        }
        return v + 1
    }
    return v
}

fn global_for_list(td: *mut av1blkst.TileDec, list: i64) {
    let rf: i64 = (*td).ref_frame[list as usize]
    var mr: i64 = 0
    var mc: i64 = 0
    if rf > 0 {
        let fh: *mut av1fhdr.FrameHdr = (*td).fh
        let typ: i64 = (*fh).gm_type[rf as usize]
        let base: usize = (rf * 6) as usize
        if typ == GM_TRANSLATION {
            mr = (*fh).gm_params[base] >> 13
            mc = (*fh).gm_params[base + 1] >> 13
        } else if typ > GM_TRANSLATION {
            let bw: i64 = av1blkdat.bw4((*td).mi_size) * 4
            let bh: i64 = av1blkdat.bh4((*td).mi_size) * 4
            let x: i64 = (*td).mi_col * 4 + bw / 2 - 1
            let y: i64 = (*td).mi_row * 4 + bh / 2 - 1
            let xc: i64 = ((*fh).gm_params[base + 2] - (1 << 16)) * x + (*fh).gm_params[base + 3] * y + (*fh).gm_params[base]
            let yc: i64 = (*fh).gm_params[base + 4] * x + ((*fh).gm_params[base + 5] - (1 << 16)) * y + (*fh).gm_params[base + 1]
            if (*fh).allow_high_precision_mv != 0 {
                mr = round2signed(yc, WARP_PREC - 3)
                mc = round2signed(xc, WARP_PREC - 3)
            } else {
                mr = round2signed(yc, WARP_PREC - 2) * 2
                mc = round2signed(xc, WARP_PREC - 2) * 2
            }
        }
        mr = lower_comp(fh, mr)
        mc = lower_comp(fh, mc)
    }
    (*td).global_mv[(list * 2) as usize] = mr
    (*td).global_mv[(list * 2 + 1) as usize] = mc
}

fn setup_global_mv(td: *mut av1blkst.TileDec) {
    global_for_list(td, 0)
    global_for_list(td, 1)
}
