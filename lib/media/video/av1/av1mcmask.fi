import media.video.vp9.vp9mem
import media.video.av1.av1ipm
import media.video.av1.av1mc
import media.video.av1.av1tabmask

export { dist_weights, single_to_plane, avg_to_plane, dist_to_plane, mask_to_plane, diffwtd_mask }

fn dist_weights(d0: i64, d1: i64) -> i64 {
    let wt: u64 = av1tabmask.dist_weight_addr()
    let lk: u64 = av1tabmask.dist_lookup_addr()
    var order: i64 = 0
    if d0 <= d1 {
        order = 1
    }
    if d0 == 0 || d1 == 0 {
        return (vp9mem.ldi16(lk, (6 + order) as usize) << 8) | vp9mem.ldi16(lk, (6 + 1 - order) as usize)
    }
    var i: i64 = 0
    while i < 3 {
        let c0: i64 = vp9mem.ldi16(wt, (i * 2 + order) as usize)
        let c1: i64 = vp9mem.ldi16(wt, (i * 2 + 1 - order) as usize)
        let d0c0: i64 = d0 * c0
        let d1c1: i64 = d1 * c1
        if (d0 > d1 && d0c0 < d1c1) || (d0 <= d1 && d0c0 > d1c1) {
            break
        }
        i = i + 1
    }
    return (vp9mem.ldi16(lk, (i * 2 + order) as usize) << 8) | vp9mem.ldi16(lk, (i * 2 + 1 - order) as usize)
}

fn single_to_plane(p0: u64, w: i64, h: i64, dst: u64, stride: i64, bd: i64) {
    var r: i64 = 0
    while r < h {
        var c: i64 = 0
        while c < w {
            av1ipm.st(dst, r * stride + c, av1ipm.clip_px(av1ipm.ld64(p0, r * w + c), bd))
            c = c + 1
        }
        r = r + 1
    }
}

fn avg_to_plane(p0: u64, p1: u64, w: i64, h: i64, dst: u64, stride: i64, bd: i64) {
    let sh: i64 = 1 + av1mc.post_round_of(bd)
    var r: i64 = 0
    while r < h {
        var c: i64 = 0
        while c < w {
            let v: i64 = av1mc.round2s(av1ipm.ld64(p0, r * w + c) + av1ipm.ld64(p1, r * w + c), sh)
            av1ipm.st(dst, r * stride + c, av1ipm.clip_px(v, bd))
            c = c + 1
        }
        r = r + 1
    }
}

fn dist_to_plane(p0: u64, p1: u64, w: i64, h: i64, fwd: i64, bck: i64, dst: u64, stride: i64, bd: i64) {
    let sh: i64 = 4 + av1mc.post_round_of(bd)
    var r: i64 = 0
    while r < h {
        var c: i64 = 0
        while c < w {
            let v: i64 = av1mc.round2s(av1ipm.ld64(p0, r * w + c) * fwd + av1ipm.ld64(p1, r * w + c) * bck, sh)
            av1ipm.st(dst, r * stride + c, av1ipm.clip_px(v, bd))
            c = c + 1
        }
        r = r + 1
    }
}

fn mask_at(mask: u64, mstride: i64, r: i64, c: i64, sub_x: i64, sub_y: i64) -> i64 {
    if sub_x == 0 && sub_y == 0 {
        return vp9mem.ldi16(mask, (r * mstride + c) as usize)
    }
    if sub_x != 0 && sub_y != 0 {
        let a: i64 = vp9mem.ldi16(mask, ((2 * r) * mstride + 2 * c) as usize)
        let b: i64 = vp9mem.ldi16(mask, ((2 * r) * mstride + 2 * c + 1) as usize)
        let d: i64 = vp9mem.ldi16(mask, ((2 * r + 1) * mstride + 2 * c) as usize)
        let e: i64 = vp9mem.ldi16(mask, ((2 * r + 1) * mstride + 2 * c + 1) as usize)
        return av1mc.round2s(a + b + d + e, 2)
    }
    if sub_x != 0 {
        let a: i64 = vp9mem.ldi16(mask, (r * mstride + 2 * c) as usize)
        let b: i64 = vp9mem.ldi16(mask, (r * mstride + 2 * c + 1) as usize)
        return av1mc.round2s(a + b, 1)
    }
    let a: i64 = vp9mem.ldi16(mask, ((2 * r) * mstride + c) as usize)
    let b: i64 = vp9mem.ldi16(mask, ((2 * r + 1) * mstride + c) as usize)
    return av1mc.round2s(a + b, 1)
}

fn mask_to_plane(p0: u64, p1: u64, mask: u64, mstride: i64, sub_x: i64, sub_y: i64, w: i64, h: i64, post: i64, dst: u64, stride: i64, bd: i64) {
    var r: i64 = 0
    while r < h {
        var c: i64 = 0
        while c < w {
            let m: i64 = mask_at(mask, mstride, r, c, sub_x, sub_y)
            let v: i64 = av1mc.round2s(m * av1ipm.ld64(p0, r * w + c) + (64 - m) * av1ipm.ld64(p1, r * w + c), 6 + post)
            av1ipm.st(dst, r * stride + c, av1ipm.clip_px(v, bd))
            c = c + 1
        }
        r = r + 1
    }
}

fn diffwtd_mask(p0: u64, p1: u64, w: i64, h: i64, bd: i64, inverse: i64, out: u64) {
    let sh: i64 = (bd - 8) + av1mc.post_round_of(bd)
    var i: i64 = 0
    while i < w * h {
        let d: i64 = av1mc.round2s(av1ipm.iabs(av1ipm.ld64(p0, i) - av1ipm.ld64(p1, i)), sh)
        var m: i64 = 38 + d / 16
        if m > 64 {
            m = 64
        }
        if inverse != 0 {
            m = 64 - m
        }
        vp9mem.sti16(out, i as usize, m)
        i = i + 1
    }
}
