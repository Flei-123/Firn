// SPDX-License-Identifier: MPL-2.0
export { ld64, st64, ld, st, imin, imax, iabs, clip_px, fill_px }

#[no_gc]
fn ld(p: u64, i: i64) -> i64 {
    return (*((((p as i64) + i * 2) as u64) as *mut u16)) as i64
}

#[no_gc]
fn st(p: u64, i: i64, v: i64) {
    *((((p as i64) + i * 2) as u64) as *mut u16) = v as% u16
}

#[no_gc]
fn imin(a: i64, b: i64) -> i64 {
    if a < b {
        return a
    }
    return b
}

#[no_gc]
fn imax(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    }
    return b
}

#[no_gc]
fn iabs(a: i64) -> i64 {
    if a < 0 {
        return 0 - a
    }
    return a
}

#[no_gc]
fn clip_px(v: i64, bd: i64) -> i64 {
    let hi: i64 = (1 << (bd as u64)) - 1
    if v < 0 {
        return 0
    }
    if v > hi {
        return hi
    }
    return v
}

fn fill_px(p: u64, from: i64, n: i64, v: i64) {
    var i: i64 = 0
    while i < n {
        st(p, from + i, v)
        i = i + 1
    }
}

#[no_gc]
fn ld64(p: u64, i: i64) -> i64 {
    return *((p + (i * 8) as u64) as *mut i64)
}

#[no_gc]
fn st64(p: u64, i: i64, v: i64) {
    *((p + (i * 8) as u64) as *mut i64) = v
}
