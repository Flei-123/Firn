import media.video.av1.av1blkst
import media.video.av1.av1blkdat
import media.video.av1.av1fhdr

export { residual, clear_block_decoded, reset_block_context }

fn bd_index(y: i64, x: i64) -> i64 {
    return (y + 1) * av1blkst.BD_STRIDE + x + 1
}

fn bd_get(td: *mut av1blkst.TileDec, plane: i64, y: i64, x: i64) -> i64 {
    return av1blkst.ld((*td).block_dec[plane as usize], bd_index(y, x))
}

fn bd_set(td: *mut av1blkst.TileDec, plane: i64, y: i64, x: i64, v: i64) {
    av1blkst.st((*td).block_dec[plane as usize], bd_index(y, x), v)
}

fn clear_block_decoded(td: *mut av1blkst.TileDec, r: i64, c: i64, sb4: i64) {
    var plane: i64 = 0
    while plane < (*td).num_planes {
        var sx: i64 = 0
        var sy: i64 = 0
        if plane > 0 {
            sx = (*td).ss_x
            sy = (*td).ss_y
        }
        let sb_w: i64 = ((*td).mi_col_end - c) >> (sx as u64)
        let sb_h: i64 = ((*td).mi_row_end - r) >> (sy as u64)
        var y: i64 = 0 - 1
        while y <= (sb4 >> (sy as u64)) {
            var x: i64 = 0 - 1
            while x <= (sb4 >> (sx as u64)) {
                var v: i64 = 0
                if y < 0 && x < sb_w {
                    v = 1
                } else if x < 0 && y < sb_h {
                    v = 1
                }
                bd_set(td, plane, y, x, v)
                x = x + 1
            }
            y = y + 1
        }
        bd_set(td, plane, sb4 >> (sy as u64), 0 - 1, 0)
        plane = plane + 1
    }
}

fn reset_block_context(td: *mut av1blkst.TileDec) {
    var plane: i64 = 0
    var planes: i64 = 1
    if (*td).has_chroma != 0 {
        planes = 3
    }
    while plane < planes {
        var sx: i64 = 0
        var sy: i64 = 0
        if plane > 0 {
            sx = (*td).ss_x
            sy = (*td).ss_y
        }
        var i: i64 = (*td).mi_col >> (sx as u64)
        while i <= (((*td).mi_col + (*td).bw4 - 1) >> (sx as u64)) {
            av1blkst.st((*td).above_level[plane as usize], i, 0)
            av1blkst.st((*td).above_dc[plane as usize], i, 0)
            i = i + 1
        }
        var j: i64 = (*td).mi_row >> (sy as u64)
        while j <= (((*td).mi_row + (*td).bh4 - 1) >> (sy as u64)) {
            av1blkst.st((*td).left_level[plane as usize], j, 0)
            av1blkst.st((*td).left_dc[plane as usize], j, 0)
            j = j + 1
        }
        plane = plane + 1
    }
}

fn plane_tx_size(td: *mut av1blkst.TileDec, plane: i64) -> i64 {
    if (*td).lossless != 0 {
        return av1blkdat.TX_4X4
    }
    if plane == 0 {
        return (*td).tx_size
    }
    let uv: i64 = av1blkdat.max_tx_rect(av1blkdat.subsampled_size((*td).mi_size, (*td).ss_x, (*td).ss_y))
    if av1blkdat.tx_w(uv) == 64 || av1blkdat.tx_h(uv) == 64 {
        if av1blkdat.tx_w(uv) == 16 {
            return 9
        }
        if av1blkdat.tx_h(uv) == 16 {
            return 10
        }
        return av1blkdat.TX_32X32
    }
    return uv
}

fn store_loopfilter_tx(td: *mut av1blkst.TileDec, plane: i64, row: i64, col: i64, tx: i64) {
    var sx: i64 = 0
    var sy: i64 = 0
    if plane > 0 {
        sx = (*td).ss_x
        sy = (*td).ss_y
    }
    let sh: i64 = av1blkdat.tx_h(tx) >> 2
    let sw: i64 = av1blkdat.tx_w(tx) >> 2
    var i: i64 = 0
    while i < sh {
        var j: i64 = 0
        while j < sw {
            let rp: i64 = (row >> (sy as u64)) + i
            let cp: i64 = (col >> (sx as u64)) + j
            if rp < (*td).mi_rows && cp < (*td).mi_cols {
                av1blkst.st((*td).lftx_a, (rp * (*td).mi_cols + cp) * 3 + plane, tx)
            }
            j = j + 1
        }
        i = i + 1
    }
}

fn transform_block(td: *mut av1blkst.TileDec, plane: i64, base_x: i64, base_y: i64, tx: i64, x: i64, y: i64) -> i64 {
    var sx: i64 = 0
    var sy: i64 = 0
    if plane > 0 {
        sx = (*td).ss_x
        sy = (*td).ss_y
    }
    let start_x: i64 = base_x + 4 * x
    let start_y: i64 = base_y + 4 * y
    let row: i64 = (start_y << (sy as u64)) >> 2
    let col: i64 = (start_x << (sx as u64)) >> 2
    var sb_mask: i64 = 15
    if (*td).sb128 != 0 {
        sb_mask = 31
    }
    let sub_row: i64 = (row & sb_mask) >> (sy as u64)
    let sub_col: i64 = (col & sb_mask) >> (sx as u64)
    let step_x: i64 = av1blkdat.tx_w(tx) >> 2
    let step_y: i64 = av1blkdat.tx_h(tx) >> 2
    let max_x: i64 = ((*td).mi_cols * 4) >> (sx as u64)
    let max_y: i64 = ((*td).mi_rows * 4) >> (sy as u64)
    if start_x >= max_x || start_y >= max_y {
        return av1blkst.TD_OK
    }
    var mode: i64 = (*td).y_mode
    var is_cfl: i64 = 0
    if plane > 0 {
        mode = (*td).uv_mode
        if mode == av1blkdat.UV_CFL {
            is_cfl = 1
            mode = av1blkdat.DC_PRED
        }
    }
    var have_l: i64 = (*td).avail_l
    var have_u: i64 = (*td).avail_u
    if plane > 0 {
        have_l = (*td).avail_lc
        have_u = (*td).avail_uc
    }
    if x > 0 {
        have_l = 1
    }
    if y > 0 {
        have_u = 1
    }
    (*td).ev_plane = plane
    (*td).ev_x = start_x
    (*td).ev_y = start_y
    (*td).ev_x4 = start_x >> 2
    (*td).ev_y4 = start_y >> 2
    (*td).ev_tx_size = tx
    (*td).ev_tw = av1blkdat.tx_w(tx)
    (*td).ev_th = av1blkdat.tx_h(tx)
    (*td).ev_mode = mode
    (*td).ev_is_cfl = is_cfl
    (*td).ev_palette = 0
    (*td).ev_have_l = have_l
    (*td).ev_have_u = have_u
    (*td).ev_have_ar = bd_get(td, plane, sub_row - 1, sub_col + step_x)
    (*td).ev_have_bl = bd_get(td, plane, sub_row + step_y, sub_col - 1)
    if plane == 0 {
        (*td).max_luma_w = start_x + step_x * 4
        (*td).max_luma_h = start_y + step_y * 4
    }
    (*td).ev_eob = 0
    (*td).ev_tx_type = 0
    if (*td).skip == 0 {
        let coef: fn(u64, i64, i64, i64, i64) -> i64 = (*td).hook_coef
        let eob: i64 = coef(td as u64, plane, start_x >> 2, start_y >> 2, tx)
        if eob < 0 {
            return av1blkst.TD_ERR
        }
        (*td).ev_eob = eob
        (*td).n_coefs = (*td).n_coefs + 1
        (*td).n_eob_sum = (*td).n_eob_sum + eob
    }
    let hook: fn(u64, u64) = (*td).hook_tx
    hook((*td).hook_ctx, td as u64)
    (*td).n_tx = (*td).n_tx + 1
    store_loopfilter_tx(td, plane, row, col, tx)
    var i: i64 = 0
    while i < step_y {
        var j: i64 = 0
        while j < step_x {
            bd_set(td, plane, sub_row + i, sub_col + j, 1)
            j = j + 1
        }
        i = i + 1
    }
    return av1blkst.TD_OK
}

fn residual(td: *mut av1blkst.TileDec) -> i64 {
    var wchunks: i64 = (*td).bw4 >> 4
    var hchunks: i64 = (*td).bh4 >> 4
    if wchunks < 1 {
        wchunks = 1
    }
    if hchunks < 1 {
        hchunks = 1
    }
    var planes: i64 = 1
    if (*td).has_chroma != 0 {
        planes = 3
    }
    var cy: i64 = 0
    while cy < hchunks {
        var cx: i64 = 0
        while cx < wchunks {
            var plane: i64 = 0
            while plane < planes {
                var sx: i64 = 0
                var sy: i64 = 0
                if plane > 0 {
                    sx = (*td).ss_x
                    sy = (*td).ss_y
                }
                let tx: i64 = plane_tx_size(td, plane)
                let step_x: i64 = av1blkdat.tx_w(tx) >> 2
                let step_y: i64 = av1blkdat.tx_h(tx) >> 2
                let plane_sz: i64 = av1blkdat.subsampled_size((*td).mi_size, sx, sy)
                let n4w: i64 = av1blkdat.bw4(plane_sz)
                let n4h: i64 = av1blkdat.bh4(plane_sz)
                let base_x: i64 = ((*td).mi_col >> (sx as u64)) * 4
                let base_y: i64 = ((*td).mi_row >> (sy as u64)) * 4
                var lim_h: i64 = 16 >> (sy as u64)
                var lim_w: i64 = 16 >> (sx as u64)
                if n4h < lim_h {
                    lim_h = n4h
                }
                if n4w < lim_w {
                    lim_w = n4w
                }
                var y: i64 = 0
                while y < lim_h {
                    var x: i64 = 0
                    while x < lim_w {
                        let rc: i64 = transform_block(td, plane, base_x, base_y, tx, x + ((cx << 4) >> (sx as u64)), y + ((cy << 4) >> (sy as u64)))
                        if rc != av1blkst.TD_OK {
                            return rc
                        }
                        x = x + step_x
                    }
                    y = y + step_y
                }
                plane = plane + 1
            }
            cx = cx + 1
        }
        cy = cy + 1
    }
    return av1blkst.TD_OK
}
