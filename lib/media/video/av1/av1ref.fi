import media.video.av1.av1fg
import media.video.av1.av1seq
import media.video.av1.av1fhdr
import media.video.av1.av1mem

export { ref_state_new, ref_state_free, RefSlot, RefState, ref_update, ref_show_existing, ref_invalidate_all }

struct RefSlot {
    valid: i64,
    frame_id: i64,
    upscaled_width: i64,
    frame_width: i64,
    frame_height: i64,
    render_width: i64,
    render_height: i64,
    mi_cols: i64,
    mi_rows: i64,
    frame_type: i64,
    subsampling_x: i64,
    subsampling_y: i64,
    bit_depth: i64,
    order_hint: i64,
    showable_frame: i64,
    saved_order_hints: [i64; 8],
    gm_params: [i64; 48],
    lf_ref_deltas: [i64; 8],
    lf_mode_deltas: [i64; 2],
    feature_enabled: [i64; 64],
    feature_data: [i64; 64],
    film_grain: av1fg.FilmGrain,
}

struct RefState {
    slots: [RefSlot; 8],
    seen_frame_header: i64,
}

fn ref_invalidate_all(st: *mut RefState) {
    var i: usize = 0
    while i < 8 {
        (*st).slots[i].valid = 0
        (*st).slots[i].order_hint = 0
        i = i + 1
    }
}

fn save_slot(st: *mut RefState, i: usize, f: *mut av1fhdr.FrameHdr, s: *mut av1seq.SeqHdr) {
    let d: *mut RefSlot = &(*st).slots[i]
    (*d).valid = 1
    (*d).frame_id = (*f).current_frame_id
    (*d).upscaled_width = (*f).upscaled_width
    (*d).frame_width = (*f).frame_width
    (*d).frame_height = (*f).frame_height
    (*d).render_width = (*f).render_width
    (*d).render_height = (*f).render_height
    (*d).mi_cols = (*f).mi_cols
    (*d).mi_rows = (*f).mi_rows
    (*d).frame_type = (*f).frame_type
    (*d).subsampling_x = (*s).subsampling_x
    (*d).subsampling_y = (*s).subsampling_y
    (*d).bit_depth = (*s).bit_depth
    (*d).order_hint = (*f).order_hint
    (*d).showable_frame = (*f).showable_frame
    var k: usize = 0
    while k < 8 {
        (*d).saved_order_hints[k] = (*f).order_hints[k]
        (*d).lf_ref_deltas[k] = (*f).loop_filter_ref_deltas[k]
        k = k + 1
    }
    (*d).lf_mode_deltas[0] = (*f).loop_filter_mode_deltas[0]
    (*d).lf_mode_deltas[1] = (*f).loop_filter_mode_deltas[1]
    k = 0
    while k < 48 {
        (*d).gm_params[k] = (*f).gm_params[k]
        k = k + 1
    }
    k = 0
    while k < 64 {
        (*d).feature_enabled[k] = (*f).feature_enabled[k]
        (*d).feature_data[k] = (*f).feature_data[k]
        k = k + 1
    }
    (*d).film_grain = (*f).film_grain
}

fn ref_update(st: *mut RefState, f: *mut av1fhdr.FrameHdr, s: *mut av1seq.SeqHdr) {
    var i: usize = 0
    while i < 8 {
        if (((*f).refresh_frame_flags >> (i as u64)) & 1) == 1 {
            save_slot(st, i, f, s)
        }
        i = i + 1
    }
}

fn ref_show_existing(st: *mut RefState, f: *mut av1fhdr.FrameHdr) {
    if (*f).frame_type != av1fhdr.KEY_FRAME {
        return
    }
    let src: usize = (*f).frame_to_show_map_idx as usize
    var i: usize = 0
    while i < 8 {
        if i != src {
            (*st).slots[i] = (*st).slots[src]
        }
        i = i + 1
    }
}

fn ref_state_new() -> *mut RefState {
    return av1mem.av1_zalloc[RefState]()
}

fn ref_state_free(st: *mut RefState) {
    av1mem.av1_zfree[RefState](st)
}
