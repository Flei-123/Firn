import media.video.av1.av1blkst
import media.video.av1.av1blkdat
import media.video.av1.av1interdef
import media.video.av1.av1interctx
import media.video.av1.av1intermv

export { find_warp_samples, has_overlappable_candidates, SAMPLES_MAX }

const SAMPLES_MAX: i64 = 8

fn inside(td: *mut av1blkst.TileDec, r: i64, c: i64) -> bool {
    return c >= (*td).mi_col_start && c < (*td).mi_col_end && r >= (*td).mi_row_start && r < (*td).mi_row_end
}

fn add_sample(td: *mut av1blkst.TileDec, scanned: *mut i64, delta_row: i64, delta_col: i64) {
    if *scanned >= SAMPLES_MAX {
        return
    }
    let r: i64 = (*td).mi_row + delta_row
    let c: i64 = (*td).mi_col + delta_col
    if !inside(td, r, c) {
        return
    }
    if av1blkst.mi_get(td, (*td).wr_a, r, c) == 0 {
        return
    }
    if av1interctx.nb_ref(td, r, c, 0) != (*td).ref_frame[0] || av1interctx.nb_ref(td, r, c, 1) != av1interdef.NONE_FRAME {
        return
    }
    let cand_size: i64 = av1blkst.mi_get(td, (*td).mi_size_a, r, c)
    let w4: i64 = av1blkdat.bw4(cand_size)
    let h4: i64 = av1blkdat.bh4(cand_size)
    let cand_row: i64 = r & (0 - h4)
    let cand_col: i64 = c & (0 - w4)
    let mid_y: i64 = cand_row * 4 + h4 * 2 - 1
    let mid_x: i64 = cand_col * 4 + w4 * 2 - 1
    let bw: i64 = av1blkdat.bw_px((*td).mi_size)
    let bh: i64 = av1blkdat.bh_px((*td).mi_size)
    var mx: i64 = bw
    if bh > mx {
        mx = bh
    }
    let thresh: i64 = av1interdef.clip3(16, 112, mx)
    let mv_r: i64 = av1intermv.mv_load(td, r, c, 0, 0)
    let mv_c: i64 = av1intermv.mv_load(td, r, c, 0, 1)
    let diff: i64 = av1interdef.abs_i(mv_r - (*td).mvs[0]) + av1interdef.abs_i(mv_c - (*td).mvs[1])
    let valid: bool = diff <= thresh
    *scanned = *scanned + 1
    if !valid && *scanned > 1 {
        return
    }
    let n: i64 = (*td).num_samples * 4
    (*td).samples[n as usize] = mid_y * 8
    (*td).samples[(n + 1) as usize] = mid_x * 8
    (*td).samples[(n + 2) as usize] = mid_y * 8 + mv_r
    (*td).samples[(n + 3) as usize] = mid_x * 8 + mv_c
    if valid {
        (*td).num_samples = (*td).num_samples + 1
    }
}

fn find_warp_samples(td: *mut av1blkst.TileDec) {
    (*td).num_samples = 0
    var scanned: i64 = 0
    let w4: i64 = (*td).bw4
    let h4: i64 = (*td).bh4
    var do_top_left: bool = true
    var do_top_right: bool = true
    if (*td).avail_u != 0 {
        let src_w: i64 = av1blkdat.bw4(av1blkst.mi_get(td, (*td).mi_size_a, (*td).mi_row - 1, (*td).mi_col))
        if w4 <= src_w {
            let col_off: i64 = 0 - ((*td).mi_col & (src_w - 1))
            if col_off < 0 {
                do_top_left = false
            }
            if col_off + src_w > w4 {
                do_top_right = false
            }
            add_sample(td, &scanned, 0 - 1, 0)
        } else {
            var lim: i64 = (*td).mi_cols - (*td).mi_col
            if w4 < lim {
                lim = w4
            }
            var i: i64 = 0
            while i < lim {
                let sw: i64 = av1blkdat.bw4(av1blkst.mi_get(td, (*td).mi_size_a, (*td).mi_row - 1, (*td).mi_col + i))
                var step: i64 = w4
                if sw < step {
                    step = sw
                }
                add_sample(td, &scanned, 0 - 1, i)
                i = i + step
            }
        }
    }
    if (*td).avail_l != 0 {
        let src_h: i64 = av1blkdat.bh4(av1blkst.mi_get(td, (*td).mi_size_a, (*td).mi_row, (*td).mi_col - 1))
        if h4 <= src_h {
            let row_off: i64 = 0 - ((*td).mi_row & (src_h - 1))
            if row_off < 0 {
                do_top_left = false
            }
            add_sample(td, &scanned, 0, 0 - 1)
        } else {
            var lim: i64 = (*td).mi_rows - (*td).mi_row
            if h4 < lim {
                lim = h4
            }
            var i: i64 = 0
            while i < lim {
                let sh: i64 = av1blkdat.bh4(av1blkst.mi_get(td, (*td).mi_size_a, (*td).mi_row + i, (*td).mi_col - 1))
                var step: i64 = h4
                if sh < step {
                    step = sh
                }
                add_sample(td, &scanned, i, 0 - 1)
                i = i + step
            }
        }
    }
    if do_top_left {
        add_sample(td, &scanned, 0 - 1, 0 - 1)
    }
    if do_top_right {
        var mx: i64 = w4
        if h4 > mx {
            mx = h4
        }
        if mx <= 16 {
            add_sample(td, &scanned, 0 - 1, w4)
        }
    }
    if (*td).num_samples == 0 && scanned > 0 {
        (*td).num_samples = 1
    }
}

fn has_overlappable_candidates(td: *mut av1blkst.TileDec) -> bool {
    if (*td).avail_u != 0 {
        var lim: i64 = (*td).mi_col + (*td).bw4
        if (*td).mi_cols < lim {
            lim = (*td).mi_cols
        }
        var x: i64 = (*td).mi_col
        while x < lim {
            var x5: i64 = x | 1
            if x5 >= (*td).mi_cols {
                x5 = (*td).mi_cols - 1
            }
            if av1interctx.nb_ref(td, (*td).mi_row - 1, x5, 0) > av1interdef.INTRA_FRAME {
                return true
            }
            x = x + 2
        }
    }
    if (*td).avail_l != 0 {
        var lim: i64 = (*td).mi_row + (*td).bh4
        if (*td).mi_rows < lim {
            lim = (*td).mi_rows
        }
        var y: i64 = (*td).mi_row
        while y < lim {
            var y5: i64 = y | 1
            if y5 >= (*td).mi_rows {
                y5 = (*td).mi_rows - 1
            }
            if av1interctx.nb_ref(td, y5, (*td).mi_col - 1, 0) > av1interdef.INTRA_FRAME {
                return true
            }
            y = y + 2
        }
    }
    return false
}
