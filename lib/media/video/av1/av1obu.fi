// SPDX-License-Identifier: MPL-2.0
import media.video.vp9.vp9mem

export {
    Obu, obu_parse, OBU_SEQ, OBU_TD, OBU_FRAME_HDR, OBU_TILE_GROUP, OBU_METADATA, OBU_FRAME, OBU_REDUNDANT_HDR,
    OBU_TILE_LIST, OBU_PADDING, OBU_OK, OBU_ERR, obu_leb128,
}

const OBU_SEQ: i64 = 1
const OBU_TD: i64 = 2
const OBU_FRAME_HDR: i64 = 3
const OBU_TILE_GROUP: i64 = 4
const OBU_METADATA: i64 = 5
const OBU_FRAME: i64 = 6
const OBU_REDUNDANT_HDR: i64 = 7
const OBU_TILE_LIST: i64 = 8
const OBU_PADDING: i64 = 15
const OBU_OK: i64 = 0
const OBU_ERR: i64 = 0 - 1

struct Obu {
    kind: i64,
    has_ext: bool,
    tid: i64,
    sid: i64,
    has_size: bool,
    pay_off: usize,
    pay_len: usize,
    total: usize,
}

fn obu_leb128(data: u64, size: usize, pos: usize, out: *mut i64) -> i64 {
    var v: i64 = 0
    var i: usize = 0
    while i < 8 {
        if pos + i >= size {
            return 0 - 1
        }
        let b: i64 = vp9mem.ld8(data, pos + i)
        v = v + ((b & 127) << ((i * 7) as u64))
        i = i + 1
        if (b & 128) == 0 {
            *out = v
            return i as i64
        }
    }
    return 0 - 1
}

fn obu_parse(data: u64, size: usize, pos: usize, o: *mut Obu) -> i64 {
    if pos >= size {
        return OBU_ERR
    }
    let h: i64 = vp9mem.ld8(data, pos)
    if (h & 128) != 0 {
        return OBU_ERR
    }
    (*o).kind = (h >> 3) & 15
    (*o).has_ext = ((h >> 2) & 1) == 1
    (*o).has_size = ((h >> 1) & 1) == 1
    (*o).tid = 0
    (*o).sid = 0
    var p: usize = pos + 1
    if (*o).has_ext {
        if p >= size {
            return OBU_ERR
        }
        let e: i64 = vp9mem.ld8(data, p)
        (*o).tid = e >> 5
        (*o).sid = (e >> 3) & 3
        p = p + 1
    }
    var len: i64 = 0
    if (*o).has_size {
        let n: i64 = obu_leb128(data, size, p, &len)
        if n < 0 {
            return OBU_ERR
        }
        p = p + n as usize
    } else {
        len = (size - p) as i64
    }
    if len < 0 || (len as usize) > size - p {
        return OBU_ERR
    }
    (*o).pay_off = p
    (*o).pay_len = len as usize
    (*o).total = p + (len as usize) - pos
    return OBU_OK
}
