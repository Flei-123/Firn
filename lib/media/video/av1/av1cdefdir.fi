// SPDX-License-Identifier: MPL-2.0
import media.video.av1.av1ipm

export { cdef_find_dir, CDEF_SCRATCH_BYTES }

const CDEF_SCRATCH_BYTES: usize = 1920

static DIV_TABLE: [i32; 9] = [0, 840, 420, 280, 210, 168, 140, 120, 105]

fn add64(p: u64, i: i64, v: i64) {
    av1ipm.st64(p, i, av1ipm.ld64(p, i) + v)
}

fn sq(v: i64) -> i64 {
    return v * v
}

fn accumulate(scr: u64, plane: u64, stride: i64, x0: i64, y0: i64, shift: i64) {
    var i: i64 = 0
    while i < 8 {
        var j: i64 = 0
        while j < 8 {
            let x: i64 = (av1ipm.ld(plane, (y0 + i) * stride + x0 + j) >> (shift as u64)) - 128
            add64(scr, i + j, x)
            add64(scr, 15 + i + (j >> 1), x)
            add64(scr, 30 + i, x)
            add64(scr, 45 + 3 + i - (j >> 1), x)
            add64(scr, 60 + 7 + i - j, x)
            add64(scr, 75 + 3 - (i >> 1) + j, x)
            add64(scr, 90 + j, x)
            add64(scr, 105 + (i >> 1) + j, x)
            j = j + 1
        }
        i = i + 1
    }
}

fn p_at(scr: u64, d: i64, i: i64) -> i64 {
    return av1ipm.ld64(scr, d * 15 + i)
}

fn compute_costs(scr: u64) {
    var i: i64 = 0
    while i < 8 {
        av1ipm.st64(scr, 120 + i, 0)
        i = i + 1
    }
    i = 0
    while i < 8 {
        add64(scr, 122, sq(p_at(scr, 2, i)))
        add64(scr, 126, sq(p_at(scr, 6, i)))
        i = i + 1
    }
    av1ipm.st64(scr, 122, av1ipm.ld64(scr, 122) * (DIV_TABLE[8] as i64))
    av1ipm.st64(scr, 126, av1ipm.ld64(scr, 126) * (DIV_TABLE[8] as i64))
    i = 0
    while i < 7 {
        let w: i64 = DIV_TABLE[(i + 1) as usize] as i64
        add64(scr, 120, (sq(p_at(scr, 0, i)) + sq(p_at(scr, 0, 14 - i))) * w)
        add64(scr, 124, (sq(p_at(scr, 4, i)) + sq(p_at(scr, 4, 14 - i))) * w)
        i = i + 1
    }
    add64(scr, 120, sq(p_at(scr, 0, 7)) * (DIV_TABLE[8] as i64))
    add64(scr, 124, sq(p_at(scr, 4, 7)) * (DIV_TABLE[8] as i64))
    var d: i64 = 1
    while d < 8 {
        var j: i64 = 0
        while j < 5 {
            add64(scr, 120 + d, sq(p_at(scr, d, 3 + j)))
            j = j + 1
        }
        av1ipm.st64(scr, 120 + d, av1ipm.ld64(scr, 120 + d) * (DIV_TABLE[8] as i64))
        j = 0
        while j < 3 {
            add64(scr, 120 + d, (sq(p_at(scr, d, j)) + sq(p_at(scr, d, 10 - j))) * (DIV_TABLE[(2 * j + 2) as usize] as i64))
            j = j + 1
        }
        d = d + 2
    }
}

fn cdef_find_dir(scr: u64, plane: u64, stride: i64, x0: i64, y0: i64, bit_depth: i64) -> i64 {
    var i: i64 = 0
    while i < 120 {
        av1ipm.st64(scr, i, 0)
        i = i + 1
    }
    accumulate(scr, plane, stride, x0, y0, bit_depth - 8)
    compute_costs(scr)
    var best: i64 = 0
    var dir: i64 = 0
    var d: i64 = 0
    while d < 8 {
        if av1ipm.ld64(scr, 120 + d) > best {
            best = av1ipm.ld64(scr, 120 + d)
            dir = d
        }
        d = d + 1
    }
    let v: i64 = (best - av1ipm.ld64(scr, 120 + ((dir + 4) & 7))) >> 10
    return v * 8 + dir
}
