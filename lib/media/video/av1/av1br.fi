import std.rt
import media.video.vp9.vp9mem

export { BR, br_new, br_trace, br_pos, br_align, br_ok, rd, rd_bit, rd_su, rd_ns, rd_le, rd_uvlc, tr_emit }

struct BR {
    p: u64,
    bit: i64,
    nbits: i64,
    err: bool,
    tr: u64,
}

fn br_new(p: u64, n: usize) -> BR {
    return BR { p: p, bit: 0, nbits: (n as i64) * 8, err: false, tr: 0 }
}

fn br_trace(r: *mut BR, buf: u64) {
    (*r).tr = buf
}

fn br_pos(r: *mut BR) -> i64 {
    return (*r).bit
}

fn br_ok(r: *mut BR) -> bool {
    return !(*r).err
}

fn raw_bit(r: *mut BR) -> i64 {
    if (*r).bit >= (*r).nbits {
        (*r).err = true
        return 0
    }
    let byte: i64 = vp9mem.ld8((*r).p, ((*r).bit >> 3) as usize)
    let v: i64 = (byte >> ((7 - ((*r).bit & 7)) as u64)) & 1
    (*r).bit = (*r).bit + 1
    return v
}

fn raw_lit(r: *mut BR, n: i64) -> i64 {
    var v: i64 = 0
    var i: i64 = 0
    while i < n {
        v = (v << 1) | raw_bit(r)
        i = i + 1
    }
    return v
}

fn tr_emit(r: *mut BR, name: str, nbits: i64, v: i64) {
    if (*r).tr == 0 {
        return
    }
    let b: *mut rt.Buf = (*r).tr as *mut rt.Buf
    rt.buf_push_bytes(b, name.p as u64, name.n)
    rt.buf_push(b, 32 as u8)
    rt.buf_push_dec_i64(b, nbits)
    rt.buf_push(b, 32 as u8)
    rt.buf_push_dec_i64(b, v)
    rt.buf_push(b, 10 as u8)
}

fn rd(r: *mut BR, n: i64, name: str) -> i64 {
    let v: i64 = raw_lit(r, n)
    tr_emit(r, name, n, v)
    return v
}

fn rd_bit(r: *mut BR, name: str) -> i64 {
    return rd(r, 1, name)
}

fn rd_su(r: *mut BR, n: i64, name: str) -> i64 {
    var v: i64 = raw_lit(r, n)
    let sign: i64 = 1 << ((n - 1) as u64)
    if (v & sign) != 0 {
        v = v - 2 * sign
    }
    tr_emit(r, name, n, v)
    return v
}

fn rd_ns(r: *mut BR, n: i64, name: str) -> i64 {
    var w: i64 = 0
    var x: i64 = n
    while x != 0 {
        x = x >> 1
        w = w + 1
    }
    let m: i64 = (1 << (w as u64)) - n
    let v: i64 = raw_lit(r, w - 1)
    if v < m {
        tr_emit(r, name, w - 1, v)
        return v
    }
    let extra: i64 = raw_bit(r)
    let res: i64 = (v << 1) - m + extra
    tr_emit(r, name, w, res)
    return res
}

fn rd_le(r: *mut BR, nbytes: i64, name: str) -> i64 {
    var t: i64 = 0
    var i: i64 = 0
    while i < nbytes {
        t = t + (raw_lit(r, 8) << ((i * 8) as u64))
        i = i + 1
    }
    tr_emit(r, name, nbytes * 8, t)
    return t
}

fn rd_uvlc(r: *mut BR, name: str) -> i64 {
    let start: i64 = (*r).bit
    var lz: i64 = 0
    while lz < 32 {
        if raw_bit(r) == 1 {
            break
        }
        if (*r).err {
            return 0
        }
        lz = lz + 1
    }
    if lz >= 32 {
        tr_emit(r, name, (*r).bit - start, 4294967295)
        return 4294967295
    }
    let v: i64 = raw_lit(r, lz) + (1 << (lz as u64)) - 1
    tr_emit(r, name, (*r).bit - start, v)
    return v
}

fn br_align(r: *mut BR) {
    (*r).bit = ((*r).bit + 7) & (0 - 8)
}
