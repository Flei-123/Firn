import media.video.av1.av1ipm
import media.video.av1.av1tabintra

export { pred_filter_intra }

fn tap(mode: i64, k: i64, t: i64) -> i64 {
    let p: u64 = av1tabintra.filter_intra_taps_addr()
    return (*((p + (((mode * 8 + k) * 8 + t) * 2) as u64) as *mut i16)) as i64
}

fn pred_filter_intra(dst: u64, stride: i64, w: i64, h: i64, above: u64, left: u64, mode: i64, bd: i64, buf: u64) {
    var r: i64 = 0
    while r < h {
        av1ipm.st(buf, (r + 1) * 33, av1ipm.ld(left, r))
        r = r + 1
    }
    var c0: i64 = 0
    while c0 < w + 1 {
        av1ipm.st(buf, c0, av1ipm.ld(above, c0 - 1))
        c0 = c0 + 1
    }
    r = 1
    while r < h + 1 {
        var c: i64 = 1
        while c < w + 1 {
            let p0: i64 = av1ipm.ld(buf, (r - 1) * 33 + c - 1)
            let p1: i64 = av1ipm.ld(buf, (r - 1) * 33 + c)
            let p2: i64 = av1ipm.ld(buf, (r - 1) * 33 + c + 1)
            let p3: i64 = av1ipm.ld(buf, (r - 1) * 33 + c + 2)
            let p4: i64 = av1ipm.ld(buf, (r - 1) * 33 + c + 3)
            let p5: i64 = av1ipm.ld(buf, r * 33 + c - 1)
            let p6: i64 = av1ipm.ld(buf, (r + 1) * 33 + c - 1)
            var k: i64 = 0
            while k < 8 {
                let pr: i64 = tap(mode, k, 0) * p0 + tap(mode, k, 1) * p1 + tap(mode, k, 2) * p2 + tap(mode, k, 3) * p3 + tap(mode, k, 4) * p4 + tap(mode, k, 5) * p5 + tap(mode, k, 6) * p6
                av1ipm.st(buf, (r + (k >> 2)) * 33 + c + (k & 3), av1ipm.clip_px((pr + 8) >> 4, bd))
                k = k + 1
            }
            c = c + 4
        }
        r = r + 2
    }
    r = 0
    while r < h {
        var c: i64 = 0
        while c < w {
            av1ipm.st(dst, r * stride + c, av1ipm.ld(buf, (r + 1) * 33 + c + 1))
            c = c + 1
        }
        r = r + 1
    }
}
