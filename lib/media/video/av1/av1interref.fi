import media.video.av1.av1blkst
import media.video.av1.av1cdfidx
import media.video.av1.av1fhdr
import media.video.av1.av1interdef
import media.video.av1.av1interctx
import media.video.av1.av1modeinfo

export { read_ref_frames, SEG_LVL_REF_FRAME, SEG_LVL_GLOBALMV }

const SEG_LVL_REF_FRAME: i64 = 5
const SEG_LVL_GLOBALMV: i64 = 7
const UNIDIR_COMP_REFERENCE: i64 = 0

fn single_ref(td: *mut av1blkst.TileDec, ctx: i64, p: i64) -> i64 {
    return av1blkst.rd_sym(td, av1cdfidx.CDF_SINGLE_REF + (ctx * 18 + (p - 1) * 3) as usize, 2)
}

fn comp_ref_bit(td: *mut av1blkst.TileDec, ctx: i64, p: i64) -> i64 {
    return av1blkst.rd_sym(td, av1cdfidx.CDF_COMP_REF + (ctx * 9 + p * 3) as usize, 2)
}

fn comp_bwdref_bit(td: *mut av1blkst.TileDec, ctx: i64, p: i64) -> i64 {
    return av1blkst.rd_sym(td, av1cdfidx.CDF_COMP_BWDREF + (ctx * 6 + p * 3) as usize, 2)
}

fn uni_comp_bit(td: *mut av1blkst.TileDec, ctx: i64, p: i64) -> i64 {
    return av1blkst.rd_sym(td, av1cdfidx.CDF_UNI_COMP_REF + (ctx * 9 + p * 3) as usize, 2)
}

fn set_refs(td: *mut av1blkst.TileDec, r0: i64, r1: i64) {
    (*td).ref_frame[0] = r0
    (*td).ref_frame[1] = r1
}

fn read_single(td: *mut av1blkst.TileDec) {
    if single_ref(td, av1interctx.ctx_single_p1(td), 1) == 1 {
        if single_ref(td, av1interctx.ctx_single_p2(td), 2) == 0 {
            if single_ref(td, av1interctx.ctx_single_p6(td), 6) == 1 {
                set_refs(td, av1interdef.ALTREF2_FRAME, av1interdef.NONE_FRAME)
            } else {
                set_refs(td, av1interdef.BWDREF_FRAME, av1interdef.NONE_FRAME)
            }
        } else {
            set_refs(td, av1interdef.ALTREF_FRAME, av1interdef.NONE_FRAME)
        }
        return
    }
    if single_ref(td, av1interctx.ctx_single_p3(td), 3) == 1 {
        if single_ref(td, av1interctx.ctx_single_p5(td), 5) == 1 {
            set_refs(td, av1interdef.GOLDEN_FRAME, av1interdef.NONE_FRAME)
        } else {
            set_refs(td, av1interdef.LAST3_FRAME, av1interdef.NONE_FRAME)
        }
    } else if single_ref(td, av1interctx.ctx_single_p4(td), 4) == 1 {
        set_refs(td, av1interdef.LAST2_FRAME, av1interdef.NONE_FRAME)
    } else {
        set_refs(td, av1interdef.LAST_FRAME, av1interdef.NONE_FRAME)
    }
}

fn read_uni_comp(td: *mut av1blkst.TileDec) {
    if uni_comp_bit(td, av1interctx.ctx_single_p1(td), 0) == 1 {
        set_refs(td, av1interdef.BWDREF_FRAME, av1interdef.ALTREF_FRAME)
        return
    }
    if uni_comp_bit(td, av1interctx.ctx_uni_comp_p1(td), 1) == 1 {
        if uni_comp_bit(td, av1interctx.ctx_single_p5(td), 2) == 1 {
            set_refs(td, av1interdef.LAST_FRAME, av1interdef.GOLDEN_FRAME)
        } else {
            set_refs(td, av1interdef.LAST_FRAME, av1interdef.LAST3_FRAME)
        }
    } else {
        set_refs(td, av1interdef.LAST_FRAME, av1interdef.LAST2_FRAME)
    }
}

fn read_bidir_comp(td: *mut av1blkst.TileDec) {
    var r0: i64 = av1interdef.LAST_FRAME
    if comp_ref_bit(td, av1interctx.ctx_single_p3(td), 0) == 0 {
        if comp_ref_bit(td, av1interctx.ctx_single_p4(td), 1) == 1 {
            r0 = av1interdef.LAST2_FRAME
        }
    } else {
        r0 = av1interdef.LAST3_FRAME
        if comp_ref_bit(td, av1interctx.ctx_single_p5(td), 2) == 1 {
            r0 = av1interdef.GOLDEN_FRAME
        }
    }
    var r1: i64 = av1interdef.ALTREF_FRAME
    if comp_bwdref_bit(td, av1interctx.ctx_single_p2(td), 0) == 0 {
        r1 = av1interdef.BWDREF_FRAME
        if comp_bwdref_bit(td, av1interctx.ctx_single_p6(td), 1) == 1 {
            r1 = av1interdef.ALTREF2_FRAME
        }
    }
    set_refs(td, r0, r1)
}

fn read_ref_frames(td: *mut av1blkst.TileDec) {
    let fh: *mut av1fhdr.FrameHdr = (*td).fh
    if (*td).skip_mode != 0 {
        set_refs(td, (*fh).skip_mode_frame[0], (*fh).skip_mode_frame[1])
        return
    }
    if av1modeinfo.seg_feature_active(td, SEG_LVL_REF_FRAME) {
        set_refs(td, (*fh).feature_data[((*td).segment_id * 8 + SEG_LVL_REF_FRAME) as usize], av1interdef.NONE_FRAME)
        return
    }
    if av1modeinfo.seg_feature_active(td, av1modeinfo.SEG_LVL_SKIP) || av1modeinfo.seg_feature_active(td, SEG_LVL_GLOBALMV) {
        set_refs(td, av1interdef.LAST_FRAME, av1interdef.NONE_FRAME)
        return
    }
    var comp: i64 = 0
    if (*fh).reference_select == 1 && (*td).bw4 >= 2 && (*td).bh4 >= 2 {
        comp = av1blkst.rd_sym(td, av1cdfidx.CDF_COMP_INTER + (av1interctx.ctx_comp_inter(td) * 3) as usize, 2)
    }
    if comp == 0 {
        read_single(td)
        return
    }
    let ct: i64 = av1blkst.rd_sym(td, av1cdfidx.CDF_COMP_REF_TYPE + (av1interctx.ctx_comp_ref_type(td) * 3) as usize, 2)
    if ct == UNIDIR_COMP_REFERENCE {
        read_uni_comp(td)
    } else {
        read_bidir_comp(td)
    }
}
