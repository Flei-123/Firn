import media.video.av1.av1blkst
import media.video.av1.av1blkdat
import media.video.av1.av1interdef
import media.video.av1.av1mvmi
import media.video.av1.av1mvglob

export { scan_row, scan_col, scan_point }

fn is_global_block(td: *mut av1blkst.TileDec, row: i64, col: i64, ref_frame: i64) -> bool {
    let mode: i64 = av1blkst.mi_get(td, (*td).ymode_a, row, col)
    if mode != av1interdef.GLOBALMV && mode != av1interdef.GLOBAL_GLOBALMV {
        return false
    }
    if (*(*td).fh).gm_type[ref_frame as usize] <= 1 {
        return false
    }
    let size: i64 = av1blkst.mi_get(td, (*td).mi_size_a, row, col)
    return av1blkdat.bw4(size) >= 2 && av1blkdat.bh4(size) >= 2
}

fn cand_comp(td: *mut av1blkst.TileDec, row: i64, col: i64, list: i64, gl: bool, gidx: i64, comp: i64) -> i64 {
    if gl {
        return (*td).global_mv[(gidx * 2 + comp) as usize]
    }
    return av1mvglob.lower_comp((*td).fh, av1mvmi.mv_get(td, row, col, list, comp))
}

fn add_single(td: *mut av1blkst.TileDec, ms: *mut [i64; 24], row: i64, col: i64, cand_list: i64, weight: i64) {
    let gl: bool = is_global_block(td, row, col, (*td).ref_frame[0])
    let r: i64 = cand_comp(td, row, col, cand_list, gl, 0, 0)
    let c: i64 = cand_comp(td, row, col, cand_list, gl, 0, 1)
    if av1interdef.has_newmv(av1blkst.mi_get(td, (*td).ymode_a, row, col)) {
        (*ms)[av1mvmi.SC_NEW] = (*ms)[av1mvmi.SC_NEW] + 1
    }
    (*ms)[av1mvmi.SC_FOUND] = 1
    av1mvmi.stack_add(td, false, r, c, 0, 0, weight)
}

fn add_compound(td: *mut av1blkst.TileDec, ms: *mut [i64; 24], row: i64, col: i64, weight: i64) {
    let gl0: bool = is_global_block(td, row, col, (*td).ref_frame[0])
    let gl1: bool = is_global_block(td, row, col, (*td).ref_frame[1])
    let r0: i64 = cand_comp(td, row, col, 0, gl0, 0, 0)
    let c0: i64 = cand_comp(td, row, col, 0, gl0, 0, 1)
    let r1: i64 = cand_comp(td, row, col, 1, gl1, 1, 0)
    let c1: i64 = cand_comp(td, row, col, 1, gl1, 1, 1)
    if av1interdef.has_newmv(av1blkst.mi_get(td, (*td).ymode_a, row, col)) {
        (*ms)[av1mvmi.SC_NEW] = (*ms)[av1mvmi.SC_NEW] + 1
    }
    (*ms)[av1mvmi.SC_FOUND] = 1
    av1mvmi.stack_add(td, true, r0, c0, r1, c1, weight)
}

fn add_ref_mv_candidate(td: *mut av1blkst.TileDec, ms: *mut [i64; 24], row: i64, col: i64, weight: i64) {
    if av1blkst.mi_get(td, (*td).inter_a, row, col) == 0 {
        return
    }
    let f0: i64 = av1mvmi.ref_get(td, row, col, 0)
    let f1: i64 = av1mvmi.ref_get(td, row, col, 1)
    if av1mvmi.td_compound(td) {
        if f0 == (*td).ref_frame[0] && f1 == (*td).ref_frame[1] {
            add_compound(td, ms, row, col, weight)
        }
    } else {
        if f0 == (*td).ref_frame[0] {
            add_single(td, ms, row, col, 0, weight)
        }
        if f1 == (*td).ref_frame[0] {
            add_single(td, ms, row, col, 1, weight)
        }
    }
}

fn scan_row(td: *mut av1blkst.TileDec, ms: *mut [i64; 24], delta_row_in: i64) {
    var delta_row: i64 = delta_row_in
    var delta_col: i64 = 0
    var end4: i64 = (*td).bw4
    if (*td).mi_cols - (*td).mi_col < end4 {
        end4 = (*td).mi_cols - (*td).mi_col
    }
    if end4 > 16 {
        end4 = 16
    }
    var far: bool = false
    if delta_row < 0 - 1 {
        far = true
        delta_row = delta_row + ((*td).mi_row & 1)
        delta_col = 1 - ((*td).mi_col & 1)
    }
    var i: i64 = 0
    while i < end4 {
        let r: i64 = (*td).mi_row + delta_row
        let c: i64 = (*td).mi_col + delta_col + i
        if !av1mvmi.is_inside(td, r, c) {
            break
        }
        var len: i64 = av1blkdat.bw4(av1blkst.mi_get(td, (*td).mi_size_a, r, c))
        if (*td).bw4 < len {
            len = (*td).bw4
        }
        if far && len < 2 {
            len = 2
        }
        if (*td).bw4 >= 16 && len < 4 {
            len = 4
        }
        add_ref_mv_candidate(td, ms, r, c, len * 2)
        i = i + len
    }
}

fn scan_col(td: *mut av1blkst.TileDec, ms: *mut [i64; 24], delta_col_in: i64) {
    var delta_col: i64 = delta_col_in
    var delta_row: i64 = 0
    var end4: i64 = (*td).bh4
    if (*td).mi_rows - (*td).mi_row < end4 {
        end4 = (*td).mi_rows - (*td).mi_row
    }
    if end4 > 16 {
        end4 = 16
    }
    var far: bool = false
    if delta_col < 0 - 1 {
        far = true
        delta_row = 1 - ((*td).mi_row & 1)
        delta_col = delta_col + ((*td).mi_col & 1)
    }
    var i: i64 = 0
    while i < end4 {
        let r: i64 = (*td).mi_row + delta_row + i
        let c: i64 = (*td).mi_col + delta_col
        if !av1mvmi.is_inside(td, r, c) {
            break
        }
        var len: i64 = av1blkdat.bh4(av1blkst.mi_get(td, (*td).mi_size_a, r, c))
        if (*td).bh4 < len {
            len = (*td).bh4
        }
        if far && len < 2 {
            len = 2
        }
        if (*td).bh4 >= 16 && len < 4 {
            len = 4
        }
        add_ref_mv_candidate(td, ms, r, c, len * 2)
        i = i + len
    }
}

fn scan_point(td: *mut av1blkst.TileDec, ms: *mut [i64; 24], delta_row: i64, delta_col: i64) {
    let r: i64 = (*td).mi_row + delta_row
    let c: i64 = (*td).mi_col + delta_col
    if av1mvmi.is_inside(td, r, c) && av1blkst.mi_get(td, (*td).wr_a, r, c) != 0 {
        add_ref_mv_candidate(td, ms, r, c, 4)
    }
}
