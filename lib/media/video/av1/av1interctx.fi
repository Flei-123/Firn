import media.video.av1.av1blkst
import media.video.av1.av1interdef

export {
    nb_ref, nb_ref_above, nb_ref_left, count_refs, ref_count_ctx, ctx_intra_inter, ctx_comp_inter, ctx_comp_ref_type,
    ctx_single_p1, ctx_single_p2, ctx_single_p3, ctx_single_p4, ctx_single_p5, ctx_single_p6,
    ctx_uni_comp_p1, ctx_interp, ctx_comp_group, ctx_compound_idx, ctx_skip_mode,
}

fn nb_ref(td: *mut av1blkst.TileDec, row: i64, col: i64, k: i64) -> i64 {
    return av1blkst.ld((*td).ref_a, (row * (*td).mi_cols + col) * 2 + k) - 1
}

fn nb_ref_above(td: *mut av1blkst.TileDec, k: i64) -> i64 {
    if (*td).avail_u == 0 {
        if k == 0 {
            return av1interdef.INTRA_FRAME
        }
        return av1interdef.NONE_FRAME
    }
    return nb_ref(td, (*td).mi_row - 1, (*td).mi_col, k)
}

fn nb_ref_left(td: *mut av1blkst.TileDec, k: i64) -> i64 {
    if (*td).avail_l == 0 {
        if k == 0 {
            return av1interdef.INTRA_FRAME
        }
        return av1interdef.NONE_FRAME
    }
    return nb_ref(td, (*td).mi_row, (*td).mi_col - 1, k)
}

fn is_backward(r: i64) -> i64 {
    if r >= av1interdef.BWDREF_FRAME && r <= av1interdef.ALTREF_FRAME {
        return 1
    }
    return 0
}

fn b2i(b: bool) -> i64 {
    if b {
        return 1
    }
    return 0
}

fn count_refs(td: *mut av1blkst.TileDec, frame_type: i64) -> i64 {
    var c: i64 = 0
    if (*td).avail_u != 0 {
        if nb_ref_above(td, 0) == frame_type {
            c = c + 1
        }
        if nb_ref_above(td, 1) == frame_type {
            c = c + 1
        }
    }
    if (*td).avail_l != 0 {
        if nb_ref_left(td, 0) == frame_type {
            c = c + 1
        }
        if nb_ref_left(td, 1) == frame_type {
            c = c + 1
        }
    }
    return c
}

fn ref_count_ctx(c0: i64, c1: i64) -> i64 {
    if c0 < c1 {
        return 0
    }
    if c0 == c1 {
        return 1
    }
    return 2
}

fn ctx_single_p1(td: *mut av1blkst.TileDec) -> i64 {
    let fwd: i64 = count_refs(td, 1) + count_refs(td, 2) + count_refs(td, 3) + count_refs(td, 4)
    let bwd: i64 = count_refs(td, 5) + count_refs(td, 6) + count_refs(td, 7)
    return ref_count_ctx(fwd, bwd)
}

fn ctx_single_p2(td: *mut av1blkst.TileDec) -> i64 {
    return ref_count_ctx(count_refs(td, 5) + count_refs(td, 6), count_refs(td, 7))
}

fn ctx_single_p3(td: *mut av1blkst.TileDec) -> i64 {
    return ref_count_ctx(count_refs(td, 1) + count_refs(td, 2), count_refs(td, 3) + count_refs(td, 4))
}

fn ctx_single_p4(td: *mut av1blkst.TileDec) -> i64 {
    return ref_count_ctx(count_refs(td, 1), count_refs(td, 2))
}

fn ctx_single_p5(td: *mut av1blkst.TileDec) -> i64 {
    return ref_count_ctx(count_refs(td, 3), count_refs(td, 4))
}

fn ctx_single_p6(td: *mut av1blkst.TileDec) -> i64 {
    return ref_count_ctx(count_refs(td, 5), count_refs(td, 6))
}

fn ctx_uni_comp_p1(td: *mut av1blkst.TileDec) -> i64 {
    return ref_count_ctx(count_refs(td, 2), count_refs(td, 3) + count_refs(td, 4))
}

fn ctx_intra_inter(td: *mut av1blkst.TileDec) -> i64 {
    let au: i64 = b2i(nb_ref_above(td, 0) <= 0)
    let lf: i64 = b2i(nb_ref_left(td, 0) <= 0)
    if (*td).avail_u != 0 && (*td).avail_l != 0 {
        if au == 1 && lf == 1 {
            return 3
        }
        return b2i(au == 1 || lf == 1)
    }
    if (*td).avail_u != 0 {
        return 2 * au
    }
    if (*td).avail_l != 0 {
        return 2 * lf
    }
    return 0
}

fn ctx_comp_inter(td: *mut av1blkst.TileDec) -> i64 {
    let a0: i64 = nb_ref_above(td, 0)
    let l0: i64 = nb_ref_left(td, 0)
    let a_single: bool = nb_ref_above(td, 1) <= 0
    let l_single: bool = nb_ref_left(td, 1) <= 0
    if (*td).avail_u != 0 && (*td).avail_l != 0 {
        if a_single && l_single {
            return is_backward(a0) ^ is_backward(l0)
        }
        if a_single {
            return 2 + b2i(is_backward(a0) == 1 || a0 <= 0)
        }
        if l_single {
            return 2 + b2i(is_backward(l0) == 1 || l0 <= 0)
        }
        return 4
    }
    if (*td).avail_u != 0 {
        if a_single {
            return is_backward(a0)
        }
        return 3
    }
    if (*td).avail_l != 0 {
        if l_single {
            return is_backward(l0)
        }
        return 3
    }
    return 1
}

fn samedir(r0: i64, r1: i64) -> i64 {
    return b2i((r0 >= av1interdef.BWDREF_FRAME) == (r1 >= av1interdef.BWDREF_FRAME))
}

fn ctx_comp_ref_type(td: *mut av1blkst.TileDec) -> i64 {
    let a0: i64 = nb_ref_above(td, 0)
    let a1: i64 = nb_ref_above(td, 1)
    let l0: i64 = nb_ref_left(td, 0)
    let l1: i64 = nb_ref_left(td, 1)
    let au: bool = (*td).avail_u != 0
    let al: bool = (*td).avail_l != 0
    let a_intra: bool = a0 <= 0
    let l_intra: bool = l0 <= 0
    let a_comp: bool = au && !a_intra && a1 > 0
    let l_comp: bool = al && !l_intra && l1 > 0
    var a_uni: i64 = 0
    var l_uni: i64 = 0
    if a_comp {
        a_uni = samedir(a0, a1)
    }
    if l_comp {
        l_uni = samedir(l0, l1)
    }
    if au && !a_intra && al && !l_intra {
        let sd: i64 = samedir(a0, l0)
        if !a_comp && !l_comp {
            return 1 + 2 * sd
        }
        if !a_comp {
            if l_uni == 0 {
                return 1
            }
            return 3 + sd
        }
        if !l_comp {
            if a_uni == 0 {
                return 1
            }
            return 3 + sd
        }
        if a_uni == 0 && l_uni == 0 {
            return 0
        }
        if a_uni == 0 || l_uni == 0 {
            return 2
        }
        return 3 + b2i((a0 == av1interdef.BWDREF_FRAME) == (l0 == av1interdef.BWDREF_FRAME))
    }
    if au && al {
        if a_comp {
            return 1 + 2 * a_uni
        }
        if l_comp {
            return 1 + 2 * l_uni
        }
        return 2
    }
    if a_comp {
        return 4 * a_uni
    }
    if l_comp {
        return 4 * l_uni
    }
    return 2
}

fn ctx_skip_mode(td: *mut av1blkst.TileDec) -> i64 {
    var c: i64 = 0
    if (*td).avail_u != 0 {
        c = c + av1blkst.mi_get(td, (*td).skipmode_a, (*td).mi_row - 1, (*td).mi_col)
    }
    if (*td).avail_l != 0 {
        c = c + av1blkst.mi_get(td, (*td).skipmode_a, (*td).mi_row, (*td).mi_col - 1)
    }
    return c
}

fn ctx_interp(td: *mut av1blkst.TileDec, dir: i64) -> i64 {
    var ctx: i64 = ((dir & 1) * 2 + b2i((*td).ref_frame[1] > 0)) * 4
    var left_t: i64 = 3
    var above_t: i64 = 3
    let r0: i64 = (*td).ref_frame[0]
    if (*td).avail_l != 0 {
        if nb_ref_left(td, 0) == r0 || nb_ref_left(td, 1) == r0 {
            left_t = av1blkst.ld((*td).interp_a, ((*td).mi_row * (*td).mi_cols + (*td).mi_col - 1) * 2 + dir)
        }
    }
    if (*td).avail_u != 0 {
        if nb_ref_above(td, 0) == r0 || nb_ref_above(td, 1) == r0 {
            above_t = av1blkst.ld((*td).interp_a, (((*td).mi_row - 1) * (*td).mi_cols + (*td).mi_col) * 2 + dir)
        }
    }
    if left_t == above_t {
        ctx = ctx + left_t
    } else if left_t == 3 {
        ctx = ctx + above_t
    } else if above_t == 3 {
        ctx = ctx + left_t
    } else {
        ctx = ctx + 3
    }
    return ctx
}

fn ctx_comp_group(td: *mut av1blkst.TileDec) -> i64 {
    var ctx: i64 = 0
    if (*td).avail_u != 0 {
        if nb_ref_above(td, 1) > 0 {
            ctx = ctx + av1blkst.mi_get(td, (*td).cgrp_a, (*td).mi_row - 1, (*td).mi_col)
        } else if nb_ref_above(td, 0) == av1interdef.ALTREF_FRAME {
            ctx = ctx + 3
        }
    }
    if (*td).avail_l != 0 {
        if nb_ref_left(td, 1) > 0 {
            ctx = ctx + av1blkst.mi_get(td, (*td).cgrp_a, (*td).mi_row, (*td).mi_col - 1)
        } else if nb_ref_left(td, 0) == av1interdef.ALTREF_FRAME {
            ctx = ctx + 3
        }
    }
    if ctx > 5 {
        ctx = 5
    }
    return ctx
}

fn ctx_compound_idx(td: *mut av1blkst.TileDec, fwd: i64, bck: i64) -> i64 {
    var ctx: i64 = 0
    if fwd == bck {
        ctx = 3
    }
    if (*td).avail_u != 0 {
        if nb_ref_above(td, 1) > 0 {
            ctx = ctx + av1blkst.mi_get(td, (*td).cidx_a, (*td).mi_row - 1, (*td).mi_col)
        } else if nb_ref_above(td, 0) == av1interdef.ALTREF_FRAME {
            ctx = ctx + 1
        }
    }
    if (*td).avail_l != 0 {
        if nb_ref_left(td, 1) > 0 {
            ctx = ctx + av1blkst.mi_get(td, (*td).cidx_a, (*td).mi_row, (*td).mi_col - 1)
        } else if nb_ref_left(td, 0) == av1interdef.ALTREF_FRAME {
            ctx = ctx + 1
        }
    }
    return ctx
}
