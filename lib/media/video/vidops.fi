export {
    VideoOps, vo_none,
    VO_OK, VO_ERR_FORMAT, VO_ERR_UNSUPPORTED, VO_ERR_DECODE, VO_END,
}

const VO_OK: i32 = 0
const VO_ERR_FORMAT: i32 = -1
const VO_ERR_UNSUPPORTED: i32 = -2
const VO_ERR_DECODE: i32 = -3
const VO_END: i32 = 0

struct VideoOps {
    create: fn() -> u64,
    destroy: fn(u64),
    open: fn(u64, u64, usize) -> i32,
    close: fn(u64),
    width: fn(u64) -> u32,
    height: fn(u64) -> u32,
    fps_milli: fn(u64) -> u32,
    rgba_bytes: fn(u64) -> usize,
    duration_us: fn(u64) -> i64,
    next_frame: fn(u64, u64, *mut i64) -> i32,
    seek: fn(u64, i64) -> i64,
}

fn none_create() -> u64 {
    return 0 as u64
}

fn none_destroy(h: u64) {
}

fn none_open(h: u64, data: u64, n: usize) -> i32 {
    return VO_ERR_UNSUPPORTED
}

fn none_close(h: u64) {
}

fn none_u32(h: u64) -> u32 {
    return 0 as u32
}

fn none_usize(h: u64) -> usize {
    return 0
}

fn none_i64(h: u64) -> i64 {
    return 0
}

fn none_next(h: u64, out: u64, pts: *mut i64) -> i32 {
    return VO_ERR_UNSUPPORTED
}

fn none_seek(h: u64, t: i64) -> i64 {
    return 0
}

fn vo_none() -> VideoOps {
    return VideoOps { create: none_create, destroy: none_destroy, open: none_open, close: none_close,
        width: none_u32, height: none_u32, fps_milli: none_u32, rgba_bytes: none_usize, duration_us: none_i64,
        next_frame: none_next, seek: none_seek }
}
