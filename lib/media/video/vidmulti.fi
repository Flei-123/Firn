import docview.obj
import media.video.vidh264
import media.video.vidops
import media.video.vidvp8

export { vmulti_ops }

struct Multi {
    cur: vidops.VideoOps,
    inner: u64,
    active: bool,
}

fn m_create() -> u64 {
    let raw: u64 = obj.obj_alloc[Multi]()
    if raw == 0 as u64 {
        return raw
    }
    *(raw as *mut Multi) = Multi { cur: vidops.vo_none(), inner: 0, active: false }
    return raw
}

fn drop_inner(m: *mut Multi) {
    if (*m).active {
        (*m).cur.close((*m).inner)
        (*m).cur.destroy((*m).inner)
        (*m).active = false
    }
}

fn m_destroy(h: u64) {
    if h != 0 as u64 {
        drop_inner(h as *mut Multi)
        obj.obj_free[Multi](h)
    }
}

fn try_ops(m: *mut Multi, ops: vidops.VideoOps, data: u64, n: usize) -> i32 {
    let inner: u64 = ops.create()
    if inner == 0 as u64 {
        return vidops.VO_ERR_FORMAT
    }
    let rc: i32 = ops.open(inner, data, n)
    if rc == vidops.VO_OK {
        (*m).cur = ops
        (*m).inner = inner
        (*m).active = true
        return rc
    }
    ops.close(inner)
    ops.destroy(inner)
    return rc
}

fn m_open(h: u64, data: u64, n: usize) -> i32 {
    let m: *mut Multi = h as *mut Multi
    drop_inner(m)
    let rc: i32 = try_ops(m, vidh264.vh264_ops(), data, n)
    if rc != vidops.VO_ERR_UNSUPPORTED {
        return rc
    }
    return try_ops(m, vidvp8.vvp8_ops(), data, n)
}

fn m_close(h: u64) {
    drop_inner(h as *mut Multi)
}

fn m_width(h: u64) -> u32 {
    let m: *mut Multi = h as *mut Multi
    return (*m).cur.width((*m).inner)
}

fn m_height(h: u64) -> u32 {
    let m: *mut Multi = h as *mut Multi
    return (*m).cur.height((*m).inner)
}

fn m_fps(h: u64) -> u32 {
    let m: *mut Multi = h as *mut Multi
    return (*m).cur.fps_milli((*m).inner)
}

fn m_bytes(h: u64) -> usize {
    let m: *mut Multi = h as *mut Multi
    return (*m).cur.rgba_bytes((*m).inner)
}

fn m_duration(h: u64) -> i64 {
    let m: *mut Multi = h as *mut Multi
    return (*m).cur.duration_us((*m).inner)
}

fn m_next(h: u64, out: u64, pts: *mut i64) -> i32 {
    let m: *mut Multi = h as *mut Multi
    if !(*m).active {
        return vidops.VO_ERR_UNSUPPORTED
    }
    return (*m).cur.next_frame((*m).inner, out, pts)
}

fn m_seek(h: u64, t: i64) -> i64 {
    let m: *mut Multi = h as *mut Multi
    if !(*m).active {
        return 0
    }
    return (*m).cur.seek((*m).inner, t)
}

fn vmulti_ops() -> vidops.VideoOps {
    return vidops.VideoOps { create: m_create, destroy: m_destroy, open: m_open, close: m_close, width: m_width,
        height: m_height, fps_milli: m_fps, rgba_bytes: m_bytes, duration_us: m_duration, next_frame: m_next,
        seek: m_seek }
}
