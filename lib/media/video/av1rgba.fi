// SPDX-License-Identifier: MPL-2.0
import std.rt

export { planar_to_rgba, frame_bytes }

fn clamp8(v: i32) -> u8 {
    if v < 0 {
        return 0 as u8
    }
    if v > 255 {
        return 255 as u8
    }
    return v as u8
}

fn frame_bytes(w: usize, h: usize, ssx: usize, ssy: usize, planes: usize, bd: usize) -> usize {
    var n: usize = w * h
    if planes == 3 {
        n = n + 2 * (((w + ssx) >> ssx) * ((h + ssy) >> ssy))
    }
    if bd > 8 {
        n = n * 2
    }
    return n
}

fn sample(p: u64, idx: usize, wide: bool) -> i32 {
    if wide {
        return (rt.ld8(p, idx * 2) as i32) | ((rt.ld8(p, idx * 2 + 1) as i32) << 8)
    }
    return rt.ld8(p, idx) as i32
}

fn planar_to_rgba(src: u64, w: usize, h: usize, ssx: usize, ssy: usize, planes: usize, bd: usize, matrix: i32, out: u64) {
    let wide: bool = bd > 8
    let s: u64 = (bd - 8) as u64
    let cw: usize = (w + ssx) >> ssx
    let ch: usize = (h + ssy) >> ssy
    let up: u64 = src + (((w * h) as u64) << (if wide { 1 } else { 0 }))
    let vp: u64 = up + (((cw * ch) as u64) << (if wide { 1 } else { 0 }))
    let mid: i32 = 128 << s
    let half: i32 = 128 << s
    var row: usize = 0
    while row < h {
        var x: usize = 0
        while x < w {
            let yv: i32 = sample(src, row * w + x, wide)
            var cu: i32 = 0
            var cv: i32 = 0
            if planes == 3 {
                let ci: usize = (row >> ssy) * cw + (x >> ssx)
                cu = sample(up, ci, wide) - mid
                cv = sample(vp, ci, wide) - mid
            }
            let yy: i32 = (yv - (16 << s)) * 298
            var rv: i32 = 0
            var gv: i32 = 0
            var bv: i32 = 0
            if matrix == 1 {
                rv = (yy + (cv * 459) + half) >> (8 + s)
                gv = (yy - (cu * 55) - (cv * 136) + half) >> (8 + s)
                bv = (yy + (cu * 541) + half) >> (8 + s)
            } else {
                rv = (yy + (cv * 409) + half) >> (8 + s)
                gv = (yy - (cu * 100) - (cv * 208) + half) >> (8 + s)
                bv = (yy + (cu * 516) + half) >> (8 + s)
            }
            let o: usize = (row * w + x) * 4
            rt.st8(out, o, clamp8(rv))
            rt.st8(out, o + 1, clamp8(gv))
            rt.st8(out, o + 2, clamp8(bv))
            rt.st8(out, o + 3, 255 as u8)
            x = x + 1
        }
        row = row + 1
    }
}
