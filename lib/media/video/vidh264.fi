import docview.obj
import media.video.vidsource
import media.video.vidops

export { vh264_ops }

fn h_create() -> u64 {
    let raw: u64 = obj.obj_alloc[vidsource.VideoSource]()
    if raw == 0 as u64 {
        return raw
    }
    *(raw as *mut vidsource.VideoSource) = vidsource.vs_new()
    return raw
}

fn h_destroy(h: u64) {
    if h != 0 as u64 {
        obj.obj_free[vidsource.VideoSource](h)
    }
}

fn h_open(h: u64, data: u64, n: usize) -> i32 {
    return vidsource.vs_open(h as *mut vidsource.VideoSource, data, n)
}

fn h_close(h: u64) {
    vidsource.vs_close(h as *mut vidsource.VideoSource)
}

fn h_width(h: u64) -> u32 {
    return vidsource.vs_width(h as *mut vidsource.VideoSource)
}

fn h_height(h: u64) -> u32 {
    return vidsource.vs_height(h as *mut vidsource.VideoSource)
}

fn h_fps(h: u64) -> u32 {
    return vidsource.vs_fps_milli(h as *mut vidsource.VideoSource)
}

fn h_bytes(h: u64) -> usize {
    return vidsource.vs_rgba_bytes(h as *mut vidsource.VideoSource)
}

fn h_duration(h: u64) -> i64 {
    return vidsource.vs_duration_us(h as *mut vidsource.VideoSource)
}

fn h_next(h: u64, out: u64, pts: *mut i64) -> i32 {
    return vidsource.vs_next_frame(h as *mut vidsource.VideoSource, out, pts)
}

fn h_seek(h: u64, t: i64) -> i64 {
    return vidsource.vs_seek(h as *mut vidsource.VideoSource, t)
}

fn vh264_ops() -> vidops.VideoOps {
    return vidops.VideoOps { create: h_create, destroy: h_destroy, open: h_open, close: h_close, width: h_width,
        height: h_height, fps_milli: h_fps, rgba_bytes: h_bytes, duration_us: h_duration, next_frame: h_next,
        seek: h_seek }
}
