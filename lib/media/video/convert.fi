import std.rt

export { yuv420_to_rgba }

fn clamp8(v: i32) -> u8 {
    if v < 0 {
        return 0 as u8
    }
    if v > 255 {
        return 255 as u8
    }
    return v as u8
}

fn yuv420_to_rgba(y: u64, u: u64, v: u64, stride_y: usize, stride_c: usize, w: usize, h: usize, matrix: i32, out: u64) {
    var row: usize = 0
    while row < h {
        let yp: u64 = y + (row * stride_y) as u64
        let up: u64 = u + ((row / 2) * stride_c) as u64
        let vp: u64 = v + ((row / 2) * stride_c) as u64
        let op: u64 = out + (row * w * 4) as u64
        var x: usize = 0
        while x < w {
            let yy: i32 = ((rt.ld8(yp, x) as i32) - 16) * 298
            let cu: i32 = (rt.ld8(up, x / 2) as i32) - 128
            let cv: i32 = (rt.ld8(vp, x / 2) as i32) - 128
            var rv: i32 = 0
            var gv: i32 = 0
            var bv: i32 = 0
            if matrix == 1 {
                rv = (yy + (cv * 459) + 128) >> 8
                gv = (yy - (cu * 55) - (cv * 136) + 128) >> 8
                bv = (yy + (cu * 541) + 128) >> 8
            } else {
                rv = (yy + (cv * 409) + 128) >> 8
                gv = (yy - (cu * 100) - (cv * 208) + 128) >> 8
                bv = (yy + (cu * 516) + 128) >> 8
            }
            rt.st8(op, x * 4, clamp8(rv))
            rt.st8(op, x * 4 + 1, clamp8(gv))
            rt.st8(op, x * 4 + 2, clamp8(bv))
            rt.st8(op, x * 4 + 3, 255 as u8)
            x = x + 1
        }
        row = row + 1
    }
}
