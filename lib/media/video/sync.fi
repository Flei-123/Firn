// SPDX-License-Identifier: MPL-2.0
export { SYNC_SHOW, SYNC_WAIT, SYNC_DROP, sync_decide, sync_wait_us }

const SYNC_SHOW: i32 = 0
const SYNC_WAIT: i32 = 1
const SYNC_DROP: i32 = 2

fn sync_decide(frame_pts_us: i64, clock_us: i64, early_us: i64, late_us: i64) -> i32 {
    let diff: i64 = frame_pts_us - clock_us
    if diff > early_us {
        return SYNC_WAIT
    }
    if diff < (0 - late_us) {
        return SYNC_DROP
    }
    return SYNC_SHOW
}

fn sync_wait_us(frame_pts_us: i64, clock_us: i64) -> i64 {
    let diff: i64 = frame_pts_us - clock_us
    if diff < 0 {
        return 0
    }
    return diff
}
