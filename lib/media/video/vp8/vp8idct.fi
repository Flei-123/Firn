import media.video.vp8.vp8mem

export { addpx, idct_dc, idct_full, mul20091, mul35468, recon_block, walsh }

fn walsh(y2: u64, co: u64) {
    var t: [i64; 16] = [0; 16]
    var i: usize = 0
    while i < 4 {
        let a1: i64 = vp8mem.ldi(y2, i) + vp8mem.ldi(y2, 12 + i)
        let b1: i64 = vp8mem.ldi(y2, 4 + i) + vp8mem.ldi(y2, 8 + i)
        let c1: i64 = vp8mem.ldi(y2, 4 + i) - vp8mem.ldi(y2, 8 + i)
        let d1: i64 = vp8mem.ldi(y2, i) - vp8mem.ldi(y2, 12 + i)
        t[i] = vp8mem.s16(a1 + b1)
        t[4 + i] = vp8mem.s16(c1 + d1)
        t[8 + i] = vp8mem.s16(a1 - b1)
        t[12 + i] = vp8mem.s16(d1 - c1)
        i = i + 1
    }
    i = 0
    while i < 4 {
        let a1: i64 = t[4 * i] + t[4 * i + 3]
        let b1: i64 = t[4 * i + 1] + t[4 * i + 2]
        let c1: i64 = t[4 * i + 1] - t[4 * i + 2]
        let d1: i64 = t[4 * i] - t[4 * i + 3]
        let a2: i64 = a1 + b1
        let b2: i64 = c1 + d1
        let c2: i64 = a1 - b1
        let d2: i64 = d1 - c1
        vp8mem.sti(co, (4 * i) * 16, vp8mem.s16((a2 + 3) >> 3))
        vp8mem.sti(co, (4 * i + 1) * 16, vp8mem.s16((b2 + 3) >> 3))
        vp8mem.sti(co, (4 * i + 2) * 16, vp8mem.s16((c2 + 3) >> 3))
        vp8mem.sti(co, (4 * i + 3) * 16, vp8mem.s16((d2 + 3) >> 3))
        i = i + 1
    }
}

fn mul35468(v: i64) -> i64 {
    return (v * 35468) >> 16
}

fn mul20091(v: i64) -> i64 {
    return v + ((v * 20091) >> 16)
}

fn addpx(r: u64, i: usize, dv: i64) {
    var v: i64 = vp8mem.ld8(r, i) + dv
    if (v & (0 - 256)) != 0 {
        v = ((0 - 1 - v) >> 63) & 255
    }
    vp8mem.st8(r, i, v)
}

fn idct_full(px: u64, st: i64, co: u64) {
    let a0: i64 = vp8mem.ldi(co, 0) + vp8mem.ldi(co, 8)
    let b0: i64 = vp8mem.ldi(co, 0) - vp8mem.ldi(co, 8)
    let c0: i64 = mul35468(vp8mem.ldi(co, 4)) - mul20091(vp8mem.ldi(co, 12))
    let d0: i64 = mul20091(vp8mem.ldi(co, 4)) + mul35468(vp8mem.ldi(co, 12))
    let a1: i64 = vp8mem.ldi(co, 1) + vp8mem.ldi(co, 9)
    let b1: i64 = vp8mem.ldi(co, 1) - vp8mem.ldi(co, 9)
    let c1: i64 = mul35468(vp8mem.ldi(co, 5)) - mul20091(vp8mem.ldi(co, 13))
    let d1: i64 = mul20091(vp8mem.ldi(co, 5)) + mul35468(vp8mem.ldi(co, 13))
    let a2: i64 = vp8mem.ldi(co, 2) + vp8mem.ldi(co, 10)
    let b2: i64 = vp8mem.ldi(co, 2) - vp8mem.ldi(co, 10)
    let c2: i64 = mul35468(vp8mem.ldi(co, 6)) - mul20091(vp8mem.ldi(co, 14))
    let d2: i64 = mul20091(vp8mem.ldi(co, 6)) + mul35468(vp8mem.ldi(co, 14))
    let a3: i64 = vp8mem.ldi(co, 3) + vp8mem.ldi(co, 11)
    let b3: i64 = vp8mem.ldi(co, 3) - vp8mem.ldi(co, 11)
    let c3: i64 = mul35468(vp8mem.ldi(co, 7)) - mul20091(vp8mem.ldi(co, 15))
    let d3: i64 = mul20091(vp8mem.ldi(co, 7)) + mul35468(vp8mem.ldi(co, 15))
    var r: u64 = px
    var x0: i64 = vp8mem.s16(a0 + d0)
    var x1: i64 = vp8mem.s16(a1 + d1)
    var x2: i64 = vp8mem.s16(a2 + d2)
    var x3: i64 = vp8mem.s16(a3 + d3)
    var ra: i64 = x0 + x2 + 4
    var rb: i64 = x0 - x2 + 4
    var rc: i64 = mul35468(x1) - mul20091(x3)
    var rd: i64 = mul20091(x1) + mul35468(x3)
    addpx(r, 0, (ra + rd) >> 3)
    addpx(r, 1, (rb + rc) >> 3)
    addpx(r, 2, (rb - rc) >> 3)
    addpx(r, 3, (ra - rd) >> 3)
    r = ((r as i64) + st) as u64
    x0 = vp8mem.s16(b0 + c0)
    x1 = vp8mem.s16(b1 + c1)
    x2 = vp8mem.s16(b2 + c2)
    x3 = vp8mem.s16(b3 + c3)
    ra = x0 + x2 + 4
    rb = x0 - x2 + 4
    rc = mul35468(x1) - mul20091(x3)
    rd = mul20091(x1) + mul35468(x3)
    addpx(r, 0, (ra + rd) >> 3)
    addpx(r, 1, (rb + rc) >> 3)
    addpx(r, 2, (rb - rc) >> 3)
    addpx(r, 3, (ra - rd) >> 3)
    r = ((r as i64) + st) as u64
    x0 = vp8mem.s16(b0 - c0)
    x1 = vp8mem.s16(b1 - c1)
    x2 = vp8mem.s16(b2 - c2)
    x3 = vp8mem.s16(b3 - c3)
    ra = x0 + x2 + 4
    rb = x0 - x2 + 4
    rc = mul35468(x1) - mul20091(x3)
    rd = mul20091(x1) + mul35468(x3)
    addpx(r, 0, (ra + rd) >> 3)
    addpx(r, 1, (rb + rc) >> 3)
    addpx(r, 2, (rb - rc) >> 3)
    addpx(r, 3, (ra - rd) >> 3)
    r = ((r as i64) + st) as u64
    x0 = vp8mem.s16(a0 - d0)
    x1 = vp8mem.s16(a1 - d1)
    x2 = vp8mem.s16(a2 - d2)
    x3 = vp8mem.s16(a3 - d3)
    ra = x0 + x2 + 4
    rb = x0 - x2 + 4
    rc = mul35468(x1) - mul20091(x3)
    rd = mul20091(x1) + mul35468(x3)
    addpx(r, 0, (ra + rd) >> 3)
    addpx(r, 1, (rb + rc) >> 3)
    addpx(r, 2, (rb - rc) >> 3)
    addpx(r, 3, (ra - rd) >> 3)
}

fn idct_dc(px: u64, st: i64, dc: i64) {
    let d: i64 = (dc + 4) >> 3
    var r: u64 = px
    var y: i64 = 0
    while y < 4 {
        addpx(r, 0, d)
        addpx(r, 1, d)
        addpx(r, 2, d)
        addpx(r, 3, d)
        r = ((r as i64) + st) as u64
        y = y + 1
    }
}

fn recon_block(px: u64, st: i64, co: u64, c: i64) {
    if c > 1 {
        idct_full(px, st, co)
        var k: u64 = 0
        while k < 64 {
            *((co + k) as *mut u64) = 0
            k = k + 8
        }
    } else {
        let dc: i64 = vp8mem.ldi(co, 0)
        if dc != 0 {
            idct_dc(px, st, dc)
            vp8mem.sti(co, 0, 0)
        }
    }
}
