import media.video.vp8.vp8bool
import media.video.vp8.vp8kfmode
import media.video.vp8.vp8mem
import media.video.vp8.vp8mode
import media.video.vp8.vp8mv
import media.video.vp8.vp8split
import media.video.vp8.vp8state

export { read_inter_modes }

static BMODE_PROBS: [u8; 9] = [120, 90, 79, 133, 87, 85, 80, 111, 151]

fn read_intra_ymode(d: *mut vp8bool.BD, p: u64) -> i64 {
    if vp8bool.bd_get(d, vp8mem.ld8(p, 0)) == 0 {
        return vp8kfmode.M_DC
    }
    if vp8bool.bd_get(d, vp8mem.ld8(p, 1)) == 0 {
        if vp8bool.bd_get(d, vp8mem.ld8(p, 2)) == 0 {
            return vp8kfmode.M_V
        }
        return vp8kfmode.M_H
    }
    if vp8bool.bd_get(d, vp8mem.ld8(p, 3)) == 0 {
        return vp8kfmode.M_TM
    }
    return vp8kfmode.M_B
}

fn read_intra_uvmode(d: *mut vp8bool.BD, p: u64) -> i64 {
    if vp8bool.bd_get(d, vp8mem.ld8(p, 0)) == 0 {
        return vp8kfmode.M_DC
    }
    if vp8bool.bd_get(d, vp8mem.ld8(p, 1)) == 0 {
        return vp8kfmode.M_V
    }
    if vp8bool.bd_get(d, vp8mem.ld8(p, 2)) == 0 {
        return vp8kfmode.M_H
    }
    return vp8kfmode.M_TM
}

fn clear_mvs(mb: u64) {
    vp8mem.sti(mb, vp8state.C_MVY, 0)
    vp8mem.sti(mb, vp8state.C_MVX, 0)
    vp8split.set_all_mvs(mb, 0, 0)
}

fn read_intra_mb(f: *mut vp8state.Vp8, d: *mut vp8bool.BD, mb: u64) {
    let ym: i64 = read_intra_ymode(d, (*f).ent + vp8state.ENT_Y as u64)
    if ym == vp8kfmode.M_B {
        var b: usize = 0
        while b < 16 {
            vp8mem.sti(mb, vp8state.C_BM + b, vp8kfmode.read_bmode(d, (&BMODE_PROBS[0]) as u64))
            b = b + 1
        }
    }
    vp8mem.sti(mb, vp8state.C_YMODE, ym)
    vp8mem.sti(mb, vp8state.C_UVMODE, read_intra_uvmode(d, (*f).ent + vp8state.ENT_UV as u64))
    vp8mem.sti(mb, vp8state.C_REF, 0)
    clear_mvs(mb)
}

fn read_mv_pair(f: *mut vp8state.Vp8, d: *mut vp8bool.BD, by: i64, bx: i64, mb: u64) {
    let mvp: u64 = (*f).ent + vp8state.ENT_MV as u64
    let dy: i64 = vp8mv.read_mv_component(d, mvp) * 2
    let dx: i64 = vp8mv.read_mv_component(d, mvp + 19) * 2
    vp8mem.sti(mb, vp8state.C_MVY, by + dy)
    vp8mem.sti(mb, vp8state.C_MVX, bx + dx)
}

fn read_inter_mb(f: *mut vp8state.Vp8, d: *mut vp8bool.BD, mb: u64, mba: u64, mbl: u64, mbal: u64, row: i64, col: i64) {
    var rf: i64 = 1
    if vp8bool.bd_get(d, (*f).prob_last) == 1 {
        rf = 2 + vp8bool.bd_get(d, (*f).prob_gf)
    }
    var nr: vp8mv.Near = vp8mv.near_new()
    vp8mv.find_near(f, &nr, rf, mba, mbl, mbal)
    let lo_x: i64 = 0 - ((col + 1) << 7)
    let hi_x: i64 = ((*f).mbw - col) << 7
    let lo_y: i64 = 0 - ((row + 1) << 7)
    let hi_y: i64 = ((*f).mbh - row) << 7
    vp8mem.sti(mb, vp8state.C_REF, rf)
    vp8mem.sti(mb, vp8state.C_UVMODE, 0)
    var ym: i64 = vp8state.Y_ZERO
    var my: i64 = 0
    var mx: i64 = 0
    if vp8bool.bd_get(d, vp8mv.mode_prob(nr.cnt[0], 0)) == 1 {
        if vp8bool.bd_get(d, vp8mv.mode_prob(nr.cnt[1], 1)) == 0 {
            ym = vp8state.Y_NEAREST
            my = vp8mv.clamp_axis(nr.y[1], lo_y, hi_y)
            mx = vp8mv.clamp_axis(nr.x[1], lo_x, hi_x)
        } else {
            if vp8bool.bd_get(d, vp8mv.mode_prob(nr.cnt[2], 2)) == 0 {
                ym = vp8state.Y_NEAR
                my = vp8mv.clamp_axis(nr.y[2], lo_y, hi_y)
                mx = vp8mv.clamp_axis(nr.x[2], lo_x, hi_x)
            } else {
                let by: i64 = vp8mv.clamp_axis(nr.y[0], lo_y, hi_y)
                let bx: i64 = vp8mv.clamp_axis(nr.x[0], lo_x, hi_x)
                if vp8bool.bd_get(d, vp8mv.mode_prob(nr.cnt[3], 3)) == 0 {
                    ym = vp8state.Y_NEW
                    read_mv_pair(f, d, by, bx, mb)
                    my = vp8mem.ldi(mb, vp8state.C_MVY)
                    mx = vp8mem.ldi(mb, vp8state.C_MVX)
                } else {
                    ym = vp8state.Y_SPLIT
                    vp8mem.sti(mb, vp8state.C_YMODE, ym)
                    vp8split.read_split_mvs(f, d, mb, mba, mbl, by, bx)
                    return
                }
            }
        }
    }
    vp8mem.sti(mb, vp8state.C_YMODE, ym)
    vp8mem.sti(mb, vp8state.C_MVY, my)
    vp8mem.sti(mb, vp8state.C_MVX, mx)
    vp8split.set_all_mvs(mb, my, mx)
}

fn read_inter_modes(f: *mut vp8state.Vp8, d: *mut vp8bool.BD, mb: u64, mba: u64, mbl: u64, mbal: u64, row: i64, col: i64) {
    var seg: i64 = 0
    if (*f).seg_on == 1 {
        seg = vp8mem.ldi(mb, vp8state.C_SEG)
        if (*f).seg_map == 1 {
            seg = vp8mode.read_segment_id(f, d)
        }
    }
    var skip: i64 = 0
    if (*f).skip_on == 1 {
        skip = vp8bool.bd_get(d, (*f).skip_p)
    }
    vp8mem.sti(mb, vp8state.C_SEG, seg)
    vp8mem.sti(mb, vp8state.C_SKIP, skip)
    if vp8bool.bd_get(d, (*f).prob_inter) == 1 {
        read_inter_mb(f, d, mb, mba, mbl, mbal, row, col)
    } else {
        read_intra_mb(f, d, mb)
    }
}
