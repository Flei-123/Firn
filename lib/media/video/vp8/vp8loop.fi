import media.video.vp8.vp8kfmode
import media.video.vp8.vp8lf
import media.video.vp8.vp8mem
import media.video.vp8.vp8state

export { loop_filter_frame, mb_filter_level }

fn clamp63(v: i64) -> i64 {
    if v > 63 {
        return 63
    }
    if v < 0 {
        return 0
    }
    return v
}

fn mb_filter_level(f: *mut vp8state.Vp8, mb: u64) -> i64 {
    let ym: i64 = vp8mem.ldi(mb, vp8state.C_YMODE)
    let rf: i64 = vp8mem.ldi(mb, vp8state.C_REF)
    var lvl: i64 = (*f).lf_level
    if (*f).seg_on == 1 {
        let sg: usize = vp8mem.ldi(mb, vp8state.C_SEG) as usize
        if (*f).seg_abs == 1 {
            lvl = (*f).seg_lf[sg]
        } else {
            lvl = lvl + (*f).seg_lf[sg]
        }
        lvl = clamp63(lvl)
    }
    if (*f).lf_delta == 0 {
        return clamp63(lvl)
    }
    lvl = lvl + (*f).ref_delta[rf as usize]
    if rf == 0 {
        if ym == vp8kfmode.M_B {
            lvl = lvl + (*f).mode_delta[0]
        }
    } else {
        if ym == vp8state.Y_ZERO {
            lvl = lvl + (*f).mode_delta[1]
        } else {
            if ym == vp8state.Y_SPLIT {
                lvl = lvl + (*f).mode_delta[3]
            } else {
                lvl = lvl + (*f).mode_delta[2]
            }
        }
    }
    return clamp63(lvl)
}

fn interior_limit(f: *mut vp8state.Vp8, lvl: i64) -> i64 {
    var ilim: i64 = lvl
    if (*f).lf_sharp > 0 {
        if (*f).lf_sharp > 4 {
            ilim = ilim >> 2
        } else {
            ilim = ilim >> 1
        }
        if ilim > 9 - (*f).lf_sharp {
            ilim = 9 - (*f).lf_sharp
        }
    }
    if ilim < 1 {
        return 1
    }
    return ilim
}

fn hev_threshold(key: bool, lvl: i64) -> i64 {
    if key {
        if lvl >= 40 {
            return 2
        }
        if lvl >= 15 {
            return 1
        }
        return 0
    }
    if lvl >= 40 {
        return 3
    }
    if lvl >= 20 {
        return 2
    }
    if lvl >= 15 {
        return 1
    }
    return 0
}

fn filter_simple(yp: u64, ys: i64, row: i64, col: i64, mbl: i64, bl: i64, inner: bool) {
    if col > 0 {
        vp8lf.lf_simple(yp, 1, ys, mbl)
    }
    if inner {
        vp8lf.lf_simple(yp + 4, 1, ys, bl)
        vp8lf.lf_simple(yp + 8, 1, ys, bl)
        vp8lf.lf_simple(yp + 12, 1, ys, bl)
    }
    if row > 0 {
        vp8lf.lf_simple(yp, ys, 1, mbl)
    }
    if inner {
        vp8lf.lf_simple(yp + (4 * ys) as u64, ys, 1, bl)
        vp8lf.lf_simple(yp + (8 * ys) as u64, ys, 1, bl)
        vp8lf.lf_simple(yp + (12 * ys) as u64, ys, 1, bl)
    }
}

fn filter_normal(yp: u64, up: u64, vp: u64, ys: i64, uvs: i64, row: i64, col: i64, mbl: i64, bl: i64, ilim: i64, hev: i64, inner: bool) {
    if col > 0 {
        vp8lf.lf_mb_v(yp, ys, 16, mbl, ilim, hev)
        vp8lf.lf_mb_v(up, uvs, 8, mbl, ilim, hev)
        vp8lf.lf_mb_v(vp, uvs, 8, mbl, ilim, hev)
    }
    if inner {
        vp8lf.lf_inner_v(yp + 4, ys, 16, bl, ilim, hev)
        vp8lf.lf_inner_v(yp + 8, ys, 16, bl, ilim, hev)
        vp8lf.lf_inner_v(yp + 12, ys, 16, bl, ilim, hev)
        vp8lf.lf_inner_v(up + 4, uvs, 8, bl, ilim, hev)
        vp8lf.lf_inner_v(vp + 4, uvs, 8, bl, ilim, hev)
    }
    if row > 0 {
        vp8lf.lf_mb_h(yp, ys, 16, mbl, ilim, hev)
        vp8lf.lf_mb_h(up, uvs, 8, mbl, ilim, hev)
        vp8lf.lf_mb_h(vp, uvs, 8, mbl, ilim, hev)
    }
    if inner {
        vp8lf.lf_inner_h(yp + (4 * ys) as u64, ys, 16, bl, ilim, hev)
        vp8lf.lf_inner_h(yp + (8 * ys) as u64, ys, 16, bl, ilim, hev)
        vp8lf.lf_inner_h(yp + (12 * ys) as u64, ys, 16, bl, ilim, hev)
        vp8lf.lf_inner_h(up + (4 * uvs) as u64, uvs, 8, bl, ilim, hev)
        vp8lf.lf_inner_h(vp + (4 * uvs) as u64, uvs, 8, bl, ilim, hev)
    }
}

fn filter_row(f: *mut vp8state.Vp8, row: i64) {
    let ys: i64 = (*f).ys
    let uvs: i64 = (*f).uvs
    let y0: i64 = vp8state.plane_y(f, (*f).cur) as i64
    let u0: i64 = vp8state.plane_u(f, (*f).cur) as i64
    let v0: i64 = vp8state.plane_v(f, (*f).cur) as i64
    var col: i64 = 0
    while col < (*f).mbw {
        let mb: u64 = vp8state.mbi_at(f, row, col)
        let ym: i64 = vp8mem.ldi(mb, vp8state.C_YMODE)
        let lvl: i64 = mb_filter_level(f, mb)
        if lvl > 0 {
            let ilim: i64 = interior_limit(f, lvl)
            let hev: i64 = hev_threshold((*f).keyframe, lvl)
            let inner: bool = vp8mem.ldi(mb, vp8state.C_NZ) != 0 || ym == vp8kfmode.M_B || ym == vp8state.Y_SPLIT
            let mbl: i64 = (lvl + 2) * 2 + ilim
            let bl: i64 = lvl * 2 + ilim
            let yp: u64 = (y0 + row * 16 * ys + col * 16) as u64
            if (*f).lf_simple == 1 {
                filter_simple(yp, ys, row, col, mbl, bl, inner)
            } else {
                let up: u64 = (u0 + row * 8 * uvs + col * 8) as u64
                let vp: u64 = (v0 + row * 8 * uvs + col * 8) as u64
                filter_normal(yp, up, vp, ys, uvs, row, col, mbl, bl, ilim, hev, inner)
            }
        }
        col = col + 1
    }
}

fn loop_filter_frame(f: *mut vp8state.Vp8) {
    if (*f).lf_level == 0 {
        return
    }
    vp8lf.lf_init()
    var row: i64 = 0
    while row < (*f).mbh {
        filter_row(f, row)
        row = row + 1
    }
}
