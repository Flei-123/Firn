import media.video.vp8.vp8bool
import media.video.vp8.vp8mem

export { BMODE_TREE, M_B, M_DC, M_H, M_TM, M_V, implied_bmode, read_bmode, read_kf_ymode, read_uvmode }

const M_DC: i64 = 0

const M_V: i64 = 1

const M_H: i64 = 2

const M_TM: i64 = 3

const M_B: i64 = 4

fn read_kf_ymode(d: *mut vp8bool.BD) -> i64 {
    if vp8bool.bd_get(d, 145) == 0 {
        return M_B
    }
    if vp8bool.bd_get(d, 156) == 0 {
        if vp8bool.bd_get(d, 163) == 0 {
            return M_DC
        }
        return M_V
    }
    if vp8bool.bd_get(d, 128) == 0 {
        return M_H
    }
    return M_TM
}

fn read_uvmode(d: *mut vp8bool.BD) -> i64 {
    if vp8bool.bd_get(d, 142) == 0 {
        return M_DC
    }
    if vp8bool.bd_get(d, 114) == 0 {
        return M_V
    }
    if vp8bool.bd_get(d, 183) == 0 {
        return M_H
    }
    return M_TM
}

static BMODE_TREE: [u8; 18] = [16, 18, 15, 20, 14, 22, 24, 28, 13, 26, 11, 10,
    12, 30, 9, 32, 8, 7]

fn read_bmode(d: *mut vp8bool.BD, probs: u64) -> i64 {
    var i: i64 = 0
    while true {
        let bit: i64 = vp8bool.bd_get(d, vp8mem.ld8(probs, (i >> 1) as usize))
        i = (BMODE_TREE[(i + bit) as usize] as i64) - 16
        if i <= 0 {
            break
        }
    }
    return 0 - i
}

fn implied_bmode(ymode: i64) -> i64 {
    if ymode == M_V {
        return 2
    }
    if ymode == M_H {
        return 3
    }
    if ymode == M_TM {
        return 1
    }
    return 0
}
