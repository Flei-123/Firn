import media.video.vp8.vp8bool
import media.video.vp8.vp8mem
import media.video.vp8.vp8mv
import media.video.vp8.vp8state

export { read_split_mvs, set_all_mvs }

static SUB_PROBS: [u8; 15] = [147, 136, 18, 106, 145, 1, 179, 121, 1, 223, 1, 34, 208, 1, 1]

fn part_of(s: i64, b: i64) -> i64 {
    if s == 0 {
        return b >> 3
    }
    if s == 1 {
        return (b & 3) >> 1
    }
    if s == 2 {
        return ((b >> 3) << 1) | ((b & 3) >> 1)
    }
    return b
}

fn part_count(s: i64) -> i64 {
    if s == 3 {
        return 16
    }
    if s == 2 {
        return 4
    }
    return 2
}

fn set_all_mvs(mb: u64, my: i64, mx: i64) {
    var b: usize = 0
    while b < 16 {
        vp8mem.sti(mb, vp8state.C_SMV + b * 2, my)
        vp8mem.sti(mb, vp8state.C_SMV + b * 2 + 1, mx)
        b = b + 1
    }
}

fn read_split_shape(d: *mut vp8bool.BD) -> i64 {
    if vp8bool.bd_get(d, 110) == 0 {
        return 3
    }
    if vp8bool.bd_get(d, 111) == 0 {
        return 2
    }
    return vp8bool.bd_get(d, 150)
}

fn context_of(ly: i64, lx: i64, ay: i64, ax: i64) -> i64 {
    let lez: bool = ly == 0 && lx == 0
    let aez: bool = ay == 0 && ax == 0
    let lea: bool = ly == ay && lx == ax
    if lea && lez {
        return 4
    }
    if lea {
        return 3
    }
    if aez {
        return 2
    }
    if lez {
        return 1
    }
    return 0
}

fn read_split_mvs(f: *mut vp8state.Vp8, d: *mut vp8bool.BD, mb: u64, mba: u64, mbl: u64, by: i64, bx: i64) {
    let s: i64 = read_split_shape(d)
    let np: i64 = part_count(s)
    let mvp: u64 = (*f).ent + vp8state.ENT_MV as u64
    var j: i64 = 0
    while j < np {
        var k: i64 = 0
        while part_of(s, k) != j {
            k = k + 1
        }
        var ly: i64 = 0
        var lx: i64 = 0
        if (k & 3) == 0 {
            ly = vp8mem.ldi(mbl, vp8state.C_SMV + ((k + 3) * 2) as usize)
            lx = vp8mem.ldi(mbl, vp8state.C_SMV + ((k + 3) * 2 + 1) as usize)
        } else {
            ly = vp8mem.ldi(mb, vp8state.C_SMV + ((k - 1) * 2) as usize)
            lx = vp8mem.ldi(mb, vp8state.C_SMV + ((k - 1) * 2 + 1) as usize)
        }
        var ay: i64 = 0
        var ax: i64 = 0
        if k < 4 {
            ay = vp8mem.ldi(mba, vp8state.C_SMV + ((k + 12) * 2) as usize)
            ax = vp8mem.ldi(mba, vp8state.C_SMV + ((k + 12) * 2 + 1) as usize)
        } else {
            ay = vp8mem.ldi(mb, vp8state.C_SMV + ((k - 4) * 2) as usize)
            ax = vp8mem.ldi(mb, vp8state.C_SMV + ((k - 4) * 2 + 1) as usize)
        }
        let po: usize = (context_of(ly, lx, ay, ax) * 3) as usize
        var my: i64 = 0
        var mx: i64 = 0
        if vp8bool.bd_get(d, SUB_PROBS[po] as i64) == 0 {
            my = ly
            mx = lx
        } else {
            if vp8bool.bd_get(d, SUB_PROBS[po + 1] as i64) == 0 {
                my = ay
                mx = ax
            } else {
                if vp8bool.bd_get(d, SUB_PROBS[po + 2] as i64) == 1 {
                    my = by + vp8mv.read_mv_component(d, mvp) * 2
                    mx = bx + vp8mv.read_mv_component(d, mvp + 19) * 2
                }
            }
        }
        var b: i64 = k
        while b < 16 {
            if part_of(s, b) == j {
                vp8mem.sti(mb, vp8state.C_SMV + (b * 2) as usize, my)
                vp8mem.sti(mb, vp8state.C_SMV + (b * 2 + 1) as usize, mx)
            }
            b = b + 1
        }
        j = j + 1
    }
    vp8mem.sti(mb, vp8state.C_MVY, vp8mem.ldi(mb, vp8state.C_SMV + 30))
    vp8mem.sti(mb, vp8state.C_MVX, vp8mem.ldi(mb, vp8state.C_SMV + 31))
}
