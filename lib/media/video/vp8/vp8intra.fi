import media.video.vp8.vp8lf
import media.video.vp8.vp8mem

export { at, avg2, avg3, fill_row, hsum8, pred_b, pred_dc, pred_h, pred_tm, pred_v, put }

fn at(p: u64, st: i64, x: i64, y: i64) -> i64 {
    return vp8mem.ld8o(p, y * st + x)
}

fn put(p: u64, st: i64, x: i64, y: i64, v: i64) {
    vp8mem.st8o(p, y * st + x, v)
}

fn fill_row(r: u64, n: i64, v8: u64) {
    if n == 16 {
        *(r as *mut u64) = v8
        *((r + 8) as *mut u64) = v8
    } else if n == 8 {
        *(r as *mut u64) = v8
    } else {
        *(r as *mut u32) = (v8 & 4294967295) as u32
    }
}

fn hsum8(x: u64) -> i64 {
    let t: u64 = (x & 71777214294589695) + ((x >> 8) & 71777214294589695)
    let u: u64 = t + (t >> 32)
    return ((u + (u >> 16)) & 65535) as i64
}

fn pred_h(p: u64, st: i64, n: i64) {
    var r: i64 = p as i64
    var i: i64 = 0
    while i < n {
        let l: u64 = (*((r - 1) as u64 as *mut u8)) as u64
        fill_row(r as u64, n, l * 72340172838076673)
        r = r + st
        i = i + 1
    }
}

fn pred_v(p: u64, st: i64, n: i64) {
    let top: i64 = (p as i64) - st
    let a: u64 = *(top as u64 as *mut u64)
    var b: u64 = 0
    if n == 16 {
        b = *((top + 8) as u64 as *mut u64)
    }
    var r: i64 = p as i64
    var i: i64 = 0
    while i < n {
        if n == 16 {
            *(r as u64 as *mut u64) = a
            *((r + 8) as u64 as *mut u64) = b
        } else if n == 8 {
            *(r as u64 as *mut u64) = a
        } else {
            *(r as u64 as *mut u32) = a as u32
        }
        r = r + st
        i = i + 1
    }
}

fn pred_tm(p: u64, st: i64, n: i64) {
    let t: i64 = (&vp8lf.G_LF[0]) as u64 as i64
    let top: i64 = (p as i64) - st
    let tl: i64 = vp8lf.lpx(top - 1)
    var r: i64 = p as i64
    var i: i64 = 0
    while i < n {
        let d: i64 = vp8lf.lpx(r - 1) - tl
        var j: i64 = 0
        while j < n {
            vp8lf.lset(r + j, vp8lf.tcl1(t, vp8lf.lpx(top + j) + d))
            j = j + 1
        }
        r = r + st
        i = i + 1
    }
}

fn pred_dc(p: u64, st: i64, n: i64) {
    let top: i64 = (p as i64) - st
    var dc: i64 = 0
    if n == 4 {
        dc = hsum8((*(top as u64 as *mut u32)) as u64)
    } else {
        dc = hsum8(*(top as u64 as *mut u64))
        if n == 16 {
            dc = dc + hsum8(*((top + 8) as u64 as *mut u64))
        }
    }
    var r: i64 = (p as i64) - 1
    var i: i64 = 0
    while i < n {
        dc = dc + vp8lf.lpx(r)
        r = r + st
        i = i + 1
    }
    var sh: i64 = 3
    if n == 16 {
        sh = 5
    } else if n == 8 {
        sh = 4
    }
    dc = (dc + (1 << (sh - 1))) >> sh
    let v8: u64 = (dc as u64) * 72340172838076673
    r = p as i64
    i = 0
    while i < n {
        fill_row(r as u64, n, v8)
        r = r + st
        i = i + 1
    }
}

fn avg3(a: i64, b: i64, c: i64) -> i64 {
    return (a + 2 * b + c + 2) >> 2
}

fn avg2(a: i64, b: i64) -> i64 {
    return (a + b + 1) >> 1
}

fn pred_b(p: u64, st: i64, mode: i64) {
    if mode == 0 {
        pred_dc(p, st, 4)
        return
    }
    if mode == 1 {
        pred_tm(p, st, 4)
        return
    }
    var a: [i64; 9] = [0; 9]
    var l: [i64; 4] = [0; 4]
    var k: i64 = 0
    while k < 9 {
        a[k as usize] = at(p, st, k - 1, 0 - 1)
        k = k + 1
    }
    k = 0
    while k < 4 {
        l[k as usize] = at(p, st, 0 - 1, k)
        k = k + 1
    }
    var o: [i64; 16] = [0; 16]
    if mode == 2 {
        var j: usize = 0
        while j < 4 {
            let v: i64 = avg3(a[j], a[j + 1], a[j + 2])
            o[j] = v
            o[4 + j] = v
            o[8 + j] = v
            o[12 + j] = v
            j = j + 1
        }
    } else if mode == 3 {
        let r0: i64 = avg3(a[0], l[0], l[1])
        let r1: i64 = avg3(l[0], l[1], l[2])
        let r2: i64 = avg3(l[1], l[2], l[3])
        let r3: i64 = avg3(l[2], l[3], l[3])
        var j: usize = 0
        while j < 4 {
            o[j] = r0
            o[4 + j] = r1
            o[8 + j] = r2
            o[12 + j] = r3
            j = j + 1
        }
    } else if mode == 4 {
        let p0: i64 = avg3(a[1], a[2], a[3])
        let p1: i64 = avg3(a[2], a[3], a[4])
        let p2: i64 = avg3(a[3], a[4], a[5])
        let p3: i64 = avg3(a[4], a[5], a[6])
        let p4: i64 = avg3(a[5], a[6], a[7])
        let p5: i64 = avg3(a[6], a[7], a[8])
        let p6: i64 = avg3(a[7], a[8], a[8])
        o[0] = p0
        o[1] = p1
        o[2] = p2
        o[3] = p3
        o[4] = p1
        o[5] = p2
        o[6] = p3
        o[7] = p4
        o[8] = p2
        o[9] = p3
        o[10] = p4
        o[11] = p5
        o[12] = p3
        o[13] = p4
        o[14] = p5
        o[15] = p6
    } else if mode == 5 {
        let p0: i64 = avg3(l[0], a[0], a[1])
        let p1: i64 = avg3(a[0], a[1], a[2])
        let p2: i64 = avg3(a[1], a[2], a[3])
        let p3: i64 = avg3(a[2], a[3], a[4])
        let p4: i64 = avg3(l[1], l[0], a[0])
        let p5: i64 = avg3(l[2], l[1], l[0])
        let p6: i64 = avg3(l[3], l[2], l[1])
        o[0] = p0
        o[1] = p1
        o[2] = p2
        o[3] = p3
        o[4] = p4
        o[5] = p0
        o[6] = p1
        o[7] = p2
        o[8] = p5
        o[9] = p4
        o[10] = p0
        o[11] = p1
        o[12] = p6
        o[13] = p5
        o[14] = p4
        o[15] = p0
    } else if mode == 6 {
        let p0: i64 = avg2(a[0], a[1])
        let p1: i64 = avg2(a[1], a[2])
        let p2: i64 = avg2(a[2], a[3])
        let p3: i64 = avg2(a[3], a[4])
        let p4: i64 = avg3(l[0], a[0], a[1])
        let p5: i64 = avg3(a[0], a[1], a[2])
        let p6: i64 = avg3(a[1], a[2], a[3])
        let p7: i64 = avg3(a[2], a[3], a[4])
        let p8: i64 = avg3(l[1], l[0], a[0])
        let p9: i64 = avg3(l[2], l[1], l[0])
        o[0] = p0
        o[1] = p1
        o[2] = p2
        o[3] = p3
        o[4] = p4
        o[5] = p5
        o[6] = p6
        o[7] = p7
        o[8] = p8
        o[9] = p0
        o[10] = p1
        o[11] = p2
        o[12] = p9
        o[13] = p4
        o[14] = p5
        o[15] = p6
    } else if mode == 7 {
        let p0: i64 = avg2(a[1], a[2])
        let p1: i64 = avg2(a[2], a[3])
        let p2: i64 = avg2(a[3], a[4])
        let p3: i64 = avg2(a[4], a[5])
        let p4: i64 = avg3(a[1], a[2], a[3])
        let p5: i64 = avg3(a[2], a[3], a[4])
        let p6: i64 = avg3(a[3], a[4], a[5])
        let p7: i64 = avg3(a[4], a[5], a[6])
        let p8: i64 = avg3(a[5], a[6], a[7])
        let p9: i64 = avg3(a[6], a[7], a[8])
        o[0] = p0
        o[1] = p1
        o[2] = p2
        o[3] = p3
        o[4] = p4
        o[5] = p5
        o[6] = p6
        o[7] = p7
        o[8] = p1
        o[9] = p2
        o[10] = p3
        o[11] = p8
        o[12] = p5
        o[13] = p6
        o[14] = p7
        o[15] = p9
    } else if mode == 8 {
        let p0: i64 = avg2(l[0], a[0])
        let p1: i64 = avg3(l[0], a[0], a[1])
        let p2: i64 = avg3(a[0], a[1], a[2])
        let p3: i64 = avg3(a[1], a[2], a[3])
        let p4: i64 = avg2(l[1], l[0])
        let p5: i64 = avg3(l[1], l[0], a[0])
        let p6: i64 = avg2(l[2], l[1])
        let p7: i64 = avg3(l[2], l[1], l[0])
        let p8: i64 = avg2(l[3], l[2])
        let p9: i64 = avg3(l[3], l[2], l[1])
        o[0] = p0
        o[1] = p1
        o[2] = p2
        o[3] = p3
        o[4] = p4
        o[5] = p5
        o[6] = p0
        o[7] = p1
        o[8] = p6
        o[9] = p7
        o[10] = p4
        o[11] = p5
        o[12] = p8
        o[13] = p9
        o[14] = p6
        o[15] = p7
    } else {
        let p0: i64 = avg2(l[0], l[1])
        let p1: i64 = avg3(l[0], l[1], l[2])
        let p2: i64 = avg2(l[1], l[2])
        let p3: i64 = avg3(l[1], l[2], l[3])
        let p4: i64 = avg2(l[2], l[3])
        let p5: i64 = avg3(l[2], l[3], l[3])
        let p6: i64 = l[3]
        o[0] = p0
        o[1] = p1
        o[2] = p2
        o[3] = p3
        o[4] = p2
        o[5] = p3
        o[6] = p4
        o[7] = p5
        o[8] = p4
        o[9] = p5
        o[10] = p6
        o[11] = p6
        o[12] = p6
        o[13] = p6
        o[14] = p6
        o[15] = p6
    }
    var r: i64 = p as i64
    var y: usize = 0
    while y < 16 {
        *(r as u64 as *mut u32) = (o[y] | (o[y + 1] << 8) | (o[y + 2] << 16)
            | (o[y + 3] << 24)) as u32
        r = r + st
        y = y + 4
    }
}
