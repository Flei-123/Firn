import media.video.vp8.vp8bool
import media.video.vp8.vp8kfmode
import media.video.vp8.vp8mem
import media.video.vp8.vp8state
import media.video.vp8.vp8tok

export { mb_frame_init, mb_row_init, read_mb_tokens, has_y2 }

fn mb_frame_init(f: *mut vp8state.Vp8) {
    var ti: i64 = 0
    while ti < 4 {
        var ni: i64 = 0
        while ni < 17 {
            vp8state.stq((*f).bandp, (ti * 17 + ni) as usize,
                (*f).ent + vp8state.ENT_COEF as u64 + ((ti * 8 + (vp8tok.BANDS[ni as usize] as i64)) * 33) as u64)
            ni = ni + 1
        }
        ti = ti + 1
    }
    vp8mem.zero((*f).above_nz, (((*f).mbw + 1) * 36) as usize)
}

fn mb_row_init(f: *mut vp8state.Vp8) {
    vp8mem.zero((*f).left_nz, 36)
}

fn has_y2(ym: i64) -> bool {
    return ym != vp8kfmode.M_B && ym != vp8state.Y_SPLIT
}

fn clear_ctx(lnz: u64, an: u64, with_y2: bool) {
    var k: usize = 0
    while k < 8 {
        vp8mem.sti(lnz, k, 0)
        vp8mem.sti(an, k, 0)
        k = k + 1
    }
    if with_y2 {
        vp8mem.sti(lnz, 8, 0)
        vp8mem.sti(an, 8, 0)
    }
}

fn read_luma(f: *mut vp8state.Vp8, pd: *mut vp8bool.BD, lnz: u64, an: u64, dqp: u64, first: i64, ytype: i64) -> i64 {
    let bpy: u64 = (*f).bandp + (ytype * 136) as u64
    let coeffs: u64 = (*f).coeffs
    var nz: i64 = 0
    var by: i64 = 0
    while by < 4 {
        var l: i64 = vp8mem.ldi(lnz, by as usize)
        var bx: i64 = 0
        while bx < 4 {
            let bi: i64 = by * 4 + bx
            let c: i64 = vp8tok.read_block(pd, bpy, l + vp8mem.ldi(an, bx as usize), coeffs + (bi * 64) as u64, dqp, first)
            vp8mem.sti((*f).nzc, bi as usize, c)
            l = 0
            if c > first {
                l = 1
            }
            vp8mem.sti(an, bx as usize, l)
            nz = nz | l
            bx = bx + 1
        }
        vp8mem.sti(lnz, by as usize, l)
        by = by + 1
    }
    return nz
}

fn read_chroma(f: *mut vp8state.Vp8, pd: *mut vp8bool.BD, lnz: u64, an: u64, dqp: u64) -> i64 {
    let coeffs: u64 = (*f).coeffs
    var nz: i64 = 0
    var pl: i64 = 4
    while pl < 8 {
        var by: i64 = 0
        while by < 2 {
            var l: i64 = vp8mem.ldi(lnz, (pl + by) as usize)
            var bx: i64 = 0
            while bx < 2 {
                let bi: i64 = 16 + (pl - 4) * 2 + by * 2 + bx
                let c: i64 = vp8tok.read_block(pd, (*f).bandp + 272, l + vp8mem.ldi(an, (pl + bx) as usize),
                    coeffs + (bi * 64) as u64, dqp + 32, 0)
                vp8mem.sti((*f).nzc, bi as usize, c)
                l = 0
                if c > 0 {
                    l = 1
                }
                vp8mem.sti(an, (pl + bx) as usize, l)
                nz = nz | l
                bx = bx + 1
            }
            vp8mem.sti(lnz, (pl + by) as usize, l)
            by = by + 1
        }
        pl = pl + 2
    }
    return nz
}

fn read_mb_tokens(f: *mut vp8state.Vp8, pd: *mut vp8bool.BD, mb: u64, col: i64) -> i64 {
    let ym: i64 = vp8mem.ldi(mb, vp8state.C_YMODE)
    let seg: i64 = vp8mem.ldi(mb, vp8state.C_SEG)
    let skip: i64 = vp8mem.ldi(mb, vp8state.C_SKIP)
    let lnz: u64 = (*f).left_nz
    let an: u64 = (*f).above_nz + (col * 36) as u64
    let y2: bool = has_y2(ym)
    if skip == 1 {
        clear_ctx(lnz, an, y2)
        return 0
    }
    let dqp: u64 = (&(*f).dq[0]) as u64 + (seg * 48) as u64
    var nz: i64 = 0
    var first: i64 = 0
    var ytype: i64 = 3
    if y2 {
        let ctx: i64 = vp8mem.ldi(lnz, 8) + vp8mem.ldi(an, 8)
        let c: i64 = vp8tok.read_block(pd, (*f).bandp + 136, ctx, (*f).coeffs + 1536, dqp + 16, 0)
        vp8mem.sti((*f).nzc, 24, c)
        var t: i64 = 0
        if c != 0 {
            t = 1
        }
        vp8mem.sti(lnz, 8, t)
        vp8mem.sti(an, 8, t)
        nz = t
        first = 1
        ytype = 0
    }
    nz = nz | read_luma(f, pd, lnz, an, dqp, first, ytype)
    nz = nz | read_chroma(f, pd, lnz, an, dqp)
    return nz
}
