import media.video.vp8.vp8mem

export { G_LF, G_LF_OK, lf_do2, lf_flat4, lf_flat8, lf_init, lf_inner_h, lf_inner_v, lf_mb_h, lf_mb_v, lf_rows_diff, lf_simple, lpx, lset, tabs, tcl1, tsc1, tsc2 }

static mut G_LF_OK: bool = false

static mut G_LF: [u8; 3584] = [0 as u8; 3584]

fn lf_init() {
    if G_LF_OK {
        return
    }
    var d: i64 = 0 - 1020
    while d <= 1020 {
        if d >= 0 - 255 && d <= 255 {
            G_LF[(255 + d) as usize] = vp8mem.iabs(d) as u8
        }
        var c1: i64 = d
        if c1 < 0 - 128 {
            c1 = 0 - 128
        }
        if c1 > 127 {
            c1 = 127
        }
        G_LF[(1532 + d) as usize] = (c1 & 255) as u8
        if d >= 0 - 112 && d <= 112 {
            var c2: i64 = d
            if c2 < 0 - 16 {
                c2 = 0 - 16
            }
            if c2 > 15 {
                c2 = 15
            }
            G_LF[(2672 + d) as usize] = (c2 & 255) as u8
        }
        if d >= 0 - 255 && d <= 510 {
            G_LF[(3071 + d) as usize] = vp8mem.clamp255(d) as u8
        }
        d = d + 1
    }
    G_LF_OK = true
}

fn lpx(a: i64) -> i64 {
    return (*(a as u64 as *mut u8)) as i64
}

fn lset(a: i64, v: i64) {
    *(a as u64 as *mut u8) = (v & 255) as u8
}

fn tabs(t: i64, d: i64) -> i64 {
    return (*((t + 255 + d) as u64 as *mut u8)) as i64
}

fn tsc1(t: i64, d: i64) -> i64 {
    return (*((t + 1532 + d) as u64 as *mut i8)) as i64
}

fn tsc2(t: i64, d: i64) -> i64 {
    return (*((t + 2672 + d) as u64 as *mut i8)) as i64
}

fn tcl1(t: i64, d: i64) -> i64 {
    return (*((t + 3071 + d) as u64 as *mut u8)) as i64
}

fn lf_flat8(q: i64) -> bool {
    let x: u64 = *((q - 4) as u64 as *mut u64)
    return x == (x & 255) * 72340172838076673
}

fn lf_flat4(q: i64) -> bool {
    let x: u64 = (*((q - 2) as u64 as *mut u32)) as u64
    return x == (x & 255) * 16843009
}

fn lf_do2(t: i64, q: i64, hs: i64) {
    let p1: i64 = lpx(q - 2 * hs)
    let p0: i64 = lpx(q - hs)
    let q0: i64 = lpx(q)
    let q1: i64 = lpx(q + hs)
    let a: i64 = 3 * (q0 - p0) + tsc1(t, p1 - q1)
    let a1: i64 = tsc2(t, (a + 4) >> 3)
    let a2: i64 = tsc2(t, (a + 3) >> 3)
    lset(q - hs, tcl1(t, p0 + a2))
    lset(q, tcl1(t, q0 - a1))
}

fn lf_simple(p: u64, hs: i64, vs: i64, thresh: i64) {
    if hs != 1 && lf_rows_diff(p, hs, 2, 0) == 0 && lf_rows_diff(p, hs, 2, 8) == 0 {
        return
    }
    let t: i64 = (&G_LF[0]) as u64 as i64
    let t2: i64 = 2 * thresh + 1
    var q: i64 = p as i64
    var k: i64 = 0
    while k < 16 {
        if hs == 1 && lf_flat4(q) {
            q = q + vs
            k = k + 1
            continue
        }
        let p1: i64 = lpx(q - 2 * hs)
        let p0: i64 = lpx(q - hs)
        let q0: i64 = lpx(q)
        let q1: i64 = lpx(q + hs)
        if 4 * tabs(t, p0 - q0) + tabs(t, p1 - q1) <= t2 {
            lf_do2(t, q, hs)
        }
        q = q + vs
        k = k + 1
    }
}

fn lf_rows_diff(p: u64, st: i64, k: i64, off: i64) -> u64 {
    var q: i64 = (p as i64) - k * st + off
    var prev: u64 = *(q as u64 as *mut u64)
    var acc: u64 = 0
    var j: i64 = 1
    while j < 2 * k {
        q = q + st
        let cur: u64 = *(q as u64 as *mut u64)
        acc = acc | (prev ^ cur)
        prev = cur
        j = j + 1
    }
    return acc
}

fn lf_mb_v(p: u64, vs: i64, n: i64, thresh: i64, it: i64, hev: i64) {
    let hs: i64 = 1
    let t: i64 = (&G_LF[0]) as u64 as i64
    let t2: i64 = 2 * thresh + 1
    var q: i64 = p as i64
    var k: i64 = 0
    while k < n {
        if lf_flat8(q) {
            q = q + vs
            k = k + 1
            continue
        }
        let p1: i64 = lpx(q - 2 * hs)
        let p0: i64 = lpx(q - hs)
        let q0: i64 = lpx(q)
        let q1: i64 = lpx(q + hs)
        if 4 * tabs(t, p0 - q0) + tabs(t, p1 - q1) <= t2 {
            let p3: i64 = lpx(q - 4 * hs)
            let p2: i64 = lpx(q - 3 * hs)
            let q2: i64 = lpx(q + 2 * hs)
            let q3: i64 = lpx(q + 3 * hs)
            let h1: i64 = tabs(t, p1 - p0)
            let h2: i64 = tabs(t, q1 - q0)
            if tabs(t, p3 - p2) <= it && tabs(t, p2 - p1) <= it && h1 <= it
            && tabs(t, q3 - q2) <= it && tabs(t, q2 - q1) <= it && h2 <= it {
                if h1 > hev || h2 > hev {
                    lf_do2(t, q, hs)
                } else {
                    let w: i64 = tsc1(t, 3 * (q0 - p0) + tsc1(t, p1 - q1))
                    let a1: i64 = (27 * w + 63) >> 7
                    let a2: i64 = (18 * w + 63) >> 7
                    let a3: i64 = (9 * w + 63) >> 7
                    lset(q - 3 * hs, tcl1(t, p2 + a3))
                    lset(q - 2 * hs, tcl1(t, p1 + a2))
                    lset(q - hs, tcl1(t, p0 + a1))
                    lset(q, tcl1(t, q0 - a1))
                    lset(q + hs, tcl1(t, q1 - a2))
                    lset(q + 2 * hs, tcl1(t, q2 - a3))
                }
            }
        }
        q = q + vs
        k = k + 1
    }
}

fn lf_mb_h(p: u64, hs: i64, n: i64, thresh: i64, it: i64, hev: i64) {
    let m0: u64 = lf_rows_diff(p, hs, 4, 0)
    var m1: u64 = 0
    if n == 16 {
        m1 = lf_rows_diff(p, hs, 4, 8)
    }
    if m0 == 0 && m1 == 0 {
        return
    }
    let t: i64 = (&G_LF[0]) as u64 as i64
    let t2: i64 = 2 * thresh + 1
    var q: i64 = p as i64
    var k: i64 = 0
    while k < n {
        var m: u64 = m0
        if k >= 8 {
            m = m1
        }
        if ((m >> (((k & 7) * 8) as u64)) & 255) == 0 {
            q = q + 1
            k = k + 1
            continue
        }
        let p1: i64 = lpx(q - 2 * hs)
        let p0: i64 = lpx(q - hs)
        let q0: i64 = lpx(q)
        let q1: i64 = lpx(q + hs)
        if 4 * tabs(t, p0 - q0) + tabs(t, p1 - q1) <= t2 {
            let p3: i64 = lpx(q - 4 * hs)
            let p2: i64 = lpx(q - 3 * hs)
            let q2: i64 = lpx(q + 2 * hs)
            let q3: i64 = lpx(q + 3 * hs)
            let h1: i64 = tabs(t, p1 - p0)
            let h2: i64 = tabs(t, q1 - q0)
            if tabs(t, p3 - p2) <= it && tabs(t, p2 - p1) <= it && h1 <= it
            && tabs(t, q3 - q2) <= it && tabs(t, q2 - q1) <= it && h2 <= it {
                if h1 > hev || h2 > hev {
                    lf_do2(t, q, hs)
                } else {
                    let w: i64 = tsc1(t, 3 * (q0 - p0) + tsc1(t, p1 - q1))
                    let a1: i64 = (27 * w + 63) >> 7
                    let a2: i64 = (18 * w + 63) >> 7
                    let a3: i64 = (9 * w + 63) >> 7
                    lset(q - 3 * hs, tcl1(t, p2 + a3))
                    lset(q - 2 * hs, tcl1(t, p1 + a2))
                    lset(q - hs, tcl1(t, p0 + a1))
                    lset(q, tcl1(t, q0 - a1))
                    lset(q + hs, tcl1(t, q1 - a2))
                    lset(q + 2 * hs, tcl1(t, q2 - a3))
                }
            }
        }
        q = q + 1
        k = k + 1
    }
}

fn lf_inner_v(p: u64, vs: i64, n: i64, thresh: i64, it: i64, hev: i64) {
    let hs: i64 = 1
    let t: i64 = (&G_LF[0]) as u64 as i64
    let t2: i64 = 2 * thresh + 1
    var q: i64 = p as i64
    var k: i64 = 0
    while k < n {
        if lf_flat8(q) {
            q = q + vs
            k = k + 1
            continue
        }
        let p1: i64 = lpx(q - 2 * hs)
        let p0: i64 = lpx(q - hs)
        let q0: i64 = lpx(q)
        let q1: i64 = lpx(q + hs)
        if 4 * tabs(t, p0 - q0) + tabs(t, p1 - q1) <= t2 {
            let p3: i64 = lpx(q - 4 * hs)
            let p2: i64 = lpx(q - 3 * hs)
            let q2: i64 = lpx(q + 2 * hs)
            let q3: i64 = lpx(q + 3 * hs)
            let h1: i64 = tabs(t, p1 - p0)
            let h2: i64 = tabs(t, q1 - q0)
            if tabs(t, p3 - p2) <= it && tabs(t, p2 - p1) <= it && h1 <= it
            && tabs(t, q3 - q2) <= it && tabs(t, q2 - q1) <= it && h2 <= it {
                if h1 > hev || h2 > hev {
                    lf_do2(t, q, hs)
                } else {
                    let a: i64 = 3 * (q0 - p0)
                    let a1: i64 = tsc2(t, (a + 4) >> 3)
                    let a2: i64 = tsc2(t, (a + 3) >> 3)
                    let a3: i64 = (a1 + 1) >> 1
                    lset(q - 2 * hs, tcl1(t, p1 + a3))
                    lset(q - hs, tcl1(t, p0 + a2))
                    lset(q, tcl1(t, q0 - a1))
                    lset(q + hs, tcl1(t, q1 - a3))
                }
            }
        }
        q = q + vs
        k = k + 1
    }
}

fn lf_inner_h(p: u64, hs: i64, n: i64, thresh: i64, it: i64, hev: i64) {
    let m0: u64 = lf_rows_diff(p, hs, 4, 0)
    var m1: u64 = 0
    if n == 16 {
        m1 = lf_rows_diff(p, hs, 4, 8)
    }
    if m0 == 0 && m1 == 0 {
        return
    }
    let t: i64 = (&G_LF[0]) as u64 as i64
    let t2: i64 = 2 * thresh + 1
    var q: i64 = p as i64
    var k: i64 = 0
    while k < n {
        var m: u64 = m0
        if k >= 8 {
            m = m1
        }
        if ((m >> (((k & 7) * 8) as u64)) & 255) == 0 {
            q = q + 1
            k = k + 1
            continue
        }
        let p1: i64 = lpx(q - 2 * hs)
        let p0: i64 = lpx(q - hs)
        let q0: i64 = lpx(q)
        let q1: i64 = lpx(q + hs)
        if 4 * tabs(t, p0 - q0) + tabs(t, p1 - q1) <= t2 {
            let p3: i64 = lpx(q - 4 * hs)
            let p2: i64 = lpx(q - 3 * hs)
            let q2: i64 = lpx(q + 2 * hs)
            let q3: i64 = lpx(q + 3 * hs)
            let h1: i64 = tabs(t, p1 - p0)
            let h2: i64 = tabs(t, q1 - q0)
            if tabs(t, p3 - p2) <= it && tabs(t, p2 - p1) <= it && h1 <= it
            && tabs(t, q3 - q2) <= it && tabs(t, q2 - q1) <= it && h2 <= it {
                if h1 > hev || h2 > hev {
                    lf_do2(t, q, hs)
                } else {
                    let a: i64 = 3 * (q0 - p0)
                    let a1: i64 = tsc2(t, (a + 4) >> 3)
                    let a2: i64 = tsc2(t, (a + 3) >> 3)
                    let a3: i64 = (a1 + 1) >> 1
                    lset(q - 2 * hs, tcl1(t, p1 + a3))
                    lset(q - hs, tcl1(t, p0 + a2))
                    lset(q, tcl1(t, q0 - a1))
                    lset(q + hs, tcl1(t, q1 - a3))
                }
            }
        }
        q = q + 1
        k = k + 1
    }
}
