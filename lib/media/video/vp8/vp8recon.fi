import media.video.vp8.vp8idct
import media.video.vp8.vp8intra
import media.video.vp8.vp8kfmode
import media.video.vp8.vp8mem
import media.video.vp8.vp8state

export { recon_intra_mb, recon_residual_luma, recon_residual_chroma }

fn fixup_left(p: u64, st: i64, n: i64, row: i64, mode: i64) {
    var i: i64 = 0
    if mode == vp8kfmode.M_DC && row > 0 {
        while i < n {
            vp8intra.put(p, st, 0 - 1, i, vp8intra.at(p, st, i, 0 - 1))
            i = i + 1
        }
        return
    }
    i = 0 - 1
    while i < n {
        vp8intra.put(p, st, 0 - 1, i, 129)
        i = i + 1
    }
}

fn fixup_above(p: u64, st: i64, n: i64, col: i64, mode: i64) {
    var i: i64 = 0
    if mode == vp8kfmode.M_DC && col > 0 {
        while i < n {
            vp8intra.put(p, st, i, 0 - 1, vp8intra.at(p, st, 0 - 1, i))
            i = i + 1
        }
    } else {
        i = 0 - 1
        while i < n {
            vp8intra.put(p, st, i, 0 - 1, 127)
            i = i + 1
        }
    }
    var k: i64 = 0
    while k < 4 {
        vp8intra.put(p, st, n + k, 0 - 1, 127)
        k = k + 1
    }
}

fn predict_plane(p: u64, st: i64, n: i64, mode: i64) {
    if mode == vp8kfmode.M_DC {
        vp8intra.pred_dc(p, st, n)
        return
    }
    if mode == vp8kfmode.M_V {
        vp8intra.pred_v(p, st, n)
        return
    }
    if mode == vp8kfmode.M_H {
        vp8intra.pred_h(p, st, n)
        return
    }
    vp8intra.pred_tm(p, st, n)
}

fn recon_y2(f: *mut vp8state.Vp8) {
    let coeffs: u64 = (*f).coeffs
    let y2: u64 = coeffs + 1536
    let c: i64 = vp8mem.ldi((*f).nzc, 24)
    if c > 1 {
        vp8idct.walsh(y2, coeffs)
        var k: u64 = 0
        while k < 64 {
            *((y2 + k) as *mut u64) = 0
            k = k + 8
        }
        return
    }
    if c == 1 {
        let dc0: i64 = vp8mem.s16((vp8mem.ldi(y2, 0) + 3) >> 3)
        var k: usize = 0
        while k < 16 {
            vp8mem.sti(coeffs, k * 16, dc0)
            k = k + 1
        }
        vp8mem.sti(y2, 0, 0)
    }
}

fn recon_residual_luma(f: *mut vp8state.Vp8, yp: u64, ys: i64, y2: bool) {
    if y2 {
        recon_y2(f)
    }
    var b: i64 = 0
    while b < 16 {
        let co: u64 = (*f).coeffs + (b * 64) as u64
        let c: i64 = vp8mem.ldi((*f).nzc, b as usize)
        if c > 1 || vp8mem.ldi(co, 0) != 0 {
            let bp: u64 = ((yp as i64) + (b >> 2) * 4 * ys + (b & 3) * 4) as u64
            vp8idct.recon_block(bp, ys, co, c)
        }
        b = b + 1
    }
}

fn recon_residual_chroma(f: *mut vp8state.Vp8, up: u64, vp: u64, uvs: i64) {
    var cb: i64 = 0
    while cb < 8 {
        let co: u64 = (*f).coeffs + ((16 + cb) * 64) as u64
        let c: i64 = vp8mem.ldi((*f).nzc, (16 + cb) as usize)
        if c > 1 || vp8mem.ldi(co, 0) != 0 {
            var pb: i64 = up as i64
            if cb >= 4 {
                pb = vp as i64
            }
            let q: i64 = cb & 3
            let o: i64 = (q >> 1) * 4 * uvs + (q & 1) * 4
            vp8idct.recon_block((pb + o) as u64, uvs, co, c)
        }
        cb = cb + 1
    }
}

fn recon_bpred(f: *mut vp8state.Vp8, mb: u64, yp: u64, ys: i64, skip: i64) {
    let ar: u32 = *(((yp as i64) - ys + 16) as u64 as *mut u32)
    *(((yp as i64) + 3 * ys + 16) as u64 as *mut u32) = ar
    *(((yp as i64) + 7 * ys + 16) as u64 as *mut u32) = ar
    *(((yp as i64) + 11 * ys + 16) as u64 as *mut u32) = ar
    var b: i64 = 0
    while b < 16 {
        let bp: u64 = ((yp as i64) + (b >> 2) * 4 * ys + (b & 3) * 4) as u64
        vp8intra.pred_b(bp, ys, vp8mem.ldi(mb, vp8state.C_BM + b as usize))
        if skip == 0 {
            let co: u64 = (*f).coeffs + (b * 64) as u64
            let c: i64 = vp8mem.ldi((*f).nzc, b as usize)
            if c > 1 || vp8mem.ldi(co, 0) != 0 {
                vp8idct.recon_block(bp, ys, co, c)
            }
        }
        b = b + 1
    }
}

fn recon_intra_mb(f: *mut vp8state.Vp8, mb: u64, row: i64, col: i64) {
    let ym: i64 = vp8mem.ldi(mb, vp8state.C_YMODE)
    let uvm: i64 = vp8mem.ldi(mb, vp8state.C_UVMODE)
    let skip: i64 = vp8mem.ldi(mb, vp8state.C_SKIP)
    let ys: i64 = (*f).ys
    let uvs: i64 = (*f).uvs
    let yp: u64 = ((vp8state.plane_y(f, (*f).cur) as i64) + row * 16 * ys + col * 16) as u64
    let up: u64 = ((vp8state.plane_u(f, (*f).cur) as i64) + row * 8 * uvs + col * 8) as u64
    let vp: u64 = ((vp8state.plane_v(f, (*f).cur) as i64) + row * 8 * uvs + col * 8) as u64
    if col == 0 {
        fixup_left(yp, ys, 16, row, ym)
        fixup_left(up, uvs, 8, row, uvm)
        fixup_left(vp, uvs, 8, row, uvm)
        if row == 0 {
            vp8intra.put(yp, ys, 0 - 1, 0 - 1, 127)
        }
    }
    if row == 0 {
        fixup_above(yp, ys, 16, col, ym)
        fixup_above(up, uvs, 8, col, uvm)
        fixup_above(vp, uvs, 8, col, uvm)
    }
    if ym == vp8kfmode.M_B {
        recon_bpred(f, mb, yp, ys, skip)
    } else {
        predict_plane(yp, ys, 16, ym)
        if skip == 0 {
            recon_residual_luma(f, yp, ys, true)
        }
    }
    predict_plane(up, uvs, 8, uvm)
    predict_plane(vp, uvs, 8, uvm)
    if skip == 0 {
        recon_residual_chroma(f, up, vp, uvs)
    }
}
