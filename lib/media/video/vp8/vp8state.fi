import media.video.vp8.vp8bool
import media.video.vp8.vp8mem

export {
    Vp8, vp8_new, vp8_release, vp8_setup, mbi_at, plane_y, plane_u, plane_v, stq,
    MBI_CELLS, BORDER, C_YMODE, C_UVMODE, C_SEG, C_SKIP, C_NZ, C_REF, C_MVY, C_MVX, C_BM, C_SMV,
    Y_NEAREST, Y_NEAR, Y_ZERO, Y_NEW, Y_SPLIT, ENT_COEF, ENT_Y, ENT_UV, ENT_MV, ENT_LEN, MAX_PIXELS,
}

const MBI_CELLS: i64 = 64
const BORDER: i64 = 32
const MAX_PIXELS: i64 = 16777216

const C_YMODE: usize = 0
const C_UVMODE: usize = 1
const C_SEG: usize = 2
const C_SKIP: usize = 3
const C_NZ: usize = 4
const C_REF: usize = 5
const C_MVY: usize = 6
const C_MVX: usize = 7
const C_BM: usize = 8
const C_SMV: usize = 24

const Y_NEAREST: i64 = 5
const Y_NEAR: i64 = 6
const Y_ZERO: i64 = 7
const Y_NEW: i64 = 8
const Y_SPLIT: i64 = 9

const ENT_COEF: usize = 0
const ENT_Y: usize = 1056
const ENT_UV: usize = 1060
const ENT_MV: usize = 1064
const ENT_LEN: usize = 1104

struct Vp8 {
    ready: bool,
    w: i64,
    h: i64,
    mbw: i64,
    mbh: i64,
    version: i64,
    keyframe: bool,
    show: bool,
    ys: i64,
    uvs: i64,
    ybytes: usize,
    uvbytes: usize,
    ybuf: [u64; 4],
    ubuf: [u64; 4],
    vbuf: [u64; 4],
    refs: [i64; 4],
    cur: i64,
    mbi: u64,
    mbin: usize,
    ent: u64,
    saved: u64,
    seg_on: i64,
    seg_map: i64,
    seg_abs: i64,
    seg_q: [i64; 4],
    seg_lf: [i64; 4],
    seg_p: [i64; 3],
    lf_simple: i64,
    lf_level: i64,
    lf_sharp: i64,
    lf_delta: i64,
    ref_delta: [i64; 4],
    mode_delta: [i64; 4],
    skip_on: i64,
    skip_p: i64,
    prob_inter: i64,
    prob_last: i64,
    prob_gf: i64,
    sign_bias: [i64; 4],
    refresh_gf: i64,
    refresh_arf: i64,
    copy_gf: i64,
    copy_arf: i64,
    refresh_entropy: i64,
    refresh_last: i64,
    nparts: i64,
    parts: [vp8bool.BD; 8],
    dq: [i64; 24],
    coeffs: u64,
    above_nz: u64,
    left_nz: u64,
    nzc: u64,
    bandp: u64,
    emu: u64,
    tmp: u64,
}

fn vp8_new() -> Vp8 {
    return Vp8 {
        ready: false, w: 0, h: 0, mbw: 0, mbh: 0, version: 0, keyframe: false, show: false, ys: 0, uvs: 0,
        ybytes: 0, uvbytes: 0, ybuf: [0 as u64; 4], ubuf: [0 as u64; 4], vbuf: [0 as u64; 4],
        refs: [0 - 1; 4], cur: 0, mbi: 0, mbin: 0, ent: 0, saved: 0,
        seg_on: 0, seg_map: 0, seg_abs: 0, seg_q: [0; 4], seg_lf: [0; 4], seg_p: [255; 3],
        lf_simple: 0, lf_level: 0, lf_sharp: 0, lf_delta: 0, ref_delta: [0; 4], mode_delta: [0; 4],
        skip_on: 0, skip_p: 0, prob_inter: 0, prob_last: 0, prob_gf: 0, sign_bias: [0; 4],
        refresh_gf: 0, refresh_arf: 0, copy_gf: 0, copy_arf: 0, refresh_entropy: 0, refresh_last: 0,
        nparts: 1, parts: [vp8bool.bd_new(); 8], dq: [0; 24],
        coeffs: 0, above_nz: 0, left_nz: 0, nzc: 0, bandp: 0, emu: 0, tmp: 0,
    }
}

fn vp8_release(f: *mut Vp8) {
    var i: usize = 0
    while i < 4 {
        vp8mem.free((*f).ybuf[i], (*f).ybytes)
        vp8mem.free((*f).ubuf[i], (*f).uvbytes)
        vp8mem.free((*f).vbuf[i], (*f).uvbytes)
        (*f).ybuf[i] = 0
        (*f).ubuf[i] = 0
        (*f).vbuf[i] = 0
        i = i + 1
    }
    vp8mem.free((*f).mbi, (*f).mbin)
    vp8mem.free((*f).ent, ENT_LEN)
    vp8mem.free((*f).saved, ENT_LEN)
    vp8mem.free((*f).coeffs, 1600)
    vp8mem.free((*f).above_nz, (((*f).mbw + 1) * 36) as usize)
    vp8mem.free((*f).left_nz, 36)
    vp8mem.free((*f).nzc, 100)
    vp8mem.free((*f).bandp, 544)
    vp8mem.free((*f).emu, 2048)
    vp8mem.free((*f).tmp, 2048)
    (*f).mbi = 0
    (*f).ent = 0
    (*f).saved = 0
    (*f).coeffs = 0
    (*f).above_nz = 0
    (*f).left_nz = 0
    (*f).nzc = 0
    (*f).bandp = 0
    (*f).emu = 0
    (*f).tmp = 0
    (*f).ready = false
}

fn vp8_setup(f: *mut Vp8, w: i64, h: i64) -> bool {
    vp8_release(f)
    if w <= 0 || h <= 0 || w * h > MAX_PIXELS {
        return false
    }
    (*f).w = w
    (*f).h = h
    (*f).mbw = (w + 15) / 16
    (*f).mbh = (h + 15) / 16
    let mbw: i64 = (*f).mbw
    let mbh: i64 = (*f).mbh
    (*f).ys = mbw * 16 + 2 * BORDER
    (*f).uvs = mbw * 8 + 2 * BORDER
    (*f).ybytes = ((*f).ys * (mbh * 16 + 2 * BORDER)) as usize
    (*f).uvbytes = ((*f).uvs * (mbh * 8 + 2 * BORDER)) as usize
    var ok: bool = true
    var i: usize = 0
    while i < 4 {
        (*f).ybuf[i] = vp8mem.alloc((*f).ybytes)
        (*f).ubuf[i] = vp8mem.alloc((*f).uvbytes)
        (*f).vbuf[i] = vp8mem.alloc((*f).uvbytes)
        if (*f).ybuf[i] == 0 || (*f).ubuf[i] == 0 || (*f).vbuf[i] == 0 {
            ok = false
        } else {
            vp8mem.zero((*f).ybuf[i], (*f).ybytes)
            vp8mem.zero((*f).ubuf[i], (*f).uvbytes)
            vp8mem.zero((*f).vbuf[i], (*f).uvbytes)
        }
        i = i + 1
    }
    (*f).mbin = (((mbw + 1) * (mbh + 1) + 1) * MBI_CELLS * 4) as usize
    (*f).mbi = vp8mem.alloc((*f).mbin)
    (*f).ent = vp8mem.alloc(ENT_LEN)
    (*f).saved = vp8mem.alloc(ENT_LEN)
    (*f).coeffs = vp8mem.alloc(1600)
    (*f).above_nz = vp8mem.alloc(((mbw + 1) * 36) as usize)
    (*f).left_nz = vp8mem.alloc(36)
    (*f).nzc = vp8mem.alloc(100)
    (*f).bandp = vp8mem.alloc(544)
    (*f).emu = vp8mem.alloc(2048)
    (*f).tmp = vp8mem.alloc(2048)
    if (*f).mbi == 0 || (*f).ent == 0 || (*f).saved == 0 || (*f).coeffs == 0 || (*f).above_nz == 0
    || (*f).left_nz == 0 || (*f).nzc == 0 || (*f).bandp == 0 || (*f).emu == 0 || (*f).tmp == 0 {
        ok = false
    }
    if !ok {
        vp8_release(f)
        return false
    }
    vp8mem.zero((*f).mbi, (*f).mbin)
    vp8mem.zero((*f).coeffs, 1600)
    vp8mem.zero((*f).ent, ENT_LEN)
    vp8mem.zero((*f).saved, ENT_LEN)
    (*f).refs[0] = 0 - 1
    (*f).refs[1] = 0 - 1
    (*f).refs[2] = 0 - 1
    (*f).refs[3] = 0 - 1
    (*f).ready = true
    return true
}

fn mbi_at(f: *mut Vp8, row: i64, col: i64) -> u64 {
    return (*f).mbi + (((row + 1) * ((*f).mbw + 1) + (col + 1)) * MBI_CELLS * 4) as u64
}

fn plane_y(f: *mut Vp8, i: i64) -> u64 {
    return (*f).ybuf[i as usize] + (BORDER * (*f).ys + BORDER) as u64
}

fn plane_u(f: *mut Vp8, i: i64) -> u64 {
    return (*f).ubuf[i as usize] + (BORDER * (*f).uvs + BORDER) as u64
}

fn plane_v(f: *mut Vp8, i: i64) -> u64 {
    return (*f).vbuf[i as usize] + (BORDER * (*f).uvs + BORDER) as u64
}

fn stq(p: u64, i: usize, v: u64) {
    *((p + (i * 8) as u64) as *mut u64) = v
}
