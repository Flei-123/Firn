import media.video.vp8.vp8bool
import media.video.vp8.vp8mem

export { BANDS, CAT6, ZIGZAG, read_block, read_large }

static ZIGZAG: [u8; 16] = [0, 1, 4, 8, 5, 2, 3, 6, 9, 12, 13, 10, 7, 11, 14, 15]

static BANDS: [u8; 17] = [0, 1, 2, 3, 6, 4, 5, 6, 6, 6, 6, 6, 6, 6, 6, 7, 0]

static CAT6: [u8; 11] = [254, 254, 243, 230, 196, 177, 153, 140, 133, 130, 129]

fn read_large(d: *mut vp8bool.BD, p: u64) -> i64 {
    var v: i64 = 0
    if vp8bool.bd_get(d, vp8mem.ld8(p, 3)) == 0 {
        if vp8bool.bd_get(d, vp8mem.ld8(p, 4)) == 0 {
            v = 2
        } else {
            v = 3 + vp8bool.bd_get(d, vp8mem.ld8(p, 5))
        }
    } else if vp8bool.bd_get(d, vp8mem.ld8(p, 6)) == 0 {
        if vp8bool.bd_get(d, vp8mem.ld8(p, 7)) == 0 {
            v = 5 + vp8bool.bd_get(d, 159)
        } else {
            v = 7 + 2 * vp8bool.bd_get(d, 165)
            v = v + vp8bool.bd_get(d, 145)
        }
    } else if vp8bool.bd_get(d, vp8mem.ld8(p, 8)) == 0 {
        if vp8bool.bd_get(d, vp8mem.ld8(p, 9)) == 0 {
            v = 11 + 4 * vp8bool.bd_get(d, 173)
            v = v + 2 * vp8bool.bd_get(d, 148)
            v = v + vp8bool.bd_get(d, 140)
        } else {
            v = 19 + 8 * vp8bool.bd_get(d, 176)
            v = v + 4 * vp8bool.bd_get(d, 155)
            v = v + 2 * vp8bool.bd_get(d, 140)
            v = v + vp8bool.bd_get(d, 135)
        }
    } else if vp8bool.bd_get(d, vp8mem.ld8(p, 10)) == 0 {
        v = 35 + 16 * vp8bool.bd_get(d, 180)
        v = v + 8 * vp8bool.bd_get(d, 157)
        v = v + 4 * vp8bool.bd_get(d, 141)
        v = v + 2 * vp8bool.bd_get(d, 134)
        v = v + vp8bool.bd_get(d, 130)
    } else {
        v = 67
        var k: i64 = 0
        while k < 11 {
            v = v + (vp8bool.bd_get(d, CAT6[k as usize] as i64) << (10 - k))
            k = k + 1
        }
    }
    return v
}

fn read_block(d: *mut vp8bool.BD, bp: u64, ctx0: i64, out: u64, dq: u64,
    first: i64) -> i64 {
    var n: i64 = first
    var p: u64 = *((bp + (n * 8) as u64) as *mut u64) + (ctx0 * 11) as u64
    while n < 16 {
        if vp8bool.bd_get(d, vp8mem.ld8(p, 0)) == 0 {
            return n
        }
        while vp8bool.bd_get(d, vp8mem.ld8(p, 1)) == 0 {
            n = n + 1
            if n == 16 {
                return 16
            }
            p = *((bp + (n * 8) as u64) as *mut u64)
        }
        let pn: u64 = *((bp + ((n + 1) * 8) as u64) as *mut u64)
        var v: i64 = 1
        if vp8bool.bd_get(d, vp8mem.ld8(p, 2)) == 0 {
            p = pn + 11
        } else {
            v = read_large(d, p)
            p = pn + 22
        }
        if vp8bool.bd_get(d, 128) == 1 {
            v = 0 - v
        }
        if n > 0 {
            v = v * *((dq + 8) as *mut i64)
        } else {
            v = v * *(dq as *mut i64)
        }
        vp8mem.sti(out, ZIGZAG[n as usize] as usize, vp8mem.s16(v))
        n = n + 1
    }
    return 16
}
