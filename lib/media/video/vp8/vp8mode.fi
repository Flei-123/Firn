import media.video.vp8.vp8bool
import media.video.vp8.vp8kfmode
import media.video.vp8.vp8mem
import media.video.vp8.vp8state
import media.video.vp8.vp8tabs

export { read_key_modes, read_segment_id }

fn read_segment_id(f: *mut vp8state.Vp8, d: *mut vp8bool.BD) -> i64 {
    if vp8bool.bd_get(d, (*f).seg_p[0]) == 1 {
        return 2 + vp8bool.bd_get(d, (*f).seg_p[2])
    }
    return vp8bool.bd_get(d, (*f).seg_p[1])
}

fn read_bmodes_key(d: *mut vp8bool.BD, mb: u64, mba: u64, mbl: u64) {
    let tb: u64 = vp8tabs.vp8_kf_bmode_addr()
    var b: usize = 0
    while b < 16 {
        var am: i64 = 0
        if b < 4 {
            am = vp8mem.ldi(mba, vp8state.C_BM + b + 12)
        } else {
            am = vp8mem.ldi(mb, vp8state.C_BM + b - 4)
        }
        var lm: i64 = 0
        if (b & 3) == 0 {
            lm = vp8mem.ldi(mbl, vp8state.C_BM + b + 3)
        } else {
            lm = vp8mem.ldi(mb, vp8state.C_BM + b - 1)
        }
        let pr: u64 = tb + ((am * 10 + lm) * 9) as u64
        vp8mem.sti(mb, vp8state.C_BM + b, vp8kfmode.read_bmode(d, pr))
        b = b + 1
    }
}

fn fill_implied(mb: u64, ym: i64) {
    let im: i64 = vp8kfmode.implied_bmode(ym)
    var b: usize = 0
    while b < 16 {
        vp8mem.sti(mb, vp8state.C_BM + b, im)
        b = b + 1
    }
}

fn read_key_modes(f: *mut vp8state.Vp8, d: *mut vp8bool.BD, mb: u64, mba: u64, mbl: u64) {
    var seg: i64 = 0
    if (*f).seg_on == 1 {
        seg = vp8mem.ldi(mb, vp8state.C_SEG)
        if (*f).seg_map == 1 {
            seg = read_segment_id(f, d)
        }
    }
    var skip: i64 = 0
    if (*f).skip_on == 1 {
        skip = vp8bool.bd_get(d, (*f).skip_p)
    }
    let ym: i64 = vp8kfmode.read_kf_ymode(d)
    if ym == vp8kfmode.M_B {
        read_bmodes_key(d, mb, mba, mbl)
    } else {
        fill_implied(mb, ym)
    }
    let uvm: i64 = vp8kfmode.read_uvmode(d)
    vp8mem.sti(mb, vp8state.C_YMODE, ym)
    vp8mem.sti(mb, vp8state.C_UVMODE, uvm)
    vp8mem.sti(mb, vp8state.C_SEG, seg)
    vp8mem.sti(mb, vp8state.C_SKIP, skip)
    vp8mem.sti(mb, vp8state.C_REF, 0)
}
