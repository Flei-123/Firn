// SPDX-License-Identifier: MPL-2.0
import media.video.vp8.vp8mem

export { predict_block }

static SIXTAP: [i16; 48] = [
    0, 0, 128, 0, 0, 0,
    0, -6, 123, 12, -1, 0,
    2, -11, 108, 36, -8, 1,
    0, -9, 93, 50, -6, 0,
    3, -16, 77, 77, -16, 3,
    0, -6, 50, 93, -9, 0,
    1, -8, 36, 108, -11, 2,
    0, -1, 12, 123, -6, 0
]

static BILINEAR: [i16; 48] = [
    0, 0, 128, 0, 0, 0,
    0, 0, 112, 16, 0, 0,
    0, 0, 96, 32, 0, 0,
    0, 0, 80, 48, 0, 0,
    0, 0, 64, 64, 0, 0,
    0, 0, 48, 80, 0, 0,
    0, 0, 32, 96, 0, 0,
    0, 0, 16, 112, 0, 0
]

fn tap(bil: bool, idx: usize) -> i64 {
    if bil {
        return BILINEAR[idx] as i64
    }
    return SIXTAP[idx] as i64
}

fn filter_h(bil: bool, src: u64, off: i64, f: usize) -> i64 {
    let s: i64 = (src as i64) + off
    var acc: i64 = 64
    var k: usize = 0
    while k < 6 {
        let t: i64 = tap(bil, f * 6 + k)
        if t != 0 {
            acc = acc + t * vp8mem.ld8o(s as u64, (k as i64) - 2)
        }
        k = k + 1
    }
    return vp8mem.clamp255(acc >> 7)
}

fn filter_v(bil: bool, src: u64, off: i64, st: i64, f: usize) -> i64 {
    let s: i64 = (src as i64) + off
    var acc: i64 = 64
    var k: usize = 0
    while k < 6 {
        let t: i64 = tap(bil, f * 6 + k)
        if t != 0 {
            acc = acc + t * vp8mem.ld8o(s as u64, ((k as i64) - 2) * st)
        }
        k = k + 1
    }
    return vp8mem.clamp255(acc >> 7)
}

fn mc_block(bil: bool, src: u64, ss: i64, dst: u64, ds: i64, bw: i64, bh: i64, fx: i64, fy: i64, tmp: u64) {
    var y: i64 = 0
    if fx == 0 && fy == 0 {
        while y < bh {
            var x: i64 = 0
            while x < bw {
                vp8mem.st8o(dst, y * ds + x, vp8mem.ld8o(src, y * ss + x))
                x = x + 1
            }
            y = y + 1
        }
        return
    }
    if fy == 0 {
        while y < bh {
            var x: i64 = 0
            while x < bw {
                vp8mem.st8o(dst, y * ds + x, filter_h(bil, src, y * ss + x, fx as usize))
                x = x + 1
            }
            y = y + 1
        }
        return
    }
    if fx == 0 {
        while y < bh {
            var x: i64 = 0
            while x < bw {
                vp8mem.st8o(dst, y * ds + x, filter_v(bil, src, y * ss + x, ss, fy as usize))
                x = x + 1
            }
            y = y + 1
        }
        return
    }
    while y < bh + 5 {
        var x: i64 = 0
        while x < bw {
            vp8mem.st8o(tmp, y * bw + x, filter_h(bil, src, (y - 2) * ss + x, fx as usize))
            x = x + 1
        }
        y = y + 1
    }
    y = 0
    while y < bh {
        var x: i64 = 0
        while x < bw {
            vp8mem.st8o(dst, y * ds + x, filter_v(bil, tmp, (y + 2) * bw + x, bw, fy as usize))
            x = x + 1
        }
        y = y + 1
    }
}

fn clamp_idx(v: i64, n: i64) -> i64 {
    if v < 0 {
        return 0
    }
    if v >= n {
        return n - 1
    }
    return v
}

fn predict_block(bil: bool, refp: u64, rs: i64, pw: i64, ph: i64, bx: i64, by: i64, mvx: i64, mvy: i64,
    bw: i64, bh: i64, dst: u64, ds: i64, emu: u64, tmp: u64) {
    let sx: i64 = bx + (mvx >> 3)
    let sy: i64 = by + (mvy >> 3)
    let fx: i64 = mvx & 7
    let fy: i64 = mvy & 7
    if sx >= 2 && sy >= 2 && sx + bw + 3 <= pw && sy + bh + 3 <= ph {
        mc_block(bil, ((refp as i64) + sy * rs + sx) as u64, rs, dst, ds, bw, bh, fx, fy, tmp)
        return
    }
    let ew: i64 = bw + 5
    var yy: i64 = 0
    while yy < bh + 5 {
        let cy: i64 = clamp_idx(sy - 2 + yy, ph)
        var xx: i64 = 0
        while xx < ew {
            let cx: i64 = clamp_idx(sx - 2 + xx, pw)
            vp8mem.st8o(emu, yy * ew + xx, vp8mem.ld8o(refp, cy * rs + cx))
            xx = xx + 1
        }
        yy = yy + 1
    }
    mc_block(bil, ((emu as i64) + 2 * ew + 2) as u64, ew, dst, ds, bw, bh, fx, fy, tmp)
}
