import media.video.vp8.vp8bool
import media.video.vp8.vp8mem
import media.video.vp8.vp8state

export { Near, near_new, find_near, read_mv_component, clamp_axis, mode_prob }

struct Near {
    y: [i64; 4],
    x: [i64; 4],
    cnt: [i64; 4],
    n: i64,
}

fn near_new() -> Near {
    return Near { y: [0; 4], x: [0; 4], cnt: [0; 4], n: 0 }
}

static MODE_CTX: [u8; 24] = [7, 1, 1, 143, 14, 18, 14, 107, 135, 64, 57, 68, 60, 56, 128, 65, 159, 134, 128, 34, 234, 188, 128, 28]

fn mode_prob(count: i64, which: i64) -> i64 {
    return MODE_CTX[(count * 4 + which) as usize] as i64
}

fn clamp_axis(v: i64, lo: i64, hi: i64) -> i64 {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

fn consider(f: *mut vp8state.Vp8, nr: *mut Near, nb: u64, rf: i64, weight: i64) {
    let nref: i64 = vp8mem.ldi(nb, vp8state.C_REF)
    if nref == 0 {
        return
    }
    var ny: i64 = vp8mem.ldi(nb, vp8state.C_MVY)
    var nx: i64 = vp8mem.ldi(nb, vp8state.C_MVX)
    if ny == 0 && nx == 0 {
        (*nr).cnt[0] = (*nr).cnt[0] + weight
        return
    }
    if (*f).sign_bias[nref as usize] != (*f).sign_bias[rf as usize] {
        ny = 0 - ny
        nx = 0 - nx
    }
    let k: usize = (*nr).n as usize
    if k > 0 && (*nr).y[k] == ny && (*nr).x[k] == nx {
        (*nr).cnt[k] = (*nr).cnt[k] + weight
        return
    }
    (*nr).n = (*nr).n + 1
    let m: usize = (*nr).n as usize
    (*nr).y[m] = ny
    (*nr).x[m] = nx
    (*nr).cnt[m] = (*nr).cnt[m] + weight
}

fn is_split(nb: u64) -> i64 {
    if vp8mem.ldi(nb, vp8state.C_YMODE) == vp8state.Y_SPLIT {
        return 1
    }
    return 0
}

fn find_near(f: *mut vp8state.Vp8, nr: *mut Near, rf: i64, mba: u64, mbl: u64, mbal: u64) {
    var i: usize = 0
    while i < 4 {
        (*nr).y[i] = 0
        (*nr).x[i] = 0
        (*nr).cnt[i] = 0
        i = i + 1
    }
    (*nr).n = 0
    consider(f, nr, mba, rf, 2)
    consider(f, nr, mbl, rf, 2)
    consider(f, nr, mbal, rf, 1)
    if (*nr).cnt[3] > 0 && (*nr).y[3] == (*nr).y[1] && (*nr).x[3] == (*nr).x[1] {
        (*nr).cnt[1] = (*nr).cnt[1] + 1
    }
    (*nr).cnt[3] = (is_split(mba) + is_split(mbl)) * 2 + is_split(mbal)
    if (*nr).cnt[2] > (*nr).cnt[1] {
        let tc: i64 = (*nr).cnt[1]
        (*nr).cnt[1] = (*nr).cnt[2]
        (*nr).cnt[2] = tc
        let ty: i64 = (*nr).y[1]
        let tx: i64 = (*nr).x[1]
        (*nr).y[1] = (*nr).y[2]
        (*nr).x[1] = (*nr).x[2]
        (*nr).y[2] = ty
        (*nr).x[2] = tx
    }
    if (*nr).cnt[1] >= (*nr).cnt[0] {
        (*nr).y[0] = (*nr).y[1]
        (*nr).x[0] = (*nr).x[1]
    }
}

fn read_mv_component(d: *mut vp8bool.BD, p: u64) -> i64 {
    var x: i64 = 0
    if vp8bool.bd_get(d, vp8mem.ld8(p, 0)) == 1 {
        var i: usize = 0
        while i < 3 {
            x = x + (vp8bool.bd_get(d, vp8mem.ld8(p, 9 + i)) << (i as u64))
            i = i + 1
        }
        i = 9
        while i > 3 {
            x = x + (vp8bool.bd_get(d, vp8mem.ld8(p, 9 + i)) << (i as u64))
            i = i - 1
        }
        if (x & 65520) == 0 {
            x = x + 8
        } else {
            x = x + (vp8bool.bd_get(d, vp8mem.ld8(p, 12)) << 3)
        }
    } else {
        if vp8bool.bd_get(d, vp8mem.ld8(p, 2)) == 0 {
            if vp8bool.bd_get(d, vp8mem.ld8(p, 3)) == 0 {
                x = vp8bool.bd_get(d, vp8mem.ld8(p, 4))
            } else {
                x = 2 + vp8bool.bd_get(d, vp8mem.ld8(p, 5))
            }
        } else {
            if vp8bool.bd_get(d, vp8mem.ld8(p, 6)) == 0 {
                x = 4 + vp8bool.bd_get(d, vp8mem.ld8(p, 7))
            } else {
                x = 6 + vp8bool.bd_get(d, vp8mem.ld8(p, 8))
            }
        }
    }
    if x != 0 && vp8bool.bd_get(d, vp8mem.ld8(p, 1)) == 1 {
        return 0 - x
    }
    return x
}
