// SPDX-License-Identifier: MPL-2.0
import docview.obj
import std.rt
import media.demux
import media.video.av1rgba
import media.video.vidops
import media.video.av1.av1dec
import media.video.av1.av1seq
import media.video.av1.av1fhdr

export { vav1_ops }

struct Av1Source {
    dm: demux.Demux,
    dec: u64,
    pend: rt.Buf,
    pend_off: usize,
    pts_hold: i64,
    track: i32,
    data: u64,
    next: usize,
    count: usize,
    open: bool,
}

fn feed_config(vs: *mut Av1Source) {
    let cfg: u64 = demux.demux_track_cfg(&(*vs).dm, (*vs).track)
    let n: usize = demux.demux_track_cfg_len(&(*vs).dm, (*vs).track)
    if cfg != 0 && n > 4 {
        var scratch: rt.Buf = rt.buf_new()
        av1dec.dec_stream((*vs).dec as *mut av1dec.Decoder, &scratch, cfg + 4, n - 4)
        rt.buf_free(&scratch)
    }
}

fn reset_decoder(vs: *mut Av1Source) {
    if (*vs).dec != 0 {
        av1dec.dec_free((*vs).dec as *mut av1dec.Decoder)
    }
    (*vs).dec = av1dec.dec_new() as u64
    rt.buf_clear(&(*vs).pend)
    (*vs).pend_off = 0
    feed_config(vs)
}

fn h_create() -> u64 {
    let raw: u64 = obj.obj_alloc[Av1Source]()
    if raw == 0 as u64 {
        return raw
    }
    *(raw as *mut Av1Source) = Av1Source { dm: demux.demux_new(), dec: 0, pend: rt.buf_new(), pend_off: 0, pts_hold: 0, track: -1, data: 0, next: 0, count: 0, open: false }
    return raw
}

fn h_destroy(h: u64) {
    if h != 0 as u64 {
        obj.obj_free[Av1Source](h)
    }
}

fn h_open(h: u64, data: u64, n: usize) -> i32 {
    let vs: *mut Av1Source = h as *mut Av1Source
    if demux.demux_open(&(*vs).dm, data, n) != 0 {
        return vidops.VO_ERR_FORMAT
    }
    let t: i32 = demux.demux_find_track(&(*vs).dm, demux.TK_VIDEO)
    if t < 0 {
        return vidops.VO_ERR_FORMAT
    }
    if demux.demux_track_codec(&(*vs).dm, t) != demux.CODEC_AV1 {
        return vidops.VO_ERR_UNSUPPORTED
    }
    (*vs).track = t
    (*vs).data = data
    (*vs).count = demux.demux_nsamples(&(*vs).dm, t)
    reset_decoder(vs)
    (*vs).open = true
    return vidops.VO_OK
}

fn h_close(h: u64) {
    let vs: *mut Av1Source = h as *mut Av1Source
    if (*vs).dec != 0 {
        av1dec.dec_free((*vs).dec as *mut av1dec.Decoder)
        (*vs).dec = 0
    }
    rt.buf_free(&(*vs).pend)
    demux.demux_free(&(*vs).dm)
    (*vs).open = false
}

fn h_width(h: u64) -> u32 {
    let vs: *mut Av1Source = h as *mut Av1Source
    return demux.demux_track_width(&(*vs).dm, (*vs).track)
}

fn h_height(h: u64) -> u32 {
    let vs: *mut Av1Source = h as *mut Av1Source
    return demux.demux_track_height(&(*vs).dm, (*vs).track)
}

fn h_duration(h: u64) -> i64 {
    let vs: *mut Av1Source = h as *mut Av1Source
    return demux.demux_track_duration_us(&(*vs).dm, (*vs).track)
}

fn h_fps(h: u64) -> u32 {
    let vs: *mut Av1Source = h as *mut Av1Source
    let dur: i64 = h_duration(h)
    if dur <= 0 || (*vs).count == 0 {
        return 0
    }
    return (((*vs).count as i64) * 1000000000 / dur) as u32
}

fn h_bytes(h: u64) -> usize {
    return (h_width(h) as usize) * (h_height(h) as usize) * 4
}

fn h_next(h: u64, out: u64, pts: *mut i64) -> i32 {
    let vs: *mut Av1Source = h as *mut Av1Source
    if !(*vs).open {
        return vidops.VO_ERR_UNSUPPORTED
    }
    let d: *mut av1dec.Decoder = (*vs).dec as *mut av1dec.Decoder
    while true {
        if (*vs).pend_off >= rt.buf_len(&(*vs).pend) {
            rt.buf_clear(&(*vs).pend)
            (*vs).pend_off = 0
            if (*vs).next >= (*vs).count {
                return vidops.VO_END
            }
            let i: usize = (*vs).next
            (*vs).next = i + 1
            let sp: u64 = (*vs).data + demux.demux_sample_off(&(*vs).dm, (*vs).track, i)
            let ss: usize = demux.demux_sample_size(&(*vs).dm, (*vs).track, i) as usize
            av1dec.dec_stream(d, &(*vs).pend, sp, ss)
            if (*d).err != 0 {
                return vidops.VO_ERR_DECODE
            }
            (*vs).pts_hold = demux.demux_sample_pts_us(&(*vs).dm, (*vs).track, i)
        }
        if rt.buf_len(&(*vs).pend) == 0 {
            continue
        }
        let seq: *mut av1seq.SeqHdr = (*d).seq
        let fh: *mut av1fhdr.FrameHdr = (*d).fh
        let w: usize = (*fh).upscaled_width as usize
        let fhh: usize = (*fh).frame_height as usize
        let fb: usize = av1rgba.frame_bytes(w, fhh, (*seq).subsampling_x as usize, (*seq).subsampling_y as usize, (*seq).num_planes as usize, (*seq).bit_depth as usize)
        if w != (h_width(h) as usize) || fhh != (h_height(h) as usize) || (*vs).pend_off + fb > rt.buf_len(&(*vs).pend) {
            return vidops.VO_ERR_DECODE
        }
        av1rgba.planar_to_rgba(rt.buf_ptr(&(*vs).pend) + (*vs).pend_off as u64, w, fhh, (*seq).subsampling_x as usize, (*seq).subsampling_y as usize, (*seq).num_planes as usize, (*seq).bit_depth as usize, (*seq).matrix_coefficients as i32, out)
        (*vs).pend_off = (*vs).pend_off + fb
        *pts = (*vs).pts_hold
        return 1
    }
    return vidops.VO_END
}

fn h_seek(h: u64, t: i64) -> i64 {
    let vs: *mut Av1Source = h as *mut Av1Source
    let k: usize = demux.demux_seek_sync(&(*vs).dm, (*vs).track, t)
    (*vs).next = k
    reset_decoder(vs)
    return demux.demux_sample_pts_us(&(*vs).dm, (*vs).track, k)
}

fn vav1_ops() -> vidops.VideoOps {
    return vidops.VideoOps { create: h_create, destroy: h_destroy, open: h_open, close: h_close, width: h_width,
        height: h_height, fps_milli: h_fps, rgba_bytes: h_bytes, duration_us: h_duration, next_frame: h_next,
        seek: h_seek }
}
