import media.video.h264.bits as h264_bits
import media.video.h264.cabac as h264_cabac
import media.video.h264.params
import media.video.h264.raw

export {
    read_mvd, read_ref_idx, read_sub_type, store_mvd,
}

fn ref_gt0(d: *mut params.H264, list: i32, b8x: i32, b8y: i32) -> i32 {
    let mb: i32 = (*d).mb_addr
    var nmb: i32 = mb
    var bx: i32 = b8x
    var by: i32 = b8y
    if b8x < 0 || b8y < 0 {
        if b8x < 0 {
            if (*d).mb_x == 0 {
                return 0
            }
            nmb = mb - 1
            bx = 1
        } else {
            if (*d).mb_y == 0 {
                return 0
            }
            nmb = mb - (*d).mb_w
            by = 1
        }
        if raw.ldi32((*d).mbslice, nmb as usize) != (*d).cur_slice {
            return 0
        }
    }
    let b8: i32 = by * 2 + bx
    let f: i32 = raw.ldu8((*d).mbf, nmb as usize)
    if (f & 2) != 0 || ((f >> (4 + b8)) & 1) != 0 {
        return 0
    }
    if raw.ldi8((*d).refidx, (nmb * 8 + list * 4 + b8) as usize) > 0 {
        return 1
    }
    return 0
}

fn read_ref_idx(d: *mut params.H264, list: i32, b8: i32, nref: i32) -> i32 {
    if nref <= 1 {
        return 0
    }
    if (*d).pps[(*d).sh.pps_id as usize].cabac == 0 {
        if nref == 2 {
            return 1 - h264_bits.br_get1(&(*d).br)
        }
        let v: i32 = h264_bits.br_ue(&(*d).br)
        if v >= nref {
            return -1
        }
        return v
    }
    let bx: i32 = b8 & 1
    let by: i32 = b8 >> 1
    var inc: usize = 0
    if ref_gt0(d, list, bx - 1, by) != 0 {
        inc = inc + 1
    }
    if ref_gt0(d, list, bx, by - 1) != 0 {
        inc = inc + 2
    }
    var r: i32 = 0
    var ctx: usize = 54 + inc
    while h264_cabac.cabac_decision(d, ctx) != 0 {
        r = r + 1
        if ctx < 58 {
            ctx = 58
        } else {
            ctx = 59
        }
        if r >= nref {
            return -1
        }
    }
    return r
}

fn mvd_nb(d: *mut params.H264, list: i32, bx: i32, by: i32, comp: i32) -> i32 {
    let mb: i32 = (*d).mb_addr
    var nmb: i32 = mb
    var nbx: i32 = bx
    var nby: i32 = by
    if bx < 0 || by < 0 {
        if bx < 0 {
            if (*d).mb_x == 0 {
                return 0
            }
            nmb = mb - 1
            nbx = 3
        } else {
            if (*d).mb_y == 0 {
                return 0
            }
            nmb = mb - (*d).mb_w
            nby = 3
        }
        if raw.ldi32((*d).mbslice, nmb as usize) != (*d).cur_slice {
            return 0
        }
    }
    return raw.ldu8((*d).mvd, (nmb * 64 + list * 32 + (nby * 4 + nbx) * 2 + comp) as usize)
}

fn read_mvd(d: *mut params.H264, list: i32, bx: i32, by: i32, comp: i32) -> i32 {
    if (*d).pps[(*d).sh.pps_id as usize].cabac == 0 {
        return h264_bits.br_se(&(*d).br)
    }
    let sum: i32 = mvd_nb(d, list, bx - 1, by, comp) + mvd_nb(d, list, bx, by - 1, comp)
    var base: usize = 40
    if comp == 1 {
        base = 47
    }
    var inc0: usize = 0
    if sum > 32 {
        inc0 = 2
    } else {
        if sum >= 3 {
            inc0 = 1
        }
    }
    if h264_cabac.cabac_decision(d, base + inc0) == 0 {
        return 0
    }
    var mvd: i32 = 1
    var ctx: usize = 3
    while mvd < 9 && h264_cabac.cabac_decision(d, base + ctx) != 0 {
        if mvd < 4 {
            ctx = ctx + 1
        }
        mvd = mvd + 1
    }
    if mvd >= 9 {
        mvd = mvd + h264_cabac.cabac_egk(d, 3)
    }
    if h264_cabac.cabac_bypass(d) != 0 {
        return 0 - mvd
    }
    return mvd
}

fn store_mvd(d: *mut params.H264, list: i32, bx: i32, by: i32, bw: i32, bh: i32, mx: i32, my: i32) {
    let mb: i32 = (*d).mb_addr
    var ax: i32 = raw.iabs(mx)
    var ay: i32 = raw.iabs(my)
    if ax > 127 {
        ax = 127
    }
    if ay > 127 {
        ay = 127
    }
    var y: i32 = 0
    while y < bh {
        var x: i32 = 0
        while x < bw {
            let o: usize = (mb * 64 + list * 32 + ((by + y) * 4 + bx + x) * 2) as usize
            raw.stb((*d).mvd, o, ax)
            raw.stb((*d).mvd, o + 1, ay)
            x = x + 1
        }
        y = y + 1
    }
}

fn read_sub_type(d: *mut params.H264, islice_b: i32) -> i32 {
    if (*d).pps[(*d).sh.pps_id as usize].cabac == 0 {
        return h264_bits.br_ue(&(*d).br)
    }
    if islice_b == 0 {
        if h264_cabac.cabac_decision(d, 21) != 0 {
            return 0
        }
        if h264_cabac.cabac_decision(d, 22) == 0 {
            return 1
        }
        if h264_cabac.cabac_decision(d, 23) != 0 {
            return 2
        }
        return 3
    }
    if h264_cabac.cabac_decision(d, 36) == 0 {
        return 0
    }
    if h264_cabac.cabac_decision(d, 37) == 0 {
        return 1 + h264_cabac.cabac_decision(d, 39)
    }
    var t: i32 = 3
    if h264_cabac.cabac_decision(d, 38) != 0 {
        if h264_cabac.cabac_decision(d, 39) != 0 {
            return 11 + h264_cabac.cabac_decision(d, 39)
        }
        t = t + 4
    }
    t = t + 2 * h264_cabac.cabac_decision(d, 39)
    t = t + h264_cabac.cabac_decision(d, 39)
    return t
}
