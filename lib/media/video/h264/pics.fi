import std.rt
import media.video.h264.marking
import media.video.h264.params
import media.video.h264.raw
import media.video.h264.types
import media.video.h264.vlctries

export {
    activate_sps, alloc_pic, h264_free,
}

fn alloc_pic(d: *mut params.H264, i: usize) {
    let p: *mut types.Pic = &(*d).dpb[i]
    if (*p).base_y != 0 {
        return
    }
    let sy: usize = (*d).stride_y as usize
    let sc: usize = (*d).stride_c as usize
    let rows_y: usize = ((*d).mb_h * 16) as usize + 2 * types.PAD
    let rows_c: usize = ((*d).mb_h * 8) as usize + types.PAD
    (*p).base_y = raw.heap_zero(sy * rows_y + 64)
    (*p).base_u = raw.heap_zero(sc * rows_c + 64)
    (*p).base_v = raw.heap_zero(sc * rows_c + 64)
    (*p).y = (*p).base_y + (types.PAD * sy + types.PAD) as u64
    (*p).u = (*p).base_u + ((types.PAD / 2) * sc + types.PAD / 2) as u64
    (*p).v = (*p).base_v + ((types.PAD / 2) * sc + types.PAD / 2) as u64
    let mbs: usize = (*d).mbs as usize
    (*p).mv = raw.heap_zero(mbs * 128 + 64)
    (*p).refid = raw.heap_zero(mbs * 16 + 64)
    (*p).refix = raw.heap_zero(mbs * 8 + 64)
    (*p).intra = raw.heap_zero(mbs + 64)
}

fn free_pic(d: *mut params.H264, i: usize) {
    let p: *mut types.Pic = &(*d).dpb[i]
    if (*p).base_y == 0 {
        return
    }
    let sy: usize = (*d).stride_y as usize
    let sc: usize = (*d).stride_c as usize
    let rows_y: usize = ((*d).mb_h * 16) as usize + 2 * types.PAD
    let rows_c: usize = ((*d).mb_h * 8) as usize + types.PAD
    rt.heap_free((*p).base_y, sy * rows_y + 64)
    rt.heap_free((*p).base_u, sc * rows_c + 64)
    rt.heap_free((*p).base_v, sc * rows_c + 64)
    rt.heap_free((*p).mv, ((*d).mbs as usize) * 128 + 64)
    rt.heap_free((*p).refid, ((*d).mbs as usize) * 16 + 64)
    rt.heap_free((*p).refix, ((*d).mbs as usize) * 8 + 64)
    (*p).refix = 0
    rt.heap_free((*p).intra, ((*d).mbs as usize) + 64)
    (*p).base_y = 0
    (*p).base_u = 0
    (*p).base_v = 0
    (*p).y = 0
    (*p).u = 0
    (*p).v = 0
    (*p).mv = 0
    (*p).refid = 0
    (*p).intra = 0
}

fn release_all(d: *mut params.H264) {
    var i: usize = 0
    while i < 18 {
        free_pic(d, i)
        (*d).dpb[i].ref_mark = 0
        (*d).dpb[i].needs_output = 0
        (*d).dpb[i].pin = 0
        (*d).dpb[i].used = 0
        i = i + 1
    }
    if (*d).mbt != 0 {
        let m: usize = (*d).mbs as usize
        rt.heap_free((*d).mbt, m + 64)
        rt.heap_free((*d).mbf, m + 64)
        rt.heap_free((*d).mbqp, m + 64)
        rt.heap_free((*d).mbcbp, m + 64)
        rt.heap_free((*d).mbslice, m * 4 + 64)
        rt.heap_free((*d).nnz, m * 24 + 64)
        rt.heap_free((*d).cbfdc, m + 64)
        rt.heap_free((*d).ipm, m * 16 + 64)
        rt.heap_free((*d).icpm, m + 64)
        rt.heap_free((*d).mvd, m * 64 + 64)
        rt.heap_free((*d).refidx, m * 8 + 64)
        (*d).mbt = 0
    }
}

fn h264_free(d: *mut params.H264) {
    release_all(d)
    if (*d).rbsp != 0 {
        rt.heap_free((*d).rbsp, (*d).rbsp_cap)
        (*d).rbsp = 0
    }
    if (*d).trie != 0 {
        (*d).trie = 0
    }
    if (*d).slice_tab != 0 {
        rt.heap_free((*d).slice_tab, ((*d).slice_cap as usize) * 32)
        (*d).slice_tab = 0
    }
    if (*d).dq4 != 0 {
        rt.heap_free((*d).dq4, 6 * 52 * 16 * 4)
        rt.heap_free((*d).dq8, 2 * 52 * 64 * 4)
        (*d).dq4 = 0
    }
    if (*d).coef != 0 {
        rt.heap_free((*d).coef, 4096)
        rt.heap_free((*d).pred, 8192)
        (*d).coef = 0
    }
    if (*d).wt_implicit != 0 {
        rt.heap_free((*d).wt_implicit, 32 * 32 * 2)
        (*d).wt_implicit = 0
    }
}

fn level_max_dpb_mbs(level: i32, constraint: i32) -> i32 {
    if level == 9 {
        return 396
    }
    if level == 10 {
        return 396
    }
    if level == 11 {
        if (constraint & 0x10) != 0 {
            return 396
        }
        return 900
    }
    if level == 12 || level == 13 || level == 20 {
        return 2376
    }
    if level == 21 {
        return 4752
    }
    if level == 22 || level == 30 {
        return 8100
    }
    if level == 31 {
        return 18000
    }
    if level == 32 {
        return 20480
    }
    if level == 40 || level == 41 {
        return 32768
    }
    if level == 42 {
        return 34816
    }
    if level == 50 {
        return 110400
    }
    if level == 51 || level == 52 {
        return 184320
    }
    return 696320
}

fn activate_sps(d: *mut params.H264, id: i32) -> i32 {
    let s: *mut types.Sps = &(*d).sps[id as usize]
    if (*s).unsupported != 0 {
        return 1
    }
    var same: i32 = 0
    if (*d).active >= 0 && (*d).mb_w == (*s).mb_w && (*d).mb_h == (*s).mb_h && (*d).mbt != 0 {
        same = 1
    }
    var dpb: i32 = level_max_dpb_mbs((*s).level, (*s).constraint) / ((*s).mb_w * (*s).mb_h)
    if dpb > 16 {
        dpb = 16
    }
    if dpb < 1 {
        dpb = 1
    }
    if (*s).max_ref > dpb {
        dpb = (*s).max_ref
    }
    if (*s).max_dec_buf >= 0 && (*s).max_dec_buf >= (*s).max_ref && (*s).max_dec_buf < dpb {
        dpb = (*s).max_dec_buf
    }
    if dpb < 1 {
        dpb = 1
    }
    if same == 0 {
        marking.flush_output(d)
        (*d).out_drop = (*d).out_drop + (*d).out_n
        (*d).out_n = 0
        release_all(d)
        (*d).mb_w = (*s).mb_w
        (*d).mb_h = (*s).mb_h
        (*d).mbs = (*s).mb_w * (*s).mb_h
        (*d).stride_y = (*s).mb_w * 16 + 2 * (types.PAD as i32)
        (*d).stride_c = (*s).mb_w * 8 + (types.PAD as i32)
        let m: usize = (*d).mbs as usize
        (*d).mbt = raw.heap_zero(m + 64)
        (*d).mbf = raw.heap_zero(m + 64)
        (*d).mbqp = raw.heap_zero(m + 64)
        (*d).mbcbp = raw.heap_zero(m + 64)
        (*d).mbslice = raw.heap_zero(m * 4 + 64)
        (*d).nnz = raw.heap_zero(m * 24 + 64)
        (*d).cbfdc = raw.heap_zero(m + 64)
        (*d).ipm = raw.heap_zero(m * 16 + 64)
        (*d).icpm = raw.heap_zero(m + 64)
        (*d).mvd = raw.heap_zero(m * 64 + 64)
        (*d).refidx = raw.heap_zero(m * 8 + 64)
    }
    (*d).active = id
    (*d).dpb_size = dpb
    (*d).width = (*s).mb_w * 16 - (*s).crop_l - (*s).crop_r
    (*d).height = (*s).mb_h * 16 - (*s).crop_t - (*s).crop_b
    (*d).crop_l = (*s).crop_l
    (*d).crop_t = (*s).crop_t
    (*d).dq_for = -1
    if (*d).coef == 0 {
        (*d).coef = raw.heap_zero(4096)
        (*d).pred = raw.heap_zero(8192)
        (*d).dq4 = raw.heap_zero(6 * 52 * 16 * 4)
        (*d).dq8 = raw.heap_zero(2 * 52 * 64 * 4)
        (*d).wt_implicit = raw.heap_zero(32 * 32 * 2)
        (*d).slice_cap = 256
        (*d).slice_tab = raw.heap_zero(256 * 32)
        vlctries.build_tries(d)
    }
    return 0
}
