import media.video.h264.tables as h264_tables
import media.video.h264.bits as h264_bits
import media.video.h264.raw
import media.video.h264.types

export {
    H264, h264_full_range, h264_height, h264_matrix, h264_new, h264_pic_count, h264_set_nal_length,
    h264_width, parse_pps, parse_sps,
}

fn parse_list(b: *mut types.Br, dst: u64, size: usize, def: u64, fb: u64) -> i32 {
    let present: i32 = h264_bits.br_get1(b)
    var i: usize = 0
    if present == 0 {
        var src: u64 = fb
        if src == 0 {
            src = def
        }
        while i < size {
            raw.stb(dst, i, raw.ldu8(src, i))
            i = i + 1
        }
        return 0
    }
    var last: i32 = 8
    var next: i32 = 8
    var use_def: i32 = 0
    while i < size {
        if next != 0 {
            let delta: i32 = h264_bits.br_se(b)
            next = (last + delta + 256) & 255
            if i == 0 && next == 0 {
                use_def = 1
            }
        }
        var v: i32 = next
        if next == 0 {
            v = last
        }
        raw.stb(dst, i, v)
        last = v
        i = i + 1
    }
    if use_def != 0 {
        i = 0
        while i < size {
            raw.stb(dst, i, raw.ldu8(def, i))
            i = i + 1
        }
    }
    return 1
}

fn parse_matrix(b: *mut types.Br, sl4: u64, sl8: u64, fb4: u64, fb8: u64, n8: i32) {
    let d4: u64 = h264_default4_addr()
    let d8: u64 = h264_default8_addr()
    var i: usize = 0
    while i < 6 {
        var def: u64 = d4
        if i >= 3 {
            def = d4 + 16
        }
        var fb: u64 = 0
        if i == 0 || i == 3 {
            if fb4 != 0 {
                fb = fb4 + (i * 16) as u64
            }
        } else {
            fb = sl4 + ((i - 1) * 16) as u64
        }
        parse_list(b, sl4 + (i * 16) as u64, 16, def, fb)
        i = i + 1
    }
    i = 0
    while i < 2 {
        var fb8l: u64 = 0
        if fb8 != 0 {
            fb8l = fb8 + (i * 64) as u64
        }
        if (i as i32) < n8 {
            parse_list(b, sl8 + (i * 64) as u64, 64, d8 + (i * 64) as u64, fb8l)
        } else {
            var src8: u64 = d8 + (i * 64) as u64
            if fb8l != 0 {
                src8 = fb8l
            }
            var k8: usize = 0
            while k8 < 64 {
                raw.stb(sl8 + (i * 64) as u64, k8, raw.ldu8(src8, k8))
                k8 = k8 + 1
            }
        }
        i = i + 1
    }
}

fn h264_default4_addr() -> u64 {
    return h264_tables.h264_default_scaling4_addr()
}

fn h264_default8_addr() -> u64 {
    return h264_tables.h264_default_scaling8_addr()
}

fn skip_hrd(b: *mut types.Br) {
    let cnt: i32 = h264_bits.br_ue(b) + 1
    h264_bits.br_get(b, 8)
    var i: i32 = 0
    while i < cnt && i < 32 {
        h264_bits.br_ue(b)
        h264_bits.br_ue(b)
        h264_bits.br_get1(b)
        i = i + 1
    }
    h264_bits.br_get(b, 20)
}

fn parse_vui(b: *mut types.Br, s: *mut types.Sps) {
    if h264_bits.br_get1(b) != 0 {
        if h264_bits.br_bits(b, 8) == 255 {
            h264_bits.br_get(b, 16)
            h264_bits.br_get(b, 16)
        }
    }
    if h264_bits.br_get1(b) != 0 {
        h264_bits.br_get1(b)
    }
    if h264_bits.br_get1(b) != 0 {
        h264_bits.br_get(b, 3)
        (*s).full_range = h264_bits.br_get1(b)
        if h264_bits.br_get1(b) != 0 {
            h264_bits.br_get(b, 8)
            h264_bits.br_get(b, 8)
            (*s).matrix_coeffs = h264_bits.br_bits(b, 8)
        }
    }
    if h264_bits.br_get1(b) != 0 {
        h264_bits.br_ue(b)
        h264_bits.br_ue(b)
    }
    if h264_bits.br_get1(b) != 0 {
        h264_bits.br_get(b, 32)
        h264_bits.br_get(b, 32)
        h264_bits.br_get1(b)
    }
    let nal_hrd: i32 = h264_bits.br_get1(b)
    if nal_hrd != 0 {
        skip_hrd(b)
    }
    let vcl_hrd: i32 = h264_bits.br_get1(b)
    if vcl_hrd != 0 {
        skip_hrd(b)
    }
    if nal_hrd != 0 || vcl_hrd != 0 {
        h264_bits.br_get1(b)
    }
    h264_bits.br_get1(b)
    if h264_bits.br_get1(b) != 0 {
        h264_bits.br_get1(b)
        h264_bits.br_ue(b)
        h264_bits.br_ue(b)
        h264_bits.br_ue(b)
        h264_bits.br_ue(b)
        (*s).reorder = h264_bits.br_ue(b)
        (*s).max_dec_buf = h264_bits.br_ue(b)
        if h264_bits.br_left(b) < 0 {
            (*s).reorder = -1
            (*s).max_dec_buf = -1
        }
    }
}

fn parse_sps(d: *mut H264, b: *mut types.Br) -> i32 {
    var s: types.Sps = types.sps_new()
    s.prof_idc = h264_bits.br_bits(b, 8)
    s.constraint = h264_bits.br_bits(b, 8)
    s.level = h264_bits.br_bits(b, 8)
    let id: i32 = h264_bits.br_ue(b)
    if id < 0 || id >= 8 {
        return 2
    }
    var p: i32 = s.prof_idc
    if p == 100 || p == 110 || p == 122 || p == 244 || p == 44 || p == 83 || p == 86 || p == 118 || p == 128 || p == 138 || p == 139 || p == 134 || p == 135 {
        s.chroma_format = h264_bits.br_ue(b)
        if s.chroma_format == 3 {
            h264_bits.br_get1(b)
        }
        let bd_l: i32 = h264_bits.br_ue(b)
        let bd_c: i32 = h264_bits.br_ue(b)
        let bypass: i32 = h264_bits.br_get1(b)
        if s.chroma_format != 1 || bd_l != 0 || bd_c != 0 || bypass != 0 {
            s.unsupported = 1
        }
        s.has_matrix = h264_bits.br_get1(b)
        if s.has_matrix != 0 {
            parse_matrix(b, (&s.sl4[0]) as u64, (&s.sl8[0]) as u64, 0, 0, 2)
        }
    }
    s.log2_max_fn = h264_bits.br_ue(b) + 4
    s.poc_type = h264_bits.br_ue(b)
    if s.poc_type == 0 {
        s.log2_max_poc = h264_bits.br_ue(b) + 4
    }
    if s.poc_type == 1 {
        s.delta_pic_always_zero = h264_bits.br_get1(b)
        s.offset_non_ref = h264_bits.br_se(b)
        s.offset_tb = h264_bits.br_se(b)
        s.n_ref_cycle = h264_bits.br_ue(b)
        if s.n_ref_cycle > 255 {
            return 2
        }
        var i: i32 = 0
        while i < s.n_ref_cycle {
            s.offset_ref[i as usize] = h264_bits.br_se(b)
            i = i + 1
        }
    }
    s.max_ref = h264_bits.br_ue(b)
    s.gaps = h264_bits.br_get1(b)
    s.mb_w = h264_bits.br_ue(b) + 1
    s.mb_h = h264_bits.br_ue(b) + 1
    s.frame_mbs_only = h264_bits.br_get1(b)
    if s.frame_mbs_only == 0 {
        s.mbaff = h264_bits.br_get1(b)
        s.unsupported = 1
    }
    s.direct8x8 = h264_bits.br_get1(b)
    if h264_bits.br_get1(b) != 0 {
        let l: i32 = h264_bits.br_ue(b)
        let r: i32 = h264_bits.br_ue(b)
        let t: i32 = h264_bits.br_ue(b)
        let bt: i32 = h264_bits.br_ue(b)
        s.crop_l = l * 2
        s.crop_r = r * 2
        s.crop_t = t * 2 * (2 - s.frame_mbs_only)
        s.crop_b = bt * 2 * (2 - s.frame_mbs_only)
    }
    if h264_bits.br_get1(b) != 0 {
        parse_vui(b, &s)
    }
    if h264_bits.br_left(b) < 0 {
        return 2
    }
    if s.mb_w <= 0 || s.mb_h <= 0 || s.mb_w > 512 || s.mb_h > 512 {
        return 2
    }
    if s.crop_l + s.crop_r >= s.mb_w * 16 || s.crop_t + s.crop_b >= s.mb_h * 16 {
        return 2
    }
    s.valid = 1
    (*d).sps[id as usize] = s
    return 0
}

fn parse_pps(d: *mut H264, b: *mut types.Br) -> i32 {
    var q: types.Pps = types.pps_new()
    let id: i32 = h264_bits.br_ue(b)
    if id < 0 || id >= 32 {
        return 2
    }
    q.sps_id = h264_bits.br_ue(b)
    if q.sps_id < 0 || q.sps_id >= 8 {
        return 2
    }
    if (*d).sps[q.sps_id as usize].valid == 0 {
        return 3
    }
    q.cabac = h264_bits.br_get1(b)
    q.bottom_poc = h264_bits.br_get1(b)
    q.n_groups = h264_bits.br_ue(b) + 1
    if q.n_groups != 1 {
        return 1
    }
    q.num_ref0 = h264_bits.br_ue(b) + 1
    q.num_ref1 = h264_bits.br_ue(b) + 1
    q.weighted = h264_bits.br_get1(b)
    q.weighted_bi = h264_bits.br_bits(b, 2)
    q.init_qp = 26 + h264_bits.br_se(b)
    q.init_qs = 26 + h264_bits.br_se(b)
    q.cqp0 = h264_bits.br_se(b)
    q.cqp1 = q.cqp0
    q.deblock_ctrl = h264_bits.br_get1(b)
    q.constrained_intra = h264_bits.br_get1(b)
    q.redundant_pic = h264_bits.br_get1(b)
    q.t8x8 = 0
    if h264_bits.br_more_rbsp(b) != 0 {
        q.t8x8 = h264_bits.br_get1(b)
        q.has_matrix = h264_bits.br_get1(b)
        if q.has_matrix != 0 {
            let sp: *mut types.Sps = &(*d).sps[q.sps_id as usize]
            var fb4: u64 = 0
            var fb8: u64 = 0
            if (*sp).has_matrix != 0 {
                fb4 = (&(*sp).sl4[0]) as u64
                fb8 = (&(*sp).sl8[0]) as u64
            }
            parse_matrix(b, (&q.sl4[0]) as u64, (&q.sl8[0]) as u64, fb4, fb8, 2 * q.t8x8)
        }
        q.cqp1 = h264_bits.br_se(b)
    }
    if h264_bits.br_left(b) < 0 {
        return 2
    }
    q.valid = 1
    (*d).pps[id as usize] = q
    return 0
}

struct H264 {
    sps: [types.Sps; 8],
    pps: [types.Pps; 32],
    sh: types.Sh,
    psh: types.Sh,
    nal_len: i32,
    active: i32,
    mb_w: i32,
    mb_h: i32,
    mbs: i32,
    width: i32,
    height: i32,
    crop_l: i32,
    crop_t: i32,
    stride_y: i32,
    stride_c: i32,
    alloc_h: i32,
    dpb_size: i32,
    dpb: [types.Pic; 18],
    cur: i32,
    next_id: i32,
    mbt: u64,
    mbf: u64,
    mbqp: u64,
    mbcbp: u64,
    mbslice: u64,
    nnz: u64,
    cbfdc: u64,
    ipm: u64,
    icpm: u64,
    mvd: u64,
    refidx: u64,
    slice_tab: u64,
    slice_cap: i32,
    nslices: i32,
    qp: i32,
    last_dqp: i32,
    skip_run: i32,
    prev_skip: i32,
    mb_x: i32,
    mb_y: i32,
    mb_addr: i32,
    cur_slice: i32,
    ref_n: [i32; 2],
    ref_pic: [i32; 64],
    ref_poc: [i32; 64],
    ref_long: [i32; 64],
    ref_id: [i32; 64],
    dq4: u64,
    dq8: u64,
    dq_for: i32,
    dq_sps: i32,
    wt_implicit: u64,
    br: types.Br,
    rbsp: u64,
    rbsp_cap: usize,
    cab_range: i32,
    cab_off: i32,
    cab_k: i32,
    cab_state: [u8; 1024],
    trie: u64,
    trie_off: [i32; 40],
    done: [i32; 2],
    pmode: i32,
    sub_shape: [i32; 4],
    sub_direct: [i32; 4],
    dmv: [i32; 64],
    coef: u64,
    pred: u64,
    prev_poc_msb: i32,
    prev_poc_lsb: i32,
    prev_fn_offset: i32,
    prev_frame_num: i32,
    prev_ref_frame_num: i32,
    poc: i32,
    poc_top: i32,
    poc_bottom: i32,
    max_long_idx: i32,
    mmco5: i32,
    out_q: [i32; 20],
    out_n: i32,
    out_drop: i32,
    last_out_poc: i32,
    frames_out: i32,
    pic_count: i32,
    need_idr: i32,
    err_flag: i32,
    err_site: i32,
    in_pts: i64,
    out_pts: i64,
    have_pic: i32,
    hold: i32,
    parse_only: i32,
}

fn h264_new() -> H264 {
    return H264 {
        sps: [types.sps_new(); 8], pps: [types.pps_new(); 32], sh: types.sh_new(), psh: types.sh_new(), nal_len: 0,
        active: -1, mb_w: 0, mb_h: 0, mbs: 0, width: 0, height: 0, crop_l: 0, crop_t: 0,
        stride_y: 0, stride_c: 0, alloc_h: 0, dpb_size: 1, dpb: [types.pic_new(); 18], cur: -1, next_id: 1,
        mbt: 0, mbf: 0, mbqp: 0, mbcbp: 0, mbslice: 0, nnz: 0, cbfdc: 0, ipm: 0, icpm: 0, mvd: 0, refidx: 0,
        slice_tab: 0, slice_cap: 0, nslices: 0,
        qp: 0, last_dqp: 0, skip_run: 0, prev_skip: 0, mb_x: 0, mb_y: 0, mb_addr: 0, cur_slice: 0,
        ref_n: [0; 2], ref_pic: [0; 64], ref_poc: [0; 64], ref_long: [0; 64], ref_id: [0; 64],
        dq4: 0, dq8: 0, dq_for: -1, dq_sps: -1, wt_implicit: 0,
        br: types.Br { buf: 0, pos: 0, end: 0 }, rbsp: 0, rbsp_cap: 0,
        cab_range: 510, cab_off: 0, cab_k: 0, cab_state: [0 as u8; 1024],
        trie: 0, trie_off: [0; 40], done: [0; 2], pmode: 0, sub_shape: [0; 4], sub_direct: [0; 4], dmv: [0; 64], coef: 0, pred: 0,
        prev_poc_msb: 0, prev_poc_lsb: 0, prev_fn_offset: 0, prev_frame_num: 0, prev_ref_frame_num: 0,
        poc: 0, poc_top: 0, poc_bottom: 0, max_long_idx: -1, mmco5: 0,
        out_q: [0; 20], out_n: 0, out_drop: 0, last_out_poc: -2147483647, frames_out: 0, pic_count: 0, need_idr: 1, err_flag: 0, err_site: 0, in_pts: -1, out_pts: -1,
        have_pic: 0, hold: 0, parse_only: 0,
    }
}

fn h264_set_nal_length(d: *mut H264, n: i32) {
    (*d).nal_len = n
}

fn h264_width(d: *mut H264) -> i32 {
    return (*d).width
}

fn h264_height(d: *mut H264) -> i32 {
    return (*d).height
}

fn h264_matrix(d: *mut H264) -> i32 {
    if (*d).active < 0 {
        return 2
    }
    return (*d).sps[(*d).active as usize].matrix_coeffs
}

fn h264_full_range(d: *mut H264) -> i32 {
    if (*d).active < 0 {
        return 0
    }
    return (*d).sps[(*d).active as usize].full_range
}

fn h264_pic_count(d: *mut H264) -> i32 {
    return (*d).pic_count
}
