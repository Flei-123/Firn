import media.video.h264.tables as h264_tables
import media.video.h264.cavlc
import media.video.h264.mbhelp
import media.video.h264.params
import media.video.h264.raw
import media.video.h264.types

export {
    deblock_picture,
}

fn db_alpha(i: i32) -> i32 {
    return h264_tables.h264_alpha((52 + raw.clip3(0, 51, i)) as usize) as i32
}

fn db_beta(i: i32) -> i32 {
    return h264_tables.h264_beta((52 + raw.clip3(0, 51, i)) as usize) as i32
}

fn db_tc0(i: i32, bs: i32) -> i32 {
    return h264_tables.h264_tc0(((52 + raw.clip3(0, 51, i)) * 4 + bs) as usize) as i32
}

fn filter_luma_seg(pix: u64, across: usize, along: usize, bs: i32, alpha: i32, beta: i32, tc0: i32) {
    var k: usize = 0
    while k < 4 {
        let p: u64 = pix + (k * along) as u64
        let p0: i32 = raw.ldu8(p - across as u64, 0)
        let q0: i32 = raw.ldu8(p, 0)
        let p1: i32 = raw.ldu8(p - (across * 2) as u64, 0)
        let q1: i32 = raw.ldu8(p + across as u64, 0)
        if raw.iabs(p0 - q0) < alpha && raw.iabs(p1 - p0) < beta && raw.iabs(q1 - q0) < beta {
            let p2: i32 = raw.ldu8(p - (across * 3) as u64, 0)
            let q2: i32 = raw.ldu8(p + (across * 2) as u64, 0)
            let ap: i32 = raw.iabs(p2 - p0)
            let aq: i32 = raw.iabs(q2 - q0)
            if bs < 4 {
                var tc: i32 = tc0
                if ap < beta {
                    tc = tc + 1
                }
                if aq < beta {
                    tc = tc + 1
                }
                let delta: i32 = raw.clip3(0 - tc, tc, (((q0 - p0) << 2) + (p1 - q1) + 4) >> 3)
                raw.stb(p - across as u64, 0, raw.clip255(p0 + delta))
                raw.stb(p, 0, raw.clip255(q0 - delta))
                if ap < beta {
                    raw.stb(p - (across * 2) as u64, 0, p1 + raw.clip3(0 - tc0, tc0, (p2 + ((p0 + q0 + 1) >> 1) - (p1 << 1)) >> 1))
                }
                if aq < beta {
                    raw.stb(p + across as u64, 0, q1 + raw.clip3(0 - tc0, tc0, (q2 + ((p0 + q0 + 1) >> 1) - (q1 << 1)) >> 1))
                }
            } else {
                var small: i32 = 0
                if raw.iabs(p0 - q0) < ((alpha >> 2) + 2) {
                    small = 1
                }
                if ap < beta && small != 0 {
                    let p3: i32 = raw.ldu8(p - (across * 4) as u64, 0)
                    raw.stb(p - across as u64, 0, (p2 + 2 * p1 + 2 * p0 + 2 * q0 + q1 + 4) >> 3)
                    raw.stb(p - (across * 2) as u64, 0, (p2 + p1 + p0 + q0 + 2) >> 2)
                    raw.stb(p - (across * 3) as u64, 0, (2 * p3 + 3 * p2 + p1 + p0 + q0 + 4) >> 3)
                } else {
                    raw.stb(p - across as u64, 0, (2 * p1 + p0 + q1 + 2) >> 2)
                }
                if aq < beta && small != 0 {
                    let q3: i32 = raw.ldu8(p + (across * 3) as u64, 0)
                    raw.stb(p, 0, (p1 + 2 * p0 + 2 * q0 + 2 * q1 + q2 + 4) >> 3)
                    raw.stb(p + across as u64, 0, (p0 + q0 + q1 + q2 + 2) >> 2)
                    raw.stb(p + (across * 2) as u64, 0, (2 * q3 + 3 * q2 + q1 + q0 + p0 + 4) >> 3)
                } else {
                    raw.stb(p, 0, (2 * q1 + q0 + p1 + 2) >> 2)
                }
            }
        }
        k = k + 1
    }
}

fn filter_chroma_seg(pix: u64, across: usize, along: usize, bs: i32, alpha: i32, beta: i32, tc0: i32) {
    var k: usize = 0
    while k < 2 {
        let p: u64 = pix + (k * along) as u64
        let p0: i32 = raw.ldu8(p - across as u64, 0)
        let q0: i32 = raw.ldu8(p, 0)
        let p1: i32 = raw.ldu8(p - (across * 2) as u64, 0)
        let q1: i32 = raw.ldu8(p + across as u64, 0)
        if raw.iabs(p0 - q0) < alpha && raw.iabs(p1 - p0) < beta && raw.iabs(q1 - q0) < beta {
            if bs < 4 {
                let tc: i32 = tc0 + 1
                let delta: i32 = raw.clip3(0 - tc, tc, (((q0 - p0) << 2) + (p1 - q1) + 4) >> 3)
                raw.stb(p - across as u64, 0, raw.clip255(p0 + delta))
                raw.stb(p, 0, raw.clip255(q0 - delta))
            } else {
                raw.stb(p - across as u64, 0, (2 * p1 + p0 + q1 + 2) >> 2)
                raw.stb(p, 0, (2 * q1 + q0 + p1 + 2) >> 2)
            }
        }
        k = k + 1
    }
}

fn mb_has_coef(d: *mut params.H264, mb: i32, bx: i32, by: i32) -> i32 {
    if (raw.ldu8((*d).mbf, mb as usize) & 4) != 0 {
        let x0: i32 = bx & 2
        let y0: i32 = by & 2
        let o: usize = (mb * 24) as usize
        if raw.ldu8((*d).nnz, o + ((y0 * 4 + x0) as usize)) != 0 || raw.ldu8((*d).nnz, o + ((y0 * 4 + x0 + 1) as usize)) != 0
            || raw.ldu8((*d).nnz, o + (((y0 + 1) * 4 + x0) as usize)) != 0 || raw.ldu8((*d).nnz, o + (((y0 + 1) * 4 + x0 + 1) as usize)) != 0 {
            return 1
        }
        return 0
    }
    if raw.ldu8((*d).nnz, (mb * 24 + by * 4 + bx) as usize) != 0 {
        return 1
    }
    return 0
}

fn mb_coef_mask(d: *mut params.H264, mb: i32) -> i32 {
    let o: u64 = (*d).nnz + (mb * 24) as u64
    var m: i32 = 0
    if (raw.ldu8((*d).mbf, mb as usize) & 4) != 0 {
        var q: i32 = 0
        while q < 4 {
            let b0: usize = (((q >> 1) * 2) * 4 + (q & 1) * 2) as usize
            if raw.ldu8(o, b0) != 0 || raw.ldu8(o, b0 + 1) != 0 || raw.ldu8(o, b0 + 4) != 0 || raw.ldu8(o, b0 + 5) != 0 {
                m = m | (0x33 << (((q >> 1) * 8 + (q & 1) * 2) as u32))
            }
            q = q + 1
        }
        return m
    }
    var i: usize = 0
    while i < 16 {
        if raw.ldu8(o, i) != 0 {
            m = m | (1 << (i as u32))
        }
        i = i + 1
    }
    return m
}

fn mv_far(a: i32, b: i32, c: i32, e: i32) -> i32 {
    if raw.iabs(a - b) >= 4 || raw.iabs(c - e) >= 4 {
        return 1
    }
    return 0
}

fn bs_inter(d: *mut params.H264, pm: i32, pb: i32, qm: i32, qb: i32) -> i32 {
    let cur: *mut types.Pic = &(*d).dpb[(*d).cur as usize]
    let mbs: i32 = (*d).mbs
    let p8: i32 = ((pb >> 3) << 1) | ((pb & 3) >> 1)
    let q8: i32 = ((qb >> 3) << 1) | ((qb & 3) >> 1)
    let rp0: i32 = raw.ldi16((*cur).refid, (pm * 4 + p8) as usize)
    let rp1: i32 = raw.ldi16((*cur).refid, ((mbs + pm) * 4 + p8) as usize)
    let rq0: i32 = raw.ldi16((*cur).refid, (qm * 4 + q8) as usize)
    let rq1: i32 = raw.ldi16((*cur).refid, ((mbs + qm) * 4 + q8) as usize)
    var np: i32 = 0
    var nq: i32 = 0
    if rp0 >= 0 {
        np = np + 1
    }
    if rp1 >= 0 {
        np = np + 1
    }
    if rq0 >= 0 {
        nq = nq + 1
    }
    if rq1 >= 0 {
        nq = nq + 1
    }
    if np != nq {
        return 1
    }
    let mvp0: usize = ((pm * 16 + pb) * 2) as usize
    let mvp1: usize = (((mbs + pm) * 16 + pb) * 2) as usize
    let mvq0: usize = ((qm * 16 + qb) * 2) as usize
    let mvq1: usize = (((mbs + qm) * 16 + qb) * 2) as usize
    let mv: u64 = (*cur).mv
    if np == 1 {
        var rp: i32 = rp0
        var op: usize = mvp0
        if rp0 < 0 {
            rp = rp1
            op = mvp1
        }
        var rq: i32 = rq0
        var oq: usize = mvq0
        if rq0 < 0 {
            rq = rq1
            oq = mvq1
        }
        if rp != rq {
            return 1
        }
        return mv_far(raw.ldi16(mv, op), raw.ldi16(mv, oq), raw.ldi16(mv, op + 1), raw.ldi16(mv, oq + 1))
    }
    if np == 0 {
        return 0
    }
    if !((rp0 == rq0 && rp1 == rq1) || (rp0 == rq1 && rp1 == rq0)) {
        return 1
    }
    if rp0 != rp1 {
        if rp0 == rq0 {
            if mv_far(raw.ldi16(mv, mvp0), raw.ldi16(mv, mvq0), raw.ldi16(mv, mvp0 + 1), raw.ldi16(mv, mvq0 + 1)) != 0
                || mv_far(raw.ldi16(mv, mvp1), raw.ldi16(mv, mvq1), raw.ldi16(mv, mvp1 + 1), raw.ldi16(mv, mvq1 + 1)) != 0 {
                return 1
            }
            return 0
        }
        if mv_far(raw.ldi16(mv, mvp0), raw.ldi16(mv, mvq1), raw.ldi16(mv, mvp0 + 1), raw.ldi16(mv, mvq1 + 1)) != 0
            || mv_far(raw.ldi16(mv, mvp1), raw.ldi16(mv, mvq0), raw.ldi16(mv, mvp1 + 1), raw.ldi16(mv, mvq0 + 1)) != 0 {
            return 1
        }
        return 0
    }
    var straight: i32 = 0
    if mv_far(raw.ldi16(mv, mvp0), raw.ldi16(mv, mvq0), raw.ldi16(mv, mvp0 + 1), raw.ldi16(mv, mvq0 + 1)) != 0
        || mv_far(raw.ldi16(mv, mvp1), raw.ldi16(mv, mvq1), raw.ldi16(mv, mvp1 + 1), raw.ldi16(mv, mvq1 + 1)) != 0 {
        straight = 1
    }
    var crossed: i32 = 0
    if mv_far(raw.ldi16(mv, mvp0), raw.ldi16(mv, mvq1), raw.ldi16(mv, mvp0 + 1), raw.ldi16(mv, mvq1 + 1)) != 0
        || mv_far(raw.ldi16(mv, mvp1), raw.ldi16(mv, mvq0), raw.ldi16(mv, mvp1 + 1), raw.ldi16(mv, mvq0 + 1)) != 0 {
        crossed = 1
    }
    if straight != 0 && crossed != 0 {
        return 1
    }
    return 0
}

fn edge_bs(d: *mut params.H264, mb: i32, pm: i32, vertical: i32, edge: i32, seg: i32, qm: i32, pmk: i32, intra: i32) -> i32 {
    var qbx: i32 = 0
    var qby: i32 = 0
    var pbx: i32 = 0
    var pby: i32 = 0
    if vertical != 0 {
        qbx = edge
        qby = seg
        if edge == 0 {
            pbx = 3
        } else {
            pbx = edge - 1
        }
        pby = seg
    } else {
        qbx = seg
        qby = edge
        pbx = seg
        if edge == 0 {
            pby = 3
        } else {
            pby = edge - 1
        }
    }
    if intra != 0 {
        if edge == 0 {
            return 4
        }
        return 3
    }
    var pcoef: i32 = pmk
    if edge != 0 {
        pcoef = qm
    }
    if ((qm >> ((qby * 4 + qbx) as u32)) & 1) != 0 || ((pcoef >> ((pby * 4 + pbx) as u32)) & 1) != 0 {
        return 2
    }
    return bs_inter(d, pm, pby * 4 + pbx, mb, qby * 4 + qbx)
}

fn deblock_picture(d: *mut params.H264) {
    var any: i32 = 0
    var s: i32 = 0
    while s < (*d).nslices {
        if raw.ldi32((*d).slice_tab, (s as usize) * 8) != 1 {
            any = 1
        }
        s = s + 1
    }
    if any == 0 {
        return
    }
    deblock_rows(d, 0, (*d).mb_h)
}

fn deblock_rows(d: *mut params.H264, row0: i32, row1: i32) {
    let mbw: i32 = (*d).mb_w
    let sy: usize = (*d).stride_y as usize
    let sc: usize = (*d).stride_c as usize
    let cur: *mut types.Pic = &(*d).dpb[(*d).cur as usize]
    var mb: i32 = row0 * mbw
    let mb_end: i32 = row1 * mbw
    while mb < mb_end {
        let mx: i32 = mb % mbw
        let my: i32 = mb / mbw
        let sl: i32 = raw.ldi32((*d).mbslice, mb as usize)
        let so: usize = (sl as usize) * 8
        let idc: i32 = raw.ldi32((*d).slice_tab, so)
        if idc != 1 {
            let aoff: i32 = raw.ldi32((*d).slice_tab, so + 1)
            let boff: i32 = raw.ldi32((*d).slice_tab, so + 2)
            let qpq: i32 = raw.ldi8((*d).mbqp, mb as usize)
            let ly: u64 = (*cur).y + ((my * 16) as usize * sy + (mx * 16) as usize) as u64
            let lu: u64 = (*cur).u + ((my * 8) as usize * sc + (mx * 8) as usize) as u64
            let lv: u64 = (*cur).v + ((my * 8) as usize * sc + (mx * 8) as usize) as u64
            let t8: i32 = raw.ldu8((*d).mbf, mb as usize) & 4
            let qmask: i32 = mb_coef_mask(d, mb)
            let qintra: i32 = mbhelp.mb_is_intra(raw.ldu8((*d).mbt, mb as usize))
            let uniform: i32 = raw.ldu8((*d).mbf, mb as usize) & 8
            var dir: i32 = 0
            while dir < 2 {
                var e: i32 = 0
                while e < 4 {
                    var do_edge: i32 = 1
                    var pm: i32 = mb
                    if e == 0 {
                        if dir == 0 {
                            if mx == 0 {
                                do_edge = 0
                            } else {
                                pm = mb - 1
                            }
                        } else {
                            if my == 0 {
                                do_edge = 0
                            } else {
                                pm = mb - mbw
                            }
                        }
                        if do_edge != 0 && idc == 2 && raw.ldi32((*d).mbslice, pm as usize) != sl {
                            do_edge = 0
                        }
                    }
                    if do_edge != 0 && t8 != 0 && (e & 1) == 1 {
                        do_edge = 2
                    }
                    if do_edge != 0 && e > 0 && uniform != 0 && qmask == 0 && qintra == 0 {
                        do_edge = 0
                    }
                    if do_edge != 0 {
                        var pmask: i32 = qmask
                        var pintra: i32 = qintra
                        if e == 0 {
                            pmask = mb_coef_mask(d, pm)
                            pintra = mbhelp.mb_is_intra(raw.ldu8((*d).mbt, pm as usize))
                        }
                        var bsv: [i32; 4] = [0; 4]
                        var seg: i32 = 0
                        var nz: i32 = 0
                        var anyintra: i32 = qintra
                        if pintra != 0 {
                            anyintra = 1
                        }
                        while seg < 4 {
                            bsv[seg as usize] = edge_bs(d, mb, pm, 1 - dir, e, seg, qmask, pmask, anyintra)
                            if bsv[seg as usize] != 0 {
                                nz = 1
                            }
                            seg = seg + 1
                        }
                        if nz != 0 {
                            let qpp: i32 = raw.ldi8((*d).mbqp, pm as usize)
                            let qpav: i32 = (qpp + qpq + 1) >> 1
                            let alpha: i32 = db_alpha(qpav + aoff)
                            let beta: i32 = db_beta(qpav + boff)
                            if alpha != 0 && beta != 0 {
                                let ia: i32 = qpav + aoff
                                if do_edge == 1 {
                                    seg = 0
                                    while seg < 4 {
                                        let bs: i32 = bsv[seg as usize]
                                        if bs != 0 {
                                            var tc0: i32 = 0
                                            if bs < 4 {
                                                tc0 = db_tc0(ia, bs)
                                            }
                                            if dir == 0 {
                                                filter_luma_seg(ly + ((seg * 4) as usize * sy + (e * 4) as usize) as u64, 1, sy, bs, alpha, beta, tc0)
                                            } else {
                                                filter_luma_seg(ly + ((e * 4) as usize * sy + (seg * 4) as usize) as u64, sy, 1, bs, alpha, beta, tc0)
                                            }
                                        }
                                        seg = seg + 1
                                    }
                                }
                                if e == 0 || e == 2 {
                                    var comp: i32 = 0
                                    while comp < 2 {
                                        var cpix: u64 = lu
                                        if comp == 1 {
                                            cpix = lv
                                        }
                                        var cq0: i32 = raw.ldi32((*d).slice_tab, so + 3)
                                        if comp == 1 {
                                            cq0 = raw.ldi32((*d).slice_tab, so + 4)
                                        }
                                        let sp: usize = (raw.ldi32((*d).mbslice, pm as usize) as usize) * 8
                                        var cp0: i32 = raw.ldi32((*d).slice_tab, sp + 3)
                                        if comp == 1 {
                                            cp0 = raw.ldi32((*d).slice_tab, sp + 4)
                                        }
                                        let qcp: i32 = cavlc.chroma_qp(qpp, cp0)
                                        let qcq: i32 = cavlc.chroma_qp(qpq, cq0)
                                        let qcav: i32 = (qcp + qcq + 1) >> 1
                                        let calpha: i32 = db_alpha(qcav + aoff)
                                        let cbeta: i32 = db_beta(qcav + boff)
                                        if calpha != 0 && cbeta != 0 {
                                            let cia: i32 = qcav + aoff
                                            seg = 0
                                            while seg < 4 {
                                                let bs2: i32 = bsv[seg as usize]
                                                if bs2 != 0 {
                                                    var ctc0: i32 = 0
                                                    if bs2 < 4 {
                                                        ctc0 = db_tc0(cia, bs2)
                                                    }
                                                    let ce: i32 = e >> 1
                                                    if dir == 0 {
                                                        filter_chroma_seg(cpix + ((seg * 2) as usize * sc + (ce * 4) as usize) as u64, 1, sc, bs2, calpha, cbeta, ctc0)
                                                    } else {
                                                        filter_chroma_seg(cpix + ((ce * 4) as usize * sc + (seg * 2) as usize) as u64, sc, 1, bs2, calpha, cbeta, ctc0)
                                                    }
                                                }
                                                seg = seg + 1
                                            }
                                        }
                                        comp = comp + 1
                                    }
                                }
                            }
                        }
                    }
                    e = e + 1
                }
                dir = dir + 1
            }
        }
        mb = mb + 1
    }
}
