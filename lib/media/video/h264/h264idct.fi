// SPDX-License-Identifier: MPL-2.0
import media.video.h264.raw

export {
    chroma_dc_dequant, idct4_add, idct4_dc_add, idct8_add, luma_dc_dequant,
}

fn idct4_add(dst: u64, stride: usize, c: u64) {
    var t: [i32; 16] = [0; 16]
    var i: usize = 0
    while i < 4 {
        let d0: i32 = raw.ldi32(c, i * 4)
        let d1: i32 = raw.ldi32(c, i * 4 + 1)
        let d2: i32 = raw.ldi32(c, i * 4 + 2)
        let d3: i32 = raw.ldi32(c, i * 4 + 3)
        let e0: i32 = d0 + d2
        let e1: i32 = d0 - d2
        let e2: i32 = (d1 >> 1) - d3
        let e3: i32 = d1 + (d3 >> 1)
        t[i * 4] = e0 + e3
        t[i * 4 + 1] = e1 + e2
        t[i * 4 + 2] = e1 - e2
        t[i * 4 + 3] = e0 - e3
        i = i + 1
    }
    i = 0
    while i < 4 {
        let f0: i32 = t[i]
        let f1: i32 = t[4 + i]
        let f2: i32 = t[8 + i]
        let f3: i32 = t[12 + i]
        let g0: i32 = f0 + f2
        let g1: i32 = f0 - f2
        let g2: i32 = (f1 >> 1) - f3
        let g3: i32 = f1 + (f3 >> 1)
        let r0: i32 = (g0 + g3 + 32) >> 6
        let r1: i32 = (g1 + g2 + 32) >> 6
        let r2: i32 = (g1 - g2 + 32) >> 6
        let r3: i32 = (g0 - g3 + 32) >> 6
        let p0: u64 = dst + i as u64
        raw.stb(p0, 0, raw.clip255(raw.ldu8(p0, 0) + r0))
        raw.stb(p0, stride, raw.clip255(raw.ldu8(p0, stride) + r1))
        raw.stb(p0, stride * 2, raw.clip255(raw.ldu8(p0, stride * 2) + r2))
        raw.stb(p0, stride * 3, raw.clip255(raw.ldu8(p0, stride * 3) + r3))
        i = i + 1
    }
}

fn idct4_dc_add(dst: u64, stride: usize, dc: i32) {
    let v: i32 = (dc + 32) >> 6
    var y: usize = 0
    while y < 4 {
        let p: u64 = dst + (y * stride) as u64
        raw.stb(p, 0, raw.clip255(raw.ldu8(p, 0) + v))
        raw.stb(p, 1, raw.clip255(raw.ldu8(p, 1) + v))
        raw.stb(p, 2, raw.clip255(raw.ldu8(p, 2) + v))
        raw.stb(p, 3, raw.clip255(raw.ldu8(p, 3) + v))
        y = y + 1
    }
}

fn idct8_add(dst: u64, stride: usize, c: u64) {
    var t: [i32; 64] = [0; 64]
    var i: usize = 0
    while i < 8 {
        let a0: i32 = raw.ldi32(c, i * 8)
        let a1: i32 = raw.ldi32(c, i * 8 + 1)
        let a2: i32 = raw.ldi32(c, i * 8 + 2)
        let a3: i32 = raw.ldi32(c, i * 8 + 3)
        let a4: i32 = raw.ldi32(c, i * 8 + 4)
        let a5: i32 = raw.ldi32(c, i * 8 + 5)
        let a6: i32 = raw.ldi32(c, i * 8 + 6)
        let a7: i32 = raw.ldi32(c, i * 8 + 7)
        let e0: i32 = a0 + a4
        let e1: i32 = 0 - a3 + a5 - a7 - (a7 >> 1)
        let e2: i32 = a0 - a4
        let e3: i32 = a1 + a7 - a3 - (a3 >> 1)
        let e4: i32 = (a2 >> 1) - a6
        let e5: i32 = 0 - a1 + a7 + a5 + (a5 >> 1)
        let e6: i32 = a2 + (a6 >> 1)
        let e7: i32 = a3 + a5 + a1 + (a1 >> 1)
        let f0: i32 = e0 + e6
        let f1: i32 = e1 + (e7 >> 2)
        let f2: i32 = e2 + e4
        let f3: i32 = e3 + (e5 >> 2)
        let f4: i32 = e2 - e4
        let f5: i32 = (e3 >> 2) - e5
        let f6: i32 = e0 - e6
        let f7: i32 = e7 - (e1 >> 2)
        t[i * 8] = f0 + f7
        t[i * 8 + 1] = f2 + f5
        t[i * 8 + 2] = f4 + f3
        t[i * 8 + 3] = f6 + f1
        t[i * 8 + 4] = f6 - f1
        t[i * 8 + 5] = f4 - f3
        t[i * 8 + 6] = f2 - f5
        t[i * 8 + 7] = f0 - f7
        i = i + 1
    }
    i = 0
    while i < 8 {
        let a0: i32 = t[i]
        let a1: i32 = t[8 + i]
        let a2: i32 = t[16 + i]
        let a3: i32 = t[24 + i]
        let a4: i32 = t[32 + i]
        let a5: i32 = t[40 + i]
        let a6: i32 = t[48 + i]
        let a7: i32 = t[56 + i]
        let e0: i32 = a0 + a4
        let e1: i32 = 0 - a3 + a5 - a7 - (a7 >> 1)
        let e2: i32 = a0 - a4
        let e3: i32 = a1 + a7 - a3 - (a3 >> 1)
        let e4: i32 = (a2 >> 1) - a6
        let e5: i32 = 0 - a1 + a7 + a5 + (a5 >> 1)
        let e6: i32 = a2 + (a6 >> 1)
        let e7: i32 = a3 + a5 + a1 + (a1 >> 1)
        let f0: i32 = e0 + e6
        let f1: i32 = e1 + (e7 >> 2)
        let f2: i32 = e2 + e4
        let f3: i32 = e3 + (e5 >> 2)
        let f4: i32 = e2 - e4
        let f5: i32 = (e3 >> 2) - e5
        let f6: i32 = e0 - e6
        let f7: i32 = e7 - (e1 >> 2)
        let p0: u64 = dst + i as u64
        raw.stb(p0, 0, raw.clip255(raw.ldu8(p0, 0) + ((f0 + f7 + 32) >> 6)))
        raw.stb(p0, stride, raw.clip255(raw.ldu8(p0, stride) + ((f2 + f5 + 32) >> 6)))
        raw.stb(p0, stride * 2, raw.clip255(raw.ldu8(p0, stride * 2) + ((f4 + f3 + 32) >> 6)))
        raw.stb(p0, stride * 3, raw.clip255(raw.ldu8(p0, stride * 3) + ((f6 + f1 + 32) >> 6)))
        raw.stb(p0, stride * 4, raw.clip255(raw.ldu8(p0, stride * 4) + ((f6 - f1 + 32) >> 6)))
        raw.stb(p0, stride * 5, raw.clip255(raw.ldu8(p0, stride * 5) + ((f4 - f3 + 32) >> 6)))
        raw.stb(p0, stride * 6, raw.clip255(raw.ldu8(p0, stride * 6) + ((f2 - f5 + 32) >> 6)))
        raw.stb(p0, stride * 7, raw.clip255(raw.ldu8(p0, stride * 7) + ((f0 - f7 + 32) >> 6)))
        i = i + 1
    }
}

fn luma_dc_dequant(coef: u64, lv: u64, qp: i32, dqtab: u64) {
    var t: [i32; 16] = [0; 16]
    var i: usize = 0
    while i < 4 {
        let a: i32 = raw.ldi32(lv, i * 4)
        let b: i32 = raw.ldi32(lv, i * 4 + 1)
        let c: i32 = raw.ldi32(lv, i * 4 + 2)
        let d: i32 = raw.ldi32(lv, i * 4 + 3)
        t[i * 4] = a + b + c + d
        t[i * 4 + 1] = a + b - c - d
        t[i * 4 + 2] = a - b - c + d
        t[i * 4 + 3] = a - b + c - d
        i = i + 1
    }
    let ls: i32 = raw.ldi32(dqtab, (qp as usize) * 16)
    i = 0
    while i < 4 {
        let a: i32 = t[i]
        let b: i32 = t[4 + i]
        let c: i32 = t[8 + i]
        let d: i32 = t[12 + i]
        let f0: i32 = a + b + c + d
        let f1: i32 = a + b - c - d
        let f2: i32 = a - b - c + d
        let f3: i32 = a - b + c - d
        raw.sti32(coef, (0 * 4 + i) * 16, (f0 * ls + 32) >> 6)
        raw.sti32(coef, (1 * 4 + i) * 16, (f1 * ls + 32) >> 6)
        raw.sti32(coef, (2 * 4 + i) * 16, (f2 * ls + 32) >> 6)
        raw.sti32(coef, (3 * 4 + i) * 16, (f3 * ls + 32) >> 6)
        i = i + 1
    }
}

fn chroma_dc_dequant(coef: u64, base: usize, lv: u64, qp: i32, dqtab: u64) {
    let a: i32 = raw.ldi32(lv, 0)
    let b: i32 = raw.ldi32(lv, 1)
    let c: i32 = raw.ldi32(lv, 2)
    let d: i32 = raw.ldi32(lv, 3)
    let ls: i32 = raw.ldi32(dqtab, (qp as usize) * 16)
    raw.sti32(coef, base + 0 * 16, (((a + b + c + d) * ls) >> 5))
    raw.sti32(coef, base + 1 * 16, (((a - b + c - d) * ls) >> 5))
    raw.sti32(coef, base + 2 * 16, (((a + b - c - d) * ls) >> 5))
    raw.sti32(coef, base + 3 * 16, (((a - b - c + d) * ls) >> 5))
}
