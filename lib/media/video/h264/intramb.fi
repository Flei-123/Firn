import std.rt
import media.video.h264.tables as h264_tables
import media.video.h264.bits as h264_bits
import media.video.h264.cabac as h264_cabac
import media.video.h264.cabacres
import media.video.h264.cabacsyn
import media.video.h264.cavlc
import media.video.h264.intra as h264_intra
import media.video.h264.mbhelp
import media.video.h264.params
import media.video.h264.raw
import media.video.h264.rescavlc
import media.video.h264.transform
import media.video.h264.types

export {
    apply_qp_delta, decode_intra_mb, start_mb,
}

fn start_mb(d: *mut params.H264, mb: i32) {
    raw.sti32((*d).mbslice, mb as usize, (*d).cur_slice)
    rt.mem_set((*d).nnz + (mb * 24) as u64, 0 as u8, 24)
    rt.mem_set((*d).ipm + (mb * 16) as u64, 2 as u8, 16)
    raw.stb((*d).cbfdc, mb as usize, 0)
    raw.stb((*d).mbf, mb as usize, 0)
    raw.stb((*d).mbcbp, mb as usize, 0)
    raw.stb((*d).icpm, mb as usize, 0)
    rt.mem_set((*d).mvd + (mb * 64) as u64, 0 as u8, 64)
    rt.mem_set((*d).refidx + (mb * 8) as u64, 255 as u8, 8)
}

fn apply_qp_delta(d: *mut params.H264, delta: i32) -> i32 {
    if delta < -26 || delta > 25 {
        return -1
    }
    (*d).qp = ((*d).qp + delta + 52) % 52
    return 0
}

fn pred_intra_mode(d: *mut params.H264, mb: i32, bx: i32, by: i32, av_a: i32, av_b: i32) -> i32 {
    var ma: i32 = 2
    var mb_: i32 = 2
    var unavailable: i32 = 0
    let constrained: i32 = (*d).pps[(*d).sh.pps_id as usize].constrained_intra
    if bx > 0 {
        ma = raw.ldi8((*d).ipm, (mb * 16 + by * 4 + bx - 1) as usize)
    } else {
        if av_a == 0 {
            unavailable = 1
        } else {
            let a: i32 = mb - 1
            let t: i32 = raw.ldu8((*d).mbt, a as usize)
            if mbhelp.mb_is_intra(t) == 0 && constrained != 0 {
                unavailable = 1
            } else {
                ma = raw.ldi8((*d).ipm, (a * 16 + by * 4 + 3) as usize)
            }
        }
    }
    if by > 0 {
        mb_ = raw.ldi8((*d).ipm, (mb * 16 + (by - 1) * 4 + bx) as usize)
    } else {
        if av_b == 0 {
            unavailable = 1
        } else {
            let b: i32 = mb - (*d).mb_w
            let t2: i32 = raw.ldu8((*d).mbt, b as usize)
            if mbhelp.mb_is_intra(t2) == 0 && constrained != 0 {
                unavailable = 1
            } else {
                mb_ = raw.ldi8((*d).ipm, (b * 16 + 12 + bx) as usize)
            }
        }
    }
    if unavailable != 0 {
        return 2
    }
    return raw.imin(ma, mb_)
}

fn decode_intra_mb(d: *mut params.H264, mb: i32, itype: i32, av_a: i32, av_b: i32, av_c: i32, av_d: i32) -> i32 {
    let pps: *mut types.Pps = &(*d).pps[(*d).sh.pps_id as usize]
    let cur: *mut types.Pic = &(*d).dpb[(*d).cur as usize]
    raw.stb((*cur).intra, mb as usize, 1)
    let cabac: i32 = (*pps).cabac
    if itype == 25 {
        if cabac != 0 {
            (*d).br.pos = (*d).br.pos + 1
        }
        (*d).br.pos = ((*d).br.pos + 7) & (0 - 8)
        if h264_bits.br_left(&(*d).br) < 3072 {
            return 2
        }
        let sy: usize = (*d).stride_y as usize
        let base: u64 = mbhelp.mb_luma_ptr(d)
        var y: usize = 0
        while y < 16 {
            var x: usize = 0
            while x < 16 {
                raw.stb(base, y * sy + x, h264_bits.br_bits(&(*d).br, 8))
                x = x + 1
            }
            y = y + 1
        }
        let sc: usize = (*d).stride_c as usize
        var comp: i32 = 0
        while comp < 2 {
            var cb: u64 = mbhelp.mb_cb_ptr(d)
            if comp == 1 {
                cb = mbhelp.mb_cr_ptr(d)
            }
            y = 0
            while y < 8 {
                var x2: usize = 0
                while x2 < 8 {
                    raw.stb(cb, y * sc + x2, h264_bits.br_bits(&(*d).br, 8))
                    x2 = x2 + 1
                }
                y = y + 1
            }
            comp = comp + 1
        }
        raw.stb((*d).mbt, mb as usize, types.MB_PCM)
        raw.stb((*d).mbqp, mb as usize, 0)
        raw.stb((*d).mbcbp, mb as usize, 0x2F)
        rt.mem_set((*d).nnz + (mb * 24) as u64, 16 as u8, 24)
        raw.stb((*d).cbfdc, mb as usize, 7)
        (*d).last_dqp = 0
        if cabac != 0 {
            h264_cabac.cabac_start(d)
        }
        return 0
    }
    var t8: i32 = 0
    var kind: i32 = 0
    var i16mode: i32 = 0
    var cbp: i32 = 0
    if itype == 0 {
        if (*pps).t8x8 != 0 {
            if cabac != 0 {
                var tinc: usize = 0
                if av_a != 0 && (raw.ldu8((*d).mbf, (mb - 1) as usize) & 4) != 0 {
                    tinc = tinc + 1
                }
                if av_b != 0 && (raw.ldu8((*d).mbf, (mb - (*d).mb_w) as usize) & 4) != 0 {
                    tinc = tinc + 1
                }
                t8 = h264_cabac.cabac_decision(d, 399 + tinc)
            } else {
                t8 = h264_bits.br_get1(&(*d).br)
            }
        }
        if t8 == 0 {
            raw.stb((*d).mbt, mb as usize, types.MB_I4)
            var blk: i32 = 0
            while blk < 16 {
                let bx: i32 = cavlc.blk_x(blk)
                let by: i32 = cavlc.blk_y(blk)
                let pm: i32 = pred_intra_mode(d, mb, bx, by, av_a, av_b)
                var mode: i32 = pm
                var prevf: i32 = 0
                if cabac != 0 {
                    prevf = h264_cabac.cabac_decision(d, 68)
                } else {
                    prevf = h264_bits.br_get1(&(*d).br)
                }
                if prevf == 0 {
                    var rem: i32 = 0
                    if cabac != 0 {
                        rem = h264_cabac.cabac_decision(d, 69)
                        rem = rem | (h264_cabac.cabac_decision(d, 69) << 1)
                        rem = rem | (h264_cabac.cabac_decision(d, 69) << 2)
                    } else {
                        rem = h264_bits.br_bits(&(*d).br, 3)
                    }
                    if rem < pm {
                        mode = rem
                    } else {
                        mode = rem + 1
                    }
                }
                raw.stb((*d).ipm, (mb * 16 + by * 4 + bx) as usize, mode)
                blk = blk + 1
            }
        } else {
            kind = 2
            raw.stb((*d).mbt, mb as usize, types.MB_I8)
            var q: i32 = 0
            while q < 4 {
                let bx: i32 = (q & 1) * 2
                let by: i32 = (q >> 1) * 2
                let pm: i32 = pred_intra_mode(d, mb, bx, by, av_a, av_b)
                var mode: i32 = pm
                var prevf: i32 = 0
                if cabac != 0 {
                    prevf = h264_cabac.cabac_decision(d, 68)
                } else {
                    prevf = h264_bits.br_get1(&(*d).br)
                }
                if prevf == 0 {
                    var rem: i32 = 0
                    if cabac != 0 {
                        rem = h264_cabac.cabac_decision(d, 69)
                        rem = rem | (h264_cabac.cabac_decision(d, 69) << 1)
                        rem = rem | (h264_cabac.cabac_decision(d, 69) << 2)
                    } else {
                        rem = h264_bits.br_bits(&(*d).br, 3)
                    }
                    if rem < pm {
                        mode = rem
                    } else {
                        mode = rem + 1
                    }
                }
                let o: usize = (mb * 16 + by * 4 + bx) as usize
                raw.stb((*d).ipm, o, mode)
                raw.stb((*d).ipm, o + 1, mode)
                raw.stb((*d).ipm, o + 4, mode)
                raw.stb((*d).ipm, o + 5, mode)
                q = q + 1
            }
        }
    } else {
        raw.stb((*d).mbt, mb as usize, types.MB_I16)
        kind = 1
        i16mode = (itype - 1) & 3
        var cbpc: i32 = ((itype - 1) >> 2) % 3
        var cbpl: i32 = 0
        if itype >= 13 {
            cbpl = 15
        }
        cbp = cbpl | (cbpc << 4)
    }
    var cpm: i32 = 0
    if cabac != 0 {
        cpm = cabacsyn.cabac_chroma_pred_mode(d, mb, av_a, av_b)
    } else {
        cpm = h264_bits.br_ue(&(*d).br)
    }
    if cpm > 3 {
        return 2
    }
    raw.stb((*d).icpm, mb as usize, cpm)
    if itype == 0 {
        if cabac != 0 {
            cbp = cabacsyn.cabac_cbp(d, mb, av_a, av_b)
        } else {
            let code: i32 = h264_bits.br_ue(&(*d).br)
            if code > 47 {
                return 2
            }
            cbp = h264_tables.h264_cbp_intra(code as usize) as i32
        }
    }
    raw.stb((*d).mbcbp, mb as usize, cbp)
    if t8 != 0 {
        raw.stb((*d).mbf, mb as usize, raw.ldu8((*d).mbf, mb as usize) | 4)
    }
    var dqp: i32 = 0
    if cbp != 0 || itype != 0 {
        if cabac != 0 {
            dqp = cabacsyn.cabac_dqp(d)
        } else {
            dqp = h264_bits.br_se(&(*d).br)
        }
        if apply_qp_delta(d, dqp) != 0 {
            return 2
        }
    }
    (*d).last_dqp = dqp
    raw.stb((*d).mbqp, mb as usize, (*d).qp)
    rt.mem_set((*d).coef, 0 as u8, 2048)
    let qp: i32 = (*d).qp
    let qpcb: i32 = cavlc.chroma_qp(qp, (*pps).cqp0)
    let qpcr: i32 = cavlc.chroma_qp(qp, (*pps).cqp1)
    if cabac != 0 {
        if cabacres.residual_luma_cabac(d, mb, kind, cbp & 15, qp, 1, av_a, av_b) != 0 {
            return 2
        }
        if cabacres.residual_chroma_cabac(d, mb, cbp >> 4, qpcb, qpcr, 1, av_a, av_b) != 0 {
            return 2
        }
    } else {
        if rescavlc.residual_luma_cavlc(d, mb, kind, cbp & 15, qp, 1, av_a, av_b) != 0 {
            return 2
        }
        if rescavlc.residual_chroma_cavlc(d, mb, cbp >> 4, qpcb, qpcr, 1, av_a, av_b) != 0 {
            return 2
        }
    }
    let ia_a: i32 = mbhelp.intra_ok(d, mb - 1, av_a)
    let ia_b: i32 = mbhelp.intra_ok(d, mb - (*d).mb_w, av_b)
    let ia_c: i32 = mbhelp.intra_ok(d, mb - (*d).mb_w + 1, av_c)
    let ia_d: i32 = mbhelp.intra_ok(d, mb - (*d).mb_w - 1, av_d)
    let sy: usize = (*d).stride_y as usize
    if itype == 0 {
        if t8 == 0 {
            mbhelp.recon_i4(d, ia_a, ia_b, ia_c, ia_d, mb)
        } else {
            mbhelp.recon_i8(d, ia_a, ia_b, ia_c, ia_d, mb)
        }
    } else {
        let base: u64 = mbhelp.mb_luma_ptr(d)
        h264_intra.pred16x16(base, sy, i16mode, ia_a, ia_b, ia_d)
        var bi: i32 = 0
        while bi < 16 {
            let bx: i32 = bi & 3
            let by: i32 = bi >> 2
            let dst: u64 = base + ((by * 4) as usize * sy + (bx * 4) as usize) as u64
            let cp: u64 = (*d).coef + ((bi * 16) as usize * 4) as u64
            if raw.ldu8((*d).nnz, (mb * 24 + bi) as usize) != 0 {
                transform.idct4_add(dst, sy, cp)
            } else {
                let dc: i32 = raw.ldi32(cp, 0)
                if dc != 0 {
                    transform.idct4_dc_add(dst, sy, dc)
                }
            }
            bi = bi + 1
        }
    }
    mbhelp.recon_chroma(d, mb, cpm, ia_a, ia_b)
    return 0
}
