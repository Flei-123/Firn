import media.video.h264.cabac as h264_cabac
import media.video.h264.mbhelp
import media.video.h264.params
import media.video.h264.raw
import media.video.h264.types

export {
    cabac_cbp, cabac_chroma_pred_mode, cabac_dqp, cabac_intra_type,
}

fn cabac_intra_type(d: *mut params.H264, base: i32, inc: i32, islice: i32) -> i32 {
    var st: usize = base as usize
    if islice != 0 {
        if h264_cabac.cabac_decision(d, st + (inc as usize)) == 0 {
            return 0
        }
        st = st + 2
    } else {
        if h264_cabac.cabac_decision(d, st) == 0 {
            return 0
        }
    }
    if h264_cabac.cabac_terminate(d) != 0 {
        return 25
    }
    var t: i32 = 1
    t = t + 12 * h264_cabac.cabac_decision(d, st + 1)
    if h264_cabac.cabac_decision(d, st + 2) != 0 {
        t = t + 4 + 4 * h264_cabac.cabac_decision(d, st + 2 + (islice as usize))
    }
    t = t + 2 * h264_cabac.cabac_decision(d, st + 3 + (islice as usize))
    t = t + h264_cabac.cabac_decision(d, st + 3 + 2 * (islice as usize))
    return t
}

fn cabac_dqp(d: *mut params.H264) -> i32 {
    var inc: usize = 0
    if (*d).last_dqp != 0 {
        inc = 1
    }
    if h264_cabac.cabac_decision(d, 60 + inc) == 0 {
        return 0
    }
    var k: i32 = 1
    var ctx: usize = 62
    while h264_cabac.cabac_decision(d, ctx) != 0 && k < 200 {
        k = k + 1
        ctx = 63
    }
    if (k & 1) != 0 {
        return (k + 1) >> 1
    }
    return 0 - (k >> 1)
}

fn cabac_chroma_pred_mode(d: *mut params.H264, mb: i32, av_a: i32, av_b: i32) -> i32 {
    var inc: usize = 0
    if av_a != 0 {
        let t: i32 = raw.ldu8((*d).mbt, (mb - 1) as usize)
        if mbhelp.mb_is_intra(t) != 0 && t != types.MB_PCM && raw.ldu8((*d).icpm, (mb - 1) as usize) != 0 {
            inc = inc + 1
        }
    }
    if av_b != 0 {
        let t2: i32 = raw.ldu8((*d).mbt, (mb - (*d).mb_w) as usize)
        if mbhelp.mb_is_intra(t2) != 0 && t2 != types.MB_PCM && raw.ldu8((*d).icpm, (mb - (*d).mb_w) as usize) != 0 {
            inc = inc + 1
        }
    }
    if h264_cabac.cabac_decision(d, 64 + inc) == 0 {
        return 0
    }
    if h264_cabac.cabac_decision(d, 67) == 0 {
        return 1
    }
    if h264_cabac.cabac_decision(d, 67) == 0 {
        return 2
    }
    return 3
}

fn cabac_cbp(d: *mut params.H264, mb: i32, av_a: i32, av_b: i32) -> i32 {
    var cbp: i32 = 0
    var b8: i32 = 0
    var ca: i32 = 15
    var cb: i32 = 15
    if av_a != 0 {
        ca = raw.ldu8((*d).mbcbp, (mb - 1) as usize) & 15
    }
    if av_b != 0 {
        cb = raw.ldu8((*d).mbcbp, (mb - (*d).mb_w) as usize) & 15
    }
    while b8 < 4 {
        var bit_a: i32 = 0
        var bit_b: i32 = 0
        if (b8 & 1) == 0 {
            bit_a = (ca >> (b8 + 1)) & 1
        } else {
            bit_a = (cbp >> (b8 - 1)) & 1
        }
        if b8 < 2 {
            bit_b = (cb >> (b8 + 2)) & 1
        } else {
            bit_b = (cbp >> (b8 - 2)) & 1
        }
        var inc: usize = 0
        if bit_a == 0 {
            inc = inc + 1
        }
        if bit_b == 0 {
            inc = inc + 2
        }
        cbp = cbp | (h264_cabac.cabac_decision(d, 73 + inc) << (b8 as u32))
        b8 = b8 + 1
    }
    var ra: i32 = 0
    var rb: i32 = 0
    if av_a != 0 {
        let t: i32 = raw.ldu8((*d).mbt, (mb - 1) as usize)
        if t == types.MB_PCM {
            ra = 2
        } else {
            ra = (raw.ldu8((*d).mbcbp, (mb - 1) as usize) >> 4) & 3
        }
    }
    if av_b != 0 {
        let t2: i32 = raw.ldu8((*d).mbt, (mb - (*d).mb_w) as usize)
        if t2 == types.MB_PCM {
            rb = 2
        } else {
            rb = (raw.ldu8((*d).mbcbp, (mb - (*d).mb_w) as usize) >> 4) & 3
        }
    }
    var inc0: usize = 0
    if ra != 0 {
        inc0 = inc0 + 1
    }
    if rb != 0 {
        inc0 = inc0 + 2
    }
    if h264_cabac.cabac_decision(d, 77 + inc0) == 0 {
        return cbp
    }
    var inc1: usize = 0
    if ra == 2 {
        inc1 = inc1 + 1
    }
    if rb == 2 {
        inc1 = inc1 + 2
    }
    if h264_cabac.cabac_decision(d, 77 + 4 + inc1) == 0 {
        return cbp | (1 << 4)
    }
    return cbp | (2 << 4)
}
