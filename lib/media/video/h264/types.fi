    frame_num: i32,
    field_pic: i32,
    bottom: i32,
    idr_pic_id: i32,
    poc_lsb: i32,
    delta_poc_bottom: i32,
    delta_poc0: i32,
    delta_poc1: i32,
    redundant: i32,
    direct_spatial: i32,
    num_ref0: i32,
    num_ref1: i32,
    rplm_n: [i32; 2],
    rplm_idc: [i32; 66],
