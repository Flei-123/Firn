}

struct Pic {
    used: i32,
    id: i32,
    y: u64,
    u: u64,
    v: u64,
    base_y: u64,
    base_u: u64,
    base_v: u64,
    mv: u64,
    refid: u64,
    refix: u64,
    intra: u64,
    ref_mark: i32,
