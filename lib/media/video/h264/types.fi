    delta_pic_always_zero: i32,
    offset_non_ref: i32,
    offset_tb: i32,
    n_ref_cycle: i32,
    offset_ref: [i32; 256],
    max_ref: i32,
    gaps: i32,
    mb_w: i32,
    mb_h: i32,
    frame_mbs_only: i32,
    mbaff: i32,
