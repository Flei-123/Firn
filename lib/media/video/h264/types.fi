import std.rt

export {
    Br, Frame, MB_B, MB_I16, MB_I4, MB_I8, MB_P, MB_PCM, PAD, Pic, Pps, ST_B, ST_I, ST_P, Sh, Sps, dbg,
    h264_set_debug, pic_new, pps_new, sh_new, sps_new,
}

static mut G_DEBUG: i32 = 0

fn h264_set_debug(v: i32) {
    G_DEBUG = v
}

fn dbg(tag: str, v: i64) {
    if G_DEBUG == 0 {
        return
    }
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b, tag.p as u64, tag.n)
    rt.buf_push(&b, 61 as u8)
    if v < 0 {
        rt.buf_push(&b, 45 as u8)
        rt.buf_push_dec_u64(&b, (0 - v) as u64)
    } else {
        rt.buf_push_dec_u64(&b, v as u64)
    }
    rt.buf_push(&b, 10 as u8)
    rt.write_everything(2, rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
}

const PAD: usize = 32

const MAXDPB: usize = 17

const ST_P: i32 = 0

const ST_B: i32 = 1

const ST_I: i32 = 2

const MB_NONE: i32 = 0

const MB_I4: i32 = 1

const MB_I8: i32 = 2

const MB_I16: i32 = 3

const MB_PCM: i32 = 4

const MB_P: i32 = 5

const MB_B: i32 = 6

struct Br {
    buf: u64,
    pos: i32,
    end: i32,
}

struct Sps {
