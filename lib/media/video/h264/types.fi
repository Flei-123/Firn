fn sps_new() -> Sps {
    return Sps { valid: 0, prof_idc: 0, constraint: 0, level: 0, chroma_format: 1, log2_max_fn: 4, poc_type: 0, log2_max_poc: 4,
        delta_pic_always_zero: 0, offset_non_ref: 0, offset_tb: 0, n_ref_cycle: 0, offset_ref: [0; 256], max_ref: 1, gaps: 0,
        mb_w: 0, mb_h: 0, frame_mbs_only: 1, mbaff: 0, direct8x8: 0, crop_l: 0, crop_r: 0, crop_t: 0, crop_b: 0,
        has_matrix: 0, sl4: [16 as u8; 96], sl8: [16 as u8; 128], reorder: -1, max_dec_buf: -1,
        matrix_coeffs: 2, full_range: 0, unsupported: 0 }
}

fn pps_new() -> Pps {
    return Pps { valid: 0, sps_id: 0, cabac: 0, bottom_poc: 0, n_groups: 1, num_ref0: 1, num_ref1: 1, weighted: 0, weighted_bi: 0,
        init_qp: 26, init_qs: 26, cqp0: 0, cqp1: 0, deblock_ctrl: 0, constrained_intra: 0, redundant_pic: 0, t8x8: 0,
        has_matrix: 0, sl4: [16 as u8; 96], sl8: [16 as u8; 128] }
}

fn sh_new() -> Sh {
    return Sh { first_mb: 0, slice_type: 0, pps_id: 0, frame_num: 0, field_pic: 0, bottom: 0, idr_pic_id: 0, poc_lsb: 0,
        delta_poc_bottom: 0, delta_poc0: 0, delta_poc1: 0, redundant: 0, direct_spatial: 0, num_ref0: 0, num_ref1: 0,
        rplm_n: [0; 2], rplm_idc: [0; 66], rplm_val: [0; 66], luma_log2_wd: 0, chroma_log2_wd: 0,
        pw: [0; 384], pw_flag: [0; 64], wp_def: 0, mmco_n: 0, mmco_op: [0; 68], mmco_a: [0; 68], mmco_b: [0; 68],
        adaptive: 0, long_term_ref: 0, no_output_prior: 0, cabac_init_idc: 0, qp: 26, disable_deblock: 0,
        alpha_off: 0, beta_off: 0, nal_ref_idc: 0, idr: 0 }
}

fn pic_new() -> Pic {
    return Pic { used: 0, id: 0, y: 0, u: 0, v: 0, base_y: 0, base_u: 0, base_v: 0, mv: 0, refid: 0, refix: 0, intra: 0,
        ref_mark: 0, long_idx: 0, frame_num: 0, frame_num_wrap: 0, poc: 0, needs_output: 0, is_ref_pic: 0,
        non_existing: 0, pin: 0, upts: -1 }
}
