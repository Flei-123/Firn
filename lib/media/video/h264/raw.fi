import std.rt

export {
    clip255, clip3, heap_zero, iabs, imax, imin, ldi16, ldi32, ldi8, ldu8, median3, stb, stbs, sti16, sti32,
}

fn ldu8(p: u64, i: usize) -> i32 {
    return (*((p + i as u64) as *mut u8)) as i32
}

fn ldi8(p: u64, i: usize) -> i32 {
    return (*((p + i as u64) as *mut i8)) as i32
}

fn stb(p: u64, i: usize, v: i32) {
    *((p + i as u64) as *mut u8) = v as u8
}

fn stbs(p: u64, i: usize, v: i32) {
    *((p + i as u64) as *mut u8) = (v & 255) as u8
}

fn ldi16(p: u64, i: usize) -> i32 {
    return (*((p + (i * 2) as u64) as *mut i16)) as i32
}

fn sti16(p: u64, i: usize, v: i32) {
    var x: i32 = v
    if x > 32767 {
        x = 32767
    }
    if x < -32768 {
        x = -32768
    }
    *((p + (i * 2) as u64) as *mut i16) = x as i16
}

fn ldi32(p: u64, i: usize) -> i32 {
    return *((p + (i * 4) as u64) as *mut i32)
}

fn sti32(p: u64, i: usize, v: i32) {
    *((p + (i * 4) as u64) as *mut i32) = v
}

fn heap_zero(n: usize) -> u64 {
    let p: u64 = rt.heap_alloc(n)
    rt.mem_set(p, 0 as u8, n)
    return p
}

fn clip255(v: i32) -> i32 {
    if v < 0 {
        return 0
    }
    if v > 255 {
        return 255
    }
    return v
}

fn clip3(lo: i32, hi: i32, v: i32) -> i32 {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

fn imin(a: i32, b: i32) -> i32 {
    if a < b {
        return a
    }
    return b
}

fn imax(a: i32, b: i32) -> i32 {
    if a > b {
        return a
    }
    return b
}

fn iabs(a: i32) -> i32 {
    if a < 0 {
        return 0 - a
    }
    return a
}

fn median3(a: i32, b: i32, c: i32) -> i32 {
    var lo: i32 = a
    var hi: i32 = b
    if lo > hi {
        lo = b
        hi = a
    }
    if c < lo {
        return lo
    }
    if c > hi {
        return hi
    }
    return c
}
