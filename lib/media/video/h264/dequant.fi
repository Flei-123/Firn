import media.video.h264.tables as h264_tables
import media.video.h264.params
import media.video.h264.raw
import media.video.h264.types

export {
    build_dequant,
}

fn norm4(m: usize, pos: usize) -> i32 {
    let x: usize = pos & 3
    let y: usize = pos >> 2
    if (x & 1) == 0 && (y & 1) == 0 {
        return h264_tables.h264_dequant4_init(m * 3) as i32
    }
    if (x & 1) == 1 && (y & 1) == 1 {
        return h264_tables.h264_dequant4_init(m * 3 + 2) as i32
    }
    return h264_tables.h264_dequant4_init(m * 3 + 1) as i32
}

fn norm8(m: usize, pos: usize) -> i32 {
    let i: usize = pos >> 3
    let j: usize = pos & 7
    var c: usize = 5
    if (i & 3) == 0 && (j & 3) == 0 {
        c = 0
    } else {
        if (i & 1) == 1 && (j & 1) == 1 {
            c = 1
        } else {
            if (i & 3) == 2 && (j & 3) == 2 {
                c = 2
            } else {
                if ((i & 3) == 0 && (j & 1) == 1) || ((i & 1) == 1 && (j & 3) == 0) {
                    c = 3
                } else {
                    if ((i & 3) == 0 && (j & 3) == 2) || ((i & 3) == 2 && (j & 3) == 0) {
                        c = 4
                    }
                }
            }
        }
    }
    return h264_tables.h264_dequant8_init(m * 6 + c) as i32
}

fn build_dequant(d: *mut params.H264, pps_id: i32) {
    if (*d).dq_for == pps_id {
        return
    }
    let pp: *mut types.Pps = &(*d).pps[pps_id as usize]
    let sp: *mut types.Sps = &(*d).sps[(*pp).sps_id as usize]
    var l4: u64 = (&(*sp).sl4[0]) as u64
    var l8: u64 = (&(*sp).sl8[0]) as u64
    if (*pp).has_matrix != 0 {
        l4 = (&(*pp).sl4[0]) as u64
        l8 = (&(*pp).sl8[0]) as u64
    }
    var i: usize = 0
    while i < 6 {
        var w: [i32; 16] = [0; 16]
        var k: usize = 0
        while k < 16 {
            w[h264_tables.h264_zz4(k) as usize] = raw.ldu8(l4, i * 16 + k)
            k = k + 1
        }
        var qp: usize = 0
        while qp < 52 {
            var pos: usize = 0
            while pos < 16 {
                let v: i32 = w[pos] * norm4(qp % 6, pos)
                raw.sti32((*d).dq4, (i * 52 + qp) * 16 + pos, v << ((qp / 6) as u32))
                pos = pos + 1
            }
            qp = qp + 1
        }
        i = i + 1
    }
    i = 0
    while i < 2 {
        var w8: [i32; 64] = [0; 64]
        var k8: usize = 0
        while k8 < 64 {
            w8[h264_tables.h264_zz8(k8) as usize] = raw.ldu8(l8, i * 64 + k8)
            k8 = k8 + 1
        }
        var qp8: usize = 0
        while qp8 < 52 {
            var pos8: usize = 0
            while pos8 < 64 {
                let v8: i32 = w8[pos8] * norm8(qp8 % 6, pos8)
                raw.sti32((*d).dq8, (i * 52 + qp8) * 64 + pos8, v8 << ((qp8 / 6) as u32))
                pos8 = pos8 + 1
            }
            qp8 = qp8 + 1
        }
        i = i + 1
    }
    (*d).dq_for = pps_id
}
