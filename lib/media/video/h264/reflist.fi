// SPDX-License-Identifier: MPL-2.0
import media.video.h264.params
import media.video.h264.types

export {
    build_ref_lists, max_frame_num, update_wraps,
}

fn max_frame_num(d: *mut params.H264) -> i32 {
    return 1 << ((*d).sps[(*d).active as usize].log2_max_fn as u32)
}

fn update_wraps(d: *mut params.H264) {
    let mf: i32 = max_frame_num(d)
    var i: usize = 0
    while i < 18 {
        let p: *mut types.Pic = &(*d).dpb[i]
        if (*p).ref_mark == 1 {
            if (*p).frame_num > (*d).sh.frame_num {
                (*p).frame_num_wrap = (*p).frame_num - mf
            } else {
                (*p).frame_num_wrap = (*p).frame_num
            }
        }
        i = i + 1
    }
}

fn ref_fill(d: *mut params.H264, list: i32, k: i32, idx: i32) {
    let o: usize = (list * 32 + k) as usize
    if idx < 0 {
        (*d).ref_pic[o] = -1
        (*d).ref_poc[o] = 0
        (*d).ref_long[o] = 0
        (*d).ref_id[o] = -1
        return
    }
    let p: *mut types.Pic = &(*d).dpb[idx as usize]
    (*d).ref_pic[o] = idx
    (*d).ref_poc[o] = (*p).poc
    (*d).ref_long[o] = 0
    if (*p).ref_mark == 2 {
        (*d).ref_long[o] = 1
    }
    (*d).ref_id[o] = (*p).id
}

fn build_ref_lists(d: *mut params.H264) {
    let sh: *mut types.Sh = &(*d).sh
    update_wraps(d)
    var tmp: [i32; 40] = [-1; 40]
    var shorts: [i32; 20] = [0; 20]
    var longs: [i32; 20] = [0; 20]
    var ns: i32 = 0
    var nl: i32 = 0
    var i: i32 = 0
    while i < 18 {
        let p: *mut types.Pic = &(*d).dpb[i as usize]
        if i != (*d).cur {
            if (*p).ref_mark == 1 {
                shorts[ns as usize] = i
                ns = ns + 1
            }
            if (*p).ref_mark == 2 {
                longs[nl as usize] = i
                nl = nl + 1
            }
        }
        i = i + 1
    }
    var a: i32 = 1
    while a < nl {
        var b: i32 = a
        while b > 0 && (*d).dpb[longs[(b - 1) as usize] as usize].long_idx > (*d).dpb[longs[b as usize] as usize].long_idx {
            let t: i32 = longs[b as usize]
            longs[b as usize] = longs[(b - 1) as usize]
            longs[(b - 1) as usize] = t
            b = b - 1
        }
        a = a + 1
    }
    var l: i32 = 0
    var nlists: i32 = 1
    if (*sh).slice_type == types.ST_B {
        nlists = 2
    }
    if (*sh).slice_type == types.ST_I {
        nlists = 0
    }
    var linit: [i32; 80] = [-1; 80]
    var lcount: [i32; 2] = [0; 2]
    while l < nlists {
        var n: i32 = 0
        if (*sh).slice_type == types.ST_P {
            var ord: [i32; 20] = [0; 20]
            var k: i32 = 0
            while k < ns {
                ord[k as usize] = shorts[k as usize]
                k = k + 1
            }
            var x: i32 = 1
            while x < ns {
                var y: i32 = x
                while y > 0 && (*d).dpb[ord[(y - 1) as usize] as usize].frame_num_wrap < (*d).dpb[ord[y as usize] as usize].frame_num_wrap {
                    let t2: i32 = ord[y as usize]
                    ord[y as usize] = ord[(y - 1) as usize]
                    ord[(y - 1) as usize] = t2
                    y = y - 1
                }
                x = x + 1
            }
            k = 0
            while k < ns {
                linit[(l * 40 + n) as usize] = ord[k as usize]
                n = n + 1
                k = k + 1
            }
        } else {
            var before: [i32; 20] = [0; 20]
            var after: [i32; 20] = [0; 20]
            var nb: i32 = 0
            var na: i32 = 0
            var k2: i32 = 0
            while k2 < ns {
                let pic: i32 = shorts[k2 as usize]
                if (*d).dpb[pic as usize].poc < (*d).poc {
                    before[nb as usize] = pic
                    nb = nb + 1
                } else {
                    after[na as usize] = pic
                    na = na + 1
                }
                k2 = k2 + 1
            }
            var x2: i32 = 1
            while x2 < nb {
                var y2: i32 = x2
                while y2 > 0 && (*d).dpb[before[(y2 - 1) as usize] as usize].poc < (*d).dpb[before[y2 as usize] as usize].poc {
                    let t3: i32 = before[y2 as usize]
                    before[y2 as usize] = before[(y2 - 1) as usize]
                    before[(y2 - 1) as usize] = t3
                    y2 = y2 - 1
                }
                x2 = x2 + 1
            }
            x2 = 1
            while x2 < na {
                var y3: i32 = x2
                while y3 > 0 && (*d).dpb[after[(y3 - 1) as usize] as usize].poc > (*d).dpb[after[y3 as usize] as usize].poc {
                    let t4: i32 = after[y3 as usize]
                    after[y3 as usize] = after[(y3 - 1) as usize]
                    after[(y3 - 1) as usize] = t4
                    y3 = y3 - 1
                }
                x2 = x2 + 1
            }
            if l == 0 {
                k2 = 0
                while k2 < nb {
                    linit[n as usize] = before[k2 as usize]
                    n = n + 1
                    k2 = k2 + 1
                }
                k2 = 0
                while k2 < na {
                    linit[n as usize] = after[k2 as usize]
                    n = n + 1
                    k2 = k2 + 1
                }
            } else {
                k2 = 0
                while k2 < na {
                    linit[(40 + n) as usize] = after[k2 as usize]
                    n = n + 1
                    k2 = k2 + 1
                }
                k2 = 0
                while k2 < nb {
                    linit[(40 + n) as usize] = before[k2 as usize]
                    n = n + 1
                    k2 = k2 + 1
                }
            }
        }
        var k3: i32 = 0
        while k3 < nl {
            linit[(l * 40 + n) as usize] = longs[k3 as usize]
            n = n + 1
            k3 = k3 + 1
        }
        lcount[l as usize] = n
        l = l + 1
    }
    if (*sh).slice_type == types.ST_B && lcount[1] > 1 && lcount[0] == lcount[1] {
        var same: i32 = 1
        var q: i32 = 0
        while q < lcount[0] {
            if linit[q as usize] != linit[(40 + q) as usize] {
                same = 0
            }
            q = q + 1
        }
        if same != 0 {
            let t5: i32 = linit[40]
            linit[40] = linit[41]
            linit[41] = t5
        }
    }
    l = 0
    while l < nlists {
        var num: i32 = (*sh).num_ref0
        if l == 1 {
            num = (*sh).num_ref1
        }
        var cur: [i32; 40] = [-1; 40]
        var c: i32 = 0
        while c < num && c < 33 {
            if c < lcount[l as usize] {
                cur[c as usize] = linit[(l * 40 + c) as usize]
            }
            c = c + 1
        }
        var pred: i32 = (*sh).frame_num
        var ref_idx: i32 = 0
        let max_pn: i32 = max_frame_num(d)
        var op: i32 = 0
        while op < (*sh).rplm_n[l as usize] && ref_idx < num {
            let idc: i32 = (*sh).rplm_idc[(l * 33 + op) as usize]
            let val: i32 = (*sh).rplm_val[(l * 33 + op) as usize]
            var target: i32 = -1
            var pic_num: i32 = 0
            var is_long: i32 = 0
            if idc < 2 {
                let abs_diff: i32 = val + 1
                var no_wrap: i32 = 0
                if idc == 0 {
                    no_wrap = pred - abs_diff
                    if no_wrap < 0 {
                        no_wrap = no_wrap + max_pn
                    }
                } else {
                    no_wrap = pred + abs_diff
                    if no_wrap >= max_pn {
                        no_wrap = no_wrap - max_pn
                    }
                }
                pred = no_wrap
                pic_num = no_wrap
                if no_wrap > (*sh).frame_num {
                    pic_num = no_wrap - max_pn
                }
                var s: i32 = 0
                while s < 18 {
                    if (*d).dpb[s as usize].ref_mark == 1 && s != (*d).cur && (*d).dpb[s as usize].frame_num_wrap == pic_num {
                        target = s
                    }
                    s = s + 1
                }
            } else {
                is_long = 1
                var s2: i32 = 0
                while s2 < 18 {
                    if (*d).dpb[s2 as usize].ref_mark == 2 && s2 != (*d).cur && (*d).dpb[s2 as usize].long_idx == val {
                        target = s2
                    }
                    s2 = s2 + 1
                }
            }
            if target >= 0 {
                var m: i32 = num
                while m > ref_idx {
                    cur[m as usize] = cur[(m - 1) as usize]
                    m = m - 1
                }
                cur[ref_idx as usize] = target
                ref_idx = ref_idx + 1
                var nidx: i32 = ref_idx
                var m2: i32 = ref_idx
                while m2 <= num {
                    if cur[m2 as usize] != target {
                        cur[nidx as usize] = cur[m2 as usize]
                        nidx = nidx + 1
                    }
                    m2 = m2 + 1
                }
            }
            op = op + 1
        }
        var first: i32 = -1
        c = 0
        while c < num {
            if cur[c as usize] >= 0 && first < 0 {
                first = cur[c as usize]
            }
            c = c + 1
        }
        c = 0
        while c < num {
            var e: i32 = cur[c as usize]
            if e < 0 {
                e = first
            }
            ref_fill(d, l, c, e)
            c = c + 1
        }
        (*d).ref_n[l as usize] = num
        l = l + 1
    }
    if nlists < 2 {
        (*d).ref_n[1] = 0
    }
    if nlists < 1 {
        (*d).ref_n[0] = 0
    }
}
