import media.video.h264.params
import media.video.h264.types

export {
    bump, flush_output, get_slot, run_mmco, sliding_window, unmark_all,
}

fn count_refs(d: *mut params.H264, skip: i32) -> i32 {
    var n: i32 = 0
    var i: i32 = 0
    while i < 18 {
        if i != skip && (*d).dpb[i as usize].ref_mark != 0 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn unmark_all(d: *mut params.H264) {
    var i: usize = 0
    while i < 18 {
        (*d).dpb[i].ref_mark = 0
        i = i + 1
    }
}

fn sliding_window(d: *mut params.H264, cur: i32) {
    var maxr: i32 = (*d).sps[(*d).active as usize].max_ref
    if maxr < 1 {
        maxr = 1
    }
    var guard: i32 = 0
    while count_refs(d, cur) >= maxr && guard < 20 {
        guard = guard + 1
        var best: i32 = -1
        var i: i32 = 0
        while i < 18 {
            if i != cur && (*d).dpb[i as usize].ref_mark == 1 {
                if best < 0 || (*d).dpb[i as usize].frame_num_wrap < (*d).dpb[best as usize].frame_num_wrap {
                    best = i
                }
            }
            i = i + 1
        }
        if best < 0 {
            return
        }
        (*d).dpb[best as usize].ref_mark = 0
    }
}

fn run_mmco(d: *mut params.H264) {
    let sh: *mut types.Sh = &(*d).sh
    let cur: i32 = (*d).cur
    var i: i32 = 0
    while i < (*sh).mmco_n {
        let op: i32 = (*sh).mmco_op[i as usize]
        let a: i32 = (*sh).mmco_a[i as usize]
        let b: i32 = (*sh).mmco_b[i as usize]
        if op == 1 {
            let pic_num_x: i32 = (*sh).frame_num - (a + 1)
            var s: i32 = 0
            while s < 18 {
                if s != cur && (*d).dpb[s as usize].ref_mark == 1 && (*d).dpb[s as usize].frame_num_wrap == pic_num_x {
                    (*d).dpb[s as usize].ref_mark = 0
                }
                s = s + 1
            }
        }
        if op == 2 {
            var s2: i32 = 0
            while s2 < 18 {
                if s2 != cur && (*d).dpb[s2 as usize].ref_mark == 2 && (*d).dpb[s2 as usize].long_idx == a {
                    (*d).dpb[s2 as usize].ref_mark = 0
                }
                s2 = s2 + 1
            }
        }
        if op == 3 {
            let pic_num_x2: i32 = (*sh).frame_num - (a + 1)
            var s3: i32 = 0
            while s3 < 18 {
                if s3 != cur && (*d).dpb[s3 as usize].ref_mark == 2 && (*d).dpb[s3 as usize].long_idx == b {
                    (*d).dpb[s3 as usize].ref_mark = 0
                }
                s3 = s3 + 1
            }
            s3 = 0
            while s3 < 18 {
                if s3 != cur && (*d).dpb[s3 as usize].ref_mark == 1 && (*d).dpb[s3 as usize].frame_num_wrap == pic_num_x2 {
                    (*d).dpb[s3 as usize].ref_mark = 2
                    (*d).dpb[s3 as usize].long_idx = b
                }
                s3 = s3 + 1
            }
        }
        if op == 4 {
            (*d).max_long_idx = a - 1
            var s4: i32 = 0
            while s4 < 18 {
                if s4 != cur && (*d).dpb[s4 as usize].ref_mark == 2 && (*d).dpb[s4 as usize].long_idx > (*d).max_long_idx {
                    (*d).dpb[s4 as usize].ref_mark = 0
                }
                s4 = s4 + 1
            }
        }
        if op == 5 {
            var s5: i32 = 0
            while s5 < 18 {
                if s5 != cur {
                    (*d).dpb[s5 as usize].ref_mark = 0
                }
                s5 = s5 + 1
            }
            (*d).max_long_idx = -1
            (*d).mmco5 = 1
        }
        if op == 6 {
            var s6: i32 = 0
            while s6 < 18 {
                if s6 != cur && (*d).dpb[s6 as usize].ref_mark == 2 && (*d).dpb[s6 as usize].long_idx == b {
                    (*d).dpb[s6 as usize].ref_mark = 0
                }
                s6 = s6 + 1
            }
            (*d).dpb[cur as usize].ref_mark = 2
            (*d).dpb[cur as usize].long_idx = b
        }
        i = i + 1
    }
}

fn output_one(d: *mut params.H264) -> i32 {
    var best: i32 = -1
    var i: i32 = 0
    while i < 18 {
        let p: *mut types.Pic = &(*d).dpb[i as usize]
        if (*p).needs_output != 0 {
            if best < 0 || (*p).poc < (*d).dpb[best as usize].poc {
                best = i
            }
        }
        i = i + 1
    }
    if best < 0 {
        return 0
    }
    (*d).dpb[best as usize].needs_output = 0
    if (*d).out_n >= 19 {
        (*d).dpb[(*d).out_q[0] as usize].pin = 0
        var k: i32 = 1
        while k < (*d).out_n {
            (*d).out_q[(k - 1) as usize] = (*d).out_q[k as usize]
            k = k + 1
        }
        (*d).out_n = (*d).out_n - 1
    }
    (*d).dpb[best as usize].pin = 1
    (*d).out_q[(*d).out_n as usize] = best
    (*d).out_n = (*d).out_n + 1
    return 1
}

fn flush_output(d: *mut params.H264) {
    var guard: i32 = 0
    while output_one(d) != 0 && guard < 40 {
        guard = guard + 1
    }
}

fn dpb_fullness(d: *mut params.H264) -> i32 {
    var n: i32 = 0
    var i: usize = 0
    while i < 18 {
        if (*d).dpb[i].ref_mark != 0 || (*d).dpb[i].needs_output != 0 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn waiting_count(d: *mut params.H264) -> i32 {
    var n: i32 = 0
    var i: usize = 0
    while i < 18 {
        if (*d).dpb[i].needs_output != 0 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn bump(d: *mut params.H264) {
    let sp: *mut types.Sps = &(*d).sps[(*d).active as usize]
    var guard: i32 = 0
    while guard < 40 {
        guard = guard + 1
        var must: i32 = 0
        if dpb_fullness(d) > (*d).dpb_size {
            must = 1
        }
        if (*sp).reorder >= 0 && waiting_count(d) > (*sp).reorder {
            must = 1
        }
        if must == 0 {
            return
        }
        if output_one(d) == 0 {
            return
        }
    }
}

fn find_free_slot(d: *mut params.H264) -> i32 {
    var i: i32 = 0
    while i < 18 {
        let p: *mut types.Pic = &(*d).dpb[i as usize]
        if i != (*d).cur && (*p).ref_mark == 0 && (*p).needs_output == 0 && (*p).pin == 0 {
            return i
        }
        i = i + 1
    }
    return -1
}

fn get_slot(d: *mut params.H264) -> i32 {
    var s: i32 = find_free_slot(d)
    var guard: i32 = 0
    while s < 0 && guard < 20 {
        guard = guard + 1
        if output_one(d) == 0 {
            if (*d).out_n > 0 {
                (*d).dpb[(*d).out_q[0] as usize].pin = 0
                var k: i32 = 1
                while k < (*d).out_n {
                    (*d).out_q[(k - 1) as usize] = (*d).out_q[k as usize]
                    k = k + 1
                }
                (*d).out_n = (*d).out_n - 1
            } else {
                var j: i32 = 0
                while j < 18 {
                    if j != (*d).cur && (*d).dpb[j as usize].ref_mark != 0 {
                        (*d).dpb[j as usize].ref_mark = 0
                        j = 99
                    }
                    j = j + 1
                }
            }
        }
        s = find_free_slot(d)
    }
    return s
}
