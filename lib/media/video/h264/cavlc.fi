import media.video.h264.bits as h264_bits
import media.video.h264.params
import media.video.h264.raw
import media.video.h264.vlctries

export {
    blk_x, blk_y, cavlc_block, chroma_qp, nc_chroma, nc_luma,
}

fn cavlc_block(d: *mut params.H264, tclass: i32, nc: i32, maxn: i32, lv: u64) -> i32 {
    var i: i32 = 0
    while i < maxn {
        raw.sti32(lv, i as usize, 0)
        i = i + 1
    }
    var tk: usize = 4
    if tclass != 4 {
        if nc < 2 {
            tk = 0
        } else {
            if nc < 4 {
                tk = 1
            } else {
                if nc < 8 {
                    tk = 2
                } else {
                    tk = 3
                }
            }
        }
    }
    let sym: i32 = vlctries.trie_sym(d, tk)
    if sym < 0 {
        return -1
    }
    let tc: i32 = sym >> 2
    let t1: i32 = sym & 3
    if tc == 0 {
        return 0
    }
    if tc > maxn || t1 > tc {
        return -1
    }
    var lev: [i32; 16] = [0; 16]
    var suffix_len: i32 = 0
    if tc > 10 && t1 < 3 {
        suffix_len = 1
    }
    i = 0
    while i < tc {
        if i < t1 {
            lev[i as usize] = 1 - 2 * h264_bits.br_get1(&(*d).br)
        } else {
            var prefix: i32 = 0
            while h264_bits.br_get1(&(*d).br) == 0 {
                prefix = prefix + 1
                if prefix > 30 || h264_bits.br_left(&(*d).br) < 0 {
                    return -1
                }
            }
            var code: i32 = raw.imin(15, prefix) << (suffix_len as u32)
            if suffix_len > 0 || prefix >= 14 {
                var size: i32 = suffix_len
                if prefix == 14 && suffix_len == 0 {
                    size = 4
                }
                if prefix >= 15 {
                    size = prefix - 3
                }
                if size > 0 {
                    code = code + h264_bits.br_bits(&(*d).br, size)
                }
            }
            if prefix >= 15 && suffix_len == 0 {
                code = code + 15
            }
            if prefix >= 16 {
                code = code + (1 << ((prefix - 3) as u32)) - 4096
            }
            if i == t1 && t1 < 3 {
                code = code + 2
            }
            var lvl: i32 = 0
            if (code & 1) == 0 {
                lvl = (code + 2) >> 1
            } else {
                lvl = (0 - code - 1) >> 1
            }
            lev[i as usize] = lvl
            if suffix_len == 0 {
                suffix_len = 1
            }
            if raw.iabs(lvl) > (3 << ((suffix_len - 1) as u32)) && suffix_len < 6 {
                suffix_len = suffix_len + 1
            }
        }
        i = i + 1
    }
    var zeros_left: i32 = 0
    if tc < maxn {
        var tz: i32 = 0
        if tclass == 4 {
            tz = vlctries.trie_sym(d, (20 + tc - 1) as usize)
        } else {
            tz = vlctries.trie_sym(d, (5 + tc - 1) as usize)
        }
        if tz < 0 {
            return -1
        }
        zeros_left = tz
    }
    var pos: i32 = tc + zeros_left - 1
    if pos >= maxn {
        return -1
    }
    i = 0
    while i < tc {
        raw.sti32(lv, pos as usize, lev[i as usize])
        var run: i32 = 0
        if i < tc - 1 {
            if zeros_left > 0 {
                var rk: usize = 29
                if zeros_left <= 6 {
                    rk = (23 + zeros_left - 1) as usize
                } else {
                    rk = 29
                }
                run = vlctries.trie_sym(d, rk)
                if run < 0 || run > zeros_left {
                    return -1
                }
            }
        }
        pos = pos - 1 - run
        zeros_left = zeros_left - run
        i = i + 1
    }
    return tc
}

fn nc_luma(d: *mut params.H264, mb: i32, bx: i32, by: i32, av_a: i32, av_b: i32) -> i32 {
    var na: i32 = 0
    var nb: i32 = 0
    var ha: i32 = 0
    var hb: i32 = 0
    if bx > 0 {
        na = raw.ldu8((*d).nnz, (mb * 24 + by * 4 + bx - 1) as usize)
        ha = 1
    } else {
        if av_a != 0 {
            na = raw.ldu8((*d).nnz, ((mb - 1) * 24 + by * 4 + 3) as usize)
            ha = 1
        }
    }
    if by > 0 {
        nb = raw.ldu8((*d).nnz, (mb * 24 + (by - 1) * 4 + bx) as usize)
        hb = 1
    } else {
        if av_b != 0 {
            nb = raw.ldu8((*d).nnz, ((mb - (*d).mb_w) * 24 + 12 + bx) as usize)
            hb = 1
        }
    }
    if ha != 0 && hb != 0 {
        return (na + nb + 1) >> 1
    }
    if ha != 0 {
        return na
    }
    if hb != 0 {
        return nb
    }
    return 0
}

fn nc_chroma(d: *mut params.H264, mb: i32, comp: i32, bx: i32, by: i32, av_a: i32, av_b: i32) -> i32 {
    var na: i32 = 0
    var nb: i32 = 0
    var ha: i32 = 0
    var hb: i32 = 0
    let base: i32 = 16 + comp * 4
    if bx > 0 {
        na = raw.ldu8((*d).nnz, (mb * 24 + base + by * 2) as usize)
        ha = 1
    } else {
        if av_a != 0 {
            na = raw.ldu8((*d).nnz, ((mb - 1) * 24 + base + by * 2 + 1) as usize)
            ha = 1
        }
    }
    if by > 0 {
        nb = raw.ldu8((*d).nnz, (mb * 24 + base + bx) as usize)
        hb = 1
    } else {
        if av_b != 0 {
            nb = raw.ldu8((*d).nnz, ((mb - (*d).mb_w) * 24 + base + 2 + bx) as usize)
            hb = 1
        }
    }
    if ha != 0 && hb != 0 {
        return (na + nb + 1) >> 1
    }
    if ha != 0 {
        return na
    }
    if hb != 0 {
        return nb
    }
    return 0
}

fn blk_x(b: i32) -> i32 {
    return (b & 1) | ((b >> 1) & 2)
}

fn blk_y(b: i32) -> i32 {
    return ((b >> 1) & 1) | ((b >> 2) & 2)
}

fn chroma_qp(qp: i32, off: i32) -> i32 {
    let qpi: i32 = raw.clip3(0, 51, qp + off)
    if qpi < 30 {
        return qpi
    }
    var tbl: [i32; 22] = [29, 30, 31, 32, 32, 33, 34, 34, 35, 35, 36, 36, 37, 37, 37, 38, 38, 38, 39, 39, 39, 39]
    return tbl[(qpi - 30) as usize]
}
