import std.rt
import media.video.h264.bits as h264_bits
import media.video.h264.cabac as h264_cabac
import media.video.h264.cabacsyn
import media.video.h264.dequant
import media.video.h264.intermb
import media.video.h264.intermbsyn
import media.video.h264.intramb
import media.video.h264.params
import media.video.h264.pics
import media.video.h264.picture
import media.video.h264.raw
import media.video.h264.reflist
import media.video.h264.slicehdr
import media.video.h264.types

export {
    decode_slice,
}

fn set_mb_pos(d: *mut params.H264, mb: i32) {
    (*d).mb_addr = mb
    (*d).mb_x = mb % (*d).mb_w
    (*d).mb_y = mb / (*d).mb_w
}

fn neighbour_flags(d: *mut params.H264, mb: i32, av: *mut i32) {
    let x: i32 = (*d).mb_x
    let y: i32 = (*d).mb_y
    let s: i32 = (*d).cur_slice
    var a: i32 = 0
    var b: i32 = 0
    var c: i32 = 0
    var dd: i32 = 0
    if x > 0 && raw.ldi32((*d).mbslice, (mb - 1) as usize) == s {
        a = 1
    }
    if y > 0 && raw.ldi32((*d).mbslice, (mb - (*d).mb_w) as usize) == s {
        b = 1
    }
    if y > 0 && x < (*d).mb_w - 1 && raw.ldi32((*d).mbslice, (mb - (*d).mb_w + 1) as usize) == s {
        c = 1
    }
    if y > 0 && x > 0 && raw.ldi32((*d).mbslice, (mb - (*d).mb_w - 1) as usize) == s {
        dd = 1
    }
    *av = a
    *((av as u64 + 4) as *mut i32) = b
    *((av as u64 + 8) as *mut i32) = c
    *((av as u64 + 12) as *mut i32) = dd
}

fn decode_mb_cavlc(d: *mut params.H264, mb: i32) -> i32 {
    var av: [i32; 4] = [0; 4]
    neighbour_flags(d, mb, &av[0])
    intramb.start_mb(d, mb)
    let mt: i32 = h264_bits.br_ue(&(*d).br)
    var itype: i32 = -1
    let st: i32 = (*d).sh.slice_type
    if st == types.ST_I {
        itype = mt
    } else {
        if st == types.ST_P {
            if mt >= 5 {
                itype = mt - 5
            }
        } else {
            if mt >= 23 {
                itype = mt - 23
            }
        }
    }
    if itype > 25 {
        return 2
    }
    if itype >= 0 {
        return intramb.decode_intra_mb(d, mb, itype, av[0], av[1], av[2], av[3])
    }
    return intermbsyn.decode_inter_mb(d, mb, mt, av[0], av[1], av[2], av[3])
}

fn decode_slice_cavlc(d: *mut params.H264) -> i32 {
    var mb: i32 = (*d).sh.first_mb
    (*d).qp = (*d).sh.qp
    (*d).last_dqp = 0
    var go: i32 = 1
    while go != 0 {
        if mb >= (*d).mbs {
            go = 0
        } else {
            set_mb_pos(d, mb)
            if (*d).sh.slice_type != types.ST_I {
                let run: i32 = h264_bits.br_ue(&(*d).br)
                if run < 0 || run > (*d).mbs - mb {
                    return 2
                }
                var k: i32 = 0
                while k < run {
                    set_mb_pos(d, mb)
                    let rc0: i32 = decode_skip_mb(d, mb)
                    if rc0 != 0 {
                        return rc0
                    }
                    mb = mb + 1
                    k = k + 1
                }
                if run > 0 {
                    if h264_bits.br_more_rbsp(&(*d).br) == 0 || mb >= (*d).mbs {
                        return 0
                    }
                    set_mb_pos(d, mb)
                }
            }
            let rc: i32 = decode_mb_cavlc(d, mb)
            if rc != 0 {
                return rc
            }
            mb = mb + 1
            if h264_bits.br_more_rbsp(&(*d).br) == 0 {
                go = 0
            }
        }
    }
    return 0
}

fn decode_mb_cabac(d: *mut params.H264, mb: i32) -> i32 {
    var av: [i32; 4] = [0; 4]
    neighbour_flags(d, mb, &av[0])
    intramb.start_mb(d, mb)
    let st: i32 = (*d).sh.slice_type
    var itype: i32 = -1
    if st == types.ST_I {
        var inc: i32 = 0
        if av[0] != 0 && raw.ldu8((*d).mbt, (mb - 1) as usize) != types.MB_I4 && raw.ldu8((*d).mbt, (mb - 1) as usize) != types.MB_I8 {
            inc = inc + 1
        }
        if av[1] != 0 && raw.ldu8((*d).mbt, (mb - (*d).mb_w) as usize) != types.MB_I4 && raw.ldu8((*d).mbt, (mb - (*d).mb_w) as usize) != types.MB_I8 {
            inc = inc + 1
        }
        itype = cabacsyn.cabac_intra_type(d, 3, inc, 1)
        if (*d).pic_count == 0 {
            types.dbg("itype", itype as i64)
        }
        return intramb.decode_intra_mb(d, mb, itype, av[0], av[1], av[2], av[3])
    }
    if st == types.ST_P {
        var mt: i32 = 0
        if h264_cabac.cabac_decision(d, 14) == 0 {
            if h264_cabac.cabac_decision(d, 15) == 0 {
                mt = 3 * h264_cabac.cabac_decision(d, 16)
            } else {
                mt = 2 - h264_cabac.cabac_decision(d, 17)
            }
            return intermbsyn.decode_inter_mb(d, mb, mt, av[0], av[1], av[2], av[3])
        }
        itype = cabacsyn.cabac_intra_type(d, 17, 0, 0)
        return intramb.decode_intra_mb(d, mb, itype, av[0], av[1], av[2], av[3])
    }
    var inc: usize = 0
    if av[0] != 0 && (raw.ldu8((*d).mbf, (mb - 1) as usize) & 2) == 0 {
        inc = inc + 1
    }
    if av[1] != 0 && (raw.ldu8((*d).mbf, (mb - (*d).mb_w) as usize) & 2) == 0 {
        inc = inc + 1
    }
    var bt: i32 = 0
    if h264_cabac.cabac_decision(d, 27 + inc) == 0 {
        bt = 0
    } else {
        if h264_cabac.cabac_decision(d, 27 + 3) == 0 {
            bt = 1 + h264_cabac.cabac_decision(d, 27 + 5)
        } else {
            var bits: i32 = h264_cabac.cabac_decision(d, 27 + 4) << 3
            bits = bits | (h264_cabac.cabac_decision(d, 27 + 5) << 2)
            bits = bits | (h264_cabac.cabac_decision(d, 27 + 5) << 1)
            bits = bits | h264_cabac.cabac_decision(d, 27 + 5)
            if bits < 8 {
                bt = bits + 3
            } else {
                if bits == 13 {
                    itype = cabacsyn.cabac_intra_type(d, 32, 0, 0)
                    return intramb.decode_intra_mb(d, mb, itype, av[0], av[1], av[2], av[3])
                }
                if bits == 14 {
                    bt = 11
                } else {
                    if bits == 15 {
                        bt = 22
                    } else {
                        bits = (bits << 1) | h264_cabac.cabac_decision(d, 27 + 5)
                        bt = bits - 4
                    }
                }
            }
        }
    }
    return intermbsyn.decode_inter_mb(d, mb, bt, av[0], av[1], av[2], av[3])
}

fn cabac_skip_flag(d: *mut params.H264, mb: i32) -> i32 {
    var av: [i32; 4] = [0; 4]
    neighbour_flags(d, mb, &av[0])
    var inc: usize = 0
    if av[0] != 0 && (raw.ldu8((*d).mbf, (mb - 1) as usize) & 1) == 0 {
        inc = inc + 1
    }
    if av[1] != 0 && (raw.ldu8((*d).mbf, (mb - (*d).mb_w) as usize) & 1) == 0 {
        inc = inc + 1
    }
    if (*d).sh.slice_type == types.ST_B {
        return h264_cabac.cabac_decision(d, 24 + inc)
    }
    return h264_cabac.cabac_decision(d, 11 + inc)
}

fn decode_slice_cabac(d: *mut params.H264) -> i32 {
    (*d).br.pos = ((*d).br.pos + 7) & (0 - 8)
    h264_cabac.cabac_init_contexts(d)
    h264_cabac.cabac_start(d)
    var mb: i32 = (*d).sh.first_mb
    (*d).qp = (*d).sh.qp
    (*d).last_dqp = 0
    var go: i32 = 1
    while go != 0 {
        if mb >= (*d).mbs {
            return 0
        }
        set_mb_pos(d, mb)
        var rc: i32 = 0
        if (*d).sh.slice_type != types.ST_I && cabac_skip_flag(d, mb) != 0 {
            rc = decode_skip_mb(d, mb)
        } else {
            rc = decode_mb_cabac(d, mb)
        }
        if rc != 0 {
            types.dbg("cabac mb error mb", mb as i64)
            types.dbg("cabac mb error rc", rc as i64)
            return rc
        }
        mb = mb + 1
        if h264_cabac.cabac_terminate(d) != 0 {
            types.dbg("cabac slice end at mb", mb as i64)
            go = 0
        }
    }
    return 0
}

fn decode_skip_mb(d: *mut params.H264, mb: i32) -> i32 {
    var av: [i32; 4] = [0; 4]
    neighbour_flags(d, mb, &av[0])
    if (*d).sh.slice_type == types.ST_P {
        return intermbsyn.decode_pskip_mb(d, mb)
    }
    return intermbsyn.decode_bskip_mb(d, mb)
}

fn decode_slice(d: *mut params.H264, nal_type: i32, ref_idc: i32) -> i32 {
    let rc: i32 = slicehdr.parse_slice_header(d, nal_type, ref_idc)
    if rc != 0 {
        (*d).err_site = 1
        return rc
    }
    let sh: *mut types.Sh = &(*d).sh
    if (*sh).redundant != 0 {
        return 0
    }
    let pp: *mut types.Pps = &(*d).pps[(*sh).pps_id as usize]
    var newpic: i32 = 0
    if (*d).have_pic == 0 {
        newpic = 1
    } else {
        if (*sh).first_mb == 0 {
            newpic = 1
        }
    }
    if newpic != 0 {
        picture.finish_picture(d)
        let sid: i32 = (*pp).sps_id
        if (*d).active != sid || (*d).mbt == 0 || (*sh).idr != 0 {
            let arc: i32 = pics.activate_sps(d, sid)
            if arc != 0 {
                return arc
            }
        }
        if (*d).need_idr != 0 && (*sh).idr == 0 && (*sh).slice_type != types.ST_I {
            (*d).err_site = 2
            return 2
        }
        (*d).need_idr = 0
        let src: i32 = picture.start_picture(d)
        if src != 0 {
            (*d).err_site = 3
            return src
        }
    }
    if (*d).have_pic == 0 {
        (*d).err_site = 4
        return 2
    }
    if (*sh).first_mb >= (*d).mbs {
        (*d).err_site = 5
        return 2
    }
    dequant.build_dequant(d, (*sh).pps_id)
    if (*sh).slice_type != types.ST_I {
        reflist.build_ref_lists(d)
        if (*d).ref_n[0] == 0 {
            (*d).err_site = 6
            return 2
        }
        if (*sh).slice_type == types.ST_B {
            if (*d).ref_n[1] == 0 {
                (*d).err_site = 7
                return 2
            }
            if intermb.weight_mode(d) == 2 {
                intermb.build_implicit_weights(d)
            }
        }
    }
    if (*d).nslices >= (*d).slice_cap {
        let ncap: i32 = (*d).slice_cap * 2
        let nt: u64 = raw.heap_zero((ncap as usize) * 32)
        rt.mem_copy(nt, (*d).slice_tab, ((*d).slice_cap as usize) * 32)
        rt.heap_free((*d).slice_tab, ((*d).slice_cap as usize) * 32)
        (*d).slice_tab = nt
        (*d).slice_cap = ncap
    }
    let so: usize = ((*d).nslices as usize) * 8
    raw.sti32((*d).slice_tab, so, (*sh).disable_deblock)
    raw.sti32((*d).slice_tab, so + 1, (*sh).alpha_off)
    raw.sti32((*d).slice_tab, so + 2, (*sh).beta_off)
    raw.sti32((*d).slice_tab, so + 3, (*pp).cqp0)
    raw.sti32((*d).slice_tab, so + 4, (*pp).cqp1)
    raw.sti32((*d).slice_tab, so + 5, (*sh).slice_type)
    (*d).cur_slice = (*d).nslices
    (*d).nslices = (*d).nslices + 1
    if (*d).parse_only != 0 {
        return 0
    }
    var src: i32 = 0
    if (*pp).cabac != 0 {
        src = decode_slice_cabac(d)
    } else {
        src = decode_slice_cavlc(d)
    }
    if src != 0 {
        (*d).err_site = 8
    }
    return src
}
