// SPDX-License-Identifier: MPL-2.0
import std.rt
import media.video.h264.raw

export {
    pred16x16, pred4x4, pred8x8, pred_chroma,
}

fn pred4x4(dst: u64, stride: usize, mode: i32, has_l: i32, has_t: i32, has_tr: i32, has_tl: i32) {
    var t: [i32; 8] = [128; 8]
    var l: [i32; 4] = [128; 4]
    var tl: i32 = 128
    let up: u64 = dst - stride as u64
    if has_t != 0 {
        var i: usize = 0
        while i < 4 {
            t[i] = raw.ldu8(up, i)
            i = i + 1
        }
        if has_tr != 0 {
            i = 4
            while i < 8 {
                t[i] = raw.ldu8(up, i)
                i = i + 1
            }
        } else {
            i = 4
            while i < 8 {
                t[i] = t[3]
                i = i + 1
            }
        }
    }
    if has_l != 0 {
        var j: usize = 0
        while j < 4 {
            l[j] = raw.ldu8((dst + (j * stride) as u64) - 1, 0)
            j = j + 1
        }
    }
    if has_tl != 0 {
        tl = raw.ldu8(up - 1, 0)
    }
    var out: [i32; 16] = [0; 16]
    var x: i32 = 0
    var y: i32 = 0
    if mode == 0 {
        y = 0
        while y < 4 {
            x = 0
            while x < 4 {
                out[(y * 4 + x) as usize] = t[x as usize]
                x = x + 1
            }
            y = y + 1
        }
    }
    if mode == 1 {
        y = 0
        while y < 4 {
            x = 0
            while x < 4 {
                out[(y * 4 + x) as usize] = l[y as usize]
                x = x + 1
            }
            y = y + 1
        }
    }
    if mode == 2 {
        var dc: i32 = 128
        if has_t != 0 && has_l != 0 {
            dc = (t[0] + t[1] + t[2] + t[3] + l[0] + l[1] + l[2] + l[3] + 4) >> 3
        } else {
            if has_l != 0 {
                dc = (l[0] + l[1] + l[2] + l[3] + 2) >> 2
            } else {
                if has_t != 0 {
                    dc = (t[0] + t[1] + t[2] + t[3] + 2) >> 2
                }
            }
        }
        var k: usize = 0
        while k < 16 {
            out[k] = dc
            k = k + 1
        }
    }
    if mode == 3 {
        y = 0
        while y < 4 {
            x = 0
            while x < 4 {
                if x == 3 && y == 3 {
                    out[15] = (t[6] + 3 * t[7] + 2) >> 2
                } else {
                    out[(y * 4 + x) as usize] = (t[(x + y) as usize] + 2 * t[(x + y + 1) as usize] + t[(x + y + 2) as usize] + 2) >> 2
                }
                x = x + 1
            }
            y = y + 1
        }
    }
    if mode == 4 || mode == 5 || mode == 6 {
        var e: [i32; 9] = [0; 9]
        e[0] = l[3]
        e[1] = l[2]
        e[2] = l[1]
        e[3] = l[0]
        e[4] = tl
        e[5] = t[0]
        e[6] = t[1]
        e[7] = t[2]
        e[8] = t[3]
        y = 0
        while y < 4 {
            x = 0
            while x < 4 {
                var v: i32 = 0
                if mode == 4 {
                    let c: i32 = 4 + x - y
                    v = (e[(c - 1) as usize] + 2 * e[c as usize] + e[(c + 1) as usize] + 2) >> 2
                }
                if mode == 5 {
                    let z: i32 = 2 * x - y
                    if z >= 0 {
                        let a: i32 = 4 + x - (y >> 1)
                        if (z & 1) == 0 {
                            v = (e[a as usize] + e[(a + 1) as usize] + 1) >> 1
                        } else {
                            v = (e[(a - 1) as usize] + 2 * e[a as usize] + e[(a + 1) as usize] + 2) >> 2
                        }
                    } else {
                        if z == -1 {
                            v = (e[3] + 2 * e[4] + e[5] + 2) >> 2
                        } else {
                            v = (e[(4 - y) as usize] + 2 * e[(5 - y) as usize] + e[(6 - y) as usize] + 2) >> 2
                        }
                    }
                }
                if mode == 6 {
                    let z2: i32 = 2 * y - x
                    if z2 >= 0 {
                        let b: i32 = 4 - y + (x >> 1)
                        if (z2 & 1) == 0 {
                            v = (e[b as usize] + e[(b - 1) as usize] + 1) >> 1
                        } else {
                            v = (e[(b + 1) as usize] + 2 * e[b as usize] + e[(b - 1) as usize] + 2) >> 2
                        }
                    } else {
                        if z2 == -1 {
                            v = (e[3] + 2 * e[4] + e[5] + 2) >> 2
                        } else {
                            v = (e[(4 + x - 1 + 1) as usize] + 2 * e[(4 + x - 2 + 1) as usize] + e[(4 + x - 3 + 1) as usize] + 2) >> 2
                        }
                    }
                }
                out[(y * 4 + x) as usize] = v
                x = x + 1
            }
            y = y + 1
        }
    }
    if mode == 7 {
        y = 0
        while y < 4 {
            x = 0
            while x < 4 {
                let a2: i32 = x + (y >> 1)
                if (y & 1) == 0 {
                    out[(y * 4 + x) as usize] = (t[a2 as usize] + t[(a2 + 1) as usize] + 1) >> 1
                } else {
                    out[(y * 4 + x) as usize] = (t[a2 as usize] + 2 * t[(a2 + 1) as usize] + t[(a2 + 2) as usize] + 2) >> 2
                }
                x = x + 1
            }
            y = y + 1
        }
    }
    if mode == 8 {
        y = 0
        while y < 4 {
            x = 0
            while x < 4 {
                let z3: i32 = x + 2 * y
                let a3: i32 = y + (x >> 1)
                var v3: i32 = l[3]
                if z3 > 5 {
                    v3 = l[3]
                } else {
                    if z3 == 5 {
                        v3 = (l[2] + 3 * l[3] + 2) >> 2
                    } else {
                        if (z3 & 1) == 0 {
                            v3 = (l[a3 as usize] + l[(a3 + 1) as usize] + 1) >> 1
                        } else {
                            v3 = (l[a3 as usize] + 2 * l[(a3 + 1) as usize] + l[(a3 + 2) as usize] + 2) >> 2
                        }
                    }
                }
                out[(y * 4 + x) as usize] = v3
                x = x + 1
            }
            y = y + 1
        }
    }
    y = 0
    while y < 4 {
        x = 0
        while x < 4 {
            raw.stb(dst, (y as usize) * stride + (x as usize), out[(y * 4 + x) as usize])
            x = x + 1
        }
        y = y + 1
    }
}

fn pred8x8(dst: u64, stride: usize, mode: i32, has_l: i32, has_t: i32, has_tr: i32, has_tl: i32) {
    var tp: [i32; 16] = [128; 16]
    var lp: [i32; 8] = [128; 8]
    var tlp: i32 = 128
    let up: u64 = dst - stride as u64
    if has_t != 0 {
        var i: usize = 0
        while i < 8 {
            tp[i] = raw.ldu8(up, i)
            i = i + 1
        }
        if has_tr != 0 {
            i = 8
            while i < 16 {
                tp[i] = raw.ldu8(up, i)
                i = i + 1
            }
        } else {
            i = 8
            while i < 16 {
                tp[i] = tp[7]
                i = i + 1
            }
        }
    }
    if has_l != 0 {
        var j: usize = 0
        while j < 8 {
            lp[j] = raw.ldu8((dst + (j * stride) as u64) - 1, 0)
            j = j + 1
        }
    }
    if has_tl != 0 {
        tlp = raw.ldu8(up - 1, 0)
    }
    var t: [i32; 16] = [128; 16]
    var l: [i32; 8] = [128; 8]
    var tl: i32 = tlp
    if has_t != 0 {
        if has_tl != 0 {
            t[0] = (tlp + 2 * tp[0] + tp[1] + 2) >> 2
        } else {
            t[0] = (3 * tp[0] + tp[1] + 2) >> 2
        }
        var x: usize = 1
        while x < 15 {
            t[x] = (tp[x - 1] + 2 * tp[x] + tp[x + 1] + 2) >> 2
            x = x + 1
        }
        t[15] = (tp[14] + 3 * tp[15] + 2) >> 2
    }
    if has_tl != 0 {
        if has_t != 0 && has_l != 0 {
            tl = (tp[0] + 2 * tlp + lp[0] + 2) >> 2
        } else {
            if has_t != 0 {
                tl = (3 * tlp + tp[0] + 2) >> 2
            } else {
                if has_l != 0 {
                    tl = (3 * tlp + lp[0] + 2) >> 2
                }
            }
        }
    }
    if has_l != 0 {
        if has_tl != 0 {
            l[0] = (tlp + 2 * lp[0] + lp[1] + 2) >> 2
        } else {
            l[0] = (3 * lp[0] + lp[1] + 2) >> 2
        }
        var y: usize = 1
        while y < 7 {
            l[y] = (lp[y - 1] + 2 * lp[y] + lp[y + 1] + 2) >> 2
            y = y + 1
        }
        l[7] = (lp[6] + 3 * lp[7] + 2) >> 2
    }
    var e: [i32; 25] = [0; 25]
    var k: usize = 0
    while k < 8 {
        e[k] = l[7 - k]
        k = k + 1
    }
    e[8] = tl
    k = 0
    while k < 16 {
        e[9 + k] = t[k]
        k = k + 1
    }
    var out: [i32; 64] = [0; 64]
    var x: i32 = 0
    var y: i32 = 0
    if mode == 2 {
        var dc: i32 = 128
        var st: i32 = 0
        var sl: i32 = 0
        k = 0
        while k < 8 {
            st = st + t[k]
            sl = sl + l[k]
            k = k + 1
        }
        if has_t != 0 && has_l != 0 {
            dc = (st + sl + 8) >> 4
        } else {
            if has_l != 0 {
                dc = (sl + 4) >> 3
            } else {
                if has_t != 0 {
                    dc = (st + 4) >> 3
                }
            }
        }
        k = 0
        while k < 64 {
            out[k] = dc
            k = k + 1
        }
    } else {
        y = 0
        while y < 8 {
            x = 0
            while x < 8 {
                var v: i32 = 0
                if mode == 0 {
                    v = e[(9 + x) as usize]
                }
                if mode == 1 {
                    v = e[(7 - y) as usize]
                }
                if mode == 3 {
                    if x == 7 && y == 7 {
                        v = (e[(9 + 14) as usize] + 3 * e[(9 + 15) as usize] + 2) >> 2
                    } else {
                        v = (e[(9 + x + y) as usize] + 2 * e[(9 + x + y + 1) as usize] + e[(9 + x + y + 2) as usize] + 2) >> 2
                    }
                }
                if mode == 4 {
                    let c: i32 = 8 + x - y
                    v = (e[(c - 1) as usize] + 2 * e[c as usize] + e[(c + 1) as usize] + 2) >> 2
                }
                if mode == 5 {
                    let z: i32 = 2 * x - y
                    if z >= 0 {
                        let a: i32 = 8 + x - (y >> 1)
                        if (z & 1) == 0 {
                            v = (e[a as usize] + e[(a + 1) as usize] + 1) >> 1
                        } else {
                            v = (e[(a - 1) as usize] + 2 * e[a as usize] + e[(a + 1) as usize] + 2) >> 2
                        }
                    } else {
                        if z == -1 {
                            v = (e[7] + 2 * e[8] + e[9] + 2) >> 2
                        } else {
                            v = (e[(8 - y + 2 * x) as usize] + 2 * e[(9 - y + 2 * x) as usize] + e[(10 - y + 2 * x) as usize] + 2) >> 2
                        }
                    }
                }
                if mode == 6 {
                    let z2: i32 = 2 * y - x
                    if z2 >= 0 {
                        let b: i32 = 8 - y + (x >> 1)
                        if (z2 & 1) == 0 {
                            v = (e[b as usize] + e[(b - 1) as usize] + 1) >> 1
                        } else {
                            v = (e[(b + 1) as usize] + 2 * e[b as usize] + e[(b - 1) as usize] + 2) >> 2
                        }
                    } else {
                        if z2 == -1 {
                            v = (e[7] + 2 * e[8] + e[9] + 2) >> 2
                        } else {
                            v = (e[(8 + x - 2 * y) as usize] + 2 * e[(7 + x - 2 * y) as usize] + e[(6 + x - 2 * y) as usize] + 2) >> 2
                        }
                    }
                }
                if mode == 7 {
                    let a2: i32 = 9 + x + (y >> 1)
                    if (y & 1) == 0 {
                        v = (e[a2 as usize] + e[(a2 + 1) as usize] + 1) >> 1
                    } else {
                        v = (e[a2 as usize] + 2 * e[(a2 + 1) as usize] + e[(a2 + 2) as usize] + 2) >> 2
                    }
                }
                if mode == 8 {
                    let z3: i32 = x + 2 * y
                    let a3: i32 = y + (x >> 1)
                    if z3 > 13 {
                        v = l[7]
                    } else {
                        if z3 == 13 {
                            v = (l[6] + 3 * l[7] + 2) >> 2
                        } else {
                            if (z3 & 1) == 0 {
                                v = (l[a3 as usize] + l[(a3 + 1) as usize] + 1) >> 1
                            } else {
                                v = (l[a3 as usize] + 2 * l[(a3 + 1) as usize] + l[(a3 + 2) as usize] + 2) >> 2
                            }
                        }
                    }
                }
                out[(y * 8 + x) as usize] = v
                x = x + 1
            }
            y = y + 1
        }
    }
    y = 0
    while y < 8 {
        x = 0
        while x < 8 {
            raw.stb(dst, (y as usize) * stride + (x as usize), out[(y * 8 + x) as usize])
            x = x + 1
        }
        y = y + 1
    }
}

fn pred16x16(dst: u64, stride: usize, mode: i32, has_l: i32, has_t: i32, has_tl: i32) {
    let up: u64 = dst - stride as u64
    var x: usize = 0
    var y: usize = 0
    if mode == 0 {
        y = 0
        while y < 16 {
            rt.mem_copy(dst + (y * stride) as u64, up, 16)
            y = y + 1
        }
        return
    }
    if mode == 1 {
        y = 0
        while y < 16 {
            let row: u64 = dst + (y * stride) as u64
            let v: u8 = *((row - 1) as *mut u8)
            rt.mem_set(row, v, 16)
            y = y + 1
        }
        return
    }
    if mode == 2 {
        var st: i32 = 0
        var sl: i32 = 0
        x = 0
        while x < 16 {
            if has_t != 0 {
                st = st + raw.ldu8(up, x)
            }
            if has_l != 0 {
                sl = sl + raw.ldu8((dst + (x * stride) as u64) - 1, 0)
            }
            x = x + 1
        }
        var dc: i32 = 128
        if has_t != 0 && has_l != 0 {
            dc = (st + sl + 16) >> 5
        } else {
            if has_l != 0 {
                dc = (sl + 8) >> 4
            } else {
                if has_t != 0 {
                    dc = (st + 8) >> 4
                }
            }
        }
        y = 0
        while y < 16 {
            rt.mem_set(dst + (y * stride) as u64, dc as u8, 16)
            y = y + 1
        }
        return
    }
    var hh: i32 = 0
    var vv: i32 = 0
    var i: i32 = 0
    while i < 8 {
        let tr: i32 = raw.ldu8(up, (8 + i) as usize)
        var tlf: i32 = 0
        if 6 - i >= 0 {
            tlf = raw.ldu8(up, (6 - i) as usize)
        } else {
            tlf = raw.ldu8(up - 1, 0)
        }
        hh = hh + (i + 1) * (tr - tlf)
        let lb: i32 = raw.ldu8((dst + ((8 + i) as usize * stride) as u64) - 1, 0)
        var lt: i32 = 0
        if 6 - i >= 0 {
            lt = raw.ldu8((dst + ((6 - i) as usize * stride) as u64) - 1, 0)
        } else {
            lt = raw.ldu8(up - 1, 0)
        }
        vv = vv + (i + 1) * (lb - lt)
        i = i + 1
    }
    let a: i32 = 16 * (raw.ldu8((dst + (15 * stride) as u64) - 1, 0) + raw.ldu8(up, 15))
    let b: i32 = (5 * hh + 32) >> 6
    let c: i32 = (5 * vv + 32) >> 6
    y = 0
    while y < 16 {
        x = 0
        while x < 16 {
            let v: i32 = (a + b * ((x as i32) - 7) + c * ((y as i32) - 7) + 16) >> 5
            raw.stb(dst, y * stride + x, raw.clip255(v))
            x = x + 1
        }
        y = y + 1
    }
}

fn pred_chroma(dst: u64, stride: usize, mode: i32, has_l: i32, has_t: i32) {
    let up: u64 = dst - stride as u64
    var x: usize = 0
    var y: usize = 0
    if mode == 2 {
        y = 0
        while y < 8 {
            rt.mem_copy(dst + (y * stride) as u64, up, 8)
            y = y + 1
        }
        return
    }
    if mode == 1 {
        y = 0
        while y < 8 {
            let row: u64 = dst + (y * stride) as u64
            let v: u8 = *((row - 1) as *mut u8)
            rt.mem_set(row, v, 8)
            y = y + 1
        }
        return
    }
    if mode == 0 {
        var blk: usize = 0
        while blk < 4 {
            let bx: usize = (blk & 1) * 4
            let by: usize = (blk >> 1) * 4
            var st: i32 = 0
            var sl: i32 = 0
            x = 0
            while x < 4 {
                if has_t != 0 {
                    st = st + raw.ldu8(up, bx + x)
                }
                if has_l != 0 {
                    sl = sl + raw.ldu8((dst + ((by + x) * stride) as u64) - 1, 0)
                }
                x = x + 1
            }
            var dc: i32 = 128
            if blk == 0 || blk == 3 {
                if has_t != 0 && has_l != 0 {
                    dc = (st + sl + 4) >> 3
                } else {
                    if has_l != 0 {
                        dc = (sl + 2) >> 2
                    } else {
                        if has_t != 0 {
                            dc = (st + 2) >> 2
                        }
                    }
                }
            }
            if blk == 1 {
                if has_t != 0 {
                    dc = (st + 2) >> 2
                } else {
                    if has_l != 0 {
                        dc = (sl + 2) >> 2
                    }
                }
            }
            if blk == 2 {
                if has_l != 0 {
                    dc = (sl + 2) >> 2
                } else {
                    if has_t != 0 {
                        dc = (st + 2) >> 2
                    }
                }
            }
            y = 0
            while y < 4 {
                rt.mem_set(dst + ((by + y) * stride + bx) as u64, dc as u8, 4)
                y = y + 1
            }
            blk = blk + 1
        }
        return
    }
    var hh: i32 = 0
    var vv: i32 = 0
    var i: i32 = 0
    while i < 4 {
        let tr: i32 = raw.ldu8(up, (4 + i) as usize)
        var tlf: i32 = 0
        if 2 - i >= 0 {
            tlf = raw.ldu8(up, (2 - i) as usize)
        } else {
            tlf = raw.ldu8(up - 1, 0)
        }
        hh = hh + (i + 1) * (tr - tlf)
        let lb: i32 = raw.ldu8((dst + ((4 + i) as usize * stride) as u64) - 1, 0)
        var lt: i32 = 0
        if 2 - i >= 0 {
            lt = raw.ldu8((dst + ((2 - i) as usize * stride) as u64) - 1, 0)
        } else {
            lt = raw.ldu8(up - 1, 0)
        }
        vv = vv + (i + 1) * (lb - lt)
        i = i + 1
    }
    let a: i32 = 16 * (raw.ldu8((dst + (7 * stride) as u64) - 1, 0) + raw.ldu8(up, 7))
    let b: i32 = (34 * hh + 32) >> 6
    let c: i32 = (34 * vv + 32) >> 6
    y = 0
    while y < 8 {
        x = 0
        while x < 8 {
            let v: i32 = (a + b * ((x as i32) - 3) + c * ((y as i32) - 3) + 16) >> 5
            raw.stb(dst, y * stride + x, raw.clip255(v))
            x = x + 1
        }
        y = y + 1
    }
}
