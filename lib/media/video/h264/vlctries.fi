import media.video.h264.tables as h264_tables
import media.video.h264.bits as h264_bits
import media.video.h264.params
import media.video.h264.raw

export {
    build_tries, trie_sym,
}

fn trie_add(t: u64, base: usize, next: *mut i32, sym: usize, code: u32, len: u32) {
    if len == 0 {
        return
    }
    var node: i32 = 0
    var i: u32 = 0
    while i < len {
        let bit: u32 = (code >> (len - 1 - i)) & 1
        let slot: usize = base + (node as usize) * 2 + (bit as usize)
        if i == len - 1 {
            raw.sti32(t, slot, -((sym as i32) + 1))
        } else {
            var v: i32 = raw.ldi32(t, slot)
            if v <= 0 {
                v = *next
                *next = *next + 1
                raw.sti32(t, slot, v)
            }
            node = v
        }
        i = i + 1
    }
}

fn build_tries(d: *mut params.H264) {
    var total: usize = 0
    var k: usize = 0
    while k < 30 {
        var ncodes: usize = 70
        if k == 4 {
            ncodes = 20
        }
        if k >= 5 && k < 20 {
            ncodes = 16
        }
        if k >= 20 && k < 23 {
            ncodes = 4
        }
        if k >= 23 {
            ncodes = 16
        }
        (*d).trie_off[k] = total as i32
        total = total + 2 * (ncodes + 2)
        k = k + 1
    }
    (*d).trie = raw.heap_zero(total * 4 + 64)
    var next: i32 = 1
    var c: usize = 0
    while c < 4 {
        next = 1
        var i: usize = 0
        while i < 68 {
            trie_add((*d).trie, (*d).trie_off[c] as usize, &next, i,
                h264_tables.h264_coeff_token_bits(c * 68 + i) as u32, h264_tables.h264_coeff_token_len(c * 68 + i) as u32)
            i = i + 1
        }
        c = c + 1
    }
    next = 1
    var i2: usize = 0
    while i2 < 20 {
        trie_add((*d).trie, (*d).trie_off[4] as usize, &next, i2,
            h264_tables.h264_cdc_token_bits(i2) as u32, h264_tables.h264_cdc_token_len(i2) as u32)
        i2 = i2 + 1
    }
    var t: usize = 0
    while t < 15 {
        next = 1
        var z: usize = 0
        while z < 16 {
            trie_add((*d).trie, (*d).trie_off[5 + t] as usize, &next, z,
                h264_tables.h264_total_zeros_bits(t * 16 + z) as u32, h264_tables.h264_total_zeros_len(t * 16 + z) as u32)
            z = z + 1
        }
        t = t + 1
    }
    t = 0
    while t < 3 {
        next = 1
        var z2: usize = 0
        while z2 < 4 {
            trie_add((*d).trie, (*d).trie_off[20 + t] as usize, &next, z2,
                h264_tables.h264_cdc_zeros_bits(t * 4 + z2) as u32, h264_tables.h264_cdc_zeros_len(t * 4 + z2) as u32)
            z2 = z2 + 1
        }
        t = t + 1
    }
    t = 0
    while t < 7 {
        next = 1
        var r: usize = 0
        while r < 16 {
            trie_add((*d).trie, (*d).trie_off[23 + t] as usize, &next, r,
                h264_tables.h264_run_bits(t * 16 + r) as u32, h264_tables.h264_run_len(t * 16 + r) as u32)
            r = r + 1
        }
        t = t + 1
    }
}

fn trie_sym(d: *mut params.H264, k: usize) -> i32 {
    var node: i32 = 0
    let base: usize = (*d).trie_off[k] as usize
    var guard: i32 = 0
    var res: i32 = -1
    var go: i32 = 1
    while go != 0 {
        let bit: i32 = h264_bits.br_get1(&(*d).br)
        let v: i32 = raw.ldi32((*d).trie, base + (node as usize) * 2 + (bit as usize))
        if v < 0 {
            res = -(v + 1)
            go = 0
        } else {
            if v == 0 {
                go = 0
            } else {
                node = v
            }
        }
        guard = guard + 1
        if guard > 20 {
            go = 0
        }
    }
    return res
}
