import media.video.h264.params
import media.video.h264.raw
import media.video.h264.types

export {
    nb_get, pred_mv, pred_mv_core, pskip_mv, set_mv, set_ref,
}

fn nb_get(d: *mut params.H264, list: i32, bx: i32, by: i32, mv: u64) -> i32 {
    let mb: i32 = (*d).mb_addr
    raw.sti32(mv, 0, 0)
    raw.sti32(mv, 1, 0)
    let cur: *mut types.Pic = &(*d).dpb[(*d).cur as usize]
    var nmb: i32 = mb
    var nbx: i32 = bx
    var nby: i32 = by
    if bx >= 0 && bx < 4 && by >= 0 && by < 4 {
        if ((*d).done[list as usize] & (1 << ((by * 4 + bx) as u32))) == 0 {
            return -2
        }
    } else {
        var dx: i32 = 0
        var dy: i32 = 0
        if bx < 0 {
            dx = -1
        }
        if bx >= 4 {
            dx = 1
        }
        if by < 0 {
            dy = -1
        }
        if by >= 4 {
            return -2
        }
        if dx > 0 && dy == 0 {
            return -2
        }
        let nx: i32 = (*d).mb_x + dx
        let ny: i32 = (*d).mb_y + dy
        if nx < 0 || nx >= (*d).mb_w || ny < 0 {
            return -2
        }
        nmb = mb + dy * (*d).mb_w + dx
        if raw.ldi32((*d).mbslice, nmb as usize) != (*d).cur_slice {
            return -2
        }
        nbx = (bx + 4) & 3
        nby = (by + 4) & 3
    }
    let r: i32 = raw.ldi8((*d).refidx, (nmb * 8 + list * 4 + (nby >> 1) * 2 + (nbx >> 1)) as usize)
    if r < 0 {
        return -1
    }
    let o: usize = (((list * (*d).mbs + nmb) * 16 + nby * 4 + nbx) * 2) as usize
    raw.sti32(mv, 0, raw.ldi16((*cur).mv, o))
    raw.sti32(mv, 1, raw.ldi16((*cur).mv, o + 1))
    return r
}

fn pred_mv(d: *mut params.H264, list: i32, bx: i32, by: i32, bw: i32, rf: i32, shape: i32, out: u64) {
    var m: [i32; 8] = [0; 8]
    let ma: u64 = (&m[0]) as u64
    let mbp: u64 = (&m[2]) as u64
    let mc: u64 = (&m[4]) as u64
    let ra: i32 = nb_get(d, list, bx - 1, by, ma)
    let rb: i32 = nb_get(d, list, bx, by - 1, mbp)
    var rc: i32 = nb_get(d, list, bx + bw, by - 1, mc)
    if rc == -2 {
        rc = nb_get(d, list, bx - 1, by - 1, mc)
    }
    pred_mv_core(ra, rb, rc, ma, rf, shape, out)
}

fn pred_mv_core(ra: i32, rb: i32, rc: i32, m: u64, rf: i32, shape: i32, out: u64) {
    if shape == 1 {
        if rb == rf {
            raw.sti32(out, 0, raw.ldi32(m, 2))
            raw.sti32(out, 1, raw.ldi32(m, 3))
            return
        }
    }
    if shape == 2 {
        if ra == rf {
            raw.sti32(out, 0, raw.ldi32(m, 0))
            raw.sti32(out, 1, raw.ldi32(m, 1))
            return
        }
    }
    if shape == 3 {
        if ra == rf {
            raw.sti32(out, 0, raw.ldi32(m, 0))
            raw.sti32(out, 1, raw.ldi32(m, 1))
            return
        }
    }
    if shape == 4 {
        if rc == rf {
            raw.sti32(out, 0, raw.ldi32(m, 4))
            raw.sti32(out, 1, raw.ldi32(m, 5))
            return
        }
    }
    if rb == -2 && rc == -2 && ra != -2 {
        raw.sti32(out, 0, raw.ldi32(m, 0))
        raw.sti32(out, 1, raw.ldi32(m, 1))
        return
    }
    var cnt: i32 = 0
    var which: i32 = 0
    if ra == rf {
        cnt = cnt + 1
        which = 0
    }
    if rb == rf {
        cnt = cnt + 1
        which = 1
    }
    if rc == rf {
        cnt = cnt + 1
        which = 2
    }
    if cnt == 1 {
        raw.sti32(out, 0, raw.ldi32(m, (which * 2) as usize))
        raw.sti32(out, 1, raw.ldi32(m, (which * 2 + 1) as usize))
        return
    }
    raw.sti32(out, 0, raw.median3(raw.ldi32(m, 0), raw.ldi32(m, 2), raw.ldi32(m, 4)))
    raw.sti32(out, 1, raw.median3(raw.ldi32(m, 1), raw.ldi32(m, 3), raw.ldi32(m, 5)))
}

fn set_mv(d: *mut params.H264, list: i32, bx: i32, by: i32, bw: i32, bh: i32, mvx: i32, mvy: i32) {
    let cur: *mut types.Pic = &(*d).dpb[(*d).cur as usize]
    let mb: i32 = (*d).mb_addr
    let pk: u32 = ((mvx & 0xFFFF) as u32) | (((mvy & 0xFFFF) as u32) << 16)
    let basep: u64 = (*cur).mv + ((((list * (*d).mbs + mb) * 16) as usize) * 4) as u64
    let rm: i32 = ((1 << (bw as u32)) - 1) << (bx as u32)
    var mask: i32 = 0
    var y: i32 = 0
    if (bw & 1) == 0 && (bx & 1) == 0 {
        let pk2: u64 = (pk as u64) | ((pk as u64) << 32)
        let nw: i32 = bw >> 1
        while y < bh {
            let rp: u64 = basep + ((((by + y) * 4 + bx) as usize) * 4) as u64
            *(rp as *mut u64) = pk2
            if nw == 2 {
                *((rp + 8) as *mut u64) = pk2
            }
            mask = mask | (rm << (((by + y) * 4) as u32))
            y = y + 1
        }
    } else {
        while y < bh {
            let rp: u64 = basep + ((((by + y) * 4 + bx) as usize) * 4) as u64
            var x: i32 = 0
            while x < bw {
                *((rp + ((x as usize) * 4) as u64) as *mut u32) = pk
                x = x + 1
            }
            mask = mask | (rm << (((by + y) * 4) as u32))
            y = y + 1
        }
    }
    (*d).done[list as usize] = (*d).done[list as usize] | mask
}

fn set_ref(d: *mut params.H264, list: i32, b8: i32, rf: i32) {
    let cur: *mut types.Pic = &(*d).dpb[(*d).cur as usize]
    let mb: i32 = (*d).mb_addr
    raw.stbs((*d).refidx, (mb * 8 + list * 4 + b8) as usize, rf)
    var id: i32 = -1
    if rf >= 0 {
        id = (*d).ref_id[(list * 32 + rf) as usize] & 0x7FFF
    }
    raw.sti16((*cur).refid, ((list * (*d).mbs + mb) * 4 + b8) as usize, id)
    raw.stbs((*cur).refix, ((list * (*d).mbs + mb) * 4 + b8) as usize, rf)
}

fn pskip_mv(d: *mut params.H264, out: u64) {
    var m: [i32; 4] = [0; 4]
    let ra: i32 = nb_get(d, 0, -1, 0, (&m[0]) as u64)
    let rb: i32 = nb_get(d, 0, 0, -1, (&m[2]) as u64)
    raw.sti32(out, 0, 0)
    raw.sti32(out, 1, 0)
    if ra == -2 || rb == -2 {
        return
    }
    if ra == 0 && m[0] == 0 && m[1] == 0 {
        return
    }
    if rb == 0 && m[2] == 0 && m[3] == 0 {
        return
    }
    pred_mv(d, 0, 0, 0, 4, 0, 0, out)
}
