// SPDX-License-Identifier: MPL-2.0
import media.video.h264.raw
import media.video.h264.types

export {
    br_bits, br_get, br_get1, br_left, br_more_rbsp, br_se, br_ue,
}

fn br_get(b: *mut types.Br, n: i32) -> u32 {
    if n > 32 {
        return br_get(b, n - 32)
    }
    let pos: i32 = (*b).pos
    if pos > (*b).end + 100000 {
        return 0
    }
    (*b).pos = pos + n
    var r: u64 = 0
    if n != 0 {
        if pos + n <= (*b).end {
            let sh: i32 = pos & 7
            let p: u64 = (*b).buf + ((pos >> 3) as u64)
            let need: i32 = sh + n
            var v: u64 = (raw.ldu8(p, 0) as u64) << 32
            if need > 8 {
                v = v | ((raw.ldu8(p, 1) as u64) << 24)
            }
            if need > 16 {
                v = v | ((raw.ldu8(p, 2) as u64) << 16)
            }
            if need > 24 {
                v = v | ((raw.ldu8(p, 3) as u64) << 8)
            }
            if need > 32 {
                v = v | (raw.ldu8(p, 4) as u64)
            }
            r = (v >> ((40 - need) as u64)) & ((1 << (n as u64)) - 1)
        }
    }
    return r as u32
}

fn br_get1(b: *mut types.Br) -> i32 {
    return br_get(b, 1) as i32
}

fn br_bits(b: *mut types.Br, n: i32) -> i32 {
    return br_get(b, n) as i32
}

fn br_show(b: *mut types.Br, n: i32) -> i32 {
    let save: i32 = (*b).pos
    let v: u32 = br_get(b, n)
    (*b).pos = save
    return v as i32
}

fn br_left(b: *mut types.Br) -> i32 {
    return (*b).end - (*b).pos
}

fn br_ue(b: *mut types.Br) -> i32 {
    var zeros: i32 = 0
    var go: i32 = 1
    while go != 0 {
        if br_left(b) <= 0 {
            go = 0
            zeros = 32
        } else {
            if br_get1(b) != 0 {
                go = 0
            } else {
                zeros = zeros + 1
                if zeros >= 32 {
                    go = 0
                }
            }
        }
    }
    if zeros >= 24 {
        return 0
    }
    if zeros == 0 {
        return 0
    }
    let v: u32 = br_get(b, zeros)
    return ((1 << (zeros as u32)) - 1 + v) as i32
}

fn br_se(b: *mut types.Br) -> i32 {
    let k: i32 = br_ue(b)
    if (k & 1) != 0 {
        return (k + 1) >> 1
    }
    return 0 - (k >> 1)
}

fn br_more_rbsp(b: *mut types.Br) -> i32 {
    if (*b).pos >= (*b).end {
        return 0
    }
    var last: i32 = (*b).end - 1
    var go: i32 = 1
    while go != 0 {
        if last < (*b).pos {
            return 0
        }
        let byte: i32 = raw.ldu8((*b).buf, (last >> 3) as usize)
        if ((byte >> (7 - (last & 7))) & 1) != 0 {
            go = 0
        } else {
            last = last - 1
        }
    }
    if (*b).pos < last {
        return 1
    }
    return 0
}
