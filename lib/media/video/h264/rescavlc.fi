import media.video.h264.tables as h264_tables
import media.video.h264.cavlc
import media.video.h264.params
import media.video.h264.raw
import media.video.h264.transform

export {
    residual_chroma_cavlc, residual_luma_cavlc,
}

fn tclass_of(nc: i32) -> i32 {
    return 0
}

fn residual_luma_cavlc(d: *mut params.H264, mb: i32, kind: i32, cbp: i32, qp: i32, intra: i32, av_a: i32, av_b: i32) -> i32 {
    let coef: u64 = (*d).coef
    let lv: u64 = coef + 420 * 4
    var dq4l: i32 = 0
    var dq8l: i32 = 0
    if intra == 0 {
        dq4l = 3
        dq8l = 1
    }
    let dq4: u64 = (*d).dq4 + (((dq4l * 52 + qp) * 16) as usize * 4) as u64
    if kind == 1 {
        let nc: i32 = cavlc.nc_luma(d, mb, 0, 0, av_a, av_b)
        let tc: i32 = cavlc.cavlc_block(d, 0, nc, 16, lv)
        if tc < 0 {
            return -1
        }
        let dcl: u64 = coef + 384 * 4
        var k: usize = 0
        while k < 16 {
            raw.sti32(dcl, k, 0)
            k = k + 1
        }
        k = 0
        while k < 16 {
            raw.sti32(dcl, h264_tables.h264_zz4(k) as usize, raw.ldi32(lv, k))
            k = k + 1
        }
        if tc > 0 {
            transform.luma_dc_dequant(coef, dcl, qp, (*d).dq4 + (((dq4l * 52) * 16) as usize * 4) as u64)
        }
        if tc > 0 {
            raw.stb((*d).cbfdc, mb as usize, raw.ldu8((*d).cbfdc, mb as usize) | 1)
        }
    }
    if kind == 2 {
        var q: i32 = 0
        while q < 4 {
            if (cbp & (1 << (q as u32))) != 0 {
                let l8: u64 = coef + 440 * 4
                var z: usize = 0
                while z < 64 {
                    raw.sti32(l8, z, 0)
                    z = z + 1
                }
                var s: i32 = 0
                while s < 4 {
                    let blk: i32 = q * 4 + s
                    let bx: i32 = cavlc.blk_x(blk)
                    let by: i32 = cavlc.blk_y(blk)
                    let nc: i32 = cavlc.nc_luma(d, mb, bx, by, av_a, av_b)
                    let tc: i32 = cavlc.cavlc_block(d, 0, nc, 16, lv)
                    if tc < 0 {
                        return -1
                    }
                    raw.stb((*d).nnz, (mb * 24 + by * 4 + bx) as usize, tc)
                    var k2: usize = 0
                    while k2 < 16 {
                        raw.sti32(l8, 4 * k2 + (s as usize), raw.ldi32(lv, k2))
                        k2 = k2 + 1
                    }
                    s = s + 1
                }
                let dq8: u64 = (*d).dq8 + (((dq8l * 52 + qp) * 64) as usize * 4) as u64
                var i: usize = 0
                while i < 64 {
                    let lvl: i32 = raw.ldi32(l8, i)
                    if lvl != 0 {
                        let pos: usize = h264_tables.h264_zz8(i) as usize
                        raw.sti32(coef, (q as usize) * 64 + pos, (lvl * raw.ldi32(dq8, pos) + 32) >> 6)
                    }
                    i = i + 1
                }
            }
            q = q + 1
        }
        return 0
    }
    var blk2: i32 = 0
    while blk2 < 16 {
        if (cbp & (1 << ((blk2 >> 2) as u32))) != 0 {
            let bx2: i32 = cavlc.blk_x(blk2)
            let by2: i32 = cavlc.blk_y(blk2)
            let nc2: i32 = cavlc.nc_luma(d, mb, bx2, by2, av_a, av_b)
            var maxn: i32 = 16
            if kind == 1 {
                maxn = 15
            }
            let tc2: i32 = cavlc.cavlc_block(d, 0, nc2, maxn, lv)
            if tc2 < 0 {
                return -1
            }
            raw.stb((*d).nnz, (mb * 24 + by2 * 4 + bx2) as usize, tc2)
            if tc2 > 0 {
                let bi: usize = (by2 * 4 + bx2) as usize
                var k3: usize = 0
                while k3 < (maxn as usize) {
                    let lvl2: i32 = raw.ldi32(lv, k3)
                    if lvl2 != 0 {
                        var si: usize = k3
                        if kind == 1 {
                            si = k3 + 1
                        }
                        let pos2: usize = h264_tables.h264_zz4(si) as usize
                        raw.sti32(coef, bi * 16 + pos2, (lvl2 * raw.ldi32(dq4, pos2) + 8) >> 4)
                    }
                    k3 = k3 + 1
                }
            }
        }
        blk2 = blk2 + 1
    }
    return 0
}

fn residual_chroma_cavlc(d: *mut params.H264, mb: i32, cbpc: i32, qpcb: i32, qpcr: i32, intra: i32, av_a: i32, av_b: i32) -> i32 {
    if cbpc == 0 {
        return 0
    }
    let coef: u64 = (*d).coef
    let lv: u64 = coef + 420 * 4
    var comp: i32 = 0
    while comp < 2 {
        var qpc: i32 = qpcb
        if comp == 1 {
            qpc = qpcr
        }
        var list: i32 = 1 + comp
        if intra == 0 {
            list = 4 + comp
        }
        let tc: i32 = cavlc.cavlc_block(d, 4, -1, 4, lv)
        if tc < 0 {
            return -1
        }
        if tc > 0 {
            transform.chroma_dc_dequant(coef, (256 + comp * 64) as usize, lv, qpc, (*d).dq4 + (((list * 52) * 16) as usize * 4) as u64)
            raw.stb((*d).cbfdc, mb as usize, raw.ldu8((*d).cbfdc, mb as usize) | (2 << (comp as u32)))
        }
        comp = comp + 1
    }
    if cbpc == 2 {
        comp = 0
        while comp < 2 {
            var qpc2: i32 = qpcb
            if comp == 1 {
                qpc2 = qpcr
            }
            var list2: i32 = 1 + comp
            if intra == 0 {
                list2 = 4 + comp
            }
            let dq: u64 = (*d).dq4 + (((list2 * 52 + qpc2) * 16) as usize * 4) as u64
            var b: i32 = 0
            while b < 4 {
                let nc: i32 = cavlc.nc_chroma(d, mb, comp, b & 1, b >> 1, av_a, av_b)
                let tc2: i32 = cavlc.cavlc_block(d, 0, nc, 15, lv)
                if tc2 < 0 {
                    return -1
                }
                raw.stb((*d).nnz, (mb * 24 + 16 + comp * 4 + b) as usize, tc2)
                if tc2 > 0 {
                    var k: usize = 0
                    while k < 15 {
                        let lvl: i32 = raw.ldi32(lv, k)
                        if lvl != 0 {
                            let pos: usize = h264_tables.h264_zz4(k + 1) as usize
                            raw.sti32(coef, (256 + comp * 64 + b * 16) as usize + pos, (lvl * raw.ldi32(dq, pos) + 8) >> 4)
                        }
                        k = k + 1
                    }
                }
                b = b + 1
            }
            comp = comp + 1
        }
    }
    return 0
}
