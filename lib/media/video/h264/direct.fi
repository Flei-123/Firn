import media.video.h264.mvpred
import media.video.h264.params
import media.video.h264.raw
import media.video.h264.types

export {
    commit_direct, direct_derive, direct_spatial,
}

fn col_info(d: *mut params.H264, cp: *mut types.Pic, mb: i32, bx: i32, by: i32, out: u64, idp: *mut i32) -> i32 {
    let b8: i32 = (by >> 1) * 2 + (bx >> 1)
    let mbs: i32 = (*d).mbs
    var list: i32 = 0
    var r: i32 = raw.ldi8((*cp).refix, (mb * 4 + b8) as usize)
    if r < 0 {
        list = 1
        r = raw.ldi8((*cp).refix, ((mbs + mb) * 4 + b8) as usize)
    }
    if r < 0 {
        raw.sti32(out, 0, 0)
        raw.sti32(out, 1, 0)
        *idp = -1
        return -1
    }
    let o: usize = (((list * mbs + mb) * 16 + by * 4 + bx) * 2) as usize
    raw.sti32(out, 0, raw.ldi16((*cp).mv, o))
    raw.sti32(out, 1, raw.ldi16((*cp).mv, o + 1))
    *idp = raw.ldi16((*cp).refid, ((list * mbs + mb) * 4 + b8) as usize)
    return r
}

fn min_positive(a: i32, b: i32) -> i32 {
    if a >= 0 && b >= 0 {
        return raw.imin(a, b)
    }
    return raw.imax(a, b)
}

fn direct_spatial(d: *mut params.H264, mb: i32, mask8: i32) {
    var rf: [i32; 2] = [-1; 2]
    var list: i32 = 0
    var mvbuf: [i32; 12] = [0; 12]
    var nbr: [i32; 6] = [0; 6]
    while list < 2 {
        let mo: usize = (list * 6) as usize
        let ra: i32 = mvpred.nb_get(d, list, -1, 0, (&mvbuf[mo]) as u64)
        let rb: i32 = mvpred.nb_get(d, list, 0, -1, (&mvbuf[mo + 2]) as u64)
        var rc: i32 = mvpred.nb_get(d, list, 4, -1, (&mvbuf[mo + 4]) as u64)
        if rc == -2 {
            rc = mvpred.nb_get(d, list, -1, -1, (&mvbuf[mo + 4]) as u64)
        }
        nbr[(list * 3) as usize] = ra
        nbr[(list * 3 + 1) as usize] = rb
        nbr[(list * 3 + 2) as usize] = rc
        var a: i32 = ra
        var b: i32 = rb
        var c: i32 = rc
        if a < 0 {
            a = -1
        }
        if b < 0 {
            b = -1
        }
        if c < 0 {
            c = -1
        }
        rf[list as usize] = min_positive(a, min_positive(b, c))
        list = list + 1
    }
    var zero_pred: i32 = 0
    if rf[0] < 0 && rf[1] < 0 {
        rf[0] = 0
        rf[1] = 0
        zero_pred = 1
    }
    var mvp: [i32; 4] = [0; 4]
    list = 0
    while list < 2 {
        if rf[list as usize] >= 0 && zero_pred == 0 {
            mvpred.pred_mv_core(nbr[(list * 3) as usize], nbr[(list * 3 + 1) as usize], nbr[(list * 3 + 2) as usize], (&mvbuf[(list * 6) as usize]) as u64, rf[list as usize], 0, (&mvp[(list * 2) as usize]) as u64)
        }
        list = list + 1
    }
    let colpi: i32 = (*d).ref_pic[32]
    var cp: *mut types.Pic = &(*d).dpb[0]
    var have_col: i32 = 0
    if colpi >= 0 {
        cp = &(*d).dpb[colpi as usize]
        have_col = 1
    }
    let col_short: i32 = 1 - (*d).ref_long[32]
    let inference: i32 = (*d).sps[(*d).active as usize].direct8x8
    var q: i32 = 0
    while q < 4 {
        if ((mask8 >> (q as u32)) & 1) != 0 {
            mvpred.set_ref(d, 0, q, rf[0])
            mvpred.set_ref(d, 1, q, rf[1])
            var k: i32 = 0
            var colzero: i32 = 0
            if inference != 0 {
                if have_col != 0 && col_short != 0 && zero_pred == 0 {
                    var cm: [i32; 2] = [0; 2]
                    var cid: i32 = 0
                    let cr: i32 = col_info(d, cp, mb, (q & 1) * 3, (q >> 1) * 3, (&cm[0]) as u64, &cid)
                    if cr == 0 && cm[0] >= -1 && cm[0] <= 1 && cm[1] >= -1 && cm[1] <= 1 {
                        colzero = 1
                    }
                }
                let b0: i32 = (q >> 1) * 8 + (q & 1) * 2
                var l: i32 = 0
                while l < 2 {
                    var mx: i32 = 0
                    var my: i32 = 0
                    if rf[l as usize] >= 0 && zero_pred == 0 && !(rf[l as usize] == 0 && colzero != 0) {
                        mx = mvp[(l * 2) as usize]
                        my = mvp[(l * 2 + 1) as usize]
                    }
                    let o: usize = ((l * 16 + b0) * 2) as usize
                    (*d).dmv[o] = mx
                    (*d).dmv[o + 1] = my
                    (*d).dmv[o + 2] = mx
                    (*d).dmv[o + 3] = my
                    (*d).dmv[o + 8] = mx
                    (*d).dmv[o + 9] = my
                    (*d).dmv[o + 10] = mx
                    (*d).dmv[o + 11] = my
                    l = l + 1
                }
                k = 4
            }
            while k < 4 {
                let bx: i32 = (q & 1) * 2 + (k & 1)
                let by: i32 = (q >> 1) * 2 + (k >> 1)
                var cbx: i32 = bx
                var cby: i32 = by
                if inference != 0 {
                    cbx = (q & 1) * 3
                    cby = (q >> 1) * 3
                }
                if (k == 0 || inference == 0) && have_col != 0 && col_short != 0 && zero_pred == 0 {
                    colzero = 0
                    var cm: [i32; 2] = [0; 2]
                    var cid: i32 = 0
                    let cr: i32 = col_info(d, cp, mb, cbx, cby, (&cm[0]) as u64, &cid)
                    if cr == 0 && cm[0] >= -1 && cm[0] <= 1 && cm[1] >= -1 && cm[1] <= 1 {
                        colzero = 1
                    }
                }
                var l: i32 = 0
                while l < 2 {
                    var mx: i32 = 0
                    var my: i32 = 0
                    if rf[l as usize] >= 0 && zero_pred == 0 {
                        if rf[l as usize] == 0 && colzero != 0 {
                            mx = 0
                            my = 0
                        } else {
                            mx = mvp[(l * 2) as usize]
                            my = mvp[(l * 2 + 1) as usize]
                        }
                    }
                    (*d).dmv[((l * 16 + by * 4 + bx) * 2) as usize] = mx
                    (*d).dmv[((l * 16 + by * 4 + bx) * 2 + 1) as usize] = my
                    l = l + 1
                }
                k = k + 1
            }
        }
        q = q + 1
    }
}

fn direct_temporal(d: *mut params.H264, mb: i32, mask8: i32) {
    let colpi: i32 = (*d).ref_pic[32]
    let inference: i32 = (*d).sps[(*d).active as usize].direct8x8
    var q: i32 = 0
    while q < 4 {
        if ((mask8 >> (q as u32)) & 1) != 0 {
            var r0: i32 = 0
            var k: i32 = 0
            while k < 4 {
                let bx: i32 = (q & 1) * 2 + (k & 1)
                let by: i32 = (q >> 1) * 2 + (k >> 1)
                var cbx: i32 = bx
                var cby: i32 = by
                if inference != 0 {
                    cbx = (q & 1) * 3
                    cby = (q >> 1) * 3
                }
                var cm: [i32; 2] = [0; 2]
                var cid: i32 = -1
                var cr: i32 = -1
                if colpi >= 0 {
                    cr = col_info(d, &(*d).dpb[colpi as usize], mb, cbx, cby, (&cm[0]) as u64, &cid)
                }
                var ref0: i32 = 0
                if cr >= 0 {
                    var i: i32 = 0
                    ref0 = 0
                    var found: i32 = 0
                    while i < (*d).ref_n[0] && found == 0 {
                        if ((*d).ref_id[i as usize] & 0x7FFF) == cid {
                            ref0 = i
                            found = 1
                        }
                        i = i + 1
                    }
                }
                if k == 0 {
                    r0 = ref0
                }
                var mx0: i32 = cm[0]
                var my0: i32 = cm[1]
                var mx1: i32 = 0
                var my1: i32 = 0
                let poc0: i32 = (*d).ref_poc[ref0 as usize]
                let poc1: i32 = (*d).ref_poc[32]
                let tb: i32 = raw.clip3(-128, 127, (*d).poc - poc0)
                let td: i32 = raw.clip3(-128, 127, poc1 - poc0)
                if (*d).ref_long[ref0 as usize] != 0 || td == 0 {
                } else {
                    let tx: i32 = (16384 + raw.iabs(td / 2)) / td
                    let dsf: i32 = raw.clip3(-1024, 1023, (tb * tx + 32) >> 6)
                    mx0 = (dsf * cm[0] + 128) >> 8
                    my0 = (dsf * cm[1] + 128) >> 8
                    mx1 = mx0 - cm[0]
                    my1 = my0 - cm[1]
                }
                (*d).dmv[((by * 4 + bx) * 2) as usize] = mx0
                (*d).dmv[((by * 4 + bx) * 2 + 1) as usize] = my0
                (*d).dmv[((16 + by * 4 + bx) * 2) as usize] = mx1
                (*d).dmv[((16 + by * 4 + bx) * 2 + 1) as usize] = my1
                k = k + 1
            }
            mvpred.set_ref(d, 0, q, r0)
            mvpred.set_ref(d, 1, q, 0)
        }
        q = q + 1
    }
}

fn direct_derive(d: *mut params.H264, mb: i32, mask8: i32) {
    if (*d).sh.direct_spatial != 0 {
        direct_spatial(d, mb, mask8)
    } else {
        direct_temporal(d, mb, mask8)
    }
}

fn commit_direct(d: *mut params.H264, q: i32, l: i32) {
    let x0: i32 = (q & 1) * 2
    let y0: i32 = (q >> 1) * 2
    let used: bool = raw.ldi8((*d).refidx, ((*d).mb_addr * 8 + l * 4 + q) as usize) >= 0
    let i0: usize = ((l * 16 + y0 * 4 + x0) * 2) as usize
    let i1: usize = i0 + 2
    let i2: usize = i0 + 8
    let i3: usize = i0 + 10
    let m0x: i32 = (*d).dmv[i0]
    let m0y: i32 = (*d).dmv[i0 + 1]
    if !used {
        mvpred.set_mv(d, l, x0, y0, 2, 2, 0, 0)
        return
    }
    if (*d).dmv[i1] == m0x && (*d).dmv[i1 + 1] == m0y && (*d).dmv[i2] == m0x && (*d).dmv[i2 + 1] == m0y && (*d).dmv[i3] == m0x && (*d).dmv[i3 + 1] == m0y {
        mvpred.set_mv(d, l, x0, y0, 2, 2, m0x, m0y)
        return
    }
    var k: i32 = 0
    while k < 4 {
        let bx: i32 = x0 + (k & 1)
        let by: i32 = y0 + (k >> 1)
        mvpred.set_mv(d, l, bx, by, 1, 1, (*d).dmv[((l * 16 + by * 4 + bx) * 2) as usize], (*d).dmv[((l * 16 + by * 4 + bx) * 2 + 1) as usize])
        k = k + 1
    }
}
