import std.rt
import media.video.h264.tables as h264_tables
import media.video.h264.bits as h264_bits
import media.video.h264.cabac as h264_cabac
import media.video.h264.cabacres
import media.video.h264.cabacsyn
import media.video.h264.cavlc
import media.video.h264.direct
import media.video.h264.intermb
import media.video.h264.intersyn
import media.video.h264.intramb
import media.video.h264.mvpred
import media.video.h264.params
import media.video.h264.raw
import media.video.h264.rescavlc
import media.video.h264.types

export {
    decode_bskip_mb, decode_inter_mb, decode_pskip_mb, h264_size,
}

fn decode_pskip_mb(d: *mut params.H264, mb: i32) -> i32 {
    intramb.start_mb(d, mb)
    let cur: *mut types.Pic = &(*d).dpb[(*d).cur as usize]
    raw.stb((*d).mbt, mb as usize, types.MB_P)
    raw.stb((*d).mbf, mb as usize, 1 | 8)
    raw.stb((*cur).intra, mb as usize, 0)
    (*d).done[0] = 0
    (*d).done[1] = 0
    var m: [i32; 2] = [0; 2]
    mvpred.pskip_mv(d, (&m[0]) as u64)
    var b8: i32 = 0
    while b8 < 4 {
        mvpred.set_ref(d, 0, b8, 0)
        b8 = b8 + 1
    }
    mvpred.set_mv(d, 0, 0, 0, 4, 4, m[0], m[1])
    (*d).pmode = 0
    raw.stb((*d).mbqp, mb as usize, (*d).qp)
    (*d).last_dqp = 0
    intermb.mc_inter_mb(d, mb)
    return 0
}

fn decode_bskip_mb(d: *mut params.H264, mb: i32) -> i32 {
    intramb.start_mb(d, mb)
    let cur: *mut types.Pic = &(*d).dpb[(*d).cur as usize]
    raw.stb((*d).mbt, mb as usize, types.MB_B)
    raw.stb((*d).mbf, mb as usize, 3)
    raw.stb((*cur).intra, mb as usize, 0)
    (*d).done[0] = 0
    (*d).done[1] = 0
    direct.direct_derive(d, mb, 15)
    let inference: i32 = (*d).sps[(*d).active as usize].direct8x8
    var q: i32 = 0
    while q < 4 {
        direct.commit_direct(d, q, 0)
        direct.commit_direct(d, q, 1)
        if inference != 0 {
            (*d).sub_shape[q as usize] = 0
        } else {
            (*d).sub_shape[q as usize] = 3
        }
        q = q + 1
    }
    (*d).pmode = 3
    raw.stb((*d).mbqp, mb as usize, (*d).qp)
    (*d).last_dqp = 0
    intermb.mc_inter_mb(d, mb)
    return 0
}

fn b_part_mask(t: i32, which: i32) -> i32 {
    let k: i32 = (t - 4) >> 1
    var m0: i32 = 1
    var m1: i32 = 1
    if k == 1 {
        m0 = 2
        m1 = 2
    }
    if k == 2 {
        m0 = 1
        m1 = 2
    }
    if k == 3 {
        m0 = 2
        m1 = 1
    }
    if k == 4 {
        m0 = 1
        m1 = 3
    }
    if k == 5 {
        m0 = 2
        m1 = 3
    }
    if k == 6 {
        m0 = 3
        m1 = 1
    }
    if k == 7 {
        m0 = 3
        m1 = 2
    }
    if k == 8 {
        m0 = 3
        m1 = 3
    }
    if which == 0 {
        return m0
    }
    return m1
}

fn sub_info(b: i32, t: i32, shape: *mut i32, mask: *mut i32) {
    if b == 0 {
        *shape = t
        *mask = 1
        return
    }
    var sh: i32 = 0
    var m: i32 = 0
    if t == 0 {
        sh = 0
        m = 0
    }
    if t == 1 {
        m = 1
    }
    if t == 2 {
        m = 2
    }
    if t == 3 {
        m = 3
    }
    if t == 4 {
        sh = 1
        m = 1
    }
    if t == 5 {
        sh = 2
        m = 1
    }
    if t == 6 {
        sh = 1
        m = 2
    }
    if t == 7 {
        sh = 2
        m = 2
    }
    if t == 8 {
        sh = 1
        m = 3
    }
    if t == 9 {
        sh = 2
        m = 3
    }
    if t == 10 {
        sh = 3
        m = 1
    }
    if t == 11 {
        sh = 3
        m = 2
    }
    if t == 12 {
        sh = 3
        m = 3
    }
    *shape = sh
    *mask = m
}

fn part_b8_mask(pm: i32, p: i32) -> i32 {
    if pm == 0 {
        return 15
    }
    if pm == 1 {
        if p == 0 {
            return 3
        }
        return 12
    }
    if p == 0 {
        return 5
    }
    return 10
}

fn read_one_mv(d: *mut params.H264, list: i32, bx: i32, by: i32, bw: i32, bh: i32, rf: i32, shape: i32) {
    let mx: i32 = intersyn.read_mvd(d, list, bx, by, 0)
    let my: i32 = intersyn.read_mvd(d, list, bx, by, 1)
    var pr: [i32; 2] = [0; 2]
    mvpred.pred_mv(d, list, bx, by, bw, rf, shape, (&pr[0]) as u64)
    intersyn.store_mvd(d, list, bx, by, bw, bh, mx, my)
    mvpred.set_mv(d, list, bx, by, bw, bh, pr[0] + mx, pr[1] + my)
}

fn decode_inter_mb(d: *mut params.H264, mb: i32, mt: i32, av_a: i32, av_b: i32, av_c: i32, av_d: i32) -> i32 {
    let sh: *mut types.Sh = &(*d).sh
    let pps: *mut types.Pps = &(*d).pps[(*sh).pps_id as usize]
    let cabac: i32 = (*pps).cabac
    var isb: i32 = 0
    if (*sh).slice_type == types.ST_B {
        isb = 1
    }
    let cur: *mut types.Pic = &(*d).dpb[(*d).cur as usize]
    raw.stb((*cur).intra, mb as usize, 0)
    if isb != 0 {
        raw.stb((*d).mbt, mb as usize, types.MB_B)
    } else {
        raw.stb((*d).mbt, mb as usize, types.MB_P)
    }
    (*d).done[0] = 0
    (*d).done[1] = 0
    var pm: i32 = 0
    var masks: [i32; 2] = [1, 1]
    var smask: [i32; 4] = [1; 4]
    var allow_t8: i32 = 1
    (*d).sub_direct[0] = 0
    (*d).sub_direct[1] = 0
    (*d).sub_direct[2] = 0
    (*d).sub_direct[3] = 0
    var p8ref0: i32 = 0
    if isb == 0 {
        if mt == 0 {
            pm = 0
        }
        if mt == 1 {
            pm = 1
        }
        if mt == 2 {
            pm = 2
        }
        if mt >= 3 {
            pm = 3
        }
        if mt == 4 {
            p8ref0 = 1
        }
    } else {
        if mt == 0 {
            pm = 3
        }
        if mt >= 1 && mt <= 3 {
            pm = 0
            masks[0] = mt
        }
        if mt >= 4 && mt <= 21 {
            pm = 1 + ((mt - 4) & 1)
            masks[0] = b_part_mask(mt, 0)
            masks[1] = b_part_mask(mt, 1)
        }
        if mt == 22 {
            pm = 3
        }
    }
    (*d).pmode = pm
    var nref: [i32; 2] = [(*d).ref_n[0], (*d).ref_n[1]]
    var b8: i32 = 0
    while b8 < 4 {
        mvpred.set_ref(d, 0, b8, -1)
        mvpred.set_ref(d, 1, b8, -1)
        b8 = b8 + 1
    }
    var rf: [i32; 8] = [-1; 8]
    let inference: i32 = (*d).sps[(*d).active as usize].direct8x8
    if isb != 0 && mt == 0 {
        raw.stb((*d).mbf, mb as usize, raw.ldu8((*d).mbf, mb as usize) | 2)
        direct.direct_derive(d, mb, 15)
        var q0: i32 = 0
        while q0 < 4 {
            direct.commit_direct(d, q0, 0)
            direct.commit_direct(d, q0, 1)
            if inference != 0 {
                (*d).sub_shape[q0 as usize] = 0
            } else {
                (*d).sub_shape[q0 as usize] = 3
                allow_t8 = 0
            }
            q0 = q0 + 1
        }
    } else {
    if pm < 3 {
        var parts: i32 = 1
        if pm != 0 {
            parts = 2
        }
        var list: i32 = 0
        while list < 2 {
            var p: i32 = 0
            while p < parts {
                if (masks[p as usize] & (1 << (list as u32))) != 0 {
                    let first: i32 = part_b8_mask(pm, p)
                    var fb: i32 = 0
                    while ((first >> (fb as u32)) & 1) == 0 {
                        fb = fb + 1
                    }
                    let r: i32 = intersyn.read_ref_idx(d, list, fb, nref[list as usize])
                    if r < 0 {
                        return 2
                    }
                    rf[(list * 4 + p) as usize] = r
                    var q: i32 = 0
                    while q < 4 {
                        if ((first >> (q as u32)) & 1) != 0 {
                            mvpred.set_ref(d, list, q, r)
                        }
                        q = q + 1
                    }
                }
                p = p + 1
            }
            list = list + 1
        }
        list = 0
        while list < 2 {
            var p2: i32 = 0
            while p2 < parts {
                if (masks[p2 as usize] & (1 << (list as u32))) != 0 {
                    var bx: i32 = 0
                    var by: i32 = 0
                    var bw: i32 = 4
                    var bh: i32 = 4
                    var shape: i32 = 0
                    if pm == 1 {
                        bh = 2
                        by = p2 * 2
                        shape = 1 + p2
                    }
                    if pm == 2 {
                        bw = 2
                        bx = p2 * 2
                        shape = 3 + p2
                    }
                    read_one_mv(d, list, bx, by, bw, bh, rf[(list * 4 + p2) as usize], shape)
                } else {
                    var ux: i32 = 0
                    var uy: i32 = 0
                    var uw: i32 = 4
                    var uh: i32 = 4
                    if pm == 1 {
                        uh = 2
                        uy = p2 * 2
                    }
                    if pm == 2 {
                        uw = 2
                        ux = p2 * 2
                    }
                    mvpred.set_mv(d, list, ux, uy, uw, uh, 0, 0)
                }
                p2 = p2 + 1
            }
            list = list + 1
        }
    } else {
        var s: i32 = 0
        while s < 4 {
            var t: i32 = 0
            if p8ref0 != 0 {
                t = h264_bits.br_ue(&(*d).br)
            } else {
                t = intersyn.read_sub_type(d, isb)
            }
            var shp: i32 = 0
            var mk: i32 = 0
            if isb == 0 {
                if t > 3 {
                    return 2
                }
                shp = t
                mk = 1
            } else {
                if t > 12 {
                    return 2
                }
                sub_info(1, t, &shp, &mk)
            }
            if isb != 0 && t == 0 {
                (*d).sub_direct[s as usize] = 1
                raw.stb((*d).mbf, mb as usize, raw.ldu8((*d).mbf, mb as usize) | (16 << (s as u32)))
                if inference != 0 {
                    shp = 0
                } else {
                    shp = 3
                    allow_t8 = 0
                }
            } else {
                if shp != 0 {
                    allow_t8 = 0
                }
            }
            (*d).sub_shape[s as usize] = shp
            smask[s as usize] = mk
            s = s + 1
        }
        var dmask: i32 = 0
        s = 0
        while s < 4 {
            if (*d).sub_direct[s as usize] != 0 {
                dmask = dmask | (1 << (s as u32))
            }
            s = s + 1
        }
        if dmask != 0 {
            direct.direct_derive(d, mb, dmask)
        }
        var list: i32 = 0
        while list < 2 {
            s = 0
            while s < 4 {
                if (smask[s as usize] & (1 << (list as u32))) != 0 {
                    var r: i32 = 0
                    if p8ref0 == 0 {
                        r = intersyn.read_ref_idx(d, list, s, nref[list as usize])
                        if r < 0 {
                            return 2
                        }
                    }
                    rf[(list * 4 + s) as usize] = r
                    mvpred.set_ref(d, list, s, r)
                }
                s = s + 1
            }
            list = list + 1
        }
        list = 0
        while list < 2 {
            s = 0
            while s < 4 {
                if (*d).sub_direct[s as usize] != 0 {
                    direct.commit_direct(d, s, list)
                }
                if (smask[s as usize] & (1 << (list as u32))) != 0 {
                    let qx: i32 = (s & 1) * 2
                    let qy: i32 = (s >> 1) * 2
                    let shp2: i32 = (*d).sub_shape[s as usize]
                    let r2: i32 = rf[(list * 4 + s) as usize]
                    if shp2 == 0 {
                        read_one_mv(d, list, qx, qy, 2, 2, r2, 0)
                    }
                    if shp2 == 1 {
                        read_one_mv(d, list, qx, qy, 2, 1, r2, 0)
                        read_one_mv(d, list, qx, qy + 1, 2, 1, r2, 0)
                    }
                    if shp2 == 2 {
                        read_one_mv(d, list, qx, qy, 1, 2, r2, 0)
                        read_one_mv(d, list, qx + 1, qy, 1, 2, r2, 0)
                    }
                    if shp2 == 3 {
                        read_one_mv(d, list, qx, qy, 1, 1, r2, 0)
                        read_one_mv(d, list, qx + 1, qy, 1, 1, r2, 0)
                        read_one_mv(d, list, qx, qy + 1, 1, 1, r2, 0)
                        read_one_mv(d, list, qx + 1, qy + 1, 1, 1, r2, 0)
                    }
                } else {
                    if (*d).sub_direct[s as usize] == 0 {
                        mvpred.set_mv(d, list, (s & 1) * 2, (s >> 1) * 2, 2, 2, 0, 0)
                    }
                }
                s = s + 1
            }
            list = list + 1
        }
    }
    }
    var cbp: i32 = 0
    if cabac != 0 {
        cbp = cabacsyn.cabac_cbp(d, mb, av_a, av_b)
    } else {
        let code: i32 = h264_bits.br_ue(&(*d).br)
        if code > 47 {
            return 2
        }
        cbp = h264_tables.h264_cbp_inter(code as usize) as i32
    }
    raw.stb((*d).mbcbp, mb as usize, cbp)
    var t8: i32 = 0
    if (cbp & 15) != 0 && (*pps).t8x8 != 0 && allow_t8 != 0 {
        if cabac != 0 {
            var tinc: usize = 0
            if av_a != 0 && (raw.ldu8((*d).mbf, (mb - 1) as usize) & 4) != 0 {
                tinc = tinc + 1
            }
            if av_b != 0 && (raw.ldu8((*d).mbf, (mb - (*d).mb_w) as usize) & 4) != 0 {
                tinc = tinc + 1
            }
            t8 = h264_cabac.cabac_decision(d, 399 + tinc)
        } else {
            t8 = h264_bits.br_get1(&(*d).br)
        }
        if t8 != 0 {
            raw.stb((*d).mbf, mb as usize, raw.ldu8((*d).mbf, mb as usize) | 4)
        }
    }
    var dqp: i32 = 0
    if cbp != 0 {
        if cabac != 0 {
            dqp = cabacsyn.cabac_dqp(d)
        } else {
            dqp = h264_bits.br_se(&(*d).br)
        }
        if intramb.apply_qp_delta(d, dqp) != 0 {
            return 2
        }
    }
    (*d).last_dqp = dqp
    raw.stb((*d).mbqp, mb as usize, (*d).qp)
    if cbp != 0 {
        rt.mem_set((*d).coef, 0 as u8, 2048)
        let qp: i32 = (*d).qp
        let qpcb: i32 = cavlc.chroma_qp(qp, (*pps).cqp0)
        let qpcr: i32 = cavlc.chroma_qp(qp, (*pps).cqp1)
        var kind: i32 = 0
        if t8 != 0 {
            kind = 2
        }
        if cabac != 0 {
            if cabacres.residual_luma_cabac(d, mb, kind, cbp & 15, qp, 0, av_a, av_b) != 0 {
                return 2
            }
            if cabacres.residual_chroma_cabac(d, mb, cbp >> 4, qpcb, qpcr, 0, av_a, av_b) != 0 {
                return 2
            }
        } else {
            if rescavlc.residual_luma_cavlc(d, mb, kind, cbp & 15, qp, 0, av_a, av_b) != 0 {
                return 2
            }
            if rescavlc.residual_chroma_cavlc(d, mb, cbp >> 4, qpcb, qpcr, 0, av_a, av_b) != 0 {
                return 2
            }
        }
    }
    if pm == 0 && mt != 0 || (pm == 0 && isb == 0) {
        raw.stb((*d).mbf, mb as usize, raw.ldu8((*d).mbf, mb as usize) | 8)
    }
    intermb.mc_inter_mb(d, mb)
    if cbp != 0 {
        intermb.add_residual_inter(d, mb, t8, cbp)
    }
    return 0
}

static mut G_H264_SIZE: usize = 0

fn h264_size() -> usize {
    if G_H264_SIZE == 0 {
        var a: [params.H264; 2] = [params.h264_new(), params.h264_new()]
        G_H264_SIZE = (((&a[1]) as u64) - ((&a[0]) as u64)) as usize
    }
    return G_H264_SIZE
}
