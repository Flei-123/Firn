import media.video.h264.tables as h264_tables
import media.video.h264.cabac as h264_cabac
import media.video.h264.cavlc
import media.video.h264.params
import media.video.h264.raw
import media.video.h264.transform
import media.video.h264.types

export {
    residual_chroma_cabac, residual_luma_cabac,
}

fn cbf_luma_nb(d: *mut params.H264, mn: i32, bx: i32, by: i32) -> i32 {
    let t: i32 = raw.ldu8((*d).mbt, mn as usize)
    if t == types.MB_PCM {
        return 1
    }
    if (raw.ldu8((*d).mbf, mn as usize) & 4) != 0 {
        return (raw.ldu8((*d).mbcbp, mn as usize) >> ((by >> 1) * 2 + (bx >> 1))) & 1
    }
    if raw.ldu8((*d).nnz, (mn * 24 + by * 4 + bx) as usize) != 0 {
        return 1
    }
    return 0
}

fn cbf_inc_luma(d: *mut params.H264, mb: i32, bx: i32, by: i32, av_a: i32, av_b: i32, intra: i32) -> usize {
    var ca: i32 = 0
    var cb: i32 = 0
    if bx > 0 {
        if raw.ldu8((*d).nnz, (mb * 24 + by * 4 + bx - 1) as usize) != 0 {
            ca = 1
        }
    } else {
        if av_a != 0 {
            ca = cbf_luma_nb(d, mb - 1, 3, by)
        } else {
            ca = intra
        }
    }
    if by > 0 {
        if raw.ldu8((*d).nnz, (mb * 24 + (by - 1) * 4 + bx) as usize) != 0 {
            cb = 1
        }
    } else {
        if av_b != 0 {
            cb = cbf_luma_nb(d, mb - (*d).mb_w, bx, 3)
        } else {
            cb = intra
        }
    }
    return (ca + 2 * cb) as usize
}

fn cbf_inc_dc(d: *mut params.H264, mb: i32, bit: i32, av_a: i32, av_b: i32, intra: i32) -> usize {
    var ca: i32 = 0
    var cb: i32 = 0
    if av_a != 0 {
        if raw.ldu8((*d).mbt, (mb - 1) as usize) == types.MB_PCM {
            ca = 1
        } else {
            ca = (raw.ldu8((*d).cbfdc, (mb - 1) as usize) >> bit) & 1
        }
    } else {
        ca = intra
    }
    if av_b != 0 {
        if raw.ldu8((*d).mbt, (mb - (*d).mb_w) as usize) == types.MB_PCM {
            cb = 1
        } else {
            cb = (raw.ldu8((*d).cbfdc, (mb - (*d).mb_w) as usize) >> bit) & 1
        }
    } else {
        cb = intra
    }
    return (ca + 2 * cb) as usize
}

fn cbf_inc_chroma_ac(d: *mut params.H264, mb: i32, comp: i32, bx: i32, by: i32, av_a: i32, av_b: i32, intra: i32) -> usize {
    var ca: i32 = 0
    var cb: i32 = 0
    let base: i32 = 16 + comp * 4
    if bx > 0 {
        if raw.ldu8((*d).nnz, (mb * 24 + base + by * 2) as usize) != 0 {
            ca = 1
        }
    } else {
        if av_a != 0 {
            if raw.ldu8((*d).nnz, ((mb - 1) * 24 + base + by * 2 + 1) as usize) != 0 {
                ca = 1
            }
        } else {
            ca = intra
        }
    }
    if by > 0 {
        if raw.ldu8((*d).nnz, (mb * 24 + base + bx) as usize) != 0 {
            cb = 1
        }
    } else {
        if av_b != 0 {
            if raw.ldu8((*d).nnz, ((mb - (*d).mb_w) * 24 + base + 2 + bx) as usize) != 0 {
                cb = 1
            }
        } else {
            cb = intra
        }
    }
    return (ca + 2 * cb) as usize
}

fn cabac_block(d: *mut params.H264, cat: i32, cbf_inc: i32, maxn: i32, lv: u64) -> i32 {
    var i: i32 = 0
    while i < maxn {
        raw.sti32(lv, i as usize, 0)
        i = i + 1
    }
    if cbf_inc >= 0 {
        let co: usize = (cat as usize) * 4
        if h264_cabac.cabac_decision(d, 85 + co + (cbf_inc as usize)) == 0 {
            return 0
        }
    }
    let sig_base: usize = h264_tables.h264_sig_off(cat as usize) as usize
    let last_base: usize = h264_tables.h264_last_off(cat as usize) as usize
    var idx: [i32; 64] = [0; 64]
    var n: i32 = 0
    var done: i32 = 0
    i = 0
    while i < maxn - 1 && done == 0 {
        var si: usize = i as usize
        var li: usize = i as usize
        if cat == 3 {
            si = raw.imin(i, 2) as usize
            li = si
        }
        if cat == 5 {
            si = h264_tables.h264_sig8(i as usize) as usize
            li = h264_tables.h264_last8(i as usize) as usize
        }
        if h264_cabac.cabac_decision(d, sig_base + si) != 0 {
            idx[n as usize] = i
            n = n + 1
            if h264_cabac.cabac_decision(d, last_base + li) != 0 {
                done = 1
            }
        }
        i = i + 1
    }
    if done == 0 {
        idx[n as usize] = maxn - 1
        n = n + 1
    }
    let abs_base: usize = h264_tables.h264_abs_off(cat as usize) as usize
    var l1c: [i32; 8] = [1, 2, 3, 4, 0, 0, 0, 0]
    var g1c: [i32; 8] = [5, 5, 5, 5, 6, 7, 8, 9]
    var tr0: [i32; 8] = [1, 2, 3, 3, 4, 5, 6, 7]
    var tr1: [i32; 8] = [4, 4, 4, 4, 5, 6, 7, 7]
    var node: i32 = 0
    var k: i32 = n - 1
    while k >= 0 {
        var abs: i32 = 1
        if h264_cabac.cabac_decision(d, abs_base + (l1c[node as usize] as usize)) == 0 {
            node = tr0[node as usize]
        } else {
            let gctx: usize = abs_base + (g1c[node as usize] as usize)
            node = tr1[node as usize]
            abs = 2
            while abs < 15 && h264_cabac.cabac_decision(d, gctx) != 0 {
                abs = abs + 1
            }
            if abs >= 15 {
                abs = 15 + h264_cabac.cabac_egk(d, 0)
            }
        }
        if h264_cabac.cabac_bypass(d) != 0 {
            abs = 0 - abs
        }
        raw.sti32(lv, idx[k as usize] as usize, abs)
        k = k - 1
    }
    return n
}

fn residual_luma_cabac(d: *mut params.H264, mb: i32, kind: i32, cbp: i32, qp: i32, intra: i32, av_a: i32, av_b: i32) -> i32 {
    let coef: u64 = (*d).coef
    let lv: u64 = coef + 420 * 4
    var dq4l: i32 = 0
    var dq8l: i32 = 0
    if intra == 0 {
        dq4l = 3
        dq8l = 1
    }
    let dq4: u64 = (*d).dq4 + (((dq4l * 52 + qp) * 16) as usize * 4) as u64
    if kind == 1 {
        let inc: usize = cbf_inc_dc(d, mb, 0, av_a, av_b, intra)
        let tc: i32 = cabac_block(d, 0, inc as i32, 16, lv)
        let dcl: u64 = coef + 384 * 4
        var k: usize = 0
        while k < 16 {
            raw.sti32(dcl, k, 0)
            k = k + 1
        }
        k = 0
        while k < 16 {
            raw.sti32(dcl, h264_tables.h264_zz4(k) as usize, raw.ldi32(lv, k))
            k = k + 1
        }
        if tc > 0 {
            transform.luma_dc_dequant(coef, dcl, qp, (*d).dq4 + (((dq4l * 52) * 16) as usize * 4) as u64)
            raw.stb((*d).cbfdc, mb as usize, raw.ldu8((*d).cbfdc, mb as usize) | 1)
        }
    }
    if kind == 2 {
        var q: i32 = 0
        while q < 4 {
            if (cbp & (1 << (q as u32))) != 0 {
                let l8: u64 = coef + 440 * 4
                let tc: i32 = cabac_block(d, 5, -1, 64, l8)
                let bx0: i32 = (q & 1) * 2
                let by0: i32 = (q >> 1) * 2
                let o: usize = (mb * 24 + by0 * 4 + bx0) as usize
                raw.stb((*d).nnz, o, tc)
                raw.stb((*d).nnz, o + 1, tc)
                raw.stb((*d).nnz, o + 4, tc)
                raw.stb((*d).nnz, o + 5, tc)
                let dq8: u64 = (*d).dq8 + (((dq8l * 52 + qp) * 64) as usize * 4) as u64
                var i: usize = 0
                while i < 64 {
                    let lvl: i32 = raw.ldi32(l8, i)
                    if lvl != 0 {
                        let pos: usize = h264_tables.h264_zz8(i) as usize
                        raw.sti32(coef, (q as usize) * 64 + pos, ((lvl *% raw.ldi32(dq8, pos)) +% 32) >> 6)
                    }
                    i = i + 1
                }
            }
            q = q + 1
        }
        return 0
    }
    var blk: i32 = 0
    while blk < 16 {
        if (cbp & (1 << ((blk >> 2) as u32))) != 0 {
            let bx: i32 = cavlc.blk_x(blk)
            let by: i32 = cavlc.blk_y(blk)
            var maxn: i32 = 16
            var cat: i32 = 2
            if kind == 1 {
                maxn = 15
                cat = 1
            }
            let inc: usize = cbf_inc_luma(d, mb, bx, by, av_a, av_b, intra)
            let tc: i32 = cabac_block(d, cat, inc as i32, maxn, lv)
            raw.stb((*d).nnz, (mb * 24 + by * 4 + bx) as usize, tc)
            if tc > 0 {
                let bi: usize = (by * 4 + bx) as usize
                var k2: usize = 0
                while k2 < (maxn as usize) {
                    let lvl2: i32 = raw.ldi32(lv, k2)
                    if lvl2 != 0 {
                        var si: usize = k2
                        if kind == 1 {
                            si = k2 + 1
                        }
                        let pos2: usize = h264_tables.h264_zz4(si) as usize
                        raw.sti32(coef, bi * 16 + pos2, ((lvl2 *% raw.ldi32(dq4, pos2)) +% 8) >> 4)
                    }
                    k2 = k2 + 1
                }
            }
        }
        blk = blk + 1
    }
    return 0
}

fn residual_chroma_cabac(d: *mut params.H264, mb: i32, cbpc: i32, qpcb: i32, qpcr: i32, intra: i32, av_a: i32, av_b: i32) -> i32 {
    if cbpc == 0 {
        return 0
    }
    let coef: u64 = (*d).coef
    let lv: u64 = coef + 420 * 4
    var comp: i32 = 0
    while comp < 2 {
        var qpc: i32 = qpcb
        if comp == 1 {
            qpc = qpcr
        }
        var list: i32 = 1 + comp
        if intra == 0 {
            list = 4 + comp
        }
        let inc: usize = cbf_inc_dc(d, mb, 1 + comp, av_a, av_b, intra)
        let tc: i32 = cabac_block(d, 3, inc as i32, 4, lv)
        if tc > 0 {
            transform.chroma_dc_dequant(coef, (256 + comp * 64) as usize, lv, qpc, (*d).dq4 + (((list * 52) * 16) as usize * 4) as u64)
            raw.stb((*d).cbfdc, mb as usize, raw.ldu8((*d).cbfdc, mb as usize) | (2 << (comp as u32)))
        }
        comp = comp + 1
    }
    if cbpc == 2 {
        comp = 0
        while comp < 2 {
            var qpc2: i32 = qpcb
            if comp == 1 {
                qpc2 = qpcr
            }
            var list2: i32 = 1 + comp
            if intra == 0 {
                list2 = 4 + comp
            }
            let dq: u64 = (*d).dq4 + (((list2 * 52 + qpc2) * 16) as usize * 4) as u64
            var b: i32 = 0
            while b < 4 {
                let inc2: usize = cbf_inc_chroma_ac(d, mb, comp, b & 1, b >> 1, av_a, av_b, intra)
                let tc2: i32 = cabac_block(d, 4, inc2 as i32, 15, lv)
                raw.stb((*d).nnz, (mb * 24 + 16 + comp * 4 + b) as usize, tc2)
                if tc2 > 0 {
                    var k: usize = 0
                    while k < 15 {
                        let lvl: i32 = raw.ldi32(lv, k)
                        if lvl != 0 {
                            let pos: usize = h264_tables.h264_zz4(k + 1) as usize
                            raw.sti32(coef, (256 + comp * 64 + b * 16) as usize + pos, ((lvl *% raw.ldi32(dq, pos)) +% 8) >> 4)
                        }
                        k = k + 1
                    }
                }
                b = b + 1
            }
            comp = comp + 1
        }
    }
    return 0
}
