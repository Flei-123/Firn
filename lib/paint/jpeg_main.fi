// SPDX-License-Identifier: GPL-2.0-only
// lib/paint/jpeg_main.fi -- a JPEG in, a PPM out. Nothing else.
//
// The same shape as `png_main.fi` of round B3, and for the same reason:
// so that the DECODER can be held against somebody else's -- Pillow, which
// is libjpeg underneath -- with the browser out of the way.
// A file this decoder refuses produces `REFUSED <reason>` on standard
// error and exit code 1, so that a test can tell "cannot" from "wrong".
import std.rt
import html.mem
import paint.png
import paint.jpeg

fn main() -> i32 {
    var inb: mem.Buf = mem.buf_new()
    mem.read_all_stdin(&inb)
    let n: usize = mem.buf_len(&inb)
    var im: png.Image = png.image_new()
    var why: u32 = 0
    if !jpeg.decode_jpeg(mem.buf_ptr(&inb) as u64, n, &im, &why) {
        var out: mem.Buf = mem.buf_new()
        mem.buf_init(&out)
        var lit: [u8; 8] = "REFUSED "
        var i: usize = 0
        while i < 8 {
            mem.buf_push(&out, lit[i])
            i = i + 1
        }
        mem.buf_push_dec(&out, why as u64)
        mem.buf_push(&out, 10 as u8)
        rt.write_everything(2, mem.buf_ptr(&out) as u64, mem.buf_len(&out))
        return 1
    }
    let w: usize = png.image_width(&im)
    let h: usize = png.image_height(&im)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    var head: [u8; 3] = "P6\n"
    var i: usize = 0
    while i < 3 {
        mem.buf_push(&out, head[i])
        i = i + 1
    }
    mem.buf_push_dec(&out, w as u64)
    mem.buf_push(&out, 32 as u8)
    mem.buf_push_dec(&out, h as u64)
    mem.buf_push(&out, 10 as u8)
    var m: [u8; 4] = "255\n"
    i = 0
    while i < 4 {
        mem.buf_push(&out, m[i])
        i = i + 1
    }
    var y: usize = 0
    while y < h {
        var x: usize = 0
        while x < w {
            let px: u32 = png.image_pixel(&im, x, y)
            mem.buf_push(&out, ((px >> 16) & 255 as u32) as u8)
            mem.buf_push(&out, ((px >> 8) & 255 as u32) as u8)
            mem.buf_push(&out, (px & 255 as u32) as u8)
            x = x + 1
        }
        y = y + 1
    }
    rt.write_everything(1, mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    png.image_free(&im)
    return 0
}
