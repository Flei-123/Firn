// SPDX-License-Identifier: GPL-2.0-only
// lib/paint/png_main.fi -- a PNG in, a PPM out. Nothing else.
//
// It exists so that the DECODER can be measured against somebody else's
// encoder and the ENCODER against somebody else's decoder, without the
// browser in between. `tools/paintb3/run.sh` feeds it a file Pillow
// wrote and holds the answer against what Pillow reads out of the same
// file, pixel for pixel: two implementations that share no line of code.
//
// Compile with:  firnc -o build/pngb3 lib/paint/png_main.fi
import html.mem
import paint.png

fn main() -> i32 {
    var inb: mem.Buf = mem.buf_new()
    mem.read_all_stdin(&inb)
    let n: usize = mem.buf_len(&inb)
    var im: png.Image = png.image_new()
    if !png.decode_png(mem.buf_ptr(&inb) as u64, n, &im) {
        return 1
    }
    let w: usize = png.image_width(&im)
    let h: usize = png.image_height(&im)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    var head: [u8; 3] = "P6\n"
    var i: usize = 0
    while i < 3 {
        mem.buf_push(&out, head[i])
        i = i + 1
    }
    mem.buf_push_dec(&out, w as u64)
    mem.buf_push(&out, 32 as u8)
    mem.buf_push_dec(&out, h as u64)
    mem.buf_push(&out, 10 as u8)
    var m: [u8; 4] = "255\n"
    i = 0
    while i < 4 {
        mem.buf_push(&out, m[i])
        i = i + 1
    }
    var y: usize = 0
    while y < h {
        var x: usize = 0
        while x < w {
            let v: u32 = png.image_pixel(&im, x, y)
            // Straight alpha, put on white -- PPM has no alpha channel and
            // guessing one would hide a wrong alpha instead of showing it.
            let a: u32 = (v >> 24) & 255 as u32
            let inv: u32 = 255 - a
            mem.buf_push(&out, (((v >> 16) & 255 as u32) * a / 255 + inv) as u8)
            mem.buf_push(&out, (((v >> 8) & 255 as u32) * a / 255 + inv) as u8)
            mem.buf_push(&out, ((v & 255 as u32) * a / 255 + inv) as u8)
            x = x + 1
        }
        y = y + 1
    }
    mem.buf_flush(&out, 1)
    png.image_free(&im)
    return 0
}
