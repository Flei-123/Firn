// SPDX-License-Identifier: MPL-2.0
// lib/paint/gl.fi -- THE GPU AS A TABLE: the OpenGL ES 3 calls fUi's
// renderer (lib/fui/gpu.fi) needs, filled by the platform.
//
// ================================================================ WHY A TABLE
//
// fUi's painter is used by programs that never see a GPU -- the native
// acceptance runs, a kernel window server, a program that paints PNGs.
// If the renderer called `extern fn glDrawArrays` directly, every one of
// them would have to link a GL library, and a WebAssembly module would
// import functions its host may not have. So the renderer calls through
// THIS table, and only a program that switches the GPU on imports the
// platform file that fills it:
//
//   lib/plat/webgl.fi   the browser: WebGL2 through the host (firn.js)
//   lib/plat/gles.fi    Android: OpenGL ES 3 out of libGLESv3, on an EGL
//                       window surface (lib/window/android.fi)
//   (later) the desktop, once a Firn program can load the system's GL
//
// It lives in lib/paint and not in lib/fui because a window backend
// (lib/window/*) hands it out -- the table knows nothing of fUi.
//
// The calls are OpenGL ES 3.0 as WebGL2 exposes it -- the one API that
// all of them have in common. Objects are numbers (as in GLES; the browser
// host keeps a table of its WebGL objects). Octets cross as address +
// length in the program's own memory.
//
// Only what the renderer uses is here. Every entry is a plain function
// value; the platform file sets them all (`gl_api_ok` says whether it
// did). EVERY PARAMETER AND RESULT IS 64 BITS WIDE (u64, i64, f64), on
// purpose: the WebAssembly back end passes a narrower integer through a
// function value as i64 while the function's record takes it as i32 --
// a "function signature mismatch" trap at the first such call (found
// here, 24.09.2026; the fix belongs into compiler/src/codegen_wasm.rs,
// CallIndirect, which types the call by its argument values instead of
// by the callee).
export {
    GlApi, gl_api_new, gl_api_ok,
    GL_TRIANGLES, GL_TRIANGLE_STRIP, GL_FLOAT, GL_UNSIGNED_BYTE,
    GL_ARRAY_BUFFER, GL_STATIC_DRAW, GL_DYNAMIC_DRAW, GL_STREAM_DRAW,
    GL_TEXTURE_2D, GL_TEXTURE0, GL_RGBA, GL_RGBA8, GL_RED, GL_R8,
    GL_TEXTURE_MIN_FILTER, GL_TEXTURE_MAG_FILTER, GL_TEXTURE_WRAP_S,
    GL_TEXTURE_WRAP_T, GL_NEAREST, GL_LINEAR, GL_CLAMP_TO_EDGE,
    GL_FRAMEBUFFER, GL_READ_FRAMEBUFFER, GL_DRAW_FRAMEBUFFER,
    GL_COLOR_ATTACHMENT0, GL_FRAMEBUFFER_COMPLETE,
    GL_COLOR_BUFFER_BIT, GL_BLEND, GL_SCISSOR_TEST, GL_ONE,
    GL_ONE_MINUS_SRC_ALPHA, GL_ZERO, GL_SRC_ALPHA,
    GL_VERTEX_SHADER, GL_FRAGMENT_SHADER,
    GLK_TEXTURE, GLK_BUFFER, GLK_FRAMEBUFFER, GLK_PROGRAM, GLK_SHADER,
    GLK_VERTEX_ARRAY,
}

const GL_TRIANGLES: u32 = 4
const GL_TRIANGLE_STRIP: u32 = 5
const GL_FLOAT: u32 = 5126
const GL_UNSIGNED_BYTE: u32 = 5121
const GL_ARRAY_BUFFER: u32 = 34962
const GL_STATIC_DRAW: u32 = 35044
const GL_DYNAMIC_DRAW: u32 = 35048
const GL_STREAM_DRAW: u32 = 35040
const GL_TEXTURE_2D: u32 = 3553
const GL_TEXTURE0: u32 = 33984
const GL_RGBA: u32 = 6408
const GL_RGBA8: u32 = 32856
const GL_RED: u32 = 6403
const GL_R8: u32 = 33321
const GL_TEXTURE_MIN_FILTER: u32 = 10241
const GL_TEXTURE_MAG_FILTER: u32 = 10240
const GL_TEXTURE_WRAP_S: u32 = 10242
const GL_TEXTURE_WRAP_T: u32 = 10243
const GL_NEAREST: u32 = 9728
const GL_LINEAR: u32 = 9729
const GL_CLAMP_TO_EDGE: u32 = 33071
const GL_FRAMEBUFFER: u32 = 36160
const GL_READ_FRAMEBUFFER: u32 = 36008
const GL_DRAW_FRAMEBUFFER: u32 = 36009
const GL_COLOR_ATTACHMENT0: u32 = 36064
const GL_FRAMEBUFFER_COMPLETE: u32 = 36053
const GL_COLOR_BUFFER_BIT: u32 = 16384
const GL_BLEND: u32 = 3042
const GL_SCISSOR_TEST: u32 = 3089
const GL_ONE: u32 = 1
const GL_ZERO: u32 = 0
const GL_SRC_ALPHA: u32 = 770
const GL_ONE_MINUS_SRC_ALPHA: u32 = 771
const GL_VERTEX_SHADER: u32 = 35633
const GL_FRAGMENT_SHADER: u32 = 35632

// What `delete_obj` deletes.
const GLK_TEXTURE: u32 = 1
const GLK_BUFFER: u32 = 2
const GLK_FRAMEBUFFER: u32 = 3
const GLK_PROGRAM: u32 = 4
const GLK_SHADER: u32 = 5
const GLK_VERTEX_ARRAY: u32 = 6

struct GlApi {
    ok: bool,
    // a program out of two shader sources (address, length); 0 = it did
    // not compile or link -- the log goes to `log` (cap octets), its
    // length comes back through `loglen`
    program: fn(u64, usize, u64, usize, u64, usize) -> u64,
    use_program: fn(u64),
    uniform_location: fn(u64, u64, usize) -> u64,
    uniform1i: fn(u64, i64),
    uniform1f: fn(u64, f64),
    uniform2f: fn(u64, f64, f64),
    uniform4f: fn(u64, f64, f64, f64, f64),
    create_buffer: fn() -> u64,
    bind_buffer: fn(u64, u64),
    buffer_data: fn(u64, u64, usize, u64),
    buffer_sub_data: fn(u64, usize, u64, usize),
    create_vertex_array: fn() -> u64,
    bind_vertex_array: fn(u64),
    enable_vertex_attrib_array: fn(u64),
    vertex_attrib_pointer: fn(u64, i64, u64, u64, i64, usize),
    vertex_attrib_divisor: fn(u64, u64),
    create_texture: fn() -> u64,
    bind_texture: fn(u64, u64),
    active_texture: fn(u64),
    // target, level, internal format, w, h, format, type, data (0 = none), octets
    tex_image_2d: fn(u64, i64, u64, i64, i64, u64, u64, u64, usize),
    // target, level, x, y, w, h, format, type, data, octets, row length in pixels
    tex_sub_image_2d: fn(u64, i64, i64, i64, i64, i64, u64, u64, u64, usize, i64),
    tex_parameteri: fn(u64, u64, i64),
    create_framebuffer: fn() -> u64,
    bind_framebuffer: fn(u64, u64),
    framebuffer_texture_2d: fn(u64, u64, u64, u64, i64),
    check_framebuffer_status: fn(u64) -> u64,
    blit_framebuffer: fn(i64, i64, i64, i64, i64, i64, i64, i64, u64, u64),
    copy_tex_sub_image_2d: fn(u64, i64, i64, i64, i64, i64, i64, i64),
    viewport: fn(i64, i64, i64, i64),
    scissor: fn(i64, i64, i64, i64),
    enable: fn(u64),
    disable: fn(u64),
    blend_func_separate: fn(u64, u64, u64, u64),
    clear_color: fn(f64, f64, f64, f64),
    clear: fn(u64),
    draw_arrays: fn(u64, i64, i64),
    draw_arrays_instanced: fn(u64, i64, i64, i64),
    read_pixels: fn(i64, i64, i64, i64, u64),
    delete_obj: fn(u64, u64),
    get_error: fn() -> u64,
    finish: fn(),
}

fn nop0() { }
fn nop1(a: u64) { }
fn nop2(a: u64, b: u64) { }
fn zero0() -> u64 { return 0 }
fn prog_none(a: u64, an: usize, b: u64, bn: usize, lg: u64, cap: usize) -> u64 { return 0 }
fn uloc_none(p: u64, n: u64, nn: usize) -> u64 { return 0 }
fn u1i_none(l: u64, v: i64) { }
fn u1f_none(l: u64, v: f64) { }
fn u2f_none(l: u64, a: f64, b: f64) { }
fn u4f_none(l: u64, a: f64, b: f64, c: f64, d: f64) { }
fn bdata_none(t: u64, p: u64, n: usize, u: u64) { }
fn bsub_none(t: u64, o: usize, p: u64, n: usize) { }
fn vap_none(i: u64, s: i64, t: u64, nm: u64, st: i64, o: usize) { }
fn teximg_none(t: u64, l: i64, f: u64, w: i64, h: i64, fm: u64, ty: u64, p: u64, n: usize) { }
fn texsub_none(t: u64, l: i64, x: i64, y: i64, w: i64, h: i64, fm: u64, ty: u64, p: u64, n: usize, rl: i64) { }
fn texpar_none(t: u64, p: u64, v: i64) { }
fn fbtex_none(t: u64, a: u64, tt: u64, tx: u64, l: i64) { }
fn fbst_none(t: u64) -> u64 { return 0 }
fn blit_none(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, m: u64, fl: u64) { }
fn copytex_none(t: u64, l: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) { }
fn rect_none(a: i64, b: i64, c: i64, d: i64) { }
fn bfs_none(a: u64, b: u64, c: u64, d: u64) { }
fn cc_none(a: f64, b: f64, c: f64, d: f64) { }
fn da_none(m: u64, f: i64, c: i64) { }
fn dai_none(m: u64, f: i64, c: i64, n: i64) { }
fn rp_none(x: i64, y: i64, w: i64, h: i64, p: u64) { }

// An empty table: every call does nothing. The platform file replaces the
// entries and sets `ok`.
fn gl_api_new() -> GlApi {
    return GlApi {
        ok: false,
        program: prog_none, use_program: nop1, uniform_location: uloc_none,
        uniform1i: u1i_none, uniform1f: u1f_none, uniform2f: u2f_none,
        uniform4f: u4f_none,
        create_buffer: zero0, bind_buffer: nop2, buffer_data: bdata_none,
        buffer_sub_data: bsub_none,
        create_vertex_array: zero0, bind_vertex_array: nop1,
        enable_vertex_attrib_array: nop1, vertex_attrib_pointer: vap_none,
        vertex_attrib_divisor: nop2,
        create_texture: zero0, bind_texture: nop2, active_texture: nop1,
        tex_image_2d: teximg_none, tex_sub_image_2d: texsub_none,
        tex_parameteri: texpar_none,
        create_framebuffer: zero0, bind_framebuffer: nop2,
        framebuffer_texture_2d: fbtex_none,
        check_framebuffer_status: fbst_none, blit_framebuffer: blit_none,
        copy_tex_sub_image_2d: copytex_none,
        viewport: rect_none, scissor: rect_none, enable: nop1, disable: nop1,
        blend_func_separate: bfs_none, clear_color: cc_none, clear: nop1,
        draw_arrays: da_none, draw_arrays_instanced: dai_none,
        read_pixels: rp_none, delete_obj: nop2, get_error: zero0,
        finish: nop0,
    }
}

fn gl_api_ok(g: *mut GlApi) -> bool {
    return (*g).ok
}
