// SPDX-License-Identifier: MPL-2.0
// lib/paint/png.fi -- the picture leaves the process: PPM and PNG out,
// PNG in.
//
// PPM IS THERE ON PURPOSE and is not a fallback. It is eleven octets of
// header and then the raw pixels; a bug in the writer cannot hide in it,
// and a harness can read it without a library. Whenever the two disagree
// about a picture, PPM is the one that is right.
//
// PNG is the one anybody can look at. It needs three things, and all
// three are already in this repository: DEFLATE (round 81, written in
// Firn, no zlib linked in), the CRC-32 that comes with it, and the
// Adler-32 of the zlib frame. What this file adds is the chunk structure,
// the per-row FILTER and the reverse of it.
//
// THE FILTER is the part of PNG people forget. Every row is preceded by
// one octet saying how it was predicted from the row above and from the
// pixel to the left; a decoder that ignores it gets noise, and an encoder
// that always writes 0 produces a file three times too large. The encoder
// here picks per row, by the standard heuristic of the specification
// (minimum sum of absolute differences), and the decoder implements all
// five.
import rt.rt
import html.mem
import std.deflate
import paint.canvas

export {
    write_ppm, write_png, Image, image_new, image_free, decode_png, decode_png_limited,
    PNG_MAX_PIXELS,
    image_width, image_height, image_pixel, image_ok,
}

// ------------------------------------------------------------------ PPM

#[no_gc]
fn push_dec(b: *mut mem.Buf, v: u64) {
    mem.buf_push_dec(b, v)
}

fn write_ppm(cv: *mut canvas.Canvas, out: *mut mem.Buf) {
    let w: usize = canvas.canvas_width(cv)
    let h: usize = canvas.canvas_height(cv)
    var head: [u8; 3] = "P6\n"
    var i: usize = 0
    while i < 3 {
        mem.buf_push(out, head[i])
        i = i + 1
    }
    push_dec(out, w as u64)
    mem.buf_push(out, 32 as u8)
    push_dec(out, h as u64)
    mem.buf_push(out, 10 as u8)
    var m: [u8; 4] = "255\n"
    i = 0
    while i < 4 {
        mem.buf_push(out, m[i])
        i = i + 1
    }
    var y: usize = 0
    while y < h {
        var x: usize = 0
        while x < w {
            let v: u32 = canvas.canvas_get(cv, x, y)
            // The canvas is PREMULTIPLIED; PPM has no alpha, so the
            // picture is put on white -- which is what a browser window
            // is behind the page.
            let a: u32 = (v >> 24) & 255 as u32
            let inv: u32 = 255 - a
            mem.buf_push(out, (((v >> 16) & 255 as u32) + inv) as u8)
            mem.buf_push(out, (((v >> 8) & 255 as u32) + inv) as u8)
            mem.buf_push(out, ((v & 255 as u32) + inv) as u8)
            x = x + 1
        }
        y = y + 1
    }
}

// ------------------------------------------------------------------ PNG

#[no_gc]
fn be32(b: *mut mem.Buf, v: u32) {
    mem.buf_push(b, ((v >> 24) & 255 as u32) as u8)
    mem.buf_push(b, ((v >> 16) & 255 as u32) as u8)
    mem.buf_push(b, ((v >> 8) & 255 as u32) as u8)
    mem.buf_push(b, (v & 255 as u32) as u8)
}

fn chunk(out: *mut mem.Buf, tag: *mut u8, payload: u64, n: usize) {
    be32(out, n as u32)
    let start: usize = mem.buf_len(out)
    var i: usize = 0
    while i < 4 {
        mem.buf_push(out, *((tag as u64 + i as u64) as *mut u8))
        i = i + 1
    }
    i = 0
    while i < n {
        mem.buf_push(out, *((payload + i as u64) as *mut u8))
        i = i + 1
    }
    let base: u64 = mem.buf_ptr(out) as u64 + start as u64
    be32(out, deflate.crc32(base, 4 + n))
}

// The filter of one row, chosen by the sum of absolute differences -- the
// heuristic the PNG specification itself recommends (12.8).
#[no_gc]
fn paeth(a: i32, b: i32, c: i32) -> i32 {
    let pp: i32 = a + b - c
    var pa: i32 = pp - a
    if pa < 0 {
        pa = 0 - pa
    }
    var pb: i32 = pp - b
    if pb < 0 {
        pb = 0 - pb
    }
    var pc: i32 = pp - c
    if pc < 0 {
        pc = 0 - pc
    }
    if pa <= pb && pa <= pc {
        return a
    }
    if pb <= pc {
        return b
    }
    return c
}

fn write_png(cv: *mut canvas.Canvas, out: *mut mem.Buf) -> bool {
    let w: usize = canvas.canvas_width(cv)
    let h: usize = canvas.canvas_height(cv)
    if w == 0 || h == 0 {
        return false
    }
    // ---- the raw scan lines, RGBA, with a filter octet in front of each
    let stride: usize = w * 4
    let raw_n: usize = (stride + 1) * h
    let raw: *mut u8 = mem.heap_alloc(raw_n)
    if raw as usize == 0 {
        return false
    }
    let prev: *mut u8 = mem.heap_alloc(stride)
    let cur: *mut u8 = mem.heap_alloc(stride)
    let best: *mut u8 = mem.heap_alloc(stride)
    if prev as usize == 0 || cur as usize == 0 || best as usize == 0 {
        return false
    }
    var y: usize = 0
    while y < h {
        var x: usize = 0
        while x < w {
            let v: u32 = canvas.canvas_get(cv, x, y)
            // PNG wants STRAIGHT alpha, the canvas holds premultiplied.
            let a: u32 = (v >> 24) & 255 as u32
            var r: u32 = (v >> 16) & 255 as u32
            var g: u32 = (v >> 8) & 255 as u32
            var b: u32 = v & 255 as u32
            if a != 0 as u32 && a != 255 as u32 {
                r = unpremul(r, a)
                g = unpremul(g, a)
                b = unpremul(b, a)
            }
            let p: u64 = cur as u64 + (x * 4) as u64
            *(p as *mut u8) = r as u8
            *((p + 1) as *mut u8) = g as u8
            *((p + 2) as *mut u8) = b as u8
            *((p + 3) as *mut u8) = a as u8
            x = x + 1
        }
        // choose the filter
        var bestf: u32 = 0
        var bestsum: u64 = 0
        var f: u32 = 0
        while f < 5 as u32 {
            var sum: u64 = 0
            var i: usize = 0
            while i < stride {
                let v: i32 = filt(f, cur, prev, i, stride) as i32
                var d: i32 = v
                if d > 127 {
                    d = 256 - d
                }
                sum = sum + (d as u64)
                i = i + 1
            }
            if f == 0 as u32 || sum < bestsum {
                bestsum = sum
                bestf = f
            }
            f = f + 1 as u32
        }
        let rowbase: u64 = raw as u64 + ((stride + 1) * y) as u64
        *(rowbase as *mut u8) = bestf as u8
        var i2: usize = 0
        while i2 < stride {
            *((rowbase + 1 + i2 as u64) as *mut u8) =
            filt(bestf, cur, prev, i2, stride)
            i2 = i2 + 1
        }
        mem.mem_copy(prev, cur, stride)
        y = y + 1
    }
    // ---- zlib
    var z: rt.Buf = rt.buf_new()
    let zn: usize = deflate.zlib_compress(raw as u64, raw_n, 6, &z) catch 0
    if zn == 0 {
        return false
    }
    // ---- the file
    var sig: [u8; 8] = [137 as u8, 80 as u8, 78 as u8, 71 as u8,
        13 as u8, 10 as u8, 26 as u8, 10 as u8]
    var i3: usize = 0
    while i3 < 8 {
        mem.buf_push(out, sig[i3])
        i3 = i3 + 1
    }
    var ihdr: [u8; 13] = [0 as u8; 13]
    put_be32(&ihdr[0], 0, w as u32)
    put_be32(&ihdr[0], 4, h as u32)
    ihdr[8] = 8 as u8 // bit depth
    ihdr[9] = 6 as u8 // colour type 6 = RGBA
    ihdr[10] = 0 as u8
    ihdr[11] = 0 as u8
    ihdr[12] = 0 as u8
    var t1: [u8; 4] = "IHDR"
    chunk(out, &t1[0], (&ihdr[0]) as u64, 13)
    var t2: [u8; 4] = "IDAT"
    chunk(out, &t2[0], rt.buf_ptr(&z), rt.buf_len(&z))
    var t3: [u8; 4] = "IEND"
    chunk(out, &t3[0], 0, 0)
    rt.buf_free(&z)
    mem.heap_free(raw, raw_n)
    mem.heap_free(prev, stride)
    mem.heap_free(cur, stride)
    mem.heap_free(best, stride)
    return true
}

#[no_gc]
fn unpremul(v: u32, a: u32) -> u32 {
    let r: u32 = (v * 255 + a / 2) / a
    if r > 255 as u32 {
        return 255
    }
    return r
}

#[no_gc]
fn put_be32(p: *mut u8, off: usize, v: u32) {
    *((p as u64 + off as u64) as *mut u8) = ((v >> 24) & 255 as u32) as u8
    *((p as u64 + off as u64 + 1) as *mut u8) = ((v >> 16) & 255 as u32) as u8
    *((p as u64 + off as u64 + 2) as *mut u8) = ((v >> 8) & 255 as u32) as u8
    *((p as u64 + off as u64 + 3) as *mut u8) = (v & 255 as u32) as u8
}

#[no_gc]
fn at(p: *mut u8, i: usize) -> u32 {
    let v: u8 = *((p as u64 + i as u64) as *mut u8)
    return v as u32
}

// The five filters of PNG 9.2, in the encoding direction.
#[no_gc]
fn filt(f: u32, cur: *mut u8, prev: *mut u8, i: usize, stride: usize) -> u8 {
    let x: u32 = at(cur, i)
    var a: u32 = 0
    if i >= 4 {
        a = at(cur, i - 4)
    }
    let b: u32 = at(prev, i)
    var c: u32 = 0
    if i >= 4 {
        c = at(prev, i - 4)
    }
    if f == 0 as u32 {
        return x as u8
    }
    if f == 1 as u32 {
        return ((x -% a) & 255 as u32) as u8
    }
    if f == 2 as u32 {
        return ((x -% b) & 255 as u32) as u8
    }
    if f == 3 as u32 {
        return ((x -% ((a + b) / 2)) & 255 as u32) as u8
    }
    return ((x -% (paeth(a as i32, b as i32, c as i32) as u32)) &
        255 as u32) as u8
}

// ------------------------------------------------------- PNG, the way in

struct Image {
    px: *mut u8, // w * h * 4, STRAIGHT RGBA
    w: usize,
    h: usize,
    cap: usize,
    ok: usize,
}

#[no_gc]
fn image_new() -> Image {
    return Image { px: 0 as *mut u8, w: 0, h: 0, cap: 0, ok: 0 }
}

#[no_gc]
fn image_free(im: *mut Image) {
    mem.heap_free((*im).px, (*im).cap)
    (*im).px = 0 as *mut u8
    (*im).ok = 0
}

#[no_gc]
fn image_ok(im: *mut Image) -> bool {
    return (*im).ok != 0
}

#[no_gc]
fn image_width(im: *mut Image) -> usize {
    return (*im).w
}

#[no_gc]
fn image_height(im: *mut Image) -> usize {
    return (*im).h
}

// STRAIGHT RGBA as 0xAARRGGBB.
#[no_gc]
fn image_pixel(im: *mut Image, x: usize, y: usize) -> u32 {
    if (*im).ok == 0 || x >= (*im).w || y >= (*im).h {
        return 0 as u32
    }
    let p: u64 = (*im).px as u64 + ((y * (*im).w + x) * 4) as u64
    return (at((*im).px, (y * (*im).w + x) * 4 + 3) << 24) |
    (at((*im).px, (y * (*im).w + x) * 4) << 16) |
    (at((*im).px, (y * (*im).w + x) * 4 + 1) << 8) |
    at((*im).px, (y * (*im).w + x) * 4 + 2)
}

fn rd_be32(p: u64, off: usize) -> u32 {
    return ((rt.ld8(p, off) as u32) << 24) | ((rt.ld8(p, off + 1) as u32) << 16) |
    ((rt.ld8(p, off + 2) as u32) << 8) | (rt.ld8(p, off + 3) as u32)
}

// PNG IN: every colour type and bit depth the specification has, Adam7
// interlacing, and the transparency chunks. Written for the pictures a
// launcher meets (Modrinth mod icons: 78 % are palette PNGs, the rest grey,
// RGB and RGBA), held against Pillow (libpng) by tools/libmvp/check_png.py.
//
//   colour type 0 grey          1, 2, 4, 8, 16 bits   (+ tRNS colour key)
//   colour type 2 RGB           8, 16 bits            (+ tRNS colour key)
//   colour type 3 palette       1, 2, 4, 8 bits       (PLTE + tRNS alpha)
//   colour type 4 grey + alpha  8, 16 bits
//   colour type 6 RGBA          8, 16 bits
//   interlace method 0 and 1 (Adam7)
//
// The result is STRAIGHT RGBA, 8 bits per channel. Samples of 16 bits keep
// their high octet (libpng's strip_16, what browsers do); samples of 1, 2
// and 4 bits grey are scaled to 0..255 (v * 255 / (2^bits - 1)); an index
// beyond the palette is black; gamma, sRGB and ICC chunks are ignored, an
// APNG shows its default image (the IDAT frames).
//
// HOSTILE INPUT: the size is checked against `max_pixels` before any pixel
// memory is asked for; the decompressed data is limited to exactly what the
// header promises (a small file cannot inflate to gigabytes); every chunk
// that is used must have the right CRC-32; anything cut, inconsistent or
// unknown gives `false` and no picture.
const PNG_MAX_PIXELS: u64 = 16777216

fn decode_png(src: u64, n: usize, im: *mut Image) -> bool {
    return decode_png_limited(src, n, PNG_MAX_PIXELS, im)
}

// the sample `i` of a row at `depth` bits (1, 2, 4, 8 or 16)
#[no_gc]
fn smp(line: *mut u8, i: usize, depth: u32) -> u32 {
    if depth == 8 as u32 {
        return at(line, i)
    }
    if depth == 16 as u32 {
        return (at(line, i * 2) << 8) | at(line, i * 2 + 1)
    }
    let bit: usize = i * (depth as usize)
    let sh: u32 = 8 as u32 - depth - ((bit & 7) as u32)
    return (at(line, bit >> 3) >> sh) & ((1 as u32 << depth) - 1 as u32)
}

// a sample as 0..255: 16 bits keep the high octet, fewer than 8 are scaled
#[no_gc]
fn to8(v: u32, depth: u32) -> u32 {
    if depth == 16 as u32 {
        return v >> 8
    }
    if depth == 8 as u32 {
        return v
    }
    return v * 255 as u32 / ((1 as u32 << depth) - 1 as u32)
}

fn decode_png_limited(src: u64, n: usize, max_pixels: u64, im: *mut Image) -> bool {
    (*im).ok = 0
    if n < 33 {
        return false
    }
    // 89 50 4E 47 0D 0A 1A 0A
    if rt.ld8(src, 0) as u32 != 137 as u32 || rt.ld8(src, 1) as u32 != 80 as u32 ||
    rt.ld8(src, 2) as u32 != 78 as u32 || rt.ld8(src, 3) as u32 != 71 as u32 ||
    rt.ld8(src, 4) as u32 != 13 as u32 || rt.ld8(src, 5) as u32 != 10 as u32 ||
    rt.ld8(src, 6) as u32 != 26 as u32 || rt.ld8(src, 7) as u32 != 10 as u32 {
        return false
    }
    var crctab: deflate.CrcTable = deflate.crc_table()
    var off: usize = 8
    var w: usize = 0
    var h: usize = 0
    var ctype: u32 = 0
    var depth: u32 = 0
    var interlace: u32 = 0
    var pal: [u8; 768] = [0; 768]
    var pal_n: usize = 0
    var trns: [u8; 256] = [0; 256]
    var trns_n: usize = 0
    var idat: rt.Buf = rt.buf_new()
    var seen_ihdr: bool = false
    var seen_idat: bool = false
    var seen_iend: bool = false
    var ok: bool = true
    while ok && !seen_iend && off + 12 <= n {
        let len: usize = rd_be32(src, off) as usize
        let t0: u32 = rt.ld8(src, off + 4) as u32
        let t1: u32 = rt.ld8(src, off + 5) as u32
        let t2: u32 = rt.ld8(src, off + 6) as u32
        let t3: u32 = rt.ld8(src, off + 7) as u32
        let body: usize = off + 8
        if len > 2147483647 || body + len + 4 > n {
            ok = false
            break
        }
        let is_ihdr: bool = t0 == 73 as u32 && t1 == 72 as u32 && t2 == 68 as u32 && t3 == 82 as u32
        let is_plte: bool = t0 == 80 as u32 && t1 == 76 as u32 && t2 == 84 as u32 && t3 == 69 as u32
        let is_trns: bool = t0 == 116 as u32 && t1 == 82 as u32 && t2 == 78 as u32 && t3 == 83 as u32
        let is_idat: bool = t0 == 73 as u32 && t1 == 68 as u32 && t2 == 65 as u32 && t3 == 84 as u32
        let is_iend: bool = t0 == 73 as u32 && t1 == 69 as u32 && t2 == 78 as u32 && t3 == 68 as u32
        if !seen_ihdr && !is_ihdr {
            ok = false // IHDR comes first
            break
        }
        if is_ihdr || is_plte || is_trns || is_idat {
            // the CRC-32 over the type and the data
            let c: u32 = deflate.crc32_more(&crctab, 0 as u32, src + (off + 4) as u64, len + 4)
            if c != rd_be32(src, body + len) {
                ok = false
                break
            }
        }
        if is_ihdr {
            if seen_ihdr || len != 13 {
                ok = false
                break
            }
            w = rd_be32(src, body) as usize
            h = rd_be32(src, body + 4) as usize
            depth = rt.ld8(src, body + 8) as u32
            ctype = rt.ld8(src, body + 9) as u32
            interlace = rt.ld8(src, body + 12) as u32
            if rt.ld8(src, body + 10) as u32 != 0 as u32 || rt.ld8(src, body + 11) as u32 != 0 as u32 ||
            interlace > 1 as u32 {
                ok = false
                break
            }
            seen_ihdr = true
        } else if is_plte {
            if seen_idat || len % 3 != 0 || len == 0 || len > 768 {
                ok = false
                break
            }
            pal_n = len / 3
            var i: usize = 0
            while i < len {
                pal[i] = rt.ld8(src, body + i)
                i = i + 1
            }
        } else if is_trns {
            if seen_idat || len > 256 {
                ok = false
                break
            }
            trns_n = len
            var i: usize = 0
            while i < len {
                trns[i] = rt.ld8(src, body + i)
                i = i + 1
            }
        } else if is_idat {
            seen_idat = true
            if rt.buf_len(&idat) + len > 1073741824 {
                ok = false
                break
            }
            rt.buf_push_bytes(&idat, src + body as u64, len)
        } else if is_iend {
            seen_iend = true
        }
        off = body + len + 4
    }
    if !ok || !seen_ihdr || !seen_idat || w == 0 || h == 0 {
        rt.buf_free(&idat)
        return false
    }
    // the colour type and depth must go together
    var channels: usize = 0
    if ctype == 0 as u32 {
        channels = 1
        if depth != 1 as u32 && depth != 2 as u32 && depth != 4 as u32 && depth != 8 as u32 && depth != 16 as u32 {
            ok = false
        }
    } else if ctype == 2 as u32 {
        channels = 3
        if depth != 8 as u32 && depth != 16 as u32 { ok = false }
    } else if ctype == 3 as u32 {
        channels = 1
        if depth != 1 as u32 && depth != 2 as u32 && depth != 4 as u32 && depth != 8 as u32 { ok = false }
        if pal_n == 0 { ok = false }
    } else if ctype == 4 as u32 {
        channels = 2
        if depth != 8 as u32 && depth != 16 as u32 { ok = false }
    } else if ctype == 6 as u32 {
        channels = 4
        if depth != 8 as u32 && depth != 16 as u32 { ok = false }
    } else {
        ok = false
    }
    if !ok || (w as u64) * (h as u64) > max_pixels || w > 65535 * 16 || h > 65535 * 16 {
        rt.buf_free(&idat)
        return false
    }
    let bits: usize = channels * (depth as usize) // bits per pixel
    var bpp: usize = bits / 8 // bytes per pixel for the filters
    if bpp == 0 {
        bpp = 1
    }
    // the passes: Adam7 (7 passes) or the one pass over the whole picture
    var npass: usize = 1
    // Adam7: x0, y0, dx, dy of the seven passes; without interlacing the
    // first pass is the whole picture
    var sx: [usize; 7] = [0, 4, 0, 2, 0, 1, 0]
    var dx: [usize; 7] = [8, 8, 4, 4, 2, 2, 1]
    var sy: [usize; 7] = [0, 0, 4, 0, 2, 0, 1]
    var dy: [usize; 7] = [8, 8, 8, 4, 4, 2, 2]
    if interlace == 1 as u32 {
        npass = 7
    } else {
        dx[0] = 1
        dy[0] = 1
    }
    // how many raw octets the header promises (and so the most we inflate)
    var expect: usize = 0
    var q: usize = 0
    while q < npass {
        let pw: usize = (w + dx[q] - 1 - sx[q]) / dx[q]
        let ph: usize = (h + dy[q] - 1 - sy[q]) / dy[q]
        if w > sx[q] && h > sy[q] && pw > 0 && ph > 0 {
            expect = expect + ((pw * bits + 7) / 8 + 1) * ph
        }
        q = q + 1
    }
    // zlib: CMF (deflate, window <= 32K), FLG (check bits, no dictionary)
    let zn: usize = rt.buf_len(&idat)
    let zp: u64 = rt.buf_ptr(&idat)
    if zn < 3 || (rt.ld8(zp, 0) as u32 & 15 as u32) != 8 as u32 ||
    (rt.ld8(zp, 0) as u32 >> 4) > 7 as u32 || (((rt.ld8(zp, 0) as u32) << 8) + (rt.ld8(zp, 1) as u32)) % 31 as u32 != 0 as u32 ||
    (rt.ld8(zp, 1) as u32 & 32 as u32) != 0 as u32 {
        rt.buf_free(&idat)
        return false
    }
    var raw: rt.Buf = rt.buf_new()
    let got: usize = deflate.inflate_limited(zp + 2, zn - 2, expect, &raw) catch 0
    rt.buf_free(&idat)
    if got < expect {
        rt.buf_free(&raw)
        return false
    }
    let cap: usize = w * h * 4
    let px: *mut u8 = mem.heap_alloc(cap)
    if px as usize == 0 {
        rt.buf_free(&raw)
        return false
    }
    let maxrow: usize = (w * bits + 7) / 8
    let line: *mut u8 = mem.heap_alloc(maxrow + 8)
    let prev: *mut u8 = mem.heap_alloc(maxrow + 8)
    if line as usize == 0 || prev as usize == 0 {
        mem.heap_free(px, cap)
        mem.heap_free(line, maxrow + 8)
        mem.heap_free(prev, maxrow + 8)
        rt.buf_free(&raw)
        return false
    }
    // tRNS colour key of a grey or RGB picture (16-bit sample values)
    var key_on: bool = false
    var kr: u32 = 0
    var kg: u32 = 0
    var kb: u32 = 0
    if ctype == 0 as u32 && trns_n >= 2 {
        key_on = true
        kr = ((trns[0] as u32) << 8) | (trns[1] as u32)
    } else if ctype == 2 as u32 && trns_n >= 6 {
        key_on = true
        kr = ((trns[0] as u32) << 8) | (trns[1] as u32)
        kg = ((trns[2] as u32) << 8) | (trns[3] as u32)
        kb = ((trns[4] as u32) << 8) | (trns[5] as u32)
    }
    let rawp: u64 = rt.buf_ptr(&raw)
    var rp: usize = 0 // read position in the raw data
    var bad: bool = false
    q = 0
    while q < npass && !bad {
        let pw: usize = (w + dx[q] - 1 - sx[q]) / dx[q]
        let ph: usize = (h + dy[q] - 1 - sy[q]) / dy[q]
        if w <= sx[q] || h <= sy[q] || pw == 0 || ph == 0 {
            q = q + 1
            continue
        }
        let rowb: usize = (pw * bits + 7) / 8
        var i0: usize = 0
        while i0 < rowb + 8 {
            *((prev as u64 + i0 as u64) as *mut u8) = 0 as u8
            i0 = i0 + 1
        }
        var y: usize = 0
        while y < ph && !bad {
            let f: u32 = rt.ld8(rawp, rp) as u32
            if f > 4 as u32 {
                bad = true
                break
            }
            var i: usize = 0
            while i < rowb {
                let x0: u32 = rt.ld8(rawp, rp + 1 + i) as u32
                var a: u32 = 0
                var c: u32 = 0
                if i >= bpp {
                    a = at(line, i - bpp)
                    c = at(prev, i - bpp)
                }
                let b: u32 = at(prev, i)
                var v: u32 = x0
                if f == 1 as u32 {
                    v = (x0 + a) & 255 as u32
                } else if f == 2 as u32 {
                    v = (x0 + b) & 255 as u32
                } else if f == 3 as u32 {
                    v = (x0 + (a + b) / 2) & 255 as u32
                } else if f == 4 as u32 {
                    v = (x0 + (paeth(a as i32, b as i32, c as i32) as u32)) & 255 as u32
                }
                *((line as u64 + i as u64) as *mut u8) = v as u8
                i = i + 1
            }
            rp = rp + rowb + 1
            // the pixels of this row, into their places
            let oy: usize = sy[q] + y * dy[q]
            var x: usize = 0
            while x < pw {
                var r: u32 = 0
                var g: u32 = 0
                var bl: u32 = 0
                var al: u32 = 255
                if ctype == 0 as u32 {
                    let v: u32 = smp(line, x, depth)
                    r = to8(v, depth)
                    g = r
                    bl = r
                    if key_on && v == kr { al = 0 }
                } else if ctype == 2 as u32 {
                    let vr: u32 = smp(line, x * 3, depth)
                    let vg: u32 = smp(line, x * 3 + 1, depth)
                    let vb: u32 = smp(line, x * 3 + 2, depth)
                    r = to8(vr, depth)
                    g = to8(vg, depth)
                    bl = to8(vb, depth)
                    if key_on && vr == kr && vg == kg && vb == kb { al = 0 }
                } else if ctype == 3 as u32 {
                    let idx: usize = smp(line, x, depth) as usize
                    if idx < pal_n {
                        r = pal[idx * 3] as u32
                        g = pal[idx * 3 + 1] as u32
                        bl = pal[idx * 3 + 2] as u32
                    }
                    if idx < trns_n {
                        al = trns[idx] as u32
                    }
                } else if ctype == 4 as u32 {
                    r = to8(smp(line, x * 2, depth), depth)
                    g = r
                    bl = r
                    al = to8(smp(line, x * 2 + 1, depth), depth)
                } else {
                    r = to8(smp(line, x * 4, depth), depth)
                    g = to8(smp(line, x * 4 + 1, depth), depth)
                    bl = to8(smp(line, x * 4 + 2, depth), depth)
                    al = to8(smp(line, x * 4 + 3, depth), depth)
                }
                let ox: usize = sx[q] + x * dx[q]
                let o: u64 = px as u64 + ((oy * w + ox) * 4) as u64
                *(o as *mut u8) = r as u8
                *((o + 1) as *mut u8) = g as u8
                *((o + 2) as *mut u8) = bl as u8
                *((o + 3) as *mut u8) = al as u8
                x = x + 1
            }
            mem.mem_copy(prev, line, rowb)
            y = y + 1
        }
        q = q + 1
    }
    mem.heap_free(line, maxrow + 8)
    mem.heap_free(prev, maxrow + 8)
    rt.buf_free(&raw)
    if bad {
        mem.heap_free(px, cap)
        return false
    }
    (*im).px = px
    (*im).cap = cap
    (*im).w = w
    (*im).h = h
    (*im).ok = 1
    return true
}
