// SPDX-License-Identifier: MPL-2.0
// lib/fuishell/dockpaint.fi -- draws a dock.Dock (and a dock.Split) with
// fUi's painter: the tab strips, the tabs with their titles, the splitter
// bars, and the hint where a dragged tab would land.
//
// OpenPlan LIB-005. dock.fi is the model and draws nothing (so that it can
// be checked without a window); this file is the look that goes with it,
// in the theme's colours:
//
//     dockpaint.dock_paint(&d, &z, theme.theme_colors(&m), 13.0)
//     // then every panel draws into dock.dock_content(&d, p),
//     // the drawing into dock.dock_center(&d)
//
// What it draws, back to front:
//   - every area that takes space: its ground (`base`), and -- when it
//     holds panels -- a tab strip (`surface`) with a separator line under it;
//   - every visible tab: the active one on `base` with a 2 px accent line
//     on top and its title in `text`, the others with the title in
//     `text_muted`; a title too long for its tab ends in an ellipsis;
//   - the splitter bars in `separator`;
//   - while a tab is dragged: the landing area veiled in the accent colour
//     with an accent frame. A side that is still empty gets a strip at the
//     edge of the whole space, a fifth of it wide (or high).
//
// Pixels are whole numbers in the model; the painter takes them as f64.

import fuishell.dock
import fui.layout
import fui.painter
import fui.theme

export {
    dock_paint, split_paint, hint_rect,
}

const PAD: f64 = 8.0 // text inset inside a tab
const ACCENT_LINE: f64 = 2.0
const VEIL_ALPHA: u32 = 72 // of 255: the drop hint lets the panel show through

fn fill(z: *mut painter.Painter, r: layout.Rect, col: u32) {
    if r.w <= 0 || r.h <= 0 {
        return
    }
    painter.surface(z, r.x as f64, r.y as f64, r.w as f64, r.h as f64, col)
}

fn has_panels(d: *mut dock.Dock, area: u32) -> bool {
    var i: u32 = 0
    while i < dock.dock_panel_count(d) {
        if dock.dock_area_of(d, i) == area && dock.dock_is_visible(d, i) {
            return true
        }
        i = i + 1
    }
    return false
}

// Where the drop hint goes for `area`: the area itself when it takes
// space, otherwise a strip at the matching edge of the whole space.
fn hint_rect(d: *mut dock.Dock, area: u32) -> layout.Rect {
    if area > dock.AREA_CENTER {
        return layout.rect_new(0, 0, 0, 0)
    }
    let r: layout.Rect = dock.dock_area_rect(d, area)
    if r.w > 0 && r.h > 0 {
        return r
    }
    let wh: layout.Rect = dock.dock_whole(d)
    if area == dock.AREA_LEFT {
        return layout.rect_new(wh.x, wh.y, wh.w / 5, wh.h)
    }
    if area == dock.AREA_RIGHT {
        return layout.rect_new(wh.x + wh.w - wh.w / 5, wh.y, wh.w / 5, wh.h)
    }
    if area == dock.AREA_BOTTOM {
        return layout.rect_new(wh.x, wh.y + wh.h - wh.h / 5, wh.w, wh.h / 5)
    }
    return dock.dock_whole(d)
}

fn paint_tab(d: *mut dock.Dock, z: *mut painter.Painter, c: *mut theme.Colors, p: u32, size: f64) {
    let t: layout.Rect = dock.dock_tab(d, p)
    if t.w <= 0 || t.h <= 0 {
        return
    }
    let area: u32 = dock.dock_area_of(d, p)
    let active: bool = dock.dock_active(d, area) == p as i64
    var col: u32 = (*c).text_muted
    if active {
        fill(z, t, (*c).base)
        painter.surface(z, t.x as f64, t.y as f64, t.w as f64, ACCENT_LINE, (*c).accent)
        col = (*c).text
    }
    // the thin divider at the right end of every tab
    painter.surface(z, (t.x + t.w - 1) as f64, (t.y + 6) as f64, 1.0, (t.h - 12) as f64, (*c).separator)
    let title: str = dock.dock_title(d, p)
    let w: f64 = t.w as f64 - 2.0 * PAD
    if w <= 0.0 || title.n == 0 {
        return
    }
    let by: f64 = painter.text_baseline_mid(z, t.y as f64, t.h as f64, size)
    var run: painter.TextRun = painter.run_new(size)
    painter.run_draw_ellipsis(z, &run, t.x as f64 + PAD, by, w, col, title.p as u64, title.n, painter.TEXT_L)
}

// Draws the whole dock as laid out by dock_layout. `size` is the tab
// title's font size in pixels.
fn dock_paint(d: *mut dock.Dock, z: *mut painter.Painter, c: *mut theme.Colors, size: f64) {
    let th: i64 = dock.dock_tab_h(d)
    var a: u32 = 0
    while a <= dock.AREA_CENTER {
        let r: layout.Rect = dock.dock_area_rect(d, a)
        if r.w > 0 && r.h > 0 {
            fill(z, r, (*c).base)
            if has_panels(d, a) {
                fill(z, layout.rect_new(r.x, r.y, r.w, th), (*c).surface)
                painter.surface(z, r.x as f64, (r.y + th - 1) as f64, r.w as f64, 1.0, (*c).separator)
            }
        }
        a = a + 1
    }
    var i: u32 = 0
    while i < dock.dock_panel_count(d) {
        if dock.dock_is_visible(d, i) {
            paint_tab(d, z, c, i, size)
        }
        i = i + 1
    }
    var b: u32 = 0
    while b <= dock.AREA_BOTTOM {
        fill(z, dock.dock_splitter(d, b), (*c).separator)
        b = b + 1
    }
    let h: u32 = dock.dock_drop_hint(d)
    if h != dock.AREA_NONE {
        let hr: layout.Rect = hint_rect(d, h)
        let acc: u32 = (*c).accent
        fill(z, hr, (acc & 16777215 as u32) | (VEIL_ALPHA << 24))
        let x: f64 = hr.x as f64
        let y: f64 = hr.y as f64
        let w: f64 = hr.w as f64
        let hh: f64 = hr.h as f64
        painter.surface(z, x, y, w, ACCENT_LINE, acc)
        painter.surface(z, x, y + hh - ACCENT_LINE, w, ACCENT_LINE, acc)
        painter.surface(z, x, y, ACCENT_LINE, hh, acc)
        painter.surface(z, x + w - ACCENT_LINE, y, ACCENT_LINE, hh, acc)
    }
}

// The free-standing splitter: only its bar (the two halves belong to the
// program).
fn split_paint(s: *mut dock.Split, z: *mut painter.Painter, c: *mut theme.Colors) {
    fill(z, dock.split_bar(s), (*c).separator)
}
