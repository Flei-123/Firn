export { face, mono }

const INTER_REGULAR: str = __include_str("../../fui/fonts/Inter-Regular.ttf")
const INTER_MEDIUM: str = __include_str("../../fui/fonts/Inter-Medium.ttf")
const INTER_SEMIBOLD: str = __include_str("../../fui/fonts/Inter-SemiBold.ttf")
const INTER_BOLD: str = __include_str("../../fui/fonts/Inter-Bold.ttf")
const MONO_FACE: str = __include_str("../../fui/fonts/DejaVuSansMono.ttf")

fn face(i: usize) -> str {
    if i == 0 { return INTER_REGULAR }
    if i == 1 { return INTER_MEDIUM }
    if i == 2 { return INTER_SEMIBOLD }
    if i == 3 { return INTER_BOLD }
    return ""
}

fn mono() -> str {
    return MONO_FACE
}
