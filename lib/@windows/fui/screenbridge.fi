import std.rt
import fui.screenax
import fui.screenaxtree
import fui.apphost
import fui.uiacom

export { enable }

struct Bridge {
    tree: *mut screenaxtree.Tree,
    ud: u64,
    act: fn(u64, usize) -> bool,
    focus: fn(u64, usize) -> bool,
    click: fn(u64, f64, f64) -> bool,
    setnum: fn(u64, usize, i64) -> bool,
    settext: fn(u64, usize, str) -> bool,
}

fn reg_of(ud: u64, node: usize) -> usize {
    let b: *mut Bridge = ud as *mut Bridge
    return screenaxtree.reg_of_node((*b).tree, node)
}

fn bridge_act(ud: u64, node: usize) -> bool {
    let b: *mut Bridge = ud as *mut Bridge
    let r: usize = reg_of(ud, node)
    if r == screenax.NONE { return false }
    return ((*b).act)((*b).ud, r)
}

fn bridge_focus(ud: u64, node: usize) -> bool {
    let b: *mut Bridge = ud as *mut Bridge
    let r: usize = reg_of(ud, node)
    if r == screenax.NONE { return false }
    return ((*b).focus)((*b).ud, r)
}

fn bridge_click(ud: u64, x: f64, y: f64) -> bool {
    let b: *mut Bridge = ud as *mut Bridge
    return ((*b).click)((*b).ud, x, y)
}

fn bridge_setnum(ud: u64, node: usize, v: i64) -> bool {
    let b: *mut Bridge = ud as *mut Bridge
    let r: usize = reg_of(ud, node)
    if r == screenax.NONE { return false }
    return ((*b).setnum)((*b).ud, r, v)
}

#[allow_escape]
fn bridge_settext(ud: u64, node: usize, t: str) -> bool {
    let b: *mut Bridge = ud as *mut Bridge
    let r: usize = reg_of(ud, node)
    if r == screenax.NONE { return false }
    return ((*b).settext)((*b).ud, r, t)
}

fn opened(ud: u64, win: u64) {
    let ok: bool = uiacom.source_attach(win)
}

fn no_hotkey(ud: u64, id: u32) {}

#[allow_escape]
fn enable(hk: *mut apphost.Hooks, t: *mut screenaxtree.Tree, title: str, ud: u64, act: fn(u64, usize) -> bool, focus: fn(u64, usize) -> bool, click: fn(u64, f64, f64) -> bool, setnum: fn(u64, usize, i64) -> bool, settext: fn(u64, usize, str) -> bool, setcaret: fn(u64, usize, usize, usize) -> bool) -> bool {
    let b: *mut Bridge = rt.heap_alloc(96) as *mut Bridge
    if (b as u64) == 0 { return false }
    (*b).tree = t
    (*b).ud = ud
    (*b).act = act
    (*b).focus = focus
    (*b).click = click
    (*b).setnum = setnum
    (*b).settext = settext
    if !uiacom.source_bind(screenaxtree.tree_scene(t), screenaxtree.tree_ax(t), title, b as u64, bridge_act, bridge_focus, bridge_click, bridge_setnum, bridge_settext) {
        return false
    }
    apphost.hooks_set_window(hk, 0, opened, no_hotkey)
    return true
}
