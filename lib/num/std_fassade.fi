// lib/num/std_fassade.fi — Zahl <-> Text fuer die std-Fassade (Runde 42).
//
// NUR fuer `lib/std/num.fi`: eingebunden ausschliesslich von
// `tools/strlib/src/std_num.fi`. lib/num (bignum/dtoa/strtod) bleibt
// unveraendert; wer die Einbindungs-Bibliothek ohne std benutzt, bekommt
// kein Byte mehr Code.
//
// EINE REGEL FUER DIE RICHTUNG, an jedem Namen ablesbar:
//   * `schreibe_*` nimmt eine Zahl und HAENGT ihren Text an ein `*mut Bytes`
//     an. Nie wird dabei geleert — mehrere Aufrufe bauen eine Zeile.
//   * `lies_*` nimmt Text und liefert die Zahl. Rueckgabe ist die Zahl der
//     VERBRAUCHTEN Oktette (0 = da stand keine Zahl); der Wert kommt ueber
//     einen Ausgabezeiger. So kann der Aufrufer weiterlesen, wo die Zahl
//     aufhoert — das braucht jeder Zerleger.
//   * `text_zu_*` ist die strenge Form: der GANZE Text muss die Zahl sein,
//     sonst `false`. Das ist, was man beim Auswerten eines Arguments will.
//
// UEBERLAUF WIRD GEMELDET, nicht verschwiegen: die `lies_*`-Formen tragen
// einen `ueberlauf`-Ausgabezeiger, die `text_zu_*`-Formen geben dann
// `false`. Firn hat in Stufe 0 keine Ueberlaufpruefung in der Arithmetik
// (SPEC §14.1.3) — beim Einlesen fremder Eingaben waere ein stiller Umbruch
// eine Sicherheitsluecke, kein Schoenheitsfehler.
//
// Gleitkomma laeuft ueber die bereits vorhandenen, exakten Kerne dieses
// Moduls: `dtoa` (kuerzester ruecklesbarer Text) und `strtod` (korrekt
// gerundet). Neu ist nur die Huelle darum: seit Runde 30 gibt es `f64`
// wirklich, also nimmt und liefert die Fassade `f64` statt Bitmuster.
// Die Bitmuster-Formen bleiben daneben stehen.

// ------------------------------------------------------------- Grenzen
//
// Als Funktionen, weil `const` in Stufe 0 ganzzahlig (i64) ausgewertet wird
// und 2^64-1 dort nicht darstellbar ist.

fn u64_max() -> u64 {
    var x: u64 = 0
    return x - 1
}

fn i64_max() -> i64 {
    return 9223372036854775807
}

fn i64_min() -> i64 {
    return 0 - 9223372036854775807 - 1
}

// ------------------------------------------------------- Zahl -> Text

// Wert einer Ziffer in Basis <= 36, sonst -1. Gross und klein gelten gleich.
fn ziffernwert(c: u8) -> i32 {
    if c >= 48 as u8 && c <= 57 as u8 {
        return (c - 48 as u8) as i32
    }
    if c >= 97 as u8 && c <= 122 as u8 {
        return (c - 97 as u8) as i32 + 10
    }
    if c >= 65 as u8 && c <= 90 as u8 {
        return (c - 65 as u8) as i32 + 10
    }
    return 0 - 1
}

// Zahl der Ziffern, die `v` in `basis` braucht (0 hat eine).
fn ziffernzahl(v: u64, basis: u32) -> usize {
    if basis < 2 || basis > 36 {
        return 0
    }
    if v == 0 {
        return 1
    }
    let b: u64 = basis as u64
    var x: u64 = v
    var n: usize = 0
    while x > 0 {
        x = x / b
        n = n + 1
    }
    return n
}

// Vorzeichenlos in beliebiger Basis 2..36, ohne Praefix.
// `gross` waehlt A-Z statt a-z.
fn schreibe_basis(aus: *mut Bytes, v: u64, basis: u32, gross: bool) {
    if basis < 2 || basis > 36 {
        return
    }
    if v == 0 {
        bytes_push(aus, 48 as u8)
        return
    }
    let b: u64 = basis as u64
    var d: [u8; 64] = [0 as u8; 64]
    var n: usize = 0
    var x: u64 = v
    while x > 0 {
        let z: u64 = x % b
        if z < 10 {
            d[n] = z as u8 + 48 as u8
        } else if gross {
            d[n] = z as u8 + 55 as u8
        } else {
            d[n] = z as u8 + 87 as u8
        }
        x = x / b
        n = n + 1
    }
    while n > 0 {
        n = n - 1
        bytes_push(aus, d[n])
    }
}

fn schreibe_u64(aus: *mut Bytes, v: u64) {
    schreibe_basis(aus, v, 10, false)
}

// Vorzeichenbehaftet. Am Rand (i64::MIN) geht der Betrag ueber u64 — `0 - v`
// waere dort ein Umbruch.
fn schreibe_i64(aus: *mut Bytes, v: i64) {
    if v < 0 {
        bytes_push(aus, 45 as u8)
        schreibe_basis(aus, (0 - (v + 1)) as u64 + 1, 10, false)
        return
    }
    schreibe_basis(aus, v as u64, 10, false)
}

// Hexadezimal, mindestens `mindest` Ziffern (links mit Nullen aufgefuellt).
// Kein "0x" — wer es will, schreibt es davor; so bleibt die Funktion in
// beiden Welten brauchbar.
fn schreibe_hex(aus: *mut Bytes, v: u64, mindest: usize) {
    let z: usize = ziffernzahl(v, 16)
    var i: usize = z
    while i < mindest {
        bytes_push(aus, 48 as u8)
        i = i + 1
    }
    schreibe_basis(aus, v, 16, false)
}

fn schreibe_hex_gross(aus: *mut Bytes, v: u64, mindest: usize) {
    let z: usize = ziffernzahl(v, 16)
    var i: usize = z
    while i < mindest {
        bytes_push(aus, 48 as u8)
        i = i + 1
    }
    schreibe_basis(aus, v, 16, true)
}

fn schreibe_binaer(aus: *mut Bytes, v: u64, mindest: usize) {
    let z: usize = ziffernzahl(v, 2)
    var i: usize = z
    while i < mindest {
        bytes_push(aus, 48 as u8)
        i = i + 1
    }
    schreibe_basis(aus, v, 2, false)
}

fn schreibe_oktal(aus: *mut Bytes, v: u64, mindest: usize) {
    let z: usize = ziffernzahl(v, 8)
    var i: usize = z
    while i < mindest {
        bytes_push(aus, 48 as u8)
        i = i + 1
    }
    schreibe_basis(aus, v, 8, false)
}

// Rechtsbuendig auf `breite`, links mit `fueller`. Laengere Zahlen werden
// NICHT abgeschnitten — eine gekuerzte Zahl waere eine falsche Zahl.
fn schreibe_breit_u64(aus: *mut Bytes, v: u64, breite: usize, fueller: u8) {
    let z: usize = ziffernzahl(v, 10)
    var i: usize = z
    while i < breite {
        bytes_push(aus, fueller)
        i = i + 1
    }
    schreibe_basis(aus, v, 10, false)
}

fn schreibe_breit_i64(aus: *mut Bytes, v: i64, breite: usize, fueller: u8) {
    var betrag: u64 = v as u64
    var z: usize = 0
    if v < 0 {
        betrag = (0 - (v + 1)) as u64 + 1
        z = 1
    }
    z = z + ziffernzahl(betrag, 10)
    var i: usize = z
    while i < breite {
        bytes_push(aus, fueller)
        i = i + 1
    }
    schreibe_i64(aus, v)
}

// ------------------------------------------------------- Text -> Zahl

// Ziffernfolge ab `ab` in Basis 2..36. Rueckgabe: Zahl der verbrauchten
// Oktette (0 = keine Ziffer). `ueberlauf` wird gesetzt, sobald der Wert
// nicht mehr in u64 passt; gelesen wird trotzdem bis zum Ende der Ziffern,
// damit der Aufrufer weiss, wo der Text weitergeht.
fn lies_u64_basis(p: *mut u8, n: usize, ab: usize, basis: u32, aus: *mut u64,
                  ueberlauf: *mut bool) -> usize {
    *aus = 0
    *ueberlauf = false
    if basis < 2 || basis > 36 {
        return 0
    }
    let b: u64 = basis as u64
    let grenze: u64 = u64_max() / b
    let restgrenze: u64 = u64_max() - grenze * b
    var w: u64 = 0
    var i: usize = ab
    var z: usize = 0
    while i < n {
        let d: i32 = ziffernwert(ld8(p, i))
        if d < 0 {
            i = n
        } else if (d as u32) >= basis {
            i = n
        } else {
            if w > grenze || (w == grenze && (d as u64) > restgrenze) {
                *ueberlauf = true
            }
            w = w * b + d as u64
            z = z + 1
            i = i + 1
        }
    }
    *aus = w
    return z
}

fn lies_u64(p: *mut u8, n: usize, ab: usize, aus: *mut u64,
            ueberlauf: *mut bool) -> usize {
    return lies_u64_basis(p, n, ab, 10, aus, ueberlauf)
}

// Mit Vorzeichen. `+` und `-` sind erlaubt, danach muss mindestens eine
// Ziffer stehen. Rueckgabe zaehlt das Vorzeichen mit.
fn lies_i64(p: *mut u8, n: usize, ab: usize, aus: *mut i64,
            ueberlauf: *mut bool) -> usize {
    *aus = 0
    *ueberlauf = false
    var i: usize = ab
    var negativ: bool = false
    if i < n {
        let c: u8 = ld8(p, i)
        if c == 45 as u8 {
            negativ = true
            i = i + 1
        } else if c == 43 as u8 {
            i = i + 1
        }
    }
    var betrag: u64 = 0
    var ue: bool = false
    let z: usize = lies_u64_basis(p, n, i, 10, &betrag, &ue)
    if z == 0 {
        return 0
    }
    if ue {
        *ueberlauf = true
    }
    if negativ {
        if betrag > 9223372036854775808 as u64 {
            *ueberlauf = true
            *aus = i64_min()
        } else if betrag == 9223372036854775808 as u64 {
            *aus = i64_min()
        } else {
            *aus = 0 - (betrag as i64)
        }
    } else {
        if betrag > 9223372036854775807 as u64 {
            *ueberlauf = true
            *aus = i64_max()
        } else {
            *aus = betrag as i64
        }
    }
    return i - ab + z
}

// Streng: der ganze Text muss die Zahl sein, kein Leerraum, kein Rest.
fn text_zu_u64_basis(p: *mut u8, n: usize, basis: u32, aus: *mut u64) -> bool {
    var ue: bool = false
    let z: usize = lies_u64_basis(p, n, 0, basis, aus, &ue)
    return z == n && z > 0 && !ue
}

fn text_zu_u64(p: *mut u8, n: usize, aus: *mut u64) -> bool {
    return text_zu_u64_basis(p, n, 10, aus)
}

fn text_zu_i64(p: *mut u8, n: usize, aus: *mut i64) -> bool {
    var ue: bool = false
    let z: usize = lies_i64(p, n, 0, aus, &ue)
    return z == n && z > 0 && !ue
}

// Mit Basispraefix: 0x/0X = 16, 0b/0B = 2, 0o/0O = 8, sonst 10.
// "0" allein bleibt 0 (kein Sonderfall fuer fuehrende Nullen — die sind
// dezimal, wie in jeder modernen Sprache).
fn text_zu_u64_auto(p: *mut u8, n: usize, aus: *mut u64) -> bool {
    if n >= 3 && ld8(p, 0) == 48 as u8 {
        let c: u8 = ld8(p, 1)
        if c == 120 as u8 || c == 88 as u8 {
            return text_zu_u64_basis((p as usize + 2) as *mut u8, n - 2, 16, aus)
        }
        if c == 98 as u8 || c == 66 as u8 {
            return text_zu_u64_basis((p as usize + 2) as *mut u8, n - 2, 2, aus)
        }
        if c == 111 as u8 || c == 79 as u8 {
            return text_zu_u64_basis((p as usize + 2) as *mut u8, n - 2, 8, aus)
        }
    }
    return text_zu_u64_basis(p, n, 10, aus)
}

// ----------------------------------------------------------- Gleitkomma
//
// Umdeutung des Bitmusters ueber den Speicher — Firn hat keinen
// Umdeutungsoperator, und `as` waere eine WERT-Umwandlung (1.0 as u64 = 1).

fn f64_bits(x: f64) -> u64 {
    var t: f64 = x
    return *(((&t) as usize) as *mut u64)
}

fn bits_f64(b: u64) -> f64 {
    var t: u64 = b
    return *(((&t) as usize) as *mut f64)
}

fn f64_ist_nan(x: f64) -> bool {
    return dtoa_is_nan(f64_bits(x))
}

fn f64_ist_unendlich(x: f64) -> bool {
    return dtoa_is_inf(f64_bits(x))
}

fn f64_ist_null(x: f64) -> bool {
    return dtoa_is_zero(f64_bits(x))
}

// true = negatives Vorzeichenbit (auch bei -0.0).
fn f64_vorzeichen(x: f64) -> bool {
    return dtoa_sign(f64_bits(x))
}

fn dtoa_arbeitsbytes() -> usize {
    return DTOA_WS_BYTES
}

fn strtod_arbeitsbytes() -> usize {
    return STRTOD_WS_BYTES
}

// Bitmuster als kuerzester ruecklesbarer Dezimaltext, ANGEHAENGT.
// `dtoa` selbst leert sein Ziel — deshalb geht der Weg ueber einen kurzen
// Zwischenpuffer. Rueckgabe false = kein Speicher.
//
// KOSTEN, ehrlich: ein `mmap` fuer den Arbeitsspeicher (14 KiB) und eins fuer
// den Zwischenpuffer je Aufruf. Wer viele Zahlen schreibt, ruft `dtoa`
// direkt mit eigenem Arbeitsspeicher — die Fassade ist die bequeme, nicht
// die schnelle Form.
fn schreibe_f64_bits(aus: *mut Bytes, bits: u64) -> bool {
    let ws: *mut u8 = heap_alloc(DTOA_WS_BYTES)
    if (ws as usize) == 0 {
        return false
    }
    var zwischen: Bytes = Bytes{ ptr: 0 as *mut u8, len: 0, cap: 0 }
    dtoa(bits, &zwischen, ws)
    bytes_append(aus, zwischen.ptr, zwischen.len)
    bytes_free(&zwischen)
    heap_free(ws, DTOA_WS_BYTES)
    return true
}

fn schreibe_f64(aus: *mut Bytes, x: f64) -> bool {
    return schreibe_f64_bits(aus, f64_bits(x))
}

// Text -> Bitmuster. Rueckgabe: verbrauchte Oktette (0 = keine Zahl).
// Erkannt wird [+-] ziffern [ . ziffern ] [ (e|E) [+-] ziffern ] — genau die
// Form, die `strtod` (lib/num/strtod.fi) korrekt gerundet liest.
fn lies_f64_bits(p: *mut u8, n: usize, aus: *mut u64) -> usize {
    *aus = 0
    let ws: *mut u8 = heap_alloc(STRTOD_WS_BYTES)
    if (ws as usize) == 0 {
        return 0
    }
    var verbraucht: usize = 0
    let bits: u64 = strtod(p, n, ws, &verbraucht)
    heap_free(ws, STRTOD_WS_BYTES)
    *aus = bits
    return verbraucht
}

fn lies_f64(p: *mut u8, n: usize, aus: *mut f64) -> usize {
    var bits: u64 = 0
    let z: usize = lies_f64_bits(p, n, &bits)
    *aus = bits_f64(bits)
    return z
}

fn text_zu_f64(p: *mut u8, n: usize, aus: *mut f64) -> bool {
    let z: usize = lies_f64(p, n, aus)
    return z == n && z > 0
}

fn text_zu_f64_bits(p: *mut u8, n: usize, aus: *mut u64) -> bool {
    let z: usize = lies_f64_bits(p, n, aus)
    return z == n && z > 0
}
