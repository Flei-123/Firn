// lib/num/core_comfort.fi -- reading a number out of a Span (round 73).
//
// The comfort layer of round 69 (`num.parse_i64(s) -> num.ParsedI64`), for
// the freestanding half of the library. Same shape, same core: `parse_*`
// calls exactly the `read_*` out of `lib/num/core_facade.fi` that
// `text_to_*` calls too. There is no second parser here that could drift
// away from the first.
//
// WHY THIS FILE EXISTS NEXT TO tools/strlib/src/num_comfort.fi, honestly:
// the round 69 version takes a `str.Span` -- it names the module `str`,
// which is exactly the module a kernel must not have. Inside
// `lib/std/core.fi` the `Span` is the local one out of
// `lib/str/core_facade.fi`, and Firn has no type aliases at stage 0 (SPEC
// 14), so the signature cannot be shared. What IS shared is everything
// below it: both call `read_i64`/`read_u64_base`, and those exist exactly
// once, in `lib/num/core_facade.fi`. The duplication is 40 lines of
// wrapper without an ounce of arithmetic in them.
//
// NO f64 HERE. `ParsedF64` would need a struct with an f64 field, and a
// struct like that needs `#[allow_fp]` in the kernel profile -- for a
// convenience that a kernel has no use for. Whoever wants floating point
// in `core` takes `text_to_f64_at` with scratch memory of his own; the
// `ParsedF64` form stays in `std.num`, where the FPU is nobody's problem.
//
// Include:  //#include lib/num/core_comfort.fi

// ---------------------------------------------------------- The results
//
// `ok` answers the only question the caller usually has: is `value` the
// number that was written there? `overflow` says WHY not, when the digits
// were fine but too many.

struct ParsedI64 {
    ok: bool,
    overflow: bool,
    value: i64,
}

struct ParsedU64 {
    ok: bool,
    overflow: bool,
    value: u64,
}

fn parsed_i64_none() -> ParsedI64 {
    return ParsedI64 { ok: false, overflow: false, value: 0 }
}

fn parsed_u64_none() -> ParsedU64 {
    return ParsedU64 { ok: false, overflow: false, value: 0 }
}

// ----------------------------------------------------------- The parsers
//
// STRICT, like `text_to_*`: the WHOLE span has to be the number. Blanks
// are not swallowed silently -- `s.trim()` is one call and says what it
// does.

fn parse_i64(s: Span) -> ParsedI64 {
    var v: i64 = 0
    var over: bool = false
    let used: usize = read_i64(s.p, s.n, 0, &v, &over)
    return ParsedI64 { ok: used == s.n && used > 0 && !over, overflow: over,
        value: v }
}

fn parse_u64_base(s: Span, base: u32) -> ParsedU64 {
    var v: u64 = 0
    var over: bool = false
    let used: usize = read_u64_base(s.p, s.n, 0, base, &v, &over)
    return ParsedU64 { ok: used == s.n && used > 0 && !over, overflow: over,
        value: v }
}

fn parse_u64(s: Span) -> ParsedU64 {
    return parse_u64_base(s, 10)
}

// With a base prefix: 0x/0X = 16, 0b/0B = 2, 0o/0O = 8, otherwise 10.
fn parse_u64_auto(s: Span) -> ParsedU64 {
    var v: u64 = 0
    let ok: bool = text_to_u64_auto(s.p, s.n, &v)
    return ParsedU64 { ok: ok, overflow: false, value: v }
}

// -------------------------------------------------------- Taking it apart

fn i64_or(r: ParsedI64, fallback: i64) -> i64 {
    if r.ok {
        return r.value
    }
    return fallback
}

fn u64_or(r: ParsedU64, fallback: u64) -> u64 {
    if r.ok {
        return r.value
    }
    return fallback
}

// The results are VALUES; their methods therefore take `self`.
impl ParsedI64 {
    fn value_or(self, fallback: i64) -> i64 { return i64_or(self, fallback) }
}

impl ParsedU64 {
    fn value_or(self, fallback: u64) -> u64 { return u64_or(self, fallback) }
}
