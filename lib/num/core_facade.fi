// lib/num/core_facade.fi -- text -> number WITHOUT an allocator (round 73).
//
// The reading half of `lib/num/std_facade.fi`. Every function here writes
// into memory that the CALLER holds and asks nobody for a byte:
// `read_u64_base`, `read_i64`, `text_to_i64`, `digit_count`, the digit
// tests and the bit pattern helpers of `f64`. That is why the file is
// included by `lib/std/core.fi` (usable under `profile kernel`) as well as
// by `lib/std/num.fi` (the full facade) -- ONE source text, no second
// parser that could drift apart from the first.
//
// WHAT IS NOT HERE: everything that PRODUCES text (`write_*` appends to a
// `*mut Bytes`), and everything that reaches for scratch memory on its own.
//
// FLOATING POINT WITHOUT A HIDDEN mmap. `strtod` (lib/num/strtod.fi)
// computes in exact big number arithmetic and needs `strtod_work_bytes()`
// octets of scratch memory. The convenient form in `std.num` fetches them
// with `mmap` -- which is exactly what a kernel must not do. The `_at`
// forms here therefore take the scratch memory as a PARAMETER: at the call
// site you see that it costs memory, and you see whose memory it is.
//
//     var ws: [u8; 12288] = [0; 12288]      // core.strtod_work_bytes()
//     var x: f64 = 0.0
//     if core.text_to_f64_at(s.p, s.n, &ws[0], &x) { ... }
//
// `#[allow_fp]` sits on every function that touches an f64: in the kernel
// profile the FPU/SSE registers belong to the interrupted thread (SPEC 2),
// so whoever calls one of them takes over the duty to save their state.
// The integer part of this file -- and that is the bigger part -- carries
// no such marking and costs a kernel nothing.
//
// Include:  //#include lib/num/core_facade.fi  (needs core_mem.fi, strtod.fi)

fn u64_max() -> u64 {
    // ROUND 72: 0 - 1 on an UNSIGNED type is a well-known way to spell
    // "every bit set" (u64::MAX) without writing the 20-digit literal --
    // deliberate wraparound, not a mistake, so `-%` says so explicitly.
    var x: u64 = 0
    return x -% 1
}

fn i64_max() -> i64 {
    return 9223372036854775807
}

fn i64_min() -> i64 {
    return 0 - 9223372036854775807 - 1
}

// ---------------------------------------------------------- Number -> text

// The value of a digit in base <= 36, otherwise -1. Upper and lower case count alike.
fn digit_value(c: u8) -> i32 {
    if c >= 48 as u8 && c <= 57 as u8 {
        return (c - 48 as u8) as i32
    }
    if c >= 97 as u8 && c <= 122 as u8 {
        return (c - 97 as u8) as i32 + 10
    }
    if c >= 65 as u8 && c <= 90 as u8 {
        return (c - 65 as u8) as i32 + 10
    }
    return 0 - 1
}

// How many digits `v` needs in `base` (0 needs one).
fn digit_count(v: u64, base: u32) -> usize {
    if base < 2 || base > 36 {
        return 0
    }
    if v == 0 {
        return 1
    }
    let b: u64 = base as u64
    var x: u64 = v
    var n: usize = 0
    while x > 0 {
        x = x / b
        n = n + 1
    }
    return n
}

// ---------------------------------------------------------- Text -> number

// A digit sequence starting at `ab` in base 2..36. Return value: the number
// of octets used up (0 = no digit). `overflow` is set as soon as the value
// no longer fits in a u64; it keeps reading to the end of the digits anyway,
// so that the caller knows where the text continues.
fn read_u64_base(p: *mut u8, n: usize, ab: usize, base: u32, out: *mut u64,
    overflow: *mut bool) -> usize {
    *out = 0
    *overflow = false
    if base < 2 || base > 36 {
        return 0
    }
    let b: u64 = base as u64
    let limit: u64 = u64_max() / b
    let rest_limit: u64 = u64_max() - limit * b
    var w: u64 = 0
    var i: usize = ab
    var z: usize = 0
    while i < n {
        let d: i32 = digit_value(ld8(p, i))
        if d < 0 {
            i = n
        } else if (d as u32) >= base {
            i = n
        } else {
            if w > limit || (w == limit && (d as u64) > rest_limit) {
                *overflow = true
            }
            // ROUND 72: the doc comment above says it plainly --
            // AFTER the first overflow (*overflow already set to
            // true above) this keeps accumulating on purpose, only
            // to consume the rest of the digit run; the value itself
            // is already known-wrong at that point, so `*%`/`+%`
            // wrapping instead of panicking is the intended shape.
            w = (w *% b) +% (d as u64)
            z = z + 1
            i = i + 1
        }
    }
    *out = w
    return z
}

fn read_u64(p: *mut u8, n: usize, ab: usize, out: *mut u64,
    overflow: *mut bool) -> usize {
    return read_u64_base(p, n, ab, 10, out, overflow)
}

// With a sign. `+` and `-` are allowed, and at least one digit has to
// follow. The return value counts the sign.
fn read_i64(p: *mut u8, n: usize, ab: usize, out: *mut i64,
    overflow: *mut bool) -> usize {
    *out = 0
    *overflow = false
    var i: usize = ab
    var negative: bool = false
    if i < n {
        let c: u8 = ld8(p, i)
        if c == 45 as u8 {
            negative = true
            i = i + 1
        } else if c == 43 as u8 {
            i = i + 1
        }
    }
    var abs: u64 = 0
    var ue: bool = false
    let z: usize = read_u64_base(p, n, i, 10, &abs, &ue)
    if z == 0 {
        return 0
    }
    if ue {
        *overflow = true
    }
    if negative {
        if abs > 9223372036854775808 as u64 {
            *overflow = true
            *out = i64_min()
        } else if abs == 9223372036854775808 as u64 {
            *out = i64_min()
        } else {
            *out = 0 - (abs as i64)
        }
    } else {
        if abs > 9223372036854775807 as u64 {
            *overflow = true
            *out = i64_max()
        } else {
            *out = abs as i64
        }
    }
    return i - ab + z
}

// Strict: the whole text has to be the number, no whitespace, no leftovers.
fn text_to_u64_base(p: *mut u8, n: usize, base: u32, out: *mut u64) -> bool {
    var ue: bool = false
    let z: usize = read_u64_base(p, n, 0, base, out, &ue)
    return z == n && z > 0 && !ue
}

fn text_to_u64(p: *mut u8, n: usize, out: *mut u64) -> bool {
    return text_to_u64_base(p, n, 10, out)
}

fn text_to_i64(p: *mut u8, n: usize, out: *mut i64) -> bool {
    var ue: bool = false
    let z: usize = read_i64(p, n, 0, out, &ue)
    return z == n && z > 0 && !ue
}

// With a base prefix: 0x/0X = 16, 0b/0B = 2, 0o/0O = 8, otherwise 10.
// A lone "0" stays 0 (no special case for leading zeros -- those are
// decimal, as in every modern language).
fn text_to_u64_auto(p: *mut u8, n: usize, out: *mut u64) -> bool {
    if n >= 3 && ld8(p, 0) == 48 as u8 {
        let c: u8 = ld8(p, 1)
        if c == 120 as u8 || c == 88 as u8 {
            return text_to_u64_base((p as usize + 2) as *mut u8, n - 2, 16, out)
        }
        if c == 98 as u8 || c == 66 as u8 {
            return text_to_u64_base((p as usize + 2) as *mut u8, n - 2, 2, out)
        }
        if c == 111 as u8 || c == 79 as u8 {
            return text_to_u64_base((p as usize + 2) as *mut u8, n - 2, 8, out)
        }
    }
    return text_to_u64_base(p, n, 10, out)
}

// ---------------------------------------------------------- Floating point
//
// Reinterpreting the bit pattern through memory -- Firn has no
// reinterpretation operator, and `as` would be a VALUE conversion (1.0 as u64 = 1).

#[allow_fp]
fn f64_bits(x: f64) -> u64 {
    var t: f64 = x
    return *(((&t) as usize) as *mut u64)
}

#[allow_fp]
fn bits_f64(b: u64) -> f64 {
    var t: u64 = b
    return *(((&t) as usize) as *mut f64)
}

#[allow_fp]
fn f64_is_nan(x: f64) -> bool {
    return dtoa_is_nan(f64_bits(x))
}

#[allow_fp]
fn f64_is_infinite(x: f64) -> bool {
    return dtoa_is_inf(f64_bits(x))
}

#[allow_fp]
fn f64_is_null(x: f64) -> bool {
    return dtoa_is_zero(f64_bits(x))
}

// true = the sign bit is negative (for -0.0 as well).
#[allow_fp]
fn f64_sign(x: f64) -> bool {
    return dtoa_sign(f64_bits(x))
}

// ROUND 71 -- the same four questions for an `f32`, and the reinterpretation
// in both directions. `as` would be a VALUE conversion (1.0 as u32 = 1);
// what is wanted here are the four octets themselves.

#[allow_fp]
fn f32_bits(x: f32) -> u32 {
    var t: f32 = x
    return *(((&t) as usize) as *mut u32)
}

#[allow_fp]
fn bits_f32(b: u32) -> f32 {
    var t: u32 = b
    return *(((&t) as usize) as *mut f32)
}

#[allow_fp]
fn f32_is_nan(x: f32) -> bool {
    return f32_bits_is_nan(f32_bits(x))
}

#[allow_fp]
fn f32_is_infinite(x: f32) -> bool {
    return f32_bits_is_inf(f32_bits(x))
}

#[allow_fp]
fn f32_is_null(x: f32) -> bool {
    return f32_bits_is_zero(f32_bits(x))
}

// true = the sign bit is negative (for -0.0 as well).
#[allow_fp]
fn f32_sign(x: f32) -> bool {
    return f32_bits_sign(f32_bits(x))
}

fn strtod_work_bytes() -> usize {
    return STRTOD_WS_BYTES
}

// ---------------------------------------------- Floating point, text -> f64
//
// The same core (`strtod`, correctly rounded) that `std.num` uses -- only
// the scratch memory comes from outside. `ws` needs `strtod_work_bytes()`
// octets and may lie anywhere: on the stack, in an arena, in a kernel
// frame. Return value of the `read_` forms: the octets used up (0 = there
// was no number there).

fn read_f64_bits_at(p: *mut u8, n: usize, ws: *mut u8, out: *mut u64) -> usize {
    *out = 0
    if (ws as usize) == 0 {
        return 0
    }
    var consumed: usize = 0
    let bits: u64 = strtod(p, n, ws, &consumed)
    *out = bits
    return consumed
}

// Strict: the WHOLE text has to be the number.
fn text_to_f64_bits_at(p: *mut u8, n: usize, ws: *mut u8, out: *mut u64) -> bool {
    let z: usize = read_f64_bits_at(p, n, ws, out)
    return z == n && z > 0
}

#[allow_fp]
fn read_f64_at(p: *mut u8, n: usize, ws: *mut u8, out: *mut f64) -> usize {
    var bits: u64 = 0
    let z: usize = read_f64_bits_at(p, n, ws, &bits)
    *out = bits_f64(bits)
    return z
}

#[allow_fp]
fn text_to_f64_at(p: *mut u8, n: usize, ws: *mut u8, out: *mut f64) -> bool {
    let z: usize = read_f64_at(p, n, ws, out)
    return z == n && z > 0
}

// ---------------------------------------------- Floating point, text -> f32
//
// ROUND 71, and the one place in this file where a comment has to say what
// does NOT work: the way "correctly rounded binary64, then narrow" is WRONG.
// At the exact middle between two binary32 the first rounding lands ON the
// middle, and the tie-to-even of the second one then decides without knowing
// which side the real value lay on. It is not a rarity either -- measured
// against C `strtof`, 63568 of 239064 such cases came out one ulp off.
//
// The way that works runs over `strtod_odd`: rounding to ODD in between (cut
// off, last bit set when anything was left over) never produces a binary32
// middle, so the second rounding always has a direction and it is the right
// one. `tools/lexnum/run.sh` holds the whole thing against C `strtof` and
// against an exact reference written in Python for thousands of literals.

#[allow_fp]
fn read_f32_at(p: *mut u8, n: usize, ws: *mut u8, out: *mut f32) -> usize {
    var used: usize = 0
    let bits: u64 = strtod_odd(p, n, ws, &used)
    *out = bits_f64(bits) as f32
    return used
}

#[allow_fp]
fn read_f32_bits_at(p: *mut u8, n: usize, ws: *mut u8, out: *mut u32) -> usize {
    var x: f32 = 0.0
    let z: usize = read_f32_at(p, n, ws, &x)
    *out = f32_bits(x)
    return z
}

#[allow_fp]
fn text_to_f32_at(p: *mut u8, n: usize, ws: *mut u8, out: *mut f32) -> bool {
    let z: usize = read_f32_at(p, n, ws, out)
    return z == n && z > 0
}

#[allow_fp]
fn text_to_f32_bits_at(p: *mut u8, n: usize, ws: *mut u8, out: *mut u32) -> bool {
    let z: usize = read_f32_bits_at(p, n, ws, out)
    return z == n && z > 0
}
