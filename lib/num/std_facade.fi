// lib/num/std_facade.fi -- number <-> text for the std facade (round 42).
//
// ONLY for `lib/std/num.fi`: included exclusively by
// `tools/strlib/src/std_num.fi`. lib/num (bignum/dtoa/strtod) stays
// unchanged; whoever uses the include library without std gets not one
// byte more code.
//
// ONE RULE FOR THE DIRECTION, readable off every name:
//   * `write_*` takes a number and APPENDS its text to a `*mut Bytes`.
//     It never clears -- several calls build up one line.
//   * `read_*` takes text and delivers the number. The return value is the
//     number of octets USED UP (0 = there was no number there); the value
//     itself comes back through an output pointer. That lets the caller
//     read on where the number ends -- every parser needs that.
//   * `text_to_*` is the strict form: the WHOLE text has to be the number,
//     otherwise `false`. That is what you want when evaluating an argument.
//
// OVERFLOW IS REPORTED, not hushed up: the `read_*` forms carry an
// `overflow` output pointer, and the `text_to_*` forms then return
// `false`. In stage 0 Firn has no overflow check in its arithmetic
// (SPEC 14.1.3) -- when reading foreign input a silent wraparound would be
// a security hole, not a cosmetic flaw.
//
// Floating point runs through the exact cores this module already has:
// `dtoa` (the shortest text that reads back) and `strtod` (correctly
// rounded). All that is new is the wrapper around them: since round 30
// `f64` really exists, so the facade takes and returns `f64` instead of bit
// patterns. The bit pattern forms remain alongside.

// ------------------------------------------------------------------ Limits
//
// As functions, because `const` in stage 0 is evaluated as an integer (i64)
// and 2^64-1 is not representable there.

fn u64_max() -> u64 {
    var x: u64 = 0
    return x - 1
}

fn i64_max() -> i64 {
    return 9223372036854775807
}

fn i64_min() -> i64 {
    return 0 - 9223372036854775807 - 1
}

// ---------------------------------------------------------- Number -> text

// The value of a digit in base <= 36, otherwise -1. Upper and lower case count alike.
fn digit_value(c: u8) -> i32 {
    if c >= 48 as u8 && c <= 57 as u8 {
        return (c - 48 as u8) as i32
    }
    if c >= 97 as u8 && c <= 122 as u8 {
        return (c - 97 as u8) as i32 + 10
    }
    if c >= 65 as u8 && c <= 90 as u8 {
        return (c - 65 as u8) as i32 + 10
    }
    return 0 - 1
}

// How many digits `v` needs in `base` (0 needs one).
fn digit_count(v: u64, base: u32) -> usize {
    if base < 2 || base > 36 {
        return 0
    }
    if v == 0 {
        return 1
    }
    let b: u64 = base as u64
    var x: u64 = v
    var n: usize = 0
    while x > 0 {
        x = x / b
        n = n + 1
    }
    return n
}

// Unsigned in any base 2..36, without a prefix.
// `big` selects A-Z instead of a-z.
fn write_base(out: *mut Bytes, v: u64, base: u32, big: bool) {
    if base < 2 || base > 36 {
        return
    }
    if v == 0 {
        bytes_push(out, 48 as u8)
        return
    }
    let b: u64 = base as u64
    var d: [u8; 64] = [0 as u8; 64]
    var n: usize = 0
    var x: u64 = v
    while x > 0 {
        let z: u64 = x % b
        if z < 10 {
            d[n] = z as u8 + 48 as u8
        } else if big {
            d[n] = z as u8 + 55 as u8
        } else {
            d[n] = z as u8 + 87 as u8
        }
        x = x / b
        n = n + 1
    }
    while n > 0 {
        n = n - 1
        bytes_push(out, d[n])
    }
}

fn write_u64(out: *mut Bytes, v: u64) {
    write_base(out, v, 10, false)
}

// Signed. At the edge (i64::MIN) the magnitude does not fit in i64 -- `0 - v`
// would wrap around there.
fn write_i64(out: *mut Bytes, v: i64) {
    if v < 0 {
        bytes_push(out, 45 as u8)
        write_base(out, (0 - (v + 1)) as u64 + 1, 10, false)
        return
    }
    write_base(out, v as u64, 10, false)
}

// Hexadecimal, at least `min` digits (padded with zeros on the left).
// No "0x" -- whoever wants it writes it in front; that keeps the function
// usable in both worlds.
fn write_hex(out: *mut Bytes, v: u64, min: usize) {
    let z: usize = digit_count(v, 16)
    var i: usize = z
    while i < min {
        bytes_push(out, 48 as u8)
        i = i + 1
    }
    write_base(out, v, 16, false)
}

fn write_hex_big(out: *mut Bytes, v: u64, min: usize) {
    let z: usize = digit_count(v, 16)
    var i: usize = z
    while i < min {
        bytes_push(out, 48 as u8)
        i = i + 1
    }
    write_base(out, v, 16, true)
}

fn write_binary(out: *mut Bytes, v: u64, min: usize) {
    let z: usize = digit_count(v, 2)
    var i: usize = z
    while i < min {
        bytes_push(out, 48 as u8)
        i = i + 1
    }
    write_base(out, v, 2, false)
}

fn write_octal(out: *mut Bytes, v: u64, min: usize) {
    let z: usize = digit_count(v, 8)
    var i: usize = z
    while i < min {
        bytes_push(out, 48 as u8)
        i = i + 1
    }
    write_base(out, v, 8, false)
}

// Right aligned to `width`, padded on the left with `filler`. Longer numbers
// are NOT truncated -- a shortened number would be a wrong number.
fn write_wide_u64(out: *mut Bytes, v: u64, width: usize, filler: u8) {
    let z: usize = digit_count(v, 10)
    var i: usize = z
    while i < width {
        bytes_push(out, filler)
        i = i + 1
    }
    write_base(out, v, 10, false)
}

fn write_wide_i64(out: *mut Bytes, v: i64, width: usize, filler: u8) {
    var abs: u64 = v as u64
    var z: usize = 0
    if v < 0 {
        abs = (0 - (v + 1)) as u64 + 1
        z = 1
    }
    z = z + digit_count(abs, 10)
    var i: usize = z
    while i < width {
        bytes_push(out, filler)
        i = i + 1
    }
    write_i64(out, v)
}

// ---------------------------------------------------------- Text -> number

// A digit sequence starting at `ab` in base 2..36. Return value: the number
// of octets used up (0 = no digit). `overflow` is set as soon as the value
// no longer fits in a u64; it keeps reading to the end of the digits anyway,
// so that the caller knows where the text continues.
fn read_u64_base(p: *mut u8, n: usize, ab: usize, base: u32, out: *mut u64,
                  overflow: *mut bool) -> usize {
    *out = 0
    *overflow = false
    if base < 2 || base > 36 {
        return 0
    }
    let b: u64 = base as u64
    let limit: u64 = u64_max() / b
    let rest_limit: u64 = u64_max() - limit * b
    var w: u64 = 0
    var i: usize = ab
    var z: usize = 0
    while i < n {
        let d: i32 = digit_value(ld8(p, i))
        if d < 0 {
            i = n
        } else if (d as u32) >= base {
            i = n
        } else {
            if w > limit || (w == limit && (d as u64) > rest_limit) {
                *overflow = true
            }
            w = w * b + d as u64
            z = z + 1
            i = i + 1
        }
    }
    *out = w
    return z
}

fn read_u64(p: *mut u8, n: usize, ab: usize, out: *mut u64,
            overflow: *mut bool) -> usize {
    return read_u64_base(p, n, ab, 10, out, overflow)
}

// With a sign. `+` and `-` are allowed, and at least one digit has to
// follow. The return value counts the sign.
fn read_i64(p: *mut u8, n: usize, ab: usize, out: *mut i64,
            overflow: *mut bool) -> usize {
    *out = 0
    *overflow = false
    var i: usize = ab
    var negative: bool = false
    if i < n {
        let c: u8 = ld8(p, i)
        if c == 45 as u8 {
            negative = true
            i = i + 1
        } else if c == 43 as u8 {
            i = i + 1
        }
    }
    var abs: u64 = 0
    var ue: bool = false
    let z: usize = read_u64_base(p, n, i, 10, &abs, &ue)
    if z == 0 {
        return 0
    }
    if ue {
        *overflow = true
    }
    if negative {
        if abs > 9223372036854775808 as u64 {
            *overflow = true
            *out = i64_min()
        } else if abs == 9223372036854775808 as u64 {
            *out = i64_min()
        } else {
            *out = 0 - (abs as i64)
        }
    } else {
        if abs > 9223372036854775807 as u64 {
            *overflow = true
            *out = i64_max()
        } else {
            *out = abs as i64
        }
    }
    return i - ab + z
}

// Strict: the whole text has to be the number, no whitespace, no leftovers.
fn text_to_u64_base(p: *mut u8, n: usize, base: u32, out: *mut u64) -> bool {
    var ue: bool = false
    let z: usize = read_u64_base(p, n, 0, base, out, &ue)
    return z == n && z > 0 && !ue
}

fn text_to_u64(p: *mut u8, n: usize, out: *mut u64) -> bool {
    return text_to_u64_base(p, n, 10, out)
}

fn text_to_i64(p: *mut u8, n: usize, out: *mut i64) -> bool {
    var ue: bool = false
    let z: usize = read_i64(p, n, 0, out, &ue)
    return z == n && z > 0 && !ue
}

// With a base prefix: 0x/0X = 16, 0b/0B = 2, 0o/0O = 8, otherwise 10.
// A lone "0" stays 0 (no special case for leading zeros -- those are
// decimal, as in every modern language).
fn text_to_u64_auto(p: *mut u8, n: usize, out: *mut u64) -> bool {
    if n >= 3 && ld8(p, 0) == 48 as u8 {
        let c: u8 = ld8(p, 1)
        if c == 120 as u8 || c == 88 as u8 {
            return text_to_u64_base((p as usize + 2) as *mut u8, n - 2, 16, out)
        }
        if c == 98 as u8 || c == 66 as u8 {
            return text_to_u64_base((p as usize + 2) as *mut u8, n - 2, 2, out)
        }
        if c == 111 as u8 || c == 79 as u8 {
            return text_to_u64_base((p as usize + 2) as *mut u8, n - 2, 8, out)
        }
    }
    return text_to_u64_base(p, n, 10, out)
}

// ---------------------------------------------------------- Floating point
//
// Reinterpreting the bit pattern through memory -- Firn has no
// reinterpretation operator, and `as` would be a VALUE conversion (1.0 as u64 = 1).

fn f64_bits(x: f64) -> u64 {
    var t: f64 = x
    return *(((&t) as usize) as *mut u64)
}

fn bits_f64(b: u64) -> f64 {
    var t: u64 = b
    return *(((&t) as usize) as *mut f64)
}

fn f64_is_nan(x: f64) -> bool {
    return dtoa_is_nan(f64_bits(x))
}

fn f64_is_infinite(x: f64) -> bool {
    return dtoa_is_inf(f64_bits(x))
}

fn f64_is_null(x: f64) -> bool {
    return dtoa_is_zero(f64_bits(x))
}

// true = the sign bit is negative (for -0.0 as well).
fn f64_sign(x: f64) -> bool {
    return dtoa_sign(f64_bits(x))
}

fn dtoa_work_bytes() -> usize {
    return DTOA_WS_BYTES
}

fn strtod_work_bytes() -> usize {
    return STRTOD_WS_BYTES
}

// The bit pattern as the shortest decimal text that reads back, APPENDED.
// `dtoa` itself clears its target -- that is why the way leads through a
// short intermediate buffer. Return value false = out of memory.
//
// THE COST, honestly: one `mmap` for the scratch memory (14 KiB) and one for
// the intermediate buffer per call. Whoever writes many numbers calls `dtoa`
// directly with scratch memory of their own -- the facade is the convenient
// form, not the fast one.
fn write_f64_bits(out: *mut Bytes, bits: u64) -> bool {
    let ws: *mut u8 = heap_alloc(DTOA_WS_BYTES)
    if (ws as usize) == 0 {
        return false
    }
    var between: Bytes = Bytes{ ptr: 0 as *mut u8, len: 0, cap: 0 }
    dtoa(bits, &between, ws)
    bytes_append(out, between.ptr, between.len)
    bytes_free(&between)
    heap_free(ws, DTOA_WS_BYTES)
    return true
}

fn write_f64(out: *mut Bytes, x: f64) -> bool {
    return write_f64_bits(out, f64_bits(x))
}

// Text -> bit pattern. Return value: the octets used up (0 = no number).
// It recognizes [+-] digits [ . digits ] [ (e|E) [+-] digits ] -- exactly the
// form that `strtod` (lib/num/strtod.fi) reads correctly rounded.
fn read_f64_bits(p: *mut u8, n: usize, out: *mut u64) -> usize {
    *out = 0
    let ws: *mut u8 = heap_alloc(STRTOD_WS_BYTES)
    if (ws as usize) == 0 {
        return 0
    }
    var consumed: usize = 0
    let bits: u64 = strtod(p, n, ws, &consumed)
    heap_free(ws, STRTOD_WS_BYTES)
    *out = bits
    return consumed
}

fn read_f64(p: *mut u8, n: usize, out: *mut f64) -> usize {
    var bits: u64 = 0
    let z: usize = read_f64_bits(p, n, &bits)
    *out = bits_f64(bits)
    return z
}

fn text_to_f64(p: *mut u8, n: usize, out: *mut f64) -> bool {
    let z: usize = read_f64(p, n, out)
    return z == n && z > 0
}

fn text_to_f64_bits(p: *mut u8, n: usize, out: *mut u64) -> bool {
    let z: usize = read_f64_bits(p, n, out)
    return z == n && z > 0
}
