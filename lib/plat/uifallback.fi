import std.rt
import font.metrics

export { load_symbols, load_emoji }

const SYMBOL_CANDIDATES: usize = 4
const EMOJI_CANDIDATES: usize = 3

fn symbol_path(i: usize) -> str {
    if i == 0 { return "C:/Windows/Fonts/seguisym.ttf\0" }
    if i == 1 { return "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0" }
    if i == 2 { return "/usr/share/fonts/TTF/DejaVuSans.ttf\0" }
    return "/system/fonts/NotoSansSymbols-Regular-Subsetted.ttf\0"
}

fn emoji_path(i: usize) -> str {
    if i == 0 { return "C:/Windows/Fonts/seguiemj.ttf\0" }
    if i == 1 { return "/system/fonts/NotoColorEmoji.ttf\0" }
    return "/usr/share/fonts/truetype/noto/NotoColorEmoji.ttf\0"
}

fn read_font(path: str, fs: *mut metrics.FontSet) -> bool {
    var data: rt.Buf = rt.buf_new()
    if rt.read_file(path.p as u64, &data) && rt.buf_len(&data) > 1024 {
        *fs = metrics.fontset_new()
        if metrics.fontset_load(fs, rt.buf_ptr(&data) as *mut u8, rt.buf_len(&data)) { return true }
    }
    rt.buf_free(&data)
    return false
}

fn load_symbols(fs: *mut metrics.FontSet) -> bool {
    var i: usize = 0
    while i < SYMBOL_CANDIDATES {
        if read_font(symbol_path(i), fs) { return true }
        i = i + 1
    }
    return false
}

fn load_emoji(fs: *mut metrics.FontSet) -> bool {
    var i: usize = 0
    while i < EMOJI_CANDIDATES {
        if read_font(emoji_path(i), fs) { return true }
        i = i + 1
    }
    return false
}
