export { web_face_size, web_face_read }

extern fn firn_web_face_size(i: u32) -> u32;
extern fn firn_web_face_read(i: u32, p: u32, n: u32) -> u32;

fn web_face_size(i: usize) -> usize {
    return firn_web_face_size(i as u32) as usize
}

fn web_face_read(i: usize, p: u64, n: usize) -> usize {
    return firn_web_face_read(i as u32, p as u32, n as u32) as usize
}
