// SPDX-License-Identifier: MPL-2.0
// lib/plat/fuiwirt.fi -- THE HOST: what a window reports becomes fUi.
//
// ========================================================= WHY IT EXISTS
//
// fUi has an operation (lib/fui/control.fi: hover, press,
// release, focus chain, dragging), a pane box with wheel, keys
// and scrollbars (lib/fui/viewport.fi) and a clock for animations
// (lib/fui/anim.fi). What was missing was the place at which the EVENTS
// OF A WINDOW run into exactly these three -- until now only
// OrientOS did that, in its own way. This place is here.
//
// THIS FILE KNOWS NO WINDOW. It imports neither lib/window nor
// any platform; it takes pointer positions, buttons, keys and
// characters as NUMBERS. The translation "event of the
// window system -> call here" stands in lib/plat/fuiwin.fi, and that
// is a single switch. That is why everything that is decided
// here can be re-calculated without a screen (tools/fui/x11_main.fi),
// and that is why it applies to X11, Windows and every future back end
// alike.
//
// ========================================================== WHAT IT DOES
//
// W1 POINTER. Movement, press and release go to control.fi --
//    to a panel that hangs via scene.scene_bind_panel directly on the
//    nodes of the described tree. There is no second operation
//    and no copy of the widgets.
// W2 SCROLLING. The wheel (button 4/5, horizontal 6/7) scrolls the pane box
//    UNDER THE POINTER; a press on its scrollbar takes the
//    thumb (viewport_bar_press/drag/release). The step size is
//    a length from the design and therefore goes through `render.len_of` --
//    at scale 2 a notch scrolls twice as many pixels, so
//    the same distance on the screen.
// W3 KEYS. Tab / Shift+Tab is the focus chain, Enter and
//    space trigger the widget in focus, arrows, page up/down,
//    Home and End scroll the pane box over which the pointer
//    stood last (otherwise the first of the tree).
// W4 THE SCALE. `wirt_set_scale` sets it ONCE in the theme
//    (theme.theme_set_scale) -- the one place from which render.len_of
//    and thereby scene.fi read it. A second way does not exist.
// W5 WHEN PAINTING HAPPENS. Only if something is DIRTY: an event has
//    changed something (the change bits of control.fi say so), the
//    window was uncovered or changed in size, or the
//    last tick of the animations has moved a value
//    (anim.animator_dirty). `wirt_wait_ms` tells the loop how
//    long it may sleep: -1 (until the next event) if
//    nothing is running, 16 ms as long as a tween or a run-out is active,
//    0 if something is already dirty. WHEN IDLE NOTHING IS
//    PAINTED -- that is counted in tools/fui/x11_main.fi and measured on a
//    real Xvfb by the computing time.
//
// ====================================================== WHAT IS NOT HERE
//
// N1 NO text input. Characters other than the space bar are counted,
//    but given to no text field; lib/fui/editor.fi is a task of its
//    own.
// N2 NO double click, no drag and drop, no clipboard.
import fui.render
import fui.scene
import fui.control
import fui.viewport
import fui.anim
import fui.theme
import fui.event

export {
    Host, host_new, host_bind, host_set_animator,
    host_pointer_move, host_pointer_down, host_pointer_up,
    host_pointer_leave, host_key, host_char,
    // r111: real pointers (id, type, primary, time) into the router
    host_set_router, host_router, host_pointer, host_pointer_cancel,
    PE_DOWN, PE_MOVE, PE_UP, PE_CANCEL, PE_LEAVE,
    host_resize, host_expose, host_set_scale, host_touch,
    host_tick, host_wait_ms, host_dirty, host_painted, host_frames,
    host_after_layout, host_take_activated, host_panel,
    host_kbd_viewport, host_chars, host_focus,
    host_set_hook, HOOK_MOVE, HOOK_LEAVE, HOOK_DOWN, HOOK_UP, HOOK_WHEEL,
    rgba_to_bgrx,
    KEY_TAB, KEY_RETURN, KEY_UP, KEY_DOWN, KEY_LEFT, KEY_RIGHT,
    KEY_PAGE_UP, KEY_PAGE_DOWN, KEY_HOME, KEY_END,
    MOD_SHIFT, MOD_CTRL,
    BTN_LEFT, BTN_WHEEL_UP, BTN_WHEEL_DOWN, BTN_WHEEL_LEFT,
    BTN_WHEEL_RIGHT,
    FRAME_MS, WAIT_FOREVER, KEINER,
}

// The keys that the host understands -- numbers of its own, none of a
// window system. Which key of the system is which of them is decided by
// lib/plat/fuiwin.fi.
const KEY_TAB: u32 = 1
const KEY_RETURN: u32 = 2
const KEY_UP: u32 = 3
const KEY_DOWN: u32 = 4
const KEY_LEFT: u32 = 5
const KEY_RIGHT: u32 = 6
const KEY_PAGE_UP: u32 = 7
const KEY_PAGE_DOWN: u32 = 8
const KEY_HOME: u32 = 9
const KEY_END: u32 = 10

// The state bits that the host reads. The same as in X11 (Shift =
// bit 0, Control = bit 2) -- lib/window/window.fi has fixed them for all
// back ends in this way (`ev_state`).
const MOD_SHIFT: u32 = 1
const MOD_CTRL: u32 = 4

// The buttons: 1 left, 4/5 the wheel, 6/7 the wheel sideways.
const BTN_LEFT: u32 = 1
const BTN_WHEEL_UP: u32 = 4
const BTN_WHEEL_DOWN: u32 = 5
const BTN_WHEEL_LEFT: u32 = 6
const BTN_WHEEL_RIGHT: u32 = 7

// One frame every 16 ms as long as something is running; -1 = sleep until an
// event comes.
const FRAME_MS: i64 = 16

// THE APPLICATION'S OWN EAR (29.09.2026, examples/codehub). control.fi
// hears only widgets; a page that paints its own hover (a button that
// lifts on a spring, a link whose underline grows) or scrolls itself
// needs the raw pointer as well. `host_set_hook` hands every move, leave,
// press, release and wheel notch to the application AFTER the host did
// its own work; the hook answers true when the page has to be painted
// again. Kinds:
const HOOK_MOVE: u32 = 1
const HOOK_LEAVE: u32 = 2
const HOOK_DOWN: u32 = 3
const HOOK_UP: u32 = 4
const HOOK_WHEEL: u32 = 5 // x, y = the notches (positive = down / right)
// "No node" -- the same value as scene.SCENE_NONE, for callers
// who do not import scene (lib/plat/fuiwin.fi).
const KEINER: usize = 4294967295
const WAIT_FOREVER: i64 = -1

struct Host {
    sc: u64, // *mut scene.Scene -- gehoert dem Aufrufer
    c: u64, // *mut render.Ctx -- fuer len_of und die Balkenmasse
    g: u64, // *mut anim.Animator oder 0
    pn: control.Panel,
    dirty: bool,
    frames: u64,
    px: f64,
    py: f64,
    inside: bool,
    // The pane box whose thumb is currently being dragged, and the one
    // over which the pointer stood last (for the keys).
    bar_node: usize,
    kbd_node: usize,
    // Which node was TRIGGERED last (click or Enter),
    // until the caller collects it.
    act: usize,
    chars: u64,
    // the application's hook (host_set_hook); has_hook = 0: none
    hook: fn(u64, u32, f64, f64) -> bool,
    hook_ud: u64,
    has_hook: u32,
    // the event router (lib/fui/event.fi) or 0; see host_set_router
    rt: u64,
}

fn hook_none(ud: u64, kind: u32, x: f64, y: f64) -> bool {
    return false
}

fn host_set_hook(w: *mut Host, ud: u64, f: fn(u64, u32, f64, f64) -> bool) {
    (*w).hook = f
    (*w).hook_ud = ud
    (*w).has_hook = 1 as u32
}

// Ask the hook; a true answer makes the page dirty.
fn call_hook(w: *mut Host, kind: u32, x: f64, y: f64) -> u32 {
    if (*w).has_hook == 0 as u32 {
        return control.CH_NONE
    }
    let f: fn(u64, u32, f64, f64) -> bool = (*w).hook
    if f((*w).hook_ud, kind, x, y) {
        (*w).dirty = true
        return control.CH_REPAINT
    }
    return control.CH_NONE
}

fn host_new(sc: *mut scene.Scene, c: *mut render.Ctx) -> Host {
    return Host { sc: sc as u64, c: c as u64, g: 0,
        pn: control.panel_new(), dirty: true, frames: 0,
        px: 0.0, py: 0.0, inside: false,
        bar_node: scene.SCENE_NONE, kbd_node: scene.SCENE_NONE,
        act: scene.SCENE_NONE, chars: 0,
        hook: hook_none, hook_ud: 0, has_hook: 0 as u32, rt: 0 }
}

// Hang the panel on the tree. Call AFTER building the tree, and
// again when nodes are added -- the panel knows their number.
fn host_bind(w: *mut Host) {
    scene.scene_bind_panel(wsc(w), &(*w).pn)
}

fn host_set_animator(w: *mut Host, g: *mut anim.Animator) {
    (*w).g = g as u64
}

fn wsc(w: *mut Host) -> *mut scene.Scene {
    return (*w).sc as *mut scene.Scene
}

fn wctx(w: *mut Host) -> *mut render.Ctx {
    return (*w).c as *mut render.Ctx
}

fn host_panel(w: *mut Host) -> *mut control.Panel {
    return &(*w).pn
}

fn schmutzig(w: *mut Host, ch: u32) -> u32 {
    if (ch & control.CH_REPAINT) != 0 as u32 {
        (*w).dirty = true
    }
    return ch
}

// Something has changed that the host cannot see (the caller
// has set a value, switched the theme ...).
fn host_touch(w: *mut Host) {
    (*w).dirty = true
}

// ------------------------------------------------------------ the pointer

fn host_pointer_move(w: *mut Host, x: f64, y: f64) -> u32 {
    (*w).px = x
    (*w).py = y
    (*w).inside = true
    if (*w).bar_node != scene.SCENE_NONE {
        let v: *mut viewport.Viewport = scene.node_viewport(wsc(w),
            (*w).bar_node)
        if viewport.viewport_bar_drag(wctx(w), v, x, y) {
            (*w).dirty = true
            return control.CH_REPAINT | control.CH_VALUE
        }
        return control.CH_NONE
    }
    let vn: usize = scene.scene_viewport_at(wsc(w), x, y)
    if vn != scene.SCENE_NONE {
        (*w).kbd_node = vn
    }
    let ch: u32 = schmutzig(w, control.mouse_move(&(*w).pn, x, y))
    return ch | call_hook(w, HOOK_MOVE, x, y)
}

// Which pane box has its SCROLLBAR under (x, y)? Every box is
// asked itself (viewport_bar_hit): the bar lies at the
// edge of the viewport, and the hit test of the tree does not count it
// as content.
fn bar_under(w: *mut Host, x: f64, y: f64) -> usize {
    let sc: *mut scene.Scene = wsc(w)
    var i: usize = 0
    while i < scene.scene_count(sc) {
        if scene.node_kind(sc, i) == scene.N_VIEWPORT {
            let v: *mut viewport.Viewport = scene.node_viewport(sc, i)
            if v as u64 != 0 as u64 {
                if viewport.viewport_bar_hit(v, x, y) != viewport.VP_BAR_NONE {
                    return i
                }
            }
        }
        i = i + 1
    }
    return scene.SCENE_NONE
}

// The wheel: `nx`/`ny` notches (positive = down or right).
fn rad(w: *mut Host, x: f64, y: f64, nx: f64, ny: f64) -> u32 {
    let vn: usize = scene.scene_viewport_at(wsc(w), x, y)
    if vn == scene.SCENE_NONE {
        // no scroll area under the pointer: the page may scroll itself
        return call_hook(w, HOOK_WHEEL, nx, ny)
    }
    (*w).kbd_node = vn
    let v: *mut viewport.Viewport = scene.node_viewport(wsc(w), vn)
    let step: f64 = render.len_of(wctx(w),
        viewport.VP_WHEEL_STEP as usize)
    let ox: f64 = viewport.viewport_off_x(v)
    let oy: f64 = viewport.viewport_off_y(v)
    viewport.viewport_scroll_by(v, nx * step, ny * step)
    if viewport.viewport_off_x(v) != ox || viewport.viewport_off_y(v) != oy {
        (*w).dirty = true
        return control.CH_REPAINT | control.CH_VALUE
    }
    return control.CH_NONE
}

fn host_pointer_down(w: *mut Host, x: f64, y: f64, btn: u32) -> u32 {
    (*w).px = x
    (*w).py = y
    if btn == BTN_WHEEL_UP {
        return rad(w, x, y, 0.0, -1.0)
    }
    if btn == BTN_WHEEL_DOWN {
        return rad(w, x, y, 0.0, 1.0)
    }
    if btn == BTN_WHEEL_LEFT {
        return rad(w, x, y, -1.0, 0.0)
    }
    if btn == BTN_WHEEL_RIGHT {
        return rad(w, x, y, 1.0, 0.0)
    }
    if btn != BTN_LEFT {
        return control.CH_NONE
    }
    let bn: usize = bar_under(w, x, y)
    if bn != scene.SCENE_NONE {
        let v: *mut viewport.Viewport = scene.node_viewport(wsc(w), bn)
        (*w).kbd_node = bn
        if viewport.viewport_bar_press(wctx(w), v, x, y) {
            if viewport.viewport_bar_dragging(v) != viewport.VP_BAR_NONE {
                (*w).bar_node = bn
            }
            (*w).dirty = true
            return control.CH_REPAINT | control.CH_VALUE
        }
    }
    let ch: u32 = schmutzig(w, control.mouse_down(&(*w).pn, x, y))
    return ch | call_hook(w, HOOK_DOWN, x, y)
}

fn host_pointer_up(w: *mut Host, x: f64, y: f64, btn: u32) -> u32 {
    if btn != BTN_LEFT {
        return control.CH_NONE
    }
    if (*w).bar_node != scene.SCENE_NONE {
        let v: *mut viewport.Viewport = scene.node_viewport(wsc(w),
            (*w).bar_node)
        viewport.viewport_bar_release(v)
        (*w).bar_node = scene.SCENE_NONE
        (*w).dirty = true
        return control.CH_REPAINT
    }
    // Whoever was pressed stands in the panel ONLY before the release.
    let war: usize = control.panel_pressed(&(*w).pn)
    let ch: u32 = control.mouse_up(&(*w).pn, x, y)
    if (ch & control.CH_ACTIVATE) != 0 as u32 {
        (*w).act = war
    }
    return schmutzig(w, ch) | call_hook(w, HOOK_UP, x, y)
}

fn host_pointer_leave(w: *mut Host) -> u32 {
    (*w).inside = false
    let ch: u32 = schmutzig(w, control.mouse_leave(&(*w).pn))
    return ch | call_hook(w, HOOK_LEAVE, (*w).px, (*w).py)
}

// ------------------------------------------------ REAL POINTERS (r111)
//
// A host that knows more than "the mouse" -- a browser's pointerId, an
// Android finger -- reports every pointer through `host_pointer` with its
// id, type (event.PT_*), `primary` and time. Two things happen:
//   * the ROUTER (lib/fui/event.fi), if one is attached, sees ALL pointers:
//     handlers per key, capture, tap / double tap / long press / pan /
//     pinch with its arena;
//   * the PRIMARY pointer also takes the old way (host_pointer_move/down/up:
//     hover, press, scroll bars, the application hook) -- unless a handler
//     prevented the default. A second finger never presses a button.
// The router is bound in HOST MODE: it does not run those defaults itself
// (they would run twice) but still cancels a press that lost the arena.
const PE_DOWN: u32 = 1
const PE_MOVE: u32 = 2
const PE_UP: u32 = 3
const PE_CANCEL: u32 = 4
// the pointer left the window (a mouse; a finger just ends)
const PE_LEAVE: u32 = 5

fn host_set_router(w: *mut Host, r: *mut event.Router) {
    (*w).rt = r as u64
    event.router_host_mode(r, &(*w).pn)
}

fn host_router(w: *mut Host) -> *mut event.Router {
    return (*w).rt as *mut event.Router
}

// The primary pointer was taken away (pointercancel, ACTION_CANCEL): the
// press ends WITHOUT a click, a dragged scroll bar is let go.
fn host_pointer_cancel(w: *mut Host) -> u32 {
    var ch: u32 = control.CH_NONE
    if (*w).bar_node != scene.SCENE_NONE {
        let v: *mut viewport.Viewport = scene.node_viewport(wsc(w),
            (*w).bar_node)
        viewport.viewport_bar_release(v)
        (*w).bar_node = scene.SCENE_NONE
        ch = ch | control.CH_REPAINT
    }
    ch = ch | control.mouse_cancel(&(*w).pn)
    return schmutzig(w, ch)
}

fn host_pointer(w: *mut Host, kind: u32, pid: u32, ptype: u32,
    primary: bool, x: f64, y: f64, t: i64) -> u32 {
    var ch: u32 = control.CH_NONE
    var prevented: bool = false
    let r: *mut event.Router = host_router(w)
    if r as u64 != 0 as u64 {
        let sc: *mut scene.Scene = wsc(w)
        if kind == PE_DOWN {
            let ok: bool = event.ev_pointer_down(r, sc, pid, ptype, x, y, t)
            prevented = event.router_default_prevented(r)
        } else if kind == PE_MOVE {
            let ok: bool = event.ev_pointer_move(r, sc, pid, x, y, t)
            prevented = event.router_default_prevented(r)
        } else if kind == PE_UP {
            let ok: bool = event.ev_pointer_up(r, sc, pid, x, y, t)
            prevented = event.router_default_prevented(r)
        } else if kind == PE_CANCEL {
            let ok: bool = event.ev_pointer_cancel(r, sc, pid, t)
        }
        ch = ch | schmutzig(w, event.router_changes(r))
    }
    if !primary {
        return ch
    }
    if kind == PE_DOWN && !prevented {
        ch = ch | host_pointer_move(w, x, y)
        ch = ch | host_pointer_down(w, x, y, BTN_LEFT)
    } else if kind == PE_MOVE && !prevented {
        ch = ch | host_pointer_move(w, x, y)
    } else if kind == PE_UP && !prevented {
        ch = ch | host_pointer_up(w, x, y, BTN_LEFT)
    } else if kind == PE_CANCEL {
        ch = ch | host_pointer_cancel(w)
    } else if kind == PE_LEAVE {
        ch = ch | host_pointer_leave(w)
    }
    return ch
}

// AFTER A NEW ARRANGING. Whoever has scrolled has a different node under the
// standing pointer; the hover must be caught up with,
// otherwise the row that has scrolled away lights up. The caller calls it
// after every `scene_layout`; if it changes something, painting is done once more.
fn host_after_layout(w: *mut Host) -> u32 {
    if !(*w).inside || (*w).bar_node != scene.SCENE_NONE {
        return control.CH_NONE
    }
    return schmutzig(w, control.mouse_move(&(*w).pn, (*w).px, (*w).py))
}

// ------------------------------------------------------------- die Tasten

fn kbd_viewport(w: *mut Host) -> usize {
    if (*w).kbd_node != scene.SCENE_NONE {
        return (*w).kbd_node
    }
    let sc: *mut scene.Scene = wsc(w)
    var i: usize = 0
    while i < scene.scene_count(sc) {
        if scene.node_kind(sc, i) == scene.N_VIEWPORT
        && scene.node_viewport(sc, i) as u64 != 0 as u64 {
            return i
        }
        i = i + 1
    }
    return scene.SCENE_NONE
}

fn host_kbd_viewport(w: *mut Host) -> usize {
    return kbd_viewport(w)
}

fn ausloesen(w: *mut Host) -> u32 {
    let f: usize = control.panel_focus(&(*w).pn)
    let ch: u32 = control.activate_focused(&(*w).pn)
    if (ch & control.CH_ACTIVATE) != 0 as u32 {
        (*w).act = f
    }
    return schmutzig(w, ch)
}

fn host_key(w: *mut Host, key: u32, mods: u32) -> u32 {
    if key == KEY_TAB {
        return schmutzig(w, control.key_tab(&(*w).pn,
                (mods & MOD_SHIFT) != 0 as u32))
    }
    if key == KEY_RETURN {
        return ausloesen(w)
    }
    let vn: usize = kbd_viewport(w)
    if vn == scene.SCENE_NONE {
        return control.CH_NONE
    }
    let v: *mut viewport.Viewport = scene.node_viewport(wsc(w), vn)
    let ox: f64 = viewport.viewport_off_x(v)
    let oy: f64 = viewport.viewport_off_y(v)
    // An arrow step is a length from the design (VP_STEP) and goes
    // through len_of; page, start and end depend on the viewport itself
    // and are already pixels -- viewport_key calculates them.
    let step: f64 = render.len_of(wctx(w), viewport.VP_STEP as usize)
    if key == KEY_UP {
        viewport.viewport_scroll_by(v, 0.0, 0.0 - step)
    } else if key == KEY_DOWN {
        viewport.viewport_scroll_by(v, 0.0, step)
    } else if key == KEY_LEFT {
        viewport.viewport_scroll_by(v, 0.0 - step, 0.0)
    } else if key == KEY_RIGHT {
        viewport.viewport_scroll_by(v, step, 0.0)
    } else if key == KEY_PAGE_UP {
        let b: bool = viewport.viewport_key(v, viewport.VP_PAGE_UP)
    } else if key == KEY_PAGE_DOWN {
        let b: bool = viewport.viewport_key(v, viewport.VP_PAGE_DOWN)
    } else if key == KEY_HOME {
        let b: bool = viewport.viewport_key(v, viewport.VP_HOME)
    } else if key == KEY_END {
        let b: bool = viewport.viewport_key(v, viewport.VP_END)
    } else {
        return control.CH_NONE
    }
    if viewport.viewport_off_x(v) != ox || viewport.viewport_off_y(v) != oy {
        (*w).dirty = true
        return control.CH_REPAINT | control.CH_VALUE
    }
    return control.CH_NONE
}

// A character. The space bar triggers the widget in focus (like the
// Enter key); everything else is only counted (N1).
fn host_char(w: *mut Host, cp: u32, mods: u32) -> u32 {
    (*w).chars = (*w).chars + 1
    if cp == 32 as u32 && (mods & MOD_CTRL) == 0 as u32 {
        return ausloesen(w)
    }
    return control.CH_NONE
}

// Who has the focus? NONE = nobody.
fn host_focus(w: *mut Host) -> usize {
    let f: usize = control.panel_focus(&(*w).pn)
    if f == control.NOBODY {
        return KEINER
    }
    return f
}

fn host_chars(w: *mut Host) -> u64 {
    return (*w).chars
}

// Which node was triggered since the last collection?
// scene.SCENE_NONE = none. The panel hangs from node 0 on the
// nodes of the tree, so the number in the panel IS the node number.
fn host_take_activated(w: *mut Host) -> usize {
    let a: usize = (*w).act
    (*w).act = scene.SCENE_NONE
    return a
}

// ------------------------------------------------- window and scale

fn host_resize(w: *mut Host) {
    (*w).dirty = true
}

fn host_expose(w: *mut Host) {
    (*w).dirty = true
}

// W4: the scale in per mille (1000 = 96 dpi), ONCE into the theme.
fn host_set_scale(w: *mut Host, m: *mut theme.Theme, promille: usize) {
    if theme.theme_scale(m) != promille {
        theme.theme_set_scale(m, promille)
        (*w).dirty = true
    }
}

// ------------------------------------------------------------- the clock

// Set the animations and the run-out of the pane boxes to `ms`.
// It becomes dirty only if the tick REALLY moved something.
fn host_tick(w: *mut Host, ms: i64) {
    if (*w).rt != 0 {
        event.ev_tick(host_router(w), wsc(w), ms)
    }
    if (*w).g != 0 {
        let g: *mut anim.Animator = (*w).g as *mut anim.Animator
        let b: bool = anim.anim_tick(g, ms)
        if anim.animator_dirty(g) {
            (*w).dirty = true
        }
    }
    let sc: *mut scene.Scene = wsc(w)
    var i: usize = 0
    while i < scene.scene_count(sc) {
        if scene.node_kind(sc, i) == scene.N_VIEWPORT {
            let v: *mut viewport.Viewport = scene.node_viewport(sc, i)
            if v as u64 != 0 as u64 {
                if viewport.viewport_tick(v, ms) {
                    (*w).dirty = true
                }
            }
        }
        i = i + 1
    }
}

fn runs_something(w: *mut Host) -> bool {
    // a finger is down: the long-press deadline needs ticks
    if (*w).rt != 0 && event.ev_arena_open(host_router(w)) {
        return true
    }
    if (*w).g != 0 {
        let g: *mut anim.Animator = (*w).g as *mut anim.Animator
        var i: usize = 0
        while i < anim.animator_count(g) {
            if anim.anim_active(anim.animator_at(g, i)) {
                return true
            }
            i = i + 1
        }
    }
    let sc: *mut scene.Scene = wsc(w)
    var k: usize = 0
    while k < scene.scene_count(sc) {
        if scene.node_kind(sc, k) == scene.N_VIEWPORT {
            let v: *mut viewport.Viewport = scene.node_viewport(sc, k)
            if v as u64 != 0 as u64 {
                if viewport.viewport_moving(v) {
                    return true
                }
            }
        }
        k = k + 1
    }
    return false
}

// W5: how long may the loop sleep?
fn host_wait_ms(w: *mut Host) -> i64 {
    if (*w).dirty {
        return 0
    }
    if runs_something(w) {
        return FRAME_MS
    }
    return WAIT_FOREVER
}

fn host_dirty(w: *mut Host) -> bool {
    return (*w).dirty
}

// The caller has painted.
fn host_painted(w: *mut Host) {
    (*w).dirty = false
    (*w).frames = (*w).frames + 1
}

fn host_frames(w: *mut Host) -> u64 {
    return (*w).frames
}

// ========================================================= THE IMAGE FORMAT
//
// The canvas (lib/paint/canvas.fi) holds per point R, G, B, A in
// memory (premultiplied). An X server with 24-bit TrueColor and
// a Windows DIB want B, G, R, X (lib/window/window.fi, F3). So
// R and B are swapped and the fourth octet set to 0. The background of the window
// is opaque, so "premultiplied" is here
// the same as "straight".
//
// In Certus that was only a mask (`window.to_bgrx`), because Certus
// already paints in BGRX; fUi paints in RGBA -- the swap therefore stands
// here, once, with its reasoning, and x11_main checks it octet
// for octet.
fn rgba_to_bgrx(src: u64, dst: u64, n: usize) {
    var i: usize = 0
    while i < n {
        let o: u64 = (i * 4) as u64
        let r: u8 = *((src + o) as *mut u8)
        let g: u8 = *((src + o + 1) as *mut u8)
        let b: u8 = *((src + o + 2) as *mut u8)
        *((dst + o) as *mut u8) = b
        *((dst + o + 1) as *mut u8) = g
        *((dst + o + 2) as *mut u8) = r
        *((dst + o + 3) as *mut u8) = 0 as u8
        i = i + 1
    }
}
