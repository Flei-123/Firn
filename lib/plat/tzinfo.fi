// SPDX-License-Identifier: MPL-2.0
// lib/plat/tzinfo.fi -- the time zone of the DEVICE, ONE API on every platform.
//
//     import plat.tzinfo
//
//   tzinfo.tz_id()                 IANA name of the device zone ("Europe/Berlin"), "" = not known
//   tzinfo.tz_offset_min(ms)       UTC offset in minutes at the unix time `ms` (DST included), TZ_UNKNOWN = not known
//
// This file is the generic one: nothing is known (the caller falls back to its own default). The Android program gets the real one
// from lib/@android/plat/tzinfo.fi (java.util.TimeZone.getDefault() through JNI).
export { tz_id, tz_offset_min, TZ_UNKNOWN }

const TZ_UNKNOWN: i64 = 100000

fn tz_id() -> str { return "" }
fn tz_offset_min(ms: i64) -> i64 { return TZ_UNKNOWN }
