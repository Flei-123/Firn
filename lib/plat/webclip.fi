// SPDX-License-Identifier: MPL-2.0
// lib/plat/webclip.fi -- the system clipboard for a Firn page in the browser
// (OpenPlan LIB-006, the browser part; X11 is in lib/window/x11.fi).
//
// The browser's clipboard is asynchronous and guarded: writing is allowed
// while the page handles a user gesture (a key press, a click), reading
// asks for permission. So reading is a request whose answer comes back as
// an event, like web_fetch:
//
//     webclip.web_clip_write("text/plain;charset=utf-8", p, n)   // Ctrl+C
//     webclip.web_clip_read("text/plain;charset=utf-8")          // Ctrl+V
//     ... later: web.WE_CLIP, e.q/e.qn = the type, e.p/e.n = the data,
//         e.status 1 = there, 0 = empty, another type, or refused
//
// TYPES: "text/plain" (with or without ";charset=utf-8") goes through
// navigator.clipboard.writeText/readText; "image/png" as a ClipboardItem;
// any other type as a custom web format ("web <type>", Chromium) with the
// text alongside, so that another program still gets something. When the
// browser refuses a write, the host keeps the data for the page's own
// next read -- copy and paste inside the page keep working.
//
// Pasting with the browser's own shortcut into the host's text field still
// arrives as WE_TEXT (lib/plat/web.fi); this file is for a page that
// copies and pastes its own objects.
//
// WHY A MODULE OF ITS OWN: every `extern fn` is an import the host must
// answer, or the module does not start. Pages that do not import this file
// run on hosts that do not know it (demos/webdemo/firn.js knows it).

import plat.web

export {
    web_clip_write, web_clip_read,
}

extern fn firn_web_clip_write(mp: u32, mn: u32, p: u32, n: u32) -> u32;
extern fn firn_web_clip_read(mp: u32, mn: u32);

// Offers `n` octets at `p` as `mime`. false: this browser has no clipboard
// API at all (the host then still keeps the data for the page).
fn web_clip_write(mime: str, p: u64, n: usize) -> bool {
    return firn_web_clip_write(mime.p as u32, mime.n as u32, p as u32, n as u32) != 0 as u32
}

// Asks for the clipboard's content of type `mime`; the answer comes as
// web.WE_CLIP.
fn web_clip_read(mime: str) {
    firn_web_clip_read(mime.p as u32, mime.n as u32)
}
