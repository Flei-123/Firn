// lib/plat/fileio.fi -- hand a received file to the user (save + open in another app), ONE API on every platform.
//
//     import plat.fileio
//
//   fileio.fio_open(data, n, "report.pdf", "application/pdf")   // saves into Downloads/Jarvis and opens it; false = not possible
//   fileio.fio_share(data, n, "photo.jpg", "image/jpeg")        // saves and offers the share sheet
//
// Generic file: nothing can be shown (every call returns false). The Android program gets the real one from
// lib/@android/plat/fileio.fi (platform directory; plat.android.share).
export { fio_available, fio_open, fio_share }

fn fio_available() -> bool { return false }
fn fio_open(data: u64, n: usize, name: str, mime: str) -> bool { return false }
fn fio_share(data: u64, n: usize, name: str, mime: str) -> bool { return false }
