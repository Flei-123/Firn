import std.rt
import appkit.util

export { dir }

extern fn GetModuleFileNameW(h: i64, buf: u64, n: i64) -> i32;

fn dir(out: *mut rt.Buf) -> bool {
    var w: rt.Buf = rt.buf_new()
    if !util.buf_room(&w, 65536) {
        rt.buf_free(&w)
        return false
    }
    let n: i32 = GetModuleFileNameW(0, rt.buf_ptr(&w), 32768)
    if n <= 0 || n >= 32768 {
        rt.buf_free(&w)
        return false
    }
    var full: rt.Buf = rt.buf_new()
    util.utf16_to_utf8(rt.buf_ptr(&w), n as usize, false, &full)
    rt.buf_free(&w)
    var cut: usize = 0
    var i: usize = 0
    while i < rt.buf_len(&full) {
        let c: u8 = rt.ld8(rt.buf_ptr(&full), i)
        if c == 92 as u8 || c == 47 as u8 { cut = i }
        i = i + 1
    }
    if cut == 0 {
        rt.buf_free(&full)
        return false
    }
    rt.buf_clear(out)
    i = 0
    while i < cut {
        var c: u8 = rt.ld8(rt.buf_ptr(&full), i)
        if c == 92 as u8 { c = 47 as u8 }
        rt.buf_push(out, c)
        i = i + 1
    }
    rt.buf_free(&full)
    return true
}
