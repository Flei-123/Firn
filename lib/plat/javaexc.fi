// SPDX-License-Identifier: MPL-2.0
// lib/plat/javaexc.fi -- an UNCAUGHT JAVA EXCEPTION written to a file before the process dies; ONE API on every platform. This file is
// the generic one (no Java, nothing installed); the Android program gets the real one from lib/@android/plat/javaexc.fi.
//
//     javaexc.je_install(path)    // opens `path` (append), installs the default uncaught-exception handler; false = not available / failed
//     javaexc.je_available()
//     javaexc.je_test_throw()     // test hook: starts a Java thread that throws; false = not available
export { je_install, je_available, je_test_throw }

fn je_available() -> bool { return false }
fn je_install(path: str) -> bool { return false }
fn je_test_throw() -> bool { return false }
