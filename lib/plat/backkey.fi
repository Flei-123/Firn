// SPDX-License-Identifier: MPL-2.0
// lib/plat/backkey.fi -- the Android Back key for a program that wants to handle it, ONE API on every platform.
//
//     import plat.backkey
//
//   backkey.back_hold(true)    the program wants the Back key now (a drawer is open, a sub page is shown): the key is swallowed and counted
//   backkey.back_hold(false)   the program has nothing to close: Back does what Android does (the activity finishes)
//   backkey.back_take()        true once per Back press since the last call (poll it every <= 100 ms)
//
// Call back_hold every tick with the current state. Until the first call the old behaviour stays (Back = Escape). This file is the generic
// one: no Back key, nothing happens. The Android program gets the real one from lib/@android/plat/backkey.fi (android.activity).
export { back_hold, back_take }

fn back_hold(on: bool) {}
fn back_take() -> bool { return false }
