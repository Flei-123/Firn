// SPDX-License-Identifier: MPL-2.0
// lib/plat/envvar.fi -- ONE ENVIRONMENT VARIABLE, NATIVELY.
//
// `rt` has no environment (the start block of `main(start)` holds it, but
// `fn main()` never sees that). /proc/self/environ needs only open, read and
// close -- the way lib/window/x11.fi and lib/i18n/lang.fi get at it. This is
// the small public version for the places that only ask "is it set?"
// (fui.app's audit mode: FUI_AUDIT=1) or want the first value octet.
import std.rt

export { env_has, env_value_first, env_value_i64 }

// Is the variable `name` set (to anything, empty included)?
fn env_has(name: str) -> bool {
    return env_find(name) != 4294967295
}

// The first octet of the value of `name`, 0 when it is not set or empty.
fn env_value_first(name: str) -> u8 {
    var b: rt.Buf = rt.buf_new()
    var path: [u8; 19] = "/proc/self/environ\0"
    var first: u8 = 0 as u8
    if rt.read_file((&path[0]) as u64, &b) {
        let at: usize = find_in(rt.buf_ptr(&b), rt.buf_len(&b), name)
        if at != 4294967295 {
            first = rt.ld8(rt.buf_ptr(&b), at + name.n + 1)
        }
    }
    rt.buf_free(&b)
    return first
}

// The value of `name` as a non-negative decimal number, -1 when it is not
// set, empty or not a number (FUI_REFRESH_HZ=120).
fn env_value_i64(name: str) -> i64 {
    var b: rt.Buf = rt.buf_new()
    var path: [u8; 19] = "/proc/self/environ\0"
    var v: i64 = 0 - 1
    if rt.read_file((&path[0]) as u64, &b) {
        let at: usize = find_in(rt.buf_ptr(&b), rt.buf_len(&b), name)
        if at != 4294967295 {
            var i: usize = at + name.n + 1
            var acc: i64 = 0
            var any: bool = false
            var ok: bool = true
            while i < rt.buf_len(&b) && rt.ld8(rt.buf_ptr(&b), i) != 0 as u8 {
                let ch: u8 = rt.ld8(rt.buf_ptr(&b), i)
                if ch >= 48 as u8 && ch <= 57 as u8 && acc < 100000000 {
                    acc = acc * 10 + (ch as i64 - 48)
                    any = true
                } else {
                    ok = false
                }
                i = i + 1
            }
            if any && ok {
                v = acc
            }
        }
    }
    rt.buf_free(&b)
    return v
}

fn env_find(name: str) -> usize {
    var b: rt.Buf = rt.buf_new()
    var path: [u8; 19] = "/proc/self/environ\0"
    var r: usize = 4294967295
    if rt.read_file((&path[0]) as u64, &b) {
        r = find_in(rt.buf_ptr(&b), rt.buf_len(&b), name)
    }
    rt.buf_free(&b)
    return r
}

// The offset of the entry "name=" in the block `p`[0, n), or the maximum.
fn find_in(p: u64, n: usize, name: str) -> usize {
    var at: usize = 0
    while at < n {
        var e: usize = at
        while e < n && rt.ld8(p, e) != 0 as u8 {
            e = e + 1
        }
        if at + name.n + 1 <= e {
            var same: bool = true
            var i: usize = 0
            while i < name.n {
                if rt.ld8(p, at + i) != rt.ld8(name.p as u64, i) {
                    same = false
                }
                i = i + 1
            }
            if same && rt.ld8(p, at + name.n) == 61 as u8 {
                return at
            }
        }
        at = e + 1
    }
    return 4294967295
}
