// SPDX-License-Identifier: MPL-2.0
// lib/plat/blog.fi -- one line to the platform log with a tag, portable. Android: logcat (lib/@android/plat/blog.fi, liblog);
// everywhere else one line on stderr ("<tag> <text>"). Used by the bench app: tag BENCH.
//
//     blog.log("BENCH", "ready ms=1200")
//     blog.since_start_ms()    milliseconds since this process started (Linux/Android: /proc/self/stat + /proc/uptime), -1 if unknown
import std.rt
import std.io
import std.fs

export { log, since_start_ms }

fn log(tag: str, text: str) {
    io.eprint_line(tag + " " + text)
}

// the n-th (1 based) blank separated token after the last ')' of a /proc/<pid>/stat line (token 1 = field 3, the state)
fn stat_token(p: u64, n: usize, k: usize) -> i64 {
    var last: usize = 0
    var i: usize = 0
    while i < n {
        if rt.ld8(p, i) == 41 as u8 { last = i }
        i = i + 1
    }
    var tok: usize = 0
    i = last + 1
    while i < n {
        while i < n && rt.ld8(p, i) == 32 as u8 { i = i + 1 }
        if i >= n { return 0 - 1 }
        tok = tok + 1
        var v: i64 = 0
        while i < n && rt.ld8(p, i) != 32 as u8 {
            let c: u8 = rt.ld8(p, i)
            if c >= 48 as u8 && c <= 57 as u8 { v = v * 10 + (c as i64 - 48) }
            i = i + 1
        }
        if tok == k { return v }
    }
    return 0 - 1
}

fn since_start_ms() -> i64 {
    var a: rt.Buf = rt.buf_new()
    let na: usize = fs.read_file("/proc/self/stat", &a) catch 0
    var r: i64 = 0 - 1
    if na > 0 {
        let st: i64 = stat_token(rt.buf_ptr(&a), na, 20) // field 22 starttime, clock ticks (100 Hz) since boot (CLOCK_BOOTTIME base)
        var ts: [i64; 2] = [0; 2]
        syscall(228, 7, (&ts[0]) as i64, 0, 0, 0, 0)
        let now_ms: i64 = ts[0] * 1000 + ts[1] / 1000000
        if st >= 0 && now_ms >= st * 10 { r = now_ms - st * 10 }
    }
    rt.buf_free(&a)
    return r
}
