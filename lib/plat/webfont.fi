import std.rt
import font.metrics
import font.fontprov
import font.platmetrics
import font.platglyph
import fui.painter

export { web_font_apply, web_font_wanted }

extern fn firn_web_text_probe() -> u32;
extern fn firn_web_text_advance(cp: u32, size: f64, weight: u32) -> f64;
extern fn firn_web_text_pair(a: u32, b: u32, size: f64, weight: u32) -> f64;
extern fn firn_web_text_vmetrics(size: f64, weight: u32, out: u32) -> u32;
extern fn firn_web_text_glyph(cp: u32, size: f64, weight: u32, slant: u32, qx: u32, buf: u32, cap: u32, meta: u32) -> i32;

static mut G_WANT: u32 = 0
static mut G_APPLIED: bool = false

fn bridge_advance(cp: u32, size: f64, weight: u32) -> f64 {
    return firn_web_text_advance(cp, size, weight)
}

fn bridge_pair(a: u32, b: u32, size: f64, weight: u32) -> f64 {
    return firn_web_text_pair(a, b, size, weight)
}

fn bridge_vmetrics(size: f64, weight: u32, out: *mut f64) -> bool {
    return firn_web_text_vmetrics(size, weight, out as u64 as u32) != 0 as u32
}

fn bridge_glyph(cp: u32, size: f64, weight: u32, slant: u32, qx: u32, buf: u64, cap: usize, meta: *mut i32) -> i64 {
    return firn_web_text_glyph(cp, size, weight, slant, qx, buf as u32, cap as u32, meta as u64 as u32) as i64
}

#[export_c]
fn firn_web_font_backend(mode: u32) {
    G_WANT = mode
}

#[export_c]
fn firn_web_font_stat(i: u32) -> f64 {
    let k: usize = i as usize
    if k < 6 { return platmetrics.pm_stats(k) as f64 }
    if k < 10 { return platglyph.pg_stat(k - 6) as f64 }
    return fontprov.mode_get() as f64
}

fn web_font_wanted() -> u32 { return G_WANT }

fn web_font_apply(z: *mut painter.Painter) -> bool {
    if G_APPLIED { return fontprov.platform_on() }
    G_APPLIED = true
    if G_WANT != fontprov.MODE_PLATFORM { return false }
    if firn_web_text_probe() == 0 as u32 { return false }
    let base: u64 = painter.painter_font(z)
    if !metrics.fm_present(base) { return false }
    fontprov.prov_set(fontprov.Provider { advance: bridge_advance, pair: bridge_pair, vmetrics: bridge_vmetrics, glyph: bridge_glyph })
    fontprov.mode_set(fontprov.MODE_PLATFORM)
    let main: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if main as u64 == 0 { return false }
    metrics.fontset_platform(main, base as *mut metrics.FontSet, 400)
    painter.painter_set_font(z, main as u64)
    var i: usize = 0
    while i < 3 {
        let f: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
        if f as u64 != 0 {
            metrics.fontset_platform(f, base as *mut metrics.FontSet, 500 + i * 100)
            painter.painter_set_weight_face(z, i, 500 + i * 100, f as u64)
        }
        i = i + 1
    }
    return true
}
