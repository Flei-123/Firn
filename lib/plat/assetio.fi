import std.rt
import fui.datadir

export { read }

fn read(name: str, out: *mut rt.Buf) -> bool {
    var p: rt.Buf = rt.buf_new()
    let full: str = datadir.file(name)
    rt.buf_push_bytes(&p, full.p as u64, full.n)
    rt.buf_push(&p, 0 as u8)
    let ok: bool = rt.read_file(rt.buf_ptr(&p), out)
    rt.buf_free(&p)
    return ok
}
