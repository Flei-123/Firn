// SPDX-License-Identifier: MPL-2.0
// lib/plat/fuiwinvk.fi -- plat.fuiwinvk: the fUi window host with fUi painted ON VULKAN (W18-F3, `FUI_GPU=1`).
//
// lib/plat/fuiwin.fi paints fUi on the CPU. This file is the PROVIDER for the other way: the GL table of lib/paint/gl.fi
// filled by Vulkan (lib/fui/gpu_vk.fi), so fUi's renderer (lib/fui/gpu.fi) paints into a Vulkan image; every frame the
// canvas is read back and the ordinary CPU present (RGBA -> BGRX + PutImage) shows it. Same events, same layout, same
// painter calls -- only WHERE the pixels are made changes.
//
//     import plat.fuiwinvk
//     var fx: fuiwin.Window = fuiwin.window_new()
//     fuiwinvk.window_use_env(&fx)          // BEFORE window_open: FUI_GPU=1 asks for Vulkan, anything else = the CPU painter
//     fuiwin.window_open(&fx, ...)          // ... as always; fuiwin.window_gpu(&fx) / window_gpu_readback(&fx) say what runs
//
// WHY A PROVIDER AND NOT A PLAIN IMPORT IN fuiwin.fi: gpu_vk.fi imports std.dynlib (the Vulkan loader), and that makes the
// program a dynamically linked ELF. A program that imports THIS file takes that on; every other fUi program (OrientOS has no
// libc) stays static. So: import plat.fuiwinvk only in programs that may run on a desktop with Vulkan.
//
// AUTOMATIC CPU FALLBACK (nothing for the program to do): no libvulkan / no device (or FUI_GPU_FAIL=open), a shader that does
// not build (FUI_GPU_FAIL=compile), no memory for the canvas target -> the window opens and paints on the CPU. A device that
// fails LATER (a submit or wait error; FUI_GPU_FAIL=lost fakes it at the 3rd read-back) -> that very frame is painted again on
// the CPU and the GPU is dropped for the rest of the run.
// HONEST: software Vulkan (lavapipe) is a CPU -- this proves the arithmetic and the fallback, not a speed-up. A real GPU: the
// Intel Iris Xe of a Windows 11 laptop passed gpuparity (docs/fui-gpu-path.md); other drivers are UNTESTED.
import std.rt
import std.env
import paint.gl
import fui.gpu_vk
import plat.fuiwin
import gpu.vkplat

export { window_use, window_use_env, pre_open_env, wanted, device_name, is_software, policy, POLICY_CPU, POLICY_VULKAN, POLICY_GL_FIRST, POLICY_VULKAN_FIRST }

fn provide(api: *mut gl.GlApi) -> bool {
    return gpu_vk.vkgl_api(api)
}

fn alive() -> bool {
    return gpu_vk.vkgl_alive()
}

// The device stays open for the process (other windows share it); there is nothing to give back per window.
fn release() {
}

// W39: the swapchain present of the provider (fuiwin.window_set_gpu_present). FUI_GPU_PRESENT=0 keeps the read-back path (A/B timing).
fn present_open(native: u64, w: i32, h: i32) -> bool {
    return gpu_vk.vkgl_present_open(native, w, h)
}

fn present_show(w: i32, h: i32) -> i32 {
    return gpu_vk.vkgl_present(w, h)
}

fn present_close() {
    gpu_vk.vkgl_present_close()
}

fn present_vsync(on: bool) {
    gpu_vk.vkgl_present_vsync(on)
}

fn install(fx: *mut fuiwin.Window, force: bool, allow_cpu: bool) {
    gpu_vk.vkgl_options(env.get("FUI_GPU_PRESENT") != "0", allow_cpu)
    fuiwin.window_set_gpu_provider(fx, provide, alive, release)
    fuiwin.window_set_gpu_present(fx, present_open, present_show, present_close, present_vsync)
    // force: Vulkan goes FIRST even where the window layer has OpenGL of its own (Windows, W38)
    fuiwin.window_force_provider(fx, force)
}

// Always use Vulkan if it can be had (a program's own switch, e.g. a --gpu flag). Call before fuiwin.window_open. On a window with a
// native handle the canvas reaches the screen by swapchain present; without one (or when the swapchain fails) by read-back + CPU present.
fn window_use(fx: *mut fuiwin.Window) {
    install(fx, true, true)
}

const POLICY_CPU: i32 = 0 // FUI_GPU=0
const POLICY_VULKAN: i32 = 1 // FUI_GPU=1: Vulkan first (any device), then the window's OpenGL, then the CPU
const POLICY_GL_FIRST: i32 = 2 // window's own OpenGL first, Vulkan (real GPU only) second, CPU last
const POLICY_VULKAN_FIRST: i32 = 3 // Vulkan on a real GPU first, the window's OpenGL second, CPU last

// What the environment asks for. FUI_GPU=0 CPU, 1 Vulkan, anything else / unset = the platform default: on Windows `auto_policy`, elsewhere
// the CPU painter stays the default (docs/fui-gpu-path.md).
fn policy() -> i32 {
    let e: str = env.get("FUI_GPU")
    if e == "0" {
        return POLICY_CPU
    }
    if e == "1" {
        return POLICY_VULKAN
    }
    if e == "gl" {
        return POLICY_GL_FIRST
    }
    if e == "vk" {
        return POLICY_VULKAN_FIRST
    }
    if vkplat.plat_name() == "win32" {
        return auto_policy()
    }
    return POLICY_CPU
}

// The Windows default (FUI_GPU unset). Chosen from the Iris Xe measurements of W39 (docs/fui-gpu-path.md).
fn auto_policy() -> i32 {
    return POLICY_GL_FIRST
}

// FUI_GPU in the environment decides (see `policy`). Returns whether the Vulkan provider was installed.
fn window_use_env(fx: *mut fuiwin.Window) -> bool {
    let p: i32 = policy()
    if p == POLICY_CPU {
        // an explicit 0 is the pure CPU painter also where the window layer has OpenGL of its own; elsewhere it is the default anyway
        if env.get("FUI_GPU") == "0" {
            fuiwin.window_set_gpu(fx, false)
        }
        return false
    }
    if p == POLICY_VULKAN {
        install(fx, true, true)
    } else if p == POLICY_VULKAN_FIRST {
        install(fx, true, false)
    } else {
        install(fx, false, false)
    }
    return true
}

// For programs built on fui.app: `app.set_pre_open(a, fuiwinvk.pre_open_env)`. The host calls it with the window it is about to open;
// FUI_GPU=1 installs the Vulkan provider on it, anything else leaves the CPU painter (and the program unchanged).
fn pre_open_env(fx: u64) {
    let used: bool = window_use_env(fx as *mut fuiwin.Window)
}

// FUI_GPU is set to "1".
fn wanted() -> bool {
    return env.get("FUI_GPU") == "1"
}

// Address of the NUL-terminated device name (0 before the first window opened Vulkan).
fn device_name() -> u64 {
    return gpu_vk.vkgl_device()
}

// The Vulkan device is a CPU (llvmpipe/lavapipe): its timings are NOT GPU timings.
fn is_software() -> bool {
    return gpu_vk.vkgl_is_cpu()
}
