// SPDX-License-Identifier: MPL-2.0
// lib/plat/voiceio.fi -- microphone + speech output for an app, ONE API on every platform.
//
//     import plat.voiceio
//
//   let r: i32 = voiceio.vio_mic_toggle()   // VIO_STARTED (recording) / VIO_STOPPED (a WAV is ready) / VIO_PERMISSION (ask shown) / VIO_FAILED
//   voiceio.vio_poll()                      // every <= 200 ms: feeds the microphone buffer and the speech engine
//   voiceio.vio_mic_wav(), vio_mic_wav_len()  // after VIO_STOPPED: a complete 16 kHz mono WAV; vio_mic_free() when it was uploaded
//   voiceio.vio_say(text) / vio_say_stop()  // speech output
//   voiceio.vio_set_rate(1.25f)             // speech speed for the next vio_say (1.0 normal; a65)
//   voiceio.vio_play_start(wav, n)          // a66: plays a PCM16 WAV in memory (Piper audio of /tts); vio_play_state() = VIO_PLAY_*; vio_play_stop()
//                                           // the memory must stay valid while it plays. Here (generic): NO sound, only the timing of the audio.
//
// This file is the generic one: no microphone, no voice (every call says so). The Android program gets the real one from
// lib/@android/plat/voiceio.fi (platform directory, no compiler switch; plat.android.speech + plat.android.tts).
import plat.android.pcmwav
import std.time

export {
    VIO_STARTED, VIO_STOPPED, VIO_PERMISSION, VIO_FAILED,
    vio_available, vio_mic_toggle, vio_mic_recording, vio_mic_level, vio_mic_wav, vio_mic_wav_len, vio_mic_free,
    vio_poll, vio_say, vio_say_stop, vio_say_active, vio_set_rate, vio_error_text,
    VIO_PLAY_IDLE, VIO_PLAY_PLAYING, VIO_PLAY_DONE, VIO_PLAY_FAILED, vio_play_start, vio_play_state, vio_play_stop,
}

const VIO_STARTED: i32 = 0
const VIO_STOPPED: i32 = 1
const VIO_PERMISSION: i32 = 2
const VIO_FAILED: i32 = 3

fn vio_available() -> bool { return false }
fn vio_mic_toggle() -> i32 { return VIO_FAILED }
fn vio_mic_recording() -> bool { return false }
fn vio_mic_level() -> i32 { return 0 }
fn vio_mic_wav() -> u64 { return 0 }
fn vio_mic_wav_len() -> usize { return 0 }
fn vio_mic_free() {}
fn vio_poll() {}
fn vio_say(text: str) -> bool { return false }
fn vio_say_stop() {}
fn vio_say_active() -> bool { return false }
fn vio_set_rate(r: f32) {}
fn vio_error_text() -> str { return "no microphone on this platform" }

// ---- a66: playing a WAV (Piper). The generic version plays nothing but keeps the clock of the audio, so the whole read-aloud
// pipeline (fetch -> queue -> next chunk) can be tested on the desktop without a sound device.
const VIO_PLAY_IDLE: i32 = 0
const VIO_PLAY_PLAYING: i32 = 1
const VIO_PLAY_DONE: i32 = 2
const VIO_PLAY_FAILED: i32 = 3

static mut G_PLAY: i32 = 0
static mut G_PLAY_END_NS: u64 = 0 as u64

fn vio_play_start(p: u64, n: usize) -> bool {
    var info: pcmwav.WavInfo = pcmwav.WavInfo { rate: 0 as u32, channels: 0 as u32, bits: 0 as u32, data_at: 0, data_len: 0 }
    G_PLAY = VIO_PLAY_IDLE
    if p == 0 || !pcmwav.wav_parse(p, n, &info) || info.rate == 0 as u32 || info.channels == 0 as u32 { return false }
    let frames: u64 = (info.data_len as u64) / ((info.channels as u64) * 2 as u64)
    let ns: u64 = frames * 1000000000 as u64 / (info.rate as u64)
    G_PLAY_END_NS = time.monotonic_ns() + ns
    G_PLAY = VIO_PLAY_PLAYING
    return true
}

fn vio_play_state() -> i32 {
    if G_PLAY == VIO_PLAY_PLAYING && time.monotonic_ns() >= G_PLAY_END_NS { G_PLAY = VIO_PLAY_DONE }
    return G_PLAY
}

fn vio_play_stop() { G_PLAY = VIO_PLAY_IDLE }
