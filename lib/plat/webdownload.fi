// SPDX-License-Identifier: MPL-2.0
// lib/plat/webdownload.fi -- hand a file to the user from a Firn page in the browser.
//
//     webdownload.web_download("font.ttf", "font/ttf", p, n)
//
// The host makes a Blob of the `n` octets at `p`, clicks a temporary
// <a download=name> and revokes the URL later. It must run inside a user
// gesture (a click or key handler) or the browser may refuse; false means
// this host has no way to download. Pages that do not import this file run
// on hosts that do not know it (demos/webdemo/firn.js knows it).

export { web_download }

extern fn firn_web_download(np: u32, nn: u32, mp: u32, mn: u32, p: u32, n: u32) -> u32;

fn web_download(name: str, mime: str, p: u64, n: usize) -> bool {
    return firn_web_download(name.p as u32, name.n as u32, mime.p as u32, mime.n as u32, p as u32, n as u32) != 0 as u32
}
