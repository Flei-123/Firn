// SPDX-License-Identifier: MPL-2.0
// lib/plat/kbd.fi -- where the visible part of the window ends (the on-screen keyboard covers the rest), ONE API on every platform.
//
//     import plat.kbd
//
//   kbd.kbd_visible_bottom()   // screen pixels, -1 = not known / no on-screen keyboard
//   kbd.kbd_reset_input()      // the program cleared the focused field: the keyboard drops its copy of the text
//
// Generic: -1 / no-op. The Android program gets the real ones from lib/@android/plat/kbd.fi.
export { kbd_visible_bottom, kbd_reset_input }

fn kbd_visible_bottom() -> i32 { return -1 }

fn kbd_reset_input() {}
