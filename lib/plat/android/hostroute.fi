import std.rt
import plat.hostev
import plat.fileio
import plat.intentx
import plat.backkey
import plat.android.hostbus

export { location, navigate, back_hold }

const ROUTE_CAP: usize = 256
const ROUTE_DEPTH: usize = 16
const START_ROUTE: str = "/"
const START_ROUTE_KEY: str = "route"
const SLASH: u8 = 47
const HASH: u8 = 35

static mut G_ROUTES: [u8; 4096] = [0; 4096]
static mut G_LENS: [usize; 16] = [0; 16]
static mut G_DEPTH: usize = 0
static mut G_WANTS_BACK: bool = false

fn slot(i: usize) -> u64 { return ((&G_ROUTES[0]) as u64) + ((i * ROUTE_CAP) as u64) }

fn push_route(p: u64, n: usize) {
    if G_DEPTH == ROUTE_DEPTH {
        var i: usize = 1
        while i < ROUTE_DEPTH {
            rt.mem_copy(slot(i - 1), slot(i), G_LENS[i])
            G_LENS[i - 1] = G_LENS[i]
            i = i + 1
        }
        G_DEPTH = G_DEPTH - 1
    }
    var len: usize = n
    if len > ROUTE_CAP { len = ROUTE_CAP }
    rt.mem_copy(slot(G_DEPTH), p, len)
    G_LENS[G_DEPTH] = len
    G_DEPTH = G_DEPTH + 1
}

fn route_init() {
    if G_DEPTH > 0 { return }
    let start: str = intentx.ix_str(START_ROUTE_KEY, START_ROUTE)
    push_route(start.p as u64, start.n)
}

fn is_route(url: u64, un: usize) -> bool {
    if un == 0 { return false }
    let c: u8 = rt.ld8(url, 0)
    return c == SLASH || c == HASH
}

fn announce() {
    var e: hostev.HostEvent = hostev.blank(hostev.WE_ROUTE)
    e.p = slot(G_DEPTH - 1)
    e.n = G_LENS[G_DEPTH - 1]
    let used: bool = hostbus.bus_emit(&e)
}

fn apply_back_mode() {
    backkey.back_hold(G_WANTS_BACK || G_DEPTH > 1)
}

fn route_turn() {
    if !backkey.back_take() { return }
    if G_WANTS_BACK {
        var e: hostev.HostEvent = hostev.blank(hostev.WE_BACK)
        let used: bool = hostbus.bus_emit(&e)
        return
    }
    if G_DEPTH > 1 {
        G_DEPTH = G_DEPTH - 1
        announce()
        apply_back_mode()
    }
}

fn start_watching() {
    let hooked: bool = hostbus.bus_on_turn(route_turn)
    apply_back_mode()
}

fn location(out: u64, cap: usize) -> usize {
    route_init()
    var n: usize = G_LENS[G_DEPTH - 1]
    if n > cap { n = cap }
    rt.mem_copy(out, slot(G_DEPTH - 1), n)
    return n
}

fn navigate(url: u64, un: usize) {
    if !is_route(url, un) {
        let opened: bool = fileio.fio_open_url(str { p: url as *mut u8, n: un })
        return
    }
    route_init()
    push_route(url, un)
    start_watching()
    announce()
}

fn back_hold(on: bool) {
    route_init()
    G_WANTS_BACK = on
    start_watching()
}
