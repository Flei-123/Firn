import std.rt
import std.time
import async.loop
import async.ahttp
import plat.hostev
import window.window

export {
    bus_loop, bus_client, bus_set_sink, bus_emit, bus_pump, bus_fd, bus_wait_ms,
    bus_set_dark, bus_dark, bus_wake_in, bus_wake_after, bus_wake_due,
    bus_set_window, bus_window, bus_set_dpr, bus_dpr, bus_on_turn, bus_turn,
}

const TURN_MAX: usize = 8
const MS_PER_NS: f64 = 1000000.0

static mut G_LOOP: u64 = 0
static mut G_CLIENT: u64 = 0
static mut G_DARK: bool = false
static mut G_WAKE_AT: f64 = 0.0
static mut G_WINDOW: u64 = 0
static mut G_DPR: usize = 1000
static mut G_TURN_N: usize = 0
static mut G_TURNS: [u64; 8] = [0; 8]
static mut G_SINK: fn(*mut hostev.HostEvent) -> bool = 0 as fn(*mut hostev.HostEvent) -> bool

fn loop_size() -> usize {
    var probe: [loop.Loop; 2] = [loop.loop_new(); 2]
    return ((&probe[1]) as usize) - ((&probe[0]) as usize)
}

fn client_size() -> usize {
    var probe: [ahttp.AClient; 2] = [ahttp.aclient_new(); 2]
    return ((&probe[1]) as usize) - ((&probe[0]) as usize)
}

fn bus_loop() -> *mut loop.Loop {
    if G_LOOP == 0 {
        let p: u64 = rt.heap_alloc(loop_size())
        if p == 0 { return 0 as *mut loop.Loop }
        *(p as *mut loop.Loop) = loop.loop_new()
        if !loop.loop_init(p as *mut loop.Loop) { return 0 as *mut loop.Loop }
        G_LOOP = p
    }
    return G_LOOP as *mut loop.Loop
}

fn bus_client() -> *mut ahttp.AClient {
    if G_CLIENT == 0 {
        let l: *mut loop.Loop = bus_loop()
        if l as u64 == 0 { return 0 as *mut ahttp.AClient }
        let p: u64 = rt.heap_alloc(client_size())
        if p == 0 { return 0 as *mut ahttp.AClient }
        *(p as *mut ahttp.AClient) = ahttp.aclient_new()
        if !ahttp.aclient_init(p as *mut ahttp.AClient, l) { return 0 as *mut ahttp.AClient }
        G_CLIENT = p
    }
    return G_CLIENT as *mut ahttp.AClient
}

fn bus_set_sink(f: fn(*mut hostev.HostEvent) -> bool) {
    G_SINK = f
}

fn bus_emit(e: *mut hostev.HostEvent) -> bool {
    if G_SINK as u64 == 0 { return false }
    let f: fn(*mut hostev.HostEvent) -> bool = G_SINK
    return f(e)
}

fn bus_fd() -> i32 {
    let l: *mut loop.Loop = bus_loop()
    if l as u64 == 0 { return 0 - 1 }
    return loop.loop_fd(l)
}

fn wake_left_ms(wanted: i64) -> i64 {
    if G_WAKE_AT == 0.0 { return wanted }
    let left: f64 = G_WAKE_AT - (time.monotonic_ns() as f64) / MS_PER_NS
    if left <= 0.0 { return 0 as i64 }
    let due: i64 = (left as i64) + 1
    if due < wanted { return due }
    return wanted
}

fn bus_wait_ms(wanted: i64) -> i64 {
    let ms: i64 = wake_left_ms(wanted)
    let l: *mut loop.Loop = bus_loop()
    if l as u64 == 0 { return ms }
    return loop.embed_wait_ms(l, ms)
}

fn bus_pump() -> bool {
    let l: *mut loop.Loop = bus_loop()
    if l as u64 == 0 { return false }
    return loop.run_once(l, 0) != (0 as u64)
}

fn bus_set_dark(on: bool) { G_DARK = on }

fn bus_dark() -> bool { return G_DARK }

fn bus_wake_in(now_ms: f64, ms: f64) {
    let at: f64 = now_ms + ms
    if G_WAKE_AT == 0.0 || at < G_WAKE_AT { G_WAKE_AT = at }
}

fn bus_wake_after(ms: f64) {
    bus_wake_in((time.monotonic_ns() as f64) / MS_PER_NS, ms)
}

fn bus_wake_due(now_ms: f64) -> bool {
    if G_WAKE_AT == 0.0 || now_ms < G_WAKE_AT { return false }
    G_WAKE_AT = 0.0
    return true
}

fn bus_set_window(w: *mut window.Window) { G_WINDOW = w as u64 }

fn bus_window() -> *mut window.Window { return G_WINDOW as *mut window.Window }

fn bus_set_dpr(per_mille: usize) { G_DPR = per_mille }

fn bus_dpr() -> usize { return G_DPR }

fn bus_on_turn(f: fn()) -> bool {
    var i: usize = 0
    while i < G_TURN_N {
        if G_TURNS[i] == f as u64 { return true }
        i = i + 1
    }
    if G_TURN_N >= TURN_MAX { return false }
    G_TURNS[G_TURN_N] = f as u64
    G_TURN_N = G_TURN_N + 1
    return true
}

fn bus_turn() {
    var i: usize = 0
    while i < G_TURN_N {
        let f: fn() = G_TURNS[i] as fn()
        f()
        i = i + 1
    }
}
