import std.rt
import async.ahttp
import plat.hostev
import plat.android.hostbus
import plat.android.hostorigin

export { fetch_start }

const JSON_TYPE: str = "application/json"
const FETCH_TIMEOUT_MS: i64 = 60000

fn fetch_done(r: *mut ahttp.Request, ud: u64) {
    var e: hostev.HostEvent = hostev.blank(hostev.WE_FETCH)
    e.id = ud as u32
    if ahttp.areq_error(r) == 0 {
        e.status = ahttp.areq_status(r)
        e.p = ahttp.areq_body_ptr(r)
        e.n = ahttp.areq_body_len(r)
    }
    let used: bool = hostbus.bus_emit(&e)
}

fn fetch_start(id: u32, method: u64, mn: usize, url: u64, un: usize, body: u64, bn: usize) {
    let a: *mut ahttp.AClient = hostbus.bus_client()
    var full: rt.Buf = rt.buf_new()
    hostorigin.origin_join(url, un, &full)
    var ct: u64 = 0
    var ctn: usize = 0
    if bn > 0 {
        ct = JSON_TYPE.p as u64
        ctn = JSON_TYPE.n
    }
    var rq: *mut ahttp.Request = 0 as *mut ahttp.Request
    if a as u64 != 0 {
        rq = ahttp.aclient_request(a, method, mn, rt.buf_ptr(&full), rt.buf_len(&full),
            body, bn, ct, ctn, FETCH_TIMEOUT_MS, fetch_done, id as u64)
    }
    rt.buf_free(&full)
    if rq as u64 == 0 {
        var e: hostev.HostEvent = hostev.blank(hostev.WE_FETCH)
        e.id = id
        let used: bool = hostbus.bus_emit(&e)
    }
}
