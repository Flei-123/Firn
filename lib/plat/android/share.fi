// SPDX-License-Identifier: MPL-2.0
// lib/plat/android/share.fi -- FILES AND TEXT OUT OF THE APP: save to Downloads, open, share, clipboard.
//
//     import plat.android.share
//
//   share.share_save(data, n, "report.pdf\0".p, "application/pdf\0".p, 0)   // 1 = in Downloads, 2 = private file, 0 = failed
//   share.share_view_last()                         // ACTION_VIEW on the file just saved (another app opens it)
//   share.share_send_last("Send report")            // ACTION_SEND + chooser for the file just saved
//   share.share_send_text(p, n, "Share")            // ACTION_SEND text/plain (UTF-8 p[0, n))
//   share.share_open_url("https://...\0".p)         // ACTION_VIEW on a link (browser)
//   share.clip_write(p, n)  /  share.clip_read(p, cap) -> n     // the system clipboard, UTF-8 text
//
// ================================================================= WHERE FILES GO
//
// MediaStore.Downloads (Android 10+, API 29): the file appears in the Files app under Download/<sub> and needs
// NO storage permission for what we write ourselves. `sub` is an optional sub folder name (a C string, "Jarvis")
// or 0 for Download itself. A name that exists gets a number from Android ("report (1).pdf"). Below API 29 --
// and when MediaStore refuses -- the file is written into the app's working directory (result 2, the app can
// still send it with its own means). The Uri of the last saved file is kept (global reference) so that
// view / send need no path: Android's content Uri + FLAG_GRANT_READ_URI_PERMISSION give the other app
// access to exactly that file, no FileProvider and no extra manifest entry.
//
// ================================================================= THE CLIPBOARD
//
// lib/window/android.fi leaves the system clipboard unconnected (fUi then copies inside the app only). The
// two functions here have exactly the signatures of editor.editor_set_clipboard(read, write):
//     editor.editor_set_clipboard(&ed, share.clip_read, share.clip_write)
// Android 10+ lets only the focused app READ the clipboard (clip_read answers 0 otherwise). Text goes through
// UTF-16 (plat.android.jtext), so emoji are safe under CheckJNI. Limit 65536 UTF-16 units; longer text is
// refused (false), never cut silently.
//
// ================================================================= THREADS
//
// All #[no_gc]; JNI on the program's own thread only (never on an attached worker thread).
import android.ndk
import android.jnicall
import android.activity
import plat.android.jtext

export {
    share_save, share_view_last, share_send_last, share_send_text, share_open_url, share_last_ok,
    clip_write, clip_read, clip_has,
}

