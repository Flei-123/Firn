// SPDX-License-Identifier: MPL-2.0
// lib/plat/android/focusplan.fi -- pure focus-stack planning (no device access, testable on the host).
export { focus_plan, tap_region, zoom_crop, zoom_pick, zoom_stops }

// Focus positions (diopters) for a focus stack, near to far, as a PURE function of the lens facts:
// near_d = LENS_INFO_MINIMUM_FOCUS_DISTANCE, far_d = hyperfocal (or 0 = infinity), step_d = how far apart
// two positions may be so that the sharp zones touch (about the depth of field in diopters:
// 2 * N * c / f^2 * 1000, c = circle of confusion mm, N = f number, f = focal length mm; pass 0 to use
// a quarter of the near distance). The count adapts to the range, at least 2, at most nmax. Writes the
// positions to out[0..n) and returns n. near_d <= 0 (fixed focus lens) -> 0: no focus stack possible.
#[no_gc]
fn focus_plan(near_d: f32, far_d: f32, step_d: f32, nmax: i32, out: u64) -> i32 {
    if near_d <= 0.0f || nmax < 2 { return 0 }
    var far: f32 = far_d
    if far < 0.0f { far = 0.0f }
    if far >= near_d { return 0 }
    let span: f32 = near_d - far
    var step: f32 = step_d
    if step <= 0.0f { step = near_d * 0.25f }
    var n: i32 = (span / step) as i32 + 1
    if (n as f32) * step < span { n = n + 1 }
    if n < 2 { n = 2 }
    if n > nmax { n = nmax }
    var i: i32 = 0
    while i < n {
        *((out + ((i * 4) as u64)) as *mut f32) = near_d - span * (i as f32) / ((n - 1) as f32)
        i = i + 1
    }
    return n
}

// ------------------------------------------------------------ tap to focus / zoom (pure)

// Tap point -> metering region. (nx, ny) is a point in 0..1 of the UPRIGHT preview (the sensor picture rotated
// `rot` degrees clockwise, as camera_preview_bgrx(rot = orientation) shows it; mirror = the preview is flipped
// horizontally, front camera). The zoom window is the centre 1/zoom of the active array; the region keeps the same
// share of the VISIBLE picture (size_frac of its shorter side, e.g. 0.15) and is clamped into the array.
// Writes out[0..4) = xmin, ymin, xmax, ymax (i32, active-array pixels, android.control.afRegions order).
#[no_gc]
fn tap_region(nx: f32, ny: f32, rot: i32, mirror: bool, zoom: f32, aw: i32, ah: i32, size_frac: f32, out: u64) -> bool {
    if aw <= 8 || ah <= 8 { return false }
    if nx < 0.0f || nx > 1.0f || ny < 0.0f || ny > 1.0f { return false }
    var ux: f32 = nx
    if mirror { ux = 1.0f - nx }
    var sx: f32 = ux
    var sy: f32 = ny
    let r: i32 = ((rot % 360) + 360) % 360
    if r == 90 {
        sx = ny
        sy = 1.0f - ux
    } else if r == 180 {
        sx = 1.0f - ux
        sy = 1.0f - ny
    } else if r == 270 {
        sx = 1.0f - ny
        sy = ux
    }
    var z: f32 = zoom
    if z < 1.0f { z = 1.0f }
    let cx: f32 = (0.5f + (sx - 0.5f) / z) * (aw as f32)
    let cy: f32 = (0.5f + (sy - 0.5f) / z) * (ah as f32)
    // the region is square in SENSOR pixels, sized from the shorter side of the visible window
    var short: f32 = aw as f32
    if (ah as f32) < short { short = ah as f32 }
    var frac: f32 = size_frac
    if frac < 0.02f { frac = 0.02f }
    if frac > 1.0f { frac = 1.0f }
    let half: f32 = short * frac / z * 0.5f
    var x0: i32 = (cx - half) as i32
    var y0: i32 = (cy - half) as i32
    var x1: i32 = (cx + half) as i32
    var y1: i32 = (cy + half) as i32
    if x0 < 0 { x0 = 0 }
    if y0 < 0 { y0 = 0 }
    if x1 > aw - 1 { x1 = aw - 1 }
    if y1 > ah - 1 { y1 = ah - 1 }
    if x1 <= x0 { x1 = x0 + 1 }
    if y1 <= y0 { y1 = y0 + 1 }
    *((out) as *mut i32) = x0
    *((out + 4) as *mut i32) = y0
    *((out + 8) as *mut i32) = x1
    *((out + 12) as *mut i32) = y1
    return true
}

// Centre crop for SCALER_CROP_REGION (devices without CONTROL_ZOOM_RATIO): out[0..4) = left, top, width, height
// (even numbers, never outside the array).
#[no_gc]
fn zoom_crop(zoom: f32, aw: i32, ah: i32, out: u64) {
    var z: f32 = zoom
    if z < 1.0f { z = 1.0f }
    var w: i32 = ((aw as f32) / z) as i32
    var h: i32 = ((ah as f32) / z) as i32
    w = w - (w % 2)
    h = h - (h % 2)
    if w < 2 { w = 2 }
    if h < 2 { h = 2 }
    if w > aw { w = aw }
    if h > ah { h = ah }
    *((out) as *mut i32) = (aw - w) / 2
    *((out + 4) as *mut i32) = (ah - h) / 2
    *((out + 8) as *mut i32) = w
    *((out + 12) as *mut i32) = h
}

// Which lens serves zoom `zoom` (1.0 = the main lens `ref_idx`). equiv[0..n) = 35 mm equivalent focal length of
// each candidate lens (0 = not a candidate, e.g. other facing). The target equivalent is equiv[ref] * zoom; the lens
// with the longest equivalent that is not (more than 5 %) above the target wins -- so a tele lens takes over exactly
// where its own zoom factor starts; below every lens the shortest one is used. *out_ratio = the remaining
// CONTROL_ZOOM_RATIO for that lens (target / equiv[lens]). Returns the lens index, or -1 (no candidate / bad input).
#[no_gc]
fn zoom_pick(equiv: u64, n: i32, ref_idx: i32, zoom: f32, out_ratio: u64) -> i32 {
    if n <= 0 || ref_idx < 0 || ref_idx >= n || zoom <= 0.0f { return 0 - 1 }
    let ref_e: f32 = *((equiv + ((ref_idx * 4) as u64)) as *mut f32)
    if ref_e <= 0.0f { return 0 - 1 }
    let target: f32 = ref_e * zoom
    var best: i32 = 0 - 1
    var best_e: f32 = 0.0f
    var short: i32 = 0 - 1
    var short_e: f32 = 0.0f
    var i: i32 = 0
    while i < n {
        let e: f32 = *((equiv + ((i * 4) as u64)) as *mut f32)
        if e > 0.0f {
            if e <= target * 1.05f && e > best_e {
                best = i
                best_e = e
            }
            if short < 0 || e < short_e {
                short = i
                short_e = e
            }
        }
        i = i + 1
    }
    if best < 0 {
        best = short
        best_e = short_e
    }
    if best < 0 { return 0 - 1 }
    *((out_ratio) as *mut f32) = target / best_e
    return best
}

// True when a stop within `pct` percent of x10 is already in list[0..nc).
#[no_gc]
fn stop_has(list: u64, nc: i32, x10: i32, pct: i32) -> bool {
    var i: i32 = 0
    while i < nc {
        let e: i32 = *((list + ((i * 4) as u64)) as *mut i32)
        var d: i32 = x10 - e
        if d < 0 { d = 0 - d }
        if d * 100 <= pct * e { return true }
        i = i + 1
    }
    return false
}

#[no_gc]
fn stop_add(cx: u64, co: u64, cp: u64, nc: i32, x10: i32, opt: i32, prio: i32) -> i32 {
    if nc >= 32 { return nc }
    *((cx + ((nc * 4) as u64)) as *mut i32) = x10
    *((co + ((nc * 4) as u64)) as *mut i32) = opt
    *((cp + ((nc * 4) as u64)) as *mut i32) = prio
    return nc + 1
}

// Zoom preset stops for the chip row (user scale, 1.0 = the main lens `ref_idx`). equiv[0..n) as in zoom_pick;
// cur_idx = the open lens, whose CONTROL_ZOOM_RATIO range is [zmin, zmax]; extra[0..nx) = more 35 mm equivalents of
// the same camera (e.g. the focal length list of a logical camera; pass 0, 0 for none). Writes up to cap (<= 8)
// stops ascending: out_x10[i] = factor x 10, out_opt[i] = 1 when a lens of that factor exists (optical), 0 = a digital
// crop. Lens factors are always stops (a range below 1 counts as the ultra wide lens); the standard stops 1 2 5 3 8
// 10 20 fill the rest as far as the zoom range reaches, unless a lens factor is within 20 % of them. Returns the count.
#[no_gc]
fn zoom_stops(equiv: u64, n: i32, ref_idx: i32, cur_idx: i32, zmin: f32, zmax: f32, extra: u64, nx: i32, out_x10: u64, out_opt: u64, cap: i32) -> i32 {
    if cap < 1 || cap > 8 { return 0 }
    var ref_e: f32 = 0.0f
    if ref_idx >= 0 && ref_idx < n { ref_e = *((equiv + ((ref_idx * 4) as u64)) as *mut f32) }
    var f_cur: f32 = 1.0f
    if ref_e > 0.0f && cur_idx >= 0 && cur_idx < n {
        let ce: f32 = *((equiv + ((cur_idx * 4) as u64)) as *mut f32)
        if ce > 0.0f { f_cur = ce / ref_e }
    }
    var zlo: f32 = zmin
    var zhi: f32 = zmax
    if zlo <= 0.0f { zlo = 1.0f }
    if zhi < zlo { zhi = zlo }
    var lo: f32 = zlo * f_cur
    var hi: f32 = zhi * f_cur
    var cx: [i32; 32] = [0; 32]
    var co: [i32; 32] = [0; 32]
    var cp: [i32; 32] = [0; 32]
    let px: u64 = (&cx[0]) as u64
    let po: u64 = (&co[0]) as u64
    let pp: u64 = (&cp[0]) as u64
    var nc: i32 = 0
    var i: i32 = 0
    // lens factors (the main lens is 1.0 by definition)
    while i < n + nx {
        var e: f32 = 0.0f
        if i < n { e = *((equiv + ((i * 4) as u64)) as *mut f32) } else { e = *((extra + (((i - n) * 4) as u64)) as *mut f32) }
        if e > 0.0f && ref_e > 0.0f {
            let f: f32 = e / ref_e
            let x: i32 = (f * 10.0f + 0.5f) as i32
            if x >= 1 && !stop_has(px, nc, x, 4) { nc = stop_add(px, po, pp, nc, x, 1, 0) }
            if f * zhi > hi { hi = f * zhi }
            if f < lo { lo = f }
        }
        i = i + 1
    }
    // a zoom range below 1 is a wider lens even when it is not listed on its own
    if lo < 0.9f {
        let x: i32 = (lo * 10.0f + 0.5f) as i32
        if x >= 1 && !stop_has(px, nc, x, 10) { nc = stop_add(px, po, pp, nc, x, 1, 0) }
    }
    // standard stops, by priority
    var std: [i32; 7] = [10, 20, 50, 30, 80, 100, 200]
    i = 0
    while i < 7 {
        let x: i32 = std[i as usize]
        if (x as f32) >= lo * 10.0f - 0.5f && (x as f32) <= hi * 10.0f + 0.5f && !stop_has(px, nc, x, 20) {
            nc = stop_add(px, po, pp, nc, x, 0, i + 1)
        }
        i = i + 1
    }
    // take by priority (lens factors first), then sort ascending
    var take: [i32; 32] = [0; 32]
    var got: i32 = 0
    var pr: i32 = 0
    while pr <= 7 && got < cap {
        i = 0
        while i < nc && got < cap {
            if cp[i as usize] == pr { take[i as usize] = 1; got = got + 1 }
            i = i + 1
        }
        pr = pr + 1
    }
    var m: i32 = 0
    while m < got {
        var best: i32 = 0 - 1
        i = 0
        while i < nc {
            if take[i as usize] == 1 && (best < 0 || cx[i as usize] < cx[best as usize]) { best = i }
            i = i + 1
        }
        *((out_x10 + ((m * 4) as u64)) as *mut i32) = cx[best as usize]
        *((out_opt + ((m * 4) as u64)) as *mut i32) = co[best as usize]
        take[best as usize] = 2
        m = m + 1
    }
    return got
}
