import std.rt
import async.loop
import async.ahttp
import plat.hostev
import plat.android.hostbus
import plat.android.hostorigin
import plat.android.ssefeed

export { stream_begin, stream_end }

const SYS_READ: i64 = 0
const SYS_CLOSE: i64 = 3
const SYS_PIPE2: i64 = 293
const PIPE_FLAGS: i64 = 526336
const READ_CHUNK: usize = 4096
const RECONNECT_MS: i64 = 3000
const MAX_STREAM_BYTES: usize = 1099511627776
const NO_TIMER: u64 = 0

static mut G_ACTIVE: bool = false
static mut G_GEN: u64 = 0
static mut G_URL_P: u64 = 0
static mut G_FEED_P: u64 = 0
static mut G_FDS: [i32; 2] = [0 - 1, 0 - 1]
static mut G_WATCH: u64 = 0
static mut G_TIMER: u64 = 0
static mut G_REQ: u64 = 0
static mut G_OPEN: bool = false

fn buf_bytes() -> usize {
    var probe: [rt.Buf; 2] = [rt.buf_new(); 2]
    return ((&probe[1]) as usize) - ((&probe[0]) as usize)
}

fn url_buf() -> *mut rt.Buf {
    if G_URL_P == 0 {
        G_URL_P = rt.heap_alloc(buf_bytes())
        *(G_URL_P as *mut rt.Buf) = rt.buf_new()
    }
    return G_URL_P as *mut rt.Buf
}

fn feed() -> *mut ssefeed.Feed {
    if G_FEED_P == 0 {
        G_FEED_P = rt.heap_alloc(ssefeed.feed_bytes())
        *(G_FEED_P as *mut ssefeed.Feed) = ssefeed.feed_new()
    }
    return G_FEED_P as *mut ssefeed.Feed
}

fn announce(open: bool) {
    if G_OPEN == open { return }
    G_OPEN = open
    var e: hostev.HostEvent = hostev.blank(hostev.WE_STREAM_STATE)
    if open { e.status = 1 as u32 }
    let used: bool = hostbus.bus_emit(&e)
}

fn drain_events() {
    var name: rt.Buf = rt.buf_new()
    var data: rt.Buf = rt.buf_new()
    while ssefeed.feed_take(feed(), &name, &data) {
        var e: hostev.HostEvent = hostev.blank(hostev.WE_STREAM)
        e.q = rt.buf_ptr(&name)
        e.qn = rt.buf_len(&name)
        e.p = rt.buf_ptr(&data)
        e.n = rt.buf_len(&data)
        let used: bool = hostbus.bus_emit(&e)
    }
    rt.buf_free(&name)
    rt.buf_free(&data)
}

fn on_readable(l: *mut loop.Loop, ud: u64, ev: u32) {
    if ud != G_GEN { return }
    var chunk: [u8; 4096] = [0; 4096]
    let n: i64 = syscall(SYS_READ, G_FDS[0] as i64, (&chunk[0]) as i64, READ_CHUNK as i64, 0, 0, 0)
    if n <= 0 { return }
    announce(true)
    ssefeed.feed_push(feed(), (&chunk[0]) as u64, n as usize)
    drain_events()
}

fn on_written(ud: u64, got: u64) -> u32 {
    if ud != G_GEN { return 1 as u32 }
    return 0 as u32
}

fn close_pipe() {
    let l: *mut loop.Loop = hostbus.bus_loop()
    if G_WATCH != 0 && l as u64 != 0 { loop.watch_del(l, G_WATCH) }
    G_WATCH = 0
    if G_FDS[0] >= 0 { let c0: i64 = syscall(SYS_CLOSE, G_FDS[0] as i64, 0, 0, 0, 0, 0) }
    if G_FDS[1] >= 0 { let c1: i64 = syscall(SYS_CLOSE, G_FDS[1] as i64, 0, 0, 0, 0, 0) }
    G_FDS[0] = 0 - 1
    G_FDS[1] = 0 - 1
}

fn on_reconnect(l: *mut loop.Loop, ud: u64) {
    G_TIMER = NO_TIMER
    if ud != G_GEN || !G_ACTIVE { return }
    connect()
}

fn request_done(r: *mut ahttp.Request, ud: u64) {
    if ud != G_GEN { return }
    drain_events()
    close_pipe()
    G_REQ = 0
    announce(false)
    if !G_ACTIVE { return }
    let l: *mut loop.Loop = hostbus.bus_loop()
    if l as u64 != 0 { G_TIMER = loop.timer_after(l, RECONNECT_MS, on_reconnect, G_GEN) }
}

fn connect() {
    let a: *mut ahttp.AClient = hostbus.bus_client()
    let l: *mut loop.Loop = hostbus.bus_loop()
    if a as u64 == 0 || l as u64 == 0 { return }
    if syscall(SYS_PIPE2, (&G_FDS[0]) as i64, PIPE_FLAGS, 0, 0, 0, 0) < 0 { return }
    G_WATCH = loop.watch_add(l, G_FDS[0], loop.EV_READ, on_readable, G_GEN)
    let rq: *mut ahttp.Request = ahttp.aclient_request(a, "GET".p as u64, 3,
        rt.buf_ptr(url_buf()), rt.buf_len(url_buf()), 0, 0, 0, 0, 0, request_done, G_GEN)
    if rq as u64 == 0 {
        close_pipe()
        return
    }
    ahttp.areq_set_max_body(rq, MAX_STREAM_BYTES)
    ahttp.areq_set_sink(rq, G_FDS[1] as i64, on_written, G_GEN)
    G_REQ = rq as u64
}

fn stream_end() {
    G_ACTIVE = false
    G_GEN = G_GEN + (1 as u64)
    let l: *mut loop.Loop = hostbus.bus_loop()
    if G_TIMER != NO_TIMER && l as u64 != 0 { loop.timer_cancel(l, G_TIMER) }
    G_TIMER = NO_TIMER
    if G_REQ != 0 { ahttp.areq_cancel(G_REQ as *mut ahttp.Request) }
    G_REQ = 0
    close_pipe()
    announce(false)
}

fn stream_begin(url: u64, un: usize) {
    stream_end()
    rt.buf_clear(url_buf())
    hostorigin.origin_join(url, un, url_buf())
    ssefeed.feed_free(feed())
    *feed() = ssefeed.feed_new()
    G_ACTIVE = true
    connect()
}
