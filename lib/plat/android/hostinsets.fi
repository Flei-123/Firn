import window.window
import plat.android.hostbus

export { insets }

const INSET_COUNT: usize = 4
const F64_BYTES: usize = 8
const PROMILLE: f64 = 1000.0

fn insets(out: u64) -> bool {
    let w: *mut window.Window = hostbus.bus_window()
    if w as u64 == 0 { return false }
    var raw: [f64; 4] = [0.0; 4]
    if !window.insets(w, &raw) { return false }
    let per_mille: f64 = hostbus.bus_dpr() as f64
    var i: usize = 0
    while i < INSET_COUNT {
        *((out + ((i * F64_BYTES) as u64)) as *mut f64) = raw[i] * PROMILLE / per_mille
        i = i + 1
    }
    return true
}
