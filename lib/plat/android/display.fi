// SPDX-License-Identifier: MPL-2.0
// lib/plat/android/display.fi -- the rotation of the screen (Surface.ROTATION_*), for the camera preview.
//
// A camera preview must be turned by (sensor orientation - display rotation) (back lens) or (+) (front lens):
// gpu.campreview.cp_rotation(sensor, display_deg, front). The display rotation is not a window property here, it
// comes from the system:  activity.getSystemService("window").getDefaultDisplay().getRotation()  (0..3).
// Call it when the window size changes (EV_CONFIGURE), not every frame.
import android.ndk
import android.jnicall
import android.activity

export { display_rotation }

// Degrees the screen content is turned clockwise from the natural orientation: 0, 90, 180 or 270.
// -1: no activity or the JNI call failed (use 0 / the aspect of the window instead).
#[no_gc]
fn display_rotation() -> i32 {
    let act: u64 = activity.activity_pointer()
    if act == 0 { return 0 - 1 }
    let ctx: u64 = ndk.peek64(act + 24)
    let env: u64 = jnicall.j_env(ndk.peek64(act + 8))
    if env == 0 || ctx == 0 { return 0 - 1 }
    let n_get: str = "getSystemService\0"
    let g_get: str = "(Ljava/lang/String;)Ljava/lang/Object;\0"
    let n_win: str = "window\0"
    let n_dd: str = "getDefaultDisplay\0"
    let g_dd: str = "()Landroid/view/Display;\0"
    let n_rot: str = "getRotation\0"
    let g_rot: str = "()I\0"
    let cc: u64 = jnicall.j_obj_class(env, ctx)
    let ws: u64 = jnicall.j_str(env, n_win.p as u64)
    var a: [u64; 2] = [0; 2]
    a[0] = ws
    let wm: u64 = jnicall.j_obj(env, ctx, jnicall.j_method(env, cc, n_get.p as u64, g_get.p as u64), (&a[0]) as u64)
    var rot: i32 = 0 - 1
    if wm != 0 {
        let wc: u64 = jnicall.j_obj_class(env, wm)
        let disp: u64 = jnicall.j_obj(env, wm, jnicall.j_method(env, wc, n_dd.p as u64, g_dd.p as u64), 0)
        if disp != 0 {
            let dc: u64 = jnicall.j_obj_class(env, disp)
            let r: i32 = jnicall.j_int(env, disp, jnicall.j_method(env, dc, n_rot.p as u64, g_rot.p as u64), 0)
            if r >= 0 && r <= 3 { rot = r * 90 }
            jnicall.j_del(env, dc)
            jnicall.j_del(env, disp)
        }
        jnicall.j_del(env, wc)
        jnicall.j_del(env, wm)
    }
    jnicall.j_del(env, ws)
    jnicall.j_del(env, cc)
    return rot
}
