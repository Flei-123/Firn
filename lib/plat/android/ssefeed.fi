// SPDX-License-Identifier: MPL-2.0
import std.rt

export { Feed, feed_bytes, feed_new, feed_free, feed_push, feed_take }

const DEFAULT_EVENT: str = "message"
const FIELD_EVENT: str = "event"
const FIELD_DATA: str = "data"
const BUF_LIMIT: usize = 1048576

struct Feed {
    raw: rt.Buf,
    name: rt.Buf,
    data: rt.Buf,
    has_data: bool,
    ready: bool,
}

fn feed_bytes() -> usize {
    var probe: [Feed; 2] = [feed_new(); 2]
    return ((&probe[1]) as usize) - ((&probe[0]) as usize)
}

fn feed_new() -> Feed {
    return Feed { raw: rt.buf_new(), name: rt.buf_new(), data: rt.buf_new(), has_data: false, ready: false }
}

fn feed_free(f: *mut Feed) {
    rt.buf_free(&(*f).raw)
    rt.buf_free(&(*f).name)
    rt.buf_free(&(*f).data)
}

fn feed_push(f: *mut Feed, p: u64, n: usize) {
    if rt.buf_len(&(*f).raw) + n > BUF_LIMIT {
        rt.buf_clear(&(*f).raw)
        return
    }
    rt.buf_push_bytes(&(*f).raw, p, n)
}

fn field_is(line: u64, n: usize, name: str) -> bool {
    if n < name.n + 1 { return false }
    var i: usize = 0
    while i < name.n {
        if rt.ld8(line, i) != rt.ld8(name.p as u64, i) { return false }
        i = i + 1
    }
    return rt.ld8(line, name.n) == 58 as u8
}

fn value_start(line: u64, n: usize, name: str) -> usize {
    var at: usize = name.n + 1
    if at < n && rt.ld8(line, at) == 32 as u8 { at = at + 1 }
    return at
}

fn take_line(f: *mut Feed, line: u64, n: usize) {
    if n == 0 {
        if (*f).has_data { (*f).ready = true }
        return
    }
    if field_is(line, n, FIELD_EVENT) {
        let at: usize = value_start(line, n, FIELD_EVENT)
        rt.buf_clear(&(*f).name)
        rt.buf_push_bytes(&(*f).name, line + at as u64, n - at)
    } else if field_is(line, n, FIELD_DATA) {
        let at: usize = value_start(line, n, FIELD_DATA)
        if (*f).has_data { rt.buf_push(&(*f).data, 10 as u8) }
        rt.buf_push_bytes(&(*f).data, line + at as u64, n - at)
        (*f).has_data = true
    }
}

fn find_eol(p: u64, n: usize) -> usize {
    var i: usize = 0
    while i < n {
        if rt.ld8(p, i) == 10 as u8 { return i }
        i = i + 1
    }
    return n
}

fn consume(f: *mut Feed, n: usize) {
    let left: usize = rt.buf_len(&(*f).raw) - n
    let base: u64 = rt.buf_ptr(&(*f).raw)
    var i: usize = 0
    while i < left {
        rt.st8(base, i, rt.ld8(base, i + n))
        i = i + 1
    }
    rt.buf_set_len(&(*f).raw, left)
}

fn feed_take(f: *mut Feed, name: *mut rt.Buf, data: *mut rt.Buf) -> bool {
    while !(*f).ready {
        let n: usize = rt.buf_len(&(*f).raw)
        let eol: usize = find_eol(rt.buf_ptr(&(*f).raw), n)
        if eol >= n { return false }
        var ln: usize = eol
        if ln > 0 && rt.ld8(rt.buf_ptr(&(*f).raw), ln - 1) == 13 as u8 { ln = ln - 1 }
        take_line(f, rt.buf_ptr(&(*f).raw), ln)
        consume(f, eol + 1)
    }
    rt.buf_clear(name)
    if rt.buf_len(&(*f).name) == 0 {
        rt.buf_push_bytes(name, DEFAULT_EVENT.p as u64, DEFAULT_EVENT.n)
    } else {
        rt.buf_push_bytes(name, rt.buf_ptr(&(*f).name), rt.buf_len(&(*f).name))
    }
    rt.buf_clear(data)
    rt.buf_push_bytes(data, rt.buf_ptr(&(*f).data), rt.buf_len(&(*f).data))
    rt.buf_clear(&(*f).name)
    rt.buf_clear(&(*f).data)
    (*f).has_data = false
    (*f).ready = false
    return true
}
