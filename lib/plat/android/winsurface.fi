import std.rt
import paint.canvas
import fui.theme
import fui.painter
import fui.face
import window.window
import plat.hostev
import plat.android.hostbus
import plat.android.winstate

export { measure, announce_size }

const MIN_DPR: usize = 250
const DEFAULT_DPR: usize = 1000
const BYTES_PER_PIXEL: usize = 4

fn release_surfaces(x: *mut winstate.Win) {
    if canvas.canvas_ok(&(*x).cv) {
        painter.painter_free(&(*x).z)
        canvas.canvas_free(&(*x).cv)
    }
    if (*x).bgrx_n > 0 {
        rt.heap_free((*x).bgrx, (*x).bgrx_n)
        (*x).bgrx_n = 0
    }
}

fn build_surfaces(x: *mut winstate.Win, w: usize, h: usize) -> bool {
    release_surfaces(x)
    if !canvas.canvas_init(&(*x).cv, w, h) { return false }
    if !painter.painter_init(&(*x).z, &(*x).cv, w, h) { return false }
    face.install(&(*x).z)
    (*x).bgrx = rt.heap_alloc(w * h * BYTES_PER_PIXEL)
    if (*x).bgrx == 0 { return false }
    (*x).bgrx_n = w * h * BYTES_PER_PIXEL
    return true
}

fn measure(x: *mut winstate.Win) -> bool {
    let f: *mut window.Window = &(*x).f
    var r: usize = window.uiscale(f)
    if r < MIN_DPR { r = DEFAULT_DPR }
    let w: usize = window.width(f)
    let h: usize = window.height(f)
    if w == 0 || h == 0 { return false }
    if w != (*x).w || h != (*x).h {
        if !build_surfaces(x, w, h) { return false }
    }
    (*x).dpr = r
    (*x).w = w
    (*x).h = h
    (*x).css_w = (w * 1000 + r / 2) / r
    (*x).css_h = (h * 1000 + r / 2) / r
    theme.theme_set_scale(&(*x).m, r)
    hostbus.bus_set_dpr(r)
    return true
}

fn announce_size(x: *mut winstate.Win) {
    var e: hostev.HostEvent = hostev.blank(hostev.WE_RESIZE)
    e.x = (*x).css_w as f64
    e.y = (*x).css_h as f64
    let used: bool = winstate.deliver(x, &e)
}
