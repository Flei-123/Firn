import fui.tap
import fui.hotreg
import window.pointers
import plat.hostev
import plat.android.hostbus
import plat.android.winstate

export { pointer_event, press_check }

const PRESS_WAKE_SLACK_MS: f64 = 8.0

fn tap_event(x: *mut winstate.Win, pr: *mut pointers.Pointer, base: *mut hostev.HostEvent, t0: f64) {
    var te: hostev.HostEvent = hostev.blank(hostev.WE_TAP)
    te.x = (*base).x
    te.y = (*base).y
    te.pid = (*pr).id
    te.ptype = (*pr).ptype
    te.primary = (*pr).primary
    te.ms = t0
    te.mods = (*base).mods
    let used: bool = winstate.deliver(x, &te)
}

fn pointer_event(x: *mut winstate.Win, pr: *mut pointers.Pointer) {
    var e: hostev.HostEvent = hostev.blank(hostev.WE_MOVE)
    var tapped: bool = false
    let cx: f64 = winstate.css_of(x, (*pr).x)
    let cy: f64 = winstate.css_of(x, (*pr).y)
    let touch: bool = (*pr).ptype == pointers.PTR_TOUCH
    let t0: f64 = winstate.now_ms()
    if (*pr).kind == pointers.PK_DOWN {
        e.kind = hostev.WE_DOWN
        tap.tap_down(&(*x).tap, (*pr).id, (*pr).primary != 0 as u32, touch, cx, cy, t0)
        if touch { hostbus.bus_wake_in(t0, tap.PRESS_DELAY_MS + PRESS_WAKE_SLACK_MS) }
    } else if (*pr).kind == pointers.PK_UP {
        e.kind = hostev.WE_UP
        tapped = tap.tap_up(&(*x).tap, (*pr).id, cx, cy, t0)
    } else if (*pr).kind == pointers.PK_CANCEL {
        e.kind = hostev.WE_UP
        tap.tap_cancel(&(*x).tap)
        let cancelled: bool = hotreg.press_cancel()
    } else if tap.tap_move(&(*x).tap, (*pr).id, cx, cy) && hotreg.press_cancel() {
        (*x).dirty = true
    }
    e.x = cx
    e.y = cy
    e.pid = (*pr).id
    e.ptype = (*pr).ptype
    e.primary = (*pr).primary
    e.ms = t0
    e.pressure = (*pr).pressure
    if touch { e.mods = hostev.MOD_TOUCH }
    let used: bool = winstate.deliver(x, &e)
    if tapped { tap_event(x, pr, &e, t0) }
}

fn press_check(x: *mut winstate.Win, now: f64) {
    if tap.tap_take_press(&(*x).tap, now) {
        let settled: bool = hotreg.press_settle()
        var pe: hostev.HostEvent = hostev.blank(hostev.WE_PRESS)
        pe.x = tap.tap_x0(&(*x).tap)
        pe.y = tap.tap_y0(&(*x).tap)
        pe.mods = hostev.MOD_TOUCH
        pe.ptype = 2 as u32
        let used: bool = winstate.deliver(x, &pe)
    } else if !tap.tap_live(&(*x).tap) {
        let cancelled: bool = hotreg.press_cancel()
    }
}
