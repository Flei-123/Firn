import std.rt
import services.svcosstore
import services.svc

export { store_read, store_write }

const HEX: str = "0123456789abcdef"

fn safe_byte(c: u8) -> bool {
    if c >= 97 as u8 && c <= 122 as u8 { return true }
    if c >= 65 as u8 && c <= 90 as u8 { return true }
    if c >= 48 as u8 && c <= 57 as u8 { return true }
    return c == 95 as u8 || c == 45 as u8 || c == 46 as u8
}

fn file_key(key: u64, kn: usize, out: *mut rt.Buf) {
    var i: usize = 0
    while i < kn {
        let c: u8 = rt.ld8(key, i)
        if safe_byte(c) && !(i == 0 && c == 46 as u8) {
            rt.buf_push(out, c)
        } else {
            rt.buf_push(out, 126 as u8)
            rt.buf_push(out, rt.ld8(HEX.p as u64, (c >> 4) as usize))
            rt.buf_push(out, rt.ld8(HEX.p as u64, (c & 15) as usize))
        }
        i = i + 1
    }
}

fn store_read(key: u64, kn: usize, out: u64, cap: usize) -> usize {
    if key == 0 || kn == 0 || out == 0 { return 0 }
    var fk: rt.Buf = rt.buf_new()
    var data: rt.Buf = rt.buf_new()
    file_key(key, kn, &fk)
    var got: usize = 0
    if svcosstore.os_store_get(rt.buf_str(&fk), &data) == svc.OK {
        got = rt.buf_len(&data)
        if got > cap { got = cap }
        rt.mem_copy(out, rt.buf_ptr(&data), got)
    }
    rt.buf_free(&fk)
    rt.buf_free(&data)
    return got
}

fn store_write(key: u64, kn: usize, v: u64, vn: usize) -> bool {
    if key == 0 || kn == 0 { return false }
    var fk: rt.Buf = rt.buf_new()
    file_key(key, kn, &fk)
    let value: str = str { p: v as *mut u8, n: vn }
    let ok: bool = svcosstore.os_store_set(rt.buf_str(&fk), value) == svc.OK
    rt.buf_free(&fk)
    return ok
}
