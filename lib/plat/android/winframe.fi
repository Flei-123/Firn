import paint.canvas
import fui.theme
import fui.anim
import fui.render
import window.window
import plat.fuiblit
import plat.hostev
import plat.android.hostbus
import plat.android.winstate
import plat.android.winpointer

export { run_frame, wait_input, fade_busy, open_window }

const IDLE_WAIT_MS: i64 = 1000
const FRAME_WAIT_MS: i64 = 8
const START_SIZE: usize = 360

fn fade_busy(w: u64) -> bool {
    let x: *mut winstate.Win = w as *mut winstate.Win
    if (*x).tr == 0 { return false }
    return anim.transreg_dirty((*x).tr as *mut anim.TransReg)
}

fn present(x: *mut winstate.Win) {
    let f: *mut window.Window = &(*x).f
    let direct: bool = window.rgba_native(f)
    let px: u64 = canvas.canvas_pixels(&(*x).cv) as u64
    fuiblit.full_prepare(direct, px, (*x).bgrx, (*x).w * (*x).h)
    let put: bool = fuiblit.full_put(f, direct, px, (*x).bgrx, (*x).w, (*x).h)
    let shown: bool = window.present(f)
}

fn paint_frame(x: *mut winstate.Win, now: f64) {
    render.ctx_set_time(&(*x).c, now as i64)
    if !(*x).keep {
        let colors: *mut theme.Colors = theme.theme_colors(&(*x).m)
        canvas.canvas_clear(&(*x).cv, theme.opaque((*colors).base))
    }
    if (*x).tr != 0 { anim.transreg_new_frame((*x).tr as *mut anim.TransReg) }
    let painted: bool = ((*x).paint)((*x).ud, x as u64)
    if fade_busy(x as u64) { (*x).again = true }
    present(x)
}

fn run_frame(x: *mut winstate.Win) {
    let now: f64 = winstate.now_ms()
    if hostbus.bus_wake_due(now) { (*x).again = true }
    let wanted: bool = !(*x).on_demand || (*x).again || (*x).dirty
    if !wanted { return }
    (*x).again = false
    winpointer.press_check(x, now)
    var te: hostev.HostEvent = hostev.blank(hostev.WE_TICK)
    te.ms = now
    let ticked: bool = winstate.deliver(x, &te)
    if (*x).dirty {
        (*x).dirty = false
        paint_frame(x, now)
    }
    if !(*x).on_demand { (*x).again = true }
}

fn wait_ms(x: *mut winstate.Win) -> i64 {
    if (*x).dirty || (*x).again || !(*x).on_demand { return FRAME_WAIT_MS }
    return hostbus.bus_wait_ms(IDLE_WAIT_MS)
}

fn wait_input(x: *mut winstate.Win) {
    let wins: [u64; 8] = [((&(*x).f) as u64), 0, 0, 0, 0, 0, 0, 0]
    let hit: i64 = window.wait_any_fd(&wins, 1, hostbus.bus_fd(), wait_ms(x))
}

fn open_window(x: *mut winstate.Win) -> bool {
    let f: *mut window.Window = &(*x).f
    if !window.open_window(f, 0) { return false }
    let full: bool = window.full_input(f, true)
    let real: bool = window.real_pointers(f, true)
    if !window.make(f, START_SIZE, START_SIZE) { return false }
    if !window.show_window(f) { return false }
    return true
}
