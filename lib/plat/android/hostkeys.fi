import window.window

export { key_name }

fn key_name(k: u32) -> str {
    if k == window.K_RETURN { return "Enter" }
    if k == window.K_BACK { return "Backspace" }
    if k == window.K_ESCAPE { return "Escape" }
    if k == window.K_TAB { return "Tab" }
    if k == window.K_DELETE { return "Delete" }
    if k == window.K_LEFT { return "ArrowLeft" }
    if k == window.K_RIGHT { return "ArrowRight" }
    if k == window.K_UP { return "ArrowUp" }
    if k == window.K_DOWN { return "ArrowDown" }
    if k == window.K_HOME { return "Home" }
    if k == window.K_END { return "End" }
    if k == window.K_PAGEUP { return "PageUp" }
    if k == window.K_PAGEDOWN { return "PageDown" }
    return ""
}
