import plat.pushio
import plat.android.share

export { save, share_text, notify }

const SAVED_NONE: i32 = 0
const NO_SUBFOLDER: u64 = 0

fn save(name: str, mime: str, p: u64, n: usize) -> bool {
    let name_c: str = name + "\0"
    let mime_c: str = mime + "\0"
    return share.share_save(p, n, name_c.p as u64, mime_c.p as u64, NO_SUBFOLDER) != SAVED_NONE
}

fn share_text(title: str, text: str) -> bool {
    let title_c: str = title + "\0"
    return share.share_send_text(text.p as u64, text.n, title_c.p as u64)
}

fn notify(key: u64, title: str, text: str) -> bool {
    if !pushio.pio_allowed() { return false }
    if key == 0 { return pushio.pio_notify(title, text) }
    return pushio.pio_notify_cid(key, title, text, "")
}
