import std.rt
import window.window
import window.pointers
import plat.hostev
import plat.android.hostbus
import plat.android.hostkeys
import plat.android.winstate
import plat.android.winsurface
import plat.android.winpointer

export { drain_window, utf8_put }

const NOTCH_CSS_PX: f64 = 100.0
const MOD_STATE_SHIFT: u32 = 1
const MOD_STATE_CTRL: u32 = 4
const MOD_STATE_ALT: u32 = 8
const UTF8_BUF: usize = 4
const ONE_BYTE_LIMIT: u32 = 128
const TWO_BYTE_LIMIT: u32 = 2048
const THREE_BYTE_LIMIT: u32 = 65536

fn mods_of(state: u32) -> u32 {
    var m: u32 = 0
    if (state & MOD_STATE_SHIFT) != 0 as u32 { m = m | hostev.MOD_SHIFT }
    if (state & MOD_STATE_CTRL) != 0 as u32 { m = m | hostev.MOD_CTRL }
    if (state & MOD_STATE_ALT) != 0 as u32 { m = m | hostev.MOD_ALT }
    return m
}

fn key_event(x: *mut winstate.Win, code: u32, state: u32) {
    let name: str = hostkeys.key_name(code)
    if name.n == 0 { return }
    var e: hostev.HostEvent = hostev.blank(hostev.WE_KEY)
    e.p = name.p as u64
    e.n = name.n
    e.mods = mods_of(state)
    e.status = 1 as u32
    let used: bool = winstate.deliver(x, &e)
}

fn utf8_put(cp: u32, out: u64) -> usize {
    if cp < ONE_BYTE_LIMIT {
        rt.st8(out, 0, cp as u8)
        return 1
    }
    if cp < TWO_BYTE_LIMIT {
        rt.st8(out, 0, (192 as u32 | (cp >> 6)) as u8)
        rt.st8(out, 1, (128 as u32 | (cp & 63 as u32)) as u8)
        return 2
    }
    if cp < THREE_BYTE_LIMIT {
        rt.st8(out, 0, (224 as u32 | (cp >> 12)) as u8)
        rt.st8(out, 1, (128 as u32 | ((cp >> 6) & 63 as u32)) as u8)
        rt.st8(out, 2, (128 as u32 | (cp & 63 as u32)) as u8)
        return 3
    }
    rt.st8(out, 0, (240 as u32 | (cp >> 18)) as u8)
    rt.st8(out, 1, (128 as u32 | ((cp >> 12) & 63 as u32)) as u8)
    rt.st8(out, 2, (128 as u32 | ((cp >> 6) & 63 as u32)) as u8)
    rt.st8(out, 3, (128 as u32 | (cp & 63 as u32)) as u8)
    return UTF8_BUF
}

fn text_event(x: *mut winstate.Win, cp: u32) {
    var buf: [u8; 4] = [0; 4]
    let n: usize = utf8_put(cp, (&buf[0]) as u64)
    var e: hostev.HostEvent = hostev.blank(hostev.WE_TEXT)
    e.p = (&buf[0]) as u64
    e.n = n
    let used: bool = winstate.deliver(x, &e)
}

fn wheel_event(x: *mut winstate.Win, up: bool, px: u32, py: u32) {
    var e: hostev.HostEvent = hostev.blank(hostev.WE_WHEEL)
    e.x = winstate.css_of(x, px as f64)
    e.y = winstate.css_of(x, py as f64)
    if up { e.dy = 0.0 - NOTCH_CSS_PX } else { e.dy = NOTCH_CSS_PX }
    let used: bool = winstate.deliver(x, &e)
}

fn button_event(x: *mut winstate.Win) {
    let f: *mut window.Window = &(*x).f
    let b: u32 = window.ev_a(f)
    if b == window.BTN_WHEEL_UP || b == window.BTN_WHEEL_DOWN {
        wheel_event(x, b == window.BTN_WHEEL_UP, window.ev_x(f), window.ev_y(f))
    }
}

fn handle_event(x: *mut winstate.Win, kind: u32) {
    let f: *mut window.Window = &(*x).f
    if kind == window.EV_CLOSED {
        (*x).quit = true
    } else if kind == window.EV_CONFIGURE {
        if winsurface.measure(x) { winsurface.announce_size(x) }
        (*x).dirty = true
    } else if kind == window.EV_EXPOSE {
        (*x).dirty = true
    } else if kind == window.EV_THEME {
        hostbus.bus_set_dark(window.dark(f))
        (*x).dirty = true
    } else if kind == window.EV_KEY {
        key_event(x, window.ev_a(f), window.ev_state(f))
    } else if kind == window.EV_CHAR {
        text_event(x, window.ev_a(f))
    } else if kind == window.EV_BUTTON {
        button_event(x)
    }
}

fn drain_window(x: *mut winstate.Win) {
    let f: *mut window.Window = &(*x).f
    var pr: pointers.Pointer = pointers.ptr_blank()
    while window.next_pointer(f, (&pr) as u64) {
        winpointer.pointer_event(x, &pr)
    }
    var k: u32 = window.next_event(f)
    while k != window.EV_NONE && !(*x).quit {
        handle_event(x, k)
        k = window.next_event(f)
    }
}
