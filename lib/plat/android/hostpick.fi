import std.rt
import plat.hostev
import plat.android.hostbus
import plat.android.pick
import plat.android.pickfile

export { pick_begin, KIND_PHOTO, KIND_FILE }

const KIND_PHOTO: u32 = 0
const KIND_FILE: u32 = 1
const PHOTO_CAP: usize = 262144
const META_CAP: usize = 512
const POLL_MS: f64 = 100.0
const POLL_OPEN: i32 = 1
const POLL_READY: i32 = 2
const PHOTO_NAME: str = "photo.jpg"

static mut G_KIND: u32 = 0
static mut G_OPEN: bool = false
static mut G_META: [u8; 512] = [0; 512]

fn emit_dialog(status: u32, name_p: u64, name_n: usize, p: u64, n: usize) {
    var e: hostev.HostEvent = hostev.blank(hostev.WE_DIALOG)
    e.status = status
    e.q = name_p
    e.qn = name_n
    e.p = p
    e.n = n
    let used: bool = hostbus.bus_emit(&e)
}

fn cstr_len(p: u64, cap: usize) -> usize {
    var n: usize = 0
    while n < cap && rt.ld8(p, n) != 0 as u8 { n = n + 1 }
    return n
}

fn take_photo(buf: u64, n: *mut usize) -> bool {
    var w: usize = 0
    var h: usize = 0
    return pick.pick_take(buf, PHOTO_CAP, n, &w, &h)
}

fn take_file(buf: u64, n: *mut usize) -> bool {
    return pick.pick_file_take(buf, pickfile.FILE_MAX, n, (&G_META[0]) as u64, META_CAP)
}

fn deliver_result() {
    var cap: usize = PHOTO_CAP
    if G_KIND == KIND_FILE { cap = pickfile.FILE_MAX }
    let buf: u64 = rt.heap_alloc(cap)
    var n: usize = 0
    var ok: bool = buf != 0
    if ok && G_KIND == KIND_FILE { ok = take_file(buf, &n) }
    if ok && G_KIND != KIND_FILE { ok = take_photo(buf, &n) }
    if !ok {
        emit_dialog(0 as u32, 0 as u64, 0, 0 as u64, 0)
    } else if G_KIND == KIND_FILE {
        emit_dialog(1 as u32, (&G_META[0]) as u64, cstr_len((&G_META[0]) as u64, META_CAP), buf, n)
        emit_dialog(2 as u32, 0 as u64, 0, 0 as u64, 0)
    } else {
        emit_dialog(1 as u32, PHOTO_NAME.p as u64, PHOTO_NAME.n, buf, n)
        emit_dialog(2 as u32, 0 as u64, 0, 0 as u64, 0)
    }
    if buf != 0 { rt.heap_free(buf, cap) }
}

fn pick_turn() {
    if !G_OPEN { return }
    let state: i32 = pick.pick_poll()
    if state == POLL_OPEN {
        hostbus.bus_wake_after(POLL_MS)
        return
    }
    G_OPEN = false
    if state == POLL_READY {
        deliver_result()
    } else {
        emit_dialog(0 as u32, 0 as u64, 0, 0 as u64, 0)
    }
}

fn pick_begin(kind: u32) -> bool {
    if G_OPEN { return false }
    var started: bool = false
    if kind == KIND_FILE { started = pick.pick_file_start() } else { started = pick.pick_start() }
    if !started { return false }
    G_KIND = kind
    G_OPEN = true
    let hooked: bool = hostbus.bus_on_turn(pick_turn)
    hostbus.bus_wake_after(POLL_MS)
    return true
}
