// SPDX-License-Identifier: MPL-2.0
// lib/plat/android/pick.fi -- A PHOTO FROM THE GALLERY OR THE CAMERA, AND
// PICTURES INTO PIXELS -- through Android itself, without a codec of our own.
//
// ================================================================= WHY
//
// A NativeActivity cannot receive the answer of another app: the result of
// startActivityForResult goes to the Java method onActivityResult of the
// activity that asked, and NativeActivity has none for us. So the asking
// is done by a second, invisible activity whose class Firn WRITES into
// classes.dex (tools/android/servicedex_main.fi):
//
//     public class FirnPick extends android.app.Activity {
//         static { System.loadLibrary("<lib>"); }
//         protected void onCreate(Bundle b) { super.onCreate(b); pick(); }
//         public native void pick();
//         public native void onActivityResult(int req, int res, Intent d);
//     }
//
// Both native methods land HERE, on Android's main thread, in the same
// process as the program -- so the answer is simply left in this file's
// statics, and the program's app thread picks it up (pick_poll).
//
//   pick_start()     app thread: opens FirnPick (translucent, no title)
//   FirnPick.pick    main thread: a chooser -- the system's picker for
//                    images, and the camera (it writes its photo into a
//                    fresh MediaStore entry that we made; no permission
//                    needed for that, and none for the picker)
//   onActivityResult main thread: the chosen picture is decoded by
//                    BitmapFactory (down-sampled), turned upright by its
//                    EXIF orientation, scaled to at most SIDE_MAX pixels
//                    and compressed to a JPEG of at most OUT_MAX octets
//                    -- what the page does in the browser before it
//                    sends (webui/firn.js) -- then FirnPick finishes
//   pick_poll()      app thread: nothing / waiting / a JPEG / no picture
//   image_decode()   app thread: JPEG/PNG/WebP octets -> RGBA pixels of a
//                    given size (the thumbnails of a conversation)
//
// Everything is #[no_gc]: the main thread and a foreign thread must never
// meet the collector. Local references are deleted where a thread lives
// long (the app thread); on the main thread they go with the call.
import android.ndk
import android.jnicall
import android.activity

export {
    pick_start, pick_poll, pick_take, image_decode,
    Java_org_firn_FirnPick_pick,
    Java_org_firn_FirnPick_onActivityResult,
}

