// the answer, left here by the main thread for the app thread
const P_IDLE: i32 = 0
const P_WAIT: i32 = 1
const P_READY: i32 = 2
const P_NONE: i32 = 3
const P_FAIL: i32 = 4

static mut G_STATE: i32 = 0
static mut G_BUF: [u8; 196608] = [0; 196608]
