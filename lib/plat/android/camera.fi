const B_STILL_WIN: u64 = 72
const B_STILL_OUT: u64 = 80
const B_STILL_TGT: u64 = 88
const B_PREV_REQ: u64 = 96
const B_STATE: u64 = 104      // i32: 0 closed, 1 open, 2 disconnected, 3 device error
const B_ERRCODE: u64 = 108    // i32
const B_READY: u64 = 112      // i32 session ready callbacks
const B_RES_N: u64 = 120      // u64 results stored so far
const B_FAILS: u64 = 128      // u64 failed captures
const B_KIND: u64 = 136       // i32 current session kind, -1 none
const B_CUR: u64 = 140        // i32 index of the open camera
const B_SCAN_N: u64 = 144     // i32 entries in the table
const B_P_MANUAL: u64 = 148   // i32 1 = manual exposure
const B_P_ISO: u64 = 152      // i32
const B_P_EXP: u64 = 160      // i64
const B_P_FOCUS: u64 = 168    // f32 diopters
const B_P_FOCUS_ON: u64 = 172 // i32 1 = manual focus
const B_P_AELOCK: u64 = 176   // i32
const B_P_AFLOCK: u64 = 180   // i32 (AF continuous -> auto, fixed at the current distance)
const B_S_W: u64 = 184        // i32 still stream size
const B_S_H: u64 = 188
const B_P_W: u64 = 192        // i32 preview size
const B_P_H: u64 = 196
const B_ROT: u64 = 200        // i32 sensor orientation of the open camera
const B_CAPS: u64 = 204       // u32 caps of the open camera
const B_LAST_SLOT: u64 = 208  // i32 slot of the last captured frame's result
const B_PHYS_FN: u64 = 216    // u64 ACaptureSessionPhysicalOutput_create or 0
const B_PHYS_ID: u64 = 224    // 40 octets, physical id to stream from ("" = none)
const B_ID: u64 = 264         // 40 octets, id of the open (logical) camera
const B_SDK: u64 = 304        // i32
const B_AF_CONT: u64 = 308    // i32 1 = AF_MODE continuous picture available
const B_NR_MIN: u64 = 312     // i32 noise reduction MINIMAL available
const B_COMP_STEP: u64 = 316  // f32
const B_REC: u64 = 320        // u64 global ref of the MediaRecorder, 0 = none
const B_REC_WIN: u64 = 328    // u64 ANativeWindow of the recorder surface
const B_REC_OUT: u64 = 336    // u64 ACaptureSessionOutput
const B_REC_TGT: u64 = 344    // u64 ACameraOutputTarget
const B_REC_PFD: u64 = 352    // u64 global ref of the ParcelFileDescriptor
const B_REC_ON: u64 = 360     // i32 1 = recording
const B_CLOSED: u64 = 368     // i32 session onClosed callbacks
const B_FORCE_PHYS: u64 = 376 // 40 octets, test hook: stream from this physical id ("" = off)
const B_FACING: u64 = 416     // i32 lens facing of the open camera + 1 (0 = unknown; 1 front, 2 back, 3 external)
const B_ZOOM: u64 = 424       // f32 current zoom ratio (of the open lens)
const B_ZOOM_MIN: u64 = 428   // f32
const B_ZOOM_MAX: u64 = 432   // f32
const B_ZOOM_MODE: u64 = 436  // i32 1 = CONTROL_ZOOM_RATIO, 2 = SCALER_CROP_REGION (older devices)
const B_ACT_W: u64 = 440      // i32 active array of the OPENED (logical) camera: metering regions use these pixels
const B_ACT_H: u64 = 444
const B_FLASH: u64 = 448      // i32 FLASH_*
const B_MAX_AE: u64 = 452     // i32 AE regions the device accepts
const B_MAX_AF: u64 = 456     // i32 AF regions the device accepts
const B_AF_REG: u64 = 460     // 5 x i32: xmin ymin xmax ymax weight (weight 0 = none)
const B_AE_REG: u64 = 484     // 5 x i32
const B_AF_TAP: u64 = 508     // i32 1 = tap focus active (AF mode AUTO, regions set)
const B_AF_STATE: u64 = 512   // i32 last CONTROL_AF_STATE (-1 unknown)
const B_AE_STATE: u64 = 516   // i32 last CONTROL_AE_STATE (-1 unknown)
const B_FLASH_STATE: u64 = 520 // i32 last FLASH_STATE
const B_FLASH_USE: u64 = 524  // i32 1 = the still being captured may use the flash AE modes
const B_FLASH_PREP: u64 = 528 // i32 1 = preview runs in flash AE mode (precapture before a flash still)
const B_CROP: u64 = 532       // 4 x i32 scratch for SCALER_CROP_REGION
const B_ZOOM_RES: u64 = 548   // f32 zoom ratio the newest capture result reports (0 = none yet)
const B_LAST_URI: u64 = 552   // u64 global ref of the Uri of the newest saved picture (0 = none)
const CB_DEV: u64 = 1024      // ACameraDevice_StateCallbacks (24)
const CB_SESS: u64 = 1056     // ACameraCaptureSession_stateCallbacks (32)
const CB_CAP: u64 = 1096      // ACameraCaptureSession_captureCallbacks (64)
const B_SCRATCH: u64 = 1200   // 512 octets of scratch for entries and out parameters
const RES_BASE: u64 = 2048
const RES_SLOT: u64 = 160
const RES_COUNT: u64 = 16     // slots 2048 .. 4608
const TBL_BASE: u64 = 8192
const TBL_SLOT: u64 = 64      // id[40] @0, parent i32 @40, used by camera_scan
const TBL_MAX: u64 = 64

const YUV_MAX_PIXELS: i64 = 13000000
const PREVIEW_MAX_PIXELS: i64 = 1000000
const VIDEO_MAX_PIXELS: i64 = 2200000

static mut G_P: u64 = 0

#[no_gc]
fn t(i: usize) -> u64 {
    return ((&TXT[0]) as u64) + i as u64
}

#[no_gc]
fn log(i: usize) {
    ndk.log_write(ndk.LOG_INFO, t(S_TAG), t(i))
}

#[no_gc]
fn block() -> u64 {
    if G_P == 0 {
        let r: i64 = syscall(9, 0, B_SIZE as i64, 3, 34, -1, 0)
        if r > 0 {
            G_P = r as u64
        }
    }
    return G_P
}

// A large buffer for frames (anonymous mmap, zeroed by the kernel). 0 = no memory.
#[no_gc]
fn camera_alloc(n: usize) -> u64 {
    let r: i64 = syscall(9, 0, n as i64, 3, 34, -1, 0)
    if r > 0 {
        return r as u64
    }
    return 0
}

#[no_gc]
fn camera_free(p: u64, n: usize) {
    if p != 0 {
        let r: i64 = syscall(11, p as i64, n as i64, 0, 0, 0, 0)
    }
}

#[no_gc]
fn wait_ms(ms: u32) {
    let r: i32 = usleep(ms * 1000)
}

#[no_gc]
fn rd32(p: u64) -> i32 { return *(p as *mut i32) }
#[no_gc]
fn rdu32(p: u64) -> u32 { return *(p as *mut u32) }
#[no_gc]
fn rd64(p: u64) -> i64 { return *(p as *mut i64) }
#[no_gc]
fn rdf(p: u64) -> f32 { return *(p as *mut f32) }
#[no_gc]
fn rdd(p: u64) -> f64 { return *(p as *mut f64) }
#[no_gc]
fn rd8(p: u64) -> u32 { return (*(p as *mut u8)) as u32 }
#[no_gc]
fn wr8(p: u64, v: u32) { *(p as *mut u8) = v as u8 }
#[no_gc]
fn wr32(p: u64, v: i32) { *(p as *mut i32) = v }
#[no_gc]
fn wr64(p: u64, v: i64) { *(p as *mut i64) = v }
#[no_gc]
fn wrf(p: u64, v: f32) { *(p as *mut f32) = v }

#[no_gc]
fn length(p: u64) -> usize {
    var n: usize = 0
    while *((p + n as u64) as *mut u8) != 0 as u8 {
        n = n + 1
    }
    return n
}

#[no_gc]
fn copy(z: u64, q: u64, n: usize) {
    var i: usize = 0
    while i < n {
        *((z + i as u64) as *mut u8) = *((q + i as u64) as *mut u8)
        i = i + 1
    }
}

// copy a zero terminated string of at most cap-1 octets
#[no_gc]
fn copy_str(z: u64, q: u64, cap: usize) {
    var n: usize = length(q)
    if n > cap - 1 {
        n = cap - 1
    }
    copy(z, q, n)
    *((z + n as u64) as *mut u8) = 0 as u8
}

// ---- a metadata entry: tag@0 u32, type@4 u8, count@8 u32, data@16 pointer (24 octets)
#[no_gc]
fn md_get(md: u64, tag: u32, e: u64) -> bool {
    if md == 0 {
        return false
    }
    if ACameraMetadata_getConstEntry(md, tag, e) != 0 {
        return false
    }
    return rdu32(e + 8) > 0 as u32
}

#[no_gc]
fn e_count(e: u64) -> usize { return rdu32(e + 8) as usize }
#[no_gc]
fn e_data(e: u64) -> u64 { return *((e + 16) as *mut u64) }

// first value of an i32 / u8 / f32 / i64 entry, or `dflt`
#[no_gc]
fn md_i32(md: u64, tag: u32, dflt: i32) -> i32 {
    let e: u64 = block() + B_SCRATCH
    if !md_get(md, tag, e) { return dflt }
    return rd32(e_data(e))
}

#[no_gc]
fn md_u8(md: u64, tag: u32, dflt: i32) -> i32 {
    let e: u64 = block() + B_SCRATCH
    if !md_get(md, tag, e) { return dflt }
    return rd8(e_data(e)) as i32
}

#[no_gc]
fn md_f32(md: u64, tag: u32, dflt: f32) -> f32 {
    let e: u64 = block() + B_SCRATCH
    if !md_get(md, tag, e) { return dflt }
    return rdf(e_data(e))
}

#[no_gc]
fn md_has_u8(md: u64, tag: u32, v: i32) -> bool {
    let e: u64 = block() + B_SCRATCH
    if !md_get(md, tag, e) { return false }
    let n: usize = e_count(e)
    let p: u64 = e_data(e)
    var i: usize = 0
    while i < n {
        if rd8(p + i as u64) as i32 == v { return true }
        i = i + 1
    }
    return false
}

#[no_gc]
fn md_has_i32(md: u64, tag: u32, v: i32) -> bool {
    let e: u64 = block() + B_SCRATCH
    if !md_get(md, tag, e) { return false }
    let n: usize = e_count(e)
    let p: u64 = e_data(e)
    var i: usize = 0
    while i < n {
        if rd32(p + (i * 4) as u64) == v { return true }
        i = i + 1
    }
    return false
}

// characteristics of camera id (zero terminated); 0 = failed. Free with ACameraMetadata_free.
#[no_gc]
fn chars_of(id: u64) -> u64 {
    let b: u64 = block()
    if b == 0 { return 0 }
    let mgr: u64 = manager()
    if mgr == 0 { return 0 }
    let out: u64 = b + B_SCRATCH + 64
    wr64(out, 0)
    if ACameraManager_getCameraCharacteristics(mgr, id, out) != 0 {
        return 0
    }
    return *(out as *mut u64)
}

#[no_gc]
fn manager() -> u64 {
    let b: u64 = block()
    if b == 0 { return 0 }
    var m: u64 = *((b + B_MGR) as *mut u64)
    if m == 0 {
        m = ACameraManager_create()
        *((b + B_MGR) as *mut u64) = m
    }
    return m
}

#[no_gc]
fn tbl_id(i: i32) -> u64 {
    return block() + TBL_BASE + (i as u64) * TBL_SLOT
}

// ------------------------------------------------------------ permission
#[no_gc]
fn jni_ctx(ctx_out: *mut u64) -> u64 {
    let act: u64 = activity.activity_pointer()
    if act == 0 {
        return 0
    }
    *ctx_out = ndk.peek64(act + 24)
    return jnicall.j_env(ndk.peek64(act + 8))
}

// 1 granted, 0 not (yet) granted, -1 no activity / JNI.
#[no_gc]
fn camera_permission() -> i32 {
    var ctx: u64 = 0
    let env: u64 = jni_ctx(&ctx)
    if env == 0 { return 0 - 1 }
    let b: u64 = block()
    let act: u64 = activity.activity_pointer()
    wr32(b + B_SDK, ndk.peek32(act + ndk.ACT_SDK_VERSION))
    if ndk.peek32(act + ndk.ACT_SDK_VERSION) < 23 { return 1 }
    let cc: u64 = jnicall.j_obj_class(env, ctx)
    let ps: u64 = jnicall.j_str(env, t(S_PERM_CAMERA))
    var a: [u64; 2] = [0; 2]
    a[0] = ps
    let g: i32 = jnicall.j_int(env, ctx,
        jnicall.j_method(env, cc, t(N_CHECK_PERM), t(G_CHECK_PERM)), (&a[0]) as u64)
    jnicall.j_del(env, ps)
    jnicall.j_del(env, cc)
    if g == 0 { return 1 }
    return 0
}

// Asks the system dialog for the CAMERA permission (asynchronous: poll camera_permission()).
#[no_gc]
fn camera_request_permission() -> bool {
    var ctx: u64 = 0
    let env: u64 = jni_ctx(&ctx)
    if env == 0 { return false }
    let cc: u64 = jnicall.j_obj_class(env, ctx)
    let ps: u64 = jnicall.j_str(env, t(S_PERM_CAMERA))
    let sc: u64 = jnicall.j_class(env, t(C_STRING))
    let arr: u64 = jnicall.j_array1(env, sc, ps)
    var a: [u64; 2] = [0; 2]
    a[0] = arr
    a[1] = 21
    let ok: bool = jnicall.j_void(env, ctx,
        jnicall.j_method(env, cc, t(N_REQ_PERM), t(G_REQ_PERM)), (&a[0]) as u64)
    jnicall.j_del(env, arr)
    jnicall.j_del(env, sc)
    jnicall.j_del(env, ps)
    jnicall.j_del(env, cc)
    return ok
}

// ------------------------------------------------------------ scanning lenses
// Lists the camera ids (logical ones first, then the physical ids a logical camera names that are not
// listed on their own). Returns the number of entries, 0 when there is no camera or no permission.
#[no_gc]
fn camera_scan() -> i32 {
    let b: u64 = block()
    let mgr: u64 = manager()
    if b == 0 || mgr == 0 { return 0 }
    let lp: u64 = b + B_SCRATCH + 128
    wr64(lp, 0)
    if ACameraManager_getCameraIdList(mgr, lp) != 0 { return 0 }
    let list: u64 = *(lp as *mut u64)
    if list == 0 { return 0 }
    var n: i32 = rd32(list)
    let ids: u64 = *((list + 8) as *mut u64)
    var count: i32 = 0
    var i: i32 = 0
    while i < n && (count as u64) < TBL_MAX {
        let id: u64 = *((ids + (i as u64) * 8) as *mut u64)
        copy_str(tbl_id(count), id, 40)
        wr32(tbl_id(count) + 40, 0 - 1)
        count = count + 1
        i = i + 1
    }
    // physical ids of logical multi cameras
    let logical: i32 = count
    i = 0
    while i < logical {
        let md: u64 = chars_of(tbl_id(i))
        if md != 0 {
            let e: u64 = b + B_SCRATCH
            if md_get(md, T_PHYSICAL_IDS, e) {
                let total: usize = e_count(e)
                let p: u64 = e_data(e)
                var at: usize = 0
                while at < total {
                    let pid: u64 = p + at as u64
                    let plen: usize = length(pid)
                    if plen == 0 { break }
                    var known: bool = false
                    var k: i32 = 0
                    while k < count {
                        if same(tbl_id(k), pid) { known = true }
                        k = k + 1
                    }
                    if !known && (count as u64) < TBL_MAX {
                        copy_str(tbl_id(count), pid, 40)
                        wr32(tbl_id(count) + 40, i)
                        count = count + 1
                    }
                    at = at + plen + 1
                }
            }
            ACameraMetadata_free(md)
        }
        i = i + 1
    }
    ACameraManager_deleteCameraIdList(list)
    wr32(b + B_SCAN_N, count)
    return count
}

#[no_gc]
fn same(a: u64, b: u64) -> bool {
    var i: usize = 0
    while true {
        let x: u32 = rd8(a + i as u64)
        let y: u32 = rd8(b + i as u64)
        if x != y { return false }
        if x == 0 as u32 { return true }
        i = i + 1
    }
    return true
}

// Largest output size of `format` whose pixel count is <= max_px (0 = no limit). prefer_aspect > 0:
// among the sizes of that aspect (+-3 %) first. Writes w, h (0 when none).
#[no_gc]
fn best_size(md: u64, format: i32, max_px: i64, aspect: f32, ow: *mut i32, oh: *mut i32) {
    *ow = 0
    *oh = 0
    let e: u64 = block() + B_SCRATCH
    if !md_get(md, T_SCALER_STREAM_CONFIGS, e) { return }
    let n: usize = e_count(e) / 4
    let p: u64 = e_data(e)
    var best: i64 = 0
    var best_match: bool = false
    var i: usize = 0
    while i < n {
        let q: u64 = p + (i * 16) as u64
        let f: i32 = rd32(q)
        let w: i32 = rd32(q + 4)
        let h: i32 = rd32(q + 8)
        let is_in: i32 = rd32(q + 12)
        if f == format && is_in == 0 && w > 0 && h > 0 {
            let px: i64 = (w as i64) * (h as i64)
            if max_px == 0 || px <= max_px {
                var fits: bool = true
                if aspect > 0.0f {
                    var ar: f32 = (w as f32) / (h as f32)
                    var d: f32 = ar / aspect
                    if d < 1.0f { d = 1.0f / d }
                    fits = d < 1.03f
                }
                var better: bool = false
                if fits && !best_match { better = true }
                if fits == best_match && px > best { better = true }
                if better {
                    best = px
                    best_match = fits
                    *ow = w
                    *oh = h
                }
            }
        }
        i = i + 1
    }
}

#[no_gc]
fn str_set(dst: u64, src: u64, cap: usize) {
    copy_str(dst, src, cap)
}

// Fills everything the characteristics tell about entry `index`. False when the id cannot be read.
#[no_gc]
fn camera_info(index: i32, c: *mut CamInfo) -> bool {
    let b: u64 = block()
    if b == 0 || index < 0 || index >= rd32(b + B_SCAN_N) { return false }
    let id: u64 = tbl_id(index)
    let md: u64 = chars_of(id)
    if md == 0 { return false }
    let e: u64 = b + B_SCRATCH
    (*c).index = index
    (*c).parent = rd32(id + 40)
    str_set((&(*c).id[0]) as u64, id, 40)
    (*c).facing = md_u8(md, T_LENS_FACING, 1)
    (*c).orientation = md_i32(md, T_SENSOR_ORIENTATION, 0)
    (*c).hw_level = md_u8(md, T_INFO_HW_LEVEL, 2)
    var caps: u32 = 0
    if md_has_u8(md, T_REQUEST_CAPS, 3) { caps = caps | CAP_RAW }
    if md_has_u8(md, T_REQUEST_CAPS, 1) { caps = caps | CAP_MANUAL_SENSOR }
    if md_has_u8(md, T_REQUEST_CAPS, 6) { caps = caps | CAP_BURST }
    if md_has_u8(md, T_REQUEST_CAPS, 11) { caps = caps | CAP_LOGICAL }
    if md_has_u8(md, T_REQUEST_CAPS, 2) { caps = caps | CAP_MANUAL_POST }
    if md_has_u8(md, T_REQUEST_CAPS, 5) { caps = caps | CAP_READ_SETTINGS }
    (*c).focal_count = 0
    (*c).focal_mm = 0.0f
    if md_get(md, T_LENS_INFO_FOCAL_LENGTHS, e) {
        (*c).focal_mm = rdf(e_data(e))
        (*c).focal_count = e_count(e) as i32
    }
    (*c).aperture = 0.0f
    if md_get(md, T_LENS_INFO_APERTURES, e) {
        (*c).aperture = rdf(e_data(e))
    }
    (*c).sensor_w_mm = 0.0f
    (*c).sensor_h_mm = 0.0f
    if md_get(md, T_SENSOR_INFO_PHYS_SIZE, e) {
        (*c).sensor_w_mm = rdf(e_data(e))
        (*c).sensor_h_mm = rdf(e_data(e) + 4)
    }
    (*c).equiv_mm = 0.0f
    if (*c).sensor_w_mm > 0.0f && (*c).focal_mm > 0.0f {
        let diag: f32 = sqrt_f((*c).sensor_w_mm * (*c).sensor_w_mm + (*c).sensor_h_mm * (*c).sensor_h_mm)
        if diag > 0.0f {
            (*c).equiv_mm = (*c).focal_mm * 43.27f / diag
        }
    }
    (*c).active_w = 0
    (*c).active_h = 0
    if md_get(md, T_SENSOR_INFO_ACTIVE, e) {
        (*c).active_w = rd32(e_data(e) + 8)
        (*c).active_h = rd32(e_data(e) + 12)
    }
    (*c).iso_min = 0
    (*c).iso_max = 0
    if md_get(md, T_SENSOR_INFO_ISO_RANGE, e) {
        (*c).iso_min = rd32(e_data(e))
        (*c).iso_max = rd32(e_data(e) + 4)
    }
    (*c).exp_min_ns = 0
    (*c).exp_max_ns = 0
    if md_get(md, T_SENSOR_INFO_EXP_RANGE, e) {
        (*c).exp_min_ns = rd64(e_data(e))
        (*c).exp_max_ns = rd64(e_data(e) + 8)
    }
    (*c).min_focus_d = md_f32(md, T_LENS_INFO_MIN_FOCUS, 0.0f)
    (*c).hyperfocal_d = md_f32(md, T_LENS_INFO_HYPERFOCAL, 0.0f)
    (*c).focus_calib = md_u8(md, T_LENS_INFO_FOCUS_CALIB, 0)
    if (*c).min_focus_d > 0.0f { caps = caps | CAP_MANUAL_FOCUS }
    (*c).stabilisation = 0
    if md_has_u8(md, T_LENS_INFO_OIS, 1) {
        (*c).stabilisation = 1
        caps = caps | CAP_OIS
    }
    if md_u8(md, T_FLASH_INFO_AVAILABLE, 0) != 0 { caps = caps | CAP_FLASH }
    (*c).caps = caps
    (*c).has_af = md_has_u8(md, T_CONTROL_AF_AVAILABLE, 4) || md_has_u8(md, T_CONTROL_AF_AVAILABLE, 1)
    (*c).ae_comp_min = 0
    (*c).ae_comp_max = 0
    if md_get(md, T_CONTROL_AE_COMP_RANGE, e) {
        (*c).ae_comp_min = rd32(e_data(e))
        (*c).ae_comp_max = rd32(e_data(e) + 4)
    }
    (*c).ae_comp_step = 0.0f
    if md_get(md, T_CONTROL_AE_COMP_STEP, e) {
        (*c).ae_comp_step = (rd32(e_data(e)) as f32) / (rd32(e_data(e) + 4) as f32)
    }
    var w: i32 = 0
    var h: i32 = 0
    best_size(md, 256, 0, 0.0f, &w, &h)
    (*c).jpeg_w = w
    (*c).jpeg_h = h
    best_size(md, 32, 0, 0.0f, &w, &h)
    (*c).raw_w = w
    (*c).raw_h = h
    var asp: f32 = 0.0f
    if (*c).jpeg_h > 0 { asp = ((*c).jpeg_w as f32) / ((*c).jpeg_h as f32) }
    best_size(md, 35, YUV_MAX_PIXELS, asp, &w, &h)
    (*c).yuv_w = w
    (*c).yuv_h = h
    best_size(md, 35, PREVIEW_MAX_PIXELS, asp, &w, &h)
    (*c).prev_w = w
    (*c).prev_h = h
    best_size(md, 34, VIDEO_MAX_PIXELS, 1.7778f, &w, &h)
    (*c).vid_w = w
    (*c).vid_h = h
    ACameraMetadata_free(md)
    return true
}

// Square root by Newton steps (no libm needed in #[no_gc] code).
#[no_gc]
fn sqrt_f(x: f32) -> f32 {
    if x <= 0.0f { return 0.0f }
    var g: f32 = x
    if g < 1.0f { g = 1.0f }
    var i: i32 = 0
    while i < 24 {
        g = 0.5f * (g + x / g)
        i = i + 1
    }
    return g
}

// The best capture path this lens supports: RAW_SENSOR -> YUV burst -> single JPEG.
#[no_gc]
fn camera_best_kind(c: *mut CamInfo) -> i32 {
    if ((*c).caps & CAP_RAW) != 0 as u32 && (*c).raw_w > 0 { return KIND_RAW }
    if (*c).yuv_w > 0 && (((*c).caps & CAP_BURST) != 0 as u32 || (*c).hw_level != 2) { return KIND_YUV }
    return KIND_JPEG
}

#[no_gc]
fn camera_error_text(code: i32) -> u64 {
    if code == E_OK { return t(X_OK) }
    if code == E_PERMISSION { return t(X_PERMISSION) }
    if code == E_NO_CAMERA { return t(X_NO_CAMERA) }
    if code == E_OPEN { return t(X_OPEN) }
    if code == E_SESSION { return t(X_SESSION) }
    if code == E_STREAM { return t(X_STREAM) }
    if code == E_TIMEOUT { return t(X_TIMEOUT) }
    if code == E_UNSUPPORTED { return t(X_UNSUPPORTED) }
    if code == E_SPACE { return t(X_SPACE) }
    return t(X_STATE)
}

// ------------------------------------------------------------ callbacks (HAL threads: raw memory only)
struct HolderQ { f: fn(u64, u64, u64, u64) }

#[no_gc]
fn code_of_q(f: fn(u64, u64, u64, u64)) -> u64 {
    var roh: [u64; 1] = [0; 1]
    let h: *mut HolderQ = (&roh[0]) as *mut HolderQ
    (*h).f = f
    return ndk.peek64(roh[0])
}

#[no_gc]
fn cb_noop(a: u64, b: u64, c: u64, d: u64) {
}

#[no_gc]
fn cb_disconnected(ctx: u64, dev: u64, c: u64, d: u64) {
    wr32(G_P + B_STATE, 2)
}

#[no_gc]
fn cb_error(ctx: u64, dev: u64, err: u64, d: u64) {
    wr32(G_P + B_STATE, 3)
    wr32(G_P + B_ERRCODE, (err & 4294967295) as i32)
}

#[no_gc]
fn cb_closed(ctx: u64, sess: u64, c: u64, d: u64) {
    wr32(G_P + B_CLOSED, rd32(G_P + B_CLOSED) + 1)
}

#[no_gc]
fn cb_ready(ctx: u64, sess: u64, c: u64, d: u64) {
    wr32(G_P + B_READY, rd32(G_P + B_READY) + 1)
}

#[no_gc]
fn cb_failed(ctx: u64, sess: u64, req: u64, fail: u64) {
    *((G_P + B_FAILS) as *mut u64) = *((G_P + B_FAILS) as *mut u64) + 1
}

// A result: copy what a frame needs into the next ring slot. The slot's timestamp is written LAST,
// so a reader that finds a timestamp finds a complete slot.
#[no_gc]
fn cb_completed(ctx: u64, sess: u64, req: u64, md: u64) {
    let b: u64 = G_P
    if b == 0 || md == 0 { return }
    let n: u64 = *((b + B_RES_N) as *mut u64)
    let s: u64 = b + RES_BASE + (n % RES_COUNT) * RES_SLOT
    let e: u64 = b + B_SCRATCH + 256
    wr64(s, 0)
    var flags: u32 = 0
    if md_get(md, T_CONTROL_AF_STATE, e) { wr32(b + B_AF_STATE, rd8(e_data(e)) as i32) }
    if md_get(md, T_CONTROL_AE_STATE, e) { wr32(b + B_AE_STATE, rd8(e_data(e)) as i32) }
    if md_get(md, T_CONTROL_ZOOM_RATIO, e) { wrf(b + B_ZOOM_RES, rdf(e_data(e))) }
    if md_get(md, T_FLASH_STATE, e) { wr32(b + B_FLASH_STATE, rd8(e_data(e)) as i32) }
    wr64(s + 8, 0)
    if md_get(md, T_SENSOR_EXPOSURE_TIME, e) { wr64(s + 8, rd64(e_data(e))) ; flags = flags | 1 as u32 }
    wr32(s + 16, 0)
    if md_get(md, T_SENSOR_SENSITIVITY, e) { wr32(s + 16, rd32(e_data(e))) ; flags = flags | 2 as u32 }
    wr32(s + 20, 0 - 1)
    if md_get(md, T_LENS_STATE, e) { wr32(s + 20, rd8(e_data(e)) as i32) }
    wrf(s + 24, 0.0f - 1.0f)
    if md_get(md, T_LENS_FOCUS_DISTANCE, e) { wrf(s + 24, rdf(e_data(e))) ; flags = flags | 4 as u32 }
    wrf(s + 28, 0.0f)
    if md_get(md, T_LENS_FOCAL_LENGTH, e) { wrf(s + 28, rdf(e_data(e))) }
    wrf(s + 32, 0.0f)
    if md_get(md, T_LENS_APERTURE, e) { wrf(s + 32, rdf(e_data(e))) }
    var i: usize = 0
    if md_get(md, T_COLOR_GAINS, e) && e_count(e) >= 4 {
        while i < 4 {
            wrf(s + 40 + (i * 4) as u64, rdf(e_data(e) + (i * 4) as u64))
            i = i + 1
        }
        flags = flags | 8 as u32
    }
    if md_get(md, T_SENSOR_NEUTRAL, e) && e_count(e) >= 3 {
        i = 0
        while i < 3 {
            let num: i32 = rd32(e_data(e) + (i * 8) as u64)
            let den: i32 = rd32(e_data(e) + (i * 8) as u64 + 4)
            var v: f32 = 1.0f
            if den != 0 { v = (num as f32) / (den as f32) }
            wrf(s + 56 + (i * 4) as u64, v)
            i = i + 1
        }
        flags = flags | 16 as u32
    }
    if md_get(md, T_SENSOR_NOISE_PROFILE, e) && e_count(e) >= 2 {
        let cnt: usize = e_count(e)
        i = 0
        while i < 8 {
            var src: usize = i
            if src >= cnt { src = i % 2 }
            *((s + 72 + (i * 8) as u64) as *mut f64) = rdd(e_data(e) + (src * 8) as u64)
            i = i + 1
        }
        flags = flags | 32 as u32
    }
    *((s + 36) as *mut u32) = flags
    var ts: i64 = 1
    if md_get(md, T_SENSOR_TIMESTAMP, e) { ts = rd64(e_data(e)) }
    wr64(s, ts)
    *((b + B_RES_N) as *mut u64) = n + 1
}

// ------------------------------------------------------------ open / close
#[no_gc]
fn camera_is_open() -> bool {
    let b: u64 = block()
    return b != 0 && rd32(b + B_STATE) == 1 && *((b + B_DEV) as *mut u64) != 0
}

#[no_gc]
fn camera_kind() -> i32 {
    return rd32(block() + B_KIND)
}

// Test hook: the next camera_open streams from physical id `pid` (NUL-terminated) of the opened camera, as if
// that lens were a physical id of a multi camera. 0 clears it. Lets an emulator without a multi camera run the
// physical-output code path (the session is then refused by the camera service, which must not crash).
#[no_gc]
fn camera_force_physical(pid: u64) {
    let b: u64 = block()
    if b == 0 { return }
    wr8(b + B_FORCE_PHYS, 0 as u32)
    if pid != 0 { copy_str(b + B_FORCE_PHYS, pid, 40) }
}

// Opens lens `index` of the last camera_scan (a physical id opens its logical camera and streams from
// that physical camera where the device allows it). Returns E_OK or an E_* code.
#[no_gc]
fn camera_open(index: i32) -> i32 {
    let b: u64 = block()
    let mgr: u64 = manager()
    if b == 0 || mgr == 0 { return E_STATE }
    if index < 0 || index >= rd32(b + B_SCAN_N) { return E_NO_CAMERA }
    if camera_permission() == 0 { return E_PERMISSION }
    camera_close()
    var open_id: u64 = tbl_id(index)
    wr8(b + B_PHYS_ID, 0 as u32)
    wr64(b + B_PHYS_FN, 0)
    let parent: i32 = rd32(open_id + 40)
    var phys_src: u64 = 0
    if parent >= 0 {
        phys_src = open_id
    } else if rd8(b + B_FORCE_PHYS) != 0 as u32 {
        phys_src = b + B_FORCE_PHYS
    }
    if phys_src != 0 {
        // a physical id: open the logical camera, stream from this one
        copy_str(b + B_PHYS_ID, phys_src, 40)
        if parent >= 0 { open_id = tbl_id(parent) }
        let h: u64 = dlopen(t(S_LIBCAM), 2)
        if h != 0 {
            wr64(b + B_PHYS_FN, dlsym(h, t(S_PHYS_FN)) as i64)
        }
        if rd64(b + B_PHYS_FN) == 0 {
            return E_UNSUPPORTED
        }
    }
    copy_str(b + B_ID, open_id, 40)
    // callbacks
    *((b + CB_DEV) as *mut u64) = 0
    *((b + CB_DEV + 8) as *mut u64) = code_of_q(cb_disconnected)
    *((b + CB_DEV + 16) as *mut u64) = code_of_q(cb_error)
    wr32(b + B_STATE, 0)
    wr32(b + B_ERRCODE, 0)
    let dp: u64 = b + B_SCRATCH + 192
    wr64(dp, 0)
    let st: i32 = ACameraManager_openCamera(mgr, open_id, b + CB_DEV, dp)
    if st != 0 || *(dp as *mut u64) == 0 {
        ndk.log_write(ndk.LOG_WARN, t(S_TAG), t(L_OPEN_FAILED))
        return E_OPEN
    }
    *((b + B_DEV) as *mut u64) = *(dp as *mut u64)
    wr32(b + B_STATE, 1)
    wr32(b + B_CUR, index)
    wr32(b + B_KIND, 0 - 1)
    var ci: CamInfo = zero_info()
    if camera_info(index, &ci) {
        wr32(b + B_ROT, ci.orientation)
        wr32(b + B_FACING, ci.facing + 1)
        *((b + B_CAPS) as *mut u32) = ci.caps
        wr32(b + B_S_W, 0)
        wr32(b + B_P_W, ci.prev_w)
        wr32(b + B_P_H, ci.prev_h)
    }
    let md: u64 = chars_of(open_id)
    reset_controls(b, md)
    if md != 0 {
        wr32(b + B_AF_CONT, if_i(md_has_u8(md, T_CONTROL_AF_AVAILABLE, 4)))
        wr32(b + B_NR_MIN, if_i(md_has_u8(md, T_NR_AVAILABLE, 3)))
        ACameraMetadata_free(md)
    }
    ndk.log_write(ndk.LOG_INFO, t(S_TAG), t(L_OPENED))
    return E_OK
}

#[no_gc]
fn if_i(v: bool) -> i32 {
    if v { return 1 }
    return 0
}

#[no_gc]
fn zero_info() -> CamInfo {
    return CamInfo {
        index: 0, parent: 0 - 1, id: [0 as u8; 40], facing: 0, orientation: 0, hw_level: 0, caps: 0 as u32,
        focal_mm: 0.0f, focal_count: 0, equiv_mm: 0.0f, aperture: 0.0f, sensor_w_mm: 0.0f, sensor_h_mm: 0.0f,
        active_w: 0, active_h: 0, iso_min: 0, iso_max: 0, exp_min_ns: 0, exp_max_ns: 0,
        min_focus_d: 0.0f, hyperfocal_d: 0.0f, focus_calib: 0, jpeg_w: 0, jpeg_h: 0, raw_w: 0, raw_h: 0,
        yuv_w: 0, yuv_h: 0, prev_w: 0, prev_h: 0, stabilisation: 0, has_af: false,
        ae_comp_min: 0, ae_comp_max: 0, ae_comp_step: 0.0f, vid_w: 0, vid_h: 0,
    }
}

#[no_gc]
fn free_reader(b: u64, rd: u64, win: u64, out: u64, tgt: u64) {
    let o: u64 = *((b + out) as *mut u64)
    let t2: u64 = *((b + tgt) as *mut u64)
    if t2 != 0 { ACameraOutputTarget_free(t2) }
    if o != 0 { ACaptureSessionOutput_free(o) }
    let r: u64 = *((b + rd) as *mut u64)
    if r != 0 { AImageReader_delete(r) }
    *((b + rd) as *mut u64) = 0
    *((b + win) as *mut u64) = 0
    *((b + out) as *mut u64) = 0
    *((b + tgt) as *mut u64) = 0
}

#[no_gc]
fn close_session() {
    let b: u64 = block()
    if b == 0 { return }
    let s: u64 = *((b + B_SESS) as *mut u64)
    if s != 0 {
        let r1: i32 = ACameraCaptureSession_stopRepeating(s)
        let r2: i32 = ACameraCaptureSession_abortCaptures(s)
        wr32(b + B_CLOSED, 0)
        ACameraCaptureSession_close(s)
        *((b + B_SESS) as *mut u64) = 0
        // buffers go back to the readers only after onClosed: wait for it (up to 1 s) before freeing them
        var waited: i32 = 0
        while rd32(b + B_CLOSED) == 0 && waited < 100 {
            wait_ms(10)
            waited = waited + 1
        }
        wait_ms(20)
    }
    let rq: u64 = *((b + B_PREV_REQ) as *mut u64)
    if rq != 0 {
        ACaptureRequest_free(rq)
        *((b + B_PREV_REQ) as *mut u64) = 0
    }
    let c: u64 = *((b + B_CONT) as *mut u64)
    if c != 0 {
        ACaptureSessionOutputContainer_free(c)
        *((b + B_CONT) as *mut u64) = 0
    }
    rec_free(b)
    free_reader(b, B_PREV_RD, B_PREV_WIN, B_PREV_OUT, B_PREV_TGT)
    free_reader(b, B_STILL_RD, B_STILL_WIN, B_STILL_OUT, B_STILL_TGT)
    wr32(b + B_KIND, 0 - 1)
}

#[no_gc]
fn camera_close() {
    let b: u64 = block()
    if b == 0 { return }
    close_session()
    let d: u64 = *((b + B_DEV) as *mut u64)
    if d != 0 {
        let r: i32 = ACameraDevice_close(d)
        *((b + B_DEV) as *mut u64) = 0
    }
    wr32(b + B_STATE, 0)
}

// ------------------------------------------------------------ requests
#[no_gc]
fn set_u8(req: u64, tag: u32, v: i32) {
    let p: u64 = G_P + B_SCRATCH + 320
    wr8(p, v as u32)
    let r: i32 = ACaptureRequest_setEntry_u8(req, tag, 1 as u32, p)
}

#[no_gc]
fn set_i32(req: u64, tag: u32, v: i32) {
    let p: u64 = G_P + B_SCRATCH + 328
    wr32(p, v)
    let r: i32 = ACaptureRequest_setEntry_i32(req, tag, 1 as u32, p)
}

#[no_gc]
fn set_i64(req: u64, tag: u32, v: i64) {
    let p: u64 = G_P + B_SCRATCH + 336
    wr64(p, v)
    let r: i32 = ACaptureRequest_setEntry_i64(req, tag, 1 as u32, p)
}

#[no_gc]
fn set_f32(req: u64, tag: u32, v: f32) {
    let p: u64 = G_P + B_SCRATCH + 344
    wrf(p, v)
    let r: i32 = ACaptureRequest_setEntry_float(req, tag, 1 as u32, p)
}

// Zoom, flash and metering regions of the current state (shared by preview and stills).
#[no_gc]
fn fill_controls(req: u64, ae_auto: bool) {
    let b: u64 = G_P
    // zoom
    let z: f32 = rdf(b + B_ZOOM)
    if rd32(b + B_ZOOM_MODE) == 1 {
        set_f32(req, T_CONTROL_ZOOM_RATIO, z)
    } else if rd32(b + B_ZOOM_MODE) == 2 && z > 1.0f {
        focusplan.zoom_crop(z, rd32(b + B_ACT_W), rd32(b + B_ACT_H), b + B_CROP)
        let r: i32 = ACaptureRequest_setEntry_i32(req, T_SCALER_CROP_REGION, 4 as u32, b + B_CROP)
    }
    // flash
    if (*((b + B_CAPS) as *mut u32) & CAP_FLASH) != 0 as u32 {
        if rd32(b + B_FLASH) == FLASH_TORCH {
            set_u8(req, T_FLASH_MODE, 2)
        } else {
            set_u8(req, T_FLASH_MODE, 0)
        }
    }
    // metering regions from a tap
    if rd32(b + B_AF_TAP) == 1 && rd32(b + B_MAX_AF) > 0 && rd32(b + B_AF_REG + 16) > 0 {
        let r2: i32 = ACaptureRequest_setEntry_i32(req, T_CONTROL_AF_REGIONS, 5 as u32, b + B_AF_REG)
    }
    if ae_auto && rd32(b + B_MAX_AE) > 0 && rd32(b + B_AE_REG + 16) > 0 {
        let r3: i32 = ACaptureRequest_setEntry_i32(req, T_CONTROL_AE_REGIONS, 5 as u32, b + B_AE_REG)
    }
}

// 3A and manual settings (current parameters, overridden by exp/iso/focus >= 0 when given).
#[no_gc]
fn fill_request(req: u64, still: bool, exp_ns: i64, iso: i32, focus: f32) {
    let b: u64 = G_P
    set_u8(req, T_CONTROL_MODE, 1)
    var manual: bool = rd32(b + B_P_MANUAL) == 1
    var e: i64 = rd64(b + B_P_EXP)
    var s: i32 = rd32(b + B_P_ISO)
    if exp_ns > 0 {
        manual = true
        e = exp_ns
    }
    if iso > 0 { s = iso }
    var ae_auto: bool = true
    if manual && (*((b + B_CAPS) as *mut u32) & CAP_MANUAL_SENSOR) != 0 as u32 && e > 0 && s > 0 {
        ae_auto = false
        set_u8(req, T_CONTROL_AE_MODE, 0)
        set_i64(req, T_SENSOR_EXPOSURE_TIME, e)
        set_i32(req, T_SENSOR_SENSITIVITY, s)
        if e > 33000000 {
            set_i64(req, T_SENSOR_FRAME_DURATION, e)
        }
    } else {
        // flash AE modes: only for a single still (or the precapture run before it); never for bursts / video
        var ae: i32 = 1
        let fl: i32 = rd32(b + B_FLASH)
        var use_flash: bool = false
        if (*((b + B_CAPS) as *mut u32) & CAP_FLASH) != 0 as u32 {
            if still && rd32(b + B_FLASH_USE) == 1 { use_flash = true }
            if !still && rd32(b + B_FLASH_PREP) == 1 { use_flash = true }
        }
        if use_flash && fl == FLASH_AUTO { ae = 2 }
        if use_flash && fl == FLASH_ON { ae = 3 }
        set_u8(req, T_CONTROL_AE_MODE, ae)
        set_u8(req, T_CONTROL_AE_LOCK, if_i(rd32(b + B_P_AELOCK) == 1))
    }
    set_u8(req, T_CONTROL_AWB_MODE, 1)
    var fd: f32 = focus
    var fon: bool = focus >= 0.0f
    if !fon && rd32(b + B_P_FOCUS_ON) == 1 {
        fon = true
        fd = rdf(b + B_P_FOCUS)
    }
    if fon && (*((b + B_CAPS) as *mut u32) & CAP_MANUAL_FOCUS) != 0 as u32 {
        set_u8(req, T_CONTROL_AF_MODE, 0)
        set_f32(req, T_LENS_FOCUS_DISTANCE, fd)
    } else if rd32(b + B_AF_TAP) == 1 {
        set_u8(req, T_CONTROL_AF_MODE, 1)
    } else if rd32(b + B_AF_CONT) == 1 && rd32(b + B_P_AFLOCK) == 0 {
        set_u8(req, T_CONTROL_AF_MODE, 4)
    } else {
        set_u8(req, T_CONTROL_AF_MODE, 1)
    }
    fill_controls(req, ae_auto)
    if still {
        set_i32(req, T_JPEG_ORIENTATION, rd32(b + B_ROT))
        set_u8(req, T_JPEG_QUALITY, 97)
    }
    if still && rd32(b + B_KIND) == KIND_YUV && rd32(b + B_NR_MIN) == 1 {
        set_u8(req, T_NR_MODE, 3)
    }
}

// (Re)starts the repeating preview with the current parameters (focus < 0 = current setting).
#[no_gc]
fn restart_preview(focus: f32) -> i32 {
    let b: u64 = G_P
    let s: u64 = *((b + B_SESS) as *mut u64)
    let d: u64 = *((b + B_DEV) as *mut u64)
    if s == 0 || d == 0 { return E_STATE }
    let rp: u64 = b + B_SCRATCH + 352
    wr64(rp, 0)
    var tpl: i32 = 1
    if rd32(b + B_KIND) == KIND_VIDEO { tpl = 3 }
    if ACameraDevice_createCaptureRequest(d, tpl, rp) != 0 || *(rp as *mut u64) == 0 { return E_STREAM }
    let req: u64 = *(rp as *mut u64)
    let tg: u64 = *((b + B_PREV_TGT) as *mut u64)
    if ACaptureRequest_addTarget(req, tg) != 0 {
        ACaptureRequest_free(req)
        return E_STREAM
    }
    if tpl == 3 && *((b + B_REC_TGT) as *mut u64) != 0 {
        ACaptureRequest_addTarget(req, *((b + B_REC_TGT) as *mut u64))
    }
    fill_request(req, false, 0, 0, focus)
    let arr: u64 = b + B_SCRATCH + 360
    wr64(arr, req as i64)
    // capture callbacks collect the results (focus state, exposure, ...)
    let r: i32 = ACameraCaptureSession_setRepeatingRequest(s, b + CB_CAP, 1, arr, 0)
    let old: u64 = *((b + B_PREV_REQ) as *mut u64)
    if old != 0 { ACaptureRequest_free(old) }
    *((b + B_PREV_REQ) as *mut u64) = req
    if r != 0 { return E_STREAM }
    return E_OK
}

// One session output for window `wn` (out parameter `rp`). When a physical id is set the output is bound to
// that physical camera: ACaptureSessionPhysicalOutput_create(window, const char* physicalId, output**) --
// THREE arguments (an earlier version passed the id length as a 4th argument and crashed the app on the
// first lens that is a physical id).
#[no_gc]
fn make_output(b: u64, wn: u64, rp: u64) -> bool {
    let phys: u64 = *((b + B_PHYS_FN) as *mut u64)
    if phys != 0 && rd8(b + B_PHYS_ID) != 0 as u32 {
        let st: u64 = jnicall.ruf3(phys, wn, b + B_PHYS_ID, rp) & 4294967295
        return st == 0 as u64 && *(rp as *mut u64) != 0
    }
    return ACaptureSessionOutput_create(wn, rp) == 0 && *(rp as *mut u64) != 0
}

#[no_gc]
fn make_stream(b: u64, cont: u64, rd: u64, win: u64, out: u64, tgt: u64, w: i32, h: i32, fmt: i32,
               max_images: i32) -> bool {
    let rp: u64 = b + B_SCRATCH + 400
    wr64(rp, 0)
    if AImageReader_new(w, h, fmt, max_images, rp) != 0 || *(rp as *mut u64) == 0 { return false }
    *((b + rd) as *mut u64) = *(rp as *mut u64)
    wr64(rp, 0)
    if AImageReader_getWindow(*((b + rd) as *mut u64), rp) != 0 { return false }
    let wn: u64 = *(rp as *mut u64)
    *((b + win) as *mut u64) = wn
    wr64(rp, 0)
    if !make_output(b, wn, rp) { return false }
    *((b + out) as *mut u64) = *(rp as *mut u64)
    if ACaptureSessionOutputContainer_add(cont, *((b + out) as *mut u64)) != 0 { return false }
    wr64(rp, 0)
    if ACameraOutputTarget_create(wn, rp) != 0 { return false }
    *((b + tgt) as *mut u64) = *(rp as *mut u64)
    return true
}

#[no_gc]
fn init_callbacks(b: u64) {
    *((b + CB_SESS) as *mut u64) = 0
    *((b + CB_SESS + 8) as *mut u64) = code_of_q(cb_closed)
    *((b + CB_SESS + 16) as *mut u64) = code_of_q(cb_ready)
    *((b + CB_SESS + 24) as *mut u64) = code_of_q(cb_noop)
    *((b + CB_CAP) as *mut u64) = 0
    *((b + CB_CAP + 8) as *mut u64) = code_of_q(cb_noop)
    *((b + CB_CAP + 16) as *mut u64) = code_of_q(cb_noop)
    *((b + CB_CAP + 24) as *mut u64) = code_of_q(cb_completed)
    *((b + CB_CAP + 32) as *mut u64) = code_of_q(cb_failed)
    *((b + CB_CAP + 40) as *mut u64) = code_of_q(cb_noop)
    *((b + CB_CAP + 48) as *mut u64) = code_of_q(cb_noop)
    *((b + CB_CAP + 56) as *mut u64) = code_of_q(cb_noop)
}

// Builds the session for `kind`: preview (small YUV) + ONE full size stream (JPEG, RAW16 or YUV), the
// combinations every Camera2 device that has the capability must support. Starts the preview.
// If the full size stream is refused, the session is rebuilt with the next kind down the chain.
#[no_gc]
fn camera_start(kind: i32) -> i32 {
    let b: u64 = block()
    if b == 0 || !camera_is_open() { return E_STATE }
    close_session()
    var ci: CamInfo = zero_info()
    if !camera_info(rd32(b + B_CUR), &ci) { return E_STATE }
    var sw: i32 = ci.jpeg_w
    var sh: i32 = ci.jpeg_h
    var fmt: i32 = 256
    if kind == KIND_RAW {
        sw = ci.raw_w
        sh = ci.raw_h
        fmt = 32
    }
    if kind == KIND_YUV {
        sw = ci.yuv_w
        sh = ci.yuv_h
        fmt = 35
    }
    if sw <= 0 || sh <= 0 || ci.prev_w <= 0 {
        if kind != KIND_JPEG { return camera_start(KIND_JPEG) }
        return E_UNSUPPORTED
    }
    let cp: u64 = b + B_SCRATCH + 440
    wr64(cp, 0)
    if ACaptureSessionOutputContainer_create(cp) != 0 { return E_SESSION }
    let cont: u64 = *(cp as *mut u64)
    *((b + B_CONT) as *mut u64) = cont
    if !make_stream(b, cont, B_PREV_RD, B_PREV_WIN, B_PREV_OUT, B_PREV_TGT, ci.prev_w, ci.prev_h, 35, 4) {
        close_session()
        return E_STREAM
    }
    if !make_stream(b, cont, B_STILL_RD, B_STILL_WIN, B_STILL_OUT, B_STILL_TGT, sw, sh, fmt, 6) {
        close_session()
        if kind != KIND_JPEG { return camera_start(KIND_JPEG) }
        return E_STREAM
    }
    wr32(b + B_S_W, sw)
    wr32(b + B_S_H, sh)
    wr32(b + B_P_W, ci.prev_w)
    wr32(b + B_P_H, ci.prev_h)
    init_callbacks(b)
    wr32(b + B_READY, 0)
    let sp: u64 = b + B_SCRATCH + 448
    wr64(sp, 0)
    let st: i32 = ACameraDevice_createCaptureSession(*((b + B_DEV) as *mut u64), cont, b + CB_SESS, sp)
    if st != 0 || *(sp as *mut u64) == 0 {
        close_session()
        if kind != KIND_JPEG { return camera_start(KIND_JPEG) }
        return E_SESSION
    }
    *((b + B_SESS) as *mut u64) = *(sp as *mut u64)
    wr32(b + B_KIND, kind)
    return restart_preview(0.0f - 1.0f)
}

// Width and height of the still stream (which = 0) or the preview (which = 1) of the running session.
#[no_gc]
fn camera_stream_size(which: i32, w: *mut i32, h: *mut i32) {
    let b: u64 = block()
    if which == 0 {
        *w = rd32(b + B_S_W)
        *h = rd32(b + B_S_H)
    } else {
        *w = rd32(b + B_P_W)
        *h = rd32(b + B_P_H)
    }
}

// ------------------------------------------------------------ manual control
#[no_gc]
fn camera_set_auto() -> i32 {
    let b: u64 = block()
    wr32(b + B_P_MANUAL, 0)
    wr32(b + B_P_FOCUS_ON, 0)
    wr32(b + B_P_AELOCK, 0)
    wr32(b + B_P_AFLOCK, 0)
    return restart_preview(0.0f - 1.0f)
}

// exp_ns <= 0 / iso <= 0 keep auto exposure; focus_d < 0 keeps autofocus. Values are clamped to the
// ranges the lens reported. Capabilities missing -> the setting is ignored (the call still returns E_OK).
#[no_gc]
fn camera_set_manual(exp_ns: i64, iso: i32, focus_d: f32) -> i32 {
    let b: u64 = block()
    var ci: CamInfo = zero_info()
    if !camera_info(rd32(b + B_CUR), &ci) { return E_STATE }
    if exp_ns > 0 && iso > 0 {
        var e: i64 = exp_ns
        if ci.exp_min_ns > 0 && e < ci.exp_min_ns { e = ci.exp_min_ns }
        if ci.exp_max_ns > 0 && e > ci.exp_max_ns { e = ci.exp_max_ns }
        var s: i32 = iso
        if ci.iso_min > 0 && s < ci.iso_min { s = ci.iso_min }
        if ci.iso_max > 0 && s > ci.iso_max { s = ci.iso_max }
        wr64(b + B_P_EXP, e)
        wr32(b + B_P_ISO, s)
        wr32(b + B_P_MANUAL, 1)
    } else {
        wr32(b + B_P_MANUAL, 0)
    }
    if focus_d >= 0.0f {
        var f: f32 = focus_d
        if f > ci.min_focus_d { f = ci.min_focus_d }
        wrf(b + B_P_FOCUS, f)
        wr32(b + B_P_FOCUS_ON, 1)
    } else {
        wr32(b + B_P_FOCUS_ON, 0)
    }
    return restart_preview(0.0f - 1.0f)
}

// Locks / unlocks auto exposure and the autofocus distance (AF-lock = one-shot AF mode: stays where it is).
#[no_gc]
fn camera_lock(ae: bool, af: bool) -> i32 {
    let b: u64 = block()
    wr32(b + B_P_AELOCK, if_i(ae))
    wr32(b + B_P_AFLOCK, if_i(af))
    return restart_preview(0.0f - 1.0f)
}

// ------------------------------------------------------------ tap focus, zoom, flash
// Reads the control facts of the opened camera (zoom range, active array, region counts) and resets the state.
#[no_gc]
fn reset_controls(b: u64, md: u64) {
    wrf(b + B_ZOOM, 1.0f)
    wrf(b + B_ZOOM_MIN, 1.0f)
    wrf(b + B_ZOOM_MAX, 1.0f)
    wr32(b + B_ZOOM_MODE, 0)
    wr32(b + B_ACT_W, 0)
    wr32(b + B_ACT_H, 0)
    wr32(b + B_FLASH, FLASH_OFF)
    wr32(b + B_MAX_AE, 0)
    wr32(b + B_MAX_AF, 0)
    wr32(b + B_AF_REG + 16, 0)
    wr32(b + B_AE_REG + 16, 0)
    wr32(b + B_AF_TAP, 0)
    wr32(b + B_AF_STATE, 0 - 1)
    wr32(b + B_AE_STATE, 0 - 1)
    wr32(b + B_FLASH_STATE, 0 - 1)
    wr32(b + B_FLASH_USE, 0)
    wr32(b + B_FLASH_PREP, 0)
    wrf(b + B_ZOOM_RES, 0.0f)
    if md == 0 { return }
    let e: u64 = b + B_SCRATCH + 480
    if md_get(md, T_CONTROL_ZOOM_RATIO_RANGE, e) && e_count(e) >= 2 {
        wrf(b + B_ZOOM_MIN, rdf(e_data(e)))
        wrf(b + B_ZOOM_MAX, rdf(e_data(e) + 4))
        wr32(b + B_ZOOM_MODE, 1)
    } else {
        // older devices: digital zoom through the crop region
        wrf(b + B_ZOOM_MAX, md_f32(md, T_SCALER_MAX_DIGITAL_ZOOM, 1.0f))
        if rdf(b + B_ZOOM_MAX) > 1.0f { wr32(b + B_ZOOM_MODE, 2) }
    }
    if rdf(b + B_ZOOM_MIN) <= 0.0f { wrf(b + B_ZOOM_MIN, 1.0f) }
    if md_get(md, T_SENSOR_INFO_ACTIVE, e) && e_count(e) >= 4 {
        wr32(b + B_ACT_W, rd32(e_data(e) + 8))
        wr32(b + B_ACT_H, rd32(e_data(e) + 12))
    }
    if md_get(md, T_CONTROL_MAX_REGIONS, e) && e_count(e) >= 3 {
        wr32(b + B_MAX_AE, rd32(e_data(e)))
        wr32(b + B_MAX_AF, rd32(e_data(e) + 8))
    }
}

// One single (non repeating) request with the current state plus an AF / AE-precapture trigger.
#[no_gc]
fn send_trigger(af: bool, ae: bool, cancel: bool) -> i32 {
    let b: u64 = block()
    let s: u64 = *((b + B_SESS) as *mut u64)
    let d: u64 = *((b + B_DEV) as *mut u64)
    if s == 0 || d == 0 { return E_STATE }
    let rp: u64 = b + B_SCRATCH + 500
    wr64(rp, 0)
    var tpl: i32 = 1
    if rd32(b + B_KIND) == KIND_VIDEO { tpl = 3 }
    if ACameraDevice_createCaptureRequest(d, tpl, rp) != 0 || *(rp as *mut u64) == 0 { return E_STREAM }
    let req: u64 = *(rp as *mut u64)
    if ACaptureRequest_addTarget(req, *((b + B_PREV_TGT) as *mut u64)) != 0 {
        ACaptureRequest_free(req)
        return E_STREAM
    }
    if tpl == 3 && *((b + B_REC_TGT) as *mut u64) != 0 {
        ACaptureRequest_addTarget(req, *((b + B_REC_TGT) as *mut u64))
    }
    fill_request(req, false, 0, 0, 0.0f - 1.0f)
    if af {
        var v: i32 = 1
        if cancel { v = 2 }
        set_u8(req, T_CONTROL_AF_TRIGGER, v)
    }
    if ae { set_u8(req, T_CONTROL_AE_PRECAPTURE_TRIGGER, 1) }
    let arr: u64 = b + B_SCRATCH + 508
    wr64(arr, req as i64)
    let r: i32 = ACameraCaptureSession_capture(s, b + CB_CAP, 1, arr, 0)
    ACaptureRequest_free(req)
    if r != 0 { return E_STREAM }
    return E_OK
}

// TAP TO FOCUS. (nx, ny) in 0..1 = the tapped point of the UPRIGHT picture, i.e. the sensor picture rotated by the
// lens orientation (what camera_preview_bgrx(rot = orientation) and the GPU preview show; if the UI rotates the
// picture further for the display, convert the tap first). mirror = the preview is flipped (front camera). The
// point is turned into a sensor-space metering region (rotation, mirror and the current zoom are taken into
// account); ae = also meter exposure there. Starts a one-shot autofocus; poll camera_focus_state(). The focus
// stays where it is until camera_focus_clear(). Lenses without AF: E_UNSUPPORTED. Bad point: E_STATE.
#[no_gc]
fn camera_focus_at(nx: f32, ny: f32, mirror: bool, ae: bool) -> i32 {
    let b: u64 = block()
    if b == 0 || !camera_is_open() || *((b + B_SESS) as *mut u64) == 0 { return E_STATE }
    var li: CamInfo = zero_info()
    if !camera_info(rd32(b + B_CUR), &li) || !li.has_af { return E_UNSUPPORTED }
    let reg: u64 = b + B_AF_REG
    if !focusplan.tap_region(nx, ny, rd32(b + B_ROT), mirror, rdf(b + B_ZOOM), rd32(b + B_ACT_W), rd32(b + B_ACT_H),
                             0.15f, reg) {
        return E_STATE
    }
    wr32(reg + 16, 1000)
    let ae_reg: u64 = b + B_AE_REG
    var i: u64 = 0
    while i < 16 {
        wr8(ae_reg + i, rd8(reg + i))
        i = i + 1
    }
    wr32(ae_reg + 16, if_i(ae) * 1000)
    wr32(b + B_AF_TAP, 1)
    wr32(b + B_P_FOCUS_ON, 0)
    wr32(b + B_P_AFLOCK, 0)
    wr32(b + B_AF_STATE, 0 - 1)
    let r: i32 = restart_preview(0.0f - 1.0f)
    if r != E_OK { return r }
    return send_trigger(true, false, false)
}

// Ends tap focus: regions off, AF back to continuous picture.
#[no_gc]
fn camera_focus_clear() -> i32 {
    let b: u64 = block()
    if b == 0 || !camera_is_open() || *((b + B_SESS) as *mut u64) == 0 { return E_STATE }
    if rd32(b + B_AF_TAP) == 0 { return E_OK }
    wr32(b + B_AF_TAP, 0)
    wr32(b + B_AF_REG + 16, 0)
    wr32(b + B_AE_REG + 16, 0)
    wr32(b + B_AF_STATE, 0 - 1)
    let t: i32 = send_trigger(true, false, true)
    return restart_preview(0.0f - 1.0f)
}

// true while a tapped focus point is set.
#[no_gc]
fn camera_focus_active() -> bool {
    return rd32(block() + B_AF_TAP) == 1
}

// FOCUS_SCANNING / FOCUS_FOCUSED / FOCUS_FAILED from the newest capture result; FOCUS_IDLE = nothing to report.
#[no_gc]
fn camera_focus_state() -> i32 {
    let b: u64 = block()
    if b == 0 { return FOCUS_IDLE }
    let st: i32 = rd32(b + B_AF_STATE)
    if st == 1 || st == 3 { return FOCUS_SCANNING }
    if st == 2 || st == 4 { return FOCUS_FOCUSED }
    if st == 5 || st == 6 { return FOCUS_FAILED }
    return FOCUS_IDLE
}

// Capture results received / capture requests the camera service reported as failed since the last camera_open
// (a rejected setting shows up as failures with no more results).
#[no_gc]
fn camera_result_count() -> i64 {
    return rd64(block() + B_RES_N)
}

#[no_gc]
fn camera_fail_count() -> i64 {
    return rd64(block() + B_FAILS)
}

// The raw CONTROL_AF_STATE / CONTROL_AE_STATE of the newest capture result (-1 = none yet), for diagnosis.
#[no_gc]
fn camera_af_state_raw() -> i32 {
    return rd32(block() + B_AF_STATE)
}

#[no_gc]
fn camera_ae_state_raw() -> i32 {
    return rd32(block() + B_AE_STATE)
}

// Zoom ratio range of the open lens (ratio 1.0 = the lens's own field of view; logical multi cameras reach below 1).
#[no_gc]
fn camera_zoom_range(zmin: *mut f32, zmax: *mut f32) {
    let b: u64 = block()
    *zmin = rdf(b + B_ZOOM_MIN)
    *zmax = rdf(b + B_ZOOM_MAX)
}

// The zoom ratio the camera REPORTS in its newest capture result (0 = no result yet / device does not report).
#[no_gc]
fn camera_applied_zoom() -> f32 {
    return rdf(block() + B_ZOOM_RES)
}

// Current zoom ratio of the open lens.
#[no_gc]
fn camera_get_zoom() -> f32 {
    return rdf(block() + B_ZOOM)
}

// Sets the zoom ratio of the OPEN lens (clamped to its range). Preview and stills use it. A tapped focus
// point is cleared (its pixels would no longer match the picture).
#[no_gc]
fn camera_set_zoom(z: f32) -> i32 {
    let b: u64 = block()
    if b == 0 || !camera_is_open() { return E_STATE }
    if rd32(b + B_ZOOM_MODE) == 0 { return E_UNSUPPORTED }
    var v: f32 = z
    if v < rdf(b + B_ZOOM_MIN) { v = rdf(b + B_ZOOM_MIN) }
    if v > rdf(b + B_ZOOM_MAX) { v = rdf(b + B_ZOOM_MAX) }
    wrf(b + B_ZOOM, v)
    if rd32(b + B_AF_TAP) == 1 {
        wr32(b + B_AF_TAP, 0)
        wr32(b + B_AF_REG + 16, 0)
        wr32(b + B_AE_REG + 16, 0)
    }
    if *((b + B_SESS) as *mut u64) == 0 { return E_OK }
    return restart_preview(0.0f - 1.0f)
}

// The scan table as zoom candidates: equiv[i] = 35 mm equivalent of lens i when it faces like the open lens
// (else 0). Returns the index of the main lens (first lens of that facing that is not a physical id), or -1.
#[no_gc]
fn zoom_candidates(equiv: u64, cap: i32) -> i32 {
    let b: u64 = block()
    let n: i32 = rd32(b + B_SCAN_N)
    var cur: CamInfo = zero_info()
    if !camera_info(rd32(b + B_CUR), &cur) { return 0 - 1 }
    var main: i32 = 0 - 1
    var i: i32 = 0
    while i < n && i < cap {
        var ci: CamInfo = zero_info()
        var v: f32 = 0.0f
        if camera_info(i, &ci) && ci.facing == cur.facing && ci.equiv_mm > 0.0f && ci.prev_w > 0 {
            v = ci.equiv_mm
            if main < 0 && ci.parent < 0 { main = i }
        }
        *((equiv + ((i * 4) as u64)) as *mut f32) = v
        i = i + 1
    }
    return main
}

// Which lens should show zoom `z` (1.0 = the main lens of that facing, as in a phone's camera app): returns its
// scan index and the zoom ratio to set on it (*ratio). A logical multi camera whose own zoom range covers z (the
// service switches the physical lenses itself) stays as it is. No candidate (no focal data) -> current lens.
#[no_gc]
fn camera_zoom_lens(z: f32, ratio: *mut f32) -> i32 {
    let b: u64 = block()
    let cur_idx: i32 = rd32(b + B_CUR)
    *ratio = z
    if b == 0 { return cur_idx }
    if (*((b + B_CAPS) as *mut u32) & CAP_LOGICAL) != 0 as u32 && rd32(b + B_ZOOM_MODE) == 1 && rd8(b + B_PHYS_ID) == 0 as u32 {
        if z >= rdf(b + B_ZOOM_MIN) && z <= rdf(b + B_ZOOM_MAX) { return cur_idx }
    }
    var eq: [f32; 64] = [0.0f; 64]
    let main: i32 = zoom_candidates((&eq[0]) as u64, 64)
    if main < 0 { return cur_idx }
    var r: f32 = z
    let pick: i32 = focusplan.zoom_pick((&eq[0]) as u64, rd32(b + B_SCAN_N), main, z, (&r) as u64)
    if pick < 0 { return cur_idx }
    *ratio = r
    return pick
}

// Zoom as the user sees it: ratio of the open lens relative to the main lens (1.0 = main, 0.5 = ultra wide,
// 3.0 = a 3x tele lens at ratio 1). Without focal data = the plain ratio.
#[no_gc]
fn camera_zoom_factor() -> f32 {
    let b: u64 = block()
    var eq: [f32; 64] = [0.0f; 64]
    let main: i32 = zoom_candidates((&eq[0]) as u64, 64)
    let cur: i32 = rd32(b + B_CUR)
    if main < 0 || cur < 0 || cur >= 64 || eq[main as usize] <= 0.0f || eq[cur as usize] <= 0.0f { return rdf(b + B_ZOOM) }
    return rdf(b + B_ZOOM) * eq[cur as usize] / eq[main as usize]
}

// Zoom to `z` (user scale, see camera_zoom_factor): switches the lens when another lens serves it better, then
// sets the ratio. A lens switch closes and reopens the camera and restarts the session with the same kind, so
// the caller must have released its PreviewFrame first; while recording only the ratio changes.
#[no_gc]
fn camera_zoom_to(z: f32) -> i32 {
    let b: u64 = block()
    if b == 0 || !camera_is_open() { return E_STATE }
    var ratio: f32 = z
    let lens: i32 = camera_zoom_lens(z, &ratio)
    if lens != rd32(b + B_CUR) {
        if camera_video_active() { return camera_set_zoom(z) }
        let kind: i32 = rd32(b + B_KIND)
        let fl: i32 = rd32(b + B_FLASH)
        let r: i32 = camera_open(lens)
        if r != E_OK { return r }
        if kind >= 0 {
            let r2: i32 = camera_start(kind)
            if r2 != E_OK { return r2 }
        }
        if fl == FLASH_TORCH {
            let r3: i32 = camera_set_flash(fl)
        }
    }
    return camera_set_zoom(ratio)
}

// Flash for STILLS: FLASH_OFF / FLASH_AUTO / FLASH_ON fire with a single camera_capture (n == 1) in automatic
// exposure; FLASH_TORCH keeps the light on for the preview, every still and video. E_UNSUPPORTED = the lens has
// no flash (the mode stays off).
#[no_gc]
fn camera_set_flash(mode: i32) -> i32 {
    let b: u64 = block()
    if b == 0 || !camera_is_open() { return E_STATE }
    if mode < FLASH_OFF || mode > FLASH_TORCH { return E_STATE }
    if mode != FLASH_OFF && (*((b + B_CAPS) as *mut u32) & CAP_FLASH) == 0 as u32 {
        wr32(b + B_FLASH, FLASH_OFF)
        return E_UNSUPPORTED
    }
    wr32(b + B_FLASH, mode)
    wr32(b + B_FLASH_PREP, 0)
    if *((b + B_SESS) as *mut u64) == 0 { return E_OK }
    return restart_preview(0.0f - 1.0f)
}

#[no_gc]
fn camera_flash_mode() -> i32 {
    return rd32(block() + B_FLASH)
}

// Call right before camera_capture(1, ...) when the mode is FLASH_AUTO / FLASH_ON: runs the AE precapture sequence
// (metering with the flash in the loop, up to 2.4 s) so the flash exposure is right. Harmless in other modes.
// The next camera_capture ends the flash preview state again.
#[no_gc]
fn camera_flash_prepare() -> i32 {
    let b: u64 = block()
    if b == 0 || !camera_is_open() || *((b + B_SESS) as *mut u64) == 0 { return E_STATE }
    let fl: i32 = rd32(b + B_FLASH)
    if (fl != FLASH_AUTO && fl != FLASH_ON) || (*((b + B_CAPS) as *mut u32) & CAP_FLASH) == 0 as u32 || rd32(b + B_P_MANUAL) == 1 {
        return E_OK
    }
    wr32(b + B_FLASH_PREP, 1)
    wr32(b + B_AE_STATE, 0 - 1)
    let r: i32 = restart_preview(0.0f - 1.0f)
    if r != E_OK { return r }
    let t: i32 = send_trigger(false, true, false)
    if t != E_OK { return t }
    // AE_STATE 5 = PRECAPTURE; wait for it to start (<= 400 ms) and to finish
    var w: i32 = 0
    var seen: bool = false
    while w < 2400 {
        wait_ms(20 as u32)
        w = w + 20
        let st: i32 = rd32(b + B_AE_STATE)
        if st == 5 { seen = true }
        if seen && st != 5 && st >= 0 { break }
        if !seen && w >= 400 { break }
    }
    return E_OK
}

// ------------------------------------------------------------ preview frames
// The newest preview frame as BGRX (window.image) scaled to ow x oh (nearest), rotated `rot` degrees
// clockwise (0/90/180/270; pass the lens `orientation` to get an upright picture). mirror flips
// horizontally (front camera). Returns 1 = new frame written, 0 = no new frame, <0 error.
#[no_gc]
fn camera_preview_bgrx(out: u64, ow: i32, oh: i32, rot: i32, mirror: bool) -> i32 {
    let b: u64 = block()
    let rd: u64 = *((b + B_PREV_RD) as *mut u64)
    if rd == 0 || out == 0 || ow <= 0 || oh <= 0 { return 0 - 1 }
    let ip: u64 = b + B_SCRATCH + 480
    var img: u64 = 0
    // drop all but the newest image
    while true {
        wr64(ip, 0)
        if AImageReader_acquireNextImage(rd, ip) != 0 { break }
        let n: u64 = *(ip as *mut u64)
        if n == 0 { break }
        if img != 0 { AImage_delete(img) }
        img = n
    }
    if img == 0 { return 0 }
    let q: u64 = b + B_SCRATCH + 488
    let w: i32 = img_int(AImage_getWidth(img, q), q)
    let h: i32 = img_int(AImage_getHeight(img, q), q)
    var yp: u64 = 0
    var up: u64 = 0
    var vp: u64 = 0
    wr32(q, 0)
    let r0: i32 = AImage_getPlaneData(img, 0, b + B_SCRATCH + 496, q)
    yp = *((b + B_SCRATCH + 496) as *mut u64)
    let r1: i32 = AImage_getPlaneData(img, 1, b + B_SCRATCH + 496, q)
    up = *((b + B_SCRATCH + 496) as *mut u64)
    let r2: i32 = AImage_getPlaneData(img, 2, b + B_SCRATCH + 496, q)
    vp = *((b + B_SCRATCH + 496) as *mut u64)
    let ys: i32 = plane_int(AImage_getPlaneRowStride(img, 0, q), q)
    let us: i32 = plane_int(AImage_getPlaneRowStride(img, 1, q), q)
    let up_s: i32 = plane_int(AImage_getPlanePixelStride(img, 1, q), q)
    if yp == 0 || up == 0 || vp == 0 || w <= 0 || h <= 0 || ys <= 0 {
        AImage_delete(img)
        return 0 - 1
    }
    var oy: i32 = 0
    while oy < oh {
        var ox: i32 = 0
        while ox < ow {
            var mx: i32 = ox
            if mirror { mx = ow - 1 - ox }
            var sx: i32 = 0
            var sy: i32 = 0
            if rot == 90 {
                sx = oy * w / oh
                sy = (ow - 1 - mx) * h / ow
            } else if rot == 270 {
                sx = (oh - 1 - oy) * w / oh
                sy = mx * h / ow
            } else if rot == 180 {
                sx = (ow - 1 - mx) * w / ow
                sy = (oh - 1 - oy) * h / oh
            } else {
                sx = mx * w / ow
                sy = oy * h / oh
            }
            let y: i32 = rd8(yp + ((sy * ys + sx) as u64)) as i32
            let ci: u64 = ((sy / 2) * us + (sx / 2) * up_s) as u64
            let u: i32 = rd8(up + ci) as i32 - 128
            let v: i32 = rd8(vp + ci) as i32 - 128
            var r: i32 = y + (359 * v) / 256
            var g: i32 = y - (88 * u + 183 * v) / 256
            var bl: i32 = y + (454 * u) / 256
            if r < 0 { r = 0 }
            if r > 255 { r = 255 }
            if g < 0 { g = 0 }
            if g > 255 { g = 255 }
            if bl < 0 { bl = 0 }
            if bl > 255 { bl = 255 }
            let o: u64 = out + (((oy * ow + ox) * 4) as u64)
            wr8(o, bl as u32)
            wr8(o + 1, g as u32)
            wr8(o + 2, r as u32)
            wr8(o + 3, 0 as u32)
            ox = ox + 1
        }
        oy = oy + 1
    }
    AImage_delete(img)
    return 1
}

// ------------------------------------------------------------ preview frames for the GPU
// The newest preview image as raw planes (YUV_420_888): nothing is converted here, lib/gpu/campreview.fi
// uploads the planes and the shader does YUV -> RGB, rotation and the aspect crop. The image stays held
// (its planes are camera memory) until camera_preview_release; hold it only for the upload.
//   up/vp: the U and V plane starts, ups = pixel stride of U/V (1 planar, 2 interleaved semi-planar)
//   ts: sensor timestamp in ns (0 if the NDK does not say)
struct PreviewFrame {
    w: i32,
    h: i32,
    yp: u64,
    up: u64,
    vp: u64,
    ys: i32,
    us: i32,
    vs: i32,
    ups: i32,
    ts: i64,
    img: u64,
}

#[no_gc]
fn preview_frame_new() -> PreviewFrame {
    return PreviewFrame { w: 0, h: 0, yp: 0, up: 0, vp: 0, ys: 0, us: 0, vs: 0, ups: 0, ts: 0, img: 0 }
}

// 1 = a new frame is in `f` (call camera_preview_release when uploaded), 0 = no new frame, <0 = error.
// Older queued images are dropped, so the preview never lags behind.
#[no_gc]
fn camera_preview_acquire(f: *mut PreviewFrame) -> i32 {
    let b: u64 = block()
    let rd: u64 = *((b + B_PREV_RD) as *mut u64)
    if rd == 0 { return 0 - 1 }
    if (*f).img != 0 { camera_preview_release(f) }
    let ip: u64 = b + B_SCRATCH + 480
    var img: u64 = 0
    while true {
        wr64(ip, 0)
        if AImageReader_acquireNextImage(rd, ip) != 0 { break }
        let n: u64 = *(ip as *mut u64)
        if n == 0 { break }
        if img != 0 { AImage_delete(img) }
        img = n
    }
    if img == 0 { return 0 }
    let q: u64 = b + B_SCRATCH + 488
    let pp: u64 = b + B_SCRATCH + 496
    (*f).w = img_int(AImage_getWidth(img, q), q)
    (*f).h = img_int(AImage_getHeight(img, q), q)
    wr64(pp, 0)
    let r0: i32 = AImage_getPlaneData(img, 0, pp, q)
    (*f).yp = *(pp as *mut u64)
    wr64(pp, 0)
    let r1: i32 = AImage_getPlaneData(img, 1, pp, q)
    (*f).up = *(pp as *mut u64)
    wr64(pp, 0)
    let r2: i32 = AImage_getPlaneData(img, 2, pp, q)
    (*f).vp = *(pp as *mut u64)
    (*f).ys = plane_int(AImage_getPlaneRowStride(img, 0, q), q)
    (*f).us = plane_int(AImage_getPlaneRowStride(img, 1, q), q)
    (*f).vs = plane_int(AImage_getPlaneRowStride(img, 2, q), q)
    (*f).ups = plane_int(AImage_getPlanePixelStride(img, 1, q), q)
    wr64(q, 0)
    (*f).ts = 0
    if AImage_getTimestamp(img, q) == 0 { (*f).ts = rd64(q) }
    (*f).img = img
    if (*f).yp == 0 || (*f).up == 0 || (*f).vp == 0 || (*f).w <= 0 || (*f).h <= 0 || (*f).ys <= 0 || (*f).us <= 0 {
        camera_preview_release(f)
        return 0 - 1
    }
    return 1
}

#[no_gc]
fn camera_preview_release(f: *mut PreviewFrame) {
    if (*f).img != 0 { AImage_delete((*f).img) }
    (*f).img = 0
    (*f).yp = 0
    (*f).up = 0
    (*f).vp = 0
}

// Sensor orientation (degrees clockwise to be upright at display rotation 0) and facing of the OPEN lens,
// for the preview: rot = campreview.cp_rotation(camera_sensor_rotation(), display_deg, camera_is_front()),
// mirror = camera_is_front().
#[no_gc]
fn camera_sensor_rotation() -> i32 {
    return rd32(block() + B_ROT)
}

#[no_gc]
fn camera_is_front() -> bool {
    return rd32(block() + B_FACING) == 1
}

#[no_gc]
fn img_int(status: i32, q: u64) -> i32 {
    if status != 0 { return 0 }
    return rd32(q)
}

#[no_gc]
fn plane_int(status: i32, q: u64) -> i32 {
    if status != 0 { return 0 }
    return rd32(q)
}

// ------------------------------------------------------------ results
// Index of the result ring slot with this timestamp, -1 when it has not arrived.
#[no_gc]
fn res_find(ts: i64) -> i32 {
    let b: u64 = G_P
    var i: u64 = 0
    while i < RES_COUNT {
        if rd64(b + RES_BASE + i * RES_SLOT) == ts && ts != 0 {
            return i as i32
        }
        i = i + 1
    }
    return 0 - 1
}

#[no_gc]
fn res_slot(i: i32) -> u64 {
    return G_P + RES_BASE + (i as u64) * RES_SLOT
}

// True when a focus lens reported by a result has stopped within `tol` diopters of the target.
#[no_gc]
fn focus_converged(lens_state: i32, reported: f32, target: f32, tol: f32) -> bool {
    var d: f32 = reported - target
    if d < 0.0f { d = 0.0f - d }
    if lens_state == 1 { return false }
    return d <= tol
}

// The newest result slot (for the preview): -1 when no result yet.
#[no_gc]
fn camera_last_slot() -> i32 {
    let b: u64 = block()
    let n: u64 = *((b + B_RES_N) as *mut u64)
    if n == 0 { return 0 - 1 }
    return ((n - 1) % RES_COUNT) as i32
}

// ------------------------------------------------------------ metadata for the pipeline
// Static facts of the open lens (CFA, black / white level, forward matrix, focus range, lens) plus,
// when slot >= 0, what that frame's result says (exposure, ISO, noise profile, white balance gains).
#[no_gc]
fn camera_meta(slot: i32, m: *mut meta.SensorMeta) -> bool {
    let b: u64 = block()
    if b == 0 || !camera_is_open() { return false }
    let md: u64 = chars_of(b + B_ID)
    if md == 0 { return false }
    let e: u64 = b + B_SCRATCH
    *m = meta.meta_default()
    (*m).cfa = md_u8(md, T_SENSOR_INFO_CFA, 0) as u32
    if (*m).cfa > 4 as u32 { (*m).cfa = 0 as u32 }
    let white: i32 = md_i32(md, T_SENSOR_INFO_WHITE, 0)
    if md_get(md, T_SENSOR_BLACK_PATTERN, e) && e_count(e) >= 4 && white > 0 {
        var i: usize = 0
        while i < 4 {
            meta.meta_set_black(m, i, rd32(e_data(e) + (i * 4) as u64) as f32, white as f32)
            i = i + 1
        }
    }
    if md_get(md, T_SENSOR_FORWARD_MATRIX1, e) && e_count(e) >= 9 {
        var i: usize = 0
        while i < 9 {
            let num: i32 = rd32(e_data(e) + (i * 8) as u64)
            let den: i32 = rd32(e_data(e) + (i * 8) as u64 + 4)
            if den != 0 { meta.meta_set_forward(m, i, (num as f32) / (den as f32)) }
            i = i + 1
        }
    }
    (*m).focal_length = 0.0f
    if md_get(md, T_LENS_INFO_FOCAL_LENGTHS, e) { (*m).focal_length = rdf(e_data(e)) }
    if md_get(md, T_LENS_INFO_APERTURES, e) { (*m).aperture = rdf(e_data(e)) }
    if md_get(md, T_SENSOR_INFO_PHYS_SIZE, e) { (*m).sensor_width = rdf(e_data(e)) }
    meta.meta_set_focus(m, md_f32(md, T_LENS_INFO_MIN_FOCUS, 0.0f), md_f32(md, T_LENS_INFO_HYPERFOCAL, 0.0f),
        md_u8(md, T_LENS_INFO_FOCUS_CALIB, 0) as u32)
    ACameraMetadata_free(md)
    if slot >= 0 && (slot as u64) < RES_COUNT {
        let s: u64 = res_slot(slot)
        let flags: u32 = *((s + 36) as *mut u32)
        if (flags & 1 as u32) != 0 as u32 {
            (*m).exposure_ns = rd64(s + 8) as u64
            (*m).has_exposure = true
        }
        if (flags & 2 as u32) != 0 as u32 && rd32(s + 16) > 0 { (*m).iso = rd32(s + 16) as u32 }
        if rdf(s + 28) > 0.0f { (*m).focal_length = rdf(s + 28) }
        if rdf(s + 32) > 0.0f { (*m).aperture = rdf(s + 32) }
        if (flags & 32 as u32) != 0 as u32 {
            var k: usize = 0
            while k < 4 {
                meta.meta_set_noise(m, k, rdd(s + 72 + (k * 16) as u64) as f32, rdd(s + 80 + (k * 16) as u64) as f32)
                k = k + 1
            }
        }
        if (flags & 8 as u32) != 0 as u32 {
            var k: usize = 0
            while k < 4 {
                meta.meta_set_wb(m, k, rdf(s + 40 + (k * 4) as u64))
                k = k + 1
            }
        }
    }
    return true
}

// What a DNG additionally needs: ColorMatrix1, the illuminant, the as-shot neutral and the orientation.
#[no_gc]
fn camera_dng_extra(slot: i32, ex: *mut dngwrite.DngExtra) -> bool {
    let b: u64 = block()
    if b == 0 || !camera_is_open() { return false }
    *ex = dngwrite.dng_extra_default()
    let md: u64 = chars_of(b + B_ID)
    if md == 0 { return false }
    let e: u64 = b + B_SCRATCH
    if md_get(md, T_SENSOR_COLOR_TRANSFORM1, e) && e_count(e) >= 9 {
        var i: usize = 0
        var okm: bool = true
        while i < 9 {
            let num: i32 = rd32(e_data(e) + (i * 8) as u64)
            let den: i32 = rd32(e_data(e) + (i * 8) as u64 + 4)
            if den == 0 { okm = false } else { (*ex).color[i] = (num as f32) / (den as f32) }
            i = i + 1
        }
        (*ex).has_color = okm
    }
    let ill: i32 = md_u8(md, T_SENSOR_REF_ILLUMINANT1, 0)
    if ill > 0 { (*ex).illuminant = ill as u32 }
    ACameraMetadata_free(md)
    // the image is stored in sensor orientation; DNG tag 274 tells readers how to turn it upright
    let rot: i32 = rd32(b + B_ROT)
    (*ex).orientation = 1 as u32
    if rot == 90 { (*ex).orientation = 6 as u32 }
    if rot == 180 { (*ex).orientation = 3 as u32 }
    if rot == 270 { (*ex).orientation = 8 as u32 }
    if slot >= 0 && (slot as u64) < RES_COUNT {
        let s: u64 = res_slot(slot)
        if (*((s + 36) as *mut u32) & 16 as u32) != 0 as u32 {
            (*ex).neutral = [rdf(s + 56), rdf(s + 60), rdf(s + 64)]
            (*ex).has_neutral = true
        }
    }
    return true
}

// ------------------------------------------------------------ capture
// Drops every image waiting in `rd` (old frames from before the shutter press).
#[no_gc]
fn flush_reader(rd: u64) {
    let ip: u64 = G_P + B_SCRATCH + 504
    while true {
        wr64(ip, 0)
        if AImageReader_acquireNextImage(rd, ip) != 0 { break }
        let n: u64 = *(ip as *mut u64)
        if n == 0 { break }
        AImage_delete(n)
    }
}

// Waits up to timeout_ms for the next image of `rd`; 0 on timeout.
#[no_gc]
fn wait_image(rd: u64, timeout_ms: i32) -> u64 {
    let ip: u64 = G_P + B_SCRATCH + 504
    var waited: i32 = 0
    while waited < timeout_ms {
        wr64(ip, 0)
        if AImageReader_acquireNextImage(rd, ip) == 0 {
            let n: u64 = *(ip as *mut u64)
            if n != 0 { return n }
        }
        if rd32(G_P + B_STATE) != 1 { return 0 }
        wait_ms(4 as u32)
        waited = waited + 4
    }
    return 0
}

// Copies image `img` into out+at in the frame's own format; returns the octets written, 0 = does not fit.
#[no_gc]
fn store_image(img: u64, kind: i32, out: u64, at: usize, cap: usize, fi: *mut FrameInfo) -> usize {
    let b: u64 = G_P
    let q: u64 = b + B_SCRATCH + 512
    let w: i32 = img_int(AImage_getWidth(img, q), q)
    let h: i32 = img_int(AImage_getHeight(img, q), q)
    (*fi).w = w
    (*fi).h = h
    (*fi).kind = kind
    (*fi).offset = at
    wr64(q, 0)
    let tsr: i32 = AImage_getTimestamp(img, q)
    (*fi).timestamp = rd64(q)
    let dp: u64 = b + B_SCRATCH + 528
    let lp: u64 = b + B_SCRATCH + 536
    wr32(lp, 0)
    if kind == KIND_JPEG {
        if AImage_getPlaneData(img, 0, dp, lp) != 0 { return 0 }
        let n: usize = rd32(lp) as usize
        if at + n > cap { return 0 }
        copy(out + at as u64, *(dp as *mut u64), n)
        (*fi).size = n
        return n
    }
    if kind == KIND_RAW {
        if AImage_getPlaneData(img, 0, dp, lp) != 0 { return 0 }
        let src: u64 = *(dp as *mut u64)
        let rs: i32 = plane_int(AImage_getPlaneRowStride(img, 0, q), q)
        let n: usize = (w as usize) * (h as usize) * 2
        if at + n > cap || rs < w * 2 { return 0 }
        var y: i32 = 0
        while y < h {
            copy(out + (at + (y as usize) * (w as usize) * 2) as u64, src + ((y * rs) as u64), (w * 2) as usize)
            y = y + 1
        }
        (*fi).size = n
        return n
    }
    // YUV_420_888 -> packed I420 (Y, then U, then V; quarter size chroma planes)
    let n2: usize = (w as usize) * (h as usize) * 3 / 2
    if at + n2 > cap { return 0 }
    var pl: i32 = 0
    var dst: u64 = out + at as u64
    while pl < 3 {
        if AImage_getPlaneData(img, pl, dp, lp) != 0 { return 0 }
        let src2: u64 = *(dp as *mut u64)
        let rs2: i32 = plane_int(AImage_getPlaneRowStride(img, pl, q), q)
        let ps: i32 = plane_int(AImage_getPlanePixelStride(img, pl, q), q)
        var pw: i32 = w
        var ph: i32 = h
        if pl > 0 {
            pw = w / 2
            ph = h / 2
        }
        var y2: i32 = 0
        while y2 < ph {
            let row: u64 = src2 + ((y2 * rs2) as u64)
            if ps == 1 {
                copy(dst, row, pw as usize)
            } else {
                var x: i32 = 0
                while x < pw {
                    wr8(dst + x as u64, rd8(row + ((x * ps) as u64)))
                    x = x + 1
                }
            }
            dst = dst + pw as u64
            y2 = y2 + 1
        }
        pl = pl + 1
    }
    (*fi).size = n2
    return n2
}

// THE capture function. Takes n frames with the session's kind (KIND_JPEG: one JPEG per frame, KIND_RAW:
// RAW16, KIND_YUV: I420). exp_list (i64 ns per frame) and focus_list (f32 diopters per frame) may be 0:
// auto exposure / current focus. With a focus_list every frame waits for the lens to arrive (result
// LENS_STATE stationary and LENS_FOCUS_DISTANCE within tolerance, at most ~700 ms) and is taken alone;
// without it frames go out in batches of up to 4. Frames land one after the other in `out` (cap octets),
// described in frames[i]. Returns the number of frames stored (may be < n when the buffer is full or a
// frame timed out), or a negative E_* code when nothing could be taken.
#[no_gc]
fn camera_capture(n: i32, exp_list: u64, focus_list: u64, iso: i32, out: u64, cap: usize,
                  frames: *mut FrameInfo) -> i32 {
    let b: u64 = block()
    if b == 0 || !camera_is_open() { return 0 - E_STATE }
    let sess: u64 = *((b + B_SESS) as *mut u64)
    let rd: u64 = *((b + B_STILL_RD) as *mut u64)
    let kind: i32 = rd32(b + B_KIND)
    if sess == 0 || rd == 0 || kind < 0 { return 0 - E_STATE }
    if n <= 0 || out == 0 { return 0 - E_STATE }
    let d: u64 = *((b + B_DEV) as *mut u64)
    var done: i32 = 0
    var at: usize = 0
    var batch: i32 = 1
    // the flash AE modes are for a single frame only: a burst must not fire the flash n times
    wr32(b + B_FLASH_USE, if_i(n == 1 && kind != KIND_VIDEO))
    flush_reader(rd)
    while done < n {
        batch = 1
        if focus_list == 0 {
            batch = n - done
            if batch > 4 { batch = 4 }
        }
        var focus: f32 = 0.0f - 1.0f
        if focus_list != 0 {
            focus = rdf(focus_list + ((done * 4) as u64))
            // move the lens with the preview request, wait for the result
            let mark: u64 = *((b + B_RES_N) as *mut u64)
            let rr: i32 = restart_preview(focus)
            var w8: i32 = 0
            var tol: f32 = 0.15f
            while w8 < 700 {
                let cur: u64 = *((b + B_RES_N) as *mut u64)
                if cur >= mark + 3 {
                    let ls: i32 = camera_last_slot()
                    let s2: u64 = res_slot(ls)
                    if focus_converged(rd32(s2 + 20), rdf(s2 + 24), focus, tol) { break }
                }
                wait_ms(20 as u32)
                w8 = w8 + 20
            }
        }
        let arr: u64 = b + B_SCRATCH + 544
        var made: i32 = 0
        var k: i32 = 0
        while k < batch {
            let rp: u64 = b + B_SCRATCH + 584
            wr64(rp, 0)
            if ACameraDevice_createCaptureRequest(d, 2, rp) != 0 || *(rp as *mut u64) == 0 { break }
            let req: u64 = *(rp as *mut u64)
            ACaptureRequest_addTarget(req, *((b + B_STILL_TGT) as *mut u64))
            var e: i64 = 0
            if exp_list != 0 { e = rd64(exp_list + (((done + k) * 8) as u64)) }
            fill_request(req, true, e, iso, focus)
            *((arr + (made * 8) as u64) as *mut u64) = req
            made = made + 1
            k = k + 1
        }
        if made == 0 { break }
        let st: i32 = ACameraCaptureSession_capture(sess, b + CB_CAP, made, arr, 0)
        var got: i32 = 0
        if st == 0 {
            while got < made {
                let img: u64 = wait_image(rd, 6000)
                if img == 0 { break }
                let cur: *mut FrameInfo = frame_at(frames, done + got)
                (*cur).focus_cmd = focus
                (*cur).slot = 0 - 1
                (*cur).have_result = false
                (*cur).exposure_ns = 0
                (*cur).iso = 0
                (*cur).focus_res = 0.0f - 1.0f
                (*cur).lens_state = 0 - 1
                let sz: usize = store_image(img, kind, out, at, cap, cur)
                AImage_delete(img)
                if sz == 0 { break }
                at = at + sz
                // the result for this frame (it may arrive a little after the image)
                var wr: i32 = 0
                var slot: i32 = res_find((*cur).timestamp)
                while slot < 0 && wr < 1500 {
                    wait_ms(10 as u32)
                    wr = wr + 10
                    slot = res_find((*cur).timestamp)
                }
                if slot >= 0 {
                    let s3: u64 = res_slot(slot)
                    (*cur).slot = slot
                    (*cur).have_result = true
                    (*cur).exposure_ns = rd64(s3 + 8)
                    (*cur).iso = rd32(s3 + 16)
                    (*cur).focus_res = rdf(s3 + 24)
                    (*cur).lens_state = rd32(s3 + 20)
                    wr32(b + B_LAST_SLOT, slot)
                }
                got = got + 1
            }
        }
        var f2: i32 = 0
        while f2 < made {
            ACaptureRequest_free(*((arr + (f2 * 8) as u64) as *mut u64))
            f2 = f2 + 1
        }
        done = done + got
        if got < made { break }
    }
    wr32(b + B_FLASH_USE, 0)
    let was_prep: bool = rd32(b + B_FLASH_PREP) == 1
    wr32(b + B_FLASH_PREP, 0)
    if focus_list != 0 || was_prep {
        let rr2: i32 = restart_preview(0.0f - 1.0f)
    }
    if done == 0 { return 0 - E_TIMEOUT }
    return done
}

#[no_gc]
fn frame_at(f: *mut FrameInfo, i: i32) -> *mut FrameInfo {
    return ((f as u64) + (i as u64) * (sizeof_frame() as u64)) as *mut FrameInfo
}

#[no_gc]
fn sizeof_frame() -> usize {
    var two: [FrameInfo; 2] = [zero_frame(), zero_frame()]
    return ((&two[1]) as u64 - (&two[0]) as u64) as usize
}

#[no_gc]
fn zero_frame() -> FrameInfo {
    return FrameInfo {
        kind: 0, w: 0, h: 0, offset: 0, size: 0, timestamp: 0, exposure_ns: 0, iso: 0,
        focus_cmd: 0.0f, focus_res: 0.0f, lens_state: 0, slot: 0 - 1, have_result: false,
    }
}

// ------------------------------------------------------------ focus plan
// Focus positions for a focus stack: see focusplan.fi (pure function, host-testable).
#[no_gc]
fn focus_plan(near_d: f32, far_d: f32, step_d: f32, nmax: i32, out: u64) -> i32 {
    return focusplan.focus_plan(near_d, far_d, step_d, nmax, out)
}

// ------------------------------------------------------------ saving
// Writes `n` octets to the gallery: MediaStore.Images (Pictures/FirnCam) on Android 10+, which needs no
// permission for our own pictures. Older systems / failures: a file in the app's working directory
// (returns 2). Returns 1 = in the gallery, 2 = private file, 0 = failed. name is e.g. "IMG_1.jpg".
#[no_gc]
fn camera_save(data: u64, n: usize, name: u64, mime: u64) -> i32 {
    var ctx: u64 = 0
    let env: u64 = jni_ctx(&ctx)
    let act: u64 = activity.activity_pointer()
    if env != 0 && ndk.peek32(act + ndk.ACT_SDK_VERSION) >= 29 {
        if save_mediastore(env, ctx, data, n, name, mime) { return 1 }
    }
    let fd: i64 = syscall(2, name as i64, 577, 420, 0, 0, 0)
    if fd < 0 { return 0 }
    var off: usize = 0
    while off < n {
        let w: i64 = syscall(1, fd, (data + off as u64) as i64, (n - off) as i64, 0, 0, 0)
        if w <= 0 { break }
        off = off + w as usize
    }
    syscall(3, fd, 0, 0, 0, 0, 0)
    if off == n { return 2 }
    return 0
}

// Inserts a MediaStore row (collection class `coll`, relative folder `rel`, both string table offsets) and opens
// it with `mode` ("w" / "rw"). Returns the ParcelFileDescriptor (local ref) or 0.
#[no_gc]
fn mediastore_open(env: u64, ctx: u64, coll: usize, rel: usize, name: u64, mime: u64, mode: usize) -> u64 {
    let cc: u64 = jnicall.j_obj_class(env, ctx)
    let resolver: u64 = jnicall.j_obj(env, ctx, jnicall.j_method(env, cc, t(N_RESOLVER), t(G_RESOLVER)), 0)
    jnicall.j_del(env, cc)
    if resolver == 0 { return 0 }
    let vc: u64 = jnicall.j_class(env, t(C_VALUES))
    let values: u64 = jnicall.j_new(env, vc, jnicall.j_method(env, vc, t(N_INIT), t(G_V)), 0)
    if values == 0 { return 0 }
    var a: [u64; 3] = [0; 3]
    let pm: u64 = jnicall.j_method(env, vc, t(N_PUT), t(G_PUT_SS))
    a[0] = jnicall.j_str(env, t(S_DISPLAY))
    a[1] = jnicall.j_str(env, name)
    let o1: bool = jnicall.j_void(env, values, pm, (&a[0]) as u64)
    a[0] = jnicall.j_str(env, t(S_MIME))
    a[1] = jnicall.j_str(env, mime)
    let o2: bool = jnicall.j_void(env, values, pm, (&a[0]) as u64)
    a[0] = jnicall.j_str(env, t(S_RELPATH))
    a[1] = jnicall.j_str(env, t(rel))
    let o3: bool = jnicall.j_void(env, values, pm, (&a[0]) as u64)
    let mc: u64 = jnicall.j_class(env, t(coll))
    let base: u64 = jnicall.j_sfield_obj(env, mc, t(N_EXT), t(G_URI))
    let rc: u64 = jnicall.j_obj_class(env, resolver)
    a[0] = base
    a[1] = values
    let uri: u64 = jnicall.j_obj(env, resolver, jnicall.j_method(env, rc, t(N_INSERT), t(G_INSERT)), (&a[0]) as u64)
    if uri == 0 { return 0 }
    if coll == C_MEDIA {
        let old: u64 = rd64(block() + B_LAST_URI) as u64
        if old != 0 { jnicall.j_del_global(env, old) }
        wr64(block() + B_LAST_URI, jnicall.j_global(env, uri) as i64)
    }
    a[0] = uri
    a[1] = jnicall.j_str(env, t(mode))
    let pfd: u64 = jnicall.j_obj(env, resolver, jnicall.j_method(env, rc, t(N_OPEN_FD), t(G_OPEN_FD)), (&a[0]) as u64)
    jnicall.j_del(env, uri)
    jnicall.j_del(env, resolver)
    jnicall.j_del(env, values)
    return pfd
}

#[no_gc]
fn save_mediastore(env: u64, ctx: u64, data: u64, n: usize, name: u64, mime: u64) -> bool {
    let pfd: u64 = mediastore_open(env, ctx, C_MEDIA, S_PICTURES, name, mime, S_W)
    if pfd == 0 { return false }
    let pc: u64 = jnicall.j_obj_class(env, pfd)
    let fd: i32 = jnicall.j_int(env, pfd, jnicall.j_method(env, pc, t(N_DETACH), t(G_VI)), 0)
    if fd < 0 { return false }
    var off: usize = 0
    while off < n {
        let w: i64 = syscall(1, fd as i64, (data + off as u64) as i64, (n - off) as i64, 0, 0, 0)
        if w <= 0 { break }
        off = off + w as usize
    }
    syscall(3, fd as i64, 0, 0, 0, 0, 0)
    jnicall.j_del(env, pfd)
    return off == n
}

// Opens the system gallery: ACTION_VIEW on the newest picture saved by this app (global Uri ref), else on the
// whole Images collection. Needs read grant for our own entry (FLAG_GRANT_READ_URI_PERMISSION) and NEW_TASK.
// True = an activity was started (false: no activity / JNI, or no app handles it).
#[no_gc]
fn camera_open_gallery() -> bool {
    var ctx: u64 = 0
    let env: u64 = jni_ctx(&ctx)
    if env == 0 || ctx == 0 { return false }
    var uri: u64 = rd64(block() + B_LAST_URI) as u64
    if uri == 0 {
        let mc: u64 = jnicall.j_class(env, t(C_MEDIA))
        uri = jnicall.j_sfield_obj(env, mc, t(N_EXT), t(G_URI))
        if uri == 0 { return false }
    }
    let ic: u64 = jnicall.j_class(env, t(C_INTENT))
    var a: [u64; 2] = [0; 2]
    a[0] = jnicall.j_str(env, t(S_ACTION_VIEW))
    a[1] = uri
    let it: u64 = jnicall.j_new(env, ic, jnicall.j_method(env, ic, t(N_INIT), t(G_INTENT_INIT)), (&a[0]) as u64)
    if it == 0 { return false }
    a[0] = 268435457 // FLAG_ACTIVITY_NEW_TASK | FLAG_GRANT_READ_URI_PERMISSION
    let it2: u64 = jnicall.j_obj(env, it, jnicall.j_method(env, ic, t(N_SET_FLAGS), t(G_SET_FLAGS)), (&a[0]) as u64)
    if it2 == 0 { return false }
    let cc: u64 = jnicall.j_obj_class(env, ctx)
    a[0] = it
    let ok: bool = jnicall.j_void(env, ctx, jnicall.j_method(env, cc, t(N_START_ACT), t(G_START_ACT)), (&a[0]) as u64)
    jnicall.j_del(env, cc)
    jnicall.j_del(env, it)
    return ok
}

// ------------------------------------------------------------ video
// MediaRecorder (Java, called through JNI: no callbacks needed) records the camera's recorder surface straight
// into MediaStore.Video (Movies/FirnCam) -- Android 10+ (no storage permission for our own files). The session is
// the preview + that surface (TEMPLATE_RECORD). Video only: audio needs RECORD_AUDIO, which the app does not ask for.
#[no_gc]
fn rec_free(b: u64) {
    let t2: u64 = *((b + B_REC_TGT) as *mut u64)
    if t2 != 0 { ACameraOutputTarget_free(t2) }
    let o: u64 = *((b + B_REC_OUT) as *mut u64)
    if o != 0 { ACaptureSessionOutput_free(o) }
    let w: u64 = *((b + B_REC_WIN) as *mut u64)
    if w != 0 { ANativeWindow_release(w) }
    *((b + B_REC_TGT) as *mut u64) = 0
    *((b + B_REC_OUT) as *mut u64) = 0
    *((b + B_REC_WIN) as *mut u64) = 0
}

#[no_gc]
fn call_i(env: u64, o: u64, m: u64, v: i32) -> bool {
    var a: [u64; 2] = [0; 2]
    a[0] = (v as i64) as u64
    return jnicall.j_void(env, o, m, (&a[0]) as u64)
}

// Releases the recorder and closes the file (stop = true: stop() first, which finalises the MP4).
#[no_gc]
fn rec_release(b: u64, stop: bool) -> bool {
    var ok: bool = true
    let rec: u64 = *((b + B_REC) as *mut u64)
    if rec == 0 { return false }
    var ctx: u64 = 0
    let env: u64 = jni_ctx(&ctx)
    if env == 0 { return false }
    let rc: u64 = jnicall.j_class(env, t(C_RECORDER))
    if stop && rd32(b + B_REC_ON) == 1 {
        ok = jnicall.j_void(env, rec, jnicall.j_method(env, rc, t(N_STOP), t(G_V)), 0)
    }
    let rel: bool = jnicall.j_void(env, rec, jnicall.j_method(env, rc, t(N_RELEASE), t(G_V)), 0)
    let pfd: u64 = *((b + B_REC_PFD) as *mut u64)
    if pfd != 0 {
        let pc: u64 = jnicall.j_obj_class(env, pfd)
        let cl: bool = jnicall.j_void(env, pfd, jnicall.j_method(env, pc, t(N_CLOSE), t(G_V)), 0)
        jnicall.j_del_global(env, pfd)
    }
    jnicall.j_del_global(env, rec)
    *((b + B_REC) as *mut u64) = 0
    *((b + B_REC_PFD) as *mut u64) = 0
    wr32(b + B_REC_ON, 0)
    return ok
}

#[no_gc]
fn camera_video_active() -> bool {
    let b: u64 = block()
    return b != 0 && rd32(b + B_REC_ON) == 1
}

// Starts recording into the gallery as `name` (zero terminated, e.g. "VID_1.mp4"). Replaces the running
// session by preview + recorder. Returns E_OK or an error; afterwards camera_stream_size(0, ..) = video size.
// After an error call camera_start(kind) again.
#[no_gc]
fn camera_video_start(name: u64) -> i32 {
    let b: u64 = block()
    if b == 0 || !camera_is_open() { return E_STATE }
    if rd32(b + B_REC_ON) == 1 { return E_STATE }
    var ctx: u64 = 0
    let env: u64 = jni_ctx(&ctx)
    let act: u64 = activity.activity_pointer()
    if env == 0 || ndk.peek32(act + ndk.ACT_SDK_VERSION) < 29 { return E_UNSUPPORTED }
    var ci: CamInfo = zero_info()
    if !camera_info(rd32(b + B_CUR), &ci) { return E_STATE }
    if ci.vid_w <= 0 || ci.vid_h <= 0 || ci.prev_w <= 0 { return E_UNSUPPORTED }
    close_session()
    let mime: str = "video/mp4\0"
    let pfd: u64 = mediastore_open(env, ctx, C_MEDIA_VIDEO, S_MOVIES, name, mime.p as u64, S_RW)
    if pfd == 0 {
        log(L_REC_FAILED)
        return E_SPACE
    }
    let rc: u64 = jnicall.j_class(env, t(C_RECORDER))
    let rec: u64 = jnicall.j_new(env, rc, jnicall.j_method(env, rc, t(N_INIT), t(G_V)), 0)
    if rec == 0 {
        log(L_REC_FAILED)
        return E_STREAM
    }
    *((b + B_REC) as *mut u64) = jnicall.j_global(env, rec)
    *((b + B_REC_PFD) as *mut u64) = jnicall.j_global(env, pfd)
    var ok: bool = true
    ok = call_i(env, rec, jnicall.j_method(env, rc, t(N_SET_VSRC), t(G_I_V)), 2) && ok
    ok = call_i(env, rec, jnicall.j_method(env, rc, t(N_SET_FMT), t(G_I_V)), 2) && ok
    var a: [u64; 3] = [0; 3]
    let pc: u64 = jnicall.j_obj_class(env, pfd)
    let fdo: u64 = jnicall.j_obj(env, pfd, jnicall.j_method(env, pc, t(N_GET_FD), t(G_GET_FD)), 0)
    a[0] = fdo
    ok = jnicall.j_void(env, rec, jnicall.j_method(env, rc, t(N_SET_FILE), t(G_SET_FILE)), (&a[0]) as u64) && ok
    ok = call_i(env, rec, jnicall.j_method(env, rc, t(N_SET_VENC), t(G_I_V)), 2) && ok
    ok = call_i(env, rec, jnicall.j_method(env, rc, t(N_SET_BR), t(G_I_V)), ci.vid_w * ci.vid_h * 5) && ok
    ok = call_i(env, rec, jnicall.j_method(env, rc, t(N_SET_FR), t(G_I_V)), 30) && ok
    a[0] = ci.vid_w as u64
    a[1] = ci.vid_h as u64
    ok = jnicall.j_void(env, rec, jnicall.j_method(env, rc, t(N_SET_SIZE), t(G_II_V)), (&a[0]) as u64) && ok
    ok = call_i(env, rec, jnicall.j_method(env, rc, t(N_SET_ORI), t(G_I_V)), ci.orientation) && ok
    ok = jnicall.j_void(env, rec, jnicall.j_method(env, rc, t(N_PREPARE), t(G_V)), 0) && ok
    var surf: u64 = 0
    if ok { surf = jnicall.j_obj(env, rec, jnicall.j_method(env, rc, t(N_GET_SURF), t(G_SURF)), 0) }
    var win: u64 = 0
    if surf != 0 { win = ANativeWindow_fromSurface(env, surf) }
    if win == 0 {
        rec_release(b, false)
        log(L_REC_FAILED)
        return E_STREAM
    }
    *((b + B_REC_WIN) as *mut u64) = win
    let cp: u64 = b + B_SCRATCH + 440
    wr64(cp, 0)
    if ACaptureSessionOutputContainer_create(cp) != 0 {
        rec_release(b, false)
        close_session()
        return E_SESSION
    }
    let cont: u64 = *(cp as *mut u64)
    *((b + B_CONT) as *mut u64) = cont
    if !make_stream(b, cont, B_PREV_RD, B_PREV_WIN, B_PREV_OUT, B_PREV_TGT, ci.prev_w, ci.prev_h, 35, 4) {
        rec_release(b, false)
        close_session()
        return E_STREAM
    }
    let rp: u64 = b + B_SCRATCH + 400
    wr64(rp, 0)
    if !make_output(b, win, rp) {
        rec_release(b, false)
        close_session()
        return E_STREAM
    }
    *((b + B_REC_OUT) as *mut u64) = *(rp as *mut u64)
    if ACaptureSessionOutputContainer_add(cont, *((b + B_REC_OUT) as *mut u64)) != 0 {
        rec_release(b, false)
        close_session()
        return E_STREAM
    }
    wr64(rp, 0)
    if ACameraOutputTarget_create(win, rp) != 0 {
        rec_release(b, false)
        close_session()
        return E_STREAM
    }
    *((b + B_REC_TGT) as *mut u64) = *(rp as *mut u64)
    wr32(b + B_S_W, ci.vid_w)
    wr32(b + B_S_H, ci.vid_h)
    wr32(b + B_P_W, ci.prev_w)
    wr32(b + B_P_H, ci.prev_h)
    init_callbacks(b)
    wr32(b + B_READY, 0)
    let sp: u64 = b + B_SCRATCH + 448
    wr64(sp, 0)
    let st: i32 = ACameraDevice_createCaptureSession(*((b + B_DEV) as *mut u64), cont, b + CB_SESS, sp)
    if st != 0 || *(sp as *mut u64) == 0 {
        rec_release(b, false)
        close_session()
        return E_SESSION
    }
    *((b + B_SESS) as *mut u64) = *(sp as *mut u64)
    wr32(b + B_KIND, KIND_VIDEO)
    let r: i32 = restart_preview(0.0f - 1.0f)
    if r != E_OK {
        rec_release(b, false)
        close_session()
        return r
    }
    wait_ms(150)
    if !jnicall.j_void(env, rec, jnicall.j_method(env, rc, t(N_START), t(G_V)), 0) {
        rec_release(b, false)
        close_session()
        return E_STREAM
    }
    wr32(b + B_REC_ON, 1)
    return E_OK
}

// Stops the recording (finalises the file) and tears the video session down. True when the MP4 was finalised.
// Afterwards call camera_start(kind) to get the preview + still session back.
#[no_gc]
fn camera_video_stop() -> bool {
    let b: u64 = block()
    if b == 0 { return false }
    let s: u64 = *((b + B_SESS) as *mut u64)
    if s != 0 {
        let r1: i32 = ACameraCaptureSession_stopRepeating(s)
        wait_ms(100)
    }
    let ok: bool = rec_release(b, true)
    close_session()
    return ok
}

// Saves a document (PDF etc.) into Download/FirnCam (MediaStore.Downloads, Android 10+). 1 = saved, 0 = failed.
#[no_gc]
fn camera_save_doc(data: u64, n: usize, name: u64, mime: u64) -> i32 {
    var ctx: u64 = 0
    let env: u64 = jni_ctx(&ctx)
    let act: u64 = activity.activity_pointer()
    if env == 0 || ndk.peek32(act + ndk.ACT_SDK_VERSION) < 29 { return 0 }
    let pfd: u64 = mediastore_open(env, ctx, C_DOWNLOADS, S_DOWNLOAD, name, mime, S_W)
    if pfd == 0 { return 0 }
    let pc: u64 = jnicall.j_obj_class(env, pfd)
    let fd: i32 = jnicall.j_int(env, pfd, jnicall.j_method(env, pc, t(N_DETACH), t(G_VI)), 0)
    if fd < 0 { return 0 }
    var off: usize = 0
    while off < n {
        let w: i64 = syscall(1, fd as i64, (data + off as u64) as i64, (n - off) as i64, 0, 0, 0)
        if w <= 0 { break }
        off = off + w as usize
    }
    syscall(3, fd as i64, 0, 0, 0, 0, 0)
    jnicall.j_del(env, pfd)
    if off == n { return 1 }
    return 0
}
