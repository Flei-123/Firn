const B_STILL_TGT: u64 = 88
const B_PREV_REQ: u64 = 96
const B_STATE: u64 = 104      // i32: 0 closed, 1 open, 2 disconnected, 3 device error
const B_ERRCODE: u64 = 108    // i32
const B_READY: u64 = 112      // i32 session ready callbacks
const B_RES_N: u64 = 120      // u64 results stored so far
const B_FAILS: u64 = 128      // u64 failed captures
const B_KIND: u64 = 136       // i32 current session kind, -1 none
const B_CUR: u64 = 140        // i32 index of the open camera
