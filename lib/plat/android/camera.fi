// SPDX-License-Identifier: MPL-2.0
// lib/plat/android/camera.fi -- CAMERA2 FROM FIRN: lenses, preview, JPEG, RAW (for DNG), YUV bursts,
// manual control, focus bracketing, saving to the gallery. For ANY Android device (API 24+).
//
// ================================================================= WHY THE NDK, NOT JAVA
//
// Camera2's Java API needs abstract Java classes as callbacks (CameraDevice.StateCallback, ...), which
// would be classes in classes.dex. The same API exists as a C API (libcamera2ndk + libmediandk, API 24+):
// C function pointers instead of classes, images as raw planes in OUR memory. So everything here is
// plain Firn on top of `extern fn`; Java (via lib/android/jnicall.fi) is used only where the NDK has no
// equivalent: the CAMERA runtime permission and saving into MediaStore.
//
// ================================================================= NOTHING HARD CODED
//
// Every device fact comes from the CameraCharacteristics: which cameras and lenses exist (logical and,
// where the device lists them, physical ids), sizes (largest JPEG / RAW16 / YUV, a preview size of the
// same aspect), ISO and exposure ranges, focus range, hardware level, capabilities (RAW, manual sensor,
// burst). A missing feature is reported (capability bits, size 0, error code), never assumed. Callers
// walk the FALLBACK CHAIN with `camera_best_kind`: RAW_SENSOR -> YUV burst -> single JPEG.
//
// ================================================================= THREADS
//
// All of it is #[no_gc]. The camera HAL calls our callbacks on its own threads: they only write raw
// memory (one mmap block, G_P). Public functions run on the program's thread. Images are POLLED
// (AImageReader_acquireNextImage), so no image listener is needed.
//
//   perm = camera.camera_permission()                // 1 granted
//   n    = camera.camera_scan()                      // lenses (logical + physical ids)
//   camera.camera_info(i, &info)                     // everything the API knows about lens i
//   camera.camera_open(i)  ->  camera.camera_start(KIND_JPEG | KIND_RAW | KIND_YUV)
//   camera.camera_preview_bgrx(buf, w, h, rot)       // frames for window.image (CPU, slow: fallback only)
//   camera.camera_preview_acquire(&pf) / camera_preview_release(&pf)   // newest YUV frame as planes, for the GPU
//                                                    // preview (lib/gpu/campreview.fi: YUV->RGB, rotation, cover)
//   camera.camera_set_manual(exp_ns, iso, focus_d) / camera.camera_set_auto()
//   camera.camera_focus_at(nx, ny, mirror, ae) / camera_focus_clear() / camera_focus_state()   // tap to focus (AF + AE regions)
//   camera.camera_set_zoom(z) / camera_zoom_to(z) / camera_zoom_factor()   // zoom ratio, lens choice by zoom
//   camera.camera_set_flash(FLASH_OFF|AUTO|ON|TORCH) / camera_flash_prepare()   // flash for stills, torch for the preview
//   camera.camera_capture(n, exp_list, focus_list, iso, out, cap, frames)   // the one capture function
//   camera.camera_save(data, n, name, mime)          // MediaStore (Pictures/FirnCam)
import android.ndk
import android.jnicall
import android.activity
import photo.meta
import plat.android.dngwrite
import plat.android.focusplan

export {
    CamInfo, FrameInfo,
    KIND_JPEG, KIND_RAW, KIND_YUV, KIND_VIDEO,
    CAP_RAW, CAP_MANUAL_SENSOR, CAP_BURST, CAP_LOGICAL, CAP_MANUAL_POST, CAP_READ_SETTINGS,
    CAP_MANUAL_FOCUS, CAP_OIS, CAP_FLASH,
    E_OK, E_PERMISSION, E_NO_CAMERA, E_OPEN, E_SESSION, E_STREAM, E_TIMEOUT, E_UNSUPPORTED, E_STATE, E_SPACE,
    camera_permission, camera_request_permission, camera_scan, camera_info, camera_meta,
    camera_open, camera_close, camera_force_physical, camera_start, camera_is_open, camera_kind,
    zero_frame, sizeof_frame, frame_at,
    camera_preview_bgrx, PreviewFrame, preview_frame_new, camera_preview_acquire, camera_preview_release,
    camera_sensor_rotation, camera_is_front, camera_set_auto, camera_set_manual, camera_lock, camera_stream_size,
    camera_best_kind, camera_capture, camera_save, camera_alloc, camera_free,
    focus_plan, focus_converged, camera_dng_extra, camera_last_slot, camera_error_text, zero_info,
    camera_open_gallery, camera_video_start, camera_video_stop, camera_video_active, camera_save_doc,
    FOCUS_IDLE, FOCUS_SCANNING, FOCUS_FOCUSED, FOCUS_FAILED, FLASH_OFF, FLASH_AUTO, FLASH_ON, FLASH_TORCH,
    camera_focus_at, camera_focus_clear, camera_focus_state, camera_focus_active, camera_af_state_raw, camera_ae_state_raw, camera_result_count, camera_fail_count,
    camera_zoom_range, camera_get_zoom, camera_applied_zoom, camera_set_zoom, camera_zoom_lens, camera_zoom_to, camera_zoom_factor,
    camera_set_flash, camera_flash_mode, camera_flash_prepare,
}

const KIND_JPEG: i32 = 0
const KIND_RAW: i32 = 1
const KIND_YUV: i32 = 2
const KIND_VIDEO: i32 = 3   // preview + MediaRecorder surface (camera_video_start), no still stream

const CAP_RAW: u32 = 1
const CAP_MANUAL_SENSOR: u32 = 2
const CAP_BURST: u32 = 4
const CAP_LOGICAL: u32 = 8
const CAP_MANUAL_POST: u32 = 16
const CAP_READ_SETTINGS: u32 = 32
const CAP_MANUAL_FOCUS: u32 = 64
const CAP_OIS: u32 = 128
const CAP_FLASH: u32 = 256

// camera_focus_state()
const FOCUS_IDLE: i32 = 0      // no tap focus and the continuous AF has nothing to report
const FOCUS_SCANNING: i32 = 1
const FOCUS_FOCUSED: i32 = 2
const FOCUS_FAILED: i32 = 3
// camera_set_flash()
const FLASH_OFF: i32 = 0
const FLASH_AUTO: i32 = 1      // stills: flash when the scene is dark (single shots only; bursts never fire it)
const FLASH_ON: i32 = 2        // stills: always flash (single shots only)
const FLASH_TORCH: i32 = 3     // continuous light for preview, stills and video

const E_OK: i32 = 0
const E_PERMISSION: i32 = 1
const E_NO_CAMERA: i32 = 2
const E_OPEN: i32 = 3
const E_SESSION: i32 = 4
const E_STREAM: i32 = 5
const E_TIMEOUT: i32 = 6
const E_UNSUPPORTED: i32 = 7
const E_STATE: i32 = 8
const E_SPACE: i32 = 9

// One lens / camera id as the characteristics describe it.
struct CamInfo {
    index: i32,          // position in the scan list
    parent: i32,         // index of the logical camera that lists this physical id, else -1
    id: [u8; 40],        // zero terminated camera id
    facing: i32,         // 0 front, 1 back, 2 external
    orientation: i32,    // SENSOR_ORIENTATION degrees (rotate the sensor image clockwise to be upright)
    hw_level: i32,       // 0 limited, 1 full, 2 legacy, 3 level 3, 4 external
    caps: u32,           // CAP_* bits
    focal_mm: f32,       // first (usually only) focal length
    focal_count: i32,
    equiv_mm: f32,       // 35 mm equivalent of focal_mm (0 = unknown)
    aperture: f32,       // f number, 0 = unknown
    sensor_w_mm: f32,
    sensor_h_mm: f32,
    active_w: i32,
    active_h: i32,
    iso_min: i32,
    iso_max: i32,
    exp_min_ns: i64,
    exp_max_ns: i64,
    min_focus_d: f32,    // nearest focus in diopters, 0 = fixed focus (no manual focus)
    hyperfocal_d: f32,
    focus_calib: i32,    // 0 uncalibrated, 1 approximate, 2 calibrated
    jpeg_w: i32,
    jpeg_h: i32,
    raw_w: i32,
    raw_h: i32,
    yuv_w: i32,          // largest YUV_420_888 not above YUV_MAX_PIXELS
    yuv_h: i32,
    prev_w: i32,
    prev_h: i32,
    stabilisation: i32,  // lens optical stabilisation available
    has_af: bool,
    ae_comp_min: i32,
    ae_comp_max: i32,
    ae_comp_step: f32,
    vid_w: i32,          // largest recorder (PRIVATE) size up to ~1080p, 16:9 preferred; 0 = no video
    vid_h: i32,
}

// One captured frame inside the caller's buffer.
struct FrameInfo {
    kind: i32,           // KIND_*
    w: i32,
    h: i32,
    offset: usize,       // where the pixels start in `out`
    size: usize,         // octets: JPEG bytes, w*h*2 (RAW16 LE, no padding) or w*h*3/2 (I420: Y, U, V)
    timestamp: i64,
    exposure_ns: i64,
    iso: i32,
    focus_cmd: f32,      // requested focus (diopters), -1 = not set
    focus_res: f32,      // focus reported by the result, -1 = unknown
    lens_state: i32,     // 0 stationary, 1 moving, -1 unknown
    slot: i32,           // result slot (camera_dng_extra / camera_meta use it)
    have_result: bool,
}

