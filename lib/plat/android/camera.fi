const TBL_MAX: u64 = 64

const YUV_MAX_PIXELS: i64 = 13000000
const PREVIEW_MAX_PIXELS: i64 = 1000000

static mut G_P: u64 = 0

#[no_gc]
fn t(i: usize) -> u64 {
    return ((&TXT[0]) as u64) + i as u64
}

#[no_gc]
fn log(i: usize) {
    ndk.log_write(ndk.LOG_INFO, t(S_TAG), t(i))
}

#[no_gc]
fn block() -> u64 {
    if G_P == 0 {
        let r: i64 = syscall(9, 0, B_SIZE as i64, 3, 34, -1, 0)
        if r > 0 {
            G_P = r as u64
        }
    }
    return G_P
}

// A large buffer for frames (anonymous mmap, zeroed by the kernel). 0 = no memory.
#[no_gc]
fn camera_alloc(n: usize) -> u64 {
    let r: i64 = syscall(9, 0, n as i64, 3, 34, -1, 0)
    if r > 0 {
        return r as u64
    }
    return 0
}

#[no_gc]
fn camera_free(p: u64, n: usize) {
    if p != 0 {
        let r: i64 = syscall(11, p as i64, n as i64, 0, 0, 0, 0)
    }
}

#[no_gc]
fn wait_ms(ms: u32) {
    let r: i32 = usleep(ms * 1000)
}

#[no_gc]
fn rd32(p: u64) -> i32 { return *(p as *mut i32) }
#[no_gc]
fn rdu32(p: u64) -> u32 { return *(p as *mut u32) }
#[no_gc]
fn rd64(p: u64) -> i64 { return *(p as *mut i64) }
#[no_gc]
fn rdf(p: u64) -> f32 { return *(p as *mut f32) }
#[no_gc]
fn rdd(p: u64) -> f64 { return *(p as *mut f64) }
#[no_gc]
fn rd8(p: u64) -> u32 { return (*(p as *mut u8)) as u32 }
#[no_gc]
fn wr8(p: u64, v: u32) { *(p as *mut u8) = v as u8 }
#[no_gc]
fn wr32(p: u64, v: i32) { *(p as *mut i32) = v }
#[no_gc]
fn wr64(p: u64, v: i64) { *(p as *mut i64) = v }
#[no_gc]
fn wrf(p: u64, v: f32) { *(p as *mut f32) = v }

#[no_gc]
fn length(p: u64) -> usize {
    var n: usize = 0
    while *((p + n as u64) as *mut u8) != 0 as u8 {
        n = n + 1
    }
    return n
}

#[no_gc]
fn copy(z: u64, q: u64, n: usize) {
    var i: usize = 0
    while i < n {
        *((z + i as u64) as *mut u8) = *((q + i as u64) as *mut u8)
        i = i + 1
    }
}

// copy a zero terminated string of at most cap-1 octets
#[no_gc]
fn copy_str(z: u64, q: u64, cap: usize) {
    var n: usize = length(q)
    if n > cap - 1 {
        n = cap - 1
    }
    copy(z, q, n)
    *((z + n as u64) as *mut u8) = 0 as u8
}

// ---- a metadata entry: tag@0 u32, type@4 u8, count@8 u32, data@16 pointer (24 octets)
#[no_gc]
fn md_get(md: u64, tag: u32, e: u64) -> bool {
    if md == 0 {
        return false
    }
    if ACameraMetadata_getConstEntry(md, tag, e) != 0 {
        return false
    }
    return rdu32(e + 8) > 0 as u32
}

#[no_gc]
fn e_count(e: u64) -> usize { return rdu32(e + 8) as usize }
#[no_gc]
fn e_data(e: u64) -> u64 { return *((e + 16) as *mut u64) }

// first value of an i32 / u8 / f32 / i64 entry, or `dflt`
#[no_gc]
fn md_i32(md: u64, tag: u32, dflt: i32) -> i32 {
    let e: u64 = block() + B_SCRATCH
    if !md_get(md, tag, e) { return dflt }
    return rd32(e_data(e))
}

#[no_gc]
fn md_u8(md: u64, tag: u32, dflt: i32) -> i32 {
    let e: u64 = block() + B_SCRATCH
    if !md_get(md, tag, e) { return dflt }
    return rd8(e_data(e)) as i32
}

#[no_gc]
fn md_f32(md: u64, tag: u32, dflt: f32) -> f32 {
    let e: u64 = block() + B_SCRATCH
    if !md_get(md, tag, e) { return dflt }
    return rdf(e_data(e))
}

#[no_gc]
fn md_has_u8(md: u64, tag: u32, v: i32) -> bool {
    let e: u64 = block() + B_SCRATCH
    if !md_get(md, tag, e) { return false }
    let n: usize = e_count(e)
    let p: u64 = e_data(e)
    var i: usize = 0
    while i < n {
        if rd8(p + i as u64) as i32 == v { return true }
        i = i + 1
    }
    return false
}

#[no_gc]
fn md_has_i32(md: u64, tag: u32, v: i32) -> bool {
    let e: u64 = block() + B_SCRATCH
    if !md_get(md, tag, e) { return false }
    let n: usize = e_count(e)
    let p: u64 = e_data(e)
    var i: usize = 0
    while i < n {
        if rd32(p + (i * 4) as u64) == v { return true }
        i = i + 1
    }
    return false
}

// characteristics of camera id (zero terminated); 0 = failed. Free with ACameraMetadata_free.
#[no_gc]
fn chars_of(id: u64) -> u64 {
    let b: u64 = block()
    if b == 0 { return 0 }
    let mgr: u64 = manager()
    if mgr == 0 { return 0 }
    let out: u64 = b + B_SCRATCH + 64
    wr64(out, 0)
    if ACameraManager_getCameraCharacteristics(mgr, id, out) != 0 {
        return 0
    }
    return *(out as *mut u64)
}

#[no_gc]
fn manager() -> u64 {
    let b: u64 = block()
    if b == 0 { return 0 }
    var m: u64 = *((b + B_MGR) as *mut u64)
    if m == 0 {
        m = ACameraManager_create()
        *((b + B_MGR) as *mut u64) = m
    }
    return m
}

#[no_gc]
fn tbl_id(i: i32) -> u64 {
    return block() + TBL_BASE + (i as u64) * TBL_SLOT
}

// ------------------------------------------------------------ permission
#[no_gc]
fn jni_ctx(ctx_out: *mut u64) -> u64 {
    let act: u64 = activity.activity_pointer()
    if act == 0 {
        return 0
    }
    *ctx_out = ndk.peek64(act + 24)
    return jnicall.j_env(ndk.peek64(act + 8))
}

// 1 granted, 0 not (yet) granted, -1 no activity / JNI.
#[no_gc]
fn camera_permission() -> i32 {
    var ctx: u64 = 0
    let env: u64 = jni_ctx(&ctx)
    if env == 0 { return 0 - 1 }
    let b: u64 = block()
    let act: u64 = activity.activity_pointer()
    wr32(b + B_SDK, ndk.peek32(act + ndk.ACT_SDK_VERSION))
    if ndk.peek32(act + ndk.ACT_SDK_VERSION) < 23 { return 1 }
    let cc: u64 = jnicall.j_obj_class(env, ctx)
    let ps: u64 = jnicall.j_str(env, t(S_PERM_CAMERA))
    var a: [u64; 2] = [0; 2]
    a[0] = ps
    let g: i32 = jnicall.j_int(env, ctx,
        jnicall.j_method(env, cc, t(N_CHECK_PERM), t(G_CHECK_PERM)), (&a[0]) as u64)
    jnicall.j_del(env, ps)
    jnicall.j_del(env, cc)
    if g == 0 { return 1 }
    return 0
}

// Asks the system dialog for the CAMERA permission (asynchronous: poll camera_permission()).
#[no_gc]
fn camera_request_permission() -> bool {
    var ctx: u64 = 0
    let env: u64 = jni_ctx(&ctx)
    if env == 0 { return false }
    let cc: u64 = jnicall.j_obj_class(env, ctx)
    let ps: u64 = jnicall.j_str(env, t(S_PERM_CAMERA))
    let sc: u64 = jnicall.j_class(env, t(C_STRING))
    let arr: u64 = jnicall.j_array1(env, sc, ps)
    var a: [u64; 2] = [0; 2]
    a[0] = arr
    a[1] = 21
    let ok: bool = jnicall.j_void(env, ctx,
        jnicall.j_method(env, cc, t(N_REQ_PERM), t(G_REQ_PERM)), (&a[0]) as u64)
    jnicall.j_del(env, arr)
    jnicall.j_del(env, sc)
    jnicall.j_del(env, ps)
    jnicall.j_del(env, cc)
    return ok
}

// ------------------------------------------------------------ scanning lenses
// Lists the camera ids (logical ones first, then the physical ids a logical camera names that are not
// listed on their own). Returns the number of entries, 0 when there is no camera or no permission.
#[no_gc]
fn camera_scan() -> i32 {
    let b: u64 = block()
    let mgr: u64 = manager()
    if b == 0 || mgr == 0 { return 0 }
    let lp: u64 = b + B_SCRATCH + 128
    wr64(lp, 0)
    if ACameraManager_getCameraIdList(mgr, lp) != 0 { return 0 }
    let list: u64 = *(lp as *mut u64)
    if list == 0 { return 0 }
    var n: i32 = rd32(list)
    let ids: u64 = *((list + 8) as *mut u64)
    var count: i32 = 0
    var i: i32 = 0
    while i < n && (count as u64) < TBL_MAX {
        let id: u64 = *((ids + (i as u64) * 8) as *mut u64)
        copy_str(tbl_id(count), id, 40)
        wr32(tbl_id(count) + 40, 0 - 1)
        count = count + 1
        i = i + 1
    }
    // physical ids of logical multi cameras
    let logical: i32 = count
    i = 0
    while i < logical {
        let md: u64 = chars_of(tbl_id(i))
        if md != 0 {
            let e: u64 = b + B_SCRATCH
            if md_get(md, T_PHYSICAL_IDS, e) {
                let total: usize = e_count(e)
                let p: u64 = e_data(e)
                var at: usize = 0
                while at < total {
                    let pid: u64 = p + at as u64
                    let plen: usize = length(pid)
                    if plen == 0 { break }
                    var known: bool = false
                    var k: i32 = 0
                    while k < count {
                        if same(tbl_id(k), pid) { known = true }
                        k = k + 1
                    }
                    if !known && (count as u64) < TBL_MAX {
                        copy_str(tbl_id(count), pid, 40)
                        wr32(tbl_id(count) + 40, i)
                        count = count + 1
                    }
                    at = at + plen + 1
                }
            }
            ACameraMetadata_free(md)
        }
        i = i + 1
    }
    ACameraManager_deleteCameraIdList(list)
    wr32(b + B_SCAN_N, count)
    return count
}

#[no_gc]
fn same(a: u64, b: u64) -> bool {
    var i: usize = 0
    while true {
        let x: u32 = rd8(a + i as u64)
        let y: u32 = rd8(b + i as u64)
        if x != y { return false }
        if x == 0 as u32 { return true }
        i = i + 1
    }
    return true
}

// Largest output size of `format` whose pixel count is <= max_px (0 = no limit). prefer_aspect > 0:
// among the sizes of that aspect (+-3 %) first. Writes w, h (0 when none).
#[no_gc]
fn best_size(md: u64, format: i32, max_px: i64, aspect: f32, ow: *mut i32, oh: *mut i32) {
    *ow = 0
    *oh = 0
    let e: u64 = block() + B_SCRATCH
    if !md_get(md, T_SCALER_STREAM_CONFIGS, e) { return }
    let n: usize = e_count(e) / 4
    let p: u64 = e_data(e)
    var best: i64 = 0
    var best_match: bool = false
    var i: usize = 0
    while i < n {
        let q: u64 = p + (i * 16) as u64
        let f: i32 = rd32(q)
        let w: i32 = rd32(q + 4)
        let h: i32 = rd32(q + 8)
        let is_in: i32 = rd32(q + 12)
        if f == format && is_in == 0 && w > 0 && h > 0 {
            let px: i64 = (w as i64) * (h as i64)
            if max_px == 0 || px <= max_px {
                var fits: bool = true
                if aspect > 0.0f {
                    var ar: f32 = (w as f32) / (h as f32)
                    var d: f32 = ar / aspect
                    if d < 1.0f { d = 1.0f / d }
                    fits = d < 1.03f
                }
                var better: bool = false
                if fits && !best_match { better = true }
                if fits == best_match && px > best { better = true }
                if better {
                    best = px
                    best_match = fits
                    *ow = w
                    *oh = h
                }
            }
        }
        i = i + 1
    }
}

#[no_gc]
fn str_set(dst: u64, src: u64, cap: usize) {
    copy_str(dst, src, cap)
}

// Fills everything the characteristics tell about entry `index`. False when the id cannot be read.
#[no_gc]
fn camera_info(index: i32, c: *mut CamInfo) -> bool {
    let b: u64 = block()
    if b == 0 || index < 0 || index >= rd32(b + B_SCAN_N) { return false }
    let id: u64 = tbl_id(index)
    let md: u64 = chars_of(id)
    if md == 0 { return false }
    let e: u64 = b + B_SCRATCH
    (*c).index = index
    (*c).parent = rd32(id + 40)
    str_set((&(*c).id[0]) as u64, id, 40)
    (*c).facing = md_u8(md, T_LENS_FACING, 1)
    (*c).orientation = md_i32(md, T_SENSOR_ORIENTATION, 0)
    (*c).hw_level = md_u8(md, T_INFO_HW_LEVEL, 2)
    var caps: u32 = 0
    if md_has_u8(md, T_REQUEST_CAPS, 3) { caps = caps | CAP_RAW }
    if md_has_u8(md, T_REQUEST_CAPS, 1) { caps = caps | CAP_MANUAL_SENSOR }
    if md_has_u8(md, T_REQUEST_CAPS, 6) { caps = caps | CAP_BURST }
    if md_has_u8(md, T_REQUEST_CAPS, 11) { caps = caps | CAP_LOGICAL }
    if md_has_u8(md, T_REQUEST_CAPS, 2) { caps = caps | CAP_MANUAL_POST }
    if md_has_u8(md, T_REQUEST_CAPS, 5) { caps = caps | CAP_READ_SETTINGS }
    (*c).focal_count = 0
    (*c).focal_mm = 0.0f
    if md_get(md, T_LENS_INFO_FOCAL_LENGTHS, e) {
        (*c).focal_mm = rdf(e_data(e))
        (*c).focal_count = e_count(e) as i32
    }
    (*c).aperture = 0.0f
    if md_get(md, T_LENS_INFO_APERTURES, e) {
        (*c).aperture = rdf(e_data(e))
    }
    (*c).sensor_w_mm = 0.0f
    (*c).sensor_h_mm = 0.0f
    if md_get(md, T_SENSOR_INFO_PHYS_SIZE, e) {
        (*c).sensor_w_mm = rdf(e_data(e))
        (*c).sensor_h_mm = rdf(e_data(e) + 4)
    }
    (*c).equiv_mm = 0.0f
    if (*c).sensor_w_mm > 0.0f && (*c).focal_mm > 0.0f {
        let diag: f32 = sqrt_f((*c).sensor_w_mm * (*c).sensor_w_mm + (*c).sensor_h_mm * (*c).sensor_h_mm)
        if diag > 0.0f {
            (*c).equiv_mm = (*c).focal_mm * 43.27f / diag
        }
    }
    (*c).active_w = 0
    (*c).active_h = 0
    if md_get(md, T_SENSOR_INFO_ACTIVE, e) {
        (*c).active_w = rd32(e_data(e) + 8)
        (*c).active_h = rd32(e_data(e) + 12)
    }
    (*c).iso_min = 0
    (*c).iso_max = 0
    if md_get(md, T_SENSOR_INFO_ISO_RANGE, e) {
        (*c).iso_min = rd32(e_data(e))
        (*c).iso_max = rd32(e_data(e) + 4)
    }
    (*c).exp_min_ns = 0
    (*c).exp_max_ns = 0
    if md_get(md, T_SENSOR_INFO_EXP_RANGE, e) {
        (*c).exp_min_ns = rd64(e_data(e))
        (*c).exp_max_ns = rd64(e_data(e) + 8)
    }
    (*c).min_focus_d = md_f32(md, T_LENS_INFO_MIN_FOCUS, 0.0f)
    (*c).hyperfocal_d = md_f32(md, T_LENS_INFO_HYPERFOCAL, 0.0f)
    (*c).focus_calib = md_u8(md, T_LENS_INFO_FOCUS_CALIB, 0)
    if (*c).min_focus_d > 0.0f { caps = caps | CAP_MANUAL_FOCUS }
    (*c).stabilisation = 0
    if md_has_u8(md, T_LENS_INFO_OIS, 1) {
        (*c).stabilisation = 1
        caps = caps | CAP_OIS
    }
    if md_u8(md, T_FLASH_INFO_AVAILABLE, 0) != 0 { caps = caps | CAP_FLASH }
    (*c).caps = caps
    (*c).has_af = md_has_u8(md, T_CONTROL_AF_AVAILABLE, 4) || md_has_u8(md, T_CONTROL_AF_AVAILABLE, 1)
    (*c).ae_comp_min = 0
    (*c).ae_comp_max = 0
    if md_get(md, T_CONTROL_AE_COMP_RANGE, e) {
        (*c).ae_comp_min = rd32(e_data(e))
        (*c).ae_comp_max = rd32(e_data(e) + 4)
    }
    (*c).ae_comp_step = 0.0f
    if md_get(md, T_CONTROL_AE_COMP_STEP, e) {
        (*c).ae_comp_step = (rd32(e_data(e)) as f32) / (rd32(e_data(e) + 4) as f32)
    }
    var w: i32 = 0
    var h: i32 = 0
    best_size(md, 256, 0, 0.0f, &w, &h)
    (*c).jpeg_w = w
    (*c).jpeg_h = h
    best_size(md, 32, 0, 0.0f, &w, &h)
    (*c).raw_w = w
    (*c).raw_h = h
    var asp: f32 = 0.0f
    if (*c).jpeg_h > 0 { asp = ((*c).jpeg_w as f32) / ((*c).jpeg_h as f32) }
    best_size(md, 35, YUV_MAX_PIXELS, asp, &w, &h)
    (*c).yuv_w = w
    (*c).yuv_h = h
    best_size(md, 35, PREVIEW_MAX_PIXELS, asp, &w, &h)
    (*c).prev_w = w
    (*c).prev_h = h
    ACameraMetadata_free(md)
    return true
}

// Square root by Newton steps (no libm needed in #[no_gc] code).
#[no_gc]
fn sqrt_f(x: f32) -> f32 {
    if x <= 0.0f { return 0.0f }
    var g: f32 = x
    if g < 1.0f { g = 1.0f }
    var i: i32 = 0
    while i < 24 {
        g = 0.5f * (g + x / g)
        i = i + 1
    }
    return g
}

// The best capture path this lens supports: RAW_SENSOR -> YUV burst -> single JPEG.
#[no_gc]
fn camera_best_kind(c: *mut CamInfo) -> i32 {
    if ((*c).caps & CAP_RAW) != 0 as u32 && (*c).raw_w > 0 { return KIND_RAW }
    if (*c).yuv_w > 0 && (((*c).caps & CAP_BURST) != 0 as u32 || (*c).hw_level != 2) { return KIND_YUV }
    return KIND_JPEG
}

#[no_gc]
fn camera_error_text(code: i32) -> u64 {
    if code == E_OK { return t(X_OK) }
    if code == E_PERMISSION { return t(X_PERMISSION) }
    if code == E_NO_CAMERA { return t(X_NO_CAMERA) }
    if code == E_OPEN { return t(X_OPEN) }
    if code == E_SESSION { return t(X_SESSION) }
    if code == E_STREAM { return t(X_STREAM) }
    if code == E_TIMEOUT { return t(X_TIMEOUT) }
    if code == E_UNSUPPORTED { return t(X_UNSUPPORTED) }
    if code == E_SPACE { return t(X_SPACE) }
    return t(X_STATE)
}

// ------------------------------------------------------------ callbacks (HAL threads: raw memory only)
struct HolderQ { f: fn(u64, u64, u64, u64) }

#[no_gc]
fn code_of_q(f: fn(u64, u64, u64, u64)) -> u64 {
    var roh: [u64; 1] = [0; 1]
    let h: *mut HolderQ = (&roh[0]) as *mut HolderQ
    (*h).f = f
    return ndk.peek64(roh[0])
}

#[no_gc]
fn cb_noop(a: u64, b: u64, c: u64, d: u64) {
}

#[no_gc]
fn cb_disconnected(ctx: u64, dev: u64, c: u64, d: u64) {
    wr32(G_P + B_STATE, 2)
}

#[no_gc]
fn cb_error(ctx: u64, dev: u64, err: u64, d: u64) {
    wr32(G_P + B_STATE, 3)
    wr32(G_P + B_ERRCODE, (err & 4294967295) as i32)
}

#[no_gc]
fn cb_ready(ctx: u64, sess: u64, c: u64, d: u64) {
    wr32(G_P + B_READY, rd32(G_P + B_READY) + 1)
}

#[no_gc]
fn cb_failed(ctx: u64, sess: u64, req: u64, fail: u64) {
    *((G_P + B_FAILS) as *mut u64) = *((G_P + B_FAILS) as *mut u64) + 1
}

// A result: copy what a frame needs into the next ring slot. The slot's timestamp is written LAST,
// so a reader that finds a timestamp finds a complete slot.
#[no_gc]
fn cb_completed(ctx: u64, sess: u64, req: u64, md: u64) {
    let b: u64 = G_P
    if b == 0 || md == 0 { return }
    let n: u64 = *((b + B_RES_N) as *mut u64)
    let s: u64 = b + RES_BASE + (n % RES_COUNT) * RES_SLOT
    let e: u64 = b + B_SCRATCH + 256
    wr64(s, 0)
    var flags: u32 = 0
    wr64(s + 8, 0)
    if md_get(md, T_SENSOR_EXPOSURE_TIME, e) { wr64(s + 8, rd64(e_data(e))) ; flags = flags | 1 as u32 }
    wr32(s + 16, 0)
    if md_get(md, T_SENSOR_SENSITIVITY, e) { wr32(s + 16, rd32(e_data(e))) ; flags = flags | 2 as u32 }
    wr32(s + 20, 0 - 1)
    if md_get(md, T_LENS_STATE, e) { wr32(s + 20, rd8(e_data(e)) as i32) }
    wrf(s + 24, 0.0f - 1.0f)
    if md_get(md, T_LENS_FOCUS_DISTANCE, e) { wrf(s + 24, rdf(e_data(e))) ; flags = flags | 4 as u32 }
    wrf(s + 28, 0.0f)
    if md_get(md, T_LENS_FOCAL_LENGTH, e) { wrf(s + 28, rdf(e_data(e))) }
    wrf(s + 32, 0.0f)
    if md_get(md, T_LENS_APERTURE, e) { wrf(s + 32, rdf(e_data(e))) }
    var i: usize = 0
    if md_get(md, T_COLOR_GAINS, e) && e_count(e) >= 4 {
        while i < 4 {
            wrf(s + 40 + (i * 4) as u64, rdf(e_data(e) + (i * 4) as u64))
            i = i + 1
        }
        flags = flags | 8 as u32
    }
    if md_get(md, T_SENSOR_NEUTRAL, e) && e_count(e) >= 3 {
        i = 0
        while i < 3 {
            let num: i32 = rd32(e_data(e) + (i * 8) as u64)
            let den: i32 = rd32(e_data(e) + (i * 8) as u64 + 4)
            var v: f32 = 1.0f
            if den != 0 { v = (num as f32) / (den as f32) }
            wrf(s + 56 + (i * 4) as u64, v)
            i = i + 1
        }
        flags = flags | 16 as u32
    }
    if md_get(md, T_SENSOR_NOISE_PROFILE, e) && e_count(e) >= 2 {
        let cnt: usize = e_count(e)
        i = 0
        while i < 8 {
            var src: usize = i
            if src >= cnt { src = i % 2 }
            *((s + 72 + (i * 8) as u64) as *mut f64) = rdd(e_data(e) + (src * 8) as u64)
            i = i + 1
        }
        flags = flags | 32 as u32
    }
    *((s + 36) as *mut u32) = flags
    var ts: i64 = 1
    if md_get(md, T_SENSOR_TIMESTAMP, e) { ts = rd64(e_data(e)) }
    wr64(s, ts)
    *((b + B_RES_N) as *mut u64) = n + 1
}

// ------------------------------------------------------------ open / close
#[no_gc]
fn camera_is_open() -> bool {
    let b: u64 = block()
    return b != 0 && rd32(b + B_STATE) == 1 && *((b + B_DEV) as *mut u64) != 0
}

#[no_gc]
fn camera_kind() -> i32 {
    return rd32(block() + B_KIND)
}

// Opens lens `index` of the last camera_scan (a physical id opens its logical camera and streams from
// that physical camera where the device allows it). Returns E_OK or an E_* code.
#[no_gc]
fn camera_open(index: i32) -> i32 {
    let b: u64 = block()
    let mgr: u64 = manager()
    if b == 0 || mgr == 0 { return E_STATE }
    if index < 0 || index >= rd32(b + B_SCAN_N) { return E_NO_CAMERA }
    if camera_permission() == 0 { return E_PERMISSION }
    camera_close()
    var open_id: u64 = tbl_id(index)
    wr8(b + B_PHYS_ID, 0 as u32)
    wr64(b + B_PHYS_FN, 0)
    let parent: i32 = rd32(open_id + 40)
    if parent >= 0 {
        // a physical id: open the logical camera, stream from this one
        copy_str(b + B_PHYS_ID, open_id, 40)
        open_id = tbl_id(parent)
        let h: u64 = dlopen(t(S_LIBCAM), 2)
        if h != 0 {
            wr64(b + B_PHYS_FN, dlsym(h, t(S_PHYS_FN)) as i64)
        }
        if rd64(b + B_PHYS_FN) == 0 {
            return E_UNSUPPORTED
        }
    }
    copy_str(b + B_ID, open_id, 40)
    // callbacks
    *((b + CB_DEV) as *mut u64) = 0
    *((b + CB_DEV + 8) as *mut u64) = code_of_q(cb_disconnected)
    *((b + CB_DEV + 16) as *mut u64) = code_of_q(cb_error)
    wr32(b + B_STATE, 0)
    wr32(b + B_ERRCODE, 0)
    let dp: u64 = b + B_SCRATCH + 192
    wr64(dp, 0)
    let st: i32 = ACameraManager_openCamera(mgr, open_id, b + CB_DEV, dp)
    if st != 0 || *(dp as *mut u64) == 0 {
        ndk.log_write(ndk.LOG_WARN, t(S_TAG), t(L_OPEN_FAILED))
        return E_OPEN
    }
    *((b + B_DEV) as *mut u64) = *(dp as *mut u64)
    wr32(b + B_STATE, 1)
    wr32(b + B_CUR, index)
    wr32(b + B_KIND, 0 - 1)
    var ci: CamInfo = zero_info()
    if camera_info(index, &ci) {
        wr32(b + B_ROT, ci.orientation)
        *((b + B_CAPS) as *mut u32) = ci.caps
        wr32(b + B_S_W, 0)
        wr32(b + B_P_W, ci.prev_w)
        wr32(b + B_P_H, ci.prev_h)
    }
    let md: u64 = chars_of(open_id)
    if md != 0 {
        wr32(b + B_AF_CONT, if_i(md_has_u8(md, T_CONTROL_AF_AVAILABLE, 4)))
        wr32(b + B_NR_MIN, if_i(md_has_u8(md, T_NR_AVAILABLE, 3)))
        ACameraMetadata_free(md)
    }
    ndk.log_write(ndk.LOG_INFO, t(S_TAG), t(L_OPENED))
    return E_OK
}

#[no_gc]
fn if_i(v: bool) -> i32 {
    if v { return 1 }
    return 0
}

#[no_gc]
fn zero_info() -> CamInfo {
    return CamInfo {
        index: 0, parent: 0 - 1, id: [0 as u8; 40], facing: 0, orientation: 0, hw_level: 0, caps: 0 as u32,
        focal_mm: 0.0f, focal_count: 0, equiv_mm: 0.0f, aperture: 0.0f, sensor_w_mm: 0.0f, sensor_h_mm: 0.0f,
        active_w: 0, active_h: 0, iso_min: 0, iso_max: 0, exp_min_ns: 0, exp_max_ns: 0,
        min_focus_d: 0.0f, hyperfocal_d: 0.0f, focus_calib: 0, jpeg_w: 0, jpeg_h: 0, raw_w: 0, raw_h: 0,
        yuv_w: 0, yuv_h: 0, prev_w: 0, prev_h: 0, stabilisation: 0, has_af: false,
        ae_comp_min: 0, ae_comp_max: 0, ae_comp_step: 0.0f,
    }
}

#[no_gc]
fn free_reader(b: u64, rd: u64, win: u64, out: u64, tgt: u64) {
    let o: u64 = *((b + out) as *mut u64)
    let t2: u64 = *((b + tgt) as *mut u64)
    if t2 != 0 { ACameraOutputTarget_free(t2) }
    if o != 0 { ACaptureSessionOutput_free(o) }
    let r: u64 = *((b + rd) as *mut u64)
    if r != 0 { AImageReader_delete(r) }
    *((b + rd) as *mut u64) = 0
    *((b + win) as *mut u64) = 0
    *((b + out) as *mut u64) = 0
    *((b + tgt) as *mut u64) = 0
}

#[no_gc]
fn close_session() {
    let b: u64 = block()
    if b == 0 { return }
    let s: u64 = *((b + B_SESS) as *mut u64)
    if s != 0 {
        let r1: i32 = ACameraCaptureSession_stopRepeating(s)
        let r2: i32 = ACameraCaptureSession_abortCaptures(s)
        ACameraCaptureSession_close(s)
        *((b + B_SESS) as *mut u64) = 0
        wait_ms(50)
    }
    let rq: u64 = *((b + B_PREV_REQ) as *mut u64)
    if rq != 0 {
        ACaptureRequest_free(rq)
        *((b + B_PREV_REQ) as *mut u64) = 0
    }
    let c: u64 = *((b + B_CONT) as *mut u64)
    if c != 0 {
        ACaptureSessionOutputContainer_free(c)
        *((b + B_CONT) as *mut u64) = 0
    }
    free_reader(b, B_PREV_RD, B_PREV_WIN, B_PREV_OUT, B_PREV_TGT)
    free_reader(b, B_STILL_RD, B_STILL_WIN, B_STILL_OUT, B_STILL_TGT)
    wr32(b + B_KIND, 0 - 1)
}

#[no_gc]
fn camera_close() {
    let b: u64 = block()
    if b == 0 { return }
    close_session()
    let d: u64 = *((b + B_DEV) as *mut u64)
    if d != 0 {
        let r: i32 = ACameraDevice_close(d)
        *((b + B_DEV) as *mut u64) = 0
    }
    wr32(b + B_STATE, 0)
}

// ------------------------------------------------------------ requests
#[no_gc]
fn set_u8(req: u64, tag: u32, v: i32) {
    let p: u64 = G_P + B_SCRATCH + 320
    wr8(p, v as u32)
    let r: i32 = ACaptureRequest_setEntry_u8(req, tag, 1 as u32, p)
}

#[no_gc]
fn set_i32(req: u64, tag: u32, v: i32) {
    let p: u64 = G_P + B_SCRATCH + 328
    wr32(p, v)
    let r: i32 = ACaptureRequest_setEntry_i32(req, tag, 1 as u32, p)
}

#[no_gc]
fn set_i64(req: u64, tag: u32, v: i64) {
    let p: u64 = G_P + B_SCRATCH + 336
    wr64(p, v)
    let r: i32 = ACaptureRequest_setEntry_i64(req, tag, 1 as u32, p)
}

#[no_gc]
fn set_f32(req: u64, tag: u32, v: f32) {
    let p: u64 = G_P + B_SCRATCH + 344
    wrf(p, v)
    let r: i32 = ACaptureRequest_setEntry_float(req, tag, 1 as u32, p)
}

// 3A and manual settings (current parameters, overridden by exp/iso/focus >= 0 when given).
#[no_gc]
fn fill_request(req: u64, still: bool, exp_ns: i64, iso: i32, focus: f32) {
    let b: u64 = G_P
    set_u8(req, T_CONTROL_MODE, 1)
    var manual: bool = rd32(b + B_P_MANUAL) == 1
    var e: i64 = rd64(b + B_P_EXP)
    var s: i32 = rd32(b + B_P_ISO)
    if exp_ns > 0 {
        manual = true
        e = exp_ns
    }
    if iso > 0 { s = iso }
    if manual && (*((b + B_CAPS) as *mut u32) & CAP_MANUAL_SENSOR) != 0 as u32 && e > 0 && s > 0 {
        set_u8(req, T_CONTROL_AE_MODE, 0)
        set_i64(req, T_SENSOR_EXPOSURE_TIME, e)
        set_i32(req, T_SENSOR_SENSITIVITY, s)
        if e > 33000000 {
            set_i64(req, T_SENSOR_FRAME_DURATION, e)
        }
    } else {
        set_u8(req, T_CONTROL_AE_MODE, 1)
        set_u8(req, T_CONTROL_AE_LOCK, if_i(rd32(b + B_P_AELOCK) == 1))
    }
    set_u8(req, T_CONTROL_AWB_MODE, 1)
    var fd: f32 = focus
    var fon: bool = focus >= 0.0f
    if !fon && rd32(b + B_P_FOCUS_ON) == 1 {
        fon = true
        fd = rdf(b + B_P_FOCUS)
    }
    if fon && (*((b + B_CAPS) as *mut u32) & CAP_MANUAL_FOCUS) != 0 as u32 {
        set_u8(req, T_CONTROL_AF_MODE, 0)
        set_f32(req, T_LENS_FOCUS_DISTANCE, fd)
    } else if rd32(b + B_AF_CONT) == 1 && rd32(b + B_P_AFLOCK) == 0 {
        set_u8(req, T_CONTROL_AF_MODE, 4)
    } else {
        set_u8(req, T_CONTROL_AF_MODE, 1)
    }
    if still {
        set_i32(req, T_JPEG_ORIENTATION, rd32(b + B_ROT))
        set_u8(req, T_JPEG_QUALITY, 97)
    }
    if still && rd32(b + B_KIND) == KIND_YUV && rd32(b + B_NR_MIN) == 1 {
        set_u8(req, T_NR_MODE, 3)
    }
}

// (Re)starts the repeating preview with the current parameters (focus < 0 = current setting).
#[no_gc]
fn restart_preview(focus: f32) -> i32 {
    let b: u64 = G_P
    let s: u64 = *((b + B_SESS) as *mut u64)
    let d: u64 = *((b + B_DEV) as *mut u64)
    if s == 0 || d == 0 { return E_STATE }
    let rp: u64 = b + B_SCRATCH + 352
    wr64(rp, 0)
    if ACameraDevice_createCaptureRequest(d, 1, rp) != 0 || *(rp as *mut u64) == 0 { return E_STREAM }
    let req: u64 = *(rp as *mut u64)
    let tg: u64 = *((b + B_PREV_TGT) as *mut u64)
    if ACaptureRequest_addTarget(req, tg) != 0 {
        ACaptureRequest_free(req)
        return E_STREAM
    }
    fill_request(req, false, 0, 0, focus)
    let arr: u64 = b + B_SCRATCH + 360
    wr64(arr, req as i64)
    // capture callbacks collect the results (focus state, exposure, ...)
    let r: i32 = ACameraCaptureSession_setRepeatingRequest(s, b + CB_CAP, 1, arr, 0)
    let old: u64 = *((b + B_PREV_REQ) as *mut u64)
    if old != 0 { ACaptureRequest_free(old) }
    *((b + B_PREV_REQ) as *mut u64) = req
    if r != 0 { return E_STREAM }
    return E_OK
}

#[no_gc]
fn make_stream(b: u64, cont: u64, rd: u64, win: u64, out: u64, tgt: u64, w: i32, h: i32, fmt: i32,
               max_images: i32) -> bool {
    let rp: u64 = b + B_SCRATCH + 400
    wr64(rp, 0)
    if AImageReader_new(w, h, fmt, max_images, rp) != 0 || *(rp as *mut u64) == 0 { return false }
    *((b + rd) as *mut u64) = *(rp as *mut u64)
    wr64(rp, 0)
    if AImageReader_getWindow(*((b + rd) as *mut u64), rp) != 0 { return false }
    let wn: u64 = *(rp as *mut u64)
    *((b + win) as *mut u64) = wn
    wr64(rp, 0)
    let phys: u64 = *((b + B_PHYS_FN) as *mut u64)
    if phys != 0 && rd8(b + B_PHYS_ID) != 0 as u32 {
        let pid: u64 = b + B_PHYS_ID
        if jnicall.ruf4(phys, wn, length(pid) as u64, pid, rp) != 0 as u64 { return false }
    } else {
        if ACaptureSessionOutput_create(wn, rp) != 0 { return false }
    }
    *((b + out) as *mut u64) = *(rp as *mut u64)
    if ACaptureSessionOutputContainer_add(cont, *((b + out) as *mut u64)) != 0 { return false }
    wr64(rp, 0)
    if ACameraOutputTarget_create(wn, rp) != 0 { return false }
    *((b + tgt) as *mut u64) = *(rp as *mut u64)
    return true
}

// Builds the session for `kind`: preview (small YUV) + ONE full size stream (JPEG, RAW16 or YUV), the
// combinations every Camera2 device that has the capability must support. Starts the preview.
// If the full size stream is refused, the session is rebuilt with the next kind down the chain.
#[no_gc]
fn camera_start(kind: i32) -> i32 {
    let b: u64 = block()
    if b == 0 || !camera_is_open() { return E_STATE }
    close_session()
    var ci: CamInfo = zero_info()
    if !camera_info(rd32(b + B_CUR), &ci) { return E_STATE }
    var sw: i32 = ci.jpeg_w
    var sh: i32 = ci.jpeg_h
    var fmt: i32 = 256
    if kind == KIND_RAW {
        sw = ci.raw_w
        sh = ci.raw_h
        fmt = 32
    }
    if kind == KIND_YUV {
        sw = ci.yuv_w
        sh = ci.yuv_h
        fmt = 35
    }
    if sw <= 0 || sh <= 0 || ci.prev_w <= 0 {
        if kind != KIND_JPEG { return camera_start(KIND_JPEG) }
        return E_UNSUPPORTED
    }
    let cp: u64 = b + B_SCRATCH + 440
    wr64(cp, 0)
    if ACaptureSessionOutputContainer_create(cp) != 0 { return E_SESSION }
    let cont: u64 = *(cp as *mut u64)
    *((b + B_CONT) as *mut u64) = cont
    if !make_stream(b, cont, B_PREV_RD, B_PREV_WIN, B_PREV_OUT, B_PREV_TGT, ci.prev_w, ci.prev_h, 35, 4) {
        close_session()
        return E_STREAM
    }
    if !make_stream(b, cont, B_STILL_RD, B_STILL_WIN, B_STILL_OUT, B_STILL_TGT, sw, sh, fmt, 6) {
        close_session()
        if kind != KIND_JPEG { return camera_start(KIND_JPEG) }
        return E_STREAM
    }
    wr32(b + B_S_W, sw)
    wr32(b + B_S_H, sh)
    wr32(b + B_P_W, ci.prev_w)
    wr32(b + B_P_H, ci.prev_h)
    *((b + CB_SESS) as *mut u64) = 0
    *((b + CB_SESS + 8) as *mut u64) = code_of_q(cb_noop)
    *((b + CB_SESS + 16) as *mut u64) = code_of_q(cb_ready)
    *((b + CB_SESS + 24) as *mut u64) = code_of_q(cb_noop)
    *((b + CB_CAP) as *mut u64) = 0
    *((b + CB_CAP + 8) as *mut u64) = code_of_q(cb_noop)
    *((b + CB_CAP + 16) as *mut u64) = code_of_q(cb_noop)
    *((b + CB_CAP + 24) as *mut u64) = code_of_q(cb_completed)
    *((b + CB_CAP + 32) as *mut u64) = code_of_q(cb_failed)
    *((b + CB_CAP + 40) as *mut u64) = code_of_q(cb_noop)
    *((b + CB_CAP + 48) as *mut u64) = code_of_q(cb_noop)
    *((b + CB_CAP + 56) as *mut u64) = code_of_q(cb_noop)
    wr32(b + B_READY, 0)
    let sp: u64 = b + B_SCRATCH + 448
    wr64(sp, 0)
    let st: i32 = ACameraDevice_createCaptureSession(*((b + B_DEV) as *mut u64), cont, b + CB_SESS, sp)
    if st != 0 || *(sp as *mut u64) == 0 {
        close_session()
        if kind != KIND_JPEG { return camera_start(KIND_JPEG) }
        return E_SESSION
    }
    *((b + B_SESS) as *mut u64) = *(sp as *mut u64)
    wr32(b + B_KIND, kind)
    return restart_preview(0.0f - 1.0f)
}

// Width and height of the still stream (which = 0) or the preview (which = 1) of the running session.
#[no_gc]
fn camera_stream_size(which: i32, w: *mut i32, h: *mut i32) {
    let b: u64 = block()
    if which == 0 {
        *w = rd32(b + B_S_W)
        *h = rd32(b + B_S_H)
    } else {
        *w = rd32(b + B_P_W)
        *h = rd32(b + B_P_H)
    }
}

// ------------------------------------------------------------ manual control
#[no_gc]
fn camera_set_auto() -> i32 {
    let b: u64 = block()
    wr32(b + B_P_MANUAL, 0)
    wr32(b + B_P_FOCUS_ON, 0)
    wr32(b + B_P_AELOCK, 0)
    wr32(b + B_P_AFLOCK, 0)
    return restart_preview(0.0f - 1.0f)
}

// exp_ns <= 0 / iso <= 0 keep auto exposure; focus_d < 0 keeps autofocus. Values are clamped to the
// ranges the lens reported. Capabilities missing -> the setting is ignored (the call still returns E_OK).
#[no_gc]
fn camera_set_manual(exp_ns: i64, iso: i32, focus_d: f32) -> i32 {
    let b: u64 = block()
    var ci: CamInfo = zero_info()
    if !camera_info(rd32(b + B_CUR), &ci) { return E_STATE }
    if exp_ns > 0 && iso > 0 {
        var e: i64 = exp_ns
        if ci.exp_min_ns > 0 && e < ci.exp_min_ns { e = ci.exp_min_ns }
        if ci.exp_max_ns > 0 && e > ci.exp_max_ns { e = ci.exp_max_ns }
        var s: i32 = iso
        if ci.iso_min > 0 && s < ci.iso_min { s = ci.iso_min }
        if ci.iso_max > 0 && s > ci.iso_max { s = ci.iso_max }
        wr64(b + B_P_EXP, e)
        wr32(b + B_P_ISO, s)
        wr32(b + B_P_MANUAL, 1)
    } else {
        wr32(b + B_P_MANUAL, 0)
    }
    if focus_d >= 0.0f {
        var f: f32 = focus_d
        if f > ci.min_focus_d { f = ci.min_focus_d }
        wrf(b + B_P_FOCUS, f)
        wr32(b + B_P_FOCUS_ON, 1)
    } else {
        wr32(b + B_P_FOCUS_ON, 0)
    }
    return restart_preview(0.0f - 1.0f)
}

// Locks / unlocks auto exposure and the autofocus distance (AF-lock = one-shot AF mode: stays where it is).
#[no_gc]
fn camera_lock(ae: bool, af: bool) -> i32 {
    let b: u64 = block()
    wr32(b + B_P_AELOCK, if_i(ae))
    wr32(b + B_P_AFLOCK, if_i(af))
    return restart_preview(0.0f - 1.0f)
}

// ------------------------------------------------------------ preview frames
// The newest preview frame as BGRX (window.image) scaled to ow x oh (nearest), rotated `rot` degrees
// clockwise (0/90/180/270; pass the lens `orientation` to get an upright picture). mirror flips
// horizontally (front camera). Returns 1 = new frame written, 0 = no new frame, <0 error.
#[no_gc]
fn camera_preview_bgrx(out: u64, ow: i32, oh: i32, rot: i32, mirror: bool) -> i32 {
    let b: u64 = block()
    let rd: u64 = *((b + B_PREV_RD) as *mut u64)
    if rd == 0 || out == 0 || ow <= 0 || oh <= 0 { return 0 - 1 }
    let ip: u64 = b + B_SCRATCH + 480
    var img: u64 = 0
    // drop all but the newest image
    while true {
        wr64(ip, 0)
        if AImageReader_acquireNextImage(rd, ip) != 0 { break }
        let n: u64 = *(ip as *mut u64)
        if n == 0 { break }
        if img != 0 { AImage_delete(img) }
        img = n
    }
    if img == 0 { return 0 }
    let q: u64 = b + B_SCRATCH + 488
    let w: i32 = img_int(AImage_getWidth(img, q), q)
    let h: i32 = img_int(AImage_getHeight(img, q), q)
    var yp: u64 = 0
    var up: u64 = 0
    var vp: u64 = 0
    wr32(q, 0)
    let r0: i32 = AImage_getPlaneData(img, 0, b + B_SCRATCH + 496, q)
    yp = *((b + B_SCRATCH + 496) as *mut u64)
    let r1: i32 = AImage_getPlaneData(img, 1, b + B_SCRATCH + 496, q)
    up = *((b + B_SCRATCH + 496) as *mut u64)
    let r2: i32 = AImage_getPlaneData(img, 2, b + B_SCRATCH + 496, q)
    vp = *((b + B_SCRATCH + 496) as *mut u64)
    let ys: i32 = plane_int(AImage_getPlaneRowStride(img, 0, q), q)
    let us: i32 = plane_int(AImage_getPlaneRowStride(img, 1, q), q)
    let up_s: i32 = plane_int(AImage_getPlanePixelStride(img, 1, q), q)
    if yp == 0 || up == 0 || vp == 0 || w <= 0 || h <= 0 || ys <= 0 {
        AImage_delete(img)
        return 0 - 1
    }
    var oy: i32 = 0
    while oy < oh {
        var ox: i32 = 0
        while ox < ow {
            var mx: i32 = ox
            if mirror { mx = ow - 1 - ox }
            var sx: i32 = 0
            var sy: i32 = 0
            if rot == 90 {
                sx = oy * w / oh
                sy = (ow - 1 - mx) * h / ow
            } else if rot == 270 {
                sx = (oh - 1 - oy) * w / oh
                sy = mx * h / ow
            } else if rot == 180 {
                sx = (ow - 1 - mx) * w / ow
                sy = (oh - 1 - oy) * h / oh
            } else {
                sx = mx * w / ow
                sy = oy * h / oh
            }
            let y: i32 = rd8(yp + ((sy * ys + sx) as u64)) as i32
            let ci: u64 = ((sy / 2) * us + (sx / 2) * up_s) as u64
            let u: i32 = rd8(up + ci) as i32 - 128
            let v: i32 = rd8(vp + ci) as i32 - 128
            var r: i32 = y + (359 * v) / 256
            var g: i32 = y - (88 * u + 183 * v) / 256
            var bl: i32 = y + (454 * u) / 256
            if r < 0 { r = 0 }
            if r > 255 { r = 255 }
            if g < 0 { g = 0 }
            if g > 255 { g = 255 }
            if bl < 0 { bl = 0 }
            if bl > 255 { bl = 255 }
            let o: u64 = out + (((oy * ow + ox) * 4) as u64)
            wr8(o, bl as u32)
            wr8(o + 1, g as u32)
            wr8(o + 2, r as u32)
            wr8(o + 3, 0 as u32)
            ox = ox + 1
        }
        oy = oy + 1
    }
    AImage_delete(img)
    return 1
}

#[no_gc]
fn img_int(status: i32, q: u64) -> i32 {
    if status != 0 { return 0 }
    return rd32(q)
}

#[no_gc]
fn plane_int(status: i32, q: u64) -> i32 {
    if status != 0 { return 0 }
    return rd32(q)
}

// ------------------------------------------------------------ results
// Index of the result ring slot with this timestamp, -1 when it has not arrived.
#[no_gc]
fn res_find(ts: i64) -> i32 {
    let b: u64 = G_P
    var i: u64 = 0
    while i < RES_COUNT {
        if rd64(b + RES_BASE + i * RES_SLOT) == ts && ts != 0 {
            return i as i32
        }
        i = i + 1
    }
    return 0 - 1
}

#[no_gc]
fn res_slot(i: i32) -> u64 {
    return G_P + RES_BASE + (i as u64) * RES_SLOT
}

// True when a focus lens reported by a result has stopped within `tol` diopters of the target.
#[no_gc]
fn focus_converged(lens_state: i32, reported: f32, target: f32, tol: f32) -> bool {
    var d: f32 = reported - target
    if d < 0.0f { d = 0.0f - d }
    if lens_state == 1 { return false }
    return d <= tol
}

// The newest result slot (for the preview): -1 when no result yet.
#[no_gc]
fn camera_last_slot() -> i32 {
    let b: u64 = block()
    let n: u64 = *((b + B_RES_N) as *mut u64)
    if n == 0 { return 0 - 1 }
    return ((n - 1) % RES_COUNT) as i32
}

// ------------------------------------------------------------ metadata for the pipeline
// Static facts of the open lens (CFA, black / white level, forward matrix, focus range, lens) plus,
// when slot >= 0, what that frame's result says (exposure, ISO, noise profile, white balance gains).
#[no_gc]
fn camera_meta(slot: i32, m: *mut meta.SensorMeta) -> bool {
    let b: u64 = block()
    if b == 0 || !camera_is_open() { return false }
    let md: u64 = chars_of(b + B_ID)
    if md == 0 { return false }
    let e: u64 = b + B_SCRATCH
    *m = meta.meta_default()
    (*m).cfa = md_u8(md, T_SENSOR_INFO_CFA, 0) as u32
    if (*m).cfa > 4 as u32 { (*m).cfa = 0 as u32 }
    let white: i32 = md_i32(md, T_SENSOR_INFO_WHITE, 0)
    if md_get(md, T_SENSOR_BLACK_PATTERN, e) && e_count(e) >= 4 && white > 0 {
        var i: usize = 0
        while i < 4 {
            meta.meta_set_black(m, i, rd32(e_data(e) + (i * 4) as u64) as f32, white as f32)
            i = i + 1
        }
    }
    if md_get(md, T_SENSOR_FORWARD_MATRIX1, e) && e_count(e) >= 9 {
        var i: usize = 0
        while i < 9 {
            let num: i32 = rd32(e_data(e) + (i * 8) as u64)
            let den: i32 = rd32(e_data(e) + (i * 8) as u64 + 4)
            if den != 0 { meta.meta_set_forward(m, i, (num as f32) / (den as f32)) }
            i = i + 1
        }
    }
    (*m).focal_length = 0.0f
    if md_get(md, T_LENS_INFO_FOCAL_LENGTHS, e) { (*m).focal_length = rdf(e_data(e)) }
    if md_get(md, T_LENS_INFO_APERTURES, e) { (*m).aperture = rdf(e_data(e)) }
    if md_get(md, T_SENSOR_INFO_PHYS_SIZE, e) { (*m).sensor_width = rdf(e_data(e)) }
    meta.meta_set_focus(m, md_f32(md, T_LENS_INFO_MIN_FOCUS, 0.0f), md_f32(md, T_LENS_INFO_HYPERFOCAL, 0.0f),
        md_u8(md, T_LENS_INFO_FOCUS_CALIB, 0) as u32)
    ACameraMetadata_free(md)
    if slot >= 0 && (slot as u64) < RES_COUNT {
        let s: u64 = res_slot(slot)
        let flags: u32 = *((s + 36) as *mut u32)
        if (flags & 1 as u32) != 0 as u32 {
            (*m).exposure_ns = rd64(s + 8) as u64
            (*m).has_exposure = true
        }
        if (flags & 2 as u32) != 0 as u32 && rd32(s + 16) > 0 { (*m).iso = rd32(s + 16) as u32 }
        if rdf(s + 28) > 0.0f { (*m).focal_length = rdf(s + 28) }
        if rdf(s + 32) > 0.0f { (*m).aperture = rdf(s + 32) }
        if (flags & 32 as u32) != 0 as u32 {
            var k: usize = 0
            while k < 4 {
                meta.meta_set_noise(m, k, rdd(s + 72 + (k * 16) as u64) as f32, rdd(s + 80 + (k * 16) as u64) as f32)
                k = k + 1
            }
        }
        if (flags & 8 as u32) != 0 as u32 {
            var k: usize = 0
            while k < 4 {
                meta.meta_set_wb(m, k, rdf(s + 40 + (k * 4) as u64))
                k = k + 1
            }
        }
    }
    return true
}

// What a DNG additionally needs: ColorMatrix1, the illuminant, the as-shot neutral and the orientation.
#[no_gc]
fn camera_dng_extra(slot: i32, ex: *mut dngwrite.DngExtra) -> bool {
    let b: u64 = block()
    if b == 0 || !camera_is_open() { return false }
    *ex = dngwrite.dng_extra_default()
    let md: u64 = chars_of(b + B_ID)
    if md == 0 { return false }
    let e: u64 = b + B_SCRATCH
    if md_get(md, T_SENSOR_COLOR_TRANSFORM1, e) && e_count(e) >= 9 {
        var i: usize = 0
        var okm: bool = true
        while i < 9 {
            let num: i32 = rd32(e_data(e) + (i * 8) as u64)
            let den: i32 = rd32(e_data(e) + (i * 8) as u64 + 4)
            if den == 0 { okm = false } else { (*ex).color[i] = (num as f32) / (den as f32) }
            i = i + 1
        }
        (*ex).has_color = okm
    }
    let ill: i32 = md_u8(md, T_SENSOR_REF_ILLUMINANT1, 0)
    if ill > 0 { (*ex).illuminant = ill as u32 }
    ACameraMetadata_free(md)
    // the image is stored in sensor orientation; DNG tag 274 tells readers how to turn it upright
    let rot: i32 = rd32(b + B_ROT)
    (*ex).orientation = 1 as u32
    if rot == 90 { (*ex).orientation = 6 as u32 }
    if rot == 180 { (*ex).orientation = 3 as u32 }
    if rot == 270 { (*ex).orientation = 8 as u32 }
    if slot >= 0 && (slot as u64) < RES_COUNT {
        let s: u64 = res_slot(slot)
        if (*((s + 36) as *mut u32) & 16 as u32) != 0 as u32 {
            (*ex).neutral = [rdf(s + 56), rdf(s + 60), rdf(s + 64)]
            (*ex).has_neutral = true
        }
    }
    return true
}

// ------------------------------------------------------------ capture
// Drops every image waiting in `rd` (old frames from before the shutter press).
#[no_gc]
fn flush_reader(rd: u64) {
    let ip: u64 = G_P + B_SCRATCH + 504
    while true {
        wr64(ip, 0)
        if AImageReader_acquireNextImage(rd, ip) != 0 { break }
        let n: u64 = *(ip as *mut u64)
        if n == 0 { break }
        AImage_delete(n)
    }
}

// Waits up to timeout_ms for the next image of `rd`; 0 on timeout.
#[no_gc]
fn wait_image(rd: u64, timeout_ms: i32) -> u64 {
    let ip: u64 = G_P + B_SCRATCH + 504
    var waited: i32 = 0
    while waited < timeout_ms {
        wr64(ip, 0)
        if AImageReader_acquireNextImage(rd, ip) == 0 {
            let n: u64 = *(ip as *mut u64)
            if n != 0 { return n }
        }
        if rd32(G_P + B_STATE) != 1 { return 0 }
        wait_ms(4 as u32)
        waited = waited + 4
    }
    return 0
}

// Copies image `img` into out+at in the frame's own format; returns the octets written, 0 = does not fit.
#[no_gc]
fn store_image(img: u64, kind: i32, out: u64, at: usize, cap: usize, fi: *mut FrameInfo) -> usize {
    let b: u64 = G_P
    let q: u64 = b + B_SCRATCH + 512
    let w: i32 = img_int(AImage_getWidth(img, q), q)
    let h: i32 = img_int(AImage_getHeight(img, q), q)
    (*fi).w = w
    (*fi).h = h
    (*fi).kind = kind
    (*fi).offset = at
    wr64(q, 0)
    let tsr: i32 = AImage_getTimestamp(img, q)
    (*fi).timestamp = rd64(q)
    let dp: u64 = b + B_SCRATCH + 528
    let lp: u64 = b + B_SCRATCH + 536
    wr32(lp, 0)
    if kind == KIND_JPEG {
        if AImage_getPlaneData(img, 0, dp, lp) != 0 { return 0 }
        let n: usize = rd32(lp) as usize
        if at + n > cap { return 0 }
        copy(out + at as u64, *(dp as *mut u64), n)
        (*fi).size = n
        return n
    }
    if kind == KIND_RAW {
        if AImage_getPlaneData(img, 0, dp, lp) != 0 { return 0 }
        let src: u64 = *(dp as *mut u64)
        let rs: i32 = plane_int(AImage_getPlaneRowStride(img, 0, q), q)
        let n: usize = (w as usize) * (h as usize) * 2
        if at + n > cap || rs < w * 2 { return 0 }
        var y: i32 = 0
        while y < h {
            copy(out + (at + (y as usize) * (w as usize) * 2) as u64, src + ((y * rs) as u64), (w * 2) as usize)
            y = y + 1
        }
        (*fi).size = n
        return n
    }
    // YUV_420_888 -> packed I420 (Y, then U, then V; quarter size chroma planes)
    let n2: usize = (w as usize) * (h as usize) * 3 / 2
    if at + n2 > cap { return 0 }
    var pl: i32 = 0
    var dst: u64 = out + at as u64
    while pl < 3 {
        if AImage_getPlaneData(img, pl, dp, lp) != 0 { return 0 }
        let src2: u64 = *(dp as *mut u64)
        let rs2: i32 = plane_int(AImage_getPlaneRowStride(img, pl, q), q)
        let ps: i32 = plane_int(AImage_getPlanePixelStride(img, pl, q), q)
        var pw: i32 = w
        var ph: i32 = h
        if pl > 0 {
            pw = w / 2
            ph = h / 2
        }
        var y2: i32 = 0
        while y2 < ph {
            let row: u64 = src2 + ((y2 * rs2) as u64)
            if ps == 1 {
                copy(dst, row, pw as usize)
            } else {
                var x: i32 = 0
                while x < pw {
                    wr8(dst + x as u64, rd8(row + ((x * ps) as u64)))
                    x = x + 1
                }
            }
            dst = dst + pw as u64
            y2 = y2 + 1
        }
        pl = pl + 1
    }
    (*fi).size = n2
    return n2
}

// THE capture function. Takes n frames with the session's kind (KIND_JPEG: one JPEG per frame, KIND_RAW:
// RAW16, KIND_YUV: I420). exp_list (i64 ns per frame) and focus_list (f32 diopters per frame) may be 0:
// auto exposure / current focus. With a focus_list every frame waits for the lens to arrive (result
// LENS_STATE stationary and LENS_FOCUS_DISTANCE within tolerance, at most ~700 ms) and is taken alone;
// without it frames go out in batches of up to 4. Frames land one after the other in `out` (cap octets),
// described in frames[i]. Returns the number of frames stored (may be < n when the buffer is full or a
// frame timed out), or a negative E_* code when nothing could be taken.
#[no_gc]
fn camera_capture(n: i32, exp_list: u64, focus_list: u64, iso: i32, out: u64, cap: usize,
                  frames: *mut FrameInfo) -> i32 {
    let b: u64 = block()
    if b == 0 || !camera_is_open() { return 0 - E_STATE }
    let sess: u64 = *((b + B_SESS) as *mut u64)
    let rd: u64 = *((b + B_STILL_RD) as *mut u64)
    let kind: i32 = rd32(b + B_KIND)
    if sess == 0 || rd == 0 || kind < 0 { return 0 - E_STATE }
    if n <= 0 || out == 0 { return 0 - E_STATE }
    let d: u64 = *((b + B_DEV) as *mut u64)
    var done: i32 = 0
    var at: usize = 0
    var batch: i32 = 1
    flush_reader(rd)
    while done < n {
        batch = 1
        if focus_list == 0 {
            batch = n - done
            if batch > 4 { batch = 4 }
        }
        var focus: f32 = 0.0f - 1.0f
        if focus_list != 0 {
            focus = rdf(focus_list + ((done * 4) as u64))
            // move the lens with the preview request, wait for the result
            let mark: u64 = *((b + B_RES_N) as *mut u64)
            let rr: i32 = restart_preview(focus)
            var w8: i32 = 0
            var tol: f32 = 0.15f
            while w8 < 700 {
                let cur: u64 = *((b + B_RES_N) as *mut u64)
                if cur >= mark + 3 {
                    let ls: i32 = camera_last_slot()
                    let s2: u64 = res_slot(ls)
                    if focus_converged(rd32(s2 + 20), rdf(s2 + 24), focus, tol) { break }
                }
                wait_ms(20 as u32)
                w8 = w8 + 20
            }
        }
        let arr: u64 = b + B_SCRATCH + 544
        var made: i32 = 0
        var k: i32 = 0
        while k < batch {
            let rp: u64 = b + B_SCRATCH + 552
            wr64(rp, 0)
            if ACameraDevice_createCaptureRequest(d, 2, rp) != 0 || *(rp as *mut u64) == 0 { break }
            let req: u64 = *(rp as *mut u64)
            ACaptureRequest_addTarget(req, *((b + B_STILL_TGT) as *mut u64))
            var e: i64 = 0
            if exp_list != 0 { e = rd64(exp_list + (((done + k) * 8) as u64)) }
            fill_request(req, true, e, iso, focus)
            *((arr + (made * 8) as u64) as *mut u64) = req
            made = made + 1
            k = k + 1
        }
        if made == 0 { break }
        let st: i32 = ACameraCaptureSession_capture(sess, b + CB_CAP, made, arr, 0)
        var got: i32 = 0
        if st == 0 {
            while got < made {
                let img: u64 = wait_image(rd, 6000)
                if img == 0 { break }
                let cur: *mut FrameInfo = frame_at(frames, done + got)
                (*cur).focus_cmd = focus
                (*cur).slot = 0 - 1
                (*cur).have_result = false
                (*cur).exposure_ns = 0
                (*cur).iso = 0
                (*cur).focus_res = 0.0f - 1.0f
                (*cur).lens_state = 0 - 1
                let sz: usize = store_image(img, kind, out, at, cap, cur)
                AImage_delete(img)
                if sz == 0 { break }
                at = at + sz
                // the result for this frame (it may arrive a little after the image)
                var wr: i32 = 0
                var slot: i32 = res_find((*cur).timestamp)
                while slot < 0 && wr < 1500 {
                    wait_ms(10 as u32)
                    wr = wr + 10
                    slot = res_find((*cur).timestamp)
                }
                if slot >= 0 {
                    let s3: u64 = res_slot(slot)
                    (*cur).slot = slot
                    (*cur).have_result = true
                    (*cur).exposure_ns = rd64(s3 + 8)
                    (*cur).iso = rd32(s3 + 16)
                    (*cur).focus_res = rdf(s3 + 24)
                    (*cur).lens_state = rd32(s3 + 20)
                    wr32(b + B_LAST_SLOT, slot)
                }
                got = got + 1
            }
        }
        var f2: i32 = 0
        while f2 < made {
            ACaptureRequest_free(*((arr + (f2 * 8) as u64) as *mut u64))
            f2 = f2 + 1
        }
        done = done + got
        if got < made { break }
    }
    if focus_list != 0 {
        let rr2: i32 = restart_preview(0.0f - 1.0f)
    }
    if done == 0 { return 0 - E_TIMEOUT }
    return done
}

#[no_gc]
fn frame_at(f: *mut FrameInfo, i: i32) -> *mut FrameInfo {
    return ((f as u64) + (i as u64) * (sizeof_frame() as u64)) as *mut FrameInfo
}

#[no_gc]
fn sizeof_frame() -> usize {
    var two: [FrameInfo; 2] = [zero_frame(), zero_frame()]
    return ((&two[1]) as u64 - (&two[0]) as u64) as usize
}

#[no_gc]
fn zero_frame() -> FrameInfo {
    return FrameInfo {
        kind: 0, w: 0, h: 0, offset: 0, size: 0, timestamp: 0, exposure_ns: 0, iso: 0,
        focus_cmd: 0.0f, focus_res: 0.0f, lens_state: 0, slot: 0 - 1, have_result: false,
    }
}

// ------------------------------------------------------------ focus plan
// Focus positions (diopters) for a focus stack, near to far, as a PURE function of the lens facts:
// near_d = LENS_INFO_MINIMUM_FOCUS_DISTANCE, far_d = hyperfocal (or 0 = infinity), step_d = how far apart
// two positions may be so that the sharp zones touch (about the depth of field in diopters:
// 2 * N * c / f^2 * 1000, c = circle of confusion mm, N = f number, f = focal length mm; pass 0 to use
// a quarter of the near distance). The count adapts to the range, at least 2, at most nmax. Writes the
// positions to out[0..n) and returns n. near_d <= 0 (fixed focus lens) -> 0: no focus stack possible.
#[no_gc]
fn focus_plan(near_d: f32, far_d: f32, step_d: f32, nmax: i32, out: u64) -> i32 {
    if near_d <= 0.0f || nmax < 2 { return 0 }
    var far: f32 = far_d
    if far < 0.0f { far = 0.0f }
    if far >= near_d { return 0 }
    let span: f32 = near_d - far
    var step: f32 = step_d
    if step <= 0.0f { step = near_d * 0.25f }
    var n: i32 = (span / step) as i32 + 1
    if (n as f32) * step < span { n = n + 1 }
    if n < 2 { n = 2 }
    if n > nmax { n = nmax }
    var i: i32 = 0
    while i < n {
        wrf(out + ((i * 4) as u64), near_d - span * (i as f32) / ((n - 1) as f32))
        i = i + 1
    }
    return n
}

// ------------------------------------------------------------ saving
// Writes `n` octets to the gallery: MediaStore.Images (Pictures/FirnCam) on Android 10+, which needs no
// permission for our own pictures. Older systems / failures: a file in the app's working directory
// (returns 2). Returns 1 = in the gallery, 2 = private file, 0 = failed. name is e.g. "IMG_1.jpg".
#[no_gc]
fn camera_save(data: u64, n: usize, name: u64, mime: u64) -> i32 {
    var ctx: u64 = 0
    let env: u64 = jni_ctx(&ctx)
    let act: u64 = activity.activity_pointer()
    if env != 0 && ndk.peek32(act + ndk.ACT_SDK_VERSION) >= 29 {
        if save_mediastore(env, ctx, data, n, name, mime) { return 1 }
    }
    let fd: i64 = syscall(2, name as i64, 577, 420, 0, 0, 0)
    if fd < 0 { return 0 }
    var off: usize = 0
    while off < n {
        let w: i64 = syscall(1, fd, (data + off as u64) as i64, (n - off) as i64, 0, 0, 0)
        if w <= 0 { break }
        off = off + w as usize
    }
    syscall(3, fd, 0, 0, 0, 0, 0)
    if off == n { return 2 }
    return 0
}

#[no_gc]
fn save_mediastore(env: u64, ctx: u64, data: u64, n: usize, name: u64, mime: u64) -> bool {
    let cc: u64 = jnicall.j_obj_class(env, ctx)
    let resolver: u64 = jnicall.j_obj(env, ctx, jnicall.j_method(env, cc, t(N_RESOLVER), t(G_RESOLVER)), 0)
    jnicall.j_del(env, cc)
    if resolver == 0 { return false }
    let vc: u64 = jnicall.j_class(env, t(C_VALUES))
    let values: u64 = jnicall.j_new(env, vc, jnicall.j_method(env, vc, t(N_INIT), t(G_V)), 0)
    if values == 0 { return false }
    var a: [u64; 3] = [0; 3]
    let pm: u64 = jnicall.j_method(env, vc, t(N_PUT), t(G_PUT_SS))
    a[0] = jnicall.j_str(env, t(S_DISPLAY))
    a[1] = jnicall.j_str(env, name)
    let o1: bool = jnicall.j_void(env, values, pm, (&a[0]) as u64)
    a[0] = jnicall.j_str(env, t(S_MIME))
    a[1] = jnicall.j_str(env, mime)
    let o2: bool = jnicall.j_void(env, values, pm, (&a[0]) as u64)
    a[0] = jnicall.j_str(env, t(S_RELPATH))
    a[1] = jnicall.j_str(env, t(S_PICTURES))
    let o3: bool = jnicall.j_void(env, values, pm, (&a[0]) as u64)
    let mc: u64 = jnicall.j_class(env, t(C_MEDIA))
    let base: u64 = jnicall.j_sfield_obj(env, mc, t(N_EXT), t(G_URI))
    let rc: u64 = jnicall.j_obj_class(env, resolver)
    a[0] = base
    a[1] = values
    let uri: u64 = jnicall.j_obj(env, resolver, jnicall.j_method(env, rc, t(N_INSERT), t(G_INSERT)), (&a[0]) as u64)
    if uri == 0 { return false }
    a[0] = uri
    a[1] = jnicall.j_str(env, t(S_W))
    let pfd: u64 = jnicall.j_obj(env, resolver, jnicall.j_method(env, rc, t(N_OPEN_FD), t(G_OPEN_FD)), (&a[0]) as u64)
    if pfd == 0 { return false }
    let pc: u64 = jnicall.j_obj_class(env, pfd)
    let fd: i32 = jnicall.j_int(env, pfd, jnicall.j_method(env, pc, t(N_DETACH), t(G_VI)), 0)
    if fd < 0 { return false }
    var off: usize = 0
    while off < n {
        let w: i64 = syscall(1, fd as i64, (data + off as u64) as i64, (n - off) as i64, 0, 0, 0)
        if w <= 0 { break }
        off = off + w as usize
    }
    syscall(3, fd as i64, 0, 0, 0, 0, 0)
    jnicall.j_del(env, pfd)
    jnicall.j_del(env, uri)
    jnicall.j_del(env, resolver)
    jnicall.j_del(env, values)
    return off == n
}
