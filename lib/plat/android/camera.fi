// ------------------------------------------------------------ the raw block
// One mmap block: callbacks write into it, API functions read it. Offsets in octets.
const B_SIZE: usize = 65536
const B_MGR: u64 = 0
const B_DEV: u64 = 8
const B_SESS: u64 = 16
const B_CONT: u64 = 24
