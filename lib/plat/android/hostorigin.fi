import std.rt

export { origin_set, origin_join }

const DEFAULT_ORIGIN: str = "https://chat.fleitec.com"

static mut G_ORIGIN: u64 = 0
static mut G_ORIGIN_N: usize = 0

fn origin_set(o: str) {
    if G_ORIGIN != 0 { rt.heap_free(G_ORIGIN, G_ORIGIN_N) }
    G_ORIGIN = rt.heap_alloc(o.n)
    G_ORIGIN_N = o.n
    if G_ORIGIN != 0 { rt.mem_copy(G_ORIGIN, o.p as u64, o.n) }
}

fn origin_join(url: u64, un: usize, out: *mut rt.Buf) {
    if un > 0 && rt.ld8(url, 0) == 47 as u8 {
        if G_ORIGIN == 0 { origin_set(DEFAULT_ORIGIN) }
        rt.buf_push_bytes(out, G_ORIGIN, G_ORIGIN_N)
    }
    rt.buf_push_bytes(out, url, un)
}
