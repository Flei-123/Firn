import std.rt
import std.time
import paint.canvas
import fui.theme
import fui.painter
import fui.render
import fui.anim
import fui.tap
import window.window
import plat.hostev

export {
    Win, G_WIN, the, win_blank, win_bytes, tr_bytes, now_ms, css_of, deliver, bus_event,
    MS_PER_NS, PROMILLE,
}

const PROMILLE: f64 = 1000.0
const MS_PER_NS: f64 = 1000000.0

struct Win {
    f: window.Window,
    cv: canvas.Canvas,
    z: painter.Painter,
    m: theme.Theme,
    c: render.Ctx,
    bgrx: u64,
    bgrx_n: usize,
    css_w: usize,
    css_h: usize,
    dpr: usize,
    w: usize,
    h: usize,
    ud: u64,
    paint: fn(u64, u64) -> bool,
    event: fn(u64, u64, *mut hostev.HostEvent) -> bool,
    keep: bool,
    opaque: bool,
    on_demand: bool,
    again: bool,
    dirty: bool,
    quit: bool,
    tr: u64,
    tap: tap.Tap,
}

static mut G_WIN: u64 = 0

fn paint_none(ud: u64, w: u64) -> bool { return false }

fn event_none(ud: u64, w: u64, e: *mut hostev.HostEvent) -> bool { return false }

fn win_blank() -> Win {
    return Win { f: window.window_new(), cv: canvas.canvas_new(), z: painter.painter_new(),
        m: theme.theme_new(true), c: render.ctx_new(0 as *mut theme.Theme, 0 as *mut painter.Painter),
        bgrx: 0, bgrx_n: 0, css_w: 0, css_h: 0, dpr: 1000, w: 0, h: 0, ud: 0,
        paint: paint_none, event: event_none, keep: false, opaque: false,
        on_demand: false, again: false, dirty: true, quit: false, tr: 0, tap: tap.tap_new() }
}

fn win_bytes() -> usize {
    var probe: [Win; 2] = [win_blank(); 2]
    return ((&probe[1]) as usize) - ((&probe[0]) as usize)
}

fn tr_bytes() -> usize {
    var probe: [anim.TransReg; 2] = [anim.transreg_new(); 2]
    return ((&probe[1]) as usize) - ((&probe[0]) as usize)
}

fn the() -> *mut Win { return G_WIN as *mut Win }

fn now_ms() -> f64 { return time.monotonic_ns() as f64 / MS_PER_NS }

fn css_of(x: *mut Win, v: f64) -> f64 { return v * PROMILLE / ((*x).dpr as f64) }

fn deliver(x: *mut Win, e: *mut hostev.HostEvent) -> bool {
    if ((*x).event)((*x).ud, x as u64, e) {
        (*x).dirty = true
        return true
    }
    return false
}

fn bus_event(e: *mut hostev.HostEvent) -> bool {
    if G_WIN == 0 { return false }
    return deliver(the(), e)
}
