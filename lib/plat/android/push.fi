#[no_gc]
extern fn usleep(us: u32) -> i32;
#[no_gc]
#[link_name(__system_property_get)]
extern fn system_property_get(name: u64, value: u64) -> i32;
#[no_gc]
extern fn pthread_create(tid: u64, attr: u64, start: u64, arg: u64) -> i32;

// ------------------------------------------------------- shared state
// One raw block: host text, port, the pthread id. Offsets in octets.
const P_HOST: u64 = 0 // 64 octets, zero terminated
const P_PORT: u64 = 64
const P_TID: u64 = 72
const P_BYTES: usize = 4096

const P_DNS: u64 = 80 // u64: server (host order) | port << 32; 0 = system
const P_TLS: u64 = 88 // u64: 1 = TLS with the pin below
const P_PIN: u64 = 96 // 32 octets: SHA-256 of the relay's public key
static mut G_P: u64 = 0
static mut G_DNS: u64 = 0 // the same value, set by the program before push_start
static mut G_PIN_ON: u64 = 0 // push_set_pin: TLS wanted ...
static mut G_PIN: [u8; 32] = [0 as u8; 32] // ... with this key
static mut G_VM: u64 = 0
static mut G_SVC: u64 = 0 // global reference to the running service
static mut G_APP: u64 = 0 // global reference to the application context
static mut G_RUN: u64 = 0
static mut G_STOP: u64 = 0
static mut G_SOCK: i64 = -1
static mut G_NID: u64 = 100

const START_STICKY: i32 = 1
const FGS_TYPE_REMOTE_MESSAGING: u64 = 512
const IMPORTANCE_LOW: u64 = 2
const IMPORTANCE_HIGH: u64 = 4
const PI_FLAGS: u64 = 201326592 // FLAG_IMMUTABLE | FLAG_UPDATE_CURRENT
const SVC_NOTE_ID: u64 = 1

#[no_gc]
fn t(i: usize) -> u64 {
    return ((&TXT[0]) as u64) + i as u64
}

#[no_gc]
fn log(i: usize) {
    ndk.log_write(ndk.LOG_INFO, t(S_TAG), t(i))
}

#[no_gc]
fn block() -> u64 {
    if G_P == 0 {
        let r: i64 = syscall(9, 0, P_BYTES as i64, 3, 34, -1, 0)
        if r > 0 {
            G_P = r as u64
        }
    }
    return G_P
}

#[no_gc]
fn length(p: u64) -> usize {
    var n: usize = 0
    while *((p + n as u64) as *mut u8) != 0 as u8 {
        n = n + 1
    }
    return n
}

#[no_gc]
fn copy(z: u64, q: u64, n: usize) {
    var i: usize = 0
    while i < n {
        *((z + i as u64) as *mut u8) = *((q + i as u64) as *mut u8)
        i = i + 1
    }
}

#[no_gc]
fn wait_ms(ms: u32) {
    let r: i32 = usleep(ms * 1000)
}

// ------------------------------------------------ the notification side

#[no_gc]
fn manager(env: u64, ctx: u64) -> u64 {
    let cc: u64 = jnicall.j_obj_class(env, ctx)
    let m: u64 = jnicall.j_method(env, cc, t(N_GETSVC), t(G_GETSVC))
    let s: u64 = jnicall.j_str(env, t(S_NOTIFICATION))
    var a: [u64; 1] = [0; 1]
    a[0] = s
    let nm: u64 = jnicall.j_obj(env, ctx, m, (&a[0]) as u64)
    jnicall.j_del(env, s)
    jnicall.j_del(env, cc)
    return nm
}

// Both channels, idempotent (Android ignores a second create with the same
// id): "Nachrichten" makes a sound and a heads-up, "Verbindung" is the
// quiet permanent one of the service.
#[no_gc]
fn kanaele(env: u64, ctx: u64) {
    let nm: u64 = manager(env, ctx)
    if nm == 0 {
        return
    }
    let chc: u64 = jnicall.j_class(env, t(C_CHANNEL))
    let ctor: u64 = jnicall.j_method(env, chc, t(N_INIT), t(G_CHANNEL_INIT))
    let nmc: u64 = jnicall.j_obj_class(env, nm)
    let mc: u64 = jnicall.j_method(env, nmc, t(N_CREATE_CHANNEL),
        t(G_CREATE_CHANNEL))
    var k: usize = 0
    while k < 2 {
        var id: usize = S_CH_PUSH
        var name: usize = S_CH_PUSH_NAME
        var imp: u64 = IMPORTANCE_HIGH
        if k == 1 {
            id = S_CH_SVC
            name = S_CH_SVC_NAME
            imp = IMPORTANCE_LOW
        }
        let jid: u64 = jnicall.j_str(env, t(id))
        let jname: u64 = jnicall.j_str(env, t(name))
        var a: [u64; 3] = [0; 3]
        a[0] = jid
        a[1] = jname
        a[2] = imp
        let ch: u64 = jnicall.j_new(env, chc, ctor, (&a[0]) as u64)
        var b: [u64; 1] = [0; 1]
        if k == 0 {
            // A message may buzz: vibration follows the phone's own
            // setting (silent mode, do not disturb) -- the channel only
            // allows it. Android fixes a channel at its creation, which is
            // why this one has a new id (see S_CH_OLD below).
            b[0] = 1
            let vb: bool = jnicall.j_void(env, ch,
                jnicall.j_method(env, chc, t(N_VIBRATION), t(G_ZV)),
                (&b[0]) as u64)
        }
        b[0] = ch
        let ok: bool = jnicall.j_void(env, nm, mc, (&b[0]) as u64)
        jnicall.j_del(env, ch)
        jnicall.j_del(env, jid)
        jnicall.j_del(env, jname)
        k = k + 1
    }
    // The channel of the first builds ("firn_push") was made without
    // vibration and Android keeps a channel as it was made: it goes, so the
    // system settings show one "Nachrichten", the new one.
    let jold: u64 = jnicall.j_str(env, t(S_CH_OLD))
    var d: [u64; 1] = [0; 1]
    d[0] = jold
    let dok: bool = jnicall.j_void(env, nm,
        jnicall.j_method(env, nmc, t(N_DEL_CHANNEL), t(G_DEL_CHANNEL)),
        (&d[0]) as u64)
    jnicall.j_del(env, jold)
    jnicall.j_del(env, nmc)
    jnicall.j_del(env, chc)
    jnicall.j_del(env, nm)
}

// Tapping the notification opens the app: the launch intent of our own
// package, as a PendingIntent.
#[no_gc]
fn antippen(env: u64, ctx: u64) -> u64 {
    let cc: u64 = jnicall.j_obj_class(env, ctx)
    let pm: u64 = jnicall.j_obj(env, ctx,
        jnicall.j_method(env, cc, t(N_GET_PM), t(G_GET_PM)), 0)
    let pk: u64 = jnicall.j_obj(env, ctx,
        jnicall.j_method(env, cc, t(N_GET_PKG), t(G_STR)), 0)
    let pmc: u64 = jnicall.j_obj_class(env, pm)
    var a: [u64; 4] = [0; 4]
    a[0] = pk
    let it: u64 = jnicall.j_obj(env, pm,
        jnicall.j_method(env, pmc, t(N_LAUNCH), t(G_LAUNCH)),
        (&a[0]) as u64)
    var pi: u64 = 0
    if it != 0 {
        let pic: u64 = jnicall.j_class(env, t(C_PENDING))
        let mg: u64 = jnicall.j_smethod(env, pic, t(N_GET_ACTIVITY),
            t(G_GET_ACTIVITY))
        a[0] = ctx
        a[1] = 0
        a[2] = it
        a[3] = PI_FLAGS
        pi = jnicall.j_sobj(env, pic, mg, (&a[0]) as u64)
        jnicall.j_del(env, pic)
    }
    jnicall.j_del(env, it)
    jnicall.j_del(env, pmc)
    jnicall.j_del(env, pk)
    jnicall.j_del(env, pm)
    jnicall.j_del(env, cc)
    return pi
}

// Call a Builder setter with one argument and drop the returned builder
// (it is the same object, as another local reference).
#[no_gc]
fn set(env: u64, b: u64, bc: u64, name: usize, sig: usize, v: u64) {
    let m: u64 = jnicall.j_method(env, bc, t(name), t(sig))
    var a: [u64; 1] = [0; 1]
    a[0] = v
    let r: u64 = jnicall.j_obj(env, b, m, (&a[0]) as u64)
    jnicall.j_del(env, r)
}

// A finished `Notification`; `title`, `text`: zero terminated.
#[no_gc]
fn build(env: u64, ctx: u64, channel: usize, title: u64, text: u64,
    dauernd: bool) -> u64 {
    return build_in_group(env, ctx, channel, title, text, dauernd, 0)
}

// `gruppe`: 0 = alone, 1 = a message of the group "firn_msgs",
// 2 = the summary of that group. WHY A GROUP: Android bundles the
// notifications of one app by itself ("autogroup") as soon as there are a
// few, and then a tap on a bundled line is a tap on ANDROID'S summary --
// the message stays and nobody can tell which chat was meant (measured,
// emulator API 35). With our own group the lines of the expanded bundle
// and a heads-up are the messages themselves; a tap on the collapsed
// bundle is our summary, which takes the whole group with it.
#[no_gc]
fn build_in_group(env: u64, ctx: u64, channel: usize, title: u64, text: u64,
    dauernd: bool, gruppe: u32) -> u64 {
    let bc: u64 = jnicall.j_class(env, t(C_BUILDER))
    let ctor: u64 = jnicall.j_method(env, bc, t(N_INIT), t(G_BUILDER_INIT))
    let jk: u64 = jnicall.j_str(env, t(channel))
    var a: [u64; 2] = [0; 2]
    a[0] = ctx
    a[1] = jk
    let b: u64 = jnicall.j_new(env, bc, ctor, (&a[0]) as u64)
    if b == 0 {
        jnicall.j_del(env, jk)
        jnicall.j_del(env, bc)
        return 0
    }
    let dc: u64 = jnicall.j_class(env, t(C_DRAWABLE))
    let icon: i32 = jnicall.j_sfield_int(env, dc, t(S_ICON), t(G_INT))
    jnicall.j_del(env, dc)
    set(env, b, bc, N_SMALL_ICON, G_I_B, (icon as i64) as u64)
    let jt: u64 = jnicall.j_str(env, title)
    set(env, b, bc, N_TITLE, G_CS_B, jt)
    jnicall.j_del(env, jt)
    let jx: u64 = jnicall.j_str(env, text)
    set(env, b, bc, N_TEXT, G_CS_B, jx)
    jnicall.j_del(env, jx)
    var an: u64 = 0
    if dauernd {
        an = 1
    }
    set(env, b, bc, N_ONGOING, G_Z_B, an)
    if !dauernd {
        // CATEGORY_MESSAGE: do-not-disturb exceptions for messages apply
        let jc: u64 = jnicall.j_str(env, t(S_CAT_MSG))
        set(env, b, bc, N_CATEGORY, G_STR_B, jc)
        jnicall.j_del(env, jc)
    }
    if gruppe != 0 as u32 {
        let jg: u64 = jnicall.j_str(env, t(S_GROUP))
        set(env, b, bc, N_GROUP, G_STR_B, jg)
        jnicall.j_del(env, jg)
    }
    if gruppe == 2 as u32 {
        set(env, b, bc, N_GROUP_SUMMARY, G_Z_B, 1)
        // the summary never rings: the message under it already did
        set(env, b, bc, N_GROUP_ALERT, G_I_B, 2) // GROUP_ALERT_CHILDREN
        set(env, b, bc, N_ONLY_ONCE, G_Z_B, 1)
    }
    set(env, b, bc, N_AUTOCANCEL, G_Z_B, 1 - an)
    let pi: u64 = antippen(env, ctx)
    if pi != 0 {
        set(env, b, bc, N_CONTENT_INTENT, G_PI_B, pi)
        jnicall.j_del(env, pi)
    }
    let note: u64 = jnicall.j_obj(env, b,
        jnicall.j_method(env, bc, t(N_BUILD), t(G_BUILD)), 0)
    jnicall.j_del(env, b)
    jnicall.j_del(env, jk)
    jnicall.j_del(env, bc)
    return note
}

#[no_gc]
fn show(env: u64, ctx: u64, id: u64, note: u64) -> bool {
    let nm: u64 = manager(env, ctx)
    if nm == 0 || note == 0 {
        return false
    }
    let nmc: u64 = jnicall.j_obj_class(env, nm)
    let m: u64 = jnicall.j_method(env, nmc, t(N_NOTIFY), t(G_NOTIFY))
    var a: [u64; 2] = [0; 2]
    a[0] = id
    a[1] = note
    let ok: bool = jnicall.j_void(env, nm, m, (&a[0]) as u64)
    jnicall.j_del(env, nmc)
    jnicall.j_del(env, nm)
    return ok
}

// A UTF-16 half (U+D800..U+DFFF) as three octets at z + o; the new o.
#[no_gc]
fn drei(z: u64, o: usize, u: u32) -> usize {
    *((z + o as u64) as *mut u8) = (224 as u32 | (u >> 12)) as u8
    *((z + o as u64 + 1) as *mut u8) = (128 as u32 | ((u >> 6) & 63 as u32)) as u8
    *((z + o as u64 + 2) as *mut u8) = (128 as u32 | (u & 63 as u32)) as u8
    return o + 3
}

// JNI wants MODIFIED UTF-8: a character outside the BMP (four octets)
// becomes a surrogate pair of three octets each (an emoji survives), CR is
// dropped, NUL ends the text. At most `cap - 1`.
#[no_gc]
fn utf_clean(q: u64, n: usize, z: u64, cap: usize) {
    var i: usize = 0
    var o: usize = 0
    while i < n && o + 1 < cap {
        let b: u8 = *((q + i as u64) as *mut u8)
        if b == 0 as u8 {
            break
        }
        if b == 13 as u8 {
            i = i + 1
        } else if b >= 240 as u8 {
            // Four octets (an emoji): Java holds it as TWO UTF-16 halves,
            // and modified UTF-8 writes each half as three octets.
            if i + 3 < n && o + 7 < cap {
                let b1: u8 = *((q + i as u64 + 1) as *mut u8)
                let b2: u8 = *((q + i as u64 + 2) as *mut u8)
                let b3: u8 = *((q + i as u64 + 3) as *mut u8)
                let cp: u32 = ((b as u32 & 7 as u32) << 18)
                | ((b1 as u32 & 63 as u32) << 12)
                | ((b2 as u32 & 63 as u32) << 6)
                | (b3 as u32 & 63 as u32)
                if cp >= 65536 as u32 && cp < 1114112 as u32 {
                    let v: u32 = cp - 65536 as u32
                    let hi: u32 = 55296 as u32 + (v >> 10)
                    let lo: u32 = 56320 as u32 + (v & 1023 as u32)
                    o = drei(z, o, hi)
                    o = drei(z, o, lo)
                } else {
                    *((z + o as u64) as *mut u8) = 63 as u8
                    o = o + 1
                }
            } else {
                *((z + o as u64) as *mut u8) = 63 as u8
                o = o + 1
            }
            i = i + 4
        } else {
            *((z + o as u64) as *mut u8) = b
            o = o + 1
            i = i + 1
        }
    }
    *((z + o as u64) as *mut u8) = 0 as u8
}

// A message notification with the next id.
#[no_gc]
fn nachricht(env: u64, ctx: u64, title: u64, q: u64, n: usize) {
    let id: u64 = G_NID
    G_NID = G_NID + 1
    let ok: bool = nachricht_id(env, ctx, id, title, q, n)
}

// ... with a given id: a second one with the same id REPLACES the first
// (one notification per conversation, like every messenger).
#[no_gc]
fn nachricht_id(env: u64, ctx: u64, id: u64, title: u64, q: u64,
    n: usize) -> bool {
    var text: [u8; 1024] = [0 as u8; 1024]
    utf_clean(q, n, (&text[0]) as u64, 1024)
    if text[0] == 0 as u8 {
        return false
    }
    var tt: [u8; 256] = [0 as u8; 256]
    utf_clean(title, length(title), (&tt[0]) as u64, 256)
    var gruppe: u32 = 0
    if id >= KEYED_BASE {
        gruppe = 1
    }
    let note: u64 = build_in_group(env, ctx, S_CH_PUSH, (&tt[0]) as u64,
        (&text[0]) as u64, false, gruppe)
    let ok: bool = show(env, ctx, id, note)
    if ok {
        log(S_L_NOTE)
    }
    jnicall.j_del(env, note)
    return ok
}

// ------------------------------------------------------ the program side

// The VM and the APPLICATION context, kept as a global reference: they
// outlive every activity. A program that keeps running after Back (see
// activity_keep_alive) notifies through them -- the ANativeActivity it
// started with is freed by then.
#[no_gc]
fn remember() {
    let act: u64 = activity.activity_pointer()
    if act == 0 {
        return
    }
    G_VM = ndk.peek64(act + 8)
    if G_APP != 0 {
        return
    }
    let env: u64 = jnicall.j_env(G_VM)
    let ctx: u64 = ndk.peek64(act + 24)
    let cc: u64 = jnicall.j_obj_class(env, ctx)
    let app: u64 = jnicall.j_obj(env, ctx,
        jnicall.j_method(env, cc, t(N_GET_APP), t(G_GET_APP)), 0)
    if app != 0 {
        G_APP = jnicall.j_global(env, app)
        jnicall.j_del(env, app)
    }
    jnicall.j_del(env, cc)
}

// A notification from the program itself (app thread), with or without an
// activity. `title`, `text`: zero terminated.
#[no_gc]
fn push_notify(title: u64, text: u64) -> bool {
    remember()
    var ctx: u64 = G_APP
    if ctx == 0 {
        ctx = G_SVC
    }
    if G_VM == 0 || ctx == 0 {
        return false
    }
    let env: u64 = jnicall.j_env(G_VM)
    if env == 0 {
        return false
    }
    kanaele(env, ctx)
    nachricht(env, ctx, title, text, length(text))
    return true
}

// THE KEYED NOTIFICATIONS. A program with several conversations gives
// each one a KEY (0, 1, 2, ...): a new message replaces the notification of
// its conversation instead of stacking a new one, `push_cancel` takes it
// away when the conversation is read, and `push_shown` says whether it is
// still in the status bar. The last one is how a program learns WHICH
// notification was tapped without a Java class of its own: a tap on an
// auto-cancel notification opens the app and removes exactly that one, so
// the conversation whose notification is gone when the window comes back
// is the one the user asked for.
const KEYED_BASE: u64 = 1000000
const SUMMARY_ID: u64 = 999999

// env and context for the app thread (with or without an activity).
#[no_gc]
fn jni_env(ctx_out: *mut u64) -> u64 {
    remember()
    var ctx: u64 = G_APP
    if ctx == 0 {
        ctx = G_SVC
    }
    if G_VM == 0 || ctx == 0 {
        return 0
    }
    *ctx_out = ctx
    return jnicall.j_env(G_VM)
}

#[no_gc]
fn push_notify_at(key: u64, title: u64, text: u64) -> bool {
    var ctx: u64 = 0
    let env: u64 = jni_env(&ctx)
    if env == 0 {
        return false
    }
    kanaele(env, ctx)
    let ok: bool = nachricht_id(env, ctx, KEYED_BASE + key, title, text,
        length(text))
    if ok {
        log(S_L_KEYED)
        let sn: u64 = build_in_group(env, ctx, S_CH_PUSH, t(S_APP_TITLE),
            t(S_SUMMARY_TEXT), false, 2)
        let so: bool = show(env, ctx, SUMMARY_ID, sn)
        jnicall.j_del(env, sn)
    }
    return ok
}

// How many keyed notifications are in the status bar (-1: cannot tell).
#[no_gc]
fn gezeigt(env: u64, ctx: u64, nur: u64) -> i64 {
    let nm: u64 = manager(env, ctx)
    if nm == 0 {
        return -1
    }
    let nmc: u64 = jnicall.j_obj_class(env, nm)
    let arr: u64 = jnicall.j_obj(env, nm,
        jnicall.j_method(env, nmc, t(N_ACTIVE), t(G_ACTIVE)), 0)
    var r: i64 = 0
    if arr == 0 {
        r = -1
    } else {
        let n: usize = jnicall.j_array_len(env, arr)
        var i: usize = 0
        var gid: u64 = 0
        while i < n {
            let sbn: u64 = jnicall.j_array_get(env, arr, i)
            if sbn != 0 {
                if gid == 0 {
                    let sc: u64 = jnicall.j_obj_class(env, sbn)
                    gid = jnicall.j_method(env, sc, t(N_GET_ID), t(G_GET_ID))
                    jnicall.j_del(env, sc)
                }
                let id: i32 = jnicall.j_int(env, sbn, gid, 0)
                if id >= 0 && id as u64 >= KEYED_BASE {
                    if nur == 0 || id as u64 == nur {
                        r = r + 1
                    }
                }
                jnicall.j_del(env, sbn)
            }
            i = i + 1
        }
        jnicall.j_del(env, arr)
    }
    jnicall.j_del(env, nmc)
    jnicall.j_del(env, nm)
    return r
}

// 1 = the notification of `key` is in the status bar, 0 = it is not
// (never posted, tapped, swiped away or cancelled), -1 = cannot tell.
#[no_gc]
fn push_shown(key: u64) -> i32 {
    var ctx: u64 = 0
    let env: u64 = jni_env(&ctx)
    if env == 0 {
        return -1
    }
    let r: i64 = gezeigt(env, ctx, KEYED_BASE + key)
    if r < 0 {
        return -1
    }
    if r > 0 {
        return 1
    }
    return 0
}

#[no_gc]
fn push_cancel(key: u64) -> bool {
    var ctx: u64 = 0
    let env: u64 = jni_env(&ctx)
    if env == 0 {
        return false
    }
    let nm: u64 = manager(env, ctx)
    if nm == 0 {
        return false
    }
    let nmc: u64 = jnicall.j_obj_class(env, nm)
    var a: [u64; 1] = [0; 1]
    a[0] = KEYED_BASE + key
    let mc: u64 = jnicall.j_method(env, nmc, t(N_CANCEL), t(G_CANCEL))
    let ok: bool = jnicall.j_void(env, nm, mc, (&a[0]) as u64)
    // the last message gone: the summary goes with it
    if gezeigt(env, ctx, 0) == 0 {
        a[0] = SUMMARY_ID
        let so: bool = jnicall.j_void(env, nm, mc, (&a[0]) as u64)
    }
    jnicall.j_del(env, nmc)
    jnicall.j_del(env, nm)
    if ok {
        log(S_L_CANCEL)
    }
    return ok
}

#[no_gc]
fn push_running() -> bool {
    return G_RUN != 0
}

// The intent that names our service.
#[no_gc]
fn dienst_absicht(env: u64, ctx: u64) -> u64 {
    let ic: u64 = jnicall.j_class(env, t(C_INTENT))
    let it: u64 = jnicall.j_new(env, ic,
        jnicall.j_method(env, ic, t(N_INIT), t(G_V)), 0)
    let cc: u64 = jnicall.j_obj_class(env, ctx)
    let pk: u64 = jnicall.j_obj(env, ctx,
        jnicall.j_method(env, cc, t(N_GET_PKG), t(G_STR)), 0)
    let sn: u64 = jnicall.j_str(env, t(S_SERVICE_CLASS))
    var a: [u64; 2] = [0; 2]
    a[0] = pk
    a[1] = sn
    let r: u64 = jnicall.j_obj(env, it,
        jnicall.j_method(env, ic, t(N_SET_CLASS), t(G_SET_CLASS)),
        (&a[0]) as u64)
    jnicall.j_del(env, r)
    jnicall.j_del(env, sn)
    jnicall.j_del(env, pk)
    jnicall.j_del(env, cc)
    jnicall.j_del(env, ic)
    return it
}

// Start the push connection to `host` (dotted IPv4, zero terminated) and
// `port`. Called on the app thread while the activity is on screen
// (Android 12+ refuses to start a foreground service from the background).
#[no_gc]
fn push_start(host: u64, port: u32) -> bool {
    let act: u64 = activity.activity_pointer()
    if act == 0 {
        return false
    }
    remember()
    let env: u64 = jnicall.j_env(ndk.peek64(act + 8))
    let ctx: u64 = ndk.peek64(act + 24)
    if env == 0 {
        return false
    }
    // 1. the configuration, where the service finds it without us
    let dir: u64 = ndk.peek64(act + ndk.ACT_INTERNAL_DATA_PATH)
    if dir == 0 {
        return false
    }
    var path: [u8; 512] = [0 as u8; 512]
    let dn: usize = length(dir)
    let cn: usize = length(t(S_CFG))
    if dn + cn + 1 > 512 {
        return false
    }
    copy((&path[0]) as u64, dir, dn)
    copy((&path[0]) as u64 + dn as u64, t(S_CFG), cn + 1)
    var content: [u8; 192] = [0 as u8; 192]
    var n: usize = length(host)
    if n > 63 {
        return false
    }
    copy((&content[0]) as u64, host, n)
    content[n] = 10 as u8
    n = n + 1
    var digits: [u8; 8] = [0 as u8; 8]
    var k: usize = 0
    var p: u32 = port
    while k == 0 || p > 0 as u32 {
        digits[k] = (48 as u32 + p % 10 as u32) as u8
        p = p / 10 as u32
        k = k + 1
    }
    while k > 0 {
        k = k - 1
        content[n] = digits[k]
        n = n + 1
    }
    content[n] = 10 as u8
    n = n + 1
    if (G_DNS != 0 as u64 || G_PIN_ON == 1 as u64) && n + 24 <= 96 {
        if G_DNS != 0 as u64 {
            // third line: the name server, "a.b.c.d:port"
            let ds: u32 = (G_DNS & 4294967295 as u64) as u32
            var sh: u32 = 24 as u32
            var o: usize = 0
            while o < 4 {
                let v: u32 = (ds >> sh) & 255 as u32
                if v >= 100 as u32 {
                    content[n] = (48 as u32 + v / 100 as u32) as u8
                    n = n + 1
                }
                if v >= 10 as u32 {
                    content[n] = (48 as u32 + (v / 10 as u32) % 10 as u32) as u8
                    n = n + 1
                }
                content[n] = (48 as u32 + v % 10 as u32) as u8
                n = n + 1
                if o < 3 {
                    content[n] = 46 as u8
                    n = n + 1
                    sh = sh - 8 as u32
                }
                o = o + 1
            }
            content[n] = 58 as u8
            n = n + 1
            var dg: [u8; 8] = [0 as u8; 8]
            var dk: usize = 0
            var dp: u32 = ((G_DNS >> 32) & 65535 as u64) as u32
            while dk == 0 || dp > 0 as u32 {
                dg[dk] = (48 as u32 + dp % 10 as u32) as u8
                dp = dp / 10 as u32
                dk = dk + 1
            }
            while dk > 0 {
                dk = dk - 1
                content[n] = dg[dk]
                n = n + 1
            }
        }
        content[n] = 10 as u8 // end of the (maybe empty) third line
        n = n + 1
    }
    if G_PIN_ON == 1 as u64 {
        // fourth line: the key pin, 64 hex digits
        var pi: usize = 0
        while pi < 32 {
            let hx: u8 = G_PIN[pi]
            let hi: u8 = hx >> 4 as u8
            let lo: u8 = hx & 15 as u8
            content[n] = if hi < 10 as u8 { 48 as u8 + hi } else { 87 as u8 + hi }
            content[n + 1] = if lo < 10 as u8 { 48 as u8 + lo } else { 87 as u8 + lo }
            n = n + 2
            pi = pi + 1
        }
        content[n] = 10 as u8
        n = n + 1
    }
    let fd: i64 = syscall(2, (&path[0]) as i64, 577, 384, 0, 0, 0)
    if fd < 0 {
        return false
    }
    syscall(1, fd, (&content[0]) as i64, n as i64, 0, 0, 0)
    syscall(3, fd, 0, 0, 0, 0, 0)
    // 2. the permission to show notifications (Android 13, API 33+)
    let sdk: i32 = ndk.peek32(act + ndk.ACT_SDK_VERSION)
    let cc: u64 = jnicall.j_obj_class(env, ctx)
    if sdk >= 33 {
        let ps: u64 = jnicall.j_str(env, t(S_POST_NOTIF))
        var a: [u64; 2] = [0; 2]
        a[0] = ps
        let g: i32 = jnicall.j_int(env, ctx,
            jnicall.j_method(env, cc, t(N_CHECK_PERM), t(G_CHECK_PERM)),
            (&a[0]) as u64)
        if g != 0 {
            let sc: u64 = jnicall.j_class(env, t(C_STRING))
            let arr: u64 = jnicall.j_array1(env, sc, ps)
            a[0] = arr
            a[1] = 7
            let ok: bool = jnicall.j_void(env, ctx,
                jnicall.j_method(env, cc, t(N_REQ_PERM), t(G_REQ_PERM)),
                (&a[0]) as u64)
            jnicall.j_del(env, arr)
            jnicall.j_del(env, sc)
        }
        jnicall.j_del(env, ps)
    }
    // 3. the service
    kanaele(env, ctx)
    let it: u64 = dienst_absicht(env, ctx)
    var b: [u64; 1] = [0; 1]
    b[0] = it
    let cn2: u64 = jnicall.j_obj(env, ctx,
        jnicall.j_method(env, cc, t(N_START_FGS), t(G_START_FGS)),
        (&b[0]) as u64)
    jnicall.j_del(env, it)
    jnicall.j_del(env, cc)
    let ok2: bool = cn2 != 0
    jnicall.j_del(env, cn2)
    if ok2 {
        activity.activity_keep_alive(true)
    }
    return ok2
}

// The foreground service WITHOUT a connection of its own: the program keeps
// its connection itself (FIRNCHAT's relay session) and only needs the
// process to stay when its activity goes. Port 0 = no push thread.
#[no_gc]
fn push_keep() -> bool {
    var empty: [u8; 1] = [0 as u8; 1]
    return push_start((&empty[0]) as u64, 0 as u32)
}

#[no_gc]
fn push_stop() -> bool {
    remember()
    if G_VM == 0 || G_APP == 0 {
        return false
    }
    let env: u64 = jnicall.j_env(G_VM)
    let ctx: u64 = G_APP
    let cc: u64 = jnicall.j_obj_class(env, ctx)
    let it: u64 = dienst_absicht(env, ctx)
    var b: [u64; 1] = [0; 1]
    b[0] = it
    let ok: bool = jnicall.j_bool(env, ctx,
        jnicall.j_method(env, cc, t(N_STOP_SVC), t(G_STOP_SVC)),
        (&b[0]) as u64)
    jnicall.j_del(env, it)
    jnicall.j_del(env, cc)
    activity.activity_keep_alive(false)
    return ok
}

// ---------------------------------------------------------- the thread

// "a.b.c.d" -> the four octets in network order as one u32 (little endian
// memory: a is the lowest octet). 0 = not an address.
#[no_gc]
fn ipv4(p: u64) -> u32 {
    var parts: [u32; 4] = [0; 4]
    var k: usize = 0
    var i: usize = 0
    var digits: usize = 0
    while true {
        let c: u8 = *((p + i as u64) as *mut u8)
        if c >= 48 as u8 && c <= 57 as u8 {
            parts[k] = parts[k] * 10 as u32 + (c - 48 as u8) as u32
            digits = digits + 1
            if parts[k] > 255 as u32 || digits > 3 {
                return 0 as u32
            }
        } else if c == 46 as u8 && digits > 0 && k < 3 {
            k = k + 1
            digits = 0
        } else if (c == 0 as u8 || c == 10 as u8) && k == 3 && digits > 0 {
            break
        } else {
            return 0 as u32
        }
        i = i + 1
    }
    return parts[0] | (parts[1] << 8) | (parts[2] << 16) | (parts[3] << 24)
}

// ------------------------------------------------- the relay by name

// net.dns1 .. net.dns4 into `out` (host order); how many. Android 8+ hides
// them from apps, then this is 0.
#[no_gc]
fn system_dns(out: u64) -> usize {
    var name: [u8; 9] = [0 as u8; 9]
    name[0] = 110 as u8 // n
    name[1] = 101 as u8 // e
    name[2] = 116 as u8 // t
    name[3] = 46 as u8 // .
    name[4] = 100 as u8 // d
    name[5] = 110 as u8 // n
    name[6] = 115 as u8 // s
    var val: [u8; 92] = [0 as u8; 92]
    var got: usize = 0
    var k: usize = 1
    while k <= 4 {
        name[7] = (48 + k) as u8
        name[8] = 0 as u8
        val[0] = 0 as u8
        let n: i32 = system_property_get((&name[0]) as u64, (&val[0]) as u64)
        if n > 0 {
            let a: u32 = ipv4((&val[0]) as u64)
            if a != 0 as u32 {
                *((out + (got * 4) as u64) as *mut u32) = (a << 24)
                | ((a & 65280 as u32) << 8) | ((a >> 8) & 65280 as u32)
                | (a >> 24)
                got = got + 1
            }
        }
        k = k + 1
    }
    return got
}

// The name servers to ask: into `servers` (6 u32, host order), how many;
// `port` gets their port.
#[no_gc]
fn dns_servers(servers: *mut [u32; 6], port: *mut u16) -> usize {
    *port = 53 as u16
    let own: u64 = *((G_P + P_DNS) as *mut u64)
    if own != 0 as u64 {
        (*servers)[0] = (own & 4294967295 as u64) as u32
        *port = ((own >> 32) & 65535 as u64) as u16
        return 1
    }
    let count: usize = system_dns((&(*servers)[0]) as u64)
    if count == 0 {
        (*servers)[0] = 134744072 as u32 // 8.8.8.8
        (*servers)[1] = 16843009 as u32 // 1.1.1.1
        return 2
    }
    return count
}

// The relay's host name -> an address in sockaddr representation, 0 = none.
#[no_gc]
fn resolve_relay() -> u32 {
    var servers: [u32; 6] = [0; 6]
    var port: u16 = 53 as u16
    let count: usize = dns_servers(&servers, &port)
    return dnsmini.mini_lookup(G_P + P_HOST, length(G_P + P_HOST),
        (&servers[0]) as u64, count, port, 2000 as u64)
}

// The same for the AAAA record: 16 octets at `out`.
#[no_gc]
fn resolve_relay6(out: u64) -> bool {
    var servers: [u32; 6] = [0; 6]
    var port: u16 = 53 as u16
    let count: usize = dns_servers(&servers, &port)
    return dnsmini.mini_lookup6(G_P + P_HOST, length(G_P + P_HOST),
        (&servers[0]) as u64, count, port, 2000 as u64, out)
}

// "a.b.c.d" or "a.b.c.d:port" (ends at 0 or a line feed) -> the server in
// host order | port << 32 (port 53 when none); 0 = not that.
#[no_gc]
fn dns_spec(p: u64, n: usize) -> u64 {
    var parts: [u32; 4] = [0; 4]
    var k: usize = 0
    var digits: usize = 0
    var i: usize = 0
    var port: u64 = 0
    var in_port: bool = false
    while i < n {
        let c: u8 = *((p + i as u64) as *mut u8)
        if c == 0 as u8 || c == 10 as u8 {
            break
        }
        if c >= 48 as u8 && c <= 57 as u8 {
            if in_port {
                port = port * 10 + (c - 48 as u8) as u64
                if port > 65535 {
                    return 0 as u64
                }
            } else {
                parts[k] = parts[k] * 10 as u32 + (c - 48 as u8) as u32
                if parts[k] > 255 as u32 {
                    return 0 as u64
                }
            }
            digits = digits + 1
        } else if c == 46 as u8 && !in_port && digits > 0 && k < 3 {
            k = k + 1
            digits = 0
        } else if c == 58 as u8 && !in_port && k == 3 && digits > 0 {
            in_port = true
            digits = 0
        } else {
            return 0 as u64
        }
        i = i + 1
    }
    if k != 3 || digits == 0 {
        return 0 as u64
    }
    if !in_port {
        port = 53
    }
    if port == 0 {
        return 0 as u64
    }
    let a: u64 = ((parts[0] << 24) | (parts[1] << 16) | (parts[2] << 8) | parts[3]) as u64
    return a | (port << 32)
}

// Use this name server for the relay's name instead of the system's:
// `spec` is "a.b.c.d" or "a.b.c.d:port" (zero terminated; port 53 when
// none). Call BEFORE push_start; it is kept in firn-push.cfg for the
// restarted service. An empty text or 0 = back to the system's servers.
// false = not an address (nothing changed).
#[no_gc]
fn push_set_dns(spec: u64) -> bool {
    if spec == 0 || *(spec as *mut u8) == 0 as u8 {
        G_DNS = 0 as u64
        return true
    }
    let v: u64 = dns_spec(spec, length(spec))
    if v == 0 as u64 {
        return false
    }
    G_DNS = v
    return true
}

// A TCP connection (family 2 / 10) to the address in `sa`; 10 s at most.
// The descriptor, -1 = failed.
#[no_gc]
fn dial(family: i64, sa: u64, salen: i64) -> i64 {
    let fd: i64 = syscall(41, family, 1, 0, 0, 0, 0)
    if fd < 0 {
        return -1
    }
    var tv: [i64; 2] = [10, 0]
    syscall(54, fd, 1, 21, (&tv[0]) as i64, 16, 0) // SO_SNDTIMEO: the connect
    let r: i64 = syscall(42, fd, sa as i64, salen, 0, 0, 0)
    if r != 0 {
        syscall(3, fd, 0, 0, 0, 0, 0)
        return -1
    }
    return fd
}

// IPv4: struct sockaddr_in: family (2), port (big endian), address, 8 zeroes
#[no_gc]
fn dial4(adr: u32, port: u64) -> i64 {
    var sa: [u8; 16] = [0 as u8; 16]
    sa[0] = 2 as u8
    sa[2] = ((port >> 8) & 255) as u8
    sa[3] = (port & 255) as u8
    *(((&sa[0]) as u64 + 4) as *mut u32) = adr
    return dial(2, (&sa[0]) as u64, 16)
}

// IPv6: struct sockaddr_in6: family (10), port, flow info (4), 16 octets of
// address, scope id (4)
#[no_gc]
fn dial6(adr: u64, port: u64) -> i64 {
    var sa: [u8; 28] = [0 as u8; 28]
    sa[0] = 10 as u8
    sa[2] = ((port >> 8) & 255) as u8
    sa[3] = (port & 255) as u8
    copy((&sa[0]) as u64 + 8 as u64, adr, 16)
    return dial(10, (&sa[0]) as u64, 28)
}

// Use TLS with a pinned key for the relay: `pin` is 64 hex digits (colons
// allowed), zero terminated: the SHA-256 of the relay's public key (see
// lib/tls/tlsmini.fi). Call BEFORE push_start; it is kept in firn-push.cfg.
// An empty text or 0 = plain TCP again. false = not a pin (nothing changed).
#[no_gc]
fn push_set_pin(pin: u64) -> bool {
    if pin == 0 || *(pin as *mut u8) == 0 as u8 {
        G_PIN_ON = 0 as u64
        return true
    }
    if !tlsmini.tlsm_hex_pin(pin, length(pin), (&G_PIN[0]) as u64) {
        return false
    }
    G_PIN_ON = 1 as u64
    return true
}

#[no_gc]
fn join() -> i64 {
    let port: u64 = *((G_P + P_PORT) as *mut u64)
    if port == 0 || port > 65535 {
        return -1
    }
    let lit: u32 = ipv4(G_P + P_HOST)
    if lit != 0 as u32 {
        return dial4(lit, port)
    }
    // a name: the A record, then the AAAA record
    let adr: u32 = resolve_relay()
    if adr != 0 as u32 {
        let fd: i64 = dial4(adr, port)
        if fd >= 0 {
            return fd
        }
    }
    var a6: [u8; 16] = [0 as u8; 16]
    if resolve_relay6((&a6[0]) as u64) {
        let fd6: i64 = dial6((&a6[0]) as u64, port)
        if fd6 >= 0 {
            log(S_L_V6)
            return fd6
        }
    }
    return -1
}

// Read from the relay: through TLS when there is a session, else the socket.
// > 0 octets, 0 = closed, < 0 = error.
#[no_gc]
fn relay_read(fd: i64, tm: *mut tlsmini.TlsM, tls: bool, p: u64, cap: usize) -> i64 {
    if tls {
        return tlsmini.tlsm_read(tm, p, cap)
    }
    return syscall(45, fd, p as i64, cap as i64, 0, 0, 0)
}

#[no_gc]
fn push_thread(arg: u64) -> u64 {
    let env: u64 = jnicall.j_env(G_VM)
    if env == 0 {
        G_RUN = 0
        return 0
    }
    var puf: [u8; 1024] = [0 as u8; 1024]
    let pb: u64 = (&puf[0]) as u64
    var tm: tlsmini.TlsM = tlsmini.tlsm_new()
    while __atomic_add((&G_STOP) as *mut u64, 0) == 0 as u64 {
        var fd: i64 = join()
        var tls: bool = false
        if fd >= 0 && *((G_P + P_TLS) as *mut u64) == 1 as u64 {
            // TLS: the handshake must prove the pinned key before a single
            // octet counts as a message
            var sni: u64 = 0 as u64
            var snil: usize = 0
            if ipv4(G_P + P_HOST) == 0 as u32 {
                sni = G_P + P_HOST
                snil = length(G_P + P_HOST)
            }
            G_SOCK = fd
            let hrc: i32 = tlsmini.tlsm_handshake(&tm, fd, sni, snil, G_P + P_PIN)
            G_SOCK = -1
            if hrc != 0 {
                syscall(3, fd, 0, 0, 0, 0, 0)
                log(S_L_TLSFAIL)
                fd = -1
            } else {
                tls = true
            }
        }
        if fd < 0 {
            var w: usize = 0
            while w < 30 && __atomic_add((&G_STOP) as *mut u64, 0) == 0 as u64 {
                wait_ms(100 as u32)
                w = w + 1
            }
        } else {
            G_SOCK = fd
            if tls {
                log(S_L_TLS)
            } else {
                log(S_L_CONNECTED)
            }
            var n: usize = 0
            while true {
                let r: i64 = relay_read(fd, &tm, tls, pb + n as u64, 1024 - n)
                if r <= 0 {
                    break
                }
                n = n + r as usize
                // every complete line is one message
                var a: usize = 0
                var i: usize = 0
                while i < n {
                    if puf[i] == 10 as u8 {
                        nachricht(env, G_SVC, t(S_MSG_TITLE), pb + a as u64,
                            i - a)
                        a = i + 1
                    }
                    i = i + 1
                }
                if a > 0 {
                    copy(pb, pb + a as u64, n - a)
                    n = n - a
                } else if n == 1024 {
                    // a line longer than the buffer: show what there is
                    nachricht(env, G_SVC, t(S_MSG_TITLE), pb, n)
                    n = 0
                }
            }
            G_SOCK = -1
            syscall(3, fd, 0, 0, 0, 0, 0)
            log(S_L_LOST)
            wait_ms(1000 as u32)
        }
    }
    jnicall.j_detach(G_VM)
    G_RUN = 0
    return 0
}

// Read firn-push.cfg ("host\nport\n") from the service's files directory.
#[no_gc]
fn config_read(env: u64, svc: u64) -> bool {
    let b: u64 = block()
    if b == 0 {
        return false
    }
    let cc: u64 = jnicall.j_obj_class(env, svc)
    let f: u64 = jnicall.j_obj(env, svc,
        jnicall.j_method(env, cc, t(N_FILES_DIR), t(G_FILES_DIR)), 0)
    let fc: u64 = jnicall.j_obj_class(env, f)
    let s: u64 = jnicall.j_obj(env, f,
        jnicall.j_method(env, fc, t(N_ABS_PATH), t(G_STR)), 0)
    let chars: u64 = jnicall.j_utf_chars(env, s)
    var path: [u8; 512] = [0 as u8; 512]
    var ok: bool = false
    if chars != 0 {
        let dn: usize = length(chars)
        let cn: usize = length(t(S_CFG))
        if dn + cn + 1 <= 512 {
            copy((&path[0]) as u64, chars, dn)
            copy((&path[0]) as u64 + dn as u64, t(S_CFG), cn + 1)
            ok = true
        }
        jnicall.j_utf_release(env, s, chars)
    }
    jnicall.j_del(env, s)
    jnicall.j_del(env, fc)
    jnicall.j_del(env, f)
    jnicall.j_del(env, cc)
    if !ok {
        return false
    }
    var content: [u8; 256] = [0 as u8; 256]
    let fd: i64 = syscall(2, (&path[0]) as i64, 0, 0, 0, 0, 0)
    if fd < 0 {
        return false
    }
    let n: i64 = syscall(0, fd, (&content[0]) as i64, 255, 0, 0, 0)
    syscall(3, fd, 0, 0, 0, 0, 0)
    if n <= 0 {
        return false
    }
    var i: usize = 0
    while i < n as usize && content[i] != 10 as u8 && i < 63 {
        *((b + P_HOST + i as u64) as *mut u8) = content[i]
        i = i + 1
    }
    *((b + P_HOST + i as u64) as *mut u8) = 0 as u8
    i = i + 1
    var port: u64 = 0
    while i < n as usize && content[i] >= 48 as u8 && content[i] <= 57 as u8 {
        port = port * 10 + (content[i] - 48 as u8) as u64
        i = i + 1
    }
    *((b + P_PORT) as *mut u64) = port
    // optional third line: the name server "a.b.c.d[:port]"
    *((b + P_DNS) as *mut u64) = 0 as u64
    while i < n as usize && content[i] != 10 as u8 {
        i = i + 1
    }
    i = i + 1
    if i < n as usize {
        *((b + P_DNS) as *mut u64) = dns_spec((&content[0]) as u64 + i as u64,
            n as usize - i)
    }
    // optional fourth line: the key pin (TLS)
    *((b + P_TLS) as *mut u64) = 0 as u64
    while i < n as usize && content[i] != 10 as u8 {
        i = i + 1
    }
    i = i + 1
    if i < n as usize {
        var pe: usize = i
        while pe < n as usize && content[pe] != 10 as u8 {
            pe = pe + 1
        }
        if tlsmini.tlsm_hex_pin((&content[0]) as u64 + i as u64, pe - i, b + P_PIN) {
            *((b + P_TLS) as *mut u64) = 1 as u64
        }
    }
    return port > 0
}

// ------------------------------------------- the service (main thread)

#[export_c]
#[no_gc]
fn Java_org_firn_FirnService_onStartCommand(env: u64, svc: u64, intent: u64,
    flags: i32, id: i32) -> i32 {
    log(S_L_START)
    G_VM = jnicall.j_vm(env)
    if G_SVC == 0 {
        G_SVC = jnicall.j_global(env, svc)
    }
    kanaele(env, svc)
    // Within five seconds of startForegroundService, or Android kills us.
    let note: u64 = build(env, svc, S_CH_SVC, t(S_SVC_TITLE), t(S_SVC_TEXT),
        true)
    let cc: u64 = jnicall.j_obj_class(env, svc)
    var a: [u64; 3] = [0; 3]
    a[0] = SVC_NOTE_ID
    a[1] = note
    a[2] = FGS_TYPE_REMOTE_MESSAGING
    let ok: bool = jnicall.j_void(env, svc,
        jnicall.j_method(env, cc, t(N_START_FG), t(G_START_FG)),
        (&a[0]) as u64)
    jnicall.j_del(env, cc)
    jnicall.j_del(env, note)
    if G_RUN == 0 {
        if config_read(env, svc) {
            G_STOP = 0
            G_RUN = 1
            let r: i32 = pthread_create(G_P + P_TID, 0,
                ndk.code_of_thread(push_thread), 0)
            if r != 0 {
                G_RUN = 0
            }
        } else {
            log(S_L_NOCFG)
        }
    }
    return START_STICKY
}

#[export_c]
#[no_gc]
fn Java_org_firn_FirnService_onBind(env: u64, svc: u64, intent: u64) -> u64 {
    return 0
}

#[export_c]
#[no_gc]
fn Java_org_firn_FirnService_onDestroy(env: u64, svc: u64) {
    log(S_L_STOP)
    __atomic_add((&G_STOP) as *mut u64, 1)
    if G_SOCK >= 0 {
        // shutdown wakes the thread out of its recv
        syscall(48, G_SOCK, 2, 0, 0, 0, 0)
    }
}
