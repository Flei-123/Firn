// SPDX-License-Identifier: MPL-2.0
// lib/plat/sysfont.fi -- THE TEXT FACE THE SYSTEM ALREADY HAS.
//
// Every fUi program so far opened
// /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf by name. That path is a
// Debian path: on a phone it does not exist, and a program that wants to
// run on both would need a second `main`. This file is the one place that
// knows where faces lie, tried in order, the first that loads wins:
//
//   Linux    DejaVu Sans (fonts-dejavu-core; the face of every reference
//            picture of lib/fui, so desktop output stays pixel identical)
//   Android  RobotoStatic-Regular.ttf first: Roboto-Regular.ttf is a
//            VARIABLE font from Android 12 on (fvar/gvar), and lib/font
//            reads only the default instance of it -- right by accident.
//            Measured by Certus round FONT on Android 15: RobotoStatic is
//            305,656 octets, 3,359 glyphs, no variable table.
//            /system/fonts is world readable, no permission needed.
//
// The octets stay in memory for as long as the program runs: a FontSet
// points into them.
import std.rt
import font.metrics

export { sysfont_load, sysfont_path }

// The candidates, zero separated, in the order they are tried.
fn kandidat(i: usize, out: *mut rt.Buf) -> bool {
    if i == 0 {
        var a: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
        rt.buf_push_bytes(out, (&a[0]) as u64, 48)
        return true
    }
    if i == 1 {
        var b: [u8; 39] = "/system/fonts/RobotoStatic-Regular.ttf\0"
        rt.buf_push_bytes(out, (&b[0]) as u64, 39)
        return true
    }
    if i == 2 {
        var c: [u8; 33] = "/system/fonts/Roboto-Regular.ttf\0"
        rt.buf_push_bytes(out, (&c[0]) as u64, 33)
        return true
    }
    if i == 3 {
        var d: [u8; 35] = "/system/fonts/NotoSans-Regular.ttf\0"
        rt.buf_push_bytes(out, (&d[0]) as u64, 35)
        return true
    }
    if i == 4 {
        var e: [u8; 28] = "/system/fonts/DroidSans.ttf\0"
        rt.buf_push_bytes(out, (&e[0]) as u64, 28)
        return true
    }
    return false
}

static mut G_WELCHER: usize = 99

// Load the first face that is there into `fs`. False = none of them.
fn sysfont_load(fs: *mut metrics.FontSet) -> bool {
    *fs = metrics.fontset_new()
    var i: usize = 0
    while i < 16 {
        var pfad: rt.Buf = rt.buf_new()
        if !kandidat(i, &pfad) {
            rt.buf_free(&pfad)
            return false
        }
        var daten: rt.Buf = rt.buf_new()
        let da: bool = rt.read_file(rt.buf_ptr(&pfad), &daten)
        rt.buf_free(&pfad)
        if da && rt.buf_len(&daten) > 1024 {
            if metrics.fontset_load(fs, rt.buf_ptr(&daten) as *mut u8,
                rt.buf_len(&daten)) {
                G_WELCHER = i
                return true
            }
        }
        rt.buf_free(&daten)
        *fs = metrics.fontset_new()
        i = i + 1
    }
    return false
}

// Which path was loaded (a zero terminated string written into `out`),
// false = none yet.
fn sysfont_path(out: *mut rt.Buf) -> bool {
    return kandidat(G_WELCHER, out)
}
