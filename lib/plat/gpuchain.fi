// SPDX-License-Identifier: MPL-2.0
// lib/plat/gpuchain.fi -- plat.gpuchain: WHICH PAINT PATH comes next (W42-b). Pure functions, no I/O, no imports: the decisions of
// the fUi window host (lib/plat/fuiwin.fi, lib/plat/fuiwinvk.fi) live here so a test can walk every case (tools/fui/gpuchain_main.fi).
//
// THE CHAIN. Three paint paths, tried in an order the POLICY gives; the first that opens wins, a path that fails at open hands over
// to the next, the CPU painter is always last and never fails:
//     GL      the window layer's own OpenGL (Windows WGL, Android EGL)           -- STAGE_GL
//     VULKAN  the provider (lib/plat/fuiwinvk.fi): Vulkan, shown by swapchain present or by read-back + CPU present -- STAGE_VULKAN
//     CPU     lib/fui/raster.fi into memory                                     -- STAGE_CPU
// policies (FUI_GPU):  "0" CPU | "1" VULKAN (any device, also lavapipe) then GL | "gl" GL then VULKAN (real GPU only) |
//                      "vk" VULKAN (real GPU only) then GL | unset / anything else = the platform default (Windows: GL, VULKAN, CPU;
//                      every other platform: CPU, the reference painter).
// Later failures (not in this file): Vulkan swapchain stops showing -> read-back (same GPU); Vulkan device lost -> CPU for the run;
// GL context lost -> the chain starts again from the top.

export { POLICY_CPU, POLICY_VULKAN, POLICY_GL_FIRST, POLICY_VULKAN_FIRST, STAGE_CPU, STAGE_GL, STAGE_VULKAN,
    policy_of, default_policy, plan_force, plan_allow_cpu, plan_provider, next_stage, stage_bit, stage_name }

const POLICY_CPU: i32 = 0 // FUI_GPU=0
const POLICY_VULKAN: i32 = 1 // FUI_GPU=1: Vulkan first (any device), then the window's OpenGL, then the CPU
const POLICY_GL_FIRST: i32 = 2 // window's own OpenGL first, Vulkan (real GPU only) second, CPU last
const POLICY_VULKAN_FIRST: i32 = 3 // Vulkan on a real GPU first, the window's OpenGL second, CPU last

const STAGE_CPU: i32 = 0
const STAGE_GL: i32 = 1
const STAGE_VULKAN: i32 = 2

// The platform default when FUI_GPU says nothing (`platform` = vkplat.plat_name()): Windows measured GL 1.40 ms < Vulkan present 1.73 ms
// < CPU 11.9 ms at 1080p (docs/fui-gpu-path.md), other platforms keep the CPU painter as the default.
fn default_policy(platform: str) -> i32 {
    if platform == "win32" {
        return POLICY_GL_FIRST
    }
    return POLICY_CPU
}

// FUI_GPU (the environment value, "" = unset) + the platform -> policy
fn policy_of(env_gpu: str, platform: str) -> i32 {
    if env_gpu == "0" {
        return POLICY_CPU
    }
    if env_gpu == "1" {
        return POLICY_VULKAN
    }
    if env_gpu == "gl" {
        return POLICY_GL_FIRST
    }
    if env_gpu == "vk" {
        return POLICY_VULKAN_FIRST
    }
    return default_policy(platform)
}

// Does the policy install the Vulkan provider at all (the CPU policy does not)?
fn plan_provider(policy: i32) -> bool {
    return policy == POLICY_VULKAN || policy == POLICY_GL_FIRST || policy == POLICY_VULKAN_FIRST
}

// Is Vulkan tried BEFORE the window layer's own GL?
fn plan_force(policy: i32) -> bool {
    return policy == POLICY_VULKAN || policy == POLICY_VULKAN_FIRST
}

// May the Vulkan device be a CPU (lavapipe/llvmpipe)? Only when the program asked for Vulkan outright (FUI_GPU=1): the automatic
// modes must never pick a software device (it is slower than the CPU painter).
fn plan_allow_cpu(policy: i32) -> bool {
    return policy == POLICY_VULKAN
}

// The next stage to try. `tried` = bit mask of stages already tried (`stage_bit` of each), `provider` = a Vulkan
// provider is installed, `force` = Vulkan goes before GL. STAGE_CPU = nothing left, the CPU painter paints.
fn next_stage(tried: i32, provider: bool, force: bool) -> i32 {
    var first: i32 = STAGE_GL
    var second: i32 = STAGE_VULKAN
    if force {
        first = STAGE_VULKAN
        second = STAGE_GL
    }
    if stage_open(tried, first, provider) {
        return first
    }
    if stage_open(tried, second, provider) {
        return second
    }
    return STAGE_CPU
}

// 1 = GL, 2 = Vulkan, 0 = CPU: OR these into `tried`
fn stage_bit(st: i32) -> i32 {
    if st == STAGE_GL {
        return 1
    }
    if st == STAGE_VULKAN {
        return 2
    }
    return 0
}

fn stage_open(tried: i32, st: i32, provider: bool) -> bool {
    if (tried & stage_bit(st)) != 0 {
        return false
    }
    if st == STAGE_VULKAN && !provider {
        return false
    }
    return true
}

fn stage_name(st: i32) -> str {
    if st == STAGE_GL {
        return "gl"
    }
    if st == STAGE_VULKAN {
        return "vulkan"
    }
    return "cpu"
}
