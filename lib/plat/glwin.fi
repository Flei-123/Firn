fn glTexSubImage2D(t: u32, l: i32, x: i32, y: i32, w: i32, h: i32, fmt: u32, ty: u32, p: u64) { wgl.call9(fnp(33, "glTexSubImage2D"), t as u64, l as u64, x as u64, y as u64, w as u64, h as u64, fmt as u64, ty as u64, p as u64) }
