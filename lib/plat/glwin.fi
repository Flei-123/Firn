const GL_COMPILE_STATUS: u32 = 35713
const GL_LINK_STATUS: u32 = 35714
const GL_UNPACK_ALIGNMENT: u32 = 3317
const GL_UNPACK_ROW_LENGTH: u32 = 3314
const GL_PACK_ALIGNMENT: u32 = 3333
const GL_COLOR: u32 = 6144
const GL_RGBA: u32 = 6408
const GL_UNSIGNED_BYTE: u32 = 5121

// Scratch for the vector forms: four f32, and the kept clear colour.
static mut G_V: [f32; 4] = [0.0; 4]
static mut G_CLEAR: [f32; 4] = [0.0; 4]
// One name in and out of glGen* / glDelete*.
static mut G_NAME: [u32; 2] = [0 as u32; 2]
// A uniform's name with its terminating zero (glGetUniformLocation wants C).
static mut G_CNAME: [u8; 128] = [0 as u8; 128]

fn one_new(kind: u32) -> u64 {
    G_NAME[0] = 0 as u32
    let p: u64 = (&G_NAME[0]) as u64
    if kind == gl.GLK_BUFFER {
        glGenBuffers(1, p)
    } else if kind == gl.GLK_TEXTURE {
        glGenTextures(1, p)
    } else if kind == gl.GLK_FRAMEBUFFER {
        glGenFramebuffers(1, p)
    } else if kind == gl.GLK_VERTEX_ARRAY {
        glGenVertexArrays(1, p)
    }
    return G_NAME[0] as u64
}

fn shader(ty: u32, src: u64, n: usize, lp: u64, lcap: usize) -> u32 {
    let sh: u32 = glCreateShader(ty)
    if sh == 0 as u32 {
        return 0 as u32
    }
    var ptrs: [u64; 1] = [src]
    var lens: [i32; 1] = [n as i32]
    glShaderSource(sh, 1, (&ptrs[0]) as u64, (&lens[0]) as u64)
    glCompileShader(sh)
    var ok: [i32; 1] = [0]
    glGetShaderiv(sh, GL_COMPILE_STATUS, (&ok[0]) as u64)
    if ok[0] == 0 {
        if lp != 0 && lcap > 1 {
            var got: [i32; 1] = [0]
            glGetShaderInfoLog(sh, (lcap - 1) as i32, (&got[0]) as u64, lp)
        }
        glDeleteShader(sh)
        return 0 as u32
    }
    return sh
}

fn g_program(vp: u64, vn: usize, fp: u64, fnn: usize, lp: u64, lcap: usize) -> u64 {
    if lp != 0 && lcap > 0 {
        rt.mem_set(lp, 0 as u8, lcap)
    }
    let vs: u32 = shader(gl.GL_VERTEX_SHADER, vp, vn, lp, lcap)
    if vs == 0 as u32 {
        return 0
    }
    let fs: u32 = shader(gl.GL_FRAGMENT_SHADER, fp, fnn, lp, lcap)
    if fs == 0 as u32 {
        glDeleteShader(vs)
        return 0
    }
    let p: u32 = glCreateProgram()
    glAttachShader(p, vs)
    glAttachShader(p, fs)
    glLinkProgram(p)
    glDeleteShader(vs)
    glDeleteShader(fs)
    var ok: [i32; 1] = [0]
    glGetProgramiv(p, GL_LINK_STATUS, (&ok[0]) as u64)
    if ok[0] == 0 {
        if lp != 0 && lcap > 1 {
            var got: [i32; 1] = [0]
            glGetProgramInfoLog(p, (lcap - 1) as i32, (&got[0]) as u64, lp)
        }
        glDeleteProgram(p)
        return 0
    }
    return p as u64
}
fn g_use_program(p: u64) { glUseProgram(p as u32) }
fn g_uniform_location(p: u64, np: u64, nn: usize) -> u64 {
    var n: usize = nn
    if n > 127 { n = 127 }
    rt.mem_copy((&G_CNAME[0]) as u64, np, n)
    G_CNAME[n] = 0 as u8
    // -1 (no such uniform) stays -1 through the table: GL ignores it
    return (glGetUniformLocation(p as u32, (&G_CNAME[0]) as u64) as i64) as u64
}
fn g_uniform1i(l: u64, v: i64) { glUniform1i(l as i32, v as i32) }
fn g_uniform1f(l: u64, v: f64) {
    G_V[0] = v as f32
    glUniform1fv(l as i32, 1, (&G_V[0]) as u64)
}
fn g_uniform2f(l: u64, x: f64, y: f64) {
    G_V[0] = x as f32
    G_V[1] = y as f32
    glUniform2fv(l as i32, 1, (&G_V[0]) as u64)
}
fn g_uniform4f(l: u64, x: f64, y: f64, z: f64, q: f64) {
    G_V[0] = x as f32
    G_V[1] = y as f32
    G_V[2] = z as f32
    G_V[3] = q as f32
    glUniform4fv(l as i32, 1, (&G_V[0]) as u64)
}
fn g_create_buffer() -> u64 { return one_new(gl.GLK_BUFFER) }
fn g_bind_buffer(t: u64, b: u64) { glBindBuffer(t as u32, b as u32) }
fn g_buffer_data(t: u64, p: u64, n: usize, u: u64) { glBufferData(t as u32, n as i64, p, u as u32) }
fn g_buffer_sub_data(t: u64, off: usize, p: u64, n: usize) {
    glBufferSubData(t as u32, off as i64, n as i64, p)
}
fn g_create_vertex_array() -> u64 { return one_new(gl.GLK_VERTEX_ARRAY) }
fn g_bind_vertex_array(v: u64) { glBindVertexArray(v as u32) }
fn g_enable_vertex_attrib_array(i: u64) { glEnableVertexAttribArray(i as u32) }
fn g_vertex_attrib_pointer(i: u64, size: i64, ty: u64, norm: u64, stride: i64, off: usize) {
    glVertexAttribPointer(i as u32, size as i32, ty as u32, norm as u32, stride as i32, off as u64)
}
fn g_vertex_attrib_divisor(i: u64, d: u64) { glVertexAttribDivisor(i as u32, d as u32) }
fn g_create_texture() -> u64 { return one_new(gl.GLK_TEXTURE) }
fn g_bind_texture(t: u64, tex: u64) { glBindTexture(t as u32, tex as u32) }
fn g_active_texture(u: u64) { glActiveTexture(u as u32) }
fn g_tex_image_2d(t: u64, l: i64, ifmt: u64, w: i64, h: i64, fmt: u64, ty: u64, p: u64, n: usize) {
    glPixelStorei(GL_UNPACK_ALIGNMENT, 1)
    glTexImage2D(t as u32, l as i32, ifmt as i32, w as i32, h as i32, 0, fmt as u32, ty as u32, p)
}
fn g_tex_sub_image_2d(t: u64, l: i64, x: i64, y: i64, w: i64, h: i64, fmt: u64, ty: u64,
    p: u64, n: usize, rl: i64) {
    glPixelStorei(GL_UNPACK_ALIGNMENT, 1)
    glPixelStorei(GL_UNPACK_ROW_LENGTH, rl as i32)
    glTexSubImage2D(t as u32, l as i32, x as i32, y as i32, w as i32, h as i32, fmt as u32,
        ty as u32, p)
    glPixelStorei(GL_UNPACK_ROW_LENGTH, 0)
}
fn g_tex_parameteri(t: u64, pn: u64, v: i64) { glTexParameteri(t as u32, pn as u32, v as i32) }
fn g_create_framebuffer() -> u64 { return one_new(gl.GLK_FRAMEBUFFER) }
fn g_bind_framebuffer(t: u64, f: u64) { glBindFramebuffer(t as u32, f as u32) }
fn g_framebuffer_texture_2d(t: u64, at: u64, tt: u64, tex: u64, l: i64) {
    glFramebufferTexture2D(t as u32, at as u32, tt as u32, tex as u32, l as i32)
}
fn g_check_framebuffer_status(t: u64) -> u64 { return glCheckFramebufferStatus(t as u32) as u64 }
fn g_blit_framebuffer(x0: i64, y0: i64, x1: i64, y1: i64, a0: i64, b0: i64, a1: i64, b1: i64,
    m: u64, fl: u64) {
    glBlitFramebuffer(x0 as i32, y0 as i32, x1 as i32, y1 as i32, a0 as i32, b0 as i32,
        a1 as i32, b1 as i32, m as u32, fl as u32)
}
fn g_copy_tex_sub_image_2d(t: u64, l: i64, xo: i64, yo: i64, x: i64, y: i64, w: i64, h: i64) {
    glCopyTexSubImage2D(t as u32, l as i32, xo as i32, yo as i32, x as i32, y as i32,
        w as i32, h as i32)
}
fn g_viewport(x: i64, y: i64, w: i64, h: i64) { glViewport(x as i32, y as i32, w as i32, h as i32) }
fn g_scissor(x: i64, y: i64, w: i64, h: i64) { glScissor(x as i32, y as i32, w as i32, h as i32) }
fn g_enable(c: u64) { glEnable(c as u32) }
fn g_disable(c: u64) { glDisable(c as u32) }
fn g_blend_func_separate(a0: u64, b0: u64, c0: u64, d0: u64) {
    glBlendFuncSeparate(a0 as u32, b0 as u32, c0 as u32, d0 as u32)
}
fn g_clear_color(r: f64, g: f64, b: f64, al: f64) {
    G_CLEAR[0] = r as f32
    G_CLEAR[1] = g as f32
    G_CLEAR[2] = b as f32
    G_CLEAR[3] = al as f32
}
// Only the colour buffer is ever cleared (gpu.fi): glClearBufferfv with
// the kept colour -- it honours the scissor exactly as glClear does.
fn g_clear(m: u64) {
    if (m as u32 & gl.GL_COLOR_BUFFER_BIT) != 0 as u32 {
        glClearBufferfv(GL_COLOR, 0, (&G_CLEAR[0]) as u64)
    }
}
fn g_draw_arrays(m: u64, f: i64, c: i64) { glDrawArrays(m as u32, f as i32, c as i32) }
fn g_draw_arrays_instanced(m: u64, f: i64, c: i64, n: i64) {
    glDrawArraysInstanced(m as u32, f as i32, c as i32, n as i32)
}
fn g_read_pixels(x: i64, y: i64, w: i64, h: i64, p: u64) {
    glPixelStorei(GL_PACK_ALIGNMENT, 1)
    glReadPixels(x as i32, y as i32, w as i32, h as i32, GL_RGBA, GL_UNSIGNED_BYTE, p)
}
fn g_delete(kind: u64, id: u64) {
    if id == 0 {
        return
    }
    G_NAME[0] = id as u32
    let p: u64 = (&G_NAME[0]) as u64
    let k: u32 = kind as u32
    if k == gl.GLK_TEXTURE {
        glDeleteTextures(1, p)
    } else if k == gl.GLK_BUFFER {
        glDeleteBuffers(1, p)
    } else if k == gl.GLK_FRAMEBUFFER {
        glDeleteFramebuffers(1, p)
    } else if k == gl.GLK_PROGRAM {
        glDeleteProgram(id as u32)
    } else if k == gl.GLK_SHADER {
        glDeleteShader(id as u32)
    } else if k == gl.GLK_VERTEX_ARRAY {
        glDeleteVertexArrays(1, p)
    }
}
fn g_get_error() -> u64 { return glGetError() as u64 }
fn g_finish() { glFinish() }

// The table, filled. The caller (the window backend) has made a GLES 3
// context current on this thread; `ok` says the table may be used.
fn gles_api(t: *mut gl.GlApi) {
    *t = gl.gl_api_new()
    (*t).program = g_program
    (*t).use_program = g_use_program
    (*t).uniform_location = g_uniform_location
    (*t).uniform1i = g_uniform1i
    (*t).uniform1f = g_uniform1f
    (*t).uniform2f = g_uniform2f
    (*t).uniform4f = g_uniform4f
    (*t).create_buffer = g_create_buffer
    (*t).bind_buffer = g_bind_buffer
    (*t).buffer_data = g_buffer_data
    (*t).buffer_sub_data = g_buffer_sub_data
    (*t).create_vertex_array = g_create_vertex_array
    (*t).bind_vertex_array = g_bind_vertex_array
    (*t).enable_vertex_attrib_array = g_enable_vertex_attrib_array
    (*t).vertex_attrib_pointer = g_vertex_attrib_pointer
    (*t).vertex_attrib_divisor = g_vertex_attrib_divisor
    (*t).create_texture = g_create_texture
    (*t).bind_texture = g_bind_texture
    (*t).active_texture = g_active_texture
    (*t).tex_image_2d = g_tex_image_2d
    (*t).tex_sub_image_2d = g_tex_sub_image_2d
    (*t).tex_parameteri = g_tex_parameteri
    (*t).create_framebuffer = g_create_framebuffer
    (*t).bind_framebuffer = g_bind_framebuffer
    (*t).framebuffer_texture_2d = g_framebuffer_texture_2d
    (*t).check_framebuffer_status = g_check_framebuffer_status
