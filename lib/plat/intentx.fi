// SPDX-License-Identifier: MPL-2.0
// lib/plat/intentx.fi -- start extras ("intent extras") of the program, portable. Android: the extras of the Intent that started
// the activity (lib/@android/plat/intentx.fi, JNI); everywhere else the environment variable INTENT_<KEY> (key in upper case).
//
//     intentx.ix_str("tab", "list")      string extra or the default
//     intentx.ix_int("autoscroll", 0)    int extra or the default
//     intentx.ix_bool("autorun", false)  boolean extra or the default ("1"/"true" on the desktop)
import std.rt
import std.env

export { ix_str, ix_int, ix_bool }

fn upper(s: str) -> str {
    var b: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < s.n {
        var c: u8 = *((s.p as u64 + i as u64) as *mut u8)
        if c >= 97 as u8 && c <= 122 as u8 { c = c - 32 as u8 }
        rt.buf_push(&b, c)
        i = i + 1
    }
    let r: str = __str_copy(str { p: rt.buf_data(&b), n: rt.buf_len(&b) })
    rt.buf_free(&b)
    return r
}

fn ix_str(key: str, dflt: str) -> str {
    let v: str = env.get("INTENT_" + upper(key))
    if v.n == 0 { return dflt }
    return v
}

fn ix_int(key: str, dflt: i64) -> i64 {
    let v: str = ix_str(key, "")
    if v.n == 0 { return dflt }
    var r: i64 = 0
    var neg: bool = false
    var i: usize = 0
    if *(v.p as *mut u8) == 45 as u8 {
        neg = true
        i = 1
    }
    while i < v.n {
        let c: u8 = *((v.p as u64 + i as u64) as *mut u8)
        if c < 48 as u8 || c > 57 as u8 { return dflt }
        r = r * 10 + (c as i64 - 48)
        i = i + 1
    }
    if neg { return 0 - r }
    return r
}

fn ix_bool(key: str, dflt: bool) -> bool {
    let v: str = ix_str(key, "")
    if v.n == 0 { return dflt }
    return v == "1" || v == "true"
}
