// SPDX-License-Identifier: MPL-2.0
export {
    web_audio_open, web_audio_room, web_audio_push, web_audio_queued, web_audio_pause, web_audio_flush,
    web_audio_close, web_audio_state, web_audio_mode, web_audio_played, web_audio_latency,
    STATE_NONE, STATE_WAITING, STATE_RUNNING, MODE_NONE, MODE_WORKLET, MODE_SCRIPT,
}

const STATE_NONE: u32 = 0
const STATE_WAITING: u32 = 1
const STATE_RUNNING: u32 = 2
const MODE_NONE: u32 = 0
const MODE_WORKLET: u32 = 1
const MODE_SCRIPT: u32 = 2

extern fn firn_web_audio_open(rate: u32, channels: u32) -> u32;
extern fn firn_web_audio_room(id: u32) -> u32;
extern fn firn_web_audio_push(id: u32, p: u32, frames: u32) -> u32;
extern fn firn_web_audio_queued(id: u32) -> u32;
extern fn firn_web_audio_pause(id: u32, on: u32) -> u32;
extern fn firn_web_audio_flush(id: u32) -> u32;
extern fn firn_web_audio_close(id: u32);
extern fn firn_web_audio_state(id: u32) -> u32;
extern fn firn_web_audio_mode(id: u32) -> u32;
extern fn firn_web_audio_played(id: u32) -> u32;
extern fn firn_web_audio_latency(id: u32) -> u32;

fn web_audio_open(rate: u32, channels: u32) -> u32 {
    return firn_web_audio_open(rate, channels)
}

fn web_audio_room(id: u32) -> usize {
    return firn_web_audio_room(id) as usize
}

fn web_audio_push(id: u32, p: u64, frames: usize) -> usize {
    return firn_web_audio_push(id, p as u32, frames as u32) as usize
}

fn web_audio_queued(id: u32) -> usize {
    return firn_web_audio_queued(id) as usize
}

fn web_audio_pause(id: u32, on: bool) -> bool {
    var v: u32 = 0 as u32
    if on {
        v = 1 as u32
    }
    return firn_web_audio_pause(id, v) != 0 as u32
}

fn web_audio_flush(id: u32) -> bool {
    return firn_web_audio_flush(id) != 0 as u32
}

fn web_audio_close(id: u32) {
    firn_web_audio_close(id)
}

fn web_audio_state(id: u32) -> u32 {
    return firn_web_audio_state(id)
}

fn web_audio_mode(id: u32) -> u32 {
    return firn_web_audio_mode(id)
}

fn web_audio_played(id: u32) -> u32 {
    return firn_web_audio_played(id)
}

fn web_audio_latency(id: u32) -> usize {
    return firn_web_audio_latency(id) as usize
}
