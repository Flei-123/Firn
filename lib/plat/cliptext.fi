// lib/plat/cliptext.fi -- put UTF-8 text on the SYSTEM clipboard, ONE API on every platform.
//
//     import plat.cliptext
//
//   cliptext.clip_put(p, n)    text p[0, n) -> system clipboard, true = done
//
// This file is the generic one: no system clipboard known here (the caller uses window.clipboard_set). The Android program gets the
// real one from lib/@android/plat/cliptext.fi (ClipboardManager through JNI, plat.android.share).
export { clip_put, CLIP_NATIVE }

const CLIP_NATIVE: bool = false

fn clip_put(p: u64, n: usize) -> bool { return false }
