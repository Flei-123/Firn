// SPDX-License-Identifier: MPL-2.0
// lib/plat/uifont.fi -- THE UI FACE FAMILY (Inter, SIL OFL 1.1) AND THE MONOSPACE FACE.
//
// `lib/plat/sysfont.fi` finds the face the SYSTEM has. This file finds the faces fUi
// ships (lib/fui/fonts/Inter-*.ttf, subsets of Inter 4.0) and loads them on demand,
// one file per weight, so a program that never asks pays nothing for them.
//
// Where the family is looked for, first hit wins (a directory holding Inter-Regular.ttf):
//   $FUI_FONT_DIR            an explicit choice
//   $FIRNLIB/fui/fonts       the library tree (what a `firnc` build runs against)
//   /usr/share/fonts/truetype/inter, /usr/local/share/fonts   a system install
// No directory = `family_dir` is false and the caller keeps the system face.
import std.rt
import font.metrics
import plat.envvar

export { FACE_COUNT, face_weight, load_face, family_dir, load_mono }

const FACE_COUNT: usize = 4

fn face_weight(i: usize) -> usize {
    if i == 0 { return 400 }
    if i == 1 { return 500 }
    if i == 2 { return 600 }
    return 700
}

fn face_file(i: usize) -> str {
    if i == 0 { return "Inter-Regular.ttf" }
    if i == 1 { return "Inter-Medium.ttf" }
    if i == 2 { return "Inter-SemiBold.ttf" }
    return "Inter-Bold.ttf"
}

fn push_str(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn dir_from_env(i: usize, out: *mut rt.Buf) -> bool {
    var v: [u8; 512] = [0 as u8; 512]
    var n: usize = 0
    if i == 0 { n = envvar.env_value_copy("FUI_FONT_DIR", (&v[0]) as u64, 512) }
    if i == 1 { n = envvar.env_value_copy("FIRNLIB", (&v[0]) as u64, 512) }
    if n == 0 { return false }
    rt.buf_push_bytes(out, (&v[0]) as u64, n)
    if i == 1 { push_str(out, "/fui/fonts") }
    return true
}

fn dir_candidate(i: usize, out: *mut rt.Buf) -> bool {
    if i < 2 { return dir_from_env(i, out) }
    if i == 2 {
        push_str(out, "/usr/share/fonts/truetype/inter")
        return true
    }
    if i == 3 {
        push_str(out, "/usr/local/share/fonts")
        return true
    }
    return false
}

fn file_in(i: usize, face: usize, out: *mut rt.Buf) -> bool {
    if !dir_candidate(i, out) { return false }
    push_str(out, "/")
    push_str(out, face_file(face))
    rt.buf_push(out, 0 as u8)
    return true
}

fn read_face(path: *mut rt.Buf, fs: *mut metrics.FontSet) -> bool {
    var data: rt.Buf = rt.buf_new()
    if rt.read_file(rt.buf_ptr(path), &data) && rt.buf_len(&data) > 1024 {
        *fs = metrics.fontset_new()
        if metrics.fontset_load(fs, rt.buf_ptr(&data) as *mut u8, rt.buf_len(&data)) { return true }
    }
    rt.buf_free(&data)
    return false
}

static mut FAMILY_DIR: usize = 99

// Is there an Inter family at all? Cached after the first probe.
fn family_dir() -> bool {
    if FAMILY_DIR != 99 { return FAMILY_DIR != 98 }
    var i: usize = 0
    FAMILY_DIR = 98
    while i < 4 {
        var p: rt.Buf = rt.buf_new()
        if file_in(i, 0, &p) {
            var probe: rt.Buf = rt.buf_new()
            if rt.read_file(rt.buf_ptr(&p), &probe) { FAMILY_DIR = i }
            rt.buf_free(&probe)
        }
        rt.buf_free(&p)
        if FAMILY_DIR != 98 { return true }
        i = i + 1
    }
    return false
}

// Face `face` (0..FACE_COUNT-1, weights 400/500/600/700) of the family into `fs`. False = not found.
fn load_face(face: usize, fs: *mut metrics.FontSet) -> bool {
    if face >= FACE_COUNT || !family_dir() { return false }
    var p: rt.Buf = rt.buf_new()
    var ok: bool = false
    if file_in(FAMILY_DIR, face, &p) { ok = read_face(&p, fs) }
    rt.buf_free(&p)
    return ok
}

fn mono_candidate(i: usize) -> str {
    if i == 0 { return "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf\0" }
    if i == 1 { return "/system/fonts/DroidSansMono.ttf\0" }
    if i == 2 { return "C:/Windows/Fonts/consola.ttf\0" }
    if i == 3 { return "C:/Windows/Fonts/cour.ttf\0" }
    return ""
}

// The monospace face the machine has (DejaVu Sans Mono, Droid Sans Mono, Consolas, Courier New). False = none.
fn load_mono(fs: *mut metrics.FontSet) -> bool {
    var i: usize = 0
    while i < 4 {
        let s: str = mono_candidate(i)
        var p: rt.Buf = rt.buf_new()
        push_str(&p, s)
        let ok: bool = read_face(&p, fs)
        rt.buf_free(&p)
        if ok { return true }
        i = i + 1
    }
    *fs = metrics.fontset_new()
    return false
}
