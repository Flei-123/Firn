// SPDX-License-Identifier: MPL-2.0
// lib/plat/fuiime.fi -- plat.fuiime: OPT IN to the platform input method (XIM on Linux, IMM32 on Windows) for a fUi window (r444b).
//
//     import plat.fuiime
//     fn main() -> i32 {
//         let a: *mut app.App = app.window("title", 420, 300)
//         fuiime.enable()           // before app.run
//         ...
//         return app.run(a)
//     }
//
// Why opt in: lib/plat/fuitext.fi -> input.textsys loads libX11 through std.dynlib, which turns the program into a DYNAMICALLY linked ELF on
// x86_64 Linux and does not build for aarch64. fUi programs stay static images unless they import this file. Without it the window sends
// plain EV_CHAR (no dead keys / Compose / IME pre-edit text). FUI_NO_IME=1 in the environment switches it off again at run time.
// Android and the web build do not use it (their apphost never calls the table).
import std.rt
import fui.apphost
import plat.fuitext

export { enable }

fn enable() {
    let sz: usize = 10 * 8
    let p: u64 = rt.heap_alloc(sz)
    if p == 0 {
        return
    }
    let b: *mut apphost.ImeBind = p as *mut apphost.ImeBind
    *b = apphost.ImeBind { open: fuitext.ft_open, set_sink: fuitext.ft_set_sink, event: fuitext.ft_event, swallow: fuitext.ft_swallow,
        pump: fuitext.ft_pump, fd: fuitext.ft_fd, reset: fuitext.ft_reset, spot: fuitext.ft_spot, on: fuitext.ft_on, close: fuitext.ft_close }
    apphost.ime_install(b)
}
