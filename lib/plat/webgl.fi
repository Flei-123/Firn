// SPDX-License-Identifier: MPL-2.0
// lib/plat/webgl.fi -- THE BROWSER'S GPU for fUi: WebGL2 through the host
// (fUi tempo, stage 2, 24.09.2026).
//
// lib/paint/gl.fi is the table of GL calls fUi's renderer (lib/fui/gpu.fi)
// draws through. This file fills it for a web page: every entry is one
// host call (`firn_gl_*`, answered by demos/webdemo/firn.js with the
// WebGL2 call of the same name, 1:1, no logic). Objects are numbers on
// this side; the host keeps a table of its WebGL objects.
//
// Only a program that imports this file needs a host that has these
// calls -- lib/plat/web.fi does, and only when the page asked for the GPU
// (web_use_gpu). `webgl_open` asks the host for a WebGL2 context on the
// page's canvas; no WebGL2 (an old browser, a blocked GPU) and the page
// paints in memory as before.
import paint.gl

export { webgl_open, webgl_api, webgl_size }

extern fn firn_gl_init(flags: u32) -> u32;
extern fn firn_gl_size(w: u32, h: u32);
extern fn firn_gl_program(vp: u32, vn: u32, fp: u32, fn2: u32, lp: u32, lcap: u32) -> u32;
extern fn firn_gl_use_program(p: u32);
extern fn firn_gl_uniform_location(p: u32, np: u32, nn: u32) -> u32;
extern fn firn_gl_uniform1i(l: u32, v: i32);
extern fn firn_gl_uniform1f(l: u32, v: f64);
extern fn firn_gl_uniform2f(l: u32, a: f64, b: f64);
extern fn firn_gl_uniform4f(l: u32, a: f64, b: f64, c: f64, d: f64);
extern fn firn_gl_create_buffer() -> u32;
extern fn firn_gl_bind_buffer(t: u32, b: u32);
extern fn firn_gl_buffer_data(t: u32, p: u32, n: u32, u: u32);
extern fn firn_gl_buffer_sub_data(t: u32, off: u32, p: u32, n: u32);
extern fn firn_gl_create_vertex_array() -> u32;
extern fn firn_gl_bind_vertex_array(v: u32);
extern fn firn_gl_enable_vertex_attrib_array(i: u32);
extern fn firn_gl_vertex_attrib_pointer(i: u32, size: i32, ty: u32, norm: u32, stride: i32, off: u32);
extern fn firn_gl_vertex_attrib_divisor(i: u32, d: u32);
extern fn firn_gl_create_texture() -> u32;
extern fn firn_gl_bind_texture(t: u32, tex: u32);
extern fn firn_gl_active_texture(u: u32);
extern fn firn_gl_tex_image_2d(t: u32, l: i32, ifmt: u32, w: i32, h: i32, fmt: u32, ty: u32, p: u32, n: u32);
extern fn firn_gl_tex_sub_image_2d(t: u32, l: i32, x: i32, y: i32, w: i32, h: i32, fmt: u32, ty: u32, p: u32, n: u32, rl: i32);
extern fn firn_gl_tex_parameteri(t: u32, pn: u32, v: i32);
extern fn firn_gl_create_framebuffer() -> u32;
extern fn firn_gl_bind_framebuffer(t: u32, f: u32);
extern fn firn_gl_framebuffer_texture_2d(t: u32, at: u32, tt: u32, tex: u32, l: i32);
extern fn firn_gl_check_framebuffer_status(t: u32) -> u32;
extern fn firn_gl_blit_framebuffer(a: i32, b: i32, c: i32, d: i32, e: i32, f: i32, g: i32, h: i32, m: u32, fl: u32);
extern fn firn_gl_copy_tex_sub_image_2d(t: u32, l: i32, a: i32, b: i32, c: i32, d: i32, e: i32, f: i32);
extern fn firn_gl_viewport(x: i32, y: i32, w: i32, h: i32);
extern fn firn_gl_scissor(x: i32, y: i32, w: i32, h: i32);
extern fn firn_gl_enable(c: u32);
extern fn firn_gl_disable(c: u32);
extern fn firn_gl_blend_func_separate(a: u32, b: u32, c: u32, d: u32);
extern fn firn_gl_clear_color(r: f64, g: f64, b: f64, a: f64);
extern fn firn_gl_clear(m: u32);
extern fn firn_gl_draw_arrays(m: u32, f: i32, c: i32);
extern fn firn_gl_draw_arrays_instanced(m: u32, f: i32, c: i32, n: i32);
extern fn firn_gl_read_pixels(x: i32, y: i32, w: i32, h: i32, p: u32);
extern fn firn_gl_delete(kind: u32, id: u32);
extern fn firn_gl_get_error() -> u32;
extern fn firn_gl_finish();

fn w_program(vp: u64, vn: usize, fp: u64, fnn: usize, lp: u64, lcap: usize) -> u64 {
    return firn_gl_program(vp as u32, vn as u32, fp as u32, fnn as u32, lp as u32, lcap as u32) as u64
}
fn w_use_program(p: u64) { firn_gl_use_program(p as u32) }
fn w_uniform_location(p: u64, np: u64, nn: usize) -> u64 {
    return firn_gl_uniform_location(p as u32, np as u32, nn as u32) as u64
}
fn w_uniform1i(l: u64, v: i64) { firn_gl_uniform1i(l as u32, v as i32) }
fn w_uniform1f(l: u64, v: f64) { firn_gl_uniform1f(l as u32, v) }
fn w_uniform2f(l: u64, x: f64, y: f64) { firn_gl_uniform2f(l as u32, x, y) }
fn w_uniform4f(l: u64, x: f64, y: f64, z: f64, q: f64) { firn_gl_uniform4f(l as u32, x, y, z, q) }
fn w_create_buffer() -> u64 { return firn_gl_create_buffer() as u64 }
fn w_bind_buffer(t: u64, b: u64) { firn_gl_bind_buffer(t as u32, b as u32) }
fn w_buffer_data(t: u64, p: u64, n: usize, u: u64) { firn_gl_buffer_data(t as u32, p as u32, n as u32, u as u32) }
fn w_buffer_sub_data(t: u64, off: usize, p: u64, n: usize) {
    firn_gl_buffer_sub_data(t as u32, off as u32, p as u32, n as u32)
}
fn w_create_vertex_array() -> u64 { return firn_gl_create_vertex_array() as u64 }
fn w_bind_vertex_array(v: u64) { firn_gl_bind_vertex_array(v as u32) }
fn w_enable_vertex_attrib_array(i: u64) { firn_gl_enable_vertex_attrib_array(i as u32) }
fn w_vertex_attrib_pointer(i: u64, size: i64, ty: u64, norm: u64, stride: i64, off: usize) {
    firn_gl_vertex_attrib_pointer(i as u32, size as i32, ty as u32, norm as u32, stride as i32, off as u32)
}
fn w_vertex_attrib_divisor(i: u64, d: u64) { firn_gl_vertex_attrib_divisor(i as u32, d as u32) }
fn w_create_texture() -> u64 { return firn_gl_create_texture() as u64 }
fn w_bind_texture(t: u64, tex: u64) { firn_gl_bind_texture(t as u32, tex as u32) }
fn w_active_texture(u: u64) { firn_gl_active_texture(u as u32) }
fn w_tex_image_2d(t: u64, l: i64, ifmt: u64, w: i64, h: i64, fmt: u64, ty: u64, p: u64, n: usize) {
    firn_gl_tex_image_2d(t as u32, l as i32, ifmt as u32, w as i32, h as i32, fmt as u32, ty as u32,
        p as u32, n as u32)
}
fn w_tex_sub_image_2d(t: u64, l: i64, x: i64, y: i64, w: i64, h: i64, fmt: u64, ty: u64,
    p: u64, n: usize, rl: i64) {
    firn_gl_tex_sub_image_2d(t as u32, l as i32, x as i32, y as i32, w as i32, h as i32, fmt as u32,
        ty as u32, p as u32, n as u32, rl as i32)
}
fn w_tex_parameteri(t: u64, pn: u64, v: i64) { firn_gl_tex_parameteri(t as u32, pn as u32, v as i32) }
fn w_create_framebuffer() -> u64 { return firn_gl_create_framebuffer() as u64 }
fn w_bind_framebuffer(t: u64, f: u64) { firn_gl_bind_framebuffer(t as u32, f as u32) }
fn w_framebuffer_texture_2d(t: u64, at: u64, tt: u64, tex: u64, l: i64) {
    firn_gl_framebuffer_texture_2d(t as u32, at as u32, tt as u32, tex as u32, l as i32)
}
fn w_check_framebuffer_status(t: u64) -> u64 { return firn_gl_check_framebuffer_status(t as u32) as u64 }
fn w_blit_framebuffer(x0: i64, y0: i64, x1: i64, y1: i64, a0: i64, b0: i64, a1: i64, b1: i64,
    m: u64, fl: u64) {
    firn_gl_blit_framebuffer(x0 as i32, y0 as i32, x1 as i32, y1 as i32, a0 as i32, b0 as i32,
        a1 as i32, b1 as i32, m as u32, fl as u32)
}
fn w_copy_tex_sub_image_2d(t: u64, l: i64, xo: i64, yo: i64, x: i64, y: i64, w: i64, h: i64) {
    firn_gl_copy_tex_sub_image_2d(t as u32, l as i32, xo as i32, yo as i32, x as i32, y as i32,
        w as i32, h as i32)
}
fn w_viewport(x: i64, y: i64, w: i64, h: i64) { firn_gl_viewport(x as i32, y as i32, w as i32, h as i32) }
fn w_scissor(x: i64, y: i64, w: i64, h: i64) { firn_gl_scissor(x as i32, y as i32, w as i32, h as i32) }
fn w_enable(c: u64) { firn_gl_enable(c as u32) }
fn w_disable(c: u64) { firn_gl_disable(c as u32) }
fn w_blend_func_separate(a0: u64, b0: u64, c0: u64, d0: u64) {
    firn_gl_blend_func_separate(a0 as u32, b0 as u32, c0 as u32, d0 as u32)
}
fn w_clear_color(r: f64, g: f64, b: f64, al: f64) { firn_gl_clear_color(r, g, b, al) }
fn w_clear(m: u64) { firn_gl_clear(m as u32) }
fn w_draw_arrays(m: u64, f: i64, c: i64) { firn_gl_draw_arrays(m as u32, f as i32, c as i32) }
fn w_draw_arrays_instanced(m: u64, f: i64, c: i64, n: i64) {
    firn_gl_draw_arrays_instanced(m as u32, f as i32, c as i32, n as i32)
}
fn w_read_pixels(x: i64, y: i64, w: i64, h: i64, p: u64) {
    firn_gl_read_pixels(x as i32, y as i32, w as i32, h as i32, p as u32)
}
fn w_delete(kind: u64, id: u64) { firn_gl_delete(kind as u32, id as u32) }
fn w_get_error() -> u64 { return firn_gl_get_error() as u64 }
fn w_finish() { firn_gl_finish() }

// The table, filled -- `ok` only when the host really has a WebGL2
// context for the page's canvas.
fn webgl_api(t: *mut gl.GlApi) {
    (*t).program = w_program
    (*t).use_program = w_use_program
    (*t).uniform_location = w_uniform_location
    (*t).uniform1i = w_uniform1i
    (*t).uniform1f = w_uniform1f
    (*t).uniform2f = w_uniform2f
    (*t).uniform4f = w_uniform4f
    (*t).create_buffer = w_create_buffer
    (*t).bind_buffer = w_bind_buffer
    (*t).buffer_data = w_buffer_data
    (*t).buffer_sub_data = w_buffer_sub_data
    (*t).create_vertex_array = w_create_vertex_array
    (*t).bind_vertex_array = w_bind_vertex_array
    (*t).enable_vertex_attrib_array = w_enable_vertex_attrib_array
    (*t).vertex_attrib_pointer = w_vertex_attrib_pointer
    (*t).vertex_attrib_divisor = w_vertex_attrib_divisor
    (*t).create_texture = w_create_texture
    (*t).bind_texture = w_bind_texture
    (*t).active_texture = w_active_texture
    (*t).tex_image_2d = w_tex_image_2d
    (*t).tex_sub_image_2d = w_tex_sub_image_2d
    (*t).tex_parameteri = w_tex_parameteri
    (*t).create_framebuffer = w_create_framebuffer
    (*t).bind_framebuffer = w_bind_framebuffer
    (*t).framebuffer_texture_2d = w_framebuffer_texture_2d
    (*t).check_framebuffer_status = w_check_framebuffer_status
    (*t).blit_framebuffer = w_blit_framebuffer
    (*t).copy_tex_sub_image_2d = w_copy_tex_sub_image_2d
    (*t).viewport = w_viewport
    (*t).scissor = w_scissor
    (*t).enable = w_enable
    (*t).disable = w_disable
    (*t).blend_func_separate = w_blend_func_separate
    (*t).clear_color = w_clear_color
    (*t).clear = w_clear
    (*t).draw_arrays = w_draw_arrays
    (*t).draw_arrays_instanced = w_draw_arrays_instanced
    (*t).read_pixels = w_read_pixels
    (*t).delete_obj = w_delete
    (*t).get_error = w_get_error
    (*t).finish = w_finish
}

// The size of the page's drawing buffer (device pixels): the picture is
// copied onto it 1:1 at the end of every frame.
fn webgl_size(w: usize, h: usize) {
    firn_gl_size(w as u32, h as u32)
}

// Ask the host for WebGL2 on the page's canvas and fill the table. False:
// no WebGL2 here (the table stays empty, `ok` false).
fn webgl_open(t: *mut gl.GlApi) -> bool {
    *t = gl.gl_api_new()
    if firn_gl_init(0 as u32) == 0 as u32 {
        return false
    }
    webgl_api(t)
    (*t).ok = true
    return true
}
