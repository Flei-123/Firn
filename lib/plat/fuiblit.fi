// lib/plat/fuiblit.fi -- canvas to window: RGBA straight through on back ends that store RGBA, else via a BGRX buffer.

import window.window
import plat.fuiwirt
import fui.damage

fn full_prepare(direct: bool, canvas: u64, bgrx: u64, n: usize) {
    if !direct {
        fuiwirt.rgba_to_bgrx(canvas, bgrx, n)
    }
}

fn full_put(f: *mut window.Window, direct: bool, canvas: u64, bgrx: u64, w: usize, h: usize) -> bool {
    if direct {
        return window.image_rgba(f, canvas, w, w, h, 0, 0)
    }
    return window.image(f, bgrx, w, h, 0, 0)
}

fn rect_put(f: *mut window.Window, direct: bool, canvas: u64, bgrx: u64, canvas_w: usize, rc: *mut [i64; 4]) -> bool {
    let rw: usize = ((*rc)[2] - (*rc)[0]) as usize
    let rh: usize = ((*rc)[3] - (*rc)[1]) as usize
    let x0: usize = (*rc)[0] as usize
    let y0: usize = (*rc)[1] as usize
    if direct {
        return window.image_rgba(f, canvas + ((y0 * canvas_w + x0) * 4) as u64, canvas_w, rw, rh, x0, y0)
    }
    damage.to_bgrx_rect(canvas, canvas_w, rc, bgrx)
    return window.image(f, bgrx, rw, rh, x0, y0)
}
