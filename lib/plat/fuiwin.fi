// SPDX-License-Identifier: MPL-2.0
// lib/plat/fuiwin.fi -- THE WINDOW LOOP: lib/window + fUi.
//
// ========================================================= WHY IT EXISTS
//
// lib/window/window.fi can open a window, push a finished picture
// into it and hand out events -- on X11, Windows,
// Android and OSUM, depending on which back end lies next to the root file
// as window/backend.fi. lib/plat/fuiwirt.fi knows what an
// event means for fUi. This file is the piece in between, and
// it is deliberately SMALL:
//
//   * ONE SWITCH: every EV_* goes to exactly one function of the host;
//     every key with meaning (window.K_*) becomes a key of the host.
//     Which key is Escape is known by the back end (under X11 from the
//     keysym, see lib/window/x11.fi F1) -- no table stands here.
//   * THE CANVAS: a canvas.Canvas in window size and a painter
//     on it. If the size changes (EV_CONFIGURE), both are created ANEW
//     and not stretched -- otherwise the picture would be blurry.
//   * THE LOOP: wait as long as the host allows
//     (`wirt_wait_ms`: -1 = until an event comes), collect all events,
//     set the clock, and ONLY if the host is dirty:
//     have it painted, RGBA -> BGRX, one PutImage, done. When idle
//     the program stands in `poll` and uses nothing.
//   * THE SCALE: `window.uiscale` (from Xft.dpi or the millimetres
//     of the screen, lib/window/x11.fi L4) goes via `wirt_set_scale`
//     into the theme -- on opening and after every EV_CONFIGURE, because a
//     window can move to another screen.
//
// THIS FILE DOES NOT BELONG IN lib/fui. fUi stays translatable
// without a window; whoever wants fUi in a window takes lib/plat.
import std.rt
import paint.canvas
import paint.gl
import fui.painter
import fui.theme
import fui.gpu
import window.window
import plat.fuiwirt

export {
    Window, window_new, window_open, window_run, window_close,
    window_canvas, window_painter, window_w, window_h,
    window_window, window_set_font, window_log, window_full,
    window_images, now_ms,
    // fUi tempo, stage 2b: THE GPU (see "ON THE GPU" below)
    window_set_gpu, window_gpu,
    // OpenPlan LIB-006: the system clipboard for fUi text fields
    window_clip_read, window_clip_write,
    // OpenPlan LIB-005: more than one window
    window_step, window_wait_many,
    // fUi app layer (lib/fui/app.fi): keys and characters for a text field
    // first, and Escape that does not close the window
    window_set_input_hook, window_set_escape_closes,
}

struct Window {
    f: window.Window,
    cv: canvas.Canvas,
    z: painter.Painter,
    fm: u64,
    bgrx: u64,
    cap: usize,
    w: usize,
    h: usize,
    // Liefert die Rueckwand Loslassen/Hinein/Hinaus (window.full_input)?
    full: bool,
    // One line per event and per frame on fd 1 -- for the acceptance run.
    log: bool,
    images: u64,
    open: bool,
    // Escape ends (the demo wants that; a program with dialogs does not).
    esc_zu: bool,
    // ON THE GPU: wanted (default yes), and whether it runs; the GL table
    // of the window and fUi's renderer on it
    gpu_will: bool,
    gpu_an: bool,
    gl: gl.GlApi,
    gp: gpu.Gpu,
    // THE INPUT HOOK (window_set_input_hook): 0 = none
    hook_on: bool,
    hook_ud: u64,
    hook: fn(u64, u32, u32, u32, f64, f64) -> bool,
}

fn hook_none(ud: u64, kind: u32, a: u32, st: u32, x: f64, y: f64) -> bool {
    return false
}

// THE INPUT HOOK. `f(ud, kind, a, state, x, y)` sees every EV_KEY, EV_CHAR
// and EV_BUTTON before the host does (kind = window.EV_*, a = the key, the
// code point or the button, state = window.ev_state). For EV_KEY and
// EV_CHAR an answer of true means "taken" and the host never sees the
// event -- that is how a focused text field gets its letters, the space
// bar included. A button is only reported: the host still gets it (focus,
// press, release stay in ONE place, control.fi).
fn window_set_input_hook(fx: *mut Window, ud: u64,
    f: fn(u64, u32, u32, u32, f64, f64) -> bool) {
    (*fx).hook_on = true
    (*fx).hook_ud = ud
    (*fx).hook = f
}

// Escape closes the window by default (the demos want that); an
// application with its own Close button does not.
fn window_set_escape_closes(fx: *mut Window, on: bool) {
    (*fx).esc_zu = on
}

fn window_new() -> Window {
    return Window { f: window.window_new(), cv: canvas.canvas_new(),
        z: painter.painter_new(), fm: 0, bgrx: 0, cap: 0, w: 0, h: 0,
        full: false, log: false, images: 0, open: false, esc_zu: true,
        gpu_will: true, gpu_an: false, gl: gl.gl_api_new(), gp: gpu.gpu_new(),
        hook_on: false, hook_ud: 0, hook: hook_none }
}

// ============================================================ ON THE GPU
//
// fUi tempo, stage 2b (24.09.2026). If the window offers a GPU
// (`window.gpu_open`: today Android, EGL + OpenGL ES 3), then the
// canvas lies on the GPU (lib/fui/gpu.fi): fUi paints into it there, a frame
// ends with ONE copy onto the screen and `window.gpu_swap` -- no
// RGBA -> BGRX, no octet-by-octet copying into the window buffer.
// Without a GPU (X11, Windows, Osum, a device without GLES 3) fUi paints as
// before in memory. `fenster_set_gpu(fx, false)` BEFORE opening
// switches it off (for comparing).
fn window_set_gpu(fx: *mut Window, an: bool) {
    (*fx).gpu_will = an
}

fn window_gpu(fx: *mut Window) -> bool {
    return (*fx).gpu_an
}

fn gpu_start(fx: *mut Window) {
    (*fx).gpu_an = false
    if !(*fx).gpu_will || (*fx).cap == 0 {
        return
    }
    if !window.gpu_open(&(*fx).f, (&(*fx).gl) as u64) {
        return
    }
    if !gpu.gpu_open(&(*fx).gp, &(*fx).gl) {
        return
    }
    if !gpu.gpu_attach(&(*fx).gp, &(*fx).cv) {
        return
    }
    (*fx).gpu_an = true
    var nm: [u8; 3] = "gpu"
    line(fx, (&nm[0]) as u64, 3, 1, (*fx).w as i64, (*fx).h as i64, 0)
}

// Write accesses that bypassed the GPU (canvas.fi counts them):
// into the log as soon as there are new ones -- a hole in the picture is thereby noticed.
static mut G_HASH: u64 = 0

fn hash_report(fx: *mut Window) {
    let n: u64 = canvas.canvas_stray_writes()
    if n == G_HASH {
        return
    }
    G_HASH = n
    var nm: [u8; 5] = "streu"
    line(fx, (&nm[0]) as u64, 5, n as i64, 0, 0, 0)
    let s: str = "fui.gpu: writes that missed the GPU\n"
    rt.write_everything(2, s.p as u64, s.n)
}

fn window_canvas(fx: *mut Window) -> *mut canvas.Canvas { return &(*fx).cv }
fn window_painter(fx: *mut Window) -> *mut painter.Painter { return &(*fx).z }
fn window_w(fx: *mut Window) -> usize { return (*fx).w }
fn window_h(fx: *mut Window) -> usize { return (*fx).h }
fn window_window(fx: *mut Window) -> *mut window.Window { return &(*fx).f }
fn window_full(fx: *mut Window) -> bool { return (*fx).full }
fn window_images(fx: *mut Window) -> u64 { return (*fx).images }

fn window_set_font(fx: *mut Window, fm: u64) {
    (*fx).fm = fm
    painter.painter_set_font(&(*fx).z, fm)
}

fn window_log(fx: *mut Window, an: bool) {
    (*fx).log = an
}

// The clock against which the animations run: CLOCK_MONOTONIC in ms.
fn now_ms() -> i64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return ts[0] * 1000 + ts[1] / 1000000
}

// Canvas, painter and BGRX buffer for `w` x `h` -- new, not stretched.
fn flaechen(fx: *mut Window, w: usize, h: usize) -> bool {
    if (*fx).cap > 0 {
        painter.painter_free(&(*fx).z)
        canvas.canvas_free(&(*fx).cv)
        rt.heap_free((*fx).bgrx, (*fx).cap)
        (*fx).cap = 0
    }
    if !canvas.canvas_init(&(*fx).cv, w, h) {
        return false
    }
    if !painter.painter_init(&(*fx).z, &(*fx).cv, w, h) {
        return false
    }
    painter.painter_set_font(&(*fx).z, (*fx).fm)
    (*fx).bgrx = rt.heap_alloc(w * h * 4)
    if (*fx).bgrx == 0 {
        return false
    }
    (*fx).cap = w * h * 4
    (*fx).w = w
    (*fx).h = h
    // the new canvas back onto the GPU (a target of the new size)
    if (*fx).gpu_an && !gpu.gpu_attach(&(*fx).gp, &(*fx).cv) {
        (*fx).gpu_an = false
    }
    return true
}

// OPENING. `bw`/`bh` are DESIGN POINTS: the start size is converted like
// every other length via the theme, after the scale
// of the screen is known. `anzeige` 0 = $DISPLAY.
// `#[allow_escape]`: the window's address is kept (G_CLIPWIN) for the
// clipboard functions a text field calls without a context. It is
// cleared again in `fenster_close`, and a Fenster lives from open to
// close by contract.
#[allow_escape]
fn window_open(fx: *mut Window, w: *mut fuiwirt.Host, m: *mut theme.Theme,
    disp: usize, bw: usize, bh: usize, titel: u64, tn: usize) -> bool {
    if !window.open_window(&(*fx).f, disp) {
        return false
    }
    fuiwirt.host_set_scale(w, m, window.uiscale(&(*fx).f))
    let pw: usize = theme.theme_px(m, bw)
    let ph: usize = theme.theme_px(m, bh)
    // Release, enter, leave -- order BEFORE the window.
    (*fx).full = window.full_input(&(*fx).f, true)
    if !window.make(&(*fx).f, pw, ph) {
        return false
    }
    let t: bool = window.title(&(*fx).f, titel, tn)
    if !flaechen(fx, window.width(&(*fx).f), window.height(&(*fx).f)) {
        return false
    }
    if !window.show_window(&(*fx).f) {
        return false
    }
    gpu_start(fx)
    (*fx).open = true
    G_CLIPWIN = (&(*fx).f) as u64
    return true
}

// ================================================ SEVERAL WINDOWS
//
// OpenPlan LIB-005. Every Fenster is a window of its own (under X11 with
// a connection of its own). A program with several of them waits for all
// at once and then steps each:
//
//     var fs: [u64; 8] = [(&a) as u64, (&b) as u64, 0, 0, 0, 0, 0, 0]
//     var ws: [u64; 8] = [(&wa) as u64, (&wb) as u64, 0, 0, 0, 0, 0, 0]
//     while open_a || open_b {
//         fuiwin.fenster_wait_many(&fs, &ws, 2)
//         if open_a { open_a = fuiwin.fenster_step(&a, &wa, &ma, male_a, akt_a, ud) }
//         if open_b { open_b = fuiwin.fenster_step(&b, &wb, &mb, male_b, akt_b, ud) }
//     }
//
// It waits as long as the most impatient window allows (an animation
// wants its next frame in 16 ms) or until one of them has an event. A
// closed window (0 in `fs`) is skipped. The answer is the index of a
// window with an event, or -1 when the time ran out.
fn window_wait_many(fs: *mut [u64; 8], ws: *mut [u64; 8], n: usize) -> i64 {
    var ms: i64 = fuiwirt.WAIT_FOREVER
    var wins: [u64; 8] = [0 as u64; 8]
    var k: usize = 0
    var i: usize = 0
    while i < n && i < 8 {
        if (*fs)[i] != 0 && (*ws)[i] != 0 {
            let fx: *mut Window = (*fs)[i] as *mut Window
            let wm: i64 = fuiwirt.host_wait_ms((*ws)[i] as *mut fuiwirt.Host)
            if wm == 0 {
                return i as i64
            }
            if wm > 0 && (ms < 0 || wm < ms) {
                ms = wm
            }
            wins[k] = (&(*fx).f) as u64
            k = k + 1
        }
        i = i + 1
    }
    if k == 0 {
        return -1
    }
    return window.wait_any(&wins, k, ms)
}

// ================================================ THE SYSTEM CLIPBOARD
//
// OpenPlan LIB-006. The two functions a text field wants
// (editor.editor_set_clipboard), on the clipboard of the window opened
// last:
//
//     editor.editor_set_clipboard(&ed, fuiwin.fenster_clip_read, fuiwin.fenster_clip_write)
//
// Text only (text/plain;charset=utf-8). A backend without a system
// clipboard answers 0/false, and the field keeps its internal one.
static mut G_CLIPWIN: u64 = 0

fn window_clip_read(p: u64, cap: usize) -> usize {
    if G_CLIPWIN == 0 {
        return 0
    }
    var b: rt.Buf = rt.buf_new()
    var n: usize = 0
    if window.clipboard_get(G_CLIPWIN as *mut window.Window, "text/plain;charset=utf-8", &b) {
        n = rt.buf_len(&b)
        if n > cap {
            // cut at a character boundary, not in the middle of one
            n = cap
            while n > 0 && (rt.ld8(rt.buf_ptr(&b), n) & 192 as u8) == 128 as u8 {
                n = n - 1
            }
        }
        rt.mem_copy(p, rt.buf_ptr(&b), n)
    }
    rt.buf_free(&b)
    return n
}

fn window_clip_write(p: u64, n: usize) -> bool {
    if G_CLIPWIN == 0 {
        return false
    }
    let w: *mut window.Window = G_CLIPWIN as *mut window.Window
    window.clipboard_clear(w)
    return window.clipboard_set(w, "text/plain;charset=utf-8", p, n)
}

fn window_close(fx: *mut Window) {
    if (*fx).gpu_an {
        gpu.gpu_detach(&(*fx).gp, &(*fx).cv)
        window.gpu_close(&(*fx).f)
        (*fx).gpu_an = false
    }
    if (*fx).cap > 0 {
        painter.painter_free(&(*fx).z)
        canvas.canvas_free(&(*fx).cv)
        rt.heap_free((*fx).bgrx, (*fx).cap)
        (*fx).cap = 0
    }
    window.close_window(&(*fx).f)
    (*fx).open = false
    if G_CLIPWIN == (&(*fx).f) as u64 {
        G_CLIPWIN = 0
    }
}

fn line(fx: *mut Window, was: u64, wn: usize, a: i64, b: i64, c: i64,
    d: i64) {
    if !(*fx).log {
        return
    }
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, was, wn)
    rt.buf_push(&t, 32 as u8)
    rt.buf_push_dec_i64(&t, a)
    rt.buf_push(&t, 32 as u8)
    rt.buf_push_dec_i64(&t, b)
    rt.buf_push(&t, 32 as u8)
    rt.buf_push_dec_i64(&t, c)
    rt.buf_push(&t, 32 as u8)
    rt.buf_push_dec_i64(&t, d)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// Key of the window system -> key of the host; 0 = none for it.
fn taste(k: u32) -> u32 {
    if k == window.K_TAB { return fuiwirt.KEY_TAB }
    if k == window.K_RETURN { return fuiwirt.KEY_RETURN }
    if k == window.K_UP { return fuiwirt.KEY_UP }
    if k == window.K_DOWN { return fuiwirt.KEY_DOWN }
    if k == window.K_LEFT { return fuiwirt.KEY_LEFT }
    if k == window.K_RIGHT { return fuiwirt.KEY_RIGHT }
    if k == window.K_PAGEUP { return fuiwirt.KEY_PAGE_UP }
    if k == window.K_PAGEDOWN { return fuiwirt.KEY_PAGE_DOWN }
    if k == window.K_HOME { return fuiwirt.KEY_HOME }
    if k == window.K_END { return fuiwirt.KEY_END }
    return 0 as u32
}

// ONE EVENT -> THE HOST. false = the window is closed.
fn fork(fx: *mut Window, w: *mut fuiwirt.Host, m: *mut theme.Theme,
    k: u32) -> bool {
    let f: *mut window.Window = &(*fx).f
    let a: u32 = window.ev_a(f)
    let x: f64 = window.ev_x(f) as f64
    let y: f64 = window.ev_y(f) as f64
    let s: u32 = window.ev_state(f)
    var nm: [u8; 8] = "ereignis"
    line(fx, (&nm[0]) as u64, 8, k as i64, a as i64, x as i64, y as i64)
    if k == window.EV_CLOSED {
        return false
    }
    if (*fx).hook_on && (k == window.EV_KEY || k == window.EV_CHAR
        || k == window.EV_BUTTON) {
        let taken: bool = (*fx).hook((*fx).hook_ud, k, a, s, x, y)
        if taken && k != window.EV_BUTTON {
            return true
        }
    }
    if k == window.EV_EXPOSE {
        fuiwirt.host_expose(w)
    } else if k == window.EV_CONFIGURE {
        let nw: usize = window.width(f)
        let nh: usize = window.height(f)
        if nw != (*fx).w || nh != (*fx).h {
            if !flaechen(fx, nw, nh) {
                return false
            }
        }
        // Another screen can have a different density.
        fuiwirt.host_set_scale(w, m, window.uiscale(f))
        fuiwirt.host_resize(w)
    } else if k == window.EV_MOTION || k == window.EV_ENTER {
        let c: u32 = fuiwirt.host_pointer_move(w, x, y)
    } else if k == window.EV_LEAVE {
        let c: u32 = fuiwirt.host_pointer_leave(w)
    } else if k == window.EV_BUTTON {
        let c: u32 = fuiwirt.host_pointer_down(w, x, y, a)
        // Without release from the back end a click is the press
        // alone -- honestly worse, but operable.
        if !(*fx).full && a == fuiwirt.BTN_LEFT {
            let c2: u32 = fuiwirt.host_pointer_up(w, x, y, a)
        }
    } else if k == window.EV_RELEASE {
        let c: u32 = fuiwirt.host_pointer_up(w, x, y, a)
    } else if k == window.EV_KEY {
        if a == window.K_ESCAPE && (*fx).esc_zu {
            return false
        }
        let t: u32 = taste(a)
        if t != 0 as u32 {
            let c: u32 = fuiwirt.host_key(w, t, s)
        }
    } else if k == window.EV_CHAR {
        let c: u32 = fuiwirt.host_char(w, a, s)
    } else if k == window.EV_THEME {
        theme.theme_set_dark(m, window.dark(f))
        fuiwirt.host_touch(w)
    }
    return true
}

// THE LOOP. `male(ud, fx)` paints the page into `fenster_canvas(fx)`
// (size fenster_w/h); `aktion(ud, fx, knoten)` learns which
// node was triggered. Returns when the window is closed.
fn window_run(fx: *mut Window, w: *mut fuiwirt.Host, m: *mut theme.Theme,
    times: fn(u64, *mut Window), aktion: fn(u64, *mut Window, usize),
    ud: u64) {
    let f: *mut window.Window = &(*fx).f
    var runs: bool = true
    while runs {
        let ms: i64 = fuiwirt.host_wait_ms(w)
        // In the log: how long the loop now WANTS to sleep (-1 =
        // until an event comes). That is the proof for idling.
        var dn: [u8; 5] = "warte"
        line(fx, (&dn[0]) as u64, 5, ms, now_ms(), 0, 0)
        if ms != 0 {
            let da: bool = window.wait_event(f, ms)
        }
        runs = window_step(fx, w, m, times, aktion, ud)
    }
}

// ONE TURN of the loop without the waiting: the events that are there,
// the activated control, the animation tick, a frame if something
// changed. false = the window is closed (or the program asked to end).
// `fenster_run` is this in a loop with the wait in front; a program with
// SEVERAL windows (OpenPlan LIB-005: pages in windows of their own) waits
// with `fenster_wait_many` and then steps every window.
fn window_step(fx: *mut Window, w: *mut fuiwirt.Host, m: *mut theme.Theme,
    times: fn(u64, *mut Window), aktion: fn(u64, *mut Window, usize),
    ud: u64) -> bool {
    let f: *mut window.Window = &(*fx).f
    var runs: bool = true
    var k: u32 = window.next_event(f)
    while k != window.EV_NONE && runs {
        if !fork(fx, w, m, k) {
            runs = false
        } else {
            k = window.next_event(f)
        }
    }
    if !runs {
        return false
    }
    let akt: usize = fuiwirt.host_take_activated(w)
    if akt != fuiwirt.KEINER {
        aktion(ud, fx, akt)
    }
    fuiwirt.host_tick(w, now_ms())
    if fuiwirt.host_dirty(w) {
        let q0: i64 = now_ms()
        var q2: i64 = q0
        var q3: i64 = q0
        var q1: i64 = q0
        if (*fx).gpu_an {
            // ON THE GPU: paint, one copy onto the screen, swap
            var pl: [u64; 4] = [0; 4]
            window.gpu_place(f, (&pl[0]) as u64)
            gpu.gpu_frame_begin(&(*fx).gp, pl[2] as i32, pl[3] as i32)
            times(ud, fx)
            q1 = now_ms()
            gpu.gpu_present_at(&(*fx).gp, pl[0] as i32, pl[1] as i32)
            hash_report(fx)
            q2 = now_ms()
            let ok3: bool = window.gpu_swap(f)
            q3 = now_ms()
            if window.gpu_lost(f) {
                // the context is gone and with it every GL object: open
                // anew, and everything is painted once more
                gpu_start(fx)
                fuiwirt.host_touch(w)
            }
        } else {
            times(ud, fx)
            q1 = now_ms()
            fuiwirt.rgba_to_bgrx(canvas.canvas_pixels(&(*fx).cv) as u64,
                (*fx).bgrx, (*fx).w * (*fx).h)
            q2 = now_ms()
            let ok: bool = window.image(f, (*fx).bgrx, (*fx).w, (*fx).h, 0, 0)
            let ok2: bool = window.present(f)
            q3 = now_ms()
        }
        // Where the time of a frame goes: paint fUi, RGBA->BGRX,
        // PutImage -- in ms. Measured, so that nobody suspects the platform
        // when the rasteriser is slow (and the other way round).
        var tn: [u8; 4] = "zeit"
        line(fx, (&tn[0]) as u64, 4, q1 - q0, q2 - q1, q3 - q2, 0)
        fuiwirt.host_painted(w)
        (*fx).images = (*fx).images + 1
        var nm: [u8; 4] = "bild"
        line(fx, (&nm[0]) as u64, 4, (*fx).images as i64,
            (*fx).w as i64, (*fx).h as i64,
            theme.theme_scale(m) as i64)
        // After arranging, a different node may lie under the standing
        // pointer (scrolled) -- the host catches up with that,
        // and then painting happens once more.
        let c: u32 = fuiwirt.host_after_layout(w)
    }
    return window.is_open(f)
}
