// SPDX-License-Identifier: MPL-2.0
// lib/plat/fuiwin.fi -- THE WINDOW LOOP: lib/window + fUi.
//
// ========================================================= WHY IT EXISTS
//
// lib/window/window.fi can open a window, push a finished picture
// into it and hand out events -- on X11, Windows,
// Android and OSUM, depending on which back end lies next to the root file
// as window/backend.fi. lib/plat/fuiwirt.fi knows what an
// event means for fUi. This file is the piece in between, and
// it is deliberately SMALL:
//
//   * ONE SWITCH: every EV_* goes to exactly one function of the host;
//     every key with meaning (window.K_*) becomes a key of the host.
//     Which key is Escape is known by the back end (under X11 from the
//     keysym, see lib/window/x11.fi F1) -- no table stands here.
//   * THE CANVAS: a canvas.Canvas in window size and a painter
//     on it. If the size changes (EV_CONFIGURE), both are created ANEW
//     and not stretched -- otherwise the picture would be blurry.
//   * THE LOOP: wait as long as the host allows
//     (`wirt_wait_ms`: -1 = until an event comes), collect all events,
//     set the clock, and ONLY if the host is dirty:
//     have it painted, RGBA -> BGRX, one PutImage, done. When idle
//     the program stands in `poll` and uses nothing.
//   * THE SCALE: `window.uiscale` (from Xft.dpi or the millimetres
//     of the screen, lib/window/x11.fi L4) goes via `wirt_set_scale`
//     into the theme -- on opening and after every EV_CONFIGURE, because a
//     window can move to another screen.
//
// THIS FILE DOES NOT BELONG IN lib/fui. fUi stays translatable
// without a window; whoever wants fUi in a window takes lib/plat.
import std.rt
import paint.canvas
import paint.gl
import fui.painter
import fui.theme
import fui.syspref
import fui.gpu
import window.window
import window.pointers
import window.hostmetrics
import plat.envvar
import plat.fuiwirt
import plat.fuiblit
import plat.gpuchain
import fui.recorder
import fui.event

export {
    Window, window_new, window_open, window_run, window_close,
    window_canvas, window_painter, window_w, window_h,
    window_window, window_set_font, window_log, window_full, window_apply_cursor,
    window_images, window_last_px, now_ms, host_key_of,
    // fUi tempo, stage 2b: THE GPU (see "ON THE GPU" below)
    window_set_gpu, window_gpu,
    // W40-a: system dark mode + high contrast onto the theme (open and EV_THEME)
    window_system_look,
    // W44-c: the host's safe area (insets) and text scale, opt-in; FUI_INSETS / FUI_TEXT_SCALE override the system
    window_follow_text_scale, window_follow_insets, host_text_scale, host_insets,
    // OpenPlan LIB-006: the system clipboard for fUi text fields
    window_clip_read, window_clip_write,
    // OpenPlan LIB-005: more than one window
    window_step, window_wait_many, window_wait_many_fd,
    rec_attach, rec_detach,
    // fUi app layer (lib/fui/app.fi): keys and characters for a text field
    // first, and Escape that does not close the window
    window_set_input_hook, window_set_escape_closes,
    // r111: real pointers (every finger with its id) into the event router
    window_use_pointers,
    // r422: a present hook (lib/plat/fuiwingl.fi: the canvas goes through an OpenGL window instead of PutImage)
    window_set_present, window_clear_present, window_present_hooked,
    // W18-F3: the GPU PROVIDER (lib/plat/fuiwinvk.fi: fUi painted on Vulkan, read back, shown by the CPU present)
    window_set_gpu_provider, window_force_provider, window_fail_gl, window_gpu_readback,
    // W39: swapchain present of the provider (no read-back), vsync, finish
    window_set_gpu_present, window_gpu_present, window_vsync, window_gpu_finish,
}

struct Window {
    f: window.Window,
    cv: canvas.Canvas,
    z: painter.Painter,
    fm: u64,
    bgrx: u64,
    cap: usize,
    w: usize,
    h: usize,
    // Liefert die Rueckwand Loslassen/Hinein/Hinaus (window.full_input)?
    full: bool,
    // One line per event and per frame on fd 1 -- for the acceptance run.
    log: bool,
    images: u64,
    // pixels handed to the screen by the last frame (the metric of the partial present)
    last_px: i64,
    open: bool,
    // Escape ends (the demo wants that; a program with dialogs does not).
    esc_zu: bool,
    // ON THE GPU: wanted (default yes), and whether it runs; the GL table
    // of the window and fUi's renderer on it
    gpu_will: bool,
    gpu_an: bool,
    gl: gl.GlApi,
    gp: gpu.Gpu,
    // THE INPUT HOOK (window_set_input_hook): 0 = none
    hook_on: bool,
    hook_ud: u64,
    hook: fn(u64, u32, u32, u32, f64, f64) -> bool,
    // REAL POINTERS (window_use_pointers): the back end delivers every
    // finger as a record; `pdown` counts the ones that are down
    real: bool,
    // ... and the MOUSE too (Android), or only touch/pen while the mouse
    // keeps the old events (X11 XInput2, Win32 WM_POINTER)
    rmouse: bool,
    cur_shape: u32,
    pdown: usize,
    // THE PRESENT HOOK (window_set_present): 0 = none, the CPU path (RGBA -> BGRX, PutImage)
    pres_on: bool,
    pres_ud: u64,
    pres: fn(u64, u64, usize, usize) -> bool,
    // THE GPU PROVIDER (window_set_gpu_provider): for a window that has no GPU of its own (X11, Windows, Osum) a provider
    // fills the GL table (lib/plat/fuiwinvk.fi: Vulkan); then fUi paints on the GPU, the canvas is read back and the
    // normal CPU present shows it (`gpu_rb`). prov_ok asks whether the device is still alive, prov_close lets it go.
    prov_on: bool,
    prov_open: fn(*mut gl.GlApi) -> bool,
    prov_ok: fn() -> bool,
    prov_close: fn(),
    gpu_rb: bool,
    // W38: the provider goes FIRST even when the window layer has a GPU of its own (Windows: WGL / OpenGL) -- FUI_GPU=1 means Vulkan
    prov_force: bool,
    gl_fail: i32, // test hook (window_fail_gl): 1 = the GL stage does not open, 2 = its shaders do not build, 0 = real
    // W39 PRESENT: the provider can also show the canvas target itself (Vulkan swapchain on the window): no read-back, no CPU copy.
    // psc_open(native handle, w, h), psc_show(w, h) = 1 shown / 0 not shown (swapchain unusable) / -1 device gone, psc_close, psc_vsync(on).
    psc_on: bool,
    psc_open: fn(u64, i32, i32) -> bool,
    psc_show: fn(i32, i32) -> i32,
    psc_close: fn(),
    psc_vsync: fn(bool),
    pres_sc: bool,
    // W40-a: the system's HIGH CONTRAST on this window (syspref.hc_sync): whether the High Contrast theme is on and the shape to give back
    hc: syspref.HcState,
    // W44-c: OPT-IN host metrics. hm_text: the system's text size goes onto the theme (theme.theme_set_text_scale); hm_cb(hm_ud, l, t, r, b)
    // hears the insets (device pixels, all 0 when the host cannot tell). Both run at open and on every EV_THEME (window_system_look).
    hm_text: bool,
    hm_ins: bool,
    hm_ud: u64,
    hm_cb: fn(u64, f64, f64, f64, f64),
}

fn hm_none(ud: u64, l: f64, t: f64, r: f64, b: f64) {
}

fn hook_none(ud: u64, kind: u32, a: u32, st: u32, x: f64, y: f64) -> bool {
    return false
}

fn pres_none(ud: u64, px: u64, w: usize, h: usize) -> bool {
    return false
}

fn prov_open_none(api: *mut gl.GlApi) -> bool {
    return false
}

fn psc_open_none(native: u64, w: i32, h: i32) -> bool {
    return false
}

fn psc_show_none(w: i32, h: i32) -> i32 {
    return 0
}

fn psc_vsync_none(on: bool) {
}

fn prov_ok_none() -> bool {
    return false
}

fn prov_close_none() {
}

// THE GPU PROVIDER (W18-F3). Call BEFORE window_open (like window_set_gpu). `open(table)` fills the GL table of
// lib/paint/gl.fi and says whether it worked, `alive()` says whether the device still answers (asked after every frame),
// `close()` lets it go. The window asks for it only when the window layer has no GPU of its own (`window.gpu_open` false)
// and `window_set_gpu(fx, false)` was not called. Whatever fails -- no device, shader, canvas target, a frame later --
// the window paints on the CPU as if nothing had been set (a full repaint follows). The provider is a function pointer
// on purpose: importing std.dynlib here would make EVERY fUi program a dynamically linked ELF (OrientOS has no libc).
fn window_set_gpu_provider(fx: *mut Window, open: fn(*mut gl.GlApi) -> bool, alive: fn() -> bool, close: fn()) {
    (*fx).prov_on = true
    (*fx).prov_open = open
    (*fx).prov_ok = alive
    (*fx).prov_close = close
}

// W39: the provider's swapchain present (call BEFORE window_open, after window_set_gpu_provider). When the provider's GPU is up and
// the window has a native handle, `open(handle, w, h)` puts a swapchain on the window and every frame goes `show(w, h)` instead of
// read-back + CPU present. A swapchain that cannot be made, or stops working (show says 0), leaves the read-back path in charge.
fn window_set_gpu_present(fx: *mut Window, open: fn(u64, i32, i32) -> bool, show: fn(i32, i32) -> i32, close: fn(), vsync: fn(bool)) {
    (*fx).psc_on = true
    (*fx).psc_open = open
    (*fx).psc_show = show
    (*fx).psc_close = close
    (*fx).psc_vsync = vsync
}

// True while the canvas reaches the screen by the provider's swapchain (no read-back).
fn window_gpu_present(fx: *mut Window) -> bool {
    return (*fx).gpu_an && (*fx).gpu_rb && (*fx).pres_sc
}

// vsync on/off for the GPU paths that have a switch (WGL swap interval; the Vulkan swapchain: FIFO vs IMMEDIATE). Benchmarks only.
fn window_vsync(fx: *mut Window, on: bool) {
    let nv: bool = window.gpu_vsync(&(*fx).f, on)
    if (*fx).pres_sc {
        (*fx).psc_vsync(on)
    }
}

// Waits until the GPU has finished what was submitted (glFinish on the GL table; the Vulkan present waits for its fence anyway).
fn window_gpu_finish(fx: *mut Window) {
    if (*fx).gpu_an && !(*fx).gpu_rb {
        (*fx).gl.finish()
    }
}

// W38: the provider is tried BEFORE the window layer's own GPU (Windows has WGL / OpenGL and would otherwise never ask the provider:
// FUI_GPU=1 silently stayed on OpenGL). A provider that says no leaves the window layer's own GPU (or the CPU painter) in charge.
// W42-b: fake a failing GL stage (1 = no context, 2 = fUi's shaders do not build) to test the chain GL -> Vulkan -> CPU. 0 = off.
fn window_fail_gl(fx: *mut Window, mode: i32) {
    (*fx).gl_fail = mode
}

fn window_force_provider(fx: *mut Window, on: bool) {
    (*fx).prov_force = on
}

// True while the window paints on a provider's GPU and brings the canvas to the screen by read-back + CPU present.
fn window_gpu_readback(fx: *mut Window) -> bool {
    return (*fx).gpu_an && (*fx).gpu_rb
}

// THE PRESENT HOOK (r422). `f(ud, pixels, w, h)` gets the finished canvas (RGBA octets, top row first, packed
// w * h * 4) instead of RGBA -> BGRX + `window.image` + `window.present`, and brings it to the screen itself
// (lib/plat/fuiwingl.fi: upload as a texture, draw, swap -- on an OpenGL context of this very window). It returns
// true if the frame is on the screen. False = the hook is dropped for good and THIS frame takes the CPU path, so a
// broken GL never leaves the window empty. window_clear_present goes back to the CPU path.
fn window_set_present(fx: *mut Window, ud: u64, f: fn(u64, u64, usize, usize) -> bool) {
    (*fx).pres_on = true
    (*fx).pres_ud = ud
    (*fx).pres = f
}

fn window_clear_present(fx: *mut Window) {
    (*fx).pres_on = false
    (*fx).pres_ud = 0
    (*fx).pres = pres_none
}

fn window_present_hooked(fx: *mut Window) -> bool {
    return (*fx).pres_on
}

// THE INPUT HOOK. `f(ud, kind, a, state, x, y)` sees every EV_KEY, EV_CHAR
// and EV_BUTTON (and, when the window delivers them, EV_RAWKEY / EV_RAWKEY_UP / EV_FOCUS / EV_IME; their answer is ignored) before the host does (kind = window.EV_*, a = the key, the
// code point or the button, state = window.ev_state). For EV_KEY and
// EV_CHAR an answer of true means "taken" and the host never sees the
// event -- that is how a focused text field gets its letters, the space
// bar included. A button is only reported: the host still gets it (focus,
// press, release stay in ONE place, control.fi).
fn window_set_input_hook(fx: *mut Window, ud: u64,
    f: fn(u64, u32, u32, u32, f64, f64) -> bool) {
    (*fx).hook_on = true
    (*fx).hook_ud = ud
    (*fx).hook = f
}

// REAL POINTERS (roadmap r111). Call after `window_open`, when the program
// has an event router on the host (fuiwirt.host_set_router -- fui.app does
// it with its first `app.on`). A back end that has them (Android: every
// finger with its id, window.real_pointers) then feeds the host through
// fuiwirt.host_pointer with id, type, primary and time; the old events for
// the first finger (EV_BUTTON / EV_RELEASE / EV_LEAVE, and EV_MOTION while a
// pointer is down) are left out, or the finger would act twice. A back end
// without them (X11, Win32) keeps the one pointer: the mouse, which the
// router now sees as pointer 1 of type mouse. False = the one pointer.
fn window_use_pointers(fx: *mut Window, w: *mut fuiwirt.Host) -> bool {
    (*fx).real = false
    (*fx).rmouse = false
    if fuiwirt.host_router(w) as u64 != 0 as u64 || fuiwirt.host_has_pointer_sink(w) {
        (*fx).real = window.real_pointers(&(*fx).f, true)
        if (*fx).real {
            (*fx).rmouse = window.pointer_mouse(&(*fx).f)
        }
    }
    return (*fx).real
}

// One pointer record of the window layer -> the host.
fn pointer_record(fx: *mut Window, w: *mut fuiwirt.Host, p: *mut pointers.Pointer) {
    if (*p).kind == pointers.PK_DOWN {
        (*fx).pdown = (*fx).pdown + 1
    } else if ((*p).kind == pointers.PK_UP || (*p).kind == pointers.PK_CANCEL)
    && (*fx).pdown > 0 {
        (*fx).pdown = (*fx).pdown - 1
    }
    // pointers.PK_* and fuiwirt.PE_* are the same numbers
    let c: u32 = fuiwirt.host_pointer_p(w, (*p).kind, (*p).id, (*p).ptype,
        (*p).primary != 0 as u32, (*p).x, (*p).y, (*p).pressure, (*p).t)
}

// Escape closes the window by default (the demos want that); an
// application with its own Close button does not.
fn window_set_escape_closes(fx: *mut Window, on: bool) {
    (*fx).esc_zu = on
}

fn window_new() -> Window {
    return Window { f: window.window_new(), cv: canvas.canvas_new(),
        z: painter.painter_new(), fm: 0, bgrx: 0, cap: 0, w: 0, h: 0,
        full: false, log: false, images: 0, last_px: 0, open: false, esc_zu: true,
        gpu_will: true, gpu_an: false, gl: gl.gl_api_new(), gp: gpu.gpu_new(),
        hook_on: false, hook_ud: 0, hook: hook_none, real: false, rmouse: false, cur_shape: 0 as u32, pdown: 0,
        pres_on: false, pres_ud: 0, pres: pres_none,
        prov_on: false, prov_open: prov_open_none, prov_ok: prov_ok_none, prov_close: prov_close_none, gpu_rb: false, prov_force: false, gl_fail: 0,
        psc_on: false, psc_open: psc_open_none, psc_show: psc_show_none, psc_close: prov_close_none, psc_vsync: psc_vsync_none, pres_sc: false,
        hc: syspref.hcstate_new(), hm_text: false, hm_ins: false, hm_ud: 0, hm_cb: hm_none }
}

// ============================================================ ON THE GPU
//
// fUi tempo, stage 2b (24.09.2026). If the window offers a GPU
// (`window.gpu_open`: today Android, EGL + OpenGL ES 3), then the
// canvas lies on the GPU (lib/fui/gpu.fi): fUi paints into it there, a frame
// ends with ONE copy onto the screen and `window.gpu_swap` -- no
// RGBA -> BGRX, no octet-by-octet copying into the window buffer.
// Without a GPU (X11, Windows, Osum, a device without GLES 3) fUi paints as
// before in memory. `fenster_set_gpu(fx, false)` BEFORE opening
// switches it off (for comparing).
fn window_set_gpu(fx: *mut Window, an: bool) {
    (*fx).gpu_will = an
}

fn window_gpu(fx: *mut Window) -> bool {
    return (*fx).gpu_an
}

fn gpu_start(fx: *mut Window) {
    (*fx).gpu_an = false
    (*fx).gpu_rb = false
    if !(*fx).gpu_will || (*fx).cap == 0 {
        return
    }
    // THE CHAIN (lib/plat/gpuchain.fi): the window's own GL and the Vulkan provider in the order the policy gave; a stage that does not
    // open hands over to the next one, the CPU painter is what is left. `window_fail_gl` fakes a failing GL stage (tests).
    var tried: i32 = 0
    var guard: i32 = 0
    while guard < 3 {
        let st: i32 = gpuchain.next_stage(tried, (*fx).prov_on, (*fx).prov_force)
        if st == gpuchain.STAGE_CPU {
            return
        }
        tried = tried | gpuchain.stage_bit(st)
        if st == gpuchain.STAGE_VULKAN {
            gpu_start_provider(fx)
        } else {
            gpu_start_gl(fx)
        }
        if (*fx).gpu_an {
            return
        }
        guard = guard + 1
    }
}

// The window layer's own GL: context, fUi's renderer on it, canvas on the GPU. Any "no" gives the context back and leaves the
// table empty, so the next stage starts clean (W42-b: before, a GL context that opened but whose shaders did not build ended the
// chain on the CPU without asking Vulkan).
fn gpu_start_gl(fx: *mut Window) {
    if (*fx).gl_fail == 1 {
        return
    }
    if !window.gpu_open(&(*fx).f, (&(*fx).gl) as u64) {
        return
    }
    // phone budget for the GPU painter (an app's own gpu_set_budget wins)
    gpu.gpu_set_budget_default(1024, 1024, 1024, 512, 4096)
    if (*fx).gl_fail == 2 || !gpu.gpu_open(&(*fx).gp, &(*fx).gl) || !gpu.gpu_attach(&(*fx).gp, &(*fx).cv) {
        window.gpu_close(&(*fx).f)
        (*fx).gl = gl.gl_api_new()
        return
    }
    (*fx).gpu_an = true
    var nm: [u8; 3] = "gpu"
    line(fx, (&nm[0]) as u64, 3, 1, (*fx).w as i64, (*fx).h as i64, 0)
}

// The provider route: fill the table, open fUi's renderer on it, put the canvas on the GPU. Any "no" leaves the CPU painter
// in charge (the table is empty again, nothing is attached).
fn gpu_start_provider(fx: *mut Window) {
    if !(*fx).prov_on {
        return
    }
    let api: *mut gl.GlApi = &(*fx).gl
    if !(*fx).prov_open(api) {
        *api = gl.gl_api_new()
        return
    }
    if !gpu.gpu_open(&(*fx).gp, api) {
        *api = gl.gl_api_new()
        return
    }
    if !gpu.gpu_attach(&(*fx).gp, &(*fx).cv) {
        *api = gl.gl_api_new()
        return
    }
    (*fx).gpu_an = true
    (*fx).gpu_rb = true
    (*fx).pres_sc = false
    if (*fx).psc_on {
        let nat: u64 = window.native_handle(&(*fx).f)
        if nat != 0 {
            (*fx).pres_sc = (*fx).psc_open(nat, (*fx).w as i32, (*fx).h as i32)
        }
    }
    var nm: [u8; 3] = "gpu"
    var mode: i64 = 2
    if (*fx).pres_sc { mode = 3 }
    line(fx, (&nm[0]) as u64, 3, mode, (*fx).w as i64, (*fx).h as i64, 0)
}

// The swapchain goes (its surface must be gone before the CPU present draws on the same window again).
fn present_drop(fx: *mut Window) {
    if (*fx).pres_sc {
        (*fx).psc_close()
        (*fx).pres_sc = false
    }
}

// The provider's GPU is gone (a frame failed, the canvas could not be put on it again): back to the CPU painter for the rest of
// the run. The canvas keeps its memory, so the next full repaint is an ordinary CPU frame.
fn gpu_drop(fx: *mut Window) {
    if !(*fx).gpu_an {
        return
    }
    gpu.gpu_detach(&(*fx).gp, &(*fx).cv)
    present_drop(fx)
    (*fx).gpu_an = false
    (*fx).gpu_rb = false
    (*fx).prov_on = false
    var nm: [u8; 3] = "gpu"
    line(fx, (&nm[0]) as u64, 3, 0, (*fx).w as i64, (*fx).h as i64, 0)
}

// Write accesses that bypassed the GPU (canvas.fi counts them):
// into the log as soon as there are new ones -- a hole in the picture is thereby noticed.
static mut G_HASH: u64 = 0

fn hash_report(fx: *mut Window) {
    let n: u64 = canvas.canvas_stray_writes()
    if n == G_HASH {
        return
    }
    G_HASH = n
    var nm: [u8; 5] = "streu"
    line(fx, (&nm[0]) as u64, 5, n as i64, 0, 0, 0)
    let s: str = "fui.gpu: writes that missed the GPU\n"
    rt.write_everything(2, s.p as u64, s.n)
}

fn window_canvas(fx: *mut Window) -> *mut canvas.Canvas { return &(*fx).cv }
fn window_painter(fx: *mut Window) -> *mut painter.Painter { return &(*fx).z }
fn window_w(fx: *mut Window) -> usize { return (*fx).w }
// Pixels handed to the screen by the last frame.
fn window_last_px(fx: *mut Window) -> i64 { return (*fx).last_px }
fn window_h(fx: *mut Window) -> usize { return (*fx).h }
fn window_window(fx: *mut Window) -> *mut window.Window { return &(*fx).f }
fn window_full(fx: *mut Window) -> bool { return (*fx).full }

fn window_apply_cursor(fx: *mut Window, shape: u32) {
    if shape == (*fx).cur_shape {
        return
    }
    if window.cursor_shape(&(*fx).f, shape) {
        (*fx).cur_shape = shape
    }
}
fn window_images(fx: *mut Window) -> u64 { return (*fx).images }

fn window_set_font(fx: *mut Window, fm: u64) {
    (*fx).fm = fm
    painter.painter_set_font(&(*fx).z, fm)
}

fn window_log(fx: *mut Window, an: bool) {
    (*fx).log = an
}

// The clock against which the animations run: CLOCK_MONOTONIC in ms.
fn now_ms() -> i64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return ts[0] * 1000 + ts[1] / 1000000
}

// RECORDER HOOK (opt-in, r265): while a recorder is attached (apphost: FUI_RECORD=<file>) the plain mouse, key and char
// paths of `window_step` go through the rec_* wrappers, which log the event and forward it to the host unchanged.
// Touch records and the routed pointer path are not logged (the log format knows M/D/U/L/C/K/H/T only).
static mut G_REC: u64 = 0

#[allow_escape]
fn rec_attach(r: *mut recorder.Rec) { G_REC = r as u64 }
fn rec_detach() { G_REC = 0 }

fn fw_move(w: *mut fuiwirt.Host, x: f64, y: f64) -> u32 {
    if G_REC != 0 as u64 { return recorder.rec_move(G_REC as *mut recorder.Rec, w, x, y, now_ms()) }
    return fuiwirt.host_pointer_move(w, x, y)
}
fn fw_down(w: *mut fuiwirt.Host, x: f64, y: f64, b: u32) -> u32 {
    if G_REC != 0 as u64 { return recorder.rec_down(G_REC as *mut recorder.Rec, w, x, y, b, now_ms()) }
    return fuiwirt.host_pointer_down(w, x, y, b)
}
fn fw_up(w: *mut fuiwirt.Host, x: f64, y: f64, b: u32) -> u32 {
    if G_REC != 0 as u64 { return recorder.rec_up(G_REC as *mut recorder.Rec, w, x, y, b, now_ms()) }
    return fuiwirt.host_pointer_up(w, x, y, b)
}
fn fw_leave(w: *mut fuiwirt.Host) -> u32 {
    if G_REC != 0 as u64 { return recorder.rec_leave(G_REC as *mut recorder.Rec, w, now_ms()) }
    return fuiwirt.host_pointer_leave(w)
}
fn fw_key(w: *mut fuiwirt.Host, k: u32, mods: u32) -> u32 {
    if G_REC != 0 as u64 { return recorder.rec_key(G_REC as *mut recorder.Rec, w, k, mods, now_ms()) }
    return fuiwirt.host_key(w, k, mods)
}
fn fw_char(w: *mut fuiwirt.Host, cp: u32, mods: u32) -> u32 {
    if G_REC != 0 as u64 { return recorder.rec_char(G_REC as *mut recorder.Rec, w, cp, mods, now_ms()) }
    return fuiwirt.host_char(w, cp, mods)
}
fn fw_tick(w: *mut fuiwirt.Host) {
    if G_REC != 0 as u64 {
        recorder.rec_tick(G_REC as *mut recorder.Rec, w, now_ms())
        return
    }
    fuiwirt.host_tick(w, now_ms())
}

// Canvas, painter and BGRX buffer for `w` x `h` -- new, not stretched.
fn flaechen(fx: *mut Window, w: usize, h: usize) -> bool {
    if (*fx).cap > 0 {
        painter.painter_free(&(*fx).z)
        canvas.canvas_free(&(*fx).cv)
        rt.heap_free((*fx).bgrx, (*fx).cap)
        (*fx).cap = 0
    }
    if !canvas.canvas_init(&(*fx).cv, w, h) {
        return false
    }
    if !painter.painter_init(&(*fx).z, &(*fx).cv, w, h) {
        return false
    }
    painter.painter_set_font(&(*fx).z, (*fx).fm)
    (*fx).bgrx = rt.heap_alloc(w * h * 4)
    if (*fx).bgrx == 0 {
        return false
    }
    (*fx).cap = w * h * 4
    (*fx).w = w
    (*fx).h = h
    // the new canvas back onto the GPU (a target of the new size)
    if (*fx).gpu_an && !gpu.gpu_attach(&(*fx).gp, &(*fx).cv) {
        present_drop(fx)
        (*fx).gpu_an = false
        (*fx).gpu_rb = false
    }
    return true
}

// OPENING. `bw`/`bh` are DESIGN POINTS: the start size is converted like
// every other length via the theme, after the scale
// of the screen is known. `anzeige` 0 = $DISPLAY.
// `#[allow_escape]`: the window's address is kept (G_CLIPWIN) for the
// clipboard functions a text field calls without a context. It is
// cleared again in `fenster_close`, and a Fenster lives from open to
// close by contract.
#[allow_escape]
fn window_open(fx: *mut Window, w: *mut fuiwirt.Host, m: *mut theme.Theme,
    disp: usize, bw: usize, bh: usize, titel: u64, tn: usize) -> bool {
    if !window.open_window(&(*fx).f, disp) {
        return false
    }
    fuiwirt.host_set_scale(w, m, window.uiscale(&(*fx).f))
    let pw: usize = theme.theme_px(m, bw)
    let ph: usize = theme.theme_px(m, bh)
    // Release, enter, leave -- order BEFORE the window.
    (*fx).full = window.full_input(&(*fx).f, true)
    if !window.make(&(*fx).f, pw, ph) {
        return false
    }
    // W39-b r359: the window may sit on a screen whose density differs from the one the start size was
    // converted with (Windows: system vs monitor density) -- take the real one now.
    fuiwirt.host_set_scale(w, m, window.uiscale(&(*fx).f))
    let t: bool = window.title(&(*fx).f, titel, tn)
    if !flaechen(fx, window.width(&(*fx).f), window.height(&(*fx).f)) {
        return false
    }
    if !window.show_window(&(*fx).f) {
        return false
    }
    gpu_start(fx)
    (*fx).open = true
    G_CLIPWIN = (&(*fx).f) as u64
    transparency_sync(&(*fx).f)
    return true
}

// r264: the system's "reduced transparency" answer (window layer: desktop setting / Windows switch) onto the glass
// surfaces (syspref -> glasspane.set_reduced). Unknown = no change. Runs at open and on every EV_THEME.
fn transparency_sync(f: *mut window.Window) {
    if !window.transparency_known(f) && !window.contrast_known(f) {
        return
    }
    var sp: syspref.SysPref = syspref.syspref_new()
    if window.transparency_known(f) {
        if window.transparency_is_spi(f) {
            syspref.transparency_from_spi(!window.transparency_reduced(f), &sp)
        } else {
            syspref.transparency_from_gsettings(!window.transparency_reduced(f), &sp)
        }
    }
    // W40-a: high contrast reduces transparency as well (syspref.transparency_reduced)
    sp.contrast = window.contrast_known(f) && window.contrast_on(f)
    let r: bool = syspref.transparency_apply(&sp)
}

// W40-a: THE SYSTEM'S LOOK onto the theme `m`: light/dark (when the window knows it), then HIGH CONTRAST on top (the built-in
// High Contrast theme, syspref.hc_sync) or given back, then the glass follows (transparency_sync: contrast = flat). The host
// calls it once after opening and on every EV_THEME. A window that is not asked about contrast (backends without an answer) keeps its theme.
fn window_follow_text_scale(fx: *mut Window, on: bool) {
    (*fx).hm_text = on
}

// `cb(ud, left, top, right, bottom)` is told the system bars over the window in device pixels (0,0,0,0 = none / not known).
fn window_follow_insets(fx: *mut Window, ud: u64, cb: fn(u64, f64, f64, f64, f64)) {
    (*fx).hm_ins = true
    (*fx).hm_ud = ud
    (*fx).hm_cb = cb
}

// The user's text size in per mille: FUI_TEXT_SCALE=<1.25 | 125> first (manual switch, tests), then the window layer (Windows
// TextScaleFactor, GNOME text-scaling-factor, Android fontScale). 0 = no answer = leave the sizes alone.
fn host_text_scale(fx: *mut Window) -> usize {
    var b: [u8; 64] = [0; 64]
    let n: usize = envvar.env_value_copy("FUI_TEXT_SCALE", (&b[0]) as u64, 64)
    if n > 0 {
        return hostmetrics.parse_scale_permille((&b[0]) as u64, n)
    }
    return window.text_scale(&(*fx).f)
}

// The system bars over the window: FUI_INSETS=l,t,r,b (device pixels) first, then the window layer (work area / WindowInsets).
// false = unknown.
fn host_insets(fx: *mut Window, out: *mut [f64; 4]) -> bool {
    var b: [u8; 96] = [0; 96]
    let n: usize = envvar.env_value_copy("FUI_INSETS", (&b[0]) as u64, 96)
    if n > 0 {
        return hostmetrics.parse_insets((&b[0]) as u64, n, out)
    }
    return window.insets(&(*fx).f, out)
}

fn window_system_look(fx: *mut Window, m: *mut theme.Theme) {
    let f: *mut window.Window = &(*fx).f
    if window.theme_known(f) {
        theme.theme_set_dark(m, window.dark(f))
    }
    if window.contrast_known(f) {
        let ch: bool = syspref.hc_sync(&(*fx).hc, m, window.contrast_on(f))
    }
    if (*fx).hm_text {
        theme.theme_set_text_scale(m, host_text_scale(fx))
    }
    if (*fx).hm_ins {
        var o: [f64; 4] = [0.0; 4]
        if host_insets(fx, &o) {
            (*fx).hm_cb((*fx).hm_ud, o[0], o[1], o[2], o[3])
        } else {
            (*fx).hm_cb((*fx).hm_ud, 0.0, 0.0, 0.0, 0.0)
        }
    }
    transparency_sync(f)
}

// ================================================ SEVERAL WINDOWS
//
// OpenPlan LIB-005. Every Fenster is a window of its own (under X11 with
// a connection of its own). A program with several of them waits for all
// at once and then steps each:
//
//     var fs: [u64; 8] = [(&a) as u64, (&b) as u64, 0, 0, 0, 0, 0, 0]
//     var ws: [u64; 8] = [(&wa) as u64, (&wb) as u64, 0, 0, 0, 0, 0, 0]
//     while open_a || open_b {
//         fuiwin.fenster_wait_many(&fs, &ws, 2)
//         if open_a { open_a = fuiwin.fenster_step(&a, &wa, &ma, male_a, akt_a, ud) }
//         if open_b { open_b = fuiwin.fenster_step(&b, &wb, &mb, male_b, akt_b, ud) }
//     }
//
// It waits as long as the most impatient window allows (an animation
// wants its next frame in 16 ms) or until one of them has an event. A
// closed window (0 in `fs`) is skipped. The answer is the index of a
// window with an event, or -1 when the time ran out.
fn window_wait_many(fs: *mut [u64; 8], ws: *mut [u64; 8], n: usize) -> i64 {
    var ms: i64 = fuiwirt.WAIT_FOREVER
    var wins: [u64; 8] = [0 as u64; 8]
    var k: usize = 0
    var i: usize = 0
    while i < n && i < 8 {
        if (*fs)[i] != 0 && (*ws)[i] != 0 {
            let fx: *mut Window = (*fs)[i] as *mut Window
            let wm: i64 = fuiwirt.host_wait_ms((*ws)[i] as *mut fuiwirt.Host)
            if wm == 0 {
                return i as i64
            }
            if wm > 0 && (ms < 0 || wm < ms) {
                ms = wm
            }
            wins[k] = (&(*fx).f) as u64
            k = k + 1
        }
        i = i + 1
    }
    if k == 0 {
        return -1
    }
    return window.wait_any(&wins, k, ms)
}

// ROUND ASYNC: the same wait, with the event loop's descriptor in it.
//
//     let ms: i64 = loop.embed_wait_ms(&l, 1000)          // timers, defers
//     let hit: i64 = fuiwin.window_wait_many_fd(&fs, &ws, 1, loop.loop_fd(&l), ms)
//     loop.run_once(&l, 0)                                // network, timers, posts
//     if hit >= 0 { fuiwin.window_step(...) }             // the window's events
//
// `fd` < 0 behaves like `window_wait_many`; `cap_ms` (-1 = none) is an upper
// limit on top of what the windows want (an animation, ...). The answer is
// the index of a window with an event, -1 for the time, -2 when `fd` is
// readable. Results of other threads reach the UI thread through
// `async.post` and its wake-up, which makes the loop's descriptor readable.
fn window_wait_many_fd(fs: *mut [u64; 8], ws: *mut [u64; 8], n: usize, fd: i32,
    cap_ms: i64) -> i64 {
    var ms: i64 = fuiwirt.WAIT_FOREVER
    var wins: [u64; 8] = [0 as u64; 8]
    var k: usize = 0
    var i: usize = 0
    while i < n && i < 8 {
        if (*fs)[i] != 0 && (*ws)[i] != 0 {
            let fx: *mut Window = (*fs)[i] as *mut Window
            let wm: i64 = fuiwirt.host_wait_ms((*ws)[i] as *mut fuiwirt.Host)
            if wm == 0 {
                return i as i64
            }
            if wm > 0 && (ms < 0 || wm < ms) {
                ms = wm
            }
            wins[k] = (&(*fx).f) as u64
            k = k + 1
        }
        i = i + 1
    }
    if cap_ms >= 0 && (ms < 0 || cap_ms < ms) {
        ms = cap_ms
    }
    if k == 0 && fd < 0 {
        return -1
    }
    return window.wait_any_fd(&wins, k, fd, ms)
}

// ================================================ THE SYSTEM CLIPBOARD
//
// OpenPlan LIB-006. The two functions a text field wants
// (editor.editor_set_clipboard), on the clipboard of the window opened
// last:
//
//     editor.editor_set_clipboard(&ed, fuiwin.fenster_clip_read, fuiwin.fenster_clip_write)
//
// Text only (text/plain;charset=utf-8). A backend without a system
// clipboard answers 0/false, and the field keeps its internal one.
static mut G_CLIPWIN: u64 = 0

fn window_clip_read(p: u64, cap: usize) -> usize {
    if G_CLIPWIN == 0 {
        return 0
    }
    var b: rt.Buf = rt.buf_new()
    var n: usize = 0
    if window.clipboard_get(G_CLIPWIN as *mut window.Window, "text/plain;charset=utf-8", &b) {
        n = rt.buf_len(&b)
        if n > cap {
            // cut at a character boundary, not in the middle of one
            n = cap
            while n > 0 && (rt.ld8(rt.buf_ptr(&b), n) & 192 as u8) == 128 as u8 {
                n = n - 1
            }
        }
        rt.mem_copy(p, rt.buf_ptr(&b), n)
    }
    rt.buf_free(&b)
    return n
}

fn window_clip_write(p: u64, n: usize) -> bool {
    if G_CLIPWIN == 0 {
        return false
    }
    let w: *mut window.Window = G_CLIPWIN as *mut window.Window
    window.clipboard_clear(w)
    return window.clipboard_set(w, "text/plain;charset=utf-8", p, n)
}

fn window_close(fx: *mut Window) {
    window_clear_present(fx)
    if (*fx).gpu_an {
        gpu.gpu_detach(&(*fx).gp, &(*fx).cv)
        if (*fx).gpu_rb {
            present_drop(fx)
            (*fx).prov_close()
        } else {
            window.gpu_close(&(*fx).f)
        }
        (*fx).gpu_an = false
        (*fx).gpu_rb = false
    }
    if (*fx).cap > 0 {
        painter.painter_free(&(*fx).z)
        canvas.canvas_free(&(*fx).cv)
        rt.heap_free((*fx).bgrx, (*fx).cap)
        (*fx).cap = 0
    }
    window.close_window(&(*fx).f)
    (*fx).open = false
    if G_CLIPWIN == (&(*fx).f) as u64 {
        G_CLIPWIN = 0
    }
}

fn line(fx: *mut Window, was: u64, wn: usize, a: i64, b: i64, c: i64,
    d: i64) {
    if !(*fx).log {
        return
    }
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, was, wn)
    rt.buf_push(&t, 32 as u8)
    rt.buf_push_dec_i64(&t, a)
    rt.buf_push(&t, 32 as u8)
    rt.buf_push_dec_i64(&t, b)
    rt.buf_push(&t, 32 as u8)
    rt.buf_push_dec_i64(&t, c)
    rt.buf_push(&t, 32 as u8)
    rt.buf_push_dec_i64(&t, d)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// Key of the window system -> key of the host; 0 = none for it.
// A window key (window.K_*) as the host's key (fuiwirt.KEY_*), 0 = none.
fn host_key_of(k: u32) -> u32 {
    return taste(k)
}

fn taste(k: u32) -> u32 {
    if k == window.K_TAB { return fuiwirt.KEY_TAB }
    if k == window.K_RETURN { return fuiwirt.KEY_RETURN }
    if k == window.K_UP { return fuiwirt.KEY_UP }
    if k == window.K_DOWN { return fuiwirt.KEY_DOWN }
    if k == window.K_LEFT { return fuiwirt.KEY_LEFT }
    if k == window.K_RIGHT { return fuiwirt.KEY_RIGHT }
    if k == window.K_PAGEUP { return fuiwirt.KEY_PAGE_UP }
    if k == window.K_PAGEDOWN { return fuiwirt.KEY_PAGE_DOWN }
    if k == window.K_HOME { return fuiwirt.KEY_HOME }
    if k == window.K_END { return fuiwirt.KEY_END }
    if k == window.K_ESCAPE { return fuiwirt.KEY_ESCAPE }
    if k == window.K_MENU { return fuiwirt.KEY_MENU }
    if k == window.K_F10 { return fuiwirt.KEY_F10 }
    return 0 as u32
}

// ONE EVENT -> THE HOST. false = the window is closed.
fn fork(fx: *mut Window, w: *mut fuiwirt.Host, m: *mut theme.Theme,
    k: u32) -> bool {
    let f: *mut window.Window = &(*fx).f
    let a: u32 = window.ev_a(f)
    let x: f64 = window.ev_x(f) as f64
    let y: f64 = window.ev_y(f) as f64
    let s: u32 = window.ev_state(f)
    let routed: bool = fuiwirt.host_router(w) as u64 != 0 as u64
    var nm: [u8; 8] = "ereignis"
    line(fx, (&nm[0]) as u64, 8, k as i64, a as i64, x as i64, y as i64)
    if k == window.EV_CLOSED {
        return false
    }
    // the modifiers of THIS event for everything below (context requests)
    fuiwirt.host_set_mods(w, s)
    // A MENU IS OPEN (r161): it is modal -- the keys and characters are its,
    // before the application's hook and before "Esc closes the window".
    if fuiwirt.host_popup_open(w) {
        if k == window.EV_KEY {
            let tp: u32 = taste(a)
            let cp: u32 = fw_key(w, tp, s)
            return true
        }
        if k == window.EV_CHAR {
            let cq: u32 = fw_char(w, a, s)
            return true
        }
    }
    // TEXT INPUT (lib/plat/fuitext.fi): raw keys (a = scancode, state, y = time ms), focus (a = 1/0) and Windows IME messages (a = message,
    // x = GCS_* flags) go to the input hook only; the host has no use for them. An open menu is modal: it gets no raw key presses.
    if k == window.EV_RAWKEY || k == window.EV_RAWKEY_UP || k == window.EV_FOCUS || k == window.EV_IME {
        if (*fx).hook_on && !(k == window.EV_RAWKEY && fuiwirt.host_popup_open(w)) {
            let ignored: bool = (*fx).hook((*fx).hook_ud, k, a, s, x, y)
        }
        return true
    }
    // a global hotkey (window.extras.hotkey_set) goes to the input hook only
    if k == window.EV_HOTKEY {
        if (*fx).hook_on {
            let ignored2: bool = (*fx).hook((*fx).hook_ud, k, a, s, x, y)
        }
        return true
    }
    if (*fx).hook_on && (k == window.EV_KEY || k == window.EV_CHAR
        || k == window.EV_BUTTON) {
        let taken: bool = (*fx).hook((*fx).hook_ud, k, a, s, x, y)
        if taken && k != window.EV_BUTTON {
            return true
        }
    }
    if k == window.EV_EXPOSE {
        fuiwirt.host_expose(w)
    } else if k == window.EV_CONFIGURE {
        // an open menu does not follow a window that moves or resizes
        fuiwirt.host_popup_note(w, 1 as u32)
        let nw: usize = window.width(f)
        let nh: usize = window.height(f)
        if nw != (*fx).w || nh != (*fx).h {
            if !flaechen(fx, nw, nh) {
                return false
            }
        }
        // Another screen can have a different density.
        fuiwirt.host_set_scale(w, m, window.uiscale(f))
        fuiwirt.host_resize(w)
    } else if k == window.EV_MOTION || k == window.EV_ENTER {
        if (*fx).rmouse {
            // the fingers come as records; a hovering mouse still moves
            if (*fx).pdown == 0 {
                let c: u32 = fw_move(w, x, y)
            }
        } else if routed {
            let c: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_MOVE, 1 as u32,
                event.PT_MOUSE, true, x, y, now_ms())
        } else {
            let c: u32 = fw_move(w, x, y)
        }
    } else if k == window.EV_LEAVE {
        if (*fx).rmouse {
            // a finger that lifts is an UP record, not a leave
        } else if routed {
            let c: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_LEAVE, 1 as u32,
                event.PT_MOUSE, true, x, y, now_ms())
        } else {
            let c: u32 = fw_leave(w)
        }
    } else if k == window.EV_BUTTON {
        if a == fuiwirt.BTN_LEFT && (*fx).rmouse {
            // comes as a record
        } else if a == fuiwirt.BTN_LEFT && routed {
            let c: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_DOWN, 1 as u32,
                event.PT_MOUSE, true, x, y, now_ms())
            if !(*fx).full {
                let c2: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_UP, 1 as u32,
                    event.PT_MOUSE, true, x, y, now_ms())
            }
        } else {
            let c: u32 = fw_down(w, x, y, a)
            // Without release from the back end a click is the press
            // alone -- honestly worse, but operable.
            if !(*fx).full && a == fuiwirt.BTN_LEFT {
                let c2: u32 = fw_up(w, x, y, a)
            }
        }
    } else if k == window.EV_RELEASE {
        if a == fuiwirt.BTN_LEFT && (*fx).rmouse {
            // comes as a record
        } else if a == fuiwirt.BTN_LEFT && routed {
            let c: u32 = fuiwirt.host_pointer(w, fuiwirt.PE_UP, 1 as u32,
                event.PT_MOUSE, true, x, y, now_ms())
        } else {
            let c: u32 = fw_up(w, x, y, a)
        }
    } else if k == window.EV_KEY {
        if a == window.K_ESCAPE && (*fx).esc_zu {
            return false
        }
        let t: u32 = taste(a)
        if t != 0 as u32 {
            let c: u32 = fw_key(w, t, s)
        }
    } else if k == window.EV_CHAR {
        let c: u32 = fw_char(w, a, s)
    } else if k == window.EV_THEME {
        theme.theme_set_dark(m, window.dark(f))
        window_system_look(fx, m)
        fuiwirt.host_touch(w)
    }
    return true
}

// THE LOOP. `male(ud, fx)` paints the page into `fenster_canvas(fx)`
// (size fenster_w/h); `aktion(ud, fx, knoten)` learns which
// node was triggered. Returns when the window is closed.
fn window_run(fx: *mut Window, w: *mut fuiwirt.Host, m: *mut theme.Theme,
    times: fn(u64, *mut Window), aktion: fn(u64, *mut Window, usize),
    ud: u64) {
    let f: *mut window.Window = &(*fx).f
    var runs: bool = true
    while runs {
        let ms: i64 = fuiwirt.host_wait_ms(w)
        // In the log: how long the loop now WANTS to sleep (-1 =
        // until an event comes). That is the proof for idling.
        var dn: [u8; 5] = "warte"
        line(fx, (&dn[0]) as u64, 5, ms, now_ms(), 0, 0)
        if ms != 0 {
            let da: bool = window.wait_event(f, ms)
        }
        runs = window_step(fx, w, m, times, aktion, ud)
    }
}

// ONE TURN of the loop without the waiting: the events that are there,
// the activated control, the animation tick, a frame if something
// changed. false = the window is closed (or the program asked to end).
// `fenster_run` is this in a loop with the wait in front; a program with
// SEVERAL windows (OpenPlan LIB-005: pages in windows of their own) waits
// with `fenster_wait_many` and then steps every window.
fn window_step(fx: *mut Window, w: *mut fuiwirt.Host, m: *mut theme.Theme,
    times: fn(u64, *mut Window), aktion: fn(u64, *mut Window, usize),
    ud: u64) -> bool {
    let f: *mut window.Window = &(*fx).f
    var runs: bool = true
    if (*fx).real {
        var pr: pointers.Pointer = pointers.ptr_blank()
        while window.next_pointer(f, (&pr) as u64) {
            pointer_record(fx, w, &pr)
        }
    }
    var k: u32 = window.next_event(f)
    while k != window.EV_NONE && runs {
        if !fork(fx, w, m, k) {
            runs = false
        } else {
            k = window.next_event(f)
        }
    }
    if !runs {
        return false
    }
    let akt: usize = fuiwirt.host_take_activated(w)
    if akt != fuiwirt.KEINER {
        aktion(ud, fx, akt)
    }
    fw_tick(w)
    if fuiwirt.host_dirty(w) {
        // A partial repaint builds on the canvas of the last frame, which
        // only the plain CPU path keeps: on the GPU and with a present hook
        // the whole window is painted.
        if (*fx).gpu_an || (*fx).pres_on {
            fuiwirt.host_touch(w)
        }
        let q0: i64 = now_ms()
        var q2: i64 = q0
        var q3: i64 = q0
        var q1: i64 = q0
        if (*fx).gpu_an && (*fx).gpu_rb {
            // ON A PROVIDER'S GPU (Vulkan): paint there, read the whole canvas back, then the ordinary CPU present
            gpu.gpu_frame_begin(&(*fx).gp, (*fx).w as i32, (*fx).h as i32)
            times(ud, fx)
            q1 = now_ms()
            var shown: bool = false
            if (*fx).pres_sc {
                // W39: the canvas target goes into the swapchain image on the GPU: no read-back, no RGBA -> BGRX, no PutImage
                gpu.gpu_target_bind(&(*fx).gp)
                let pr: i32 = (*fx).psc_show((*fx).w as i32, (*fx).h as i32)
                if pr == 1 {
                    shown = true
                } else {
                    // not shown: the swapchain is dropped for good, this frame takes the read-back route (a device that is gone is
                    // found by prov_ok below)
                    present_drop(fx)
                }
            }
            if shown {
                hash_report(fx)
                q2 = now_ms()
                (*fx).last_px = ((*fx).w * (*fx).h) as i64
                q3 = q2
            } else {
                gpu.gpu_read(&(*fx).gp, 0, 0, (*fx).w as i32, (*fx).h as i32, canvas.canvas_pixels(&(*fx).cv) as u64, (*fx).w * 4)
                hash_report(fx)
                if !(*fx).prov_ok() {
                    // the device failed during this frame: the read-back is not a picture. CPU for good, this frame is painted again
                    gpu_drop(fx)
                    times(ud, fx)
                    q1 = now_ms()
                }
                let dg: bool = window.rgba_native(f)
                fuiblit.full_prepare(dg, canvas.canvas_pixels(&(*fx).cv) as u64, (*fx).bgrx, (*fx).w * (*fx).h)
                q2 = now_ms()
                let okg: bool = fuiblit.full_put(f, dg, canvas.canvas_pixels(&(*fx).cv) as u64, (*fx).bgrx, (*fx).w, (*fx).h)
                let okp: bool = window.present(f)
                (*fx).last_px = ((*fx).w * (*fx).h) as i64
                q3 = now_ms()
            }
        } else if (*fx).gpu_an {
            // ON THE GPU: paint, one copy onto the screen, swap
            var pl: [u64; 4] = [0; 4]
            window.gpu_place(f, (&pl[0]) as u64)
            if pl[2] == 0 || pl[3] == 0 {
                // NO SURFACE (the window is gone, e.g. after HOME): every GL call would hit "no current context".
                // Nothing is painted; the window that comes back sends EV_EXPOSE, which paints everything again
                q1 = now_ms()
                q2 = q1
                q3 = q1
            } else {
                gpu.gpu_set_origin(pl[0] as i32, pl[1] as i32)
                gpu.gpu_frame_begin(&(*fx).gp, pl[2] as i32, pl[3] as i32)
                times(ud, fx)
                q1 = now_ms()
                gpu.gpu_present_at(&(*fx).gp, pl[0] as i32, pl[1] as i32)
                hash_report(fx)
                q2 = now_ms()
                let ok3: bool = window.gpu_swap(f)
                q3 = now_ms()
                if window.gpu_lost(f) {
                    // the context is gone and with it every GL object: open
                    // anew, and everything is painted once more
                    gpu_start(fx)
                    fuiwirt.host_touch(w)
                }
            }
        } else if (*fx).pres_on {
            // THE PRESENT HOOK: the canvas goes to the screen through the hook (OpenGL window)
            times(ud, fx)
            q1 = now_ms()
            q2 = q1
            let shown: bool = (*fx).pres((*fx).pres_ud, canvas.canvas_pixels(&(*fx).cv) as u64, (*fx).w, (*fx).h)
            if !shown {
                // the hook failed: gone for good, this frame takes the CPU path
                window_clear_present(fx)
                let d4: bool = window.rgba_native(f)
                fuiblit.full_prepare(d4, canvas.canvas_pixels(&(*fx).cv) as u64, (*fx).bgrx, (*fx).w * (*fx).h)
                let ok4: bool = fuiblit.full_put(f, d4, canvas.canvas_pixels(&(*fx).cv) as u64, (*fx).bgrx, (*fx).w, (*fx).h)
                let ok5: bool = window.present(f)
            }
            q3 = now_ms()
        } else {
            times(ud, fx)
            q1 = now_ms()
            // ONLY WHAT WAS PAINTED GOES TO THE SCREEN: the damaged
            // rectangles (a hover is one button), else the whole window
            var rs: [i64; 16] = [0; 16]
            let nr: usize = fuiwirt.host_damage_rects(w, (*fx).w, (*fx).h, &rs)
            if nr > 0 {
                // the bounding box first: a back end that locks a buffer (Android)
                // needs the dirty bounds before the first image
                var bx0: i64 = rs[0]
                var by0: i64 = rs[1]
                var bx1: i64 = rs[2]
                var by1: i64 = rs[3]
                var rect_i: usize = 1
                while rect_i < nr {
                    if rs[rect_i * 4] < bx0 { bx0 = rs[rect_i * 4] }
                    if rs[rect_i * 4 + 1] < by0 { by0 = rs[rect_i * 4 + 1] }
                    if rs[rect_i * 4 + 2] > bx1 { bx1 = rs[rect_i * 4 + 2] }
                    if rs[rect_i * 4 + 3] > by1 { by1 = rs[rect_i * 4 + 3] }
                    rect_i = rect_i + 1
                }
                window.damage_hint(f, bx0 as usize, by0 as usize, bx1 as usize, by1 as usize)
                let drect: bool = window.rgba_native(f)
                var px: i64 = 0
                rect_i = 0
                while rect_i < nr {
                    var rc: [i64; 4] = [rs[rect_i * 4], rs[rect_i * 4 + 1], rs[rect_i * 4 + 2], rs[rect_i * 4 + 3]]
                    let okr: bool = fuiblit.rect_put(f, drect, canvas.canvas_pixels(&(*fx).cv) as u64,
                        (*fx).bgrx, (*fx).w, &rc)
                    px = px + (rc[2] - rc[0]) * (rc[3] - rc[1])
                    rect_i = rect_i + 1
                }
                q2 = now_ms()
                // each rectangle goes to the screen alone (a hover in two
                // corners is two small blits, not one big one)
                rect_i = 0
                while rect_i < nr {
                    let okp: bool = window.present_rect(f, rs[rect_i * 4] as usize, rs[rect_i * 4 + 1] as usize,
                        (rs[rect_i * 4 + 2] - rs[rect_i * 4]) as usize, (rs[rect_i * 4 + 3] - rs[rect_i * 4 + 1]) as usize,
                        rect_i + 1 < nr)
                    rect_i = rect_i + 1
                }
                (*fx).last_px = px
            } else {
                let d0: bool = window.rgba_native(f)
                fuiblit.full_prepare(d0, canvas.canvas_pixels(&(*fx).cv) as u64, (*fx).bgrx, (*fx).w * (*fx).h)
                q2 = now_ms()
                let ok: bool = fuiblit.full_put(f, d0, canvas.canvas_pixels(&(*fx).cv) as u64, (*fx).bgrx, (*fx).w, (*fx).h)
                let ok2: bool = window.present(f)
                (*fx).last_px = ((*fx).w * (*fx).h) as i64
            }
            q3 = now_ms()
        }
        // Where the time of a frame goes: paint fUi, RGBA->BGRX,
        // PutImage -- in ms. Measured, so that nobody suspects the platform
        // when the rasteriser is slow (and the other way round).
        var tn: [u8; 4] = "zeit"
        line(fx, (&tn[0]) as u64, 4, q1 - q0, q2 - q1, q3 - q2, 0)
        fuiwirt.host_painted_at(w, now_ms())
        (*fx).images = (*fx).images + 1
        var nm: [u8; 4] = "bild"
        line(fx, (&nm[0]) as u64, 4, (*fx).images as i64,
            (*fx).w as i64, (*fx).h as i64,
            theme.theme_scale(m) as i64)
        // After arranging, a different node may lie under the standing
        // pointer (scrolled) -- the host catches up with that,
        // and then painting happens once more.
        let c: u32 = fuiwirt.host_after_layout(w)
    }
    return window.is_open(f)
}
