import paint.canvas
import paint.gl
import fui.gpu
import plat.web
import plat.webgl

export { web_gpu_enable }

fn gl_open(t: *mut gl.GlApi) -> bool {
    return webgl.webgl_open(t)
}

fn gpu_open(g: *mut gpu.Gpu, a: *mut gl.GlApi) -> bool {
    return gpu.gpu_open(g, a)
}

fn gpu_attach(g: *mut gpu.Gpu, cv: *mut canvas.Canvas) -> bool {
    return gpu.gpu_attach(g, cv)
}

fn gpu_clear(g: *mut gpu.Gpu, col: u32) {
    gpu.gpu_clear(g, col)
}

fn gpu_present(g: *mut gpu.Gpu) {
    gpu.gpu_present(g)
}

fn gpu_begin(g: *mut gpu.Gpu, sw: i32, sh: i32) {
    gpu.gpu_frame_begin(g, sw, sh)
}

fn gl_size(w: usize, h: usize) {
    webgl.webgl_size(w, h)
}

fn web_gpu_enable() {
    web.web_set_gpu_backend(gl_open, gpu_open, gpu_attach, gpu_clear, gpu_present, gpu_begin, gl_size)
}
