// SPDX-License-Identifier: MPL-2.0
// lib/plat/pushio.fi -- notifications through an own relay connection (no Firebase), ONE API on every platform.
//
//     import plat.pushio
//
//   pushio.pio_start("jarvis.fleitec.com", 7781, "HELLO <token> 1")   // starts the connection (Android: foreground service)
//   pushio.pio_running()                                              // true while the connection is up
//   pushio.pio_keep()                                                 // foreground service WITHOUT a relay connection: the program keeps
//                                                                     // the process alive and polls over HTTPS (443) itself
//   pushio.pio_notify("JARVIS", "worker finished")                    // one notification (a new one per call)
//   pushio.pio_stop()
//
// The hello line identifies the device to the relay (docs/ANDROID-APP-API.md of the JARVIS server, section 4); "" = none.
// The Android permission POST_NOTIFICATIONS is asked by the first pio_start. This file is the generic one (no push, every call
// says so); the Android program gets the real one from lib/@android/plat/pushio.fi (platform directory, plat.android.push;
// build with `--push`, tools/android/build.sh).
export { pio_available, pio_start, pio_keep, pio_notify, pio_stop, pio_running }

fn pio_available() -> bool { return false }
fn pio_start(host: str, port: i64, hello: str) -> bool { return false }
fn pio_keep() -> bool { return false }
fn pio_notify(title: str, text: str) -> bool { return false }
fn pio_stop() {}
fn pio_running() -> bool { return false }
