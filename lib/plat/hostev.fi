// SPDX-License-Identifier: MPL-2.0
export {
    HostEvent, blank,
    WE_MOVE, WE_DOWN, WE_UP, WE_LEAVE, WE_WHEEL, WE_KEY,
    WE_TEXT, WE_FETCH, WE_STREAM, WE_STREAM_STATE, WE_TICK, WE_RESIZE,
    WE_EDIT, WE_CANCEL, WE_TAP, WE_PRESS, WE_DIALOG, WE_CLIP,
    MOD_SHIFT, MOD_CTRL, MOD_ALT, MOD_META, MOD_TOUCH, MOD_MIDDLE,
    CURSOR_DEFAULT, CURSOR_POINTER, CURSOR_TEXT,
}

const WE_MOVE: u32 = 1
const WE_DOWN: u32 = 2
const WE_UP: u32 = 3
const WE_LEAVE: u32 = 4
const WE_WHEEL: u32 = 5
const WE_KEY: u32 = 6
const WE_TEXT: u32 = 7
const WE_FETCH: u32 = 8
const WE_STREAM: u32 = 9
const WE_STREAM_STATE: u32 = 10
const WE_TICK: u32 = 11
const WE_RESIZE: u32 = 12
const WE_EDIT: u32 = 13
const WE_CANCEL: u32 = 15
const WE_TAP: u32 = 17
const WE_PRESS: u32 = 18
const WE_DIALOG: u32 = 16
const WE_CLIP: u32 = 14
const MOD_SHIFT: u32 = 1
const MOD_CTRL: u32 = 2
const MOD_ALT: u32 = 4
const MOD_META: u32 = 8
const MOD_TOUCH: u32 = 256
const MOD_MIDDLE: u32 = 512
const CURSOR_DEFAULT: u32 = 0
const CURSOR_POINTER: u32 = 1
const CURSOR_TEXT: u32 = 2

struct HostEvent {
    kind: u32,
    x: f64,
    y: f64,
    dx: f64,
    dy: f64,
    mods: u32,
    id: u32,
    status: u32,
    p: u64,
    n: usize,
    q: u64,
    qn: usize,
    ms: f64,
    cur: usize,
    anc: usize,
    ca: usize,
    cb: usize,
    pid: u32,
    ptype: u32,
    primary: u32,
    pressure: f64,
}

fn blank(kind: u32) -> HostEvent {
    return HostEvent { kind: kind, x: 0.0, y: 0.0, dx: 0.0, dy: 0.0,
        mods: 0 as u32, id: 0 as u32, status: 0 as u32, p: 0, n: 0, q: 0,
        qn: 0, ms: 0.0, cur: 0, anc: 0, ca: 0, cb: 0,
        pid: 1 as u32, ptype: 1 as u32, primary: 1 as u32, pressure: 0.0 }
}
