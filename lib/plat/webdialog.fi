// SPDX-License-Identifier: MPL-2.0
// lib/plat/webdialog.fi -- the system dialogs and notifications for a Firn page in the browser (std.dialog, std.toast).
//
// THREE KINDS of host calls:
//
//   message boxes    SYNCHRONOUS: `alert` / `confirm` of the page. `web_dialog_message` answers with the answer
//                    number (1 OK, 2 Cancel, 3 Yes, 4 No) or 0 when there is no such box (Yes / No / Cancel: the
//                    browser has no three button box).
//   a colour, files  ASYNCHRONOUS, and only inside a user gesture (a key press, a click): an <input type=color> /
//                    <input type=file> is made, clicked, and answers later as web.WE_DIALOG:
//                      q/qn = "color", p/n = "rrggbb", status 1 = chosen, 0 = cancelled
//                      q/qn = the FILE NAME, p/n = the file's content, id = its number from 0, status 1;
//                      then q = "" , status 2 = that was the last one (status 0 = cancelled)
//                    A browser gives NO path of a file, only its name and content.
//   notifications    `web_notify` shows a Notification (permission is asked at the first call, inside a gesture);
//                    a click and a close come back as WE_DIALOG with q = "notify-click" / "notify-close", id = the
//                    notification's number.
//
// WHY A MODULE OF ITS OWN: every `extern fn` is an import the host must answer, or the module does not start.
// Pages that do not import this file run on hosts that do not know it (demos/webdemo/firn.js knows it).

import plat.web

export {
    web_dialog_message, web_dialog_color, web_dialog_file, web_notify, web_notify_close,
}

extern fn firn_web_dialog_message(kind: u32, tp: u32, tn: u32, xp: u32, xn: u32, buttons: u32) -> u32;
extern fn firn_web_dialog_color(tp: u32, tn: u32, rgb: u32) -> u32;
extern fn firn_web_dialog_file(ap: u32, an: u32, multi: u32) -> u32;
extern fn firn_web_notify(tp: u32, tn: u32, bp: u32, bn: u32, ip: u32, inn: u32, tagp: u32, tagn: u32) -> u32;
extern fn firn_web_notify_close(id: u32) -> u32;

// A message box; kind 0..3 (info, question, warning, error), buttons 0..3 (OK, OK/Cancel, Yes/No, Yes/No/Cancel).
// Returns 1 OK, 2 Cancel, 3 Yes, 4 No, 0 = this browser cannot show that box.
fn web_dialog_message(kind: i32, title: str, text: str, buttons: i32) -> i32 {
    return firn_web_dialog_message(kind as u32, title.p as u32, title.n as u32, text.p as u32, text.n as u32, buttons as u32) as i32
}

// Asks for a colour, starting at 0xRRGGBB. false = this browser has no colour input. The answer is WE_DIALOG "color".
fn web_dialog_color(title: str, rgb: u32) -> bool {
    return firn_web_dialog_color(title.p as u32, title.n as u32, rgb) != 0 as u32
}

// Asks for files. `accept` is the input's accept list (".png,.jpg" or "image/*"; "" = every file). The answers are
// WE_DIALOG, one per file.
fn web_dialog_file(accept: str, multiple: bool) -> bool {
    var m: u32 = 0 as u32
    if multiple {
        m = 1 as u32
    }
    return firn_web_dialog_file(accept.p as u32, accept.n as u32, m) != 0 as u32
}

// Shows a notification. Returns its number (>= 1), 0 = not shown (no Notification API, permission refused or
// still being asked: ask again after the answer).
fn web_notify(title: str, body: str, icon: str, tag: str) -> u32 {
    return firn_web_notify(title.p as u32, title.n as u32, body.p as u32, body.n as u32, icon.p as u32, icon.n as u32,
        tag.p as u32, tag.n as u32)
}

fn web_notify_close(id: u32) -> bool {
    return firn_web_notify_close(id) != 0 as u32
}
