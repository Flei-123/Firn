// SPDX-License-Identifier: MPL-2.0
// lib/plat/fuitext.fi -- plat.fuitext: TEXT INPUT / IME GLUE between a lib/window window and a fUi text field (r433b / r444).
//
//     fuitext.ft_open(f)                         // after window_open; false = no input method, the old EV_CHAR path stays
//     fuitext.ft_set_sink(ud, pre, commit, end, del)
//     // from the window's input hook (lib/@linux/fui/apphost.fi on_input):
//     fuitext.ft_event(kind, a, state, x, y)     // EV_RAWKEY / EV_RAWKEY_UP / EV_FOCUS / EV_IME
//     if fuitext.ft_swallow(kind, a, state) { return true }    // EV_KEY / EV_CHAR the input method already handled
//     // once per loop turn:
//     fuitext.ft_pump()                          // events the IME sent on its own (XIM commit from ibus ...)
//     fuitext.ft_spot(x, y, h); fuitext.ft_surround(p, n, caret, anchor)
//
// WHAT RUNS WHERE. Linux: every EV_RAWKEY goes into textsys.sys_key (XIM through a second Xlib connection, Compose engine as the
// fallback for dead keys); the text a key makes (and every pre-edit change) comes back as textcore events (TE_*), which `drain` turns
// into the SINK calls: pre-edit text (UTF-8 + caret octet) -> editor_ime_preedit, commit -> editor_ime_commit, cancel ->
// ime_cancel, delete-surrounding -> editor_delete_surrounding. Windows: the window delivers EV_IME (WM_IME_COMPOSITION ...), which
// textsys.windows.fi reads from the IMM32 context; plain characters stay WM_CHAR / EV_CHAR. Android / web do not use this file
// (raw_input answers false there): Android's InputConnection (lib/android/inputmethod.fi) maps onto the same Text API, see docs/INPUT.md.
//
// DOUBLE TEXT. The window still sends EV_CHAR / EV_KEY after an EV_RAWKEY. ft_swallow drops the EV_KEY / EV_CHAR of a key (1) that the
// input method ate (sys_key = true: dead key, Compose, a candidate selection) or (2) whose text the input method already committed
// into a field (the sink answered "taken"). Anything else (no focused field, a plain key whose lookup gave no text, Ctrl / Alt
// shortcuts, which are never replayed into the input method) goes the old way, so a program keeps its character hooks and shortcuts.
//
// Singleton (one window): the state is on the heap behind one static pointer; a function pointer in Firn carries no state.
import std.rt
import window.window
import input.textcore
import input.textsys

export {
    ft_open, ft_close, ft_on, ft_set_sink, ft_event, ft_swallow, ft_pump, ft_spot, ft_surround, ft_focus, ft_stats,
    ft_feed_key, ft_text,
}

struct Glue {
    t: textcore.Text,
    s: textsys.TextSys,
    on: bool,
    win_ime: bool, // Windows: EV_IME is delivered
    hwnd: u64,
    eat: bool, // the last key press was eaten by the input method
    taken: bool, // ... or its text went into a field
    pend_end: bool, // a pre-edit cancel waits to see whether a commit follows at once
    focus: bool,
    ud: u64,
    f_pre: fn(u64, u64, usize, usize) -> bool,
    f_commit: fn(u64, u64, usize) -> bool,
    f_end: fn(u64),
    f_del: fn(u64, usize, usize) -> bool,
    n_pre: u64,
    n_commit: u64,
    n_end: u64,
    n_del: u64,
    buf: [u8; 2048],
}

static mut G: u64 = 0

fn pre_none(ud: u64, p: u64, n: usize, caret: usize) -> bool { return false }
fn commit_none(ud: u64, p: u64, n: usize) -> bool { return false }
fn end_none(ud: u64) {}
fn del_none(ud: u64, before: usize, after: usize) -> bool { return false }

fn glue_new() -> Glue {
    return Glue { t: textcore.text_new(), s: textsys.sys_new(), on: false, win_ime: false, hwnd: 0, eat: false, taken: false,
        pend_end: false, focus: true, ud: 0, f_pre: pre_none, f_commit: commit_none, f_end: end_none, f_del: del_none,
        n_pre: 0, n_commit: 0, n_end: 0, n_del: 0, buf: [0 as u8; 2048] }
}

fn glue_size() -> usize {
    var probe: [Glue; 2] = [glue_new(); 2]
    return ((&probe[1]) as usize) - ((&probe[0]) as usize)
}

fn gp() -> *mut Glue { return G as *mut Glue }

// The state of the singleton for the sink-less tests: the Text (pure core) is reachable, nothing else.
fn ft_text() -> *mut textcore.Text {
    if G == 0 { return 0 as u64 as *mut textcore.Text }
    return &(*gp()).t
}

// Start text input for `f`: raw keys (and on Windows the IME messages) are switched on, then the platform input method is opened.
// False = not possible here (Android / Osum: no raw keys; no libX11 / imm32 / XIM): the window keeps delivering EV_CHAR as before.
// `#[allow_escape]`: the Text's address goes to Xlib callbacks.
#[allow_escape]
fn ft_open(f: *mut window.Window) -> bool {
    if G != 0 {
        return (*gp()).on
    }
    if !window.raw_input(f, true) {
        return false
    }
    let p: u64 = rt.heap_alloc(glue_size())
    if p == 0 {
        window.raw_input(f, false)
        return false
    }
    *(p as *mut Glue) = glue_new()
    G = p
    let g: *mut Glue = gp()
    if !textsys.sys_open(&(*g).s, &(*g).t) {
        window.raw_input(f, false)
        G = 0
        rt.heap_free(p, glue_size())
        return false
    }
    (*g).hwnd = window.ime_handle(f)
    if (*g).hwnd != 0 {
        textsys.sys_attach(&(*g).s, (*g).hwnd)
        (*g).win_ime = window.ime_events(f, true)
    }
    (*g).on = true
    return true
}

fn ft_close() {
    if G == 0 { return }
    let g: *mut Glue = gp()
    textsys.sys_close(&(*g).s)
    (*g).on = false
}

fn ft_on() -> bool {
    if G == 0 { return false }
    return (*gp()).on
}

// The sink: where pre-edit text, commits, cancels and delete-surrounding requests go. Each answers true when a text field took it.
//   pre(ud, utf8, n, caret_octet)   commit(ud, utf8, n)   end(ud)   del(ud, octets_before, octets_after)
fn ft_set_sink(ud: u64, pre: fn(u64, u64, usize, usize) -> bool, commit: fn(u64, u64, usize) -> bool, end: fn(u64),
    del: fn(u64, usize, usize) -> bool) {
    if G == 0 { return }
    let g: *mut Glue = gp()
    (*g).ud = ud
    (*g).f_pre = pre
    (*g).f_commit = commit
    (*g).f_end = end
    (*g).f_del = del
}

// counters for tests / diagnostics: pre-edit calls, commits taken, cancels, deletes
fn ft_stats(which: u32) -> u64 {
    if G == 0 { return 0 }
    let g: *mut Glue = gp()
    if which == 0 as u32 { return (*g).n_pre }
    if which == 1 as u32 { return (*g).n_commit }
    if which == 2 as u32 { return (*g).n_end }
    return (*g).n_del
}

fn flush_end(g: *mut Glue) {
    if (*g).pend_end {
        (*g).pend_end = false
        (*g).n_end = (*g).n_end + 1 as u64
        let e: fn(u64) = (*g).f_end
        e((*g).ud)
    }
}

// Turn the queued textcore events into sink calls. Returns how many commits a field took.
fn drain(g: *mut Glue) -> usize {
    var took: usize = 0
    var ev: textcore.TextEvent = textcore.TextEvent { kind: 0 as u32, n: 0, cp: [0 as u32; 32] }
    var k: u32 = textcore.text_event_next(&(*g).t, &ev)
    while k != textcore.TE_NONE {
        if k == textcore.TE_PREEDIT_BEGIN {
            // nothing: the first TE_PREEDIT carries the text
        } else if k == textcore.TE_PREEDIT {
            (*g).pend_end = false
            let n: usize = textcore.text_preedit_utf8(&(*g).t, (&(*g).buf[0]) as u64, 2048)
            let c: usize = textcore.text_preedit_caret_bytes(&(*g).t)
            (*g).n_pre = (*g).n_pre + 1 as u64
            let f: fn(u64, u64, usize, usize) -> bool = (*g).f_pre
            let ok: bool = f((*g).ud, (&(*g).buf[0]) as u64, n, c)
        } else if k == textcore.TE_PREEDIT_END {
            // a cancel followed at once by a commit is "the pre-edit text became final": do not cancel, the commit replaces it
            (*g).pend_end = true
        } else if k == textcore.TE_COMMIT {
            var n2: usize = 0
            var i: usize = 0
            while i < ev.n {
                n2 = n2 + textcore.utf8_encode(ev.cp[i], ((&(*g).buf[0]) as u64) + n2 as u64)
                i = i + 1
            }
            (*g).pend_end = false
            let f2: fn(u64, u64, usize) -> bool = (*g).f_commit
            if f2((*g).ud, (&(*g).buf[0]) as u64, n2) {
                (*g).n_commit = (*g).n_commit + 1 as u64
                took = took + 1
            }
        } else if k == textcore.TE_DELETE_SURROUNDING {
            flush_end(g)
            let f3: fn(u64, usize, usize) -> bool = (*g).f_del
            if f3((*g).ud, ev.cp[0] as usize, ev.cp[1] as usize) {
                (*g).n_del = (*g).n_del + 1 as u64
            }
        }
        k = textcore.text_event_next(&(*g).t, &ev)
    }
    flush_end(g)
    return took
}

// ONE KEY into the input method (the EV_RAWKEY / EV_RAWKEY_UP of the window; scancode = Linux scancode). Returns true if the
// input method ate it. Ctrl / Alt / Super combinations are never replayed (they are shortcuts, not text) and cancel a waiting Compose.
fn ft_feed_key(down: bool, scancode: u32, state: u32, time_ms: u32) -> bool {
    if G == 0 { return false }
    let g: *mut Glue = gp()
    if !(*g).on { return false }
    if down {
        (*g).eat = false
        (*g).taken = false
        if (state & 76 as u32) != 0 as u32 {
            // Control 4, Alt (Mod1) 8, Super (Mod4) 64
            if textcore.text_composing(&(*g).t) {
                textcore.text_preedit_cancel(&(*g).t)
                drain(g)
            }
            return false
        }
    }
    let ate: bool = textsys.sys_key(&(*g).s, &(*g).t, down, scancode + 8 as u32, state, time_ms)
    let took: usize = drain(g)
    if down {
        (*g).eat = ate
        (*g).taken = took > 0
    }
    return ate
}

// The input hook calls this for the window events of text input; ignored when ft_open did not succeed.
fn ft_event(kind: u32, a: u32, state: u32, x: f64, y: f64) {
    if G == 0 { return }
    let g: *mut Glue = gp()
    if !(*g).on { return }
    if kind == window.EV_RAWKEY {
        let ate: bool = ft_feed_key(true, a, state, y as u32)
    } else if kind == window.EV_RAWKEY_UP {
        let ate2: bool = ft_feed_key(false, a, state, y as u32)
    } else if kind == window.EV_FOCUS {
        ft_focus(a != 0 as u32)
    } else if kind == window.EV_IME {
        if (*g).win_ime {
            let msg: u64 = a as u64
            let lp: u64 = x as u64
            if msg != 269 as u64 {
                // WM_IME_STARTCOMPOSITION needs nothing; COMPOSITION / ENDCOMPOSITION are read from the IMM context
                let h: bool = textsys.sys_ime_message(&(*g).s, &(*g).t, (*g).hwnd, msg, lp)
            }
            drain(g)
        }
    }
}

// EV_KEY / EV_CHAR of a key press that was already seen as EV_RAWKEY: true = drop it (the input method has it).
fn ft_swallow(kind: u32, a: u32, state: u32) -> bool {
    if G == 0 { return false }
    let g: *mut Glue = gp()
    if !(*g).on { return false }
    if kind == window.EV_KEY {
        let e: bool = (*g).eat
        (*g).eat = false
        return e
    }
    if kind == window.EV_CHAR {
        let r: bool = (*g).eat || (*g).taken
        (*g).eat = false
        (*g).taken = false
        return r
    }
    return false
}

// Events the input method sent on its own (Linux: a commit from ibus arrives on the second connection).
fn ft_pump() {
    if G == 0 { return }
    let g: *mut Glue = gp()
    if !(*g).on { return }
    textsys.sys_pump(&(*g).s, &(*g).t)
    drain(g)
}

// The window got / lost the keyboard focus (EV_FOCUS) or the text field did: an inactive Text drops its pre-edit text.
fn ft_focus(on: bool) {
    if G == 0 { return }
    let g: *mut Glue = gp()
    (*g).focus = on
    textsys.sys_focus(&(*g).s, &(*g).t, on)
    drain(g)
}

// The caret of the focused field in window pixels (x, y = top left of the caret, h = line height) -> the IME's candidate window.
fn ft_spot(x: f64, y: f64, h: f64) {
    if G == 0 { return }
    let g: *mut Glue = gp()
    if !(*g).on { return }
    textcore.text_set_spot(&(*g).t, x as i32, y as i32, 1 as i32, h as i32)
    textsys.sys_spot(&(*g).s, &(*g).t)
}

// What stands around the caret (the field text WITHOUT its pre-edit text, UTF-8, octet offsets): for IMs that ask
// (Android getTextBeforeCursor, Wayland surrounding_text) and for text_delete_surrounding. Cheap: copies at most SURMAX octets.
fn ft_surround(p: u64, n: usize, caret: usize, anchor: usize) {
    if G == 0 { return }
    let g: *mut Glue = gp()
    textcore.text_set_surrounding(&(*g).t, p, n, caret, anchor)
}
