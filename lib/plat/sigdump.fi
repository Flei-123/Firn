// SPDX-License-Identifier: MPL-2.0
// lib/plat/sigdump.fi -- a fatal signal (SIGSEGV, SIGBUS, SIGILL, SIGABRT, SIGFPE, SIGTRAP, SIGSYS) written to a file by the dying
// process; ONE API on every platform. This file is the generic one (no handler installed); the Android program gets the real one from
// lib/@android/plat/sigdump.fi.
//
//     sigdump.sd_install(path)    // opens `path` (append), installs the handlers; false = not available / failed
//     sigdump.sd_available()
export { sd_install, sd_available }

fn sd_available() -> bool { return false }
fn sd_install(path: str) -> bool { return false }
