import std.rt

export {
    Cur, cur_new, cur_next_line, cur_skip_blanks, cur_at_eol, cur_word, cur_rest,
    cur_num, cur_int, cur_cp, str_eq, parse_num,
    push_num, push_int, push_cp, push_text, push_nl,
}

struct Cur {
    p: u64,
    n: usize,
    i: usize,
    line: i64,
}

fn cur_new(p: u64, n: usize) -> Cur {
    return Cur { p: p, n: n, i: 0, line: 0 }
}

fn is_blank(c: u8) -> bool {
    return c == 32 as u8 || c == 9 as u8 || c == 13 as u8
}

fn is_digit(c: u8) -> bool {
    return c >= 48 as u8 && c <= 57 as u8
}

fn str_eq(a: str, b: str) -> bool {
    return a.n == b.n && rt.mem_eq(a.p as u64, b.p as u64, a.n)
}

fn cur_next_line(c: *mut Cur) -> bool {
    if (*c).i >= (*c).n {
        return false
    }
    if (*c).line > 0 {
        while (*c).i < (*c).n && rt.ld8((*c).p, (*c).i) != 10 as u8 {
            (*c).i = (*c).i + 1
        }
        if (*c).i < (*c).n {
            (*c).i = (*c).i + 1
        }
    }
    (*c).line = (*c).line + 1
    return (*c).i < (*c).n
}

fn cur_skip_blanks(c: *mut Cur) {
    while (*c).i < (*c).n && is_blank(rt.ld8((*c).p, (*c).i)) {
        (*c).i = (*c).i + 1
    }
}

fn cur_at_eol(c: *mut Cur) -> bool {
    cur_skip_blanks(c)
    return (*c).i >= (*c).n || rt.ld8((*c).p, (*c).i) == 10 as u8
}

fn cur_word(c: *mut Cur) -> str {
    cur_skip_blanks(c)
    let start: usize = (*c).i
    while (*c).i < (*c).n {
        let ch: u8 = rt.ld8((*c).p, (*c).i)
        if is_blank(ch) || ch == 10 as u8 {
            break
        }
        (*c).i = (*c).i + 1
    }
    return str { p: ((*c).p + start as u64) as *mut u8, n: (*c).i - start }
}

fn cur_rest(c: *mut Cur) -> str {
    cur_skip_blanks(c)
    let start: usize = (*c).i
    var end: usize = start
    while (*c).i < (*c).n && rt.ld8((*c).p, (*c).i) != 10 as u8 {
        if !is_blank(rt.ld8((*c).p, (*c).i)) {
            end = (*c).i + 1
        }
        (*c).i = (*c).i + 1
    }
    return str { p: ((*c).p + start as u64) as *mut u8, n: end - start }
}

fn parse_num(w: str, out: *mut f64) -> bool {
    var i: usize = 0
    var neg: bool = false
    if w.n > 0 && rt.ld8(w.p as u64, 0) == 45 as u8 {
        neg = true
        i = 1
    }
    var digits: usize = 0
    var whole: f64 = 0.0
    while i < w.n && is_digit(rt.ld8(w.p as u64, i)) {
        whole = whole * 10.0 + ((rt.ld8(w.p as u64, i) - 48 as u8) as f64)
        digits = digits + 1
        i = i + 1
    }
    var frac: f64 = 0.0
    var scale: f64 = 1.0
    if i < w.n && rt.ld8(w.p as u64, i) == 46 as u8 {
        i = i + 1
        while i < w.n && is_digit(rt.ld8(w.p as u64, i)) {
            frac = frac * 10.0 + ((rt.ld8(w.p as u64, i) - 48 as u8) as f64)
            scale = scale * 10.0
            digits = digits + 1
            i = i + 1
        }
    }
    if digits == 0 || i != w.n {
        return false
    }
    var v: f64 = whole + frac / scale
    if neg {
        v = 0.0 - v
    }
    *out = v
    return true
}

fn cur_num(c: *mut Cur, out: *mut f64) -> bool {
    return parse_num(cur_word(c), out)
}

fn cur_int(c: *mut Cur, out: *mut i64) -> bool {
    var v: f64 = 0.0
    if !cur_num(c, &v) {
        return false
    }
    if v < 0.0 {
        *out = (v - 0.5) as i64
    } else {
        *out = (v + 0.5) as i64
    }
    return true
}

fn hex_digit(c: u8) -> i64 {
    if c >= 48 as u8 && c <= 57 as u8 {
        return (c - 48 as u8) as i64
    }
    if c >= 65 as u8 && c <= 70 as u8 {
        return (c - 55 as u8) as i64
    }
    if c >= 97 as u8 && c <= 102 as u8 {
        return (c - 87 as u8) as i64
    }
    return -1
}

fn cur_cp(c: *mut Cur, out: *mut u32) -> bool {
    let w: str = cur_word(c)
    if w.n < 6 || w.n > 8 {
        return false
    }
    if rt.ld8(w.p as u64, 0) != 85 as u8 || rt.ld8(w.p as u64, 1) != 43 as u8 {
        return false
    }
    var v: u32 = 0
    var i: usize = 2
    while i < w.n {
        let d: i64 = hex_digit(rt.ld8(w.p as u64, i))
        if d < 0 {
            return false
        }
        v = v * 16 + d as u32
        i = i + 1
    }
    if v > 1114111 as u32 {
        return false
    }
    *out = v
    return true
}

fn push_text(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn push_nl(b: *mut rt.Buf) {
    rt.buf_push(b, 10 as u8)
}

fn push_int(b: *mut rt.Buf, v: i64) {
    rt.buf_push_dec_i64(b, v)
}

fn push_cp(b: *mut rt.Buf, cp: u32) {
    push_text(b, "U+")
    var digits: usize = 4
    if cp >= 1048576 as u32 {
        digits = 6
    } else if cp >= 65536 as u32 {
        digits = 5
    }
    var shift: i64 = (digits as i64 - 1) * 4
    while shift >= 0 {
        let d: u32 = (cp >> (shift as u32)) & 15 as u32
        if d < 10 as u32 {
            rt.buf_push(b, (48 as u32 + d) as u8)
        } else {
            rt.buf_push(b, (55 as u32 + d) as u8)
        }
        shift = shift - 4
    }
}

fn push_num(b: *mut rt.Buf, x: f64) {
    var scaled: f64 = x * 1000.0
    if scaled < 0.0 {
        scaled = scaled - 0.5
    } else {
        scaled = scaled + 0.5
    }
    var m: i64 = scaled as i64
    if m < 0 {
        rt.buf_push(b, 45 as u8)
        m = 0 - m
    }
    rt.buf_push_dec_u64(b, (m / 1000) as u64)
    var frac: i64 = m % 1000
    if frac == 0 {
        return
    }
    rt.buf_push(b, 46 as u8)
    var width: i64 = 3
    while frac % 10 == 0 {
        frac = frac / 10
        width = width - 1
    }
    var div: i64 = 1
    var k: i64 = 1
    while k < width {
        div = div * 10
        k = k + 1
    }
    while div > 0 {
        rt.buf_push(b, (48 + (frac / div) % 10) as u8)
        div = div / 10
    }
}
