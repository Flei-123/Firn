import std.rt
import std.vec
import svg.path

export {
    Ref, Keep, Glyph, Kern, Font,
    font_new, font_free,
    glyph_new, glyph_free, glyph_clear,
    font_glyph_count, font_glyph_at, font_find, font_find_index, font_add_glyph, font_remove_glyph,
    font_kern_count, font_kern_at, font_kern_get, font_kern_set,
    glyph_add_ref, glyph_ref_count, glyph_ref_at,
    glyph_add_keep, glyph_keep_count, glyph_keep_at, glyph_keep_clear,
    set_text, text_str,
}

struct Ref {
    cp: u32,
    dx: f64,
    dy: f64,
}

struct Keep {
    x: f64,
    y: f64,
}

struct Glyph {
    cp: u32,
    advance: f64,
    path: path.Path,
    refs: vec.Vec[Ref],
    keeps: vec.Vec[Keep],
}

struct Kern {
    left: u32,
    right: u32,
    value: i64,
}

struct Font {
    family: rt.Buf,
    style: rt.Buf,
    license: rt.Buf,
    copyright: rt.Buf,
    version: rt.Buf,
    upem: i64,
    ascender: i64,
    descender: i64,
    xheight: i64,
    capheight: i64,
    linegap: i64,
    glyphs: vec.Vec[Glyph],
    kerns: vec.Vec[Kern],
}

fn font_new() -> Font {
    return Font {
        family: rt.buf_new(),
        style: rt.buf_new(),
        license: rt.buf_new(),
        copyright: rt.buf_new(),
        version: rt.buf_new(),
        upem: 1000,
        ascender: 800,
        descender: -200,
        xheight: 500,
        capheight: 700,
        linegap: 0,
        glyphs: vec.vec_new[Glyph](),
        kerns: vec.vec_new[Kern](),
    }
}

fn glyph_new(cp: u32) -> Glyph {
    return Glyph {
        cp: cp,
        advance: 0.0,
        path: path.path_new(),
        refs: vec.vec_new[Ref](),
        keeps: vec.vec_new[Keep](),
    }
}

fn glyph_free(g: *mut Glyph) {
    path.path_free(&(*g).path)
    vec.vec_free[Ref](&(*g).refs)
    vec.vec_free[Keep](&(*g).keeps)
}

fn glyph_clear(g: *mut Glyph) {
    path.path_empty(&(*g).path)
    vec.vec_clear[Ref](&(*g).refs)
    vec.vec_clear[Keep](&(*g).keeps)
}

fn font_free(f: *mut Font) {
    var i: usize = 0
    let n: usize = vec.vec_len[Glyph](&(*f).glyphs)
    while i < n {
        glyph_free(vec.vec_elem_ptr[Glyph](&(*f).glyphs, i))
        i = i + 1
    }
    vec.vec_free[Glyph](&(*f).glyphs)
    vec.vec_free[Kern](&(*f).kerns)
    rt.buf_free(&(*f).family)
    rt.buf_free(&(*f).style)
    rt.buf_free(&(*f).license)
    rt.buf_free(&(*f).copyright)
    rt.buf_free(&(*f).version)
}

fn set_text(b: *mut rt.Buf, s: str) {
    rt.buf_clear(b)
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn text_str(b: *mut rt.Buf) -> str {
    return str { p: rt.buf_data(b), n: rt.buf_len(b) }
}

fn font_glyph_count(f: *mut Font) -> usize {
    return vec.vec_len[Glyph](&(*f).glyphs)
}

fn font_glyph_at(f: *mut Font, i: usize) -> *mut Glyph {
    return vec.vec_elem_ptr[Glyph](&(*f).glyphs, i)
}

fn font_find_index(f: *mut Font, cp: u32) -> i64 {
    var lo: i64 = 0
    var hi: i64 = font_glyph_count(f) as i64 - 1
    while lo <= hi {
        let mid: i64 = (lo + hi) / 2
        let c: u32 = (*font_glyph_at(f, mid as usize)).cp
        if c == cp {
            return mid
        }
        if c < cp {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    return -1
}

fn font_find(f: *mut Font, cp: u32) -> *mut Glyph {
    let i: i64 = font_find_index(f, cp)
    if i < 0 {
        return 0 as *mut Glyph
    }
    return font_glyph_at(f, i as usize)
}

fn font_add_glyph(f: *mut Font, g: Glyph) -> *mut Glyph {
    let existing: i64 = font_find_index(f, g.cp)
    if existing >= 0 {
        let slot: *mut Glyph = font_glyph_at(f, existing as usize)
        glyph_free(slot)
        *slot = g
        return slot
    }
    var at: usize = 0
    let n: usize = font_glyph_count(f)
    while at < n && (*font_glyph_at(f, at)).cp < g.cp {
        at = at + 1
    }
    vec.vec_insert[Glyph](&(*f).glyphs, at, g)
    return font_glyph_at(f, at)
}

fn font_remove_glyph(f: *mut Font, cp: u32) -> bool {
    let i: i64 = font_find_index(f, cp)
    if i < 0 {
        return false
    }
    glyph_free(font_glyph_at(f, i as usize))
    var j: usize = i as usize
    let n: usize = font_glyph_count(f)
    while j + 1 < n {
        *font_glyph_at(f, j) = *font_glyph_at(f, j + 1)
        j = j + 1
    }
    vec.vec_shorten[Glyph](&(*f).glyphs, n - 1)
    return true
}

fn glyph_add_ref(g: *mut Glyph, cp: u32, dx: f64, dy: f64) {
    vec.vec_push[Ref](&(*g).refs, Ref { cp: cp, dx: dx, dy: dy })
}

fn glyph_ref_count(g: *mut Glyph) -> usize {
    return vec.vec_len[Ref](&(*g).refs)
}

fn glyph_ref_at(g: *mut Glyph, i: usize) -> *mut Ref {
    return vec.vec_elem_ptr[Ref](&(*g).refs, i)
}

fn font_kern_count(f: *mut Font) -> usize {
    return vec.vec_len[Kern](&(*f).kerns)
}

fn font_kern_at(f: *mut Font, i: usize) -> *mut Kern {
    return vec.vec_elem_ptr[Kern](&(*f).kerns, i)
}

fn kern_before(k: *mut Kern, left: u32, right: u32) -> bool {
    if (*k).left != left {
        return (*k).left < left
    }
    return (*k).right < right
}

fn font_kern_get(f: *mut Font, left: u32, right: u32) -> i64 {
    var i: usize = 0
    let n: usize = font_kern_count(f)
    while i < n {
        let k: *mut Kern = font_kern_at(f, i)
        if (*k).left == left && (*k).right == right {
            return (*k).value
        }
        i = i + 1
    }
    return 0
}

fn font_kern_set(f: *mut Font, left: u32, right: u32, value: i64) {
    var i: usize = 0
    let n: usize = font_kern_count(f)
    while i < n && kern_before(font_kern_at(f, i), left, right) {
        i = i + 1
    }
    if i < n {
        let k: *mut Kern = font_kern_at(f, i)
        if (*k).left == left && (*k).right == right {
            (*k).value = value
            return
        }
    }
    vec.vec_insert[Kern](&(*f).kerns, i, Kern { left: left, right: right, value: value })
}

fn glyph_add_keep(g: *mut Glyph, x: f64, y: f64) {
    vec.vec_push[Keep](&(*g).keeps, Keep { x: x, y: y })
}

fn glyph_keep_count(g: *mut Glyph) -> usize {
    return vec.vec_len[Keep](&(*g).keeps)
}

fn glyph_keep_at(g: *mut Glyph, i: usize) -> *mut Keep {
    return vec.vec_elem_ptr[Keep](&(*g).keeps, i)
}

fn glyph_keep_clear(g: *mut Glyph) {
    vec.vec_clear[Keep](&(*g).keeps)
}
