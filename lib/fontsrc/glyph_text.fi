import std.rt
import svg.path
import fontsrc.model
import fontsrc.cursor

export { glyph_parse, glyph_write }

fn glyph_parse(p: u64, n: usize, g: *mut model.Glyph) -> i64 {
    var c: cursor.Cur = cursor.cur_new(p, n)
    var seen_header: bool = false
    var open: bool = false
    var x: f64 = 0.0
    var y: f64 = 0.0
    var x2: f64 = 0.0
    var y2: f64 = 0.0
    var x3: f64 = 0.0
    var y3: f64 = 0.0
    while cursor.cur_next_line(&c) {
        if cursor.cur_at_eol(&c) {
            continue
        }
        let w: str = cursor.cur_word(&c)
        if w.n > 0 && rt.ld8(w.p as u64, 0) == 35 as u8 {
            continue
        }
        if cursor.str_eq(w, "glyph") {
            var cp: u32 = 0
            if seen_header || !cursor.cur_cp(&c, &cp) {
                return c.line
            }
            (*g).cp = cp
            seen_header = true
        } else if !seen_header {
            return c.line
        } else if cursor.str_eq(w, "advance") {
            if !cursor.cur_num(&c, &x) {
                return c.line
            }
            (*g).advance = x
        } else if cursor.str_eq(w, "M") {
            if open || !cursor.cur_num(&c, &x) || !cursor.cur_num(&c, &y) {
                return c.line
            }
            path.path_move(&(*g).path, x, y)
            open = true
        } else if cursor.str_eq(w, "L") {
            if !open || !cursor.cur_num(&c, &x) || !cursor.cur_num(&c, &y) {
                return c.line
            }
            path.path_line(&(*g).path, x, y)
        } else if cursor.str_eq(w, "Q") {
            if !open || !cursor.cur_num(&c, &x) || !cursor.cur_num(&c, &y) {
                return c.line
            }
            if !cursor.cur_num(&c, &x2) || !cursor.cur_num(&c, &y2) {
                return c.line
            }
            path.path_quad(&(*g).path, x, y, x2, y2)
        } else if cursor.str_eq(w, "C") {
            if !open || !cursor.cur_num(&c, &x) || !cursor.cur_num(&c, &y) {
                return c.line
            }
            if !cursor.cur_num(&c, &x2) || !cursor.cur_num(&c, &y2) {
                return c.line
            }
            if !cursor.cur_num(&c, &x3) || !cursor.cur_num(&c, &y3) {
                return c.line
            }
            path.path_cubic(&(*g).path, x, y, x2, y2, x3, y3)
        } else if cursor.str_eq(w, "Z") {
            if !open {
                return c.line
            }
            path.path_too(&(*g).path)
            open = false
        } else if cursor.str_eq(w, "ref") {
            var rcp: u32 = 0
            if !cursor.cur_cp(&c, &rcp) || !cursor.cur_num(&c, &x) || !cursor.cur_num(&c, &y) {
                return c.line
            }
            model.glyph_add_ref(g, rcp, x, y)
        } else {
            return c.line
        }
    }
    if !seen_header || open {
        return c.line + 1
    }
    return 0
}

fn push_point(out: *mut rt.Buf, pt: *mut path.Path, i: usize) {
    rt.buf_push(out, 32 as u8)
    cursor.push_num(out, path.path_px(pt, i))
    rt.buf_push(out, 32 as u8)
    cursor.push_num(out, path.path_py(pt, i))
}

fn push_command(out: *mut rt.Buf, letter: u8, pt: *mut path.Path, first: usize, count: usize) {
    rt.buf_push(out, letter)
    var k: usize = 0
    while k < count {
        push_point(out, pt, first + k)
        k = k + 1
    }
    cursor.push_nl(out)
}

fn glyph_write(g: *mut model.Glyph, out: *mut rt.Buf) {
    cursor.push_text(out, "glyph ")
    cursor.push_cp(out, (*g).cp)
    cursor.push_nl(out)
    cursor.push_text(out, "advance ")
    cursor.push_num(out, (*g).advance)
    cursor.push_nl(out)
    let pt: *mut path.Path = &(*g).path
    let verbs: usize = path.path_verbs(pt)
    var v: usize = 0
    var at: usize = 0
    var open: bool = false
    while v < verbs {
        let kind: u32 = path.path_verb(pt, v)
        if kind == path.V_ZUG {
            if open {
                cursor.push_text(out, "Z\n")
            }
            push_command(out, 77 as u8, pt, at, 1)
            at = at + 1
            open = true
        } else if kind == path.V_LINE {
            push_command(out, 76 as u8, pt, at, 1)
            at = at + 1
        } else if kind == path.V_QUAD {
            push_command(out, 81 as u8, pt, at, 2)
            at = at + 2
        } else if kind == path.V_CUBIC {
            push_command(out, 67 as u8, pt, at, 3)
            at = at + 3
        } else {
            cursor.push_text(out, "Z\n")
            open = false
        }
        v = v + 1
    }
    if open {
        cursor.push_text(out, "Z\n")
    }
    var r: usize = 0
    let refs: usize = model.glyph_ref_count(g)
    while r < refs {
        let ref: *mut model.Ref = model.glyph_ref_at(g, r)
        cursor.push_text(out, "ref ")
        cursor.push_cp(out, (*ref).cp)
        rt.buf_push(out, 32 as u8)
        cursor.push_num(out, (*ref).dx)
        rt.buf_push(out, 32 as u8)
        cursor.push_num(out, (*ref).dy)
        cursor.push_nl(out)
        r = r + 1
    }
}
