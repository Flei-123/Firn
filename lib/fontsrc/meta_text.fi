import std.rt
import fontsrc.model
import fontsrc.cursor

export { meta_parse, meta_write, kerning_parse, kerning_write }

fn assign_int(c: *mut cursor.Cur, slot: *mut i64) -> bool {
    var v: i64 = 0
    if !cursor.cur_int(c, &v) {
        return false
    }
    *slot = v
    return true
}

fn assign_text(c: *mut cursor.Cur, slot: *mut rt.Buf) {
    model.set_text(slot, cursor.cur_rest(c))
}

fn meta_parse(p: u64, n: usize, f: *mut model.Font) -> i64 {
    var c: cursor.Cur = cursor.cur_new(p, n)
    var seen_header: bool = false
    while cursor.cur_next_line(&c) {
        if cursor.cur_at_eol(&c) {
            continue
        }
        let key: str = cursor.cur_word(&c)
        if key.n > 0 && rt.ld8(key.p as u64, 0) == 35 as u8 {
            continue
        }
        if !seen_header {
            var version: i64 = 0
            if !cursor.str_eq(key, "firnfont") || !assign_int(&c, &version) || version != 1 {
                return c.line
            }
            seen_header = true
        } else if cursor.str_eq(key, "family") {
            assign_text(&c, &(*f).family)
        } else if cursor.str_eq(key, "style") {
            assign_text(&c, &(*f).style)
        } else if cursor.str_eq(key, "license") {
            assign_text(&c, &(*f).license)
        } else if cursor.str_eq(key, "copyright") {
            assign_text(&c, &(*f).copyright)
        } else if cursor.str_eq(key, "version") {
            assign_text(&c, &(*f).version)
        } else if cursor.str_eq(key, "upem") {
            if !assign_int(&c, &(*f).upem) || (*f).upem <= 0 {
                return c.line
            }
        } else if cursor.str_eq(key, "ascender") {
            if !assign_int(&c, &(*f).ascender) {
                return c.line
            }
        } else if cursor.str_eq(key, "descender") {
            if !assign_int(&c, &(*f).descender) {
                return c.line
            }
        } else if cursor.str_eq(key, "xheight") {
            if !assign_int(&c, &(*f).xheight) {
                return c.line
            }
        } else if cursor.str_eq(key, "capheight") {
            if !assign_int(&c, &(*f).capheight) {
                return c.line
            }
        } else if cursor.str_eq(key, "linegap") {
            if !assign_int(&c, &(*f).linegap) {
                return c.line
            }
        } else {
            return c.line
        }
    }
    if !seen_header {
        return 1
    }
    return 0
}

fn push_text_field(out: *mut rt.Buf, key: str, value: *mut rt.Buf) {
    cursor.push_text(out, key)
    if rt.buf_len(value) > 0 {
        rt.buf_push(out, 32 as u8)
        cursor.push_text(out, model.text_str(value))
    }
    cursor.push_nl(out)
}

fn push_int_field(out: *mut rt.Buf, key: str, value: i64) {
    cursor.push_text(out, key)
    rt.buf_push(out, 32 as u8)
    cursor.push_int(out, value)
    cursor.push_nl(out)
}

fn meta_write(f: *mut model.Font, out: *mut rt.Buf) {
    cursor.push_text(out, "firnfont 1\n")
    push_text_field(out, "family", &(*f).family)
    push_text_field(out, "style", &(*f).style)
    push_int_field(out, "upem", (*f).upem)
    push_int_field(out, "ascender", (*f).ascender)
    push_int_field(out, "descender", (*f).descender)
    push_int_field(out, "xheight", (*f).xheight)
    push_int_field(out, "capheight", (*f).capheight)
    push_int_field(out, "linegap", (*f).linegap)
    push_text_field(out, "license", &(*f).license)
    push_text_field(out, "copyright", &(*f).copyright)
    push_text_field(out, "version", &(*f).version)
}

fn kerning_parse(p: u64, n: usize, f: *mut model.Font) -> i64 {
    var c: cursor.Cur = cursor.cur_new(p, n)
    while cursor.cur_next_line(&c) {
        if cursor.cur_at_eol(&c) {
            continue
        }
        let key: str = cursor.cur_word(&c)
        if key.n > 0 && rt.ld8(key.p as u64, 0) == 35 as u8 {
            continue
        }
        var left: u32 = 0
        var right: u32 = 0
        var value: i64 = 0
        if !cursor.str_eq(key, "pair") || !cursor.cur_cp(&c, &left) || !cursor.cur_cp(&c, &right) {
            return c.line
        }
        if !cursor.cur_int(&c, &value) {
            return c.line
        }
        model.font_kern_set(f, left, right, value)
    }
    return 0
}

fn kerning_write(f: *mut model.Font, out: *mut rt.Buf) {
    var i: usize = 0
    let n: usize = model.font_kern_count(f)
    while i < n {
        let k: *mut model.Kern = model.font_kern_at(f, i)
        cursor.push_text(out, "pair ")
        cursor.push_cp(out, (*k).left)
        rt.buf_push(out, 32 as u8)
        cursor.push_cp(out, (*k).right)
        rt.buf_push(out, 32 as u8)
        cursor.push_int(out, (*k).value)
        cursor.push_nl(out)
        i = i + 1
    }
}
