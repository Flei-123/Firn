// lib/rt/vec.fi — `Vec[T]`: wachsendes Feld beliebiger Elementtypen.
//
// `docs/SELBSTHOSTING.md` §4 führt dies als Punkt 2 der Blockerliste: der
// Tokenstrom, die Anweisungslisten, die Blocklisten — der ganze Compiler
// besteht aus wachsenden Feldern. Ein Feld FESTER Größe geht seit Runde 2
// (`tests/211_generic_struct.fi`); für ein wachsendes fehlte die
// Elementgröße. Seit `size_of[T]()` (Runde 16) ist sie da.
//
// Aufbau: Zeiger, Länge, Kapazität — dieselbe Form wie `rt.Buf`, nur typisiert.
// Gewachsen wird durch Verdopplung, damit die Zahl der Umkopierungen
// logarithmisch bleibt.
//
// EHRLICHE GRENZE: Firn hat keine Zerstörer. Wer einen `Vec[T]` nicht mehr
// braucht, ruft `vec_frei[T]` — vergisst er es, bleibt der Speicher liegen.
// Mit `defer` (Runde 9) ist das eine Zeile:
//
//     var v: Vec[i32] = vec_neu[i32]()
//     defer vec_frei[i32](&v)

import rt

export { Vec, vec_new, vec_free, vec_clear, vec_reserve, vec_push, vec_at,
         vec_set, vec_len, vec_cap, vec_ptr, vec_last, vec_pop,
         // Runde 42
         vec_is_empty, vec_shorten, vec_fill, vec_swap, vec_invert,
         vec_index_of, vec_contains, vec_count, vec_insert,
         vec_remove, vec_remove_fast, vec_append, vec_copy,
         vec_equal, vec_min, vec_max, vec_sort, vec_is_sorted,
         vec_lower_bound, vec_binary_search, vec_sorted_insert,
         // Runde 50
         Ord, vec_elem_ptr }

// --------------------------------------------------------------- Die Ordnung
//
// RUNDE 50. Bis hierher stand in `vec_sortiere` das Zeichen `<` — der
// eingebaute Vergleich. Das hatte zwei Folgen, die man erst sieht, wenn man
// sie nebeneinanderlegt:
//
//   * Sortieren ging NUR fuer Skalare. `Vec[Punkt]` liess sich anlegen und
//     fuellen, aber nicht sortieren: `<` gibt es fuer einen Struct nicht,
//     und die Vorlage hatte keine Moeglichkeit, danach zu fragen.
//   * Die Ordnung stand im Sortierer, nicht am Typ. Wer eine andere wollte,
//     schrieb den Sortierer ab.
//
// Jetzt steht sie am Typ. `T: Ord` ist eine SCHRANKE (SPEC §14.1 T7): die
// Vorlage darf `a.kleiner(b)` schreiben, und der Uebersetzer prueft bei der
// Auspraegung, dass es das gibt — mit einer Meldung, die die fehlende Methode
// nennt, nicht mit „unbekannte methode" mitten im Sortierer.
//
// `*Self` ist dabei der Punkt, an dem es haengt: eine Ordnung vergleicht
// ZWEI Werte DESSELBEN Typs. Ohne `Self` muesste in der Schnittstelle ein
// konkreter Typ stehen, und `Ord` waere fuer genau einen Typ da.
//
// DER AUFRUF IST STATISCH. `dyn Ord` gibt es nicht (und kann es nicht geben,
// siehe `Self` oben) — bei bekannter Auspraegung steht `call i32__kleiner`
// im Assembler, kein Sprung ueber eine Methodentafel. Nachgewiesen in
// `tools/bounds/run.sh`.
interface Ord {
    fn less(*self, b: *Self) -> bool
}

// Die Ordnung der eingebauten Ganzzahltypen — die, die `<` schon immer
// meinte: vorzeichenbehaftet fuer `i*`, vorzeichenlos fuer `u*`. Sie steht
// hier, damit `vec_sortiere[i32]` weiter ohne Zutun des Aufrufers geht.
//
// PROGRAMMWEIT: Methoden eines Grundtyps werden nicht nach Modul umbenannt
// (`i32__kleiner`, nicht `vec__i32__kleiner`) — der Typ `i32` gehoert ja
// auch keinem Modul.
impl Ord for i8    { fn less(*self, b: *i8)    -> bool { return *self < *b } }
impl Ord for i16   { fn less(*self, b: *i16)   -> bool { return *self < *b } }
impl Ord for i32   { fn less(*self, b: *i32)   -> bool { return *self < *b } }
impl Ord for i64   { fn less(*self, b: *i64)   -> bool { return *self < *b } }
impl Ord for u8    { fn less(*self, b: *u8)    -> bool { return *self < *b } }
impl Ord for u16   { fn less(*self, b: *u16)   -> bool { return *self < *b } }
impl Ord for u32   { fn less(*self, b: *u32)   -> bool { return *self < *b } }
impl Ord for u64   { fn less(*self, b: *u64)   -> bool { return *self < *b } }
impl Ord for usize { fn less(*self, b: *usize) -> bool { return *self < *b } }
impl Ord for isize { fn less(*self, b: *isize) -> bool { return *self < *b } }

struct Vec[T] {
    ptr: u64,
    len: usize,
    cap: usize,
}

fn vec_new[T]() -> Vec[T] {
    return Vec[T]{ ptr: 0, len: 0, cap: 0 }
}

fn vec_free[T](v: *mut Vec[T]) {
    rt.heap_free((*v).ptr, (*v).cap * size_of[T]())
    (*v).ptr = 0
    (*v).len = 0
    (*v).cap = 0
}

fn vec_clear[T](v: *mut Vec[T]) {
    (*v).len = 0
}

fn vec_len[T](v: *mut Vec[T]) -> usize {
    return (*v).len
}

fn vec_cap[T](v: *mut Vec[T]) -> usize {
    return (*v).cap
}

fn vec_ptr[T](v: *mut Vec[T]) -> u64 {
    return (*v).ptr
}

// Vergroessert auf mindestens `noetig` Plaetze. `false` = Speicher aus.
fn vec_grow[T](v: *mut Vec[T], needed: usize) -> bool {
    let gr: usize = size_of[T]()
    var cap: usize = (*v).cap
    if cap == 0 {
        cap = 8
    }
    while cap < needed {
        cap = cap * 2
    }
    let new: u64 = rt.heap_alloc(cap * gr)
    if new == 0 {
        return false
    }
    if (*v).len > 0 {
        rt.mem_copy(new, (*v).ptr, (*v).len * gr)
    }
    rt.heap_free((*v).ptr, (*v).cap * gr)
    (*v).ptr = new
    (*v).cap = cap
    return true
}

fn vec_reserve[T](v: *mut Vec[T], needed: usize) -> bool {
    if (*v).cap >= needed {
        return true
    }
    return vec_grow[T](v, needed)
}

// Schneller Pfad oben, Wachsen ausgelagert — dieselbe Lehre wie bei `rt.Buf`
// (Runde 6: die Kapazitaetspruefung war 33 % aller Instruktionen, weil sie
// als Aufruf anfiel).
fn vec_push[T](v: *mut Vec[T], value: T) -> bool {
    if (*v).len >= (*v).cap {
        if !vec_grow[T](v, (*v).len + 1) {
            return false
        }
    }
    let addr: u64 = (*v).ptr + (*v).len as u64 * size_of[T]() as u64
    *(addr as *mut T) = value
    (*v).len = (*v).len + 1
    return true
}

// Zeiger auf das i-te Element, NULL jenseits des Endes (Runde 50).
//
// Warum es das zusaetzlich zu `vec_at` gibt: `vec_at` liefert jenseits des
// Endes `0 as T` — und ein `0 as T` gibt es nur fuer Skalare. Genau daran
// haengt die Schranke `T: Scalar` an `vec_at`, und genau deshalb liess sich
// ein `Vec[Punkt]` frueher nicht sortieren. Ein ZEIGER hat einen Nullwert
// fuer jeden Elementtyp; alles, was danach kommt (Sortieren, Suchen,
// Tauschen), arbeitet deshalb hierueber und gilt fuer JEDEN Typ.
fn vec_elem_ptr[T](v: *mut Vec[T], i: usize) -> *mut T {
    if i >= (*v).len {
        return 0 as *mut T
    }
    return ((*v).ptr + i as u64 * size_of[T]() as u64) as *mut T
}

// Jenseits des Endes liefert `vec_at` den Nullwert — wie `rt.buf_at`. Das ist
// eine bewusste Entscheidung: Stufe 0 hat keine Ausnahmen, und ein stiller
// Zugriff ins Nichts waere schlimmer.
fn vec_at[T: Scalar](v: *mut Vec[T], i: usize) -> T {
    if i >= (*v).len {
        return 0 as T
    }
    let addr: u64 = (*v).ptr + i as u64 * size_of[T]() as u64
    return *(addr as *mut T)
}

fn vec_set[T](v: *mut Vec[T], i: usize, value: T) -> bool {
    if i >= (*v).len {
        return false
    }
    let addr: u64 = (*v).ptr + i as u64 * size_of[T]() as u64
    *(addr as *mut T) = value
    return true
}

fn vec_last[T: Scalar](v: *mut Vec[T]) -> T {
    if (*v).len == 0 {
        return 0 as T
    }
    return vec_at[T](v, (*v).len - 1)
}

fn vec_pop[T: Scalar](v: *mut Vec[T]) -> T {
    if (*v).len == 0 {
        return 0 as T
    }
    let w: T = vec_at[T](v, (*v).len - 1)
    (*v).len = (*v).len - 1
    return w
}

// =====================================================================
// Runde 42 — der Ausbau. Alles hier ist GENERISCH: eine Vorlage, die nur
// dann Code wird, wenn ein Programm sie fuer einen Typ benutzt
// (Monomorphisierung, Runde 2). `lib/firnc1/vec.fi` ist ein Symlink auf
// diese Datei — der selbstgehostete Compiler traegt davon also kein Byte,
// solange er die neuen Namen nicht ruft (nachgemessen: Fixpunkt unveraendert).
//
// Die Ordnung ist die des Typs: `<` auf `T`. Fuer vorzeichenlose Typen ist
// das die vorzeichenlose Ordnung, fuer vorzeichenbehaftete die
// vorzeichenbehaftete — die Kernsprache waehlt den richtigen Vergleich, weil
// die Ausprägung den Typ kennt.
// =====================================================================

fn vec_is_empty[T](v: *mut Vec[T]) -> bool {
    return (*v).len == 0
}

// Auf hoechstens `n` Elemente kuerzen. Der Speicher bleibt — wer ihn will,
// ruft danach `vec_frei`.
fn vec_shorten[T](v: *mut Vec[T], n: usize) {
    if n < (*v).len {
        (*v).len = n
    }
}

fn vec_fill[T](v: *mut Vec[T], value: T) {
    var i: usize = 0
    while i < (*v).len {
        vec_set[T](v, i, value)
        i = i + 1
    }
}

fn vec_swap[T](v: *mut Vec[T], i: usize, j: usize) -> bool {
    if i >= (*v).len || j >= (*v).len {
        return false
    }
    let pi: *mut T = vec_elem_ptr[T](v, i)
    let pj: *mut T = vec_elem_ptr[T](v, j)
    let a: T = *pi
    *pi = *pj
    *pj = a
    return true
}

fn vec_invert[T](v: *mut Vec[T]) {
    if (*v).len < 2 {
        return
    }
    var a: usize = 0
    var b: usize = (*v).len - 1
    while a < b {
        vec_swap[T](v, a, b)
        a = a + 1
        b = b - 1
    }
}

// Erste Fundstelle. NICHT GEFUNDEN ist `vec_len` — dieselbe Regel wie bei
// `map_finde` (dort `kap`): ein Index jenseits des Endes kann nie ein
// Treffer sein, also braucht es keinen zweiten Rueckgabeweg.
fn vec_index_of[T: Scalar](v: *mut Vec[T], value: T) -> usize {
    var i: usize = 0
    while i < (*v).len {
        if vec_at[T](v, i) == value {
            return i
        }
        i = i + 1
    }
    return (*v).len
}

fn vec_contains[T: Scalar](v: *mut Vec[T], value: T) -> bool {
    return vec_index_of[T](v, value) < (*v).len
}

fn vec_count[T: Scalar](v: *mut Vec[T], value: T) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < (*v).len {
        if vec_at[T](v, i) == value {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// An Position `i` einfuegen (i == len haengt an). `false` = Speicher aus.
fn vec_insert[T](v: *mut Vec[T], i: usize, value: T) -> bool {
    if i > (*v).len {
        return false
    }
    if !vec_push[T](v, value) {
        return false
    }
    var j: usize = (*v).len - 1
    while j > i {
        let target: *mut T = vec_elem_ptr[T](v, j)
        let source: *mut T = vec_elem_ptr[T](v, j - 1)
        *target = *source
        j = j - 1
    }
    let first: *mut T = vec_elem_ptr[T](v, i)
    *first = value
    return true
}

// Entfernen unter Erhalt der Reihenfolge — O(n).
fn vec_remove[T: Scalar](v: *mut Vec[T], i: usize) -> T {
    if i >= (*v).len {
        return 0 as T
    }
    let w: T = vec_at[T](v, i)
    var j: usize = i
    while j + 1 < (*v).len {
        vec_set[T](v, j, vec_at[T](v, j + 1))
        j = j + 1
    }
    (*v).len = (*v).len - 1
    return w
}

// Entfernen in O(1), indem das letzte Element nachrueckt. Die Reihenfolge
// geht dabei verloren — der Aufrufer entscheidet, ob ihm das recht ist.
fn vec_remove_fast[T: Scalar](v: *mut Vec[T], i: usize) -> T {
    if i >= (*v).len {
        return 0 as T
    }
    let w: T = vec_at[T](v, i)
    let last: T = vec_at[T](v, (*v).len - 1)
    vec_set[T](v, i, last)
    (*v).len = (*v).len - 1
    return w
}

// `quelle` an `ziel` anhaengen. Beide duerfen NICHT dasselbe Feld sein.
fn vec_append[T](target: *mut Vec[T], source: *mut Vec[T]) -> bool {
    if !vec_reserve[T](target, (*target).len + (*source).len) {
        return false
    }
    var i: usize = 0
    while i < (*source).len {
        let p: *mut T = vec_elem_ptr[T](source, i)
        if !vec_push[T](target, *p) {
            return false
        }
        i = i + 1
    }
    return true
}

// `ziel` wird zur Kopie von `quelle` (vorheriger Inhalt faellt weg, der
// Speicher bleibt).
fn vec_copy[T](source: *mut Vec[T], target: *mut Vec[T]) -> bool {
    vec_clear[T](target)
    if (*source).len == 0 {
        return true
    }
    if !vec_reserve[T](target, (*source).len) {
        return false
    }
    rt.mem_copy((*target).ptr, (*source).ptr, (*source).len * size_of[T]())
    (*target).len = (*source).len
    return true
}

fn vec_equal[T: Scalar](a: *mut Vec[T], b: *mut Vec[T]) -> bool {
    if (*a).len != (*b).len {
        return false
    }
    var i: usize = 0
    while i < (*a).len {
        if vec_at[T](a, i) != vec_at[T](b, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// Kleinstes/groesstes Element. Bei leerem Feld der Nullwert — wie `vec_at`.
// ZWEI SCHRANKEN GLEICHZEITIG: `Scalar` fuer den Nullwert bei leerem Feld
// (`0 as T`), `Ord` fuer den Vergleich. Beide muessen gelten, geprueft wird
// bei der Auspraegung.
fn vec_min[T: Scalar + Ord](v: *mut Vec[T]) -> T {
    if (*v).len == 0 {
        return 0 as T
    }
    var m: T = vec_at[T](v, 0)
    var i: usize = 1
    while i < (*v).len {
        var w: T = vec_at[T](v, i)
        if w.less(&m) {
            m = w
        }
        i = i + 1
    }
    return m
}

fn vec_max[T: Scalar + Ord](v: *mut Vec[T]) -> T {
    if (*v).len == 0 {
        return 0 as T
    }
    var m: T = vec_at[T](v, 0)
    var i: usize = 1
    while i < (*v).len {
        var w: T = vec_at[T](v, i)
        if m.less(&w) {
            m = w
        }
        i = i + 1
    }
    return m
}

// --------------------------------------------------------------- Sortieren
//
// HEAPSORT, nicht Quicksort. Drei Gruende, alle nachpruefbar:
//   * O(n log n) im SCHLECHTESTEN Fall — Quicksort entartet bei bereits
//     sortierter oder gleichverteilter Eingabe zu O(n^2), und genau die
//     kommen in einem Compiler staendig vor.
//   * kein zusaetzlicher Speicher (Mergesort braeuchte n Elemente).
//   * keine Rekursion — die Tiefe eines Sortierlaufs haengt sonst an der
//     Eingabe, und Stufe 0 hat keine Stapelpruefung.
// NICHT STABIL: gleiche Elemente koennen die Reihenfolge tauschen. Bei
// Skalaren ist das nicht unterscheidbar; sobald Vec[T] Schluessel-Wert-Paare
// traegt, ist es eine Zusage, die hier fehlt.

fn vec_lower[T: Ord](v: *mut Vec[T], root: usize, end: usize) {
    var i: usize = root
    var runs: bool = true
    while runs {
        var gr: usize = i
        let l: usize = 2 * i + 1
        let r: usize = 2 * i + 2
        if l < end {
            let pl: *mut T = vec_elem_ptr[T](v, l)
            let pg: *mut T = vec_elem_ptr[T](v, gr)
            if pg.less(pl) {
                gr = l
            }
        }
        if r < end {
            let pr: *mut T = vec_elem_ptr[T](v, r)
            let pg: *mut T = vec_elem_ptr[T](v, gr)
            if pg.less(pr) {
                gr = r
            }
        }
        if gr == i {
            runs = false
        } else {
            vec_swap[T](v, i, gr)
            i = gr
        }
    }
}

fn vec_sort[T: Ord](v: *mut Vec[T]) {
    let n: usize = (*v).len
    if n < 2 {
        return
    }
    var i: usize = n / 2
    while i > 0 {
        i = i - 1
        vec_lower[T](v, i, n)
    }
    var e: usize = n
    while e > 1 {
        e = e - 1
        vec_swap[T](v, 0, e)
        vec_lower[T](v, 0, e)
    }
}

fn vec_is_sorted[T: Ord](v: *mut Vec[T]) -> bool {
    if (*v).len < 2 {
        return true
    }
    var i: usize = 1
    while i < (*v).len {
        let a: *mut T = vec_elem_ptr[T](v, i)
        let b: *mut T = vec_elem_ptr[T](v, i - 1)
        if a.less(b) {
            return false
        }
        i = i + 1
    }
    return true
}

// Erste Position, an der `wert` stehen koennte (alle davor sind kleiner) —
// die Standardschranke, mit der man auch einfuegen kann.
// SETZT VORAUS, dass das Feld sortiert ist; sonst ist die Antwort beliebig.
fn vec_lower_bound[T: Ord](v: *mut Vec[T], value: T) -> usize {
    var w: T = value
    var lo: usize = 0
    var hi: usize = (*v).len
    while lo < hi {
        let m: usize = lo + (hi - lo) / 2
        let p: *mut T = vec_elem_ptr[T](v, m)
        if p.less(&w) {
            lo = m + 1
        } else {
            hi = m
        }
    }
    return lo
}

// Binaersuche. NICHT GEFUNDEN ist `vec_len` — wie bei `vec_index_von`.
//
// GLEICHHEIT AUS DER ORDNUNG: `a == b` heisst hier `!(a < b) && !(b < a)`.
// Das ist keine Bequemlichkeit, sondern die einzige Gleichheit, die zu einer
// Binaersuche passt — sie muss dieselbe sein, nach der sortiert wurde.
// Sonst faende die Suche eine Stelle, an der nach der Ordnung nichts steht.
fn vec_binary_search[T: Ord](v: *mut Vec[T], value: T) -> usize {
    var w: T = value
    let i: usize = vec_lower_bound[T](v, w)
    if i < (*v).len {
        let p: *mut T = vec_elem_ptr[T](v, i)
        if !p.less(&w) && !w.less(p) {
            return i
        }
    }
    return (*v).len
}

// Sortiert einfuegen: die Ordnung bleibt erhalten.
fn vec_sorted_insert[T: Ord](v: *mut Vec[T], value: T) -> bool {
    return vec_insert[T](v, vec_lower_bound[T](v, value), value)
}
