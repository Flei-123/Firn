// lib/rt/vec.fi — `Vec[T]`: wachsendes Feld beliebiger Elementtypen.
//
// `docs/SELBSTHOSTING.md` §4 führt dies als Punkt 2 der Blockerliste: der
// Tokenstrom, die Anweisungslisten, die Blocklisten — der ganze Compiler
// besteht aus wachsenden Feldern. Ein Feld FESTER Größe geht seit Runde 2
// (`tests/211_generic_struct.fi`); für ein wachsendes fehlte die
// Elementgröße. Seit `size_of[T]()` (Runde 16) ist sie da.
//
// Aufbau: Zeiger, Länge, Kapazität — dieselbe Form wie `rt.Buf`, nur typisiert.
// Gewachsen wird durch Verdopplung, damit die Zahl der Umkopierungen
// logarithmisch bleibt.
//
// EHRLICHE GRENZE: Firn hat keine Zerstörer. Wer einen `Vec[T]` nicht mehr
// braucht, ruft `vec_frei[T]` — vergisst er es, bleibt der Speicher liegen.
// Mit `defer` (Runde 9) ist das eine Zeile:
//
//     var v: Vec[i32] = vec_neu[i32]()
//     defer vec_frei[i32](&v)

import rt

export { Vec, vec_neu, vec_frei, vec_leeren, vec_reserve, vec_push, vec_at,
         vec_setzen, vec_len, vec_kap, vec_ptr, vec_letztes, vec_pop,
         // Runde 42
         vec_ist_leer, vec_kuerzen, vec_fuellen, vec_tausche, vec_umkehren,
         vec_index_von, vec_enthaelt, vec_zaehle, vec_einfuegen,
         vec_entfernen, vec_entfernen_schnell, vec_anhaengen, vec_kopie,
         vec_gleich, vec_min, vec_max, vec_sortiere, vec_ist_sortiert,
         vec_untere_schranke, vec_binaersuche, vec_sortiert_einfuegen }

struct Vec[T] {
    ptr: u64,
    len: usize,
    kap: usize,
}

fn vec_neu[T: Scalar]() -> Vec[T] {
    return Vec[T]{ ptr: 0, len: 0, kap: 0 }
}

fn vec_frei[T: Scalar](v: *mut Vec[T]) {
    rt.heap_free((*v).ptr, (*v).kap * size_of[T]())
    (*v).ptr = 0
    (*v).len = 0
    (*v).kap = 0
}

fn vec_leeren[T: Scalar](v: *mut Vec[T]) {
    (*v).len = 0
}

fn vec_len[T: Scalar](v: *mut Vec[T]) -> usize {
    return (*v).len
}

fn vec_kap[T: Scalar](v: *mut Vec[T]) -> usize {
    return (*v).kap
}

fn vec_ptr[T: Scalar](v: *mut Vec[T]) -> u64 {
    return (*v).ptr
}

// Vergroessert auf mindestens `noetig` Plaetze. `false` = Speicher aus.
fn vec_wachse[T: Scalar](v: *mut Vec[T], noetig: usize) -> bool {
    let gr: usize = size_of[T]()
    var kap: usize = (*v).kap
    if kap == 0 {
        kap = 8
    }
    while kap < noetig {
        kap = kap * 2
    }
    let neu: u64 = rt.heap_alloc(kap * gr)
    if neu == 0 {
        return false
    }
    if (*v).len > 0 {
        rt.mem_copy(neu, (*v).ptr, (*v).len * gr)
    }
    rt.heap_free((*v).ptr, (*v).kap * gr)
    (*v).ptr = neu
    (*v).kap = kap
    return true
}

fn vec_reserve[T: Scalar](v: *mut Vec[T], noetig: usize) -> bool {
    if (*v).kap >= noetig {
        return true
    }
    return vec_wachse[T](v, noetig)
}

// Schneller Pfad oben, Wachsen ausgelagert — dieselbe Lehre wie bei `rt.Buf`
// (Runde 6: die Kapazitaetspruefung war 33 % aller Instruktionen, weil sie
// als Aufruf anfiel).
fn vec_push[T: Scalar](v: *mut Vec[T], wert: T) -> bool {
    if (*v).len >= (*v).kap {
        if !vec_wachse[T](v, (*v).len + 1) {
            return false
        }
    }
    let adr: u64 = (*v).ptr + (*v).len as u64 * size_of[T]() as u64
    *(adr as *mut T) = wert
    (*v).len = (*v).len + 1
    return true
}

// Jenseits des Endes liefert `vec_at` den Nullwert — wie `rt.buf_at`. Das ist
// eine bewusste Entscheidung: Stufe 0 hat keine Ausnahmen, und ein stiller
// Zugriff ins Nichts waere schlimmer.
fn vec_at[T: Scalar](v: *mut Vec[T], i: usize) -> T {
    if i >= (*v).len {
        return 0 as T
    }
    let adr: u64 = (*v).ptr + i as u64 * size_of[T]() as u64
    return *(adr as *mut T)
}

fn vec_setzen[T: Scalar](v: *mut Vec[T], i: usize, wert: T) -> bool {
    if i >= (*v).len {
        return false
    }
    let adr: u64 = (*v).ptr + i as u64 * size_of[T]() as u64
    *(adr as *mut T) = wert
    return true
}

fn vec_letztes[T: Scalar](v: *mut Vec[T]) -> T {
    if (*v).len == 0 {
        return 0 as T
    }
    return vec_at[T](v, (*v).len - 1)
}

fn vec_pop[T: Scalar](v: *mut Vec[T]) -> T {
    if (*v).len == 0 {
        return 0 as T
    }
    let w: T = vec_at[T](v, (*v).len - 1)
    (*v).len = (*v).len - 1
    return w
}

// =====================================================================
// Runde 42 — der Ausbau. Alles hier ist GENERISCH: eine Vorlage, die nur
// dann Code wird, wenn ein Programm sie fuer einen Typ benutzt
// (Monomorphisierung, Runde 2). `lib/firnc1/vec.fi` ist ein Symlink auf
// diese Datei — der selbstgehostete Compiler traegt davon also kein Byte,
// solange er die neuen Namen nicht ruft (nachgemessen: Fixpunkt unveraendert).
//
// Die Ordnung ist die des Typs: `<` auf `T`. Fuer vorzeichenlose Typen ist
// das die vorzeichenlose Ordnung, fuer vorzeichenbehaftete die
// vorzeichenbehaftete — die Kernsprache waehlt den richtigen Vergleich, weil
// die Ausprägung den Typ kennt.
// =====================================================================

fn vec_ist_leer[T: Scalar](v: *mut Vec[T]) -> bool {
    return (*v).len == 0
}

// Auf hoechstens `n` Elemente kuerzen. Der Speicher bleibt — wer ihn will,
// ruft danach `vec_frei`.
fn vec_kuerzen[T: Scalar](v: *mut Vec[T], n: usize) {
    if n < (*v).len {
        (*v).len = n
    }
}

fn vec_fuellen[T: Scalar](v: *mut Vec[T], wert: T) {
    var i: usize = 0
    while i < (*v).len {
        vec_setzen[T](v, i, wert)
        i = i + 1
    }
}

fn vec_tausche[T: Scalar](v: *mut Vec[T], i: usize, j: usize) -> bool {
    if i >= (*v).len || j >= (*v).len {
        return false
    }
    let a: T = vec_at[T](v, i)
    vec_setzen[T](v, i, vec_at[T](v, j))
    vec_setzen[T](v, j, a)
    return true
}

fn vec_umkehren[T: Scalar](v: *mut Vec[T]) {
    if (*v).len < 2 {
        return
    }
    var a: usize = 0
    var b: usize = (*v).len - 1
    while a < b {
        vec_tausche[T](v, a, b)
        a = a + 1
        b = b - 1
    }
}

// Erste Fundstelle. NICHT GEFUNDEN ist `vec_len` — dieselbe Regel wie bei
// `map_finde` (dort `kap`): ein Index jenseits des Endes kann nie ein
// Treffer sein, also braucht es keinen zweiten Rueckgabeweg.
fn vec_index_von[T: Scalar](v: *mut Vec[T], wert: T) -> usize {
    var i: usize = 0
    while i < (*v).len {
        if vec_at[T](v, i) == wert {
            return i
        }
        i = i + 1
    }
    return (*v).len
}

fn vec_enthaelt[T: Scalar](v: *mut Vec[T], wert: T) -> bool {
    return vec_index_von[T](v, wert) < (*v).len
}

fn vec_zaehle[T: Scalar](v: *mut Vec[T], wert: T) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < (*v).len {
        if vec_at[T](v, i) == wert {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// An Position `i` einfuegen (i == len haengt an). `false` = Speicher aus.
fn vec_einfuegen[T: Scalar](v: *mut Vec[T], i: usize, wert: T) -> bool {
    if i > (*v).len {
        return false
    }
    if !vec_push[T](v, wert) {
        return false
    }
    var j: usize = (*v).len - 1
    while j > i {
        vec_setzen[T](v, j, vec_at[T](v, j - 1))
        j = j - 1
    }
    vec_setzen[T](v, i, wert)
    return true
}

// Entfernen unter Erhalt der Reihenfolge — O(n).
fn vec_entfernen[T: Scalar](v: *mut Vec[T], i: usize) -> T {
    if i >= (*v).len {
        return 0 as T
    }
    let w: T = vec_at[T](v, i)
    var j: usize = i
    while j + 1 < (*v).len {
        vec_setzen[T](v, j, vec_at[T](v, j + 1))
        j = j + 1
    }
    (*v).len = (*v).len - 1
    return w
}

// Entfernen in O(1), indem das letzte Element nachrueckt. Die Reihenfolge
// geht dabei verloren — der Aufrufer entscheidet, ob ihm das recht ist.
fn vec_entfernen_schnell[T: Scalar](v: *mut Vec[T], i: usize) -> T {
    if i >= (*v).len {
        return 0 as T
    }
    let w: T = vec_at[T](v, i)
    let letztes: T = vec_at[T](v, (*v).len - 1)
    vec_setzen[T](v, i, letztes)
    (*v).len = (*v).len - 1
    return w
}

// `quelle` an `ziel` anhaengen. Beide duerfen NICHT dasselbe Feld sein.
fn vec_anhaengen[T: Scalar](ziel: *mut Vec[T], quelle: *mut Vec[T]) -> bool {
    if !vec_reserve[T](ziel, (*ziel).len + (*quelle).len) {
        return false
    }
    var i: usize = 0
    while i < (*quelle).len {
        if !vec_push[T](ziel, vec_at[T](quelle, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

// `ziel` wird zur Kopie von `quelle` (vorheriger Inhalt faellt weg, der
// Speicher bleibt).
fn vec_kopie[T: Scalar](quelle: *mut Vec[T], ziel: *mut Vec[T]) -> bool {
    vec_leeren[T](ziel)
    if (*quelle).len == 0 {
        return true
    }
    if !vec_reserve[T](ziel, (*quelle).len) {
        return false
    }
    rt.mem_copy((*ziel).ptr, (*quelle).ptr, (*quelle).len * size_of[T]())
    (*ziel).len = (*quelle).len
    return true
}

fn vec_gleich[T: Scalar](a: *mut Vec[T], b: *mut Vec[T]) -> bool {
    if (*a).len != (*b).len {
        return false
    }
    var i: usize = 0
    while i < (*a).len {
        if vec_at[T](a, i) != vec_at[T](b, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// Kleinstes/groesstes Element. Bei leerem Feld der Nullwert — wie `vec_at`.
fn vec_min[T: Scalar](v: *mut Vec[T]) -> T {
    if (*v).len == 0 {
        return 0 as T
    }
    var m: T = vec_at[T](v, 0)
    var i: usize = 1
    while i < (*v).len {
        let w: T = vec_at[T](v, i)
        if w < m {
            m = w
        }
        i = i + 1
    }
    return m
}

fn vec_max[T: Scalar](v: *mut Vec[T]) -> T {
    if (*v).len == 0 {
        return 0 as T
    }
    var m: T = vec_at[T](v, 0)
    var i: usize = 1
    while i < (*v).len {
        let w: T = vec_at[T](v, i)
        if w > m {
            m = w
        }
        i = i + 1
    }
    return m
}

// --------------------------------------------------------------- Sortieren
//
// HEAPSORT, nicht Quicksort. Drei Gruende, alle nachpruefbar:
//   * O(n log n) im SCHLECHTESTEN Fall — Quicksort entartet bei bereits
//     sortierter oder gleichverteilter Eingabe zu O(n^2), und genau die
//     kommen in einem Compiler staendig vor.
//   * kein zusaetzlicher Speicher (Mergesort braeuchte n Elemente).
//   * keine Rekursion — die Tiefe eines Sortierlaufs haengt sonst an der
//     Eingabe, und Stufe 0 hat keine Stapelpruefung.
// NICHT STABIL: gleiche Elemente koennen die Reihenfolge tauschen. Bei
// Skalaren ist das nicht unterscheidbar; sobald Vec[T] Schluessel-Wert-Paare
// traegt, ist es eine Zusage, die hier fehlt.

fn vec_senken[T: Scalar](v: *mut Vec[T], wurzel: usize, ende: usize) {
    var i: usize = wurzel
    var laeuft: bool = true
    while laeuft {
        var gr: usize = i
        let l: usize = 2 * i + 1
        let r: usize = 2 * i + 2
        if l < ende && vec_at[T](v, l) > vec_at[T](v, gr) {
            gr = l
        }
        if r < ende && vec_at[T](v, r) > vec_at[T](v, gr) {
            gr = r
        }
        if gr == i {
            laeuft = false
        } else {
            vec_tausche[T](v, i, gr)
            i = gr
        }
    }
}

fn vec_sortiere[T: Scalar](v: *mut Vec[T]) {
    let n: usize = (*v).len
    if n < 2 {
        return
    }
    var i: usize = n / 2
    while i > 0 {
        i = i - 1
        vec_senken[T](v, i, n)
    }
    var e: usize = n
    while e > 1 {
        e = e - 1
        vec_tausche[T](v, 0, e)
        vec_senken[T](v, 0, e)
    }
}

fn vec_ist_sortiert[T: Scalar](v: *mut Vec[T]) -> bool {
    if (*v).len < 2 {
        return true
    }
    var i: usize = 1
    while i < (*v).len {
        if vec_at[T](v, i) < vec_at[T](v, i - 1) {
            return false
        }
        i = i + 1
    }
    return true
}

// Erste Position, an der `wert` stehen koennte (alle davor sind kleiner) —
// die Standardschranke, mit der man auch einfuegen kann.
// SETZT VORAUS, dass das Feld sortiert ist; sonst ist die Antwort beliebig.
fn vec_untere_schranke[T: Scalar](v: *mut Vec[T], wert: T) -> usize {
    var lo: usize = 0
    var hi: usize = (*v).len
    while lo < hi {
        let m: usize = lo + (hi - lo) / 2
        if vec_at[T](v, m) < wert {
            lo = m + 1
        } else {
            hi = m
        }
    }
    return lo
}

// Binaersuche. NICHT GEFUNDEN ist `vec_len` — wie bei `vec_index_von`.
fn vec_binaersuche[T: Scalar](v: *mut Vec[T], wert: T) -> usize {
    let i: usize = vec_untere_schranke[T](v, wert)
    if i < (*v).len && vec_at[T](v, i) == wert {
        return i
    }
    return (*v).len
}

// Sortiert einfuegen: die Ordnung bleibt erhalten.
fn vec_sortiert_einfuegen[T: Scalar](v: *mut Vec[T], wert: T) -> bool {
    return vec_einfuegen[T](v, vec_untere_schranke[T](v, wert), wert)
}
