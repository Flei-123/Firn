// lib/rt/vec.fi — `Vec[T]`: wachsendes Feld beliebiger Elementtypen.
//
// `docs/SELBSTHOSTING.md` §4 führt dies als Punkt 2 der Blockerliste: der
// Tokenstrom, die Anweisungslisten, die Blocklisten — der ganze Compiler
// besteht aus wachsenden Feldern. Ein Feld FESTER Größe geht seit Runde 2
// (`tests/211_generic_struct.fi`); für ein wachsendes fehlte die
// Elementgröße. Seit `size_of[T]()` (Runde 16) ist sie da.
//
// Aufbau: Zeiger, Länge, Kapazität — dieselbe Form wie `rt.Buf`, nur typisiert.
// Gewachsen wird durch Verdopplung, damit die Zahl der Umkopierungen
// logarithmisch bleibt.
//
// EHRLICHE GRENZE: Firn hat keine Zerstörer. Wer einen `Vec[T]` nicht mehr
// braucht, ruft `vec_frei[T]` — vergisst er es, bleibt der Speicher liegen.
// Mit `defer` (Runde 9) ist das eine Zeile:
//
//     var v: Vec[i32] = vec_neu[i32]()
//     defer vec_frei[i32](&v)

import rt

export { Vec, vec_neu, vec_frei, vec_leeren, vec_reserve, vec_push, vec_at,
         vec_setzen, vec_len, vec_kap, vec_ptr, vec_letztes, vec_pop }

struct Vec[T] {
    ptr: u64,
    len: usize,
    kap: usize,
}

fn vec_neu[T: Scalar]() -> Vec[T] {
    return Vec[T]{ ptr: 0, len: 0, kap: 0 }
}

fn vec_frei[T: Scalar](v: *mut Vec[T]) {
    rt.heap_free((*v).ptr, (*v).kap * size_of[T]())
    (*v).ptr = 0
    (*v).len = 0
    (*v).kap = 0
}

fn vec_leeren[T: Scalar](v: *mut Vec[T]) {
    (*v).len = 0
}

fn vec_len[T: Scalar](v: *mut Vec[T]) -> usize {
    return (*v).len
}

fn vec_kap[T: Scalar](v: *mut Vec[T]) -> usize {
    return (*v).kap
}

fn vec_ptr[T: Scalar](v: *mut Vec[T]) -> u64 {
    return (*v).ptr
}

// Vergroessert auf mindestens `noetig` Plaetze. `false` = Speicher aus.
fn vec_wachse[T: Scalar](v: *mut Vec[T], noetig: usize) -> bool {
    let gr: usize = size_of[T]()
    var kap: usize = (*v).kap
    if kap == 0 {
        kap = 8
    }
    while kap < noetig {
        kap = kap * 2
    }
    let neu: u64 = rt.heap_alloc(kap * gr)
    if neu == 0 {
        return false
    }
    if (*v).len > 0 {
        rt.mem_copy(neu, (*v).ptr, (*v).len * gr)
    }
    rt.heap_free((*v).ptr, (*v).kap * gr)
    (*v).ptr = neu
    (*v).kap = kap
    return true
}

fn vec_reserve[T: Scalar](v: *mut Vec[T], noetig: usize) -> bool {
    if (*v).kap >= noetig {
        return true
    }
    return vec_wachse[T](v, noetig)
}

// Schneller Pfad oben, Wachsen ausgelagert — dieselbe Lehre wie bei `rt.Buf`
// (Runde 6: die Kapazitaetspruefung war 33 % aller Instruktionen, weil sie
// als Aufruf anfiel).
fn vec_push[T: Scalar](v: *mut Vec[T], wert: T) -> bool {
    if (*v).len >= (*v).kap {
        if !vec_wachse[T](v, (*v).len + 1) {
            return false
        }
    }
    let adr: u64 = (*v).ptr + (*v).len as u64 * size_of[T]() as u64
    *(adr as *mut T) = wert
    (*v).len = (*v).len + 1
    return true
}

// Jenseits des Endes liefert `vec_at` den Nullwert — wie `rt.buf_at`. Das ist
// eine bewusste Entscheidung: Stufe 0 hat keine Ausnahmen, und ein stiller
// Zugriff ins Nichts waere schlimmer.
fn vec_at[T: Scalar](v: *mut Vec[T], i: usize) -> T {
    if i >= (*v).len {
        return 0 as T
    }
    let adr: u64 = (*v).ptr + i as u64 * size_of[T]() as u64
    return *(adr as *mut T)
}

fn vec_setzen[T: Scalar](v: *mut Vec[T], i: usize, wert: T) -> bool {
    if i >= (*v).len {
        return false
    }
    let adr: u64 = (*v).ptr + i as u64 * size_of[T]() as u64
    *(adr as *mut T) = wert
    return true
}

fn vec_letztes[T: Scalar](v: *mut Vec[T]) -> T {
    if (*v).len == 0 {
        return 0 as T
    }
    return vec_at[T](v, (*v).len - 1)
}

fn vec_pop[T: Scalar](v: *mut Vec[T]) -> T {
    if (*v).len == 0 {
        return 0 as T
    }
    let w: T = vec_at[T](v, (*v).len - 1)
    (*v).len = (*v).len - 1
    return w
}
