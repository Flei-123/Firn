// lib/rt/rt.fi — Laufzeitkern in Firn.
//
// ZWECK: `docs/SELBSTHOSTING.md` §4 nennt drei Punkte, die den Weg zu Stufe 1
// am stärksten blockieren:
//
//   1. Heap-Allokator          — ohne ihn kein `Vec`, kein AST, keine Tabelle
//   5. Textformatierung        — jede Diagnose, der gesamte Assemblertext
//  12. Dateizugriff            — Quelle lesen, `.s` schreiben
//
// Alle drei stehen hier. Sie existierten vorher DREIFACH und leicht
// verschieden — in `lib/html/mem.fi`, `lib/str/alloc.fi` und `lib/gc/gc.fi`.
// Diese Datei ist die gemeinsame Fassung; die bestehenden Module bleiben
// vorerst, wo sie sind (ihr Umbau wäre ein eigener Schritt mit eigenem Risiko
// und ist in `docs/SELBSTHOSTING.md` als offen geführt).
//
// KEINE libc. Alles geht direkt über `syscall`.

export {
    Buf,
    heap_alloc, heap_free, mem_copy, mem_set, mem_eq,
    buf_new, buf_free, buf_clear, buf_reserve, buf_push, buf_push_bytes,
    buf_len, buf_at, buf_ptr, buf_set_len,
    buf_push_dec_u64, buf_push_dec_i64, buf_push_hex_u64,
    write_everything, read_file, read_stdin, finish,
    arg_count, arg_ptr, c_length,
    write_file, run, lauf3,
    ld8, st8, ld16, st16, ld32, st32, ld64, st64,
}

const SYS_READ: i64 = 0
const SYS_WRITE: i64 = 1
const SYS_OPEN: i64 = 2
const SYS_CLOSE: i64 = 3
const SYS_MMAP: i64 = 9
const SYS_MUNMAP: i64 = 11
const SYS_EXIT_GROUP: i64 = 231

const PROT_RW: i64 = 3
const MAP_PRIVATE_ANON: i64 = 34
const SEITE: usize = 4096

// --------------------------------------------------------------- Rohzugriffe

fn ld8(p: u64, i: usize) -> u8 {
    return *((p + i as u64) as *mut u8)
}

fn st8(p: u64, i: usize, v: u8) {
    *((p + i as u64) as *mut u8) = v
}

fn ld16(p: u64, i: usize) -> u16 {
    return *((p + i as u64 * 2) as *mut u16)
}

fn st16(p: u64, i: usize, v: u16) {
    *((p + i as u64 * 2) as *mut u16) = v
}

fn ld32(p: u64, i: usize) -> u32 {
    return *((p + i as u64 * 4) as *mut u32)
}

fn st32(p: u64, i: usize, v: u32) {
    *((p + i as u64 * 4) as *mut u32) = v
}

fn ld64(p: u64, i: usize) -> u64 {
    return *((p + i as u64 * 8) as *mut u64)
}

fn st64(p: u64, i: usize, v: u64) {
    *((p + i as u64 * 8) as *mut u64) = v
}

// ------------------------------------------------------------------ Speicher

fn pages_on(n: usize) -> usize {
    return (n + SEITE - 1) / SEITE * SEITE
}

// n Bytes vom Betriebssystem, nullinitialisiert. 0 = fehlgeschlagen.
//
// OHNE feste Adresse, ohne MAP_FIXED — ein Allokator, der sich die Adresse
// aussucht, kollidiert frueher oder spaeter mit etwas anderem.
fn heap_alloc(n: usize) -> u64 {
    if n == 0 {
        return 0
    }
    let len: usize = pages_on(n)
    let r: i64 = syscall(SYS_MMAP, 0, len as i64, PROT_RW, MAP_PRIVATE_ANON, -1, 0)
    // mmap meldet Fehler als -1 .. -4095
    if r < 0 && r > 0 - 4096 {
        return 0
    }
    if r == 0 {
        return 0
    }
    return r as u64
}

fn heap_free(p: u64, n: usize) {
    if p == 0 {
        return
    }
    syscall(SYS_MUNMAP, p as i64, pages_on(n) as i64, 0, 0, 0, 0)
}

fn mem_copy(target: u64, source: u64, n: usize) {
    // Wortweise, solange es geht — das ist der haeufige Fall bei Puffern.
    var i: usize = 0
    while i + 8 <= n {
        st64(target, i / 8, ld64(source, i / 8))
        i = i + 8
    }
    while i < n {
        st8(target, i, ld8(source, i))
        i = i + 1
    }
}

fn mem_set(target: u64, value: u8, n: usize) {
    var i: usize = 0
    while i < n {
        st8(target, i, value)
        i = i + 1
    }
}

fn mem_eq(a: u64, b: u64, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        if ld8(a, i) != ld8(b, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// -------------------------------------------------------------------- Puffer

// Wachsendes Byte-Feld — die Grundlage fuer alles, was in Stufe 1 `Vec` heisst.
struct Buf {
    ptr: u64,
    len: usize,
    cap: usize,
}

fn buf_new() -> Buf {
    return Buf{ ptr: 0, len: 0, cap: 0 }
}

fn buf_free(b: *mut Buf) {
    heap_free((*b).ptr, (*b).cap)
    (*b).ptr = 0
    (*b).len = 0
    (*b).cap = 0
}

fn buf_clear(b: *mut Buf) {
    (*b).len = 0
}

fn buf_len(b: *mut Buf) -> usize {
    return (*b).len
}

fn buf_ptr(b: *mut Buf) -> u64 {
    return (*b).ptr
}

fn buf_set_len(b: *mut Buf, n: usize) {
    if n <= (*b).cap {
        (*b).len = n
    }
}

fn buf_at(b: *mut Buf, i: usize) -> u8 {
    if i >= (*b).len {
        return 0 as u8
    }
    return ld8((*b).ptr, i)
}

// Wachsen verdoppelt — das haelt die Zahl der Kopien logarithmisch.
fn buf_grow(b: *mut Buf, needed: usize) {
    var cap: usize = (*b).cap
    if cap == 0 {
        cap = 64
    }
    while cap < needed {
        cap = cap * 2
    }
    let new: u64 = heap_alloc(cap)
    if new == 0 {
        return
    }
    if (*b).len > 0 {
        mem_copy(new, (*b).ptr, (*b).len)
    }
    heap_free((*b).ptr, (*b).cap)
    (*b).ptr = new
    (*b).cap = cap
}

fn buf_reserve(b: *mut Buf, needed: usize) {
    if (*b).cap >= needed {
        return
    }
    buf_grow(b, needed)
}

// SCHNELLER PFAD OBEN: nur der Vergleich steht hier, das Wachsen ist eine
// eigene Funktion. So bleibt `buf_push` klein genug zum Einbetten — gemessen
// in Runde 6 waren die Kapazitaetspruefungen sonst 33 % aller Instruktionen
// des Tokenizers.
fn buf_push(b: *mut Buf, v: u8) {
    if (*b).len >= (*b).cap {
        buf_grow(b, (*b).len + 1)
    }
    if (*b).len < (*b).cap {
        st8((*b).ptr, (*b).len, v)
        (*b).len = (*b).len + 1
    }
}

fn buf_push_bytes(b: *mut Buf, p: u64, n: usize) {
    buf_reserve(b, (*b).len + n)
    if (*b).len + n > (*b).cap {
        return
    }
    mem_copy((*b).ptr + (*b).len as u64, p, n)
    (*b).len = (*b).len + n
}

// -------------------------------------------------------------- Zahl -> Text

fn buf_push_dec_u64(b: *mut Buf, v: u64) {
    if v == 0 {
        buf_push(b, 48 as u8)
        return
    }
    var d: [u8; 20] = [0 as u8; 20]
    var n: usize = 0
    var x: u64 = v
    while x > 0 {
        d[n] = (x % 10) as u8 + 48 as u8
        x = x / 10
        n = n + 1
    }
    while n > 0 {
        n = n - 1
        buf_push(b, d[n])
    }
}

fn buf_push_dec_i64(b: *mut Buf, v: i64) {
    if v < 0 {
        buf_push(b, 45 as u8)
        // Vorsicht am Rand: `-(i64::MIN)` passt nicht in i64, der Umweg ueber
        // u64 schon.
        buf_push_dec_u64(b, (0 - (v + 1)) as u64 + 1)
        return
    }
    buf_push_dec_u64(b, v as u64)
}

fn buf_push_hex_u64(b: *mut Buf, v: u64, min: usize) {
    var d: [u8; 16] = [0 as u8; 16]
    var n: usize = 0
    var x: u64 = v
    while x > 0 {
        let z: u64 = x & 15
        if z < 10 {
            d[n] = z as u8 + 48 as u8
        } else {
            d[n] = z as u8 + 87 as u8
        }
        x = x >> 4
        n = n + 1
    }
    while n < min {
        d[n] = 48 as u8
        n = n + 1
    }
    if n == 0 {
        buf_push(b, 48 as u8)
        return
    }
    while n > 0 {
        n = n - 1
        buf_push(b, d[n])
    }
}

// ------------------------------------------------------------- Ein-/Ausgabe

// Schreibt vollstaendig — ein `write` darf weniger schreiben als verlangt.
fn write_everything(fd: i64, p: u64, n: usize) -> bool {
    var written: usize = 0
    while written < n {
        let r: i64 = syscall(
            SYS_WRITE,
            fd,
            (p + written as u64) as i64,
            (n - written) as i64,
            0,
            0,
            0,
        )
        if r <= 0 {
            return false
        }
        written = written + r as usize
    }
    return true
}

// Liest einen Dateideskriptor bis zum Ende in den Puffer.
fn read_fd(fd: i64, out: *mut Buf) -> bool {
    var runs: bool = true
    while runs {
        buf_reserve(out, buf_len(out) + 65536)
        if buf_len(out) + 65536 > (*out).cap {
            return false
        }
        let r: i64 = syscall(
            SYS_READ,
            fd,
            (buf_ptr(out) + buf_len(out) as u64) as i64,
            65536,
            0,
            0,
            0,
        )
        if r < 0 {
            return false
        }
        if r == 0 {
            runs = false
        } else {
            (*out).len = (*out).len + r as usize
        }
    }
    return true
}

fn read_stdin(out: *mut Buf) -> bool {
    return read_fd(0, out)
}

// Liest eine ganze Datei. `pfad` zeigt auf eine mit Null abgeschlossene Folge.
fn read_file(path: u64, out: *mut Buf) -> bool {
    let fd: i64 = syscall(SYS_OPEN, path as i64, 0, 0, 0, 0, 0)
    if fd < 0 {
        return false
    }
    let ok: bool = read_fd(fd, out)
    syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0)
    return ok
}

fn finish(code: i64) {
    syscall(SYS_EXIT_GROUP, code, 0, 0, 0, 0, 0)
}

// ------------------------------------------------------- Aufrufargumente
//
// `fn main(start: u64) -> i32` bekommt den STARTBLOCK des Prozesses in `rdi`
// (`_start` legt `rsp` dorthin, codegen_x86.rs). Der Block sieht so aus:
//
//     [argc][argv0][argv1]..[argvN][0][envp0]..[0][auxv..]
//
// Alle Zeichenketten sind mit einem Nulloktett abgeschlossen — genau die Form,
// die `lies_datei` erwartet. Damit kann ein Firn-Programm eine Datei
// oeffnen, deren Namen es auf der Kommandozeile bekommen hat.

fn arg_count(start: u64) -> usize {
    if start == 0 {
        return 0
    }
    return ld64(start, 0) as usize
}

// Argument `i` (0 = der Programmname selbst). 0, wenn es keins gibt.
fn arg_ptr(start: u64, i: usize) -> u64 {
    if start == 0 || i >= arg_count(start) {
        return 0
    }
    return ld64(start, 1 + i)
}

// Laenge einer nullabgeschlossenen Zeichenkette.
fn c_length(p: u64) -> usize {
    if p == 0 {
        return 0
    }
    var n: usize = 0
    while ld8(p, n) != 0 as u8 {
        n = n + 1
    }
    return n
}

// ------------------------------------------------------- Datei schreiben
//
// `open` mit O_WRONLY|O_CREAT|O_TRUNC und Rechten 0755 — der Compiler legt
// damit sowohl die `.s`-Datei als auch (ueber `ld`) das Ergebnis an.

const O_SCHREIB: i64 = 577      // O_WRONLY|O_CREAT|O_TRUNC
const RECHTE: i64 = 493         // 0755

fn write_file(path: u64, p: u64, n: usize) -> bool {
    let fd: i64 = syscall(SYS_OPEN, path as i64, O_SCHREIB, RECHTE, 0, 0, 0)
    if fd < 0 {
        return false
    }
    let ok: bool = write_everything(fd, p, n)
    syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0)
    return ok
}

// ----------------------------------------------------------- Prozessstart
//
// Punkt 11 der Liste in `docs/SELBSTHOSTING.md`: ohne `fork`/`execve` kann ein
// Compiler `as` und `ld` nicht aufrufen — und dann ist er kein Compiler,
// sondern ein Textwerkzeug.
//
// `fork` heisst auf x86-64 `clone` mit denselben Kennzeichen wie
// `SIGCHLD` — der Systemaufruf `fork` (57) existiert aber weiterhin und ist
// hier der einfachere Weg.
//
// Rueckgabe: der ENDESTATUS des Kindes (0 = in Ordnung), oder -1.

const SYS_FORK: i64 = 57
const SYS_EXECVE: i64 = 59
const SYS_WAIT4: i64 = 61

fn run(path: u64, argv: u64) -> i64 {
    let kind: i64 = syscall(SYS_FORK, 0, 0, 0, 0, 0, 0)
    if kind < 0 {
        return -1
    }
    if kind == 0 {
        // Im Kind: das eigene Programm durch `pfad` ersetzen. Kommt `execve`
        // zurueck, ist es fehlgeschlagen — dann darf das Kind NICHT
        // weiterlaufen, sonst gaebe es den Compiler zweimal.
        syscall(SYS_EXECVE, path as i64, argv as i64, 0, 0, 0, 0)
        finish(127)
    }
    var status: i32 = 0
    let r: i64 = syscall(SYS_WAIT4, kind, (&status) as i64, 0, 0, 0, 0)
    if r < 0 {
        return -1
    }
    // Normales Ende: die oberen acht Bit des unteren Wortes sind der Code.
    if (status & 127) == 0 {
        return ((status >> 8) & 255) as i64
    }
    return -1
}

// Bequemer Aufruf mit bis zu drei Argumenten hinter dem Programmnamen.
// Alle Zeiger muessen auf NULLABGESCHLOSSENE Zeichenketten zeigen.
fn lauf3(path: u64, a1: u64, a2: u64, a3: u64) -> i64 {
    // argv ist ein nullabgeschlossenes Feld aus Zeigern.
    var field: [u64; 5] = [0; 5]
    field[0] = path
    var n: usize = 1
    if a1 != 0 {
        field[n] = a1
        n = n + 1
    }
    if a2 != 0 {
        field[n] = a2
        n = n + 1
    }
    if a3 != 0 {
        field[n] = a3
        n = n + 1
    }
    field[n] = 0
    return run(path, (&field[0]) as u64)
}
