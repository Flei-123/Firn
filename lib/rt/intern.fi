// SPDX-License-Identifier: MPL-2.0
// lib/rt/intern.fi -- mapping strings onto numbers.
//
// WHY THIS BELONGS WITH `Map`: `lib/rt/map.fi` has SCALAR keys. A name table
// of the compiler, however, has identifiers as keys. The Rust compiler solves
// it no differently -- `Interner` hands out one number per identifier, and
// everything after that computes with numbers. Only both building blocks
// together add up to point 3 of the list in `docs/SELF_HOSTING.md` 4.
//
// Two gains that go beyond "it works too":
//   * Comparing two identifiers is a comparison of two `u32` instead of a
//     run through a byte loop. The name resolver does that millions of times.
//   * Every identifier lies exactly ONCE in memory, no matter how often it
//     occurs inside the source.
//
// STRUCTURE: all bytes one after another inside an `rt.Buf`, plus offset and
// length per number inside two `Vec[u32]`. The lookup runs over a table of
// its own with open addressing that holds numbers instead of strings -- while
// probing, the text is compared, not the hash value. Hash collisions are
// therefore handled CORRECTLY and not merely made unlikely.
//
// THE HONEST LIMITS:
//   * There is no removal. An interner only ever grows -- for one compiler
//     run that is right, for a long running process it is not.
//   * `intern_ptr` is valid only until the next `intern_number`: the text
//     buffer may move. Whoever wants to keep the pointer makes a copy.

import rt
import vec

export { Interner, intern_new, intern_free, intern_number, intern_find,
    intern_ptr, intern_length, intern_count, intern_equal,
    intern_prefix, intern_ab, intern_hash_bytes }

struct Interner {
    text: rt.Buf, // all identifiers one after another
    off: Vec[u32], // offset into the text per number
    len: Vec[u32], // length per number
    slots: u64, // array of u32: 0 = empty, otherwise number + 1
    cap: usize, // a power of two, or 0
    cnt: usize,
}

const HASH_MUL: u64 = 11400714819323198485

#[inline]
fn intern_hash_bytes(p: u64, n: usize) -> u64 {
    let nn: u64 = n as u64
    var h: u64 = 14695981039346656037 as u64 ^ nn
    var i: usize = 0
    while i + 8 <= n {
        h = (h ^ *((p +% i as u64) as *mut u64)) *% HASH_MUL
        h = h ^ (h >> 29 as u64)
        i = i + 8
    }
    let left: usize = n - i
    if left >= 4 {
        let tail4: u64 = p +% nn -% 4
        let lo32: u32 = *((p +% i as u64) as *mut u32)
        let hi32: u32 = *(tail4 as *mut u32)
        let lo: u64 = lo32 as u64
        let hi: u64 = hi32 as u64
        h = (h ^ (lo | (hi << 32 as u64))) *% HASH_MUL
    } else if left >= 2 {
        let tail2: u64 = p +% nn -% 2
        let lo16: u16 = *((p +% i as u64) as *mut u16)
        let hi16: u16 = *(tail2 as *mut u16)
        let lo: u64 = lo16 as u64
        let hi: u64 = hi16 as u64
        h = (h ^ (lo | (hi << 16 as u64))) *% HASH_MUL
    } else if left == 1 {
        let b8: u8 = *((p +% i as u64) as *mut u8)
        h = (h ^ b8 as u64) *% HASH_MUL
    }
    return h ^ (h >> 31 as u64)
}

fn intern_new() -> Interner {
    return Interner {
        text: rt.buf_new(),
        off: vec_new[u32](),
        len: vec_new[u32](),
        slots: 0,
        cap: 0,
        cnt: 0,
    }
}

fn intern_free(t: *mut Interner) {
    rt.buf_free(&(*t).text)
    vec_free[u32](&(*t).off)
    vec_free[u32](&(*t).len)
    if (*t).cap > 0 {
        rt.heap_free((*t).slots, (*t).cap * 4)
    }
    (*t).slots = 0
    (*t).cap = 0
    (*t).cnt = 0
}

fn intern_count(t: *mut Interner) -> usize {
    return (*t).cnt
}

#[inline]
fn intern_length(t: *mut Interner, nr: u32) -> usize {
    if nr as usize >= (*t).cnt {
        return 0
    }
    let x: u32 = *(((*t).len.ptr +% nr as u64 *% 4) as *mut u32)
    return x as usize
}

// VALID ONLY UNTIL THE NEXT `intern_number` -- the text buffer may move.
#[inline]
fn intern_ptr(t: *mut Interner, nr: u32) -> u64 {
    if nr as usize >= (*t).cnt {
        return 0
    }
    let x: u32 = *(((*t).off.ptr +% nr as u64 *% 4) as *mut u32)
    return (*t).text.ptr + x as u64
}

// ROUND 45: does the name start with these bytes? Needed for the compiler
// internal prefixes (`"method "`) that tell a call name apart from an
// identifier of the source text.
fn intern_prefix(t: *mut Interner, nr: u32, p: u64, n: usize) -> bool {
    if intern_length(t, nr) < n {
        return false
    }
    return rt.mem_eq(intern_ptr(t, nr), p, n)
}

// The name FROM byte `of` onwards, as a number of its own. The text is copied
// out FIRST: `intern_number` can make the text buffer move, and after that
// `intern_ptr` would point at nothing (see the comment at the top of the file).
fn intern_ab(t: *mut Interner, nr: u32, of: usize) -> u32 {
    let len: usize = intern_length(t, nr)
    if of < len {
        let src: u64 = intern_ptr(t, nr) +% of as u64
        let rest: usize = len - of
        let known: i64 = intern_find_hashed(t, src, rest, intern_hash_bytes(src, rest))
        if known >= 0 {
            return known as u32
        }
    }
    var b: rt.Buf = rt.buf_new()
    if of < len {
        rt.buf_push_bytes(&b, intern_ptr(t, nr) + of as u64, len - of)
    }
    let r: u32 = intern_number(t, rt.buf_ptr(&b), rt.buf_len(&b)) as u32
    rt.buf_free(&b)
    return r
}

#[inline]
fn intern_equal(t: *mut Interner, nr: u32, p: u64, n: usize) -> bool {
    if nr as usize >= (*t).cnt {
        return n == 0
    }
    let x: u32 = *(((*t).len.ptr +% nr as u64 *% 4) as *mut u32)
    if x as usize != n {
        return false
    }
    let o: u32 = *(((*t).off.ptr +% nr as u64 *% 4) as *mut u32)
    return rt.mem_eq((*t).text.ptr + o as u64, p, n)
}

// Creates the probe table anew and enters every existing number into it.
fn intern_grow(t: *mut Interner, new_cap: usize) -> bool {
    var cap: usize = 16
    while cap < new_cap {
        cap = cap * 2
    }
    let field: u64 = rt.heap_alloc(cap * 4)
    if field == 0 {
        return false
    }
    rt.mem_set(field, 0 as u8, cap * 4)
    let mask: u64 = cap as u64 - 1
    var nr: usize = 0
    while nr < (*t).cnt {
        let p: u64 = rt.buf_ptr(&(*t).text) + vec_at[u32](&(*t).off, nr) as u64
        let n: usize = vec_at[u32](&(*t).len, nr) as usize
        var i: u64 = intern_hash_bytes(p, n) & mask
        while rt.ld32(field, i as usize) != 0 as u32 {
            i = (i + 1) & mask
        }
        rt.st32(field, i as usize, nr as u32 + 1)
        nr = nr + 1
    }
    if (*t).cap > 0 {
        rt.heap_free((*t).slots, (*t).cap * 4)
    }
    (*t).slots = field
    (*t).cap = cap
    return true
}

// The number of an already known text; `-1` if it is missing. Unlike
// `intern_number` this creates NOTHING -- the name resolver needs exactly
// that when it only asks whether an identifier occurs at all.
#[inline]
fn intern_find_hashed(t: *mut Interner, p: u64, n: usize, h: u64) -> i64 {
    let cap: usize = (*t).cap
    if cap == 0 {
        return -1
    }
    let mask: u64 = cap as u64 -% 1
    let slots: u64 = (*t).slots
    let lens: u64 = (*t).len.ptr
    let offs: u64 = (*t).off.ptr
    let text: u64 = (*t).text.ptr
    var i: u64 = h & mask
    while true {
        let e: u32 = *((slots +% i *% 4) as *mut u32)
        if e == 0 as u32 {
            return -1
        }
        let nr: u64 = e as u64 -% 1
        let ln: u32 = *((lens +% nr *% 4) as *mut u32)
        if ln as usize == n {
            let o: u32 = *((offs +% nr *% 4) as *mut u32)
            if rt.mem_eq(text +% o as u64, p, n) {
                return nr as i64
            }
        }
        i = (i +% 1) & mask
    }
    return -1
}

fn intern_find(t: *mut Interner, p: u64, n: usize) -> i64 {
    if (*t).cap == 0 {
        return -1
    }
    return intern_find_hashed(t, p, n, intern_hash_bytes(p, n))
}

// Returns the number of the text -- existing or newly created.
// On lack of memory `-1`.
fn intern_number(t: *mut Interner, p: u64, n: usize) -> i64 {
    let h: u64 = intern_hash_bytes(p, n)
    let da: i64 = intern_find_hashed(t, p, n, h)
    if da >= 0 {
        return da
    }
    return intern_insert(t, p, n, h)
}

#[no_inline]
fn intern_insert(t: *mut Interner, p: u64, n: usize, h: u64) -> i64 {
    if ((*t).cnt + 1) * 4 > (*t).cap * 3 {
        if !intern_grow(t, (*t).cnt * 2 + 16) {
            return -1
        }
    }
    let offset: usize = rt.buf_len(&(*t).text)
    rt.buf_push_bytes(&(*t).text, p, n)
    if !vec_push[u32](&(*t).off, offset as u32) {
        return -1
    }
    if !vec_push[u32](&(*t).len, n as u32) {
        return -1
    }
    let nr: u32 = (*t).cnt as u32
    (*t).cnt = (*t).cnt + 1

    // CAREFUL: the hash has to be taken from our OWN buffer AFTER the copy
    // -- `p` may have been lying inside that same buffer and may have moved.
    let mask: u64 = (*t).cap as u64 - 1
    var i: u64 = h & mask
    while rt.ld32((*t).slots, i as usize) != 0 as u32 {
        i = (i + 1) & mask
    }
    rt.st32((*t).slots, i as usize, nr + 1 as u32)
    return nr as i64
}
