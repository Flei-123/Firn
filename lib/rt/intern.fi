// lib/rt/intern.fi — Zeichenketten auf Nummern abbilden.
//
// WARUM DAS ZU `Map` GEHOERT: `lib/rt/map.fi` hat SKALARE Schluessel. Eine
// Namenstabelle des Compilers hat aber Bezeichner als Schluessel. Der Rust-
// Compiler loest das nicht anders — `Interner` vergibt je Bezeichner eine
// Nummer, und alles danach rechnet mit Nummern. Erst beide Bausteine zusammen
// ergeben Punkt 3 der Liste in `docs/SELBSTHOSTING.md` §4.
//
// Zwei Gewinne, die ueber "geht auch" hinausgehen:
//   * Vergleich zweier Bezeichner ist ein Vergleich zweier `u32` statt eines
//     Byteschleifendurchlaufs. Der Namensaufloeser macht davon Millionen.
//   * Jeder Bezeichner liegt genau EINMAL im Speicher, egal wie oft er in der
//     Quelle steht.
//
// AUFBAU: alle Bytes hintereinander in einem `rt.Buf`, dazu Versatz und Laenge
// je Nummer in zwei `Vec[u32]`. Die Suche laeuft ueber eine eigene Tabelle mit
// offener Adressierung, die Nummern statt Zeichenketten haelt — beim Sondieren
// wird der Text verglichen, nicht der Hashwert. Damit sind Hashkollisionen
// KORREKT behandelt und nicht nur unwahrscheinlich.
//
// EHRLICHE GRENZEN:
//   * Es gibt kein Entfernen. Ein Interner waechst nur — fuer einen
//     Compilerlauf ist das richtig, fuer einen Dauerlaeufer nicht.
//   * `intern_zeiger` ist nur bis zum naechsten `intern_nummer` gueltig: der
//     Textpuffer kann umziehen. Wer den Zeiger behalten will, kopiert.

import rt
import vec

export { Interner, intern_neu, intern_frei, intern_nummer, intern_finde,
         intern_zeiger, intern_laenge, intern_anzahl, intern_gleich,
         intern_praefix, intern_ab, intern_hash_bytes }

struct Interner {
    text: rt.Buf,      // alle Bezeichner hintereinander
    off: Vec[u32],     // Versatz im Text je Nummer
    laen: Vec[u32],    // Laenge je Nummer
    plaetze: u64,      // Feld aus u32: 0 = leer, sonst Nummer + 1
    kap: usize,        // Zweierpotenz oder 0
    anz: usize,
}

// FNV-1a, 64 Bit. Byteweise, kein Tabellenzugriff — fuer Bezeichner (meist
// unter 16 Byte) schlaegt das jedes blockweise Verfahren, weil dort der
// Ueberhang fuer den Rest groesser ist als die Ersparnis.
fn intern_hash_bytes(p: u64, n: usize) -> u64 {
    var h: u64 = 14695981039346656037 as u64
    var i: usize = 0
    while i < n {
        h = h ^ rt.ld8(p, i) as u64
        h = h * 1099511628211 as u64
        i = i + 1
    }
    return h
}

fn intern_neu() -> Interner {
    return Interner{
        text: rt.buf_neu(),
        off: vec_neu[u32](),
        laen: vec_neu[u32](),
        plaetze: 0,
        kap: 0,
        anz: 0,
    }
}

fn intern_frei(t: *mut Interner) {
    rt.buf_frei(&(*t).text)
    vec_frei[u32](&(*t).off)
    vec_frei[u32](&(*t).laen)
    if (*t).kap > 0 {
        rt.heap_free((*t).plaetze, (*t).kap * 4)
    }
    (*t).plaetze = 0
    (*t).kap = 0
    (*t).anz = 0
}

fn intern_anzahl(t: *mut Interner) -> usize {
    return (*t).anz
}

fn intern_laenge(t: *mut Interner, nr: u32) -> usize {
    if nr as usize >= (*t).anz {
        return 0
    }
    return vec_at[u32](&(*t).laen, nr as usize) as usize
}

// GUELTIG BIS ZUM NAECHSTEN `intern_nummer` — der Textpuffer kann umziehen.
fn intern_zeiger(t: *mut Interner, nr: u32) -> u64 {
    if nr as usize >= (*t).anz {
        return 0
    }
    return rt.buf_ptr(&(*t).text) + vec_at[u32](&(*t).off, nr as usize) as u64
}

// RUNDE 45: Beginnt der Name mit diesen Bytes? Gebraucht fuer die
// compilerinternen Praefixe (`"methode "`), die einen Aufrufnamen von einem
// Bezeichner des Quelltextes unterscheiden.
fn intern_praefix(t: *mut Interner, nr: u32, p: u64, n: usize) -> bool {
    if intern_laenge(t, nr) < n {
        return false
    }
    return rt.mem_eq(intern_zeiger(t, nr), p, n)
}

// Der Name AB dem Byte `von`, als eigene Nummer. Der Text wird ZUERST
// herauskopiert: `intern_nummer` kann den Textpuffer umziehen lassen, und
// dann zeigte `intern_zeiger` ins Leere (Kommentar am Dateikopf).
fn intern_ab(t: *mut Interner, nr: u32, von: usize) -> u32 {
    let laen: usize = intern_laenge(t, nr)
    var b: rt.Buf = rt.buf_neu()
    if von < laen {
        rt.buf_push_bytes(&b, intern_zeiger(t, nr) + von as u64, laen - von)
    }
    let r: u32 = intern_nummer(t, rt.buf_ptr(&b), rt.buf_len(&b)) as u32
    rt.buf_frei(&b)
    return r
}

fn intern_gleich(t: *mut Interner, nr: u32, p: u64, n: usize) -> bool {
    if intern_laenge(t, nr) != n {
        return false
    }
    return rt.mem_eq(intern_zeiger(t, nr), p, n)
}

// Legt die Sondiertabelle neu an und traegt alle vorhandenen Nummern ein.
fn intern_wachse(t: *mut Interner, neu_kap: usize) -> bool {
    var kap: usize = 16
    while kap < neu_kap {
        kap = kap * 2
    }
    let feld: u64 = rt.heap_alloc(kap * 4)
    if feld == 0 {
        return false
    }
    rt.mem_set(feld, 0 as u8, kap * 4)
    let maske: u64 = kap as u64 - 1
    var nr: usize = 0
    while nr < (*t).anz {
        let p: u64 = rt.buf_ptr(&(*t).text) + vec_at[u32](&(*t).off, nr) as u64
        let n: usize = vec_at[u32](&(*t).laen, nr) as usize
        var i: u64 = intern_hash_bytes(p, n) & maske
        while rt.ld32(feld, i as usize) != 0 as u32 {
            i = (i + 1) & maske
        }
        rt.st32(feld, i as usize, nr as u32 + 1)
        nr = nr + 1
    }
    if (*t).kap > 0 {
        rt.heap_free((*t).plaetze, (*t).kap * 4)
    }
    (*t).plaetze = feld
    (*t).kap = kap
    return true
}

// Nummer eines bereits bekannten Textes; `-1`, wenn er fehlt. Anders als
// `intern_nummer` legt das NICHTS an — der Namensaufloeser braucht genau das,
// wenn er nur fragt, ob ein Bezeichner ueberhaupt vorkommt.
fn intern_finde(t: *mut Interner, p: u64, n: usize) -> i64 {
    if (*t).kap == 0 {
        return -1
    }
    let maske: u64 = (*t).kap as u64 - 1
    var i: u64 = intern_hash_bytes(p, n) & maske
    var schritte: usize = 0
    while schritte < (*t).kap {
        let e: u32 = rt.ld32((*t).plaetze, i as usize)
        if e == 0 as u32 {
            return -1
        }
        let nr: u32 = e - 1 as u32
        if intern_gleich(t, nr, p, n) {
            return nr as i64
        }
        i = (i + 1) & maske
        schritte = schritte + 1
    }
    return -1
}

// Liefert die Nummer des Textes — vorhanden oder neu angelegt.
// Bei Speichermangel `-1`.
fn intern_nummer(t: *mut Interner, p: u64, n: usize) -> i64 {
    let da: i64 = intern_finde(t, p, n)
    if da >= 0 {
        return da
    }
    if ((*t).anz + 1) * 4 > (*t).kap * 3 {
        if !intern_wachse(t, (*t).anz * 2 + 16) {
            return -1
        }
    }
    let versatz: usize = rt.buf_len(&(*t).text)
    rt.buf_push_bytes(&(*t).text, p, n)
    if !vec_push[u32](&(*t).off, versatz as u32) {
        return -1
    }
    if !vec_push[u32](&(*t).laen, n as u32) {
        return -1
    }
    let nr: u32 = (*t).anz as u32
    (*t).anz = (*t).anz + 1

    // ACHTUNG: der Hash muss NACH dem Kopieren aus dem EIGENEN Puffer kommen
    // — `p` darf inzwischen im selben Puffer gelegen haben und umgezogen sein.
    let maske: u64 = (*t).kap as u64 - 1
    let ep: u64 = intern_zeiger(t, nr)
    var i: u64 = intern_hash_bytes(ep, n) & maske
    while rt.ld32((*t).plaetze, i as usize) != 0 as u32 {
        i = (i + 1) & maske
    }
    rt.st32((*t).plaetze, i as usize, nr + 1 as u32)
    return nr as i64
}
