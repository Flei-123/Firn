// lib/rt/map.fi — `Map[K, V]`: Hash-Abbildung mit offener Adressierung.
//
// `docs/SELBSTHOSTING.md` §4 fuehrt dies als Punkt 3 der Blockerliste, direkt
// hinter Allokator und `Vec[T]`. Der Compiler braucht sie ueberall dort, wo
// ein Name auf etwas zeigt: `fns`, `consts`, `structs`, die Bereichsketten des
// Namensaufloesers, die Beschriftungstabelle des Codegenerators.
//
// AUFBAU — offene Adressierung mit linearer Sondierung, nicht Verkettung:
//   * drei getrennte Felder (Schluessel, Werte, Zustand) statt eines Feldes
//     aus Paaren. Das spart die Ausrichtungsloecher, die bei `struct { K, V }`
//     mit ungleichen Groessen entstehen, und der Zustand liegt dicht — die
//     Sondierschleife liest nur ein Byte je Schritt.
//   * Kapazitaet ist immer eine Zweierpotenz, damit `hash & (kap-1)` das
//     Modulo ersetzt (eine Und-Verknuepfung statt einer Division).
//   * Lastgrenze 3/4. Darueber wird verdoppelt und neu eingestreut.
//
// ZUSTAND je Platz: 0 = leer (nie belegt), 1 = belegt, 2 = geloescht.
// Der Unterschied zwischen 0 und 2 ist wesentlich: eine Suche darf bei 2
// NICHT abbrechen, sonst verliert sie Eintraege, die hinter einer Loeschung
// liegen. Bei 0 darf sie abbrechen — dort war nie etwas.
//
// EHRLICHE GRENZEN:
//   * `K` und `V` sind Skalare. Zeichenketten als Schluessel gehen ueber ihre
//     interne Nummer (`Map[u32, …]`) — genau so macht es der Rust-Compiler
//     mit `Interner` auch.
//   * Es gibt keinen Nullwert-Schutz: `map_hol` liefert bei fehlendem
//     Schluessel `0 as V`. Wer 0 von "fehlt" unterscheiden muss, nimmt
//     `map_hat` davor.
//   * Firn hat keine Zerstoerer — `map_frei` ist Pflicht, am besten mit
//     `defer` direkt hinter `map_neu`.

import rt

export { Map, map_neu, map_frei, map_leeren, map_setzen, map_hol, map_hat,
         map_loeschen, map_len, map_kap, map_reserve,
         map_platz_belegt, map_platz_schluessel, map_platz_wert, map_hash,
         // Runde 42
         map_ist_leer, map_tot, map_naechster, map_erstes, map_hol_oder,
         map_hol_wenn, map_wert_adresse, map_setzen_wenn_neu, map_erhoehen,
         map_nehmen, map_aufraeumen }

struct Map[K, V] {
    schluessel: u64,   // Feld aus K, `kap` Eintraege
    werte: u64,        // Feld aus V, `kap` Eintraege
    zustand: u64,      // Feld aus u8, `kap` Eintraege
    kap: usize,        // immer Zweierpotenz oder 0
    len: usize,        // belegte Plaetze
    tot: usize,        // geloeschte Plaetze (Grabsteine)
}

// Streuung nach dem Vorbild von splitmix64: zwei Schiebe-Xor-Runden um eine
// Multiplikation mit einer ungeraden Konstante.
//
// GEMESSEN, nicht behauptet (20.000 Schluessel, 32.768 Plaetze, Last 0,61;
// mittlere Sondierschritte je Einfuegung / laengste Kette):
//
//   Schluesselmuster        mit Streuung      ohne (Schluessel = Platz)
//   fortlaufend k            1,80 /  38          1,00 /      1
//   k * 1024 (Zeiger)        1,76 /  37        313,00 /    625
//   k * 65536                1,62 /  39      10000,50 /  20000
//   k << 32 (hohe Bits)      1,80 /  53      10000,50 /  20000
//
// Die Streuung ist also NICHT umsonst: bei fortlaufenden Nummern kostet sie
// 0,8 Sondierschritte gegenueber dem Idealfall. Sie kauft damit die Sicherheit,
// dass die Tabelle bei Schluesseln, die sich nur in hohen Bits unterscheiden —
// Zeiger, ausgerichtete Adressen, verschobene Nummern — nicht zur linearen
// Suche entartet. 0,8 gegen 10.000 ist kein knapper Abwaegungsfall.
fn map_hash[K: Scalar](k: K) -> u64 {
    var x: u64 = k as u64
    x = x ^ (x >> 33)
    x = x * 14181476777654086739 as u64
    x = x ^ (x >> 29)
    x = x * 12297829382473034411 as u64
    x = x ^ (x >> 32)
    return x
}

fn map_neu[K: Scalar, V: Scalar]() -> Map[K, V] {
    return Map[K, V]{ schluessel: 0, werte: 0, zustand: 0, kap: 0, len: 0, tot: 0 }
}

fn map_frei[K: Scalar, V: Scalar](m: *mut Map[K, V]) {
    if (*m).kap > 0 {
        rt.heap_free((*m).schluessel, (*m).kap * size_of[K]())
        rt.heap_free((*m).werte, (*m).kap * size_of[V]())
        rt.heap_free((*m).zustand, (*m).kap)
    }
    (*m).schluessel = 0
    (*m).werte = 0
    (*m).zustand = 0
    (*m).kap = 0
    (*m).len = 0
    (*m).tot = 0
}

// Behaelt den Speicher, setzt nur alle Plaetze auf `leer`. Fuer eine
// Bereichstabelle, die je Funktion neu gefuellt wird, ist das der richtige
// Weg — kein mmap je Funktion.
fn map_leeren[K: Scalar, V: Scalar](m: *mut Map[K, V]) {
    if (*m).kap > 0 {
        rt.mem_set((*m).zustand, 0 as u8, (*m).kap)
    }
    (*m).len = 0
    (*m).tot = 0
}

fn map_len[K: Scalar, V: Scalar](m: *mut Map[K, V]) -> usize {
    return (*m).len
}

fn map_kap[K: Scalar, V: Scalar](m: *mut Map[K, V]) -> usize {
    return (*m).kap
}

fn map_platz_belegt[K: Scalar, V: Scalar](m: *mut Map[K, V], i: usize) -> bool {
    if i >= (*m).kap {
        return false
    }
    return rt.ld8((*m).zustand, i) == 1 as u8
}

fn map_platz_schluessel[K: Scalar, V: Scalar](m: *mut Map[K, V], i: usize) -> K {
    if i >= (*m).kap {
        return 0 as K
    }
    let adr: u64 = (*m).schluessel + i as u64 * size_of[K]() as u64
    return *(adr as *mut K)
}

fn map_platz_wert[K: Scalar, V: Scalar](m: *mut Map[K, V], i: usize) -> V {
    if i >= (*m).kap {
        return 0 as V
    }
    let adr: u64 = (*m).werte + i as u64 * size_of[V]() as u64
    return *(adr as *mut V)
}

// Sucht den Platz eines Schluessels. Rueckgabe `kap` = nicht vorhanden.
// Bricht bei Zustand 0 ab, laeuft ueber Zustand 2 hinweg.
fn map_finde[K: Scalar, V: Scalar](m: *mut Map[K, V], k: K) -> usize {
    if (*m).kap == 0 {
        return 0
    }
    let maske: u64 = (*m).kap as u64 - 1
    var i: u64 = map_hash[K](k) & maske
    var schritte: usize = 0
    while schritte < (*m).kap {
        let z: u8 = rt.ld8((*m).zustand, i as usize)
        if z == 0 as u8 {
            return (*m).kap
        }
        if z == 1 as u8 {
            let adr: u64 = (*m).schluessel + i * size_of[K]() as u64
            if *(adr as *mut K) == k {
                return i as usize
            }
        }
        i = (i + 1) & maske
        schritte = schritte + 1
    }
    return (*m).kap
}

fn map_hat[K: Scalar, V: Scalar](m: *mut Map[K, V], k: K) -> bool {
    return map_finde[K, V](m, k) < (*m).kap
}

fn map_hol[K: Scalar, V: Scalar](m: *mut Map[K, V], k: K) -> V {
    let i: usize = map_finde[K, V](m, k)
    if i >= (*m).kap {
        return 0 as V
    }
    let adr: u64 = (*m).werte + i as u64 * size_of[V]() as u64
    return *(adr as *mut V)
}

// Legt ein Paar ohne jede Pruefung ab. Nur fuer `map_wachse`, wo feststeht,
// dass der Schluessel neu ist und Platz da ist.
fn map_roh_setzen[K: Scalar, V: Scalar](m: *mut Map[K, V], k: K, v: V) {
    let maske: u64 = (*m).kap as u64 - 1
    var i: u64 = map_hash[K](k) & maske
    while rt.ld8((*m).zustand, i as usize) == 1 as u8 {
        i = (i + 1) & maske
    }
    let ka: u64 = (*m).schluessel + i * size_of[K]() as u64
    *(ka as *mut K) = k
    let va: u64 = (*m).werte + i * size_of[V]() as u64
    *(va as *mut V) = v
    rt.st8((*m).zustand, i as usize, 1 as u8)
}

// Baut die Tabelle mit `neu_kap` Plaetzen neu auf. Das raeumt zugleich alle
// Grabsteine weg — deshalb wird auch dann neu gebaut, wenn die Kapazitaet
// gleich bleibt und nur `tot` zu gross geworden ist.
fn map_wachse[K: Scalar, V: Scalar](m: *mut Map[K, V], neu_kap: usize) -> bool {
    var kap: usize = 8
    while kap < neu_kap {
        kap = kap * 2
    }
    let sk: u64 = rt.heap_alloc(kap * size_of[K]())
    if sk == 0 {
        return false
    }
    let sw: u64 = rt.heap_alloc(kap * size_of[V]())
    if sw == 0 {
        rt.heap_free(sk, kap * size_of[K]())
        return false
    }
    let sz: u64 = rt.heap_alloc(kap)
    if sz == 0 {
        rt.heap_free(sk, kap * size_of[K]())
        rt.heap_free(sw, kap * size_of[V]())
        return false
    }
    rt.mem_set(sz, 0 as u8, kap)

    // Alte Tabelle merken, neue einhaengen, dann umstreuen.
    let alt_k: u64 = (*m).schluessel
    let alt_v: u64 = (*m).werte
    let alt_z: u64 = (*m).zustand
    let alt_kap: usize = (*m).kap

    (*m).schluessel = sk
    (*m).werte = sw
    (*m).zustand = sz
    (*m).kap = kap
    (*m).len = 0
    (*m).tot = 0

    var i: usize = 0
    while i < alt_kap {
        if rt.ld8(alt_z, i) == 1 as u8 {
            let ka: u64 = alt_k + i as u64 * size_of[K]() as u64
            let va: u64 = alt_v + i as u64 * size_of[V]() as u64
            map_roh_setzen[K, V](m, *(ka as *mut K), *(va as *mut V))
            (*m).len = (*m).len + 1
        }
        i = i + 1
    }

    if alt_kap > 0 {
        rt.heap_free(alt_k, alt_kap * size_of[K]())
        rt.heap_free(alt_v, alt_kap * size_of[V]())
        rt.heap_free(alt_z, alt_kap)
    }
    return true
}

fn map_reserve[K: Scalar, V: Scalar](m: *mut Map[K, V], n: usize) -> bool {
    // Lastgrenze 3/4: fuer `n` Eintraege braucht es mindestens 4n/3 Plaetze.
    if (*m).kap * 3 >= (n + (*m).len) * 4 {
        return true
    }
    return map_wachse[K, V](m, (n + (*m).len) * 4 / 3 + 1)
}

// Legt ab oder ueberschreibt. `false` heisst: Speicher aus.
fn map_setzen[K: Scalar, V: Scalar](m: *mut Map[K, V], k: K, v: V) -> bool {
    // Vorhandenen Schluessel zuerst — dann waechst nichts.
    let da: usize = map_finde[K, V](m, k)
    if da < (*m).kap {
        let va: u64 = (*m).werte + da as u64 * size_of[V]() as u64
        *(va as *mut V) = v
        return true
    }
    // Lastgrenze 3/4, Grabsteine zaehlen mit: sie belegen einen Platz, den die
    // Sondierschleife durchlaufen muss. Ohne das entartet eine Tabelle, in die
    // dauernd eingefuegt und geloescht wird, zur linearen Suche.
    if ((*m).len + (*m).tot + 1) * 4 > (*m).kap * 3 {
        if !map_wachse[K, V](m, (*m).len * 2 + 8) {
            return false
        }
    }
    let maske: u64 = (*m).kap as u64 - 1
    var i: u64 = map_hash[K](k) & maske
    while rt.ld8((*m).zustand, i as usize) == 1 as u8 {
        i = (i + 1) & maske
    }
    // Ein Grabstein wird ueberschrieben — er zaehlt danach nicht mehr als tot.
    if rt.ld8((*m).zustand, i as usize) == 2 as u8 {
        (*m).tot = (*m).tot - 1
    }
    let ka: u64 = (*m).schluessel + i * size_of[K]() as u64
    *(ka as *mut K) = k
    let va: u64 = (*m).werte + i * size_of[V]() as u64
    *(va as *mut V) = v
    rt.st8((*m).zustand, i as usize, 1 as u8)
    (*m).len = (*m).len + 1
    return true
}

// `true`, wenn wirklich etwas entfernt wurde.
fn map_loeschen[K: Scalar, V: Scalar](m: *mut Map[K, V], k: K) -> bool {
    let i: usize = map_finde[K, V](m, k)
    if i >= (*m).kap {
        return false
    }
    rt.st8((*m).zustand, i, 2 as u8)
    (*m).len = (*m).len - 1
    (*m).tot = (*m).tot + 1
    return true
}

// =====================================================================
// Runde 42 — der Ausbau. Wie bei `Vec[T]` ist alles GENERISCH und wird nur
// zu Code, wenn ein Programm es benutzt.
//
// ITERATION OHNE `Vec`: `lib/rt/map.fi` bindet bewusst kein `vec` ein — ein
// zweiter Import in einem Modul, das der Compiler selbst benutzt, ist
// Gewicht ohne Gegenwert, und `firnc1` dedupliziert Importpfade als
// Zeichenkette (Runde 39). Statt "gib mir alle Schluessel als Feld" gibt es
// darum einen KURSOR ueber die Plaetze:
//
//     var i: usize = map_naechster[K, V](&m, 0)
//     while i < map_kap[K, V](&m) {
//         let k: K = map_platz_schluessel[K, V](&m, i)
//         let w: V = map_platz_wert[K, V](&m, i)
//         i = map_naechster[K, V](&m, i + 1)
//     }
//
// Wer die Schluessel doch als Feld will, schiebt sie in dieser Schleife in
// ein `Vec[K]` — dann steht der Import beim Aufrufer, wo er hingehoert.
//
// WARNUNG, wie sie fuer jede offene Adressierung gilt: waehrend der
// Iteration NICHT einfuegen. Ein Einfuegen kann die Tabelle neu streuen,
// und dann zeigt der Kursor irgendwohin. Loeschen ist unbedenklich.
// =====================================================================

fn map_ist_leer[K: Scalar, V: Scalar](m: *mut Map[K, V]) -> bool {
    return (*m).len == 0
}

// Zahl der Grabsteine. Diagnose: steigt sie ohne Ende, hilft
// `map_aufraeumen`.
fn map_tot[K: Scalar, V: Scalar](m: *mut Map[K, V]) -> usize {
    return (*m).tot
}

// Erster belegter Platz mit Index >= `ab`; `kap`, wenn keiner mehr kommt.
fn map_naechster[K: Scalar, V: Scalar](m: *mut Map[K, V], ab: usize) -> usize {
    var i: usize = ab
    while i < (*m).kap {
        if rt.ld8((*m).zustand, i) == 1 as u8 {
            return i
        }
        i = i + 1
    }
    return (*m).kap
}

fn map_erstes[K: Scalar, V: Scalar](m: *mut Map[K, V]) -> usize {
    return map_naechster[K, V](m, 0)
}

// Wert oder Vorgabe. Der Unterschied zu `map_hol`: dort ist der Nullwert
// die Antwort auf "fehlt", hier waehlt ihn der Aufrufer.
fn map_hol_oder[K: Scalar, V: Scalar](m: *mut Map[K, V], k: K, vorgabe: V) -> V {
    let i: usize = map_finde[K, V](m, k)
    if i >= (*m).kap {
        return vorgabe
    }
    let adr: u64 = (*m).werte + i as u64 * size_of[V]() as u64
    return *(adr as *mut V)
}

// Holen und zugleich wissen, ob es da war — spart das zweite Sondieren, das
// `map_hat` + `map_hol` kostet.
fn map_hol_wenn[K: Scalar, V: Scalar](m: *mut Map[K, V], k: K, aus: *mut V) -> bool {
    let i: usize = map_finde[K, V](m, k)
    if i >= (*m).kap {
        return false
    }
    let adr: u64 = (*m).werte + i as u64 * size_of[V]() as u64
    *aus = *(adr as *mut V)
    return true
}

// Adresse des Wertes, 0 wenn der Schluessel fehlt. Damit laesst sich ein
// Wert AN ORT UND STELLE aendern, ohne zweimal zu sondieren.
// NUR GUELTIG, bis die Tabelle das naechste Mal waechst.
fn map_wert_adresse[K: Scalar, V: Scalar](m: *mut Map[K, V], k: K) -> u64 {
    let i: usize = map_finde[K, V](m, k)
    if i >= (*m).kap {
        return 0
    }
    return (*m).werte + i as u64 * size_of[V]() as u64
}

// Nur einfuegen, wenn der Schluessel neu ist. `eingefuegt` sagt, ob wirklich
// etwas dazukam; der Rueckgabewert sagt (wie ueberall hier), ob es an
// Speicher fehlte.
fn map_setzen_wenn_neu[K: Scalar, V: Scalar](m: *mut Map[K, V], k: K, v: V,
                                             eingefuegt: *mut bool) -> bool {
    *eingefuegt = false
    if map_finde[K, V](m, k) < (*m).kap {
        return true
    }
    if !map_setzen[K, V](m, k, v) {
        return false
    }
    *eingefuegt = true
    return true
}

// Das Zaehl-Muster in einem Aufruf: fehlt der Schluessel, wird `delta`
// eingetragen, sonst wird `delta` aufaddiert. Rueckgabe ist der NEUE Wert.
// Bei Speichermangel bleibt die Tabelle unveraendert und die Antwort ist der
// alte Wert (bzw. der Nullwert).
fn map_erhoehen[K: Scalar, V: Scalar](m: *mut Map[K, V], k: K, delta: V) -> V {
    let adr: u64 = map_wert_adresse[K, V](m, k)
    if adr != 0 {
        let neu: V = *(adr as *mut V) + delta
        *(adr as *mut V) = neu
        return neu
    }
    if !map_setzen[K, V](m, k, delta) {
        return 0 as V
    }
    return delta
}

// Holen und entfernen in einem Schritt.
fn map_nehmen[K: Scalar, V: Scalar](m: *mut Map[K, V], k: K, aus: *mut V) -> bool {
    if !map_hol_wenn[K, V](m, k, aus) {
        return false
    }
    return map_loeschen[K, V](m, k)
}

// Grabsteine wegraeumen, Kapazitaet beibehalten. Nach vielen Loeschungen
// wird die Sondierung sonst immer laenger, ohne dass die Tabelle waechst.
fn map_aufraeumen[K: Scalar, V: Scalar](m: *mut Map[K, V]) -> bool {
    if (*m).tot == 0 || (*m).kap == 0 {
        return true
    }
    return map_wachse[K, V](m, (*m).kap)
}
