// SPDX-License-Identifier: MIT
// lib/brigadier/suggest.fi -- brigadier.suggest: Suggestion, SuggestionsBuilder and Suggestions (java.util.HashSet order, TimSort insertion order for small lists).
import brigadier.mem as m
import brigadier.text as tx
import brigadier.casing as cs

export { Sugg, SuggBuilder, Suggestions, sb_new, sb_suggest, sb_suggest_int, sb_build, sb_remaining_lower, sugg_apply,
    suggestions_empty, suggestions_create, suggestions_merge, hash_set_order }

struct Sugg {
    start: usize,
    end: usize,
    text: tx.U16,
    is_int: bool,
    ival: i32,
}

struct SuggBuilder {
    a: *mut m.Arena,
    input: tx.U16,
    input_lower: tx.U16,
    start: usize,
    remaining: tx.U16,
    remaining_lower: tx.U16,
    result: m.Arr[Sugg],
}

struct Suggestions {
    start: usize,
    end: usize,
    list: m.Arr[Sugg],
}

fn sb_new(a: *mut m.Arena, input: tx.U16, input_lower: tx.U16, start: usize) -> SuggBuilder {
    return SuggBuilder {
        a: a,
        input: input,
        input_lower: input_lower,
        start: start,
        remaining: tx.u16_sub(input, start, input.n),
        remaining_lower: tx.u16_sub(input_lower, start, input_lower.n),
        result: m.arr_new[Sugg](),
    }
}

fn sb_remaining_lower(b: *mut SuggBuilder) -> tx.U16 {
    return (*b).remaining_lower
}

fn sb_suggest(b: *mut SuggBuilder, text: tx.U16) {
    if tx.u16_eq(text, (*b).remaining) {
        return
    }
    m.arr_push[Sugg]((*b).a, &(*b).result, Sugg { start: (*b).start, end: (*b).input.n, text: text, is_int: false, ival: 0 })
}

fn sb_suggest_int(b: *mut SuggBuilder, v: i32) {
    var t: m.Arr[u16] = tx.b16_new()
    tx.b16_i64((*b).a, &t, v as i64)
    m.arr_push[Sugg]((*b).a, &(*b).result, Sugg { start: (*b).start, end: (*b).input.n, text: tx.b16_view(&t), is_int: true, ival: v })
}

fn suggestions_empty() -> Suggestions {
    return Suggestions { start: 0, end: 0, list: m.arr_new[Sugg]() }
}

fn sugg_hash(s: *mut Sugg) -> u32 {
    let range_hash: u32 = 31 *% (31 +% ((*s).start as u32)) +% ((*s).end as u32)
    var h: u32 = 31 *% (31 *% (31 +% range_hash) +% (tx.u16_hash((*s).text) as% u32))
    if (*s).is_int {
        h = 31 *% (31 +% h) +% ((*s).ival as% u32)
    }
    return h
}

fn sugg_equals_new(n: *mut Sugg, o: *mut Sugg) -> bool {
    if (*n).start != (*o).start || (*n).end != (*o).end || !tx.u16_eq((*n).text, (*o).text) {
        return false
    }
    if (*n).is_int {
        return (*o).is_int && (*n).ival == (*o).ival
    }
    return true
}

fn hash_set_order(a: *mut m.Arena, items: *mut m.Arr[Sugg]) -> m.Arr[Sugg] {
    var kept: m.Arr[Sugg] = m.arr_new[Sugg]()
    var hashes: m.Arr[u32] = m.arr_new[u32]()
    var i: usize = 0
    while i < m.arr_len[Sugg](items) {
        let it: *mut Sugg = m.arr_at[Sugg](items, i)
        let h: u32 = sugg_hash(it)
        var dup: bool = false
        var j: usize = 0
        while j < m.arr_len[Sugg](&kept) {
            if *m.arr_at[u32](&hashes, j) == h && sugg_equals_new(it, m.arr_at[Sugg](&kept, j)) {
                dup = true
            }
            j = j + 1
        }
        if !dup {
            m.arr_push[Sugg](a, &kept, *it)
            m.arr_push[u32](a, &hashes, h)
        }
        i = i + 1
    }
    let n: usize = m.arr_len[Sugg](&kept)
    var cap: usize = 16
    while n > cap * 3 / 4 {
        cap = cap * 2
    }
    var out: m.Arr[Sugg] = m.arr_new[Sugg]()
    var b: usize = 0
    while b < cap {
        var k: usize = 0
        while k < n {
            let h: u32 = *m.arr_at[u32](&hashes, k)
            let spread: u32 = h ^ (h >> 16)
            if (spread as usize) & (cap - 1) == b {
                m.arr_push[Sugg](a, &out, *m.arr_at[Sugg](&kept, k))
            }
            k = k + 1
        }
        b = b + 1
    }
    return out
}

fn sugg_cmp_ci(x: *mut Sugg, y: *mut Sugg) -> i32 {
    if (*x).is_int && (*y).is_int {
        if (*x).ival < (*y).ival {
            return -1
        }
        if (*x).ival > (*y).ival {
            return 1
        }
        return 0
    }
    return cs.u16_cmp_ci((*x).text, (*y).text)
}

fn sort_like_timsort(v: *mut m.Arr[Sugg]) {
    let n: usize = m.arr_len[Sugg](v)
    if n < 2 {
        return
    }
    var run_hi: usize = 1
    if sugg_cmp_ci(m.arr_at[Sugg](v, 1), m.arr_at[Sugg](v, 0)) < 0 {
        run_hi = 2
        while run_hi < n && sugg_cmp_ci(m.arr_at[Sugg](v, run_hi), m.arr_at[Sugg](v, run_hi - 1)) < 0 {
            run_hi = run_hi + 1
        }
        var lo: usize = 0
        var hi: usize = run_hi - 1
        while lo < hi {
            let t: Sugg = *m.arr_at[Sugg](v, lo)
            *m.arr_at[Sugg](v, lo) = *m.arr_at[Sugg](v, hi)
            *m.arr_at[Sugg](v, hi) = t
            lo = lo + 1
            hi = hi - 1
        }
    } else {
        run_hi = 2
        while run_hi < n && sugg_cmp_ci(m.arr_at[Sugg](v, run_hi), m.arr_at[Sugg](v, run_hi - 1)) >= 0 {
            run_hi = run_hi + 1
        }
    }
    var start: usize = run_hi
    while start < n {
        let pivot: Sugg = *m.arr_at[Sugg](v, start)
        var left: usize = 0
        var right: usize = start
        while left < right {
            let mid: usize = (left + right) / 2
            if sugg_cmp_ci(&pivot, m.arr_at[Sugg](v, mid)) < 0 {
                right = mid
            } else {
                left = mid + 1
            }
        }
        var p: usize = start
        while p > left {
            *m.arr_at[Sugg](v, p) = *m.arr_at[Sugg](v, p - 1)
            p = p - 1
        }
        *m.arr_at[Sugg](v, left) = pivot
        start = start + 1
    }
}

fn sugg_expand(a: *mut m.Arena, s: *mut Sugg, command: tx.U16, start: usize, end: usize) -> Sugg {
    if start == (*s).start && end == (*s).end {
        return *s
    }
    var b: m.Arr[u16] = tx.b16_new()
    if start < (*s).start {
        tx.b16_text(a, &b, tx.u16_sub(command, start, (*s).start))
    }
    tx.b16_text(a, &b, (*s).text)
    if end > (*s).end {
        tx.b16_text(a, &b, tx.u16_sub(command, (*s).end, end))
    }
    return Sugg { start: start, end: end, text: tx.b16_view(&b), is_int: false, ival: 0 }
}

fn suggestions_create(a: *mut m.Arena, command: tx.U16, items: *mut m.Arr[Sugg]) -> Suggestions {
    let n: usize = m.arr_len[Sugg](items)
    if n == 0 {
        return suggestions_empty()
    }
    var start: usize = 4294967295
    var end: usize = 0
    var i: usize = 0
    while i < n {
        let s: *mut Sugg = m.arr_at[Sugg](items, i)
        if (*s).start < start {
            start = (*s).start
        }
        if (*s).end > end {
            end = (*s).end
        }
        i = i + 1
    }
    var expanded: m.Arr[Sugg] = m.arr_new[Sugg]()
    i = 0
    while i < n {
        m.arr_push[Sugg](a, &expanded, sugg_expand(a, m.arr_at[Sugg](items, i), command, start, end))
        i = i + 1
    }
    var sorted: m.Arr[Sugg] = hash_set_order(a, &expanded)
    sort_like_timsort(&sorted)
    return Suggestions { start: start, end: end, list: sorted }
}

fn sb_build(b: *mut SuggBuilder) -> Suggestions {
    return suggestions_create((*b).a, (*b).input, &(*b).result)
}

fn suggestions_merge(a: *mut m.Arena, command: tx.U16, parts: *mut m.Arr[Suggestions]) -> Suggestions {
    let n: usize = m.arr_len[Suggestions](parts)
    if n == 0 {
        return suggestions_empty()
    }
    if n == 1 {
        return *m.arr_at[Suggestions](parts, 0)
    }
    var all: m.Arr[Sugg] = m.arr_new[Sugg]()
    var i: usize = 0
    while i < n {
        let p: *mut Suggestions = m.arr_at[Suggestions](parts, i)
        var j: usize = 0
        while j < m.arr_len[Sugg](&(*p).list) {
            m.arr_push[Sugg](a, &all, *m.arr_at[Sugg](&(*p).list, j))
            j = j + 1
        }
        i = i + 1
    }
    var first: m.Arr[Sugg] = hash_set_order(a, &all)
    return suggestions_create(a, command, &first)
}

fn sugg_apply(a: *mut m.Arena, s: *mut Sugg, input: tx.U16) -> tx.U16 {
    if (*s).start == 0 && (*s).end == input.n {
        return (*s).text
    }
    var b: m.Arr[u16] = tx.b16_new()
    if (*s).start > 0 {
        tx.b16_text(a, &b, tx.u16_sub(input, 0, (*s).start))
    }
    tx.b16_text(a, &b, (*s).text)
    if (*s).end < input.n {
        tx.b16_text(a, &b, tx.u16_sub(input, (*s).end, input.n))
    }
    return tx.b16_view(&b)
}
