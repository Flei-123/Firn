// SPDX-License-Identifier: MIT
// lib/brigadier/casing.fi -- brigadier.casing: java.lang.String.toLowerCase(Locale.ROOT) and compareToIgnoreCase on UTF-16 text.
import brigadier.mem as m
import brigadier.text as tx
import brigadier.casemap as cm

export { u16_lower, u16_cmp_ci }

fn is_high(c: u32) -> bool {
    return c >= 0xD800 && c < 0xDC00
}

fn is_low(c: u32) -> bool {
    return c >= 0xDC00 && c < 0xE000
}

fn to_cp(hi: u32, lo: u32) -> u32 {
    return 0x10000 + ((hi - 0xD800) << 10) + (lo - 0xDC00)
}

fn cp_at(t: tx.U16, i: usize) -> u32 {
    let c: u32 = tx.u16_at(t, i)
    if is_high(c) && i + 1 < t.n && is_low(tx.u16_at(t, i + 1)) {
        return to_cp(c, tx.u16_at(t, i + 1))
    }
    return c
}

fn cp_len(cp: u32) -> usize {
    if cp >= 0x10000 {
        return 2
    }
    return 1
}

fn cp_before(t: tx.U16, i: usize) -> u32 {
    let c: u32 = tx.u16_at(t, i - 1)
    if is_low(c) && i >= 2 && is_high(tx.u16_at(t, i - 2)) {
        return to_cp(tx.u16_at(t, i - 2), c)
    }
    return c
}

fn is_word_char(cp: u32) -> bool {
    if cp < 128 {
        return (cp >= 48 && cp <= 57) || (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122) || cp == 95
    }
    if cp >= 0xA0 && cp <= 0xBF {
        return cp == 0xAA || cp == 0xB5 || cp == 0xBA
    }
    if cp == 0xD7 || cp == 0xF7 {
        return false
    }
    if cp >= 0x2000 && cp <= 0x206F {
        return false
    }
    if cp >= 0x3000 && cp <= 0x303F {
        return false
    }
    return true
}

fn is_joiner(cp: u32) -> bool {
    return cp == 39 || cp == 46 || cp == 58 || cp == 0xB7 || cp == 0x2019
}

fn is_boundary(t: tx.U16, i: usize) -> bool {
    if i == 0 || i >= t.n {
        return true
    }
    let prev: u32 = cp_before(t, i)
    let next: u32 = cp_at(t, i)
    if is_word_char(prev) && is_word_char(next) {
        return false
    }
    if is_joiner(next) && is_word_char(prev) && i + 1 < t.n && is_word_char(cp_at(t, i + 1)) {
        return false
    }
    if is_joiner(prev) && is_word_char(next) && i >= 2 && is_word_char(cp_before(t, i - 1)) {
        return false
    }
    return true
}

fn final_cased(t: tx.U16, index: usize) -> bool {
    var i: usize = index
    while i > 0 && !is_boundary(t, i) {
        let ch: u32 = cp_before(t, i)
        if cm.cm_cased(ch) {
            var j: usize = index + 1
            while j < t.n && !is_boundary(t, j) {
                let c2: u32 = cp_at(t, j)
                if cm.cm_cased(c2) {
                    return false
                }
                j = j + cp_len(c2)
            }
            return true
        }
        i = i - cp_len(ch)
    }
    return false
}

fn push_cp(a: *mut m.Arena, b: *mut m.Arr[u16], cp: u32) {
    if cp >= 0x10000 {
        let v: u32 = cp - 0x10000
        tx.b16_char(a, b, 0xD800 + (v >> 10))
        tx.b16_char(a, b, 0xDC00 + (v & 0x3FF))
    } else {
        tx.b16_char(a, b, cp)
    }
}

fn u16_lower(a: *mut m.Arena, t: tx.U16) -> tx.U16 {
    if t.n == 0 {
        return tx.u16_empty()
    }
    var b: m.Arr[u16] = tx.b16_new()
    var i: usize = 0
    while i < t.n {
        let cp: u32 = cp_at(t, i)
        if cp == 0x3A3 {
            if final_cased(t, i) {
                tx.b16_char(a, &b, 0x3C2)
            } else {
                tx.b16_char(a, &b, 0x3C3)
            }
        } else if cp == 0x130 {
            tx.b16_char(a, &b, 0x69)
            tx.b16_char(a, &b, 0x307)
        } else {
            push_cp(a, &b, cm.cm_lower(cp))
        }
        i = i + cp_len(cp)
    }
    return tx.b16_view(&b)
}

fn cmp_cp_ci(x: u32, y: u32) -> i32 {
    var c1: u32 = cm.cm_upper(x)
    var c2: u32 = cm.cm_upper(y)
    if c1 != c2 {
        c1 = cm.cm_lower(c1)
        c2 = cm.cm_lower(c2)
        if c1 != c2 {
            return (c1 as i32) - (c2 as i32)
        }
    }
    return 0
}

fn u16_cmp_ci(x: tx.U16, y: tx.U16) -> i32 {
    var k1: usize = 0
    var k2: usize = 0
    while k1 < x.n && k2 < y.n {
        var c1: u32 = tx.u16_at(x, k1)
        var c2: u32 = tx.u16_at(y, k2)
        if c1 != c2 && cmp_cp_ci(c1, c2) != 0 {
            if is_low(c1) && k1 > 0 && is_high(tx.u16_at(x, k1 - 1)) {
                c1 = to_cp(tx.u16_at(x, k1 - 1), c1)
            } else if is_high(c1) && k1 + 1 < x.n && is_low(tx.u16_at(x, k1 + 1)) {
                c1 = to_cp(c1, tx.u16_at(x, k1 + 1))
                k1 = k1 + 1
            }
            if is_low(c2) && k2 > 0 && is_high(tx.u16_at(y, k2 - 1)) {
                c2 = to_cp(tx.u16_at(y, k2 - 1), c2)
            } else if is_high(c2) && k2 + 1 < y.n && is_low(tx.u16_at(y, k2 + 1)) {
                c2 = to_cp(c2, tx.u16_at(y, k2 + 1))
                k2 = k2 + 1
            }
            let diff: i32 = cmp_cp_ci(c1, c2)
            if diff != 0 {
                return diff
            }
        }
        k1 = k1 + 1
        k2 = k2 + 1
    }
    return (x.n as i32) - (y.n as i32)
}
