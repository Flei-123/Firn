// SPDX-License-Identifier: MIT
// lib/brigadier/mem.fi -- brigadier.mem: bump arena and arena-backed growing arrays.
import std.rt

export { Arena, Arr, arena_new, arena_alloc, arena_free, arena_reset, arena_obj, arr_new, arr_push, arr_at, arr_len, arr_clone, arr_truncate }

const CHUNK: usize = 65536

struct Arena {
    head: u64,
    cur: u64,
    used: usize,
    size: usize,
}

struct Arr[T] {
    p: u64,
    n: usize,
    cap: usize,
}

fn arena_new() -> Arena {
    return Arena { head: 0, cur: 0, used: 0, size: 0 }
}

fn arena_chunk(a: *mut Arena, n: usize) {
    var size: usize = CHUNK
    if n + 16 > size {
        size = n + 16
    }
    let c: u64 = rt.heap_alloc(size + 16)
    rt.st64(c, 0, 0)
    rt.st64(c, 1, size as u64)
    if (*a).cur != 0 {
        rt.st64((*a).cur, 0, c)
    } else {
        (*a).head = c
    }
    (*a).cur = c
    (*a).used = 0
    (*a).size = size
}

fn arena_alloc(a: *mut Arena, n0: usize) -> u64 {
    var n: usize = (n0 + 15) & ~15
    if n == 0 {
        n = 16
    }
    if (*a).cur == 0 || (*a).used + n > (*a).size {
        arena_chunk(a, n)
    }
    let p: u64 = (*a).cur + 16 + ((*a).used as u64)
    (*a).used = (*a).used + n
    rt.mem_set(p, 0, n)
    return p
}

fn arena_free(a: *mut Arena) {
    var c: u64 = (*a).head
    while c != 0 {
        let next: u64 = rt.ld64(c, 0)
        let size: usize = rt.ld64(c, 1) as usize
        rt.heap_free(c, size + 16)
        c = next
    }
    *a = arena_new()
}

fn arena_reset(a: *mut Arena) {
    arena_free(a)
}

fn arr_new[T]() -> Arr[T] {
    return Arr[T] { p: 0, n: 0, cap: 0 }
}

fn arr_len[T](v: *mut Arr[T]) -> usize {
    return (*v).n
}

fn arr_at[T](v: *mut Arr[T], i: usize) -> *mut T {
    return ((*v).p + ((i * size_of[T]()) as u64)) as *mut T
}

fn arr_push[T](a: *mut Arena, v: *mut Arr[T], x: T) {
    if (*v).n == (*v).cap {
        var nc: usize = (*v).cap * 2
        if nc < 4 {
            nc = 4
        }
        let np: u64 = arena_alloc(a, nc * size_of[T]())
        if (*v).n > 0 {
            rt.mem_copy(np, (*v).p, (*v).n * size_of[T]())
        }
        (*v).p = np
        (*v).cap = nc
    }
    let slot: *mut T = ((*v).p + (((*v).n * size_of[T]()) as u64)) as *mut T
    *slot = x
    (*v).n = (*v).n + 1
}

fn arr_clone[T](a: *mut Arena, v: *mut Arr[T]) -> Arr[T] {
    var r: Arr[T] = arr_new[T]()
    if (*v).n == 0 {
        return r
    }
    let np: u64 = arena_alloc(a, (*v).n * size_of[T]())
    rt.mem_copy(np, (*v).p, (*v).n * size_of[T]())
    r.p = np
    r.n = (*v).n
    r.cap = (*v).n
    return r
}

fn arr_truncate[T](v: *mut Arr[T], n: usize) {
    if n < (*v).n {
        (*v).n = n
    }
}

fn arena_obj[T](a: *mut Arena) -> u64 {
    return arena_alloc(a, size_of[T]())
}
