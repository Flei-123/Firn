// SPDX-License-Identifier: MIT
// lib/brigadier/argtype.fi -- brigadier.argtype: argument types (bool, int, long, float, double, word, string, greedy, custom) with parse and suggestions.
import brigadier.mem as m
import brigadier.text as tx
import brigadier.exc as ex
import brigadier.reader as rd
import brigadier.javanum as jn
import brigadier.suggest as sg

export { ArgType, Value, TypeHooks, at_bool, at_int, at_long, at_float, at_double, at_word, at_string, at_greedy, at_custom,
    at_parse, at_suggest, value_text,
    AT_BOOL, AT_INT, AT_LONG, AT_FLOAT, AT_DOUBLE, AT_WORD, AT_STRING, AT_GREEDY, AT_CUSTOM,
    VK_BOOL, VK_INT, VK_LONG, VK_FLOAT, VK_DOUBLE, VK_STRING, VK_CUSTOM }

const AT_BOOL: i32 = 1
const AT_INT: i32 = 2
const AT_LONG: i32 = 3
const AT_FLOAT: i32 = 4
const AT_DOUBLE: i32 = 5
const AT_WORD: i32 = 6
const AT_STRING: i32 = 7
const AT_GREEDY: i32 = 8
const AT_CUSTOM: i32 = 9

const VK_BOOL: i32 = 1
const VK_INT: i32 = 2
const VK_LONG: i32 = 3
const VK_FLOAT: i32 = 4
const VK_DOUBLE: i32 = 5
const VK_STRING: i32 = 6
const VK_CUSTOM: i32 = 7

struct ArgType {
    kind: i32,
    imin: i64,
    imax: i64,
    fmin: f64,
    fmax: f64,
    custom: i32,
}

struct Value {
    kind: i32,
    i: i64,
    f: f64,
    s: tx.U16,
}

struct TypeHooks {
    user: u64,
    parse: fn(u64, i32, u64, u64, u64) -> bool,
    suggest: fn(u64, i32, u64),
}

fn at_blank(kind: i32) -> ArgType {
    return ArgType { kind: kind, imin: 0, imax: 0, fmin: 0.0, fmax: 0.0, custom: 0 }
}

fn at_bool() -> ArgType {
    return at_blank(AT_BOOL)
}

fn at_int(lo: i32, hi: i32) -> ArgType {
    var t: ArgType = at_blank(AT_INT)
    t.imin = lo as i64
    t.imax = hi as i64
    return t
}

fn at_long(lo: i64, hi: i64) -> ArgType {
    var t: ArgType = at_blank(AT_LONG)
    t.imin = lo
    t.imax = hi
    return t
}

fn at_float(lo: f32, hi: f32) -> ArgType {
    var t: ArgType = at_blank(AT_FLOAT)
    t.fmin = lo as f64
    t.fmax = hi as f64
    return t
}

fn at_double(lo: f64, hi: f64) -> ArgType {
    var t: ArgType = at_blank(AT_DOUBLE)
    t.fmin = lo
    t.fmax = hi
    return t
}

fn at_word() -> ArgType {
    return at_blank(AT_WORD)
}

fn at_string() -> ArgType {
    return at_blank(AT_STRING)
}

fn at_greedy() -> ArgType {
    return at_blank(AT_GREEDY)
}

fn at_custom(id: i32) -> ArgType {
    var t: ArgType = at_blank(AT_CUSTOM)
    t.custom = id
    return t
}

fn int_text(a: *mut m.Arena, v: i64) -> tx.U16 {
    var b: m.Arr[u16] = tx.b16_new()
    tx.b16_i64(a, &b, v)
    return tx.b16_view(&b)
}

fn f32_text(a: *mut m.Arena, v: f32) -> tx.U16 {
    var b: m.Arr[u16] = tx.b16_new()
    jn.put_float(a, &b, v)
    return tx.b16_view(&b)
}

fn f64_text(a: *mut m.Arena, v: f64) -> tx.U16 {
    var b: m.Arr[u16] = tx.b16_new()
    jn.put_double(a, &b, v)
    return tx.b16_view(&b)
}

fn value_text(a: *mut m.Arena, v: *mut Value) -> tx.U16 {
    if (*v).kind == VK_BOOL {
        if (*v).i != 0 {
            return tx.u16_from_str(a, "true")
        }
        return tx.u16_from_str(a, "false")
    }
    if (*v).kind == VK_INT || (*v).kind == VK_LONG || (*v).kind == VK_CUSTOM {
        return int_text(a, (*v).i)
    }
    if (*v).kind == VK_FLOAT {
        return f32_text(a, (*v).f as f32)
    }
    if (*v).kind == VK_DOUBLE {
        return f64_text(a, (*v).f)
    }
    return (*v).s
}

fn bounds_fail(r: *mut rd.Reader, err: *mut ex.Exc, kind: i32, found: tx.U16, bound: tx.U16) {
    *err = ex.exc_builtin((*r).a, kind, (*r).s, (*r).cursor, found, bound)
}

fn parse_int_type(t: *mut ArgType, r: *mut rd.Reader, out: *mut Value, err: *mut ex.Exc) -> bool {
    let start: usize = (*r).cursor
    var v: i32 = 0
    if !rd.read_int(r, &v, err) {
        return false
    }
    if (v as i64) < (*t).imin {
        rd.set_cursor(r, start)
        bounds_fail(r, err, ex.EX_INT_TOO_SMALL, int_text((*r).a, v as i64), int_text((*r).a, (*t).imin))
        return false
    }
    if (v as i64) > (*t).imax {
        rd.set_cursor(r, start)
        bounds_fail(r, err, ex.EX_INT_TOO_BIG, int_text((*r).a, v as i64), int_text((*r).a, (*t).imax))
        return false
    }
    *out = Value { kind: VK_INT, i: v as i64, f: 0.0, s: tx.u16_empty() }
    return true
}

fn parse_long_type(t: *mut ArgType, r: *mut rd.Reader, out: *mut Value, err: *mut ex.Exc) -> bool {
    let start: usize = (*r).cursor
    var v: i64 = 0
    if !rd.read_long(r, &v, err) {
        return false
    }
    if v < (*t).imin {
        rd.set_cursor(r, start)
        bounds_fail(r, err, ex.EX_LONG_TOO_SMALL, int_text((*r).a, v), int_text((*r).a, (*t).imin))
        return false
    }
    if v > (*t).imax {
        rd.set_cursor(r, start)
        bounds_fail(r, err, ex.EX_LONG_TOO_BIG, int_text((*r).a, v), int_text((*r).a, (*t).imax))
        return false
    }
    *out = Value { kind: VK_LONG, i: v, f: 0.0, s: tx.u16_empty() }
    return true
}

fn parse_float_type(t: *mut ArgType, r: *mut rd.Reader, out: *mut Value, err: *mut ex.Exc) -> bool {
    let start: usize = (*r).cursor
    var v: f32 = 0.0
    if !rd.read_float(r, &v, err) {
        return false
    }
    if (v as f64) < (*t).fmin {
        rd.set_cursor(r, start)
        bounds_fail(r, err, ex.EX_FLOAT_TOO_SMALL, f32_text((*r).a, v), f32_text((*r).a, (*t).fmin as f32))
        return false
    }
    if (v as f64) > (*t).fmax {
        rd.set_cursor(r, start)
        bounds_fail(r, err, ex.EX_FLOAT_TOO_BIG, f32_text((*r).a, v), f32_text((*r).a, (*t).fmax as f32))
        return false
    }
    *out = Value { kind: VK_FLOAT, i: 0, f: v as f64, s: tx.u16_empty() }
    return true
}

fn parse_double_type(t: *mut ArgType, r: *mut rd.Reader, out: *mut Value, err: *mut ex.Exc) -> bool {
    let start: usize = (*r).cursor
    var v: f64 = 0.0
    if !rd.read_double(r, &v, err) {
        return false
    }
    if v < (*t).fmin {
        rd.set_cursor(r, start)
        bounds_fail(r, err, ex.EX_DOUBLE_TOO_SMALL, f64_text((*r).a, v), f64_text((*r).a, (*t).fmin))
        return false
    }
    if v > (*t).fmax {
        rd.set_cursor(r, start)
        bounds_fail(r, err, ex.EX_DOUBLE_TOO_BIG, f64_text((*r).a, v), f64_text((*r).a, (*t).fmax))
        return false
    }
    *out = Value { kind: VK_DOUBLE, i: 0, f: v, s: tx.u16_empty() }
    return true
}

fn at_parse(t: *mut ArgType, r: *mut rd.Reader, out: *mut Value, err: *mut ex.Exc, th: *mut TypeHooks) -> bool {
    let k: i32 = (*t).kind
    if k == AT_BOOL {
        var b: bool = false
        if !rd.read_bool(r, &b, err) {
            return false
        }
        var iv: i64 = 0
        if b {
            iv = 1
        }
        *out = Value { kind: VK_BOOL, i: iv, f: 0.0, s: tx.u16_empty() }
        return true
    }
    if k == AT_INT {
        return parse_int_type(t, r, out, err)
    }
    if k == AT_LONG {
        return parse_long_type(t, r, out, err)
    }
    if k == AT_FLOAT {
        return parse_float_type(t, r, out, err)
    }
    if k == AT_DOUBLE {
        return parse_double_type(t, r, out, err)
    }
    if k == AT_WORD {
        *out = Value { kind: VK_STRING, i: 0, f: 0.0, s: rd.read_unquoted(r) }
        return true
    }
    if k == AT_STRING {
        var s: tx.U16 = tx.u16_empty()
        if !rd.read_string(r, &s, err) {
            return false
        }
        *out = Value { kind: VK_STRING, i: 0, f: 0.0, s: s }
        return true
    }
    if k == AT_GREEDY {
        let s: tx.U16 = rd.remaining(r)
        rd.set_cursor(r, rd.total_length(r))
        *out = Value { kind: VK_STRING, i: 0, f: 0.0, s: s }
        return true
    }
    let f: fn(u64, i32, u64, u64, u64) -> bool = (*th).parse
    return f((*th).user, (*t).custom, r as u64, out as u64, err as u64)
}

fn at_suggest(t: *mut ArgType, b: *mut sg.SuggBuilder, th: *mut TypeHooks) {
    if (*t).kind == AT_BOOL {
        let rl: tx.U16 = sg.sb_remaining_lower(b)
        let tr: tx.U16 = tx.u16_from_str((*b).a, "true")
        let fl: tx.U16 = tx.u16_from_str((*b).a, "false")
        if tx.u16_starts_with(tr, rl) {
            sg.sb_suggest(b, tr)
        }
        if tx.u16_starts_with(fl, rl) {
            sg.sb_suggest(b, fl)
        }
        return
    }
    if (*t).kind == AT_CUSTOM {
        let f: fn(u64, i32, u64) = (*th).suggest
        f((*th).user, (*t).custom, b as u64)
    }
}
