// SPDX-License-Identifier: MIT
// lib/brigadier/javanum.fi -- brigadier.javanum: Java compatible number parsing (Integer/Long/Float/Double.parse*) and Float/Double.toString.
import std.rt
import std.num
import brigadier.mem as m
import brigadier.text as tx

export { parse_int, parse_long, parse_float, parse_double, put_float, put_double, put_f64_bits_hex }

fn digit_at(t: tx.U16, i: usize) -> i32 {
    let c: u32 = tx.u16_at(t, i)
    if c >= 48 && c <= 57 {
        return (c - 48) as i32
    }
    return -1
}

fn parse_mag(t: tx.U16, limit_pos: u64, limit_neg: u64, out: *mut i64) -> bool {
    var i: usize = 0
    var neg: bool = false
    if t.n == 0 {
        return false
    }
    let c0: u32 = tx.u16_at(t, 0)
    if c0 == 45 {
        neg = true
        i = 1
    } else if c0 == 43 {
        i = 1
    }
    if i >= t.n {
        return false
    }
    var mag: u64 = 0
    var limit: u64 = limit_pos
    if neg {
        limit = limit_neg
    }
    while i < t.n {
        let d: i32 = digit_at(t, i)
        if d < 0 {
            return false
        }
        let dd: u64 = d as u64
        if mag > (limit - dd) / 10 {
            return false
        }
        mag = mag * 10 + dd
        i = i + 1
    }
    if neg {
        *out = 0 -% (mag as i64)
    } else {
        *out = mag as i64
    }
    return true
}

fn parse_int(t: tx.U16, out: *mut i32) -> bool {
    var v: i64 = 0
    if !parse_mag(t, 2147483647, 2147483648, &v) {
        return false
    }
    *out = v as i32
    return true
}

fn parse_long(t: tx.U16, out: *mut i64) -> bool {
    return parse_mag(t, 9223372036854775807, 9223372036854775808, out)
}

fn valid_decimal(t: tx.U16) -> bool {
    var i: usize = 0
    if t.n > 0 && (tx.u16_at(t, 0) == 45 || tx.u16_at(t, 0) == 43) {
        i = 1
    }
    var digits: usize = 0
    while i < t.n && digit_at(t, i) >= 0 {
        digits = digits + 1
        i = i + 1
    }
    if i < t.n && tx.u16_at(t, i) == 46 {
        i = i + 1
        while i < t.n && digit_at(t, i) >= 0 {
            digits = digits + 1
            i = i + 1
        }
    }
    return i == t.n && digits > 0
}

fn ascii_span(a: *mut m.Arena, t: tx.U16) -> str {
    let p: u64 = m.arena_alloc(a, t.n + 1)
    var i: usize = 0
    while i < t.n {
        rt.st8(p, i, tx.u16_at(t, i) as u8)
        i = i + 1
    }
    return str { p: p as *mut u8, n: t.n }
}

fn parse_double(a: *mut m.Arena, t: tx.U16, out: *mut f64) -> bool {
    if !valid_decimal(t) {
        return false
    }
    let r = num.parse_f64(ascii_span(a, t))
    if !r.ok {
        return false
    }
    *out = r.value
    return true
}

fn parse_float(a: *mut m.Arena, t: tx.U16, out: *mut f32) -> bool {
    if !valid_decimal(t) {
        return false
    }
    let r = num.parse_f32(ascii_span(a, t))
    if !r.ok {
        return false
    }
    *out = r.value
    return true
}

fn put_es_as_java(a: *mut m.Arena, b: *mut m.Arr[u16], p: u64, n: usize) {
    var i: usize = 0
    if n > 0 && rt.ld8(p, 0) == 45 {
        tx.b16_char(a, b, 45)
        i = 1
    }
    var all: [u8; 48] = [0 as u8; 48]
    var total: usize = 0
    var point_idx: i64 = -1
    var e10: i64 = 0
    while i < n {
        let c: u32 = rt.ld8(p, i) as u32
        if c == 46 {
            point_idx = total as i64
        } else if c == 101 {
            i = i + 1
            var eneg: bool = false
            if rt.ld8(p, i) == 45 {
                eneg = true
            }
            if rt.ld8(p, i) == 45 || rt.ld8(p, i) == 43 {
                i = i + 1
            }
            while i < n {
                e10 = e10 * 10 + ((rt.ld8(p, i) as i64) - 48)
                i = i + 1
            }
            if eneg {
                e10 = 0 - e10
            }
            break
        } else if total < 48 {
            all[total] = c as u8
            total = total + 1
        }
        i = i + 1
    }
    if point_idx < 0 {
        point_idx = total as i64
    }
    var lz: usize = 0
    while lz < total && all[lz] == 48 {
        lz = lz + 1
    }
    if lz == total {
        tx.b16_ascii(a, b, "0.0")
        return
    }
    var last: usize = total
    while last > lz + 1 && all[last - 1] == 48 {
        last = last - 1
    }
    let sci: i64 = point_idx - 1 - (lz as i64) + e10
    let nd: usize = last - lz
    if sci >= 0 - 3 && sci < 7 {
        if sci >= 0 {
            var k: usize = 0
            while k <= (sci as usize) {
                if k < nd {
                    tx.b16_char(a, b, all[lz + k] as u32)
                } else {
                    tx.b16_char(a, b, 48)
                }
                k = k + 1
            }
            tx.b16_char(a, b, 46)
            if (sci as usize) + 1 >= nd {
                tx.b16_char(a, b, 48)
            } else {
                var j: usize = (sci as usize) + 1
                while j < nd {
                    tx.b16_char(a, b, all[lz + j] as u32)
                    j = j + 1
                }
            }
        } else {
            tx.b16_ascii(a, b, "0.")
            var z: i64 = 0
            while z < 0 - sci - 1 {
                tx.b16_char(a, b, 48)
                z = z + 1
            }
            var j: usize = 0
            while j < nd {
                tx.b16_char(a, b, all[lz + j] as u32)
                j = j + 1
            }
        }
    } else {
        tx.b16_char(a, b, all[lz] as u32)
        tx.b16_char(a, b, 46)
        if nd == 1 {
            tx.b16_char(a, b, 48)
        } else {
            var j: usize = 1
            while j < nd {
                tx.b16_char(a, b, all[lz + j] as u32)
                j = j + 1
            }
        }
        tx.b16_char(a, b, 69)
        tx.b16_i64(a, b, sci)
    }
}

fn put_double(a: *mut m.Arena, b: *mut m.Arr[u16], x: f64) {
    if x != x {
        tx.b16_ascii(a, b, "NaN")
        return
    }
    if x > 1.7976931348623157e308 {
        tx.b16_ascii(a, b, "Infinity")
        return
    }
    if x < -1.7976931348623157e308 {
        tx.b16_ascii(a, b, "-Infinity")
        return
    }
    if x == 0.0 {
        if num.f64_bits(x) >> 63 == 1 {
            tx.b16_ascii(a, b, "-0.0")
        } else {
            tx.b16_ascii(a, b, "0.0")
        }
        return
    }
    var by: num.Bytes = num.bytes_new()
    if num.write_f64(&by, x) {
        put_es_as_java(a, b, rt.addr_of(by.ptr), by.len)
    }
    num.bytes_free(&by)
}

fn put_float(a: *mut m.Arena, b: *mut m.Arr[u16], x: f32) {
    if x != x {
        tx.b16_ascii(a, b, "NaN")
        return
    }
    if x > 3.4028235e38 {
        tx.b16_ascii(a, b, "Infinity")
        return
    }
    if x < -3.4028235e38 {
        tx.b16_ascii(a, b, "-Infinity")
        return
    }
    if x == 0.0 {
        if num.f32_bits(x) >> 31 == 1 {
            tx.b16_ascii(a, b, "-0.0")
        } else {
            tx.b16_ascii(a, b, "0.0")
        }
        return
    }
    var by: num.Bytes = num.bytes_new()
    if num.write_f32(&by, x) {
        put_es_as_java(a, b, rt.addr_of(by.ptr), by.len)
    }
    num.bytes_free(&by)
}

fn put_f64_bits_hex(a: *mut m.Arena, b: *mut m.Arr[u16], x: f64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_hex_u64(&t, num.f64_bits(x), 16)
    var i: usize = 0
    while i < rt.buf_len(&t) {
        tx.b16_char(a, b, rt.buf_at(&t, i) as u32)
        i = i + 1
    }
    rt.buf_free(&t)
}
