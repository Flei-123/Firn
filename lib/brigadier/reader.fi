// SPDX-License-Identifier: MIT
// lib/brigadier/reader.fi -- brigadier.reader: StringReader over UTF-16 code units with the exact errors and cursors of Mojang's Brigadier.
import brigadier.mem as m
import brigadier.text as tx
import brigadier.exc as ex
import brigadier.javanum as jn

export { Reader, reader_new, can_read, can_read_n, peek, peek_at, read_char, skip, remaining, remaining_length, total_length,
    set_cursor, skip_whitespace, read_int, read_long, read_float, read_double, read_bool, read_unquoted, read_quoted,
    read_string, read_string_until, expect_char, is_allowed_in_unquoted, is_quoted_start, read_rest }

struct Reader {
    a: *mut m.Arena,
    s: tx.U16,
    cursor: usize,
}

fn reader_new(a: *mut m.Arena, s: tx.U16) -> Reader {
    return Reader { a: a, s: s, cursor: 0 }
}

fn remaining_length(r: *mut Reader) -> usize {
    return (*r).s.n - (*r).cursor
}

fn total_length(r: *mut Reader) -> usize {
    return (*r).s.n
}

fn remaining(r: *mut Reader) -> tx.U16 {
    return tx.u16_sub((*r).s, (*r).cursor, (*r).s.n)
}

fn can_read_n(r: *mut Reader, n: usize) -> bool {
    return (*r).cursor + n <= (*r).s.n
}

fn can_read(r: *mut Reader) -> bool {
    return can_read_n(r, 1)
}

fn peek(r: *mut Reader) -> u32 {
    return tx.u16_at((*r).s, (*r).cursor)
}

fn peek_at(r: *mut Reader, offset: usize) -> u32 {
    return tx.u16_at((*r).s, (*r).cursor + offset)
}

fn read_char(r: *mut Reader) -> u32 {
    let c: u32 = tx.u16_at((*r).s, (*r).cursor)
    (*r).cursor = (*r).cursor + 1
    return c
}

fn skip(r: *mut Reader) {
    (*r).cursor = (*r).cursor + 1
}

fn set_cursor(r: *mut Reader, c: usize) {
    (*r).cursor = c
}

fn skip_whitespace(r: *mut Reader) {
    while can_read(r) && tx.is_java_whitespace(peek(r)) {
        skip(r)
    }
}

fn is_allowed_number(c: u32) -> bool {
    return (c >= 48 && c <= 57) || c == 46 || c == 45
}

fn is_allowed_in_unquoted(c: u32) -> bool {
    return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 45 || c == 46 || c == 43
}

fn is_quoted_start(c: u32) -> bool {
    return c == 34 || c == 39
}

fn fail(r: *mut Reader, err: *mut ex.Exc, kind: i32, arg0: tx.U16) {
    *err = ex.exc_builtin((*r).a, kind, (*r).s, (*r).cursor, arg0, tx.u16_empty())
}

fn read_number_text(r: *mut Reader) -> tx.U16 {
    let start: usize = (*r).cursor
    while can_read(r) && is_allowed_number(peek(r)) {
        skip(r)
    }
    return tx.u16_sub((*r).s, start, (*r).cursor)
}

fn read_int(r: *mut Reader, out: *mut i32, err: *mut ex.Exc) -> bool {
    let start: usize = (*r).cursor
    let t: tx.U16 = read_number_text(r)
    if t.n == 0 {
        fail(r, err, ex.EX_EXPECTED_INT, tx.u16_empty())
        return false
    }
    if !jn.parse_int(t, out) {
        (*r).cursor = start
        fail(r, err, ex.EX_INVALID_INT, t)
        return false
    }
    return true
}

fn read_long(r: *mut Reader, out: *mut i64, err: *mut ex.Exc) -> bool {
    let start: usize = (*r).cursor
    let t: tx.U16 = read_number_text(r)
    if t.n == 0 {
        fail(r, err, ex.EX_EXPECTED_LONG, tx.u16_empty())
        return false
    }
    if !jn.parse_long(t, out) {
        (*r).cursor = start
        fail(r, err, ex.EX_INVALID_LONG, t)
        return false
    }
    return true
}

fn read_float(r: *mut Reader, out: *mut f32, err: *mut ex.Exc) -> bool {
    let start: usize = (*r).cursor
    let t: tx.U16 = read_number_text(r)
    if t.n == 0 {
        fail(r, err, ex.EX_EXPECTED_FLOAT, tx.u16_empty())
        return false
    }
    if !jn.parse_float((*r).a, t, out) {
        (*r).cursor = start
        fail(r, err, ex.EX_INVALID_FLOAT, t)
        return false
    }
    return true
}

fn read_double(r: *mut Reader, out: *mut f64, err: *mut ex.Exc) -> bool {
    let start: usize = (*r).cursor
    let t: tx.U16 = read_number_text(r)
    if t.n == 0 {
        fail(r, err, ex.EX_EXPECTED_DOUBLE, tx.u16_empty())
        return false
    }
    if !jn.parse_double((*r).a, t, out) {
        (*r).cursor = start
        fail(r, err, ex.EX_INVALID_DOUBLE, t)
        return false
    }
    return true
}

fn read_unquoted(r: *mut Reader) -> tx.U16 {
    let start: usize = (*r).cursor
    while can_read(r) && is_allowed_in_unquoted(peek(r)) {
        skip(r)
    }
    return tx.u16_sub((*r).s, start, (*r).cursor)
}

fn read_string_until(r: *mut Reader, terminator: u32, out: *mut tx.U16, err: *mut ex.Exc) -> bool {
    var b: m.Arr[u16] = tx.b16_new()
    var escaped: bool = false
    while can_read(r) {
        let c: u32 = read_char(r)
        if escaped {
            if c == terminator || c == 92 {
                tx.b16_char((*r).a, &b, c)
                escaped = false
            } else {
                set_cursor(r, (*r).cursor - 1)
                var one: m.Arr[u16] = tx.b16_new()
                tx.b16_char((*r).a, &one, c)
                fail(r, err, ex.EX_INVALID_ESCAPE, tx.b16_view(&one))
                return false
            }
        } else if c == 92 {
            escaped = true
        } else if c == terminator {
            *out = tx.b16_view(&b)
            return true
        } else {
            tx.b16_char((*r).a, &b, c)
        }
    }
    fail(r, err, ex.EX_EXPECTED_END_OF_QUOTE, tx.u16_empty())
    return false
}

fn read_quoted(r: *mut Reader, out: *mut tx.U16, err: *mut ex.Exc) -> bool {
    if !can_read(r) {
        *out = tx.u16_empty()
        return true
    }
    let next: u32 = peek(r)
    if !is_quoted_start(next) {
        fail(r, err, ex.EX_EXPECTED_START_OF_QUOTE, tx.u16_empty())
        return false
    }
    skip(r)
    return read_string_until(r, next, out, err)
}

fn read_string(r: *mut Reader, out: *mut tx.U16, err: *mut ex.Exc) -> bool {
    if !can_read(r) {
        *out = tx.u16_empty()
        return true
    }
    let next: u32 = peek(r)
    if is_quoted_start(next) {
        skip(r)
        return read_string_until(r, next, out, err)
    }
    *out = read_unquoted(r)
    return true
}

fn is_ascii_eq(t: tx.U16, s: str) -> bool {
    if t.n != s.n {
        return false
    }
    var i: usize = 0
    while i < t.n {
        if tx.u16_at(t, i) != (rt_ld8(s, i) as u32) {
            return false
        }
        i = i + 1
    }
    return true
}

fn rt_ld8(s: str, i: usize) -> u8 {
    return *((s.p as u64 + (i as u64)) as *mut u8)
}

fn read_bool(r: *mut Reader, out: *mut bool, err: *mut ex.Exc) -> bool {
    let start: usize = (*r).cursor
    var v: tx.U16 = tx.u16_empty()
    if !read_string(r, &v, err) {
        return false
    }
    if v.n == 0 {
        fail(r, err, ex.EX_EXPECTED_BOOL, tx.u16_empty())
        return false
    }
    if is_ascii_eq(v, "true") {
        *out = true
        return true
    }
    if is_ascii_eq(v, "false") {
        *out = false
        return true
    }
    (*r).cursor = start
    fail(r, err, ex.EX_INVALID_BOOL, v)
    return false
}

fn expect_char(r: *mut Reader, c: u32, err: *mut ex.Exc) -> bool {
    if !can_read(r) || peek(r) != c {
        var one: m.Arr[u16] = tx.b16_new()
        tx.b16_char((*r).a, &one, c)
        fail(r, err, ex.EX_EXPECTED_SYMBOL, tx.b16_view(&one))
        return false
    }
    skip(r)
    return true
}

fn read_rest(r: *mut Reader) -> tx.U16 {
    let t: tx.U16 = remaining(r)
    (*r).cursor = (*r).s.n
    return t
}
