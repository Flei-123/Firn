// SPDX-License-Identifier: MIT
// lib/brigadier/exc.fi -- brigadier.exc: CommandSyntaxException with the built-in messages, cursor and context.
import brigadier.mem as m
import brigadier.text as tx

export { Exc, exc_none, exc_custom, exc_custom_ctx, exc_builtin, exc_message, exc_context, exc_raw,
    EX_NONE, EX_CUSTOM, EX_DOUBLE_TOO_SMALL, EX_DOUBLE_TOO_BIG, EX_FLOAT_TOO_SMALL, EX_FLOAT_TOO_BIG,
    EX_INT_TOO_SMALL, EX_INT_TOO_BIG, EX_LONG_TOO_SMALL, EX_LONG_TOO_BIG, EX_LITERAL_INCORRECT,
    EX_EXPECTED_START_OF_QUOTE, EX_EXPECTED_END_OF_QUOTE, EX_INVALID_ESCAPE, EX_INVALID_BOOL,
    EX_INVALID_INT, EX_EXPECTED_INT, EX_INVALID_LONG, EX_EXPECTED_LONG, EX_INVALID_DOUBLE,
    EX_EXPECTED_DOUBLE, EX_INVALID_FLOAT, EX_EXPECTED_FLOAT, EX_EXPECTED_BOOL, EX_EXPECTED_SYMBOL,
    EX_UNKNOWN_COMMAND, EX_UNKNOWN_ARGUMENT, EX_EXPECTED_ARG_SEPARATOR, EX_PARSE_EXCEPTION }

const CONTEXT_AMOUNT: usize = 10

const EX_NONE: i32 = 0
const EX_CUSTOM: i32 = 1
const EX_DOUBLE_TOO_SMALL: i32 = 2
const EX_DOUBLE_TOO_BIG: i32 = 3
const EX_FLOAT_TOO_SMALL: i32 = 4
const EX_FLOAT_TOO_BIG: i32 = 5
const EX_INT_TOO_SMALL: i32 = 6
const EX_INT_TOO_BIG: i32 = 7
const EX_LONG_TOO_SMALL: i32 = 8
const EX_LONG_TOO_BIG: i32 = 9
const EX_LITERAL_INCORRECT: i32 = 10
const EX_EXPECTED_START_OF_QUOTE: i32 = 11
const EX_EXPECTED_END_OF_QUOTE: i32 = 12
const EX_INVALID_ESCAPE: i32 = 13
const EX_INVALID_BOOL: i32 = 14
const EX_INVALID_INT: i32 = 15
const EX_EXPECTED_INT: i32 = 16
const EX_INVALID_LONG: i32 = 17
const EX_EXPECTED_LONG: i32 = 18
const EX_INVALID_DOUBLE: i32 = 19
const EX_EXPECTED_DOUBLE: i32 = 20
const EX_INVALID_FLOAT: i32 = 21
const EX_EXPECTED_FLOAT: i32 = 22
const EX_EXPECTED_BOOL: i32 = 23
const EX_EXPECTED_SYMBOL: i32 = 24
const EX_UNKNOWN_COMMAND: i32 = 25
const EX_UNKNOWN_ARGUMENT: i32 = 26
const EX_EXPECTED_ARG_SEPARATOR: i32 = 27
const EX_PARSE_EXCEPTION: i32 = 28

struct Exc {
    kind: i32,
    msg: tx.U16,
    input: tx.U16,
    cursor: i64,
}

fn exc_none() -> Exc {
    return Exc { kind: 0, msg: tx.u16_empty(), input: tx.u16_empty(), cursor: -1 }
}

fn exc_custom(a: *mut m.Arena, message: str) -> Exc {
    return Exc { kind: EX_CUSTOM, msg: tx.u16_from_str(a, message), input: tx.u16_empty(), cursor: -1 }
}

fn exc_custom_ctx(a: *mut m.Arena, message: str, input: tx.U16, cursor: usize) -> Exc {
    return Exc { kind: EX_CUSTOM, msg: tx.u16_from_str(a, message), input: input, cursor: cursor as i64 }
}

fn bounds_msg(a: *mut m.Arena, head: str, bound: tx.U16, found: tx.U16) -> tx.U16 {
    var b: m.Arr[u16] = tx.b16_new()
    tx.b16_ascii(a, &b, head)
    tx.b16_text(a, &b, bound)
    tx.b16_ascii(a, &b, ", found ")
    tx.b16_text(a, &b, found)
    return tx.b16_view(&b)
}

fn quoted_msg(a: *mut m.Arena, head: str, v: tx.U16, tail: str) -> tx.U16 {
    var b: m.Arr[u16] = tx.b16_new()
    tx.b16_ascii(a, &b, head)
    tx.b16_text(a, &b, v)
    tx.b16_ascii(a, &b, tail)
    return tx.b16_view(&b)
}

fn builtin_text(a: *mut m.Arena, kind: i32, arg0: tx.U16, arg1: tx.U16) -> tx.U16 {
    if kind == EX_DOUBLE_TOO_SMALL {
        return bounds_msg(a, "Double must not be less than ", arg1, arg0)
    }
    if kind == EX_DOUBLE_TOO_BIG {
        return bounds_msg(a, "Double must not be more than ", arg1, arg0)
    }
    if kind == EX_FLOAT_TOO_SMALL {
        return bounds_msg(a, "Float must not be less than ", arg1, arg0)
    }
    if kind == EX_FLOAT_TOO_BIG {
        return bounds_msg(a, "Float must not be more than ", arg1, arg0)
    }
    if kind == EX_INT_TOO_SMALL {
        return bounds_msg(a, "Integer must not be less than ", arg1, arg0)
    }
    if kind == EX_INT_TOO_BIG {
        return bounds_msg(a, "Integer must not be more than ", arg1, arg0)
    }
    if kind == EX_LONG_TOO_SMALL {
        return bounds_msg(a, "Long must not be less than ", arg1, arg0)
    }
    if kind == EX_LONG_TOO_BIG {
        return bounds_msg(a, "Long must not be more than ", arg1, arg0)
    }
    if kind == EX_LITERAL_INCORRECT {
        return quoted_msg(a, "Expected literal ", arg0, "")
    }
    if kind == EX_EXPECTED_START_OF_QUOTE {
        return quoted_msg(a, "Expected quote to start a string", tx.u16_empty(), "")
    }
    if kind == EX_EXPECTED_END_OF_QUOTE {
        return quoted_msg(a, "Unclosed quoted string", tx.u16_empty(), "")
    }
    if kind == EX_INVALID_ESCAPE {
        return quoted_msg(a, "Invalid escape sequence '", arg0, "' in quoted string")
    }
    if kind == EX_INVALID_BOOL {
        return quoted_msg(a, "Invalid bool, expected true or false but found '", arg0, "'")
    }
    if kind == EX_INVALID_INT {
        return quoted_msg(a, "Invalid integer '", arg0, "'")
    }
    if kind == EX_EXPECTED_INT {
        return quoted_msg(a, "Expected integer", tx.u16_empty(), "")
    }
    if kind == EX_INVALID_LONG {
        return quoted_msg(a, "Invalid long '", arg0, "'")
    }
    if kind == EX_EXPECTED_LONG {
        return quoted_msg(a, "Expected long", tx.u16_empty(), "")
    }
    if kind == EX_INVALID_DOUBLE {
        return quoted_msg(a, "Invalid double '", arg0, "'")
    }
    if kind == EX_EXPECTED_DOUBLE {
        return quoted_msg(a, "Expected double", tx.u16_empty(), "")
    }
    if kind == EX_INVALID_FLOAT {
        return quoted_msg(a, "Invalid float '", arg0, "'")
    }
    if kind == EX_EXPECTED_FLOAT {
        return quoted_msg(a, "Expected float", tx.u16_empty(), "")
    }
    if kind == EX_EXPECTED_BOOL {
        return quoted_msg(a, "Expected bool", tx.u16_empty(), "")
    }
    if kind == EX_EXPECTED_SYMBOL {
        return quoted_msg(a, "Expected '", arg0, "'")
    }
    if kind == EX_UNKNOWN_COMMAND {
        return quoted_msg(a, "Unknown command", tx.u16_empty(), "")
    }
    if kind == EX_UNKNOWN_ARGUMENT {
        return quoted_msg(a, "Incorrect argument for command", tx.u16_empty(), "")
    }
    if kind == EX_EXPECTED_ARG_SEPARATOR {
        return quoted_msg(a, "Expected whitespace to end one argument, but found trailing data", tx.u16_empty(), "")
    }
    if kind == EX_PARSE_EXCEPTION {
        return quoted_msg(a, "Could not parse command: ", arg0, "")
    }
    return tx.u16_empty()
}

fn exc_builtin(a: *mut m.Arena, kind: i32, input: tx.U16, cursor: usize, arg0: tx.U16, arg1: tx.U16) -> Exc {
    return Exc { kind: kind, msg: builtin_text(a, kind, arg0, arg1), input: input, cursor: cursor as i64 }
}

fn exc_raw(e: *mut Exc) -> tx.U16 {
    return (*e).msg
}

fn exc_context(a: *mut m.Arena, e: *mut Exc, out: *mut tx.U16) -> bool {
    if (*e).cursor < 0 {
        return false
    }
    var cursor: usize = (*e).cursor as usize
    if cursor > (*e).input.n {
        cursor = (*e).input.n
    }
    var b: m.Arr[u16] = tx.b16_new()
    if cursor > CONTEXT_AMOUNT {
        tx.b16_ascii(a, &b, "...")
    }
    var from: usize = 0
    if cursor > CONTEXT_AMOUNT {
        from = cursor - CONTEXT_AMOUNT
    }
    tx.b16_text(a, &b, tx.u16_sub((*e).input, from, cursor))
    tx.b16_ascii(a, &b, "<--[HERE]")
    *out = tx.b16_view(&b)
    return true
}

fn exc_message(a: *mut m.Arena, e: *mut Exc) -> tx.U16 {
    var ctx: tx.U16 = tx.u16_empty()
    if !exc_context(a, e, &ctx) {
        return (*e).msg
    }
    var b: m.Arr[u16] = tx.b16_new()
    tx.b16_text(a, &b, (*e).msg)
    tx.b16_ascii(a, &b, " at position ")
    tx.b16_i64(a, &b, (*e).cursor)
    tx.b16_ascii(a, &b, ": ")
    tx.b16_text(a, &b, ctx)
    return tx.b16_view(&b)
}
