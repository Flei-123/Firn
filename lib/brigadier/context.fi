// SPDX-License-Identifier: MIT
// lib/brigadier/context.fi -- brigadier.context: CommandContextBuilder / CommandContext in one arena struct (handles are u64 pointers, 0 = null).
import brigadier.mem as m
import brigadier.text as tx
import brigadier.argtype as at

export { Ctx, PArg, PNode, cx, ctx_new, ctx_copy, ctx_build, ctx_copy_for, ctx_with_node, ctx_with_arg, ctx_with_command,
    ctx_with_child, ctx_find_arg, ctx_last_child, ctx_find_suggestion, SuggCtx }

struct PArg {
    name: tx.U16,
    start: usize,
    end: usize,
    v: at.Value,
}

struct PNode {
    node: u64,
    start: usize,
    end: usize,
}

struct Ctx {
    source: i64,
    input: tx.U16,
    args: m.Arr[PArg],
    nodes: m.Arr[PNode],
    root: u64,
    start: usize,
    end: usize,
    child: u64,
    cmd: i32,
    mod_id: i32,
    forks: bool,
}

struct SuggCtx {
    parent: u64,
    start: usize,
}

fn cx(h: u64) -> *mut Ctx {
    return h as *mut Ctx
}

fn ctx_new(a: *mut m.Arena, source: i64, root: u64, start: usize) -> u64 {
    let h: u64 = m.arena_obj[Ctx](a)
    let c: *mut Ctx = cx(h)
    *c = Ctx {
        source: source,
        input: tx.u16_empty(),
        args: m.arr_new[PArg](),
        nodes: m.arr_new[PNode](),
        root: root,
        start: start,
        end: start,
        child: 0,
        cmd: 0,
        mod_id: 0,
        forks: false,
    }
    return h
}

fn ctx_copy(a: *mut m.Arena, h: u64) -> u64 {
    let n: u64 = m.arena_obj[Ctx](a)
    let c: *mut Ctx = cx(n)
    *c = *cx(h)
    (*c).args = m.arr_clone[PArg](a, &(*cx(h)).args)
    (*c).nodes = m.arr_clone[PNode](a, &(*cx(h)).nodes)
    return n
}

fn ctx_build(a: *mut m.Arena, h: u64, input: tx.U16) -> u64 {
    let n: u64 = ctx_copy(a, h)
    (*cx(n)).input = input
    if (*cx(h)).child != 0 {
        (*cx(n)).child = ctx_build(a, (*cx(h)).child, input)
    }
    return n
}

fn ctx_copy_for(a: *mut m.Arena, h: u64, source: i64) -> u64 {
    if (*cx(h)).source == source {
        return h
    }
    let n: u64 = m.arena_obj[Ctx](a)
    *cx(n) = *cx(h)
    (*cx(n)).source = source
    return n
}

fn ctx_with_node(a: *mut m.Arena, h: u64, node: u64, start: usize, end: usize, mod_id: i32, forks: bool) {
    let c: *mut Ctx = cx(h)
    m.arr_push[PNode](a, &(*c).nodes, PNode { node: node, start: start, end: end })
    if start < (*c).start {
        (*c).start = start
    }
    if end > (*c).end {
        (*c).end = end
    }
    (*c).mod_id = mod_id
    (*c).forks = forks
}

fn ctx_with_arg(a: *mut m.Arena, h: u64, name: tx.U16, start: usize, end: usize, v: at.Value) {
    let c: *mut Ctx = cx(h)
    var i: usize = 0
    while i < m.arr_len[PArg](&(*c).args) {
        let p: *mut PArg = m.arr_at[PArg](&(*c).args, i)
        if tx.u16_eq((*p).name, name) {
            (*p).start = start
            (*p).end = end
            (*p).v = v
            return
        }
        i = i + 1
    }
    m.arr_push[PArg](a, &(*c).args, PArg { name: name, start: start, end: end, v: v })
}

fn ctx_with_command(h: u64, cmd: i32) {
    (*cx(h)).cmd = cmd
}

fn ctx_with_child(h: u64, child: u64) {
    (*cx(h)).child = child
}

fn ctx_find_arg(h: u64, name: tx.U16) -> *mut PArg {
    let c: *mut Ctx = cx(h)
    var i: usize = 0
    while i < m.arr_len[PArg](&(*c).args) {
        let p: *mut PArg = m.arr_at[PArg](&(*c).args, i)
        if tx.u16_eq((*p).name, name) {
            return p
        }
        i = i + 1
    }
    return 0 as *mut PArg
}

fn ctx_last_child(h: u64) -> u64 {
    var c: u64 = h
    while (*cx(c)).child != 0 {
        c = (*cx(c)).child
    }
    return c
}

fn ctx_find_suggestion(h: u64, cursor: usize, out: *mut SuggCtx) -> bool {
    let c: *mut Ctx = cx(h)
    if (*c).start > cursor {
        return false
    }
    if (*c).end < cursor {
        if (*c).child != 0 {
            return ctx_find_suggestion((*c).child, cursor, out)
        }
        let n: usize = m.arr_len[PNode](&(*c).nodes)
        if n > 0 {
            let last: *mut PNode = m.arr_at[PNode](&(*c).nodes, n - 1)
            *out = SuggCtx { parent: (*last).node, start: (*last).end + 1 }
            return true
        }
        *out = SuggCtx { parent: (*c).root, start: (*c).start }
        return true
    }
    var prev: u64 = (*c).root
    var i: usize = 0
    while i < m.arr_len[PNode](&(*c).nodes) {
        let pn: *mut PNode = m.arr_at[PNode](&(*c).nodes, i)
        if (*pn).start <= cursor && cursor <= (*pn).end {
            *out = SuggCtx { parent: prev, start: (*pn).start }
            return true
        }
        prev = (*pn).node
        i = i + 1
    }
    *out = SuggCtx { parent: prev, start: (*c).start }
    return true
}
