// SPDX-License-Identifier: MIT
// lib/brigadier/text.fi -- brigadier.text: UTF-16 text views (Java string semantics), builders, case folding, UTF-8 conversion.
import std.rt
import brigadier.mem as m

export { U16, u16_empty, u16_at, u16_sub, u16_eq, u16_cmp, u16_cmp_ci, u16_hash, u16_lower, u16_starts_with, u16_from_str, u16_to_str, u16_clone, u16_is_empty, u16_concat, b16_new, b16_char, b16_text, b16_ascii, b16_str, b16_i64, b16_view, lower16, upper16, is_java_whitespace }

struct U16 {
    p: u64,
    n: usize,
}

fn u16_empty() -> U16 {
    return U16 { p: 0, n: 0 }
}

fn u16_is_empty(t: U16) -> bool {
    return t.n == 0
}

fn u16_at(t: U16, i: usize) -> u32 {
    return rt.ld16(t.p, i) as u32
}

fn u16_sub(t: U16, a: usize, b: usize) -> U16 {
    return U16 { p: t.p + ((a * 2) as u64), n: b - a }
}

fn u16_eq(a: U16, b: U16) -> bool {
    if a.n != b.n {
        return false
    }
    return a.n == 0 || rt.mem_eq(a.p, b.p, a.n * 2)
}

fn u16_cmp(a: U16, b: U16) -> i32 {
    var n: usize = a.n
    if b.n < n {
        n = b.n
    }
    var i: usize = 0
    while i < n {
        let x: u32 = u16_at(a, i)
        let y: u32 = u16_at(b, i)
        if x != y {
            return (x as i32) - (y as i32)
        }
        i = i + 1
    }
    return (a.n as i32) - (b.n as i32)
}

fn lower16(c: u32) -> u32 {
    if c >= 65 && c <= 90 {
        return c + 32
    }
    if c < 128 {
        return c
    }
    if c >= 0xC0 && c <= 0xDE && c != 0xD7 {
        return c + 32
    }
    if c >= 0x100 && c <= 0x137 && c != 0x130 {
        if c % 2 == 0 {
            return c + 1
        }
        return c
    }
    if c >= 0x139 && c <= 0x148 {
        if c % 2 == 1 {
            return c + 1
        }
        return c
    }
    if c >= 0x14A && c <= 0x177 {
        if c % 2 == 0 {
            return c + 1
        }
        return c
    }
    if c >= 0x391 && c <= 0x3A9 && c != 0x3A2 {
        return c + 32
    }
    if c >= 0x410 && c <= 0x42F {
        return c + 32
    }
    if c >= 0x400 && c <= 0x40F {
        return c + 80
    }
    return c
}

fn upper16(c: u32) -> u32 {
    if c >= 97 && c <= 122 {
        return c - 32
    }
    if c < 128 {
        return c
    }
    if c >= 0xE0 && c <= 0xFE && c != 0xF7 {
        return c - 32
    }
    if c == 0xFF {
        return 0x178
    }
    if c == 0xB5 {
        return 0x39C
    }
    if c >= 0x100 && c <= 0x137 && c != 0x131 {
        if c % 2 == 1 {
            return c - 1
        }
        return c
    }
    if c >= 0x139 && c <= 0x148 {
        if c % 2 == 0 {
            return c - 1
        }
        return c
    }
    if c >= 0x14A && c <= 0x177 {
        if c % 2 == 1 {
            return c - 1
        }
        return c
    }
    if c >= 0x3B1 && c <= 0x3C9 && c != 0x3C2 {
        return c - 32
    }
    if c >= 0x430 && c <= 0x44F {
        return c - 32
    }
    if c >= 0x450 && c <= 0x45F {
        return c - 80
    }
    return c
}

fn u16_cmp_ci(a: U16, b: U16) -> i32 {
    var n: usize = a.n
    if b.n < n {
        n = b.n
    }
    var i: usize = 0
    while i < n {
        var x: u32 = u16_at(a, i)
        var y: u32 = u16_at(b, i)
        if x != y {
            x = upper16(x)
            y = upper16(y)
            if x != y {
                x = lower16(x)
                y = lower16(y)
                if x != y {
                    return (x as i32) - (y as i32)
                }
            }
        }
        i = i + 1
    }
    return (a.n as i32) - (b.n as i32)
}

fn u16_hash(t: U16) -> i32 {
    var h: u32 = 0
    var i: usize = 0
    while i < t.n {
        h = (h *% 31) +% u16_at(t, i)
        i = i + 1
    }
    return h as i32
}

fn u16_starts_with(t: U16, prefix: U16) -> bool {
    if prefix.n > t.n {
        return false
    }
    return prefix.n == 0 || rt.mem_eq(t.p, prefix.p, prefix.n * 2)
}

fn u16_clone(a: *mut m.Arena, t: U16) -> U16 {
    if t.n == 0 {
        return u16_empty()
    }
    let p: u64 = m.arena_alloc(a, t.n * 2)
    rt.mem_copy(p, t.p, t.n * 2)
    return U16 { p: p, n: t.n }
}

fn u16_lower(a: *mut m.Arena, t: U16) -> U16 {
    if t.n == 0 {
        return u16_empty()
    }
    let p: u64 = m.arena_alloc(a, t.n * 2)
    var i: usize = 0
    while i < t.n {
        rt.st16(p, i, lower16(u16_at(t, i)) as u16)
        i = i + 1
    }
    return U16 { p: p, n: t.n }
}

fn u16_concat(a: *mut m.Arena, x: U16, y: U16) -> U16 {
    let n: usize = x.n + y.n
    if n == 0 {
        return u16_empty()
    }
    let p: u64 = m.arena_alloc(a, n * 2)
    if x.n > 0 {
        rt.mem_copy(p, x.p, x.n * 2)
    }
    if y.n > 0 {
        rt.mem_copy(p + ((x.n * 2) as u64), y.p, y.n * 2)
    }
    return U16 { p: p, n: n }
}

fn is_java_whitespace(c: u32) -> bool {
    if c >= 9 && c <= 13 {
        return true
    }
    if c >= 0x1C && c <= 0x20 {
        return true
    }
    if c == 0x1680 || c == 0x2028 || c == 0x2029 || c == 0x205F || c == 0x3000 {
        return true
    }
    if c >= 0x2000 && c <= 0x200A && c != 0x2007 {
        return true
    }
    return false
}

fn u16_from_str(a: *mut m.Arena, s: str) -> U16 {
    if s.n == 0 {
        return u16_empty()
    }
    let p: u64 = m.arena_alloc(a, s.n * 2 + 2)
    var out: usize = 0
    var i: usize = 0
    let base: u64 = s.p as u64
    while i < s.n {
        let b0: u32 = rt.ld8(base, i) as u32
        var cp: u32 = 0xFFFD
        var len: usize = 1
        if b0 < 0x80 {
            cp = b0
        } else if b0 >= 0xC2 && b0 < 0xE0 && i + 1 < s.n {
            let b1: u32 = rt.ld8(base, i + 1) as u32
            if (b1 & 0xC0) == 0x80 {
                cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F)
                len = 2
            }
        } else if b0 >= 0xE0 && b0 < 0xF0 && i + 2 < s.n {
            let b1: u32 = rt.ld8(base, i + 1) as u32
            let b2: u32 = rt.ld8(base, i + 2) as u32
            if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 {
                cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
                len = 3
            }
        } else if b0 >= 0xF0 && b0 < 0xF5 && i + 3 < s.n {
            let b1: u32 = rt.ld8(base, i + 1) as u32
            let b2: u32 = rt.ld8(base, i + 2) as u32
            let b3: u32 = rt.ld8(base, i + 3) as u32
            if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 && (b3 & 0xC0) == 0x80 {
                cp = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
                len = 4
            }
        }
        if cp >= 0x10000 {
            let v: u32 = cp - 0x10000
            rt.st16(p, out, (0xD800 + (v >> 10)) as u16)
            rt.st16(p, out + 1, (0xDC00 + (v & 0x3FF)) as u16)
            out = out + 2
        } else {
            rt.st16(p, out, cp as u16)
            out = out + 1
        }
        i = i + len
    }
    return U16 { p: p, n: out }
}

fn push_utf8(b: *mut rt.Buf, cp: u32) {
    if cp < 0x80 {
        rt.buf_push(b, cp as u8)
    } else if cp < 0x800 {
        rt.buf_push(b, (0xC0 | (cp >> 6)) as u8)
        rt.buf_push(b, (0x80 | (cp & 0x3F)) as u8)
    } else if cp < 0x10000 {
        rt.buf_push(b, (0xE0 | (cp >> 12)) as u8)
        rt.buf_push(b, (0x80 | ((cp >> 6) & 0x3F)) as u8)
        rt.buf_push(b, (0x80 | (cp & 0x3F)) as u8)
    } else {
        rt.buf_push(b, (0xF0 | (cp >> 18)) as u8)
        rt.buf_push(b, (0x80 | ((cp >> 12) & 0x3F)) as u8)
        rt.buf_push(b, (0x80 | ((cp >> 6) & 0x3F)) as u8)
        rt.buf_push(b, (0x80 | (cp & 0x3F)) as u8)
    }
}

fn u16_to_str(a: *mut m.Arena, t: U16) -> str {
    if t.n == 0 {
        return ""
    }
    var b: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < t.n {
        let c: u32 = u16_at(t, i)
        if c >= 0xD800 && c < 0xDC00 && i + 1 < t.n && u16_at(t, i + 1) >= 0xDC00 && u16_at(t, i + 1) < 0xE000 {
            let lo: u32 = u16_at(t, i + 1)
            push_utf8(&b, 0x10000 + ((c - 0xD800) << 10) + (lo - 0xDC00))
            i = i + 2
        } else if c >= 0xD800 && c < 0xE000 {
            rt.buf_push(&b, 63 as u8)
            i = i + 1
        } else {
            push_utf8(&b, c)
            i = i + 1
        }
    }
    let n: usize = rt.buf_len(&b)
    let p: u64 = m.arena_alloc(a, n + 1)
    rt.mem_copy(p, rt.buf_ptr(&b), n)
    rt.buf_free(&b)
    return str { p: p as *mut u8, n: n }
}

fn b16_new() -> m.Arr[u16] {
    return m.arr_new[u16]()
}

fn b16_char(a: *mut m.Arena, b: *mut m.Arr[u16], c: u32) {
    m.arr_push[u16](a, b, c as u16)
}

fn b16_text(a: *mut m.Arena, b: *mut m.Arr[u16], t: U16) {
    var i: usize = 0
    while i < t.n {
        m.arr_push[u16](a, b, u16_at(t, i) as u16)
        i = i + 1
    }
}

fn b16_str(a: *mut m.Arena, b: *mut m.Arr[u16], s: str) {
    let t: U16 = u16_from_str(a, s)
    b16_text(a, b, t)
}

fn b16_ascii(a: *mut m.Arena, b: *mut m.Arr[u16], s: str) {
    var i: usize = 0
    while i < s.n {
        m.arr_push[u16](a, b, rt.ld8(s.p as u64, i) as u16)
        i = i + 1
    }
}

fn b16_i64(a: *mut m.Arena, b: *mut m.Arr[u16], v: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    var i: usize = 0
    while i < rt.buf_len(&t) {
        m.arr_push[u16](a, b, rt.buf_at(&t, i) as u16)
        i = i + 1
    }
    rt.buf_free(&t)
}

fn b16_view(b: *mut m.Arr[u16]) -> U16 {
    return U16 { p: (*b).p, n: (*b).n }
}
