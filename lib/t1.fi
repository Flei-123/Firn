import std.io
import std.math

struct S {
    a: [[f32; 4]; 3],
    b: [f32; 8],
}

fn main() -> i32 {
    var s: S = S { a: [[0.0f; 4]; 3], b: [0.0f; 8] }
    s.a[1][2] = 3.5f
    s.b[0] = s.a[1][2] * 2.0f
    var x: f64 = math.cos(0.5)
    var i: i32 = (s.b[0] as f64 + x * 10.0) as i32
    io.print_line("ok")
    return i
}
