// SPDX-License-Identifier: MPL-2.0
// lib/tls/tlsmini_main.fi -- lib/tls/tlsmini.fi as a PROGRAM (for tests).
//
//     tlsmini_main <ipv4> <port> <pin hex> [sni]
//
// Connects, runs the handshake with the pin, copies every octet of
// application data to stdout until the peer closes. stderr gets
//   `ERR <code>`          the handshake failed (exit 1)
//   `END <n>`             the read that ended it: 0 = clean close, < 0 = error
// exit 0 after a clean close, 3 after a read error.
import std.rt
import net.dns
import tls.tlsmini

fn parse_u32(p: u64, n: usize) -> u32 {
    var v: u32 = 0
    var i: usize = 0
    while i < n {
        v = v * 10 as u32 + (rt.ld8(p, i) - 48 as u8) as u32
        i = i + 1
    }
    return v
}

fn say(msg: u64, mlen: usize, v: i64) {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b, msg, mlen)
    if v < 0 {
        rt.buf_push(&b, 45 as u8)
        rt.buf_push_dec_u64(&b, (0 - v) as u64)
    } else {
        rt.buf_push_dec_u64(&b, v as u64)
    }
    rt.buf_push(&b, 10 as u8)
    rt.write_everything(2, b.ptr, b.len)
    rt.buf_free(&b)
}

fn main(start: u64) -> i32 {
    var m_err: [u8; 4] = "ERR "
    var m_hs: [u8; 6] = "HS OK "
    var m_end: [u8; 4] = "END "
    if rt.arg_count(start) < 4 {
        return 2
    }
    let ip_p: u64 = rt.arg_ptr(start, 1)
    var ip: u32 = 0
    if !dns.dns_parse_ipv4(ip_p, rt.c_length(ip_p), &ip) {
        return 2
    }
    let pp: u64 = rt.arg_ptr(start, 2)
    let port: u32 = parse_u32(pp, rt.c_length(pp))
    let hp: u64 = rt.arg_ptr(start, 3)
    var pin: [u8; 32] = [0 as u8; 32]
    if !tlsmini.tlsm_hex_pin(hp, rt.c_length(hp), (&pin[0]) as u64) {
        return 2
    }
    var sni: u64 = 0
    var snil: usize = 0
    if rt.arg_count(start) > 4 {
        sni = rt.arg_ptr(start, 4)
        snil = rt.c_length(sni)
    }
    let fd: i64 = syscall(41, 2, 1, 0, 0, 0, 0)
    var sa: [u8; 16] = [0 as u8; 16]
    sa[0] = 2 as u8
    sa[2] = ((port >> 8) & 255 as u32) as u8
    sa[3] = (port & 255 as u32) as u8
    sa[4] = (ip >> 24) as u8
    sa[5] = ((ip >> 16) & 255 as u32) as u8
    sa[6] = ((ip >> 8) & 255 as u32) as u8
    sa[7] = (ip & 255 as u32) as u8
    if fd < 0 || syscall(42, fd, (&sa[0]) as i64, 16, 0, 0, 0) != 0 {
        say((&m_err[0]) as u64, 4, 1 as i64)
        return 1
    }
    var t: tlsmini.TlsM = tlsmini.tlsm_new()
    let rc: i32 = tlsmini.tlsm_handshake(&t, fd, sni, snil, (&pin[0]) as u64)
    if rc != 0 {
        say((&m_err[0]) as u64, 4, rc as i64)
        return 1
    }
    say((&m_hs[0]) as u64, 6, 0 as i64)
    var buf: [u8; 700] = [0 as u8; 700]
    while true {
        let n: i64 = tlsmini.tlsm_read(&t, (&buf[0]) as u64, 700)
        if n > 0 {
            rt.write_everything(1, (&buf[0]) as u64, n as usize)
        } else {
            say((&m_end[0]) as u64, 4, n)
            if n == 0 as i64 {
                return 0
            }
            return 3
        }
    }
    return 0
}
