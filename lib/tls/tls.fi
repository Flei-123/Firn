// SPDX-License-Identifier: MPL-2.0
// Origin: Firn branch dns-pic (commit dd9d62e1), round B5; released for
// main under MPL-2.0 by its sole author Justin (see LICENSING.md).
// lib/tls/tls.fi -- a TLS 1.3 client (RFC 8446), round B5.
//
// Round B4 refused `https://` on purpose and wrote down what it would
// take. This is that: the record layer, the handshake, and the point where
// the certificate chain of `x509.fi` is actually consulted.
//
// ============================================================== THE SHAPE
//
// TLS 1.3 is one round trip. The client sends everything it can offer at
// once -- versions, cipher suites, groups, AND a key share for the group it
// expects to be chosen. The server answers with its own share, and from
// that moment on EVERYTHING is encrypted, including the server's
// certificate. Compare TLS 1.2, where the certificate travelled in the
// clear and a passive observer learned which site was being visited from
// it; here they learn it only from the SNI in the ClientHello, which is
// the one thing still in the open.
//
//     -> ClientHello            + key_share
//     <- ServerHello            + key_share
//        --- from here on encrypted with the handshake keys ---
//     <- EncryptedExtensions
//     <- Certificate
//     <- CertificateVerify      the proof that the peer holds the key
//     <- Finished               the proof that the transcript was not touched
//     -> Finished
//        --- from here on encrypted with the application keys ---
//
// THE TWO SIGNATURES DO DIFFERENT JOBS and both are checked here:
//   * the certificate chain says WHO the key belongs to
//     (`x509.verify_chain`);
//   * `CertificateVerify` says the peer HOLDS that key, by signing the
//     transcript so far. Without it, anybody could replay a certificate
//     they picked up somewhere.
//   * `Finished` says the whole transcript arrived unmodified, keyed with
//     a secret that only the two ends have. That is what makes a downgrade
//     impossible: a man in the middle who strips a cipher suite out of the
//     ClientHello changes the transcript, and the MAC no longer matches.
//
// ========================================================== WHAT IS OFFERED
//
// Two cipher suites -- `TLS_AES_128_GCM_SHA256` (mandatory, RFC 8446 9.1)
// and `TLS_CHACHA20_POLY1305_SHA256` -- and TWO groups, X25519 and
// secp256r1. That is a deliberately narrow offer. Every group and suite in
// a ClientHello is a code path that has to be right.
//
// secp256r1 was added in round DNS because X25519 alone is NOT enough: the
// Mojang launcher meta host (piston-meta.mojang.com, Azure Front Door)
// has no X25519 and answers an X25519-only ClientHello with
// handshake_failure -- measured with `openssl s_client -groups X25519`.
// Both key shares go out in the first flight (the way Go and Chrome do),
// so no HelloRetryRequest is needed. The secp256r1 shared secret is the
// X coordinate of d*Q (RFC 8446 7.4.2) and the server's point is checked to
// lie on the curve first (`ecdsa.point_valid`).
//
// ==================================================================== HONEST
//
// T1 NO SESSION RESUMPTION, no 0-RTT, no PSK. Every connection is a full
//    handshake. `NewSessionTicket` is read and thrown away.
// T2 NO KEY UPDATE (see `keys.fi` K2). A `key_update` from the server ends
//    the connection with an alert instead of being ignored.
// T3 NO CLIENT CERTIFICATE. A `CertificateRequest` is answered with an
//    empty Certificate message, which is what a client without one must
//    do -- not with an alert, because plenty of servers ask optionally.
// T4 NO HELLO RETRY REQUEST. It is DETECTED (the magic random of
//    RFC 8446 4.1.3) and reported as `Retry`, not misread as a
//    ServerHello. Since only X25519 is offered and every server has it,
//    the only reason left is a cookie, which no ordinary web server
//    sends.
// T5 THE RECORD LAYER DOES NOT PAD. Outgoing records carry exactly their
//    content plus the one type octet. Padding would hide the length of a
//    request from a passive observer; not padding is what every browser
//    does today and what this round measures.
// N1 NON-BLOCKING MODE (round ASYNC, `tls_set_nonblocking`). The handshake
//    is a state machine (`tls_handshake_step`): every call does as much as
//    the octets that have arrived allow and answers `TlsError::WouldBlock`
//    when it needs more -- nothing is lost, the next call goes on where this
//    one stopped. `tls_handshake` is the same machine run in a loop, so
//    both modes execute the SAME code. The socket must be non-blocking
//    (std.net `set_nonblocking`); the caller waits for it to become readable
//    (or writable, when `tls_out_pending` > 0) and calls again.
// N2 OUTPUT IS BUFFERED in non-blocking mode: `tls_write` encrypts into an
//    internal buffer and tries to send it at once; what the kernel does not
//    take stays there until `tls_flush`. A caller that writes a lot should
//    look at `tls_out_pending` and stop feeding while it is large.
// N3 ONE RECORD AT A TIME: a record that has arrived only in part waits in
//    the read buffer (`read_record` consumes nothing before the whole record
//    stands there), so a `WouldBlock` in the middle of a record loses nothing.
// N4 `tls_read` answers `WouldBlock` for "nothing more right now" and 0 for
//    "the peer is done", exactly as read(2) does on a non-blocking socket.
// T7 TLS 1.2 (round TLS12). The ONE ClientHello offers both versions
//    (`supported_versions` 1.3 and 1.2, plus the 1.2 suites); the server's
//    choice decides, there is NO second connection and NO retry with an
//    older version -- a "fallback dance" is exactly what downgrade attacks
//    (POODLE) use. A server that picked 1.2 while it also speaks 1.3 says so
//    in the last eight octets of its random ("DOWNGRD"); that is refused with
//    `Downgrade`. The 1.2 suites are ECDHE only (ECDSA and RSA certificates)
//    with AES-128-GCM, AES-256-GCM and ChaCha20-Poly1305; the groups are the
//    two offered above. The EXTENDED MASTER SECRET (RFC 7627) is offered and
//    used whenever the server echoes it. A server without it (OpenSSL before
//    1.1.0, e.g. badssl.com's nginx 1.10) is still accepted, with the plain
//    master secret: the attack the extension closes (triple handshake)
//    needs a renegotiation or a resumed session, and this client does neither.
//    `tls_require_ems(t, true)` refuses such servers (`Unsupported`).
//    No renegotiation: a HelloRequest is answered with a no_renegotiation
//    alert. No resumption (T1), no static RSA, no DHE, no CBC, no
//    TLS 1.0/1.1, no client certificate (T3). `tls_set_max_version(t, 771)`
//    makes the client offer 1.2 only (for servers that choke on 1.3 and for
//    tests); `tls_version(t)` says what was negotiated (771 or 772).
// T6 A CLOSE WITHOUT `close_notify` is reported as a clean end of stream
//    for the body, because a large part of the web does exactly that and
//    treating it as an error means failing on pages that work everywhere
//    else. It is noted in `tls_truncated` so that a caller who cares --
//    one that has a Content-Length, say -- can tell the difference.
import std.rt
import std.net
import std.crypto.sha256
import std.crypto.hmac
import std.crypto.random
import std.crypto.x25519
import std.crypto.chacha
import std.crypto.gcm
import std.crypto.rsa
import std.crypto.ecdsa
import std.crypto.p256
import tls.keys
import tls.x509
import tls.prf12

export {
    TlsError, Tls,
    tls_new, tls_init, tls_free, tls_handshake, tls_read, tls_write,
    tls_close, tls_established, tls_verify_reason, tls_suite,
    tls_alpn_ptr, tls_alpn_len, tls_truncated, tls_records_in,
    tls_records_out, tls_handshake_bytes, tls_peer_cert_count,
    tls_alert_desc, tls_chain_depth, tls_err_num, tls_err_name,
    tls_fail_into, tls_fail_len,
    tls_version, tls_set_max_version, tls_ems, tls_require_ems,
    SUITE_AES128GCM, SUITE_CHACHA20,
    // round ASYNC -- non-blocking mode (see N1..N4 below)
    tls_set_nonblocking, tls_handshake_step, tls_flush, tls_out_pending,
    tls_is_nonblocking, tls_closed, tls_note_error,
    SUITE12_ECDSA_AES128GCM, SUITE12_ECDSA_AES256GCM, SUITE12_RSA_AES128GCM,
    SUITE12_RSA_AES256GCM, SUITE12_ECDSA_CHACHA20, SUITE12_RSA_CHACHA20,
}

error TlsError {
    Io, // the socket failed
    Closed, // the peer went away in the middle of the handshake
    Protocol, // a message this client cannot make sense of
    Version, // the server did not choose TLS 1.3
    Group, // the server chose a group that was not offered
    Suite, // ... or a cipher suite that was not offered
    Retry, // HelloRetryRequest -- see T4
    Alert, // the server sent a fatal alert
    Certificate, // the chain did not verify; the reason is in `verify`
    Signature, // CertificateVerify did not check out
    Finished, // the transcript MAC did not match
    Decrypt, // a record did not authenticate
    Unsupported, // an algorithm this round does not have
    TooLarge,
    Random, // the kernel would not give randomness
    WouldBlock, // non-blocking mode: no more octets right now, call again
    Downgrade, // a TLS 1.3 capable server answered with 1.2 (RFC 8446 4.1.3)
}

const SUITE_AES128GCM: u32 = 4865 // 0x1301
const SUITE_CHACHA20: u32 = 4867 // 0x1303
// TLS 1.2 (ECDHE, AEAD only)
const SUITE12_ECDSA_AES128GCM: u32 = 49195 // 0xc02b
const SUITE12_ECDSA_AES256GCM: u32 = 49196 // 0xc02c
const SUITE12_RSA_AES128GCM: u32 = 49199 // 0xc02f
const SUITE12_RSA_AES256GCM: u32 = 49200 // 0xc030
const SUITE12_ECDSA_CHACHA20: u32 = 52393 // 0xcca9
const SUITE12_RSA_CHACHA20: u32 = 52392 // 0xcca8

const REC_CHANGE_CIPHER: u32 = 20
const REC_ALERT: u32 = 21
const REC_HANDSHAKE: u32 = 22
const REC_APPDATA: u32 = 23

const HS_CLIENT_HELLO: u32 = 1
const HS_HELLO_REQUEST: u32 = 0
const HS_SERVER_HELLO: u32 = 2
const HS_NEW_TICKET: u32 = 4
const HS_ENCRYPTED_EXT: u32 = 8
const HS_CERTIFICATE: u32 = 11
const HS_CERT_REQUEST: u32 = 13
const HS_CERT_VERIFY: u32 = 15
const HS_SERVER_KEY_EXCHANGE: u32 = 12
const HS_SERVER_HELLO_DONE: u32 = 14
const HS_CLIENT_KEY_EXCHANGE: u32 = 16
const HS_FINISHED: u32 = 20
const HS_KEY_UPDATE: u32 = 24

const MAX_RECORD: usize = 16640 // 2^14 plus the AEAD expansion
const MAX_HANDSHAKE: usize = 65536
const MAX_CERTS: usize = 10

struct Tls {
    conn: *mut net.Conn,
    store: *mut x509.Store,
    rbuf: rt.Buf, // raw octets from the socket
    rpos: usize,
    rec: rt.Buf, // the current record, decrypted
    hsin: rt.Buf, // handshake octets not yet cut into messages
    hspos: usize,
    // The Certificate message, copied out of `hsin` and kept still. The
    // `Cert` structures point INTO it, and `hsin` is compacted and
    // reallocated while the rest of the handshake arrives -- so parsing
    // the certificates where they landed leaves every one of those
    // pointers dangling. That is not a hypothetical: it is what made the
    // first run of this client report `Signature` on a handshake whose
    // signature was perfectly good.
    certbuf: rt.Buf,
    tr: rt.Buf, // the transcript: every handshake message, in order
    app: rt.Buf, // decrypted application data waiting for the caller
    apos: usize,
    host: [u8; 256],
    hostlen: usize,
    alpn: [u8; 32],
    alpnlen: usize,
    suite: u32,
    keylen: usize,
    ckey: [u8; 32],
    civ: [u8; 12],
    cseq: u64,
    skey: [u8; 32],
    siv: [u8; 12],
    sseq: u64,
    have_keys: bool,
    hs_secret: [u8; 32],
    ms_secret: [u8; 32],
    c_hs_secret: [u8; 32],
    s_hs_secret: [u8; 32],
    priv: [u8; 32],
    pub_key: [u8; 32],
    p256_priv: [u8; 32], // the secp256r1 share, offered next to X25519
    p256_pub: [u8; 65], // 04 || X || Y
    group: u32, // the group the server chose: 29 X25519, 23 secp256r1
    established: bool,
    truncated: bool,
    closed: bool,
    verify: u32,
    chain_depth: usize,
    ncerts: usize,
    alert_desc: u32,
    now: u64,
    records_in: usize,
    records_out: usize,
    hs_bytes: usize,
    // round ASYNC: non-blocking mode and the state of the handshake machine
    nb: bool,
    blocked: bool, // the last `fill` found no octets (EAGAIN)
    wbuf: rt.Buf, // octets that still have to go to the socket (N2)
    wpos: usize,
    hs_step: u32, // 0 start, 1 ServerHello, 2 server flight, 3 done
    hs_have_cert: bool,
    hs_verified: bool,
    hs_fin: bool,
    certs: [x509.Cert; 10],
    hs_have_ske: bool, // TLS 1.2: the ServerKeyExchange arrived and verified
    hs_cert_req: bool, // TLS 1.2: the server asked for a client certificate
    hs_done12: bool, // TLS 1.2: the ServerHelloDone arrived
    // ---- TLS 1.2 (round TLS12)
    max_ver: u32, // 772 (offer 1.3 and 1.2) or 771 (1.2 only)
    v12: bool, // the server chose TLS 1.2
    rx12: bool, // the server's records are encrypted (after its ChangeCipherSpec)
    tx12: bool, // ours are (after ours)
    ems: bool, // the server echoed extended_master_secret
    prf: u32, // prf12.PRF_SHA256 / PRF_SHA384
    crandom: [u8; 32],
    srandom: [u8; 32],
    csid: [u8; 32], // the legacy_session_id we sent
    master: [u8; 48],
    peer_pub: [u8; 65], // the server's ephemeral share (ServerKeyExchange)
    peer_pub_len: usize,
    reneg_ok: bool, // renegotiation_info seen in the ServerHello
    require_ems: bool, // refuse a TLS 1.2 server that does not echo the extension
}

fn tls_new() -> Tls {
    return Tls { conn: 0 as *mut net.Conn, store: 0 as *mut x509.Store,
        rbuf: rt.buf_new(), rpos: 0, rec: rt.buf_new(),
        hsin: rt.buf_new(), hspos: 0, certbuf: rt.buf_new(),
        tr: rt.buf_new(), app: rt.buf_new(),
        apos: 0, host: [0; 256], hostlen: 0, alpn: [0; 32], alpnlen: 0,
        suite: 0, keylen: 0, ckey: [0; 32], civ: [0; 12], cseq: 0,
        skey: [0; 32], siv: [0; 12], sseq: 0, have_keys: false,
        hs_secret: [0; 32], ms_secret: [0; 32], c_hs_secret: [0; 32],
        s_hs_secret: [0; 32], priv: [0; 32], pub_key: [0; 32],
        p256_priv: [0; 32], p256_pub: [0; 65], group: 0 as u32,
        established: false, truncated: false, closed: false,
        verify: x509.V_PARSE, chain_depth: 0, ncerts: 0, alert_desc: 0,
        now: 0, records_in: 0, records_out: 0, hs_bytes: 0,
        nb: false, blocked: false, wbuf: rt.buf_new(), wpos: 0, hs_step: 0 as u32,
        hs_have_cert: false, hs_verified: false, hs_fin: false,
        certs: [x509.cert_new(); 10],
        hs_have_ske: false, hs_cert_req: false, hs_done12: false,
        max_ver: 772 as u32, v12: false, rx12: false, tx12: false, ems: false,
        prf: prf12.PRF_SHA256, crandom: [0; 32], srandom: [0; 32], csid: [0; 32],
        master: [0; 48], peer_pub: [0; 65], peer_pub_len: 0, reneg_ok: false,
        require_ems: false }
}

// 772 (the default: offer TLS 1.3 and 1.2) or 771 (offer 1.2 only). Before
// `tls_handshake`.
fn tls_set_max_version(t: *mut Tls, v: u32) {
    if v == 771 as u32 {
        (*t).max_ver = 771 as u32
    } else {
        (*t).max_ver = 772 as u32
    }
}

// The negotiated version: 772 (TLS 1.3), 771 (TLS 1.2), 0 before the handshake.
fn tls_version(t: *mut Tls) -> u32 {
    if !(*t).established {
        return 0 as u32
    }
    if (*t).v12 {
        return 771 as u32
    }
    return 772 as u32
}

// TLS 1.2: did the server echo extended_master_secret (RFC 7627), i.e. is the
// master secret of this connection bound to its handshake?
fn tls_ems(t: *mut Tls) -> bool {
    return (*t).ems
}

// TLS 1.2: refuse servers that do not echo extended_master_secret. Before
// `tls_handshake`.
fn tls_require_ems(t: *mut Tls, on: bool) {
    (*t).require_ems = on
}

fn tls_init(t: *mut Tls, conn: *mut net.Conn, store: *mut x509.Store,
    host: u64, hostlen: usize, now: u64) -> bool {
    if hostlen > 255 {
        return false
    }
    (*t).conn = conn
    (*t).store = store
    var i: usize = 0
    while i < hostlen {
        (*t).host[i] = rt.ld8(host, i)
        i = i + 1
    }
    (*t).hostlen = hostlen
    (*t).now = now
    return true
}

fn tls_free(t: *mut Tls) {
    rt.buf_free(&(*t).rbuf)
    rt.buf_free(&(*t).rec)
    rt.buf_free(&(*t).hsin)
    rt.buf_free(&(*t).certbuf)
    rt.buf_free(&(*t).tr)
    rt.buf_free(&(*t).app)
    rt.buf_free(&(*t).wbuf)
}

fn tls_established(t: *mut Tls) -> bool {
    return (*t).established
}

fn tls_verify_reason(t: *mut Tls) -> u32 {
    return (*t).verify
}

fn tls_chain_depth(t: *mut Tls) -> usize {
    return (*t).chain_depth
}

fn tls_peer_cert_count(t: *mut Tls) -> usize {
    return (*t).ncerts
}

fn tls_suite(t: *mut Tls) -> u32 {
    return (*t).suite
}

fn tls_alpn_ptr(t: *mut Tls) -> u64 {
    return (&(*t).alpn[0]) as u64
}

fn tls_alpn_len(t: *mut Tls) -> usize {
    return (*t).alpnlen
}

fn tls_truncated(t: *mut Tls) -> bool {
    return (*t).truncated
}

fn tls_records_in(t: *mut Tls) -> usize {
    return (*t).records_in
}

fn tls_records_out(t: *mut Tls) -> usize {
    return (*t).records_out
}

fn tls_handshake_bytes(t: *mut Tls) -> usize {
    return (*t).hs_bytes
}

fn tls_alert_desc(t: *mut Tls) -> u32 {
    return (*t).alert_desc
}

// ------------------------------------------------------------- The socket

const RD_ERR: usize = 18446744073709551615

// Ensures at least `need` octets stand at `rpos`. False at a clean end of
// stream; `err` tells a failure apart from an end.
fn fill(t: *mut Tls, need: usize, err: *mut bool) -> bool {
    *err = false
    (*t).blocked = false
    while (*t).rbuf.len - (*t).rpos < need {
        // compact, so that a long connection does not grow the buffer
        if (*t).rpos > 0 && (*t).rpos == (*t).rbuf.len {
            rt.buf_clear(&(*t).rbuf)
            (*t).rpos = 0
        }
        let have: usize = (*t).rbuf.len
        rt.buf_reserve(&(*t).rbuf, have + MAX_RECORD)
        if (*t).rbuf.cap < have + MAX_RECORD {
            *err = true
            return false
        }
        var k: usize = 0
        if (*t).nb {
            (*(*t).conn).err = 0
            k = net.read_nb((*t).conn, (*t).rbuf.ptr + have as u64,
                MAX_RECORD) catch RD_ERR
            if k == RD_ERR && net.conn_error((*t).conn) == 0 - 11 {
                // EAGAIN (N1): not an error, not the end -- come back later
                (*t).blocked = true
                return false
            }
        } else {
            k = net.read((*t).conn, (*t).rbuf.ptr + have as u64,
                MAX_RECORD) catch RD_ERR
        }
        if k == RD_ERR {
            *err = true
            return false
        }
        if k == 0 {
            return false
        }
        rt.buf_set_len(&(*t).rbuf, have + k)
    }
    return true
}

// Sends what is in `wbuf`; false only on a real error. EAGAIN leaves the
// rest there for the next call (N2).
fn flush_nb(t: *mut Tls) -> bool {
    while (*t).wpos < (*t).wbuf.len {
        (*(*t).conn).err = 0
        let k: usize = net.write_nb((*t).conn, (*t).wbuf.ptr + (*t).wpos as u64,
            (*t).wbuf.len - (*t).wpos) catch RD_ERR
        if k == RD_ERR {
            if net.conn_error((*t).conn) == 0 - 11 {
                return true
            }
            return false
        }
        if k == 0 {
            return false
        }
        (*t).wpos = (*t).wpos + k
    }
    rt.buf_clear(&(*t).wbuf)
    (*t).wpos = 0
    return true
}

fn send_raw(t: *mut Tls, p: u64, n: usize) -> bool {
    if (*t).nb {
        rt.buf_push_bytes(&(*t).wbuf, p, n)
        return flush_nb(t)
    }
    let k: usize = net.write_all((*t).conn, p, n) catch RD_ERR
    return k == n
}

// Non-blocking mode (N1): the socket must be non-blocking already.
fn tls_set_nonblocking(t: *mut Tls, on: bool) {
    (*t).nb = on
}

fn tls_is_nonblocking(t: *mut Tls) -> bool {
    return (*t).nb
}

fn tls_closed(t: *mut Tls) -> bool {
    return (*t).closed
}

// Octets encrypted and waiting for the socket (N2).
fn tls_out_pending(t: *mut Tls) -> usize {
    return (*t).wbuf.len - (*t).wpos
}

// Tries to send them. true = no error (octets may remain: see
// `tls_out_pending`); false = the socket failed.
fn tls_flush(t: *mut Tls) -> bool {
    if !(*t).nb {
        return true
    }
    return flush_nb(t)
}

// -------------------------------------------------------- The record layer

fn be16(p: u64, off: usize) -> u32 {
    return ((rt.ld8(p, off) as u32) << 8) | (rt.ld8(p, off + 1) as u32)
}

fn be24(p: u64, off: usize) -> usize {
    return ((rt.ld8(p, off) as usize) << 16)
    | ((rt.ld8(p, off + 1) as usize) << 8) | (rt.ld8(p, off + 2) as usize)
}

fn push16(b: *mut rt.Buf, v: u32) {
    rt.buf_push(b, ((v >> 8) & 255 as u32) as u8)
    rt.buf_push(b, (v & 255 as u32) as u8)
}

fn push24(b: *mut rt.Buf, v: usize) {
    rt.buf_push(b, ((v >> 16) & 255) as u8)
    rt.buf_push(b, ((v >> 8) & 255) as u8)
    rt.buf_push(b, (v & 255) as u8)
}

// The per-record nonce: the static IV xored with the sequence number,
// right-aligned (RFC 8446 5.3). The sequence number is NEVER sent -- both
// ends count, and a record that arrives out of order simply fails to
// decrypt, which is what makes a replay impossible.
fn make_nonce(iv: u64, seq: u64, out: u64) {
    var i: usize = 0
    while i < 12 {
        rt.st8(out, i, rt.ld8(iv, i))
        i = i + 1
    }
    i = 0
    while i < 8 {
        let sh: u64 = ((7 - i) as u64) * 8
        let b: u8 = ((seq >> sh) & 255 as u64) as u8
        rt.st8(out, 4 + i, rt.ld8(out, 4 + i) ^ b)
        i = i + 1
    }
}

fn is_chacha(suite: u32) -> bool {
    return suite == SUITE_CHACHA20 || suite == SUITE12_ECDSA_CHACHA20
    || suite == SUITE12_RSA_CHACHA20
}

fn aead_open_suite(t: *mut Tls, nonce: u64, aad: u64, na: usize,
    ct: u64, n: usize, out: u64) -> bool {
    if is_chacha((*t).suite) {
        return chacha.aead_open((&(*t).skey[0]) as u64, nonce, aad, na,
            ct, n, out)
    }
    return gcm.gcm_open((&(*t).skey[0]) as u64, (*t).keylen, nonce, aad, na,
        ct, n, out)
}

fn aead_seal_suite(t: *mut Tls, nonce: u64, aad: u64, na: usize,
    plain: u64, n: usize, out: u64) -> bool {
    if is_chacha((*t).suite) {
        chacha.aead_seal((&(*t).ckey[0]) as u64, nonce, aad, na, plain, n,
            out)
        return true
    }
    return gcm.gcm_seal((&(*t).ckey[0]) as u64, (*t).keylen, nonce, aad, na,
        plain, n, out)
}

// Reads ONE record. `kind` comes back as the real content type (after
// decryption, that is the last non-zero octet of the inner plaintext), and
// the contents land in `t.rec`.
fn read_record(t: *mut Tls, kind: *mut u32) -> TlsError!bool {
    if (*t).v12 {
        return read_record12(t, kind)
    }
    var err: bool = false
    if !fill(t, 5, &err) {
        if (*t).blocked {
            return TlsError::WouldBlock
        }
        if err {
            return TlsError::Io
        }
        return TlsError::Closed
    }
    let base: u64 = (*t).rbuf.ptr + (*t).rpos as u64
    let ctype: u32 = rt.ld8(base, 0) as u32
    let len: usize = be16(base, 3) as usize
    if len > MAX_RECORD {
        return TlsError::TooLarge
    }
    if !fill(t, 5 + len, &err) {
        if (*t).blocked {
            return TlsError::WouldBlock // N3: nothing was consumed
        }
        if err {
            return TlsError::Io
        }
        return TlsError::Closed
    }
    let body: u64 = (*t).rbuf.ptr + ((*t).rpos + 5) as u64
    let head: u64 = (*t).rbuf.ptr + (*t).rpos as u64
    (*t).records_in = (*t).records_in + 1
    rt.buf_clear(&(*t).rec)
    if !(*t).have_keys || ctype != REC_APPDATA {
        // A change_cipher_spec in the middle of a TLS 1.3 handshake is
        // "middlebox compatibility" and means nothing (RFC 8446 5). It is
        // dropped here rather than passed on.
        rt.buf_push_bytes(&(*t).rec, body, len)
        *kind = ctype
        (*t).rpos = (*t).rpos + 5 + len
        return true
    }
    if len < 17 {
        return TlsError::Decrypt
    }
    var nonce: [u8; 12] = [0; 12]
    make_nonce((&(*t).siv[0]) as u64, (*t).sseq, (&nonce[0]) as u64)
    rt.buf_reserve(&(*t).rec, len)
    if (*t).rec.cap < len {
        return TlsError::TooLarge
    }
    if !aead_open_suite(t, (&nonce[0]) as u64, head, 5, body, len,
        (*t).rec.ptr) {
        return TlsError::Decrypt
    }
    (*t).sseq = (*t).sseq + 1 as u64
    var plen: usize = len - 16
    rt.buf_set_len(&(*t).rec, plen)
    // the inner content type is the last octet that is not zero padding
    while plen > 0 && rt.ld8((*t).rec.ptr, plen - 1) == 0 as u8 {
        plen = plen - 1
    }
    if plen == 0 {
        return TlsError::Protocol
    }
    *kind = rt.ld8((*t).rec.ptr, plen - 1) as u32
    rt.buf_set_len(&(*t).rec, plen - 1)
    (*t).rpos = (*t).rpos + 5 + len
    return true
}

fn write_record(t: *mut Tls, kind: u32, p: u64, n: usize) -> bool {
    if (*t).v12 {
        return write_record12(t, kind, p, n)
    }
    var out: rt.Buf = rt.buf_new()
    var ok: bool = true
    if !(*t).have_keys {
        rt.buf_push(&out, kind as u8)
        push16(&out, 771 as u32) // legacy_record_version 0x0303
        push16(&out, n as u32)
        rt.buf_push_bytes(&out, p, n)
        ok = send_raw(t, out.ptr, out.len)
    } else {
        var inner: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&inner, p, n)
        rt.buf_push(&inner, kind as u8) // T5: no padding after it
        var head: [u8; 5] = [0; 5]
        head[0] = REC_APPDATA as u8
        head[1] = 3 as u8
        head[2] = 3 as u8
        let clen: usize = inner.len + 16
        head[3] = ((clen >> 8) & 255) as u8
        head[4] = (clen & 255) as u8
        var nonce: [u8; 12] = [0; 12]
        make_nonce((&(*t).civ[0]) as u64, (*t).cseq, (&nonce[0]) as u64)
        rt.buf_push_bytes(&out, (&head[0]) as u64, 5)
        let at: usize = out.len
        rt.buf_reserve(&out, at + clen)
        rt.buf_set_len(&out, at + clen)
        if !aead_seal_suite(t, (&nonce[0]) as u64, (&head[0]) as u64, 5,
            inner.ptr, inner.len, out.ptr + at as u64) {
            ok = false
        }
        rt.buf_free(&inner)
        if ok {
            (*t).cseq = (*t).cseq + 1 as u64
            ok = send_raw(t, out.ptr, out.len)
        }
    }
    rt.buf_free(&out)
    if ok {
        (*t).records_out = (*t).records_out + 1
    }
    return ok
}

// ----------------------------------------------- The TLS 1.2 record layer
//
// What differs from the TLS 1.3 layer above: the content type travels in the
// clear header (there is no inner type and no padding), the sequence number
// is part of the additional data instead of the nonce construction
// (GCM: 4 octet salt from the key block + 8 octet explicit nonce that is sent
// with every record; ChaCha20-Poly1305, RFC 7905: the IV xor the sequence
// number as in 1.3), and encryption starts with the ChangeCipherSpec of each
// direction instead of with the ServerHello.

fn be64put(p: u64, off: usize, v: u64) {
    var i: usize = 0
    while i < 8 {
        let sh: u64 = ((7 - i) as u64) * 8
        rt.st8(p, off + i, ((v >> sh) & 255 as u64) as u8)
        i = i + 1
    }
}

// seq(8) || type(1) || version 0x0303 (2) || plaintext length (2)
fn aad12(seq: u64, kind: u32, plen: usize, out: u64) {
    be64put(out, 0, seq)
    rt.st8(out, 8, kind as u8)
    rt.st8(out, 9, 3 as u8)
    rt.st8(out, 10, 3 as u8)
    rt.st8(out, 11, ((plen >> 8) & 255) as u8)
    rt.st8(out, 12, (plen & 255) as u8)
}

fn read_record12(t: *mut Tls, kind: *mut u32) -> TlsError!bool {
    var err: bool = false
    if !fill(t, 5, &err) {
        if (*t).blocked {
            return TlsError::WouldBlock
        }
        if err {
            return TlsError::Io
        }
        return TlsError::Closed
    }
    let base: u64 = (*t).rbuf.ptr + (*t).rpos as u64
    let ctype: u32 = rt.ld8(base, 0) as u32
    let len: usize = be16(base, 3) as usize
    if len > MAX_RECORD {
        return TlsError::TooLarge
    }
    if !fill(t, 5 + len, &err) {
        if (*t).blocked {
            return TlsError::WouldBlock // N3: nothing was consumed
        }
        if err {
            return TlsError::Io
        }
        return TlsError::Closed
    }
    let body: u64 = (*t).rbuf.ptr + ((*t).rpos + 5) as u64
    (*t).records_in = (*t).records_in + 1
    rt.buf_clear(&(*t).rec)
    if !(*t).rx12 {
        rt.buf_push_bytes(&(*t).rec, body, len)
        *kind = ctype
        (*t).rpos = (*t).rpos + 5 + len
        return true
    }
    // The server's ChangeCipherSpec is the LAST plaintext record of its
    // direction; a second one is a protocol error, never decrypted.
    if ctype == REC_CHANGE_CIPHER {
        return TlsError::Protocol
    }
    var explicit: usize = 8
    if is_chacha((*t).suite) {
        explicit = 0
    }
    if len < explicit + 16 {
        return TlsError::Decrypt
    }
    let plen: usize = len - explicit - 16
    if plen > 16384 {
        return TlsError::TooLarge
    }
    var aad: [u8; 13] = [0; 13]
    aad12((*t).sseq, ctype, plen, (&aad[0]) as u64)
    var nonce: [u8; 12] = [0; 12]
    if explicit == 0 {
        make_nonce((&(*t).siv[0]) as u64, (*t).sseq, (&nonce[0]) as u64)
    } else {
        var i: usize = 0
        while i < 4 {
            nonce[i] = (*t).siv[i]
            i = i + 1
        }
        i = 0
        while i < 8 {
            nonce[4 + i] = rt.ld8(body, i)
            i = i + 1
        }
    }
    rt.buf_reserve(&(*t).rec, len)
    if (*t).rec.cap < len {
        return TlsError::TooLarge
    }
    if !aead_open_suite(t, (&nonce[0]) as u64, (&aad[0]) as u64, 13,
        body + explicit as u64, plen + 16, (*t).rec.ptr) {
        return TlsError::Decrypt
    }
    (*t).sseq = (*t).sseq + 1 as u64
    rt.buf_set_len(&(*t).rec, plen)
    *kind = ctype
    (*t).rpos = (*t).rpos + 5 + len
    return true
}

fn write_record12(t: *mut Tls, kind: u32, p: u64, n: usize) -> bool {
    var out: rt.Buf = rt.buf_new()
    var ok: bool = true
    if !(*t).tx12 {
        rt.buf_push(&out, kind as u8)
        push16(&out, 771 as u32)
        push16(&out, n as u32)
        rt.buf_push_bytes(&out, p, n)
        ok = send_raw(t, out.ptr, out.len)
    } else if n > 16384 {
        ok = false
    } else {
        var explicit: usize = 8
        if is_chacha((*t).suite) {
            explicit = 0
        }
        let clen: usize = explicit + n + 16
        rt.buf_push(&out, kind as u8)
        push16(&out, 771 as u32)
        push16(&out, clen as u32)
        var aad: [u8; 13] = [0; 13]
        aad12((*t).cseq, kind, n, (&aad[0]) as u64)
        var nonce: [u8; 12] = [0; 12]
        let at: usize = out.len
        rt.buf_reserve(&out, at + clen)
        rt.buf_set_len(&out, at + clen)
        if explicit == 0 {
            make_nonce((&(*t).civ[0]) as u64, (*t).cseq, (&nonce[0]) as u64)
        } else {
            var i: usize = 0
            while i < 4 {
                nonce[i] = (*t).civ[i]
                i = i + 1
            }
            be64put((&nonce[0]) as u64, 4, (*t).cseq)
            be64put(out.ptr, at, (*t).cseq)
        }
        if !aead_seal_suite(t, (&nonce[0]) as u64, (&aad[0]) as u64, 13, p, n,
            out.ptr + (at + explicit) as u64) {
            ok = false
        }
        if ok {
            (*t).cseq = (*t).cseq + 1 as u64
            ok = send_raw(t, out.ptr, out.len)
        }
    }
    rt.buf_free(&out)
    if ok {
        (*t).records_out = (*t).records_out + 1
    }
    return ok
}

// --------------------------------------------------- The handshake stream

// Reads records until a whole handshake message stands in `t.hsin`, then
// hands back where its BODY is. The message including its four octet
// header goes into the transcript.
fn next_handshake(t: *mut Tls, htype: *mut u32, off: *mut usize,
    len: *mut usize) -> TlsError!bool {
    while true {
        let have: usize = (*t).hsin.len - (*t).hspos
        if have >= 4 {
            let base: u64 = (*t).hsin.ptr + (*t).hspos as u64
            let body: usize = be24(base, 1)
            if body > MAX_HANDSHAKE {
                return TlsError::TooLarge
            }
            if have >= 4 + body {
                *htype = rt.ld8(base, 0) as u32
                rt.buf_push_bytes(&(*t).tr, base, 4 + body)
                (*t).hs_bytes = (*t).hs_bytes + 4 + body
                *off = (*t).hspos + 4
                *len = body
                (*t).hspos = (*t).hspos + 4 + body
                return true
            }
        }
        // compact what has been consumed
        if (*t).hspos > 0 {
            let rest: usize = (*t).hsin.len - (*t).hspos
            var k: usize = 0
            while k < rest {
                rt.st8((*t).hsin.ptr, k,
                    rt.ld8((*t).hsin.ptr, (*t).hspos + k))
                k = k + 1
            }
            rt.buf_set_len(&(*t).hsin, rest)
            (*t).hspos = 0
        }
        var kind: u32 = 0
        let got: bool = try read_record(t, &kind)
        if kind == REC_CHANGE_CIPHER {
            if (*t).v12 {
                // TLS 1.2: the server's ChangeCipherSpec switches ITS
                // direction to the new keys. It is legal only once, after our
                // own, and never in the middle of a handshake message.
                if (*t).rec.len != 1 || rt.ld8((*t).rec.ptr, 0) != 1 as u8 {
                    return TlsError::Protocol
                }
                if !(*t).tx12 || (*t).rx12 || (*t).hsin.len != (*t).hspos {
                    return TlsError::Protocol
                }
                (*t).rx12 = true
                (*t).sseq = 0
            }
            continue
        }
        if kind == REC_ALERT {
            if (*t).rec.len >= 2 {
                (*t).alert_desc = rt.ld8((*t).rec.ptr, 1) as u32
            }
            return TlsError::Alert
        }
        if kind != REC_HANDSHAKE {
            return TlsError::Protocol
        }
        rt.buf_push_bytes(&(*t).hsin, (*t).rec.ptr, (*t).rec.len)
    }
    return TlsError::Protocol
}

// ------------------------------------------------------------ ClientHello

fn build_client_hello(t: *mut Tls, out: *mut rt.Buf) -> bool {
    var rnd: [u8; 32] = [0; 32]
    var sid: [u8; 32] = [0; 32]
    if !random.random_bytes((&rnd[0]) as u64, 32) {
        return false
    }
    if !random.random_bytes((&sid[0]) as u64, 32) {
        return false
    }
    // kept: the TLS 1.2 key derivation and the ServerKeyExchange signature
    // need the client random, and a server must not echo the session id
    var q: usize = 0
    while q < 32 {
        (*t).crandom[q] = rnd[q]
        (*t).csid[q] = sid[q]
        q = q + 1
    }
    let with13: bool = (*t).max_ver == 772 as u32
    var body: rt.Buf = rt.buf_new()
    push16(&body, 771 as u32) // legacy_version TLS 1.2, per RFC 8446 4.1.2
    rt.buf_push_bytes(&body, (&rnd[0]) as u64, 32)
    rt.buf_push(&body, 32 as u8) // legacy_session_id -- 32 octets for the
    rt.buf_push_bytes(&body, (&sid[0]) as u64, 32) // middlebox compat mode
    // cipher suites: the two TLS 1.3 suites (when 1.3 is offered), then the
    // six TLS 1.2 ECDHE suites in the order AES-128, ChaCha20, AES-256
    if with13 {
        push16(&body, 16 as u32)
        push16(&body, SUITE_AES128GCM)
        push16(&body, SUITE_CHACHA20)
    } else {
        push16(&body, 12 as u32)
    }
    push16(&body, SUITE12_ECDSA_AES128GCM)
    push16(&body, SUITE12_RSA_AES128GCM)
    push16(&body, SUITE12_ECDSA_CHACHA20)
    push16(&body, SUITE12_RSA_CHACHA20)
    push16(&body, SUITE12_ECDSA_AES256GCM)
    push16(&body, SUITE12_RSA_AES256GCM)
    rt.buf_push(&body, 1 as u8) // legacy_compression_methods
    rt.buf_push(&body, 0 as u8)

    var ext: rt.Buf = rt.buf_new()
    // server_name (0) -- and it is the ONE thing still sent in the clear
    push16(&ext, 0 as u32)
    push16(&ext, ((*t).hostlen + 5) as u32)
    push16(&ext, ((*t).hostlen + 3) as u32)
    rt.buf_push(&ext, 0 as u8) // host_name
    push16(&ext, (*t).hostlen as u32)
    rt.buf_push_bytes(&ext, (&(*t).host[0]) as u64, (*t).hostlen)
    // supported_groups (10)
    push16(&ext, 10 as u32)
    push16(&ext, 6 as u32)
    push16(&ext, 4 as u32)
    push16(&ext, 29 as u32) // x25519
    push16(&ext, 23 as u32) // secp256r1
    // ec_point_formats (11): uncompressed only (TLS 1.2 ECDHE)
    push16(&ext, 11 as u32)
    push16(&ext, 2 as u32)
    rt.buf_push(&ext, 1 as u8)
    rt.buf_push(&ext, 0 as u8)
    // signature_algorithms (13)
    push16(&ext, 13 as u32)
    push16(&ext, 16 as u32)
    push16(&ext, 14 as u32)
    push16(&ext, 2052 as u32) // rsa_pss_rsae_sha256
    push16(&ext, 2053 as u32) // rsa_pss_rsae_sha384
    push16(&ext, 2054 as u32) // rsa_pss_rsae_sha512
    push16(&ext, 1027 as u32) // ecdsa_secp256r1_sha256
    push16(&ext, 1283 as u32) // ecdsa_secp384r1_sha384
    push16(&ext, 1025 as u32) // rsa_pkcs1_sha256 -- certificates (1.3), TLS 1.2 signatures
    push16(&ext, 1281 as u32) // rsa_pkcs1_sha384
    // extended_master_secret (23): RFC 7627, empty
    push16(&ext, 23 as u32)
    push16(&ext, 0 as u32)
    // renegotiation_info (0xff01): the initial handshake, RFC 5746
    push16(&ext, 65281 as u32)
    push16(&ext, 1 as u32)
    rt.buf_push(&ext, 0 as u8)
    // supported_versions (43)
    push16(&ext, 43 as u32)
    if with13 {
        push16(&ext, 5 as u32)
        rt.buf_push(&ext, 4 as u8)
        push16(&ext, 772 as u32) // 0x0304 = TLS 1.3
        push16(&ext, 771 as u32) // 0x0303 = TLS 1.2
    } else {
        push16(&ext, 3 as u32)
        rt.buf_push(&ext, 2 as u8)
        push16(&ext, 771 as u32)
    }
    // key_share (51) -- only when TLS 1.3 is offered
    // BOTH shares are sent, so that a server that has only one of the two
    // groups answers with its ServerHello directly -- Azure Front Door
    // (piston-meta.mojang.com) has no X25519 and would otherwise need a
    // HelloRetryRequest, which T4 does not do. The same two keys serve the
    // TLS 1.2 ECDHE if the server picks 1.2.
    if with13 {
        push16(&ext, 51 as u32)
        push16(&ext, 107 as u32)
        push16(&ext, 105 as u32)
        push16(&ext, 29 as u32)
        push16(&ext, 32 as u32)
        rt.buf_push_bytes(&ext, (&(*t).pub_key[0]) as u64, 32)
        push16(&ext, 23 as u32)
        push16(&ext, 65 as u32)
        rt.buf_push_bytes(&ext, (&(*t).p256_pub[0]) as u64, 65)
    }
    // application_layer_protocol_negotiation (16)
    var http11: [u8; 8] = "http/1.1"
    push16(&ext, 16 as u32)
    push16(&ext, 11 as u32)
    push16(&ext, 9 as u32)
    rt.buf_push(&ext, 8 as u8)
    rt.buf_push_bytes(&ext, (&http11[0]) as u64, 8)

    push16(&body, ext.len as u32)
    rt.buf_push_bytes(&body, ext.ptr, ext.len)
    rt.buf_free(&ext)

    rt.buf_push(out, HS_CLIENT_HELLO as u8)
    push24(out, body.len)
    rt.buf_push_bytes(out, body.ptr, body.len)
    rt.buf_free(&body)
    return true
}

// The magic random of RFC 8446 4.1.3 -- SHA-256 of "HelloRetryRequest".
fn is_retry(p: u64, off: usize) -> bool {
    var magic: [u8; 32] = [207, 33, 173, 116, 229, 154, 97, 17, 190, 29,
        140, 2, 30, 101, 184, 145, 194, 162, 17, 22, 122, 187, 140, 94,
        7, 158, 9, 226, 200, 168, 51, 156]
    var i: usize = 0
    while i < 32 {
        if rt.ld8(p, off + i) != magic[i] {
            return false
        }
        i = i + 1
    }
    return true
}

// What a TLS 1.2 suite needs: 0 = not one of ours. `*keylen` the AEAD key,
// `*prf` the hash of the PRF and of the handshake hash.
fn suite12_params(suite: u32, keylen: *mut usize, prf: *mut u32) -> bool {
    if suite == SUITE12_ECDSA_AES128GCM || suite == SUITE12_RSA_AES128GCM {
        *keylen = 16
        *prf = prf12.PRF_SHA256
        return true
    }
    if suite == SUITE12_ECDSA_AES256GCM || suite == SUITE12_RSA_AES256GCM {
        *keylen = 32
        *prf = prf12.PRF_SHA384
        return true
    }
    if suite == SUITE12_ECDSA_CHACHA20 || suite == SUITE12_RSA_CHACHA20 {
        *keylen = 32
        *prf = prf12.PRF_SHA256
        return true
    }
    return false
}

// "DOWNGRD" followed by 01 (the server speaks 1.3 but chose 1.2) or 00 (...
// chose 1.1 or lower): RFC 8446 4.1.3.
fn has_downgrade_sentinel(p: u64, rnd: usize) -> bool {
    var mark: [u8; 7] = "DOWNGRD"
    var i: usize = 0
    while i < 7 {
        if rt.ld8(p, rnd + 24 + i) != mark[i] {
            return false
        }
        i = i + 1
    }
    let last: u8 = rt.ld8(p, rnd + 31)
    return last == 0 as u8 || last == 1 as u8
}

fn parse_server_hello(t: *mut Tls, p: u64, off: usize, len: usize,
    share: *mut usize) -> TlsError!bool {
    if len < 38 {
        return TlsError::Protocol
    }
    let legacy: u32 = be16(p, off)
    var at: usize = off + 2
    if is_retry(p, at) {
        return TlsError::Retry // T4
    }
    let rnd: usize = at
    var q: usize = 0
    while q < 32 {
        (*t).srandom[q] = rt.ld8(p, rnd + q)
        q = q + 1
    }
    at = at + 32
    let sidlen: usize = rt.ld8(p, at) as usize
    if sidlen > 32 {
        return TlsError::Protocol
    }
    // A server that echoes our (random, never used before) session id claims
    // to resume a session that does not exist.
    var echoed: bool = sidlen == 32
    q = 0
    while echoed && q < 32 {
        if rt.ld8(p, at + 1 + q) != (*t).csid[q] {
            echoed = false
        }
        q = q + 1
    }
    at = at + 1 + sidlen
    if at + 3 > off + len {
        return TlsError::Protocol
    }
    let suite: u32 = be16(p, at)
    at = at + 2
    if rt.ld8(p, at) != 0 as u8 {
        return TlsError::Protocol // legacy_compression_method
    }
    at = at + 1
    if at + 2 > off + len {
        return TlsError::Protocol
    }
    let elen: usize = be16(p, at) as usize
    at = at + 2
    let eend: usize = at + elen
    if eend > off + len {
        return TlsError::Protocol
    }
    var saw_version: bool = false
    var saw_share: bool = false
    var saw_ems: bool = false
    while at + 4 <= eend {
        let etype: u32 = be16(p, at)
        let elen2: usize = be16(p, at + 2) as usize
        at = at + 4
        if at + elen2 > eend {
            return TlsError::Protocol
        }
        if etype == 43 as u32 {
            if elen2 != 2 || be16(p, at) != 772 as u32 {
                return TlsError::Version
            }
            saw_version = true
        } else if etype == 51 as u32 {
            if elen2 < 4 {
                return TlsError::Protocol
            }
            let grp: u32 = be16(p, at)
            if grp != 29 as u32 && grp != 23 as u32 {
                return TlsError::Group
            }
            let klen: usize = be16(p, at + 2) as usize
            if at + 4 + klen > eend {
                return TlsError::Group
            }
            if grp == 29 as u32 && klen != 32 {
                return TlsError::Group
            }
            // an uncompressed point: 04 || X || Y
            if grp == 23 as u32 && (klen != 65 || rt.ld8(p, at + 4) != 4 as u8) {
                return TlsError::Group
            }
            (*t).group = grp
            *share = at + 4
            saw_share = true
        } else if etype == 23 as u32 {
            if elen2 != 0 {
                return TlsError::Protocol
            }
            saw_ems = true
        } else if etype == 65281 as u32 {
            // renegotiation_info of the initial handshake: one zero octet
            if elen2 != 1 || rt.ld8(p, at) != 0 as u8 {
                return TlsError::Protocol
            }
            (*t).reneg_ok = true
        } else if etype == 16 as u32 && elen2 >= 3 {
            let nlen: usize = rt.ld8(p, at + 2) as usize
            if nlen <= 32 && at + 3 + nlen <= eend {
                var a: usize = 0
                while a < nlen {
                    (*t).alpn[a] = rt.ld8(p, at + 3 + a)
                    a = a + 1
                }
                (*t).alpnlen = nlen
            }
        }
        at = at + elen2
    }
    if saw_version {
        // ---- TLS 1.3
        if suite != SUITE_AES128GCM && suite != SUITE_CHACHA20 {
            return TlsError::Suite
        }
        (*t).suite = suite
        if suite == SUITE_CHACHA20 {
            (*t).keylen = 32
        } else {
            (*t).keylen = 16
        }
        if (*t).max_ver != 772 as u32 {
            return TlsError::Version // not offered
        }
        if !saw_share {
            return TlsError::Group
        }
        return true
    }
    // ---- no supported_versions: a TLS 1.2 ServerHello (or older). T7.
    if legacy != 771 as u32 {
        return TlsError::Version // TLS 1.1 and lower are not spoken
    }
    var kl: usize = 0
    var ph: u32 = 0
    if !suite12_params(suite, &kl, &ph) {
        // a TLS 1.3 suite without supported_versions is not a 1.3 hello
        // either (RFC 8446 4.1.3), and anything else was not offered
        if suite == SUITE_AES128GCM || suite == SUITE_CHACHA20 {
            return TlsError::Version
        }
        return TlsError::Suite
    }
    // RFC 8446 4.1.3: a client that offered 1.3 and gets a 1.2 hello whose
    // random ends in DOWNGRD was downgraded by somebody between it and a
    // server that does speak 1.3.
    if (*t).max_ver == 772 as u32 && has_downgrade_sentinel(p, rnd) {
        return TlsError::Downgrade
    }
    if echoed {
        return TlsError::Protocol
    }
    // RFC 7627. Without the extension the master secret is not bound to this
    // handshake; accepted unless the caller asked for strictness (T7).
    if !saw_ems && (*t).require_ems {
        return TlsError::Unsupported
    }
    (*t).ems = saw_ems
    (*t).suite = suite
    (*t).keylen = kl
    (*t).prf = ph
    (*t).v12 = true
    return true
}

// ------------------------------------------------------------ The keys

// The ECDHE shared secret with the peer's share at `peer` (X25519: 32 octets;
// secp256r1: 04 || X || Y). The peer's point is checked to lie on the curve
// first -- a point off the curve makes the multiplication leak the private
// scalar (invalid curve attack) -- and an X25519 result of all zeros (a
// low order point) is refused by `x25519`.
fn ecdh_shared(t: *mut Tls, grp: u32, peer: u64, shared: u64) -> bool {
    if grp == 23 as u32 {
        var curve: ecdsa.Curve = ecdsa.curve_new_p256()
        if !ecdsa.point_valid(&curve, peer + 1 as u64, peer + 33 as u64) {
            return false
        }
        var yy: [u8; 32] = [0; 32]
        return p256.p256_mult((&(*t).p256_priv[0]) as u64, peer + 1 as u64,
            peer + 33 as u64, shared, (&yy[0]) as u64)
    }
    return x25519.x25519((&(*t).priv[0]) as u64, peer, shared)
}

fn install_handshake_keys(t: *mut Tls, secret_hash: u64) -> bool {
    var early: [u8; 32] = [0; 32]
    keys.key_schedule_early((&early[0]) as u64)
    var shared: [u8; 32] = [0; 32]
    if !ecdh_shared(t, (*t).group, secret_hash, (&shared[0]) as u64) {
        return false
    }
    if !keys.key_schedule_handshake((&early[0]) as u64,
        (&shared[0]) as u64, 32, (&(*t).hs_secret[0]) as u64) {
        return false
    }
    var lc: [u8; 12] = "c hs traffic"
    var ls: [u8; 12] = "s hs traffic"
    if !keys.derive_secret((&(*t).hs_secret[0]) as u64, (&lc[0]) as u64, 12,
        (*t).tr.ptr, (*t).tr.len, (&(*t).c_hs_secret[0]) as u64) {
        return false
    }
    if !keys.derive_secret((&(*t).hs_secret[0]) as u64, (&ls[0]) as u64, 12,
        (*t).tr.ptr, (*t).tr.len, (&(*t).s_hs_secret[0]) as u64) {
        return false
    }
    if !keys.traffic_keys((&(*t).c_hs_secret[0]) as u64, (*t).keylen,
        (&(*t).ckey[0]) as u64, (&(*t).civ[0]) as u64) {
        return false
    }
    if !keys.traffic_keys((&(*t).s_hs_secret[0]) as u64, (*t).keylen,
        (&(*t).skey[0]) as u64, (&(*t).siv[0]) as u64) {
        return false
    }
    (*t).cseq = 0
    (*t).sseq = 0
    (*t).have_keys = true
    return true
}

fn install_application_keys(t: *mut Tls) -> bool {
    if !keys.key_schedule_master((&(*t).hs_secret[0]) as u64,
        (&(*t).ms_secret[0]) as u64) {
        return false
    }
    var lc: [u8; 12] = "c ap traffic"
    var ls: [u8; 12] = "s ap traffic"
    var cs: [u8; 32] = [0; 32]
    var ss: [u8; 32] = [0; 32]
    if !keys.derive_secret((&(*t).ms_secret[0]) as u64, (&lc[0]) as u64, 12,
        (*t).tr.ptr, (*t).tr.len, (&cs[0]) as u64) {
        return false
    }
    if !keys.derive_secret((&(*t).ms_secret[0]) as u64, (&ls[0]) as u64, 12,
        (*t).tr.ptr, (*t).tr.len, (&ss[0]) as u64) {
        return false
    }
    if !keys.traffic_keys((&cs[0]) as u64, (*t).keylen,
        (&(*t).ckey[0]) as u64, (&(*t).civ[0]) as u64) {
        return false
    }
    if !keys.traffic_keys((&ss[0]) as u64, (*t).keylen,
        (&(*t).skey[0]) as u64, (&(*t).siv[0]) as u64) {
        return false
    }
    (*t).cseq = 0
    (*t).sseq = 0
    return true
}

// -------------------------------------------------- Certificate, and proof

fn parse_certificate(t: *mut Tls, p: u64, off: usize, len: usize,
    certs: *mut [x509.Cert; 10], n: *mut usize) -> TlsError!bool {
    var at: usize = off
    let ctxlen: usize = rt.ld8(p, at) as usize
    at = at + 1 + ctxlen
    if at + 3 > off + len {
        return TlsError::Protocol
    }
    let listlen: usize = be24(p, at)
    at = at + 3
    let lend: usize = at + listlen
    if lend > off + len {
        return TlsError::Protocol
    }
    var count: usize = 0
    while at + 3 <= lend && count < MAX_CERTS {
        let clen: usize = be24(p, at)
        at = at + 3
        if at + clen > lend {
            return TlsError::Protocol
        }
        if !x509.cert_parse(&(*certs)[count], p + at as u64, clen) {
            return TlsError::Certificate
        }
        at = at + clen
        count = count + 1
        if at + 2 > lend {
            break
        }
        let exlen: usize = be16(p, at) as usize
        at = at + 2 + exlen
    }
    if count == 0 {
        return TlsError::Certificate
    }
    *n = count
    return true
}

// RFC 8446 4.4.3: what the server actually signed.
fn certverify_content(t: *mut Tls, upto: usize, out: *mut rt.Buf) {
    var i: usize = 0
    while i < 64 {
        rt.buf_push(out, 32 as u8)
        i = i + 1
    }
    var lit: [u8; 33] = "TLS 1.3, server CertificateVerify"
    rt.buf_push_bytes(out, (&lit[0]) as u64, 33)
    rt.buf_push(out, 0 as u8)
    var th: [u8; 32] = [0; 32]
    keys.transcript((*t).tr.ptr, upto, (&th[0]) as u64)
    rt.buf_push_bytes(out, (&th[0]) as u64, 32)
}

fn sig_result(code: u32) -> TlsError!bool {
    if code == 2 as u32 {
        return TlsError::Unsupported
    }
    if code == 1 as u32 {
        return TlsError::Signature
    }
    return true
}

fn verify_sig(leaf: *mut x509.Cert, alg: u32, msg: u64, msglen: usize,
    sig: u64, siglen: usize, pkcs1: bool) -> TlsError!bool {
    return sig_result(sig_check(leaf, alg, msg, msglen, sig, siglen, pkcs1))
}

fn verify_certverify(t: *mut Tls, leaf: *mut x509.Cert, alg: u32,
    sig: u64, siglen: usize, upto: usize) -> TlsError!bool {
    var msg: rt.Buf = rt.buf_new()
    certverify_content(t, upto, &msg)
    let code: u32 = sig_check(leaf, alg, msg.ptr, msg.len, sig, siglen, false)
    rt.buf_free(&msg)
    return sig_result(code)
}

// Checks `sig` over `msg` with the certificate's key by the TLS signature
// scheme `alg`. 0 = good, 1 = bad signature (or the wrong kind of key),
// 2 = a scheme this client does not have. `v12` = the TLS 1.2 rules: the
// rsa_pkcs1_* schemes are allowed (RFC 8446 4.2.3 forbids them in a TLS 1.3
// CertificateVerify), and an ECDSA scheme names only the HASH, not the curve
// (RFC 5246 7.4.1.4.1): a P-256 key may sign with SHA-384. In TLS 1.3
// 0x0403 means P-256 and 0x0503 means P-384. The scheme has to fit the KIND
// of key in the certificate.
fn sig_check(leaf: *mut x509.Cert, alg: u32, msg: u64, msglen: usize,
    sig: u64, siglen: usize, v12: bool) -> u32 {
    var pkcs1: bool = v12
    var digest: [u8; 64] = [0; 64]
    var good: bool = false
    var known: bool = true
    let ka: u32 = x509.cert_key_alg(leaf)
    if alg == 2052 as u32 || alg == 2057 as u32 { // rsa_pss_*_sha256
        if ka != x509.KEY_RSA { return 1 as u32 }
        rsa.hash_of(rsa.RSA_SHA256, msg, msglen, (&digest[0]) as u64)
        good = rsa.rsa_verify_pss(leaf_mod(leaf), leaf_modlen(leaf),
            leaf_exp(leaf), leaf_explen(leaf), sig, siglen,
            (&digest[0]) as u64, rsa.RSA_SHA256)
    } else if alg == 2053 as u32 || alg == 2058 as u32 {
        if ka != x509.KEY_RSA { return 1 as u32 }
        rsa.hash_of(rsa.RSA_SHA384, msg, msglen, (&digest[0]) as u64)
        good = rsa.rsa_verify_pss(leaf_mod(leaf), leaf_modlen(leaf),
            leaf_exp(leaf), leaf_explen(leaf), sig, siglen,
            (&digest[0]) as u64, rsa.RSA_SHA384)
    } else if alg == 2054 as u32 || alg == 2059 as u32 {
        if ka != x509.KEY_RSA { return 1 as u32 }
        rsa.hash_of(rsa.RSA_SHA512, msg, msglen, (&digest[0]) as u64)
        good = rsa.rsa_verify_pss(leaf_mod(leaf), leaf_modlen(leaf),
            leaf_exp(leaf), leaf_explen(leaf), sig, siglen,
            (&digest[0]) as u64, rsa.RSA_SHA512)
    } else if alg == 1027 as u32 { // ecdsa_secp256r1_sha256 (TLS 1.2: ecdsa + sha256)
        var half: usize = 32
        if v12 {
            if ka == x509.KEY_P384 {
                half = 48
            } else if ka != x509.KEY_P256 {
                return 1 as u32
            }
        } else if ka != x509.KEY_P256 {
            return 1 as u32
        }
        rsa.hash_of(rsa.RSA_SHA256, msg, msglen, (&digest[0]) as u64)
        good = ecdsa_from_der(leaf, (&digest[0]) as u64, 32, sig, siglen,
            half)
    } else if alg == 1283 as u32 { // ecdsa_secp384r1_sha384 (TLS 1.2: ecdsa + sha384)
        var half: usize = 48
        if v12 {
            if ka == x509.KEY_P256 {
                half = 32
            } else if ka != x509.KEY_P384 {
                return 1 as u32
            }
        } else if ka != x509.KEY_P384 {
            return 1 as u32
        }
        rsa.hash_of(rsa.RSA_SHA384, msg, msglen, (&digest[0]) as u64)
        good = ecdsa_from_der(leaf, (&digest[0]) as u64, 48, sig, siglen,
            half)
    } else if pkcs1 && alg == 1025 as u32 { // rsa_pkcs1_sha256
        if ka != x509.KEY_RSA { return 1 as u32 }
        rsa.hash_of(rsa.RSA_SHA256, msg, msglen, (&digest[0]) as u64)
        good = rsa.rsa_verify_pkcs1(leaf_mod(leaf), leaf_modlen(leaf),
            leaf_exp(leaf), leaf_explen(leaf), sig, siglen,
            (&digest[0]) as u64, rsa.RSA_SHA256)
    } else if pkcs1 && alg == 1281 as u32 { // rsa_pkcs1_sha384
        if ka != x509.KEY_RSA { return 1 as u32 }
        rsa.hash_of(rsa.RSA_SHA384, msg, msglen, (&digest[0]) as u64)
        good = rsa.rsa_verify_pkcs1(leaf_mod(leaf), leaf_modlen(leaf),
            leaf_exp(leaf), leaf_explen(leaf), sig, siglen,
            (&digest[0]) as u64, rsa.RSA_SHA384)
    } else {
        // RFC 8446 4.2.3: rsa_pkcs1_* MUST NOT appear in TLS 1.3. Anything
        // else is an algorithm this client does not have.
        known = false
    }
    if !known {
        return 2 as u32
    }
    if !good {
        return 1 as u32
    }
    return 0 as u32
}

fn leaf_mod(c: *mut x509.Cert) -> u64 {
    return x509.cert_mod_ptr(c)
}

fn leaf_modlen(c: *mut x509.Cert) -> usize {
    return x509.cert_mod_len(c)
}

fn leaf_exp(c: *mut x509.Cert) -> u64 {
    return x509.cert_exp_ptr(c)
}

fn leaf_explen(c: *mut x509.Cert) -> usize {
    return x509.cert_exp_len(c)
}

fn ecdsa_from_der(leaf: *mut x509.Cert, digest: u64, hlen: usize,
    sig: u64, siglen: usize, half: usize) -> bool {
    var r: [u8; 48] = [0; 48]
    var s: [u8; 48] = [0; 48]
    if !x509.ecdsa_der_split(sig, siglen, (&r[0]) as u64, (&s[0]) as u64,
        half) {
        return false
    }
    var curve: ecdsa.Curve = ecdsa.curve_new_p256()
    if x509.cert_key_alg(leaf) == x509.KEY_P384 {
        ecdsa.curve_p384(&curve)
        if half != 48 {
            return false
        }
    } else if x509.cert_key_alg(leaf) == x509.KEY_P256 {
        if half != 32 {
            return false
        }
    } else {
        return false
    }
    return ecdsa.ecdsa_verify_curve(&curve, x509.cert_ec_ptr(leaf),
        x509.cert_ec_ptr(leaf) + half as u64, (&r[0]) as u64,
        (&s[0]) as u64, digest, hlen)
}

// ------------------------------------------------------------ The handshake

// The blocking handshake: the machine below, run until it is done. On a
// blocking socket `WouldBlock` cannot happen; if the socket is non-blocking
// after all, the caller gets the error and may call `tls_handshake_step`
// itself.
fn tls_handshake(t: *mut Tls) -> TlsError!bool {
    while true {
        let done: bool = try tls_handshake_step(t)
        if done {
            return true
        }
    }
    return true
}

// ONE STEP of the handshake (N1). true = established. The error
// `WouldBlock` means: more octets are needed, call again when the socket is
// readable; every other error is final. The state lives in the struct
// (`hs_step` and the flags), the transcript and the buffers are as they
// were, so a step that stops early loses nothing.
fn tls_handshake_step(t: *mut Tls) -> TlsError!bool {
    if (*t).established {
        return true
    }
    if (*t).v12 {
        return handshake12_step(t)
    }
    if (*t).hs_step == 0 as u32 {
        if !random.random_bytes((&(*t).priv[0]) as u64, 32) {
            return TlsError::Random
        }
        if !x25519.x25519_base((&(*t).priv[0]) as u64,
            (&(*t).pub_key[0]) as u64) {
            return TlsError::Random
        }
        // the secp256r1 share: a scalar in 1 .. n-1 (a draw outside is
        // astronomically rare, but it is checked, not assumed)
        var drawn: bool = false
        var tries: usize = 0
        while !drawn && tries < 8 {
            if !random.random_bytes((&(*t).p256_priv[0]) as u64, 32) {
                return TlsError::Random
            }
            if p256.p256_scalar_valid((&(*t).p256_priv[0]) as u64) {
                drawn = true
            }
            tries = tries + 1
        }
        if !drawn || !p256.p256_public((&(*t).p256_priv[0]) as u64,
            (&(*t).p256_pub[0]) as u64) {
            return TlsError::Random
        }
        var ch: rt.Buf = rt.buf_new()
        if !build_client_hello(t, &ch) {
            rt.buf_free(&ch)
            return TlsError::Random
        }
        rt.buf_push_bytes(&(*t).tr, ch.ptr, ch.len)
        (*t).hs_bytes = (*t).hs_bytes + ch.len
        let sent: bool = write_record(t, REC_HANDSHAKE, ch.ptr, ch.len)
        rt.buf_free(&ch)
        if !sent {
            return TlsError::Io
        }
        (*t).hs_step = 1 as u32
    }

    if (*t).hs_step == 1 as u32 {
        var htype: u32 = 0
        var hoff: usize = 0
        var hlen: usize = 0
        let got: bool = try next_handshake(t, &htype, &hoff, &hlen)
        if htype != HS_SERVER_HELLO {
            return TlsError::Protocol
        }
        var share: usize = 0
        let okh: bool = try parse_server_hello(t, (*t).hsin.ptr, hoff, hlen,
            &share)
        if (*t).v12 {
            // the server chose TLS 1.2 (T7): the rest is `handshake12_step`
            (*t).hs_step = 5 as u32
            return handshake12_step(t)
        }
        // the middlebox compatibility record (RFC 8446 D.4): after the first
        // server flight and before our second, in the clear. (Sent right after
        // the ClientHello it would reach a TLS 1.2 server in the middle of ITS
        // first flight, which is a protocol error there.)
        var ccs: [u8; 1] = [1; 1]
        let ok_ccs: bool = write_record(t, REC_CHANGE_CIPHER,
            (&ccs[0]) as u64, 1)
        if !install_handshake_keys(t, (*t).hsin.ptr + share as u64) {
            return TlsError::Protocol
        }
        (*t).hs_step = 2 as u32
    }

    if (*t).hs_step == 2 as u32 {
        while !(*t).hs_fin {
            var ht: u32 = 0
            var ho: usize = 0
            var hl: usize = 0
            // The transcript up to but NOT including this message -- the
            // CertificateVerify and the Finished are each computed over
            // everything BEFORE themselves.
            let before: usize = (*t).tr.len
            let g2: bool = try next_handshake(t, &ht, &ho, &hl)
            if ht == HS_ENCRYPTED_EXT {
                parse_encrypted_extensions(t, (*t).hsin.ptr, ho, hl)
            } else if ht == HS_CERT_REQUEST {
                // T3: noted, and answered with an empty Certificate below.
                (*t).hs_have_cert = (*t).hs_have_cert
            } else if ht == HS_CERTIFICATE {
                rt.buf_clear(&(*t).certbuf)
                rt.buf_push_bytes(&(*t).certbuf, (*t).hsin.ptr + ho as u64, hl)
                (*t).ncerts = 0
                let g3: bool = try parse_certificate(t, (*t).certbuf.ptr, 0, hl,
                    &(*t).certs, &(*t).ncerts)
                if !check_chain(t, &(*t).certs, (*t).ncerts) {
                    return TlsError::Certificate
                }
                (*t).hs_have_cert = true
            } else if ht == HS_CERT_VERIFY {
                if !(*t).hs_have_cert || hl < 4 {
                    return TlsError::Protocol
                }
                let alg: u32 = be16((*t).hsin.ptr, ho)
                let slen: usize = be16((*t).hsin.ptr, ho + 2) as usize
                if 4 + slen > hl {
                    return TlsError::Protocol
                }
                let g4: bool = try verify_certverify(t, &(*t).certs[0], alg,
                    (*t).hsin.ptr + (ho + 4) as u64, slen, before)
                (*t).hs_verified = true
            } else if ht == HS_FINISHED {
                if !(*t).hs_verified {
                    return TlsError::Signature
                }
                var fkey: [u8; 32] = [0; 32]
                if !keys.finished_key((&(*t).s_hs_secret[0]) as u64,
                    (&fkey[0]) as u64) {
                    return TlsError::Protocol
                }
                var want: [u8; 32] = [0; 32]
                keys.finished_mac((&fkey[0]) as u64, (*t).tr.ptr, before,
                    (&want[0]) as u64)
                if hl != 32 || !chacha.tag_equal((&want[0]) as u64,
                    (*t).hsin.ptr + ho as u64, 32) {
                    return TlsError::Finished
                }
                (*t).hs_fin = true
            } else if ht == HS_KEY_UPDATE {
                send_alert(t, 2 as u32, 40 as u32) // handshake_failure -- T2
                return TlsError::Unsupported
            }
        }
        (*t).hs_step = 3 as u32
    }

    // the client's own Finished, over the transcript INCLUDING the
    // server's Finished
    var cfkey: [u8; 32] = [0; 32]
    if !keys.finished_key((&(*t).c_hs_secret[0]) as u64,
        (&cfkey[0]) as u64) {
        return TlsError::Protocol
    }
    var vd: [u8; 32] = [0; 32]
    keys.finished_mac((&cfkey[0]) as u64, (*t).tr.ptr, (*t).tr.len,
        (&vd[0]) as u64)
    var fin: rt.Buf = rt.buf_new()
    rt.buf_push(&fin, HS_FINISHED as u8)
    push24(&fin, 32)
    rt.buf_push_bytes(&fin, (&vd[0]) as u64, 32)
    let sent2: bool = write_record(t, REC_HANDSHAKE, fin.ptr, fin.len)
    rt.buf_free(&fin)
    if !sent2 {
        return TlsError::Io
    }
    if !install_application_keys(t) {
        return TlsError::Protocol
    }
    (*t).established = true
    (*t).hs_step = 4 as u32
    return true
}

// ------------------------------------------------- The TLS 1.2 handshake
//
//     -> ClientHello (sent by `tls_handshake_step`)
//     <- ServerHello, Certificate, ServerKeyExchange, [CertificateRequest],
//        ServerHelloDone
//     -> [Certificate (empty)], ClientKeyExchange, ChangeCipherSpec, Finished
//     <- ChangeCipherSpec, Finished
//
// Everything from the ClientHello to the ServerHelloDone is plaintext. The
// server's ephemeral share and the proof that it holds the certificate's key
// are ONE message, the ServerKeyExchange: the signature covers both random
// values and the share, which is what ties the key exchange to this
// connection. The key exchange is ECDHE with the two groups of the
// ClientHello; the pre-master secret is the shared secret itself.
//
// It is a state machine like the TLS 1.3 one (N1): `hs_step` 5 = reading the
// server's flight, 6 = our flight is sent and the server's ChangeCipherSpec
// and Finished are awaited; the flags `hs_have_cert`, `hs_have_ske`,
// `hs_cert_req`, `hs_done12`, `hs_fin` and the certificates live in the
// struct, so a `WouldBlock` in the middle loses nothing.

fn is_ecdsa_suite12(s: u32) -> bool {
    return s == SUITE12_ECDSA_AES128GCM || s == SUITE12_ECDSA_AES256GCM
    || s == SUITE12_ECDSA_CHACHA20
}

// Verifies the chain against the store and the host name; the verdict stays
// in `t.verify`. An unknown or bad chain is answered with an alert.
fn check_chain(t: *mut Tls, certs: *mut [x509.Cert; 10], n: usize) -> bool {
    var res: x509.VerifyResult = x509.VerifyResult { reason: 0, depth: 0,
        anchor: 0 }
    (*t).verify = x509.verify_chain((*t).store, certs, n,
        (&(*t).host[0]) as u64, (*t).hostlen, (*t).now, &res)
    (*t).chain_depth = res.depth
    if (*t).verify != x509.V_OK {
        send_alert(t, 2 as u32, 48 as u32) // unknown_ca
        return false
    }
    return true
}
// TLS 1.2 Certificate: a list of certificates, no request context and no
// per-certificate extensions (RFC 5246 7.4.2).
fn parse_certificate12(p: u64, off: usize, len: usize,
    certs: *mut [x509.Cert; 10], n: *mut usize) -> TlsError!bool {
    if len < 3 {
        return TlsError::Protocol
    }
    let listlen: usize = be24(p, off)
    var at: usize = off + 3
    if at + listlen != off + len {
        return TlsError::Protocol
    }
    let lend: usize = at + listlen
    var count: usize = 0
    while at + 3 <= lend && count < MAX_CERTS {
        let clen: usize = be24(p, at)
        at = at + 3
        if at + clen > lend {
            return TlsError::Protocol
        }
        if !x509.cert_parse(&(*certs)[count], p + at as u64, clen) {
            return TlsError::Certificate
        }
        at = at + clen
        count = count + 1
    }
    if count == 0 {
        return TlsError::Certificate
    }
    *n = count
    return true
}

// The ServerKeyExchange of an ECDHE suite: curve_type 3 (named_curve), the
// curve, the share, the signature scheme and the signature.
fn parse_server_key_exchange(t: *mut Tls, leaf: *mut x509.Cert, p: u64,
    off: usize, len: usize) -> TlsError!bool {
    if len < 4 || rt.ld8(p, off) != 3 as u8 {
        return TlsError::Group
    }
    let grp: u32 = be16(p, off + 1)
    if grp != 29 as u32 && grp != 23 as u32 {
        return TlsError::Group
    }
    let pklen: usize = rt.ld8(p, off + 3) as usize
    if grp == 29 as u32 && pklen != 32 {
        return TlsError::Group
    }
    if grp == 23 as u32 && (pklen != 65 || rt.ld8(p, off + 4) != 4 as u8) {
        return TlsError::Group
    }
    let at: usize = 4 + pklen
    if at + 4 > len {
        return TlsError::Protocol
    }
    let alg: u32 = be16(p, off + at)
    let siglen: usize = be16(p, off + at + 2) as usize
    if at + 4 + siglen != len {
        return TlsError::Protocol
    }
    // only what the ClientHello offered
    if alg != 2052 as u32 && alg != 2053 as u32 && alg != 2054 as u32
    && alg != 1027 as u32 && alg != 1283 as u32 && alg != 1025 as u32
    && alg != 1281 as u32 {
        return TlsError::Unsupported
    }
    // the suite names the KIND of certificate it needs
    let ka: u32 = x509.cert_key_alg(leaf)
    if is_ecdsa_suite12((*t).suite) {
        if ka != x509.KEY_P256 && ka != x509.KEY_P384 {
            return TlsError::Suite
        }
    } else if ka != x509.KEY_RSA {
        return TlsError::Suite
    }
    var msg: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&msg, (&(*t).crandom[0]) as u64, 32)
    rt.buf_push_bytes(&msg, (&(*t).srandom[0]) as u64, 32)
    rt.buf_push_bytes(&msg, p + off as u64, at)
    let code: u32 = sig_check(leaf, alg, msg.ptr, msg.len,
        p + (off + at + 4) as u64, siglen, true)
    rt.buf_free(&msg)
    if code != 0 as u32 {
        return sig_result(code)
    }
    (*t).group = grp
    var i: usize = 0
    while i < pklen {
        (*t).peer_pub[i] = rt.ld8(p, off + 4 + i)
        i = i + 1
    }
    (*t).peer_pub_len = pklen
    return true
}

// One step of the TLS 1.2 handshake (see the states above). true =
// established; `WouldBlock` = call again when the socket is readable.
fn handshake12_step(t: *mut Tls) -> TlsError!bool {
    if (*t).hs_step == 5 as u32 {
        while !(*t).hs_done12 {
            var ht: u32 = 0
            var ho: usize = 0
            var hl: usize = 0
            let before: usize = (*t).tr.len
            let g: bool = try next_handshake(t, &ht, &ho, &hl)
            if ht == HS_CERTIFICATE {
                if (*t).hs_have_cert {
                    return TlsError::Protocol
                }
                rt.buf_clear(&(*t).certbuf)
                rt.buf_push_bytes(&(*t).certbuf, (*t).hsin.ptr + ho as u64, hl)
                (*t).ncerts = 0
                let g3: bool = try parse_certificate12((*t).certbuf.ptr, 0, hl,
                    &(*t).certs, &(*t).ncerts)
                if !check_chain(t, &(*t).certs, (*t).ncerts) {
                    return TlsError::Certificate
                }
                (*t).hs_have_cert = true
            } else if ht == HS_SERVER_KEY_EXCHANGE {
                if !(*t).hs_have_cert || (*t).hs_have_ske {
                    return TlsError::Protocol
                }
                // `hsin` may move while later messages arrive; the parser
                // copies what it keeps
                let g4: bool = try parse_server_key_exchange(t, &(*t).certs[0],
                    (*t).hsin.ptr, ho, hl)
                (*t).hs_have_ske = true
            } else if ht == HS_CERT_REQUEST {
                (*t).hs_cert_req = true // T3: answered with an empty Certificate below
            } else if ht == HS_SERVER_HELLO_DONE {
                if hl != 0 {
                    return TlsError::Protocol
                }
                (*t).hs_done12 = true
            } else if ht == HS_HELLO_REQUEST {
                // never part of the handshake hashes (RFC 5246 7.4.1.1)
                rt.buf_set_len(&(*t).tr, before)
            } else {
                return TlsError::Protocol
            }
        }
        if !(*t).hs_have_cert || !(*t).hs_have_ske {
            return TlsError::Protocol
        }
        let flight: bool = try send_flight12(t)
        (*t).hs_step = 6 as u32
    }

    // ---- the server's: [NewSessionTicket] ChangeCipherSpec Finished
    while !(*t).hs_fin {
        var ht: u32 = 0
        var ho: usize = 0
        var hl: usize = 0
        let before: usize = (*t).tr.len
        let g5: bool = try next_handshake(t, &ht, &ho, &hl)
        if ht == HS_FINISHED {
            // it must come AFTER the ChangeCipherSpec, i.e. be encrypted
            if !(*t).rx12 || hl != 12 {
                return TlsError::Protocol
            }
            var want: [u8; 12] = [0; 12]
            if !prf12.verify_data((*t).prf, (&(*t).master[0]) as u64, false,
                (*t).tr.ptr, before, (&want[0]) as u64) {
                return TlsError::Protocol
            }
            if !chacha.tag_equal((&want[0]) as u64, (*t).hsin.ptr + ho as u64,
                12) {
                return TlsError::Finished
            }
            (*t).hs_fin = true
        } else if ht == HS_NEW_TICKET {
            // not offered (T1); ignored if a server sends one anyway
            (*t).hs_cert_req = (*t).hs_cert_req
        } else {
            return TlsError::Protocol
        }
    }
    if (*t).hsin.len != (*t).hspos {
        return TlsError::Protocol // octets after the Finished in the same record
    }
    (*t).established = true
    (*t).hs_step = 4 as u32
    return true
}

// Our flight after the ServerHelloDone: [empty Certificate], ClientKeyExchange,
// the keys, ChangeCipherSpec, Finished. Sends only (non-blocking sends are
// buffered, N2), so it never answers WouldBlock.
fn send_flight12(t: *mut Tls) -> TlsError!bool {
    if (*t).hs_cert_req {
        var empty: [u8; 7] = [11, 0, 0, 3, 0, 0, 0]
        rt.buf_push_bytes(&(*t).tr, (&empty[0]) as u64, 7)
        if !write_record(t, REC_HANDSHAKE, (&empty[0]) as u64, 7) {
            return TlsError::Io
        }
    }
    var pms: [u8; 32] = [0; 32]
    if !ecdh_shared(t, (*t).group, (&(*t).peer_pub[0]) as u64,
        (&pms[0]) as u64) {
        return TlsError::Protocol
    }
    var cke: rt.Buf = rt.buf_new()
    rt.buf_push(&cke, HS_CLIENT_KEY_EXCHANGE as u8)
    if (*t).group == 23 as u32 {
        push24(&cke, 66)
        rt.buf_push(&cke, 65 as u8)
        rt.buf_push_bytes(&cke, (&(*t).p256_pub[0]) as u64, 65)
    } else {
        push24(&cke, 33)
        rt.buf_push(&cke, 32 as u8)
        rt.buf_push_bytes(&cke, (&(*t).pub_key[0]) as u64, 32)
    }
    rt.buf_push_bytes(&(*t).tr, cke.ptr, cke.len)
    (*t).hs_bytes = (*t).hs_bytes + cke.len
    let sent_cke: bool = write_record(t, REC_HANDSHAKE, cke.ptr, cke.len)
    rt.buf_free(&cke)
    if !sent_cke {
        return TlsError::Io
    }
    // the master secret is derived over the handshake up to and including
    // the ClientKeyExchange (RFC 7627)
    if (*t).ems {
        if !prf12.master_secret_ems((*t).prf, (&pms[0]) as u64, 32, (*t).tr.ptr,
            (*t).tr.len, (&(*t).master[0]) as u64) {
            return TlsError::Protocol
        }
    } else if !prf12.master_secret((*t).prf, (&pms[0]) as u64, 32,
        (&(*t).crandom[0]) as u64, (&(*t).srandom[0]) as u64,
        (&(*t).master[0]) as u64) {
        return TlsError::Protocol
    }
    rt.mem_set((&pms[0]) as u64, 0 as u8, 32)
    var ivlen: usize = 4
    if is_chacha((*t).suite) {
        ivlen = 12
    }
    let kl: usize = (*t).keylen
    var kb: [u8; 96] = [0; 96]
    if !prf12.key_expansion((*t).prf, (&(*t).master[0]) as u64,
        (&(*t).crandom[0]) as u64, (&(*t).srandom[0]) as u64,
        (&kb[0]) as u64, 2 * kl + 2 * ivlen) {
        return TlsError::Protocol
    }
    var i: usize = 0
    while i < kl {
        (*t).ckey[i] = kb[i]
        (*t).skey[i] = kb[kl + i]
        i = i + 1
    }
    i = 0
    while i < ivlen {
        (*t).civ[i] = kb[2 * kl + i]
        (*t).siv[i] = kb[2 * kl + ivlen + i]
        i = i + 1
    }
    rt.mem_set((&kb[0]) as u64, 0 as u8, 96)
    // ChangeCipherSpec in the clear, then everything we send is encrypted
    var ccs: [u8; 1] = [1; 1]
    if !write_record(t, REC_CHANGE_CIPHER, (&ccs[0]) as u64, 1) {
        return TlsError::Io
    }
    (*t).cseq = 0
    (*t).sseq = 0
    (*t).tx12 = true
    var vd: [u8; 12] = [0; 12]
    if !prf12.verify_data((*t).prf, (&(*t).master[0]) as u64, true,
        (*t).tr.ptr, (*t).tr.len, (&vd[0]) as u64) {
        return TlsError::Protocol
    }
    var fin: [u8; 16] = [0; 16]
    fin[0] = HS_FINISHED as u8
    fin[3] = 12 as u8
    i = 0
    while i < 12 {
        fin[4 + i] = vd[i]
        i = i + 1
    }
    rt.buf_push_bytes(&(*t).tr, (&fin[0]) as u64, 16)
    (*t).hs_bytes = (*t).hs_bytes + 16
    if !write_record(t, REC_HANDSHAKE, (&fin[0]) as u64, 16) {
        return TlsError::Io
    }
    return true
}

fn parse_encrypted_extensions(t: *mut Tls, p: u64, off: usize,
    len: usize) {
    if len < 2 {
        return
    }
    let elen: usize = be16(p, off) as usize
    var at: usize = off + 2
    let eend: usize = at + elen
    if eend > off + len {
        return
    }
    while at + 4 <= eend {
        let etype: u32 = be16(p, at)
        let elen2: usize = be16(p, at + 2) as usize
        at = at + 4
        if at + elen2 > eend {
            return
        }
        if etype == 16 as u32 && elen2 >= 3 {
            let nlen: usize = rt.ld8(p, at + 2) as usize
            if nlen <= 32 && at + 3 + nlen <= eend {
                var i: usize = 0
                while i < nlen {
                    (*t).alpn[i] = rt.ld8(p, at + 3 + i)
                    i = i + 1
                }
                (*t).alpnlen = nlen
            }
        }
        at = at + elen2
    }
}

fn send_alert(t: *mut Tls, level: u32, desc: u32) {
    var a: [u8; 2] = [0; 2]
    a[0] = level as u8
    a[1] = desc as u8
    let ok: bool = write_record(t, REC_ALERT, (&a[0]) as u64, 2)
}

// ------------------------------------------------------ Application data

fn tls_write(t: *mut Tls, p: u64, n: usize) -> TlsError!bool {
    if !(*t).established {
        return TlsError::Protocol
    }
    var at: usize = 0
    while at < n {
        var chunk: usize = n - at
        if chunk > 16384 {
            chunk = 16384
        }
        if !write_record(t, REC_APPDATA, p + at as u64, chunk) {
            return TlsError::Io
        }
        at = at + chunk
    }
    return true
}

// Up to `max` octets of plaintext. 0 means the peer is done.
fn tls_read(t: *mut Tls, out: u64, max: usize) -> TlsError!usize {
    if (*t).closed {
        return 0
    }
    while (*t).app.len - (*t).apos == 0 {
        rt.buf_clear(&(*t).app)
        (*t).apos = 0
        var kind: u32 = 0
        var err: bool = false
        // A clean end of stream without close_notify -- see T6.
        if !fill(t, 5, &err) {
            if (*t).blocked {
                return TlsError::WouldBlock // N4
            }
            (*t).closed = true
            if err {
                return TlsError::Io
            }
            (*t).truncated = true
            return 0
        }
        let got: bool = try read_record(t, &kind)
        if kind == REC_ALERT {
            if (*t).rec.len >= 2 {
                (*t).alert_desc = rt.ld8((*t).rec.ptr, 1) as u32
            }
            (*t).closed = true
            if (*t).alert_desc == 0 as u32 {
                return 0 // close_notify
            }
            return TlsError::Alert
        }
        if kind == REC_HANDSHAKE {
            // TLS 1.3: NewSessionTicket after the handshake -- T1, thrown
            // away. TLS 1.2: a HelloRequest asks for a renegotiation, which
            // this client does not do (T7): a warning alert says so.
            if (*t).v12 && (*t).rec.len >= 1 && rt.ld8((*t).rec.ptr, 0) == 0 as u8 {
                send_alert(t, 1 as u32, 100 as u32) // no_renegotiation
            }
            continue
        }
        if kind == REC_CHANGE_CIPHER {
            continue
        }
        if kind != REC_APPDATA {
            return TlsError::Protocol
        }
        rt.buf_push_bytes(&(*t).app, (*t).rec.ptr, (*t).rec.len)
    }
    var n: usize = (*t).app.len - (*t).apos
    if n > max {
        n = max
    }
    rt.mem_copy(out, (*t).app.ptr + (*t).apos as u64, n)
    (*t).apos = (*t).apos + n
    return n
}

fn tls_close(t: *mut Tls) {
    if (*t).established && !(*t).closed {
        send_alert(t, 1 as u32, 0 as u32) // warning, close_notify
    }
    (*t).closed = true
}

// The driver cannot name the error TYPE of an imported module, so the
// mapping lives here -- the same shape `lib/net/http.fi` uses.
fn tls_err_num(e: TlsError) -> u32 {
    if e == TlsError::Io { return 1 as u32 }
    if e == TlsError::Closed { return 2 as u32 }
    if e == TlsError::Protocol { return 3 as u32 }
    if e == TlsError::Version { return 4 as u32 }
    if e == TlsError::Group { return 5 as u32 }
    if e == TlsError::Suite { return 6 as u32 }
    if e == TlsError::Retry { return 7 as u32 }
    if e == TlsError::Alert { return 8 as u32 }
    if e == TlsError::Certificate { return 9 as u32 }
    if e == TlsError::Signature { return 10 as u32 }
    if e == TlsError::Finished { return 11 as u32 }
    if e == TlsError::Decrypt { return 12 as u32 }
    if e == TlsError::Unsupported { return 13 as u32 }
    if e == TlsError::TooLarge { return 14 as u32 }
    if e == TlsError::WouldBlock { return 16 as u32 }
    if e == TlsError::Downgrade { return 17 as u32 }
    return 15 as u32
}

fn tls_err_name(e: TlsError, out: *mut rt.Buf) {
    var t: [u8; 122] = "IoClosedProtocolVersionGroupSuiteRetryAlertCertificateSignatureFinishedDecryptUnsupportedTooLargeRandomWouldBlockDowngrade"
    var offs: [usize; 18] = [0, 0, 2, 8, 16, 23, 28, 33, 38, 43, 54, 63,
        71, 78, 89, 97, 103, 113]
    var lens: [usize; 18] = [0, 2, 6, 8, 7, 5, 5, 5, 5, 11, 9, 8, 7, 11,
        8, 6, 10, 9]
    let k: u32 = tls_err_num(e)
    var i: usize = k as usize
    if i > 17 {
        i = 17
    }
    rt.buf_push_bytes(out, (&t[0]) as u64 + offs[i] as u64, lens[i])
}

// `catch |x| tls.tls_fail_into(&out, x, &failed)` -- a driver cannot name
// the error TYPE of an imported module, so the whole handler lives here.
fn tls_fail_into(out: *mut rt.Buf, e: TlsError, failed: *mut bool) -> bool {
    *failed = true
    var m: [u8; 3] = "ERR"
    rt.buf_push_bytes(out, (&m[0]) as u64, 3)
    tls_err_name(e, out)
    rt.buf_push(out, 10 as u8)
    return false
}

fn tls_fail_len(out: *mut rt.Buf, e: TlsError, failed: *mut bool) -> usize {
    let ok: bool = tls_fail_into(out, e, failed)
    return 0
}

// `catch |e| tls.tls_note_error(&slot, e)`: stores `tls_err_num(e)` in
// `*slot` unless the error is WouldBlock (then 0), and answers false. For a
// non-blocking driver (lib/async/stream.fi) that must tell "call again"
// from "failed" without naming the error type.
fn tls_note_error(slot: *mut u32, e: TlsError) -> bool {
    *slot = 0 as u32
    if e != TlsError::WouldBlock {
        *slot = tls_err_num(e)
    }
    return false
}
