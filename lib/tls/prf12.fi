// SPDX-License-Identifier: MPL-2.0
// lib/tls/prf12.fi -- the TLS 1.2 key derivation (RFC 5246 section 5 and
// 6.3, RFC 7627 extended master secret), round WIN-THREADS / TLS 1.2.
//
// TLS 1.3 replaced all of this with HKDF (`keys.fi`). TLS 1.2 has ONE
// function, the PRF, built from HMAC:
//
//     P_hash(secret, seed) = HMAC(secret, A(1) + seed)
//                          + HMAC(secret, A(2) + seed) + ...
//         A(0) = seed,   A(i) = HMAC(secret, A(i-1))
//     PRF(secret, label, seed) = P_hash(secret, label + seed)
//
// and every key in the handshake comes out of it:
//
//     master_secret   = PRF(pre_master, "extended master secret",
//                           Hash(handshake up to the ClientKeyExchange))[0..48]
//     key_block       = PRF(master, "key expansion",
//                           server_random + client_random)
//     verify_data     = PRF(master, "client finished" | "server finished",
//                           Hash(handshake so far))[0..12]
//
// THE HASH is the one the cipher suite names: SHA-256 for every suite this
// client offers except the two `..._AES_256_GCM_SHA384` ones, which use
// SHA-384 -- in the PRF AND for the handshake hash. `hmac_sha384` is here
// because `std.crypto.hmac` has only SHA-1 and SHA-256.
//
// HONEST
// F1  Both master secret derivations are here: the EXTENDED one is used when
//     the server echoes the extension, the plain "master secret" one for the
//     servers that do not (`tls.fi` T7 says why that is accepted).
// F2  Nothing here is constant time beyond what HMAC is: the secrets are
//     session keys, not long term ones.
import std.rt
import std.crypto.sha256
import std.crypto.sha512
import std.crypto.hmac

export {
    PRF_SHA256, PRF_SHA384,
    hmac_sha384, prf, hash_len, handshake_hash,
    master_secret, master_secret_ems, key_expansion, verify_data,
}

const PRF_SHA256: u32 = 1
const PRF_SHA384: u32 = 2

const BLOCK384: usize = 128

fn hash_len(h: u32) -> usize {
    if h == PRF_SHA384 {
        return 48
    }
    return 32
}

// HMAC-SHA384 (RFC 2104 with the SHA-512 block of 128 octets, 48 octets out).
fn hmac_sha384(key: u64, keylen: usize, msg: u64, msglen: usize, out: u64) {
    var k: [u8; 128] = [0; 128]
    var i: usize = 0
    if keylen > BLOCK384 {
        var kd: [u8; 48] = [0; 48]
        sha512.sha384(key, keylen, (&kd[0]) as u64)
        while i < 48 {
            k[i] = kd[i]
            i = i + 1
        }
    } else {
        while i < keylen {
            k[i] = rt.ld8(key, i)
            i = i + 1
        }
    }
    var ipad: [u8; 128] = [0; 128]
    var opad: [u8; 128] = [0; 128]
    i = 0
    while i < 128 {
        ipad[i] = k[i] ^ 54 as u8
        opad[i] = k[i] ^ 92 as u8
        i = i + 1
    }
    var inner: [u8; 48] = [0; 48]
    var s: sha512.Sha512 = sha512.sha384_new()
    sha512.sha512_update(&s, (&ipad[0]) as u64, 128)
    sha512.sha512_update(&s, msg, msglen)
    sha512.sha512_final(&s, (&inner[0]) as u64)
    var o: sha512.Sha512 = sha512.sha384_new()
    sha512.sha512_update(&o, (&opad[0]) as u64, 128)
    sha512.sha512_update(&o, (&inner[0]) as u64, 48)
    sha512.sha512_final(&o, out)
}

fn hmac_h(h: u32, key: u64, klen: usize, msg: u64, mlen: usize, out: u64) {
    if h == PRF_SHA384 {
        hmac_sha384(key, klen, msg, mlen, out)
    } else {
        hmac.hmac_sha256(key, klen, msg, mlen, out)
    }
}

// The handshake hash of `n` octets of transcript, in the suite's hash.
fn handshake_hash(h: u32, p: u64, n: usize, out: u64) {
    if h == PRF_SHA384 {
        sha512.sha384(p, n, out)
    } else {
        sha256.sha256(p, n, out)
    }
}

// PRF(secret, label, seed) into `out` (`outlen` octets, any length).
fn prf(h: u32, secret: u64, slen: usize, label: u64, llen: usize,
    seed: u64, seedlen: usize, out: u64, outlen: usize) -> bool {
    let hl: usize = hash_len(h)
    // ls = label + seed
    var ls: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&ls, label, llen)
    rt.buf_push_bytes(&ls, seed, seedlen)
    // work = A(i) + label + seed
    var work: rt.Buf = rt.buf_new()
    rt.buf_reserve(&work, hl + ls.len)
    if work.cap < hl + ls.len || ls.len != llen + seedlen {
        rt.buf_free(&ls)
        rt.buf_free(&work)
        return false
    }
    var a: [u8; 48] = [0; 48]
    var blk: [u8; 48] = [0; 48]
    // A(1) = HMAC(secret, label + seed)
    hmac_h(h, secret, slen, ls.ptr, ls.len, (&a[0]) as u64)
    var done: usize = 0
    while done < outlen {
        rt.buf_clear(&work)
        rt.buf_push_bytes(&work, (&a[0]) as u64, hl)
        rt.buf_push_bytes(&work, ls.ptr, ls.len)
        hmac_h(h, secret, slen, work.ptr, work.len, (&blk[0]) as u64)
        var i: usize = 0
        while i < hl && done + i < outlen {
            rt.st8(out, done + i, blk[i])
            i = i + 1
        }
        done = done + hl
        // A(i+1) = HMAC(secret, A(i))
        var next: [u8; 48] = [0; 48]
        hmac_h(h, secret, slen, (&a[0]) as u64, hl, (&next[0]) as u64)
        i = 0
        while i < hl {
            a[i] = next[i]
            i = i + 1
        }
    }
    rt.buf_free(&ls)
    rt.buf_free(&work)
    return true
}

// master_secret = PRF(pms, "master secret", client_random + server_random)[0..48]
fn master_secret(h: u32, pms: u64, plen: usize, crandom: u64, srandom: u64,
    out: u64) -> bool {
    var lab: [u8; 13] = "master secret"
    var seed: [u8; 64] = [0; 64]
    var i: usize = 0
    while i < 32 {
        seed[i] = rt.ld8(crandom, i)
        seed[32 + i] = rt.ld8(srandom, i)
        i = i + 1
    }
    return prf(h, pms, plen, (&lab[0]) as u64, 13, (&seed[0]) as u64, 64, out, 48)
}

// RFC 7627: the seed is the hash of the handshake up to and including the
// ClientKeyExchange, not the two randoms -- which is what ties the master
// secret to THIS handshake (no triple handshake attack).
fn master_secret_ems(h: u32, pms: u64, plen: usize, transcript: u64,
    tlen: usize, out: u64) -> bool {
    var lab: [u8; 22] = "extended master secret"
    var sh: [u8; 48] = [0; 48]
    handshake_hash(h, transcript, tlen, (&sh[0]) as u64)
    return prf(h, pms, plen, (&lab[0]) as u64, 22, (&sh[0]) as u64,
        hash_len(h), out, 48)
}

// key_block = PRF(master, "key expansion", server_random + client_random)
fn key_expansion(h: u32, master: u64, crandom: u64, srandom: u64, out: u64,
    n: usize) -> bool {
    var lab: [u8; 13] = "key expansion"
    var seed: [u8; 64] = [0; 64]
    var i: usize = 0
    while i < 32 {
        seed[i] = rt.ld8(srandom, i)
        seed[32 + i] = rt.ld8(crandom, i)
        i = i + 1
    }
    return prf(h, master, 48, (&lab[0]) as u64, 13, (&seed[0]) as u64, 64, out, n)
}

// verify_data (12 octets) of the Finished message. `client` picks the label.
fn verify_data(h: u32, master: u64, client: bool, transcript: u64,
    tlen: usize, out: u64) -> bool {
    var lc: [u8; 15] = "client finished"
    var ls: [u8; 15] = "server finished"
    var th: [u8; 48] = [0; 48]
    handshake_hash(h, transcript, tlen, (&th[0]) as u64)
    if client {
        return prf(h, master, 48, (&lc[0]) as u64, 15, (&th[0]) as u64,
            hash_len(h), out, 12)
    }
    return prf(h, master, 48, (&ls[0]) as u64, 15, (&th[0]) as u64,
        hash_len(h), out, 12)
}
