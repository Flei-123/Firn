import std.rt

export {
    T_DATA, T_HEADERS, T_PRIORITY, T_RST_STREAM, T_SETTINGS, T_PUSH_PROMISE,
    T_PING, T_GOAWAY, T_WINDOW_UPDATE, T_CONTINUATION,
    F_END_STREAM, F_ACK, F_END_HEADERS, F_PADDED, F_PRIORITY,
    E_NO_ERROR, E_PROTOCOL, E_INTERNAL, E_FLOW_CONTROL, E_SETTINGS_TIMEOUT,
    E_STREAM_CLOSED, E_FRAME_SIZE, E_REFUSED_STREAM, E_CANCEL, E_COMPRESSION,
    S_HEADER_TABLE_SIZE, S_ENABLE_PUSH, S_MAX_CONCURRENT_STREAMS,
    S_INITIAL_WINDOW_SIZE, S_MAX_FRAME_SIZE, S_MAX_HEADER_LIST_SIZE,
    PREFACE_LEN, DEFAULT_FRAME_SIZE, MAX_FRAME_SIZE_LIMIT, DEFAULT_WINDOW, MAX_WINDOW,
    FRAME_HEADER_LEN,
    put_preface, put_frame_header, put_frame, put_setting, put_u32,
    read_frame_header, strip_padding, be32, be16,
}

const T_DATA: u8 = 0
const T_HEADERS: u8 = 1
const T_PRIORITY: u8 = 2
const T_RST_STREAM: u8 = 3
const T_SETTINGS: u8 = 4
const T_PUSH_PROMISE: u8 = 5
const T_PING: u8 = 6
const T_GOAWAY: u8 = 7
const T_WINDOW_UPDATE: u8 = 8
const T_CONTINUATION: u8 = 9

const F_END_STREAM: u8 = 1
const F_ACK: u8 = 1
const F_END_HEADERS: u8 = 4
const F_PADDED: u8 = 8
const F_PRIORITY: u8 = 32

const E_NO_ERROR: u32 = 0
const E_PROTOCOL: u32 = 1
const E_INTERNAL: u32 = 2
const E_FLOW_CONTROL: u32 = 3
const E_SETTINGS_TIMEOUT: u32 = 4
const E_STREAM_CLOSED: u32 = 5
const E_FRAME_SIZE: u32 = 6
const E_REFUSED_STREAM: u32 = 7
const E_CANCEL: u32 = 8
const E_COMPRESSION: u32 = 9

const S_HEADER_TABLE_SIZE: u32 = 1
const S_ENABLE_PUSH: u32 = 2
const S_MAX_CONCURRENT_STREAMS: u32 = 3
const S_INITIAL_WINDOW_SIZE: u32 = 4
const S_MAX_FRAME_SIZE: u32 = 5
const S_MAX_HEADER_LIST_SIZE: u32 = 6

const PREFACE_LEN: usize = 24
const FRAME_HEADER_LEN: usize = 9
const DEFAULT_FRAME_SIZE: usize = 16384
const MAX_FRAME_SIZE_LIMIT: usize = 16777215
const DEFAULT_WINDOW: i64 = 65535
const MAX_WINDOW: i64 = 2147483647

fn put_preface(out: *mut rt.Buf) {
    let s: str = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"
    rt.buf_push_bytes(out, s.p as u64, s.n)
}

fn put_u32(out: *mut rt.Buf, v: u32) {
    rt.buf_push(out, ((v >> 24) & 255) as u8)
    rt.buf_push(out, ((v >> 16) & 255) as u8)
    rt.buf_push(out, ((v >> 8) & 255) as u8)
    rt.buf_push(out, (v & 255) as u8)
}

fn put_frame_header(out: *mut rt.Buf, len: usize, ftype: u8, flags: u8, stream: u32) {
    rt.buf_push(out, ((len >> 16) & 255) as u8)
    rt.buf_push(out, ((len >> 8) & 255) as u8)
    rt.buf_push(out, (len & 255) as u8)
    rt.buf_push(out, ftype)
    rt.buf_push(out, flags)
    put_u32(out, stream & 2147483647)
}

fn put_frame(out: *mut rt.Buf, ftype: u8, flags: u8, stream: u32, p: u64, n: usize) {
    put_frame_header(out, n, ftype, flags, stream)
    rt.buf_push_bytes(out, p, n)
}

fn put_setting(out: *mut rt.Buf, id: u32, value: u32) {
    rt.buf_push(out, ((id >> 8) & 255) as u8)
    rt.buf_push(out, (id & 255) as u8)
    put_u32(out, value)
}

fn be32(p: u64, at: usize) -> u32 {
    return ((rt.ld8(p, at) as u32) << 24) | ((rt.ld8(p, at + 1) as u32) << 16)
    | ((rt.ld8(p, at + 2) as u32) << 8) | (rt.ld8(p, at + 3) as u32)
}

fn be16(p: u64, at: usize) -> u32 {
    return ((rt.ld8(p, at) as u32) << 8) | (rt.ld8(p, at + 1) as u32)
}

fn read_frame_header(p: u64, n: usize, len: *mut usize, ftype: *mut u8, flags: *mut u8,
    stream: *mut u32) -> bool {
    if n < FRAME_HEADER_LEN { return false }
    *len = ((rt.ld8(p, 0) as usize) << 16) | ((rt.ld8(p, 1) as usize) << 8) | (rt.ld8(p, 2) as usize)
    *ftype = rt.ld8(p, 3)
    *flags = rt.ld8(p, 4)
    *stream = be32(p, 5) & 2147483647
    return true
}

fn strip_padding(p: u64, n: usize, flags: u8, skip: usize, off: *mut usize, len: *mut usize) -> bool {
    *off = 0
    *len = n
    if (flags & F_PADDED) != 0 {
        if n < 1 { return false }
        let pad: usize = rt.ld8(p, 0) as usize
        if pad + 1 > n { return false }
        *off = 1
        *len = n - 1 - pad
    }
    if (flags & F_PRIORITY) != 0 && skip > 0 {
        if *len < skip { return false }
        *off = *off + skip
        *len = *len - skip
    }
    return true
}
