// SPDX-License-Identifier: MPL-2.0
// lib/net/web.fi -- net.web: HTTP in one call, the `urllib.request` / `requests.get` of a script.
//
//     import net.web
//
//     var body: rt.Buf = rt.buf_new()
//     let st: u32 = web.get("http://127.0.0.1:8080/items", &body)       // 200, body in `body`
//     let st2: u32 = web.post_json("http://host/items", "{\"a\": 1}", &body)
//     web.download("http://host/pkg.zip", "/tmp/pkg.zip")               // true when 200 and written
//     let text: str = rt.buf_str(&body)                                 // view of the buffer
//
// The answer is the HTTP status (any status, 404 is an answer, not an error), or 0 when no
// answer came (refused, timeout, bad URL, TLS); `web.last_error()` then says which
// `net.http` error number it was. Redirects, cookies, gzip, TLS are those of net.http.
//
// HONEST
//   W1 One connection per call (a fresh net.http client), no keep-alive between calls.
//   W2 The body is held in memory (net.http limit, `BODY_MAX`).
//   W3 No headers other than the content type of a POST; for those use net.http directly.
//   W4 Blocking. For many requests at once use async.ahttp.
import std.rt
import std.fs
import net.http

export { get, post, post_json, download, last_error }

static mut last_err: u32 = 0

// The error number (net.http `err_num`) of the last call that answered 0; 0 after an answer.
fn last_error() -> u32 { return last_err }

fn run(post_it: bool, url: str, ctype: str, payload: str, out: *mut rt.Buf) -> u32 {
    var c: http.Client = http.client_new()
    var r: http.Response = http.resp_new()
    var e: u32 = 0
    if !http.client_init(&c) {
        last_err = 16 as u32
        rt.buf_clear(out)
        return 0
    }
    http.resp_init(&r)
    if post_it {
        e = http.http_post_num(&c, url.p as u64, url.n, payload.p as u64, payload.n,
            ctype.p as u64, ctype.n, &r)
    } else {
        e = http.http_get_num(&c, url.p as u64, url.n, &r)
    }
    last_err = e
    var st: u32 = 0
    rt.buf_clear(out)
    if e == 0 {
        st = http.resp_status(&r)
        rt.buf_push_bytes(out, http.resp_body_ptr(&r), http.resp_body_len(&r))
    }
    http.resp_free(&r)
    http.client_free(&c)
    return st
}

// GET `url`; the body replaces the content of `out`. Returns the status, 0 = no answer.
fn get(url: str, out: *mut rt.Buf) -> u32 {
    return run(false, url, "", "", out)
}

// POST `payload` with the content type `ctype`.
fn post(url: str, ctype: str, payload: str, out: *mut rt.Buf) -> u32 {
    return run(true, url, ctype, payload, out)
}

// POST `payload` as application/json.
fn post_json(url: str, payload: str, out: *mut rt.Buf) -> u32 {
    return run(true, url, "application/json", payload, out)
}

// GET `url` into the file `path` (written only on status 200). True when the file was written.
fn download(url: str, path: str) -> bool {
    var b: rt.Buf = rt.buf_new()
    let st: u32 = get(url, &b)
    var ok: bool = false
    if st == 200 as u32 {
        ok = (fs.write_file(path, rt.buf_ptr(&b), rt.buf_len(&b)) catch 0) == rt.buf_len(&b)
    }
    rt.buf_free(&b)
    return ok
}
