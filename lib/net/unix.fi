// SPDX-License-Identifier: MPL-2.0
// lib/net/unix.fi -- net.unix: Unix domain sockets by file descriptor, with poll.
//
//     import net.unix
//
//     let fd: i32 = unix.unix_connect("/run/user/1000/bus", false)     // < 0 = errno
//     let l: i32 = unix.unix_listen("/tmp/x.sock", false, 4)
//     let c: i32 = unix.unix_accept(l)
//     unix.fd_wait(c, unix.WAIT_READ, 500)                              // 1 ready, 0 timeout, -1 error
//     unix.fd_send_all(c, p, n)   unix.fd_recv(c, p, n)   unix.fd_close(c)
//
// WHY A SECOND FILE next to std.net: `net.connect_unix` hands the kernel an
// address length of 110 octets. For a file path that is harmless (the path is
// NUL-terminated); for an ABSTRACT socket (path begins with a NUL octet, the
// D-Bus session bus of many desktops: `unix:abstract=...`) the whole length is
// the name, so a 110-octet name never matches. Here the length is exact:
// `2 + plen` for an abstract name, `2 + plen + 1` for a file path.
//
// No `listen` exists in std.net for Unix sockets at all; the single-instance
// channel and the D-Bus test peers need it.
//
// HONEST
// U1  Linux (and any POSIX with these system calls) only. The Windows
//     counterparts are named pipes (appkit.platform.windows, plat_ipc_*).
// U2  Everything is BLOCKING except what `fd_wait` guards. A caller that
//     wants to wait with a timeout calls `fd_wait` first and then reads once.
// U3  A path longer than 107 octets is refused (sockaddr_un has 108).
// U4  `unix_listen` removes a stale socket file first (and only a socket
//     file: whatever else sits at the path makes the call fail).
// U5  No file descriptor passing (SCM_RIGHTS): D-Bus is negotiated without
//     UNIX_FD, so messages that carry descriptors are never requested.
import std.rt
import std.str

export {
    unix_connect, unix_listen, unix_accept, fd_close, fd_wait, fd_recv, fd_read, fd_send_all,
    fd_set_nonblock, unix_peer_uid, getuid_now,
    WAIT_READ, WAIT_WRITE, ERR_AGAIN,
}

const SYS_READ: i64 = 0
const SYS_WRITE: i64 = 1
const SYS_CLOSE: i64 = 3
const SYS_POLL: i64 = 7
const SYS_SOCKET: i64 = 41
const SYS_CONNECT: i64 = 42
const SYS_SENDTO: i64 = 44
const SYS_RECVFROM: i64 = 45
const SYS_BIND: i64 = 49
const SYS_LISTEN: i64 = 50
const SYS_GETSOCKOPT: i64 = 55
const SYS_FCNTL: i64 = 72
const SYS_GETUID: i64 = 102
const SYS_ACCEPT4: i64 = 288

const AF_UNIX: i64 = 1
const SOCK_STREAM: i64 = 1
const SOCK_CLOEXEC: i64 = 524288
const MSG_NOSIGNAL: i64 = 16384
const SOL_SOCKET: i64 = 1
const SO_PEERCRED: i64 = 17
const F_GETFL: i64 = 3
const F_SETFL: i64 = 4
const O_NONBLOCK: i64 = 2048
const EINTR: i64 = -4
const EAGAIN: i64 = -11
const POLLIN: i64 = 1
const POLLOUT: i64 = 4

const WAIT_READ: i32 = 1
const WAIT_WRITE: i32 = 4
const ERR_AGAIN: i64 = -11

fn getuid_now() -> u32 {
    return syscall(SYS_GETUID, 0, 0, 0, 0, 0, 0) as u32
}

// Fills `sa` (110 octets) and returns the address length, or 0 when the name is too long.
fn make_addr(sa: *mut u8, path: str, abstract: bool) -> usize {
    let plen: usize = path.length()
    if plen == 0 || plen > 107 {
        return 0
    }
    var i: usize = 0
    while i < 110 {
        *((sa as u64 + i as u64) as *mut u8) = 0 as u8
        i = i + 1
    }
    *sa = AF_UNIX as u8
    var k: usize = 0
    var off: usize = 2
    if abstract {
        off = 3 // sa[2] stays NUL
    }
    while k < plen {
        *((sa as u64 + (off + k) as u64) as *mut u8) = path.chars(k)
        k = k + 1
    }
    if abstract {
        return 2 + 1 + plen
    }
    return 2 + plen + 1
}

fn unix_connect(path: str, abstract: bool) -> i32 {
    var sa: [u8; 110] = [0; 110]
    let alen: usize = make_addr(&sa[0], path, abstract)
    if alen == 0 {
        return -22
    }
    let fd: i64 = syscall(SYS_SOCKET, AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, 0, 0, 0)
    if fd < 0 {
        return fd as i32
    }
    var r: i64 = EINTR
    while r == EINTR {
        r = syscall(SYS_CONNECT, fd, (&sa[0]) as i64, alen as i64, 0, 0, 0)
    }
    if r < 0 {
        syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0)
        return r as i32
    }
    return fd as i32
}

fn unix_listen(path: str, abstract: bool, backlog: i32) -> i32 {
    var sa: [u8; 110] = [0; 110]
    let alen: usize = make_addr(&sa[0], path, abstract)
    if alen == 0 {
        return -22
    }
    let fd: i64 = syscall(SYS_SOCKET, AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, 0, 0, 0)
    if fd < 0 {
        return fd as i32
    }
    var r: i64 = syscall(SYS_BIND, fd, (&sa[0]) as i64, alen as i64, 0, 0, 0)
    if r < 0 {
        syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0)
        return r as i32
    }
    r = syscall(SYS_LISTEN, fd, backlog as i64, 0, 0, 0, 0)
    if r < 0 {
        syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0)
        return r as i32
    }
    return fd as i32
}

// One pending connection (blocks when there is none; use fd_wait first).
fn unix_accept(l: i32) -> i32 {
    var r: i64 = EINTR
    while r == EINTR {
        r = syscall(SYS_ACCEPT4, l as i64, 0, 0, SOCK_CLOEXEC, 0, 0)
    }
    return r as i32
}

fn fd_close(fd: i32) {
    if fd >= 0 {
        syscall(SYS_CLOSE, fd as i64, 0, 0, 0, 0, 0)
    }
}

fn fd_set_nonblock(fd: i32, on: bool) -> bool {
    let fl: i64 = syscall(SYS_FCNTL, fd as i64, F_GETFL, 0, 0, 0, 0)
    if fl < 0 {
        return false
    }
    var nf: i64 = fl & (~O_NONBLOCK)
    if on {
        nf = fl | O_NONBLOCK
    }
    return syscall(SYS_FCNTL, fd as i64, F_SETFL, nf, 0, 0, 0) >= 0
}

// Waits until `fd` is readable (WAIT_READ) or writable (WAIT_WRITE).
// 1 = ready (or hung up: the next read tells), 0 = timeout, -1 = error.
// `ms` < 0 waits forever.
fn fd_wait(fd: i32, what: i32, ms: i64) -> i32 {
    var pfd: [i32; 2] = [0; 2]
    pfd[0] = fd
    pfd[1] = what
    while true {
        let r: i64 = syscall(SYS_POLL, (&pfd[0]) as i64, 1, ms, 0, 0, 0)
        if r == EINTR {
            continue
        }
        if r < 0 {
            return -1
        }
        if r == 0 {
            return 0
        }
        return 1
    }
    return -1
}

// A read of up to `n` octets. 0 = the peer closed, < 0 = negated errno
// (-11 = nothing there on a non-blocking descriptor).
fn fd_recv(fd: i32, p: u64, n: usize) -> i64 {
    var r: i64 = EINTR
    while r == EINTR {
        r = syscall(SYS_RECVFROM, fd as i64, p as i64, n as i64, 0, 0, 0)
    }
    return r
}

// `read(2)` for descriptors that are not sockets (inotify, pipes, files).
// Same results as `fd_recv`: 0 = end, < 0 = negated errno (-11 = nothing there yet).
fn fd_read(fd: i32, p: u64, n: usize) -> i64 {
    var r: i64 = EINTR
    while r == EINTR {
        r = syscall(SYS_READ, fd as i64, p as i64, n as i64, 0, 0, 0)
    }
    return r
}

// Writes all `n` octets (MSG_NOSIGNAL: a vanished peer is an error, not a signal).
fn fd_send_all(fd: i32, p: u64, n: usize) -> bool {
    var done: usize = 0
    while done < n {
        let r: i64 = syscall(SYS_SENDTO, fd as i64, (p + done as u64) as i64, (n - done) as i64,
            MSG_NOSIGNAL, 0, 0)
        if r == EINTR {
            continue
        }
        if r == EAGAIN {
            fd_wait(fd, WAIT_WRITE, 1000)
            continue
        }
        if r <= 0 {
            return false
        }
        done = done + r as usize
    }
    return true
}

// The user id of the process at the other end of a connected Unix socket
// (SO_PEERCRED: pid, uid, gid as three u32), or 0xFFFFFFFF when unknown.
fn unix_peer_uid(fd: i32) -> u32 {
    var cred: [u32; 3] = [0; 3]
    var len: [u32; 1] = [12]
    let r: i64 = syscall(SYS_GETSOCKOPT, fd as i64, SOL_SOCKET, SO_PEERCRED, (&cred[0]) as i64,
        (&len[0]) as i64, 0)
    if r < 0 {
        return 4294967295 as u32
    }
    return cred[1]
}
