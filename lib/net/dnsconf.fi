// SPDX-License-Identifier: MPL-2.0
// lib/net/dnsconf.fi -- WHERE THE NAME SERVERS AND THE HOSTS TABLE COME
// FROM, on Linux (round DNS). The Windows twin is dnsconf.windows.fi;
// `import net.dnsconf` takes it on the Windows target.
//
// The contract is two functions that hand back TEXT, not parsed data:
//
//   conf_resolv(out) -- something in the format of resolv.conf
//                       (`nameserver 192.0.2.1` lines). On Linux that is
//                       the file itself; on Windows the text is made up
//                       from GetNetworkParams. One parser (lib/net/dns.fi,
//                       `dns_parse_resolv_conf`) then serves both, and it
//                       is unit tested against fixtures on every machine.
//   conf_hosts(out)  -- the hosts table, /etc/hosts format.
//
// Both return false when there is nothing (no file, no adapter); the
// resolver then falls back to its public servers (HONEST D6 in dns.fi).
import std.rt

export { conf_resolv, conf_hosts }

fn conf_resolv(out: *mut rt.Buf) -> bool {
    var path: [u8; 17] = "/etc/resolv.conf\0"
    return rt.read_file((&path[0]) as u64, out)
}

fn conf_hosts(out: *mut rt.Buf) -> bool {
    var path: [u8; 11] = "/etc/hosts\0"
    return rt.read_file((&path[0]) as u64, out)
}
