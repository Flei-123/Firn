// SPDX-License-Identifier: GPL-2.0-only
profile kernel

// lib/net/wire.fi -- round K3: the octets on the wire.
//
// A network stack is, before it is anything else, a function from octet
// sequences to octet sequences. This file is that function and nothing
// else: it reads and writes headers, it computes the one checksum the
// internet protocols share, and it does the arithmetic modulo 2^32 that
// TCP sequence numbers live in. It holds NO state, it asks nobody for
// memory and it makes no system call -- which is why it says `profile
// kernel` in its first line and why the compiler, not this comment, is
// what proves that (SPEC 2.1).
//
// TWO TRAPS OF THIS LANGUAGE ARE THE REASON THIS FILE LOOKS THE WAY IT
// DOES.
//
//   1. ARITHMETIC IS CHECKED (SPEC 13, item L9, since round 72). At the
//      CLI default level (`dev-fast`) every `+`, `-`, `*` and every
//      narrowing `as` is checked and a value out of range aborts the
//      program. TCP sequence numbers are DEFINED to wrap; a checksum is
//      DEFINED to wrap. So every place where the wrap-around is the point
//      writes `+%` / `-%` and every narrowing conversion masks first:
//      `(v & 0xFFFF) as u16`, never `v as u16`. That is not decoration --
//      `(a as u32) << 8` on two octets produces a value that does not fit
//      into a `u16`, and the abort would come at the first frame.
//
//   2. `as` ON A NEGATIVE VALUE ABORTS. Where a bit pattern is wanted
//      rather than a number -- the difference of two sequence numbers, an
//      error code coming back out of a system call -- the value is masked
//      in `i64` first: `((i as i64) & 4294967295) as u32`.
//
// THE SEQUENCE ARITHMETIC, and why it is not a comparison. RFC 793
// section 3.3: sequence numbers are 32 bit and wrap. `a < b` is therefore
// meaningless; what is meant is "a lies before b in the window", and that
// question only has an answer if the two are less than 2^31 apart. The
// test is the sign bit of the wrapping difference, which is exactly what
// `seq_lt` computes. A stack that compares sequence numbers with `<`
// works perfectly until the counter passes 2^32 -- once every four
// gigaoctets -- and then loses the connection. Round 72 makes the trap
// visible instead of silent: `a - b` would ABORT there.

export {
    // raw octets
    ld8, st8, be16, put16, be32, put32, copy, blank, same,
    // checksums
    sum16, sum_add, fold, checksum, pseudo_sum,
    // ethernet
    ETH_HDR, ETYPE_IP4, ETYPE_ARP, MTU, FRAME_MAX,
    eth_type, eth_dst_is, eth_is_broadcast, eth_build, mac_broadcast, mac_copy,
    // arp
    ARP_LEN, ARP_REQUEST, ARP_REPLY,
    arp_op, arp_spa, arp_tpa, arp_sha_at, arp_ok, arp_build,
    // ipv4
    IP_HDR, IP_ICMP, IP_TCP, IP_UDP,
    ip4, ip_a, ip_b, ip_c, ip_d,
    ip_version, ip_ihl, ip_total, ip_proto, ip_src, ip_dst, ip_ttl, ip_id,
    ip_is_fragment, ip_header_ok, ip_build,
    // icmp
    ICMP_ECHO, ICMP_ECHO_REPLY, ICMP_UNREACH, ICMP_TIME_EXCEEDED,
    icmp_type, icmp_code,
    // udp
    UDP_HDR, udp_sport, udp_dport, udp_len, udp_csum, udp_build,
    // tcp
    TCP_HDR, F_FIN, F_SYN, F_RST, F_PSH, F_ACK, F_URG,
    tcp_sport, tcp_dport, tcp_seq, tcp_ack, tcp_off, tcp_flags, tcp_wnd,
    tcp_csum_field, tcp_data_at, tcp_mss_option,
    // sequence arithmetic modulo 2^32
    seq_lt, seq_le, seq_gt, seq_ge, seq_diff, seq_in,
    // a generator for the initial sequence number
    next_random,
}

// ===================================================================
// 1. raw octets
// ===================================================================

fn ld8(p: *mut u8, i: usize) -> u8 {
    return *(((p as u64) + i as u64) as *mut u8)
}

fn st8(p: *mut u8, i: usize, v: u8) {
    *(((p as u64) + i as u64) as *mut u8) = v
}

// Network byte order is big endian. It is read octet for octet on
// purpose: a `*mut u16` on an odd address is a different question on
// every machine, and an IP header inside an Ethernet frame sits at
// offset 14.
fn be16(p: *mut u8, i: usize) -> u16 {
    let hi: u32 = ld8(p, i) as u32
    let lo: u32 = ld8(p, i + 1) as u32
    return (((hi << 8) | lo) & 0xFFFF) as u16
}

fn put16(p: *mut u8, i: usize, v: u16) {
    st8(p, i, ((v as u32 >> 8) & 0xFF) as u8)
    st8(p, i + 1, (v as u32 & 0xFF) as u8)
}

fn be32(p: *mut u8, i: usize) -> u32 {
    let a: u32 = ld8(p, i) as u32
    let b: u32 = ld8(p, i + 1) as u32
    let c: u32 = ld8(p, i + 2) as u32
    let d: u32 = ld8(p, i + 3) as u32
    return (a << 24) | (b << 16) | (c << 8) | d
}

fn put32(p: *mut u8, i: usize, v: u32) {
    st8(p, i, ((v >> 24) & 0xFF) as u8)
    st8(p, i + 1, ((v >> 16) & 0xFF) as u8)
    st8(p, i + 2, ((v >> 8) & 0xFF) as u8)
    st8(p, i + 3, (v & 0xFF) as u8)
}

fn copy(dst: *mut u8, src: *mut u8, n: usize) {
    var i: usize = 0
    while i < n {
        st8(dst, i, ld8(src, i))
        i = i + 1
    }
}

fn blank(dst: *mut u8, n: usize) {
    var i: usize = 0
    while i < n {
        st8(dst, i, 0 as u8)
        i = i + 1
    }
}

fn same(a: *mut u8, b: *mut u8, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        if ld8(a, i) != ld8(b, i) { return false }
        i = i + 1
    }
    return true
}

// ===================================================================
// 2. the internet checksum (RFC 1071)
// ===================================================================
//
// The one's complement sum of the 16 bit words, complemented. Summed in
// a `u64` so that no carry can go out of range -- 1500 octets are at
// most 750 words of 65535, which is far from 2^64. Folding happens once
// at the end.

fn sum16(p: *mut u8, n: usize) -> u64 {
    var acc: u64 = 0
    var i: usize = 0
    while i + 1 < n {
        acc = acc + be16(p, i) as u64
        i = i + 2
    }
    // An odd length pads with a zero octet on the RIGHT -- the last
    // octet is the HIGH half of the word, not the low one.
    if i < n {
        acc = acc + ((ld8(p, i) as u64) << 8)
    }
    return acc
}

fn sum_add(acc: u64, v: u64) -> u64 {
    return acc + v
}

fn fold(acc: u64) -> u16 {
    var a: u64 = acc
    while (a >> 16) != 0 {
        a = (a & 0xFFFF) + (a >> 16)
    }
    return ((~a) & 0xFFFF) as u16
}

fn checksum(p: *mut u8, n: usize) -> u16 {
    return fold(sum16(p, n))
}

// The TCP/UDP pseudo header: source, destination, a zero octet, the
// protocol number and the length of the protocol part.
fn pseudo_sum(src: u32, dst: u32, proto: u8, length: usize) -> u64 {
    var acc: u64 = 0
    acc = acc + ((src >> 16) & 0xFFFF) as u64
    acc = acc + (src & 0xFFFF) as u64
    acc = acc + ((dst >> 16) & 0xFFFF) as u64
    acc = acc + (dst & 0xFFFF) as u64
    acc = acc + proto as u64
    acc = acc + length as u64
    return acc
}

// ===================================================================
// 3. ethernet
// ===================================================================

const ETH_HDR: usize = 14
const ETYPE_IP4: u16 = 0x0800
const ETYPE_ARP: u16 = 0x0806
const MTU: usize = 1500
const FRAME_MAX: usize = 1514 // 14 + 1500, without the CRC the card adds

fn eth_type(f: *mut u8) -> u16 {
    return be16(f, 12)
}

fn eth_dst_is(f: *mut u8, mac: *mut u8) -> bool {
    return same(f, mac, 6)
}

fn eth_is_broadcast(f: *mut u8) -> bool {
    var i: usize = 0
    while i < 6 {
        if ld8(f, i) != 0xFF as u8 { return false }
        i = i + 1
    }
    return true
}

fn mac_copy(dst: *mut u8, src: *mut u8) {
    copy(dst, src, 6)
}

fn mac_broadcast(dst: *mut u8) {
    var i: usize = 0
    while i < 6 {
        st8(dst, i, 0xFF as u8)
        i = i + 1
    }
}

fn eth_build(f: *mut u8, dmac: *mut u8, smac: *mut u8, etype: u16) {
    copy(f, dmac, 6)
    copy(((f as u64) + 6) as *mut u8, smac, 6)
    put16(f, 12, etype)
}

// ===================================================================
// 4. ARP (RFC 826)
// ===================================================================

const ARP_LEN: usize = 28
const ARP_REQUEST: u16 = 1
const ARP_REPLY: u16 = 2

fn arp_op(a: *mut u8) -> u16 {
    return be16(a, 6)
}

fn arp_spa(a: *mut u8) -> u32 {
    return be32(a, 14)
}

fn arp_tpa(a: *mut u8) -> u32 {
    return be32(a, 24)
}

// The sender hardware address, in place -- no copy.
fn arp_sha_at(a: *mut u8) -> *mut u8 {
    return ((a as u64) + 8) as *mut u8
}

// Ethernet over IPv4, six octet hardware address, four octet protocol
// address. Anything else this stack does not answer -- and says so
// rather than guessing at the offsets.
fn arp_ok(a: *mut u8, n: usize) -> bool {
    if n < ARP_LEN { return false }
    if be16(a, 0) != 1 as u16 { return false }
    if be16(a, 2) != ETYPE_IP4 { return false }
    if ld8(a, 4) != 6 as u8 { return false }
    if ld8(a, 5) != 4 as u8 { return false }
    return true
}

fn arp_build(a: *mut u8, op: u16, sha: *mut u8, spa: u32, tha: *mut u8, tpa: u32) {
    put16(a, 0, 1 as u16)
    put16(a, 2, ETYPE_IP4)
    st8(a, 4, 6 as u8)
    st8(a, 5, 4 as u8)
    put16(a, 6, op)
    copy(((a as u64) + 8) as *mut u8, sha, 6)
    put32(a, 14, spa)
    copy(((a as u64) + 18) as *mut u8, tha, 6)
    put32(a, 24, tpa)
}

// ===================================================================
// 5. IPv4 (RFC 791)
// ===================================================================

const IP_HDR: usize = 20
const IP_ICMP: u8 = 1
const IP_TCP: u8 = 6
const IP_UDP: u8 = 17

fn ip4(a: u8, b: u8, c: u8, d: u8) -> u32 {
    return ((a as u32) << 24) | ((b as u32) << 16) | ((c as u32) << 8) | (d as u32)
}

fn ip_a(v: u32) -> u8 { return ((v >> 24) & 0xFF) as u8 }
fn ip_b(v: u32) -> u8 { return ((v >> 16) & 0xFF) as u8 }
fn ip_c(v: u32) -> u8 { return ((v >> 8) & 0xFF) as u8 }
fn ip_d(v: u32) -> u8 { return (v & 0xFF) as u8 }

fn ip_version(h: *mut u8) -> u8 { return ((ld8(h, 0) as u32 >> 4) & 0xF) as u8 }
fn ip_ihl(h: *mut u8) -> usize { return ((ld8(h, 0) as u32) & 0xF) as usize * 4 }
fn ip_total(h: *mut u8) -> usize { return be16(h, 2) as usize }
fn ip_id(h: *mut u8) -> u16 { return be16(h, 4) }
fn ip_ttl(h: *mut u8) -> u8 { return ld8(h, 8) }
fn ip_proto(h: *mut u8) -> u8 { return ld8(h, 9) }
fn ip_src(h: *mut u8) -> u32 { return be32(h, 12) }
fn ip_dst(h: *mut u8) -> u32 { return be32(h, 16) }

// A datagram is a fragment when MF is set or when the offset is not
// zero. This stack does not reassemble; it RECOGNISES the case and
// refuses it, which is the honest half. Silently treating a fragment as
// a whole datagram would hand a truncated TCP segment to the state
// machine.
fn ip_is_fragment(h: *mut u8) -> bool {
    let w: u32 = be16(h, 6) as u32
    if (w & 0x2000) != 0 { return true } // MF
    if (w & 0x1FFF) != 0 { return true } // a non-zero offset
    return false
}

// Everything a receiver has to check before it believes an octet of the
// payload: version, header length, the length fields against the frame
// that really arrived, and the header checksum.
fn ip_header_ok(h: *mut u8, avail: usize) -> bool {
    if avail < IP_HDR { return false }
    if ip_version(h) != 4 as u8 { return false }
    let ihl: usize = ip_ihl(h)
    if ihl < IP_HDR { return false }
    if ihl > avail { return false }
    let total: usize = ip_total(h)
    if total < ihl { return false }
    if total > avail { return false }
    if checksum(h, ihl) != 0 as u16 { return false }
    return true
}

fn ip_build(h: *mut u8, id: u16, proto: u8, src: u32, dst: u32, payload: usize) {
    st8(h, 0, 0x45 as u8)
    st8(h, 1, 0 as u8)
    put16(h, 2, ((IP_HDR + payload) & 0xFFFF) as u16)
    put16(h, 4, id)
    put16(h, 6, 0x4000 as u16) // Don't Fragment -- this stack sends none
    st8(h, 8, 64 as u8)
    st8(h, 9, proto)
    put16(h, 10, 0 as u16)
    put32(h, 12, src)
    put32(h, 16, dst)
    put16(h, 10, checksum(h, IP_HDR))
}

// ===================================================================
// 6. ICMP (RFC 792)
// ===================================================================

const ICMP_ECHO_REPLY: u8 = 0
const ICMP_UNREACH: u8 = 3
const ICMP_ECHO: u8 = 8
const ICMP_TIME_EXCEEDED: u8 = 11

fn icmp_type(p: *mut u8) -> u8 { return ld8(p, 0) }
fn icmp_code(p: *mut u8) -> u8 { return ld8(p, 1) }

// ===================================================================
// 7. UDP (RFC 768)
// ===================================================================

const UDP_HDR: usize = 8

fn udp_sport(p: *mut u8) -> u16 { return be16(p, 0) }
fn udp_dport(p: *mut u8) -> u16 { return be16(p, 2) }
fn udp_len(p: *mut u8) -> usize { return be16(p, 4) as usize }
fn udp_csum(p: *mut u8) -> u16 { return be16(p, 6) }

// The payload has to lie behind `p` already. A checksum of zero means
// "not computed" in UDP; this stack always computes one, and where the
// result is zero it sends 0xFFFF, as RFC 768 prescribes.
fn udp_build(p: *mut u8, sport: u16, dport: u16, payload: usize, src: u32, dst: u32) {
    put16(p, 0, sport)
    put16(p, 2, dport)
    put16(p, 4, ((UDP_HDR + payload) & 0xFFFF) as u16)
    put16(p, 6, 0 as u16)
    var acc: u64 = pseudo_sum(src, dst, IP_UDP, UDP_HDR + payload)
    acc = acc + sum16(p, UDP_HDR + payload)
    var c: u16 = fold(acc)
    if c == 0 as u16 { c = 0xFFFF as u16 }
    put16(p, 6, c)
}

// ===================================================================
// 8. TCP (RFC 793 / 9293)
// ===================================================================

const TCP_HDR: usize = 20
const F_FIN: u8 = 0x01
const F_SYN: u8 = 0x02
const F_RST: u8 = 0x04
const F_PSH: u8 = 0x08
const F_ACK: u8 = 0x10
const F_URG: u8 = 0x20

fn tcp_sport(p: *mut u8) -> u16 { return be16(p, 0) }
fn tcp_dport(p: *mut u8) -> u16 { return be16(p, 2) }
fn tcp_seq(p: *mut u8) -> u32 { return be32(p, 4) }
fn tcp_ack(p: *mut u8) -> u32 { return be32(p, 8) }
fn tcp_off(p: *mut u8) -> usize { return ((ld8(p, 12) as u32 >> 4) & 0xF) as usize * 4 }
fn tcp_flags(p: *mut u8) -> u8 { return ld8(p, 13) }
fn tcp_wnd(p: *mut u8) -> u32 { return be16(p, 14) as u32 }
fn tcp_csum_field(p: *mut u8) -> u16 { return be16(p, 16) }

fn tcp_data_at(p: *mut u8) -> *mut u8 {
    return ((p as u64) + tcp_off(p) as u64) as *mut u8
}

// Walks the option field and answers with the maximum segment size the
// other side announced, or 0 when it announced none. The walk is written
// so that a malformed option list ends it instead of running off: a
// length octet of 0 or 1 in a multi-octet option is the classic way into
// an endless loop, and it is caught here explicitly.
fn tcp_mss_option(p: *mut u8, seglen: usize) -> u16 {
    let off: usize = tcp_off(p)
    if off <= TCP_HDR { return 0 as u16 }
    if off > seglen { return 0 as u16 }
    var i: usize = TCP_HDR
    while i < off {
        let kind: u8 = ld8(p, i)
        if kind == 0 as u8 { return 0 as u16 } // end of list
        if kind == 1 as u8 { i = i + 1 } // one octet of padding
        else {
            if i + 1 >= off { return 0 as u16 }
            let len: usize = ld8(p, i + 1) as usize
            if len < 2 { return 0 as u16 }
            if i + len > off { return 0 as u16 }
            if kind == 2 as u8 && len == 4 {
                return be16(p, i + 2)
            }
            i = i + len
        }
    }
    return 0 as u16
}

// ===================================================================
// 9. sequence arithmetic modulo 2^32
// ===================================================================

fn seq_lt(a: u32, b: u32) -> bool {
    return ((a -% b) & 0x80000000) != 0
}

fn seq_gt(a: u32, b: u32) -> bool {
    return ((b -% a) & 0x80000000) != 0
}

fn seq_le(a: u32, b: u32) -> bool {
    if a == b { return true }
    return seq_lt(a, b)
}

fn seq_ge(a: u32, b: u32) -> bool {
    if a == b { return true }
    return seq_gt(a, b)
}

// How far `b` lies AHEAD of `a`. The caller has to know that it does --
// this is the wrapping difference and nothing else.
fn seq_diff(b: u32, a: u32) -> u32 {
    return b -% a
}

// `lo <= x < hi` in the wrapping order.
fn seq_in(x: u32, lo: u32, hi: u32) -> bool {
    return seq_ge(x, lo) && seq_lt(x, hi)
}

// ===================================================================
// 10. a generator for the initial sequence number
// ===================================================================
//
// RFC 793 wants an initial sequence number that an outsider cannot
// guess; this one is a 64 bit linear congruential generator (Knuth's
// MMIX constants, the same ones `tools/net/load.py` uses) whose state
// the caller keeps. It is not a cryptographic generator and this
// sentence stands here so that nobody takes it for one.

fn next_random(state: u64) -> u64 {
    return state *% 6364136223846793005 +% 1442695040888963407
}
