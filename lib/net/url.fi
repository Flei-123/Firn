// SPDX-License-Identifier: GPL-2.0-only
// lib/net/url.fi -- URLs, round B4.
//
// A browser needs three things from a URL and nothing else at this layer:
// which protocol, which machine and which port, and what to ask for. The
// fourth thing -- how a RELATIVE reference is read against the address a
// document came from -- is what makes a redirect and a `<link href="a.css">`
// work at all, and it is the only part of this file that is not obvious.
//
// The rules are those of the WHATWG URL standard, section 4.4 ("URL parsing"),
// in the reduced shape that a fetch needs:
//
//     "http://h/a/b" + "c"        -> http://h/a/c
//     "http://h/a/b" + "/c"       -> http://h/c
//     "http://h/a/b" + "//o/c"    -> http://o/c        (protocol relative)
//     "http://h/a/b" + "?q"       -> http://h/a/b?q
//     "http://h/a/b" + "#f"       -> http://h/a/b       (the fragment is
//                                                        never sent)
//     "http://h/a/../b/./c"       -> http://h/b/c       (dot segments)
//
// NO GC AND NO ALLOCATION. Everything lies in fixed fields of `Url`, so a
// URL can be a local variable in a function that must not allocate -- and
// so that this file can be compiled for a system that has no heap yet.
// The price is named: a path longer than PATH_MAX or a host longer than
// HOST_MAX is REFUSED, not truncated. Silently cutting a URL short is how
// a fetch ends up at the wrong document.
import std.rt

export {
    Url, PATH_MAX, HOST_MAX,
    url_new, url_clear, url_parse, url_parse_rel, url_write, url_origin_same,
    url_is_http, url_is_https, url_default_port,
    url_host_ptr, url_host_len, url_port, url_path_ptr, url_path_len,
    url_scheme_ptr, url_scheme_len,
    url_set_path,
    ascii_lower, ci_equal, host_is_ip4,
}

const HOST_MAX: usize = 256
const PATH_MAX: usize = 2048
const SCHEME_MAX: usize = 16

struct Url {
    scheme: [u8; 16],
    host: [u8; 256],
    path: [u8; 2048],
    ns: usize,
    nh: usize,
    np: usize,
    port: u16,
    ok: bool,
}

fn url_new() -> Url {
    return Url {
        scheme: [0; 16], host: [0; 256], path: [0; 2048],
        ns: 0, nh: 0, np: 0, port: 0 as u16, ok: false,
    }
}

fn url_clear(u: *mut Url) {
    (*u).ns = 0
    (*u).nh = 0
    (*u).np = 0
    (*u).port = 0 as u16
    (*u).ok = false
}

// --------------------------------------------------------------- Octets

fn ascii_lower(c: u8) -> u8 {
    if c >= 65 as u8 && c <= 90 as u8 {
        return c + 32 as u8
    }
    return c
}

fn ci_equal(a: u64, na: usize, b: u64, nb: usize) -> bool {
    if na != nb {
        return false
    }
    var i: usize = 0
    while i < na {
        if ascii_lower(rt.ld8(a, i)) != ascii_lower(rt.ld8(b, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

fn at(p: u64, n: usize, i: usize) -> u8 {
    if i >= n {
        return 0 as u8
    }
    return rt.ld8(p, i)
}

// ------------------------------------------------------------- Accessors

fn url_scheme_ptr(u: *mut Url) -> u64 { return (&(*u).scheme[0]) as u64 }
fn url_scheme_len(u: *mut Url) -> usize { return (*u).ns }
fn url_host_ptr(u: *mut Url) -> u64 { return (&(*u).host[0]) as u64 }
fn url_host_len(u: *mut Url) -> usize { return (*u).nh }
fn url_path_ptr(u: *mut Url) -> u64 { return (&(*u).path[0]) as u64 }
fn url_path_len(u: *mut Url) -> usize { return (*u).np }
fn url_port(u: *mut Url) -> u16 { return (*u).port }

fn url_is_http(u: *mut Url) -> bool {
    var lit: [u8; 4] = "http"
    return ci_equal((&(*u).scheme[0]) as u64, (*u).ns, (&lit[0]) as u64, 4)
}

fn url_is_https(u: *mut Url) -> bool {
    var lit: [u8; 5] = "https"
    return ci_equal((&(*u).scheme[0]) as u64, (*u).ns, (&lit[0]) as u64, 5)
}

fn url_default_port(u: *mut Url) -> u16 {
    if url_is_https(u) {
        return 443 as u16
    }
    return 80 as u16
}

fn url_origin_same(a: *mut Url, b: *mut Url) -> bool {
    if !ci_equal((&(*a).scheme[0]) as u64, (*a).ns,
        (&(*b).scheme[0]) as u64, (*b).ns) {
        return false
    }
    if !ci_equal((&(*a).host[0]) as u64, (*a).nh,
        (&(*b).host[0]) as u64, (*b).nh) {
        return false
    }
    return (*a).port == (*b).port
}

// Is the host a dotted quad? Then it needs no resolver.
fn host_is_ip4(p: u64, n: usize) -> bool {
    if n == 0 || n > 15 {
        return false
    }
    var parts: usize = 0
    var digits: usize = 0
    var v: u32 = 0
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c == 46 as u8 {
            if digits == 0 || v > 255 as u32 {
                return false
            }
            parts = parts + 1
            digits = 0
            v = 0
        } else if c >= 48 as u8 && c <= 57 as u8 {
            digits = digits + 1
            if digits > 3 {
                return false
            }
            v = v * 10 as u32 + (c - 48 as u8) as u32
        } else {
            return false
        }
        i = i + 1
    }
    if digits == 0 || v > 255 as u32 {
        return false
    }
    return parts == 3
}

// ------------------------------------------------------------- The writer

fn push(dst: u64, cap: usize, len: *mut usize, c: u8) -> bool {
    if *len >= cap {
        return false
    }
    rt.st8(dst, *len, c)
    *len = *len + 1
    return true
}

fn push_span(dst: u64, cap: usize, len: *mut usize, p: u64,
    from: usize, to: usize) -> bool {
    var i: usize = from
    while i < to {
        if !push(dst, cap, len, rt.ld8(p, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

// The URL back as text, WITHOUT the fragment -- that is what goes into a
// cache key, a `Referer` and the log line, and it is what a redirect chain
// is compared against.
fn url_write(u: *mut Url, out: *mut rt.Buf) {
    rt.buf_push_bytes(out, (&(*u).scheme[0]) as u64, (*u).ns)
    var sep: [u8; 3] = "://"
    rt.buf_push_bytes(out, (&sep[0]) as u64, 3)
    rt.buf_push_bytes(out, (&(*u).host[0]) as u64, (*u).nh)
    if (*u).port != url_default_port(u) {
        rt.buf_push(out, 58 as u8)
        rt.buf_push_dec_u64(out, (*u).port as u64)
    }
    rt.buf_push_bytes(out, (&(*u).path[0]) as u64, (*u).np)
}

fn url_set_path(u: *mut Url, p: u64, n: usize) -> bool {
    if n > PATH_MAX {
        return false
    }
    (*u).np = 0
    return push_span((&(*u).path[0]) as u64, PATH_MAX, &(*u).np, p, 0, n)
}

// --------------------------------------------------------- Dot segments

// WHATWG URL 4.4, "path state": `.` disappears, `..` eats the segment in
// front of it, and neither may climb above the root. Done in place on the
// path already written.
fn remove_dot_segments(u: *mut Url) {
    let base: u64 = (&(*u).path[0]) as u64
    var n: usize = (*u).np
    // THE QUERY IS NOT A PATH. `g?y/../x` keeps its `/../` -- it is part
    // of the query string, not a segment, and a resolver that walks past
    // the '?' turns it into `x` and asks the server for the wrong thing.
    var tail: usize = 0
    var q: usize = 0
    while q < n {
        let c: u8 = rt.ld8(base, q)
        if c == 63 as u8 || c == 35 as u8 {
            tail = n - q
            n = q
            break
        }
        q = q + 1
    }
    var out: usize = 0
    var i: usize = 0
    // Every segment starts at a '/'. `starts` holds the write position of
    // the last 32 of them -- deeper nesting than that keeps the segment
    // instead of climbing, which is wrong in a way that cannot lose data.
    var starts: [usize; 64] = [0; 64]
    var depth: usize = 0
    while i < n {
        // one segment: from the '/' to the next '/' or the end
        if rt.ld8(base, i) != 47 as u8 {
            // A path that does not start with '/' -- copy as is.
            rt.st8(base, out, rt.ld8(base, i))
            out = out + 1
            i = i + 1
            continue
        }
        var j: usize = i + 1
        while j < n && rt.ld8(base, j) != 47 as u8 {
            j = j + 1
        }
        let seg: usize = j - i - 1
        var is_dot: bool = seg == 1 && rt.ld8(base, i + 1) == 46 as u8
        var is_dd: bool = seg == 2 && rt.ld8(base, i + 1) == 46 as u8 &&
        rt.ld8(base, i + 2) == 46 as u8
        if is_dot {
            i = j
            if j >= n {
                rt.st8(base, out, 47 as u8)
                out = out + 1
            }
            continue
        }
        if is_dd {
            if depth > 0 {
                depth = depth - 1
                out = starts[depth]
            }
            i = j
            if j >= n {
                rt.st8(base, out, 47 as u8)
                out = out + 1
            }
            continue
        }
        if depth < 64 {
            starts[depth] = out
            depth = depth + 1
        }
        var k2: usize = i
        while k2 < j {
            rt.st8(base, out, rt.ld8(base, k2))
            out = out + 1
            k2 = k2 + 1
        }
        i = j
    }
    // the query back on, unchanged
    if tail > 0 {
        var z: usize = 0
        while z < tail {
            rt.st8(base, out + z, rt.ld8(base, n + z))
            z = z + 1
        }
        out = out + tail
    }
    (*u).np = out
}

// ------------------------------------------------------------ The parser

// An absolute URL. `false` when it is not one or does not fit.
fn url_parse(s: u64, n: usize, out: *mut Url) -> bool {
    return url_parse_rel(0 as *mut Url, s, n, out)
}

// `base` may be null; then only an absolute reference is accepted.
fn url_parse_rel(base: *mut Url, s: u64, n: usize, out: *mut Url) -> bool {
    url_clear(out)
    // Leading and trailing C0 controls and spaces are stripped
    // (WHATWG URL 4.4, step 1).
    var from: usize = 0
    var to: usize = n
    while from < to && at(s, n, from) <= 32 as u8 {
        from = from + 1
    }
    while to > from && at(s, n, to - 1) <= 32 as u8 {
        to = to - 1
    }
    // Tab and newline are removed everywhere (step 2). They occur in real
    // markup, inside an href, and a browser has to survive them.
    var buf: [u8; 2048] = [0; 2048]
    var m: usize = 0
    var i: usize = from
    while i < to {
        let c: u8 = at(s, n, i)
        if c != 9 as u8 && c != 10 as u8 && c != 13 as u8 {
            if m >= 2048 {
                return false
            }
            buf[m] = c
            m = m + 1
        }
        i = i + 1
    }
    let p: u64 = (&buf[0]) as u64

    // --- the scheme: letters, digits, +-. up to a ':'
    var sc: usize = 0
    var have_scheme: bool = false
    if m > 0 {
        let c0: u8 = rt.ld8(p, 0)
        if (c0 >= 65 as u8 && c0 <= 90 as u8) ||
        (c0 >= 97 as u8 && c0 <= 122 as u8) {
            var k: usize = 1
            while k < m {
                let c: u8 = rt.ld8(p, k)
                if c == 58 as u8 {
                    sc = k
                    have_scheme = true
                    break
                }
                let okc: bool = (c >= 65 as u8 && c <= 90 as u8) ||
                (c >= 97 as u8 && c <= 122 as u8) ||
                (c >= 48 as u8 && c <= 57 as u8) ||
                c == 43 as u8 || c == 45 as u8 || c == 46 as u8
                if !okc {
                    break
                }
                k = k + 1
            }
        }
    }

    var at_auth: usize = 0
    if have_scheme {
        if sc > SCHEME_MAX {
            return false
        }
        var q: usize = 0
        while q < sc {
            (*out).scheme[q] = ascii_lower(rt.ld8(p, q))
            q = q + 1
        }
        (*out).ns = sc
        at_auth = sc + 1
        if at_auth + 2 <= m && rt.ld8(p, at_auth) == 47 as u8 &&
        rt.ld8(p, at_auth + 1) == 47 as u8 {
            at_auth = at_auth + 2
        } else {
            // `mailto:`, `data:` and friends: no authority, and nothing
            // this round fetches. Refused by name rather than guessed at.
            return false
        }
    } else {
        if base as u64 == 0 {
            return false
        }
        (*out).ns = (*base).ns
        var q: usize = 0
        while q < (*base).ns {
            (*out).scheme[q] = (*base).scheme[q]
            q = q + 1
        }
        if m >= 2 && rt.ld8(p, 0) == 47 as u8 && rt.ld8(p, 1) == 47 as u8 {
            // protocol relative: the scheme of the base, a new authority
            at_auth = 2
        } else {
            // a relative reference: take host and port from the base
            (*out).nh = (*base).nh
            var h: usize = 0
            while h < (*base).nh {
                (*out).host[h] = (*base).host[h]
                h = h + 1
            }
            (*out).port = (*base).port
            return merge_path(base, p, m, 0, out)
        }
    }

    // --- the authority: userinfo@host:port
    var e: usize = at_auth
    while e < m {
        let c: u8 = rt.ld8(p, e)
        if c == 47 as u8 || c == 63 as u8 || c == 35 as u8 {
            break
        }
        e = e + 1
    }
    var hstart: usize = at_auth
    var k2: usize = at_auth
    while k2 < e {
        if rt.ld8(p, k2) == 64 as u8 {
            hstart = k2 + 1
        }
        k2 = k2 + 1
    }
    var hend: usize = e
    var port: u16 = 0
    var have_port: bool = false
    var k3: usize = hstart
    while k3 < e {
        if rt.ld8(p, k3) == 58 as u8 {
            hend = k3
            var v: u32 = 0
            var q: usize = k3 + 1
            if q >= e {
                have_port = false
            } else {
                have_port = true
                while q < e {
                    let c: u8 = rt.ld8(p, q)
                    if c < 48 as u8 || c > 57 as u8 {
                        return false
                    }
                    v = v * 10 as u32 + (c - 48 as u8) as u32
                    if v > 65535 as u32 {
                        return false
                    }
                    q = q + 1
                }
            }
            port = v as u16
            break
        }
        k3 = k3 + 1
    }
    if hend - hstart == 0 || hend - hstart > HOST_MAX {
        return false
    }
    var h2: usize = hstart
    (*out).nh = 0
    while h2 < hend {
        (*out).host[(*out).nh] = ascii_lower(rt.ld8(p, h2))
        (*out).nh = (*out).nh + 1
        h2 = h2 + 1
    }
    if have_port {
        (*out).port = port
    } else {
        (*out).port = url_default_port(out)
    }

    // --- what is left is the path (plus query, minus fragment)
    return merge_path(0 as *mut Url, p, m, e, out)
}

// The path of `out` out of the reference `p[from..m]`, against `base`
// (null = the reference already carries an authority, so it is absolute).
fn merge_path(base: *mut Url, p: u64, m: usize, from: usize,
    out: *mut Url) -> bool {
    // The fragment never goes on the wire (RFC 7230, 5.3.1).
    var end: usize = from
    while end < m && rt.ld8(p, end) != 35 as u8 {
        end = end + 1
    }
    let dst: u64 = (&(*out).path[0]) as u64
    (*out).np = 0
    if base as u64 == 0 {
        if end == from {
            if !push(dst, PATH_MAX, &(*out).np, 47 as u8) {
                return false
            }
        } else {
            if rt.ld8(p, from) != 47 as u8 && rt.ld8(p, from) != 63 as u8 {
                if !push(dst, PATH_MAX, &(*out).np, 47 as u8) {
                    return false
                }
            }
            if !push_span(dst, PATH_MAX, &(*out).np, p, from, end) {
                return false
            }
        }
        (*out).ok = true
        remove_dot_segments(out)
        return true
    }
    // A relative reference against a base.
    if end == from {
        // the empty reference: the base without its fragment
        if !push_span(dst, PATH_MAX, &(*out).np,
            (&(*base).path[0]) as u64, 0, (*base).np) {
            return false
        }
        (*out).ok = true
        return true
    }
    let c0: u8 = rt.ld8(p, from)
    if c0 == 63 as u8 {
        // only a query: the path of the base up to its own query
        var q: usize = 0
        while q < (*base).np && (*base).path[q] != 63 as u8 {
            q = q + 1
        }
        if !push_span(dst, PATH_MAX, &(*out).np,
            (&(*base).path[0]) as u64, 0, q) {
            return false
        }
        if !push_span(dst, PATH_MAX, &(*out).np, p, from, end) {
            return false
        }
        (*out).ok = true
        return true
    }
    if c0 == 47 as u8 {
        if !push_span(dst, PATH_MAX, &(*out).np, p, from, end) {
            return false
        }
        (*out).ok = true
        remove_dot_segments(out)
        return true
    }
    // a plain relative path: everything of the base up to and including
    // the last '/', and the query of the base thrown away
    var cut: usize = 0
    var q2: usize = 0
    while q2 < (*base).np {
        let c: u8 = (*base).path[q2]
        if c == 63 as u8 {
            break
        }
        if c == 47 as u8 {
            cut = q2 + 1
        }
        q2 = q2 + 1
    }
    if !push_span(dst, PATH_MAX, &(*out).np,
        (&(*base).path[0]) as u64, 0, cut) {
        return false
    }
    if !push_span(dst, PATH_MAX, &(*out).np, p, from, end) {
        return false
    }
    (*out).ok = true
    remove_dot_segments(out)
    return true
}
