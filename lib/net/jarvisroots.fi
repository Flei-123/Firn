// SPDX-License-Identifier: MPL-2.0
// lib/net/jarvisroots.fi -- the roots a JARVIS client always trusts IN ADDITION
// to the system's: ISRG Root X1 + X2 (Let's Encrypt), embedded from
// lib/appkit/roots.pem. The JARVIS server's certificate comes from Let's
// Encrypt (leaf ECDSA P-384, chain YE1 -> Root YE -> ISRG Root X2).
//
// WHY: a device without a usable system store (net.http refuses https with
// 0 roots: tls error 100) would otherwise never reach the server -- the app
// said "no connection". Android keeps its roots as one file per root in a
// directory (tls.trust reads it) and not every image has it; with these two
// roots the Let's Encrypt chain verifies anyway. Only PUBLIC roots, nothing
// private; a server with another CA still needs the system store or
// `jc_add_trust_pem` / `ja_add_trust_pem`.
//
//     jarvisroots.add_to_http(ahttp.aclient_http(&ah))
//     jarvisroots.add_to_ws(wsc_client)
import std.rt
import net.http
import async.wsc

export { add_to_http, add_to_ws, roots_pem_len }

const ROOTS: str = __include_str("../appkit/roots.pem")

fn roots_pem_len() -> usize { return ROOTS.n }

fn add_to_http(c: *mut http.Client) -> usize {
    return http.client_add_trust_pem(c, ROOTS.p as u64, ROOTS.n)
}

fn add_to_ws(w: *mut wsc.WsClient) -> usize {
    return wsc.wsc_add_trust_pem(w, ROOTS.p as u64, ROOTS.n)
}
