// SPDX-License-Identifier: GPL-2.0-only
// lib/net/url_main.fi -- the URL resolver as a program, so that it can be
// measured against somebody else's (root file, round B4).
//
// One line per job on standard input:  <base> TAB <reference>
// One line per job on standard output: the resolved absolute URL, or
// "ERR" when the reference cannot be resolved.
//
// The other side is `urllib.parse.urljoin` in tools/liveb4/url_check.py --
// a parser nobody here wrote.
import std.rt
import net.url

fn main() -> i32 {
    var inb: rt.Buf = rt.buf_new()
    rt.read_stdin(&inb)
    var out: rt.Buf = rt.buf_new()
    let p: u64 = inb.ptr
    let n: usize = inb.len
    var i: usize = 0
    var base: url.Url = url.url_new()
    var got: url.Url = url.url_new()
    while i < n {
        var e: usize = i
        while e < n && rt.ld8(p, e) != 10 as u8 {
            e = e + 1
        }
        var tab: usize = e
        var k: usize = i
        while k < e {
            if rt.ld8(p, k) == 9 as u8 {
                tab = k
                break
            }
            k = k + 1
        }
        var ok: bool = url.url_parse(p + i as u64, tab - i, &base)
        if ok {
            if tab < e {
                ok = url.url_parse_rel(&base, p + (tab + 1) as u64,
                    e - tab - 1, &got)
            } else {
                ok = url.url_parse(p + i as u64, tab - i, &got)
            }
        }
        if ok {
            url.url_write(&got, &out)
        } else {
            var bad: [u8; 3] = "ERR"
            rt.buf_push_bytes(&out, (&bad[0]) as u64, 3)
        }
        rt.buf_push(&out, 10 as u8)
        i = e + 1
    }
    rt.write_everything(1, out.ptr, out.len)
    rt.buf_free(&out)
    rt.buf_free(&inb)
    return 0
}
