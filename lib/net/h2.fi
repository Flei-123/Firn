import std.rt
import tls.tls
import net.transport as tr
import net.hpack
import net.h2frame as fr
import net.h2conn as hc

export {
    H2, H2Stream, h2_new, h2_free, h2_connect_plain, h2_connect_tls, h2_is_open,
    h2_request, h2_wait, h2_status, h2_headers, h2_body, h2_release, h2_error_code,
    h2_goaway_code, h2_ping, h2_close,
    MAX_STREAMS,
}

type H2 = hc.H2
type H2Stream = hc.H2Stream

const MAX_STREAMS: usize = hc.MAX_STREAMS

fn h2_new() -> H2 { return hc.h2_new() }
fn h2_free(c: *mut H2) { hc.h2_free(c) }
fn h2_is_open(c: *mut H2) -> bool { return hc.h2_is_open(c) }
fn h2_goaway_code(c: *mut H2) -> u32 { return hc.h2_goaway_code(c) }

fn free_slot(c: *mut H2) -> *mut H2Stream {
    var i: usize = 0
    while i < hc.MAX_STREAMS {
        if !(*c).streams[i].live { return &(*c).streams[i] }
        i = i + 1
    }
    return 0 as *mut H2Stream
}

fn push_header(c: *mut H2, blk: *mut rt.Buf, name: str, value: str) {
    var secret: bool = false
    if name.n == 13 && rt.mem_eq(name.p as u64, "authorization".p as u64, 13) { secret = true }
    if name.n == 6 && rt.mem_eq(name.p as u64, "cookie".p as u64, 6) { secret = true }
    hpack.hp_encode(&(*c).enc, blk, name.p as u64, name.n, value.p as u64, value.n, secret)
}

fn lower(b: u8) -> u8 {
    if b >= 65 as u8 && b <= 90 as u8 { return b + 32 as u8 }
    return b
}

fn push_extra(c: *mut H2, blk: *mut rt.Buf, extra: str) {
    var pos: usize = 0
    let base: u64 = extra.p as u64
    var name: rt.Buf = rt.buf_new()
    while pos < extra.n {
        var e: usize = pos
        while e < extra.n && rt.ld8(base, e) != 10 as u8 { e = e + 1 }
        var colon: usize = pos
        while colon < e && rt.ld8(base, colon) != 58 as u8 { colon = colon + 1 }
        if colon < e && colon > pos {
            rt.buf_clear(&name)
            var i: usize = pos
            while i < colon {
                rt.buf_push(&name, lower(rt.ld8(base, i)))
                i = i + 1
            }
            var v: usize = colon + 1
            while v < e && rt.ld8(base, v) == 32 as u8 { v = v + 1 }
            var ve: usize = e
            if ve > v && rt.ld8(base, ve - 1) == 13 as u8 { ve = ve - 1 }
            hpack.hp_encode(&(*c).enc, blk, name.ptr, name.len, base + v as u64, ve - v, false)
        }
        pos = e + 1
    }
    rt.buf_free(&name)
}

fn send_header_block(c: *mut H2, id: u32, blk: *mut rt.Buf, end_stream: bool) -> bool {
    var pos: usize = 0
    var first: bool = true
    while pos < (*blk).len || first {
        var n: usize = (*blk).len - pos
        if n > (*c).peer_frame { n = (*c).peer_frame }
        var flags: u8 = 0
        if pos + n >= (*blk).len { flags = fr.F_END_HEADERS }
        var ftype: u8 = fr.T_CONTINUATION
        if first {
            ftype = fr.T_HEADERS
            if end_stream { flags = flags | fr.F_END_STREAM }
        }
        fr.put_frame(&(*c).out, ftype, flags, id, (*blk).ptr + pos as u64, n)
        pos = pos + n
        first = false
    }
    return hc.flush_out(c)
}

fn send_body(c: *mut H2, s: *mut H2Stream, p: u64, n: usize) -> bool {
    var pos: usize = 0
    while pos < n {
        var room: i64 = (*c).send_win
        if (*s).send_win < room { room = (*s).send_win }
        if room <= 0 {
            if !hc.pump(c) || (*s).done { return false }
        } else {
            var k: usize = n - pos
            if k > (*c).peer_frame { k = (*c).peer_frame }
            if k as i64 > room { k = room as usize }
            var flags: u8 = 0
            if pos + k == n { flags = fr.F_END_STREAM }
            fr.put_frame(&(*c).out, fr.T_DATA, flags, (*s).id, p + pos as u64, k)
            (*c).send_win = (*c).send_win - k as i64
            (*s).send_win = (*s).send_win - k as i64
            pos = pos + k
            if !hc.flush_out(c) { return false }
        }
    }
    return true
}

fn h2_request(c: *mut H2, method: str, scheme: str, authority: str, path: str, extra: str,
    body: u64, body_n: usize) -> i32 {
    if !(*c).open { return 0 - 1 }
    var s: *mut H2Stream = free_slot(c)
    while s as u64 == 0 {
        if !hc.pump(c) { return 0 - 1 }
        s = free_slot(c)
    }
    (*s).id = (*c).next_id
    (*c).next_id = (*c).next_id + 2
    (*s).live = true
    (*s).done = false
    (*s).got_headers = false
    (*s).status = 0
    (*s).err = 0
    (*s).send_win = (*c).peer_init_win
    (*s).recv_win = hc.RECV_WINDOW
    rt.buf_clear(&(*s).hdrs)
    rt.buf_clear(&(*s).body)
    var blk: rt.Buf = rt.buf_new()
    hpack.hp_encode_begin(&(*c).enc, &blk)
    push_header(c, &blk, ":method", method)
    push_header(c, &blk, ":scheme", scheme)
    push_header(c, &blk, ":authority", authority)
    push_header(c, &blk, ":path", path)
    push_extra(c, &blk, extra)
    if body_n > 0 {
        var len: rt.Buf = rt.buf_new()
        rt.buf_push_dec_u64(&len, body_n as u64)
        hpack.hp_encode(&(*c).enc, &blk, "content-length".p as u64, 14, len.ptr, len.len, false)
        rt.buf_free(&len)
    }
    let id: u32 = (*s).id
    let ok: bool = send_header_block(c, id, &blk, body_n == 0)
    rt.buf_free(&blk)
    if !ok { return 0 - 1 }
    if body_n > 0 && !send_body(c, s, body, body_n) { return 0 - 1 }
    return id as i32
}

fn h2_wait(c: *mut H2, id: u32) -> bool {
    let s: *mut H2Stream = hc.find_stream(c, id)
    if s as u64 == 0 { return false }
    while !(*s).done {
        if !hc.pump(c) && !(*s).done { return false }
    }
    return (*s).err == 0
}

fn h2_status(c: *mut H2, id: u32) -> i32 {
    let s: *mut H2Stream = hc.find_stream(c, id)
    if s as u64 == 0 { return 0 }
    return (*s).status
}

fn h2_error_code(c: *mut H2, id: u32) -> u32 {
    let s: *mut H2Stream = hc.find_stream(c, id)
    if s as u64 == 0 { return 0 }
    return (*s).err
}

fn h2_headers(c: *mut H2, id: u32) -> *mut rt.Buf {
    let s: *mut H2Stream = hc.find_stream(c, id)
    if s as u64 == 0 { return 0 as *mut rt.Buf }
    return &(*s).hdrs
}

fn h2_body(c: *mut H2, id: u32) -> *mut rt.Buf {
    let s: *mut H2Stream = hc.find_stream(c, id)
    if s as u64 == 0 { return 0 as *mut rt.Buf }
    return &(*s).body
}

fn h2_release(c: *mut H2, id: u32) {
    let s: *mut H2Stream = hc.find_stream(c, id)
    if s as u64 == 0 { return }
    if !(*s).done {
        fr.put_frame_header(&(*c).out, 4, fr.T_RST_STREAM, 0, id)
        fr.put_u32(&(*c).out, fr.E_CANCEL)
        hc.flush_out(c)
    }
    (*s).live = false
}

fn start(c: *mut H2) -> bool {
    fr.put_preface(&(*c).out)
    fr.put_frame_header(&(*c).out, 18, fr.T_SETTINGS, 0, 0)
    fr.put_setting(&(*c).out, fr.S_ENABLE_PUSH, 0)
    fr.put_setting(&(*c).out, fr.S_INITIAL_WINDOW_SIZE, hc.RECV_WINDOW as u32)
    fr.put_setting(&(*c).out, fr.S_MAX_CONCURRENT_STREAMS, 100)
    hc.send_window_update(c, 0, hc.RECV_WINDOW - fr.DEFAULT_WINDOW)
    (*c).open = true
    return hc.flush_out(c)
}

fn h2_connect_plain(c: *mut H2, addr: u32, port: u16) -> bool {
    if !tr.tp_connect(&(*c).tp, addr, port) { return false }
    return start(c)
}

fn h2_connect_tls(c: *mut H2, addr: u32, port: u16, host: str, roots: u64, rn: usize, now: u64) -> bool {
    if !tr.tp_connect(&(*c).tp, addr, port) { return false }
    if tr.tp_start_tls(&(*c).tp, host, roots, rn, now, true) != tr.TP_TLS_OK { return false }
    if !tls.tls_alpn_is_h2(&(*c).tp.t) { return false }
    return start(c)
}

fn h2_ping(c: *mut H2) -> bool {
    var data: [u8; 8] = [1, 2, 3, 4, 5, 6, 7, 8]
    (*c).ping_acked = false
    fr.put_frame(&(*c).out, fr.T_PING, 0, 0, (&data[0]) as u64, 8)
    if !hc.flush_out(c) { return false }
    while !(*c).ping_acked {
        if !hc.pump(c) { return false }
    }
    return true
}

fn h2_close(c: *mut H2) {
    if (*c).open { hc.fail_conn(c, fr.E_NO_ERROR) }
}
