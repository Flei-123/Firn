// SPDX-License-Identifier: MPL-2.0
// lib/net/dnsmini.fi -- ONE A / AAAA LOOKUP IN #[no_gc] CODE (roadmap r74).
//
// WHY IT EXISTS. lib/net/dns.fi is the resolver; it is not #[no_gc]. The
// push connection of lib/plat/android/push.fi lives on a bionic pthread
// where the collector must never run (and the compiler checks that
// transitively), and it must find its relay by NAME again on every
// reconnect -- the service may run for days in a process without a
// program. So this file is the smallest thing that resolves a name there:
// raw system calls and stack arrays, nothing else.
//
//   mini_lookup(name, nlen, servers, nservers, port, timeout_ms) -> u32
//   mini_lookup6(name, nlen, servers, nservers, port, timeout_ms, out) -> bool
//
// `servers` points at `nservers` u32, each an IPv4 address in HOST order
// (1.1.1.1 = 0x01010101). Every server is asked twice, in order.
// mini_lookup: the first A record in the address representation of
// sockaddr_in / lib/plat/android/push.fi (the first octet in the LOWEST
// byte); 0 = no answer (timeout, NXDOMAIN, SERVFAIL, garbage, a name that is
// not a name). mini_lookup6: the first AAAA record as 16 octets in network
// order at `out`; false = none.
//
// HONEST
//   M1 UDP first. A reply with TC set and no usable record is asked again
//      over TCP (2 octet length prefix, RFC 7766) from the same server --
//      once, with the same timeout. A TCP reply is read up to 2048 octets;
//      the record is taken from what fits.
//   M2 The first A (AAAA) record of the answer is taken. dns.fi checks that
//      the records belong to the CNAME chain of the question; this does not
//      -- it relies on: right server address and port, right transaction ID,
//      QR set, RCODE 0, the question echoed back.
//   M3 No cache, no hosts table, no search list. The caller resolves
//      numeric addresses itself and decides how often to ask.
//   M4 The transaction ID comes from getrandom(2) (clock when that fails).
//      The source port is the kernel's choice.
//   M5 The NAME SERVERS are IPv4 only (the list is u32); the answers can be
//      IPv6 (mini_lookup6). No EDNS0, so a UDP answer is at most 512 octets.
// Test: tools/dns/mini_check.py against tools/dns/fake_dns.py.

export { mini_lookup, mini_lookup_one, mini_lookup6, mini_query, mini_name_ok }

const SYS_CLOSE: i64 = 3
const SYS_CONNECT: i64 = 42
const SYS_SOCKET: i64 = 41
const SYS_SENDTO: i64 = 44
const SYS_RECVFROM: i64 = 45
const QT_A: u32 = 1
const QT_AAAA: u32 = 28
const TCP_MAX: usize = 2048
const SYS_SETSOCKOPT: i64 = 54
const SYS_CLOCK_GETTIME: i64 = 228
const SYS_GETRANDOM: i64 = 318
const SOL_SOCKET: i64 = 1
const SO_RCVTIMEO: i64 = 20
const SO_SNDTIMEO: i64 = 21
const MSG_NOSIGNAL: i64 = 16384
const EINTR_NEG: i64 = -4

// A host name as the resolver wants it: 1-253 octets, labels of 1-63 octets
// of letters, digits, '-' and '_', one trailing dot allowed.
#[no_gc]
fn mini_name_ok(name: u64, nlen: usize) -> bool {
    var n: usize = nlen
    if n > 0 && *((name + (n - 1) as u64) as *mut u8) == 46 as u8 {
        n = n - 1
    }
    if n == 0 || n > 253 {
        return false
    }
    var label: usize = 0
    var i: usize = 0
    while i < n {
        let c: u8 = *((name + i as u64) as *mut u8)
        if c == 46 as u8 {
            if label == 0 {
                return false
            }
            label = 0
        } else {
            let ok: bool = (c >= 97 as u8 && c <= 122 as u8)
            || (c >= 65 as u8 && c <= 90 as u8)
            || (c >= 48 as u8 && c <= 57 as u8)
            || c == 45 as u8 || c == 95 as u8
            if !ok {
                return false
            }
            label = label + 1
            if label > 63 {
                return false
            }
        }
        i = i + 1
    }
    return label > 0
}

#[no_gc]
fn rnd_id() -> u32 {
    var r: [u8; 8] = [0 as u8; 8]
    let g: i64 = syscall(SYS_GETRANDOM, (&r[0]) as i64, 2, 0, 0, 0, 0)
    if g == 2 {
        return (r[0] as u32) << 8 | (r[1] as u32)
    }
    var ts: [i64; 2] = [0; 2]
    syscall(SYS_CLOCK_GETTIME, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return ((ts[1] ^ (ts[1] >> 16)) & 65535) as u32
}

// Question for `name` (class IN) of type `qtype` into q; the length, 0 = failed.
#[no_gc]
fn build_query(q: *mut [u8; 300], name: u64, nlen: usize, id: u32,
    qtype: u32) -> usize {
    var n: usize = nlen
    if n > 0 && *((name + (n - 1) as u64) as *mut u8) == 46 as u8 {
        n = n - 1
    }
    (*q)[0] = (id >> 8) as u8
    (*q)[1] = (id & 255 as u32) as u8
    (*q)[2] = 1 as u8 // RD
    (*q)[3] = 0 as u8
    (*q)[4] = 0 as u8
    (*q)[5] = 1 as u8 // QDCOUNT = 1
    var k: usize = 6
    while k < 12 {
        (*q)[k] = 0 as u8
        k = k + 1
    }
    var at: usize = 12
    var start: usize = 0
    var i: usize = 0
    while i <= n {
        if i == n || *((name + i as u64) as *mut u8) == 46 as u8 {
            let len: usize = i - start
            (*q)[at] = len as u8
            at = at + 1
            var j: usize = 0
            while j < len {
                (*q)[at + j] = *((name + (start + j) as u64) as *mut u8)
                j = j + 1
            }
            at = at + len
            start = i + 1
        }
        i = i + 1
    }
    (*q)[at] = 0 as u8
    (*q)[at + 1] = (qtype >> 8) as u8
    (*q)[at + 2] = (qtype & 255 as u32) as u8 // QTYPE
    (*q)[at + 3] = 0 as u8
    (*q)[at + 4] = 1 as u8 // QCLASS IN
    return at + 5
}

#[no_gc]
fn mb(m: u64, i: usize) -> u8 {
    return *((m + i as u64) as *mut u8)
}

// The position after a name at `at` (labels, or a pointer), 0 = malformed.
#[no_gc]
fn skip_name(m: u64, n: usize, at: usize) -> usize {
    var p: usize = at
    var hops: usize = 0
    while p < n && hops < 130 {
        let b: u8 = mb(m, p)
        if b == 0 as u8 {
            return p + 1
        }
        if (b & 192 as u8) == 192 as u8 {
            return p + 2
        }
        if (b & 192 as u8) != 0 as u8 {
            return 0
        }
        p = p + 1 + b as usize
        hops = hops + 1
    }
    return 0
}

const R_NONE: i32 = 0 // bad, or an answer without the record
const R_FOUND: i32 = 1 // the record is at `out`
const R_TRUNC: i32 = 2 // TC set and no record: ask again over TCP

// The first record of type `qtype` in a reply to question `id`/`qlen`
// (4 octets at `out` for A, 16 for AAAA).
#[no_gc]
fn parse_reply(m: u64, n: usize, id: u32, q: *mut [u8; 300], qlen: usize,
    qtype: u32, out: u64) -> i32 {
    if n < 12 + 5 {
        return R_NONE
    }
    if ((mb(m, 0) as u32) << 8 | (mb(m, 1) as u32)) != id {
        return R_NONE
    }
    if (mb(m, 2) & 128 as u8) == 0 as u8 { // QR: an answer
        return R_NONE
    }
    if (mb(m, 3) & 15 as u8) != 0 as u8 { // RCODE
        return R_NONE
    }
    if mb(m, 4) != 0 as u8 || mb(m, 5) != 1 as u8 { // QDCOUNT
        return R_NONE
    }
    // the question must be the one that was asked (case-insensitive name)
    if n < qlen {
        return R_NONE
    }
    var i: usize = 12
    while i < qlen {
        var a: u8 = mb(m, i)
        var b: u8 = (*q)[i]
        if a >= 65 as u8 && a <= 90 as u8 { a = a + 32 as u8 }
        if b >= 65 as u8 && b <= 90 as u8 { b = b + 32 as u8 }
        if a != b {
            return R_NONE
        }
        i = i + 1
    }
    var an: usize = (mb(m, 6) as usize) << 8 | (mb(m, 7) as usize)
    var p: usize = qlen
    let want: usize = if qtype == QT_A { 4 } else { 16 }
    while an > 0 {
        p = skip_name(m, n, p)
        if p == 0 || p + 10 > n {
            break
        }
        let ty: u32 = (mb(m, p) as u32) << 8 | (mb(m, p + 1) as u32)
        let cl: u32 = (mb(m, p + 2) as u32) << 8 | (mb(m, p + 3) as u32)
        let rl: usize = (mb(m, p + 8) as usize) << 8 | (mb(m, p + 9) as usize)
        p = p + 10
        if p + rl > n {
            break
        }
        if ty == qtype && cl == 1 as u32 && rl == want {
            var k: usize = 0
            while k < want {
                *((out + k as u64) as *mut u8) = mb(m, p + k)
                k = k + 1
            }
            return R_FOUND
        }
        p = p + rl
        an = an - 1
    }
    if (mb(m, 2) & 2 as u8) != 0 as u8 { // TC
        return R_TRUNC
    }
    return R_NONE
}

// A socket with both timeouts set; -1 = none.
#[no_gc]
fn open_sock(kind: i64, timeout_ms: u64) -> i64 {
    let fd: i64 = syscall(SYS_SOCKET, 2, kind, 0, 0, 0, 0) // AF_INET
    if fd < 0 {
        return -1
    }
    var tv: [i64; 2] = [0; 2]
    tv[0] = (timeout_ms / 1000 as u64) as i64
    tv[1] = (timeout_ms % 1000 as u64) as i64 * 1000
    syscall(SYS_SETSOCKOPT, fd, SOL_SOCKET, SO_RCVTIMEO, (&tv[0]) as i64, 16, 0)
    syscall(SYS_SETSOCKOPT, fd, SOL_SOCKET, SO_SNDTIMEO, (&tv[0]) as i64, 16, 0)
    return fd
}

#[no_gc]
fn fill_sa(sa: *mut [u8; 16], server: u32, port: u16) {
    (*sa)[0] = 2 as u8
    (*sa)[2] = ((port >> 8) & 255 as u16) as u8
    (*sa)[3] = (port & 255 as u16) as u8
    (*sa)[4] = (server >> 24) as u8
    (*sa)[5] = ((server >> 16) & 255 as u32) as u8
    (*sa)[6] = ((server >> 8) & 255 as u32) as u8
    (*sa)[7] = (server & 255 as u32) as u8
}

// The question over UDP; R_* (the record at `out`).
#[no_gc]
fn ask_udp(q: *mut [u8; 300], qlen: usize, id: u32, qtype: u32, server: u32,
    port: u16, timeout_ms: u64, out: u64) -> i32 {
    let fd: i64 = open_sock(2, timeout_ms) // SOCK_DGRAM
    if fd < 0 {
        return R_NONE
    }
    var sa: [u8; 16] = [0 as u8; 16]
    fill_sa(&sa, server, port)
    var r: i64 = 0
    var t: usize = 0
    while t < 4 {
        r = syscall(SYS_SENDTO, fd, (q as u64) as i64, qlen as i64, MSG_NOSIGNAL,
            (&sa[0]) as i64, 16)
        if r != EINTR_NEG {
            break
        }
        t = t + 1
    }
    var got: i32 = R_NONE
    if r == qlen as i64 {
        // Several datagrams may arrive (a forged one first): read until a
        // good one, a timeout or 8 tries.
        var m: [u8; 512] = [0 as u8; 512]
        var from: [u8; 16] = [0 as u8; 16]
        var flen: [u32; 1] = [16]
        var rounds: usize = 0
        var done: bool = false
        while rounds < 8 && !done {
            flen[0] = 16 as u32
            let n: i64 = syscall(SYS_RECVFROM, fd, (&m[0]) as i64, 512, 0,
                (&from[0]) as i64, (&flen[0]) as i64)
            if n == EINTR_NEG {
                rounds = rounds + 1
            } else if n <= 0 {
                break
            } else {
                // only the server we asked, from the port we asked
                var same: bool = true
                var k: usize = 2
                while k < 8 {
                    if from[k] != sa[k] {
                        same = false
                    }
                    k = k + 1
                }
                if same {
                    let pr: i32 = parse_reply((&m[0]) as u64, n as usize, id, q,
                        qlen, qtype, out)
                    if pr != R_NONE {
                        got = pr
                        done = true
                    }
                }
                rounds = rounds + 1
            }
        }
    }
    syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0)
    return got
}

// All of `n` octets from a stream socket; false = error / timeout / EOF.
#[no_gc]
fn read_n(fd: i64, p: u64, n: usize) -> bool {
    var got: usize = 0
    var tries: usize = 0
    while got < n {
        let r: i64 = syscall(SYS_RECVFROM, fd, (p + got as u64) as i64,
            (n - got) as i64, 0, 0, 0)
        if r == EINTR_NEG && tries < 20 {
            tries = tries + 1
            continue
        }
        if r <= 0 {
            return false
        }
        got = got + r as usize
    }
    return true
}

// The same question over TCP (RFC 7766): length prefix, one reply.
#[no_gc]
fn ask_tcp(q: *mut [u8; 300], qlen: usize, id: u32, qtype: u32, server: u32,
    port: u16, timeout_ms: u64, out: u64) -> i32 {
    let fd: i64 = open_sock(1, timeout_ms) // SOCK_STREAM
    if fd < 0 {
        return R_NONE
    }
    var sa: [u8; 16] = [0 as u8; 16]
    fill_sa(&sa, server, port)
    var got: i32 = R_NONE
    if syscall(SYS_CONNECT, fd, (&sa[0]) as i64, 16, 0, 0, 0) == 0 {
        var msg: [u8; 302] = [0 as u8; 302]
        msg[0] = (qlen >> 8) as u8
        msg[1] = (qlen & 255) as u8
        var i: usize = 0
        while i < qlen {
            msg[2 + i] = (*q)[i]
            i = i + 1
        }
        var sent: usize = 0
        var tries: usize = 0
        var ok: bool = true
        while sent < qlen + 2 && ok {
            let r: i64 = syscall(SYS_SENDTO, fd, ((&msg[0]) as u64 + sent as u64) as i64,
                (qlen + 2 - sent) as i64, MSG_NOSIGNAL, 0, 0)
            if r == EINTR_NEG && tries < 20 {
                tries = tries + 1
            } else if r <= 0 {
                ok = false
            } else {
                sent = sent + r as usize
            }
        }
        var lb: [u8; 2] = [0 as u8; 2]
        if ok && read_n(fd, (&lb[0]) as u64, 2) {
            var len: usize = (lb[0] as usize) << 8 | (lb[1] as usize)
            if len > TCP_MAX {
                len = TCP_MAX
            }
            var m: [u8; 2048] = [0 as u8; 2048]
            if len >= 17 && read_n(fd, (&m[0]) as u64, len) {
                let pr: i32 = parse_reply((&m[0]) as u64, len, id, q, qlen, qtype, out)
                if pr == R_FOUND {
                    got = R_FOUND
                }
            }
        }
    }
    syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0)
    return got
}

// Ask ONE server once for `qtype` (1 = A, 28 = AAAA): UDP, and TCP when the
// answer was cut off. true = the record (4 / 16 octets) is at `out`.
#[no_gc]
fn mini_query(name: u64, nlen: usize, server: u32, port: u16,
    timeout_ms: u64, qtype: u32, out: u64) -> bool {
    if !mini_name_ok(name, nlen) {
        return false
    }
    if qtype != QT_A && qtype != QT_AAAA {
        return false
    }
    var q: [u8; 300] = [0 as u8; 300]
    let id: u32 = rnd_id()
    let qlen: usize = build_query(&q, name, nlen, id, qtype)
    if qlen == 0 {
        return false
    }
    let r: i32 = ask_udp(&q, qlen, id, qtype, server, port, timeout_ms, out)
    if r == R_FOUND {
        return true
    }
    if r == R_TRUNC {
        return ask_tcp(&q, qlen, id, qtype, server, port, timeout_ms, out) == R_FOUND
    }
    return false
}

// Ask ONE server once for an A record. 0 = no usable answer.
#[no_gc]
fn mini_lookup_one(name: u64, nlen: usize, server: u32, port: u16,
    timeout_ms: u64) -> u32 {
    var a: [u8; 4] = [0 as u8; 4]
    if !mini_query(name, nlen, server, port, timeout_ms, QT_A, (&a[0]) as u64) {
        return 0 as u32
    }
    return a[0] as u32 | (a[1] as u32) << 8 | (a[2] as u32) << 16 | (a[3] as u32) << 24
}

// Every server twice, in order. 0 = nothing.
#[no_gc]
fn mini_lookup(name: u64, nlen: usize, servers: u64, nservers: usize,
    port: u16, timeout_ms: u64) -> u32 {
    var round: usize = 0
    while round < 2 {
        var s: usize = 0
        while s < nservers {
            let srv: u32 = *((servers + (s * 4) as u64) as *mut u32)
            let a: u32 = mini_lookup_one(name, nlen, srv, port, timeout_ms)
            if a != 0 as u32 {
                return a
            }
            s = s + 1
        }
        round = round + 1
    }
    return 0 as u32
}

// The same for an AAAA record: 16 octets in network order at `out`.
#[no_gc]
fn mini_lookup6(name: u64, nlen: usize, servers: u64, nservers: usize,
    port: u16, timeout_ms: u64, out: u64) -> bool {
    var round: usize = 0
    while round < 2 {
        var s: usize = 0
        while s < nservers {
            let srv: u32 = *((servers + (s * 4) as u64) as *mut u32)
            if mini_query(name, nlen, srv, port, timeout_ms, QT_AAAA, out) {
                return true
            }
            s = s + 1
        }
        round = round + 1
    }
    return false
}
