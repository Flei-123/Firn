// SPDX-License-Identifier: MPL-2.0
import std.rt
import net.transport as tr
import net.hpack
import net.h2frame as fr

export {
    H2, H2Stream, MAX_STREAMS, RECV_WINDOW, fail_conn, find_stream, flush_out, pump, send_window_update, h2_new, h2_free, h2_is_open, h2_goaway_code,
}

const MAX_STREAMS: usize = 16
const RECV_WINDOW: i64 = 1048576
const MAX_BODY: usize = 268435456
const READ_CHUNK: usize = 16384
const COMPACT_AT: usize = 1048576

struct H2Stream {
    id: u32,
    live: bool,
    done: bool,
    got_headers: bool,
    status: i32,
    err: u32,
    send_win: i64,
    recv_win: i64,
    hdrs: rt.Buf,
    body: rt.Buf,
}

fn stream_new() -> H2Stream {
    return H2Stream { id: 0, live: false, done: false, got_headers: false, status: 0, err: 0,
        send_win: 0, recv_win: 0, hdrs: rt.buf_new(), body: rt.buf_new() }
}

struct H2 {
    tp: tr.Transport,
    out: rt.Buf,
    enc: hpack.Hpack,
    dec: hpack.Hpack,
    hblock: rt.Buf,
    hblock_stream: u32,
    hblock_end: bool,
    open: bool,
    goaway_code: u32,
    peer_frame: usize,
    peer_init_win: i64,
    send_win: i64,
    recv_win: i64,
    ping_acked: bool,
    next_id: u32,
    streams: [H2Stream; 16],
}

fn h2_new() -> H2 {
    return H2 { tp: tr.tp_new(), out: rt.buf_new(),
        enc: hpack.hp_new(), dec: hpack.hp_new(), hblock: rt.buf_new(),
        hblock_stream: 0, hblock_end: false, open: false, goaway_code: 0,
        peer_frame: fr.DEFAULT_FRAME_SIZE, peer_init_win: fr.DEFAULT_WINDOW,
        send_win: fr.DEFAULT_WINDOW, recv_win: RECV_WINDOW, ping_acked: false,
        next_id: 1, streams: [stream_new(); 16] }
}

fn h2_free(c: *mut H2) {
    var i: usize = 0
    while i < MAX_STREAMS {
        rt.buf_free(&(*c).streams[i].hdrs)
        rt.buf_free(&(*c).streams[i].body)
        i = i + 1
    }
    tr.tp_free(&(*c).tp)
    hpack.hp_free(&(*c).enc)
    hpack.hp_free(&(*c).dec)
    rt.buf_free(&(*c).out)
    rt.buf_free(&(*c).hblock)
}

fn h2_is_open(c: *mut H2) -> bool { return (*c).open }

fn h2_goaway_code(c: *mut H2) -> u32 { return (*c).goaway_code }

fn flush_out(c: *mut H2) -> bool {
    if (*c).out.len == 0 { return true }
    let ok: bool = tr.tp_write(&(*c).tp, (*c).out.ptr, (*c).out.len)
    rt.buf_clear(&(*c).out)
    if !ok { (*c).open = false }
    return ok
}

fn find_stream(c: *mut H2, id: u32) -> *mut H2Stream {
    var i: usize = 0
    while i < MAX_STREAMS {
        if (*c).streams[i].live && (*c).streams[i].id == id { return &(*c).streams[i] }
        i = i + 1
    }
    return 0 as *mut H2Stream
}

fn fail_conn(c: *mut H2, code: u32) -> bool {
    fr.put_frame_header(&(*c).out, 8, fr.T_GOAWAY, 0, 0)
    fr.put_u32(&(*c).out, 0)
    fr.put_u32(&(*c).out, code)
    flush_out(c)
    (*c).open = false
    return false
}

fn send_window_update(c: *mut H2, stream: u32, inc: i64) {
    fr.put_frame_header(&(*c).out, 4, fr.T_WINDOW_UPDATE, 0, stream)
    fr.put_u32(&(*c).out, inc as u32)
}

fn apply_settings(c: *mut H2, p: u64, n: usize) -> bool {
    var i: usize = 0
    while i + 6 <= n {
        let id: u32 = fr.be16(p, i)
        let v: u32 = fr.be32(p, i + 2)
        if id == fr.S_HEADER_TABLE_SIZE {
            hpack.hp_set_limit(&(*c).enc, v as usize)
        } else if id == fr.S_INITIAL_WINDOW_SIZE {
            if v as i64 > fr.MAX_WINDOW { return fail_conn(c, fr.E_FLOW_CONTROL) }
            let delta: i64 = v as i64 - (*c).peer_init_win
            (*c).peer_init_win = v as i64
            var s: usize = 0
            while s < MAX_STREAMS {
                if (*c).streams[s].live { (*c).streams[s].send_win = (*c).streams[s].send_win + delta }
                s = s + 1
            }
        } else if id == fr.S_MAX_FRAME_SIZE {
            if (v as usize) < fr.DEFAULT_FRAME_SIZE || (v as usize) > fr.MAX_FRAME_SIZE_LIMIT {
                return fail_conn(c, fr.E_PROTOCOL)
            }
            (*c).peer_frame = v as usize
        } else if id == fr.S_ENABLE_PUSH {
            if v > 1 { return fail_conn(c, fr.E_PROTOCOL) }
        }
        i = i + 6
    }
    fr.put_frame_header(&(*c).out, 0, fr.T_SETTINGS, fr.F_ACK, 0)
    return true
}

fn finish_stream(s: *mut H2Stream) {
    (*s).done = true
}

fn on_header_block(c: *mut H2, stream: u32, end_stream: bool) -> bool {
    var decoded: rt.Buf = rt.buf_new()
    let r: i32 = hpack.hp_decode(&(*c).dec, (*c).hblock.ptr, (*c).hblock.len, &decoded)
    rt.buf_clear(&(*c).hblock)
    if r != hpack.HP_OK {
        rt.buf_free(&decoded)
        return fail_conn(c, fr.E_COMPRESSION)
    }
    let s: *mut H2Stream = find_stream(c, stream)
    if s as u64 != 0 && !(*s).done {
        var vp: u64 = 0
        var vn: usize = 0
        if !(*s).got_headers {
            var code: i32 = 0
            if hpack.hdr_find(decoded.ptr, decoded.len, ":status", &vp, &vn) && vn == 3 {
                code = ((rt.ld8(vp, 0) as i32) - 48) * 100 + ((rt.ld8(vp, 1) as i32) - 48) * 10 + ((rt.ld8(vp, 2) as i32) - 48)
            }
            if code >= 100 && code < 200 {
                rt.buf_free(&decoded)
                return true
            }
            (*s).status = code
            (*s).got_headers = true
            rt.buf_push_bytes(&(*s).hdrs, decoded.ptr, decoded.len)
        }
        if end_stream { finish_stream(s) }
    }
    rt.buf_free(&decoded)
    return true
}

fn on_headers(c: *mut H2, stream: u32, flags: u8, p: u64, n: usize) -> bool {
    if stream == 0 { return fail_conn(c, fr.E_PROTOCOL) }
    var off: usize = 0
    var len: usize = 0
    if !fr.strip_padding(p, n, flags, 5, &off, &len) { return fail_conn(c, fr.E_PROTOCOL) }
    rt.buf_push_bytes(&(*c).hblock, p + off as u64, len)
    (*c).hblock_stream = stream
    (*c).hblock_end = (flags & fr.F_END_STREAM) != 0
    if (flags & fr.F_END_HEADERS) != 0 { return on_header_block(c, stream, (*c).hblock_end) }
    return true
}

fn on_data(c: *mut H2, stream: u32, flags: u8, p: u64, n: usize) -> bool {
    if stream == 0 { return fail_conn(c, fr.E_PROTOCOL) }
    var off: usize = 0
    var len: usize = 0
    if !fr.strip_padding(p, n, flags, 0, &off, &len) { return fail_conn(c, fr.E_PROTOCOL) }
    if n as i64 > (*c).recv_win { return fail_conn(c, fr.E_FLOW_CONTROL) }
    (*c).recv_win = (*c).recv_win - n as i64
    let s: *mut H2Stream = find_stream(c, stream)
    if s as u64 != 0 && !(*s).done {
        if n as i64 > (*s).recv_win { return fail_conn(c, fr.E_FLOW_CONTROL) }
        (*s).recv_win = (*s).recv_win - n as i64
        if (*s).body.len + len > MAX_BODY {
            (*s).err = fr.E_CANCEL
            finish_stream(s)
        } else {
            rt.buf_push_bytes(&(*s).body, p + off as u64, len)
            if (flags & fr.F_END_STREAM) != 0 { finish_stream(s) }
        }
        if !(*s).done && (*s).recv_win < RECV_WINDOW / 2 {
            send_window_update(c, stream, RECV_WINDOW - (*s).recv_win)
            (*s).recv_win = RECV_WINDOW
        }
    }
    if (*c).recv_win < RECV_WINDOW / 2 {
        send_window_update(c, 0, RECV_WINDOW - (*c).recv_win)
        (*c).recv_win = RECV_WINDOW
    }
    return true
}

fn on_window_update(c: *mut H2, stream: u32, p: u64, n: usize) -> bool {
    if n != 4 { return fail_conn(c, fr.E_FRAME_SIZE) }
    let inc: i64 = (fr.be32(p, 0) & 2147483647) as i64
    if inc == 0 { return fail_conn(c, fr.E_PROTOCOL) }
    if stream == 0 {
        (*c).send_win = (*c).send_win + inc
        if (*c).send_win > fr.MAX_WINDOW { return fail_conn(c, fr.E_FLOW_CONTROL) }
        return true
    }
    let s: *mut H2Stream = find_stream(c, stream)
    if s as u64 != 0 {
        (*s).send_win = (*s).send_win + inc
        if (*s).send_win > fr.MAX_WINDOW {
            (*s).err = fr.E_FLOW_CONTROL
            finish_stream(s)
        }
    }
    return true
}

fn on_goaway(c: *mut H2, p: u64, n: usize) -> bool {
    if n < 8 { return fail_conn(c, fr.E_FRAME_SIZE) }
    let last: u32 = fr.be32(p, 0) & 2147483647
    (*c).goaway_code = fr.be32(p, 4)
    var i: usize = 0
    while i < MAX_STREAMS {
        if (*c).streams[i].live && (*c).streams[i].id > last && !(*c).streams[i].done {
            (*c).streams[i].err = (*c).goaway_code + 1000
            (*c).streams[i].done = true
        }
        i = i + 1
    }
    (*c).open = false
    return true
}

fn dispatch(c: *mut H2, ftype: u8, flags: u8, stream: u32, p: u64, n: usize) -> bool {
    if (*c).hblock.len > 0 && ftype != fr.T_CONTINUATION { return fail_conn(c, fr.E_PROTOCOL) }
    if ftype == fr.T_DATA { return on_data(c, stream, flags, p, n) }
    if ftype == fr.T_HEADERS { return on_headers(c, stream, flags, p, n) }
    if ftype == fr.T_CONTINUATION {
        if (*c).hblock.len == 0 || stream != (*c).hblock_stream { return fail_conn(c, fr.E_PROTOCOL) }
        rt.buf_push_bytes(&(*c).hblock, p, n)
        if (flags & fr.F_END_HEADERS) != 0 { return on_header_block(c, stream, (*c).hblock_end) }
        return true
    }
    if ftype == fr.T_SETTINGS {
        if stream != 0 { return fail_conn(c, fr.E_PROTOCOL) }
        if (flags & fr.F_ACK) != 0 { return n == 0 || fail_conn(c, fr.E_FRAME_SIZE) }
        if n % 6 != 0 { return fail_conn(c, fr.E_FRAME_SIZE) }
        return apply_settings(c, p, n)
    }
    if ftype == fr.T_PING {
        if stream != 0 { return fail_conn(c, fr.E_PROTOCOL) }
        if n != 8 { return fail_conn(c, fr.E_FRAME_SIZE) }
        if (flags & fr.F_ACK) != 0 {
            (*c).ping_acked = true
        } else {
            fr.put_frame(&(*c).out, fr.T_PING, fr.F_ACK, 0, p, 8)
        }
        return true
    }
    if ftype == fr.T_RST_STREAM {
        if n != 4 || stream == 0 { return fail_conn(c, fr.E_FRAME_SIZE) }
        let s: *mut H2Stream = find_stream(c, stream)
        if s as u64 != 0 {
            (*s).err = fr.be32(p, 0) + 1
            finish_stream(s)
        }
        return true
    }
    if ftype == fr.T_WINDOW_UPDATE { return on_window_update(c, stream, p, n) }
    if ftype == fr.T_GOAWAY { return on_goaway(c, p, n) }
    if ftype == fr.T_PUSH_PROMISE { return fail_conn(c, fr.E_PROTOCOL) }
    if ftype == fr.T_PRIORITY { return n == 5 || fail_conn(c, fr.E_FRAME_SIZE) }
    return true
}

fn pump(c: *mut H2) -> bool {
    if !(*c).open { return false }
    if !tr.tp_need(&(*c).tp, fr.FRAME_HEADER_LEN) {
        (*c).open = false
        return false
    }
    let base: u64 = (*c).tp.inb.ptr + (*c).tp.inpos as u64
    var len: usize = 0
    var ftype: u8 = 0
    var flags: u8 = 0
    var stream: u32 = 0
    fr.read_frame_header(base, fr.FRAME_HEADER_LEN, &len, &ftype, &flags, &stream)
    if len > fr.DEFAULT_FRAME_SIZE { return fail_conn(c, fr.E_FRAME_SIZE) }
    if !tr.tp_need(&(*c).tp, fr.FRAME_HEADER_LEN + len) {
        (*c).open = false
        return false
    }
    let pl: u64 = (*c).tp.inb.ptr + (*c).tp.inpos as u64 + fr.FRAME_HEADER_LEN as u64
    let ok: bool = dispatch(c, ftype, flags, stream, pl, len)
    (*c).tp.inpos = (*c).tp.inpos + fr.FRAME_HEADER_LEN + len
    if !ok { return false }
    return flush_out(c)
}
