// SPDX-License-Identifier: MPL-2.0
// lib/net/dnsmini_main.fi -- lib/net/dnsmini.fi as a PROGRAM (for tests).
//
//     dnsmini_main <ipv4> <port> <timeout ms> <name>...
//
// One line per name:  `<name> OK <a.b.c.d>`  or  `<name> ERR`. A name with
// the prefix `6:` asks for the AAAA record: `6:<name> OK <8 groups of hex>`
// (groups separated by `:`, no zero compression).
// tools/dns/mini_check.py drives it against tools/dns/fake_dns.py.
import std.rt
import net.dns
import net.dnsmini

fn parse_u32(p: u64, n: usize) -> u32 {
    var v: u32 = 0
    var i: usize = 0
    while i < n {
        v = v * 10 as u32 + (rt.ld8(p, i) - 48 as u8) as u32
        i = i + 1
    }
    return v
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 5 {
        return 2
    }
    let ip_p: u64 = rt.arg_ptr(start, 1)
    var ip: u32 = 0
    if !dns.dns_parse_ipv4(ip_p, rt.c_length(ip_p), &ip) {
        return 2
    }
    let pp: u64 = rt.arg_ptr(start, 2)
    let port: u32 = parse_u32(pp, rt.c_length(pp))
    let tp: u64 = rt.arg_ptr(start, 3)
    let tmo: u32 = parse_u32(tp, rt.c_length(tp))
    var servers: [u32; 1] = [ip]
    var out: rt.Buf = rt.buf_new()
    var i: usize = 4
    while i < rt.arg_count(start) {
        let np: u64 = rt.arg_ptr(start, i)
        let nn: usize = rt.c_length(np)
        rt.buf_push_bytes(&out, np, nn)
        if nn > 2 && rt.ld8(np, 0) == 54 as u8 && rt.ld8(np, 1) == 58 as u8 {
            var a6: [u8; 16] = [0 as u8; 16]
            if !dnsmini.mini_lookup6(np + 2 as u64, nn - 2, (&servers[0]) as u64, 1,
                port as u16, tmo as u64, (&a6[0]) as u64) {
                var er: [u8; 4] = " ERR"
                rt.buf_push_bytes(&out, (&er[0]) as u64, 4)
            } else {
                var ok: [u8; 4] = " OK "
                rt.buf_push_bytes(&out, (&ok[0]) as u64, 4)
                var g: usize = 0
                while g < 8 {
                    if g > 0 {
                        rt.buf_push(&out, 58 as u8)
                    }
                    rt.buf_push_hex_u64(&out, (a6[g * 2] as u64) << 8 | (a6[g * 2 + 1] as u64), 1)
                    g = g + 1
                }
            }
        } else {
            let a: u32 = dnsmini.mini_lookup(np, nn, (&servers[0]) as u64, 1,
                port as u16, tmo as u64)
            if a == 0 as u32 {
                var er: [u8; 4] = " ERR"
                rt.buf_push_bytes(&out, (&er[0]) as u64, 4)
            } else {
                var ok: [u8; 4] = " OK "
                rt.buf_push_bytes(&out, (&ok[0]) as u64, 4)
                rt.buf_push_dec_u64(&out, (a & 255 as u32) as u64)
                rt.buf_push(&out, 46 as u8)
                rt.buf_push_dec_u64(&out, ((a >> 8) & 255 as u32) as u64)
                rt.buf_push(&out, 46 as u8)
                rt.buf_push_dec_u64(&out, ((a >> 16) & 255 as u32) as u64)
                rt.buf_push(&out, 46 as u8)
                rt.buf_push_dec_u64(&out, (a >> 24) as u64)
            }
        }
        rt.buf_push(&out, 10 as u8)
        i = i + 1
    }
    rt.write_everything(1, out.ptr, out.len)
    rt.buf_free(&out)
    return 0
}
