// SPDX-License-Identifier: MPL-2.0
import std.rt
import net.udp

export {
    mcast_open, mcast_join, mcast_leave, mcast_set_iface, mcast_set_ttl,
    mcast_set_loop, mcast_group_v4, MCAST_MDNS_V4, MCAST_SSDP_V4,
}

const SYS_SETSOCKOPT: i64 = 54

const SOL_SOCKET: i64 = 1
const SO_REUSEADDR: i64 = 2
const IPPROTO_IP: i64 = 0
const IP_MULTICAST_IF: i64 = 9
const IP_MULTICAST_TTL: i64 = 10
const IP_MULTICAST_LOOP: i64 = 11
const IP_ADD_MEMBERSHIP: i64 = 12
const IP_DROP_MEMBERSHIP: i64 = 13

const MCAST_MDNS_V4: u32 = 3758096635
const MCAST_SSDP_V4: u32 = 4026531834

fn mcast_group_v4(a: u8, b: u8, c: u8, d: u8) -> u32 {
    return ((a as u32) << 24) | ((b as u32) << 16) | ((c as u32) << 8) | (d as u32)
}

fn put_addr(p: u64, off: usize, addr: u32) {
    rt.st8(p, off, ((addr >> 24) & 255 as u32) as u8)
    rt.st8(p, off + 1, ((addr >> 16) & 255 as u32) as u8)
    rt.st8(p, off + 2, ((addr >> 8) & 255 as u32) as u8)
    rt.st8(p, off + 3, (addr & 255 as u32) as u8)
}

fn set_int(fd: i64, level: i64, opt: i64, v: i64) -> i64 {
    var one: [u32; 1] = [0; 1]
    one[0] = (v & 4294967295) as u32
    return syscall(SYS_SETSOCKOPT, fd, level, opt, (&one[0]) as i64, 4, 0)
}

fn mcast_open(port: u16, iface: u32) -> i64 {
    let fd: i64 = udp.udp_open()
    if fd < 0 {
        return fd
    }
    set_int(fd, SOL_SOCKET, SO_REUSEADDR, 1)
    let b: i64 = udp.udp_bind(fd, 0 as u32, port)
    if b < 0 {
        udp.udp_close(fd)
        return b
    }
    mcast_set_loop(fd, true)
    mcast_set_ttl(fd, 255)
    if iface != 0 as u32 {
        mcast_set_iface(fd, iface)
    }
    return fd
}

fn mcast_join(fd: i64, group: u32, iface: u32) -> i64 {
    var m: [u8; 8] = [0; 8]
    put_addr((&m[0]) as u64, 0, group)
    put_addr((&m[0]) as u64, 4, iface)
    return syscall(SYS_SETSOCKOPT, fd, IPPROTO_IP, IP_ADD_MEMBERSHIP, (&m[0]) as i64, 8, 0)
}

fn mcast_leave(fd: i64, group: u32, iface: u32) -> i64 {
    var m: [u8; 8] = [0; 8]
    put_addr((&m[0]) as u64, 0, group)
    put_addr((&m[0]) as u64, 4, iface)
    return syscall(SYS_SETSOCKOPT, fd, IPPROTO_IP, IP_DROP_MEMBERSHIP, (&m[0]) as i64, 8, 0)
}

fn mcast_set_iface(fd: i64, iface: u32) -> i64 {
    var m: [u8; 4] = [0; 4]
    put_addr((&m[0]) as u64, 0, iface)
    return syscall(SYS_SETSOCKOPT, fd, IPPROTO_IP, IP_MULTICAST_IF, (&m[0]) as i64, 4, 0)
}

fn mcast_set_ttl(fd: i64, ttl: i64) -> i64 {
    return set_int(fd, IPPROTO_IP, IP_MULTICAST_TTL, ttl)
}

fn mcast_set_loop(fd: i64, on: bool) -> i64 {
    var v: i64 = 0
    if on {
        v = 1
    }
    return set_int(fd, IPPROTO_IP, IP_MULTICAST_LOOP, v)
}
