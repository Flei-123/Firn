// SPDX-License-Identifier: MPL-2.0
// lib/net/ttschunk.fi -- cuts a text into pieces for the server voice (Piper, GET /tts): the same rule as chunkForTts of the web client
// (public/app.js): the FIRST piece is short (~90) so the voice starts quickly, the next ones are bigger (~280) for a smooth intonation.
//
//   ttschunk.chunk_end(p, n, start, limit, first) -> end (exclusive) of the piece that starts at `start` in p[0, n)
//
// Pieces end after a sentence stop (. ! ? followed by a blank or the end, or a line break) and the blanks behind it. A piece grows by whole
// sentences while it stays within `limit`; one longer sentence stays whole and is cut at HARD_MAX at a blank. `first`: the first piece may
// also end at , ; : once it holds 25 octets. Only ASCII octets decide, so a UTF-8 character is never cut.
import std.rt

export { chunk_end, is_space, HARD_MAX }

const HARD_MAX: usize = 700 // the server cuts a request at 1000 characters

fn is_space(c: u8) -> bool { return c == 32 as u8 || c == 10 as u8 || c == 13 as u8 || c == 9 as u8 }

// End (exclusive) of the piece that starts at `start` in p[0, n). Pieces end after a sentence stop (. ! ? or a line break) and its following
// blanks. A piece grows by whole sentences while it stays within `limit`; a single longer sentence stays whole (cut at HARD_MAX at a blank).
// `first`: the first piece may also end at a , ; : once it has 25 octets (the voice starts sooner). Only ASCII octets decide, so a UTF-8
// character is never cut. Public for the test.
fn chunk_end(p: u64, n: usize, start: usize, limit: usize, first: bool) -> usize {
    var i: usize = start
    var best: usize = 0
    var last_blank: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if is_space(c) && i > start { last_blank = i }
        if i - start >= HARD_MAX {
            if best > 0 { return best }
            if last_blank > start { return last_blank }
            return i
        }
        var brk: bool = false
        var soft: bool = false
        if c == 10 as u8 { brk = true }
        if (c == 46 as u8 || c == 33 as u8 || c == 63 as u8) && (i + 1 >= n || is_space(rt.ld8(p, i + 1))) { brk = true }
        if first && (c == 44 as u8 || c == 59 as u8 || c == 58 as u8) && i - start >= 25 && i + 1 < n && is_space(rt.ld8(p, i + 1)) {
            brk = true
            soft = true
        }
        if brk {
            var e: usize = i + 1
            while e < n && is_space(rt.ld8(p, e)) { e = e + 1 }
            if soft { return e } // first piece: a pause (comma) is early enough
            if e - start > limit && best > 0 { return best }
            best = e
            if e - start >= limit { return best }
            i = e
        } else {
            i = i + 1
        }
    }
    return n
}

