// SPDX-License-Identifier: GPL-2.0-only
// lib/net/httpstate_main.fi -- the jar and the date parser as a program
// (root file, round B4), so that both can be measured against somebody
// else's implementation without a socket in the way.
//
// One command per line on standard input:
//   D <http-date>                  -> the unix time, or 0
//   S <host> <path> <set-cookie>   -> "OK"/"NO" plus the number of live
//                                     cookies afterwards
//   H <host> <path> <secure 0|1>   -> the `Cookie:` value the jar would send
//   N                              -> the number of cookies in the jar
//   Z                              -> empty the jar
// The other side is Python's `http.cookies` plus the rules of RFC 6265 in
// tools/liveb4/cookie_check.py, and `email.utils.parsedate_to_datetime`
// for the dates.
import std.rt
import net.httpstate

fn field(p: u64, n: usize, from: usize, e: *mut usize) -> usize {
    var i: usize = from
    while i < n && rt.ld8(p, i) == 32 as u8 {
        i = i + 1
    }
    var k: usize = i
    while k < n && rt.ld8(p, k) != 32 as u8 {
        k = k + 1
    }
    *e = k
    return i
}

fn main() -> i32 {
    var inb: rt.Buf = rt.buf_new()
    rt.read_stdin(&inb)
    var out: rt.Buf = rt.buf_new()
    var jar: httpstate.Jar = httpstate.jar_new()
    if !httpstate.jar_init(&jar) {
        return 2
    }
    // A FIXED "now", so the test is reproducible: 2026-01-01T00:00:00Z.
    let now: u64 = 1767225600 as u64
    let p: u64 = inb.ptr
    let n: usize = inb.len
    var i: usize = 0
    while i < n {
        var e: usize = i
        while e < n && rt.ld8(p, e) != 10 as u8 {
            e = e + 1
        }
        if e > i {
            let cmd: u8 = rt.ld8(p, i)
            if cmd == 68 as u8 { // D
                let t: u64 = httpstate.http_date(p + (i + 2) as u64,
                    e - i - 2)
                rt.buf_push_dec_u64(&out, t)
            } else if cmd == 78 as u8 { // N
                rt.buf_push_dec_u64(&out,
                    httpstate.jar_live(&jar, now) as u64)
            } else if cmd == 90 as u8 { // Z
                httpstate.jar_clear(&jar)
                var okz: [u8; 2] = "OK"
                rt.buf_push_bytes(&out, (&okz[0]) as u64, 2)
            } else if cmd == 83 as u8 { // S host path set-cookie
                var he: usize = 0
                let hs: usize = field(p, e, i + 2, &he)
                var pe: usize = 0
                let ps: usize = field(p, e, he, &pe)
                var vs: usize = pe
                while vs < e && rt.ld8(p, vs) == 32 as u8 {
                    vs = vs + 1
                }
                let ok: bool = httpstate.jar_set_cookie(&jar,
                    p + vs as u64, e - vs, p + hs as u64, he - hs,
                    p + ps as u64, pe - ps, now)
                if ok {
                    var y: [u8; 3] = "OK "
                    rt.buf_push_bytes(&out, (&y[0]) as u64, 3)
                } else {
                    var no: [u8; 3] = "NO "
                    rt.buf_push_bytes(&out, (&no[0]) as u64, 3)
                }
                rt.buf_push_dec_u64(&out,
                    httpstate.jar_live(&jar, now) as u64)
            } else if cmd == 72 as u8 { // H host path secure
                var he: usize = 0
                let hs: usize = field(p, e, i + 2, &he)
                var pe: usize = 0
                let ps: usize = field(p, e, he, &pe)
                var se: usize = 0
                let ss: usize = field(p, e, pe, &se)
                var secure: bool = false
                if se > ss && rt.ld8(p, ss) == 49 as u8 {
                    secure = true
                }
                let k: usize = httpstate.jar_header(&jar, p + hs as u64,
                    he - hs, p + ps as u64, pe - ps, secure, now, &out)
                if k == 0 {
                    var dash: [u8; 1] = "-"
                    rt.buf_push_bytes(&out, (&dash[0]) as u64, 1)
                }
            }
            rt.buf_push(&out, 10 as u8)
        }
        i = e + 1
    }
    rt.write_everything(1, out.ptr, out.len)
    httpstate.jar_free(&jar)
    rt.buf_free(&out)
    rt.buf_free(&inb)
    return 0
}
