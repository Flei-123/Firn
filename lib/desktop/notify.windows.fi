// SPDX-License-Identifier: MPL-2.0
// lib/desktop/notify.windows.fi -- desktop.notify, Windows: a balloon from a notification-area icon.
//
// The same names and meaning as lib/desktop/notify.fi (Linux, org.freedesktop.Notifications);
// the compiler picks this file for --target=x86_64-windows. Windows 10 and 11 show
// the classic balloon (Shell_NotifyIconW with NIF_INFO) as a toast in the action
// center. The balloon belongs to an icon: `notify_open` therefore puts an icon in the notification
// area (the default application icon, or the picture of the program's own desktop.tray when it
// has one -- use `desktop.tray` directly for that) and keeps it while the notifier is open.
//
// WHAT MAPS TO WHAT
//   summary / body          -> the balloon's title (63 characters) and text (255 characters)
//   icon, category, urgency -> ignored (Windows takes the icon of the tray icon; the sound is the system's)
//   timeout_ms              -> ignored (Windows decides how long a balloon stays)
//   actions                 -> none: a click on the balloon is the action "default"
//   replaces                -> a new balloon replaces the one on show anyway
//   EV_ACTION (id, "default") <- NIN_BALLOONUSERCLICK;  EV_CLOSED (id, CLOSED_EXPIRED) <- NIN_BALLOONTIMEOUT
//
// HONEST
// N1  Only one balloon is on show at a time and its id is a counter of this module (Windows has
//     no notification ids for balloons); `notify_close` clears it.
// N2  This is NOT the WinRT ToastNotification API (action buttons, images, a notification of its own in the
//     settings): that needs COM and WinRT activation -- a project of its own. The balloon needs
//     no registration of the program (an AppUserModelID, a Start menu shortcut) which toasts do.
// N3  Tested under Wine (what Shell_NotifyIconW was given, clicks posted as the shell does), not
//     on a real Windows machine.
import std.rt
import std.str
import desktop.tray

export {
    Notifier, Note, NotifyEvent,
    notify_open, notify_close_bus, notify_ready, notify_server_info, notify_capabilities,
    notify_show, notify_close, notify_poll, notify_event_key, notify_event_zero,
    note_new, notify_once, notify_fd,
    EV_NONE, EV_ACTION, EV_CLOSED,
    CLOSED_EXPIRED, CLOSED_DISMISSED, CLOSED_BY_CALL, CLOSED_UNDEFINED,
    URGENCY_DEFAULT, URGENCY_LOW, URGENCY_NORMAL, URGENCY_CRITICAL,
    TIMEOUT_DEFAULT, TIMEOUT_NEVER,
}

const EV_NONE: u32 = 0
const EV_ACTION: u32 = 1
const EV_CLOSED: u32 = 2

const CLOSED_EXPIRED: u32 = 1
const CLOSED_DISMISSED: u32 = 2
const CLOSED_BY_CALL: u32 = 3
const CLOSED_UNDEFINED: u32 = 4

const URGENCY_DEFAULT: i32 = -1
const URGENCY_LOW: i32 = 0
const URGENCY_NORMAL: i32 = 1
const URGENCY_CRITICAL: i32 = 2

const TIMEOUT_DEFAULT: i32 = -1
const TIMEOUT_NEVER: i32 = 0

struct Note {
    summary: str,
    body: str,
    icon: str,
    actions: str,
    category: str,
    desktop_entry: str,
    urgency: i32,
    timeout_ms: i32,
    replaces: u32,
}

fn note_new(summary: str, body: str) -> Note {
    return Note { summary: summary, body: body, icon: "", actions: "", category: "", desktop_entry: "",
        urgency: URGENCY_DEFAULT, timeout_ms: TIMEOUT_DEFAULT, replaces: 0 as u32 }
}

struct NotifyEvent {
    kind: u32,
    id: u32,
    reason: u32,
}

fn notify_event_zero() -> NotifyEvent {
    return NotifyEvent { kind: 0 as u32, id: 0 as u32, reason: 0 as u32 }
}

struct Notifier {
    t: tray.Tray,
    key: rt.Buf,
    next: u32,
    shown_id: u32,
    ok: bool,
}

fn notify_open(app: str) -> Notifier {
    var n: Notifier = Notifier { t: tray.tray_new(app, app), key: rt.buf_new(), next: 1 as u32, shown_id: 0 as u32,
        ok: false }
    n.ok = tray.tray_show(&n.t)
    return n
}

fn notify_close_bus(n: *mut Notifier) {
    tray.tray_close(&(*n).t)
    rt.buf_free(&(*n).key)
    (*n).ok = false
}

fn notify_ready(n: *mut Notifier) -> bool {
    tray.tray_rebind(&(*n).t)
    return (*n).ok && tray.tray_visible(&(*n).t)
}

fn notify_fd(n: *mut Notifier) -> i32 {
    return -1
}

fn notify_server_info(n: *mut Notifier, out: *mut rt.Buf) -> bool {
    let s: str = "Windows shell\nMicrosoft\n\n1.2\n"
    rt.buf_push_bytes(out, s.p as u64, s.length())
    return true
}

fn notify_capabilities(n: *mut Notifier, out: *mut rt.Buf) -> usize {
    let s: str = "body\nballoon\n"
    rt.buf_push_bytes(out, s.p as u64, s.length())
    return 2
}

fn notify_show(n: *mut Notifier, note: *mut Note) -> u32 {
    if !notify_ready(n) {
        return 0 as u32
    }
    if !tray.tray_balloon(&(*n).t, (*note).summary, (*note).body) {
        return 0 as u32
    }
    var id: u32 = (*note).replaces
    if id == 0 as u32 {
        id = (*n).next
        (*n).next = (*n).next + 1 as u32
    }
    (*n).shown_id = id
    return id
}

fn notify_close(n: *mut Notifier, id: u32) -> bool {
    if !notify_ready(n) || (*n).shown_id != id {
        return false
    }
    tray.tray_balloon(&(*n).t, "", "") // an empty balloon removes the one on show
    (*n).shown_id = 0 as u32
    return true
}

fn notify_event_key(n: *mut Notifier) -> str {
    return str { p: rt.buf_data(&(*n).key), n: rt.buf_len(&(*n).key) }
}

fn notify_poll(n: *mut Notifier, ms: i64, ev: *mut NotifyEvent) -> bool {
    tray.tray_rebind(&(*n).t)
    var te: tray.TrayEvent = tray.tray_event_zero()
    var left: i64 = ms
    var go: bool = true
    while go {
        var step: i64 = left
        if ms < 0 || step > 50 {
            step = 50
        }
        if tray.tray_poll(&(*n).t, step, &te) {
            if te.kind == tray.EV_BALLOON_CLICK {
                rt.buf_clear(&(*n).key)
                let k: str = "default"
                rt.buf_push_bytes(&(*n).key, k.p as u64, k.length())
                (*ev).kind = EV_ACTION
                (*ev).id = (*n).shown_id
                (*ev).reason = 0 as u32
                return true
            }
            if te.kind == tray.EV_BALLOON_CLOSED {
                (*ev).kind = EV_CLOSED
                (*ev).id = (*n).shown_id
                (*ev).reason = CLOSED_EXPIRED
                (*n).shown_id = 0 as u32
                return true
            }
        } else if ms >= 0 {
            left = left - step
            if left <= 0 {
                go = false
            }
        }
    }
    return false
}

fn notify_once(app: str, summary: str, body: str) -> bool {
    var n: Notifier = notify_open(app)
    var note: Note = note_new(summary, body)
    let id: u32 = notify_show(&n, &note)
    notify_close_bus(&n)
    return id != 0 as u32
}
