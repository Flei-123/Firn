// SPDX-License-Identifier: MPL-2.0
// lib/desktop/filedrop.fi -- desktop.filedrop: files dropped on a window, as a callback with the paths.
//
//     import desktop.filedrop
//
//     fn got_file(ud: u64, path: str) { ... open `path` ... }
//
//     window.drop_accept(&w, true)                          // once, after window.make
//     ...
//     let k: u32 = window.next_event(&w)                    // in the event loop
//     if filedrop.filedrop_event(&w, k, got_file, 0) { continue }    // true = it was a drop, `got_file` ran per file
//
// The window layer does the system part (`window.drop_accept`, the event EV_DROP, `window.drop_take`):
// X11 through the XDND protocol, Windows through WM_DROPFILES. This module turns the list of paths
// into calls. A `path` is a UTF-8 view that is valid only during the call (copy it to keep it).
// Android and OrientOS have no file drag and drop onto a window: `window.drop_accept` answers false.
import std.rt
import std.str
import window.window

export { filedrop_event, filedrop_take_all }

// Calls `cb(ud, path)` for every path dropped since the last call. The number of files.
fn filedrop_take_all(w: *mut window.Window, cb: fn(u64, str), ud: u64) -> usize {
    var paths: rt.Buf = rt.buf_new()
    let n: usize = window.drop_take(w, &paths)
    var i: usize = 0
    var at: usize = 0
    var done: usize = 0
    while i < rt.buf_len(&paths) {
        if rt.buf_at(&paths, i) == 0 as u8 {
            cb(ud, str { p: (rt.buf_ptr(&paths) + at as u64) as *mut u8, n: i - at })
            done = done + 1
            at = i + 1
        }
        i = i + 1
    }
    rt.buf_free(&paths)
    return done
}

// For an event loop: when `kind` is EV_DROP, runs the callback for each file and answers true.
fn filedrop_event(w: *mut window.Window, kind: u32, cb: fn(u64, str), ud: u64) -> bool {
    if kind != window.EV_DROP {
        return false
    }
    filedrop_take_all(w, cb, ud)
    return true
}
