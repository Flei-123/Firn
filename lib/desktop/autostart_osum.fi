// lib/desktop/autostart_osum.fi -- desktop.autostart for OrientOS. STUB: OrientOS has no autostart list yet.
//
// Every function answers "not available" (false / 0 / nothing) and has the signature of the Linux
// reference lib/desktop/autostart.fi; `tools/desktop/platforms.py` compares export lists and signatures and
// type-checks this file. A real back end replaces the bodies, not the interface.
import std.rt

export {
    autostart_set, autostart_set_in, autostart_remove, autostart_remove_in, autostart_is_enabled,
    autostart_is_enabled_in, autostart_dir, autostart_command_in, exec_quote,
}

fn autostart_set(app_id: str, name: str, exe: str, args: str) -> bool { return false }
fn autostart_set_in(dir: str, app_id: str, name: str, exe: str, args: str) -> bool { return false }
fn autostart_remove(app_id: str) -> bool { return false }
fn autostart_remove_in(dir: str, app_id: str) -> bool { return false }
fn autostart_is_enabled(app_id: str) -> bool { return false }
fn autostart_is_enabled_in(dir: str, app_id: str) -> bool { return false }
fn autostart_dir(out: *mut rt.Buf) -> bool { return false }
fn autostart_command_in(dir: str, app_id: str, out: *mut rt.Buf) -> bool { return false }
fn exec_quote(out: *mut rt.Buf, s: str) {}
