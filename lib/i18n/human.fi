// weekday names, Sunday first
fn data_weekdays(l: u32) -> str {
    if l == 1 { return "Sonntag|Montag|Dienstag|Mittwoch|Donnerstag|Freitag|Samstag" }
    if l == 2 { return "dimanche|lundi|mardi|mercredi|jeudi|vendredi|samedi" }
    if l == 3 { return "domenica|lunedì|martedì|mercoledì|giovedì|venerdì|sabato" }
    if l == 4 { return "domingo|lunes|martes|miércoles|jueves|viernes|sábado" }
    if l == 5 { return "niedziela|poniedziałek|wtorek|środa|czwartek|piątek|sobota" }
    if l == 6 { return "neděle|pondělí|úterý|středa|čtvrtek|pátek|sobota" }
    if l == 7 { return "воскресенье|понедельник|вторник|среда|четверг|пятница|суббота" }
    return "Sunday|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday"
}

// abbreviated weekday names, Sunday first
fn data_weekdays_abbr(l: u32) -> str {
    if l == 1 { return "So.|Mo.|Di.|Mi.|Do.|Fr.|Sa." }
    if l == 2 { return "dim.|lun.|mar.|mer.|jeu.|ven.|sam." }
    if l == 3 { return "dom|lun|mar|mer|gio|ven|sab" }
    if l == 4 { return "dom|lun|mar|mié|jue|vie|sáb" }
    if l == 5 { return "niedz.|pon.|wt.|śr.|czw.|pt.|sob." }
    if l == 6 { return "ne|po|út|st|čt|pá|so" }
    if l == 7 { return "вс|пн|вт|ср|чт|пт|сб" }
    return "Sun|Mon|Tue|Wed|Thu|Fri|Sat"
}

// AM|PM
fn data_ampm(l: u32) -> str {
    if l == 1 { return "AM|PM" }
    if l == 2 { return "AM|PM" }
    if l == 3 { return "AM|PM" }
    if l == 4 { return "a.\u{A0}m.|p.\u{A0}m." }
    if l == 5 { return "AM|PM" }
    if l == 6 { return "dop.|odp." }
    if l == 7 { return "AM|PM" }
    return "AM|PM"
}
