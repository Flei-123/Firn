// lib/ssdp/ssdp_desc.fi -- ssdp.ssdp_desc: UPnP device description XML (std.xml) and URL resolution (net.url)
import std.rt
import std.xml
import net.url

export {
    Desc, DescService, SERVICE_MAX, FIELD_MAX,
    desc_new, desc_parse, desc_resolve, desc_service_find,
    desc_friendly, desc_manufacturer, desc_model, desc_udn, desc_device_type,
    desc_service_type, desc_service_control, desc_service_scpd, desc_service_events,
}

const SERVICE_MAX: usize = 8
const FIELD_MAX: usize = 160

struct DescService {
    kind: [u8; 160],
    nk: usize,
    control: [u8; 160],
    nc: usize,
    scpd: [u8; 160],
    ns: usize,
    events: [u8; 160],
    ne: usize,
}

struct Desc {
    friendly: [u8; 160],
    nf: usize,
    manufacturer: [u8; 160],
    nm: usize,
    model: [u8; 160],
    nmo: usize,
    udn: [u8; 160],
    nu: usize,
    device_type: [u8; 160],
    nd: usize,
    base: [u8; 160],
    nb: usize,
    count: usize,
    services: [DescService; 8],
}

fn service_new() -> DescService {
    return DescService { kind: [0; 160], nk: 0, control: [0; 160], nc: 0, scpd: [0; 160], ns: 0,
        events: [0; 160], ne: 0 }
}

fn desc_new() -> Desc {
    return Desc { friendly: [0; 160], nf: 0, manufacturer: [0; 160], nm: 0, model: [0; 160], nmo: 0,
        udn: [0; 160], nu: 0, device_type: [0; 160], nd: 0, base: [0; 160], nb: 0, count: 0,
        services: [service_new(); 8] }
}

fn store(dst: u64, s: str) -> usize {
    var n: usize = s.n
    if n > FIELD_MAX {
        n = FIELD_MAX
    }
    var i: usize = 0
    while i < n {
        rt.st8(dst, i, rt.ld8(s.p as u64, i))
        i = i + 1
    }
    return n
}

fn field(d: *mut xml.Doc, parent: u32, key: str, dst: u64) -> usize {
    let n: u32 = xml.child(d, parent, key)
    if n == xml.NONE {
        return 0
    }
    return store(dst, xml.text(d, n))
}

fn read_service(d: *mut xml.Doc, node: u32, s: *mut DescService) {
    (*s).nk = field(d, node, "serviceType", (&(*s).kind[0]) as u64)
    (*s).nc = field(d, node, "controlURL", (&(*s).control[0]) as u64)
    (*s).ns = field(d, node, "SCPDURL", (&(*s).scpd[0]) as u64)
    (*s).ne = field(d, node, "eventSubURL", (&(*s).events[0]) as u64)
}

fn desc_parse(p: u64, n: usize, out: *mut Desc) -> bool {
    var d: xml.Doc = xml.doc_new()
    defer xml.doc_free(&d)
    let ok: bool = xml.parse(&d, p, n) catch false
    if !ok {
        return false
    }
    let root: u32 = xml.root(&d)
    let dev: u32 = xml.child(&d, root, "device")
    if dev == xml.NONE {
        return false
    }
    (*out).nb = field(&d, root, "URLBase", (&(*out).base[0]) as u64)
    (*out).nf = field(&d, dev, "friendlyName", (&(*out).friendly[0]) as u64)
    (*out).nm = field(&d, dev, "manufacturer", (&(*out).manufacturer[0]) as u64)
    (*out).nmo = field(&d, dev, "modelName", (&(*out).model[0]) as u64)
    (*out).nu = field(&d, dev, "UDN", (&(*out).udn[0]) as u64)
    (*out).nd = field(&d, dev, "deviceType", (&(*out).device_type[0]) as u64)
    (*out).count = 0
    let list: u32 = xml.child(&d, dev, "serviceList")
    if list != xml.NONE {
        var ids: [u32; 8] = [0; 8]
        let k: usize = xml.children_named(&d, list, "service", &ids[0], SERVICE_MAX)
        var i: usize = 0
        while i < k {
            read_service(&d, ids[i], &(*out).services[i])
            i = i + 1
        }
        (*out).count = k
    }
    return true
}

fn desc_resolve(location: u64, ln: usize, d: *mut Desc, rel: u64, rn: usize, out: *mut url.Url) -> bool {
    var base: url.Url = url.url_new()
    if !url.url_parse(location, ln, &base) {
        return false
    }
    if (*d).nb > 0 {
        var b2: url.Url = url.url_new()
        if url.url_parse((&(*d).base[0]) as u64, (*d).nb, &b2) {
            return url.url_parse_rel(&b2, rel, rn, out)
        }
    }
    return url.url_parse_rel(&base, rel, rn, out)
}

fn str_of(p: u64, n: usize) -> str {
    if n == 0 {
        return ""
    }
    return str { p: p as *mut u8, n: n }
}

fn same(a: u64, an: usize, b: str) -> bool {
    return an == b.n && rt.mem_eq(a, b.p as u64, an)
}

fn desc_service_find(d: *mut Desc, kind: str) -> usize {
    var i: usize = 0
    while i < (*d).count {
        if same((&(*d).services[i].kind[0]) as u64, (*d).services[i].nk, kind) {
            return i
        }
        i = i + 1
    }
    return SERVICE_MAX
}

fn desc_friendly(d: *mut Desc) -> str { return str_of((&(*d).friendly[0]) as u64, (*d).nf) }
fn desc_manufacturer(d: *mut Desc) -> str { return str_of((&(*d).manufacturer[0]) as u64, (*d).nm) }
fn desc_model(d: *mut Desc) -> str { return str_of((&(*d).model[0]) as u64, (*d).nmo) }
fn desc_udn(d: *mut Desc) -> str { return str_of((&(*d).udn[0]) as u64, (*d).nu) }
fn desc_device_type(d: *mut Desc) -> str { return str_of((&(*d).device_type[0]) as u64, (*d).nd) }
fn desc_service_type(d: *mut Desc, i: usize) -> str { return str_of((&(*d).services[i].kind[0]) as u64, (*d).services[i].nk) }
fn desc_service_control(d: *mut Desc, i: usize) -> str { return str_of((&(*d).services[i].control[0]) as u64, (*d).services[i].nc) }
fn desc_service_scpd(d: *mut Desc, i: usize) -> str { return str_of((&(*d).services[i].scpd[0]) as u64, (*d).services[i].ns) }
fn desc_service_events(d: *mut Desc, i: usize) -> str { return str_of((&(*d).services[i].events[0]) as u64, (*d).services[i].ne) }
