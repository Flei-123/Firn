import std.math
import svg.path
import bezier.geom
import bezier.flatten

export { poly_area, path_area, contour_area }

fn contour_area(poly: *mut geom.Poly, c: usize) -> f64 {
    var sum: f64 = 0.0
    let a: usize = geom.poly_start(poly, c)
    let b: usize = geom.poly_end(poly, c)
    var i: usize = a
    while i < b {
        let j: usize = if i + 1 < b { i + 1 } else { a }
        sum = sum + geom.poly_x(poly, i) * geom.poly_y(poly, j) - geom.poly_x(poly, j) * geom.poly_y(poly, i)
        i = i + 1
    }
    return sum * 0.5
}

fn poly_area(poly: *mut geom.Poly) -> f64 {
    var total: f64 = 0.0
    var c: usize = 0
    while c < geom.poly_contours(poly) {
        total = total + contour_area(poly, c)
        c = c + 1
    }
    return total
}

fn path_area(p: *mut path.Path, tol: f64) -> f64 {
    var poly: geom.Poly = geom.poly_new()
    flatten.path_flatten(p, tol, &poly)
    let a: f64 = poly_area(&poly)
    geom.poly_free(&poly)
    return a
}
