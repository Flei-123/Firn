import std.vec
import std.math
import bezier.geom

export { Arr, NONE_EDGE, arr_new, arr_free, arr_edges, arr_from_poly, arr_intersect, arr_subedges, arr_winding }

const NONE_EDGE: usize = 4294967295
const ES: usize = 6
const SS: usize = 4

struct Arr {
    e: Vec[f64],
    s: Vec[f64],
    scale: f64,
    tol: f64,
}

fn arr_new() -> Arr {
    return Arr { e: vec_new[f64](), s: vec_new[f64](), scale: 1.0, tol: 1e-7 }
}

fn arr_free(a: *mut Arr) {
    vec_free[f64](&(*a).e)
    vec_free[f64](&(*a).s)
}

fn arr_edges(a: *mut Arr) -> usize {
    return vec_len[f64](&(*a).e) / ES
}

fn ev(a: *mut Arr, i: usize, k: usize) -> f64 {
    return (*a).e[i * ES + k]
}

fn turn_deg(px: f64, py: f64, cx: f64, cy: f64, nx: f64, ny: f64) -> f64 {
    let ux: f64 = cx - px
    let uy: f64 = cy - py
    let vx: f64 = nx - cx
    let vy: f64 = ny - cy
    return math.fabs(math.atan2(ux * vy - uy * vx, ux * vx + uy * vy)) * 180.0 / math.PI()
}

fn arr_from_poly(poly: *mut geom.Poly, a: *mut Arr, hard_angle: f64) {
    var x0: f64 = 1e300
    var y0: f64 = 1e300
    var x1: f64 = -1e300
    var y1: f64 = -1e300
    var i: usize = 0
    let total: usize = geom.pts_n(&(*poly).pts)
    while i < total {
        let x: f64 = geom.poly_x(poly, i)
        let y: f64 = geom.poly_y(poly, i)
        if x < x0 { x0 = x }
        if y < y0 { y0 = y }
        if x > x1 { x1 = x }
        if y > y1 { y1 = y }
        i = i + 1
    }
    var scale: f64 = geom.dist(x0, y0, x1, y1)
    if total == 0 || scale < 1e-9 {
        scale = 1.0
    }
    (*a).scale = scale
    (*a).tol = scale * 1e-7
    var c: usize = 0
    while c < geom.poly_contours(poly) {
        var cv: Vec[f64] = geom.pts_new()
        var j: usize = geom.poly_start(poly, c)
        while j < geom.poly_end(poly, c) {
            let x: f64 = geom.poly_x(poly, j)
            let y: f64 = geom.poly_y(poly, j)
            let m: usize = geom.pts_n(&cv)
            if m == 0 || geom.dist(x, y, geom.pts_x(&cv, m - 1), geom.pts_y(&cv, m - 1)) > (*a).tol {
                geom.pts_add(&cv, x, y)
            }
            j = j + 1
        }
        var k: usize = geom.pts_n(&cv)
        if k > 1 && geom.dist(geom.pts_x(&cv, 0), geom.pts_y(&cv, 0), geom.pts_x(&cv, k - 1), geom.pts_y(&cv, k - 1)) <= (*a).tol {
            cv.len = cv.len - 2
            k = k - 1
        }
        if k >= 3 {
            var q: usize = 0
            while q < k {
                let p: usize = (q + k - 1) % k
                let n: usize = (q + 1) % k
                let n2: usize = (q + 2) % k
                let fa: f64 = if turn_deg(geom.pts_x(&cv, p), geom.pts_y(&cv, p), geom.pts_x(&cv, q), geom.pts_y(&cv, q), geom.pts_x(&cv, n), geom.pts_y(&cv, n)) > hard_angle { 1.0 } else { 0.0 }
                let fb: f64 = if turn_deg(geom.pts_x(&cv, q), geom.pts_y(&cv, q), geom.pts_x(&cv, n), geom.pts_y(&cv, n), geom.pts_x(&cv, n2), geom.pts_y(&cv, n2)) > hard_angle { 1.0 } else { 0.0 }
                vec_push[f64](&(*a).e, geom.pts_x(&cv, q))
                vec_push[f64](&(*a).e, geom.pts_y(&cv, q))
                vec_push[f64](&(*a).e, geom.pts_x(&cv, n))
                vec_push[f64](&(*a).e, geom.pts_y(&cv, n))
                vec_push[f64](&(*a).e, fa)
                vec_push[f64](&(*a).e, fb)
                q = q + 1
            }
        }
        geom.pts_free(&cv)
        c = c + 1
    }
}

fn add_split(a: *mut Arr, edge: usize, t: f64, x: f64, y: f64) {
    vec_push[f64](&(*a).s, edge as f64)
    vec_push[f64](&(*a).s, t)
    vec_push[f64](&(*a).s, x)
    vec_push[f64](&(*a).s, y)
}

fn end_on_edge(a: *mut Arr, k: usize, qx: f64, qy: f64) {
    let ax: f64 = ev(a, k, 0)
    let ay: f64 = ev(a, k, 1)
    let bx: f64 = ev(a, k, 2)
    let by: f64 = ev(a, k, 3)
    let len: f64 = geom.dist(ax, ay, bx, by)
    let t: f64 = geom.seg_param(qx, qy, ax, ay, bx, by)
    if geom.dist(qx, qy, ax + (bx - ax) * t, ay + (by - ay) * t) <= (*a).tol && t * len > (*a).tol && (1.0 - t) * len > (*a).tol {
        add_split(a, k, t, qx, qy)
    }
}

fn arr_intersect(a: *mut Arr) {
    let n: usize = arr_edges(a)
    let tol: f64 = (*a).tol
    var i: usize = 0
    while i < n {
        let ax: f64 = ev(a, i, 0)
        let ay: f64 = ev(a, i, 1)
        let bx: f64 = ev(a, i, 2)
        let by: f64 = ev(a, i, 3)
        let lox: f64 = if ax < bx { ax } else { bx }
        let hix: f64 = if ax < bx { bx } else { ax }
        let loy: f64 = if ay < by { ay } else { by }
        let hiy: f64 = if ay < by { by } else { ay }
        var j: usize = i + 1
        while j < n {
            let cx: f64 = ev(a, j, 0)
            let cy: f64 = ev(a, j, 1)
            let dx: f64 = ev(a, j, 2)
            let dy: f64 = ev(a, j, 3)
            let clox: f64 = if cx < dx { cx } else { dx }
            let chix: f64 = if cx < dx { dx } else { cx }
            let cloy: f64 = if cy < dy { cy } else { dy }
            let chiy: f64 = if cy < dy { dy } else { cy }
            if chix + tol >= lox && clox - tol <= hix && chiy + tol >= loy && cloy - tol <= hiy {
                let r1x: f64 = bx - ax
                let r1y: f64 = by - ay
                let r2x: f64 = dx - cx
                let r2y: f64 = dy - cy
                let den: f64 = r1x * r2y - r1y * r2x
                let l1: f64 = geom.len2(r1x, r1y)
                let l2: f64 = geom.len2(r2x, r2y)
                if math.fabs(den) > 1e-12 * l1 * l2 {
                    let qx: f64 = cx - ax
                    let qy: f64 = cy - ay
                    let t: f64 = (qx * r2y - qy * r2x) / den
                    let u: f64 = (qx * r1y - qy * r1x) / den
                    if t * l1 > tol && (1.0 - t) * l1 > tol && u * l2 > tol && (1.0 - u) * l2 > tol {
                        let px: f64 = ax + r1x * t
                        let py: f64 = ay + r1y * t
                        add_split(a, i, t, px, py)
                        add_split(a, j, u, px, py)
                    }
                }
                end_on_edge(a, i, cx, cy)
                end_on_edge(a, i, dx, dy)
                end_on_edge(a, j, ax, ay)
                end_on_edge(a, j, bx, by)
            }
            j = j + 1
        }
        i = i + 1
    }
}

fn push_sub(out: *mut Vec[f64], px: f64, py: f64, qx: f64, qy: f64, fp: f64, fq: f64) {
    vec_push[f64](out, px)
    vec_push[f64](out, py)
    vec_push[f64](out, qx)
    vec_push[f64](out, qy)
    vec_push[f64](out, fp)
    vec_push[f64](out, fq)
}

fn arr_subedges(a: *mut Arr, out: *mut Vec[f64]) {
    vec_clear[f64](out)
    let n: usize = arr_edges(a)
    let ns: usize = vec_len[f64](&(*a).s) / SS
    var idx: Vec[u32] = vec_new[u32]()
    var i: usize = 0
    while i < n {
        vec_clear[u32](&idx)
        var k: usize = 0
        while k < ns {
            if (*a).s[k * SS] as usize == i {
                var pos: usize = vec_len[u32](&idx)
                vec_push[u32](&idx, k as u32)
                while pos > 0 && (*a).s[idx[pos - 1] as usize * SS + 1] > (*a).s[k * SS + 1] {
                    idx[pos] = idx[pos - 1]
                    pos = pos - 1
                }
                idx[pos] = k as u32
            }
            k = k + 1
        }
        var px: f64 = ev(a, i, 0)
        var py: f64 = ev(a, i, 1)
        var pf: f64 = ev(a, i, 4)
        k = 0
        while k < vec_len[u32](&idx) {
            let r: usize = idx[k] as usize
            let sx: f64 = (*a).s[r * SS + 2]
            let sy: f64 = (*a).s[r * SS + 3]
            if geom.dist(px, py, sx, sy) > (*a).tol {
                push_sub(out, px, py, sx, sy, pf, 1.0)
                px = sx
                py = sy
                pf = 1.0
            }
            k = k + 1
        }
        let bx: f64 = ev(a, i, 2)
        let by: f64 = ev(a, i, 3)
        if geom.dist(px, py, bx, by) > (*a).tol {
            push_sub(out, px, py, bx, by, pf, ev(a, i, 5))
        }
        i = i + 1
    }
    vec_free[u32](&idx)
}

fn arr_winding(a: *mut Arr, x: f64, y: f64) -> i64 {
    var wn: i64 = 0
    let n: usize = arr_edges(a)
    var i: usize = 0
    while i < n {
        let ax: f64 = ev(a, i, 0)
        let ay: f64 = ev(a, i, 1)
        let bx: f64 = ev(a, i, 2)
        let by: f64 = ev(a, i, 3)
        let left: f64 = (bx - ax) * (y - ay) - (x - ax) * (by - ay)
        if ay <= y {
            if by > y && left > 0.0 {
                wn = wn + 1
            }
        } else {
            if by <= y && left < 0.0 {
                wn = wn - 1
            }
        }
        i = i + 1
    }
    return wn
}
