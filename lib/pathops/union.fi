import std.vec
import std.math
import svg.path
import bezier.geom
import bezier.flatten
import bezier.fit
import pathops.arrange

export { union_poly, union_path, union_paths, union_flatten_tol }

const HARD_ANGLE: f64 = 30.0
const SUB: usize = 6

fn union_flatten_tol(maxerr: f64) -> f64 {
    return maxerr * 0.25
}

struct Graph {
    vx: Vec[f64],
    vf: Vec[u8],
    from: Vec[u32],
    to: Vec[u32],
    used: Vec[u8],
}

fn vertex(g: *mut Graph, x: f64, y: f64, f: f64, tol: f64) -> usize {
    let n: usize = geom.pts_n(&(*g).vx)
    var i: usize = 0
    while i < n {
        if geom.dist(x, y, geom.pts_x(&(*g).vx, i), geom.pts_y(&(*g).vx, i)) <= tol * 3.0 {
            if f > 0.0 {
                (*g).vf[i] = 1 as u8
            }
            return i
        }
        i = i + 1
    }
    geom.pts_add(&(*g).vx, x, y)
    vec_push[u8](&(*g).vf, if f > 0.0 { 1 as u8 } else { 0 as u8 })
    return n
}

fn has_edge(g: *mut Graph, u: usize, v: usize) -> bool {
    var i: usize = 0
    while i < vec_len[u32](&(*g).from) {
        if (*g).from[i] as usize == u && (*g).to[i] as usize == v {
            return true
        }
        i = i + 1
    }
    return false
}

fn add_edge(g: *mut Graph, u: usize, v: usize) {
    if u == v || has_edge(g, u, v) {
        return
    }
    vec_push[u32](&(*g).from, u as u32)
    vec_push[u32](&(*g).to, v as u32)
    vec_push[u8](&(*g).used, 0 as u8)
}

fn next_edge(g: *mut Graph, v: usize) -> usize {
    var i: usize = 0
    while i < vec_len[u32](&(*g).from) {
        if (*g).used[i] == 0 && (*g).from[i] as usize == v {
            return i
        }
        i = i + 1
    }
    return arrange.NONE_EDGE
}

fn union_poly(src: *mut geom.Poly, loops: *mut geom.Poly, hard: *mut Vec[u8]) {
    geom.poly_clear(loops)
    vec_clear[u8](hard)
    var a: arrange.Arr = arrange.arr_new()
    arrange.arr_from_poly(src, &a, HARD_ANGLE)
    arrange.arr_intersect(&a)
    var subs: Vec[f64] = geom.pts_new()
    arrange.arr_subedges(&a, &subs)
    var g: Graph = Graph { vx: geom.pts_new(), vf: vec_new[u8](), from: vec_new[u32](), to: vec_new[u32](), used: vec_new[u8]() }
    let delta: f64 = a.scale * 1e-6
    let ns: usize = vec_len[f64](&subs) / SUB
    var i: usize = 0
    while i < ns {
        let px: f64 = subs[i * SUB]
        let py: f64 = subs[i * SUB + 1]
        let qx: f64 = subs[i * SUB + 2]
        let qy: f64 = subs[i * SUB + 3]
        let fp: f64 = subs[i * SUB + 4]
        let fq: f64 = subs[i * SUB + 5]
        let dx: f64 = qx - px
        let dy: f64 = qy - py
        let l: f64 = geom.len2(dx, dy)
        let mx: f64 = (px + qx) * 0.5
        let my: f64 = (py + qy) * 0.5
        let nx: f64 = -dy / l * delta
        let ny: f64 = dx / l * delta
        let wl: i64 = arrange.arr_winding(&a, mx + nx, my + ny)
        let wr: i64 = arrange.arr_winding(&a, mx - nx, my - ny)
        if (wl != 0) != (wr != 0) {
            let u: usize = vertex(&g, px, py, fp, a.tol)
            let v: usize = vertex(&g, qx, qy, fq, a.tol)
            if wl != 0 {
                add_edge(&g, u, v)
            } else {
                add_edge(&g, v, u)
            }
        }
        i = i + 1
    }
    var e: usize = 0
    while e < vec_len[u32](&g.from) {
        if g.used[e] == 0 {
            g.used[e] = 1 as u8
            let start: usize = g.from[e] as usize
            var chain: Vec[u32] = vec_new[u32]()
            vec_push[u32](&chain, start as u32)
            var cur: usize = g.to[e] as usize
            var closed: bool = false
            while true {
                if cur == start {
                    closed = true
                    break
                }
                vec_push[u32](&chain, cur as u32)
                let nx: usize = next_edge(&g, cur)
                if nx == arrange.NONE_EDGE {
                    break
                }
                g.used[nx] = 1 as u8
                cur = g.to[nx] as usize
            }
            if closed && vec_len[u32](&chain) >= 3 {
                var k: usize = 0
                while k < vec_len[u32](&chain) {
                    let v: usize = chain[k] as usize
                    geom.poly_add(loops, geom.pts_x(&g.vx, v), geom.pts_y(&g.vx, v))
                    vec_push[u8](hard, g.vf[v])
                    k = k + 1
                }
                geom.poly_close(loops)
            }
            vec_free[u32](&chain)
        }
        e = e + 1
    }
    geom.pts_free(&g.vx)
    vec_free[u8](&g.vf)
    vec_free[u32](&g.from)
    vec_free[u32](&g.to)
    vec_free[u8](&g.used)
    geom.pts_free(&subs)
    arrange.arr_free(&a)
}

fn fit_loops(loops: *mut geom.Poly, hard: *mut Vec[u8], maxerr: f64, out: *mut path.Path) {
    var c: usize = 0
    while c < geom.poly_contours(loops) {
        var v: Vec[f64] = geom.pts_new()
        var cuts: Vec[u32] = vec_new[u32]()
        let a: usize = geom.poly_start(loops, c)
        let b: usize = geom.poly_end(loops, c)
        var i: usize = a
        while i < b {
            geom.pts_add(&v, geom.poly_x(loops, i), geom.poly_y(loops, i))
            if (*hard)[i] != 0 {
                vec_push[u32](&cuts, (i - a) as u32)
            }
            i = i + 1
        }
        fit.fit_loop_cuts(&v, geom.pts_n(&v), &cuts, maxerr, out)
        geom.pts_free(&v)
        vec_free[u32](&cuts)
        c = c + 1
    }
}

fn union_path(src: *mut path.Path, maxerr: f64, out: *mut path.Path) {
    var poly: geom.Poly = geom.poly_new()
    flatten.path_flatten(src, union_flatten_tol(maxerr), &poly)
    var loops: geom.Poly = geom.poly_new()
    var hard: Vec[u8] = vec_new[u8]()
    union_poly(&poly, &loops, &hard)
    fit_loops(&loops, &hard, maxerr, out)
    geom.poly_free(&poly)
    geom.poly_free(&loops)
    vec_free[u8](&hard)
}

fn union_paths(a: *mut path.Path, b: *mut path.Path, maxerr: f64, out: *mut path.Path) {
    var poly: geom.Poly = geom.poly_new()
    flatten.path_flatten(a, union_flatten_tol(maxerr), &poly)
    flatten.path_flatten(b, union_flatten_tol(maxerr), &poly)
    var loops: geom.Poly = geom.poly_new()
    var hard: Vec[u8] = vec_new[u8]()
    union_poly(&poly, &loops, &hard)
    fit_loops(&loops, &hard, maxerr, out)
    geom.poly_free(&poly)
    geom.poly_free(&loops)
    vec_free[u8](&hard)
}
