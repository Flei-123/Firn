// SPDX-License-Identifier: MPL-2.0
// lib/barcode/dmcode.fi -- barcode.dmcode: Data Matrix data codewords: ASCII / Base 256 encodation, and decoding of ASCII, C40, Text, X12, EDIFACT and Base 256.

import std.rt

export { dmcode_encode, dmcode_decode, DM_MODE_ASCII, DM_MODE_BASE256 }

const DM_MODE_ASCII: u32 = 0
const DM_MODE_BASE256: u32 = 1

fn rand253(pos: i64) -> i64 {
    var r: i64 = 129 + ((149 * pos) % 253) + 1
    if r > 254 {
        r = r - 254
    }
    return r
}

fn is_digit(c: u8) -> bool {
    return c >= 48 as u8 && c <= 57 as u8
}

fn dmcode_encode(p: u64, n: usize, mode: u32, cw: *mut rt.Buf) {
    rt.buf_clear(cw)
    if mode == DM_MODE_BASE256 {
        rt.buf_push(cw, 231 as u8)
        var hdr: [i64; 2] = [0; 2]
        var hn: i64 = 1
        if n <= 249 {
            hdr[0] = n as i64
        } else {
            hdr[0] = (n as i64) / 250 + 249
            hdr[1] = (n as i64) % 250
            hn = 2
        }
        var k: i64 = 0
        while k < hn {
            let pos: i64 = (rt.buf_len(cw) as i64) + 1
            rt.buf_push(cw, ((hdr[k as usize] + (149 * pos) % 255 + 1) % 256) as u8)
            k = k + 1
        }
        var i: usize = 0
        while i < n {
            let pos: i64 = (rt.buf_len(cw) as i64) + 1
            rt.buf_push(cw, (((rt.ld8(p, i) as i64) + (149 * pos) % 255 + 1) % 256) as u8)
            i++
        }
        return
    }
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if is_digit(c) && i + 1 < n && is_digit(rt.ld8(p, i + 1)) {
            let v: i64 = ((c as i64) - 48) * 10 + (rt.ld8(p, i + 1) as i64) - 48
            rt.buf_push(cw, (130 + v) as u8)
            i = i + 2
        } else {
            if c < 128 as u8 {
                rt.buf_push(cw, c + 1 as u8)
            } else {
                rt.buf_push(cw, 235 as u8)
                rt.buf_push(cw, c - 128 as u8 + 1 as u8)
            }
            i++
        }
    }
}

fn c40_char(set: i64, v: i64, text: bool, upper: bool) -> i64 {
    var c: i64 = 0 - 1
    if set == 0 {
        if v == 3 {
            c = 32
        }
        if v >= 4 && v <= 13 {
            c = 48 + v - 4
        }
        if v >= 14 && v <= 39 {
            if text {
                c = 97 + v - 14
            } else {
                c = 65 + v - 14
            }
        }
    }
    if set == 1 {
        if v <= 31 {
            c = v
        }
    }
    if set == 2 {
        if v <= 14 {
            c = 33 + v
        }
        if v >= 15 && v <= 21 {
            c = 58 + v - 15
        }
        if v >= 22 && v <= 26 {
            c = 91 + v - 22
        }
        if v == 27 {
            c = 29
        }
    }
    if set == 3 {
        if v == 0 {
            c = 96
        }
        if v >= 1 && v <= 26 {
            if text {
                c = 65 + v - 1
            } else {
                c = 97 + v - 1
            }
        }
        if v >= 27 && v <= 30 {
            c = 123 + v - 27
        }
        if v == 31 {
            c = 127
        }
    }
    if c >= 0 && upper {
        c = c + 128
    }
    return c
}

fn x12_char(v: i64) -> i64 {
    if v == 0 {
        return 13
    }
    if v == 1 {
        return 42
    }
    if v == 2 {
        return 62
    }
    if v == 3 {
        return 32
    }
    if v >= 4 && v <= 13 {
        return 48 + v - 4
    }
    if v >= 14 && v <= 39 {
        return 65 + v - 14
    }
    return 0 - 1
}

fn decode_c40(cw: u64, n: i64, i0: i64, text: bool, out: *mut rt.Buf, next: *mut i64) -> bool {
    var i: i64 = i0
    var shift: i64 = 0
    var upper: bool = false
    while i < n {
        let a: i64 = rt.ld8(cw, i as usize) as i64
        if a == 254 {
            *(next) = i + 1
            return true
        }
        if i + 1 >= n {
            *(next) = i
            return true
        }
        let b: i64 = rt.ld8(cw, (i + 1) as usize) as i64
        let v: i64 = a * 256 + b - 1
        var vals: [i64; 3] = [v / 1600, (v / 40) % 40, v % 40]
        var k: i64 = 0
        while k < 3 {
            let x: i64 = vals[k as usize]
            if shift == 0 {
                if x <= 2 {
                    shift = x + 1
                } else {
                    let c: i64 = c40_char(0, x, text, upper)
                    if c < 0 {
                        return false
                    }
                    rt.buf_push(out, c as u8)
                    upper = false
                }
            } else {
                if shift == 2 && x == 30 {
                    upper = true
                } else {
                    let c: i64 = c40_char(shift, x, text, upper)
                    if c < 0 {
                        return false
                    }
                    rt.buf_push(out, c as u8)
                    upper = false
                }
                shift = 0
            }
            k = k + 1
        }
        i = i + 2
    }
    *(next) = i
    return true
}

fn decode_x12(cw: u64, n: i64, i0: i64, out: *mut rt.Buf, next: *mut i64) -> bool {
    var i: i64 = i0
    while i < n {
        let a: i64 = rt.ld8(cw, i as usize) as i64
        if a == 254 {
            *(next) = i + 1
            return true
        }
        if i + 1 >= n {
            *(next) = i
            return true
        }
        let v: i64 = a * 256 + (rt.ld8(cw, (i + 1) as usize) as i64) - 1
        var vals: [i64; 3] = [v / 1600, (v / 40) % 40, v % 40]
        var k: i64 = 0
        while k < 3 {
            let c: i64 = x12_char(vals[k as usize])
            if c < 0 {
                return false
            }
            rt.buf_push(out, c as u8)
            k = k + 1
        }
        i = i + 2
    }
    *(next) = i
    return true
}

fn decode_edifact(cw: u64, n: i64, i0: i64, out: *mut rt.Buf, next: *mut i64) -> bool {
    var i: i64 = i0
    while i < n {
        if n - i <= 2 {
            *(next) = i
            return true
        }
        var b: [i64; 3] = [0; 3]
        var k: i64 = 0
        while k < 3 {
            if i + k < n {
                b[k as usize] = rt.ld8(cw, (i + k) as usize) as i64
            }
            k = k + 1
        }
        var vals: [i64; 4] = [b[0] / 4, (b[0] % 4) * 16 + b[1] / 16, (b[1] % 16) * 4 + b[2] / 64, b[2] % 64]
        k = 0
        while k < 4 {
            let v: i64 = vals[k as usize]
            if v == 31 {
                *(next) = i + 3
                if *(next) > n {
                    *(next) = n
                }
                return true
            }
            if v < 32 {
                rt.buf_push(out, (v + 64) as u8)
            } else {
                rt.buf_push(out, v as u8)
            }
            k = k + 1
        }
        i = i + 3
    }
    *(next) = n
    return true
}

fn decode_base256(cw: u64, n: i64, i0: i64, out: *mut rt.Buf, next: *mut i64) -> bool {
    var i: i64 = i0
    let d1: i64 = ((rt.ld8(cw, i as usize) as i64) - (149 * (i + 1)) % 255 - 1 + 512) % 256
    i = i + 1
    var len: i64 = d1
    if d1 == 0 {
        len = n - i
    }
    if d1 >= 250 {
        if i >= n {
            return false
        }
        let d2: i64 = ((rt.ld8(cw, i as usize) as i64) - (149 * (i + 1)) % 255 - 1 + 512) % 256
        i = i + 1
        len = 250 * (d1 - 249) + d2
    }
    if i + len > n {
        return false
    }
    var k: i64 = 0
    while k < len {
        let v: i64 = ((rt.ld8(cw, i as usize) as i64) - (149 * (i + 1)) % 255 - 1 + 512) % 256
        rt.buf_push(out, v as u8)
        i = i + 1
        k = k + 1
    }
    *(next) = i
    return true
}

fn dmcode_decode(cw: u64, n: i64, out: *mut rt.Buf) -> bool {
    var i: i64 = 0
    var upper: bool = false
    while i < n {
        let c: i64 = rt.ld8(cw, i as usize) as i64
        i = i + 1
        if c == 0 {
            return false
        }
        if c <= 128 {
            var v: i64 = c - 1
            if upper {
                v = v + 128
                upper = false
            }
            rt.buf_push(out, v as u8)
        }
        if c == 129 {
            return true
        }
        if c >= 130 && c <= 229 {
            let v: i64 = c - 130
            rt.buf_push(out, (48 + v / 10) as u8)
            rt.buf_push(out, (48 + v % 10) as u8)
        }
        if c == 230 || c == 239 {
            var next: i64 = i
            if !decode_c40(cw, n, i, c == 239, out, &next) {
                return false
            }
            i = next
        }
        if c == 231 {
            var next: i64 = i
            if i >= n {
                return false
            }
            if !decode_base256(cw, n, i, out, &next) {
                return false
            }
            i = next
        }
        if c == 232 {
            rt.buf_push(out, 29 as u8)
        }
        if c == 235 {
            upper = true
        }
        if c == 236 || c == 237 {
            rt.buf_push_bytes(out, "[)>".p as u64, 3)
            rt.buf_push(out, 30 as u8)
            rt.buf_push(out, 48 as u8)
            if c == 236 {
                rt.buf_push(out, 53 as u8)
            } else {
                rt.buf_push(out, 54 as u8)
            }
            rt.buf_push(out, 29 as u8)
        }
        if c == 238 {
            var next: i64 = i
            if !decode_x12(cw, n, i, out, &next) {
                return false
            }
            i = next
        }
        if c == 240 {
            var next: i64 = i
            if !decode_edifact(cw, n, i, out, &next) {
                return false
            }
            i = next
        }
        if c == 241 {
            if i >= n {
                return false
            }
            let e: i64 = rt.ld8(cw, i as usize) as i64
            i = i + 1
            if e >= 128 {
                i = i + 1
            }
            if e >= 192 {
                i = i + 1
            }
        }
        if c == 233 || c == 234 || c >= 242 {
            if c == 233 {
                i = i + 3
            }
            if c != 233 && c != 234 && c != 254 {
                if c != 255 {
                    return false
                }
            }
        }
    }
    return true
}
