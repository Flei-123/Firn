// SPDX-License-Identifier: MPL-2.0
// lib/barcode/dmplace.fi -- barcode.dmplace: the ECC 200 codeword placement (ISO/IEC 16022 Annex F) as a module to (codeword, bit) map.

import std.rt

export { dm_place, DM_UNSET, DM_FILL_DARK }

const DM_UNSET: u32 = 4294967295 as u32
const DM_FILL_DARK: u32 = 4294967294 as u32

struct Grid {
    map: u64,
    nr: i64,
    nc: i64,
}

fn put(g: *mut Grid, row: i64, col: i64, pos: i64, bit: i64) {
    var r: i64 = row
    var c: i64 = col
    if r < 0 {
        r = r + (*g).nr
        c = c + 4 - (((*g).nr + 4) % 8)
    }
    if c < 0 {
        c = c + (*g).nc
        r = r + 4 - (((*g).nc + 4) % 8)
    }
    rt.st32((*g).map, (r * (*g).nc + c) as usize, (pos * 8 + bit - 1) as u32)
}

fn utah(g: *mut Grid, row: i64, col: i64, pos: i64) {
    put(g, row - 2, col - 2, pos, 1)
    put(g, row - 2, col - 1, pos, 2)
    put(g, row - 1, col - 2, pos, 3)
    put(g, row - 1, col - 1, pos, 4)
    put(g, row - 1, col, pos, 5)
    put(g, row, col - 2, pos, 6)
    put(g, row, col - 1, pos, 7)
    put(g, row, col, pos, 8)
}

fn corner1(g: *mut Grid, pos: i64) {
    let nr: i64 = (*g).nr
    let nc: i64 = (*g).nc
    put(g, nr - 1, 0, pos, 1)
    put(g, nr - 1, 1, pos, 2)
    put(g, nr - 1, 2, pos, 3)
    put(g, 0, nc - 2, pos, 4)
    put(g, 0, nc - 1, pos, 5)
    put(g, 1, nc - 1, pos, 6)
    put(g, 2, nc - 1, pos, 7)
    put(g, 3, nc - 1, pos, 8)
}

fn corner2(g: *mut Grid, pos: i64) {
    let nr: i64 = (*g).nr
    let nc: i64 = (*g).nc
    put(g, nr - 3, 0, pos, 1)
    put(g, nr - 2, 0, pos, 2)
    put(g, nr - 1, 0, pos, 3)
    put(g, 0, nc - 4, pos, 4)
    put(g, 0, nc - 3, pos, 5)
    put(g, 0, nc - 2, pos, 6)
    put(g, 0, nc - 1, pos, 7)
    put(g, 1, nc - 1, pos, 8)
}

fn corner3(g: *mut Grid, pos: i64) {
    let nr: i64 = (*g).nr
    let nc: i64 = (*g).nc
    put(g, nr - 3, 0, pos, 1)
    put(g, nr - 2, 0, pos, 2)
    put(g, nr - 1, 0, pos, 3)
    put(g, 0, nc - 2, pos, 4)
    put(g, 0, nc - 1, pos, 5)
    put(g, 1, nc - 1, pos, 6)
    put(g, 2, nc - 1, pos, 7)
    put(g, 3, nc - 1, pos, 8)
}

fn corner4(g: *mut Grid, pos: i64) {
    let nr: i64 = (*g).nr
    let nc: i64 = (*g).nc
    put(g, nr - 1, 0, pos, 1)
    put(g, nr - 1, nc - 1, pos, 2)
    put(g, 0, nc - 3, pos, 3)
    put(g, 0, nc - 2, pos, 4)
    put(g, 0, nc - 1, pos, 5)
    put(g, 1, nc - 3, pos, 6)
    put(g, 1, nc - 2, pos, 7)
    put(g, 1, nc - 1, pos, 8)
}

fn is_unset(g: *mut Grid, r: i64, c: i64) -> bool {
    return rt.ld32((*g).map, (r * (*g).nc + c) as usize) == DM_UNSET
}

fn dm_place(map: u64, nr: i64, nc: i64) {
    var g: Grid = Grid { map: map, nr: nr, nc: nc }
    var i: i64 = 0
    while i < nr * nc {
        rt.st32(map, i as usize, DM_UNSET)
        i = i + 1
    }
    var pos: i64 = 0
    var row: i64 = 4
    var col: i64 = 0
    var go: bool = true
    while go {
        if row == nr && col == 0 {
            corner1(&g, pos)
            pos = pos + 1
        }
        if row == nr - 2 && col == 0 && nc % 4 != 0 {
            corner2(&g, pos)
            pos = pos + 1
        }
        if row == nr - 2 && col == 0 && nc % 8 == 4 {
            corner3(&g, pos)
            pos = pos + 1
        }
        if row == nr + 4 && col == 2 && nc % 8 == 0 {
            corner4(&g, pos)
            pos = pos + 1
        }
        var inner: bool = true
        while inner {
            if row < nr && col >= 0 && is_unset(&g, row, col) {
                utah(&g, row, col, pos)
                pos = pos + 1
            }
            row = row - 2
            col = col + 2
            inner = row >= 0 && col < nc
        }
        row = row + 1
        col = col + 3
        inner = true
        while inner {
            if row >= 0 && col < nc && is_unset(&g, row, col) {
                utah(&g, row, col, pos)
                pos = pos + 1
            }
            row = row + 2
            col = col - 2
            inner = row < nr && col >= 0
        }
        row = row + 3
        col = col + 1
        go = row < nr || col < nc
    }
    if is_unset(&g, nr - 1, nc - 1) {
        rt.st32(map, ((nr - 1) * nc + nc - 1) as usize, DM_FILL_DARK)
        rt.st32(map, ((nr - 2) * nc + nc - 2) as usize, DM_FILL_DARK)
    }
}
