// SPDX-License-Identifier: MPL-2.0
// lib/barcode/gray.fi -- barcode.gray: RGBA to gray conversion and module string to picture rendering for lib/barcode.

import std.rt

export { gray_from_rgba, gray_free, gray_render_row }

fn gray_from_rgba(p: u64, w: usize, h: usize) -> u64 {
    let g: u64 = rt.heap_alloc(w * h + 1)
    if g == 0 {
        return 0
    }
    var i: usize = 0
    while i < w * h {
        let r: u32 = rt.ld8(p, i * 4) as u32
        let gg: u32 = rt.ld8(p, i * 4 + 1) as u32
        let b: u32 = rt.ld8(p, i * 4 + 2) as u32
        let a: u32 = rt.ld8(p, i * 4 + 3) as u32
        var y: u32 = (r * 299 as u32 + gg * 587 as u32 + b * 114 as u32) / 1000 as u32
        y = (y * a + 255 as u32 * (255 as u32 - a)) / 255 as u32
        rt.st8(g, i, y as u8)
        i++
    }
    return g
}

fn gray_free(g: u64, w: usize, h: usize) {
    rt.heap_free(g, w * h + 1)
}

fn gray_render_row(mods: *mut rt.Buf, scale: usize, quiet: usize, out: u64) -> usize {
    let n: usize = rt.buf_len(mods)
    let total: usize = (n + quiet * 2) * scale
    var x: usize = 0
    while x < total {
        rt.st8(out, x, 255 as u8)
        x++
    }
    var i: usize = 0
    while i < n {
        if rt.buf_at(mods, i) != 0 as u8 {
            var k: usize = 0
            while k < scale {
                rt.st8(out, (quiet + i) * scale + k, 0 as u8)
                k++
            }
        }
        i++
    }
    return total
}
