// SPDX-License-Identifier: MPL-2.0
// lib/barcode/dmrs.fi -- barcode.dmrs: Reed-Solomon over GF(256) with polynomial 0x12D and roots alpha^1..alpha^n (Data Matrix ECC 200).

import std.rt

export { dmrs_encode, dmrs_correct }

static mut EXP: [u8; 512] = [0 as u8; 512]
static mut LOG: [u8; 256] = [0 as u8; 256]
static mut READY: bool = false

fn init() {
    if READY {
        return
    }
    var x: u32 = 1 as u32
    var i: usize = 0
    while i < 255 {
        EXP[i] = x as u8
        LOG[x as usize] = i as u8
        x = x << 1
        if (x & 256 as u32) != 0 as u32 {
            x = x ^ 301 as u32
        }
        i++
    }
    i = 255
    while i < 512 {
        EXP[i] = EXP[i - 255]
        i++
    }
    READY = true
}

fn mul(a: i64, b: i64) -> i64 {
    if a == 0 || b == 0 {
        return 0
    }
    return EXP[(LOG[a as usize] as usize) + (LOG[b as usize] as usize)] as i64
}

fn inv(a: i64) -> i64 {
    return EXP[255 - (LOG[a as usize] as usize)] as i64
}

fn alpha(e: i64) -> i64 {
    var k: i64 = e % 255
    if k < 0 {
        k = k + 255
    }
    return EXP[k as usize] as i64
}

fn generator(n: i64, gp: *mut [i64; 80]) {
    var k: i64 = 0
    while k < 80 {
        (*gp)[k as usize] = 0
        k = k + 1
    }
    (*gp)[0] = 1
    var deg: i64 = 0
    var i: i64 = 1
    while i <= n {
        let a: i64 = alpha(i)
        var j: i64 = deg + 1
        while j >= 1 {
            (*gp)[j as usize] = (*gp)[(j - 1) as usize] ^ mul((*gp)[j as usize], a)
            j = j - 1
        }
        (*gp)[0] = mul((*gp)[0], a)
        deg = deg + 1
        i = i + 1
    }
}

fn dmrs_encode(data: u64, n: usize, ecc: u64, nsym: usize) {
    init()
    var gp: [i64; 80] = [0; 80]
    generator(nsym as i64, &gp)
    var reg: [i64; 80] = [0; 80]
    var i: usize = 0
    while i < n {
        let fb: i64 = (rt.ld8(data, i) as i64) ^ reg[0]
        var j: usize = 0
        while j < nsym {
            var nxt: i64 = 0
            if j + 1 < nsym {
                nxt = reg[j + 1]
            }
            reg[j] = nxt ^ mul(fb, gp[nsym - 1 - j])
            j++
        }
        i++
    }
    i = 0
    while i < nsym {
        rt.st8(ecc, i, reg[i] as u8)
        i++
    }
}

fn dmrs_correct(p: u64, n: i64, nsym: i64) -> i64 {
    init()
    var syn: [i64; 80] = [0; 80]
    var any: bool = false
    var j: i64 = 1
    while j <= nsym {
        let a: i64 = alpha(j)
        var s: i64 = 0
        var i: i64 = 0
        while i < n {
            s = mul(s, a) ^ (rt.ld8(p, i as usize) as i64)
            i = i + 1
        }
        syn[(j - 1) as usize] = s
        if s != 0 {
            any = true
        }
        j = j + 1
    }
    if !any {
        return 0
    }
    var lam: [i64; 81] = [0; 81]
    var prev: [i64; 81] = [0; 81]
    lam[0] = 1
    prev[0] = 1
    var l: i64 = 0
    var m: i64 = 1
    var b: i64 = 1
    var r: i64 = 0
    while r < nsym {
        var d: i64 = syn[r as usize]
        var i: i64 = 1
        while i <= l {
            d = d ^ mul(lam[i as usize], syn[(r - i) as usize])
            i = i + 1
        }
        if d == 0 {
            m = m + 1
        } else {
            var tmp: [i64; 81] = [0; 81]
            var k: i64 = 0
            while k < 81 {
                tmp[k as usize] = lam[k as usize]
                k = k + 1
            }
            let coef: i64 = mul(d, inv(b))
            k = 0
            while k + m < 81 {
                lam[(k + m) as usize] = lam[(k + m) as usize] ^ mul(coef, prev[k as usize])
                k = k + 1
            }
            if 2 * l <= r {
                l = r + 1 - l
                k = 0
                while k < 81 {
                    prev[k as usize] = tmp[k as usize]
                    k = k + 1
                }
                b = d
                m = 1
            } else {
                m = m + 1
            }
        }
        r = r + 1
    }
    if l * 2 > nsym || l == 0 {
        return 0 - 1
    }
    var pos: [i64; 80] = [0; 80]
    var found: i64 = 0
    var e: i64 = 0
    while e < n {
        var v: i64 = 0
        var k: i64 = l
        let xi: i64 = alpha(0 - e)
        while k >= 0 {
            v = mul(v, xi) ^ lam[k as usize]
            k = k - 1
        }
        if v == 0 {
            if found >= 80 {
                return 0 - 1
            }
            pos[found as usize] = e
            found = found + 1
        }
        e = e + 1
    }
    if found != l {
        return 0 - 1
    }
    var omega: [i64; 80] = [0; 80]
    var i: i64 = 0
    while i < nsym {
        var s: i64 = 0
        var k: i64 = 0
        while k <= i && k <= l {
            s = s ^ mul(lam[k as usize], syn[(i - k) as usize])
            k = k + 1
        }
        omega[i as usize] = s
        i = i + 1
    }
    var f: i64 = 0
    while f < found {
        let ex: i64 = pos[f as usize]
        let xi: i64 = alpha(0 - ex)
        var num: i64 = 0
        var k: i64 = nsym - 1
        while k >= 0 {
            num = mul(num, xi) ^ omega[k as usize]
            k = k - 1
        }
        var den: i64 = 0
        k = 1
        while k <= l {
            if k % 2 == 1 {
                var pw: i64 = 1
                var q: i64 = 0
                while q < k - 1 {
                    pw = mul(pw, xi)
                    q = q + 1
                }
                den = den ^ mul(lam[k as usize], pw)
            }
            k = k + 1
        }
        if den == 0 {
            return 0 - 1
        }
        let mag: i64 = mul(num, inv(den))
        let idx: i64 = n - 1 - ex
        rt.st8(p, idx as usize, ((rt.ld8(p, idx as usize) as i64) ^ mag) as u8)
        f = f + 1
    }
    j = 1
    while j <= nsym {
        let a: i64 = alpha(j)
        var s: i64 = 0
        var q: i64 = 0
        while q < n {
            s = mul(s, a) ^ (rt.ld8(p, q as usize) as i64)
            q = q + 1
        }
        if s != 0 {
            return 0 - 1
        }
        j = j + 1
    }
    return found
}
