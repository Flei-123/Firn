// SPDX-License-Identifier: MPL-2.0
// lib/barcode/code39.fi -- barcode.code39: Code 39 (43 characters, optional mod 43 check) encoder and run-length decoder.

import std.rt
import barcode.bcutil
import barcode.bctab

export { code39_encode, code39_decode_runs, code39_check_char }

fn char_index(c: u8) -> i64 {
    var i: usize = 0
    while i < 43 {
        if rt.ld8(bctab.CODE39_CHARS.p as u64, i) == c {
            return i as i64
        }
        i++
    }
    return 0 - 1
}

fn code39_check_char(p: u64, n: usize) -> u8 {
    var sum: i64 = 0
    var i: usize = 0
    while i < n {
        sum = sum + char_index(rt.ld8(p, i))
        i++
    }
    return rt.ld8(bctab.CODE39_CHARS.p as u64, (sum % 43) as usize)
}

fn push_char(m: *mut rt.Buf, idx: i64, gap: bool) {
    if gap {
        bcutil.mods_push_run(m, false, 1)
    }
    var dark: bool = true
    var j: i64 = 0
    while j < 9 {
        var w: i64 = 1
        if rt.ld8(bctab.CODE39_WIDE.p as u64, (idx * 9 + j) as usize) == 49 as u8 {
            w = 3
        }
        bcutil.mods_push_run(m, dark, w)
        dark = !dark
        j = j + 1
    }
}

fn code39_encode(p: u64, n: usize, check: bool, m: *mut rt.Buf) -> BcError!bool {
    if n == 0 {
        return BcError::BadArg
    }
    var i: usize = 0
    while i < n {
        let c: i64 = char_index(rt.ld8(p, i))
        if c < 0 {
            return BcError::BadArg
        }
        i++
    }
    rt.buf_clear(m)
    push_char(m, 43, false)
    i = 0
    while i < n {
        push_char(m, char_index(rt.ld8(p, i)), true)
        i++
    }
    if check {
        push_char(m, char_index(code39_check_char(p, n)), true)
    }
    push_char(m, 43, true)
    return true
}

fn char_at(r: u64, i: i64) -> i64 {
    var w: [f64; 9] = [0.0; 9]
    var sorted: [f64; 9] = [0.0; 9]
    var j: i64 = 0
    while j < 9 {
        w[j as usize] = bcutil.runs_w(r, i + j)
        sorted[j as usize] = w[j as usize]
        j = j + 1
    }
    var a: i64 = 1
    while a < 9 {
        let v: f64 = sorted[a as usize]
        var b: i64 = a - 1
        while b >= 0 && sorted[b as usize] > v {
            sorted[(b + 1) as usize] = sorted[b as usize]
            b = b - 1
        }
        sorted[(b + 1) as usize] = v
        a = a + 1
    }
    if sorted[6] < sorted[5] * 1.45 {
        return 0 - 1
    }
    let thr: f64 = (sorted[5] + sorted[6]) / 2.0
    var k: i64 = 0
    while k < 44 {
        var m: bool = true
        j = 0
        while j < 9 {
            let wide: bool = w[j as usize] > thr
            let want: bool = rt.ld8(bctab.CODE39_WIDE.p as u64, (k * 9 + j) as usize) == 49 as u8
            if wide != want {
                m = false
            }
            j = j + 1
        }
        if m {
            return k
        }
        k = k + 1
    }
    return 0 - 1
}

fn decode_at(r: u64, nr: i64, s: i64, out: *mut rt.Buf) -> bool {
    if s + 9 > nr {
        return false
    }
    if char_at(r, s) != 43 {
        return false
    }
    let nw: f64 = (bcutil.runs_w(r, s) + bcutil.runs_w(r, s + 2) + bcutil.runs_w(r, s + 4)) / 3.0
    if s > 0 && bcutil.runs_w(r, s - 1) < nw * 5.0 {
        return false
    }
    var pos: i64 = s + 9
    var text: rt.Buf = rt.buf_new()
    var ok: bool = false
    while pos + 10 <= nr {
        let gap: f64 = bcutil.runs_w(r, pos)
        if gap > nw * 2.4 {
            break
        }
        let c: i64 = char_at(r, pos + 1)
        if c < 0 {
            break
        }
        pos = pos + 10
        if c == 43 {
            ok = rt.buf_len(&text) > 0
            break
        }
        rt.buf_push(&text, rt.ld8(bctab.CODE39_CHARS.p as u64, c as usize))
    }
    if ok {
        rt.buf_clear(out)
        rt.buf_push_bytes(out, rt.buf_ptr(&text), rt.buf_len(&text))
    }
    rt.buf_free(&text)
    return ok
}

fn code39_decode_runs(r: u64, n: usize, out: *mut rt.Buf) -> bool {
    var s: i64 = 0
    let nr: i64 = n as i64
    while s + 29 <= nr {
        if decode_at(r, nr, s, out) {
            return true
        }
        s = s + 2
    }
    return false
}
