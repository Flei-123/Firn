// SPDX-License-Identifier: MPL-2.0
// lib/barcode/dmtab.fi -- barcode.dmtab: the 30 ECC 200 symbol sizes of ISO/IEC 16022 (rows, columns, data regions, codewords, blocks).

import std.rt

export { dm_size_count, dm_size_rows, dm_size_cols, dm_size_hregions, dm_size_vregions, dm_size_data, dm_size_ecc, dm_size_blocks, dm_size_find }

const SIZES: str = ""

fn field(i: i64, off: i64, w: i64) -> i64 {
    var v: i64 = 0
    var k: i64 = 0
    while k < w {
        v = v * 10 + (rt.ld8(SIZES.p as u64, (i * 18 + off + k) as usize) as i64) - 48
        k = k + 1
    }
    return v
}

fn dm_size_count() -> i64 {
    return (SIZES.n / 18) as i64
}

fn dm_size_rows(i: i64) -> i64 {
    return field(i, 0, 3)
}

fn dm_size_cols(i: i64) -> i64 {
    return field(i, 3, 3)
}

fn dm_size_hregions(i: i64) -> i64 {
    return field(i, 6, 1)
}

fn dm_size_vregions(i: i64) -> i64 {
    return field(i, 7, 1)
}

fn dm_size_data(i: i64) -> i64 {
    return field(i, 8, 4)
}

fn dm_size_ecc(i: i64) -> i64 {
    return field(i, 12, 4)
}

fn dm_size_blocks(i: i64) -> i64 {
    return field(i, 16, 2)
}

fn dm_size_find(rows: i64, cols: i64) -> i64 {
    var i: i64 = 0
    while i < dm_size_count() {
        if dm_size_rows(i) == rows && dm_size_cols(i) == cols {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}
