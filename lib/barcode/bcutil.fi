// lib/barcode/bcutil.fi -- barcode.bcutil: shared types and helpers of lib/barcode (result, errors, module strings, run arrays).

import std.rt

export {
    BcResult, BcError, bc_result_new, bc_result_free, bc_kind_name,
    BC_NONE, BC_EAN13, BC_EAN8, BC_UPCA, BC_CODE128, BC_CODE39, BC_ITF, BC_DATAMATRIX,
    mods_push_run, mods_push_bits, mods_to_text, bc_fabs, bc_fround,
    runs_new, runs_free, runs_set, runs_get, runs_w,
}

const BC_NONE: u32 = 0
const BC_EAN13: u32 = 1
const BC_EAN8: u32 = 2
const BC_UPCA: u32 = 3
const BC_CODE128: u32 = 4
const BC_CODE39: u32 = 5
const BC_ITF: u32 = 6
const BC_DATAMATRIX: u32 = 7

error BcError {
    BadArg,
    TooLong,
    OutOfMemory,
}

struct BcResult {
    kind: u32,
    text: rt.Buf,
    votes: u32,
}

fn bc_result_new() -> BcResult {
    return BcResult { kind: 0 as u32, text: rt.buf_new(), votes: 0 as u32 }
}

fn bc_result_free(r: *mut BcResult) {
    rt.buf_free(&(*r).text)
}

fn bc_kind_name(k: u32) -> str {
    if k == BC_EAN13 {
        return "EAN-13"
    }
    if k == BC_EAN8 {
        return "EAN-8"
    }
    if k == BC_UPCA {
        return "UPC-A"
    }
    if k == BC_CODE128 {
        return "Code128"
    }
    if k == BC_CODE39 {
        return "Code39"
    }
    if k == BC_ITF {
        return "ITF"
    }
    if k == BC_DATAMATRIX {
        return "DataMatrix"
    }
    return "none"
}

fn mods_push_run(b: *mut rt.Buf, dark: bool, n: i64) {
    var i: i64 = 0
    while i < n {
        if dark {
            rt.buf_push(b, 1 as u8)
        } else {
            rt.buf_push(b, 0 as u8)
        }
        i = i + 1
    }
}

fn mods_push_bits(b: *mut rt.Buf, bits: str) {
    var i: usize = 0
    while i < bits.n {
        if rt.ld8(bits.p as u64, i) == 49 as u8 {
            rt.buf_push(b, 1 as u8)
        } else {
            rt.buf_push(b, 0 as u8)
        }
        i++
    }
}

fn mods_to_text(m: *mut rt.Buf, out: *mut rt.Buf) {
    var i: usize = 0
    while i < rt.buf_len(m) {
        if rt.buf_at(m, i) != 0 as u8 {
            rt.buf_push(out, 49 as u8)
        } else {
            rt.buf_push(out, 48 as u8)
        }
        i++
    }
}

fn bc_fabs(v: f64) -> f64 {
    if v < 0.0 {
        return 0.0 - v
    }
    return v
}

fn bc_fround(v: f64) -> i64 {
    if v < 0.0 {
        return 0 - ((0.0 - v + 0.5) as i64)
    }
    return (v + 0.5) as i64
}

fn runs_new(n: usize) -> u64 {
    return rt.heap_alloc((n + 1) * 4)
}

fn runs_free(p: u64, n: usize) {
    rt.heap_free(p, (n + 1) * 4)
}

fn runs_set(p: u64, i: usize, v: i64) {
    rt.st32(p, i, v as u32)
}

fn runs_get(p: u64, i: usize) -> i64 {
    return rt.ld32(p, i) as i64
}

fn runs_w(p: u64, i: i64) -> f64 {
    return (rt.ld32(p, i as usize) as f64) / 16.0
}
