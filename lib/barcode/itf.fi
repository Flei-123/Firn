// SPDX-License-Identifier: MPL-2.0
// lib/barcode/itf.fi -- barcode.itf: Interleaved 2 of 5 encoder and run-length decoder.

import std.rt
import barcode.bcutil

export { itf_encode, itf_decode_runs }

const ITF_WIDE: str = "00110100010100111000001011010001100000111001001010"

fn wide_at(d: i64, j: i64) -> bool {
    return rt.ld8(ITF_WIDE.p as u64, (d * 5 + j) as usize) == 49 as u8
}

fn itf_encode(text: str, m: *mut rt.Buf) -> BcError!bool {
    if text.n == 0 || text.n % 2 != 0 {
        return BcError::BadArg
    }
    var i: usize = 0
    while i < text.n {
        let c: u8 = rt.ld8(text.p as u64, i)
        if c < 48 as u8 || c > 57 as u8 {
            return BcError::BadArg
        }
        i++
    }
    rt.buf_clear(m)
    bcutil.mods_push_bits(m, "1010")
    i = 0
    while i < text.n {
        let a: i64 = (rt.ld8(text.p as u64, i) as i64) - 48
        let b: i64 = (rt.ld8(text.p as u64, i + 1) as i64) - 48
        var j: i64 = 0
        while j < 5 {
            var wa: i64 = 1
            if wide_at(a, j) {
                wa = 3
            }
            var wb: i64 = 1
            if wide_at(b, j) {
                wb = 3
            }
            bcutil.mods_push_run(m, true, wa)
            bcutil.mods_push_run(m, false, wb)
            j = j + 1
        }
        i = i + 2
    }
    bcutil.mods_push_bits(m, "11101")
    return true
}

fn digit_of(r: u64, i: i64, off: i64, thr: f64) -> i64 {
    var d: i64 = 0
    while d < 10 {
        var m: bool = true
        var j: i64 = 0
        while j < 5 {
            let wide: bool = bcutil.runs_w(r, i + j * 2 + off) > thr
            if wide != wide_at(d, j) {
                m = false
            }
            j = j + 1
        }
        if m {
            return d
        }
        d = d + 1
    }
    return 0 - 1
}

fn decode_at(r: u64, nr: i64, s: i64, out: *mut rt.Buf) -> bool {
    if s + 4 + 10 + 3 > nr {
        return false
    }
    let nw: f64 = (bcutil.runs_w(r, s) + bcutil.runs_w(r, s + 1) + bcutil.runs_w(r, s + 2) + bcutil.runs_w(r, s + 3)) / 4.0
    var k: i64 = 0
    while k < 4 {
        let x: f64 = bcutil.runs_w(r, s + k)
        if x > nw * 1.5 || x < nw * 0.6 {
            return false
        }
        k = k + 1
    }
    let thr: f64 = nw * 2.0
    if s > 0 && bcutil.runs_w(r, s - 1) < nw * 5.0 {
        return false
    }
    var pos: i64 = s + 4
    var text: rt.Buf = rt.buf_new()
    var ok: bool = false
    while pos + 3 <= nr {
        if pos + 3 <= nr && bcutil.runs_w(r, pos) > thr && bcutil.runs_w(r, pos + 1) < thr && bcutil.runs_w(r, pos + 2) < thr && (pos + 3 == nr || bcutil.runs_w(r, pos + 3) > nw * 5.0) {
            ok = rt.buf_len(&text) > 0
            break
        }
        if pos + 10 > nr {
            break
        }
        let a: i64 = digit_of(r, pos, 0, thr)
        let b: i64 = digit_of(r, pos, 1, thr)
        if a < 0 || b < 0 {
            break
        }
        rt.buf_push(&text, (48 + a) as u8)
        rt.buf_push(&text, (48 + b) as u8)
        pos = pos + 10
    }
    if ok {
        rt.buf_clear(out)
        rt.buf_push_bytes(out, rt.buf_ptr(&text), rt.buf_len(&text))
    }
    rt.buf_free(&text)
    return ok
}

fn itf_decode_runs(r: u64, n: usize, out: *mut rt.Buf) -> bool {
    var s: i64 = 0
    let nr: i64 = n as i64
    while s + 17 <= nr {
        if decode_at(r, nr, s, out) {
            return true
        }
        s = s + 2
    }
    return false
}
