import std.rt
import fontgen.fgbytes
import fontgen.sfntdir
import fontgen.brotli_enc

export { build_woff2 }

const HEADER_SIZE: usize = 48
const KNOWN_TAGS: str = "cmapheadhheahmtxmaxpnameOS/2postcvt fpgmglyflocaprepCFF VORGEBDTEBLCgasphdmxkernLTSHPCLTVDMXvheavmtxBASEGDEFGPOSGSUBEBSCJSTFMATHCBDTCBLCCOLRCPALSVG sbixacntavarbdatblocbslncvarfdscfeatfmtxfvargvarhstyjustlcarmortmorxopbdproptrakZapfSilfGlatGlocFeatSill"
const KNOWN_COUNT: usize = 63
const TAG_GLYF: u32 = 1735162214
const TAG_LOCA: u32 = 1819239265

fn known_index(tag: u32) -> usize {
    var i: usize = 0
    while i < KNOWN_COUNT {
        let at: u64 = KNOWN_TAGS.p as u64 + (i * 4) as u64
        let v: u32 = ((rt.ld8(at, 0) as u32) << 24) | ((rt.ld8(at, 1) as u32) << 16) | ((rt.ld8(at, 2) as u32) << 8) | (rt.ld8(at, 3) as u32)
        if v == tag {
            return i
        }
        i = i + 1
    }
    return KNOWN_COUNT
}

fn put_base128(out: *mut rt.Buf, value: u32) {
    var groups: u32 = 1
    var rest: u32 = value >> 7
    while rest != 0 as u32 {
        groups = groups + 1
        rest = rest >> 7
    }
    var g: u32 = groups
    while g > 0 {
        g = g - 1
        var byte: u32 = (value >> (7 * g)) & 127 as u32
        if g != 0 {
            byte = byte | 128 as u32
        }
        fgbytes.put8(out, byte)
    }
}

fn put_entry(out: *mut rt.Buf, tag: u32, length: usize) {
    let index: usize = known_index(tag)
    var flags: u32 = index as u32
    if tag == TAG_GLYF || tag == TAG_LOCA {
        flags = flags | 192 as u32
    }
    fgbytes.put8(out, flags)
    if index == KNOWN_COUNT {
        fgbytes.put32(out, tag)
    }
    put_base128(out, length as u32)
}

fn build_woff2(sfnt: *mut rt.Buf, out: *mut rt.Buf) -> bool {
    if !sfntdir.dir_valid(sfnt) {
        return false
    }
    let count: usize = sfntdir.dir_count(sfnt)
    var entries: rt.Buf = rt.buf_new()
    var raw: rt.Buf = rt.buf_new()
    var packed: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < count {
        let length: usize = sfntdir.dir_length(sfnt, i)
        put_entry(&entries, sfntdir.dir_tag(sfnt, i), length)
        rt.buf_push_bytes(&raw, rt.buf_ptr(sfnt) + sfntdir.dir_offset(sfnt, i) as u64, length)
        i = i + 1
    }
    brotli_enc.brotli_encode(rt.buf_ptr(&raw), rt.buf_len(&raw), &packed)
    let compressed: usize = rt.buf_len(&packed)
    fgbytes.put_pad4(&packed)
    let total: usize = HEADER_SIZE + rt.buf_len(&entries) + rt.buf_len(&packed)
    rt.buf_clear(out)
    fgbytes.put_tag(out, "wOF2")
    fgbytes.put32(out, sfntdir.dir_flavor(sfnt))
    fgbytes.put32(out, total as u32)
    fgbytes.put16(out, count as u32)
    fgbytes.put16(out, 0)
    fgbytes.put32(out, rt.buf_len(sfnt) as u32)
    fgbytes.put32(out, compressed as u32)
    fgbytes.put16(out, 1)
    fgbytes.put16(out, 0)
    fgbytes.put_zero(out, 20)
    rt.buf_push_bytes(out, rt.buf_ptr(&entries), rt.buf_len(&entries))
    rt.buf_push_bytes(out, rt.buf_ptr(&packed), rt.buf_len(&packed))
    rt.buf_free(&entries)
    rt.buf_free(&raw)
    rt.buf_free(&packed)
    return true
}
