import std.rt
import std.vec
import fontgen.fgbytes
import fontgen.fgmetrics

export { Table, Sfnt, sfnt_new, sfnt_free, sfnt_add, sfnt_assemble }

struct Table {
    tag: u32,
    data: rt.Buf,
}

struct Sfnt {
    tables: vec.Vec[Table],
}

fn sfnt_new() -> Sfnt {
    return Sfnt { tables: vec.vec_new[Table]() }
}

fn sfnt_free(s: *mut Sfnt) {
    var i: usize = 0
    let n: usize = vec.vec_len[Table](&(*s).tables)
    while i < n {
        rt.buf_free(&(*vec.vec_elem_ptr[Table](&(*s).tables, i)).data)
        i = i + 1
    }
    vec.vec_free[Table](&(*s).tables)
}

fn tag_value(tag: str) -> u32 {
    return ((rt.ld8(tag.p as u64, 0) as u32) << 24) | ((rt.ld8(tag.p as u64, 1) as u32) << 16) | ((rt.ld8(tag.p as u64, 2) as u32) << 8) | (rt.ld8(tag.p as u64, 3) as u32)
}

fn sfnt_add(s: *mut Sfnt, tag: str, data: *mut rt.Buf) {
    let key: u32 = tag_value(tag)
    var at: usize = 0
    let n: usize = vec.vec_len[Table](&(*s).tables)
    while at < n && (*vec.vec_elem_ptr[Table](&(*s).tables, at)).tag < key {
        at = at + 1
    }
    var copy: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&copy, rt.buf_ptr(data), rt.buf_len(data))
    vec.vec_insert[Table](&(*s).tables, at, Table { tag: key, data: copy })
}

fn put_tag_value(b: *mut rt.Buf, tag: u32) {
    fgbytes.put32(b, tag)
}

fn sfnt_assemble(s: *mut Sfnt, out: *mut rt.Buf) {
    let count: u32 = vec.vec_len[Table](&(*s).tables) as u32
    var pow: u32 = 0
    while (1 << (pow + 1)) <= count {
        pow = pow + 1
    }
    let search: u32 = 16 * (1 << pow)
    fgbytes.put32(out, 65536 as u32)
    fgbytes.put16(out, count)
    fgbytes.put16(out, search)
    fgbytes.put16(out, pow)
    fgbytes.put16(out, count * 16 - search)
    var offset: u32 = 12 + 16 * count
    var i: usize = 0
    var head_at: usize = 0
    while i < count as usize {
        let t: *mut Table = vec.vec_elem_ptr[Table](&(*s).tables, i)
        let len: usize = rt.buf_len(&(*t).data)
        put_tag_value(out, (*t).tag)
        fgbytes.put32(out, fgbytes.checksum(rt.buf_ptr(&(*t).data), len))
        fgbytes.put32(out, offset)
        fgbytes.put32(out, len as u32)
        if (*t).tag == 1751474532 as u32 {
            head_at = offset as usize
        }
        offset = offset + ((len as u32 + 3) / 4) * 4
        i = i + 1
    }
    i = 0
    while i < count as usize {
        let t: *mut Table = vec.vec_elem_ptr[Table](&(*s).tables, i)
        rt.buf_push_bytes(out, rt.buf_ptr(&(*t).data), rt.buf_len(&(*t).data))
        fgbytes.put_pad4(out)
        i = i + 1
    }
    if head_at != 0 {
        let whole: u32 = fgbytes.checksum(rt.buf_ptr(out), rt.buf_len(out))
        fgbytes.patch32(out, head_at + 8, ((2981146554 as u64 + 4294967296 as u64 - whole as u64) % 4294967296 as u64) as u32)
    }
}
