import fontgen.brotli_bits

export { ALPHA_MAX, build_code, put_tree, put_sym }

const ALPHA_MAX: usize = 704
const CL_ALPHA: usize = 18
const CL_MAX_LEN: u32 = 5
const CL_REPEAT_ZERO: u32 = 17

static mut CL_ORDER: [u32; 18] = [1, 2, 3, 4, 0, 5, 17, 6, 16, 7, 8, 9, 10, 11, 12, 13, 14, 15]
static mut CL_FIXED_BITS: [u32; 6] = [2, 4, 3, 2, 2, 4]
static mut CL_FIXED_VALUE: [u32; 6] = [0, 7, 3, 2, 1, 15]

fn huffman_depths(f: *mut [u32; 704], n: usize, lens: *mut [u8; 704]) -> u32 {
    var weight: [u32; 1408] = [0; 1408]
    var parent: [u32; 1408] = [0; 1408]
    var alive: [u8; 1408] = [0; 1408]
    var sym: [u32; 704] = [0; 704]
    var k: usize = 0
    var s: usize = 0
    while s < n {
        (*lens)[s] = 0 as u8
        if (*f)[s] > (0 as u32) {
            weight[k] = (*f)[s]
            alive[k] = 1 as u8
            sym[k] = s as u32
            k = k + 1
        }
        s = s + 1
    }
    if k == 0 {
        return 0 as u32
    }
    if k == 1 {
        (*lens)[sym[0] as usize] = 1 as u8
        return 1 as u32
    }
    var total: usize = k
    var merges: usize = 1
    while merges < k {
        var a: usize = 1408
        var b: usize = 1408
        var i: usize = 0
        while i < total {
            if alive[i] == (1 as u8) {
                if a == 1408 || weight[i] < weight[a] {
                    b = a
                    a = i
                } else if b == 1408 || weight[i] < weight[b] {
                    b = i
                }
            }
            i = i + 1
        }
        weight[total] = weight[a] + weight[b]
        alive[a] = 0 as u8
        alive[b] = 0 as u8
        alive[total] = 1 as u8
        parent[a] = total as u32
        parent[b] = total as u32
        total = total + 1
        merges = merges + 1
    }
    var depth: [u32; 1408] = [0; 1408]
    var maxd: u32 = 0
    var idx: usize = total - 1
    while idx > 0 {
        idx = idx - 1
        depth[idx] = depth[parent[idx] as usize] + (1 as u32)
        if idx < k {
            (*lens)[sym[idx] as usize] = depth[idx] as u8
            if depth[idx] > maxd {
                maxd = depth[idx]
            }
        }
    }
    return maxd
}

fn limited_lengths(freq: *mut [u32; 704], n: usize, max_len: u32, lens: *mut [u8; 704]) {
    var f: [u32; 704] = [0; 704]
    var i: usize = 0
    while i < n {
        f[i] = (*freq)[i]
        i = i + 1
    }
    while huffman_depths(&f, n, lens) > max_len {
        i = 0
        while i < n {
            if f[i] > (0 as u32) {
                f[i] = (f[i] + (1 as u32)) / (2 as u32)
            }
            i = i + 1
        }
    }
}

fn reverse_bits(v: u32, n: u32) -> u32 {
    var r: u32 = 0
    var x: u32 = v
    var i: u32 = 0
    while i < n {
        r = (r << (1 as u32)) | (x & (1 as u32))
        x = x >> (1 as u32)
        i = i + (1 as u32)
    }
    return r
}

fn assign_codes(lens: *mut [u8; 704], n: usize, rev: *mut [u32; 704]) {
    var count: [u32; 16] = [0; 16]
    var next: [u32; 16] = [0; 16]
    var s: usize = 0
    while s < n {
        count[(*lens)[s] as usize] = count[(*lens)[s] as usize] + (1 as u32)
        s = s + 1
    }
    count[0] = 0
    var code: u32 = 0
    var l: usize = 1
    while l < 16 {
        code = (code + count[l - 1]) << (1 as u32)
        next[l] = code
        l = l + 1
    }
    s = 0
    while s < n {
        let len: u32 = (*lens)[s] as u32
        if len > (0 as u32) {
            (*rev)[s] = reverse_bits(next[len as usize], len)
            next[len as usize] = next[len as usize] + (1 as u32)
        }
        s = s + 1
    }
}

fn build_code(freq: *mut [u32; 704], n: usize, max_len: u32, lens: *mut [u8; 704], rev: *mut [u32; 704]) -> i64 {
    limited_lengths(freq, n, max_len, lens)
    var used: usize = 0
    var only: i64 = 0 - 1
    var s: usize = 0
    while s < n {
        if (*lens)[s] > (0 as u8) {
            used = used + 1
            only = s as i64
        }
        s = s + 1
    }
    if used == 0 {
        return 0
    }
    if used == 1 {
        return only
    }
    assign_codes(lens, n, rev)
    return 0 - 1
}

fn put_sym(w: *mut brotli_bits.BitW, lens: *mut [u8; 704], rev: *mut [u32; 704], s: u32) {
    brotli_bits.bw_put(w, (*rev)[s as usize], (*lens)[s as usize] as u32)
}

fn put_simple_single(w: *mut brotli_bits.BitW, only: i64, alphabet_bits: u32) {
    var sym: u32 = 0
    if only >= 0 {
        sym = only as u32
    }
    brotli_bits.bw_put(w, 1 as u32, 2 as u32)
    brotli_bits.bw_put(w, 0 as u32, 2 as u32)
    brotli_bits.bw_put(w, sym, alphabet_bits)
}

fn rle_lengths(lens: *mut [u8; 704], last: usize, syms: *mut [u32; 704], extra: *mut [u32; 704]) -> usize {
    var m: usize = 0
    var i: usize = 0
    while i <= last {
        let v: u32 = (*lens)[i] as u32
        if v != (0 as u32) {
            (*syms)[m] = v
            (*extra)[m] = 0
            m = m + 1
            i = i + 1
        } else {
            var run: usize = 0
            while i + run <= last && (*lens)[i + run] == (0 as u8) {
                run = run + 1
            }
            i = i + run
            while run > 0 {
                if run >= 3 {
                    var c: usize = run
                    if c > 10 { c = 10 }
                    (*syms)[m] = CL_REPEAT_ZERO
                    (*extra)[m] = (c - 3) as u32
                    m = m + 1
                    run = run - c
                    if run > 0 {
                        (*syms)[m] = 0
                        (*extra)[m] = 0
                        m = m + 1
                        run = run - 1
                    }
                } else {
                    (*syms)[m] = 0
                    (*extra)[m] = 0
                    m = m + 1
                    run = run - 1
                }
            }
        }
    }
    return m
}

fn put_code_length_header(w: *mut brotli_bits.BitW, cl_lens: *mut [u8; 704], single: bool) {
    brotli_bits.bw_put(w, 0 as u32, 2 as u32)
    var space: u32 = 0
    var i: usize = 0
    while i < CL_ALPHA {
        let sym: usize = CL_ORDER[i] as usize
        let v: u32 = (*cl_lens)[sym] as u32
        brotli_bits.bw_put(w, CL_FIXED_VALUE[v as usize], CL_FIXED_BITS[v as usize])
        if v > (0 as u32) {
            space = space + ((32 as u32) >> v)
        }
        i = i + 1
        if space == (32 as u32) && !single {
            return
        }
    }
}

fn put_tree(w: *mut brotli_bits.BitW, lens: *mut [u8; 704], n: usize, alphabet_bits: u32, only: i64) {
    if only >= 0 {
        put_simple_single(w, only, alphabet_bits)
        return
    }
    var last: usize = 0
    var s: usize = 0
    while s < n {
        if (*lens)[s] > (0 as u8) {
            last = s
        }
        s = s + 1
    }
    var syms: [u32; 704] = [0; 704]
    var extra: [u32; 704] = [0; 704]
    let m: usize = rle_lengths(lens, last, &syms, &extra)
    var freq: [u32; 704] = [0; 704]
    var j: usize = 0
    while j < m {
        freq[syms[j] as usize] = freq[syms[j] as usize] + (1 as u32)
        j = j + 1
    }
    var cl_lens: [u8; 704] = [0; 704]
    var cl_rev: [u32; 704] = [0; 704]
    let cl_only: i64 = build_code(&freq, CL_ALPHA, CL_MAX_LEN, &cl_lens, &cl_rev)
    put_code_length_header(w, &cl_lens, cl_only >= 0)
    j = 0
    while j < m {
        if cl_only < 0 {
            put_sym(w, &cl_lens, &cl_rev, syms[j])
        }
        if syms[j] == CL_REPEAT_ZERO {
            brotli_bits.bw_put(w, extra[j], 3 as u32)
        }
        j = j + 1
    }
}
