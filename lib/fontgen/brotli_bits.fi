import std.rt

export { BitW, BitMark, bw_new, bw_put, bw_align, bw_mark, bw_rewind, bw_push_bytes }

struct BitW {
    acc: u64,
    n: u32,
    out: *mut rt.Buf,
}

struct BitMark {
    acc: u64,
    n: u32,
    len: usize,
}

fn bw_new(out: *mut rt.Buf) -> BitW {
    return BitW { acc: 0, n: 0, out: out }
}

fn bw_put(w: *mut BitW, value: u32, nbits: u32) {
    if nbits == (0 as u32) {
        return
    }
    (*w).acc = (*w).acc | ((value as u64) << ((*w).n as u64))
    (*w).n = (*w).n + nbits
    while (*w).n >= (8 as u32) {
        rt.buf_push((*w).out, ((*w).acc & (255 as u64)) as u8)
        (*w).acc = (*w).acc >> (8 as u64)
        (*w).n = (*w).n - (8 as u32)
    }
}

fn bw_align(w: *mut BitW) {
    if (*w).n > (0 as u32) {
        bw_put(w, 0 as u32, (8 as u32) - (*w).n)
    }
}

fn bw_push_bytes(w: *mut BitW, p: u64, n: usize) {
    rt.buf_push_bytes((*w).out, p, n)
}

fn bw_mark(w: *mut BitW) -> BitMark {
    return BitMark { acc: (*w).acc, n: (*w).n, len: rt.buf_len((*w).out) }
}

fn bw_rewind(w: *mut BitW, m: BitMark) {
    rt.buf_set_len((*w).out, m.len)
    (*w).acc = m.acc
    (*w).n = m.n
}
