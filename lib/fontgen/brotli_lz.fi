import std.rt
import std.vec

export { Cmd, lz_reset, lz_parse, MAX_DISTANCE }

const MAX_DISTANCE: usize = 65520
const CHAIN_LIMIT: usize = 24
const MIN_MATCH: usize = 4
const FAR_DISTANCE: usize = 4096
const FAR_MIN_MATCH: usize = 6

struct Cmd {
    insert: u32,
    copy: u32,
    dist: u32,
}

static mut HEAD: [u32; 65536] = [0; 65536]
static mut PREV: [u32; 65536] = [0; 65536]

fn lz_reset() {
    var i: usize = 0
    while i < 65536 {
        HEAD[i] = 0
        PREV[i] = 0
        i = i + 1
    }
}

fn hash4(p: u64) -> usize {
    let v: u32 = (rt.ld8(p, 0) as u32) | ((rt.ld8(p, 1) as u32) << (8 as u32)) | ((rt.ld8(p, 2) as u32) << (16 as u32)) | ((rt.ld8(p, 3) as u32) << (24 as u32))
    return ((((v as u64) * (2654435761 as u64)) >> (16 as u64)) & (65535 as u64)) as usize
}

fn insert_pos(base: u64, pos: usize, limit: usize) {
    if pos + MIN_MATCH > limit {
        return
    }
    let h: usize = hash4(base + pos as u64)
    PREV[pos & 65535] = HEAD[h]
    HEAD[h] = (pos + 1) as u32
}

fn match_len(base: u64, a: usize, b: usize, max: usize) -> usize {
    var n: usize = 0
    while n < max && rt.ld8(base, a + n) == rt.ld8(base, b + n) {
        n = n + 1
    }
    return n
}

fn lz_parse(base: u64, start: usize, end: usize, total: usize, out: *mut vec.Vec[Cmd]) {
    var pos: usize = start
    var lit_start: usize = start
    while pos < end {
        var best_len: usize = 0
        var best_dist: usize = 0
        if pos + MIN_MATCH <= end {
            var cand: usize = HEAD[hash4(base + pos as u64)] as usize
            var tries: usize = 0
            while cand > 0 && tries < CHAIN_LIMIT {
                let c: usize = cand - 1
                if c >= pos || pos - c > MAX_DISTANCE {
                    cand = 0
                } else {
                    let l: usize = match_len(base, c, pos, end - pos)
                    if l > best_len {
                        best_len = l
                        best_dist = pos - c
                    }
                    let next: usize = PREV[c & 65535] as usize
                    if next != 0 && next - 1 >= c {
                        cand = 0
                    } else {
                        cand = next
                    }
                }
                tries = tries + 1
            }
        }
        var take: bool = best_len >= MIN_MATCH
        if take && best_dist > FAR_DISTANCE && best_len < FAR_MIN_MATCH {
            take = false
        }
        if take {
            vec.vec_push[Cmd](out, Cmd { insert: (pos - lit_start) as u32, copy: best_len as u32, dist: best_dist as u32 })
            var k: usize = 0
            while k < best_len {
                insert_pos(base, pos + k, total)
                k = k + 1
            }
            pos = pos + best_len
            lit_start = pos
        } else {
            insert_pos(base, pos, total)
            pos = pos + 1
        }
    }
    if lit_start < end {
        vec.vec_push[Cmd](out, Cmd { insert: (end - lit_start) as u32, copy: 0, dist: 0 })
    }
}
