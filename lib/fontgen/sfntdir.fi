import std.rt
import fontgen.fgbytes

export { dir_count, dir_tag, dir_checksum, dir_offset, dir_length, dir_flavor, dir_valid }

fn dir_flavor(b: *mut rt.Buf) -> u32 {
    return fgbytes.get32(b, 0)
}

fn dir_count(b: *mut rt.Buf) -> usize {
    return (((rt.ld8(rt.buf_ptr(b), 4) as u32) << 8) | (rt.ld8(rt.buf_ptr(b), 5) as u32)) as usize
}

fn dir_valid(b: *mut rt.Buf) -> bool {
    if rt.buf_len(b) < 12 {
        return false
    }
    let count: usize = dir_count(b)
    if rt.buf_len(b) < 12 + 16 * count {
        return false
    }
    var i: usize = 0
    while i < count {
        let end: usize = dir_offset(b, i) + dir_length(b, i)
        if end > rt.buf_len(b) {
            return false
        }
        i = i + 1
    }
    return true
}

fn dir_tag(b: *mut rt.Buf, i: usize) -> u32 {
    return fgbytes.get32(b, 12 + 16 * i)
}

fn dir_checksum(b: *mut rt.Buf, i: usize) -> u32 {
    return fgbytes.get32(b, 16 + 16 * i)
}

fn dir_offset(b: *mut rt.Buf, i: usize) -> usize {
    return fgbytes.get32(b, 20 + 16 * i) as usize
}

fn dir_length(b: *mut rt.Buf, i: usize) -> usize {
    return fgbytes.get32(b, 24 + 16 * i) as usize
}
