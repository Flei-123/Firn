import std.rt
import fontsrc.model
import fontgen.glyf
import fontgen.cmap
import fontgen.fgmetrics
import fontgen.name
import fontgen.os2
import fontgen.kern
import fontgen.gpos
import fontgen.sfnt
import fontgen.fgbytes

export { build, build_with, FLAG_KERN, FLAG_GPOS, FLAG_ALL }

const FLAG_KERN: u32 = 1
const FLAG_GPOS: u32 = 2
const FLAG_ALL: u32 = 3

fn build_loca(set: *mut glyf.GlyphSet, long_loca: bool, out: *mut rt.Buf) {
    var i: usize = 0
    let n: usize = glyf.glyphset_loca_count(set)
    while i < n {
        let v: u32 = glyf.glyphset_loca_at(set, i)
        if long_loca {
            fgbytes.put32(out, v)
        } else {
            fgbytes.put16(out, v / 2)
        }
        i = i + 1
    }
}

fn build(f: *mut model.Font, out: *mut rt.Buf) -> bool {
    return build_with(f, FLAG_ALL, out)
}

fn build_with(f: *mut model.Font, flags: u32, out: *mut rt.Buf) -> bool {
    var set: glyf.GlyphSet = glyf.glyphset_new()
    glyf.glyphset_build(&set, f)
    let long_loca: bool = rt.buf_len(&set.glyf) >= 131072
    var table: rt.Buf = rt.buf_new()
    var font: sfnt.Sfnt = sfnt.sfnt_new()
    sfnt.sfnt_add(&font, "glyf", &set.glyf)
    build_loca(&set, long_loca, &table)
    sfnt.sfnt_add(&font, "loca", &table)
    rt.buf_clear(&table)
    cmap.build_cmap(f, &table)
    sfnt.sfnt_add(&font, "cmap", &table)
    rt.buf_clear(&table)
    fgmetrics.build_head(f, &set, long_loca, &table)
    sfnt.sfnt_add(&font, "head", &table)
    rt.buf_clear(&table)
    fgmetrics.build_hhea(f, &set, &table)
    sfnt.sfnt_add(&font, "hhea", &table)
    rt.buf_clear(&table)
    fgmetrics.build_hmtx(&set, &table)
    sfnt.sfnt_add(&font, "hmtx", &table)
    rt.buf_clear(&table)
    fgmetrics.build_maxp(&set, &table)
    sfnt.sfnt_add(&font, "maxp", &table)
    rt.buf_clear(&table)
    name.build_name(f, &table)
    sfnt.sfnt_add(&font, "name", &table)
    rt.buf_clear(&table)
    os2.build_os2(f, &set, &table)
    sfnt.sfnt_add(&font, "OS/2", &table)
    rt.buf_clear(&table)
    fgmetrics.build_post(f, &table)
    sfnt.sfnt_add(&font, "post", &table)
    rt.buf_clear(&table)
    if (flags & FLAG_KERN) != 0 as u32 && kern.build_kern(f, &table) {
        sfnt.sfnt_add(&font, "kern", &table)
    }
    rt.buf_clear(&table)
    if (flags & FLAG_GPOS) != 0 as u32 && gpos.build_gpos(f, &table) {
        sfnt.sfnt_add(&font, "GPOS", &table)
    }
    rt.buf_clear(&table)
    rt.buf_clear(out)
    sfnt.sfnt_assemble(&font, out)
    sfnt.sfnt_free(&font)
    rt.buf_free(&table)
    glyf.glyphset_free(&set)
    return true
}
