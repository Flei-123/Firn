import svg.path
import fontsrc.model

export { MAX_REF_DEPTH, append_glyph_path, glyph_ref_depth }

const MAX_REF_DEPTH: usize = 8

fn append_offset(dst: *mut path.Path, src: *mut path.Path, dx: f64, dy: f64) {
    let verbs: usize = path.path_verbs(src)
    var v: usize = 0
    var at: usize = 0
    while v < verbs {
        let kind: u32 = path.path_verb(src, v)
        if kind == path.V_ZUG {
            path.path_move(dst, path.path_px(src, at) + dx, path.path_py(src, at) + dy)
            at = at + 1
        } else if kind == path.V_LINE {
            path.path_line(dst, path.path_px(src, at) + dx, path.path_py(src, at) + dy)
            at = at + 1
        } else if kind == path.V_QUAD {
            path.path_quad(dst, path.path_px(src, at) + dx, path.path_py(src, at) + dy,
                path.path_px(src, at + 1) + dx, path.path_py(src, at + 1) + dy)
            at = at + 2
        } else if kind == path.V_CUBIC {
            path.path_cubic(dst, path.path_px(src, at) + dx, path.path_py(src, at) + dy,
                path.path_px(src, at + 1) + dx, path.path_py(src, at + 1) + dy,
                path.path_px(src, at + 2) + dx, path.path_py(src, at + 2) + dy)
            at = at + 3
        } else {
            path.path_too(dst)
        }
        v = v + 1
    }
}

fn append_glyph_path(f: *mut model.Font, g: *mut model.Glyph, dst: *mut path.Path, dx: f64, dy: f64, depth: usize) {
    append_offset(dst, &(*g).path, dx, dy)
    if depth >= MAX_REF_DEPTH {
        return
    }
    var r: usize = 0
    let n: usize = model.glyph_ref_count(g)
    while r < n {
        let ref: *mut model.Ref = model.glyph_ref_at(g, r)
        let target: *mut model.Glyph = model.font_find(f, (*ref).cp)
        if target as usize != 0 {
            append_glyph_path(f, target, dst, dx + (*ref).dx, dy + (*ref).dy, depth + 1)
        }
        r = r + 1
    }
}

fn glyph_ref_depth(f: *mut model.Font, g: *mut model.Glyph, depth: usize) -> usize {
    if depth >= MAX_REF_DEPTH || model.glyph_ref_count(g) == 0 {
        return 0
    }
    var best: usize = 0
    var r: usize = 0
    let n: usize = model.glyph_ref_count(g)
    while r < n {
        let target: *mut model.Glyph = model.font_find(f, (*model.glyph_ref_at(g, r)).cp)
        if target as usize != 0 {
            let d: usize = glyph_ref_depth(f, target, depth + 1) + 1
            if d > best {
                best = d
            }
        }
        r = r + 1
    }
    return best
}
