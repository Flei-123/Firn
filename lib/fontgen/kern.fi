import std.rt
import fontsrc.model
import fontgen.fgbytes
import fontgen.glyf

export { build_kern }

const MAX_PAIRS: usize = 10900

fn build_kern(f: *mut model.Font, out: *mut rt.Buf) -> bool {
    var body: rt.Buf = rt.buf_new()
    var pairs: u32 = 0
    var i: usize = 0
    let n: usize = model.font_kern_count(f)
    var records: rt.Buf = rt.buf_new()
    while i < n && (pairs as usize) < MAX_PAIRS {
        let k: *mut model.Kern = model.font_kern_at(f, i)
        let left: i64 = glyf.gid_of_cp(f, (*k).left)
        let right: i64 = glyf.gid_of_cp(f, (*k).right)
        if left >= 0 && right >= 0 && (*k).value != 0 {
            fgbytes.put16(&records, left as u32)
            fgbytes.put16(&records, right as u32)
            fgbytes.put_i16(&records, (*k).value)
            pairs = pairs + 1
        }
        i = i + 1
    }
    if pairs == 0 {
        rt.buf_free(&body)
        rt.buf_free(&records)
        return false
    }
    var pow: u32 = 0
    while (1 << (pow + 1)) <= pairs {
        pow = pow + 1
    }
    let search: u32 = 6 * (1 << pow)
    fgbytes.put16(out, 0)
    fgbytes.put16(out, 1)
    fgbytes.put16(out, 0)
    fgbytes.put16(out, 14 + 6 * pairs)
    fgbytes.put16(out, 1)
    fgbytes.put16(out, pairs)
    fgbytes.put16(out, search)
    fgbytes.put16(out, pow)
    fgbytes.put16(out, 6 * pairs - search)
    rt.buf_push_bytes(out, rt.buf_ptr(&records), rt.buf_len(&records))
    rt.buf_free(&body)
    rt.buf_free(&records)
    return true
}
