import std.rt
import fontsrc.model
import fontgen.fgbytes
import fontgen.glyf

export { build_hmtx, build_hhea, build_maxp, build_head, build_post, MAGIC, version_fixed, style_has }

const MAGIC: u32 = 1594834165
const HEAD_CREATED: u32 = 3850000000

fn build_hmtx(set: *mut glyf.GlyphSet, out: *mut rt.Buf) {
    var i: usize = 0
    let n: usize = glyf.glyphset_count(set)
    while i < n {
        let info: *mut glyf.GInfo = glyf.glyphset_info(set, i)
        fgbytes.put16(out, (*info).advance as u32)
        fgbytes.put_i16(out, (*info).xmin)
        i = i + 1
    }
}

fn build_hhea(f: *mut model.Font, set: *mut glyf.GlyphSet, out: *mut rt.Buf) {
    var advance_max: i64 = 0
    var min_lsb: i64 = 0
    var min_rsb: i64 = 0
    var max_extent: i64 = 0
    var first: bool = true
    var i: usize = 0
    let n: usize = glyf.glyphset_count(set)
    while i < n {
        let info: *mut glyf.GInfo = glyf.glyphset_info(set, i)
        if (*info).advance > advance_max {
            advance_max = (*info).advance
        }
        if (*info).contours > 0 || (*info).components > 0 {
            let rsb: i64 = (*info).advance - (*info).xmax
            if first || (*info).xmin < min_lsb {
                min_lsb = (*info).xmin
            }
            if first || rsb < min_rsb {
                min_rsb = rsb
            }
            if first || (*info).xmax > max_extent {
                max_extent = (*info).xmax
            }
            first = false
        }
        i = i + 1
    }
    fgbytes.put32(out, 65536 as u32)
    fgbytes.put_i16(out, (*f).ascender)
    fgbytes.put_i16(out, (*f).descender)
    fgbytes.put_i16(out, (*f).linegap)
    fgbytes.put16(out, advance_max as u32)
    fgbytes.put_i16(out, min_lsb)
    fgbytes.put_i16(out, min_rsb)
    fgbytes.put_i16(out, max_extent)
    fgbytes.put_i16(out, 1)
    fgbytes.put_i16(out, 0)
    fgbytes.put_i16(out, 0)
    fgbytes.put_zero(out, 8)
    fgbytes.put_i16(out, 0)
    fgbytes.put16(out, n as u32)
}

fn build_maxp(set: *mut glyf.GlyphSet, out: *mut rt.Buf) {
    var points: i64 = 0
    var contours: i64 = 0
    var comp_points: i64 = 0
    var comp_contours: i64 = 0
    var elements: i64 = 0
    var depth: i64 = 0
    var i: usize = 0
    let n: usize = glyf.glyphset_count(set)
    while i < n {
        let info: *mut glyf.GInfo = glyf.glyphset_info(set, i)
        if (*info).components > 0 {
            if (*info).points > comp_points {
                comp_points = (*info).points
            }
            if (*info).contours > comp_contours {
                comp_contours = (*info).contours
            }
            if (*info).components > elements {
                elements = (*info).components
            }
            if (*info).depth > depth {
                depth = (*info).depth
            }
        } else {
            if (*info).points > points {
                points = (*info).points
            }
            if (*info).contours > contours {
                contours = (*info).contours
            }
        }
        i = i + 1
    }
    fgbytes.put32(out, 65536 as u32)
    fgbytes.put16(out, n as u32)
    fgbytes.put16(out, points as u32)
    fgbytes.put16(out, contours as u32)
    fgbytes.put16(out, comp_points as u32)
    fgbytes.put16(out, comp_contours as u32)
    fgbytes.put16(out, 2)
    fgbytes.put16(out, 0)
    fgbytes.put16(out, 0)
    fgbytes.put16(out, 0)
    fgbytes.put16(out, 0)
    fgbytes.put16(out, 0)
    fgbytes.put16(out, 0)
    fgbytes.put16(out, elements as u32)
    fgbytes.put16(out, depth as u32)
}

fn version_fixed(s: str) -> u32 {
    var major: u32 = 0
    var i: usize = 0
    while i < s.n && rt.ld8(s.p as u64, i) >= 48 as u8 && rt.ld8(s.p as u64, i) <= 57 as u8 {
        major = major * 10 + (rt.ld8(s.p as u64, i) - 48 as u8) as u32
        i = i + 1
    }
    var frac: u32 = 0
    var scale: u32 = 1
    if i < s.n && rt.ld8(s.p as u64, i) == 46 as u8 {
        i = i + 1
        var digits: usize = 0
        while i < s.n && digits < 4 && rt.ld8(s.p as u64, i) >= 48 as u8 && rt.ld8(s.p as u64, i) <= 57 as u8 {
            frac = frac * 10 + (rt.ld8(s.p as u64, i) - 48 as u8) as u32
            scale = scale * 10
            i = i + 1
            digits = digits + 1
        }
    }
    return (major << 16) + frac * 65536 / scale
}

fn style_has(style: str, word: str) -> bool {
    if style.n < word.n {
        return false
    }
    var i: usize = 0
    while i + word.n <= style.n {
        if rt.mem_eq(style.p as u64 + i as u64, word.p as u64, word.n) {
            return true
        }
        i = i + 1
    }
    return false
}

fn build_head(f: *mut model.Font, set: *mut glyf.GlyphSet, long_loca: bool, out: *mut rt.Buf) {
    var xmin: i64 = 0
    var ymin: i64 = 0
    var xmax: i64 = 0
    var ymax: i64 = 0
    var first: bool = true
    var i: usize = 0
    let n: usize = glyf.glyphset_count(set)
    while i < n {
        let info: *mut glyf.GInfo = glyf.glyphset_info(set, i)
        if (*info).contours > 0 || (*info).components > 0 {
            if first || (*info).xmin < xmin {
                xmin = (*info).xmin
            }
            if first || (*info).ymin < ymin {
                ymin = (*info).ymin
            }
            if first || (*info).xmax > xmax {
                xmax = (*info).xmax
            }
            if first || (*info).ymax > ymax {
                ymax = (*info).ymax
            }
            first = false
        }
        i = i + 1
    }
    let style: str = model.text_str(&(*f).style)
    var mac: u32 = 0
    if style_has(style, "Bold") {
        mac = mac | 1
    }
    if style_has(style, "Italic") || style_has(style, "Oblique") {
        mac = mac | 2
    }
    fgbytes.put32(out, 65536 as u32)
    fgbytes.put32(out, version_fixed(model.text_str(&(*f).version)))
    fgbytes.put32(out, 0)
    fgbytes.put32(out, MAGIC)
    fgbytes.put16(out, 3)
    fgbytes.put16(out, (*f).upem as u32)
    fgbytes.put32(out, 0)
    fgbytes.put32(out, HEAD_CREATED)
    fgbytes.put32(out, 0)
    fgbytes.put32(out, HEAD_CREATED)
    fgbytes.put_i16(out, xmin)
    fgbytes.put_i16(out, ymin)
    fgbytes.put_i16(out, xmax)
    fgbytes.put_i16(out, ymax)
    fgbytes.put16(out, mac)
    fgbytes.put16(out, 8)
    fgbytes.put16(out, 2)
    if long_loca {
        fgbytes.put16(out, 1)
    } else {
        fgbytes.put16(out, 0)
    }
    fgbytes.put16(out, 0)
}

fn build_post(f: *mut model.Font, out: *mut rt.Buf) {
    fgbytes.put32(out, 196608 as u32)
    fgbytes.put32(out, 0)
    fgbytes.put_i16(out, 0 - (*f).upem / 10)
    fgbytes.put_i16(out, (*f).upem / 20)
    fgbytes.put32(out, 0)
    fgbytes.put_zero(out, 16)
}
