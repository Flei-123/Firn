import std.vec
import svg.path
import bezier.pathquad
import fontgen.fgbytes

export {
    Pt, Outline,
    outline_new, outline_free, outline_from_path,
    outline_point_count, outline_contour_count, outline_pt, outline_end,
}

struct Pt {
    x: i64,
    y: i64,
    on: bool,
}

struct Outline {
    pts: vec.Vec[Pt],
    ends: vec.Vec[u32],
    xmin: i64,
    ymin: i64,
    xmax: i64,
    ymax: i64,
}

fn outline_new() -> Outline {
    return Outline {
        pts: vec.vec_new[Pt](),
        ends: vec.vec_new[u32](),
        xmin: 0,
        ymin: 0,
        xmax: 0,
        ymax: 0,
    }
}

fn outline_free(o: *mut Outline) {
    vec.vec_free[Pt](&(*o).pts)
    vec.vec_free[u32](&(*o).ends)
}

fn outline_point_count(o: *mut Outline) -> usize {
    return vec.vec_len[Pt](&(*o).pts)
}

fn outline_contour_count(o: *mut Outline) -> usize {
    return vec.vec_len[u32](&(*o).ends)
}

fn outline_pt(o: *mut Outline, i: usize) -> *mut Pt {
    return vec.vec_elem_ptr[Pt](&(*o).pts, i)
}

fn outline_end(o: *mut Outline, c: usize) -> usize {
    return (*vec.vec_elem_ptr[u32](&(*o).ends, c)) as usize
}

fn contour_start(o: *mut Outline, c: usize) -> usize {
    if c == 0 {
        return 0
    }
    return outline_end(o, c - 1) + 1
}

fn push_pt(o: *mut Outline, x: f64, y: f64, on: bool) {
    vec.vec_push[Pt](&(*o).pts, Pt { x: fgbytes.round_i64(x), y: fgbytes.round_i64(y), on: on })
}

fn close_contour(o: *mut Outline, start: usize) {
    var n: usize = outline_point_count(o)
    if n - start >= 2 {
        let first: *mut Pt = outline_pt(o, start)
        let last: *mut Pt = outline_pt(o, n - 1)
        if (*last).on && (*first).x == (*last).x && (*first).y == (*last).y {
            vec.vec_shorten[Pt](&(*o).pts, n - 1)
            n = n - 1
        }
    }
    if n - start < 3 {
        vec.vec_shorten[Pt](&(*o).pts, start)
        return
    }
    vec.vec_push[u32](&(*o).ends, (n - 1) as u32)
}

fn reverse_contour(o: *mut Outline, c: usize) {
    var i: usize = contour_start(o, c)
    var j: usize = outline_end(o, c)
    while i < j {
        let tmp: Pt = *outline_pt(o, i)
        *outline_pt(o, i) = *outline_pt(o, j)
        *outline_pt(o, j) = tmp
        i = i + 1
        j = j - 1
    }
}

fn orient(o: *mut Outline) {
    let n: usize = outline_contour_count(o)
    var c: usize = 0
    while c < n {
        reverse_contour(o, c)
        c = c + 1
    }
}

fn midpoint_on(a: *mut Pt, mid: *mut Pt, b: *mut Pt) -> bool {
    return (*mid).on && !(*a).on && !(*b).on && (*a).x + (*b).x == 2 * (*mid).x && (*a).y + (*b).y == 2 * (*mid).y
}

fn compress(o: *mut Outline) {
    var out: vec.Vec[Pt] = vec.vec_new[Pt]()
    var ends: vec.Vec[u32] = vec.vec_new[u32]()
    let n: usize = outline_contour_count(o)
    var c: usize = 0
    while c < n {
        let a: usize = contour_start(o, c)
        let b: usize = outline_end(o, c)
        let count: usize = b - a + 1
        let before: usize = vec.vec_len[Pt](&out)
        var i: usize = 0
        while i < count {
            let prev: *mut Pt = outline_pt(o, a + (i + count - 1) % count)
            let cur: *mut Pt = outline_pt(o, a + i)
            let next: *mut Pt = outline_pt(o, a + (i + 1) % count)
            if !midpoint_on(prev, cur, next) {
                vec.vec_push[Pt](&out, *cur)
            }
            i = i + 1
        }
        if vec.vec_len[Pt](&out) - before >= 3 {
            vec.vec_push[u32](&ends, (vec.vec_len[Pt](&out) - 1) as u32)
        } else {
            vec.vec_shorten[Pt](&out, before)
        }
        c = c + 1
    }
    vec.vec_free[Pt](&(*o).pts)
    vec.vec_free[u32](&(*o).ends)
    (*o).pts = out
    (*o).ends = ends
}

fn measure(o: *mut Outline) {
    let n: usize = outline_point_count(o)
    (*o).xmin = 0
    (*o).ymin = 0
    (*o).xmax = 0
    (*o).ymax = 0
    var i: usize = 0
    while i < n {
        let p: *mut Pt = outline_pt(o, i)
        if i == 0 || (*p).x < (*o).xmin {
            (*o).xmin = (*p).x
        }
        if i == 0 || (*p).y < (*o).ymin {
            (*o).ymin = (*p).y
        }
        if i == 0 || (*p).x > (*o).xmax {
            (*o).xmax = (*p).x
        }
        if i == 0 || (*p).y > (*o).ymax {
            (*o).ymax = (*p).y
        }
        i = i + 1
    }
}

fn outline_from_path(src: *mut path.Path, o: *mut Outline, tolerance: f64) {
    var quads: path.Path = path.path_new()
    pathquad.path_to_quads(src, &quads, tolerance)
    let verbs: usize = path.path_verbs(&quads)
    var v: usize = 0
    var at: usize = 0
    var start: usize = 0
    var open: bool = false
    while v < verbs {
        let kind: u32 = path.path_verb(&quads, v)
        if kind == path.V_ZUG {
            if open {
                close_contour(o, start)
            }
            start = outline_point_count(o)
            push_pt(o, path.path_px(&quads, at), path.path_py(&quads, at), true)
            at = at + 1
            open = true
        } else if kind == path.V_LINE {
            push_pt(o, path.path_px(&quads, at), path.path_py(&quads, at), true)
            at = at + 1
        } else if kind == path.V_QUAD {
            push_pt(o, path.path_px(&quads, at), path.path_py(&quads, at), false)
            push_pt(o, path.path_px(&quads, at + 1), path.path_py(&quads, at + 1), true)
            at = at + 2
        } else {
            if open {
                close_contour(o, start)
            }
            open = false
        }
        v = v + 1
    }
    if open {
        close_contour(o, start)
    }
    path.path_free(&quads)
    orient(o)
    compress(o)
    measure(o)
}
