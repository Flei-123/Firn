import std.rt
import std.deflate
import fontgen.fgbytes
import fontgen.sfntdir

export { build_woff }

const HEADER_SIZE: usize = 44
const ENTRY_SIZE: usize = 20
const COMPRESS_LEVEL: usize = 9

fn padded(n: usize) -> usize {
    return ((n + 3) / 4) * 4
}

fn compress_table(src: u64, n: usize, out: *mut rt.Buf) -> bool {
    rt.buf_clear(out)
    let written: usize = deflate.zlib_compress(src, n, COMPRESS_LEVEL, out) catch 0
    return written != 0 && written < n
}

fn build_woff(sfnt: *mut rt.Buf, out: *mut rt.Buf) -> bool {
    if !sfntdir.dir_valid(sfnt) {
        return false
    }
    let count: usize = sfntdir.dir_count(sfnt)
    var blobs: rt.Buf = rt.buf_new()
    var scratch: rt.Buf = rt.buf_new()
    var entries: rt.Buf = rt.buf_new()
    var offset: usize = HEADER_SIZE + ENTRY_SIZE * count
    var sfnt_size: usize = 12 + 16 * count
    var i: usize = 0
    while i < count {
        let length: usize = sfntdir.dir_length(sfnt, i)
        let src: u64 = rt.buf_ptr(sfnt) + sfntdir.dir_offset(sfnt, i) as u64
        var stored: usize = length
        if compress_table(src, length, &scratch) {
            stored = rt.buf_len(&scratch)
            rt.buf_push_bytes(&blobs, rt.buf_ptr(&scratch), stored)
        } else {
            rt.buf_push_bytes(&blobs, src, length)
        }
        fgbytes.put_pad4(&blobs)
        fgbytes.put32(&entries, sfntdir.dir_tag(sfnt, i))
        fgbytes.put32(&entries, offset as u32)
        fgbytes.put32(&entries, stored as u32)
        fgbytes.put32(&entries, length as u32)
        fgbytes.put32(&entries, sfntdir.dir_checksum(sfnt, i))
        offset = offset + padded(stored)
        sfnt_size = sfnt_size + padded(length)
        i = i + 1
    }
    rt.buf_clear(out)
    fgbytes.put_tag(out, "wOFF")
    fgbytes.put32(out, sfntdir.dir_flavor(sfnt))
    fgbytes.put32(out, offset as u32)
    fgbytes.put16(out, count as u32)
    fgbytes.put16(out, 0)
    fgbytes.put32(out, sfnt_size as u32)
    fgbytes.put16(out, 1)
    fgbytes.put16(out, 0)
    fgbytes.put_zero(out, 20)
    rt.buf_push_bytes(out, rt.buf_ptr(&entries), rt.buf_len(&entries))
    rt.buf_push_bytes(out, rt.buf_ptr(&blobs), rt.buf_len(&blobs))
    rt.buf_free(&blobs)
    rt.buf_free(&scratch)
    rt.buf_free(&entries)
    return true
}
