import std.rt
import fontsrc.model
import fontsrc.cursor
import fontgen.fgbytes

export { build_name, push_utf16 }

const OFL_ID: str = "OFL-1.1"
const OFL_NOTICE: str = "This Font Software is licensed under the SIL Open Font License, Version 1.1. This license is available with a FAQ at: https://openfontlicense.org"
const OFL_URL: str = "https://openfontlicense.org"

struct NameRecord {
    id: u32,
    offset: u32,
    length: u32,
}

fn utf8_next(s: str, at: *mut usize) -> u32 {
    let b0: u32 = rt.ld8(s.p as u64, *at) as u32
    var need: usize = 0
    var cp: u32 = b0
    if b0 >= 240 as u32 {
        need = 3
        cp = b0 & 7 as u32
    } else if b0 >= 224 as u32 {
        need = 2
        cp = b0 & 15 as u32
    } else if b0 >= 192 as u32 {
        need = 1
        cp = b0 & 31 as u32
    }
    *at = *at + 1
    var k: usize = 0
    while k < need && *at < s.n {
        cp = (cp << 6) | ((rt.ld8(s.p as u64, *at) as u32) & 63 as u32)
        *at = *at + 1
        k = k + 1
    }
    return cp
}

fn push_utf16(out: *mut rt.Buf, s: str) {
    var at: usize = 0
    while at < s.n {
        let cp: u32 = utf8_next(s, &at)
        if cp >= 65536 as u32 {
            let v: u32 = cp - 65536 as u32
            fgbytes.put16(out, 55296 as u32 + (v >> 10))
            fgbytes.put16(out, 56320 as u32 + (v & 1023 as u32))
        } else {
            fgbytes.put16(out, cp)
        }
    }
}

fn strip_spaces(out: *mut rt.Buf, s: str) {
    var i: usize = 0
    while i < s.n {
        let c: u8 = rt.ld8(s.p as u64, i)
        if c != 32 as u8 {
            rt.buf_push(out, c)
        }
        i = i + 1
    }
}

fn add_record(strings: *mut rt.Buf, records: *mut rt.Buf, count: *mut u32, id: u32, text: *mut rt.Buf) {
    if rt.buf_len(text) == 0 {
        return
    }
    let start: usize = rt.buf_len(strings)
    push_utf16(strings, model.text_str(text))
    fgbytes.put16(records, 3)
    fgbytes.put16(records, 1)
    fgbytes.put16(records, 1033)
    fgbytes.put16(records, id)
    fgbytes.put16(records, (rt.buf_len(strings) - start) as u32)
    fgbytes.put16(records, start as u32)
    *count = *count + 1
}

fn build_name(f: *mut model.Font, out: *mut rt.Buf) {
    var family: rt.Buf = rt.buf_new()
    var style: rt.Buf = rt.buf_new()
    if rt.buf_len(&(*f).family) == 0 {
        cursor.push_text(&family, "Untitled")
    } else {
        cursor.push_text(&family, model.text_str(&(*f).family))
    }
    if rt.buf_len(&(*f).style) == 0 {
        cursor.push_text(&style, "Regular")
    } else {
        cursor.push_text(&style, model.text_str(&(*f).style))
    }
    var unique: rt.Buf = rt.buf_new()
    cursor.push_text(&unique, model.text_str(&family))
    cursor.push_text(&unique, ";")
    cursor.push_text(&unique, model.text_str(&(*f).version))
    cursor.push_text(&unique, ";")
    cursor.push_text(&unique, model.text_str(&style))
    var full: rt.Buf = rt.buf_new()
    cursor.push_text(&full, model.text_str(&family))
    cursor.push_text(&full, " ")
    cursor.push_text(&full, model.text_str(&style))
    var version: rt.Buf = rt.buf_new()
    if rt.buf_len(&(*f).version) > 0 {
        cursor.push_text(&version, "Version ")
        cursor.push_text(&version, model.text_str(&(*f).version))
    }
    var postscript: rt.Buf = rt.buf_new()
    strip_spaces(&postscript, model.text_str(&family))
    cursor.push_text(&postscript, "-")
    strip_spaces(&postscript, model.text_str(&style))
    var license_text: rt.Buf = rt.buf_new()
    var license_url: rt.Buf = rt.buf_new()
    if cursor.str_eq(model.text_str(&(*f).license), OFL_ID) {
        cursor.push_text(&license_text, OFL_NOTICE)
        cursor.push_text(&license_url, OFL_URL)
    } else {
        cursor.push_text(&license_text, model.text_str(&(*f).license))
    }
    var strings: rt.Buf = rt.buf_new()
    var records: rt.Buf = rt.buf_new()
    var count: u32 = 0
    add_record(&strings, &records, &count, 0 as u32, &(*f).copyright)
    add_record(&strings, &records, &count, 1 as u32, &family)
    add_record(&strings, &records, &count, 2 as u32, &style)
    add_record(&strings, &records, &count, 3 as u32, &unique)
    add_record(&strings, &records, &count, 4 as u32, &full)
    add_record(&strings, &records, &count, 5 as u32, &version)
    add_record(&strings, &records, &count, 6 as u32, &postscript)
    add_record(&strings, &records, &count, 13 as u32, &license_text)
    add_record(&strings, &records, &count, 14 as u32, &license_url)
    fgbytes.put16(out, 0)
    fgbytes.put16(out, count)
    fgbytes.put16(out, 6 + 12 * count)
    rt.buf_push_bytes(out, rt.buf_ptr(&records), rt.buf_len(&records))
    rt.buf_push_bytes(out, rt.buf_ptr(&strings), rt.buf_len(&strings))
    rt.buf_free(&family)
    rt.buf_free(&style)
    rt.buf_free(&unique)
    rt.buf_free(&full)
    rt.buf_free(&version)
    rt.buf_free(&postscript)
    rt.buf_free(&license_text)
    rt.buf_free(&license_url)
    rt.buf_free(&strings)
    rt.buf_free(&records)
}
