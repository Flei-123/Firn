import std.rt

export {
    put8, put16, put32, put_i16, put_tag, put_zero, put_pad4,
    patch32, get32, checksum, round_i64,
}

fn put8(b: *mut rt.Buf, v: u32) {
    rt.buf_push(b, (v & 255 as u32) as u8)
}

fn put16(b: *mut rt.Buf, v: u32) {
    put8(b, v >> 8)
    put8(b, v)
}

fn put32(b: *mut rt.Buf, v: u32) {
    put16(b, v >> 16)
    put16(b, v)
}

fn put_i16(b: *mut rt.Buf, v: i64) {
    put16(b, ((v + 65536) % 65536) as u32)
}

fn put_tag(b: *mut rt.Buf, tag: str) {
    var i: usize = 0
    while i < 4 {
        rt.buf_push(b, rt.ld8(tag.p as u64, i))
        i = i + 1
    }
}

fn put_zero(b: *mut rt.Buf, n: usize) {
    var i: usize = 0
    while i < n {
        rt.buf_push(b, 0 as u8)
        i = i + 1
    }
}

fn put_pad4(b: *mut rt.Buf) {
    while rt.buf_len(b) % 4 != 0 {
        rt.buf_push(b, 0 as u8)
    }
}

fn patch32(b: *mut rt.Buf, at: usize, v: u32) {
    let p: u64 = rt.buf_ptr(b)
    rt.st8(p, at, ((v >> 24) & 255 as u32) as u8)
    rt.st8(p, at + 1, ((v >> 16) & 255 as u32) as u8)
    rt.st8(p, at + 2, ((v >> 8) & 255 as u32) as u8)
    rt.st8(p, at + 3, (v & 255 as u32) as u8)
}

fn get32(b: *mut rt.Buf, at: usize) -> u32 {
    let p: u64 = rt.buf_ptr(b)
    return ((rt.ld8(p, at) as u32) << 24) | ((rt.ld8(p, at + 1) as u32) << 16) | ((rt.ld8(p, at + 2) as u32) << 8) | (rt.ld8(p, at + 3) as u32)
}

fn checksum(p: u64, n: usize) -> u32 {
    var sum: u64 = 0
    var i: usize = 0
    while i < n {
        var word: u64 = 0
        var k: usize = 0
        while k < 4 {
            word = word << 8
            if i + k < n {
                word = word | (rt.ld8(p, i + k) as u64)
            }
            k = k + 1
        }
        sum = (sum + word) & 4294967295
        i = i + 4
    }
    return sum as u32
}

fn round_i64(x: f64) -> i64 {
    if x < 0.0 {
        return (x - 0.5) as i64
    }
    return (x + 0.5) as i64
}
