import std.rt
import fontsrc.model
import fontgen.fgbytes
import fontgen.glyf
import fontgen.fgmetrics

export { build_os2 }

fn unicode_range1(f: *mut model.Font) -> u32 {
    var bits: u32 = 0
    var i: usize = 0
    let n: usize = model.font_glyph_count(f)
    while i < n {
        let cp: u32 = (*model.font_glyph_at(f, i)).cp
        if cp >= 32 as u32 && cp < 128 as u32 {
            bits = bits | 1
        } else if cp >= 128 as u32 && cp < 256 as u32 {
            bits = bits | 2
        } else if cp >= 256 as u32 && cp < 384 as u32 {
            bits = bits | 4
        } else if cp >= 384 as u32 && cp < 592 as u32 {
            bits = bits | 8
        }
        i = i + 1
    }
    return bits
}

fn build_os2(f: *mut model.Font, set: *mut glyf.GlyphSet, out: *mut rt.Buf) {
    var total_advance: i64 = 0
    var counted: i64 = 0
    var ymin: i64 = 0
    var ymax: i64 = 0
    var i: usize = 1
    let n: usize = glyf.glyphset_count(set)
    while i < n {
        let info: *mut glyf.GInfo = glyf.glyphset_info(set, i)
        if (*info).advance > 0 {
            total_advance = total_advance + (*info).advance
            counted = counted + 1
        }
        if (*info).ymin < ymin {
            ymin = (*info).ymin
        }
        if (*info).ymax > ymax {
            ymax = (*info).ymax
        }
        i = i + 1
    }
    var avg: i64 = (*f).upem / 2
    if counted > 0 {
        avg = total_advance / counted
    }
    let style: str = model.text_str(&(*f).style)
    var weight: u32 = 400
    var selection: u32 = 192
    if fgmetrics.style_has(style, "Bold") {
        weight = 700
        selection = (selection & 0xFFBF as u32) | 32
    }
    if fgmetrics.style_has(style, "Italic") || fgmetrics.style_has(style, "Oblique") {
        selection = (selection & 0xFFBF as u32) | 1
    }
    var first: u32 = 65535
    var last: u32 = 0
    if model.font_glyph_count(f) > 0 {
        first = (*model.font_glyph_at(f, 0)).cp
        last = (*model.font_glyph_at(f, model.font_glyph_count(f) - 1)).cp
        if first > 65535 as u32 {
            first = 65535
        }
        if last > 65535 as u32 {
            last = 65535
        }
    }
    var win_ascent: i64 = (*f).ascender
    if ymax > win_ascent {
        win_ascent = ymax
    }
    var win_descent: i64 = 0 - (*f).descender
    if 0 - ymin > win_descent {
        win_descent = 0 - ymin
    }
    let upem: i64 = (*f).upem
    fgbytes.put16(out, 4)
    fgbytes.put_i16(out, avg)
    fgbytes.put16(out, weight)
    fgbytes.put16(out, 5)
    fgbytes.put16(out, 0)
    fgbytes.put_i16(out, upem * 7 / 10)
    fgbytes.put_i16(out, upem * 65 / 100)
    fgbytes.put_i16(out, 0)
    fgbytes.put_i16(out, upem * 14 / 100)
    fgbytes.put_i16(out, upem * 7 / 10)
    fgbytes.put_i16(out, upem * 65 / 100)
    fgbytes.put_i16(out, 0)
    fgbytes.put_i16(out, upem * 48 / 100)
    fgbytes.put_i16(out, upem / 20)
    fgbytes.put_i16(out, upem * 26 / 100)
    fgbytes.put_i16(out, 0)
    fgbytes.put_zero(out, 10)
    fgbytes.put32(out, unicode_range1(f))
    fgbytes.put32(out, 0)
    fgbytes.put32(out, 0)
    fgbytes.put32(out, 0)
    fgbytes.put_tag(out, "FFNT")
    fgbytes.put16(out, selection)
    fgbytes.put16(out, first)
    fgbytes.put16(out, last)
    fgbytes.put_i16(out, (*f).ascender)
    fgbytes.put_i16(out, (*f).descender)
    fgbytes.put_i16(out, (*f).linegap)
    fgbytes.put16(out, win_ascent as u32)
    fgbytes.put16(out, win_descent as u32)
    fgbytes.put32(out, 1)
    fgbytes.put32(out, 0)
    fgbytes.put_i16(out, (*f).xheight)
    fgbytes.put_i16(out, (*f).capheight)
    fgbytes.put16(out, 0)
    fgbytes.put16(out, 32)
    fgbytes.put16(out, 2)
}
