// SPDX-License-Identifier: MPL-2.0
// lib/str/grapheme.fi -- extended grapheme clusters (UAX #29, Unicode 17.0).
//
// The table is `generated/grapheme_tables.fi`, made by `python3 tools/grapheme/gen.py`
// out of GraphemeBreakProperty.txt, emoji-data.txt (Extended_Pictographic) and
// DerivedCoreProperties.txt (InCB). Sorted ranges, one binary search per code point.
//
//   gb_map() -> table        0 = allocation failed (every lookup then says "Other")
//   gb_free(t)
//   gb_class(t, cp)          Grapheme_Cluster_Break: GB_OTHER .. GB_LVT
//   gb_ext_pict(t, cp)       Extended_Pictographic
//   gb_incb(t, cp)           0 None, 1 Consonant, 2 Linker, 3 Extend
//   gb_next(t, p, n, i)      octets of the cluster that starts at octet `i` of the UTF-8 text
//                            at `p` (n octets); 0 if i >= n. Malformed octets are one U+FFFD each.
//   gb_count(t, p, n)        number of clusters
//   gb_decode(p, n, i, &len) one code point (shared by the font code)
//
// Rules: GB3 CR x LF, GB4/5 controls, GB6-8 Hangul, GB9 x Extend/ZWJ, GB9a x SpacingMark,
// GB9b Prepend x, GB9c Indic conjuncts (InCB), GB11 emoji ZWJ sequences, GB12/13 flags
// (pairs of Regional Indicators). Tailoring (locale) is NOT done; no word/sentence/line breaks.
import rt.rt
import generated.grapheme_tables

export {
    gb_map, gb_free, gb_class, gb_ext_pict, gb_incb, gb_next, gb_count, gb_decode,
    GB_OTHER, GB_CR, GB_LF, GB_CONTROL, GB_EXTEND, GB_ZWJ, GB_RI, GB_PREPEND,
    GB_SPACINGMARK, GB_L, GB_V, GB_T, GB_LV, GB_LVT,
}

const GB_OTHER: u32 = 0
const GB_CR: u32 = 1
const GB_LF: u32 = 2
const GB_CONTROL: u32 = 3
const GB_EXTEND: u32 = 4
const GB_ZWJ: u32 = 5
const GB_RI: u32 = 6
const GB_PREPEND: u32 = 7
const GB_SPACINGMARK: u32 = 8
const GB_L: u32 = 9
const GB_V: u32 = 10
const GB_T: u32 = 11
const GB_LV: u32 = 12
const GB_LVT: u32 = 13

fn gb_map() -> u64 {
    let t: u64 = rt.heap_alloc(grapheme_tables.BYTES)
    if t == 0 {
        return 0
    }
    grapheme_tables.load(t as *mut u8)
    return t
}

fn gb_free(t: u64) {
    if t != 0 {
        rt.heap_free(t, grapheme_tables.BYTES)
    }
}

// Packed value: bits 0..3 class, 4..5 InCB, bit 6 Extended_Pictographic.
fn gb_value(t: u64, cp: u32) -> u32 {
    if t == 0 {
        return 0 as u32
    }
    let c: u64 = cp as u64
    var lo: usize = 0
    var hi: usize = grapheme_tables.RANGES
    while lo < hi {
        let mid: usize = (lo + hi) / 2
        let r: u64 = rt.ld64(t, mid)
        let first: u64 = r & 0x1FFFFF
        let last: u64 = (r >> 21) & 0x1FFFFF
        if c < first {
            hi = mid
        } else if c > last {
            lo = mid + 1
        } else {
            return ((r >> 42) & 127) as u32
        }
    }
    return 0 as u32
}

fn gb_class(t: u64, cp: u32) -> u32 {
    return gb_value(t, cp) & 15 as u32
}

fn gb_ext_pict(t: u64, cp: u32) -> bool {
    return (gb_value(t, cp) & 64 as u32) != 0 as u32
}

fn gb_incb(t: u64, cp: u32) -> u32 {
    return (gb_value(t, cp) >> 4 as u32) & 3 as u32
}

// Strict UTF-8 (no overlongs, no surrogates, <= U+10FFFF); anything else is U+FFFD, one octet.
fn gb_decode(p: u64, n: usize, i: usize, len: *mut usize) -> u32 {
    let b0: u32 = rt.ld8(p, i) as u32
    *len = 1
    if b0 < 128 as u32 {
        return b0
    }
    var need: usize = 0
    var cp: u32 = 0
    var minv: u32 = 0
    if b0 >= 194 as u32 && b0 < 224 as u32 {
        need = 1
        cp = b0 & 31 as u32
        minv = 128 as u32
    } else if b0 >= 224 as u32 && b0 < 240 as u32 {
        need = 2
        cp = b0 & 15 as u32
        minv = 2048 as u32
    } else if b0 >= 240 as u32 && b0 < 245 as u32 {
        need = 3
        cp = b0 & 7 as u32
        minv = 65536 as u32
    } else {
        return 65533 as u32
    }
    if i + need >= n {
        return 65533 as u32
    }
    var k: usize = 1
    while k <= need {
        let b: u32 = rt.ld8(p, i + k) as u32
        if (b & 192 as u32) != 128 as u32 {
            return 65533 as u32
        }
        cp = (cp << 6 as u32) | (b & 63 as u32)
        k = k + 1
    }
    if cp < minv || cp > 1114111 as u32 || (cp >= 55296 as u32 && cp < 57344 as u32) {
        return 65533 as u32
    }
    *len = need + 1
    return cp
}

fn is_ctl(c: u32) -> bool {
    return c == GB_CR || c == GB_LF || c == GB_CONTROL
}

fn gb_next(t: u64, p: u64, n: usize, i: usize) -> usize {
    if i >= n {
        return 0
    }
    var l: usize = 1
    let first: u32 = gb_decode(p, n, i, &l)
    var j: usize = i + l
    let v0: u32 = gb_value(t, first)
    var pc: u32 = v0 & 15 as u32
    var ri: u32 = 0 as u32
    if pc == GB_RI {
        ri = 1 as u32
    }
    // 0 none, 1 ExtPict Extend*, 2 ExtPict Extend* ZWJ
    var pict: u32 = 0 as u32
    if (v0 & 64 as u32) != 0 as u32 {
        pict = 1 as u32
    }
    // 0 none, 1 Consonant [Extend Linker]*, 2 ... Linker [Extend Linker]*
    var incb: u32 = 0 as u32
    if ((v0 >> 4 as u32) & 3 as u32) == 1 as u32 {
        incb = 1 as u32
    }
    while j < n {
        var l2: usize = 1
        let nc: u32 = gb_decode(p, n, j, &l2)
        let nv: u32 = gb_value(t, nc)
        let cls: u32 = nv & 15 as u32
        let ib: u32 = (nv >> 4 as u32) & 3 as u32
        let ep: bool = (nv & 64 as u32) != 0 as u32
        var join: bool = false
        if pc == GB_CR && cls == GB_LF {
            join = true
        } else if is_ctl(pc) || is_ctl(cls) {
            join = false
        } else if pc == GB_L && (cls == GB_L || cls == GB_V || cls == GB_LV || cls == GB_LVT) {
            join = true
        } else if (pc == GB_LV || pc == GB_V) && (cls == GB_V || cls == GB_T) {
            join = true
        } else if (pc == GB_LVT || pc == GB_T) && cls == GB_T {
            join = true
        } else if cls == GB_EXTEND || cls == GB_ZWJ || cls == GB_SPACINGMARK || pc == GB_PREPEND {
            join = true
        } else if incb == 2 as u32 && ib == 1 as u32 {
            join = true
        } else if pict == 2 as u32 && ep {
            join = true
        } else if pc == GB_RI && cls == GB_RI && (ri & 1 as u32) == 1 as u32 {
            join = true
        }
        if !join {
            break
        }
        if ep {
            pict = 1 as u32
        } else if cls == GB_EXTEND && pict == 1 as u32 {
            pict = 1 as u32
        } else if cls == GB_ZWJ && pict == 1 as u32 {
            pict = 2 as u32
        } else {
            pict = 0 as u32
        }
        if ib == 1 as u32 {
            incb = 1 as u32
        } else if ib == 2 as u32 {
            if incb >= 1 as u32 {
                incb = 2 as u32
            } else {
                incb = 0 as u32
            }
        } else if ib != 3 as u32 {
            incb = 0 as u32
        }
        if cls == GB_RI {
            ri = ri + 1 as u32
        } else {
            ri = 0 as u32
        }
        pc = cls
        j = j + l2
    }
    return j - i
}

fn gb_count(t: u64, p: u64, n: usize) -> usize {
    var c: usize = 0
    var i: usize = 0
    while i < n {
        i = i + gb_next(t, p, n, i)
        c = c + 1
    }
    return c
}
