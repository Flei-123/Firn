// lib/str/ucd.fi -- the way into the generated Unicode table.
//
// The table itself is `generated/unicode_tables.fi`, produced by
// `bash tools/ucd/build.sh` out of the Unicode Character Database
// (ACCEPTANCE item 6). This file is written by hand and holds the three
// loads of a lookup, nothing else.
//
// Stage 0 has no global variables (SPEC 14.1 item 5), so the pointer to the
// mapped area is handed around -- exactly the way the character reference
// table of the HTML tokenizer is handed around in `tokens.Sink`
// (`lib/html/entities.fi`). `ucd_map()` maps and fills it once; a null
// pointer means "the mapping failed", and every lookup then answers as if
// the code point were unassigned instead of reading from address zero.
//
// The mapping is done with `mmap` WITHOUT `MAP_FIXED`: the kernel picks the
// address, and nothing in this file assumes anything about the memory image
// of the process.
import generated.unicode_tables
import rt.rt

export {
    ucd_map, ucd_free, ucd_bytes,
    ucd_class, ucd_category, ucd_is_id_start, ucd_is_id_continue,
    ucd_to_upper, ucd_to_lower,
    CAT_CN, CAT_LU, CAT_LL, CAT_LT, CAT_LM, CAT_LO, CAT_MN, CAT_MC, CAT_ME,
    CAT_ND, CAT_NL, CAT_NO, CAT_PC, CAT_PD, CAT_PS, CAT_PE, CAT_PI, CAT_PF,
    CAT_PO, CAT_SM, CAT_SC, CAT_SK, CAT_SO, CAT_ZS, CAT_ZL, CAT_ZP, CAT_CC,
    CAT_CF, CAT_CS, CAT_CO,
}

const SYS_MMAP: i64 = 9
const SYS_MUNMAP: i64 = 11
const PROT_READ_WRITE: i64 = 3
// MAP_PRIVATE|MAP_ANONYMOUS -- expressly WITHOUT MAP_FIXED.
const MAP_FLAGS: i64 = 0x22

const CAT_CN: u8 = 0
const CAT_LU: u8 = 1
const CAT_LL: u8 = 2
const CAT_LT: u8 = 3
const CAT_LM: u8 = 4
const CAT_LO: u8 = 5
const CAT_MN: u8 = 6
const CAT_MC: u8 = 7
const CAT_ME: u8 = 8
const CAT_ND: u8 = 9
const CAT_NL: u8 = 10
const CAT_NO: u8 = 11
const CAT_PC: u8 = 12
const CAT_PD: u8 = 13
const CAT_PS: u8 = 14
const CAT_PE: u8 = 15
const CAT_PI: u8 = 16
const CAT_PF: u8 = 17
const CAT_PO: u8 = 18
const CAT_SM: u8 = 19
const CAT_SC: u8 = 20
const CAT_SK: u8 = 21
const CAT_SO: u8 = 22
const CAT_ZS: u8 = 23
const CAT_ZL: u8 = 24
const CAT_ZP: u8 = 25
const CAT_CC: u8 = 26
const CAT_CF: u8 = 27
const CAT_CS: u8 = 28
const CAT_CO: u8 = 29

const MAX_CP: u32 = 0x110000

// The size of the table in octets -- the number ACCEPTANCE item 6 asks to
// have documented.
fn ucd_bytes() -> usize {
    return unicode_tables.BYTES
}

// Maps the table and fills it. Returns 0 if the mapping failed; every
// lookup then answers "unassigned" instead of reading from a null pointer.
fn ucd_map() -> u64 {
    let r: i64 = syscall(SYS_MMAP, 0, unicode_tables.BYTES as i64,
        PROT_READ_WRITE, MAP_FLAGS, 0 - 1, 0)
    if r <= 0 {
        return 0
    }
    unicode_tables.load(r as *mut u8)
    return r as u64
}

fn ucd_free(t: u64) {
    if t == 0 {
        return
    }
    syscall(SYS_MUNMAP, t as i64, unicode_tables.BYTES as i64, 0, 0, 0, 0)
}

// THE LOOKUP: three loads, no loop.
fn ucd_class(t: u64, cp: u32) -> u8 {
    if t == 0 {
        return 0 as u8
    }
    if cp >= MAX_CP {
        return 0 as u8
    }
    let c: usize = cp as usize
    let b2: usize = rt.ld8(t, unicode_tables.OFF_L1 + (c >> 9)) as usize
    let b3: usize = rt.ld16(t + unicode_tables.OFF_L2 as u64,
        b2 * 32 + ((c >> 4) & 31)) as usize
    return rt.ld8(t, unicode_tables.OFF_L3 + b3 * 16 + (c & 15))
}

fn ucd_category(t: u64, cp: u32) -> u8 {
    return ucd_class(t, cp) & 31 as u8
}

fn ucd_is_id_start(t: u64, cp: u32) -> bool {
    return (ucd_class(t, cp) & 32 as u8) != 0 as u8
}

fn ucd_is_id_continue(t: u64, cp: u32) -> bool {
    return (ucd_class(t, cp) & 64 as u8) != 0 as u8
}

// One run of the case table: lo, hi, the stride and the delta.
fn case_at(t: u64, base: usize, k: usize) -> u64 {
    return rt.ld64(t + base as u64, k)
}

fn case_lookup(t: u64, idx_off: usize, run_off: usize, runs: usize, cp: u32) -> u32 {
    if t == 0 {
        return cp
    }
    if cp >= (unicode_tables.IDX_LEN << unicode_tables.IDX_SHIFT) as u32 {
        return cp
    }
    let win: usize = (cp as usize) >> unicode_tables.IDX_SHIFT
    var k: usize = rt.ld16(t + idx_off as u64, win) as usize
    let c: u64 = cp as u64
    while k < runs {
        let r: u64 = case_at(t, run_off, k)
        let lo: u64 = r & 0x1FFFFF
        if lo > c {
            return cp
        }
        let hi: u64 = (r >> 21) & 0x1FFFFF
        if c <= hi {
            var hit: bool = true
            if (r >> 42) & 1 == 1 {
                if (c - lo) & 1 == 1 {
                    hit = false
                }
            }
            if hit {
                let d: i64 = ((r >> 43) & 0x1FFFFF) as i64 - 1048576
                return (c as i64 + d) as u32
            }
        }
        k = k + 1
    }
    return cp
}

// The simple upper case mapping of the UCD (field 12). "Simple" means: one
// code point in, one code point out -- the full mappings of
// SpecialCasing.txt (one to many, and the locale rules) are NOT in here,
// and no caller may pretend otherwise.
fn ucd_to_upper(t: u64, cp: u32) -> u32 {
    return case_lookup(t, unicode_tables.OFF_UPIDX, unicode_tables.OFF_UP,
        unicode_tables.UP_RUNS, cp)
}

// The simple lower case mapping of the UCD (field 13).
fn ucd_to_lower(t: u64, cp: u32) -> u32 {
    return case_lookup(t, unicode_tables.OFF_LOIDX, unicode_tables.OFF_LOW,
        unicode_tables.LOW_RUNS, cp)
}
