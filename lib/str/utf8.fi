// lib/str/utf8.fi -- conversions between Str16 (WTF-16), Str (UTF-8) and
// WTF-8 (SPEC 8.2). Every conversion is EXPLICIT, and how it can fail
// stands in its result:
//
//   str16_to_utf8       -> bool   false = unpaired surrogate, target stays empty
//   str16_to_utf8_lossy -> replaces unpaired surrogates with U+FFFD
//   str16_to_wtf8       -> lossless (keeps unpaired surrogates)
//   wtf8_to_str16       -> the lossless way back
//   utf8_to_str16       -> always succeeds if the source is valid UTF-8
//
// Include:  //#include lib/str/utf8.fi   (needs alloc.fi, bytes.fi, str16.fi)

// ROUND 73: the constant moved to lib/str/core_cp.fi -- the reading half
// of the facade needs it too and must not drag this file (which writes
// into a Bytes) into lib/std/core.fi.
//#include lib/str/core_cp.fi

fn utf8_push_cp(out: *mut Bytes, cp: u32) {
    if cp < 0x80 {
        bytes_push(out, cp as u8)
    } else if cp < 0x800 {
        bytes_push(out, (0xC0 + (cp >> 6)) as u8)
        bytes_push(out, (0x80 + (cp & 0x3F)) as u8)
    } else if cp < 0x10000 {
        bytes_push(out, (0xE0 + (cp >> 12)) as u8)
        bytes_push(out, (0x80 + ((cp >> 6) & 0x3F)) as u8)
        bytes_push(out, (0x80 + (cp & 0x3F)) as u8)
    } else {
        bytes_push(out, (0xF0 + (cp >> 18)) as u8)
        bytes_push(out, (0x80 + ((cp >> 12) & 0x3F)) as u8)
        bytes_push(out, (0x80 + ((cp >> 6) & 0x3F)) as u8)
        bytes_push(out, (0x80 + (cp & 0x3F)) as u8)
    }
}

fn combine_surrogates(hi: u32, lo: u32) -> u32 {
    return 0x10000 + ((hi - 0xD800) << 10) + (lo - 0xDC00)
}

// Str16 -> Str. Result false on an unpaired surrogate; `out` is empty then.
fn str16_to_utf8(s: *mut Str16, out: *mut Bytes) -> bool {
    bytes_clear(out)
    var i: usize = 0
    let n: usize = str16_len(s)
    while i < n {
        let u: u32 = str16_at(s, i) as u32
        if is_high_surrogate(u) {
            if i + 1 >= n {
                bytes_clear(out)
                return false
            }
            let lo: u32 = str16_at(s, i + 1) as u32
            if !is_low_surrogate(lo) {
                bytes_clear(out)
                return false
            }
            utf8_push_cp(out, combine_surrogates(u, lo))
            i = i + 2
        } else if is_low_surrogate(u) {
            bytes_clear(out)
            return false
        } else {
            utf8_push_cp(out, u)
            i = i + 1
        }
    }
    return true
}

// Str16 -> Str, replacing: every unpaired surrogate becomes U+FFFD.
fn str16_to_utf8_lossy(s: *mut Str16, out: *mut Bytes) {
    bytes_clear(out)
    var i: usize = 0
    let n: usize = str16_len(s)
    while i < n {
        let u: u32 = str16_at(s, i) as u32
        if is_high_surrogate(u) {
            var paired: bool = false
            if i + 1 < n {
                if is_low_surrogate(str16_at(s, i + 1) as u32) {
                    paired = true
                }
            }
            if paired {
                utf8_push_cp(out, combine_surrogates(u, str16_at(s, i + 1) as u32))
                i = i + 2
            } else {
                utf8_push_cp(out, REPLACEMENT_CP)
                i = i + 1
            }
        } else if is_low_surrogate(u) {
            utf8_push_cp(out, REPLACEMENT_CP)
            i = i + 1
        } else {
            utf8_push_cp(out, u)
            i = i + 1
        }
    }
}

// Str16 -> WTF-8: the lossless bridge, unpaired surrogates survive as a
// three byte sequence.
fn str16_to_wtf8(s: *mut Str16, out: *mut Bytes) {
    bytes_clear(out)
    var i: usize = 0
    let n: usize = str16_len(s)
    while i < n {
        let u: u32 = str16_at(s, i) as u32
        var step: usize = 1
        var cp: u32 = u
        if is_high_surrogate(u) && i + 1 < n {
            let lo: u32 = str16_at(s, i + 1) as u32
            if is_low_surrogate(lo) {
                cp = combine_surrogates(u, lo)
                step = 2
            }
        }
        utf8_push_cp(out, cp)
        i = i + step
    }
}

// WTF-8 -> Str16, lossless (surrogate sequences become single units again).
fn wtf8_to_str16(b: *mut Bytes, out: *mut Str16) {
    str16_clear(out)
    var i: usize = 0
    let n: usize = bytes_len(b)
    while i < n {
        let b0: u32 = bytes_at(b, i) as u32
        var cp: u32 = 0
        var len: usize = 1
        if b0 < 0x80 {
            cp = b0
            len = 1
        } else if b0 >= 0xF0 {
            cp = b0 & 0x07
            len = 4
        } else if b0 >= 0xE0 {
            cp = b0 & 0x0F
            len = 3
        } else if b0 >= 0xC0 {
            cp = b0 & 0x1F
            len = 2
        } else {
            cp = REPLACEMENT_CP
            len = 1
        }
        if len > 1 {
            if i + len > n {
                str16_push_cp(out, REPLACEMENT_CP)
                return
            }
            var k: usize = 1
            while k < len {
                cp = (cp << 6) + (bytes_at(b, i + k) as u32 & 0x3F)
                k = k + 1
            }
        }
        if is_surrogate(cp) {
            str16_push(out, cp as u16)
        } else {
            str16_push_cp(out, cp)
        }
        i = i + len
    }
}

// Str -> Str16: always succeeds (the source is validated UTF-8).
fn utf8_to_str16(b: *mut Bytes, out: *mut Str16) {
    wtf8_to_str16(b, out)
}
