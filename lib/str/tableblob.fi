// SPDX-License-Identifier: MPL-2.0
// lib/str/tableblob.fi -- fills a generated table from a base64 literal.
import rt.rt

export { unpack }

#[no_gc]
fn sextet(c: u8) -> u64 {
    if c >= 97 as u8 { return (c - 97 as u8) as u64 + 26 }
    if c >= 65 as u8 { return (c - 65 as u8) as u64 }
    if c >= 48 as u8 { return (c - 48 as u8) as u64 + 52 }
    if c == 43 as u8 { return 62 }
    return 63
}

#[no_gc]
fn unpack(dst: *mut u8, bytes: usize, src: str) {
    var acc: u64 = 0
    var bits: u64 = 0
    var o: usize = 0
    var i: usize = 0
    while i < src.n && o < bytes {
        acc = ((acc << 6) | sextet(rt.ld8(src.p as u64, i))) & 16777215
        bits = bits + 6
        i = i + 1
        if bits >= 8 {
            bits = bits - 8
            rt.st8(dst as u64, o, ((acc >> bits) & 255) as u8)
            o = o + 1
        }
    }
}
