// lib/str/std_fassade.fi — die Textarbeit der std-Fassade (Runde 42).
//
// NUR fuer `lib/std/str.fi`: diese Datei wird ausschliesslich von
// `tools/strlib/src/std_str.fi` eingebunden, nicht von den erzeugten Tests
// 300-308. Die Einbindungs-Bibliothek lib/str selbst (alloc/bytes/str16/
// utf8/atom) bleibt damit unveraendert — wer sie ohne std benutzt, bekommt
// kein Byte mehr Code als vorher.
//
// WAS HIER STEHT: alles, was C# unter `string` und `char` fuehrt, soweit es
// ohne Sprachaenderung geht — Vergleiche, Suchen, Trimmen, Teilen,
// Verbinden, Ersetzen, ASCII-Gross/Klein, Auffuellen und eine
// UTF-8-SICHERE Iteration.
//
// ZWEI TYPEN, EINE REGEL:
//   * `Spanne` (Zeiger + Laenge) ist die LESENDE Sicht. Sie besitzt nichts,
//     alloziert nichts und wird als Wert weitergereicht — wie
//     `ReadOnlySpan<byte>`. Jede Frage ueber Text nimmt eine `Spanne`.
//   * `Bytes` (aus lib/str/bytes.fi) ist der BESITZENDE Puffer. Jede
//     Funktion, die Text ERZEUGT, schreibt in ein `*mut Bytes`.
// So ist an jeder Signatur ablesbar, wer Speicher haelt, und es gibt keine
// versteckte Allokation.
//
// EHRLICHE GRENZEN, gesammelt:
//   * Gross/Klein ist ASCII (A-Z / a-z). Unicode-Fallabbildung braucht die
//     UCD-Tabellen; die stehen im comptime-Zweig (tests/602_comptime_ucd.fi)
//     und gehoeren nicht in die Kernfassade.
//   * Die erzeugenden Funktionen (`ersetze`, `nach_gross`, ...) verlangen,
//     dass `aus` NICHT im Speicher der Quelle liegt. Sie leeren `aus` zuerst;
//     eine Ueberlappung waere ein Lesen aus einem gerade ueberschriebenen
//     Puffer. Wer an Ort und Stelle arbeiten will, nimmt die `_hier`-Formen.
//   * `npos()` (alle Bits gesetzt) ist "nicht gefunden" — Firn hat keine
//     Optionswerte, und ein Sonderwert ist ehrlicher als eine 0, die auch
//     "Treffer an Position 0" heissen koennte.
//   * Zahlen stehen NICHT hier, sondern in `std.num` (Text <-> Ganzzahl,
//     Text <-> f64). Doppelte Parser waeren zwei Wahrheiten.

// "nicht gefunden" / "kein Index". Als Funktion, weil `const` in Stufe 0
// ganzzahlig ausgewertet wird und 2^64-1 dort nicht darstellbar ist.
fn npos() -> usize {
    var x: usize = 0
    return x - 1
}

// ---------------------------------------------------------------- Spanne

struct Spanne {
    p: *mut u8,
    n: usize,
}

fn spanne(p: *mut u8, n: usize) -> Spanne {
    return Spanne{ p: p, n: n }
}

fn spanne_leer() -> Spanne {
    return Spanne{ p: 0 as *mut u8, n: 0 }
}

// Sicht auf den Inhalt eines Puffers. Gilt nur, solange der Puffer nicht
// waechst — `bytes_push` kann umziehen.
fn spanne_von_bytes(b: *mut Bytes) -> Spanne {
    return Spanne{ p: (*b).ptr, n: (*b).len }
}

// Laenge einer nullabgeschlossenen Folge.
fn c_laenge(p: *mut u8) -> usize {
    if (p as usize) == 0 {
        return 0
    }
    var n: usize = 0
    while ld8(p, n) != 0 as u8 {
        n = n + 1
    }
    return n
}

// Sicht auf eine nullabgeschlossene Folge (ohne das Nulloktett).
fn spanne_von_c(p: *mut u8) -> Spanne {
    return Spanne{ p: p, n: c_laenge(p) }
}

fn ist_leer(s: Spanne) -> bool {
    return s.n == 0
}

fn laenge(s: Spanne) -> usize {
    return s.n
}

// Oktett an Position `i`; jenseits des Endes 0 — wie `bytes_at`.
fn zeichen(s: Spanne, i: usize) -> u8 {
    if i >= s.n {
        return 0 as u8
    }
    return ld8(s.p, i)
}

// Teilstueck ab `von`, hoechstens `wieviel` Oktette. Beide Grenzen werden
// GEKAPPT statt gemeldet: eine Sicht kann nicht ungueltig werden.
fn spanne_teil(s: Spanne, von: usize, wieviel: usize) -> Spanne {
    if von >= s.n {
        return Spanne{ p: s.p, n: 0 }
    }
    var rest: usize = s.n - von
    if wieviel < rest {
        rest = wieviel
    }
    return Spanne{ p: (s.p as usize + von) as *mut u8, n: rest }
}

fn spanne_ab(s: Spanne, von: usize) -> Spanne {
    return spanne_teil(s, von, s.n)
}

fn spanne_bis(s: Spanne, bis: usize) -> Spanne {
    return spanne_teil(s, 0, bis)
}

// -------------------------------------------------------- Zeichenklassen
//
// ASCII. `ist_leerraum` folgt der Menge, die auch der Firn-Lexer als
// Trennung ansieht: Leerzeichen, Tab, Zeilenvorschub, Wagenruecklauf,
// Vertikaltab, Seitenvorschub.

fn ist_leerraum(c: u8) -> bool {
    return c == 32 as u8 || c == 9 as u8 || c == 10 as u8 || c == 13 as u8 ||
        c == 11 as u8 || c == 12 as u8
}

fn ist_ziffer(c: u8) -> bool {
    return c >= 48 as u8 && c <= 57 as u8
}

fn ist_hexziffer(c: u8) -> bool {
    return ist_ziffer(c) || (c >= 97 as u8 && c <= 102 as u8) ||
        (c >= 65 as u8 && c <= 70 as u8)
}

fn ist_grossbuchstabe(c: u8) -> bool {
    return c >= 65 as u8 && c <= 90 as u8
}

fn ist_kleinbuchstabe(c: u8) -> bool {
    return c >= 97 as u8 && c <= 122 as u8
}

fn ist_buchstabe(c: u8) -> bool {
    return ist_grossbuchstabe(c) || ist_kleinbuchstabe(c)
}

fn ist_alphanumerisch(c: u8) -> bool {
    return ist_buchstabe(c) || ist_ziffer(c)
}

// Wert einer Hexziffer, sonst -1.
fn hexwert(c: u8) -> i32 {
    if ist_ziffer(c) {
        return (c - 48 as u8) as i32
    }
    if c >= 97 as u8 && c <= 102 as u8 {
        return (c - 87 as u8) as i32
    }
    if c >= 65 as u8 && c <= 70 as u8 {
        return (c - 55 as u8) as i32
    }
    return 0 - 1
}

fn gross_zeichen(c: u8) -> u8 {
    if ist_kleinbuchstabe(c) {
        return c - 32 as u8
    }
    return c
}

fn klein_zeichen(c: u8) -> u8 {
    if ist_grossbuchstabe(c) {
        return c + 32 as u8
    }
    return c
}

// ------------------------------------------------------------- Vergleich

fn gleich(a: Spanne, b: Spanne) -> bool {
    if a.n != b.n {
        return false
    }
    return mem_eq(a.p, b.p, a.n)
}

// Lexikographisch ueber die Oktette; bei gemeinsamem Praefix entscheidet die
// Laenge. -1 = a vor b, 0 = gleich, 1 = a nach b.
fn vergleiche(a: Spanne, b: Spanne) -> i32 {
    var m: usize = a.n
    if b.n < m {
        m = b.n
    }
    var i: usize = 0
    while i < m {
        let x: u8 = ld8(a.p, i)
        let y: u8 = ld8(b.p, i)
        if x < y {
            return 0 - 1
        }
        if x > y {
            return 1
        }
        i = i + 1
    }
    if a.n < b.n {
        return 0 - 1
    }
    if a.n > b.n {
        return 1
    }
    return 0
}

fn gleich_ohne_fall(a: Spanne, b: Spanne) -> bool {
    if a.n != b.n {
        return false
    }
    var i: usize = 0
    while i < a.n {
        if klein_zeichen(ld8(a.p, i)) != klein_zeichen(ld8(b.p, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

fn vergleiche_ohne_fall(a: Spanne, b: Spanne) -> i32 {
    var m: usize = a.n
    if b.n < m {
        m = b.n
    }
    var i: usize = 0
    while i < m {
        let x: u8 = klein_zeichen(ld8(a.p, i))
        let y: u8 = klein_zeichen(ld8(b.p, i))
        if x < y {
            return 0 - 1
        }
        if x > y {
            return 1
        }
        i = i + 1
    }
    if a.n < b.n {
        return 0 - 1
    }
    if a.n > b.n {
        return 1
    }
    return 0
}

fn beginnt_mit(s: Spanne, teil: Spanne) -> bool {
    if teil.n > s.n {
        return false
    }
    return mem_eq(s.p, teil.p, teil.n)
}

fn endet_mit(s: Spanne, teil: Spanne) -> bool {
    if teil.n > s.n {
        return false
    }
    return mem_eq((s.p as usize + (s.n - teil.n)) as *mut u8, teil.p, teil.n)
}

// ---------------------------------------------------------------- Suchen

fn finde_zeichen_ab(s: Spanne, c: u8, ab: usize) -> usize {
    var i: usize = ab
    while i < s.n {
        if ld8(s.p, i) == c {
            return i
        }
        i = i + 1
    }
    return npos()
}

fn finde_zeichen(s: Spanne, c: u8) -> usize {
    return finde_zeichen_ab(s, c, 0)
}

fn finde_zeichen_rueck(s: Spanne, c: u8) -> usize {
    var i: usize = s.n
    while i > 0 {
        i = i - 1
        if ld8(s.p, i) == c {
            return i
        }
    }
    return npos()
}

// Ein LEERER Suchtext wird an `ab` gefunden — dieselbe Regel wie in C# und
// Rust; sie macht `ersetze` mit leerem `alt` zu einer Nulloperation statt zu
// einer Endlosschleife.
fn finde_ab(s: Spanne, teil: Spanne, ab: usize) -> usize {
    if teil.n == 0 {
        if ab > s.n {
            return npos()
        }
        return ab
    }
    if teil.n > s.n {
        return npos()
    }
    let letzte: usize = s.n - teil.n
    var i: usize = ab
    while i <= letzte {
        if mem_eq((s.p as usize + i) as *mut u8, teil.p, teil.n) {
            return i
        }
        i = i + 1
    }
    return npos()
}

fn finde(s: Spanne, teil: Spanne) -> usize {
    return finde_ab(s, teil, 0)
}

fn finde_rueck(s: Spanne, teil: Spanne) -> usize {
    if teil.n == 0 {
        return s.n
    }
    if teil.n > s.n {
        return npos()
    }
    var i: usize = s.n - teil.n + 1
    while i > 0 {
        i = i - 1
        if mem_eq((s.p as usize + i) as *mut u8, teil.p, teil.n) {
            return i
        }
    }
    return npos()
}

fn enthaelt(s: Spanne, teil: Spanne) -> bool {
    return finde(s, teil) != npos()
}

fn enthaelt_zeichen(s: Spanne, c: u8) -> bool {
    return finde_zeichen(s, c) != npos()
}

fn zaehle_zeichen(s: Spanne, c: u8) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < s.n {
        if ld8(s.p, i) == c {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// Nicht ueberlappende Vorkommen. Leerer Suchtext: 0 (sonst waere die Antwort
// "unendlich" oder willkuerlich).
fn zaehle_teil(s: Spanne, teil: Spanne) -> usize {
    if teil.n == 0 || teil.n > s.n {
        return 0
    }
    var n: usize = 0
    var i: usize = 0
    while true {
        let f: usize = finde_ab(s, teil, i)
        if f == npos() {
            return n
        }
        n = n + 1
        i = f + teil.n
        if i > s.n {
            return n
        }
    }
    return n
}

// Erstes Oktett, das NICHT in `menge` steht — die Grundlage jedes Trimmens
// mit eigener Zeichenmenge.
fn finde_nicht_aus(s: Spanne, menge: Spanne, ab: usize) -> usize {
    var i: usize = ab
    while i < s.n {
        if !enthaelt_zeichen(menge, ld8(s.p, i)) {
            return i
        }
        i = i + 1
    }
    return npos()
}

// --------------------------------------------------------------- Trimmen

fn trimme_links(s: Spanne) -> Spanne {
    var i: usize = 0
    while i < s.n && ist_leerraum(ld8(s.p, i)) {
        i = i + 1
    }
    return spanne_ab(s, i)
}

fn trimme_rechts(s: Spanne) -> Spanne {
    var e: usize = s.n
    while e > 0 && ist_leerraum(ld8(s.p, e - 1)) {
        e = e - 1
    }
    return spanne_bis(s, e)
}

fn trimme(s: Spanne) -> Spanne {
    return trimme_rechts(trimme_links(s))
}

// Trimmt jedes Oktett, das in `menge` steht.
fn trimme_menge(s: Spanne, menge: Spanne) -> Spanne {
    var a: usize = 0
    while a < s.n && enthaelt_zeichen(menge, ld8(s.p, a)) {
        a = a + 1
    }
    var e: usize = s.n
    while e > a && enthaelt_zeichen(menge, ld8(s.p, e - 1)) {
        e = e - 1
    }
    return spanne_teil(s, a, e - a)
}

// Praefix/Suffix abschneiden, falls vorhanden — sonst unveraendert.
fn ohne_praefix(s: Spanne, teil: Spanne) -> Spanne {
    if beginnt_mit(s, teil) {
        return spanne_ab(s, teil.n)
    }
    return s
}

fn ohne_suffix(s: Spanne, teil: Spanne) -> Spanne {
    if endet_mit(s, teil) {
        return spanne_bis(s, s.n - teil.n)
    }
    return s
}

// ----------------------------------------------------------------- Teilen
//
// Ein KURSOR, keine Liste: Firn hat in diesem Modul kein `Vec` (lib/str ist
// eine Einbindungs-Bibliothek ohne Modulstruktur), und ein Kursor ist
// ohnehin die Form, die nichts alloziert.
//
//     var t: str.Teiler = str.teiler_neu(quelle, trenner)
//     var stueck: str.Spanne = str.spanne_leer()
//     while str.teiler_naechst(&t, &stueck) { ... }
//
// Regeln (wie C# String.Split ohne RemoveEmptyEntries):
//   * "a,b,,c" mit "," ergibt "a", "b", "", "c"
//   * "" ergibt genau EIN leeres Stueck
//   * ein leerer Trenner ergibt genau EIN Stueck: die ganze Quelle
//   * `teiler_leerraum` fasst Leerraumfolgen zusammen und liefert NIE ein
//     leeres Stueck — das ist die Form, die man beim Zerlegen einer
//     Kommandozeile will.

const TEILER_TRENNER: u32 = 0
const TEILER_LEERRAUM: u32 = 1

struct Teiler {
    quelle: Spanne,
    trenner: Spanne,
    i: usize,
    modus: u32,
    fertig: bool,
}

fn teiler_neu(s: Spanne, trenner: Spanne) -> Teiler {
    return Teiler{ quelle: s, trenner: trenner, i: 0,
                   modus: TEILER_TRENNER, fertig: false }
}

fn teiler_leerraum(s: Spanne) -> Teiler {
    return Teiler{ quelle: s, trenner: spanne_leer(), i: 0,
                   modus: TEILER_LEERRAUM, fertig: false }
}

fn teiler_naechst(t: *mut Teiler, aus: *mut Spanne) -> bool {
    if (*t).fertig {
        return false
    }
    var s: Spanne = (*t).quelle
    if (*t).modus == TEILER_LEERRAUM {
        var i: usize = (*t).i
        while i < s.n && ist_leerraum(ld8(s.p, i)) {
            i = i + 1
        }
        if i >= s.n {
            (*t).i = s.n
            (*t).fertig = true
            return false
        }
        let start: usize = i
        while i < s.n && !ist_leerraum(ld8(s.p, i)) {
            i = i + 1
        }
        (*t).i = i
        (*aus).p = (s.p as usize + start) as *mut u8
        (*aus).n = i - start
        return true
    }
    var tr: Spanne = (*t).trenner
    let start: usize = (*t).i
    if tr.n == 0 {
        (*t).fertig = true
        (*aus).p = s.p
        (*aus).n = s.n
        return true
    }
    let f: usize = finde_ab(s, tr, start)
    if f == npos() {
        (*t).fertig = true
        var rest: Spanne = spanne_ab(s, start)
        (*aus).p = rest.p
        (*aus).n = rest.n
        return true
    }
    (*aus).p = (s.p as usize + start) as *mut u8
    (*aus).n = f - start
    (*t).i = f + tr.n
    return true
}

// Wie viele Stuecke `teiler_neu` liefern wird — fuer den Aufrufer, der
// vorher Platz schaffen will.
fn teile_zaehle(s: Spanne, trenner: Spanne) -> usize {
    if trenner.n == 0 {
        return 1
    }
    return zaehle_teil(s, trenner) + 1
}

// ----------------------------------------------------------- Text bauen
//
// Alles hier haengt an einem `*mut Bytes` an oder ersetzt dessen Inhalt.
// `_hier` heisst: an Ort und Stelle, ohne zweiten Puffer.

fn anhaengen(aus: *mut Bytes, s: Spanne) {
    bytes_append(aus, s.p, s.n)
}

fn anhaengen_zeichen(aus: *mut Bytes, c: u8) {
    bytes_push(aus, c)
}

fn setze(aus: *mut Bytes, s: Spanne) {
    bytes_clear(aus)
    bytes_append(aus, s.p, s.n)
}

fn wiederhole(aus: *mut Bytes, s: Spanne, mal: usize) {
    var i: usize = 0
    while i < mal {
        bytes_append(aus, s.p, s.n)
        i = i + 1
    }
}

// Verbinden: `teil` anhaengen, davor den Trenner — aber nur, wenn schon
// etwas dasteht. Damit ist die ganze Schleife der Aufrufer:
//
//     while str.teiler_naechst(&t, &st) { str.verbinde_teil(&aus, st, tr) }
fn verbinde_teil(aus: *mut Bytes, teil: Spanne, trenner: Spanne) {
    if bytes_len(aus) > 0 {
        bytes_append(aus, trenner.p, trenner.n)
    }
    bytes_append(aus, teil.p, teil.n)
}

// Rechtsbuendig auf `breite` bringen (links auffuellen). Ist der Text schon
// laenger, wird NICHT abgeschnitten.
fn fuelle_links(aus: *mut Bytes, s: Spanne, breite: usize, fueller: u8) {
    var i: usize = s.n
    while i < breite {
        bytes_push(aus, fueller)
        i = i + 1
    }
    bytes_append(aus, s.p, s.n)
}

fn fuelle_rechts(aus: *mut Bytes, s: Spanne, breite: usize, fueller: u8) {
    bytes_append(aus, s.p, s.n)
    var i: usize = s.n
    while i < breite {
        bytes_push(aus, fueller)
        i = i + 1
    }
}

// ------------------------------------------------------- Gross und Klein

fn nach_gross(aus: *mut Bytes, s: Spanne) {
    bytes_clear(aus)
    var i: usize = 0
    while i < s.n {
        bytes_push(aus, gross_zeichen(ld8(s.p, i)))
        i = i + 1
    }
}

fn nach_klein(aus: *mut Bytes, s: Spanne) {
    bytes_clear(aus)
    var i: usize = 0
    while i < s.n {
        bytes_push(aus, klein_zeichen(ld8(s.p, i)))
        i = i + 1
    }
}

fn gross_hier(b: *mut Bytes) {
    var i: usize = 0
    while i < (*b).len {
        st8((*b).ptr, i, gross_zeichen(ld8((*b).ptr, i)))
        i = i + 1
    }
}

fn klein_hier(b: *mut Bytes) {
    var i: usize = 0
    while i < (*b).len {
        st8((*b).ptr, i, klein_zeichen(ld8((*b).ptr, i)))
        i = i + 1
    }
}

// ------------------------------------------------------------- Ersetzen

// Alle nicht ueberlappenden Vorkommen. Rueckgabe: wie oft ersetzt wurde.
// `aus` wird geleert und muss ausserhalb von `s`, `alt` und `neu` liegen.
fn ersetze(aus: *mut Bytes, s: Spanne, alt: Spanne, neu: Spanne) -> usize {
    bytes_clear(aus)
    if alt.n == 0 || alt.n > s.n {
        bytes_append(aus, s.p, s.n)
        return 0
    }
    var n: usize = 0
    var i: usize = 0
    while i < s.n {
        let f: usize = finde_ab(s, alt, i)
        if f == npos() {
            bytes_append(aus, (s.p as usize + i) as *mut u8, s.n - i)
            return n
        }
        bytes_append(aus, (s.p as usize + i) as *mut u8, f - i)
        bytes_append(aus, neu.p, neu.n)
        n = n + 1
        i = f + alt.n
    }
    return n
}

fn ersetze_erstes(aus: *mut Bytes, s: Spanne, alt: Spanne, neu: Spanne) -> bool {
    bytes_clear(aus)
    if alt.n == 0 {
        bytes_append(aus, s.p, s.n)
        return false
    }
    let f: usize = finde(s, alt)
    if f == npos() {
        bytes_append(aus, s.p, s.n)
        return false
    }
    bytes_append(aus, s.p, f)
    bytes_append(aus, neu.p, neu.n)
    let ab: usize = f + alt.n
    bytes_append(aus, (s.p as usize + ab) as *mut u8, s.n - ab)
    return true
}

// Oktettweise, an Ort und Stelle — die Laenge aendert sich nicht.
fn ersetze_zeichen_hier(b: *mut Bytes, alt: u8, neu: u8) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < (*b).len {
        if ld8((*b).ptr, i) == alt {
            st8((*b).ptr, i, neu)
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// ------------------------------------------------------- UTF-8-Iteration
//
// `utf8_is_valid` (lib/str/utf8.fi) sagt, OB eine Folge gueltig ist. Hier
// steht, wie man ueber sie LAEUFT, ohne mitten in ein Zeichen zu greifen.
//
// `utf8_lies` prueft dieselben Regeln wie `utf8_is_valid`: Ueberlange
// Kodierungen, Surrogate (U+D800..U+DFFF) und alles ueber U+10FFFF sind
// UNGUELTIG. Ein ungueltiges Oktett wird als EIN Zeichen mit `gueltig =
// false` gemeldet (cp = U+FFFD), damit jede Schleife garantiert vorankommt.

struct Zeichenfund {
    cp: u32,
    laenge: usize,
    gueltig: bool,
}

fn ist_folgeoktett(c: u8) -> bool {
    return (c & 0xC0 as u8) == 0x80 as u8
}

fn utf8_fehlzeichen() -> Zeichenfund {
    return Zeichenfund{ cp: REPLACEMENT_CP, laenge: 1, gueltig: false }
}

fn utf8_lies(s: Spanne, i: usize) -> Zeichenfund {
    if i >= s.n {
        return Zeichenfund{ cp: 0, laenge: 0, gueltig: false }
    }
    let c0: u8 = ld8(s.p, i)
    if c0 < 0x80 as u8 {
        return Zeichenfund{ cp: c0 as u32, laenge: 1, gueltig: true }
    }
    if c0 < 0xC2 as u8 {
        // 0x80..0xBF sind Folgeoktette, 0xC0/0xC1 waeren ueberlang.
        return utf8_fehlzeichen()
    }
    if c0 < 0xE0 as u8 {
        if i + 1 >= s.n {
            return utf8_fehlzeichen()
        }
        let c1: u8 = ld8(s.p, i + 1)
        if !ist_folgeoktett(c1) {
            return utf8_fehlzeichen()
        }
        let cp: u32 = ((c0 as u32 & 0x1F) << 6) | (c1 as u32 & 0x3F)
        return Zeichenfund{ cp: cp, laenge: 2, gueltig: true }
    }
    if c0 < 0xF0 as u8 {
        if i + 2 >= s.n {
            return utf8_fehlzeichen()
        }
        let c1: u8 = ld8(s.p, i + 1)
        let c2: u8 = ld8(s.p, i + 2)
        if !ist_folgeoktett(c1) || !ist_folgeoktett(c2) {
            return utf8_fehlzeichen()
        }
        let cp: u32 = ((c0 as u32 & 0x0F) << 12) | ((c1 as u32 & 0x3F) << 6) |
            (c2 as u32 & 0x3F)
        if cp < 0x800 {
            return utf8_fehlzeichen()
        }
        if cp >= 0xD800 && cp <= 0xDFFF {
            return utf8_fehlzeichen()
        }
        return Zeichenfund{ cp: cp, laenge: 3, gueltig: true }
    }
    if c0 < 0xF5 as u8 {
        if i + 3 >= s.n {
            return utf8_fehlzeichen()
        }
        let c1: u8 = ld8(s.p, i + 1)
        let c2: u8 = ld8(s.p, i + 2)
        let c3: u8 = ld8(s.p, i + 3)
        if !ist_folgeoktett(c1) || !ist_folgeoktett(c2) || !ist_folgeoktett(c3) {
            return utf8_fehlzeichen()
        }
        let cp: u32 = ((c0 as u32 & 0x07) << 18) | ((c1 as u32 & 0x3F) << 12) |
            ((c2 as u32 & 0x3F) << 6) | (c3 as u32 & 0x3F)
        if cp < 0x10000 || cp > 0x10FFFF {
            return utf8_fehlzeichen()
        }
        return Zeichenfund{ cp: cp, laenge: 4, gueltig: true }
    }
    return utf8_fehlzeichen()
}

// Index des naechsten Zeichenanfangs. Am Ende: s.n.
fn utf8_naechst(s: Spanne, i: usize) -> usize {
    if i >= s.n {
        return s.n
    }
    let z: Zeichenfund = utf8_lies(s, i)
    var l: usize = z.laenge
    if l == 0 {
        l = 1
    }
    if i + l > s.n {
        return s.n
    }
    return i + l
}

// Index des vorigen Zeichenanfangs. Bei 0 bleibt es 0.
fn utf8_vorher(s: Spanne, i: usize) -> usize {
    if i == 0 {
        return 0
    }
    var j: usize = i
    if j > s.n {
        j = s.n
    }
    var k: usize = 0
    while k < 4 {
        if j == 0 {
            return 0
        }
        j = j - 1
        if !ist_folgeoktett(ld8(s.p, j)) {
            return j
        }
        k = k + 1
    }
    return j
}

fn utf8_ist_grenze(s: Spanne, i: usize) -> bool {
    if i == 0 || i >= s.n {
        return true
    }
    return !ist_folgeoktett(ld8(s.p, i))
}

// Zahl der Zeichen (nicht der Oktette). Ungueltige Oktette zaehlen als eins.
fn utf8_zaehle(s: Spanne) -> usize {
    var i: usize = 0
    var n: usize = 0
    while i < s.n {
        i = utf8_naechst(s, i)
        n = n + 1
    }
    return n
}

// Teilstueck NACH ZEICHEN statt nach Oktetten — der Schnitt liegt damit nie
// mitten in einem Zeichen.
fn utf8_teil(s: Spanne, von_zeichen: usize, anzahl: usize) -> Spanne {
    var i: usize = 0
    var z: usize = 0
    while z < von_zeichen && i < s.n {
        i = utf8_naechst(s, i)
        z = z + 1
    }
    let start: usize = i
    var g: usize = 0
    while g < anzahl && i < s.n {
        i = utf8_naechst(s, i)
        g = g + 1
    }
    return spanne_teil(s, start, i - start)
}

// Codepunkt an ein `Bytes` anhaengen (Huelle ueber utf8_push_cp, damit die
// Fassade eine vollstaendige Runde kann: lesen und schreiben).
fn utf8_anhaengen(aus: *mut Bytes, cp: u32) {
    utf8_push_cp(aus, cp)
}
