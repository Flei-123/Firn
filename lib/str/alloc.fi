// lib/str/alloc.fi -- memory without libc (module str).
//
// Stage 0 has neither global variables nor aggregates across function
// boundaries; that is why the whole library works with pointers to
// structures held by the caller. The memory comes straight from mmap(2).
//
// Include:  //#include lib/str/alloc.fi

// ROUND 73: the pure memory work (copy/compare/zero, ld*/st*, page_round)
// moved to `lib/str/core_mem.fi` -- it is the part that a freestanding
// kernel may use. Everything that is LEFT here needs the operating
// system: mmap, munmap, write. Whoever includes this file gets both, so
// no existing caller notices the cut.
//#include lib/str/core_mem.fi

const SYS_WRITE: i64 = 1
const SYS_READ: i64 = 0
const SYS_MMAP: i64 = 9
const SYS_MUNMAP: i64 = 11
const SYS_EXIT: i64 = 60
const PROT_READ_WRITE: i64 = 3
const MAP_PRIVATE_ANON: i64 = 34

// Returns n contiguous bytes (zero initialized) or 0 on failure.
fn heap_alloc(n: usize) -> *mut u8 {
    if n == 0 {
        return 0 as *mut u8
    }
    let len: usize = page_round(n)
    let r: i64 = syscall(SYS_MMAP, 0, len as i64, PROT_READ_WRITE, MAP_PRIVATE_ANON, -1, 0)
    // mmap reports failure as -1..-4095
    if r < 0 && r > -4096 {
        return 0 as *mut u8
    }
    return r as *mut u8
}

fn heap_free(p: *mut u8, n: usize) {
    if p as usize != 0 {
        syscall(SYS_MUNMAP, p as i64, page_round(n) as i64)
    }
}

fn write_all(fd: i64, p: *mut u8, n: usize) {
    var off: usize = 0
    while off < n {
        let r: i64 = syscall(SYS_WRITE, fd, (p as usize + off) as i64, (n - off) as i64)
        if r <= 0 {
            return
        }
        off = off + r as usize
    }
}
