// lib/str/print.fi — minimale Ausgabe ohne libc (Zahlen und Oktette).
// Wird nur von den Testprogrammen benutzt.
//
// Einbinden:  //#include lib/str/print.fi   (braucht lib/str/alloc.fi)

struct PrintBuf {
    b: [u8; 32],
    n: usize,
}

// Dezimalzahl, gefolgt von einem Leerzeichen.
fn print_num(v: u64) {
    print_num_sep(v, 32 as u8)
}

// Dezimalzahl, gefolgt von einem Zeilenende (letzter Wert einer Zeile).
fn print_num_nl(v: u64) {
    print_num_sep(v, 10 as u8)
}

// Dezimalzahl mit frei gewaehltem Trennzeichen dahinter.
fn print_num_sep(v: u64, sep: u8) {
    var p: PrintBuf = PrintBuf{ b: [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8], n: 0, }
    var x: u64 = v
    var n: usize = 0
    if x == 0 {
        p.b[0] = 48 as u8
        n = 1
    }
    while x > 0 {
        p.b[n] = (x % 10) as u8 + 48 as u8
        x = x / 10
        n = n + 1
    }
    var i: usize = 0
    while i < n / 2 {
        let t: u8 = p.b[i]
        p.b[i] = p.b[n - 1 - i]
        p.b[n - 1 - i] = t
        i = i + 1
    }
    p.b[n] = sep
    write_all(1, &p.b[0], n + 1)
}

// Zeilenende.
fn print_nl() {
    var p: PrintBuf = PrintBuf{ b: [10 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8], n: 0, }
    write_all(1, &p.b[0], 1)
}

// Einzelnes Oktett als Zeichen (fuer Textausgabe aus einem Bytes-Puffer).
fn print_bytes_raw(b: *mut Bytes) {
    write_all(1, (*b).ptr, (*b).len)
}
