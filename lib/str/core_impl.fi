// lib/str/core_impl.fi -- the METHODS of the reading text view (round 73).
//
// Cut out of `lib/str/std_impl.fi` along the same line as the free
// functions: `Span` is a VIEW, it owns nothing and allocates nothing, so
// its methods belong to the freestanding half of the library. The file is
// included by `lib/std/core.fi` and by `lib/std/str.fi` -- one source
// text, two front doors.
//
// NOTHING BUT WRAPPERS. Every method calls exactly the free function that
// already exists and does nothing else; there is no second implementation
// that could drift apart. `Span` is passed around by value, so its methods
// take `self` (compiler/src/impls.rs).
//
// Include:  //#include lib/str/core_impl.fi

// -------------------------------------------------------------------- Span
//
// The reading view. Everything here asks a question about text, it never
// changes it; nothing allocates.
impl Span {
    fn length(self) -> usize { return length(self) }
    fn is_empty(self) -> bool { return is_empty(self) }
    fn chars(self, i: usize) -> u8 { return chars(self, i) }
    fn part(self, of: usize, how_much: usize) -> Span {
        return span_part(self, of, how_much)
    }
    fn ab(self, of: usize) -> Span { return span_ab(self, of) }
    fn to(self, to: usize) -> Span { return span_to(self, to) }
    fn equal(self, b: Span) -> bool { return equal(self, b) }
    fn compare(self, b: Span) -> i32 { return compare(self, b) }
    fn equal_without_case(self, b: Span) -> bool {
        return equal_without_case(self, b)
    }
    fn starts_with(self, part: Span) -> bool { return starts_with(self, part) }
    fn ends_with(self, part: Span) -> bool { return ends_with(self, part) }
    fn find(self, part: Span) -> usize { return find(self, part) }
    fn find_back(self, part: Span) -> usize { return find_back(self, part) }
    fn find_char(self, c: u8) -> usize { return find_char(self, c) }
    fn contains(self, part: Span) -> bool { return contains(self, part) }
    fn count_char(self, c: u8) -> usize { return count_char(self, c) }
    fn count_part(self, part: Span) -> usize { return count_part(self, part) }
    fn trim(self) -> Span { return trim(self) }
    fn trim_left(self) -> Span { return trim_left(self) }
    fn trim_right(self) -> Span { return trim_right(self) }
    fn without_prefix(self, part: Span) -> Span { return without_prefix(self, part) }
    fn without_suffix(self, part: Span) -> Span { return without_suffix(self, part) }
    fn utf8_char(self) -> usize { return utf8_count(self) }
    fn utf8_part(self, of_char: usize, count: usize) -> Span {
        return utf8_part(self, of_char, count)
    }
}
