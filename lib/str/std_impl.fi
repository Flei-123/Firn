// lib/str/std_impl.fi -- the METHODS of the text facade (round 45).
//
// ONLY for `lib/std/str.fi`: this file is included exclusively by
// `tools/strlib/src/std_str.fi`. The include library lib/str itself
// (alloc/bytes/str16/utf8/atom) stays unchanged -- whoever uses it without
// std gets not one byte more code than before.
//
// WHAT IS HERE AND WHAT IS NOT: nothing but WRAPPERS. Every method calls
// exactly the free function that already exists, and does nothing else.
// That makes the move to methods provably behavior preserving -- there is
// no second implementation that could drift apart:
//
//     length(s)                 ->   s.length()
//     find(s, part)             ->   s.find(part)
//     bytes_push(&b, 65 as u8)  ->   b.add(65 as u8)
//
// THE FREE FUNCTIONS STAY. They remain available under their own names and
// are still used throughout the library; `impl` does NOT retire them. Both
// spellings point at the same code -- the method `Span.length` is called
// `Span__length` internally, while the free function is still called
// `length`. That is exactly why neither can shadow the other
// (compiler/src/impls.rs, section "name resolution").
//
// RECEIVERS (compiler/src/impls.rs):
//   `Span` is a VIEW (pointer + length) and is passed around by value --
//   its methods take `self`.
//   `Bytes` and `Str16` OWN memory; their methods take `*self`
//   (reading) or `*mut self` (writing), exactly like the free functions
//   behind them.

// ROUND 73: the methods of `Span` moved to `lib/str/core_impl.fi` -- the
// reading view needs no allocator and is therefore usable in the kernel
// profile. Included here, so that `std.str` keeps offering all of them.
//#include lib/str/core_impl.fi

// ------------------------------------------------------------------- Bytes
//
// The owning octet buffer. Reading methods take `*self`, writing ones
// `*mut self` -- the same distinction the free functions behind them make
// in their parameter types.
impl Bytes {
    fn length(*self) -> usize { return bytes_len(self) }
    fn at(*self, i: usize) -> u8 { return bytes_at(self, i) }
    fn is_text(*self) -> bool { return bytes_is_str(self) }
    fn equal(*self, b: *mut Bytes) -> bool { return bytes_eq(self, b) }
    fn span(*self) -> Span { return span_of_bytes(self) }
    fn write(*self, fd: i64) { bytes_write(fd, self) }
    fn add(*mut self, v: u8) { bytes_push(self, v) }
    fn clear(*mut self) { bytes_clear(self) }
    fn free(*mut self) { bytes_free(self) }
    fn append(*mut self, s: Span) { append(self, s) }
    fn set(*mut self, s: Span) { set(self, s) }
    fn repeat(*mut self, s: Span, times: usize) { repeat(self, s, times) }
    fn big_here(*mut self) { big_here(self) }
    fn small_here(*mut self) { small_here(self) }
}

// ------------------------------------------------------------------- Str16
//
// WTF-16: validates nothing, normalizes nothing (SPEC 8.2).
impl Str16 {
    fn length(*self) -> usize { return str16_len(self) }
    fn at(*self, i: usize) -> u16 { return str16_at(self, i) }
    fn equal(*self, b: *mut Str16) -> bool { return str16_eq(self, b) }
    fn add(*mut self, u: u16) { str16_push(self, u) }
    fn add_cp(*mut self, cp: u32) { str16_push_cp(self, cp) }
    fn set_at(*mut self, i: usize, u: u16) { str16_set(self, i, u) }
    fn clear(*mut self) { str16_clear(self) }
    fn free(*mut self) { str16_free(self) }
}
