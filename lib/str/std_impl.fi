// lib/str/std_impl.fi — die METHODEN der Textfassade (Runde 45).
//
// NUR fuer `lib/std/str.fi`: diese Datei wird ausschliesslich von
// `tools/strlib/src/std_str.fi` eingebunden. Die Einbindungs-Bibliothek
// lib/str selbst (alloc/bytes/str16/utf8/atom) bleibt unveraendert — wer sie
// ohne std benutzt, bekommt kein Byte mehr Code als vorher.
//
// WAS HIER STEHT UND WAS NICHT: ausschliesslich HUELLEN. Jede Methode ruft
// genau die freie Funktion auf, die es schon gibt, und tut sonst nichts.
// Damit ist die Umstellung auf Methoden nachweislich verhaltensgleich — es
// gibt keine zweite Umsetzung, die auseinanderlaufen koennte:
//
//     laenge(s)                 ->   s.laenge()
//     finde(s, teil)            ->   s.finde(teil)
//     bytes_push(&b, 65 as u8)  ->   b.dazu(65 as u8)
//
// DIE FREIEN FUNKTIONEN BLEIBEN. Sie stehen weiter unter ihrem Namen und
// werden von der ganzen Bibliothek weiter benutzt; `impl` legt sie NICHT
// still. Beide Schreibweisen zeigen auf denselben Code — die Methode
// `Spanne.laenge` heisst intern `Spanne__laenge`, die freie Funktion
// weiterhin `laenge`. Genau deshalb kann keine die andere verdecken
// (compiler/src/impls.rs, Abschnitt „Namensaufloesung").
//
// EMPFAENGER (compiler/src/impls.rs):
//   `Spanne` ist eine SICHT (Zeiger + Laenge) und wird als Wert
//   weitergereicht — ihre Methoden nehmen `self`.
//   `Bytes` und `Str16` BESITZEN Speicher; ihre Methoden nehmen `*self`
//   (lesend) bzw. `*mut self` (schreibend), genau wie die freien Funktionen
//   dahinter.

// ------------------------------------------------------------------ Spanne
//
// Die lesende Sicht. Alles hier ist eine Frage ueber Text, keine Aenderung
// an ihm; nichts alloziert.
impl Span {
    fn length(self) -> usize { return length(self) }
    fn is_empty(self) -> bool { return is_empty(self) }
    fn chars(self, i: usize) -> u8 { return chars(self, i) }
    fn part(self, of: usize, howmuch: usize) -> Span {
        return span_part(self, of, howmuch)
    }
    fn ab(self, of: usize) -> Span { return span_ab(self, of) }
    fn to(self, to: usize) -> Span { return span_to(self, to) }
    fn equal(self, b: Span) -> bool { return equal(self, b) }
    fn compare(self, b: Span) -> i32 { return compare(self, b) }
    fn equal_without_case(self, b: Span) -> bool {
        return equal_without_case(self, b)
    }
    fn starts_with(self, part: Span) -> bool { return starts_with(self, part) }
    fn ends_with(self, part: Span) -> bool { return ends_with(self, part) }
    fn find(self, part: Span) -> usize { return find(self, part) }
    fn find_back(self, part: Span) -> usize { return find_back(self, part) }
    fn find_char(self, c: u8) -> usize { return find_char(self, c) }
    fn contains(self, part: Span) -> bool { return contains(self, part) }
    fn count_char(self, c: u8) -> usize { return count_char(self, c) }
    fn count_part(self, part: Span) -> usize { return count_part(self, part) }
    fn trim(self) -> Span { return trim(self) }
    fn trim_left(self) -> Span { return trim_left(self) }
    fn trim_right(self) -> Span { return trim_right(self) }
    fn without_prefix(self, part: Span) -> Span { return without_prefix(self, part) }
    fn without_suffix(self, part: Span) -> Span { return without_suffix(self, part) }
    fn utf8_char(self) -> usize { return utf8_count(self) }
    fn utf8_part(self, of_char: usize, count: usize) -> Span {
        return utf8_part(self, of_char, count)
    }
}

// ------------------------------------------------------------------- Bytes
//
// Der besitzende Oktettpuffer. Lesende Methoden nehmen `*self`, schreibende
// `*mut self` — dieselbe Unterscheidung, die die freien Funktionen dahinter
// in ihren Parametertypen treffen.
impl Bytes {
    fn length(*self) -> usize { return bytes_len(self) }
    fn at(*self, i: usize) -> u8 { return bytes_at(self, i) }
    fn is_text(*self) -> bool { return bytes_is_str(self) }
    fn equal(*self, b: *mut Bytes) -> bool { return bytes_eq(self, b) }
    fn span(*self) -> Span { return span_of_bytes(self) }
    fn write(*self, fd: i64) { bytes_write(fd, self) }
    fn add(*mut self, v: u8) { bytes_push(self, v) }
    fn clear(*mut self) { bytes_clear(self) }
    fn free(*mut self) { bytes_free(self) }
    fn append(*mut self, s: Span) { append(self, s) }
    fn set(*mut self, s: Span) { set(self, s) }
    fn repeat(*mut self, s: Span, times: usize) { repeat(self, s, times) }
    fn big_here(*mut self) { big_here(self) }
    fn small_here(*mut self) { small_here(self) }
}

// ------------------------------------------------------------------ Str16
//
// WTF-16: prueft nichts, normalisiert nichts (SPEC §8.2).
impl Str16 {
    fn length(*self) -> usize { return str16_len(self) }
    fn at(*self, i: usize) -> u16 { return str16_at(self, i) }
    fn equal(*self, b: *mut Str16) -> bool { return str16_eq(self, b) }
    fn add(*mut self, u: u16) { str16_push(self, u) }
    fn add_cp(*mut self, cp: u32) { str16_push_cp(self, cp) }
    fn set_at(*mut self, i: usize, u: u16) { str16_set(self, i, u) }
    fn clear(*mut self) { str16_clear(self) }
    fn free(*mut self) { str16_free(self) }
}
