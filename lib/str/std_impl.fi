// lib/str/std_impl.fi — die METHODEN der Textfassade (Runde 45).
//
// NUR fuer `lib/std/str.fi`: diese Datei wird ausschliesslich von
// `tools/strlib/src/std_str.fi` eingebunden. Die Einbindungs-Bibliothek
// lib/str selbst (alloc/bytes/str16/utf8/atom) bleibt unveraendert — wer sie
// ohne std benutzt, bekommt kein Byte mehr Code als vorher.
//
// WAS HIER STEHT UND WAS NICHT: ausschliesslich HUELLEN. Jede Methode ruft
// genau die freie Funktion auf, die es schon gibt, und tut sonst nichts.
// Damit ist die Umstellung auf Methoden nachweislich verhaltensgleich — es
// gibt keine zweite Umsetzung, die auseinanderlaufen koennte:
//
//     laenge(s)                 ->   s.laenge()
//     finde(s, teil)            ->   s.finde(teil)
//     bytes_push(&b, 65 as u8)  ->   b.dazu(65 as u8)
//
// DIE FREIEN FUNKTIONEN BLEIBEN. Sie stehen weiter unter ihrem Namen und
// werden von der ganzen Bibliothek weiter benutzt; `impl` legt sie NICHT
// still. Beide Schreibweisen zeigen auf denselben Code — die Methode
// `Spanne.laenge` heisst intern `Spanne__laenge`, die freie Funktion
// weiterhin `laenge`. Genau deshalb kann keine die andere verdecken
// (compiler/src/impls.rs, Abschnitt „Namensaufloesung").
//
// EMPFAENGER (compiler/src/impls.rs):
//   `Spanne` ist eine SICHT (Zeiger + Laenge) und wird als Wert
//   weitergereicht — ihre Methoden nehmen `self`.
//   `Bytes` und `Str16` BESITZEN Speicher; ihre Methoden nehmen `*self`
//   (lesend) bzw. `*mut self` (schreibend), genau wie die freien Funktionen
//   dahinter.

// ------------------------------------------------------------------ Spanne
//
// Die lesende Sicht. Alles hier ist eine Frage ueber Text, keine Aenderung
// an ihm; nichts alloziert.
impl Spanne {
    fn laenge(self) -> usize { return laenge(self) }
    fn ist_leer(self) -> bool { return ist_leer(self) }
    fn zeichen(self, i: usize) -> u8 { return zeichen(self, i) }
    fn teil(self, von: usize, wieviel: usize) -> Spanne {
        return spanne_teil(self, von, wieviel)
    }
    fn ab(self, von: usize) -> Spanne { return spanne_ab(self, von) }
    fn bis(self, bis: usize) -> Spanne { return spanne_bis(self, bis) }
    fn gleich(self, b: Spanne) -> bool { return gleich(self, b) }
    fn vergleiche(self, b: Spanne) -> i32 { return vergleiche(self, b) }
    fn gleich_ohne_fall(self, b: Spanne) -> bool {
        return gleich_ohne_fall(self, b)
    }
    fn beginnt_mit(self, teil: Spanne) -> bool { return beginnt_mit(self, teil) }
    fn endet_mit(self, teil: Spanne) -> bool { return endet_mit(self, teil) }
    fn finde(self, teil: Spanne) -> usize { return finde(self, teil) }
    fn finde_rueck(self, teil: Spanne) -> usize { return finde_rueck(self, teil) }
    fn finde_zeichen(self, c: u8) -> usize { return finde_zeichen(self, c) }
    fn enthaelt(self, teil: Spanne) -> bool { return enthaelt(self, teil) }
    fn zaehle_zeichen(self, c: u8) -> usize { return zaehle_zeichen(self, c) }
    fn zaehle_teil(self, teil: Spanne) -> usize { return zaehle_teil(self, teil) }
    fn trimme(self) -> Spanne { return trimme(self) }
    fn trimme_links(self) -> Spanne { return trimme_links(self) }
    fn trimme_rechts(self) -> Spanne { return trimme_rechts(self) }
    fn ohne_praefix(self, teil: Spanne) -> Spanne { return ohne_praefix(self, teil) }
    fn ohne_suffix(self, teil: Spanne) -> Spanne { return ohne_suffix(self, teil) }
    fn utf8_zeichen(self) -> usize { return utf8_zaehle(self) }
    fn utf8_teil(self, von_zeichen: usize, anzahl: usize) -> Spanne {
        return utf8_teil(self, von_zeichen, anzahl)
    }
}

// ------------------------------------------------------------------- Bytes
//
// Der besitzende Oktettpuffer. Lesende Methoden nehmen `*self`, schreibende
// `*mut self` — dieselbe Unterscheidung, die die freien Funktionen dahinter
// in ihren Parametertypen treffen.
impl Bytes {
    fn laenge(*self) -> usize { return bytes_len(self) }
    fn bei(*self, i: usize) -> u8 { return bytes_at(self, i) }
    fn ist_text(*self) -> bool { return bytes_is_str(self) }
    fn gleich(*self, b: *mut Bytes) -> bool { return bytes_eq(self, b) }
    fn spanne(*self) -> Spanne { return spanne_von_bytes(self) }
    fn schreibe(*self, fd: i64) { bytes_write(fd, self) }
    fn dazu(*mut self, v: u8) { bytes_push(self, v) }
    fn leeren(*mut self) { bytes_clear(self) }
    fn frei(*mut self) { bytes_free(self) }
    fn anhaengen(*mut self, s: Spanne) { anhaengen(self, s) }
    fn setze(*mut self, s: Spanne) { setze(self, s) }
    fn wiederhole(*mut self, s: Spanne, mal: usize) { wiederhole(self, s, mal) }
    fn gross_hier(*mut self) { gross_hier(self) }
    fn klein_hier(*mut self) { klein_hier(self) }
}

// ------------------------------------------------------------------ Str16
//
// WTF-16: prueft nichts, normalisiert nichts (SPEC §8.2).
impl Str16 {
    fn laenge(*self) -> usize { return str16_len(self) }
    fn bei(*self, i: usize) -> u16 { return str16_at(self, i) }
    fn gleich(*self, b: *mut Str16) -> bool { return str16_eq(self, b) }
    fn dazu(*mut self, u: u16) { str16_push(self, u) }
    fn dazu_cp(*mut self, cp: u32) { str16_push_cp(self, cp) }
    fn setze_bei(*mut self, i: usize, u: u16) { str16_set(self, i, u) }
    fn leeren(*mut self) { str16_clear(self) }
    fn frei(*mut self) { str16_free(self) }
}
