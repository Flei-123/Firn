// SPDX-License-Identifier: MPL-2.0
// lib/str/ucd_bidi.fi -- DER WEG IN DIE BIDI-TABELLE DES HAUSES.
//
// Die Tabelle selbst ist `generated/bidi_tables.fi`. Sie entsteht mit
// `bash tools/ucd/build_bidi.sh` aus vier Dateien der Unicode Character
// Database 17.0.0 (DerivedBidiClass, BidiMirroring, BidiBrackets,
// ArabicShaping) und aus UnicodeData.txt, die schon fuer
// `generated/unicode_tables.fi` im Baum liegt. Diese Datei hier ist von
// Hand geschrieben und haelt die Abfragen, sonst nichts -- dieselbe
// Teilung wie zwischen `unicode_tables.fi` und `ucd.fi`.
//
// WARUM EIN EIGENES MODUL UND NICHT DREI FUNKTIONEN MEHR IN ucd.fi. Der
// JavaScript-Zerleger (lib/js/) und jedes andere Programm, das nach der
// Allgemeinen Kategorie fragt, bindet `ucd.fi` ein. Wer dort die
// Bidi-Tabelle mit hineinzieht, laedt sie in jedes dieser Programme,
// obwohl keines von ihnen je eine Zeile umordnet. Die Daten sind
// dieselbe Sorte (eine Tabelle aus der UCD, derselbe Erzeugungsweg im
// selben Werkzeugordner), der Zugang liegt nur daneben.
//
// WIE DIE TABELLE AUSSIEHT (Einzelheiten im Kopf der erzeugten Datei):
//
//   * eine dreistufige Tabelle wie in unicode_tables.fi, ein Oktett je
//     Codepunkt: Bit 0..4 die Bidi-Klasse (BIDI_*), Bit 5..7 die
//     Verbindungsart fuer die arabische Schrift (JOIN_*);
//   * eine sortierte Liste der Spiegelpaare, in der auch die
//     Klammerpaare fuer die Regel N0 stehen;
//   * die arabischen Darstellungsformen (U+FB50..U+FEFF) je
//     Grundbuchstabe, und die Zweierligaturen -- beides nur fuer die
//     Naeherung ohne GSUB in lib/fui/shape.fi.
//
// Der Zeiger auf die abgebildete Flaeche wird herumgereicht wie in
// `ucd.fi` (Stufe 0 hat keine globalen Felder). Ein Nullzeiger heisst
// "die Abbildung ist gescheitert", und jede Abfrage antwortet dann so,
// als sei der Codepunkt ein gewoehnlicher lateinischer Buchstabe --
// eine Oberflaeche, die ohne Tabelle alles von links nach rechts
// schreibt, ist das alte Verhalten und kein Absturz.
import generated.bidi_tables

export {
    ucd_bidi_map, ucd_bidi_free, ucd_bidi_bytes,
    ucd_bidi_octet, ucd_bidi_class, ucd_joining, ucd_mirror,
    ucd_bracket_type, ucd_bracket_pair, ucd_bracket_canon,
    ucd_arabic_form, ucd_arabic_ligature,
    BIDI_L, BIDI_R, BIDI_AL, BIDI_EN, BIDI_ES, BIDI_ET, BIDI_AN, BIDI_CS,
    BIDI_NSM, BIDI_BN, BIDI_B, BIDI_S, BIDI_WS, BIDI_ON,
    BIDI_LRE, BIDI_LRO, BIDI_RLE, BIDI_RLO, BIDI_PDF,
    BIDI_LRI, BIDI_RLI, BIDI_FSI, BIDI_PDI, BIDI_COUNT,
    JOIN_U, JOIN_R, JOIN_L, JOIN_D, JOIN_C, JOIN_T,
    BRACKET_NONE, BRACKET_OPEN, BRACKET_CLOSE,
    FORM_ISOL, FORM_FINA, FORM_INIT, FORM_MEDI,
}

const SYS_MMAP: i64 = 9
const SYS_MUNMAP: i64 = 11
const PROT_READ_WRITE: i64 = 3
// MAP_PRIVATE|MAP_ANONYMOUS -- ausdruecklich OHNE MAP_FIXED, aus dem
// Grund, der im Kopf von ucd.fi steht.
const MAP_FLAGS: i64 = 0x22

// DIE 23 BIDI-KLASSEN VON UAX #9, Tabelle 4. Die Nummern sind die des
// Erzeugers (tools/ucd/pack_bidi.fi) -- L ist mit Absicht die Null,
// denn die Seiten aus mmap sind genullt, und "L" ist die Vorgabe von
// DerivedBidiClass.txt fuer alles, was keine eigene Zeile hat.
const BIDI_L: u8 = 0
const BIDI_R: u8 = 1
const BIDI_AL: u8 = 2
const BIDI_EN: u8 = 3
const BIDI_ES: u8 = 4
const BIDI_ET: u8 = 5
const BIDI_AN: u8 = 6
const BIDI_CS: u8 = 7
const BIDI_NSM: u8 = 8
const BIDI_BN: u8 = 9
const BIDI_B: u8 = 10
const BIDI_S: u8 = 11
const BIDI_WS: u8 = 12
const BIDI_ON: u8 = 13
const BIDI_LRE: u8 = 14
const BIDI_LRO: u8 = 15
const BIDI_RLE: u8 = 16
const BIDI_RLO: u8 = 17
const BIDI_PDF: u8 = 18
const BIDI_LRI: u8 = 19
const BIDI_RLI: u8 = 20
const BIDI_FSI: u8 = 21
const BIDI_PDI: u8 = 22
const BIDI_COUNT: u8 = 23

// DIE VERBINDUNGSART (ArabicShaping.txt, Spalte 2). U verbindet sich mit
// nichts, R nur mit dem Vorgaenger (Alif, Dal, Waw ...), L nur mit dem
// Nachfolger, D nach beiden Seiten, C verbindet ohne selbst eine Form zu
// haben (Tatweel, ZWJ), T ist durchsichtig (die Vokalzeichen) und wird
// beim Suchen des Nachbarn uebersprungen.
const JOIN_U: u8 = 0
const JOIN_R: u8 = 1
const JOIN_L: u8 = 2
const JOIN_D: u8 = 3
const JOIN_C: u8 = 4
const JOIN_T: u8 = 5

const BRACKET_NONE: u8 = 0
const BRACKET_OPEN: u8 = 1
const BRACKET_CLOSE: u8 = 2

// Die vier Stellungsformen eines arabischen Buchstabens. Dieselbe
// Reihenfolge wie die OpenType-Merkmale isol/fina/init/medi.
const FORM_ISOL: u32 = 0
const FORM_FINA: u32 = 1
const FORM_INIT: u32 = 2
const FORM_MEDI: u32 = 3

const MAX_CP: u32 = 0x110000

// DIE DREI LESEBREITEN, ohne rt.ld*: die Messwege von lib/fui/painter.fi
// sind #[no_gc], und das Versprechen gilt fuer den ganzen Aufrufbaum --
// eine Abfrage hier muss es also auch halten.
#[no_gc]
fn l8(p: u64, i: usize) -> u8 {
    return *((p + i as u64) as *mut u8)
}

#[no_gc]
fn l16(p: u64, i: usize) -> u16 {
    return *((p + (i * 2) as u64) as *mut u16)
}

#[no_gc]
fn l64(p: u64, i: usize) -> u64 {
    return *((p + (i * 8) as u64) as *mut u64)
}

fn ucd_bidi_bytes() -> usize {
    return bidi_tables.BYTES
}

// Bildet die Tabelle ab und fuellt sie. 0 heisst gescheitert.
fn ucd_bidi_map() -> u64 {
    let r: i64 = syscall(SYS_MMAP, 0, bidi_tables.BYTES as i64,
        PROT_READ_WRITE, MAP_FLAGS, 0 - 1, 0)
    if r <= 0 {
        return 0
    }
    bidi_tables.load(r as *mut u8)
    return r as u64
}

fn ucd_bidi_free(t: u64) {
    if t == 0 {
        return
    }
    syscall(SYS_MUNMAP, t as i64, bidi_tables.BYTES as i64, 0, 0, 0, 0)
}

// DAS OKTETT EINES CODEPUNKTES: drei Ladebefehle, keine Schleife.
#[no_gc]
fn ucd_bidi_octet(t: u64, cp: u32) -> u8 {
    if t == 0 || cp >= MAX_CP {
        return 0 as u8
    }
    let c: usize = cp as usize
    let b2: usize = l8(t, bidi_tables.OFF_L1 + (c >> 9)) as usize
    let b3: usize = l16(t + bidi_tables.OFF_L2 as u64,
        b2 * 32 + ((c >> 4) & 31)) as usize
    return l8(t, bidi_tables.OFF_L3 + b3 * 16 + (c & 15))
}

#[no_gc]
fn ucd_bidi_class(t: u64, cp: u32) -> u8 {
    return ucd_bidi_octet(t, cp) & 31 as u8
}

#[no_gc]
fn ucd_joining(t: u64, cp: u32) -> u8 {
    return (ucd_bidi_octet(t, cp) >> 5) & 7 as u8
}

// ------------------------------------------------------ Spiegelpaare
//
// Ein Eintrag je Zeichen mit Bidi_Mirroring_Glyph, sortiert nach dem
// Codepunkt, ein u64:
//
//   Bit  0..20   der Codepunkt
//   Bit 21..41   sein Spiegelbild (0 = keines, das Zeichen ist trotzdem
//                ein Klammerzeichen -- das kommt in 17.0.0 nicht vor,
//                wird aber nicht ausgeschlossen)
//   Bit 42..43   die Klammerart aus BidiBrackets.txt (BRACKET_*)
//   Bit 44..59   die kanonische Entsprechung einer Klammer (U+2329 ist
//                kanonisch U+3008), 0 = das Zeichen selbst. BD16 von
//                UAX #9 verlangt, Klammern ueber diese Entsprechung zu
//                vergleichen.
#[no_gc]
fn mir_find(t: u64, cp: u32) -> u64 {
    if t == 0 {
        return 0
    }
    var lo: usize = 0
    var hi: usize = bidi_tables.MIR_N
    let c: u64 = cp as u64
    while lo < hi {
        let mid: usize = (lo + hi) / 2
        let e: u64 = l64(t + bidi_tables.OFF_MIR as u64, mid)
        let k: u64 = e & 0x1FFFFF
        if k == c {
            return e
        }
        if k < c {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return 0
}

// Das Spiegelbild fuer die Regel L4, oder der Codepunkt selbst.
#[no_gc]
fn ucd_mirror(t: u64, cp: u32) -> u32 {
    let e: u64 = mir_find(t, cp)
    let m: u32 = ((e >> 21) & 0x1FFFFF) as u32
    if m == 0 as u32 {
        return cp
    }
    return m
}

#[no_gc]
fn ucd_bracket_type(t: u64, cp: u32) -> u8 {
    let e: u64 = mir_find(t, cp)
    return ((e >> 42) & 3) as u8
}

// Das Gegenstueck einer Klammer (Bidi_Paired_Bracket), 0 wenn keines.
#[no_gc]
fn ucd_bracket_pair(t: u64, cp: u32) -> u32 {
    let e: u64 = mir_find(t, cp)
    if ((e >> 42) & 3) == 0 {
        return 0
    }
    return ((e >> 21) & 0x1FFFFF) as u32
}

// Die Form, unter der zwei Klammern verglichen werden (BD16).
#[no_gc]
fn ucd_bracket_canon(t: u64, cp: u32) -> u32 {
    let e: u64 = mir_find(t, cp)
    let k: u32 = ((e >> 44) & 0xFFFF) as u32
    if k == 0 as u32 {
        return cp
    }
    return k
}

// ------------------------------------------- arabische Darstellungsformen
//
// NUR FUER DIE NAEHERUNG OHNE GSUB. Die Formen stehen in UnicodeData.txt
// als Zerlegung (`<initial> 0628`), und der Erzeuger hat sie je
// Grundbuchstabe eingesammelt: zwei u64 je Eintrag,
//
//   Wort 0   Grund | isoliert << 16 | endend << 32 | anfangs << 48
//   Wort 1   mittig
//
// 0 heisst "diese Form gibt es fuer diesen Buchstaben nicht".
#[no_gc]
fn ucd_arabic_form(t: u64, cp: u32, form: u32) -> u32 {
    if t == 0 || cp > 0xFFFF as u32 {
        return 0
    }
    var lo: usize = 0
    var hi: usize = bidi_tables.FORM_N
    let c: u64 = cp as u64
    while lo < hi {
        let mid: usize = (lo + hi) / 2
        let w0: u64 = l64(t + bidi_tables.OFF_FORM as u64, mid * 2)
        let k: u64 = w0 & 0xFFFF
        if k == c {
            if form == FORM_MEDI {
                return l64(t + bidi_tables.OFF_FORM as u64,
                    mid * 2 + 1) as u32
            }
            return ((w0 >> (16 * (form + 1) as u64)) & 0xFFFF) as u32
        }
        if k < c {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return 0
}

// Die Zweierligatur aus `a` und `b` in der Form `form` (nur FORM_ISOL
// und FORM_FINA sind gefuehrt), 0 wenn es sie nicht gibt. Ein Eintrag:
//   a | b << 16 | isoliert << 32 | endend << 48
#[no_gc]
fn ucd_arabic_ligature(t: u64, a: u32, b: u32, form: u32) -> u32 {
    if t == 0 || a > 0xFFFF as u32 || b > 0xFFFF as u32 {
        return 0
    }
    let key: u64 = (a as u64) | ((b as u64) << 16)
    var lo: usize = 0
    var hi: usize = bidi_tables.LIG_N
    while lo < hi {
        let mid: usize = (lo + hi) / 2
        let e: u64 = l64(t + bidi_tables.OFF_LIG as u64, mid)
        let k: u64 = e & 0xFFFFFFFF
        if k == key {
            if form == FORM_ISOL {
                return ((e >> 32) & 0xFFFF) as u32
            }
            if form == FORM_FINA {
                return ((e >> 48) & 0xFFFF) as u32
            }
            return 0
        }
        if k < key {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return 0
}
