// SPDX-License-Identifier: MPL-2.0
// lib/str/ucd_bidi.fi -- THE WAY INTO THE BIDI TABLE OF THE HOUSE.
//
// The table itself is `generated/bidi_tables.fi`. It arises with
// `bash tools/ucd/build_bidi.sh` from four files of the Unicode Character
// Database 17.0.0 (DerivedBidiClass, BidiMirroring, BidiBrackets,
// ArabicShaping) and from UnicodeData.txt, which already lies in the tree for
// `generated/unicode_tables.fi`. This file here is written by
// hand and holds the queries, nothing else -- the same division
// as between `unicode_tables.fi` and `ucd.fi`.
//
// WHY A MODULE OF ITS OWN AND NOT THREE MORE FUNCTIONS IN ucd.fi. The
// JavaScript parser (lib/js/) and every other program that asks for the
// general category includes `ucd.fi`. Whoever pulls the
// bidi table in there loads it into each of these programs,
// although none of them ever reorders a line. The data are
// the same kind (a table from the UCD, the same generation path in the
// same tool folder), the access just lies next to it.
//
// WHAT THE TABLE LOOKS LIKE (details in the head of the generated file):
//
//   * a three-stage table as in unicode_tables.fi, one octet per
//     code point: bit 0..4 the bidi class (BIDI_*), bit 5..7 the
//     joining type for Arabic script (JOIN_*);
//   * a sorted list of the mirror pairs, in which the
//     bracket pairs for rule N0 also stand;
//   * the Arabic presentation forms (U+FB50..U+FEFF) per
//     base letter, and the two-letter ligatures -- both only for the
//     approximation without GSUB in lib/fui/shape.fi.
//
// The pointer to the mapped area is passed around as in
// `ucd.fi` (stage 0 has no global fields). A null pointer means
// "the mapping failed", and every query then answers as
// if the code point were an ordinary Latin letter --
// a surface that without a table writes everything from left to right is the old
// behaviour and no crash.
import generated.bidi_tables

export {
    ucd_bidi_map, ucd_bidi_free, ucd_bidi_bytes,
    ucd_bidi_octet, ucd_bidi_class, ucd_joining, ucd_mirror,
    ucd_bracket_type, ucd_bracket_pair, ucd_bracket_canon,
    ucd_arabic_form, ucd_arabic_ligature,
    BIDI_L, BIDI_R, BIDI_AL, BIDI_EN, BIDI_ES, BIDI_ET, BIDI_AN, BIDI_CS,
    BIDI_NSM, BIDI_BN, BIDI_B, BIDI_S, BIDI_WS, BIDI_ON,
    BIDI_LRE, BIDI_LRO, BIDI_RLE, BIDI_RLO, BIDI_PDF,
    BIDI_LRI, BIDI_RLI, BIDI_FSI, BIDI_PDI, BIDI_COUNT,
    JOIN_U, JOIN_R, JOIN_L, JOIN_D, JOIN_C, JOIN_T,
    BRACKET_NONE, BRACKET_OPEN, BRACKET_CLOSE,
    FORM_ISOL, FORM_FINA, FORM_INIT, FORM_MEDI,
}

const SYS_MMAP: i64 = 9
const SYS_MUNMAP: i64 = 11
const PROT_READ_WRITE: i64 = 3
// MAP_PRIVATE|MAP_ANONYMOUS -- expressly WITHOUT MAP_FIXED, for the
// reason that stands in the head of ucd.fi.
const MAP_FLAGS: i64 = 0x22

// THE 23 BIDI CLASSES OF UAX #9, table 4. The numbers are those of the
// generator (tools/ucd/pack_bidi.fi) -- L is deliberately zero,
// because the pages from mmap are zeroed, and "L" is the default of
// DerivedBidiClass.txt for everything that has no line of its own.
const BIDI_L: u8 = 0
const BIDI_R: u8 = 1
const BIDI_AL: u8 = 2
const BIDI_EN: u8 = 3
const BIDI_ES: u8 = 4
const BIDI_ET: u8 = 5
const BIDI_AN: u8 = 6
const BIDI_CS: u8 = 7
const BIDI_NSM: u8 = 8
const BIDI_BN: u8 = 9
const BIDI_B: u8 = 10
const BIDI_S: u8 = 11
const BIDI_WS: u8 = 12
const BIDI_ON: u8 = 13
const BIDI_LRE: u8 = 14
const BIDI_LRO: u8 = 15
const BIDI_RLE: u8 = 16
const BIDI_RLO: u8 = 17
const BIDI_PDF: u8 = 18
const BIDI_LRI: u8 = 19
const BIDI_RLI: u8 = 20
const BIDI_FSI: u8 = 21
const BIDI_PDI: u8 = 22
const BIDI_COUNT: u8 = 23

// THE JOINING TYPE (ArabicShaping.txt, column 2). U joins with
// nothing, R only with the predecessor (alif, dal, waw ...), L only with the
// successor, D to both sides, C joins without itself having a
// shape (tatweel, ZWJ), T is transparent (the vowel signs) and is
// skipped when looking for the neighbour.
const JOIN_U: u8 = 0
const JOIN_R: u8 = 1
const JOIN_L: u8 = 2
const JOIN_D: u8 = 3
const JOIN_C: u8 = 4
const JOIN_T: u8 = 5

const BRACKET_NONE: u8 = 0
const BRACKET_OPEN: u8 = 1
const BRACKET_CLOSE: u8 = 2

// The four positional forms of an Arabic letter. The same
// order as the OpenType features isol/fina/init/medi.
const FORM_ISOL: u32 = 0
const FORM_FINA: u32 = 1
const FORM_INIT: u32 = 2
const FORM_MEDI: u32 = 3

const MAX_CP: u32 = 0x110000

// THE THREE READ WIDTHS, without rt.ld*: the measuring paths of lib/fui/painter.fi
// are #[no_gc], and the promise applies to the whole call tree --
// a query here must therefore keep it too.
#[no_gc]
fn l8(p: u64, i: usize) -> u8 {
    return *((p + i as u64) as *mut u8)
}

#[no_gc]
fn l16(p: u64, i: usize) -> u16 {
    return *((p + (i * 2) as u64) as *mut u16)
}

#[no_gc]
fn l64(p: u64, i: usize) -> u64 {
    return *((p + (i * 8) as u64) as *mut u64)
}

fn ucd_bidi_bytes() -> usize {
    return bidi_tables.BYTES
}

// Maps the table and fills it. 0 means failed.
fn ucd_bidi_map() -> u64 {
    let r: i64 = syscall(SYS_MMAP, 0, bidi_tables.BYTES as i64,
        PROT_READ_WRITE, MAP_FLAGS, 0 - 1, 0)
    if r <= 0 {
        return 0
    }
    bidi_tables.load(r as *mut u8)
    return r as u64
}

fn ucd_bidi_free(t: u64) {
    if t == 0 {
        return
    }
    syscall(SYS_MUNMAP, t as i64, bidi_tables.BYTES as i64, 0, 0, 0, 0)
}

// THE OCTET OF A CODE POINT: three load instructions, no loop.
#[no_gc]
fn ucd_bidi_octet(t: u64, cp: u32) -> u8 {
    if t == 0 || cp >= MAX_CP {
        return 0 as u8
    }
    let c: usize = cp as usize
    let b2: usize = l8(t, bidi_tables.OFF_L1 + (c >> 9)) as usize
    let b3: usize = l16(t + bidi_tables.OFF_L2 as u64,
        b2 * 32 + ((c >> 4) & 31)) as usize
    return l8(t, bidi_tables.OFF_L3 + b3 * 16 + (c & 15))
}

#[no_gc]
fn ucd_bidi_class(t: u64, cp: u32) -> u8 {
    return ucd_bidi_octet(t, cp) & 31 as u8
}

#[no_gc]
fn ucd_joining(t: u64, cp: u32) -> u8 {
    return (ucd_bidi_octet(t, cp) >> 5) & 7 as u8
}

// ------------------------------------------------------ mirror pairs
//
// One entry per character with Bidi_Mirroring_Glyph, sorted by the
// code point, one u64:
//
//   Bit  0..20   the code point
//   Bit 21..41   its mirror image (0 = none, the character is nevertheless
//                a bracket character -- that does not occur in 17.0.0,
//                but is not ruled out)
//   Bit 42..43   the bracket kind from BidiBrackets.txt (BRACKET_*)
//   Bit 44..59   the canonical equivalent of a bracket (U+2329 is
//                canonically U+3008), 0 = the character itself. BD16 of
//                UAX #9 demands comparing brackets via this equivalent.
#[no_gc]
fn mir_find(t: u64, cp: u32) -> u64 {
    if t == 0 {
        return 0
    }
    var lo: usize = 0
    var hi: usize = bidi_tables.MIR_N
    let c: u64 = cp as u64
    while lo < hi {
        let mid: usize = (lo + hi) / 2
        let e: u64 = l64(t + bidi_tables.OFF_MIR as u64, mid)
        let k: u64 = e & 0x1FFFFF
        if k == c {
            return e
        }
        if k < c {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return 0
}

// The mirror image for rule L4, or the code point itself.
#[no_gc]
fn ucd_mirror(t: u64, cp: u32) -> u32 {
    let e: u64 = mir_find(t, cp)
    let m: u32 = ((e >> 21) & 0x1FFFFF) as u32
    if m == 0 as u32 {
        return cp
    }
    return m
}

#[no_gc]
fn ucd_bracket_type(t: u64, cp: u32) -> u8 {
    let e: u64 = mir_find(t, cp)
    return ((e >> 42) & 3) as u8
}

// The counterpart of a bracket (Bidi_Paired_Bracket), 0 if none.
#[no_gc]
fn ucd_bracket_pair(t: u64, cp: u32) -> u32 {
    let e: u64 = mir_find(t, cp)
    if ((e >> 42) & 3) == 0 {
        return 0
    }
    return ((e >> 21) & 0x1FFFFF) as u32
}

// The form under which two brackets are compared (BD16).
#[no_gc]
fn ucd_bracket_canon(t: u64, cp: u32) -> u32 {
    let e: u64 = mir_find(t, cp)
    let k: u32 = ((e >> 44) & 0xFFFF) as u32
    if k == 0 as u32 {
        return cp
    }
    return k
}

// ------------------------------------------- Arabic presentation forms
//
// ONLY FOR THE APPROXIMATION WITHOUT GSUB. The forms stand in UnicodeData.txt
// as a decomposition (`<initial> 0628`), and the generator has collected them per
// base letter: two u64 per entry,
//
//   Word 0   base | isolated << 16 | final << 32 | initial << 48
//   Word 1   medial
//
// 0 means "this form does not exist for this letter".
#[no_gc]
fn ucd_arabic_form(t: u64, cp: u32, form: u32) -> u32 {
    if t == 0 || cp > 0xFFFF as u32 {
        return 0
    }
    var lo: usize = 0
    var hi: usize = bidi_tables.FORM_N
    let c: u64 = cp as u64
    while lo < hi {
        let mid: usize = (lo + hi) / 2
        let w0: u64 = l64(t + bidi_tables.OFF_FORM as u64, mid * 2)
        let k: u64 = w0 & 0xFFFF
        if k == c {
            if form == FORM_MEDI {
                return l64(t + bidi_tables.OFF_FORM as u64,
                    mid * 2 + 1) as u32
            }
            return ((w0 >> (16 * (form + 1) as u64)) & 0xFFFF) as u32
        }
        if k < c {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return 0
}

// The two-letter ligature of `a` and `b` in the form `form` (only FORM_ISOL
// and FORM_FINA are kept), 0 if it does not exist. An entry:
//   a | b << 16 | isolated << 32 | final << 48
#[no_gc]
fn ucd_arabic_ligature(t: u64, a: u32, b: u32, form: u32) -> u32 {
    if t == 0 || a > 0xFFFF as u32 || b > 0xFFFF as u32 {
        return 0
    }
    let key: u64 = (a as u64) | ((b as u64) << 16)
    var lo: usize = 0
    var hi: usize = bidi_tables.LIG_N
    while lo < hi {
        let mid: usize = (lo + hi) / 2
        let e: u64 = l64(t + bidi_tables.OFF_LIG as u64, mid)
        let k: u64 = e & 0xFFFFFFFF
        if k == key {
            if form == FORM_ISOL {
                return ((e >> 32) & 0xFFFF) as u32
            }
            if form == FORM_FINA {
                return ((e >> 48) & 0xFFFF) as u32
            }
            return 0
        }
        if k < key {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return 0
}
