// SPDX-License-Identifier: MPL-2.0
// lib/jpeg/jpeg.fi -- a JPEG decoder: baseline and progressive, to RGBA.
//
// OpenPlan LIB-010 (image import F-IEX-018, pictures on pages): photos of
// plants and nameplates are JPEG. PNG existed (lib/paint/png.fi); this is
// the other half.
//
//     import jpeg.jpeg
//     var im: jpeg.JpegImage = jpeg.jpeg_image_new()
//     jpeg.jpeg_decode(p, n, &im) catch |e| ...      // im.w, im.h, im.px (RGBA)
//     jpeg.jpeg_image_free(&im)
//
// WHAT IT READS: ITU T.81 with Huffman coding -- baseline (SOF0), extended
// sequential 8-bit (SOF1) and progressive (SOF2) -- with any sampling
// factors (4:4:4, 4:2:2, 4:2:0, 4:4:0, 4:1:1), restart intervals, one to
// four components (grey, YCbCr, RGB, CMYK/YCCK as Adobe writes them), and
// the EXIF orientation, which is applied so that the picture stands the
// way the camera was held. Refused: arithmetic coding, lossless and
// hierarchical JPEG, 12-bit samples (`JpegError::Unsupported`).
//
// THE SAME PIXELS AS libjpeg: the inverse DCT is libjpeg's "islow"
// (jidctint.c: fixed point, 13 fraction bits, the same rounding), chroma
// is upsampled "fancy" (triangular, jdsample.c) where libjpeg does it and
// replicated where it does not, and YCbCr -> RGB uses jdcolor.c's
// fixed-point tables. tools/libmvp/check_jpeg.py decodes a set of images
// with this file and with Pillow (libjpeg-turbo) and compares every pixel.
//
// LIMITS: 65535 x 65535 by the format, and at most `JPEG_MAX_PIXELS`
// (50 megapixels) unless `jpeg_decode_limited` is given another bound --
// all coefficients of a progressive image have to be held at once (128
// octets per 64 pixels and component).

import std.rt
import std.vec

export {
    JpegImage, JpegError,
    jpeg_image_new, jpeg_image_free, jpeg_decode, jpeg_decode_limited, jpeg_info,
    JPEG_MAX_PIXELS,
}

error JpegError {
    NotJpeg, // no SOI marker
    Corrupt, // a segment or the entropy-coded data contradicts itself
    Unsupported, // arithmetic, lossless, hierarchical, 12-bit
    TooLarge, // over the pixel limit
    OutOfMemory,
}

const JPEG_MAX_PIXELS: u64 = 50000000

struct JpegImage {
    w: u32,
    h: u32,
    px: rt.Buf, // w * h * 4 octets, RGBA, row 0 at the top
    orientation: u32, // the EXIF orientation that was applied (1 = none)
}

fn jpeg_image_new() -> JpegImage {
    return JpegImage { w: 0, h: 0, px: rt.buf_new(), orientation: 1 }
}

fn jpeg_image_free(im: *mut JpegImage) {
    rt.buf_free(&(*im).px)
    (*im).w = 0
    (*im).h = 0
}

// the zigzag order: position k of the coded sequence -> index in the block
fn zz(k: u32) -> u32 {
    let t: str = "\u{0}\u{1}\u{8}\u{10}\u{9}\u{2}\u{3}\u{a}\u{11}\u{18}\u{20}\u{19}\u{12}\u{b}\u{4}\u{5}\u{c}\u{13}\u{1a}\u{21}\u{28}\u{30}\u{29}\u{22}\u{1b}\u{14}\u{d}\u{6}\u{7}\u{e}\u{15}\u{1c}\u{23}\u{2a}\u{31}\u{38}\u{39}\u{32}\u{2b}\u{24}\u{1d}\u{16}\u{f}\u{17}\u{1e}\u{25}\u{2c}\u{33}\u{3a}\u{3b}\u{34}\u{2d}\u{26}\u{1f}\u{27}\u{2e}\u{35}\u{3c}\u{3d}\u{36}\u{2f}\u{37}\u{3e}\u{3f}"
    return rt.ld8(t.p as u64, k as usize) as u32
}

// ------------------------------------------------------------ Structures

struct Huff {
    // canonical code: for each length 1..16 the largest code and the index
    // of its first value
    maxcode: [i32; 18],
    valptr: [i32; 17],
    mincode: [i32; 17],
    vals: [u8; 256],
    // 9-bit lookahead: length << 8 | value, 0 = longer code
    fast: [u16; 512],
    ok: bool,
}

struct Comp {
    id: u32,
    h: u32,
    v: u32,
    tq: u32,
    bw: u32, // blocks per row (padded to the MCU)
    bh: u32,
    bw_real: u32, // blocks that hold image data (ceil(width / 8))
    bh_real: u32,
    coefs: u64, // bw * bh * 64 i16
    dc_tab: u32,
    ac_tab: u32,
    pred: i32,
}

struct Dec {
    p: u64,
    n: usize,
    pos: usize, // read position in the segment stream
    // the frame
    w: u32,
    h: u32,
    ncomp: u32,
    comps: [Comp; 4],
    hmax: u32,
    vmax: u32,
    mcux: u32,
    mcuy: u32,
    progressive: bool,
    qt: [u16; 256], // 4 tables of 64, in zigzag order
    qt_ok: [bool; 4],
    dc: [Huff; 4],
    ac: [Huff; 4],
    restart: u32,
    // bit reader
    bits: u64,
    nbits: u32,
    marker: u32, // a marker met in the entropy-coded data (0 = none)
    eobrun: u32,
    // colour
    adobe: i32, // -1 none, else the transform flag
    jfif: bool,
    orientation: u32,
    frame_seen: bool,
    bad: bool,
}

// ------------------------------------------------------------ Octets

fn u8at(d: *mut Dec, i: usize) -> u32 {
    if i >= (*d).n {
        (*d).bad = true
        return 0 as u32
    }
    return rt.ld8((*d).p, i) as u32
}

fn u16at(d: *mut Dec, i: usize) -> u32 {
    return (u8at(d, i) << 8) | u8at(d, i + 1)
}

// ------------------------------------------------------------ Huffman

fn huff_build(hf: *mut Huff, counts: u64, vals: u64, total: usize) -> bool {
    var code: i32 = 0
    var k: i32 = 0
    var len: usize = 1
    var i: usize = 0
    while i < 512 {
        (*hf).fast[i] = 0
        i = i + 1
    }
    i = 0
    while i < total {
        (*hf).vals[i] = rt.ld8(vals, i)
        i = i + 1
    }
    while len <= 16 {
        let c: i32 = rt.ld8(counts, len - 1) as i32
        (*hf).valptr[len] = k
        (*hf).mincode[len] = code
        if c > 0 {
            // fast table for codes up to 9 bits
            if len <= 9 {
                var j: i32 = 0
                while j < c {
                    let cd: i32 = code + j
                    let shift: usize = 9 - len
                    var f: i32 = 0
                    let entry: u16 = ((len << 8) as u32 | (*hf).vals[(k + j) as usize] as u32) as u16
                    while f < (1 << shift as u32) as i32 {
                        (*hf).fast[((cd << shift as u32) + f) as usize] = entry
                        f = f + 1
                    }
                    j = j + 1
                }
            }
            code = code + c
            k = k + c
            (*hf).maxcode[len] = code - 1
        } else {
            (*hf).maxcode[len] = -1
        }
        if code > (1 << len as u32) as i32 {
            return false // more codes than the length allows
        }
        code = code << 1
        len = len + 1
    }
    (*hf).maxcode[17] = 2147483647
    (*hf).ok = true
    return true
}

// ------------------------------------------------------------ Bits

fn fill(d: *mut Dec) {
    while (*d).nbits <= 56 {
        var b: u32 = 0
        if (*d).marker != 0 || (*d).pos >= (*d).n {
            b = 0 // past a marker or the end: zeros (T.81 F.2.2.5)
        } else {
            b = rt.ld8((*d).p, (*d).pos) as u32
            if b == 255 {
                var nx: u32 = 0
                if (*d).pos + 1 < (*d).n {
                    nx = rt.ld8((*d).p, (*d).pos + 1) as u32
                }
                if nx == 0 {
                    (*d).pos = (*d).pos + 2
                } else if nx == 255 {
                    (*d).pos = (*d).pos + 1 // fill octet
                    continue
                } else {
                    (*d).marker = nx
                    b = 0
                }
            } else {
                (*d).pos = (*d).pos + 1
            }
        }
        (*d).bits = (*d).bits | ((b as u64) << (56 - (*d).nbits) as u64)
        (*d).nbits = (*d).nbits + 8
    }
}

fn getbits(d: *mut Dec, n: u32) -> u32 {
    if n == 0 {
        return 0 as u32
    }
    if (*d).nbits < n {
        fill(d)
    }
    let v: u32 = ((*d).bits >> (64 - n) as u64) as u32
    (*d).bits = (*d).bits << n as u64
    (*d).nbits = (*d).nbits - n
    return v
}

fn getbit(d: *mut Dec) -> u32 {
    return getbits(d, 1 as u32)
}

// T.81 F.12: the value of `s` bits
fn extend(v: u32, s: u32) -> i32 {
    if s == 0 {
        return 0 as i32
    }
    if v < (1 << (s - 1)) {
        return v as i32 - (1 << s) as i32 + 1
    }
    return v as i32
}

fn decode(d: *mut Dec, hf: *mut Huff) -> i32 {
    if (*d).nbits < 16 {
        fill(d)
    }
    let look: u32 = ((*d).bits >> 55) as u32
    let e: u32 = (*hf).fast[look as usize] as u32
    if e != 0 {
        let len: u32 = e >> 8
        (*d).bits = (*d).bits << len as u64
        (*d).nbits = (*d).nbits - len
        return (e & 255) as i32
    }
    var code: i32 = 0
    var len: usize = 1
    while len <= 16 {
        code = (code << 1) | getbit(d) as i32
        if code <= (*hf).maxcode[len] && (*hf).maxcode[len] >= 0 {
            let idx: i32 = (*hf).valptr[len] + code - (*hf).mincode[len]
            if idx < 0 || idx > 255 {
                (*d).bad = true
                return 0 as i32
            }
            return (*hf).vals[idx as usize] as i32
        }
        len = len + 1
    }
    (*d).bad = true
    return 0 as i32
}

// the restart marker: align, expect RSTn, reset the predictors
fn restart(d: *mut Dec) {
    (*d).bits = 0
    (*d).nbits = 0
    if (*d).marker == 0 {
        // not met yet: look for it (skipping fill octets)
        while (*d).pos + 1 < (*d).n && !(rt.ld8((*d).p, (*d).pos) == 255 as u8 && rt.ld8((*d).p, (*d).pos + 1) != 0 as u8 && rt.ld8((*d).p, (*d).pos + 1) != 255 as u8) {
            (*d).pos = (*d).pos + 1
        }
        if (*d).pos + 1 < (*d).n {
            (*d).marker = rt.ld8((*d).p, (*d).pos + 1) as u32
        }
    }
    if (*d).marker >= 208 && (*d).marker <= 215 {
        (*d).pos = (*d).pos + 2
        (*d).marker = 0
    }
    // a missing restart marker is tolerated like libjpeg does: go on
    var c: usize = 0
    while c < 4 {
        (*d).comps[c].pred = 0
        c = c + 1
    }
    (*d).eobrun = 0
}

// ------------------------------------------------------------ Blocks

fn coef_ptr(c: *mut Comp, bx: u32, by: u32) -> u64 {
    return (*c).coefs + ((by * (*c).bw + bx) as u64) * 128
}

fn ld16s(p: u64, i: u32) -> i32 {
    let v: i32 = rt.ld16(p, i as usize) as i32
    if v >= 32768 {
        return v - 65536
    }
    return v
}

fn st16s(p: u64, i: u32, v: i32) {
    var x: i32 = v
    if x < -32768 { x = -32768 }
    if x > 32767 { x = 32767 }
    if x < 0 {
        rt.st16(p, i as usize, (x + 65536) as u16)
    } else {
        rt.st16(p, i as usize, x as u16)
    }
}

// one block of a sequential scan: all coefficients (in natural order)
fn block_seq(d: *mut Dec, c: *mut Comp, blk: u64) {
    let t: i32 = decode(d, &(*d).dc[(*c).dc_tab as usize])
    let diff: i32 = extend(getbits(d, t as u32), t as u32)
    (*c).pred = (*c).pred + diff
    st16s(blk, 0 as u32, (*c).pred)
    var k: u32 = 1
    while k < 64 {
        let rs: i32 = decode(d, &(*d).ac[(*c).ac_tab as usize])
        let r: u32 = (rs >> 4) as u32
        let s: u32 = (rs & 15) as u32
        if s == 0 {
            if r != 15 {
                return
            }
            k = k + 16
        } else {
            k = k + r
            if k > 63 {
                (*d).bad = true
                return
            }
            st16s(blk, zz(k), extend(getbits(d, s), s))
            k = k + 1
        }
    }
}

fn block_dc_first(d: *mut Dec, c: *mut Comp, blk: u64, al: u32) {
    let t: i32 = decode(d, &(*d).dc[(*c).dc_tab as usize])
    let diff: i32 = extend(getbits(d, t as u32), t as u32)
    (*c).pred = (*c).pred + diff
    st16s(blk, 0 as u32, (*c).pred * (1 << al) as i32)
}

fn block_dc_refine(d: *mut Dec, blk: u64, al: u32) {
    if getbit(d) != 0 {
        st16s(blk, 0 as u32, ld16s(blk, 0 as u32) | (1 << al) as i32)
    }
}

fn block_ac_first(d: *mut Dec, c: *mut Comp, blk: u64, ss: u32, se: u32, al: u32) {
    if (*d).eobrun > 0 {
        (*d).eobrun = (*d).eobrun - 1
        return
    }
    var k: u32 = ss
    while k <= se {
        let rs: i32 = decode(d, &(*d).ac[(*c).ac_tab as usize])
        let r: u32 = (rs >> 4) as u32
        let s: u32 = (rs & 15) as u32
        if s != 0 {
            k = k + r
            if k > 63 {
                (*d).bad = true
                return
            }
            st16s(blk, zz(k), extend(getbits(d, s), s) * (1 << al) as i32)
        } else {
            if r < 15 {
                (*d).eobrun = (1 << r) as u32
                if r > 0 {
                    (*d).eobrun = (*d).eobrun + getbits(d, r)
                }
                (*d).eobrun = (*d).eobrun - 1
                return
            }
            k = k + 15
        }
        k = k + 1
    }
}

// jdphuff.c decode_mcu_AC_refine, for one block
fn block_ac_refine(d: *mut Dec, c: *mut Comp, blk: u64, ss: u32, se: u32, al: u32) {
    let p1: i32 = (1 << al) as i32
    let m1: i32 = 0 - p1
    var k: u32 = ss
    if (*d).eobrun == 0 {
        while k <= se {
            let rs: i32 = decode(d, &(*d).ac[(*c).ac_tab as usize])
            var r: i32 = rs >> 4
            let s0: i32 = rs & 15
            var s: i32 = 0
            if s0 != 0 {
                if s0 != 1 {
                    (*d).bad = true
                }
                if getbit(d) != 0 {
                    s = p1
                } else {
                    s = m1
                }
            } else if r != 15 {
                (*d).eobrun = (1 << r as u32) as u32
                if r > 0 {
                    (*d).eobrun = (*d).eobrun + getbits(d, r as u32)
                }
                break
            }
            // advance over the coefficients that already have a value and
            // `r` that do not
            while k <= se {
                let at: u32 = zz(k)
                let cur: i32 = ld16s(blk, at)
                if cur != 0 {
                    if getbit(d) != 0 {
                        if (cur & p1) == 0 {
                            if cur >= 0 {
                                st16s(blk, at, cur + p1)
                            } else {
                                st16s(blk, at, cur + m1)
                            }
                        }
                    }
                } else {
                    r = r - 1
                    if r < 0 {
                        break
                    }
                }
                k = k + 1
            }
            if s != 0 && k <= se {
                st16s(blk, zz(k), s)
            }
            k = k + 1
        }
    }
    if (*d).eobrun > 0 {
        while k <= se {
            let at: u32 = zz(k)
            let cur: i32 = ld16s(blk, at)
            if cur != 0 {
                if getbit(d) != 0 {
                    if (cur & p1) == 0 {
                        if cur >= 0 {
                            st16s(blk, at, cur + p1)
                        } else {
                            st16s(blk, at, cur + m1)
                        }
                    }
                }
            }
            k = k + 1
        }
        (*d).eobrun = (*d).eobrun - 1
    }
}

// one scan
fn scan(d: *mut Dec, ns: u32, sel: *mut [u32; 4], ss: u32, se: u32, ah: u32, al: u32) {
    var i: u32 = 0
    while i < 4 {
        (*d).comps[i as usize].pred = 0
        i = i + 1
    }
    (*d).eobrun = 0
    (*d).bits = 0
    (*d).nbits = 0
    (*d).marker = 0
    let prog: bool = (*d).progressive
    var todo: u32 = (*d).restart
    if ns == 1 {
        // non-interleaved: the component's own blocks, in raster order
        let c: *mut Comp = &(*d).comps[(*sel)[0] as usize]
        var by: u32 = 0
        while by < (*c).bh_real && !(*d).bad {
            var bx: u32 = 0
            while bx < (*c).bw_real && !(*d).bad {
                if (*d).restart > 0 {
                    if todo == 0 {
                        restart(d)
                        todo = (*d).restart
                    }
                    todo = todo - 1
                }
                let blk: u64 = coef_ptr(c, bx, by)
                if !prog {
                    block_seq(d, c, blk)
                } else if ss == 0 {
                    if ah == 0 {
                        block_dc_first(d, c, blk, al)
                    } else {
                        block_dc_refine(d, blk, al)
                    }
                } else if ah == 0 {
                    block_ac_first(d, c, blk, ss, se, al)
                } else {
                    block_ac_refine(d, c, blk, ss, se, al)
                }
                bx = bx + 1
            }
            by = by + 1
        }
        return
    }
    var my: u32 = 0
    while my < (*d).mcuy && !(*d).bad {
        var mx: u32 = 0
        while mx < (*d).mcux && !(*d).bad {
            if (*d).restart > 0 {
                if todo == 0 {
                    restart(d)
                    todo = (*d).restart
                }
                todo = todo - 1
            }
            var k: u32 = 0
            while k < ns {
                let c: *mut Comp = &(*d).comps[(*sel)[k as usize] as usize]
                var v: u32 = 0
                while v < (*c).v {
                    var h: u32 = 0
                    while h < (*c).h {
                        let blk: u64 = coef_ptr(c, mx * (*c).h + h, my * (*c).v + v)
                        if !prog {
                            block_seq(d, c, blk)
                        } else if ah == 0 {
                            block_dc_first(d, c, blk, al)
                        } else {
                            block_dc_refine(d, blk, al)
                        }
                        h = h + 1
                    }
                    v = v + 1
                }
                k = k + 1
            }
            mx = mx + 1
        }
        my = my + 1
    }
}

// ------------------------------------------------------------ IDCT

// jidctint.c, jpeg_idct_islow: dequantize, 2-D inverse DCT, level shift,
// clamp -- into `out` (8 x 8 samples, row stride `stride`)
fn idct(blk: u64, q: *mut [u16; 256], qoff: u32, out: u64, stride: usize) {
    var ws: [i32; 64] = [0; 64]
    var col: u32 = 0
    while col < 8 {
        let q0: i32 = (*q)[(qoff + zzinv(col)) as usize] as i32
        let c0: i32 = ld16s(blk, col)
        let allzero: bool = ld16s(blk, col + 8) == 0 && ld16s(blk, col + 16) == 0 && ld16s(blk, col + 24) == 0 &&
        ld16s(blk, col + 32) == 0 && ld16s(blk, col + 40) == 0 && ld16s(blk, col + 48) == 0 && ld16s(blk, col + 56) == 0
        if allzero {
            let dcval: i32 = c0 * q0 * 4
            var r: u32 = 0
            while r < 8 {
                ws[(r * 8 + col) as usize] = dcval
                r = r + 1
            }
        } else {
            let i0: i32 = c0 * q0
            let i1: i32 = ld16s(blk, col + 8) * (*q)[(qoff + zzinv(col + 8)) as usize] as i32
            let i2: i32 = ld16s(blk, col + 16) * (*q)[(qoff + zzinv(col + 16)) as usize] as i32
            let i3: i32 = ld16s(blk, col + 24) * (*q)[(qoff + zzinv(col + 24)) as usize] as i32
            let i4: i32 = ld16s(blk, col + 32) * (*q)[(qoff + zzinv(col + 32)) as usize] as i32
            let i5: i32 = ld16s(blk, col + 40) * (*q)[(qoff + zzinv(col + 40)) as usize] as i32
            let i6: i32 = ld16s(blk, col + 48) * (*q)[(qoff + zzinv(col + 48)) as usize] as i32
            let i7: i32 = ld16s(blk, col + 56) * (*q)[(qoff + zzinv(col + 56)) as usize] as i32
            var t: [i32; 8] = [0; 8]
            idct1(i0, i1, i2, i3, i4, i5, i6, i7, &t, 11 as u32)
            var r: u32 = 0
            while r < 8 {
                ws[(r * 8 + col) as usize] = t[r as usize]
                r = r + 1
            }
        }
        col = col + 1
    }
    var row: u32 = 0
    while row < 8 {
        let b: usize = (row * 8) as usize
        let dst: u64 = out + (row as usize * stride) as u64
        let allzero: bool = ws[b + 1] == 0 && ws[b + 2] == 0 && ws[b + 3] == 0 && ws[b + 4] == 0 && ws[b + 5] == 0 &&
        ws[b + 6] == 0 && ws[b + 7] == 0
        if allzero {
            let v: u8 = clamp((ws[b] + 16) >> 5)
            var x: usize = 0
            while x < 8 {
                rt.st8(dst, x, v)
                x = x + 1
            }
        } else {
            var t: [i32; 8] = [0; 8]
            idct1(ws[b], ws[b + 1], ws[b + 2], ws[b + 3], ws[b + 4], ws[b + 5], ws[b + 6], ws[b + 7], &t, 18 as u32)
            var x: usize = 0
            while x < 8 {
                rt.st8(dst, x, clamp(t[x]))
                x = x + 1
            }
        }
        row = row + 1
    }
}

// the natural index -> zigzag position (the quantization tables are kept
// in zigzag order, as they are coded)
fn zzinv(i: u32) -> u32 {
    let t: str = "\u{0}\u{1}\u{5}\u{6}\u{e}\u{f}\u{1b}\u{1c}\u{2}\u{4}\u{7}\u{d}\u{10}\u{1a}\u{1d}\u{2a}\u{3}\u{8}\u{c}\u{11}\u{19}\u{1e}\u{29}\u{2b}\u{9}\u{b}\u{12}\u{18}\u{1f}\u{28}\u{2c}\u{35}\u{a}\u{13}\u{17}\u{20}\u{27}\u{2d}\u{34}\u{36}\u{14}\u{16}\u{21}\u{26}\u{2e}\u{33}\u{37}\u{3c}\u{15}\u{22}\u{25}\u{2f}\u{32}\u{38}\u{3b}\u{3d}\u{23}\u{24}\u{30}\u{31}\u{39}\u{3a}\u{3e}\u{3f}"
    return rt.ld8(t.p as u64, i as usize) as u32
}

fn clamp(v: i32) -> u8 {
    let x: i32 = v + 128
    if x < 0 {
        return 0 as u8
    }
    if x > 255 {
        return 255 as u8
    }
    return x as u8
}

// (x + 2^(n-1)) >> n, arithmetic
fn descale(x: i32, n: u32) -> i32 {
    return (x + (1 << (n - 1)) as i32) >> n
}

// one 8-point pass of jpeg_idct_islow; `sh` = 11 (pass 1) or 18 (pass 2)
fn idct1(i0: i32, i1: i32, i2: i32, i3: i32, i4: i32, i5: i32, i6: i32, i7: i32, out: *mut [i32; 8], sh: u32) {
    // even part
    var z2: i32 = i2
    var z3: i32 = i6
    var z1: i32 = (z2 + z3) * 4433
    let tmp2: i32 = z1 + z3 * (0 - 15137)
    let tmp3: i32 = z1 + z2 * 6270
    z2 = i0
    z3 = i4
    let t0: i32 = (z2 + z3) * 8192
    let t1: i32 = (z2 - z3) * 8192
    let tmp10: i32 = t0 + tmp3
    let tmp13: i32 = t0 - tmp3
    let tmp11: i32 = t1 + tmp2
    let tmp12: i32 = t1 - tmp2
    // odd part
    var o0: i32 = i7
    var o1: i32 = i5
    var o2: i32 = i3
    var o3: i32 = i1
    z1 = o0 + o3
    z2 = o1 + o2
    z3 = o0 + o2
    var z4: i32 = o1 + o3
    let z5: i32 = (z3 + z4) * 9633
    o0 = o0 * 2446
    o1 = o1 * 16819
    o2 = o2 * 25172
    o3 = o3 * 12299
    z1 = z1 * (0 - 7373)
    z2 = z2 * (0 - 20995)
    z3 = z3 * (0 - 16069)
    z4 = z4 * (0 - 3196)
    z3 = z3 + z5
    z4 = z4 + z5
    o0 = o0 + z1 + z3
    o1 = o1 + z2 + z4
    o2 = o2 + z2 + z3
    o3 = o3 + z1 + z4
    (*out)[0] = descale(tmp10 + o3, sh)
    (*out)[7] = descale(tmp10 - o3, sh)
    (*out)[1] = descale(tmp11 + o2, sh)
    (*out)[6] = descale(tmp11 - o2, sh)
    (*out)[2] = descale(tmp12 + o1, sh)
    (*out)[5] = descale(tmp12 - o1, sh)
    (*out)[3] = descale(tmp13 + o0, sh)
    (*out)[4] = descale(tmp13 - o0, sh)
}

// ------------------------------------------------------------ Markers

fn read_dqt(d: *mut Dec, at: usize, len: usize) -> bool {
    var i: usize = at
    let end: usize = at + len
    while i < end {
        let pq: u32 = u8at(d, i) >> 4
        let tq: u32 = u8at(d, i) & 15
        i = i + 1
        if tq > 3 || pq > 1 {
            return false
        }
        var k: u32 = 0
        while k < 64 {
            var v: u32 = 0
            if pq == 0 {
                v = u8at(d, i)
                i = i + 1
            } else {
                v = u16at(d, i)
                i = i + 2
            }
            (*d).qt[(tq * 64 + k) as usize] = v as u16
            k = k + 1
        }
        (*d).qt_ok[tq as usize] = true
    }
    return i == end && !(*d).bad
}

fn read_dht(d: *mut Dec, at: usize, len: usize) -> bool {
    var i: usize = at
    let end: usize = at + len
    while i < end {
        let tc: u32 = u8at(d, i) >> 4
        let th: u32 = u8at(d, i) & 15
        if tc > 1 || th > 3 || i + 17 > end {
            return false
        }
        var total: usize = 0
        var k: usize = 0
        while k < 16 {
            total = total + u8at(d, i + 1 + k) as usize
            k = k + 1
        }
        if total > 256 || i + 17 + total > end {
            return false
        }
        let counts: u64 = (*d).p + (i + 1) as u64
        let vals: u64 = (*d).p + (i + 17) as u64
        var ok: bool = false
        if tc == 0 {
            ok = huff_build(&(*d).dc[th as usize], counts, vals, total)
        } else {
            ok = huff_build(&(*d).ac[th as usize], counts, vals, total)
        }
        if !ok {
            return false
        }
        i = i + 17 + total
    }
    return i == end
}

// EXIF: the orientation tag (0x0112) of IFD0
fn read_exif(d: *mut Dec, at: usize, len: usize) {
    if len < 14 || u8at(d, at) != 69 || u8at(d, at + 1) != 120 || u8at(d, at + 2) != 105 || u8at(d, at + 3) != 102 {
        return
    }
    let t: usize = at + 6 // the TIFF header
    let tl: usize = len - 6
    let le: bool = u8at(d, t) == 73 // "II"
    let ifd: usize = rd32x(d, t + 4, le) as usize
    if ifd + 2 > tl {
        return
    }
    let count: usize = rd16x(d, t + ifd, le) as usize
    var k: usize = 0
    while k < count && ifd + 2 + (k + 1) * 12 <= tl {
        let e: usize = t + ifd + 2 + k * 12
        if rd16x(d, e, le) == 274 {
            let o: u32 = rd16x(d, e + 8, le)
            if o >= 1 && o <= 8 {
                (*d).orientation = o
            }
            return
        }
        k = k + 1
    }
}

fn rd16x(d: *mut Dec, i: usize, le: bool) -> u32 {
    if le {
        return u8at(d, i) | (u8at(d, i + 1) << 8)
    }
    return (u8at(d, i) << 8) | u8at(d, i + 1)
}

fn rd32x(d: *mut Dec, i: usize, le: bool) -> u32 {
    if le {
        return rd16x(d, i, true) | (rd16x(d, i + 2, true) << 16)
    }
    return (rd16x(d, i, false) << 16) | rd16x(d, i + 2, false)
}

fn read_sof(d: *mut Dec, at: usize, len: usize, max_pixels: u64) -> u32 {
    // 0 fine, 1 corrupt, 2 unsupported, 3 too large, 4 memory
    if len < 6 || (*d).frame_seen {
        return 1 as u32
    }
    (*d).frame_seen = true
    if u8at(d, at) != 8 {
        return 2 as u32 // 12-bit
    }
    (*d).h = u16at(d, at + 1)
    (*d).w = u16at(d, at + 3)
    (*d).ncomp = u8at(d, at + 5)
    if (*d).w == 0 || (*d).h == 0 {
        return 1 as u32 // DNL-defined height: not supported
    }
    if (*d).ncomp == 0 || (*d).ncomp > 4 || len < 6 + (*d).ncomp as usize * 3 {
        return 1 as u32
    }
    if (*d).w as u64 * (*d).h as u64 > max_pixels {
        return 3 as u32
    }
    (*d).hmax = 1
    (*d).vmax = 1
    var i: u32 = 0
    while i < (*d).ncomp {
        let o: usize = at + 6 + (i * 3) as usize
        let c: *mut Comp = &(*d).comps[i as usize]
        (*c).id = u8at(d, o)
        (*c).h = u8at(d, o + 1) >> 4
        (*c).v = u8at(d, o + 1) & 15
        (*c).tq = u8at(d, o + 2)
        if (*c).h < 1 || (*c).h > 4 || (*c).v < 1 || (*c).v > 4 || (*c).tq > 3 {
            return 1 as u32
        }
        if (*c).h > (*d).hmax { (*d).hmax = (*c).h }
        if (*c).v > (*d).vmax { (*d).vmax = (*c).v }
        i = i + 1
    }
    (*d).mcux = ((*d).w + 8 * (*d).hmax - 1) / (8 * (*d).hmax)
    (*d).mcuy = ((*d).h + 8 * (*d).vmax - 1) / (8 * (*d).vmax)
    i = 0
    while i < (*d).ncomp {
        let c: *mut Comp = &(*d).comps[i as usize]
        (*c).bw = (*d).mcux * (*c).h
        (*c).bh = (*d).mcuy * (*c).v
        (*c).bw_real = (((*d).w * (*c).h + (*d).hmax - 1) / (*d).hmax + 7) / 8
        (*c).bh_real = (((*d).h * (*c).v + (*d).vmax - 1) / (*d).vmax + 7) / 8
        let bytes: usize = ((*c).bw * (*c).bh) as usize * 128
        (*c).coefs = rt.heap_alloc(bytes) // zeroed
        if (*c).coefs == 0 {
            return 4 as u32
        }
        i = i + 1
    }
    return 0 as u32
}

fn free_coefs(d: *mut Dec) {
    var i: u32 = 0
    while i < 4 {
        let c: *mut Comp = &(*d).comps[i as usize]
        if (*c).coefs != 0 {
            rt.heap_free((*c).coefs, ((*c).bw * (*c).bh) as usize * 128)
            (*c).coefs = 0
        }
        i = i + 1
    }
}

fn read_sos(d: *mut Dec, at: usize, len: usize) -> bool {
    if !(*d).frame_seen || len < 1 {
        return false
    }
    let ns: u32 = u8at(d, at)
    if ns < 1 || ns > 4 || len != 4 + ns as usize * 2 {
        return false
    }
    var sel: [u32; 4] = [0 as u32; 4]
    var k: u32 = 0
    while k < ns {
        let cid: u32 = u8at(d, at + 1 + (k * 2) as usize)
        let tabs: u32 = u8at(d, at + 2 + (k * 2) as usize)
        var found: i64 = -1
        var i: u32 = 0
        while i < (*d).ncomp {
            if (*d).comps[i as usize].id == cid {
                found = i as i64
            }
            i = i + 1
        }
        if found < 0 {
            return false
        }
        let c: *mut Comp = &(*d).comps[found as usize]
        (*c).dc_tab = tabs >> 4
        (*c).ac_tab = tabs & 15
        if (*c).dc_tab > 3 || (*c).ac_tab > 3 {
            return false
        }
        sel[k as usize] = found as u32
        k = k + 1
    }
    let o: usize = at + 1 + (ns * 2) as usize
    let ss: u32 = u8at(d, o)
    let se: u32 = u8at(d, o + 1)
    let ah: u32 = u8at(d, o + 2) >> 4
    let al: u32 = u8at(d, o + 2) & 15
    if (*d).progressive {
        if ss > se || se > 63 || (ss == 0 && se != 0) || (ss > 0 && ns != 1) || al > 13 {
            return false
        }
    }
    // the tables the scan needs must be there
    k = 0
    while k < ns {
        let c: *mut Comp = &(*d).comps[sel[k as usize] as usize]
        let need_dc: bool = !(*d).progressive || ss == 0
        let need_ac: bool = !(*d).progressive || ss > 0
        if need_dc && ah == 0 && !(*d).dc[(*c).dc_tab as usize].ok {
            return false
        }
        if need_ac && !(*d).ac[(*c).ac_tab as usize].ok {
            return false
        }
        k = k + 1
    }
    (*d).pos = at + len
    scan(d, ns, &sel, ss, se, ah, al)
    if (*d).bad {
        return false
    }
    // continue after the entropy-coded data: at the marker it ended with
    if (*d).marker != 0 {
        // pos points at the 0xFF of that marker
        return true
    }
    // find the next marker
    while (*d).pos + 1 < (*d).n && !(rt.ld8((*d).p, (*d).pos) == 255 as u8 && rt.ld8((*d).p, (*d).pos + 1) != 0 as u8 && (rt.ld8((*d).p, (*d).pos + 1) < 208 as u8 || rt.ld8((*d).p, (*d).pos + 1) > 215 as u8)) {
        (*d).pos = (*d).pos + 1
    }
    return true
}

// ------------------------------------------------------------ Output

// the component planes, one sample per pixel of the component
fn planes(d: *mut Dec, out: *mut [u64; 4]) -> bool {
    var i: u32 = 0
    while i < (*d).ncomp {
        let c: *mut Comp = &(*d).comps[i as usize]
        let stride: usize = ((*c).bw * 8) as usize
        let size: usize = stride * ((*c).bh * 8) as usize
        let pl: u64 = rt.heap_alloc(size)
        if pl == 0 {
            return false
        }
        (*out)[i as usize] = pl
        let q: u32 = (*c).tq * 64
        var by: u32 = 0
        while by < (*c).bh {
            var bx: u32 = 0
            while bx < (*c).bw {
                idct(coef_ptr(c, bx, by), &(*d).qt, q, pl + (by as usize * 8 * stride + bx as usize * 8) as u64, stride)
                bx = bx + 1
            }
            by = by + 1
        }
        i = i + 1
    }
    return true
}

// A component plane brought to full size (w x h samples, stride w), with
// libjpeg's upsampling: fancy for 2:1 horizontally and/or vertically,
// replication otherwise.
fn upsample(d: *mut Dec, c: *mut Comp, pl: u64, full: u64) {
    let w: u32 = (*d).w
    let h: u32 = (*d).h
    let stride: u32 = (*c).bw * 8
    let hx: u32 = (*d).hmax / (*c).h
    let vx: u32 = (*d).vmax / (*c).v
    let dw: u32 = (w * (*c).h + (*d).hmax - 1) / (*d).hmax // downsampled size
    let dh: u32 = (h * (*c).v + (*d).vmax - 1) / (*d).vmax
    let exact: bool = hx * (*c).h == (*d).hmax && vx * (*c).v == (*d).vmax
    var y: u32 = 0
    if exact && hx == 1 && vx == 1 {
        while y < h {
            rt.mem_copy(full + (y * w) as u64, pl + (y * stride) as u64, w as usize)
            y = y + 1
        }
        return
    }
    let fancy_h: bool = exact && hx == 2 && dw > 2
    if exact && fancy_h && vx == 1 {
        // h2v1 fancy
        while y < h {
            let src: u64 = pl + (y * stride) as u64
            let dst: u64 = full + (y * w) as u64
            h2v1_row(src, dst, dw, w)
            y = y + 1
        }
        return
    }
    if exact && fancy_h && vx == 2 {
        // h2v2 fancy: every output row from its input row and the nearer
        // neighbour row (edge rows repeated)
        while y < h {
            let iy: u32 = y / 2
            var ny: u32 = iy
            if y % 2 == 0 {
                if iy > 0 { ny = iy - 1 }
            } else {
                if iy + 1 < dh { ny = iy + 1 }
            }
            let r0: u64 = pl + (iy * stride) as u64
            let r1: u64 = pl + (ny * stride) as u64
            let dst: u64 = full + (y * w) as u64
            var x: u32 = 0
            var this: i32 = rt.ld8(r0, 0) as i32 * 3 + rt.ld8(r1, 0) as i32
            var next: i32 = rt.ld8(r0, 1) as i32 * 3 + rt.ld8(r1, 1) as i32
            var last: i32 = this
            put_px(dst, 0, w, ((this * 4 + 8) >> 4) as u8)
            put_px(dst, 1, w, ((this * 3 + next + 7) >> 4) as u8)
            last = this
            this = next
            x = 1
            while x + 1 < dw {
                next = rt.ld8(r0, (x + 1) as usize) as i32 * 3 + rt.ld8(r1, (x + 1) as usize) as i32
                put_px(dst, x * 2, w, ((this * 3 + last + 8) >> 4) as u8)
                put_px(dst, x * 2 + 1, w, ((this * 3 + next + 7) >> 4) as u8)
                last = this
                this = next
                x = x + 1
            }
            put_px(dst, x * 2, w, ((this * 3 + last + 8) >> 4) as u8)
            put_px(dst, x * 2 + 1, w, ((this * 4 + 7) >> 4) as u8)
            y = y + 1
        }
        return
    }
    if exact && hx == 1 && vx == 2 {
        // h1v2 fancy (libjpeg-turbo): vertical triangle
        while y < h {
            let iy: u32 = y / 2
            var ny: u32 = iy
            var bias: i32 = 1
            if y % 2 == 0 {
                if iy > 0 { ny = iy - 1 }
            } else {
                if iy + 1 < dh { ny = iy + 1 }
                bias = 2
            }
            let r0: u64 = pl + (iy * stride) as u64
            let r1: u64 = pl + (ny * stride) as u64
            let dst: u64 = full + (y * w) as u64
            var x: u32 = 0
            while x < w {
                let v: i32 = rt.ld8(r0, x as usize) as i32 * 3 + rt.ld8(r1, x as usize) as i32
                rt.st8(dst, x as usize, ((v + bias) >> 2) as u8)
                x = x + 1
            }
            y = y + 1
        }
        return
    }
    // replication
    while y < h {
        var sy: u32 = y * (*c).v / (*d).vmax
        let dst: u64 = full + (y * w) as u64
        var x: u32 = 0
        while x < w {
            let sx: u32 = x * (*c).h / (*d).hmax
            rt.st8(dst, x as usize, rt.ld8(pl + (sy * stride) as u64, sx as usize))
            x = x + 1
        }
        y = y + 1
    }
}

fn put_px(dst: u64, x: u32, w: u32, v: u8) {
    if x < w {
        rt.st8(dst, x as usize, v)
    }
}

fn h2v1_row(src: u64, dst: u64, dw: u32, w: u32) {
    var inv: i32 = rt.ld8(src, 0) as i32
    put_px(dst, 0, w, inv as u8)
    put_px(dst, 1, w, ((inv * 3 + rt.ld8(src, 1) as i32 + 2) >> 2) as u8)
    var x: u32 = 1
    while x + 1 < dw {
        inv = rt.ld8(src, x as usize) as i32 * 3
        put_px(dst, x * 2, w, ((inv + rt.ld8(src, (x - 1) as usize) as i32 + 1) >> 2) as u8)
        put_px(dst, x * 2 + 1, w, ((inv + rt.ld8(src, (x + 1) as usize) as i32 + 2) >> 2) as u8)
        x = x + 1
    }
    inv = rt.ld8(src, x as usize) as i32
    put_px(dst, x * 2, w, ((inv * 3 + rt.ld8(src, (x - 1) as usize) as i32 + 1) >> 2) as u8)
    put_px(dst, x * 2 + 1, w, inv as u8)
}

fn clamp255(v: i32) -> u8 {
    if v < 0 { return 0 as u8 }
    if v > 255 { return 255 as u8 }
    return v as u8
}

// jdcolor.c ycc_rgb_convert, fixed point with 16 fraction bits
fn ycc(y: i32, cb: i32, cr: i32, px: u64) {
    let x: i32 = cr - 128
    let z: i32 = cb - 128
    let rr: i32 = (91881 * x + 32768) >> 16
    let bb: i32 = (116130 * z + 32768) >> 16
    let gg: i32 = ((0 - 22554) * z + 32768 + (0 - 46802) * x) >> 16
    rt.st8(px, 0, clamp255(y + rr))
    rt.st8(px, 1, clamp255(y + gg))
    rt.st8(px, 2, clamp255(y + bb))
    rt.st8(px, 3, 255 as u8)
}

fn to_rgba(d: *mut Dec, full: *mut [u64; 4], im: *mut JpegImage) -> bool {
    let n: usize = (*d).w as usize * (*d).h as usize
    rt.buf_clear(&(*im).px)
    rt.buf_reserve(&(*im).px, n * 4)
    if (*im).px.cap < n * 4 {
        return false
    }
    rt.buf_set_len(&(*im).px, n * 4)
    let out: u64 = rt.buf_ptr(&(*im).px)
    let nc: u32 = (*d).ncomp
    // the colour space, as libjpeg decides it (jdapimin.c)
    var rgb: bool = false
    if nc == 3 && !(*d).jfif {
        if (*d).adobe == 0 {
            rgb = true
        } else if (*d).adobe < 0 && (*d).comps[0].id == 82 && (*d).comps[1].id == 71 && (*d).comps[2].id == 66 {
            rgb = true
        }
    }
    var i: usize = 0
    while i < n {
        let px: u64 = out + (i * 4) as u64
        if nc == 1 {
            let g: u8 = rt.ld8((*full)[0], i)
            rt.st8(px, 0, g)
            rt.st8(px, 1, g)
            rt.st8(px, 2, g)
            rt.st8(px, 3, 255 as u8)
        } else if nc == 3 && rgb {
            rt.st8(px, 0, rt.ld8((*full)[0], i))
            rt.st8(px, 1, rt.ld8((*full)[1], i))
            rt.st8(px, 2, rt.ld8((*full)[2], i))
            rt.st8(px, 3, 255 as u8)
        } else if nc == 3 {
            ycc(rt.ld8((*full)[0], i) as i32, rt.ld8((*full)[1], i) as i32, rt.ld8((*full)[2], i) as i32, px)
        } else if nc == 4 {
            // Adobe CMYK is stored inverted; YCCK (transform 2) is YCbCr + K
            var c: i32 = rt.ld8((*full)[0], i) as i32
            var m: i32 = rt.ld8((*full)[1], i) as i32
            var ye: i32 = rt.ld8((*full)[2], i) as i32
            let k: i32 = rt.ld8((*full)[3], i) as i32
            if (*d).adobe == 2 {
                ycc(c, m, ye, px)
                c = 255 - rt.ld8(px, 0) as i32
                m = 255 - rt.ld8(px, 1) as i32
                ye = 255 - rt.ld8(px, 2) as i32
            }
            rt.st8(px, 0, (c * k / 255) as u8)
            rt.st8(px, 1, (m * k / 255) as u8)
            rt.st8(px, 2, (ye * k / 255) as u8)
            rt.st8(px, 3, 255 as u8)
        } else {
            // two components: grey plus something -- show the first
            let g: u8 = rt.ld8((*full)[0], i)
            rt.st8(px, 0, g)
            rt.st8(px, 1, g)
            rt.st8(px, 2, g)
            rt.st8(px, 3, 255 as u8)
        }
        i = i + 1
    }
    (*im).w = (*d).w
    (*im).h = (*d).h
    return true
}

// EXIF orientation 2..8 applied to the RGBA pixels
fn orient(im: *mut JpegImage, o: u32) -> bool {
    if o <= 1 || o > 8 {
        return true
    }
    let w: u32 = (*im).w
    let h: u32 = (*im).h
    var nw: u32 = w
    var nh: u32 = h
    if o >= 5 {
        nw = h
        nh = w
    }
    var dst: rt.Buf = rt.buf_new()
    let n: usize = w as usize * h as usize * 4
    rt.buf_reserve(&dst, n)
    if dst.cap < n {
        return false
    }
    rt.buf_set_len(&dst, n)
    let s: u64 = rt.buf_ptr(&(*im).px)
    let t: u64 = rt.buf_ptr(&dst)
    var y: u32 = 0
    while y < nh {
        var x: u32 = 0
        while x < nw {
            // the source pixel of target (x, y)
            var sx: u32 = x
            var sy: u32 = y
            if o == 2 { sx = w - 1 - x }
            if o == 3 { sx = w - 1 - x
                sy = h - 1 - y }
            if o == 4 { sy = h - 1 - y }
            if o == 5 { sx = y
                sy = x }
            if o == 6 { sx = y
                sy = h - 1 - x }
            if o == 7 { sx = w - 1 - y
                sy = h - 1 - x }
            if o == 8 { sx = w - 1 - y
                sy = x }
            rt.st32(t, (y * nw + x) as usize, rt.ld32(s, (sy * w + sx) as usize))
            x = x + 1
        }
        y = y + 1
    }
    rt.buf_free(&(*im).px)
    (*im).px = dst
    (*im).w = nw
    (*im).h = nh
    (*im).orientation = o
    return true
}

// ------------------------------------------------------------ Entry

fn dec_new(p: u64, n: usize) -> Dec {
    let c: Comp = Comp { id: 0, h: 1, v: 1, tq: 0, bw: 0, bh: 0, bw_real: 0, bh_real: 0, coefs: 0, dc_tab: 0, ac_tab: 0, pred: 0 }
    let hf: Huff = Huff { maxcode: [0; 18], valptr: [0; 17], mincode: [0; 17], vals: [0 as u8; 256], fast: [0 as u16; 512], ok: false }
    return Dec { p: p, n: n, pos: 2, w: 0, h: 0, ncomp: 0, comps: [c, c, c, c], hmax: 1, vmax: 1, mcux: 0, mcuy: 0,
        progressive: false, qt: [0 as u16; 256], qt_ok: [false; 4], dc: [hf, hf, hf, hf], ac: [hf, hf, hf, hf],
        restart: 0, bits: 0, nbits: 0, marker: 0, eobrun: 0, adobe: -1, jfif: false, orientation: 1,
        frame_seen: false, bad: false }
}

// Width and height from the frame header, without decoding.
fn jpeg_info(p: u64, n: usize, w: *mut u32, h: *mut u32) -> bool {
    if n < 4 || rt.ld8(p, 0) != 255 as u8 || rt.ld8(p, 1) != 216 as u8 {
        return false
    }
    var i: usize = 2
    while i + 4 <= n {
        if rt.ld8(p, i) != 255 as u8 {
            return false
        }
        let m: u32 = rt.ld8(p, i + 1) as u32
        if m == 255 {
            i = i + 1
            continue
        }
        let len: usize = (rt.ld8(p, i + 2) as usize << 8) | rt.ld8(p, i + 3) as usize
        if (m >= 192 && m <= 207 && m != 196 && m != 200 && m != 204) && i + 9 <= n {
            *h = (rt.ld8(p, i + 5) as u32 << 8) | rt.ld8(p, i + 6) as u32
            *w = (rt.ld8(p, i + 7) as u32 << 8) | rt.ld8(p, i + 8) as u32
            return true
        }
        i = i + 2 + len
    }
    return false
}

fn jpeg_decode(p: u64, n: usize, im: *mut JpegImage) -> JpegError!bool {
    return try jpeg_decode_limited(p, n, JPEG_MAX_PIXELS, im)
}

// Decodes to RGBA in `im` (its buffer is reused). At most `max_pixels`.
fn jpeg_decode_limited(p: u64, n: usize, max_pixels: u64, im: *mut JpegImage) -> JpegError!bool {
    if n < 4 || rt.ld8(p, 0) != 255 as u8 || rt.ld8(p, 1) != 216 as u8 {
        return JpegError::NotJpeg
    }
    var d: Dec = dec_new(p, n)
    var err: u32 = 0 // 1 corrupt, 2 unsupported, 3 too large, 4 memory
    var done: bool = false
    var scans: u32 = 0
    while !done && err == 0 {
        // the next marker
        while d.pos < n && rt.ld8(p, d.pos) != 255 as u8 {
            d.pos = d.pos + 1 // garbage between segments: skip, as libjpeg does
        }
        while d.pos < n && rt.ld8(p, d.pos) == 255 as u8 {
            d.pos = d.pos + 1
        }
        if d.pos >= n {
            // no EOI: take what was decoded (a truncated file shows grey)
            break
        }
        let m: u32 = rt.ld8(p, d.pos) as u32
        d.pos = d.pos + 1
        if m == 217 { // EOI
            done = true
            break
        }
        if m >= 208 && m <= 215 {
            continue // a stray RST
        }
        if d.pos + 2 > n {
            err = 1
            break
        }
        let len: usize = (rt.ld8(p, d.pos) as usize << 8) | rt.ld8(p, d.pos + 1) as usize
        if len < 2 || d.pos + len > n {
            err = 1
            break
        }
        let at: usize = d.pos + 2
        let body: usize = len - 2
        d.pos = d.pos + len
        if m == 192 || m == 193 || m == 194 { // SOF0, SOF1, SOF2
            d.progressive = m == 194
            err = read_sof(&d, at, body, max_pixels)
        } else if m >= 195 && m <= 207 && m != 196 && m != 200 && m != 204 {
            err = 2 // lossless, hierarchical, arithmetic
        } else if m == 204 {
            err = 2 // DAC: arithmetic coding
        } else if m == 196 { // DHT
            if !read_dht(&d, at, body) { err = 1 }
        } else if m == 219 { // DQT
            if !read_dqt(&d, at, body) { err = 1 }
        } else if m == 221 { // DRI
            if body < 2 { err = 1 } else { d.restart = (rt.ld8(p, at) as u32 << 8) | rt.ld8(p, at + 1) as u32 }
        } else if m == 218 { // SOS
            if !read_sos(&d, at, body) {
                err = 1
            }
            scans = scans + 1
        } else if m == 224 { // APP0: JFIF
            if body >= 5 && rt.ld8(p, at) == 74 as u8 && rt.ld8(p, at + 1) == 70 as u8 && rt.ld8(p, at + 2) == 73 as u8 && rt.ld8(p, at + 3) == 70 as u8 {
                d.jfif = true
            }
        } else if m == 225 { // APP1: Exif
            read_exif(&d, at, body)
        } else if m == 238 { // APP14: Adobe
            if body >= 12 && rt.ld8(p, at) == 65 as u8 && rt.ld8(p, at + 1) == 100 as u8 {
                d.adobe = rt.ld8(p, at + 11) as i32
            }
        }
        // everything else (APPn, COM, ...) is skipped
    }
    if err == 0 && (!d.frame_seen || scans == 0) {
        err = 1
    }
    if err == 0 {
        var q: u32 = 0
        while q < d.ncomp {
            if !d.qt_ok[d.comps[q as usize].tq as usize] {
                err = 1
            }
            q = q + 1
        }
    }
    if err != 0 {
        free_coefs(&d)
        if err == 2 { return JpegError::Unsupported }
        if err == 3 { return JpegError::TooLarge }
        if err == 4 { return JpegError::OutOfMemory }
        return JpegError::Corrupt
    }
    // inverse DCT into planes, upsample, colour
    var pl: [u64; 4] = [0; 4]
    var full: [u64; 4] = [0; 4]
    var ok: bool = planes(&d, &pl)
    let npx: usize = d.w as usize * d.h as usize
    var i: u32 = 0
    while ok && i < d.ncomp {
        full[i as usize] = rt.heap_alloc(npx)
        if full[i as usize] == 0 {
            ok = false
        } else {
            upsample(&d, &d.comps[i as usize], pl[i as usize], full[i as usize])
        }
        i = i + 1
    }
    if ok {
        ok = to_rgba(&d, &full, im)
    }
    i = 0
    while i < 4 {
        let c: *mut Comp = &d.comps[i as usize]
        if pl[i as usize] != 0 {
            rt.heap_free(pl[i as usize], ((*c).bw * 8 * (*c).bh * 8) as usize)
        }
        if full[i as usize] != 0 {
            rt.heap_free(full[i as usize], npx)
        }
        i = i + 1
    }
    free_coefs(&d)
    (*im).orientation = 1
    if ok {
        ok = orient(im, d.orientation)
    }
    if !ok {
        return JpegError::OutOfMemory
    }
    return true
}
