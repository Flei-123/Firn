// SPDX-License-Identifier: MPL-2.0
// lib/jobs/jobs.fi -- jobs: a thread pool for CPU work (meshing, world
// generation, decoding) with chunked parallel loops, wait groups and join
// handles. The caller HELPS while it waits, so `T` threads of work need only
// `T - 1` workers and a nested wait can never deadlock.
//
//     import jobs.jobs
//
//     fn mesh_chunks(ctx: u64, lo: u64, hi: u64) {      // runs on any thread
//         var i: u64 = lo
//         while i < hi { build_mesh(ctx, i); i = i + 1 }
//     }
//
//     fn __thread_work(kind: u64, arg: u64) -> u64 {    // ONE line to wire it
//         if kind == jobs.WORKER_KIND { return jobs.worker_main(arg) }
//         return 0
//     }
//
//     // parallel map (results per index, no ctx struct, no raw pointers):
//     fn size_of_file(i: u64) -> u64 { ... }
//     var sizes: Vec[u64] = vec_new[u64]()
//     jobs_map[u64](&j, 100, size_of_file, &sizes)             // sizes[i] = f(i)
//     jobs_map_into[Digest](&j, 100, digest_of, &digests)       // fn(i, out: *mut Digest)
//     jobs_map_files[u64](&j, &paths, lines_in_file, &counts)   // fn(p: *str, out: *mut u64)
//
//     fn main() -> i32 {
//         var j: jobs.Jobs = jobs.create(7)             // 7 workers + the caller = 8 threads
//         jobs.parallel_for(&j, 0, 4096, 16, mesh_chunks, world_addr)
//         let t: u64 = jobs.spawn(&j, load_file, 5)     // a future
//         ...
//         let r: u64 = jobs.join(&j, t)                 // waits (and helps), then the result
//         jobs.destroy(&j)
//         return 0
//     }
//
// MODEL. A BATCH is a range [begin, end) cut into chunks plus a function
// `body(ctx, lo, hi)`. Batches sit in a FIFO under one futex lock. A thread
// (worker or a waiting caller) takes the NEXT CHUNK of the front batch under
// that lock -- a dozen instructions -- and runs it outside the lock. The batch
// leaves the queue when its last chunk has been taken, so a long batch is
// shared by everybody and a short one costs one queue visit. Finished items are
// counted in a GROUP (`pending`, a futex word); when it reaches 0 the waiter
// is woken. This is dynamic load balancing by chunk: a slow chunk never holds
// back the others, which is what stealing buys, without per-thread deques.
//
// HONEST
// J1  NO WORK STEALING (deque per thread), and the default queue is one LOCKED
//     queue with chunk claiming. Firn DOES have compare-and-swap:
//     `__atomic_swap(p, expected, new)` (compiler/src/thread.rs, x86-64 and
//     aarch64) returns the old value and stores `new` when it equals
//     `expected`. What is missing is the memory-reclamation half of a
//     Chase-Lev deque: a batch record that threads read while another frees it
//     needs hazard pointers or epochs. So `create` keeps the locked queue (it
//     is cheap while a chunk runs for more than ~1 us; `docs/JOBS.md` has the
//     measured per-task cost; pick `chunk` so a chunk is >= 20 us of work) and
//     `create_lf` adds a LOCK-FREE FAST PATH in front of it, see J8.
// J2  `ctx`, the arguments and everything `body` touches are numbers /
//     addresses. They must stay alive until the group is waited for; the
//     collector does not look into the queue (as in std.pool Q1). The thread
//     that waits holds `ctx` in its own frame, which is enough for
//     `parallel_for`; for `group_go` / `spawn` keep it referenced until the
//     `group_wait` / `join`.
// J3  `body` must not write to the same memory from two chunks unless it is
//     the caller's job to make that safe (disjoint [lo,hi) is the contract).
// J4  A `body` that computes for seconds without allocating or blocking
//     delays the collector like any thread (std.pool Q5): keep chunks short.
// J5  `create` asks for at most 255 workers (thread table: 1023 entries).
//     `create(0)` is legal: everything then runs on the caller inside the
//     wait -- the sequential baseline with the same code path.
// J6  Linux and Windows (futex on the Windows target is WaitOnAddress).
//     Counters in futex words stay below 2^32 (items per group < 4 billion).
// J7  `destroy` needs all groups waited for. A worker that is still inside a
//     `body` is joined, not killed.
// J8  `create_lf(workers)`: a bounded MPMC ring (Vyukov: one sequence word per
//     slot, enqueue/dequeue positions moved with `__atomic_swap` CAS) of CHUNK
//     DESCRIPTORS sits in front of the locked queue. `group_go` pushes one
//     descriptor per chunk (a batch of more than RING/2 chunks, or a ring that
//     is full, sends the rest to the locked queue as before); `spawn` pushes a
//     task descriptor. A thread takes work from the ring with no lock and no
//     futex, then from the locked queue. Slots are never freed (the ring is one
//     block), so no reclamation problem; every slot access is ordered by its
//     sequence word (a locked add = full barrier, also on aarch64). Same API,
//     same results; only the take path changes. The ring is a fast path for
//     many small chunks, not a load balancer of its own: dynamic balance
//     still comes from chunk-sized descriptors.

import std.rt
import std.vec

export {
    Jobs, WORKER_KIND,
    create, create_lf, lockfree, destroy, worker_main, worker_count,
    parallel_for, parallel_each,
    group_new, group_free, group_go, group_wait, group_pending,
    spawn, join, task_done, jobs_map, jobs_map_into, jobs_map_files,
    executed_by_workers, executed_by_callers,
}

// The thread kind of a jobs worker ("jobs" in ASCII).
const WORKER_KIND: u64 = 1650813811

const MINUS1: u64 = 18446744073709551615
const WORKERS_MAX: u64 = 255

// pool block, in 64 bit words
const P_LOCK: usize = 0
const P_SEQ: usize = 1 // futex word: bumped on every push, workers sleep on it
const P_HEAD: usize = 2
const P_TAIL: usize = 3
const P_STOP: usize = 4
const P_WORKERS: usize = 5
const P_EXEC_W: usize = 6 // chunks run by workers
const P_EXEC_C: usize = 7 // chunks run by callers while waiting
const P_HANDLES: usize = 8 // up to 255 thread handles
const P_RING: usize = 264 // lock-free ring block (create_lf), 0 = locked queue only
const P_WORDS: usize = 272

// lock-free ring (J8): header words, then RING_SLOTS slots of SLOT_WORDS words
const R_ENQ: usize = 0 // next position to enqueue
const R_DEQ: usize = 16 // next position to dequeue (another cache line)
const R_MASK: usize = 32
const R_SLOTS: usize = 48 // first slot
const RING_SLOTS: u64 = 1024
const SLOT_WORDS: usize = 8
const S_SEQ: usize = 0 // sequence word: pos = free for enqueue at pos, pos + 1 = filled, pos + RING_SLOTS = free again
const S_FN: usize = 1
const S_CTX: usize = 2
const S_LO: usize = 3
const S_HI: usize = 4
const S_GROUP: usize = 5
const S_KIND: usize = 6
const RING_WORDS: usize = 48 + 8 * 1024

// batch record, in words
const B_FN: usize = 0
const B_CTX: usize = 1
const B_NEXT_LO: usize = 2 // next index to hand out
const B_END: usize = 3
const B_CHUNK: usize = 4
const B_GROUP: usize = 5
const B_KIND: usize = 6 // 0 = body(ctx, lo, hi); 1 = fn(ctx) -> u64, result into the group
const B_LINK: usize = 7
const BATCH_WORDS: usize = 8

// group record, in words (the first word is the futex word)
const G_PENDING: usize = 0
const G_RESULT: usize = 1
const GROUP_WORDS: usize = 2

struct Jobs {
    blk: u64, // 0 = could not be created
}

fn lock_of(blk: u64) -> *mut u64 {
    return (blk + (P_LOCK * 8) as u64) as *mut u64
}

fn word_addr(base: u64, w: usize) -> u64 {
    return base + (w * 8) as u64
}

// Starts `workers` threads (0 to 255). `Jobs.blk == 0` when it did not work.
fn create(workers: u64) -> Jobs {
    return create_with(workers, false)
}

// Same, with the lock-free fast path of J8.
fn create_lf(workers: u64) -> Jobs {
    return create_with(workers, true)
}

fn lockfree(j: *mut Jobs) -> bool {
    return (*j).blk != 0 && rt.ld64((*j).blk, P_RING) != 0
}

fn create_with(workers: u64, lf: bool) -> Jobs {
    var w: u64 = workers
    if w > WORKERS_MAX {
        w = WORKERS_MAX
    }
    let blk: u64 = rt.heap_alloc(P_WORDS * 8)
    if blk == 0 {
        return Jobs { blk: 0 }
    }
    rt.mem_set(blk, 0 as u8, P_WORDS * 8)
    if lf {
        // before the first worker exists: they read P_RING without a lock
        let ring: u64 = rt.heap_alloc(RING_WORDS * 8)
        if ring != 0 {
            rt.mem_set(ring, 0 as u8, RING_WORDS * 8)
            rt.st64(ring, R_MASK, RING_SLOTS - 1)
            var i: u64 = 0
            while i < RING_SLOTS {
                rt.st64(ring, R_SLOTS + i as usize * SLOT_WORDS + S_SEQ, i)
                i = i + 1
            }
            rt.st64(blk, P_RING, ring)
        }
    }
    var started: u64 = 0
    while started < w {
        let h: u64 = thread_start(WORKER_KIND, blk)
        if h == 0 {
            break
        }
        rt.st64(blk, P_HANDLES + started as usize, h)
        started = started + 1
    }
    rt.st64(blk, P_WORKERS, started)
    return Jobs { blk: blk }
}

fn worker_count(j: *mut Jobs) -> u64 {
    if (*j).blk == 0 {
        return 0
    }
    return rt.ld64((*j).blk, P_WORKERS)
}

fn executed_by_workers(j: *mut Jobs) -> u64 {
    if (*j).blk == 0 {
        return 0
    }
    return rt.ld64((*j).blk, P_EXEC_W)
}

fn executed_by_callers(j: *mut Jobs) -> u64 {
    if (*j).blk == 0 {
        return 0
    }
    return rt.ld64((*j).blk, P_EXEC_C)
}

// ---------------------------------------------------------------- lock-free ring (J8)
// Acquire load: a locked add of 0 is a full barrier on x86-64 and aarch64.
fn aload(p: u64) -> u64 {
    return __atomic_add(p as *mut u64, 0)
}

fn slot_addr(ring: u64, pos: u64) -> u64 {
    return ring + ((R_SLOTS + (pos & (RING_SLOTS - 1)) as usize * SLOT_WORDS) * 8) as u64
}

// Queues one chunk descriptor. false = the ring is full.
fn ring_push(ring: u64, f: u64, ctx: u64, lo: u64, hi: u64, g: u64, kind: u64) -> bool {
    let enq: u64 = word_addr(ring, R_ENQ)
    var pos: u64 = rt.ld64(ring, R_ENQ)
    while true {
        let slot: u64 = slot_addr(ring, pos)
        let seq: u64 = aload(slot)
        if seq == pos {
            // free: claim the position
            if __atomic_swap(enq as *mut u64, pos, pos + 1) == pos {
                break
            }
            pos = rt.ld64(ring, R_ENQ)
        } else if seq < pos {
            return false // the slot still holds an entry of the previous lap: full
        } else {
            pos = rt.ld64(ring, R_ENQ) // somebody else took this position
        }
    }
    let slot: u64 = slot_addr(ring, pos)
    rt.st64(slot, S_FN, f)
    rt.st64(slot, S_CTX, ctx)
    rt.st64(slot, S_LO, lo)
    rt.st64(slot, S_HI, hi)
    rt.st64(slot, S_GROUP, g)
    rt.st64(slot, S_KIND, kind)
    __atomic_add(slot as *mut u64, 1) // seq: pos -> pos + 1 = filled (the locked add publishes the fields)
    return true
}

// Takes one descriptor; false = empty. Fields come back in `out` (6 words: fn, ctx, lo, hi, group, kind).
fn ring_pop(ring: u64, out: u64) -> bool {
    let deq: u64 = word_addr(ring, R_DEQ)
    var pos: u64 = rt.ld64(ring, R_DEQ)
    while true {
        let slot: u64 = slot_addr(ring, pos)
        let seq: u64 = aload(slot)
        if seq == pos + 1 {
            if __atomic_swap(deq as *mut u64, pos, pos + 1) == pos {
                break
            }
            pos = rt.ld64(ring, R_DEQ)
        } else if seq < pos + 1 {
            return false // not filled yet: empty
        } else {
            pos = rt.ld64(ring, R_DEQ)
        }
    }
    let slot: u64 = slot_addr(ring, pos)
    rt.st64(out, 0, rt.ld64(slot, S_FN))
    rt.st64(out, 1, rt.ld64(slot, S_CTX))
    rt.st64(out, 2, rt.ld64(slot, S_LO))
    rt.st64(out, 3, rt.ld64(slot, S_HI))
    rt.st64(out, 4, rt.ld64(slot, S_GROUP))
    rt.st64(out, 5, rt.ld64(slot, S_KIND))
    __atomic_add(slot as *mut u64, RING_SLOTS - 1) // seq: pos + 1 -> pos + RING_SLOTS = free for the next lap
    return true
}

// Runs one chunk and counts its items into the group.
fn run_chunk(blk: u64, counter: usize, f: u64, ctx: u64, g: u64, kind: u64, lo: u64, hi: u64) {
    __atomic_add(word_addr(blk, counter) as *mut u64, 1)
    if kind == 0 {
        let body: fn(u64, u64, u64) = f as fn(u64, u64, u64)
        body(ctx, lo, hi)
    } else {
        let fr: fn(u64) -> u64 = f as fn(u64) -> u64
        rt.st64(g, G_RESULT, fr(ctx))
    }
    // count the items; the locked add orders the body's writes before it
    let n: u64 = hi - lo
    let old: u64 = __atomic_add(word_addr(g, G_PENDING) as *mut u64, MINUS1 - n + 1)
    if old == n {
        __thread_futex_wake(word_addr(g, G_PENDING), 1024)
    }
}

// Takes the next chunk of the front batch (after the ring, J8) and runs it. False when the queue
// is empty. `counter` is P_EXEC_W or P_EXEC_C.
fn run_one(blk: u64, counter: usize) -> bool {
    let ring: u64 = rt.ld64(blk, P_RING)
    if ring != 0 {
        var d: [u64; 6] = [0; 6]
        if ring_pop(ring, (&d[0]) as u64) {
            run_chunk(blk, counter, d[0], d[1], d[4], d[5], d[2], d[3])
            return true
        }
    }
    let lock: *mut u64 = lock_of(blk)
    thread_lock(lock)
    let b: u64 = rt.ld64(blk, P_HEAD)
    if b == 0 {
        thread_unlock(lock)
        return false
    }
    let lo: u64 = rt.ld64(b, B_NEXT_LO)
    let end: u64 = rt.ld64(b, B_END)
    let chunk: u64 = rt.ld64(b, B_CHUNK)
    var hi: u64 = lo + chunk
    if hi > end {
        hi = end
    }
    rt.st64(b, B_NEXT_LO, hi)
    let f: u64 = rt.ld64(b, B_FN)
    let ctx: u64 = rt.ld64(b, B_CTX)
    let g: u64 = rt.ld64(b, B_GROUP)
    let kind: u64 = rt.ld64(b, B_KIND)
    var gone: bool = false
    if hi >= end {
        // last chunk taken: the batch leaves the queue
        let nx: u64 = rt.ld64(b, B_LINK)
        rt.st64(blk, P_HEAD, nx)
        if nx == 0 {
            rt.st64(blk, P_TAIL, 0)
        }
        gone = true
    }
    thread_unlock(lock)
    if gone {
        rt.heap_free(b, BATCH_WORDS * 8)
    }
    run_chunk(blk, counter, f, ctx, g, kind, lo, hi)
    return true
}

// What the dispatcher calls for WORKER_KIND (see the head of this file).
fn worker_main(blk: u64) -> u64 {
    while true {
        // read the sequence BEFORE looking: a push after this read changes it
        // and the wait below returns at once
        let seq: u64 = rt.ld64(blk, P_SEQ)
        if run_one(blk, P_EXEC_W) {
            continue
        }
        if rt.ld64(blk, P_STOP) != 0 {
            break
        }
        __thread_blocked_an()
        __thread_futex_wait(word_addr(blk, P_SEQ), seq)
        __thread_blocked_out()
    }
    return 0
}

// Announces new work to sleeping workers (the ring path: no lock).
fn announce(blk: u64, wake: u64) {
    __atomic_add(word_addr(blk, P_SEQ) as *mut u64, 1)
    __thread_futex_wake(word_addr(blk, P_SEQ), wake)
}

fn push_batch(blk: u64, b: u64, wake: u64) {
    let lock: *mut u64 = lock_of(blk)
    thread_lock(lock)
    rt.st64(b, B_LINK, 0)
    let t: u64 = rt.ld64(blk, P_TAIL)
    if t == 0 {
        rt.st64(blk, P_HEAD, b)
    } else {
        rt.st64(t, B_LINK, b)
    }
    rt.st64(blk, P_TAIL, b)
    // atomic, not load + store: `announce` bumps the same word from the lock-free path without the lock (a plain
    // store here could overwrite that bump and lose the wake-up of a worker that is about to sleep)
    __atomic_add(word_addr(blk, P_SEQ) as *mut u64, 1)
    thread_unlock(lock)
    __thread_futex_wake(word_addr(blk, P_SEQ), wake)
}

// A group counts items; `group_wait` returns when all items added with
// `group_go` are done. 0 = out of memory.
fn group_new(j: *mut Jobs) -> u64 {
    let g: u64 = rt.heap_alloc(GROUP_WORDS * 8)
    if g == 0 {
        return 0
    }
    rt.mem_set(g, 0 as u8, GROUP_WORDS * 8)
    return g
}

fn group_free(j: *mut Jobs, g: u64) {
    if g != 0 {
        rt.heap_free(g, GROUP_WORDS * 8)
    }
}

fn group_pending(g: u64) -> u64 {
    return rt.ld64(g, G_PENDING)
}

// Counts `n` finished items into the group (wakes the waiter when it was the last).
fn finish_items(g: u64, n: u64) {
    let old: u64 = __atomic_add(word_addr(g, G_PENDING) as *mut u64, MINUS1 - n + 1)
    if old == n {
        __thread_futex_wake(word_addr(g, G_PENDING), 1024)
    }
}

// group_go through the lock-free ring (J8): one descriptor per chunk; what does not fit goes to the locked queue.
fn group_go_ring(blk: u64, ring: u64, g: u64, begin: u64, end: u64, c: u64, body: fn(u64, u64, u64), ctx: u64) -> bool {
    __atomic_add(word_addr(g, G_PENDING) as *mut u64, end - begin)
    var lo: u64 = begin
    var chunks: u64 = 0
    while lo < end {
        var hi: u64 = lo + c
        if hi > end {
            hi = end
        }
        if !ring_push(ring, body as u64, ctx, lo, hi, g, 0) {
            break
        }
        chunks = chunks + 1
        lo = hi
    }
    if lo < end {
        // the ring is full: the rest as one batch in the locked queue
        let b: u64 = rt.heap_alloc(BATCH_WORDS * 8)
        if b == 0 {
            run_inline(lo, end, c, body, ctx)
            finish_items(g, end - lo)
        } else {
            rt.st64(b, B_FN, body as u64)
            rt.st64(b, B_CTX, ctx)
            rt.st64(b, B_NEXT_LO, lo)
            rt.st64(b, B_END, end)
            rt.st64(b, B_CHUNK, c)
            rt.st64(b, B_GROUP, g)
            rt.st64(b, B_KIND, 0)
            push_batch(blk, b, rt.ld64(blk, P_WORKERS))
        }
    }
    var wake: u64 = chunks
    let nw: u64 = rt.ld64(blk, P_WORKERS)
    if wake > nw {
        wake = nw
    }
    if wake > 0 {
        announce(blk, wake)
    }
    return true
}

// Adds the loop [begin, end) in chunks of `chunk` items to the group and
// returns at once. Result false: out of memory (nothing was queued).
fn group_go(j: *mut Jobs, g: u64, begin: u64, end: u64, chunk: u64, body: fn(u64, u64, u64), ctx: u64) -> bool {
    let blk: u64 = (*j).blk
    if blk == 0 || g == 0 {
        return false
    }
    if end <= begin {
        return true
    }
    var c: u64 = chunk
    if c < 1 {
        c = 1
    }
    let ring: u64 = rt.ld64(blk, P_RING)
    if ring != 0 && (end - begin + c - 1) / c <= RING_SLOTS / 2 {
        return group_go_ring(blk, ring, g, begin, end, c, body, ctx)
    }
    let b: u64 = rt.heap_alloc(BATCH_WORDS * 8)
    if b == 0 {
        return false
    }
    rt.st64(b, B_FN, body as u64)
    rt.st64(b, B_CTX, ctx)
    rt.st64(b, B_NEXT_LO, begin)
    rt.st64(b, B_END, end)
    rt.st64(b, B_CHUNK, c)
    rt.st64(b, B_GROUP, g)
    rt.st64(b, B_KIND, 0)
    __atomic_add(word_addr(g, G_PENDING) as *mut u64, end - begin)
    let chunks: u64 = (end - begin + c - 1) / c
    var wake: u64 = chunks
    let nw: u64 = rt.ld64(blk, P_WORKERS)
    if wake > nw {
        wake = nw
    }
    push_batch(blk, b, wake)
    return true
}

// Waits until the group is empty. The caller runs chunks of ANY batch while
// it waits (so a job may wait for other jobs and `create(0)` works).
fn group_wait(j: *mut Jobs, g: u64) {
    let blk: u64 = (*j).blk
    if blk == 0 || g == 0 {
        return
    }
    while true {
        let p: u64 = rt.ld64(g, G_PENDING)
        if p == 0 {
            break
        }
        if run_one(blk, P_EXEC_C) {
            continue
        }
        __thread_blocked_an()
        __thread_futex_wait(word_addr(g, G_PENDING), p)
        __thread_blocked_out()
    }
}

// Runs the range [begin, end) chunk by chunk on the calling thread.
fn run_inline(begin: u64, end: u64, c: u64, body: fn(u64, u64, u64), ctx: u64) {
    var lo: u64 = begin
    while lo < end {
        var hi: u64 = lo + c
        if hi > end {
            hi = end
        }
        body(ctx, lo, hi)
        lo = hi
    }
}

// body(ctx, lo, hi) for every chunk of [begin, end); returns when all are
// done. Chunks are disjoint, together exactly the range. Result false: could
// not be queued (the range was then run on the caller, so it IS complete).
fn parallel_for(j: *mut Jobs, begin: u64, end: u64, chunk: u64, body: fn(u64, u64, u64), ctx: u64) -> bool {
    if end <= begin {
        return true
    }
    var c: u64 = chunk
    if c < 1 {
        c = 1
    }
    if (*j).blk == 0 || rt.ld64((*j).blk, P_WORKERS) == 0 || end - begin <= c {
        // nobody to share with: the same chunks, in order, right here
        run_inline(begin, end, c, body, ctx)
        return true
    }
    let g: u64 = group_new(j)
    if g == 0 {
        run_inline(begin, end, c, body, ctx)
        return false
    }
    let ok: bool = group_go(j, g, begin, end, c, body, ctx)
    if !ok {
        run_inline(begin, end, c, body, ctx)
        group_free(j, g)
        return false
    }
    group_wait(j, g)
    group_free(j, g)
    return true
}

// One item per chunk: body(ctx, i, i + 1) for i in 0..n. For heavy items
// (one world chunk each).
fn parallel_each(j: *mut Jobs, n: u64, body: fn(u64, u64, u64), ctx: u64) -> bool {
    return parallel_for(j, 0, n, 1, body, ctx)
}

// A future: runs `f(arg)` on the pool. The result is the handle (0 = out of
// memory); `join` gives the result and frees it. `task_done` does not block.
fn spawn(j: *mut Jobs, f: fn(u64) -> u64, arg: u64) -> u64 {
    let blk: u64 = (*j).blk
    if blk == 0 {
        return 0
    }
    let g: u64 = group_new(j)
    if g == 0 {
        return 0
    }
    let ring: u64 = rt.ld64(blk, P_RING)
    if ring != 0 {
        __atomic_add(word_addr(g, G_PENDING) as *mut u64, 1)
        if ring_push(ring, f as u64, arg, 0, 1, g, 1) {
            announce(blk, 1)
            return g
        }
        __atomic_add(word_addr(g, G_PENDING) as *mut u64, MINUS1) // ring full: the locked queue below
    }
    let b: u64 = rt.heap_alloc(BATCH_WORDS * 8)
    if b == 0 {
        group_free(j, g)
        return 0
    }
    rt.st64(b, B_FN, f as u64)
    rt.st64(b, B_CTX, arg)
    rt.st64(b, B_NEXT_LO, 0)
    rt.st64(b, B_END, 1)
    rt.st64(b, B_CHUNK, 1)
    rt.st64(b, B_GROUP, g)
    rt.st64(b, B_KIND, 1)
    __atomic_add(word_addr(g, G_PENDING) as *mut u64, 1)
    push_batch(blk, b, 1)
    return g
}

fn task_done(t: u64) -> bool {
    return rt.ld64(t, G_PENDING) == 0
}

// Waits for the task (helping with other work) and returns its result. The
// handle is invalid afterwards -- join each task exactly once (R2 of
// FIRN-GAPS: the handle is freed here, like `thread_wait`).
fn join(j: *mut Jobs, t: u64) -> u64 {
    if t == 0 {
        return 0
    }
    group_wait(j, t)
    let r: u64 = rt.ld64(t, G_RESULT)
    group_free(j, t)
    return r
}

// Ends the workers (after the queue is empty) and frees everything. The
// caller has waited for all groups and tasks (J7).
fn destroy(j: *mut Jobs) {
    let blk: u64 = (*j).blk
    if blk == 0 {
        return
    }
    rt.st64(blk, P_STOP, 1)
    let lock: *mut u64 = lock_of(blk)
    thread_lock(lock)
    __atomic_add(word_addr(blk, P_SEQ) as *mut u64, 1)
    thread_unlock(lock)
    __thread_futex_wake(word_addr(blk, P_SEQ), 1024)
    let n: u64 = rt.ld64(blk, P_WORKERS)
    var i: u64 = 0
    while i < n {
        thread_wait(rt.ld64(blk, P_HANDLES + i as usize))
        i = i + 1
    }
    // batches nobody took (a caller that never waited): give the memory back
    var b: u64 = rt.ld64(blk, P_HEAD)
    while b != 0 {
        let nx: u64 = rt.ld64(b, B_LINK)
        rt.heap_free(b, BATCH_WORDS * 8)
        b = nx
    }
    let ring: u64 = rt.ld64(blk, P_RING)
    if ring != 0 {
        rt.heap_free(ring, RING_WORDS * 8)
    }
    rt.heap_free(blk, P_WORDS * 8)
    (*j).blk = 0
}

// ------------------------------------------------------------ parallel map
//
// `map` is the Python `[f(i) for i in range(n)]` / `pool.map(f, items)`:
// every result lands in its own slot of a `Vec`, so no two items write the
// same memory and the caller needs neither a context struct nor a raw
// pointer. Three shapes, because a generic function cannot be handed to the
// pool as a `fn` value (so the pool calls the user's function through its
// ADDRESS with a fixed register signature):
//   jobs_map[T: Scalar]        f(i) -> T       T = integer, bool or pointer (<= 8 bytes)
//   jobs_map_into[T]           f(i, out: *mut T)   any T (str, struct, f64); f writes *out
//   jobs_map_files[T]          f(path: *str, out: *mut T) per element of a Vec[str]
// `out` is CLEARED first and holds `n` elements afterwards (zeroed when
// `f` leaves its slot untouched). False when memory ran out (out untouched).
// A `str` / pointer written into a slot by a worker is reachable for the
// collector through `out` only after the call returns -- keep `out` alive
// (a local `Vec` is) and do not allocate-heavy inside `f` without `#[no_gc]`
// concerns of the usual kind (J4).

// The context is 5 words on the heap: f, base, size, kind, items.
fn jobs_map_body(ctx: u64, lo: u64, hi: u64) {
    let f: u64 = rt.ld64(ctx, 0)
    let base: u64 = rt.ld64(ctx, 1)
    let size: u64 = rt.ld64(ctx, 2)
    let kind: u64 = rt.ld64(ctx, 3)
    let items: u64 = rt.ld64(ctx, 4)
    var i: u64 = lo
    while i < hi {
        let slot: u64 = base + i * size
        if kind == 0 {
            let g: fn(u64) -> u64 = f as fn(u64) -> u64
            let r: u64 = g(i)
            rt.mem_copy(slot, (&r) as u64, size as usize)
        } else if kind == 1 {
            let g: fn(u64, u64) = f as fn(u64, u64)
            g(i, slot)
        } else {
            let g: fn(u64, u64) = f as fn(u64, u64)
            g(items + i * 16, slot)
        }
        i = i + 1
    }
}

fn jobs_map_run[T](j: *mut Jobs, n: u64, kind: u64, f: u64, items: u64, out: *mut Vec[T]) -> bool {
    vec_clear[T](out)
    if n == 0 {
        return true
    }
    if !vec_reserve[T](out, n as usize) {
        return false
    }
    rt.mem_set((*out).ptr, 0 as u8, n as usize * size_of[T]())
    (*out).len = n as usize
    let cp: u64 = rt.heap_alloc(40)
    if cp == 0 {
        return false
    }
    rt.st64(cp, 0, f)
    rt.st64(cp, 1, (*out).ptr)
    rt.st64(cp, 2, size_of[T]() as u64)
    rt.st64(cp, 3, kind)
    rt.st64(cp, 4, items)
    parallel_for(j, 0, n, 1, jobs_map_body, cp)
    rt.heap_free(cp, 40)
    return true
}

fn jobs_map[T: Scalar](j: *mut Jobs, n: u64, f: fn(u64) -> T, out: *mut Vec[T]) -> bool {
    return jobs_map_run[T](j, n, 0, f as u64, 0, out)
}

fn jobs_map_into[T](j: *mut Jobs, n: u64, f: fn(u64, *mut T), out: *mut Vec[T]) -> bool {
    return jobs_map_run[T](j, n, 1, f as u64, 0, out)
}

fn jobs_map_files[T](j: *mut Jobs, paths: *mut Vec[str], f: fn(*str, *mut T), out: *mut Vec[T]) -> bool {
    return jobs_map_run[T](j, vec_len[str](paths) as u64, 2, f as u64, (*paths).ptr, out)
}
