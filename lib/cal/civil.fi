// SPDX-License-Identifier: MPL-2.0
// lib/cal/civil.fi -- cal.civil: the proleptic Gregorian calendar as plain integer math, for
// calendars (iCalendar RRULE, vCard birthdays) that need whole-day arithmetic.
//
//     civil.days_from_civil(y, m, d) -> i64     days since 1970-01-01 (negative before)
//     civil.civil_from_days(z) -> Ymd           the inverse
//     civil.weekday(z) -> u32                   0 = Monday ... 6 = Sunday (ISO / Python order)
//     civil.is_leap(y), days_in_month(y, m), days_in_year(y), day_of_year(y, m, d) (1-based)
//     civil.iso_week(z) -> u32, iso_year(z) -> i32       ISO 8601 week number (1..53) and its year
//     civil.floor_div(a, b), floor_mod(a, b)    rounding towards minus infinity
//     civil.valid(y, m, d) -> bool
//
// The day count formulas are Howard Hinnant's (exact for negative days). Unlike std.time this
// module knows no clock and no zone: a "local second" is days * 86400 + seconds of the day,
// which is what the floating date-times of iCalendar need (see cal.rrule).

export {
    Ymd, floor_div, floor_mod, is_leap, days_in_month, days_in_year, valid,
    days_from_civil, civil_from_days, weekday, day_of_year, iso_week, iso_year,
}

struct Ymd {
    y: i32,
    m: u32,
    d: u32,
}

fn floor_div(a: i64, b: i64) -> i64 {
    var q: i64 = a / b
    if (a % b != 0) && ((a < 0) != (b < 0)) {
        q = q - 1
    }
    return q
}

fn floor_mod(a: i64, b: i64) -> i64 {
    return a - floor_div(a, b) * b
}

fn is_leap(y: i32) -> bool {
    if y % 400 == 0 {
        return true
    }
    if y % 100 == 0 {
        return false
    }
    return y % 4 == 0
}

fn days_in_month(y: i32, m: u32) -> u32 {
    if m == 2 {
        if is_leap(y) {
            return 29
        }
        return 28
    }
    if m == 4 || m == 6 || m == 9 || m == 11 {
        return 30
    }
    return 31
}

fn days_in_year(y: i32) -> u32 {
    if is_leap(y) {
        return 366
    }
    return 365
}

fn valid(y: i32, m: u32, d: u32) -> bool {
    if m < 1 || m > 12 || d < 1 {
        return false
    }
    return d <= days_in_month(y, m)
}

fn days_from_civil(y0: i32, m: u32, d: u32) -> i64 {
    var y: i64 = y0 as i64
    if m <= 2 {
        y = y - 1
    }
    let era: i64 = floor_div(y, 400)
    let yoe: i64 = y - era * 400
    var mp: i64 = (m as i64) - 3
    if m <= 2 {
        mp = (m as i64) + 9
    }
    let doy: i64 = (153 * mp + 2) / 5 + (d as i64) - 1
    let doe: i64 = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

fn civil_from_days(z0: i64) -> Ymd {
    let z: i64 = z0 + 719468
    let era: i64 = floor_div(z, 146097)
    let doe: i64 = z - era * 146097
    let yoe: i64 = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    var y: i64 = yoe + era * 400
    let doy: i64 = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp: i64 = (5 * doy + 2) / 153
    let d: i64 = doy - (153 * mp + 2) / 5 + 1
    var m: i64 = mp + 3
    if mp >= 10 {
        m = mp - 9
    }
    if m <= 2 {
        y = y + 1
    }
    return Ymd { y: y as i32, m: m as u32, d: d as u32 }
}

// 0 = Monday ... 6 = Sunday. 1970-01-01 (day 0) was a Thursday.
fn weekday(z: i64) -> u32 {
    return floor_mod(z + 3, 7) as u32
}

// 1-based.
fn day_of_year(y: i32, m: u32, d: u32) -> u32 {
    return (days_from_civil(y, m, d) - days_from_civil(y, 1, 1) + 1) as u32
}

// The year the ISO week of day `z` belongs to: that of the Thursday of its week.
fn iso_year(z: i64) -> i32 {
    let thu: i64 = z - (weekday(z) as i64) + 3
    return civil_from_days(thu).y
}

fn iso_week(z: i64) -> u32 {
    let thu: i64 = z - (weekday(z) as i64) + 3
    let c: Ymd = civil_from_days(thu)
    return ((thu - days_from_civil(c.y, 1, 1)) / 7 + 1) as u32
}
