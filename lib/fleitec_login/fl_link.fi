// SPDX-License-Identifier: MPL-2.0
// lib/fleitec_login/fl_link.fi -- the CLIENT side of linking a login method ("link XOFFI").
// LOGIN-PLAN 2.5: the user is signed in with method A, proves a FRESH login at provider B, and the
// broker attaches identity (B, sub) to the account.
//
//     link.link_begin(&xoffi_client, redirect_uri, now, &p)        // p.url -> browser, prompt=login
//     let r: link.LinkResult = link.link_finish(&xoffi_client, &p, redirected, "xoffi", acc, now)
//     // r.reason == L_OK  =>  hand (r.provider, r.sub, attributes) to the broker
//     link.unlink(&tx, broker_unlink_url, access_token, "xoffi", sub)
//
// WHAT THIS ADDS TO A PLAIN LOGIN
//   * `prompt=login` + `max_age=0` always, and `finish` refuses (L_STALE) when the provider's
//     `auth_time` is older than the attempt: an old session of the browser proves nothing.
//   * `sub` is the STABLE provider id; e-mail and name are only attributes ("hints"), never keys.
//   * `expected_acc` (the account that is linking): if the returned token itself names a Fleitec account
//     (`acc`) it must be the same one, else L_ACCOUNT -- you cannot link B2 to account A by logging in
//     as B2 from the Fleitec side.
//   * XOFFI admin flags (`is_admin`, `nexus_core_access`) are NOT read; groups are copied as names only.
// What the broker does with the result (identity_taken 409, no auto-create, 24 h hold) is server
// logic, not in this file.
import std.rt
import std.str
import std.json
import fleitec_login.fl_util as u
import fleitec_login.fl_transport as tp
import fleitec_login.fl_oidc as oidc

export { LinkResult, link_begin, link_finish, unlink }

struct LinkResult {
    reason: i64,
    detail: str,
    provider: str,
    iss: str,
    sub: str,
    name: str,
    email_hint: str,
    org_id: str,
    org_name: str,
    groups: str,
    amr: str,
    auth_time: i64,
    id_token: str, // the RAW id_token: the broker verifies it itself (POST /link/finish), never our word
}

fn link_begin(c: *mut oidc.Client, redirect_uri: str, now: i64, p: *mut oidc.Pending) -> i64 {
    return oidc.begin(c, redirect_uri, "prompt=login&max_age=0", now, p)
}

fn empty_result(reason: i64, detail: str) -> LinkResult {
    return LinkResult { reason: reason, detail: detail, provider: "", iss: "", sub: "", name: "", email_hint: "",
        org_id: "", org_name: "", groups: "", amr: "", auth_time: 0, id_token: "" }
}

fn link_finish(c: *mut oidc.Client, p: *mut oidc.Pending, redirected: str, provider: str,
    expected_acc: str, now: i64) -> LinkResult {
    if !(*p).fresh {
        return empty_result(oidc.L_CONFIG, "not_a_link_attempt")
    }
    let l: oidc.Login = oidc.finish(c, p, redirected, now)
    if l.reason != oidc.L_OK {
        return empty_result(l.reason, l.detail)
    }
    if expected_acc.length() > 0 && l.claims.acc.length() > 0 && l.claims.acc != expected_acc {
        return empty_result(oidc.L_ACCOUNT, "")
    }
    var r: LinkResult = empty_result(oidc.L_OK, "")
    r.provider = provider
    r.iss = l.claims.iss
    r.sub = l.claims.sub
    r.name = l.claims.name
    if r.name.length() == 0 { r.name = l.claims.preferred_username }
    r.email_hint = l.claims.email
    r.org_id = l.claims.org_id
    r.org_name = l.claims.org_name
    r.groups = l.claims.groups
    r.amr = l.claims.amr
    r.auth_time = l.claims.auth_time
    r.id_token = l.tokens.id_token
    return r
}

// POST {provider, sub} to the broker's unlink endpoint (fleitec-id: POST /link/unlink) with the bearer
// token. The broker needs a FRESH login (auth_time within its window) and answers: 200 = unlinked
// (the session version rises, so the answer carries a NEW access token: it is returned in
// `tokens.access_token`, "" when the answer has none); 409 = it is the last identity
// ("last_identity"); 401/403 = sign in again (L_NEED_LOGIN; 403 reauth_required = fresh login
// missing); 404 = nothing to unlink (L_ERROR "not_linked").
fn unlink(t: *mut tp.Transport, endpoint: str, access_token: str, provider: str, sub: str) -> oidc.Login {
    let f: str = u.kv("provider", provider) + "&" + u.kv("sub", sub)
    let r: tp.HttpResp = tp.post_form(t, endpoint, f, "Authorization: Bearer " + access_token + "\r\n")
    if !r.ok { return oidc.error_login(oidc.L_NET, "") }
    if r.status == 200 {
        var ok: oidc.Login = oidc.error_login(oidc.L_OK, "")
        var d: json.Json = json.json_new()
        let parsed: bool = json.json_parse(&d, r.body.p as u64, r.body.length()) catch false
        if parsed && json.json_kind(&d, json.json_root(&d)) == json.JSON_OBJECT {
            ok.tokens.access_token = u.jget_str(&d, json.json_root(&d), "access_token")
        }
        json.json_free(&d)
        return ok
    }
    if r.status == 409 { return oidc.error_login(oidc.L_ERROR, "last_identity") }
    if r.status == 401 || r.status == 403 { return oidc.error_login(oidc.L_NEED_LOGIN, "") }
    if r.status == 404 { return oidc.error_login(oidc.L_ERROR, "not_linked") }
    return oidc.error_login(oidc.L_HTTP, "")
}
