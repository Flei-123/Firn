// SPDX-License-Identifier: MPL-2.0
// lib/fleitec_login/fl_nethttp.fi -- the production transport: net.http (TLS 1.3/1.2).
//
//     var t: transport.Transport = transport.Transport { f: nethttp.net_transport }
//
// One request = one client (no keep-alive state to leak between logins), 20 s timeout,
// no redirect following (a login endpoint that redirects is an answer, not a detour),
// no gzip, no cache. The body is copied to the garbage collected heap.
import std.rt
import std.str
import net.http
import fleitec_login.fl_transport as tp

export { net_transport, NET_TIMEOUT_MS }

const NET_TIMEOUT_MS: u64 = 20000

fn net_transport(req: *mut tp.HttpReq, resp: *mut tp.HttpResp) -> bool {
    var cl: http.Client = http.client_new()
    if !http.client_init(&cl) {
        return false
    }
    http.client_set_cache(&cl, false)
    http.client_set_gzip(&cl, false)
    http.client_set_max_redirects(&cl, 0 as u32)
    http.client_set_timeout(&cl, NET_TIMEOUT_MS)
    let hd: str = "Accept: application/json\r\n" + (*req).headers
    http.client_set_headers(&cl, hd.p as u64, hd.length())
    var r: http.Response = http.resp_new()
    var ne: u32 = 0 as u32
    if (*req).method == "GET" {
        ne = http.http_get_num(&cl, (*req).url.p as u64, (*req).url.length(), &r)
    } else {
        ne = http.http_post_num(&cl, (*req).url.p as u64, (*req).url.length(),
            (*req).body.p as u64, (*req).body.length(),
            (*req).ctype.p as u64, (*req).ctype.length(), &r)
    }
    http.client_clear_headers(&cl)
    if ne != 0 as u32 {
        http.client_close(&cl)
        http.resp_free(&r)
        http.client_free(&cl)
        (*resp).net_err = tp.NE_FAILED
        return false
    }
    (*resp).status = http.resp_status(&r) as i64
    (*resp).body = __str_copy(str { p: http.resp_body_ptr(&r) as *u8, n: http.resp_body_len(&r) })
    var at: u64 = 0
    let n: usize = http.resp_header(&r, "location".p as u64, 8, &at)
    if n > 0 {
        (*resp).location = __str_copy(str { p: at as *u8, n: n })
    }
    http.resp_free(&r)
    http.client_close(&cl)
    http.client_free(&cl)
    return true
}
