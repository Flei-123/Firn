// SPDX-License-Identifier: MPL-2.0
// lib/fleitec_login/fl_nethttp.fi -- the production transport: net.http (TLS 1.3/1.2).
//
//     var t: transport.Transport = transport.Transport { f: nethttp.net_transport }
//
// One request = one client (no keep-alive state to leak between logins), 20 s timeout (net_set_timeout),
// no redirect following (a login endpoint that redirects is an answer, not a detour),
// no gzip, no cache. The body is copied to the garbage collected heap.
import std.rt
import std.str
import net.http
import fleitec_login.fl_transport as tp

export { net_transport, net_set_timeout, net_add_trust_pem, net_trust_count, NET_TIMEOUT_MS }

const NET_TIMEOUT_MS: u64 = 20000

static mut G_TIMEOUT_MS: u64 = 20000

// The operator's own roots (a private CA of the issuer), PEM, kept in raw heap so no collector
// owns them. They are used IN ADDITION to the system roots in every later request; the check
// of the chain is never switched off. Returns how many certificates the PEM holds (0 = none, nothing kept).
static mut G_TRUST_P: u64 = 0
static mut G_TRUST_N: usize = 0
static mut G_TRUST_CERTS: usize = 0

fn net_add_trust_pem(p: u64, n: usize) -> usize {
    if p == 0 as u64 || n == 0 {
        return 0
    }
    // the PEM must parse before we keep it: count with a throw-away client
    var probe: http.Client = http.client_new()
    if !http.client_init(&probe) {
        return 0
    }
    let got: usize = http.client_add_trust_pem(&probe, p, n)
    http.client_free(&probe)
    if got == 0 {
        return 0
    }
    let q: u64 = rt.heap_alloc(n)
    if q == 0 as u64 {
        return 0
    }
    var i: usize = 0
    while i < n {
        rt.st8(q, i, rt.ld8(p, i))
        i = i + 1
    }
    G_TRUST_P = q
    G_TRUST_N = n
    G_TRUST_CERTS = got
    return got
}

// How many private roots are installed (0 = system roots only).
fn net_trust_count() -> usize {
    return G_TRUST_CERTS
}

// Shortens (or lengthens) the limit of every later request of this process; 0 = the default.
// A server that logs people in on its one thread sets this to a few seconds.
fn net_set_timeout(ms: u64) {
    if ms == 0 as u64 {
        G_TIMEOUT_MS = NET_TIMEOUT_MS
    } else {
        G_TIMEOUT_MS = ms
    }
}

fn net_transport(req: *mut tp.HttpReq, resp: *mut tp.HttpResp) -> bool {
    var cl: http.Client = http.client_new()
    if !http.client_init(&cl) {
        return false
    }
    http.client_set_cache(&cl, false)
    http.client_set_gzip(&cl, false)
    http.client_set_max_redirects(&cl, 0 as u32)
    http.client_set_timeout(&cl, G_TIMEOUT_MS)
    if G_TRUST_N > 0 {
        let added: usize = http.client_add_trust_pem(&cl, G_TRUST_P, G_TRUST_N)
    }
    let hd: str = "Accept: application/json\r\n" + (*req).headers
    http.client_set_headers(&cl, hd.p as u64, hd.length())
    var r: http.Response = http.resp_new()
    var ne: u32 = 0 as u32
    if (*req).method == "GET" {
        ne = http.http_get_num(&cl, (*req).url.p as u64, (*req).url.length(), &r)
    } else {
        ne = http.http_post_num(&cl, (*req).url.p as u64, (*req).url.length(),
            (*req).body.p as u64, (*req).body.length(),
            (*req).ctype.p as u64, (*req).ctype.length(), &r)
    }
    http.client_clear_headers(&cl)
    if ne != 0 as u32 {
        http.client_close(&cl)
        http.resp_free(&r)
        http.client_free(&cl)
        (*resp).net_err = tp.NE_FAILED
        return false
    }
    (*resp).status = http.resp_status(&r) as i64
    (*resp).body = __str_copy(str { p: http.resp_body_ptr(&r) as *u8, n: http.resp_body_len(&r) })
    var at: u64 = 0
    let n: usize = http.resp_header(&r, "location".p as u64, 8, &at)
    if n > 0 {
        (*resp).location = __str_copy(str { p: at as *u8, n: n })
    }
    http.resp_free(&r)
    http.client_close(&cl)
    http.client_free(&cl)
    return true
}
