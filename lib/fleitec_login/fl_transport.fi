// SPDX-License-Identifier: MPL-2.0
// lib/fleitec_login/fl_transport.fi -- the seam between the login logic and the network.
//
// Every fleitec_login module that talks HTTP (jwks refresh, oidc discovery and token
// exchange, device flow, session refresh, link) takes a TRANSPORT: a plain function
// `fn(*mut HttpReq, *mut HttpResp) -> bool`. The production one is
// `fleitec_login.nethttp.net_transport` (net.http, TLS); the tests bring a fake
// identity provider as a transport, so no socket is needed to test the protocol.
//
// `send` applies the endpoint rule BEFORE the transport sees the request: https
// always, http only for a loopback host. A refusal is `ok=false, net_err=NE_REFUSED`.
import std.rt
import std.str
import fleitec_login.fl_util as u

export {
    HttpReq, HttpResp, Transport,
    send, get, post_form, post_json, resp_text_ok,
    NE_NONE, NE_REFUSED, NE_FAILED,
}

const NE_NONE: i64 = 0
const NE_REFUSED: i64 = 1 // endpoint rule: not https / not loopback
const NE_FAILED: i64 = 2 // transport could not complete the exchange

struct HttpReq {
    method: str, // "GET" | "POST"
    url: str,
    headers: str, // extra header lines, each ended by "\r\n" ("" = none)
    ctype: str, // Content-Type of the body
    body: str,
}

struct HttpResp {
    ok: bool, // an HTTP answer arrived (any status)
    status: i64,
    body: str,
    location: str, // Location header, "" if none
    net_err: i64,
}

struct Transport {
    f: fn(*mut HttpReq, *mut HttpResp) -> bool,
}

fn resp_empty() -> HttpResp {
    return HttpResp { ok: false, status: 0, body: "", location: "", net_err: NE_NONE }
}

fn send(t: *mut Transport, req: *mut HttpReq) -> HttpResp {
    var resp: HttpResp = resp_empty()
    if !u.endpoint_ok((*req).url) {
        resp.net_err = NE_REFUSED
        return resp
    }
    let f: fn(*mut HttpReq, *mut HttpResp) -> bool = (*t).f
    let done: bool = f(req, &resp)
    if !done {
        resp.ok = false
        if resp.net_err == NE_NONE {
            resp.net_err = NE_FAILED
        }
        return resp
    }
    resp.ok = true
    return resp
}

fn get(t: *mut Transport, url: str, headers: str) -> HttpResp {
    var rq: HttpReq = HttpReq { method: "GET", url: url, headers: headers, ctype: "", body: "" }
    return send(t, &rq)
}

fn post_form(t: *mut Transport, url: str, form: str, headers: str) -> HttpResp {
    var rq: HttpReq = HttpReq { method: "POST", url: url, headers: headers,
        ctype: "application/x-www-form-urlencoded", body: form }
    return send(t, &rq)
}

fn post_json(t: *mut Transport, url: str, body: str, headers: str) -> HttpResp {
    var rq: HttpReq = HttpReq { method: "POST", url: url, headers: headers,
        ctype: "application/json", body: body }
    return send(t, &rq)
}

// a 2xx answer with a body
fn resp_text_ok(r: *mut HttpResp) -> bool {
    return (*r).ok && (*r).status >= 200 && (*r).status < 300
}
