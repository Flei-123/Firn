// SPDX-License-Identifier: MPL-2.0
// lib/markdown/md.fi -- THE MARKDOWN PARSER, IN ONE IMPORT.
//
//     import markdown.md
//     import markdown.doc
//
//     var d: doc.Doc = md.parse("# Hello *world*", doc.opts_default())
//     ... walk it with doc.node_first / doc.node_next / doc.node_kind ...
//     doc.doc_free(&d)
//
// `parse` reads CommonMark 0.31 plus the GitHub extensions (tables,
// ~~strikethrough~~, task list items, bare URLs); options switch each of the
// extensions off and decide what happens to raw HTML (see doc.Opts). The
// answer is a tree (lib/markdown/doc.fi); `html.render` writes it as HTML,
// `fui.markdownview` draws it in a window.
//
// The text is copied: the source may go away as soon as `parse` returns.
// Every call must be paired with `doc.doc_free`.
import std.rt
import markdown.doc
import markdown.block
import markdown.html

export { parse, parse_bytes, to_html, to_html_safe }

// Parse the text `src` with the options `o`.
fn parse(src: str, o: doc.Opts) -> doc.Doc {
    return parse_bytes(src.p as u64, src.n, o)
}

// Parse the octets (p, n).
fn parse_bytes(p: u64, n: usize, o: doc.Opts) -> doc.Doc {
    var d: doc.Doc = doc.doc_new(o)
    block.parse(&d, p, n)
    return d
}

// Parse and render in one go (the buffer is the caller's to free).
fn to_html(src: str, o: doc.Opts, out: *mut rt.Buf) {
    var d: doc.Doc = parse(src, o)
    html.render(&d, out, false)
    doc.doc_free(&d)
}

// The same, with the target filter of html.fi's safe mode.
fn to_html_safe(src: str, o: doc.Opts, out: *mut rt.Buf) {
    var d: doc.Doc = parse(src, o)
    html.render(&d, out, true)
    doc.doc_free(&d)
}
