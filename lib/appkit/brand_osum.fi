// SPDX-License-Identifier: MPL-2.0
// lib/appkit/brand_osum.fi -- the product brand of an Osum image, read from the image.
import std.rt
import std.fs
import appkit.util

export {
    brand_value, brand_from_text, product_from_version, slug_from_product,
    KEY_PRODUCT, KEY_SLUG, KEY_VENDOR, KEY_WEB,
    BRAND_FILE, VERSION_FILE,
}

const KEY_PRODUCT: str = "product"
const KEY_SLUG: str = "slug"
const KEY_VENDOR: str = "vendor"
const KEY_WEB: str = "web"
const BRAND_FILE: str = "/proc/brand"
const VERSION_FILE: str = "/proc/version"
const VERSION_MARK: str = " (Firn) version "

fn trim_end(p: u64, n: usize) -> usize {
    var m: usize = n
    while m > 0 && (rt.ld8(p, m - 1) == (32 as u8) || rt.ld8(p, m - 1) == (13 as u8) || rt.ld8(p, m - 1) == (9 as u8)) {
        m = m - 1
    }
    return m
}

fn brand_from_text(text: str, key: str, out: *mut rt.Buf) -> bool {
    rt.buf_clear(out)
    var at: usize = 0
    while at < text.n {
        var end: usize = at
        while end < text.n && rt.ld8(text.p as u64, end) != (10 as u8) {
            end = end + 1
        }
        let line: str = str { p: ((text.p as u64) + (at as u64)) as *mut u8, n: end - at }
        if util.starts_with(line, key) && line.n > key.n && rt.ld8(line.p as u64, key.n) == (58 as u8) {
            var v: usize = key.n + 1
            while v < line.n && rt.ld8(line.p as u64, v) == (32 as u8) {
                v = v + 1
            }
            let vn: usize = trim_end((line.p as u64) + (v as u64), line.n - v)
            if vn == 0 {
                return false
            }
            rt.buf_push_bytes(out, (line.p as u64) + (v as u64), vn)
            return true
        }
        at = end + 1
    }
    return false
}

fn product_from_version(text: str, out: *mut rt.Buf) -> bool {
    rt.buf_clear(out)
    var i: usize = 0
    while i + VERSION_MARK.n <= text.n {
        if rt.mem_eq((text.p as u64) + (i as u64), VERSION_MARK.p as u64, VERSION_MARK.n) {
            if i == 0 {
                return false
            }
            rt.buf_push_bytes(out, text.p as u64, i)
            return true
        }
        i = i + 1
    }
    return false
}

fn slug_from_product(product: str, out: *mut rt.Buf) -> bool {
    rt.buf_clear(out)
    var i: usize = 0
    while i < product.n {
        let c: u8 = rt.ld8(product.p as u64, i)
        if c >= (65 as u8) && c <= (90 as u8) {
            rt.buf_push(out, c + (32 as u8))
        } else if (c >= (97 as u8) && c <= (122 as u8)) || (c >= (48 as u8) && c <= (57 as u8)) {
            rt.buf_push(out, c)
        }
        i = i + 1
    }
    return rt.buf_len(out) > 0
}

fn read_text(path: str, b: *mut rt.Buf) -> bool {
    rt.buf_clear(b)
    let n: usize = fs.read_file(path, b) catch 4294967295
    return n != 4294967295 && rt.buf_len(b) > 0
}

fn brand_value(key: str, out: *mut rt.Buf) -> bool {
    rt.buf_clear(out)
    var text: rt.Buf = rt.buf_new()
    var found: bool = false
    if read_text(BRAND_FILE, &text) {
        found = brand_from_text(str { p: rt.buf_data(&text), n: rt.buf_len(&text) }, key, out)
    }
    if !found && (key == KEY_PRODUCT || key == KEY_SLUG) {
        if read_text(VERSION_FILE, &text) {
            found = product_from_version(str { p: rt.buf_data(&text), n: rt.buf_len(&text) }, out)
            if found && key == KEY_SLUG {
                var product: rt.Buf = rt.buf_new()
                rt.buf_push_bytes(&product, rt.buf_ptr(out), rt.buf_len(out))
                found = slug_from_product(str { p: rt.buf_data(&product), n: rt.buf_len(&product) }, out)
                rt.buf_free(&product)
            }
        }
    }
    rt.buf_free(&text)
    return found
}
