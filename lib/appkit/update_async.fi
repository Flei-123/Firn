// SPDX-License-Identifier: MPL-2.0
// lib/appkit/update_async.fi -- THE STORE CHECK THAT NEVER BLOCKS THE UI THREAD.
//
// Android has no thread of our own and no second process (see
// lib/@android/appkit/platform.fi), so update.fi used to run the whole check
// (DNS, TCP, TLS, three HTTPS requests) on the app thread: 3.4 s frozen on
// x86_64, 8 s on a translated arm64 -- the system's ANR limit is 5 s and every
// tap in that time was lost. This driver runs the SAME check as PASSES between
// NON-BLOCKING requests (async.ahttp, on the program's event loop):
//
//   1. entry.json and entry.json.sig are asked at once;
//   2. when all answers are in, a PASS runs update.update_check_blocking. Every
//      answer comes from the cache of this driver (update.get_mem -> `a_get`);
//      the first answer a pass misses (the catalog, whose address is in the
//      entry) makes it return PH_PENDING without any side effect;
//   3. the driver asks for that one and runs the pass again;
//   4. a pass that gets through returns the real phase -> update_async_finish.
//
// A pass is CPU only (signature, JSON, compare): the log shows `pass n .. ms`.
//
// HONEST
//   A1  Names are looked up on the loop (async.adns, ahttp H2): no wait, no
//       freeze. The system's name servers come from LinkProperties (JNI).
//   A2  The download of an update (OP_FETCH, started by the user) runs on the
//       loop too: ahttp's SINK writes the octets to the staged file as they
//       come (hashed on the way), progress reaches the screen at most every
//       150 ms, a cancel is looked at with every write. Per loop round at
//       most one stream read (<= 256 KiB) is written and hashed.
//   A3  Needs verify_tls (the default); a check against a test server without
//       TLS verification takes the blocking way of update.fi.
//   A4  update_cancel is looked at between passes (a request in flight ends by
//       itself within REQ_TIMEOUT_MS).
import std.rt
import async.loop
import async.ahttp
import net.http
import net.dns
import appkit.update
import appkit.fetch
import appkit.appinfo
import appkit.util
import appkit.log
import tls.tls

export { install }

const SLOTS: usize = 4
const REL_MAX: usize = 128
const REQ_TIMEOUT_MS: i64 = 12000
const DNS_TIMEOUT_MS: u64 = 1000
const DL_TIMEOUT_MS: i64 = 3600000
const PROGRESS_MS: i64 = 150
const MAX_SIG: usize = 128
const MAX_ENTRY: usize = 65536
const MAX_CATALOG: usize = 8388608

struct Driver {
    l: *mut loop.Loop,
    up: *mut update.Updater,
    ah: ahttp.AClient,
    ready: bool,
    inflight: u32,
    n: usize,
    rel: [u8; 512], // SLOTS x REL_MAX
    nrel: [usize; 4],
    res: [u32; 4], // fetch.FE_* per request
    code: [u32; 4], // HTTP status per request
    off: [usize; 4],
    len: [usize; 4],
    state: [u8; 4], // 0 free, 1 asked, 2 answered
    blob: rt.Buf, // all bodies, one after the other
    need: [u8; 128], // the address the last pass missed
    nneed: usize,
    npass: u32,
    t0: i64,
    cpu_ms: i64,
    dl_fd: i64,
    dl_sp_p: u64, // the staged file's path (heap copy)
    dl_sp_n: usize,
    dl_last_ms: i64,
}

static mut G_DRV: u64 = 0

fn dec(v: i64) -> str {
    var b: rt.Buf = rt.buf_new()
    var x: i64 = v
    if x < 0 { x = 0 }
    rt.buf_push_dec_u64(&b, x as u64)
    let s: str = util.buf_to_str_copy(&b)
    rt.buf_free(&b)
    return s
}

fn drv_size[T: Any]() -> usize {
    return size_of[T]()
}

// Makes the driver and hands it to the updater (RUN_AUTO on a platform
// without threads then means RUN_ASYNC). `l` is the program's event loop.
fn install(u: *mut update.Updater, l: *mut loop.Loop) -> bool {
    let sz: usize = drv_size[Driver]()
    let p: u64 = rt.heap_alloc(sz)
    if p == 0 as u64 {
        return false
    }
    rt.mem_set(p, 0 as u8, sz)
    let d: *mut Driver = p as *mut Driver
    (*d).l = l
    (*d).up = u
    (*d).ah = ahttp.aclient_new()
    (*d).blob = rt.buf_new()
    G_DRV = p
    update.update_async_install(u, a_start, a_get)
    update.update_async_install_dl(u, dl_start)
    return true
}

fn rel_at(d: *mut Driver, i: usize) -> u64 {
    return ((&(*d).rel[0]) as u64) + (i * REL_MAX) as u64
}

fn map_layer(layer: u32, err: u32) -> u32 {
    if err == 15 as u32 { return fetch.FE_TOOLARGE }
    if layer == ahttp.NL_URL { return fetch.FE_URL }
    if layer == ahttp.NL_DNS { return fetch.FE_RESOLVE }
    if layer == ahttp.NL_TCP { return fetch.FE_CONNECT }
    if layer == ahttp.NL_TLS_NOROOTS || layer == ahttp.NL_TLS_CERT || layer == ahttp.NL_TLS_OTHER { return fetch.FE_TLS }
    if layer == ahttp.NL_TIMEOUT { return fetch.FE_TIMEOUT }
    if layer == ahttp.NL_CANCELLED { return fetch.FE_CANCELLED }
    return fetch.FE_RECV
}

// the answer to one request of the check, from what the requests brought in
fn a_get(up: u64, relp: u64, reln: usize, out: *mut rt.Buf, http_out: *mut u32) -> u32 {
    let d: *mut Driver = G_DRV as *mut Driver
    var i: usize = 0
    while i < (*d).n {
        if (*d).nrel[i] == reln && rt.mem_eq(rel_at(d, i), relp, reln) {
            if (*d).state[i] != 2 as u8 {
                return update.FE_PENDING
            }
            *http_out = (*d).code[i]
            rt.buf_clear(out)
            if (*d).res[i] == fetch.FE_OK {
                rt.buf_push_bytes(out, rt.buf_ptr(&(*d).blob) + (*d).off[i] as u64, (*d).len[i])
            }
            return (*d).res[i]
        }
        i = i + 1
    }
    if (*d).nneed == 0 && reln > 0 && reln < 128 {
        rt.mem_copy((&(*d).need[0]) as u64, relp, reln)
        (*d).nneed = reln
    }
    return update.FE_PENDING
}

// one request: the slot is the callback's user data
fn req(d: *mut Driver, rel: str, max: usize) -> bool {
    let i: usize = (*d).n
    if i >= SLOTS || rel.n == 0 || rel.n >= REL_MAX {
        return false
    }
    rt.mem_copy(rel_at(d, i), rel.p as u64, rel.n)
    (*d).nrel[i] = rel.n
    (*d).state[i] = 1 as u8
    (*d).res[i] = fetch.FE_OK
    (*d).code[i] = 0 as u32
    (*d).n = i + 1
    var url: rt.Buf = rt.buf_new()
    util.buf_push_str(&url, appinfo.app_store_url())
    util.buf_push_str(&url, rel)
    (*d).inflight = (*d).inflight + 1 as u32
    let r: *mut ahttp.Request = ahttp.aclient_get(&(*d).ah, rt.buf_ptr(&url), rt.buf_len(&url), REQ_TIMEOUT_MS, on_done, i as u64)
    rt.buf_free(&url)
    if r == 0 as *mut ahttp.Request {
        (*d).inflight = (*d).inflight - 1 as u32
        (*d).state[i] = 2 as u8
        (*d).res[i] = fetch.FE_MEMORY
        return false
    }
    ahttp.areq_set_max_body(r, max)
    return true
}

fn on_done(r: *mut ahttp.Request, ud: u64) {
    let d: *mut Driver = G_DRV as *mut Driver
    let i: usize = ud as usize
    var code: u32 = fetch.FE_OK
    var st: u32 = 0 as u32
    let err: u32 = ahttp.areq_error(r)
    log.log_info("update", "timing: roots " + dec(ahttp.ahttp_trust_roots() as i64) + " in " + dec(ahttp.ahttp_trust_ms())
        +" ms, open call " + dec(ahttp.ahttp_open_call_ms()) + " ms, open->ready " + dec(ahttp.ahttp_ready_ms()) + " ms")
    log.log_info("update", "handshake stages: keygen " + dec(tls.tls_stage_ms(0)) + " ms, key exchange " + dec(tls.tls_stage_ms(1))
        +" ms, chain " + dec(tls.tls_stage_ms(2)) + " ms in " + dec(tls.tls_stage_ms(5)) + " steps (longest " + dec(tls.tls_stage_ms(4)) + " ms), CertificateVerify " + dec(tls.tls_stage_ms(3)) + " ms")
    if err != 0 as u32 {
        code = map_layer(ahttp.areq_layer(r), err)
    } else {
        st = ahttp.areq_status(r)
        if st != 200 as u32 {
            code = fetch.FE_STATUS
        } else {
            (*d).off[i] = rt.buf_len(&(*d).blob)
            (*d).len[i] = ahttp.areq_body_len(r)
            rt.buf_push_bytes(&(*d).blob, ahttp.areq_body_ptr(r), ahttp.areq_body_len(r))
        }
    }
    (*d).res[i] = code
    (*d).code[i] = st
    (*d).state[i] = 2 as u8
    (*d).inflight = (*d).inflight - 1 as u32
    if (*d).inflight == 0 as u32 {
        step(d)
    }
}

fn need_str(d: *mut Driver) -> str {
    return str { p: (&(*d).need[0]) as *mut u8, n: (*d).nneed }
}

fn max_for(rel: str) -> usize {
    if rel == "entry.json" { return MAX_ENTRY }
    if rel == "entry.json.sig" || rel == "index.json.sig" { return MAX_SIG }
    return MAX_CATALOG
}

// all requests are answered: run a pass of the check
fn step(d: *mut Driver) {
    let u: *mut update.Updater = (*d).up
    if update.update_async_cancelled(u) {
        update.update_async_finish(u, update.PH_IDLE)
        return
    }
    (*d).npass = (*d).npass + 1 as u32
    (*d).nneed = 0
    let t: i64 = loop.mono_ms()
    let ph: u64 = update.update_check_blocking(u)
    let took: i64 = loop.mono_ms() - t
    (*d).cpu_ms = (*d).cpu_ms + took
    if ph == update.PH_PENDING {
        let rel: str = need_str(d)
        log.log_info("update", "pass " + dec((*d).npass as i64) + " " + dec(took) + " ms, asks " + rel)
        if rel.n == 0 || !req(d, rel, max_for(rel)) {
            update.update_async_fail(u, "cannot ask for the next file")
        }
        return
    }
    log.log_info("update", "pass " + dec((*d).npass as i64) + " " + dec(took) + " ms, done after " + dec(loop.mono_ms() - (*d).t0) + " ms (cpu " + dec((*d).cpu_ms) + " ms)")
    update.update_async_finish(u, ph)
}

// update_start (RUN_AUTO, no threads) calls this
fn a_start(up: u64, op: u32) -> bool {
    let d: *mut Driver = G_DRV as *mut Driver
    if d == 0 as *mut Driver {
        return false
    }
    if !(*d).ready {
        if !ahttp.aclient_init(&(*d).ah, (*d).l) {
            return false
        }
        (*d).ready = true
        http.client_set_gzip(ahttp.aclient_http(&(*d).ah), false) // a download must arrive as the store has it
        // the lookup runs on the loop (A1): it only bounds how long a dead server delays
        let rs: *mut dns.Resolver = http.client_resolver(ahttp.aclient_http(&(*d).ah))
        dns.resolver_set_timeout(rs, DNS_TIMEOUT_MS)
        dns.resolver_set_retries(rs, 2 as u32)
    }
    (*d).n = 0
    (*d).inflight = 0 as u32
    (*d).npass = 0 as u32
    (*d).nneed = 0
    (*d).cpu_ms = 0
    rt.buf_clear(&(*d).blob)
    (*d).t0 = loop.mono_ms()
    // entry.json and its signature are always needed: ask for both at once
    let a: bool = req(d, "entry.json", MAX_ENTRY)
    let b: bool = req(d, "entry.json.sig", MAX_SIG)
    if !a && !b {
        return false
    }
    // a request that failed to start is an answered one (FE_MEMORY); if both
    // were answered right away the pass runs now
    if (*d).inflight == 0 as u32 {
        step(d)
    }
    return true
}

// ------------------------------------------------------------ the download

// update_async_finish calls this for OP_FETCH: true = the driver owns the run now.
fn dl_start(up: u64) -> bool {
    let d: *mut Driver = G_DRV as *mut Driver
    if d == 0 as *mut Driver || !(*d).ready {
        return false
    }
    let u: *mut update.Updater = up as *mut update.Updater
    var fd: i64 = 0 - 1
    var sp: str = ""
    if update.update_fetch_prepare(u, &fd, &sp) != 0 {
        update.update_async_dl_end(u)
        return true
    }
    (*d).dl_fd = fd
    (*d).dl_sp_p = sp.p as u64
    (*d).dl_sp_n = sp.n
    (*d).dl_last_ms = 0
    var url: rt.Buf = rt.buf_new()
    update.update_fetch_url(u, &url)
    let r: *mut ahttp.Request = ahttp.aclient_get(&(*d).ah, rt.buf_ptr(&url), rt.buf_len(&url),
        DL_TIMEOUT_MS, on_dl_done, 0)
    rt.buf_free(&url)
    if r == 0 as *mut ahttp.Request {
        var dg0: [u8; 32] = [0 as u8; 32]
        syscall(3, fd, 0, 0, 0, 0, 0)
        update.update_fetch_complete(u, sp, fetch.FE_MEMORY, 0 as u32, 0 as u64, (&dg0[0]) as u64)
        update.update_async_dl_end(u)
        return true
    }
    ahttp.areq_set_max_body(r, update.update_fetch_size(u) as usize)
    ahttp.areq_set_sink(r, fd, dl_progress, 0)
    log.log_info("update", "download on the loop")
    return true
}

// After every write: progress for the screen (not more than every 150 ms),
// nonzero = the user cancelled.
fn dl_progress(ud: u64, got: u64) -> u32 {
    let d: *mut Driver = G_DRV as *mut Driver
    let u: *mut update.Updater = (*d).up
    if update.update_async_cancelled(u) {
        return 1 as u32
    }
    let now: i64 = loop.mono_ms()
    if now - (*d).dl_last_ms >= PROGRESS_MS {
        (*d).dl_last_ms = now
        update.update_progress(u, got, update.update_fetch_size(u))
    }
    return 0 as u32
}

fn on_dl_done(r: *mut ahttp.Request, ud: u64) {
    let d: *mut Driver = G_DRV as *mut Driver
    let u: *mut update.Updater = (*d).up
    var fe: u32 = fetch.FE_OK
    var st: u32 = 0 as u32
    let err: u32 = ahttp.areq_error(r)
    if err != 0 as u32 {
        if ahttp.areq_sink_failed(r) {
            fe = fetch.FE_SINK
        } else {
            fe = map_layer(ahttp.areq_layer(r), err)
        }
    } else {
        st = ahttp.areq_status(r)
        if st != 200 as u32 {
            fe = fetch.FE_STATUS
        }
    }
    var dg: [u8; 32] = [0 as u8; 32]
    ahttp.areq_sink_digest(r, (&dg[0]) as u64)
    let got: u64 = ahttp.areq_sink_got(r)
    syscall(74, (*d).dl_fd, 0, 0, 0, 0, 0)
    syscall(3, (*d).dl_fd, 0, 0, 0, 0, 0)
    (*d).dl_fd = 0 - 1
    let sp: str = str { p: (*d).dl_sp_p as *mut u8, n: (*d).dl_sp_n }
    update.update_progress(u, got, update.update_fetch_size(u))
    update.update_fetch_complete(u, sp, fe, st, got, (&dg[0]) as u64)
    update.update_async_dl_end(u)
}
