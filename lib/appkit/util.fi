// SPDX-License-Identifier: MPL-2.0
// lib/appkit/util.fi -- small helpers every appkit module shares: octet
// strings, hex, argument lists, UTF-8 <-> UTF-16, a lower case compare.
//
// Nothing here knows an operating system; the platform files
// (platform.fi, platform.windows.fi, ...) build on it.
import std.rt

export {
    Args, args_new, args_free, args_push, args_count,
    buf_push_str, buf_eq_str, buf_to_str_copy, buf_room,
    hex_encode, hex_decode, hex_digit,
    utf8_to_utf16, utf16_to_utf8,
    ends_with, starts_with, ci_starts_with, find_byte, rfind_byte,
    push_dec_pad,
}

fn buf_push_str(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

// does the buffer hold exactly `s`?
fn buf_eq_str(b: *mut rt.Buf, s: str) -> bool {
    if rt.buf_len(b) != s.n {
        return false
    }
    return rt.mem_eq(rt.buf_ptr(b), s.p as u64, s.n)
}

// A `str` that owns its octets (GC heap), copied out of the buffer.
fn buf_to_str_copy(b: *mut rt.Buf) -> str {
    return __str_copy(str { p: rt.buf_data(b), n: rt.buf_len(b) })
}

// make room for `n` octets; false when the allocator could not
fn buf_room(b: *mut rt.Buf, n: usize) -> bool {
    rt.buf_reserve(b, n)
    return (*b).cap >= n
}

fn hex_digit(v: u8) -> u8 {
    if v < 10 as u8 {
        return 48 as u8 + v
    }
    return 87 as u8 + v
}

// lower case hex of p[0, n) appended to `out`
fn hex_encode(p: u64, n: usize, out: *mut rt.Buf) {
    var i: usize = 0
    while i < n {
        let v: u8 = rt.ld8(p, i)
        rt.buf_push(out, hex_digit(v >> 4 as u8))
        rt.buf_push(out, hex_digit(v & 15 as u8))
        i = i + 1
    }
}

fn nib(c: u8) -> i32 {
    if c >= 48 as u8 && c <= 57 as u8 { return (c - 48 as u8) as i32 }
    if c >= 97 as u8 && c <= 102 as u8 { return (c - 87 as u8) as i32 }
    if c >= 65 as u8 && c <= 70 as u8 { return (c - 55 as u8) as i32 }
    return -1
}

// hex text -> octets into `out` (room for s.n / 2). Returns the octet
// count, or -1 when `s` is not an even number of hex digits.
fn hex_decode(s: str, out: u64) -> i64 {
    if s.n % 2 != 0 {
        return -1
    }
    var i: usize = 0
    while i < s.n / 2 {
        let hi: i32 = nib(rt.ld8(s.p as u64, i * 2))
        let lo: i32 = nib(rt.ld8(s.p as u64, i * 2 + 1))
        if hi < 0 || lo < 0 {
            return -1
        }
        rt.st8(out, i, ((hi << 4) | lo) as u8)
        i = i + 1
    }
    return (s.n / 2) as i64
}

// zero padded decimal, at least `width` digits
fn push_dec_pad(b: *mut rt.Buf, v: u64, width: usize) {
    var digits: [u8; 20] = [0; 20]
    var n: usize = 0
    var x: u64 = v
    if x == 0 as u64 {
        digits[0] = 48 as u8
        n = 1
    }
    while x > 0 as u64 {
        digits[n] = 48 as u8 + (x % 10 as u64) as u8
        x = x / 10 as u64
        n = n + 1
    }
    var pad: usize = 0
    if width > n {
        pad = width - n
    }
    while pad > 0 {
        rt.buf_push(b, 48 as u8)
        pad = pad - 1
    }
    while n > 0 {
        n = n - 1
        rt.buf_push(b, digits[n])
    }
}

fn starts_with(s: str, prefix: str) -> bool {
    if s.n < prefix.n {
        return false
    }
    return rt.mem_eq(s.p as u64, prefix.p as u64, prefix.n)
}

fn ends_with(s: str, suffix: str) -> bool {
    if s.n < suffix.n {
        return false
    }
    return rt.mem_eq(s.p as u64 + (s.n - suffix.n) as u64, suffix.p as u64, suffix.n)
}

fn lower8(c: u8) -> u8 {
    if c >= 65 as u8 && c <= 90 as u8 {
        return c + 32 as u8
    }
    return c
}

fn ci_starts_with(s: str, prefix: str) -> bool {
    if s.n < prefix.n {
        return false
    }
    var i: usize = 0
    while i < prefix.n {
        if lower8(rt.ld8(s.p as u64, i)) != lower8(rt.ld8(prefix.p as u64, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

// the first index of byte `c` in s, or s.n
fn find_byte(s: str, c: u8) -> usize {
    var i: usize = 0
    while i < s.n {
        if rt.ld8(s.p as u64, i) == c {
            return i
        }
        i = i + 1
    }
    return s.n
}

// the last index of byte `c` in s, or s.n when there is none
fn rfind_byte(s: str, c: u8) -> usize {
    var i: usize = s.n
    while i > 0 {
        i = i - 1
        if rt.ld8(s.p as u64, i) == c {
            return i
        }
    }
    return s.n
}

// ------------------------------------------------------------ argument list

// A program's arguments as NUL separated octets, in order. The platform
// layer turns it into an `argv` (POSIX) or a quoted command line (Windows).
struct Args {
    buf: rt.Buf,
    n: usize,
}

fn args_new() -> Args {
    return Args { buf: rt.buf_new(), n: 0 }
}

fn args_free(a: *mut Args) {
    rt.buf_free(&(*a).buf)
    (*a).n = 0
}

fn args_push(a: *mut Args, s: str) {
    rt.buf_push_bytes(&(*a).buf, s.p as u64, s.n)
    rt.buf_push(&(*a).buf, 0 as u8)
    (*a).n = (*a).n + 1
}

fn args_count(a: *mut Args) -> usize {
    return (*a).n
}

// --------------------------------------------------------------- UTF-16

// UTF-8 p[0, n) -> UTF-16LE code units appended to `out` (2 octets each).
// A malformed octet becomes U+FFFD. Returns the number of units.
fn utf8_to_utf16(p: u64, n: usize, out: *mut rt.Buf) -> usize {
    var units: usize = 0
    var i: usize = 0
    while i < n {
        let c: u32 = rt.ld8(p, i) as u32
        var cp: u32 = 0xFFFD as u32
        var take: usize = 1
        if c < 0x80 as u32 {
            cp = c
        } else if c >= 0xC2 as u32 && c < 0xE0 as u32 && i + 1 < n {
            let c1: u32 = rt.ld8(p, i + 1) as u32
            if (c1 & 0xC0 as u32) == 0x80 as u32 {
                cp = ((c & 0x1F as u32) << 6) | (c1 & 0x3F as u32)
                take = 2
            }
        } else if c >= 0xE0 as u32 && c < 0xF0 as u32 && i + 2 < n {
            let c1: u32 = rt.ld8(p, i + 1) as u32
            let c2: u32 = rt.ld8(p, i + 2) as u32
            if (c1 & 0xC0 as u32) == 0x80 as u32 && (c2 & 0xC0 as u32) == 0x80 as u32 {
                cp = ((c & 0x0F as u32) << 12) | ((c1 & 0x3F as u32) << 6) | (c2 & 0x3F as u32)
                take = 3
            }
        } else if c >= 0xF0 as u32 && c < 0xF5 as u32 && i + 3 < n {
            let c1: u32 = rt.ld8(p, i + 1) as u32
            let c2: u32 = rt.ld8(p, i + 2) as u32
            let c3: u32 = rt.ld8(p, i + 3) as u32
            if (c1 & 0xC0 as u32) == 0x80 as u32 && (c2 & 0xC0 as u32) == 0x80 as u32 &&
            (c3 & 0xC0 as u32) == 0x80 as u32 {
                cp = ((c & 0x07 as u32) << 18) | ((c1 & 0x3F as u32) << 12) |
                ((c2 & 0x3F as u32) << 6) | (c3 & 0x3F as u32)
                take = 4
            }
        }
        i = i + take
        if cp >= 0x10000 as u32 {
            let v: u32 = cp - 0x10000 as u32
            let hi: u32 = 0xD800 as u32 + (v >> 10)
            let lo: u32 = 0xDC00 as u32 + (v & 0x3FF as u32)
            rt.buf_push(out, (hi & 255 as u32) as u8)
            rt.buf_push(out, (hi >> 8) as u8)
            rt.buf_push(out, (lo & 255 as u32) as u8)
            rt.buf_push(out, (lo >> 8) as u8)
            units = units + 2
        } else {
            rt.buf_push(out, (cp & 255 as u32) as u8)
            rt.buf_push(out, (cp >> 8) as u8)
            units = units + 1
        }
    }
    return units
}

// UTF-16LE units p[0, units) (2 octets each, up to `units` or a zero unit
// when `until_nul`) -> UTF-8 appended to `out`. Returns the units read.
fn utf16_to_utf8(p: u64, units: usize, until_nul: bool, out: *mut rt.Buf) -> usize {
    var i: usize = 0
    while i < units {
        let u: u32 = rt.ld8(p, i * 2) as u32 | ((rt.ld8(p, i * 2 + 1) as u32) << 8)
        if until_nul && u == 0 as u32 {
            return i
        }
        var cp: u32 = u
        var step: usize = 1
        if u >= 0xD800 as u32 && u < 0xDC00 as u32 && i + 1 < units {
            let u2: u32 = rt.ld8(p, (i + 1) * 2) as u32 | ((rt.ld8(p, (i + 1) * 2 + 1) as u32) << 8)
            if u2 >= 0xDC00 as u32 && u2 < 0xE000 as u32 {
                cp = 0x10000 as u32 + ((u - 0xD800 as u32) << 10) + (u2 - 0xDC00 as u32)
                step = 2
            } else {
                cp = 0xFFFD as u32
            }
        } else if u >= 0xD800 as u32 && u < 0xE000 as u32 {
            cp = 0xFFFD as u32
        }
        i = i + step
        if cp < 0x80 as u32 {
            rt.buf_push(out, cp as u8)
        } else if cp < 0x800 as u32 {
            rt.buf_push(out, (0xC0 as u32 | (cp >> 6)) as u8)
            rt.buf_push(out, (0x80 as u32 | (cp & 0x3F as u32)) as u8)
        } else if cp < 0x10000 as u32 {
            rt.buf_push(out, (0xE0 as u32 | (cp >> 12)) as u8)
            rt.buf_push(out, (0x80 as u32 | ((cp >> 6) & 0x3F as u32)) as u8)
            rt.buf_push(out, (0x80 as u32 | (cp & 0x3F as u32)) as u8)
        } else {
            rt.buf_push(out, (0xF0 as u32 | (cp >> 18)) as u8)
            rt.buf_push(out, (0x80 as u32 | ((cp >> 12) & 0x3F as u32)) as u8)
            rt.buf_push(out, (0x80 as u32 | ((cp >> 6) & 0x3F as u32)) as u8)
            rt.buf_push(out, (0x80 as u32 | (cp & 0x3F as u32)) as u8)
        }
    }
    return i
}
