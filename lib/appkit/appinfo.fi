// SPDX-License-Identifier: MPL-2.0
// lib/appkit/appinfo.fi -- WHO THIS PROGRAM IS: name, version, build,
// channel, store address and the store's public key.
//
// ONE call at the top of `main` (the template does it):
//
//     appinfo.appinfo_init(AppSpec {
//         id: "fleilauncher",              // store name: exe:fleilauncher
//         name: "FleiLauncher", vendor: "FleiTec",
//         version: "0.5.5", build: 0,      // build 0 = the store assigns it
//         channel: "stabil",
//         store_url: "https://store.fleitec.com/",
//         store_key: "33f41a31...",        // 64 hex digits: the TRUST ANCHOR
//         android_id: "de.fleitec.fleilauncher" })
//
// WHERE EVERYTHING LIVES. The strings are copied into static storage of
// this module: every thread (the update worker!) reads the same octets, and
// nothing points into some thread's collected heap. The getters return
// `str` views of that storage; they stay valid for the life of the process.
//
// THE KEY. `store_key` is the Ed25519 public key the catalog signatures are
// checked against. It is compiled in on purpose (KATALOG-FORMAT.md section
// 4): the copy in `oeffentlich.key` on the server is only a convenience,
// and a program that fetched its trust anchor from the place it is meant to
// check would check nothing. Whoever changes these 64 digits makes the
// program talk to a different store.
//
// THE BUILD. `build` is the store's `build_id` when the release tool put
// it in (FIRN_BUILD_ID at build time); 0 means "not known". The updater does
// not need it: it recognises its own build by the SHA-256 of its executable
// (catalog.catalog_build_by_sha).
import std.rt
import appkit.util

export {
    AppSpec, appinfo_init, appinfo_ready,
    app_id, app_name, app_vendor, app_version, app_build, app_channel,
    app_store_url, app_android_id, app_key_ptr, app_title,
    app_set_channel, app_set_store,
    app_min_revision, app_set_min_revision,
}

struct AppSpec {
    id: str,
    name: str,
    vendor: str,
    version: str,
    build: i64,
    channel: str,
    store_url: str,
    store_key: str,
    android_id: str,
}

static mut G_READY: bool = false
static mut G_ID: [u8; 48] = [0; 48]
static mut G_NID: usize = 0
static mut G_NAME: [u8; 64] = [0; 64]
static mut G_NNAME: usize = 0
static mut G_VENDOR: [u8; 48] = [0; 48]
static mut G_NVENDOR: usize = 0
static mut G_VERSION: [u8; 48] = [0; 48]
static mut G_NVERSION: usize = 0
static mut G_BUILD: i64 = 0
static mut G_CHANNEL: [u8; 32] = [0; 32]
static mut G_NCHANNEL: usize = 0
static mut G_STORE: [u8; 192] = [0; 192]
static mut G_NSTORE: usize = 0
static mut G_KEY: [u8; 32] = [0; 32]
static mut G_ANDROID: [u8; 96] = [0; 96]
static mut G_NANDROID: usize = 0
static mut G_MINREV: i64 = 0

fn put(dst: u64, cap: usize, s: str, outn: *mut usize) -> bool {
    if s.n > cap {
        return false
    }
    rt.mem_copy(dst, s.p as u64, s.n)
    *outn = s.n
    return true
}

// Returns false when a text is too long or the key is not 64 hex digits;
// nothing is half set in that case (G_READY stays false).
fn appinfo_init(spec: AppSpec) -> bool {
    G_READY = false
    if !put((&G_ID[0]) as u64, 48, spec.id, &G_NID) || G_NID == 0 {
        return false
    }
    if !put((&G_NAME[0]) as u64, 64, spec.name, &G_NNAME) {
        return false
    }
    if !put((&G_VENDOR[0]) as u64, 48, spec.vendor, &G_NVENDOR) {
        return false
    }
    if !put((&G_VERSION[0]) as u64, 48, spec.version, &G_NVERSION) || G_NVERSION == 0 {
        return false
    }
    if !put((&G_CHANNEL[0]) as u64, 32, spec.channel, &G_NCHANNEL) {
        return false
    }
    if !put((&G_STORE[0]) as u64, 192, spec.store_url, &G_NSTORE) {
        return false
    }
    if !put((&G_ANDROID[0]) as u64, 96, spec.android_id, &G_NANDROID) {
        return false
    }
    if G_NCHANNEL == 0 {
        rt.mem_copy((&G_CHANNEL[0]) as u64, "stabil".p as u64, 6)
        G_NCHANNEL = 6
    }
    if spec.store_key.n != 64 {
        return false
    }
    if util.hex_decode(spec.store_key, (&G_KEY[0]) as u64) != 32 {
        return false
    }
    // the store address ends in a slash: files are named relative to it
    if G_NSTORE > 0 && G_STORE[G_NSTORE - 1] != 47 as u8 && G_NSTORE < 192 {
        G_STORE[G_NSTORE] = 47 as u8
        G_NSTORE = G_NSTORE + 1
    }
    G_BUILD = spec.build
    G_READY = true
    return true
}

fn appinfo_ready() -> bool {
    return G_READY
}

fn app_id() -> str {
    return str { p: (&G_ID[0]) as *mut u8, n: G_NID }
}

fn app_name() -> str {
    if G_NNAME == 0 {
        return app_id()
    }
    return str { p: (&G_NAME[0]) as *mut u8, n: G_NNAME }
}

fn app_vendor() -> str {
    if G_NVENDOR == 0 {
        return app_name()
    }
    return str { p: (&G_VENDOR[0]) as *mut u8, n: G_NVENDOR }
}

fn app_version() -> str {
    return str { p: (&G_VERSION[0]) as *mut u8, n: G_NVERSION }
}

fn app_build() -> i64 {
    return G_BUILD
}

fn app_channel() -> str {
    return str { p: (&G_CHANNEL[0]) as *mut u8, n: G_NCHANNEL }
}

fn app_store_url() -> str {
    return str { p: (&G_STORE[0]) as *mut u8, n: G_NSTORE }
}

fn app_android_id() -> str {
    return str { p: (&G_ANDROID[0]) as *mut u8, n: G_NANDROID }
}

fn app_key_ptr() -> u64 {
    return (&G_KEY[0]) as u64
}

// "FleiLauncher 0.5.5" for a window title or an about line
fn app_title(out: *mut rt.Buf) {
    util.buf_push_str(out, app_name())
    rt.buf_push(out, 32 as u8)
    util.buf_push_str(out, app_version())
}

// The user may pick another channel in the settings; the update module
// stores that and tells appinfo, so every module reads one answer.
fn app_set_channel(c: str) -> bool {
    if c.n == 0 || c.n > 32 {
        return false
    }
    rt.mem_copy((&G_CHANNEL[0]) as u64, c.p as u64, c.n)
    G_NCHANNEL = c.n
    return true
}

// Test stores and private mirrors: another address, same key.
fn app_set_store(u: str) -> bool {
    if u.n == 0 || u.n > 191 {
        return false
    }
    rt.mem_copy((&G_STORE[0]) as u64, u.p as u64, u.n)
    G_NSTORE = u.n
    if G_STORE[G_NSTORE - 1] != 47 as u8 {
        G_STORE[G_NSTORE] = 47 as u8
        G_NSTORE = G_NSTORE + 1
    }
    return true
}

// the lowest catalog revision this program accepts (KATALOG-FORMAT.md
// section 2, MINDEST_REVISION): a freshly installed program has no
// "last seen" number yet, and without this floor it would take any old,
// correctly signed catalog
fn app_min_revision() -> i64 {
    return G_MINREV
}

fn app_set_min_revision(r: i64) {
    G_MINREV = r
}
