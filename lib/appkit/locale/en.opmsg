# lib/appkit/locale/en.opmsg -- the texts of appkit's own pages (updates,
# settings, about, crash notice). English is the source language.
@lang en

app.name = {name}
about.title = About
about.version = Version {version}
about.channel = Update channel: {channel}
about.platform = Platform: {platform}

settings.title = Settings
settings.language = Language
settings.language-system = System language
settings.dark = Dark mode
settings.updates = Updates
settings.close = Close

update.title = Updates
update.check = Check for updates
update.checking = Checking for updates ...
update.uptodate = You have the latest version ({version}).
update.available = Version {version} is available.
update.notes = What is new
update.download = Download
update.downloading = Downloading ... {percent:number} %
update.verifying = Verifying the download ...
update.ready = Version {version} is ready to install.
update.install = Restart and install
update.installing = Installing ...
update.installer = The system installer takes over from here.
update.error = The update failed: {text}
update.retry = Try again
update.cancel = Cancel
update.channel = Channel
update.auto = Check for updates automatically
update.last-check = Last check: {when}
update.never = never
update.rolledback = Version {version} did not work and was undone. The previous version is running again.
update.banner = Version {version} is available
update.banner-ready = Version {version} is ready - restart to install

crash.title = The program ended unexpectedly
crash.text = A report was saved. It helps to find the problem.
crash.show = Show report
crash.dismiss = Dismiss
