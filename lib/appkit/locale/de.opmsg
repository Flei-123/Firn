# lib/appkit/locale/de.opmsg -- die Texte der appkit-Seiten auf Deutsch.
@lang de

app.name = {name}
about.title = Über
about.version = Version {version}
about.channel = Update-Kanal: {channel}
about.platform = Plattform: {platform}

settings.title = Einstellungen
settings.language = Sprache
settings.language-system = Systemsprache
settings.dark = Dunkler Modus
settings.updates = Updates
settings.close = Schließen

update.title = Updates
update.check = Nach Updates suchen
update.checking = Suche nach Updates ...
update.uptodate = Du hast die neueste Version ({version}).
update.available = Version {version} ist verfügbar.
update.notes = Was ist neu
update.download = Herunterladen
update.downloading = Lade herunter ... {percent:number} %
update.verifying = Prüfe den Download ...
update.ready = Version {version} ist bereit zur Installation.
update.install = Neu starten und installieren
update.installing = Installiere ...
update.installer = Ab hier übernimmt der System-Installer.
update.error = Das Update ist fehlgeschlagen: {text}
update.retry = Nochmal versuchen
update.cancel = Abbrechen
update.channel = Kanal
update.auto = Automatisch nach Updates suchen
update.last-check = Letzte Prüfung: {when}
update.never = nie
update.rolledback = Version {version} hat nicht funktioniert und wurde rückgängig gemacht. Die vorherige Version läuft wieder.
update.toast-ready = Update bereit
update.banner = Version {version} ist verfügbar
update.banner-ready = Version {version} ist bereit - zum Installieren neu starten

crash.title = Das Programm wurde unerwartet beendet
crash.text = Ein Bericht wurde gespeichert. Er hilft, das Problem zu finden.
crash.show = Bericht anzeigen
crash.dismiss = Schließen
