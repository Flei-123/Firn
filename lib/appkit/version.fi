// SPDX-License-Identifier: MPL-2.0
// lib/appkit/version.fi -- version numbers: parse, compare, print.
//
// WHAT A VERSION IS HERE. Up to four numeric components compared place by
// place, missing places count as 0 ("1.2" == "1.2.0" -- the OrientOS packages
// of the store are called "1.2" and "2.0.0" and are ordered exactly like
// that), and an optional semver pre-release ("0.6.0-beta.2"), which sorts
// BEFORE the plain release. Build metadata ("+abc") is read and ignored, as
// semver 2.0.0 section 10 says. A leading "v" is accepted ("v1.2.3").
//
// THE ORDER of pre-release identifiers is semver 2.0.0 section 11: numbers
// compare as numbers, words compare as ASCII, a number is lower than a
// word, and when all places before are equal the shorter list is lower
// ("1.0.0-alpha" < "1.0.0-alpha.1" < "1.0.0-alpha.beta" < "1.0.0-beta").
//
// Nothing here allocates; a Version is a fixed value.
import std.rt

export { Version, version_new, version_parse, version_cmp, version_write,
    version_is_pre, version_cmp_text, VERSION_MAX_PRE }

const NUM_MAX: usize = 4
const VERSION_MAX_PRE: usize = 48

struct Version {
    n: [u64; 4],
    ncomp: usize,
    pre: [u8; 48],
    npre: usize,
}

fn version_new() -> Version {
    return Version { n: [0; 4], ncomp: 0, pre: [0; 48], npre: 0 }
}

fn is_digit(c: u8) -> bool {
    return c >= 48 as u8 && c <= 57 as u8
}

fn is_alnum_or_dash(c: u8) -> bool {
    if is_digit(c) { return true }
    if c >= 65 as u8 && c <= 90 as u8 { return true }
    if c >= 97 as u8 && c <= 122 as u8 { return true }
    return c == 45 as u8
}

// Reads `p[0, n)` into `v`. false = not a version (empty, a letter where a
// number belongs, an empty place "1..2", more than four places, a number
// above 2^60, an over long pre-release).
fn version_parse(p: u64, n: usize, v: *mut Version) -> bool {
    *v = version_new()
    var i: usize = 0
    if i < n && (rt.ld8(p, i) == 118 as u8 || rt.ld8(p, i) == 86 as u8) {
        i = i + 1
    }
    var comps: usize = 0
    while true {
        if i >= n || !is_digit(rt.ld8(p, i)) {
            return false
        }
        var val: u64 = 0
        while i < n && is_digit(rt.ld8(p, i)) {
            val = val * 10 as u64 + (rt.ld8(p, i) - 48 as u8) as u64
            if val > 1152921504606846976 as u64 {
                return false
            }
            i = i + 1
        }
        if comps >= NUM_MAX {
            return false
        }
        (*v).n[comps] = val
        comps = comps + 1
        if i < n && rt.ld8(p, i) == 46 as u8 {
            i = i + 1
            continue
        }
        break
    }
    (*v).ncomp = comps
    if i < n && rt.ld8(p, i) == 45 as u8 {
        i = i + 1
        var k: usize = 0
        while i < n && rt.ld8(p, i) != 43 as u8 {
            let c: u8 = rt.ld8(p, i)
            if !is_alnum_or_dash(c) && c != 46 as u8 {
                return false
            }
            if k >= VERSION_MAX_PRE {
                return false
            }
            (*v).pre[k] = c
            k = k + 1
            i = i + 1
        }
        if k == 0 {
            return false
        }
        (*v).npre = k
    }
    if i < n && rt.ld8(p, i) == 43 as u8 {
        i = i + 1
        // build metadata: identifiers of [0-9A-Za-z-] separated by dots
        if i >= n {
            return false
        }
        while i < n {
            let c: u8 = rt.ld8(p, i)
            if !is_alnum_or_dash(c) && c != 46 as u8 {
                return false
            }
            i = i + 1
        }
    }
    return i == n
}

fn version_is_pre(v: *mut Version) -> bool {
    return (*v).npre > 0
}

// one pre-release identifier [s, e) of `v`: is it all digits?
fn id_numeric(v: *mut Version, s: usize, e: usize) -> bool {
    if s >= e { return false }
    var i: usize = s
    while i < e {
        if !is_digit((*v).pre[i]) { return false }
        i = i + 1
    }
    return true
}

fn id_value(v: *mut Version, s: usize, e: usize) -> u64 {
    var val: u64 = 0
    var i: usize = s
    while i < e {
        if val < 1000000000000000 as u64 {
            val = val * 10 as u64 + ((*v).pre[i] - 48 as u8) as u64
        }
        i = i + 1
    }
    return val
}

fn pre_cmp(a: *mut Version, b: *mut Version) -> i32 {
    var ia: usize = 0
    var ib: usize = 0
    while true {
        let a_end: bool = ia >= (*a).npre
        let b_end: bool = ib >= (*b).npre
        if a_end && b_end { return 0 }
        if a_end { return -1 }
        if b_end { return 1 }
        var ea: usize = ia
        while ea < (*a).npre && (*a).pre[ea] != 46 as u8 { ea = ea + 1 }
        var eb: usize = ib
        while eb < (*b).npre && (*b).pre[eb] != 46 as u8 { eb = eb + 1 }
        let na: bool = id_numeric(a, ia, ea)
        let nb: bool = id_numeric(b, ib, eb)
        if na && nb {
            let x: u64 = id_value(a, ia, ea)
            let y: u64 = id_value(b, ib, eb)
            if x < y { return -1 }
            if x > y { return 1 }
        } else if na {
            return -1
        } else if nb {
            return 1
        } else {
            var k: usize = 0
            let la: usize = ea - ia
            let lb: usize = eb - ib
            while k < la && k < lb {
                let ca: u8 = (*a).pre[ia + k]
                let cb: u8 = (*b).pre[ib + k]
                if ca < cb { return -1 }
                if ca > cb { return 1 }
                k = k + 1
            }
            if la < lb { return -1 }
            if la > lb { return 1 }
        }
        ia = ea + 1
        ib = eb + 1
    }
    return 0
}

// -1, 0, 1: a < b, a == b, a > b.
fn version_cmp(a: *mut Version, b: *mut Version) -> i32 {
    var i: usize = 0
    while i < NUM_MAX {
        if (*a).n[i] < (*b).n[i] { return -1 }
        if (*a).n[i] > (*b).n[i] { return 1 }
        i = i + 1
    }
    // a release is higher than any pre-release of the same numbers
    if (*a).npre == 0 && (*b).npre == 0 { return 0 }
    if (*a).npre == 0 { return 1 }
    if (*b).npre == 0 { return -1 }
    return pre_cmp(a, b)
}

// Compares two texts. `ok` says whether BOTH were versions; when one is not,
// the answer is 0 and ok is false (the caller decides what a broken version
// means -- the updater treats it as "no update").
fn version_cmp_text(a: str, b: str, ok: *mut bool) -> i32 {
    var x: Version = version_new()
    var y: Version = version_new()
    if !version_parse(a.p as u64, a.n, &x) || !version_parse(b.p as u64, b.n, &y) {
        *ok = false
        return 0
    }
    *ok = true
    return version_cmp(&x, &y)
}

// "1.2.3" or "1.2.3-beta.2": the numbers as they were given (at least
// three places so a "1.2" prints as "1.2.0").
fn version_write(v: *mut Version, out: *mut rt.Buf) {
    var places: usize = (*v).ncomp
    if places < 3 { places = 3 }
    var i: usize = 0
    while i < places {
        if i > 0 { rt.buf_push(out, 46 as u8) }
        rt.buf_push_dec_u64(out, (*v).n[i])
        i = i + 1
    }
    if (*v).npre > 0 {
        rt.buf_push(out, 45 as u8)
        rt.buf_push_bytes(out, (&(*v).pre[0]) as u64, (*v).npre)
    }
}
