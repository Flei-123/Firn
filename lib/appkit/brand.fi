// lib/appkit/brand.fi -- the product brand of the system the program runs on: name, slug, vendor, web address.
import std.rt
import appkit.platform

export { product_name, product_slug, vendor_name, product_web, brand_text }

const CAP: usize = 96

static mut NAME: [u8; 96] = [0 as u8; 96]
static mut NAME_N: usize = 0
static mut NAME_DONE: bool = false
static mut SLUG: [u8; 96] = [0 as u8; 96]
static mut SLUG_N: usize = 0
static mut SLUG_DONE: bool = false
static mut VENDOR: [u8; 96] = [0 as u8; 96]
static mut VENDOR_N: usize = 0
static mut VENDOR_DONE: bool = false
static mut WEB: [u8; 96] = [0 as u8; 96]
static mut WEB_N: usize = 0
static mut WEB_DONE: bool = false

fn load(key: str, dst: u64) -> usize {
    var b: rt.Buf = rt.buf_new()
    var n: usize = 0
    if platform.plat_brand(key, &b) {
        n = rt.buf_len(&b)
        if n > CAP - 1 {
            n = CAP - 1
        }
        rt.mem_copy(dst, rt.buf_ptr(&b), n)
    }
    rt.st8(dst, n, 0 as u8)
    rt.buf_free(&b)
    return n
}

fn product_name() -> str {
    if !NAME_DONE {
        NAME_N = load("product", (&NAME[0]) as u64)
        NAME_DONE = true
    }
    return str { p: (&NAME[0]) as *mut u8, n: NAME_N }
}

fn product_slug() -> str {
    if !SLUG_DONE {
        SLUG_N = load("slug", (&SLUG[0]) as u64)
        SLUG_DONE = true
    }
    return str { p: (&SLUG[0]) as *mut u8, n: SLUG_N }
}

fn vendor_name() -> str {
    if !VENDOR_DONE {
        VENDOR_N = load("vendor", (&VENDOR[0]) as u64)
        VENDOR_DONE = true
    }
    return str { p: (&VENDOR[0]) as *mut u8, n: VENDOR_N }
}

fn product_web() -> str {
    if !WEB_DONE {
        WEB_N = load("web", (&WEB[0]) as u64)
        WEB_DONE = true
    }
    return str { p: (&WEB[0]) as *mut u8, n: WEB_N }
}

fn brand_text(key: str) -> str {
    if key == "product" {
        return product_name()
    }
    if key == "slug" {
        return product_slug()
    }
    if key == "vendor" {
        return vendor_name()
    }
    return product_web()
}
