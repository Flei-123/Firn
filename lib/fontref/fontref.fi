import std.rt
import font.ttf
import font.raster

export {
    RefFont, ref_new, ref_load, ref_load_bytes, ref_free, ref_loaded, ref_upem, ref_has, ref_advance,
    ref_bbox, ref_outline, ref_glyph_count,
}

const SCRATCH_BYTES: usize = 2097152
const MIN_TTF_BYTES: usize = 12

struct RefFont {
    font: ttf.Font,
    data: rt.Buf,
    scratch: u64,
    loaded: bool,
}

fn ref_new() -> RefFont {
    return RefFont { font: ttf.font_new(), data: rt.buf_new(), scratch: 0, loaded: false }
}

fn ref_free(r: *mut RefFont) {
    rt.buf_free(&(*r).data)
    (*r).data = rt.buf_new()
    (*r).font = ttf.font_new()
    (*r).loaded = false
}

fn ref_load_bytes(r: *mut RefFont, p: u64, n: usize) -> bool {
    ref_free(r)
    if n < MIN_TTF_BYTES { return false }
    rt.buf_push_bytes(&(*r).data, p, n)
    return ref_init(r)
}

fn ref_load(r: *mut RefFont, path: str) -> bool {
    ref_free(r)
    var nul: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&nul, path.p as u64, path.n)
    rt.buf_push(&nul, 0 as u8)
    let read: bool = rt.read_file(rt.buf_ptr(&nul), &(*r).data)
    rt.buf_free(&nul)
    if !read || rt.buf_len(&(*r).data) < MIN_TTF_BYTES {
        ref_free(r)
        return false
    }
    return ref_init(r)
}

fn ref_init(r: *mut RefFont) -> bool {
    if !ttf.font_init(&(*r).font, rt.buf_ptr(&(*r).data) as *mut u8, rt.buf_len(&(*r).data)) {
        ref_free(r)
        return false
    }
    if (*r).scratch == 0 {
        (*r).scratch = rt.heap_alloc(SCRATCH_BYTES)
    }
    (*r).loaded = true
    return true
}

fn ref_loaded(r: *mut RefFont) -> bool {
    return (*r).loaded
}

fn ref_upem(r: *mut RefFont) -> f64 {
    if !(*r).loaded {
        return 1000.0
    }
    return ttf.font_upem(&(*r).font) as f64
}

fn ref_glyph_count(r: *mut RefFont) -> usize {
    if !(*r).loaded {
        return 0
    }
    return ttf.font_num_glyphs(&(*r).font) as usize
}

fn gid_of(r: *mut RefFont, cp: u32) -> u32 {
    if !(*r).loaded {
        return 0 as u32
    }
    return ttf.font_glyph_for(&(*r).font, cp)
}

fn ref_has(r: *mut RefFont, cp: u32) -> bool {
    return gid_of(r, cp) != (0 as u32)
}

fn ref_advance(r: *mut RefFont, cp: u32) -> f64 {
    let gid: u32 = gid_of(r, cp)
    if gid == (0 as u32) {
        return 0.0
    }
    return ttf.font_advance(&(*r).font, gid) as f64
}

fn ref_bbox(r: *mut RefFont, cp: u32, x0: *mut f64, y0: *mut f64, x1: *mut f64, y1: *mut f64) -> bool {
    let gid: u32 = gid_of(r, cp)
    if gid == (0 as u32) {
        return false
    }
    var a: i32 = 0
    var b: i32 = 0
    var c: i32 = 0
    var d: i32 = 0
    if !ttf.font_glyph_bbox(&(*r).font, gid, &a, &b, &c, &d) {
        return false
    }
    *x0 = a as f64
    *y0 = b as f64
    *x1 = c as f64
    *y1 = d as f64
    return true
}

fn ref_outline(r: *mut RefFont, cp: u32, rs: *mut raster.Raster, ox: f64, oy: f64, scale: f64) -> bool {
    let gid: u32 = gid_of(r, cp)
    if gid == (0 as u32) {
        return false
    }
    return ttf.font_outline(&(*r).font, gid, rs, ox, oy, scale, (*r).scratch as *mut u8, SCRATCH_BYTES, 0)
}
