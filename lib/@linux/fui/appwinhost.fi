// SPDX-License-Identifier: MPL-2.0
import std.rt
import window.window
import plat.fuiwin

export {
    Driver, supported, add, alive, count, open_count, bind, unbind, serve, windows, wait_ms, close_all,
    SLOT_MAX,
}

const SLOT_MAX: usize = 7

struct Driver {
    fonts: u64,
    open: fn(u64, u64, *mut fuiwin.Window) -> bool,
    step: fn(u64, *mut fuiwin.Window) -> bool,
    wait_ms: fn(u64) -> i64,
    done: fn(u64) -> bool,
}

struct Slot {
    app: u64,
    hooks: u64,
    closed: fn(u64),
    live: bool,
    up: bool,
    fx: fuiwin.Window,
}

static mut SLOTS: [u64; 7] = [0; 7]
static mut DRIVER: u64 = 0

fn closed_none(app: u64) {}

fn slot_size() -> usize {
    var probe: [Slot; 2] = [slot_blank(); 2]
    return ((&probe[1]) as usize) - ((&probe[0]) as usize)
}

fn slot_blank() -> Slot {
    return Slot { app: 0, hooks: 0, closed: closed_none, live: false, up: false, fx: fuiwin.window_new() }
}

fn supported() -> bool {
    return true
}

fn slot_at(i: usize) -> *mut Slot {
    return SLOTS[i] as *mut Slot
}

fn add(app: u64, hooks: u64, closed: fn(u64)) -> bool {
    var i: usize = 0
    while i < SLOT_MAX {
        if SLOTS[i] == 0 {
            let p: u64 = rt.heap_alloc(slot_size())
            if p == 0 {
                return false
            }
            *(p as *mut Slot) = slot_blank()
            SLOTS[i] = p
        }
        let s: *mut Slot = slot_at(i)
        if !(*s).live {
            (*s).app = app
            (*s).hooks = hooks
            (*s).closed = closed
            (*s).live = true
            (*s).up = false
            return true
        }
        i = i + 1
    }
    return false
}

fn alive(app: u64) -> bool {
    var i: usize = 0
    while i < SLOT_MAX {
        if SLOTS[i] != 0 && (*slot_at(i)).live && (*slot_at(i)).app == app {
            return true
        }
        i = i + 1
    }
    return false
}

fn count() -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < SLOT_MAX {
        if SLOTS[i] != 0 && (*slot_at(i)).live {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn open_count() -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < SLOT_MAX {
        if SLOTS[i] != 0 && (*slot_at(i)).live && (*slot_at(i)).up {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn bind(d: *mut Driver) {
    DRIVER = d as u64
}

fn unbind() {
    DRIVER = 0
}

fn drv() -> *mut Driver {
    return DRIVER as *mut Driver
}

fn finish(s: *mut Slot) {
    if (*s).up {
        fuiwin.window_close(&(*s).fx)
    }
    (*s).live = false
    (*s).up = false
    let f: fn(u64) = (*s).closed
    f((*s).app)
}

fn serve() {
    if DRIVER == 0 {
        return
    }
    var i: usize = 0
    while i < SLOT_MAX {
        if SLOTS[i] != 0 && (*slot_at(i)).live {
            serve_one(slot_at(i))
        }
        i = i + 1
    }
}

fn serve_one(s: *mut Slot) {
    let d: *mut Driver = drv()
    let done: fn(u64) -> bool = (*d).done
    if done((*s).hooks) {
        finish(s)
        return
    }
    if !(*s).up {
        let op: fn(u64, u64, *mut fuiwin.Window) -> bool = (*d).open
        if !op((*s).hooks, (*d).fonts, &(*s).fx) {
            (*s).live = false
            let f: fn(u64) = (*s).closed
            f((*s).app)
            return
        }
        (*s).up = true
    }
    let st: fn(u64, *mut fuiwin.Window) -> bool = (*d).step
    if !st((*s).hooks, &(*s).fx) {
        finish(s)
    }
}

fn windows(out: *mut [u64; 8], first: u64) -> usize {
    (*out)[0] = first
    var n: usize = 1
    var i: usize = 0
    while i < SLOT_MAX {
        if SLOTS[i] != 0 && (*slot_at(i)).live && (*slot_at(i)).up {
            (*out)[n] = fuiwin.window_window(&(*slot_at(i)).fx) as u64
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn wait_ms(ms: i64) -> i64 {
    if DRIVER == 0 {
        return ms
    }
    var best: i64 = ms
    let w: fn(u64) -> i64 = (*drv()).wait_ms
    var i: usize = 0
    while i < SLOT_MAX {
        if SLOTS[i] != 0 && (*slot_at(i)).live && !(*slot_at(i)).up {
            return 0
        }
        if SLOTS[i] != 0 && (*slot_at(i)).live && (*slot_at(i)).up {
            let t: i64 = w((*slot_at(i)).hooks)
            if t >= 0 && (best < 0 || t < best) {
                best = t
            }
        }
        i = i + 1
    }
    return best
}

fn close_all() {
    var i: usize = 0
    while i < SLOT_MAX {
        if SLOTS[i] != 0 && (*slot_at(i)).live {
            finish(slot_at(i))
        }
        i = i + 1
    }
}
