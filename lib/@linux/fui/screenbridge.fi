import std.rt
import std.env
import fui.atspi
import fui.screenax
import fui.screenaxtree
import fui.apphost

export { enable }

struct Link {
    tree: u64,
    ud: u64,
    act: fn(u64, usize) -> bool,
    focus: fn(u64, usize) -> bool,
    setnum: fn(u64, usize, i64) -> bool,
    settext: fn(u64, usize, str) -> bool,
    setcaret: fn(u64, usize, usize, usize) -> bool,
}

fn on_act(ud: u64, node: usize, row: usize) -> bool {
    let l: *mut Link = ud as *mut Link
    let i: usize = screenaxtree.reg_of_node((*l).tree as *mut screenaxtree.Tree, node)
    if i == screenax.NONE { return false }
    return ((*l).act)((*l).ud, i)
}

fn on_focus(ud: u64, node: usize) -> bool {
    let l: *mut Link = ud as *mut Link
    let i: usize = screenaxtree.reg_of_node((*l).tree as *mut screenaxtree.Tree, node)
    if i == screenax.NONE { return false }
    return ((*l).focus)((*l).ud, i)
}

fn on_setnum(ud: u64, node: usize, v: i64) -> bool {
    let l: *mut Link = ud as *mut Link
    let i: usize = screenaxtree.reg_of_node((*l).tree as *mut screenaxtree.Tree, node)
    if i == screenax.NONE { return false }
    return ((*l).setnum)((*l).ud, i, v)
}

#[allow_escape]
fn on_settext(ud: u64, node: usize, t: str) -> bool {
    let l: *mut Link = ud as *mut Link
    let i: usize = screenaxtree.reg_of_node((*l).tree as *mut screenaxtree.Tree, node)
    if i == screenax.NONE { return false }
    return ((*l).settext)((*l).ud, i, t)
}

fn on_getcaret(ud: u64, node: usize, caret: *mut usize, anchor: *mut usize) -> bool {
    let l: *mut Link = ud as *mut Link
    let i: usize = screenaxtree.reg_of_node((*l).tree as *mut screenaxtree.Tree, node)
    if i == screenax.NONE { return false }
    return screenax.caret_of(i, caret, anchor)
}

fn on_setcaret(ud: u64, node: usize, anchor: usize, caret: usize) -> bool {
    let l: *mut Link = ud as *mut Link
    let i: usize = screenaxtree.reg_of_node((*l).tree as *mut screenaxtree.Tree, node)
    if i == screenax.NONE { return false }
    return ((*l).setcaret)((*l).ud, i, anchor, caret)
}

#[allow_escape]
fn enable(hk: *mut apphost.Hooks, t: *mut screenaxtree.Tree, title: str, ud: u64, act: fn(u64, usize) -> bool, focus: fn(u64, usize) -> bool, click: fn(u64, f64, f64) -> bool, setnum: fn(u64, usize, i64) -> bool, settext: fn(u64, usize, str) -> bool, setcaret: fn(u64, usize, usize, usize) -> bool) -> bool {
    let v: str = env.get("FUI_ATSPI")
    if v.n == 0 { return false }
    let br: *mut atspi.Bridge = rt.heap_alloc(65536) as *mut atspi.Bridge
    *br = atspi.bridge_new(screenaxtree.tree_scene(t), screenaxtree.tree_ax(t), title)
    let l: *mut Link = rt.heap_alloc(256) as *mut Link
    (*l).tree = t as u64
    (*l).ud = ud
    (*l).act = act
    (*l).focus = focus
    (*l).setnum = setnum
    (*l).settext = settext
    (*l).setcaret = setcaret
    atspi.bridge_set_actions(br, l as u64, on_act, on_focus)
    atspi.bridge_set_setters(br, on_setnum, on_settext)
    atspi.bridge_set_carets(br, on_getcaret, on_setcaret)
    var ok: bool = false
    if v == "1" {
        ok = atspi.bridge_open(br)
    } else {
        ok = atspi.bridge_open_address(br, v)
    }
    if !ok { return false }
    apphost.hooks_set_pump(hk, br as u64, atspi.pump_fd, atspi.pump_ms, atspi.pump_step)
    return true
}
