// SPDX-License-Identifier: MPL-2.0
// lib/@linux/fui/apphost.fi -- lib/fui/app.fi IN AN X11 WINDOW.
//
// firnc finds this file for `import fui.apphost` when it builds for Linux
// (compiler/src/target.rs `platform_dir` = "@linux"); the browser build
// finds lib/@web/fui/apphost.fi instead. Both export the same names --
// `Hooks`, `hooks_blank`, `hooks_new`, `run`, `PLATFORM` -- and app.fi
// imports neither of them by name.
//
// What this file does: load the font (lib/plat/sysfont.fi: DejaVu Sans),
// open the window through lib/plat/fuiwin.fi (which sets the scale from
// Xft.dpi and follows the system's light/dark), route keys and
// characters to a focused text field first (fuiwin's input hook), and run
// the loop -- asleep in `poll` while nothing changes, one frame per
// change, until the window is closed or the program calls app.quit.
//
// window.window imports `window.backend`; for a native build that is
// lib/@linux/window/backend.fi, a link to lib/window/x11.fi -- the program
// needs no symlink of its own.
import std.rt
import font.metrics
import fui.theme
import fui.painter
import fui.editor
import fui.textbuf
import window.window
import plat.fuiwirt
import plat.fuiwin
import plat.sysfont
import plat.envvar
import plat.fuipopup
import fui.menuview

export {
    Hooks, hooks_blank, hooks_new, hooks_set_audit, hooks_set_buf, hooks_set_edited, hooks_set_popups, hooks_set_pump, hooks_set_window, hooks_set_ime, ImeBind, ime_install, run,
    PLATFORM,
    PLATFORM_LINUX, PLATFORM_WEB,
}

const PLATFORM_LINUX: u32 = 1
const PLATFORM_WEB: u32 = 2
const PLATFORM: u32 = 1
const FONTSET_BYTES: usize = 4096
// the X11 keycode of F5 (lib/window/window.fi names only F10)
const K_F5: u32 = 71

// What the application gives the platform. `ud` goes back into every
// call; `m` / `host` are its *mut theme.Theme and *mut fuiwirt.Host.
struct Hooks {
    ud: u64,
    m: u64,
    host: u64,
    attach: fn(u64, *mut painter.Painter),
    paint: fn(u64, usize, usize),
    key: fn(u64, u32, u32) -> bool,
    text: fn(u64, u32, u32) -> bool,
    press: fn(u64, f64, f64),
    act: fn(u64, usize),
    done: fn(u64) -> bool,
    field: fn(u64, *mut [f64; 4]) -> bool,
    title: str,
    w: usize,
    h: usize,
    // THE AUDIT MODE (roadmap r98): with FUI_AUDIT set in the environment
    // `run` opens NO window; it asks the program for its audit (the
    // accessibility checks of lib/fui/audit.fi on the tree it just built)
    // and returns that as the exit code. 0 = no hook.
    audit: fn(u64) -> i32,
    has_audit: bool,
    // THE FOCUSED TEXT FIELD'S BUFFER (r114): a *mut textbuf.TextBuf as u64,
    // 0 = no field has the focus. A phone's on-screen keyboard follows it and
    // types into it (window.text_input / window.text_sync).
    buf: fn(u64) -> u64,
    // The platform (the on-screen keyboard) changed the focused field's text
    // or caret: the program wakes its caret (it stands visible again).
    edited: fn(u64),
    // THE MENU VIEW (r168): the program's lib/fui/menuview.fi, 0 = none yet; this
    // host gives its menus windows of their own on the screen
    popups: fn(u64) -> u64,
    // THE INPUT METHOD (r444b, lib/plat/fuitext.fi): pre-edit text / commit / cancel / delete-surrounding of the focused field, "the
    // field takes the pending pre-edit text as it is" (a click), and the caret (x, y, height in window pixels) for the candidate window
    ime_pre: fn(u64, u64, usize, usize) -> bool,
    ime_commit: fn(u64, u64, usize) -> bool,
    ime_end: fn(u64),
    ime_del: fn(u64, usize, usize) -> bool,
    ime_confirm: fn(u64),
    ime_spot: fn(u64, *mut [f64; 3]) -> bool,
    // THE PUMP (roadmap: fUi + network in one thread, lib/fui/looppump.fi): a
    // second thing the window loop serves besides the window. `pump_fd` is a
    // descriptor that is readable while the pump has work (async.loop's
    // loop_fd; -1 = none), `pump_ms` caps the sleep so timers fire (the sleep
    // the host wants -> the sleep the pump allows), `pump_step` serves it once
    // and answers true when something happened (the host then repaints).
    has_pump: bool,
    pump_ud: u64,
    pump_fd: fn(u64) -> i32,
    pump_ms: fn(u64, i64) -> i64,
    pump_step: fn(u64) -> bool,
    // THE WINDOW HANDLE AND GLOBAL HOTKEYS (lib/window/extras.fi): `win_opened(win_ud, win)` is called once, right after the
    // window is open, with the *mut window.Window as u64 (valid until `run` returns) -- for topmost, place_corner, hotkey_set ...
    // `win_hotkey(win_ud, id)` hears window.EV_HOTKEY.
    win_ud: u64,
    win_opened: fn(u64, u64),
    win_hotkey: fn(u64, u32),
}

// THE INPUT METHOD TABLE (r444b). apphost does NOT import plat.fuitext: that pulls in std.dynlib (libX11), which makes the image a
// dynamically linked ELF on Linux and does not build for aarch64, so every fUi program would lose its static image. A program that
// wants XIM / IMM32 text input imports plat.fuiime and calls `fuiime.enable()` before app.run; that installs this table. Without
// it every call below is skipped and the window sends plain EV_CHAR as before.
struct ImeBind {
    open: fn(*mut window.Window) -> bool,
    set_sink: fn(u64, fn(u64, u64, usize, usize) -> bool, fn(u64, u64, usize) -> bool, fn(u64), fn(u64, usize, usize) -> bool),
    event: fn(u32, u32, u32, f64, f64),
    swallow: fn(u32, u32, u32) -> bool,
    pump: fn(),
    fd: fn() -> i32,
    reset: fn(),
    spot: fn(f64, f64, f64),
    on: fn() -> bool,
    close: fn(),
}

static mut IME_TABLE: u64 = 0

fn ime_install(b: *mut ImeBind) {
    IME_TABLE = b as u64
}

fn ime_tab() -> *mut ImeBind {
    return IME_TABLE as *mut ImeBind
}

fn ime_pre_none(ud: u64, p: u64, n: usize, caret: usize) -> bool {
    return false
}

fn ime_commit_none(ud: u64, p: u64, n: usize) -> bool {
    return false
}

fn ime_end_none(ud: u64) {
}

fn ime_del_none(ud: u64, before: usize, after: usize) -> bool {
    return false
}

fn ime_spot_none(ud: u64, out: *mut [f64; 3]) -> bool {
    return false
}

fn pump_fd_none(ud: u64) -> i32 {
    return 0 - 1
}

fn pump_ms_none(ud: u64, ms: i64) -> i64 {
    return ms
}

fn pump_step_none(ud: u64) -> bool {
    return false
}

fn win_opened_none(ud: u64, win: u64) {
}

fn win_hotkey_none(ud: u64, id: u32) {
}

fn audit_none(ud: u64) -> i32 {
    return 0
}

fn buf_none(ud: u64) -> u64 {
    return 0
}

fn edited_none(ud: u64) {
}

fn popups_none(ud: u64) -> u64 {
    return 0
}

fn attach_none(ud: u64, z: *mut painter.Painter) {
}

fn paint_none(ud: u64, w: usize, h: usize) {
}

fn key_none(ud: u64, k: u32, m: u32) -> bool {
    return false
}

fn press_none(ud: u64, x: f64, y: f64) {
}

fn act_none(ud: u64, i: usize) {
}

fn done_none(ud: u64) -> bool {
    return true
}

fn field_none(ud: u64, out: *mut [f64; 4]) -> bool {
    return false
}

fn hooks_blank() -> Hooks {
    return Hooks { ud: 0, m: 0, host: 0, attach: attach_none,
        paint: paint_none, key: key_none, text: key_none, press: press_none,
        act: act_none, done: done_none, field: field_none, title: "",
        w: 0, h: 0, audit: audit_none, has_audit: false, buf: buf_none,
        edited: edited_none, popups: popups_none, ime_pre: ime_pre_none,
        ime_commit: ime_commit_none, ime_end: ime_end_none, ime_del: ime_del_none, ime_confirm: ime_end_none,
        ime_spot: ime_spot_none, has_pump: false, pump_ud: 0,
        pump_fd: pump_fd_none, pump_ms: pump_ms_none, pump_step: pump_step_none,
        win_ud: 0, win_opened: win_opened_none, win_hotkey: win_hotkey_none }
}

fn hooks_new(ud: u64, m: *mut theme.Theme, host: *mut fuiwirt.Host,
    attach: fn(u64, *mut painter.Painter), paint: fn(u64, usize, usize),
    key: fn(u64, u32, u32) -> bool, text: fn(u64, u32, u32) -> bool,
    press: fn(u64, f64, f64), act: fn(u64, usize), done: fn(u64) -> bool,
    field: fn(u64, *mut [f64; 4]) -> bool,
    title: str, w: usize, h: usize) -> Hooks {
    return Hooks { ud: ud, m: m as u64, host: host as u64, attach: attach,
        paint: paint, key: key, text: text, press: press, act: act,
        done: done, field: field, title: title, w: w, h: h,
        audit: audit_none, has_audit: false, buf: buf_none,
        edited: edited_none, popups: popups_none, ime_pre: ime_pre_none,
        ime_commit: ime_commit_none, ime_end: ime_end_none, ime_del: ime_del_none, ime_confirm: ime_end_none,
        ime_spot: ime_spot_none, has_pump: false, pump_ud: 0,
        pump_fd: pump_fd_none, pump_ms: pump_ms_none, pump_step: pump_step_none,
        win_ud: 0, win_opened: win_opened_none, win_hotkey: win_hotkey_none }
}

fn hooks_set_audit(h: *mut Hooks, f: fn(u64) -> i32) {
    (*h).audit = f
    (*h).has_audit = true
}

fn hooks_set_buf(h: *mut Hooks, f: fn(u64) -> u64) {
    (*h).buf = f
}

fn hooks_set_edited(h: *mut Hooks, f: fn(u64)) {
    (*h).edited = f
}

fn hooks_set_popups(h: *mut Hooks, f: fn(u64) -> u64) {
    (*h).popups = f
}

// See `Hooks.pump_*`. Call it before `run`; lib/fui/looppump.fi does it for an
// async.loop.
fn hooks_set_pump(h: *mut Hooks, ud: u64, fd: fn(u64) -> i32, ms: fn(u64, i64) -> i64, step: fn(u64) -> bool) {
    (*h).has_pump = true
    (*h).pump_ud = ud
    (*h).pump_fd = fd
    (*h).pump_ms = ms
    (*h).pump_step = step
}

// See `Hooks.win_*`. Call it before `run`.
fn hooks_set_window(h: *mut Hooks, ud: u64, opened: fn(u64, u64), hotkey: fn(u64, u32)) {
    (*h).win_ud = ud
    (*h).win_opened = opened
    (*h).win_hotkey = hotkey
}

fn hooks_set_ime(h: *mut Hooks, pre: fn(u64, u64, usize, usize) -> bool, commit: fn(u64, u64, usize) -> bool, end: fn(u64),
    del: fn(u64, usize, usize) -> bool, confirm: fn(u64), spot: fn(u64, *mut [f64; 3]) -> bool) {
    (*h).ime_pre = pre
    (*h).ime_commit = commit
    (*h).ime_end = end
    (*h).ime_del = del
    (*h).ime_confirm = confirm
    (*h).ime_spot = spot
}

// The keys of the window system -> the keys of a text field (editor.fi).
// 0 = none for it.
fn edit_key(k: u32) -> u32 {
    if k == window.K_LEFT { return editor.KEY_LEFT }
    if k == window.K_RIGHT { return editor.KEY_RIGHT }
    if k == window.K_HOME { return editor.KEY_HOME }
    if k == window.K_END { return editor.KEY_END }
    if k == window.K_BACK { return editor.KEY_BACKSPACE }
    if k == window.K_DELETE { return editor.KEY_DELETE }
    if k == window.K_RETURN { return editor.KEY_ENTER }
    if k == window.K_ESCAPE { return editor.KEY_ESC }
    if k == window.K_TAB { return editor.KEY_TAB }
    if k == window.K_UP { return editor.KEY_UP }
    if k == window.K_DOWN { return editor.KEY_DOWN }
    // PageUp / PageDown (fontdlg, list boxes): a program's key hook sees them now; what it does not
    // use goes on to the host as before
    if k == window.K_PAGEUP { return editor.KEY_PGUP }
    if k == window.K_PAGEDOWN { return editor.KEY_PGDN }
    if k == K_F5 { return 100 as u32 }
    return 0 as u32
}

// fuiwin's input hook. The state bits of lib/window (X11 order: shift 1,
// control 4, alt 8) are editor.fi's bits already.
// A press happened since the loop last looked: a press into the focused text
// field asks for the on-screen keyboard again (the user may have put it away
// with Back while the field kept the focus).
static mut G_PRESSED: bool = false

fn on_input(ud: u64, kind: u32, a: u32, st: u32, x: f64, y: f64) -> bool {
    let h: *mut Hooks = ud as *mut Hooks
    let mods: u32 = st & (editor.MOD_SHIFT | editor.MOD_CTRL | editor.MOD_ALT)
    // r444b: the raw keys, the focus and (Windows) the IME messages go to the input method; the EV_KEY / EV_CHAR that follow a key
    // the input method ate or whose text it already committed into the field are dropped (no double text)
    if kind == window.EV_RAWKEY || kind == window.EV_RAWKEY_UP || kind == window.EV_FOCUS || kind == window.EV_IME {
        if IME_TABLE != 0 {
            let ev: fn(u32, u32, u32, f64, f64) = (*ime_tab()).event
            ev(kind, a, st, x, y)
        }
        return false
    }
    if IME_TABLE != 0 && (kind == window.EV_KEY || kind == window.EV_CHAR) {
        let sw: fn(u32, u32, u32) -> bool = (*ime_tab()).swallow
        if sw(kind, a, st) {
            return true
        }
    }
    if kind == window.EV_HOTKEY {
        (*h).win_hotkey((*h).win_ud, a)
        return true
    }
    if kind == window.EV_KEY {
        let k: u32 = edit_key(a)
        if k == 0 as u32 {
            return false
        }
        return (*h).key((*h).ud, k, mods)
    }
    if kind == window.EV_CHAR {
        if a < 32 as u32 || a == 127 as u32 {
            return false
        }
        return (*h).text((*h).ud, a, mods)
    }
    if kind == window.EV_BUTTON && a == window.BTN_LEFT {
        // a click while pre-edit text stands: the field keeps the text as it is, the input method forgets it
        if IME_TABLE != 0 {
            let on: fn() -> bool = (*ime_tab()).on
            if on() {
                (*h).ime_confirm((*h).ud)
                let rs: fn() = (*ime_tab()).reset
                rs()
            }
        }
        (*h).press((*h).ud, x, y)
        G_PRESSED = true
    }
    return false
}

fn on_paint(ud: u64, fx: *mut fuiwin.Window) {
    let h: *mut Hooks = ud as *mut Hooks
    (*h).paint((*h).ud, fuiwin.window_w(fx), fuiwin.window_h(fx))
}

fn on_act(ud: u64, fx: *mut fuiwin.Window, node: usize) {
    let h: *mut Hooks = ud as *mut Hooks
    (*h).act((*h).ud, node)
}

fn say(s: str) {
    rt.write_everything(2, s.p as u64, s.n)
}

// `#[allow_escape]`: the menu windows' host keeps the address of the window `fx`
// (it lives as long as `run`).
#[allow_escape]
fn run(h: *mut Hooks) -> i32 {
    if (*h).has_audit && envvar.env_has("FUI_AUDIT") {
        let f: fn(u64) -> i32 = (*h).audit
        return f((*h).ud)
    }
    let fs: *mut metrics.FontSet =
    rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    if fs as u64 == 0 || !sysfont.sysfont_load_ui(fs) {
        say("fui.app: no font found (DejaVu Sans, fonts-dejavu-core)\n")
        return 9
    }
    let m: *mut theme.Theme = (*h).m as *mut theme.Theme
    let w: *mut fuiwirt.Host = (*h).host as *mut fuiwirt.Host
    var fx: fuiwin.Window = fuiwin.window_new()
    fuiwin.window_set_font(&fx, fs as u64)
    fuiwin.window_set_escape_closes(&fx, false)
    fuiwin.window_set_input_hook(&fx, h as u64, on_input)
    (*h).attach((*h).ud, fuiwin.window_painter(&fx))
    let t: str = (*h).title
    if !fuiwin.window_open(&fx, w, m, 0, (*h).w, (*h).h, t.p as u64, t.n) {
        say("fui.app: no X server reachable ($DISPLAY)\n")
        return 1
    }
    // a router (app.on) sees the mouse as pointer 1; a back end with real
    // pointers would send every finger (Android fingers; X11 XInput2 touch)
    let real: bool = fuiwin.window_use_pointers(&fx, w)
    let f: *mut window.Window = fuiwin.window_window(&fx)
    (*h).win_opened((*h).win_ud, f as u64)
    if window.theme_known(f) {
        theme.theme_set_dark(m, window.dark(f))
        fuiwirt.host_touch(w)
    }
    // r444b: text input through the platform input method (XIM / IMM32). false (no libX11, no XIM, FUI_NO_IME set) = the window
    // keeps sending plain EV_CHAR and everything works as before.
    var ime_up: bool = false
    if IME_TABLE != 0 && !envvar.env_has("FUI_NO_IME") {
        let op: fn(*mut window.Window) -> bool = (*ime_tab()).open
        if op(f) {
            let ss: fn(u64, fn(u64, u64, usize, usize) -> bool, fn(u64, u64, usize) -> bool, fn(u64), fn(u64, usize, usize) -> bool) = (*ime_tab()).set_sink
            ss((*h).ud, (*h).ime_pre, (*h).ime_commit, (*h).ime_end, (*h).ime_del)
            ime_up = true
        }
    }
    var imebuf: u64 = 0
    var spot_x: f64 = 0.0 - 1.0
    var spot_y: f64 = 0.0 - 1.0
    var spot_h: f64 = 0.0
    var open: bool = true
    // r168: the windows of a menu (see lib/plat/fuipopup.fi)
    let ph: *mut fuipopup.PopupHost = fuipopup.ph_new()
    // r114: the on-screen keyboard follows the focused text field and types
    // into its buffer (Android; a desktop back end answers false / 0 and
    // nothing happens)
    var kbuf: u64 = 0
    while open && !(*h).done((*h).ud) {
        var ms: i64 = fuiwirt.host_wait_ms(w)
        var pump_fd: i32 = 0 - 1
        if (*h).has_pump {
            // timers of the pump bound the sleep; its descriptor wakes it
            ms = (*h).pump_ms((*h).pump_ud, ms)
            pump_fd = (*h).pump_fd((*h).pump_ud)
        }
        if ms != 0 {
            var xfd: i32 = 0 - 1
            if ime_up {
                let fdf: fn() -> i32 = (*ime_tab()).fd
                xfd = fdf()
            }
            if pump_fd >= 0 {
                if xfd < 0 {
                    xfd = pump_fd
                } else if ms < 0 || ms > 10 {
                    // the window wait watches ONE extra descriptor and the IME has it: look at the pump every 10 ms
                    ms = 10
                }
            }
            if ph as u64 != 0 {
                // the XIM connection is watched too: an IME (ibus ...) commits on it by itself
                let got: bool = fuipopup.ph_wait_fd(ph, f, ms, xfd)
            } else if xfd >= 0 {
                let wins: [u64; 8] = [f as u64, 0, 0, 0, 0, 0, 0, 0]
                let hit: i64 = window.wait_any_fd(&wins, 1, xfd, ms)
            } else {
                let e: bool = window.wait_event(f, ms)
            }
        }
        if (*h).has_pump {
            // network, timers, posted results: on this thread, between two window turns
            if (*h).pump_step((*h).pump_ud) {
                fuiwirt.host_touch(w)
            }
        }
        if ime_up {
            let pf: fn() = (*ime_tab()).pump
            pf()
        }
        open = fuiwin.window_step(&fx, w, m, on_paint, on_act, h as u64)
        if ph as u64 != 0 {
            let mvp: u64 = (*h).popups((*h).ud)
            if mvp != 0 {
                if !fuipopup.ph_bound(ph) {
                    fuipopup.ph_bind(ph, mvp as *mut menuview.MenuView, &fx, w, m, fs as u64)
                }
                fuipopup.ph_step(ph)
            }
        }
        let tb: u64 = (*h).buf((*h).ud)
        if ime_up {
            // another field got the focus (Tab, a program call): the pre-edit text of the old one is over
            if tb != imebuf {
                if imebuf != 0 as u64 {
                    (*h).ime_confirm((*h).ud)
                    let rs2: fn() = (*ime_tab()).reset
                    rs2()
                }
                imebuf = tb
                spot_x = 0.0 - 1.0
            }
            if tb != 0 as u64 {
                var sp: [f64; 3] = [0.0; 3]
                if (*h).ime_spot((*h).ud, &sp) && (sp[0] != spot_x || sp[1] != spot_y || sp[2] != spot_h) {
                    spot_x = sp[0]
                    spot_y = sp[1]
                    spot_h = sp[2]
                    let sp2: fn(f64, f64, f64) = (*ime_tab()).spot
                    sp2(spot_x, spot_y, spot_h)
                }
            }
        }
        let pressed: bool = G_PRESSED
        G_PRESSED = false
        if tb != 0 as u64 {
            if tb != kbuf || pressed {
                kbuf = tb
                let secret: bool = textbuf.tb_secret(tb as *mut textbuf.TextBuf)
                let up: bool = window.text_input(f, true, secret, tb)
            }
            let got: u32 = window.text_sync(f, tb)
            if (got & window.TI_CHANGED) != 0 as u32 {
                (*h).edited((*h).ud)
                fuiwirt.host_touch(w)
            }
            if (got & window.TI_ENTER) != 0 as u32 {
                let used: bool = (*h).key((*h).ud, editor.KEY_ENTER, 0 as u32)
                fuiwirt.host_touch(w)
            }
        } else if kbuf != 0 as u64 {
            kbuf = 0
            let down: bool = window.text_input(f, false, false, 0 as u64)
        }
    }
    if kbuf != 0 as u64 {
        let down2: bool = window.text_input(f, false, false, 0 as u64)
    }
    if ime_up {
        let cl: fn() = (*ime_tab()).close
        cl()
    }
    fuiwin.window_close(&fx)
    return 0
}
