// SPDX-License-Identifier: MPL-2.0
import term.vtparse
import term.termgrid
import term.termstate

export { apply_sgr }

const SGR_RESET: i32 = 0
const SGR_EXTENDED_FG: i32 = 38
const SGR_EXTENDED_BG: i32 = 48
const EXT_INDEXED: i32 = 5
const EXT_RGB: i32 = 2
const BRIGHT_BASE: u32 = 8

fn set_color(g: *mut termgrid.Grid, is_fg: bool, c: u32) {
    if is_fg { (*g).fg = c } else { (*g).bg = c }
}

fn clamp_byte(v: i32) -> u32 {
    if v < 0 as i32 { return 0 as u32 }
    if v > 255 as i32 { return 255 as u32 }
    return v as u32
}

fn extended_color(p: *mut vtparse.Parser, g: *mut termgrid.Grid, i: usize, is_fg: bool) -> usize {
    let mode: i32 = vtparse.param(p, i + 1, -1 as i32)
    if mode == EXT_INDEXED {
        let idx: i32 = vtparse.param(p, i + 2, 0 as i32)
        set_color(g, is_fg, termgrid.color_indexed(clamp_byte(idx)))
        return i + 2
    }
    if mode == EXT_RGB {
        var first: usize = i + 2
        if vtparse.param_colon(p, i + 1) && (*p).np >= i + 6 { first = i + 3 }
        let r: u32 = clamp_byte(vtparse.param(p, first, 0 as i32))
        let gr: u32 = clamp_byte(vtparse.param(p, first + 1, 0 as i32))
        let b: u32 = clamp_byte(vtparse.param(p, first + 2, 0 as i32))
        set_color(g, is_fg, termgrid.color_rgb((r << 16) | (gr << 8) | b))
        return first + 2
    }
    return i
}

fn set_flag(g: *mut termgrid.Grid, f: u32, on: bool) {
    if on { (*g).flags = (*g).flags | f } else { (*g).flags = (*g).flags & (f ^ 0xFFFFFFFF) }
}

fn simple_attr(g: *mut termgrid.Grid, v: i32) -> bool {
    if v == 1 as i32 { set_flag(g, termgrid.F_BOLD, true) }
    else if v == 2 as i32 { set_flag(g, termgrid.F_DIM, true) }
    else if v == 3 as i32 { set_flag(g, termgrid.F_ITALIC, true) }
    else if v == 7 as i32 { set_flag(g, termgrid.F_INVERSE, true) }
    else if v == 8 as i32 { set_flag(g, termgrid.F_HIDDEN, true) }
    else if v == 9 as i32 { set_flag(g, termgrid.F_STRIKE, true) }
    else if v == 21 as i32 { set_flag(g, termgrid.F_UNDERLINE, true) }
    else if v == 22 as i32 { set_flag(g, termgrid.F_BOLD | termgrid.F_DIM, false) }
    else if v == 23 as i32 { set_flag(g, termgrid.F_ITALIC, false) }
    else if v == 24 as i32 { set_flag(g, termgrid.F_UNDERLINE, false) }
    else if v == 27 as i32 { set_flag(g, termgrid.F_INVERSE, false) }
    else if v == 28 as i32 { set_flag(g, termgrid.F_HIDDEN, false) }
    else if v == 29 as i32 { set_flag(g, termgrid.F_STRIKE, false) }
    else { return false }
    return true
}

fn palette_attr(g: *mut termgrid.Grid, v: i32) -> bool {
    if v >= 30 as i32 && v <= 37 as i32 { (*g).fg = termgrid.color_indexed((v - 30 as i32) as u32) }
    else if v == 39 as i32 { (*g).fg = 0 as u32 }
    else if v >= 40 as i32 && v <= 47 as i32 { (*g).bg = termgrid.color_indexed((v - 40 as i32) as u32) }
    else if v == 49 as i32 { (*g).bg = 0 as u32 }
    else if v >= 90 as i32 && v <= 97 as i32 { (*g).fg = termgrid.color_indexed((v - 90 as i32) as u32 + BRIGHT_BASE) }
    else if v >= 100 as i32 && v <= 107 as i32 { (*g).bg = termgrid.color_indexed((v - 100 as i32) as u32 + BRIGHT_BASE) }
    else { return false }
    return true
}

fn reset_pen(g: *mut termgrid.Grid) {
    (*g).fg = 0 as u32
    (*g).bg = 0 as u32
    (*g).flags = 0 as u32
}

fn underline_style(p: *mut vtparse.Parser, g: *mut termgrid.Grid, i: usize) -> usize {
    if vtparse.param_colon(p, i) {
        let style: i32 = vtparse.param(p, i + 1, 0 as i32)
        set_flag(g, termgrid.F_UNDERLINE, style != 0 as i32)
        return i + 2
    }
    set_flag(g, termgrid.F_UNDERLINE, true)
    return i + 1
}

fn apply_sgr(t: *mut termstate.Term) {
    let p: *mut vtparse.Parser = &(*t).parser
    let g: *mut termgrid.Grid = termstate.cur(t)
    if (*p).np == 0 {
        reset_pen(g)
        return
    }
    var i: usize = 0
    while i < (*p).np {
        let v: i32 = vtparse.param(p, i, 0 as i32)
        if v == SGR_RESET {
            reset_pen(g)
            i = i + 1
        } else if v == 4 as i32 {
            i = underline_style(p, g, i)
        } else if v == SGR_EXTENDED_FG {
            i = extended_color(p, g, i, true) + 1
        } else if v == SGR_EXTENDED_BG {
            i = extended_color(p, g, i, false) + 1
        } else {
            if !simple_attr(g, v) { palette_attr(g, v) }
            i = i + 1
        }
    }
}
