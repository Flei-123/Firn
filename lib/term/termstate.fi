import std.rt
import term.vtparse
import term.termgrid

export {
    Term, term_alloc, term_release, cur, reply_str, reply_num, reply_clear,
    TITLE_MAX, MOUSE_OFF, MOUSE_PRESS, MOUSE_DRAG, MOUSE_ANY, SCROLLBACK_MAX, SCROLLBACK_DEFAULT,
}

const TITLE_MAX: usize = 255
const TERM_BYTES: usize = 8192
const MOUSE_OFF: u32 = 0
const MOUSE_PRESS: u32 = 1000
const MOUSE_DRAG: u32 = 1002
const MOUSE_ANY: u32 = 1003
const SCROLLBACK_MAX: usize = 100000
const SCROLLBACK_DEFAULT: usize = 2000

struct Term {
    parser: vtparse.Parser,
    main: termgrid.Grid,
    alt: termgrid.Grid,
    use_alt: bool,
    app_cursor: bool,
    app_keypad: bool,
    bracketed: bool,
    cursor_visible: bool,
    focus_report: bool,
    mouse_mode: u32,
    mouse_sgr: bool,
    g0_acs: bool,
    g1_acs: bool,
    shifted: bool,
    last_cp: u32,
    title: [u8; 256],
    title_len: usize,
    title_gen: u64,
    bell: u64,
    reply: rt.Buf,
}

fn term_alloc(cols: usize, rows: usize, sb: usize) -> *mut Term {
    let t: *mut Term = rt.heap_alloc(TERM_BYTES) as *mut Term
    var keep: usize = sb
    if keep > SCROLLBACK_MAX { keep = SCROLLBACK_MAX }
    (*t).parser = vtparse.parser_new()
    (*t).main = termgrid.grid_new(cols, rows, keep)
    (*t).alt = termgrid.grid_new(cols, rows, 0)
    (*t).cursor_visible = true
    (*t).reply = rt.buf_new()
    return t
}

fn term_release(t: *mut Term) {
    termgrid.grid_free(&(*t).main)
    termgrid.grid_free(&(*t).alt)
    rt.buf_free(&(*t).reply)
    rt.heap_free(t as u64, TERM_BYTES)
}

fn cur(t: *mut Term) -> *mut termgrid.Grid {
    if (*t).use_alt { return &(*t).alt }
    return &(*t).main
}

fn reply_str(t: *mut Term, s: str) {
    rt.buf_push_bytes(&(*t).reply, s.p as u64, s.n)
}

fn reply_num(t: *mut Term, v: i64) {
    rt.buf_push_dec_i64(&(*t).reply, v)
}

fn reply_clear(t: *mut Term) {
    rt.buf_clear(&(*t).reply)
}
