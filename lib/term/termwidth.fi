// SPDX-License-Identifier: MPL-2.0
export { width, is_wide_cp }

fn is_combining(cp: u32) -> bool {
    if cp >= 0x300 && cp <= 0x36F { return true }
    if cp >= 0x200B && cp <= 0x200F { return true }
    if cp >= 0xFE00 && cp <= 0xFE0F { return true }
    if cp >= 0x20D0 && cp <= 0x20FF { return true }
    return cp == 0xFEFF
}

fn is_wide_cp(cp: u32) -> bool {
    if cp < 0x1100 { return false }
    if cp <= 0x115F { return true }
    if cp >= 0x2E80 && cp <= 0xA4CF { return cp != 0x303F }
    if cp >= 0xAC00 && cp <= 0xD7A3 { return true }
    if cp >= 0xF900 && cp <= 0xFAFF { return true }
    if cp >= 0xFE30 && cp <= 0xFE6F { return true }
    if cp >= 0xFF00 && cp <= 0xFF60 { return true }
    if cp >= 0xFFE0 && cp <= 0xFFE6 { return true }
    if cp >= 0x1F300 && cp <= 0x1F64F { return true }
    if cp >= 0x1F900 && cp <= 0x1F9FF { return true }
    return cp >= 0x20000 && cp <= 0x3FFFD
}

fn width(cp: u32) -> u32 {
    if cp == 0 { return 1 as u32 }
    if cp < 32 || (cp >= 0x7F && cp < 0xA0) { return 0 as u32 }
    if is_combining(cp) { return 0 as u32 }
    if is_wide_cp(cp) { return 2 as u32 }
    return 1 as u32
}
