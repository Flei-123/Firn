// SPDX-License-Identifier: MPL-2.0
import std.rt
import term.termgrid

export { push_cp, line_text, range_text, screen_text }

const NEWLINE: u8 = 10 as u8
const SPACE: u8 = 32 as u8

fn push_cp(b: *mut rt.Buf, cp: u32) {
    if cp < 0x80 {
        rt.buf_push(b, cp as u8)
    } else if cp < 0x800 {
        rt.buf_push(b, (0xC0 | (cp >> 6)) as u8)
        rt.buf_push(b, (0x80 | (cp & 0x3F)) as u8)
    } else if cp < 0x10000 {
        rt.buf_push(b, (0xE0 | (cp >> 12)) as u8)
        rt.buf_push(b, (0x80 | ((cp >> 6) & 0x3F)) as u8)
        rt.buf_push(b, (0x80 | (cp & 0x3F)) as u8)
    } else {
        rt.buf_push(b, (0xF0 | (cp >> 18)) as u8)
        rt.buf_push(b, (0x80 | ((cp >> 12) & 0x3F)) as u8)
        rt.buf_push(b, (0x80 | ((cp >> 6) & 0x3F)) as u8)
        rt.buf_push(b, (0x80 | (cp & 0x3F)) as u8)
    }
}

fn last_used(g: *mut termgrid.Grid, line: usize, x0: usize, x1: usize) -> usize {
    var e: usize = x1
    while e > x0 && termgrid.cell_cp(g, line, e - 1) == 0 as u32 && (termgrid.cell_flags(g, line, e - 1) & termgrid.F_TAIL) == 0 as u32 {
        e = e - 1
    }
    return e
}

fn line_text(g: *mut termgrid.Grid, line: usize, x0: usize, x1: usize, out: *mut rt.Buf) {
    var e: usize = x1
    if e > (*g).cols { e = (*g).cols }
    e = last_used(g, line, x0, e)
    var x: usize = x0
    while x < e {
        let f: u32 = termgrid.cell_flags(g, line, x)
        if (f & termgrid.F_TAIL) == 0 as u32 {
            let cp: u32 = termgrid.cell_cp(g, line, x)
            if cp == 0 as u32 { rt.buf_push(out, SPACE) } else { push_cp(out, cp) }
        }
        x = x + 1
    }
}

fn range_text(g: *mut termgrid.Grid, l0: usize, x0: usize, l1: usize, x1: usize, out: *mut rt.Buf) {
    var line: usize = l0
    while line <= l1 {
        var from: usize = 0
        var to: usize = (*g).cols
        if line == l0 { from = x0 }
        if line == l1 { to = x1 }
        line_text(g, line, from, to, out)
        if line < l1 && !termgrid.row_wrapped(g, line) { rt.buf_push(out, NEWLINE) }
        line = line + 1
    }
}

fn screen_text(g: *mut termgrid.Grid, out: *mut rt.Buf) {
    let first: usize = (*g).sb_len
    range_text(g, first, 0, first + (*g).rows - 1, (*g).cols, out)
}
