// SPDX-License-Identifier: MPL-2.0
import std.rt
import term.termgrid

export {
    erase_cells, erase_line, erase_display, erase_chars,
    insert_chars, delete_chars, insert_lines, delete_lines,
    scroll_up, scroll_down, scroll_region_up, scroll_region_down,
}

fn blank_cell(g: *mut termgrid.Grid, phys: usize, x: usize) {
    termgrid.set_cell(g, phys, x, 0 as u32, 0 as u32, (*g).bg, 0 as u32)
}

fn fix_wide_edges(g: *mut termgrid.Grid, phys: usize, x0: usize, x1: usize) {
    if x0 > 0 && (termgrid.get_flags(g, phys, x0) & termgrid.F_TAIL) != 0 as u32 {
        blank_cell(g, phys, x0 - 1)
    }
    if x1 < (*g).cols && (termgrid.get_flags(g, phys, x1) & termgrid.F_TAIL) != 0 as u32 {
        blank_cell(g, phys, x1)
    }
}

fn erase_cells(g: *mut termgrid.Grid, y: usize, x0: usize, x1: usize) {
    var e: usize = x1
    if e > (*g).cols { e = (*g).cols }
    if x0 >= e { return }
    let phys: usize = termgrid.phys_row(g, y)
    fix_wide_edges(g, phys, x0, e)
    var x: usize = x0
    while x < e {
        blank_cell(g, phys, x)
        x = x + 1
    }
    if e == (*g).cols { rt.st8((*g).wrap, phys, 0 as u8) }
    termgrid.touch(g)
}

fn erase_line(g: *mut termgrid.Grid, mode: i32) {
    if mode == 0 as i32 { erase_cells(g, (*g).cy, (*g).cx, (*g).cols) }
    else if mode == 1 as i32 { erase_cells(g, (*g).cy, 0, (*g).cx + 1) }
    else { erase_cells(g, (*g).cy, 0, (*g).cols) }
}

fn erase_rows(g: *mut termgrid.Grid, y0: usize, y1: usize) {
    var y: usize = y0
    while y < y1 {
        erase_cells(g, y, 0, (*g).cols)
        y = y + 1
    }
}

fn erase_display(g: *mut termgrid.Grid, mode: i32) {
    if mode == 0 as i32 {
        erase_line(g, 0 as i32)
        erase_rows(g, (*g).cy + 1, (*g).rows)
    } else if mode == 1 as i32 {
        erase_rows(g, 0, (*g).cy)
        erase_line(g, 1 as i32)
    } else if mode == 2 as i32 {
        erase_rows(g, 0, (*g).rows)
    } else if mode == 3 as i32 {
        (*g).sb_len = 0
        termgrid.touch(g)
    }
}

fn erase_chars(g: *mut termgrid.Grid, n: usize) {
    erase_cells(g, (*g).cy, (*g).cx, (*g).cx + n)
}

fn move_cell(g: *mut termgrid.Grid, phys: usize, from: usize, to: usize) {
    let a: usize = termgrid.cell_ix(g, phys, from)
    let b: usize = termgrid.cell_ix(g, phys, to)
    var k: usize = 0
    while k < 4 {
        rt.st32((*g).data, b + k, rt.ld32((*g).data, a + k))
        k = k + 1
    }
}

fn delete_chars(g: *mut termgrid.Grid, n: usize) {
    var k: usize = n
    if k > (*g).cols - (*g).cx { k = (*g).cols - (*g).cx }
    if k == 0 { return }
    let phys: usize = termgrid.phys_row(g, (*g).cy)
    fix_wide_edges(g, phys, (*g).cx, (*g).cx + k)
    var x: usize = (*g).cx
    while x + k < (*g).cols {
        move_cell(g, phys, x + k, x)
        x = x + 1
    }
    while x < (*g).cols {
        blank_cell(g, phys, x)
        x = x + 1
    }
    termgrid.touch(g)
}

fn insert_chars(g: *mut termgrid.Grid, n: usize) {
    var k: usize = n
    if k > (*g).cols - (*g).cx { k = (*g).cols - (*g).cx }
    if k == 0 { return }
    let phys: usize = termgrid.phys_row(g, (*g).cy)
    fix_wide_edges(g, phys, (*g).cx, (*g).cx)
    var x: usize = (*g).cols - 1
    while x >= (*g).cx + k {
        move_cell(g, phys, x - k, x)
        x = x - 1
    }
    var j: usize = (*g).cx
    while j < (*g).cx + k {
        blank_cell(g, phys, j)
        j = j + 1
    }
    termgrid.touch(g)
}

fn copy_screen_row(g: *mut termgrid.Grid, from: usize, to: usize) {
    let sp: usize = termgrid.phys_row(g, from)
    let dp: usize = termgrid.phys_row(g, to)
    termgrid.copy_row_cells((*g).data, sp, (*g).cols, (*g).data, dp, (*g).cols)
    rt.st8((*g).wrap, dp, rt.ld8((*g).wrap, sp))
}

fn ring_advance(g: *mut termgrid.Grid, k: usize) {
    var i: usize = 0
    while i < k {
        (*g).head = ((*g).head + 1) % (*g).cap
        if (*g).sb_len < (*g).sb_max { (*g).sb_len = (*g).sb_len + 1 }
        termgrid.blank_row(g, termgrid.phys_row(g, (*g).rows - 1))
        i = i + 1
    }
}

fn scroll_region_up(g: *mut termgrid.Grid, top: usize, bot: usize, n: usize, history: bool) {
    var k: usize = n
    if k > bot - top + 1 { k = bot - top + 1 }
    if k == 0 { return }
    if history && top == 0 && bot == (*g).rows - 1 {
        ring_advance(g, k)
        termgrid.touch(g)
        return
    }
    var y: usize = top
    while y + k <= bot {
        copy_screen_row(g, y + k, y)
        y = y + 1
    }
    while y <= bot {
        termgrid.blank_row(g, termgrid.phys_row(g, y))
        y = y + 1
    }
    termgrid.touch(g)
}

fn scroll_region_down(g: *mut termgrid.Grid, top: usize, bot: usize, n: usize) {
    var k: usize = n
    if k > bot - top + 1 { k = bot - top + 1 }
    if k == 0 { return }
    var y: usize = bot
    while y >= top + k {
        copy_screen_row(g, y - k, y)
        y = y - 1
    }
    var j: usize = top
    while j < top + k {
        termgrid.blank_row(g, termgrid.phys_row(g, j))
        j = j + 1
    }
    termgrid.touch(g)
}

fn scroll_up(g: *mut termgrid.Grid, n: usize) {
    scroll_region_up(g, (*g).top, (*g).bot, n, true)
}

fn scroll_down(g: *mut termgrid.Grid, n: usize) {
    scroll_region_down(g, (*g).top, (*g).bot, n)
}

fn insert_lines(g: *mut termgrid.Grid, n: usize) {
    if (*g).cy < (*g).top || (*g).cy > (*g).bot { return }
    scroll_region_down(g, (*g).cy, (*g).bot, n)
    (*g).cx = 0
    (*g).pending = false
}

fn delete_lines(g: *mut termgrid.Grid, n: usize) {
    if (*g).cy < (*g).top || (*g).cy > (*g).bot { return }
    scroll_region_up(g, (*g).cy, (*g).bot, n, false)
    (*g).cx = 0
    (*g).pending = false
}
