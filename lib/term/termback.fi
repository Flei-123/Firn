export {
    Backend, backend_none, back_read, back_write, back_resize, back_alive, back_fd, back_close,
}

struct Backend {
    ud: u64,
    read: fn(u64, u64, usize) -> i64,
    write: fn(u64, u64, usize) -> bool,
    resize: fn(u64, usize, usize) -> bool,
    alive: fn(u64) -> bool,
    fd: fn(u64) -> i32,
    close: fn(u64),
}

fn none_read(ud: u64, buf: u64, cap: usize) -> i64 { return 0 - 1 }
fn none_write(ud: u64, buf: u64, n: usize) -> bool { return false }
fn none_resize(ud: u64, cols: usize, rows: usize) -> bool { return false }
fn none_alive(ud: u64) -> bool { return false }
fn none_fd(ud: u64) -> i32 { return 0 - 1 }
fn none_close(ud: u64) {}

fn backend_none() -> Backend {
    return Backend { ud: 0 as u64, read: none_read, write: none_write, resize: none_resize,
        alive: none_alive, fd: none_fd, close: none_close }
}

fn back_read(b: *mut Backend, buf: u64, cap: usize) -> i64 {
    let f: fn(u64, u64, usize) -> i64 = (*b).read
    return f((*b).ud, buf, cap)
}

fn back_write(b: *mut Backend, buf: u64, n: usize) -> bool {
    let f: fn(u64, u64, usize) -> bool = (*b).write
    return f((*b).ud, buf, n)
}

fn back_resize(b: *mut Backend, cols: usize, rows: usize) -> bool {
    let f: fn(u64, usize, usize) -> bool = (*b).resize
    return f((*b).ud, cols, rows)
}

fn back_alive(b: *mut Backend) -> bool {
    let f: fn(u64) -> bool = (*b).alive
    return f((*b).ud)
}

fn back_fd(b: *mut Backend) -> i32 {
    let f: fn(u64) -> i32 = (*b).fd
    return f((*b).ud)
}

fn back_close(b: *mut Backend) {
    let f: fn(u64) = (*b).close
    f((*b).ud)
}
