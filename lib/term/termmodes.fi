// SPDX-License-Identifier: MPL-2.0
import term.vtparse
import term.termgrid
import term.termedit
import term.termcursor
import term.termstate

export { apply_private_modes, apply_standard_modes, enter_alt, leave_alt }

const MODE_APP_CURSOR: i32 = 1
const MODE_ORIGIN: i32 = 6
const MODE_AUTOWRAP: i32 = 7
const MODE_CURSOR_VISIBLE: i32 = 25
const MODE_ALT_OLD: i32 = 47
const MODE_ALT_CLEAR: i32 = 1047
const MODE_CURSOR_SAVE: i32 = 1048
const MODE_ALT_FULL: i32 = 1049
const MODE_MOUSE_PRESS: i32 = 1000
const MODE_MOUSE_DRAG: i32 = 1002
const MODE_MOUSE_ANY: i32 = 1003
const MODE_FOCUS: i32 = 1004
const MODE_MOUSE_SGR: i32 = 1006
const MODE_BRACKETED: i32 = 2004
const MODE_INSERT: i32 = 4

fn enter_alt(t: *mut termstate.Term, save: bool) {
    if (*t).use_alt { return }
    if save { termcursor.save_cursor(&(*t).main) }
    (*t).use_alt = true
    termgrid.grid_reset(&(*t).alt)
}

fn leave_alt(t: *mut termstate.Term, restore: bool) {
    if !(*t).use_alt { return }
    (*t).use_alt = false
    if restore { termcursor.restore_cursor(&(*t).main) }
    termgrid.touch(&(*t).main)
}

fn set_mouse(t: *mut termstate.Term, mode: u32, on: bool) {
    if on { (*t).mouse_mode = mode }
    else if (*t).mouse_mode == mode { (*t).mouse_mode = termstate.MOUSE_OFF }
}

fn set_alt_mode(t: *mut termstate.Term, m: i32, on: bool) {
    if m == MODE_ALT_FULL {
        if on { enter_alt(t, true) } else { leave_alt(t, true) }
    } else if m == MODE_ALT_CLEAR || m == MODE_ALT_OLD {
        if on { enter_alt(t, false) } else { leave_alt(t, false) }
    } else if m == MODE_CURSOR_SAVE {
        if on { termcursor.save_cursor(termstate.cur(t)) } else { termcursor.restore_cursor(termstate.cur(t)) }
    }
}

fn set_private(t: *mut termstate.Term, m: i32, on: bool) {
    let g: *mut termgrid.Grid = termstate.cur(t)
    if m == MODE_APP_CURSOR { (*t).app_cursor = on }
    else if m == MODE_ORIGIN {
        (*g).origin = on
        termcursor.cursor_to(g, 0, 0)
    }
    else if m == MODE_AUTOWRAP { (*g).autowrap = on }
    else if m == MODE_CURSOR_VISIBLE { (*t).cursor_visible = on }
    else if m == MODE_MOUSE_PRESS { set_mouse(t, termstate.MOUSE_PRESS, on) }
    else if m == MODE_MOUSE_DRAG { set_mouse(t, termstate.MOUSE_DRAG, on) }
    else if m == MODE_MOUSE_ANY { set_mouse(t, termstate.MOUSE_ANY, on) }
    else if m == MODE_FOCUS { (*t).focus_report = on }
    else if m == MODE_MOUSE_SGR { (*t).mouse_sgr = on }
    else if m == MODE_BRACKETED { (*t).bracketed = on }
    else { set_alt_mode(t, m, on) }
    termgrid.touch(g)
}

fn apply_private_modes(t: *mut termstate.Term, on: bool) {
    let p: *mut vtparse.Parser = &(*t).parser
    var i: usize = 0
    while i < (*p).np {
        set_private(t, vtparse.param(p, i, 0 as i32), on)
        i = i + 1
    }
}

fn apply_standard_modes(t: *mut termstate.Term, on: bool) {
    let p: *mut vtparse.Parser = &(*t).parser
    let g: *mut termgrid.Grid = termstate.cur(t)
    var i: usize = 0
    while i < (*p).np {
        if vtparse.param(p, i, 0 as i32) == MODE_INSERT { (*g).insert = on }
        i = i + 1
    }
}
