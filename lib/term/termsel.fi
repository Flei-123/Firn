import std.rt
import term.termgrid
import term.termtext

export {
    Sel, sel_new, sel_clear, sel_begin, sel_drag, sel_contains, sel_text, sel_active,
    SEL_CHAR, SEL_WORD, SEL_LINE,
}

const SEL_CHAR: u32 = 0
const SEL_WORD: u32 = 1
const SEL_LINE: u32 = 2
const KEY_SHIFT: u64 = 65536

struct Sel {
    active: bool,
    mode: u32,
    a_id: u64,
    a_col: usize,
    b_id: u64,
    b_col: usize,
    o_a_id: u64,
    o_a_col: usize,
    o_b_id: u64,
    o_b_col: usize,
}

fn sel_new() -> Sel {
    return Sel {
        active: false, mode: SEL_CHAR, a_id: 0 as u64, a_col: 0, b_id: 0 as u64, b_col: 0,
        o_a_id: 0 as u64, o_a_col: 0, o_b_id: 0 as u64, o_b_col: 0,
    }
}

fn sel_clear(s: *mut Sel) { (*s).active = false }

fn sel_active(s: *mut Sel) -> bool { return (*s).active }

fn id_of(g: *mut termgrid.Grid, line: usize) -> u64 { return line as u64 + (*g).dropped }

fn line_of(g: *mut termgrid.Grid, id: u64) -> usize {
    if id < (*g).dropped { return 0 }
    var l: usize = (id - (*g).dropped) as usize
    let last: usize = termgrid.abs_lines(g) - 1
    if l > last { l = last }
    return l
}

fn key_of(id: u64, col: usize) -> u64 { return id * KEY_SHIFT + col as u64 }

fn is_word_cp(cp: u32) -> bool {
    if cp <= 32 { return false }
    if cp == 34 || cp == 39 || cp == 40 || cp == 41 || cp == 60 || cp == 62 { return false }
    if cp == 91 || cp == 93 || cp == 123 || cp == 125 || cp == 124 || cp == 44 || cp == 59 { return false }
    return true
}

fn head_col(g: *mut termgrid.Grid, line: usize, col: usize) -> usize {
    if col > 0 && (termgrid.cell_flags(g, line, col) & termgrid.F_TAIL) != 0 as u32 { return col - 1 }
    return col
}

fn word_start(g: *mut termgrid.Grid, line: usize, col: usize) -> usize {
    var c: usize = head_col(g, line, col)
    while c > 0 && is_word_cp(termgrid.cell_cp(g, line, c - 1)) { c = c - 1 }
    return c
}

fn word_end(g: *mut termgrid.Grid, line: usize, col: usize) -> usize {
    var c: usize = head_col(g, line, col)
    while c + 1 < (*g).cols && is_word_cp(termgrid.cell_cp(g, line, c + 1)) { c = c + 1 }
    return c
}

fn logical_first(g: *mut termgrid.Grid, line: usize) -> usize {
    var l: usize = line
    while l > 0 && termgrid.row_wrapped(g, l - 1) { l = l - 1 }
    return l
}

fn logical_last(g: *mut termgrid.Grid, line: usize) -> usize {
    var l: usize = line
    while l + 1 < termgrid.abs_lines(g) && termgrid.row_wrapped(g, l) { l = l + 1 }
    return l
}

fn unit_start(g: *mut termgrid.Grid, mode: u32, line: usize, col: usize, out_line: *mut usize) -> usize {
    *out_line = line
    if mode == SEL_WORD {
        if is_word_cp(termgrid.cell_cp(g, line, col)) { return word_start(g, line, col) }
        return col
    }
    if mode == SEL_LINE {
        *out_line = logical_first(g, line)
        return 0
    }
    return head_col(g, line, col)
}

fn unit_end(g: *mut termgrid.Grid, mode: u32, line: usize, col: usize, out_line: *mut usize) -> usize {
    *out_line = line
    if mode == SEL_WORD {
        if is_word_cp(termgrid.cell_cp(g, line, col)) { return word_end(g, line, col) }
        return col
    }
    if mode == SEL_LINE {
        *out_line = logical_last(g, line)
        return (*g).cols - 1
    }
    return col
}

fn store(s: *mut Sel, g: *mut termgrid.Grid, al: usize, ac: usize, bl: usize, bc: usize) {
    (*s).a_id = id_of(g, al)
    (*s).a_col = ac
    (*s).b_id = id_of(g, bl)
    (*s).b_col = bc
}

fn sel_begin(s: *mut Sel, g: *mut termgrid.Grid, line: usize, col: usize, mode: u32) {
    var sl: usize = 0
    var el: usize = 0
    let sc: usize = unit_start(g, mode, line, col, &sl)
    let ec: usize = unit_end(g, mode, line, col, &el)
    (*s).active = true
    (*s).mode = mode
    store(s, g, sl, sc, el, ec)
    (*s).o_a_id = (*s).a_id
    (*s).o_a_col = sc
    (*s).o_b_id = (*s).b_id
    (*s).o_b_col = ec
}

fn sel_drag(s: *mut Sel, g: *mut termgrid.Grid, line: usize, col: usize) {
    if !(*s).active { return }
    var sl: usize = 0
    var el: usize = 0
    let sc: usize = unit_start(g, (*s).mode, line, col, &sl)
    let ec: usize = unit_end(g, (*s).mode, line, col, &el)
    let pos: u64 = key_of(id_of(g, line), col)
    let o_start: u64 = key_of((*s).o_a_id, (*s).o_a_col)
    if pos < o_start {
        store(s, g, sl, sc, line_of(g, (*s).o_b_id), (*s).o_b_col)
    } else {
        store(s, g, line_of(g, (*s).o_a_id), (*s).o_a_col, el, ec)
    }
}

fn first_key(s: *mut Sel) -> u64 {
    let a: u64 = key_of((*s).a_id, (*s).a_col)
    let b: u64 = key_of((*s).b_id, (*s).b_col)
    if a < b { return a }
    return b
}

fn last_key(s: *mut Sel) -> u64 {
    let a: u64 = key_of((*s).a_id, (*s).a_col)
    let b: u64 = key_of((*s).b_id, (*s).b_col)
    if a < b { return b }
    return a
}

fn sel_contains(s: *mut Sel, g: *mut termgrid.Grid, line: usize, col: usize) -> bool {
    if !(*s).active { return false }
    let k: u64 = key_of(id_of(g, line), col)
    return k >= first_key(s) && k <= last_key(s)
}

fn sel_text(s: *mut Sel, g: *mut termgrid.Grid, out: *mut rt.Buf) {
    if !(*s).active { return }
    let f: u64 = first_key(s)
    let l: u64 = last_key(s)
    let id0: u64 = f / KEY_SHIFT
    let id1: u64 = l / KEY_SHIFT
    let c0: usize = (f % KEY_SHIFT) as usize
    let c1: usize = (l % KEY_SHIFT) as usize
    if id1 < (*g).dropped { return }
    termtext.range_text(g, line_of(g, id0), c0, line_of(g, id1), c1 + 1, out)
}
