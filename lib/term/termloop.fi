// SPDX-License-Identifier: MPL-2.0
import std.rt
import term.termback

export {
    Loop, loop_new, loop_free, loop_push, loop_backend, loop_sent_ptr, loop_sent_len, loop_size_cols,
    loop_size_rows, loop_pending,
}

const LOOP_BYTES: usize = 256
const CR: u8 = 13 as u8
const LF: u8 = 10 as u8

struct Loop {
    script: rt.Buf,
    pos: usize,
    sent: rt.Buf,
    echo: bool,
    cols: usize,
    rows: usize,
}

fn loop_new(echo: bool) -> *mut Loop {
    let l: *mut Loop = rt.heap_alloc(LOOP_BYTES) as *mut Loop
    (*l).script = rt.buf_new()
    (*l).sent = rt.buf_new()
    (*l).pos = 0
    (*l).echo = echo
    (*l).cols = 0
    (*l).rows = 0
    return l
}

fn loop_free(l: *mut Loop) {
    rt.buf_free(&(*l).script)
    rt.buf_free(&(*l).sent)
    rt.heap_free(l as u64, LOOP_BYTES)
}

fn loop_push(l: *mut Loop, s: str) { rt.buf_push_bytes(&(*l).script, s.p as u64, s.n) }

fn loop_pending(l: *mut Loop) -> usize { return rt.buf_len(&(*l).script) - (*l).pos }

fn loop_sent_ptr(l: *mut Loop) -> u64 { return rt.buf_ptr(&(*l).sent) }

fn loop_sent_len(l: *mut Loop) -> usize { return rt.buf_len(&(*l).sent) }

fn loop_size_cols(l: *mut Loop) -> usize { return (*l).cols }

fn loop_size_rows(l: *mut Loop) -> usize { return (*l).rows }

fn echo_octet(l: *mut Loop, c: u8) {
    if c == CR {
        rt.buf_push(&(*l).script, CR)
        rt.buf_push(&(*l).script, LF)
    } else if c == 127 as u8 {
        rt.buf_push_bytes(&(*l).script, "\x08 \x08".p as u64, 3)
    } else if c >= 32 as u8 {
        rt.buf_push(&(*l).script, c)
    }
}

fn loop_read(ud: u64, buf: u64, cap: usize) -> i64 {
    let l: *mut Loop = ud as *mut Loop
    var n: usize = loop_pending(l)
    if n > cap { n = cap }
    if n == 0 { return 0 }
    rt.mem_copy(buf, rt.buf_ptr(&(*l).script) + (*l).pos as u64, n)
    (*l).pos = (*l).pos + n
    if (*l).pos == rt.buf_len(&(*l).script) {
        rt.buf_clear(&(*l).script)
        (*l).pos = 0
    }
    return n as i64
}

fn loop_write(ud: u64, buf: u64, n: usize) -> bool {
    let l: *mut Loop = ud as *mut Loop
    rt.buf_push_bytes(&(*l).sent, buf, n)
    if !(*l).echo { return true }
    var i: usize = 0
    while i < n {
        echo_octet(l, rt.ld8(buf, i))
        i = i + 1
    }
    return true
}

fn loop_resize(ud: u64, cols: usize, rows: usize) -> bool {
    let l: *mut Loop = ud as *mut Loop
    (*l).cols = cols
    (*l).rows = rows
    return true
}

fn loop_alive(ud: u64) -> bool { return true }

fn loop_fd(ud: u64) -> i32 { return 0 - 1 }

fn loop_close(ud: u64) {}

fn loop_backend(l: *mut Loop) -> termback.Backend {
    return termback.Backend { ud: l as u64, read: loop_read, write: loop_write, resize: loop_resize,
        alive: loop_alive, fd: loop_fd, close: loop_close }
}
