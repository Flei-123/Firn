import std.rt
import term.pty
import term.termback

export { PtyLink, ptylink_open, ptylink_backend, ptylink_free }

const LINK_BYTES: usize = 64

struct PtyLink {
    p: pty.Pty,
}

fn ptylink_open(argv: str, cols: usize, rows: usize) -> *mut PtyLink {
    let l: *mut PtyLink = rt.heap_alloc(LINK_BYTES) as *mut PtyLink
    if !pty.pty_open(&(*l).p, argv, cols, rows) {
        rt.heap_free(l as u64, LINK_BYTES)
        return 0 as *mut PtyLink
    }
    return l
}

fn link_read(ud: u64, buf: u64, cap: usize) -> i64 {
    return pty.pty_read(&(*(ud as *mut PtyLink)).p, buf, cap)
}

fn link_write(ud: u64, buf: u64, n: usize) -> bool {
    return pty.pty_write(&(*(ud as *mut PtyLink)).p, buf, n)
}

fn link_resize(ud: u64, cols: usize, rows: usize) -> bool {
    return pty.pty_resize(&(*(ud as *mut PtyLink)).p, cols, rows)
}

fn link_alive(ud: u64) -> bool {
    return pty.pty_alive(&(*(ud as *mut PtyLink)).p)
}

fn link_fd(ud: u64) -> i32 {
    return (*(ud as *mut PtyLink)).p.fd as i32
}

fn link_close(ud: u64) {
    pty.pty_close(&(*(ud as *mut PtyLink)).p)
}

fn ptylink_backend(l: *mut PtyLink) -> termback.Backend {
    return termback.Backend { ud: l as u64, read: link_read, write: link_write, resize: link_resize,
        alive: link_alive, fd: link_fd, close: link_close }
}

fn ptylink_free(l: *mut PtyLink) {
    pty.pty_close(&(*l).p)
    rt.heap_free(l as u64, LINK_BYTES)
}
