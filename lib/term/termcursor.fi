// SPDX-License-Identifier: MPL-2.0
import std.rt
import term.termgrid
import term.termedit
import term.termwidth

export {
    put_char, carriage_return, linefeed, reverse_index, backspace,
    tab_forward, tab_back, set_tab, clear_tab,
    cursor_to, cursor_col, cursor_row, move_up, move_down, move_left, move_right,
    set_region, save_cursor, restore_cursor,
}

fn carriage_return(g: *mut termgrid.Grid) {
    (*g).cx = 0
    (*g).pending = false
}

fn linefeed(g: *mut termgrid.Grid) {
    (*g).pending = false
    if (*g).cy == (*g).bot {
        termedit.scroll_up(g, 1)
    } else if (*g).cy + 1 < (*g).rows {
        (*g).cy = (*g).cy + 1
    }
}

fn reverse_index(g: *mut termgrid.Grid) {
    (*g).pending = false
    if (*g).cy == (*g).top {
        termedit.scroll_down(g, 1)
    } else if (*g).cy > 0 {
        (*g).cy = (*g).cy - 1
    }
}

fn backspace(g: *mut termgrid.Grid) {
    if (*g).cx > 0 { (*g).cx = (*g).cx - 1 }
    (*g).pending = false
}

fn wrap_line(g: *mut termgrid.Grid) {
    rt.st8((*g).wrap, termgrid.phys_row(g, (*g).cy), 1 as u8)
    (*g).cx = 0
    linefeed(g)
}

fn shift_right_for_insert(g: *mut termgrid.Grid, w: usize) {
    if (*g).insert { termedit.insert_chars(g, w) }
}

fn clear_wide_overlap(g: *mut termgrid.Grid, phys: usize, x: usize, w: usize) {
    let f: u32 = termgrid.get_flags(g, phys, x)
    if (f & termgrid.F_TAIL) != 0 as u32 && x > 0 {
        termgrid.set_cell(g, phys, x - 1, 0 as u32, 0 as u32, (*g).bg, 0 as u32)
    }
    if (f & termgrid.F_WIDE) != 0 as u32 && x + 1 < (*g).cols {
        termgrid.set_cell(g, phys, x + 1, 0 as u32, 0 as u32, (*g).bg, 0 as u32)
    }
    if w == 2 && x + 1 < (*g).cols {
        let f2: u32 = termgrid.get_flags(g, phys, x + 1)
        if (f2 & termgrid.F_WIDE) != 0 as u32 && x + 2 < (*g).cols {
            termgrid.set_cell(g, phys, x + 2, 0 as u32, 0 as u32, (*g).bg, 0 as u32)
        }
    }
}

fn write_cells(g: *mut termgrid.Grid, cp: u32, w: usize) {
    let phys: usize = termgrid.phys_row(g, (*g).cy)
    clear_wide_overlap(g, phys, (*g).cx, w)
    var fl: u32 = (*g).flags
    if w == 2 { fl = fl | termgrid.F_WIDE }
    termgrid.set_cell(g, phys, (*g).cx, cp, (*g).fg, (*g).bg, fl)
    if w == 2 {
        termgrid.set_cell(g, phys, (*g).cx + 1, 0 as u32, (*g).fg, (*g).bg, (*g).flags | termgrid.F_TAIL)
    }
}

fn put_char(g: *mut termgrid.Grid, cp: u32) {
    let w: usize = termwidth.width(cp) as usize
    if w == 0 { return }
    if (*g).pending && (*g).autowrap { wrap_line(g) }
    (*g).pending = false
    if w == 2 && (*g).cx + 1 >= (*g).cols {
        if (*g).cols < 2 { return }
        if (*g).autowrap { wrap_line(g) } else { (*g).cx = (*g).cols - 2 }
    }
    shift_right_for_insert(g, w)
    write_cells(g, cp, w)
    if (*g).cx + w >= (*g).cols {
        (*g).cx = (*g).cols - 1
        (*g).pending = true
    } else {
        (*g).cx = (*g).cx + w
    }
    termgrid.touch(g)
}

fn is_tab_stop(g: *mut termgrid.Grid, x: usize) -> bool {
    return rt.ld8((*g).tabs, x) != 0 as u8
}

fn tab_forward(g: *mut termgrid.Grid, n: usize) {
    var left: usize = n
    while left > 0 {
        var x: usize = (*g).cx + 1
        while x < (*g).cols - 1 && !is_tab_stop(g, x) { x = x + 1 }
        if x > (*g).cols - 1 { x = (*g).cols - 1 }
        (*g).cx = x
        left = left - 1
    }
    (*g).pending = false
}

fn tab_back(g: *mut termgrid.Grid, n: usize) {
    var left: usize = n
    while left > 0 {
        var x: usize = (*g).cx
        if x > 0 { x = x - 1 }
        while x > 0 && !is_tab_stop(g, x) { x = x - 1 }
        (*g).cx = x
        left = left - 1
    }
    (*g).pending = false
}

fn set_tab(g: *mut termgrid.Grid) { rt.st8((*g).tabs, (*g).cx, 1 as u8) }

fn clear_tab(g: *mut termgrid.Grid, all: bool) {
    if all {
        rt.mem_set((*g).tabs, 0 as u8, (*g).cols)
    } else {
        rt.st8((*g).tabs, (*g).cx, 0 as u8)
    }
}

fn cursor_col(g: *mut termgrid.Grid, x: usize) {
    var c: usize = x
    if c >= (*g).cols { c = (*g).cols - 1 }
    (*g).cx = c
    (*g).pending = false
}

fn cursor_row(g: *mut termgrid.Grid, y: usize) {
    var r: usize = y
    var lo: usize = 0
    var hi: usize = (*g).rows - 1
    if (*g).origin {
        r = y + (*g).top
        lo = (*g).top
        hi = (*g).bot
    }
    if r < lo { r = lo }
    if r > hi { r = hi }
    (*g).cy = r
    (*g).pending = false
}

fn cursor_to(g: *mut termgrid.Grid, y: usize, x: usize) {
    cursor_row(g, y)
    cursor_col(g, x)
}

fn move_up(g: *mut termgrid.Grid, n: usize) {
    var lim: usize = 0
    if (*g).cy >= (*g).top { lim = (*g).top }
    var t: usize = (*g).cy
    if n >= t - lim { t = lim } else { t = t - n }
    (*g).cy = t
    (*g).pending = false
}

fn move_down(g: *mut termgrid.Grid, n: usize) {
    var lim: usize = (*g).rows - 1
    if (*g).cy <= (*g).bot { lim = (*g).bot }
    var t: usize = (*g).cy + n
    if t > lim { t = lim }
    (*g).cy = t
    (*g).pending = false
}

fn move_left(g: *mut termgrid.Grid, n: usize) {
    if n >= (*g).cx { (*g).cx = 0 } else { (*g).cx = (*g).cx - n }
    (*g).pending = false
}

fn move_right(g: *mut termgrid.Grid, n: usize) {
    var t: usize = (*g).cx + n
    if t >= (*g).cols { t = (*g).cols - 1 }
    (*g).cx = t
    (*g).pending = false
}

fn set_region(g: *mut termgrid.Grid, top: usize, bot: usize) {
    var b: usize = bot
    if b >= (*g).rows { b = (*g).rows - 1 }
    if top >= b {
        (*g).top = 0
        (*g).bot = (*g).rows - 1
    } else {
        (*g).top = top
        (*g).bot = b
    }
    cursor_to(g, 0, 0)
}

fn save_cursor(g: *mut termgrid.Grid) {
    (*g).s_cx = (*g).cx
    (*g).s_cy = (*g).cy
    (*g).s_fg = (*g).fg
    (*g).s_bg = (*g).bg
    (*g).s_flags = (*g).flags
    (*g).s_pending = (*g).pending
    (*g).s_origin = (*g).origin
}

fn restore_cursor(g: *mut termgrid.Grid) {
    (*g).origin = (*g).s_origin
    (*g).cy = (*g).s_cy
    if (*g).cy >= (*g).rows { (*g).cy = (*g).rows - 1 }
    (*g).cx = (*g).s_cx
    if (*g).cx >= (*g).cols { (*g).cx = (*g).cols - 1 }
    (*g).fg = (*g).s_fg
    (*g).bg = (*g).s_bg
    (*g).flags = (*g).s_flags
    (*g).pending = (*g).s_pending
}
