// SPDX-License-Identifier: MPL-2.0
import std.rt
import term.termtext

export {
    encode_key, encode_char, encode_mouse, encode_paste, encode_focus,
    TK_UP, TK_DOWN, TK_RIGHT, TK_LEFT, TK_HOME, TK_END, TK_PGUP, TK_PGDN, TK_INSERT, TK_DELETE,
    TK_BACKSPACE, TK_ENTER, TK_TAB, TK_ESC, TK_F1, TK_F12,
    M_SHIFT, M_CTRL, M_ALT,
    MK_PRESS, MK_RELEASE, MK_MOVE, BTN_LEFT, BTN_MIDDLE, BTN_RIGHT, BTN_NONE, BTN_WHEEL_UP, BTN_WHEEL_DOWN,
}

const TK_UP: u32 = 1
const TK_DOWN: u32 = 2
const TK_RIGHT: u32 = 3
const TK_LEFT: u32 = 4
const TK_HOME: u32 = 5
const TK_END: u32 = 6
const TK_PGUP: u32 = 7
const TK_PGDN: u32 = 8
const TK_INSERT: u32 = 9
const TK_DELETE: u32 = 10
const TK_BACKSPACE: u32 = 11
const TK_ENTER: u32 = 12
const TK_TAB: u32 = 13
const TK_ESC: u32 = 14
const TK_F1: u32 = 20
const TK_F12: u32 = 31

const M_SHIFT: u32 = 1
const M_CTRL: u32 = 4
const M_ALT: u32 = 8

const MK_PRESS: u32 = 0
const MK_RELEASE: u32 = 1
const MK_MOVE: u32 = 2
const BTN_LEFT: u32 = 0
const BTN_MIDDLE: u32 = 1
const BTN_RIGHT: u32 = 2
const BTN_NONE: u32 = 3
const BTN_WHEEL_UP: u32 = 64
const BTN_WHEEL_DOWN: u32 = 65

const ESC: u8 = 27 as u8
const MOUSE_X10_LIMIT: u32 = 223
const MOUSE_MOTION_BIT: u32 = 32
const MOUSE_DRAG: u32 = 1002
const MOUSE_ANY: u32 = 1003

fn push_str(out: *mut rt.Buf, s: str) { rt.buf_push_bytes(out, s.p as u64, s.n) }

fn xterm_mod(mods: u32) -> u32 {
    var m: u32 = 1 as u32
    if (mods & M_SHIFT) != 0 as u32 { m = m + 1 as u32 }
    if (mods & M_ALT) != 0 as u32 { m = m + 2 as u32 }
    if (mods & M_CTRL) != 0 as u32 { m = m + 4 as u32 }
    return m
}

fn push_csi_letter(out: *mut rt.Buf, letter: u8, mods: u32) {
    rt.buf_push(out, ESC)
    rt.buf_push(out, 91 as u8)
    if mods != 0 as u32 {
        push_str(out, "1;")
        rt.buf_push_dec_u64(out, xterm_mod(mods) as u64)
    }
    rt.buf_push(out, letter)
}

fn push_csi_tilde(out: *mut rt.Buf, code: u32, mods: u32) {
    rt.buf_push(out, ESC)
    rt.buf_push(out, 91 as u8)
    rt.buf_push_dec_u64(out, code as u64)
    if mods != 0 as u32 {
        rt.buf_push(out, 59 as u8)
        rt.buf_push_dec_u64(out, xterm_mod(mods) as u64)
    }
    rt.buf_push(out, 126 as u8)
}

fn cursor_letter(key: u32) -> u8 {
    if key == TK_UP { return 65 as u8 }
    if key == TK_DOWN { return 66 as u8 }
    if key == TK_RIGHT { return 67 as u8 }
    if key == TK_LEFT { return 68 as u8 }
    if key == TK_HOME { return 72 as u8 }
    return 70 as u8
}

fn tilde_code(key: u32) -> u32 {
    if key == TK_INSERT { return 2 as u32 }
    if key == TK_DELETE { return 3 as u32 }
    if key == TK_PGUP { return 5 as u32 }
    return 6 as u32
}

fn function_code(n: u32) -> u32 {
    if n == 5 { return 15 as u32 }
    if n == 6 { return 17 as u32 }
    if n == 7 { return 18 as u32 }
    if n == 8 { return 19 as u32 }
    if n == 9 { return 20 as u32 }
    if n == 10 { return 21 as u32 }
    if n == 11 { return 23 as u32 }
    return 24 as u32
}

fn encode_function(n: u32, mods: u32, out: *mut rt.Buf) {
    if n <= 4 {
        let letter: u8 = (79 + n) as u8
        if mods == 0 as u32 {
            rt.buf_push(out, ESC)
            rt.buf_push(out, 79 as u8)
            rt.buf_push(out, letter)
        } else {
            push_csi_letter(out, letter, mods)
        }
        return
    }
    push_csi_tilde(out, function_code(n), mods)
}

fn encode_cursor(app_cursor: bool, key: u32, mods: u32, out: *mut rt.Buf) {
    if app_cursor && mods == 0 as u32 {
        rt.buf_push(out, ESC)
        rt.buf_push(out, 79 as u8)
        rt.buf_push(out, cursor_letter(key))
        return
    }
    push_csi_letter(out, cursor_letter(key), mods)
}

fn encode_simple(key: u32, mods: u32, out: *mut rt.Buf) {
    if (mods & M_ALT) != 0 as u32 { rt.buf_push(out, ESC) }
    if key == TK_BACKSPACE {
        if (mods & M_CTRL) != 0 as u32 { rt.buf_push(out, 8 as u8) } else { rt.buf_push(out, 127 as u8) }
    } else if key == TK_ENTER {
        rt.buf_push(out, 13 as u8)
    } else if key == TK_TAB {
        if (mods & M_SHIFT) != 0 as u32 { push_str(out, "\x1b[Z") } else { rt.buf_push(out, 9 as u8) }
    } else {
        rt.buf_push(out, ESC)
    }
}

fn encode_key(app_cursor: bool, key: u32, mods: u32, out: *mut rt.Buf) -> bool {
    if key >= TK_UP && key <= TK_LEFT || key == TK_HOME || key == TK_END {
        encode_cursor(app_cursor, key, mods, out)
    } else if key == TK_INSERT || key == TK_DELETE || key == TK_PGUP || key == TK_PGDN {
        push_csi_tilde(out, tilde_code(key), mods)
    } else if key == TK_BACKSPACE || key == TK_ENTER || key == TK_TAB || key == TK_ESC {
        encode_simple(key, mods, out)
    } else if key >= TK_F1 && key <= TK_F12 {
        encode_function(key - TK_F1 + 1 as u32, mods, out)
    } else {
        return false
    }
    return true
}

fn control_code(cp: u32) -> u32 {
    if cp >= 97 && cp <= 122 { return cp - 96 as u32 }
    if cp >= 64 && cp <= 95 { return cp - 64 as u32 }
    if cp == 32 { return 0 as u32 }
    if cp == 63 { return 127 as u32 }
    return cp
}

fn encode_char(cp: u32, mods: u32, out: *mut rt.Buf) {
    if (mods & M_ALT) != 0 as u32 { rt.buf_push(out, ESC) }
    if (mods & M_CTRL) != 0 as u32 && cp < 128 {
        rt.buf_push(out, control_code(cp) as u8)
        return
    }
    termtext.push_cp(out, cp)
}

fn mouse_reported(mode: u32, kind: u32, button: u32) -> bool {
    if mode == 0 as u32 { return false }
    if kind != MK_MOVE { return true }
    if mode == MOUSE_ANY { return true }
    return mode == MOUSE_DRAG && button != BTN_NONE
}

fn push_x10(out: *mut rt.Buf, cb: u32, x: u32, y: u32) {
    push_str(out, "\x1b[M")
    rt.buf_push(out, (cb + 32 as u32) as u8)
    rt.buf_push(out, (x + 32 as u32) as u8)
    rt.buf_push(out, (y + 32 as u32) as u8)
}

fn push_sgr(out: *mut rt.Buf, cb: u32, x: u32, y: u32, release: bool) {
    push_str(out, "\x1b[<")
    rt.buf_push_dec_u64(out, cb as u64)
    rt.buf_push(out, 59 as u8)
    rt.buf_push_dec_u64(out, x as u64)
    rt.buf_push(out, 59 as u8)
    rt.buf_push_dec_u64(out, y as u64)
    if release { rt.buf_push(out, 109 as u8) } else { rt.buf_push(out, 77 as u8) }
}

fn mouse_code(kind: u32, button: u32, mods: u32) -> u32 {
    var cb: u32 = button
    if (mods & M_SHIFT) != 0 as u32 { cb = cb + 4 as u32 }
    if (mods & M_ALT) != 0 as u32 { cb = cb + 8 as u32 }
    if (mods & M_CTRL) != 0 as u32 { cb = cb + 16 as u32 }
    if kind == MK_MOVE { cb = cb + MOUSE_MOTION_BIT }
    return cb
}

fn encode_mouse(mode: u32, sgr: bool, kind: u32, button: u32, col: u32, row: u32, mods: u32, out: *mut rt.Buf) -> bool {
    if !mouse_reported(mode, kind, button) { return false }
    let x: u32 = col + 1 as u32
    let y: u32 = row + 1 as u32
    if sgr {
        push_sgr(out, mouse_code(kind, button, mods), x, y, kind == MK_RELEASE)
        return true
    }
    if x > MOUSE_X10_LIMIT || y > MOUSE_X10_LIMIT { return false }
    var b: u32 = button
    if kind == MK_RELEASE { b = BTN_NONE }
    push_x10(out, mouse_code(kind, b, mods), x, y)
    return true
}

fn paste_octet_ok(c: u8) -> bool {
    return c >= 32 as u8 || c == 9 as u8 || c == 10 as u8 || c == 13 as u8
}

fn encode_paste(bracketed: bool, p: u64, n: usize, out: *mut rt.Buf) {
    if bracketed { push_str(out, "\x1b[200~") }
    var i: usize = 0
    while i < n {
        var c: u8 = rt.ld8(p, i)
        if paste_octet_ok(c) {
            if c == 10 as u8 && !bracketed { c = 13 as u8 }
            rt.buf_push(out, c)
        }
        i = i + 1
    }
    if bracketed { push_str(out, "\x1b[201~") }
}

fn encode_focus(focused: bool, out: *mut rt.Buf) {
    if focused { push_str(out, "\x1b[I") } else { push_str(out, "\x1b[O") }
}
