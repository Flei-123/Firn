import std.rt
import term.vtparse
import term.termgrid
import term.termstate
import term.termcursor
import term.termcsi
import term.termesc

export {
    term_new, term_free, term_feed, term_feed_str, term_resize, term_reset,
    term_grid, term_gen, term_cols, term_rows, term_title, term_title_gen,
    term_reply_ptr, term_reply_len, term_reply_clear,
    term_is_alt, term_app_cursor, term_bracketed, term_mouse_mode, term_mouse_sgr,
    term_cursor_visible, term_focus_report, term_bell,
    SCROLLBACK_DEFAULT, MOUSE_OFF, MOUSE_PRESS, MOUSE_DRAG, MOUSE_ANY,
}

const SCROLLBACK_DEFAULT: usize = termstate.SCROLLBACK_DEFAULT
const MOUSE_OFF: u32 = termstate.MOUSE_OFF
const MOUSE_PRESS: u32 = termstate.MOUSE_PRESS
const MOUSE_DRAG: u32 = termstate.MOUSE_DRAG
const MOUSE_ANY: u32 = termstate.MOUSE_ANY

fn term_new(cols: usize, rows: usize, scrollback: usize) -> *mut termstate.Term {
    return termstate.term_alloc(cols, rows, scrollback)
}

fn term_free(t: *mut termstate.Term) { termstate.term_release(t) }

fn handle_action(t: *mut termstate.Term, act: u32) {
    let p: *mut vtparse.Parser = &(*t).parser
    if act == vtparse.ACT_PRINT {
        let cp: u32 = termesc.translate(t, (*p).cp)
        (*t).last_cp = cp
        termcursor.put_char(termstate.cur(t), cp)
    } else if act == vtparse.ACT_EXEC {
        termesc.exec_control(t, (*p).cp)
    } else if act == vtparse.ACT_CSI {
        termcsi.dispatch_csi(t)
    } else if act == vtparse.ACT_ESC {
        termesc.dispatch_esc(t)
    } else if act == vtparse.ACT_OSC {
        termesc.dispatch_osc(t)
    }
}

fn feed_octet(t: *mut termstate.Term, b: u8) {
    let act: u32 = vtparse.feed(&(*t).parser, b)
    if act != vtparse.ACT_NONE { handle_action(t, act) }
    let again: i32 = vtparse.take_replay(&(*t).parser)
    if again >= 0 as i32 { feed_octet(t, again as u8) }
}

fn term_feed(t: *mut termstate.Term, p: u64, n: usize) {
    var i: usize = 0
    while i < n {
        feed_octet(t, rt.ld8(p, i))
        i = i + 1
    }
}

fn term_feed_str(t: *mut termstate.Term, s: str) { term_feed(t, s.p as u64, s.n) }

fn term_resize(t: *mut termstate.Term, cols: usize, rows: usize) {
    termgrid.grid_resize(&(*t).main, cols, rows)
    termgrid.grid_resize(&(*t).alt, cols, rows)
}

fn term_reset(t: *mut termstate.Term) { termesc.reset_state(t) }

fn term_grid(t: *mut termstate.Term) -> *mut termgrid.Grid { return termstate.cur(t) }

fn term_gen(t: *mut termstate.Term) -> u64 { return (*termstate.cur(t)).gen + (*t).title_gen }

fn term_cols(t: *mut termstate.Term) -> usize { return (*termstate.cur(t)).cols }

fn term_rows(t: *mut termstate.Term) -> usize { return (*termstate.cur(t)).rows }

fn term_title(t: *mut termstate.Term) -> str {
    return str { p: rt.ptr_of((&(*t).title[0]) as u64), n: (*t).title_len }
}

fn term_title_gen(t: *mut termstate.Term) -> u64 { return (*t).title_gen }

fn term_reply_ptr(t: *mut termstate.Term) -> u64 { return rt.buf_ptr(&(*t).reply) }

fn term_reply_len(t: *mut termstate.Term) -> usize { return rt.buf_len(&(*t).reply) }

fn term_reply_clear(t: *mut termstate.Term) { termstate.reply_clear(t) }

fn term_is_alt(t: *mut termstate.Term) -> bool { return (*t).use_alt }

fn term_app_cursor(t: *mut termstate.Term) -> bool { return (*t).app_cursor }

fn term_bracketed(t: *mut termstate.Term) -> bool { return (*t).bracketed }

fn term_mouse_mode(t: *mut termstate.Term) -> u32 { return (*t).mouse_mode }

fn term_mouse_sgr(t: *mut termstate.Term) -> bool { return (*t).mouse_sgr }

fn term_cursor_visible(t: *mut termstate.Term) -> bool { return (*t).cursor_visible }

fn term_focus_report(t: *mut termstate.Term) -> bool { return (*t).focus_report }

fn term_bell(t: *mut termstate.Term) -> u64 { return (*t).bell }
