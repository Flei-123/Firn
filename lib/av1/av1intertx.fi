// SPDX-License-Identifier: MPL-2.0
export { inter_set, inter_inv, inter_nsym, in_set_inter }

static INV1: [i16; 16] = [9, 10, 11, 12, 13, 14, 15, 0, 1, 2, 4, 5, 3, 6, 7, 8]
static INV2: [i16; 12] = [9, 10, 11, 0, 1, 2, 4, 5, 3, 6, 7, 8]
static INV3: [i16; 2] = [9, 0]

fn inter_set(sqr: i64, sqrup: i64, reduced: i64) -> i64 {
    if sqrup > 3 {
        return 0
    }
    if reduced != 0 || sqrup == 3 {
        return 3
    }
    if sqr == 2 {
        return 2
    }
    return 1
}

fn inter_nsym(set: i64) -> i64 {
    if set == 1 {
        return 16
    }
    if set == 2 {
        return 12
    }
    return 2
}

fn inter_inv(set: i64, sym: i64) -> i64 {
    if set == 1 {
        return INV1[sym as usize] as i64
    }
    if set == 2 {
        return INV2[sym as usize] as i64
    }
    return INV3[sym as usize] as i64
}

fn in_set_inter(set: i64, t: i64) -> i64 {
    if set == 1 {
        return 1
    }
    if set == 2 {
        if t < 12 {
            return 1
        }
        return 0
    }
    if set == 3 {
        if t == 0 || t == 9 {
            return 1
        }
    }
    if set == 0 && t == 0 {
        return 1
    }
    return 0
}
