// SPDX-License-Identifier: MPL-2.0
// lib/av1/av1pic.fi -- av1.pic: reference-counted decoded picture store (planes, grain parameters, frame metadata).
import rt.rt
import av1.av1mem
import av1.avif

export { pic_set, pic_new, pic_retain, pic_release, pic_get, pic_plane, pic_clone_plane, pic_store_grain, pic_load_grain }
export { PIC_STRIDE, PIC_ROWS, PIC_NP, PIC_W, PIC_H, PIC_DEPTH, PIC_FTYPE, PIC_SHOWABLE, PIC_ORDER, PIC_SUBX, PIC_SUBY }

const PIC_REFS: usize = 0
const PIC_P0: usize = 1
const PIC_P1: usize = 2
const PIC_P2: usize = 3
const PIC_STRIDE: usize = 4
const PIC_ROWS: usize = 5
const PIC_NP: usize = 6
const PIC_W: usize = 7
const PIC_H: usize = 8
const PIC_DEPTH: usize = 9
const PIC_GRAIN: usize = 10
const PIC_FTYPE: usize = 11
const PIC_SHOWABLE: usize = 12
const PIC_ORDER: usize = 13
const PIC_SUBX: usize = 14
const PIC_SUBY: usize = 15
const PIC_CELLS: usize = 16
const GRAIN_CELLS: usize = 200

fn pic_get(pic: u64, i: usize) -> i64 {
    return *((pic + ((i * 8) as u64)) as *mut i64)
}

fn pic_set(pic: u64, i: usize, v: i64) {
    *((pic + ((i * 8) as u64)) as *mut i64) = v
}

fn plane_bytes(pic: u64) -> usize {
    return (pic_get(pic, PIC_STRIDE) * pic_get(pic, PIC_ROWS) * 2) as usize
}

fn pic_new(src0: u64, src1: u64, src2: u64, stride: i64, rows: i64, np: i64, w: i64, h: i64, depth: i64, subx: i64, suby: i64) -> u64 {
    let pic: u64 = av1mem.heap_alloc(PIC_CELLS * 8) as u64
    if pic == 0 {
        return 0
    }
    pic_set(pic, PIC_REFS, 1)
    pic_set(pic, PIC_STRIDE, stride)
    pic_set(pic, PIC_ROWS, rows)
    pic_set(pic, PIC_NP, np)
    pic_set(pic, PIC_W, w)
    pic_set(pic, PIC_H, h)
    pic_set(pic, PIC_DEPTH, depth)
    pic_set(pic, PIC_SUBX, subx)
    pic_set(pic, PIC_SUBY, suby)
    let nb: usize = plane_bytes(pic)
    var k: i64 = 0
    while k < np {
        let d: u64 = av1mem.heap_alloc(nb) as u64
        var s: u64 = src0
        if k == 1 {
            s = src1
        }
        if k == 2 {
            s = src2
        }
        if d != 0 {
            av1mem.mem_copy(d as *mut u8, s as *mut u8, nb)
        }
        pic_set(pic, PIC_P0 + (k as usize), d as i64)
        k = k + 1
    }
    return pic
}

fn pic_plane(pic: u64, k: i64) -> u64 {
    return pic_get(pic, PIC_P0 + (k as usize)) as u64
}

fn pic_clone_plane(pic: u64, k: i64) -> u64 {
    let nb: usize = plane_bytes(pic)
    let d: u64 = av1mem.heap_alloc(nb) as u64
    if d != 0 {
        av1mem.mem_copy(d as *mut u8, pic_plane(pic, k) as *mut u8, nb)
    }
    return d
}

fn pic_retain(pic: u64) {
    pic_set(pic, PIC_REFS, pic_get(pic, PIC_REFS) + 1)
}

fn pic_release(pic: u64) {
    if pic == 0 {
        return
    }
    let r: i64 = pic_get(pic, PIC_REFS) - 1
    pic_set(pic, PIC_REFS, r)
    if r > 0 {
        return
    }
    let nb: usize = plane_bytes(pic)
    var k: i64 = 0
    while k < pic_get(pic, PIC_NP) {
        av1mem.heap_free(pic_plane(pic, k) as *mut u8, nb)
        k = k + 1
    }
    let g: u64 = pic_get(pic, PIC_GRAIN) as u64
    if g != 0 {
        av1mem.heap_free(g as *mut u8, GRAIN_CELLS * 8)
    }
    av1mem.heap_free(pic as *mut u8, PIC_CELLS * 8)
}

fn pic_store_grain(pic: u64, info: u64) {
    let g: u64 = av1mem.heap_alloc(GRAIN_CELLS * 8) as u64
    pic_set(pic, PIC_GRAIN, g as i64)
    if g == 0 {
        return
    }
    var i: usize = 0
    while i < GRAIN_CELLS {
        *((g + ((i * 8) as u64)) as *mut i64) = avif.avif_cell(info, avif.GR_BASE + i)
        i = i + 1
    }
}

fn pic_load_grain(pic: u64, info: u64) {
    let g: u64 = pic_get(pic, PIC_GRAIN) as u64
    var i: usize = 0
    while i < GRAIN_CELLS {
        var v: i64 = 0
        if g != 0 {
            v = *((g + ((i * 8) as u64)) as *mut i64)
        }
        avif.avif_set_cell(info, avif.GR_BASE + i, v)
        i = i + 1
    }
}
