// lib/av1/av1seg.fi -- AV1 segmentation and loop filter level helpers.

export { neg_deinterleave, seg_predict, seg_ctx, lf_block_level }

fn clip3(lo: i64, hi: i64, v: i64) -> i64 {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

fn neg_deinterleave(diff: i64, ref: i64, max: i64) -> i64 {
    if ref == 0 {
        return diff
    }
    if ref >= max - 1 {
        return max - diff - 1
    }
    if 2 * ref < max {
        if diff <= 2 * ref {
            if (diff & 1) != 0 {
                return ref + ((diff + 1) >> 1)
            }
            return ref - (diff >> 1)
        }
        return diff
    }
    if diff <= 2 * (max - ref - 1) {
        if (diff & 1) != 0 {
            return ref + ((diff + 1) >> 1)
        }
        return ref - (diff >> 1)
    }
    return max - (diff + 1)
}

fn seg_predict(prev_ul: i64, prev_u: i64, prev_l: i64) -> i64 {
    if prev_u == 0 - 1 {
        if prev_l == 0 - 1 {
            return 0
        }
        return prev_l
    }
    if prev_l == 0 - 1 {
        return prev_u
    }
    if prev_ul == prev_u {
        return prev_u
    }
    return prev_l
}

fn seg_ctx(prev_ul: i64, prev_u: i64, prev_l: i64) -> i64 {
    if prev_ul < 0 {
        return 0
    }
    if prev_ul == prev_u && prev_ul == prev_l {
        return 2
    }
    if prev_ul == prev_u || prev_ul == prev_l || prev_u == prev_l {
        return 1
    }
    return 0
}

fn lf_block_level(frame_level: i64, delta_lf: i64, seg_active: i64, seg_data: i64, delta_en: i64, intra_delta: i64) -> i64 {
    var lvl: i64 = clip3(0, 63, delta_lf + frame_level)
    if seg_active != 0 {
        lvl = clip3(0, 63, lvl + seg_data)
    }
    if delta_en != 0 {
        lvl = clip3(0, 63, lvl + intra_delta * (1 << (lvl >> 5)))
    }
    return lvl
}
