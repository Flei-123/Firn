#[no_gc]
fn cget(c: u64, i: usize) -> i64 {
    return (*((c + (i * 4) as u64) as *mut u32)) as i64
}

#[no_gc]
fn cset(c: u64, i: usize, v: i64) {
    *((c + (i * 4) as u64) as *mut u32) = (v & 4294967295) as u32
}

fn cgets(c: u64, i: usize) -> i64 {
    let v: i64 = cget(c, i)
    if v >= 2147483648 {
        return v - 4294967296
    }
    return v
}

fn csets(c: u64, i: usize, v: i64) {
    cset(c, i, v)
}
