}

fn t_inv2(i: i64) -> i64 {
    return INV2[i as usize] as i64
}

fn t_smw(n: i64, i: i64) -> i64 {
    var s: i64 = 0
    if n == 8 {
        s = 4
    }
    if n == 16 {
        s = 12
    }
    if n == 32 {
        s = 28
    }
    if n == 64 {
        s = 60
    }
    return SMW[(s + i) as usize] as i64
}
