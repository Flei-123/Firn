const MAX_PROPS: usize = 64
const MAX_ASSOC: usize = 256
const IT_BASE: usize = 64
const PR_BASE: usize = 576
const AS_BASE: usize = 1088
const GR_BASE: usize = 2300
const GR_APPLY: usize = 0
const GR_SEED: usize = 1
const GR_NY: usize = 2
const GR_PY: usize = 3
const GR_CFL: usize = 31
const GR_NCB: usize = 32
const GR_PCB: usize = 33
const GR_NCR: usize = 53
const GR_PCR: usize = 54
const GR_SCALING: usize = 74
const GR_LAG: usize = 75
const GR_ARY: usize = 76
const GR_ARCB: usize = 100
const GR_ARCR: usize = 125
const GR_ARSHIFT: usize = 150
const GR_GSHIFT: usize = 151
const GR_CBMULT: usize = 152
const GR_CBLUMA: usize = 153
const GR_CBOFF: usize = 154
const GR_CRMULT: usize = 155
const GR_CRLUMA: usize = 156
const GR_CROFF: usize = 157
const GR_OVERLAP: usize = 158
const GR_CLIP: usize = 159

const CELLS: usize = 5700

#[no_gc]
fn ld32(p: u64, i: usize) -> i64 {
    return (*((p + (i * 4) as u64) as *mut u32)) as i64
}

#[no_gc]
fn st32(p: u64, i: usize, v: i64) {
    *((p + (i * 4) as u64) as *mut u32) = (v & 4294967295) as u32
}

#[no_gc]
fn rd8(p: u64, i: usize) -> i64 {
    if i >= G_N {
        return 0
    }
    return (*((p + i as u64) as *mut u8)) as i64
}

fn be16(p: u64, i: usize) -> i64 {
    return (rd8(p, i) << 8) | rd8(p, i + 1)
}

fn be32(p: u64, i: usize) -> i64 {
    return (rd8(p, i) << 24) | (rd8(p, i + 1) << 16) | (rd8(p, i + 2) << 8) | rd8(p, i + 3)
}

fn be_n(p: u64, i: usize, w: usize) -> i64 {
    var v: i64 = 0
    var k: usize = 0
    while k < w {
        v = (v << 8) | rd8(p, i + k)
        k = k + 1
    }
    return v
}

fn avif_cell(info: u64, i: usize) -> i64 {
    return ld32(info, i)
}

fn avif_info_free(info: u64) {
    if info != 0 {
        av1mem.heap_free(info as *mut u8, CELLS * 4)
    }
}

fn avif_sniff(p: u64, n: usize) -> bool {
    if n < 16 {
        return false
    }
    G_N = n
    if be32(p, 4) != FT_FTYP {
        return false
    }
    var sz: usize = be32(p, 0) as usize
    if sz > n || sz < 16 {
        sz = n
    }
    let major: i64 = be32(p, 8)
    if major == FT_AVIF || major == FT_AVIS {
        return true
    }
    var at: usize = 16
    while at + 4 <= sz {
        let b: i64 = be32(p, at)
        if b == FT_AVIF || b == FT_AVIS {
            return true
        }
        at = at + 4
    }
    return false
}

fn box_hdr(p: u64, at: usize) -> usize {
    if be32(p, at) == 1 {
        return 16
    }
    return 8
}

fn box_end(p: u64, at: usize, lim: usize) -> usize {
    if at + 8 > lim {
        return 0
    }
    let s: i64 = be32(p, at)
    var sz: usize = s as usize
    if s == 1 {
        if be32(p, at + 8) != 0 {
            return 0
        }
        sz = be32(p, at + 12) as usize
    } else if s == 0 {
        sz = lim - at
    }
    let h: usize = box_hdr(p, at)
    if sz < h || at + sz > lim {
        return 0
    }
    return at + sz
}

fn find_item(c: u64, id: i64) -> i64 {
    let n: usize = ld32(c, AI_N_ITEMS) as usize
    var i: usize = 0
    while i < n {
        if ld32(c, IT_BASE + i * 8) == id {
            return i as i64
        }
        i = i + 1
    }
    return -1
}

fn item_slot(c: u64, id: i64) -> i64 {
    let f: i64 = find_item(c, id)
    if f >= 0 {
        return f
    }
    let n: usize = ld32(c, AI_N_ITEMS) as usize
    if n >= MAX_ITEMS {
        return -1
    }
    st32(c, IT_BASE + n * 8, id)
    st32(c, AI_N_ITEMS, (n + 1) as i64)
    return n as i64
}

fn parse_iloc(p: u64, c: u64, at: usize, end: usize) {
    let ver: i64 = rd8(p, at)
    var q: usize = at + 4
    let b1: i64 = rd8(p, q)
    let b2: i64 = rd8(p, q + 1)
    q = q + 2
    let osz: usize = (b1 >> 4) as usize
    let lsz: usize = (b1 & 15) as usize
    let bsz: usize = (b2 >> 4) as usize
    var isz: usize = 0
    if ver == 1 || ver == 2 {
        isz = (b2 & 15) as usize
    }
    var cnt: i64 = 0
    if ver < 2 {
        cnt = be16(p, q)
        q = q + 2
    } else {
        cnt = be32(p, q)
        q = q + 4
    }
    var k: i64 = 0
    while k < cnt && q < end {
        var id: i64 = 0
        if ver < 2 {
            id = be16(p, q)
            q = q + 2
        } else {
            id = be32(p, q)
            q = q + 4
        }
        var cm: i64 = 0
        if ver == 1 || ver == 2 {
            cm = be16(p, q) & 15
            q = q + 2
        }
        q = q + 2
        let base: i64 = be_n(p, q, bsz)
        q = q + bsz
        let ne: i64 = be16(p, q)
        q = q + 2
        var off: i64 = 0
        var len: i64 = 0
        var e: i64 = 0
        while e < ne && q < end {
            q = q + isz
            let o: i64 = be_n(p, q, osz)
            q = q + osz
            let l: i64 = be_n(p, q, lsz)
            q = q + lsz
            if e == 0 {
                off = base + o
                len = l
            }
            e = e + 1
        }
        let s: i64 = item_slot(c, id)
        if s >= 0 {
            let b: usize = IT_BASE + (s as usize) * 8
            st32(c, b + 2, off)
            st32(c, b + 3, len)
            st32(c, b + 4, cm)
            st32(c, b + 5, ne)
        }
        k = k + 1
    }
}

fn parse_iinf(p: u64, c: u64, at: usize, end: usize) {
    let ver: i64 = rd8(p, at)
    var q: usize = at + 4
    if ver == 0 {
        q = q + 2
    } else {
        q = q + 4
    }
    while q + 8 <= end {
        let e: usize = box_end(p, q, end)
        if e == 0 {
            return
        }
        if be32(p, q + 4) == FT_INFE {
            let b: usize = q + box_hdr(p, q)
            let v: i64 = rd8(p, b)
            if v >= 2 {
                var id: i64 = 0
                var r: usize = b + 4
                if v == 2 {
                    id = be16(p, r)
                    r = r + 2
                } else {
                    id = be32(p, r)
                    r = r + 4
                }
                r = r + 2
                let s: i64 = item_slot(c, id)
                if s >= 0 {
                    st32(c, IT_BASE + (s as usize) * 8 + 1, be32(p, r))
                }
            }
        }
        q = e
    }
}

fn parse_ipco(p: u64, c: u64, at: usize, end: usize) {
    var q: usize = at
    while q + 8 <= end {
        let e: usize = box_end(p, q, end)
        if e == 0 {
            return
        }
        let n: usize = ld32(c, AI_N_PROPS) as usize
        if n < MAX_PROPS {
            let b: usize = PR_BASE + n * 8
            let h: usize = box_hdr(p, q)
            st32(c, b, be32(p, q + 4))
            st32(c, b + 1, (q + h) as i64)
            st32(c, b + 2, (e - q - h) as i64)
            st32(c, AI_N_PROPS, (n + 1) as i64)
        }
        q = e
    }
}

fn parse_ipma(p: u64, c: u64, at: usize, end: usize) {
    let ver: i64 = rd8(p, at)
    let fl: i64 = be32(p, at) & 16777215
    var q: usize = at + 4
    let cnt: i64 = be32(p, q)
    q = q + 4
    var k: i64 = 0
    while k < cnt && q < end {
        var id: i64 = 0
        if ver < 1 {
            id = be16(p, q)
            q = q + 2
        } else {
            id = be32(p, q)
            q = q + 4
        }
        let na: i64 = rd8(p, q)
        q = q + 1
        var j: i64 = 0
        while j < na && q < end {
            var pi: i64 = 0
            if (fl & 1) != 0 {
                pi = be16(p, q) & 32767
                q = q + 2
            } else {
                pi = rd8(p, q) & 127
                q = q + 1
            }
            let n: usize = ld32(c, AI_N_ASSOC) as usize
            if n < MAX_ASSOC {
                st32(c, AS_BASE + n * 2, id)
                st32(c, AS_BASE + n * 2 + 1, pi)
                st32(c, AI_N_ASSOC, (n + 1) as i64)
            }
            j = j + 1
        }
        k = k + 1
    }
}

fn parse_iprp(p: u64, c: u64, at: usize, end: usize) {
    var q: usize = at
    while q + 8 <= end {
        let e: usize = box_end(p, q, end)
        if e == 0 {
            return
        }
        let t: i64 = be32(p, q + 4)
        let b: usize = q + box_hdr(p, q)
        if t == FT_IPCO {
            parse_ipco(p, c, b, e)
        }
        if t == FT_IPMA {
            parse_ipma(p, c, b, e)
        }
        q = e
    }
}

fn parse_meta(p: u64, c: u64, at: usize, end: usize) {
    var q: usize = at
    while q + 8 <= end {
        let e: usize = box_end(p, q, end)
        if e == 0 {
            return
        }
        let t: i64 = be32(p, q + 4)
        let b: usize = q + box_hdr(p, q)
        if t == FT_PITM {
            if rd8(p, b) == 0 {
                st32(c, AI_PRIMARY_ID, be16(p, b + 4))
            } else {
                st32(c, AI_PRIMARY_ID, be32(p, b + 4))
            }
        }
        if t == FT_ILOC {
            parse_iloc(p, c, b, e)
        }
        if t == FT_IINF {
            parse_iinf(p, c, b, e)
        }
        if t == FT_IPRP {
            parse_iprp(p, c, b, e)
        }
        q = e
    }
}

fn item_prop(c: u64, id: i64, t: i64) -> i64 {
    let na: usize = ld32(c, AI_N_ASSOC) as usize
    let np: usize = ld32(c, AI_N_PROPS) as usize
    var j: usize = 0
    while j < na {
        if ld32(c, AS_BASE + j * 2) == id {
            let pi: i64 = ld32(c, AS_BASE + j * 2 + 1)
            if pi >= 1 && (pi as usize) <= np {
                let k: usize = (pi - 1) as usize
                if ld32(c, PR_BASE + k * 8) == t {
                    return k as i64
                }
            }
        }
        j = j + 1
    }
    return -1
}

fn auxc_is_alpha(p: u64, c: u64, k: usize) -> bool {
    let off: usize = ld32(c, PR_BASE + k * 8 + 1) as usize
    var len: usize = ld32(c, PR_BASE + k * 8 + 2) as usize
    if len < 10 {
        return false
    }
    len = len - 4
    var i: usize = off + 4
    let stop: usize = off + 4 + len
    while i + 5 <= stop {
        if rd8(p, i) == 97 && rd8(p, i + 1) == 108 && rd8(p, i + 2) == 112 && rd8(p, i + 3) == 104
            && rd8(p, i + 4) == 97 {
            return true
        }
        i = i + 1
    }
    return false
}

fn parse_seq_hdr(p: u64, n: usize, c: u64) -> bool {
    var b: av1bits.Bits = av1bits.Bits { p: p, n: n, pos: 0 }
    let sprof: i64 = av1bits.bits_get(&b, 3)
    let still: i64 = av1bits.bits_get(&b, 1)
    let reduced: i64 = av1bits.bits_get(&b, 1)
    st32(c, AI_SEQ_PROFILE, sprof)
    st32(c, AI_STILL, still)
    st32(c, AI_REDUCED, reduced)
    if sprof > 2 {
        return false
    }
    var dm_present: i64 = 0
    var buf_delay_len: usize = 0
    if reduced != 0 {
        st32(c, AI_SEQ_LEVEL, av1bits.bits_get(&b, 5))
    } else {
        let timing: i64 = av1bits.bits_get(&b, 1)
        st32(c, AI_TIMING, timing)
        if timing != 0 {
            av1bits.bits_get(&b, 32)
            av1bits.bits_get(&b, 32)
            if av1bits.bits_get(&b, 1) != 0 {
                av1bits.bits_uvlc(&b)
            }
            dm_present = av1bits.bits_get(&b, 1)
            st32(c, AI_DM, dm_present)
            if dm_present != 0 {
                buf_delay_len = (av1bits.bits_get(&b, 5) + 1) as usize
                av1bits.bits_get(&b, 32)
                av1bits.bits_get(&b, 5)
                av1bits.bits_get(&b, 5)
            }
        }
        let idd: i64 = av1bits.bits_get(&b, 1)
        let nop: i64 = av1bits.bits_get(&b, 5) + 1
        var i: i64 = 0
        while i < nop {
            av1bits.bits_get(&b, 12)
            let lvl: i64 = av1bits.bits_get(&b, 5)
            if i == 0 {
                st32(c, AI_SEQ_LEVEL, lvl)
            }
            if lvl > 7 {
                av1bits.bits_get(&b, 1)
            }
            if dm_present != 0 {
                if av1bits.bits_get(&b, 1) != 0 {
                    av1bits.bits_get(&b, buf_delay_len)
                    av1bits.bits_get(&b, buf_delay_len)
                    av1bits.bits_get(&b, 1)
                }
            }
            if idd != 0 {
                if av1bits.bits_get(&b, 1) != 0 {
                    av1bits.bits_get(&b, 4)
                }
            }
            i = i + 1
        }
    }
    let wb: usize = (av1bits.bits_get(&b, 4) + 1) as usize
    let hb: usize = (av1bits.bits_get(&b, 4) + 1) as usize
    st32(c, AI_WBITS, wb as i64)
    st32(c, AI_HBITS, hb as i64)
    st32(c, AI_MAXW, av1bits.bits_get(&b, wb) + 1)
    st32(c, AI_MAXH, av1bits.bits_get(&b, hb) + 1)
    st32(c, AI_SEQ_SCT, 2)
    st32(c, AI_SEQ_FIMV, 2)
    if reduced == 0 {
        if av1bits.bits_get(&b, 1) != 0 {
            let d: i64 = av1bits.bits_get(&b, 4) + 2
            let a: i64 = av1bits.bits_get(&b, 3) + 1
            st32(c, AI_FID_LEN, d + a)
            st32(c, AI_DFID_LEN, d)
        }
    }
    st32(c, AI_SB128, av1bits.bits_get(&b, 1))
    st32(c, AI_FILTER_INTRA, av1bits.bits_get(&b, 1))
    st32(c, AI_EDGE_FILTER, av1bits.bits_get(&b, 1))
    if reduced == 0 {
        let tl: i64 = av1bits.bits_get(&b, 4)
        let order_hint: i64 = av1bits.bits_get(&b, 1)
        var tools: i64 = ((tl >> 3) & 1) | (((tl >> 2) & 1) << 1) | (((tl >> 1) & 1) << 2) | ((tl & 1) << 3)
        if order_hint != 0 {
            let jr: i64 = av1bits.bits_get(&b, 2)
            tools = tools | 16 | (((jr >> 1) & 1) << 5) | ((jr & 1) << 6)
        }
        st32(c, AI_TOOLS, tools)
        var sct: i64 = 2
        if av1bits.bits_get(&b, 1) == 0 {
            sct = av1bits.bits_get(&b, 1)
        }
        st32(c, AI_SEQ_SCT, sct)
        var fimv: i64 = 2
        if sct > 0 {
            if av1bits.bits_get(&b, 1) == 0 {
                fimv = av1bits.bits_get(&b, 1)
            }
        }
        st32(c, AI_SEQ_FIMV, fimv)
        if order_hint != 0 {
            st32(c, AI_OH_BITS, av1bits.bits_get(&b, 3) + 1)
        }
    }
    st32(c, AI_SUPERRES, av1bits.bits_get(&b, 1))
    st32(c, AI_CDEF, av1bits.bits_get(&b, 1))
    st32(c, AI_RESTORATION, av1bits.bits_get(&b, 1))
    let high: i64 = av1bits.bits_get(&b, 1)
    var depth: i64 = 8
    if sprof == 2 && high != 0 {
        if av1bits.bits_get(&b, 1) != 0 {
            depth = 12
        } else {
            depth = 10
        }
    } else if high != 0 {
        depth = 10
    }
    st32(c, AI_BITDEPTH, depth)
    var mono: i64 = 0
    if sprof != 1 {
        mono = av1bits.bits_get(&b, 1)
    }
    st32(c, AI_MONO, mono)
    var cp: i64 = 2
    var tc: i64 = 2
    var mc: i64 = 2
    if av1bits.bits_get(&b, 1) != 0 {
        cp = av1bits.bits_get(&b, 8)
        tc = av1bits.bits_get(&b, 8)
        mc = av1bits.bits_get(&b, 8)
    }
    st32(c, AI_CP, cp)
    st32(c, AI_TC, tc)
    st32(c, AI_MC, mc)
    var sx: i64 = 1
    var sy: i64 = 1
    if mono != 0 {
        st32(c, AI_FULL_RANGE, av1bits.bits_get(&b, 1))
    } else if cp == 1 && tc == 13 && mc == 0 {
        st32(c, AI_FULL_RANGE, 1)
        sx = 0
        sy = 0
        st32(c, AI_SEP_UV_DQ, av1bits.bits_get(&b, 1))
    } else {
        st32(c, AI_FULL_RANGE, av1bits.bits_get(&b, 1))
        if sprof == 0 {
            sx = 1
            sy = 1
        } else if sprof == 1 {
            sx = 0
            sy = 0
        } else if depth == 12 {
            sx = av1bits.bits_get(&b, 1)
            sy = 0
            if sx != 0 {
                sy = av1bits.bits_get(&b, 1)
            }
        } else {
            sx = 1
            sy = 0
        }
        if sx != 0 && sy != 0 {
            st32(c, AI_CHROMA_POS, av1bits.bits_get(&b, 2))
        }
        st32(c, AI_SEP_UV_DQ, av1bits.bits_get(&b, 1))
    }
    st32(c, AI_SUBX, sx)
    st32(c, AI_SUBY, sy)
    st32(c, AI_FILM_GRAIN, av1bits.bits_get(&b, 1))
    if av1bits.bits_over(&b) {
        return false
    }
    return true
}

fn tile_log2(blk: i64, target: i64) -> i64 {
    var k: i64 = 0
    while (blk << k) < target {
        k = k + 1
    }
    return k
}

fn imin(a: i64, b: i64) -> i64 {
    if a < b {
        return a
    }
    return b
}

fn imax(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    }
    return b
}

fn fh(c: u64, i: usize, v: i64) {
    st32(c, FH_BASE + i, v & 4294967295)
}

fn fhg(c: u64, i: usize) -> i64 {
    return ld32(c, FH_BASE + i)
}

fn read_delta_q(b: *mut av1bits.Bits) -> i64 {
    if av1bits.bits_get(b, 1) != 0 {
        return av1bits.bits_su(b, 7) + 128
    }
    return 128
}

fn gr(c: u64, i: usize, v: i64) {
    st32(c, GR_BASE + i, v & 4294967295)
}

fn grain_points(b: *mut av1bits.Bits, c: u64, count_idx: usize, base: usize) {
    let n: i64 = av1bits.bits_get(b, 4)
    gr(c, count_idx, n)
    var i: i64 = 0
    while i < n && i < 14 {
        gr(c, base + (i as usize) * 2, av1bits.bits_get(b, 8))
        gr(c, base + (i as usize) * 2 + 1, av1bits.bits_get(b, 8))
        i = i + 1
    }
}

fn grain_coeffs(b: *mut av1bits.Bits, c: u64, base: usize, n: i64) {
    var i: i64 = 0
    while i < n {
        gr(c, base + (i as usize), av1bits.bits_get(b, 8))
        i = i + 1
    }
}

fn rf_idx(slot: i64, i: usize) -> usize {
    return av1fhx.RF_BASE + (slot as usize) * av1fhx.RF_STRIDE + i
}

fn rfg(c: u64, slot: i64, i: usize) -> i64 {
    return ld32(c, rf_idx(slot, i))
}

fn rfs(c: u64, slot: i64, i: usize, v: i64) {
    st32(c, rf_idx(slot, i), v)
}

fn copy_cells(c: u64, dst: usize, src: usize, n: usize) {
    var i: usize = 0
    while i < n {
        st32(c, dst + i, ld32(c, src + i))
        i = i + 1
    }
}

fn slot_hints(c: u64) {
    var i: usize = 0
    while i < 8 {
        st32(c, FH_BASE + av1fhx.FH_SLOT_HINT + i, rfg(c, i as i64, av1fhx.RF_ORDER))
        i = i + 1
    }
}

fn lf_defaults(c: u64) {
    fh(c, av1fhx.FH_LF_REFD, 129)
    fh(c, av1fhx.FH_LF_REFD + 1, 128)
    fh(c, av1fhx.FH_LF_REFD + 2, 128)
    fh(c, av1fhx.FH_LF_REFD + 3, 128)
    fh(c, av1fhx.FH_LF_REFD + 4, 127)
    fh(c, av1fhx.FH_LF_REFD + 5, 128)
    fh(c, av1fhx.FH_LF_REFD + 6, 127)
    fh(c, av1fhx.FH_LF_REFD + 7, 127)
    fh(c, av1fhx.FH_LF_MODED, 128)
    fh(c, av1fhx.FH_LF_MODED + 1, 128)
}

fn load_previous(c: u64, primary: i64) -> bool {
    av1gm.gm_defaults(c, FH_BASE + av1fhx.FH_GM_PARAMS)
    lf_defaults(c)
    if primary == av1fhx.PRIMARY_NONE {
        return true
    }
    if primary > 6 {
        return false
    }
    let slot: i64 = fhg(c, av1fhx.FH_REF_IDX + (primary as usize))
    if rfg(c, slot, av1fhx.RF_VALID) == 0 {
        return false
    }
    fh(c, av1fhx.FH_PREV_SLOT, slot)
    var k: usize = 0
    while k < 8 {
        fh(c, av1fhx.FH_LF_REFD + k, rfg(c, slot, av1fhx.RF_LF + k))
        k = k + 1
    }
    fh(c, av1fhx.FH_LF_MODED, rfg(c, slot, av1fhx.RF_LF + 8))
    fh(c, av1fhx.FH_LF_MODED + 1, rfg(c, slot, av1fhx.RF_LF + 9))
    return true
}

fn load_seg(c: u64, slot: i64) {
    var s: usize = 0
    while s < 8 {
        var j: usize = 0
        while j < 8 {
            let en: i64 = rfg(c, slot, av1fhx.RF_SEGE + s * 8 + j)
            st32(c, FH_BASE + FH_SEG_FEAT + s * 8 + j, rfg(c, slot, av1fhx.RF_SEGF + s * 8 + j))
            st32(c, FH_BASE + FH_SEG_FEN + s * 8 + j, en)
            if en != 0 {
                if j >= 5 {
                    fh(c, FH_SEG_PRESKIP, 1)
                }
                if (s as i64) > fhg(c, FH_SEG_LAST) {
                    fh(c, FH_SEG_LAST, s as i64)
                }
            }
            j = j + 1
        }
        s = s + 1
    }
}

fn parse_ref_idx(b: *mut av1bits.Bits, c: u64) -> bool {
    var short: i64 = 0
    let tools: i64 = ld32(c, AI_TOOLS)
    if (tools & av1fhx.TOOL_ORDER) != 0 {
        short = av1bits.bits_get(b, 1)
    }
    fh(c, av1fhx.FH_SHORT_SIG, short)
    if short != 0 {
        let last: i64 = av1bits.bits_get(b, 3)
        let gold: i64 = av1bits.bits_get(b, 3)
        fh(c, av1fhx.FH_LAST_IDX, last)
        fh(c, av1fhx.FH_GOLD_IDX, gold)
        copy_cells(c, FH_BASE + av1fhx.FH_REF_HINT, FH_BASE + av1fhx.FH_SLOT_HINT, 8)
        av1refs.set_frame_refs(c, FH_BASE, FH_BASE + av1fhx.FH_USED, ld32(c, AI_OH_BITS), fhg(c, FH_ORDER_HINT), last, gold)
    }
    var i: usize = 0
    while i < 7 {
        if short == 0 {
            fh(c, av1fhx.FH_REF_IDX + i, av1bits.bits_get(b, 3))
        }
        if ld32(c, AI_FID_LEN) != 0 {
            av1bits.bits_get(b, ld32(c, AI_DFID_LEN) as usize)
        }
        let slot: i64 = fhg(c, av1fhx.FH_REF_IDX + i)
        if slot > 7 || rfg(c, slot, av1fhx.RF_VALID) == 0 {
            return false
        }
        fh(c, av1fhx.FH_ORDER_HINTS + 1 + i, rfg(c, slot, av1fhx.RF_ORDER))
        i = i + 1
    }
    return true
}

fn parse_inter_flags(b: *mut av1bits.Bits, c: u64, force_int: i64, err_res: i64) {
    var hp: i64 = 0
    if force_int == 0 {
        hp = av1bits.bits_get(b, 1)
    }
    fh(c, av1fhx.FH_ALLOW_HP, hp)
    var interp: i64 = 4
    if av1bits.bits_get(b, 1) == 0 {
        interp = av1bits.bits_get(b, 2)
    }
    fh(c, av1fhx.FH_INTERP, interp)
    fh(c, av1fhx.FH_MOTION_SWITCH, av1bits.bits_get(b, 1))
    var urm: i64 = 0
    if err_res == 0 && (ld32(c, AI_TOOLS) & av1fhx.TOOL_REFMVS) != 0 {
        urm = av1bits.bits_get(b, 1)
    }
    fh(c, av1fhx.FH_USE_REF_MVS, urm)
}

fn parse_skip_mode(b: *mut av1bits.Bits, c: u64, intra: bool, ref_select: i64) {
    var allowed: bool = false
    if !intra && ref_select != 0 && (ld32(c, AI_TOOLS) & av1fhx.TOOL_ORDER) != 0 {
        allowed = av1refs.skip_mode_params(c, FH_BASE, FH_BASE + av1fhx.FH_SLOT_HINT, ld32(c, AI_OH_BITS), fhg(c, FH_ORDER_HINT))
    }
    if allowed {
        fh(c, av1fhx.FH_SKIP_ALLOWED, 1)
        fh(c, av1fhx.FH_SKIP_PRESENT, av1bits.bits_get(b, 1))
    }
}

fn ref_save(c: u64, slot: i64) {
    let o: usize = rf_idx(slot, 0)
    st32(c, o + av1fhx.RF_VALID, 1)
    st32(c, o + av1fhx.RF_ORDER, fhg(c, FH_ORDER_HINT))
    st32(c, o + av1fhx.RF_FTYPE, fhg(c, FH_FRAME_TYPE))
    st32(c, o + av1fhx.RF_UPW, fhg(c, FH_UP_W))
    st32(c, o + av1fhx.RF_FW, fhg(c, FH_FRAME_W))
    st32(c, o + av1fhx.RF_FH, fhg(c, FH_FRAME_H))
    st32(c, o + av1fhx.RF_RW, fhg(c, av1fhx.FH_RENDER_W))
    st32(c, o + av1fhx.RF_RH, fhg(c, av1fhx.FH_RENDER_H))
    st32(c, o + av1fhx.RF_MIC, fhg(c, FH_MI_COLS))
    st32(c, o + av1fhx.RF_MIR, fhg(c, FH_MI_ROWS))
    st32(c, o + av1fhx.RF_SHOWABLE, fhg(c, FH_SHOWABLE))
    copy_cells(c, o + av1fhx.RF_GM, FH_BASE + av1fhx.FH_GM_PARAMS, 48)
    copy_cells(c, o + av1fhx.RF_LF, FH_BASE + av1fhx.FH_LF_REFD, 8)
    copy_cells(c, o + av1fhx.RF_LF + 8, FH_BASE + av1fhx.FH_LF_MODED, 2)
    copy_cells(c, o + av1fhx.RF_OHINTS, FH_BASE + av1fhx.FH_ORDER_HINTS, 8)
    copy_cells(c, o + av1fhx.RF_SEGF, FH_BASE + FH_SEG_FEAT, 64)
    copy_cells(c, o + av1fhx.RF_SEGE, FH_BASE + FH_SEG_FEN, 64)
    copy_cells(c, o + av1fhx.RF_GRAIN, GR_BASE, av1fhx.RF_GRAIN_N)
}

fn ref_load(c: u64, slot: i64) {
    let o: usize = rf_idx(slot, 0)
    fh(c, FH_ORDER_HINT, ld32(c, o + av1fhx.RF_ORDER))
    fh(c, FH_FRAME_TYPE, ld32(c, o + av1fhx.RF_FTYPE))
    fh(c, FH_UP_W, ld32(c, o + av1fhx.RF_UPW))
    fh(c, FH_FRAME_W, ld32(c, o + av1fhx.RF_FW))
    fh(c, FH_FRAME_H, ld32(c, o + av1fhx.RF_FH))
    fh(c, av1fhx.FH_RENDER_W, ld32(c, o + av1fhx.RF_RW))
    fh(c, av1fhx.FH_RENDER_H, ld32(c, o + av1fhx.RF_RH))
    fh(c, FH_MI_COLS, ld32(c, o + av1fhx.RF_MIC))
    fh(c, FH_MI_ROWS, ld32(c, o + av1fhx.RF_MIR))
    fh(c, FH_SHOWABLE, ld32(c, o + av1fhx.RF_SHOWABLE))
    copy_cells(c, FH_BASE + av1fhx.FH_GM_PARAMS, o + av1fhx.RF_GM, 48)
    copy_cells(c, FH_BASE + av1fhx.FH_LF_REFD, o + av1fhx.RF_LF, 8)
    copy_cells(c, FH_BASE + av1fhx.FH_LF_MODED, o + av1fhx.RF_LF + 8, 2)
    copy_cells(c, FH_BASE + av1fhx.FH_ORDER_HINTS, o + av1fhx.RF_OHINTS, 8)
    copy_cells(c, FH_BASE + FH_SEG_FEAT, o + av1fhx.RF_SEGF, 64)
    copy_cells(c, FH_BASE + FH_SEG_FEN, o + av1fhx.RF_SEGE, 64)
    copy_cells(c, GR_BASE, o + av1fhx.RF_GRAIN, av1fhx.RF_GRAIN_N)
}

fn avif_ref_update(c: u64, mask: i64) {
    var i: usize = 0
    while i < 8 {
        if ((mask >> (i as i64)) & 1) != 0 {
            ref_save(c, i as i64)
        }
        i = i + 1
    }
}

fn avif_ref_show_existing(c: u64, idx: i64) -> bool {
    if idx > 7 || rfg(c, idx, av1fhx.RF_VALID) == 0 {
        return false
    }
    fh(c, FH_FRAME_TYPE, rfg(c, idx, av1fhx.RF_FTYPE))
    if rfg(c, idx, av1fhx.RF_FTYPE) == 0 {
        ref_load(c, idx)
        avif_ref_update(c, 255)
    }
    return true
}

fn parse_film_grain(b: *mut av1bits.Bits, c: u64, ftype: i64) {
    gr(c, GR_APPLY, 1)
    let seed: i64 = av1bits.bits_get(b, 16)
    gr(c, GR_SEED, seed)
    var update: i64 = 1
    if ftype == 1 {
        update = av1bits.bits_get(b, 1)
    }
    if update == 0 {
        let idx: i64 = av1bits.bits_get(b, 3)
        copy_cells(c, GR_BASE, rf_idx(idx, av1fhx.RF_GRAIN), av1fhx.RF_GRAIN_N)
        gr(c, GR_APPLY, 1)
        gr(c, GR_SEED, seed)
        return
    }
    grain_points(b, c, GR_NY, GR_PY)
    let mono: i64 = ld32(c, AI_MONO)
    var cfl: i64 = 0
    if mono == 0 {
        cfl = av1bits.bits_get(b, 1)
    }
    gr(c, GR_CFL, cfl)
    let ny: i64 = ld32(c, GR_BASE + GR_NY)
    if mono != 0 || cfl != 0 || (ld32(c, AI_SUBX) == 1 && ld32(c, AI_SUBY) == 1 && ny == 0) {
        gr(c, GR_NCB, 0)
        gr(c, GR_NCR, 0)
    } else {
        grain_points(b, c, GR_NCB, GR_PCB)
        grain_points(b, c, GR_NCR, GR_PCR)
    }
    gr(c, GR_SCALING, av1bits.bits_get(b, 2))
    let lag: i64 = av1bits.bits_get(b, 2)
    gr(c, GR_LAG, lag)
    let pos_luma: i64 = 2 * lag * (lag + 1)
    var pos_chroma: i64 = pos_luma
    if ny != 0 {
        pos_chroma = pos_luma + 1
        grain_coeffs(b, c, GR_ARY, pos_luma)
    }
    if cfl != 0 || ld32(c, GR_BASE + GR_NCB) != 0 {
        grain_coeffs(b, c, GR_ARCB, pos_chroma)
    }
    if cfl != 0 || ld32(c, GR_BASE + GR_NCR) != 0 {
        grain_coeffs(b, c, GR_ARCR, pos_chroma)
    }
    gr(c, GR_ARSHIFT, av1bits.bits_get(b, 2))
    gr(c, GR_GSHIFT, av1bits.bits_get(b, 2))
    if ld32(c, GR_BASE + GR_NCB) != 0 {
        gr(c, GR_CBMULT, av1bits.bits_get(b, 8))
        gr(c, GR_CBLUMA, av1bits.bits_get(b, 8))
        gr(c, GR_CBOFF, av1bits.bits_get(b, 9))
    }
    if ld32(c, GR_BASE + GR_NCR) != 0 {
        gr(c, GR_CRMULT, av1bits.bits_get(b, 8))
        gr(c, GR_CRLUMA, av1bits.bits_get(b, 8))
        gr(c, GR_CROFF, av1bits.bits_get(b, 9))
    }
    gr(c, GR_OVERLAP, av1bits.bits_get(b, 1))
    gr(c, GR_CLIP, av1bits.bits_get(b, 1))
}

fn parse_frame_hdr(p: u64, n: usize, c: u64) -> bool {
    var b: av1bits.Bits = av1bits.Bits { p: p, n: n, pos: 0 }
    let reduced: i64 = ld32(c, AI_REDUCED)
    var err_res: i64 = 1
    var show: i64 = 1
    var ftype: i64 = 0
    var showable: i64 = 0
    if reduced == 0 {
        if av1bits.bits_get(&b, 1) != 0 {
            let idx: i64 = av1bits.bits_get(&b, 3)
            if ld32(c, AI_DM) != 0 {
                return false
            }
            if ld32(c, AI_FID_LEN) != 0 {
                av1bits.bits_get(&b, ld32(c, AI_FID_LEN) as usize)
            }
            if av1bits.bits_over(&b) {
                return false
            }
            fh(c, FH_SHOW_EXISTING, 1)
            fh(c, FH_SHOW_IDX, idx)
            fh(c, FH_HDR_END, ((b.pos + 7) >> 3) as i64)
            fh(c, FH_OK, 1)
            return true
        }
        ftype = av1bits.bits_get(&b, 2)
        show = av1bits.bits_get(&b, 1)
        if ftype == 3 {
            return false
        }
        if ld32(c, AI_DM) != 0 {
            return false
        }
        if show == 0 {
            showable = av1bits.bits_get(&b, 1)
        } else if ftype != 0 {
            showable = 1
        }
        if ftype == 0 && show == 1 {
            err_res = 1
        } else {
            err_res = av1bits.bits_get(&b, 1)
        }
    }
    fh(c, FH_SHOWABLE, showable)
    fh(c, FH_FRAME_TYPE, ftype)
    fh(c, FH_SHOW, show)
    let dis_cdf: i64 = av1bits.bits_get(&b, 1)
    fh(c, FH_DIS_CDF, dis_cdf)
    var sct: i64 = ld32(c, AI_SEQ_SCT)
    if sct == 2 {
        sct = av1bits.bits_get(&b, 1)
    }
    fh(c, FH_SCT, sct)
    var force_int: i64 = 0
    if sct != 0 {
        force_int = ld32(c, AI_SEQ_FIMV)
        if force_int == 2 {
            force_int = av1bits.bits_get(&b, 1)
        }
    }
    fh(c, av1fhx.FH_FORCE_INT_MV, force_int)
    if ld32(c, AI_FID_LEN) != 0 {
        av1bits.bits_get(&b, ld32(c, AI_FID_LEN) as usize)
    }
    var override: i64 = 0
    if reduced == 0 {
        override = av1bits.bits_get(&b, 1)
    }
    if ld32(c, AI_OH_BITS) != 0 {
        fh(c, FH_ORDER_HINT, av1bits.bits_get(&b, ld32(c, AI_OH_BITS) as usize))
    }
    let intra: bool = ftype == 0 || ftype == 2
    var primary: i64 = av1fhx.PRIMARY_NONE
    if !intra && err_res == 0 {
        primary = av1bits.bits_get(&b, 3)
    }
    fh(c, av1fhx.FH_ERR_RES, err_res)
    fh(c, av1fhx.FH_PRIMARY_REF, primary)
    fh(c, FH_REFRESH_POS, b.pos as i64)
    var refresh: i64 = 255
    if reduced == 0 && !(ftype == 0 && show == 1) {
        refresh = av1bits.bits_get(&b, 8)
    }
    fh(c, FH_REFRESH, refresh)
    if (ftype != 0 || refresh != 255) && err_res != 0 && ld32(c, AI_OH_BITS) != 0 {
        var ri: i64 = 0
        while ri < 8 {
            let roh: i64 = av1bits.bits_get(&b, ld32(c, AI_OH_BITS) as usize)
            if roh != rfg(c, ri, av1fhx.RF_ORDER) || rfg(c, ri, av1fhx.RF_VALID) == 0 {
                rfs(c, ri, av1fhx.RF_ORDER, roh)
                rfs(c, ri, av1fhx.RF_VALID, 0)
            }
            ri = ri + 1
        }
    }
    slot_hints(c)
    var fw: i64 = ld32(c, AI_MAXW)
    var fhh: i64 = ld32(c, AI_MAXH)
    var rw: i64 = 0
    var rh: i64 = 0
    var found: bool = false
    if !intra {
        if !parse_ref_idx(&b, c) {
            return false
        }
        if override != 0 && err_res == 0 {
            var fi: usize = 0
            while fi < 7 && !found {
                if av1bits.bits_get(&b, 1) != 0 {
                    let slot: i64 = fhg(c, av1fhx.FH_REF_IDX + fi)
                    fw = rfg(c, slot, av1fhx.RF_UPW)
                    fhh = rfg(c, slot, av1fhx.RF_FH)
                    rw = rfg(c, slot, av1fhx.RF_RW)
                    rh = rfg(c, slot, av1fhx.RF_RH)
                    found = true
                }
                fi = fi + 1
            }
        }
    }
    if !found && override != 0 {
        fw = av1bits.bits_get(&b, ld32(c, AI_WBITS) as usize) + 1
        fhh = av1bits.bits_get(&b, ld32(c, AI_HBITS) as usize) + 1
    }
    let upw: i64 = fw
    var sr_denom: i64 = 8
    if ld32(c, AI_SUPERRES) != 0 {
        if av1bits.bits_get(&b, 1) != 0 {
            sr_denom = av1bits.bits_get(&b, 3) + 9
            fw = (upw * 8 + sr_denom / 2) / sr_denom
        }
    }
    fh(c, FH_SR_DENOM, sr_denom)
    if !found {
        rw = upw
        rh = fhh
        if av1bits.bits_get(&b, 1) != 0 {
            rw = av1bits.bits_get(&b, 16) + 1
            rh = av1bits.bits_get(&b, 16) + 1
        }
    }
    fh(c, av1fhx.FH_RENDER_W, rw)
    fh(c, av1fhx.FH_RENDER_H, rh)
    var ibc: i64 = 0
    if intra {
        if sct != 0 && upw == fw {
            ibc = av1bits.bits_get(&b, 1)
        }
    } else {
        parse_inter_flags(&b, c, force_int, err_res)
    }
    fh(c, FH_INTRABC, ibc)
    fh(c, FH_FRAME_W, fw)
    fh(c, FH_FRAME_H, fhh)
    fh(c, FH_UP_W, upw)
    let mi_cols: i64 = 2 * ((fw + 7) >> 3)
    let mi_rows: i64 = 2 * ((fhh + 7) >> 3)
    fh(c, FH_MI_COLS, mi_cols)
    fh(c, FH_MI_ROWS, mi_rows)
    fh(c, FH_TILE_POS, b.pos as i64)
    var dfec: i64 = 1
    if reduced == 0 && dis_cdf == 0 {
        dfec = av1bits.bits_get(&b, 1)
    }
    fh(c, av1fhx.FH_DIS_FEC, dfec)
    if !load_previous(c, primary) {
        return false
    }
    var sb_shift: i64 = 4
    if ld32(c, AI_SB128) != 0 {
        sb_shift = 5
    }
    let sb_cols: i64 = (mi_cols + (1 << sb_shift) - 1) >> sb_shift
    let sb_rows: i64 = (mi_rows + (1 << sb_shift) - 1) >> sb_shift
    fh(c, FH_SB_COLS, sb_cols)
    fh(c, FH_SB_ROWS, sb_rows)
    let sb_log2: i64 = sb_shift + 2
    let max_tw_sb: i64 = 4096 >> sb_log2
    var max_ta_sb: i64 = (4096 * 2304) >> (2 * sb_log2)
    let min_l2c: i64 = tile_log2(max_tw_sb, sb_cols)
    let max_l2c: i64 = tile_log2(1, imin(sb_cols, 64))
    let max_l2r: i64 = tile_log2(1, imin(sb_rows, 64))
    let min_l2t: i64 = imax(min_l2c, tile_log2(max_ta_sb, sb_rows * sb_cols))
    var tcl2: i64 = 0
    var trl2: i64 = 0
    var tcols: i64 = 0
    var trows: i64 = 0
    if av1bits.bits_get(&b, 1) != 0 {
        tcl2 = min_l2c
        while tcl2 < max_l2c {
            if av1bits.bits_get(&b, 1) != 0 {
                tcl2 = tcl2 + 1
            } else {
                break
            }
        }
        let tws: i64 = (sb_cols + (1 << tcl2) - 1) >> tcl2
        tcols = (sb_cols + tws - 1) / tws
        var ti: i64 = 0
        while ti < tcols {
            fh(c, FH_TCSTART + (ti as usize), ti * tws)
            ti = ti + 1
        }
        fh(c, FH_TCSTART + (tcols as usize), sb_cols)
        trl2 = imax(min_l2t - tcl2, 0)
        while trl2 < max_l2r {
            if av1bits.bits_get(&b, 1) != 0 {
                trl2 = trl2 + 1
            } else {
                break
            }
        }
        let ths: i64 = (sb_rows + (1 << trl2) - 1) >> trl2
        trows = (sb_rows + ths - 1) / ths
        ti = 0
        while ti < trows {
            fh(c, FH_TRSTART + (ti as usize), ti * ths)
            ti = ti + 1
        }
        fh(c, FH_TRSTART + (trows as usize), sb_rows)
    } else {
        var widest: i64 = 0
        var start: i64 = 0
        while start < sb_cols && tcols < 64 {
            let mw: i64 = imin(sb_cols - start, max_tw_sb)
            let sz: i64 = av1bits.bits_ns(&b, mw) + 1
            widest = imax(sz, widest)
            fh(c, FH_TCSTART + (tcols as usize), start)
            start = start + sz
            tcols = tcols + 1
        }
        fh(c, FH_TCSTART + (tcols as usize), sb_cols)
        tcl2 = tile_log2(1, tcols)
        if min_l2t > 0 {
            max_ta_sb = (sb_rows * sb_cols) >> (min_l2t + 1)
        } else {
            max_ta_sb = sb_rows * sb_cols
        }
        let mth: i64 = imax(max_ta_sb / imax(widest, 1), 1)
        start = 0
        while start < sb_rows && trows < 64 {
            let mh: i64 = imin(sb_rows - start, mth)
            fh(c, FH_TRSTART + (trows as usize), start)
            start = start + av1bits.bits_ns(&b, mh) + 1
            trows = trows + 1
        }
        fh(c, FH_TRSTART + (trows as usize), sb_rows)
        trl2 = tile_log2(1, trows)
    }
    fh(c, FH_TCOLS_LOG2, tcl2)
    fh(c, FH_TROWS_LOG2, trl2)
    fh(c, FH_TCOLS, tcols)
    fh(c, FH_TROWS, trows)
    if tcl2 > 0 || trl2 > 0 {
        fh(c, FH_CTX_TILE, av1bits.bits_get(&b, (tcl2 + trl2) as usize))
        fh(c, FH_TSIZE_BYTES, av1bits.bits_get(&b, 2) + 1)
    }
    let mono: i64 = ld32(c, AI_MONO)
    let planes: i64 = 3 - 2 * mono
    let base_q: i64 = av1bits.bits_get(&b, 8)
    fh(c, FH_BASE_Q, base_q)
    let dqy: i64 = read_delta_q(&b)
    fh(c, FH_DQ_YDC, dqy)
    var dqu: i64 = 128
    var dqua: i64 = 128
    var dqv: i64 = 128
    var dqva: i64 = 128
    if planes > 1 {
        var diff: i64 = 0
        if ld32(c, AI_SEP_UV_DQ) != 0 {
            diff = av1bits.bits_get(&b, 1)
        }
        dqu = read_delta_q(&b)
        dqua = read_delta_q(&b)
        if diff != 0 {
            dqv = read_delta_q(&b)
            dqva = read_delta_q(&b)
        } else {
            dqv = dqu
            dqva = dqua
        }
    }
    fh(c, FH_DQ_UDC, dqu)
    fh(c, FH_DQ_UAC, dqua)
    fh(c, FH_DQ_VDC, dqv)
    fh(c, FH_DQ_VAC, dqva)
    if av1bits.bits_get(&b, 1) != 0 {
        fh(c, FH_QM, 1)
        let qy: i64 = av1bits.bits_get(&b, 4)
        let qu: i64 = av1bits.bits_get(&b, 4)
        var qv: i64 = qu
        if ld32(c, AI_SEP_UV_DQ) != 0 {
            qv = av1bits.bits_get(&b, 4)
        }
        fh(c, FH_QM_Y, qy)
        fh(c, FH_QM_U, qu)
        fh(c, FH_QM_V, qv)
    }
    let seg_en: i64 = av1bits.bits_get(&b, 1)
    fh(c, FH_SEG_EN, seg_en)
    var upd_map: i64 = 1
    var temporal: i64 = 0
    var upd_data: i64 = 1
    if seg_en != 0 && primary != av1fhx.PRIMARY_NONE {
        upd_map = av1bits.bits_get(&b, 1)
        if upd_map != 0 {
            temporal = av1bits.bits_get(&b, 1)
        }
        upd_data = av1bits.bits_get(&b, 1)
    }
    if seg_en != 0 {
        fh(c, av1fhx.FH_SEG_UPD_MAP, upd_map)
        fh(c, av1fhx.FH_SEG_TEMPORAL, temporal)
        fh(c, av1fhx.FH_SEG_UPD_DATA, upd_data)
    }
    if seg_en != 0 && upd_data == 0 {
        load_seg(c, fhg(c, av1fhx.FH_PREV_SLOT))
    }
    if seg_en != 0 && upd_data != 0 {
        var s: usize = 0
        while s < 8 {
            var j: usize = 0
            while j < 8 {
                if av1bits.bits_get(&b, 1) != 0 {
                    var bitsn: usize = 0
                    var sgn: bool = true
                    if j == 0 {
                        bitsn = 8
                    } else if j < 5 {
                        bitsn = 6
                    } else if j == 5 {
                        bitsn = 3
                        sgn = false
                    } else {
                        sgn = false
                    }
                    var v: i64 = 0
                    var lim: i64 = 0
                    if j == 0 {
                        lim = 255
                    } else if j < 5 {
                        lim = 63
                    } else if j == 5 {
                        lim = 7
                    }
                    if bitsn > 0 {
                        if sgn {
                            v = imax(0 - lim, imin(lim, av1bits.bits_su(&b, bitsn + 1)))
                        } else {
                            v = imax(0, imin(lim, av1bits.bits_get(&b, bitsn)))
                        }
                    }
                    st32(c, FH_BASE + FH_SEG_FEAT + s * 8 + j, v + 256)
                    st32(c, FH_BASE + FH_SEG_FEN + s * 8 + j, 1)
                    if j >= 5 {
                        fh(c, FH_SEG_PRESKIP, 1)
                    }
                    if (s as i64) > fhg(c, FH_SEG_LAST) {
                        fh(c, FH_SEG_LAST, s as i64)
                    }
                }
                j = j + 1
            }
            s = s + 1
        }
    }
    var dq_pres: i64 = 0
    if base_q > 0 {
        dq_pres = av1bits.bits_get(&b, 1)
    }
    fh(c, FH_DQ_PRES, dq_pres)
    if dq_pres != 0 {
        fh(c, FH_DQ_RES, av1bits.bits_get(&b, 2))
        if ibc == 0 {
            let dlf: i64 = av1bits.bits_get(&b, 1)
            fh(c, FH_DLF_PRES, dlf)
            if dlf != 0 {
                fh(c, FH_DLF_RES, av1bits.bits_get(&b, 2))
                fh(c, FH_DLF_MULTI, av1bits.bits_get(&b, 1))
            }
        }
    }
    var lossless: i64 = 1
    var s2: usize = 0
    while s2 < 8 {
        var qi: i64 = base_q
        if seg_en != 0 && ld32(c, FH_BASE + FH_SEG_FEN + s2 * 8) != 0 {
            qi = qi + ld32(c, FH_BASE + FH_SEG_FEAT + s2 * 8) - 256
            qi = imax(0, imin(255, qi))
        }
        var seg_ll: i64 = 1
        if qi != 0 || dqy != 128 || dqu != 128 || dqua != 128 || dqv != 128 || dqva != 128 {
            seg_ll = 0
            lossless = 0
        }
        fh(c, FH_SEGQ + s2, seg_ll)
        s2 = s2 + 1
    }
    fh(c, FH_LOSSLESS, lossless)
    if lossless != 0 || ibc != 0 {
        lf_defaults(c)
    }
    if lossless == 0 && ibc == 0 {
        let l0: i64 = av1bits.bits_get(&b, 6)
        let l1: i64 = av1bits.bits_get(&b, 6)
        fh(c, FH_LF0, l0)
        fh(c, FH_LF0 + 1, l1)
        if planes > 1 && (l0 != 0 || l1 != 0) {
            fh(c, FH_LF0 + 2, av1bits.bits_get(&b, 6))
            fh(c, FH_LF0 + 3, av1bits.bits_get(&b, 6))
        }
        fh(c, FH_LF_SHARP, av1bits.bits_get(&b, 3))
        let lde: i64 = av1bits.bits_get(&b, 1)
        fh(c, FH_LF_DELTA_EN, lde)
        if lde != 0 {
            if av1bits.bits_get(&b, 1) != 0 {
                var k: usize = 0
                while k < 8 {
                    if av1bits.bits_get(&b, 1) != 0 {
                        fh(c, av1fhx.FH_LF_REFD + k, av1bits.bits_su(&b, 7) + 128)
                    }
                    k = k + 1
                }
                k = 0
                while k < 2 {
                    if av1bits.bits_get(&b, 1) != 0 {
                        fh(c, av1fhx.FH_LF_MODED + k, av1bits.bits_su(&b, 7) + 128)
                    }
                    k = k + 1
                }
            }
        }
    }
    fh(c, FH_LF_RD0, fhg(c, av1fhx.FH_LF_REFD))
    fh(c, FH_CDEF_DAMP, 3)
    if lossless == 0 && ibc == 0 && ld32(c, AI_CDEF) != 0 {
        fh(c, FH_CDEF_DAMP, av1bits.bits_get(&b, 2) + 3)
        let cb: i64 = av1bits.bits_get(&b, 2)
        fh(c, FH_CDEF_BITS, cb)
        var i: usize = 0
        while i < (1 << cb) as usize {
            fh(c, FH_CDEF_YP + i, av1bits.bits_get(&b, 4))
            var ys: i64 = av1bits.bits_get(&b, 2)
            if ys == 3 {
                ys = 4
            }
            fh(c, FH_CDEF_YS + i, ys)
            if planes > 1 {
                fh(c, FH_CDEF_UVP + i, av1bits.bits_get(&b, 4))
                var us: i64 = av1bits.bits_get(&b, 2)
                if us == 3 {
                    us = 4
                }
                fh(c, FH_CDEF_UVS + i, us)
            }
            i = i + 1
        }
    }
    var all_lossless: i64 = lossless
    if upw != fw {
        all_lossless = 0
    }
    if all_lossless == 0 && ibc == 0 && ld32(c, AI_RESTORATION) != 0 {
        var uses: bool = false
        var uses_c: bool = false
        var pl: usize = 0
        while pl < planes as usize {
            let t: i64 = av1bits.bits_get(&b, 2)
            var ty: i64 = 0
            if t == 1 {
                ty = 3
            } else if t == 2 {
                ty = 1
            } else if t == 3 {
                ty = 2
            }
            fh(c, FH_LR_TYPE + pl, ty)
            if ty != 0 {
                uses = true
                if pl > 0 {
                    uses_c = true
                }
            }
            pl = pl + 1
        }
        if uses {
            var sh: i64 = 0
            if ld32(c, AI_SB128) != 0 {
                sh = av1bits.bits_get(&b, 1) + 1
            } else {
                sh = av1bits.bits_get(&b, 1)
                if sh != 0 {
                    sh = sh + av1bits.bits_get(&b, 1)
                }
            }
            fh(c, FH_LR_UNIT_SHIFT, sh)
            if ld32(c, AI_SUBX) != 0 && ld32(c, AI_SUBY) != 0 && uses_c {
                fh(c, FH_LR_UV_SHIFT, av1bits.bits_get(&b, 1))
            }
        }
    }
    if lossless != 0 {
        fh(c, FH_TX_MODE, 0)
    } else if av1bits.bits_get(&b, 1) != 0 {
        fh(c, FH_TX_MODE, 2)
    } else {
        fh(c, FH_TX_MODE, 1)
    }
    var ref_select: i64 = 0
    if !intra {
        ref_select = av1bits.bits_get(&b, 1)
    }
    fh(c, av1fhx.FH_REF_SELECT, ref_select)
    parse_skip_mode(&b, c, intra, ref_select)
    var warped: i64 = 0
    if !intra && err_res == 0 && (ld32(c, AI_TOOLS) & av1fhx.TOOL_WARPED) != 0 {
        warped = av1bits.bits_get(&b, 1)
    }
    fh(c, av1fhx.FH_WARPED, warped)
    fh(c, FH_REDUCED_TX, av1bits.bits_get(&b, 1))
    if !intra {
        var gprev: usize = FH_BASE + av1fhx.FH_GM_PARAMS
        if primary != av1fhx.PRIMARY_NONE {
            gprev = rf_idx(fhg(c, av1fhx.FH_PREV_SLOT), av1fhx.RF_GM)
        }
        av1gm.gm_parse(&b, c, FH_BASE, gprev, fhg(c, av1fhx.FH_ALLOW_HP))
    }
    if ld32(c, AI_FILM_GRAIN) != 0 && (show != 0 || showable != 0) {
        let g: i64 = av1bits.bits_get(&b, 1)
        fh(c, FH_GRAIN, g)
        if g != 0 {
            parse_film_grain(&b, c, ftype)
        }
    }
    if av1bits.bits_over(&b) {
        return false
    }
    fh(c, FH_HDR_BITS, b.pos as i64)
    fh(c, FH_HDR_END, ((b.pos + 7) >> 3) as i64)
    fh(c, FH_OK, 1)
    return true
}

fn obu_extent(p: u64, n: usize, at: usize) -> i64 {
    if at >= n {
        return -1
    }
    let h: i64 = rd8(p, at)
    let ext: i64 = (h >> 2) & 1
    let has_size: i64 = (h >> 1) & 1
    var q: usize = at + 1 + (ext as usize)
    var sz: usize = 0
    if has_size != 0 {
        var k: usize = 0
        var v: i64 = 0
        while k < 8 {
            if q >= n {
                return -1
            }
            let by: i64 = rd8(p, q)
            q = q + 1
            v = v | ((by & 127) << (7 * k))
            k = k + 1
            if (by & 128) == 0 {
                break
            }
        }
        sz = v as usize
    } else {
        sz = n - q
    }
    if q > n || sz > n - q {
        return -1
    }
    return ((q as i64) << 32) | (sz as i64)
}

fn walk_obus(p: u64, n: usize, c: u64) -> bool {
    var at: usize = 0
    var got: bool = false
    while at < n {
        let e: i64 = obu_extent(p, n, at)
        if e < 0 {
            return got
        }
        let typ: i64 = (rd8(p, at) >> 3) & 15
        let q: usize = (e >> 32) as usize
        let sz: usize = ((e << 32) >> 32) as usize
        if typ == 1 {
            st32(c, AI_OBU_SEQ, ld32(c, AI_OBU_SEQ) + 1)
            if !got {
                if parse_seq_hdr(p + q as u64, sz, c) {
                    got = true
                } else {
                    return false
                }
            }
        }
        if typ == 3 || typ == 6 {
            st32(c, AI_OBU_FRAME, ld32(c, AI_OBU_FRAME) + 1)
            if ld32(c, AI_OBU_FRAME) == 1 && got {
                fh(c, FH_TYPE, typ)
                fh(c, FH_OBU_OFF, q as i64)
                fh(c, FH_OBU_LEN, sz as i64)
                parse_frame_hdr(p + q as u64, sz, c)
            }
        }
        if typ == 4 || typ == 6 {
            st32(c, AI_OBU_TILE, ld32(c, AI_OBU_TILE) + 1)
        }
        at = q + sz
    }
    return got
}

fn avif_set_cell(info: u64, i: usize, v: i64) {
    st32(info, i, v)
}

fn avif_obu_open(src: u64, n: usize) -> u64 {
    G_AR = AR_OK
    G_N = n
    let c: u64 = av1mem.heap_alloc(CELLS * 4) as u64
    if c == 0 {
        G_AR = AR_MEMORY
        return 0
    }
    st32(c, AI_BRAND_OK, 1)
    var at: usize = 0
    while at < n {
        let e: i64 = obu_extent(src, n, at)
        if e < 0 {
            break
        }
        let q: usize = (e >> 32) as usize
        let sz: usize = ((e << 32) >> 32) as usize
        if ((rd8(src, at) >> 3) & 15) == 1 {
            if parse_seq_hdr(src + q as u64, sz, c) {
                st32(c, AI_PRIM_OFF, 0)
                return c
            }
            break
        }
        at = q + sz
    }
    G_AR = AR_NO_SEQHDR
    avif_info_free(c)
    return 0
}

fn avif_obu_next(src: u64, n: usize, c: u64, at: usize) -> i64 {
    G_N = n
    let e: i64 = obu_extent(src, n, at)
    if e < 0 {
        return -1
    }
    let typ: i64 = (rd8(src, at) >> 3) & 15
    let q: usize = (e >> 32) as usize
    let sz: usize = ((e << 32) >> 32) as usize
    if typ == 3 || typ == 6 {
        var i: usize = FH_BASE
        while i < GR_BASE {
            st32(c, i, 0)
            i = i + 1
        }
        while i < av1fhx.RF_BASE {
            st32(c, i, 0)
            i = i + 1
        }
        fh(c, FH_NEW_FRAME, 1)
        fh(c, FH_TYPE, typ)
        fh(c, FH_OBU_OFF, q as i64)
        fh(c, FH_OBU_LEN, sz as i64)
        parse_frame_hdr(src + q as u64, sz, c)
    } else {
        fh(c, FH_NEW_FRAME, 0)
        if typ == 4 {
            fh(c, av1fhx.FH_TG_COUNT, fhg(c, av1fhx.FH_TG_COUNT) + 1)
            if fhg(c, av1fhx.FH_TG_COUNT) == 1 {
                fh(c, av1fhx.FH_TG_OFF, q as i64)
                fh(c, av1fhx.FH_TG_LEN, sz as i64)
            }
        }
    }
    return (q + sz) as i64
}

fn avif_obu_kind(src: u64, n: usize, at: usize) -> i64 {
    G_N = n
    if obu_extent(src, n, at) < 0 {
        return -1
    }
    return (rd8(src, at) >> 3) & 15
}

fn avif_parse(src: u64, n: usize) -> u64 {
    G_AR = AR_OK
    G_N = n
    if !avif_sniff(src, n) {
        G_AR = AR_NOT_AVIF
        return 0
    }
    if n > 2000000000 {
        G_AR = AR_TOO_BIG
        return 0
    }
    let c: u64 = av1mem.heap_alloc(CELLS * 4) as u64
    if c == 0 {
        G_AR = AR_MEMORY
        return 0
    }
    st32(c, AI_BRAND_OK, 1)
    var at: usize = 0
    while at + 8 <= n {
        let e: usize = box_end(src, at, n)
        if e == 0 {
            break
        }
        if be32(src, at + 4) == FT_META {
            parse_meta(src, c, at + box_hdr(src, at) + 4, e)
        }
        at = e
    }
    let pid: i64 = ld32(c, AI_PRIMARY_ID)
    let pi: i64 = find_item(c, pid)
    if pid == 0 || pi < 0 {
        G_AR = AR_NO_PRIMARY
        avif_info_free(c)
        return 0
    }
    let ib: usize = IT_BASE + (pi as usize) * 8
    let ptype: i64 = ld32(c, ib + 1)
    st32(c, AI_PRIM_TYPE, ptype)
    st32(c, AI_PRIM_OFF, ld32(c, ib + 2))
    st32(c, AI_PRIM_LEN, ld32(c, ib + 3))
    st32(c, AI_ITEM_CM, ld32(c, ib + 4))
    st32(c, AI_ITEM_EXT, ld32(c, ib + 5))
    let ispe: i64 = item_prop(c, pid, FT_ISPE)
    if ispe >= 0 {
        let o: usize = ld32(c, PR_BASE + (ispe as usize) * 8 + 1) as usize
        st32(c, AI_ISPE_W, be32(src, o + 4))
        st32(c, AI_ISPE_H, be32(src, o + 8))
        st32(c, AI_WIDTH, be32(src, o + 4))
        st32(c, AI_HEIGHT, be32(src, o + 8))
    }
    let colr: i64 = item_prop(c, pid, FT_COLR)
    if colr >= 0 {
        let o: usize = ld32(c, PR_BASE + (colr as usize) * 8 + 1) as usize
        if be32(src, o) == FT_NCLX {
            st32(c, AI_COLR, 1)
            st32(c, AI_FULL_RANGE, (rd8(src, o + 10) >> 7) & 1)
        } else {
            st32(c, AI_COLR, 2)
        }
    }
    let pixi: i64 = item_prop(c, pid, FT_PIXI)
    if pixi >= 0 {
        let o: usize = ld32(c, PR_BASE + (pixi as usize) * 8 + 1) as usize
        st32(c, AI_NPLANES, rd8(src, o + 4))
        st32(c, AI_PIXI_BITS, rd8(src, o + 5))
    }
    let a1c: i64 = item_prop(c, pid, FT_AV1C)
    if a1c >= 0 {
        let o: usize = ld32(c, PR_BASE + (a1c as usize) * 8 + 1) as usize
        st32(c, AI_AV1C_PROFILE, rd8(src, o + 1) >> 5)
        st32(c, AI_AV1C_LEVEL, rd8(src, o + 1) & 31)
    }
    let ir: i64 = item_prop(c, pid, FT_IROT)
    if ir >= 0 {
        let o: usize = ld32(c, PR_BASE + (ir as usize) * 8 + 1) as usize
        st32(c, AI_IROT, 1 + (rd8(src, o) & 3))
    }
    let im: i64 = item_prop(c, pid, FT_IMIR)
    if im >= 0 {
        let o: usize = ld32(c, PR_BASE + (im as usize) * 8 + 1) as usize
        st32(c, AI_IMIR, 1 + (rd8(src, o) & 1))
    }
    let ni: usize = ld32(c, AI_N_ITEMS) as usize
    var i: usize = 0
    while i < ni {
        let id: i64 = ld32(c, IT_BASE + i * 8)
        if id != pid && ld32(c, IT_BASE + i * 8 + 1) == FT_AV01 {
            let ax: i64 = item_prop(c, id, FT_AUXC)
            if ax >= 0 && auxc_is_alpha(src, c, ax as usize) {
                st32(c, AI_ALPHA_ID, id)
                st32(c, AI_ALPHA_OFF, ld32(c, IT_BASE + i * 8 + 2))
                st32(c, AI_ALPHA_LEN, ld32(c, IT_BASE + i * 8 + 3))
                break
            }
        }
        i = i + 1
    }
    if ptype != FT_AV01 || ld32(c, AI_ITEM_CM) != 0 || ld32(c, AI_ITEM_EXT) != 1 {
        G_AR = AR_UNSUPPORTED
        return c
    }
    let po: usize = ld32(c, AI_PRIM_OFF) as usize
    let pl: usize = ld32(c, AI_PRIM_LEN) as usize
    if po > n || pl > n - po {
        G_AR = AR_TRUNCATED
        return c
    }
    if !walk_obus(src + po as u64, pl, c) {
        G_AR = AR_NO_SEQHDR
        return c
    }
    return c
}
