const GR_PCR: usize = 54
const GR_SCALING: usize = 74
const GR_LAG: usize = 75
const GR_ARY: usize = 76
const GR_ARCB: usize = 100
const GR_ARCR: usize = 125
const GR_ARSHIFT: usize = 150
const GR_GSHIFT: usize = 151
const GR_CBMULT: usize = 152
const GR_CBLUMA: usize = 153
const GR_CBOFF: usize = 154
const GR_CRMULT: usize = 155
const GR_CRLUMA: usize = 156
const GR_CROFF: usize = 157
const GR_OVERLAP: usize = 158
const GR_CLIP: usize = 159

const CELLS: usize = 2300

#[no_gc]
fn ld32(p: u64, i: usize) -> i64 {
    return (*((p + (i * 4) as u64) as *mut u32)) as i64
}

#[no_gc]
fn st32(p: u64, i: usize, v: i64) {
    *((p + (i * 4) as u64) as *mut u32) = (v & 4294967295) as u32
}

#[no_gc]
fn rd8(p: u64, i: usize) -> i64 {
    if i >= G_N {
        return 0
    }
    return (*((p + i as u64) as *mut u8)) as i64
}

fn be16(p: u64, i: usize) -> i64 {
    return (rd8(p, i) << 8) | rd8(p, i + 1)
}

fn be32(p: u64, i: usize) -> i64 {
    return (rd8(p, i) << 24) | (rd8(p, i + 1) << 16) | (rd8(p, i + 2) << 8) | rd8(p, i + 3)
}

fn be_n(p: u64, i: usize, w: usize) -> i64 {
    var v: i64 = 0
    var k: usize = 0
    while k < w {
        v = (v << 8) | rd8(p, i + k)
        k = k + 1
    }
    return v
}

fn avif_cell(info: u64, i: usize) -> i64 {
    return ld32(info, i)
}

fn avif_info_free(info: u64) {
    if info != 0 {
        av1mem.heap_free(info as *mut u8, CELLS * 4)
    }
}

fn avif_sniff(p: u64, n: usize) -> bool {
    if n < 16 {
        return false
    }
    G_N = n
    if be32(p, 4) != FT_FTYP {
        return false
    }
    var sz: usize = be32(p, 0) as usize
    if sz > n || sz < 16 {
        sz = n
    }
    let major: i64 = be32(p, 8)
    if major == FT_AVIF || major == FT_AVIS {
        return true
    }
    var at: usize = 16
    while at + 4 <= sz {
        let b: i64 = be32(p, at)
        if b == FT_AVIF || b == FT_AVIS {
            return true
        }
        at = at + 4
    }
    return false
}

fn box_hdr(p: u64, at: usize) -> usize {
    if be32(p, at) == 1 {
        return 16
    }
    return 8
}

fn box_end(p: u64, at: usize, lim: usize) -> usize {
    if at + 8 > lim {
        return 0
    }
    let s: i64 = be32(p, at)
    var sz: usize = s as usize
    if s == 1 {
        if be32(p, at + 8) != 0 {
            return 0
        }
        sz = be32(p, at + 12) as usize
    } else if s == 0 {
        sz = lim - at
    }
    let h: usize = box_hdr(p, at)
    if sz < h || at + sz > lim {
        return 0
    }
    return at + sz
}

fn find_item(c: u64, id: i64) -> i64 {
    let n: usize = ld32(c, AI_N_ITEMS) as usize
    var i: usize = 0
    while i < n {
        if ld32(c, IT_BASE + i * 8) == id {
            return i as i64
        }
        i = i + 1
    }
    return -1
}

fn item_slot(c: u64, id: i64) -> i64 {
    let f: i64 = find_item(c, id)
    if f >= 0 {
        return f
    }
    let n: usize = ld32(c, AI_N_ITEMS) as usize
    if n >= MAX_ITEMS {
        return -1
    }
    st32(c, IT_BASE + n * 8, id)
    st32(c, AI_N_ITEMS, (n + 1) as i64)
    return n as i64
}

fn parse_iloc(p: u64, c: u64, at: usize, end: usize) {
    let ver: i64 = rd8(p, at)
    var q: usize = at + 4
    let b1: i64 = rd8(p, q)
    let b2: i64 = rd8(p, q + 1)
    q = q + 2
    let osz: usize = (b1 >> 4) as usize
    let lsz: usize = (b1 & 15) as usize
    let bsz: usize = (b2 >> 4) as usize
    var isz: usize = 0
    if ver == 1 || ver == 2 {
        isz = (b2 & 15) as usize
    }
    var cnt: i64 = 0
    if ver < 2 {
        cnt = be16(p, q)
        q = q + 2
    } else {
        cnt = be32(p, q)
        q = q + 4
    }
    var k: i64 = 0
    while k < cnt && q < end {
        var id: i64 = 0
        if ver < 2 {
            id = be16(p, q)
            q = q + 2
        } else {
            id = be32(p, q)
            q = q + 4
        }
        var cm: i64 = 0
        if ver == 1 || ver == 2 {
            cm = be16(p, q) & 15
            q = q + 2
        }
        q = q + 2
        let base: i64 = be_n(p, q, bsz)
        q = q + bsz
        let ne: i64 = be16(p, q)
        q = q + 2
        var off: i64 = 0
        var len: i64 = 0
        var e: i64 = 0
        while e < ne && q < end {
            q = q + isz
            let o: i64 = be_n(p, q, osz)
            q = q + osz
            let l: i64 = be_n(p, q, lsz)
            q = q + lsz
            if e == 0 {
                off = base + o
                len = l
            }
            e = e + 1
        }
        let s: i64 = item_slot(c, id)
        if s >= 0 {
            let b: usize = IT_BASE + (s as usize) * 8
            st32(c, b + 2, off)
            st32(c, b + 3, len)
            st32(c, b + 4, cm)
            st32(c, b + 5, ne)
        }
        k = k + 1
    }
}

fn parse_iinf(p: u64, c: u64, at: usize, end: usize) {
    let ver: i64 = rd8(p, at)
    var q: usize = at + 4
    if ver == 0 {
        q = q + 2
    } else {
        q = q + 4
    }
    while q + 8 <= end {
        let e: usize = box_end(p, q, end)
        if e == 0 {
            return
        }
        if be32(p, q + 4) == FT_INFE {
            let b: usize = q + box_hdr(p, q)
            let v: i64 = rd8(p, b)
            if v >= 2 {
                var id: i64 = 0
                var r: usize = b + 4
                if v == 2 {
                    id = be16(p, r)
                    r = r + 2
                } else {
                    id = be32(p, r)
                    r = r + 4
                }
                r = r + 2
                let s: i64 = item_slot(c, id)
                if s >= 0 {
                    st32(c, IT_BASE + (s as usize) * 8 + 1, be32(p, r))
                }
            }
        }
        q = e
    }
}

fn parse_ipco(p: u64, c: u64, at: usize, end: usize) {
    var q: usize = at
    while q + 8 <= end {
        let e: usize = box_end(p, q, end)
        if e == 0 {
            return
        }
        let n: usize = ld32(c, AI_N_PROPS) as usize
        if n < MAX_PROPS {
            let b: usize = PR_BASE + n * 8
            let h: usize = box_hdr(p, q)
            st32(c, b, be32(p, q + 4))
            st32(c, b + 1, (q + h) as i64)
            st32(c, b + 2, (e - q - h) as i64)
            st32(c, AI_N_PROPS, (n + 1) as i64)
        }
        q = e
    }
}

fn parse_ipma(p: u64, c: u64, at: usize, end: usize) {
    let ver: i64 = rd8(p, at)
    let fl: i64 = be32(p, at) & 16777215
    var q: usize = at + 4
    let cnt: i64 = be32(p, q)
    q = q + 4
    var k: i64 = 0
    while k < cnt && q < end {
        var id: i64 = 0
        if ver < 1 {
            id = be16(p, q)
            q = q + 2
        } else {
            id = be32(p, q)
            q = q + 4
        }
        let na: i64 = rd8(p, q)
        q = q + 1
        var j: i64 = 0
        while j < na && q < end {
            var pi: i64 = 0
            if (fl & 1) != 0 {
                pi = be16(p, q) & 32767
                q = q + 2
            } else {
                pi = rd8(p, q) & 127
                q = q + 1
            }
            let n: usize = ld32(c, AI_N_ASSOC) as usize
            if n < MAX_ASSOC {
                st32(c, AS_BASE + n * 2, id)
                st32(c, AS_BASE + n * 2 + 1, pi)
                st32(c, AI_N_ASSOC, (n + 1) as i64)
            }
            j = j + 1
        }
        k = k + 1
    }
}

fn parse_iprp(p: u64, c: u64, at: usize, end: usize) {
    var q: usize = at
    while q + 8 <= end {
        let e: usize = box_end(p, q, end)
        if e == 0 {
            return
        }
        let t: i64 = be32(p, q + 4)
        let b: usize = q + box_hdr(p, q)
        if t == FT_IPCO {
            parse_ipco(p, c, b, e)
        }
        if t == FT_IPMA {
            parse_ipma(p, c, b, e)
        }
        q = e
    }
}

fn parse_meta(p: u64, c: u64, at: usize, end: usize) {
    var q: usize = at
    while q + 8 <= end {
        let e: usize = box_end(p, q, end)
        if e == 0 {
            return
        }
        let t: i64 = be32(p, q + 4)
        let b: usize = q + box_hdr(p, q)
        if t == FT_PITM {
            if rd8(p, b) == 0 {
                st32(c, AI_PRIMARY_ID, be16(p, b + 4))
            } else {
                st32(c, AI_PRIMARY_ID, be32(p, b + 4))
            }
        }
        if t == FT_ILOC {
            parse_iloc(p, c, b, e)
        }
        if t == FT_IINF {
            parse_iinf(p, c, b, e)
        }
        if t == FT_IPRP {
            parse_iprp(p, c, b, e)
        }
        q = e
    }
}

fn item_prop(c: u64, id: i64, t: i64) -> i64 {
    let na: usize = ld32(c, AI_N_ASSOC) as usize
    let np: usize = ld32(c, AI_N_PROPS) as usize
    var j: usize = 0
    while j < na {
        if ld32(c, AS_BASE + j * 2) == id {
            let pi: i64 = ld32(c, AS_BASE + j * 2 + 1)
            if pi >= 1 && (pi as usize) <= np {
                let k: usize = (pi - 1) as usize
                if ld32(c, PR_BASE + k * 8) == t {
                    return k as i64
                }
            }
        }
        j = j + 1
    }
    return -1
}

fn auxc_is_alpha(p: u64, c: u64, k: usize) -> bool {
    let off: usize = ld32(c, PR_BASE + k * 8 + 1) as usize
    var len: usize = ld32(c, PR_BASE + k * 8 + 2) as usize
    if len < 10 {
        return false
    }
    len = len - 4
    var i: usize = off + 4
    let stop: usize = off + 4 + len
    while i + 5 <= stop {
        if rd8(p, i) == 97 && rd8(p, i + 1) == 108 && rd8(p, i + 2) == 112 && rd8(p, i + 3) == 104
            && rd8(p, i + 4) == 97 {
            return true
        }
        i = i + 1
    }
    return false
}

struct Bits {
    p: u64,
    n: usize,
    pos: usize,
}

fn bits_get(b: *mut Bits, k: usize) -> i64 {
    var v: i64 = 0
    var i: usize = 0
    while i < k {
        let by: usize = (*b).pos >> 3
        var bit: i64 = 0
        if by < (*b).n {
            let o: i64 = (*(((*b).p + by as u64) as *mut u8)) as i64
            bit = (o >> (7 - ((*b).pos & 7)) as i64) & 1
        }
        v = (v << 1) | bit
        (*b).pos = (*b).pos + 1
        i = i + 1
    }
    return v
}

fn bits_over(b: *mut Bits) -> bool {
    return (*b).pos > (*b).n * 8
}

fn bits_uvlc(b: *mut Bits) -> i64 {
    var lz: usize = 0
    while lz < 32 && !bits_over(b) {
        if bits_get(b, 1) != 0 {
            break
        }
        lz = lz + 1
    }
    if lz >= 32 {
        return 4294967295
    }
    return bits_get(b, lz) + (1 << lz) - 1
}

fn parse_seq_hdr(p: u64, n: usize, c: u64) -> bool {
    var b: Bits = Bits { p: p, n: n, pos: 0 }
    let sprof: i64 = bits_get(&b, 3)
    let still: i64 = bits_get(&b, 1)
    let reduced: i64 = bits_get(&b, 1)
    st32(c, AI_SEQ_PROFILE, sprof)
    st32(c, AI_STILL, still)
    st32(c, AI_REDUCED, reduced)
    if sprof > 2 {
        return false
    }
    var dm_present: i64 = 0
    var buf_delay_len: usize = 0
    if reduced != 0 {
        st32(c, AI_SEQ_LEVEL, bits_get(&b, 5))
    } else {
        let timing: i64 = bits_get(&b, 1)
        st32(c, AI_TIMING, timing)
        if timing != 0 {
            bits_get(&b, 32)
            bits_get(&b, 32)
            if bits_get(&b, 1) != 0 {
                bits_uvlc(&b)
            }
            dm_present = bits_get(&b, 1)
            st32(c, AI_DM, dm_present)
            if dm_present != 0 {
                buf_delay_len = (bits_get(&b, 5) + 1) as usize
                bits_get(&b, 32)
                bits_get(&b, 5)
                bits_get(&b, 5)
            }
        }
        let idd: i64 = bits_get(&b, 1)
        let nop: i64 = bits_get(&b, 5) + 1
        var i: i64 = 0
        while i < nop {
            bits_get(&b, 12)
            let lvl: i64 = bits_get(&b, 5)
            if i == 0 {
                st32(c, AI_SEQ_LEVEL, lvl)
            }
            if lvl > 7 {
                bits_get(&b, 1)
            }
            if dm_present != 0 {
                if bits_get(&b, 1) != 0 {
                    bits_get(&b, buf_delay_len)
                    bits_get(&b, buf_delay_len)
                    bits_get(&b, 1)
                }
            }
            if idd != 0 {
                if bits_get(&b, 1) != 0 {
                    bits_get(&b, 4)
                }
            }
            i = i + 1
        }
    }
    let wb: usize = (bits_get(&b, 4) + 1) as usize
    let hb: usize = (bits_get(&b, 4) + 1) as usize
    st32(c, AI_WBITS, wb as i64)
    st32(c, AI_HBITS, hb as i64)
    st32(c, AI_MAXW, bits_get(&b, wb) + 1)
    st32(c, AI_MAXH, bits_get(&b, hb) + 1)
    st32(c, AI_SEQ_SCT, 2)
    st32(c, AI_SEQ_FIMV, 2)
    if reduced == 0 {
        if bits_get(&b, 1) != 0 {
            let d: i64 = bits_get(&b, 4) + 2
            let a: i64 = bits_get(&b, 3) + 1
            st32(c, AI_FID_LEN, d + a)
        }
    }
    st32(c, AI_SB128, bits_get(&b, 1))
    st32(c, AI_FILTER_INTRA, bits_get(&b, 1))
    st32(c, AI_EDGE_FILTER, bits_get(&b, 1))
    if reduced == 0 {
        bits_get(&b, 4)
        let order_hint: i64 = bits_get(&b, 1)
        if order_hint != 0 {
            bits_get(&b, 2)
        }
        var sct: i64 = 2
        if bits_get(&b, 1) == 0 {
            sct = bits_get(&b, 1)
        }
        st32(c, AI_SEQ_SCT, sct)
        var fimv: i64 = 2
        if sct > 0 {
            if bits_get(&b, 1) == 0 {
                fimv = bits_get(&b, 1)
            }
        }
        st32(c, AI_SEQ_FIMV, fimv)
        if order_hint != 0 {
            st32(c, AI_OH_BITS, bits_get(&b, 3) + 1)
        }
    }
    st32(c, AI_SUPERRES, bits_get(&b, 1))
    st32(c, AI_CDEF, bits_get(&b, 1))
    st32(c, AI_RESTORATION, bits_get(&b, 1))
    let high: i64 = bits_get(&b, 1)
    var depth: i64 = 8
    if sprof == 2 && high != 0 {
        if bits_get(&b, 1) != 0 {
            depth = 12
        } else {
            depth = 10
        }
    } else if high != 0 {
        depth = 10
    }
    st32(c, AI_BITDEPTH, depth)
    var mono: i64 = 0
    if sprof != 1 {
        mono = bits_get(&b, 1)
    }
    st32(c, AI_MONO, mono)
    var cp: i64 = 2
    var tc: i64 = 2
    var mc: i64 = 2
    if bits_get(&b, 1) != 0 {
        cp = bits_get(&b, 8)
        tc = bits_get(&b, 8)
        mc = bits_get(&b, 8)
    }
    st32(c, AI_CP, cp)
    st32(c, AI_TC, tc)
    st32(c, AI_MC, mc)
    var sx: i64 = 1
    var sy: i64 = 1
    if mono != 0 {
        st32(c, AI_FULL_RANGE, bits_get(&b, 1))
    } else if cp == 1 && tc == 13 && mc == 0 {
        st32(c, AI_FULL_RANGE, 1)
        sx = 0
        sy = 0
        st32(c, AI_SEP_UV_DQ, bits_get(&b, 1))
    } else {
        st32(c, AI_FULL_RANGE, bits_get(&b, 1))
        if sprof == 0 {
            sx = 1
            sy = 1
        } else if sprof == 1 {
            sx = 0
            sy = 0
        } else if depth == 12 {
            sx = bits_get(&b, 1)
            sy = 0
            if sx != 0 {
                sy = bits_get(&b, 1)
            }
        } else {
            sx = 1
            sy = 0
        }
        if sx != 0 && sy != 0 {
            st32(c, AI_CHROMA_POS, bits_get(&b, 2))
        }
        st32(c, AI_SEP_UV_DQ, bits_get(&b, 1))
    }
    st32(c, AI_SUBX, sx)
    st32(c, AI_SUBY, sy)
    st32(c, AI_FILM_GRAIN, bits_get(&b, 1))
    if bits_over(&b) {
        return false
    }
    return true
}

fn bits_su(b: *mut Bits, n: usize) -> i64 {
    var v: i64 = bits_get(b, n)
    let m: i64 = 1 << (n - 1)
    if (v & m) != 0 {
        v = v - 2 * m
    }
    return v
}

fn bits_ns(b: *mut Bits, n: i64) -> i64 {
    if n <= 1 {
        return 0
    }
    var w: usize = 0
    var x: i64 = n
    while x != 0 {
        x = x >> 1
        w = w + 1
    }
    let m: i64 = (1 << w) - n
    let v: i64 = bits_get(b, w - 1)
    if v < m {
        return v
    }
    return (v << 1) - m + bits_get(b, 1)
}

fn tile_log2(blk: i64, target: i64) -> i64 {
    var k: i64 = 0
    while (blk << k) < target {
        k = k + 1
    }
    return k
}

fn imin(a: i64, b: i64) -> i64 {
    if a < b {
        return a
    }
    return b
}

fn imax(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    }
    return b
}

fn fh(c: u64, i: usize, v: i64) {
    st32(c, FH_BASE + i, v & 4294967295)
}

fn fhg(c: u64, i: usize) -> i64 {
    return ld32(c, FH_BASE + i)
}

fn read_delta_q(b: *mut Bits) -> i64 {
    if bits_get(b, 1) != 0 {
        return bits_su(b, 7) + 128
    }
    return 128
}

fn gr(c: u64, i: usize, v: i64) {
    st32(c, GR_BASE + i, v & 4294967295)
}

fn grain_points(b: *mut Bits, c: u64, count_idx: usize, base: usize) {
    let n: i64 = bits_get(b, 4)
    gr(c, count_idx, n)
    var i: i64 = 0
    while i < n && i < 14 {
        gr(c, base + (i as usize) * 2, bits_get(b, 8))
        gr(c, base + (i as usize) * 2 + 1, bits_get(b, 8))
        i = i + 1
    }
}

fn grain_coeffs(b: *mut Bits, c: u64, base: usize, n: i64) {
    var i: i64 = 0
    while i < n {
        gr(c, base + (i as usize), bits_get(b, 8))
        i = i + 1
    }
}

fn parse_film_grain(b: *mut Bits, c: u64) {
    gr(c, GR_APPLY, 1)
    gr(c, GR_SEED, bits_get(b, 16))
    grain_points(b, c, GR_NY, GR_PY)
    let mono: i64 = ld32(c, AI_MONO)
    var cfl: i64 = 0
    if mono == 0 {
        cfl = bits_get(b, 1)
    }
    gr(c, GR_CFL, cfl)
    let ny: i64 = ld32(c, GR_BASE + GR_NY)
    if mono != 0 || cfl != 0 || (ld32(c, AI_SUBX) == 1 && ld32(c, AI_SUBY) == 1 && ny == 0) {
        gr(c, GR_NCB, 0)
        gr(c, GR_NCR, 0)
    } else {
        grain_points(b, c, GR_NCB, GR_PCB)
        grain_points(b, c, GR_NCR, GR_PCR)
    }
    gr(c, GR_SCALING, bits_get(b, 2))
    let lag: i64 = bits_get(b, 2)
    gr(c, GR_LAG, lag)
    let pos_luma: i64 = 2 * lag * (lag + 1)
    var pos_chroma: i64 = pos_luma
    if ny != 0 {
        pos_chroma = pos_luma + 1
        grain_coeffs(b, c, GR_ARY, pos_luma)
    }
    if cfl != 0 || ld32(c, GR_BASE + GR_NCB) != 0 {
        grain_coeffs(b, c, GR_ARCB, pos_chroma)
    }
    if cfl != 0 || ld32(c, GR_BASE + GR_NCR) != 0 {
        grain_coeffs(b, c, GR_ARCR, pos_chroma)
    }
    gr(c, GR_ARSHIFT, bits_get(b, 2))
    gr(c, GR_GSHIFT, bits_get(b, 2))
    if ld32(c, GR_BASE + GR_NCB) != 0 {
        gr(c, GR_CBMULT, bits_get(b, 8))
        gr(c, GR_CBLUMA, bits_get(b, 8))
        gr(c, GR_CBOFF, bits_get(b, 9))
    }
    if ld32(c, GR_BASE + GR_NCR) != 0 {
        gr(c, GR_CRMULT, bits_get(b, 8))
        gr(c, GR_CRLUMA, bits_get(b, 8))
        gr(c, GR_CROFF, bits_get(b, 9))
    }
    gr(c, GR_OVERLAP, bits_get(b, 1))
    gr(c, GR_CLIP, bits_get(b, 1))
}

fn parse_frame_hdr(p: u64, n: usize, c: u64) -> bool {
    var b: Bits = Bits { p: p, n: n, pos: 0 }
    let reduced: i64 = ld32(c, AI_REDUCED)
    var err_res: i64 = 1
    var show: i64 = 1
    var ftype: i64 = 0
    if reduced == 0 {
        if bits_get(&b, 1) != 0 {
            return false
        }
        ftype = bits_get(&b, 2)
        show = bits_get(&b, 1)
        if ftype != 0 || show == 0 {
            return false
        }
        if ld32(c, AI_DM) != 0 {
            return false
        }
    }
    fh(c, FH_FRAME_TYPE, ftype)
    fh(c, FH_SHOW, show)
    let dis_cdf: i64 = bits_get(&b, 1)
    fh(c, FH_DIS_CDF, dis_cdf)
    var sct: i64 = ld32(c, AI_SEQ_SCT)
    if sct == 2 {
        sct = bits_get(&b, 1)
    }
    fh(c, FH_SCT, sct)
    if sct != 0 {
        if ld32(c, AI_SEQ_FIMV) == 2 {
            bits_get(&b, 1)
        }
    }
    if ld32(c, AI_FID_LEN) != 0 {
        bits_get(&b, ld32(c, AI_FID_LEN) as usize)
    }
    var override: i64 = 0
    if reduced == 0 {
        override = bits_get(&b, 1)
    }
    if ld32(c, AI_OH_BITS) != 0 {
        bits_get(&b, ld32(c, AI_OH_BITS) as usize)
    }
    var fw: i64 = ld32(c, AI_MAXW)
    var fhh: i64 = ld32(c, AI_MAXH)
    if override != 0 {
        fw = bits_get(&b, ld32(c, AI_WBITS) as usize) + 1
        fhh = bits_get(&b, ld32(c, AI_HBITS) as usize) + 1
    }
    let upw: i64 = fw
    var sr_denom: i64 = 8
    if ld32(c, AI_SUPERRES) != 0 {
        if bits_get(&b, 1) != 0 {
            sr_denom = bits_get(&b, 3) + 9
            fw = (upw * 8 + sr_denom / 2) / sr_denom
        }
    }
    fh(c, FH_SR_DENOM, sr_denom)
    if bits_get(&b, 1) != 0 {
        bits_get(&b, 32)
    }
    var ibc: i64 = 0
    if sct != 0 && upw == fw {
        ibc = bits_get(&b, 1)
    }
    fh(c, FH_INTRABC, ibc)
    fh(c, FH_FRAME_W, fw)
    fh(c, FH_FRAME_H, fhh)
    fh(c, FH_UP_W, upw)
    let mi_cols: i64 = 2 * ((fw + 7) >> 3)
    let mi_rows: i64 = 2 * ((fhh + 7) >> 3)
    fh(c, FH_MI_COLS, mi_cols)
    fh(c, FH_MI_ROWS, mi_rows)
    if reduced != 0 || dis_cdf != 0 {
    } else {
        bits_get(&b, 1)
    }
    var sb_shift: i64 = 4
    if ld32(c, AI_SB128) != 0 {
        sb_shift = 5
    }
    let sb_cols: i64 = (mi_cols + (1 << sb_shift) - 1) >> sb_shift
    let sb_rows: i64 = (mi_rows + (1 << sb_shift) - 1) >> sb_shift
    fh(c, FH_SB_COLS, sb_cols)
    fh(c, FH_SB_ROWS, sb_rows)
    let sb_log2: i64 = sb_shift + 2
    let max_tw_sb: i64 = 4096 >> sb_log2
    var max_ta_sb: i64 = (4096 * 2304) >> (2 * sb_log2)
    let min_l2c: i64 = tile_log2(max_tw_sb, sb_cols)
    let max_l2c: i64 = tile_log2(1, imin(sb_cols, 64))
    let max_l2r: i64 = tile_log2(1, imin(sb_rows, 64))
    let min_l2t: i64 = imax(min_l2c, tile_log2(max_ta_sb, sb_rows * sb_cols))
    var tcl2: i64 = 0
    var trl2: i64 = 0
    var tcols: i64 = 0
    var trows: i64 = 0
    if bits_get(&b, 1) != 0 {
        tcl2 = min_l2c
        while tcl2 < max_l2c {
            if bits_get(&b, 1) != 0 {
                tcl2 = tcl2 + 1
            } else {
                break
            }
        }
        let tws: i64 = (sb_cols + (1 << tcl2) - 1) >> tcl2
        tcols = (sb_cols + tws - 1) / tws
        var ti: i64 = 0
        while ti < tcols {
            fh(c, FH_TCSTART + (ti as usize), ti * tws)
            ti = ti + 1
        }
        fh(c, FH_TCSTART + (tcols as usize), sb_cols)
        trl2 = imax(min_l2t - tcl2, 0)
        while trl2 < max_l2r {
            if bits_get(&b, 1) != 0 {
                trl2 = trl2 + 1
            } else {
                break
            }
        }
        let ths: i64 = (sb_rows + (1 << trl2) - 1) >> trl2
        trows = (sb_rows + ths - 1) / ths
        ti = 0
        while ti < trows {
            fh(c, FH_TRSTART + (ti as usize), ti * ths)
            ti = ti + 1
        }
        fh(c, FH_TRSTART + (trows as usize), sb_rows)
    } else {
        var widest: i64 = 0
        var start: i64 = 0
        while start < sb_cols && tcols < 64 {
            let mw: i64 = imin(sb_cols - start, max_tw_sb)
            let sz: i64 = bits_ns(&b, mw) + 1
            widest = imax(sz, widest)
            fh(c, FH_TCSTART + (tcols as usize), start)
            start = start + sz
            tcols = tcols + 1
        }
        fh(c, FH_TCSTART + (tcols as usize), sb_cols)
        tcl2 = tile_log2(1, tcols)
        if min_l2t > 0 {
            max_ta_sb = (sb_rows * sb_cols) >> (min_l2t + 1)
        } else {
            max_ta_sb = sb_rows * sb_cols
        }
        let mth: i64 = imax(max_ta_sb / imax(widest, 1), 1)
        start = 0
        while start < sb_rows && trows < 64 {
            let mh: i64 = imin(sb_rows - start, mth)
            fh(c, FH_TRSTART + (trows as usize), start)
            start = start + bits_ns(&b, mh) + 1
            trows = trows + 1
        }
        fh(c, FH_TRSTART + (trows as usize), sb_rows)
        trl2 = tile_log2(1, trows)
    }
    fh(c, FH_TCOLS_LOG2, tcl2)
    fh(c, FH_TROWS_LOG2, trl2)
    fh(c, FH_TCOLS, tcols)
    fh(c, FH_TROWS, trows)
    if tcl2 > 0 || trl2 > 0 {
        fh(c, FH_CTX_TILE, bits_get(&b, (tcl2 + trl2) as usize))
        fh(c, FH_TSIZE_BYTES, bits_get(&b, 2) + 1)
    }
    let mono: i64 = ld32(c, AI_MONO)
    let planes: i64 = 3 - 2 * mono
    let base_q: i64 = bits_get(&b, 8)
    fh(c, FH_BASE_Q, base_q)
    let dqy: i64 = read_delta_q(&b)
    fh(c, FH_DQ_YDC, dqy)
    var dqu: i64 = 128
    var dqua: i64 = 128
    var dqv: i64 = 128
    var dqva: i64 = 128
    if planes > 1 {
        var diff: i64 = 0
        if ld32(c, AI_SEP_UV_DQ) != 0 {
            diff = bits_get(&b, 1)
        }
        dqu = read_delta_q(&b)
        dqua = read_delta_q(&b)
        if diff != 0 {
            dqv = read_delta_q(&b)
            dqva = read_delta_q(&b)
        } else {
            dqv = dqu
            dqva = dqua
        }
    }
    fh(c, FH_DQ_UDC, dqu)
    fh(c, FH_DQ_UAC, dqua)
    fh(c, FH_DQ_VDC, dqv)
    fh(c, FH_DQ_VAC, dqva)
    if bits_get(&b, 1) != 0 {
        fh(c, FH_QM, 1)
        let qy: i64 = bits_get(&b, 4)
        let qu: i64 = bits_get(&b, 4)
        var qv: i64 = qu
        if ld32(c, AI_SEP_UV_DQ) != 0 {
            qv = bits_get(&b, 4)
        }
        fh(c, FH_QM_Y, qy)
        fh(c, FH_QM_U, qu)
        fh(c, FH_QM_V, qv)
    }
    let seg_en: i64 = bits_get(&b, 1)
    fh(c, FH_SEG_EN, seg_en)
    if seg_en != 0 {
        var s: usize = 0
        while s < 8 {
            var j: usize = 0
            while j < 8 {
                if bits_get(&b, 1) != 0 {
                    var bitsn: usize = 0
                    var sgn: bool = true
                    if j == 0 {
                        bitsn = 8
                    } else if j < 5 {
                        bitsn = 6
                    } else if j == 5 {
                        bitsn = 3
                        sgn = false
                    } else {
                        sgn = false
                    }
                    var v: i64 = 0
                    var lim: i64 = 0
                    if j == 0 {
                        lim = 255
                    } else if j < 5 {
                        lim = 63
                    } else if j == 5 {
                        lim = 7
                    }
                    if bitsn > 0 {
                        if sgn {
                            v = imax(0 - lim, imin(lim, bits_su(&b, bitsn + 1)))
                        } else {
                            v = imax(0, imin(lim, bits_get(&b, bitsn)))
                        }
                    }
                    st32(c, FH_BASE + FH_SEG_FEAT + s * 8 + j, v + 256)
                    st32(c, FH_BASE + FH_SEG_FEN + s * 8 + j, 1)
                    if j >= 5 {
                        fh(c, FH_SEG_PRESKIP, 1)
                    }
                    if (s as i64) > fhg(c, FH_SEG_LAST) {
                        fh(c, FH_SEG_LAST, s as i64)
                    }
                }
                j = j + 1
            }
            s = s + 1
        }
    }
    var dq_pres: i64 = 0
    if base_q > 0 {
        dq_pres = bits_get(&b, 1)
    }
    fh(c, FH_DQ_PRES, dq_pres)
    if dq_pres != 0 {
        fh(c, FH_DQ_RES, bits_get(&b, 2))
        if ibc == 0 {
            let dlf: i64 = bits_get(&b, 1)
            fh(c, FH_DLF_PRES, dlf)
            if dlf != 0 {
                fh(c, FH_DLF_RES, bits_get(&b, 2))
                fh(c, FH_DLF_MULTI, bits_get(&b, 1))
            }
        }
    }
    var lossless: i64 = 1
    var s2: usize = 0
    while s2 < 8 {
        var qi: i64 = base_q
        if seg_en != 0 && ld32(c, FH_BASE + FH_SEG_FEN + s2 * 8) != 0 {
            qi = qi + ld32(c, FH_BASE + FH_SEG_FEAT + s2 * 8) - 256
            qi = imax(0, imin(255, qi))
        }
        var seg_ll: i64 = 1
        if qi != 0 || dqy != 128 || dqu != 128 || dqua != 128 || dqv != 128 || dqva != 128 {
            seg_ll = 0
            lossless = 0
        }
        fh(c, FH_SEGQ + s2, seg_ll)
        s2 = s2 + 1
    }
    fh(c, FH_LOSSLESS, lossless)
    if lossless == 0 && ibc == 0 {
        let l0: i64 = bits_get(&b, 6)
        let l1: i64 = bits_get(&b, 6)
        fh(c, FH_LF0, l0)
        fh(c, FH_LF0 + 1, l1)
        if planes > 1 && (l0 != 0 || l1 != 0) {
            fh(c, FH_LF0 + 2, bits_get(&b, 6))
            fh(c, FH_LF0 + 3, bits_get(&b, 6))
        }
        fh(c, FH_LF_SHARP, bits_get(&b, 3))
        let lde: i64 = bits_get(&b, 1)
        fh(c, FH_LF_DELTA_EN, lde)
        fh(c, FH_LF_RD0, 129)
        if lde != 0 {
            if bits_get(&b, 1) != 0 {
                var k: usize = 0
                while k < 8 {
                    if bits_get(&b, 1) != 0 {
                        let dv: i64 = bits_su(&b, 7)
                        if k == 0 {
                            fh(c, FH_LF_RD0, dv + 128)
                        }
                    }
                    k = k + 1
                }
                k = 0
                while k < 2 {
                    if bits_get(&b, 1) != 0 {
                        bits_su(&b, 7)
                    }
                    k = k + 1
                }
            }
        }
    }
    fh(c, FH_CDEF_DAMP, 3)
    if lossless == 0 && ibc == 0 && ld32(c, AI_CDEF) != 0 {
        fh(c, FH_CDEF_DAMP, bits_get(&b, 2) + 3)
        let cb: i64 = bits_get(&b, 2)
        fh(c, FH_CDEF_BITS, cb)
        var i: usize = 0
        while i < (1 << cb) as usize {
            fh(c, FH_CDEF_YP + i, bits_get(&b, 4))
            var ys: i64 = bits_get(&b, 2)
            if ys == 3 {
                ys = 4
            }
            fh(c, FH_CDEF_YS + i, ys)
            if planes > 1 {
                fh(c, FH_CDEF_UVP + i, bits_get(&b, 4))
                var us: i64 = bits_get(&b, 2)
                if us == 3 {
                    us = 4
                }
                fh(c, FH_CDEF_UVS + i, us)
            }
            i = i + 1
        }
    }
    var all_lossless: i64 = lossless
    if upw != fw {
        all_lossless = 0
    }
    if all_lossless == 0 && ibc == 0 && ld32(c, AI_RESTORATION) != 0 {
        var uses: bool = false
        var uses_c: bool = false
        var pl: usize = 0
        while pl < planes as usize {
            let t: i64 = bits_get(&b, 2)
            var ty: i64 = 0
            if t == 1 {
                ty = 3
            } else if t == 2 {
                ty = 1
            } else if t == 3 {
                ty = 2
            }
            fh(c, FH_LR_TYPE + pl, ty)
            if ty != 0 {
                uses = true
                if pl > 0 {
                    uses_c = true
                }
            }
            pl = pl + 1
        }
        if uses {
            var sh: i64 = 0
            if ld32(c, AI_SB128) != 0 {
                sh = bits_get(&b, 1) + 1
            } else {
                sh = bits_get(&b, 1)
                if sh != 0 {
                    sh = sh + bits_get(&b, 1)
                }
            }
            fh(c, FH_LR_UNIT_SHIFT, sh)
            if ld32(c, AI_SUBX) != 0 && ld32(c, AI_SUBY) != 0 && uses_c {
                fh(c, FH_LR_UV_SHIFT, bits_get(&b, 1))
            }
        }
    }
    if lossless != 0 {
        fh(c, FH_TX_MODE, 0)
    } else if bits_get(&b, 1) != 0 {
        fh(c, FH_TX_MODE, 2)
    } else {
        fh(c, FH_TX_MODE, 1)
    }
    fh(c, FH_REDUCED_TX, bits_get(&b, 1))
    if ld32(c, AI_FILM_GRAIN) != 0 && show != 0 {
        let g: i64 = bits_get(&b, 1)
        fh(c, FH_GRAIN, g)
        if g != 0 {
            parse_film_grain(&b, c)
        }
    }
    if bits_over(&b) {
        return false
    }
    fh(c, FH_HDR_END, ((b.pos + 7) >> 3) as i64)
    fh(c, FH_OK, 1)
    return true
}

fn walk_obus(p: u64, n: usize, c: u64) -> bool {
    var at: usize = 0
    var got: bool = false
    while at < n {
        let h: i64 = rd8(p, at)
        let typ: i64 = (h >> 3) & 15
        let ext: i64 = (h >> 2) & 1
        let has_size: i64 = (h >> 1) & 1
        var q: usize = at + 1 + (ext as usize)
        var sz: usize = 0
        if has_size != 0 {
            var k: usize = 0
            var v: i64 = 0
            while k < 8 {
                let by: i64 = rd8(p, q)
                q = q + 1
                v = v | ((by & 127) << (7 * k))
                k = k + 1
                if (by & 128) == 0 {
                    break
                }
            }
            sz = v as usize
        } else {
            sz = n - q
        }
        if q > n || sz > n - q {
            return got
        }
        if typ == 1 {
            st32(c, AI_OBU_SEQ, ld32(c, AI_OBU_SEQ) + 1)
            if !got {
                if parse_seq_hdr(p + q as u64, sz, c) {
                    got = true
                } else {
                    return false
                }
            }
        }
        if typ == 3 || typ == 6 {
            st32(c, AI_OBU_FRAME, ld32(c, AI_OBU_FRAME) + 1)
            if ld32(c, AI_OBU_FRAME) == 1 && got {
                fh(c, FH_TYPE, typ)
                fh(c, FH_OBU_OFF, q as i64)
                fh(c, FH_OBU_LEN, sz as i64)
                parse_frame_hdr(p + q as u64, sz, c)
            }
        }
        if typ == 4 || typ == 6 {
            st32(c, AI_OBU_TILE, ld32(c, AI_OBU_TILE) + 1)
        }
        at = q + sz
    }
    return got
}

fn avif_parse(src: u64, n: usize) -> u64 {
    G_AR = AR_OK
    G_N = n
    if !avif_sniff(src, n) {
        G_AR = AR_NOT_AVIF
        return 0
    }
    if n > 2000000000 {
        G_AR = AR_TOO_BIG
        return 0
    }
    let c: u64 = av1mem.heap_alloc(CELLS * 4) as u64
    if c == 0 {
        G_AR = AR_MEMORY
        return 0
    }
    st32(c, AI_BRAND_OK, 1)
    var at: usize = 0
    while at + 8 <= n {
        let e: usize = box_end(src, at, n)
        if e == 0 {
            break
        }
        if be32(src, at + 4) == FT_META {
            parse_meta(src, c, at + box_hdr(src, at) + 4, e)
        }
        at = e
    }
    let pid: i64 = ld32(c, AI_PRIMARY_ID)
    let pi: i64 = find_item(c, pid)
    if pid == 0 || pi < 0 {
        G_AR = AR_NO_PRIMARY
        avif_info_free(c)
        return 0
    }
    let ib: usize = IT_BASE + (pi as usize) * 8
    let ptype: i64 = ld32(c, ib + 1)
    st32(c, AI_PRIM_TYPE, ptype)
    st32(c, AI_PRIM_OFF, ld32(c, ib + 2))
    st32(c, AI_PRIM_LEN, ld32(c, ib + 3))
    st32(c, AI_ITEM_CM, ld32(c, ib + 4))
    st32(c, AI_ITEM_EXT, ld32(c, ib + 5))
    let ispe: i64 = item_prop(c, pid, FT_ISPE)
    if ispe >= 0 {
        let o: usize = ld32(c, PR_BASE + (ispe as usize) * 8 + 1) as usize
        st32(c, AI_ISPE_W, be32(src, o + 4))
        st32(c, AI_ISPE_H, be32(src, o + 8))
        st32(c, AI_WIDTH, be32(src, o + 4))
        st32(c, AI_HEIGHT, be32(src, o + 8))
    }
    let colr: i64 = item_prop(c, pid, FT_COLR)
    if colr >= 0 {
        let o: usize = ld32(c, PR_BASE + (colr as usize) * 8 + 1) as usize
        if be32(src, o) == FT_NCLX {
            st32(c, AI_COLR, 1)
            st32(c, AI_FULL_RANGE, (rd8(src, o + 10) >> 7) & 1)
        } else {
            st32(c, AI_COLR, 2)
        }
    }
    let pixi: i64 = item_prop(c, pid, FT_PIXI)
    if pixi >= 0 {
        let o: usize = ld32(c, PR_BASE + (pixi as usize) * 8 + 1) as usize
        st32(c, AI_NPLANES, rd8(src, o + 4))
        st32(c, AI_PIXI_BITS, rd8(src, o + 5))
    }
    let a1c: i64 = item_prop(c, pid, FT_AV1C)
    if a1c >= 0 {
        let o: usize = ld32(c, PR_BASE + (a1c as usize) * 8 + 1) as usize
        st32(c, AI_AV1C_PROFILE, rd8(src, o + 1) >> 5)
        st32(c, AI_AV1C_LEVEL, rd8(src, o + 1) & 31)
    }
    let ir: i64 = item_prop(c, pid, FT_IROT)
    if ir >= 0 {
        let o: usize = ld32(c, PR_BASE + (ir as usize) * 8 + 1) as usize
        st32(c, AI_IROT, 1 + (rd8(src, o) & 3))
    }
    let im: i64 = item_prop(c, pid, FT_IMIR)
    if im >= 0 {
        let o: usize = ld32(c, PR_BASE + (im as usize) * 8 + 1) as usize
        st32(c, AI_IMIR, 1 + (rd8(src, o) & 1))
    }
    let ni: usize = ld32(c, AI_N_ITEMS) as usize
    var i: usize = 0
    while i < ni {
        let id: i64 = ld32(c, IT_BASE + i * 8)
        if id != pid && ld32(c, IT_BASE + i * 8 + 1) == FT_AV01 {
            let ax: i64 = item_prop(c, id, FT_AUXC)
            if ax >= 0 && auxc_is_alpha(src, c, ax as usize) {
                st32(c, AI_ALPHA_ID, id)
                st32(c, AI_ALPHA_OFF, ld32(c, IT_BASE + i * 8 + 2))
                st32(c, AI_ALPHA_LEN, ld32(c, IT_BASE + i * 8 + 3))
                break
            }
        }
        i = i + 1
    }
    if ptype != FT_AV01 || ld32(c, AI_ITEM_CM) != 0 || ld32(c, AI_ITEM_EXT) != 1 {
        G_AR = AR_UNSUPPORTED
        return c
    }
    let po: usize = ld32(c, AI_PRIM_OFF) as usize
    let pl: usize = ld32(c, AI_PRIM_LEN) as usize
    if po > n || pl > n - po {
        G_AR = AR_TRUNCATED
        return c
    }
    if !walk_obus(src + po as u64, pl, c) {
        G_AR = AR_NO_SEQHDR
        return c
    }
    return c
}
