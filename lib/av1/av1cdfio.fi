import rt.rt
import av1.av1mem
import av1.av1sym
import av1.avif_cdf

export { cell_at, MODE_CELLS, COEF_CELLS, store_new, store_free, store_save, store_load, store_valid, store_copy_all, store_invalidate, clear_counters, layout_check, load_defaults, buf_new, buf_free }

const MODE_CELLS: i64 = 4401
const COEF_CELLS: i64 = 4045
const MODE_REGION_COUNT: i64 = 52
const COEF_REGION_COUNT: i64 = 13
const SLOT_CELLS: i64 = 8446
const STORE_HEADER: i64 = 64
const NUM_SLOTS: i64 = 8

static MODE_REGIONS: [u16; 156] = [
    0, 13, 25, 350, 7, 8, 414, 13, 4, 470, 14, 26,
    860, 10, 20, 1080, 7, 104, 1912, 16, 12, 2116, 8, 1,
    2125, 16, 6, 2227, 3, 16, 2291, 2, 6, 2309, 2, 2,
    2315, 2, 6, 2333, 2, 3, 2342, 8, 8, 2414, 2, 4,
    2426, 4, 4, 2446, 2, 22, 2512, 2, 22, 2578, 16, 22,
    2952, 3, 22, 3040, 2, 22, 3106, 2, 4, 3118, 2, 5,
    3133, 2, 5, 3148, 2, 9, 3175, 2, 18, 3229, 2, 9,
    3256, 2, 6, 3274, 7, 7, 3330, 7, 7, 3386, 2, 21,
    3449, 2, 2, 3455, 8, 35, 3770, 8, 35, 4085, 2, 21,
    4148, 2, 3, 4157, 2, 3, 4166, 2, 6, 4184, 2, 6,
    4202, 2, 1, 4205, 5, 1, 4211, 2, 22, 4277, 3, 1,
    4281, 2, 1, 4284, 2, 1, 4287, 4, 1, 4292, 4, 4,
    4312, 4, 1, 4317, 2, 3, 4326, 8, 3, 4353, 3, 12,
]

static COEF_REGIONS: [u16; 39] = [
    0, 2, 6, 18, 2, 65, 213, 2, 90, 483, 5, 4,
    507, 6, 4, 535, 7, 4, 567, 8, 4, 603, 9, 4,
    643, 10, 4, 687, 11, 4, 735, 4, 210, 1785, 4, 420,
    3885, 3, 40,
]

fn mode_region(i: i64, k: i64) -> i64 {
    return MODE_REGIONS[(i * 3 + k) as usize] as i64
}

fn coef_region(i: i64, k: i64) -> i64 {
    return COEF_REGIONS[(i * 3 + k) as usize] as i64
}

fn cell_at(p: u64, i: i64) -> i64 {
    return av1sym.cdf_ld(p, i)
}

fn clear_array(p: u64, base: i64, n: i64) {
    var j: i64 = 0
    while j < n {
        if av1sym.cdf_ld(p, base + j) == 32768 {
            av1sym.cdf_st(p, base + j + 1, 0)
            return
        }
        j = j + 1
    }
}

fn clear_region(p: u64, off: i64, n: i64, leaves: i64) {
    var l: i64 = 0
    while l < leaves {
        clear_array(p, off + l * (n + 1), n)
        l = l + 1
    }
}

fn clear_counters(mode: u64, coef: u64) {
    var i: i64 = 0
    while i < MODE_REGION_COUNT {
        clear_region(mode, mode_region(i, 0), mode_region(i, 1), mode_region(i, 2))
        i = i + 1
    }
    i = 0
    while i < COEF_REGION_COUNT {
        clear_region(coef, coef_region(i, 0), coef_region(i, 1), coef_region(i, 2))
        i = i + 1
    }
}

fn check_array(p: u64, base: i64, n: i64) -> i64 {
    var j: i64 = 0
    var prev: i64 = 0
    while j < n {
        let v: i64 = av1sym.cdf_ld(p, base + j)
        if v < prev {
            return 1
        }
        if v == 32768 {
            if av1sym.cdf_ld(p, base + j + 1) != 0 {
                return 1
            }
            return 0
        }
        prev = v
        j = j + 1
    }
    return 0
}

fn check_region(p: u64, off: i64, n: i64, leaves: i64) -> i64 {
    var bad: i64 = 0
    var l: i64 = 0
    while l < leaves {
        bad = bad + check_array(p, off + l * (n + 1), n)
        l = l + 1
    }
    return bad
}

fn layout_check(mode: u64, coef: u64) -> i64 {
    var bad: i64 = 0
    var i: i64 = 0
    while i < MODE_REGION_COUNT {
        bad = bad + check_region(mode, mode_region(i, 0), mode_region(i, 1), mode_region(i, 2))
        i = i + 1
    }
    i = 0
    while i < COEF_REGION_COUNT {
        bad = bad + check_region(coef, coef_region(i, 0), coef_region(i, 1), coef_region(i, 2))
        i = i + 1
    }
    return bad
}

fn load_defaults(qctx: i64, mode: u64, coef: u64) {
    av1sym.cdf_copy(mode, avif_cdf.cdf_mode_addr(), MODE_CELLS)
    av1sym.cdf_copy(coef, avif_cdf.cdf_coef_addr() + ((qctx * COEF_CELLS * 2) as u64), COEF_CELLS)
}

fn buf_new(cells: i64) -> u64 {
    return av1mem.heap_alloc((cells * 2 + 64) as usize) as u64
}

fn buf_free(p: u64, cells: i64) {
    if p != 0 {
        av1mem.heap_free(p as *mut u8, (cells * 2 + 64) as usize)
    }
}

fn store_new() -> u64 {
    return av1mem.heap_alloc((STORE_HEADER + NUM_SLOTS * SLOT_CELLS * 2) as usize) as u64
}

fn store_free(s: u64) {
    if s != 0 {
        av1mem.heap_free(s as *mut u8, (STORE_HEADER + NUM_SLOTS * SLOT_CELLS * 2) as usize)
    }
}

fn flag_ptr(s: u64, slot: i64) -> *mut i64 {
    return (s + ((slot * 8) as u64)) as *mut i64
}

fn slot_base(s: u64, slot: i64) -> u64 {
    return s + ((STORE_HEADER + slot * SLOT_CELLS * 2) as u64)
}

fn store_valid(s: u64, slot: i64) -> bool {
    return *flag_ptr(s, slot) != 0
}

fn store_save(s: u64, slot: i64, mode: u64, coef: u64) {
    let b: u64 = slot_base(s, slot)
    av1sym.cdf_copy(b, mode, MODE_CELLS)
    av1sym.cdf_copy(b + ((MODE_CELLS * 2) as u64), coef, COEF_CELLS)
    *flag_ptr(s, slot) = 1
}

fn store_load(s: u64, slot: i64, mode: u64, coef: u64) -> bool {
    if !store_valid(s, slot) {
        return false
    }
    let b: u64 = slot_base(s, slot)
    av1sym.cdf_copy(mode, b, MODE_CELLS)
    av1sym.cdf_copy(coef, b + ((MODE_CELLS * 2) as u64), COEF_CELLS)
    return true
}

fn store_invalidate(s: u64, slot: i64) {
    *flag_ptr(s, slot) = 0
}

fn store_copy_all(s: u64, from: i64) {
    var i: i64 = 0
    while i < NUM_SLOTS {
        if i != from && store_valid(s, from) {
            av1sym.cdf_copy(slot_base(s, i), slot_base(s, from), SLOT_CELLS)
            *flag_ptr(s, i) = 1
        }
        i = i + 1
    }
}
