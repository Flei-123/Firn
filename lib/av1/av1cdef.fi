// SPDX-License-Identifier: MPL-2.0
// lib/av1/av1cdef.fi -- AV1 constrained directional enhancement filter (CDEF).
import av1.av1mem

export { cdef_frame, CDEF_PAR_BYTES, CDEF_SCRATCH_BYTES }

const CDEF_PAR_BYTES: i64 = 32
const CDEF_SCRATCH_BYTES: i64 = 1280

static DIRS: [i16; 32] = [-1, 1, -2, 2, 0, 1, -1, 2, 0, 1, 0, 2, 0, 1, 1, 2, 1, 1, 2, 2, 1, 0, 2, 1, 1, 0, 2, 0, 1, 0, 2, -1]
static UVDIR: [i16; 32] = [0, 1, 2, 3, 4, 5, 6, 7, 1, 2, 2, 2, 3, 4, 6, 0, 7, 0, 2, 4, 5, 6, 6, 6, 0, 1, 2, 3, 4, 5, 6, 7]
static DIVT: [i16; 9] = [0, 840, 420, 280, 210, 168, 140, 120, 105]

#[no_gc]
fn ldb(p: u64, i: i64) -> i64 {
    return (*((p + (i as u64)) as *mut u8)) as i64
}

#[no_gc]
fn stb(p: u64, i: i64, v: i64) {
    *((p + (i as u64)) as *mut u8) = (v & 255) as u8
}

#[no_gc]
fn ldq(p: u64, i: i64) -> i64 {
    return *((p + ((i * 8) as u64)) as *mut i64)
}

#[no_gc]
fn stq(p: u64, i: i64, v: i64) {
    *((p + ((i * 8) as u64)) as *mut i64) = v
}

fn imin(a: i64, b: i64) -> i64 {
    if a < b {
        return a
    }
    return b
}

fn imax(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    }
    return b
}

fn iabs(a: i64) -> i64 {
    if a < 0 {
        return 0 - a
    }
    return a
}

fn clip3(lo: i64, hi: i64, v: i64) -> i64 {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

fn floor_log2(v: i64) -> i64 {
    var n: i64 = 0
    var x: i64 = v
    while x > 1 {
        x = x >> 1
        n = n + 1
    }
    return n
}

fn constrain(diff: i64, thr: i64, damping: i64) -> i64 {
    if thr == 0 {
        return 0
    }
    let adj: i64 = imax(0, damping - floor_log2(thr))
    let a: i64 = iabs(diff)
    let v: i64 = clip3(0, a, thr - (a >> adj))
    if diff < 0 {
        return 0 - v
    }
    return v
}

fn cdef_dir(pl: u64, stride: i64, x0: i64, y0: i64, sc: u64) -> i64 {
    var k: i64 = 0
    while k < 129 {
        stq(sc, k, 0)
        k = k + 1
    }
    var i: i64 = 0
    while i < 8 {
        var j: i64 = 0
        while j < 8 {
            let x: i64 = ldb(pl, (y0 + i) * stride + x0 + j) - 128
            stq(sc, 0 * 15 + i + j, ldq(sc, 0 * 15 + i + j) + x)
            stq(sc, 1 * 15 + i + j / 2, ldq(sc, 1 * 15 + i + j / 2) + x)
            stq(sc, 2 * 15 + i, ldq(sc, 2 * 15 + i) + x)
            stq(sc, 3 * 15 + 3 + i - j / 2, ldq(sc, 3 * 15 + 3 + i - j / 2) + x)
            stq(sc, 4 * 15 + 7 + i - j, ldq(sc, 4 * 15 + 7 + i - j) + x)
            stq(sc, 5 * 15 + 3 - i / 2 + j, ldq(sc, 5 * 15 + 3 - i / 2 + j) + x)
            stq(sc, 6 * 15 + j, ldq(sc, 6 * 15 + j) + x)
            stq(sc, 7 * 15 + i / 2 + j, ldq(sc, 7 * 15 + i / 2 + j) + x)
            j = j + 1
        }
        i = i + 1
    }
    var c2: i64 = 0
    var c6: i64 = 0
    i = 0
    while i < 8 {
        c2 = c2 + ldq(sc, 2 * 15 + i) * ldq(sc, 2 * 15 + i)
        c6 = c6 + ldq(sc, 6 * 15 + i) * ldq(sc, 6 * 15 + i)
        i = i + 1
    }
    stq(sc, 120 + 2, c2 * (DIVT[8] as i64))
    stq(sc, 120 + 6, c6 * (DIVT[8] as i64))
    var c0: i64 = 0
    var c4: i64 = 0
    i = 0
    while i < 7 {
        let d: i64 = DIVT[(i + 1) as usize] as i64
        c0 = c0 + (ldq(sc, i) * ldq(sc, i) + ldq(sc, 14 - i) * ldq(sc, 14 - i)) * d
        c4 = c4 + (ldq(sc, 60 + i) * ldq(sc, 60 + i) + ldq(sc, 60 + 14 - i) * ldq(sc, 60 + 14 - i)) * d
        i = i + 1
    }
    c0 = c0 + ldq(sc, 7) * ldq(sc, 7) * (DIVT[8] as i64)
    c4 = c4 + ldq(sc, 60 + 7) * ldq(sc, 60 + 7) * (DIVT[8] as i64)
    stq(sc, 120 + 0, c0)
    stq(sc, 120 + 4, c4)
    i = 1
    while i < 8 {
        var cs: i64 = 0
        var j: i64 = 0
        while j < 5 {
            cs = cs + ldq(sc, i * 15 + 3 + j) * ldq(sc, i * 15 + 3 + j)
            j = j + 1
        }
        cs = cs * (DIVT[8] as i64)
        j = 0
        while j < 3 {
            cs = cs + (ldq(sc, i * 15 + j) * ldq(sc, i * 15 + j) + ldq(sc, i * 15 + 10 - j) * ldq(sc, i * 15 + 10 - j)) * (DIVT[(2 * j + 2) as usize] as i64)
            j = j + 1
        }
        stq(sc, 120 + i, cs)
        i = i + 2
    }
    var best: i64 = 0
    var dir: i64 = 0
    i = 0
    while i < 8 {
        if ldq(sc, 120 + i) > best {
            best = ldq(sc, 120 + i)
            dir = i
        }
        i = i + 1
    }
    stq(sc, 128, (best - ldq(sc, 120 + ((dir + 4) & 7))) >> 10)
    return dir
}

fn tap_at(src: u64, stride: i64, x: i64, y: i64, sx: i64, sy: i64, mc: i64, mr: i64, sc: u64) -> i64 {
    if x < 0 || y < 0 {
        return 0
    }
    if ((y << sy) >> 2) >= mr || ((x << sx) >> 2) >= mc {
        return 0
    }
    stq(sc, 130, ldb(src, y * stride + x))
    return 1
}

fn cdef_filter(src: u64, dst: u64, stride: i64, x0: i64, y0: i64, w: i64, h: i64, pri: i64, sec: i64, damping: i64, dir: i64,
               sx: i64, sy: i64, mc: i64, mr: i64, sc: u64) {
    let ptap: i64 = pri & 1
    var i: i64 = 0
    while i < h {
        var j: i64 = 0
        while j < w {
            var sum: i64 = 0
            let x: i64 = ldb(src, (y0 + i) * stride + x0 + j)
            var mx: i64 = x
            var mn: i64 = x
            var k: i64 = 0
            while k < 2 {
                var sign: i64 = 0 - 1
                while sign <= 1 {
                    let dy: i64 = DIRS[(dir * 4 + k * 2) as usize] as i64
                    let dx: i64 = DIRS[(dir * 4 + k * 2 + 1) as usize] as i64
                    if tap_at(src, stride, x0 + j + sign * dx, y0 + i + sign * dy, sx, sy, mc, mr, sc) != 0 {
                        let p: i64 = ldq(sc, 130)
                        var pt: i64 = 4
                        if ptap != 0 {
                            pt = 3
                        }
                        if k == 1 {
                            pt = 2
                            if ptap != 0 {
                                pt = 3
                            }
                        }
                        sum = sum + pt * constrain(p - x, pri, damping)
                        mx = imax(p, mx)
                        mn = imin(p, mn)
                    }
                    var off: i64 = 0 - 2
                    while off <= 2 {
                        let d2: i64 = (dir + off) & 7
                        let sdy: i64 = DIRS[(d2 * 4 + k * 2) as usize] as i64
                        let sdx: i64 = DIRS[(d2 * 4 + k * 2 + 1) as usize] as i64
                        if tap_at(src, stride, x0 + j + sign * sdx, y0 + i + sign * sdy, sx, sy, mc, mr, sc) != 0 {
                            let s: i64 = ldq(sc, 130)
                            var st: i64 = 2
                            if k == 1 {
                                st = 1
                            }
                            sum = sum + st * constrain(s - x, sec, damping)
                            mx = imax(s, mx)
                            mn = imin(s, mn)
                        }
                        off = off + 4
                    }
                    sign = sign + 2
                }
                k = k + 1
            }
            var neg: i64 = 0
            if sum < 0 {
                neg = 1
            }
            let adj: i64 = ((8 + sum - neg + 65536) >> 4) - 4096
            stb(dst, (y0 + i) * stride + x0 + j, clip3(mn, mx, x + adj))
            j = j + 1
        }
        i = i + 1
    }
}

fn cdef_frame(p0: u64, p1: u64, p2: u64, stride: i64, skp: u64, cidx: u64, sbcols: i64, mc: i64, mr: i64, sx: i64, sy: i64, np: i64,
              damp: i64, par: u64, sc: u64) {
    let arows: i64 = (mr + 15) & (0 - 16)
    let psz: i64 = stride * arows * 4
    let s0: u64 = av1mem.heap_alloc(psz as usize) as u64
    av1mem.mem_copy(s0 as *mut u8, p0 as *mut u8, psz as usize)
    var s1: u64 = 0
    var s2: u64 = 0
    if np > 1 {
        s1 = av1mem.heap_alloc(psz as usize) as u64
        s2 = av1mem.heap_alloc(psz as usize) as u64
        av1mem.mem_copy(s1 as *mut u8, p1 as *mut u8, psz as usize)
        av1mem.mem_copy(s2 as *mut u8, p2 as *mut u8, psz as usize)
    }
    var r: i64 = 0
    while r < mr {
        var c: i64 = 0
        while c < mc {
            let idx: i64 = ldb(cidx, (r >> 4) * sbcols + (c >> 4)) - 1
            let a: i64 = r * mc + c
            var skip: i64 = 0
            if ldb(skp, a) != 0 && ldb(skp, a + 1) != 0 && ldb(skp, a + mc) != 0 && ldb(skp, a + mc + 1) != 0 {
                skip = 1
            }
            if idx >= 0 && skip == 0 {
                let ydir: i64 = cdef_dir(s0, stride, c * 4, r * 4, sc)
                let vr: i64 = ldq(sc, 128)
                var pri: i64 = ldb(par, idx)
                let sec: i64 = ldb(par, 8 + idx)
                var dir: i64 = ydir
                if pri == 0 {
                    dir = 0
                }
                var vstr: i64 = 0
                if (vr >> 6) != 0 {
                    vstr = imin(floor_log2(vr >> 6), 12)
                }
                if vr != 0 {
                    pri = (pri * (4 + vstr) + 8) >> 4
                } else {
                    pri = 0
                }
                cdef_filter(s0, p0, stride, c * 4, r * 4, 8, 8, pri, sec, damp, dir, 0, 0, mc, mr, sc)
                if np > 1 {
                    let upri: i64 = ldb(par, 16 + idx)
                    let usec: i64 = ldb(par, 24 + idx)
                    var udir: i64 = 0
                    if upri != 0 {
                        udir = UVDIR[(sx * 16 + sy * 8 + ydir) as usize] as i64
                    }
                    let cx: i64 = (c * 4) >> sx
                    let cy: i64 = (r * 4) >> sy
                    cdef_filter(s1, p1, stride, cx, cy, 8 >> sx, 8 >> sy, upri, usec, damp - 1, udir, sx, sy, mc, mr, sc)
                    cdef_filter(s2, p2, stride, cx, cy, 8 >> sx, 8 >> sy, upri, usec, damp - 1, udir, sx, sy, mc, mr, sc)
                }
            }
            c = c + 2
        }
        r = r + 2
    }
    av1mem.heap_free(s0 as *mut u8, psz as usize)
    if np > 1 {
        av1mem.heap_free(s1 as *mut u8, psz as usize)
        av1mem.heap_free(s2 as *mut u8, psz as usize)
    }
}
