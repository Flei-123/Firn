// lib/av1/av1gm.fi -- av1.av1gm: global motion parameter syntax (spec 5.9.24, 5.9.25, 5.9.26).
import av1.av1bits
import av1.av1fhx

export { gm_defaults, gm_parse }

fn gm_defaults(c: u64, base: usize) {
    var r: usize = 0
    while r < 8 {
        var i: usize = 0
        while i < 6 {
            var v: i64 = 0
            if i == 2 || i == 5 {
                v = av1fhx.WARP_ONE
            }
            av1fhx.csets(c, base + r * 6 + i, v)
            i = i + 1
        }
        r = r + 1
    }
}

fn inverse_recenter(r: i64, v: i64) -> i64 {
    if v > 2 * r {
        return v
    }
    if (v & 1) != 0 {
        return r - ((v + 1) >> 1)
    }
    return r + (v >> 1)
}

fn decode_subexp(b: *mut av1bits.Bits, num_syms: i64) -> i64 {
    var i: i64 = 0
    var mk: i64 = 0
    let k: i64 = 3
    while true {
        var b2: i64 = k
        if i != 0 {
            b2 = k + i - 1
        }
        let a: i64 = 1 << b2
        if num_syms <= mk + 3 * a {
            return av1bits.bits_ns(b, num_syms - mk) + mk
        }
        if av1bits.bits_get(b, 1) != 0 {
            i = i + 1
            mk = mk + a
        } else {
            return av1bits.bits_get(b, b2 as usize) + mk
        }
    }
    return 0
}

fn decode_unsigned_subexp_with_ref(b: *mut av1bits.Bits, mx: i64, r: i64) -> i64 {
    let v: i64 = decode_subexp(b, mx)
    if (r << 1) <= mx {
        return inverse_recenter(r, v)
    }
    return mx - 1 - inverse_recenter(mx - 1 - r, v)
}

fn decode_signed_subexp_with_ref(b: *mut av1bits.Bits, low: i64, high: i64, r: i64) -> i64 {
    return decode_unsigned_subexp_with_ref(b, high - low, r - low) + low
}

fn read_param(b: *mut av1bits.Bits, c: u64, base: usize, prev: usize, gtype: i64, r: usize, idx: usize, allow_hp: i64) {
    var abs_bits: i64 = 12
    var prec_bits: i64 = 15
    if idx < 2 {
        if gtype == av1fhx.GM_TRANSLATION {
            abs_bits = 9 - (1 - allow_hp)
            prec_bits = 3 - (1 - allow_hp)
        } else {
            abs_bits = 12
            prec_bits = 6
        }
    }
    let prec_diff: i64 = 16 - prec_bits
    var round: i64 = 0
    var sub: i64 = 0
    if (idx % 3) == 2 {
        round = av1fhx.WARP_ONE
        sub = 1 << prec_bits
    }
    let mx: i64 = 1 << abs_bits
    let rv: i64 = (av1fhx.cgets(c, prev + r * 6 + idx) >> prec_diff) - sub
    let v: i64 = decode_signed_subexp_with_ref(b, 0 - mx, mx + 1, rv)
    av1fhx.csets(c, base + r * 6 + idx, (v << prec_diff) + round)
}

fn gm_parse(b: *mut av1bits.Bits, c: u64, fb: usize, prev: usize, allow_hp: i64) {
    let base: usize = fb + av1fhx.FH_GM_PARAMS
    var r: usize = 1
    while r < 8 {
        var gtype: i64 = av1fhx.GM_IDENTITY
        if av1bits.bits_get(b, 1) != 0 {
            if av1bits.bits_get(b, 1) != 0 {
                gtype = av1fhx.GM_ROTZOOM
            } else if av1bits.bits_get(b, 1) != 0 {
                gtype = av1fhx.GM_TRANSLATION
            } else {
                gtype = av1fhx.GM_AFFINE
            }
        }
        av1fhx.csets(c, fb + av1fhx.FH_GM_TYPE + r, gtype)
        if gtype >= av1fhx.GM_ROTZOOM {
            read_param(b, c, base, prev, gtype, r, 2, allow_hp)
            read_param(b, c, base, prev, gtype, r, 3, allow_hp)
            if gtype == av1fhx.GM_AFFINE {
                read_param(b, c, base, prev, gtype, r, 4, allow_hp)
                read_param(b, c, base, prev, gtype, r, 5, allow_hp)
            } else {
                av1fhx.csets(c, base + r * 6 + 4, 0 - av1fhx.cgets(c, base + r * 6 + 3))
                av1fhx.csets(c, base + r * 6 + 5, av1fhx.cgets(c, base + r * 6 + 2))
            }
        }
        if gtype >= av1fhx.GM_TRANSLATION {
            read_param(b, c, base, prev, gtype, r, 0, allow_hp)
            read_param(b, c, base, prev, gtype, r, 1, allow_hp)
        }
        r = r + 1
    }
}
