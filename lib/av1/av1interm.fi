// SPDX-License-Identifier: MPL-2.0
// lib/av1/av1interm.fi -- AV1 inter block mode info: is_inter, skip_mode, reference frames, inter modes, drl, MV assignment, inter-intra, motion mode, compound type, interpolation filter.
import av1.av1sym
import av1.avif_cdf
import av1.av1mv
import av1.av1mvp
import av1.av1ictx
import av1.av1mem

export { IM_CELLS, IM_PLANE_BYTES, im_bind, im_set_tile, im_set_frame, im_set_skip_mode_frames, im_set_ref_dist, im_set_ref_scaled, im_begin_block, im_read_skip_mode, im_read_is_inter, im_read_inter_block, im_set_intra, im_store_block, im_out, im_filter_at }
export { O_ISINTER, O_RF0, O_RF1, O_YMODE, O_REF_MV_IDX, O_MV, O_INTERINTRA, O_II_MODE, O_WEDGE_II, O_WEDGE_IDX, O_WEDGE_SIGN, O_MOTION_MODE, O_COMP_TYPE, O_CGI, O_CIDX, O_MASK_TYPE, O_FILTER0, O_FILTER1, O_NUM_SAMPLES, O_NUM_FOUND, O_SKIP_MODE }

const IM_CELLS: i64 = 128

const I_MVP: i64 = 0
const I_IF0: i64 = 1
const I_IF1: i64 = 2
const I_FLG: i64 = 3
const I_MC: i64 = 4
const I_MR: i64 = 5
const I_R0: i64 = 6
const I_C0: i64 = 7
const I_REFSEL: i64 = 8
const I_SMP: i64 = 9
const I_IIEN: i64 = 10
const I_MASKED: i64 = 11
const I_JNT: i64 = 12
const I_INTERP: i64 = 13
const I_DUAL: i64 = 14
const I_MMSW: i64 = 15
const I_WARP: i64 = 16
const I_SKF0: i64 = 17
const I_SKF1: i64 = 18
const I_DIST: i64 = 24
const I_SCALED: i64 = 32
const I_R: i64 = 40
const I_C: i64 = 41
const I_SIZE: i64 = 42
const I_SEGREF: i64 = 43
const I_SEGSKIP: i64 = 44
const I_SEGGMV: i64 = 45
const I_AU: i64 = 46
const I_AL: i64 = 47
const I_A0: i64 = 48
const I_A1: i64 = 49
const I_L0: i64 = 50
const I_L1: i64 = 51
const I_NSCAN: i64 = 52
const I_SCR: i64 = 56

const O_ISINTER: i64 = 64
const O_RF0: i64 = 65
const O_RF1: i64 = 66
const O_YMODE: i64 = 67
const O_REF_MV_IDX: i64 = 68
const O_MV: i64 = 69
const O_INTERINTRA: i64 = 73
const O_II_MODE: i64 = 74
const O_WEDGE_II: i64 = 75
const O_WEDGE_IDX: i64 = 76
const O_WEDGE_SIGN: i64 = 77
const O_MOTION_MODE: i64 = 78
const O_COMP_TYPE: i64 = 79
const O_CGI: i64 = 80
const O_CIDX: i64 = 81
const O_MASK_TYPE: i64 = 82
const O_FILTER0: i64 = 83
const O_FILTER1: i64 = 84
const O_NUM_SAMPLES: i64 = 85
const O_NUM_FOUND: i64 = 86
const O_SKIP_MODE: i64 = 87

const NEARESTMV: i64 = 14
const NEARMV: i64 = 15
const GLOBALMV: i64 = 16
const NEWMV: i64 = 17
const NEAREST_NEARESTMV: i64 = 18
const NEAR_NEARMV: i64 = 19
const NEAREST_NEWMV: i64 = 20
const NEW_NEARESTMV: i64 = 21
const NEAR_NEWMV: i64 = 22
const NEW_NEARMV: i64 = 23
const GLOBAL_GLOBALMV: i64 = 24
const NEW_NEWMV: i64 = 25
const COMPOUND_WEDGE: i64 = 0
const COMPOUND_DIFFWTD: i64 = 1
const COMPOUND_AVERAGE: i64 = 2
const COMPOUND_INTRA: i64 = 3
const COMPOUND_DISTANCE: i64 = 4
const LOCALWARP: i64 = 2
const SWITCHABLE: i64 = 4
const SAMPLES_MAX: i64 = 8
const IM_PLANE_BYTES: i64 = 1

fn g(im: u64, k: i64) -> i64 {
    return av1mem.cell_get(im, k)
}

fn s(im: u64, k: i64, v: i64) {
    av1mem.cell_set(im, k, v)
}

fn imin(a: i64, b: i64) -> i64 {
    if a < b {
        return a
    }
    return b
}

fn imax(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    }
    return b
}

fn iabs(a: i64) -> i64 {
    if a < 0 {
        return 0 - a
    }
    return a
}

fn b2i(x: bool) -> i64 {
    if x {
        return 1
    }
    return 0
}

fn rd(sy: *mut av1sym.Sym, cdf: u64, cell: i64, n: i64) -> i64 {
    return av1sym.sym_read(sy, cdf + ((cell * 2) as u64), n)
}

fn im_bind(im: u64, mvp: u64, if0: u64, if1: u64, flags: u64, mc: i64, mr: i64) {
    s(im, I_MVP, mvp as i64)
    s(im, I_IF0, if0 as i64)
    s(im, I_IF1, if1 as i64)
    s(im, I_FLG, flags as i64)
    s(im, I_MC, mc)
    s(im, I_MR, mr)
}

fn im_set_tile(im: u64, row_start: i64, col_start: i64) {
    s(im, I_R0, row_start)
    s(im, I_C0, col_start)
}

fn im_set_frame(im: u64, reference_select: i64, skip_mode_present: i64, interintra: i64, masked: i64, jnt: i64, interp_filter: i64, dual_filter: i64, mm_switchable: i64, warp: i64) {
    s(im, I_REFSEL, reference_select)
    s(im, I_SMP, skip_mode_present)
    s(im, I_IIEN, interintra)
    s(im, I_MASKED, masked)
    s(im, I_JNT, jnt)
    s(im, I_INTERP, interp_filter)
    s(im, I_DUAL, dual_filter)
    s(im, I_MMSW, mm_switchable)
    s(im, I_WARP, warp)
}

fn im_set_skip_mode_frames(im: u64, f0: i64, f1: i64) {
    s(im, I_SKF0, f0)
    s(im, I_SKF1, f1)
}

fn im_set_ref_dist(im: u64, ref_frame: i64, abs_dist: i64) {
    s(im, I_DIST + ref_frame, abs_dist)
}

fn im_set_ref_scaled(im: u64, ref_frame: i64, scaled: i64) {
    s(im, I_SCALED + ref_frame, scaled)
}

fn im_out(im: u64, k: i64) -> i64 {
    return g(im, k)
}

fn at_of(im: u64, r: i64, c: i64) -> i64 {
    return r * g(im, I_MC) + c
}

fn im_filter_at(im: u64, r: i64, c: i64, dir: i64) -> i64 {
    var base: u64 = g(im, I_IF0) as u64
    if dir != 0 {
        base = g(im, I_IF1) as u64
    }
    return av1mem.byte_get(base, at_of(im, r, c))
}

fn flags_at(im: u64, r: i64, c: i64) -> i64 {
    return av1mem.byte_get(g(im, I_FLG) as u64, at_of(im, r, c))
}

fn im_begin_block(im: u64, r: i64, c: i64, size: i64, seg_ref: i64, seg_skip: i64, seg_gmv: i64) {
    let mvp: u64 = g(im, I_MVP) as u64
    s(im, I_R, r)
    s(im, I_C, c)
    s(im, I_SIZE, size)
    s(im, I_SEGREF, seg_ref)
    s(im, I_SEGSKIP, seg_skip)
    s(im, I_SEGGMV, seg_gmv)
    let au: i64 = b2i(r > g(im, I_R0))
    let al: i64 = b2i(c > g(im, I_C0))
    s(im, I_AU, au)
    s(im, I_AL, al)
    var a0: i64 = 0
    var a1: i64 = 0 - 1
    var l0: i64 = 0
    var l1: i64 = 0 - 1
    if au != 0 {
        a0 = av1mvp.mvp_rf(mvp, r - 1, c, 0)
        a1 = av1mvp.mvp_rf(mvp, r - 1, c, 1)
    }
    if al != 0 {
        l0 = av1mvp.mvp_rf(mvp, r, c - 1, 0)
        l1 = av1mvp.mvp_rf(mvp, r, c - 1, 1)
    }
    s(im, I_A0, a0)
    s(im, I_A1, a1)
    s(im, I_L0, l0)
    s(im, I_L1, l1)
    s(im, O_SKIP_MODE, 0)
    s(im, O_ISINTER, 0)
}

fn im_read_skip_mode(im: u64, sy: *mut av1sym.Sym, cdf: u64) -> i64 {
    let size: i64 = g(im, I_SIZE)
    let mvp: u64 = g(im, I_MVP) as u64
    var v: i64 = 0
    let blocked: bool = g(im, I_SEGSKIP) != 0 || g(im, I_SEGREF) >= 0 || g(im, I_SEGGMV) != 0 || g(im, I_SMP) == 0 || av1mvp.mvp_bw4(size) < 2 || av1mvp.mvp_bh4(size) < 2
    if !blocked {
        let r: i64 = g(im, I_R)
        let c: i64 = g(im, I_C)
        var a_sm: i64 = 0
        var l_sm: i64 = 0
        if g(im, I_AU) != 0 {
            a_sm = flags_at(im, r - 1, c) & 1
        }
        if g(im, I_AL) != 0 {
            l_sm = flags_at(im, r, c - 1) & 1
        }
        let ctx: i64 = av1ictx.ctx_skip_mode(g(im, I_AU), g(im, I_AL), a_sm, l_sm)
        v = rd(sy, cdf, (avif_cdf.M_SKIP_MODE as i64) + ctx * 3, 2)
    }
    s(im, O_SKIP_MODE, v)
    return v
}

fn im_read_is_inter(im: u64, sy: *mut av1sym.Sym, cdf: u64) -> i64 {
    var v: i64 = 1
    if g(im, O_SKIP_MODE) != 0 {
        v = 1
    } else {
        if g(im, I_SEGREF) >= 0 {
            v = b2i(g(im, I_SEGREF) != 0)
        } else {
            if g(im, I_SEGGMV) != 0 {
                v = 1
            } else {
                let ctx: i64 = av1ictx.ctx_is_inter(g(im, I_AU), g(im, I_AL), g(im, I_A0), g(im, I_L0))
                v = rd(sy, cdf, (avif_cdf.M_INTRA_INTER as i64) + ctx * 3, 2)
            }
        }
    }
    s(im, O_ISINTER, v)
    return v
}

fn ref_ctx(im: u64, kind: i64) -> i64 {
    return av1ictx.ctx_ref_kind(kind, g(im, I_AU), g(im, I_AL), g(im, I_A0), g(im, I_A1), g(im, I_L0), g(im, I_L1))
}

fn read_single_ref(im: u64, sy: *mut av1sym.Sym, cdf: u64, kind: i64, n: i64) -> i64 {
    let ctx: i64 = ref_ctx(im, kind)
    return rd(sy, cdf, (avif_cdf.M_SINGLE_REF as i64) + (ctx * 6 + n) * 3, 2)
}

fn read_comp_ref(im: u64, sy: *mut av1sym.Sym, cdf: u64, kind: i64, n: i64) -> i64 {
    let ctx: i64 = ref_ctx(im, kind)
    return rd(sy, cdf, (avif_cdf.M_COMP_REF as i64) + (ctx * 3 + n) * 3, 2)
}

fn read_comp_bwdref(im: u64, sy: *mut av1sym.Sym, cdf: u64, kind: i64, n: i64) -> i64 {
    let ctx: i64 = ref_ctx(im, kind)
    return rd(sy, cdf, (avif_cdf.M_COMP_BWDREF as i64) + (ctx * 2 + n) * 3, 2)
}

fn read_uni_comp_ref(im: u64, sy: *mut av1sym.Sym, cdf: u64, kind: i64, n: i64) -> i64 {
    let ctx: i64 = ref_ctx(im, kind)
    return rd(sy, cdf, (avif_cdf.M_UNI_COMP_REF as i64) + (ctx * 3 + n) * 3, 2)
}

fn read_compound_refs(im: u64, sy: *mut av1sym.Sym, cdf: u64) {
    let ctx: i64 = av1ictx.ctx_comp_ref_type(g(im, I_AU), g(im, I_AL), g(im, I_A0), g(im, I_A1), g(im, I_L0), g(im, I_L1))
    let ref_type: i64 = rd(sy, cdf, (avif_cdf.M_COMP_REF_TYPE as i64) + ctx * 3, 2)
    if ref_type == 0 {
        let u: i64 = read_uni_comp_ref(im, sy, cdf, av1ictx.REF_KIND_SINGLE_P1, 0)
        if u != 0 {
            s(im, O_RF0, 5)
            s(im, O_RF1, 7)
            return
        }
        let u1: i64 = read_uni_comp_ref(im, sy, cdf, av1ictx.REF_KIND_UNI_P1, 1)
        s(im, O_RF0, 1)
        if u1 != 0 {
            let u2: i64 = read_uni_comp_ref(im, sy, cdf, av1ictx.REF_KIND_COMP_P2, 2)
            if u2 != 0 {
                s(im, O_RF1, 4)
            } else {
                s(im, O_RF1, 3)
            }
        } else {
            s(im, O_RF1, 2)
        }
        return
    }
    let cr: i64 = read_comp_ref(im, sy, cdf, av1ictx.REF_KIND_COMP, 0)
    if cr == 0 {
        let p1: i64 = read_comp_ref(im, sy, cdf, av1ictx.REF_KIND_COMP_P1, 1)
        if p1 != 0 {
            s(im, O_RF0, 2)
        } else {
            s(im, O_RF0, 1)
        }
    } else {
        let p2: i64 = read_comp_ref(im, sy, cdf, av1ictx.REF_KIND_COMP_P2, 2)
        if p2 != 0 {
            s(im, O_RF0, 4)
        } else {
            s(im, O_RF0, 3)
        }
    }
    let cb: i64 = read_comp_bwdref(im, sy, cdf, av1ictx.REF_KIND_BWD, 0)
    if cb == 0 {
        let b1: i64 = read_comp_bwdref(im, sy, cdf, av1ictx.REF_KIND_BWD_P1, 1)
        if b1 != 0 {
            s(im, O_RF1, 6)
        } else {
            s(im, O_RF1, 5)
        }
    } else {
        s(im, O_RF1, 7)
    }
}

fn read_single_refs(im: u64, sy: *mut av1sym.Sym, cdf: u64) {
    s(im, O_RF1, 0 - 1)
    let p1: i64 = read_single_ref(im, sy, cdf, av1ictx.REF_KIND_SINGLE_P1, 0)
    if p1 != 0 {
        let p2: i64 = read_single_ref(im, sy, cdf, av1ictx.REF_KIND_BWD, 1)
        if p2 == 0 {
            let p6: i64 = read_single_ref(im, sy, cdf, av1ictx.REF_KIND_BWD_P1, 5)
            if p6 != 0 {
                s(im, O_RF0, 6)
            } else {
                s(im, O_RF0, 5)
            }
        } else {
            s(im, O_RF0, 7)
        }
        return
    }
    let p3: i64 = read_single_ref(im, sy, cdf, av1ictx.REF_KIND_COMP, 2)
    if p3 != 0 {
        let p5: i64 = read_single_ref(im, sy, cdf, av1ictx.REF_KIND_COMP_P2, 4)
        if p5 != 0 {
            s(im, O_RF0, 4)
        } else {
            s(im, O_RF0, 3)
        }
    } else {
        let p4: i64 = read_single_ref(im, sy, cdf, av1ictx.REF_KIND_COMP_P1, 3)
        if p4 != 0 {
            s(im, O_RF0, 2)
        } else {
            s(im, O_RF0, 1)
        }
    }
}

fn read_ref_frames(im: u64, sy: *mut av1sym.Sym, cdf: u64) {
    if g(im, O_SKIP_MODE) != 0 {
        s(im, O_RF0, g(im, I_SKF0))
        s(im, O_RF1, g(im, I_SKF1))
        return
    }
    if g(im, I_SEGREF) >= 0 {
        s(im, O_RF0, g(im, I_SEGREF))
        s(im, O_RF1, 0 - 1)
        return
    }
    if g(im, I_SEGSKIP) != 0 || g(im, I_SEGGMV) != 0 {
        s(im, O_RF0, 1)
        s(im, O_RF1, 0 - 1)
        return
    }
    let size: i64 = g(im, I_SIZE)
    var comp_mode: i64 = 0
    if g(im, I_REFSEL) != 0 && imin(av1mvp.mvp_bw4(size), av1mvp.mvp_bh4(size)) >= 2 {
        let ctx: i64 = av1ictx.ctx_comp_mode(g(im, I_AU), g(im, I_AL), g(im, I_A0), g(im, I_A1), g(im, I_L0), g(im, I_L1))
        comp_mode = rd(sy, cdf, (avif_cdf.M_COMP_INTER as i64) + ctx * 3, 2)
    }
    if comp_mode != 0 {
        read_compound_refs(im, sy, cdf)
    } else {
        read_single_refs(im, sy, cdf)
    }
}

fn has_nearmv(mode: i64) -> bool {
    return mode == NEARMV || mode == NEAR_NEARMV || mode == NEAR_NEWMV || mode == NEW_NEARMV
}

fn get_mode(ymode: i64, list: i64) -> i64 {
    if list == 0 {
        if ymode < NEAREST_NEARESTMV {
            return ymode
        }
        if ymode == NEW_NEWMV || ymode == NEW_NEARESTMV || ymode == NEW_NEARMV {
            return NEWMV
        }
        if ymode == NEAREST_NEARESTMV || ymode == NEAREST_NEWMV {
            return NEARESTMV
        }
        if ymode == NEAR_NEARMV || ymode == NEAR_NEWMV {
            return NEARMV
        }
        return GLOBALMV
    }
    if ymode == NEW_NEWMV || ymode == NEAREST_NEWMV || ymode == NEAR_NEWMV {
        return NEWMV
    }
    if ymode == NEAREST_NEARESTMV || ymode == NEW_NEARESTMV {
        return NEARESTMV
    }
    if ymode == NEAR_NEARMV || ymode == NEW_NEARMV {
        return NEARMV
    }
    return GLOBALMV
}

fn read_drl(im: u64, sy: *mut av1sym.Sym, cdf: u64, first: i64) -> i64 {
    let mvp: u64 = g(im, I_MVP) as u64
    let num: i64 = av1mvp.mvp_num(mvp)
    var ref_idx: i64 = first
    var idx: i64 = first
    while idx < first + 2 {
        if num > idx + 1 {
            let ctx: i64 = av1mvp.mvp_drl_ctx(mvp, idx)
            let drl: i64 = rd(sy, cdf, (avif_cdf.M_DRL as i64) + ctx * 3, 2)
            if drl == 0 {
                return idx
            }
            ref_idx = idx + 1
        }
        idx = idx + 1
    }
    return ref_idx
}

fn read_inter_mode(im: u64, sy: *mut av1sym.Sym, cdf: u64, compound: i64) -> i64 {
    let mvp: u64 = g(im, I_MVP) as u64
    if g(im, O_SKIP_MODE) != 0 {
        return NEAREST_NEARESTMV
    }
    if g(im, I_SEGSKIP) != 0 || g(im, I_SEGGMV) != 0 {
        return GLOBALMV
    }
    if compound != 0 {
        let ctx: i64 = av1ictx.ctx_compound_mode(av1mvp.mvp_ref_ctx(mvp), av1mvp.mvp_new_ctx(mvp))
        return NEAREST_NEARESTMV + rd(sy, cdf, (avif_cdf.M_INTER_COMPOUND_MODE as i64) + ctx * 9, 8)
    }
    let new_mv: i64 = rd(sy, cdf, (avif_cdf.M_NEWMV as i64) + av1mvp.mvp_new_ctx(mvp) * 3, 2)
    if new_mv == 0 {
        return NEWMV
    }
    let zero_mv: i64 = rd(sy, cdf, (avif_cdf.M_ZEROMV as i64) + av1mvp.mvp_zero_ctx(mvp) * 3, 2)
    if zero_mv == 0 {
        return GLOBALMV
    }
    let ref_mv: i64 = rd(sy, cdf, (avif_cdf.M_REFMV as i64) + av1mvp.mvp_ref_ctx(mvp) * 3, 2)
    if ref_mv == 0 {
        return NEARESTMV
    }
    return NEARMV
}

fn assign_mv(im: u64, sy: *mut av1sym.Sym, cdf: u64, compound: i64) {
    let mvp: u64 = g(im, I_MVP) as u64
    let ymode: i64 = g(im, O_YMODE)
    let ref_idx: i64 = g(im, O_REF_MV_IDX)
    let num: i64 = av1mvp.mvp_num(mvp)
    let scratch: u64 = im + ((I_SCR * 8) as u64)
    var i: i64 = 0
    while i < 1 + compound {
        let cm: i64 = get_mode(ymode, i)
        var pr: i64 = 0
        var pc: i64 = 0
        if cm == GLOBALMV {
            pr = av1mvp.mvp_global_mv(mvp, i, 0)
            pc = av1mvp.mvp_global_mv(mvp, i, 1)
        } else {
            var pos: i64 = ref_idx
            if cm == NEARESTMV {
                pos = 0
            }
            if cm == NEWMV && num <= 1 {
                pos = 0
            }
            pr = av1mvp.mvp_stack_mv(mvp, pos, i, 0)
            pc = av1mvp.mvp_stack_mv(mvp, pos, i, 1)
        }
        if cm == NEWMV {
            av1mv.mv_read_diff(sy, cdf, 0, av1mvp.mvp_force_int(mvp), av1mvp.mvp_allow_hp(mvp), scratch)
            pr = pr + av1mem.cell_get(scratch, 0)
            pc = pc + av1mem.cell_get(scratch, 1)
        }
        s(im, O_MV + i * 2, pr)
        s(im, O_MV + i * 2 + 1, pc)
        i = i + 1
    }
}

fn read_interintra(im: u64, sy: *mut av1sym.Sym, cdf: u64, compound: i64) {
    let size: i64 = g(im, I_SIZE)
    s(im, O_INTERINTRA, 0)
    s(im, O_WEDGE_II, 0)
    s(im, O_WEDGE_SIGN, 0)
    s(im, O_WEDGE_IDX, 0)
    s(im, O_II_MODE, 0)
    if g(im, O_SKIP_MODE) == 0 && g(im, I_IIEN) != 0 && compound == 0 && size >= 3 && size <= 9 {
        let ctx: i64 = av1ictx.size_group(size)
        let ii: i64 = rd(sy, cdf, (avif_cdf.M_INTERINTRA as i64) + ctx * 3, 2)
        s(im, O_INTERINTRA, ii)
        if ii != 0 {
            s(im, O_II_MODE, rd(sy, cdf, (avif_cdf.M_INTERINTRA_MODE as i64) + ctx * 5, 4))
            s(im, O_RF1, 0)
            let w: i64 = rd(sy, cdf, (avif_cdf.M_WEDGE_INTERINTRA as i64) + size * 3, 2)
            s(im, O_WEDGE_II, w)
            if w != 0 {
                s(im, O_WEDGE_IDX, rd(sy, cdf, (avif_cdf.M_WEDGE_IDX as i64) + size * 17, 16))
            }
        }
    }
}

fn has_overlappable(im: u64) -> bool {
    let mvp: u64 = g(im, I_MVP) as u64
    let r: i64 = g(im, I_R)
    let c: i64 = g(im, I_C)
    let size: i64 = g(im, I_SIZE)
    if g(im, I_AU) != 0 {
        let lim: i64 = imin(g(im, I_MC), c + av1mvp.mvp_bw4(size))
        var x4: i64 = c
        while x4 < lim {
            if av1mvp.mvp_rf(mvp, r - 1, x4 | 1, 0) > 0 {
                return true
            }
            x4 = x4 + 2
        }
    }
    if g(im, I_AL) != 0 {
        let lim: i64 = imin(g(im, I_MR), r + av1mvp.mvp_bh4(size))
        var y4: i64 = r
        while y4 < lim {
            if av1mvp.mvp_rf(mvp, y4 | 1, c - 1, 0) > 0 {
                return true
            }
            y4 = y4 + 2
        }
    }
    return false
}

fn add_sample(im: u64, dr: i64, dc: i64) {
    let mvp: u64 = g(im, I_MVP) as u64
    if g(im, I_NSCAN) >= SAMPLES_MAX {
        return
    }
    let mr: i64 = g(im, I_R) + dr
    let mc: i64 = g(im, I_C) + dc
    if !av1mvp.mvp_inside(mvp, mr, mc) {
        return
    }
    if !av1mvp.mvp_written(mvp, mr, mc) {
        return
    }
    if av1mvp.mvp_rf(mvp, mr, mc, 0) != g(im, O_RF0) {
        return
    }
    if av1mvp.mvp_rf(mvp, mr, mc, 1) != 0 - 1 {
        return
    }
    let size: i64 = g(im, I_SIZE)
    let cand: i64 = av1mvp.mvp_size_at(mvp, mr, mc)
    let cw4: i64 = av1mvp.mvp_bw4(cand)
    let ch4: i64 = av1mvp.mvp_bh4(cand)
    let cand_row: i64 = mr & (0 - ch4)
    let cand_col: i64 = mc & (0 - cw4)
    var threshold: i64 = imax(av1mvp.mvp_bw4(size), av1mvp.mvp_bh4(size)) * 4
    if threshold < 16 {
        threshold = 16
    }
    if threshold > 112 {
        threshold = 112
    }
    let dr_mv: i64 = iabs(av1mvp.mvp_mv(mvp, cand_row, cand_col, 0, 0) - g(im, O_MV))
    let dc_mv: i64 = iabs(av1mvp.mvp_mv(mvp, cand_row, cand_col, 0, 1) - g(im, O_MV + 1))
    let valid: bool = dr_mv + dc_mv <= threshold
    s(im, I_NSCAN, g(im, I_NSCAN) + 1)
    if !valid && g(im, I_NSCAN) > 1 {
        return
    }
    if valid {
        s(im, O_NUM_SAMPLES, g(im, O_NUM_SAMPLES) + 1)
    }
}

fn find_warp_samples(im: u64) -> i64 {
    let mvp: u64 = g(im, I_MVP) as u64
    let r: i64 = g(im, I_R)
    let c: i64 = g(im, I_C)
    let size: i64 = g(im, I_SIZE)
    let w4: i64 = av1mvp.mvp_bw4(size)
    let h4: i64 = av1mvp.mvp_bh4(size)
    s(im, I_NSCAN, 0)
    s(im, O_NUM_SAMPLES, 0)
    var do_top_left: i64 = 1
    var do_top_right: i64 = 1
    if g(im, I_AU) != 0 {
        let src_w: i64 = av1mvp.mvp_bw4(av1mvp.mvp_size_at(mvp, r - 1, c))
        if w4 <= src_w {
            let col_offset: i64 = 0 - (c & (src_w - 1))
            if col_offset < 0 {
                do_top_left = 0
            }
            if col_offset + src_w > w4 {
                do_top_right = 0
            }
            add_sample(im, 0 - 1, 0)
        } else {
            let lim: i64 = imin(w4, g(im, I_MC) - c)
            var i: i64 = 0
            while i < lim {
                let sw: i64 = av1mvp.mvp_bw4(av1mvp.mvp_size_at(mvp, r - 1, c + i))
                add_sample(im, 0 - 1, i)
                i = i + imin(w4, sw)
            }
        }
    }
    if g(im, I_AL) != 0 {
        let src_h: i64 = av1mvp.mvp_bh4(av1mvp.mvp_size_at(mvp, r, c - 1))
        if h4 <= src_h {
            let row_offset: i64 = 0 - (r & (src_h - 1))
            if row_offset < 0 {
                do_top_left = 0
            }
            add_sample(im, 0, 0 - 1)
        } else {
            let lim: i64 = imin(h4, g(im, I_MR) - r)
            var i: i64 = 0
            while i < lim {
                let sh: i64 = av1mvp.mvp_bh4(av1mvp.mvp_size_at(mvp, r + i, c - 1))
                add_sample(im, i, 0 - 1)
                i = i + imin(h4, sh)
            }
        }
    }
    if do_top_left != 0 {
        add_sample(im, 0 - 1, 0 - 1)
    }
    if do_top_right != 0 {
        if imax(w4, h4) <= 16 {
            add_sample(im, 0 - 1, w4)
        }
    }
    if g(im, O_NUM_SAMPLES) == 0 && g(im, I_NSCAN) > 0 {
        s(im, O_NUM_SAMPLES, 1)
    }
    return g(im, O_NUM_SAMPLES)
}

fn read_motion_mode(im: u64, sy: *mut av1sym.Sym, cdf: u64, compound: i64) {
    let mvp: u64 = g(im, I_MVP) as u64
    let size: i64 = g(im, I_SIZE)
    let ymode: i64 = g(im, O_YMODE)
    let rf0: i64 = g(im, O_RF0)
    s(im, O_MOTION_MODE, 0)
    s(im, O_NUM_SAMPLES, 0)
    if g(im, O_SKIP_MODE) != 0 || g(im, I_MMSW) == 0 {
        return
    }
    if imin(av1mvp.mvp_bw4(size), av1mvp.mvp_bh4(size)) < 2 {
        return
    }
    if av1mvp.mvp_force_int(mvp) == 0 && (ymode == GLOBALMV || ymode == GLOBAL_GLOBALMV) {
        if av1mvp.mvp_gm_type(mvp, rf0) > 1 {
            return
        }
    }
    if compound != 0 || g(im, O_RF1) == 0 || !has_overlappable(im) {
        return
    }
    let ns: i64 = find_warp_samples(im)
    if av1mvp.mvp_force_int(mvp) != 0 || ns == 0 || g(im, I_WARP) == 0 || g(im, I_SCALED + rf0) != 0 {
        s(im, O_MOTION_MODE, rd(sy, cdf, (avif_cdf.M_OBMC as i64) + size * 3, 2))
    } else {
        s(im, O_MOTION_MODE, rd(sy, cdf, (avif_cdf.M_MOTION_MODE as i64) + size * 4, 3))
    }
}

fn read_compound_type(im: u64, sy: *mut av1sym.Sym, cdf: u64, compound: i64) {
    let size: i64 = g(im, I_SIZE)
    let r: i64 = g(im, I_R)
    let c: i64 = g(im, I_C)
    s(im, O_CGI, 0)
    s(im, O_CIDX, 1)
    s(im, O_MASK_TYPE, 0)
    if g(im, O_SKIP_MODE) != 0 {
        s(im, O_COMP_TYPE, COMPOUND_AVERAGE)
        return
    }
    if compound == 0 {
        if g(im, O_INTERINTRA) != 0 {
            if g(im, O_WEDGE_II) != 0 {
                s(im, O_COMP_TYPE, COMPOUND_WEDGE)
            } else {
                s(im, O_COMP_TYPE, COMPOUND_INTRA)
            }
        } else {
            s(im, O_COMP_TYPE, COMPOUND_AVERAGE)
        }
        return
    }
    let au: i64 = g(im, I_AU)
    let al: i64 = g(im, I_AL)
    var a_cgi: i64 = 0
    var l_cgi: i64 = 0
    var a_cidx: i64 = 0
    var l_cidx: i64 = 0
    if au != 0 {
        let f: i64 = flags_at(im, r - 1, c)
        a_cgi = (f >> 1) & 1
        a_cidx = (f >> 2) & 1
    }
    if al != 0 {
        let f: i64 = flags_at(im, r, c - 1)
        l_cgi = (f >> 1) & 1
        l_cidx = (f >> 2) & 1
    }
    var ct: i64 = COMPOUND_AVERAGE
    var cgi: i64 = 0
    if g(im, I_MASKED) != 0 {
        let ctx: i64 = av1ictx.ctx_comp_group_idx(au, al, g(im, I_A0), g(im, I_A1), g(im, I_L0), g(im, I_L1), a_cgi, l_cgi)
        cgi = rd(sy, cdf, (avif_cdf.M_COMP_GROUP_IDX as i64) + ctx * 3, 2)
    }
    s(im, O_CGI, cgi)
    if cgi == 0 {
        if g(im, I_JNT) != 0 {
            let fwd: i64 = g(im, I_DIST + g(im, O_RF0))
            let bck: i64 = g(im, I_DIST + g(im, O_RF1))
            let ctx: i64 = av1ictx.ctx_compound_idx(fwd, bck, au, al, g(im, I_A0), g(im, I_A1), g(im, I_L0), g(im, I_L1), a_cidx, l_cidx)
            let cidx: i64 = rd(sy, cdf, (avif_cdf.M_COMPOUND_IDX as i64) + ctx * 3, 2)
            s(im, O_CIDX, cidx)
            if cidx == 0 {
                ct = COMPOUND_DISTANCE
            }
        }
    } else {
        if av1ictx.wedge_bits(size) == 0 {
            ct = COMPOUND_DIFFWTD
        } else {
            ct = rd(sy, cdf, (avif_cdf.M_COMPOUND_TYPE as i64) + size * 3, 2)
        }
    }
    s(im, O_COMP_TYPE, ct)
    if ct == COMPOUND_WEDGE {
        s(im, O_WEDGE_IDX, rd(sy, cdf, (avif_cdf.M_WEDGE_IDX as i64) + size * 17, 16))
        s(im, O_WEDGE_SIGN, av1sym.sym_literal(sy, 1))
    }
    if ct == COMPOUND_DIFFWTD {
        s(im, O_MASK_TYPE, av1sym.sym_literal(sy, 1))
    }
}

fn needs_interp_filter(im: u64) -> bool {
    let mvp: u64 = g(im, I_MVP) as u64
    let size: i64 = g(im, I_SIZE)
    let ymode: i64 = g(im, O_YMODE)
    let large: bool = imin(av1mvp.mvp_bw4(size), av1mvp.mvp_bh4(size)) >= 2
    if g(im, O_SKIP_MODE) != 0 || g(im, O_MOTION_MODE) == LOCALWARP {
        return false
    }
    if large && ymode == GLOBALMV {
        return av1mvp.mvp_gm_type(mvp, g(im, O_RF0)) == 1
    }
    if large && ymode == GLOBAL_GLOBALMV {
        return av1mvp.mvp_gm_type(mvp, g(im, O_RF0)) == 1 || av1mvp.mvp_gm_type(mvp, g(im, O_RF1)) == 1
    }
    return true
}

fn read_interp_filters(im: u64, sy: *mut av1sym.Sym, cdf: u64) {
    let r: i64 = g(im, I_R)
    let c: i64 = g(im, I_C)
    let au: i64 = g(im, I_AU)
    let al: i64 = g(im, I_AL)
    if g(im, I_INTERP) != SWITCHABLE {
        s(im, O_FILTER0, g(im, I_INTERP))
        s(im, O_FILTER1, g(im, I_INTERP))
        return
    }
    var dirs: i64 = 1
    if g(im, I_DUAL) != 0 {
        dirs = 2
    }
    let needs: bool = needs_interp_filter(im)
    var dir: i64 = 0
    while dir < dirs {
        var v: i64 = 0
        if needs {
            var a_f: i64 = 0
            var l_f: i64 = 0
            if au != 0 {
                a_f = im_filter_at(im, r - 1, c, dir)
            }
            if al != 0 {
                l_f = im_filter_at(im, r, c - 1, dir)
            }
            let ctx: i64 = av1ictx.ctx_interp_filter(dir, g(im, O_RF0), g(im, O_RF1), au, al, g(im, I_A0), g(im, I_A1), a_f, g(im, I_L0), g(im, I_L1), l_f)
            v = rd(sy, cdf, (avif_cdf.M_SWITCHABLE_INTERP as i64) + ctx * 4, 3)
        }
        s(im, O_FILTER0 + dir, v)
        dir = dir + 1
    }
    if g(im, I_DUAL) == 0 {
        s(im, O_FILTER1, g(im, O_FILTER0))
    }
}

fn im_read_inter_block(im: u64, sy: *mut av1sym.Sym, cdf: u64) -> i64 {
    let mvp: u64 = g(im, I_MVP) as u64
    read_ref_frames(im, sy, cdf)
    let compound: i64 = b2i(g(im, O_RF1) > 0)
    let rc: i64 = av1mvp.mvp_find(mvp, g(im, I_R), g(im, I_C), g(im, I_SIZE), g(im, O_RF0), g(im, O_RF1))
    if rc < 0 {
        return 0 - 1
    }
    s(im, O_NUM_FOUND, av1mvp.mvp_num(mvp))
    let ymode: i64 = read_inter_mode(im, sy, cdf, compound)
    s(im, O_YMODE, ymode)
    var ref_idx: i64 = 0
    if ymode == NEWMV || ymode == NEW_NEWMV {
        ref_idx = read_drl(im, sy, cdf, 0)
    } else {
        if has_nearmv(ymode) {
            ref_idx = read_drl(im, sy, cdf, 1)
        }
    }
    s(im, O_REF_MV_IDX, ref_idx)
    assign_mv(im, sy, cdf, compound)
    read_interintra(im, sy, cdf, compound)
    read_motion_mode(im, sy, cdf, compound)
    read_compound_type(im, sy, cdf, compound)
    read_interp_filters(im, sy, cdf)
    s(im, O_ISINTER, 1)
    return 0
}

fn im_set_intra(im: u64, ymode: i64) {
    s(im, O_ISINTER, 0)
    s(im, O_RF0, 0)
    s(im, O_RF1, 0 - 1)
    s(im, O_YMODE, ymode)
    s(im, O_MV, 0)
    s(im, O_MV + 1, 0)
    s(im, O_MV + 2, 0)
    s(im, O_MV + 3, 0)
    s(im, O_CGI, 0)
    s(im, O_CIDX, 0)
    s(im, O_FILTER0, 0)
    s(im, O_FILTER1, 0)
}

fn im_store_block(im: u64) {
    let mvp: u64 = g(im, I_MVP) as u64
    let r: i64 = g(im, I_R)
    let c: i64 = g(im, I_C)
    let size: i64 = g(im, I_SIZE)
    av1mvp.mvp_store(mvp, r, c, size, g(im, O_ISINTER), g(im, O_RF0), g(im, O_RF1), g(im, O_YMODE), g(im, O_MV), g(im, O_MV + 1), g(im, O_MV + 2), g(im, O_MV + 3))
    let mc: i64 = g(im, I_MC)
    let mr: i64 = g(im, I_MR)
    let flags: i64 = (g(im, O_SKIP_MODE) & 1) | ((g(im, O_CGI) & 1) << 1) | ((g(im, O_CIDX) & 1) << 2)
    let bw4: i64 = av1mvp.mvp_bw4(size)
    let bh4: i64 = av1mvp.mvp_bh4(size)
    var y: i64 = 0
    while y < bh4 {
        var x: i64 = 0
        while x < bw4 {
            if r + y < mr && c + x < mc {
                let at: i64 = (r + y) * mc + c + x
                av1mem.byte_set(g(im, I_IF0) as u64, at, g(im, O_FILTER0))
                av1mem.byte_set(g(im, I_IF1) as u64, at, g(im, O_FILTER1))
                av1mem.byte_set(g(im, I_FLG) as u64, at, flags)
            }
            x = x + 1
        }
        y = y + 1
    }
}
