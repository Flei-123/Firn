// SPDX-License-Identifier: MPL-2.0
import av1.av1sym
import av1.avif_cdf

export { mv_read_diff, mv_cdf_joint, mv_cdf_class, mv_cdf_class0_fr, mv_cdf_fr, mv_cdf_sign, mv_cdf_class0_bit, mv_cdf_class0_hp, mv_cdf_hp, mv_cdf_bit, MV_CTX_INTRABC }

const MV_CTX_INTRABC: i64 = 1

fn mv_cdf_joint(ctx: i64) -> i64 {
    return (avif_cdf.M_MV_JOINT as i64) + ctx * 5
}

fn mv_cdf_class(ctx: i64, comp: i64) -> i64 {
    return (avif_cdf.M_MV_CLASS as i64) + (ctx * 2 + comp) * 12
}

fn mv_cdf_class0_fr(ctx: i64, comp: i64, bit: i64) -> i64 {
    return (avif_cdf.M_MV_CLASS0_FR as i64) + ((ctx * 2 + comp) * 2 + bit) * 5
}

fn mv_cdf_fr(ctx: i64, comp: i64) -> i64 {
    return (avif_cdf.M_MV_FR as i64) + (ctx * 2 + comp) * 5
}

fn mv_cdf_sign(ctx: i64, comp: i64) -> i64 {
    return (avif_cdf.M_MV_SIGN as i64) + (ctx * 2 + comp) * 3
}

fn mv_cdf_class0_bit(ctx: i64, comp: i64) -> i64 {
    return (avif_cdf.M_MV_CLASS0_BIT as i64) + (ctx * 2 + comp) * 3
}

fn mv_cdf_class0_hp(ctx: i64, comp: i64) -> i64 {
    return (avif_cdf.M_MV_CLASS0_HP as i64) + (ctx * 2 + comp) * 3
}

fn mv_cdf_hp(ctx: i64, comp: i64) -> i64 {
    return (avif_cdf.M_MV_HP as i64) + (ctx * 2 + comp) * 3
}

fn mv_cdf_bit(ctx: i64, comp: i64, i: i64) -> i64 {
    return (avif_cdf.M_MV_BIT as i64) + ((ctx * 2 + comp) * 10 + i) * 3
}

fn sym_at(sy: *mut av1sym.Sym, cdf: u64, at: i64, n: i64) -> i64 {
    return av1sym.sym_read(sy, cdf + ((at * 2) as u64), n)
}

fn read_component(sy: *mut av1sym.Sym, cdf: u64, ctx: i64, comp: i64, force_int: i64, allow_hp: i64) -> i64 {
    let sign: i64 = sym_at(sy, cdf, mv_cdf_sign(ctx, comp), 2)
    let cls: i64 = sym_at(sy, cdf, mv_cdf_class(ctx, comp), 11)
    var mag: i64 = 0
    if cls == 0 {
        let bit: i64 = sym_at(sy, cdf, mv_cdf_class0_bit(ctx, comp), 2)
        var fr: i64 = 3
        if force_int == 0 {
            fr = sym_at(sy, cdf, mv_cdf_class0_fr(ctx, comp, bit), 4)
        }
        var hp: i64 = 1
        if allow_hp != 0 {
            hp = sym_at(sy, cdf, mv_cdf_class0_hp(ctx, comp), 2)
        }
        mag = ((bit << 3) | (fr << 1) | hp) + 1
    } else {
        var d: i64 = 0
        var i: i64 = 0
        while i < cls {
            let bit: i64 = sym_at(sy, cdf, mv_cdf_bit(ctx, comp, i), 2)
            d = d | (bit << i)
            i = i + 1
        }
        mag = 2 << (cls + 2)
        var fr: i64 = 3
        if force_int == 0 {
            fr = sym_at(sy, cdf, mv_cdf_fr(ctx, comp), 4)
        }
        var hp: i64 = 1
        if allow_hp != 0 {
            hp = sym_at(sy, cdf, mv_cdf_hp(ctx, comp), 2)
        }
        mag = mag + ((d << 3) | (fr << 1) | hp) + 1
    }
    if sign != 0 {
        return 0 - mag
    }
    return mag
}

fn mv_read_diff(sy: *mut av1sym.Sym, cdf: u64, ctx: i64, force_int: i64, allow_hp: i64, out: u64) -> i64 {
    let joint: i64 = sym_at(sy, cdf, mv_cdf_joint(ctx), 4)
    var dr: i64 = 0
    var dc: i64 = 0
    if joint == 2 || joint == 3 {
        dr = read_component(sy, cdf, ctx, 0, force_int, allow_hp)
    }
    if joint == 1 || joint == 3 {
        dc = read_component(sy, cdf, ctx, 1, force_int, allow_hp)
    }
    *(out as *mut i64) = dr
    *((out + 8) as *mut i64) = dc
    return joint
}
