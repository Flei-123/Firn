// SPDX-License-Identifier: MPL-2.0
// lib/av1/av1recon.fi -- AV1 dequantization and residual reconstruction.
import rt.rt
import av1.av1txfm
import av1.av1lt

export { dequant_denom, recon_block, recon_work_size }

#[no_gc]
fn ldq(p: u64, i: i64) -> i64 {
    return (*((p + ((i * 4) as u64)) as *mut i32)) as i64
}

#[no_gc]
fn stq(p: u64, i: i64, v: i64) {
    *((p + ((i * 4) as u64)) as *mut i32) = v as i32
}

fn dequant_denom(tx_size: i64) -> i64 {
    if tx_size == 3 || tx_size == 9 || tx_size == 10 || tx_size == 17 || tx_size == 18 {
        return 2
    }
    if tx_size == 4 || tx_size == 11 || tx_size == 12 {
        return 4
    }
    return 1
}

fn recon_work_size() -> i64 {
    return (5120 + 128) * 4
}

fn recon_block(work: u64, quant: u64, plane: u64, stride: i64, x: i64, y: i64, plane_w: i64, plane_h: i64,
               tx_size: i64, tx_type: i64, dcq: i64, acq: i64, bit_depth: i64) {
    let log2w: i64 = av1txfm.tx_log2w(tx_size)
    let log2h: i64 = av1txfm.tx_log2h(tx_size)
    let w: i64 = 1 << log2w
    let h: i64 = 1 << log2h
    var tw: i64 = w
    if tw > 32 {
        tw = 32
    }
    var th: i64 = h
    if th > 32 {
        th = 32
    }
    let denom: i64 = dequant_denom(tx_size)
    let lim: i64 = 1 << (7 + bit_depth)
    var i: i64 = 0
    while i < th {
        var j: i64 = 0
        while j < tw {
            var q: i64 = acq
            if i == 0 && j == 0 {
                q = dcq
            }
            let dq: i64 = ldq(quant, i * tw + j) * q
            var a: i64 = dq
            var neg: i64 = 0
            if dq < 0 {
                a = 0 - dq
                neg = 1
            }
            a = (a & 16777215) / denom
            if neg != 0 {
                a = 0 - a
            }
            if a < 0 - lim {
                a = 0 - lim
            }
            if a > lim - 1 {
                a = lim - 1
            }
            stq(work, i * tw + j, a)
            j = j + 1
        }
        i = i + 1
    }
    let res: u64 = work + 4096
    let w1d: u64 = work + 20480
    av1txfm.inv_txfm_2d(work, tw, res, w1d, tx_size, tx_type, bit_depth)
    let fud: i64 = av1txfm.flip_ud(tx_type)
    let flr: i64 = av1txfm.flip_lr(tx_type)
    let maxv: i64 = (1 << bit_depth) - 1
    i = 0
    while i < h {
        var j: i64 = 0
        while j < w {
            var xx: i64 = j
            if flr != 0 {
                xx = w - j - 1
            }
            var yy: i64 = i
            if fud != 0 {
                yy = h - i - 1
            }
            let px: i64 = x + xx
            let py: i64 = y + yy
            if px < plane_w && py < plane_h {
                let ap: u64 = plane + ((py * stride + px) as u64)
                var v: i64 = (*(ap as *mut u8)) as i64 + ldq(res, i * w + j)
                if v < 0 {
                    v = 0
                }
                if v > maxv {
                    v = maxv
                }
                *(ap as *mut u8) = v as u8
            }
            j = j + 1
        }
        i = i + 1
    }
}
