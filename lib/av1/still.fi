// SPDX-License-Identifier: MPL-2.0
// lib/av1/still.fi -- AV1 still picture (AVIF) decoder API: bytes in, planar YUV out (8 bit u8, 10 bit u16 LE).
import rt.rt
import av1.av1mem
import av1.avif
import av1.av1tile
import av1.av1lf
import av1.av1cdef
import av1.av1lr
import av1.av1fg
import av1.av1sr
import av1.av1pic

export { Frame, frame_new, frame_free, decode_frame, output_pic, still_decode, still_decode_limited, STILL_OK, STILL_NOT_AVIF, STILL_UNSUPPORTED, STILL_TILE_ERROR, STILL_TOO_LARGE, STILL_MAX_PIXELS }

const STILL_OK: i32 = 0
const STILL_NOT_AVIF: i32 = 1
const STILL_UNSUPPORTED: i32 = 2
const STILL_TILE_ERROR: i32 = 10
const STILL_TOO_LARGE: i32 = 3
const STILL_MAX_PIXELS: i64 = 67108864

struct Frame {
    width: i64,
    height: i64,
    planes: i64,
    sub_x: i64,
    sub_y: i64,
    depth: i64,
    y: u64,
    u: u64,
    v: u64,
    y_bytes: usize,
    u_bytes: usize,
    v_bytes: usize,
}

struct Planes {
    p0: u64,
    p1: u64,
    p2: u64,
    stride: i64,
    bytes: usize,
}

fn frame_new() -> Frame {
    return Frame { width: 0, height: 0, planes: 0, sub_x: 0, sub_y: 0, depth: 8, y: 0, u: 0, v: 0, y_bytes: 0, u_bytes: 0, v_bytes: 0 }
}

fn frame_free(f: *mut Frame) {
    av1mem.heap_free((*f).y as *mut u8, (*f).y_bytes)
    av1mem.heap_free((*f).u as *mut u8, (*f).u_bytes)
    av1mem.heap_free((*f).v as *mut u8, (*f).v_bytes)
    *f = frame_new()
}

fn cell(info: u64, i: usize) -> i64 {
    return avif.avif_cell(info, i)
}

fn fits(info: u64, max_pixels: i64) -> bool {
    let fb: usize = avif.FH_BASE
    let w: i64 = cell(info, avif.AI_WIDTH)
    let h: i64 = cell(info, avif.AI_HEIGHT)
    let mw: i64 = cell(info, fb + avif.FH_MI_COLS) * 4
    let mh: i64 = cell(info, fb + avif.FH_MI_ROWS) * 4
    if w <= 0 || h <= 0 || mw <= 0 || mh <= 0 {
        return false
    }
    if w > 65536 || h > 65536 || mw > 65536 + 64 || mh > 65536 + 64 {
        return false
    }
    var lim: i64 = mw
    let up_w: i64 = cell(info, fb + avif.FH_UP_W)
    if up_w > cell(info, fb + avif.FH_FRAME_W) {
        lim = up_w
        if up_w > 65536 || up_w * mh > max_pixels + max_pixels / 4 + 8192 {
            return false
        }
    }
    if w > lim || h > mh {
        return false
    }
    return w * h <= max_pixels && mw * mh <= max_pixels + max_pixels / 4 + 8192
}

fn crop_plane(src: u64, stride: i64, w: i64, h: i64, bd: i64, bytes: *mut usize) -> u64 {
    var unit: i64 = 1
    if bd > 8 {
        unit = 2
    }
    let n: usize = (w * h * unit) as usize
    let dst: u64 = av1mem.heap_alloc(n) as u64
    *bytes = n
    if dst == 0 {
        return 0
    }
    var row: i64 = 0
    while row < h {
        let drow: u64 = dst + ((row * w * unit) as u64)
        let srow: u64 = src + ((row * stride * 2) as u64)
        if bd > 8 {
            av1mem.mem_copy(drow as *mut u8, srow as *mut u8, (w * 2) as usize)
        } else {
            var col: i64 = 0
            while col < w {
                *((drow + (col as u64)) as *mut u8) = (*((srow + ((col * 2) as u64)) as *mut u16)) as u8
                col = col + 1
            }
        }
        row = row + 1
    }
    return dst
}

fn still_decode(src: u64, n: usize, f: *mut Frame) -> i32 {
    return still_decode_limited(src, n, STILL_MAX_PIXELS, f)
}

fn still_decode_limited(src: u64, n: usize, max_pixels: i64, f: *mut Frame) -> i32 {
    let info: u64 = avif.avif_parse(src, n)
    if info == 0 {
        return STILL_NOT_AVIF
    }
    var rc: i32 = STILL_TOO_LARGE
    if fits(info, max_pixels) {
        rc = decode_info(src, info, f)
    }
    avif.avif_info_free(info)
    return rc
}

fn set_tile_grid(t: u64, info: u64) {
    let fb: usize = avif.FH_BASE
    let tcols: i64 = cell(info, fb + avif.FH_TCOLS)
    let trows: i64 = cell(info, fb + avif.FH_TROWS)
    if tcols * trows <= 1 {
        return
    }
    av1tile.tile_set_grid(t, tcols, trows, cell(info, fb + avif.FH_TSIZE_BYTES))
    var i: i64 = 0
    while i <= tcols {
        av1tile.tile_set_col_start(t, i, cell(info, fb + avif.FH_TCSTART + (i as usize)))
        i = i + 1
    }
    i = 0
    while i <= trows {
        av1tile.tile_set_row_start(t, i, cell(info, fb + avif.FH_TRSTART + (i as usize)))
        i = i + 1
    }
}

fn decode_info(src: u64, info: u64, f: *mut Frame) -> i32 {
    let fb: usize = avif.FH_BASE
    if cell(info, fb + avif.FH_SHOW_EXISTING) != 0 || cell(info, fb + avif.FH_FRAME_TYPE) != 0 || cell(info, fb + avif.FH_SHOW) == 0 {
        return STILL_UNSUPPORTED
    }
    var keep: u64 = 0
    return decode_frame(src, info, f, &keep, false, true)
}

fn decode_frame(src: u64, info: u64, f: *mut Frame, pic_out: *mut u64, keep: bool, show: bool) -> i32 {
    let fb: usize = avif.FH_BASE
    if cell(info, fb + avif.FH_OK) == 0 {
        return STILL_UNSUPPORTED
    }
    let off: i64 = cell(info, avif.AI_PRIM_OFF) + cell(info, fb + avif.FH_OBU_OFF) + cell(info, fb + avif.FH_HDR_END)
    let tlen: i64 = cell(info, fb + avif.FH_OBU_LEN) - cell(info, fb + avif.FH_HDR_END)
    let mc: i64 = cell(info, fb + avif.FH_MI_COLS)
    let mr: i64 = cell(info, fb + avif.FH_MI_ROWS)
    let w: i64 = cell(info, avif.AI_WIDTH)
    let h: i64 = cell(info, avif.AI_HEIGHT)
    var upd: i64 = 1
    if cell(info, fb + avif.FH_DIS_CDF) != 0 {
        upd = 0
    }
    var np: i64 = 3
    if cell(info, avif.AI_MONO) != 0 {
        np = 1
    }
    let lossless: bool = cell(info, fb + avif.FH_LOSSLESS) != 0
    let up_w: i64 = cell(info, fb + avif.FH_UP_W)
    let superres: bool = up_w != cell(info, fb + avif.FH_FRAME_W)
    let t: u64 = av1tile.tile_new(src + (off as u64), tlen, mc, mr, cell(info, avif.AI_FILTER_INTRA), cell(info, avif.AI_EDGE_FILTER), upd)
    av1tile.tile_set_sb128(t, cell(info, avif.AI_SB128))
    set_tile_grid(t, info)
    av1tile.tile_set_chroma(t, np, cell(info, avif.AI_SUBX), cell(info, avif.AI_SUBY))
    let bit_depth: i64 = cell(info, avif.AI_BITDEPTH)
    if bit_depth != 8 && bit_depth != 10 && bit_depth != 12 {
        av1tile.tile_free(t)
        return STILL_UNSUPPORTED
    }
    av1tile.tile_set_bit_depth(t, bit_depth)
    var lrctx: u64 = 0
    var rc: i32 = STILL_OK
    av1tile.tile_set_sct(t, cell(info, fb + avif.FH_SCT))
    if cell(info, fb + avif.FH_INTRABC) != 0 {
        av1tile.tile_set_intrabc(t, 1)
    }
    setup_segmentation(t, info)
    if !lossless {
        let unsup: i64 = 0
        let bad: i64 = av1tile.tile_set_frame(t, cell(info, fb + avif.FH_BASE_Q), cell(info, fb + avif.FH_TX_MODE), cell(info, fb + avif.FH_REDUCED_TX),
                                              cell(info, fb + avif.FH_SCT), 0, cell(info, fb + avif.FH_DQ_YDC), cell(info, fb + avif.FH_DQ_UDC),
                                              cell(info, fb + avif.FH_DQ_UAC), cell(info, fb + avif.FH_DQ_VDC), cell(info, fb + avif.FH_DQ_VAC),
                                              cell(info, avif.AI_BITDEPTH), cell(info, avif.AI_SUBX), cell(info, avif.AI_SUBY),
                                              cell(info, fb + avif.FH_CDEF_BITS), cell(info, avif.AI_CDEF), unsup)
        av1tile.tile_set_quant_ext(t, cell(info, fb + avif.FH_QM), cell(info, fb + avif.FH_QM_Y), cell(info, fb + avif.FH_QM_U), cell(info, fb + avif.FH_QM_V),
                                   cell(info, fb + avif.FH_DQ_PRES), cell(info, fb + avif.FH_DQ_RES))
        if bad != 0 {
            av1tile.tile_free(t)
            return STILL_UNSUPPORTED
        }
    }
    if superres || !lossless {
        lrctx = setup_restoration(t, info, np, up_w)
    }
    av1tile.tile_run(t)
    if av1tile.tile_err(t) != 0 {
        rc = STILL_TILE_ERROR + (av1tile.tile_err(t) as i32)
        av1tile.tile_free(t)
        av1lr.lr_free(lrctx)
        return rc
    }
    var pl: Planes = Planes { p0: av1tile.tile_plane(t, 0), p1: av1tile.tile_plane(t, 1), p2: av1tile.tile_plane(t, 2), stride: av1tile.tile_stride(t), bytes: 0 }
    post_filters(t, info, lrctx, np, mc, mr, bit_depth, lossless, &pl)
    let st: i64 = pl.stride
    if keep {
        let pic: u64 = av1pic.pic_new(pl.p0, pl.p1, pl.p2, st, mr * 4, np, w, h, bit_depth, cell(info, avif.AI_SUBX), cell(info, avif.AI_SUBY))
        if pic != 0 {
            av1pic.pic_set(pic, av1pic.PIC_FTYPE, cell(info, fb + avif.FH_FRAME_TYPE))
            av1pic.pic_set(pic, av1pic.PIC_SHOWABLE, cell(info, fb + avif.FH_SHOWABLE))
            av1pic.pic_set(pic, av1pic.PIC_ORDER, cell(info, fb + avif.FH_ORDER_HINT))
            av1pic.pic_store_grain(pic, info)
        }
        *pic_out = pic
    }
    if !show {
        free_planes(&pl, np)
        av1tile.tile_free(t)
        av1lr.lr_free(lrctx)
        return STILL_OK
    }
    emit_planes(info, &pl, np, w, h, bit_depth, f)
    free_planes(&pl, np)
    av1tile.tile_free(t)
    av1lr.lr_free(lrctx)
    return STILL_OK
}

fn output_pic(info: u64, pic: u64, f: *mut Frame) -> i32 {
    let np: i64 = av1pic.pic_get(pic, av1pic.PIC_NP)
    var pl: Planes = Planes { p0: av1pic.pic_clone_plane(pic, 0), p1: 0, p2: 0, stride: av1pic.pic_get(pic, av1pic.PIC_STRIDE), bytes: 1 }
    if np == 3 {
        pl.p1 = av1pic.pic_clone_plane(pic, 1)
        pl.p2 = av1pic.pic_clone_plane(pic, 2)
    }
    pl.bytes = (pl.stride * av1pic.pic_get(pic, av1pic.PIC_ROWS) * 2) as usize
    av1pic.pic_load_grain(pic, info)
    emit_planes(info, &pl, np, av1pic.pic_get(pic, av1pic.PIC_W), av1pic.pic_get(pic, av1pic.PIC_H), av1pic.pic_get(pic, av1pic.PIC_DEPTH), f)
    free_planes(&pl, np)
    return STILL_OK
}

fn emit_planes(info: u64, pl: *mut Planes, np: i64, w: i64, h: i64, bit_depth: i64, f: *mut Frame) {
    let st: i64 = (*pl).stride
    if cell(info, avif.GR_BASE + avif.GR_APPLY) != 0 {
        av1fg.fg_apply(info, (*pl).p0, (*pl).p1, (*pl).p2, st, w, h,
                       cell(info, avif.AI_SUBX), cell(info, avif.AI_SUBY), np, bit_depth, cell(info, avif.AI_MC) == 0)
    }
    (*f).width = w
    (*f).height = h
    (*f).planes = np
    (*f).sub_x = cell(info, avif.AI_SUBX)
    (*f).sub_y = cell(info, avif.AI_SUBY)
    (*f).depth = bit_depth
    (*f).y = crop_plane((*pl).p0, st, w, h, bit_depth, &(*f).y_bytes)
    if np == 3 {
        let cw: i64 = (w + (*f).sub_x) >> (*f).sub_x
        let ch: i64 = (h + (*f).sub_y) >> (*f).sub_y
        (*f).u = crop_plane((*pl).p1, st, cw, ch, bit_depth, &(*f).u_bytes)
        (*f).v = crop_plane((*pl).p2, st, cw, ch, bit_depth, &(*f).v_bytes)
    }
}

fn setup_restoration(t: u64, info: u64, np: i64, up_w: i64) -> u64 {
    let fb: usize = avif.FH_BASE
    let lrt0: i64 = cell(info, fb + avif.FH_LR_TYPE)
    let lrt1: i64 = cell(info, fb + avif.FH_LR_TYPE + 1)
    let lrt2: i64 = cell(info, fb + avif.FH_LR_TYPE + 2)
    if (lrt0 | lrt1 | lrt2) == 0 {
        return 0
    }
    let lrctx: u64 = av1lr.lr_new(np, cell(info, avif.AI_SUBX), cell(info, avif.AI_SUBY), up_w,
                                  cell(info, fb + avif.FH_FRAME_H), lrt0, lrt1, lrt2, cell(info, fb + avif.FH_LR_UNIT_SHIFT),
                                  cell(info, fb + avif.FH_LR_UV_SHIFT))
    av1lr.lr_set_superres(lrctx, cell(info, fb + avif.FH_SR_DENOM))
    av1tile.tile_set_lr(t, lrctx)
    return lrctx
}

fn setup_segmentation(t: u64, info: u64) {
    let fb: usize = avif.FH_BASE
    let enabled: i64 = cell(info, fb + avif.FH_SEG_EN)
    av1tile.tile_set_segmentation(t, enabled, cell(info, fb + avif.FH_SEG_LAST), cell(info, fb + avif.FH_SEG_PRESKIP))
    if enabled != 0 {
        var sg: usize = 0
        while sg < 8 {
            av1tile.tile_set_seg_lossless(t, sg as i64, cell(info, fb + avif.FH_SEGQ + sg))
            var ft: usize = 0
            while ft < 8 {
                if cell(info, fb + avif.FH_SEG_FEN + sg * 8 + ft) != 0 {
                    av1tile.tile_set_seg_feature(t, sg as i64, ft as i64, cell(info, fb + avif.FH_SEG_FEAT + sg * 8 + ft) - 256)
                }
                ft = ft + 1
            }
            sg = sg + 1
        }
    }
    var lf_on: i64 = 0
    if cell(info, fb + avif.FH_LOSSLESS) == 0 && (cell(info, fb + avif.FH_LF0) != 0 || cell(info, fb + avif.FH_LF0 + 1) != 0) {
        lf_on = 1
    }
    av1tile.tile_set_lf(t, lf_on, cell(info, fb + avif.FH_DLF_PRES), cell(info, fb + avif.FH_DLF_RES), cell(info, fb + avif.FH_DLF_MULTI),
                        cell(info, fb + avif.FH_LF_DELTA_EN), cell(info, fb + avif.FH_LF_RD0) - 128,
                        cell(info, fb + avif.FH_LF0), cell(info, fb + avif.FH_LF0 + 1), cell(info, fb + avif.FH_LF0 + 2), cell(info, fb + avif.FH_LF0 + 3))
}

fn free_planes(pl: *mut Planes, np: i64) {
    if (*pl).bytes == 0 {
        return
    }
    av1mem.heap_free((*pl).p0 as *mut u8, (*pl).bytes)
    if np == 3 {
        av1mem.heap_free((*pl).p1 as *mut u8, (*pl).bytes)
        av1mem.heap_free((*pl).p2 as *mut u8, (*pl).bytes)
    }
}

fn upscale_one(info: u64, src: u64, st: i64, plane: i64, mc: i64, mr: i64, bd: i64) -> u64 {
    let fb: usize = avif.FH_BASE
    return av1sr.sr_upscale_alloc(src, st, plane, cell(info, avif.AI_SUBX), cell(info, avif.AI_SUBY), cell(info, fb + avif.FH_FRAME_W),
                                  cell(info, fb + avif.FH_UP_W), cell(info, fb + avif.FH_FRAME_H), mc, mr, bd)
}

fn upscale_frame(info: u64, pl: *mut Planes, np: i64, mc: i64, mr: i64, bd: i64, s0: *mut u64, s1: *mut u64, s2: *mut u64) {
    let st: i64 = (*pl).stride
    let ust: i64 = av1sr.sr_stride(cell(info, avif.FH_BASE + avif.FH_UP_W))
    let n0: u64 = upscale_one(info, (*pl).p0, st, 0, mc, mr, bd)
    var n1: u64 = 0
    var n2: u64 = 0
    if np == 3 {
        n1 = upscale_one(info, (*pl).p1, st, 1, mc, mr, bd)
        n2 = upscale_one(info, (*pl).p2, st, 2, mc, mr, bd)
    }
    if *s0 != 0 {
        let t0: u64 = upscale_one(info, *s0, st, 0, mc, mr, bd)
        av1lr.lr_snapshot_free(*s0, st, mr * 4)
        *s0 = t0
    }
    if *s1 != 0 {
        let t1: u64 = upscale_one(info, *s1, st, 1, mc, mr, bd)
        av1lr.lr_snapshot_free(*s1, st, mr * 4)
        *s1 = t1
    }
    if *s2 != 0 {
        let t2: u64 = upscale_one(info, *s2, st, 2, mc, mr, bd)
        av1lr.lr_snapshot_free(*s2, st, mr * 4)
        *s2 = t2
    }
    (*pl).p0 = n0
    (*pl).p1 = n1
    (*pl).p2 = n2
    (*pl).stride = ust
    (*pl).bytes = av1sr.sr_bytes(ust, mr * 4)
}

fn post_filters(t: u64, info: u64, lrctx: u64, np: i64, mc: i64, mr: i64, bd: i64, lossless: bool, pl: *mut Planes) {
    let fb: usize = avif.FH_BASE
    let st: i64 = av1tile.tile_stride(t)
    if !lossless {
        let lv: u64 = av1mem.heap_alloc(64) as u64
        let scr: u64 = av1mem.heap_alloc(512) as u64
        var li: usize = 0
        while li < 4 {
            *((lv + (li as u64)) as *mut u8) = cell(info, fb + avif.FH_LF0 + li) as u8
            li = li + 1
        }
        av1lf.lf_frame(av1tile.tile_plane(t, 0), av1tile.tile_plane(t, 1), av1tile.tile_plane(t, 2), st,
                       av1tile.tile_lftx(t, 0), av1tile.tile_lftx(t, 1), av1tile.tile_lftx(t, 2), mc, mr,
                       cell(info, fb + avif.FH_FRAME_W), cell(info, fb + avif.FH_FRAME_H),
                       cell(info, avif.AI_SUBX), cell(info, avif.AI_SUBY), np, lv,
                       cell(info, fb + avif.FH_LF_SHARP), av1tile.tile_lvlmap(t), scr, bd)
        av1mem.heap_free(lv as *mut u8, 64)
        av1mem.heap_free(scr as *mut u8, 512)
    }
    var s0: u64 = 0
    var s1: u64 = 0
    var s2: u64 = 0
    let cdef_on: bool = !lossless && cell(info, avif.AI_CDEF) != 0
    if lrctx != 0 && cdef_on {
        s0 = av1lr.lr_snapshot(av1tile.tile_plane(t, 0), st, mr * 4)
        s1 = av1lr.lr_snapshot(av1tile.tile_plane(t, 1), st, mr * 4)
        s2 = av1lr.lr_snapshot(av1tile.tile_plane(t, 2), st, mr * 4)
    }
    if cdef_on {
        let par: u64 = av1mem.heap_alloc(av1cdef.CDEF_PAR_BYTES as usize) as u64
        var ci: usize = 0
        while ci < 8 {
            *((par + (ci as u64)) as *mut u8) = cell(info, fb + avif.FH_CDEF_YP + ci) as u8
            *((par + 8 + (ci as u64)) as *mut u8) = cell(info, fb + avif.FH_CDEF_YS + ci) as u8
            *((par + 16 + (ci as u64)) as *mut u8) = cell(info, fb + avif.FH_CDEF_UVP + ci) as u8
            *((par + 24 + (ci as u64)) as *mut u8) = cell(info, fb + avif.FH_CDEF_UVS + ci) as u8
            ci = ci + 1
        }
        let csc: u64 = av1mem.heap_alloc(av1cdef.CDEF_SCRATCH_BYTES as usize) as u64
        av1cdef.cdef_frame(av1tile.tile_plane(t, 0), av1tile.tile_plane(t, 1), av1tile.tile_plane(t, 2), st,
                           av1tile.tile_skp(t), av1tile.tile_cdefidx(t), av1tile.tile_sbcols(t), mc, mr,
                           cell(info, avif.AI_SUBX), cell(info, avif.AI_SUBY), np,
                           cell(info, fb + avif.FH_CDEF_DAMP), bd, par, csc)
        av1mem.heap_free(par as *mut u8, av1cdef.CDEF_PAR_BYTES as usize)
        av1mem.heap_free(csc as *mut u8, av1cdef.CDEF_SCRATCH_BYTES as usize)
    }
    if cell(info, fb + avif.FH_UP_W) != cell(info, fb + avif.FH_FRAME_W) {
        upscale_frame(info, pl, np, mc, mr, bd, &s0, &s1, &s2)
    }
    if lrctx != 0 {
        av1lr.lr_frame(lrctx, (*pl).p0, (*pl).p1, (*pl).p2, s0, s1, s2, (*pl).stride, bd)
        if cdef_on {
            av1lr.lr_snapshot_free(s0, (*pl).stride, mr * 4)
            av1lr.lr_snapshot_free(s1, (*pl).stride, mr * 4)
            av1lr.lr_snapshot_free(s2, (*pl).stride, mr * 4)
        }
    }
}
