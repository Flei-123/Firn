// SPDX-License-Identifier: MPL-2.0
// lib/av1/av1bits.fi -- av1.av1bits: MSB-first bit reader for AV1 headers (f(n), su, ns, uvlc).

export { Bits, bits_get, bits_over, bits_uvlc, bits_su, bits_ns }

struct Bits {
    p: u64,
    n: usize,
    pos: usize,
}

fn bits_get(b: *mut Bits, k: usize) -> i64 {
    var v: i64 = 0
    var i: usize = 0
    while i < k {
        let by: usize = (*b).pos >> 3
        var bit: i64 = 0
        if by < (*b).n {
            let o: i64 = (*(((*b).p + by as u64) as *mut u8)) as i64
            bit = (o >> (7 - ((*b).pos & 7)) as i64) & 1
        }
        v = (v << 1) | bit
        (*b).pos = (*b).pos + 1
        i = i + 1
    }
    return v
}

fn bits_over(b: *mut Bits) -> bool {
    return (*b).pos > (*b).n * 8
}

fn bits_uvlc(b: *mut Bits) -> i64 {
    var lz: usize = 0
    while lz < 32 && !bits_over(b) {
        if bits_get(b, 1) != 0 {
            break
        }
        lz = lz + 1
    }
    if lz >= 32 {
        return 4294967295
    }
    return bits_get(b, lz) + (1 << lz) - 1
}

fn bits_su(b: *mut Bits, n: usize) -> i64 {
    var v: i64 = bits_get(b, n)
    let m: i64 = 1 << (n - 1)
    if (v & m) != 0 {
        v = v - 2 * m
    }
    return v
}

fn bits_ns(b: *mut Bits, n: i64) -> i64 {
    if n <= 1 {
        return 0
    }
    var w: usize = 0
    var x: i64 = n
    while x != 0 {
        x = x >> 1
        w = w + 1
    }
    let m: i64 = (1 << w) - n
    let v: i64 = bits_get(b, w - 1)
    if v < m {
        return v
    }
    return (v << 1) - m + bits_get(b, 1)
}

