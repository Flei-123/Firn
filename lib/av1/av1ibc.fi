// SPDX-License-Identifier: MPL-2.0
import av1.av1sym

export { IBC_CELLS, ibc_bind, ibc_set_tile, ibc_set_sb, ibc_reset_cdfs, ibc_decode_mv, ibc_store, ibc_kind, ibc_predict, ibc_mv_row, ibc_mv_col, ibc_mis_w4, ibc_mis_h4, ibc_find, ibc_num, ibc_stack_mv, ibc_stack_weight }

const IBC_CELLS: i64 = 48
const C_MC: i64 = 0
const C_MR: i64 = 1
const C_KIND: i64 = 2
const C_MVS: i64 = 3
const C_MIS: i64 = 4
const C_CDF: i64 = 5
const C_R0: i64 = 6
const C_R1: i64 = 7
const C_C0: i64 = 8
const C_C1: i64 = 9
const C_NUM: i64 = 10
const C_SB128: i64 = 11
const C_MVR: i64 = 12
const C_MVC: i64 = 13
const C_STK: i64 = 16
const MAX_STACK: i64 = 8
const CDF_JOINT: i64 = 0
const CDF_COMP: i64 = 8
const COMP_CELLS: i64 = 48
const COMP_SIGN: i64 = 0
const COMP_CLASS: i64 = 3
const COMP_CLASS0: i64 = 15
const COMP_BITS: i64 = 18
const CDF_CELLS: i64 = 104

static BW4: [i16; 22] = [1, 1, 2, 2, 2, 4, 4, 4, 8, 8, 8, 16, 16, 16, 32, 32, 1, 4, 2, 8, 4, 16]
static BH4: [i16; 22] = [1, 2, 1, 2, 4, 2, 4, 8, 4, 8, 16, 8, 16, 32, 16, 32, 4, 1, 8, 2, 16, 4]
static CLASS_CDF: [u16; 11] = [28672, 30976, 31858, 32320, 32551, 32656, 32740, 32757, 32762, 32767, 32768]
static BIT_CDF: [u16; 10] = [136, 140, 148, 160, 176, 192, 224, 234, 234, 240]

#[no_gc]
fn pg(ps: u64, i: i64) -> i64 {
    return *((ps + ((i * 8) as u64)) as *mut i64)
}

#[no_gc]
fn pset(ps: u64, i: i64, v: i64) {
    *((ps + ((i * 8) as u64)) as *mut i64) = v
}

#[no_gc]
fn ldb(p: u64, i: i64) -> i64 {
    return (*((p + (i as u64)) as *mut u8)) as i64
}

#[no_gc]
fn stb(p: u64, i: i64, v: i64) {
    *((p + (i as u64)) as *mut u8) = (v & 255) as u8
}

#[no_gc]
fn ldi(p: u64, i: i64) -> i64 {
    return (*((p + ((i * 4) as u64)) as *mut i32)) as i64
}

#[no_gc]
fn sti(p: u64, i: i64, v: i64) {
    *((p + ((i * 4) as u64)) as *mut i32) = v as i32
}

#[no_gc]
fn ldw(p: u64, i: i64) -> i64 {
    return (*((p + ((i * 2) as u64)) as *mut u16)) as i64
}

#[no_gc]
fn stw(p: u64, i: i64, v: i64) {
    *((p + ((i * 2) as u64)) as *mut u16) = (v & 65535) as u16
}

fn imin(a: i64, b: i64) -> i64 {
    if a < b {
        return a
    }
    return b
}

fn imax(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    }
    return b
}

fn iabs(a: i64) -> i64 {
    if a < 0 {
        return 0 - a
    }
    return a
}

fn clip3(lo: i64, hi: i64, v: i64) -> i64 {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

fn ibc_mis_w4(size: i64) -> i64 {
    return BW4[size as usize] as i64
}

fn ibc_mis_h4(size: i64) -> i64 {
    return BH4[size as usize] as i64
}

fn ibc_bind(ps: u64, kind: u64, mvs: u64, mis: u64, cdf: u64, mc: i64, mr: i64) {
    pset(ps, C_KIND, kind as i64)
    pset(ps, C_MVS, mvs as i64)
    pset(ps, C_MIS, mis as i64)
    pset(ps, C_CDF, cdf as i64)
    pset(ps, C_MC, mc)
    pset(ps, C_MR, mr)
}

fn ibc_set_tile(ps: u64, r0: i64, r1: i64, c0: i64, c1: i64) {
    pset(ps, C_R0, r0)
    pset(ps, C_R1, r1)
    pset(ps, C_C0, c0)
    pset(ps, C_C1, c1)
}

fn ibc_set_sb(ps: u64, on: i64) {
    pset(ps, C_SB128, on)
}

fn cdf_put(cdf: u64, at: i64, v: i64) {
    av1sym.cdf_st(cdf, at, v * 128)
    av1sym.cdf_st(cdf, at + 1, 32768)
    av1sym.cdf_st(cdf, at + 2, 0)
}

fn ibc_reset_cdfs(ps: u64) {
    let cdf: u64 = pg(ps, C_CDF) as u64
    av1sym.cdf_st(cdf, CDF_JOINT, 4096)
    av1sym.cdf_st(cdf, CDF_JOINT + 1, 11264)
    av1sym.cdf_st(cdf, CDF_JOINT + 2, 19328)
    av1sym.cdf_st(cdf, CDF_JOINT + 3, 32768)
    av1sym.cdf_st(cdf, CDF_JOINT + 4, 0)
    var k: i64 = 0
    while k < 2 {
        let b: i64 = CDF_COMP + k * COMP_CELLS
        cdf_put(cdf, b + COMP_SIGN, 128)
        var i: i64 = 0
        while i < 11 {
            av1sym.cdf_st(cdf, b + COMP_CLASS + i, CLASS_CDF[i as usize] as i64)
            i = i + 1
        }
        av1sym.cdf_st(cdf, b + COMP_CLASS + 11, 0)
        cdf_put(cdf, b + COMP_CLASS0, 216)
        i = 0
        while i < 10 {
            cdf_put(cdf, b + COMP_BITS + i * 3, BIT_CDF[i as usize] as i64)
            i = i + 1
        }
        k = k + 1
    }
}

fn ibc_kind(ps: u64, r: i64, cc: i64) -> i64 {
    return ldb(pg(ps, C_KIND) as u64, r * pg(ps, C_MC) + cc)
}

fn mv_row_at(ps: u64, r: i64, cc: i64) -> i64 {
    return ldi(pg(ps, C_MVS) as u64, r * pg(ps, C_MC) + cc) >> 16
}

fn mv_col_at(ps: u64, r: i64, cc: i64) -> i64 {
    let v: i64 = ldi(pg(ps, C_MVS) as u64, r * pg(ps, C_MC) + cc) & 65535
    return (v ^ 32768) - 32768
}

fn ibc_store(ps: u64, r: i64, cc: i64, bw4: i64, bh4: i64, kind: i64, mvr: i64, mvc: i64) {
    let mc: i64 = pg(ps, C_MC)
    let mr: i64 = pg(ps, C_MR)
    let packed: i64 = (mvr << 16) | (mvc & 65535)
    var y: i64 = 0
    while y < bh4 {
        var x: i64 = 0
        while x < bw4 {
            if r + y < mr && cc + x < mc {
                stb(pg(ps, C_KIND) as u64, (r + y) * mc + cc + x, kind)
                sti(pg(ps, C_MVS) as u64, (r + y) * mc + cc + x, packed)
            }
            x = x + 1
        }
        y = y + 1
    }
}

fn ibc_mv_row(ps: u64) -> i64 {
    return pg(ps, C_MVR)
}

fn ibc_mv_col(ps: u64) -> i64 {
    return pg(ps, C_MVC)
}

fn inside(ps: u64, r: i64, cc: i64) -> bool {
    return cc >= pg(ps, C_C0) && cc < pg(ps, C_C1) && r >= pg(ps, C_R0) && r < pg(ps, C_R1)
}

fn lower_prec(v: i64) -> i64 {
    let a: i64 = (iabs(v) + 3) >> 3
    if v > 0 {
        return a << 3
    }
    return 0 - (a << 3)
}

fn add_cand(ps: u64, r: i64, cc: i64, weight: i64) {
    if ibc_kind(ps, r, cc) != 2 {
        return
    }
    let mr: i64 = lower_prec(mv_row_at(ps, r, cc))
    let mc: i64 = lower_prec(mv_col_at(ps, r, cc))
    let n: i64 = pg(ps, C_NUM)
    var i: i64 = 0
    while i < n {
        if pg(ps, C_STK + i * 3) == mr && pg(ps, C_STK + i * 3 + 1) == mc {
            pset(ps, C_STK + i * 3 + 2, pg(ps, C_STK + i * 3 + 2) + weight)
            return
        }
        i = i + 1
    }
    if n < MAX_STACK {
        pset(ps, C_STK + n * 3, mr)
        pset(ps, C_STK + n * 3 + 1, mc)
        pset(ps, C_STK + n * 3 + 2, weight)
        pset(ps, C_NUM, n + 1)
    }
}

fn mis_at(ps: u64, r: i64, cc: i64) -> i64 {
    return ldb(pg(ps, C_MIS) as u64, r * pg(ps, C_MC) + cc)
}

fn scan_row(ps: u64, r: i64, cc: i64, bw4: i64, delta_row_in: i64) {
    var delta_row: i64 = delta_row_in
    let end4: i64 = imin(imin(bw4, pg(ps, C_MC) - cc), 16)
    var delta_col: i64 = 0
    let step16: bool = bw4 >= 16
    if iabs(delta_row) > 1 {
        delta_row = delta_row + (r & 1)
        delta_col = 1 - (cc & 1)
    }
    var i: i64 = 0
    while i < end4 {
        let mvr: i64 = r + delta_row
        let mvc: i64 = cc + delta_col + i
        if !inside(ps, mvr, mvc) {
            break
        }
        var len: i64 = imin(bw4, ibc_mis_w4(mis_at(ps, mvr, mvc)))
        if iabs(delta_row) > 1 {
            len = imax(2, len)
        }
        if step16 {
            len = imax(4, len)
        }
        add_cand(ps, mvr, mvc, len * 2)
        i = i + len
    }
}

fn scan_col(ps: u64, r: i64, cc: i64, bh4: i64, delta_col_in: i64) {
    var delta_col: i64 = delta_col_in
    let end4: i64 = imin(imin(bh4, pg(ps, C_MR) - r), 16)
    var delta_row: i64 = 0
    let step16: bool = bh4 >= 16
    if iabs(delta_col) > 1 {
        delta_row = 1 - (r & 1)
        delta_col = delta_col + (cc & 1)
    }
    var i: i64 = 0
    while i < end4 {
        let mvr: i64 = r + delta_row + i
        let mvc: i64 = cc + delta_col
        if !inside(ps, mvr, mvc) {
            break
        }
        var len: i64 = imin(bh4, ibc_mis_h4(mis_at(ps, mvr, mvc)))
        if iabs(delta_col) > 1 {
            len = imax(2, len)
        }
        if step16 {
            len = imax(4, len)
        }
        add_cand(ps, mvr, mvc, len * 2)
        i = i + len
    }
}

fn scan_point(ps: u64, r: i64, cc: i64, dr: i64, dc: i64) {
    let mvr: i64 = r + dr
    let mvc: i64 = cc + dc
    if inside(ps, mvr, mvc) && ibc_kind(ps, mvr, mvc) != 0 {
        add_cand(ps, mvr, mvc, 4)
    }
}

fn swap_entries(ps: u64, a: i64, b: i64) {
    var k: i64 = 0
    while k < 3 {
        let t: i64 = pg(ps, C_STK + a * 3 + k)
        pset(ps, C_STK + a * 3 + k, pg(ps, C_STK + b * 3 + k))
        pset(ps, C_STK + b * 3 + k, t)
        k = k + 1
    }
}

fn sort_range(ps: u64, start: i64, end_in: i64) {
    var end: i64 = end_in
    while end > start {
        var new_end: i64 = start
        var idx: i64 = start + 1
        while idx < end {
            if pg(ps, C_STK + (idx - 1) * 3 + 2) < pg(ps, C_STK + idx * 3 + 2) {
                swap_entries(ps, idx - 1, idx)
                new_end = idx
            }
            idx = idx + 1
        }
        end = new_end
    }
}

fn find_mv_stack(ps: u64, r: i64, cc: i64, size: i64) {
    let bw4: i64 = ibc_mis_w4(size)
    let bh4: i64 = ibc_mis_h4(size)
    pset(ps, C_NUM, 0)
    scan_row(ps, r, cc, bw4, 0 - 1)
    scan_col(ps, r, cc, bh4, 0 - 1)
    if imax(bw4, bh4) <= 16 {
        scan_point(ps, r, cc, 0 - 1, bw4)
    }
    let nearest: i64 = pg(ps, C_NUM)
    var i: i64 = 0
    while i < nearest {
        pset(ps, C_STK + i * 3 + 2, pg(ps, C_STK + i * 3 + 2) + 640)
        i = i + 1
    }
    scan_point(ps, r, cc, 0 - 1, 0 - 1)
    scan_row(ps, r, cc, bw4, 0 - 3)
    scan_col(ps, r, cc, bh4, 0 - 3)
    if bh4 > 1 {
        scan_row(ps, r, cc, bw4, 0 - 5)
    }
    if bw4 > 1 {
        scan_col(ps, r, cc, bh4, 0 - 5)
    }
    sort_range(ps, 0, nearest)
    sort_range(ps, nearest, pg(ps, C_NUM))
    let found: i64 = pg(ps, C_NUM)
    i = found
    while i < 2 {
        pset(ps, C_STK + i * 3, 0)
        pset(ps, C_STK + i * 3 + 1, 0)
        pset(ps, C_STK + i * 3 + 2, 0)
        i = i + 1
    }
    let mr: i64 = pg(ps, C_MR)
    let mc: i64 = pg(ps, C_MC)
    i = 0
    while i < found {
        let brow: i64 = 128 + bh4 * 4 * 8
        let bcol: i64 = 128 + bw4 * 4 * 8
        let top: i64 = 0 - ((r * 4) * 8)
        let bottom: i64 = ((mr - bh4 - r) * 4) * 8
        let left: i64 = 0 - ((cc * 4) * 8)
        let right: i64 = ((mc - bw4 - cc) * 4) * 8
        pset(ps, C_STK + i * 3, clip3(top - brow, bottom + brow, pg(ps, C_STK + i * 3)))
        pset(ps, C_STK + i * 3 + 1, clip3(left - bcol, right + bcol, pg(ps, C_STK + i * 3 + 1)))
        i = i + 1
    }
}

fn read_comp(ps: u64, sy: *mut av1sym.Sym, comp: i64) -> i64 {
    let cdf: u64 = pg(ps, C_CDF) as u64
    let b: i64 = CDF_COMP + comp * COMP_CELLS
    let sign: i64 = av1sym.sym_read(sy, cdf + (((b + COMP_SIGN) * 2) as u64), 2)
    let cls: i64 = av1sym.sym_read(sy, cdf + (((b + COMP_CLASS) * 2) as u64), 11)
    var mag: i64 = 0
    if cls == 0 {
        let bit: i64 = av1sym.sym_read(sy, cdf + (((b + COMP_CLASS0) * 2) as u64), 2)
        mag = bit * 8 + 8
    } else {
        var d: i64 = 0
        var i: i64 = 0
        while i < cls {
            let bit: i64 = av1sym.sym_read(sy, cdf + (((b + COMP_BITS + i * 3) * 2) as u64), 2)
            d = d | (bit << i)
            i = i + 1
        }
        mag = (2 << (cls + 2)) + d * 8 + 8
    }
    if sign != 0 {
        return 0 - mag
    }
    return mag
}

fn mv_valid(ps: u64, r: i64, cc: i64, size: i64, hasc: i64, subx: i64, suby: i64, mvr: i64, mvc: i64) -> bool {
    if iabs(mvr) >= 16384 || iabs(mvc) >= 16384 {
        return false
    }
    if (mvr & 7) != 0 || (mvc & 7) != 0 {
        return false
    }
    let bw: i64 = ibc_mis_w4(size) * 4
    let bh: i64 = ibc_mis_h4(size) * 4
    let dr: i64 = mvr >> 3
    let dc: i64 = mvc >> 3
    var top: i64 = r * 4 + dr
    var left: i64 = cc * 4 + dc
    let bottom: i64 = top + bh
    let right: i64 = left + bw
    if hasc != 0 {
        if bw < 8 && subx != 0 {
            left = left - 4
        }
        if bh < 8 && suby != 0 {
            top = top - 4
        }
    }
    if top < pg(ps, C_R0) * 4 || left < pg(ps, C_C0) * 4 || bottom > pg(ps, C_R1) * 4 || right > pg(ps, C_C1) * 4 {
        return false
    }
    let sbh: i64 = 64 << pg(ps, C_SB128)
    let active_row: i64 = (r * 4) / sbh
    let active_col: i64 = (cc * 4) >> 6
    let src_row: i64 = (bottom - 1) / sbh
    let src_col: i64 = (right - 1) >> 6
    let total: i64 = ((pg(ps, C_C1) - pg(ps, C_C0) - 1) >> 4) + 1
    let active: i64 = active_row * total + active_col
    let src: i64 = src_row * total + src_col
    if src >= active - 4 {
        return false
    }
    let wf: i64 = (5 + pg(ps, C_SB128)) * (active_row - src_row)
    if src_row > active_row || src_col >= active_col - 4 + wf {
        return false
    }
    return true
}

fn ibc_decode_mv(ps: u64, sy: *mut av1sym.Sym, r: i64, cc: i64, size: i64, hasc: i64, subx: i64, suby: i64) -> i64 {
    find_mv_stack(ps, r, cc, size)
    var pr: i64 = pg(ps, C_STK)
    var pc: i64 = pg(ps, C_STK + 1)
    if pr == 0 && pc == 0 {
        pr = pg(ps, C_STK + 3)
        pc = pg(ps, C_STK + 4)
    }
    if pr == 0 && pc == 0 {
        let sb4: i64 = 16 << pg(ps, C_SB128)
        if r - sb4 < pg(ps, C_R0) {
            pr = 0
            pc = 0 - ((sb4 * 4 + 256) * 8)
        } else {
            pr = 0 - (sb4 * 4 * 8)
            pc = 0
        }
    }
    let cdf: u64 = pg(ps, C_CDF) as u64
    let joint: i64 = av1sym.sym_read(sy, cdf, 4)
    var dr: i64 = 0
    var dc: i64 = 0
    if joint == 2 || joint == 3 {
        dr = read_comp(ps, sy, 0)
    }
    if joint == 1 || joint == 3 {
        dc = read_comp(ps, sy, 1)
    }
    let mvr: i64 = pr + dr
    let mvc: i64 = pc + dc
    pset(ps, C_MVR, mvr)
    pset(ps, C_MVC, mvc)
    if mv_valid(ps, r, cc, size, hasc, subx, suby, mvr, mvc) {
        return 1
    }
    return 0
}

fn hfilt(src: u64, stride: i64, x0: i64, y: i64, fx: i64, last_x: i64) -> i64 {
    let a: i64 = ldw(src, y * stride + clip3(0, last_x, x0))
    if fx == 0 {
        return a * 16
    }
    let b: i64 = ldw(src, y * stride + clip3(0, last_x, x0 + 1))
    return ((128 - 8 * fx) * a + 8 * fx * b + 4) >> 3
}

fn ibc_predict(ps: u64, plane: u64, stride: i64, x: i64, y: i64, w: i64, h: i64, mvr: i64, mvc: i64, subx: i64, suby: i64, bd: i64) {
    let last_x: i64 = ((pg(ps, C_MC) * 4 + subx) >> subx) - 1
    let last_y: i64 = ((pg(ps, C_MR) * 4 + suby) >> suby) - 1
    let qx: i64 = (2 * mvc) >> subx
    let qy: i64 = (2 * mvr) >> suby
    let fx: i64 = qx & 15
    let fy: i64 = qy & 15
    let ix: i64 = x + (qx >> 4)
    let iy: i64 = y + (qy >> 4)
    let maxv: i64 = (1 << bd) - 1
    var j: i64 = 0
    while j < h {
        let ry: i64 = clip3(0, last_y, iy + j)
        let ry1: i64 = clip3(0, last_y, iy + j + 1)
        var i: i64 = 0
        while i < w {
            let h0: i64 = hfilt(plane, stride, ix + i, ry, fx, last_x)
            var v: i64 = h0 * 128
            if fy != 0 {
                let h1: i64 = hfilt(plane, stride, ix + i, ry1, fx, last_x)
                v = (128 - 8 * fy) * h0 + 8 * fy * h1
            }
            v = (v + 1024) >> 11
            stw(plane, (y + j) * stride + x + i, clip3(0, maxv, v))
            i = i + 1
        }
        j = j + 1
    }
}

fn ibc_find(ps: u64, r: i64, cc: i64, size: i64) {
    find_mv_stack(ps, r, cc, size)
}

fn ibc_num(ps: u64) -> i64 {
    return pg(ps, C_NUM)
}

fn ibc_stack_mv(ps: u64, idx: i64, comp: i64) -> i64 {
    return pg(ps, C_STK + idx * 3 + comp)
}

fn ibc_stack_weight(ps: u64, idx: i64) -> i64 {
    return pg(ps, C_STK + idx * 3 + 2)
}
