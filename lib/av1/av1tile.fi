// SPDX-License-Identifier: MPL-2.0
// lib/av1/av1tile.fi -- AV1 intra tile decoder: partition, mode info, coefficients, prediction.
import rt.rt
import av1.av1mem
import av1.av1sym
import av1.av1tab
import av1.avif_cdf
import av1.av1tab2
import av1.av1lt
import av1.av1recon
import av1.av1lr
import av1.av1qm
import av1.av1txfm
import av1.av1pal
import av1.av1ibc
import av1.av1intertx

export { tile_set_chroma, tile_set_lr, tile_skp, tile_cdefidx, tile_sbcols, tile_lftx, tile_new, tile_run, tile_plane, tile_stride, tile_bits_left, tile_free, tile_set_frame, tile_set_quant_ext, tile_set_sct, tile_set_bit_depth, tile_err, tile_set_grid, tile_set_col_start, tile_set_row_start, tile_set_intrabc, tile_set_sb128 }

const S_SYM: i64 = 0
const S_MCDF: i64 = 1
const S_CCDF: i64 = 2
const S_MC: i64 = 3
const S_MR: i64 = 4
const S_PL0: i64 = 5
const S_PL1: i64 = 6
const S_PL2: i64 = 7
const S_YM: i64 = 8
const S_UVM: i64 = 9
const S_MIS: i64 = 10
const S_SKP: i64 = 11
const S_ALC: i64 = 12
const S_ADC: i64 = 13
const S_LLC: i64 = 14
const S_LDC: i64 = 15
const S_CN: i64 = 16
const S_BDEC: i64 = 17
const S_QUANT: i64 = 18
const S_RES: i64 = 19
const S_ABOVE: i64 = 20
const S_LEFT: i64 = 21
const S_TMP: i64 = 22
const S_TCDF: i64 = 23
const S_EFI: i64 = 24
const S_EEF: i64 = 25
const S_ROW: i64 = 26
const S_COL: i64 = 27
const S_SIZE: i64 = 28
const S_SKIP: i64 = 29
const S_YMODE: i64 = 30
const S_UVMODE: i64 = 31
const S_ANGY: i64 = 32
const S_ANGUV: i64 = 33
const S_UFI: i64 = 34
const S_FIM: i64 = 35
const S_CAU: i64 = 36
const S_CAV: i64 = 37
const S_AVU: i64 = 38
const S_AVL: i64 = 39
const S_MAXLW: i64 = 40
const S_MAXLH: i64 = 41
const S_ERR: i64 = 42
const S_QIDX: i64 = 43
const S_TXMODE: i64 = 44
const S_REDTX: i64 = 45
const S_BD: i64 = 46
const S_SCT: i64 = 47
const S_LOSSLESS: i64 = 48
const S_DCQ: i64 = 49
const S_TXSZ: i64 = 55
const S_STRIDE: i64 = 56
const S_TXS: i64 = 57
const S_WORK: i64 = 58
const S_CDEFBITS: i64 = 59
const S_ENCDEF: i64 = 60
const S_CDEFIDX: i64 = 62
const S_SBCOLS: i64 = 63
const S_SUBX: i64 = 64
const S_SUBY: i64 = 65
const S_QCTX: i64 = 66
const S_TXTYPE: i64 = 67
const S_PALY: i64 = 68
const S_LR: i64 = 72
const S_NALLOC: i64 = 73
const S_ALLOC0: i64 = 100
const MAX_ALLOCS: i64 = 200
const S_LFTX: i64 = 69
const S_HASC: i64 = 74
const S_AVUC: i64 = 75
const S_AVLC: i64 = 76
const S_NPL: i64 = 77
const S_BDI: i64 = 78
const S_DQD: i64 = 79
const S_QML: i64 = 84
const S_DQPRES: i64 = 87
const S_DQRES: i64 = 88
const S_CURQ: i64 = 89
const S_RDELTAS: i64 = 90
const S_PAL: i64 = 91
const S_R0: i64 = 92
const S_R1: i64 = 93
const S_C0: i64 = 94
const S_C1: i64 = 95
const S_TINFO: i64 = 96
const S_DATA: i64 = 97
const S_DLEN: i64 = 98
const S_UPD: i64 = 99
const S_SBMI: i64 = 504
const S_IBC: i64 = 500
const S_ALLOWIBC: i64 = 501
const S_ISINTER: i64 = 502
const S_TXTYPES: i64 = 503
const G_COLS: i64 = 0
const G_ROWS: i64 = 1
const G_SIZE_BYTES: i64 = 2
const G_COL_START: i64 = 3
const G_ROW_START: i64 = 70
const G_CELLS: i64 = 140

static NUM4W: [i16; 22] = [1, 1, 2, 2, 2, 4, 4, 4, 8, 8, 8, 16, 16, 16, 32, 32, 1, 4, 2, 8, 4, 16]
static NUM4H: [i16; 22] = [1, 2, 1, 2, 4, 2, 4, 8, 4, 8, 16, 8, 16, 32, 16, 32, 4, 1, 8, 2, 16, 4]
static MIWL: [i16; 22] = [0, 0, 1, 1, 1, 2, 2, 2, 3, 3, 3, 4, 4, 4, 5, 5, 0, 2, 1, 3, 2, 4]
static MIHL: [i16; 22] = [0, 1, 0, 1, 2, 1, 2, 3, 2, 3, 4, 3, 4, 5, 4, 5, 2, 0, 3, 1, 4, 2]
static IMC: [i16; 13] = [0, 1, 2, 3, 4, 4, 4, 4, 3, 0, 1, 2, 0]
static MODE_ANGLE: [i16; 13] = [0, 90, 180, 45, 135, 113, 157, 203, 67, 0, 0, 0, 0]
static EDGE_K: [i16; 15] = [0, 4, 8, 4, 0, 0, 5, 6, 5, 0, 2, 4, 4, 4, 2]
static FIM2DIR: [i16; 5] = [0, 1, 2, 6, 0]

#[no_gc]
fn ldb(p: u64, i: i64) -> i64 {
    return (*((p + (i as u64)) as *mut u8)) as i64
}

#[no_gc]
fn stb(p: u64, i: i64, v: i64) {
    *((p + (i as u64)) as *mut u8) = (v & 255) as u8
}

#[no_gc]
fn ldw(p: u64, i: i64) -> i64 {
    return (*((p + ((i * 2) as u64)) as *mut u16)) as i64
}

#[no_gc]
fn stw(p: u64, i: i64, v: i64) {
    *((p + ((i * 2) as u64)) as *mut u16) = (v & 65535) as u16
}

#[no_gc]
fn ldi(p: u64, i: i64) -> i64 {
    return (*((p + ((i * 4) as u64)) as *mut i32)) as i64
}

#[no_gc]
fn sti(p: u64, i: i64, v: i64) {
    *((p + ((i * 4) as u64)) as *mut i32) = v as i32
}

#[no_gc]
fn sg(c: u64, i: i64) -> i64 {
    return *((c + ((i * 8) as u64)) as *mut i64)
}

#[no_gc]
fn ss(c: u64, i: i64, v: i64) {
    *((c + ((i * 8) as u64)) as *mut i64) = v
}

fn imin(a: i64, b: i64) -> i64 {
    if a < b {
        return a
    }
    return b
}

fn imax(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    }
    return b
}

fn iabs(a: i64) -> i64 {
    if a < 0 {
        return 0 - a
    }
    return a
}

fn clip1(c: u64, v: i64) -> i64 {
    let maxv: i64 = (1 << sg(c, S_BD)) - 1
    if v < 0 {
        return 0
    }
    if v > maxv {
        return maxv
    }
    return v
}

fn mid_value(c: u64) -> i64 {
    return 1 << (sg(c, S_BD) - 1)
}

fn round2(x: i64, n: i64) -> i64 {
    if n == 0 {
        return x
    }
    return (x + (1 << (n - 1))) >> n
}

fn round2s(x: i64, n: i64) -> i64 {
    if x >= 0 {
        return round2(x, n)
    }
    return 0 - round2(0 - x, n)
}

fn n4w(i: i64) -> i64 {
    return NUM4W[i as usize] as i64
}

fn n4h(i: i64) -> i64 {
    return NUM4H[i as usize] as i64
}

fn zalloc(n: i64) -> u64 {
    return av1mem.heap_alloc(n as usize) as u64
}

fn zalloc_c(c: u64, n: i64) -> u64 {
    let p: u64 = zalloc(n)
    let k: i64 = sg(c, S_NALLOC)
    if p != 0 && k < MAX_ALLOCS {
        ss(c, S_ALLOC0 + k * 2, p as i64)
        ss(c, S_ALLOC0 + k * 2 + 1, n)
        ss(c, S_NALLOC, k + 1)
    }
    return p
}

fn symp(c: u64) -> *mut av1sym.Sym {
    return (sg(c, S_SYM) as u64) as *mut av1sym.Sym
}

fn mcell(c: u64, idx: i64) -> u64 {
    return (sg(c, S_MCDF) as u64) + ((idx * 2) as u64)
}

fn kcell(c: u64, idx: i64) -> u64 {
    return (sg(c, S_CCDF) as u64) + ((idx * 2) as u64)
}

fn rs(c: u64, cdf: u64, n: i64) -> i64 {
    return av1sym.sym_read(symp(c), cdf, n)
}

fn rbool(c: u64) -> i64 {
    return av1sym.sym_bool(symp(c))
}

fn plane_ptr(c: u64, p: i64) -> u64 {
    return sg(c, S_PL0 + p) as u64
}

fn tile_plane(c: u64, p: i64) -> u64 {
    return plane_ptr(c, p)
}

fn tile_lftx(c: u64, p: i64) -> u64 {
    return sg(c, S_LFTX + p) as u64
}

fn tile_set_chroma(c: u64, planes: i64, subx: i64, suby: i64) {
    ss(c, S_NPL, planes)
    ss(c, S_SUBX, subx)
    ss(c, S_SUBY, suby)
}

fn psub_x(c: u64, plane: i64) -> i64 {
    if plane == 0 {
        return 0
    }
    return sg(c, S_SUBX)
}

fn psub_y(c: u64, plane: i64) -> i64 {
    if plane == 0 {
        return 0
    }
    return sg(c, S_SUBY)
}

fn plane_w(c: u64, plane: i64) -> i64 {
    return (sg(c, S_MC) * 4) >> psub_x(c, plane)
}

fn plane_h(c: u64, plane: i64) -> i64 {
    return (sg(c, S_MR) * 4) >> psub_y(c, plane)
}

fn plane_alloc_w(c: u64, plane: i64) -> i64 {
    return sg(c, S_STRIDE) >> psub_x(c, plane)
}

fn plane_alloc_h(c: u64, plane: i64) -> i64 {
    return (((sg(c, S_MR) + 31) & (0 - 32)) * 4) >> psub_y(c, plane)
}

fn plane_size(size: i64, sx: i64, sy: i64) -> i64 {
    let w4: i64 = imax(1, n4w(size) >> sx)
    let h4: i64 = imax(1, n4h(size) >> sy)
    var s: i64 = 0
    while s < 22 {
        if n4w(s) == w4 && n4h(s) == h4 {
            return s
        }
        s = s + 1
    }
    return 0
}

fn tile_set_grid(c: u64, tcols: i64, trows: i64, size_bytes: i64) {
    let g: u64 = zalloc_c(c, G_CELLS * 8)
    ss(g, G_COLS, tcols)
    ss(g, G_ROWS, trows)
    ss(g, G_SIZE_BYTES, size_bytes)
    ss(c, S_TINFO, g as i64)
}

fn tile_set_sb128(c: u64, on: i64) {
    ss(c, S_SBMI, 16 << on)
}

fn tile_set_col_start(c: u64, i: i64, sb_start: i64) {
    ss(sg(c, S_TINFO) as u64, G_COL_START + i, imin(sb_start * sg(c, S_SBMI), sg(c, S_MC)))
}

fn tile_set_row_start(c: u64, i: i64, sb_start: i64) {
    ss(sg(c, S_TINFO) as u64, G_ROW_START + i, imin(sb_start * sg(c, S_SBMI), sg(c, S_MR)))
}

fn tile_set_intrabc(c: u64, allow: i64) {
    ss(c, S_ALLOWIBC, allow)
    if allow == 0 {
        return
    }
    let mc: i64 = sg(c, S_MC)
    let mr: i64 = sg(c, S_MR)
    let mn: i64 = mc * mr + 64
    let ps: u64 = zalloc_c(c, av1ibc.IBC_CELLS * 8)
    av1ibc.ibc_bind(ps, zalloc_c(c, mn), zalloc_c(c, mn * 4), sg(c, S_MIS) as u64, zalloc_c(c, 256), mc, mr)
    ss(c, S_IBC, ps as i64)
    ss(c, S_TXTYPES, zalloc_c(c, mn) as i64)
}

fn tile_set_lr(c: u64, lr: u64) {
    ss(c, S_LR, lr as i64)
}

fn tile_skp(c: u64) -> u64 {
    return sg(c, S_SKP) as u64
}

fn tile_cdefidx(c: u64) -> u64 {
    return sg(c, S_CDEFIDX) as u64
}

fn tile_sbcols(c: u64) -> i64 {
    return sg(c, S_SBCOLS)
}

fn tile_stride(c: u64) -> i64 {
    return sg(c, S_STRIDE)
}

fn tile_err(c: u64) -> i64 {
    return sg(c, S_ERR)
}

fn tile_bits_left(c: u64) -> i64 {
    return av1sym.sym_bits_left(symp(c))
}

fn px(c: u64, p: i64, x: i64, y: i64) -> i64 {
    return ldw(plane_ptr(c, p), y * tile_stride(c) + x)
}

fn setpx(c: u64, p: i64, x: i64, y: i64, v: i64) {
    stw(plane_ptr(c, p), y * tile_stride(c) + x, v)
}

fn getab(c: u64, i: i64) -> i64 {
    return ldi(sg(c, S_ABOVE) as u64, i + 16)
}

fn setab(c: u64, i: i64, v: i64) {
    sti(sg(c, S_ABOVE) as u64, i + 16, v)
}

fn getlf(c: u64, i: i64) -> i64 {
    return ldi(sg(c, S_LEFT) as u64, i + 16)
}

fn setlf(c: u64, i: i64, v: i64) {
    sti(sg(c, S_LEFT) as u64, i + 16, v)
}

fn tile_new(data: u64, len: i64, mi_cols: i64, mi_rows: i64, enable_fi: i64, enable_ef: i64, upd: i64) -> u64 {
    let c: u64 = zalloc(4096)
    let sp: u64 = zalloc_c(c, 128)
    av1sym.sym_init(sp as *mut av1sym.Sym, data, len, upd)
    ss(c, S_SYM, sp as i64)
    ss(c, S_DATA, data as i64)
    ss(c, S_DLEN, len)
    ss(c, S_UPD, upd)
    ss(c, S_R1, mi_rows)
    ss(c, S_C1, mi_cols)
    let mc: u64 = zalloc_c(c, avif_cdf.CDF_MODE_LEN as i64 * 2 + 64)
    av1sym.cdf_copy(mc, avif_cdf.cdf_mode_addr(), avif_cdf.CDF_MODE_LEN as i64)
    ss(c, S_MCDF, mc as i64)
    let cc: u64 = zalloc_c(c, avif_cdf.CDF_COEF_QSTRIDE as i64 * 2 + 64)
    av1sym.cdf_copy(cc, avif_cdf.cdf_coef_addr(), avif_cdf.CDF_COEF_QSTRIDE as i64)
    ss(c, S_CCDF, cc as i64)
    ss(c, S_MC, mi_cols)
    ss(c, S_MR, mi_rows)
    let acols: i64 = (mi_cols + 31) & (0 - 32)
    let arows: i64 = (mi_rows + 31) & (0 - 32)
    ss(c, S_STRIDE, acols * 4)
    let pn: i64 = (acols * arows * 16 + 64) * 2
    ss(c, S_PL0, zalloc_c(c, pn) as i64)
    ss(c, S_PL1, zalloc_c(c, pn) as i64)
    ss(c, S_PL2, zalloc_c(c, pn) as i64)
    let mn: i64 = mi_cols * mi_rows + 64
    ss(c, S_YM, zalloc_c(c, mn) as i64)
    ss(c, S_UVM, zalloc_c(c, mn) as i64)
    ss(c, S_MIS, zalloc_c(c, mn) as i64)
    ss(c, S_SKP, zalloc_c(c, mn) as i64)
    let cn: i64 = imax(mi_cols, mi_rows) + 40
    ss(c, S_CN, cn)
    ss(c, S_ALC, zalloc_c(c, cn * 3) as i64)
    ss(c, S_ADC, zalloc_c(c, cn * 3) as i64)
    ss(c, S_LLC, zalloc_c(c, cn * 3) as i64)
    ss(c, S_LDC, zalloc_c(c, cn * 3) as i64)
    ss(c, S_BDEC, zalloc_c(c, 3 * 34 * 34) as i64)
    ss(c, S_QUANT, zalloc_c(c, 4096 + 64) as i64)
    ss(c, S_RES, zalloc_c(c, 256) as i64)
    ss(c, S_ABOVE, zalloc_c(c, 2048) as i64)
    ss(c, S_LEFT, zalloc_c(c, 2048) as i64)
    ss(c, S_TMP, zalloc_c(c, 32768) as i64)
    ss(c, S_TXS, zalloc_c(c, mn) as i64)
    ss(c, S_LFTX, zalloc_c(c, mn) as i64)
    ss(c, S_LFTX + 1, zalloc_c(c, mn) as i64)
    ss(c, S_LFTX + 2, zalloc_c(c, mn) as i64)
    ss(c, S_WORK, zalloc_c(c, av1recon.recon_work_size() + 64) as i64)
    ss(c, S_SBCOLS, (mi_cols + 15) >> 4)
    ss(c, S_SBMI, 16)
    ss(c, S_CDEFIDX, zalloc_c(c, ((mi_cols + 15) >> 4) * ((mi_rows + 15) >> 4) + 8) as i64)
    ss(c, S_LOSSLESS, 1)
    ss(c, S_BD, 8)
    let ps: u64 = zalloc_c(c, av1pal.PS_CELLS * 8)
    av1pal.pal_bind(ps, zalloc_c(c, mn), zalloc_c(c, mn), zalloc_c(c, mn * 16), zalloc_c(c, mn * 16), zalloc_c(c, 4096), zalloc_c(c, 4096))
    ss(c, S_PAL, ps as i64)
    ss(c, S_TCDF, zalloc_c(c, 64) as i64)
    ss(c, S_EFI, enable_fi)
    ss(c, S_EEF, enable_ef)
    ss(c, S_NPL, 3)
    return c
}

fn tile_free(c: u64) {
    var k: i64 = sg(c, S_NALLOC)
    while k > 0 {
        k = k - 1
        av1mem.heap_free(sg(c, S_ALLOC0 + k * 2) as u64 as *mut u8, sg(c, S_ALLOC0 + k * 2 + 1) as usize)
    }
    av1mem.heap_free(c as *mut u8, 4096)
}

fn qclip(v: i64) -> i64 {
    return imax(0, imin(255, v))
}

fn set_quant(c: u64, qidx: i64) {
    let bdi: i64 = sg(c, S_BDI)
    ss(c, S_DCQ + 0, av1lt.dc_q(bdi, qclip(qidx + sg(c, S_DQD + 0) - 128)))
    ss(c, S_DCQ + 1, av1lt.ac_q(bdi, qclip(qidx)))
    ss(c, S_DCQ + 2, av1lt.dc_q(bdi, qclip(qidx + sg(c, S_DQD + 1) - 128)))
    ss(c, S_DCQ + 3, av1lt.ac_q(bdi, qclip(qidx + sg(c, S_DQD + 2) - 128)))
    ss(c, S_DCQ + 4, av1lt.dc_q(bdi, qclip(qidx + sg(c, S_DQD + 3) - 128)))
    ss(c, S_DCQ + 5, av1lt.ac_q(bdi, qclip(qidx + sg(c, S_DQD + 4) - 128)))
}

fn tile_set_bit_depth(c: u64, bit_depth: i64) {
    ss(c, S_BD, bit_depth)
    ss(c, S_BDI, (bit_depth - 8) >> 1)
}

fn tile_set_sct(c: u64, sct: i64) {
    ss(c, S_SCT, sct)
}

fn tile_set_quant_ext(c: u64, qm_present: i64, qm_y: i64, qm_u: i64, qm_v: i64, dq_present: i64, dq_res: i64) {
    if qm_present != 0 {
        ss(c, S_QML + 0, qm_y)
        ss(c, S_QML + 1, qm_u)
        ss(c, S_QML + 2, qm_v)
    }
    ss(c, S_DQPRES, dq_present)
    ss(c, S_DQRES, dq_res)
}

fn tile_set_frame(c: u64, qidx: i64, tx_mode: i64, reduced_tx: i64, sct: i64, lossless: i64, dq_ydc: i64, dq_udc: i64, dq_uac: i64,
                  dq_vdc: i64, dq_vac: i64, bit_depth: i64, subx: i64, suby: i64, cdef_bits: i64, enable_cdef: i64, unsupported: i64) -> i64 {
    ss(c, S_QIDX, qidx)
    ss(c, S_TXMODE, tx_mode)
    ss(c, S_REDTX, reduced_tx)
    ss(c, S_SCT, sct)
    ss(c, S_LOSSLESS, lossless)
    ss(c, S_BD, bit_depth)
    ss(c, S_SUBX, subx)
    ss(c, S_SUBY, suby)
    ss(c, S_CDEFBITS, cdef_bits)
    ss(c, S_ENCDEF, enable_cdef)
    var qctx: i64 = 3
    if qidx <= 20 {
        qctx = 0
    } else if qidx <= 60 {
        qctx = 1
    } else if qidx <= 120 {
        qctx = 2
    }
    ss(c, S_QCTX, qctx)
    av1sym.cdf_copy(sg(c, S_CCDF) as u64, avif_cdf.cdf_coef_addr() + ((qctx * avif_cdf.CDF_COEF_QSTRIDE as i64 * 2) as u64), avif_cdf.CDF_COEF_QSTRIDE as i64)
    var bdi: i64 = (bit_depth - 8) >> 1
    if bit_depth < 8 || bit_depth > 12 {
        bdi = 0
    }
    ss(c, S_BDI, bdi)
    ss(c, S_DQD + 0, dq_ydc)
    ss(c, S_DQD + 1, dq_udc)
    ss(c, S_DQD + 2, dq_uac)
    ss(c, S_DQD + 3, dq_vdc)
    ss(c, S_DQD + 4, dq_vac)
    ss(c, S_QML + 0, av1qm.NONE_LEVEL)
    ss(c, S_QML + 1, av1qm.NONE_LEVEL)
    ss(c, S_QML + 2, av1qm.NONE_LEVEL)
    ss(c, S_CURQ, qidx)
    set_quant(c, qidx)
    var bad: i64 = unsupported
    if subx < suby || subx > 1 || (bit_depth != 8 && bit_depth != 10) {
        bad = 1
    }
    ss(c, S_ERR, bad)
    return bad
}

fn is_dir(m: i64) -> i64 {
    if m >= 1 && m <= 8 {
        return 1
    }
    return 0
}

fn edge_filter(c: u64, sz: i64, strength: i64, left: i64) {
    if strength == 0 {
        return
    }
    let tmp: u64 = sg(c, S_TMP) as u64
    var i: i64 = 0
    while i < sz {
        if left != 0 {
            sti(tmp, i, getlf(c, i - 1))
        } else {
            sti(tmp, i, getab(c, i - 1))
        }
        i = i + 1
    }
    i = 1
    while i < sz {
        var s: i64 = 0
        var j: i64 = 0
        while j < 5 {
            let k: i64 = imax(0, imin(sz - 1, i - 2 + j))
            s = s + (EDGE_K[((strength - 1) * 5 + j) as usize] as i64) * ldi(tmp, k)
            j = j + 1
        }
        if left != 0 {
            setlf(c, i - 1, (s + 8) >> 4)
        } else {
            setab(c, i - 1, (s + 8) >> 4)
        }
        i = i + 1
    }
}

fn edge_upsample(c: u64, num_px: i64, left: i64) {
    let tmp: u64 = sg(c, S_TMP) as u64
    var b0: i64 = 0
    if left != 0 {
        b0 = getlf(c, 0 - 1)
    } else {
        b0 = getab(c, 0 - 1)
    }
    sti(tmp, 0, b0)
    var i: i64 = 0 - 1
    while i < num_px {
        var v: i64 = 0
        if left != 0 {
            v = getlf(c, i)
        } else {
            v = getab(c, i)
        }
        sti(tmp, i + 2, v)
        i = i + 1
    }
    sti(tmp, num_px + 2, ldi(tmp, num_px + 1))
    if left != 0 {
        setlf(c, 0 - 2, ldi(tmp, 0))
    } else {
        setab(c, 0 - 2, ldi(tmp, 0))
    }
    i = 0
    while i < num_px {
        var s: i64 = 0 - ldi(tmp, i) + 9 * ldi(tmp, i + 1) + 9 * ldi(tmp, i + 2) - ldi(tmp, i + 3)
        s = clip1(c, round2(s, 4))
        if left != 0 {
            setlf(c, 2 * i - 1, s)
            setlf(c, 2 * i, ldi(tmp, i + 2))
        } else {
            setab(c, 2 * i - 1, s)
            setab(c, 2 * i, ldi(tmp, i + 2))
        }
        i = i + 1
    }
}

fn strength_sel(w: i64, h: i64, ft: i64, delta: i64) -> i64 {
    let d: i64 = iabs(delta)
    let wh: i64 = w + h
    var st: i64 = 0
    if ft == 0 {
        if wh <= 8 {
            if d >= 56 {
                st = 1
            }
        } else if wh <= 12 {
            if d >= 40 {
                st = 1
            }
        } else if wh <= 16 {
            if d >= 40 {
                st = 1
            }
        } else if wh <= 24 {
            if d >= 8 {
                st = 1
            }
            if d >= 16 {
                st = 2
            }
            if d >= 32 {
                st = 3
            }
        } else if wh <= 32 {
            st = 1
            if d >= 4 {
                st = 2
            }
            if d >= 32 {
                st = 3
            }
        } else {
            st = 3
        }
    } else {
        if wh <= 8 {
            if d >= 40 {
                st = 1
            }
            if d >= 64 {
                st = 2
            }
        } else if wh <= 16 {
            if d >= 20 {
                st = 1
            }
            if d >= 48 {
                st = 2
            }
        } else if wh <= 24 {
            if d >= 4 {
                st = 3
            }
        } else {
            st = 3
        }
    }
    return st
}

fn upsample_sel(w: i64, h: i64, ft: i64, delta: i64) -> i64 {
    let d: i64 = iabs(delta)
    let wh: i64 = w + h
    if d <= 0 || d >= 40 {
        return 0
    }
    if ft == 0 {
        if wh <= 16 {
            return 1
        }
        return 0
    }
    if wh <= 8 {
        return 1
    }
    return 0
}

fn is_smooth(c: u64, plane: i64, r: i64, cc: i64) -> i64 {
    var m: i64 = 0
    if plane == 0 {
        m = ldb(sg(c, S_YM) as u64, r * sg(c, S_MC) + cc)
    } else {
        m = ldb(sg(c, S_UVM) as u64, r * sg(c, S_MC) + cc)
    }
    if m >= 9 && m <= 11 {
        return 1
    }
    return 0
}

fn filter_type(c: u64, plane: i64) -> i64 {
    var a: i64 = 0
    var l: i64 = 0
    let r0: i64 = sg(c, S_ROW)
    let c0: i64 = sg(c, S_COL)
    let sx: i64 = psub_x(c, plane)
    let sy: i64 = psub_y(c, plane)
    var avu: i64 = sg(c, S_AVU)
    var avl: i64 = sg(c, S_AVL)
    if plane > 0 {
        avu = sg(c, S_AVUC)
        avl = sg(c, S_AVLC)
    }
    if avu != 0 {
        var rr: i64 = r0 - 1
        var cc: i64 = c0
        if sx != 0 && (c0 & 1) == 0 {
            cc = cc + 1
        }
        if sy != 0 && (r0 & 1) != 0 {
            rr = rr - 1
        }
        a = is_smooth(c, plane, rr, cc)
    }
    if avl != 0 {
        var rr: i64 = r0
        var cc: i64 = c0 - 1
        if sx != 0 && (c0 & 1) != 0 {
            cc = cc - 1
        }
        if sy != 0 && (r0 & 1) == 0 {
            rr = rr + 1
        }
        l = is_smooth(c, plane, rr, cc)
    }
    if a != 0 || l != 0 {
        return 1
    }
    return 0
}

fn dr_deriv(a: i64) -> i64 {
    return av1tab.t_dr_deriv(a)
}

fn pred_directional(c: u64, plane: i64, x: i64, y: i64, have_left: i64, have_above: i64, mode: i64, w: i64, h: i64) {
    let max_x: i64 = plane_w(c, plane) - 1
    let max_y: i64 = plane_h(c, plane) - 1
    var ang_delta: i64 = sg(c, S_ANGY)
    if plane != 0 {
        ang_delta = sg(c, S_ANGUV)
    }
    let pang: i64 = (MODE_ANGLE[mode as usize] as i64) + ang_delta * 3
    var ups_a: i64 = 0
    var ups_l: i64 = 0
    if sg(c, S_EEF) != 0 {
        if pang != 90 && pang != 180 {
            if pang > 90 && pang < 180 && (w + h) >= 24 {
                let s: i64 = getlf(c, 0) * 5 + getab(c, 0 - 1) * 6 + getab(c, 0) * 5
                let v: i64 = round2(s, 4)
                setlf(c, 0 - 1, v)
                setab(c, 0 - 1, v)
            }
            let ft: i64 = filter_type(c, plane)
            if have_above != 0 {
                let st: i64 = strength_sel(w, h, ft, pang - 90)
                var npx: i64 = imin(w, max_x - x + 1) + 1
                if pang < 90 {
                    npx = npx + h
                }
                edge_filter(c, npx, st, 0)
            }
            if have_left != 0 {
                let st: i64 = strength_sel(w, h, ft, pang - 180)
                var npx: i64 = imin(h, max_y - y + 1) + 1
                if pang > 180 {
                    npx = npx + w
                }
                edge_filter(c, npx, st, 1)
            }
            ups_a = upsample_sel(w, h, ft, pang - 90)
            var npa: i64 = w
            if pang < 90 {
                npa = npa + h
            }
            if ups_a != 0 {
                edge_upsample(c, npa, 0)
            }
            ups_l = upsample_sel(w, h, ft, pang - 180)
            var npl: i64 = h
            if pang > 180 {
                npl = npl + w
            }
            if ups_l != 0 {
                edge_upsample(c, npl, 1)
            }
        }
    }
    var dx: i64 = 0
    var dy: i64 = 0
    if pang < 90 {
        dx = dr_deriv(pang)
    } else if pang > 90 && pang < 180 {
        dx = dr_deriv(180 - pang)
    }
    if pang > 90 && pang < 180 {
        dy = dr_deriv(pang - 90)
    } else if pang > 180 {
        dy = dr_deriv(270 - pang)
    }
    var i: i64 = 0
    while i < h {
        var j: i64 = 0
        while j < w {
            var v: i64 = 0
            if pang < 90 {
                let idx: i64 = (i + 1) * dx
                let base: i64 = (idx >> (6 - ups_a)) + (j << ups_a)
                let shift: i64 = ((idx << ups_a) >> 1) & 31
                let max_base: i64 = (w + h - 1) << ups_a
                if base < max_base {
                    v = round2(getab(c, base) * (32 - shift) + getab(c, base + 1) * shift, 5)
                } else {
                    v = getab(c, max_base)
                }
            } else if pang > 90 && pang < 180 {
                let idx: i64 = (j << 6) - (i + 1) * dx
                let base: i64 = idx >> (6 - ups_a)
                if base >= 0 - (1 << ups_a) {
                    let shift: i64 = ((idx << ups_a) >> 1) & 31
                    v = round2(getab(c, base) * (32 - shift) + getab(c, base + 1) * shift, 5)
                } else {
                    let idy: i64 = (i << 6) - (j + 1) * dy
                    let basel: i64 = idy >> (6 - ups_l)
                    let shiftl: i64 = ((idy << ups_l) >> 1) & 31
                    v = round2(getlf(c, basel) * (32 - shiftl) + getlf(c, basel + 1) * shiftl, 5)
                }
            } else if pang > 180 {
                let idx: i64 = (j + 1) * dy
                let base: i64 = (idx >> (6 - ups_l)) + (i << ups_l)
                let shift: i64 = ((idx << ups_l) >> 1) & 31
                v = round2(getlf(c, base) * (32 - shift) + getlf(c, base + 1) * shift, 5)
            } else if pang == 90 {
                v = getab(c, j)
            } else {
                v = getlf(c, i)
            }
            setpx(c, plane, x + j, y + i, v)
            j = j + 1
        }
        i = i + 1
    }
}

fn pred_filter_intra(c: u64, plane: i64, x: i64, y: i64, w: i64, h: i64) {
    let fim: i64 = sg(c, S_FIM)
    let p: u64 = sg(c, S_TMP) as u64
    let w4: i64 = w >> 2
    let h2: i64 = h >> 1
    var i2: i64 = 0
    while i2 < h2 {
        var j4: i64 = 0
        while j4 < w4 {
            var i: i64 = 0
            while i < 7 {
                var v: i64 = 0
                if i < 5 {
                    if i2 == 0 {
                        v = getab(c, (j4 << 2) + i - 1)
                    } else if j4 == 0 && i == 0 {
                        v = getlf(c, (i2 << 1) - 1)
                    } else {
                        v = px(c, plane, x + (j4 << 2) + i - 1, y + (i2 << 1) - 1)
                    }
                } else {
                    if j4 == 0 {
                        v = getlf(c, (i2 << 1) + i - 5)
                    } else {
                        v = px(c, plane, x + (j4 << 2) - 1, y + (i2 << 1) + i - 5)
                    }
                }
                sti(p, i, v)
                i = i + 1
            }
            var i1: i64 = 0
            while i1 < 2 {
                var j1: i64 = 0
                while j1 < 4 {
                    var pr: i64 = 0
                    var k: i64 = 0
                    while k < 7 {
                        pr = pr + av1tab.t_filter_taps(fim * 56 + ((i1 << 2) + j1) * 7 + k) * ldi(p, k)
                        k = k + 1
                    }
                    setpx(c, plane, x + (j4 << 2) + j1, y + (i2 << 1) + i1, clip1(c, round2s(pr, 4)))
                    j1 = j1 + 1
                }
                i1 = i1 + 1
            }
            j4 = j4 + 1
        }
        i2 = i2 + 1
    }
}

fn predict_intra(c: u64, plane: i64, x: i64, y: i64, have_left: i64, have_above: i64, har: i64, hbl: i64, mode: i64, txsz: i64) {
    let w: i64 = av1tab2.t_txw(txsz)
    let h: i64 = av1tab2.t_txh(txsz)
    let log2w: i64 = av1tab2.t_txwl(txsz)
    let log2h: i64 = av1tab2.t_txhl(txsz)
    let max_x: i64 = plane_w(c, plane) - 1
    let max_y: i64 = plane_h(c, plane) - 1
    var i: i64 = 0
    while i < w + h {
        if have_above == 0 && have_left != 0 {
            setab(c, i, px(c, plane, x - 1, y))
        } else if have_above == 0 {
            setab(c, i, mid_value(c) - 1)
        } else {
            var lim: i64 = x + w - 1
            if har != 0 {
                lim = x + 2 * w - 1
            }
            lim = imin(max_x, lim)
            setab(c, i, px(c, plane, imin(lim, x + i), y - 1))
        }
        if have_left == 0 && have_above != 0 {
            setlf(c, i, px(c, plane, x, y - 1))
        } else if have_left == 0 {
            setlf(c, i, mid_value(c) + 1)
        } else {
            var lim: i64 = y + h - 1
            if hbl != 0 {
                lim = y + 2 * h - 1
            }
            lim = imin(max_y, lim)
            setlf(c, i, px(c, plane, x - 1, imin(lim, y + i)))
        }
        i = i + 1
    }
    var corner: i64 = mid_value(c)
    if have_above != 0 && have_left != 0 {
        corner = px(c, plane, x - 1, y - 1)
    } else if have_above != 0 {
        corner = px(c, plane, x, y - 1)
    } else if have_left != 0 {
        corner = px(c, plane, x - 1, y)
    }
    setab(c, 0 - 1, corner)
    setlf(c, 0 - 1, corner)
    if plane == 0 && sg(c, S_UFI) != 0 {
        pred_filter_intra(c, plane, x, y, w, h)
        return
    }
    if is_dir(mode) != 0 {
        pred_directional(c, plane, x, y, have_left, have_above, mode, w, h)
        return
    }
    if mode >= 9 && mode <= 11 {
        i = 0
        while i < h {
            var j: i64 = 0
            while j < w {
                var v: i64 = 0
                let wy: i64 = av1tab2.t_smw(h, i)
                let wx: i64 = av1tab2.t_smw(w, j)
                if mode == 9 {
                    v = round2(wy * getab(c, j) + (256 - wy) * getlf(c, h - 1) + wx * getlf(c, i) + (256 - wx) * getab(c, w - 1), 9)
                } else if mode == 10 {
                    v = round2(wy * getab(c, j) + (256 - wy) * getlf(c, h - 1), 8)
                } else {
                    v = round2(wx * getlf(c, i) + (256 - wx) * getab(c, w - 1), 8)
                }
                setpx(c, plane, x + j, y + i, v)
                j = j + 1
            }
            i = i + 1
        }
        return
    }
    if mode == 0 {
        var sum: i64 = 0
        var k: i64 = 0
        var v: i64 = mid_value(c)
        if have_left != 0 && have_above != 0 {
            while k < h {
                sum = sum + getlf(c, k)
                k = k + 1
            }
            k = 0
            while k < w {
                sum = sum + getab(c, k)
                k = k + 1
            }
            v = (sum + ((w + h) >> 1)) / (w + h)
        } else if have_left != 0 {
            while k < h {
                sum = sum + getlf(c, k)
                k = k + 1
            }
            v = clip1(c, (sum + (h >> 1)) >> log2h)
        } else if have_above != 0 {
            while k < w {
                sum = sum + getab(c, k)
                k = k + 1
            }
            v = clip1(c, (sum + (w >> 1)) >> log2w)
        }
        i = 0
        while i < h {
            var j: i64 = 0
            while j < w {
                setpx(c, plane, x + j, y + i, v)
                j = j + 1
            }
            i = i + 1
        }
        return
    }
    i = 0
    while i < h {
        var j: i64 = 0
        while j < w {
            let base: i64 = getab(c, j) + getlf(c, i) - getab(c, 0 - 1)
            let pl: i64 = iabs(base - getlf(c, i))
            let pt: i64 = iabs(base - getab(c, j))
            let ptl: i64 = iabs(base - getab(c, 0 - 1))
            var v: i64 = 0
            if pl <= pt && pl <= ptl {
                v = getlf(c, i)
            } else if pt <= ptl {
                v = getab(c, j)
            } else {
                v = getab(c, 0 - 1)
            }
            setpx(c, plane, x + j, y + i, v)
            j = j + 1
        }
        i = i + 1
    }
}

fn predict_cfl(c: u64, plane: i64, sx: i64, sy: i64, txsz: i64) {
    let w: i64 = av1tab2.t_txw(txsz)
    let h: i64 = av1tab2.t_txh(txsz)
    let subx: i64 = sg(c, S_SUBX)
    let suby: i64 = sg(c, S_SUBY)
    var alpha: i64 = sg(c, S_CAU)
    if plane == 2 {
        alpha = sg(c, S_CAV)
    }
    let l: u64 = sg(c, S_TMP) as u64
    var avg: i64 = 0
    var i: i64 = 0
    while i < h {
        let ly: i64 = imin((sy + i) << suby, sg(c, S_MAXLH) - (1 << suby))
        var j: i64 = 0
        while j < w {
            let lx: i64 = imin((sx + j) << subx, sg(c, S_MAXLW) - (1 << subx))
            var t: i64 = 0
            var dy: i64 = 0
            while dy <= suby {
                var dx: i64 = 0
                while dx <= subx {
                    t = t + px(c, 0, lx + dx, ly + dy)
                    dx = dx + 1
                }
                dy = dy + 1
            }
            let v: i64 = t << (3 - subx - suby)
            sti(l, i * w + j, v)
            avg = avg + v
            j = j + 1
        }
        i = i + 1
    }
    avg = round2(avg, av1tab2.t_txwl(txsz) + av1tab2.t_txhl(txsz))
    i = 0
    while i < h {
        var j: i64 = 0
        while j < w {
            let dc: i64 = px(c, plane, sx + j, sy + i)
            let sc: i64 = round2s(alpha * (ldi(l, i * w + j) - avg), 6)
            setpx(c, plane, sx + j, sy + i, clip1(c, dc + sc))
            j = j + 1
        }
        i = i + 1
    }
}

fn tx_class(t: i64) -> i64 {
    if t == 10 || t == 12 || t == 14 {
        return 2
    }
    if t == 11 || t == 13 || t == 15 {
        return 1
    }
    return 0
}

fn tx_set(c: u64, txsz: i64) -> i64 {
    if av1tab2.t_sqrup(txsz) >= 3 {
        return 0
    }
    if sg(c, S_REDTX) != 0 || av1tab2.t_sqr(txsz) == 2 {
        return 2
    }
    return 1
}

fn eob_cdf(c: u64, ms: i64, ptype: i64, cls: i64) -> u64 {
    var base: i64 = avif_cdf.K_EOB_MULTI16 as i64
    if ms == 1 {
        base = avif_cdf.K_EOB_MULTI32 as i64
    } else if ms == 2 {
        base = avif_cdf.K_EOB_MULTI64 as i64
    } else if ms == 3 {
        base = avif_cdf.K_EOB_MULTI128 as i64
    } else if ms == 4 {
        base = avif_cdf.K_EOB_MULTI256 as i64
    } else if ms == 5 {
        base = avif_cdf.K_EOB_MULTI512 as i64
    } else if ms == 6 {
        base = avif_cdf.K_EOB_MULTI1024 as i64
    }
    var k: i64 = 0
    if ms < 5 && cls != 0 {
        k = 1
    }
    return kcell(c, base + (ptype * 2 + k) * (ms + 6))
}

fn read_inter_tx_type(c: u64, txsz: i64) {
    let set: i64 = av1intertx.inter_set(av1tab2.t_sqr(txsz), av1tab2.t_sqrup(txsz), sg(c, S_REDTX))
    var t: i64 = 0
    if set > 0 && sg(c, S_QIDX) > 0 {
        let cdf: u64 = mcell(c, avif_cdf.M_INTER_EXT_TX as i64 + ((set - 1) * 4 + av1tab2.t_sqr(txsz)) * 17)
        t = av1intertx.inter_inv(set, rs(c, cdf, av1intertx.inter_nsym(set)))
    }
    ss(c, S_TXTYPE, t)
}

fn chroma_inter_tx_type(c: u64, txsz: i64, x4: i64, y4: i64) -> i64 {
    let set: i64 = av1intertx.inter_set(av1tab2.t_sqr(txsz), av1tab2.t_sqrup(txsz), sg(c, S_REDTX))
    let lx: i64 = imax(sg(c, S_COL), x4 << sg(c, S_SUBX))
    let ly: i64 = imax(sg(c, S_ROW), y4 << sg(c, S_SUBY))
    let t: i64 = ldb(sg(c, S_TXTYPES) as u64, ly * sg(c, S_MC) + lx)
    if av1intertx.in_set_inter(set, t) != 0 {
        return t
    }
    return 0
}

fn store_tx_types(c: u64, x4: i64, y4: i64, w4: i64, h4: i64, t: i64) {
    if sg(c, S_ISINTER) == 0 {
        return
    }
    let map: u64 = sg(c, S_TXTYPES) as u64
    let mc: i64 = sg(c, S_MC)
    let mr: i64 = sg(c, S_MR)
    var i: i64 = 0
    while i < h4 {
        var j: i64 = 0
        while j < w4 {
            if y4 + i < mr && x4 + j < mc {
                stb(map, (y4 + i) * mc + x4 + j, t)
            }
            j = j + 1
        }
        i = i + 1
    }
}

fn read_tx_type(c: u64, txsz: i64) {
    if sg(c, S_ISINTER) != 0 {
        read_inter_tx_type(c, txsz)
        return
    }
    let set: i64 = tx_set(c, txsz)
    var t: i64 = 0
    if set > 0 && sg(c, S_QIDX) > 0 {
        var dir: i64 = sg(c, S_YMODE)
        if sg(c, S_UFI) != 0 {
            dir = FIM2DIR[sg(c, S_FIM) as usize] as i64
        }
        let cdf: u64 = mcell(c, avif_cdf.M_INTRA_EXT_TX as i64 + (((set - 1) * 4 + av1tab2.t_sqr(txsz)) * 13 + dir) * 8)
        if set == 1 {
            t = av1tab2.t_inv1(rs(c, cdf, 7))
        } else {
            t = av1tab2.t_inv2(rs(c, cdf, 5))
        }
    }
    ss(c, S_TXTYPE, t)
}

fn coeffs(c: u64, plane: i64, sx: i64, sy: i64, txsz: i64) -> i64 {
    let x4: i64 = sx >> 2
    let y4: i64 = sy >> 2
    let w: i64 = av1tab2.t_txw(txsz)
    let h: i64 = av1tab2.t_txh(txsz)
    let w4: i64 = w >> 2
    let h4: i64 = h >> 2
    let txc: i64 = (av1tab2.t_sqr(txsz) + av1tab2.t_sqrup(txsz) + 1) >> 1
    var ptype: i64 = plane
    if ptype > 1 {
        ptype = 1
    }
    let adj: i64 = av1tab2.t_adj(txsz)
    let bwl: i64 = av1tab2.t_txwl(adj)
    let width: i64 = 1 << bwl
    let height: i64 = av1tab2.t_txh(adj)
    let q: u64 = sg(c, S_QUANT) as u64
    var k: i64 = 0
    while k < width * height {
        sti(q, k, 0)
        k = k + 1
    }
    let cn: i64 = sg(c, S_CN)
    let alc: u64 = sg(c, S_ALC) as u64
    let adc: u64 = sg(c, S_ADC) as u64
    let llc: u64 = sg(c, S_LLC) as u64
    let ldc: u64 = sg(c, S_LDC) as u64
    let maxx4: i64 = (sg(c, S_MC) + psub_x(c, plane)) >> psub_x(c, plane)
    let maxy4: i64 = (sg(c, S_MR) + psub_y(c, plane)) >> psub_y(c, plane)
    var top: i64 = 0
    var left: i64 = 0
    var ab: i64 = 0
    var lb: i64 = 0
    k = 0
    while k < w4 {
        if x4 + k < maxx4 {
            top = imax(top, ldb(alc, plane * cn + x4 + k))
            ab = ab | ldb(alc, plane * cn + x4 + k) | ldb(adc, plane * cn + x4 + k)
        }
        k = k + 1
    }
    k = 0
    while k < h4 {
        if y4 + k < maxy4 {
            left = imax(left, ldb(llc, plane * cn + y4 + k))
            lb = lb | ldb(llc, plane * cn + y4 + k) | ldb(ldc, plane * cn + y4 + k)
        }
        k = k + 1
    }
    let bsz: i64 = sg(c, S_SIZE)
    let bw: i64 = imax(1, n4w(bsz) >> psub_x(c, plane)) * 4
    let bh: i64 = imax(1, n4h(bsz) >> psub_y(c, plane)) * 4
    var ctx: i64 = 0
    if plane == 0 {
        if bw == w && bh == h {
            ctx = 0
        } else if top == 0 && left == 0 {
            ctx = 1
        } else if top == 0 || left == 0 {
            ctx = 2
            if imax(top, left) > 3 {
                ctx = 3
            }
        } else if imax(top, left) <= 3 {
            ctx = 4
        } else if imin(top, left) <= 3 {
            ctx = 5
        } else {
            ctx = 6
        }
    } else {
        ctx = 7
        if ab != 0 {
            ctx = ctx + 1
        }
        if lb != 0 {
            ctx = ctx + 1
        }
        if bw * bh > w * h {
            ctx = ctx + 3
        }
    }
    var eob: i64 = 0
    var cul: i64 = 0
    var dccat: i64 = 0
    let az: i64 = rs(c, kcell(c, avif_cdf.K_TXB_SKIP as i64 + (txc * 13 + ctx) * 3), 2)
    if az != 0 && plane == 0 {
        store_tx_types(c, x4, y4, w4, h4, 0)
    }
    if az == 0 {
        var tt: i64 = 0
        if sg(c, S_LOSSLESS) == 0 && av1tab2.t_sqrup(txsz) <= 3 {
            if plane == 0 {
                read_tx_type(c, txsz)
                tt = sg(c, S_TXTYPE)
            } else if sg(c, S_ISINTER) != 0 {
                tt = chroma_inter_tx_type(c, txsz, x4, y4)
            } else {
                let cand: i64 = av1tab2.t_mode2tx(sg(c, S_UVMODE))
                if av1tab2.t_inset(tx_set(c, txsz) * 16 + cand) != 0 {
                    tt = cand
                }
            }
        }
        ss(c, S_TXTYPE, tt)
        if plane == 0 {
            store_tx_types(c, x4, y4, w4, h4, tt)
        }
        let cls: i64 = tx_class(tt)
        var skind: i64 = 0
        if cls == 2 {
            skind = 1
        } else if cls == 1 {
            skind = 2
        }
        let ms: i64 = imin(av1tab2.t_txwl(txsz), 5) + imin(av1tab2.t_txhl(txsz), 5) - 4
        let eobpt: i64 = rs(c, eob_cdf(c, ms, ptype, cls), ms + 5) + 1
        if eobpt < 2 {
            eob = eobpt
        } else {
            eob = (1 << (eobpt - 2)) + 1
        }
        let eshift: i64 = imax(0 - 1, eobpt - 3)
        if eshift >= 0 {
            let ex: i64 = rs(c, kcell(c, avif_cdf.K_EOB_EXTRA as i64 + ((txc * 2 + ptype) * 9 + (eobpt - 3)) * 3), 2)
            if ex != 0 {
                eob = eob + (1 << eshift)
            }
            var i: i64 = 1
            while i < imax(0, eobpt - 2) {
                let sh: i64 = imax(0, eobpt - 2) - 1 - i
                if rbool(c) != 0 {
                    eob = eob + (1 << sh)
                }
                i = i + 1
            }
        }
        var ci: i64 = eob - 1
        while ci >= 0 {
            let pos: i64 = av1lt.scan_at(txsz, skind, ci)
            let row: i64 = pos >> bwl
            let col: i64 = pos - (row << bwl)
            var level: i64 = 0
            if ci == eob - 1 {
                var ec: i64 = 3
                if ci == 0 {
                    ec = 0
                } else if ci <= (height << bwl) / 8 {
                    ec = 1
                } else if ci <= (height << bwl) / 4 {
                    ec = 2
                }
                level = rs(c, kcell(c, avif_cdf.K_COEFF_BASE_EOB_MULTI as i64 + ((txc * 2 + ptype) * 4 + ec) * 4), 3) + 1
            } else {
                var mag: i64 = 0
                var t: i64 = 0
                while t < 5 {
                    let rr: i64 = row + av1tab2.t_sigref((cls * 5 + t) * 2)
                    let cc2: i64 = col + av1tab2.t_sigref((cls * 5 + t) * 2 + 1)
                    if rr >= 0 && cc2 >= 0 && rr < height && cc2 < width {
                        mag = mag + imin(iabs(ldi(q, (rr << bwl) + cc2)), 3)
                    }
                    t = t + 1
                }
                var bc: i64 = imin((mag + 1) >> 1, 4)
                if cls == 0 {
                    if row == 0 && col == 0 {
                        bc = 0
                    } else {
                        bc = bc + av1tab2.t_cbctx(txsz * 25 + imin(row, 4) * 5 + imin(col, 4))
                    }
                } else {
                    var idx: i64 = col
                    if cls == 2 {
                        idx = row
                    }
                    bc = bc + av1tab2.t_cbpos(imin(idx, 2))
                }
                level = rs(c, kcell(c, avif_cdf.K_COEFF_BASE_MULTI as i64 + ((txc * 2 + ptype) * 42 + bc) * 5), 4)
            }
            if level > 2 {
                var mag: i64 = 0
                var t: i64 = 0
                while t < 3 {
                    let rr: i64 = row + av1tab2.t_magref((cls * 3 + t) * 2)
                    let cc2: i64 = col + av1tab2.t_magref((cls * 3 + t) * 2 + 1)
                    if rr >= 0 && cc2 >= 0 && rr < height && cc2 < width {
                        mag = mag + imin(ldi(q, rr * width + cc2), 15)
                    }
                    t = t + 1
                }
                mag = imin((mag + 1) >> 1, 6)
                var bctx: i64 = mag
                if pos != 0 {
                    var near: i64 = 0
                    if cls == 0 {
                        if row < 2 && col < 2 {
                            near = 1
                        }
                    } else if cls == 1 {
                        if col == 0 {
                            near = 1
                        }
                    } else if row == 0 {
                        near = 1
                    }
                    if near != 0 {
                        bctx = mag + 7
                    } else {
                        bctx = mag + 14
                    }
                }
                var idx: i64 = 0
                while idx < 4 {
                    let br: i64 = rs(c, kcell(c, avif_cdf.K_COEFF_LPS_MULTI as i64 + ((imin(txc, 3) * 2 + ptype) * 21 + bctx) * 5), 4)
                    level = level + br
                    if br < 3 {
                        break
                    }
                    idx = idx + 1
                }
            }
            sti(q, pos, level)
            ci = ci - 1
        }
        ci = 0
        while ci < eob {
            let pos: i64 = av1lt.scan_at(txsz, skind, ci)
            var v: i64 = ldi(q, pos)
            var sign: i64 = 0
            if v != 0 {
                if ci == 0 {
                    var ds: i64 = 0
                    k = 0
                    while k < w4 {
                        if x4 + k < maxx4 {
                            let s1: i64 = ldb(adc, plane * cn + x4 + k)
                            if s1 == 1 {
                                ds = ds - 1
                            } else if s1 == 2 {
                                ds = ds + 1
                            }
                        }
                        k = k + 1
                    }
                    k = 0
                    while k < h4 {
                        if y4 + k < maxy4 {
                            let s2: i64 = ldb(ldc, plane * cn + y4 + k)
                            if s2 == 1 {
                                ds = ds - 1
                            } else if s2 == 2 {
                                ds = ds + 1
                            }
                        }
                        k = k + 1
                    }
                    var dctx: i64 = 0
                    if ds < 0 {
                        dctx = 1
                    } else if ds > 0 {
                        dctx = 2
                    }
                    sign = rs(c, kcell(c, avif_cdf.K_DC_SIGN as i64 + (ptype * 3 + dctx) * 3), 2)
                } else {
                    sign = rbool(c)
                }
            }
            if v > 14 {
                var length: i64 = 0
                while length < 32 {
                    length = length + 1
                    if rbool(c) != 0 {
                        break
                    }
                }
                var xg: i64 = 1
                var i: i64 = length - 2
                while i >= 0 {
                    xg = (xg << 1) | rbool(c)
                    i = i - 1
                }
                v = xg + 14
            }
            if pos == 0 && v > 0 {
                if sign != 0 {
                    dccat = 1
                } else {
                    dccat = 2
                }
            }
            v = v & 1048575
            cul = cul + v
            if sign != 0 {
                v = 0 - v
            }
            sti(q, pos, v)
            ci = ci + 1
        }
        cul = imin(63, cul)
    }
    k = 0
    while k < w4 {
        stb(alc, plane * cn + x4 + k, cul)
        stb(adc, plane * cn + x4 + k, dccat)
        k = k + 1
    }
    k = 0
    while k < h4 {
        stb(llc, plane * cn + y4 + k, cul)
        stb(ldc, plane * cn + y4 + k, dccat)
        k = k + 1
    }
    return eob
}

fn wht(t: u64, shift: i64) {
    var a: i64 = ldi(t, 0) >> shift
    var cc: i64 = ldi(t, 1) >> shift
    var d: i64 = ldi(t, 2) >> shift
    var b: i64 = ldi(t, 3) >> shift
    a = a + cc
    d = d - b
    let e: i64 = (a - d) >> 1
    b = e - b
    cc = e - cc
    a = a - b
    d = d + cc
    sti(t, 0, a)
    sti(t, 1, b)
    sti(t, 2, cc)
    sti(t, 3, d)
}

fn reconstruct_wht(c: u64, plane: i64, sx: i64, sy: i64) {
    let q: u64 = sg(c, S_QUANT) as u64
    let r: u64 = sg(c, S_RES) as u64
    var i: i64 = 0
    while i < 16 {
        let dq: i64 = ldi(q, i) * 4
        var v: i64 = iabs(dq) & 16777215
        if dq < 0 {
            v = 0 - v
        }
        v = imax(0 - 32768, imin(32767, v))
        sti(r, i, v)
        i = i + 1
    }
    let t: u64 = sg(c, S_TMP) as u64
    i = 0
    while i < 4 {
        var j: i64 = 0
        while j < 4 {
            sti(t, j, ldi(r, i * 4 + j))
            j = j + 1
        }
        wht(t, 2)
        j = 0
        while j < 4 {
            sti(r, i * 4 + j, imax(0 - 32768, imin(32767, ldi(t, j))))
            j = j + 1
        }
        i = i + 1
    }
    var j2: i64 = 0
    while j2 < 4 {
        i = 0
        while i < 4 {
            sti(t, i, ldi(r, i * 4 + j2))
            i = i + 1
        }
        wht(t, 0)
        i = 0
        while i < 4 {
            sti(r, i * 4 + j2, ldi(t, i))
            i = i + 1
        }
        j2 = j2 + 1
    }
    i = 0
    while i < 4 {
        var j: i64 = 0
        while j < 4 {
            setpx(c, plane, sx + j, sy + i, clip1(c, px(c, plane, sx + j, sy + i) + ldi(r, i * 4 + j)))
            j = j + 1
        }
        i = i + 1
    }
}

fn reconstruct(c: u64, plane: i64, sx: i64, sy: i64, txsz: i64) {
    if sg(c, S_LOSSLESS) != 0 {
        reconstruct_wht(c, plane, sx, sy)
        return
    }
    var qm: u64 = 0
    let level: i64 = sg(c, S_QML + plane)
    if level < av1qm.NONE_LEVEL && sg(c, S_TXTYPE) < 9 {
        var chroma: i64 = 0
        if plane > 0 {
            chroma = 1
        }
        qm = av1qm.level_base(level, chroma) + (av1qm.tx_offset(av1txfm.tx_log2w(txsz), av1txfm.tx_log2h(txsz)) as u64)
    }
    av1recon.recon_block(sg(c, S_WORK) as u64, sg(c, S_QUANT) as u64, plane_ptr(c, plane), tile_stride(c), sx, sy, plane_alloc_w(c, plane), plane_alloc_h(c, plane),
                         txsz, sg(c, S_TXTYPE), sg(c, S_DCQ + plane * 2), sg(c, S_DCQ + plane * 2 + 1), sg(c, S_BD), qm)
}

fn predict_palette(c: u64, plane: i64, sx: i64, sy: i64, x: i64, y: i64, txsz: i64) {
    let ps: u64 = sg(c, S_PAL) as u64
    let w: i64 = av1tab2.t_txw(txsz)
    let h: i64 = av1tab2.t_txh(txsz)
    var i: i64 = 0
    while i < h {
        var j: i64 = 0
        while j < w {
            setpx(c, plane, sx + j, sy + i, av1pal.pal_color(ps, plane, x * 4 + j, y * 4 + i))
            j = j + 1
        }
        i = i + 1
    }
}

fn transform_block(c: u64, plane: i64, sx: i64, sy: i64, x: i64, y: i64, txsz: i64) {
    if sx >= plane_w(c, plane) || sy >= plane_h(c, plane) {
        return
    }
    let psx: i64 = psub_x(c, plane)
    let psy: i64 = psub_y(c, plane)
    let stepx: i64 = av1tab2.t_txw(txsz) >> 2
    let stepy: i64 = av1tab2.t_txh(txsz) >> 2
    let prow: i64 = sy >> 2
    let pcol: i64 = sx >> 2
    let sbmask: i64 = sg(c, S_SBMI) - 1
    let sbr: i64 = ((sy << psy) >> 2) & sbmask
    let sbc: i64 = ((sx << psx) >> 2) & sbmask
    let bdr: i64 = sbr >> psy
    let bdc: i64 = sbc >> psx
    let bd: u64 = sg(c, S_BDEC) as u64
    var isc: i64 = 0
    if plane > 0 && sg(c, S_UVMODE) == 13 {
        isc = 1
    }
    var mode: i64 = sg(c, S_YMODE)
    if plane > 0 {
        mode = sg(c, S_UVMODE)
        if isc != 0 {
            mode = 0
        }
    }
    var hl: i64 = sg(c, S_AVL)
    var ha: i64 = sg(c, S_AVU)
    if plane > 0 {
        hl = sg(c, S_AVLC)
        ha = sg(c, S_AVUC)
    }
    if x > 0 {
        hl = 1
    }
    if y > 0 {
        ha = 1
    }
    let har: i64 = ldb(bd, (plane * 34 + bdr) * 34 + bdc + stepx + 1)
    let hbl: i64 = ldb(bd, (plane * 34 + bdr + stepy + 1) * 34 + bdc)
    let pps: u64 = sg(c, S_PAL) as u64
    if sg(c, S_ISINTER) == 0 {
        if (plane == 0 && av1pal.pal_size_y(pps) > 0) || (plane > 0 && av1pal.pal_size_uv(pps) > 0) {
            predict_palette(c, plane, sx, sy, x, y, txsz)
        } else {
            predict_intra(c, plane, sx, sy, hl, ha, har, hbl, mode, txsz)
            if isc != 0 {
                predict_cfl(c, plane, sx, sy, txsz)
            }
        }
    }
    if plane == 0 {
        ss(c, S_MAXLW, sx + stepx * 4)
        ss(c, S_MAXLH, sy + stepy * 4)
    }
    if sg(c, S_SKIP) == 0 {
        let eob: i64 = coeffs(c, plane, sx, sy, txsz)
        if eob > 0 {
            reconstruct(c, plane, sx, sy, txsz)
        }
    }
    let lft: u64 = sg(c, S_LFTX + plane) as u64
    let lmc: i64 = sg(c, S_MC)
    let lmr: i64 = sg(c, S_MR)
    var i: i64 = 0
    while i < stepy {
        var j: i64 = 0
        while j < stepx {
            if prow + i < lmr && pcol + j < lmc {
                stb(lft, (prow + i) * lmc + pcol + j, txsz)
            }
            stb(bd, (plane * 34 + bdr + i + 1) * 34 + bdc + j + 1, 1)
            j = j + 1
        }
        i = i + 1
    }
}

fn find_tx_size(w: i64, h: i64) -> i64 {
    var t: i64 = 0
    while t < 19 {
        if av1tab2.t_txw(t) == w && av1tab2.t_txh(t) == h {
            return t
        }
        t = t + 1
    }
    return 0
}

fn transform_tree(c: u64, sx: i64, sy: i64, w: i64, h: i64) {
    if sx >= sg(c, S_MC) * 4 || sy >= sg(c, S_MR) * 4 {
        return
    }
    let lt: i64 = ldb(sg(c, S_TXS) as u64, (sy >> 2) * sg(c, S_MC) + (sx >> 2))
    if w <= av1tab2.t_txw(lt) && h <= av1tab2.t_txh(lt) {
        transform_block(c, 0, sx, sy, 0, 0, find_tx_size(w, h))
    } else if w > h {
        transform_tree(c, sx, sy, w / 2, h)
        transform_tree(c, sx + w / 2, sy, w / 2, h)
    } else if w < h {
        transform_tree(c, sx, sy, w, h / 2)
        transform_tree(c, sx, sy + h / 2, w, h / 2)
    } else {
        transform_tree(c, sx, sy, w / 2, h / 2)
        transform_tree(c, sx + w / 2, sy, w / 2, h / 2)
        transform_tree(c, sx, sy + h / 2, w / 2, h / 2)
        transform_tree(c, sx + w / 2, sy + h / 2, w / 2, h / 2)
    }
}

fn is_ibc_at(c: u64, r: i64, cc: i64) -> bool {
    if sg(c, S_IBC) == 0 {
        return false
    }
    return av1ibc.ibc_kind(sg(c, S_IBC) as u64, r, cc) == 2
}

fn above_tx_width(c: u64, row: i64, col: i64) -> i64 {
    let mc: i64 = sg(c, S_MC)
    if row == sg(c, S_ROW) {
        if sg(c, S_AVU) == 0 {
            return 64
        }
        if ldb(sg(c, S_SKP) as u64, (row - 1) * mc + col) != 0 && is_ibc_at(c, row - 1, col) {
            return n4w(ldb(sg(c, S_MIS) as u64, (row - 1) * mc + col)) * 4
        }
    }
    return av1tab2.t_txw(ldb(sg(c, S_TXS) as u64, (row - 1) * mc + col))
}

fn left_tx_height(c: u64, row: i64, col: i64) -> i64 {
    let mc: i64 = sg(c, S_MC)
    if col == sg(c, S_COL) {
        if sg(c, S_AVL) == 0 {
            return 64
        }
        if ldb(sg(c, S_SKP) as u64, row * mc + col - 1) != 0 && is_ibc_at(c, row, col - 1) {
            return n4h(ldb(sg(c, S_MIS) as u64, row * mc + col - 1)) * 4
        }
    }
    return av1tab2.t_txh(ldb(sg(c, S_TXS) as u64, row * mc + col - 1))
}

fn read_var_tx_size(c: u64, row: i64, col: i64, txsz: i64, depth: i64) {
    let mc: i64 = sg(c, S_MC)
    let mr: i64 = sg(c, S_MR)
    if row >= mr || col >= mc {
        return
    }
    var split: i64 = 0
    if txsz != 0 && depth != 2 {
        let size: i64 = sg(c, S_SIZE)
        let side: i64 = imin(64, imax(n4w(size), n4h(size)) * 4)
        let max_tx: i64 = find_tx_size(side, side)
        var ctx: i64 = (4 - max_tx) * 6
        if av1tab2.t_sqrup(txsz) != max_tx {
            ctx = ctx + 3
        }
        if above_tx_width(c, row, col) < av1tab2.t_txw(txsz) {
            ctx = ctx + 1
        }
        if left_tx_height(c, row, col) < av1tab2.t_txh(txsz) {
            ctx = ctx + 1
        }
        split = rs(c, mcell(c, avif_cdf.M_TXFM_PARTITION as i64 + ctx * 3), 2)
    }
    let w4: i64 = av1tab2.t_txw(txsz) >> 2
    let h4: i64 = av1tab2.t_txh(txsz) >> 2
    if split != 0 {
        let sub: i64 = av1tab2.t_split(txsz)
        let step_w: i64 = av1tab2.t_txw(sub) >> 2
        let step_h: i64 = av1tab2.t_txh(sub) >> 2
        var i: i64 = 0
        while i < h4 {
            var j: i64 = 0
            while j < w4 {
                read_var_tx_size(c, row + i, col + j, sub, depth + 1)
                j = j + step_w
            }
            i = i + step_h
        }
    } else {
        let txs: u64 = sg(c, S_TXS) as u64
        var i: i64 = 0
        while i < h4 {
            var j: i64 = 0
            while j < w4 {
                if row + i < mr && col + j < mc {
                    stb(txs, (row + i) * mc + col + j, txsz)
                }
                j = j + 1
            }
            i = i + 1
        }
        ss(c, S_TXSZ, txsz)
    }
}

fn read_block_var_tx(c: u64, r: i64, cc: i64, size: i64) {
    let mx: i64 = av1tab2.t_maxrect(size)
    let step_w: i64 = av1tab2.t_txw(mx) >> 2
    let step_h: i64 = av1tab2.t_txh(mx) >> 2
    var row: i64 = r
    while row < r + n4h(size) {
        var col: i64 = cc
        while col < cc + n4w(size) {
            read_var_tx_size(c, row, col, mx, 0)
            col = col + step_w
        }
        row = row + step_h
    }
}

fn predict_ibc_block(c: u64, r: i64, cc: i64, size: i64, hasc: i64) {
    let ps: u64 = sg(c, S_IBC) as u64
    let mvr: i64 = av1ibc.ibc_mv_row(ps)
    let mvc: i64 = av1ibc.ibc_mv_col(ps)
    var plane: i64 = 0
    while plane < 1 + 2 * hasc {
        let qx: i64 = psub_x(c, plane)
        let qy: i64 = psub_y(c, plane)
        av1ibc.ibc_predict(ps, plane_ptr(c, plane), tile_stride(c), (cc >> qx) * 4, (r >> qy) * 4, imax(4, (n4w(size) * 4) >> qx),
                           imax(4, (n4h(size) * 4) >> qy), mvr, mvc, qx, qy, sg(c, S_BD))
        plane = plane + 1
    }
}

fn uv_txsize(psize: i64) -> i64 {
    let u: i64 = av1tab2.t_maxrect(psize)
    if av1tab2.t_txw(u) == 64 || av1tab2.t_txh(u) == 64 {
        if av1tab2.t_txw(u) == 16 {
            return 9
        }
        if av1tab2.t_txh(u) == 16 {
            return 10
        }
        return 3
    }
    return u
}

fn read_cfl(c: u64) {
    let signs: i64 = rs(c, mcell(c, avif_cdf.M_CFL_SIGN as i64), 8)
    let su: i64 = (signs + 1) / 3
    let sv: i64 = (signs + 1) % 3
    ss(c, S_CAU, 0)
    ss(c, S_CAV, 0)
    if su != 0 {
        let a: i64 = rs(c, mcell(c, avif_cdf.M_CFL_ALPHA as i64 + ((su - 1) * 3 + sv) * 17), 16) + 1
        if su == 1 {
            ss(c, S_CAU, 0 - a)
        } else {
            ss(c, S_CAU, a)
        }
    }
    if sv != 0 {
        let a: i64 = rs(c, mcell(c, avif_cdf.M_CFL_ALPHA as i64 + ((sv - 1) * 3 + su) * 17), 16) + 1
        if sv == 1 {
            ss(c, S_CAV, 0 - a)
        } else {
            ss(c, S_CAV, a)
        }
    }
}

fn read_cdef_idx(c: u64, r: i64, cc: i64, bw4: i64, bh4: i64) {
    let ci: i64 = av1sym.sym_literal(symp(c), sg(c, S_CDEFBITS))
    let idx: u64 = sg(c, S_CDEFIDX) as u64
    let sbcols: i64 = sg(c, S_SBCOLS)
    let rows64: i64 = (sg(c, S_MR) + 15) >> 4
    var y: i64 = r >> 4
    while y < imin(rows64, (r + bh4 + 15) >> 4) {
        var x: i64 = cc >> 4
        while x < imin(sbcols, (cc + bw4 + 15) >> 4) {
            stb(idx, y * sbcols + x, ci + 1)
            x = x + 1
        }
        y = y + 1
    }
}

fn read_delta_qindex(c: u64, size: i64, skip: i64) {
    if sg(c, S_RDELTAS) == 0 || (n4w(size) == sg(c, S_SBMI) && n4h(size) == sg(c, S_SBMI) && skip != 0) {
        ss(c, S_RDELTAS, 0)
        return
    }
    var mag: i64 = rs(c, mcell(c, avif_cdf.M_DELTA_Q as i64), 4)
    if mag == 3 {
        let rem: i64 = av1sym.sym_literal(symp(c), 3) + 1
        let low: i64 = av1sym.sym_literal(symp(c), rem)
        mag = low + (1 << rem) + 1
    }
    if mag != 0 {
        var step: i64 = mag
        if av1sym.sym_literal(symp(c), 1) != 0 {
            step = 0 - mag
        }
        let cur: i64 = imax(1, imin(255, sg(c, S_CURQ) + step * (1 << sg(c, S_DQRES))))
        ss(c, S_CURQ, cur)
        set_quant(c, cur)
    }
    ss(c, S_RDELTAS, 0)
}

fn decode_block(c: u64, r: i64, cc: i64, size: i64) {
    if sg(c, S_ERR) != 0 {
        return
    }
    let mc: i64 = sg(c, S_MC)
    let mr: i64 = sg(c, S_MR)
    ss(c, S_ROW, r)
    ss(c, S_COL, cc)
    ss(c, S_SIZE, size)
    var avu: i64 = 0
    var avl: i64 = 0
    if r > sg(c, S_R0) {
        avu = 1
    }
    if cc > sg(c, S_C0) {
        avl = 1
    }
    ss(c, S_AVU, avu)
    ss(c, S_AVL, avl)
    let bw4: i64 = n4w(size)
    let bh4: i64 = n4h(size)
    let subx: i64 = sg(c, S_SUBX)
    let suby: i64 = sg(c, S_SUBY)
    var hasc: i64 = 0
    if sg(c, S_NPL) > 1 {
        hasc = 1
        if suby != 0 && bh4 == 1 && (r & 1) == 0 {
            hasc = 0
        }
        if subx != 0 && bw4 == 1 && (cc & 1) == 0 {
            hasc = 0
        }
    }
    var avuc: i64 = 0
    var avlc: i64 = 0
    if hasc != 0 {
        avuc = avu
        avlc = avl
        if suby != 0 && bh4 == 1 && r - 2 < sg(c, S_R0) {
            avuc = 0
        }
        if subx != 0 && bw4 == 1 && cc - 2 < sg(c, S_C0) {
            avlc = 0
        }
    }
    ss(c, S_HASC, hasc)
    ss(c, S_AVUC, avuc)
    ss(c, S_AVLC, avlc)
    let ym: u64 = sg(c, S_YM) as u64
    let skp: u64 = sg(c, S_SKP) as u64
    var sctx: i64 = 0
    if avu != 0 {
        sctx = sctx + ldb(skp, (r - 1) * mc + cc)
    }
    if avl != 0 {
        sctx = sctx + ldb(skp, r * mc + cc - 1)
    }
    let skip: i64 = rs(c, mcell(c, avif_cdf.M_SKIP_TXFM as i64 + sctx * 3), 2)
    ss(c, S_SKIP, skip)
    if skip == 0 && sg(c, S_ENCDEF) != 0 && sg(c, S_ALLOWIBC) == 0 && sg(c, S_LOSSLESS) == 0 && ldb(sg(c, S_CDEFIDX) as u64, (r >> 4) * sg(c, S_SBCOLS) + (cc >> 4)) == 0 {
        read_cdef_idx(c, r, cc, bw4, bh4)
    }
    read_delta_qindex(c, size, skip)
    var ibc: i64 = 0
    if sg(c, S_ALLOWIBC) != 0 {
        ibc = rs(c, mcell(c, avif_cdf.M_INTRABC as i64), 2)
    }
    ss(c, S_ISINTER, ibc)
    var am: i64 = 0
    var lm: i64 = 0
    if avu != 0 {
        am = IMC[ldb(ym, (r - 1) * mc + cc) as usize] as i64
    }
    if avl != 0 {
        lm = IMC[ldb(ym, r * mc + cc - 1) as usize] as i64
    }
    var ymode: i64 = 0
    var angy: i64 = 0
    var uvmode: i64 = 0
    var anguv: i64 = 0
    let ps: u64 = sg(c, S_PAL) as u64
    ss(c, S_UFI, 0)
    if ibc != 0 {
        ss(c, S_YMODE, 0)
        ss(c, S_ANGY, 0)
        ss(c, S_UVMODE, 0)
        ss(c, S_ANGUV, 0)
        av1pal.pal_clear(ps)
        if av1ibc.ibc_decode_mv(sg(c, S_IBC) as u64, symp(c), r, cc, size, hasc, subx, suby) == 0 {
            ss(c, S_ERR, 5)
            return
        }
    } else {
        ymode = rs(c, mcell(c, avif_cdf.M_KF_Y_MODE as i64 + (am * 5 + lm) * 14), 13)
        ss(c, S_YMODE, ymode)
        if size >= 3 && is_dir(ymode) != 0 {
            angy = rs(c, mcell(c, avif_cdf.M_ANGLE_DELTA as i64 + (ymode - 1) * 8), 7) - 3
        }
        ss(c, S_ANGY, angy)
        if hasc != 0 {
            var cfl_ok: i64 = 0
            if sg(c, S_LOSSLESS) != 0 {
                if plane_size(size, subx, suby) == 0 {
                    cfl_ok = 1
                }
            } else if imax(bw4, bh4) <= 8 {
                cfl_ok = 1
            }
            if cfl_ok != 0 {
                uvmode = rs(c, mcell(c, avif_cdf.M_UV_MODE as i64 + (13 + ymode) * 15), 14)
            } else {
                uvmode = rs(c, mcell(c, avif_cdf.M_UV_MODE as i64 + ymode * 15), 13)
            }
            ss(c, S_UVMODE, uvmode)
            if uvmode == 13 {
                read_cfl(c)
            }
            if size >= 3 && is_dir(uvmode) != 0 {
                anguv = rs(c, mcell(c, avif_cdf.M_ANGLE_DELTA as i64 + (uvmode - 1) * 8), 7) - 3
            }
        } else {
            ss(c, S_UVMODE, 0)
        }
        ss(c, S_ANGUV, anguv)
        if size >= 3 && sg(c, S_SCT) != 0 {
            let bctx: i64 = (MIWL[size as usize] as i64) + (MIHL[size as usize] as i64) - 2
            av1pal.pal_mode_info(ps, symp(c), sg(c, S_MCDF) as u64, r, cc, mc, avu, avl, bctx, hasc, ymode, uvmode, sg(c, S_BD))
        } else {
            av1pal.pal_clear(ps)
        }
        if sg(c, S_EFI) != 0 && ymode == 0 && av1pal.pal_size_y(ps) == 0 && imax(bw4, bh4) <= 8 {
            let u: i64 = rs(c, mcell(c, avif_cdf.M_FILTER_INTRA as i64 + size * 3), 2)
            ss(c, S_UFI, u)
            if u != 0 {
                ss(c, S_FIM, rs(c, mcell(c, avif_cdf.M_FILTER_INTRA_MODE as i64), 5))
            }
        }
    }
    av1pal.pal_tokens(ps, symp(c), sg(c, S_MCDF) as u64, bw4 * 4, bh4 * 4, r, cc, mr, mc, subx, suby)
    var txsz: i64 = 0
    var vartx: i64 = 0
    if sg(c, S_LOSSLESS) == 0 {
        let mx: i64 = av1tab2.t_maxrect(size)
        txsz = mx
        if ibc != 0 && skip == 0 && size > 0 && sg(c, S_TXMODE) == 2 {
            vartx = 1
            read_block_var_tx(c, r, cc, size)
            txsz = sg(c, S_TXSZ)
        } else if size > 0 && sg(c, S_TXMODE) == 2 && (ibc == 0 || skip == 0) {
            let txs: u64 = sg(c, S_TXS) as u64
            var aw: i64 = 0
            var lh: i64 = 0
            if avu != 0 {
                aw = av1tab2.t_txw(ldb(txs, (r - 1) * mc + cc))
                if is_ibc_at(c, r - 1, cc) {
                    aw = n4w(ldb(sg(c, S_MIS) as u64, (r - 1) * mc + cc)) * 4
                }
            }
            if avl != 0 {
                lh = av1tab2.t_txh(ldb(txs, r * mc + cc - 1))
                if is_ibc_at(c, r, cc - 1) {
                    lh = n4h(ldb(sg(c, S_MIS) as u64, r * mc + cc - 1)) * 4
                }
            }
            var tctx: i64 = 0
            if aw >= av1tab2.t_txw(mx) {
                tctx = tctx + 1
            }
            if lh >= av1tab2.t_txh(mx) {
                tctx = tctx + 1
            }
            let md: i64 = av1tab2.t_maxdepth(size)
            var cat: i64 = 0
            if md >= 4 {
                cat = 3
            } else if md == 3 {
                cat = 2
            } else if md == 2 {
                cat = 1
            }
            var nsym: i64 = 3
            if cat == 0 {
                nsym = 2
            }
            let depth: i64 = rs(c, mcell(c, avif_cdf.M_TX_SIZE as i64 + (cat * 3 + tctx) * 4), nsym)
            var d: i64 = 0
            while d < depth {
                txsz = av1tab2.t_split(txsz)
                d = d + 1
            }
        }
    }
    ss(c, S_TXSZ, txsz)
    let uvm: u64 = sg(c, S_UVM) as u64
    let mis: u64 = sg(c, S_MIS) as u64
    var y: i64 = 0
    while y < bh4 {
        var x: i64 = 0
        while x < bw4 {
            if r + y < mr && cc + x < mc {
                let at: i64 = (r + y) * mc + cc + x
                stb(ym, at, ymode)
                if hasc != 0 {
                    stb(uvm, at, uvmode)
                }
                stb(mis, at, size)
                stb(skp, at, skip)
                if vartx == 0 {
                    stb(sg(c, S_TXS) as u64, at, txsz)
                }
            }
            x = x + 1
        }
        y = y + 1
    }
    av1pal.pal_store(ps, r, cc, bw4, bh4, mr, mc)
    if sg(c, S_IBC) != 0 {
        var kind: i64 = 1
        var mvr: i64 = 0
        var mvc: i64 = 0
        if ibc != 0 {
            kind = 2
            mvr = av1ibc.ibc_mv_row(sg(c, S_IBC) as u64)
            mvc = av1ibc.ibc_mv_col(sg(c, S_IBC) as u64)
        }
        av1ibc.ibc_store(sg(c, S_IBC) as u64, r, cc, bw4, bh4, kind, mvr, mvc)
    }
    let cn: i64 = sg(c, S_CN)
    if skip != 0 {
        var pl: i64 = 0
        while pl < 1 + 2 * hasc {
            let qx: i64 = psub_x(c, pl)
            let qy: i64 = psub_y(c, pl)
            var i: i64 = cc >> qx
            while i <= ((cc + bw4 - 1) >> qx) {
                stb(sg(c, S_ALC) as u64, pl * cn + i, 0)
                stb(sg(c, S_ADC) as u64, pl * cn + i, 0)
                i = i + 1
            }
            i = r >> qy
            while i <= ((r + bh4 - 1) >> qy) {
                stb(sg(c, S_LLC) as u64, pl * cn + i, 0)
                stb(sg(c, S_LDC) as u64, pl * cn + i, 0)
                i = i + 1
            }
            pl = pl + 1
        }
    }
    if ibc != 0 {
        predict_ibc_block(c, r, cc, size, hasc)
    }
    let chunks_w: i64 = imax(1, bw4 >> 4)
    let chunks_h: i64 = imax(1, bh4 >> 4)
    let cw4: i64 = imin(bw4, 16)
    let ch4: i64 = imin(bh4, 16)
    var chunk_y: i64 = 0
    while chunk_y < chunks_h {
        var chunk_x: i64 = 0
        while chunk_x < chunks_w {
            var plane: i64 = 0
            while plane < 1 + 2 * hasc {
                let qx: i64 = psub_x(c, plane)
                let qy: i64 = psub_y(c, plane)
                if ibc != 0 && plane == 0 && sg(c, S_LOSSLESS) == 0 {
                    transform_tree(c, (cc + chunk_x * 16) * 4, (r + chunk_y * 16) * 4, cw4 * 4, ch4 * 4)
                    plane = plane + 1
                    continue
                }
                var tsz: i64 = 0
                if sg(c, S_LOSSLESS) == 0 {
                    tsz = txsz
                    if plane > 0 {
                        tsz = uv_txsize(plane_size(size, qx, qy))
                    }
                }
                let stepx: i64 = av1tab2.t_txw(tsz) >> 2
                let stepy: i64 = av1tab2.t_txh(tsz) >> 2
                let pw4: i64 = imax(1, cw4 >> qx)
                let ph4: i64 = imax(1, ch4 >> qy)
                let offx: i64 = (chunk_x * 16) >> qx
                let offy: i64 = (chunk_y * 16) >> qy
                let basex: i64 = (cc >> qx) * 4
                let basey: i64 = (r >> qy) * 4
                var ty: i64 = 0
                while ty < ph4 {
                    var tx: i64 = 0
                    while tx < pw4 {
                        transform_block(c, plane, basex + (offx + tx) * 4, basey + (offy + ty) * 4, offx + tx, offy + ty, tsz)
                        tx = tx + stepx
                    }
                    ty = ty + stepy
                }
                plane = plane + 1
            }
            chunk_x = chunk_x + 1
        }
        chunk_y = chunk_y + 1
    }
}

fn read_partition(c: u64, r: i64, cc: i64, bsize: i64, kind: i64) -> i64 {
    let mc: i64 = sg(c, S_MC)
    let bsl: i64 = MIWL[bsize as usize] as i64
    var above: i64 = 0
    var left: i64 = 0
    if r > sg(c, S_R0) {
        let s: i64 = ldb(sg(c, S_MIS) as u64, (r - 1) * mc + cc)
        if (MIWL[s as usize] as i64) < bsl {
            above = 1
        }
    }
    if cc > sg(c, S_C0) {
        let s: i64 = ldb(sg(c, S_MIS) as u64, r * mc + cc - 1)
        if (MIHL[s as usize] as i64) < bsl {
            left = 1
        }
    }
    let ctx: i64 = left * 2 + above
    var nsym: i64 = 10
    if bsl == 1 {
        nsym = 4
    } else if bsl == 5 {
        nsym = 8
    }
    let cdf: u64 = mcell(c, avif_cdf.M_PARTITION as i64 + ((bsl - 1) * 4 + ctx) * 11)
    if kind == 0 {
        return rs(c, cdf, nsym)
    }
    var psum: i64 = 0
    if kind == 1 {
        psum = pdiff(cdf, 2) + pdiff(cdf, 3) + pdiff(cdf, 4) + pdiff(cdf, 6) + pdiff(cdf, 7)
        if bsize != 15 {
            psum = psum + pdiff(cdf, 9)
        }
    } else {
        psum = pdiff(cdf, 1) + pdiff(cdf, 3) + pdiff(cdf, 4) + pdiff(cdf, 5) + pdiff(cdf, 6)
        if bsize != 15 {
            psum = psum + pdiff(cdf, 8)
        }
    }
    let t: u64 = sg(c, S_TCDF) as u64
    av1sym.cdf_st(t, 0, 32768 - psum)
    av1sym.cdf_st(t, 1, 32768)
    av1sym.cdf_st(t, 2, 0)
    return rs(c, t, 2)
}

fn pdiff(cdf: u64, x: i64) -> i64 {
    return av1sym.cdf_ld(cdf, x) - av1sym.cdf_ld(cdf, x - 1)
}

fn decode_partition(c: u64, r: i64, cc: i64, bsize: i64) {
    let mr: i64 = sg(c, S_MR)
    let mc: i64 = sg(c, S_MC)
    if r >= mr || cc >= mc {
        return
    }
    let num4: i64 = n4w(bsize)
    let half: i64 = num4 >> 1
    let quarter: i64 = half >> 1
    var has_rows: i64 = 0
    if r + half < mr {
        has_rows = 1
    }
    var has_cols: i64 = 0
    if cc + half < mc {
        has_cols = 1
    }
    var part: i64 = 0
    if bsize < 3 {
        part = 0
    } else if has_rows != 0 && has_cols != 0 {
        part = read_partition(c, r, cc, bsize, 0)
    } else if has_cols != 0 {
        part = 1
        if read_partition(c, r, cc, bsize, 1) != 0 {
            part = 3
        }
    } else if has_rows != 0 {
        part = 2
        if read_partition(c, r, cc, bsize, 2) != 0 {
            part = 3
        }
    } else {
        part = 3
    }
    let sub: i64 = av1tab.t_part_subsize(part * 22 + bsize)
    let spl: i64 = av1tab.t_part_subsize(3 * 22 + bsize)
    if part == 0 {
        decode_block(c, r, cc, sub)
    } else if part == 1 {
        decode_block(c, r, cc, sub)
        if has_rows != 0 {
            decode_block(c, r + half, cc, sub)
        }
    } else if part == 2 {
        decode_block(c, r, cc, sub)
        if has_cols != 0 {
            decode_block(c, r, cc + half, sub)
        }
    } else if part == 3 {
        decode_partition(c, r, cc, sub)
        decode_partition(c, r, cc + half, sub)
        decode_partition(c, r + half, cc, sub)
        decode_partition(c, r + half, cc + half, sub)
    } else if part == 4 {
        decode_block(c, r, cc, spl)
        decode_block(c, r, cc + half, spl)
        decode_block(c, r + half, cc, sub)
    } else if part == 5 {
        decode_block(c, r, cc, sub)
        decode_block(c, r + half, cc, spl)
        decode_block(c, r + half, cc + half, spl)
    } else if part == 6 {
        decode_block(c, r, cc, spl)
        decode_block(c, r + half, cc, spl)
        decode_block(c, r, cc + half, sub)
    } else if part == 7 {
        decode_block(c, r, cc, sub)
        decode_block(c, r, cc + half, spl)
        decode_block(c, r + half, cc + half, spl)
    } else if part == 8 {
        decode_block(c, r, cc, sub)
        decode_block(c, r + quarter, cc, sub)
        decode_block(c, r + quarter * 2, cc, sub)
        if r + quarter * 3 < mr {
            decode_block(c, r + quarter * 3, cc, sub)
        }
    } else {
        decode_block(c, r, cc, sub)
        decode_block(c, r, cc + quarter, sub)
        decode_block(c, r, cc + quarter * 2, sub)
        if cc + quarter * 3 < mc {
            decode_block(c, r, cc + quarter * 3, sub)
        }
    }
}

fn clear_block_decoded(c: u64, r: i64, cc: i64) {
    let bd: u64 = sg(c, S_BDEC) as u64
    let sbmi: i64 = sg(c, S_SBMI)
    var p: i64 = 0
    while p < 3 {
        let qx: i64 = psub_x(c, p)
        let qy: i64 = psub_y(c, p)
        let sbw: i64 = (sg(c, S_C1) - cc) >> qx
        let sbh: i64 = (sg(c, S_R1) - r) >> qy
        var y: i64 = 0 - 1
        while y <= (sbmi >> qy) {
            var x: i64 = 0 - 1
            while x <= (sbmi >> qx) {
                var v: i64 = 0
                if y < 0 && x < sbw {
                    v = 1
                } else if x < 0 && y < sbh {
                    v = 1
                }
                stb(bd, (p * 34 + y + 1) * 34 + x + 1, v)
                x = x + 1
            }
            y = y + 1
        }
        stb(bd, (p * 34 + (sbmi >> qy) + 1) * 34, 0)
        p = p + 1
    }
}

fn reset_cdfs(c: u64) {
    av1sym.cdf_copy(sg(c, S_MCDF) as u64, avif_cdf.cdf_mode_addr(), avif_cdf.CDF_MODE_LEN as i64)
    av1sym.cdf_copy(sg(c, S_CCDF) as u64, avif_cdf.cdf_coef_addr() + ((sg(c, S_QCTX) * avif_cdf.CDF_COEF_QSTRIDE as i64 * 2) as u64),
                    avif_cdf.CDF_COEF_QSTRIDE as i64)
}

fn clear_above_context(c: u64) {
    let cn3: i64 = sg(c, S_CN) * 3
    var i: i64 = 0
    while i < cn3 {
        stb(sg(c, S_ALC) as u64, i, 0)
        stb(sg(c, S_ADC) as u64, i, 0)
        i = i + 1
    }
}

fn clear_left_context(c: u64) {
    let cn3: i64 = sg(c, S_CN) * 3
    var i: i64 = 0
    while i < cn3 {
        stb(sg(c, S_LLC) as u64, i, 0)
        stb(sg(c, S_LDC) as u64, i, 0)
        i = i + 1
    }
}

fn run_tile(c: u64, r0: i64, r1: i64, c0: i64, c1: i64, data: u64, len: i64) {
    ss(c, S_R0, r0)
    ss(c, S_R1, r1)
    ss(c, S_C0, c0)
    ss(c, S_C1, c1)
    av1sym.sym_init(symp(c), data, len, sg(c, S_UPD))
    reset_cdfs(c)
    if sg(c, S_IBC) != 0 {
        av1ibc.ibc_set_tile(sg(c, S_IBC) as u64, r0, r1, c0, c1)
        av1ibc.ibc_set_sb(sg(c, S_IBC) as u64, (sg(c, S_SBMI) >> 5) & 1)
        av1ibc.ibc_reset_cdfs(sg(c, S_IBC) as u64)
    }
    clear_above_context(c)
    if sg(c, S_DQPRES) != 0 {
        ss(c, S_CURQ, sg(c, S_QIDX))
        set_quant(c, sg(c, S_QIDX))
    }
    if sg(c, S_LR) != 0 {
        av1lr.lr_tile_reset(sg(c, S_LR) as u64)
    }
    let sbmi: i64 = sg(c, S_SBMI)
    var sbsize: i64 = 12
    if sbmi == 32 {
        sbsize = 15
    }
    var r: i64 = r0
    while r < r1 {
        clear_left_context(c)
        var cc: i64 = c0
        while cc < c1 {
            clear_block_decoded(c, r, cc)
            ss(c, S_RDELTAS, sg(c, S_DQPRES))
            if sg(c, S_LR) != 0 {
                av1lr.lr_read_sb(sg(c, S_LR) as u64, symp(c), r, cc, sbmi)
            }
            decode_partition(c, r, cc, sbsize)
            cc = cc + sbmi
        }
        r = r + sbmi
    }
}

fn read_le(p: u64, n: i64) -> i64 {
    var v: i64 = 0
    var i: i64 = n - 1
    while i >= 0 {
        v = (v << 8) | ldb(p, i)
        i = i - 1
    }
    return v
}

fn tile_run(c: u64) {
    let g: u64 = sg(c, S_TINFO) as u64
    var data: u64 = sg(c, S_DATA) as u64
    var left: i64 = sg(c, S_DLEN)
    if g == 0 {
        run_tile(c, 0, sg(c, S_MR), 0, sg(c, S_MC), data, left)
        return
    }
    if left < 1 || (ldb(data, 0) & 128) != 0 {
        ss(c, S_ERR, 2)
        return
    }
    data = data + 1
    left = left - 1
    let tcols: i64 = sg(g, G_COLS)
    let trows: i64 = sg(g, G_ROWS)
    let tsb: i64 = sg(g, G_SIZE_BYTES)
    let n: i64 = tcols * trows
    var idx: i64 = 0
    while idx < n {
        var size: i64 = left
        if idx < n - 1 {
            if left < tsb {
                ss(c, S_ERR, 3)
                return
            }
            size = read_le(data, tsb) + 1
            data = data + (tsb as u64)
            left = left - tsb
            if size > left {
                ss(c, S_ERR, 3)
                return
            }
        }
        let tr: i64 = idx / tcols
        let tc: i64 = idx % tcols
        run_tile(c, sg(g, G_ROW_START + tr), sg(g, G_ROW_START + tr + 1), sg(g, G_COL_START + tc), sg(g, G_COL_START + tc + 1), data, size)
        if sg(c, S_ERR) != 0 {
            return
        }
        data = data + (size as u64)
        left = left - size
        idx = idx + 1
    }
}
