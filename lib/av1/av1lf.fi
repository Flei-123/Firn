// SPDX-License-Identifier: MPL-2.0
// lib/av1/av1lf.fi -- AV1 deblocking loop filter.
import av1.av1tab2

export { lf_frame }

#[no_gc]
fn ldb(p: u64, i: i64) -> i64 {
    return (*((p + (i as u64)) as *mut u8)) as i64
}

#[no_gc]
fn ldp(p: u64, i: i64) -> i64 {
    return (*((p + ((i * 2) as u64)) as *mut u16)) as i64
}

#[no_gc]
fn stp(p: u64, i: i64, v: i64) {
    *((p + ((i * 2) as u64)) as *mut u16) = (v & 65535) as u16
}

#[no_gc]
fn ldq(p: u64, i: i64) -> i64 {
    return *((p + ((i * 8) as u64)) as *mut i64)
}

#[no_gc]
fn stq(p: u64, i: i64, v: i64) {
    *((p + ((i * 8) as u64)) as *mut i64) = v
}

#[no_gc]
fn stb(p: u64, i: i64, v: i64) {
    *((p + (i as u64)) as *mut u8) = (v & 255) as u8
}

fn imin(a: i64, b: i64) -> i64 {
    if a < b {
        return a
    }
    return b
}

fn imax(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    }
    return b
}

fn iabs(a: i64) -> i64 {
    if a < 0 {
        return 0 - a
    }
    return a
}

fn clip3(lo: i64, hi: i64, v: i64) -> i64 {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

fn c4(v: i64, half: i64) -> i64 {
    return clip3(0 - half, half - 1, v)
}

fn sar3(v: i64, half: i64) -> i64 {
    return ((v + half) >> 3) - (half >> 3)
}

fn narrow(pl: u64, b: i64, st: i64, hev: i64, bd: i64) {
    let half: i64 = 1 << (bd - 1)
    let ps1: i64 = ldp(pl, b - st * 2) - half
    let ps0: i64 = ldp(pl, b - st) - half
    let qs0: i64 = ldp(pl, b) - half
    let qs1: i64 = ldp(pl, b + st) - half
    var f: i64 = 0
    if hev != 0 {
        f = c4(ps1 - qs1, half)
    }
    f = c4(f + 3 * (qs0 - ps0), half)
    let f1: i64 = sar3(c4(f + 4, half), half)
    let f2: i64 = sar3(c4(f + 3, half), half)
    stp(pl, b, c4(qs0 - f1, half) + half)
    stp(pl, b - st, c4(ps0 + f2, half) + half)
    if hev == 0 {
        let g: i64 = ((f1 + 1 + (half >> 3)) >> 1) - (half >> 4)
        stp(pl, b + st, c4(qs1 - g, half) + half)
        stp(pl, b - st * 2, c4(ps1 + g, half) + half)
    }
}

fn wide(pl: u64, b: i64, st: i64, plane: i64, log2sz: i64, sc: u64) {
    var n: i64 = 3
    if log2sz == 4 {
        n = 6
    } else if plane != 0 {
        n = 2
    }
    var n2: i64 = 1
    if log2sz == 3 && plane == 0 {
        n2 = 0
    }
    var k: i64 = 0 - (n + 1)
    while k <= n {
        stq(sc, k + 7, ldp(pl, b + k * st))
        k = k + 1
    }
    var i: i64 = 0 - n
    while i < n {
        var t: i64 = 0
        var j: i64 = 0 - n
        while j <= n {
            let p: i64 = clip3(0 - (n + 1), n, i + j)
            var tap: i64 = 1
            if iabs(j) <= n2 {
                tap = 2
            }
            t = t + ldq(sc, p + 7) * tap
            j = j + 1
        }
        stq(sc, i + n + 16, (t + (1 << (log2sz - 1))) >> log2sz)
        i = i + 1
    }
    i = 0 - n
    while i < n {
        stp(pl, b + i * st, ldq(sc, i + n + 16))
        i = i + 1
    }
}

fn filter_sample(pl: u64, b: i64, st: i64, plane: i64, limit0: i64, blimit0: i64, thresh0: i64, fsize: i64, sc: u64, bd: i64) {
    let limit: i64 = limit0 << (bd - 8)
    let blimit: i64 = blimit0 << (bd - 8)
    let thresh: i64 = thresh0 << (bd - 8)
    let one: i64 = 1 << (bd - 8)
    let q0: i64 = ldp(pl, b)
    let q1: i64 = ldp(pl, b + st)
    let p0: i64 = ldp(pl, b - st)
    let p1: i64 = ldp(pl, b - st * 2)
    var hev: i64 = 0
    if iabs(p1 - p0) > thresh || iabs(q1 - q0) > thresh {
        hev = 1
    }
    var flen: i64 = 16
    if fsize == 4 {
        flen = 4
    } else if plane != 0 {
        flen = 6
    } else if fsize == 8 {
        flen = 8
    }
    var bad: i64 = 0
    if iabs(p1 - p0) > limit || iabs(q1 - q0) > limit || iabs(p0 - q0) * 2 + iabs(p1 - q1) / 2 > blimit {
        bad = 1
    }
    var q2: i64 = 0
    var p2: i64 = 0
    var q3: i64 = 0
    var p3: i64 = 0
    if flen >= 6 {
        q2 = ldp(pl, b + st * 2)
        p2 = ldp(pl, b - st * 3)
        if iabs(p2 - p1) > limit || iabs(q2 - q1) > limit {
            bad = 1
        }
    }
    if flen >= 8 {
        q3 = ldp(pl, b + st * 3)
        p3 = ldp(pl, b - st * 4)
        if iabs(p3 - p2) > limit || iabs(q3 - q2) > limit {
            bad = 1
        }
    }
    if bad != 0 {
        return
    }
    var flat: i64 = 0
    if fsize >= 8 {
        flat = 1
        if iabs(p1 - p0) > one || iabs(q1 - q0) > one || iabs(p2 - p0) > one || iabs(q2 - q0) > one {
            flat = 0
        }
        if flen >= 8 {
            if iabs(p3 - p0) > one || iabs(q3 - q0) > one {
                flat = 0
            }
        }
    }
    if fsize == 4 || flat == 0 {
        narrow(pl, b, st, hev, bd)
        return
    }
    var flat2: i64 = 0
    if fsize >= 16 {
        flat2 = 1
        if iabs(ldp(pl, b - st * 7) - p0) > one || iabs(ldp(pl, b + st * 6) - q0) > one || iabs(ldp(pl, b - st * 6) - p0) > one || iabs(ldp(pl, b + st * 5) - q0) > one || iabs(ldp(pl, b - st * 5) - p0) > one || iabs(ldp(pl, b + st * 4) - q0) > one {
            flat2 = 0
        }
    }
    if fsize == 8 || flat2 == 0 {
        wide(pl, b, st, plane, 3, sc)
        return
    }
    wide(pl, b, st, plane, 4, sc)
}

fn level_of(lv: u64, plane: i64, pass: i64, delta_en: i64, intra_delta: i64) -> i64 {
    var i: i64 = plane + 1
    if plane == 0 {
        i = pass
    }
    var l: i64 = clip3(0, 63, ldb(lv, i))
    if delta_en != 0 {
        let sh: i64 = l >> 5
        l = clip3(0, 63, l + intra_delta * (1 << sh))
    }
    return l
}

fn lf_frame(p0: u64, p1: u64, p2: u64, stride: i64, t0: u64, t1: u64, t2: u64, mi_cols: i64, mi_rows: i64, fw: i64, fh: i64,
            subx: i64, suby: i64, nplanes: i64, lv: u64, sharp: i64, delta_en: i64, intra_delta: i64, scratch: u64, bd: i64) {
    if ldb(lv, 0) == 0 && ldb(lv, 1) == 0 {
        return
    }
    var plane: i64 = 0
    while plane < nplanes {
        if plane == 0 || ldb(lv, 1 + plane) != 0 {
            var pl: u64 = p0
            var tm: u64 = t0
            var sx: i64 = 0
            var sy: i64 = 0
            if plane == 1 {
                pl = p1
                tm = t1
            } else if plane == 2 {
                pl = p2
                tm = t2
            }
            if plane > 0 {
                sx = subx
                sy = suby
            }
            var pass: i64 = 0
            while pass < 2 {
                let lvl: i64 = level_of(lv, plane, pass, delta_en, intra_delta)
                var shift: i64 = 0
                if sharp > 4 {
                    shift = 2
                } else if sharp > 0 {
                    shift = 1
                }
                var limit: i64 = imax(1, lvl >> shift)
                if sharp > 0 {
                    limit = clip3(1, 9 - sharp, lvl >> shift)
                }
                let blimit: i64 = 2 * (lvl + 2) + limit
                let thresh: i64 = lvl >> 4
                let dx: i64 = 1 - pass
                let dy: i64 = pass
                var st: i64 = stride
                if pass == 0 {
                    st = 1
                }
                if lvl > 0 {
                    let rstep: i64 = 1 << sy
                    let cstep: i64 = 1 << sx
                    var row: i64 = 0
                    while row < mi_rows {
                        var col: i64 = 0
                        while col < mi_cols {
                            let x: i64 = col * 4
                            let y: i64 = row * 4
                            var on: i64 = 1
                            if x >= fw || y >= fh {
                                on = 0
                            } else if pass == 0 && x == 0 {
                                on = 0
                            } else if pass == 1 && y == 0 {
                                on = 0
                            }
                            if on != 0 {
                                let r2: i64 = row | sy
                                let c2: i64 = col | sx
                                let xp: i64 = x >> sx
                                let yp: i64 = y >> sy
                                let prow: i64 = r2 - (dy << sy)
                                let pcol: i64 = c2 - (dx << sx)
                                let txs: i64 = ldb(tm, (r2 >> sy) * mi_cols + (c2 >> sx))
                                let ptx: i64 = ldb(tm, (prow >> sy) * mi_cols + (pcol >> sx))
                                var tw: i64 = av1tab2.t_txw(txs)
                                var ptw: i64 = av1tab2.t_txw(ptx)
                                var edge: i64 = xp
                                if pass == 1 {
                                    tw = av1tab2.t_txh(txs)
                                    ptw = av1tab2.t_txh(ptx)
                                    edge = yp
                                }
                                if (edge & (tw - 1)) == 0 {
                                    var fsize: i64 = imin(tw, ptw)
                                    if plane == 0 {
                                        fsize = imin(16, fsize)
                                    } else {
                                        fsize = imin(8, fsize)
                                    }
                                    var i: i64 = 0
                                    while i < 4 {
                                        let b: i64 = (yp + dx * i) * stride + xp + dy * i
                                        filter_sample(pl, b, st, plane, limit, blimit, thresh, fsize, scratch, bd)
                                        i = i + 1
                                    }
                                }
                            }
                            col = col + cstep
                        }
                        row = row + rstep
                    }
                }
                pass = pass + 1
            }
        }
        plane = plane + 1
    }
}
