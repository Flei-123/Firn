// lib/av1/av1refs.fi -- av1.av1refs: order-hint distance, frame_refs_short_signaling (spec 7.8) and skip mode frames (5.9.22).
import av1.av1fhx

export { rel_dist, set_frame_refs, skip_mode_params }

fn rel_dist(bits: i64, a: i64, b: i64) -> i64 {
    if bits == 0 {
        return 0
    }
    let diff: i64 = a - b
    let m: i64 = 1 << (bits - 1)
    return (diff & (m - 1)) - (diff & m)
}

fn find_latest_backward(c: u64, fb: usize, used: usize, cur: i64) -> i64 {
    var r: i64 = -1
    var latest: i64 = 0
    var i: usize = 0
    while i < 8 {
        let hint: i64 = av1fhx.cgets(c, fb + av1fhx.FH_REF_HINT + i)
        if av1fhx.cget(c, used + i) == 0 && hint >= cur && (r < 0 || hint >= latest) {
            r = i as i64
            latest = hint
        }
        i = i + 1
    }
    return r
}

fn find_earliest_backward(c: u64, fb: usize, used: usize, cur: i64) -> i64 {
    var r: i64 = -1
    var earliest: i64 = 0
    var i: usize = 0
    while i < 8 {
        let hint: i64 = av1fhx.cgets(c, fb + av1fhx.FH_REF_HINT + i)
        if av1fhx.cget(c, used + i) == 0 && hint >= cur && (r < 0 || hint < earliest) {
            r = i as i64
            earliest = hint
        }
        i = i + 1
    }
    return r
}

fn find_latest_forward(c: u64, fb: usize, used: usize, cur: i64) -> i64 {
    var r: i64 = -1
    var latest: i64 = 0
    var i: usize = 0
    while i < 8 {
        let hint: i64 = av1fhx.cgets(c, fb + av1fhx.FH_REF_HINT + i)
        if av1fhx.cget(c, used + i) == 0 && hint < cur && (r < 0 || hint >= latest) {
            r = i as i64
            latest = hint
        }
        i = i + 1
    }
    return r
}

fn set_idx(c: u64, fb: usize, ref_frame: usize, v: i64) {
    av1fhx.csets(c, fb + av1fhx.FH_REF_IDX + ref_frame, v)
}

fn get_idx(c: u64, fb: usize, ref_frame: usize) -> i64 {
    return av1fhx.cgets(c, fb + av1fhx.FH_REF_IDX + ref_frame)
}

fn set_frame_refs(c: u64, fb: usize, used: usize, bits: i64, order_hint: i64, last_idx: i64, gold_idx: i64) {
    var i: usize = 0
    while i < 7 {
        set_idx(c, fb, i, -1)
        i = i + 1
    }
    set_idx(c, fb, 0, last_idx)
    set_idx(c, fb, 3, gold_idx)
    i = 0
    while i < 8 {
        av1fhx.cset(c, used + i, 0)
        i = i + 1
    }
    av1fhx.cset(c, used + (last_idx as usize), 1)
    av1fhx.cset(c, used + (gold_idx as usize), 1)
    let cur: i64 = 1 << (bits - 1)
    i = 0
    while i < 8 {
        let h: i64 = cur + rel_dist(bits, av1fhx.cgets(c, fb + av1fhx.FH_REF_HINT + i), order_hint)
        av1fhx.csets(c, fb + av1fhx.FH_REF_HINT + i, h)
        i = i + 1
    }
    var r: i64 = find_latest_backward(c, fb, used, cur)
    if r >= 0 {
        set_idx(c, fb, 6, r)
        av1fhx.cset(c, used + (r as usize), 1)
    }
    r = find_earliest_backward(c, fb, used, cur)
    if r >= 0 {
        set_idx(c, fb, 4, r)
        av1fhx.cset(c, used + (r as usize), 1)
    }
    r = find_earliest_backward(c, fb, used, cur)
    if r >= 0 {
        set_idx(c, fb, 5, r)
        av1fhx.cset(c, used + (r as usize), 1)
    }
    var j: usize = 0
    while j < 5 {
        var rf: usize = 1
        if j == 1 {
            rf = 2
        } else if j == 2 {
            rf = 4
        } else if j == 3 {
            rf = 5
        } else if j == 4 {
            rf = 6
        }
        if get_idx(c, fb, rf) < 0 {
            r = find_latest_forward(c, fb, used, cur)
            if r >= 0 {
                set_idx(c, fb, rf, r)
                av1fhx.cset(c, used + (r as usize), 1)
            }
        }
        j = j + 1
    }
    r = -1
    var earliest: i64 = 0
    i = 0
    while i < 8 {
        let h: i64 = av1fhx.cgets(c, fb + av1fhx.FH_REF_HINT + i)
        if r < 0 || h < earliest {
            r = i as i64
            earliest = h
        }
        i = i + 1
    }
    i = 0
    while i < 7 {
        if get_idx(c, fb, i) < 0 {
            set_idx(c, fb, i, r)
        }
        i = i + 1
    }
}

fn skip_mode_params(c: u64, fb: usize, slot_hint_base: usize, bits: i64, order_hint: i64) -> bool {
    var fwd_idx: i64 = -1
    var bwd_idx: i64 = -1
    var fwd_hint: i64 = 0
    var bwd_hint: i64 = 0
    var i: usize = 0
    while i < 7 {
        let slot: usize = get_idx(c, fb, i) as usize
        let h: i64 = av1fhx.cgets(c, slot_hint_base + slot)
        if rel_dist(bits, h, order_hint) < 0 {
            if fwd_idx < 0 || rel_dist(bits, h, fwd_hint) > 0 {
                fwd_idx = i as i64
                fwd_hint = h
            }
        } else if rel_dist(bits, h, order_hint) > 0 {
            if bwd_idx < 0 || rel_dist(bits, h, bwd_hint) < 0 {
                bwd_idx = i as i64
                bwd_hint = h
            }
        }
        i = i + 1
    }
    if fwd_idx < 0 {
        return false
    }
    if bwd_idx >= 0 {
        var lo: i64 = fwd_idx
        var hi: i64 = bwd_idx
        if bwd_idx < fwd_idx {
            lo = bwd_idx
            hi = fwd_idx
        }
        av1fhx.csets(c, fb + av1fhx.FH_SKIP_FRAME, 1 + lo)
        av1fhx.csets(c, fb + av1fhx.FH_SKIP_FRAME + 1, 1 + hi)
        return true
    }
    var sec_idx: i64 = -1
    var sec_hint: i64 = 0
    i = 0
    while i < 7 {
        let slot: usize = get_idx(c, fb, i) as usize
        let h: i64 = av1fhx.cgets(c, slot_hint_base + slot)
        if rel_dist(bits, h, fwd_hint) < 0 {
            if sec_idx < 0 || rel_dist(bits, h, sec_hint) > 0 {
                sec_idx = i as i64
                sec_hint = h
            }
        }
        i = i + 1
    }
    if sec_idx < 0 {
        return false
    }
    var lo2: i64 = fwd_idx
    var hi2: i64 = sec_idx
    if sec_idx < fwd_idx {
        lo2 = sec_idx
        hi2 = fwd_idx
    }
    av1fhx.csets(c, fb + av1fhx.FH_SKIP_FRAME, 1 + lo2)
    av1fhx.csets(c, fb + av1fhx.FH_SKIP_FRAME + 1, 1 + hi2)
    return true
}
