// SPDX-License-Identifier: MPL-2.0
// lib/av1/av1fg.fi -- AV1 film grain synthesis (grain generation, scaling LUTs, noise stripes, blending).
import av1.av1mem
import av1.avif
import av1.av1fgtab

export { fg_apply }

struct Fg {
    reg: i64,
    bd: i64,
    gmin: i64,
    gmax: i64,
    luma: u64,
    cb: u64,
    cr: u64,
    lut: u64,
    cur: u64,
    prev: u64,
    sw: i64,
}

#[no_gc]
fn ld32s(p: u64, i: i64) -> i64 {
    return (*((p + ((i * 4) as u64)) as *mut i32)) as i64
}

#[no_gc]
fn st32s(p: u64, i: i64, v: i64) {
    *((p + ((i * 4) as u64)) as *mut i32) = v as i32
}

#[no_gc]
fn ldw(p: u64, i: i64) -> i64 {
    return (*((p + ((i * 2) as u64)) as *mut u16)) as i64
}

#[no_gc]
fn stw(p: u64, i: i64, v: i64) {
    *((p + ((i * 2) as u64)) as *mut u16) = (v & 65535) as u16
}

fn gp(info: u64, i: usize) -> i64 {
    return avif.avif_cell(info, avif.GR_BASE + i)
}

fn clip3(lo: i64, hi: i64, v: i64) -> i64 {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

fn round2(x: i64, n: i64) -> i64 {
    if n == 0 {
        return x
    }
    return (x + (1 << (n - 1))) >> n
}

fn rnd(f: *mut Fg, bits: i64) -> i64 {
    let r: i64 = (*f).reg
    let bit: i64 = (r ^ (r >> 1) ^ (r >> 3) ^ (r >> 12)) & 1
    let nr: i64 = (r >> 1) | (bit << 15)
    (*f).reg = nr
    return (nr >> (16 - bits)) & ((1 << bits) - 1)
}

fn white_noise(f: *mut Fg, info: u64, dst: u64, n: i64, enabled: bool) {
    let shift: i64 = 12 - (*f).bd + gp(info, avif.GR_GSHIFT)
    var i: i64 = 0
    while i < n {
        var g: i64 = 0
        if enabled {
            g = av1fgtab.gaussian(rnd(f, 11))
        }
        st32s(dst, i, round2(g, shift))
        i = i + 1
    }
}

fn luma_grain(f: *mut Fg, info: u64) {
    let lag: i64 = gp(info, avif.GR_LAG)
    let shift: i64 = gp(info, avif.GR_ARSHIFT) + 6
    let g: u64 = (*f).luma
    var y: i64 = 3
    while y < 73 {
        var x: i64 = 3
        while x < 79 {
            var s: i64 = 0
            var pos: i64 = 0
            var dr: i64 = 0 - lag
            while dr <= 0 {
                var dc: i64 = 0 - lag
                while dc <= lag && !(dr == 0 && dc == 0) {
                    let c: i64 = gp(info, avif.GR_ARY + (pos as usize)) - 128
                    s = s + ld32s(g, (y + dr) * 82 + x + dc) * c
                    pos = pos + 1
                    dc = dc + 1
                }
                dr = dr + 1
            }
            st32s(g, y * 82 + x, clip3((*f).gmin, (*f).gmax, ld32s(g, y * 82 + x) + round2(s, shift)))
            x = x + 1
        }
        y = y + 1
    }
}

fn chroma_grain(f: *mut Fg, info: u64, g: u64, seed_xor: i64, enabled: bool, ar_base: usize, subx: i64, suby: i64, ny: i64) {
    var cw: i64 = 82
    if subx != 0 {
        cw = 44
    }
    var ch: i64 = 73
    if suby != 0 {
        ch = 38
    }
    (*f).reg = gp(info, avif.GR_SEED) ^ seed_xor
    white_noise(f, info, g, cw * ch, enabled)
    if !enabled {
        return
    }
    let lag: i64 = gp(info, avif.GR_LAG)
    let shift: i64 = gp(info, avif.GR_ARSHIFT) + 6
    var y: i64 = 3
    while y < ch {
        var x: i64 = 3
        while x < cw - 3 {
            var s: i64 = 0
            var pos: i64 = 0
            var dr: i64 = 0 - lag
            while dr <= 0 {
                var dc: i64 = 0 - lag
                while dc <= lag {
                    let c: i64 = gp(info, ar_base + (pos as usize)) - 128
                    if dr == 0 && dc == 0 {
                        if ny > 0 {
                            var luma: i64 = 0
                            let lx: i64 = ((x - 3) << subx) + 3
                            let ly: i64 = ((y - 3) << suby) + 3
                            var i: i64 = 0
                            while i <= suby {
                                var j: i64 = 0
                                while j <= subx {
                                    luma = luma + ld32s((*f).luma, (ly + i) * 82 + lx + j)
                                    j = j + 1
                                }
                                i = i + 1
                            }
                            s = s + round2(luma, subx + suby) * c
                        }
                        dc = lag + 1
                    } else {
                        s = s + ld32s(g, (y + dr) * cw + x + dc) * c
                        pos = pos + 1
                        dc = dc + 1
                    }
                }
                dr = dr + 1
            }
            st32s(g, y * cw + x, clip3((*f).gmin, (*f).gmax, ld32s(g, y * cw + x) + round2(s, shift)))
            x = x + 1
        }
        y = y + 1
    }
}

fn build_lut(f: *mut Fg, info: u64, plane: i64) {
    let cfl: bool = gp(info, avif.GR_CFL) != 0
    var n: i64 = gp(info, avif.GR_NY)
    var base: usize = avif.GR_PY
    if plane == 1 && !cfl {
        n = gp(info, avif.GR_NCB)
        base = avif.GR_PCB
    }
    if plane == 2 && !cfl {
        n = gp(info, avif.GR_NCR)
        base = avif.GR_PCR
    }
    let lut: u64 = (*f).lut + ((plane * 256 * 4) as u64)
    var x: i64 = 0
    while x < 256 {
        st32s(lut, x, 0)
        x = x + 1
    }
    if n == 0 {
        return
    }
    x = 0
    while x < gp(info, base) {
        st32s(lut, x, gp(info, base + 1))
        x = x + 1
    }
    var i: i64 = 0
    while i < n - 1 {
        let ux: usize = base + (i as usize) * 2
        let dy: i64 = gp(info, ux + 3) - gp(info, ux + 1)
        let dx: i64 = gp(info, ux + 2) - gp(info, ux)
        let delta: i64 = dy * ((65536 + (dx >> 1)) / dx)
        x = 0
        while x < dx {
            st32s(lut, gp(info, ux) + x, gp(info, ux + 1) + ((x * delta + 32768) >> 16))
            x = x + 1
        }
        i = i + 1
    }
    let last: usize = base + ((n - 1) as usize) * 2
    x = gp(info, last)
    while x < 256 {
        st32s(lut, x, gp(info, last + 1))
        x = x + 1
    }
}

fn scale_lut(f: *mut Fg, plane: i64, index: i64) -> i64 {
    let lut: u64 = (*f).lut + ((plane * 256 * 4) as u64)
    let shift: i64 = (*f).bd - 8
    let x: i64 = index >> shift
    let rem: i64 = index - (x << shift)
    if (*f).bd == 8 || x == 255 {
        return ld32s(lut, x)
    }
    let start: i64 = ld32s(lut, x)
    let end: i64 = ld32s(lut, x + 1)
    return start + round2((end - start) * rem, shift)
}

fn stripe_buf(base: u64, sw: i64, plane: i64) -> u64 {
    return base + ((plane * 34 * sw * 4) as u64)
}

fn grain_of(f: *mut Fg, plane: i64) -> u64 {
    if plane == 0 {
        return (*f).luma
    }
    if plane == 1 {
        return (*f).cb
    }
    return (*f).cr
}

fn make_stripe(f: *mut Fg, info: u64, n: i64, w: i64, subx: i64, suby: i64, np: i64) {
    let overlap: bool = gp(info, avif.GR_OVERLAP) != 0
    let sw: i64 = (*f).sw
    (*f).reg = gp(info, avif.GR_SEED)
    (*f).reg = (*f).reg ^ (((n * 37 + 178) & 255) << 8)
    (*f).reg = (*f).reg ^ ((n * 173 + 105) & 255)
    var x: i64 = 0
    while x < (w + 1) / 2 {
        let rand: i64 = rnd(f, 8)
        let offx: i64 = rand >> 4
        let offy: i64 = rand & 15
        var plane: i64 = 0
        while plane < np {
            var psx: i64 = 0
            var psy: i64 = 0
            if plane > 0 {
                psx = subx
                psy = suby
            }
            var pox: i64 = 9 + offx * 2
            if psx != 0 {
                pox = 6 + offx
            }
            var poy: i64 = 9 + offy * 2
            if psy != 0 {
                poy = 6 + offy
            }
            var gw: i64 = 82
            if plane > 0 && subx != 0 {
                gw = 44
            }
            let gr: u64 = grain_of(f, plane)
            let buf: u64 = stripe_buf((*f).cur, sw, plane)
            var i: i64 = 0
            while i < (34 >> psy) {
                var j: i64 = 0
                while j < (34 >> psx) {
                    var g: i64 = ld32s(gr, (poy + i) * gw + pox + j)
                    if psx == 0 {
                        let at: i64 = i * sw + x * 2 + j
                        if j < 2 && overlap && x > 0 {
                            let old: i64 = ld32s(buf, at)
                            if j == 0 {
                                g = old * 27 + g * 17
                            } else {
                                g = old * 17 + g * 27
                            }
                            g = clip3((*f).gmin, (*f).gmax, round2(g, 5))
                        }
                        st32s(buf, at, g)
                    } else {
                        let at: i64 = i * sw + x + j
                        if j == 0 && overlap && x > 0 {
                            let old: i64 = ld32s(buf, at)
                            g = old * 23 + g * 22
                            g = clip3((*f).gmin, (*f).gmax, round2(g, 5))
                        }
                        st32s(buf, at, g)
                    }
                    j = j + 1
                }
                i = i + 1
            }
            plane = plane + 1
        }
        x = x + 16
    }
}

fn noise_at(f: *mut Fg, overlap: bool, n: i64, plane: i64, psy: i64, i: i64, x: i64) -> i64 {
    let sw: i64 = (*f).sw
    var g: i64 = ld32s(stripe_buf((*f).cur, sw, plane), i * sw + x)
    if n > 0 && overlap {
        if psy == 0 && i < 2 {
            let old: i64 = ld32s(stripe_buf((*f).prev, sw, plane), (i + 32) * sw + x)
            if i == 0 {
                g = old * 27 + g * 17
            } else {
                g = old * 17 + g * 27
            }
            g = clip3((*f).gmin, (*f).gmax, round2(g, 5))
        }
        if psy != 0 && i < 1 {
            let old: i64 = ld32s(stripe_buf((*f).prev, sw, plane), (i + 16) * sw + x)
            g = old * 23 + g * 22
            g = clip3((*f).gmin, (*f).gmax, round2(g, 5))
        }
    }
    return g
}

fn blend_chroma(f: *mut Fg, info: u64, n: i64, plane: i64, py: u64, pc: u64, stride: i64, w: i64, h: i64, subx: i64, suby: i64, maxc: i64, minv: i64) {
    var npts: i64 = gp(info, avif.GR_NCB)
    var mult: i64 = gp(info, avif.GR_CBMULT)
    var lmult: i64 = gp(info, avif.GR_CBLUMA)
    var off: i64 = gp(info, avif.GR_CBOFF)
    if plane == 2 {
        npts = gp(info, avif.GR_NCR)
        mult = gp(info, avif.GR_CRMULT)
        lmult = gp(info, avif.GR_CRLUMA)
        off = gp(info, avif.GR_CROFF)
    }
    let cfl: bool = gp(info, avif.GR_CFL) != 0
    if npts == 0 && !cfl {
        return
    }
    let overlap: bool = gp(info, avif.GR_OVERLAP) != 0
    let bd: i64 = (*f).bd
    let pmax: i64 = (1 << bd) - 1
    let shift: i64 = gp(info, avif.GR_SCALING) + 8
    let ch: i64 = (h + suby) >> suby
    let cw: i64 = (w + subx) >> subx
    let rows: i64 = 32 >> suby
    var y: i64 = n * rows
    while y < (n + 1) * rows && y < ch {
        var x: i64 = 0
        while x < cw {
            let lx: i64 = x << subx
            let ly: i64 = y << suby
            let lnx: i64 = clip3(0, w - 1, lx + 1)
            var avg: i64 = ldw(py, ly * stride + lx)
            if subx != 0 {
                avg = round2(avg + ldw(py, ly * stride + lnx), 1)
            }
            let orig: i64 = ldw(pc, y * stride + x)
            var merged: i64 = avg
            if !cfl {
                let combined: i64 = avg * (lmult - 128) + orig * (mult - 128)
                merged = clip3(0, pmax, (combined >> 6) + ((off - 256) << (bd - 8)))
            }
            var noise: i64 = noise_at(f, overlap, n, plane, suby, y - n * rows, x)
            noise = round2(scale_lut(f, plane, merged) * noise, shift)
            stw(pc, y * stride + x, clip3(minv, maxc, orig + noise))
            x = x + 1
        }
        y = y + 1
    }
}

fn blend_luma(f: *mut Fg, info: u64, n: i64, py: u64, stride: i64, w: i64, h: i64, maxl: i64, minv: i64) {
    if gp(info, avif.GR_NY) == 0 {
        return
    }
    let overlap: bool = gp(info, avif.GR_OVERLAP) != 0
    let shift: i64 = gp(info, avif.GR_SCALING) + 8
    var y: i64 = n * 32
    while y < (n + 1) * 32 && y < h {
        var x: i64 = 0
        while x < w {
            let orig: i64 = ldw(py, y * stride + x)
            var noise: i64 = noise_at(f, overlap, n, 0, 0, y - n * 32, x)
            noise = round2(scale_lut(f, 0, orig) * noise, shift)
            stw(py, y * stride + x, clip3(minv, maxl, orig + noise))
            x = x + 1
        }
        y = y + 1
    }
}

fn add_noise(f: *mut Fg, info: u64, py: u64, pu: u64, pv: u64, stride: i64, w: i64, h: i64, subx: i64, suby: i64, np: i64, mc_identity: bool) {
    let bd: i64 = (*f).bd
    var minv: i64 = 0
    var maxl: i64 = (256 << (bd - 8)) - 1
    var maxc: i64 = maxl
    if gp(info, avif.GR_CLIP) != 0 {
        minv = 16 << (bd - 8)
        maxl = 235 << (bd - 8)
        maxc = 240 << (bd - 8)
        if mc_identity {
            maxc = maxl
        }
    }
    (*f).sw = w + 64
    let bytes: usize = ((3 * 34 * (*f).sw * 4) as usize)
    (*f).cur = av1mem.heap_alloc(bytes) as u64
    (*f).prev = av1mem.heap_alloc(bytes) as u64
    var n: i64 = 0
    while n * 16 < (h + 1) / 2 {
        make_stripe(f, info, n, w, subx, suby, np)
        if np == 3 {
            blend_chroma(f, info, n, 1, py, pu, stride, w, h, subx, suby, maxc, minv)
            blend_chroma(f, info, n, 2, py, pv, stride, w, h, subx, suby, maxc, minv)
        }
        blend_luma(f, info, n, py, stride, w, h, maxl, minv)
        let t: u64 = (*f).cur
        (*f).cur = (*f).prev
        (*f).prev = t
        n = n + 1
    }
    av1mem.heap_free((*f).cur as *mut u8, bytes)
    av1mem.heap_free((*f).prev as *mut u8, bytes)
}

fn fg_apply(info: u64, py: u64, pu: u64, pv: u64, stride: i64, w: i64, h: i64, subx: i64, suby: i64, np: i64, bd: i64, mc_identity: bool) {
    if gp(info, avif.GR_APPLY) == 0 {
        return
    }
    let center: i64 = 128 << (bd - 8)
    var f: Fg = Fg { reg: 0, bd: bd, gmin: 0 - center, gmax: (256 << (bd - 8)) - 1 - center, luma: 0, cb: 0, cr: 0, lut: 0, cur: 0, prev: 0, sw: 0 }
    f.luma = av1mem.heap_alloc(82 * 73 * 4) as u64
    f.cb = av1mem.heap_alloc(82 * 73 * 4) as u64
    f.cr = av1mem.heap_alloc(82 * 73 * 4) as u64
    f.lut = av1mem.heap_alloc(3 * 256 * 4) as u64
    let ny: i64 = gp(info, avif.GR_NY)
    f.reg = gp(info, avif.GR_SEED)
    white_noise(&f, info, f.luma, 82 * 73, ny > 0)
    if ny > 0 {
        luma_grain(&f, info)
    }
    if np == 3 {
        let cfl: bool = gp(info, avif.GR_CFL) != 0
        chroma_grain(&f, info, f.cb, 46372, gp(info, avif.GR_NCB) > 0 || cfl, avif.GR_ARCB, subx, suby, ny)
        chroma_grain(&f, info, f.cr, 18904, gp(info, avif.GR_NCR) > 0 || cfl, avif.GR_ARCR, subx, suby, ny)
    }
    var plane: i64 = 0
    while plane < np {
        build_lut(&f, info, plane)
        plane = plane + 1
    }
    add_noise(&f, info, py, pu, pv, stride, w, h, subx, suby, np, mc_identity)
    av1mem.heap_free(f.luma as *mut u8, 82 * 73 * 4)
    av1mem.heap_free(f.cb as *mut u8, 82 * 73 * 4)
    av1mem.heap_free(f.cr as *mut u8, 82 * 73 * 4)
    av1mem.heap_free(f.lut as *mut u8, 3 * 256 * 4)
}
