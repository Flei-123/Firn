// lib/av1/av1sr.fi -- AV1 super-resolution horizontal upscaling.
import av1.av1mem

export { sr_upscale_plane, sr_stride, sr_bytes, sr_upscale_alloc }

static UPSCALE_FILTER: [i16; 512] = [
    0, 0, 0, 128, 0, 0, 0, 0,
    0, 0, -1, 128, 2, -1, 0, 0,
    0, 1, -3, 127, 4, -2, 1, 0,
    0, 1, -4, 127, 6, -3, 1, 0,
    0, 2, -6, 126, 8, -3, 1, 0,
    0, 2, -7, 125, 11, -4, 1, 0,
    -1, 2, -8, 125, 13, -5, 2, 0,
    -1, 3, -9, 124, 15, -6, 2, 0,
    -1, 3, -10, 123, 18, -6, 2, -1,
    -1, 3, -11, 122, 20, -7, 3, -1,
    -1, 4, -12, 121, 22, -8, 3, -1,
    -1, 4, -13, 120, 25, -9, 3, -1,
    -1, 4, -14, 118, 28, -9, 3, -1,
    -1, 4, -15, 117, 30, -10, 4, -1,
    -1, 5, -16, 116, 32, -11, 4, -1,
    -1, 5, -16, 114, 35, -12, 4, -1,
    -1, 5, -17, 112, 38, -12, 4, -1,
    -1, 5, -18, 111, 40, -13, 5, -1,
    -1, 5, -18, 109, 43, -14, 5, -1,
    -1, 6, -19, 107, 45, -14, 5, -1,
    -1, 6, -19, 105, 48, -15, 5, -1,
    -1, 6, -19, 103, 51, -16, 5, -1,
    -1, 6, -20, 101, 53, -16, 6, -1,
    -1, 6, -20, 99, 56, -17, 6, -1,
    -1, 6, -20, 97, 58, -17, 6, -1,
    -1, 6, -20, 95, 61, -18, 6, -1,
    -2, 7, -20, 93, 64, -18, 6, -2,
    -2, 7, -20, 91, 66, -19, 6, -1,
    -2, 7, -20, 88, 69, -19, 6, -1,
    -2, 7, -20, 86, 71, -19, 6, -1,
    -2, 7, -20, 84, 74, -20, 7, -2,
    -2, 7, -20, 81, 76, -20, 7, -1,
    -2, 7, -20, 79, 79, -20, 7, -2,
    -1, 7, -20, 76, 81, -20, 7, -2,
    -2, 7, -20, 74, 84, -20, 7, -2,
    -1, 6, -19, 71, 86, -20, 7, -2,
    -1, 6, -19, 69, 88, -20, 7, -2,
    -1, 6, -19, 66, 91, -20, 7, -2,
    -2, 6, -18, 64, 93, -20, 7, -2,
    -1, 6, -18, 61, 95, -20, 6, -1,
    -1, 6, -17, 58, 97, -20, 6, -1,
    -1, 6, -17, 56, 99, -20, 6, -1,
    -1, 6, -16, 53, 101, -20, 6, -1,
    -1, 5, -16, 51, 103, -19, 6, -1,
    -1, 5, -15, 48, 105, -19, 6, -1,
    -1, 5, -14, 45, 107, -19, 6, -1,
    -1, 5, -14, 43, 109, -18, 5, -1,
    -1, 5, -13, 40, 111, -18, 5, -1,
    -1, 4, -12, 38, 112, -17, 5, -1,
    -1, 4, -12, 35, 114, -16, 5, -1,
    -1, 4, -11, 32, 116, -16, 5, -1,
    -1, 4, -10, 30, 117, -15, 4, -1,
    -1, 3, -9, 28, 118, -14, 4, -1,
    -1, 3, -9, 25, 120, -13, 4, -1,
    -1, 3, -8, 22, 121, -12, 4, -1,
    -1, 3, -7, 20, 122, -11, 3, -1,
    -1, 2, -6, 18, 123, -10, 3, -1,
    0, 2, -6, 15, 124, -9, 3, -1,
    0, 2, -5, 13, 125, -8, 2, -1,
    0, 1, -4, 11, 125, -7, 2, 0,
    0, 1, -3, 8, 126, -6, 2, 0,
    0, 1, -3, 6, 127, -4, 1, 0,
    0, 1, -2, 4, 127, -3, 1, 0,
    0, 0, -1, 2, 128, -1, 0, 0,
]

#[no_gc]
fn ldw(p: u64, i: i64) -> i64 {
    return (*((p + ((i * 2) as u64)) as *mut u16)) as i64
}

#[no_gc]
fn stw(p: u64, i: i64, v: i64) {
    *((p + ((i * 2) as u64)) as *mut u16) = (v & 65535) as u16
}

fn clip3(lo: i64, hi: i64, v: i64) -> i64 {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

fn sr_upscale_plane(src: u64, src_stride: i64, dst: u64, dst_stride: i64, down_w: i64, up_w: i64, rows: i64, max_x: i64, bd: i64) {
    let step: i64 = ((down_w << 14) + (up_w / 2)) / up_w
    let err: i64 = up_w * step - (down_w << 14)
    var init: i64 = ((0 - ((up_w - down_w) << 13)) + up_w / 2) / up_w + (1 << 7) - err / 2
    init = init & 16383
    let pmax: i64 = (1 << bd) - 1
    var y: i64 = 0
    while y < rows {
        var x: i64 = 0
        while x < up_w {
            let sx: i64 = 0 - 16384 + init + x * step
            let px: i64 = sx >> 14
            let sub: i64 = (sx & 16383) >> 8
            var sum: i64 = 0
            var k: i64 = 0
            while k < 8 {
                let at: i64 = clip3(0, max_x, px + k - 3)
                sum = sum + ldw(src, y * src_stride + at) * (UPSCALE_FILTER[(sub * 8 + k) as usize] as i64)
                k = k + 1
            }
            stw(dst, y * dst_stride + x, clip3(0, pmax, (sum + 64) >> 7))
            x = x + 1
        }
        y = y + 1
    }
}

fn sr_stride(up_w: i64) -> i64 {
    return (up_w + 63) / 64 * 64 + 64
}

fn sr_bytes(stride: i64, rows: i64) -> usize {
    return ((stride * rows + 16) * 2) as usize
}

fn sr_upscale_alloc(src: u64, src_stride: i64, plane: i64, sub_x: i64, sub_y: i64, fw: i64, up_w: i64, fh: i64, mi_cols: i64, mi_rows: i64, bd: i64) -> u64 {
    var sx: i64 = 0
    var sy: i64 = 0
    if plane > 0 {
        sx = sub_x
        sy = sub_y
    }
    let stride: i64 = sr_stride(up_w)
    let dst: u64 = av1mem.heap_alloc(sr_bytes(stride, mi_rows * 4)) as u64
    if dst == 0 {
        return 0
    }
    sr_upscale_plane(src, src_stride, dst, stride, (fw + sx) >> sx, (up_w + sx) >> sx, (fh + sy) >> sy, (mi_cols >> sx) * 4 - 1, bd)
    return dst
}
