// lib/av1/av1qm.fi -- AV1 quantizer matrix lookup.
import av1.av1qm0
import av1.av1qm1
import av1.av1qm2

export { level_base, tx_offset, NONE_LEVEL, PLANE_STRIDE }

const NONE_LEVEL: i64 = 15
const PLANE_STRIDE: i64 = 3344

static TX_OFFSETS: [i16; 16] = [0, 1360, 2704, -1, 1392, 16, 1424, 2832, 2768, 1552, 80, 1680, -1, 3088, 2192, 336]

fn tx_offset(log2w: i64, log2h: i64) -> i64 {
    var lw: i64 = log2w
    if lw > 5 {
        lw = 5
    }
    var lh: i64 = log2h
    if lh > 5 {
        lh = 5
    }
    return TX_OFFSETS[((lw - 2) * 4 + (lh - 2)) as usize] as i64
}

fn level_base(level: i64, chroma: i64) -> u64 {
    let group: i64 = level / 5
    let slot: i64 = level - group * 5
    var base: u64 = av1qm0.base()
    if group == 1 {
        base = av1qm1.base()
    } else if group == 2 {
        base = av1qm2.base()
    }
    return base + (((slot * 2 + chroma) * PLANE_STRIDE) as u64)
}
