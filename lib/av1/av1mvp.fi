// SPDX-License-Identifier: MPL-2.0
export { MVP_CELLS, mvp_bind, mvp_set_tile, mvp_set_frame, mvp_set_gm, mvp_set_sign_bias, mvp_store, mvp_find, mvp_num, mvp_stack_mv, mvp_weight, mvp_new_ctx, mvp_ref_ctx, mvp_zero_ctx, mvp_drl_ctx, mvp_global_mv, mvp_close_matches, mvp_total_matches, mvp_rf, mvp_mv }

const MVP_CELLS: i64 = 256
const P_MC: i64 = 0
const P_MR: i64 = 1
const P_RF0: i64 = 2
const P_RF1: i64 = 3
const P_ISINT: i64 = 4
const P_MIS: i64 = 5
const P_YMODE: i64 = 6
const P_MV0: i64 = 7
const P_MV1: i64 = 8
const P_R0: i64 = 9
const P_R1: i64 = 10
const P_C0: i64 = 11
const P_C1: i64 = 12
const P_HP: i64 = 13
const P_FINT: i64 = 14
const P_MFMV: i64 = 15
const P_RFA: i64 = 16
const P_RFB: i64 = 17
const P_COMP: i64 = 18
const P_R: i64 = 19
const P_C: i64 = 20
const P_SIZE: i64 = 21
const P_NUM: i64 = 22
const P_NEWCNT: i64 = 23
const P_FOUND: i64 = 24
const P_CLOSE: i64 = 25
const P_TOTAL: i64 = 26
const P_NEWCTX: i64 = 27
const P_REFCTX: i64 = 28
const P_ZEROCTX: i64 = 29
const P_STK: i64 = 64
const P_GMT: i64 = 128
const P_BIAS: i64 = 136
const P_GMP: i64 = 144
const P_GLOB: i64 = 192
const P_DRL: i64 = 196
const P_IDMV: i64 = 208
const P_DIFFMV: i64 = 216
const P_CNT: i64 = 224
const MAX_STACK: i64 = 8
const REF_CAT_LEVEL: i64 = 640
const MV_BORDER: i64 = 128
const NEARESTMV: i64 = 14
const GLOBALMV: i64 = 16
const NEWMV: i64 = 17
const NEAREST_NEARESTMV: i64 = 18
const NEAREST_NEWMV: i64 = 20
const NEW_NEARESTMV: i64 = 21
const NEAR_NEWMV: i64 = 22
const NEW_NEARMV: i64 = 23
const GLOBAL_GLOBALMV: i64 = 24
const NEW_NEWMV: i64 = 25

static BW4: [i16; 22] = [1, 1, 2, 2, 2, 4, 4, 4, 8, 8, 8, 16, 16, 16, 32, 32, 1, 4, 2, 8, 4, 16]
static BH4: [i16; 22] = [1, 2, 1, 2, 4, 2, 4, 8, 4, 8, 16, 8, 16, 32, 16, 32, 4, 1, 8, 2, 16, 4]

#[no_gc]
fn pg(ps: u64, i: i64) -> i64 {
    return *((ps + ((i * 8) as u64)) as *mut i64)
}

#[no_gc]
fn pset(ps: u64, i: i64, v: i64) {
    *((ps + ((i * 8) as u64)) as *mut i64) = v
}

#[no_gc]
fn ldb(p: u64, i: i64) -> i64 {
    return (*((p + (i as u64)) as *mut u8)) as i64
}

#[no_gc]
fn stb(p: u64, i: i64, v: i64) {
    *((p + (i as u64)) as *mut u8) = (v & 255) as u8
}

#[no_gc]
fn ldi(p: u64, i: i64) -> i64 {
    return (*((p + ((i * 4) as u64)) as *mut i32)) as i64
}

#[no_gc]
fn sti(p: u64, i: i64, v: i64) {
    *((p + ((i * 4) as u64)) as *mut i32) = v as i32
}

fn imin(a: i64, b: i64) -> i64 {
    if a < b {
        return a
    }
    return b
}

fn imax(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    }
    return b
}

fn iabs(a: i64) -> i64 {
    if a < 0 {
        return 0 - a
    }
    return a
}

fn clip3(lo: i64, hi: i64, v: i64) -> i64 {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

fn round2s(x: i64, n: i64) -> i64 {
    let h: i64 = 1 << (n - 1)
    if x >= 0 {
        return (x + h) >> n
    }
    return 0 - ((h - x) >> n)
}

fn bw4_of(size: i64) -> i64 {
    return BW4[size as usize] as i64
}

fn bh4_of(size: i64) -> i64 {
    return BH4[size as usize] as i64
}

fn pack(r: i64, c: i64) -> i64 {
    return (r << 16) | (c & 65535)
}

fn unpack_r(v: i64) -> i64 {
    return v >> 16
}

fn unpack_c(v: i64) -> i64 {
    return ((v & 65535) ^ 32768) - 32768
}

fn mvp_bind(ps: u64, rf0: u64, rf1: u64, isint: u64, mis: u64, ymode: u64, mv0: u64, mv1: u64, mc: i64, mr: i64) {
    pset(ps, P_RF0, rf0 as i64)
    pset(ps, P_RF1, rf1 as i64)
    pset(ps, P_ISINT, isint as i64)
    pset(ps, P_MIS, mis as i64)
    pset(ps, P_YMODE, ymode as i64)
    pset(ps, P_MV0, mv0 as i64)
    pset(ps, P_MV1, mv1 as i64)
    pset(ps, P_MC, mc)
    pset(ps, P_MR, mr)
}

fn mvp_set_tile(ps: u64, r0: i64, r1: i64, c0: i64, c1: i64) {
    pset(ps, P_R0, r0)
    pset(ps, P_R1, r1)
    pset(ps, P_C0, c0)
    pset(ps, P_C1, c1)
}

fn mvp_set_frame(ps: u64, allow_hp: i64, force_int: i64, use_mfmv: i64) {
    pset(ps, P_HP, allow_hp)
    pset(ps, P_FINT, force_int)
    pset(ps, P_MFMV, use_mfmv)
}

fn mvp_set_gm(ps: u64, ref_frame: i64, gm_type: i64, params: u64) {
    pset(ps, P_GMT + ref_frame, gm_type)
    var i: i64 = 0
    while i < 6 {
        pset(ps, P_GMP + ref_frame * 6 + i, *((params + ((i * 8) as u64)) as *mut i64))
        i = i + 1
    }
}

fn mvp_set_sign_bias(ps: u64, ref_frame: i64, bias: i64) {
    pset(ps, P_BIAS + ref_frame, bias)
}

fn mvp_store(ps: u64, r: i64, c: i64, size: i64, isint: i64, rf0: i64, rf1: i64, ymode: i64, mv0r: i64, mv0c: i64, mv1r: i64, mv1c: i64) {
    let mc: i64 = pg(ps, P_MC)
    let mr: i64 = pg(ps, P_MR)
    let bw4: i64 = bw4_of(size)
    let bh4: i64 = bh4_of(size)
    var y: i64 = 0
    while y < bh4 {
        var x: i64 = 0
        while x < bw4 {
            if r + y < mr && c + x < mc {
                let at: i64 = (r + y) * mc + c + x
                stb(pg(ps, P_RF0) as u64, at, rf0 + 2)
                stb(pg(ps, P_RF1) as u64, at, rf1 + 2)
                stb(pg(ps, P_ISINT) as u64, at, isint)
                stb(pg(ps, P_MIS) as u64, at, size)
                stb(pg(ps, P_YMODE) as u64, at, ymode)
                sti(pg(ps, P_MV0) as u64, at, pack(mv0r, mv0c))
                sti(pg(ps, P_MV1) as u64, at, pack(mv1r, mv1c))
            }
            x = x + 1
        }
        y = y + 1
    }
}

fn mvp_rf(ps: u64, r: i64, c: i64, list: i64) -> i64 {
    var base: u64 = pg(ps, P_RF0) as u64
    if list != 0 {
        base = pg(ps, P_RF1) as u64
    }
    return ldb(base, r * pg(ps, P_MC) + c) - 2
}

fn mvp_mv(ps: u64, r: i64, c: i64, list: i64, comp: i64) -> i64 {
    var base: u64 = pg(ps, P_MV0) as u64
    if list != 0 {
        base = pg(ps, P_MV1) as u64
    }
    let v: i64 = ldi(base, r * pg(ps, P_MC) + c)
    if comp == 0 {
        return unpack_r(v)
    }
    return unpack_c(v)
}

fn written(ps: u64, r: i64, c: i64) -> bool {
    return ldb(pg(ps, P_RF0) as u64, r * pg(ps, P_MC) + c) != 0
}

fn is_inter_at(ps: u64, r: i64, c: i64) -> bool {
    return ldb(pg(ps, P_ISINT) as u64, r * pg(ps, P_MC) + c) != 0
}

fn size_at(ps: u64, r: i64, c: i64) -> i64 {
    return ldb(pg(ps, P_MIS) as u64, r * pg(ps, P_MC) + c)
}

fn ymode_at(ps: u64, r: i64, c: i64) -> i64 {
    return ldb(pg(ps, P_YMODE) as u64, r * pg(ps, P_MC) + c)
}

fn inside(ps: u64, r: i64, c: i64) -> bool {
    return c >= pg(ps, P_C0) && c < pg(ps, P_C1) && r >= pg(ps, P_R0) && r < pg(ps, P_R1)
}

fn lower_comp(ps: u64, v: i64) -> i64 {
    if pg(ps, P_HP) != 0 {
        return v
    }
    if pg(ps, P_FINT) != 0 {
        let a: i64 = (iabs(v) + 3) >> 3
        if v > 0 {
            return a << 3
        }
        return 0 - (a << 3)
    }
    if (v & 1) != 0 {
        if v > 0 {
            return v - 1
        }
        return v + 1
    }
    return v
}

fn stk_get(ps: u64, idx: i64, k: i64) -> i64 {
    return pg(ps, P_STK + idx * 5 + k)
}

fn stk_set(ps: u64, idx: i64, k: i64, v: i64) {
    pset(ps, P_STK + idx * 5 + k, v)
}

fn has_newmv(mode: i64) -> bool {
    return mode == NEWMV || mode == NEW_NEWMV || mode == NEAR_NEWMV || mode == NEW_NEARMV || mode == NEAREST_NEWMV || mode == NEW_NEARESTMV
}

fn setup_global(ps: u64, list: i64, size: i64, r: i64, c: i64) {
    var ref_frame: i64 = pg(ps, P_RFA)
    if list == 1 {
        ref_frame = pg(ps, P_RFB)
    }
    var mvr: i64 = 0
    var mvc: i64 = 0
    var typ: i64 = 0
    if ref_frame > 0 {
        typ = pg(ps, P_GMT + ref_frame)
    }
    let gb: i64 = P_GMP + ref_frame * 6
    if ref_frame > 0 && typ == 1 {
        mvr = pg(ps, gb) >> 13
        mvc = pg(ps, gb + 1) >> 13
    } else if ref_frame > 0 && typ > 1 {
        let x: i64 = c * 4 + bw4_of(size) * 2 - 1
        let y: i64 = r * 4 + bh4_of(size) * 2 - 1
        let xc: i64 = (pg(ps, gb + 2) - 65536) * x + pg(ps, gb + 3) * y + pg(ps, gb)
        let yc: i64 = pg(ps, gb + 4) * x + (pg(ps, gb + 5) - 65536) * y + pg(ps, gb + 1)
        if pg(ps, P_HP) != 0 {
            mvr = round2s(yc, 13)
            mvc = round2s(xc, 13)
        } else {
            mvr = round2s(yc, 14) * 2
            mvc = round2s(xc, 14) * 2
        }
    }
    pset(ps, P_GLOB + list * 2, lower_comp(ps, mvr))
    pset(ps, P_GLOB + list * 2 + 1, lower_comp(ps, mvc))
}

fn stack_find1(ps: u64, mr: i64, mc: i64) -> i64 {
    let n: i64 = pg(ps, P_NUM)
    var i: i64 = 0
    while i < n {
        if stk_get(ps, i, 0) == mr && stk_get(ps, i, 1) == mc {
            return i
        }
        i = i + 1
    }
    return n
}

fn stack_find2(ps: u64, a: i64, b: i64, c: i64, d: i64) -> i64 {
    let n: i64 = pg(ps, P_NUM)
    var i: i64 = 0
    while i < n {
        if stk_get(ps, i, 0) == a && stk_get(ps, i, 1) == b && stk_get(ps, i, 2) == c && stk_get(ps, i, 3) == d {
            return i
        }
        i = i + 1
    }
    return n
}

fn stack_put(ps: u64, idx: i64, a: i64, b: i64, c: i64, d: i64, weight: i64) {
    stk_set(ps, idx, 0, a)
    stk_set(ps, idx, 1, b)
    stk_set(ps, idx, 2, c)
    stk_set(ps, idx, 3, d)
    stk_set(ps, idx, 4, weight)
}

fn search_stack(ps: u64, r: i64, c: i64, weight: i64, cand_list: i64) {
    let cand_mode: i64 = ymode_at(ps, r, c)
    let cand_size: i64 = size_at(ps, r, c)
    let large: bool = imin(bw4_of(cand_size), bh4_of(cand_size)) >= 2
    var mvr: i64 = mvp_mv(ps, r, c, cand_list, 0)
    var mvc: i64 = mvp_mv(ps, r, c, cand_list, 1)
    if (cand_mode == GLOBALMV || cand_mode == GLOBAL_GLOBALMV) && pg(ps, P_GMT + pg(ps, P_RFA)) > 1 && large {
        mvr = pg(ps, P_GLOB)
        mvc = pg(ps, P_GLOB + 1)
    }
    mvr = lower_comp(ps, mvr)
    mvc = lower_comp(ps, mvc)
    if has_newmv(cand_mode) {
        pset(ps, P_NEWCNT, pg(ps, P_NEWCNT) + 1)
    }
    pset(ps, P_FOUND, 1)
    let idx: i64 = stack_find1(ps, mvr, mvc)
    let n: i64 = pg(ps, P_NUM)
    if idx < n {
        stk_set(ps, idx, 4, stk_get(ps, idx, 4) + weight)
    } else if n < MAX_STACK {
        stack_put(ps, n, mvr, mvc, 0, 0, weight)
        pset(ps, P_NUM, n + 1)
    }
}

fn compound_search_stack(ps: u64, r: i64, c: i64, weight: i64) {
    let cand_mode: i64 = ymode_at(ps, r, c)
    var m0r: i64 = mvp_mv(ps, r, c, 0, 0)
    var m0c: i64 = mvp_mv(ps, r, c, 0, 1)
    var m1r: i64 = mvp_mv(ps, r, c, 1, 0)
    var m1c: i64 = mvp_mv(ps, r, c, 1, 1)
    if cand_mode == GLOBAL_GLOBALMV {
        if pg(ps, P_GMT + pg(ps, P_RFA)) > 1 {
            m0r = pg(ps, P_GLOB)
            m0c = pg(ps, P_GLOB + 1)
        }
        if pg(ps, P_GMT + pg(ps, P_RFB)) > 1 {
            m1r = pg(ps, P_GLOB + 2)
            m1c = pg(ps, P_GLOB + 3)
        }
    }
    m0r = lower_comp(ps, m0r)
    m0c = lower_comp(ps, m0c)
    m1r = lower_comp(ps, m1r)
    m1c = lower_comp(ps, m1c)
    pset(ps, P_FOUND, 1)
    let idx: i64 = stack_find2(ps, m0r, m0c, m1r, m1c)
    let n: i64 = pg(ps, P_NUM)
    if idx < n {
        stk_set(ps, idx, 4, stk_get(ps, idx, 4) + weight)
    } else if n < MAX_STACK {
        stack_put(ps, n, m0r, m0c, m1r, m1c, weight)
        pset(ps, P_NUM, n + 1)
    }
    if has_newmv(cand_mode) {
        pset(ps, P_NEWCNT, pg(ps, P_NEWCNT) + 1)
    }
}

fn add_ref_mv_candidate(ps: u64, r: i64, c: i64, weight: i64) {
    if !is_inter_at(ps, r, c) {
        return
    }
    if pg(ps, P_COMP) == 0 {
        var list: i64 = 0
        while list < 2 {
            if mvp_rf(ps, r, c, list) == pg(ps, P_RFA) {
                search_stack(ps, r, c, weight, list)
            }
            list = list + 1
        }
    } else if mvp_rf(ps, r, c, 0) == pg(ps, P_RFA) && mvp_rf(ps, r, c, 1) == pg(ps, P_RFB) {
        compound_search_stack(ps, r, c, weight)
    }
}

fn scan_row(ps: u64, delta_row_in: i64) {
    let r: i64 = pg(ps, P_R)
    let c: i64 = pg(ps, P_C)
    let bw4: i64 = bw4_of(pg(ps, P_SIZE))
    var delta_row: i64 = delta_row_in
    let end4: i64 = imin(imin(bw4, pg(ps, P_MC) - c), 16)
    var delta_col: i64 = 0
    let step16: bool = bw4 >= 16
    if iabs(delta_row) > 1 {
        delta_row = delta_row + (r & 1)
        delta_col = 1 - (c & 1)
    }
    var i: i64 = 0
    while i < end4 {
        let mvr: i64 = r + delta_row
        let mvc: i64 = c + delta_col + i
        if !inside(ps, mvr, mvc) {
            break
        }
        var len: i64 = imin(bw4, bw4_of(size_at(ps, mvr, mvc)))
        if iabs(delta_row) > 1 {
            len = imax(2, len)
        }
        if step16 {
            len = imax(4, len)
        }
        add_ref_mv_candidate(ps, mvr, mvc, len * 2)
        i = i + len
    }
}

fn scan_col(ps: u64, delta_col_in: i64) {
    let r: i64 = pg(ps, P_R)
    let c: i64 = pg(ps, P_C)
    let bh4: i64 = bh4_of(pg(ps, P_SIZE))
    var delta_col: i64 = delta_col_in
    let end4: i64 = imin(imin(bh4, pg(ps, P_MR) - r), 16)
    var delta_row: i64 = 0
    let step16: bool = bh4 >= 16
    if iabs(delta_col) > 1 {
        delta_row = 1 - (r & 1)
        delta_col = delta_col + (c & 1)
    }
    var i: i64 = 0
    while i < end4 {
        let mvr: i64 = r + delta_row + i
        let mvc: i64 = c + delta_col
        if !inside(ps, mvr, mvc) {
            break
        }
        var len: i64 = imin(bh4, bh4_of(size_at(ps, mvr, mvc)))
        if iabs(delta_col) > 1 {
            len = imax(2, len)
        }
        if step16 {
            len = imax(4, len)
        }
        add_ref_mv_candidate(ps, mvr, mvc, len * 2)
        i = i + len
    }
}

fn scan_point(ps: u64, dr: i64, dc: i64) {
    let mvr: i64 = pg(ps, P_R) + dr
    let mvc: i64 = pg(ps, P_C) + dc
    if inside(ps, mvr, mvc) && written(ps, mvr, mvc) {
        add_ref_mv_candidate(ps, mvr, mvc, 4)
    }
}

fn swap_entries(ps: u64, a: i64, b: i64) {
    var k: i64 = 0
    while k < 5 {
        let t: i64 = stk_get(ps, a, k)
        stk_set(ps, a, k, stk_get(ps, b, k))
        stk_set(ps, b, k, t)
        k = k + 1
    }
}

fn sort_range(ps: u64, start: i64, end_in: i64) {
    var end: i64 = end_in
    while end > start {
        var new_end: i64 = start
        var idx: i64 = start + 1
        while idx < end {
            if stk_get(ps, idx - 1, 4) < stk_get(ps, idx, 4) {
                swap_entries(ps, idx - 1, idx)
                new_end = idx
            }
            idx = idx + 1
        }
        end = new_end
    }
}

fn flip_sign(ps: u64, cand_ref: i64, own_ref: i64, v: i64) -> i64 {
    if pg(ps, P_BIAS + cand_ref) != pg(ps, P_BIAS + own_ref) {
        return 0 - v
    }
    return v
}

fn add_extra_candidate(ps: u64, r: i64, c: i64) {
    var cand_list: i64 = 0
    while cand_list < 2 {
        let cand_ref: i64 = mvp_rf(ps, r, c, cand_list)
        if cand_ref > 0 {
            let cmr: i64 = mvp_mv(ps, r, c, cand_list, 0)
            let cmc: i64 = mvp_mv(ps, r, c, cand_list, 1)
            if pg(ps, P_COMP) != 0 {
                var list: i64 = 0
                while list < 2 {
                    var own: i64 = pg(ps, P_RFA)
                    if list == 1 {
                        own = pg(ps, P_RFB)
                    }
                    let ic: i64 = pg(ps, P_CNT + list)
                    let dc: i64 = pg(ps, P_CNT + 2 + list)
                    if cand_ref == own && ic < 2 {
                        pset(ps, P_IDMV + (list * 2 + ic) * 2, cmr)
                        pset(ps, P_IDMV + (list * 2 + ic) * 2 + 1, cmc)
                        pset(ps, P_CNT + list, ic + 1)
                    } else if dc < 2 {
                        pset(ps, P_DIFFMV + (list * 2 + dc) * 2, flip_sign(ps, cand_ref, own, cmr))
                        pset(ps, P_DIFFMV + (list * 2 + dc) * 2 + 1, flip_sign(ps, cand_ref, own, cmc))
                        pset(ps, P_CNT + 2 + list, dc + 1)
                    }
                    list = list + 1
                }
            } else {
                let fr: i64 = flip_sign(ps, cand_ref, pg(ps, P_RFA), cmr)
                let fc: i64 = flip_sign(ps, cand_ref, pg(ps, P_RFA), cmc)
                let idx: i64 = stack_find1(ps, fr, fc)
                let n: i64 = pg(ps, P_NUM)
                if idx == n {
                    stack_put(ps, n, fr, fc, 0, 0, 2)
                    pset(ps, P_NUM, n + 1)
                }
            }
        }
        cand_list = cand_list + 1
    }
}

fn extra_search(ps: u64) {
    let r: i64 = pg(ps, P_R)
    let c: i64 = pg(ps, P_C)
    let size: i64 = pg(ps, P_SIZE)
    var k: i64 = 0
    while k < 4 {
        pset(ps, P_CNT + k, 0)
        k = k + 1
    }
    var w4: i64 = imin(16, bw4_of(size))
    var h4: i64 = imin(16, bh4_of(size))
    w4 = imin(w4, pg(ps, P_MC) - c)
    h4 = imin(h4, pg(ps, P_MR) - r)
    let num4x4: i64 = imin(w4, h4)
    var pass: i64 = 0
    while pass < 2 {
        var idx: i64 = 0
        while idx < num4x4 && pg(ps, P_NUM) < 2 {
            var mvr: i64 = r - 1
            var mvc: i64 = c + idx
            if pass == 1 {
                mvr = r + idx
                mvc = c - 1
            }
            if !inside(ps, mvr, mvc) {
                break
            }
            add_extra_candidate(ps, mvr, mvc)
            if pass == 0 {
                idx = idx + bw4_of(size_at(ps, mvr, mvc))
            } else {
                idx = idx + bh4_of(size_at(ps, mvr, mvc))
            }
        }
        pass = pass + 1
    }
    if pg(ps, P_COMP) != 0 {
        extra_combine(ps)
    } else {
        var i: i64 = pg(ps, P_NUM)
        while i < 2 {
            stk_set(ps, i, 0, pg(ps, P_GLOB))
            stk_set(ps, i, 1, pg(ps, P_GLOB + 1))
            i = i + 1
        }
    }
}

fn comb_get(ps: u64, list: i64, slot: i64, comp: i64) -> i64 {
    var cnt_id: i64 = pg(ps, P_CNT + list)
    var cnt_diff: i64 = pg(ps, P_CNT + 2 + list)
    var count: i64 = 0
    var s: i64 = 0
    while s < cnt_id {
        if count == slot {
            return pg(ps, P_IDMV + (list * 2 + s) * 2 + comp)
        }
        count = count + 1
        s = s + 1
    }
    s = 0
    while s < cnt_diff && count < 2 {
        if count == slot {
            return pg(ps, P_DIFFMV + (list * 2 + s) * 2 + comp)
        }
        count = count + 1
        s = s + 1
    }
    return pg(ps, P_GLOB + list * 2 + comp)
}

fn extra_combine(ps: u64) {
    let n: i64 = pg(ps, P_NUM)
    if n == 1 {
        var use_slot: i64 = 0
        if comb_get(ps, 0, 0, 0) == stk_get(ps, 0, 0) && comb_get(ps, 0, 0, 1) == stk_get(ps, 0, 1) && comb_get(ps, 1, 0, 0) == stk_get(ps, 0, 2) && comb_get(ps, 1, 0, 1) == stk_get(ps, 0, 3) {
            use_slot = 1
        }
        stack_put(ps, n, comb_get(ps, 0, use_slot, 0), comb_get(ps, 0, use_slot, 1), comb_get(ps, 1, use_slot, 0), comb_get(ps, 1, use_slot, 1), 2)
        pset(ps, P_NUM, n + 1)
    } else {
        var idx: i64 = 0
        while idx < 2 {
            let at: i64 = pg(ps, P_NUM)
            stack_put(ps, at, comb_get(ps, 0, idx, 0), comb_get(ps, 0, idx, 1), comb_get(ps, 1, idx, 0), comb_get(ps, 1, idx, 1), 2)
            pset(ps, P_NUM, at + 1)
            idx = idx + 1
        }
    }
}

fn finish_contexts(ps: u64, num_new: i64) {
    let r: i64 = pg(ps, P_R)
    let c: i64 = pg(ps, P_C)
    let size: i64 = pg(ps, P_SIZE)
    let bw4: i64 = bw4_of(size)
    let bh4: i64 = bh4_of(size)
    let n: i64 = pg(ps, P_NUM)
    var idx: i64 = 0
    while idx < n {
        var z: i64 = 0
        if idx + 1 < n {
            let w0: i64 = stk_get(ps, idx, 4)
            let w1: i64 = stk_get(ps, idx + 1, 4)
            if w0 >= REF_CAT_LEVEL {
                if w1 < REF_CAT_LEVEL {
                    z = 1
                }
            } else {
                z = 2
            }
        }
        pset(ps, P_DRL + idx, z)
        idx = idx + 1
    }
    let brow: i64 = MV_BORDER + bh4 * 4 * 8
    let bcol: i64 = MV_BORDER + bw4 * 4 * 8
    let top: i64 = 0 - ((r * 4) * 8)
    let bottom: i64 = ((pg(ps, P_MR) - bh4 - r) * 4) * 8
    let left: i64 = 0 - ((c * 4) * 8)
    let right: i64 = ((pg(ps, P_MC) - bw4 - c) * 4) * 8
    var lists: i64 = 1
    if pg(ps, P_COMP) != 0 {
        lists = 2
    }
    var list: i64 = 0
    while list < lists {
        idx = 0
        while idx < n {
            stk_set(ps, idx, list * 2, clip3(top - brow, bottom + brow, stk_get(ps, idx, list * 2)))
            stk_set(ps, idx, list * 2 + 1, clip3(left - bcol, right + bcol, stk_get(ps, idx, list * 2 + 1)))
            idx = idx + 1
        }
        list = list + 1
    }
    let close: i64 = pg(ps, P_CLOSE)
    let total: i64 = pg(ps, P_TOTAL)
    if close == 0 {
        pset(ps, P_NEWCTX, imin(total, 1))
        pset(ps, P_REFCTX, total)
    } else if close == 1 {
        pset(ps, P_NEWCTX, 3 - imin(num_new, 1))
        pset(ps, P_REFCTX, 2 + total)
    } else {
        pset(ps, P_NEWCTX, 5 - imin(num_new, 1))
        pset(ps, P_REFCTX, 5)
    }
}

fn mvp_find(ps: u64, r: i64, c: i64, size: i64, rf0: i64, rf1: i64) -> i64 {
    if pg(ps, P_MFMV) != 0 {
        return 0 - 1
    }
    pset(ps, P_R, r)
    pset(ps, P_C, c)
    pset(ps, P_SIZE, size)
    pset(ps, P_RFA, rf0)
    pset(ps, P_RFB, rf1)
    var comp: i64 = 0
    if rf1 > 0 {
        comp = 1
    }
    pset(ps, P_COMP, comp)
    let bw4: i64 = bw4_of(size)
    let bh4: i64 = bh4_of(size)
    pset(ps, P_NUM, 0)
    pset(ps, P_NEWCNT, 0)
    setup_global(ps, 0, size, r, c)
    if comp != 0 {
        setup_global(ps, 1, size, r, c)
    }
    pset(ps, P_FOUND, 0)
    scan_row(ps, 0 - 1)
    var above: i64 = pg(ps, P_FOUND)
    pset(ps, P_FOUND, 0)
    scan_col(ps, 0 - 1)
    var left: i64 = pg(ps, P_FOUND)
    pset(ps, P_FOUND, 0)
    if imax(bw4, bh4) <= 16 {
        scan_point(ps, 0 - 1, bw4)
    }
    if pg(ps, P_FOUND) == 1 {
        above = 1
    }
    pset(ps, P_CLOSE, above + left)
    let nearest: i64 = pg(ps, P_NUM)
    let num_new: i64 = pg(ps, P_NEWCNT)
    var i: i64 = 0
    while i < nearest {
        stk_set(ps, i, 4, stk_get(ps, i, 4) + REF_CAT_LEVEL)
        i = i + 1
    }
    pset(ps, P_ZEROCTX, 0)
    scan_point(ps, 0 - 1, 0 - 1)
    if pg(ps, P_FOUND) == 1 {
        above = 1
    }
    pset(ps, P_FOUND, 0)
    scan_row(ps, 0 - 3)
    if pg(ps, P_FOUND) == 1 {
        above = 1
    }
    pset(ps, P_FOUND, 0)
    scan_col(ps, 0 - 3)
    if pg(ps, P_FOUND) == 1 {
        left = 1
    }
    pset(ps, P_FOUND, 0)
    if bh4 > 1 {
        scan_row(ps, 0 - 5)
    }
    if pg(ps, P_FOUND) == 1 {
        above = 1
    }
    pset(ps, P_FOUND, 0)
    if bw4 > 1 {
        scan_col(ps, 0 - 5)
    }
    if pg(ps, P_FOUND) == 1 {
        left = 1
    }
    pset(ps, P_TOTAL, above + left)
    sort_range(ps, 0, nearest)
    sort_range(ps, nearest, pg(ps, P_NUM))
    if pg(ps, P_NUM) < 2 {
        extra_search(ps)
    }
    finish_contexts(ps, num_new)
    return 0
}

fn mvp_num(ps: u64) -> i64 {
    return pg(ps, P_NUM)
}

fn mvp_stack_mv(ps: u64, idx: i64, list: i64, comp: i64) -> i64 {
    return stk_get(ps, idx, list * 2 + comp)
}

fn mvp_weight(ps: u64, idx: i64) -> i64 {
    return stk_get(ps, idx, 4)
}

fn mvp_new_ctx(ps: u64) -> i64 {
    return pg(ps, P_NEWCTX)
}

fn mvp_ref_ctx(ps: u64) -> i64 {
    return pg(ps, P_REFCTX)
}

fn mvp_zero_ctx(ps: u64) -> i64 {
    return pg(ps, P_ZEROCTX)
}

fn mvp_drl_ctx(ps: u64, idx: i64) -> i64 {
    return pg(ps, P_DRL + idx)
}

fn mvp_global_mv(ps: u64, list: i64, comp: i64) -> i64 {
    return pg(ps, P_GLOB + list * 2 + comp)
}

fn mvp_close_matches(ps: u64) -> i64 {
    return pg(ps, P_CLOSE)
}

fn mvp_total_matches(ps: u64) -> i64 {
    return pg(ps, P_TOTAL)
}
