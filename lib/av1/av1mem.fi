// lib/av1/av1mem.fi -- zeroed heap blocks and copying for the AV1 decoder.
import rt.rt

export { heap_alloc, heap_free, mem_copy, cell_get, cell_set, byte_get, byte_set }

fn heap_alloc(n: usize) -> *mut u8 {
    return rt.heap_alloc(n) as *mut u8
}

fn heap_free(p: *mut u8, n: usize) {
    rt.heap_free(p as u64, n)
}

fn mem_copy(dst: *mut u8, src: *mut u8, n: usize) {
    rt.mem_copy(dst as u64, src as u64, n)
}

#[no_gc]
fn cell_get(p: u64, i: i64) -> i64 {
    return *((p + ((i * 8) as u64)) as *mut i64)
}

#[no_gc]
fn cell_set(p: u64, i: i64, v: i64) {
    *((p + ((i * 8) as u64)) as *mut i64) = v
}

#[no_gc]
fn byte_get(p: u64, i: i64) -> i64 {
    return (*((p + (i as u64)) as *mut u8)) as i64
}

#[no_gc]
fn byte_set(p: u64, i: i64, v: i64) {
    *((p + (i as u64)) as *mut u8) = (v & 255) as u8
}
