import std.rt
import print.bitmap

export { rle_page, rle_line, rle_decode_page, unit_bytes }

fn unit_bytes(fmt: u32) -> usize {
    if fmt == bitmap.FMT_RGB8 { return 3 }
    return 1
}

fn same(p: u64, a: usize, b: usize, u: usize) -> bool {
    return rt.mem_eq(p + a as u64, p + b as u64, u)
}

fn rle_line(out: *mut rt.Buf, row: u64, bytes: usize, u: usize) {
    let n: usize = bytes / u
    var i: usize = 0
    while i < n {
        var r: usize = 1
        while i + r < n && r < 128 && same(row, i * u, (i + r) * u, u) {
            r = r + 1
        }
        if r >= 2 {
            rt.buf_push(out, (r - 1) as u8)
            rt.buf_push_bytes(out, row + (i * u) as u64, u)
            i = i + r
        } else {
            var k: usize = 1
            while i + k < n && k < 128 && !(i + k + 1 < n && same(row, (i + k) * u, (i + k + 1) * u, u)) {
                k = k + 1
            }
            if k == 1 {
                rt.buf_push(out, 0 as u8)
                rt.buf_push_bytes(out, row + (i * u) as u64, u)
            } else {
                rt.buf_push(out, (257 - k) as u8)
                rt.buf_push_bytes(out, row + (i * u) as u64, k * u)
            }
            i = i + k
        }
    }
}

fn rle_page(out: *mut rt.Buf, bm: *mut bitmap.Bitmap) {
    let u: usize = unit_bytes((*bm).fmt)
    var y: u32 = 0
    while y < (*bm).h {
        var rep: u32 = 1
        let row: u64 = bitmap.bitmap_row(bm, y)
        while y + rep < (*bm).h && rep < 256 && rt.mem_eq(row, bitmap.bitmap_row(bm, y + rep), (*bm).stride) {
            rep = rep + 1
        }
        rt.buf_push(out, (rep - 1) as u8)
        rle_line(out, row, (*bm).stride, u)
        y = y + rep
    }
}

fn rle_decode_page(p: u64, n: usize, bm: *mut bitmap.Bitmap) -> usize {
    let u: usize = unit_bytes((*bm).fmt)
    var i: usize = 0
    var y: u32 = 0
    while y < (*bm).h {
        if i >= n {
            return 0
        }
        let rep: u32 = rt.ld8(p, i) as u32 + 1
        i = i + 1
        let row: u64 = bitmap.bitmap_row(bm, y)
        var x: usize = 0
        while x < (*bm).stride {
            if i >= n {
                return 0
            }
            let c: u8 = rt.ld8(p, i)
            i = i + 1
            if c == 128 as u8 {
                rt.mem_set(row + x as u64, 255 as u8, (*bm).stride - x)
                x = (*bm).stride
            } else if c < 128 as u8 {
                let cnt: usize = c as usize + 1
                if i + u > n || x + cnt * u > (*bm).stride {
                    return 0
                }
                var j: usize = 0
                while j < cnt {
                    rt.mem_copy(row + (x + j * u) as u64, p + i as u64, u)
                    j = j + 1
                }
                i = i + u
                x = x + cnt * u
            } else {
                let cnt: usize = 257 - c as usize
                if i + cnt * u > n || x + cnt * u > (*bm).stride {
                    return 0
                }
                rt.mem_copy(row + x as u64, p + i as u64, cnt * u)
                i = i + cnt * u
                x = x + cnt * u
            }
        }
        var r: u32 = 1
        while r < rep && y + r < (*bm).h {
            rt.mem_copy(bitmap.bitmap_row(bm, y + r), row, (*bm).stride)
            r = r + 1
        }
        y = y + rep
    }
    return i
}
