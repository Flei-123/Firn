import std.rt
import std.vec
import std.str
import print.ippmsg
import print.ippcaps
import print.ippclient
import print.discover

export {
    Entry, Model, model_new, model_free, model_add_found, model_add_uri, model_count, model_entry,
    model_select, model_selected, model_load_caps, model_choices, model_set, model_get,
    model_set_copies, model_set_ranges, model_spec, model_can_print, model_find_uri,
    FIELD_SIDES, FIELD_COLOR, FIELD_MEDIA, FIELD_SCALING,
}

const FIELD_SIDES: u32 = 0
const FIELD_COLOR: u32 = 1
const FIELD_MEDIA: u32 = 2
const FIELD_SCALING: u32 = 3

struct Entry {
    name: str,
    uri: str,
    make: str,
    location: str,
    source: u32,
    caps: ippcaps.Caps,
    has_caps: bool,
}

struct Model {
    entries: Vec[Entry],
    selected: usize,
    spec: ippclient.JobSpec,
}

fn model_new() -> Model {
    return Model { entries: vec_new[Entry](), selected: ippmsg.NONE_INDEX, spec: ippclient.spec_default() }
}

fn model_free(m: *mut Model) {
    var i: usize = 0
    while i < vec_len[Entry](&(*m).entries) {
        ippcaps.caps_free(&(*vec_elem_ptr[Entry](&(*m).entries, i)).caps)
        i = i + 1
    }
    vec_free[Entry](&(*m).entries)
    vec_free[u32](&(*m).spec.ranges)
}

fn model_count(m: *mut Model) -> usize { return vec_len[Entry](&(*m).entries) }
fn model_entry(m: *mut Model, i: usize) -> *mut Entry { return vec_elem_ptr[Entry](&(*m).entries, i) }
fn model_selected(m: *mut Model) -> usize { return (*m).selected }
fn model_spec(m: *mut Model) -> *mut ippclient.JobSpec { return &(*m).spec }

fn model_find_uri(m: *mut Model, uri: str) -> usize {
    var i: usize = 0
    while i < vec_len[Entry](&(*m).entries) {
        if (*model_entry(m, i)).uri == uri {
            return i
        }
        i = i + 1
    }
    return ippmsg.NONE_INDEX
}

fn model_add_found(m: *mut Model, f: *mut discover.Found) -> usize {
    let at: usize = model_find_uri(m, (*f).uri)
    if at != ippmsg.NONE_INDEX {
        return at
    }
    vec_push[Entry](&(*m).entries, Entry { name: __str_copy((*f).name), uri: __str_copy((*f).uri), make: __str_copy((*f).make),
        location: __str_copy((*f).location), source: (*f).source, caps: ippcaps.caps_new(), has_caps: false })
    return vec_len[Entry](&(*m).entries) - 1
}

fn model_add_uri(m: *mut Model, uri: str) -> usize {
    var f: discover.Found = discover.found_new()
    f.uri = ippclient.normalize_uri(uri)
    f.name = uri
    if f.uri.n == 0 {
        return ippmsg.NONE_INDEX
    }
    return model_add_found(m, &f)
}

fn reset_spec(m: *mut Model) {
    vec_free[u32](&(*m).spec.ranges)
    (*m).spec = ippclient.spec_default()
}

fn model_select(m: *mut Model, i: usize) -> bool {
    if i >= vec_len[Entry](&(*m).entries) {
        return false
    }
    (*m).selected = i
    reset_spec(m)
    return true
}

fn model_load_caps(m: *mut Model, c: *mut ippclient.Client) -> bool {
    if (*m).selected == ippmsg.NONE_INDEX {
        return false
    }
    let e: *mut Entry = model_entry(m, (*m).selected)
    var cp: ippcaps.Caps = ippcaps.caps_new()
    let ok: bool = ippclient.get_printer_attributes(c, (*e).uri, &cp) catch | er | (false)
    if !ok {
        ippcaps.caps_free(&cp)
        return false
    }
    ippcaps.caps_free(&(*e).caps)
    (*e).caps = cp
    (*e).has_caps = true
    if cp.name.n > 0 {
        (*e).name = __str_copy(cp.name)
    }
    (*m).spec.media = ""
    return true
}

fn model_choices(m: *mut Model, field: u32) -> str {
    if (*m).selected == ippmsg.NONE_INDEX {
        return ""
    }
    let e: *mut Entry = model_entry(m, (*m).selected)
    if !(*e).has_caps {
        return ""
    }
    if field == FIELD_SIDES { return (*e).caps.sides }
    if field == FIELD_COLOR { return (*e).caps.color_modes }
    if field == FIELD_MEDIA { return (*e).caps.media }
    return (*e).caps.scaling
}

fn model_get(m: *mut Model, field: u32) -> str {
    if field == FIELD_SIDES { return (*m).spec.sides }
    if field == FIELD_COLOR { return (*m).spec.color_mode }
    if field == FIELD_MEDIA { return (*m).spec.media }
    return (*m).spec.scaling
}

fn model_set(m: *mut Model, field: u32, value: str) -> bool {
    let allowed: str = model_choices(m, field)
    if value.n > 0 && (allowed.n == 0 || !ippcaps.caps_list_has(allowed, value)) {
        return false
    }
    if field == FIELD_SIDES { (*m).spec.sides = value }
    else if field == FIELD_COLOR { (*m).spec.color_mode = value }
    else if field == FIELD_MEDIA { (*m).spec.media = value }
    else { (*m).spec.scaling = value }
    return true
}

fn model_set_copies(m: *mut Model, n: u32) -> bool {
    if n == 0 || (*m).selected == ippmsg.NONE_INDEX {
        return false
    }
    let e: *mut Entry = model_entry(m, (*m).selected)
    if (*e).has_caps && n > (*e).caps.copies_max {
        return false
    }
    (*m).spec.copies = n
    return true
}

fn model_set_ranges(m: *mut Model, text: str) -> bool {
    if (*m).selected == ippmsg.NONE_INDEX {
        return false
    }
    let e: *mut Entry = model_entry(m, (*m).selected)
    if text.n > 0 && (*e).has_caps && !(*e).caps.page_ranges {
        return false
    }
    return ippclient.spec_set_ranges(&(*m).spec, text)
}

fn model_can_print(m: *mut Model) -> bool {
    if (*m).selected == ippmsg.NONE_INDEX {
        return false
    }
    let e: *mut Entry = model_entry(m, (*m).selected)
    return (*e).has_caps && (*e).caps.accepting && (*e).caps.state != 5
}
