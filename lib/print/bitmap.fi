// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.vec

export {
    Bitmap, bitmap_new, bitmap_free, bitmap_row, bitmap_from_rgba, bitmap_bits_per_pixel,
    bitmap_bytes_per_line, bitmap_fill_white, bitmap_get_gray, bitmap_set_rgb,
    FMT_GRAY8, FMT_RGB8, FMT_BLACK1, DITHER_NONE, DITHER_FLOYD,
}

const FMT_GRAY8: u32 = 1
const FMT_RGB8: u32 = 2
const FMT_BLACK1: u32 = 3

const DITHER_NONE: u32 = 0
const DITHER_FLOYD: u32 = 1

struct Bitmap {
    w: u32,
    h: u32,
    fmt: u32,
    stride: usize,
    data: rt.Buf,
}

fn bitmap_bits_per_pixel(fmt: u32) -> u32 {
    if fmt == FMT_RGB8 { return 24 as u32 }
    if fmt == FMT_BLACK1 { return 1 as u32 }
    return 8 as u32
}

fn bitmap_bytes_per_line(w: u32, fmt: u32) -> usize {
    if fmt == FMT_RGB8 { return w as usize * 3 }
    if fmt == FMT_BLACK1 { return (w as usize + 7) / 8 }
    return w as usize
}

fn bitmap_fill_white(b: *mut Bitmap) {
    var v: u8 = 255 as u8
    if (*b).fmt == FMT_BLACK1 {
        v = 0 as u8
    }
    rt.mem_set(rt.buf_ptr(&(*b).data), v, (*b).stride * (*b).h as usize)
}

fn bitmap_new(w: u32, h: u32, fmt: u32) -> Bitmap {
    let stride: usize = bitmap_bytes_per_line(w, fmt)
    var b: Bitmap = Bitmap { w: w, h: h, fmt: fmt, stride: stride, data: rt.buf_new() }
    rt.buf_reserve(&b.data, stride * h as usize + 1)
    rt.buf_set_len(&b.data, stride * h as usize)
    bitmap_fill_white(&b)
    return b
}

fn bitmap_free(b: *mut Bitmap) {
    rt.buf_free(&(*b).data)
}

fn bitmap_row(b: *mut Bitmap, y: u32) -> u64 {
    return rt.buf_ptr(&(*b).data) + (y as usize * (*b).stride) as u64
}

fn bitmap_get_gray(b: *mut Bitmap, x: u32, y: u32) -> u32 {
    let row: u64 = bitmap_row(b, y)
    if (*b).fmt == FMT_GRAY8 {
        return rt.ld8(row, x as usize) as u32
    }
    if (*b).fmt == FMT_RGB8 {
        let o: usize = x as usize * 3
        return (rt.ld8(row, o) as u32 * 77 + rt.ld8(row, o + 1) as u32 * 150 + rt.ld8(row, o + 2) as u32 * 29) >> 8
    }
    let bit: u8 = (rt.ld8(row, (x / 8) as usize) >> (7 - (x % 8)) as u8) & 1 as u8
    if bit == 1 as u8 {
        return 0 as u32
    }
    return 255 as u32
}

fn bitmap_set_rgb(b: *mut Bitmap, x: u32, y: u32, r: u8, g: u8, bl: u8) {
    let row: u64 = bitmap_row(b, y)
    if (*b).fmt == FMT_RGB8 {
        let o: usize = x as usize * 3
        rt.st8(row, o, r)
        rt.st8(row, o + 1, g)
        rt.st8(row, o + 2, bl)
    } else if (*b).fmt == FMT_GRAY8 {
        rt.st8(row, x as usize, ((r as u32 * 77 + g as u32 * 150 + bl as u32 * 29) >> 8) as u8)
    }
}

fn over_white(c: u32, a: u32) -> u32 {
    let v: u32 = c + 255 - a
    if v > 255 {
        return 255 as u32
    }
    return v
}

fn bitmap_from_rgba(p: u64, w: u32, h: u32, fmt: u32, dither: u32) -> Bitmap {
    var out: Bitmap = bitmap_new(w, h, fmt)
    var err: Vec[i32] = vec_new[i32]()
    var next: Vec[i32] = vec_new[i32]()
    let ew: usize = w as usize + 2
    var k: usize = 0
    while k < ew {
        vec_push[i32](&err, 0)
        vec_push[i32](&next, 0)
        k = k + 1
    }
    var y: u32 = 0
    while y < h {
        let src: u64 = p + (y as usize * w as usize * 4) as u64
        let dst: u64 = bitmap_row(&out, y)
        var x: u32 = 0
        while x < w {
            let o: usize = x as usize * 4
            let a: u32 = rt.ld8(src, o + 3) as u32
            let r: u32 = over_white(rt.ld8(src, o) as u32, a)
            let g: u32 = over_white(rt.ld8(src, o + 1) as u32, a)
            let bl: u32 = over_white(rt.ld8(src, o + 2) as u32, a)
            if fmt == FMT_RGB8 {
                rt.st8(dst, x as usize * 3, r as u8)
                rt.st8(dst, x as usize * 3 + 1, g as u8)
                rt.st8(dst, x as usize * 3 + 2, bl as u8)
            } else {
                let luma: u32 = (r * 77 + g * 150 + bl * 29) >> 8
                if fmt == FMT_GRAY8 {
                    rt.st8(dst, x as usize, luma as u8)
                } else {
                    var v: i32 = luma as i32
                    if dither == DITHER_FLOYD {
                        v = v + vec_at[i32](&err, x as usize + 1) / 16
                    }
                    var black: bool = v < 128
                    if black {
                        let bi: usize = (x / 8) as usize
                        rt.st8(dst, bi, rt.ld8(dst, bi) | (128 as u8 >> (x % 8) as u8))
                    }
                    if dither == DITHER_FLOYD {
                        var q: i32 = 255
                        if black {
                            q = 0
                        }
                        let e: i32 = v - q
                        let xi: usize = x as usize + 1
                        vec_set[i32](&err, xi + 1, vec_at[i32](&err, xi + 1) + e * 7)
                        vec_set[i32](&next, xi - 1, vec_at[i32](&next, xi - 1) + e * 3)
                        vec_set[i32](&next, xi, vec_at[i32](&next, xi) + e * 5)
                        vec_set[i32](&next, xi + 1, vec_at[i32](&next, xi + 1) + e)
                    }
                }
            }
            x = x + 1
        }
        if dither == DITHER_FLOYD && fmt == FMT_BLACK1 {
            var j: usize = 0
            while j < ew {
                vec_set[i32](&err, j, vec_at[i32](&next, j))
                vec_set[i32](&next, j, 0)
                j = j + 1
            }
        }
        y = y + 1
    }
    vec_free[i32](&err)
    vec_free[i32](&next)
    return out
}
