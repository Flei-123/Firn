import std.rt
import std.vec
import std.str
import print.ippmsg

export {
    Caps, MediaSize, caps_new, caps_free, caps_parse, caps_list_has, caps_accepts_format,
    caps_supports_pdf, caps_supports_pwg, caps_supports_urf, caps_best_dpi, caps_media_dims,
    caps_pwg_color_types, caps_urf_has, join_value,
}

struct MediaSize {
    width: u32,
    height: u32,
}

struct Caps {
    name: str,
    info: str,
    location: str,
    make: str,
    uuid: str,
    uris: str,
    security: str,
    versions: str,
    state: u32,
    state_reasons: str,
    accepting: bool,
    color: bool,
    duplex: bool,
    formats: str,
    format_default: str,
    color_modes: str,
    sides: str,
    media: str,
    media_default: str,
    media_ready: str,
    media_sizes: Vec[MediaSize],
    scaling: str,
    qualities: str,
    orientations: str,
    operations: Vec[u32],
    resolutions: Vec[u32],
    pwg_resolutions: Vec[u32],
    pwg_types: str,
    urf: str,
    copies_max: u32,
    page_ranges: bool,
    job_attrs: str,
}

fn caps_new() -> Caps {
    return Caps { name: "", info: "", location: "", make: "", uuid: "", uris: "", security: "", versions: "",
        state: 0, state_reasons: "", accepting: false, color: false, duplex: false, formats: "", format_default: "",
        color_modes: "", sides: "", media: "", media_default: "", media_ready: "", media_sizes: vec_new[MediaSize](),
        scaling: "", qualities: "", orientations: "", operations: vec_new[u32](), resolutions: vec_new[u32](),
        pwg_resolutions: vec_new[u32](), pwg_types: "", urf: "", copies_max: 1, page_ranges: false, job_attrs: "" }
}

fn caps_free(c: *mut Caps) {
    vec_free[MediaSize](&(*c).media_sizes)
    vec_free[u32](&(*c).operations)
    vec_free[u32](&(*c).resolutions)
    vec_free[u32](&(*c).pwg_resolutions)
}

fn join_value(list: str, v: str) -> str {
    if list.n == 0 {
        return __str_copy(v)
    }
    return list + "," + v
}

fn collect_str(m: *mut ippmsg.Msg, at: usize) -> str {
    var out: str = ""
    if at == ippmsg.NONE_INDEX {
        return out
    }
    let n: usize = ippmsg.msg_value_count(m, at)
    var i: usize = at
    var k: usize = 0
    while k < n {
        out = join_value(out, ippmsg.msg_str(m, i))
        i = i + 1
        k = k + 1
    }
    return out
}

fn collect_ints(m: *mut ippmsg.Msg, at: usize, out: *mut Vec[u32]) {
    if at == ippmsg.NONE_INDEX {
        return
    }
    let n: usize = ippmsg.msg_value_count(m, at)
    var i: usize = at
    var k: usize = 0
    while k < n {
        vec_push[u32](out, ippmsg.msg_int(m, i))
        i = i + 1
        k = k + 1
    }
}

fn collect_res(m: *mut ippmsg.Msg, at: usize, out: *mut Vec[u32]) {
    if at == ippmsg.NONE_INDEX {
        return
    }
    let n: usize = ippmsg.msg_value_count(m, at)
    var i: usize = at
    var k: usize = 0
    while k < n {
        var x: u32 = 0
        var y: u32 = 0
        var u: u32 = 0
        if ippmsg.msg_resolution(m, i, &x, &y, &u) {
            vec_push[u32](out, x)
            vec_push[u32](out, y)
        }
        i = i + 1
        k = k + 1
    }
}

fn collect_sizes(m: *mut ippmsg.Msg, at: usize, out: *mut Vec[MediaSize]) {
    if at == ippmsg.NONE_INDEX {
        return
    }
    let n: usize = ippmsg.msg_value_count(m, at)
    var i: usize = at
    var k: usize = 0
    while k < n {
        if ippmsg.msg_tag(m, i) == ippmsg.V_BEG_COLLECTION {
            let xi: usize = ippmsg.msg_col_int(m, i, "x-dimension")
            let yi: usize = ippmsg.msg_col_int(m, i, "y-dimension")
            if xi != ippmsg.NONE_INDEX && yi != ippmsg.NONE_INDEX && ippmsg.msg_tag(m, xi) == ippmsg.V_INTEGER && ippmsg.msg_tag(m, yi) == ippmsg.V_INTEGER {
                vec_push[MediaSize](out, MediaSize { width: ippmsg.msg_int(m, xi), height: ippmsg.msg_int(m, yi) })
            }
            i = ippmsg.msg_col_end(m, i) + 1
        } else {
            i = i + 1
        }
        k = k + 1
    }
}

fn caps_parse(c: *mut Caps, m: *mut ippmsg.Msg, k: u32) -> bool {
    var lo: usize = 0
    var hi: usize = 0
    if !ippmsg.msg_group_find(m, ippmsg.T_PRINTER, k, &lo, &hi) {
        return false
    }
    var at: usize = ippmsg.msg_find_in(m, lo, hi, "printer-name")
    if at != ippmsg.NONE_INDEX { (*c).name = __str_copy(ippmsg.msg_str(m, at)) }
    at = ippmsg.msg_find_in(m, lo, hi, "printer-info")
    if at != ippmsg.NONE_INDEX { (*c).info = __str_copy(ippmsg.msg_str(m, at)) }
    at = ippmsg.msg_find_in(m, lo, hi, "printer-location")
    if at != ippmsg.NONE_INDEX { (*c).location = __str_copy(ippmsg.msg_str(m, at)) }
    at = ippmsg.msg_find_in(m, lo, hi, "printer-make-and-model")
    if at != ippmsg.NONE_INDEX { (*c).make = __str_copy(ippmsg.msg_str(m, at)) }
    at = ippmsg.msg_find_in(m, lo, hi, "printer-uuid")
    if at != ippmsg.NONE_INDEX { (*c).uuid = __str_copy(ippmsg.msg_str(m, at)) }
    (*c).uris = collect_str(m, ippmsg.msg_find_in(m, lo, hi, "printer-uri-supported"))
    (*c).security = collect_str(m, ippmsg.msg_find_in(m, lo, hi, "uri-security-supported"))
    (*c).versions = collect_str(m, ippmsg.msg_find_in(m, lo, hi, "ipp-versions-supported"))
    at = ippmsg.msg_find_in(m, lo, hi, "printer-state")
    if at != ippmsg.NONE_INDEX { (*c).state = ippmsg.msg_int(m, at) }
    (*c).state_reasons = collect_str(m, ippmsg.msg_find_in(m, lo, hi, "printer-state-reasons"))
    at = ippmsg.msg_find_in(m, lo, hi, "printer-is-accepting-jobs")
    if at != ippmsg.NONE_INDEX { (*c).accepting = ippmsg.msg_bool(m, at) }
    at = ippmsg.msg_find_in(m, lo, hi, "color-supported")
    if at != ippmsg.NONE_INDEX { (*c).color = ippmsg.msg_bool(m, at) }
    (*c).formats = collect_str(m, ippmsg.msg_find_in(m, lo, hi, "document-format-supported"))
    at = ippmsg.msg_find_in(m, lo, hi, "document-format-default")
    if at != ippmsg.NONE_INDEX { (*c).format_default = __str_copy(ippmsg.msg_str(m, at)) }
    (*c).color_modes = collect_str(m, ippmsg.msg_find_in(m, lo, hi, "print-color-mode-supported"))
    (*c).sides = collect_str(m, ippmsg.msg_find_in(m, lo, hi, "sides-supported"))
    (*c).duplex = caps_list_has((*c).sides, "two-sided-long-edge") || caps_list_has((*c).sides, "two-sided-short-edge")
    (*c).media = collect_str(m, ippmsg.msg_find_in(m, lo, hi, "media-supported"))
    at = ippmsg.msg_find_in(m, lo, hi, "media-default")
    if at != ippmsg.NONE_INDEX { (*c).media_default = __str_copy(ippmsg.msg_str(m, at)) }
    (*c).media_ready = collect_str(m, ippmsg.msg_find_in(m, lo, hi, "media-ready"))
    collect_sizes(m, ippmsg.msg_find_in(m, lo, hi, "media-size-supported"), &(*c).media_sizes)
    (*c).scaling = collect_str(m, ippmsg.msg_find_in(m, lo, hi, "print-scaling-supported"))
    (*c).qualities = collect_str(m, ippmsg.msg_find_in(m, lo, hi, "print-quality-supported"))
    (*c).orientations = collect_str(m, ippmsg.msg_find_in(m, lo, hi, "orientation-requested-supported"))
    collect_ints(m, ippmsg.msg_find_in(m, lo, hi, "operations-supported"), &(*c).operations)
    collect_res(m, ippmsg.msg_find_in(m, lo, hi, "printer-resolution-supported"), &(*c).resolutions)
    collect_res(m, ippmsg.msg_find_in(m, lo, hi, "pwg-raster-document-resolution-supported"), &(*c).pwg_resolutions)
    (*c).pwg_types = collect_str(m, ippmsg.msg_find_in(m, lo, hi, "pwg-raster-document-type-supported"))
    (*c).urf = collect_str(m, ippmsg.msg_find_in(m, lo, hi, "urf-supported"))
    at = ippmsg.msg_find_in(m, lo, hi, "copies-supported")
    if at != ippmsg.NONE_INDEX {
        var rl: u32 = 0
        var rh: u32 = 0
        if ippmsg.msg_range(m, at, &rl, &rh) { (*c).copies_max = rh }
    }
    (*c).job_attrs = collect_str(m, ippmsg.msg_find_in(m, lo, hi, "job-creation-attributes-supported"))
    (*c).page_ranges = caps_list_has((*c).job_attrs, "page-ranges")
    return true
}

fn caps_list_has(list: str, item: str) -> bool {
    var i: usize = 0
    while i <= list.n {
        var j: usize = i
        while j < list.n && rt.ld8(list.p as u64, j) != 44 as u8 {
            j = j + 1
        }
        if j - i == item.n && rt.mem_eq(list.p as u64 + i as u64, item.p as u64, item.n) {
            return true
        }
        i = j + 1
    }
    return false
}

fn caps_accepts_format(c: *mut Caps, mime: str) -> bool {
    return caps_list_has((*c).formats, mime)
}

fn caps_supports_pdf(c: *mut Caps) -> bool { return caps_accepts_format(c, "application/pdf") }
fn caps_supports_pwg(c: *mut Caps) -> bool { return caps_accepts_format(c, "image/pwg-raster") }
fn caps_supports_urf(c: *mut Caps) -> bool { return caps_accepts_format(c, "image/urf") }

fn caps_urf_has(c: *mut Caps, item: str) -> bool {
    return caps_list_has((*c).urf, item)
}

fn caps_pwg_color_types(c: *mut Caps) -> str { return (*c).pwg_types }

fn rs_tag(k: u32) -> str {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push(&b, 82 as u8)
    rt.buf_push(&b, 83 as u8)
    rt.buf_push_dec_u64(&b, k as u64)
    let s: str = __str_copy(rt.buf_str(&b))
    rt.buf_free(&b)
    return s
}

fn caps_best_dpi(c: *mut Caps, cap: u32) -> u32 {
    var best: u32 = 0
    var i: usize = 0
    let n: usize = vec_len[u32](&(*c).pwg_resolutions)
    while i + 1 < n {
        let x: u32 = vec_at[u32](&(*c).pwg_resolutions, i)
        let y: u32 = vec_at[u32](&(*c).pwg_resolutions, i + 1)
        if x == y && x <= cap && x > best {
            best = x
        }
        i = i + 2
    }
    if best == 0 {
        var k: u32 = 600
        while k >= 100 && best == 0 {
            let tag: str = rs_tag(k)
            if caps_urf_has(c, tag) && k <= cap {
                best = k
            }
            if k == 600 { k = 300 } else if k == 300 { k = 200 } else if k == 200 { k = 150 } else { k = 99 }
        }
    }
    return best
}

fn caps_media_dims(c: *mut Caps, w: *mut u32, h: *mut u32) -> bool {
    let n: usize = vec_len[MediaSize](&(*c).media_sizes)
    if n == 0 {
        return false
    }
    let s: *mut MediaSize = vec_elem_ptr[MediaSize](&(*c).media_sizes, 0)
    *w = (*s).width
    *h = (*s).height
    return true
}
