// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.vec
import std.str
import print.ippcaps
import print.ippclient

export {
    Found, Discoverer, Registry, registry_new, registry_free, registry_add, registry_scan, registry_count,
    found_new, found_free, cups_discoverer, uri_from_dnssd,
    SRC_CUPS, SRC_DNSSD, SRC_MANUAL,
}

const SRC_CUPS: u32 = 0
const SRC_DNSSD: u32 = 1
const SRC_MANUAL: u32 = 2

struct Found {
    name: str,
    uri: str,
    make: str,
    location: str,
    source: u32,
    uuid: str,
}

struct Discoverer {
    name: str,
    scan: fn(u64, *mut Vec[Found]) -> usize,
    ud: u64,
}

struct Registry {
    items: Vec[Discoverer],
}

fn found_new() -> Found {
    return Found { name: "", uri: "", make: "", location: "", source: SRC_MANUAL, uuid: "" }
}

fn found_free(f: *mut Found) {
}

fn registry_new() -> Registry {
    return Registry { items: vec_new[Discoverer]() }
}

fn registry_free(r: *mut Registry) {
    vec_free[Discoverer](&(*r).items)
}

fn registry_add(r: *mut Registry, d: Discoverer) {
    vec_push[Discoverer](&(*r).items, d)
}

fn registry_count(r: *mut Registry) -> usize {
    return vec_len[Discoverer](&(*r).items)
}

fn has_uri(out: *mut Vec[Found], uri: str) -> bool {
    var i: usize = 0
    let n: usize = vec_len[Found](out)
    while i < n {
        if (*vec_elem_ptr[Found](out, i)).uri == uri {
            return true
        }
        i = i + 1
    }
    return false
}

fn registry_scan(r: *mut Registry, out: *mut Vec[Found]) -> usize {
    var total: usize = 0
    var i: usize = 0
    let n: usize = vec_len[Discoverer](&(*r).items)
    while i < n {
        let d: *mut Discoverer = vec_elem_ptr[Discoverer](&(*r).items, i)
        var tmp: Vec[Found] = vec_new[Found]()
        let scan: fn(u64, *mut Vec[Found]) -> usize = (*d).scan
        scan((*d).ud, &tmp)
        var k: usize = 0
        while k < vec_len[Found](&tmp) {
            let f: *mut Found = vec_elem_ptr[Found](&tmp, k)
            if !has_uri(out, (*f).uri) {
                vec_push[Found](out, *f)
                total = total + 1
            }
            k = k + 1
        }
        vec_free[Found](&tmp)
        i = i + 1
    }
    return total
}

fn uri_from_dnssd(host: str, port: u32, rp: str, secure: bool) -> str {
    var b: rt.Buf = rt.buf_new()
    var scheme: str = "ipp://"
    if secure {
        scheme = "ipps://"
    }
    rt.buf_push_bytes(&b, scheme.p as u64, scheme.n)
    rt.buf_push_bytes(&b, host.p as u64, host.n)
    rt.buf_push(&b, 58 as u8)
    rt.buf_push_dec_u64(&b, port as u64)
    rt.buf_push(&b, 47 as u8)
    var s: usize = 0
    while s < rp.n && rt.ld8(rp.p as u64, s) == 47 as u8 {
        s = s + 1
    }
    rt.buf_push_bytes(&b, rp.p as u64 + s as u64, rp.n - s)
    let out: str = __str_copy(rt.buf_str(&b))
    rt.buf_free(&b)
    return out
}

fn scan_cups(ud: u64, out: *mut Vec[Found]) -> usize {
    var c: ippclient.Client = ippclient.client_new()
    var list: Vec[ippcaps.Caps] = vec_new[ippcaps.Caps]()
    let n: usize = ippclient.get_printers(&c, "", &list) catch | e | (0 as usize)
    var i: usize = 0
    while i < vec_len[ippcaps.Caps](&list) {
        let cp: *mut ippcaps.Caps = vec_elem_ptr[ippcaps.Caps](&list, i)
        var f: Found = found_new()
        f.name = __str_copy((*cp).name)
        f.uri = __str_copy((*cp).uris)
        f.make = __str_copy((*cp).make)
        f.location = __str_copy((*cp).location)
        f.uuid = __str_copy((*cp).uuid)
        f.source = SRC_CUPS
        vec_push[Found](out, f)
        ippcaps.caps_free(cp)
        i = i + 1
    }
    vec_free[ippcaps.Caps](&list)
    ippclient.client_free(&c)
    return n
}

fn cups_discoverer() -> Discoverer {
    return Discoverer { name: "cups", scan: scan_cups, ud: 0 }
}
