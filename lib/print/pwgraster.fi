import std.rt
import std.str
import print.bitmap
import print.rle

export { PwgPage, pwg_page_default, pwg_begin, pwg_add_page, pwg_header_size, pwg_color_space, PWG_HEADER_LEN }

const PWG_HEADER_LEN: usize = 1796

struct PwgPage {
    dpi_x: u32,
    dpi_y: u32,
    media_name: str,
    width_pt: u32,
    height_pt: u32,
    duplex: bool,
    tumble: bool,
    copies: u32,
    quality: u32,
    media_type: str,
    total_pages: u32,
}

fn pwg_page_default() -> PwgPage {
    return PwgPage { dpi_x: 300, dpi_y: 300, media_name: "", width_pt: 595, height_pt: 842, duplex: false, tumble: false,
        copies: 1, quality: 4, media_type: "", total_pages: 0 }
}

fn pwg_header_size() -> usize { return PWG_HEADER_LEN }

fn pwg_color_space(fmt: u32) -> u32 {
    if fmt == bitmap.FMT_RGB8 { return 19 as u32 }
    if fmt == bitmap.FMT_BLACK1 { return 3 as u32 }
    return 18 as u32
}

fn set32(h: u64, at: usize, v: u32) {
    rt.st8(h, at, ((v >> 24) & 255) as u8)
    rt.st8(h, at + 1, ((v >> 16) & 255) as u8)
    rt.st8(h, at + 2, ((v >> 8) & 255) as u8)
    rt.st8(h, at + 3, (v & 255) as u8)
}

fn set_text(h: u64, at: usize, s: str) {
    var n: usize = s.n
    if n > 63 {
        n = 63
    }
    rt.mem_copy(h + at as u64, s.p as u64, n)
}

fn pwg_begin(out: *mut rt.Buf) {
    let s: str = "RaS2"
    rt.buf_push_bytes(out, s.p as u64, s.n)
}

fn pwg_add_page(out: *mut rt.Buf, bm: *mut bitmap.Bitmap, pg: *mut PwgPage) {
    var hdr: rt.Buf = rt.buf_new()
    rt.buf_reserve(&hdr, PWG_HEADER_LEN + 1)
    rt.buf_set_len(&hdr, PWG_HEADER_LEN)
    let h: u64 = rt.buf_ptr(&hdr)
    rt.mem_set(h, 0 as u8, PWG_HEADER_LEN)
    set_text(h, 0, "PwgRaster")
    set_text(h, 64, "")
    set_text(h, 128, (*pg).media_type)
    set32(h, 272, 0 as u32)
    var dup: u32 = 0
    if (*pg).duplex {
        dup = 1
    }
    set32(h, 272, dup)
    set32(h, 276, (*pg).dpi_x)
    set32(h, 280, (*pg).dpi_y)
    set32(h, 340, (*pg).copies)
    set32(h, 352, (*pg).width_pt)
    set32(h, 356, (*pg).height_pt)
    var tm: u32 = 0
    if (*pg).tumble {
        tm = 1
    }
    set32(h, 368, tm)
    set32(h, 372, (*bm).w)
    set32(h, 376, (*bm).h)
    var bpc: u32 = 8
    if (*bm).fmt == bitmap.FMT_BLACK1 {
        bpc = 1
    }
    set32(h, 384, bpc)
    set32(h, 388, bitmap.bitmap_bits_per_pixel((*bm).fmt))
    set32(h, 392, (*bm).stride as u32)
    set32(h, 396, 0 as u32)
    set32(h, 400, pwg_color_space((*bm).fmt))
    var nc: u32 = 1
    if (*bm).fmt == bitmap.FMT_RGB8 {
        nc = 3
    }
    set32(h, 420, nc)
    set32(h, 452, (*pg).total_pages)
    set32(h, 456, 1 as u32)
    set32(h, 460, 1 as u32)
    set32(h, 488, (*pg).quality)
    set_text(h, 1732, (*pg).media_name)
    rt.buf_push_bytes(out, h, PWG_HEADER_LEN)
    rt.buf_free(&hdr)
    rle.rle_page(out, bm)
}
