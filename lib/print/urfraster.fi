import std.rt
import print.bitmap
import print.rle

export { urf_begin, urf_add_page, URF_PAGE_HEADER_LEN }

const URF_PAGE_HEADER_LEN: usize = 32

fn set32(h: u64, at: usize, v: u32) {
    rt.st8(h, at, ((v >> 24) & 255) as u8)
    rt.st8(h, at + 1, ((v >> 16) & 255) as u8)
    rt.st8(h, at + 2, ((v >> 8) & 255) as u8)
    rt.st8(h, at + 3, (v & 255) as u8)
}

fn urf_begin(out: *mut rt.Buf, pages: u32) {
    let s: str = "UNIRAST"
    rt.buf_push_bytes(out, s.p as u64, s.n)
    rt.buf_push(out, 0 as u8)
    var t: rt.Buf = rt.buf_new()
    var i: u32 = 0
    while i < 4 {
        rt.buf_push(&t, 0 as u8)
        i = i + 1
    }
    set32(rt.buf_ptr(&t), 0, pages)
    rt.buf_push_bytes(out, rt.buf_ptr(&t), 4)
    rt.buf_free(&t)
}

fn urf_add_page(out: *mut rt.Buf, bm: *mut bitmap.Bitmap, dpi: u32, duplex: u32, quality: u32) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_reserve(&t, URF_PAGE_HEADER_LEN + 1)
    rt.buf_set_len(&t, URF_PAGE_HEADER_LEN)
    let h: u64 = rt.buf_ptr(&t)
    rt.mem_set(h, 0 as u8, URF_PAGE_HEADER_LEN)
    rt.st8(h, 0, bitmap.bitmap_bits_per_pixel((*bm).fmt) as u8)
    var cs: u8 = 0 as u8
    if (*bm).fmt == bitmap.FMT_RGB8 {
        cs = 1 as u8
    }
    rt.st8(h, 1, cs)
    rt.st8(h, 2, duplex as u8)
    rt.st8(h, 3, quality as u8)
    set32(h, 12, (*bm).w)
    set32(h, 16, (*bm).h)
    set32(h, 20, dpi)
    rt.buf_push_bytes(out, h, URF_PAGE_HEADER_LEN)
    rt.buf_free(&t)
    rle.rle_page(out, bm)
}
