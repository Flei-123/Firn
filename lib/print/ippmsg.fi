import std.rt
import std.vec
import std.str

export {
    Msg, Attr, Group,
    msg_new, msg_free, msg_parse, msg_ok, msg_code, msg_id, msg_version,
    msg_group_count, msg_group_find, msg_attr_count, msg_attr_at,
    msg_find, msg_find_in, msg_value_count, msg_name, msg_str, msg_int, msg_bool,
    msg_tag, msg_resolution, msg_range, msg_col_int, msg_col_end, msg_depth,
    begin, group, put_str, put_more, put_int, put_more_int, put_bool, put_resolution,
    put_range, put_octets, end, put8, put16, put32,
    T_OPERATION, T_JOB, T_END, T_PRINTER, T_UNSUPPORTED, T_SUBSCRIPTION, T_EVENT, T_DOCUMENT,
    V_OUT_OF_BAND, V_INTEGER, V_BOOLEAN, V_ENUM, V_OCTETS, V_DATETIME, V_RESOLUTION, V_RANGE,
    V_BEG_COLLECTION, V_TEXT_LANG, V_NAME_LANG, V_END_COLLECTION, V_TEXT, V_NAME,
    V_KEYWORD, V_URI, V_URI_SCHEME, V_CHARSET, V_LANGUAGE, V_MIME, V_MEMBER_NAME,
    OP_PRINT_JOB, OP_VALIDATE_JOB, OP_CREATE_JOB, OP_SEND_DOCUMENT, OP_CANCEL_JOB,
    OP_GET_JOB_ATTRIBUTES, OP_GET_JOBS, OP_GET_PRINTER_ATTRIBUTES, OP_HOLD_JOB,
    OP_RELEASE_JOB, OP_PAUSE_PRINTER, OP_RESUME_PRINTER, OP_IDENTIFY_PRINTER,
    OP_CUPS_GET_DEFAULT, OP_CUPS_GET_PRINTERS,
    ST_OK, ST_BAD_REQUEST, ST_FORBIDDEN, ST_NOT_AUTHENTICATED, ST_NOT_AUTHORIZED,
    ST_NOT_POSSIBLE, ST_TIMEOUT, ST_NOT_FOUND, ST_GONE, ST_FORMAT_UNSUPPORTED,
    ST_ATTRIBUTES_UNSUPPORTED, ST_BUSY, ST_NOT_ACCEPTING, ST_INTERNAL, ST_OP_UNSUPPORTED,
    NONE_INDEX,
}

const T_OPERATION: u8 = 1
const T_JOB: u8 = 2
const T_END: u8 = 3
const T_PRINTER: u8 = 4
const T_UNSUPPORTED: u8 = 5
const T_SUBSCRIPTION: u8 = 6
const T_EVENT: u8 = 7
const T_DOCUMENT: u8 = 9

const V_OUT_OF_BAND: u8 = 16
const V_INTEGER: u8 = 33
const V_BOOLEAN: u8 = 34
const V_ENUM: u8 = 35
const V_OCTETS: u8 = 48
const V_DATETIME: u8 = 49
const V_RESOLUTION: u8 = 50
const V_RANGE: u8 = 51
const V_BEG_COLLECTION: u8 = 52
const V_TEXT_LANG: u8 = 53
const V_NAME_LANG: u8 = 54
const V_END_COLLECTION: u8 = 55
const V_TEXT: u8 = 65
const V_NAME: u8 = 66
const V_KEYWORD: u8 = 68
const V_URI: u8 = 69
const V_URI_SCHEME: u8 = 70
const V_CHARSET: u8 = 71
const V_LANGUAGE: u8 = 72
const V_MIME: u8 = 73
const V_MEMBER_NAME: u8 = 74

const OP_PRINT_JOB: u32 = 2
const OP_VALIDATE_JOB: u32 = 4
const OP_CREATE_JOB: u32 = 5
const OP_SEND_DOCUMENT: u32 = 6
const OP_CANCEL_JOB: u32 = 8
const OP_GET_JOB_ATTRIBUTES: u32 = 9
const OP_GET_JOBS: u32 = 10
const OP_GET_PRINTER_ATTRIBUTES: u32 = 11
const OP_HOLD_JOB: u32 = 12
const OP_RELEASE_JOB: u32 = 13
const OP_PAUSE_PRINTER: u32 = 16
const OP_RESUME_PRINTER: u32 = 17
const OP_IDENTIFY_PRINTER: u32 = 60
const OP_CUPS_GET_DEFAULT: u32 = 16385
const OP_CUPS_GET_PRINTERS: u32 = 16386

const ST_OK: u32 = 0
const ST_BAD_REQUEST: u32 = 1024
const ST_FORBIDDEN: u32 = 1025
const ST_NOT_AUTHENTICATED: u32 = 1026
const ST_NOT_AUTHORIZED: u32 = 1027
const ST_NOT_POSSIBLE: u32 = 1028
const ST_TIMEOUT: u32 = 1029
const ST_NOT_FOUND: u32 = 1030
const ST_GONE: u32 = 1031
const ST_FORMAT_UNSUPPORTED: u32 = 1034
const ST_ATTRIBUTES_UNSUPPORTED: u32 = 1035
const ST_OP_UNSUPPORTED: u32 = 1280
const ST_INTERNAL: u32 = 1280 + 1
const ST_BUSY: u32 = 1282
const ST_NOT_ACCEPTING: u32 = 1290

const NONE_INDEX: usize = 4294967295

struct Attr {
    group: u32,
    tag: u8,
    more: bool,
    depth: u32,
    name_at: u32,
    name_len: u32,
    val_at: u32,
    val_len: u32,
}

struct Group {
    tag: u8,
    lo: u32,
    hi: u32,
}

struct Msg {
    data: rt.Buf,
    attrs: Vec[Attr],
    groups: Vec[Group],
    version: u32,
    code: u32,
    id: u32,
    ok: bool,
}

fn put8(b: *mut rt.Buf, v: u32) {
    rt.buf_push(b, (v & 255) as u8)
}

fn put16(b: *mut rt.Buf, v: u32) {
    put8(b, v >> 8)
    put8(b, v)
}

fn put32(b: *mut rt.Buf, v: u32) {
    put16(b, v >> 16)
    put16(b, v & 65535)
}

fn begin(b: *mut rt.Buf, version: u32, code: u32, id: u32) {
    put16(b, version)
    put16(b, code)
    put32(b, id)
}

fn group(b: *mut rt.Buf, tag: u8) {
    put8(b, tag as u32)
}

fn end(b: *mut rt.Buf) {
    put8(b, T_END as u32)
}

fn head(b: *mut rt.Buf, tag: u8, name: str) {
    put8(b, tag as u32)
    put16(b, name.n as u32)
    rt.buf_push_bytes(b, name.p as u64, name.n)
}

fn put_str(b: *mut rt.Buf, tag: u8, name: str, value: str) {
    head(b, tag, name)
    put16(b, value.n as u32)
    rt.buf_push_bytes(b, value.p as u64, value.n)
}

fn put_more(b: *mut rt.Buf, tag: u8, value: str) {
    put_str(b, tag, "", value)
}

fn put_octets(b: *mut rt.Buf, tag: u8, name: str, p: u64, n: usize) {
    head(b, tag, name)
    put16(b, n as u32)
    rt.buf_push_bytes(b, p, n)
}

fn put_int(b: *mut rt.Buf, tag: u8, name: str, v: u32) {
    head(b, tag, name)
    put16(b, 4 as u32)
    put32(b, v)
}

fn put_more_int(b: *mut rt.Buf, tag: u8, v: u32) {
    put_int(b, tag, "", v)
}

fn put_bool(b: *mut rt.Buf, name: str, v: bool) {
    head(b, V_BOOLEAN, name)
    put16(b, 1 as u32)
    if v {
        put8(b, 1 as u32)
    } else {
        put8(b, 0 as u32)
    }
}

fn put_resolution(b: *mut rt.Buf, name: str, x: u32, y: u32, units: u32) {
    head(b, V_RESOLUTION, name)
    put16(b, 9 as u32)
    put32(b, x)
    put32(b, y)
    put8(b, units)
}

fn put_range(b: *mut rt.Buf, name: str, lo: u32, hi: u32) {
    head(b, V_RANGE, name)
    put16(b, 8 as u32)
    put32(b, lo)
    put32(b, hi)
}

fn msg_new() -> Msg {
    return Msg { data: rt.buf_new(), attrs: vec_new[Attr](), groups: vec_new[Group](), version: 0, code: 0, id: 0, ok: false }
}

fn msg_free(m: *mut Msg) {
    rt.buf_free(&(*m).data)
    vec_free[Attr](&(*m).attrs)
    vec_free[Group](&(*m).groups)
}

fn msg_ok(m: *mut Msg) -> bool { return (*m).ok }
fn msg_code(m: *mut Msg) -> u32 { return (*m).code }
fn msg_id(m: *mut Msg) -> u32 { return (*m).id }
fn msg_version(m: *mut Msg) -> u32 { return (*m).version }
fn msg_group_count(m: *mut Msg) -> usize { return vec_len[Group](&(*m).groups) }
fn msg_attr_count(m: *mut Msg) -> usize { return vec_len[Attr](&(*m).attrs) }

fn u16_at(p: u64, n: usize, i: usize, bad: *mut bool) -> u32 {
    if i + 2 > n {
        *bad = true
        return 0 as u32
    }
    return (rt.ld8(p, i) as u32 << 8) | rt.ld8(p, i + 1) as u32
}

fn close_group(m: *mut Msg, open: *mut bool) {
    if *open {
        let g: *mut Group = vec_elem_ptr[Group](&(*m).groups, vec_len[Group](&(*m).groups) - 1)
        (*g).hi = vec_len[Attr](&(*m).attrs) as u32
    }
}

fn msg_parse(m: *mut Msg, p: u64, n: usize) -> bool {
    rt.buf_clear(&(*m).data)
    vec_clear[Attr](&(*m).attrs)
    vec_clear[Group](&(*m).groups)
    (*m).ok = false
    if n < 9 {
        return false
    }
    rt.buf_push_bytes(&(*m).data, p, n)
    let d: u64 = rt.buf_ptr(&(*m).data)
    var bad: bool = false
    (*m).version = u16_at(d, n, 0, &bad)
    (*m).code = u16_at(d, n, 2, &bad)
    (*m).id = (u16_at(d, n, 4, &bad) << 16) | u16_at(d, n, 6, &bad)
    var i: usize = 8
    var gidx: u32 = 0
    var open: bool = false
    var depth: u32 = 0
    var top_at: u32 = 0
    var top_len: u32 = 0
    var mem_at: u32 = 0
    var mem_len: u32 = 0
    var fresh: bool = false
    var finished: bool = false
    while i < n && !finished {
        let t: u8 = rt.ld8(d, i)
        if t == T_END {
            close_group(m, &open)
            open = false
            finished = true
            i = i + 1
            continue
        }
        if t < 16 as u8 {
            close_group(m, &open)
            vec_push[Group](&(*m).groups, Group { tag: t, lo: vec_len[Attr](&(*m).attrs) as u32, hi: 0 })
            open = true
            gidx = gidx + 1
            depth = 0
            i = i + 1
            continue
        }
        if !open {
            return false
        }
        let nl: usize = u16_at(d, n, i + 1, &bad) as usize
        if bad || i + 3 + nl > n {
            return false
        }
        let vl: usize = u16_at(d, n, i + 3 + nl, &bad) as usize
        let vs: usize = i + 5 + nl
        if bad || vs + vl > n {
            return false
        }
        if t == V_END_COLLECTION {
            if depth == 0 {
                return false
            }
            depth = depth - 1
        }
        if t == V_MEMBER_NAME {
            mem_at = vs as u32
            mem_len = vl as u32
            fresh = true
        } else {
            var more: bool = false
            var name_at: u32 = (i + 3) as u32
            var name_len: u32 = nl as u32
            if depth == 0 {
                if nl == 0 {
                    more = true
                    name_at = top_at
                    name_len = top_len
                } else {
                    top_at = name_at
                    top_len = name_len
                }
            } else {
                name_at = mem_at
                name_len = mem_len
                more = !fresh
                fresh = false
            }
            vec_push[Attr](&(*m).attrs, Attr { group: gidx, tag: t, more: more, depth: depth, name_at: name_at, name_len: name_len, val_at: vs as u32, val_len: vl as u32 })
        }
        if t == V_BEG_COLLECTION {
            depth = depth + 1
        }
        i = vs + vl
    }
    if !finished || bad || depth != 0 {
        return false
    }
    (*m).ok = true
    return true
}

fn msg_group_find(m: *mut Msg, tag: u8, k: u32, lo: *mut usize, hi: *mut usize) -> bool {
    var seen: u32 = 0
    var i: usize = 0
    let n: usize = vec_len[Group](&(*m).groups)
    while i < n {
        let g: *mut Group = vec_elem_ptr[Group](&(*m).groups, i)
        if (*g).tag == tag {
            if seen == k {
                *lo = (*g).lo as usize
                *hi = (*g).hi as usize
                return true
            }
            seen = seen + 1
        }
        i = i + 1
    }
    return false
}

fn msg_attr_at(m: *mut Msg, i: usize) -> *mut Attr {
    return vec_elem_ptr[Attr](&(*m).attrs, i)
}

fn msg_name(m: *mut Msg, i: usize) -> str {
    let a: *mut Attr = msg_attr_at(m, i)
    return str { p: rt.ptr_of(rt.buf_ptr(&(*m).data) + (*a).name_at as u64), n: (*a).name_len as usize }
}

fn msg_str(m: *mut Msg, i: usize) -> str {
    let a: *mut Attr = msg_attr_at(m, i)
    return str { p: rt.ptr_of(rt.buf_ptr(&(*m).data) + (*a).val_at as u64), n: (*a).val_len as usize }
}

fn msg_tag(m: *mut Msg, i: usize) -> u8 { return (*msg_attr_at(m, i)).tag }
fn msg_depth(m: *mut Msg, i: usize) -> u32 { return (*msg_attr_at(m, i)).depth }

fn be32(p: u64, at: usize) -> u32 {
    return (rt.ld8(p, at) as u32 << 24) | (rt.ld8(p, at + 1) as u32 << 16) | (rt.ld8(p, at + 2) as u32 << 8) | rt.ld8(p, at + 3) as u32
}

fn msg_int(m: *mut Msg, i: usize) -> u32 {
    let s: str = msg_str(m, i)
    if s.n != 4 {
        return 0 as u32
    }
    return be32(s.p as u64, 0)
}

fn msg_bool(m: *mut Msg, i: usize) -> bool {
    let s: str = msg_str(m, i)
    return s.n == 1 && rt.ld8(s.p as u64, 0) != 0 as u8
}

fn msg_resolution(m: *mut Msg, i: usize, x: *mut u32, y: *mut u32, units: *mut u32) -> bool {
    let s: str = msg_str(m, i)
    if s.n != 9 {
        return false
    }
    *x = be32(s.p as u64, 0)
    *y = be32(s.p as u64, 4)
    *units = rt.ld8(s.p as u64, 8) as u32
    return true
}

fn msg_range(m: *mut Msg, i: usize, lo: *mut u32, hi: *mut u32) -> bool {
    let s: str = msg_str(m, i)
    if s.n != 8 {
        return false
    }
    *lo = be32(s.p as u64, 0)
    *hi = be32(s.p as u64, 4)
    return true
}

fn msg_find_in(m: *mut Msg, lo: usize, hi: usize, name: str) -> usize {
    var i: usize = lo
    while i < hi {
        let a: *mut Attr = msg_attr_at(m, i)
        if (*a).depth == 0 && !(*a).more && (*a).name_len as usize == name.n {
            if rt.mem_eq(rt.buf_ptr(&(*m).data) + (*a).name_at as u64, name.p as u64, name.n) {
                return i
            }
        }
        i = i + 1
    }
    return NONE_INDEX
}

fn msg_find(m: *mut Msg, tag: u8, k: u32, name: str) -> usize {
    var lo: usize = 0
    var hi: usize = 0
    if !msg_group_find(m, tag, k, &lo, &hi) {
        return NONE_INDEX
    }
    return msg_find_in(m, lo, hi, name)
}

fn msg_col_end(m: *mut Msg, begin_at: usize) -> usize {
    let total: usize = msg_attr_count(m)
    let d0: u32 = (*msg_attr_at(m, begin_at)).depth
    var i: usize = begin_at + 1
    while i < total {
        let a: *mut Attr = msg_attr_at(m, i)
        if (*a).tag == V_END_COLLECTION && (*a).depth == d0 {
            return i
        }
        i = i + 1
    }
    return total
}

fn msg_value_count(m: *mut Msg, at: usize) -> usize {
    let total: usize = msg_attr_count(m)
    let d0: u32 = (*msg_attr_at(m, at)).depth
    var c: usize = 1
    var i: usize = at + 1
    if (*msg_attr_at(m, at)).tag == V_BEG_COLLECTION {
        i = msg_col_end(m, at) + 1
    }
    while i < total {
        let a: *mut Attr = msg_attr_at(m, i)
        if !(*a).more || (*a).depth != d0 {
            return c
        }
        c = c + 1
        if (*a).tag == V_BEG_COLLECTION {
            i = msg_col_end(m, i) + 1
        } else {
            i = i + 1
        }
    }
    return c
}

fn msg_col_int(m: *mut Msg, begin_at: usize, name: str) -> usize {
    let stop: usize = msg_col_end(m, begin_at)
    let d1: u32 = (*msg_attr_at(m, begin_at)).depth + 1
    var i: usize = begin_at + 1
    while i < stop {
        let a: *mut Attr = msg_attr_at(m, i)
        if (*a).depth == d1 && (*a).name_len as usize == name.n {
            if rt.mem_eq(rt.buf_ptr(&(*m).data) + (*a).name_at as u64, name.p as u64, name.n) {
                return i
            }
        }
        i = i + 1
    }
    return NONE_INDEX
}
