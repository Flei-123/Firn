import std.rt
import std.str
import std.fs
import appkit.platform
import services.svc

export { os_store_get, os_store_set, os_store_remove }

fn key_path(key: str, out: *mut rt.Buf) -> bool {
    if !platform.plat_dir(platform.DIR_DATA, svc.app_name(), "", out) {
        return false
    }
    let sub: str = "/services"
    rt.buf_push_bytes(out, sub.p as u64, sub.length())
    let made: bool = fs.mkdir_all(rt.buf_str(out)) catch false
    if !made && !fs.is_dir(rt.buf_str(out)) {
        return false
    }
    rt.buf_push(out, 47 as u8)
    rt.buf_push_bytes(out, key.p as u64, key.length())
    return true
}

fn os_store_get(key: str, out: *mut rt.Buf) -> i32 {
    var path: rt.Buf = rt.buf_new()
    var s: i32 = svc.FAILED
    if key_path(key, &path) {
        s = read_value(rt.buf_str(&path), out)
    }
    rt.buf_free(&path)
    return s
}

fn read_value(path: str, out: *mut rt.Buf) -> i32 {
    if !fs.is_file(path) {
        return svc.NOT_FOUND
    }
    var data: rt.Buf = rt.buf_new()
    let got: usize = fs.read_file(path, &data) catch 4294967295
    var s: i32 = svc.FAILED
    if got != 4294967295 {
        rt.buf_push_bytes(out, rt.buf_ptr(&data), rt.buf_len(&data))
        s = svc.OK
    }
    rt.buf_free(&data)
    return s
}

fn os_store_set(key: str, value: str) -> i32 {
    var path: rt.Buf = rt.buf_new()
    var s: i32 = svc.FAILED
    if key_path(key, &path) {
        let done: bool = fs.write_atomic(rt.buf_str(&path), value.p as u64, value.length()) catch false
        if done {
            s = svc.OK
        }
    }
    rt.buf_free(&path)
    return s
}

fn os_store_remove(key: str) -> i32 {
    var path: rt.Buf = rt.buf_new()
    var s: i32 = svc.FAILED
    if key_path(key, &path) {
        s = svc.OK
        if fs.is_file(rt.buf_str(&path)) {
            let done: bool = fs.remove(rt.buf_str(&path)) catch false
            if !done {
                s = svc.FAILED
            }
        }
    }
    rt.buf_free(&path)
    return s
}
