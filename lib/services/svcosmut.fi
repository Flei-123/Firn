import std.rt
import std.str
import std.fs
import services.svc

export { os_make_dir, os_rename, os_remove }

const ERRNO_PERM: i64 = 1
const ERRNO_NOENT: i64 = 2
const ERRNO_ACCESS: i64 = 13
const ERRNO_EXIST: i64 = 17
const ERRNO_NOTDIR: i64 = 20
const ERRNO_NOTEMPTY: i64 = 39

fn errno_status(en: i64) -> i32 {
    if en == ERRNO_ACCESS || en == ERRNO_PERM { return svc.DENIED }
    if en == ERRNO_NOTDIR { return svc.NOT_DIR }
    if en == ERRNO_NOENT { return svc.NOT_FOUND }
    if en == ERRNO_EXIST { return svc.EXISTS }
    if en == ERRNO_NOTEMPTY { return svc.NOT_EMPTY }
    return svc.FAILED
}

fn os_make_dir(path: str) -> i32 {
    let ok: bool = fs.mkdir(path) catch false
    if ok { return svc.OK }
    return errno_status(fs.last_errno())
}

fn os_rename(from: str, to: str) -> i32 {
    if fs.exists(to) { return svc.EXISTS }
    let ok: bool = fs.rename(from, to) catch false
    if ok { return svc.OK }
    return errno_status(fs.last_errno())
}

fn os_remove(path: str) -> i32 {
    let ok: bool = fs.remove(path) catch false
    if ok { return svc.OK }
    return errno_status(fs.last_errno())
}
