import std.str
import std.dialog
import services.svc
import services.svcos

export {
    message, confirm,
    KIND_INFO, KIND_QUESTION, KIND_WARNING, KIND_ERROR,
    BTNS_OK, BTNS_OK_CANCEL, BTNS_YES_NO, BTNS_YES_NO_CANCEL,
    ANS_OK, ANS_CANCEL, ANS_YES, ANS_NO,
}

const KIND_INFO: i32 = dialog.KIND_INFO
const KIND_QUESTION: i32 = dialog.KIND_QUESTION
const KIND_WARNING: i32 = dialog.KIND_WARNING
const KIND_ERROR: i32 = dialog.KIND_ERROR
const BTNS_OK: i32 = dialog.BTNS_OK
const BTNS_OK_CANCEL: i32 = dialog.BTNS_OK_CANCEL
const BTNS_YES_NO: i32 = dialog.BTNS_YES_NO
const BTNS_YES_NO_CANCEL: i32 = dialog.BTNS_YES_NO_CANCEL
const ANS_OK: i32 = dialog.ANS_OK
const ANS_CANCEL: i32 = dialog.ANS_CANCEL
const ANS_YES: i32 = dialog.ANS_YES
const ANS_NO: i32 = dialog.ANS_NO

fn message(kind: i32, title: str, text: str, buttons: i32, answer: *mut i32) -> i32 {
    if kind < KIND_INFO || kind > KIND_ERROR || buttons < BTNS_OK || buttons > BTNS_YES_NO_CANCEL {
        return svc.INVALID
    }
    return svcos.os_message(kind, title, text, buttons, answer)
}

fn confirm(title: str, text: str, yes: *mut bool) -> i32 {
    return svcos.os_confirm(title, text, yes)
}
