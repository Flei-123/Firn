import std.rt
import std.str
import services.svc
import services.svcosdir

export { DirEntry, entry_new, list, pick, next_entry, push_entry }

const HEAD: usize = 19
const FLAG_DIR: u8 = 1
const FLAG_LINK: u8 = 2
const FLAG_BROKEN: u8 = 4
const NAME_LIMIT: usize = 65535
const PATH_LIMIT: usize = 4096

struct DirEntry {
    name: str,
    is_dir: bool,
    is_link: bool,
    broken: bool,
    size: u64,
    mtime_ns: i64,
}

fn entry_new() -> DirEntry {
    return DirEntry { name: "", is_dir: false, is_link: false, broken: false, size: 0 as u64, mtime_ns: 0, }
}

fn list(path: str, out: *mut rt.Buf) -> i32 {
    if path.length() == 0 || path.length() > PATH_LIMIT {
        return svc.INVALID
    }
    return svcosdir.os_dir_list(path, out)
}

fn pick(id: *mut u32) -> i32 {
    *id = 0 as u32
    return svcosdir.os_dir_pick(id)
}

fn push_le(out: *mut rt.Buf, v: u64, count: usize) {
    var i: usize = 0
    while i < count {
        rt.buf_push(out, ((v >> (8 * i as u64)) & 255 as u64) as u8)
        i = i + 1
    }
}

fn read_le(p: u64, at: usize, count: usize) -> u64 {
    var v: u64 = 0 as u64
    var i: usize = 0
    while i < count {
        v = v | ((rt.ld8(p, at + i) as u64) << (8 * i as u64))
        i = i + 1
    }
    return v
}

fn push_entry(out: *mut rt.Buf, e: *mut DirEntry) -> bool {
    if (*e).name.length() == 0 || (*e).name.length() > NAME_LIMIT {
        return false
    }
    var flags: u8 = 0 as u8
    if (*e).is_dir { flags = flags | FLAG_DIR }
    if (*e).is_link { flags = flags | FLAG_LINK }
    if (*e).broken { flags = flags | FLAG_BROKEN }
    rt.buf_push(out, flags)
    push_le(out, (*e).size, 8)
    push_le(out, (*e).mtime_ns as u64, 8)
    push_le(out, (*e).name.length() as u64, 2)
    rt.buf_push_bytes(out, (*e).name.p as u64, (*e).name.length())
    return true
}

fn next_entry(buf: *mut rt.Buf, pos: *mut usize, e: *mut DirEntry) -> bool {
    let total: usize = rt.buf_len(buf)
    if *pos + HEAD > total {
        return false
    }
    let base: u64 = rt.buf_ptr(buf)
    let at: usize = *pos
    let flags: u8 = rt.ld8(base, at)
    let n: usize = read_le(base, at + 17, 2) as usize
    if at + HEAD + n > total {
        return false
    }
    (*e).is_dir = (flags & FLAG_DIR) != 0 as u8
    (*e).is_link = (flags & FLAG_LINK) != 0 as u8
    (*e).broken = (flags & FLAG_BROKEN) != 0 as u8
    (*e).size = read_le(base, at + 1, 8)
    (*e).mtime_ns = read_le(base, at + 9, 8) as i64
    (*e).name = str { p: (base + (at + HEAD) as u64) as *mut u8, n: n }
    *pos = at + HEAD + n
    return true
}
