import std.rt
import std.str
import services.svc
import services.svcosmut

export { make_dir, rename, remove, valid_name }

const PATH_LIMIT: usize = 4096
const SLASH: u8 = 47
const NUL: u8 = 0
const NAME_LIMIT: usize = 255

fn valid_path(path: str) -> bool {
    if path.length() == 0 || path.length() > PATH_LIMIT {
        return false
    }
    var i: usize = 0
    while i < path.length() {
        if path.chars(i) == NUL {
            return false
        }
        i = i + 1
    }
    return true
}

fn valid_name(name: str) -> bool {
    if name.length() == 0 || name.length() > NAME_LIMIT {
        return false
    }
    if name == "." || name == ".." {
        return false
    }
    var i: usize = 0
    while i < name.length() {
        if name.chars(i) == SLASH || name.chars(i) == NUL {
            return false
        }
        i = i + 1
    }
    return true
}

fn make_dir(path: str) -> i32 {
    if !valid_path(path) {
        return svc.INVALID
    }
    return svcosmut.os_make_dir(path)
}

fn rename(from: str, to: str) -> i32 {
    if !valid_path(from) || !valid_path(to) {
        return svc.INVALID
    }
    return svcosmut.os_rename(from, to)
}

fn remove(path: str) -> i32 {
    if !valid_path(path) {
        return svc.INVALID
    }
    return svcosmut.os_remove(path)
}
