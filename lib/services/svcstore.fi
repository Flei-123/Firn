import std.rt
import std.str
import services.svc
import services.svcosstore

export { get, set, remove, has, VALUE_MAX }

const VALUE_MAX: usize = 65536

fn get(key: str, out: *mut rt.Buf) -> i32 {
    if !svc.valid_name(key) {
        return svc.INVALID
    }
    return svcosstore.os_store_get(key, out)
}

fn set(key: str, value: str) -> i32 {
    if !svc.valid_name(key) || value.length() > VALUE_MAX {
        return svc.INVALID
    }
    if value.length() == 0 {
        return svcosstore.os_store_remove(key)
    }
    return svcosstore.os_store_set(key, value)
}

fn remove(key: str) -> i32 {
    if !svc.valid_name(key) {
        return svc.INVALID
    }
    return svcosstore.os_store_remove(key)
}

fn has(key: str) -> bool {
    var out: rt.Buf = rt.buf_new()
    let s: i32 = get(key, &out)
    rt.buf_free(&out)
    return s == svc.OK
}
