import std.str
import services.svc
import services.svcos

export { open, save }

fn open(accept: str, multiple: bool, id: *mut u32) -> i32 {
    *id = 0 as u32
    return svcos.os_file_open(accept, multiple, id)
}

fn save(name: str, mime: str, p: u64, n: usize) -> i32 {
    if name.length() == 0 || (p == 0 && n > 0) {
        return svc.INVALID
    }
    return svcos.os_file_save(name, mime, p, n)
}
