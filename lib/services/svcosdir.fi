// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.str
import std.fs
import std.dir
import services.svc
import services.svcdir

export { os_dir_list }

const ERRNO_PERM: i64 = 1
const ERRNO_NOENT: i64 = 2
const ERRNO_ACCESS: i64 = 13
const ERRNO_NOTDIR: i64 = 20
const KIND_UNSET: u8 = 255

fn errno_status(en: i64) -> i32 {
    if en == ERRNO_ACCESS || en == ERRNO_PERM {
        return svc.DENIED
    }
    if en == ERRNO_NOTDIR {
        return svc.NOT_DIR
    }
    if en == ERRNO_NOENT {
        return svc.NOT_FOUND
    }
    return svc.FAILED
}

fn stat_or_unset(path: str) -> fs.FileInfo {
    return fs.stat(path) catch fs.FileInfo { kind: KIND_UNSET, mode: 0 as u32, size: 0, mtime_ns: 0 }
}

fn join(dirpath: str, name: str, out: *mut rt.Buf) {
    rt.buf_clear(out)
    rt.buf_push_bytes(out, dirpath.p as u64, dirpath.length())
    if !(dirpath.length() == 1 && rt.ld8(dirpath.p as u64, 0) == 47 as u8) {
        rt.buf_push(out, 47 as u8)
    }
    rt.buf_push_bytes(out, name.p as u64, name.length())
}

fn fill_entry(d: *mut dir.Dir, full: str, e: *mut svcdir.DirEntry) {
    (*e).name = (*d).name
    (*e).is_link = (*d).kind == dir.KIND_LINK
    (*e).is_dir = (*d).kind == dir.KIND_DIR
    (*e).broken = false
    (*e).size = 0 as u64
    (*e).mtime_ns = 0
    let known: bool = (*d).kind == dir.KIND_LINK || (*d).kind == dir.KIND_UNKNOWN || (*d).kind == dir.KIND_FILE || (*d).kind == dir.KIND_DIR
    if !known {
        return
    }
    let st: fs.FileInfo = stat_or_unset(full)
    if st.kind == KIND_UNSET {
        (*e).broken = (*e).is_link
        return
    }
    (*e).is_dir = st.kind == fs.KIND_DIR
    (*e).size = st.size
    (*e).mtime_ns = st.mtime_ns
}

fn append_all(d: *mut dir.Dir, path: str, out: *mut rt.Buf) {
    var full: rt.Buf = rt.buf_new()
    var e: svcdir.DirEntry = svcdir.entry_new()
    while dir.next(d) {
        join(path, (*d).name, &full)
        fill_entry(d, rt.buf_str(&full), &e)
        svcdir.push_entry(out, &e)
    }
    rt.buf_free(&full)
}

fn os_dir_list(path: str, out: *mut rt.Buf) -> i32 {
    let info: fs.FileInfo = stat_or_unset(path)
    if info.kind == KIND_UNSET {
        return errno_status(fs.last_errno())
    }
    if info.kind != fs.KIND_DIR {
        return svc.NOT_DIR
    }
    var d: dir.Dir = dir.open(path)
    if !dir.is_open(&d) {
        let code: i64 = 0 - d.fd
        dir.close(&d)
        return errno_status(code)
    }
    append_all(&d, path, out)
    dir.close(&d)
    return svc.OK
}
