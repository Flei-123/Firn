// SPDX-License-Identifier: MPL-2.0
import std.rt
import mdns.mdns_wire

export {
    Cache, NONE, cache_new, cache_free, cache_put, cache_expire, cache_find,
    cache_count, cache_name, cache_nlen, cache_typ, cache_data, cache_dlen,
    cache_ttl, cache_remaining, cache_clear,
}

const NAME_CAP: usize = 256
const DATA_CAP: usize = 1024
const META: usize = 8
const M_NLEN: usize = 0
const M_DLEN: usize = 1
const M_TYP: usize = 2
const M_CLASS: usize = 3
const M_TTL: usize = 4
const M_EXPIRE: usize = 5
const M_BORN: usize = 6
const M_USED: usize = 7
const NONE: usize = 4294967295
const GOODBYE_MS: u64 = 1000

struct Cache {
    cap: usize,
    names: u64,
    data: u64,
    meta: u64,
}

fn cache_new(cap: usize) -> Cache {
    return Cache { cap: cap, names: rt.heap_alloc(cap * NAME_CAP), data: rt.heap_alloc(cap * DATA_CAP),
        meta: rt.heap_alloc(cap * META * 8) }
}

fn cache_free(c: *mut Cache) {
    rt.heap_free((*c).names, (*c).cap * NAME_CAP)
    rt.heap_free((*c).data, (*c).cap * DATA_CAP)
    rt.heap_free((*c).meta, (*c).cap * META * 8)
    (*c).cap = 0
}

fn m_get(c: *mut Cache, i: usize, f: usize) -> u64 {
    return rt.ld64((*c).meta, i * META + f)
}

fn m_set(c: *mut Cache, i: usize, f: usize, v: u64) {
    rt.st64((*c).meta, i * META + f, v)
}

fn cache_clear(c: *mut Cache) {
    rt.mem_set((*c).meta, 0 as u8, (*c).cap * META * 8)
}

fn cache_name(c: *mut Cache, i: usize) -> u64 {
    return (*c).names + (i * NAME_CAP) as u64
}

fn cache_data(c: *mut Cache, i: usize) -> u64 {
    return (*c).data + (i * DATA_CAP) as u64
}

fn cache_nlen(c: *mut Cache, i: usize) -> usize {
    return m_get(c, i, M_NLEN) as usize
}

fn cache_dlen(c: *mut Cache, i: usize) -> usize {
    return m_get(c, i, M_DLEN) as usize
}

fn cache_typ(c: *mut Cache, i: usize) -> u32 {
    return m_get(c, i, M_TYP) as u32
}

fn cache_ttl(c: *mut Cache, i: usize) -> u32 {
    return m_get(c, i, M_TTL) as u32
}

fn cache_remaining(c: *mut Cache, i: usize, now: u64) -> u32 {
    let e: u64 = m_get(c, i, M_EXPIRE)
    if e <= now {
        return 0 as u32
    }
    return ((e - now + 999 as u64) / 1000 as u64) as u32
}

fn live(c: *mut Cache, i: usize, now: u64) -> bool {
    return m_get(c, i, M_USED) != 0 as u64 && m_get(c, i, M_EXPIRE) > now
}

fn cache_count(c: *mut Cache, now: u64) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < (*c).cap {
        if live(c, i, now) {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn cache_expire(c: *mut Cache, now: u64) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < (*c).cap {
        if m_get(c, i, M_USED) != 0 as u64 && m_get(c, i, M_EXPIRE) <= now {
            m_set(c, i, M_USED, 0 as u64)
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn same_key(c: *mut Cache, i: usize, name: u64, nlen: usize, typ: u32, class: u32) -> bool {
    return cache_nlen(c, i) == nlen && cache_typ(c, i) == typ && m_get(c, i, M_CLASS) == class as u64
        && mdns_wire.wname_eq(cache_name(c, i), nlen, name, nlen)
}

fn cache_put(c: *mut Cache, name: u64, nlen: usize, typ: u32, class: u32, ttl: u32,
    data: u64, dlen: usize, flush: bool, now: u64) -> u32 {
    if nlen > NAME_CAP || dlen > DATA_CAP {
        return 0 as u32
    }
    var same: usize = NONE
    var free_slot: usize = NONE
    var oldest: usize = 0
    var oldest_exp: u64 = 18446744073709551615
    var i: usize = 0
    while i < (*c).cap {
        if m_get(c, i, M_USED) == 0 as u64 || m_get(c, i, M_EXPIRE) <= now {
            if free_slot == NONE {
                free_slot = i
            }
        } else {
            if same_key(c, i, name, nlen, typ, class) {
                let eq: bool = cache_dlen(c, i) == dlen && rt.mem_eq(cache_data(c, i), data, dlen)
                if eq {
                    same = i
                } else if flush && m_get(c, i, M_BORN) + GOODBYE_MS <= now
                    && m_get(c, i, M_EXPIRE) > now + GOODBYE_MS {
                    m_set(c, i, M_EXPIRE, now + GOODBYE_MS)
                }
            }
            if m_get(c, i, M_EXPIRE) < oldest_exp {
                oldest_exp = m_get(c, i, M_EXPIRE)
                oldest = i
            }
        }
        i = i + 1
    }
    if ttl == 0 as u32 {
        if same != NONE {
            m_set(c, same, M_EXPIRE, now + GOODBYE_MS)
            m_set(c, same, M_TTL, 0 as u64)
            return 2 as u32
        }
        return 0 as u32
    }
    if same != NONE {
        m_set(c, same, M_TTL, ttl as u64)
        m_set(c, same, M_EXPIRE, now + (ttl as u64) * 1000 as u64)
        return 3 as u32
    }
    var slot: usize = free_slot
    if slot == NONE {
        slot = oldest
    }
    rt.mem_copy(cache_name(c, slot), name, nlen)
    rt.mem_copy(cache_data(c, slot), data, dlen)
    m_set(c, slot, M_NLEN, nlen as u64)
    m_set(c, slot, M_DLEN, dlen as u64)
    m_set(c, slot, M_TYP, typ as u64)
    m_set(c, slot, M_CLASS, class as u64)
    m_set(c, slot, M_TTL, ttl as u64)
    m_set(c, slot, M_EXPIRE, now + (ttl as u64) * 1000 as u64)
    m_set(c, slot, M_BORN, now)
    m_set(c, slot, M_USED, 1 as u64)
    return 1 as u32
}

fn cache_find(c: *mut Cache, name: u64, nlen: usize, typ: u32, from: usize, now: u64) -> usize {
    var i: usize = from
    while i < (*c).cap {
        if live(c, i, now) && cache_nlen(c, i) == nlen
            && (typ == mdns_wire.T_ANY || cache_typ(c, i) == typ)
            && mdns_wire.wname_eq(cache_name(c, i), nlen, name, nlen) {
            return i
        }
        i = i + 1
    }
    return NONE
}
