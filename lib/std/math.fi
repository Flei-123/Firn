// lib/std/math.fi -- std.math: the unified mathematics facade.
//
// Integers are solid (abs/min/max/clamp/isqrt/pow), floating point as far as
// the core language allows: f64 arithmetic has been in BOTH code generators
// since round 30 (`tests/590_f64.fi`), so sqrt/powi compute on f64.
// Self contained: no dependencies apart from the language.
export {
    // round 39
    PI, E, abs, min, max, clamp, isqrt, pow, sqrt, powi,
    // round 42 -- constants and bit patterns
    TAU, SQRT2, LN2, LN10, INF, NAN, EPSILON,
    math_bits, math_f64, is_nan, is_infinite, is_finite,
    // round 42 -- integer
    sign, min_u, max_u, clamp_u, abs_diff, gcd, lcm, ilog2, ilog10,
    is_pow_two, next_pow_two, pow_u,
    // round 42 -- floating point, exact
    fabs, fmin, fmax, fclamp, trunc, floor, ceil, round, fmod, hypot,
    ldexp, frexp,
    // round 42 -- floating point, approximated
    exp, ln, log2, log10, powf, sin, cos, tan, atan, atan2, near,
}

// Pi and Euler's number as FUNCTIONS, not as constants: in stage 0 `const`
// can only do integer and bool types (sema evaluates constants as integers)
// -- a `const PI: f64` cannot be said.
fn PI() -> f64 {
    return 3.141592653589793
}

fn E() -> f64 {
    return 2.718281828459045
}

// The magnitude of a signed integer.
fn abs(x: i64) -> i64 {
    if x < 0 {
        return 0 - x
    }
    return x
}

fn min(a: i64, b: i64) -> i64 {
    if a < b {
        return a
    }
    return b
}

fn max(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    }
    return b
}

// `x` forced into the closed range [lo, hi].
fn clamp(x: i64, lo: i64, hi: i64) -> i64 {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}

// The integer square root: floor(sqrt(n)), exact.
// Newton from above -- the sequence falls monotonically onto the fixpoint.
fn isqrt(n: u64) -> u64 {
    if n < 2 {
        return n
    }
    var x: u64 = n
    var y: u64 = (x + 1) / 2
    while y < x {
        x = y
        y = (x + n / x) / 2
    }
    return x
}

// Integer power, exponent >= 0. 0^0 is 1 (the usual convention).
fn pow(b: i64, e: u64) -> i64 {
    var r: i64 = 1
    var i: u64 = 0
    while i < e {
        r = r * b
        i = i + 1
    }
    return r
}

// The square root on f64. Newton until the value stops moving -- that
// converges for every positive input without having to guess a start value.
// sqrt(0) = 0; a negative input gives NaN (0.0/0.0).
fn sqrt(x: f64) -> f64 {
    if x < 0.0 {
        return 0.0 / 0.0
    }
    if x == 0.0 {
        return 0.0
    }
    var g: f64 = x
    if g < 1.0 {
        g = 1.0
    }
    var old: f64 = 0.0
    while g != old {
        old = g
        g = (g + x / g) / 2.0
    }
    return g
}

// f64 power with an integer exponent (negative allowed).
fn powi(b: f64, e: i64) -> f64 {
    var base: f64 = b
    var n: i64 = e
    if n < 0 {
        base = 1.0 / b
        n = 0 - n
    }
    var r: f64 = 1.0
    var i: i64 = 0
    while i < n {
        r = r * base
        i = i + 1
    }
    return r
}

// =====================================================================
// Round 42 -- the build out. The naming rule of this module, deliberately
// kept: mathematical functions carry their international name (sqrt, floor,
// exp, ln, sin). A second name next to the `sqrt` that has existed since
// round 39 would be two names for one thing; renaming would be a break.
// Everything else follows the general naming of the library (English since round 55).
// =====================================================================

// ------------------------------------------------- Bit patterns and limits
//
// `math` stays self contained: the reinterpretation f64 <-> u64 stands here
// once more (instead of an import of std.num), so that a program that only
// wants to compute does not pull in the whole number library.

fn all_bits() -> u64 {
    var x: u64 = 0
    return x - 1
}

fn math_bits(x: f64) -> u64 {
    var t: f64 = x
    return *(((&t) as usize) as *mut u64)
}

fn math_f64(b: u64) -> f64 {
    var t: u64 = b
    return *(((&t) as usize) as *mut f64)
}

fn INF() -> f64 {
    return math_f64(9218868437227405312)
}

fn NAN() -> f64 {
    return math_f64(9221120237041090560)
}

// The distance from 1.0 to the next larger number: 2^-52.
fn EPSILON() -> f64 {
    return math_f64(4372995238176751616)
}

fn TAU() -> f64 {
    return 6.283185307179586
}

fn SQRT2() -> f64 {
    return 1.4142135623730951
}

fn LN2() -> f64 {
    return 0.6931471805599453
}

fn LN10() -> f64 {
    return 2.302585092994046
}

fn is_nan(x: f64) -> bool {
    return x != x
}

fn is_infinite(x: f64) -> bool {
    let b: u64 = math_bits(x) & 9223372036854775807
    return b == 9218868437227405312
}

fn is_finite(x: f64) -> bool {
    let b: u64 = math_bits(x) & 9223372036854775807
    return b < 9218868437227405312
}

// -------------------------------------------------------- The integer part

// -1, 0 or 1.
fn sign(x: i64) -> i64 {
    if x < 0 {
        return 0 - 1
    }
    if x > 0 {
        return 1
    }
    return 0
}

fn min_u(a: u64, b: u64) -> u64 {
    if a < b {
        return a
    }
    return b
}

fn max_u(a: u64, b: u64) -> u64 {
    if a > b {
        return a
    }
    return b
}

fn clamp_u(x: u64, lo: u64, hi: u64) -> u64 {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}

// The magnitude of the difference, without wraparound -- for i64::MIN too.
fn abs_diff(a: i64, b: i64) -> u64 {
    if a >= b {
        return (a as u64) - (b as u64)
    }
    return (b as u64) - (a as u64)
}

// The greatest common divisor (Euclid, iterative). gcd(0, 0) = 0.
fn gcd(a: u64, b: u64) -> u64 {
    var x: u64 = a
    var y: u64 = b
    while y != 0 {
        let r: u64 = x % y
        x = y
        y = r
    }
    return x
}

// The least common multiple. 0 if one value is 0. Overflow is NOT checked
// (stage 0 checks nowhere) -- but dividing first and multiplying afterwards
// keeps it away as long as possible.
fn lcm(a: u64, b: u64) -> u64 {
    if a == 0 || b == 0 {
        return 0
    }
    return a / gcd(a, b) * b
}

// The rounded down binary logarithm; ilog2(0) is 0 (there is no right
// answer, and a crash would be worse).
fn ilog2(v: u64) -> usize {
    if v == 0 {
        return 0
    }
    var x: u64 = v
    var n: usize = 0
    while x > 1 {
        x = x >> 1
        n = n + 1
    }
    return n
}

fn ilog10(v: u64) -> usize {
    var x: u64 = v
    var n: usize = 0
    while x >= 10 {
        x = x / 10
        n = n + 1
    }
    return n
}

fn is_pow_two(v: u64) -> bool {
    if v == 0 {
        return false
    }
    return (v & (v - 1)) == 0
}

// The smallest power of two >= v. Above 2^63 there is none: then 0.
fn next_pow_two(v: u64) -> u64 {
    if v <= 1 {
        return 1
    }
    if v > 9223372036854775808 {
        return 0
    }
    var k: u64 = 1
    while k < v {
        k = k * 2
    }
    return k
}

// Unsigned integer power, by squaring -- the pow() next to it is the signed
// form from round 39 and stays as it is.
fn pow_u(b: u64, e: u64) -> u64 {
    var r: u64 = 1
    var base: u64 = b
    var n: u64 = e
    while n > 0 {
        if (n & 1) == 1 {
            r = r * base
        }
        base = base * base
        n = n >> 1
    }
    return r
}

// --------------------------------------------------- Floating point, exact
//
// The following six do NOT compute, they cut off bits -- their result is
// exactly the right double for every input, including 2^52 and above, where
// every formula with +0.5 would be wrong.

fn fabs(x: f64) -> f64 {
    return math_f64(math_bits(x) & 9223372036854775807)
}

fn fmin(a: f64, b: f64) -> f64 {
    if is_nan(a) {
        return b
    }
    if is_nan(b) {
        return a
    }
    if a < b {
        return a
    }
    return b
}

fn fmax(a: f64, b: f64) -> f64 {
    if is_nan(a) {
        return b
    }
    if is_nan(b) {
        return a
    }
    if a > b {
        return a
    }
    return b
}

fn fclamp(x: f64, lo: f64, hi: f64) -> f64 {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}

// Cut off the fractional digits (towards zero). The sign stays: -0.5 becomes
// -0.0.
fn trunc(x: f64) -> f64 {
    let b: u64 = math_bits(x)
    let e: u64 = (b >> 52) & 2047
    if e < 1023 {
        return math_f64(b & 9223372036854775808)
    }
    if e >= 1075 {
        return x
    }
    let frac: u64 = 4503599627370495 >> (e - 1023)
    return math_f64(b & (all_bits() - frac))
}

fn floor(x: f64) -> f64 {
    let t: f64 = trunc(x)
    if t > x {
        return t - 1.0
    }
    return t
}

fn ceil(x: f64) -> f64 {
    let t: f64 = trunc(x)
    if t < x {
        return t + 1.0
    }
    return t
}

// Commercial rounding: a half goes AWAY FROM ZERO (round(0.5) = 1,
// round(-0.5) = -1). Through `trunc` instead of through `floor(x + 0.5)` --
// otherwise round(0.49999999999999994) would wrongly be 1.
fn round(x: f64) -> f64 {
    let t: f64 = trunc(x)
    let d: f64 = x - t
    if d >= 0.5 {
        return t + 1.0
    }
    if d <= 0.0 - 0.5 {
        return t - 1.0
    }
    return t
}

// The remainder of the division as in C: the same sign as `x`, exact.
// Method: double the magnitude of the divisor until it lies above the
// remainder, then subtract while halving -- every intermediate number lies
// on the same bit grid, so every subtraction is exact.
fn fmod(x: f64, y: f64) -> f64 {
    if is_nan(x) || is_nan(y) || is_infinite(x) || y == 0.0 {
        return NAN()
    }
    if is_infinite(y) {
        return x
    }
    var a: f64 = fabs(x)
    let b: f64 = fabs(y)
    if a < b {
        return x
    }
    var s: f64 = b
    while s <= a / 2.0 {
        s = s * 2.0
    }
    var runs: bool = true
    while runs {
        if a >= s {
            a = a - s
        }
        if s == b {
            runs = false
        } else {
            s = s / 2.0
        }
    }
    if x < 0.0 {
        return 0.0 - a
    }
    return a
}

// Multiply by 2^k. In two steps, so that very small results (subnormal) and
// very large factors come out right as well.
fn ldexp(x: f64, k: i64) -> f64 {
    if x == 0.0 || is_nan(x) || is_infinite(x) {
        return x
    }
    var n: i64 = k
    var r: f64 = x
    while n > 1000 {
        r = r * math_f64(9110782046170513408)
        n = n - 1000
    }
    while n < 0 - 1000 {
        r = r * math_f64(103582791429521408)
        n = n + 1000
    }
    let bits: u64 = ((n + 1023) as u64) << 52
    return r * math_f64(bits)
}

// The decomposition x = m * 2^e with 0.5 <= |m| < 1. `e` comes via the pointer.
fn frexp(x: f64, e: *mut i64) -> f64 {
    *e = 0
    if x == 0.0 || is_nan(x) || is_infinite(x) {
        return x
    }
    var r: f64 = x
    var k: i64 = 0
    // Scale subnormals up first, so that the exponent stands in the field.
    if fabs(r) < math_f64(4503599627370496) {
        r = r * math_f64(4850376798678024192)
        k = 0 - 54
    }
    let b: u64 = math_bits(r)
    let raw: i64 = ((b >> 52) & 2047) as i64
    *e = k + raw - 1022
    return math_f64((b & 9227875636482146303) | 4602678819172646912)
}

fn hypot(x: f64, y: f64) -> f64 {
    let ax: f64 = fabs(x)
    let ay: f64 = fabs(y)
    let m: f64 = fmax(ax, ay)
    let n: f64 = fmin(ax, ay)
    if m == 0.0 {
        return 0.0
    }
    if is_infinite(m) {
        return INF()
    }
    let r: f64 = n / m
    return m * sqrt(1.0 + r * r)
}

// -------------------------------------------- Floating point, approximated
//
// Series expansion with range reduction, without tables. MEASURED in
// tests/805_std_math_f64.fi against known values; the bounds checked
// there are the honest claim about accuracy (relative <= 1e-12 over the
// checked range), NOT "correct to the last bit". Whoever needs correctly
// rounded elementary functions needs tables -- that is a round of its
// own.

// e^x. Reduction x = k*ln2 + r with |r| <= ln2/2, then Taylor around 0.
fn exp(x: f64) -> f64 {
    if is_nan(x) {
        return x
    }
    if x > 709.9 {
        return INF()
    }
    if x < 0.0 - 745.2 {
        return 0.0
    }
    let k: f64 = round(x / LN2())
    let r: f64 = x - k * LN2()
    var member: f64 = 1.0
    var sum: f64 = 1.0
    var i: i64 = 1
    while i <= 16 {
        member = member * r / (i as f64)
        sum = sum + member
        i = i + 1
    }
    return ldexp(sum, k as i64)
}

// The natural logarithm. x = m * 2^e with m in [sqrt(0.5), sqrt(2)), then
// the series for atanh: ln(m) = 2*(s + s^3/3 + s^5/5 + ...) with
// s = (m-1)/(m+1) -- there |s| <= 0.1716, and the series is exhausted after
// nine terms.
fn ln(x: f64) -> f64 {
    if is_nan(x) {
        return x
    }
    if x < 0.0 {
        return NAN()
    }
    if x == 0.0 {
        return 0.0 - INF()
    }
    if is_infinite(x) {
        return INF()
    }
    var e: i64 = 0
    var m: f64 = frexp(x, &e)
    if m < 0.7071067811865476 {
        m = m * 2.0
        e = e - 1
    }
    let s: f64 = (m - 1.0) / (m + 1.0)
    let q: f64 = s * s
    var member: f64 = s
    var sum: f64 = s
    var i: i64 = 1
    while i <= 12 {
        member = member * q
        sum = sum + member / ((2 * i + 1) as f64)
        i = i + 1
    }
    return 2.0 * sum + (e as f64) * LN2()
}

fn log2(x: f64) -> f64 {
    return ln(x) / LN2()
}

fn log10(x: f64) -> f64 {
    return ln(x) / LN10()
}

// The general power. Integer exponents go exactly through `powi` -- that
// keeps pow(2.0, 10.0) at exactly 1024 instead of at 1023.9999999.
fn powf(b: f64, e: f64) -> f64 {
    if e == trunc(e) && fabs(e) <= 1024.0 {
        return powi(b, e as i64)
    }
    if b < 0.0 {
        return NAN()
    }
    if b == 0.0 {
        if e > 0.0 {
            return 0.0
        }
        return INF()
    }
    return exp(e * ln(b))
}

// Sine/cosine. Reduction modulo 2*PI, then onto the eighth of a circle;
// Taylor around 0 with 8 terms. AN HONEST LIMIT: the reduction computes in
// double precision, and for very large |x| (beyond roughly 2^30) it eats up
// the digits. That is the usual limit without a Payne-Hanek reduction, and
// it is named here, not hidden.
fn sin_core(r: f64) -> f64 {
    let q: f64 = r * r
    var member: f64 = r
    var sum: f64 = r
    var i: i64 = 1
    while i <= 9 {
        member = 0.0 - member * q / (((2 * i) * (2 * i + 1)) as f64)
        sum = sum + member
        i = i + 1
    }
    return sum
}

fn cos_core(r: f64) -> f64 {
    let q: f64 = r * r
    var member: f64 = 1.0
    var sum: f64 = 1.0
    var i: i64 = 1
    while i <= 9 {
        member = 0.0 - member * q / (((2 * i - 1) * (2 * i)) as f64)
        sum = sum + member
        i = i + 1
    }
    return sum
}

fn sin(x: f64) -> f64 {
    if is_nan(x) || is_infinite(x) {
        return NAN()
    }
    var r: f64 = fmod(x, TAU())
    if r > PI() {
        r = r - TAU()
    }
    if r < 0.0 - PI() {
        r = r + TAU()
    }
    // Mirror onto [-PI/2, PI/2]: sin(PI - r) = sin(r).
    if r > PI() / 2.0 {
        r = PI() - r
    }
    if r < 0.0 - PI() / 2.0 {
        r = 0.0 - PI() - r
    }
    return sin_core(r)
}

fn cos(x: f64) -> f64 {
    return sin(x + PI() / 2.0)
}

fn tan(x: f64) -> f64 {
    let c: f64 = cos(x)
    if c == 0.0 {
        return NAN()
    }
    return sin(x) / c
}

// The arc tangent. Reduction onto [0, tan(PI/12)] through two identities,
// then the series -- that keeps the argument small enough for twelve terms
// to be sufficient.
fn atan(x: f64) -> f64 {
    if is_nan(x) {
        return x
    }
    if is_infinite(x) {
        if x > 0.0 {
            return PI() / 2.0
        }
        return 0.0 - PI() / 2.0
    }
    if x < 0.0 {
        return 0.0 - atan(0.0 - x)
    }
    if x > 1.0 {
        return PI() / 2.0 - atan(1.0 / x)
    }
    // tan(PI/12) = 2 - sqrt(3); above it, apply the addition formula.
    if x > 0.2679491924311227 {
        let w: f64 = (x * 1.7320508075688772 - 1.0) / (x + 1.7320508075688772)
        return PI() / 6.0 + atan(w)
    }
    let q: f64 = x * x
    var member: f64 = x
    var sum: f64 = x
    var i: i64 = 1
    while i <= 14 {
        member = 0.0 - member * q
        sum = sum + member / ((2 * i + 1) as f64)
        i = i + 1
    }
    return sum
}

// The angle of the point (x, y) over the range (-PI, PI].
fn atan2(y: f64, x: f64) -> f64 {
    if x > 0.0 {
        return atan(y / x)
    }
    if x < 0.0 {
        if y >= 0.0 {
            return atan(y / x) + PI()
        }
        return atan(y / x) - PI()
    }
    if y > 0.0 {
        return PI() / 2.0
    }
    if y < 0.0 {
        return 0.0 - PI() / 2.0
    }
    return 0.0
}

// An approximate comparison: |a - b| <= eps * max(1, |a|, |b|). The one
// every floating point test needs -- and that everybody writes wrong.
fn near(a: f64, b: f64, eps: f64) -> bool {
    if a == b {
        return true
    }
    if is_nan(a) || is_nan(b) {
        return false
    }
    var m: f64 = 1.0
    if fabs(a) > m {
        m = fabs(a)
    }
    if fabs(b) > m {
        m = fabs(b)
    }
    return fabs(a - b) <= eps * m
}
