// lib/std/math.fi — std.math: die einheitliche Mathematik-Fassade.
//
// Ganzzahl solide (abs/min/max/clamp/isqrt/pow), Gleitkomma, wo die
// Kernsprache es hergibt: f64-Arithmetik steht seit Runde 30 in BEIDEN
// Codegeneratoren (`tests/590_f64.fi`), also rechnen sqrt/powi auf f64.
// Selbstgenuegsam: keine Abhaengigkeiten ausser der Sprache.
export {
    // Runde 39
    PI, E, abs, min, max, clamp, isqrt, pow, sqrt, powi,
    // Runde 42 — Konstanten und Bitmuster
    TAU, SQRT2, LN2, LN10, INF, NAN, EPSILON,
    math_bits, math_f64, is_nan, is_infinite, is_finite,
    // Runde 42 — Ganzzahl
    sign, min_u, max_u, clamp_u, abs_diff, gcd, lcm, ilog2, ilog10,
    is_pow_two, next_pow_two, pow_u,
    // Runde 42 — Gleitkomma, exakt
    fabs, fmin, fmax, fclamp, trunc, floor, ceil, round, fmod, hypot,
    ldexp, frexp,
    // Runde 42 — Gleitkomma, genaehert
    exp, ln, log2, log10, powf, sin, cos, tan, atan, atan2, near,
}

// Die Kreiszahl und die Eulersche Zahl als FUNKTIONEN, nicht als Konstanten:
// `const` kann in Stufe 0 nur Ganzzahl- und Bool-Typen (die Sema wertet
// Konstanten ganzzahlig aus) — ein `const PI: f64` ist nicht sagbar.
fn PI() -> f64 {
    return 3.141592653589793
}

fn E() -> f64 {
    return 2.718281828459045
}

// Betrag einer vorzeichenbehafteten Ganzzahl.
fn abs(x: i64) -> i64 {
    if x < 0 {
        return 0 - x
    }
    return x
}

fn min(a: i64, b: i64) -> i64 {
    if a < b {
        return a
    }
    return b
}

fn max(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    }
    return b
}

// `x` in den geschlossenen Bereich [lo, hi] gezwaengt.
fn clamp(x: i64, lo: i64, hi: i64) -> i64 {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}

// Ganzzahlige Quadratwurzel: floor(sqrt(n)), exakt.
// Newton von oben — die Folge faellt monoton auf den Fixpunkt.
fn isqrt(n: u64) -> u64 {
    if n < 2 {
        return n
    }
    var x: u64 = n
    var y: u64 = (x + 1) / 2
    while y < x {
        x = y
        y = (x + n / x) / 2
    }
    return x
}

// Ganzzahl-Potenz, Exponent >= 0. 0^0 ist 1 (Binkonvention).
fn pow(b: i64, e: u64) -> i64 {
    var r: i64 = 1
    var i: u64 = 0
    while i < e {
        r = r * b
        i = i + 1
    }
    return r
}

// Quadratwurzel auf f64. Newton bis zum stehenden Wert — das konvergiert
// fuer jede positive Eingabe, ohne dass ein Startwert geraten werden muss.
// sqrt(0) = 0; eine negative Eingabe ergibt NaN (0.0/0.0).
fn sqrt(x: f64) -> f64 {
    if x < 0.0 {
        return 0.0 / 0.0
    }
    if x == 0.0 {
        return 0.0
    }
    var g: f64 = x
    if g < 1.0 {
        g = 1.0
    }
    var old: f64 = 0.0
    while g != old {
        old = g
        g = (g + x / g) / 2.0
    }
    return g
}

// f64-Potenz mit ganzzahligem Exponenten (negativ erlaubt).
fn powi(b: f64, e: i64) -> f64 {
    var base: f64 = b
    var n: i64 = e
    if n < 0 {
        base = 1.0 / b
        n = 0 - n
    }
    var r: f64 = 1.0
    var i: i64 = 0
    while i < n {
        r = r * base
        i = i + 1
    }
    return r
}

// =====================================================================
// Runde 42 — der Ausbau. Namensregel dieses Moduls, bewusst beibehalten:
// mathematische Funktionen tragen ihren internationalen Namen (sqrt, floor,
// exp, ln, sin). Ein `wurzel` neben dem seit Runde 39 bestehenden `sqrt`
// waere zwei Namen fuer eine Sache; umbenennen waere ein Bruch. Alles, was
// KEIN eingebuergerter Funktionsname ist, heisst deutsch.
// =====================================================================

// ------------------------------------------------- Bitmuster und Grenzen
//
// `math` bleibt selbstgenuegsam: die Umdeutung f64 <-> u64 steht hier noch
// einmal (statt eines Imports von std.num), damit ein Programm, das nur
// rechnen will, nicht die ganze Zahlenbibliothek einzieht.

fn all_bits() -> u64 {
    var x: u64 = 0
    return x - 1
}

fn math_bits(x: f64) -> u64 {
    var t: f64 = x
    return *(((&t) as usize) as *mut u64)
}

fn math_f64(b: u64) -> f64 {
    var t: u64 = b
    return *(((&t) as usize) as *mut f64)
}

fn INF() -> f64 {
    return math_f64(9218868437227405312)
}

fn NAN() -> f64 {
    return math_f64(9221120237041090560)
}

// Abstand von 1.0 zur naechsten groesseren Zahl: 2^-52.
fn EPSILON() -> f64 {
    return math_f64(4372995238176751616)
}

fn TAU() -> f64 {
    return 6.283185307179586
}

fn SQRT2() -> f64 {
    return 1.4142135623730951
}

fn LN2() -> f64 {
    return 0.6931471805599453
}

fn LN10() -> f64 {
    return 2.302585092994046
}

fn is_nan(x: f64) -> bool {
    return x != x
}

fn is_infinite(x: f64) -> bool {
    let b: u64 = math_bits(x) & 9223372036854775807
    return b == 9218868437227405312
}

fn is_finite(x: f64) -> bool {
    let b: u64 = math_bits(x) & 9223372036854775807
    return b < 9218868437227405312
}

// -------------------------------------------------------- Ganzzahl-Teil

// -1, 0 oder 1.
fn sign(x: i64) -> i64 {
    if x < 0 {
        return 0 - 1
    }
    if x > 0 {
        return 1
    }
    return 0
}

fn min_u(a: u64, b: u64) -> u64 {
    if a < b {
        return a
    }
    return b
}

fn max_u(a: u64, b: u64) -> u64 {
    if a > b {
        return a
    }
    return b
}

fn clamp_u(x: u64, lo: u64, hi: u64) -> u64 {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}

// Betrag der Differenz, ohne Umbruch — auch fuer i64::MIN.
fn abs_diff(a: i64, b: i64) -> u64 {
    if a >= b {
        return (a as u64) - (b as u64)
    }
    return (b as u64) - (a as u64)
}

// Groesster gemeinsamer Teiler (Euklid, iterativ). gcd(0, 0) = 0.
fn gcd(a: u64, b: u64) -> u64 {
    var x: u64 = a
    var y: u64 = b
    while y != 0 {
        let r: u64 = x % y
        x = y
        y = r
    }
    return x
}

// Kleinstes gemeinsames Vielfaches. 0, wenn ein Wert 0 ist. Der Ueberlauf
// wird NICHT geprueft (Stufe 0 prueft nirgends) — zuerst teilen, dann
// multiplizieren haelt ihn aber so weit wie moeglich fern.
fn lcm(a: u64, b: u64) -> u64 {
    if a == 0 || b == 0 {
        return 0
    }
    return a / gcd(a, b) * b
}

// Abgerundeter Zweierlogarithmus; ilog2(0) ist 0 (es gibt keinen richtigen
// Wert, und ein Absturz waere schlimmer).
fn ilog2(v: u64) -> usize {
    if v == 0 {
        return 0
    }
    var x: u64 = v
    var n: usize = 0
    while x > 1 {
        x = x >> 1
        n = n + 1
    }
    return n
}

fn ilog10(v: u64) -> usize {
    var x: u64 = v
    var n: usize = 0
    while x >= 10 {
        x = x / 10
        n = n + 1
    }
    return n
}

fn is_pow_two(v: u64) -> bool {
    if v == 0 {
        return false
    }
    return (v & (v - 1)) == 0
}

// Kleinste Zweierpotenz >= v. Ueber 2^63 gibt es keine mehr: dann 0.
fn next_pow_two(v: u64) -> u64 {
    if v <= 1 {
        return 1
    }
    if v > 9223372036854775808 {
        return 0
    }
    var k: u64 = 1
    while k < v {
        k = k * 2
    }
    return k
}

// Vorzeichenlose Ganzzahlpotenz, quadrierend — pow() daneben ist die
// vorzeichenbehaftete Form aus Runde 39 und bleibt, wie sie ist.
fn pow_u(b: u64, e: u64) -> u64 {
    var r: u64 = 1
    var base: u64 = b
    var n: u64 = e
    while n > 0 {
        if (n & 1) == 1 {
            r = r * base
        }
        base = base * base
        n = n >> 1
    }
    return r
}

// ----------------------------------------------------- Gleitkomma, exakt
//
// Die folgenden sechs rechnen NICHT, sie schneiden Bits ab — ihr Ergebnis
// ist fuer jede Eingabe exakt das richtige Double, auch fuer 2^52 und
// darueber, wo jede Formel mit +0.5 falsch waere.

fn fabs(x: f64) -> f64 {
    return math_f64(math_bits(x) & 9223372036854775807)
}

fn fmin(a: f64, b: f64) -> f64 {
    if is_nan(a) {
        return b
    }
    if is_nan(b) {
        return a
    }
    if a < b {
        return a
    }
    return b
}

fn fmax(a: f64, b: f64) -> f64 {
    if is_nan(a) {
        return b
    }
    if is_nan(b) {
        return a
    }
    if a > b {
        return a
    }
    return b
}

fn fclamp(x: f64, lo: f64, hi: f64) -> f64 {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}

// Nachkommastellen abschneiden (Richtung Null). Vorzeichen bleibt: aus -0.5
// wird -0.0.
fn trunc(x: f64) -> f64 {
    let b: u64 = math_bits(x)
    let e: u64 = (b >> 52) & 2047
    if e < 1023 {
        return math_f64(b & 9223372036854775808)
    }
    if e >= 1075 {
        return x
    }
    let frac: u64 = 4503599627370495 >> (e - 1023)
    return math_f64(b & (all_bits() - frac))
}

fn floor(x: f64) -> f64 {
    let t: f64 = trunc(x)
    if t > x {
        return t - 1.0
    }
    return t
}

fn ceil(x: f64) -> f64 {
    let t: f64 = trunc(x)
    if t < x {
        return t + 1.0
    }
    return t
}

// Kaufmaennisch: die Haelfte geht VON DER NULL WEG (round(0.5) = 1,
// round(-0.5) = -1). Ueber `trunc` statt ueber `floor(x + 0.5)` — sonst
// waere round(0.49999999999999994) faelschlich 1.
fn round(x: f64) -> f64 {
    let t: f64 = trunc(x)
    let d: f64 = x - t
    if d >= 0.5 {
        return t + 1.0
    }
    if d <= 0.0 - 0.5 {
        return t - 1.0
    }
    return t
}

// Rest der Division wie in C: dasselbe Vorzeichen wie `x`, exakt.
// Verfahren: den Betrag des Teilers verdoppeln, bis er ueber dem Rest
// liegt, dann halbierend abziehen — jede Zwischenzahl liegt auf demselben
// Bitraster, also ist jede Subtraktion exakt.
fn fmod(x: f64, y: f64) -> f64 {
    if is_nan(x) || is_nan(y) || is_infinite(x) || y == 0.0 {
        return NAN()
    }
    if is_infinite(y) {
        return x
    }
    var a: f64 = fabs(x)
    let b: f64 = fabs(y)
    if a < b {
        return x
    }
    var s: f64 = b
    while s <= a / 2.0 {
        s = s * 2.0
    }
    var runs: bool = true
    while runs {
        if a >= s {
            a = a - s
        }
        if s == b {
            runs = false
        } else {
            s = s / 2.0
        }
    }
    if x < 0.0 {
        return 0.0 - a
    }
    return a
}

// Mit 2^k multiplizieren. In zwei Schritten, damit auch sehr kleine
// Ergebnisse (subnormal) und sehr grosse Faktoren richtig herauskommen.
fn ldexp(x: f64, k: i64) -> f64 {
    if x == 0.0 || is_nan(x) || is_infinite(x) {
        return x
    }
    var n: i64 = k
    var r: f64 = x
    while n > 1000 {
        r = r * math_f64(9110782046170513408)
        n = n - 1000
    }
    while n < 0 - 1000 {
        r = r * math_f64(103582791429521408)
        n = n + 1000
    }
    let bits: u64 = ((n + 1023) as u64) << 52
    return r * math_f64(bits)
}

// Zerlegung x = m * 2^e mit 0,5 <= |m| < 1. `e` kommt ueber den Zeiger.
fn frexp(x: f64, e: *mut i64) -> f64 {
    *e = 0
    if x == 0.0 || is_nan(x) || is_infinite(x) {
        return x
    }
    var r: f64 = x
    var k: i64 = 0
    // Subnormale zuerst hochskalieren, damit der Exponent im Feld steht.
    if fabs(r) < math_f64(4503599627370496) {
        r = r * math_f64(4850376798678024192)
        k = 0 - 54
    }
    let b: u64 = math_bits(r)
    let raw: i64 = ((b >> 52) & 2047) as i64
    *e = k + raw - 1022
    return math_f64((b & 9227875636482146303) | 4602678819172646912)
}

fn hypot(x: f64, y: f64) -> f64 {
    let ax: f64 = fabs(x)
    let ay: f64 = fabs(y)
    let m: f64 = fmax(ax, ay)
    let n: f64 = fmin(ax, ay)
    if m == 0.0 {
        return 0.0
    }
    if is_infinite(m) {
        return INF()
    }
    let r: f64 = n / m
    return m * sqrt(1.0 + r * r)
}

// ------------------------------------------------ Gleitkomma, genaehert
//
// Reihenentwicklung mit Bereichsreduktion, ohne Tabellen. GEMESSEN in
// tests/805_std_math_f64.fi gegen bekannte Werte; die dort geprueften
// Schranken sind der ehrliche Genauigkeitsanspruch (relativ <= 1e-12 im
// gepruefen Bereich), NICHT "letztes Bit korrekt". Wer korrekt gerundete
// Elementarfunktionen braucht, braucht Tabellen — das ist eine eigene
// Runde.

// e^x. Reduktion x = k*ln2 + r mit |r| <= ln2/2, danach Taylor um 0.
fn exp(x: f64) -> f64 {
    if is_nan(x) {
        return x
    }
    if x > 709.9 {
        return INF()
    }
    if x < 0.0 - 745.2 {
        return 0.0
    }
    let k: f64 = round(x / LN2())
    let r: f64 = x - k * LN2()
    var member: f64 = 1.0
    var sum: f64 = 1.0
    var i: i64 = 1
    while i <= 16 {
        member = member * r / (i as f64)
        sum = sum + member
        i = i + 1
    }
    return ldexp(sum, k as i64)
}

// Natuerlicher Logarithmus. x = m * 2^e mit m in [sqrt(0.5), sqrt(2)),
// danach die Reihe fuer atanh: ln(m) = 2*(s + s^3/3 + s^5/5 + ...) mit
// s = (m-1)/(m+1) — dort ist |s| <= 0,1716, die Reihe ist nach neun
// Gliedern austherapiert.
fn ln(x: f64) -> f64 {
    if is_nan(x) {
        return x
    }
    if x < 0.0 {
        return NAN()
    }
    if x == 0.0 {
        return 0.0 - INF()
    }
    if is_infinite(x) {
        return INF()
    }
    var e: i64 = 0
    var m: f64 = frexp(x, &e)
    if m < 0.7071067811865476 {
        m = m * 2.0
        e = e - 1
    }
    let s: f64 = (m - 1.0) / (m + 1.0)
    let q: f64 = s * s
    var member: f64 = s
    var sum: f64 = s
    var i: i64 = 1
    while i <= 12 {
        member = member * q
        sum = sum + member / ((2 * i + 1) as f64)
        i = i + 1
    }
    return 2.0 * sum + (e as f64) * LN2()
}

fn log2(x: f64) -> f64 {
    return ln(x) / LN2()
}

fn log10(x: f64) -> f64 {
    return ln(x) / LN10()
}

// Allgemeine Potenz. Ganzzahlige Exponenten gehen exakt ueber `powi` — das
// haelt pow(2.0, 10.0) bei genau 1024 statt bei 1023,9999999.
fn powf(b: f64, e: f64) -> f64 {
    if e == trunc(e) && fabs(e) <= 1024.0 {
        return powi(b, e as i64)
    }
    if b < 0.0 {
        return NAN()
    }
    if b == 0.0 {
        if e > 0.0 {
            return 0.0
        }
        return INF()
    }
    return exp(e * ln(b))
}

// Sinus/Kosinus. Reduktion modulo 2*PI, danach auf den Achtelkreis; Taylor
// um 0 mit 8 Gliedern. EHRLICHE GRENZE: die Reduktion rechnet in doppelter
// Genauigkeit, fuer sehr grosse |x| (jenseits von etwa 2^30) frisst sie die
// Stellen auf. Das ist die uebliche Grenze ohne Payne-Hanek-Reduktion und
// wird hier benannt, nicht versteckt.
fn sin_core(r: f64) -> f64 {
    let q: f64 = r * r
    var member: f64 = r
    var sum: f64 = r
    var i: i64 = 1
    while i <= 9 {
        member = 0.0 - member * q / (((2 * i) * (2 * i + 1)) as f64)
        sum = sum + member
        i = i + 1
    }
    return sum
}

fn cos_core(r: f64) -> f64 {
    let q: f64 = r * r
    var member: f64 = 1.0
    var sum: f64 = 1.0
    var i: i64 = 1
    while i <= 9 {
        member = 0.0 - member * q / (((2 * i - 1) * (2 * i)) as f64)
        sum = sum + member
        i = i + 1
    }
    return sum
}

fn sin(x: f64) -> f64 {
    if is_nan(x) || is_infinite(x) {
        return NAN()
    }
    var r: f64 = fmod(x, TAU())
    if r > PI() {
        r = r - TAU()
    }
    if r < 0.0 - PI() {
        r = r + TAU()
    }
    // Auf [-PI/2, PI/2] spiegeln: sin(PI - r) = sin(r).
    if r > PI() / 2.0 {
        r = PI() - r
    }
    if r < 0.0 - PI() / 2.0 {
        r = 0.0 - PI() - r
    }
    return sin_core(r)
}

fn cos(x: f64) -> f64 {
    return sin(x + PI() / 2.0)
}

fn tan(x: f64) -> f64 {
    let c: f64 = cos(x)
    if c == 0.0 {
        return NAN()
    }
    return sin(x) / c
}

// Arkustangens. Reduktion auf [0, tan(PI/12)] ueber zwei Identitaeten,
// danach die Reihe — so bleibt das Argument klein genug, dass zwoelf
// Glieder genuegen.
fn atan(x: f64) -> f64 {
    if is_nan(x) {
        return x
    }
    if is_infinite(x) {
        if x > 0.0 {
            return PI() / 2.0
        }
        return 0.0 - PI() / 2.0
    }
    if x < 0.0 {
        return 0.0 - atan(0.0 - x)
    }
    if x > 1.0 {
        return PI() / 2.0 - atan(1.0 / x)
    }
    // tan(PI/12) = 2 - sqrt(3); darueber die Additionsformel anwenden.
    if x > 0.2679491924311227 {
        let w: f64 = (x * 1.7320508075688772 - 1.0) / (x + 1.7320508075688772)
        return PI() / 6.0 + atan(w)
    }
    let q: f64 = x * x
    var member: f64 = x
    var sum: f64 = x
    var i: i64 = 1
    while i <= 14 {
        member = 0.0 - member * q
        sum = sum + member / ((2 * i + 1) as f64)
        i = i + 1
    }
    return sum
}

// Winkel des Punktes (x, y) im Bereich (-PI, PI].
fn atan2(y: f64, x: f64) -> f64 {
    if x > 0.0 {
        return atan(y / x)
    }
    if x < 0.0 {
        if y >= 0.0 {
            return atan(y / x) + PI()
        }
        return atan(y / x) - PI()
    }
    if y > 0.0 {
        return PI() / 2.0
    }
    if y < 0.0 {
        return 0.0 - PI() / 2.0
    }
    return 0.0
}

// Naeherungsvergleich: |a - b| <= eps * max(1, |a|, |b|). Der Vergleich, den
// jeder Test mit Gleitkomma braucht — und den jeder falsch selbst schreibt.
fn near(a: f64, b: f64, eps: f64) -> bool {
    if a == b {
        return true
    }
    if is_nan(a) || is_nan(b) {
        return false
    }
    var m: f64 = 1.0
    if fabs(a) > m {
        m = fabs(a)
    }
    if fabs(b) > m {
        m = fabs(b)
    }
    return fabs(a - b) <= eps * m
}
