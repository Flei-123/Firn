// -1, 0 or 1.
fn sign(x: i64) -> i64 {
    if x < 0 {
        return 0 - 1
    }
    if x > 0 {
        return 1
    }
    return 0
}

fn min_u(a: u64, b: u64) -> u64 {
    if a < b {
        return a
    }
    return b
}

fn max_u(a: u64, b: u64) -> u64 {
    if a > b {
        return a
    }
    return b
}

fn clamp_u(x: u64, lo: u64, hi: u64) -> u64 {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}

// The magnitude of the difference, without wraparound -- for i64::MIN too.
fn abs_diff(a: i64, b: i64) -> u64 {
