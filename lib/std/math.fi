// lib/std/math.fi — std.math: die einheitliche Mathematik-Fassade.
//
// Ganzzahl solide (abs/min/max/clamp/isqrt/pow), Gleitkomma, wo die
// Kernsprache es hergibt: f64-Arithmetik steht seit Runde 30 in BEIDEN
// Codegeneratoren (`tests/590_f64.fi`), also rechnen sqrt/powi auf f64.
// Selbstgenuegsam: keine Abhaengigkeiten ausser der Sprache.
export { PI, E, abs, min, max, clamp, isqrt, pow, sqrt, powi }

// Die Kreiszahl und die Eulersche Zahl als FUNKTIONEN, nicht als Konstanten:
// `const` kann in Stufe 0 nur Ganzzahl- und Bool-Typen (die Sema wertet
// Konstanten ganzzahlig aus) — ein `const PI: f64` ist nicht sagbar.
fn PI() -> f64 {
    return 3.141592653589793
}

fn E() -> f64 {
    return 2.718281828459045
}

// Betrag einer vorzeichenbehafteten Ganzzahl.
fn abs(x: i64) -> i64 {
    if x < 0 {
        return 0 - x
    }
    return x
}

fn min(a: i64, b: i64) -> i64 {
    if a < b {
        return a
    }
    return b
}

fn max(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    }
    return b
}

// `x` in den geschlossenen Bereich [lo, hi] gezwaengt.
fn clamp(x: i64, lo: i64, hi: i64) -> i64 {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}

// Ganzzahlige Quadratwurzel: floor(sqrt(n)), exakt.
// Newton von oben — die Folge faellt monoton auf den Fixpunkt.
fn isqrt(n: u64) -> u64 {
    if n < 2 {
        return n
    }
    var x: u64 = n
    var y: u64 = (x + 1) / 2
    while y < x {
        x = y
        y = (x + n / x) / 2
    }
    return x
}

// Ganzzahl-Potenz, Exponent >= 0. 0^0 ist 1 (Binkonvention).
fn pow(b: i64, e: u64) -> i64 {
    var r: i64 = 1
    var i: u64 = 0
    while i < e {
        r = r * b
        i = i + 1
    }
    return r
}

// Quadratwurzel auf f64. Newton bis zum stehenden Wert — das konvergiert
// fuer jede positive Eingabe, ohne dass ein Startwert geraten werden muss.
// sqrt(0) = 0; eine negative Eingabe ergibt NaN (0.0/0.0).
fn sqrt(x: f64) -> f64 {
    if x < 0.0 {
        return 0.0 / 0.0
    }
    if x == 0.0 {
        return 0.0
    }
    var g: f64 = x
    if g < 1.0 {
        g = 1.0
    }
    var alt: f64 = 0.0
    while g != alt {
        alt = g
        g = (g + x / g) / 2.0
    }
    return g
}

// f64-Potenz mit ganzzahligem Exponenten (negativ erlaubt).
fn powi(b: f64, e: i64) -> f64 {
    var basis: f64 = b
    var n: i64 = e
    if n < 0 {
        basis = 1.0 / b
        n = 0 - n
    }
    var r: f64 = 1.0
    var i: i64 = 0
    while i < n {
        r = r * basis
        i = i + 1
    }
    return r
}
