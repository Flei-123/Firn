// ------------------------------------------------- Bit patterns and limits
//
// `math` stays self contained: the reinterpretation f64 <-> u64 stands here
// once more (instead of an import of std.num), so that a program that only
// wants to compute does not pull in the whole number library.

fn all_bits() -> u64 {
