#[allow_fp]
fn floor(x: f64) -> f64 {
    let t: f64 = trunc(x)
    if t > x {
        return t - 1.0
    }
    return t
}

#[allow_fp]
fn ceil(x: f64) -> f64 {
    let t: f64 = trunc(x)
    if t < x {
        return t + 1.0
    }
    return t
}

// Commercial rounding: a half goes AWAY FROM ZERO (round(0.5) = 1,
// round(-0.5) = -1). Through `trunc` instead of through `floor(x + 0.5)` --
// otherwise round(0.49999999999999994) would wrongly be 1.
#[allow_fp]
fn round(x: f64) -> f64 {
    let t: f64 = trunc(x)
    let d: f64 = x - t
    if d >= 0.5 {
        return t + 1.0
    }
    if d <= 0.0 - 0.5 {
        return t - 1.0
    }
    return t
}

// The remainder of the division as in C: the same sign as `x`, exact.
// Method: double the magnitude of the divisor until it lies above the
// remainder, then subtract while halving -- every intermediate number lies
// on the same bit grid, so every subtraction is exact.
#[allow_fp]
fn fmod(x: f64, y: f64) -> f64 {
    if is_nan(x) || is_nan(y) || is_infinite(x) || y == 0.0 {
        return NAN()
    }
    if is_infinite(y) {
        return x
    }
    var a: f64 = fabs(x)
    let b: f64 = fabs(y)
    if a < b {
        return x
    }
    var s: f64 = b
    while s <= a / 2.0 {
        s = s * 2.0
    }
    var runs: bool = true
    while runs {
        if a >= s {
            a = a - s
        }
        if s == b {
            runs = false
        } else {
            s = s / 2.0
        }
    }
    if x < 0.0 {
        return 0.0 - a
    }
    return a
}

// Multiply by 2^k. In two steps, so that very small results (subnormal) and
// very large factors come out right as well.
#[allow_fp]
fn ldexp(x: f64, k: i64) -> f64 {
    if x == 0.0 || is_nan(x) || is_infinite(x) {
        return x
    }
    var n: i64 = k
    var r: f64 = x
    while n > 1000 {
        r = r * math_f64(9110782046170513408)
        n = n - 1000
    }
    while n < 0 - 1000 {
        r = r * math_f64(103582791429521408)
        n = n + 1000
    }
    let bits: u64 = ((n + 1023) as u64) << 52
    return r * math_f64(bits)
}

// The decomposition x = m * 2^e with 0.5 <= |m| < 1. `e` comes via the pointer.
#[allow_fp]
fn frexp(x: f64, e: *mut i64) -> f64 {
    *e = 0
    if x == 0.0 || is_nan(x) || is_infinite(x) {
        return x
    }
    var r: f64 = x
    var k: i64 = 0
    // Scale subnormals up first, so that the exponent stands in the field.
    if fabs(r) < math_f64(4503599627370496) {
        r = r * math_f64(4850376798678024192)
        k = 0 - 54
    }
    let b: u64 = math_bits(r)
    let raw: i64 = ((b >> 52) & 2047) as i64
    *e = k + raw - 1022
    return math_f64((b & 9227875636482146303) | 4602678819172646912)
}

#[allow_fp]
fn hypot(x: f64, y: f64) -> f64 {
    let ax: f64 = fabs(x)
    let ay: f64 = fabs(y)
    let m: f64 = fmax(ax, ay)
    let n: f64 = fmin(ax, ay)
    if m == 0.0 {
        return 0.0
    }
    if is_infinite(m) {
        return INF()
    }
    let r: f64 = n / m
    return m * sqrt(1.0 + r * r)
