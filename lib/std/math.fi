// -------------------------------------------- Floating point, approximated
//
// Series expansion with range reduction, without tables. MEASURED in
// tests/805_std_math_f64.fi against known values; the bounds checked
// there are the honest claim about accuracy (relative <= 1e-12 over the
// checked range), NOT "correct to the last bit". Whoever needs correctly
// rounded elementary functions needs tables -- that is a round of its
// own.

// e^x. Reduction x = k*ln2 + r with |r| <= ln2/2, then Taylor around 0.
#[allow_fp]
fn exp(x: f64) -> f64 {
    if is_nan(x) {
        return x
    }
    if x > 709.9 {
        return INF()
    }
    if x < 0.0 - 745.2 {
        return 0.0
    }
    let k: f64 = round(x / LN2())
    let r: f64 = x - k * LN2()
    var member: f64 = 1.0
    var sum: f64 = 1.0
    var i: i64 = 1
    while i <= 16 {
        member = member * r / (i as f64)
        sum = sum + member
        i = i + 1
    }
    return ldexp(sum, k as i64)
}

// The natural logarithm. x = m * 2^e with m in [sqrt(0.5), sqrt(2)), then
// the series for atanh: ln(m) = 2*(s + s^3/3 + s^5/5 + ...) with
// s = (m-1)/(m+1) -- there |s| <= 0.1716, and the series is exhausted after
// nine terms.
#[allow_fp]
fn ln(x: f64) -> f64 {
    if is_nan(x) {
        return x
    }
    if x < 0.0 {
        return NAN()
    }
    if x == 0.0 {
        return 0.0 - INF()
    }
    if is_infinite(x) {
        return INF()
    }
    var e: i64 = 0
    var m: f64 = frexp(x, &e)
    if m < 0.7071067811865476 {
        m = m * 2.0
        e = e - 1
    }
    let s: f64 = (m - 1.0) / (m + 1.0)
    let q: f64 = s * s
    var member: f64 = s
    var sum: f64 = s
    var i: i64 = 1
    while i <= 12 {
        member = member * q
        sum = sum + member / ((2 * i + 1) as f64)
        i = i + 1
    }
    return 2.0 * sum + (e as f64) * LN2()
}

#[allow_fp]
fn log2(x: f64) -> f64 {
    return ln(x) / LN2()
}

#[allow_fp]
fn log10(x: f64) -> f64 {
    return ln(x) / LN10()
}

// The general power. Integer exponents go exactly through `powi` -- that
// keeps pow(2.0, 10.0) at exactly 1024 instead of at 1023.9999999.
#[allow_fp]
fn powf(b: f64, e: f64) -> f64 {
    if e == trunc(e) && fabs(e) <= 1024.0 {
        return powi(b, e as i64)
    }
    if b < 0.0 {
        return NAN()
    }
    if b == 0.0 {
        if e > 0.0 {
            return 0.0
        }
        return INF()
    }
    return exp(e * ln(b))
}

// Sine/cosine. Reduction modulo 2*PI, then onto the eighth of a circle;
// Taylor around 0 with 8 terms. AN HONEST LIMIT: the reduction computes in
// double precision, and for very large |x| (beyond roughly 2^30) it eats up
// the digits. That is the usual limit without a Payne-Hanek reduction, and
// it is named here, not hidden.
#[allow_fp]
fn sin_core(r: f64) -> f64 {
    let q: f64 = r * r
    var member: f64 = r
    var sum: f64 = r
    var i: i64 = 1
    while i <= 9 {
        member = 0.0 - member * q / (((2 * i) * (2 * i + 1)) as f64)
        sum = sum + member
        i = i + 1
    }
    return sum
}

#[allow_fp]
fn cos_core(r: f64) -> f64 {
    let q: f64 = r * r
    var member: f64 = 1.0
    var sum: f64 = 1.0
    var i: i64 = 1
    while i <= 9 {
        member = 0.0 - member * q / (((2 * i - 1) * (2 * i)) as f64)
        sum = sum + member
        i = i + 1
    }
    return sum
}

#[allow_fp]
fn sin(x: f64) -> f64 {
    if is_nan(x) || is_infinite(x) {
        return NAN()
    }
    var r: f64 = fmod(x, TAU())
    if r > PI() {
        r = r - TAU()
    }
    if r < 0.0 - PI() {
        r = r + TAU()
    }
    // Mirror onto [-PI/2, PI/2]: sin(PI - r) = sin(r).
    if r > PI() / 2.0 {
        r = PI() - r
    }
    if r < 0.0 - PI() / 2.0 {
        r = 0.0 - PI() - r
    }
    return sin_core(r)
}

#[allow_fp]
fn cos(x: f64) -> f64 {
    return sin(x + PI() / 2.0)
}

#[allow_fp]
fn tan(x: f64) -> f64 {
    let c: f64 = cos(x)
    if c == 0.0 {
        return NAN()
    }
    return sin(x) / c
}

// The arc tangent. Reduction onto [0, tan(PI/12)] through two identities,
// then the series -- that keeps the argument small enough for twelve terms
// to be sufficient.
#[allow_fp]
fn atan(x: f64) -> f64 {
    if is_nan(x) {
        return x
    }
    if is_infinite(x) {
        if x > 0.0 {
            return PI() / 2.0
        }
        return 0.0 - PI() / 2.0
    }
    if x < 0.0 {
        return 0.0 - atan(0.0 - x)
    }
    if x > 1.0 {
        return PI() / 2.0 - atan(1.0 / x)
    }
    // tan(PI/12) = 2 - sqrt(3); above it, apply the addition formula.
    if x > 0.2679491924311227 {
        let w: f64 = (x * 1.7320508075688772 - 1.0) / (x + 1.7320508075688772)
        return PI() / 6.0 + atan(w)
    }
    let q: f64 = x * x
    var member: f64 = x
    var sum: f64 = x
    var i: i64 = 1
    while i <= 14 {
        member = 0.0 - member * q
        sum = sum + member / ((2 * i + 1) as f64)
        i = i + 1
    }
    return sum
}

// The angle of the point (x, y) over the range (-PI, PI].
#[allow_fp]
fn atan2(y: f64, x: f64) -> f64 {
    if x > 0.0 {
        return atan(y / x)
    }
    if x < 0.0 {
        if y >= 0.0 {
            return atan(y / x) + PI()
        }
        return atan(y / x) - PI()
    }
    if y > 0.0 {
        return PI() / 2.0
    }
    if y < 0.0 {
        return 0.0 - PI() / 2.0
    }
    return 0.0
}

// An approximate comparison: |a - b| <= eps * max(1, |a|, |b|). The one
// every floating point test needs -- and that everybody writes wrong.
#[allow_fp]
fn near(a: f64, b: f64, eps: f64) -> bool {
    if a == b {
        return true
    }
    if is_nan(a) || is_nan(b) {
        return false
    }
    var m: f64 = 1.0
    if fabs(a) > m {
        m = fabs(a)
    }
    if fabs(b) > m {
        m = fabs(b)
    }
    return fabs(a - b) <= eps * m
}

// ---------------------------------------------- ROUND 71: the single width
//
// `f32` has no name of its own in this module; it carries the suffix `32`,
// because Firn knows no overloading and a second `sqrt` would be a second
// name anyway. Everything here is EXACT, and for a reason that is worth
// writing down: a computation on a binary32 value carried out in binary64
// and rounded back once is correctly rounded, as long as the intermediate
// format has at least 2p+2 = 50 bits. Binary64 has 53. So `sqrt32` is not
// an approximation of an approximation -- it is the correctly rounded
// square root, and `floor32`/`ceil32`/`round32`/`trunc32` cannot even round
// at all: their result is a whole number and every whole number in range is
// exactly representable in both widths.

#[allow_fp]
fn math_bits32(x: f32) -> u32 {
    var t: f32 = x
    return *(((&t) as usize) as *mut u32)
}

#[allow_fp]
fn math_f32(b: u32) -> f32 {
    var t: u32 = b
    return *(((&t) as usize) as *mut f32)
}

#[allow_fp]
fn INF32() -> f32 {
    return math_f32(2139095040)
}

#[allow_fp]
fn NAN32() -> f32 {
    return math_f32(2143289344)
}

// The distance from 1.0 to the next binary32: 2^-23.
#[allow_fp]
fn EPSILON32() -> f32 {
    return math_f32(872415232)
}

#[allow_fp]
fn is_nan32(x: f32) -> bool {
    return x != x
}

#[allow_fp]
fn is_infinite32(x: f32) -> bool {
    return (math_bits32(x) & 2147483647) == 2139095040
}

#[allow_fp]
fn is_finite32(x: f32) -> bool {
    return (math_bits32(x) & 2147483647) < 2139095040
}

#[allow_fp]
fn fabs32(x: f32) -> f32 {
    return math_f32(math_bits32(x) & 2147483647)
}

#[allow_fp]
fn fmin32(a: f32, b: f32) -> f32 {
    if is_nan32(a) {
        return b
    }
    if is_nan32(b) {
        return a
    }
    if a < b {
        return a
    }
    return b
}

#[allow_fp]
fn fmax32(a: f32, b: f32) -> f32 {
    if is_nan32(a) {
        return b
    }
    if is_nan32(b) {
        return a
    }
    if a > b {
        return a
    }
    return b
}

#[allow_fp]
fn fclamp32(x: f32, lo: f32, hi: f32) -> f32 {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}

#[allow_fp]
fn trunc32(x: f32) -> f32 {
    return trunc(x as f64) as f32
}

#[allow_fp]
fn floor32(x: f32) -> f32 {
    return floor(x as f64) as f32
}

#[allow_fp]
fn ceil32(x: f32) -> f32 {
    return ceil(x as f64) as f32
}

#[allow_fp]
fn round32(x: f32) -> f32 {
    return round(x as f64) as f32
}

#[allow_fp]
fn sqrt32(x: f32) -> f32 {
    return sqrt(x as f64) as f32
}
