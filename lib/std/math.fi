    var y: u64 = (x + 1) / 2
    while y < x {
        x = y
        y = (x + n / x) / 2
    }
    return x
}

// Integer power, exponent >= 0. 0^0 is 1 (the usual convention).
fn pow(b: i64, e: u64) -> i64 {
