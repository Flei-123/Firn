// lib/std/gcobj.fi -- raw heap objects whose fields hold str / Gc / fn values: the collector scans them as roots.

import std.rt

export { alloc, free }

fn alloc[T](bytes: usize) -> u64 {
    let p: u64 = rt.heap_alloc(bytes)
    gc_track[T](p, bytes)
    return p
}

fn free[T](p: u64, bytes: usize) {
    gc_untrack[T](p)
    rt.heap_free(p, bytes)
}
