// SPDX-License-Identifier: MIT
// lib/std/md5.fi -- MD5, for exactly one purpose (round 76).
//
// NOT A SECURITY PRIMITIVE, AND THE HEADER SAYS SO ON PURPOSE. MD5 is
// BROKEN as a
// cryptographic hash. Collisions can be produced in seconds, and anybody
// who signs, authenticates or stores a password with it is doing something
// wrong. It is here because the OFFLINE MODE OF MINECRAFT prescribes it,
// and for nothing else:
//
//     uuid = md5("OfflinePlayer:" + name), then
//            octet 6: upper nibble := 3     (version 3, a name UUID)
//            octet 8: upper two bits := 10  (variant RFC 4122)
//
// That is what the vanilla server does (`UUIDUtil.createOfflinePlayerUUID`),
// and a server that computes a DIFFERENT UUID gives the same player a
// different identity than every other server -- inventories, permissions
// and statistics all hang on that number. So it is not a place to be
// creative.
//
// PROVEN, not claimed: `tests/1603_md5_uuid.fi` checks the seven test
// vectors of RFC 1321 and, on top of them, four UUIDs that the REAL vanilla
// server 1.20.4 handed out on this machine (tools/mcserver/run.sh captured
// them).
//
// The implementation follows RFC 1321 directly: 64 rounds over a 512 bit
// block, four rounds of sixteen with their own mixing function.
// EVERYTHING RUNS IN u64 AND IS MASKED. `u32` arithmetic would be right
// too, but its overflow behaviour depends on the build mode (SPEC 13), and
// a hash that comes out differently in `--debug` than in `--release-fast`
// would be the worst kind of bug: one that only the customer sees.

import rt

export { md5, md5_offline_uuid }

const M32: u64 = 4294967295

fn rotl(x: u64, n: u64) -> u64 {
    return ((x << n) | (x >> (32 as u64 - n))) & M32
}

// The message in `p`/`n`, the 16 octets of the digest into `out`.
fn md5(p: u64, n: usize, out: u64) {
    var k: [u64; 64] = [
        3614090360, 3905402710, 606105819, 3250441966, 4118548399, 1200080426,
        2821735955, 4249261313, 1770035416, 2336552879, 4294925233, 2304563134,
        1804603682, 4254626195, 2792965006, 1236535329, 4129170786, 3225465664,
        643717713, 3921069994, 3593408605, 38016083, 3634488961, 3889429448,
        568446438, 3275163606, 4107603335, 1163531501, 2850285829, 4243563512,
        1735328473, 2368359562, 4294588738, 2272392833, 1839030562, 4259657740,
        2763975236, 1272893353, 4139469664, 3200236656, 681279174, 3936430074,
        3572445317, 76029189, 3654602809, 3873151461, 530742520, 3299628645,
        4096336452, 1126891415, 2878612391, 4237533241, 1700485571, 2399980690,
        4293915773, 2240044497, 1873313359, 4264355552, 2734768916, 1309151649,
        4149444226, 3174756917, 718787259, 3951481745
    ]
    var s: [u64; 64] = [
        7, 12, 17, 22, 7, 12,
        17, 22, 7, 12, 17, 22,
        7, 12, 17, 22, 5, 9,
        14, 20, 5, 9, 14, 20,
        5, 9, 14, 20, 5, 9,
        14, 20, 4, 11, 16, 23,
        4, 11, 16, 23, 4, 11,
        16, 23, 4, 11, 16, 23,
        6, 10, 15, 21, 6, 10,
        15, 21, 6, 10, 15, 21,
        6, 10, 15, 21
    ]

    var a0: u64 = 1732584193
    var b0: u64 = 4023233417
    var c0: u64 = 2562383102
    var d0: u64 = 271733878

    // The padded length: the message, one 0x80 octet, zeros, and the length
    // in BITS as a little endian 64 bit number. Little endian -- MD5 is a
    // format from the world in which x86 was the only world.
    let total: usize = ((n + 8) / 64 + 1) * 64
    var block: [u8; 64] = [0; 64]
    var off: usize = 0
    while off < total {
        // Fill one block: whatever is left of the message, then the padding.
        var i: usize = 0
        while i < 64 {
            let at: usize = off + i
            if at < n {
                block[i] = rt.ld8(p, at)
            } else if at == n {
                block[i] = 128 as u8
            } else if at + 8 >= total {
                // the eight length octets, little endian
                let sh: u64 = ((at + 8 - total) as u64) * 8
                block[i] = (((n as u64) * 8 >> sh) & 255 as u64) as u8
            } else {
                block[i] = 0 as u8
            }
            i = i + 1
        }

        // The sixteen words of the block, little endian.
        var m: [u64; 16] = [0; 16]
        i = 0
        while i < 16 {
            m[i] = (block[i * 4] as u64)
            | ((block[i * 4 + 1] as u64) << 8)
            | ((block[i * 4 + 2] as u64) << 16)
            | ((block[i * 4 + 3] as u64) << 24)
            i = i + 1
        }

        var a: u64 = a0
        var b: u64 = b0
        var c: u64 = c0
        var d: u64 = d0
        var r: usize = 0
        while r < 64 {
            var f: u64 = 0
            var g: usize = 0
            if r < 16 {
                f = (b & c) | ((b ^ M32) & d)
                g = r
            } else if r < 32 {
                f = (d & b) | ((d ^ M32) & c)
                g = (5 * r + 1) % 16
            } else if r < 48 {
                f = b ^ c ^ d
                g = (3 * r + 5) % 16
            } else {
                f = c ^ (b | (d ^ M32))
                g = (7 * r) % 16
            }
            f = (f + a + k[r] + m[g]) & M32
            a = d
            d = c
            c = b
            b = (b + rotl(f, s[r])) & M32
            r = r + 1
        }
        a0 = (a0 + a) & M32
        b0 = (b0 + b) & M32
        c0 = (c0 + c) & M32
        d0 = (d0 + d) & M32
        off = off + 64
    }

    // The digest, four words little endian.
    var w: [u64; 4] = [a0, b0, c0, d0]
    var i2: usize = 0
    while i2 < 4 {
        var j: usize = 0
        while j < 4 {
            rt.st8(out, i2 * 4 + j, ((w[i2] >> ((j as u64) * 8)) & 255 as u64) as u8)
            j = j + 1
        }
        i2 = i2 + 1
    }
}

// The offline UUID of a player name, as two 64 bit halves (that is how the
// protocol carries it: most significant half first).
//
// The two patches are the whole difference between "an MD5 digest" and "a
// UUID": without them the client accepts the number and every other server
// computes a different one.
fn md5_offline_uuid(name: u64, name_n: usize, high: *mut u64, low: *mut u64) -> bool {
    var prefix: [u8; 15] = "OfflinePlayer:\0"
    var buf: [u8; 128] = [0; 128]
    if name_n + 14 > 128 {
        *high = 0
        *low = 0
        return false
    }
    var i: usize = 0
    while i < 14 {
        buf[i] = prefix[i]
        i = i + 1
    }
    i = 0
    while i < name_n {
        buf[14 + i] = rt.ld8(name, i)
        i = i + 1
    }
    var digest: [u8; 16] = [0; 16]
    md5((&buf[0]) as u64, 14 + name_n, (&digest[0]) as u64)
    // version 3 (a name based UUID) into the upper nibble of octet 6
    digest[6] = (digest[6] & 15 as u8) | 48 as u8
    // variant RFC 4122 into the upper two bits of octet 8
    digest[8] = (digest[8] & 63 as u8) | 128 as u8
    var h: u64 = 0
    var l: u64 = 0
    i = 0
    while i < 8 {
        h = (h << 8) | (digest[i] as u64)
        l = (l << 8) | (digest[8 + i] as u64)
        i = i + 1
    }
    *high = h
    *low = l
    return true
}
