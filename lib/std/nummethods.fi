import std.math

impl i32 {
    fn abs(*self) -> i32 { if *self < 0 { return 0 - *self } return *self }
    fn min(*self, other: i32) -> i32 { if other < *self { return other } return *self }
    fn max(*self, other: i32) -> i32 { if other > *self { return other } return *self }
    fn clamp(*self, lo: i32, hi: i32) -> i32 { if *self < lo { return lo } if *self > hi { return hi } return *self }
    fn pow(*self, exp: u32) -> i32 { return math.pow((*self) as i64, exp as u64) as i32 }
}

impl i64 {
    fn abs(*self) -> i64 { return math.abs(*self) }
    fn min(*self, other: i64) -> i64 { return math.min(*self, other) }
    fn max(*self, other: i64) -> i64 { return math.max(*self, other) }
    fn clamp(*self, lo: i64, hi: i64) -> i64 { return math.clamp(*self, lo, hi) }
    fn pow(*self, exp: u32) -> i64 { return math.pow(*self, exp as u64) }
}

impl usize {
    fn min(*self, other: usize) -> usize { if other < *self { return other } return *self }
    fn max(*self, other: usize) -> usize { if other > *self { return other } return *self }
    fn clamp(*self, lo: usize, hi: usize) -> usize { if *self < lo { return lo } if *self > hi { return hi } return *self }
}

impl f64 {
    fn abs(*self) -> f64 { return math.fabs(*self) }
    fn min(*self, other: f64) -> f64 { if other < *self { return other } return *self }
    fn max(*self, other: f64) -> f64 { if other > *self { return other } return *self }
    fn clamp(*self, lo: f64, hi: f64) -> f64 { if *self < lo { return lo } if *self > hi { return hi } return *self }
    fn pow(*self, exp: f64) -> f64 { return math.powf(*self, exp) }
    fn sqrt(*self) -> f64 { return math.sqrt(*self) }
    fn sin(*self) -> f64 { return math.sin(*self) }
    fn cos(*self) -> f64 { return math.cos(*self) }
    fn tan(*self) -> f64 { return math.tan(*self) }
    fn floor(*self) -> f64 { return math.floor(*self) }
    fn ceil(*self) -> f64 { return math.ceil(*self) }
    fn round(*self) -> f64 { return math.round(*self) }
    fn trunc(*self) -> f64 { return math.trunc(*self) }
    fn to_int(*self) -> i32 { return (*self) as i32 }
}
