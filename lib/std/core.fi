// lib/str/core_mem.fi -- memory work WITHOUT the operating system (round 73).
//
// The pure half of `lib/str/alloc.fi`: copying, comparing, zeroing and the
// raw load/store helpers for the 8/16/32/64 bit elements of a block.
// Not one of these functions asks anybody for memory and not one of them
// makes a system call -- they work on memory that the CALLER already
// holds. That is exactly the line along which round 73 cuts the library
// (docs/ROUND73.md): whatever stands here may be used under
// `profile kernel`.
//
// `page_round` stands here as well although it smells of mmap: it is
// arithmetic on a number and nothing else. Whoever rounds a length to
// pages has not yet asked for a single page.
//
// Include:  //#include lib/str/core_mem.fi

fn page_round(n: usize) -> usize {
    return (n + 4095) / 4096 * 4096
}

fn mem_copy(dst: *mut u8, src: *mut u8, n: usize) {
    var i: usize = 0
    while i < n {
        *((dst as usize + i) as *mut u8) = *((src as usize + i) as *mut u8)
        i = i + 1
    }
}

fn mem_zero(dst: *mut u8, n: usize) {
    var i: usize = 0
    while i < n {
        *((dst as usize + i) as *mut u8) = 0 as u8
        i = i + 1
    }
}

fn mem_eq(a: *mut u8, b: *mut u8, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        if *((a as usize + i) as *mut u8) != *((b as usize + i) as *mut u8) {
            return false
        }
        i = i + 1
    }
    return true
}

// Raw read/write helpers for the 16/32/64 bit elements of a block.
fn ld16(p: *mut u8, i: usize) -> u16 {
    return *((p as usize + i * 2) as *mut u16)
}
fn st16(p: *mut u8, i: usize, v: u16) {
    *((p as usize + i * 2) as *mut u16) = v
}
fn ld32(p: *mut u8, i: usize) -> u32 {
    return *((p as usize + i * 4) as *mut u32)
}
fn st32(p: *mut u8, i: usize, v: u32) {
    *((p as usize + i * 4) as *mut u32) = v
}
fn ld64(p: *mut u8, i: usize) -> u64 {
    return *((p as usize + i * 8) as *mut u64)
}
fn st64(p: *mut u8, i: usize, v: u64) {
    *((p as usize + i * 8) as *mut u64) = v
}
fn ld8(p: *mut u8, i: usize) -> u8 {
    return *((p as usize + i) as *mut u8)
}
fn st8(p: *mut u8, i: usize, v: u8) {
    *((p as usize + i) as *mut u8) = v
}

// lib/str/core_cp.fi -- the replacement character (round 73).
//
// U+FFFD, the code point that every UTF-8 reader delivers for an invalid
// octet. It stands in a file of its own for ONE reason: the reading side
// of the facade (lib/str/core_facade.fi) needs it and works without an
// allocator, while the writing side (lib/str/utf8.fi) appends to a
// `*mut Bytes` and thereby owns memory. `lib/std/core.fi` takes only the
// reading side and would otherwise be missing the constant;
// `lib/std/str.fi` takes both and must not get it twice.
//
// Include:  //#include lib/str/core_cp.fi

const REPLACEMENT_CP: u32 = 0xFFFD

// lib/str/core_facade.fi -- the READING half of the text facade (round 73).
//
// Cut out of `lib/str/std_facade.fi` along ONE line: everything here works
// on memory that somebody else holds. `Span` is a pointer and a length; it
// owns nothing, it allocates nothing, it makes no system call. That is why
// this file may be used under `profile kernel` -- it is included by
// `lib/std/core.fi` (the freestanding half of the library) AND by
// `lib/std/str.fi` (the full facade), so there is exactly ONE source text
// for the searching, comparing, trimming, splitting and UTF-8 reading of
// text, and no second truth.
//
// WHAT IS NOT HERE: everything that PRODUCES text. `append`, `replace`,
// `after_big`, `fill_left` and their kin write into a `*mut Bytes`, and a
// `Bytes` owns memory -- they stayed behind in `lib/str/std_facade.fi`.
//
// Include:  //#include lib/str/core_facade.fi

fn npos() -> usize {
    var x: usize = 0
    return x - 1
}

// -------------------------------------------------------------------- Span

struct Span {
    p: *mut u8,
    n: usize,
}

fn span(p: *mut u8, n: usize) -> Span {
    return Span { p: p, n: n }
}

fn span_empty() -> Span {
    return Span { p: 0 as *mut u8, n: 0 }
}

// Length of a null terminated sequence.
fn c_length(p: *mut u8) -> usize {
    if (p as usize) == 0 {
        return 0
    }
    var n: usize = 0
    while ld8(p, n) != 0 as u8 {
        n = n + 1
    }
    return n
}

// A view of a null terminated sequence (without the null octet).
fn span_of_c(p: *mut u8) -> Span {
    return Span { p: p, n: c_length(p) }
}

fn is_empty(s: Span) -> bool {
    return s.n == 0
}

fn length(s: Span) -> usize {
    return s.n
}

// The octet at position `i`; past the end 0 -- just like `bytes_at`.
fn chars(s: Span, i: usize) -> u8 {
    if i >= s.n {
        return 0 as u8
    }
    return ld8(s.p, i)
}

// The piece starting at `of`, at most `how_much` octets. Both bounds are
// CLAMPED instead of reported: a view can never become invalid.
fn span_part(s: Span, of: usize, how_much: usize) -> Span {
    if of >= s.n {
        return Span { p: s.p, n: 0 }
    }
    var rest: usize = s.n - of
    if how_much < rest {
        rest = how_much
    }
    return Span { p: (s.p as usize + of) as *mut u8, n: rest }
}

fn span_ab(s: Span, of: usize) -> Span {
    return span_part(s, of, s.n)
}

fn span_to(s: Span, to: usize) -> Span {
    return span_part(s, 0, to)
}

// ------------------------------------------------------- Character classes
//
// ASCII. `is_whitespace` follows the same set the Firn lexer treats as
// separating: space, tab, line feed, carriage return, vertical tab,
// form feed.

fn is_whitespace(c: u8) -> bool {
    return c == 32 as u8 || c == 9 as u8 || c == 10 as u8 || c == 13 as u8 ||
    c == 11 as u8 || c == 12 as u8
}

fn is_digit(c: u8) -> bool {
    return c >= 48 as u8 && c <= 57 as u8
}

fn is_hex_digit(c: u8) -> bool {
    return is_digit(c) || (c >= 97 as u8 && c <= 102 as u8) ||
    (c >= 65 as u8 && c <= 70 as u8)
}

fn is_upper_letter(c: u8) -> bool {
    return c >= 65 as u8 && c <= 90 as u8
}

fn is_lower_letter(c: u8) -> bool {
    return c >= 97 as u8 && c <= 122 as u8
}

fn is_letter(c: u8) -> bool {
    return is_upper_letter(c) || is_lower_letter(c)
}

fn is_alphanumeric(c: u8) -> bool {
    return is_letter(c) || is_digit(c)
}

// The value of a hex digit, otherwise -1.
fn hex_value(c: u8) -> i32 {
    if is_digit(c) {
        return (c - 48 as u8) as i32
    }
    if c >= 97 as u8 && c <= 102 as u8 {
        return (c - 87 as u8) as i32
    }
    if c >= 65 as u8 && c <= 70 as u8 {
        return (c - 55 as u8) as i32
    }
    return 0 - 1
}

fn big_char(c: u8) -> u8 {
    if is_lower_letter(c) {
        return c - 32 as u8
    }
    return c
}

fn small_char(c: u8) -> u8 {
    if is_upper_letter(c) {
        return c + 32 as u8
    }
    return c
}

// -------------------------------------------------------------- Comparison

fn equal(a: Span, b: Span) -> bool {
    if a.n != b.n {
        return false
    }
    return mem_eq(a.p, b.p, a.n)
}

// Lexicographic over the octets; on a common prefix the length decides.
// -1 = a before b, 0 = equal, 1 = a after b.
fn compare(a: Span, b: Span) -> i32 {
    var m: usize = a.n
    if b.n < m {
        m = b.n
    }
    var i: usize = 0
    while i < m {
        let x: u8 = ld8(a.p, i)
        let y: u8 = ld8(b.p, i)
        if x < y {
            return 0 - 1
        }
        if x > y {
            return 1
        }
        i = i + 1
    }
    if a.n < b.n {
        return 0 - 1
    }
    if a.n > b.n {
        return 1
    }
    return 0
}

fn equal_without_case(a: Span, b: Span) -> bool {
    if a.n != b.n {
        return false
    }
    var i: usize = 0
    while i < a.n {
        if small_char(ld8(a.p, i)) != small_char(ld8(b.p, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

fn compare_without_case(a: Span, b: Span) -> i32 {
    var m: usize = a.n
    if b.n < m {
        m = b.n
    }
    var i: usize = 0
    while i < m {
        let x: u8 = small_char(ld8(a.p, i))
        let y: u8 = small_char(ld8(b.p, i))
        if x < y {
            return 0 - 1
        }
        if x > y {
            return 1
        }
        i = i + 1
    }
    if a.n < b.n {
        return 0 - 1
    }
    if a.n > b.n {
        return 1
    }
    return 0
}

fn starts_with(s: Span, part: Span) -> bool {
    if part.n > s.n {
        return false
    }
    return mem_eq(s.p, part.p, part.n)
}

fn ends_with(s: Span, part: Span) -> bool {
    if part.n > s.n {
        return false
    }
    return mem_eq((s.p as usize + (s.n - part.n)) as *mut u8, part.p, part.n)
}

// --------------------------------------------------------------- Searching

fn find_char_ab(s: Span, c: u8, ab: usize) -> usize {
    var i: usize = ab
    while i < s.n {
        if ld8(s.p, i) == c {
            return i
        }
        i = i + 1
    }
    return npos()
}

fn find_char(s: Span, c: u8) -> usize {
    return find_char_ab(s, c, 0)
}

fn find_char_back(s: Span, c: u8) -> usize {
    var i: usize = s.n
    while i > 0 {
        i = i - 1
        if ld8(s.p, i) == c {
            return i
        }
    }
    return npos()
}

// An EMPTY needle is found at `ab` -- the same rule as in C# and Rust; it
// turns `replace` with an empty `old` into a no-op instead of an endless
// loop.
fn find_ab(s: Span, part: Span, ab: usize) -> usize {
    if part.n == 0 {
        if ab > s.n {
            return npos()
        }
        return ab
    }
    if part.n > s.n {
        return npos()
    }
    let last: usize = s.n - part.n
    var i: usize = ab
    while i <= last {
        if mem_eq((s.p as usize + i) as *mut u8, part.p, part.n) {
            return i
        }
        i = i + 1
    }
    return npos()
}

fn find(s: Span, part: Span) -> usize {
    return find_ab(s, part, 0)
}

fn find_back(s: Span, part: Span) -> usize {
    if part.n == 0 {
        return s.n
    }
    if part.n > s.n {
        return npos()
    }
    var i: usize = s.n - part.n + 1
    while i > 0 {
        i = i - 1
        if mem_eq((s.p as usize + i) as *mut u8, part.p, part.n) {
            return i
        }
    }
    return npos()
}

fn contains(s: Span, part: Span) -> bool {
    return find(s, part) != npos()
}

fn contains_char(s: Span, c: u8) -> bool {
    return find_char(s, c) != npos()
}

fn count_char(s: Span, c: u8) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < s.n {
        if ld8(s.p, i) == c {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// Non overlapping occurrences. An empty needle: 0 (otherwise the answer
// would be "infinite" or arbitrary).
fn count_part(s: Span, part: Span) -> usize {
    if part.n == 0 || part.n > s.n {
        return 0
    }
    var n: usize = 0
    var i: usize = 0
    while true {
        let f: usize = find_ab(s, part, i)
        if f == npos() {
            return n
        }
        n = n + 1
        i = f + part.n
        if i > s.n {
            return n
        }
    }
    return n
}

// The first octet that is NOT in `set` -- the basis of every trim with a
// character set of your own.
fn find_not_out(s: Span, set: Span, ab: usize) -> usize {
    var i: usize = ab
    while i < s.n {
        if !contains_char(set, ld8(s.p, i)) {
            return i
        }
        i = i + 1
    }
    return npos()
}

// ---------------------------------------------------------------- Trimming

fn trim_left(s: Span) -> Span {
    var i: usize = 0
    while i < s.n && is_whitespace(ld8(s.p, i)) {
        i = i + 1
    }
    return span_ab(s, i)
}

fn trim_right(s: Span) -> Span {
    var e: usize = s.n
    while e > 0 && is_whitespace(ld8(s.p, e - 1)) {
        e = e - 1
    }
    return span_to(s, e)
}

fn trim(s: Span) -> Span {
    return trim_right(trim_left(s))
}

// Trims every octet that is in `set`.
fn trim_set(s: Span, set: Span) -> Span {
    var a: usize = 0
    while a < s.n && contains_char(set, ld8(s.p, a)) {
        a = a + 1
    }
    var e: usize = s.n
    while e > a && contains_char(set, ld8(s.p, e - 1)) {
        e = e - 1
    }
    return span_part(s, a, e - a)
}

// Cut off a prefix/suffix if it is there -- otherwise unchanged.
fn without_prefix(s: Span, part: Span) -> Span {
    if starts_with(s, part) {
        return span_ab(s, part.n)
    }
    return s
}

fn without_suffix(s: Span, part: Span) -> Span {
    if ends_with(s, part) {
        return span_to(s, s.n - part.n)
    }
    return s
}

// --------------------------------------------------------------- Splitting
//
// A CURSOR, not a list: in this module Firn has no `Vec` (lib/str is an
// include library without module structure), and a cursor is the form that
// allocates nothing anyway.
//
//     var t: str.Divisor = str.divisor_new(source, sep)
//     var part: str.Span = str.span_empty()
//     while str.divisor_next(&t, &part) { ... }
//
// Rules (like C# String.Split without RemoveEmptyEntries):
//   * "a,b,,c" with "," yields "a", "b", "", "c"
//   * "" yields exactly ONE empty piece
//   * an empty separator yields exactly ONE piece: the whole source
//   * `divisor_whitespace` collapses runs of whitespace and NEVER yields an
//     empty piece -- that is the form you want when taking a command line
//     apart.

const DIVISOR_SEP: u32 = 0
const DIVISOR_WHITESPACE: u32 = 1

struct Divisor {
    source: Span,
    sep: Span,
    i: usize,
    mode: u32,
    done: bool,
}

fn divisor_new(s: Span, sep: Span) -> Divisor {
    return Divisor { source: s, sep: sep, i: 0,
        mode: DIVISOR_SEP, done: false }
}

fn divisor_whitespace(s: Span) -> Divisor {
    return Divisor { source: s, sep: span_empty(), i: 0,
        mode: DIVISOR_WHITESPACE, done: false }
}

fn divisor_next(t: *mut Divisor, out: *mut Span) -> bool {
    if (*t).done {
        return false
    }
    var s: Span = (*t).source
    if (*t).mode == DIVISOR_WHITESPACE {
        var i: usize = (*t).i
        while i < s.n && is_whitespace(ld8(s.p, i)) {
            i = i + 1
        }
        if i >= s.n {
            (*t).i = s.n
            (*t).done = true
            return false
        }
        let start: usize = i
        while i < s.n && !is_whitespace(ld8(s.p, i)) {
            i = i + 1
        }
        (*t).i = i
        (*out).p = (s.p as usize + start) as *mut u8
        (*out).n = i - start
        return true
    }
    var tr: Span = (*t).sep
    let start: usize = (*t).i
    if tr.n == 0 {
        (*t).done = true
        (*out).p = s.p
        (*out).n = s.n
        return true
    }
    let f: usize = find_ab(s, tr, start)
    if f == npos() {
        (*t).done = true
        var rest: Span = span_ab(s, start)
        (*out).p = rest.p
        (*out).n = rest.n
        return true
    }
    (*out).p = (s.p as usize + start) as *mut u8
    (*out).n = f - start
    (*t).i = f + tr.n
    return true
}

// How many pieces `divisor_new` is going to yield -- for the caller who
// wants to make room beforehand.
fn parts_count(s: Span, sep: Span) -> usize {
    if sep.n == 0 {
        return 1
    }
    return count_part(s, sep) + 1
}

// --------------------------------------------------------- UTF-8 iteration
//
// `utf8_is_valid` (lib/str/utf8.fi) says WHETHER a sequence is valid. Here
// stands how to WALK over it without reaching into the middle of a character.
//
// `utf8_read` checks the same rules as `utf8_is_valid`: overlong encodings,
// surrogates (U+D800..U+DFFF) and everything above U+10FFFF are INVALID.
// An invalid octet is reported as ONE character with `valid = false`
// (cp = U+FFFD), so that every loop is guaranteed to make progress.

struct CharHit {
    cp: u32,
    length: usize,
    valid: bool,
}

fn is_cont_byte(c: u8) -> bool {
    return (c & 0xC0 as u8) == 0x80 as u8
}

fn utf8_bad_char() -> CharHit {
    return CharHit { cp: REPLACEMENT_CP, length: 1, valid: false }
}

fn utf8_read(s: Span, i: usize) -> CharHit {
    if i >= s.n {
        return CharHit { cp: 0, length: 0, valid: false }
    }
    let c0: u8 = ld8(s.p, i)
    if c0 < 0x80 as u8 {
        return CharHit { cp: c0 as u32, length: 1, valid: true }
    }
    if c0 < 0xC2 as u8 {
        // 0x80..0xBF are continuation octets, 0xC0/0xC1 would be overlong.
        return utf8_bad_char()
    }
    if c0 < 0xE0 as u8 {
        if i + 1 >= s.n {
            return utf8_bad_char()
        }
        let c1: u8 = ld8(s.p, i + 1)
        if !is_cont_byte(c1) {
            return utf8_bad_char()
        }
        let cp: u32 = ((c0 as u32 & 0x1F) << 6) | (c1 as u32 & 0x3F)
        return CharHit { cp: cp, length: 2, valid: true }
    }
    if c0 < 0xF0 as u8 {
        if i + 2 >= s.n {
            return utf8_bad_char()
        }
        let c1: u8 = ld8(s.p, i + 1)
        let c2: u8 = ld8(s.p, i + 2)
        if !is_cont_byte(c1) || !is_cont_byte(c2) {
            return utf8_bad_char()
        }
        let cp: u32 = ((c0 as u32 & 0x0F) << 12) | ((c1 as u32 & 0x3F) << 6) |
        (c2 as u32 & 0x3F)
        if cp < 0x800 {
            return utf8_bad_char()
        }
        if cp >= 0xD800 && cp <= 0xDFFF {
            return utf8_bad_char()
        }
        return CharHit { cp: cp, length: 3, valid: true }
    }
    if c0 < 0xF5 as u8 {
        if i + 3 >= s.n {
            return utf8_bad_char()
        }
        let c1: u8 = ld8(s.p, i + 1)
        let c2: u8 = ld8(s.p, i + 2)
        let c3: u8 = ld8(s.p, i + 3)
        if !is_cont_byte(c1) || !is_cont_byte(c2) || !is_cont_byte(c3) {
            return utf8_bad_char()
        }
        let cp: u32 = ((c0 as u32 & 0x07) << 18) | ((c1 as u32 & 0x3F) << 12) |
        ((c2 as u32 & 0x3F) << 6) | (c3 as u32 & 0x3F)
        if cp < 0x10000 || cp > 0x10FFFF {
            return utf8_bad_char()
        }
        return CharHit { cp: cp, length: 4, valid: true }
    }
    return utf8_bad_char()
}

// The index of the next character start. At the end: s.n.
fn utf8_next(s: Span, i: usize) -> usize {
    if i >= s.n {
        return s.n
    }
    let z: CharHit = utf8_read(s, i)
    var l: usize = z.length
    if l == 0 {
        l = 1
    }
    if i + l > s.n {
        return s.n
    }
    return i + l
}

// The index of the previous character start. At 0 it stays 0.
fn utf8_before(s: Span, i: usize) -> usize {
    if i == 0 {
        return 0
    }
    var j: usize = i
    if j > s.n {
        j = s.n
    }
    var k: usize = 0
    while k < 4 {
        if j == 0 {
            return 0
        }
        j = j - 1
        if !is_cont_byte(ld8(s.p, j)) {
            return j
        }
        k = k + 1
    }
    return j
}

fn utf8_is_limit(s: Span, i: usize) -> bool {
    if i == 0 || i >= s.n {
        return true
    }
    return !is_cont_byte(ld8(s.p, i))
}

// The number of characters (not octets). An invalid octet counts as one.
fn utf8_count(s: Span) -> usize {
    var i: usize = 0
    var n: usize = 0
    while i < s.n {
        i = utf8_next(s, i)
        n = n + 1
    }
    return n
}

// A piece BY CHARACTER instead of by octet -- the cut therefore never lands
// in the middle of a character.
fn utf8_part(s: Span, of_char: usize, count: usize) -> Span {
    var i: usize = 0
    var z: usize = 0
    while z < of_char && i < s.n {
        i = utf8_next(s, i)
        z = z + 1
    }
    let start: usize = i
    var g: usize = 0
    while g < count && i < s.n {
        i = utf8_next(s, i)
        g = g + 1
    }
    return span_part(s, start, i - start)
}

// lib/str/core_impl.fi -- the METHODS of the reading text view (round 73).
//
// Cut out of `lib/str/std_impl.fi` along the same line as the free
// functions: `Span` is a VIEW, it owns nothing and allocates nothing, so
// its methods belong to the freestanding half of the library. The file is
// included by `lib/std/core.fi` and by `lib/std/str.fi` -- one source
// text, two front doors.
//
// NOTHING BUT WRAPPERS. Every method calls exactly the free function that
// already exists and does nothing else; there is no second implementation
// that could drift apart. `Span` is passed around by value, so its methods
// take `self` (compiler/src/impls.rs).
//
// Include:  //#include lib/str/core_impl.fi

// -------------------------------------------------------------------- Span
//
// The reading view. Everything here asks a question about text, it never
// changes it; nothing allocates.
impl Span {
    fn length(self) -> usize { return length(self) }
    fn is_empty(self) -> bool { return is_empty(self) }
    fn chars(self, i: usize) -> u8 { return chars(self, i) }
    fn part(self, of: usize, how_much: usize) -> Span {
        return span_part(self, of, how_much)
    }
    fn ab(self, of: usize) -> Span { return span_ab(self, of) }
    fn to(self, to: usize) -> Span { return span_to(self, to) }
    fn equal(self, b: Span) -> bool { return equal(self, b) }
    fn compare(self, b: Span) -> i32 { return compare(self, b) }
    fn equal_without_case(self, b: Span) -> bool {
        return equal_without_case(self, b)
    }
    fn starts_with(self, part: Span) -> bool { return starts_with(self, part) }
    fn ends_with(self, part: Span) -> bool { return ends_with(self, part) }
    fn find(self, part: Span) -> usize { return find(self, part) }
    fn find_back(self, part: Span) -> usize { return find_back(self, part) }
    fn find_char(self, c: u8) -> usize { return find_char(self, c) }
    fn contains(self, part: Span) -> bool { return contains(self, part) }
    fn count_char(self, c: u8) -> usize { return count_char(self, c) }
    fn count_part(self, part: Span) -> usize { return count_part(self, part) }
    fn trim(self) -> Span { return trim(self) }
    fn trim_left(self) -> Span { return trim_left(self) }
    fn trim_right(self) -> Span { return trim_right(self) }
    fn without_prefix(self, part: Span) -> Span { return without_prefix(self, part) }
    fn without_suffix(self, part: Span) -> Span { return without_suffix(self, part) }
    fn utf8_char(self) -> usize { return utf8_count(self) }
    fn utf8_part(self, of_char: usize, count: usize) -> Span {
        return utf8_part(self, of_char, count)
    }
}

// lib/num/bignum.fi -- big numbers (unsigned) for strtod/dtoa.
//
// Representation: a sequence of u32 digits, least significant first, in a
// block of memory provided by the caller. `n` is the number of digits in
// use (leading zero digits are cut off), `cap` is the capacity.
// Every computation is exact -- that is exactly what a correctly rounded
// strtod and the shortest output need.
//
// Include:  //#include lib/num/bignum.fi   (needs lib/str/alloc.fi)

const BN_LIMBS: usize = 512 // 512 * 32 bit = 16384 bit, enough for
// 10^400 * 10^780 including the shifts

struct Bn {
    d: *mut u8,
    n: usize,
    cap: usize,
}

fn bn_init(b: *mut Bn, mem: *mut u8, cap: usize) {
    (*b).d = mem
    (*b).n = 0
    (*b).cap = cap
}

fn bn_limb(b: *mut Bn, i: usize) -> u32 {
    if i >= (*b).n {
        return 0 as u32
    }
    return ld32((*b).d, i)
}

fn bn_setlimb(b: *mut Bn, i: usize, v: u32) {
    if i >= (*b).cap {
        return
    }
    st32((*b).d, i, v)
    if i >= (*b).n {
        var k: usize = (*b).n
        while k < i {
            st32((*b).d, k, 0 as u32)
            k = k + 1
        }
        (*b).n = i + 1
    }
}

fn bn_norm(b: *mut Bn) {
    while (*b).n > 0 {
        if ld32((*b).d, (*b).n - 1) != 0 as u32 {
            return
        }
        (*b).n = (*b).n - 1
    }
}

fn bn_zero(b: *mut Bn) {
    (*b).n = 0
}

fn bn_is_zero(b: *mut Bn) -> bool {
    return (*b).n == 0
}

fn bn_set_u64(b: *mut Bn, v: u64) {
    (*b).n = 0
    if v == 0 {
        return
    }
    st32((*b).d, 0, (v & 0xFFFFFFFF) as u32)
    (*b).n = 1
    if v >= 4294967296 {
        st32((*b).d, 1, (v >> 32) as u32)
        (*b).n = 2
    }
}

fn bn_copy(dst: *mut Bn, src: *mut Bn) {
    var i: usize = 0
    while i < (*src).n {
        st32((*dst).d, i, ld32((*src).d, i))
        i = i + 1
    }
    (*dst).n = (*src).n
}

fn bn_cmp(a: *mut Bn, b: *mut Bn) -> i32 {
    if (*a).n != (*b).n {
        if (*a).n < (*b).n {
            return -1
        }
        return 1
    }
    var i: usize = (*a).n
    while i > 0 {
        i = i - 1
        let x: u32 = ld32((*a).d, i)
        let y: u32 = ld32((*b).d, i)
        if x != y {
            if x < y {
                return -1
            }
            return 1
        }
    }
    return 0
}

// a += b
fn bn_add(a: *mut Bn, b: *mut Bn) {
    var carry: u64 = 0
    var i: usize = 0
    var m: usize = (*a).n
    if (*b).n > m {
        m = (*b).n
    }
    while i < m || carry != 0 {
        if i >= (*a).cap {
            return
        }
        let s: u64 = bn_limb(a, i) as u64 + bn_limb(b, i) as u64 + carry
        bn_setlimb(a, i, (s & 0xFFFFFFFF) as u32)
        carry = s >> 32
        i = i + 1
    }
    bn_norm(a)
}

// a -= b, precondition a >= b
fn bn_sub(a: *mut Bn, b: *mut Bn) {
    var borrow: u64 = 0
    var i: usize = 0
    while i < (*a).n {
        let x: u64 = bn_limb(a, i) as u64
        let y: u64 = bn_limb(b, i) as u64 + borrow
        if x >= y {
            st32((*a).d, i, (x - y) as u32)
            borrow = 0
        } else {
            st32((*a).d, i, (x + 4294967296 - y) as u32)
            borrow = 1
        }
        i = i + 1
    }
    bn_norm(a)
}

// a *= m
fn bn_mul_small(a: *mut Bn, m: u32) {
    if m == 0 as u32 {
        bn_zero(a)
        return
    }
    var carry: u64 = 0
    var i: usize = 0
    let n: usize = (*a).n
    while i < n {
        let p: u64 = ld32((*a).d, i) as u64 * m as u64 + carry
        st32((*a).d, i, (p & 0xFFFFFFFF) as u32)
        carry = p >> 32
        i = i + 1
    }
    while carry != 0 {
        bn_setlimb(a, i, (carry & 0xFFFFFFFF) as u32)
        carry = carry >> 32
        i = i + 1
    }
    bn_norm(a)
}

// a += v
fn bn_add_small(a: *mut Bn, v: u32) {
    var carry: u64 = v as u64
    var i: usize = 0
    while carry != 0 {
        let s: u64 = bn_limb(a, i) as u64 + carry
        bn_setlimb(a, i, (s & 0xFFFFFFFF) as u32)
        carry = s >> 32
        i = i + 1
    }
    bn_norm(a)
}

fn bn_bitlen(a: *mut Bn) -> usize {
    if (*a).n == 0 {
        return 0
    }
    var v: u32 = ld32((*a).d, (*a).n - 1)
    var bits: usize = 0
    while v != 0 as u32 {
        v = v >> 1
        bits = bits + 1
    }
    return ((*a).n - 1) * 32 + bits
}

// a <<= bits
fn bn_shl(a: *mut Bn, bits: usize) {
    if (*a).n == 0 || bits == 0 {
        return
    }
    let words: usize = bits / 32
    let sh: usize = bits % 32
    var i: usize = (*a).n
    if sh == 0 {
        while i > 0 {
            i = i - 1
            bn_setlimb(a, i + words, ld32((*a).d, i))
        }
    } else {
        // the new top digit first
        let top: u32 = ld32((*a).d, (*a).n - 1) >> (32 - sh)
        if top != 0 as u32 {
            bn_setlimb(a, (*a).n + words, top)
        }
        while i > 0 {
            i = i - 1
            var v: u32 = ld32((*a).d, i) << sh
            if i > 0 {
                v = v + (ld32((*a).d, i - 1) >> (32 - sh))
            }
            bn_setlimb(a, i + words, v)
        }
    }
    var k: usize = 0
    while k < words {
        st32((*a).d, k, 0 as u32)
        k = k + 1
    }
    bn_norm(a)
}

// a *= 10^e
fn bn_mul_pow10(a: *mut Bn, e: usize) {
    var r: usize = e
    while r >= 9 {
        bn_mul_small(a, 1000000000 as u32)
        r = r - 9
    }
    var m: u32 = 1 as u32
    var k: usize = 0
    while k < r {
        m = m * 10 as u32
        k = k + 1
    }
    if m != 1 as u32 {
        bn_mul_small(a, m)
    }
}

// dst = 10^e
fn bn_pow10(dst: *mut Bn, e: usize) {
    bn_set_u64(dst, 1)
    bn_mul_pow10(dst, e)
}

// Integer division: returns the floor of num/`the` as a u64 and leaves the
// remainder in `num`. Precondition: the quotient fits in 64 bit (the caller
// scales beforehand). `tmp` is scratch memory.
fn bn_div_q(num: *mut Bn, the: *mut Bn, tmp: *mut Bn) -> u64 {
    if bn_cmp(num, the) < 0 {
        return 0
    }
    let bn: usize = bn_bitlen(num)
    let bd: usize = bn_bitlen(the)
    var k: usize = bn - bd
    if k > 63 {
        // The caller scaled wrongly; a clean 0 is better than a
        // silently wrong answer.
        return 0
    }
    var q: u64 = 0
    var i: usize = k + 1
    while i > 0 {
        i = i - 1
        bn_copy(tmp, the)
        bn_shl(tmp, i)
        if bn_cmp(num, tmp) >= 0 {
            bn_sub(num, tmp)
            q = q + (1 << i)
        }
    }
    return q
}

// One decimal digit: the floor of num/`the` (0..9); the rest stays in `num`.
// Precondition: num < 10 * `the`.
fn bn_div_digit(num: *mut Bn, the: *mut Bn) -> u32 {
    var d: u32 = 0
    while bn_cmp(num, the) >= 0 {
        bn_sub(num, the)
        d = d + 1 as u32
        if d > 10 as u32 {
            return d
        }
    }
    return d
}

// lib/num/strtod.fi -- text -> IEEE-754 double precision, CORRECTLY ROUNDED
// (SPEC 8.4, requirement Z5).
//
// Stage 0 has no floating point type (yet); `strtod` therefore returns the
// BIT PATTERN of the double as a `u64`. That is no shortcut: the whole
// computation runs in integer arithmetic anyway, and `dtoa` works on the
// same bit pattern. As soon as the language has `f64`, a thin wrapper goes
// on top (see ACCEPTANCE.md, section str).
//
// Method: exact big number arithmetic. The value is held as a fraction
// of two big integers, D * 10^exp, scaled so that the quotient has exactly
// 53 bit, and from the remainder it is rounded to the nearest double -- at
// exactly half distance towards the EVEN mantissa. The result is therefore
// the correctly rounded one for EVERY input, including 2.2250738585072011e-308,
// 9007199254740993 and 5e-324.
//
// The form it recognizes:  [+-] digits [ . digits ] [ (e|E) [+-] digits ]
// Deliberately not recognized (the calling layer's job): "Infinity", "NaN",
// hexadecimal floating point, leading whitespace.
//
// Include:  //#include lib/num/strtod.fi  (needs alloc.fi, bignum.fi)

const D_INF_BITS: u64 = 0x7FF0000000000000
const D_SIGN_BIT: u64 = 0x8000000000000000
const D_TWO52: u64 = 4503599627370496
const D_TWO53: u64 = 9007199254740992
const D_MAXDIG: usize = 780 // significant digits, a sticky bit after them
const STRTOD_WS_BYTES: usize = 6 * 512 * 4

// ROUND 73: renamed from `is_digit`. `lib/std/core.fi` puts this file
// and the text facade into ONE module, and the facade has an
// `is_digit` of its own (lib/str/core_facade.fi). Two functions of the
// same name would be a compile error -- and of the two names this one
// is the one that only strtod uses.
fn strtod_digit(c: u8) -> bool {
    return c >= 48 as u8 && c <= 57 as u8
}

fn u64_bitlen(v: u64) -> usize {
    var x: u64 = v
    var n: usize = 0
    while x != 0 {
        x = x >> 1
        n = n + 1
    }
    return n
}

// The quotient of 2^s * num0 / den0; the remainder stays in `numw`, the
// scaled denominator in `denw` (the rounding afterwards needs both).
fn strtod_quot(num0: *mut Bn, den0: *mut Bn, numw: *mut Bn, denw: *mut Bn, tmp: *mut Bn, s: i64) -> u64 {
    bn_copy(numw, num0)
    bn_copy(denw, den0)
    if s >= 0 {
        bn_shl(numw, s as usize)
    } else {
        bn_shl(denw, (0 - s) as usize)
    }
    return bn_div_q(numw, denw, tmp)
}

// Text -> bit pattern. `consumed` receives the number of characters used up
// (0 = no valid number). `ws` needs STRTOD_WS_BYTES bytes.
fn strtod(p: *mut u8, len: usize, ws: *mut u8, consumed: *mut usize) -> u64 {
    *consumed = 0
    var d: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    var num0: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    var den0: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    var numw: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    var denw: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    var tmp: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    let stride: usize = BN_LIMBS * 4
    bn_init(&d, ws, BN_LIMBS)
    bn_init(&num0, (ws as usize + stride) as *mut u8, BN_LIMBS)
    bn_init(&den0, (ws as usize + stride * 2) as *mut u8, BN_LIMBS)
    bn_init(&numw, (ws as usize + stride * 3) as *mut u8, BN_LIMBS)
    bn_init(&denw, (ws as usize + stride * 4) as *mut u8, BN_LIMBS)
    bn_init(&tmp, (ws as usize + stride * 5) as *mut u8, BN_LIMBS)

    var i: usize = 0
    var neg: bool = false
    if i < len {
        let c0: u8 = ld8(p, i)
        if c0 == 43 as u8 {
            i = i + 1
        } else if c0 == 45 as u8 {
            neg = true
            i = i + 1
        }
    }
    var nsig: usize = 0
    var exp: i64 = 0
    var sticky: bool = false
    var any: bool = false
    var stop: bool = false

    // --- the digits before the point ---
    while i < len && !stop {
        let c: u8 = ld8(p, i)
        if strtod_digit(c) {
            any = true
            let dig: u32 = (c - 48 as u8) as u32
            if bn_is_zero(&d) && dig == 0 as u32 {
                stop = false
            } else if nsig < D_MAXDIG {
                bn_mul_small(&d, 10 as u32)
                bn_add_small(&d, dig)
                nsig = nsig + 1
            } else {
                exp = exp + 1
                if dig != 0 as u32 {
                    sticky = true
                }
            }
            i = i + 1
        } else {
            stop = true
        }
    }

    // --- the digits after the point ---
    if i < len {
        if ld8(p, i) == 46 as u8 {
            var j: usize = i + 1
            var fany: bool = false
            stop = false
            while j < len && !stop {
                let c: u8 = ld8(p, j)
                if strtod_digit(c) {
                    fany = true
                    let dig: u32 = (c - 48 as u8) as u32
                    if bn_is_zero(&d) && dig == 0 as u32 {
                        exp = exp - 1
                    } else if nsig < D_MAXDIG {
                        bn_mul_small(&d, 10 as u32)
                        bn_add_small(&d, dig)
                        nsig = nsig + 1
                        exp = exp - 1
                    } else {
                        if dig != 0 as u32 {
                            sticky = true
                        }
                    }
                    j = j + 1
                } else {
                    stop = true
                }
            }
            if any || fany {
                any = true
                i = j
            }
        }
    }

    if !any {
        return 0
    }

    // --- exponent ---
    if i < len {
        let ec: u8 = ld8(p, i)
        if ec == 101 as u8 || ec == 69 as u8 {
            var j: usize = i + 1
            var eneg: bool = false
            if j < len {
                let sc: u8 = ld8(p, j)
                if sc == 43 as u8 {
                    j = j + 1
                } else if sc == 45 as u8 {
                    eneg = true
                    j = j + 1
                }
            }
            var eany: bool = false
            var ev: i64 = 0
            stop = false
            while j < len && !stop {
                let c: u8 = ld8(p, j)
                if strtod_digit(c) {
                    eany = true
                    if ev < 1000000 {
                        ev = ev * 10 + (c - 48 as u8) as i64
                    }
                    j = j + 1
                } else {
                    stop = true
                }
            }
            if eany {
                if eneg {
                    exp = exp - ev
                } else {
                    exp = exp + ev
                }
                i = j
            }
        }
    }
    *consumed = i

    var sign: u64 = 0
    if neg {
        sign = D_SIGN_BIT
    }

    // Digits that were cut off: a sticky bit below the last place makes sure
    // that an exact half step never turns into a wrong rounding.
    if sticky {
        bn_mul_small(&d, 10 as u32)
        bn_add_small(&d, 1 as u32)
        exp = exp - 1
    }
    if bn_is_zero(&d) {
        return sign
    }

    // Rough range: 10^(mag-1) <= |value| < 10^mag
    let likes: i64 = exp + nsig as i64
    if likes - 1 >= 309 {
        return sign + D_INF_BITS
    }
    if likes <= -400 {
        return sign
    }

    bn_copy(&num0, &d)
    bn_set_u64(&den0, 1)
    if exp > 0 {
        bn_mul_pow10(&num0, exp as usize)
    } else if exp < 0 {
        bn_mul_pow10(&den0, (0 - exp) as usize)
    }

    // Scale until the quotient has exactly 53 bit.
    var s: i64 = 53 - (bn_bitlen(&num0) as i64 - bn_bitlen(&den0) as i64)
    var q: u64 = 0
    var done: bool = false
    var iter: usize = 0
    while !done && iter < 6 {
        q = strtod_quot(&num0, &den0, &numw, &denw, &tmp, s)
        let qb: i64 = u64_bitlen(q) as i64
        if qb == 53 {
            done = true
        } else {
            s = s + (53 - qb)
        }
        iter = iter + 1
    }
    var e2: i64 = 0 - s
    if e2 < -1074 {
        s = 1074
        e2 = -1074
        q = strtod_quot(&num0, &den0, &numw, &denw, &tmp, s)
    }

    // Round: the remainder (numw) against half the denominator (denw).
    bn_shl(&numw, 1)
    let cv: i32 = bn_cmp(&numw, &denw)
    var up: bool = false
    if cv > 0 {
        up = true
    } else if cv == 0 {
        if q % 2 == 1 {
            up = true
        }
    }
    if up {
        q = q + 1
        if q == D_TWO53 {
            q = D_TWO52
            e2 = e2 + 1
        }
    }
    if e2 > 971 {
        return sign + D_INF_BITS
    }
    if q == 0 {
        return sign
    }
    var bits: u64 = 0
    if q >= D_TWO52 {
        let biased: u64 = (e2 + 1075) as u64
        bits = (biased << 52) + (q - D_TWO52)
    } else {
        bits = q
    }
    return sign + bits
}

// lib/num/core_bits.fi -- reading an IEEE-754 double off its bits
// (round 73).
//
// Sign, biased exponent, mantissa, and the three questions that follow
// from them: NaN, infinity, zero. Pure integer arithmetic on a `u64` --
// not one of these six lines touches the FPU, which is why they carry no
// `#[allow_fp]` and cost a kernel nothing.
//
// They were part of `lib/num/dtoa.fi` up to round 73. They had to move,
// because `dtoa` writes into a `*mut Bytes` (it OWNS memory) and therefore
// cannot go into `lib/std/core.fi`, while `f64_is_nan` and its kin have to
// -- and both must keep calling the SAME six lines. The names keep the
// prefix `dtoa_`: whoever searches the tree for them finds every caller
// under the name he knows.
//
// Include:  //#include lib/num/core_bits.fi

fn dtoa_sign(bits: u64) -> bool {
    return (bits >> 63) == 1
}
fn dtoa_biased_exp(bits: u64) -> u64 {
    return (bits >> 52) & 0x7FF
}
fn dtoa_frac(bits: u64) -> u64 {
    return bits & 0xFFFFFFFFFFFFF
}
fn dtoa_is_nan(bits: u64) -> bool {
    return dtoa_biased_exp(bits) == 0x7FF && dtoa_frac(bits) != 0
}
fn dtoa_is_inf(bits: u64) -> bool {
    return dtoa_biased_exp(bits) == 0x7FF && dtoa_frac(bits) == 0
}
fn dtoa_is_zero(bits: u64) -> bool {
    return (bits << 1) == 0
}

// lib/num/core_facade.fi -- text -> number WITHOUT an allocator (round 73).
//
// The reading half of `lib/num/std_facade.fi`. Every function here writes
// into memory that the CALLER holds and asks nobody for a byte:
// `read_u64_base`, `read_i64`, `text_to_i64`, `digit_count`, the digit
// tests and the bit pattern helpers of `f64`. That is why the file is
// included by `lib/std/core.fi` (usable under `profile kernel`) as well as
// by `lib/std/num.fi` (the full facade) -- ONE source text, no second
// parser that could drift apart from the first.
//
// WHAT IS NOT HERE: everything that PRODUCES text (`write_*` appends to a
// `*mut Bytes`), and everything that reaches for scratch memory on its own.
//
// FLOATING POINT WITHOUT A HIDDEN mmap. `strtod` (lib/num/strtod.fi)
// computes in exact big number arithmetic and needs `strtod_work_bytes()`
// octets of scratch memory. The convenient form in `std.num` fetches them
// with `mmap` -- which is exactly what a kernel must not do. The `_at`
// forms here therefore take the scratch memory as a PARAMETER: at the call
// site you see that it costs memory, and you see whose memory it is.
//
//     var ws: [u8; 12288] = [0; 12288]      // core.strtod_work_bytes()
//     var x: f64 = 0.0
//     if core.text_to_f64_at(s.p, s.n, &ws[0], &x) { ... }
//
// `#[allow_fp]` sits on every function that touches an f64: in the kernel
// profile the FPU/SSE registers belong to the interrupted thread (SPEC 2),
// so whoever calls one of them takes over the duty to save their state.
// The integer part of this file -- and that is the bigger part -- carries
// no such marking and costs a kernel nothing.
//
// Include:  //#include lib/num/core_facade.fi  (needs core_mem.fi, strtod.fi)

fn u64_max() -> u64 {
    var x: u64 = 0
    return x - 1
}

fn i64_max() -> i64 {
    return 9223372036854775807
}

fn i64_min() -> i64 {
    return 0 - 9223372036854775807 - 1
}

// ---------------------------------------------------------- Number -> text

// The value of a digit in base <= 36, otherwise -1. Upper and lower case count alike.
fn digit_value(c: u8) -> i32 {
    if c >= 48 as u8 && c <= 57 as u8 {
        return (c - 48 as u8) as i32
    }
    if c >= 97 as u8 && c <= 122 as u8 {
        return (c - 97 as u8) as i32 + 10
    }
    if c >= 65 as u8 && c <= 90 as u8 {
        return (c - 65 as u8) as i32 + 10
    }
    return 0 - 1
}

// How many digits `v` needs in `base` (0 needs one).
fn digit_count(v: u64, base: u32) -> usize {
    if base < 2 || base > 36 {
        return 0
    }
    if v == 0 {
        return 1
    }
    let b: u64 = base as u64
    var x: u64 = v
    var n: usize = 0
    while x > 0 {
        x = x / b
        n = n + 1
    }
    return n
}

// ---------------------------------------------------------- Text -> number

// A digit sequence starting at `ab` in base 2..36. Return value: the number
// of octets used up (0 = no digit). `overflow` is set as soon as the value
// no longer fits in a u64; it keeps reading to the end of the digits anyway,
// so that the caller knows where the text continues.
fn read_u64_base(p: *mut u8, n: usize, ab: usize, base: u32, out: *mut u64,
    overflow: *mut bool) -> usize {
    *out = 0
    *overflow = false
    if base < 2 || base > 36 {
        return 0
    }
    let b: u64 = base as u64
    let limit: u64 = u64_max() / b
    let rest_limit: u64 = u64_max() - limit * b
    var w: u64 = 0
    var i: usize = ab
    var z: usize = 0
    while i < n {
        let d: i32 = digit_value(ld8(p, i))
        if d < 0 {
            i = n
        } else if (d as u32) >= base {
            i = n
        } else {
            if w > limit || (w == limit && (d as u64) > rest_limit) {
                *overflow = true
            }
            w = w * b + d as u64
            z = z + 1
            i = i + 1
        }
    }
    *out = w
    return z
}

fn read_u64(p: *mut u8, n: usize, ab: usize, out: *mut u64,
    overflow: *mut bool) -> usize {
    return read_u64_base(p, n, ab, 10, out, overflow)
}

// With a sign. `+` and `-` are allowed, and at least one digit has to
// follow. The return value counts the sign.
fn read_i64(p: *mut u8, n: usize, ab: usize, out: *mut i64,
    overflow: *mut bool) -> usize {
    *out = 0
    *overflow = false
    var i: usize = ab
    var negative: bool = false
    if i < n {
        let c: u8 = ld8(p, i)
        if c == 45 as u8 {
            negative = true
            i = i + 1
        } else if c == 43 as u8 {
            i = i + 1
        }
    }
    var abs: u64 = 0
    var ue: bool = false
    let z: usize = read_u64_base(p, n, i, 10, &abs, &ue)
    if z == 0 {
        return 0
    }
    if ue {
        *overflow = true
    }
    if negative {
        if abs > 9223372036854775808 as u64 {
            *overflow = true
            *out = i64_min()
        } else if abs == 9223372036854775808 as u64 {
            *out = i64_min()
        } else {
            *out = 0 - (abs as i64)
        }
    } else {
        if abs > 9223372036854775807 as u64 {
            *overflow = true
            *out = i64_max()
        } else {
            *out = abs as i64
        }
    }
    return i - ab + z
}

// Strict: the whole text has to be the number, no whitespace, no leftovers.
fn text_to_u64_base(p: *mut u8, n: usize, base: u32, out: *mut u64) -> bool {
    var ue: bool = false
    let z: usize = read_u64_base(p, n, 0, base, out, &ue)
    return z == n && z > 0 && !ue
}

fn text_to_u64(p: *mut u8, n: usize, out: *mut u64) -> bool {
    return text_to_u64_base(p, n, 10, out)
}

fn text_to_i64(p: *mut u8, n: usize, out: *mut i64) -> bool {
    var ue: bool = false
    let z: usize = read_i64(p, n, 0, out, &ue)
    return z == n && z > 0 && !ue
}

// With a base prefix: 0x/0X = 16, 0b/0B = 2, 0o/0O = 8, otherwise 10.
// A lone "0" stays 0 (no special case for leading zeros -- those are
// decimal, as in every modern language).
fn text_to_u64_auto(p: *mut u8, n: usize, out: *mut u64) -> bool {
    if n >= 3 && ld8(p, 0) == 48 as u8 {
        let c: u8 = ld8(p, 1)
        if c == 120 as u8 || c == 88 as u8 {
            return text_to_u64_base((p as usize + 2) as *mut u8, n - 2, 16, out)
        }
        if c == 98 as u8 || c == 66 as u8 {
            return text_to_u64_base((p as usize + 2) as *mut u8, n - 2, 2, out)
        }
        if c == 111 as u8 || c == 79 as u8 {
            return text_to_u64_base((p as usize + 2) as *mut u8, n - 2, 8, out)
        }
    }
    return text_to_u64_base(p, n, 10, out)
}

// ---------------------------------------------------------- Floating point
//
// Reinterpreting the bit pattern through memory -- Firn has no
// reinterpretation operator, and `as` would be a VALUE conversion (1.0 as u64 = 1).

#[allow_fp]
fn f64_bits(x: f64) -> u64 {
    var t: f64 = x
    return *(((&t) as usize) as *mut u64)
}

#[allow_fp]
fn bits_f64(b: u64) -> f64 {
    var t: u64 = b
    return *(((&t) as usize) as *mut f64)
}

#[allow_fp]
fn f64_is_nan(x: f64) -> bool {
    return dtoa_is_nan(f64_bits(x))
}

#[allow_fp]
fn f64_is_infinite(x: f64) -> bool {
    return dtoa_is_inf(f64_bits(x))
}

#[allow_fp]
fn f64_is_null(x: f64) -> bool {
    return dtoa_is_zero(f64_bits(x))
}

// true = the sign bit is negative (for -0.0 as well).
#[allow_fp]
fn f64_sign(x: f64) -> bool {
    return dtoa_sign(f64_bits(x))
}

fn strtod_work_bytes() -> usize {
    return STRTOD_WS_BYTES
}

// ---------------------------------------------- Floating point, text -> f64
//
// The same core (`strtod`, correctly rounded) that `std.num` uses -- only
// the scratch memory comes from outside. `ws` needs `strtod_work_bytes()`
// octets and may lie anywhere: on the stack, in an arena, in a kernel
// frame. Return value of the `read_` forms: the octets used up (0 = there
// was no number there).

fn read_f64_bits_at(p: *mut u8, n: usize, ws: *mut u8, out: *mut u64) -> usize {
    *out = 0
    if (ws as usize) == 0 {
        return 0
    }
    var consumed: usize = 0
    let bits: u64 = strtod(p, n, ws, &consumed)
    *out = bits
    return consumed
}

// Strict: the WHOLE text has to be the number.
fn text_to_f64_bits_at(p: *mut u8, n: usize, ws: *mut u8, out: *mut u64) -> bool {
    let z: usize = read_f64_bits_at(p, n, ws, out)
    return z == n && z > 0
}

#[allow_fp]
fn read_f64_at(p: *mut u8, n: usize, ws: *mut u8, out: *mut f64) -> usize {
    var bits: u64 = 0
    let z: usize = read_f64_bits_at(p, n, ws, &bits)
    *out = bits_f64(bits)
    return z
}

#[allow_fp]
fn text_to_f64_at(p: *mut u8, n: usize, ws: *mut u8, out: *mut f64) -> bool {
    let z: usize = read_f64_at(p, n, ws, out)
    return z == n && z > 0
}

// lib/num/core_comfort.fi -- reading a number out of a Span (round 73).
//
// The comfort layer of round 69 (`num.parse_i64(s) -> num.ParsedI64`), for
// the freestanding half of the library. Same shape, same core: `parse_*`
// calls exactly the `read_*` out of `lib/num/core_facade.fi` that
// `text_to_*` calls too. There is no second parser here that could drift
// away from the first.
//
// WHY THIS FILE EXISTS NEXT TO tools/strlib/src/num_comfort.fi, honestly:
// the round 69 version takes a `str.Span` -- it names the module `str`,
// which is exactly the module a kernel must not have. Inside
// `lib/std/core.fi` the `Span` is the local one out of
// `lib/str/core_facade.fi`, and Firn has no type aliases at stage 0 (SPEC
// 14), so the signature cannot be shared. What IS shared is everything
// below it: both call `read_i64`/`read_u64_base`, and those exist exactly
// once, in `lib/num/core_facade.fi`. The duplication is 40 lines of
// wrapper without an ounce of arithmetic in them.
//
// NO f64 HERE. `ParsedF64` would need a struct with an f64 field, and a
// struct like that needs `#[allow_fp]` in the kernel profile -- for a
// convenience that a kernel has no use for. Whoever wants floating point
// in `core` takes `text_to_f64_at` with scratch memory of his own; the
// `ParsedF64` form stays in `std.num`, where the FPU is nobody's problem.
//
// Include:  //#include lib/num/core_comfort.fi

// ---------------------------------------------------------- The results
//
// `ok` answers the only question the caller usually has: is `value` the
// number that was written there? `overflow` says WHY not, when the digits
// were fine but too many.

struct ParsedI64 {
    ok: bool,
    overflow: bool,
    value: i64,
}

struct ParsedU64 {
    ok: bool,
    overflow: bool,
    value: u64,
}

fn parsed_i64_none() -> ParsedI64 {
    return ParsedI64 { ok: false, overflow: false, value: 0 }
}

fn parsed_u64_none() -> ParsedU64 {
    return ParsedU64 { ok: false, overflow: false, value: 0 }
}

// ----------------------------------------------------------- The parsers
//
// STRICT, like `text_to_*`: the WHOLE span has to be the number. Blanks
// are not swallowed silently -- `s.trim()` is one call and says what it
// does.

fn parse_i64(s: Span) -> ParsedI64 {
    var v: i64 = 0
    var over: bool = false
    let used: usize = read_i64(s.p, s.n, 0, &v, &over)
    return ParsedI64 { ok: used == s.n && used > 0 && !over, overflow: over,
        value: v }
}

fn parse_u64_base(s: Span, base: u32) -> ParsedU64 {
    var v: u64 = 0
    var over: bool = false
    let used: usize = read_u64_base(s.p, s.n, 0, base, &v, &over)
    return ParsedU64 { ok: used == s.n && used > 0 && !over, overflow: over,
        value: v }
}

fn parse_u64(s: Span) -> ParsedU64 {
    return parse_u64_base(s, 10)
}

// With a base prefix: 0x/0X = 16, 0b/0B = 2, 0o/0O = 8, otherwise 10.
fn parse_u64_auto(s: Span) -> ParsedU64 {
    var v: u64 = 0
    let ok: bool = text_to_u64_auto(s.p, s.n, &v)
    return ParsedU64 { ok: ok, overflow: false, value: v }
}

// -------------------------------------------------------- Taking it apart

fn i64_or(r: ParsedI64, fallback: i64) -> i64 {
    if r.ok {
        return r.value
    }
    return fallback
}

fn u64_or(r: ParsedU64, fallback: u64) -> u64 {
    if r.ok {
        return r.value
    }
    return fallback
}

// The results are VALUES; their methods therefore take `self`.
impl ParsedI64 {
    fn value_or(self, fallback: i64) -> i64 { return i64_or(self, fallback) }
}

impl ParsedU64 {
    fn value_or(self, fallback: u64) -> u64 { return u64_or(self, fallback) }
}

// lib/math/core_math.fi -- the mathematics, without the module frame
// (round 73).
//
// The whole body of what `std.math` has offered since round 39/42:
// integers (abs/min/max/clamp/isqrt/pow/gcd/lcm/ilog2/ilog10/pow_two) and
// floating point as far as the core language allows (sqrt, exp, ln, the
// trigonometric functions, the exact rounding functions). Not one line of
// it asks for memory or makes a system call -- it is arithmetic on values.
//
// That is why the body lives here on its own and is included TWICE: by
// `lib/std/math.fi` (the module `std.math`, unchanged from the outside)
// and by `lib/std/core.fi` (the freestanding half of the library). One
// source text, two front doors.
//
// `#[allow_fp]` on every function that touches an f64: in the kernel
// profile the FPU/SSE registers belong to the interrupted thread (SPEC 2).
// The marking is a NOTE, not a permission slip -- whoever calls `sqrt` in
// a kernel has to save the FPU state himself. Under the app profile the
// attribute does nothing at all.
//
// Include:  //#include lib/math/core_math.fi

// Pi and Euler's number as FUNCTIONS, not as constants: in stage 0 `const`
// can only do integer and bool types (sema evaluates constants as integers)
// -- a `const PI: f64` cannot be said.
#[allow_fp]
fn PI() -> f64 {
    return 3.141592653589793
}

#[allow_fp]
fn E() -> f64 {
    return 2.718281828459045
}

// The magnitude of a signed integer.
fn abs(x: i64) -> i64 {
    if x < 0 {
        return 0 - x
    }
    return x
}

fn min(a: i64, b: i64) -> i64 {
    if a < b {
        return a
    }
    return b
}

fn max(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    }
    return b
}

// `x` forced into the closed range [lo, hi].
fn clamp(x: i64, lo: i64, hi: i64) -> i64 {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}

// The integer square root: floor(sqrt(n)), exact.
// Newton from above -- the sequence falls monotonically onto the fixpoint.
fn isqrt(n: u64) -> u64 {
    if n < 2 {
        return n
    }
    var x: u64 = n
    var y: u64 = (x + 1) / 2
    while y < x {
        x = y
        y = (x + n / x) / 2
    }
    return x
}

// Integer power, exponent >= 0. 0^0 is 1 (the usual convention).
fn pow(b: i64, e: u64) -> i64 {
    var r: i64 = 1
    var i: u64 = 0
    while i < e {
        r = r * b
        i = i + 1
    }
    return r
}

// The square root on f64. Newton until the value stops moving -- that
// converges for every positive input without having to guess a start value.
// sqrt(0) = 0; a negative input gives NaN (0.0/0.0).
#[allow_fp]
fn sqrt(x: f64) -> f64 {
    if x < 0.0 {
        return 0.0 / 0.0
    }
    if x == 0.0 {
        return 0.0
    }
    var g: f64 = x
    if g < 1.0 {
        g = 1.0
    }
    var old: f64 = 0.0
    while g != old {
        old = g
        g = (g + x / g) / 2.0
    }
    return g
}

// f64 power with an integer exponent (negative allowed).
#[allow_fp]
fn powi(b: f64, e: i64) -> f64 {
    var base: f64 = b
    var n: i64 = e
    if n < 0 {
        base = 1.0 / b
        n = 0 - n
    }
    var r: f64 = 1.0
    var i: i64 = 0
    while i < n {
        r = r * base
        i = i + 1
    }
    return r
}

// =====================================================================
// Round 42 -- the build out. The naming rule of this module, deliberately
// kept: mathematical functions carry their international name (sqrt, floor,
// exp, ln, sin). A second name next to the `sqrt` that has existed since
// round 39 would be two names for one thing; renaming would be a break.
// Everything else follows the general naming of the library (English since round 55).
// =====================================================================

// ------------------------------------------------- Bit patterns and limits
//
// `math` stays self contained: the reinterpretation f64 <-> u64 stands here
// once more (instead of an import of std.num), so that a program that only
// wants to compute does not pull in the whole number library.

fn all_bits() -> u64 {
    var x: u64 = 0
    return x - 1
}

#[allow_fp]
fn math_bits(x: f64) -> u64 {
    var t: f64 = x
    return *(((&t) as usize) as *mut u64)
}

#[allow_fp]
fn math_f64(b: u64) -> f64 {
    var t: u64 = b
    return *(((&t) as usize) as *mut f64)
}

#[allow_fp]
fn INF() -> f64 {
    return math_f64(9218868437227405312)
}

#[allow_fp]
fn NAN() -> f64 {
    return math_f64(9221120237041090560)
}

// The distance from 1.0 to the next larger number: 2^-52.
#[allow_fp]
fn EPSILON() -> f64 {
    return math_f64(4372995238176751616)
}

#[allow_fp]
fn TAU() -> f64 {
    return 6.283185307179586
}

#[allow_fp]
fn SQRT2() -> f64 {
    return 1.4142135623730951
}

#[allow_fp]
fn LN2() -> f64 {
    return 0.6931471805599453
}

#[allow_fp]
fn LN10() -> f64 {
    return 2.302585092994046
}

#[allow_fp]
fn is_nan(x: f64) -> bool {
    return x != x
}

#[allow_fp]
fn is_infinite(x: f64) -> bool {
    let b: u64 = math_bits(x) & 9223372036854775807
    return b == 9218868437227405312
}

#[allow_fp]
fn is_finite(x: f64) -> bool {
    let b: u64 = math_bits(x) & 9223372036854775807
    return b < 9218868437227405312
}

// -------------------------------------------------------- The integer part

// -1, 0 or 1.
fn sign(x: i64) -> i64 {
    if x < 0 {
        return 0 - 1
    }
    if x > 0 {
        return 1
    }
    return 0
}

fn min_u(a: u64, b: u64) -> u64 {
    if a < b {
        return a
    }
    return b
}

fn max_u(a: u64, b: u64) -> u64 {
    if a > b {
        return a
    }
    return b
}

fn clamp_u(x: u64, lo: u64, hi: u64) -> u64 {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}

// The magnitude of the difference, without wraparound -- for i64::MIN too.
fn abs_diff(a: i64, b: i64) -> u64 {
    if a >= b {
        return (a as u64) - (b as u64)
    }
    return (b as u64) - (a as u64)
}

// The greatest common divisor (Euclid, iterative). gcd(0, 0) = 0.
fn gcd(a: u64, b: u64) -> u64 {
    var x: u64 = a
    var y: u64 = b
    while y != 0 {
        let r: u64 = x % y
        x = y
        y = r
    }
    return x
}

// The least common multiple. 0 if one value is 0. Overflow is NOT checked
// (stage 0 checks nowhere) -- but dividing first and multiplying afterwards
// keeps it away as long as possible.
fn lcm(a: u64, b: u64) -> u64 {
    if a == 0 || b == 0 {
        return 0
    }
    return a / gcd(a, b) * b
}

// The rounded down binary logarithm; ilog2(0) is 0 (there is no right
// answer, and a crash would be worse).
fn ilog2(v: u64) -> usize {
    if v == 0 {
        return 0
    }
    var x: u64 = v
    var n: usize = 0
    while x > 1 {
        x = x >> 1
        n = n + 1
    }
    return n
}

fn ilog10(v: u64) -> usize {
    var x: u64 = v
    var n: usize = 0
    while x >= 10 {
        x = x / 10
        n = n + 1
    }
    return n
}

fn is_pow_two(v: u64) -> bool {
    if v == 0 {
        return false
    }
    return (v & (v - 1)) == 0
}

// The smallest power of two >= v. Above 2^63 there is none: then 0.
fn next_pow_two(v: u64) -> u64 {
    if v <= 1 {
        return 1
    }
    if v > 9223372036854775808 {
        return 0
    }
    var k: u64 = 1
    while k < v {
        k = k * 2
    }
    return k
}

// Unsigned integer power, by squaring -- the pow() next to it is the signed
// form from round 39 and stays as it is.
fn pow_u(b: u64, e: u64) -> u64 {
    var r: u64 = 1
    var base: u64 = b
    var n: u64 = e
    while n > 0 {
        if (n & 1) == 1 {
            r = r * base
        }
        base = base * base
        n = n >> 1
    }
    return r
}

// --------------------------------------------------- Floating point, exact
//
// The following six do NOT compute, they cut off bits -- their result is
// exactly the right double for every input, including 2^52 and above, where
// every formula with +0.5 would be wrong.

#[allow_fp]
fn fabs(x: f64) -> f64 {
    return math_f64(math_bits(x) & 9223372036854775807)
}

#[allow_fp]
fn fmin(a: f64, b: f64) -> f64 {
    if is_nan(a) {
        return b
    }
    if is_nan(b) {
        return a
    }
    if a < b {
        return a
    }
    return b
}

#[allow_fp]
fn fmax(a: f64, b: f64) -> f64 {
    if is_nan(a) {
        return b
    }
    if is_nan(b) {
        return a
    }
    if a > b {
        return a
    }
    return b
}

#[allow_fp]
fn fclamp(x: f64, lo: f64, hi: f64) -> f64 {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}

// Cut off the fractional digits (towards zero). The sign stays: -0.5 becomes
// -0.0.
#[allow_fp]
fn trunc(x: f64) -> f64 {
    let b: u64 = math_bits(x)
    let e: u64 = (b >> 52) & 2047
    if e < 1023 {
        return math_f64(b & 9223372036854775808)
    }
    if e >= 1075 {
        return x
    }
    let frac: u64 = 4503599627370495 >> (e - 1023)
    return math_f64(b & (all_bits() - frac))
}

#[allow_fp]
fn floor(x: f64) -> f64 {
    let t: f64 = trunc(x)
    if t > x {
        return t - 1.0
    }
    return t
}

#[allow_fp]
fn ceil(x: f64) -> f64 {
    let t: f64 = trunc(x)
    if t < x {
        return t + 1.0
    }
    return t
}

// Commercial rounding: a half goes AWAY FROM ZERO (round(0.5) = 1,
// round(-0.5) = -1). Through `trunc` instead of through `floor(x + 0.5)` --
// otherwise round(0.49999999999999994) would wrongly be 1.
#[allow_fp]
fn round(x: f64) -> f64 {
    let t: f64 = trunc(x)
    let d: f64 = x - t
    if d >= 0.5 {
        return t + 1.0
    }
    if d <= 0.0 - 0.5 {
        return t - 1.0
    }
    return t
}

// The remainder of the division as in C: the same sign as `x`, exact.
// Method: double the magnitude of the divisor until it lies above the
// remainder, then subtract while halving -- every intermediate number lies
// on the same bit grid, so every subtraction is exact.
#[allow_fp]
fn fmod(x: f64, y: f64) -> f64 {
    if is_nan(x) || is_nan(y) || is_infinite(x) || y == 0.0 {
        return NAN()
    }
    if is_infinite(y) {
        return x
    }
    var a: f64 = fabs(x)
    let b: f64 = fabs(y)
    if a < b {
        return x
    }
    var s: f64 = b
    while s <= a / 2.0 {
        s = s * 2.0
    }
    var runs: bool = true
    while runs {
        if a >= s {
            a = a - s
        }
        if s == b {
            runs = false
        } else {
            s = s / 2.0
        }
    }
    if x < 0.0 {
        return 0.0 - a
    }
    return a
}

// Multiply by 2^k. In two steps, so that very small results (subnormal) and
// very large factors come out right as well.
#[allow_fp]
fn ldexp(x: f64, k: i64) -> f64 {
    if x == 0.0 || is_nan(x) || is_infinite(x) {
        return x
    }
    var n: i64 = k
    var r: f64 = x
    while n > 1000 {
        r = r * math_f64(9110782046170513408)
        n = n - 1000
    }
    while n < 0 - 1000 {
        r = r * math_f64(103582791429521408)
        n = n + 1000
    }
    let bits: u64 = ((n + 1023) as u64) << 52
    return r * math_f64(bits)
}

// The decomposition x = m * 2^e with 0.5 <= |m| < 1. `e` comes via the pointer.
#[allow_fp]
fn frexp(x: f64, e: *mut i64) -> f64 {
    *e = 0
    if x == 0.0 || is_nan(x) || is_infinite(x) {
        return x
    }
    var r: f64 = x
    var k: i64 = 0
    // Scale subnormals up first, so that the exponent stands in the field.
    if fabs(r) < math_f64(4503599627370496) {
        r = r * math_f64(4850376798678024192)
        k = 0 - 54
    }
    let b: u64 = math_bits(r)
    let raw: i64 = ((b >> 52) & 2047) as i64
    *e = k + raw - 1022
    return math_f64((b & 9227875636482146303) | 4602678819172646912)
}

#[allow_fp]
fn hypot(x: f64, y: f64) -> f64 {
    let ax: f64 = fabs(x)
    let ay: f64 = fabs(y)
    let m: f64 = fmax(ax, ay)
    let n: f64 = fmin(ax, ay)
    if m == 0.0 {
        return 0.0
    }
    if is_infinite(m) {
        return INF()
    }
    let r: f64 = n / m
    return m * sqrt(1.0 + r * r)
}

// -------------------------------------------- Floating point, approximated
//
// Series expansion with range reduction, without tables. MEASURED in
// tests/805_std_math_f64.fi against known values; the bounds checked
// there are the honest claim about accuracy (relative <= 1e-12 over the
// checked range), NOT "correct to the last bit". Whoever needs correctly
// rounded elementary functions needs tables -- that is a round of its
// own.

// e^x. Reduction x = k*ln2 + r with |r| <= ln2/2, then Taylor around 0.
#[allow_fp]
fn exp(x: f64) -> f64 {
    if is_nan(x) {
        return x
    }
    if x > 709.9 {
        return INF()
    }
    if x < 0.0 - 745.2 {
        return 0.0
    }
    let k: f64 = round(x / LN2())
    let r: f64 = x - k * LN2()
    var member: f64 = 1.0
    var sum: f64 = 1.0
    var i: i64 = 1
    while i <= 16 {
        member = member * r / (i as f64)
        sum = sum + member
        i = i + 1
    }
    return ldexp(sum, k as i64)
}

// The natural logarithm. x = m * 2^e with m in [sqrt(0.5), sqrt(2)), then
// the series for atanh: ln(m) = 2*(s + s^3/3 + s^5/5 + ...) with
// s = (m-1)/(m+1) -- there |s| <= 0.1716, and the series is exhausted after
// nine terms.
#[allow_fp]
fn ln(x: f64) -> f64 {
    if is_nan(x) {
        return x
    }
    if x < 0.0 {
        return NAN()
    }
    if x == 0.0 {
        return 0.0 - INF()
    }
    if is_infinite(x) {
        return INF()
    }
    var e: i64 = 0
    var m: f64 = frexp(x, &e)
    if m < 0.7071067811865476 {
        m = m * 2.0
        e = e - 1
    }
    let s: f64 = (m - 1.0) / (m + 1.0)
    let q: f64 = s * s
    var member: f64 = s
    var sum: f64 = s
    var i: i64 = 1
    while i <= 12 {
        member = member * q
        sum = sum + member / ((2 * i + 1) as f64)
        i = i + 1
    }
    return 2.0 * sum + (e as f64) * LN2()
}

#[allow_fp]
fn log2(x: f64) -> f64 {
    return ln(x) / LN2()
}

#[allow_fp]
fn log10(x: f64) -> f64 {
    return ln(x) / LN10()
}

// The general power. Integer exponents go exactly through `powi` -- that
// keeps pow(2.0, 10.0) at exactly 1024 instead of at 1023.9999999.
#[allow_fp]
fn powf(b: f64, e: f64) -> f64 {
    if e == trunc(e) && fabs(e) <= 1024.0 {
        return powi(b, e as i64)
    }
    if b < 0.0 {
        return NAN()
    }
    if b == 0.0 {
        if e > 0.0 {
            return 0.0
        }
        return INF()
    }
    return exp(e * ln(b))
}

// Sine/cosine. Reduction modulo 2*PI, then onto the eighth of a circle;
// Taylor around 0 with 8 terms. AN HONEST LIMIT: the reduction computes in
// double precision, and for very large |x| (beyond roughly 2^30) it eats up
// the digits. That is the usual limit without a Payne-Hanek reduction, and
// it is named here, not hidden.
#[allow_fp]
fn sin_core(r: f64) -> f64 {
    let q: f64 = r * r
    var member: f64 = r
    var sum: f64 = r
    var i: i64 = 1
    while i <= 9 {
        member = 0.0 - member * q / (((2 * i) * (2 * i + 1)) as f64)
        sum = sum + member
        i = i + 1
    }
    return sum
}

#[allow_fp]
fn cos_core(r: f64) -> f64 {
    let q: f64 = r * r
    var member: f64 = 1.0
    var sum: f64 = 1.0
    var i: i64 = 1
    while i <= 9 {
        member = 0.0 - member * q / (((2 * i - 1) * (2 * i)) as f64)
        sum = sum + member
        i = i + 1
    }
    return sum
}

#[allow_fp]
fn sin(x: f64) -> f64 {
    if is_nan(x) || is_infinite(x) {
        return NAN()
    }
    var r: f64 = fmod(x, TAU())
    if r > PI() {
        r = r - TAU()
    }
    if r < 0.0 - PI() {
        r = r + TAU()
    }
    // Mirror onto [-PI/2, PI/2]: sin(PI - r) = sin(r).
    if r > PI() / 2.0 {
        r = PI() - r
    }
    if r < 0.0 - PI() / 2.0 {
        r = 0.0 - PI() - r
    }
    return sin_core(r)
}

#[allow_fp]
fn cos(x: f64) -> f64 {
    return sin(x + PI() / 2.0)
}

#[allow_fp]
fn tan(x: f64) -> f64 {
    let c: f64 = cos(x)
    if c == 0.0 {
        return NAN()
    }
    return sin(x) / c
}

// The arc tangent. Reduction onto [0, tan(PI/12)] through two identities,
// then the series -- that keeps the argument small enough for twelve terms
// to be sufficient.
#[allow_fp]
fn atan(x: f64) -> f64 {
    if is_nan(x) {
        return x
    }
    if is_infinite(x) {
        if x > 0.0 {
            return PI() / 2.0
        }
        return 0.0 - PI() / 2.0
    }
    if x < 0.0 {
        return 0.0 - atan(0.0 - x)
    }
    if x > 1.0 {
        return PI() / 2.0 - atan(1.0 / x)
    }
    // tan(PI/12) = 2 - sqrt(3); above it, apply the addition formula.
    if x > 0.2679491924311227 {
        let w: f64 = (x * 1.7320508075688772 - 1.0) / (x + 1.7320508075688772)
        return PI() / 6.0 + atan(w)
    }
    let q: f64 = x * x
    var member: f64 = x
    var sum: f64 = x
    var i: i64 = 1
    while i <= 14 {
        member = 0.0 - member * q
        sum = sum + member / ((2 * i + 1) as f64)
        i = i + 1
    }
    return sum
}

// The angle of the point (x, y) over the range (-PI, PI].
#[allow_fp]
fn atan2(y: f64, x: f64) -> f64 {
    if x > 0.0 {
        return atan(y / x)
    }
    if x < 0.0 {
        if y >= 0.0 {
            return atan(y / x) + PI()
        }
        return atan(y / x) - PI()
    }
    if y > 0.0 {
        return PI() / 2.0
    }
    if y < 0.0 {
        return 0.0 - PI() / 2.0
    }
    return 0.0
}

// An approximate comparison: |a - b| <= eps * max(1, |a|, |b|). The one
// every floating point test needs -- and that everybody writes wrong.
#[allow_fp]
fn near(a: f64, b: f64, eps: f64) -> bool {
    if a == b {
        return true
    }
    if is_nan(a) || is_nan(b) {
        return false
    }
    var m: f64 = 1.0
    if fabs(a) > m {
        m = fabs(a)
    }
    if fabs(b) > m {
        m = fabs(b)
    }
    return fabs(a - b) <= eps * m
}

// lib/mem/core_alloc.fi -- THE ALLOCATOR, PASSED BY HAND (round 73).
//
// SPEC 2 has promised since round 52: "kernel: heap allocation only
// through an explicitly passed `Allocator`". Until round 73 that sentence
// stood alone -- there was no `Allocator`, neither in the compiler nor in
// the library. This file is it.
//
// THE POINT, in one line: at the CALL SITE it has to be visible that a
// call costs memory.
//
//     let s: core.Block = core.alloc(a, 4096, 16)   // costs memory, one sees it
//     let n: usize = span.find(part)                // costs nothing, one sees that too
//
// That is the Zig route, and it is the one Justin decided on. No global
// allocator, no hidden `mmap` behind a comfortable name, no thread local
// "current heap". Whoever wants memory names whose memory it is.
//
// ------------------------------------------------------------------------
// WHY THE INTERFACE TAKES ONLY PRIMITIVE TYPES
//
// `interface` holds PROGRAM WIDE in Firn (docs/ROUND46.md 9,
// tests/821_iface_module_core.fi) -- the name of an interface is not
// rewritten when modules are merged. A `struct` on the other hand belongs
// to its module and becomes `core__Block`. A method signature inside
// `interface` is therefore not allowed to name a struct of the module: at
// the point where the interface is read, `Block` does not exist yet.
//
// So the interface carries the MACHINE contract -- addresses as `u64`, the
// answer as `bool` -- and the layer above it carries the HUMAN one:
// `alloc`/`free`/`grow` take and return a `Block`. That has a pleasant side
// effect: an implementation CANNOT hand a null pointer back silently,
// because there is no pointer in its return value at all. It has to say
// `false`, and `alloc` turns that into a `Block` whose `ok` is `false`.
//
// ------------------------------------------------------------------------
// THE FAILURE CASE IS A VALUE, NOT A ZERO
//
// `Block { p, n, ok }`. Whoever forgets `ok` gets `p == 0` and crashes at
// the first write -- but he cannot claim he was not told: every producing
// function of this file returns a `Block`, never a bare address.
// `block_none()` is the one and only way to say "it did not work".
//
// ------------------------------------------------------------------------
// WHAT IS IN HERE
//
//   * `Block`      -- the answer of an allocator
//   * `Allocator`  -- the interface (three methods, primitive types)
//   * alloc/free/grow/alloc_zeroed -- the checked layer over it
//   * `Arena`      -- an implementation WITHOUT a system call: a bump
//                     allocator over memory that somebody else holds. That
//                     is the one a kernel can use.
//
// The second implementation, the one over `mmap`, sits in `lib/std/mem.fi`
// (`PageAllocator`): it makes system calls and therefore may not stand in
// `lib/std/core.fi`. The interface is the same one -- `impl Allocator for
// PageAllocator` in a different module works, because `interface` holds
// program wide.
//
// Include:  //#include lib/mem/core_alloc.fi  (needs lib/str/core_mem.fi)

// --------------------------------------------------------------- Block
//
// What came back. `n` is the USABLE length, and it may be bigger than what
// was asked for (an allocator is allowed to round up) -- whoever gives the
// block back hands `n` back, not his wish.

struct Block {
    p: *mut u8,
    n: usize,
    ok: bool,
}

// "It did not work." The only spelling of failure in this library.
fn block_none() -> Block {
    return Block { p: 0 as *mut u8, n: 0, ok: false }
}

fn block_of(p: *mut u8, n: usize) -> Block {
    if (p as usize) == 0 {
        return block_none()
    }
    return Block { p: p, n: n, ok: true }
}

// A reading view of the block -- the bridge to the text side of `core`.
fn block_span(b: Block) -> Span {
    if !b.ok {
        return span_empty()
    }
    return Span { p: b.p, n: b.n }
}

impl Block {
    fn is_ok(self) -> bool { return self.ok }
    fn length(self) -> usize { return self.n }
    fn span(self) -> Span { return block_span(self) }
}

// ----------------------------------------------------------- Alignment

fn is_power_of_two(v: usize) -> bool {
    return v != 0 && (v & (v - 1)) == 0
}

// The next multiple of `align` at or above `v`. `align` 0 counts as 1.
fn align_up(v: usize, align: usize) -> usize {
    var a: usize = align
    if a == 0 {
        a = 1
    }
    return (v + a - 1) / a * a
}

// The alignment every allocator has to be able to do at least: 16 octets,
// the alignment of the x86-64 ABI for the largest scalar type.
fn align_default() -> usize {
    return 16
}

// ---------------------------------------------------------- Allocator
//
// Three methods, addresses as `u64`, the answer as `bool`. `raw_alloc`
// writes the address into `out` and returns `true`; on failure it returns
// `false` and MUST NOT touch `out`.
//
// `raw_free` gets the size and the alignment back that `raw_alloc`
// answered with -- an allocator without bookkeeping of its own (an arena,
// a size class allocator) needs them, and one with bookkeeping may ignore
// them.
//
// `raw_grow` is the third method and not a convenience: growing in place
// is the difference between O(n) and O(n log n) for every buffer that
// grows. Whoever cannot do it returns `false`; `grow` above then does the
// honest thing (new block, copy, free).

interface Allocator {
    fn raw_alloc(*mut self, size: usize, align: usize, out: *mut u64) -> bool
    fn raw_free(*mut self, address: u64, size: usize, align: usize)
    fn raw_grow(*mut self, address: u64, old: usize, size: usize, align: usize,
        out: *mut u64) -> bool
}

// ------------------------------------------------------ the checked layer

// `size` octets, aligned to `align`. A size of 0 is answered with a
// refusal and not with a block of length 0 -- a pointer that must not be
// written to is the kind of half truth this round is here to remove.
fn alloc(a: dyn Allocator, size: usize, align: usize) -> Block {
    if size == 0 {
        return block_none()
    }
    if !is_power_of_two(align) {
        return block_none()
    }
    var address: u64 = 0
    if !a.raw_alloc(size, align, &address) {
        return block_none()
    }
    if address == 0 {
        return block_none()
    }
    return block_of(address as *mut u8, size)
}

// The everyday form: 16 octets alignment.
fn alloc_bytes(a: dyn Allocator, size: usize) -> Block {
    return alloc(a, size, align_default())
}

// Zeroed out. An arena over used memory hands out old octets otherwise --
// whoever wants the guarantee has to say so and pay for it.
fn alloc_zeroed(a: dyn Allocator, size: usize, align: usize) -> Block {
    let b: Block = alloc(a, size, align)
    if b.ok {
        mem_zero(b.p, b.n)
    }
    return b
}

// Giving back. A block that never came (`ok == false`) is silently
// ignored -- that makes the error path of the caller one `if` shorter and
// costs nothing, because there is nothing to give back.
fn free(a: dyn Allocator, b: Block, align: usize) {
    if !b.ok {
        return
    }
    a.raw_free(b.p as u64, b.n, align)
}

fn free_bytes(a: dyn Allocator, b: Block) {
    free(a, b, align_default())
}

// Growing. First the allocator is asked whether it can do it in place; if
// not, a new block is fetched, the contents are copied and the old one is
// given back. `size` smaller than the old length is answered with the old
// block -- shrinking is not this round's business.
fn grow(a: dyn Allocator, b: Block, size: usize, align: usize) -> Block {
    if !b.ok {
        return alloc(a, size, align)
    }
    if size <= b.n {
        return b
    }
    var address: u64 = 0
    if a.raw_grow(b.p as u64, b.n, size, align, &address) {
        if address != 0 {
            return block_of(address as *mut u8, size)
        }
    }
    let fresh: Block = alloc(a, size, align)
    if !fresh.ok {
        return block_none()
    }
    mem_copy(fresh.p, b.p, b.n)
    free(a, b, align)
    return fresh
}

// ------------------------------------------------------------- the Arena
//
// A bump allocator over memory that SOMEBODY ELSE holds: `arena_new` gets
// an address and a length and never asks for another octet. No system
// call, no page table, no free list -- which is why it works in a kernel,
// in an interrupt handler and in a program that has no operating system
// underneath it.
//
// WHAT IT CAN DO AND WHAT IT CANNOT, said plainly:
//   * alloc is a comparison and an addition. That is the whole cost.
//   * free gives back exactly ONE block: the last one handed out. Anything
//     else is accepted and does nothing. That is not a hole, it is the
//     nature of a bump allocator -- and it is the reason `arena_reset`
//     exists: a frame, a request, a parse run is freed IN ONE GO.
//   * grow grows in place if the block is the last one, otherwise it says
//     `false` and `grow` above copies.
//   * `high` remembers the highest fill level ever reached. That is the
//     number a soak run measures: it may not drift.

struct Arena {
    base: u64,
    cap: usize,
    used: usize,
    high: usize,
    last: usize,
    given: u64,
    refused: u64,
}

fn arena_new(memory: *mut u8, cap: usize) -> Arena {
    return Arena { base: memory as u64, cap: cap, used: 0, high: 0,
        last: npos(), given: 0, refused: 0 }
}

// Everything free again, in one instruction. The memory itself stays
// where it is -- the arena never owned it.
fn arena_reset(a: *mut Arena) {
    (*a).used = 0
    (*a).last = npos()
}

fn arena_used(a: *mut Arena) -> usize {
    return (*a).used
}

// The highest fill level ever reached. The measurement of a leak: it has
// to stand still.
fn arena_high(a: *mut Arena) -> usize {
    return (*a).high
}

fn arena_left(a: *mut Arena) -> usize {
    return (*a).cap - (*a).used
}

fn arena_given(a: *mut Arena) -> u64 {
    return (*a).given
}

fn arena_refused(a: *mut Arena) -> u64 {
    return (*a).refused
}

impl Arena {
    fn reset(*mut self) { arena_reset(self) }
    fn used(*mut self) -> usize { return arena_used(self) }
    fn high(*mut self) -> usize { return arena_high(self) }
    fn left(*mut self) -> usize { return arena_left(self) }
}

impl Allocator for Arena {
    fn raw_alloc(*mut self, size: usize, align: usize, out: *mut u64) -> bool {
        if size == 0 {
            (*self).refused = (*self).refused + 1
            return false
        }
        let here: usize = (*self).base as usize + (*self).used
        let start: usize = align_up(here, align)
        let of: usize = start - (*self).base as usize
        // The comparison runs on the OFFSET, not on the address: an
        // address plus a length can wrap around, an offset inside a region
        // that really exists cannot.
        if of > (*self).cap || size > (*self).cap - of {
            (*self).refused = (*self).refused + 1
            return false
        }
        (*self).last = of
        (*self).used = of + size
        if (*self).used > (*self).high {
            (*self).high = (*self).used
        }
        (*self).given = (*self).given + 1
        *out = start as u64
        return true
    }

    fn raw_free(*mut self, address: u64, size: usize, align: usize) {
        let of: usize = address as usize - (*self).base as usize
        if (*self).last != npos() && of == (*self).last {
            if of + size == (*self).used {
                (*self).used = of
                (*self).last = npos()
            }
        }
    }

    fn raw_grow(*mut self, address: u64, old: usize, size: usize, align: usize,
        out: *mut u64) -> bool {
        let of: usize = address as usize - (*self).base as usize
        if (*self).last == npos() || of != (*self).last {
            return false
        }
        if of + old != (*self).used {
            return false
        }
        if size > (*self).cap - of {
            return false
        }
        (*self).used = of + size
        if (*self).used > (*self).high {
            (*self).high = (*self).used
        }
        *out = address
        return true
    }
}
