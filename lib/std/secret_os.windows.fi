// SPDX-License-Identifier: MPL-2.0
// lib/std/secret_os.windows.fi -- the Windows twin of lib/std/secret_os.fi:
// the CREDENTIAL MANAGER (advapi32 CredWriteW / CredReadW / CredDeleteW /
// CredFree), the keyring of Windows. Selected by the compiler on
// --target=x86_64-windows.
//
// WHAT THE SYSTEM DOES FOR US. A generic credential (CRED_TYPE_GENERIC) is
// stored per user, encrypted by the system with a key derived from the
// user's logon secret (DPAPI); other users of the machine cannot read it,
// and "Credential Manager" in the Control Panel shows (and can delete) it.
// Persistence is CRED_PERSIST_LOCAL_MACHINE: it survives log off and reboot
// and does not roam.
//
// THE 2560 OCTET LIMIT. One credential holds at most 2560 octets
// (CRED_MAX_CREDENTIAL_BLOB_SIZE) -- smaller than a Microsoft/Xbox token. So
// a value is split: the first credential "<service>/<key>" holds a 4 octet
// length and the first 2000 octets, the following ones "<service>/<key>\x1f<k>"
// hold 2000 each (names with control characters are refused, so a key can
// never be mistaken for a chunk). Up to 64 KiB. The first credential is
// written LAST, so a crash leaves either the old value or the new one.
//
// WHY THE IMPORTS ARE IN THE COMPILER (compiler/src/win.rs): an indirect
// call through GetProcAddress is System V, not Win64 -- the arguments would
// land in the wrong registers. Bound as `extern fn`, the compiler puts the
// thunk in front.

import std.rt

export { os_name, os_set, os_get, os_delete }

extern fn CredWriteW(cred: u64, flags: i64) -> i32;
extern fn CredReadW(target: u64, typ: i64, flags: i64, out: u64) -> i32;
extern fn CredDeleteW(target: u64, typ: i64, flags: i64) -> i32;
extern fn CredFree(p: u64);
extern fn GetLastError() -> i32;

const CHUNK: usize = 2000
const MAX_VALUE: usize = 65536
const ERROR_NOT_FOUND: i32 = 1168
const ERROR_NO_SUCH_LOGON_SESSION: i32 = 1312
const ERROR_BAD_LENGTH: i32 = 24
const ERROR_BAD_STUB_DATA: i32 = 1783 // what Windows answers for a blob over 2560 octets
const ERROR_ACCESS_DENIED: i32 = 5

fn os_name() -> str {
    return "wincred"
}

// UTF-8 to UTF-16LE with a terminating zero, appended to `b`. false: not
// valid UTF-8.
fn to_wide(s: str, b: *mut rt.Buf) -> bool {
    let n: usize = s.length()
    var i: usize = 0
    while i < n {
        let c: u32 = s.chars(i) as u32
        var cp: u32 = 0
        var extra: usize = 0
        if c < 128 as u32 {
            cp = c
        } else if (c & 224 as u32) == 192 as u32 {
            cp = c & 31 as u32
            extra = 1
        } else if (c & 240 as u32) == 224 as u32 {
            cp = c & 15 as u32
            extra = 2
        } else if (c & 248 as u32) == 240 as u32 {
            cp = c & 7 as u32
            extra = 3
        } else {
            return false
        }
        if extra > 0 && i + extra >= n {
            return false // cut off in the middle of a character
        }
        var k: usize = 1
        while k <= extra {
            let d: u32 = s.chars(i + k) as u32
            if (d & 192 as u32) != 128 as u32 {
                return false
            }
            cp = (cp << 6) | (d & 63 as u32)
            k = k + 1
        }
        i = i + 1 + extra
        if cp >= 65536 as u32 {
            let v: u32 = cp - 65536 as u32
            let hi: u32 = 55296 as u32 + (v >> 10)
            let lo: u32 = 56320 as u32 + (v & 1023 as u32)
            rt.buf_push(b, (hi & 255 as u32) as u8)
            rt.buf_push(b, (hi >> 8) as u8)
            rt.buf_push(b, (lo & 255 as u32) as u8)
            rt.buf_push(b, (lo >> 8) as u8)
        } else {
            rt.buf_push(b, (cp & 255 as u32) as u8)
            rt.buf_push(b, (cp >> 8) as u8)
        }
    }
    rt.buf_push(b, 0 as u8)
    rt.buf_push(b, 0 as u8)
    return true
}

fn name_ok(s: str) -> bool {
    if s.length() == 0 || s.length() > 255 {
        return false
    }
    var i: usize = 0
    while i < s.length() {
        if s.chars(i) < 32 as u8 {
            return false
        }
        i = i + 1
    }
    return true
}

// "<service>/<key>" (k = 0) or "<service>/<key>\x1f<k>" as UTF-16 in `b`
fn target_wide(service: str, key: str, k: usize, b: *mut rt.Buf) -> bool {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, service.p as u64, service.length())
    rt.buf_push(&t, 47 as u8)
    rt.buf_push_bytes(&t, key.p as u64, key.length())
    if k > 0 {
        rt.buf_push(&t, 31 as u8)
        rt.buf_push_dec_u64(&t, k as u64)
    }
    let s: str = str { p: rt.buf_data(&t), n: rt.buf_len(&t) }
    let ok: bool = to_wide(s, b)
    rt.buf_free(&t)
    return ok
}

fn code_of(err: i32) -> u32 {
    if err == ERROR_NOT_FOUND { return 1 as u32 }
    if err == ERROR_NO_SUCH_LOGON_SESSION { return 2 as u32 }
    if err == ERROR_BAD_LENGTH || err == ERROR_BAD_STUB_DATA { return 3 as u32 }
    return 4 as u32
}

// writes ONE credential holding `n` octets at `p`
fn write_one(service: str, key: str, k: usize, p: u64, n: usize) -> u32 {
    var tw: rt.Buf = rt.buf_new()
    if !target_wide(service, key, k, &tw) {
        rt.buf_free(&tw)
        return 5 as u32
    }
    var user: [u16; 5] = u"firn\0"
    // CREDENTIALW (x64, 80 octets): Flags u32 @0, Type u32 @4, TargetName @8,
    // Comment @16, LastWritten @24, CredentialBlobSize u32 @32, CredentialBlob
    // @40, Persist u32 @48, AttributeCount u32 @52, Attributes @56,
    // TargetAlias @64, UserName @72
    var c: [u64; 10] = [0; 10]
    c[0] = 1 << 32 // Flags 0, Type CRED_TYPE_GENERIC
    c[1] = rt.buf_ptr(&tw)
    c[4] = n as u64
    c[5] = p
    c[6] = 2 // CRED_PERSIST_LOCAL_MACHINE
    c[9] = (&user[0]) as u64
    let ok: i32 = CredWriteW((&c[0]) as u64, 0)
    var res: u32 = 0
    if ok == 0 {
        res = code_of(GetLastError())
    }
    rt.buf_free(&tw)
    return res
}

// reads ONE credential, appending its blob to `out`; 0 ok, else a code
fn read_one(service: str, key: str, k: usize, out: *mut rt.Buf) -> u32 {
    var tw: rt.Buf = rt.buf_new()
    if !target_wide(service, key, k, &tw) {
        rt.buf_free(&tw)
        return 5 as u32
    }
    var pc: [u64; 1] = [0; 1]
    let ok: i32 = CredReadW(rt.buf_ptr(&tw), 1, 0, (&pc[0]) as u64)
    var res: u32 = 0
    if ok == 0 {
        res = code_of(GetLastError())
    } else {
        let cred: u64 = pc[0]
        let size: usize = rt.ld32(cred, 8) as usize // octet 32
        let blob: u64 = rt.ld64(cred, 5) // octet 40
        rt.buf_reserve(out, (*out).len + size + 1)
        if (*out).cap < (*out).len + size {
            res = 4 as u32
        } else {
            rt.buf_push_bytes(out, blob, size)
        }
        CredFree(cred)
    }
    rt.buf_free(&tw)
    return res
}

fn delete_one(service: str, key: str, k: usize) -> u32 {
    var tw: rt.Buf = rt.buf_new()
    if !target_wide(service, key, k, &tw) {
        rt.buf_free(&tw)
        return 5 as u32
    }
    let ok: i32 = CredDeleteW(rt.buf_ptr(&tw), 1, 0)
    var res: u32 = 0
    if ok == 0 {
        res = code_of(GetLastError())
    }
    rt.buf_free(&tw)
    return res
}

// How many chunk credentials follow the first one for a value of `total`
fn extra_chunks(total: usize) -> usize {
    if total <= CHUNK {
        return 0
    }
    return (total - CHUNK + CHUNK - 1) / CHUNK
}

// The stored length of the value (from the first credential), or -1
fn stored_total(service: str, key: str, code: *mut u32) -> i64 {
    var first: rt.Buf = rt.buf_new()
    let r: u32 = read_one(service, key, 0, &first)
    var total: i64 = -1
    if r != 0 as u32 {
        *code = r
    } else if rt.buf_len(&first) < 4 {
        *code = 4 as u32
    } else {
        total = rt.ld32(rt.buf_ptr(&first), 0) as i64
    }
    rt.buf_free(&first)
    return total
}

fn os_set(service: str, key: str, p: u64, n: usize) -> u32 {
    if !name_ok(service) || !name_ok(key) {
        return 5 as u32
    }
    if n > MAX_VALUE {
        return 3 as u32
    }
    // how many chunks did the old value have? (to remove stale ones after)
    var oldcode: u32 = 0
    let oldtotal: i64 = stored_total(service, key, &oldcode)
    // the chunks after the first one, first
    let more: usize = extra_chunks(n)
    var k: usize = 1
    while k <= more {
        var len: usize = CHUNK
        if n - CHUNK - (k - 1) * CHUNK < CHUNK {
            len = n - CHUNK - (k - 1) * CHUNK
        }
        let r: u32 = write_one(service, key, k, p + (CHUNK + (k - 1) * CHUNK) as u64, len)
        if r != 0 as u32 {
            return r
        }
        k = k + 1
    }
    // the first one: 4 octets of length, then up to CHUNK octets of data
    var first: rt.Buf = rt.buf_new()
    var head: usize = n
    if head > CHUNK {
        head = CHUNK
    }
    rt.buf_reserve(&first, 4 + head + 1)
    if first.cap < 4 + head {
        rt.buf_free(&first)
        return 4 as u32
    }
    rt.buf_push(&first, (n & 255) as u8)
    rt.buf_push(&first, ((n >> 8) & 255) as u8)
    rt.buf_push(&first, ((n >> 16) & 255) as u8)
    rt.buf_push(&first, ((n >> 24) & 255) as u8)
    rt.buf_push_bytes(&first, p, head)
    let w: u32 = write_one(service, key, 0, rt.buf_ptr(&first), rt.buf_len(&first))
    rt.buf_free(&first)
    if w != 0 as u32 {
        return w
    }
    // stale chunks of a longer previous value
    if oldtotal >= 0 {
        var j: usize = more + 1
        let oldmore: usize = extra_chunks(oldtotal as usize)
        while j <= oldmore {
            delete_one(service, key, j)
            j = j + 1
        }
    }
    return 0 as u32
}

fn os_get(service: str, key: str, out: *mut rt.Buf) -> u32 {
    if !name_ok(service) || !name_ok(key) {
        return 5 as u32
    }
    var first: rt.Buf = rt.buf_new()
    let r: u32 = read_one(service, key, 0, &first)
    if r != 0 as u32 {
        rt.buf_free(&first)
        return r
    }
    if rt.buf_len(&first) < 4 {
        rt.buf_free(&first)
        return 4 as u32
    }
    let total: usize = rt.ld32(rt.buf_ptr(&first), 0) as usize
    if total > MAX_VALUE || rt.buf_len(&first) - 4 > total {
        rt.buf_free(&first)
        return 4 as u32
    }
    let before: usize = (*out).len
    rt.buf_push_bytes(out, rt.buf_ptr(&first) + 4, rt.buf_len(&first) - 4)
    rt.buf_free(&first)
    var k: usize = 1
    let more: usize = extra_chunks(total)
    while k <= more {
        let rc: u32 = read_one(service, key, k, out)
        if rc != 0 as u32 {
            rt.buf_set_len(out, before)
            return 4 as u32 // a missing middle chunk is damage, not "not found"
        }
        k = k + 1
    }
    if (*out).len - before != total {
        rt.buf_set_len(out, before)
        return 4 as u32
    }
    return 0 as u32
}

fn os_delete(service: str, key: str) -> u32 {
    if !name_ok(service) || !name_ok(key) {
        return 5 as u32
    }
    var code: u32 = 0
    let total: i64 = stored_total(service, key, &code)
    if total < 0 && code == 1 as u32 {
        return 1 as u32
    }
    // chunks first, the first credential last (it is the commit marker)
    if total >= 0 {
        var k: usize = 1
        let more: usize = extra_chunks(total as usize)
        while k <= more {
            delete_one(service, key, k)
            k = k + 1
        }
    }
    return delete_one(service, key, 0)
}
