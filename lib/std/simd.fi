// SPDX-License-Identifier: MPL-2.0
// lib/std/simd.fi -- std.simd: readable names for the 128-bit vector intrinsics (`__v128_*`).
//
//     import std.simd
//
//     let a: v128 = simd.splat_f32(2.0)
//     let r: v128 = simd.rsqrt_nr(a)          // 1/sqrt(2), one Newton step on top of the estimate
//     let d: f32 = simd.dot4(a, r)
//
// A register is a `v128` (four f32, four i32, eight i16 or sixteen u8 -- the name of the function says which).
// Targets: x86-64 (SSE2..SSE4.1) and aarch64 (NEON). wasm32 refuses every intrinsic by name.
//
// Exactness: add/sub/mul/div/sqrt/min/max are IEEE per lane (same bits as the scalar operation). `rcp_f32` and
// `rsqrt_f32` are ESTIMATES (x86 ~12 bit, NEON ~8 bit) and differ between targets; `rcp_nr` / `rsqrt_nr` add one
// Newton step (~22 bit x86, ~16 bit NEON), still not bit-equal across targets. NaN lanes of min/max are unspecified.
// The shuffle immediates must be literals, so the common shuffles are fixed helpers here; use `__v128_shuf_f32`
// directly for any other pattern.

export {
    ld, st, splat_f32, splat_u32, lane0_f32,
    add_f32, sub_f32, mul_f32, div_f32, min_f32, max_f32, sqrt_f32, rcp_f32, rsqrt_f32, rcp_nr, rsqrt_nr, clamp_f32,
    swap_pairs_f32, swap_halves_f32, hsum_f32, dot4,
    mask_f32, mask8, any_f32,
    pack_i32_i16, pack_i32_u16, pack_i16_i8, pack_i16_u8, unpack_lo_16, unpack_hi_16,
    min_i16, max_i16, min_i32, max_i32, cmpeq_8, cmpeq_16, mulhi_16,
}

fn ld(p: u64) -> v128 {
    return __v128_load(p as *u8)
}

fn st(p: u64, v: v128) {
    __v128_store(p as *mut u8, v)
}

#[allow_fp]
fn splat_f32(x: f32) -> v128 {
    return splat_u32(__bits(x))
}

fn splat_u32(x: u32) -> v128 {
    let w: u64 = (x as u64) | ((x as u64) << 32)
    return __v128_from_u64(w, w)
}

#[allow_fp]
fn lane0_f32(v: v128) -> f32 {
    return __f32_from_bits(__v128_get_u32(v, 0))
}

fn add_f32(a: v128, b: v128) -> v128 { return __v128_addf32(a, b) }
fn sub_f32(a: v128, b: v128) -> v128 { return __v128_subf32(a, b) }
fn mul_f32(a: v128, b: v128) -> v128 { return __v128_mulf32(a, b) }
fn div_f32(a: v128, b: v128) -> v128 { return __v128_divf32(a, b) }
fn min_f32(a: v128, b: v128) -> v128 { return __v128_minf32(a, b) }
fn max_f32(a: v128, b: v128) -> v128 { return __v128_maxf32(a, b) }
fn sqrt_f32(a: v128) -> v128 { return __v128_sqrtf32(a) }
fn rcp_f32(a: v128) -> v128 { return __v128_rcpf32(a) }
fn rsqrt_f32(a: v128) -> v128 { return __v128_rsqrtf32(a) }

// One Newton step on the reciprocal estimate: r * (2 - x * r).
fn rcp_nr(x: v128) -> v128 {
    let r: v128 = __v128_rcpf32(x)
    let two: v128 = splat_u32(0x40000000 as u32)
    return __v128_mulf32(r, __v128_subf32(two, __v128_mulf32(x, r)))
}

// One Newton step on the inverse square root estimate: r * (1.5 - 0.5 * x * r * r).
fn rsqrt_nr(x: v128) -> v128 {
    let r: v128 = __v128_rsqrtf32(x)
    let half: v128 = splat_u32(0x3f000000 as u32)
    let threehalves: v128 = splat_u32(0x3fc00000 as u32)
    let t: v128 = __v128_mulf32(__v128_mulf32(half, x), __v128_mulf32(r, r))
    return __v128_mulf32(r, __v128_subf32(threehalves, t))
}

fn clamp_f32(x: v128, lo: v128, hi: v128) -> v128 {
    return __v128_minf32(__v128_maxf32(x, lo), hi)
}

// (a0 a1 a2 a3) -> (a1 a0 a3 a2)
fn swap_pairs_f32(a: v128) -> v128 {
    return __v128_shuf_f32(a, a, 0xb1)
}

// (a0 a1 a2 a3) -> (a2 a3 a0 a1)
fn swap_halves_f32(a: v128) -> v128 {
    return __v128_shuf_f32(a, a, 0x4e)
}

// Sum of the four lanes, in the lane order ((a0 + a1) + (a2 + a3)).
#[allow_fp]
fn hsum_f32(a: v128) -> f32 {
    let t: v128 = __v128_addf32(a, swap_pairs_f32(a))
    let u: v128 = __v128_addf32(t, swap_halves_f32(t))
    return lane0_f32(u)
}

#[allow_fp]
fn dot4(a: v128, b: v128) -> f32 {
    return hsum_f32(__v128_mulf32(a, b))
}

// Bit i = sign of f32 lane i (0..15 for `mask8`: top bit of byte i).
fn mask_f32(a: v128) -> u32 { return __v128_movemask_f32(a) }
fn mask8(a: v128) -> u32 { return __v128_movemask8(a) }
fn any_f32(a: v128) -> bool { return __v128_movemask_f32(a) != 0 as u32 }

// Saturating packs: a in the low half, b in the high half.
fn pack_i32_i16(a: v128, b: v128) -> v128 { return __v128_packs32(a, b) }
fn pack_i32_u16(a: v128, b: v128) -> v128 { return __v128_packus32(a, b) }
fn pack_i16_i8(a: v128, b: v128) -> v128 { return __v128_packs16(a, b) }
fn pack_i16_u8(a: v128, b: v128) -> v128 { return __v128_packus16(a, b) }
fn unpack_lo_16(a: v128, b: v128) -> v128 { return __v128_unpacklo16(a, b) }
fn unpack_hi_16(a: v128, b: v128) -> v128 { return __v128_unpackhi16(a, b) }

fn min_i16(a: v128, b: v128) -> v128 { return __v128_mini16(a, b) }
fn max_i16(a: v128, b: v128) -> v128 { return __v128_maxi16(a, b) }
fn min_i32(a: v128, b: v128) -> v128 { return __v128_mini32(a, b) }
fn max_i32(a: v128, b: v128) -> v128 { return __v128_maxi32(a, b) }
fn cmpeq_8(a: v128, b: v128) -> v128 { return __v128_cmpeq8(a, b) }
fn cmpeq_16(a: v128, b: v128) -> v128 { return __v128_cmpeq16(a, b) }
fn mulhi_16(a: v128, b: v128) -> v128 { return __v128_mulhi16(a, b) }
