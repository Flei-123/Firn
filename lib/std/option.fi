// SPDX-License-Identifier: MPL-2.0
// lib/std/option.fi -- `Option[T]`: "a value or nothing", without NULL or magic numbers.
//
// Firn has no generic enums, so `Option[T]` is a generic STRUCT with two public
// fields: `has` (bool) and `val` (T; all zero bytes when `has` is false). That is
// enough for Python's `x if x is not None else d`:
//
//     import std.vec
//     import std.option
//
//     let o: Option[i64] = vec_first_opt[i64](&v)      // Python: v[0] if v else None
//     let n: i64 = opt_unwrap_or[i64](o, -1)            // Python: n = o if o is not None else -1
//     if o.has { use(o.val) }                           // Python: if o is not None
//
// API (all generic; write the type argument, there is no inference; a generic
// function cannot be called module-qualified, so the names are bare):
//   opt_some[T](v) / opt_none[T]()            construct
//   opt_is_some[T](o) / opt_is_none[T](o)     test
//   opt_unwrap[T](o)                          the value; the zero value when empty (no panic)
//   opt_unwrap_or[T](o, d)                    the value, or `d`
//   opt_or[T](a, b)                           `a` when it has a value, else `b`
//   opt_eq[T: Scalar](a, b)                   equal when both empty or both full and equal
//   vec_get_opt / vec_first_opt / vec_last_opt / vec_pop_opt   (Vec bridges, any T except pop: Scalar)
//   vec_index_of_opt[T: Scalar](v, x)         index of the first element equal to `x`
//   vec_at_py[T](v, i)                        Python `v[i]`: negative counts from the end; out of range -> none
//   vec_slice_py[T](v, a, b, out)             Python `v[a:b]` copied into `out` (negative from the end, clamped)
//
// There are no closures in Firn, hence no `map`/`and_then`; use `if let` or `unwrap_or`.
import std.rt
import std.vec
import std.vecfn

export { Option, opt_some, opt_none, opt_is_some, opt_is_none, opt_unwrap, opt_unwrap_or, opt_or,
    opt_eq, vec_at_py, vec_slice_py, vec_get_opt, vec_first_opt, vec_last_opt, vec_pop_opt, vec_index_of_opt }

struct Option[T] {
    has: bool,
    val: T,
}

// All zero bytes of type T (no uninitialised locals in Firn: read a zeroed scratch block).
fn opt_zero[T]() -> T {
    let n: usize = size_of[T]()
    let tmp: u64 = rt.heap_alloc(n + 8)
    rt.mem_set(tmp, 0 as u8, n + 8)
    let r: T = *(tmp as *mut T)
    rt.heap_free(tmp, n + 8)
    return r
}

fn opt_some[T](v: T) -> Option[T] {
    return Option[T] { has: true, val: v }
}

fn opt_none[T]() -> Option[T] {
    return Option[T] { has: false, val: opt_zero[T]() }
}

fn opt_is_some[T](o: Option[T]) -> bool {
    return o.has
}

fn opt_is_none[T](o: Option[T]) -> bool {
    return !o.has
}

fn opt_unwrap[T](o: Option[T]) -> T {
    return o.val
}

fn opt_unwrap_or[T](o: Option[T], d: T) -> T {
    if o.has {
        return o.val
    }
    return d
}

fn opt_or[T](a: Option[T], b: Option[T]) -> Option[T] {
    if a.has {
        return a
    }
    return b
}

fn opt_eq[T: Scalar](a: Option[T], b: Option[T]) -> bool {
    if a.has != b.has {
        return false
    }
    if !a.has {
        return true
    }
    return a.val == b.val
}

// ---- Vec bridges: "element or nothing" instead of "zero value or garbage".

fn vec_get_opt[T](v: *mut Vec[T], i: usize) -> Option[T] {
    let p: *mut T = vec_elem_ptr[T](v, i)
    if p == (0 as *mut T) {
        return opt_none[T]()
    }
    return opt_some[T](*p)
}

// Python `v[i]` with a negative index counting from the end (`-1` = last). Out of range -> none.
fn vec_at_py[T](v: *mut Vec[T], i: i64) -> Option[T] {
    let n: i64 = vec_len[T](v) as i64
    var k: i64 = i
    if k < 0 {
        k = k + n
    }
    if k < 0 || k >= n {
        return opt_none[T]()
    }
    return vec_get_opt[T](v, k as usize)
}

// Python `v[a:b]` (negative bounds from the end, clamped) appended to `out`.
fn vec_slice_py[T](v: *mut Vec[T], a: i64, b: i64, out: *mut Vec[T]) -> bool {
    let n: i64 = vec_len[T](v) as i64
    var lo: i64 = a
    var hi: i64 = b
    if lo < 0 {
        lo = lo + n
        if lo < 0 { lo = 0 }
    }
    if hi < 0 {
        hi = hi + n
        if hi < 0 { hi = 0 }
    }
    if lo > n { lo = n }
    if hi > n { hi = n }
    if lo >= hi {
        return true
    }
    return vec_slice[T](v, lo as usize, hi as usize, out)
}

fn vec_first_opt[T](v: *mut Vec[T]) -> Option[T] {
    return vec_get_opt[T](v, 0)
}

fn vec_last_opt[T](v: *mut Vec[T]) -> Option[T] {
    if (*v).len == 0 {
        return opt_none[T]()
    }
    return vec_get_opt[T](v, (*v).len - 1)
}

// Removes and returns the last element; nothing when the Vec is empty.
fn vec_pop_opt[T: Scalar](v: *mut Vec[T]) -> Option[T] {
    if (*v).len == 0 {
        return opt_none[T]()
    }
    return opt_some[T](vec_pop[T](v))
}

fn vec_index_of_opt[T: Scalar](v: *mut Vec[T], x: T) -> Option[usize] {
    var i: usize = 0
    while i < (*v).len {
        if vec_at[T](v, i) == x {
            return opt_some[usize](i)
        }
        i = i + 1
    }
    return opt_none[usize]()
}
