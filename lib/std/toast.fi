// SPDX-License-Identifier: MPL-2.0
// lib/std/toast.fi -- std.toast: a desktop notification (a "toast") in one call, for a program WITHOUT a window of
// its own, with the answer to a click as a plain function. Design: docs/DIALOG.md.
//
//     import std.toast
//
//     let id: u32 = toast.show("Download finished", "mod.jar, 4.2 MiB")        // 0 = nobody showed it
//
//     var o: toast.Options = toast.options()
//     o.icon = "emblem-downloads"
//     o.urgency = toast.URGENCY_CRITICAL
//     o.timeout_ms = 7000
//     o.actions = "open\nShow file\n"                    // key, label, key, label ...
//     let id2: u32 = toast.send("Download finished", "mod.jar", &o)
//
//     fn clicked(ud: u64, id: u32, key: str) { ... }     // a named function: Firn has no closures
//     toast.dispatch(5000, clicked, 0 as u64)           // waits up to 5 s for ONE click or close
//
// WHAT IS UNDER IT. Nothing new: this is a small layer over `desktop.notify` (lib/desktop/notify.fi, tested against
// a notification server written with libdbus) that keeps ONE connection for the program, opens it at the first call
// and offers events as a poll or as a callback:
//
//   Linux     org.freedesktop.Notifications over D-Bus (GNOME Shell, KDE Plasma, dunst, mako ...): title, body, icon,
//             actions, urgency, category, timeout, replacing a notification in place, clicks and closes.
//   Windows   a balloon from a notification area icon, which Windows 10/11 shows as a toast (title, body, click).
//             Not the WinRT toast API: that needs COM / WinRT activation (docs/DIALOG.md).
//   browser   lib/@web/std/toast.fi: the Notification API (permission is asked at the first call, inside a user gesture).
//   Android   `desktop.notify`'s stub: 0. A program with a window uses `window.notify` (FIRN r64, through the Push service).
//   OrientOS  lib/desktop/notify_osum.fi: the toast of the task bar and the counter "Meldg" through the system bus.
//
// Every function answers 0 / false when it cannot do the job (no bus, no server, no permission) and never crashes.
// A callback is called on the thread that calls `dispatch`; nothing runs in the background: a program that never
// calls `poll` / `dispatch` never hears about clicks (Linux and Windows: the connection is read only then).
//
// HONEST
// N1  What a notification looks like, how long it stays and whether actions exist is the server's business
//     (`capabilities()` says). Windows ignores icon, category, urgency, timeout and actions; a click is the action
//     "default".
// N2  Not thread safe; one connection per program.
// N3  Tested against a mock server on a private D-Bus (tools/notify), under Wine (the balloon), in Chromium (the
//     Notification API); OrientOS only type-checked. Not against GNOME's or KDE's own servers.

import rt
import str
import desktop.notify as dn

export {
    Options, Event,
    options, open, send, show, close, poll, dispatch, last_key, capabilities, ready, shutdown, server_name,
    EV_NONE, EV_ACTION, EV_CLOSED,
    CLOSED_EXPIRED, CLOSED_DISMISSED, CLOSED_BY_CALL, CLOSED_UNDEFINED,
    URGENCY_DEFAULT, URGENCY_LOW, URGENCY_NORMAL, URGENCY_CRITICAL,
    TIMEOUT_DEFAULT, TIMEOUT_NEVER,
}

const EV_NONE: u32 = 0
const EV_ACTION: u32 = 1 // a click on the notification or one of its actions: `id`, `last_key()`
const EV_CLOSED: u32 = 2 // gone: `id`, `reason`

const CLOSED_EXPIRED: u32 = 1
const CLOSED_DISMISSED: u32 = 2
const CLOSED_BY_CALL: u32 = 3
const CLOSED_UNDEFINED: u32 = 4

const URGENCY_DEFAULT: i32 = -1
const URGENCY_LOW: i32 = 0
const URGENCY_NORMAL: i32 = 1
const URGENCY_CRITICAL: i32 = 2

const TIMEOUT_DEFAULT: i32 = -1
const TIMEOUT_NEVER: i32 = 0

struct Options {
    icon: str, // an icon theme name or a file path / file:// URI; "" = none
    actions: str, // "key\nLabel\nkey2\nLabel2\n"; a click on the body is the key "default"
    category: str, // "email.arrived", "transfer.complete" ...
    urgency: i32,
    timeout_ms: i32,
    replaces: u32, // the id of a notification to update in place (0 = a new one)
}

struct Event {
    kind: u32, // EV_ACTION or EV_CLOSED
    id: u32,
    reason: u32, // EV_CLOSED: CLOSED_*
}

fn options() -> Options {
    return Options { icon: "", actions: "", category: "", urgency: URGENCY_DEFAULT,
        timeout_ms: TIMEOUT_DEFAULT, replaces: 0 as u32 }
}

// The connection of this program: a heap address of a desktop.notify Notifier (0 = not opened yet).
static mut conn: u64 = 0

fn win_alloc[T]() -> u64 {
    return rt.heap_alloc(size_of[T]())
}

fn win_release[T](p: u64) {
    rt.heap_free(p, size_of[T]())
}

fn session(app: str) -> *mut dn.Notifier {
    if conn != 0 as u64 {
        return conn as *mut dn.Notifier
    }
    let p: u64 = win_alloc[dn.Notifier]()
    if p == 0 as u64 {
        return 0 as *mut dn.Notifier
    }
    var name: str = app
    if name.length() == 0 {
        name = "Firn program"
    }
    let n: *mut dn.Notifier = p as *mut dn.Notifier
    *n = dn.notify_open(name)
    conn = p
    return n
}

// Opens the connection under the name `app` (what the server shows as the sender). Optional: the first call of any
// other function opens it as "Firn program". false = no notification server.
fn open(app: str) -> bool {
    let n: *mut dn.Notifier = session(app)
    if n as u64 == 0 as u64 {
        return false
    }
    return dn.notify_ready(n)
}

// Is a notification server there? (Opens the connection if it is not open.)
fn ready() -> bool {
    let n: *mut dn.Notifier = session("")
    if n as u64 == 0 as u64 {
        return false
    }
    return dn.notify_ready(n)
}

// Shows a notification. Returns its id, 0 = it was not shown.
fn send(title: str, body: str, opts: *mut Options) -> u32 {
    let n: *mut dn.Notifier = session("")
    if n as u64 == 0 as u64 || !dn.notify_ready(n) {
        return 0 as u32
    }
    var note: dn.Note = dn.note_new(title, body)
    note.icon = (*opts).icon
    note.actions = (*opts).actions
    note.category = (*opts).category
    note.urgency = (*opts).urgency
    note.timeout_ms = (*opts).timeout_ms
    note.replaces = (*opts).replaces
    return dn.notify_show(n, &note)
}

// The short form: a title and a text.
fn show(title: str, body: str) -> u32 {
    var o: Options = options()
    return send(title, body, &o)
}

// Takes a notification away. false = no such notification, or no connection.
fn close(id: u32) -> bool {
    if conn == 0 as u64 {
        return false
    }
    return dn.notify_close(conn as *mut dn.Notifier, id)
}

// Waits up to `ms` milliseconds (0 = just look, negative = as long as it takes) for a click or a close.
fn poll(ms: i64, ev: *mut Event) -> bool {
    if conn == 0 as u64 {
        return false
    }
    var e: dn.NotifyEvent = dn.notify_event_zero()
    if !dn.notify_poll(conn as *mut dn.Notifier, ms, &e) {
        return false
    }
    (*ev).kind = e.kind
    (*ev).id = e.id
    (*ev).reason = e.reason
    return true
}

// The action key of the last EV_ACTION ("default" for a click on the notification itself); valid until the next poll.
fn last_key() -> str {
    if conn == 0 as u64 {
        return ""
    }
    return dn.notify_event_key(conn as *mut dn.Notifier)
}

// Waits up to `ms` milliseconds for ONE click or close; a click calls `on_click(ud, id, key)`. Returns true when an
// event came (clicked or closed), false after the time ran out. A close is not reported to the function: ask `poll`
// for that.
fn dispatch(ms: i64, on_click: fn(u64, u32, str), ud: u64) -> bool {
    var e: Event = Event { kind: 0 as u32, id: 0 as u32, reason: 0 as u32 }
    if !poll(ms, &e) {
        return false
    }
    if e.kind == EV_ACTION {
        on_click(ud, e.id, last_key())
    }
    return true
}

// What the server offers, one capability per line ("actions", "body-markup", "persistence" ...); the number of lines.
fn capabilities(out: *mut rt.Buf) -> usize {
    let n: *mut dn.Notifier = session("")
    if n as u64 == 0 as u64 || !dn.notify_ready(n) {
        return 0
    }
    return dn.notify_capabilities(n, out)
}

// Closes the connection. A later call opens a new one.
fn shutdown() {
    if conn == 0 as u64 {
        return
    }
    dn.notify_close_bus(conn as *mut dn.Notifier)
    win_release[dn.Notifier](conn)
    conn = 0 as u64
}

// The name of the notification server (GNOME Shell, dunst ...) APPENDED to `out`; false = there is none.
fn server_name(out: *mut rt.Buf) -> bool {
    let n: *mut dn.Notifier = session("")
    if n as u64 == 0 as u64 || !dn.notify_ready(n) {
        return false
    }
    var info: rt.Buf = rt.buf_new()
    var ok: bool = dn.notify_server_info(n, &info)
    if ok {
        var i: usize = 0
        while i < rt.buf_len(&info) && rt.buf_at(&info, i) != 10 as u8 {
            i = i + 1
        }
        rt.buf_push_bytes(out, rt.buf_ptr(&info), i)
    }
    rt.buf_free(&info)
    return ok
}
