// SPDX-License-Identifier: MPL-2.0
// lib/std/dynlib.windows.fi -- the Windows twin of lib/std/dynlib.fi (same API,
// see there). Picked by the compiler on --target=x86_64-windows.
//
// `LoadLibraryA` / `GetProcAddress` / `FreeLibrary` are real imports of the PE
// image (win.rs); the call itself goes through the compiler's generic Win64
// gate `win64_call` / `win64_callf` (a Firn indirect call is System V, a
// pointer from GetProcAddress needs Win64). So a new Win32 function needs NO
// compiler patch any more (GAPS B16): load the DLL, take the address, call.
//
// Win64 numbers integer and float arguments by POSITION: slot k of `argv`
// goes to rcx/rdx/r8/r9 AND xmm0-xmm3 (k < 4), the rest to the stack; up to
// 16 arguments. 'f' means the low 32 bits of the slot hold an f32.

import rt
import str

export {
    open, sym, close, callx, ci0, ci1, ci2, ci3, ci4, is_supported,
}

extern fn LoadLibraryA(name: u64) -> u64;
extern fn GetProcAddress(h: u64, name: u64) -> u64;
extern fn FreeLibrary(h: u64) -> i32;
extern fn win64_call(f: u64, argv: u64, n: u64) -> u64;
extern fn win64_callf(f: u64, argv: u64, n: u64) -> u64;

fn is_supported() -> bool {
    return true
}

fn cstr(s: str, buf: *mut [u8; 256]) -> bool {
    let n: usize = s.length()
    if n > 255 {
        return false
    }
    var i: usize = 0
    while i < n {
        (*buf)[i] = s.chars(i)
        i = i + 1
    }
    (*buf)[n] = 0 as u8
    return true
}

// Load `name` ("opengl32.dll", a path, ...). 0 if it cannot be loaded.
fn open(name: str) -> u64 {
    var b: [u8; 256] = [0; 256]
    if !cstr(name, &b) {
        return 0
    }
    return LoadLibraryA((&b[0]) as u64)
}

// The address of `name` in library `h` (0 = not found).
fn sym(h: u64, name: str) -> u64 {
    if h == 0 {
        return 0
    }
    var b: [u8; 256] = [0; 256]
    if !cstr(name, &b) {
        return 0
    }
    return GetProcAddress(h, (&b[0]) as u64)
}

fn close(h: u64) -> bool {
    if h == 0 {
        return false
    }
    return FreeLibrary(h) != 0
}

// Call `f` with the arguments in `argv` (one u64 slot each). `sig` gives the
// count (and is checked: only 'i', 'f', 'd'); at most 16 arguments.
fn callx(f: u64, sig: str, argv: u64, float_result: bool) -> u64 {
    if f == 0 {
        return 0
    }
    let n: usize = sig.length()
    if n > 16 {
        return 0
    }
    var buf: [u64; 16] = [0; 16]
    var k: usize = 0
    while k < n {
        let c: u8 = sig.chars(k)
        if c != 105 as u8 && c != 102 as u8 && c != 100 as u8 {
            return 0
        }
        buf[k] = rt.ld64(argv, k)
        k = k + 1
    }
    if float_result {
        return win64_callf(f, (&buf[0]) as u64, n as u64)
    }
    return win64_call(f, (&buf[0]) as u64, n as u64)
}

fn ci0(f: u64) -> u64 {
    var a: [u64; 4] = [0; 4]
    return callx(f, "", (&a[0]) as u64, false)
}

fn ci1(f: u64, a0: u64) -> u64 {
    var a: [u64; 4] = [0; 4]
    a[0] = a0
    return callx(f, "i", (&a[0]) as u64, false)
}

fn ci2(f: u64, a0: u64, a1: u64) -> u64 {
    var a: [u64; 4] = [0; 4]
    a[0] = a0
    a[1] = a1
    return callx(f, "ii", (&a[0]) as u64, false)
}

fn ci3(f: u64, a0: u64, a1: u64, a2: u64) -> u64 {
    var a: [u64; 4] = [0; 4]
    a[0] = a0
    a[1] = a1
    a[2] = a2
    return callx(f, "iii", (&a[0]) as u64, false)
}

fn ci4(f: u64, a0: u64, a1: u64, a2: u64, a3: u64) -> u64 {
    var a: [u64; 4] = [0; 4]
    a[0] = a0
    a[1] = a1
    a[2] = a2
    a[3] = a3
    return callx(f, "iiii", (&a[0]) as u64, false)
}
