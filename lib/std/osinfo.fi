// lib/std/osinfo.fi -- std.osinfo: which operating system this program was
// BUILT for.
//
// The answer is fixed at build time by the module twin mechanism of the
// compiler: on the Windows target `import std.osinfo` takes
// `osinfo.windows.fi` (next to this file), every other target takes this
// one. A library that must behave differently on Windows (file name rules,
// case-insensitive names, a different secret store) asks here instead of
// guessing from the path syntax.
//
//     import std.osinfo
//     if osinfo.is_windows() { ... }

export { is_windows }

fn is_windows() -> bool {
    return false
}
