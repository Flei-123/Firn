// SPDX-License-Identifier: MPL-2.0
// lib/std/setops.fi -- Python's set algebra on `Set[K]` (std.map):
// `|  &  -  ^  <=  >=  isdisjoint  ==  update  intersection_update ...`.
//
//     import std.map
//     import std.setops
//
//     var u: Set[i64] = set_new[i64]()
//     set_union[i64](&a, &b, &u)               // u |= a | b      (APPENDS to out)
//     set_intersection[i64](&a, &b, &out)      // a & b
//     set_difference[i64](&a, &b, &out)        // a - b
//     set_symmetric_difference[i64](&a, &b, &out)   // a ^ b
//     set_is_subset[i64](&a, &b)               // a <= b
//     set_is_superset[i64](&a, &b)  set_is_disjoint[i64](&a, &b)  set_equal[i64](&a, &b)
//     set_update[i64](&a, &b)                  // a |= b
//     set_intersection_update[i64](&a, &b)     // a &= b
//     set_difference_update[i64](&a, &b)       // a -= b
//     set_from_vec[i64](&s, &v)                // s.update(v)
//     set_to_vec[i64](&s, &out)                // list(s)  (slot order, NOT sorted)
//
// The binary forms write into a third set and leave the inputs alone; an
// output that already holds elements keeps them (call `set_clear` first for a
// fresh result). All names are bare because they are generic. Cross-checked
// against CPython sets in tests/4523.
import std.vec
import std.map

export { set_union, set_intersection, set_difference, set_symmetric_difference,
    set_is_subset, set_is_superset, set_is_disjoint, set_equal, set_update,
    set_intersection_update, set_difference_update, set_from_vec, set_to_vec }

fn set_union[K: Scalar](a: *mut Set[K], b: *mut Set[K], out: *mut Set[K]) {
    set_update[K](out, a)
    set_update[K](out, b)
}

fn set_update[K: Scalar](dst: *mut Set[K], src: *mut Set[K]) {
    let cap: usize = set_cap[K](src)
    var i: usize = set_first[K](src)
    while i < cap {
        var added: bool = false
        set_add[K](dst, set_slot_key[K](src, i), &added)
        i = set_next[K](src, i + 1)
    }
}

fn set_intersection[K: Scalar](a: *mut Set[K], b: *mut Set[K], out: *mut Set[K]) {
    let cap: usize = set_cap[K](a)
    var i: usize = set_first[K](a)
    while i < cap {
        let k: K = set_slot_key[K](a, i)
        if set_has[K](b, k) {
            var added: bool = false
            set_add[K](out, k, &added)
        }
        i = set_next[K](a, i + 1)
    }
}

fn set_difference[K: Scalar](a: *mut Set[K], b: *mut Set[K], out: *mut Set[K]) {
    let cap: usize = set_cap[K](a)
    var i: usize = set_first[K](a)
    while i < cap {
        let k: K = set_slot_key[K](a, i)
        if !set_has[K](b, k) {
            var added: bool = false
            set_add[K](out, k, &added)
        }
        i = set_next[K](a, i + 1)
    }
}

fn set_symmetric_difference[K: Scalar](a: *mut Set[K], b: *mut Set[K], out: *mut Set[K]) {
    set_difference[K](a, b, out)
    set_difference[K](b, a, out)
}

fn set_is_subset[K: Scalar](a: *mut Set[K], b: *mut Set[K]) -> bool {
    if set_len[K](a) > set_len[K](b) { return false }
    let cap: usize = set_cap[K](a)
    var i: usize = set_first[K](a)
    while i < cap {
        if !set_has[K](b, set_slot_key[K](a, i)) { return false }
        i = set_next[K](a, i + 1)
    }
    return true
}

fn set_is_superset[K: Scalar](a: *mut Set[K], b: *mut Set[K]) -> bool {
    return set_is_subset[K](b, a)
}

fn set_is_disjoint[K: Scalar](a: *mut Set[K], b: *mut Set[K]) -> bool {
    let cap: usize = set_cap[K](a)
    var i: usize = set_first[K](a)
    while i < cap {
        if set_has[K](b, set_slot_key[K](a, i)) { return false }
        i = set_next[K](a, i + 1)
    }
    return true
}

fn set_equal[K: Scalar](a: *mut Set[K], b: *mut Set[K]) -> bool {
    return set_len[K](a) == set_len[K](b) && set_is_subset[K](a, b)
}

// a &= b
fn set_intersection_update[K: Scalar](a: *mut Set[K], b: *mut Set[K]) {
    var drop: Vec[K] = vec_new[K]()
    let cap: usize = set_cap[K](a)
    var i: usize = set_first[K](a)
    while i < cap {
        let k: K = set_slot_key[K](a, i)
        if !set_has[K](b, k) { vec_push[K](&drop, k) }
        i = set_next[K](a, i + 1)
    }
    var j: usize = 0
    while j < vec_len[K](&drop) {
        set_remove[K](a, *vec_elem_ptr[K](&drop, j))
        j = j + 1
    }
    vec_free[K](&drop)
}

// a -= b
fn set_difference_update[K: Scalar](a: *mut Set[K], b: *mut Set[K]) {
    var drop: Vec[K] = vec_new[K]()
    let cap: usize = set_cap[K](b)
    var i: usize = set_first[K](b)
    while i < cap {
        vec_push[K](&drop, set_slot_key[K](b, i))
        i = set_next[K](b, i + 1)
    }
    var j: usize = 0
    while j < vec_len[K](&drop) {
        set_remove[K](a, *vec_elem_ptr[K](&drop, j))
        j = j + 1
    }
    vec_free[K](&drop)
}

fn set_from_vec[K: Scalar](s: *mut Set[K], v: *mut Vec[K]) {
    var i: usize = 0
    while i < vec_len[K](v) {
        var added: bool = false
        set_add[K](s, *vec_elem_ptr[K](v, i), &added)
        i = i + 1
    }
}

// APPENDS the elements in slot order (sort afterwards for a stable list).
fn set_to_vec[K: Scalar](s: *mut Set[K], out: *mut Vec[K]) {
    let cap: usize = set_cap[K](s)
    var i: usize = set_first[K](s)
    while i < cap {
        vec_push[K](out, set_slot_key[K](s, i))
        i = set_next[K](s, i + 1)
    }
}
