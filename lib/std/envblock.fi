// SPDX-License-Identifier: MPL-2.0
// lib/std/envblock.fi -- std.envblock: the environment of a child process.
//
// PURE (no system call), shared by `std.process` on Linux and on Windows.
// The environment a child gets is the caller's (unless cleared), minus the
// variables the command changes, plus the changes -- as one block of
// `NAME=value` strings, each followed by a zero octet.
//
//   changes   "K=V\0" sets a variable, "K\0" (no `=`) removes it
//   base      the inherited environment, "K=V\0" entries
//
// Windows compares variable names without regard to case (`Path` and `PATH`
// are the same variable), Linux compares octets; `ignore_case` is that
// difference.

import rt

export { merge_env, entry_key_eq }

// Do the entries at [a_at, a_end) of `a` and [b_at, b_end) of `b` have the
// same KEY (the part before the first `=`, or the whole entry)?
fn entry_key_eq(a: *mut rt.Buf, a_at: usize, a_end: usize, b: *mut rt.Buf, b_at: usize,
    b_end: usize, ignore_case: bool) -> bool {
    var ka: usize = a_at
    while ka < a_end && rt.buf_at(a, ka) != 61 as u8 {
        ka = ka + 1
    }
    var kb: usize = b_at
    while kb < b_end && rt.buf_at(b, kb) != 61 as u8 {
        kb = kb + 1
    }
    if ka - a_at != kb - b_at {
        return false
    }
    var j: usize = 0
    while j < ka - a_at {
        var x: u8 = rt.buf_at(a, a_at + j)
        var y: u8 = rt.buf_at(b, b_at + j)
        if ignore_case {
            if x >= 97 as u8 && x <= 122 as u8 {
                x = x - 32 as u8
            }
            if y >= 97 as u8 && y <= 122 as u8 {
                y = y - 32 as u8
            }
        }
        if x != y {
            return false
        }
        j = j + 1
    }
    return true
}

// Appends the merged environment to `out` and returns the number of
// entries. `base` may be empty (a cleared environment).
fn merge_env(base: *mut rt.Buf, changes: *mut rt.Buf, ignore_case: bool, out: *mut rt.Buf) -> usize {
    var count: usize = 0
    let total: usize = rt.buf_len(base)
    let ct: usize = rt.buf_len(changes)
    var at: usize = 0
    while at < total {
        var e: usize = at
        while e < total && rt.buf_at(base, e) != 0 as u8 {
            e = e + 1
        }
        var hit: bool = false
        var q: usize = 0
        while q < ct && !hit {
            var qe: usize = q
            while qe < ct && rt.buf_at(changes, qe) != 0 as u8 {
                qe = qe + 1
            }
            if entry_key_eq(base, at, e, changes, q, qe, ignore_case) {
                hit = true
            }
            q = qe + 1
        }
        if !hit && e > at {
            rt.buf_push_bytes(out, rt.buf_ptr(base) + at as u64, e - at + 1)
            count = count + 1
        }
        at = e + 1
    }
    var q2: usize = 0
    while q2 < ct {
        var qe2: usize = q2
        var has_eq: bool = false
        while qe2 < ct && rt.buf_at(changes, qe2) != 0 as u8 {
            if rt.buf_at(changes, qe2) == 61 as u8 {
                has_eq = true
            }
            qe2 = qe2 + 1
        }
        if has_eq {
            rt.buf_push_bytes(out, rt.buf_ptr(changes) + q2 as u64, qe2 - q2 + 1)
            count = count + 1
        }
        q2 = qe2 + 1
    }
    return count
}
