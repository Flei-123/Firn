// SPDX-License-Identifier: MPL-2.0
// lib/std/dialog.fi -- std.dialog: the system dialogs (open / save / folder / colour / font / message)
// for a program WITHOUT a window of its own, and for one with a window as well. Design: docs/DIALOG.md.
//
//     import std.rt
//     import std.dialog
//
//     var path: rt.Buf = rt.buf_new()
//     let r: i32 = dialog.open_file("Open a picture", "", "Pictures|*.png;*.jpg|All files|*", &path)
//     if r == dialog.OK { ... rt.buf_len(&path) octets of UTF-8, "/" as the separator ... }
//     rt.buf_free(&path)
//
//     var rgb: u32 = 0x1BD96A
//     dialog.pick_color("Accent", rgb, &rgb)                  // 0xRRGGBB
//     var yes: bool = false
//     dialog.confirm("Delete?", "Delete 3 files?", &yes)      // r == OK, then `yes`
//
// EVERY function returns a status and never crashes: OK (the out parameters are filled), CANCELED (the user
// closed the dialog; the out parameters are untouched), NO_BACKEND (this system has no way to show that dialog:
// no display, no helper installed, a browser, Android) or FAILED (shown, but the answer could not be read).
// None of them waits for anything but the user.
//
// THE SAME RESULT ON EVERY SYSTEM: UTF-8, paths with "/" (Windows: "C:/Users/x/a.txt"), a colour is 0xRRGGBB,
// a font is a family name + whole points + two flags, a message box answers with ANS_* (not the system's
// numbers). The filter string is the same everywhere: "Label|pattern;pattern|Label|pattern" ("" = every file).
//
// WHAT IS UNDER IT (one file per system, picked by the compiler like std.clipboard's):
//   Windows   lib/std/dialogos.windows.fi  comdlg32 + shell32 + user32 (docs/DIALOG.md, "Why not IFileDialog")
//   Linux     lib/std/dialogos.fi          zenity, kdialog, else the fUi dialog service `dialogd`
//   browser   lib/@web/std/dialog.fi       alert / confirm; the rest answers NO_BACKEND
//   Android   lib/@android/std/dialog.fi   NO_BACKEND
//
// HONEST
// B1  A dialog is modal and blocks the calling thread until the user answers; there is no time limit.
// B2  Not thread safe.
// B3  The title of the colour and the font dialog is not set on Windows (comdlg32 has no field for it).
// B4  Tested under Wine and against stand-in helpers, not on a real Windows machine / a real zenity (docs/DIALOG.md).

import rt
import str
import std.dialogos

export {
    open_file, open_files, save_file, pick_folder, pick_color, pick_font, message, confirm,
    backend_name, status_name,
    FontChoice,
    OK, CANCELED, NO_BACKEND, FAILED,
    KIND_INFO, KIND_QUESTION, KIND_WARNING, KIND_ERROR,
    BTNS_OK, BTNS_OK_CANCEL, BTNS_YES_NO, BTNS_YES_NO_CANCEL,
    ANS_OK, ANS_CANCEL, ANS_YES, ANS_NO,
}

const OK: i32 = 0
const CANCELED: i32 = 1
const NO_BACKEND: i32 = 2
const FAILED: i32 = 3

const KIND_INFO: i32 = 0
const KIND_QUESTION: i32 = 1
const KIND_WARNING: i32 = 2
const KIND_ERROR: i32 = 3

const BTNS_OK: i32 = 0
const BTNS_OK_CANCEL: i32 = 1
const BTNS_YES_NO: i32 = 2
const BTNS_YES_NO_CANCEL: i32 = 3

const ANS_OK: i32 = 1
const ANS_CANCEL: i32 = 2
const ANS_YES: i32 = 3
const ANS_NO: i32 = 4

// The answer of `pick_font`; the family name goes to a buffer of its own.
struct FontChoice {
    size: u32, // whole points
    bold: bool,
    italic: bool,
}

// What the calls of this system would use: "win32", "zenity", "kdialog", "fui", "web" or "none".
fn backend_name() -> str {
    return dialogos.os_name()
}

fn status_name(code: i32) -> str {
    if code == OK { return "ok" }
    if code == CANCELED { return "canceled" }
    if code == NO_BACKEND { return "no backend" }
    return "failed"
}

// One existing file. The path is APPENDED to `out`.
fn open_file(title: str, dir: str, filters: str, out: *mut rt.Buf) -> i32 {
    return dialogos.os_file(0, title, dir, "", filters, out)
}

// One or more existing files; the paths are appended to `out`, one per line ("\n").
fn open_files(title: str, dir: str, filters: str, out: *mut rt.Buf) -> i32 {
    return dialogos.os_file(1, title, dir, "", filters, out)
}

// A file name to write. `name` is the suggested name; the system asks before it overwrites.
fn save_file(title: str, dir: str, name: str, filters: str, out: *mut rt.Buf) -> i32 {
    return dialogos.os_file(2, title, dir, name, filters, out)
}

// An existing directory.
fn pick_folder(title: str, dir: str, out: *mut rt.Buf) -> i32 {
    return dialogos.os_file(3, title, dir, "", "", out)
}

// A colour, 0xRRGGBB. `initial` is where the dialog starts.
fn pick_color(title: str, initial: u32, out: *mut u32) -> i32 {
    var rgb: u32 = initial & 16777215 as u32
    let r: i32 = dialogos.os_color(title, rgb, &rgb)
    if r == OK {
        *out = rgb
    }
    return r
}

// A font. `family` / `size` (points, 0 = none) are where the dialog starts; the family name is APPENDED to
// `out_family`.
fn pick_font(title: str, family: str, size: u32, out_family: *mut rt.Buf, out: *mut FontChoice) -> i32 {
    var pt: u32 = 0 as u32
    var flags: u32 = 0 as u32
    var fam: rt.Buf = rt.buf_new()
    let r: i32 = dialogos.os_font(title, family, size, &fam, &pt, &flags)
    if r == OK {
        rt.buf_push_bytes(out_family, rt.buf_ptr(&fam), rt.buf_len(&fam))
        (*out).size = pt
        (*out).bold = (flags & 1 as u32) != 0 as u32
        (*out).italic = (flags & 2 as u32) != 0 as u32
    }
    rt.buf_free(&fam)
    return r
}

// A message box. `answer` gets ANS_OK, ANS_CANCEL, ANS_YES or ANS_NO. A window closed without a button
// answers ANS_CANCEL when there is a Cancel button, ANS_NO when there is only Yes / No, else ANS_OK.
fn message(kind: i32, title: str, text: str, buttons: i32, answer: *mut i32) -> i32 {
    if kind < KIND_INFO || kind > KIND_ERROR || buttons < BTNS_OK || buttons > BTNS_YES_NO_CANCEL {
        return FAILED
    }
    var a: i32 = 0
    let r: i32 = dialogos.os_message(kind, title, text, buttons, &a)
    if r == OK {
        *answer = a
    }
    return r
}

// A question with Yes and No. `yes` is true for Yes.
fn confirm(title: str, text: str, yes: *mut bool) -> i32 {
    var a: i32 = 0
    let r: i32 = message(KIND_QUESTION, title, text, BTNS_YES_NO, &a)
    if r == OK {
        *yes = a == ANS_YES
    }
    return r
}
