// SPDX-License-Identifier: MPL-2.0
import std.simd
import std.lanes.vmask

export { f32x4, splat, load, store, zero, from_lanes, select }

struct f32x4 { v: v128 }

fn splat(x: f32) -> f32x4 {
    return f32x4 { v: simd.splat_f32(x) }
}

fn zero() -> f32x4 {
    return f32x4 { v: __v128_zero() }
}

fn load(p: u64) -> f32x4 {
    return f32x4 { v: simd.ld(p) }
}

fn store(p: u64, a: f32x4) {
    simd.st(p, a.v)
}

fn from_lanes(a: f32, b: f32, c: f32, d: f32) -> f32x4 {
    var v: v128 = simd.splat_f32(a)
    v = __v128_set_u32(v, __bits(b), 1)
    v = __v128_set_u32(v, __bits(c), 2)
    v = __v128_set_u32(v, __bits(d), 3)
    return f32x4 { v: v }
}

fn select(m: vmask.mask4, a: f32x4, b: f32x4) -> f32x4 {
    return f32x4 { v: __v128_or(__v128_and(m.v, a.v), __v128_andnot(m.v, b.v)) }
}

fn ones() -> v128 {
    return simd.splat_u32(0xffffffff as u32)
}

impl f32x4 {
    fn add(self, o: f32x4) -> f32x4 { return f32x4 { v: simd.add_f32(self.v, o.v) } }
    fn sub(self, o: f32x4) -> f32x4 { return f32x4 { v: simd.sub_f32(self.v, o.v) } }
    fn mul(self, o: f32x4) -> f32x4 { return f32x4 { v: simd.mul_f32(self.v, o.v) } }
    fn div(self, o: f32x4) -> f32x4 { return f32x4 { v: simd.div_f32(self.v, o.v) } }
    fn min(self, o: f32x4) -> f32x4 { return f32x4 { v: simd.min_f32(self.v, o.v) } }
    fn max(self, o: f32x4) -> f32x4 { return f32x4 { v: simd.max_f32(self.v, o.v) } }
    fn sqrt(self) -> f32x4 { return f32x4 { v: simd.sqrt_f32(self.v) } }
    fn abs(self) -> f32x4 { return f32x4 { v: __v128_and(self.v, simd.splat_u32(0x7fffffff as u32)) } }
    fn neg(self) -> f32x4 { return f32x4 { v: __v128_xor(self.v, simd.splat_u32(0x80000000 as u32)) } }
    fn clamp(self, lo: f32x4, hi: f32x4) -> f32x4 { return f32x4 { v: simd.clamp_f32(self.v, lo.v, hi.v) } }
    fn mul_add(self, b: f32x4, c: f32x4) -> f32x4 { return f32x4 { v: simd.add_f32(simd.mul_f32(self.v, b.v), c.v) } }

    fn lt(self, o: f32x4) -> vmask.mask4 { return vmask.mask4 { v: __v128_cmplt_f32(self.v, o.v) } }
    fn le(self, o: f32x4) -> vmask.mask4 { return vmask.mask4 { v: __v128_cmple_f32(self.v, o.v) } }
    fn gt(self, o: f32x4) -> vmask.mask4 { return vmask.mask4 { v: __v128_cmplt_f32(o.v, self.v) } }
    fn ge(self, o: f32x4) -> vmask.mask4 { return vmask.mask4 { v: __v128_cmple_f32(o.v, self.v) } }
    fn eq(self, o: f32x4) -> vmask.mask4 {
        return vmask.mask4 { v: __v128_and(__v128_cmple_f32(self.v, o.v), __v128_cmple_f32(o.v, self.v)) }
    }
    fn ne(self, o: f32x4) -> vmask.mask4 {
        return vmask.mask4 { v: __v128_xor(self.eq(o).v, ones()) }
    }

    fn reverse(self) -> f32x4 { return f32x4 { v: __v128_shuffle32(self.v, 0x1b) } }
    fn swap_pairs(self) -> f32x4 { return f32x4 { v: __v128_shuffle32(self.v, 0xb1) } }
    fn swap_halves(self) -> f32x4 { return f32x4 { v: __v128_shuffle32(self.v, 0x4e) } }
    fn rotate_left(self) -> f32x4 { return f32x4 { v: __v128_shuffle32(self.v, 0x39) } }
    fn rotate_right(self) -> f32x4 { return f32x4 { v: __v128_shuffle32(self.v, 0x93) } }
    fn dup_even(self) -> f32x4 { return f32x4 { v: __v128_shuffle32(self.v, 0xa0) } }
    fn dup_odd(self) -> f32x4 { return f32x4 { v: __v128_shuffle32(self.v, 0xf5) } }
    fn interleave_lo(self, o: f32x4) -> f32x4 { return f32x4 { v: __v128_unpacklo32(self.v, o.v) } }
    fn interleave_hi(self, o: f32x4) -> f32x4 { return f32x4 { v: __v128_unpackhi32(self.v, o.v) } }
    fn broadcast(self, i: i32) -> f32x4 {
        if i == 0 { return f32x4 { v: __v128_shuffle32(self.v, 0x00) } }
        if i == 1 { return f32x4 { v: __v128_shuffle32(self.v, 0x55) } }
        if i == 2 { return f32x4 { v: __v128_shuffle32(self.v, 0xaa) } }
        return f32x4 { v: __v128_shuffle32(self.v, 0xff) }
    }

    fn lane(self, i: i32) -> f32 {
        if i == 0 { return __f32_from_bits(__v128_get_u32(self.v, 0)) }
        if i == 1 { return __f32_from_bits(__v128_get_u32(self.v, 1)) }
        if i == 2 { return __f32_from_bits(__v128_get_u32(self.v, 2)) }
        return __f32_from_bits(__v128_get_u32(self.v, 3))
    }

    fn hsum(self) -> f32 { return simd.hsum_f32(self.v) }
    fn hmin(self) -> f32 {
        let t: v128 = simd.min_f32(self.v, simd.swap_pairs_f32(self.v))
        return simd.lane0_f32(simd.min_f32(t, simd.swap_halves_f32(t)))
    }
    fn hmax(self) -> f32 {
        let t: v128 = simd.max_f32(self.v, simd.swap_pairs_f32(self.v))
        return simd.lane0_f32(simd.max_f32(t, simd.swap_halves_f32(t)))
    }
    fn dot(self, o: f32x4) -> f32 { return simd.dot4(self.v, o.v) }

}
