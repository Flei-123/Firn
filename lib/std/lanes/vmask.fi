import std.simd

export { mask4, mask8, from_v128, bits4, any4, all4, bits8, any8, all8 }

struct mask4 { v: v128 }

struct mask8 { lo: v128, hi: v128 }

fn from_v128(v: v128) -> mask4 {
    return mask4 { v: v }
}

fn bits4(m: mask4) -> u32 {
    return simd.mask_f32(m.v)
}

fn any4(m: mask4) -> bool {
    return simd.mask_f32(m.v) != (0 as u32)
}

fn all4(m: mask4) -> bool {
    return simd.mask_f32(m.v) == (15 as u32)
}

fn bits8(m: mask8) -> u32 {
    return simd.mask_f32(m.lo) | (simd.mask_f32(m.hi) << (4 as u32))
}

fn any8(m: mask8) -> bool {
    return bits8(m) != (0 as u32)
}

fn all8(m: mask8) -> bool {
    return bits8(m) == (255 as u32)
}

impl mask4 {
    fn bits(self) -> u32 { return bits4(self) }
    fn any(self) -> bool { return any4(self) }
    fn all(self) -> bool { return all4(self) }
}

impl mask8 {
    fn bits(self) -> u32 { return bits8(self) }
    fn any(self) -> bool { return any8(self) }
    fn all(self) -> bool { return all8(self) }
}
