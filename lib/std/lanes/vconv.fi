import std.lanes.vf4
import std.lanes.vi4
import std.lanes.vf8
import std.lanes.vi8

export { f32x4_to_i32x4, i32x4_to_f32x4, f32x8_to_i32x8, i32x8_to_f32x8, bits_to_f32x4, f32x4_bits }

fn f32x4_to_i32x4(a: vf4.f32x4) -> vi4.i32x4 {
    return vi4.i32x4 { v: __v128_trunc_f32_i32(a.v) }
}

fn i32x4_to_f32x4(a: vi4.i32x4) -> vf4.f32x4 {
    return vf4.f32x4 { v: __v128_cvt_i32_f32(a.v) }
}

fn f32x8_to_i32x8(a: vf8.f32x8) -> vi8.i32x8 {
    return vi8.i32x8 { lo: __v128_trunc_f32_i32(a.lo), hi: __v128_trunc_f32_i32(a.hi) }
}

fn i32x8_to_f32x8(a: vi8.i32x8) -> vf8.f32x8 {
    return vf8.f32x8 { lo: __v128_cvt_i32_f32(a.lo), hi: __v128_cvt_i32_f32(a.hi) }
}

fn bits_to_f32x4(a: vi4.i32x4) -> vf4.f32x4 {
    return vf4.f32x4 { v: a.v }
}

fn f32x4_bits(a: vf4.f32x4) -> vi4.i32x4 {
    return vi4.i32x4 { v: a.v }
}
