// SPDX-License-Identifier: MPL-2.0
import std.simd
import std.lanes.vmask
import std.lanes.vf4

export { f32x8, splat, load, store, zero, join, select }

struct f32x8 { lo: v128, hi: v128 }

fn splat(x: f32) -> f32x8 {
    let s: v128 = simd.splat_f32(x)
    return f32x8 { lo: s, hi: s }
}

fn zero() -> f32x8 {
    return f32x8 { lo: __v128_zero(), hi: __v128_zero() }
}

fn load(p: u64) -> f32x8 {
    return f32x8 { lo: simd.ld(p), hi: simd.ld(p + 16) }
}

fn store(p: u64, a: f32x8) {
    simd.st(p, a.lo)
    simd.st(p + 16, a.hi)
}

fn join(lo: vf4.f32x4, hi: vf4.f32x4) -> f32x8 {
    return f32x8 { lo: lo.v, hi: hi.v }
}

fn select(m: vmask.mask8, a: f32x8, b: f32x8) -> f32x8 {
    return f32x8 {
        lo: __v128_or(__v128_and(m.lo, a.lo), __v128_andnot(m.lo, b.lo)),
        hi: __v128_or(__v128_and(m.hi, a.hi), __v128_andnot(m.hi, b.hi)),
    }
}

fn eq_half(a: v128, b: v128) -> v128 {
    return __v128_and(__v128_cmple_f32(a, b), __v128_cmple_f32(b, a))
}

impl f32x8 {
    fn add(self, o: f32x8) -> f32x8 { return f32x8 { lo: simd.add_f32(self.lo, o.lo), hi: simd.add_f32(self.hi, o.hi) } }
    fn sub(self, o: f32x8) -> f32x8 { return f32x8 { lo: simd.sub_f32(self.lo, o.lo), hi: simd.sub_f32(self.hi, o.hi) } }
    fn mul(self, o: f32x8) -> f32x8 { return f32x8 { lo: simd.mul_f32(self.lo, o.lo), hi: simd.mul_f32(self.hi, o.hi) } }
    fn div(self, o: f32x8) -> f32x8 { return f32x8 { lo: simd.div_f32(self.lo, o.lo), hi: simd.div_f32(self.hi, o.hi) } }
    fn min(self, o: f32x8) -> f32x8 { return f32x8 { lo: simd.min_f32(self.lo, o.lo), hi: simd.min_f32(self.hi, o.hi) } }
    fn max(self, o: f32x8) -> f32x8 { return f32x8 { lo: simd.max_f32(self.lo, o.lo), hi: simd.max_f32(self.hi, o.hi) } }
    fn sqrt(self) -> f32x8 { return f32x8 { lo: simd.sqrt_f32(self.lo), hi: simd.sqrt_f32(self.hi) } }
    fn abs(self) -> f32x8 {
        let m: v128 = simd.splat_u32(0x7fffffff as u32)
        return f32x8 { lo: __v128_and(self.lo, m), hi: __v128_and(self.hi, m) }
    }
    fn neg(self) -> f32x8 {
        let m: v128 = simd.splat_u32(0x80000000 as u32)
        return f32x8 { lo: __v128_xor(self.lo, m), hi: __v128_xor(self.hi, m) }
    }
    fn mul_add(self, b: f32x8, c: f32x8) -> f32x8 { return self.mul(b).add(c) }

    fn lt(self, o: f32x8) -> vmask.mask8 { return vmask.mask8 { lo: __v128_cmplt_f32(self.lo, o.lo), hi: __v128_cmplt_f32(self.hi, o.hi) } }
    fn le(self, o: f32x8) -> vmask.mask8 { return vmask.mask8 { lo: __v128_cmple_f32(self.lo, o.lo), hi: __v128_cmple_f32(self.hi, o.hi) } }
    fn gt(self, o: f32x8) -> vmask.mask8 { return o.lt(self) }
    fn ge(self, o: f32x8) -> vmask.mask8 { return o.le(self) }
    fn eq(self, o: f32x8) -> vmask.mask8 { return vmask.mask8 { lo: eq_half(self.lo, o.lo), hi: eq_half(self.hi, o.hi) } }

    fn low(self) -> vf4.f32x4 { return vf4.f32x4 { v: self.lo } }
    fn high(self) -> vf4.f32x4 { return vf4.f32x4 { v: self.hi } }
    fn swap_halves(self) -> f32x8 { return f32x8 { lo: self.hi, hi: self.lo } }
    fn reverse(self) -> f32x8 {
        return f32x8 { lo: __v128_shuffle32(self.hi, 0x1b), hi: __v128_shuffle32(self.lo, 0x1b) }
    }

    fn lane(self, i: i32) -> f32 {
        if i < 4 { return vf4.f32x4 { v: self.lo }.lane(i) }
        return vf4.f32x4 { v: self.hi }.lane(i - 4)
    }

    fn hsum(self) -> f32 { return simd.hsum_f32(simd.add_f32(self.lo, self.hi)) }
    fn hmin(self) -> f32 { return vf4.f32x4 { v: simd.min_f32(self.lo, self.hi) }.hmin() }
    fn hmax(self) -> f32 { return vf4.f32x4 { v: simd.max_f32(self.lo, self.hi) }.hmax() }
    fn dot(self, o: f32x8) -> f32 { return self.mul(o).hsum() }
}
