// SPDX-License-Identifier: MPL-2.0
import std.simd

export { u8x16, mask16, splat, load, store, zero }

struct u8x16 { v: v128 }

struct mask16 { v: v128 }

fn splat(x: u8) -> u8x16 {
    let w: u32 = (x as u32) * (0x01010101 as u32)
    return u8x16 { v: simd.splat_u32(w) }
}

fn zero() -> u8x16 {
    return u8x16 { v: __v128_zero() }
}

fn load(p: u64) -> u8x16 {
    return u8x16 { v: simd.ld(p) }
}

fn store(p: u64, a: u8x16) {
    simd.st(p, a.v)
}

fn ones() -> v128 {
    return simd.splat_u32(0xffffffff as u32)
}

impl mask16 {
    fn bits(self) -> u32 { return simd.mask8(self.v) }
    fn any(self) -> bool { return simd.mask8(self.v) != (0 as u32) }
    fn all(self) -> bool { return simd.mask8(self.v) == (0xffff as u32) }
}

impl u8x16 {
    fn add(self, o: u8x16) -> u8x16 { return u8x16 { v: __v128_add8(self.v, o.v) } }
    fn sub(self, o: u8x16) -> u8x16 { return u8x16 { v: __v128_add8(self.v, __v128_add8(__v128_xor(o.v, ones()), simd.splat_u32(0x01010101 as u32))) } }
    fn add_sat(self, o: u8x16) -> u8x16 { return u8x16 { v: __v128_addsat_u8(self.v, o.v) } }
    fn sub_sat(self, o: u8x16) -> u8x16 { return u8x16 { v: __v128_subsat_u8(self.v, o.v) } }
    fn min(self, o: u8x16) -> u8x16 { return u8x16 { v: __v128_minu8(self.v, o.v) } }
    fn max(self, o: u8x16) -> u8x16 { return u8x16 { v: __v128_maxu8(self.v, o.v) } }
    fn and(self, o: u8x16) -> u8x16 { return u8x16 { v: __v128_and(self.v, o.v) } }
    fn or(self, o: u8x16) -> u8x16 { return u8x16 { v: __v128_or(self.v, o.v) } }
    fn xor(self, o: u8x16) -> u8x16 { return u8x16 { v: __v128_xor(self.v, o.v) } }
    fn not(self) -> u8x16 { return u8x16 { v: __v128_xor(self.v, ones()) } }
    fn abs_diff(self, o: u8x16) -> u8x16 { return self.sub_sat(o).or(o.sub_sat(self)) }

    fn eq(self, o: u8x16) -> mask16 { return mask16 { v: __v128_cmpeq8(self.v, o.v) } }
    fn le(self, o: u8x16) -> mask16 { return mask16 { v: __v128_cmpeq8(__v128_minu8(self.v, o.v), self.v) } }
    fn ge(self, o: u8x16) -> mask16 { return mask16 { v: __v128_cmpeq8(__v128_maxu8(self.v, o.v), self.v) } }
    fn ne(self, o: u8x16) -> mask16 { return mask16 { v: __v128_xor(__v128_cmpeq8(self.v, o.v), ones()) } }
    fn gt(self, o: u8x16) -> mask16 { return mask16 { v: __v128_xor(self.le(o).v, ones()) } }
    fn lt(self, o: u8x16) -> mask16 { return mask16 { v: __v128_xor(self.ge(o).v, ones()) } }
    fn select(self, m: mask16, o: u8x16) -> u8x16 {
        return u8x16 { v: __v128_or(__v128_and(m.v, self.v), __v128_andnot(m.v, o.v)) }
    }

    fn interleave_lo(self, o: u8x16) -> u8x16 { return u8x16 { v: __v128_unpacklo8(self.v, o.v) } }
    fn interleave_hi(self, o: u8x16) -> u8x16 { return u8x16 { v: __v128_unpackhi8(self.v, o.v) } }
    fn swap_halves(self) -> u8x16 { return u8x16 { v: __v128_shuffle32(self.v, 0x4e) } }

    fn lane(self, i: i32) -> u8 {
        var w: u64 = 0
        if i < 8 { w = __v128_get_u64(self.v, 0) } else { w = __v128_get_u64(self.v, 1) }
        return ((w >> (((i & 7) * 8) as u64)) & (255 as u64)) as u8
    }

    fn hsum(self) -> u32 {
        var s: u32 = 0
        var i: i32 = 0
        while i < 16 {
            s = s + (self.lane(i) as u32)
            i = i + 1
        }
        return s
    }
}
