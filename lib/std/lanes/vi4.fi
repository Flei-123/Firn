// SPDX-License-Identifier: MPL-2.0
import std.simd
import std.lanes.vmask

export { i32x4, splat, load, store, zero, from_lanes, select }

struct i32x4 { v: v128 }

fn splat(x: i32) -> i32x4 {
    return i32x4 { v: simd.splat_u32(x as% u32) }
}

fn zero() -> i32x4 {
    return i32x4 { v: __v128_zero() }
}

fn load(p: u64) -> i32x4 {
    return i32x4 { v: simd.ld(p) }
}

fn store(p: u64, a: i32x4) {
    simd.st(p, a.v)
}

fn from_lanes(a: i32, b: i32, c: i32, d: i32) -> i32x4 {
    var v: v128 = simd.splat_u32(a as% u32)
    v = __v128_set_u32(v, b as% u32, 1)
    v = __v128_set_u32(v, c as% u32, 2)
    v = __v128_set_u32(v, d as% u32, 3)
    return i32x4 { v: v }
}

fn select(m: vmask.mask4, a: i32x4, b: i32x4) -> i32x4 {
    return i32x4 { v: __v128_or(__v128_and(m.v, a.v), __v128_andnot(m.v, b.v)) }
}

fn ones() -> v128 {
    return simd.splat_u32(0xffffffff as% u32)
}

impl i32x4 {
    fn add(self, o: i32x4) -> i32x4 { return i32x4 { v: __v128_add32(self.v, o.v) } }
    fn sub(self, o: i32x4) -> i32x4 { return i32x4 { v: __v128_sub32(self.v, o.v) } }
    fn mul(self, o: i32x4) -> i32x4 { return i32x4 { v: __v128_mullo32(self.v, o.v) } }
    fn and(self, o: i32x4) -> i32x4 { return i32x4 { v: __v128_and(self.v, o.v) } }
    fn or(self, o: i32x4) -> i32x4 { return i32x4 { v: __v128_or(self.v, o.v) } }
    fn xor(self, o: i32x4) -> i32x4 { return i32x4 { v: __v128_xor(self.v, o.v) } }
    fn not(self) -> i32x4 { return i32x4 { v: __v128_xor(self.v, ones()) } }
    fn neg(self) -> i32x4 { return i32x4 { v: __v128_sub32(__v128_zero(), self.v) } }

    fn shl1(self) -> i32x4 { return i32x4 { v: __v128_shl32(self.v, 1) } }
    fn shl8(self) -> i32x4 { return i32x4 { v: __v128_shl32(self.v, 8) } }
    fn shl16(self) -> i32x4 { return i32x4 { v: __v128_shl32(self.v, 16) } }
    fn shr1(self) -> i32x4 { return i32x4 { v: __v128_shr32(self.v, 1) } }
    fn shr8(self) -> i32x4 { return i32x4 { v: __v128_shr32(self.v, 8) } }
    fn shr16(self) -> i32x4 { return i32x4 { v: __v128_shr32(self.v, 16) } }

    fn gt(self, o: i32x4) -> vmask.mask4 { return vmask.mask4 { v: __v128_cmpgt_i32(self.v, o.v) } }
    fn lt(self, o: i32x4) -> vmask.mask4 { return vmask.mask4 { v: __v128_cmpgt_i32(o.v, self.v) } }
    fn ne(self, o: i32x4) -> vmask.mask4 {
        return vmask.mask4 { v: __v128_or(__v128_cmpgt_i32(self.v, o.v), __v128_cmpgt_i32(o.v, self.v)) }
    }
    fn eq(self, o: i32x4) -> vmask.mask4 { return vmask.mask4 { v: __v128_xor(self.ne(o).v, ones()) } }
    fn ge(self, o: i32x4) -> vmask.mask4 { return vmask.mask4 { v: __v128_xor(self.lt(o).v, ones()) } }
    fn le(self, o: i32x4) -> vmask.mask4 { return vmask.mask4 { v: __v128_xor(self.gt(o).v, ones()) } }

    fn min(self, o: i32x4) -> i32x4 { return select(self.lt(o), self, o) }
    fn max(self, o: i32x4) -> i32x4 { return select(self.gt(o), self, o) }
    fn abs(self) -> i32x4 { return select(self.lt(zero()), self.neg(), self) }

    fn reverse(self) -> i32x4 { return i32x4 { v: __v128_shuffle32(self.v, 0x1b) } }
    fn swap_pairs(self) -> i32x4 { return i32x4 { v: __v128_shuffle32(self.v, 0xb1) } }
    fn swap_halves(self) -> i32x4 { return i32x4 { v: __v128_shuffle32(self.v, 0x4e) } }
    fn rotate_left(self) -> i32x4 { return i32x4 { v: __v128_shuffle32(self.v, 0x39) } }
    fn rotate_right(self) -> i32x4 { return i32x4 { v: __v128_shuffle32(self.v, 0x93) } }
    fn interleave_lo(self, o: i32x4) -> i32x4 { return i32x4 { v: __v128_unpacklo32(self.v, o.v) } }
    fn interleave_hi(self, o: i32x4) -> i32x4 { return i32x4 { v: __v128_unpackhi32(self.v, o.v) } }
    fn broadcast(self, i: i32) -> i32x4 {
        if i == 0 { return i32x4 { v: __v128_shuffle32(self.v, 0x00) } }
        if i == 1 { return i32x4 { v: __v128_shuffle32(self.v, 0x55) } }
        if i == 2 { return i32x4 { v: __v128_shuffle32(self.v, 0xaa) } }
        return i32x4 { v: __v128_shuffle32(self.v, 0xff) }
    }

    fn lane(self, i: i32) -> i32 {
        if i == 0 { return __v128_get_u32(self.v, 0) as% i32 }
        if i == 1 { return __v128_get_u32(self.v, 1) as% i32 }
        if i == 2 { return __v128_get_u32(self.v, 2) as% i32 }
        return __v128_get_u32(self.v, 3) as% i32
    }

    fn hsum(self) -> i32 {
        let t: v128 = __v128_add32(self.v, __v128_shuffle32(self.v, 0xb1))
        let u: v128 = __v128_add32(t, __v128_shuffle32(t, 0x4e))
        return __v128_get_u32(u, 0) as% i32
    }
    fn hmin(self) -> i32 {
        let t: i32x4 = self.min(self.swap_pairs())
        return t.min(t.swap_halves()).lane(0)
    }
    fn hmax(self) -> i32 {
        let t: i32x4 = self.max(self.swap_pairs())
        return t.max(t.swap_halves()).lane(0)
    }
}
