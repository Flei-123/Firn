// SPDX-License-Identifier: MPL-2.0
import std.simd
import std.lanes.vmask
import std.lanes.vi4

export { i32x8, splat, load, store, zero, join, select }

struct i32x8 { lo: v128, hi: v128 }

fn splat(x: i32) -> i32x8 {
    let s: v128 = simd.splat_u32(x as% u32)
    return i32x8 { lo: s, hi: s }
}

fn zero() -> i32x8 {
    return i32x8 { lo: __v128_zero(), hi: __v128_zero() }
}

fn load(p: u64) -> i32x8 {
    return i32x8 { lo: simd.ld(p), hi: simd.ld(p + 16) }
}

fn store(p: u64, a: i32x8) {
    simd.st(p, a.lo)
    simd.st(p + 16, a.hi)
}

fn join(lo: vi4.i32x4, hi: vi4.i32x4) -> i32x8 {
    return i32x8 { lo: lo.v, hi: hi.v }
}

fn select(m: vmask.mask8, a: i32x8, b: i32x8) -> i32x8 {
    return i32x8 {
        lo: __v128_or(__v128_and(m.lo, a.lo), __v128_andnot(m.lo, b.lo)),
        hi: __v128_or(__v128_and(m.hi, a.hi), __v128_andnot(m.hi, b.hi)),
    }
}

impl i32x8 {
    fn add(self, o: i32x8) -> i32x8 { return i32x8 { lo: __v128_add32(self.lo, o.lo), hi: __v128_add32(self.hi, o.hi) } }
    fn sub(self, o: i32x8) -> i32x8 { return i32x8 { lo: __v128_sub32(self.lo, o.lo), hi: __v128_sub32(self.hi, o.hi) } }
    fn mul(self, o: i32x8) -> i32x8 { return i32x8 { lo: __v128_mullo32(self.lo, o.lo), hi: __v128_mullo32(self.hi, o.hi) } }
    fn and(self, o: i32x8) -> i32x8 { return i32x8 { lo: __v128_and(self.lo, o.lo), hi: __v128_and(self.hi, o.hi) } }
    fn or(self, o: i32x8) -> i32x8 { return i32x8 { lo: __v128_or(self.lo, o.lo), hi: __v128_or(self.hi, o.hi) } }
    fn xor(self, o: i32x8) -> i32x8 { return i32x8 { lo: __v128_xor(self.lo, o.lo), hi: __v128_xor(self.hi, o.hi) } }

    fn gt(self, o: i32x8) -> vmask.mask8 { return vmask.mask8 { lo: __v128_cmpgt_i32(self.lo, o.lo), hi: __v128_cmpgt_i32(self.hi, o.hi) } }
    fn lt(self, o: i32x8) -> vmask.mask8 { return o.gt(self) }
    fn min(self, o: i32x8) -> i32x8 { return select(self.lt(o), self, o) }
    fn max(self, o: i32x8) -> i32x8 { return select(self.gt(o), self, o) }

    fn low(self) -> vi4.i32x4 { return vi4.i32x4 { v: self.lo } }
    fn high(self) -> vi4.i32x4 { return vi4.i32x4 { v: self.hi } }
    fn swap_halves(self) -> i32x8 { return i32x8 { lo: self.hi, hi: self.lo } }

    fn lane(self, i: i32) -> i32 {
        if i < 4 { return vi4.i32x4 { v: self.lo }.lane(i) }
        return vi4.i32x4 { v: self.hi }.lane(i - 4)
    }

    fn hsum(self) -> i32 { return vi4.i32x4 { v: __v128_add32(self.lo, self.hi) }.hsum() }
}
