import std.io
import std.hash

interface Debug { fn debug(*self) -> str }
interface Clone { fn clone(*self) -> Self }
interface Hash { fn hash(*self) -> u64 }

impl Debug for i8 {
    fn debug(*self) -> str { return io.fmt_string(io.fmt_number(io.fmt_new(), (*self) as i64)) }
}

impl Debug for i16 {
    fn debug(*self) -> str { return io.fmt_string(io.fmt_number(io.fmt_new(), (*self) as i64)) }
}

impl Debug for i32 {
    fn debug(*self) -> str { return io.fmt_string(io.fmt_number(io.fmt_new(), (*self) as i64)) }
}

impl Debug for i64 {
    fn debug(*self) -> str { return io.fmt_string(io.fmt_number(io.fmt_new(), (*self) as i64)) }
}

impl Debug for isize {
    fn debug(*self) -> str { return io.fmt_string(io.fmt_number(io.fmt_new(), (*self) as i64)) }
}

impl Debug for u8 {
    fn debug(*self) -> str { return io.fmt_string(io.fmt_u64(io.fmt_new(), (*self) as u64)) }
}

impl Debug for u16 {
    fn debug(*self) -> str { return io.fmt_string(io.fmt_u64(io.fmt_new(), (*self) as u64)) }
}

impl Debug for u32 {
    fn debug(*self) -> str { return io.fmt_string(io.fmt_u64(io.fmt_new(), (*self) as u64)) }
}

impl Debug for u64 {
    fn debug(*self) -> str { return io.fmt_string(io.fmt_u64(io.fmt_new(), (*self) as u64)) }
}

impl Debug for usize {
    fn debug(*self) -> str { return io.fmt_string(io.fmt_u64(io.fmt_new(), (*self) as u64)) }
}

impl Debug for f64 {
    fn debug(*self) -> str { return io.fmt_string(io.fmt_f64(io.fmt_new(), *self)) }
}

impl Debug for f32 {
    fn debug(*self) -> str { return io.fmt_string(io.fmt_f32(io.fmt_new(), *self)) }
}

impl Debug for bool {
    fn debug(*self) -> str { return io.fmt_string(io.fmt_bool(io.fmt_new(), *self)) }
}


impl Clone for i8 {
    fn clone(*self) -> i8 { return *self }
}

impl Clone for i16 {
    fn clone(*self) -> i16 { return *self }
}

impl Clone for i32 {
    fn clone(*self) -> i32 { return *self }
}

impl Clone for i64 {
    fn clone(*self) -> i64 { return *self }
}

impl Clone for isize {
    fn clone(*self) -> isize { return *self }
}

impl Clone for u8 {
    fn clone(*self) -> u8 { return *self }
}

impl Clone for u16 {
    fn clone(*self) -> u16 { return *self }
}

impl Clone for u32 {
    fn clone(*self) -> u32 { return *self }
}

impl Clone for u64 {
    fn clone(*self) -> u64 { return *self }
}

impl Clone for usize {
    fn clone(*self) -> usize { return *self }
}

impl Clone for f64 {
    fn clone(*self) -> f64 { return *self }
}

impl Clone for f32 {
    fn clone(*self) -> f32 { return *self }
}

impl Clone for bool {
    fn clone(*self) -> bool { return *self }
}


impl Hash for i8 {
    fn hash(*self) -> u64 { return hash.hash_mix64((*self) as u64) }
}

impl Hash for i16 {
    fn hash(*self) -> u64 { return hash.hash_mix64((*self) as u64) }
}

impl Hash for i32 {
    fn hash(*self) -> u64 { return hash.hash_mix64((*self) as u64) }
}

impl Hash for i64 {
    fn hash(*self) -> u64 { return hash.hash_mix64((*self) as u64) }
}

impl Hash for isize {
    fn hash(*self) -> u64 { return hash.hash_mix64((*self) as u64) }
}

impl Hash for u8 {
    fn hash(*self) -> u64 { return hash.hash_mix64((*self) as u64) }
}

impl Hash for u16 {
    fn hash(*self) -> u64 { return hash.hash_mix64((*self) as u64) }
}

impl Hash for u32 {
    fn hash(*self) -> u64 { return hash.hash_mix64((*self) as u64) }
}

impl Hash for u64 {
    fn hash(*self) -> u64 { return hash.hash_mix64((*self) as u64) }
}

impl Hash for usize {
    fn hash(*self) -> u64 { return hash.hash_mix64((*self) as u64) }
}

impl Hash for bool {
    fn hash(*self) -> u64 {
        if *self { return hash.hash_mix64(1 as u64) }
        return hash.hash_mix64(0 as u64)
    }
}


fn hash_seed() -> u64 { return 14695981039346656037 }

fn hash_mix(h: u64, v: u64) -> u64 { return hash.hash_mix64((h *% 1099511628211) ^ v) }

fn dbg_new() -> io.Fmt { return io.fmt_new() }

fn dbg_text(c: io.Fmt, s: str) -> io.Fmt { return io.fmt_str(c, s) }

fn dbg_field(c: io.Fmt, name: str, sep: str, value: str) -> io.Fmt {
    var g: io.Fmt = io.fmt_str(c, sep)
    g = io.fmt_str(g, name)
    g = io.fmt_str(g, ": ")
    return io.fmt_str(g, value)
}

fn dbg_done(c: io.Fmt) -> str { return io.fmt_string(c) }

fn str_debug(s: str) -> str {
    var c: io.Fmt = io.fmt_new()
    c = io.fmt_char(c, 34 as u8)
    c = io.fmt_str(c, s)
    c = io.fmt_char(c, 34 as u8)
    return io.fmt_string(c)
}

fn str_hash(s: str) -> u64 {
    unsafe { return hash.hash_bytes(s.p as u64, s.n) }
}

fn str_cmp(a: str, b: str) -> i64 {
    unsafe {
        var i: usize = 0
        while i < a.n && i < b.n {
            let ca: u8 = *(a.p + i)
            let cb: u8 = *(b.p + i)
            if ca != cb {
                if ca < cb { return 0 - 1 }
                return 1
            }
            i = i + 1
        }
        if a.n < b.n { return 0 - 1 }
        if a.n > b.n { return 1 }
        return 0
    }
}

fn bool_cmp(a: bool, b: bool) -> i64 {
    if a == b { return 0 }
    if b { return 0 - 1 }
    return 1
}
