// lib/std/cpu.fi -- what THIS processor can do (round 82).
//
// One instruction, `cpuid`, wrapped so that no one has to write it twice.
// Everything here is a RUN TIME question: the same binary has to work on the
// machine it was built on and on an older one. A compile time switch
// (`-march=native`) would be the other answer, and it is the wrong one for a
// language whose programs get copied around.
//
// The bit numbers come from `simd.rs`, which is the one place that reads
// `cpuid`; they are repeated here as named constants so that a program never
// has to write `& 32`.
//
// USE IT LIKE THIS, and not otherwise:
//
//     if cpu.has_sha() { sha256_ni(...) } else { sha256_soft(...) }
//
// The compiler inserts NO check by itself. It cannot know which two
// implementations you consider equivalent -- see `lib/std/crypto/accel.fi`,
// where exactly this pair is built and both halves are held against the same
// NIST vectors.

export {
    features,
    has_sse2, has_sse41, has_sse42, has_aes, has_pclmul, has_sha,
    has_avx2, has_bmi2, has_ssse3,
    FEAT_SSE2, FEAT_SSE41, FEAT_SSE42, FEAT_AES, FEAT_PCLMUL, FEAT_SHA,
    FEAT_AVX2, FEAT_BMI2, FEAT_SSSE3,
}

const FEAT_SSE2: u64 = 1
const FEAT_SSE41: u64 = 2
const FEAT_SSE42: u64 = 4
const FEAT_AES: u64 = 8
const FEAT_PCLMUL: u64 = 16
const FEAT_SHA: u64 = 32
const FEAT_AVX2: u64 = 64
const FEAT_BMI2: u64 = 128
const FEAT_SSSE3: u64 = 256

// The raw bit set. One `cpuid` pair per call -- some 200 cycles. Ask once
// and keep the answer if it sits in a hot loop.
fn features() -> u64 {
    return __cpu_features()
}

fn has_sse2() -> bool {
    return (__cpu_features() & FEAT_SSE2) != 0
}

fn has_sse41() -> bool {
    return (__cpu_features() & FEAT_SSE41) != 0
}

fn has_sse42() -> bool {
    return (__cpu_features() & FEAT_SSE42) != 0
}

fn has_aes() -> bool {
    return (__cpu_features() & FEAT_AES) != 0
}

fn has_pclmul() -> bool {
    return (__cpu_features() & FEAT_PCLMUL) != 0
}

// SHA-NI: `sha256rnds2`, `sha256msg1`, `sha256msg2`. Present on AMD from
// Zen 1 and on Intel from Goldmont/Ice Lake -- NOT on every x86_64.
fn has_sha() -> bool {
    return (__cpu_features() & FEAT_SHA) != 0
}

fn has_avx2() -> bool {
    return (__cpu_features() & FEAT_AVX2) != 0
}

fn has_bmi2() -> bool {
    return (__cpu_features() & FEAT_BMI2) != 0
}

fn has_ssse3() -> bool {
    return (__cpu_features() & FEAT_SSSE3) != 0
}
