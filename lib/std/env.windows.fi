// SPDX-License-Identifier: MPL-2.0
// lib/std/env.windows.fi -- std.env on Windows (picked by
// `--target=x86_64-windows` in place of lib/std/env.fi; same API, see there).
//
// The environment comes from `GetEnvironmentStringsW` (a block of UTF-16
// `NAME=value` strings), converted to UTF-8. Names compare without regard to
// case. The strings that begin with `=` (the hidden per-drive working
// directories `=C:=C:\...`) are skipped.
//
// `find_executable` is `where.exe` in miniature: a name with a separator
// (`\`, `/` or a drive colon) is a path and only checked; any other name is
// looked for in the directories of `PATH`, and a name without an extension
// is tried with every extension of `PATHEXT` (default `.COM;.EXE;.BAT;.CMD`),
// then as it is. The CURRENT DIRECTORY is NOT searched (cmd.exe does; a
// launcher that runs programs by name should not pick up `java.exe` from
// whatever folder it was started in).

import rt
import str
import cmdline

export {
    get_into, get, has, list_into, find_executable,
    PATH_SEP, DIR_SEP,
}

const PATH_SEP: u8 = 59 // ';'
const DIR_SEP: u8 = 92 // '\\'

extern fn GetEnvironmentStringsW() -> u64;
extern fn FreeEnvironmentStringsW(p: u64) -> i32;
extern fn GetFileAttributesW(path: u64) -> i32;

// The whole environment as UTF-8 "NAME=value\0" entries.
fn environ_utf8(out: *mut rt.Buf) -> bool {
    let blk: u64 = GetEnvironmentStringsW()
    if blk == 0 {
        return false
    }
    var at: usize = 0
    while rt.ld16(blk, at) != 0 as u16 {
        var e: usize = at
        while rt.ld16(blk, e) != 0 as u16 {
            e = e + 1
        }
        // skip "=C:=C:\..." and friends
        if rt.ld16(blk, at) != 61 as u16 {
            cmdline.utf16_to_utf8(blk + (at * 2) as u64, e - at, out)
            rt.buf_push(out, 0 as u8)
        }
        at = e + 1
    }
    FreeEnvironmentStringsW(blk)
    return true
}

fn upper(c: u8) -> u8 {
    if c >= 97 as u8 && c <= 122 as u8 {
        return c - 32 as u8
    }
    return c
}

fn get_into(name: str, out: *mut rt.Buf) -> bool {
    let n: usize = name.length()
    if n == 0 {
        return false
    }
    var i: usize = 0
    while i < n {
        let c: u8 = name.chars(i)
        if c == 61 as u8 || c == 0 as u8 {
            return false
        }
        i = i + 1
    }
    var blob: rt.Buf = rt.buf_new()
    if !environ_utf8(&blob) {
        rt.buf_free(&blob)
        return false
    }
    let total: usize = rt.buf_len(&blob)
    var at: usize = 0
    var found: bool = false
    while at < total && !found {
        var e: usize = at
        while e < total && rt.buf_at(&blob, e) != 0 as u8 {
            e = e + 1
        }
        if e - at > n && rt.buf_at(&blob, at + n) == 61 as u8 {
            var same: bool = true
            var j: usize = 0
            while j < n && same {
                if upper(rt.buf_at(&blob, at + j)) != upper(name.chars(j)) {
                    same = false
                }
                j = j + 1
            }
            if same {
                rt.buf_push_bytes(out, rt.buf_ptr(&blob) + (at + n + 1) as u64, e - at - n - 1)
                found = true
            }
        }
        at = e + 1
    }
    rt.buf_free(&blob)
    return found
}

fn has(name: str) -> bool {
    var tmp: rt.Buf = rt.buf_new()
    let r: bool = get_into(name, &tmp)
    rt.buf_free(&tmp)
    return r
}

fn get(name: str) -> str {
    var tmp: rt.Buf = rt.buf_new()
    if !get_into(name, &tmp) || rt.buf_len(&tmp) == 0 {
        rt.buf_free(&tmp)
        return ""
    }
    let s: str = __str_copy(str { p: rt.buf_data(&tmp), n: rt.buf_len(&tmp) })
    rt.buf_free(&tmp)
    return s
}

fn list_into(out: *mut rt.Buf) -> usize {
    var blob: rt.Buf = rt.buf_new()
    if !environ_utf8(&blob) {
        rt.buf_free(&blob)
        return 0
    }
    rt.buf_push_bytes(out, rt.buf_ptr(&blob), rt.buf_len(&blob))
    var count: usize = 0
    var i: usize = 0
    while i < rt.buf_len(&blob) {
        if rt.buf_at(&blob, i) == 0 as u8 {
            count = count + 1
        }
        i = i + 1
    }
    rt.buf_free(&blob)
    return count
}

// Is `cand` (UTF-8, no terminator) an existing FILE (not a directory)?
fn is_file_path(cand: *mut rt.Buf) -> bool {
    var w: rt.Buf = rt.buf_new()
    cmdline.utf8_to_utf16_path(rt.buf_ptr(cand), rt.buf_len(cand), &w)
    cmdline.push_u16(&w, 0 as u16)
    let a: i32 = GetFileAttributesW(rt.buf_ptr(&w))
    rt.buf_free(&w)
    if a == -1 {
        return false
    }
    return (a & 16) == 0
}

// Tries `base` + each extension of `exts` (";" separated, may be empty),
// then `base` alone when it already has an extension. true = `out` has it.
fn try_exts(base: *mut rt.Buf, has_ext: bool, exts: *mut rt.Buf, out: *mut rt.Buf) -> bool {
    let bl: usize = rt.buf_len(base)
    if has_ext && is_file_path(base) {
        rt.buf_push_bytes(out, rt.buf_ptr(base), bl)
        return true
    }
    let total: usize = rt.buf_len(exts)
    var at: usize = 0
    while at < total {
        var e: usize = at
        while e < total && rt.buf_at(exts, e) != PATH_SEP {
            e = e + 1
        }
        if e > at {
            rt.buf_set_len(base, bl)
            rt.buf_push_bytes(base, rt.buf_ptr(exts) + at as u64, e - at)
            if is_file_path(base) {
                rt.buf_push_bytes(out, rt.buf_ptr(base), rt.buf_len(base))
                rt.buf_set_len(base, bl)
                return true
            }
        }
        at = e + 1
    }
    rt.buf_set_len(base, bl)
    return false
}

fn find_executable(name: str, out: *mut rt.Buf) -> bool {
    let n: usize = name.length()
    if n == 0 {
        return false
    }
    var sep: bool = false
    var dot: bool = false
    var i: usize = 0
    while i < n {
        let c: u8 = name.chars(i)
        if c == 0 as u8 {
            return false
        }
        if c == 47 as u8 || c == 92 as u8 || c == 58 as u8 {
            sep = true
            dot = false
        }
        if c == 46 as u8 {
            dot = true
        }
        i = i + 1
    }
    var exts: rt.Buf = rt.buf_new()
    if !get_into("PATHEXT", &exts) || rt.buf_len(&exts) == 0 {
        rt.buf_free(&exts)
        exts = rt.buf_new()
        let d: str = ".COM;.EXE;.BAT;.CMD"
        rt.buf_push_bytes(&exts, d.p as u64, d.length())
    }
    var cand: rt.Buf = rt.buf_new()
    var found: bool = false
    if sep {
        rt.buf_push_bytes(&cand, name.p as u64, n)
        found = try_exts(&cand, dot, &exts, out)
    } else {
        var path: rt.Buf = rt.buf_new()
        if get_into("PATH", &path) {
            let total: usize = rt.buf_len(&path)
            var at: usize = 0
            while at <= total && !found {
                var e: usize = at
                while e < total && rt.buf_at(&path, e) != PATH_SEP {
                    e = e + 1
                }
                if e > at {
                    rt.buf_clear(&cand)
                    var a: usize = at
                    var b: usize = e
                    // a directory in quotes ("C:\Program Files\x")
                    if rt.buf_at(&path, a) == 34 as u8 && b - a >= 2 && rt.buf_at(&path, b - 1) == 34 as u8 {
                        a = a + 1
                        b = b - 1
                    }
                    rt.buf_push_bytes(&cand, rt.buf_ptr(&path) + a as u64, b - a)
                    let last: u8 = rt.buf_at(&cand, rt.buf_len(&cand) - 1)
                    if last != 92 as u8 && last != 47 as u8 {
                        rt.buf_push(&cand, 92 as u8)
                    }
                    rt.buf_push_bytes(&cand, name.p as u64, n)
                    found = try_exts(&cand, dot, &exts, out)
                }
                at = e + 1
            }
        }
        rt.buf_free(&path)
    }
    rt.buf_free(&cand)
    rt.buf_free(&exts)
    return found
}
