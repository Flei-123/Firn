// SPDX-License-Identifier: MPL-2.0
// lib/std/vdso.windows.fi -- std.vdso on Windows: there is no vDSO. The clock
// is the system call 228 the Windows seam translates (lib/std/vdso.fi has the
// Linux and Android version).

export { clock_gettime, active }

const VD_SYS_CLOCK_GETTIME: i64 = 228

fn clock_gettime(clock: i64, ts: u64) -> i64 {
    return syscall(VD_SYS_CLOCK_GETTIME, clock, ts as i64, 0, 0, 0, 0)
}

// There is no vDSO here.
fn active() -> bool {
    return false
}
