// ERZEUGT von tools/strlib/expand.py aus tools/strlib/src/std_str.fi — nicht von Hand aendern.
// QUELLE fuer lib/std/str.fi — ERZEUGT von tools/strlib/expand.py.
//
// std.str: die einheitliche Zeichenketten-Fassade ueber lib/str (SPEC §8):
// Bytes (rohe Oktette), Str (geprueftes UTF-8), Str16 (WTF-16, prueft
// nichts), Atom (internierter Name als u32). lib/str ist eine
// Einbindungs-Bibliothek (Stufe-0-Erbe, `//#include`) — darum wird die
// Fassade hier TEXTUELL zusammengesetzt und entsteht als EIN Modul namens
// `str`. lib/str selbst bleibt unveraendert.
// lib/str/alloc.fi — Speicher ohne libc (Modul str).
//
// Stufe 0 kennt keine globalen Variablen und keine Aggregate an
// Funktionsgrenzen; deshalb arbeitet die gesamte Bibliothek mit Zeigern auf
// vom Aufrufer gehaltene Strukturen. Der Speicher kommt direkt von mmap(2).
//
// Einbinden:  //#include lib/str/alloc.fi

const SYS_WRITE: i64 = 1
const SYS_READ: i64 = 0
const SYS_MMAP: i64 = 9
const SYS_MUNMAP: i64 = 11
const SYS_EXIT: i64 = 60
const PROT_READ_WRITE: i64 = 3
const MAP_PRIVATE_ANON: i64 = 34

fn page_round(n: usize) -> usize {
    return (n + 4095) / 4096 * 4096
}

// Liefert n zusammenhaengende Bytes (nullinitialisiert) oder 0 bei Fehler.
fn heap_alloc(n: usize) -> *mut u8 {
    if n == 0 {
        return 0 as *mut u8
    }
    let len: usize = page_round(n)
    let r: i64 = syscall(SYS_MMAP, 0, len as i64, PROT_READ_WRITE, MAP_PRIVATE_ANON, -1, 0)
    // mmap meldet Fehler als -1..-4095
    if r < 0 && r > -4096 {
        return 0 as *mut u8
    }
    return r as *mut u8
}

fn heap_free(p: *mut u8, n: usize) {
    if p as usize != 0 {
        syscall(SYS_MUNMAP, p as i64, page_round(n) as i64)
    }
}

fn mem_copy(dst: *mut u8, src: *mut u8, n: usize) {
    var i: usize = 0
    while i < n {
        *((dst as usize + i) as *mut u8) = *((src as usize + i) as *mut u8)
        i = i + 1
    }
}

fn mem_zero(dst: *mut u8, n: usize) {
    var i: usize = 0
    while i < n {
        *((dst as usize + i) as *mut u8) = 0 as u8
        i = i + 1
    }
}

fn mem_eq(a: *mut u8, b: *mut u8, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        if *((a as usize + i) as *mut u8) != *((b as usize + i) as *mut u8) {
            return false
        }
        i = i + 1
    }
    return true
}

// Rohe Lese-/Schreibhilfen auf 16/32/64-Bit-Elementen eines Blocks.
fn ld16(p: *mut u8, i: usize) -> u16 {
    return *((p as usize + i * 2) as *mut u16)
}
fn st16(p: *mut u8, i: usize, v: u16) {
    *((p as usize + i * 2) as *mut u16) = v
}
fn ld32(p: *mut u8, i: usize) -> u32 {
    return *((p as usize + i * 4) as *mut u32)
}
fn st32(p: *mut u8, i: usize, v: u32) {
    *((p as usize + i * 4) as *mut u32) = v
}
fn ld64(p: *mut u8, i: usize) -> u64 {
    return *((p as usize + i * 8) as *mut u64)
}
fn st64(p: *mut u8, i: usize, v: u64) {
    *((p as usize + i * 8) as *mut u64) = v
}
fn ld8(p: *mut u8, i: usize) -> u8 {
    return *((p as usize + i) as *mut u8)
}
fn st8(p: *mut u8, i: usize, v: u8) {
    *((p as usize + i) as *mut u8) = v
}

fn write_all(fd: i64, p: *mut u8, n: usize) {
    var off: usize = 0
    while off < n {
        let r: i64 = syscall(SYS_WRITE, fd, (p as usize + off) as i64, (n - off) as i64)
        if r <= 0 {
            return
        }
        off = off + r as usize
    }
}

// lib/str/bytes.fi — `Bytes` (rohe Oktette) und `Str` (geprueftes UTF-8).
//
// Layout ist Vertrag (SPEC §8.1, PLAN §3.3):
//     Bytes { ptr: *mut u8, len: usize, cap: usize }
//     Str   hat dasselbe Layout, der Inhalt ist zusaetzlich geprueftes UTF-8.
//
// `Bytes` wird NIE stillschweigend zu Text: die Umwandlung geht ausschliesslich
// ueber `bytes_to_str` (prueft) bzw. `str_from_bytes_lossy`.
//
// Einbinden:  //#include lib/str/bytes.fi   (braucht lib/str/alloc.fi)

struct Bytes {
    ptr: *mut u8,
    len: usize,
    cap: usize,
}

fn bytes_init(b: *mut Bytes) {
    (*b).ptr = 0 as *mut u8
    (*b).len = 0
    (*b).cap = 0
}

fn bytes_free(b: *mut Bytes) {
    heap_free((*b).ptr, (*b).cap)
    bytes_init(b)
}

fn bytes_reserve(b: *mut Bytes, need: usize) {
    if (*b).cap >= need {
        return
    }
    var cap: usize = (*b).cap
    if cap == 0 {
        cap = 32
    }
    while cap < need {
        cap = cap * 2
    }
    let p: *mut u8 = heap_alloc(cap)
    if (*b).len > 0 {
        mem_copy(p, (*b).ptr, (*b).len)
    }
    heap_free((*b).ptr, (*b).cap)
    (*b).ptr = p
    (*b).cap = cap
}

fn bytes_push(b: *mut Bytes, v: u8) {
    bytes_reserve(b, (*b).len + 1)
    st8((*b).ptr, (*b).len, v)
    (*b).len = (*b).len + 1
}

fn bytes_len(b: *mut Bytes) -> usize {
    return (*b).len
}

fn bytes_at(b: *mut Bytes, i: usize) -> u8 {
    if i >= (*b).len {
        return 0 as u8
    }
    return ld8((*b).ptr, i)
}

fn bytes_clear(b: *mut Bytes) {
    (*b).len = 0
}

fn bytes_append(b: *mut Bytes, p: *mut u8, n: usize) {
    bytes_reserve(b, (*b).len + n)
    mem_copy(((*b).ptr as usize + (*b).len) as *mut u8, p, n)
    (*b).len = (*b).len + n
}

fn bytes_eq(a: *mut Bytes, b: *mut Bytes) -> bool {
    if (*a).len != (*b).len {
        return false
    }
    return mem_eq((*a).ptr, (*b).ptr, (*a).len)
}

fn bytes_write(fd: i64, b: *mut Bytes) {
    write_all(fd, (*b).ptr, (*b).len)
}

// --- UTF-8-Pruefung (Grenze Bytes -> Str, SPEC §8.1) ---------------------

// Wohlgeformtes UTF-8 nach Unicode-Tabelle 3-7: keine Ueberlangkodierung,
// keine Surrogate (U+D800..U+DFFF), nichts ueber U+10FFFF.
fn utf8_is_valid(p: *mut u8, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        let b0: u32 = ld8(p, i) as u32
        var need: usize = 0
        var lo: u32 = 0
        var hi: u32 = 0
        if b0 < 0x80 {
            need = 0
        } else if b0 >= 0xC2 && b0 <= 0xDF {
            need = 1
            lo = 0x80
            hi = 0xBF
        } else if b0 == 0xE0 {
            need = 2
            lo = 0xA0
            hi = 0xBF
        } else if b0 >= 0xE1 && b0 <= 0xEC {
            need = 2
            lo = 0x80
            hi = 0xBF
        } else if b0 == 0xED {
            need = 2
            lo = 0x80
            hi = 0x9F
        } else if b0 >= 0xEE && b0 <= 0xEF {
            need = 2
            lo = 0x80
            hi = 0xBF
        } else if b0 == 0xF0 {
            need = 3
            lo = 0x90
            hi = 0xBF
        } else if b0 >= 0xF1 && b0 <= 0xF3 {
            need = 3
            lo = 0x80
            hi = 0xBF
        } else if b0 == 0xF4 {
            need = 3
            lo = 0x80
            hi = 0x8F
        } else {
            return false
        }
        if need > 0 && i + need >= n {
            return false
        }
        var k: usize = 1
        while k <= need {
            let c: u32 = ld8(p, i + k) as u32
            if k == 1 {
                if c < lo || c > hi {
                    return false
                }
            } else {
                if c < 0x80 || c > 0xBF {
                    return false
                }
            }
            k = k + 1
        }
        i = i + need + 1
    }
    return true
}

// Bytes -> Str: gelingt nur bei wohlgeformtem UTF-8 (kopiert nicht, prueft nur).
fn bytes_is_str(b: *mut Bytes) -> bool {
    return utf8_is_valid((*b).ptr, (*b).len)
}

// lib/str/str16.fi — `Str16`: Folge von u16-Codeeinheiten (WTF-16, SPEC §8.2).
//
// Str16 prueft NICHTS und normalisiert NICHTS. Ungepaarte Surrogate sind
// erlaubt und bleiben Element fuer Element erhalten — das ist Absicht: eine
// JavaScript-Zeichenkette darf sie enthalten.
//
// Layout ist Vertrag:  Str16 { ptr: *mut u16, len: usize, cap: usize }
// (len/cap zaehlen CODEEINHEITEN, nicht Bytes.)
//
// API-Vertrag mit dem Modul tok (PLAN §3.3). Da Stufe 0 weder `inout`/`&` noch
// Aggregate an Funktionsgrenzen kennt, sind die Parameter Zeiger und der
// Konstruktor heisst `str16_init(*mut Str16)` statt `str16_new() -> Str16`.
// Die Namen str16_push/str16_len/str16_at sind unveraendert.
//
// Einbinden:  //#include lib/str/str16.fi   (braucht alloc.fi, bytes.fi)

struct Str16 {
    ptr: *mut u16,
    len: usize,
    cap: usize,
}

fn str16_init(s: *mut Str16) {
    (*s).ptr = 0 as *mut u16
    (*s).len = 0
    (*s).cap = 0
}

fn str16_free(s: *mut Str16) {
    heap_free((*s).ptr as *mut u8, (*s).cap * 2)
    str16_init(s)
}

fn str16_reserve(s: *mut Str16, need: usize) {
    if (*s).cap >= need {
        return
    }
    var cap: usize = (*s).cap
    if cap == 0 {
        cap = 16
    }
    while cap < need {
        cap = cap * 2
    }
    let p: *mut u8 = heap_alloc(cap * 2)
    if (*s).len > 0 {
        mem_copy(p, (*s).ptr as *mut u8, (*s).len * 2)
    }
    heap_free((*s).ptr as *mut u8, (*s).cap * 2)
    (*s).ptr = p as *mut u16
    (*s).cap = cap
}

// Haengt EINE Codeeinheit an — ohne jede Pruefung (auch 0xD800 allein).
fn str16_push(s: *mut Str16, u: u16) {
    str16_reserve(s, (*s).len + 1)
    st16((*s).ptr as *mut u8, (*s).len, u)
    (*s).len = (*s).len + 1
}

fn str16_len(s: *mut Str16) -> usize {
    return (*s).len
}

fn str16_at(s: *mut Str16, i: usize) -> u16 {
    if i >= (*s).len {
        return 0 as u16
    }
    return ld16((*s).ptr as *mut u8, i)
}

fn str16_set(s: *mut Str16, i: usize, u: u16) {
    if i < (*s).len {
        st16((*s).ptr as *mut u8, i, u)
    }
}

fn str16_clear(s: *mut Str16) {
    (*s).len = 0
}

fn str16_eq(a: *mut Str16, b: *mut Str16) -> bool {
    if (*a).len != (*b).len {
        return false
    }
    return mem_eq((*a).ptr as *mut u8, (*b).ptr as *mut u8, (*a).len * 2)
}

// Codepunkt anhaengen: > 0xFFFF wird zum Surrogatpaar, alles andere
// (einschliesslich einzelner Surrogate!) wird eine Codeeinheit.
fn str16_push_cp(s: *mut Str16, cp: u32) {
    if cp > 0xFFFF {
        let v: u32 = cp - 0x10000
        str16_push(s, (0xD800 + (v >> 10)) as u16)
        str16_push(s, (0xDC00 + (v & 0x3FF)) as u16)
    } else {
        str16_push(s, cp as u16)
    }
}

fn is_high_surrogate(u: u32) -> bool {
    return u >= 0xD800 && u < 0xDC00
}
fn is_low_surrogate(u: u32) -> bool {
    return u >= 0xDC00 && u < 0xE000
}
fn is_surrogate(u: u32) -> bool {
    return u >= 0xD800 && u < 0xE000
}

// lib/str/str16_byval.fi — Konstruktoren nach dem API-Vertrag (PLAN §3.3).
//
// `str16_new() -> Str16` und `bytes_new() -> Bytes` geben ein Aggregat als
// Rueckgabewert zurueck. Das ist erst moeglich, seit das Modul `kern` in
// Runde 2 die System-V-Klassifikation umgesetzt hat (SPEC §14.1 Punkt 1
// gestrichen). Wer noch ohne auskommen muss, nimmt `str16_init(&s)` /
// `bytes_init(&b)` aus str16.fi bzw. bytes.fi — beide Wege liefern denselben
// leeren Wert.
//
// Einbinden:  //#include lib/str/str16_byval.fi  (braucht bytes.fi, str16.fi)

fn str16_new() -> Str16 {
    var s: Str16 = Str16{ ptr: 0 as *mut u16, len: 0, cap: 0, }
    return s
}

fn bytes_new() -> Bytes {
    var b: Bytes = Bytes{ ptr: 0 as *mut u8, len: 0, cap: 0, }
    return b
}

// lib/str/utf8.fi — Umwandlungen zwischen Str16 (WTF-16), Str (UTF-8) und
// WTF-8 (SPEC §8.2). Alle Umwandlungen sind AUSDRUECKLICH, ihre Fehlbarkeit
// steht im Ergebnis:
//
//   str16_to_utf8       -> bool   false = ungepaartes Surrogat, Ziel bleibt leer
//   str16_to_utf8_lossy -> ersetzt ungepaarte Surrogate durch U+FFFD
//   str16_to_wtf8       -> verlustfrei (haelt ungepaarte Surrogate)
//   wtf8_to_str16       -> verlustfreie Rueckrichtung
//   utf8_to_str16       -> gelingt immer, wenn die Quelle gueltiges UTF-8 ist
//
// Einbinden:  //#include lib/str/utf8.fi   (braucht alloc.fi, bytes.fi, str16.fi)

const REPLACEMENT_CP: u32 = 0xFFFD

fn utf8_push_cp(out: *mut Bytes, cp: u32) {
    if cp < 0x80 {
        bytes_push(out, cp as u8)
    } else if cp < 0x800 {
        bytes_push(out, (0xC0 + (cp >> 6)) as u8)
        bytes_push(out, (0x80 + (cp & 0x3F)) as u8)
    } else if cp < 0x10000 {
        bytes_push(out, (0xE0 + (cp >> 12)) as u8)
        bytes_push(out, (0x80 + ((cp >> 6) & 0x3F)) as u8)
        bytes_push(out, (0x80 + (cp & 0x3F)) as u8)
    } else {
        bytes_push(out, (0xF0 + (cp >> 18)) as u8)
        bytes_push(out, (0x80 + ((cp >> 12) & 0x3F)) as u8)
        bytes_push(out, (0x80 + ((cp >> 6) & 0x3F)) as u8)
        bytes_push(out, (0x80 + (cp & 0x3F)) as u8)
    }
}

fn combine_surrogates(hi: u32, lo: u32) -> u32 {
    return 0x10000 + ((hi - 0xD800) << 10) + (lo - 0xDC00)
}

// Str16 -> Str. Ergebnis false bei ungepaartem Surrogat; `out` ist dann leer.
fn str16_to_utf8(s: *mut Str16, out: *mut Bytes) -> bool {
    bytes_clear(out)
    var i: usize = 0
    let n: usize = str16_len(s)
    while i < n {
        let u: u32 = str16_at(s, i) as u32
        if is_high_surrogate(u) {
            if i + 1 >= n {
                bytes_clear(out)
                return false
            }
            let lo: u32 = str16_at(s, i + 1) as u32
            if !is_low_surrogate(lo) {
                bytes_clear(out)
                return false
            }
            utf8_push_cp(out, combine_surrogates(u, lo))
            i = i + 2
        } else if is_low_surrogate(u) {
            bytes_clear(out)
            return false
        } else {
            utf8_push_cp(out, u)
            i = i + 1
        }
    }
    return true
}

// Str16 -> Str, ersetzend: jedes ungepaarte Surrogat wird U+FFFD.
fn str16_to_utf8_lossy(s: *mut Str16, out: *mut Bytes) {
    bytes_clear(out)
    var i: usize = 0
    let n: usize = str16_len(s)
    while i < n {
        let u: u32 = str16_at(s, i) as u32
        if is_high_surrogate(u) {
            var paired: bool = false
            if i + 1 < n {
                if is_low_surrogate(str16_at(s, i + 1) as u32) {
                    paired = true
                }
            }
            if paired {
                utf8_push_cp(out, combine_surrogates(u, str16_at(s, i + 1) as u32))
                i = i + 2
            } else {
                utf8_push_cp(out, REPLACEMENT_CP)
                i = i + 1
            }
        } else if is_low_surrogate(u) {
            utf8_push_cp(out, REPLACEMENT_CP)
            i = i + 1
        } else {
            utf8_push_cp(out, u)
            i = i + 1
        }
    }
}

// Str16 -> WTF-8: verlustfreie Bruecke, ungepaarte Surrogate bleiben als
// Drei-Byte-Folge erhalten.
fn str16_to_wtf8(s: *mut Str16, out: *mut Bytes) {
    bytes_clear(out)
    var i: usize = 0
    let n: usize = str16_len(s)
    while i < n {
        let u: u32 = str16_at(s, i) as u32
        var step: usize = 1
        var cp: u32 = u
        if is_high_surrogate(u) && i + 1 < n {
            let lo: u32 = str16_at(s, i + 1) as u32
            if is_low_surrogate(lo) {
                cp = combine_surrogates(u, lo)
                step = 2
            }
        }
        utf8_push_cp(out, cp)
        i = i + step
    }
}

// WTF-8 -> Str16, verlustfrei (Surrogatfolgen werden wieder Einzeleinheiten).
fn wtf8_to_str16(b: *mut Bytes, out: *mut Str16) {
    str16_clear(out)
    var i: usize = 0
    let n: usize = bytes_len(b)
    while i < n {
        let b0: u32 = bytes_at(b, i) as u32
        var cp: u32 = 0
        var len: usize = 1
        if b0 < 0x80 {
            cp = b0
            len = 1
        } else if b0 >= 0xF0 {
            cp = b0 & 0x07
            len = 4
        } else if b0 >= 0xE0 {
            cp = b0 & 0x0F
            len = 3
        } else if b0 >= 0xC0 {
            cp = b0 & 0x1F
            len = 2
        } else {
            cp = REPLACEMENT_CP
            len = 1
        }
        if len > 1 {
            if i + len > n {
                str16_push_cp(out, REPLACEMENT_CP)
                return
            }
            var k: usize = 1
            while k < len {
                cp = (cp << 6) + (bytes_at(b, i + k) as u32 & 0x3F)
                k = k + 1
            }
        }
        if is_surrogate(cp) {
            str16_push(out, cp as u16)
        } else {
            str16_push_cp(out, cp)
        }
        i = i + len
    }
}

// Str -> Str16: gelingt immer (die Quelle ist geprueftes UTF-8).
fn utf8_to_str16(b: *mut Bytes, out: *mut Str16) {
    wtf8_to_str16(b, out)
}

// lib/str/atom.fi — `Atom` (SPEC §8.3): internierter Name als u32.
//
// Vergleich zweier Atome ist ein GANZZAHLVERGLEICH (`a == b`), kein
// Zeichenvergleich. Wer zuerst interniert, bekommt die kleinste Nummer: das
// Modul tok interniert seine bekannten Tag-Namen beim Start in fester
// Reihenfolge und erhaelt damit feste, kleine Nummern (Voraussetzung fuer
// Sprungtabellen ueber Tag-Namen).
//
// Es gibt in Stufe 0 keine globalen Variablen; die Tabelle wird darum vom
// Aufrufer gehalten und als Zeiger uebergeben.
//
// Einbinden:  //#include lib/str/atom.fi   (braucht alloc.fi, bytes.fi)

struct AtomTable {
    arena: *mut u8,     // alle Namen hintereinander
    arena_len: usize,
    arena_cap: usize,
    ents: *mut u8,      // je Atom zwei u64: Offset, Laenge
    count: usize,
    ents_cap: usize,
    buckets: *mut u8,   // offene Adressierung, je Platz ein u32 (0 = leer, sonst id+1)
    nbuckets: usize,
}

fn atom_hash(p: *mut u8, len: usize) -> u64 {
    var h: u64 = 14695981039346656037
    var i: usize = 0
    while i < len {
        h = h ^ (ld8(p, i) as u64)
        h = h * 1099511628211
        i = i + 1
    }
    return h
}

fn atom_table_init(t: *mut AtomTable) {
    (*t).arena = heap_alloc(65536)
    (*t).arena_len = 0
    (*t).arena_cap = 65536
    (*t).ents = heap_alloc(1024 * 16)
    (*t).count = 0
    (*t).ents_cap = 1024
    (*t).nbuckets = 4096
    (*t).buckets = heap_alloc(4096 * 4)
    mem_zero((*t).buckets, 4096 * 4)
}

fn atom_free(t: *mut AtomTable) {
    heap_free((*t).arena, (*t).arena_cap)
    heap_free((*t).ents, (*t).ents_cap * 16)
    heap_free((*t).buckets, (*t).nbuckets * 4)
    (*t).count = 0
}

fn atom_off(t: *mut AtomTable, id: u32) -> usize {
    return ld64((*t).ents, (id as usize) * 2) as usize
}
fn atom_len(t: *mut AtomTable, id: u32) -> usize {
    return ld64((*t).ents, (id as usize) * 2 + 1) as usize
}
fn atom_ptr(t: *mut AtomTable, id: u32) -> *mut u8 {
    return ((*t).arena as usize + atom_off(t, id)) as *mut u8
}

fn atom_count(t: *mut AtomTable) -> usize {
    return (*t).count
}

// Namen eines Atoms nach `out` kopieren.
fn atom_text(t: *mut AtomTable, id: u32, out: *mut Bytes) {
    bytes_clear(out)
    if id as usize >= (*t).count {
        return
    }
    bytes_append(out, atom_ptr(t, id), atom_len(t, id))
}

fn atom_rehash(t: *mut AtomTable) {
    let nb: usize = (*t).nbuckets * 2
    let nbuf: *mut u8 = heap_alloc(nb * 4)
    mem_zero(nbuf, nb * 4)
    heap_free((*t).buckets, (*t).nbuckets * 4)
    (*t).buckets = nbuf
    (*t).nbuckets = nb
    var id: usize = 0
    while id < (*t).count {
        let h: u64 = atom_hash(atom_ptr(t, id as u32), atom_len(t, id as u32))
        var slot: usize = (h as usize) & (nb - 1)
        while ld32(nbuf, slot) != 0 as u32 {
            slot = (slot + 1) & (nb - 1)
        }
        st32(nbuf, slot, (id + 1) as u32)
        id = id + 1
    }
}

fn atom_grow_arena(t: *mut AtomTable, need: usize) {
    if (*t).arena_len + need <= (*t).arena_cap {
        return
    }
    var cap: usize = (*t).arena_cap
    while cap < (*t).arena_len + need {
        cap = cap * 2
    }
    let p: *mut u8 = heap_alloc(cap)
    mem_copy(p, (*t).arena, (*t).arena_len)
    heap_free((*t).arena, (*t).arena_cap)
    (*t).arena = p
    (*t).arena_cap = cap
}

fn atom_grow_ents(t: *mut AtomTable) {
    if (*t).count < (*t).ents_cap {
        return
    }
    let cap: usize = (*t).ents_cap * 2
    let p: *mut u8 = heap_alloc(cap * 16)
    mem_copy(p, (*t).ents, (*t).count * 16)
    heap_free((*t).ents, (*t).ents_cap * 16)
    (*t).ents = p
    (*t).ents_cap = cap
}

// Kern: interniert `len` Oktette ab `p` und liefert die Atom-Nummer.
fn atom_intern_raw(t: *mut AtomTable, p: *mut u8, len: usize) -> u32 {
    if (*t).count * 2 >= (*t).nbuckets {
        atom_rehash(t)
    }
    let h: u64 = atom_hash(p, len)
    let mask: usize = (*t).nbuckets - 1
    var slot: usize = (h as usize) & mask
    while true {
        let e: u32 = ld32((*t).buckets, slot)
        if e == 0 as u32 {
            atom_grow_arena(t, len)
            atom_grow_ents(t)
            let id: usize = (*t).count
            let off: usize = (*t).arena_len
            mem_copy(((*t).arena as usize + off) as *mut u8, p, len)
            (*t).arena_len = off + len
            st64((*t).ents, id * 2, off as u64)
            st64((*t).ents, id * 2 + 1, len as u64)
            (*t).count = id + 1
            st32((*t).buckets, slot, (id + 1) as u32)
            return id as u32
        }
        let id: u32 = e - 1 as u32
        if atom_len(t, id) == len {
            if mem_eq(atom_ptr(t, id), p, len) {
                return id
            }
        }
        slot = (slot + 1) & mask
    }
    return 0 as u32
}

// API-Vertrag mit dem Modul tok: `atom_intern` ueber `Bytes`.
fn atom_intern(t: *mut AtomTable, b: *mut Bytes) -> u32 {
    return atom_intern_raw(t, (*b).ptr, (*b).len)
}

// Vergleich zweier Atome — ein Ganzzahlvergleich, mehr nicht.
fn atom_eq(a: u32, b: u32) -> bool {
    return a == b
}

// lib/str/std_facade.fi — die Textarbeit der std-Fassade (Runde 42).
//
// NUR fuer `lib/std/str.fi`: diese Datei wird ausschliesslich von
// `tools/strlib/src/std_str.fi` eingebunden, nicht von den erzeugten Tests
// 300-308. Die Einbindungs-Bibliothek lib/str selbst (alloc/bytes/str16/
// utf8/atom) bleibt damit unveraendert — wer sie ohne std benutzt, bekommt
// kein Byte mehr Code als vorher.
//
// WAS HIER STEHT: alles, was C# unter `string` und `char` fuehrt, soweit es
// ohne Sprachaenderung geht — Vergleiche, Suchen, Trimmen, Teilen,
// Verbinden, Ersetzen, ASCII-Gross/Klein, Auffuellen und eine
// UTF-8-SICHERE Iteration.
//
// ZWEI TYPEN, EINE REGEL:
//   * `Spanne` (Zeiger + Laenge) ist die LESENDE Sicht. Sie besitzt nichts,
//     alloziert nichts und wird als Wert weitergereicht — wie
//     `ReadOnlySpan<byte>`. Jede Frage ueber Text nimmt eine `Spanne`.
//   * `Bytes` (aus lib/str/bytes.fi) ist der BESITZENDE Puffer. Jede
//     Funktion, die Text ERZEUGT, schreibt in ein `*mut Bytes`.
// So ist an jeder Signatur ablesbar, wer Speicher haelt, und es gibt keine
// versteckte Allokation.
//
// EHRLICHE GRENZEN, gesammelt:
//   * Gross/Klein ist ASCII (A-Z / a-z). Unicode-Fallabbildung braucht die
//     UCD-Tabellen; die stehen im comptime-Zweig (tests/602_comptime_ucd.fi)
//     und gehoeren nicht in die Kernfassade.
//   * Die erzeugenden Funktionen (`ersetze`, `nach_gross`, ...) verlangen,
//     dass `aus` NICHT im Speicher der Quelle liegt. Sie leeren `aus` zuerst;
//     eine Ueberlappung waere ein Lesen aus einem gerade ueberschriebenen
//     Puffer. Wer an Ort und Stelle arbeiten will, nimmt die `_hier`-Formen.
//   * `npos()` (alle Bits gesetzt) ist "nicht gefunden" — Firn hat keine
//     Optionswerte, und ein Sonderwert ist ehrlicher als eine 0, die auch
//     "Treffer an Position 0" heissen koennte.
//   * Zahlen stehen NICHT hier, sondern in `std.num` (Text <-> Ganzzahl,
//     Text <-> f64). Doppelte Parser waeren zwei Wahrheiten.

// "nicht gefunden" / "kein Index". Als Funktion, weil `const` in Stufe 0
// ganzzahlig ausgewertet wird und 2^64-1 dort nicht darstellbar ist.
fn npos() -> usize {
    var x: usize = 0
    return x - 1
}

// ---------------------------------------------------------------- Spanne

struct Span {
    p: *mut u8,
    n: usize,
}

fn span(p: *mut u8, n: usize) -> Span {
    return Span{ p: p, n: n }
}

fn span_empty() -> Span {
    return Span{ p: 0 as *mut u8, n: 0 }
}

// Sicht auf den Inhalt eines Puffers. Gilt nur, solange der Puffer nicht
// waechst — `bytes_push` kann umziehen.
fn span_of_bytes(b: *mut Bytes) -> Span {
    return Span{ p: (*b).ptr, n: (*b).len }
}

// Laenge einer nullabgeschlossenen Folge.
fn c_length(p: *mut u8) -> usize {
    if (p as usize) == 0 {
        return 0
    }
    var n: usize = 0
    while ld8(p, n) != 0 as u8 {
        n = n + 1
    }
    return n
}

// Sicht auf eine nullabgeschlossene Folge (ohne das Nulloktett).
fn span_of_c(p: *mut u8) -> Span {
    return Span{ p: p, n: c_length(p) }
}

fn is_empty(s: Span) -> bool {
    return s.n == 0
}

fn length(s: Span) -> usize {
    return s.n
}

// Oktett an Position `i`; jenseits des Endes 0 — wie `bytes_at`.
fn chars(s: Span, i: usize) -> u8 {
    if i >= s.n {
        return 0 as u8
    }
    return ld8(s.p, i)
}

// Teilstueck ab `von`, hoechstens `wieviel` Oktette. Beide Grenzen werden
// GEKAPPT statt gemeldet: eine Sicht kann nicht ungueltig werden.
fn span_part(s: Span, of: usize, how_much: usize) -> Span {
    if of >= s.n {
        return Span{ p: s.p, n: 0 }
    }
    var rest: usize = s.n - of
    if how_much < rest {
        rest = how_much
    }
    return Span{ p: (s.p as usize + of) as *mut u8, n: rest }
}

fn span_ab(s: Span, of: usize) -> Span {
    return span_part(s, of, s.n)
}

fn span_to(s: Span, to: usize) -> Span {
    return span_part(s, 0, to)
}

// -------------------------------------------------------- Zeichenklassen
//
// ASCII. `ist_leerraum` folgt der Menge, die auch der Firn-Lexer als
// Trennung ansieht: Leerzeichen, Tab, Zeilenvorschub, Wagenruecklauf,
// Vertikaltab, Seitenvorschub.

fn is_whitespace(c: u8) -> bool {
    return c == 32 as u8 || c == 9 as u8 || c == 10 as u8 || c == 13 as u8 ||
        c == 11 as u8 || c == 12 as u8
}

fn is_digit(c: u8) -> bool {
    return c >= 48 as u8 && c <= 57 as u8
}

fn is_hex_digit(c: u8) -> bool {
    return is_digit(c) || (c >= 97 as u8 && c <= 102 as u8) ||
        (c >= 65 as u8 && c <= 70 as u8)
}

fn is_upper_letter(c: u8) -> bool {
    return c >= 65 as u8 && c <= 90 as u8
}

fn is_lower_letter(c: u8) -> bool {
    return c >= 97 as u8 && c <= 122 as u8
}

fn is_letter(c: u8) -> bool {
    return is_upper_letter(c) || is_lower_letter(c)
}

fn is_alphanumeric(c: u8) -> bool {
    return is_letter(c) || is_digit(c)
}

// Wert einer Hexziffer, sonst -1.
fn hex_value(c: u8) -> i32 {
    if is_digit(c) {
        return (c - 48 as u8) as i32
    }
    if c >= 97 as u8 && c <= 102 as u8 {
        return (c - 87 as u8) as i32
    }
    if c >= 65 as u8 && c <= 70 as u8 {
        return (c - 55 as u8) as i32
    }
    return 0 - 1
}

fn big_char(c: u8) -> u8 {
    if is_lower_letter(c) {
        return c - 32 as u8
    }
    return c
}

fn small_char(c: u8) -> u8 {
    if is_upper_letter(c) {
        return c + 32 as u8
    }
    return c
}

// ------------------------------------------------------------- Vergleich

fn equal(a: Span, b: Span) -> bool {
    if a.n != b.n {
        return false
    }
    return mem_eq(a.p, b.p, a.n)
}

// Lexikographisch ueber die Oktette; bei gemeinsamem Praefix entscheidet die
// Laenge. -1 = a vor b, 0 = gleich, 1 = a nach b.
fn compare(a: Span, b: Span) -> i32 {
    var m: usize = a.n
    if b.n < m {
        m = b.n
    }
    var i: usize = 0
    while i < m {
        let x: u8 = ld8(a.p, i)
        let y: u8 = ld8(b.p, i)
        if x < y {
            return 0 - 1
        }
        if x > y {
            return 1
        }
        i = i + 1
    }
    if a.n < b.n {
        return 0 - 1
    }
    if a.n > b.n {
        return 1
    }
    return 0
}

fn equal_without_case(a: Span, b: Span) -> bool {
    if a.n != b.n {
        return false
    }
    var i: usize = 0
    while i < a.n {
        if small_char(ld8(a.p, i)) != small_char(ld8(b.p, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

fn compare_without_case(a: Span, b: Span) -> i32 {
    var m: usize = a.n
    if b.n < m {
        m = b.n
    }
    var i: usize = 0
    while i < m {
        let x: u8 = small_char(ld8(a.p, i))
        let y: u8 = small_char(ld8(b.p, i))
        if x < y {
            return 0 - 1
        }
        if x > y {
            return 1
        }
        i = i + 1
    }
    if a.n < b.n {
        return 0 - 1
    }
    if a.n > b.n {
        return 1
    }
    return 0
}

fn starts_with(s: Span, part: Span) -> bool {
    if part.n > s.n {
        return false
    }
    return mem_eq(s.p, part.p, part.n)
}

fn ends_with(s: Span, part: Span) -> bool {
    if part.n > s.n {
        return false
    }
    return mem_eq((s.p as usize + (s.n - part.n)) as *mut u8, part.p, part.n)
}

// ---------------------------------------------------------------- Suchen

fn find_char_ab(s: Span, c: u8, ab: usize) -> usize {
    var i: usize = ab
    while i < s.n {
        if ld8(s.p, i) == c {
            return i
        }
        i = i + 1
    }
    return npos()
}

fn find_char(s: Span, c: u8) -> usize {
    return find_char_ab(s, c, 0)
}

fn find_char_back(s: Span, c: u8) -> usize {
    var i: usize = s.n
    while i > 0 {
        i = i - 1
        if ld8(s.p, i) == c {
            return i
        }
    }
    return npos()
}

// Ein LEERER Suchtext wird an `ab` gefunden — dieselbe Regel wie in C# und
// Rust; sie macht `ersetze` mit leerem `alt` zu einer Nulloperation statt zu
// einer Endlosschleife.
fn find_ab(s: Span, part: Span, ab: usize) -> usize {
    if part.n == 0 {
        if ab > s.n {
            return npos()
        }
        return ab
    }
    if part.n > s.n {
        return npos()
    }
    let last: usize = s.n - part.n
    var i: usize = ab
    while i <= last {
        if mem_eq((s.p as usize + i) as *mut u8, part.p, part.n) {
            return i
        }
        i = i + 1
    }
    return npos()
}

fn find(s: Span, part: Span) -> usize {
    return find_ab(s, part, 0)
}

fn find_back(s: Span, part: Span) -> usize {
    if part.n == 0 {
        return s.n
    }
    if part.n > s.n {
        return npos()
    }
    var i: usize = s.n - part.n + 1
    while i > 0 {
        i = i - 1
        if mem_eq((s.p as usize + i) as *mut u8, part.p, part.n) {
            return i
        }
    }
    return npos()
}

fn contains(s: Span, part: Span) -> bool {
    return find(s, part) != npos()
}

fn contains_char(s: Span, c: u8) -> bool {
    return find_char(s, c) != npos()
}

fn count_char(s: Span, c: u8) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < s.n {
        if ld8(s.p, i) == c {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// Nicht ueberlappende Vorkommen. Leerer Suchtext: 0 (sonst waere die Antwort
// "unendlich" oder willkuerlich).
fn count_part(s: Span, part: Span) -> usize {
    if part.n == 0 || part.n > s.n {
        return 0
    }
    var n: usize = 0
    var i: usize = 0
    while true {
        let f: usize = find_ab(s, part, i)
        if f == npos() {
            return n
        }
        n = n + 1
        i = f + part.n
        if i > s.n {
            return n
        }
    }
    return n
}

// Erstes Oktett, das NICHT in `menge` steht — die Grundlage jedes Trimmens
// mit eigener Zeichenmenge.
fn find_not_out(s: Span, set: Span, ab: usize) -> usize {
    var i: usize = ab
    while i < s.n {
        if !contains_char(set, ld8(s.p, i)) {
            return i
        }
        i = i + 1
    }
    return npos()
}

// --------------------------------------------------------------- Trimmen

fn trim_left(s: Span) -> Span {
    var i: usize = 0
    while i < s.n && is_whitespace(ld8(s.p, i)) {
        i = i + 1
    }
    return span_ab(s, i)
}

fn trim_right(s: Span) -> Span {
    var e: usize = s.n
    while e > 0 && is_whitespace(ld8(s.p, e - 1)) {
        e = e - 1
    }
    return span_to(s, e)
}

fn trim(s: Span) -> Span {
    return trim_right(trim_left(s))
}

// Trimmt jedes Oktett, das in `menge` steht.
fn trim_set(s: Span, set: Span) -> Span {
    var a: usize = 0
    while a < s.n && contains_char(set, ld8(s.p, a)) {
        a = a + 1
    }
    var e: usize = s.n
    while e > a && contains_char(set, ld8(s.p, e - 1)) {
        e = e - 1
    }
    return span_part(s, a, e - a)
}

// Praefix/Suffix abschneiden, falls vorhanden — sonst unveraendert.
fn without_prefix(s: Span, part: Span) -> Span {
    if starts_with(s, part) {
        return span_ab(s, part.n)
    }
    return s
}

fn without_suffix(s: Span, part: Span) -> Span {
    if ends_with(s, part) {
        return span_to(s, s.n - part.n)
    }
    return s
}

// ----------------------------------------------------------------- Teilen
//
// Ein KURSOR, keine Liste: Firn hat in diesem Modul kein `Vec` (lib/str ist
// eine Einbindungs-Bibliothek ohne Modulstruktur), und ein Kursor ist
// ohnehin die Form, die nichts alloziert.
//
//     var t: str.Teiler = str.teiler_neu(quelle, trenner)
//     var stueck: str.Spanne = str.spanne_leer()
//     while str.teiler_naechst(&t, &stueck) { ... }
//
// Regeln (wie C# String.Split ohne RemoveEmptyEntries):
//   * "a,b,,c" mit "," ergibt "a", "b", "", "c"
//   * "" ergibt genau EIN leeres Stueck
//   * ein leerer Trenner ergibt genau EIN Stueck: die ganze Quelle
//   * `teiler_leerraum` fasst Leerraumfolgen zusammen und liefert NIE ein
//     leeres Stueck — das ist die Form, die man beim Zerlegen einer
//     Kommandozeile will.

const DIVISOR_SEP: u32 = 0
const DIVISOR_WHITESPACE: u32 = 1

struct Divisor {
    source: Span,
    sep: Span,
    i: usize,
    mode: u32,
    done: bool,
}

fn divisor_new(s: Span, sep: Span) -> Divisor {
    return Divisor{ source: s, sep: sep, i: 0,
                   mode: DIVISOR_SEP, done: false }
}

fn divisor_whitespace(s: Span) -> Divisor {
    return Divisor{ source: s, sep: span_empty(), i: 0,
                   mode: DIVISOR_WHITESPACE, done: false }
}

fn divisor_next(t: *mut Divisor, out: *mut Span) -> bool {
    if (*t).done {
        return false
    }
    var s: Span = (*t).source
    if (*t).mode == DIVISOR_WHITESPACE {
        var i: usize = (*t).i
        while i < s.n && is_whitespace(ld8(s.p, i)) {
            i = i + 1
        }
        if i >= s.n {
            (*t).i = s.n
            (*t).done = true
            return false
        }
        let start: usize = i
        while i < s.n && !is_whitespace(ld8(s.p, i)) {
            i = i + 1
        }
        (*t).i = i
        (*out).p = (s.p as usize + start) as *mut u8
        (*out).n = i - start
        return true
    }
    var tr: Span = (*t).sep
    let start: usize = (*t).i
    if tr.n == 0 {
        (*t).done = true
        (*out).p = s.p
        (*out).n = s.n
        return true
    }
    let f: usize = find_ab(s, tr, start)
    if f == npos() {
        (*t).done = true
        var rest: Span = span_ab(s, start)
        (*out).p = rest.p
        (*out).n = rest.n
        return true
    }
    (*out).p = (s.p as usize + start) as *mut u8
    (*out).n = f - start
    (*t).i = f + tr.n
    return true
}

// Wie viele Stuecke `teiler_neu` liefern wird — fuer den Aufrufer, der
// vorher Platz schaffen will.
fn parts_count(s: Span, sep: Span) -> usize {
    if sep.n == 0 {
        return 1
    }
    return count_part(s, sep) + 1
}

// ----------------------------------------------------------- Text bauen
//
// Alles hier haengt an einem `*mut Bytes` an oder ersetzt dessen Inhalt.
// `_hier` heisst: an Ort und Stelle, ohne zweiten Puffer.

fn append(out: *mut Bytes, s: Span) {
    bytes_append(out, s.p, s.n)
}

fn append_char(out: *mut Bytes, c: u8) {
    bytes_push(out, c)
}

fn set(out: *mut Bytes, s: Span) {
    bytes_clear(out)
    bytes_append(out, s.p, s.n)
}

fn repeat(out: *mut Bytes, s: Span, times: usize) {
    var i: usize = 0
    while i < times {
        bytes_append(out, s.p, s.n)
        i = i + 1
    }
}

// Verbinden: `teil` anhaengen, davor den Trenner — aber nur, wenn schon
// etwas dasteht. Damit ist die ganze Schleife der Aufrufer:
//
//     while str.teiler_naechst(&t, &st) { str.verbinde_teil(&aus, st, tr) }
fn join_part(out: *mut Bytes, part: Span, sep: Span) {
    if bytes_len(out) > 0 {
        bytes_append(out, sep.p, sep.n)
    }
    bytes_append(out, part.p, part.n)
}

// Rechtsbuendig auf `breite` bringen (links auffuellen). Ist der Text schon
// laenger, wird NICHT abgeschnitten.
fn fill_left(out: *mut Bytes, s: Span, width: usize, filler: u8) {
    var i: usize = s.n
    while i < width {
        bytes_push(out, filler)
        i = i + 1
    }
    bytes_append(out, s.p, s.n)
}

fn fill_right(out: *mut Bytes, s: Span, width: usize, filler: u8) {
    bytes_append(out, s.p, s.n)
    var i: usize = s.n
    while i < width {
        bytes_push(out, filler)
        i = i + 1
    }
}

// ------------------------------------------------------- Gross und Klein

fn after_big(out: *mut Bytes, s: Span) {
    bytes_clear(out)
    var i: usize = 0
    while i < s.n {
        bytes_push(out, big_char(ld8(s.p, i)))
        i = i + 1
    }
}

fn after_small(out: *mut Bytes, s: Span) {
    bytes_clear(out)
    var i: usize = 0
    while i < s.n {
        bytes_push(out, small_char(ld8(s.p, i)))
        i = i + 1
    }
}

fn big_here(b: *mut Bytes) {
    var i: usize = 0
    while i < (*b).len {
        st8((*b).ptr, i, big_char(ld8((*b).ptr, i)))
        i = i + 1
    }
}

fn small_here(b: *mut Bytes) {
    var i: usize = 0
    while i < (*b).len {
        st8((*b).ptr, i, small_char(ld8((*b).ptr, i)))
        i = i + 1
    }
}

// ------------------------------------------------------------- Ersetzen

// Alle nicht ueberlappenden Vorkommen. Rueckgabe: wie oft ersetzt wurde.
// `aus` wird geleert und muss ausserhalb von `s`, `alt` und `neu` liegen.
fn replace(out: *mut Bytes, s: Span, old: Span, new: Span) -> usize {
    bytes_clear(out)
    if old.n == 0 || old.n > s.n {
        bytes_append(out, s.p, s.n)
        return 0
    }
    var n: usize = 0
    var i: usize = 0
    while i < s.n {
        let f: usize = find_ab(s, old, i)
        if f == npos() {
            bytes_append(out, (s.p as usize + i) as *mut u8, s.n - i)
            return n
        }
        bytes_append(out, (s.p as usize + i) as *mut u8, f - i)
        bytes_append(out, new.p, new.n)
        n = n + 1
        i = f + old.n
    }
    return n
}

fn replace_first(out: *mut Bytes, s: Span, old: Span, new: Span) -> bool {
    bytes_clear(out)
    if old.n == 0 {
        bytes_append(out, s.p, s.n)
        return false
    }
    let f: usize = find(s, old)
    if f == npos() {
        bytes_append(out, s.p, s.n)
        return false
    }
    bytes_append(out, s.p, f)
    bytes_append(out, new.p, new.n)
    let ab: usize = f + old.n
    bytes_append(out, (s.p as usize + ab) as *mut u8, s.n - ab)
    return true
}

// Oktettweise, an Ort und Stelle — die Laenge aendert sich nicht.
fn replace_char_here(b: *mut Bytes, old: u8, new: u8) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < (*b).len {
        if ld8((*b).ptr, i) == old {
            st8((*b).ptr, i, new)
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// ------------------------------------------------------- UTF-8-Iteration
//
// `utf8_is_valid` (lib/str/utf8.fi) sagt, OB eine Folge gueltig ist. Hier
// steht, wie man ueber sie LAEUFT, ohne mitten in ein Zeichen zu greifen.
//
// `utf8_lies` prueft dieselben Regeln wie `utf8_is_valid`: Ueberlange
// Kodierungen, Surrogate (U+D800..U+DFFF) und alles ueber U+10FFFF sind
// UNGUELTIG. Ein ungueltiges Oktett wird als EIN Zeichen mit `gueltig =
// false` gemeldet (cp = U+FFFD), damit jede Schleife garantiert vorankommt.

struct CharHit {
    cp: u32,
    length: usize,
    valid: bool,
}

fn is_cont_byte(c: u8) -> bool {
    return (c & 0xC0 as u8) == 0x80 as u8
}

fn utf8_bad_char() -> CharHit {
    return CharHit{ cp: REPLACEMENT_CP, length: 1, valid: false }
}

fn utf8_read(s: Span, i: usize) -> CharHit {
    if i >= s.n {
        return CharHit{ cp: 0, length: 0, valid: false }
    }
    let c0: u8 = ld8(s.p, i)
    if c0 < 0x80 as u8 {
        return CharHit{ cp: c0 as u32, length: 1, valid: true }
    }
    if c0 < 0xC2 as u8 {
        // 0x80..0xBF sind Folgeoktette, 0xC0/0xC1 waeren ueberlang.
        return utf8_bad_char()
    }
    if c0 < 0xE0 as u8 {
        if i + 1 >= s.n {
            return utf8_bad_char()
        }
        let c1: u8 = ld8(s.p, i + 1)
        if !is_cont_byte(c1) {
            return utf8_bad_char()
        }
        let cp: u32 = ((c0 as u32 & 0x1F) << 6) | (c1 as u32 & 0x3F)
        return CharHit{ cp: cp, length: 2, valid: true }
    }
    if c0 < 0xF0 as u8 {
        if i + 2 >= s.n {
            return utf8_bad_char()
        }
        let c1: u8 = ld8(s.p, i + 1)
        let c2: u8 = ld8(s.p, i + 2)
        if !is_cont_byte(c1) || !is_cont_byte(c2) {
            return utf8_bad_char()
        }
        let cp: u32 = ((c0 as u32 & 0x0F) << 12) | ((c1 as u32 & 0x3F) << 6) |
            (c2 as u32 & 0x3F)
        if cp < 0x800 {
            return utf8_bad_char()
        }
        if cp >= 0xD800 && cp <= 0xDFFF {
            return utf8_bad_char()
        }
        return CharHit{ cp: cp, length: 3, valid: true }
    }
    if c0 < 0xF5 as u8 {
        if i + 3 >= s.n {
            return utf8_bad_char()
        }
        let c1: u8 = ld8(s.p, i + 1)
        let c2: u8 = ld8(s.p, i + 2)
        let c3: u8 = ld8(s.p, i + 3)
        if !is_cont_byte(c1) || !is_cont_byte(c2) || !is_cont_byte(c3) {
            return utf8_bad_char()
        }
        let cp: u32 = ((c0 as u32 & 0x07) << 18) | ((c1 as u32 & 0x3F) << 12) |
            ((c2 as u32 & 0x3F) << 6) | (c3 as u32 & 0x3F)
        if cp < 0x10000 || cp > 0x10FFFF {
            return utf8_bad_char()
        }
        return CharHit{ cp: cp, length: 4, valid: true }
    }
    return utf8_bad_char()
}

// Index des naechsten Zeichenanfangs. Am Ende: s.n.
fn utf8_next(s: Span, i: usize) -> usize {
    if i >= s.n {
        return s.n
    }
    let z: CharHit = utf8_read(s, i)
    var l: usize = z.length
    if l == 0 {
        l = 1
    }
    if i + l > s.n {
        return s.n
    }
    return i + l
}

// Index des vorigen Zeichenanfangs. Bei 0 bleibt es 0.
fn utf8_before(s: Span, i: usize) -> usize {
    if i == 0 {
        return 0
    }
    var j: usize = i
    if j > s.n {
        j = s.n
    }
    var k: usize = 0
    while k < 4 {
        if j == 0 {
            return 0
        }
        j = j - 1
        if !is_cont_byte(ld8(s.p, j)) {
            return j
        }
        k = k + 1
    }
    return j
}

fn utf8_is_limit(s: Span, i: usize) -> bool {
    if i == 0 || i >= s.n {
        return true
    }
    return !is_cont_byte(ld8(s.p, i))
}

// Zahl der Zeichen (nicht der Oktette). Ungueltige Oktette zaehlen als eins.
fn utf8_count(s: Span) -> usize {
    var i: usize = 0
    var n: usize = 0
    while i < s.n {
        i = utf8_next(s, i)
        n = n + 1
    }
    return n
}

// Teilstueck NACH ZEICHEN statt nach Oktetten — der Schnitt liegt damit nie
// mitten in einem Zeichen.
fn utf8_part(s: Span, of_char: usize, count: usize) -> Span {
    var i: usize = 0
    var z: usize = 0
    while z < of_char && i < s.n {
        i = utf8_next(s, i)
        z = z + 1
    }
    let start: usize = i
    var g: usize = 0
    while g < count && i < s.n {
        i = utf8_next(s, i)
        g = g + 1
    }
    return span_part(s, start, i - start)
}

// Codepunkt an ein `Bytes` anhaengen (Huelle ueber utf8_push_cp, damit die
// Fassade eine vollstaendige Runde kann: lesen und schreiben).
fn utf8_append(out: *mut Bytes, cp: u32) {
    utf8_push_cp(out, cp)
}

// lib/str/std_impl.fi — die METHODEN der Textfassade (Runde 45).
//
// NUR fuer `lib/std/str.fi`: diese Datei wird ausschliesslich von
// `tools/strlib/src/std_str.fi` eingebunden. Die Einbindungs-Bibliothek
// lib/str selbst (alloc/bytes/str16/utf8/atom) bleibt unveraendert — wer sie
// ohne std benutzt, bekommt kein Byte mehr Code als vorher.
//
// WAS HIER STEHT UND WAS NICHT: ausschliesslich HUELLEN. Jede Methode ruft
// genau die freie Funktion auf, die es schon gibt, und tut sonst nichts.
// Damit ist die Umstellung auf Methoden nachweislich verhaltensgleich — es
// gibt keine zweite Umsetzung, die auseinanderlaufen koennte:
//
//     laenge(s)                 ->   s.laenge()
//     finde(s, teil)            ->   s.finde(teil)
//     bytes_push(&b, 65 as u8)  ->   b.dazu(65 as u8)
//
// DIE FREIEN FUNKTIONEN BLEIBEN. Sie stehen weiter unter ihrem Namen und
// werden von der ganzen Bibliothek weiter benutzt; `impl` legt sie NICHT
// still. Beide Schreibweisen zeigen auf denselben Code — die Methode
// `Spanne.laenge` heisst intern `Spanne__laenge`, die freie Funktion
// weiterhin `laenge`. Genau deshalb kann keine die andere verdecken
// (compiler/src/impls.rs, Abschnitt „Namensaufloesung").
//
// EMPFAENGER (compiler/src/impls.rs):
//   `Spanne` ist eine SICHT (Zeiger + Laenge) und wird als Wert
//   weitergereicht — ihre Methoden nehmen `self`.
//   `Bytes` und `Str16` BESITZEN Speicher; ihre Methoden nehmen `*self`
//   (lesend) bzw. `*mut self` (schreibend), genau wie die freien Funktionen
//   dahinter.

// ------------------------------------------------------------------ Spanne
//
// Die lesende Sicht. Alles hier ist eine Frage ueber Text, keine Aenderung
// an ihm; nichts alloziert.
impl Span {
    fn length(self) -> usize { return length(self) }
    fn is_empty(self) -> bool { return is_empty(self) }
    fn chars(self, i: usize) -> u8 { return chars(self, i) }
    fn part(self, of: usize, how_much: usize) -> Span {
        return span_part(self, of, how_much)
    }
    fn ab(self, of: usize) -> Span { return span_ab(self, of) }
    fn to(self, to: usize) -> Span { return span_to(self, to) }
    fn equal(self, b: Span) -> bool { return equal(self, b) }
    fn compare(self, b: Span) -> i32 { return compare(self, b) }
    fn equal_without_case(self, b: Span) -> bool {
        return equal_without_case(self, b)
    }
    fn starts_with(self, part: Span) -> bool { return starts_with(self, part) }
    fn ends_with(self, part: Span) -> bool { return ends_with(self, part) }
    fn find(self, part: Span) -> usize { return find(self, part) }
    fn find_back(self, part: Span) -> usize { return find_back(self, part) }
    fn find_char(self, c: u8) -> usize { return find_char(self, c) }
    fn contains(self, part: Span) -> bool { return contains(self, part) }
    fn count_char(self, c: u8) -> usize { return count_char(self, c) }
    fn count_part(self, part: Span) -> usize { return count_part(self, part) }
    fn trim(self) -> Span { return trim(self) }
    fn trim_left(self) -> Span { return trim_left(self) }
    fn trim_right(self) -> Span { return trim_right(self) }
    fn without_prefix(self, part: Span) -> Span { return without_prefix(self, part) }
    fn without_suffix(self, part: Span) -> Span { return without_suffix(self, part) }
    fn utf8_char(self) -> usize { return utf8_count(self) }
    fn utf8_part(self, of_char: usize, count: usize) -> Span {
        return utf8_part(self, of_char, count)
    }
}

// ------------------------------------------------------------------- Bytes
//
// Der besitzende Oktettpuffer. Lesende Methoden nehmen `*self`, schreibende
// `*mut self` — dieselbe Unterscheidung, die die freien Funktionen dahinter
// in ihren Parametertypen treffen.
impl Bytes {
    fn length(*self) -> usize { return bytes_len(self) }
    fn at(*self, i: usize) -> u8 { return bytes_at(self, i) }
    fn is_text(*self) -> bool { return bytes_is_str(self) }
    fn equal(*self, b: *mut Bytes) -> bool { return bytes_eq(self, b) }
    fn span(*self) -> Span { return span_of_bytes(self) }
    fn write(*self, fd: i64) { bytes_write(fd, self) }
    fn add(*mut self, v: u8) { bytes_push(self, v) }
    fn clear(*mut self) { bytes_clear(self) }
    fn free(*mut self) { bytes_free(self) }
    fn append(*mut self, s: Span) { append(self, s) }
    fn set(*mut self, s: Span) { set(self, s) }
    fn repeat(*mut self, s: Span, times: usize) { repeat(self, s, times) }
    fn big_here(*mut self) { big_here(self) }
    fn small_here(*mut self) { small_here(self) }
}

// ------------------------------------------------------------------ Str16
//
// WTF-16: prueft nichts, normalisiert nichts (SPEC §8.2).
impl Str16 {
    fn length(*self) -> usize { return str16_len(self) }
    fn at(*self, i: usize) -> u16 { return str16_at(self, i) }
    fn equal(*self, b: *mut Str16) -> bool { return str16_eq(self, b) }
    fn add(*mut self, u: u16) { str16_push(self, u) }
    fn add_cp(*mut self, cp: u32) { str16_push_cp(self, cp) }
    fn set_at(*mut self, i: usize, u: u16) { str16_set(self, i, u) }
    fn clear(*mut self) { str16_clear(self) }
    fn free(*mut self) { str16_free(self) }
}

