fn page_round(n: usize) -> usize {
    return (n + 4095) / 4096 * 4096
}

fn mem_copy(dst: *mut u8, src: *mut u8, n: usize) {
    var i: usize = 0
    while i < n {
        *((dst as usize + i) as *mut u8) = *((src as usize + i) as *mut u8)
        i = i + 1
    }
}

fn mem_zero(dst: *mut u8, n: usize) {
    var i: usize = 0
    while i < n {
        *((dst as usize + i) as *mut u8) = 0 as u8
        i = i + 1
    }
}

fn mem_eq(a: *mut u8, b: *mut u8, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        if *((a as usize + i) as *mut u8) != *((b as usize + i) as *mut u8) {
            return false
        }
        i = i + 1
    }
    return true
}

// Raw read/write helpers for the 16/32/64 bit elements of a block.
fn ld16(p: *mut u8, i: usize) -> u16 {
    return *((p as usize + i * 2) as *mut u16)
}
fn st16(p: *mut u8, i: usize, v: u16) {
    *((p as usize + i * 2) as *mut u16) = v
}
fn ld32(p: *mut u8, i: usize) -> u32 {
    return *((p as usize + i * 4) as *mut u32)
}
fn st32(p: *mut u8, i: usize, v: u32) {
    *((p as usize + i * 4) as *mut u32) = v
}
fn ld64(p: *mut u8, i: usize) -> u64 {
    return *((p as usize + i * 8) as *mut u64)
}
fn st64(p: *mut u8, i: usize, v: u64) {
    *((p as usize + i * 8) as *mut u64) = v
}
fn ld8(p: *mut u8, i: usize) -> u8 {
    return *((p as usize + i) as *mut u8)
}
fn st8(p: *mut u8, i: usize, v: u8) {
    *((p as usize + i) as *mut u8) = v
}

const SYS_WRITE: i64 = 1
const SYS_READ: i64 = 0
const SYS_MMAP: i64 = 9
const SYS_MUNMAP: i64 = 11
const SYS_EXIT: i64 = 60
const PROT_READ_WRITE: i64 = 3
const MAP_PRIVATE_ANON: i64 = 34

// Returns n contiguous bytes (zero initialized) or 0 on failure.
fn heap_alloc(n: usize) -> *mut u8 {
    if n == 0 {
        return 0 as *mut u8
    }
    let len: usize = page_round(n)
    let r: i64 = syscall(SYS_MMAP, 0, len as i64, PROT_READ_WRITE, MAP_PRIVATE_ANON, -1, 0)
    // mmap reports failure as -1..-4095
    if r < 0 && r > -4096 {
        return 0 as *mut u8
    }
    return r as *mut u8
}

fn heap_free(p: *mut u8, n: usize) {
    if p as usize != 0 {
        syscall(SYS_MUNMAP, p as i64, page_round(n) as i64)
    }
}

fn write_all(fd: i64, p: *mut u8, n: usize) {
    var off: usize = 0
    while off < n {
        let r: i64 = syscall(SYS_WRITE, fd, (p as usize + off) as i64, (n - off) as i64)
        if r <= 0 {
            return
        }
        off = off + r as usize
    }
}

// lib/str/bytes.fi -- `Bytes` (raw octets) and `Str` (validated UTF-8).
//
// The layout is a contract (SPEC 8.1, PLAN 3.3):
//     Bytes { ptr: *mut u8, len: usize, cap: usize }
//     Str   has the same layout, its content is additionally validated UTF-8.
//
// `Bytes` NEVER turns into text silently: the conversion goes exclusively
// through `bytes_to_str` (which validates) or `str_from_bytes_lossy`.
//
// Include:  //#include lib/str/bytes.fi   (needs lib/str/alloc.fi)

struct Bytes {
    ptr: *mut u8,
    len: usize,
    cap: usize,
}

fn bytes_init(b: *mut Bytes) {
    (*b).ptr = 0 as *mut u8
    (*b).len = 0
    (*b).cap = 0
}

fn bytes_free(b: *mut Bytes) {
    heap_free((*b).ptr, (*b).cap)
    bytes_init(b)
}

fn bytes_reserve(b: *mut Bytes, need: usize) {
    if (*b).cap >= need {
        return
    }
    var cap: usize = (*b).cap
    if cap == 0 {
        cap = 32
    }
    while cap < need {
        cap = cap * 2
    }
    let p: *mut u8 = heap_alloc(cap)
    if (*b).len > 0 {
        mem_copy(p, (*b).ptr, (*b).len)
    }
    heap_free((*b).ptr, (*b).cap)
    (*b).ptr = p
    (*b).cap = cap
}

fn bytes_push(b: *mut Bytes, v: u8) {
    bytes_reserve(b, (*b).len + 1)
    st8((*b).ptr, (*b).len, v)
    (*b).len = (*b).len + 1
}

fn bytes_len(b: *mut Bytes) -> usize {
    return (*b).len
}

fn bytes_at(b: *mut Bytes, i: usize) -> u8 {
    if i >= (*b).len {
        return 0 as u8
    }
    return ld8((*b).ptr, i)
}

fn bytes_clear(b: *mut Bytes) {
    (*b).len = 0
}

fn bytes_append(b: *mut Bytes, p: *mut u8, n: usize) {
    bytes_reserve(b, (*b).len + n)
    mem_copy(((*b).ptr as usize + (*b).len) as *mut u8, p, n)
    (*b).len = (*b).len + n
}

fn bytes_eq(a: *mut Bytes, b: *mut Bytes) -> bool {
    if (*a).len != (*b).len {
        return false
    }
    return mem_eq((*a).ptr, (*b).ptr, (*a).len)
}

fn bytes_write(fd: i64, b: *mut Bytes) {
    write_all(fd, (*b).ptr, (*b).len)
}

// --- UTF-8 validation (the Bytes -> Str boundary, SPEC 8.1) --------------

// Well formed UTF-8 per Unicode table 3-7: no overlong encoding,
// no surrogates (U+D800..U+DFFF), nothing above U+10FFFF.
fn utf8_is_valid(p: *mut u8, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        let b0: u32 = ld8(p, i) as u32
        var need: usize = 0
        var lo: u32 = 0
        var hi: u32 = 0
        if b0 < 0x80 {
            need = 0
        } else if b0 >= 0xC2 && b0 <= 0xDF {
            need = 1
            lo = 0x80
            hi = 0xBF
        } else if b0 == 0xE0 {
            need = 2
            lo = 0xA0
            hi = 0xBF
        } else if b0 >= 0xE1 && b0 <= 0xEC {
            need = 2
            lo = 0x80
            hi = 0xBF
        } else if b0 == 0xED {
            need = 2
            lo = 0x80
            hi = 0x9F
        } else if b0 >= 0xEE && b0 <= 0xEF {
            need = 2
            lo = 0x80
            hi = 0xBF
        } else if b0 == 0xF0 {
            need = 3
            lo = 0x90
            hi = 0xBF
        } else if b0 >= 0xF1 && b0 <= 0xF3 {
            need = 3
            lo = 0x80
            hi = 0xBF
        } else if b0 == 0xF4 {
            need = 3
            lo = 0x80
            hi = 0x8F
        } else {
            return false
        }
        if need > 0 && i + need >= n {
            return false
        }
        var k: usize = 1
        while k <= need {
            let c: u32 = ld8(p, i + k) as u32
            if k == 1 {
                if c < lo || c > hi {
                    return false
                }
            } else {
                if c < 0x80 || c > 0xBF {
                    return false
                }
            }
            k = k + 1
        }
        i = i + need + 1
    }
    return true
}

// Bytes -> Str: succeeds only for well formed UTF-8 (validates, copies nothing).
fn bytes_is_str(b: *mut Bytes) -> bool {
    return utf8_is_valid((*b).ptr, (*b).len)
}

// lib/str/str16.fi -- `Str16`: a sequence of u16 code units (WTF-16, SPEC 8.2).
//
// Str16 validates NOTHING and normalizes NOTHING. Unpaired surrogates are
// allowed and are kept element by element -- that is deliberate: a
// JavaScript string is allowed to contain them.
//
// The layout is a contract:  Str16 { ptr: *mut u16, len: usize, cap: usize }
// (len/cap count CODE UNITS, not bytes.)
//
// API contract with the module tok (PLAN 3.3). Since stage 0 knows neither
// `inout`/`&` nor aggregates across function boundaries, the parameters are
// pointers and the constructor is called `str16_init(*mut Str16)` instead of
// `str16_new() -> Str16`. The names str16_push/str16_len/str16_at are unchanged.
//
// Include:  //#include lib/str/str16.fi   (needs alloc.fi, bytes.fi)

struct Str16 {
    ptr: *mut u16,
    len: usize,
    cap: usize,
}

fn str16_init(s: *mut Str16) {
    (*s).ptr = 0 as *mut u16
    (*s).len = 0
    (*s).cap = 0
}

fn str16_free(s: *mut Str16) {
    heap_free((*s).ptr as *mut u8, (*s).cap * 2)
    str16_init(s)
}

fn str16_reserve(s: *mut Str16, need: usize) {
    if (*s).cap >= need {
        return
    }
    var cap: usize = (*s).cap
    if cap == 0 {
        cap = 16
    }
    while cap < need {
        cap = cap * 2
    }
    let p: *mut u8 = heap_alloc(cap * 2)
    if (*s).len > 0 {
        mem_copy(p, (*s).ptr as *mut u8, (*s).len * 2)
    }
    heap_free((*s).ptr as *mut u8, (*s).cap * 2)
    (*s).ptr = p as *mut u16
    (*s).cap = cap
}

// Appends ONE code unit -- without any check (0xD800 on its own as well).
fn str16_push(s: *mut Str16, u: u16) {
    str16_reserve(s, (*s).len + 1)
    st16((*s).ptr as *mut u8, (*s).len, u)
    (*s).len = (*s).len + 1
}

fn str16_len(s: *mut Str16) -> usize {
    return (*s).len
}

fn str16_at(s: *mut Str16, i: usize) -> u16 {
    if i >= (*s).len {
        return 0 as u16
    }
    return ld16((*s).ptr as *mut u8, i)
}

fn str16_set(s: *mut Str16, i: usize, u: u16) {
    if i < (*s).len {
        st16((*s).ptr as *mut u8, i, u)
    }
}

fn str16_clear(s: *mut Str16) {
    (*s).len = 0
}

fn str16_eq(a: *mut Str16, b: *mut Str16) -> bool {
    if (*a).len != (*b).len {
        return false
    }
    return mem_eq((*a).ptr as *mut u8, (*b).ptr as *mut u8, (*a).len * 2)
}

// Append a code point: anything > 0xFFFF becomes a surrogate pair, everything
// else (including a lone surrogate!) becomes one code unit.
fn str16_push_cp(s: *mut Str16, cp: u32) {
    if cp > 0xFFFF {
        let v: u32 = cp - 0x10000
        str16_push(s, (0xD800 + (v >> 10)) as u16)
        str16_push(s, (0xDC00 + (v & 0x3FF)) as u16)
    } else {
        str16_push(s, cp as u16)
    }
}

fn is_high_surrogate(u: u32) -> bool {
    return u >= 0xD800 && u < 0xDC00
}
fn is_low_surrogate(u: u32) -> bool {
    return u >= 0xDC00 && u < 0xE000
}
fn is_surrogate(u: u32) -> bool {
    return u >= 0xD800 && u < 0xE000
}

// lib/str/str16_byval.fi -- constructors per the API contract (PLAN 3.3).
//
// `str16_new() -> Str16` and `bytes_new() -> Bytes` return an aggregate as
// their result. That has been possible only since the module `core` in
// round 2 implemented the System V classification (SPEC 14.1 item 1
// dropped). Whoever still has to do without takes `str16_init(&s)` /
// `bytes_init(&b)` from str16.fi or bytes.fi -- both ways yield the same
// empty value.
//
// Include:  //#include lib/str/str16_byval.fi  (needs bytes.fi, str16.fi)

fn str16_new() -> Str16 {
    var s: Str16 = Str16 { ptr: 0 as *mut u16, len: 0, cap: 0, }
    return s
}

fn bytes_new() -> Bytes {
    var b: Bytes = Bytes { ptr: 0 as *mut u8, len: 0, cap: 0, }
    return b
}

// lib/str/utf8.fi -- conversions between Str16 (WTF-16), Str (UTF-8) and
// WTF-8 (SPEC 8.2). Every conversion is EXPLICIT, and how it can fail
// stands in its result:
//
//   str16_to_utf8       -> bool   false = unpaired surrogate, target stays empty
//   str16_to_utf8_lossy -> replaces unpaired surrogates with U+FFFD
//   str16_to_wtf8       -> lossless (keeps unpaired surrogates)
//   wtf8_to_str16       -> the lossless way back
//   utf8_to_str16       -> always succeeds if the source is valid UTF-8
//
// Include:  //#include lib/str/utf8.fi   (needs alloc.fi, bytes.fi, str16.fi)

// ROUND 73: the constant moved to lib/str/core_cp.fi -- the reading half
// of the facade needs it too and must not drag this file (which writes
// into a Bytes) into lib/std/core.fi.
// lib/str/core_cp.fi -- the replacement character (round 73).
//
// U+FFFD, the code point that every UTF-8 reader delivers for an invalid
// octet. It stands in a file of its own for ONE reason: the reading side
// of the facade (lib/str/core_facade.fi) needs it and works without an
// allocator, while the writing side (lib/str/utf8.fi) appends to a
// `*mut Bytes` and thereby owns memory. `lib/std/core.fi` takes only the
// reading side and would otherwise be missing the constant;
// `lib/std/str.fi` takes both and must not get it twice.
//
// Include:  //#include lib/str/core_cp.fi

const REPLACEMENT_CP: u32 = 0xFFFD

fn utf8_push_cp(out: *mut Bytes, cp: u32) {
    if cp < 0x80 {
        bytes_push(out, cp as u8)
    } else if cp < 0x800 {
        bytes_push(out, (0xC0 + (cp >> 6)) as u8)
        bytes_push(out, (0x80 + (cp & 0x3F)) as u8)
    } else if cp < 0x10000 {
        bytes_push(out, (0xE0 + (cp >> 12)) as u8)
        bytes_push(out, (0x80 + ((cp >> 6) & 0x3F)) as u8)
        bytes_push(out, (0x80 + (cp & 0x3F)) as u8)
    } else {
        bytes_push(out, (0xF0 + (cp >> 18)) as u8)
        bytes_push(out, (0x80 + ((cp >> 12) & 0x3F)) as u8)
        bytes_push(out, (0x80 + ((cp >> 6) & 0x3F)) as u8)
        bytes_push(out, (0x80 + (cp & 0x3F)) as u8)
    }
}

fn combine_surrogates(hi: u32, lo: u32) -> u32 {
    return 0x10000 + ((hi - 0xD800) << 10) + (lo - 0xDC00)
}

// Str16 -> Str. Result false on an unpaired surrogate; `out` is empty then.
fn str16_to_utf8(s: *mut Str16, out: *mut Bytes) -> bool {
    bytes_clear(out)
    var i: usize = 0
    let n: usize = str16_len(s)
    while i < n {
        let u: u32 = str16_at(s, i) as u32
        if is_high_surrogate(u) {
            if i + 1 >= n {
                bytes_clear(out)
                return false
            }
            let lo: u32 = str16_at(s, i + 1) as u32
            if !is_low_surrogate(lo) {
                bytes_clear(out)
                return false
            }
            utf8_push_cp(out, combine_surrogates(u, lo))
            i = i + 2
        } else if is_low_surrogate(u) {
            bytes_clear(out)
            return false
        } else {
            utf8_push_cp(out, u)
            i = i + 1
        }
    }
    return true
}

// Str16 -> Str, replacing: every unpaired surrogate becomes U+FFFD.
fn str16_to_utf8_lossy(s: *mut Str16, out: *mut Bytes) {
    bytes_clear(out)
    var i: usize = 0
    let n: usize = str16_len(s)
    while i < n {
        let u: u32 = str16_at(s, i) as u32
        if is_high_surrogate(u) {
            var paired: bool = false
            if i + 1 < n {
                if is_low_surrogate(str16_at(s, i + 1) as u32) {
                    paired = true
                }
            }
            if paired {
                utf8_push_cp(out, combine_surrogates(u, str16_at(s, i + 1) as u32))
                i = i + 2
            } else {
                utf8_push_cp(out, REPLACEMENT_CP)
                i = i + 1
            }
        } else if is_low_surrogate(u) {
            utf8_push_cp(out, REPLACEMENT_CP)
            i = i + 1
        } else {
            utf8_push_cp(out, u)
            i = i + 1
        }
    }
}

// Str16 -> WTF-8: the lossless bridge, unpaired surrogates survive as a
// three byte sequence.
fn str16_to_wtf8(s: *mut Str16, out: *mut Bytes) {
    bytes_clear(out)
    var i: usize = 0
    let n: usize = str16_len(s)
    while i < n {
        let u: u32 = str16_at(s, i) as u32
        var step: usize = 1
        var cp: u32 = u
        if is_high_surrogate(u) && i + 1 < n {
            let lo: u32 = str16_at(s, i + 1) as u32
            if is_low_surrogate(lo) {
                cp = combine_surrogates(u, lo)
                step = 2
            }
        }
        utf8_push_cp(out, cp)
        i = i + step
    }
}

// WTF-8 -> Str16, lossless (surrogate sequences become single units again).
fn wtf8_to_str16(b: *mut Bytes, out: *mut Str16) {
    str16_clear(out)
    var i: usize = 0
    let n: usize = bytes_len(b)
    while i < n {
        let b0: u32 = bytes_at(b, i) as u32
        var cp: u32 = 0
        var len: usize = 1
        if b0 < 0x80 {
            cp = b0
            len = 1
        } else if b0 >= 0xF0 {
            cp = b0 & 0x07
            len = 4
        } else if b0 >= 0xE0 {
            cp = b0 & 0x0F
            len = 3
        } else if b0 >= 0xC0 {
            cp = b0 & 0x1F
            len = 2
        } else {
            cp = REPLACEMENT_CP
            len = 1
        }
        if len > 1 {
            if i + len > n {
                str16_push_cp(out, REPLACEMENT_CP)
                return
            }
            var k: usize = 1
            while k < len {
                cp = (cp << 6) + (bytes_at(b, i + k) as u32 & 0x3F)
                k = k + 1
            }
        }
        if is_surrogate(cp) {
            str16_push(out, cp as u16)
        } else {
            str16_push_cp(out, cp)
        }
        i = i + len
    }
}

// Str -> Str16: always succeeds (the source is validated UTF-8).
fn utf8_to_str16(b: *mut Bytes, out: *mut Str16) {
    wtf8_to_str16(b, out)
}

// lib/str/atom.fi -- `Atom` (SPEC 8.3): an interned name as a u32.
//
// Comparing two atoms is an INTEGER COMPARISON (`a == b`), not a character
// comparison. Whoever interns first gets the smallest number: the module
// tok interns its known tag names at startup in a fixed order and thereby
// gets fixed, small numbers (the prerequisite for jump tables over tag
// names).
//
// Stage 0 has no global variables; the table is therefore held by the
// caller and passed in as a pointer.
//
// Include:  //#include lib/str/atom.fi   (needs alloc.fi, bytes.fi)

struct AtomTable {
    arena: *mut u8, // all names one after another
    arena_len: usize,
    arena_cap: usize,
    ents: *mut u8, // two u64 per atom: offset, length
    count: usize,
    ents_cap: usize,
    buckets: *mut u8, // open addressing, one u32 per slot (0 = empty, otherwise id+1)
    nbuckets: usize,
}

fn atom_hash(p: *mut u8, len: usize) -> u64 {
    var h: u64 = 14695981039346656037
    var i: usize = 0
    while i < len {
        h = h ^ (ld8(p, i) as u64)
        h = h *% 1099511628211 // ROUND 72: FNV-1a wraps on purpose, *% says so
        i = i + 1
    }
    return h
}

fn atom_table_init(t: *mut AtomTable) {
    (*t).arena = heap_alloc(65536)
    (*t).arena_len = 0
    (*t).arena_cap = 65536
    (*t).ents = heap_alloc(1024 * 16)
    (*t).count = 0
    (*t).ents_cap = 1024
    (*t).nbuckets = 4096
    (*t).buckets = heap_alloc(4096 * 4)
    mem_zero((*t).buckets, 4096 * 4)
}

fn atom_free(t: *mut AtomTable) {
    heap_free((*t).arena, (*t).arena_cap)
    heap_free((*t).ents, (*t).ents_cap * 16)
    heap_free((*t).buckets, (*t).nbuckets * 4)
    (*t).count = 0
}

fn atom_off(t: *mut AtomTable, id: u32) -> usize {
    return ld64((*t).ents, (id as usize) * 2) as usize
}
fn atom_len(t: *mut AtomTable, id: u32) -> usize {
    return ld64((*t).ents, (id as usize) * 2 + 1) as usize
}
fn atom_ptr(t: *mut AtomTable, id: u32) -> *mut u8 {
    return ((*t).arena as usize + atom_off(t, id)) as *mut u8
}

fn atom_count(t: *mut AtomTable) -> usize {
    return (*t).count
}

// Copy the name of an atom into `out`.
fn atom_text(t: *mut AtomTable, id: u32, out: *mut Bytes) {
    bytes_clear(out)
    if id as usize >= (*t).count {
        return
    }
    bytes_append(out, atom_ptr(t, id), atom_len(t, id))
}

fn atom_rehash(t: *mut AtomTable) {
    let nb: usize = (*t).nbuckets * 2
    let nbuf: *mut u8 = heap_alloc(nb * 4)
    mem_zero(nbuf, nb * 4)
    heap_free((*t).buckets, (*t).nbuckets * 4)
    (*t).buckets = nbuf
    (*t).nbuckets = nb
    var id: usize = 0
    while id < (*t).count {
        let h: u64 = atom_hash(atom_ptr(t, id as u32), atom_len(t, id as u32))
        var slot: usize = (h as usize) & (nb - 1)
        while ld32(nbuf, slot) != 0 as u32 {
            slot = (slot + 1) & (nb - 1)
        }
        st32(nbuf, slot, (id + 1) as u32)
        id = id + 1
    }
}

fn atom_grow_arena(t: *mut AtomTable, need: usize) {
    if (*t).arena_len + need <= (*t).arena_cap {
        return
    }
    var cap: usize = (*t).arena_cap
    while cap < (*t).arena_len + need {
        cap = cap * 2
    }
    let p: *mut u8 = heap_alloc(cap)
    mem_copy(p, (*t).arena, (*t).arena_len)
    heap_free((*t).arena, (*t).arena_cap)
    (*t).arena = p
    (*t).arena_cap = cap
}

fn atom_grow_ents(t: *mut AtomTable) {
    if (*t).count < (*t).ents_cap {
        return
    }
    let cap: usize = (*t).ents_cap * 2
    let p: *mut u8 = heap_alloc(cap * 16)
    mem_copy(p, (*t).ents, (*t).count * 16)
    heap_free((*t).ents, (*t).ents_cap * 16)
    (*t).ents = p
    (*t).ents_cap = cap
}

// Core: interns `len` octets at `p` and returns the atom number.
fn atom_intern_raw(t: *mut AtomTable, p: *mut u8, len: usize) -> u32 {
    if (*t).count * 2 >= (*t).nbuckets {
        atom_rehash(t)
    }
    let h: u64 = atom_hash(p, len)
    let mask: usize = (*t).nbuckets - 1
    var slot: usize = (h as usize) & mask
    while true {
        let e: u32 = ld32((*t).buckets, slot)
        if e == 0 as u32 {
            atom_grow_arena(t, len)
            atom_grow_ents(t)
            let id: usize = (*t).count
            let off: usize = (*t).arena_len
            mem_copy(((*t).arena as usize + off) as *mut u8, p, len)
            (*t).arena_len = off + len
            st64((*t).ents, id * 2, off as u64)
            st64((*t).ents, id * 2 + 1, len as u64)
            (*t).count = id + 1
            st32((*t).buckets, slot, (id + 1) as u32)
            return id as u32
        }
        let id: u32 = e - 1 as u32
        if atom_len(t, id) == len {
            if mem_eq(atom_ptr(t, id), p, len) {
                return id
            }
        }
        slot = (slot + 1) & mask
    }
    return 0 as u32
}

// API contract with the module tok: `atom_intern` over `Bytes`.
fn atom_intern(t: *mut AtomTable, b: *mut Bytes) -> u32 {
    return atom_intern_raw(t, (*b).ptr, (*b).len)
}

// Comparing two atoms -- an integer comparison, nothing more.
fn atom_eq(a: u32, b: u32) -> bool {
    return a == b
}

// lib/str/std_facade.fi -- the text work of the std facade (round 42).
//
// ONLY for `lib/std/str.fi`: this file is included exclusively by
// `tools/strlib/src/std_str.fi`, not by the generated tests 300-308.
// The include library lib/str itself (alloc/bytes/str16/utf8/atom) thus
// stays unchanged -- whoever uses it without std gets not one byte more
// code than before.
//
// WHAT IS HERE: everything C# keeps under `string` and `char`, as far as it
// works without changing the language -- comparing, searching, trimming,
// splitting, joining, replacing, ASCII upper/lower case, padding and a
// UTF-8 SAFE iteration.
//
// TWO TYPES, ONE RULE:
//   * `Span` (pointer + length) is the READING view. It owns nothing,
//     allocates nothing and is passed around by value -- like
//     `ReadOnlySpan<byte>`. Every question about text takes a `Span`.
//   * `Bytes` (from lib/str/bytes.fi) is the OWNING buffer. Every
//     function that PRODUCES text writes into a `*mut Bytes`.
// So every signature tells you who holds memory, and there is no hidden
// allocation.
//
// THE HONEST LIMITS, collected:
//   * Upper/lower case is ASCII (A-Z / a-z). Unicode case mapping needs the
//     UCD tables; those live in the comptime branch (tests/602_comptime_ucd.fi)
//     and do not belong in the core facade.
//   * The producing functions (`replace`, `after_big`, ...) require that
//     `out` does NOT lie inside the memory of the source. They clear `out`
//     first; an overlap would mean reading from a buffer that has just been
//     overwritten. Whoever wants to work in place takes the `_here` forms.
//   * `npos()` (all bits set) means "not found" -- Firn has no option
//     values, and a sentinel is more honest than a 0 that could equally mean
//     "hit at position 0".
//   * Numbers do NOT live here but in `std.num` (text <-> integer,
//     text <-> f64). Two parsers would be two truths.

// "not found" / "no index". A function, because `const` in stage 0 is
// evaluated as an integer and 2^64-1 is not representable there.

// ROUND 73: the reading half (Span, character classes, comparing,
// searching, trimming, splitting, UTF-8 reading) moved to
// `lib/str/core_facade.fi`, because it needs neither an allocator nor a
// system call and is therefore usable in the kernel profile. It is
// included here, so that `std.str` keeps offering everything it offered
// before -- not one caller has to change.
// lib/str/core_facade.fi -- the READING half of the text facade (round 73).
//
// Cut out of `lib/str/std_facade.fi` along ONE line: everything here works
// on memory that somebody else holds. `Span` is a pointer and a length; it
// owns nothing, it allocates nothing, it makes no system call. That is why
// this file may be used under `profile kernel` -- it is included by
// `lib/std/core.fi` (the freestanding half of the library) AND by
// `lib/std/str.fi` (the full facade), so there is exactly ONE source text
// for the searching, comparing, trimming, splitting and UTF-8 reading of
// text, and no second truth.
//
// WHAT IS NOT HERE: everything that PRODUCES text. `append`, `replace`,
// `after_big`, `fill_left` and their kin write into a `*mut Bytes`, and a
// `Bytes` owns memory -- they stayed behind in `lib/str/std_facade.fi`.
//
// Include:  //#include lib/str/core_facade.fi

fn npos() -> usize {
    // ROUND 72: 0 - 1 on an UNSIGNED type is a well-known way to spell
    // "every bit set" (usize::MAX, the not-found sentinel) without writing
    // the literal -- deliberate wraparound, not a mistake, `-%` says so.
    var x: usize = 0
    return x -% 1
}

// -------------------------------------------------------------------- Span

struct Span {
    p: *mut u8,
    n: usize,
}

fn span(p: *mut u8, n: usize) -> Span {
    return Span { p: p, n: n }
}

fn span_empty() -> Span {
    return Span { p: 0 as *mut u8, n: 0 }
}

// Length of a null terminated sequence.
fn c_length(p: *mut u8) -> usize {
    if (p as usize) == 0 {
        return 0
    }
    var n: usize = 0
    while ld8(p, n) != 0 as u8 {
        n = n + 1
    }
    return n
}

// A view of a null terminated sequence (without the null octet).
fn span_of_c(p: *mut u8) -> Span {
    return Span { p: p, n: c_length(p) }
}

fn is_empty(s: Span) -> bool {
    return s.n == 0
}

fn length(s: Span) -> usize {
    return s.n
}

// The octet at position `i`; past the end 0 -- just like `bytes_at`.
fn chars(s: Span, i: usize) -> u8 {
    if i >= s.n {
        return 0 as u8
    }
    return ld8(s.p, i)
}

// The piece starting at `of`, at most `how_much` octets. Both bounds are
// CLAMPED instead of reported: a view can never become invalid.
fn span_part(s: Span, of: usize, how_much: usize) -> Span {
    if of >= s.n {
        return Span { p: s.p, n: 0 }
    }
    var rest: usize = s.n - of
    if how_much < rest {
        rest = how_much
    }
    return Span { p: (s.p as usize + of) as *mut u8, n: rest }
}

fn span_ab(s: Span, of: usize) -> Span {
    return span_part(s, of, s.n)
}

fn span_to(s: Span, to: usize) -> Span {
    return span_part(s, 0, to)
}

// ------------------------------------------------------- Character classes
//
// ASCII. `is_whitespace` follows the same set the Firn lexer treats as
// separating: space, tab, line feed, carriage return, vertical tab,
// form feed.

fn is_whitespace(c: u8) -> bool {
    return c == 32 as u8 || c == 9 as u8 || c == 10 as u8 || c == 13 as u8 ||
    c == 11 as u8 || c == 12 as u8
}

fn is_digit(c: u8) -> bool {
    return c >= 48 as u8 && c <= 57 as u8
}

fn is_hex_digit(c: u8) -> bool {
    return is_digit(c) || (c >= 97 as u8 && c <= 102 as u8) ||
    (c >= 65 as u8 && c <= 70 as u8)
}

fn is_upper_letter(c: u8) -> bool {
    return c >= 65 as u8 && c <= 90 as u8
}

fn is_lower_letter(c: u8) -> bool {
    return c >= 97 as u8 && c <= 122 as u8
}

fn is_letter(c: u8) -> bool {
    return is_upper_letter(c) || is_lower_letter(c)
}

fn is_alphanumeric(c: u8) -> bool {
    return is_letter(c) || is_digit(c)
}

// The value of a hex digit, otherwise -1.
fn hex_value(c: u8) -> i32 {
    if is_digit(c) {
        return (c - 48 as u8) as i32
    }
    if c >= 97 as u8 && c <= 102 as u8 {
        return (c - 87 as u8) as i32
    }
    if c >= 65 as u8 && c <= 70 as u8 {
        return (c - 55 as u8) as i32
    }
    return 0 - 1
}

fn big_char(c: u8) -> u8 {
    if is_lower_letter(c) {
        return c - 32 as u8
    }
    return c
}

fn small_char(c: u8) -> u8 {
    if is_upper_letter(c) {
        return c + 32 as u8
    }
    return c
}

// -------------------------------------------------------------- Comparison

fn equal(a: Span, b: Span) -> bool {
    if a.n != b.n {
        return false
    }
    return mem_eq(a.p, b.p, a.n)
}

// Lexicographic over the octets; on a common prefix the length decides.
// -1 = a before b, 0 = equal, 1 = a after b.
fn compare(a: Span, b: Span) -> i32 {
    var m: usize = a.n
    if b.n < m {
        m = b.n
    }
    var i: usize = 0
    while i < m {
        let x: u8 = ld8(a.p, i)
        let y: u8 = ld8(b.p, i)
        if x < y {
            return 0 - 1
        }
        if x > y {
            return 1
        }
        i = i + 1
    }
    if a.n < b.n {
        return 0 - 1
    }
    if a.n > b.n {
        return 1
    }
    return 0
}

fn equal_without_case(a: Span, b: Span) -> bool {
    if a.n != b.n {
        return false
    }
    var i: usize = 0
    while i < a.n {
        if small_char(ld8(a.p, i)) != small_char(ld8(b.p, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

fn compare_without_case(a: Span, b: Span) -> i32 {
    var m: usize = a.n
    if b.n < m {
        m = b.n
    }
    var i: usize = 0
    while i < m {
        let x: u8 = small_char(ld8(a.p, i))
        let y: u8 = small_char(ld8(b.p, i))
        if x < y {
            return 0 - 1
        }
        if x > y {
            return 1
        }
        i = i + 1
    }
    if a.n < b.n {
        return 0 - 1
    }
    if a.n > b.n {
        return 1
    }
    return 0
}

fn starts_with(s: Span, part: Span) -> bool {
    if part.n > s.n {
        return false
    }
    return mem_eq(s.p, part.p, part.n)
}

fn ends_with(s: Span, part: Span) -> bool {
    if part.n > s.n {
        return false
    }
    return mem_eq((s.p as usize + (s.n - part.n)) as *mut u8, part.p, part.n)
}

// --------------------------------------------------------------- Searching

fn find_char_ab(s: Span, c: u8, ab: usize) -> usize {
    var i: usize = ab
    while i < s.n {
        if ld8(s.p, i) == c {
            return i
        }
        i = i + 1
    }
    return npos()
}

fn find_char(s: Span, c: u8) -> usize {
    return find_char_ab(s, c, 0)
}

fn find_char_back(s: Span, c: u8) -> usize {
    var i: usize = s.n
    while i > 0 {
        i = i - 1
        if ld8(s.p, i) == c {
            return i
        }
    }
    return npos()
}

// An EMPTY needle is found at `ab` -- the same rule as in C# and Rust; it
// turns `replace` with an empty `old` into a no-op instead of an endless
// loop.
fn find_ab(s: Span, part: Span, ab: usize) -> usize {
    if part.n == 0 {
        if ab > s.n {
            return npos()
        }
        return ab
    }
    if part.n > s.n {
        return npos()
    }
    let last: usize = s.n - part.n
    var i: usize = ab
    while i <= last {
        if mem_eq((s.p as usize + i) as *mut u8, part.p, part.n) {
            return i
        }
        i = i + 1
    }
    return npos()
}

fn find(s: Span, part: Span) -> usize {
    return find_ab(s, part, 0)
}

fn find_back(s: Span, part: Span) -> usize {
    if part.n == 0 {
        return s.n
    }
    if part.n > s.n {
        return npos()
    }
    var i: usize = s.n - part.n + 1
    while i > 0 {
        i = i - 1
        if mem_eq((s.p as usize + i) as *mut u8, part.p, part.n) {
            return i
        }
    }
    return npos()
}

fn contains(s: Span, part: Span) -> bool {
    return find(s, part) != npos()
}

fn contains_char(s: Span, c: u8) -> bool {
    return find_char(s, c) != npos()
}

fn count_char(s: Span, c: u8) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < s.n {
        if ld8(s.p, i) == c {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// Non overlapping occurrences. An empty needle: 0 (otherwise the answer
// would be "infinite" or arbitrary).
fn count_part(s: Span, part: Span) -> usize {
    if part.n == 0 || part.n > s.n {
        return 0
    }
    var n: usize = 0
    var i: usize = 0
    while true {
        let f: usize = find_ab(s, part, i)
        if f == npos() {
            return n
        }
        n = n + 1
        i = f + part.n
        if i > s.n {
            return n
        }
    }
    return n
}

// The first octet that is NOT in `set` -- the basis of every trim with a
// character set of your own.
fn find_not_out(s: Span, set: Span, ab: usize) -> usize {
    var i: usize = ab
    while i < s.n {
        if !contains_char(set, ld8(s.p, i)) {
            return i
        }
        i = i + 1
    }
    return npos()
}

// ---------------------------------------------------------------- Trimming

fn trim_left(s: Span) -> Span {
    var i: usize = 0
    while i < s.n && is_whitespace(ld8(s.p, i)) {
        i = i + 1
    }
    return span_ab(s, i)
}

fn trim_right(s: Span) -> Span {
    var e: usize = s.n
    while e > 0 && is_whitespace(ld8(s.p, e - 1)) {
        e = e - 1
    }
    return span_to(s, e)
}

fn trim(s: Span) -> Span {
    return trim_right(trim_left(s))
}

// Trims every octet that is in `set`.
fn trim_set(s: Span, set: Span) -> Span {
    var a: usize = 0
    while a < s.n && contains_char(set, ld8(s.p, a)) {
        a = a + 1
    }
    var e: usize = s.n
    while e > a && contains_char(set, ld8(s.p, e - 1)) {
        e = e - 1
    }
    return span_part(s, a, e - a)
}

// Cut off a prefix/suffix if it is there -- otherwise unchanged.
fn without_prefix(s: Span, part: Span) -> Span {
    if starts_with(s, part) {
        return span_ab(s, part.n)
    }
    return s
}

fn without_suffix(s: Span, part: Span) -> Span {
    if ends_with(s, part) {
        return span_to(s, s.n - part.n)
    }
    return s
}

// --------------------------------------------------------------- Splitting
//
// A CURSOR, not a list: in this module Firn has no `Vec` (lib/str is an
// include library without module structure), and a cursor is the form that
// allocates nothing anyway.
//
//     var t: str.Divisor = str.divisor_new(source, sep)
//     var part: str.Span = str.span_empty()
//     while str.divisor_next(&t, &part) { ... }
//
// Rules (like C# String.Split without RemoveEmptyEntries):
//   * "a,b,,c" with "," yields "a", "b", "", "c"
//   * "" yields exactly ONE empty piece
//   * an empty separator yields exactly ONE piece: the whole source
//   * `divisor_whitespace` collapses runs of whitespace and NEVER yields an
//     empty piece -- that is the form you want when taking a command line
//     apart.

const DIVISOR_SEP: u32 = 0
const DIVISOR_WHITESPACE: u32 = 1

struct Divisor {
    source: Span,
    sep: Span,
    i: usize,
    mode: u32,
    done: bool,
}

fn divisor_new(s: Span, sep: Span) -> Divisor {
    return Divisor { source: s, sep: sep, i: 0,
        mode: DIVISOR_SEP, done: false }
}

fn divisor_whitespace(s: Span) -> Divisor {
    return Divisor { source: s, sep: span_empty(), i: 0,
        mode: DIVISOR_WHITESPACE, done: false }
}

fn divisor_next(t: *mut Divisor, out: *mut Span) -> bool {
    if (*t).done {
        return false
    }
    var s: Span = (*t).source
    if (*t).mode == DIVISOR_WHITESPACE {
        var i: usize = (*t).i
        while i < s.n && is_whitespace(ld8(s.p, i)) {
            i = i + 1
        }
        if i >= s.n {
            (*t).i = s.n
            (*t).done = true
            return false
        }
        let start: usize = i
        while i < s.n && !is_whitespace(ld8(s.p, i)) {
            i = i + 1
        }
        (*t).i = i
        (*out).p = (s.p as usize + start) as *mut u8
        (*out).n = i - start
        return true
    }
    var tr: Span = (*t).sep
    let start: usize = (*t).i
    if tr.n == 0 {
        (*t).done = true
        (*out).p = s.p
        (*out).n = s.n
        return true
    }
    let f: usize = find_ab(s, tr, start)
    if f == npos() {
        (*t).done = true
        var rest: Span = span_ab(s, start)
        (*out).p = rest.p
        (*out).n = rest.n
        return true
    }
    (*out).p = (s.p as usize + start) as *mut u8
    (*out).n = f - start
    (*t).i = f + tr.n
    return true
}

// How many pieces `divisor_new` is going to yield -- for the caller who
// wants to make room beforehand.
fn parts_count(s: Span, sep: Span) -> usize {
    if sep.n == 0 {
        return 1
    }
    return count_part(s, sep) + 1
}

// --------------------------------------------------------- UTF-8 iteration
//
// `utf8_is_valid` (lib/str/utf8.fi) says WHETHER a sequence is valid. Here
// stands how to WALK over it without reaching into the middle of a character.
//
// `utf8_read` checks the same rules as `utf8_is_valid`: overlong encodings,
// surrogates (U+D800..U+DFFF) and everything above U+10FFFF are INVALID.
// An invalid octet is reported as ONE character with `valid = false`
// (cp = U+FFFD), so that every loop is guaranteed to make progress.

struct CharHit {
    cp: u32,
    length: usize,
    valid: bool,
}

fn is_cont_byte(c: u8) -> bool {
    return (c & 0xC0 as u8) == 0x80 as u8
}

fn utf8_bad_char() -> CharHit {
    return CharHit { cp: REPLACEMENT_CP, length: 1, valid: false }
}

fn utf8_read(s: Span, i: usize) -> CharHit {
    if i >= s.n {
        return CharHit { cp: 0, length: 0, valid: false }
    }
    let c0: u8 = ld8(s.p, i)
    if c0 < 0x80 as u8 {
        return CharHit { cp: c0 as u32, length: 1, valid: true }
    }
    if c0 < 0xC2 as u8 {
        // 0x80..0xBF are continuation octets, 0xC0/0xC1 would be overlong.
        return utf8_bad_char()
    }
    if c0 < 0xE0 as u8 {
        if i + 1 >= s.n {
            return utf8_bad_char()
        }
        let c1: u8 = ld8(s.p, i + 1)
        if !is_cont_byte(c1) {
            return utf8_bad_char()
        }
        let cp: u32 = ((c0 as u32 & 0x1F) << 6) | (c1 as u32 & 0x3F)
        return CharHit { cp: cp, length: 2, valid: true }
    }
    if c0 < 0xF0 as u8 {
        if i + 2 >= s.n {
            return utf8_bad_char()
        }
        let c1: u8 = ld8(s.p, i + 1)
        let c2: u8 = ld8(s.p, i + 2)
        if !is_cont_byte(c1) || !is_cont_byte(c2) {
            return utf8_bad_char()
        }
        let cp: u32 = ((c0 as u32 & 0x0F) << 12) | ((c1 as u32 & 0x3F) << 6) |
        (c2 as u32 & 0x3F)
        if cp < 0x800 {
            return utf8_bad_char()
        }
        if cp >= 0xD800 && cp <= 0xDFFF {
            return utf8_bad_char()
        }
        return CharHit { cp: cp, length: 3, valid: true }
    }
    if c0 < 0xF5 as u8 {
        if i + 3 >= s.n {
            return utf8_bad_char()
        }
        let c1: u8 = ld8(s.p, i + 1)
        let c2: u8 = ld8(s.p, i + 2)
        let c3: u8 = ld8(s.p, i + 3)
        if !is_cont_byte(c1) || !is_cont_byte(c2) || !is_cont_byte(c3) {
            return utf8_bad_char()
        }
        let cp: u32 = ((c0 as u32 & 0x07) << 18) | ((c1 as u32 & 0x3F) << 12) |
        ((c2 as u32 & 0x3F) << 6) | (c3 as u32 & 0x3F)
        if cp < 0x10000 || cp > 0x10FFFF {
            return utf8_bad_char()
        }
        return CharHit { cp: cp, length: 4, valid: true }
    }
    return utf8_bad_char()
}

// The index of the next character start. At the end: s.n.
fn utf8_next(s: Span, i: usize) -> usize {
    if i >= s.n {
        return s.n
    }
    let z: CharHit = utf8_read(s, i)
    var l: usize = z.length
    if l == 0 {
        l = 1
    }
    if i + l > s.n {
        return s.n
    }
    return i + l
}

// The index of the previous character start. At 0 it stays 0.
fn utf8_before(s: Span, i: usize) -> usize {
    if i == 0 {
        return 0
    }
    var j: usize = i
    if j > s.n {
        j = s.n
    }
    var k: usize = 0
    while k < 4 {
        if j == 0 {
            return 0
        }
        j = j - 1
        if !is_cont_byte(ld8(s.p, j)) {
            return j
        }
        k = k + 1
    }
    return j
}

fn utf8_is_limit(s: Span, i: usize) -> bool {
    if i == 0 || i >= s.n {
        return true
    }
    return !is_cont_byte(ld8(s.p, i))
}

// The number of characters (not octets). An invalid octet counts as one.
fn utf8_count(s: Span) -> usize {
    var i: usize = 0
    var n: usize = 0
    while i < s.n {
        i = utf8_next(s, i)
        n = n + 1
    }
    return n
}

// A piece BY CHARACTER instead of by octet -- the cut therefore never lands
// in the middle of a character.
fn utf8_part(s: Span, of_char: usize, count: usize) -> Span {
    var i: usize = 0
    var z: usize = 0
    while z < of_char && i < s.n {
        i = utf8_next(s, i)
        z = z + 1
    }
    let start: usize = i
    var g: usize = 0
    while g < count && i < s.n {
        i = utf8_next(s, i)
        g = g + 1
    }
    return span_part(s, start, i - start)
}

// A view of the contents of a buffer. Valid only as long as the buffer does
// not grow -- `bytes_push` may move it.
fn span_of_bytes(b: *mut Bytes) -> Span {
    return Span { p: (*b).ptr, n: (*b).len }
}

// ----------------------------------------------------------- Building text
//
// Everything here appends to a `*mut Bytes` or replaces its contents.
// `_here` means: in place, without a second buffer.

fn append(out: *mut Bytes, s: Span) {
    bytes_append(out, s.p, s.n)
}

fn append_char(out: *mut Bytes, c: u8) {
    bytes_push(out, c)
}

fn set(out: *mut Bytes, s: Span) {
    bytes_clear(out)
    bytes_append(out, s.p, s.n)
}

fn repeat(out: *mut Bytes, s: Span, times: usize) {
    var i: usize = 0
    while i < times {
        bytes_append(out, s.p, s.n)
        i = i + 1
    }
}

// Joining: append `part`, and the separator before it -- but only if there
// is already something there. That makes the whole loop the caller's:
//
//     while str.divisor_next(&t, &p) { str.join_part(&out, p, sep) }
fn join_part(out: *mut Bytes, part: Span, sep: Span) {
    if bytes_len(out) > 0 {
        bytes_append(out, sep.p, sep.n)
    }
    bytes_append(out, part.p, part.n)
}

// Right align to `width` (pad on the left). If the text is already longer
// it is NOT truncated.
fn fill_left(out: *mut Bytes, s: Span, width: usize, filler: u8) {
    var i: usize = s.n
    while i < width {
        bytes_push(out, filler)
        i = i + 1
    }
    bytes_append(out, s.p, s.n)
}

fn fill_right(out: *mut Bytes, s: Span, width: usize, filler: u8) {
    bytes_append(out, s.p, s.n)
    var i: usize = s.n
    while i < width {
        bytes_push(out, filler)
        i = i + 1
    }
}

// ---------------------------------------------------- Upper and lower case

fn after_big(out: *mut Bytes, s: Span) {
    bytes_clear(out)
    var i: usize = 0
    while i < s.n {
        bytes_push(out, big_char(ld8(s.p, i)))
        i = i + 1
    }
}

fn after_small(out: *mut Bytes, s: Span) {
    bytes_clear(out)
    var i: usize = 0
    while i < s.n {
        bytes_push(out, small_char(ld8(s.p, i)))
        i = i + 1
    }
}

fn big_here(b: *mut Bytes) {
    var i: usize = 0
    while i < (*b).len {
        st8((*b).ptr, i, big_char(ld8((*b).ptr, i)))
        i = i + 1
    }
}

fn small_here(b: *mut Bytes) {
    var i: usize = 0
    while i < (*b).len {
        st8((*b).ptr, i, small_char(ld8((*b).ptr, i)))
        i = i + 1
    }
}

// --------------------------------------------------------------- Replacing

// Every non overlapping occurrence. Return value: how often it replaced.
// `out` is cleared and must lie outside `s`, `old` and `new`.
fn replace(out: *mut Bytes, s: Span, old: Span, new: Span) -> usize {
    bytes_clear(out)
    if old.n == 0 || old.n > s.n {
        bytes_append(out, s.p, s.n)
        return 0
    }
    var n: usize = 0
    var i: usize = 0
    while i < s.n {
        let f: usize = find_ab(s, old, i)
        if f == npos() {
            bytes_append(out, (s.p as usize + i) as *mut u8, s.n - i)
            return n
        }
        bytes_append(out, (s.p as usize + i) as *mut u8, f - i)
        bytes_append(out, new.p, new.n)
        n = n + 1
        i = f + old.n
    }
    return n
}

fn replace_first(out: *mut Bytes, s: Span, old: Span, new: Span) -> bool {
    bytes_clear(out)
    if old.n == 0 {
        bytes_append(out, s.p, s.n)
        return false
    }
    let f: usize = find(s, old)
    if f == npos() {
        bytes_append(out, s.p, s.n)
        return false
    }
    bytes_append(out, s.p, f)
    bytes_append(out, new.p, new.n)
    let ab: usize = f + old.n
    bytes_append(out, (s.p as usize + ab) as *mut u8, s.n - ab)
    return true
}

// Octet by octet, in place -- the length does not change.
fn replace_char_here(b: *mut Bytes, old: u8, new: u8) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < (*b).len {
        if ld8((*b).ptr, i) == old {
            st8((*b).ptr, i, new)
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// Append a code point to a `Bytes` (a wrapper around utf8_push_cp, so that
// the facade can do a full round trip: reading and writing).
fn utf8_append(out: *mut Bytes, cp: u32) {
    utf8_push_cp(out, cp)
}

// lib/str/std_impl.fi -- the METHODS of the text facade (round 45).
//
// ONLY for `lib/std/str.fi`: this file is included exclusively by
// `tools/strlib/src/std_str.fi`. The include library lib/str itself
// (alloc/bytes/str16/utf8/atom) stays unchanged -- whoever uses it without
// std gets not one byte more code than before.
//
// WHAT IS HERE AND WHAT IS NOT: nothing but WRAPPERS. Every method calls
// exactly the free function that already exists, and does nothing else.
// That makes the move to methods provably behavior preserving -- there is
// no second implementation that could drift apart:
//
//     length(s)                 ->   s.length()
//     find(s, part)             ->   s.find(part)
//     bytes_push(&b, 65 as u8)  ->   b.add(65 as u8)
//
// THE FREE FUNCTIONS STAY. They remain available under their own names and
// are still used throughout the library; `impl` does NOT retire them. Both
// spellings point at the same code -- the method `Span.length` is called
// `Span__length` internally, while the free function is still called
// `length`. That is exactly why neither can shadow the other
// (compiler/src/impls.rs, section "name resolution").
//
// RECEIVERS (compiler/src/impls.rs):
//   `Span` is a VIEW (pointer + length) and is passed around by value --
//   its methods take `self`.
//   `Bytes` and `Str16` OWN memory; their methods take `*self`
//   (reading) or `*mut self` (writing), exactly like the free functions
//   behind them.

// ROUND 73: the methods of `Span` moved to `lib/str/core_impl.fi` -- the
// reading view needs no allocator and is therefore usable in the kernel
// profile. Included here, so that `std.str` keeps offering all of them.
// lib/str/core_impl.fi -- the METHODS of the reading text view (round 73).
//
// Cut out of `lib/str/std_impl.fi` along the same line as the free
// functions: `Span` is a VIEW, it owns nothing and allocates nothing, so
// its methods belong to the freestanding half of the library. The file is
// included by `lib/std/core.fi` and by `lib/std/str.fi` -- one source
// text, two front doors.
//
// NOTHING BUT WRAPPERS. Every method calls exactly the free function that
// already exists and does nothing else; there is no second implementation
// that could drift apart. `Span` is passed around by value, so its methods
// take `self` (compiler/src/impls.rs).
//
// Include:  //#include lib/str/core_impl.fi

// -------------------------------------------------------------------- Span
//
// The reading view. Everything here asks a question about text, it never
// changes it; nothing allocates.
impl Span {
    fn length(self) -> usize { return length(self) }
    fn is_empty(self) -> bool { return is_empty(self) }
    fn chars(self, i: usize) -> u8 { return chars(self, i) }
    fn part(self, of: usize, how_much: usize) -> Span {
        return span_part(self, of, how_much)
    }
    fn ab(self, of: usize) -> Span { return span_ab(self, of) }
    fn to(self, to: usize) -> Span { return span_to(self, to) }
    fn equal(self, b: Span) -> bool { return equal(self, b) }
    fn compare(self, b: Span) -> i32 { return compare(self, b) }
    fn equal_without_case(self, b: Span) -> bool {
        return equal_without_case(self, b)
    }
    fn starts_with(self, part: Span) -> bool { return starts_with(self, part) }
    fn ends_with(self, part: Span) -> bool { return ends_with(self, part) }
    fn find(self, part: Span) -> usize { return find(self, part) }
    fn find_back(self, part: Span) -> usize { return find_back(self, part) }
    fn find_char(self, c: u8) -> usize { return find_char(self, c) }
    fn contains(self, part: Span) -> bool { return contains(self, part) }
    fn count_char(self, c: u8) -> usize { return count_char(self, c) }
    fn count_part(self, part: Span) -> usize { return count_part(self, part) }
    fn trim(self) -> Span { return trim(self) }
    fn trim_left(self) -> Span { return trim_left(self) }
    fn trim_right(self) -> Span { return trim_right(self) }
    fn without_prefix(self, part: Span) -> Span { return without_prefix(self, part) }
    fn without_suffix(self, part: Span) -> Span { return without_suffix(self, part) }
    fn utf8_char(self) -> usize { return utf8_count(self) }
    fn utf8_part(self, of_char: usize, count: usize) -> Span {
        return utf8_part(self, of_char, count)
    }
}

// ------------------------------------------------------------------- Bytes
//
// The owning octet buffer. Reading methods take `*self`, writing ones
// `*mut self` -- the same distinction the free functions behind them make
// in their parameter types.
impl Bytes {
    fn length(*self) -> usize { return bytes_len(self) }
    fn at(*self, i: usize) -> u8 { return bytes_at(self, i) }
    fn is_text(*self) -> bool { return bytes_is_str(self) }
    fn equal(*self, b: *mut Bytes) -> bool { return bytes_eq(self, b) }
    fn span(*self) -> Span { return span_of_bytes(self) }
    fn write(*self, fd: i64) { bytes_write(fd, self) }
    fn add(*mut self, v: u8) { bytes_push(self, v) }
    fn clear(*mut self) { bytes_clear(self) }
    fn free(*mut self) { bytes_free(self) }
    fn append(*mut self, s: Span) { append(self, s) }
    fn set(*mut self, s: Span) { set(self, s) }
    fn repeat(*mut self, s: Span, times: usize) { repeat(self, s, times) }
    fn big_here(*mut self) { big_here(self) }
    fn small_here(*mut self) { small_here(self) }
}

// ------------------------------------------------------------------- Str16
//
// WTF-16: validates nothing, normalizes nothing (SPEC 8.2).
impl Str16 {
    fn length(*self) -> usize { return str16_len(self) }
    fn at(*self, i: usize) -> u16 { return str16_at(self, i) }
    fn equal(*self, b: *mut Str16) -> bool { return str16_eq(self, b) }
    fn add(*mut self, u: u16) { str16_push(self, u) }
    fn add_cp(*mut self, cp: u32) { str16_push_cp(self, cp) }
    fn set_at(*mut self, i: usize, u: u16) { str16_set(self, i, u) }
    fn clear(*mut self) { str16_clear(self) }
    fn free(*mut self) { str16_free(self) }
}
