// ERZEUGT von tools/strlib/expand.py aus tools/strlib/src/std_str.fi — nicht von Hand aendern.
// QUELLE fuer lib/std/str.fi — ERZEUGT von tools/strlib/expand.py.
//
// std.str: die einheitliche Zeichenketten-Fassade ueber lib/str (SPEC §8):
// Bytes (rohe Oktette), Str (geprueftes UTF-8), Str16 (WTF-16, prueft
// nichts), Atom (internierter Name als u32). lib/str ist eine
// Einbindungs-Bibliothek (Stufe-0-Erbe, `//#include`) — darum wird die
// Fassade hier TEXTUELL zusammengesetzt und entsteht als EIN Modul namens
// `str`. lib/str selbst bleibt unveraendert.
// lib/str/alloc.fi — Speicher ohne libc (Modul str).
//
// Stufe 0 kennt keine globalen Variablen und keine Aggregate an
// Funktionsgrenzen; deshalb arbeitet die gesamte Bibliothek mit Zeigern auf
// vom Aufrufer gehaltene Strukturen. Der Speicher kommt direkt von mmap(2).
//
// Einbinden:  //#include lib/str/alloc.fi

const SYS_WRITE: i64 = 1
const SYS_READ: i64 = 0
const SYS_MMAP: i64 = 9
const SYS_MUNMAP: i64 = 11
const SYS_EXIT: i64 = 60
const PROT_READ_WRITE: i64 = 3
const MAP_PRIVATE_ANON: i64 = 34

fn page_round(n: usize) -> usize {
    return (n + 4095) / 4096 * 4096
}

// Liefert n zusammenhaengende Bytes (nullinitialisiert) oder 0 bei Fehler.
fn heap_alloc(n: usize) -> *mut u8 {
    if n == 0 {
        return 0 as *mut u8
    }
    let len: usize = page_round(n)
    let r: i64 = syscall(SYS_MMAP, 0, len as i64, PROT_READ_WRITE, MAP_PRIVATE_ANON, -1, 0)
    // mmap meldet Fehler als -1..-4095
    if r < 0 && r > -4096 {
        return 0 as *mut u8
    }
    return r as *mut u8
}

fn heap_free(p: *mut u8, n: usize) {
    if p as usize != 0 {
        syscall(SYS_MUNMAP, p as i64, page_round(n) as i64)
    }
}

fn mem_copy(dst: *mut u8, src: *mut u8, n: usize) {
    var i: usize = 0
    while i < n {
        *((dst as usize + i) as *mut u8) = *((src as usize + i) as *mut u8)
        i = i + 1
    }
}

fn mem_zero(dst: *mut u8, n: usize) {
    var i: usize = 0
    while i < n {
        *((dst as usize + i) as *mut u8) = 0 as u8
        i = i + 1
    }
}

fn mem_eq(a: *mut u8, b: *mut u8, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        if *((a as usize + i) as *mut u8) != *((b as usize + i) as *mut u8) {
            return false
        }
        i = i + 1
    }
    return true
}

// Rohe Lese-/Schreibhilfen auf 16/32/64-Bit-Elementen eines Blocks.
fn ld16(p: *mut u8, i: usize) -> u16 {
    return *((p as usize + i * 2) as *mut u16)
}
fn st16(p: *mut u8, i: usize, v: u16) {
    *((p as usize + i * 2) as *mut u16) = v
}
fn ld32(p: *mut u8, i: usize) -> u32 {
    return *((p as usize + i * 4) as *mut u32)
}
fn st32(p: *mut u8, i: usize, v: u32) {
    *((p as usize + i * 4) as *mut u32) = v
}
fn ld64(p: *mut u8, i: usize) -> u64 {
    return *((p as usize + i * 8) as *mut u64)
}
fn st64(p: *mut u8, i: usize, v: u64) {
    *((p as usize + i * 8) as *mut u64) = v
}
fn ld8(p: *mut u8, i: usize) -> u8 {
    return *((p as usize + i) as *mut u8)
}
fn st8(p: *mut u8, i: usize, v: u8) {
    *((p as usize + i) as *mut u8) = v
}

fn write_all(fd: i64, p: *mut u8, n: usize) {
    var off: usize = 0
    while off < n {
        let r: i64 = syscall(SYS_WRITE, fd, (p as usize + off) as i64, (n - off) as i64)
        if r <= 0 {
            return
        }
        off = off + r as usize
    }
}

// lib/str/bytes.fi — `Bytes` (rohe Oktette) und `Str` (geprueftes UTF-8).
//
// Layout ist Vertrag (SPEC §8.1, PLAN §3.3):
//     Bytes { ptr: *mut u8, len: usize, cap: usize }
//     Str   hat dasselbe Layout, der Inhalt ist zusaetzlich geprueftes UTF-8.
//
// `Bytes` wird NIE stillschweigend zu Text: die Umwandlung geht ausschliesslich
// ueber `bytes_to_str` (prueft) bzw. `str_from_bytes_lossy`.
//
// Einbinden:  //#include lib/str/bytes.fi   (braucht lib/str/alloc.fi)

struct Bytes {
    ptr: *mut u8,
    len: usize,
    cap: usize,
}

fn bytes_init(b: *mut Bytes) {
    (*b).ptr = 0 as *mut u8
    (*b).len = 0
    (*b).cap = 0
}

fn bytes_free(b: *mut Bytes) {
    heap_free((*b).ptr, (*b).cap)
    bytes_init(b)
}

fn bytes_reserve(b: *mut Bytes, need: usize) {
    if (*b).cap >= need {
        return
    }
    var cap: usize = (*b).cap
    if cap == 0 {
        cap = 32
    }
    while cap < need {
        cap = cap * 2
    }
    let p: *mut u8 = heap_alloc(cap)
    if (*b).len > 0 {
        mem_copy(p, (*b).ptr, (*b).len)
    }
    heap_free((*b).ptr, (*b).cap)
    (*b).ptr = p
    (*b).cap = cap
}

fn bytes_push(b: *mut Bytes, v: u8) {
    bytes_reserve(b, (*b).len + 1)
    st8((*b).ptr, (*b).len, v)
    (*b).len = (*b).len + 1
}

fn bytes_len(b: *mut Bytes) -> usize {
    return (*b).len
}

fn bytes_at(b: *mut Bytes, i: usize) -> u8 {
    if i >= (*b).len {
        return 0 as u8
    }
    return ld8((*b).ptr, i)
}

fn bytes_clear(b: *mut Bytes) {
    (*b).len = 0
}

fn bytes_append(b: *mut Bytes, p: *mut u8, n: usize) {
    bytes_reserve(b, (*b).len + n)
    mem_copy(((*b).ptr as usize + (*b).len) as *mut u8, p, n)
    (*b).len = (*b).len + n
}

fn bytes_eq(a: *mut Bytes, b: *mut Bytes) -> bool {
    if (*a).len != (*b).len {
        return false
    }
    return mem_eq((*a).ptr, (*b).ptr, (*a).len)
}

fn bytes_write(fd: i64, b: *mut Bytes) {
    write_all(fd, (*b).ptr, (*b).len)
}

// --- UTF-8-Pruefung (Grenze Bytes -> Str, SPEC §8.1) ---------------------

// Wohlgeformtes UTF-8 nach Unicode-Tabelle 3-7: keine Ueberlangkodierung,
// keine Surrogate (U+D800..U+DFFF), nichts ueber U+10FFFF.
fn utf8_is_valid(p: *mut u8, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        let b0: u32 = ld8(p, i) as u32
        var need: usize = 0
        var lo: u32 = 0
        var hi: u32 = 0
        if b0 < 0x80 {
            need = 0
        } else if b0 >= 0xC2 && b0 <= 0xDF {
            need = 1
            lo = 0x80
            hi = 0xBF
        } else if b0 == 0xE0 {
            need = 2
            lo = 0xA0
            hi = 0xBF
        } else if b0 >= 0xE1 && b0 <= 0xEC {
            need = 2
            lo = 0x80
            hi = 0xBF
        } else if b0 == 0xED {
            need = 2
            lo = 0x80
            hi = 0x9F
        } else if b0 >= 0xEE && b0 <= 0xEF {
            need = 2
            lo = 0x80
            hi = 0xBF
        } else if b0 == 0xF0 {
            need = 3
            lo = 0x90
            hi = 0xBF
        } else if b0 >= 0xF1 && b0 <= 0xF3 {
            need = 3
            lo = 0x80
            hi = 0xBF
        } else if b0 == 0xF4 {
            need = 3
            lo = 0x80
            hi = 0x8F
        } else {
            return false
        }
        if need > 0 && i + need >= n {
            return false
        }
        var k: usize = 1
        while k <= need {
            let c: u32 = ld8(p, i + k) as u32
            if k == 1 {
                if c < lo || c > hi {
                    return false
                }
            } else {
                if c < 0x80 || c > 0xBF {
                    return false
                }
            }
            k = k + 1
        }
        i = i + need + 1
    }
    return true
}

// Bytes -> Str: gelingt nur bei wohlgeformtem UTF-8 (kopiert nicht, prueft nur).
fn bytes_is_str(b: *mut Bytes) -> bool {
    return utf8_is_valid((*b).ptr, (*b).len)
}

// lib/str/str16.fi — `Str16`: Folge von u16-Codeeinheiten (WTF-16, SPEC §8.2).
//
// Str16 prueft NICHTS und normalisiert NICHTS. Ungepaarte Surrogate sind
// erlaubt und bleiben Element fuer Element erhalten — das ist Absicht: eine
// JavaScript-Zeichenkette darf sie enthalten.
//
// Layout ist Vertrag:  Str16 { ptr: *mut u16, len: usize, cap: usize }
// (len/cap zaehlen CODEEINHEITEN, nicht Bytes.)
//
// API-Vertrag mit dem Modul tok (PLAN §3.3). Da Stufe 0 weder `inout`/`&` noch
// Aggregate an Funktionsgrenzen kennt, sind die Parameter Zeiger und der
// Konstruktor heisst `str16_init(*mut Str16)` statt `str16_new() -> Str16`.
// Die Namen str16_push/str16_len/str16_at sind unveraendert.
//
// Einbinden:  //#include lib/str/str16.fi   (braucht alloc.fi, bytes.fi)

struct Str16 {
    ptr: *mut u16,
    len: usize,
    cap: usize,
}

fn str16_init(s: *mut Str16) {
    (*s).ptr = 0 as *mut u16
    (*s).len = 0
    (*s).cap = 0
}

fn str16_free(s: *mut Str16) {
    heap_free((*s).ptr as *mut u8, (*s).cap * 2)
    str16_init(s)
}

fn str16_reserve(s: *mut Str16, need: usize) {
    if (*s).cap >= need {
        return
    }
    var cap: usize = (*s).cap
    if cap == 0 {
        cap = 16
    }
    while cap < need {
        cap = cap * 2
    }
    let p: *mut u8 = heap_alloc(cap * 2)
    if (*s).len > 0 {
        mem_copy(p, (*s).ptr as *mut u8, (*s).len * 2)
    }
    heap_free((*s).ptr as *mut u8, (*s).cap * 2)
    (*s).ptr = p as *mut u16
    (*s).cap = cap
}

// Haengt EINE Codeeinheit an — ohne jede Pruefung (auch 0xD800 allein).
fn str16_push(s: *mut Str16, u: u16) {
    str16_reserve(s, (*s).len + 1)
    st16((*s).ptr as *mut u8, (*s).len, u)
    (*s).len = (*s).len + 1
}

fn str16_len(s: *mut Str16) -> usize {
    return (*s).len
}

fn str16_at(s: *mut Str16, i: usize) -> u16 {
    if i >= (*s).len {
        return 0 as u16
    }
    return ld16((*s).ptr as *mut u8, i)
}

fn str16_set(s: *mut Str16, i: usize, u: u16) {
    if i < (*s).len {
        st16((*s).ptr as *mut u8, i, u)
    }
}

fn str16_clear(s: *mut Str16) {
    (*s).len = 0
}

fn str16_eq(a: *mut Str16, b: *mut Str16) -> bool {
    if (*a).len != (*b).len {
        return false
    }
    return mem_eq((*a).ptr as *mut u8, (*b).ptr as *mut u8, (*a).len * 2)
}

// Codepunkt anhaengen: > 0xFFFF wird zum Surrogatpaar, alles andere
// (einschliesslich einzelner Surrogate!) wird eine Codeeinheit.
fn str16_push_cp(s: *mut Str16, cp: u32) {
    if cp > 0xFFFF {
        let v: u32 = cp - 0x10000
        str16_push(s, (0xD800 + (v >> 10)) as u16)
        str16_push(s, (0xDC00 + (v & 0x3FF)) as u16)
    } else {
        str16_push(s, cp as u16)
    }
}

fn is_high_surrogate(u: u32) -> bool {
    return u >= 0xD800 && u < 0xDC00
}
fn is_low_surrogate(u: u32) -> bool {
    return u >= 0xDC00 && u < 0xE000
}
fn is_surrogate(u: u32) -> bool {
    return u >= 0xD800 && u < 0xE000
}

// lib/str/str16_byval.fi — Konstruktoren nach dem API-Vertrag (PLAN §3.3).
//
// `str16_new() -> Str16` und `bytes_new() -> Bytes` geben ein Aggregat als
// Rueckgabewert zurueck. Das ist erst moeglich, seit das Modul `kern` in
// Runde 2 die System-V-Klassifikation umgesetzt hat (SPEC §14.1 Punkt 1
// gestrichen). Wer noch ohne auskommen muss, nimmt `str16_init(&s)` /
// `bytes_init(&b)` aus str16.fi bzw. bytes.fi — beide Wege liefern denselben
// leeren Wert.
//
// Einbinden:  //#include lib/str/str16_byval.fi  (braucht bytes.fi, str16.fi)

fn str16_new() -> Str16 {
    var s: Str16 = Str16{ ptr: 0 as *mut u16, len: 0, cap: 0, }
    return s
}

fn bytes_new() -> Bytes {
    var b: Bytes = Bytes{ ptr: 0 as *mut u8, len: 0, cap: 0, }
    return b
}

// lib/str/utf8.fi — Umwandlungen zwischen Str16 (WTF-16), Str (UTF-8) und
// WTF-8 (SPEC §8.2). Alle Umwandlungen sind AUSDRUECKLICH, ihre Fehlbarkeit
// steht im Ergebnis:
//
//   str16_to_utf8       -> bool   false = ungepaartes Surrogat, Ziel bleibt leer
//   str16_to_utf8_lossy -> ersetzt ungepaarte Surrogate durch U+FFFD
//   str16_to_wtf8       -> verlustfrei (haelt ungepaarte Surrogate)
//   wtf8_to_str16       -> verlustfreie Rueckrichtung
//   utf8_to_str16       -> gelingt immer, wenn die Quelle gueltiges UTF-8 ist
//
// Einbinden:  //#include lib/str/utf8.fi   (braucht alloc.fi, bytes.fi, str16.fi)

const REPLACEMENT_CP: u32 = 0xFFFD

fn utf8_push_cp(out: *mut Bytes, cp: u32) {
    if cp < 0x80 {
        bytes_push(out, cp as u8)
    } else if cp < 0x800 {
        bytes_push(out, (0xC0 + (cp >> 6)) as u8)
        bytes_push(out, (0x80 + (cp & 0x3F)) as u8)
    } else if cp < 0x10000 {
        bytes_push(out, (0xE0 + (cp >> 12)) as u8)
        bytes_push(out, (0x80 + ((cp >> 6) & 0x3F)) as u8)
        bytes_push(out, (0x80 + (cp & 0x3F)) as u8)
    } else {
        bytes_push(out, (0xF0 + (cp >> 18)) as u8)
        bytes_push(out, (0x80 + ((cp >> 12) & 0x3F)) as u8)
        bytes_push(out, (0x80 + ((cp >> 6) & 0x3F)) as u8)
        bytes_push(out, (0x80 + (cp & 0x3F)) as u8)
    }
}

fn combine_surrogates(hi: u32, lo: u32) -> u32 {
    return 0x10000 + ((hi - 0xD800) << 10) + (lo - 0xDC00)
}

// Str16 -> Str. Ergebnis false bei ungepaartem Surrogat; `out` ist dann leer.
fn str16_to_utf8(s: *mut Str16, out: *mut Bytes) -> bool {
    bytes_clear(out)
    var i: usize = 0
    let n: usize = str16_len(s)
    while i < n {
        let u: u32 = str16_at(s, i) as u32
        if is_high_surrogate(u) {
            if i + 1 >= n {
                bytes_clear(out)
                return false
            }
            let lo: u32 = str16_at(s, i + 1) as u32
            if !is_low_surrogate(lo) {
                bytes_clear(out)
                return false
            }
            utf8_push_cp(out, combine_surrogates(u, lo))
            i = i + 2
        } else if is_low_surrogate(u) {
            bytes_clear(out)
            return false
        } else {
            utf8_push_cp(out, u)
            i = i + 1
        }
    }
    return true
}

// Str16 -> Str, ersetzend: jedes ungepaarte Surrogat wird U+FFFD.
fn str16_to_utf8_lossy(s: *mut Str16, out: *mut Bytes) {
    bytes_clear(out)
    var i: usize = 0
    let n: usize = str16_len(s)
    while i < n {
        let u: u32 = str16_at(s, i) as u32
        if is_high_surrogate(u) {
            var paired: bool = false
            if i + 1 < n {
                if is_low_surrogate(str16_at(s, i + 1) as u32) {
                    paired = true
                }
            }
            if paired {
                utf8_push_cp(out, combine_surrogates(u, str16_at(s, i + 1) as u32))
                i = i + 2
            } else {
                utf8_push_cp(out, REPLACEMENT_CP)
                i = i + 1
            }
        } else if is_low_surrogate(u) {
            utf8_push_cp(out, REPLACEMENT_CP)
            i = i + 1
        } else {
            utf8_push_cp(out, u)
            i = i + 1
        }
    }
}

// Str16 -> WTF-8: verlustfreie Bruecke, ungepaarte Surrogate bleiben als
// Drei-Byte-Folge erhalten.
fn str16_to_wtf8(s: *mut Str16, out: *mut Bytes) {
    bytes_clear(out)
    var i: usize = 0
    let n: usize = str16_len(s)
    while i < n {
        let u: u32 = str16_at(s, i) as u32
        var step: usize = 1
        var cp: u32 = u
        if is_high_surrogate(u) && i + 1 < n {
            let lo: u32 = str16_at(s, i + 1) as u32
            if is_low_surrogate(lo) {
                cp = combine_surrogates(u, lo)
                step = 2
            }
        }
        utf8_push_cp(out, cp)
        i = i + step
    }
}

// WTF-8 -> Str16, verlustfrei (Surrogatfolgen werden wieder Einzeleinheiten).
fn wtf8_to_str16(b: *mut Bytes, out: *mut Str16) {
    str16_clear(out)
    var i: usize = 0
    let n: usize = bytes_len(b)
    while i < n {
        let b0: u32 = bytes_at(b, i) as u32
        var cp: u32 = 0
        var len: usize = 1
        if b0 < 0x80 {
            cp = b0
            len = 1
        } else if b0 >= 0xF0 {
            cp = b0 & 0x07
            len = 4
        } else if b0 >= 0xE0 {
            cp = b0 & 0x0F
            len = 3
        } else if b0 >= 0xC0 {
            cp = b0 & 0x1F
            len = 2
        } else {
            cp = REPLACEMENT_CP
            len = 1
        }
        if len > 1 {
            if i + len > n {
                str16_push_cp(out, REPLACEMENT_CP)
                return
            }
            var k: usize = 1
            while k < len {
                cp = (cp << 6) + (bytes_at(b, i + k) as u32 & 0x3F)
                k = k + 1
            }
        }
        if is_surrogate(cp) {
            str16_push(out, cp as u16)
        } else {
            str16_push_cp(out, cp)
        }
        i = i + len
    }
}

// Str -> Str16: gelingt immer (die Quelle ist geprueftes UTF-8).
fn utf8_to_str16(b: *mut Bytes, out: *mut Str16) {
    wtf8_to_str16(b, out)
}

// lib/str/atom.fi — `Atom` (SPEC §8.3): internierter Name als u32.
//
// Vergleich zweier Atome ist ein GANZZAHLVERGLEICH (`a == b`), kein
// Zeichenvergleich. Wer zuerst interniert, bekommt die kleinste Nummer: das
// Modul tok interniert seine bekannten Tag-Namen beim Start in fester
// Reihenfolge und erhaelt damit feste, kleine Nummern (Voraussetzung fuer
// Sprungtabellen ueber Tag-Namen).
//
// Es gibt in Stufe 0 keine globalen Variablen; die Tabelle wird darum vom
// Aufrufer gehalten und als Zeiger uebergeben.
//
// Einbinden:  //#include lib/str/atom.fi   (braucht alloc.fi, bytes.fi)

struct AtomTable {
    arena: *mut u8,     // alle Namen hintereinander
    arena_len: usize,
    arena_cap: usize,
    ents: *mut u8,      // je Atom zwei u64: Offset, Laenge
    count: usize,
    ents_cap: usize,
    buckets: *mut u8,   // offene Adressierung, je Platz ein u32 (0 = leer, sonst id+1)
    nbuckets: usize,
}

fn atom_hash(p: *mut u8, len: usize) -> u64 {
    var h: u64 = 14695981039346656037
    var i: usize = 0
    while i < len {
        h = h ^ (ld8(p, i) as u64)
        h = h * 1099511628211
        i = i + 1
    }
    return h
}

fn atom_table_init(t: *mut AtomTable) {
    (*t).arena = heap_alloc(65536)
    (*t).arena_len = 0
    (*t).arena_cap = 65536
    (*t).ents = heap_alloc(1024 * 16)
    (*t).count = 0
    (*t).ents_cap = 1024
    (*t).nbuckets = 4096
    (*t).buckets = heap_alloc(4096 * 4)
    mem_zero((*t).buckets, 4096 * 4)
}

fn atom_free(t: *mut AtomTable) {
    heap_free((*t).arena, (*t).arena_cap)
    heap_free((*t).ents, (*t).ents_cap * 16)
    heap_free((*t).buckets, (*t).nbuckets * 4)
    (*t).count = 0
}

fn atom_off(t: *mut AtomTable, id: u32) -> usize {
    return ld64((*t).ents, (id as usize) * 2) as usize
}
fn atom_len(t: *mut AtomTable, id: u32) -> usize {
    return ld64((*t).ents, (id as usize) * 2 + 1) as usize
}
fn atom_ptr(t: *mut AtomTable, id: u32) -> *mut u8 {
    return ((*t).arena as usize + atom_off(t, id)) as *mut u8
}

fn atom_count(t: *mut AtomTable) -> usize {
    return (*t).count
}

// Namen eines Atoms nach `out` kopieren.
fn atom_text(t: *mut AtomTable, id: u32, out: *mut Bytes) {
    bytes_clear(out)
    if id as usize >= (*t).count {
        return
    }
    bytes_append(out, atom_ptr(t, id), atom_len(t, id))
}

fn atom_rehash(t: *mut AtomTable) {
    let nb: usize = (*t).nbuckets * 2
    let nbuf: *mut u8 = heap_alloc(nb * 4)
    mem_zero(nbuf, nb * 4)
    heap_free((*t).buckets, (*t).nbuckets * 4)
    (*t).buckets = nbuf
    (*t).nbuckets = nb
    var id: usize = 0
    while id < (*t).count {
        let h: u64 = atom_hash(atom_ptr(t, id as u32), atom_len(t, id as u32))
        var slot: usize = (h as usize) & (nb - 1)
        while ld32(nbuf, slot) != 0 as u32 {
            slot = (slot + 1) & (nb - 1)
        }
        st32(nbuf, slot, (id + 1) as u32)
        id = id + 1
    }
}

fn atom_grow_arena(t: *mut AtomTable, need: usize) {
    if (*t).arena_len + need <= (*t).arena_cap {
        return
    }
    var cap: usize = (*t).arena_cap
    while cap < (*t).arena_len + need {
        cap = cap * 2
    }
    let p: *mut u8 = heap_alloc(cap)
    mem_copy(p, (*t).arena, (*t).arena_len)
    heap_free((*t).arena, (*t).arena_cap)
    (*t).arena = p
    (*t).arena_cap = cap
}

fn atom_grow_ents(t: *mut AtomTable) {
    if (*t).count < (*t).ents_cap {
        return
    }
    let cap: usize = (*t).ents_cap * 2
    let p: *mut u8 = heap_alloc(cap * 16)
    mem_copy(p, (*t).ents, (*t).count * 16)
    heap_free((*t).ents, (*t).ents_cap * 16)
    (*t).ents = p
    (*t).ents_cap = cap
}

// Kern: interniert `len` Oktette ab `p` und liefert die Atom-Nummer.
fn atom_intern_raw(t: *mut AtomTable, p: *mut u8, len: usize) -> u32 {
    if (*t).count * 2 >= (*t).nbuckets {
        atom_rehash(t)
    }
    let h: u64 = atom_hash(p, len)
    let mask: usize = (*t).nbuckets - 1
    var slot: usize = (h as usize) & mask
    while true {
        let e: u32 = ld32((*t).buckets, slot)
        if e == 0 as u32 {
            atom_grow_arena(t, len)
            atom_grow_ents(t)
            let id: usize = (*t).count
            let off: usize = (*t).arena_len
            mem_copy(((*t).arena as usize + off) as *mut u8, p, len)
            (*t).arena_len = off + len
            st64((*t).ents, id * 2, off as u64)
            st64((*t).ents, id * 2 + 1, len as u64)
            (*t).count = id + 1
            st32((*t).buckets, slot, (id + 1) as u32)
            return id as u32
        }
        let id: u32 = e - 1 as u32
        if atom_len(t, id) == len {
            if mem_eq(atom_ptr(t, id), p, len) {
                return id
            }
        }
        slot = (slot + 1) & mask
    }
    return 0 as u32
}

// API-Vertrag mit dem Modul tok: `atom_intern` ueber `Bytes`.
fn atom_intern(t: *mut AtomTable, b: *mut Bytes) -> u32 {
    return atom_intern_raw(t, (*b).ptr, (*b).len)
}

// Vergleich zweier Atome — ein Ganzzahlvergleich, mehr nicht.
fn atom_eq(a: u32, b: u32) -> bool {
    return a == b
}

