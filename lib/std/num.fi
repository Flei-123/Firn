//
// Stage 0 has neither global variables nor aggregates across function
// boundaries; that is why the whole library works with pointers to
// structures held by the caller. The memory comes straight from mmap(2).
//
// Include:  //#include lib/str/alloc.fi

// ROUND 73: the pure memory work (copy/compare/zero, ld*/st*, page_round)
// moved to `lib/str/core_mem.fi` -- it is the part that a freestanding
// kernel may use. Everything that is LEFT here needs the operating
// system: mmap, munmap, write. Whoever includes this file gets both, so
// no existing caller notices the cut.
// lib/str/core_mem.fi -- memory work WITHOUT the operating system (round 73).
//
// The pure half of `lib/str/alloc.fi`: copying, comparing, zeroing and the
// raw load/store helpers for the 8/16/32/64 bit elements of a block.
// Not one of these functions asks anybody for memory and not one of them
// makes a system call -- they work on memory that the CALLER already
// holds. That is exactly the line along which round 73 cuts the library
// (docs/ROUND73.md): whatever stands here may be used under
// `profile kernel`.
//
// `page_round` stands here as well although it smells of mmap: it is
// arithmetic on a number and nothing else. Whoever rounds a length to
// pages has not yet asked for a single page.
//
// Include:  //#include lib/str/core_mem.fi

fn page_round(n: usize) -> usize {
    return (n + 4095) / 4096 * 4096
}

fn mem_copy(dst: *mut u8, src: *mut u8, n: usize) {
    var i: usize = 0
    while i < n {
        *((dst as usize + i) as *mut u8) = *((src as usize + i) as *mut u8)
        i = i + 1
    }
}

fn mem_zero(dst: *mut u8, n: usize) {
    var i: usize = 0
    while i < n {
        *((dst as usize + i) as *mut u8) = 0 as u8
        i = i + 1
    }
}

fn mem_eq(a: *mut u8, b: *mut u8, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        if *((a as usize + i) as *mut u8) != *((b as usize + i) as *mut u8) {
            return false
        }
        i = i + 1
    }
    return true
}

// Raw read/write helpers for the 16/32/64 bit elements of a block.
fn ld16(p: *mut u8, i: usize) -> u16 {
    return *((p as usize + i * 2) as *mut u16)
}
fn st16(p: *mut u8, i: usize, v: u16) {
    *((p as usize + i * 2) as *mut u16) = v
}
fn ld32(p: *mut u8, i: usize) -> u32 {
    return *((p as usize + i * 4) as *mut u32)
}
fn st32(p: *mut u8, i: usize, v: u32) {
    *((p as usize + i * 4) as *mut u32) = v
}
fn ld64(p: *mut u8, i: usize) -> u64 {
    return *((p as usize + i * 8) as *mut u64)
}
fn st64(p: *mut u8, i: usize, v: u64) {
    *((p as usize + i * 8) as *mut u64) = v
}
fn ld8(p: *mut u8, i: usize) -> u8 {
    return *((p as usize + i) as *mut u8)
}
fn st8(p: *mut u8, i: usize, v: u8) {
    *((p as usize + i) as *mut u8) = v
}

const SYS_WRITE: i64 = 1
const SYS_READ: i64 = 0
const SYS_MMAP: i64 = 9
const SYS_MUNMAP: i64 = 11
const SYS_EXIT: i64 = 60
const PROT_READ_WRITE: i64 = 3
const MAP_PRIVATE_ANON: i64 = 34

// Returns n contiguous bytes (zero initialized) or 0 on failure.
fn heap_alloc(n: usize) -> *mut u8 {
    if n == 0 {
        return 0 as *mut u8
    }
    let len: usize = page_round(n)
    let r: i64 = syscall(SYS_MMAP, 0, len as i64, PROT_READ_WRITE, MAP_PRIVATE_ANON, -1, 0)
    // mmap reports failure as -1..-4095
    if r < 0 && r > -4096 {
        return 0 as *mut u8
    }
    return r as *mut u8
}

fn heap_free(p: *mut u8, n: usize) {
    if p as usize != 0 {
        syscall(SYS_MUNMAP, p as i64, page_round(n) as i64)
    }
}

fn write_all(fd: i64, p: *mut u8, n: usize) {
    var off: usize = 0
    while off < n {
        let r: i64 = syscall(SYS_WRITE, fd, (p as usize + off) as i64, (n - off) as i64)
        if r <= 0 {
            return
        }
        off = off + r as usize
    }
}

// lib/str/bytes.fi -- `Bytes` (raw octets) and `Str` (validated UTF-8).
//
// The layout is a contract (SPEC 8.1, PLAN 3.3):
//     Bytes { ptr: *mut u8, len: usize, cap: usize }
//     Str   has the same layout, its content is additionally validated UTF-8.
//
// `Bytes` NEVER turns into text silently: the conversion goes exclusively
// through `bytes_to_str` (which validates) or `str_from_bytes_lossy`.
//
// Include:  //#include lib/str/bytes.fi   (needs lib/str/alloc.fi)

struct Bytes {
    ptr: *mut u8,
    len: usize,
    cap: usize,
}

fn bytes_init(b: *mut Bytes) {
    (*b).ptr = 0 as *mut u8
    (*b).len = 0
    (*b).cap = 0
}

fn bytes_free(b: *mut Bytes) {
    heap_free((*b).ptr, (*b).cap)
    bytes_init(b)
}

fn bytes_reserve(b: *mut Bytes, need: usize) {
    if (*b).cap >= need {
        return
    }
    var cap: usize = (*b).cap
    if cap == 0 {
        cap = 32
    }
    while cap < need {
        cap = cap * 2
    }
    let p: *mut u8 = heap_alloc(cap)
    if (*b).len > 0 {
        mem_copy(p, (*b).ptr, (*b).len)
    }
    heap_free((*b).ptr, (*b).cap)
    (*b).ptr = p
    (*b).cap = cap
}

fn bytes_push(b: *mut Bytes, v: u8) {
    bytes_reserve(b, (*b).len + 1)
    st8((*b).ptr, (*b).len, v)
    (*b).len = (*b).len + 1
}

fn bytes_len(b: *mut Bytes) -> usize {
    return (*b).len
}

fn bytes_at(b: *mut Bytes, i: usize) -> u8 {
    if i >= (*b).len {
        return 0 as u8
    }
    return ld8((*b).ptr, i)
}

fn bytes_clear(b: *mut Bytes) {
    (*b).len = 0
}

fn bytes_append(b: *mut Bytes, p: *mut u8, n: usize) {
    bytes_reserve(b, (*b).len + n)
    mem_copy(((*b).ptr as usize + (*b).len) as *mut u8, p, n)
    (*b).len = (*b).len + n
}

fn bytes_eq(a: *mut Bytes, b: *mut Bytes) -> bool {
    if (*a).len != (*b).len {
        return false
    }
    return mem_eq((*a).ptr, (*b).ptr, (*a).len)
}

fn bytes_write(fd: i64, b: *mut Bytes) {
    write_all(fd, (*b).ptr, (*b).len)
}

// --- UTF-8 validation (the Bytes -> Str boundary, SPEC 8.1) --------------

// Well formed UTF-8 per Unicode table 3-7: no overlong encoding,
// no surrogates (U+D800..U+DFFF), nothing above U+10FFFF.
fn utf8_is_valid(p: *mut u8, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        let b0: u32 = ld8(p, i) as u32
        var need: usize = 0
        var lo: u32 = 0
        var hi: u32 = 0
        if b0 < 0x80 {
            need = 0
        } else if b0 >= 0xC2 && b0 <= 0xDF {
            need = 1
            lo = 0x80
            hi = 0xBF
        } else if b0 == 0xE0 {
            need = 2
            lo = 0xA0
            hi = 0xBF
        } else if b0 >= 0xE1 && b0 <= 0xEC {
            need = 2
            lo = 0x80
            hi = 0xBF
        } else if b0 == 0xED {
            need = 2
            lo = 0x80
            hi = 0x9F
        } else if b0 >= 0xEE && b0 <= 0xEF {
            need = 2
            lo = 0x80
            hi = 0xBF
        } else if b0 == 0xF0 {
            need = 3
            lo = 0x90
            hi = 0xBF
        } else if b0 >= 0xF1 && b0 <= 0xF3 {
            need = 3
            lo = 0x80
            hi = 0xBF
        } else if b0 == 0xF4 {
            need = 3
            lo = 0x80
            hi = 0x8F
        } else {
            return false
        }
        if need > 0 && i + need >= n {
            return false
        }
        var k: usize = 1
        while k <= need {
            let c: u32 = ld8(p, i + k) as u32
            if k == 1 {
                if c < lo || c > hi {
                    return false
                }
            } else {
                if c < 0x80 || c > 0xBF {
                    return false
                }
            }
            k = k + 1
        }
        i = i + need + 1
    }
    return true
}

// Bytes -> Str: succeeds only for well formed UTF-8 (validates, copies nothing).
fn bytes_is_str(b: *mut Bytes) -> bool {
    return utf8_is_valid((*b).ptr, (*b).len)
}

// lib/num/bignum.fi -- big numbers (unsigned) for strtod/dtoa.
//
// Representation: a sequence of u32 digits, least significant first, in a
// block of memory provided by the caller. `n` is the number of digits in
// use (leading zero digits are cut off), `cap` is the capacity.
// Every computation is exact -- that is exactly what a correctly rounded
// strtod and the shortest output need.
//
// Include:  //#include lib/num/bignum.fi   (needs lib/str/alloc.fi)

const BN_LIMBS: usize = 512 // 512 * 32 bit = 16384 bit, enough for
// 10^400 * 10^780 including the shifts

struct Bn {
    d: *mut u8,
    n: usize,
    cap: usize,
}

fn bn_init(b: *mut Bn, mem: *mut u8, cap: usize) {
    (*b).d = mem
    (*b).n = 0
    (*b).cap = cap
}

fn bn_limb(b: *mut Bn, i: usize) -> u32 {
    if i >= (*b).n {
        return 0 as u32
    }
    return ld32((*b).d, i)
}

fn bn_setlimb(b: *mut Bn, i: usize, v: u32) {
    if i >= (*b).cap {
        return
    }
    st32((*b).d, i, v)
    if i >= (*b).n {
        var k: usize = (*b).n
        while k < i {
            st32((*b).d, k, 0 as u32)
            k = k + 1
        }
        (*b).n = i + 1
    }
}

fn bn_norm(b: *mut Bn) {
    while (*b).n > 0 {
        if ld32((*b).d, (*b).n - 1) != 0 as u32 {
            return
        }
        (*b).n = (*b).n - 1
    }
}

fn bn_zero(b: *mut Bn) {
    (*b).n = 0
}

fn bn_is_zero(b: *mut Bn) -> bool {
    return (*b).n == 0
}

fn bn_set_u64(b: *mut Bn, v: u64) {
    (*b).n = 0
    if v == 0 {
        return
    }
    st32((*b).d, 0, (v & 0xFFFFFFFF) as u32)
    (*b).n = 1
    if v >= 4294967296 {
        st32((*b).d, 1, (v >> 32) as u32)
        (*b).n = 2
    }
}

fn bn_copy(dst: *mut Bn, src: *mut Bn) {
    var i: usize = 0
    while i < (*src).n {
        st32((*dst).d, i, ld32((*src).d, i))
        i = i + 1
    }
    (*dst).n = (*src).n
}

fn bn_cmp(a: *mut Bn, b: *mut Bn) -> i32 {
    if (*a).n != (*b).n {
        if (*a).n < (*b).n {
            return -1
        }
        return 1
    }
    var i: usize = (*a).n
    while i > 0 {
        i = i - 1
        let x: u32 = ld32((*a).d, i)
        let y: u32 = ld32((*b).d, i)
        if x != y {
            if x < y {
                return -1
            }
            return 1
        }
    }
    return 0
}

// a += b
fn bn_add(a: *mut Bn, b: *mut Bn) {
    var carry: u64 = 0
    var i: usize = 0
    var m: usize = (*a).n
    if (*b).n > m {
        m = (*b).n
    }
    while i < m || carry != 0 {
        if i >= (*a).cap {
            return
        }
        let s: u64 = bn_limb(a, i) as u64 + bn_limb(b, i) as u64 + carry
        bn_setlimb(a, i, (s & 0xFFFFFFFF) as u32)
        carry = s >> 32
        i = i + 1
    }
    bn_norm(a)
}

// a -= b, precondition a >= b
fn bn_sub(a: *mut Bn, b: *mut Bn) {
    var borrow: u64 = 0
    var i: usize = 0
    while i < (*a).n {
        let x: u64 = bn_limb(a, i) as u64
        let y: u64 = bn_limb(b, i) as u64 + borrow
        if x >= y {
            st32((*a).d, i, (x - y) as u32)
            borrow = 0
        } else {
            st32((*a).d, i, (x + 4294967296 - y) as u32)
            borrow = 1
        }
        i = i + 1
    }
    bn_norm(a)
}

// a *= m
fn bn_mul_small(a: *mut Bn, m: u32) {
    if m == 0 as u32 {
        bn_zero(a)
        return
    }
    var carry: u64 = 0
    var i: usize = 0
    let n: usize = (*a).n
    while i < n {
        let p: u64 = ld32((*a).d, i) as u64 * m as u64 + carry
        st32((*a).d, i, (p & 0xFFFFFFFF) as u32)
        carry = p >> 32
        i = i + 1
    }
    while carry != 0 {
        bn_setlimb(a, i, (carry & 0xFFFFFFFF) as u32)
        carry = carry >> 32
        i = i + 1
    }
    bn_norm(a)
}

// a += v
fn bn_add_small(a: *mut Bn, v: u32) {
    var carry: u64 = v as u64
    var i: usize = 0
    while carry != 0 {
        let s: u64 = bn_limb(a, i) as u64 + carry
        bn_setlimb(a, i, (s & 0xFFFFFFFF) as u32)
        carry = s >> 32
        i = i + 1
    }
    bn_norm(a)
}

fn bn_bitlen(a: *mut Bn) -> usize {
    if (*a).n == 0 {
        return 0
    }
    var v: u32 = ld32((*a).d, (*a).n - 1)
    var bits: usize = 0
    while v != 0 as u32 {
        v = v >> 1
        bits = bits + 1
    }
    return ((*a).n - 1) * 32 + bits
}

// a <<= bits
fn bn_shl(a: *mut Bn, bits: usize) {
    if (*a).n == 0 || bits == 0 {
        return
    }
    let words: usize = bits / 32
    let sh: usize = bits % 32
    var i: usize = (*a).n
    if sh == 0 {
        while i > 0 {
            i = i - 1
            bn_setlimb(a, i + words, ld32((*a).d, i))
        }
    } else {
        // the new top digit first
        let top: u32 = ld32((*a).d, (*a).n - 1) >> (32 - sh)
        if top != 0 as u32 {
            bn_setlimb(a, (*a).n + words, top)
        }
        while i > 0 {
            i = i - 1
            var v: u32 = ld32((*a).d, i) << sh
            if i > 0 {
                v = v + (ld32((*a).d, i - 1) >> (32 - sh))
            }
            bn_setlimb(a, i + words, v)
        }
    }
    var k: usize = 0
    while k < words {
        st32((*a).d, k, 0 as u32)
        k = k + 1
    }
    bn_norm(a)
}

// a *= 10^e
fn bn_mul_pow10(a: *mut Bn, e: usize) {
    var r: usize = e
    while r >= 9 {
        bn_mul_small(a, 1000000000 as u32)
        r = r - 9
    }
    var m: u32 = 1 as u32
    var k: usize = 0
    while k < r {
        m = m * 10 as u32
        k = k + 1
    }
    if m != 1 as u32 {
        bn_mul_small(a, m)
    }
}

// dst = 10^e
fn bn_pow10(dst: *mut Bn, e: usize) {
    bn_set_u64(dst, 1)
    bn_mul_pow10(dst, e)
}

// Integer division: returns the floor of num/`the` as a u64 and leaves the
// remainder in `num`. Precondition: the quotient fits in 64 bit (the caller
// scales beforehand). `tmp` is scratch memory.
fn bn_div_q(num: *mut Bn, the: *mut Bn, tmp: *mut Bn) -> u64 {
    if bn_cmp(num, the) < 0 {
        return 0
    }
    let bn: usize = bn_bitlen(num)
    let bd: usize = bn_bitlen(the)
    var k: usize = bn - bd
    if k > 63 {
        // The caller scaled wrongly; a clean 0 is better than a
        // silently wrong answer.
        return 0
    }
    var q: u64 = 0
    var i: usize = k + 1
    while i > 0 {
        i = i - 1
        bn_copy(tmp, the)
        bn_shl(tmp, i)
        if bn_cmp(num, tmp) >= 0 {
            bn_sub(num, tmp)
            q = q + (1 << i)
        }
    }
    return q
}

// One decimal digit: the floor of num/`the` (0..9); the rest stays in `num`.
// Precondition: num < 10 * `the`.
fn bn_div_digit(num: *mut Bn, the: *mut Bn) -> u32 {
    var d: u32 = 0
    while bn_cmp(num, the) >= 0 {
        bn_sub(num, the)
        d = d + 1 as u32
        if d > 10 as u32 {
            return d
        }
    }
    return d
}

// lib/num/dtoa.fi -- double -> shortest text WITH A ROUND TRIP GUARANTEE
// (SPEC 8.4, requirement Z6).
//
// Method: Dragon4 in free format (Steele/White, Burger/Dybvig) in exact big
// number arithmetic. It produces exactly as many digits as are needed to
// pin the double down uniquely -- never more, never fewer. That makes
// strtod(dtoa(x)) == x hold for EVERY finite double, and the digit sequence
// is the same one Ryu/Grisu produce.
//
// The text form follows ECMAScript `Number.prototype.toString` (section
// 6.1.6.1.20): 0.1 -> "0.1", 1e21 -> "1e+21", 5e-324 -> "5e-324".
//
// The input is the bit pattern of the double as a u64 (stage 0 has no f64
// yet, see the header of strtod.fi).
//
// Include:  //#include lib/num/dtoa.fi  (needs alloc.fi, bytes.fi, bignum.fi)

const DTOA_WS_BYTES: usize = 7 * 512 * 4

// ROUND 73: the six bit tests moved to lib/num/core_bits.fi -- the number
// reader of `lib/std/core.fi` needs them and must not drag `dtoa` (which
// writes into a Bytes) along with them.
// lib/num/core_bits.fi -- reading an IEEE-754 double off its bits
// (round 73).
//
// Sign, biased exponent, mantissa, and the three questions that follow
// from them: NaN, infinity, zero. Pure integer arithmetic on a `u64` --
// not one of these six lines touches the FPU, which is why they carry no
// `#[allow_fp]` and cost a kernel nothing.
//
// They were part of `lib/num/dtoa.fi` up to round 73. They had to move,
// because `dtoa` writes into a `*mut Bytes` (it OWNS memory) and therefore
// cannot go into `lib/std/core.fi`, while `f64_is_nan` and its kin have to
// -- and both must keep calling the SAME six lines. The names keep the
// prefix `dtoa_`: whoever searches the tree for them finds every caller
// under the name he knows.
//
// Include:  //#include lib/num/core_bits.fi

fn dtoa_sign(bits: u64) -> bool {
    return (bits >> 63) == 1
}
fn dtoa_biased_exp(bits: u64) -> u64 {
    return (bits >> 52) & 0x7FF
}
fn dtoa_frac(bits: u64) -> u64 {
    return bits & 0xFFFFFFFFFFFFF
}
fn dtoa_is_nan(bits: u64) -> bool {
    return dtoa_biased_exp(bits) == 0x7FF && dtoa_frac(bits) != 0
}
fn dtoa_is_inf(bits: u64) -> bool {
    return dtoa_biased_exp(bits) == 0x7FF && dtoa_frac(bits) == 0
}
fn dtoa_is_zero(bits: u64) -> bool {
    return (bits << 1) == 0
}

// ROUND 71 -- the same six questions for an IEEE-754 binary32. Pure integer
// arithmetic on a `u32`: sign in bit 31, eight exponent bits, 23 mantissa
// bits. No FPU is touched here either, which is why these lines cost a
// kernel nothing.
fn f32_bits_sign(bits: u32) -> bool {
    return (bits >> 31) == 1
}
fn f32_bits_exp(bits: u32) -> u32 {
    return (bits >> 23) & 255
}
fn f32_bits_frac(bits: u32) -> u32 {
    return bits & 8388607
}
fn f32_bits_is_nan(bits: u32) -> bool {
    return f32_bits_exp(bits) == 255 && f32_bits_frac(bits) != 0
}
fn f32_bits_is_inf(bits: u32) -> bool {
    return f32_bits_exp(bits) == 255 && f32_bits_frac(bits) == 0
}
fn f32_bits_is_zero(bits: u32) -> bool {
    return (bits << 1) == 0
}

// Approximation of ceil(log10(2^e * m)); the correction step catches the misses.
fn dtoa_est_k(bitlen: usize, e2: i64) -> i64 {
    let x: i64 = bitlen as i64 + e2 - 1
    // log10(2) * 2^18 = 78913
    var k: i64 = (x * 78913) >> 18
    if x > 0 {
        k = k + 1
    }
    return k
}

// The shortest digit sequence. `digits` receives ASCII digits, `k10` the
// exponent n with  value = 0.d1d2...dk * 10^n. Return value: the digit count.
// `ws` needs DTOA_WS_BYTES bytes. For finite values != 0 only.
fn dtoa_digits(bits: u64, digits: *mut u8, k10: *mut i64, ws: *mut u8) -> usize {
    var num: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    var the: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    var mp: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    var mm: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    var t1: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    var t2: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    let stride: usize = BN_LIMBS * 4
    bn_init(&num, ws, BN_LIMBS)
    bn_init(&the, (ws as usize + stride) as *mut u8, BN_LIMBS)
    bn_init(&mp, (ws as usize + stride * 2) as *mut u8, BN_LIMBS)
    bn_init(&mm, (ws as usize + stride * 3) as *mut u8, BN_LIMBS)
    bn_init(&t1, (ws as usize + stride * 4) as *mut u8, BN_LIMBS)
    bn_init(&t2, (ws as usize + stride * 5) as *mut u8, BN_LIMBS)

    let be: u64 = dtoa_biased_exp(bits)
    let mf: u64 = dtoa_frac(bits)
    var m: u64 = 0
    var e2: i64 = 0
    if be == 0 {
        m = mf
        e2 = -1074
    } else {
        m = mf + D_TWO52
        e2 = be as i64 - 1075
    }
    // The lower bound is closer when the mantissa is a power of two.
    let closer: bool = mf == 0 && be > 1
    let even: bool = m % 2 == 0

    if e2 >= 0 {
        bn_set_u64(&num, m)
        if closer {
            bn_shl(&num, (e2 + 2) as usize)
            bn_set_u64(&the, 4)
            bn_set_u64(&mp, 1)
            bn_shl(&mp, (e2 + 1) as usize)
            bn_set_u64(&mm, 1)
            bn_shl(&mm, e2 as usize)
        } else {
            bn_shl(&num, (e2 + 1) as usize)
            bn_set_u64(&the, 2)
            bn_set_u64(&mp, 1)
            bn_shl(&mp, e2 as usize)
            bn_set_u64(&mm, 1)
            bn_shl(&mm, e2 as usize)
        }
    } else {
        bn_set_u64(&num, m)
        if closer {
            bn_shl(&num, 2)
            bn_set_u64(&the, 1)
            bn_shl(&the, (2 - e2) as usize)
            bn_set_u64(&mp, 2)
            bn_set_u64(&mm, 1)
        } else {
            bn_shl(&num, 1)
            bn_set_u64(&the, 1)
            bn_shl(&the, (1 - e2) as usize)
            bn_set_u64(&mp, 1)
            bn_set_u64(&mm, 1)
        }
    }

    var k: i64 = dtoa_est_k(u64_bitlen(m), e2)
    if k >= 0 {
        bn_mul_pow10(&the, k as usize)
    } else {
        let sc: usize = (0 - k) as usize
        bn_mul_pow10(&num, sc)
        bn_mul_pow10(&mp, sc)
        bn_mul_pow10(&mm, sc)
    }

    // Correction upwards: num + mp has to stay below the denominator.
    var fixed: bool = false
    while !fixed {
        bn_copy(&t1, &num)
        bn_add(&t1, &mp)
        let c: i32 = bn_cmp(&t1, &the)
        var too_big: bool = c > 0
        if even && c == 0 {
            too_big = true
        }
        if too_big {
            bn_mul_small(&the, 10 as u32)
            k = k + 1
        } else {
            fixed = true
        }
    }
    // Correction downwards: the leading digit must not be 0.
    fixed = false
    while !fixed {
        bn_copy(&t1, &num)
        bn_add(&t1, &mp)
        bn_mul_small(&t1, 10 as u32)
        let c: i32 = bn_cmp(&t1, &the)
        var too_small: bool = c < 0
        if even && c == 0 {
            too_small = true
        }
        if too_small {
            bn_mul_small(&num, 10 as u32)
            bn_mul_small(&mp, 10 as u32)
            bn_mul_small(&mm, 10 as u32)
            k = k - 1
        } else {
            fixed = true
        }
    }
    // Produce digits until the value is pinned down uniquely.
    var n: usize = 0
    var run: bool = true
    while run {
        bn_mul_small(&num, 10 as u32)
        bn_mul_small(&mp, 10 as u32)
        bn_mul_small(&mm, 10 as u32)
        var dg: u32 = bn_div_digit(&num, &the)

        let cl: i32 = bn_cmp(&num, &mm)
        var low: bool = cl < 0
        if even && cl == 0 {
            low = true
        }
        bn_copy(&t2, &num)
        bn_add(&t2, &mp)
        let ch: i32 = bn_cmp(&t2, &the)
        var high: bool = ch > 0
        if even && ch == 0 {
            high = true
        }

        if !low && !high {
            st8(digits, n, (48 as u32 + dg) as u8)
            n = n + 1
        } else {
            var on: bool = false
            if low && high {
                // Both bounds allow a digit: the one closer to the value
                // wins. At EXACTLY equal distance ECMAScript
                // (6.1.6.1.20, item 5) takes the larger one -- hence
                // `>=` and not `>`.
                bn_copy(&t2, &num)
                bn_shl(&t2, 1)
                if bn_cmp(&t2, &the) >= 0 {
                    on = true
                }
            } else if high {
                on = true
            }
            if on {
                dg = dg + 1 as u32
            }
            st8(digits, n, (48 as u32 + dg) as u8)
            n = n + 1
            run = false
        }
        if n >= 20 {
            run = false
        }
    }

    // Carry: the rounded up digit can become 10 (classically at 1e23).
    // It then carries forward; if every digit overflows, the result is a
    // plain power of ten.
    var pos: usize = n
    var carry: bool = true
    while carry && pos > 0 {
        pos = pos - 1
        if ld8(digits, pos) > 57 as u8 {
            st8(digits, pos, 48 as u8)
            if pos > 0 {
                st8(digits, pos - 1, ld8(digits, pos - 1) + 1 as u8)
            }
        } else {
            carry = false
        }
    }
    if carry {
        st8(digits, 0, 49 as u8)
        n = 1
        k = k + 1
    }
    // trailing zeros are not part of the shortest representation
    while n > 1 && ld8(digits, n - 1) == 48 as u8 {
        n = n - 1
    }
    *k10 = k
    return n
}

fn dtoa_push_digits(out: *mut Bytes, digits: *mut u8, of: usize, to: usize) {
    var i: usize = of
    while i < to {
        bytes_push(out, ld8(digits, i))
        i = i + 1
    }
}

fn dtoa_push_zeros(out: *mut Bytes, n: i64) {
    var i: i64 = 0
    while i < n {
        bytes_push(out, 48 as u8)
        i = i + 1
    }
}

fn dtoa_push_int(out: *mut Bytes, v: i64) {
    var x: u64 = v as u64
    if v < 0 {
        bytes_push(out, 45 as u8)
        x = (0 - v) as u64
    }
    var buf: [u8; 24] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8]
    var n: usize = 0
    if x == 0 {
        buf[0] = 48 as u8
        n = 1
    }
    while x > 0 {
        buf[n] = (48 + x % 10) as u8
        x = x / 10
        n = n + 1
    }
    while n > 0 {
        n = n - 1
        bytes_push(out, buf[n])
    }
}

// The complete text output following the ECMAScript rules.
fn dtoa(bits: u64, out: *mut Bytes, ws: *mut u8) {
    bytes_clear(out)
    if dtoa_is_nan(bits) {
        bytes_push(out, 78 as u8) // N
        bytes_push(out, 97 as u8) // a
        bytes_push(out, 78 as u8) // N
        return
    }
    if dtoa_sign(bits) && !dtoa_is_zero(bits) {
        bytes_push(out, 45 as u8) // -
    }
    if dtoa_is_inf(bits) {
        bytes_push(out, 73 as u8) // I
        bytes_push(out, 110 as u8)
        bytes_push(out, 102 as u8)
        bytes_push(out, 105 as u8)
        bytes_push(out, 110 as u8)
        bytes_push(out, 105 as u8)
        bytes_push(out, 116 as u8)
        bytes_push(out, 121 as u8)
        return
    }
    if dtoa_is_zero(bits) {
        bytes_push(out, 48 as u8) // ECMAScript: even -0 becomes "0"
        return
    }
    var digits: [u8; 32] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8]
    var n10: i64 = 0
    let k: usize = dtoa_digits(bits, &digits[0], &n10, ws)
    dtoa_write(out, &digits[0], k, n10)
}

// ROUND 71 -- the text output following the ECMAScript rules, for a digit
// string that somebody else produced.
//
// It stood inside `dtoa` up to round 71 and had to come out: `ftoa32`
// (lib/num/f32_text.fi) shortens the digits of the widened double until the
// text reads back as the SAME binary32, and then it wants exactly this
// formatting -- one set of rules for both widths, not two that drift apart.
fn dtoa_write(out: *mut Bytes, digits: *mut u8, k: usize, n10: i64) {
    let ki: i64 = k as i64
    if ki <= n10 && n10 <= 21 {
        dtoa_push_digits(out, digits, 0, k)
        dtoa_push_zeros(out, n10 - ki)
    } else if 0 < n10 && n10 <= 21 {
        dtoa_push_digits(out, digits, 0, n10 as usize)
        bytes_push(out, 46 as u8)
        dtoa_push_digits(out, digits, n10 as usize, k)
    } else if -6 < n10 && n10 <= 0 {
        bytes_push(out, 48 as u8)
        bytes_push(out, 46 as u8)
        dtoa_push_zeros(out, 0 - n10)
        dtoa_push_digits(out, digits, 0, k)
    } else {
        dtoa_push_digits(out, digits, 0, 1)
        if k > 1 {
            bytes_push(out, 46 as u8)
            dtoa_push_digits(out, digits, 1, k)
        }
        bytes_push(out, 101 as u8) // e
        if n10 - 1 >= 0 {
            bytes_push(out, 43 as u8)
        }
        dtoa_push_int(out, n10 - 1)
    }
}

// lib/num/strtod.fi -- text -> IEEE-754 double precision, CORRECTLY ROUNDED
// (SPEC 8.4, requirement Z5).
//
// Stage 0 has no floating point type (yet); `strtod` therefore returns the
// BIT PATTERN of the double as a `u64`. That is no shortcut: the whole
// computation runs in integer arithmetic anyway, and `dtoa` works on the
// same bit pattern. As soon as the language has `f64`, a thin wrapper goes
// on top (see ACCEPTANCE.md, section str).
//
// Method: exact big number arithmetic. The value is held as a fraction
// of two big integers, D * 10^exp, scaled so that the quotient has exactly
// 53 bit, and from the remainder it is rounded to the nearest double -- at
// exactly half distance towards the EVEN mantissa. The result is therefore
// the correctly rounded one for EVERY input, including 2.2250738585072011e-308,
// 9007199254740993 and 5e-324.
//
// The form it recognizes:  [+-] digits [ . digits ] [ (e|E) [+-] digits ]
// Deliberately not recognized (the calling layer's job): "Infinity", "NaN",
// hexadecimal floating point, leading whitespace.
//
// Include:  //#include lib/num/strtod.fi  (needs alloc.fi, bignum.fi)

const D_INF_BITS: u64 = 0x7FF0000000000000
const D_SIGN_BIT: u64 = 0x8000000000000000
const D_TWO52: u64 = 4503599627370496
const D_TWO53: u64 = 9007199254740992
const D_MAXDIG: usize = 780 // significant digits, a sticky bit after them
const STRTOD_WS_BYTES: usize = 6 * 512 * 4

// ROUND 73: renamed from `is_digit`. `lib/std/core.fi` puts this file
// and the text facade into ONE module, and the facade has an
// `is_digit` of its own (lib/str/core_facade.fi). Two functions of the
// same name would be a compile error -- and of the two names this one
// is the one that only strtod uses.
fn strtod_digit(c: u8) -> bool {
    return c >= 48 as u8 && c <= 57 as u8
}

fn u64_bitlen(v: u64) -> usize {
    var x: u64 = v
    var n: usize = 0
    while x != 0 {
        x = x >> 1
        n = n + 1
    }
    return n
}

// The quotient of 2^s * num0 / den0; the remainder stays in `numw`, the
// scaled denominator in `denw` (the rounding afterwards needs both).
fn strtod_quot(num0: *mut Bn, den0: *mut Bn, numw: *mut Bn, denw: *mut Bn, tmp: *mut Bn, s: i64) -> u64 {
    bn_copy(numw, num0)
    bn_copy(denw, den0)
    if s >= 0 {
        bn_shl(numw, s as usize)
    } else {
        bn_shl(denw, (0 - s) as usize)
    }
    return bn_div_q(numw, denw, tmp)
}

// ====================================================================
// ROUND 87 -- THE SHORT WAY, for the numbers that a real document carries
// ====================================================================
//
// WHAT WAS WRONG. The path above is exact for every input, and it is the
// ONLY path: `1.5` goes through the same big number arithmetic as
// `2.2250738585072011e-308`. Every single digit costs a `bn_mul_small` plus
// a `bn_add_small` over a big integer, and after that comes a big number
// division. Measured in round 81: a JSON document with floats reads at
// 1.4 MiB/s, the same document with integers at 11.7 MiB/s -- a factor of
// eight, and the float reader was named as the reason without being
// measured.
//
// WHAT IS NEW. A number whose significant digits fit into a `u64` (at most
// nineteen) and whose decimal exponent lies between -27 and +27 can be
// converted with FIXED WIDTH integer arithmetic, exactly and without a
// single allocation:
//
//   exponent >= 0:  w * 10^q = (w * 5^q) * 2^q. `5^q` fits into a `u64` up
//       to q = 27, the product `w * 5^q` into 128 bits. The product is
//       EXACT, so the rounding to 53 bits sees every discarded bit and is
//       the correctly rounded one -- there is nothing to estimate.
//
//   exponent < 0:   w / 10^m = (w / 5^m) * 2^-m. `w` is shifted left far
//       enough for the quotient to have 64 bits, and the 128-by-64
//       division yields quotient AND remainder. The remainder is the sticky
//       bit, so this rounding is exact as well.
//
// So this is NOT Eisel/Lemire's method, although it comes from the same
// place. Eisel/Lemire multiply by a 128 bit APPROXIMATION of the power of
// ten out of a table of 651 entries and need a check for the ambiguous
// case, because the approximation can land exactly on a rounding boundary.
// Firn has no global variables (SPEC 2, item 5), so a table of 1,302
// constants would have to be built at run time or unrolled into a
// generated function -- and neither is worth it: within +-27 the power of
// five is EXACT in 64 bits, and an exact factor needs no ambiguity check
// at all. Outside that range, and for more than nineteen digits, the exact
// path above takes over unchanged. It stays the only answer for the hard
// cases, and it stays the one the acceptance measures.

const D_TWO63: u64 = 9223372036854775808

// 64 x 64 -> 128. `hi` receives the upper half, the lower one is returned.
// Four 32 bit products; the language has no 128 bit type and needs none.
fn mul64(a: u64, b: u64, hi: *mut u64) -> u64 {
    let mask: u64 = 4294967295
    let al: u64 = a & mask
    let ah: u64 = a >> 32
    let bl: u64 = b & mask
    let bh: u64 = b >> 32
    let ll: u64 = al * bl
    let lh: u64 = al * bh
    let hl: u64 = ah * bl
    let hh: u64 = ah * bh
    let mid: u64 = (ll >> 32) + (lh & mask) + (hl & mask)
    *hi = hh + (lh >> 32) + (hl >> 32) + (mid >> 32)
    return (ll & mask) | (mid << 32)
}

fn bitlen128(hi: u64, lo: u64) -> usize {
    if hi != 0 {
        return 64 + u64_bitlen(hi)
    }
    return u64_bitlen(lo)
}

// The lower 64 bits of (hi,lo) >> s. Used only where the result is known to
// fit into 64 bits.
fn shr128_lo(hi: u64, lo: u64, s: usize) -> u64 {
    if s == 0 {
        return lo
    }
    if s < 64 {
        return (lo >> s) | (hi << (64 - s))
    }
    if s < 128 {
        return hi >> (s - 64)
    }
    return 0
}

fn bit128(hi: u64, lo: u64, i: usize) -> u64 {
    if i < 64 {
        return (lo >> i) & 1
    }
    if i < 128 {
        return (hi >> (i - 64)) & 1
    }
    return 0
}

// Is any of the bits 0 .. k-1 set?
fn low128_any(hi: u64, lo: u64, k: usize) -> bool {
    if k == 0 {
        return false
    }
    if k < 64 {
        return (lo & (((1 as u64) << k) - 1)) != 0
    }
    if k == 64 {
        return lo != 0
    }
    if lo != 0 {
        return true
    }
    let j: usize = k - 64
    if j >= 64 {
        return hi != 0
    }
    return (hi & (((1 as u64) << j) - 1)) != 0
}

// (nhi,nlo) / d, with the remainder in `rem`. REQUIRES nhi < d, which makes
// the quotient fit into 64 bits.
//
// Bit by bit, sixty-four steps. Knuth's two-limb algorithm would be about
// four times as short, but it needs the wrap-around of the unsigned
// subtraction in three places, and this file is not the place to depend on
// that -- round 83 is putting checked arithmetic into the language next
// door. Every step here stays inside the range: the only difficult case is
// `r >= 2^63`, where doubling would overflow, and there `2r + bit - d` is
// written as `r - (d - r) + bit`, which is non-negative because d - r < 2^63
// <= r.
fn div128(nhi: u64, nlo: u64, d: u64, rem: *mut u64) -> u64 {
    var r: u64 = nhi
    var q: u64 = 0
    var i: usize = 0
    while i < 64 {
        let bit: u64 = (nlo >> (63 - i)) & 1
        if r >= D_TWO63 {
            // 2r >= 2^64 > d, so the subtraction always happens
            r = r - (d - r) + bit
            q = (q << 1) | 1
        } else {
            let r2: u64 = (r << 1) | bit
            if r2 >= d {
                r = r2 - d
                q = (q << 1) | 1
            } else {
                r = r2
                q = q << 1
            }
        }
        i = i + 1
    }
    *rem = r
    return q
}

fn pow5_u64(m: usize) -> u64 {
    var v: u64 = 1
    var i: usize = 0
    while i < m {
        v = v * 5
        i = i + 1
    }
    return v
}

// (hi,lo) * 2^e2, plus something smaller than one unit in the last place if
// `sticky`, rounded to 53 bits. `ok` stays false when the result is not a
// NORMAL double -- overflow and the subnormal range go the exact way, they
// are rare and they are where the difficult cases live.
fn strtod_pack(hi: u64, lo: u64, e2in: i64, sticky: bool, odd: bool, ok: *mut bool) -> u64 {
    *ok = false
    let bl: usize = bitlen128(hi, lo)
    if bl == 0 {
        return 0
    }
    var q: u64 = 0
    var e2: i64 = e2in
    if bl <= 53 {
        // exact, nothing is discarded
        let sh: usize = 53 - bl
        q = lo << sh
        e2 = e2 - sh as i64
        if sticky && odd {
            q = q | 1
        }
    } else {
        let sh: usize = bl - 53
        q = shr128_lo(hi, lo, sh)
        e2 = e2 + sh as i64
        let half: u64 = bit128(hi, lo, sh - 1)
        let rest: bool = low128_any(hi, lo, sh - 1) || sticky
        if odd {
            if half != 0 || rest {
                q = q | 1
            }
        } else {
            var up: bool = false
            if half != 0 {
                if rest {
                    up = true
                } else if q % 2 == 1 {
                    up = true
                }
            }
            if up {
                q = q + 1
                if q == D_TWO53 {
                    q = D_TWO52
                    e2 = e2 + 1
                }
            }
        }
    }
    if e2 > 971 || e2 < -1074 {
        return 0
    }
    if q < D_TWO52 {
        return 0 // subnormal -- the exact path
    }
    let biased: i64 = e2 + 1075
    if biased < 1 || biased > 2046 {
        return 0
    }
    *ok = true
    return ((biased as u64) << 52) + (q - D_TWO52)
}

// w * 10^q10 as a bit pattern, without the sign. `ok` stays false when this
// way does not apply.
fn strtod_fast(w: u64, q10: i64, odd: bool, ok: *mut bool) -> u64 {
    *ok = false
    if w == 0 {
        return 0
    }
    if q10 > 27 || q10 < -27 {
        return 0
    }
    if q10 >= 0 {
        let d5: u64 = pow5_u64(q10 as usize)
        var hi: u64 = 0
        let lo: u64 = mul64(w, d5, &hi)
        return strtod_pack(hi, lo, q10, false, odd, ok)
    }
    let m: usize = (0 - q10) as usize
    let d5: u64 = pow5_u64(m)
    let bl: usize = u64_bitlen(w)
    let bd: usize = u64_bitlen(d5)
    // w << s, with s chosen so that the quotient has just under 64 bits and
    // is guaranteed to fit into one: w * 2^s < 2^(bd+63) < d5 * 2^64.
    let s: usize = 63 + bd - bl
    var nhi: u64 = 0
    var nlo: u64 = 0
    if s == 0 {
        nlo = w
    } else if s < 64 {
        nhi = w >> (64 - s)
        nlo = w << s
    } else {
        nhi = w << (s - 64)
    }
    var r: u64 = 0
    let qq: u64 = div128(nhi, nlo, d5, &r)
    return strtod_pack(0, qq, q10 - s as i64, r != 0, odd, ok)
}

// The cheap pre-scan. Mirrors the parse of `strtod_mode` EXACTLY, but keeps
// the digits in a `u64` instead of a big integer, and gives up the moment
// anything unusual turns up -- more than nineteen significant digits, no
// number at all. `false` costs nothing: the exact path parses again from
// the beginning and sets `consumed` itself.
fn strtod_scan(p: *mut u8, len: usize, wout: *mut u64, qout: *mut i64,
    negout: *mut bool, consumed: *mut usize) -> bool {
    var i: usize = 0
    var neg: bool = false
    if i < len {
        let c0: u8 = ld8(p, i)
        if c0 == 43 as u8 {
            i = i + 1
        } else if c0 == 45 as u8 {
            neg = true
            i = i + 1
        }
    }
    var w: u64 = 0
    var nsig: usize = 0
    var exp: i64 = 0
    var any: bool = false
    var stop: bool = false
    while i < len && !stop {
        let c: u8 = ld8(p, i)
        if strtod_digit(c) {
            any = true
            let dig: u64 = (c - 48 as u8) as u64
            if w != 0 || dig != 0 {
                if nsig >= 19 {
                    return false
                }
                w = w * 10 + dig
                nsig = nsig + 1
            }
            i = i + 1
        } else {
            stop = true
        }
    }
    if i < len {
        if ld8(p, i) == 46 as u8 {
            var j: usize = i + 1
            var fany: bool = false
            stop = false
            while j < len && !stop {
                let c: u8 = ld8(p, j)
                if strtod_digit(c) {
                    fany = true
                    let dig: u64 = (c - 48 as u8) as u64
                    if w == 0 && dig == 0 {
                        exp = exp - 1
                    } else {
                        if nsig >= 19 {
                            return false
                        }
                        w = w * 10 + dig
                        nsig = nsig + 1
                        exp = exp - 1
                    }
                    j = j + 1
                } else {
                    stop = true
                }
            }
            if any || fany {
                any = true
                i = j
            }
        }
    }
    if !any {
        return false
    }
    if i < len {
        let ec: u8 = ld8(p, i)
        if ec == 101 as u8 || ec == 69 as u8 {
            var j: usize = i + 1
            var eneg: bool = false
            if j < len {
                let sc: u8 = ld8(p, j)
                if sc == 43 as u8 {
                    j = j + 1
                } else if sc == 45 as u8 {
                    eneg = true
                    j = j + 1
                }
            }
            var eany: bool = false
            var ev: i64 = 0
            stop = false
            while j < len && !stop {
                let c: u8 = ld8(p, j)
                if strtod_digit(c) {
                    eany = true
                    if ev < 1000000 {
                        ev = ev * 10 + (c - 48 as u8) as i64
                    }
                    j = j + 1
                } else {
                    stop = true
                }
            }
            if eany {
                if eneg {
                    exp = exp - ev
                } else {
                    exp = exp + ev
                }
                i = j
            }
        }
    }
    *wout = w
    *qout = exp
    *negout = neg
    *consumed = i
    return true
}

// Text -> bit pattern. `consumed` receives the number of characters used up
// (0 = no valid number). `ws` needs STRTOD_WS_BYTES bytes.
// ROUND 71 -- `odd = true` rounds TO ODD instead of to nearest: cut off,
// and set the last bit when anything was left over.
//
// That is what makes a correct `f32` possible. The way decimal -> binary64
// (nearest) -> binary32 (nearest) is NOT correctly rounded: at the exact
// middle between two binary32 the intermediate rounding lands ON the middle,
// and the tie-to-even then decides without knowing which side the real value
// lay on. Measured against C `strtof`: 63568 of 239064 such cases came out
// one ulp wrong. With round-to-odd it cannot happen -- a value whose last
// bit is set is never exactly a binary32 middle (Boldo/Melquiond, 53 >= 24+2).
// ROUND 87 -- THE SHORT WAY AS A FRONT DOOR OF ITS OWN.
//
// `true` means: this number is done, `out` holds the bit pattern and
// `consumed` the characters used up. `false` means: nothing has happened,
// the exact path has to run.
//
// It is a front door because it needs NO WORKSPACE. `read_f64_bits` in
// lib/num/std_facade.fi used to fetch STRTOD_WS_BYTES = 12,288 octets from
// the operating system and give them back again FOR EVERY SINGLE NUMBER --
// and a JSON document with 60,000 floats therefore made 60,000 mmap/munmap
// pairs. That was the larger half of the cost, and no arithmetic in the
// world would have fixed it.
fn strtod_short(p: *mut u8, len: usize, consumed: *mut usize, odd: bool, out: *mut u64) -> bool {
    *consumed = 0
    *out = 0
    var fw: u64 = 0
    var fq: i64 = 0
    var fneg: bool = false
    var fcons: usize = 0
    if !strtod_scan(p, len, &fw, &fq, &fneg, &fcons) {
        return false
    }
    if fw == 0 {
        *consumed = fcons
        if fneg {
            *out = D_SIGN_BIT
        }
        return true
    }
    var fok: bool = false
    let fbits: u64 = strtod_fast(fw, fq, odd, &fok)
    if !fok {
        return false
    }
    *consumed = fcons
    if fneg {
        *out = D_SIGN_BIT + fbits
    } else {
        *out = fbits
    }
    return true
}

fn strtod_mode(p: *mut u8, len: usize, ws: *mut u8, consumed: *mut usize, odd: bool) -> u64 {
    *consumed = 0
    // The short way first. It answers or it does not; when it does not,
    // nothing below it has happened yet -- not even the workspace has been
    // touched.
    var sbits: u64 = 0
    if strtod_short(p, len, consumed, odd, &sbits) {
        return sbits
    }
    *consumed = 0
    var d: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    var num0: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    var den0: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    var numw: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    var denw: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    var tmp: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    let stride: usize = BN_LIMBS * 4
    bn_init(&d, ws, BN_LIMBS)
    bn_init(&num0, (ws as usize + stride) as *mut u8, BN_LIMBS)
    bn_init(&den0, (ws as usize + stride * 2) as *mut u8, BN_LIMBS)
    bn_init(&numw, (ws as usize + stride * 3) as *mut u8, BN_LIMBS)
    bn_init(&denw, (ws as usize + stride * 4) as *mut u8, BN_LIMBS)
    bn_init(&tmp, (ws as usize + stride * 5) as *mut u8, BN_LIMBS)

    var i: usize = 0
    var neg: bool = false
    if i < len {
        let c0: u8 = ld8(p, i)
        if c0 == 43 as u8 {
            i = i + 1
        } else if c0 == 45 as u8 {
            neg = true
            i = i + 1
        }
    }
    var nsig: usize = 0
    var exp: i64 = 0
    var sticky: bool = false
    var any: bool = false
    var stop: bool = false

    // --- the digits before the point ---
    while i < len && !stop {
        let c: u8 = ld8(p, i)
        if strtod_digit(c) {
            any = true
            let dig: u32 = (c - 48 as u8) as u32
            if bn_is_zero(&d) && dig == 0 as u32 {
                stop = false
            } else if nsig < D_MAXDIG {
                bn_mul_small(&d, 10 as u32)
                bn_add_small(&d, dig)
                nsig = nsig + 1
            } else {
                exp = exp + 1
                if dig != 0 as u32 {
                    sticky = true
                }
            }
            i = i + 1
        } else {
            stop = true
        }
    }

    // --- the digits after the point ---
    if i < len {
        if ld8(p, i) == 46 as u8 {
            var j: usize = i + 1
            var fany: bool = false
            stop = false
            while j < len && !stop {
                let c: u8 = ld8(p, j)
                if strtod_digit(c) {
                    fany = true
                    let dig: u32 = (c - 48 as u8) as u32
                    if bn_is_zero(&d) && dig == 0 as u32 {
                        exp = exp - 1
                    } else if nsig < D_MAXDIG {
                        bn_mul_small(&d, 10 as u32)
                        bn_add_small(&d, dig)
                        nsig = nsig + 1
                        exp = exp - 1
                    } else {
                        if dig != 0 as u32 {
                            sticky = true
                        }
                    }
                    j = j + 1
                } else {
                    stop = true
                }
            }
            if any || fany {
                any = true
                i = j
            }
        }
    }

    if !any {
        return 0
    }

    // --- exponent ---
    if i < len {
        let ec: u8 = ld8(p, i)
        if ec == 101 as u8 || ec == 69 as u8 {
            var j: usize = i + 1
            var eneg: bool = false
            if j < len {
                let sc: u8 = ld8(p, j)
                if sc == 43 as u8 {
                    j = j + 1
                } else if sc == 45 as u8 {
                    eneg = true
                    j = j + 1
                }
            }
            var eany: bool = false
            var ev: i64 = 0
            stop = false
            while j < len && !stop {
                let c: u8 = ld8(p, j)
                if strtod_digit(c) {
                    eany = true
                    if ev < 1000000 {
                        ev = ev * 10 + (c - 48 as u8) as i64
                    }
                    j = j + 1
                } else {
                    stop = true
                }
            }
            if eany {
                if eneg {
                    exp = exp - ev
                } else {
                    exp = exp + ev
                }
                i = j
            }
        }
    }
    *consumed = i

    var sign: u64 = 0
    if neg {
        sign = D_SIGN_BIT
    }

    // Digits that were cut off: a sticky bit below the last place makes sure
    // that an exact half step never turns into a wrong rounding.
    if sticky {
        bn_mul_small(&d, 10 as u32)
        bn_add_small(&d, 1 as u32)
        exp = exp - 1
    }
    if bn_is_zero(&d) {
        return sign
    }

    // Rough range: 10^(mag-1) <= |value| < 10^mag
    let likes: i64 = exp + nsig as i64
    if likes - 1 >= 309 {
        return sign + D_INF_BITS
    }
    if likes <= -400 {
        return sign
    }

    bn_copy(&num0, &d)
    bn_set_u64(&den0, 1)
    if exp > 0 {
        bn_mul_pow10(&num0, exp as usize)
    } else if exp < 0 {
        bn_mul_pow10(&den0, (0 - exp) as usize)
    }

    // Scale until the quotient has exactly 53 bit.
    var s: i64 = 53 - (bn_bitlen(&num0) as i64 - bn_bitlen(&den0) as i64)
    var q: u64 = 0
    var done: bool = false
    var iter: usize = 0
    while !done && iter < 6 {
        q = strtod_quot(&num0, &den0, &numw, &denw, &tmp, s)
        let qb: i64 = u64_bitlen(q) as i64
        if qb == 53 {
            done = true
        } else {
            s = s + (53 - qb)
        }
        iter = iter + 1
    }
    var e2: i64 = 0 - s
    if e2 < -1074 {
        s = 1074
        e2 = -1074
        q = strtod_quot(&num0, &den0, &numw, &denw, &tmp, s)
    }

    // ROUND 71: round to odd, if that is what was asked for.
    if odd {
        if !bn_is_zero(&numw) {
            q = q | 1
        }
        if e2 > 971 {
            return sign + D_INF_BITS
        }
        if q == 0 {
            return sign
        }
        if q >= D_TWO52 {
            let biased_o: u64 = (e2 + 1075) as u64
            return sign + (biased_o << 52) + (q - D_TWO52)
        }
        return sign + q
    }
    // Round: the remainder (numw) against half the denominator (denw).
    bn_shl(&numw, 1)
    let cv: i32 = bn_cmp(&numw, &denw)
    var up: bool = false
    if cv > 0 {
        up = true
    } else if cv == 0 {
        if q % 2 == 1 {
            up = true
        }
    }
    if up {
        q = q + 1
        if q == D_TWO53 {
            q = D_TWO52
            e2 = e2 + 1
        }
    }
    if e2 > 971 {
        return sign + D_INF_BITS
    }
    if q == 0 {
        return sign
    }
    var bits: u64 = 0
    if q >= D_TWO52 {
        let biased: u64 = (e2 + 1075) as u64
        bits = (biased << 52) + (q - D_TWO52)
    } else {
        bits = q
    }
    return sign + bits
}

// The two front doors: `strtod` rounds to nearest (the correctly rounded
// binary64), `strtod_odd` rounds to odd -- the intermediate value from which
// a correct binary32 comes out with ONE further rounding.
fn strtod(p: *mut u8, len: usize, ws: *mut u8, consumed: *mut usize) -> u64 {
    return strtod_mode(p, len, ws, consumed, false)
}

fn strtod_odd(p: *mut u8, len: usize, ws: *mut u8, consumed: *mut usize) -> u64 {
    return strtod_mode(p, len, ws, consumed, true)
}

// lib/num/f32_text.fi -- binary32 -> the SHORTEST decimal text that reads
// back (round 71).
//
// WHY THIS FILE EXISTS. `dtoa` produces the shortest text for a binary64.
// For an `f32` that is not enough: 0.1f widened to a double is
// 0.100000001490116119384765625, and the shortest text for THAT double is
// "0.10000000149011612" -- seventeen digits where one would do. The
// round-trip guarantee of `f32` is a different one, and a weaker one: the
// text only has to lead back to the same FOUR octets.
//
// THE PROCEDURE, and why it is provably right:
//
//   1. Widen the value to a binary64. That is exact -- every binary32 is a
//      binary64.
//   2. Let `dtoa_digits` produce the shortest digit string D of that
//      double. D reads back exactly to the double, hence exactly to the
//      f32.
//   3. Shorten: for p = 1, 2, 3, ... take the first p digits of D, once cut
//      off and once rounded up, and CHECK each candidate -- read it with
//      the correctly rounded `strtod`, narrow to binary32, compare the
//      octets. The first candidate that matches wins.
//
// The check is what makes the whole thing safe. Whatever comes out of here
// has been read back once and has led to the same value; there is no case
// distinction that could be forgotten. Nine significant digits always
// suffice for a binary32, so the loop terminates long before D runs out.
//
// The check reads with `strtod_odd` and narrows once -- the CORRECT way
// (lib/num/core_facade.fi). Reading with `strtod` and narrowing afterwards
// would be the double rounding that this round found, and the check would
// then bless texts that no other reader accepts.
//
// Include:  //#include lib/num/f32_text.fi
//           (needs bignum, dtoa, strtod, core_bits, core_facade)

// The digits of one candidate. Nine are always enough for a binary32; the
// two extra places carry the overflow of "999 -> 1000".
const F32A_MAX: usize = 12

// Cut the digit string `src` (length `n`) to `p` places, once downwards
// (`up = false`) and once upwards (`up = true`). The exponent may move by
// one when 9...9 turns into 10...0; that is what `k10` is for.
//
// Returns the number of digits really written (`p`, or 1 after an
// overflow).
#[allow_fp]
fn f32a_cut(src: *mut u8, n: usize, p: usize, up: bool, dst: *mut u8, k10: *mut i64) -> usize {
    var i: usize = 0
    while i < p {
        var d: u8 = 48 as u8
        if i < n {
            d = ld8(src, i)
        }
        st8(dst, i, d)
        i = i + 1
    }
    if !up {
        return p
    }
    // Round up: increment the last place, carry to the left.
    var j: usize = p
    while j > 0 {
        j = j - 1
        let d2: u8 = ld8(dst, j)
        if d2 < 57 as u8 {
            st8(dst, j, d2 + 1 as u8)
            return p
        }
        st8(dst, j, 48 as u8)
    }
    // Everything was a nine: 999 -> 1000, and one digit is enough for that.
    st8(dst, 0, 49 as u8)
    *k10 = *k10 + 1
    return 1
}

// Is rounding UP the closer of the two candidates?
//
// The digits after the cut decide, exactly as in any correct rounding:
// above a half upwards, below a half downwards, at exactly a half towards
// the EVEN last digit. Without this the shortest text would be right but
// not the nearest one -- 3.4028234e+38 and 3.4028235e+38 both read back as
// the largest binary32, and only the second is the one every other
// implementation prints.
#[allow_fp]
fn f32a_up(src: *mut u8, n: usize, p: usize) -> bool {
    if p >= n {
        return false
    }
    let d: u8 = ld8(src, p)
    if d > 53 as u8 {
        return true
    }
    if d < 53 as u8 {
        return false
    }
    // exactly 5: is anything else behind it?
    var i: usize = p + 1
    while i < n {
        if ld8(src, i) != 48 as u8 {
            return true
        }
        i = i + 1
    }
    // a true half -- towards the even digit
    var last: u8 = 48 as u8
    if p > 0 {
        last = ld8(src, p - 1)
    }
    return (last - 48 as u8) % 2 as u8 == 1 as u8
}

// Does the candidate read back as exactly this binary32?
//
// The text is built in the plainest form there is -- digits, `e`, exponent
// -- because `strtod` reads that and nothing about the formatting may
// influence the decision.
#[allow_fp]
fn f32a_holds(bits: u32, dig: *mut u8, p: usize, k10: i64, sws: *mut u8) -> bool {
    var probe: Bytes = Bytes { ptr: 0 as *mut u8, len: 0, cap: 0 }
    var i: usize = 0
    while i < p {
        bytes_push(&probe, ld8(dig, i))
        i = i + 1
    }
    bytes_push(&probe, 101 as u8) // e
    dtoa_push_int(&probe, k10 - p as i64)
    var used: usize = 0
    // The CORRECT way back (round 71): round to odd in between, then narrow
    // once. Reading with `strtod` and narrowing afterwards would be the very
    // double rounding this round found -- and the check would then bless
    // candidates that no other reader accepts.
    let db: u64 = strtod_odd(probe.ptr, probe.len, sws, &used)
    bytes_free(&probe)
    if used == 0 {
        return false
    }
    let back: f32 = bits_f64(db) as f32
    return f32_bits(back) == bits
}

// The complete text output for a binary32, in the same shape as `dtoa`.
// `ws` is the scratch memory of `dtoa` (`dtoa_work_bytes()`), `sws` that of
// `strtod` (`strtod_work_bytes()`).
#[allow_fp]
fn ftoa32(bits: u32, out: *mut Bytes, ws: *mut u8, sws: *mut u8) {
    bytes_clear(out)
    if f32_bits_is_nan(bits) {
        bytes_push(out, 78 as u8) // N
        bytes_push(out, 97 as u8) // a
        bytes_push(out, 78 as u8) // N
        return
    }
    if f32_bits_sign(bits) && !f32_bits_is_zero(bits) {
        bytes_push(out, 45 as u8) // -
    }
    if f32_bits_is_inf(bits) {
        bytes_push(out, 73 as u8) // I
        bytes_push(out, 110 as u8)
        bytes_push(out, 102 as u8)
        bytes_push(out, 105 as u8)
        bytes_push(out, 110 as u8)
        bytes_push(out, 105 as u8)
        bytes_push(out, 116 as u8)
        bytes_push(out, 121 as u8)
        return
    }
    if f32_bits_is_zero(bits) {
        bytes_push(out, 48 as u8) // like `dtoa`: even -0 becomes "0"
        return
    }
    // 1. exactly widen and let `dtoa` produce the digits of the double.
    //    The SIGN has already been written; from here on only the magnitude
    //    counts -- the candidates carry no sign, and neither does the check.
    let mag: u32 = bits & 2147483647
    let wide: f64 = bits_f32(mag) as f64
    var digits: [u8; 32] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8]
    var n10: i64 = 0
    let k: usize = dtoa_digits(f64_bits(wide), &digits[0], &n10, ws)

    // 2. shorten, and check every candidate
    var cand: [u8; 12] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8]
    var p: usize = 1
    while p < k && p < F32A_MAX {
        // The NEARER candidate first: among texts of equal length the
        // correctly rounded one wins.
        let near: bool = f32a_up(&digits[0], k, p)
        var e1: i64 = n10
        let n1: usize = f32a_cut(&digits[0], k, p, near, &cand[0], &e1)
        if f32a_holds(mag, &cand[0], n1, e1, sws) {
            dtoa_write(out, &cand[0], n1, e1)
            return
        }
        var e2: i64 = n10
        let n2: usize = f32a_cut(&digits[0], k, p, !near, &cand[0], &e2)
        if f32a_holds(mag, &cand[0], n2, e2, sws) {
            dtoa_write(out, &cand[0], n2, e2)
            return
        }
        p = p + 1
    }
    // 3. nothing shorter held: the digits of the double read back in any
    //    case, because the double IS the f32.
    dtoa_write(out, &digits[0], k, n10)
}

// lib/num/std_facade.fi -- number <-> text for the std facade (round 42).
//
// ONLY for `lib/std/num.fi`: included exclusively by
// `tools/strlib/src/std_num.fi`. lib/num (bignum/dtoa/strtod) stays
// unchanged; whoever uses the include library without std gets not one
// byte more code.
//
// ONE RULE FOR THE DIRECTION, readable off every name:
//   * `write_*` takes a number and APPENDS its text to a `*mut Bytes`.
//     It never clears -- several calls build up one line.
//   * `read_*` takes text and delivers the number. The return value is the
//     number of octets USED UP (0 = there was no number there); the value
//     itself comes back through an output pointer. That lets the caller
//     read on where the number ends -- every parser needs that.
//   * `text_to_*` is the strict form: the WHOLE text has to be the number,
//     otherwise `false`. That is what you want when evaluating an argument.
//
// OVERFLOW IS REPORTED, not hushed up: the `read_*` forms carry an
// `overflow` output pointer, and the `text_to_*` forms then return
// `false`. In stage 0 Firn has no overflow check in its arithmetic
// (SPEC 14.1.3) -- when reading foreign input a silent wraparound would be
// a security hole, not a cosmetic flaw.
//
// Floating point runs through the exact cores this module already has:
// `dtoa` (the shortest text that reads back) and `strtod` (correctly
// rounded). All that is new is the wrapper around them: since round 30
// `f64` really exists, so the facade takes and returns `f64` instead of bit
// patterns. The bit pattern forms remain alongside.

// ------------------------------------------------------------------ Limits
//
// As functions, because `const` in stage 0 is evaluated as an integer (i64)
// and 2^64-1 is not representable there.

// ROUND 73: the reading half (digit tests, `read_*`, `text_to_*`, the bit
// pattern helpers of f64) moved to `lib/num/core_facade.fi` -- it needs no
// allocator and no system call and is therefore usable in the kernel
// profile. It is included here, so that `std.num` keeps offering
// everything it offered before.
// lib/num/core_facade.fi -- text -> number WITHOUT an allocator (round 73).
//
// The reading half of `lib/num/std_facade.fi`. Every function here writes
// into memory that the CALLER holds and asks nobody for a byte:
// `read_u64_base`, `read_i64`, `text_to_i64`, `digit_count`, the digit
// tests and the bit pattern helpers of `f64`. That is why the file is
// included by `lib/std/core.fi` (usable under `profile kernel`) as well as
// by `lib/std/num.fi` (the full facade) -- ONE source text, no second
// parser that could drift apart from the first.
//
// WHAT IS NOT HERE: everything that PRODUCES text (`write_*` appends to a
// `*mut Bytes`), and everything that reaches for scratch memory on its own.
//
// FLOATING POINT WITHOUT A HIDDEN mmap. `strtod` (lib/num/strtod.fi)
// computes in exact big number arithmetic and needs `strtod_work_bytes()`
// octets of scratch memory. The convenient form in `std.num` fetches them
// with `mmap` -- which is exactly what a kernel must not do. The `_at`
// forms here therefore take the scratch memory as a PARAMETER: at the call
// site you see that it costs memory, and you see whose memory it is.
//
//     var ws: [u8; 12288] = [0; 12288]      // core.strtod_work_bytes()
//     var x: f64 = 0.0
//     if core.text_to_f64_at(s.p, s.n, &ws[0], &x) { ... }
//
// `#[allow_fp]` sits on every function that touches an f64: in the kernel
// profile the FPU/SSE registers belong to the interrupted thread (SPEC 2),
// so whoever calls one of them takes over the duty to save their state.
// The integer part of this file -- and that is the bigger part -- carries
// no such marking and costs a kernel nothing.
//
// Include:  //#include lib/num/core_facade.fi  (needs core_mem.fi, strtod.fi)

fn u64_max() -> u64 {
    // ROUND 72: 0 - 1 on an UNSIGNED type is a well-known way to spell
    // "every bit set" (u64::MAX) without writing the 20-digit literal --
    // deliberate wraparound, not a mistake, so `-%` says so explicitly.
    var x: u64 = 0
    return x -% 1
}

fn i64_max() -> i64 {
    return 9223372036854775807
}

fn i64_min() -> i64 {
    return 0 - 9223372036854775807 - 1
}

// ---------------------------------------------------------- Number -> text

// The value of a digit in base <= 36, otherwise -1. Upper and lower case count alike.
fn digit_value(c: u8) -> i32 {
    if c >= 48 as u8 && c <= 57 as u8 {
        return (c - 48 as u8) as i32
    }
    if c >= 97 as u8 && c <= 122 as u8 {
        return (c - 97 as u8) as i32 + 10
    }
    if c >= 65 as u8 && c <= 90 as u8 {
        return (c - 65 as u8) as i32 + 10
    }
    return 0 - 1
}

// How many digits `v` needs in `base` (0 needs one).
fn digit_count(v: u64, base: u32) -> usize {
    if base < 2 || base > 36 {
        return 0
    }
    if v == 0 {
        return 1
    }
    let b: u64 = base as u64
    var x: u64 = v
    var n: usize = 0
    while x > 0 {
        x = x / b
        n = n + 1
    }
    return n
}

// ---------------------------------------------------------- Text -> number

// A digit sequence starting at `ab` in base 2..36. Return value: the number
// of octets used up (0 = no digit). `overflow` is set as soon as the value
// no longer fits in a u64; it keeps reading to the end of the digits anyway,
// so that the caller knows where the text continues.
fn read_u64_base(p: *mut u8, n: usize, ab: usize, base: u32, out: *mut u64,
    overflow: *mut bool) -> usize {
    *out = 0
    *overflow = false
    if base < 2 || base > 36 {
        return 0
    }
    let b: u64 = base as u64
    let limit: u64 = u64_max() / b
    let rest_limit: u64 = u64_max() - limit * b
    var w: u64 = 0
    var i: usize = ab
    var z: usize = 0
    while i < n {
        let d: i32 = digit_value(ld8(p, i))
        if d < 0 {
            i = n
        } else if (d as u32) >= base {
            i = n
        } else {
            if w > limit || (w == limit && (d as u64) > rest_limit) {
                *overflow = true
            }
            // ROUND 72: the doc comment above says it plainly --
            // AFTER the first overflow (*overflow already set to
            // true above) this keeps accumulating on purpose, only
            // to consume the rest of the digit run; the value itself
            // is already known-wrong at that point, so `*%`/`+%`
            // wrapping instead of panicking is the intended shape.
            w = (w *% b) +% (d as u64)
            z = z + 1
            i = i + 1
        }
    }
    *out = w
    return z
}

fn read_u64(p: *mut u8, n: usize, ab: usize, out: *mut u64,
    overflow: *mut bool) -> usize {
    return read_u64_base(p, n, ab, 10, out, overflow)
}

// With a sign. `+` and `-` are allowed, and at least one digit has to
// follow. The return value counts the sign.
fn read_i64(p: *mut u8, n: usize, ab: usize, out: *mut i64,
    overflow: *mut bool) -> usize {
    *out = 0
    *overflow = false
    var i: usize = ab
    var negative: bool = false
    if i < n {
        let c: u8 = ld8(p, i)
        if c == 45 as u8 {
            negative = true
            i = i + 1
        } else if c == 43 as u8 {
            i = i + 1
        }
    }
    var abs: u64 = 0
    var ue: bool = false
    let z: usize = read_u64_base(p, n, i, 10, &abs, &ue)
    if z == 0 {
        return 0
    }
    if ue {
        *overflow = true
    }
    if negative {
        if abs > 9223372036854775808 as u64 {
            *overflow = true
            *out = i64_min()
        } else if abs == 9223372036854775808 as u64 {
            *out = i64_min()
        } else {
            *out = 0 - (abs as i64)
        }
    } else {
        if abs > 9223372036854775807 as u64 {
            *overflow = true
            *out = i64_max()
        } else {
            *out = abs as i64
        }
    }
    return i - ab + z
}

// Strict: the whole text has to be the number, no whitespace, no leftovers.
fn text_to_u64_base(p: *mut u8, n: usize, base: u32, out: *mut u64) -> bool {
    var ue: bool = false
    let z: usize = read_u64_base(p, n, 0, base, out, &ue)
    return z == n && z > 0 && !ue
}

fn text_to_u64(p: *mut u8, n: usize, out: *mut u64) -> bool {
    return text_to_u64_base(p, n, 10, out)
}

fn text_to_i64(p: *mut u8, n: usize, out: *mut i64) -> bool {
    var ue: bool = false
    let z: usize = read_i64(p, n, 0, out, &ue)
    return z == n && z > 0 && !ue
}

// With a base prefix: 0x/0X = 16, 0b/0B = 2, 0o/0O = 8, otherwise 10.
// A lone "0" stays 0 (no special case for leading zeros -- those are
// decimal, as in every modern language).
fn text_to_u64_auto(p: *mut u8, n: usize, out: *mut u64) -> bool {
    if n >= 3 && ld8(p, 0) == 48 as u8 {
        let c: u8 = ld8(p, 1)
        if c == 120 as u8 || c == 88 as u8 {
            return text_to_u64_base((p as usize + 2) as *mut u8, n - 2, 16, out)
        }
        if c == 98 as u8 || c == 66 as u8 {
            return text_to_u64_base((p as usize + 2) as *mut u8, n - 2, 2, out)
        }
        if c == 111 as u8 || c == 79 as u8 {
            return text_to_u64_base((p as usize + 2) as *mut u8, n - 2, 8, out)
        }
    }
    return text_to_u64_base(p, n, 10, out)
}

// ---------------------------------------------------------- Floating point
//
// Reinterpreting the bit pattern through memory -- Firn has no
// reinterpretation operator, and `as` would be a VALUE conversion (1.0 as u64 = 1).

#[allow_fp]
fn f64_bits(x: f64) -> u64 {
    var t: f64 = x
    return *(((&t) as usize) as *mut u64)
}

#[allow_fp]
fn bits_f64(b: u64) -> f64 {
    var t: u64 = b
    return *(((&t) as usize) as *mut f64)
}

#[allow_fp]
fn f64_is_nan(x: f64) -> bool {
    return dtoa_is_nan(f64_bits(x))
}

#[allow_fp]
fn f64_is_infinite(x: f64) -> bool {
    return dtoa_is_inf(f64_bits(x))
}

#[allow_fp]
fn f64_is_null(x: f64) -> bool {
    return dtoa_is_zero(f64_bits(x))
}

// true = the sign bit is negative (for -0.0 as well).
#[allow_fp]
fn f64_sign(x: f64) -> bool {
    return dtoa_sign(f64_bits(x))
}

// ROUND 71 -- the same four questions for an `f32`, and the reinterpretation
// in both directions. `as` would be a VALUE conversion (1.0 as u32 = 1);
// what is wanted here are the four octets themselves.

#[allow_fp]
fn f32_bits(x: f32) -> u32 {
    var t: f32 = x
    return *(((&t) as usize) as *mut u32)
}

#[allow_fp]
fn bits_f32(b: u32) -> f32 {
    var t: u32 = b
    return *(((&t) as usize) as *mut f32)
}

#[allow_fp]
fn f32_is_nan(x: f32) -> bool {
    return f32_bits_is_nan(f32_bits(x))
}

#[allow_fp]
fn f32_is_infinite(x: f32) -> bool {
    return f32_bits_is_inf(f32_bits(x))
}

#[allow_fp]
fn f32_is_null(x: f32) -> bool {
    return f32_bits_is_zero(f32_bits(x))
}

// true = the sign bit is negative (for -0.0 as well).
#[allow_fp]
fn f32_sign(x: f32) -> bool {
    return f32_bits_sign(f32_bits(x))
}

fn strtod_work_bytes() -> usize {
    return STRTOD_WS_BYTES
}

// ---------------------------------------------- Floating point, text -> f64
//
// The same core (`strtod`, correctly rounded) that `std.num` uses -- only
// the scratch memory comes from outside. `ws` needs `strtod_work_bytes()`
// octets and may lie anywhere: on the stack, in an arena, in a kernel
// frame. Return value of the `read_` forms: the octets used up (0 = there
// was no number there).

fn read_f64_bits_at(p: *mut u8, n: usize, ws: *mut u8, out: *mut u64) -> usize {
    *out = 0
    if (ws as usize) == 0 {
        return 0
    }
    var consumed: usize = 0
    let bits: u64 = strtod(p, n, ws, &consumed)
    *out = bits
    return consumed
}

// Strict: the WHOLE text has to be the number.
fn text_to_f64_bits_at(p: *mut u8, n: usize, ws: *mut u8, out: *mut u64) -> bool {
    let z: usize = read_f64_bits_at(p, n, ws, out)
    return z == n && z > 0
}

#[allow_fp]
fn read_f64_at(p: *mut u8, n: usize, ws: *mut u8, out: *mut f64) -> usize {
    var bits: u64 = 0
    let z: usize = read_f64_bits_at(p, n, ws, &bits)
    *out = bits_f64(bits)
    return z
}

#[allow_fp]
fn text_to_f64_at(p: *mut u8, n: usize, ws: *mut u8, out: *mut f64) -> bool {
    let z: usize = read_f64_at(p, n, ws, out)
    return z == n && z > 0
}

// ---------------------------------------------- Floating point, text -> f32
//
// ROUND 71, and the one place in this file where a comment has to say what
// does NOT work: the way "correctly rounded binary64, then narrow" is WRONG.
// At the exact middle between two binary32 the first rounding lands ON the
// middle, and the tie-to-even of the second one then decides without knowing
// which side the real value lay on. It is not a rarity either -- measured
// against C `strtof`, 63568 of 239064 such cases came out one ulp off.
//
// The way that works runs over `strtod_odd`: rounding to ODD in between (cut
// off, last bit set when anything was left over) never produces a binary32
// middle, so the second rounding always has a direction and it is the right
// one. `tools/lexnum/run.sh` holds the whole thing against C `strtof` and
// against an exact reference written in Python for thousands of literals.

#[allow_fp]
fn read_f32_at(p: *mut u8, n: usize, ws: *mut u8, out: *mut f32) -> usize {
    var used: usize = 0
    let bits: u64 = strtod_odd(p, n, ws, &used)
    *out = bits_f64(bits) as f32
    return used
}

#[allow_fp]
fn read_f32_bits_at(p: *mut u8, n: usize, ws: *mut u8, out: *mut u32) -> usize {
    var x: f32 = 0.0
    let z: usize = read_f32_at(p, n, ws, &x)
    *out = f32_bits(x)
    return z
}

#[allow_fp]
fn text_to_f32_at(p: *mut u8, n: usize, ws: *mut u8, out: *mut f32) -> bool {
    let z: usize = read_f32_at(p, n, ws, out)
    return z == n && z > 0
}

#[allow_fp]
fn text_to_f32_bits_at(p: *mut u8, n: usize, ws: *mut u8, out: *mut u32) -> bool {
    let z: usize = read_f32_bits_at(p, n, ws, out)
    return z == n && z > 0
}

// Unsigned in any base 2..36, without a prefix.
// `big` selects A-Z instead of a-z.
fn write_base(out: *mut Bytes, v: u64, base: u32, big: bool) {
    if base < 2 || base > 36 {
        return
    }
    if v == 0 {
        bytes_push(out, 48 as u8)
        return
    }
    let b: u64 = base as u64
    var d: [u8; 64] = [0 as u8; 64]
    var n: usize = 0
    var x: u64 = v
    while x > 0 {
        let z: u64 = x % b
        if z < 10 {
            d[n] = z as u8 + 48 as u8
        } else if big {
            d[n] = z as u8 + 55 as u8
        } else {
            d[n] = z as u8 + 87 as u8
        }
        x = x / b
        n = n + 1
    }
    while n > 0 {
        n = n - 1
        bytes_push(out, d[n])
    }
}

fn write_u64(out: *mut Bytes, v: u64) {
    write_base(out, v, 10, false)
}

// Signed. At the edge (i64::MIN) the magnitude does not fit in i64 -- `0 - v`
// would wrap around there.
fn write_i64(out: *mut Bytes, v: i64) {
    if v < 0 {
        bytes_push(out, 45 as u8)
        write_base(out, (0 - (v + 1)) as u64 + 1, 10, false)
        return
    }
    write_base(out, v as u64, 10, false)
}

// Hexadecimal, at least `min` digits (padded with zeros on the left).
// No "0x" -- whoever wants it writes it in front; that keeps the function
// usable in both worlds.
fn write_hex(out: *mut Bytes, v: u64, min: usize) {
    let z: usize = digit_count(v, 16)
    var i: usize = z
    while i < min {
        bytes_push(out, 48 as u8)
        i = i + 1
    }
    write_base(out, v, 16, false)
}

fn write_hex_big(out: *mut Bytes, v: u64, min: usize) {
    let z: usize = digit_count(v, 16)
    var i: usize = z
    while i < min {
        bytes_push(out, 48 as u8)
        i = i + 1
    }
    write_base(out, v, 16, true)
}

fn write_binary(out: *mut Bytes, v: u64, min: usize) {
    let z: usize = digit_count(v, 2)
    var i: usize = z
    while i < min {
        bytes_push(out, 48 as u8)
        i = i + 1
    }
    write_base(out, v, 2, false)
}

fn write_octal(out: *mut Bytes, v: u64, min: usize) {
    let z: usize = digit_count(v, 8)
    var i: usize = z
    while i < min {
        bytes_push(out, 48 as u8)
        i = i + 1
    }
    write_base(out, v, 8, false)
}

// Right aligned to `width`, padded on the left with `filler`. Longer numbers
// are NOT truncated -- a shortened number would be a wrong number.
fn write_wide_u64(out: *mut Bytes, v: u64, width: usize, filler: u8) {
    let z: usize = digit_count(v, 10)
    var i: usize = z
    while i < width {
        bytes_push(out, filler)
        i = i + 1
    }
    write_base(out, v, 10, false)
}

fn write_wide_i64(out: *mut Bytes, v: i64, width: usize, filler: u8) {
    var abs: u64 = v as u64
    var z: usize = 0
    if v < 0 {
        abs = (0 - (v + 1)) as u64 + 1
        z = 1
    }
    z = z + digit_count(abs, 10)
    var i: usize = z
    while i < width {
        bytes_push(out, filler)
        i = i + 1
    }
    write_i64(out, v)
}

fn dtoa_work_bytes() -> usize {
    return DTOA_WS_BYTES
}

// The bit pattern as the shortest decimal text that reads back, APPENDED.
// `dtoa` itself clears its target -- that is why the way leads through a
// short intermediate buffer. Return value false = out of memory.
//
// THE COST, honestly: one `mmap` for the scratch memory (14 KiB) and one for
// the intermediate buffer per call. Whoever writes many numbers calls `dtoa`
// directly with scratch memory of their own -- the facade is the convenient
// form, not the fast one.
fn write_f64_bits(out: *mut Bytes, bits: u64) -> bool {
    let ws: *mut u8 = heap_alloc(DTOA_WS_BYTES)
    if (ws as usize) == 0 {
        return false
    }
    var between: Bytes = Bytes { ptr: 0 as *mut u8, len: 0, cap: 0 }
    dtoa(bits, &between, ws)
    bytes_append(out, between.ptr, between.len)
    bytes_free(&between)
    heap_free(ws, DTOA_WS_BYTES)
    return true
}

fn write_f64(out: *mut Bytes, x: f64) -> bool {
    return write_f64_bits(out, f64_bits(x))
}

// ROUND 73: the four forms below fetch the scratch memory of `strtod` with
// `mmap` and are thereby the CONVENIENT ones. They compute nothing
// themselves any more -- they hand the memory to the `_at` forms out of
// `lib/num/core_facade.fi`, which also serve the kernel. One core, two
// front doors.

fn read_f64_bits(p: *mut u8, n: usize, out: *mut u64) -> usize {
    *out = 0
    // ROUND 87: the short way of `strtod` needs no workspace at all. Only
    // when it declines does the 12 KiB come from the operating system --
    // before this, EVERY number paid for that mmap/munmap pair, and in a
    // document full of floats that was the larger half of the cost.
    var zs: usize = 0
    if strtod_short(p, n, &zs, false, out) {
        return zs
    }
    let ws: *mut u8 = heap_alloc(STRTOD_WS_BYTES)
    if (ws as usize) == 0 {
        return 0
    }
    let z: usize = read_f64_bits_at(p, n, ws, out)
    heap_free(ws, STRTOD_WS_BYTES)
    return z
}

fn read_f64(p: *mut u8, n: usize, out: *mut f64) -> usize {
    var bits: u64 = 0
    let z: usize = read_f64_bits(p, n, &bits)
    *out = bits_f64(bits)
    return z
}

fn text_to_f64(p: *mut u8, n: usize, out: *mut f64) -> bool {
    let z: usize = read_f64(p, n, out)
    return z == n && z > 0
}

fn text_to_f64_bits(p: *mut u8, n: usize, out: *mut u64) -> bool {
    let z: usize = read_f64_bits(p, n, out)
    return z == n && z > 0
}

// ---------------------------------------------------------- ROUND 71: f32
//
// The same two directions for a binary32. Writing goes through `ftoa32`
// (lib/num/f32_text.fi): the shortest text that reads back as the same FOUR
// octets -- not the shortest text of the double next to it. Reading goes
// through the same correctly rounded `strtod` and one narrowing.
//
// The cost is the same as with `write_f64_bits`, plus the scratch memory of
// `strtod`: `ftoa32` reads its own candidates back, and that is exactly what
// makes the result trustworthy.

#[allow_fp]
fn write_f32_bits(out: *mut Bytes, bits: u32) -> bool {
    let ws: *mut u8 = heap_alloc(DTOA_WS_BYTES)
    if (ws as usize) == 0 {
        return false
    }
    let sws: *mut u8 = heap_alloc(STRTOD_WS_BYTES)
    if (sws as usize) == 0 {
        heap_free(ws, DTOA_WS_BYTES)
        return false
    }
    var between: Bytes = Bytes { ptr: 0 as *mut u8, len: 0, cap: 0 }
    ftoa32(bits, &between, ws, sws)
    bytes_append(out, between.ptr, between.len)
    bytes_free(&between)
    heap_free(sws, STRTOD_WS_BYTES)
    heap_free(ws, DTOA_WS_BYTES)
    return true
}

#[allow_fp]
fn write_f32(out: *mut Bytes, x: f32) -> bool {
    return write_f32_bits(out, f32_bits(x))
}

#[allow_fp]
fn read_f32(p: *mut u8, n: usize, out: *mut f32) -> usize {
    *out = 0.0
    let ws: *mut u8 = heap_alloc(STRTOD_WS_BYTES)
    if (ws as usize) == 0 {
        return 0
    }
    let z: usize = read_f32_at(p, n, ws, out)
    heap_free(ws, STRTOD_WS_BYTES)
    return z
}

#[allow_fp]
fn read_f32_bits(p: *mut u8, n: usize, out: *mut u32) -> usize {
    var x: f32 = 0.0
    let z: usize = read_f32(p, n, &x)
    *out = f32_bits(x)
    return z
}

#[allow_fp]
fn text_to_f32(p: *mut u8, n: usize, out: *mut f32) -> bool {
    let z: usize = read_f32(p, n, out)
    return z == n && z > 0
}

#[allow_fp]
fn text_to_f32_bits(p: *mut u8, n: usize, out: *mut u32) -> bool {
    let z: usize = read_f32_bits(p, n, out)
    return z == n && z > 0
}

// tools/strlib/src/num_comfort.fi -- SOURCE for a part of lib/std/num.fi.
//
// Round 69, the comfort layer of `std.num`: reading a number WITHOUT an
// output parameter and WITHOUT a pointer/length pair.
//
// WHAT WAS WRONG. The old way needs four lines and knows two truths about
// one address:
//
//     var x: i64 = 0
//     if !num.text_to_i64(s.p, s.n, &x) { ... }
//
// The value comes back through a `*mut`, the failure through the return
// value, and the text has to be taken apart into `s.p, s.n` although a
// `Span` is exactly that pair. The new way is one line:
//
//     let r: num.ParsedI64 = num.parse_i64(s)
//     if !r.ok { ... }        // r.value is the number, r.overflow the reason
//
// Firn returns structs by value (SPEC 13.1, the result location guarantee),
// so an output parameter buys nothing here -- it only costs a line and a
// mutable variable.
//
// NOTHING IS REIMPLEMENTED. `parse_*` calls exactly the `read_*` core that
// `text_to_*` calls too; there is no second parser that could drift away
// from the first. The `text_to_*` forms stay untouched next to it, so that
// every existing caller keeps working.
//
// THE SPAN COMES FROM `str`. That is why this module imports `str`: an
// address is a `*mut u8` outward (docs/ROUND69.md), and a piece of text is
// a `Span`, not two loose parameters.
//
// Include:  //#include tools/strlib/src/num_comfort.fi

// An empty octet buffer BY VALUE -- the counterpart of `bytes_init`, for
// whoever wants to write `var b: num.Bytes = num.bytes_new()` instead of
// spelling out the three fields.
fn bytes_new() -> Bytes {
    return Bytes { ptr: 0 as *mut u8, len: 0, cap: 0 }
}

// ---------------------------------------------------------- The results
//
// `ok` answers the only question the caller usually has: is `value` the
// number that was written there? `overflow` says WHY not, when the digits
// were fine but too many -- the honesty the `read_*` core already had is
// kept, it is only no longer carried in a second output pointer.

struct ParsedI64 {
    ok: bool,
    overflow: bool,
    value: i64,
}

struct ParsedU64 {
    ok: bool,
    overflow: bool,
    value: u64,
}

struct ParsedF64 {
    ok: bool,
    value: f64,
}

// ROUND 71: the same for the single width.
struct ParsedF32 {
    ok: bool,
    value: f32,
}

// "There was nothing to read" -- the form a caller returns when the input
// ended before a number could even be looked for.
fn parsed_i64_none() -> ParsedI64 {
    return ParsedI64 { ok: false, overflow: false, value: 0 }
}

fn parsed_u64_none() -> ParsedU64 {
    return ParsedU64 { ok: false, overflow: false, value: 0 }
}

fn parsed_f64_none() -> ParsedF64 {
    return ParsedF64 { ok: false, value: 0.0 }
}

fn parsed_f32_none() -> ParsedF32 {
    return ParsedF32 { ok: false, value: 0.0 }
}

// ----------------------------------------------------------- The parsers
//
// STRICT, like `text_to_*`: the WHOLE span has to be the number. Leading or
// trailing blanks are NOT swallowed silently -- `s.trim()` is one call and
// says what it does, while a parser that trims on its own would also accept
// " 4 2" halfway.

fn parse_i64(s: str.Span) -> ParsedI64 {
    var v: i64 = 0
    var over: bool = false
    let used: usize = read_i64(s.p, s.n, 0, &v, &over)
    return ParsedI64 { ok: used == s.n && used > 0 && !over, overflow: over,
        value: v }
}

fn parse_u64_base(s: str.Span, base: u32) -> ParsedU64 {
    var v: u64 = 0
    var over: bool = false
    let used: usize = read_u64_base(s.p, s.n, 0, base, &v, &over)
    return ParsedU64 { ok: used == s.n && used > 0 && !over, overflow: over,
        value: v }
}

fn parse_u64(s: str.Span) -> ParsedU64 {
    return parse_u64_base(s, 10)
}

// With a base prefix: 0x/0X = 16, 0b/0B = 2, 0o/0O = 8, otherwise 10 --
// the same rule as `text_to_u64_auto`.
fn parse_u64_auto(s: str.Span) -> ParsedU64 {
    var v: u64 = 0
    let ok: bool = text_to_u64_auto(s.p, s.n, &v)
    return ParsedU64 { ok: ok, overflow: false, value: v }
}

// Floating point runs through `strtod` (correctly rounded). There is no
// overflow flag: outside the f64 range the answer is an infinity, and that
// IS the correctly rounded result.
fn parse_f64(s: str.Span) -> ParsedF64 {
    var v: f64 = 0.0
    let used: usize = read_f64(s.p, s.n, &v)
    return ParsedF64 { ok: used == s.n && used > 0, value: v }
}

// ROUND 71: the same core, one narrowing further.
fn parse_f32(s: str.Span) -> ParsedF32 {
    var v: f32 = 0.0
    let used: usize = read_f32(s.p, s.n, &v)
    return ParsedF32 { ok: used == s.n && used > 0, value: v }
}

// -------------------------------------------------------- Taking it apart
//
// The short form for "a number or a default value" -- the `int.TryParse`
// with an `out` becomes an expression.

fn i64_or(r: ParsedI64, fallback: i64) -> i64 {
    if r.ok {
        return r.value
    }
    return fallback
}

fn u64_or(r: ParsedU64, fallback: u64) -> u64 {
    if r.ok {
        return r.value
    }
    return fallback
}

fn f64_or(r: ParsedF64, fallback: f64) -> f64 {
    if r.ok {
        return r.value
    }
    return fallback
}

fn f32_or(r: ParsedF32, fallback: f32) -> f32 {
    if r.ok {
        return r.value
    }
    return fallback
}

// The results are VALUES; their methods therefore take `self`, not `*self`.
impl ParsedI64 {
    fn value_or(self, fallback: i64) -> i64 { return i64_or(self, fallback) }
}

impl ParsedU64 {
    fn value_or(self, fallback: u64) -> u64 { return u64_or(self, fallback) }
}

impl ParsedF64 {
    fn value_or(self, fallback: f64) -> f64 { return f64_or(self, fallback) }
}

impl ParsedF32 {
    fn value_or(self, fallback: f32) -> f32 { return f32_or(self, fallback) }
}
