// SPDX-License-Identifier: MPL-2.0
// lib/std/tzos.windows.fi -- std.tzos on Windows (see tzos.fi): the active
// time zone of the system, daylight saving included.

export { system_offset_min }

extern fn FileTimeToSystemTime(ft: u64, st: u64) -> i32;
extern fn SystemTimeToTzSpecificLocalTime(tz: u64, utc: u64, local: u64) -> i32;
extern fn SystemTimeToFileTime(st: u64, ft: u64) -> i32;

const FT_UNIX_EPOCH: i64 = 116444736000000000
const FT_PER_MS: i64 = 10000
const MS_PER_MIN: i64 = 60000

fn system_offset_min(ms: i64, out: *mut i32) -> bool {
    if ms < 0 - 11644473600000 {
        return false
    }
    var ft: [i64; 1] = [0; 1]
    ft[0] = ms * FT_PER_MS + FT_UNIX_EPOCH
    var utc: [i64; 2] = [0; 2]
    var local: [i64; 2] = [0; 2]
    var lft: [i64; 1] = [0; 1]
    if FileTimeToSystemTime((&ft[0]) as u64, (&utc[0]) as u64) == 0 {
        return false
    }
    if SystemTimeToTzSpecificLocalTime(0, (&utc[0]) as u64, (&local[0]) as u64) == 0 {
        return false
    }
    if SystemTimeToFileTime((&local[0]) as u64, (&lft[0]) as u64) == 0 {
        return false
    }
    let d: i64 = (lft[0] - ft[0]) / FT_PER_MS
    *out = (d / MS_PER_MIN) as i32
    return true
}
