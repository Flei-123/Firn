import std.num
import std.str

error ParseError { Empty, Invalid, Overflow }

fn to_i64(s: str) -> ParseError!i64 {
    if s.n == 0 {
        return ParseError::Empty
    }
    let r: num.ParsedI64 = num.parse_i64(s)
    if r.ok {
        return r.value
    }
    if r.overflow {
        return ParseError::Overflow
    }
    return ParseError::Invalid
}

fn to_u64(s: str) -> ParseError!u64 {
    if s.n == 0 {
        return ParseError::Empty
    }
    let r: num.ParsedU64 = num.parse_u64(s)
    if r.ok {
        return r.value
    }
    if r.overflow {
        return ParseError::Overflow
    }
    return ParseError::Invalid
}

fn to_i32(s: str) -> ParseError!i32 {
    let v: i64 = try to_i64(s)
    if v < (0 - 2147483647 - 1) || v > 2147483647 {
        return ParseError::Overflow
    }
    return v as i32
}

fn to_u32(s: str) -> ParseError!u32 {
    let v: u64 = try to_u64(s)
    if v > 4294967295 {
        return ParseError::Overflow
    }
    return v as u32
}

fn to_f64(s: str) -> ParseError!f64 {
    if s.n == 0 {
        return ParseError::Empty
    }
    let r: num.ParsedF64 = num.parse_f64(s)
    if r.ok {
        return r.value
    }
    return ParseError::Invalid
}

fn to_f32(s: str) -> ParseError!f32 {
    if s.n == 0 {
        return ParseError::Empty
    }
    let r: num.ParsedF32 = num.parse_f32(s)
    if r.ok {
        return r.value
    }
    return ParseError::Invalid
}

fn to_bool(s: str) -> ParseError!bool {
    if s.n == 0 {
        return ParseError::Empty
    }
    if s == "true" {
        return true
    }
    if s == "false" {
        return false
    }
    return ParseError::Invalid
}

fn try_i64(s: str, out: *mut i64) -> bool {
    let r: num.ParsedI64 = num.parse_i64(s)
    if r.ok {
        *out = r.value
    }
    return r.ok
}

fn try_u64(s: str, out: *mut u64) -> bool {
    let r: num.ParsedU64 = num.parse_u64(s)
    if r.ok {
        *out = r.value
    }
    return r.ok
}

fn try_i32(s: str, out: *mut i32) -> bool {
    let r: num.ParsedI64 = num.parse_i64(s)
    if !r.ok || r.value < (0 - 2147483647 - 1) || r.value > 2147483647 {
        return false
    }
    *out = r.value as i32
    return true
}

fn try_u32(s: str, out: *mut u32) -> bool {
    let r: num.ParsedU64 = num.parse_u64(s)
    if !r.ok || r.value > 4294967295 {
        return false
    }
    *out = r.value as u32
    return true
}

fn try_f64(s: str, out: *mut f64) -> bool {
    let r: num.ParsedF64 = num.parse_f64(s)
    if r.ok {
        *out = r.value
    }
    return r.ok
}

fn try_f32(s: str, out: *mut f32) -> bool {
    let r: num.ParsedF32 = num.parse_f32(s)
    if r.ok {
        *out = r.value
    }
    return r.ok
}

fn try_bool(s: str, out: *mut bool) -> bool {
    if s == "true" {
        *out = true
        return true
    }
    if s == "false" {
        *out = false
        return true
    }
    return false
}

impl i32 {
    fn parse(s: str) -> ParseError!i32 { return to_i32(s) }
    fn try_parse(s: str, out: *mut i32) -> bool { return try_i32(s, out) }
}

impl i64 {
    fn parse(s: str) -> ParseError!i64 { return to_i64(s) }
    fn try_parse(s: str, out: *mut i64) -> bool { return try_i64(s, out) }
}

impl u32 {
    fn parse(s: str) -> ParseError!u32 { return to_u32(s) }
    fn try_parse(s: str, out: *mut u32) -> bool { return try_u32(s, out) }
}

impl u64 {
    fn parse(s: str) -> ParseError!u64 { return to_u64(s) }
    fn try_parse(s: str, out: *mut u64) -> bool { return try_u64(s, out) }
}

impl f32 {
    fn parse(s: str) -> ParseError!f32 { return to_f32(s) }
    fn try_parse(s: str, out: *mut f32) -> bool { return try_f32(s, out) }
}

impl f64 {
    fn parse(s: str) -> ParseError!f64 { return to_f64(s) }
    fn try_parse(s: str, out: *mut f64) -> bool { return try_f64(s, out) }
}

impl bool {
    fn parse(s: str) -> ParseError!bool { return to_bool(s) }
    fn try_parse(s: str, out: *mut bool) -> bool { return try_bool(s, out) }
}
