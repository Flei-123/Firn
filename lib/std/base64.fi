// SPDX-License-Identifier: MPL-2.0
// lib/std/base64.fi -- Base64 (RFC 4648 section 4) and its URL-safe form
// (section 5), both directions.
//
// Needed by the WebSocket handshake (Sec-WebSocket-Accept is the Base64
// of a SHA-1), by PEM files (certificates and keys) and by anything that
// puts octets into a URL or a header.
//
//     base64.encode(p, n, &out)          "Zmlybg=="
//     base64.encode_url(p, n, &out)      "Zmlybg"   (no padding, - and _)
//     base64.decode(p, n, &out) -> bool  both alphabets, whitespace skipped
import std.rt

export { encode, encode_url, decode, encoded_len }

fn alpha(v: u64, url: bool) -> u8 {
    if v < 26 { return (65 + v) as u8 }
    if v < 52 { return (97 + v - 26) as u8 }
    if v < 62 { return (48 + v - 52) as u8 }
    if v == 62 {
        if url { return 45 as u8 }
        return 43 as u8
    }
    if url { return 95 as u8 }
    return 47 as u8
}

fn value(c: u8) -> i32 {
    if c >= 65 as u8 && c <= 90 as u8 { return (c - 65 as u8) as i32 }
    if c >= 97 as u8 && c <= 122 as u8 { return (c - 97 as u8) as i32 + 26 }
    if c >= 48 as u8 && c <= 57 as u8 { return (c - 48 as u8) as i32 + 52 }
    if c == 43 as u8 || c == 45 as u8 { return 62 }
    if c == 47 as u8 || c == 95 as u8 { return 63 }
    return -1
}

// The length of the padded encoding of n octets.
fn encoded_len(n: usize) -> usize {
    return (n + 2) / 3 * 4
}

fn encode_with(p: u64, n: usize, out: *mut rt.Buf, url: bool) {
    var i: usize = 0
    while i + 3 <= n {
        let v: u64 = ((rt.ld8(p, i) as u64) << 16) | ((rt.ld8(p, i + 1) as u64) << 8)
        | (rt.ld8(p, i + 2) as u64)
        rt.buf_push(out, alpha((v >> 18) & 63, url))
        rt.buf_push(out, alpha((v >> 12) & 63, url))
        rt.buf_push(out, alpha((v >> 6) & 63, url))
        rt.buf_push(out, alpha(v & 63, url))
        i = i + 3
    }
    let rest: usize = n - i
    if rest == 1 {
        let v: u64 = (rt.ld8(p, i) as u64) << 16
        rt.buf_push(out, alpha((v >> 18) & 63, url))
        rt.buf_push(out, alpha((v >> 12) & 63, url))
        if !url {
            rt.buf_push(out, 61 as u8)
            rt.buf_push(out, 61 as u8)
        }
    }
    if rest == 2 {
        let v: u64 = ((rt.ld8(p, i) as u64) << 16) | ((rt.ld8(p, i + 1) as u64) << 8)
        rt.buf_push(out, alpha((v >> 18) & 63, url))
        rt.buf_push(out, alpha((v >> 12) & 63, url))
        rt.buf_push(out, alpha((v >> 6) & 63, url))
        if !url {
            rt.buf_push(out, 61 as u8)
        }
    }
}

fn encode(p: u64, n: usize, out: *mut rt.Buf) {
    encode_with(p, n, out, false)
}

fn encode_url(p: u64, n: usize, out: *mut rt.Buf) {
    encode_with(p, n, out, true)
}

// Decodes either alphabet; CR, LF, space and tab are skipped (PEM), the
// padding is optional. False on a character outside the alphabet, on data
// after the padding, or on a dangling single sextet.
fn decode(p: u64, n: usize, out: *mut rt.Buf) -> bool {
    var acc: u64 = 0
    var bits: usize = 0
    var pad: usize = 0
    var count: usize = 0
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        i = i + 1
        if c == 10 as u8 || c == 13 as u8 || c == 32 as u8 || c == 9 as u8 {
            continue
        }
        if c == 61 as u8 {
            pad = pad + 1
            continue
        }
        if pad > 0 { return false }
        let v: i32 = value(c)
        if v < 0 { return false }
        acc = ((acc << 6) | (v as u64)) & 16777215
        bits = bits + 6
        count = count + 1
        if bits >= 8 {
            bits = bits - 8
            rt.buf_push(out, ((acc >> (bits as u64)) & 255) as u8)
        }
    }
    if count % 4 == 1 { return false }
    return pad <= 2
}
