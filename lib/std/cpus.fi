import std.rt

export { cpu_count }

const SYS_SCHED_GETAFFINITY: i64 = 204
const MASK_BYTES: usize = 128
const FALLBACK_CPUS: i32 = 4

fn popcount64(v: u64) -> i32 {
    var n: i32 = 0
    var x: u64 = v
    while x != 0 as u64 {
        x = x & (x - 1 as u64)
        n = n + 1
    }
    return n
}

fn cpu_count() -> i32 {
    let buf: u64 = rt.heap_alloc(MASK_BYTES)
    var i: usize = 0
    while i < MASK_BYTES / 8 {
        rt.st64(buf, i, 0 as u64)
        i = i + 1
    }
    let got: i64 = syscall(SYS_SCHED_GETAFFINITY, 0, MASK_BYTES as i64, buf as i64, 0, 0, 0)
    var n: i32 = 0
    if got > 0 {
        var w: usize = 0
        while w < (got as usize) / 8 {
            n = n + popcount64(rt.ld64(buf, w))
            w = w + 1
        }
    }
    rt.heap_free(buf, MASK_BYTES)
    if n <= 0 { return FALLBACK_CPUS }
    return n
}
