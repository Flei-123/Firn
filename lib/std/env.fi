// SPDX-License-Identifier: MPL-2.0
// lib/std/env.fi -- std.env: the process environment, and `which`.
//
// `lib/std/fs.fi` still says "Firn has no environment access yet". This is
// the access: read a variable, list them all (what a child process
// inherits), and find a program on the search path.
//
//     import std.env
//     var v: rt.Buf = rt.buf_new()
//     if env.get_into("JAVA_HOME", &v) { ... }
//     let home: str = env.get("HOME")            // "" when unset
//     var exe: rt.Buf = rt.buf_new()
//     if env.find_executable("java", &exe) { ... }   // rt.buf_* holds the path
//
// Linux reads `/proc/self/environ`; the Windows twin (`env.windows.fi`,
// picked by `--target=x86_64-windows`) asks `GetEnvironmentVariableW` and
// `GetEnvironmentStringsW`. The API is the same on both.
//
// HONEST
// E1  READ ONLY. There is no `set_env`: a child gets its variables from
//     `std.process` (`set_env`/`unset_env` on the command), which is the
//     only place where a change can be seen by anybody. Changing the
//     environment of a running process is a data race in every C runtime;
//     Firn does not offer it.
// E2  On Linux the answer is the environment the process was STARTED with
//     (that is what `/proc/self/environ` holds).
// E3  A name containing `=` or a zero octet is never found.
// E4  Windows compares names without regard to case and returns the value
//     in UTF-8; Linux compares octets.

import rt
import str
import fs

export {
    get_into, get, has, list_into, find_executable,
    PATH_SEP, DIR_SEP,
}

const PATH_SEP: u8 = 58 // ':' (';' on Windows)
const DIR_SEP: u8 = 47 // '/' ('\\' on Windows)

const ENV_SYS_ACCESS: i64 = 21
const ENV_X_OK: i64 = 1

fn environ_blob(out: *mut rt.Buf) -> bool {
    var path: [u8; 19] = "/proc/self/environ\0"
    return rt.read_file((&path[0]) as u64, out)
}

// The value of `name` appended to `out` (UTF-8, no terminator). false when
// the variable is not set.
fn get_into(name: str, out: *mut rt.Buf) -> bool {
    let n: usize = name.length()
    if n == 0 {
        return false
    }
    var i: usize = 0
    while i < n {
        let c: u8 = name.chars(i)
        if c == 61 as u8 || c == 0 as u8 {
            return false
        }
        i = i + 1
    }
    var blob: rt.Buf = rt.buf_new()
    if !environ_blob(&blob) {
        rt.buf_free(&blob)
        return false
    }
    let total: usize = rt.buf_len(&blob)
    var at: usize = 0
    var found: bool = false
    while at < total && !found {
        var e: usize = at
        while e < total && rt.buf_at(&blob, e) != 0 as u8 {
            e = e + 1
        }
        // entry = [at, e): `name=value`
        if e - at > n && rt.buf_at(&blob, at + n) == 61 as u8 {
            var same: bool = true
            var j: usize = 0
            while j < n && same {
                if rt.buf_at(&blob, at + j) != name.chars(j) {
                    same = false
                }
                j = j + 1
            }
            if same {
                rt.buf_push_bytes(out, rt.buf_ptr(&blob) + (at + n + 1) as u64, e - at - n - 1)
                found = true
            }
        }
        at = e + 1
    }
    rt.buf_free(&blob)
    return found
}

fn has(name: str) -> bool {
    var tmp: rt.Buf = rt.buf_new()
    let r: bool = get_into(name, &tmp)
    rt.buf_free(&tmp)
    return r
}

// The value of `name` as a string; "" when unset (use `has` to tell an empty
// value from a missing one).
fn get(name: str) -> str {
    var tmp: rt.Buf = rt.buf_new()
    if !get_into(name, &tmp) || rt.buf_len(&tmp) == 0 {
        rt.buf_free(&tmp)
        return ""
    }
    let s: str = __str_copy(str { p: rt.buf_data(&tmp), n: rt.buf_len(&tmp) })
    rt.buf_free(&tmp)
    return s
}

// Every variable as `NAME=value` followed by a zero octet, appended to
// `out` (UTF-8); the result is the number of entries. This is the block
// `std.process` hands to a child (with the command's changes applied).
fn list_into(out: *mut rt.Buf) -> usize {
    var blob: rt.Buf = rt.buf_new()
    if !environ_blob(&blob) {
        rt.buf_free(&blob)
        return 0
    }
    let total: usize = rt.buf_len(&blob)
    var at: usize = 0
    var count: usize = 0
    while at < total {
        var e: usize = at
        while e < total && rt.buf_at(&blob, e) != 0 as u8 {
            e = e + 1
        }
        if e > at {
            rt.buf_push_bytes(out, rt.buf_ptr(&blob) + at as u64, e - at)
            rt.buf_push(out, 0 as u8)
            count = count + 1
        }
        at = e + 1
    }
    rt.buf_free(&blob)
    return count
}

// Is `cand` (no terminator, a path) a regular file the process may execute?
fn is_executable(cand: *mut rt.Buf) -> bool {
    let p: str = str { p: rt.buf_data(cand), n: rt.buf_len(cand) }
    if !fs.is_file(p) {
        return false
    }
    rt.buf_push(cand, 0 as u8)
    let r: i64 = syscall(ENV_SYS_ACCESS, rt.buf_ptr(cand) as i64, ENV_X_OK, 0, 0, 0, 0)
    rt.buf_set_len(cand, rt.buf_len(cand) - 1)
    return r == 0
}

// Looks for the program `name`. A name with a `/` in it is taken as a path
// (relative to the working directory) and only checked; any other name is
// searched in the directories of `PATH`, in order, exactly like a shell's
// `which`. On success the path is APPENDED to `out` (no terminator) and the
// result is true. Directories and files without the execute bit do not
// count.
fn find_executable(name: str, out: *mut rt.Buf) -> bool {
    let n: usize = name.length()
    if n == 0 {
        return false
    }
    var slash: bool = false
    var i: usize = 0
    while i < n {
        let c: u8 = name.chars(i)
        if c == 0 as u8 {
            return false
        }
        if c == 47 as u8 {
            slash = true
        }
        i = i + 1
    }
    var cand: rt.Buf = rt.buf_new()
    if slash {
        rt.buf_push_bytes(&cand, name.p as u64, n)
        let ok: bool = is_executable(&cand)
        if ok {
            rt.buf_push_bytes(out, rt.buf_ptr(&cand), rt.buf_len(&cand))
        }
        rt.buf_free(&cand)
        return ok
    }
    var path: rt.Buf = rt.buf_new()
    if !get_into("PATH", &path) {
        rt.buf_free(&cand)
        rt.buf_free(&path)
        return false
    }
    let total: usize = rt.buf_len(&path)
    var at: usize = 0
    var found: bool = false
    while at <= total && !found {
        var e: usize = at
        while e < total && rt.buf_at(&path, e) != PATH_SEP {
            e = e + 1
        }
        rt.buf_clear(&cand)
        if e > at {
            rt.buf_push_bytes(&cand, rt.buf_ptr(&path) + at as u64, e - at)
            if rt.buf_at(&cand, rt.buf_len(&cand) - 1) != DIR_SEP {
                rt.buf_push(&cand, DIR_SEP)
            }
        }
        // an empty entry of PATH means the current directory
        rt.buf_push_bytes(&cand, name.p as u64, n)
        if is_executable(&cand) {
            rt.buf_push_bytes(out, rt.buf_ptr(&cand), rt.buf_len(&cand))
            found = true
        }
        at = e + 1
    }
    rt.buf_free(&cand)
    rt.buf_free(&path)
    return found
}
