// SPDX-License-Identifier: MPL-2.0
// lib/std/xml.fi -- std.xml: a small, STRICT XML reader and writer (r319).
//
//     import std.xml
//
//     var d: xml.Doc = xml.doc_new()
//     defer xml.doc_free(&d)
//     let ok: bool = xml.parse(&d, text_ptr, text_len) catch false
//     if !ok {
//         // line:column: message  (1-based, columns count characters)
//         io.eprint(xml.err_line(&d), xml.err_col(&d), xml.err_text(&d))
//         return 1
//     }
//     let root: u32 = xml.root(&d)
//     let item: u32 = xml.child(&d, root, "item")          // first <item> child, or xml.NONE
//     let id: str = xml.attr(&d, item, "id")               // "" if there is none (has_attr tells)
//     let label: str = xml.text(&d, item)                  // the text before the first child element
//     var all: rt.Buf = rt.buf_new()
//     xml.text_all(&d, item, &all)                         // all text below, in document order
//     xml.write(&d, root, &all)                            // back to XML (round trip)
//
// WHAT IT IS FOR. Reading the small, machine-made XML files that scripts meet
// (OpenPlan's exports, project files, feeds): a few kilobytes, UTF-8,
// well-formed. It replaces the 20 lines of Python around `xml.etree` that
// walk a tree and read attributes. It is not a framework.
//
// ============================================================ WHAT IS READ
//
//   * ELEMENTS, ATTRIBUTES (single or double quoted), TEXT, CDATA sections.
//     Adjacent text, CDATA and references are ONE text node.
//   * COMMENTS and PROCESSING INSTRUCTIONS are checked and then skipped;
//     they leave no node (so `a<!--x-->b` is the single text "ab").
//   * The five predefined entities and decimal / hexadecimal character
//     references (`&#65;`, `&#x1F600;`).
//   * NAMESPACES are NOT processed: `svg:rect` is the plain name "svg:rect"
//     and `xmlns:svg="..."` is an attribute like any other. Nothing is
//     resolved, nothing is checked for a binding.
//   * Line ends are normalised as the XML standard says (CR LF and CR
//     become LF); in attribute values every white space becomes a blank,
//     except what a character reference produced.
//
// ===================================================== WHAT IT REFUSES
//
// The standard says a processor must stop at the first well-formedness
// error, and so does this one -- with LINE AND COLUMN. Not tolerated:
// a missing or mismatched end tag, an unquoted attribute value, `<` in an
// attribute value, a duplicate attribute, `--` inside a comment, `]]>` in
// text, an undefined entity, an invalid character reference (`&#0;`,
// `&#xD800;`), a control character, invalid UTF-8, a second root element,
// text outside the root, a missing root, an XML declaration that is not
// the very first thing in the input. This is the OPPOSITE of the
// fault-tolerant reader in `lib/svg/xml.fi` (which a browser needs); the
// two do not share code.
//
// HONEST (what it does not do):
//   X1 NO DTD. `<!DOCTYPE` is an ERROR, not skipped: with no DTD there are
//      no user-defined entities, so there is no "billion laughs", and a
//      document that needs its DTD is not read wrongly but refused.
//   X2 UTF-8 ONLY. A BOM is skipped; UTF-16 and any `encoding=` other than
//      UTF-8 are refused (E_ENCODING). No Latin-1, no transcoding.
//   X3 NO NAMESPACES, NO XPATH, NO XSD, NO XINCLUDE, NO SAX stream. The
//      tree is built whole in memory: flat arrays, no allocation per node.
//   X4 LIMITS: nesting depth `XML_MAX_DEPTH` (100,000; the parser itself is
//      iterative, the limit protects the CALLER's recursion), at most
//      `XML_MAX_ATTRS` (4,096) attributes per element (the duplicate check
//      is quadratic and must not become a denial of service).
//   X5 NAMES follow XML 1.0 (5th edition) `NameStartChar`/`NameChar`. The
//      reference parser (expat) uses its own table for non-ASCII letters
//      and differs from the standard on some exotic code points; the
//      cross-check in `tools/xml_cross/` counts these (see its report).
//   X6 WHITE SPACE between elements is kept as text nodes, as in
//      `xml.etree`. There is no "ignorable whitespace" without a DTD.
//   X7 `xml.write` writes the tree compactly (no declaration, no
//      indentation: indenting mixed content would change the document).
//      Empty elements are written `<a/>`. `parse(write(parse(x)))` is the
//      same tree as `parse(x)`; the bytes of `x` are not reproduced
//      (quotes, entity forms, comments, white space inside tags).
//   X8 There is no writer without a tree (`json.JsonWriter` has a
//      counterpart in JSON only).
//
// ================================================================ THE SHAPE
//
// Like `std.json`: a flat ARRAY OF NODES, the text in one blob, indices
// instead of pointers (`xml.NONE` = no node). Element and text nodes are
// siblings in document order; an element's attributes are a contiguous
// slice of the attribute array. All strings (`str`) handed out point into
// the document and stay valid until `doc_free` / the next `parse`.
import rt
import str

export {
    XmlError, Doc,
    doc_new, doc_free, parse, parse_str,
    valid, root, kind, name, text, text_all, first, last, next, parent,
    child_count, line,
    attr_count, attr_name, attr_value, attr, has_attr,
    child, next_named, children_named,
    write,
    err_line, err_col, err_code, err_text,
    NONE, ELEMENT, TEXT, XML_MAX_DEPTH, XML_MAX_ATTRS,
    E_XMLDECL, E_ENCODING, E_DTD, E_DEPTH, E_LIMIT,
}

error XmlError {
    Syntax,
    Depth,
    Limit,
    OutOfMemory,
}

const ELEMENT: u8 = 0
const TEXT: u8 = 1
const NONE: u32 = 4294967295
const XML_MAX_DEPTH: usize = 100000
const XML_MAX_ATTRS: usize = 4096

const E_NONE: usize = 0
const E_SYNTAX: usize = 1
const E_EOF: usize = 2
const E_NO_ROOT: usize = 3
const E_JUNK: usize = 4
const E_NAME: usize = 5
const E_ATTR_EQ: usize = 6
const E_ATTR_QUOTE: usize = 7
const E_ATTR_DUP: usize = 8
const E_ATTR_SPACE: usize = 9
const E_LT_IN_ATTR: usize = 10
const E_TAG_MISMATCH: usize = 11
const E_TAG_CLOSE: usize = 12
const E_ENTITY: usize = 13
const E_CHARREF: usize = 14
const E_CDEND: usize = 15
const E_COMMENT: usize = 16
const E_PI: usize = 17
const E_XMLDECL: usize = 18
const E_ENCODING: usize = 19
const E_DTD: usize = 20
const E_CHAR: usize = 21
const E_UTF8: usize = 22
const E_DEPTH: usize = 23
const E_LIMIT: usize = 24
const E_MEMORY: usize = 25

struct Node {
    kind: u8,
    parent: u32,
    first: u32,
    last: u32, // so that appending a child is O(1) instead of a walk
    next: u32,
    nchild: u32,
    afirst: u32, // index of the first attribute in the attribute array
    nattr: u32,
    line: u32,
    len: u32, // element: length of the name; text: length of the text
    off: u64, // offset into the blob
}

struct Attr {
    nlen: u32,
    vlen: u32,
    noff: u64,
    voff: u64,
}

struct Doc {
    nodes: u64, // Node[cap]
    nsize: usize, // the size of ONE Node -- measured, see `node_size`
    count: usize,
    cap: usize,
    attrs: u64, // Attr[acap]
    asize: usize,
    acount: usize,
    acap: usize,
    blob: u64, // names, attribute values and text, decoded
    blob_len: usize,
    blob_cap: usize,
    root: u32,
    // the parse state
    src: u64,
    n: usize,
    at: usize,
    line: usize,
    col: usize,
    err: usize,
    err_line: usize,
    err_col: usize,
    cur: u32, // the open element
    text_node: u32, // the text node still open for appending, or NONE
    depth: usize,
}

// LANGUAGE GAP (same as `std.json`): `size_of[Node]()` does not work in an
// imported module, so the stride of the arrays is MEASURED.
fn empty_node() -> Node {
    return Node { kind: 0 as u8, parent: NONE, first: NONE, last: NONE,
        next: NONE, nchild: 0 as u32, afirst: 0 as u32, nattr: 0 as u32,
        line: 0 as u32, len: 0 as u32, off: 0 }
}

fn empty_attr() -> Attr {
    return Attr { nlen: 0 as u32, vlen: 0 as u32, noff: 0, voff: 0 }
}

fn node_size() -> usize {
    var probe: [Node; 2] = [empty_node(); 2]
    return (((&probe[1]) as u64) - ((&probe[0]) as u64)) as usize
}

fn attr_size() -> usize {
    var probe: [Attr; 2] = [empty_attr(); 2]
    return (((&probe[1]) as u64) - ((&probe[0]) as u64)) as usize
}

fn doc_new() -> Doc {
    return Doc { nodes: 0, nsize: node_size(), count: 0, cap: 0,
        attrs: 0, asize: attr_size(), acount: 0, acap: 0,
        blob: 0, blob_len: 0, blob_cap: 0, root: NONE,
        src: 0, n: 0, at: 0, line: 1, col: 1,
        err: E_NONE, err_line: 0, err_col: 0, cur: NONE, text_node: NONE,
        depth: 0 }
}

fn doc_free(d: *mut Doc) {
    if (*d).cap > 0 {
        rt.heap_free((*d).nodes, (*d).cap * (*d).nsize)
    }
    if (*d).acap > 0 {
        rt.heap_free((*d).attrs, (*d).acap * (*d).asize)
    }
    if (*d).blob_cap > 0 {
        rt.heap_free((*d).blob, (*d).blob_cap)
    }
    (*d).nodes = 0
    (*d).cap = 0
    (*d).count = 0
    (*d).attrs = 0
    (*d).acap = 0
    (*d).acount = 0
    (*d).blob = 0
    (*d).blob_cap = 0
    (*d).blob_len = 0
    (*d).root = NONE
}

fn node_at(d: *mut Doc, i: u32) -> *mut Node {
    return ((*d).nodes + (i as u64) * (*d).nsize as u64) as *mut Node
}

fn attr_at(d: *mut Doc, i: usize) -> *mut Attr {
    return ((*d).attrs + (i as u64) * (*d).asize as u64) as *mut Attr
}

fn nodes_reserve(d: *mut Doc) -> bool {
    if (*d).count < (*d).cap {
        return true
    }
    var want: usize = (*d).cap
    if want == 0 {
        want = 64
    } else {
        want = want * 2
    }
    let p: u64 = rt.heap_alloc(want * (*d).nsize)
    if p == 0 {
        return false
    }
    if (*d).count > 0 {
        rt.mem_copy(p, (*d).nodes, (*d).count * (*d).nsize)
    }
    if (*d).cap > 0 {
        rt.heap_free((*d).nodes, (*d).cap * (*d).nsize)
    }
    (*d).nodes = p
    (*d).cap = want
    return true
}

fn attrs_reserve(d: *mut Doc) -> bool {
    if (*d).acount < (*d).acap {
        return true
    }
    var want: usize = (*d).acap
    if want == 0 {
        want = 32
    } else {
        want = want * 2
    }
    let p: u64 = rt.heap_alloc(want * (*d).asize)
    if p == 0 {
        return false
    }
    if (*d).acount > 0 {
        rt.mem_copy(p, (*d).attrs, (*d).acount * (*d).asize)
    }
    if (*d).acap > 0 {
        rt.heap_free((*d).attrs, (*d).acap * (*d).asize)
    }
    (*d).attrs = p
    (*d).acap = want
    return true
}

fn blob_reserve(d: *mut Doc, more: usize) -> bool {
    let need: usize = (*d).blob_len + more
    if need <= (*d).blob_cap {
        return true
    }
    var want: usize = (*d).blob_cap
    if want == 0 {
        want = 256
    }
    while want < need {
        want = want * 2
    }
    let p: u64 = rt.heap_alloc(want)
    if p == 0 {
        return false
    }
    if (*d).blob_len > 0 {
        rt.mem_copy(p, (*d).blob, (*d).blob_len)
    }
    if (*d).blob_cap > 0 {
        rt.heap_free((*d).blob, (*d).blob_cap)
    }
    (*d).blob = p
    (*d).blob_cap = want
    return true
}

fn blob_push_bytes(d: *mut Doc, p: u64, n: usize) -> bool {
    if !blob_reserve(d, n) {
        return false
    }
    rt.mem_copy((*d).blob + (*d).blob_len as u64, p, n)
    (*d).blob_len = (*d).blob_len + n
    return true
}

fn blob_push(d: *mut Doc, v: u8) -> bool {
    if !blob_reserve(d, 1) {
        return false
    }
    rt.st8((*d).blob, (*d).blob_len, v)
    (*d).blob_len = (*d).blob_len + 1
    return true
}

fn node_new(d: *mut Doc, kind: u8) -> u32 {
    if !nodes_reserve(d) {
        (*d).err = E_MEMORY
        return NONE
    }
    let i: u32 = (*d).count as u32
    let nd: *mut Node = node_at(d, i)
    (*nd).kind = kind
    (*nd).parent = NONE
    (*nd).first = NONE
    (*nd).last = NONE
    (*nd).next = NONE
    (*nd).nchild = 0
    (*nd).afirst = (*d).acount as u32
    (*nd).nattr = 0
    (*nd).line = (*d).line as u32
    (*nd).len = 0
    (*nd).off = 0
    (*d).count = (*d).count + 1
    return i
}

fn append_child(d: *mut Doc, parent: u32, child: u32) {
    let p: *mut Node = node_at(d, parent)
    if (*p).first == NONE {
        (*p).first = child
    } else {
        let l: *mut Node = node_at(d, (*p).last)
        (*l).next = child
    }
    (*p).last = child
    (*p).nchild = (*p).nchild + 1 as u32
    let c: *mut Node = node_at(d, child)
    (*c).parent = parent
}

// ------------------------------------------------------------ the scanner

fn peek(d: *mut Doc) -> i32 {
    if (*d).at >= (*d).n {
        return -1
    }
    return rt.ld8((*d).src, (*d).at) as i32
}

// The octet `k` places ahead, raw; -1 past the end.
fn at_byte(d: *mut Doc, k: usize) -> i32 {
    let j: usize = (*d).at + k
    if j >= (*d).n {
        return -1
    }
    return rt.ld8((*d).src, j) as i32
}

// One octet, and the line end normalisation of the standard (XML 1.0 2.11):
// CR LF and a lone CR are returned as one LF. A byte that continues a
// multi-byte character does not advance the column.
fn advance(d: *mut Doc) -> i32 {
    if (*d).at >= (*d).n {
        return -1
    }
    let c: i32 = rt.ld8((*d).src, (*d).at) as i32
    (*d).at = (*d).at + 1
    if c == 10 {
        (*d).line = (*d).line + 1
        (*d).col = 1
        return 10
    }
    if c == 13 {
        if (*d).at < (*d).n && rt.ld8((*d).src, (*d).at) == 10 as u8 {
            (*d).at = (*d).at + 1
        }
        (*d).line = (*d).line + 1
        (*d).col = 1
        return 10
    }
    if (c & 192) != 128 {
        (*d).col = (*d).col + 1
    }
    return c
}

fn fail(d: *mut Doc, code: usize) {
    if (*d).err == E_NONE {
        (*d).err = code
        (*d).err_line = (*d).line
        (*d).err_col = (*d).col
    }
}

fn fail_at(d: *mut Doc, code: usize, line: usize, col: usize) {
    if (*d).err == E_NONE {
        (*d).err = code
        (*d).err_line = line
        (*d).err_col = col
    }
}

fn is_space(c: i32) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13
}

fn skip_space(d: *mut Doc) -> usize {
    var k: usize = 0
    while is_space(peek(d)) {
        advance(d)
        k = k + 1
    }
    return k
}

// Does the input continue with the literal `s` at the current position?
fn starts(d: *mut Doc, s: str) -> bool {
    if (*d).at + s.n > (*d).n {
        return false
    }
    return rt.mem_eq((*d).src + (*d).at as u64, s.p as u64, s.n)
}

fn skip_lit(d: *mut Doc, s: str) {
    var i: usize = 0
    while i < s.n {
        advance(d)
        i = i + 1
    }
}

// Why `scan_char` said 0 at the current position (first octet `c`): U+FFFE
// and U+FFFF are well-formed UTF-8 but not XML characters.
fn fail_char(d: *mut Doc, c: i32) {
    if c < 128 || (c == 239 && at_byte(d, 1) == 191 && at_byte(d, 2) >= 190) {
        fail(d, E_CHAR)
    } else {
        fail(d, E_UTF8)
    }
}

// The length in octets of the well-formed XML character at the current
// position (1..4), or 0 if there is none: a control character other than
// tab, LF, CR; U+FFFE and U+FFFF; or UTF-8 that is invalid (a stray
// continuation byte, an overlong form, a surrogate, a value above U+10FFFF,
// a truncated sequence).
fn scan_char(d: *mut Doc) -> usize {
    let c: i32 = at_byte(d, 0)
    if c < 0 {
        return 0
    }
    if c < 128 {
        if c >= 32 || c == 9 || c == 10 || c == 13 {
            return 1
        }
        return 0
    }
    if c < 194 {
        return 0
    }
    let c1: i32 = at_byte(d, 1)
    if c < 224 {
        if c1 >= 128 && c1 < 192 {
            return 2
        }
        return 0
    }
    let c2: i32 = at_byte(d, 2)
    if c < 240 {
        if c2 < 128 || c2 >= 192 {
            return 0
        }
        if c == 224 {
            if c1 < 160 || c1 >= 192 {
                return 0
            }
        } else if c == 237 {
            if c1 < 128 || c1 >= 160 {
                return 0
            }
        } else if c1 < 128 || c1 >= 192 {
            return 0
        }
        if c == 239 && c1 == 191 && c2 >= 190 {
            return 0
        }
        return 3
    }
    if c < 245 {
        let c3: i32 = at_byte(d, 3)
        if c2 < 128 || c2 >= 192 || c3 < 128 || c3 >= 192 {
            return 0
        }
        if c == 240 {
            if c1 < 144 || c1 >= 192 {
                return 0
            }
        } else if c == 244 {
            if c1 < 128 || c1 >= 144 {
                return 0
            }
        } else if c1 < 128 || c1 >= 192 {
            return 0
        }
        return 4
    }
    return 0
}

// The code point of the (already validated) character of length `k` at the
// current position.
fn decode_cp(d: *mut Doc, k: usize) -> u32 {
    let c: u32 = at_byte(d, 0) as u32
    if k == 1 {
        return c
    }
    let c1: u32 = at_byte(d, 1) as u32
    if k == 2 {
        return ((c & 31 as u32) << 6) | (c1 & 63 as u32)
    }
    let c2: u32 = at_byte(d, 2) as u32
    if k == 3 {
        return ((c & 15 as u32) << 12) | ((c1 & 63 as u32) << 6)
        | (c2 & 63 as u32)
    }
    let c3: u32 = at_byte(d, 3) as u32
    return ((c & 7 as u32) << 18) | ((c1 & 63 as u32) << 12)
    | ((c2 & 63 as u32) << 6) | (c3 & 63 as u32)
}

fn name_start_cp(cp: u32) -> bool {
    if cp < 128 as u32 {
        return (cp >= 97 as u32 && cp <= 122 as u32)
        || (cp >= 65 as u32 && cp <= 90 as u32) || cp == 95 as u32
        || cp == 58 as u32
    }
    return (cp >= 192 as u32 && cp <= 214 as u32)
    || (cp >= 216 as u32 && cp <= 246 as u32)
    || (cp >= 248 as u32 && cp <= 767 as u32)
    || (cp >= 880 as u32 && cp <= 893 as u32)
    || (cp >= 895 as u32 && cp <= 8191 as u32)
    || (cp >= 8204 as u32 && cp <= 8205 as u32)
    || (cp >= 8304 as u32 && cp <= 8591 as u32)
    || (cp >= 11264 as u32 && cp <= 12271 as u32)
    || (cp >= 12289 as u32 && cp <= 55295 as u32)
    || (cp >= 63744 as u32 && cp <= 64975 as u32)
    || (cp >= 65008 as u32 && cp <= 65533 as u32)
    || (cp >= 65536 as u32 && cp <= 983039 as u32)
}

fn name_cp(cp: u32) -> bool {
    if name_start_cp(cp) {
        return true
    }
    return cp == 45 as u32 || cp == 46 as u32
    || (cp >= 48 as u32 && cp <= 57 as u32) || cp == 183 as u32
    || (cp >= 768 as u32 && cp <= 879 as u32)
    || (cp >= 8255 as u32 && cp <= 8256 as u32)
}

// Reads a name at the current position. On success `*start` is the offset
// of the first octet in the input, the result the length in octets; 0 if
// there is no name here (nothing is consumed then).
fn scan_name(d: *mut Doc, start: *mut usize) -> usize {
    let begin: usize = (*d).at
    var first: bool = true
    var total: usize = 0
    while true {
        let k: usize = scan_char(d)
        if k == 0 {
            break
        }
        let cp: u32 = decode_cp(d, k)
        var good: bool = false
        if first {
            good = name_start_cp(cp)
        } else {
            good = name_cp(cp)
        }
        if !good {
            break
        }
        (*d).at = (*d).at + k
        (*d).col = (*d).col + 1
        total = total + k
        first = false
    }
    *start = begin
    return total
}

// ----------------------------------------------------------- the text sink

// Appends decoded octets to the OPEN text node of the current element, and
// opens a new one if there is none. Comments and PIs do not close it, so
// `a<!--x-->b` stays one node; an element tag does.
fn text_push(d: *mut Doc, p: u64, n: usize) -> bool {
    if n == 0 {
        return true
    }
    if (*d).text_node == NONE {
        let t: u32 = node_new(d, TEXT)
        if t == NONE {
            return false
        }
        append_child(d, (*d).cur, t)
        let nd: *mut Node = node_at(d, t)
        (*nd).off = (*d).blob_len as u64
        (*d).text_node = t
    }
    if !blob_push_bytes(d, p, n) {
        (*d).err = E_MEMORY
        return false
    }
    let nd: *mut Node = node_at(d, (*d).text_node)
    (*nd).len = (*nd).len + n as u32
    return true
}

// A code point as UTF-8 into `scratch` (4 octets); returns the length.
fn encode_cp(cp: u32, scratch: *mut [u8; 4]) -> usize {
    if cp < 128 as u32 {
        (*scratch)[0] = cp as u8
        return 1
    }
    if cp < 2048 as u32 {
        (*scratch)[0] = (192 as u32 | (cp >> 6)) as u8
        (*scratch)[1] = (128 as u32 | (cp & 63 as u32)) as u8
        return 2
    }
    if cp < 65536 as u32 {
        (*scratch)[0] = (224 as u32 | (cp >> 12)) as u8
        (*scratch)[1] = (128 as u32 | ((cp >> 6) & 63 as u32)) as u8
        (*scratch)[2] = (128 as u32 | (cp & 63 as u32)) as u8
        return 3
    }
    (*scratch)[0] = (240 as u32 | (cp >> 18)) as u8
    (*scratch)[1] = (128 as u32 | ((cp >> 12) & 63 as u32)) as u8
    (*scratch)[2] = (128 as u32 | ((cp >> 6) & 63 as u32)) as u8
    (*scratch)[3] = (128 as u32 | (cp & 63 as u32)) as u8
    return 4
}

// `into_attr`: the octets go straight to the blob (an attribute value);
// otherwise to the open text node.
fn sink(d: *mut Doc, p: u64, n: usize, into_attr: bool) -> bool {
    if into_attr {
        if !blob_push_bytes(d, p, n) {
            (*d).err = E_MEMORY
            return false
        }
        return true
    }
    return text_push(d, p, n)
}

fn is_xml_char_cp(cp: u32) -> bool {
    if cp < 32 as u32 {
        return cp == 9 as u32 || cp == 10 as u32 || cp == 13 as u32
    }
    if cp >= 55296 as u32 && cp <= 57343 as u32 {
        return false
    }
    if cp == 65534 as u32 || cp == 65535 as u32 {
        return false
    }
    return cp <= 1114111 as u32
}

// The reference at the current position (`&` is next). Pushes the character
// it stands for. The position of an error is the `&`.
fn parse_ref(d: *mut Doc, into_attr: bool) -> bool {
    let l0: usize = (*d).line
    let c0: usize = (*d).col
    advance(d) // &
    let c: i32 = peek(d)
    if c == 35 { // &#
        advance(d)
        var hex: bool = false
        if peek(d) == 120 {
            hex = true
            advance(d)
        }
        var v: u64 = 0
        var digits: usize = 0
        while true {
            let x: i32 = peek(d)
            var dv: i32 = -1
            if x >= 48 && x <= 57 {
                dv = x - 48
            } else if hex && x >= 97 && x <= 102 {
                dv = x - 87
            } else if hex && x >= 65 && x <= 70 {
                dv = x - 55
            }
            if dv < 0 {
                break
            }
            advance(d)
            digits = digits + 1
            if hex {
                v = v * 16 + dv as u64
            } else {
                v = v * 10 + dv as u64
            }
            if v > 1114111 {
                v = 1114112 // out of range for good; stop growing
            }
        }
        if digits == 0 || peek(d) != 59 {
            fail_at(d, E_CHARREF, l0, c0)
            return false
        }
        advance(d) // ;
        if !is_xml_char_cp(v as u32) {
            fail_at(d, E_CHARREF, l0, c0)
            return false
        }
        var sc: [u8; 4] = [0; 4]
        let k: usize = encode_cp(v as u32, &sc)
        return sink(d, (&sc[0]) as u64, k, into_attr)
    }
    var start: usize = 0
    let k: usize = scan_name(d, &start)
    var ch: u8 = 0 as u8
    if k == 2 && rt.ld8((*d).src, start) == 108 as u8
    && rt.ld8((*d).src, start + 1) == 116 as u8 {
        ch = 60 as u8 // lt
    } else if k == 2 && rt.ld8((*d).src, start) == 103 as u8
    && rt.ld8((*d).src, start + 1) == 116 as u8 {
        ch = 62 as u8 // gt
    } else if k == 3 && rt.ld8((*d).src, start) == 97 as u8
    && rt.ld8((*d).src, start + 1) == 109 as u8
    && rt.ld8((*d).src, start + 2) == 112 as u8 {
        ch = 38 as u8 // amp
    } else if k == 4 && rt.ld8((*d).src, start) == 113 as u8
    && rt.ld8((*d).src, start + 1) == 117 as u8
    && rt.ld8((*d).src, start + 2) == 111 as u8
    && rt.ld8((*d).src, start + 3) == 116 as u8 {
        ch = 34 as u8 // quot
    } else if k == 4 && rt.ld8((*d).src, start) == 97 as u8
    && rt.ld8((*d).src, start + 1) == 112 as u8
    && rt.ld8((*d).src, start + 2) == 111 as u8
    && rt.ld8((*d).src, start + 3) == 115 as u8 {
        ch = 39 as u8 // apos
    }
    if ch == 0 as u8 || peek(d) != 59 {
        fail_at(d, E_ENTITY, l0, c0)
        return false
    }
    advance(d) // ;
    var one: [u8; 1] = [ch; 1]
    return sink(d, (&one[0]) as u64, 1, into_attr)
}

// Character data up to the next `<` (text) or up to `quote` (attribute
// value, `quote` is 34 or 39; then `<` is an error and every white space
// becomes a blank). ASCII runs are copied in one piece.
fn scan_chars(d: *mut Doc, into_attr: bool, quote: i32) -> bool {
    while true {
        // the plain run
        let run0: usize = (*d).at
        var j: usize = run0
        while j < (*d).n {
            let b: i32 = rt.ld8((*d).src, j) as i32
            if b < 32 || b >= 128 || b == 60 || b == 38 || b == 93
            || b == quote {
                break
            }
            j = j + 1
        }
        if j > run0 {
            if !sink(d, (*d).src + run0 as u64, j - run0, into_attr) {
                return false
            }
            (*d).col = (*d).col + (j - run0)
            (*d).at = j
        }
        let c: i32 = peek(d)
        if c < 0 {
            return true // the caller decides whether the end is an error
        }
        if c == quote {
            return true
        }
        if c == 60 {
            if into_attr {
                fail(d, E_LT_IN_ATTR)
                return false
            }
            return true
        }
        if c == 38 {
            if !parse_ref(d, into_attr) {
                return false
            }
        } else if c == 93 {
            if !into_attr && at_byte(d, 1) == 93 && at_byte(d, 2) == 62 {
                fail(d, E_CDEND)
                return false
            }
            advance(d)
            var one: [u8; 1] = [93 as u8; 1]
            if !sink(d, (&one[0]) as u64, 1, into_attr) {
                return false
            }
        } else if c == 9 || c == 10 || c == 13 {
            let b: i32 = advance(d) // 10 for CR, CR LF and LF
            var o: [u8; 1] = [b as u8; 1]
            if into_attr {
                o[0] = 32 as u8
            }
            if !sink(d, (&o[0]) as u64, 1, into_attr) {
                return false
            }
        } else {
            let k: usize = scan_char(d)
            if k == 0 {
                fail_char(d, c)
                return false
            }
            if !sink(d, (*d).src + (*d).at as u64, k, into_attr) {
                return false
            }
            (*d).at = (*d).at + k
            (*d).col = (*d).col + 1
        }
    }
    return true
}

// ------------------------------------------------------- comments and PIs

// `<!--` is next. Skips to after `-->`. `--` anywhere else is an error.
fn skip_comment(d: *mut Doc) -> bool {
    skip_lit(d, "<!--")
    while true {
        let c: i32 = peek(d)
        if c < 0 {
            fail(d, E_EOF)
            return false
        }
        if c == 45 && at_byte(d, 1) == 45 {
            if at_byte(d, 2) == 62 {
                skip_lit(d, "-->")
                return true
            }
            fail(d, E_COMMENT)
            return false
        }
        if c == 10 || c == 13 {
            advance(d)
        } else {
            let k: usize = scan_char(d)
            if k == 0 {
                fail_char(d, c)
                return false
            }
            (*d).at = (*d).at + k
            (*d).col = (*d).col + 1
        }
    }
    return false
}

fn name_is(d: *mut Doc, start: usize, k: usize, lit: str) -> bool {
    return k == lit.n && rt.mem_eq((*d).src + start as u64, lit.p as u64, k)
}

fn name_is_xml_nocase(d: *mut Doc, start: usize, k: usize) -> bool {
    if k != 3 {
        return false
    }
    let a: u8 = rt.ld8((*d).src, start) | 32 as u8
    let b: u8 = rt.ld8((*d).src, start + 1) | 32 as u8
    let c: u8 = rt.ld8((*d).src, start + 2) | 32 as u8
    return a == 120 as u8 && b == 109 as u8 && c == 108 as u8
}

// One pseudo attribute of the XML declaration (`version="1.0"`): the name is
// `lit`, the value goes to `*vstart`/`*vlen`.
fn decl_pair(d: *mut Doc, lit: str, vstart: *mut usize, vlen: *mut usize) -> bool {
    let l0: usize = (*d).line
    let c0: usize = (*d).col
    if !starts(d, lit) {
        fail_at(d, E_XMLDECL, l0, c0)
        return false
    }
    skip_lit(d, lit)
    skip_space(d)
    if peek(d) != 61 {
        fail(d, E_XMLDECL)
        return false
    }
    advance(d)
    skip_space(d)
    let q: i32 = peek(d)
    if q != 34 && q != 39 {
        fail(d, E_XMLDECL)
        return false
    }
    advance(d)
    *vstart = (*d).at
    while true {
        let c: i32 = peek(d)
        if c == q {
            break
        }
        let ok: bool = (c >= 97 && c <= 122) || (c >= 65 && c <= 90)
        || (c >= 48 && c <= 57) || c == 46 || c == 45 || c == 95
        if !ok {
            fail(d, E_XMLDECL)
            return false
        }
        advance(d)
    }
    *vlen = (*d).at - *vstart
    advance(d) // the closing quote
    return true
}

fn lower(c: u8) -> u8 {
    if c >= 65 as u8 && c <= 90 as u8 {
        return c + 32 as u8
    }
    return c
}

// `<?xml` has been consumed. Checks version, encoding, standalone.
fn parse_xml_decl(d: *mut Doc) -> bool {
    if skip_space(d) == 0 {
        fail(d, E_XMLDECL)
        return false
    }
    var vs: usize = 0
    var vl: usize = 0
    if !decl_pair(d, "version", &vs, &vl) {
        return false
    }
    // 1.<digit>+
    var okv: bool = vl >= 3 && rt.ld8((*d).src, vs) == 49 as u8
    && rt.ld8((*d).src, vs + 1) == 46 as u8
    var i: usize = 2
    while okv && i < vl {
        let c: u8 = rt.ld8((*d).src, vs + i)
        if c < 48 as u8 || c > 57 as u8 {
            okv = false
        }
        i = i + 1
    }
    if !okv {
        fail(d, E_XMLDECL)
        return false
    }
    var sp: usize = skip_space(d)
    if sp > 0 && starts(d, "encoding") {
        if !decl_pair(d, "encoding", &vs, &vl) {
            return false
        }
        // only UTF-8 is read (X2)
        var utf8: bool = vl == 5
        if utf8 {
            var j: usize = 0
            var want: str = "utf-8"
            while j < 5 {
                if lower(rt.ld8((*d).src, vs + j)) != rt.ld8(want.p as u64, j) {
                    utf8 = false
                }
                j = j + 1
            }
        }
        if !utf8 {
            fail(d, E_ENCODING)
            return false
        }
        sp = skip_space(d)
    }
    if sp > 0 && starts(d, "standalone") {
        if !decl_pair(d, "standalone", &vs, &vl) {
            return false
        }
        var ok: bool = false
        var yes: str = "yes"
        var no: str = "no"
        if vl == 3 && rt.mem_eq((*d).src + vs as u64, yes.p as u64, 3) {
            ok = true
        }
        if vl == 2 && rt.mem_eq((*d).src + vs as u64, no.p as u64, 2) {
            ok = true
        }
        if !ok {
            fail(d, E_XMLDECL)
            return false
        }
        skip_space(d)
    }
    if !starts(d, "?>") {
        fail(d, E_XMLDECL)
        return false
    }
    skip_lit(d, "?>")
    return true
}

// `<?` is next. `decl_ok`: the declaration may stand here (very first thing
// of the input).
fn parse_pi(d: *mut Doc, decl_ok: bool) -> bool {
    skip_lit(d, "<?")
    var start: usize = 0
    let k: usize = scan_name(d, &start)
    if k == 0 {
        fail(d, E_PI)
        return false
    }
    if name_is_xml_nocase(d, start, k) {
        if decl_ok && name_is(d, start, k, "xml") {
            return parse_xml_decl(d)
        }
        // reserved target, or a declaration that is not first
        fail_at(d, E_XMLDECL, (*d).line, (*d).col)
        return false
    }
    if !starts(d, "?>") {
        if !is_space(peek(d)) {
            fail(d, E_PI)
            return false
        }
        while true {
            let c: i32 = peek(d)
            if c < 0 {
                fail(d, E_EOF)
                return false
            }
            if c == 63 && at_byte(d, 1) == 62 {
                break
            }
            if c == 10 || c == 13 {
                advance(d)
            } else {
                let n: usize = scan_char(d)
                if n == 0 {
                    fail_char(d, c)
                    return false
                }
                (*d).at = (*d).at + n
                (*d).col = (*d).col + 1
            }
        }
    }
    skip_lit(d, "?>")
    return true
}

fn parse_cdata(d: *mut Doc) -> bool {
    skip_lit(d, "<![CDATA[")
    while true {
        let c: i32 = peek(d)
        if c < 0 {
            fail(d, E_EOF)
            return false
        }
        if c == 93 && at_byte(d, 1) == 93 && at_byte(d, 2) == 62 {
            skip_lit(d, "]]>")
            return true
        }
        if c == 10 || c == 13 {
            let b: i32 = advance(d)
            var o: [u8; 1] = [b as u8; 1]
            if !text_push(d, (&o[0]) as u64, 1) {
                return false
            }
        } else {
            let k: usize = scan_char(d)
            if k == 0 {
                fail_char(d, c)
                return false
            }
            if !text_push(d, (*d).src + (*d).at as u64, k) {
                return false
            }
            (*d).at = (*d).at + k
            (*d).col = (*d).col + 1
        }
    }
    return false
}

// ---------------------------------------------------------------- the tags

// `<` and a name start are next. Reads the start tag, creates the element
// and its attributes. Returns false on an error; `*empty` tells `<a/>`.
fn parse_start_tag(d: *mut Doc, empty: *mut bool) -> bool {
    let l0: usize = (*d).line
    let c0: usize = (*d).col
    advance(d) // <
    var ns: usize = 0
    let nk: usize = scan_name(d, &ns)
    if nk == 0 {
        fail(d, E_NAME)
        return false
    }
    (*d).text_node = NONE
    let el: u32 = node_new(d, ELEMENT)
    if el == NONE {
        return false
    }
    (*node_at(d, el)).line = l0 as u32
    if (*d).cur != NONE {
        append_child(d, (*d).cur, el)
    }
    let noff: usize = (*d).blob_len
    if !blob_push_bytes(d, (*d).src + ns as u64, nk) {
        (*d).err = E_MEMORY
        return false
    }
    (*node_at(d, el)).off = noff as u64
    (*node_at(d, el)).len = nk as u32
    var nattr: usize = 0
    while true {
        let sp: usize = skip_space(d)
        let c: i32 = peek(d)
        if c < 0 {
            fail(d, E_EOF)
            return false
        }
        if c == 62 {
            advance(d)
            *empty = false
            break
        }
        if c == 47 {
            if at_byte(d, 1) != 62 {
                fail(d, E_TAG_CLOSE)
                return false
            }
            skip_lit(d, "/>")
            *empty = true
            break
        }
        if sp == 0 {
            fail(d, E_ATTR_SPACE)
            return false
        }
        // an attribute
        let la: usize = (*d).line
        let ca: usize = (*d).col
        var as_: usize = 0
        let ak: usize = scan_name(d, &as_)
        if ak == 0 {
            fail(d, E_NAME)
            return false
        }
        skip_space(d)
        if peek(d) != 61 {
            fail(d, E_ATTR_EQ)
            return false
        }
        advance(d)
        skip_space(d)
        let q: i32 = peek(d)
        if q != 34 && q != 39 {
            fail(d, E_ATTR_QUOTE)
            return false
        }
        advance(d)
        if nattr >= XML_MAX_ATTRS {
            fail_at(d, E_LIMIT, la, ca)
            return false
        }
        // duplicate check against the attributes of this element
        let first_a: usize = (*node_at(d, el)).afirst as usize
        var t: usize = 0
        while t < nattr {
            let o: *mut Attr = attr_at(d, first_a + t)
            if (*o).nlen as usize == ak
            && rt.mem_eq((*d).blob + (*o).noff, (*d).src + as_ as u64, ak) {
                fail_at(d, E_ATTR_DUP, la, ca)
                return false
            }
            t = t + 1
        }
        if !attrs_reserve(d) {
            (*d).err = E_MEMORY
            return false
        }
        let noff2: usize = (*d).blob_len
        if !blob_push_bytes(d, (*d).src + as_ as u64, ak) {
            (*d).err = E_MEMORY
            return false
        }
        let voff: usize = (*d).blob_len
        if !scan_chars(d, true, q) {
            return false
        }
        if peek(d) != q {
            fail(d, E_EOF)
            return false
        }
        advance(d) // the closing quote
        let a: *mut Attr = attr_at(d, (*d).acount)
        (*a).noff = noff2 as u64
        (*a).nlen = ak as u32
        (*a).voff = voff as u64
        (*a).vlen = ((*d).blob_len - voff) as u32
        (*d).acount = (*d).acount + 1
        nattr = nattr + 1
        (*node_at(d, el)).nattr = nattr as u32
    }
    if (*d).cur == NONE {
        (*d).root = el
    }
    if !*empty {
        if (*d).depth >= XML_MAX_DEPTH {
            fail(d, E_DEPTH)
            return false
        }
        (*d).cur = el
        (*d).depth = (*d).depth + 1
    }
    return true
}

// `</` is next.
fn parse_end_tag(d: *mut Doc) -> bool {
    skip_lit(d, "</")
    let l0: usize = (*d).line
    let c0: usize = (*d).col
    var ns: usize = 0
    let nk: usize = scan_name(d, &ns)
    if nk == 0 {
        fail(d, E_NAME)
        return false
    }
    let cn: *mut Node = node_at(d, (*d).cur)
    if (*cn).len as usize != nk
    || !rt.mem_eq((*d).blob + (*cn).off, (*d).src + ns as u64, nk) {
        fail_at(d, E_TAG_MISMATCH, l0, c0)
        return false
    }
    skip_space(d)
    if peek(d) != 62 {
        fail(d, E_TAG_CLOSE)
        return false
    }
    advance(d)
    (*d).text_node = NONE
    (*d).cur = (*cn).parent
    (*d).depth = (*d).depth - 1
    return true
}

// state: 0 = before the root, 1 = inside it, 2 = after it
fn run(d: *mut Doc) {
    var state: usize = 0
    // a UTF-8 BOM is skipped; the UTF-16 ones are refused
    if (*d).n >= 3 && rt.ld8((*d).src, 0) == 239 as u8
    && rt.ld8((*d).src, 1) == 187 as u8 && rt.ld8((*d).src, 2) == 191 as u8 {
        (*d).at = 3
    } else if (*d).n >= 2 && ((rt.ld8((*d).src, 0) == 255 as u8
            && rt.ld8((*d).src, 1) == 254 as u8)
        || (rt.ld8((*d).src, 0) == 254 as u8 && rt.ld8((*d).src, 1) == 255 as u8)) {
        fail(d, E_ENCODING)
        return
    }
    let start_at: usize = (*d).at
    while (*d).err == E_NONE {
        if state != 1 {
            skip_space(d)
        }
        let c: i32 = peek(d)
        if c < 0 {
            if state == 1 {
                fail(d, E_EOF)
            } else if state == 0 {
                fail(d, E_NO_ROOT)
            }
            return
        }
        if c != 60 {
            if state != 1 {
                fail(d, E_JUNK)
                return
            }
            if !scan_chars(d, false, -1) {
                return
            }
            continue
        }
        let c1: i32 = at_byte(d, 1)
        if c1 == 47 { // </
            if state != 1 {
                fail(d, E_JUNK)
                return
            }
            if !parse_end_tag(d) {
                return
            }
            if (*d).cur == NONE {
                state = 2
            }
        } else if c1 == 63 { // <?
            if !parse_pi(d, (*d).at == start_at) {
                return
            }
        } else if c1 == 33 { // <!
            if starts(d, "<!--") {
                if !skip_comment(d) {
                    return
                }
            } else if starts(d, "<![CDATA[") {
                if state != 1 {
                    fail(d, E_JUNK)
                    return
                }
                if !parse_cdata(d) {
                    return
                }
            } else if starts(d, "<!DOCTYPE") {
                fail(d, E_DTD)
                return
            } else {
                fail(d, E_SYNTAX)
                return
            }
        } else {
            if state == 2 {
                fail(d, E_JUNK)
                return
            }
            var empty: bool = false
            if !parse_start_tag(d, &empty) {
                return
            }
            if empty && (*d).cur == NONE {
                state = 2
            } else {
                state = 1
            }
        }
    }
}

fn parse(d: *mut Doc, p: u64, n: usize) -> XmlError!bool {
    (*d).src = p
    (*d).n = n
    (*d).at = 0
    (*d).line = 1
    (*d).col = 1
    (*d).err = E_NONE
    (*d).err_line = 0
    (*d).err_col = 0
    (*d).depth = 0
    (*d).root = NONE
    (*d).count = 0
    (*d).acount = 0
    (*d).blob_len = 0
    (*d).cur = NONE
    (*d).text_node = NONE

    run(d)

    if (*d).err != E_NONE {
        (*d).root = NONE
        if (*d).err == E_MEMORY {
            return XmlError::OutOfMemory
        }
        if (*d).err == E_DEPTH {
            return XmlError::Depth
        }
        if (*d).err == E_LIMIT {
            return XmlError::Limit
        }
        return XmlError::Syntax
    }
    return true
}

fn parse_str(d: *mut Doc, s: str) -> XmlError!bool {
    return parse(d, s.p as u64, s.n)
}

// ------------------------------------------------------------- inspection

fn valid(d: *mut Doc) -> bool {
    return (*d).err == E_NONE && (*d).root != NONE
}

fn root(d: *mut Doc) -> u32 {
    return (*d).root
}

fn err_line(d: *mut Doc) -> usize {
    return (*d).err_line
}

fn err_col(d: *mut Doc) -> usize {
    return (*d).err_col
}

fn err_code(d: *mut Doc) -> usize {
    return (*d).err
}

fn err_text(d: *mut Doc) -> str {
    let e: usize = (*d).err
    if e == E_SYNTAX { return "not well-formed" }
    if e == E_EOF { return "the input ends too early" }
    if e == E_NO_ROOT { return "no root element" }
    if e == E_JUNK { return "content outside of the root element" }
    if e == E_NAME { return "a name was expected" }
    if e == E_ATTR_EQ { return "'=' expected after an attribute name" }
    if e == E_ATTR_QUOTE { return "an attribute value must be quoted" }
    if e == E_ATTR_DUP { return "duplicate attribute" }
    if e == E_ATTR_SPACE { return "white space expected between attributes" }
    if e == E_LT_IN_ATTR { return "'<' in an attribute value" }
    if e == E_TAG_MISMATCH { return "the end tag does not match the start tag" }
    if e == E_TAG_CLOSE { return "'>' expected" }
    if e == E_ENTITY { return "undefined entity or malformed reference" }
    if e == E_CHARREF { return "invalid character reference" }
    if e == E_CDEND { return "']]>' in text" }
    if e == E_COMMENT { return "'--' inside a comment" }
    if e == E_PI { return "bad processing instruction" }
    if e == E_XMLDECL { return "bad or misplaced XML declaration" }
    if e == E_ENCODING { return "only UTF-8 is supported" }
    if e == E_DTD { return "DOCTYPE is not supported" }
    if e == E_CHAR { return "invalid character" }
    if e == E_UTF8 { return "invalid UTF-8" }
    if e == E_DEPTH { return "nested too deeply" }
    if e == E_LIMIT { return "too many attributes" }
    if e == E_MEMORY { return "out of memory" }
    return "no error"
}

fn in_range(d: *mut Doc, i: u32) -> bool {
    return i != NONE && (i as usize) < (*d).count
}

fn kind(d: *mut Doc, i: u32) -> u8 {
    if !in_range(d, i) {
        return TEXT
    }
    return (*node_at(d, i)).kind
}

fn first(d: *mut Doc, i: u32) -> u32 {
    if !in_range(d, i) {
        return NONE
    }
    return (*node_at(d, i)).first
}

fn last(d: *mut Doc, i: u32) -> u32 {
    if !in_range(d, i) {
        return NONE
    }
    return (*node_at(d, i)).last
}

fn next(d: *mut Doc, i: u32) -> u32 {
    if !in_range(d, i) {
        return NONE
    }
    return (*node_at(d, i)).next
}

fn parent(d: *mut Doc, i: u32) -> u32 {
    if !in_range(d, i) {
        return NONE
    }
    return (*node_at(d, i)).parent
}

fn child_count(d: *mut Doc, i: u32) -> usize {
    if !in_range(d, i) {
        return 0
    }
    return (*node_at(d, i)).nchild as usize
}

// The line of the start tag (elements) or of the node's creation (text).
fn line(d: *mut Doc, i: u32) -> usize {
    if !in_range(d, i) {
        return 0
    }
    return (*node_at(d, i)).line as usize
}

fn blob_str(d: *mut Doc, off: u64, n: usize) -> str {
    if n == 0 {
        return ""
    }
    return str { p: ((*d).blob + off) as *mut u8, n: n }
}

// The name of an element; "" for a text node.
fn name(d: *mut Doc, i: u32) -> str {
    if !in_range(d, i) {
        return ""
    }
    let nd: *mut Node = node_at(d, i)
    if (*nd).kind != ELEMENT {
        return ""
    }
    return blob_str(d, (*nd).off, (*nd).len as usize)
}

// A text node: its text. An element: the text BEFORE its first child
// element (`Element.text` of xml.etree), "" if it starts with an element.
fn text(d: *mut Doc, i: u32) -> str {
    if !in_range(d, i) {
        return ""
    }
    let nd: *mut Node = node_at(d, i)
    if (*nd).kind == TEXT {
        return blob_str(d, (*nd).off, (*nd).len as usize)
    }
    if (*nd).first != NONE {
        let f: *mut Node = node_at(d, (*nd).first)
        if (*f).kind == TEXT {
            return blob_str(d, (*f).off, (*f).len as usize)
        }
    }
    return ""
}

// All text below `i`, in document order, appended to `out`
// (`"".join(e.itertext())`).
fn text_all(d: *mut Doc, i: u32, out: *mut rt.Buf) {
    if !in_range(d, i) {
        return
    }
    var cur: u32 = i
    while true {
        let nd: *mut Node = node_at(d, cur)
        if (*nd).kind == TEXT {
            rt.buf_push_bytes(out, (*d).blob + (*nd).off, (*nd).len as usize)
        } else if (*nd).first != NONE {
            cur = (*nd).first
            continue
        }
        while true {
            if cur == i {
                return
            }
            let nx: u32 = (*node_at(d, cur)).next
            if nx != NONE {
                cur = nx
                break
            }
            cur = (*node_at(d, cur)).parent
        }
    }
}

fn attr_count(d: *mut Doc, i: u32) -> usize {
    if !in_range(d, i) {
        return 0
    }
    return (*node_at(d, i)).nattr as usize
}

fn attr_slot(d: *mut Doc, i: u32, k: usize) -> *mut Attr {
    return attr_at(d, (*node_at(d, i)).afirst as usize + k)
}

// The name / value of the k-th attribute, in document order.
fn attr_name(d: *mut Doc, i: u32, k: usize) -> str {
    if k >= attr_count(d, i) {
        return ""
    }
    let a: *mut Attr = attr_slot(d, i, k)
    return blob_str(d, (*a).noff, (*a).nlen as usize)
}

fn attr_value(d: *mut Doc, i: u32, k: usize) -> str {
    if k >= attr_count(d, i) {
        return ""
    }
    let a: *mut Attr = attr_slot(d, i, k)
    return blob_str(d, (*a).voff, (*a).vlen as usize)
}

fn attr_find(d: *mut Doc, i: u32, key: str) -> usize {
    let cnt: usize = attr_count(d, i)
    var k: usize = 0
    while k < cnt {
        let a: *mut Attr = attr_slot(d, i, k)
        if (*a).nlen as usize == key.n
        && rt.mem_eq((*d).blob + (*a).noff, key.p as u64, key.n) {
            return k
        }
        k = k + 1
    }
    return cnt
}

fn has_attr(d: *mut Doc, i: u32, key: str) -> bool {
    return attr_find(d, i, key) < attr_count(d, i)
}

// The value of the attribute `key`, "" if there is none (`has_attr` tells
// "absent" from "empty").
fn attr(d: *mut Doc, i: u32, key: str) -> str {
    let k: usize = attr_find(d, i, key)
    return attr_value(d, i, k)
}

fn is_named(d: *mut Doc, i: u32, key: str) -> bool {
    let nd: *mut Node = node_at(d, i)
    return (*nd).kind == ELEMENT && (*nd).len as usize == key.n
    && rt.mem_eq((*d).blob + (*nd).off, key.p as u64, key.n)
}

// The first child ELEMENT of `i` called `key` (xml.NONE if none).
fn child(d: *mut Doc, i: u32, key: str) -> u32 {
    var c: u32 = first(d, i)
    while c != NONE {
        if is_named(d, c, key) {
            return c
        }
        c = next(d, c)
    }
    return NONE
}

// The next sibling ELEMENT after `i` called `key`. With `child` this
// iterates all children of that name.
fn next_named(d: *mut Doc, i: u32, key: str) -> u32 {
    var c: u32 = next(d, i)
    while c != NONE {
        if is_named(d, c, key) {
            return c
        }
        c = next(d, c)
    }
    return NONE
}

// All child elements called `key`: the first `cap` of them are stored in
// `out`; the result is how many there ARE (as `snprintf`: a result above
// `cap` means the list was cut).
fn children_named(d: *mut Doc, i: u32, key: str, out: *mut u32, cap: usize) -> usize {
    var found: usize = 0
    var c: u32 = child(d, i, key)
    while c != NONE {
        if found < cap {
            *((out as u64 + (found * 4) as u64) as *mut u32) = c
        }
        found = found + 1
        c = next_named(d, c, key)
    }
    return found
}

// ================================================================ WRITING

fn put_lit(out: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(out, s.p as u64, s.n)
}

fn write_text(out: *mut rt.Buf, p: u64, n: usize, in_attr: bool) {
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c == 38 as u8 {
            put_lit(out, "&amp;")
        } else if c == 60 as u8 {
            put_lit(out, "&lt;")
        } else if c == 62 as u8 {
            put_lit(out, "&gt;")
        } else if c == 13 as u8 {
            put_lit(out, "&#13;")
        } else if in_attr && c == 34 as u8 {
            put_lit(out, "&quot;")
        } else if in_attr && c == 9 as u8 {
            put_lit(out, "&#9;")
        } else if in_attr && c == 10 as u8 {
            put_lit(out, "&#10;")
        } else {
            rt.buf_push(out, c)
        }
        i = i + 1
    }
}

fn write_open(d: *mut Doc, i: u32, out: *mut rt.Buf, closed: bool) {
    let nd: *mut Node = node_at(d, i)
    rt.buf_push(out, 60 as u8)
    rt.buf_push_bytes(out, (*d).blob + (*nd).off, (*nd).len as usize)
    let cnt: usize = (*nd).nattr as usize
    var k: usize = 0
    while k < cnt {
        let a: *mut Attr = attr_slot(d, i, k)
        rt.buf_push(out, 32 as u8)
        rt.buf_push_bytes(out, (*d).blob + (*a).noff, (*a).nlen as usize)
        rt.buf_push(out, 61 as u8)
        rt.buf_push(out, 34 as u8)
        write_text(out, (*d).blob + (*a).voff, (*a).vlen as usize, true)
        rt.buf_push(out, 34 as u8)
        k = k + 1
    }
    if closed {
        rt.buf_push(out, 47 as u8)
    }
    rt.buf_push(out, 62 as u8)
}

// The subtree at `node` as compact XML, appended to `out` (X7). Iterative:
// the depth of the tree cannot overflow the stack.
fn write(d: *mut Doc, node: u32, out: *mut rt.Buf) {
    if !in_range(d, node) {
        return
    }
    var i: u32 = node
    while true {
        let nd: *mut Node = node_at(d, i)
        var descend: bool = false
        if (*nd).kind == TEXT {
            write_text(out, (*d).blob + (*nd).off, (*nd).len as usize, false)
        } else if (*nd).first == NONE {
            write_open(d, i, out, true)
        } else {
            write_open(d, i, out, false)
            descend = true
        }
        if descend {
            i = (*nd).first
            continue
        }
        while true {
            if i == node {
                return
            }
            let nx: u32 = (*node_at(d, i)).next
            if nx != NONE {
                i = nx
                break
            }
            i = (*node_at(d, i)).parent
            let pn: *mut Node = node_at(d, i)
            put_lit(out, "</")
            rt.buf_push_bytes(out, (*d).blob + (*pn).off, (*pn).len as usize)
            rt.buf_push(out, 62 as u8)
            if i == node {
                return
            }
        }
    }
}
