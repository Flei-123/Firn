// SPDX-License-Identifier: MPL-2.0
import rt
import vec
import testkit

export { Spy, spy_new, spy_ctx, spy_from_ctx, spy_free, spy_reset, spy_returns, spy_default, spy_call0, spy_call1, spy_call2, spy_call3,
    spy_count, spy_arg, assert_calls, assert_never_called, assert_call1, assert_call2, assert_call3,
    CallLog, log_new, log_free, log_add, assert_log }

const SPY_MAX_ARGS: usize = 3

struct Spy {
    args: Vec[i64],
    calls: usize,
    script: Vec[i64],
    next: usize,
    fallback: i64,
}

fn spy_new() -> Spy {
    return Spy { args: vec_new[i64](), calls: 0, script: vec_new[i64](), next: 0, fallback: 0 }
}

fn spy_ctx(s: *mut Spy) -> u64 {
    return s as u64
}

fn spy_from_ctx(ctx: u64) -> *mut Spy {
    return ctx as *mut Spy
}

fn spy_free(s: *mut Spy) {
    vec_free[i64](&(*s).args)
    vec_free[i64](&(*s).script)
}

fn spy_reset(s: *mut Spy) {
    vec_clear[i64](&(*s).args)
    vec_clear[i64](&(*s).script)
    (*s).calls = 0
    (*s).next = 0
}

fn spy_returns(s: *mut Spy, value: i64) {
    vec_push[i64](&(*s).script, value)
}

fn spy_default(s: *mut Spy, value: i64) {
    (*s).fallback = value
}

fn spy_record(s: *mut Spy, a: i64, b: i64, c: i64) -> i64 {
    vec_push[i64](&(*s).args, a)
    vec_push[i64](&(*s).args, b)
    vec_push[i64](&(*s).args, c)
    (*s).calls = (*s).calls + 1
    if (*s).next < vec_len[i64](&(*s).script) {
        let value: i64 = vec_at[i64](&(*s).script, (*s).next)
        (*s).next = (*s).next + 1
        return value
    }
    return (*s).fallback
}

fn spy_call0(s: *mut Spy) -> i64 {
    return spy_record(s, 0, 0, 0)
}

fn spy_call1(s: *mut Spy, a: i64) -> i64 {
    return spy_record(s, a, 0, 0)
}

fn spy_call2(s: *mut Spy, a: i64, b: i64) -> i64 {
    return spy_record(s, a, b, 0)
}

fn spy_call3(s: *mut Spy, a: i64, b: i64, c: i64) -> i64 {
    return spy_record(s, a, b, c)
}

fn spy_count(s: *mut Spy) -> usize {
    return (*s).calls
}

fn spy_arg(s: *mut Spy, call: usize, index: usize) -> i64 {
    if call >= (*s).calls || index >= SPY_MAX_ARGS {
        return 0
    }
    return vec_at[i64](&(*s).args, call * SPY_MAX_ARGS + index)
}

fn assert_calls(s: *mut Spy, want: usize) {
    testkit.context("spy call count")
    testkit.assert_eq_i64((*s).calls as i64, want as i64)
    testkit.context("")
}

fn assert_never_called(s: *mut Spy) {
    assert_calls(s, 0)
}

fn assert_call_arg(s: *mut Spy, call: usize, index: usize, want: i64) {
    if call >= (*s).calls {
        testkit.fail("spy was called fewer times than the assertion expects")
    }
    testkit.context("spy argument")
    testkit.assert_eq_i64(spy_arg(s, call, index), want)
    testkit.context("")
}

fn assert_call1(s: *mut Spy, call: usize, a: i64) {
    assert_call_arg(s, call, 0, a)
}

fn assert_call2(s: *mut Spy, call: usize, a: i64, b: i64) {
    assert_call_arg(s, call, 0, a)
    assert_call_arg(s, call, 1, b)
}

fn assert_call3(s: *mut Spy, call: usize, a: i64, b: i64, c: i64) {
    assert_call2(s, call, a, b)
    assert_call_arg(s, call, 2, c)
}

struct CallLog {
    text: rt.Buf,
}

fn log_new() -> CallLog {
    return CallLog { text: rt.buf_new() }
}

fn log_free(l: *mut CallLog) {
    rt.buf_free(&(*l).text)
}

fn log_add(l: *mut CallLog, event: str) {
    if (*l).text.len > 0 {
        rt.buf_push(&(*l).text, 44 as u8)
    }
    rt.buf_push_bytes(&(*l).text, event.p as u64, event.length())
}

fn assert_log(l: *mut CallLog, want: str) {
    testkit.assert_eq_buf(&(*l).text, want)
}
