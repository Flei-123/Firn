// SPDX-License-Identifier: MPL-2.0
// lib/std/secret_os.fi -- the operating system's own keyring, Linux side:
// there is none that a program without D-Bus can reach, so every call says
// "unavailable" and std.secret falls back to its encrypted file
// (the Secret Service of GNOME/KDE speaks D-Bus, which is out of scope --
// see std.secret HONEST S1).
//
// The Windows build takes `secret_os.windows.fi` instead (Credential
// Manager). The two files export the same names; the codes are:
//   0 ok, 1 not found, 2 unavailable (use the fallback), 3 too large,
//   4 refused / failed, 5 invalid name.

import std.rt

export { os_name, os_set, os_get, os_delete }

fn os_name() -> str {
    return "none"
}

fn os_set(service: str, key: str, p: u64, n: usize) -> u32 {
    return 2 as u32
}

fn os_get(service: str, key: str, out: *mut rt.Buf) -> u32 {
    return 2 as u32
}

fn os_delete(service: str, key: str) -> u32 {
    return 2 as u32
}
