// SPDX-License-Identifier: MPL-2.0
// lib/std/clipos.windows.fi -- the operating system half of std.clipboard on
// Windows (picked instead of lib/std/clipos.fi by `--target=x86_64-windows`).
// Use `std.clipboard`, not this file.
//
// Windows has the clipboard in the system itself (the window layer's win32.fi
// puts the data there at once), so there are no helper programs: every helper
// function answers "no" and the window layer does all the work.

import rt
import str

export {
    os_native_allowed, os_copy_first, os_paste_first,
    os_copy, os_paste, os_clear, os_tool_name,
}

fn os_native_allowed() -> bool {
    return true
}

fn os_copy_first(n: usize) -> bool {
    return false
}

fn os_paste_first() -> bool {
    return false
}

fn os_copy(mime: str, p: u64, n: usize) -> bool {
    return false
}

fn os_paste(mime: str, out: *mut rt.Buf) -> bool {
    return false
}

fn os_clear() -> bool {
    return false
}

fn os_tool_name() -> str {
    return ""
}
