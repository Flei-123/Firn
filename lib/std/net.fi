// SPDX-License-Identifier: MIT
// lib/std/net.fi -- TCP over raw Linux system calls (round 76).
//
// Up to round 75 the repository had exactly zero network code. Everything
// that was ever read came out of a file, everything that was ever written
// went into one. That is a comfortable place to stand: a file does not
// close under you, does not deliver half a buffer, and does not send you a
// signal when you write into it after the other side went away.
//
// A socket does all three.
//
// NO libc. `socket(2)`, `bind(2)`, `listen(2)`, `accept4(2)`, `connect(2)`,
// `setsockopt(2)`, `getsockname(2)`, `sendto(2)`, `recvfrom(2)`,
// `shutdown(2)` and `close(2)` are reached through the `syscall` intrinsic,
// exactly as `lib/std/rt.fi` reaches `mmap`. That is not purity for its own
// sake: the compiler has no C ABI dependency anywhere else either, and one
// here would make `profile kernel` a lie.
//
// -------------------------------------------------------------- THE ERRORS
//
// The kernel reports a failure as a return value in the range -1 .. -4095
// (the negated errno). Handing that number on to the caller as an `i64` is
// how C does it, and it is the reason why half of all C network code checks
// `< 0` in one place and forgets it in the next. Here every fallible
// function returns an error union `NetError!T` (SPEC 5.1); the raw errno is
// not lost -- it is written into `Conn.err` resp. reachable through the
// `*_err` variants, so that a caller who wants to tell ECONNRESET from
// EPIPE can.
//
// ---------------------------------------------------------- THE BYTE ORDER
//
// `sockaddr_in` carries the port and the address in NETWORK BYTE ORDER, and
// that is the single most productive source of error in this whole file.
// The struct is laid out so that the natural layout of Firn already is the
// C one (checked in `tests/1600_net_echo.fi`, not assumed):
//
//     offset 0   family  u16   AF_INET = 2, in HOST order (the kernel reads
//                              this field itself, it never goes on the wire)
//     offset 2   port    u16   BIG endian
//     offset 4   addr    u32   BIG endian
//     offset 8   zero    [u8;8] padding, has to be zero
//     ----------------------------------------------------------------
//     16 bytes
//
// The `family` field is the trap inside the trap: it is the one field of
// the structure that is NOT byte swapped, because it never leaves the
// machine. Whoever swaps it too gets EAFNOSUPPORT and looks for the mistake
// in the address.
//
// -------------------------------------------------------------- NO SIGPIPE
//
// Writing into a socket whose peer is gone raises SIGPIPE, and the default
// action for SIGPIPE is to kill the process. A server that dies because a
// client pressed Escape is not a server. There are two ways out; this file
// takes the one that needs no global state:
//
//   * `write` goes through `sendto(2)` with MSG_NOSIGNAL instead of
//     `write(2)`. The flag is per call, so nothing has to be installed at
//     startup and nothing can be forgotten in a second thread.
//   * the alternative -- `sigaction(SIGPIPE, SIG_IGN)` -- would be process
//     global state, and stage 0 has no globals to remember it in.
//
// `read` goes through `recvfrom(2)` for symmetry; with flags 0 that is
// `read(2)`, and `net_read_raw`/`net_write_raw` expose the plain
// `read(2)`/`write(2)` for whoever wants them.
//
// ------------------------------------------------------------------ HONEST
//
// N1  BLOCKING ONLY. There is no `O_NONBLOCK`, no `epoll`, no `poll`. The
//     concurrency model of this round is one thread per connection
//     (`thread_start`, round 49) -- which is exactly what the socket API
//     was designed for and what `demos/mcserver` does.
// N2  IPv4 ONLY. `AF_INET`, not `AF_INET6`. A `sockaddr_in6` is 28 bytes
//     and needs a scope id; nothing in this round wants it.
// N3  NO NAME RESOLUTION. `connect_tcp` takes a numeric address. A resolver
//     means /etc/resolv.conf, UDP, and a DNS message parser -- a round of
//     its own.
// N4  `read` RETURNS SHORT READS, and that is not a defect but the contract
//     of the system call: whoever wants exactly n octets calls `read_full`.
//     The single most common bug in first network code is treating one
//     `read` as one message.
// N5  EINTR IS RETRIED inside this file. A blocking `accept`/`read`/`write`
//     interrupted by a signal is not an error the caller can do anything
//     useful about.
// N6  NO TIMEOUTS unless the caller sets them (`set_timeout`, SO_RCVTIMEO).
//     A blocking `read` on a silent peer blocks forever.

import rt

export {
    NetError,
    Listener, Conn,
    ADDR_ANY, ADDR_LOCAL,
    ipv4, host_to_net_16, host_to_net_32,
    listen_tcp, listen_tcp_err, accept, accept_err,
    connect_tcp, connect_tcp_err, connect_unix,
    read, write, read_full, write_all,
    read_raw, write_raw,
    close, close_listener, shutdown_write,
    set_no_delay, set_timeout, set_reuse_addr,
    listener_port, listener_fd, listener_is_open,
    conn_fd, conn_is_open, conn_error, conn_from_fd, listener_from_fd,
    peer_addr, peer_port,
    errno_of,
}

// ------------------------------------------------------------ System calls

const SYS_READ: i64 = 0
const SYS_WRITE: i64 = 1
const SYS_CLOSE: i64 = 3
const SYS_SOCKET: i64 = 41
const SYS_CONNECT: i64 = 42
const SYS_SENDTO: i64 = 44
const SYS_RECVFROM: i64 = 45
const SYS_SHUTDOWN: i64 = 48
const SYS_BIND: i64 = 49
const SYS_LISTEN: i64 = 50
const SYS_GETSOCKNAME: i64 = 51
const SYS_GETPEERNAME: i64 = 52
const SYS_SETSOCKOPT: i64 = 54
const SYS_ACCEPT4: i64 = 288

const AF_INET: u16 = 2
const AF_UNIX: u16 = 1
const SOCK_STREAM: i64 = 1

const SOL_SOCKET: i64 = 1
const SO_REUSEADDR: i64 = 2
const SO_RCVTIMEO: i64 = 20
const SO_SNDTIMEO: i64 = 21
const IPPROTO_TCP: i64 = 6
const TCP_NODELAY: i64 = 1

const MSG_NOSIGNAL: i64 = 16384
const SHUT_WR: i64 = 1

const EINTR: i64 = 0 - 4

// The two addresses every program needs by name.
const ADDR_ANY: u32 = 0
const ADDR_LOCAL: u32 = 2130706433 // 127.0.0.1

error NetError {
    Socket, // socket(2) failed
    Options, // setsockopt(2) failed
    Bind, // bind(2) failed -- port occupied, no permission
    Listen, // listen(2) failed
    Accept, // accept4(2) failed
    Connect, // connect(2) failed
    Address, // getsockname/getpeername failed
    Broken, // read/write failed with an errno
    Closed, // the peer closed while more octets were expected
}

// --------------------------------------------------------------- Structures

// The C `struct sockaddr_in`, field for field. See the header above for why
// `family` is the only one in host order.
struct SockAddrIn {
    family: u16,
    port: u16,
    addr: u32,
    zero: [u8; 8],
}

// A listening socket. `port` is the port the socket REALLY got, which for
// `port = 0` is the one the kernel picked -- that is what makes a test
// runnable twice at the same time without a fixed port.
struct Listener {
    fd: i32,
    port: u16,
    err: i32,
}

// One accepted or dialled connection. `err` holds the raw negated errno of
// the last failed operation; error unions carry no payload in stage 0, and
// throwing the number away would make ECONNRESET and EPIPE the same event.
struct Conn {
    fd: i32,
    err: i32,
    peer: u32,
    peer_port: u16,
}

// ------------------------------------------------------------- Byte order

// 0x1234 -> 0x3412. Written out instead of borrowed from a builtin, so that
// it stays visible what happens.
fn host_to_net_16(v: u16) -> u16 {
    return ((v & 255 as u16) << 8) | (v >> 8)
}

fn host_to_net_32(v: u32) -> u32 {
    return ((v & 255 as u32) << 24)
    | (((v >> 8) & 255 as u32) << 16)
    | (((v >> 16) & 255 as u32) << 8)
    | (v >> 24)
}

// 127.0.0.1 is `ipv4(127, 0, 0, 1)` -- in HOST order, the way one reads it.
// The conversion happens once, on the way into the structure.
fn ipv4(a: u8, b: u8, c: u8, d: u8) -> u32 {
    return (a as u32 << 24) | (b as u32 << 16) | (c as u32 << 8) | d as u32
}

// ----------------------------------------------------------------- Helpers

// The kernel reports an error as -1 .. -4095. Everything else is a result.
fn failed(r: i64) -> bool {
    return r < 0 && r > 0 - 4096
}

// The errno behind a raw return value, positive; 0 when it was no error.
fn errno_of(r: i64) -> i64 {
    if failed(r) {
        return 0 - r
    }
    return 0
}

fn addr_init(sa: *mut SockAddrIn, addr: u32, port: u16) {
    (*sa).family = AF_INET
    (*sa).port = host_to_net_16(port)
    (*sa).addr = host_to_net_32(addr)
    var i: usize = 0
    while i < 8 {
        (*sa).zero[i] = 0 as u8
        i = i + 1
    }
}

// A fresh TCP socket, or a negative errno.
fn raw_socket() -> i64 {
    return syscall(SYS_SOCKET, AF_INET as i64, SOCK_STREAM, 0, 0, 0, 0)
}

fn set_int_option(fd: i32, level: i64, name: i64, value: i32) -> i64 {
    var v: i32 = value
    return syscall(SYS_SETSOCKOPT, fd as i64, level, name,
        (&v) as i64, 4, 0)
}

// SO_REUSEADDR. WHY IT IS NOT OPTIONAL for a server: after a close the
// socket stays in TIME_WAIT for minutes, and without this option the next
// `bind` on the same port fails with EADDRINUSE. A server that cannot be
// restarted for two minutes after a crash is unusable.
fn set_reuse_addr(fd: i32, on: bool) -> NetError!bool {
    var v: i32 = 0
    if on {
        v = 1
    }
    let r: i64 = set_int_option(fd, SOL_SOCKET, SO_REUSEADDR, v)
    if failed(r) {
        return NetError::Options
    }
    return true
}

// TCP_NODELAY: turn Nagle's algorithm off. A protocol that sends small
// packets and waits for an answer (which is exactly what a Minecraft
// handshake does) otherwise pays up to 40 ms per exchange.
fn set_no_delay(c: *mut Conn, on: bool) -> NetError!bool {
    var v: i32 = 0
    if on {
        v = 1
    }
    let r: i64 = set_int_option((*c).fd, IPPROTO_TCP, TCP_NODELAY, v)
    if failed(r) {
        (*c).err = r as i32
        return NetError::Options
    }
    return true
}

// SO_RCVTIMEO/SO_SNDTIMEO. `struct timeval` is two 64 bit words: seconds,
// microseconds. 0/0 means "no timeout" and is the default.
fn set_timeout(c: *mut Conn, ms: u64) -> NetError!bool {
    var tv: [i64; 2] = [0; 2]
    tv[0] = (ms / 1000 as u64) as i64
    tv[1] = (ms % 1000 as u64) as i64 * 1000
    let a: i64 = syscall(SYS_SETSOCKOPT, (*c).fd as i64, SOL_SOCKET,
        SO_RCVTIMEO, (&tv[0]) as i64, 16, 0)
    if failed(a) {
        (*c).err = a as i32
        return NetError::Options
    }
    let b: i64 = syscall(SYS_SETSOCKOPT, (*c).fd as i64, SOL_SOCKET,
        SO_SNDTIMEO, (&tv[0]) as i64, 16, 0)
    if failed(b) {
        (*c).err = b as i32
        return NetError::Options
    }
    return true
}

// ---------------------------------------------------------------- Listening

// The full form: the raw errno of the FIRST failing step lands in `*err`,
// so that "port occupied" can be told from "not allowed to bind below 1024".
fn listen_tcp_err(addr: u32, port: u16, backlog: i32, err: *mut i64) -> NetError!Listener {
    if err as u64 != 0 as u64 {
        *err = 0
    }
    let fd: i64 = raw_socket()
    if failed(fd) {
        if err as u64 != 0 as u64 {
            *err = 0 - fd
        }
        return NetError::Socket
    }
    var v: i32 = 1
    let ro: i64 = set_int_option(fd as i32, SOL_SOCKET, SO_REUSEADDR, v)
    if failed(ro) {
        if err as u64 != 0 as u64 {
            *err = 0 - ro
        }
        syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0)
        return NetError::Options
    }
    var sa: SockAddrIn = SockAddrIn { family: 0 as u16, port: 0 as u16, addr: 0 as u32, zero: [0; 8] }
    addr_init(&sa, addr, port)
    let rb: i64 = syscall(SYS_BIND, fd, (&sa) as i64, 16, 0, 0, 0)
    if failed(rb) {
        if err as u64 != 0 as u64 {
            *err = 0 - rb
        }
        syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0)
        return NetError::Bind
    }
    let rl: i64 = syscall(SYS_LISTEN, fd, backlog as i64, 0, 0, 0, 0)
    if failed(rl) {
        if err as u64 != 0 as u64 {
            *err = 0 - rl
        }
        syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0)
        return NetError::Listen
    }
    // Which port did we really get? For `port = 0` the kernel picked one,
    // and without asking back nobody could connect to it.
    var got: SockAddrIn = SockAddrIn { family: 0 as u16, port: 0 as u16, addr: 0 as u32, zero: [0; 8] }
    var len: i32 = 16
    let rn: i64 = syscall(SYS_GETSOCKNAME, fd, (&got) as i64, (&len) as i64, 0, 0, 0)
    if failed(rn) {
        if err as u64 != 0 as u64 {
            *err = 0 - rn
        }
        syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0)
        return NetError::Address
    }
    return Listener {
        fd: fd as i32,
        port: host_to_net_16(got.port), // the swap is its own inverse
        err: 0,
    }
}

// The short form from the round's brief: `listen_tcp(addr, port) -> Listener`.
fn listen_tcp(addr: u32, port: u16) -> NetError!Listener {
    return listen_tcp_err(addr, port, 128, 0 as *mut i64)
}

// ---------------------------------------------------------------- Accepting

fn accept_err(l: *mut Listener, err: *mut i64) -> NetError!Conn {
    if err as u64 != 0 as u64 {
        *err = 0
    }
    var sa: SockAddrIn = SockAddrIn { family: 0 as u16, port: 0 as u16, addr: 0 as u32, zero: [0; 8] }
    var len: i32 = 16
    var r: i64 = 0
    var again: bool = true
    while again {
        r = syscall(SYS_ACCEPT4, (*l).fd as i64, (&sa) as i64, (&len) as i64, 0, 0, 0)
        // N5: a signal is not an answer.
        if r != EINTR {
            again = false
        }
    }
    if failed(r) {
        (*l).err = r as i32
        if err as u64 != 0 as u64 {
            *err = 0 - r
        }
        return NetError::Accept
    }
    return Conn {
        fd: r as i32,
        err: 0,
        peer: host_to_net_32(sa.addr),
        peer_port: host_to_net_16(sa.port),
    }
}

fn accept(l: *mut Listener) -> NetError!Conn {
    return accept_err(l, 0 as *mut i64)
}

// ----------------------------------------------------------------- Dialling

fn connect_tcp_err(addr: u32, port: u16, err: *mut i64) -> NetError!Conn {
    if err as u64 != 0 as u64 {
        *err = 0
    }
    let fd: i64 = raw_socket()
    if failed(fd) {
        if err as u64 != 0 as u64 {
            *err = 0 - fd
        }
        return NetError::Socket
    }
    var sa: SockAddrIn = SockAddrIn { family: 0 as u16, port: 0 as u16, addr: 0 as u32, zero: [0; 8] }
    addr_init(&sa, addr, port)
    var r: i64 = 0
    var again: bool = true
    while again {
        r = syscall(SYS_CONNECT, fd, (&sa) as i64, 16, 0, 0, 0)
        if r != EINTR {
            again = false
        }
    }
    if failed(r) {
        if err as u64 != 0 as u64 {
            *err = 0 - r
        }
        syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0)
        return NetError::Connect
    }
    return Conn { fd: fd as i32, err: 0, peer: addr, peer_port: port }
}

// ROUND B5: a socket in the FILE SYSTEM, not on the network. The X11
// server listens on `/tmp/.X11-unix/X<n>` and on nothing else on a modern
// desktop -- its TCP port is switched off almost everywhere -- so a window
// cannot be opened without this.
//
// `struct sockaddr_un` is a family and 108 octets of path; the path is
// NUL-terminated and the rest is zero. A path longer than 107 octets is
// refused rather than truncated: a truncated socket path connects to the
// wrong thing or to nothing, and both are worse than a refusal.
fn connect_unix(path: u64, plen: usize) -> NetError!Conn {
    if plen > 107 {
        return NetError::Address
    }
    let fd: i64 = syscall(SYS_SOCKET, AF_UNIX as i64, SOCK_STREAM, 0,
        0, 0, 0)
    if failed(fd) {
        return NetError::Socket
    }
    var sa: [u8; 110] = [0; 110]
    sa[0] = AF_UNIX as u8
    sa[1] = 0 as u8
    var i: usize = 0
    while i < plen {
        sa[2 + i] = *((path + i as u64) as *mut u8)
        i = i + 1
    }
    let r: i64 = syscall(SYS_CONNECT, fd, (&sa[0]) as i64, 110, 0, 0, 0)
    if failed(r) {
        syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0)
        return NetError::Connect
    }
    return Conn { fd: fd as i32, err: 0, peer: 0 as u32,
        peer_port: 0 as u16 }
}

fn connect_tcp(addr: u32, port: u16) -> NetError!Conn {
    return connect_tcp_err(addr, port, 0 as *mut i64)
}

// ------------------------------------------------------------ Reading/writing

// Up to `n` octets into `buf`. THE RETURN VALUE IS THE NUMBER REALLY READ
// and may be smaller than `n` (N4). 0 means: the peer closed in an orderly
// way -- that is not an error and is not reported as one.
fn read(c: *mut Conn, buf: u64, n: usize) -> NetError!usize {
    if n == 0 {
        return 0 as usize
    }
    var r: i64 = 0
    var again: bool = true
    while again {
        r = syscall(SYS_RECVFROM, (*c).fd as i64, buf as i64, n as i64, 0, 0, 0)
        if r != EINTR {
            again = false
        }
    }
    if failed(r) {
        (*c).err = r as i32
        return NetError::Broken
    }
    return r as usize
}

// Up to `n` octets out of `buf`. MSG_NOSIGNAL: see the header. A short
// write is normal for a large buffer -- `write_all` loops.
fn write(c: *mut Conn, buf: u64, n: usize) -> NetError!usize {
    if n == 0 {
        return 0 as usize
    }
    var r: i64 = 0
    var again: bool = true
    while again {
        r = syscall(SYS_SENDTO, (*c).fd as i64, buf as i64, n as i64,
            MSG_NOSIGNAL, 0, 0)
        if r != EINTR {
            again = false
        }
    }
    if failed(r) {
        (*c).err = r as i32
        return NetError::Broken
    }
    return r as usize
}

// The plain `read(2)`/`write(2)`, without MSG_NOSIGNAL. Here so that the
// difference stays visible and measurable, not because anybody should
// prefer them.
fn read_raw(c: *mut Conn, buf: u64, n: usize) -> NetError!usize {
    let r: i64 = syscall(SYS_READ, (*c).fd as i64, buf as i64, n as i64, 0, 0, 0)
    if failed(r) {
        (*c).err = r as i32
        return NetError::Broken
    }
    return r as usize
}

fn write_raw(c: *mut Conn, buf: u64, n: usize) -> NetError!usize {
    let r: i64 = syscall(SYS_WRITE, (*c).fd as i64, buf as i64, n as i64, 0, 0, 0)
    if failed(r) {
        (*c).err = r as i32
        return NetError::Broken
    }
    return r as usize
}

// EXACTLY `n` octets, or an error. A peer that closes in between is
// `NetError::Closed` and not a short result -- the caller asked for a fixed
// number and has to be able to rely on it.
fn read_full(c: *mut Conn, buf: u64, n: usize) -> NetError!usize {
    var done: usize = 0
    while done < n {
        let k: usize = try read(c, buf + done as u64, n - done)
        if k == 0 {
            return NetError::Closed
        }
        done = done + k
    }
    return done
}

fn write_all(c: *mut Conn, buf: u64, n: usize) -> NetError!usize {
    var done: usize = 0
    while done < n {
        let k: usize = try write(c, buf + done as u64, n - done)
        if k == 0 {
            return NetError::Closed
        }
        done = done + k
    }
    return done
}

// ------------------------------------------------------------------ Closing

// `shutdown(fd, SHUT_WR)` sends the FIN but keeps reading possible. That is
// how a client says "I am done sending" without losing what is still on the
// way back -- `close` would throw that away.
fn shutdown_write(c: *mut Conn) {
    if (*c).fd < 0 {
        return
    }
    syscall(SYS_SHUTDOWN, (*c).fd as i64, SHUT_WR, 0, 0, 0, 0)
}

// Idempotent on purpose: the fd is set to -1, so a second `close` (out of a
// `defer` that runs after an explicit one) cannot close a descriptor that
// another thread has meanwhile been given by the kernel. That reuse is one
// of the nastier bugs in threaded servers.
fn close(c: *mut Conn) {
    if (*c).fd < 0 {
        return
    }
    syscall(SYS_CLOSE, (*c).fd as i64, 0, 0, 0, 0, 0)
    (*c).fd = 0 - 1
}

fn close_listener(l: *mut Listener) {
    if (*l).fd < 0 {
        return
    }
    syscall(SYS_CLOSE, (*l).fd as i64, 0, 0, 0, 0, 0)
    (*l).fd = 0 - 1
}

// --------------------------------------------------------------- Inspection

fn listener_port(l: *mut Listener) -> u16 { return (*l).port }
fn listener_fd(l: *mut Listener) -> i32 { return (*l).fd }
fn listener_is_open(l: *mut Listener) -> bool { return (*l).fd >= 0 }
fn conn_fd(c: *mut Conn) -> i32 { return (*c).fd }
fn conn_is_open(c: *mut Conn) -> bool { return (*c).fd >= 0 }
fn conn_error(c: *mut Conn) -> i32 { return (*c).err }
fn peer_addr(c: *mut Conn) -> u32 { return (*c).peer }
fn peer_port(c: *mut Conn) -> u16 { return (*c).peer_port }

// A descriptor that came from somewhere else (a thread argument, for
// instance -- stage 0 hands a thread ONE `u64`, so a whole `Conn` cannot
// travel, but the number can).
fn conn_from_fd(fd: i32) -> Conn {
    return Conn { fd: fd, err: 0, peer: 0 as u32, peer_port: 0 as u16 }
}

fn listener_from_fd(fd: i32) -> Listener {
    return Listener { fd: fd, port: 0 as u16, err: 0 }
}
