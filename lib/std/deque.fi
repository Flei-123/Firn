// SPDX-License-Identifier: MPL-2.0
// lib/std/deque.fi -- Python's `collections.deque`: a double-ended queue on a
// growing ring buffer. push/pop at BOTH ends in O(1) (a `Vec` is O(n) at the
// front), indexing in O(1), optional `maxlen` (a bounded window: pushing on
// a full deque drops the element at the opposite end).
//
//     import std.vec
//     import std.deque
//
//     var q: Deque[i64] = deque_new[i64]()      // d = deque()
//     deque_push_back[i64](&q, 1)               // d.append(1)
//     deque_push_front[i64](&q, 0)              // d.appendleft(0)
//     var x: i64 = 0
//     deque_pop_front[i64](&q, &x)              // x = d.popleft()   (false when empty)
//     deque_pop_back[i64](&q, &x)               // x = d.pop()
//     *deque_at[i64](&q, 0)                     // d[0]  (deque_at is null when out of range)
//     deque_len[i64](&q)                        // len(d)
//     deque_rotate[i64](&q, 2)                  // d.rotate(2)  (negative = left)
//     deque_extend[i64](&q, &v)                 // d.extend(v)
//     deque_to_vec[i64](&q, &out)               // list(d)  (APPENDS to out)
//     var w: Deque[i64] = deque_new_max[i64](3) // deque(maxlen=3): sliding window
//
// BFS: `deque_push_back` the start, `while deque_pop_front(&q, &n) { .. }`.
// maxlen 0 means "no limit" here (Python: `maxlen=0` is a deque that is always
// empty). A pointer from `deque_at` / `deque_front` / `deque_back` is valid
// until the next push, because a push may move the buffer. The caller frees
// with `deque_free`. Names are bare because generic functions cannot be called
// module-qualified.
import std.rt
import std.vec

export { Deque, deque_new, deque_new_max, deque_free, deque_clear, deque_len,
    deque_is_empty, deque_push_back, deque_push_front, deque_pop_back,
    deque_pop_front, deque_at, deque_front, deque_back, deque_rotate,
    deque_extend, deque_extend_left, deque_to_vec, deque_reverse }

struct Deque[T] {
    ptr: u64,
    head: usize,
    len: usize,
    cap: usize,
    maxlen: usize,
}

fn deque_new[T]() -> Deque[T] {
    return Deque[T] { ptr: 0, head: 0, len: 0, cap: 0, maxlen: 0 }
}

// Bounded deque: at most `maxlen` elements (0 = unbounded).
fn deque_new_max[T](maxlen: usize) -> Deque[T] {
    return Deque[T] { ptr: 0, head: 0, len: 0, cap: 0, maxlen: maxlen }
}

fn deque_free[T](d: *mut Deque[T]) {
    gc_untrack[T]((*d).ptr)
    rt.heap_free((*d).ptr, (*d).cap * size_of[T]())
    (*d).ptr = 0
    (*d).head = 0
    (*d).len = 0
    (*d).cap = 0
}

fn deque_clear[T](d: *mut Deque[T]) {
    (*d).head = 0
    (*d).len = 0
}

fn deque_len[T](d: *mut Deque[T]) -> usize {
    return (*d).len
}

fn deque_is_empty[T](d: *mut Deque[T]) -> bool {
    return (*d).len == 0
}

// Slot i (0 = front) without a range check.
fn deque_slot[T](d: *mut Deque[T], i: usize) -> *mut T {
    let phys: usize = ((*d).head + i) & ((*d).cap - 1)
    return ((*d).ptr +% (phys as u64) *% (size_of[T]() as u64)) as *mut T
}

// Grows to at least `needed` slots (a power of two) and straightens the ring.
fn deque_grow[T](d: *mut Deque[T], needed: usize) -> bool {
    let gr: usize = size_of[T]()
    var cap: usize = (*d).cap
    if cap == 0 {
        cap = 8
    }
    while cap < needed {
        cap = cap * 2
    }
    let new: u64 = rt.heap_alloc(cap * gr)
    if new == 0 {
        return false
    }
    var i: usize = 0
    while i < (*d).len {
        let src: *mut T = deque_slot[T](d, i)
        *((new +% (i as u64) *% (gr as u64)) as *mut T) = *src
        i = i + 1
    }
    gc_track[T](new, cap * gr)
    gc_untrack[T]((*d).ptr)
    rt.heap_free((*d).ptr, (*d).cap * gr)
    (*d).ptr = new
    (*d).cap = cap
    (*d).head = 0
    return true
}

// Drops the front element without returning it.
fn deque_drop_front[T](d: *mut Deque[T]) {
    (*d).head = ((*d).head + 1) & ((*d).cap - 1)
    (*d).len = (*d).len - 1
}

// d.append(x). A full bounded deque drops its front element first.
fn deque_push_back[T](d: *mut Deque[T], value: T) -> bool {
    if (*d).maxlen != 0 && (*d).len >= (*d).maxlen {
        if (*d).len == 0 {
            return true
        }
        deque_drop_front[T](d)
    }
    if (*d).len >= (*d).cap {
        if !deque_grow[T](d, (*d).len + 1) {
            return false
        }
    }
    (*d).len = (*d).len + 1
    *deque_slot[T](d, (*d).len - 1) = value
    return true
}

// d.appendleft(x). A full bounded deque drops its back element first.
fn deque_push_front[T](d: *mut Deque[T], value: T) -> bool {
    if (*d).maxlen != 0 && (*d).len >= (*d).maxlen {
        (*d).len = (*d).len - 1
    }
    if (*d).len >= (*d).cap {
        if !deque_grow[T](d, (*d).len + 1) {
            return false
        }
    }
    (*d).head = ((*d).head + (*d).cap - 1) & ((*d).cap - 1)
    (*d).len = (*d).len + 1
    *deque_slot[T](d, 0) = value
    return true
}

// d.popleft(): into *out. False (out untouched) when empty.
fn deque_pop_front[T](d: *mut Deque[T], out: *mut T) -> bool {
    if (*d).len == 0 {
        return false
    }
    *out = *deque_slot[T](d, 0)
    deque_drop_front[T](d)
    return true
}

// d.pop(): into *out. False (out untouched) when empty.
fn deque_pop_back[T](d: *mut Deque[T], out: *mut T) -> bool {
    if (*d).len == 0 {
        return false
    }
    *out = *deque_slot[T](d, (*d).len - 1)
    (*d).len = (*d).len - 1
    return true
}

// d[i] as a pointer, null when i >= len.
fn deque_at[T](d: *mut Deque[T], i: usize) -> *mut T {
    if i >= (*d).len {
        return 0 as *mut T
    }
    return deque_slot[T](d, i)
}

fn deque_front[T](d: *mut Deque[T]) -> *mut T {
    return deque_at[T](d, 0)
}

fn deque_back[T](d: *mut Deque[T]) -> *mut T {
    if (*d).len == 0 {
        return 0 as *mut T
    }
    return deque_slot[T](d, (*d).len - 1)
}

// d.rotate(n): n > 0 moves the last n elements to the front, n < 0 the first
// -n to the back (any |n|, taken modulo len).
fn deque_rotate[T](d: *mut Deque[T], n: i64) {
    let len: usize = (*d).len
    if len < 2 {
        return
    }
    var k: usize = 0
    if n >= 0 {
        k = (n as u64 % (len as u64)) as usize
    } else {
        // -n without overflow at i64::MIN
        let m: u64 = (0 as u64) -% (n as u64)
        k = len - (m % (len as u64)) as usize
        if k == len { k = 0 }
    }
    // rotate right by k = rotate left by len - k; take the shorter walk
    var x: T = *deque_slot[T](d, 0)
    if k <= len - k {
        var i: usize = 0
        while i < k {
            deque_pop_back[T](d, &x)
            (*d).head = ((*d).head + (*d).cap - 1) & ((*d).cap - 1)
            (*d).len = (*d).len + 1
            *deque_slot[T](d, 0) = x
            i = i + 1
        }
    } else {
        var i: usize = 0
        while i < len - k {
            deque_pop_front[T](d, &x)
            (*d).len = (*d).len + 1
            *deque_slot[T](d, (*d).len - 1) = x
            i = i + 1
        }
    }
}

// d.extend(v): append every element of v at the back, in order.
fn deque_extend[T](d: *mut Deque[T], v: *mut Vec[T]) -> bool {
    var i: usize = 0
    while i < vec_len[T](v) {
        if !deque_push_back[T](d, *vec_elem_ptr[T](v, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

// d.extendleft(v): every element goes to the front, so v ends up REVERSED.
fn deque_extend_left[T](d: *mut Deque[T], v: *mut Vec[T]) -> bool {
    var i: usize = 0
    while i < vec_len[T](v) {
        if !deque_push_front[T](d, *vec_elem_ptr[T](v, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

// list(d): APPENDS the elements front to back to out.
fn deque_to_vec[T](d: *mut Deque[T], out: *mut Vec[T]) -> bool {
    var i: usize = 0
    while i < (*d).len {
        if !vec_push[T](out, *deque_slot[T](d, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

// d.reverse(), in place.
fn deque_reverse[T](d: *mut Deque[T]) {
    var i: usize = 0
    var j: usize = (*d).len
    while j > i + 1 {
        j = j - 1
        let a: *mut T = deque_slot[T](d, i)
        let b: *mut T = deque_slot[T](d, j)
        let t: T = *a
        *a = *b
        *b = t
        i = i + 1
    }
}
