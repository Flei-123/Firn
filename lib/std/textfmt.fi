// SPDX-License-Identifier: MPL-2.0
// lib/std/textfmt.fi -- std.textfmt: the table output of a report script.
//
// What Python's format specs `{s:<8}` `{s:>8}` `{x:>9.2f}` `%.2f` and
// `round(x, 2)` do. `f"{x}"` in Firn has no width and no precision, so a
// column report needed hand-written padding loops in every script.
//
//     import std.textfmt
//
//     var out: rt.Buf = rt.buf_new()
//     textfmt.pad_right(&out, "north", 9)          // "north    "
//     textfmt.pad_left_fixed(&out, 3491.675, 2, 10)  // "   3491.67"   (as `{x:>10.2f}`)
//     textfmt.pad_left_i64(&out, 8, 3)             // "  8"
//     let r: f64 = textfmt.round_to(2.675, 2)      // 2.67 (as Python: the exact binary value decides)
//
// `fixed` is exact: the double is expanded as m * 2^e and rounded half to even
// on the exact decimal value, like C's printf and Python (2.675 -> "2.67",
// 0.125 -> "0.12", 2.5 -> "2" for 0 digits). The sign of a negative number
// that rounds to zero is kept ("-0.00"), as in Python.
//
// HONEST: (T1) width counts code points, not display cells (wide CJK / combining
// marks count 1 each, as Python's format does). (T2) `fixed` is exact for
// |x * 10^digits| < 2^64 and digits <= 15; beyond that (numbers above ~1e18) it
// writes the shortest text of the double and appends zeros -- not exact. (T3) NaN is
// "nan", infinities "inf" / "-inf" (padded like any other text). (T4) `sig_digits` (e/g forms) is exact for EVERY finite double (big number
// expansion, half to even on the exact value); only `fixed` has the limit above.
import std.rt
import std.str
import std.num

export { put, pad_left, pad_right, fixed, pad_left_fixed, pad_left_i64, round_to, char_count, sig_digits }

fn put(out: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(out, s.p as u64, s.n)
}

// number of code points of s (a continuation byte 10xxxxxx is not a start)
fn char_count(s: str) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < s.n {
        if (*(s.p + i) & 192 as u8) != 128 as u8 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn fill(out: *mut rt.Buf, count: usize) {
    var i: usize = 0
    while i < count {
        rt.buf_push(out, 32 as u8)
        i = i + 1
    }
}

// `{s:<width}`
fn pad_right(out: *mut rt.Buf, s: str, width: usize) {
    put(out, s)
    let n: usize = char_count(s)
    if n < width {
        fill(out, width - n)
    }
}

// `{s:>width}`
fn pad_left(out: *mut rt.Buf, s: str, width: usize) {
    let n: usize = char_count(s)
    if n < width {
        fill(out, width - n)
    }
    put(out, s)
}

// 64 x 64 -> 128 (hi is returned through the pointer, the low half is the result)
fn mul128(a: u64, b: u64, hi: *mut u64) -> u64 {
    let mask: u64 = 4294967295
    let al: u64 = a & mask
    let ah: u64 = a >> 32
    let bl: u64 = b & mask
    let bh: u64 = b >> 32
    let ll: u64 = al * bl
    let lh: u64 = al * bh
    let hl: u64 = ah * bl
    let hh: u64 = ah * bh
    let mid: u64 = (ll >> 32) + (lh & mask) + (hl & mask)
    *hi = hh + (lh >> 32) + (hl >> 32) + (mid >> 32)
    return (ll & mask) | (mid << 32)
}

fn pow10_u64(d: usize) -> u64 {
    var p: u64 = 1
    var i: usize = 0
    while i < d {
        p = p * 10
        i = i + 1
    }
    return p
}

// x * 10^d rounded half to even into `q`; false when it does not fit / not exact.
fn scaled_exact(m: u64, e: i64, pow: u64, q: *mut u64) -> bool {
    if e >= 0 {
        if e > 10 {
            return false
        }
        let iv: u64 = m << (e as u64)
        if iv > 18446744073709551615 / pow {
            return false
        }
        *q = iv * pow
        return true
    }
    let s: u64 = (0 - e) as u64
    var hi: u64 = 0
    let lo: u64 = mul128(m, pow, &hi)
    var qq: u64 = 0
    var cmp: i32 = 0 // remainder against half: -1 below, 0 tie, 1 above
    if s >= 128 {
        qq = 0
        cmp = -1
    } else if s > 64 {
        let k: u64 = s - 64
        qq = hi >> k
        let rem_hi: u64 = hi & ((1 << k) - 1)
        let half_hi: u64 = 1 << (k - 1)
        if rem_hi > half_hi {
            cmp = 1
        } else if rem_hi < half_hi {
            cmp = -1
        } else if lo != 0 {
            cmp = 1
        } else {
            cmp = 0
        }
    } else if s == 64 {
        qq = hi
        let half: u64 = 1 << 63
        if lo > half {
            cmp = 1
        } else if lo < half {
            cmp = -1
        } else {
            cmp = 0
        }
    } else {
        if (hi >> s) != 0 {
            return false
        }
        qq = (hi << (64 - s)) | (lo >> s)
        let rem: u64 = lo & ((1 << s) - 1)
        let half: u64 = 1 << (s - 1)
        if rem > half {
            cmp = 1
        } else if rem < half {
            cmp = -1
        } else {
            cmp = 0
        }
    }
    if cmp > 0 || (cmp == 0 && (qq & 1) == 1) {
        if qq == 18446744073709551615 {
            return false
        }
        qq = qq + 1
    }
    *q = qq
    return true
}

// `%.{digits}f` / `{x:.{digits}f}`
#[allow_fp]
fn fixed(out: *mut rt.Buf, x: f64, digits: usize) {
    let bits: u64 = __bits(x)
    let neg: bool = (bits >> 63) == 1
    let ex: u64 = (bits >> 52) & 2047
    let frac: u64 = bits & 4503599627370495
    if ex == 2047 {
        if frac != 0 {
            put(out, "nan")
        } else if neg {
            put(out, "-inf")
        } else {
            put(out, "inf")
        }
        return
    }
    var d: usize = digits
    if d > 15 {
        d = 15
    }
    var m: u64 = frac
    var e: i64 = -1074
    if ex > 0 {
        m = frac | 4503599627370496
        e = (ex as i64) - 1075
    }
    let pow: u64 = pow10_u64(d)
    var q: u64 = 0
    if neg {
        rt.buf_push(out, 45 as u8)
    }
    if !scaled_exact(m, e, pow, &q) {
        // not exact: shortest text of |x|, then zeros
        var b: num.Bytes = num.bytes_new()
        var v: f64 = x
        if neg {
            v = 0.0 - x
        }
        if num.write_f64(&b, v) {
            rt.buf_push_bytes(out, rt.addr_of(b.ptr), b.len)
        }
        num.bytes_free(&b)
        if d > 0 {
            rt.buf_push(out, 46 as u8)
            fill_zero(out, d)
        }
        return
    }
    rt.buf_push_dec_u64(out, q / pow)
    if d > 0 {
        rt.buf_push(out, 46 as u8)
        let f: u64 = q % pow
        var digits_n: usize = 1
        var t: u64 = f / 10
        while t > 0 {
            digits_n = digits_n + 1
            t = t / 10
        }
        if digits_n < d {
            fill_zero(out, d - digits_n)
        }
        rt.buf_push_dec_u64(out, f)
    }
}

fn fill_zero(out: *mut rt.Buf, count: usize) {
    var i: usize = 0
    while i < count {
        rt.buf_push(out, 48 as u8)
        i = i + 1
    }
}

// `{x:>width.digitsf}`
#[allow_fp]
fn pad_left_fixed(out: *mut rt.Buf, x: f64, digits: usize, width: usize) {
    var t: rt.Buf = rt.buf_new()
    fixed(&t, x, digits)
    let n: usize = rt.buf_len(&t)
    if n < width {
        fill(out, width - n)
    }
    rt.buf_push_bytes(out, rt.buf_ptr(&t), n)
    rt.buf_free(&t)
}

// `{v:>width}` for an integer
fn pad_left_i64(out: *mut rt.Buf, v: i64, width: usize) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&t, v)
    let n: usize = rt.buf_len(&t)
    if n < width {
        fill(out, width - n)
    }
    rt.buf_push_bytes(out, rt.buf_ptr(&t), n)
    rt.buf_free(&t)
}

// Python's `round(x, digits)`: the double nearest to the correctly rounded decimal.
#[allow_fp]
fn round_to(x: f64, digits: usize) -> f64 {
    var t: rt.Buf = rt.buf_new()
    fixed(&t, x, digits)
    let s: str = str { p: rt.buf_data(&t), n: rt.buf_len(&t) }
    let r: num.ParsedF64 = num.parse_f64(str.span(s.p, s.n))
    rt.buf_free(&t)
    if r.ok {
        return r.value
    }
    return x
}

// ---------------------------------------------------------------- r699: e / g forms
//
// `sig_digits` writes exactly `ndig` (>= 1) ASCII significant digits of |x|,
// correctly rounded half to even on the EXACT decimal value of the double
// (like C's printf and Python), and the decimal exponent of the first digit
// (1234.5 -> "12345", exp10 = 3). x must be finite; 0 gives zeros, exp10 = 0.

// limbs (u32, least significant first) at address lp, capacity 100: *= m
fn limb_mul(lp: u64, n: usize, m: u32) -> usize {
    var carry: u64 = 0
    var i: usize = 0
    while i < n {
        let t: u64 = (rt.ld32(lp, i) as u64) * (m as u64) + carry
        rt.st32(lp, i, (t & 4294967295) as u32)
        carry = t >> 32
        i = i + 1
    }
    var nn: usize = n
    if carry != 0 && nn < 100 {
        rt.st32(lp, nn, carry as u32)
        nn = nn + 1
    }
    return nn
}

// limbs at lp /= 10^9 in place; returns the remainder, shrinks *n
fn limb_div9(lp: u64, n: *mut usize) -> u32 {
    var rem: u64 = 0
    var i: usize = *n
    while i > 0 {
        i = i - 1
        let cur: u64 = (rem << 32) | (rt.ld32(lp, i) as u64)
        rt.st32(lp, i, (cur / 1000000000) as u32)
        rem = cur % 1000000000
    }
    while *n > 0 && rt.ld32(lp, *n - 1) == 0 as u32 {
        *n = *n - 1
    }
    return rem as u32
}

#[allow_fp]
fn sig_digits(x: f64, ndig: usize, out: *mut rt.Buf, exp10: *mut i64) {
    let bits: u64 = __bits(x)
    let ex: u64 = (bits >> 52) & 2047
    let frac: u64 = bits & 4503599627370495
    var m: u64 = frac
    var e: i64 = -1074
    if ex > 0 {
        m = frac | 4503599627370496
        e = (ex as i64) - 1075
    }
    *exp10 = 0
    if m == 0 {
        fill_zero(out, ndig)
        return
    }
    var limb: [u32; 100] = [0 as u32; 100]
    let lp: u64 = (&limb[0]) as u64
    limb[0] = (m & 4294967295) as u32
    limb[1] = (m >> 32) as u32
    var n: usize = 2
    if limb[1] == 0 as u32 {
        n = 1
    }
    var scale: i64 = 0
    if e >= 0 {
        var sh: i64 = e
        while sh > 0 {
            var s1: i64 = 31
            if sh < 31 {
                s1 = sh
            }
            n = limb_mul(lp, n, (1 as u32) << (s1 as u32))
            sh = sh - s1
        }
    } else {
        scale = 0 - e
        var k: i64 = scale
        while k >= 13 {
            n = limb_mul(lp, n, 1220703125 as u32)
            k = k - 13
        }
        var pw: u32 = 1
        while k > 0 {
            pw = pw * 5
            k = k - 1
        }
        n = limb_mul(lp, n, pw)
    }
    // decimal digits, filled from the end of `dig`
    var dig: [u8; 800] = [0 as u8; 800]
    var pos: usize = 800
    while n > 0 {
        var r: u32 = limb_div9(lp, &n)
        var q: usize = 0
        while q < 9 {
            pos = pos - 1
            dig[pos] = (48 + (r % 10)) as u8
            r = r / 10
            q = q + 1
        }
    }
    while pos < 799 && dig[pos] == 48 as u8 {
        pos = pos + 1
    }
    let len: usize = 800 - pos
    *exp10 = (len as i64) - 1 - scale
    if len > ndig {
        let rd: u8 = dig[pos + ndig]
        var sticky: bool = false
        var t: usize = pos + ndig + 1
        while t < 800 {
            if dig[t] != 48 as u8 {
                sticky = true
                break
            }
            t = t + 1
        }
        var up: bool = false
        if rd > 53 as u8 {
            up = true
        } else if rd == 53 as u8 {
            up = sticky || ((dig[pos + ndig - 1] - 48 as u8) % 2 as u8) == 1 as u8
        }
        if up {
            var c: usize = ndig
            var carry: bool = true
            while carry && c > 0 {
                c = c - 1
                if dig[pos + c] == 57 as u8 {
                    dig[pos + c] = 48 as u8
                } else {
                    dig[pos + c] = dig[pos + c] + 1 as u8
                    carry = false
                }
            }
            if carry {
                dig[pos] = 49 as u8
                *exp10 = *exp10 + 1
            }
        }
    }
    var have: usize = ndig
    if len < ndig {
        have = len
    }
    var i: usize = 0
    while i < have {
        rt.buf_push(out, dig[pos + i])
        i = i + 1
    }
    if ndig > have {
        fill_zero(out, ndig - have)
    }
}
