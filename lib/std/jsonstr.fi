// SPDX-License-Identifier: MPL-2.0
// lib/std/jsonstr.fi -- std.jsonstr: `str` front for std.json (keys and strings without `p as u64, n`)
// and `json.dumps(indent=, sort_keys=)` straight from a writer's output.
//
//     import std.jsonstr
//
//     let m: u32 = jsonstr.get(&d, json.json_root(&d), "manager")      // child by key
//     let who: str = jsonstr.string(&d, m)                              // view into the document
//     jsonstr.key(&w, "name")                                           // writer: key / string value as str
//     jsonstr.value(&w, "north")
//     jsonstr.dumps(&raw, 2, true, &out)                                // compact text -> indent=2, sort_keys=True
//
// HONEST: `dumps` re-parses the compact text (the writer is streaming; sorting needs the tree), so it is
// one extra pass over the output. It returns false on invalid input or depth over json.JSON_MAX_DEPTH.
import std.rt
import std.json

export { get, string, key, value, dumps }

fn get(d: *mut json.Json, obj: u32, k: str) -> u32 {
    return json.json_get(d, obj, k.p as u64, k.n)
}

// The string value of node `i` as a view into the document ("" if it is no string).
fn string(d: *mut json.Json, i: u32) -> str {
    let s = json.json_string(d, i)
    return str { p: s.p, n: s.n }
}

fn key(w: *mut json.JsonWriter, k: str) {
    json.jw_key(w, k.p as u64, k.n)
}

fn value(w: *mut json.JsonWriter, s: str) {
    json.jw_string(w, s.p as u64, s.n)
}

// json.dumps(obj, indent=indent, sort_keys=sort) of the compact JSON text in `src`, appended to `out`.
fn dumps(src: *mut rt.Buf, indent: i32, sort: bool, out: *mut rt.Buf) -> bool {
    var d: json.Json = json.json_new()
    let ok: bool = json.json_parse(&d, rt.buf_ptr(src), rt.buf_len(src)) catch false
    if !ok {
        json.json_free(&d)
        return false
    }
    var o: json.JsonOpts = json.json_opts_indent(indent)
    if sort {
        o.flags = o.flags | json.JSON_SORT_KEYS
    }
    let r: bool = json.json_write_opts(&d, json.json_root(&d), out, &o)
    json.json_free(&d)
    return r
}
