// SPDX-License-Identifier: MPL-2.0
// lib/std/text.fi -- the small things a protocol of text lines needs:
// the n-th field of "move,12,-4" and a number out of it that cannot blow
// up.
//
//     text.field("move,12,-4", ",", 1)      "12"
//     text.int("-4")                        -4
//     text.int32("99999999999")             2147483647 (clamped, never a trap)
//     text.int("12px")                      0 (not a number)
//
// A number that arrives over the network must not be able to stop the
// program: Firn traps on an overflowing cast, so `int32` clamps instead
// of casting.
export { field, int, int32, is_int }

// Field `i` (from 0) of `s` split at every occurrence of `sep`. "" when
// there are fewer fields.
fn field(s: str, sep: str, i: usize) -> str {
    var start: usize = 0
    var k: usize = 0
    var at: usize = 0
    while at + sep.n <= s.n && sep.n > 0 {
        var same: bool = true
        var j: usize = 0
        while j < sep.n {
            if *(s.p + at + j) != *(sep.p + j) {
                same = false
                break
            }
            j = j + 1
        }
        if same {
            if k == i { return str { p: s.p + start, n: at - start } }
            k = k + 1
            at = at + sep.n
            start = at
        } else {
            at = at + 1
        }
    }
    if k == i { return str { p: s.p + start, n: s.n - start } }
    return ""
}

fn is_int(s: str) -> bool {
    var i: usize = 0
    if s.n > 0 && (*s.p == 45 as u8 || *s.p == 43 as u8) { i = 1 }
    if i >= s.n { return false }
    while i < s.n {
        let c: u8 = *(s.p + i)
        if c < 48 as u8 || c > 57 as u8 { return false }
        i = i + 1
    }
    return true
}

// Decimal with an optional sign; 0 when `s` is not a number. Saturates at
// the i64 range instead of trapping.
fn int(s: str) -> i64 {
    if !is_int(s) { return 0 }
    var neg: bool = false
    var i: usize = 0
    if *s.p == 45 as u8 {
        neg = true
        i = 1
    } else if *s.p == 43 as u8 {
        i = 1
    }
    var v: i64 = 0
    while i < s.n {
        let d: i64 = (*(s.p + i) - 48 as u8) as i64
        if v > (9223372036854775807 - d) / 10 {
            if neg { return -9223372036854775807 }
            return 9223372036854775807
        }
        v = v * 10 + d
        i = i + 1
    }
    if neg { return 0 - v }
    return v
}

// `int`, clamped to the i32 range.
fn int32(s: str) -> i32 {
    let v: i64 = int(s)
    if v > 2147483647 { return 2147483647 }
    if v < -2147483648 { return -2147483648 }
    return v as i32
}
