import std.rt

const MAX_ARGS: usize = 8

fn push_text(out: *mut rt.Buf, s: str) {
    unsafe {
        rt.buf_push_bytes(out, s.p as u64, s.n)
    }
}

fn push_byte(out: *mut rt.Buf, c: u8) {
    var one: [u8; 1] = [c; 1]
    rt.buf_push_bytes(out, rt.addr_of(&one[0]), 1)
}

fn is_digit(c: u8) -> bool {
    return c >= 48 && c <= 57
}

fn closing_brace(tpl: str, from: usize) -> usize {
    var j: usize = from
    while j < tpl.n && is_digit(tpl.chars(j)) {
        j = j + 1
    }
    if j > from && j < tpl.n && tpl.chars(j) == 125 {
        return j
    }
    return tpl.n
}

fn index_of(tpl: str, from: usize, to: usize) -> usize {
    var v: usize = 0
    var j: usize = from
    while j < to {
        v = v * 10 + (tpl.chars(j) - 48) as usize
        j = j + 1
    }
    return v
}

fn render(tpl: str, args: *mut [str; 8], count: usize) -> str {
    var out: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < tpl.n {
        let c: u8 = tpl.chars(i)
        let has_next: bool = i + 1 < tpl.n
        if c == 123 && has_next && tpl.chars(i + 1) == 123 {
            push_byte(&out, 123)
            i = i + 2
        } else if c == 125 && has_next && tpl.chars(i + 1) == 125 {
            push_byte(&out, 125)
            i = i + 2
        } else if c == 123 {
            let close: usize = closing_brace(tpl, i + 1)
            if close >= tpl.n {
                push_byte(&out, c)
                i = i + 1
            } else {
                let k: usize = index_of(tpl, i + 1, close)
                if k < count && k < MAX_ARGS {
                    push_text(&out, (*args)[k])
                } else {
                    push_text(&out, tpl.part(i, close + 1 - i))
                }
                i = close + 1
            }
        } else {
            push_byte(&out, c)
            i = i + 1
        }
    }
    let s: str = __str_copy(str { p: rt.buf_data(&out), n: rt.buf_len(&out) })
    rt.buf_free(&out)
    return s
}

fn format0(tpl: str) -> str {
    var a: [str; 8] = [""; 8]
    return render(tpl, &a, 0)
}

fn format1(tpl: str, a0: str) -> str {
    var a: [str; 8] = [""; 8]
    a[0] = a0
    return render(tpl, &a, 1)
}

fn format2(tpl: str, a0: str, a1: str) -> str {
    var a: [str; 8] = [""; 8]
    a[0] = a0
    a[1] = a1
    return render(tpl, &a, 2)
}

fn format3(tpl: str, a0: str, a1: str, a2: str) -> str {
    var a: [str; 8] = [""; 8]
    a[0] = a0
    a[1] = a1
    a[2] = a2
    return render(tpl, &a, 3)
}

fn format4(tpl: str, a0: str, a1: str, a2: str, a3: str) -> str {
    var a: [str; 8] = [""; 8]
    a[0] = a0
    a[1] = a1
    a[2] = a2
    a[3] = a3
    return render(tpl, &a, 4)
}

fn format5(tpl: str, a0: str, a1: str, a2: str, a3: str, a4: str) -> str {
    var a: [str; 8] = [""; 8]
    a[0] = a0
    a[1] = a1
    a[2] = a2
    a[3] = a3
    a[4] = a4
    return render(tpl, &a, 5)
}
