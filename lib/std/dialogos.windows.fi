// SPDX-License-Identifier: MPL-2.0
// lib/std/dialogos.windows.fi -- the operating system half of std.dialog on Windows (picked instead of
// lib/std/dialogos.fi by `--target=x86_64-windows`). Use `std.dialog`, not this file.
//
// The dialogs Windows shows to every program: `GetOpenFileNameW` / `GetSaveFileNameW` / `ChooseColorW` /
// `ChooseFontW` (comdlg32), `SHBrowseForFolderW` (shell32) and `MessageBoxW` (user32). They are `extern fn`
// imports of the compiler's own import table (compiler/src/win.rs): a Firn indirect call is System V, not
// Win64, so a COM object (IFileOpenDialog) cannot be driven from here -- docs/DIALOG.md, "Why not IFileDialog".
//
// The structures are filled with offsets, as the other Windows halves of std do (x64 layout, sizes checked
// against the SDK headers):
//   OPENFILENAMEW 152   CHOOSECOLORW 72   CHOOSEFONTW 104   LOGFONTW 92   BROWSEINFOW 64
//
// Strings arrive as UTF-8 and go to Windows as UTF-16; paths come back with "/" instead of "\".
// A dialog without an owner window is created TOP MOST for message boxes (MB_TASKMODAL | MB_SETFOREGROUND), so a
// command line tool's box is not hidden behind the console.

import rt
import str
import cmdline

export { os_name, os_file, os_color, os_font, os_message }

extern fn GetOpenFileNameW(p: u64) -> i32;
extern fn GetSaveFileNameW(p: u64) -> i32;
extern fn ChooseColorW(p: u64) -> i32;
extern fn ChooseFontW(p: u64) -> i32;
extern fn CommDlgExtendedError() -> i32;
extern fn SHBrowseForFolderW(p: u64) -> u64;
extern fn SHGetPathFromIDListW(pidl: u64, out: u64) -> i32;
extern fn CoInitializeEx(reserved: u64, flags: i64) -> i32;
extern fn CoTaskMemFree(p: u64);
extern fn MessageBoxW(hwnd: i64, text: u64, caption: u64, kind: i64) -> i32;
extern fn SendMessageW(hwnd: i64, msg: i64, wp: i64, lp: i64) -> i64;

const OK: i32 = 0
const CANCELED: i32 = 1
const NO_BACKEND: i32 = 2
const FAILED: i32 = 3

const FILE_UNITS: usize = 32768 // UTF-16 units of the file name buffer (multi select needs room)

const OFN_HIDEREADONLY: u32 = 4
const OFN_OVERWRITEPROMPT: u32 = 2
const OFN_NOCHANGEDIR: u32 = 8
const OFN_ALLOWMULTISELECT: u32 = 512
const OFN_PATHMUSTEXIST: u32 = 2048
const OFN_FILEMUSTEXIST: u32 = 4096
const OFN_EXPLORER: u32 = 524288

const CC_RGBINIT: u32 = 1
const CC_FULLOPEN: u32 = 2
const CC_ANYCOLOR: u32 = 256

const CF_SCREENFONTS: u32 = 1
const CF_INITTOLOGFONTSTRUCT: u32 = 64
const CF_NOSCRIPTSEL: u32 = 8388608

const BIF_RETURNONLYFSDIRS: u32 = 1
const BIF_NEWDIALOGSTYLE: u32 = 64

fn os_name() -> str {
    return "win32"
}

// UTF-8 as UTF-16 with a terminating zero.
fn wide(s: str, b: *mut rt.Buf) {
    cmdline.utf8_to_utf16(s.p as u64, s.length(), b)
    cmdline.push_u16(b, 0 as u16)
}

fn wide_path(s: str, b: *mut rt.Buf) {
    cmdline.utf8_to_utf16_path(s.p as u64, s.length(), b)
    cmdline.push_u16(b, 0 as u16)
}

// "Label|pat;pat|Label|pat" -> "Label\0pat;pat\0Label\0pat\0\0". No filter: every file.
fn wide_filters(f: str, b: *mut rt.Buf) {
    if f.length() == 0 {
        wide("All files", b)
        wide("*.*", b)
        cmdline.push_u16(b, 0 as u16)
        return
    }
    var start: usize = 0
    var seg: usize = 0
    var i: usize = 0
    while i <= f.length() {
        if i == f.length() || f.chars(i) == 124 as u8 {
            cmdline.utf8_to_utf16(f.p as u64 + start as u64, i - start, b)
            cmdline.push_u16(b, 0 as u16)
            seg = seg + 1
            start = i + 1
        }
        i = i + 1
    }
    if seg % 2 == 1 {
        wide("*.*", b)
    }
    cmdline.push_u16(b, 0 as u16)
}

// The UTF-16 string at `p` (units from `from`) up to its zero, as UTF-8 with "/" for "\" appended to `out`.
// Returns the number of units read, without the zero.
fn take_wide(p: u64, from: usize, max: usize, out: *mut rt.Buf) -> usize {
    var n: usize = 0
    while from + n < max && rt.ld16(p, from + n) != 0 as u16 {
        n = n + 1
    }
    let start: usize = rt.buf_len(out)
    cmdline.utf16_to_utf8(p + (from * 2) as u64, n, out)
    var i: usize = start
    while i < rt.buf_len(out) {
        if rt.buf_at(out, i) == 92 as u8 {
            rt.st8(rt.buf_ptr(out), i, 47 as u8)
        }
        i = i + 1
    }
    return n
}

fn cancel_or_failed() -> i32 {
    if CommDlgExtendedError() == 0 {
        return CANCELED
    }
    return FAILED
}

// The folder dialog calls this when it is up (BFFM_INITIALIZED = 1) and the folder to start in is `data` (a UTF-16
// path): BFFM_SETSELECTIONW (WM_USER + 103) selects it. A Win64 callback: `#[win_callback]` puts the thunk in front.
#[win_callback]
fn browse_cb(hwnd: u64, msg: u64, lp: u64, data: u64) -> u64 {
    if msg == 1 as u64 && data != 0 as u64 {
        SendMessageW(hwnd as i64, 1130, 1, data as i64) // BFFM_SETEXPANDEDW: open the tree down to it
        SendMessageW(hwnd as i64, 1127, 1, data as i64) // BFFM_SETSELECTIONW
    }
    return 0 as u64
}

// A value of type `fn(..)` is a pointer to a record whose first word holds the code address -- with
// `#[win_callback]` that word is the Win64 -> System V thunk (see lib/window/win32.fi, `code_of4`).
struct Holder4 {
    f: fn(u64, u64, u64, u64) -> u64,
}

fn code_of4(f: fn(u64, u64, u64, u64) -> u64) -> u64 {
    var roh: [u64; 1] = [0; 1]
    let h: *mut Holder4 = (&roh[0]) as *mut Holder4
    (*h).f = f
    return *((roh[0]) as *mut u64)
}

fn folder(title: str, dir: str, out: *mut rt.Buf) -> i32 {
    // the new style dialog needs COM; S_FALSE (already initialised) is fine
    CoInitializeEx(0, 2)
    var t: rt.Buf = rt.buf_new()
    var d: rt.Buf = rt.buf_new()
    wide(title, &t)
    wide_path(dir, &d)
    let name: u64 = rt.heap_alloc(2080)
    rt.mem_set(name, 0 as u8, 2080)
    let bi: u64 = rt.heap_alloc(64)
    rt.mem_set(bi, 0 as u8, 64)
    rt.st64(bi, 2, name) // pszDisplayName
    rt.st64(bi, 3, rt.buf_ptr(&t)) // lpszTitle
    rt.st32(bi, 8, BIF_RETURNONLYFSDIRS | BIF_NEWDIALOGSTYLE)
    if dir.length() > 0 {
        rt.st64(bi, 5, code_of4(browse_cb)) // lpfn
        rt.st64(bi, 6, rt.buf_ptr(&d)) // lParam: the folder to start in
    }
    let pidl: u64 = SHBrowseForFolderW(bi)
    var r: i32 = CANCELED
    if pidl != 0 {
        if SHGetPathFromIDListW(pidl, name) != 0 {
            take_wide(name, 0, 1040, out)
            r = OK
        } else {
            r = FAILED // a place that is no directory (Control Panel ...)
        }
        CoTaskMemFree(pidl)
    }
    rt.heap_free(bi, 64)
    rt.heap_free(name, 2080)
    rt.buf_free(&t)
    rt.buf_free(&d)
    return r
}

// mode: 0 open, 1 open several, 2 save, 3 folder.
fn os_file(mode: i32, title: str, dir: str, name: str, filters: str, out: *mut rt.Buf) -> i32 {
    if mode == 3 {
        return folder(title, dir, out)
    }
    var ft: rt.Buf = rt.buf_new()
    var ti: rt.Buf = rt.buf_new()
    var di: rt.Buf = rt.buf_new()
    wide_filters(filters, &ft)
    wide(title, &ti)
    wide_path(dir, &di)
    let file: u64 = rt.heap_alloc(FILE_UNITS * 2)
    rt.mem_set(file, 0 as u8, FILE_UNITS * 2)
    if mode == 2 && name.length() > 0 {
        var nm: rt.Buf = rt.buf_new()
        wide_path(name, &nm)
        var k: usize = rt.buf_len(&nm)
        if k > (FILE_UNITS - 1) * 2 {
            k = (FILE_UNITS - 1) * 2
        }
        rt.mem_copy(file, rt.buf_ptr(&nm), k)
        rt.buf_free(&nm)
    }
    let ofn: u64 = rt.heap_alloc(152)
    rt.mem_set(ofn, 0 as u8, 152)
    var flags: u32 = OFN_EXPLORER | OFN_NOCHANGEDIR | OFN_HIDEREADONLY | OFN_PATHMUSTEXIST
    if mode == 2 {
        flags = flags | OFN_OVERWRITEPROMPT
    } else {
        flags = flags | OFN_FILEMUSTEXIST
    }
    if mode == 1 {
        flags = flags | OFN_ALLOWMULTISELECT
    }
    rt.st32(ofn, 0, 152 as u32) // lStructSize
    rt.st64(ofn, 3, rt.buf_ptr(&ft)) // lpstrFilter
    rt.st32(ofn, 11, 1 as u32) // nFilterIndex
    rt.st64(ofn, 6, file) // lpstrFile
    rt.st32(ofn, 14, FILE_UNITS as u32) // nMaxFile (units)
    if dir.length() > 0 {
        rt.st64(ofn, 10, rt.buf_ptr(&di)) // lpstrInitialDir
    }
    if title.length() > 0 {
        rt.st64(ofn, 11, rt.buf_ptr(&ti)) // lpstrTitle
    }
    rt.st32(ofn, 24, flags) // Flags
    var ok: i32 = 0
    if mode == 2 {
        ok = GetSaveFileNameW(ofn)
    } else {
        ok = GetOpenFileNameW(ofn)
    }
    var r: i32 = OK
    if ok == 0 {
        r = cancel_or_failed()
    } else {
        let n0: usize = take_wide_probe(file)
        if mode == 1 && rt.ld16(file, n0 + 1) != 0 as u16 {
            // "dir\0file1\0file2\0\0": the directory first, then the names
            var dd: rt.Buf = rt.buf_new()
            take_wide(file, 0, FILE_UNITS, &dd)
            var pos: usize = n0 + 1
            var first: bool = true
            while pos < FILE_UNITS && rt.ld16(file, pos) != 0 as u16 {
                if !first {
                    rt.buf_push(out, 10 as u8)
                }
                first = false
                rt.buf_push_bytes(out, rt.buf_ptr(&dd), rt.buf_len(&dd))
                if rt.buf_len(&dd) > 0 && rt.buf_at(&dd, rt.buf_len(&dd) - 1) != 47 as u8 {
                    rt.buf_push(out, 47 as u8)
                }
                pos = pos + take_wide(file, pos, FILE_UNITS, out) + 1
            }
            rt.buf_free(&dd)
        } else {
            take_wide(file, 0, FILE_UNITS, out)
        }
    }
    rt.heap_free(ofn, 152)
    rt.heap_free(file, FILE_UNITS * 2)
    rt.buf_free(&ft)
    rt.buf_free(&ti)
    rt.buf_free(&di)
    return r
}

// The length in units of the first string at `p`.
fn take_wide_probe(p: u64) -> usize {
    var n: usize = 0
    while n < FILE_UNITS && rt.ld16(p, n) != 0 as u16 {
        n = n + 1
    }
    return n
}

fn os_color(title: str, initial: u32, out: *mut u32) -> i32 {
    let cc: u64 = rt.heap_alloc(72)
    rt.mem_set(cc, 0 as u8, 72)
    let custom: u64 = rt.heap_alloc(64)
    rt.mem_set(custom, 0 as u8, 64)
    // 16 custom colours: white, so an untouched row is not a random black
    var i: usize = 0
    while i < 16 {
        rt.st32(custom, i, 16777215 as u32)
        i = i + 1
    }
    let red: u32 = (initial >> 16) & 255 as u32
    let green: u32 = (initial >> 8) & 255 as u32
    let blue: u32 = initial & 255 as u32
    rt.st32(cc, 0, 72 as u32) // lStructSize
    rt.st32(cc, 6, red | (green << 8) | (blue << 16)) // rgbResult (COLORREF 0x00BBGGRR)
    rt.st64(cc, 4, custom) // lpCustColors
    rt.st32(cc, 10, CC_RGBINIT | CC_FULLOPEN | CC_ANYCOLOR)
    var r: i32 = OK
    if ChooseColorW(cc) == 0 {
        r = cancel_or_failed()
    } else {
        let v: u32 = rt.ld32(cc, 6)
        *out = ((v & 255 as u32) << 16) | (v & 65280 as u32) | ((v >> 16) & 255 as u32)
    }
    rt.heap_free(custom, 64)
    rt.heap_free(cc, 72)
    return r
}

fn os_font(title: str, family: str, size: u32, out_family: *mut rt.Buf, out_size: *mut u32, out_flags: *mut u32) -> i32 {
    let lf: u64 = rt.heap_alloc(96)
    rt.mem_set(lf, 0 as u8, 96)
    let cf: u64 = rt.heap_alloc(104)
    rt.mem_set(cf, 0 as u8, 104)
    var fam: rt.Buf = rt.buf_new()
    cmdline.utf8_to_utf16(family.p as u64, family.length(), &fam)
    var units: usize = rt.buf_len(&fam) / 2
    if units > 31 {
        units = 31
    }
    rt.mem_copy(lf + 28 as u64, rt.buf_ptr(&fam), units * 2) // lfFaceName
    if size > 0 as u32 {
        rt.st32(lf, 0, (4294967295 as u32) - ((size * 96 as u32 + 36 as u32) / 72 as u32) + (1 as u32)) // -height as two's complement   // lfHeight, negative = character height
    }
    rt.st32(lf, 4, 400 as u32) // lfWeight
    rt.st32(cf, 0, 104 as u32) // lStructSize
    rt.st64(cf, 3, lf) // lpLogFont
    rt.st32(cf, 8, size * 10 as u32) // iPointSize (tenths)
    rt.st32(cf, 9, CF_SCREENFONTS | CF_INITTOLOGFONTSTRUCT | CF_NOSCRIPTSEL)
    var r: i32 = OK
    if ChooseFontW(cf) == 0 {
        r = cancel_or_failed()
    } else {
        var nu: usize = 0
        while nu < 32 && rt.ld16(lf + 28 as u64, nu) != 0 as u16 {
            nu = nu + 1
        }
        cmdline.utf16_to_utf8(lf + 28 as u64, nu, out_family)
        *out_size = ((rt.ld32(cf, 8) + 5 as u32) / 10 as u32)
        var fl: u32 = 0 as u32
        if rt.ld32(lf, 4) >= 600 as u32 {
            fl = fl | 1 as u32
        }
        if rt.ld8(lf, 20) != 0 as u8 {
            fl = fl | 2 as u32
        }
        *out_flags = fl
    }
    rt.buf_free(&fam)
    rt.heap_free(cf, 104)
    rt.heap_free(lf, 96)
    return r
}

const MB_OK: i64 = 0
const MB_OKCANCEL: i64 = 1
const MB_YESNOCANCEL: i64 = 3
const MB_YESNO: i64 = 4
const MB_ICONERROR: i64 = 16
const MB_ICONQUESTION: i64 = 32
const MB_ICONWARNING: i64 = 48
const MB_ICONINFORMATION: i64 = 64
const MB_TASKMODAL: i64 = 8192
const MB_SETFOREGROUND: i64 = 65536

fn os_message(kind: i32, title: str, text: str, buttons: i32, answer: *mut i32) -> i32 {
    var ty: i64 = MB_TASKMODAL | MB_SETFOREGROUND
    if buttons == 1 { ty = ty | MB_OKCANCEL }
    if buttons == 2 { ty = ty | MB_YESNO }
    if buttons == 3 { ty = ty | MB_YESNOCANCEL }
    if kind == 0 { ty = ty | MB_ICONINFORMATION }
    if kind == 1 { ty = ty | MB_ICONQUESTION }
    if kind == 2 { ty = ty | MB_ICONWARNING }
    if kind == 3 { ty = ty | MB_ICONERROR }
    var tb: rt.Buf = rt.buf_new()
    var xb: rt.Buf = rt.buf_new()
    wide(title, &tb)
    wide(text, &xb)
    let id: i32 = MessageBoxW(0, rt.buf_ptr(&xb), rt.buf_ptr(&tb), ty)
    rt.buf_free(&tb)
    rt.buf_free(&xb)
    if id == 0 {
        return FAILED
    }
    // IDOK 1, IDCANCEL 2, IDYES 6, IDNO 7
    if id == 6 { *answer = 3 }
    else if id == 7 { *answer = 4 }
    else if id == 2 { *answer = 2 }
    else { *answer = 1 }
    return OK
}
