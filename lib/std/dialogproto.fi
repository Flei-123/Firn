// SPDX-License-Identifier: MPL-2.0
// lib/std/dialogproto.fi -- the line protocol between std.dialog and a dialog service (`dialogd`, docs/DIALOG.md).
// Used by both sides, so the escaping exists once.
//
// One message is ONE line: fields separated by TAB, inside a field `\` is written `\\`, TAB `\t`, line feed `\n`,
// carriage return `\r`. The line ends with a line feed.
//
//     open_file<TAB>Open a picture<TAB>/home/x<TAB>Pictures|*.png;*.jpg\n
//     ok<TAB>/home/x/a.png\n            cancel\n            failed\n

import rt
import str

export { push_field, field_at, field_count, hex_digit }

// Appends `s` as the next field (a TAB first when `first` is false), escaped.
fn push_field(out: *mut rt.Buf, s: str, first: bool) {
    if !first {
        rt.buf_push(out, 9 as u8)
    }
    var i: usize = 0
    while i < s.length() {
        let c: u8 = s.chars(i)
        if c == 92 as u8 {
            rt.buf_push(out, 92 as u8)
            rt.buf_push(out, 92 as u8)
        } else if c == 9 as u8 {
            rt.buf_push(out, 92 as u8)
            rt.buf_push(out, 116 as u8)
        } else if c == 10 as u8 {
            rt.buf_push(out, 92 as u8)
            rt.buf_push(out, 110 as u8)
        } else if c == 13 as u8 {
            rt.buf_push(out, 92 as u8)
            rt.buf_push(out, 114 as u8)
        } else {
            rt.buf_push(out, c)
        }
        i = i + 1
    }
}

// How many fields the line has (an empty line has one empty field).
fn field_count(line: str) -> usize {
    var n: usize = 1
    var i: usize = 0
    while i < line.length() {
        if line.chars(i) == 9 as u8 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// Field number `idx` (from 0), unescaped, APPENDED to `out`. false = there is no such field.
fn field_at(line: str, idx: usize, out: *mut rt.Buf) -> bool {
    var k: usize = 0
    var i: usize = 0
    while i < line.length() && k < idx {
        if line.chars(i) == 9 as u8 {
            k = k + 1
        }
        i = i + 1
    }
    if k < idx {
        return false
    }
    while i < line.length() {
        let c: u8 = line.chars(i)
        if c == 9 as u8 {
            break
        }
        if c == 92 as u8 && i + 1 < line.length() {
            let d: u8 = line.chars(i + 1)
            if d == 116 as u8 {
                rt.buf_push(out, 9 as u8)
            } else if d == 110 as u8 {
                rt.buf_push(out, 10 as u8)
            } else if d == 114 as u8 {
                rt.buf_push(out, 13 as u8)
            } else {
                rt.buf_push(out, d)
            }
            i = i + 2
            continue
        }
        rt.buf_push(out, c)
        i = i + 1
    }
    return true
}

// The value of a hexadecimal digit, -1 when `c` is none.
fn hex_digit(c: u8) -> i32 {
    if c >= 48 as u8 && c <= 57 as u8 {
        return (c - 48 as u8) as i32
    }
    if c >= 97 as u8 && c <= 102 as u8 {
        return (c - 97 as u8) as i32 + 10
    }
    if c >= 65 as u8 && c <= 70 as u8 {
        return (c - 65 as u8) as i32 + 10
    }
    return -1
}
