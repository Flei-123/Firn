// lib/std/io.fi -- std.io: the unified input/output facade.
//
// Part of the std facade (round 39): uniform, C# flavored names on top of
// the building blocks from lib/rt -- those stay unchanged, std calls them.
// `rt` lies next to this file (lib/std/rt.fi), so that the import resolves
// inside every project directory.
//
// It also contains the `Fmt` builder: the parser translates the string
// interpolation `f"..."` at compile time into a chain of
// `fmt_new/fmt_text/fmt_number` -- no varargs, no parsing at run time.
import rt

export {
    // round 39
    print, eprint, read_file, write_file,
    Fmt, fmt_new, fmt_text, fmt_number, fmt_len, fmt_print, fmt_free,
    // round 42 -- output, files, lines
    println, eprintln, print_c, eprint_c, print_line, print_fd,
    read_stdin, append_file, file_exists,
    LineReader, lines_new, lines_of_buf, lines_next, lines_number,
    // round 42 -- the Fmt builder, built out
    fmt_char, fmt_bool, fmt_u64, fmt_hex, fmt_c, fmt_repeat,
    fmt_line, fmt_wide, fmt_append, fmt_content, fmt_print_line,
    fmt_eprint, fmt_eprint_line, fmt_in_file,
}

// ------------------------------------------------------------ Input/output

// `n` octets from `p` onto stdout (fd 1), written completely.
fn print(p: u64, n: usize) {
    rt.write_everything(1, p, n)
}

// `n` octets from `p` onto stderr (fd 2), written completely.
fn eprint(p: u64, n: usize) {
    rt.write_everything(2, p, n)
}

// Reads a whole file into `out`. `path` points at a null terminated
// sequence. true = it was read.
fn read_file(path: u64, out: *mut rt.Buf) -> bool {
    return rt.read_file(path, out)
}

// Writes `n` octets from `p` into a file (overwriting, mode 0755).
// true = it was written.
fn write_file(path: u64, p: u64, n: usize) -> bool {
    return rt.write_file(path, p, n)
}

// --------------------------------------------------------- The Fmt builder
//
// Assembling text inside a growing buffer. Every step takes the builder BY
// VALUE and gives it back BY VALUE -- that way the chain is a single
// expression, and that is exactly what the parser produces for `f"..."`.
struct Fmt {
    b: rt.Buf,
}

// An empty builder.
fn fmt_new() -> Fmt {
    return Fmt{ b: rt.buf_new() }
}

// Append a text segment: `n` octets from `p` (NOT null terminated).
fn fmt_text(f: Fmt, p: u64, n: usize) -> Fmt {
    var g: Fmt = f
    rt.buf_push_bytes(&g.b, p, n)
    return g
}

// A scalar value as decimal text. The parser does not know the type of an
// interpolated expression at compile time -- so the interpolation inserts
// it with `as i64`.
// AN HONEST LIMIT of the core version: the display is the one of `i64`
// (a u64 above i64::MAX wraps around, an f64 is truncated, a bool becomes
// 0/1). Integers -- the normal case -- are always right.
fn fmt_number(f: Fmt, v: i64) -> Fmt {
    var g: Fmt = f
    rt.buf_push_dec_i64(&g.b, v)
    return g
}

// The length of the built text in octets.
fn fmt_len(f: Fmt) -> usize {
    var g: Fmt = f
    return rt.buf_len(&g.b)
}

// Write the content onto stdout and release the buffer.
fn fmt_print(f: Fmt) {
    var g: Fmt = f
    rt.write_everything(1, rt.buf_ptr(&g.b), rt.buf_len(&g.b))
    rt.buf_free(&g.b)
}

// Release the buffer without printing anything.
fn fmt_free(f: Fmt) {
    var g: Fmt = f
    rt.buf_free(&g.b)
}

// =====================================================================
// Round 42 -- the build out: lines, stdin, appending to files and an Fmt
// builder that can do more than text and decimal numbers.
// =====================================================================

const O_ONLY_READ: i64 = 0
const O_APPEND: i64 = 1089      // O_WRONLY|O_CREAT|O_APPEND
const O_RECHTE: i64 = 493          // 0755
const SYS_OEFFNEN: i64 = 2
const SYS_CLOSE: i64 = 3

// ----------------------------------------------------- Output, short forms

// Like `print`, with a line feed. Two write calls -- an intermediate buffer
// would be one allocation per line.
fn println(p: u64, n: usize) {
    rt.write_everything(1, p, n)
    var nl: [u8; 1] = "\n"
    rt.write_everything(1, (&nl[0]) as u64, 1)
}

fn eprintln(p: u64, n: usize) {
    rt.write_everything(2, p, n)
    var nl: [u8; 1] = "\n"
    rt.write_everything(2, (&nl[0]) as u64, 1)
}

// A null terminated sequence (without the null octet) -- the form command
// line arguments arrive in (`rt.arg_ptr`).
fn print_c(p: u64) {
    rt.write_everything(1, p, rt.c_length(p))
}

fn eprint_c(p: u64) {
    rt.write_everything(2, p, rt.c_length(p))
}

fn print_line() {
    var nl: [u8; 1] = "\n"
    rt.write_everything(1, (&nl[0]) as u64, 1)
}

// Onto an arbitrary descriptor. `false` = the write call broke off.
fn print_fd(fd: i64, p: u64, n: usize) -> bool {
    return rt.write_everything(fd, p, n)
}

// ------------------------------------------------------------------- Files

// Everything from standard input up to the end.
fn read_stdin(out: *mut rt.Buf) -> bool {
    return rt.read_stdin(out)
}

// APPEND to a file instead of overwriting it (O_APPEND). Creates it if it
// is missing. That is the difference between a log and a lost log.
// einem verlorenen Protokoll.
fn append_file(path: u64, p: u64, n: usize) -> bool {
    let fd: i64 = syscall(SYS_OEFFNEN, path as i64, O_APPEND, O_RECHTE, 0, 0, 0)
    if fd < 0 {
        return false
    }
    let ok: bool = rt.write_everything(fd, p, n)
    syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0)
    return ok
}

// Can the file be opened for reading? Stage 0 says no more than that: there
// is no `stat`, and guessing from the size would be a lie.
fn file_exists(path: u64) -> bool {
    let fd: i64 = syscall(SYS_OEFFNEN, path as i64, O_ONLY_READ, 0, 0, 0, 0)
    if fd < 0 {
        return false
    }
    syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0)
    return true
}

// ------------------------------------------------------------------- Lines
//
// A CURSOR over a block that has already been read -- no second buffer, no
// copying. Every line comes as pointer + length INSIDE the block:
//
//     var buf: rt.Buf = rt.buf_new()
//     io.read_file(path, &buf)
//     var z: io.LineReader = io.lines_of_buf(&buf)
//     var p: u64 = 0
//     var n: usize = 0
//     while io.lines_next(&z, &p, &n) { ... }
//
// The line feed is NOT part of the line; a preceding \r is removed with it
// (DOS line endings). If the block ends with \n there is NO empty final
// line -- that is the rule `wc -l` and every editor use.
// benutzen.

struct LineReader {
    p: u64,
    n: usize,
    i: usize,
}

fn lines_new(p: u64, n: usize) -> LineReader {
    return LineReader{ p: p, n: n, i: 0 }
}

fn lines_of_buf(b: *mut rt.Buf) -> LineReader {
    return LineReader{ p: rt.buf_ptr(b), n: rt.buf_len(b), i: 0 }
}

fn lines_next(z: *mut LineReader, ap: *mut u64, an: *mut usize) -> bool {
    let end: usize = (*z).n
    var i: usize = (*z).i
    if i >= end {
        return false
    }
    let start: usize = i
    while i < end && rt.ld8((*z).p, i) != 10 as u8 {
        i = i + 1
    }
    var length: usize = i - start
    if length > 0 && rt.ld8((*z).p, start + length - 1) == 13 as u8 {
        length = length - 1
    }
    *ap = (*z).p + start as u64
    *an = length
    if i < end {
        i = i + 1
    }
    (*z).i = i
    return true
}

// How many lines the block has (without consuming it).
fn lines_number(p: u64, n: usize) -> usize {
    var z: LineReader = lines_new(p, n)
    var ap: u64 = 0
    var an: usize = 0
    var k: usize = 0
    while lines_next(&z, &ap, &an) {
        k = k + 1
    }
    return k
}

// ---------------------------------------------------------- Fmt, built out
//
// The same shape as in round 39: value in, value out, so that the whole
// chain stays ONE expression.

// A single octet. With it `{c}` becomes printable as a LETTER -- with
// `fmt_number` the number 65 would come out instead of "A".
fn fmt_char(f: Fmt, c: u8) -> Fmt {
    var g: Fmt = f
    rt.buf_push(&g.b, c)
    return g
}

fn fmt_bool(f: Fmt, w: bool) -> Fmt {
    var g: Fmt = f
    var ja: [u8; 4] = "wahr"
    var no: [u8; 6] = "falsch"
    if w {
        rt.buf_push_bytes(&g.b, (&ja[0]) as u64, 4)
    } else {
        rt.buf_push_bytes(&g.b, (&no[0]) as u64, 6)
    }
    return g
}

// Unsigned -- `fmt_number` shows i64 and would wrap above i64::MAX.
fn fmt_u64(f: Fmt, v: u64) -> Fmt {
    var g: Fmt = f
    rt.buf_push_dec_u64(&g.b, v)
    return g
}

// Hexadecimal, at least `min` digits, without "0x".
fn fmt_hex(f: Fmt, v: u64, min: usize) -> Fmt {
    var g: Fmt = f
    rt.buf_push_hex_u64(&g.b, v, min)
    return g
}

// A null terminated sequence.
fn fmt_c(f: Fmt, p: u64) -> Fmt {
    var g: Fmt = f
    rt.buf_push_bytes(&g.b, p, rt.c_length(p))
    return g
}

fn fmt_repeat(f: Fmt, c: u8, times: usize) -> Fmt {
    var g: Fmt = f
    var i: usize = 0
    while i < times {
        rt.buf_push(&g.b, c)
        i = i + 1
    }
    return g
}

fn fmt_line(f: Fmt) -> Fmt {
    var g: Fmt = f
    rt.buf_push(&g.b, 10 as u8)
    return g
}

// Pad to `width` on the right, then the number -- for tables.
fn fmt_wide(f: Fmt, v: i64, width: usize, filler: u8) -> Fmt {
    var g: Fmt = f
    var digits: usize = 1
    var x: u64 = v as u64
    if v < 0 {
        digits = 2
        x = (0 - (v + 1)) as u64 + 1
    }
    var rest: u64 = x / 10
    while rest > 0 {
        digits = digits + 1
        rest = rest / 10
    }
    var i: usize = digits
    while i < width {
        rt.buf_push(&g.b, filler)
        i = i + 1
    }
    rt.buf_push_dec_i64(&g.b, v)
    return g
}

// Join two builders: `h` is appended AND RELEASED. That lets a function
// return an Fmt which the caller keeps building on.
fn fmt_append(f: Fmt, h: Fmt) -> Fmt {
    var g: Fmt = f
    var q: Fmt = h
    rt.buf_push_bytes(&g.b, rt.buf_ptr(&q.b), rt.buf_len(&q.b))
    rt.buf_free(&q.b)
    return g
}

// APPEND the content to a buffer and release the builder -- the way to not
// print an `f"..."` but to process it further.
fn fmt_content(f: Fmt, out: *mut rt.Buf) {
    var g: Fmt = f
    rt.buf_push_bytes(out, rt.buf_ptr(&g.b), rt.buf_len(&g.b))
    rt.buf_free(&g.b)
}

fn fmt_print_line(f: Fmt) {
    var g: Fmt = f
    rt.buf_push(&g.b, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&g.b), rt.buf_len(&g.b))
    rt.buf_free(&g.b)
}

// Onto stderr instead of stdout -- diagnostics do not belong in the output.
fn fmt_eprint(f: Fmt) {
    var g: Fmt = f
    rt.write_everything(2, rt.buf_ptr(&g.b), rt.buf_len(&g.b))
    rt.buf_free(&g.b)
}

fn fmt_eprint_line(f: Fmt) {
    var g: Fmt = f
    rt.buf_push(&g.b, 10 as u8)
    rt.write_everything(2, rt.buf_ptr(&g.b), rt.buf_len(&g.b))
    rt.buf_free(&g.b)
}

// Write into a file (overwriting) and release.
fn fmt_in_file(f: Fmt, path: u64) -> bool {
    var g: Fmt = f
    let ok: bool = rt.write_file(path, rt.buf_ptr(&g.b), rt.buf_len(&g.b))
    rt.buf_free(&g.b)
    return ok
}
