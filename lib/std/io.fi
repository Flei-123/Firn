// lib/std/io.fi — std.io: die einheitliche Ein-/Ausgabe-Fassade.
//
// Gehoert zur std-Fassade (Runde 39): C#-fuehlig einheitliche Namen ueber
// den Bausteinen aus lib/rt — die bleiben unveraendert, std ruft sie auf.
// `rt` liegt neben dieser Datei (lib/std/rt.fi), damit der Import in jedem
// Projektverzeichnis aufloest.
//
// Enthaelt auch den `Fmt`-Builder: die String-Interpolation `f"..."`
// uebersetzt der Parser zur Uebersetzungszeit in eine Kette aus
// `fmt_neu/fmt_text/fmt_zahl` — keine Varargs, kein Laufzeit-Parsen.
import rt

export {
    // Runde 39
    print, eprint, read_file, write_file,
    Fmt, fmt_new, fmt_text, fmt_number, fmt_len, fmt_print, fmt_free,
    // Runde 42 — Ausgabe, Dateien, Zeilen
    println, eprintln, print_c, eprint_c, print_line, print_fd,
    read_stdin, append_file, file_exists,
    LineReader, lines_new, lines_of_buf, lines_next, lines_number,
    // Runde 42 — der Fmt-Builder, ausgebaut
    fmt_char, fmt_bool, fmt_u64, fmt_hex, fmt_c, fmt_repeat,
    fmt_line, fmt_wide, fmt_append, fmt_content, fmt_print_line,
    fmt_eprint, fmt_eprint_line, fmt_in_file,
}

// ------------------------------------------------------------- Ein-/Ausgabe

// `n` Oktette ab `p` auf stdout (fd 1), vollstaendig geschrieben.
fn print(p: u64, n: usize) {
    rt.write_everything(1, p, n)
}

// `n` Oktette ab `p` auf stderr (fd 2), vollstaendig geschrieben.
fn eprint(p: u64, n: usize) {
    rt.write_everything(2, p, n)
}

// Liest eine ganze Datei in `aus`. `pfad` zeigt auf eine nullabgeschlossene
// Folge. true = gelesen.
fn read_file(path: u64, out: *mut rt.Buf) -> bool {
    return rt.read_file(path, out)
}

// Schreibt `n` Oktette ab `p` in eine Datei (ueberschreibt, Rechte 0755).
// true = geschrieben.
fn write_file(path: u64, p: u64, n: usize) -> bool {
    return rt.write_file(path, p, n)
}

// ------------------------------------------------------------- Fmt-Builder
//
// Text in einem wachsenden Puffer zusammenbauen. Jede Stufe nimmt den
// Builder ALS WERT und gibt ihn ALS WERT zurueck — so ist die Kette ein
// einziger Ausdruck, und genau den erzeugt der Parser fuer `f"..."`.
struct Fmt {
    b: rt.Buf,
}

// Leerer Builder.
fn fmt_new() -> Fmt {
    return Fmt{ b: rt.buf_new() }
}

// Textsegment anhaengen: `n` Oktette ab `p` (NICHT nullabgeschlossen).
fn fmt_text(f: Fmt, p: u64, n: usize) -> Fmt {
    var g: Fmt = f
    rt.buf_push_bytes(&g.b, p, n)
    return g
}

// Skalarer Wert als Dezimaltext. Der Parser kennt den Typ eines
// interpolierten Ausdrucks zur Uebersetzungszeit nicht — die
// Interpolation setzt ihn deshalb mit `as i64` ein.
// EHRLICHE GRENZE der Kernfassung: die Anzeige ist die von `i64`
// (u64 oberhalb von i64::MAX bricht um, f64 schneidet ab, bool wird zu
// 0/1). Ganzzahlen — der Regelfall — stimmen immer.
fn fmt_number(f: Fmt, v: i64) -> Fmt {
    var g: Fmt = f
    rt.buf_push_dec_i64(&g.b, v)
    return g
}

// Laenge des gebauten Textes in Oktetten.
fn fmt_len(f: Fmt) -> usize {
    var g: Fmt = f
    return rt.buf_len(&g.b)
}

// Inhalt auf stdout schreiben und den Puffer freigeben.
fn fmt_print(f: Fmt) {
    var g: Fmt = f
    rt.write_everything(1, rt.buf_ptr(&g.b), rt.buf_len(&g.b))
    rt.buf_free(&g.b)
}

// Puffer freigeben, ohne etwas auszugeben.
fn fmt_free(f: Fmt) {
    var g: Fmt = f
    rt.buf_free(&g.b)
}

// =====================================================================
// Runde 42 — der Ausbau: Zeilen, stdin, Anhaengen an Dateien und ein
// Fmt-Builder, der mehr kann als Text und Dezimalzahl.
// =====================================================================

const O_NUR_LESEN: i64 = 0
const O_ANHAENGEN: i64 = 1089      // O_WRONLY|O_CREAT|O_APPEND
const O_RECHTE: i64 = 493          // 0755
const SYS_OEFFNEN: i64 = 2
const SYS_SCHLIESSEN: i64 = 3

// --------------------------------------------------------- Ausgabe kurz

// Wie `print`, mit Zeilenvorschub. Zwei Schreibaufrufe — ein Zwischenpuffer
// waere eine Allokation je Zeile.
fn println(p: u64, n: usize) {
    rt.write_everything(1, p, n)
    var nl: [u8; 1] = "\n"
    rt.write_everything(1, (&nl[0]) as u64, 1)
}

fn eprintln(p: u64, n: usize) {
    rt.write_everything(2, p, n)
    var nl: [u8; 1] = "\n"
    rt.write_everything(2, (&nl[0]) as u64, 1)
}

// Nullabgeschlossene Folge (ohne das Nulloktett) — die Form, in der
// Kommandozeilenargumente ankommen (`rt.arg_zeiger`).
fn print_c(p: u64) {
    rt.write_everything(1, p, rt.c_length(p))
}

fn eprint_c(p: u64) {
    rt.write_everything(2, p, rt.c_length(p))
}

fn print_line() {
    var nl: [u8; 1] = "\n"
    rt.write_everything(1, (&nl[0]) as u64, 1)
}

// Auf einen beliebigen Deskriptor. `false` = der Schreibaufruf brach ab.
fn print_fd(fd: i64, p: u64, n: usize) -> bool {
    return rt.write_everything(fd, p, n)
}

// ------------------------------------------------------------- Dateien

// Alles von der Standardeingabe bis zum Ende.
fn read_stdin(out: *mut rt.Buf) -> bool {
    return rt.read_stdin(out)
}

// An eine Datei ANHAENGEN statt sie zu ueberschreiben (O_APPEND). Legt sie
// an, wenn sie fehlt. Das ist der Unterschied zwischen einem Protokoll und
// einem verlorenen Protokoll.
fn append_file(path: u64, p: u64, n: usize) -> bool {
    let fd: i64 = syscall(SYS_OEFFNEN, path as i64, O_ANHAENGEN, O_RECHTE, 0, 0, 0)
    if fd < 0 {
        return false
    }
    let ok: bool = rt.write_everything(fd, p, n)
    syscall(SYS_SCHLIESSEN, fd, 0, 0, 0, 0, 0)
    return ok
}

// Laesst sich die Datei zum Lesen oeffnen? Mehr sagt Stufe 0 nicht: es gibt
// kein `stat`, und ein Rateversuch ueber die Groesse waere eine Luege.
fn file_exists(path: u64) -> bool {
    let fd: i64 = syscall(SYS_OEFFNEN, path as i64, O_NUR_LESEN, 0, 0, 0, 0)
    if fd < 0 {
        return false
    }
    syscall(SYS_SCHLIESSEN, fd, 0, 0, 0, 0, 0)
    return true
}

// --------------------------------------------------------------- Zeilen
//
// Ein KURSOR ueber einen bereits gelesenen Block — kein zweiter Puffer, kein
// Kopieren. Jede Zeile kommt als Zeiger+Laenge INNERHALB des Blocks:
//
//     var buf: rt.Buf = rt.buf_neu()
//     io.read_file(pfad, &buf)
//     var z: io.Zeilenleser = io.zeilen_von_buf(&buf)
//     var p: u64 = 0
//     var n: usize = 0
//     while io.zeilen_naechst(&z, &p, &n) { ... }
//
// Der Zeilenvorschub gehoert NICHT zur Zeile; ein vorangehendes \r wird
// mit entfernt (DOS-Zeilenenden). Endet der Block mit \n, gibt es KEINE
// leere Schlusszeile — das ist die Regel, die `wc -l` und jeder Editor
// benutzen.

struct LineReader {
    p: u64,
    n: usize,
    i: usize,
}

fn lines_new(p: u64, n: usize) -> LineReader {
    return LineReader{ p: p, n: n, i: 0 }
}

fn lines_of_buf(b: *mut rt.Buf) -> LineReader {
    return LineReader{ p: rt.buf_ptr(b), n: rt.buf_len(b), i: 0 }
}

fn lines_next(z: *mut LineReader, ap: *mut u64, an: *mut usize) -> bool {
    let end: usize = (*z).n
    var i: usize = (*z).i
    if i >= end {
        return false
    }
    let start: usize = i
    while i < end && rt.ld8((*z).p, i) != 10 as u8 {
        i = i + 1
    }
    var length: usize = i - start
    if length > 0 && rt.ld8((*z).p, start + length - 1) == 13 as u8 {
        length = length - 1
    }
    *ap = (*z).p + start as u64
    *an = length
    if i < end {
        i = i + 1
    }
    (*z).i = i
    return true
}

// Wie viele Zeilen der Block hat (ohne ihn zu verbrauchen).
fn lines_number(p: u64, n: usize) -> usize {
    var z: LineReader = lines_new(p, n)
    var ap: u64 = 0
    var an: usize = 0
    var k: usize = 0
    while lines_next(&z, &ap, &an) {
        k = k + 1
    }
    return k
}

// ------------------------------------------------------ Fmt, ausgebaut
//
// Dieselbe Bauform wie in Runde 39: Wert rein, Wert raus, damit die ganze
// Kette EIN Ausdruck bleibt.

// Ein einzelnes Oktett. Damit wird `{c}` als BUCHSTABE druckbar — mit
// `fmt_zahl` kaeme die Zahl 65 statt "A" heraus.
fn fmt_char(f: Fmt, c: u8) -> Fmt {
    var g: Fmt = f
    rt.buf_push(&g.b, c)
    return g
}

fn fmt_bool(f: Fmt, w: bool) -> Fmt {
    var g: Fmt = f
    var ja: [u8; 4] = "wahr"
    var no: [u8; 6] = "falsch"
    if w {
        rt.buf_push_bytes(&g.b, (&ja[0]) as u64, 4)
    } else {
        rt.buf_push_bytes(&g.b, (&no[0]) as u64, 6)
    }
    return g
}

// Vorzeichenlos — `fmt_zahl` zeigt i64 und braeche oberhalb von i64::MAX um.
fn fmt_u64(f: Fmt, v: u64) -> Fmt {
    var g: Fmt = f
    rt.buf_push_dec_u64(&g.b, v)
    return g
}

// Hexadezimal, mindestens `mindest` Ziffern, ohne "0x".
fn fmt_hex(f: Fmt, v: u64, min: usize) -> Fmt {
    var g: Fmt = f
    rt.buf_push_hex_u64(&g.b, v, min)
    return g
}

// Nullabgeschlossene Folge.
fn fmt_c(f: Fmt, p: u64) -> Fmt {
    var g: Fmt = f
    rt.buf_push_bytes(&g.b, p, rt.c_length(p))
    return g
}

fn fmt_repeat(f: Fmt, c: u8, times: usize) -> Fmt {
    var g: Fmt = f
    var i: usize = 0
    while i < times {
        rt.buf_push(&g.b, c)
        i = i + 1
    }
    return g
}

fn fmt_line(f: Fmt) -> Fmt {
    var g: Fmt = f
    rt.buf_push(&g.b, 10 as u8)
    return g
}

// Rechtsbuendig auf `breite` auffuellen und dann die Zahl — fuer Tabellen.
fn fmt_wide(f: Fmt, v: i64, width: usize, filler: u8) -> Fmt {
    var g: Fmt = f
    var digits: usize = 1
    var x: u64 = v as u64
    if v < 0 {
        digits = 2
        x = (0 - (v + 1)) as u64 + 1
    }
    var rest: u64 = x / 10
    while rest > 0 {
        digits = digits + 1
        rest = rest / 10
    }
    var i: usize = digits
    while i < width {
        rt.buf_push(&g.b, filler)
        i = i + 1
    }
    rt.buf_push_dec_i64(&g.b, v)
    return g
}

// Zwei Builder verbinden: `h` wird angehaengt UND FREIGEGEBEN. So kann eine
// Funktion einen Fmt zurueckgeben, den der Aufrufer weiterbaut.
fn fmt_append(f: Fmt, h: Fmt) -> Fmt {
    var g: Fmt = f
    var q: Fmt = h
    rt.buf_push_bytes(&g.b, rt.buf_ptr(&q.b), rt.buf_len(&q.b))
    rt.buf_free(&q.b)
    return g
}

// Inhalt an einen Puffer ANHAENGEN und den Builder freigeben — der Weg,
// einen `f"..."` nicht zu drucken, sondern weiterzuverarbeiten.
fn fmt_content(f: Fmt, out: *mut rt.Buf) {
    var g: Fmt = f
    rt.buf_push_bytes(out, rt.buf_ptr(&g.b), rt.buf_len(&g.b))
    rt.buf_free(&g.b)
}

fn fmt_print_line(f: Fmt) {
    var g: Fmt = f
    rt.buf_push(&g.b, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&g.b), rt.buf_len(&g.b))
    rt.buf_free(&g.b)
}

// Auf stderr statt stdout — Diagnosen gehoeren nicht in die Ausgabe.
fn fmt_eprint(f: Fmt) {
    var g: Fmt = f
    rt.write_everything(2, rt.buf_ptr(&g.b), rt.buf_len(&g.b))
    rt.buf_free(&g.b)
}

fn fmt_eprint_line(f: Fmt) {
    var g: Fmt = f
    rt.buf_push(&g.b, 10 as u8)
    rt.write_everything(2, rt.buf_ptr(&g.b), rt.buf_len(&g.b))
    rt.buf_free(&g.b)
}

// In eine Datei schreiben (ueberschreibend) und freigeben.
fn fmt_in_file(f: Fmt, path: u64) -> bool {
    var g: Fmt = f
    let ok: bool = rt.write_file(path, rt.buf_ptr(&g.b), rt.buf_len(&g.b))
    rt.buf_free(&g.b)
    return ok
}
