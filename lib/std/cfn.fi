// SPDX-License-Identifier: MPL-2.0
// lib/std/cfn.fi -- std.cfn: call a C function pointer (a plain code address) from Firn.
//
//     import std.cfn
//
//     #[export_c]
//     fn se_apply(cb: u64, x: u64) -> u64 {
//         var r: cfn.Rec = cfn.rec(cb)
//         let f: fn(u64) -> u64 = cfn.as_u1(&r)
//         return f(x)
//     }
//
// WHY: a Firn `fn` value is a pointer to a RECORD whose first word is the code
// address (SPEC 14.5, stage 0: `(*p).f(x)` through a raw pointer is refused).
// A C callback is a bare code address, so it has to be wrapped into such a
// record first. `Rec` is that record; `as_*` views it as a `fn` value of the
// given signature class (every argument and result is one machine word, as
// System V passes them: integers, pointers, bool in rdi/rsi/rdx/rcx).
//
// The record must outlive every call through the `fn` value: keep the `Rec`
// in a local variable of the function that calls, or in host-owned memory.
// A C callback may not be called from a Firn thread that is not the caller's
// (see docs/SHARED-OBJECTS.md, "Threads").

export {
    Rec, rec, as_u0, as_u1, as_u2, as_u3, as_v1, as_v2,
}

// The one-word record: word 0 = code address.
struct Rec {
    code: u64,
}

// One holder per signature class: reading `.f` out of it reinterprets the
// record pointer as a `fn` value without calling anything.
struct HolderU0 { f: fn() -> u64 }
struct HolderU1 { f: fn(u64) -> u64 }
struct HolderU2 { f: fn(u64, u64) -> u64 }
struct HolderU3 { f: fn(u64, u64, u64) -> u64 }
struct HolderV1 { f: fn(u64) }
struct HolderV2 { f: fn(u64, u64) }

// Wraps a C code address.
#[no_gc]
fn rec(addr: u64) -> Rec {
    return Rec { code: addr }
}

#[no_gc]
fn as_u0(r: *mut Rec) -> fn() -> u64 {
    var slot: [u64; 1] = [0; 1]
    slot[0] = r as u64
    let h: *mut HolderU0 = (&slot[0]) as *mut HolderU0
    return (*h).f
}

#[no_gc]
fn as_u1(r: *mut Rec) -> fn(u64) -> u64 {
    var slot: [u64; 1] = [0; 1]
    slot[0] = r as u64
    let h: *mut HolderU1 = (&slot[0]) as *mut HolderU1
    return (*h).f
}

#[no_gc]
fn as_u2(r: *mut Rec) -> fn(u64, u64) -> u64 {
    var slot: [u64; 1] = [0; 1]
    slot[0] = r as u64
    let h: *mut HolderU2 = (&slot[0]) as *mut HolderU2
    return (*h).f
}

#[no_gc]
fn as_u3(r: *mut Rec) -> fn(u64, u64, u64) -> u64 {
    var slot: [u64; 1] = [0; 1]
    slot[0] = r as u64
    let h: *mut HolderU3 = (&slot[0]) as *mut HolderU3
    return (*h).f
}

#[no_gc]
fn as_v1(r: *mut Rec) -> fn(u64) {
    var slot: [u64; 1] = [0; 1]
    slot[0] = r as u64
    let h: *mut HolderV1 = (&slot[0]) as *mut HolderV1
    return (*h).f
}

#[no_gc]
fn as_v2(r: *mut Rec) -> fn(u64, u64) {
    var slot: [u64; 1] = [0; 1]
    slot[0] = r as u64
    let h: *mut HolderV2 = (&slot[0]) as *mut HolderV2
    return (*h).f
}
