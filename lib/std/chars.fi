import std.str
import std.vec

struct CharIter {
    text: str,
    pos: usize,
    cp: u32,
}

fn iter(text: str) -> CharIter {
    return CharIter { text: text, pos: 0, cp: 0 }
}

fn next(it: *mut CharIter) -> bool {
    if (*it).pos >= (*it).text.n {
        return false
    }
    let hit: str.CharHit = str.utf8_read((*it).text, (*it).pos)
    var width: usize = hit.length
    if width == 0 {
        width = 1
    }
    (*it).cp = hit.cp
    (*it).pos = (*it).pos + width
    return true
}

fn count(text: str) -> usize {
    return str.utf8_count(text)
}

fn at(text: str, index: usize) -> u32 {
    var it: CharIter = iter(text)
    var k: usize = 0
    while next(&it) {
        if k == index {
            return it.cp
        }
        k = k + 1
    }
    return 0
}

fn to_str(c: u32) -> str {
    var b: str.Bytes = str.bytes_new()
    str.utf8_push_cp(&b, c)
    let s: str = __str_copy(str { p: b.ptr, n: b.len })
    str.bytes_free(&b)
    return s
}

fn is_digit(c: u32) -> bool {
    return c >= 48 && c <= 57
}

fn is_upper(c: u32) -> bool {
    return c >= 65 && c <= 90
}

fn is_lower(c: u32) -> bool {
    return c >= 97 && c <= 122
}

fn is_alpha(c: u32) -> bool {
    return is_upper(c) || is_lower(c)
}

fn is_space(c: u32) -> bool {
    return c == 32 || (c >= 9 && c <= 13)
}

fn to_upper(c: u32) -> u32 {
    if is_lower(c) {
        return c - 32
    }
    return c
}

fn to_lower(c: u32) -> u32 {
    if is_upper(c) {
        return c + 32
    }
    return c
}

impl u32 {
    fn char_str(*self) -> str { return to_str(*self) }
}

fn collect(text: str) -> Vec[u32] {
    var out: Vec[u32] = vec_new[u32]()
    var it: CharIter = iter(text)
    while next(&it) {
        vec_push[u32](&out, it.cp)
    }
    return out
}
