// SPDX-License-Identifier: MPL-2.0
// lib/std/dynlib.fi -- std.dynlib: load a shared library at run time and call
// into it (Linux twin; the Windows twin is lib/std/dynlib.windows.fi).
//
//     import std.dynlib
//
//     let h: u64 = dynlib.open("libEGL.so.1")        // 0 = not found
//     let f: u64 = dynlib.sym(h, "eglGetDisplay")    // 0 = no such symbol
//     var a: [u64; 16] = [0; 16]
//     let d: u64 = dynlib.callx(f, "i", ...)         // see callx
//
// HOW IT WORKS (docs/FFI.md). A Firn program is a static image with no libc.
// The few `extern fn` below carry `#[link_lib(c)]`: that makes the compiler
// write a dynamically linked ELF (PT_INTERP + DT_NEEDED libc.so.6) for this
// program ONLY; every other program stays byte for byte static. Measured:
// +0.4 ms start (0.23 -> 0.64 ms), 1.3 KB -> 13.9 KB.
//
// Signatures. `callx(f, sig, argv, float_result)`: `sig` has one letter per
// argument -- 'i' integer/pointer (64 bit), 'f' f32, 'd' f64 -- and `argv`
// points at one 64-bit slot per argument (a float lives as its bit pattern:
// `__bits(x) as u64`). System V gives integers 6 registers (the next 6 go onto
// the stack) and floats 8, so more than 12 'i' or 8 'f'/'d' arguments are
// refused (the call returns 0 and is NOT made). Variadic C functions (printf) need `al` set -- not supported.
//
// THREADS. The loaded code runs on glibc's TLS. Call it from the main thread
// (or from threads the foreign library created itself): a thread made by
// Firn's `thread.spawn` has its own `fs` base (the collector's block) and
// glibc/Mesa would read garbage from it.

import rt
import str

export {
    open, sym, close, callx, ci0, ci1, ci2, ci3, ci4, is_supported,
}

#[link_lib(c)]
extern fn dlopen(path: u64, flags: i32) -> u64;
#[link_lib(c)]
extern fn dlsym(h: u64, name: u64) -> u64;
#[link_lib(c)]
extern fn dlclose(h: u64) -> i32;

const RTLD_NOW: i32 = 2

// A dynamic image is possible on this target.
fn is_supported() -> bool {
    return true
}

// `s` as NUL-terminated bytes in `buf` (255 bytes at most). False if too long.
fn cstr(s: str, buf: *mut [u8; 256]) -> bool {
    let n: usize = s.length()
    if n > 255 {
        return false
    }
    var i: usize = 0
    while i < n {
        (*buf)[i] = s.chars(i)
        i = i + 1
    }
    (*buf)[n] = 0 as u8
    return true
}

// Load `name` ("libEGL.so.1", an absolute path, ...). 0 if it cannot be loaded.
fn open(name: str) -> u64 {
    var b: [u8; 256] = [0; 256]
    if !cstr(name, &b) {
        return 0
    }
    return dlopen((&b[0]) as u64, RTLD_NOW)
}

// The address of `name` in library `h` (0 = not found).
fn sym(h: u64, name: str) -> u64 {
    if h == 0 {
        return 0
    }
    var b: [u8; 256] = [0; 256]
    if !cstr(name, &b) {
        return 0
    }
    return dlsym(h, (&b[0]) as u64)
}

fn close(h: u64) -> bool {
    if h == 0 {
        return false
    }
    return dlclose(h) == 0
}

// ---- the call gate: 6 integer + 8 float registers + 6 stack words, System V ----------------
struct HX { f: fn(u64, u64, u64, u64, u64, u64, f64, f64, f64, f64, f64, f64, f64, f64, u64, u64, u64, u64, u64, u64) -> u64 }
struct HXF { f: fn(u64, u64, u64, u64, u64, u64, f64, f64, f64, f64, f64, f64, f64, f64, u64, u64, u64, u64, u64, u64) -> f64 }

// Call `f` with the arguments in `argv` (one u64 slot each) as `sig` says.
// The result is rax, or -- with `float_result` -- the bits of xmm0.
fn callx(f: u64, sig: str, argv: u64, float_result: bool) -> u64 {
    if f == 0 {
        return 0
    }
    var iv: [u64; 12] = [0; 12]
    var fv: [f64; 8] = [0.0; 8]
    var ni: usize = 0
    var nf: usize = 0
    let n: usize = sig.length()
    var k: usize = 0
    while k < n {
        let c: u8 = sig.chars(k)
        let v: u64 = rt.ld64(argv, k)
        if c == 105 as u8 { // 'i'
            if ni >= 12 {
                return 0
            }
            iv[ni] = v
            ni = ni + 1
        } else if c == 102 as u8 || c == 100 as u8 { // 'f' 'd'
            if nf >= 8 {
                return 0
            }
            fv[nf] = __f64_from_bits(v)
            nf = nf + 1
        } else {
            return 0
        }
        k = k + 1
    }
    var set: [u64; 1] = [0; 1]
    set[0] = f
    var value: [u64; 1] = [0; 1]
    value[0] = (&set[0]) as u64
    if float_result {
        let h: *mut HXF = (&value[0]) as *mut HXF
        let g: fn(u64, u64, u64, u64, u64, u64, f64, f64, f64, f64, f64, f64, f64, f64, u64, u64, u64, u64, u64, u64) -> f64 = (*h).f
        return __bits(g(iv[0], iv[1], iv[2], iv[3], iv[4], iv[5],
                fv[0], fv[1], fv[2], fv[3], fv[4], fv[5], fv[6], fv[7],
                iv[6], iv[7], iv[8], iv[9], iv[10], iv[11]))
    }
    let h: *mut HX = (&value[0]) as *mut HX
    let g: fn(u64, u64, u64, u64, u64, u64, f64, f64, f64, f64, f64, f64, f64, f64, u64, u64, u64, u64, u64, u64) -> u64 = (*h).f
    return g(iv[0], iv[1], iv[2], iv[3], iv[4], iv[5],
        fv[0], fv[1], fv[2], fv[3], fv[4], fv[5], fv[6], fv[7],
        iv[6], iv[7], iv[8], iv[9], iv[10], iv[11])
}

// Integer/pointer-only shortcuts: `ci2(f, a, b)` = `f(a, b)` returning rax.
fn ci0(f: u64) -> u64 {
    var a: [u64; 4] = [0; 4]
    return callx(f, "", (&a[0]) as u64, false)
}

fn ci1(f: u64, a0: u64) -> u64 {
    var a: [u64; 4] = [0; 4]
    a[0] = a0
    return callx(f, "i", (&a[0]) as u64, false)
}

fn ci2(f: u64, a0: u64, a1: u64) -> u64 {
    var a: [u64; 4] = [0; 4]
    a[0] = a0
    a[1] = a1
    return callx(f, "ii", (&a[0]) as u64, false)
}

fn ci3(f: u64, a0: u64, a1: u64, a2: u64) -> u64 {
    var a: [u64; 4] = [0; 4]
    a[0] = a0
    a[1] = a1
    a[2] = a2
    return callx(f, "iii", (&a[0]) as u64, false)
}

fn ci4(f: u64, a0: u64, a1: u64, a2: u64, a3: u64) -> u64 {
    var a: [u64; 4] = [0; 4]
    a[0] = a0
    a[1] = a1
    a[2] = a2
    a[3] = a3
    return callx(f, "iiii", (&a[0]) as u64, false)
}
