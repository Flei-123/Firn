import std.str
import std.pystr
import std.vec

struct StrMethods {
    p: *mut u8,
    n: usize,
}

impl StrMethods {
    fn char_count(self) -> usize { return pystr.char_len(self) }
    fn to_upper(self) -> str { return pystr.upper(self) }
    fn to_lower(self) -> str { return pystr.lower(self) }
    fn replace(self, old: str, new: str) -> str { return pystr.replace(self, old, new) }
    fn index_of(self, part: str) -> i64 { return pystr.find(self, part) }
    fn last_index_of(self, part: str) -> i64 { return pystr.rfind(self, part) }
    fn repeat(self, times: usize) -> str { return pystr.repeat(self, times) }
    fn pad_left(self, width: usize, fill: u8 = 32) -> str { return pystr.rjust(self, width, fill) }
    fn pad_right(self, width: usize, fill: u8 = 32) -> str { return pystr.ljust(self, width, fill) }

    fn split(self, sep: str) -> Vec[str] {
        var parts: Vec[str] = vec_new[str]()
        pystr.split(self, sep, &parts)
        return parts
    }

    fn split_whitespace(self) -> Vec[str] {
        var parts: Vec[str] = vec_new[str]()
        pystr.split_ws(self, &parts)
        return parts
    }

    fn join(self, parts: Vec[str]) -> str {
        var copy: Vec[str] = parts
        return pystr.join(&copy, self)
    }

    fn substring(self, start: usize, count: usize) -> str {
        var from: usize = start
        if from > self.n { from = self.n }
        var to: usize = from + count
        if to > self.n { to = self.n }
        unsafe { return str { p: self.p + from, n: to - from } }
    }
}
