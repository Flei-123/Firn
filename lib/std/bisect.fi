// SPDX-License-Identifier: MPL-2.0
// lib/std/bisect.fi -- Python's `bisect` on a sorted `Vec[T]`.
//
//     import std.vec
//     import std.bisect
//
//     bisect_left[i64](&v, 5)              // bisect.bisect_left(v, 5)
//     bisect_right[i64](&v, 5)             // bisect.bisect_right(v, 5)  (= bisect.bisect)
//     bisect_left_range[i64](&v, 5, lo, hi)    // with lo= / hi=
//     insort_left[i64](&v, 5)              // bisect.insort_left(v, 5)
//     insort_right[i64](&v, 5)             // bisect.insort_right(v, 5)  (= insort)
//
//     // any struct: a `less(a, b)` callback on element POINTERS, like vec_sort_by
//     bisect_left_by[Item](&v, probe, by_key)
//     bisect_right_by[Item](&v, probe, by_key)
//     insort_right_by[Item](&v, item, by_key)
//
// `bisect_left` is the first position where the value could be inserted
// (before equal elements, same as std.vec `vec_lower_bound`); `bisect_right`
// is the position after the last equal element (C++ upper_bound). Equal means
// neither is less. The vector must be sorted by the same order. All names
// are bare because they are generic. Cross-checked against CPython in
// tests/4524.
import std.rt
import std.vec

export { bisect_left, bisect_right, bisect_left_range, bisect_right_range,
    insort_left, insort_right, bisect_left_by, bisect_right_by,
    bisect_left_range_by, bisect_right_range_by, insort_left_by, insort_right_by }

fn bisect_left_range[T: Ord](v: *mut Vec[T], x: T, lo0: usize, hi0: usize) -> usize {
    var w: T = x
    var lo: usize = lo0
    var hi: usize = hi0
    if hi > vec_len[T](v) { hi = vec_len[T](v) }
    while lo < hi {
        let m: usize = lo + (hi - lo) / 2
        if vec_elem_ptr[T](v, m).less(&w) {
            lo = m + 1
        } else {
            hi = m
        }
    }
    return lo
}

fn bisect_right_range[T: Ord](v: *mut Vec[T], x: T, lo0: usize, hi0: usize) -> usize {
    var w: T = x
    var lo: usize = lo0
    var hi: usize = hi0
    if hi > vec_len[T](v) { hi = vec_len[T](v) }
    while lo < hi {
        let m: usize = lo + (hi - lo) / 2
        if w.less(vec_elem_ptr[T](v, m)) {
            hi = m
        } else {
            lo = m + 1
        }
    }
    return lo
}

fn bisect_left[T: Ord](v: *mut Vec[T], x: T) -> usize {
    return bisect_left_range[T](v, x, 0, vec_len[T](v))
}

fn bisect_right[T: Ord](v: *mut Vec[T], x: T) -> usize {
    return bisect_right_range[T](v, x, 0, vec_len[T](v))
}

fn insort_left[T: Ord](v: *mut Vec[T], x: T) -> bool {
    return vec_insert[T](v, bisect_left[T](v, x), x)
}

fn insort_right[T: Ord](v: *mut Vec[T], x: T) -> bool {
    return vec_insert[T](v, bisect_right[T](v, x), x)
}

fn bisect_left_range_by[T](v: *mut Vec[T], x: T, less: fn(*T, *T) -> bool, lo0: usize, hi0: usize) -> usize {
    var w: T = x
    var lo: usize = lo0
    var hi: usize = hi0
    if hi > vec_len[T](v) { hi = vec_len[T](v) }
    while lo < hi {
        let m: usize = lo + (hi - lo) / 2
        if less(vec_elem_ptr[T](v, m), &w) {
            lo = m + 1
        } else {
            hi = m
        }
    }
    return lo
}

fn bisect_right_range_by[T](v: *mut Vec[T], x: T, less: fn(*T, *T) -> bool, lo0: usize, hi0: usize) -> usize {
    var w: T = x
    var lo: usize = lo0
    var hi: usize = hi0
    if hi > vec_len[T](v) { hi = vec_len[T](v) }
    while lo < hi {
        let m: usize = lo + (hi - lo) / 2
        if less(&w, vec_elem_ptr[T](v, m)) {
            hi = m
        } else {
            lo = m + 1
        }
    }
    return lo
}

fn bisect_left_by[T](v: *mut Vec[T], x: T, less: fn(*T, *T) -> bool) -> usize {
    return bisect_left_range_by[T](v, x, less, 0, vec_len[T](v))
}

fn bisect_right_by[T](v: *mut Vec[T], x: T, less: fn(*T, *T) -> bool) -> usize {
    return bisect_right_range_by[T](v, x, less, 0, vec_len[T](v))
}

fn insort_left_by[T](v: *mut Vec[T], x: T, less: fn(*T, *T) -> bool) -> bool {
    return vec_insert[T](v, bisect_left_by[T](v, x, less), x)
}

fn insort_right_by[T](v: *mut Vec[T], x: T, less: fn(*T, *T) -> bool) -> bool {
    return vec_insert[T](v, bisect_right_by[T](v, x, less), x)
}
