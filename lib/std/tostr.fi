import std.io

impl i8 {
    fn to_str(*self) -> str { return io.fmt_string(io.fmt_number(io.fmt_new(), (*self) as i64)) }
}

impl i16 {
    fn to_str(*self) -> str { return io.fmt_string(io.fmt_number(io.fmt_new(), (*self) as i64)) }
}

impl i32 {
    fn to_str(*self) -> str { return io.fmt_string(io.fmt_number(io.fmt_new(), (*self) as i64)) }
}

impl i64 {
    fn to_str(*self) -> str { return io.fmt_string(io.fmt_number(io.fmt_new(), (*self) as i64)) }
}

impl isize {
    fn to_str(*self) -> str { return io.fmt_string(io.fmt_number(io.fmt_new(), (*self) as i64)) }
}

impl u8 {
    fn to_str(*self) -> str { return io.fmt_string(io.fmt_u64(io.fmt_new(), (*self) as u64)) }
}

impl u16 {
    fn to_str(*self) -> str { return io.fmt_string(io.fmt_u64(io.fmt_new(), (*self) as u64)) }
}

impl u32 {
    fn to_str(*self) -> str { return io.fmt_string(io.fmt_u64(io.fmt_new(), (*self) as u64)) }
}

impl u64 {
    fn to_str(*self) -> str { return io.fmt_string(io.fmt_u64(io.fmt_new(), (*self) as u64)) }
}

impl usize {
    fn to_str(*self) -> str { return io.fmt_string(io.fmt_u64(io.fmt_new(), (*self) as u64)) }
}

impl f64 {
    fn to_str(*self) -> str { return io.fmt_string(io.fmt_f64(io.fmt_new(), *self)) }
}

impl f32 {
    fn to_str(*self) -> str { return io.fmt_string(io.fmt_f32(io.fmt_new(), *self)) }
}

impl bool {
    fn to_str(*self) -> str { return io.fmt_string(io.fmt_bool(io.fmt_new(), *self)) }
}
