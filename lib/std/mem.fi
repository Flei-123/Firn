// lib/std/mem.fi -- std.mem: the unified memory facade.
//
// Two levels under one roof:
//   * raw:  alloc/free -- mmap without any bookkeeping (lib/rt)
//   * rc:   reference counts on a heap of their own (lib/rc, unchanged)
//
// The GC runtime deliberately needs NO module here: it is pulled in
// automatically as soon as `gc class` appears somewhere (HOOK gc in
// modules.rs, SPEC 3.5) -- an `import std.mem` would be neither needed nor visible.
import rt
import rc

export {
    alloc, free,
    heap_init, heap_free, heap_live, heap_allocations, heap_releases,
}

// --------------------------------------------------------------------- raw
// `n` bytes from the operating system (zero initialized). 0 = failed.
fn alloc(n: usize) -> u64 {
    return rt.heap_alloc(n)
}

// Give raw reserved memory back (address and size as with alloc).
fn free(p: u64, n: usize) {
    rt.heap_free(p, n)
}

// ---------------------------------------------------------------------- rc
// The heap bookkeeping is exposed under short, uniform names.
// The generic rc API itself (rc_new, rc_read, rc_clone, rc_free,
// RefCount[T], ...) needs NO wrapper: generic names hold program wide in
// Firn -- through this module `rc` is loaded and the names are available
// everywhere without anybody having to qualify them. The heap type
// `rc.RcHeap` is named through `import std.rc` (a re-export, lib/rc unchanged).
fn heap_init(h: *mut rc.RcHeap, bytes: usize) -> bool {
    return rc.rc_heap_init(h, bytes)
}

fn heap_free(h: *mut rc.RcHeap) {
    rc.rc_heap_free(h)
}

fn heap_live(h: *mut rc.RcHeap) -> usize {
    return rc.rc_heap_live(h)
}

fn heap_allocations(h: *mut rc.RcHeap) -> usize {
    return rc.rc_heap_allocations(h)
}

fn heap_releases(h: *mut rc.RcHeap) -> usize {
    return rc.rc_heap_releases(h)
}
