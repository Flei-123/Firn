// lib/std/mem.fi — std.mem: die einheitliche Speicher-Fassade.
//
// Zwei Ebenen unter einem Dach:
//   * roh:   alloc/free — mmap ohne Verwaltung (lib/rt)
//   * rc:    Zaehlverweise auf einer eigenen Halde (lib/rc, unveraendert)
//
// Die GC-Laufzeit braucht bewusst KEIN Modul hier: sie wird automatisch
// eingezogen, sobald irgendwo `gc class` steht (HOOK gc in modules.rs,
// SPEC 3.5) — ein `import std.mem` waere dafuer weder noetig noch sichtbar.
import rt
import rc

export {
    alloc, free,
    heap_init, heap_frei, heap_lebende, heap_allokationen, heap_freigaben,
    neu, lesen, klonen, freigeben, stark_zahl,
}

// ---------------------------------------------------------------- roh
// `n` Bytes vom Betriebssystem (nullinitialisiert). 0 = fehlgeschlagen.
fn alloc(n: usize) -> u64 {
    return rt.heap_alloc(n)
}

// Roh blockierten Speicher zurueckgeben (Adresse und Groesse wie bei alloc).
fn free(p: u64, n: usize) {
    rt.heap_free(p, n)
}

// ---------------------------------------------------------------- rc
// Eine Zaehlverweis-Halde mit `bytes` Nutzraum anlegen. true = angelegt.
fn heap_init(h: *mut rc.RcHeap, bytes: usize) -> bool {
    return rc.rc_heap_init(h, bytes)
}

fn heap_frei(h: *mut rc.RcHeap) {
    rc.rc_heap_frei(h)
}

fn heap_lebende(h: *mut rc.RcHeap) -> usize {
    return rc.rc_heap_lebende(h)
}

fn heap_allokationen(h: *mut rc.RcHeap) -> usize {
    return rc.rc_heap_allokationen(h)
}

fn heap_freigaben(h: *mut rc.RcHeap) -> usize {
    return rc.rc_heap_freigaben(h)
}

// `wert` in die Halde legen; der Zaehlverweis landet in `aus`.
// Fehlbar: bei erschoepfter Halde AllocError::OutOfMemory (SPEC, DESIGNZIELE §2).
fn neu[T: Any](h: *mut rc.RcHeap, wert: T, aus: *mut rc.Zaehlverweis[T]) -> AllocError!bool {
    return rc.rc_neu[T](h, wert, aus)
}

fn lesen[T: Any](r: rc.Zaehlverweis[T]) -> T {
    return rc.rc_lesen[T](r)
}

fn klonen[T: Any](r: rc.Zaehlverweis[T]) -> rc.Zaehlverweis[T] {
    return rc.rc_klonen[T](r)
}

fn freigeben[T: Any](h: *mut rc.RcHeap, r: *mut rc.Zaehlverweis[T]) {
    rc.rc_freigeben[T](h, r)
}

fn stark_zahl[T: Any](r: rc.Zaehlverweis[T]) -> u64 {
    return rc.rc_stark_zahl[T](r)
}
