// SPDX-License-Identifier: MPL-2.0
// lib/std/secret.fi -- std.secret: a keyring for tokens and other small
// secrets, keyed by (service, key).
//
//     import std.secret
//     secret.secret_set("fleilauncher", "microsoft-refresh", token) catch |e| ...
//     let t: str = secret.secret_get("fleilauncher", "microsoft-refresh") catch |e| ...
//     secret.secret_delete("fleilauncher", "microsoft-refresh") catch |e| ...
//
// WHERE THE SECRET GOES
//   WINDOWS  the Credential Manager (std.secret_os, secret_os.windows.fi):
//            stored per user, encrypted by the system with the user's logon
//            secret (DPAPI), visible in "Credential Manager" in the Control
//            Panel. Nothing is written by this library.
//   LINUX    an ENCRYPTED FILE, `$XDG_DATA_HOME/firn/secrets.v1` (else
//            `$HOME/.local/share/firn/secrets.v1`), mode 0600, directory
//            0700. ChaCha20-Poly1305 (RFC 8439); the key is HKDF-SHA256 over
//            the machine id (/etc/machine-id) and the user id with a random
//            per-file salt. The Secret Service (GNOME Keyring, KWallet) is
//            D-Bus and out of scope; see S1.
//   EXPLICIT The same file format with a PASSWORD instead of the machine id
//            (Argon2id, 64 MiB / 3 passes by default): `vault_open_password`.
//            This is the only variant that protects against someone who
//            has the file AND runs as the user.
//
// THE FILE FORMAT (version 1), octets:
//   0   "FSECRET1"          magic
//   8   kdf                 1 = machine id, 2 = password (Argon2id)
//   9   0 0 0               reserved
//   12  salt[16]
//   28  m_kib u32 LE        Argon2 memory (0 for kdf 1)
//   32  t u32 LE            Argon2 passes (0 for kdf 1)
//   36  nonce[12]           fresh random on EVERY save
//   48  ciphertext || tag[16]   the 48 header octets are the AAD
// The plaintext is a list of records: service_len u16, key_len u16,
// value_len u32 (all LE), service, key, value.
//
// HONEST -- WHAT IS PROTECTED AND WHAT IS NOT
//   S1 THE LINUX FILE IS NOT A SECRET SERVICE. The machine id is readable
//      by every user of the machine (0444), so the key is NOT secret: what
//      the file protects against is (a) other users and other machines
//      reading a copied or backed-up file, (b) the file leaking WITHOUT the
//      machine (a cloud backup of $HOME, a pasted directory listing, a
//      stolen laptop disk image booted elsewhere), (c) casual grepping. It
//      does NOT protect against a process running as the same user (it can
//      derive the same key), against root, or against malware on the box.
//      For that use the password variant -- or accept what every unencrypted
//      ~/.config/*.json token file also accepts.
//   S2 WINDOWS: anything running as the same user can call CredReadW as
//      well; that is how DPAPI works. It is the same level of protection
//      as every Windows application's saved logins.
//   S3 NOT WIPED FROM MEMORY BY THE GC. Key and plaintext buffers owned
//      here are zeroed before they are freed, but `secret_get` returns a
//      `str` on the garbage collected heap, which Firn cannot wipe; use
//      `secret_get_into` (a buffer you wipe yourself) for long-lived tokens.
//   S4 VALUES up to 64 KiB, names up to 255 octets with no control
//      character; the SERVICE must not contain "/".
//   S5 TWO PROCESSES at once: writers take an advisory lock (flock on
//      "<file>.lock", Linux) and re-read the file inside it, so no update is
//      lost between processes on one machine. On a network file system
//      without flock support the lock is silently absent.
//   S6 THE NUMBER OF ENTRIES is not hidden: the file length grows with
//      the content. Names and values are inside the ciphertext.
//   S7 A VAULT FILE THAT WAS COPIED TO ANOTHER MACHINE (or user) does not
//      open: `WrongKey`. That is the machine binding working; a migration
//      needs the password variant.
//   S8 NO ROLLBACK PROTECTION: an old copy of the file is a valid file.

import std.rt
import std.fs
import std.secret_os
import std.crypto.chacha
import std.crypto.hkdf
import std.crypto.argon2
import std.crypto.random

export {
    SecretError, Vault,
    secret_set, secret_get, secret_delete, secret_set_bytes, secret_get_into,
    secret_backend, secret_default_path,
    vault_open_machine, vault_open_password, vault_open_password_params,
    vault_set, vault_get_into, vault_delete, vault_count, vault_free,
    SECRET_MAX_VALUE,
}

error SecretError {
    NotFound, // no such secret
    Unavailable, // no keyring here (no machine id, no HOME, ...)
    TooLarge, // value over SECRET_MAX_VALUE
    Invalid, // a name that is empty, too long, has a control character, or a service with "/"
    WrongKey, // the file does not open with this key (other machine/user, wrong password)
    Corrupt, // the file is damaged or not a vault
    Denied, // the system refused (permissions, locked)
    Io,
    NoSpace,
}

const SECRET_MAX_VALUE: usize = 65536
const VAULT_MAX_FILE: usize = 4194304
const HDR: usize = 48
const MAGIC: str = "FSECRET1"

// ------------------------------------------------------------ names

fn name_ok(s: str) -> bool {
    if s.length() == 0 || s.length() > 255 {
        return false
    }
    var i: usize = 0
    while i < s.length() {
        if s.chars(i) < 32 as u8 {
            return false
        }
        i = i + 1
    }
    return true
}

fn names_ok(service: str, key: str) -> bool {
    if !name_ok(service) || !name_ok(key) {
        return false
    }
    var i: usize = 0
    while i < service.length() {
        if service.chars(i) == 47 as u8 {
            return false
        }
        i = i + 1
    }
    return true
}

fn os_error(code: u32) -> SecretError {
    if code == 1 as u32 { return SecretError::NotFound }
    if code == 2 as u32 { return SecretError::Unavailable }
    if code == 3 as u32 { return SecretError::TooLarge }
    if code == 5 as u32 { return SecretError::Invalid }
    return SecretError::Denied
}

fn fs_err(e: FsError) -> SecretError {
    if e == FsError::NotFound { return SecretError::NotFound }
    if e == FsError::Permission { return SecretError::Denied }
    if e == FsError::NoSpace { return SecretError::NoSpace }
    return SecretError::Io
}

fn note_fs(e: FsError, why: *mut SecretError, bad: *mut bool) -> usize {
    *why = fs_err(e)
    *bad = true
    return 0
}

fn note_fs_b(e: FsError, why: *mut SecretError, bad: *mut bool) -> bool {
    *why = fs_err(e)
    *bad = true
    return false
}

fn wipe(b: *mut rt.Buf) {
    if rt.buf_len(b) > 0 {
        rt.mem_set(rt.buf_ptr(b), 0 as u8, rt.buf_len(b))
    }
}

// ------------------------------------------------------------ the vault

struct Vault {
    path: str,
    kdf: u32, // 1 machine id, 2 password
    key: [u8; 32],
    salt: [u8; 16],
    m_kib: u32,
    t: u32,
}

fn le32(p: u64, off: usize) -> u32 {
    return rt.ld32(p + off as u64, 0)
}

fn put_le32(p: u64, off: usize, v: u32) {
    rt.st8(p, off, (v & 255 as u32) as u8)
    rt.st8(p, off + 1, ((v >> 8) & 255 as u32) as u8)
    rt.st8(p, off + 2, ((v >> 16) & 255 as u32) as u8)
    rt.st8(p, off + 3, ((v >> 24) & 255 as u32) as u8)
}

fn env_value(name: str, out: *mut rt.Buf) -> bool {
    var env: rt.Buf = rt.buf_new()
    var got: bool = true
    fs.read_file("/proc/self/environ", &env) catch | e | (env_fail(&got))
    var found: bool = false
    if got {
        let n: usize = rt.buf_len(&env)
        let p: u64 = rt.buf_ptr(&env)
        var i: usize = 0
        while i < n && !found {
            var e: usize = i
            while e < n && rt.ld8(p, e) != 0 as u8 {
                e = e + 1
            }
            // entry [i, e)
            if e - i > name.length() && rt.ld8(p, i + name.length()) == 61 as u8 {
                var same: bool = true
                var k: usize = 0
                while k < name.length() {
                    if rt.ld8(p, i + k) != name.chars(k) {
                        same = false
                        break
                    }
                    k = k + 1
                }
                if same {
                    rt.buf_push_bytes(out, p + (i + name.length() + 1) as u64, e - i - name.length() - 1)
                    found = true
                }
            }
            i = e + 1
        }
    }
    wipe(&env)
    rt.buf_free(&env)
    return found && rt.buf_len(out) > 0
}

fn env_fail(got: *mut bool) -> usize {
    *got = false
    return 0
}

// The default place of the Linux vault; see the head of the file. Needs
// /proc/self/environ (Linux): elsewhere it is `Unavailable`.
fn secret_default_path() -> SecretError!str {
    var b: rt.Buf = rt.buf_new()
    var base: str = ""
    var have: bool = false
    if env_value("XDG_DATA_HOME", &b) {
        base = __str_copy(str { p: rt.buf_data(&b), n: rt.buf_len(&b) })
        have = true
    } else {
        rt.buf_clear(&b)
        if env_value("HOME", &b) {
            base = __str_copy(str { p: rt.buf_data(&b), n: rt.buf_len(&b) }) + "/.local/share"
            have = true
        }
    }
    rt.buf_free(&b)
    if !have || base.chars(0) != 47 as u8 {
        return SecretError::Unavailable
    }
    return base + "/firn/secrets.v1"
}

// the machine and user binding of the Linux vault; false = no machine id
fn machine_material(out: *mut rt.Buf) -> bool {
    var id: rt.Buf = rt.buf_new()
    var ok: bool = true
    fs.read_file("/etc/machine-id", &id) catch | e | (env_fail(&ok))
    if !ok || rt.buf_len(&id) < 16 {
        rt.buf_clear(&id)
        ok = true
        fs.read_file("/var/lib/dbus/machine-id", &id) catch | e | (env_fail(&ok))
    }
    if !ok || rt.buf_len(&id) < 16 {
        rt.buf_free(&id)
        return false
    }
    let head: str = "firn-secret-v1|"
    rt.buf_push_bytes(out, head.p as u64, head.length())
    var n: usize = rt.buf_len(&id)
    while n > 0 && (rt.buf_at(&id, n - 1) == 10 as u8 || rt.buf_at(&id, n - 1) == 32 as u8) {
        n = n - 1
    }
    rt.buf_push_bytes(out, rt.buf_ptr(&id), n)
    let uidt: str = "|uid:"
    rt.buf_push_bytes(out, uidt.p as u64, uidt.length())
    rt.buf_push_dec_i64(out, syscall(102, 0, 0, 0, 0, 0, 0)) // getuid
    rt.buf_free(&id)
    return true
}

fn derive_machine(v: *mut Vault) -> bool {
    var ikm: rt.Buf = rt.buf_new()
    if !machine_material(&ikm) {
        rt.buf_free(&ikm)
        return false
    }
    let info: str = "firn std.secret vault key"
    let ok: bool = hkdf.hkdf((&(*v).salt[0]) as u64, 16, rt.buf_ptr(&ikm), rt.buf_len(&ikm),
        info.p as u64, info.length(), (&(*v).key[0]) as u64, 32)
    wipe(&ikm)
    rt.buf_free(&ikm)
    return ok
}

fn derive_password(v: *mut Vault, pw: str) -> bool {
    return argon2.argon2id(pw.p as u64, pw.length(), (&(*v).salt[0]) as u64, 16, 0, 0, 0, 0,
        (*v).t as usize, (*v).m_kib as usize, 1, (&(*v).key[0]) as u64, 32)
}

// Reads and decrypts the file into `plain` (appended). A missing file is an
// empty vault (`missing` = true, nothing appended).
fn load(v: *mut Vault, plain: *mut rt.Buf, missing: *mut bool) -> SecretError!bool {
    var file: rt.Buf = rt.buf_new()
    var bad: bool = false
    var why: SecretError = SecretError::Io
    *missing = false
    fs.read_file((*v).path, &file) catch | e | (note_fs(e, &why, &bad))
    if bad {
        rt.buf_free(&file)
        if why == SecretError::NotFound {
            *missing = true
            return true
        }
        return why
    }
    let n: usize = rt.buf_len(&file)
    let p: u64 = rt.buf_ptr(&file)
    if n < HDR + 16 || n > VAULT_MAX_FILE || !rt.mem_eq(p, MAGIC.p as u64, 8) {
        rt.buf_free(&file)
        return SecretError::Corrupt
    }
    if rt.ld8(p, 8) != (*v).kdf as u8 {
        rt.buf_free(&file)
        return SecretError::WrongKey
    }
    // the salt and the parameters of THIS file are what the key was made with
    if !rt.mem_eq(p + 12, (&(*v).salt[0]) as u64, 16) || le32(p, 28) != (*v).m_kib || le32(p, 32) != (*v).t {
        // Another process created the file after this vault was opened (it
        // chose its own random salt). The machine key is cheap to derive
        // again with the file's salt; a password key is not kept, so the
        // caller has to reopen.
        if (*v).kdf == 1 as u32 && le32(p, 28) == 0 as u32 && le32(p, 32) == 0 as u32 {
            rt.mem_copy((&(*v).salt[0]) as u64, p + 12, 16)
            if !derive_machine(v) {
                rt.buf_free(&file)
                return SecretError::Unavailable
            }
        } else {
            rt.buf_free(&file)
            return SecretError::WrongKey
        }
    }
    let clen: usize = n - HDR
    rt.buf_reserve(plain, rt.buf_len(plain) + clen + 1)
    if (*plain).cap < rt.buf_len(plain) + clen {
        rt.buf_free(&file)
        return SecretError::Io
    }
    let at: usize = rt.buf_len(plain)
    let ok: bool = chacha.aead_open((&(*v).key[0]) as u64, p + 36, p, HDR, p + HDR as u64, clen,
        rt.buf_ptr(plain) + at as u64)
    rt.buf_free(&file)
    if !ok {
        return SecretError::WrongKey
    }
    rt.buf_set_len(plain, at + clen - 16)
    return true
}

// Encrypts `plain` with a fresh nonce and replaces the file atomically
// (mode 0600).
fn save(v: *mut Vault, plain: *mut rt.Buf) -> SecretError!bool {
    let pn: usize = rt.buf_len(plain)
    var out: rt.Buf = rt.buf_new()
    rt.buf_reserve(&out, HDR + pn + 16 + 1)
    if out.cap < HDR + pn + 16 {
        rt.buf_free(&out)
        return SecretError::Io
    }
    var hdr: [u8; 48] = [0; 48]
    let h: u64 = (&hdr[0]) as u64
    rt.mem_copy(h, MAGIC.p as u64, 8)
    rt.st8(h, 8, (*v).kdf as u8)
    rt.mem_copy(h + 12, (&(*v).salt[0]) as u64, 16)
    put_le32(h, 28, (*v).m_kib)
    put_le32(h, 32, (*v).t)
    if !random.random_bytes(h + 36, 12) {
        rt.buf_free(&out)
        return SecretError::Unavailable
    }
    rt.buf_push_bytes(&out, h, HDR)
    rt.buf_set_len(&out, HDR + pn + 16)
    chacha.aead_seal((&(*v).key[0]) as u64, h + 36, h, HDR, rt.buf_ptr(plain), pn, rt.buf_ptr(&out) + HDR as u64)
    // the directory first (`vault_set` has normally made it already)
    var bad: bool = false
    var why: SecretError = SecretError::Io
    ensure_dir((*v).path, &why, &bad)
    if !bad {
        fs.write_atomic_mode((*v).path, rt.buf_ptr(&out), rt.buf_len(&out), 384 as u32) catch | e | (note_fs_b(e, &why, &bad))
    }
    rt.buf_free(&out)
    if bad {
        return why
    }
    return true
}

fn bounds_ok(m_kib: u32, t: u32) -> bool {
    return m_kib >= 8 as u32 && m_kib <= 262144 as u32 && t >= 1 as u32 && t <= 16 as u32
}

// Opens (or starts) the vault at `path`, bound to this machine and user (see
// the head of the file, S1/S7). A file that does not open with this key is
// `WrongKey`.
fn vault_open_machine(path: str) -> SecretError!Vault {
    var v: Vault = Vault { path: path, kdf: 1 as u32, key: [0 as u8; 32], salt: [0 as u8; 16], m_kib: 0 as u32, t: 0 as u32 }
    var file: rt.Buf = rt.buf_new()
    var bad: bool = false
    var why: SecretError = SecretError::Io
    fs.read_file(path, &file) catch | e | (note_fs(e, &why, &bad))
    if bad {
        rt.buf_free(&file)
        if why != SecretError::NotFound {
            return why
        }
        if !random.random_bytes((&v.salt[0]) as u64, 16) {
            return SecretError::Unavailable
        }
    } else {
        if rt.buf_len(&file) < HDR + 16 || !rt.mem_eq(rt.buf_ptr(&file), MAGIC.p as u64, 8) {
            rt.buf_free(&file)
            return SecretError::Corrupt
        }
        rt.mem_copy((&v.salt[0]) as u64, rt.buf_ptr(&file) + 12, 16)
        rt.buf_free(&file)
    }
    if !derive_machine(&v) {
        return SecretError::Unavailable
    }
    // prove the key now (a wrong key should show at open, not at first use)
    var plain: rt.Buf = rt.buf_new()
    var missing: bool = false
    var lbad: bool = false
    var lwhy: SecretError = SecretError::Io
    load(&v, &plain, &missing) catch | e | (note_se(e, &lwhy, &lbad))
    wipe(&plain)
    rt.buf_free(&plain)
    if lbad {
        rt.mem_set((&v.key[0]) as u64, 0 as u8, 32)
        return lwhy
    }
    return v
}

fn note_se(e: SecretError, why: *mut SecretError, bad: *mut bool) -> bool {
    *why = e
    *bad = true
    return false
}

// Like `vault_open_machine`, but the key comes from `password` through
// Argon2id with 64 MiB and 3 passes (about 1.5 s) -- the variant that
// protects against a thief who has the file and the user's session.
fn vault_open_password(path: str, password: str) -> SecretError!Vault {
    return try vault_open_password_params(path, password, 65536 as u32, 3 as u32)
}

// The parameters (memory in KiB 8..262144, passes 1..16) apply to a NEW
// vault; an existing file brings its own, and a hostile file that asks for
// more than the bounds is `Corrupt`.
fn vault_open_password_params(path: str, password: str, m_kib: u32, t: u32) -> SecretError!Vault {
    if password.length() == 0 {
        return SecretError::Invalid
    }
    var v: Vault = Vault { path: path, kdf: 2 as u32, key: [0 as u8; 32], salt: [0 as u8; 16], m_kib: m_kib, t: t }
    var file: rt.Buf = rt.buf_new()
    var bad: bool = false
    var why: SecretError = SecretError::Io
    fs.read_file(path, &file) catch | e | (note_fs(e, &why, &bad))
    if bad {
        rt.buf_free(&file)
        if why != SecretError::NotFound {
            return why
        }
        if !bounds_ok(m_kib, t) {
            return SecretError::Invalid
        }
        if !random.random_bytes((&v.salt[0]) as u64, 16) {
            return SecretError::Unavailable
        }
    } else {
        let p: u64 = rt.buf_ptr(&file)
        if rt.buf_len(&file) < HDR + 16 || !rt.mem_eq(p, MAGIC.p as u64, 8) {
            rt.buf_free(&file)
            return SecretError::Corrupt
        }
        if rt.ld8(p, 8) != 2 as u8 {
            rt.buf_free(&file)
            return SecretError::WrongKey
        }
        v.m_kib = le32(p, 28)
        v.t = le32(p, 32)
        rt.mem_copy((&v.salt[0]) as u64, p + 12, 16)
        rt.buf_free(&file)
        if !bounds_ok(v.m_kib, v.t) {
            return SecretError::Corrupt
        }
    }
    if !derive_password(&v, password) {
        return SecretError::Unavailable
    }
    var plain: rt.Buf = rt.buf_new()
    var missing: bool = false
    var lbad: bool = false
    var lwhy: SecretError = SecretError::Io
    load(&v, &plain, &missing) catch | e | (note_se(e, &lwhy, &lbad))
    wipe(&plain)
    rt.buf_free(&plain)
    if lbad {
        rt.mem_set((&v.key[0]) as u64, 0 as u8, 32)
        return lwhy
    }
    return v
}

// Zeroes the key.
fn vault_free(v: *mut Vault) {
    rt.mem_set((&(*v).key[0]) as u64, 0 as u8, 32)
}

// ------------------------------------------------------------ records

// finds the record (service, key); gives the offset of the record, its
// whole length and the offset/length of the value; false = not there.
// `corrupt` is set if the list does not parse.
fn find_record(plain: *mut rt.Buf, service: str, key: str, off: *mut usize, total: *mut usize,
    voff: *mut usize, vlen: *mut usize, corrupt: *mut bool) -> bool {
    let n: usize = rt.buf_len(plain)
    let p: u64 = rt.buf_ptr(plain)
    var pos: usize = 0
    while pos < n {
        if pos + 8 > n {
            *corrupt = true
            return false
        }
        let sl: usize = (rt.ld8(p, pos) as usize) | ((rt.ld8(p, pos + 1) as usize) << 8)
        let kl: usize = (rt.ld8(p, pos + 2) as usize) | ((rt.ld8(p, pos + 3) as usize) << 8)
        let vl: usize = le32(p, pos + 4) as usize
        if pos + 8 + sl + kl + vl > n {
            *corrupt = true
            return false
        }
        if sl == service.length() && kl == key.length()
            && rt.mem_eq(p + (pos + 8) as u64, service.p as u64, sl)
            && rt.mem_eq(p + (pos + 8 + sl) as u64, key.p as u64, kl) {
            *off = pos
            *total = 8 + sl + kl + vl
            *voff = pos + 8 + sl + kl
            *vlen = vl
            return true
        }
        pos = pos + 8 + sl + kl + vl
    }
    return false
}

// the number of records (-1 if the list does not parse)
fn count_records(plain: *mut rt.Buf) -> i64 {
    let n: usize = rt.buf_len(plain)
    let p: u64 = rt.buf_ptr(plain)
    var pos: usize = 0
    var c: i64 = 0
    while pos < n {
        if pos + 8 > n {
            return -1
        }
        let sl: usize = (rt.ld8(p, pos) as usize) | ((rt.ld8(p, pos + 1) as usize) << 8)
        let kl: usize = (rt.ld8(p, pos + 2) as usize) | ((rt.ld8(p, pos + 3) as usize) << 8)
        let vl: usize = le32(p, pos + 4) as usize
        if pos + 8 + sl + kl + vl > n {
            return -1
        }
        pos = pos + 8 + sl + kl + vl
        c = c + 1
    }
    return c
}

// Makes the directory of the vault file (mode 0700 for the one that is
// created); false = it could not be made.
fn ensure_dir(path: str, why: *mut SecretError, bad: *mut bool) -> bool {
    let parent: str = fs.path_parent(path)
    if parent.length() > 0 && !fs.is_dir(parent) {
        fs.mkdir_all(parent) catch | e | (note_fs_b(e, why, bad))
        if !*bad {
            fs.chmod(parent, 448 as u32) catch false
        }
    }
    return !*bad
}

// ------------------------------------------------------------ the lock

// Takes the advisory lock "<file>.lock" (flock, Linux); -1 if there is none
// (then the update goes ahead without it, see S5).
fn lock_take(path: str) -> i64 {
    let lp: str = path + ".lock"
    fs.write_file_mode(lp, 0, 0, 384 as u32, false) catch 0
    let fd: i64 = fs.open_read(lp) catch -1
    if fd < 0 {
        return -1
    }
    let r: i64 = syscall(73, fd, 2, 0, 0, 0, 0) // flock(fd, LOCK_EX)
    if r < 0 {
        fs.close_fd(fd)
        return -1
    }
    return fd
}

fn lock_drop(fd: i64) {
    if fd >= 0 {
        fs.close_fd(fd) // closing releases the flock
    }
}

// ------------------------------------------------------------ vault operations

// Stores `n` octets at `p` under (service, key), replacing an earlier value.
fn vault_set(v: *mut Vault, service: str, key: str, p: u64, n: usize) -> SecretError!bool {
    if !names_ok(service, key) {
        return SecretError::Invalid
    }
    if n > SECRET_MAX_VALUE {
        return SecretError::TooLarge
    }
    var bad: bool = false
    var why: SecretError = SecretError::Io
    ensure_dir((*v).path, &why, &bad)
    if bad {
        return why
    }
    let lock: i64 = lock_take((*v).path)
    var plain: rt.Buf = rt.buf_new()
    var missing: bool = false
    load(v, &plain, &missing) catch | e | (note_se(e, &why, &bad))
    if !bad {
        var off: usize = 0
        var total: usize = 0
        var vo: usize = 0
        var vl: usize = 0
        var corrupt: bool = false
        var next: rt.Buf = rt.buf_new()
        rt.buf_reserve(&next, rt.buf_len(&plain) + 8 + service.length() + key.length() + n + 1)
        if find_record(&plain, service, key, &off, &total, &vo, &vl, &corrupt) {
            rt.buf_push_bytes(&next, rt.buf_ptr(&plain), off)
            rt.buf_push_bytes(&next, rt.buf_ptr(&plain) + (off + total) as u64, rt.buf_len(&plain) - off - total)
        } else if corrupt {
            bad = true
            why = SecretError::Corrupt
        } else {
            rt.buf_push_bytes(&next, rt.buf_ptr(&plain), rt.buf_len(&plain))
        }
        if !bad {
            rt.buf_push(&next, (service.length() & 255) as u8)
            rt.buf_push(&next, (service.length() >> 8) as u8)
            rt.buf_push(&next, (key.length() & 255) as u8)
            rt.buf_push(&next, (key.length() >> 8) as u8)
            rt.buf_push(&next, (n & 255) as u8)
            rt.buf_push(&next, ((n >> 8) & 255) as u8)
            rt.buf_push(&next, ((n >> 16) & 255) as u8)
            rt.buf_push(&next, ((n >> 24) & 255) as u8)
            rt.buf_push_bytes(&next, service.p as u64, service.length())
            rt.buf_push_bytes(&next, key.p as u64, key.length())
            rt.buf_push_bytes(&next, p, n)
            if next.cap < rt.buf_len(&next) {
                bad = true
                why = SecretError::Io
            } else {
                save(v, &next) catch | e | (note_se(e, &why, &bad))
            }
        }
        wipe(&next)
        rt.buf_free(&next)
    }
    wipe(&plain)
    rt.buf_free(&plain)
    lock_drop(lock)
    if bad {
        return why
    }
    return true
}

// Appends the value of (service, key) to `out`; the answer is its length.
// `NotFound` if there is none.
fn vault_get_into(v: *mut Vault, service: str, key: str, out: *mut rt.Buf) -> SecretError!usize {
    if !names_ok(service, key) {
        return SecretError::Invalid
    }
    var plain: rt.Buf = rt.buf_new()
    var missing: bool = false
    var bad: bool = false
    var why: SecretError = SecretError::Io
    load(v, &plain, &missing) catch | e | (note_se(e, &why, &bad))
    var got: usize = 0
    if !bad {
        var off: usize = 0
        var total: usize = 0
        var vo: usize = 0
        var vl: usize = 0
        var corrupt: bool = false
        if find_record(&plain, service, key, &off, &total, &vo, &vl, &corrupt) {
            rt.buf_reserve(out, (*out).len + vl + 1)
            if (*out).cap < (*out).len + vl {
                bad = true
                why = SecretError::Io
            } else {
                rt.buf_push_bytes(out, rt.buf_ptr(&plain) + vo as u64, vl)
                got = vl
            }
        } else {
            bad = true
            why = SecretError::NotFound
            if corrupt {
                why = SecretError::Corrupt
            }
        }
    }
    wipe(&plain)
    rt.buf_free(&plain)
    if bad {
        return why
    }
    return got
}

// Removes (service, key). true = it was there and is gone; false = there was
// nothing to remove (not an error: deleting is idempotent).
fn vault_delete(v: *mut Vault, service: str, key: str) -> SecretError!bool {
    if !names_ok(service, key) {
        return SecretError::Invalid
    }
    let lock: i64 = lock_take((*v).path)
    var plain: rt.Buf = rt.buf_new()
    var missing: bool = false
    var bad: bool = false
    var why: SecretError = SecretError::Io
    var removed: bool = false
    load(v, &plain, &missing) catch | e | (note_se(e, &why, &bad))
    if !bad && !missing {
        var off: usize = 0
        var total: usize = 0
        var vo: usize = 0
        var vl: usize = 0
        var corrupt: bool = false
        if find_record(&plain, service, key, &off, &total, &vo, &vl, &corrupt) {
            var next: rt.Buf = rt.buf_new()
            rt.buf_reserve(&next, rt.buf_len(&plain) + 1)
            rt.buf_push_bytes(&next, rt.buf_ptr(&plain), off)
            rt.buf_push_bytes(&next, rt.buf_ptr(&plain) + (off + total) as u64, rt.buf_len(&plain) - off - total)
            save(v, &next) catch | e | (note_se(e, &why, &bad))
            wipe(&next)
            rt.buf_free(&next)
            removed = !bad
        } else if corrupt {
            bad = true
            why = SecretError::Corrupt
        }
    }
    wipe(&plain)
    rt.buf_free(&plain)
    lock_drop(lock)
    if bad {
        return why
    }
    return removed
}

// The number of secrets in the vault.
fn vault_count(v: *mut Vault) -> SecretError!usize {
    var plain: rt.Buf = rt.buf_new()
    var missing: bool = false
    var bad: bool = false
    var why: SecretError = SecretError::Io
    load(v, &plain, &missing) catch | e | (note_se(e, &why, &bad))
    var c: i64 = 0
    if !bad {
        c = count_records(&plain)
        if c < 0 {
            bad = true
            why = SecretError::Corrupt
        }
    }
    wipe(&plain)
    rt.buf_free(&plain)
    if bad {
        return why
    }
    return c as usize
}

// ------------------------------------------------------------ the simple API

// "wincred" where the system has a keyring this library uses, "file" for
// the encrypted file.
fn secret_backend() -> str {
    if secret_os.os_name() == "none" {
        return "file"
    }
    return secret_os.os_name()
}

fn open_default() -> SecretError!Vault {
    let path: str = try secret_default_path()
    return try vault_open_machine(path)
}

fn note_v(e: SecretError, why: *mut SecretError, bad: *mut bool) -> Vault {
    *why = e
    *bad = true
    return Vault { path: "", kdf: 0 as u32, key: [0 as u8; 32], salt: [0 as u8; 16], m_kib: 0 as u32, t: 0 as u32 }
}

// Stores a secret (replacing an earlier one).
fn secret_set_bytes(service: str, key: str, p: u64, n: usize) -> SecretError!bool {
    if !names_ok(service, key) {
        return SecretError::Invalid
    }
    if n > SECRET_MAX_VALUE {
        return SecretError::TooLarge
    }
    let c: u32 = secret_os.os_set(service, key, p, n)
    if c == 0 as u32 {
        return true
    }
    if c != 2 as u32 {
        return os_error(c)
    }
    var bad: bool = false
    var why: SecretError = SecretError::Io
    var v: Vault = open_default() catch | e | (note_v(e, &why, &bad))
    if bad {
        return why
    }
    vault_set(&v, service, key, p, n) catch | e2 | (note_se(e2, &why, &bad))
    vault_free(&v)
    if bad {
        return why
    }
    return true
}

fn secret_set(service: str, key: str, value: str) -> SecretError!bool {
    return try secret_set_bytes(service, key, value.p as u64, value.length())
}

// Appends the secret to `out` (a buffer the caller wipes); the answer is its
// length; `NotFound` if there is none.
fn secret_get_into(service: str, key: str, out: *mut rt.Buf) -> SecretError!usize {
    if !names_ok(service, key) {
        return SecretError::Invalid
    }
    let before: usize = (*out).len
    let c: u32 = secret_os.os_get(service, key, out)
    if c == 0 as u32 {
        return (*out).len - before
    }
    if c != 2 as u32 {
        return os_error(c)
    }
    var bad: bool = false
    var why: SecretError = SecretError::Io
    var v: Vault = open_default() catch | e | (note_v(e, &why, &bad))
    if bad {
        return why
    }
    let n: usize = vault_get_into(&v, service, key, out) catch | e2 | (note_n(e2, &why, &bad))
    vault_free(&v)
    if bad {
        return why
    }
    return n
}

fn note_n(e: SecretError, why: *mut SecretError, bad: *mut bool) -> usize {
    *why = e
    *bad = true
    return 0
}

// The secret as a string (copied to the garbage collected heap -- see S3).
fn secret_get(service: str, key: str) -> SecretError!str {
    var b: rt.Buf = rt.buf_new()
    var bad: bool = false
    var why: SecretError = SecretError::Io
    secret_get_into(service, key, &b) catch | e | (note_n(e, &why, &bad))
    var s: str = ""
    if !bad {
        s = __str_copy(str { p: rt.buf_data(&b), n: rt.buf_len(&b) })
    }
    wipe(&b)
    rt.buf_free(&b)
    if bad {
        return why
    }
    return s
}

// Removes a secret. true = removed; false = there was none (not an error).
fn secret_delete(service: str, key: str) -> SecretError!bool {
    if !names_ok(service, key) {
        return SecretError::Invalid
    }
    let c: u32 = secret_os.os_delete(service, key)
    if c == 0 as u32 {
        return true
    }
    if c == 1 as u32 {
        return false
    }
    if c != 2 as u32 {
        return os_error(c)
    }
    var bad: bool = false
    var why: SecretError = SecretError::Io
    var v: Vault = open_default() catch | e | (note_v(e, &why, &bad))
    if bad {
        // no file, no machine id... nothing there to delete
        if why == SecretError::NotFound {
            return false
        }
        return why
    }
    let r: bool = vault_delete(&v, service, key) catch | e2 | (note_b(e2, &why, &bad))
    vault_free(&v)
    if bad {
        return why
    }
    return r
}

fn note_b(e: SecretError, why: *mut SecretError, bad: *mut bool) -> bool {
    *why = e
    *bad = true
    return false
}
