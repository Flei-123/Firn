// SPDX-License-Identifier: MPL-2.0
// lib/std/crypto/keyident.fi -- domain separated Ed25519 signatures and the identity bundle of the Orbit key hierarchy (docs/ORBIT-KEYS-SPEC.md sections 5, 7, 11).
import std.rt
import std.crypto.ed25519
import std.crypto.keyaad

export { BUNDLE_LEN, ki_sign, ki_verify, ki_bundle, ki_bundle_sign, ki_bundle_verify,
    ki_rotation_sign, ki_rotation_verify }

const BUNDLE_LEN: usize = 69
const SIG_TAG: str = "ORBIT-SIG1"
const CTX_IDENTITY: str = "identity"
const CTX_ROTATION: str = "rotation"
const MSG_MAX: usize = 4096

fn signed_message(ctx: u64, ctxn: usize, msg: u64, mn: usize, out: *mut rt.Buf) -> bool {
    if ctxn > 255 || mn > MSG_MAX {
        return false
    }
    var head: [u8; 272] = [0; 272]
    var at: usize = keyaad.aad_tag((&head[0]) as u64, 0, SIG_TAG)
    at = keyaad.aad_lp8((&head[0]) as u64, at, ctx, ctxn)
    rt.buf_push_bytes(out, (&head[0]) as u64, at)
    rt.buf_push_bytes(out, msg, mn)
    return true
}

fn ki_sign(c: *mut ed25519.Ctx, seed: u64, ctx: u64, ctxn: usize, msg: u64, mn: usize,
    sig: u64) -> bool {
    var b: rt.Buf = rt.buf_new()
    defer rt.buf_free(&b)
    if !signed_message(ctx, ctxn, msg, mn, &b) {
        return false
    }
    return ed25519.ed25519_sign(c, seed, rt.buf_ptr(&b), rt.buf_len(&b), sig)
}

fn ki_verify(c: *mut ed25519.Ctx, pub_key: u64, ctx: u64, ctxn: usize, msg: u64, mn: usize,
    sig: u64) -> bool {
    var b: rt.Buf = rt.buf_new()
    defer rt.buf_free(&b)
    if !signed_message(ctx, ctxn, msg, mn, &b) {
        return false
    }
    return ed25519.ed25519_verify(c, pub_key, rt.buf_ptr(&b), rt.buf_len(&b), sig)
}

fn ki_bundle(x_pub: u64, s_pub: u64, created: u64, out: u64) {
    var at: usize = keyaad.aad_u8(out, 0, 1)
    at = keyaad.aad_raw(out, at, x_pub, 32)
    at = keyaad.aad_raw(out, at, s_pub, 32)
    keyaad.aad_u32(out, at, created)
}

fn bundle_msg(acct: u64, acctn: usize, bundle: u64, out: u64) -> usize {
    let at: usize = keyaad.aad_lp8(out, 0, acct, acctn)
    return keyaad.aad_raw(out, at, bundle, BUNDLE_LEN)
}

fn ki_bundle_sign(c: *mut ed25519.Ctx, s_seed: u64, acct: u64, acctn: usize, bundle: u64,
    sig: u64) -> bool {
    if acctn < 1 || acctn > 64 {
        return false
    }
    var m: [u8; 160] = [0; 160]
    let mn: usize = bundle_msg(acct, acctn, bundle, (&m[0]) as u64)
    return ki_sign(c, s_seed, CTX_IDENTITY.p as u64, CTX_IDENTITY.n, (&m[0]) as u64, mn, sig)
}

fn ki_bundle_verify(c: *mut ed25519.Ctx, acct: u64, acctn: usize, bundle: u64, sig: u64) -> bool {
    if acctn < 1 || acctn > 64 || rt.ld8(bundle, 0) != 1 as u8 {
        return false
    }
    var m: [u8; 160] = [0; 160]
    let mn: usize = bundle_msg(acct, acctn, bundle, (&m[0]) as u64)
    return ki_verify(c, bundle + 33 as u64, CTX_IDENTITY.p as u64, CTX_IDENTITY.n,
        (&m[0]) as u64, mn, sig)
}

fn rotation_msg(acct: u64, acctn: usize, old_pub: u64, new_pub: u64, out: u64) -> usize {
    var at: usize = keyaad.aad_lp8(out, 0, acct, acctn)
    at = keyaad.aad_raw(out, at, old_pub, 32)
    return keyaad.aad_raw(out, at, new_pub, 32)
}

fn ki_rotation_sign(c: *mut ed25519.Ctx, seed: u64, acct: u64, acctn: usize, old_pub: u64,
    new_pub: u64, sig: u64) -> bool {
    if acctn < 1 || acctn > 64 {
        return false
    }
    var m: [u8; 160] = [0; 160]
    let mn: usize = rotation_msg(acct, acctn, old_pub, new_pub, (&m[0]) as u64)
    return ki_sign(c, seed, CTX_ROTATION.p as u64, CTX_ROTATION.n, (&m[0]) as u64, mn, sig)
}

fn ki_rotation_verify(c: *mut ed25519.Ctx, pub_key: u64, acct: u64, acctn: usize,
    old_pub: u64, new_pub: u64, sig: u64) -> bool {
    if acctn < 1 || acctn > 64 {
        return false
    }
    var m: [u8; 160] = [0; 160]
    let mn: usize = rotation_msg(acct, acctn, old_pub, new_pub, (&m[0]) as u64)
    return ki_verify(c, pub_key, CTX_ROTATION.p as u64, CTX_ROTATION.n, (&m[0]) as u64, mn, sig)
}
