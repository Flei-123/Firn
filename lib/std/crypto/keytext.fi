// SPDX-License-Identifier: MPL-2.0
// lib/std/crypto/keytext.fi -- Base32 text forms of the Orbit key hierarchy: recovery key and fingerprints (docs/ORBIT-KEYS-SPEC.md sections 6.3 and 7).
import std.rt
import std.crypto.sha256

export {
    RK_TEXT_LEN, FP_TEXT_LEN, kt_b32_encode, kt_b32_decode, kt_rk_encode, kt_rk_decode,
    kt_fingerprint,
}

const RK_TEXT_LEN: usize = 69
const FP_TEXT_LEN: usize = 19
const ALPHABET: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
const RK_CHECK_TAG: str = "ORBIT-RK-CHECK1"
const FP_TAG: str = "ORBIT-FP1"

fn kt_b32_encode(p: u64, n: usize, out: u64) -> usize {
    var acc: u64 = 0
    var bits: usize = 0
    var o: usize = 0
    var i: usize = 0
    while i < n {
        acc = (acc << 8) | (rt.ld8(p, i) as u64)
        bits = bits + 8
        while bits >= 5 {
            let v: u64 = (acc >> ((bits - 5) as u64)) & 31
            rt.st8(out, o, rt.ld8(ALPHABET.p as u64, v as usize))
            o = o + 1
            bits = bits - 5
        }
        acc = acc & ((1 << (bits as u64)) - 1)
        i = i + 1
    }
    if bits > 0 {
        let v: u64 = (acc << ((5 - bits) as u64)) & 31
        rt.st8(out, o, rt.ld8(ALPHABET.p as u64, v as usize))
        o = o + 1
    }
    return o
}

fn symbol_value(c: u8) -> i64 {
    var u: u8 = c
    if u >= 97 as u8 && u <= 122 as u8 {
        u = u - 32 as u8
    }
    if u >= 65 as u8 && u <= 90 as u8 {
        return (u - 65 as u8) as i64
    }
    if u >= 50 as u8 && u <= 55 as u8 {
        return ((u - 50 as u8) as i64) + 26
    }
    return -1
}

fn kt_b32_decode(p: u64, n: usize, out: u64, cap: usize) -> i64 {
    var acc: u64 = 0
    var bits: usize = 0
    var o: usize = 0
    var i: usize = 0
    while i < n {
        let v: i64 = symbol_value(rt.ld8(p, i))
        if v < 0 {
            return -1
        }
        acc = (acc << 5) | (v as u64)
        bits = bits + 5
        if bits >= 8 {
            if o >= cap {
                return -1
            }
            rt.st8(out, o, ((acc >> ((bits - 8) as u64)) & 255) as u8)
            o = o + 1
            bits = bits - 8
            acc = acc & ((1 << (bits as u64)) - 1)
        }
        i = i + 1
    }
    if acc != 0 {
        return -1
    }
    return o as i64
}

fn group4(raw: u64, n: usize, out: u64) -> usize {
    var o: usize = 0
    var i: usize = 0
    while i < n {
        if i > 0 && i % 4 == 0 {
            rt.st8(out, o, 45 as u8)
            o = o + 1
        }
        rt.st8(out, o, rt.ld8(raw, i))
        o = o + 1
        i = i + 1
    }
    return o
}

fn rk_check(rk: u64, out: u64) {
    var s: sha256.Sha256 = sha256.sha256_new()
    sha256.sha256_update(&s, RK_CHECK_TAG.p as u64, RK_CHECK_TAG.n)
    sha256.sha256_update(&s, rk, 32)
    var d: [u8; 32] = [0; 32]
    sha256.sha256_final(&s, (&d[0]) as u64)
    rt.mem_copy(out, (&d[0]) as u64, 3)
}

fn kt_rk_encode(rk: u64, out: u64) -> usize {
    var raw: [u8; 35] = [0; 35]
    rt.mem_copy((&raw[0]) as u64, rk, 32)
    rk_check(rk, (&raw[32]) as u64)
    var txt: [u8; 64] = [0; 64]
    let n: usize = kt_b32_encode((&raw[0]) as u64, 35, (&txt[0]) as u64)
    return group4((&txt[0]) as u64, n, out)
}

fn kt_rk_decode(text: u64, n: usize, rk_out: u64) -> bool {
    var clean: [u8; 64] = [0; 64]
    var cn: usize = 0
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(text, i)
        if c != 45 as u8 && c != 32 as u8 {
            if cn >= 64 {
                return false
            }
            clean[cn] = c
            cn = cn + 1
        }
        i = i + 1
    }
    if cn != 56 {
        return false
    }
    var raw: [u8; 40] = [0; 40]
    if kt_b32_decode((&clean[0]) as u64, cn, (&raw[0]) as u64, 40) != 35 {
        return false
    }
    var want: [u8; 3] = [0; 3]
    rk_check((&raw[0]) as u64, (&want[0]) as u64)
    if !rt.mem_eq((&want[0]) as u64, (&raw[32]) as u64, 3) {
        return false
    }
    rt.mem_copy(rk_out, (&raw[0]) as u64, 32)
    return true
}

fn kt_fingerprint(data: u64, n: usize, out: u64) -> usize {
    var s: sha256.Sha256 = sha256.sha256_new()
    sha256.sha256_update(&s, FP_TAG.p as u64, FP_TAG.n)
    sha256.sha256_update(&s, data, n)
    var d: [u8; 32] = [0; 32]
    sha256.sha256_final(&s, (&d[0]) as u64)
    var txt: [u8; 16] = [0; 16]
    let tn: usize = kt_b32_encode((&d[0]) as u64, 10, (&txt[0]) as u64)
    return group4((&txt[0]) as u64, tn, out)
}
