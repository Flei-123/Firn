// SPDX-License-Identifier: MIT
// lib/std/crypto/aes.fi -- AES-128 with CBC and CFB8 (round 81).
//
// AES is the block cipher everything else is built on, and it is here for
// one concrete reason: the ONLINE MODE OF MINECRAFT. After the handshake
// the client and the server share a 16 octet secret, and from that moment
// on EVERY octet of the connection travels through
// `AES/CFB8/NoPadding` with key = IV = that secret. A server that cannot do
// CFB8 can authenticate a player and then not read one further packet.
// CBC comes with it because it is the mode every other protocol uses and
// because it exercises the DECRYPTION direction of the cipher, which CFB8
// never touches (see below).
//
// ================================================================ THE CIPHER
//
// AES-128: ten rounds over a 4x4 matrix of octets, each round SubBytes
// (a substitution), ShiftRows (a permutation), MixColumns (a matrix
// multiplication in GF(2^8)) and AddRoundKey (an xor with the key
// schedule). The last round has no MixColumns -- that is not an
// optimisation, it is what makes decryption symmetric.
//
// THE S-BOX IS NOT TRANSCRIBED BY HAND. It is the multiplicative inverse in
// GF(2^8) followed by an affine map, and the 256 numbers below were
// COMPUTED (the generator is in the commit that added this file) rather
// than copied from a table -- a single wrong digit in an S-box produces a
// cipher that encrypts and decrypts consistently with itself and agrees
// with nobody. The INVERSE S-box is not written down at all: it is built at
// run time as `inv[sbox[i]] = i`, which cannot disagree with the forward
// one.
//
// ================================================================== THE MODES
//
// CBC (SP 800-38A 6.2): every block is xor'ed with the previous ciphertext
// block before it is encrypted. Needs the decryption direction, needs the
// length to be a multiple of 16, and NEEDS A DIFFERENT IV PER MESSAGE --
// the IV is not a key, but reusing it leaks whether two messages start the
// same way.
//
// CFB8 (SP 800-38A 6.3, s = 8): a STREAM mode. Per OCTET the current 16
// octet shift register is encrypted, the topmost octet of the result is
// xor'ed onto the plaintext octet, and the register is shifted left by one
// octet with the CIPHERTEXT octet appended. So it costs ONE FULL AES
// ENCRYPTION PER OCTET -- sixteen times the work of CBC, which is why
// Minecraft's encrypted connections cost what they cost. Note that both
// directions use `aes_encrypt_block` only; the inverse cipher never appears.
//
// ==================================================================== HONEST
//
// A1 128 BIT KEYS ONLY. The key schedule for 192 and 256 differs in more
//    than a loop bound (the extra SubWord at Nk 8), and an untested key
//    length is worse than a missing one. The NIST vectors in
//    `testdata/crypto/` are the 128 bit sets.
// A2 NO PADDING. `aes_cbc_encrypt` demands a multiple of 16 and says so by
//    returning false. PKCS#7 is a protocol decision, not a cipher one --
//    and a padding oracle is one of the classic ways to lose a key.
// A3 NOT CONSTANT TIME. This implementation uses S-BOX LOOKUPS, and a table
//    lookup indexed by secret data leaks through the cache. SPEC 9 promises
//    `secret` types and `#[constant_time]` for exactly this problem and
//    stage 0 does not implement them for tables. For Minecraft's session
//    encryption (the attacker is not on this machine) that is acceptable;
//    for a key that has to survive a co-tenant on a shared server it is
//    not, and this note is here so that nobody finds that out later.
// A4 NO GCM, NO AUTHENTICATION. CBC and CFB8 are confidentiality only. A
//    message that must not be MODIFIED needs a MAC on top --
//    `std.crypto.hmac` is right here, and encrypt-then-MAC is the order.
// ================================================================= ROUND 82
//
// A5 THE SECOND PATH. On a processor with AES-NI the round becomes ONE
//    instruction (`aesenc`), and `lib/std/crypto/accel.fi` runs instead of
//    everything below. The decision is made ONCE, in `aes128_new`, by asking
//    `cpuid`; the same binary keeps working on a machine without AES-NI,
//    over the code in this file.
//
//    NOTE ON A3: the hardware path is CONSTANT TIME by construction. `aesenc`
//    has no data dependent timing and touches no table, so the cache leak of
//    the S-box implementation is simply not there. On this machine the
//    concern of A3 therefore does not apply -- it applies on a processor
//    without AES-NI, and there it applies exactly as written.
//
//    Every `*_soft` function is the scalar one under its own name.
//    `tools/bench82/run.sh` sends the same 1,919 NIST vectors through both
//    and demands the same answer.
import std.rt
import std.crypto.accel

export { Aes, aes128_new, aes128_new_soft,
    aes_encrypt_block, aes_decrypt_block, aes_encrypt_block_soft,
    aes_cbc_encrypt, aes_cbc_decrypt, aes_cfb8_encrypt, aes_cfb8_decrypt,
    aes_cbc_encrypt_soft, aes_cbc_decrypt_soft,
    aes_cfb8_encrypt_soft, aes_cfb8_decrypt_soft,
    AES_BLOCK }

const AES_BLOCK: usize = 16

struct Aes {
    rk: [u8; 176], // 11 round keys of 16 octets
    sbox: [u8; 256],
    isbox: [u8; 256],
    // The multiplication tables of MixColumns/InvMixColumns. MEASURED, not
    // guessed: with `gmul` called per octet AES-CBC ran at 0.84 MiB/s and
    // CFB8 (one full block encryption PER OCTET) at 0.04 MiB/s, which is
    // slower than a Minecraft connection needs. Six tables of 256 octets
    // turn the inner loop into six lookups and an xor.
    m2: [u8; 256],
    m3: [u8; 256],
    m9: [u8; 256],
    m11: [u8; 256],
    m13: [u8; 256],
    m14: [u8; 256],
    // ROUND 82: has this processor AES-NI, and may it be used?
    ni: bool,
}

fn sbox_table() -> [u8; 256] {
    var s: [u8; 256] = [
        99, 124, 119, 123, 242, 107, 111, 197, 48, 1, 103, 43,
        254, 215, 171, 118, 202, 130, 201, 125, 250, 89, 71, 240,
        173, 212, 162, 175, 156, 164, 114, 192, 183, 253, 147, 38,
        54, 63, 247, 204, 52, 165, 229, 241, 113, 216, 49, 21,
        4, 199, 35, 195, 24, 150, 5, 154, 7, 18, 128, 226,
        235, 39, 178, 117, 9, 131, 44, 26, 27, 110, 90, 160,
        82, 59, 214, 179, 41, 227, 47, 132, 83, 209, 0, 237,
        32, 252, 177, 91, 106, 203, 190, 57, 74, 76, 88, 207,
        208, 239, 170, 251, 67, 77, 51, 133, 69, 249, 2, 127,
        80, 60, 159, 168, 81, 163, 64, 143, 146, 157, 56, 245,
        188, 182, 218, 33, 16, 255, 243, 210, 205, 12, 19, 236,
        95, 151, 68, 23, 196, 167, 126, 61, 100, 93, 25, 115,
        96, 129, 79, 220, 34, 42, 144, 136, 70, 238, 184, 20,
        222, 94, 11, 219, 224, 50, 58, 10, 73, 6, 36, 92,
        194, 211, 172, 98, 145, 149, 228, 121, 231, 200, 55, 109,
        141, 213, 78, 169, 108, 86, 244, 234, 101, 122, 174, 8,
        186, 120, 37, 46, 28, 166, 180, 198, 232, 221, 116, 31,
        75, 189, 139, 138, 112, 62, 181, 102, 72, 3, 246, 14,
        97, 53, 87, 185, 134, 193, 29, 158, 225, 248, 152, 17,
        105, 217, 142, 148, 155, 30, 135, 233, 206, 85, 40, 223,
        140, 161, 137, 13, 191, 230, 66, 104, 65, 153, 45, 15,
        176, 84, 187, 22
    ]
    return s
}

// Multiplication in GF(2^8) with the AES polynomial 0x11B. The loop is the
// definition; `xtime` alone would be enough for MixColumns, but
// InvMixColumns needs 9, 11, 13 and 14.
fn gmul(a0: u8, b0: u8) -> u8 {
    var a: u32 = a0 as u32
    var b: u32 = b0 as u32
    var p: u32 = 0
    var i: usize = 0
    while i < 8 {
        if (b & 1 as u32) != 0 as u32 {
            p = p ^ a
        }
        let hi: u32 = a & 128 as u32
        a = (a << 1) & 255 as u32
        if hi != 0 as u32 {
            a = a ^ 27 as u32
        }
        b = b >> 1
        i = i + 1
    }
    return (p & 255 as u32) as u8
}

// The key schedule of FIPS 197 5.2: 44 words, every fourth one goes
// through RotWord, SubWord and the round constant.
fn aes128_new(key: u64) -> Aes {
    var a: Aes = Aes { rk: [0; 176], sbox: sbox_table(), isbox: [0; 256],
        m2: [0; 256], m3: [0; 256], m9: [0; 256], m11: [0; 256],
        m13: [0; 256], m14: [0; 256], ni: accel.accel_aes() }
    var i: usize = 0
    while i < 256 {
        a.isbox[a.sbox[i] as usize] = i as u8
        let v: u8 = i as u8
        a.m2[i] = gmul(v, 2 as u8)
        a.m3[i] = gmul(v, 3 as u8)
        a.m9[i] = gmul(v, 9 as u8)
        a.m11[i] = gmul(v, 11 as u8)
        a.m13[i] = gmul(v, 13 as u8)
        a.m14[i] = gmul(v, 14 as u8)
        i = i + 1
    }
    i = 0
    while i < 16 {
        a.rk[i] = rt.ld8(key, i)
        i = i + 1
    }
    var rcon: u8 = 1 as u8
    var w: usize = 4 // words done
    while w < 44 {
        var t: [u8; 4] = [0; 4]
        var j: usize = 0
        while j < 4 {
            t[j] = a.rk[(w - 1) * 4 + j]
            j = j + 1
        }
        if w % 4 == 0 {
            // RotWord + SubWord + Rcon
            let tmp: u8 = t[0]
            t[0] = a.sbox[t[1] as usize] ^ rcon
            t[1] = a.sbox[t[2] as usize]
            t[2] = a.sbox[t[3] as usize]
            t[3] = a.sbox[tmp as usize]
            rcon = gmul(rcon, 2 as u8)
        }
        j = 0
        while j < 4 {
            a.rk[w * 4 + j] = a.rk[(w - 4) * 4 + j] ^ t[j]
            j = j + 1
        }
        w = w + 1
    }
    return a
}

fn add_round_key(st: *mut [u8; 16], a: *mut Aes, round: usize) {
    var i: usize = 0
    while i < 16 {
        (*st)[i] = (*st)[i] ^ (*a).rk[round * 16 + i]
        i = i + 1
    }
}

fn aes_encrypt_block_soft(a: *mut Aes, inp: u64, out: u64) {
    var st: [u8; 16] = [0; 16]
    var i: usize = 0
    while i < 16 {
        st[i] = rt.ld8(inp, i)
        i = i + 1
    }
    add_round_key(&st, a, 0)
    var round: usize = 1
    while round <= 10 {
        // SubBytes
        i = 0
        while i < 16 {
            st[i] = (*a).sbox[st[i] as usize]
            i = i + 1
        }
        // ShiftRows -- the state is COLUMN MAJOR: index = col * 4 + row.
        var t: [u8; 16] = [0; 16]
        i = 0
        while i < 16 {
            t[i] = st[i]
            i = i + 1
        }
        var r: usize = 1
        while r < 4 {
            var c: usize = 0
            while c < 4 {
                st[c * 4 + r] = t[((c + r) % 4) * 4 + r]
                c = c + 1
            }
            r = r + 1
        }
        if round < 10 {
            // MixColumns
            var c: usize = 0
            while c < 4 {
                let a0: u8 = st[c * 4]
                let a1: u8 = st[c * 4 + 1]
                let a2: u8 = st[c * 4 + 2]
                let a3: u8 = st[c * 4 + 3]
                st[c * 4] = (*a).m2[a0 as usize] ^ (*a).m3[a1 as usize] ^ a2 ^ a3
                st[c * 4 + 1] = a0 ^ (*a).m2[a1 as usize] ^ (*a).m3[a2 as usize] ^ a3
                st[c * 4 + 2] = a0 ^ a1 ^ (*a).m2[a2 as usize] ^ (*a).m3[a3 as usize]
                st[c * 4 + 3] = (*a).m3[a0 as usize] ^ a1 ^ a2 ^ (*a).m2[a3 as usize]
                c = c + 1
            }
        }
        add_round_key(&st, a, round)
        round = round + 1
    }
    i = 0
    while i < 16 {
        rt.st8(out, i, st[i])
        i = i + 1
    }
}

fn aes_decrypt_block(a: *mut Aes, inp: u64, out: u64) {
    var st: [u8; 16] = [0; 16]
    var i: usize = 0
    while i < 16 {
        st[i] = rt.ld8(inp, i)
        i = i + 1
    }
    add_round_key(&st, a, 10)
    var round: usize = 10
    while round >= 1 {
        // InvShiftRows
        var t: [u8; 16] = [0; 16]
        i = 0
        while i < 16 {
            t[i] = st[i]
            i = i + 1
        }
        var r: usize = 1
        while r < 4 {
            var c: usize = 0
            while c < 4 {
                st[((c + r) % 4) * 4 + r] = t[c * 4 + r]
                c = c + 1
            }
            r = r + 1
        }
        // InvSubBytes
        i = 0
        while i < 16 {
            st[i] = (*a).isbox[st[i] as usize]
            i = i + 1
        }
        add_round_key(&st, a, round - 1)
        if round > 1 {
            // InvMixColumns
            var c: usize = 0
            while c < 4 {
                let a0: u8 = st[c * 4]
                let a1: u8 = st[c * 4 + 1]
                let a2: u8 = st[c * 4 + 2]
                let a3: u8 = st[c * 4 + 3]
                st[c * 4] = (*a).m14[a0 as usize] ^ (*a).m11[a1 as usize]
                ^ (*a).m13[a2 as usize] ^ (*a).m9[a3 as usize]
                st[c * 4 + 1] = (*a).m9[a0 as usize] ^ (*a).m14[a1 as usize]
                ^ (*a).m11[a2 as usize] ^ (*a).m13[a3 as usize]
                st[c * 4 + 2] = (*a).m13[a0 as usize] ^ (*a).m9[a1 as usize]
                ^ (*a).m14[a2 as usize] ^ (*a).m11[a3 as usize]
                st[c * 4 + 3] = (*a).m11[a0 as usize] ^ (*a).m13[a1 as usize]
                ^ (*a).m9[a2 as usize] ^ (*a).m14[a3 as usize]
                c = c + 1
            }
        }
        round = round - 1
    }
    i = 0
    while i < 16 {
        rt.st8(out, i, st[i])
        i = i + 1
    }
}

// ------------------------------------------------------------------- CBC
//
// `iv` is READ AND WRITTEN: after the call it holds the last ciphertext
// block, so a second call continues the same stream. `n` must be a
// multiple of 16 (A2).

fn aes_cbc_encrypt_soft(a: *mut Aes, iv: u64, p: u64, n: usize, out: u64) -> bool {
    if n % 16 != 0 {
        return false
    }
    var blk: [u8; 16] = [0; 16]
    var at: usize = 0
    while at < n {
        var i: usize = 0
        while i < 16 {
            blk[i] = rt.ld8(p, at + i) ^ rt.ld8(iv, i)
            i = i + 1
        }
        aes_encrypt_block_soft(a, (&blk[0]) as u64, out + at as u64)
        i = 0
        while i < 16 {
            rt.st8(iv, i, rt.ld8(out + at as u64, i))
            i = i + 1
        }
        at = at + 16
    }
    return true
}

fn aes_cbc_decrypt_soft(a: *mut Aes, iv: u64, p: u64, n: usize, out: u64) -> bool {
    if n % 16 != 0 {
        return false
    }
    var plain: [u8; 16] = [0; 16]
    var keep: [u8; 16] = [0; 16]
    var at: usize = 0
    while at < n {
        var i: usize = 0
        // The ciphertext block has to be kept BEFORE the output is written
        // -- `out` may be the same memory as `p`.
        while i < 16 {
            keep[i] = rt.ld8(p, at + i)
            i = i + 1
        }
        aes_decrypt_block(a, p + at as u64, (&plain[0]) as u64)
        i = 0
        while i < 16 {
            rt.st8(out + at as u64, i, plain[i] ^ rt.ld8(iv, i))
            i = i + 1
        }
        i = 0
        while i < 16 {
            rt.st8(iv, i, keep[i])
            i = i + 1
        }
        at = at + 16
    }
    return true
}

// ------------------------------------------------------------------ CFB8
//
// One AES encryption PER OCTET. `iv` is the 16 octet shift register and is
// updated, so a connection keeps ONE register for its whole life -- which
// is exactly what the Minecraft protocol does.

fn aes_cfb8_encrypt_soft(a: *mut Aes, iv: u64, p: u64, n: usize, out: u64) {
    var keystream: [u8; 16] = [0; 16]
    var i: usize = 0
    while i < n {
        aes_encrypt_block_soft(a, iv, (&keystream[0]) as u64)
        let c: u8 = rt.ld8(p, i) ^ keystream[0]
        rt.st8(out, i, c)
        // shift the register left by one octet, append the CIPHERTEXT
        var j: usize = 0
        while j < 15 {
            rt.st8(iv, j, rt.ld8(iv, j + 1))
            j = j + 1
        }
        rt.st8(iv, 15, c)
        i = i + 1
    }
}

fn aes_cfb8_decrypt_soft(a: *mut Aes, iv: u64, p: u64, n: usize, out: u64) {
    var keystream: [u8; 16] = [0; 16]
    var i: usize = 0
    while i < n {
        aes_encrypt_block_soft(a, iv, (&keystream[0]) as u64)
        let c: u8 = rt.ld8(p, i)
        rt.st8(out, i, c ^ keystream[0])
        var j: usize = 0
        while j < 15 {
            rt.st8(iv, j, rt.ld8(iv, j + 1))
            j = j + 1
        }
        rt.st8(iv, 15, c)
        i = i + 1
    }
}

// ------------------------------------------------- ROUND 82: the dispatch
//
// One `if` per CALL, not per block. `(*a).ni` was settled in `aes128_new`.

fn aes128_new_soft(key: u64) -> Aes {
    var a: Aes = aes128_new(key)
    a.ni = false
    return a
}

fn aes_encrypt_block(a: *mut Aes, inp: u64, out: u64) {
    if (*a).ni {
        accel.aes128_ni_encrypt_block((&(*a).rk[0]) as u64, inp, out)
        return
    }
    aes_encrypt_block_soft(a, inp, out)
}

fn aes_cbc_encrypt(a: *mut Aes, iv: u64, p: u64, n: usize, out: u64) -> bool {
    if n % 16 != 0 {
        return false
    }
    if (*a).ni {
        accel.aes128_ni_cbc_encrypt((&(*a).rk[0]) as u64, iv, p, n, out)
        return true
    }
    return aes_cbc_encrypt_soft(a, iv, p, n, out)
}

fn aes_cbc_decrypt(a: *mut Aes, iv: u64, p: u64, n: usize, out: u64) -> bool {
    if n % 16 != 0 {
        return false
    }
    if (*a).ni {
        accel.aes128_ni_cbc_decrypt((&(*a).rk[0]) as u64, iv, p, n, out)
        return true
    }
    return aes_cbc_decrypt_soft(a, iv, p, n, out)
}

fn aes_cfb8_encrypt(a: *mut Aes, iv: u64, p: u64, n: usize, out: u64) {
    if (*a).ni {
        accel.aes128_ni_cfb8_encrypt((&(*a).rk[0]) as u64, iv, p, n, out)
        return
    }
    aes_cfb8_encrypt_soft(a, iv, p, n, out)
}

fn aes_cfb8_decrypt(a: *mut Aes, iv: u64, p: u64, n: usize, out: u64) {
    if (*a).ni {
        accel.aes128_ni_cfb8_decrypt((&(*a).rk[0]) as u64, iv, p, n, out)
        return
    }
    aes_cfb8_decrypt_soft(a, iv, p, n, out)
}
