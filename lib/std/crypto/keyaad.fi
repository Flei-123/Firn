// lib/std/crypto/keyaad.fi -- byte writers for the associated data and info strings of the Orbit key hierarchy.
import std.rt

export { aad_raw, aad_tag, aad_u8, aad_u32, aad_lp8 }

fn aad_raw(out: u64, at: usize, p: u64, n: usize) -> usize {
    rt.mem_copy(out + at as u64, p, n)
    return at + n
}

fn aad_tag(out: u64, at: usize, tag: str) -> usize {
    return aad_raw(out, at, tag.p as u64, tag.n)
}

fn aad_u8(out: u64, at: usize, v: u64) -> usize {
    rt.st8(out, at, (v & 255) as u8)
    return at + 1
}

fn aad_u32(out: u64, at: usize, v: u64) -> usize {
    rt.st8(out, at, ((v >> 24) & 255) as u8)
    rt.st8(out, at + 1, ((v >> 16) & 255) as u8)
    rt.st8(out, at + 2, ((v >> 8) & 255) as u8)
    rt.st8(out, at + 3, (v & 255) as u8)
    return at + 4
}

fn aad_lp8(out: u64, at: usize, p: u64, n: usize) -> usize {
    rt.st8(out, at, (n & 255) as u8)
    return aad_raw(out, at + 1, p, n)
}
