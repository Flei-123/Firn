// SPDX-License-Identifier: MIT
// lib/std/crypto/ecdsa.fi -- NIST P-256 and P-384, and the verification
// of an ECDSA signature on them (round B5).
//
// The other half of "can this certificate be trusted". RSA is in
// `rsa.fi`; these are the two curves that carry the modern web. P-256 is
// what Let's Encrypt and Google issue leaf certificates on; P-384 turned
// out to be NOT optional, and that is a measured statement: the very first
// real chain this round tried -- `example.com`, behind Cloudflare -- has a
// P-384 intermediate and a P-384 root, and with P-256 alone the whole
// chain came back `PARSE`. A browser that cannot do P-384 cannot open a
// large part of the web.
//
// Verification only. A verifier works on public data -- the public key,
// the signature, the hash -- so nothing here has to hide anything, and the
// square-and-multiply of `std.crypto.big` with its branch on the exponent
// bit is exactly right. SIGNING on these curves would need a constant-time
// scalar multiplication and a nonce that is never reused; neither is here,
// and neither is needed by a browser.
//
// ============================================================ THE GEOMETRY
//
// The points are carried in JACOBIAN coordinates: (X, Y, Z) stands for the
// affine point (X/Z^2, Y/Z^3). The reason is that a point addition in
// affine coordinates needs a modular INVERSION, which costs about as much
// as a hundred multiplications; in Jacobian coordinates addition and
// doubling need none, and the single inversion is paid once at the end. A
// scalar multiplication therefore costs a few hundred doublings and
// additions of a dozen multiplications each, plus one inversion --
// instead of one inversion per bit.
//
// The doubling formula uses a = -3, which BOTH curves were chosen to
// have: it turns `3*(X^2 - Z^4)` into `3*(X - Z^2)*(X + Z^2)` and saves
// two squarings per bit. That is also why one piece of code serves both
// curves -- everything that differs between them is a number in a
// `Curve`, not a line of arithmetic.
//
// Z = 0 is the point at infinity. It has no affine form and every
// operation below checks for it -- an addition that returns infinity
// without saying so is how a verifier ends up accepting the signature
// (r, s) = (0, 0).
//
// ============================================================== THE CHECKS
//
// ECDSA verification (SEC 1, 4.1.4) is four conditions and ALL FOUR are
// here, because each of them alone is a forgery:
//
//   1. r and s must lie in [1, n-1]. s = 0 makes the inversion undefined
//      and r = 0 makes the answer independent of the message.
//   2. the public key must be a point ON the curve, and not the point at
//      infinity. A "public key" off the curve lies in a group where the
//      discrete logarithm is easy.
//   3. R = u1*G + u2*Q must not be the point at infinity.
//   4. R.x mod n must equal r.
//
// The hash is taken as its leftmost `ceil(log2 n)` bits, which for a hash
// shorter than the curve means the whole hash and for a longer one means a
// truncation -- SEC 1, 4.1.4 step 3.
//
// ==================================================================== HONEST
//
// E1 P-256 AND P-384 ONLY. Not P-521, not Ed25519, not any of the
//    Brainpool curves. A chain that needs one of those comes back
//    `UNSUPPORTED` from `lib/tls/x509.fi` and is refused, not accepted.
// E2 UNCOMPRESSED POINTS ONLY (the 0x04 form, SEC 1 2.3.3). A compressed
//    public key needs a square root modulo p; certificates in the wild are
//    uncompressed and a compressed one is refused rather than guessed at.
// E3 NOT CONSTANT TIME, on purpose -- see above. This file must never be
//    used to sign.
// E4 THE TWO SCALAR MULTIPLICATIONS ARE SEPARATE. Shamir's trick (one
//    ladder over both scalars) is about 30 % faster and is not here; the
//    measured cost of a verification is in docs/ROUNDB5.md.
// E5 THE CONSTANTS WERE CHECKED, NOT COPIED. The generator that produced
//    the tables below verified for both curves that G satisfies
//    y^2 = x^3 - 3x + b and that n*G is the point at infinity, with an
//    independent affine implementation. A transcription error in a curve
//    constant produces a verifier that rejects everything, or -- worse --
//    one that works in a group of the wrong order.
import std.rt
import std.crypto.big

export { Curve, curve_new_p256, curve_p256, curve_p384,
    ecdsa_verify_curve,
    ecdsa_verify, ecdsa_verify_p384, point_valid, curve_bytes,
    P256_LEN, P384_LEN }

const P256_LEN: usize = 32
const P384_LEN: usize = 48

// ---- P256: p, n, n-2, b, and the base point.

fn p256_p(a: *mut big.Big) {
    big.big_zero(a)
    (*a).d[0] = 4294967295 as u32
    (*a).d[1] = 4294967295 as u32
    (*a).d[2] = 4294967295 as u32
    (*a).d[3] = 0 as u32
    (*a).d[4] = 0 as u32
    (*a).d[5] = 0 as u32
    (*a).d[6] = 1 as u32
    (*a).d[7] = 4294967295 as u32
    (*a).n = 8
}

fn p256_n(a: *mut big.Big) {
    big.big_zero(a)
    (*a).d[0] = 4234356049 as u32
    (*a).d[1] = 4089039554 as u32
    (*a).d[2] = 2803342980 as u32
    (*a).d[3] = 3169254061 as u32
    (*a).d[4] = 4294967295 as u32
    (*a).d[5] = 4294967295 as u32
    (*a).d[6] = 0 as u32
    (*a).d[7] = 4294967295 as u32
    (*a).n = 8
}

