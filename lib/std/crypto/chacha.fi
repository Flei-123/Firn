// SPDX-License-Identifier: MIT
// lib/std/crypto/chacha.fi -- ChaCha20, Poly1305 and the AEAD they make
// together (RFC 8439), round B5.
//
// One of the two cipher suites this browser offers. The other one,
// AES-128-GCM, is in `gcm.fi` and needs the processor to have AES-NI to be
// fast; this one is fast on ANY processor, which is why it exists: it was
// designed for the phones and routers that have no AES instruction, and on
// this machine it is the fallback that is not slow.
//
// ================================================================= CHACHA20
//
// A stream cipher, and the stream is a COUNTER MODE over a permutation.
// The state is sixteen 32 bit words:
//
//     "expand 32-byte k"  (4 words, constant)
//     the key             (8 words)
//     the block counter   (1 word)
//     the nonce           (3 words)
//
// twenty rounds of a quarter-round that only adds, xors and rotates -- no
// table, no data dependent branch, so ChaCha20 is CONSTANT TIME by
// construction. That is the property AES loses when it is written with
// S-box lookups (`aes.fi`, note A3).
//
// The output block is the permuted state ADDED to the original state.
// Without that addition the permutation would be invertible and the key
// would fall out of one known block.
//
// THE ARITHMETIC. The words are 32 bit and add modulo 2^32. Firn traps on
// overflow, so every one of those additions is written `+%` -- see
// `sha512.fi` for why that is a statement and not a workaround. The words
// are carried in u64 and masked, because a rotation needs the bits above
// to be zero.
//
// ================================================================ POLY1305
//
// A one-time authenticator, not a hash. It evaluates the message as a
// polynomial at the secret point r, modulo the prime 2^130 - 5, and adds
// the secret s. THE KEY MAY BE USED ONCE. Two messages under one (r,s) let
// an attacker solve for r and forge everything afterwards; that is why the
// AEAD below derives a fresh one from the nonce for every single record.
//
// The arithmetic is five limbs of 26 bits in u64 accumulators. The bound:
// a limb is below 2^26, r is CLAMPED so its limbs are below 2^26 too, the
// pre-multiplied 5*r below 2^29, and a product of five such terms stays
// below 2^58. The clamping (RFC 8439 2.5, `r &= 0x0ffffffc...0fffffff`)
// exists for exactly this reason -- it is not a security measure, it is
// what keeps the implementation's intermediate values in range.
//
// ==================================================================== HONEST
//
// C1 THE TAG COMPARISON IS CONSTANT TIME (`tag_equal`), and it has to be.
//    A comparison that stops at the first wrong octet lets an attacker
//    forge a tag one octet at a time -- 16 x 256 tries instead of 2^128.
// C2 NO INCREMENTAL INTERFACE. Seal and open take the whole message. TLS
//    records are at most 16 KiB, so nothing here needs to stream, and an
//    incremental Poly1305 would be a second state machine to keep right.
// C3 THE COUNTER IS 32 BITS and starts at 1 in the AEAD, so one key/nonce
//    pair carries at most 256 GiB. A TLS record is 16 KiB.
import std.rt

export { chacha20_block, chacha20, poly1305, aead_seal, aead_open,
    tag_equal, CHACHA_KEY, CHACHA_NONCE, POLY_TAG }

const M32: u64 = 4294967295
const CHACHA_KEY: usize = 32
const CHACHA_NONCE: usize = 12
const POLY_TAG: usize = 16

fn rotl32(x: u64, n: u64) -> u64 {
    return ((x << n) | ((x & M32) >> (32 as u64 - n))) & M32
}

fn le32(p: u64, off: usize) -> u64 {
    return (rt.ld8(p, off) as u64)
    | ((rt.ld8(p, off + 1) as u64) << 8)
    | ((rt.ld8(p, off + 2) as u64) << 16)
    | ((rt.ld8(p, off + 3) as u64) << 24)
}

fn put_le32(p: u64, off: usize, v: u64) {
    rt.st8(p, off, (v & 255 as u64) as u8)
    rt.st8(p, off + 1, ((v >> 8) & 255 as u64) as u8)
    rt.st8(p, off + 2, ((v >> 16) & 255 as u64) as u8)
    rt.st8(p, off + 3, ((v >> 24) & 255 as u64) as u8)
}

// One 64 octet keystream block. `out` gets 64 octets.
fn chacha20_block(key: u64, nonce: u64, counter: u32, out: u64) {
    var s: [u64; 16] = [0; 16]
    // "expand 32-byte k" as four little-endian words.
    s[0] = 1634760805
    s[1] = 857760878
    s[2] = 2036477234
    s[3] = 1797285236
    var i: usize = 0
    while i < 8 {
        s[4 + i] = le32(key, i * 4)
        i = i + 1
    }
    s[12] = counter as u64
    i = 0
    while i < 3 {
        s[13 + i] = le32(nonce, i * 4)
        i = i + 1
    }
    var w: [u64; 16] = [0; 16]
    i = 0
    while i < 16 {
        w[i] = s[i]
        i = i + 1
    }
    var r: usize = 0
    while r < 10 {
        // the column round
        quarter(&w, 0, 4, 8, 12)
        quarter(&w, 1, 5, 9, 13)
        quarter(&w, 2, 6, 10, 14)
        quarter(&w, 3, 7, 11, 15)
        // the diagonal round
        quarter(&w, 0, 5, 10, 15)
        quarter(&w, 1, 6, 11, 12)
        quarter(&w, 2, 7, 8, 13)
        quarter(&w, 3, 4, 9, 14)
        r = r + 1
    }
    i = 0
    while i < 16 {
        put_le32(out, i * 4, (w[i] +% s[i]) & M32)
        i = i + 1
    }
}

fn quarter(w: *mut [u64; 16], a: usize, b: usize, c: usize, d: usize) {
    (*w)[a] = ((*w)[a] +% (*w)[b]) & M32
    (*w)[d] = rotl32((*w)[d] ^ (*w)[a], 16)
    (*w)[c] = ((*w)[c] +% (*w)[d]) & M32
    (*w)[b] = rotl32((*w)[b] ^ (*w)[c], 12)
    (*w)[a] = ((*w)[a] +% (*w)[b]) & M32
    (*w)[d] = rotl32((*w)[d] ^ (*w)[a], 8)
    (*w)[c] = ((*w)[c] +% (*w)[d]) & M32
    (*w)[b] = rotl32((*w)[b] ^ (*w)[c], 7)
}

// The stream cipher: `n` octets at `src` become `n` octets at `dst`.
// Encryption and decryption are the same function.
fn chacha20(key: u64, nonce: u64, counter: u32, src: u64, n: usize,
    dst: u64) {
    var ks: [u8; 64] = [0; 64]
    var at: usize = 0
    var blk: u64 = counter as u64
    while at < n {
        chacha20_block(key, nonce, (blk & M32) as u32, (&ks[0]) as u64)
        var i: usize = 0
        while i < 64 && at + i < n {
            rt.st8(dst, at + i, rt.ld8(src, at + i) ^ ks[i])
            i = i + 1
        }
        at = at + 64
        blk = (blk +% (1 as u64)) & M32
    }
}

// ---------------------------------------------------------------- Poly1305

struct Poly {
    r: [u64; 5],
    h: [u64; 5],
    pad: [u64; 4],
    buf: [u8; 16],
    used: usize,
}

fn poly_init(p: *mut Poly, key: u64) {
    // r, clamped as RFC 8439 2.5 prescribes, cut into five 26 bit limbs.
    let t0: u64 = le32(key, 0)
    let t1: u64 = le32(key, 4)
    let t2: u64 = le32(key, 8)
    let t3: u64 = le32(key, 12)
    (*p).r[0] = t0 & 67108863 as u64
    (*p).r[1] = ((t0 >> 26) | (t1 << 6)) & 67108611 as u64
    (*p).r[2] = ((t1 >> 20) | (t2 << 12)) & 67092735 as u64
    (*p).r[3] = ((t2 >> 14) | (t3 << 18)) & 66076671 as u64
    (*p).r[4] = (t3 >> 8) & 1048575 as u64
    var i: usize = 0
    while i < 5 {
        (*p).h[i] = 0
        i = i + 1
    }
    i = 0
    while i < 4 {
        (*p).pad[i] = le32(key, 16 + i * 4)
        i = i + 1
    }
    (*p).used = 0
}

// One 16 octet block into the accumulator. `hibit` is 1 for a full block
// and 0 for the last, padded one -- the 2^128 that separates a message
// from a shorter one with the same octets.
fn poly_block(p: *mut Poly, m: u64, hibit: u64) {
    let t0: u64 = le32(m, 0)
    let t1: u64 = le32(m, 4)
    let t2: u64 = le32(m, 8)
    let t3: u64 = le32(m, 12)
    var h0: u64 = (*p).h[0] + (t0 & 67108863 as u64)
    var h1: u64 = (*p).h[1] + (((t0 >> 26) | (t1 << 6)) & 67108863 as u64)
    var h2: u64 = (*p).h[2] + (((t1 >> 20) | (t2 << 12)) & 67108863 as u64)
    var h3: u64 = (*p).h[3] + (((t2 >> 14) | (t3 << 18)) & 67108863 as u64)
    var h4: u64 = (*p).h[4] + ((t3 >> 8) | (hibit << 24))
    let r0: u64 = (*p).r[0]
    let r1: u64 = (*p).r[1]
    let r2: u64 = (*p).r[2]
    let r3: u64 = (*p).r[3]
    let r4: u64 = (*p).r[4]
    let s1: u64 = r1 * 5
    let s2: u64 = r2 * 5
    let s3: u64 = r3 * 5
    let s4: u64 = r4 * 5
    let d0: u64 = h0 * r0 + h1 * s4 + h2 * s3 + h3 * s2 + h4 * s1
    let d1: u64 = h0 * r1 + h1 * r0 + h2 * s4 + h3 * s3 + h4 * s2
    let d2: u64 = h0 * r2 + h1 * r1 + h2 * r0 + h3 * s4 + h4 * s3
    let d3: u64 = h0 * r3 + h1 * r2 + h2 * r1 + h3 * r0 + h4 * s4
    let d4: u64 = h0 * r4 + h1 * r3 + h2 * r2 + h3 * r1 + h4 * r0
    var c: u64 = d0 >> 26
    h0 = d0 & 67108863 as u64
    let e1: u64 = d1 + c
    c = e1 >> 26
    h1 = e1 & 67108863 as u64
    let e2: u64 = d2 + c
    c = e2 >> 26
    h2 = e2 & 67108863 as u64
    let e3: u64 = d3 + c
    c = e3 >> 26
    h3 = e3 & 67108863 as u64
    let e4: u64 = d4 + c
    c = e4 >> 26
    h4 = e4 & 67108863 as u64
    h0 = h0 + c * 5
    c = h0 >> 26
    h0 = h0 & 67108863 as u64
    h1 = h1 + c
    (*p).h[0] = h0
    (*p).h[1] = h1
    (*p).h[2] = h2
    (*p).h[3] = h3
    (*p).h[4] = h4
}

fn poly_update(p: *mut Poly, m: u64, n: usize) {
    var at: usize = 0
    while at < n {
        if (*p).used == 0 && n - at >= 16 {
            poly_block(p, m + at as u64, 1)
            at = at + 16
        } else {
            (*p).buf[(*p).used] = rt.ld8(m, at)
            (*p).used = (*p).used + 1
            at = at + 1
            if (*p).used == 16 {
                poly_block(p, (&(*p).buf[0]) as u64, 1)
                (*p).used = 0
            }
        }
    }
}

fn poly_final(p: *mut Poly, out: u64) {
    if (*p).used > 0 {
        let had: usize = (*p).used
        (*p).buf[had] = 1 as u8
        var i: usize = had + 1
        while i < 16 {
            (*p).buf[i] = 0 as u8
            i = i + 1
        }
        poly_block(p, (&(*p).buf[0]) as u64, 0)
    }
    var h0: u64 = (*p).h[0]
    var h1: u64 = (*p).h[1]
    var h2: u64 = (*p).h[2]
    var h3: u64 = (*p).h[3]
    var h4: u64 = (*p).h[4]
    var c: u64 = h1 >> 26
    h1 = h1 & 67108863 as u64
    h2 = h2 + c
    c = h2 >> 26
    h2 = h2 & 67108863 as u64
    h3 = h3 + c
    c = h3 >> 26
    h3 = h3 & 67108863 as u64
    h4 = h4 + c
    c = h4 >> 26
    h4 = h4 & 67108863 as u64
    h0 = h0 + c * 5
    c = h0 >> 26
    h0 = h0 & 67108863 as u64
    h1 = h1 + c
    // h + 5: if that carries out of bit 130 the value was at least
    // 2^130 - 5 and the carried result IS h - p.
    var g0: u64 = h0 + 5
    c = g0 >> 26
    g0 = g0 & 67108863 as u64
    var g1: u64 = h1 + c
    c = g1 >> 26
    g1 = g1 & 67108863 as u64
    var g2: u64 = h2 + c
    c = g2 >> 26
    g2 = g2 & 67108863 as u64
    var g3: u64 = h3 + c
    c = g3 >> 26
    g3 = g3 & 67108863 as u64
    let g4: u64 = h4 + c
    if g4 >= 67108864 as u64 {
        h0 = g0
        h1 = g1
        h2 = g2
        h3 = g3
        h4 = g4 - 67108864 as u64
    }
    // back into four 32 bit words, then + s, modulo 2^128
    let f0: u64 = (h0 | (h1 << 26)) & M32
    let f1: u64 = ((h1 >> 6) | (h2 << 20)) & M32
    let f2: u64 = ((h2 >> 12) | (h3 << 14)) & M32
    let f3: u64 = ((h3 >> 18) | (h4 << 8)) & M32
    var acc: u64 = f0 + (*p).pad[0]
    put_le32(out, 0, acc & M32)
    acc = (acc >> 32) + f1 + (*p).pad[1]
    put_le32(out, 4, acc & M32)
    acc = (acc >> 32) + f2 + (*p).pad[2]
    put_le32(out, 8, acc & M32)
    acc = (acc >> 32) + f3 + (*p).pad[3]
    put_le32(out, 12, acc & M32)
}

// The whole message under a one-time key. 32 octets of key in, 16 out.
fn poly1305(key: u64, msg: u64, n: usize, tag: u64) {
    var p: Poly = Poly { r: [0; 5], h: [0; 5], pad: [0; 4],
        buf: [0; 16], used: 0 }
    poly_init(&p, key)
    poly_update(&p, msg, n)
    poly_final(&p, tag)
}

// See C1: no early exit, whatever the octets are.
fn tag_equal(a: u64, b: u64, n: usize) -> bool {
    var diff: u64 = 0
    var i: usize = 0
    while i < n {
        diff = diff | ((rt.ld8(a, i) as u64) ^ (rt.ld8(b, i) as u64))
        i = i + 1
    }
    return diff == 0 as u64
}

// -------------------------------------------------------------- The AEAD

fn pad16(p: *mut Poly, n: usize) {
    var zero: [u8; 16] = [0; 16]
    let rest: usize = n % 16
    if rest != 0 {
        poly_update(p, (&zero[0]) as u64, 16 - rest)
    }
}

fn put_le64(p: u64, off: usize, v: u64) {
    var i: usize = 0
    while i < 8 {
        rt.st8(p, off + i, ((v >> ((i as u64) * 8)) & 255 as u64) as u8)
        i = i + 1
    }
}

fn mac_it(otk: u64, aad: u64, na: usize, ct: u64, nc: usize, tag: u64) {
    var p: Poly = Poly { r: [0; 5], h: [0; 5], pad: [0; 4],
        buf: [0; 16], used: 0 }
    poly_init(&p, otk)
    poly_update(&p, aad, na)
    pad16(&p, na)
    poly_update(&p, ct, nc)
    pad16(&p, nc)
    var lens: [u8; 16] = [0; 16]
    put_le64((&lens[0]) as u64, 0, na as u64)
    put_le64((&lens[0]) as u64, 8, nc as u64)
    poly_update(&p, (&lens[0]) as u64, 16)
    poly_final(&p, tag)
}

// RFC 8439 2.8. `out` gets n + 16 octets: the ciphertext and the tag.
fn aead_seal(key: u64, nonce: u64, aad: u64, na: usize,
    plain: u64, n: usize, out: u64) {
    var block0: [u8; 64] = [0; 64]
    chacha20_block(key, nonce, 0 as u32, (&block0[0]) as u64)
    chacha20(key, nonce, 1 as u32, plain, n, out)
    mac_it((&block0[0]) as u64, aad, na, out, n, out + n as u64)
}

// `n` counts the tag. `out` gets n - 16 octets. `false` means the tag did
// not match, and then NOTHING of the plaintext may be used -- which is why
// the decryption happens after the check and not before.
fn aead_open(key: u64, nonce: u64, aad: u64, na: usize,
    ct: u64, n: usize, out: u64) -> bool {
    if n < POLY_TAG {
        return false
    }
    let clen: usize = n - POLY_TAG
    var block0: [u8; 64] = [0; 64]
    chacha20_block(key, nonce, 0 as u32, (&block0[0]) as u64)
    var want: [u8; 16] = [0; 16]
    mac_it((&block0[0]) as u64, aad, na, ct, clen, (&want[0]) as u64)
    if !tag_equal((&want[0]) as u64, ct + clen as u64, POLY_TAG) {
        return false
    }
    chacha20(key, nonce, 1 as u32, ct, clen, out)
    return true
}
