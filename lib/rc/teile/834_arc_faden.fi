// expect_exit: 0
// RUNDE 49 — `Arc[T]` UEBER FADENGRENZEN.
//
// Runde 47 hat den atomaren Zaehler gebaut und ehrlich dazugeschrieben, dass
// er mangels Faeden nicht unter Nebenlaeufigkeit geprueft werden konnte
// (docs/RUNDE47.md §3.2). Jetzt gibt es Faeden — und damit wird geprueft,
// was zugesagt ist:
//
//   A  Sechs Faeden klonen und geben DENSELBEN `Arc` je 20.000 Mal frei.
//      Am Ende steht der starke Zaehler exakt auf 1 (der Verweis des
//      Hauptfadens) und der Block ist NICHT freigegeben.
//   B  Gegenprobe im selben Lauf: dieselbe Zahl von Erhoehungen und
//      Erniedrigungen auf einem gewoehnlichen Wort OHNE `lock` verliert
//      welche. Ohne diese Gegenprobe belegt A nicht, dass die Faeden
//      wirklich gleichzeitig liefen.
//   C  `aufwerten_atomar` (schwach -> stark) unter Nebenlaeufigkeit: waehrend
//      sechs Faeden dauernd aufwerten und wieder freigeben, bleibt der
//      Zaehler stimmig, und es wird nichts doppelt freigegeben.
//   D  Wenn der letzte starke Verweis faellt, liefert `aufwerten_atomar`
//      LEER — und der Block geht genau EINMAL in die Freiliste zurueck.
//   E  Nach allem: `arc_heap_lebende` == 0, `arc_heap_freigaben` == 1.
//
// Die Arc-Halde selbst hat KEINE Sperre (das steht so in E1): deshalb
// alloziert hier nur der Hauptfaden. Die Faeden fassen ausschliesslich die
// ZAEHLER an — genau das ist der Gegenstand der Zusage.

const AF_SYS_MMAP: i64 = 9
const AF_PROT_RW: i64 = 3
const AF_MAP_ANON: i64 = 34

const AF_BLOCK: u64 = 0
const AF_ROH: u64 = 8
const AF_HEAP: u64 = 16
const AF_FEHLER: u64 = 24

const AF_RUNDEN: u64 = 20000
const AF_FAEDEN: u64 = 6

struct Nutz { wert: u64, zweiter: u64 }

fn af_seite() -> u64 {
    let r: i64 = syscall(AF_SYS_MMAP, 0, 4096, AF_PROT_RW, AF_MAP_ANON, -1, 0)
    if r < 0 {
        return 0
    }
    return r as u64
}

fn af_ld(a: u64, o: u64) -> u64 {
    return *((a + o) as *mut u64)
}

fn af_st(a: u64, o: u64, v: u64) {
    *((a + o) as *mut u64) = v
}

// Art 1: klonen und freigeben. Art 2: schwach aufwerten und freigeben.
fn __faden_arbeit(art: u64, arg: u64) -> u64 {
    let block: usize = af_ld(arg, AF_BLOCK) as usize
    let h: *mut ArcHeap = af_ld(arg, AF_HEAP) as *mut ArcHeap
    if art == 1 {
        var i: u64 = 0
        while i < AF_RUNDEN {
            var k: Atomverweis[Nutz] = arc_klonen[Nutz](arc_roh_verweis[Nutz](block))
            if arc_stark_zahl[Nutz](k) < 2 as u64 {
                af_st(arg, AF_FEHLER, 1)
            }
            arc_freigeben[Nutz](h, &k)
            // Gegenprobe OHNE lock: dieselbe Zahl von Schritten.
            af_st(arg, AF_ROH, af_ld(arg, AF_ROH) + 1)
            i = i + 1
        }
        return AF_RUNDEN
    }
    if art == 2 {
        let w: AtomSchwachverweis[Nutz] = aweak_von[Nutz](arc_roh_verweis[Nutz](block))
        var i: u64 = 0
        var stark: u64 = 0
        while i < AF_RUNDEN {
            var s: Atomverweis[Nutz] = aufwerten_atomar[Nutz](w)
            if !arc_ist_leer[Nutz](s) {
                stark = stark + 1
                if arc_lesen[Nutz](s).wert != 4711 as u64 {
                    af_st(arg, AF_FEHLER, 2)
                }
                arc_freigeben[Nutz](h, &s)
            }
            i = i + 1
        }
        var wm: AtomSchwachverweis[Nutz] = w
        aweak_freigeben[Nutz](h, &wm)
        return stark
    }
    return 0
}

fn main() -> i32 {
    if !faden_init() {
        return 90
    }
    var h: ArcHeap = ArcHeap{
        basis: 0 as usize, kapazitaet: 0 as usize, naechster: 0 as usize,
        frei: [0 as usize; 8], lebende: 0 as usize, belegt: 0 as usize,
        allokationen: 0 as usize, freigaben: 0 as usize
    }
    if !arc_heap_init(&h, 65536 as usize) {
        return 91
    }
    let rc: i32 = lauf(&h) catch 92
    arc_heap_frei(&h)
    return rc
}

fn lauf(h: *mut ArcHeap) -> AllocError!i32 {
    let z: u64 = af_seite()
    if z == 0 {
        return 1
    }
    var a: Atomverweis[Nutz] = arc_leer[Nutz]()
    if !(try arc_neu[Nutz](h, Nutz{ wert: 4711 as u64, zweiter: 7 as u64 }, &a)) {
        return 2
    }
    af_st(z, AF_BLOCK, arc_roh_adresse[Nutz](a) as u64)
    af_st(z, AF_HEAP, h as u64)

    // --- A/B: klonen und freigeben aus sechs Faeden ---------------------------
    var f: [u64; 6] = [0; 6]
    var i: u64 = 0
    while i < AF_FAEDEN {
        f[i as usize] = faden_starten(1, z)
        if f[i as usize] == 0 {
            return 3
        }
        i = i + 1
    }
    var summe: u64 = 0
    i = 0
    while i < AF_FAEDEN {
        summe = summe + faden_warten(f[i as usize])
        i = i + 1
    }
    if summe != AF_FAEDEN * AF_RUNDEN {
        return 4
    }
    if af_ld(z, AF_FEHLER) != 0 {
        return 5
    }
    // Der Zaehler steht exakt wieder auf 1 — keine Erhoehung ist verloren
    // gegangen und keine zu viel zurueckgenommen worden.
    if arc_stark_zahl[Nutz](a) != 1 as u64 {
        return 6
    }
    if arc_heap_lebende(h) != 1 as usize {
        return 7
    }
    if arc_heap_freigaben(h) != 0 as usize {
        return 8
    }
    // Die Gegenprobe MUSS verloren haben.
    if af_ld(z, AF_ROH) >= AF_FAEDEN * AF_RUNDEN {
        return 9
    }

    // --- C: aufwerten unter Nebenlaeufigkeit ---------------------------------
    af_st(z, AF_FEHLER, 0)
    i = 0
    while i < AF_FAEDEN {
        f[i as usize] = faden_starten(2, z)
        if f[i as usize] == 0 {
            return 10
        }
        i = i + 1
    }
    var stark: u64 = 0
    i = 0
    while i < AF_FAEDEN {
        stark = stark + faden_warten(f[i as usize])
        i = i + 1
    }
    // Solange der Hauptfaden seinen starken Verweis haelt, MUSS jede
    // Aufwertung gelingen.
    if stark != AF_FAEDEN * AF_RUNDEN {
        return 11
    }
    if af_ld(z, AF_FEHLER) != 0 {
        return 12
    }
    if arc_stark_zahl[Nutz](a) != 1 as u64 {
        return 13
    }

    // --- D/E: der letzte starke Verweis faellt --------------------------------
    var w: AtomSchwachverweis[Nutz] = aweak_von[Nutz](a)
    arc_freigeben[Nutz](h, &a)
    var leer: Atomverweis[Nutz] = aufwerten_atomar[Nutz](w)
    if !arc_ist_leer[Nutz](leer) {
        return 14
    }
    if arc_heap_freigaben(h) != 0 as usize {
        return 15
    }
    aweak_freigeben[Nutz](h, &w)
    if arc_heap_lebende(h) != 0 as usize {
        return 16
    }
    if arc_heap_freigaben(h) != 1 as usize {
        return 17
    }
    if faden_anzahl() != 1 {
        return 18
    }
    return 0
}
