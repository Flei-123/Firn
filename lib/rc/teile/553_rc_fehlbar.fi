// expect_exit: 0

// Fehlbare Allokation (DESIGNZIELE §2): 'rc_neu' liefert 'AllocError!bool'.
// Bei erschoepfter Halde kommt AllocError::OutOfMemory zurueck — kein
// stilles 0-Ergebnis, kein Absturz. Das Ergebnis ist '#[must_consume]';
// Verwerfen ist ein Compilerfehler (tests/neg/rc_verworfen.fi).

struct Stil { farbe: u32, groesse: u32, zeilen: i64 }
struct Riesig { daten: [u8; 9000] }

fn heap_leer() -> RcHeap {
    return RcHeap{
        basis: 0 as usize, kapazitaet: 0 as usize, naechster: 0 as usize,
        frei: [0 as usize, 0 as usize, 0 as usize, 0 as usize,
               0 as usize, 0 as usize, 0 as usize, 0 as usize],
        lebende: 0 as usize, belegt: 0 as usize,
        allokationen: 0 as usize, freigaben: 0 as usize,
    }
}

// true = Erfolg, false = AllocError::OutOfMemory (der Erfolgswert ist immer
// 'true', der Fehlerzweig wird hier bewusst auf 'false' abgebildet).
fn versuche(h: *mut RcHeap, aus: *mut Zaehlverweis[Stil]) -> bool {
    let w: Stil = Stil{ farbe: 1 as u32, groesse: 2 as u32, zeilen: 3 }
    return rc_neu[Stil](h, w, aus) catch false
}

fn main() -> i32 {
    var h: RcHeap = heap_leer()

    // Kapazitaet 0: sichtbarer Fehlschlag, keine Halde.
    if rc_heap_init(&h, 0 as usize) { return 1 }
    if rc_heap_kapazitaet(&h) != 0 as usize { return 2 }
    // Ohne Halde schlaegt jede Allokation fehl — und zwar sichtbar.
    var leer_v: Zaehlverweis[Stil] = rc_leer[Stil]()
    if versuche(&h, &leer_v) { return 3 }
    if rc_ist_leer[Stil](leer_v) == false { return 4 }

    // Eine Seite: 4096 / 64 = 64 Bloecke, danach ist Schluss.
    if rc_heap_init(&h, 4096 as usize) == false { return 90 }
    var halter: [usize; 64] = [0 as usize; 64]
    var n: i64 = 0
    var v: Zaehlverweis[Stil] = rc_leer[Stil]()
    while n < 200 {
        if versuche(&h, &v) == false {
            // Fehlerfall: der Ausgabeverweis bleibt leer.
            if rc_ist_leer[Stil](v) == false { return 5 }
            n = 0 - n
            break
        }
        halter[n as usize] = rc_roh_adresse[Stil](v)
        n = n + 1
        if n >= 64 {
            // Sicherung: die 65. Allokation MUSS scheitern.
            if versuche(&h, &v) { return 6 }
            n = 0 - n
            break
        }
    }
    if n != 0 - 64 { return 7 }
    if rc_heap_lebende(&h) != 64 as usize { return 8 }

    // Nach einer Freigabe geht es wieder — der Block kommt aus der Freiliste.
    var zurueck: Zaehlverweis[Stil] = rc_roh_verweis[Stil](halter[0])
    rc_freigeben[Stil](&h, &zurueck)
    if rc_heap_lebende(&h) != 63 as usize { return 9 }
    if versuche(&h, &v) == false { return 10 }
    if rc_heap_lebende(&h) != 64 as usize { return 11 }
    // Und danach ist wieder Schluss.
    if versuche(&h, &v) { return 12 }

    // Zu grosse Nutzlast: passt in keine Groessenklasse -> OutOfMemory,
    // auch wenn die Halde selbst gross genug waere.
    var h2: RcHeap = heap_leer()
    if rc_heap_init(&h2, 1048576 as usize) == false { return 91 }
    var gross: Zaehlverweis[Riesig] = rc_leer[Riesig]()
    let ok: bool = rc_neu[Riesig](&h2, Riesig{ daten: [7 as u8; 9000] }, &gross) catch false
    if ok { return 13 }
    if rc_ist_leer[Riesig](gross) == false { return 14 }
    if rc_heap_lebende(&h2) != 0 as usize { return 15 }

    // 'try' in einer fehlbaren Funktion: die Fehlerunion wird durchgereicht.
    if kette(&h2) == false { return 16 }

    rc_heap_frei(&h)
    rc_heap_frei(&h2)
    return 0
}

// Zeigt den 'try'-Weg: der Fehler wandert nach oben, der Aufrufer entscheidet.
fn kette_innen(h: *mut RcHeap, aus: *mut Zaehlverweis[Stil]) -> AllocError!bool {
    let w: Stil = Stil{ farbe: 9 as u32, groesse: 9 as u32, zeilen: 9 }
    let ok: bool = try rc_neu[Stil](h, w, aus)
    return ok
}

fn kette(h: *mut RcHeap) -> bool {
    var v: Zaehlverweis[Stil] = rc_leer[Stil]()
    let ok: bool = kette_innen(h, &v) catch false
    if ok == false { return false }
    if rc_lesen[Stil](v).zeilen != 9 { return false }
    rc_freigeben[Stil](h, &v)
    return true
}
