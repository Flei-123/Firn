// expect_exit: 0

// RUNDE 47 — ZYKLEN AUS `Arc[T]` LECKEN. Sichtbar gemacht, nicht versteckt.
//
// Das ist dieselbe Aussage wie in tests/552 fuer `Rc`, und sie steht hier
// noch einmal, weil `Arc` genau so wenig Zyklen aufloest wie `Rc` — der
// atomare Zaehler aendert daran NICHTS. Wer Zyklen hat, nimmt entweder
// `AtomSchwachverweis` (bricht ihn von Hand) oder `gc class`/`Gc[T]`
// (loest ihn auf, SPEC 3.5).
//
// Der Test zeigt beides in EINEM Lauf:
//   A  1000 Zyklenpaare, beide Seiten stark -> nichts wird frei
//   B  dieselben 1000 Paare, eine Seite schwach -> alles wird frei
// Und er verlangt, dass A wirklich leckt: waere das Leck weg, waere die
// Aussage der Dokumentation falsch und der Test muesste anschlagen.

struct Zelle {
    partner: usize,
    wert: u64,
}

fn main() -> i32 {
    var h: ArcHeap = ArcHeap{
        basis: 0 as usize, kapazitaet: 0 as usize, naechster: 0 as usize,
        frei: [0 as usize; 8], lebende: 0 as usize, belegt: 0 as usize,
        allokationen: 0 as usize, freigaben: 0 as usize
    }
    if !arc_heap_init(&h, 1048576 as usize) {
        return 90
    }
    let rc: i32 = lauf(&h) catch 91
    arc_heap_frei(&h)
    return rc
}

fn lauf(h: *mut ArcHeap) -> AllocError!i32 {
    let n: u64 = 1000 as u64

    // --- A: beide Seiten stark -> LECK ---------------------------------------
    var i: u64 = 0
    while i < n {
        var a: Atomverweis[Zelle] = arc_leer[Zelle]()
        var b: Atomverweis[Zelle] = arc_leer[Zelle]()
        if !(try arc_neu[Zelle](h, Zelle{ partner: 0 as usize, wert: i }, &a)) {
            return 1
        }
        if !(try arc_neu[Zelle](h, Zelle{ partner: 0 as usize, wert: i }, &b)) {
            return 2
        }
        // Der Zyklus: jede Zelle haelt einen STARKEN Verweis auf die andere.
        // Stufe 0 hat keine Destruktoren, deshalb liegt der Verweis als
        // Rohadresse im Wert (SPEC 3.6) und der Zaehler wird von Hand erhoeht.
        var ka: Atomverweis[Zelle] = arc_klonen[Zelle](a)
        var kb: Atomverweis[Zelle] = arc_klonen[Zelle](b)
        (*(arc_wert_adresse[Zelle](a) as *mut Zelle)).partner = arc_roh_adresse[Zelle](kb)
        (*(arc_wert_adresse[Zelle](b) as *mut Zelle)).partner = arc_roh_adresse[Zelle](ka)
        // Die aeusseren Verweise loslassen — die inneren bleiben.
        arc_freigeben[Zelle](h, &a)
        arc_freigeben[Zelle](h, &b)
        i = i + 1 as u64
    }
    let leck: usize = arc_heap_lebende(h)
    if leck != (2 as usize) * (n as usize) {
        return 3
    }
    if arc_heap_freigaben(h) != 0 as usize {
        return 4
    }

    // --- B: eine Seite schwach -> KEIN Leck ----------------------------------
    let vor_b: usize = arc_heap_freigaben(h)
    var j: u64 = 0
    while j < n {
        var a: Atomverweis[Zelle] = arc_leer[Zelle]()
        var b: Atomverweis[Zelle] = arc_leer[Zelle]()
        if !(try arc_neu[Zelle](h, Zelle{ partner: 0 as usize, wert: j }, &a)) {
            return 5
        }
        if !(try arc_neu[Zelle](h, Zelle{ partner: 0 as usize, wert: j }, &b)) {
            return 6
        }
        // a haelt b STARK, b haelt a nur SCHWACH.
        var kb: Atomverweis[Zelle] = arc_klonen[Zelle](b)
        var wa: AtomSchwachverweis[Zelle] = aweak_von[Zelle](a)
        (*(arc_wert_adresse[Zelle](a) as *mut Zelle)).partner = arc_roh_adresse[Zelle](kb)
        (*(arc_wert_adresse[Zelle](b) as *mut Zelle)).partner = aweak_roh_adresse[Zelle](wa)
        arc_freigeben[Zelle](h, &b)
        // a loslassen: a stirbt, gibt dabei seinen starken Verweis auf b von
        // Hand zurueck (Stufe 0 hat kein `drop`), dann stirbt b, dann faellt
        // der schwache Verweis.
        var innen: Atomverweis[Zelle] = arc_roh_verweis[Zelle](
            (*(arc_wert_adresse[Zelle](a) as *mut Zelle)).partner)
        arc_freigeben[Zelle](h, &a)
        arc_freigeben[Zelle](h, &innen)
        aweak_freigeben[Zelle](h, &wa)
        j = j + 1 as u64
    }
    if arc_heap_freigaben(h) - vor_b != (2 as usize) * (n as usize) {
        return 7
    }
    // Genau das Leck aus Teil A ist uebrig — mehr nicht, weniger nicht.
    if arc_heap_lebende(h) != leck {
        return 8
    }
    return 0
}
