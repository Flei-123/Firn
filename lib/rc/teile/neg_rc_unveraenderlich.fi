// expect_error: 396:5 linke seite ist kein zuweisbarer ausdruck

// 'Rc' ist IMMER unveraenderlich (SPEC §3.4): es gibt kein RefCell-
// Aequivalent und keine schreibende Funktion. 'rc_lesen' liefert eine Kopie;
// der Versuch, ueber sie den geteilten Wert zu aendern, ist ein
// Compilerfehler — nicht etwa eine stille Aenderung an der Kopie.

struct Stil { farbe: u32, groesse: u32, zeilen: i64 }

fn main() -> i32 {
    var h: RcHeap = RcHeap{
        basis: 0 as usize, kapazitaet: 0 as usize, naechster: 0 as usize,
        frei: [0 as usize, 0 as usize, 0 as usize, 0 as usize,
               0 as usize, 0 as usize, 0 as usize, 0 as usize],
        lebende: 0 as usize, belegt: 0 as usize,
        allokationen: 0 as usize, freigaben: 0 as usize,
    }
    if rc_heap_init(&h, 4096 as usize) == false { return 1 }
    var v: Zaehlverweis[Stil] = rc_leer[Stil]()
    let ok: bool = rc_neu[Stil](&h, Stil{ farbe: 1 as u32, groesse: 2 as u32, zeilen: 3 }, &v) catch false
    if ok == false { return 2 }
    rc_lesen[Stil](v).farbe = 7 as u32
    return 0
}
