// expect_exit: 0

// RUNDE 47 — schwache Verweise auf ein `Arc[T]` (SPEC 3.4 `Weak[T]`).
//
// Geprueft wird:
//   * ein schwacher Verweis haelt den Wert NICHT am Leben
//   * `aufwerten_atomar` liefert nach dem Tod sichtbar den LEEREN Verweis
//   * der Block wird erst frei, wenn BEIDE Zaehler 0 sind — und dann genau
//     EINMAL (kein doppeltes Freigeben ueber die beiden Wege)
//   * die Reihenfolge ist egal: stark-dann-schwach und schwach-dann-stark
//     ergeben beide genau eine Freigabe
//   * ein aufgewerteter Verweis haelt den Wert wieder am Leben

struct Knoten {
    wert: u64,
    tiefe: u32,
}

fn main() -> i32 {
    var h: ArcHeap = ArcHeap{
        basis: 0 as usize, kapazitaet: 0 as usize, naechster: 0 as usize,
        frei: [0 as usize; 8], lebende: 0 as usize, belegt: 0 as usize,
        allokationen: 0 as usize, freigaben: 0 as usize
    }
    if !arc_heap_init(&h, 65536 as usize) {
        return 90
    }
    let rc: i32 = lauf(&h) catch 91
    arc_heap_frei(&h)
    return rc
}

fn lauf(h: *mut ArcHeap) -> AllocError!i32 {
    // --- schwach haelt nicht am Leben ---------------------------------------
    var a: Atomverweis[Knoten] = arc_leer[Knoten]()
    if !(try arc_neu[Knoten](h, Knoten{ wert: 5 as u64, tiefe: 1 }, &a)) {
        return 1
    }
    var w: AtomSchwachverweis[Knoten] = aweak_von[Knoten](a)
    if aweak_ist_leer[Knoten](w) {
        return 2
    }
    if arc_stark_zahl[Knoten](a) != 1 as u64 {
        return 3
    }
    if arc_schwach_zahl[Knoten](a) != 1 as u64 {
        return 4
    }
    if aweak_stark_zahl[Knoten](w) != 1 as u64 {
        return 5
    }

    // Aufwerten, solange es lebt.
    var s: Atomverweis[Knoten] = aufwerten_atomar[Knoten](w)
    if arc_ist_leer[Knoten](s) {
        return 6
    }
    if arc_lesen[Knoten](s).wert != 5 as u64 {
        return 7
    }
    if arc_stark_zahl[Knoten](a) != 2 as u64 {
        return 8
    }
    arc_freigeben[Knoten](h, &s)

    // Letzter starker Verweis geht: der WERT ist tot, der BLOCK bleibt,
    // weil noch ein schwacher Verweis darauf zeigt.
    arc_freigeben[Knoten](h, &a)
    if arc_heap_freigaben(h) != 0 as usize {
        return 9
    }
    if arc_heap_lebende(h) != 1 as usize {
        return 10
    }
    if aweak_stark_zahl[Knoten](w) != 0 as u64 {
        return 11
    }
    // Aufwerten liefert jetzt sichtbar LEER.
    var tot: Atomverweis[Knoten] = aufwerten_atomar[Knoten](w)
    if !arc_ist_leer[Knoten](tot) {
        return 12
    }
    if aweak_stark_zahl[Knoten](w) != 0 as u64 {
        return 13
    }
    // Erst jetzt wird der Block frei — genau einmal.
    aweak_freigeben[Knoten](h, &w)
    if arc_heap_freigaben(h) != 1 as usize {
        return 14
    }
    if arc_heap_lebende(h) != 0 as usize {
        return 15
    }
    aweak_freigeben[Knoten](h, &w)
    if arc_heap_freigaben(h) != 1 as usize {
        return 16
    }

    // --- andere Reihenfolge: schwach zuerst ----------------------------------
    var b: Atomverweis[Knoten] = arc_leer[Knoten]()
    if !(try arc_neu[Knoten](h, Knoten{ wert: 8 as u64, tiefe: 2 }, &b)) {
        return 17
    }
    var w2: AtomSchwachverweis[Knoten] = aweak_von[Knoten](b)
    var w3: AtomSchwachverweis[Knoten] = aweak_von[Knoten](b)
    if arc_schwach_zahl[Knoten](b) != 2 as u64 {
        return 18
    }
    aweak_freigeben[Knoten](h, &w2)
    aweak_freigeben[Knoten](h, &w3)
    if arc_heap_freigaben(h) != 1 as usize {
        return 19
    }
    arc_freigeben[Knoten](h, &b)
    if arc_heap_freigaben(h) != 2 as usize {
        return 20
    }
    if arc_heap_lebende(h) != 0 as usize {
        return 21
    }

    // --- Dauerlauf mit beiden Wegen ------------------------------------------
    var runde: u64 = 0
    while runde < 10000 as u64 {
        var x: Atomverweis[Knoten] = arc_leer[Knoten]()
        if !(try arc_neu[Knoten](h, Knoten{ wert: runde, tiefe: 3 }, &x)) {
            return 22
        }
        var wx: AtomSchwachverweis[Knoten] = aweak_von[Knoten](x)
        var yx: Atomverweis[Knoten] = aufwerten_atomar[Knoten](wx)
        if arc_ist_leer[Knoten](yx) {
            return 23
        }
        arc_freigeben[Knoten](h, &yx)
        arc_freigeben[Knoten](h, &x)
        if !arc_ist_leer[Knoten](aufwerten_atomar[Knoten](wx)) {
            return 24
        }
        aweak_freigeben[Knoten](h, &wx)
        runde = runde + 1 as u64
    }
    if arc_heap_lebende(h) != 0 as usize {
        return 25
    }
    if arc_heap_allokationen(h) != arc_heap_freigaben(h) {
        return 26
    }
    return 0
}
