// expect_exit: 0

// RUNDE 47 — `Arc[T]` (SPEC 3.4): geteilter Besitz mit ATOMAREM Zaehler.
//
// Geprueft wird:
//   * anlegen, lesen, klonen, freigeben; Zaehlerstaende an jeder Stelle
//   * der Block wird erst frei, wenn der LETZTE starke Verweis geht
//   * kein doppeltes Freigeben: ein zweites `arc_freigeben` auf denselben
//     (schon geleerten) Verweis tut nichts, und der Zaehler laeuft nicht
//     unter 0
//   * die Halde zaehlt Allokationen und Freigaben mit, ein freigegebener
//     Block wird WIEDERVERWENDET
//   * ein voller Dauerlauf endet mit lebende == 0

struct Stil {
    farbe: u32,
    breite: u32,
    hoehe: u64,
}

fn main() -> i32 {
    var h: ArcHeap = ArcHeap{
        basis: 0 as usize, kapazitaet: 0 as usize, naechster: 0 as usize,
        frei: [0 as usize; 8], lebende: 0 as usize, belegt: 0 as usize,
        allokationen: 0 as usize, freigaben: 0 as usize
    }
    if !arc_heap_init(&h, 65536 as usize) {
        return 90
    }
    let rc: i32 = lauf(&h) catch 91
    arc_heap_frei(&h)
    return rc
}

fn lauf(h: *mut ArcHeap) -> AllocError!i32 {
    var a: Atomverweis[Stil] = arc_leer[Stil]()
    if !arc_ist_leer[Stil](a) {
        return 1
    }
    if arc_stark_zahl[Stil](a) != 0 as u64 {
        return 2
    }

    let ok: bool = try arc_neu[Stil](h, Stil{ farbe: 7, breite: 3, hoehe: 99 as u64 }, &a)
    if !ok {
        return 3
    }
    if arc_ist_leer[Stil](a) {
        return 4
    }
    if arc_stark_zahl[Stil](a) != 1 as u64 {
        return 5
    }
    if arc_schwach_zahl[Stil](a) != 0 as u64 {
        return 6
    }
    if arc_heap_lebende(h) != 1 as usize {
        return 7
    }

    // Lesen liefert eine KOPIE (Arc ist unveraenderlich, SPEC 3.4).
    var w: Stil = arc_lesen[Stil](a)
    if w.farbe != 7 || w.breite != 3 || w.hoehe != 99 as u64 {
        return 8
    }
    w.farbe = 42
    if arc_lesen[Stil](a).farbe != 7 {
        return 9
    }

    // --- klonen: derselbe Block, Zaehler + 1 --------------------------------
    var b: Atomverweis[Stil] = arc_klonen[Stil](a)
    if !arc_gleich[Stil](a, b) {
        return 10
    }
    if arc_stark_zahl[Stil](a) != 2 as u64 {
        return 11
    }
    var c: Atomverweis[Stil] = arc_klonen[Stil](b)
    if arc_stark_zahl[Stil](a) != 3 as u64 {
        return 12
    }
    if arc_heap_lebende(h) != 1 as usize {
        return 13
    }

    // --- freigeben: erst beim LETZTEN wird der Block frei --------------------
    arc_freigeben[Stil](h, &c)
    if !arc_ist_leer[Stil](c) {
        return 14
    }
    if arc_stark_zahl[Stil](a) != 2 as u64 {
        return 15
    }
    if arc_heap_lebende(h) != 1 as usize {
        return 16
    }
    arc_freigeben[Stil](h, &b)
    if arc_stark_zahl[Stil](a) != 1 as u64 {
        return 17
    }
    if arc_heap_freigaben(h) != 0 as usize {
        return 18
    }
    let blockadr: usize = arc_roh_adresse[Stil](a)
    arc_freigeben[Stil](h, &a)
    if arc_heap_lebende(h) != 0 as usize {
        return 19
    }
    if arc_heap_freigaben(h) != 1 as usize {
        return 20
    }

    // --- kein doppeltes Freigeben --------------------------------------------
    // `a` ist leer; ein zweiter Aufruf darf NICHTS tun (sonst kaeme derselbe
    // Block ein zweites Mal in die Freiliste — der klassische Fehler).
    arc_freigeben[Stil](h, &a)
    arc_freigeben[Stil](h, &b)
    if arc_heap_freigaben(h) != 1 as usize {
        return 21
    }
    if arc_heap_lebende(h) != 0 as usize {
        return 22
    }

    // --- der freie Block wird wiederverwendet --------------------------------
    var d: Atomverweis[Stil] = arc_leer[Stil]()
    if !(try arc_neu[Stil](h, Stil{ farbe: 1, breite: 1, hoehe: 1 as u64 }, &d)) {
        return 23
    }
    if arc_roh_adresse[Stil](d) != blockadr {
        return 24
    }
    if arc_heap_allokationen(h) != 2 as usize {
        return 25
    }
    arc_freigeben[Stil](h, &d)

    // --- Dauerlauf: 20.000 Runden, danach ist nichts uebrig -------------------
    var runde: u64 = 0
    while runde < 20000 as u64 {
        var x: Atomverweis[Stil] = arc_leer[Stil]()
        if !(try arc_neu[Stil](h, Stil{ farbe: 2, breite: 2, hoehe: runde }, &x)) {
            return 26
        }
        var y: Atomverweis[Stil] = arc_klonen[Stil](x)
        var z: Atomverweis[Stil] = arc_klonen[Stil](y)
        if arc_stark_zahl[Stil](x) != 3 as u64 {
            return 27
        }
        if arc_lesen[Stil](z).hoehe != runde {
            return 28
        }
        arc_freigeben[Stil](h, &y)
        arc_freigeben[Stil](h, &z)
        arc_freigeben[Stil](h, &x)
        runde = runde + 1 as u64
    }
    if arc_heap_lebende(h) != 0 as usize {
        return 29
    }
    if arc_heap_allokationen(h) != arc_heap_freigaben(h) {
        return 30
    }
    if arc_heap_belegte_bytes(h) != 0 as usize {
        return 31
    }
    return 0
}
