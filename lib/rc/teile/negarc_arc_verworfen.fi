// expect_error: 441:5 das ergebnis darf nicht verworfen werden

// RUNDE 47 — auch bei `Arc[T]` ist die Allokation FEHLBAR und ihr Ergebnis
// '#[must_consume]' (DESIGNZIELE §2, SPEC §5.1). Wer es wegwirft, bekommt
// einen Compilerfehler mit Zeile und Spalte — nicht ein stilles `null`.

struct Stil { farbe: u32, groesse: u32, zeilen: i64 }

fn main() -> i32 {
    var h: ArcHeap = ArcHeap{
        basis: 0 as usize, kapazitaet: 0 as usize, naechster: 0 as usize,
        frei: [0 as usize, 0 as usize, 0 as usize, 0 as usize,
               0 as usize, 0 as usize, 0 as usize, 0 as usize],
        lebende: 0 as usize, belegt: 0 as usize,
        allokationen: 0 as usize, freigaben: 0 as usize,
    }
    if arc_heap_init(&h, 4096 as usize) == false { return 1 }
    var v: Atomverweis[Stil] = arc_leer[Stil]()
    arc_neu[Stil](&h, Stil{ farbe: 1 as u32, groesse: 2 as u32, zeilen: 3 }, &v)
    return 0
}
