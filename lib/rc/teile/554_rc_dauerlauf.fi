// expect_out: 20000 0 0 192 1

// Gegenstueck zu tests/552_rc_zyklus_leck.fi: OHNE Zyklus leckt die Zaehlung
// nicht. 20.000 Runden legen je drei Werte (drei Auspraegungen der Vorlage)
// mit Klonen und schwachen Verweisen an und geben sie wieder frei.
// Nachgewiesen wird: lebende Objekte am Ende 0, belegte Bytes 0, und die
// Halde waechst nicht ueber die einmal geholten Seiten hinaus (Freilisten
// werden wiederverwendet).
//
// Ausgabe: runden lebende belegt naechster(hoechststand) reihenfolge_ok

struct Stil { farbe: u32, groesse: u32, zeilen: i64 }

fn heap_leer() -> RcHeap {
    return RcHeap{
        basis: 0 as usize, kapazitaet: 0 as usize, naechster: 0 as usize,
        frei: [0 as usize, 0 as usize, 0 as usize, 0 as usize,
               0 as usize, 0 as usize, 0 as usize, 0 as usize],
        lebende: 0 as usize, belegt: 0 as usize,
        allokationen: 0 as usize, freigaben: 0 as usize,
    }
}

fn print_zahl(buf: *mut u8, pos: usize, v: u64) -> usize {
    var ziffern: [u8; 24] = [0 as u8; 24]
    var n: usize = 0 as usize
    var x: u64 = v
    if x == 0 as u64 {
        ziffern[0] = 48 as u8
        n = 1 as usize
    }
    while x > 0 as u64 {
        ziffern[n] = (x % 10 as u64) as u8 + 48 as u8
        x = x / 10 as u64
        n = n + 1 as usize
    }
    var i: usize = 0 as usize
    var p: usize = pos
    while i < n {
        *((buf as usize + p) as *mut u8) = ziffern[n - 1 as usize - i]
        p = p + 1 as usize
        i = i + 1 as usize
    }
    *((buf as usize + p) as *mut u8) = 32 as u8
    return p + 1 as usize
}

fn main() -> i32 {
    var h: RcHeap = heap_leer()
    if rc_heap_init(&h, 262144 as usize) == false { return 90 }

    var runden: i64 = 0
    var reihenfolge_ok: u64 = 1 as u64
    var hoechst: usize = 0 as usize
    while runden < 20000 {
        var s: Zaehlverweis[Stil] = rc_leer[Stil]()
        let ok1: bool = rc_neu[Stil](&h,
            Stil{ farbe: runden as u32, groesse: 8 as u32, zeilen: runden }, &s) catch false
        if ok1 == false { return 1 }
        var z: Zaehlverweis[i64] = rc_leer[i64]()
        let ok2: bool = rc_neu[i64](&h, runden * 7, &z) catch false
        if ok2 == false { return 2 }
        var byte: Zaehlverweis[u8] = rc_leer[u8]()
        let ok3: bool = rc_neu[u8](&h, (runden % 251) as u8, &byte) catch false
        if ok3 == false { return 3 }

        // Klone und schwache Verweise wie im echten Gebrauch.
        var s2: Zaehlverweis[Stil] = rc_klonen[Stil](s)
        var w: Schwachverweis[Stil] = weak_von[Stil](s)
        var s3: Zaehlverweis[Stil] = aufwerten[Stil](w)
        if rc_stark_zahl[Stil](s) != 3 as u64 { reihenfolge_ok = 0 as u64 }
        if rc_lesen[Stil](s3).zeilen != runden { reihenfolge_ok = 0 as u64 }
        if rc_lesen[i64](z) != runden * 7 { reihenfolge_ok = 0 as u64 }
        if rc_lesen[u8](byte) != (runden % 251) as u8 { reihenfolge_ok = 0 as u64 }

        rc_freigeben[Stil](&h, &s3)
        rc_freigeben[Stil](&h, &s2)
        rc_freigeben[Stil](&h, &s)
        // Jetzt ist der Wert tot, der Block haengt noch am schwachen Verweis.
        if rc_ist_leer[Stil](aufwerten[Stil](w)) == false { reihenfolge_ok = 0 as u64 }
        weak_freigeben[Stil](&h, &w)
        rc_freigeben[i64](&h, &z)
        rc_freigeben[u8](&h, &byte)

        if h.naechster > hoechst { hoechst = h.naechster }
        if rc_heap_lebende(&h) != 0 as usize { return 4 }
        runden = runden + 1
    }

    var aus: [u8; 128] = [0 as u8; 128]
    var p: usize = 0 as usize
    p = print_zahl(&aus[0], p, runden as u64)
    p = print_zahl(&aus[0], p, rc_heap_lebende(&h) as u64)
    p = print_zahl(&aus[0], p, rc_heap_belegte_bytes(&h) as u64)
    p = print_zahl(&aus[0], p, hoechst as u64)
    p = print_zahl(&aus[0], p, reihenfolge_ok)
    aus[p - 1 as usize] = 10 as u8
    syscall(1, 1, &aus[0], p as i64)

    rc_heap_frei(&h)
    return 0
}
