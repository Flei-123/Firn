// expect_out: 1 1 2 128 200 12800 198 1 0

// PFLICHTNACHWEIS zu SPEC §3.4: ein Rc-ZYKLUS LECKT. Das ist kein Fehler
// dieser Umsetzung, sondern die dokumentierte Eigenschaft der Zaehlung — und
// genau der Grund, warum 'Rc' fuer den DOM ausdruecklich NICHT vorgesehen ist
// (siehe docs/RC.md). Der Test macht das Leck SICHTBAR statt es zu verstecken.
//
// Aufbau: zwei Zellen a und b, die einander stark halten.
// 'Rc' ist immer unveraenderlich (kein RefCell-Aequivalent), deshalb kann der
// Rueckverweis nicht ueber die Rc-Schnittstelle nachgetragen werden — der Test
// benutzt dafuer den Rohzeiger aus SPEC §3.6 (rc_wert_adresse). Genau das
// wuerde eine Innenveraenderlichkeit tun; mit ihr waere derselbe Zyklus mit
// gewoehnlichem Anwendungscode erreichbar.
//
// Ausgabe (eine Zeile):
//   stark_a stark_b lebende belegt   nach dem Verwerfen EINES Zyklus
//   lebende100 belegt100                nach 100 angelegten+verworfenen Zyklen
//   lebende_nach_handaufloesung
//   aufwerten_leer  lebende_weak_variante

struct Zelle { partner: usize, kennung: i64 }

fn heap_leer() -> RcHeap {
    return RcHeap{
        basis: 0 as usize, kapazitaet: 0 as usize, naechster: 0 as usize,
        frei: [0 as usize, 0 as usize, 0 as usize, 0 as usize,
               0 as usize, 0 as usize, 0 as usize, 0 as usize],
        lebende: 0 as usize, belegt: 0 as usize,
        allokationen: 0 as usize, freigaben: 0 as usize,
    }
}

fn neue_zelle(h: *mut RcHeap, k: i64, aus: *mut Zaehlverweis[Zelle]) -> bool {
    return rc_neu[Zelle](h, Zelle{ partner: 0 as usize, kennung: k }, aus) catch false
}

// Traegt den Partner in eine bereits angelegte Zelle nach. Rohzugriff
// (SPEC §3.6) — ueber 'Rc' selbst ist Schreiben nicht moeglich, siehe
// tests/neg/rc_unveraenderlich.fi.
fn partner_setzen(r: Zaehlverweis[Zelle], partner_block: usize) {
    let adr: usize = rc_wert_adresse[Zelle](r)
    *(adr as *mut usize) = partner_block
}

// Legt einen echten Zyklus a -> b -> a an und verwirft beide aeusseren
// Griffe. Was bleibt, sind die beiden Verweise IN den Zellen: die Zaehler
// fallen nie auf 0.
fn zyklus_anlegen_und_verwerfen(h: *mut RcHeap) -> bool {
    var a: Zaehlverweis[Zelle] = rc_leer[Zelle]()
    var b: Zaehlverweis[Zelle] = rc_leer[Zelle]()
    if neue_zelle(h, 1, &a) == false { return false }
    if neue_zelle(h, 2, &b) == false { return false }
    // a haelt b stark, b haelt a stark.
    var a_in_b: Zaehlverweis[Zelle] = rc_klonen[Zelle](a)
    var b_in_a: Zaehlverweis[Zelle] = rc_klonen[Zelle](b)
    partner_setzen(a, rc_roh_adresse[Zelle](b_in_a))
    partner_setzen(b, rc_roh_adresse[Zelle](a_in_b))
    // Die aeusseren Griffe verschwinden (im echten Programm: Blockende).
    rc_freigeben[Zelle](h, &a)
    rc_freigeben[Zelle](h, &b)
    return true
}

fn print_zahl(buf: *mut u8, pos: usize, v: u64) -> usize {
    var ziffern: [u8; 24] = [0 as u8; 24]
    var n: usize = 0 as usize
    var x: u64 = v
    if x == 0 as u64 {
        ziffern[0] = 48 as u8
        n = 1 as usize
    }
    while x > 0 as u64 {
        ziffern[n] = (x % 10 as u64) as u8 + 48 as u8
        x = x / 10 as u64
        n = n + 1 as usize
    }
    var i: usize = 0 as usize
    var p: usize = pos
    while i < n {
        *((buf as usize + p) as *mut u8) = ziffern[n - 1 as usize - i]
        p = p + 1 as usize
        i = i + 1 as usize
    }
    *((buf as usize + p) as *mut u8) = 32 as u8
    return p + 1 as usize
}

fn main() -> i32 {
    var h: RcHeap = heap_leer()
    if rc_heap_init(&h, 1048576 as usize) == false { return 90 }

    // --- Teil 1: EIN Zyklus, beide Zaehler bleiben bei 1 -------------------
    var a: Zaehlverweis[Zelle] = rc_leer[Zelle]()
    var b: Zaehlverweis[Zelle] = rc_leer[Zelle]()
    if neue_zelle(&h, 1, &a) == false { return 91 }
    if neue_zelle(&h, 2, &b) == false { return 92 }
    var a_in_b: Zaehlverweis[Zelle] = rc_klonen[Zelle](a)
    var b_in_a: Zaehlverweis[Zelle] = rc_klonen[Zelle](b)
    let adr_a: usize = rc_roh_adresse[Zelle](a)
    let adr_b: usize = rc_roh_adresse[Zelle](b)
    partner_setzen(a, adr_b)
    partner_setzen(b, adr_a)
    rc_freigeben[Zelle](&h, &a)
    rc_freigeben[Zelle](&h, &b)
    // Beide Zaehler stehen weiter auf 1 — der Zyklus haelt sich selbst.
    let stark_a: u64 = rc_ld64(adr_a + 0 as usize)
    let stark_b: u64 = rc_ld64(adr_b + 0 as usize)
    let lebende1: usize = rc_heap_lebende(&h)
    let belegt1: usize = rc_heap_belegte_bytes(&h)

    // --- Teil 2: 100 Zyklen anlegen und verwerfen -> der Verbrauch waechst
    var i: i64 = 0
    while i < 99 {
        if zyklus_anlegen_und_verwerfen(&h) == false { return 93 }
        i = i + 1
    }
    let lebende100: usize = rc_heap_lebende(&h)
    let belegt100: usize = rc_heap_belegte_bytes(&h)

    // --- Teil 3: von Hand aufloesen (nur so kommt der Speicher zurueck) ---
    // Stufe 0 kennt keine Destruktoren; die in den Zellen gespeicherten
    // Verweise muessen einzeln geloest werden. Fuer die 99 Zyklen aus Teil 2
    // ist die Adresse nicht mehr bekannt — genau das ist das Leck. Aufgeloest
    // wird deshalb nur der erste Zyklus, dessen Adressen wir noch haben.
    var innen_a: Zaehlverweis[Zelle] = rc_roh_verweis[Zelle](adr_a)
    var innen_b: Zaehlverweis[Zelle] = rc_roh_verweis[Zelle](adr_b)
    rc_freigeben[Zelle](&h, &innen_a)
    rc_freigeben[Zelle](&h, &innen_b)
    let lebende_hand: usize = rc_heap_lebende(&h)

    // --- Teil 4: derselbe Aufbau mit Weak leckt NICHT ---------------------
    var h2: RcHeap = heap_leer()
    if rc_heap_init(&h2, 65536 as usize) == false { return 94 }
    var x: Zaehlverweis[Zelle] = rc_leer[Zelle]()
    var y: Zaehlverweis[Zelle] = rc_leer[Zelle]()
    if neue_zelle(&h2, 3, &x) == false { return 95 }
    if neue_zelle(&h2, 4, &y) == false { return 96 }
    // y haelt x nur SCHWACH, x haelt y stark -> kein Zyklus aus starken Verweisen.
    var w: Schwachverweis[Zelle] = weak_von[Zelle](x)
    var y_in_x: Zaehlverweis[Zelle] = rc_klonen[Zelle](y)
    partner_setzen(x, rc_roh_adresse[Zelle](y_in_x))
    partner_setzen(y, weak_roh_adresse[Zelle](w))
    let adr_y: usize = rc_roh_adresse[Zelle](y)
    rc_freigeben[Zelle](&h2, &y)
    rc_freigeben[Zelle](&h2, &x)
    // x ist tot: die Aufwertung des schwachen Verweises liefert sichtbar leer.
    var auf: Zaehlverweis[Zelle] = aufwerten[Zelle](w)
    var leer: u64 = 0 as u64
    if rc_ist_leer[Zelle](auf) {
        leer = 1 as u64
    }
    // Den inneren starken Verweis von x auf y von Hand loesen (kein 'drop').
    var innen_y: Zaehlverweis[Zelle] = rc_roh_verweis[Zelle](adr_y)
    rc_freigeben[Zelle](&h2, &innen_y)
    weak_freigeben[Zelle](&h2, &w)
    let lebende_weak: usize = rc_heap_lebende(&h2)

    var aus: [u8; 128] = [0 as u8; 128]
    var p: usize = 0 as usize
    p = print_zahl(&aus[0], p, stark_a)
    p = print_zahl(&aus[0], p, stark_b)
    p = print_zahl(&aus[0], p, lebende1 as u64)
    p = print_zahl(&aus[0], p, belegt1 as u64)
    p = print_zahl(&aus[0], p, lebende100 as u64)
    p = print_zahl(&aus[0], p, belegt100 as u64)
    p = print_zahl(&aus[0], p, lebende_hand as u64)
    p = print_zahl(&aus[0], p, leer)
    p = print_zahl(&aus[0], p, lebende_weak as u64)
    aus[p - 1 as usize] = 10 as u8
    syscall(1, 1, &aus[0], p as i64)

    rc_heap_frei(&h)
    rc_heap_frei(&h2)
    return 0
}
