// expect_exit: 0

// Rc (SPEC §3.4, Anforderung S7): anlegen, lesen, klonen, freigeben.
// Die Zaehlung wird an jeder Stelle nachgeprueft; nach der letzten Freigabe
// kehrt der Block in die Freiliste zurueck (lebende Bloecke = 0) und wird
// wiederverwendet.

struct Stil { farbe: u32, groesse: u32, zeilen: i64 }

fn heap_leer() -> RcHeap {
    return RcHeap{
        basis: 0 as usize, kapazitaet: 0 as usize, naechster: 0 as usize,
        frei: [0 as usize, 0 as usize, 0 as usize, 0 as usize,
               0 as usize, 0 as usize, 0 as usize, 0 as usize],
        lebende: 0 as usize, belegt: 0 as usize,
        allokationen: 0 as usize, freigaben: 0 as usize,
    }
}

fn neuer_stil(h: *mut RcHeap, aus: *mut Zaehlverweis[Stil]) -> bool {
    let w: Stil = Stil{ farbe: 4278190080 as u32, groesse: 16 as u32, zeilen: 3 }
    return rc_neu[Stil](h, w, aus) catch false
}

fn main() -> i32 {
    var h: RcHeap = heap_leer()
    if rc_heap_init(&h, 65536 as usize) == false {
        return 90
    }

    var a: Zaehlverweis[Stil] = rc_leer[Stil]()
    if rc_ist_leer[Stil](a) == false { return 1 }
    if rc_stark_zahl[Stil](a) != 0 as u64 { return 2 }
    if neuer_stil(&h, &a) == false { return 3 }
    if rc_stark_zahl[Stil](a) != 1 as u64 { return 4 }
    if rc_ist_leer[Stil](a) { return 5 }

    let s: Stil = rc_lesen[Stil](a)
    if s.farbe != 4278190080 as u32 { return 6 }
    if s.groesse != 16 as u32 { return 7 }
    if s.zeilen != 3 { return 8 }

    var b: Zaehlverweis[Stil] = rc_klonen[Stil](a)
    var c: Zaehlverweis[Stil] = rc_klonen[Stil](b)
    if rc_stark_zahl[Stil](a) != 3 as u64 { return 9 }
    if rc_gleich[Stil](a, c) == false { return 10 }
    // Alle Klone sehen denselben Wert, es gibt nur EINEN Block.
    if rc_lesen[Stil](c).groesse != 16 as u32 { return 11 }
    if rc_heap_lebende(&h) != 1 as usize { return 12 }
    if rc_heap_belegte_bytes(&h) != 64 as usize { return 13 }

    rc_freigeben[Stil](&h, &c)
    if rc_ist_leer[Stil](c) == false { return 14 }
    if rc_stark_zahl[Stil](a) != 2 as u64 { return 15 }
    rc_freigeben[Stil](&h, &b)
    if rc_stark_zahl[Stil](a) != 1 as u64 { return 16 }
    if rc_heap_lebende(&h) != 1 as usize { return 17 }
    rc_freigeben[Stil](&h, &a)
    if rc_ist_leer[Stil](a) == false { return 18 }
    if rc_heap_lebende(&h) != 0 as usize { return 19 }
    if rc_heap_belegte_bytes(&h) != 0 as usize { return 20 }

    // Der freigegebene Block wird wiederverwendet — ohne neue Seiten.
    let ende_vorher: usize = h.naechster
    var d: Zaehlverweis[Stil] = rc_leer[Stil]()
    if neuer_stil(&h, &d) == false { return 21 }
    if h.naechster != ende_vorher { return 22 }
    if rc_heap_allokationen(&h) != 2 as usize { return 23 }
    if rc_heap_freigaben(&h) != 1 as usize { return 24 }
    rc_freigeben[Stil](&h, &d)

    // Zweite Auspraegung derselben Vorlage (Monomorphisierung).
    var z: Zaehlverweis[i64] = rc_leer[i64]()
    let ok2: bool = rc_neu[i64](&h, 123456789 as i64, &z) catch false
    if ok2 == false { return 25 }
    if rc_lesen[i64](z) != 123456789 as i64 { return 26 }
    var z2: Zaehlverweis[i64] = rc_klonen[i64](z)
    rc_freigeben[i64](&h, &z)
    // Der Wert lebt weiter, solange EIN starker Verweis besteht.
    if rc_lesen[i64](z2) != 123456789 as i64 { return 27 }
    if rc_stark_zahl[i64](z2) != 1 as u64 { return 28 }
    rc_freigeben[i64](&h, &z2)
    if rc_heap_lebende(&h) != 0 as usize { return 29 }

    // Freigabe eines leeren Verweises ist erlaubt und aendert nichts.
    rc_freigeben[i64](&h, &z2)
    if rc_heap_freigaben(&h) != 3 as usize { return 30 }

    rc_heap_frei(&h)
    if rc_heap_kapazitaet(&h) != 0 as usize { return 31 }
    return 0
}
