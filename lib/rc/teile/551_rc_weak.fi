// expect_exit: 0

// Weak (SPEC §3.4): der schwache Verweis haelt den Wert NICHT am Leben.
// 'aufwerten' liefert sichtbar den LEEREN Verweis, sobald der starke Zaehler
// auf 0 gefallen ist. Der Block wird erst frei, wenn auch der letzte schwache
// Verweis weg ist — bis dahin ist er gehalten, aber nicht mehr lesbar.

struct Knoten { kennung: i64, tiefe: i64 }

fn heap_leer() -> RcHeap {
    return RcHeap{
        basis: 0 as usize, kapazitaet: 0 as usize, naechster: 0 as usize,
        frei: [0 as usize, 0 as usize, 0 as usize, 0 as usize,
               0 as usize, 0 as usize, 0 as usize, 0 as usize],
        lebende: 0 as usize, belegt: 0 as usize,
        allokationen: 0 as usize, freigaben: 0 as usize,
    }
}

fn neuer_knoten(h: *mut RcHeap, k: i64, aus: *mut Zaehlverweis[Knoten]) -> bool {
    return rc_neu[Knoten](h, Knoten{ kennung: k, tiefe: 0 }, aus) catch false
}

fn main() -> i32 {
    var h: RcHeap = heap_leer()
    if rc_heap_init(&h, 65536 as usize) == false { return 90 }

    var a: Zaehlverweis[Knoten] = rc_leer[Knoten]()
    if neuer_knoten(&h, 7, &a) == false { return 1 }

    var w: Schwachverweis[Knoten] = weak_von[Knoten](a)
    if weak_ist_leer[Knoten](w) { return 2 }
    if rc_stark_zahl[Knoten](a) != 1 as u64 { return 3 }
    if rc_schwach_zahl[Knoten](a) != 1 as u64 { return 4 }

    // Aufwertung bei lebendem Ziel: starker Verweis, Zaehler steigt.
    var b: Zaehlverweis[Knoten] = aufwerten[Knoten](w)
    if rc_ist_leer[Knoten](b) { return 5 }
    if rc_stark_zahl[Knoten](a) != 2 as u64 { return 6 }
    if rc_lesen[Knoten](b).kennung != 7 { return 7 }
    rc_freigeben[Knoten](&h, &b)
    if rc_stark_zahl[Knoten](a) != 1 as u64 { return 8 }

    // Letzten starken Verweis loesen: der Wert ist tot, der Block wird aber
    // noch vom schwachen Verweis gehalten (lebende bleibt 1).
    rc_freigeben[Knoten](&h, &a)
    if weak_stark_zahl[Knoten](w) != 0 as u64 { return 9 }
    if rc_heap_lebende(&h) != 1 as usize { return 10 }

    // Sichtbar leer — genau das ist der Zweck von Weak.
    var c: Zaehlverweis[Knoten] = aufwerten[Knoten](w)
    if rc_ist_leer[Knoten](c) == false { return 11 }
    if rc_stark_zahl[Knoten](c) != 0 as u64 { return 12 }

    // Erst der letzte schwache Verweis gibt den Block frei.
    weak_freigeben[Knoten](&h, &w)
    if weak_ist_leer[Knoten](w) == false { return 13 }
    if rc_heap_lebende(&h) != 0 as usize { return 14 }
    if rc_heap_belegte_bytes(&h) != 0 as usize { return 15 }

    // Umgekehrte Reihenfolge: schwacher Verweis zuerst weg.
    var d: Zaehlverweis[Knoten] = rc_leer[Knoten]()
    if neuer_knoten(&h, 9, &d) == false { return 16 }
    var w2: Schwachverweis[Knoten] = weak_von[Knoten](d)
    var w3: Schwachverweis[Knoten] = weak_von[Knoten](d)
    if rc_schwach_zahl[Knoten](d) != 2 as u64 { return 17 }
    weak_freigeben[Knoten](&h, &w2)
    if rc_schwach_zahl[Knoten](d) != 1 as u64 { return 18 }
    if rc_heap_lebende(&h) != 1 as usize { return 19 }
    weak_freigeben[Knoten](&h, &w3)
    if rc_heap_lebende(&h) != 1 as usize { return 20 }
    rc_freigeben[Knoten](&h, &d)
    if rc_heap_lebende(&h) != 0 as usize { return 21 }

    // Weak auf einen leeren Verweis bleibt leer, Aufwertung ebenfalls.
    var e: Zaehlverweis[Knoten] = rc_leer[Knoten]()
    var w4: Schwachverweis[Knoten] = weak_von[Knoten](e)
    if weak_ist_leer[Knoten](w4) == false { return 22 }
    if rc_ist_leer[Knoten](aufwerten[Knoten](w4)) == false { return 23 }
    weak_freigeben[Knoten](&h, &w4)

    rc_heap_frei(&h)
    return 0
}
