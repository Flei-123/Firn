// Module 'arc' -- `Arc[T]` from SPEC 3.4: shared ownership with an ATOMIC
// counter. Round 47.
//
// `Rc[T]` (lib/rc/rc.fi) and `Arc[T]` are deliberately SEPARATE types:
// single threaded code should not pay for the atomic counter (SPEC 3.4).
// The difference sits at exactly four places -- incrementing and
// decrementing the strong and the weak counter -- and it is real: there
// stands `__atomic_add`, and in the assembler that is a `lock xadd`
// (compiler/src/atomic.rs, proof in tools/atomic/run.sh).
//
// Use from tests/:  the file is inserted VERBATIM
//                   (lib/rc/gen_tests.sh, as with rc.fi)
//
// ------------------------------------------------------------------ HONEST
//
// E1  THE COUNTER IS THREAD SAFE -- AND SINCE ROUND 49 SO IS THE UPGRADE.
//     `arc_clone` and `arc_free` are correct with `lock xadd`, even when
//     several threads access them at the same time: only the thread that
//     sees the 1 while decrementing releases -- which is why a double
//     release can NEVER happen. `promote_atomic` (weak -> strong) needed a
//     compare and swap; round 47 did not have one and named the gap
//     (docs/ROUND47.md 3.2). Since round 49 there is
//     `__atomic_swap` (lock cmpxchg), and the upgrade increments only
//     while the counter is not 0. The proof with many threads on
//     THE SAME structure: tests/834_arc_thread.fi.
//
//     WHAT IS STILL NOT PROMISED: the VALUE behind the reference is
//     immutable (E4), but `Arc[T]` does not make it readable in a thread
//     safe way if it itself contains pointers to mutable memory.
//     And the Arc heap (`arc_new`/`arc_free` as memory management)
//     has NO lock of its own: whoever allocates from several threads locks
//     by hand (thread_lock).
//
// E2  CYCLES LEAK, exactly as with `Rc`. Two `Arc` that hold each other
//     never become free -- made visible in tests/832_arc_cycle_leak.fi.
//     Whoever has cycles takes `AtomWeakRef` (breaks it by hand) or `Gc[T]`
//     (dissolves it, SPEC 3.5).
//
// E3  THE INTERPLAY WITH THE TRACING GC (the point of this round):
//       * The Arc heap is an mmap area of its own. The collector does NOT
//         know it -- it finds blocks only in its own chunks.
//       * From that it follows: a `Gc[T]` inside the VALUE of an `Arc` is
//         invisible to the collector and its target gets collected although
//         it is still in use. That is no special case, that is the rule for
//         ANY memory outside the GC heap.
//       * That is why round 47 brought `gc_root_register(p, bytes)`:
//         whoever puts a `Gc[T]` into an `Arc` registers its value area as
//         an external root (`arc_value_address` + `arc_size_of`) and
//         unregisters it on release. Proof in tests/833_arc_gc_root.fi --
//         WITH and WITHOUT. NO DOUBLE RELEASE, and for a structural reason:
//         the counter decides exclusively about the ARC BLOCK (which goes
//         into the free list of the Arc heap), the collector exclusively
//         about GC OBJECTS (it knows only its own chunks). The two memory
//         areas do not overlap, so neither can release what belongs to the
//         other.
//
// E4  `Arc` is, like `Rc`, ALWAYS IMMUTABLE (SPEC 3.4). `arc_read` returns
//     a copy; there is no writing function in this module.
//
// E5  As in rc.fi: stage 0 has no methods (`Arc[T].new` is `arc_new`), no
//     `inout` (the heap is a `*mut ArcHeap`), and the success value comes
//     through an output pointer, because the monomorphization does not
//     substitute type arguments inside the payload of an error union.
//     The allocation stays fallible (DESIGN_GOALS 2) and the result is
//     `#[must_consume]`.

export {
    AllocError, ArcHeap, AtomicRef, AtomWeakRef,
    arc_heap_init, arc_heap_free, arc_heap_capacity, arc_heap_live,
    arc_heap_used_bytes, arc_heap_allocations, arc_heap_releases,
    arc_size_of, arc_ld64, arc_st64,
    arc_new, arc_empty, arc_is_empty, arc_read, arc_clone, arc_free,
    arc_strong_number, arc_weak_number, arc_equal,
    arc_raw_address, arc_value_address, arc_raw_ref,
    aweak_of, aweak_empty, aweak_is_empty, promote_atomic, aweak_free,
    aweak_strong_number, aweak_raw_address
}

error AllocError { OutOfMemory }

const ARC_SYS_MMAP: i64 = 9
const ARC_SYS_MUNMAP: i64 = 11
const ARC_PROT_READ_WRITE: i64 = 3
const ARC_MAP_PRIVATE_ANON: i64 = 34

// The two's complement of 1: decrementing is adding it. A primitive of its
// own for the subtraction would be ballast (compiler/src/atomic.rs).
const ARC_MINUS1: u64 = 18446744073709551615

// The block header: 32 bytes, the value behind it.
//   +0   strong    u64   strong references    (ATOMIC)
//   +8   weak      u64   weak references      (ATOMIC)
//   +16  class     u64   size class
//   +24  next      u64   free list chaining (only while free)
//   +32  value     T
const ARC_HEADER: usize = 32
const ARC_CLASSES: usize = 8
const ARC_CLASS0: usize = 64

// `Arc[T]` from SPEC 3.4. 'block' is 0 when the reference is empty.
struct AtomicRef[T] { block: usize }

// A `Weak[T]` to an `Arc[T]` -- it does NOT keep the value alive.
struct AtomWeakRef[T] { block: usize }

struct ArcHeap {
    base: usize,
    capacity: usize,
    next: usize,
    free: [usize; 8],
    live: usize,
    used: usize,
    allocations: usize,
    releases: usize,
}

struct ArcPair[T] { a: T, b: T }

fn arc_pages(n: usize) -> usize {
    return (n + 4095 as usize) / 4096 as usize * 4096 as usize
}

fn arc_ld64(addr: usize) -> u64 {
    return *(addr as *mut u64)
}

fn arc_st64(addr: usize, v: u64) {
    *(addr as *mut u64) = v
}

// The step width (the size including alignment) of the type T.
fn arc_size_of[T: Any](pattern: T) -> usize {
    var p: ArcPair[T] = ArcPair[T] { a: pattern, b: pattern }
    return (&p.b) as usize - (&p.a) as usize
}

fn arc_class_bytes(k: usize) -> usize {
    var b: usize = ARC_CLASS0
    var i: usize = 0 as usize
    while i < k {
        b = b * 2 as usize
        i = i + 1 as usize
    }
    return b
}

fn arc_class_for(total: usize) -> usize {
    var k: usize = 0 as usize
    while k < ARC_CLASSES {
        if total <= arc_class_bytes(k) {
            return k
        }
        k = k + 1 as usize
    }
    return ARC_CLASSES
}

fn arc_heap_init(h: *mut ArcHeap, bytes: usize) -> bool {
    (*h).base = 0 as usize
    (*h).capacity = 0 as usize
    (*h).next = 0 as usize
    (*h).live = 0 as usize
    (*h).used = 0 as usize
    (*h).allocations = 0 as usize
    (*h).releases = 0 as usize
    var i: usize = 0 as usize
    while i < ARC_CLASSES {
        (*h).free[i] = 0 as usize
        i = i + 1 as usize
    }
    if bytes == 0 as usize {
        return false
    }
    let len: usize = arc_pages(bytes)
    let r: i64 = syscall(ARC_SYS_MMAP, 0, len as i64, ARC_PROT_READ_WRITE,
        ARC_MAP_PRIVATE_ANON, 0 - 1, 0)
    if r < 0 && r > 0 - 4096 {
        return false
    }
    if r == 0 {
        return false
    }
    (*h).base = r as usize
    (*h).capacity = len
    return true
}

fn arc_heap_free(h: *mut ArcHeap) {
    if (*h).base != 0 as usize {
        syscall(ARC_SYS_MUNMAP, (*h).base as i64, (*h).capacity as i64)
    }
    (*h).base = 0 as usize
    (*h).capacity = 0 as usize
    (*h).next = 0 as usize
}

fn arc_heap_capacity(h: *mut ArcHeap) -> usize { return (*h).capacity }
fn arc_heap_live(h: *mut ArcHeap) -> usize { return (*h).live }
fn arc_heap_used_bytes(h: *mut ArcHeap) -> usize { return (*h).used }
fn arc_heap_allocations(h: *mut ArcHeap) -> usize { return (*h).allocations }
fn arc_heap_releases(h: *mut ArcHeap) -> usize { return (*h).releases }

fn arc_block_get(h: *mut ArcHeap, payload: usize) -> usize {
    let k: usize = arc_class_for(ARC_HEADER + payload)
    if k >= ARC_CLASSES {
        return 0 as usize
    }
    let gr: usize = arc_class_bytes(k)
    var addr: usize = (*h).free[k]
    if addr != 0 as usize {
        (*h).free[k] = arc_ld64(addr + 24 as usize) as usize
    } else {
        if (*h).base == 0 as usize {
            return 0 as usize
        }
        if (*h).next + gr > (*h).capacity {
            return 0 as usize
        }
        addr = (*h).base + (*h).next
        (*h).next = (*h).next + gr
    }
    arc_st64(addr + 0 as usize, 0 as u64)
    arc_st64(addr + 8 as usize, 0 as u64)
    arc_st64(addr + 16 as usize, k as u64)
    arc_st64(addr + 24 as usize, 0 as u64)
    (*h).live = (*h).live + 1 as usize
    (*h).used = (*h).used + gr
    (*h).allocations = (*h).allocations + 1 as usize
    return addr
}

fn arc_block_back(h: *mut ArcHeap, addr: usize) {
    let k: usize = arc_ld64(addr + 16 as usize) as usize
    if k >= ARC_CLASSES {
        return
    }
    arc_st64(addr + 24 as usize, (*h).free[k] as u64)
    (*h).free[k] = addr
    (*h).live = (*h).live - 1 as usize
    (*h).used = (*h).used - arc_class_bytes(k)
    (*h).releases = (*h).releases + 1 as usize
}

// Puts 'value' on the heap and returns a strong reference in '*out'.
// FALLIBLE (DESIGN_GOALS 2); the result is '#[must_consume]'.
fn arc_new[T: Any](h: *mut ArcHeap, value: T, out: *mut AtomicRef[T]) -> AllocError!bool {
    (*out).block = 0 as usize
    let gr: usize = arc_size_of[T](value)
    let addr: usize = arc_block_get(h, gr)
    if addr == 0 as usize {
        return AllocError::OutOfMemory
    }
    arc_st64(addr + 0 as usize, 1 as u64)
    arc_st64(addr + 8 as usize, 0 as u64)
    *((addr + ARC_HEADER) as *mut T) = value
    (*out).block = addr
    return true
}

fn arc_empty[T: Any]() -> AtomicRef[T] {
    return AtomicRef[T] { block: 0 as usize }
}

fn arc_is_empty[T: Any](r: AtomicRef[T]) -> bool {
    return r.block == 0 as usize
}

// READING ONLY (SPEC 3.4): what comes back is a copy.
fn arc_read[T: Any](r: AtomicRef[T]) -> T {
    return *((r.block + ARC_HEADER) as *mut T)
}

// ATOMIC: `lock xadd`. Two threads cloning at the same time cannot lose an
// increment.
fn arc_clone[T: Any](r: AtomicRef[T]) -> AtomicRef[T] {
    if r.block == 0 as usize {
        return AtomicRef[T] { block: 0 as usize }
    }
    __atomic_add(r.block as *mut u64, 1)
    return AtomicRef[T] { block: r.block }
}

// Decrement ATOMICALLY. NO DOUBLE RELEASE: the release is done only by the
// call that SEES the old value 1 while decrementing -- and exactly one call
// sees it, because `lock xadd` returns the old value indivisibly.
fn arc_free[T: Any](h: *mut ArcHeap, r: *mut AtomicRef[T]) {
    let addr: usize = (*r).block
    if addr == 0 as usize {
        return
    }
    (*r).block = 0 as usize
    let old: u64 = __atomic_add(addr as *mut u64, ARC_MINUS1)
    if old == 0 as u64 {
        // It was already 0 -- the decrement was a mistake of the caller.
        // Put it straight again instead of letting it underflow quietly.
        __atomic_add(addr as *mut u64, 1)
        return
    }
    if old != 1 as u64 {
        return
    }
    if arc_ld64(addr + 8 as usize) == 0 as u64 {
        arc_block_back(h, addr)
    }
}

fn arc_strong_number[T: Any](r: AtomicRef[T]) -> u64 {
    if r.block == 0 as usize {
        return 0 as u64
    }
    return arc_ld64(r.block + 0 as usize)
}

fn arc_weak_number[T: Any](r: AtomicRef[T]) -> u64 {
    if r.block == 0 as usize {
        return 0 as u64
    }
    return arc_ld64(r.block + 8 as usize)
}

fn arc_equal[T: Any](a: AtomicRef[T], b: AtomicRef[T]) -> bool {
    return a.block == b.block
}

// Raw access (SPEC 3.6). `arc_value_address` is at the same time the address
// you report to the collector as an external root when a `Gc[T]` sits inside
// the value (see E3 above and tests/833_arc_gc_root.fi).
fn arc_raw_address[T: Any](r: AtomicRef[T]) -> usize { return r.block }

fn arc_raw_ref[T: Any](addr: usize) -> AtomicRef[T] {
    return AtomicRef[T] { block: addr }
}

fn arc_value_address[T: Any](r: AtomicRef[T]) -> usize {
    if r.block == 0 as usize {
        return 0 as usize
    }
    return r.block + ARC_HEADER
}

fn aweak_of[T: Any](r: AtomicRef[T]) -> AtomWeakRef[T] {
    if r.block == 0 as usize {
        return AtomWeakRef[T] { block: 0 as usize }
    }
    __atomic_add((r.block + 8 as usize) as *mut u64, 1)
    return AtomWeakRef[T] { block: r.block }
}

fn aweak_empty[T: Any]() -> AtomWeakRef[T] {
    return AtomWeakRef[T] { block: 0 as usize }
}

fn aweak_is_empty[T: Any](w: AtomWeakRef[T]) -> bool {
    return w.block == 0 as usize
}

fn aweak_raw_address[T: Any](w: AtomWeakRef[T]) -> usize { return w.block }

fn aweak_strong_number[T: Any](w: AtomWeakRef[T]) -> u64 {
    if w.block == 0 as usize {
        return 0 as u64
    }
    return arc_ld64(w.block + 0 as usize)
}

// The upgrade: an empty reference when the strong counter is already 0.
//
// ROUND 49 -- NOW WITH A COMPARE AND SWAP, AND THEREBY REALLY THREAD SAFE.
//
// Round 47 incremented here and took the increment back if the old value
// was 0. That does NOT close the race: between the increment and the taking
// back, another thread can see the counter, believe it to be alive and use
// the block that is being released right then. Exactly this gap stands as
// an open point in docs/ROUND47.md 3.2.
//
// The classic conclusion (Rust's `Weak::upgrade`) needs a compare and swap,
// and that has existed since this round (`__atomic_swap`,
// compiler/src/thread.rs). The loop increments ONLY while the counter is not
// 0 -- and if it is 0, the last strong reference was gone and stays gone.
// The counter never goes back from 0 to 1: `arc_free` releases the block as
// soon as it SEES the 1, and exactly one call sees it.
fn promote_atomic[T: Any](w: AtomWeakRef[T]) -> AtomicRef[T] {
    if w.block == 0 as usize {
        return AtomicRef[T] { block: 0 as usize }
    }
    let p: *mut u64 = w.block as *mut u64
    var n: u64 = arc_ld64(w.block + 0 as usize)
    var done: bool = false
    while !done {
        if n == 0 as u64 {
            return AtomicRef[T] { block: 0 as usize }
        }
        let g: u64 = __atomic_swap(p, n, n + 1 as u64)
        if g == n {
            done = true
        } else {
            n = g
        }
    }
    return AtomicRef[T] { block: w.block }
}

fn aweak_free[T: Any](h: *mut ArcHeap, w: *mut AtomWeakRef[T]) {
    let addr: usize = (*w).block
    if addr == 0 as usize {
        return
    }
    (*w).block = 0 as usize
    let old: u64 = __atomic_add((addr + 8 as usize) as *mut u64, ARC_MINUS1)
    if old == 0 as u64 {
        __atomic_add((addr + 8 as usize) as *mut u64, 1)
        return
    }
    if old != 1 as u64 {
        return
    }
    if arc_ld64(addr + 0 as usize) == 0 as u64 {
        arc_block_back(h, addr)
    }
}
