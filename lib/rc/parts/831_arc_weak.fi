// expect_exit: 0

// ROUND 47 -- weak references to an `Arc[T]` (SPEC 3.4 `Weak[T]`).
//
// What is checked:
//   * a weak reference does NOT keep the value alive
//   * after the death `promote_atomic` visibly returns the EMPTY reference
//   * the block becomes free only when BOTH counters are 0 -- and then
//     exactly ONCE (no double release over the two paths)
//   * the order does not matter: strong-then-weak and weak-then-strong
//     both yield exactly one release
//   * an upgraded reference keeps the value alive again

struct Node {
    value: u64,
    depth: u32,
}

fn main() -> i32 {
    var h: ArcHeap = ArcHeap {
        base: 0 as usize, capacity: 0 as usize, next: 0 as usize,
        free: [0 as usize; 8], live: 0 as usize, used: 0 as usize,
        allocations: 0 as usize, releases: 0 as usize
    }
    if !arc_heap_init(&h, 65536 as usize) {
        return 90
    }
    let rc: i32 = run(&h) catch 91
    arc_heap_free(&h)
    return rc
}

fn run(h: *mut ArcHeap) -> AllocError!i32 {
    // --- weak does not keep it alive -------------------------------------
    var a: AtomicRef[Node] = arc_empty[Node]()
    if !(try arc_new[Node](h, Node { value: 5 as u64, depth: 1 }, &a)) {
        return 1
    }
    var w: AtomWeakRef[Node] = aweak_of[Node](a)
    if aweak_is_empty[Node](w) {
        return 2
    }
    if arc_strong_number[Node](a) != 1 as u64 {
        return 3
    }
    if arc_weak_number[Node](a) != 1 as u64 {
        return 4
    }
    if aweak_strong_number[Node](w) != 1 as u64 {
        return 5
    }

    // Upgrade while it is alive.
    var s: AtomicRef[Node] = promote_atomic[Node](w)
    if arc_is_empty[Node](s) {
        return 6
    }
    if arc_read[Node](s).value != 5 as u64 {
        return 7
    }
    if arc_strong_number[Node](a) != 2 as u64 {
        return 8
    }
    arc_free[Node](h, &s)

    // The last strong reference goes: the VALUE is dead, the BLOCK stays,
    // because a weak reference still points at it.
    arc_free[Node](h, &a)
    if arc_heap_releases(h) != 0 as usize {
        return 9
    }
    if arc_heap_live(h) != 1 as usize {
        return 10
    }
    if aweak_strong_number[Node](w) != 0 as u64 {
        return 11
    }
    // The upgrade now visibly returns EMPTY.
    var dead: AtomicRef[Node] = promote_atomic[Node](w)
    if !arc_is_empty[Node](dead) {
        return 12
    }
    if aweak_strong_number[Node](w) != 0 as u64 {
        return 13
    }
    // Only now does the block become free -- exactly once.
    aweak_free[Node](h, &w)
    if arc_heap_releases(h) != 1 as usize {
        return 14
    }
    if arc_heap_live(h) != 0 as usize {
        return 15
    }
    aweak_free[Node](h, &w)
    if arc_heap_releases(h) != 1 as usize {
        return 16
    }

    // --- the other order: weak first -------------------------------------
    var b: AtomicRef[Node] = arc_empty[Node]()
    if !(try arc_new[Node](h, Node { value: 8 as u64, depth: 2 }, &b)) {
        return 17
    }
    var w2: AtomWeakRef[Node] = aweak_of[Node](b)
    var w3: AtomWeakRef[Node] = aweak_of[Node](b)
    if arc_weak_number[Node](b) != 2 as u64 {
        return 18
    }
    aweak_free[Node](h, &w2)
    aweak_free[Node](h, &w3)
    if arc_heap_releases(h) != 1 as usize {
        return 19
    }
    arc_free[Node](h, &b)
    if arc_heap_releases(h) != 2 as usize {
        return 20
    }
    if arc_heap_live(h) != 0 as usize {
        return 21
    }

    // --- endurance run over both paths -----------------------------------
    var round: u64 = 0
    while round < 10000 as u64 {
        var x: AtomicRef[Node] = arc_empty[Node]()
        if !(try arc_new[Node](h, Node { value: round, depth: 3 }, &x)) {
            return 22
        }
        var wx: AtomWeakRef[Node] = aweak_of[Node](x)
        var yx: AtomicRef[Node] = promote_atomic[Node](wx)
        if arc_is_empty[Node](yx) {
            return 23
        }
        arc_free[Node](h, &yx)
        arc_free[Node](h, &x)
        if !arc_is_empty[Node](promote_atomic[Node](wx)) {
            return 24
        }
        aweak_free[Node](h, &wx)
        round = round + 1 as u64
    }
    if arc_heap_live(h) != 0 as usize {
        return 25
    }
    if arc_heap_allocations(h) != arc_heap_releases(h) {
        return 26
    }
    return 0
}
