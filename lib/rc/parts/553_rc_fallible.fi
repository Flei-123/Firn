// expect_exit: 0

// Fehlbare Allokation (DESIGN_GOALS §2): 'rc_neu' liefert 'AllocError!bool'.
// Bei erschoepfter Halde kommt AllocError::OutOfMemory zurueck — kein
// stilles 0-Ergebnis, kein Absturz. Das Ergebnis ist '#[must_consume]';
// Verwerfen ist ein Compilerfehler (tests/neg/rc_discarded.fi).

struct Style { color: u32, size: u32, lines: i64 }
struct Huge { data: [u8; 9000] }

fn heap_empty() -> RcHeap {
    return RcHeap{
        base: 0 as usize, capacity: 0 as usize, next: 0 as usize,
        free: [0 as usize, 0 as usize, 0 as usize, 0 as usize,
               0 as usize, 0 as usize, 0 as usize, 0 as usize],
        live: 0 as usize, used: 0 as usize,
        allocations: 0 as usize, releases: 0 as usize,
    }
}

// true = Erfolg, false = AllocError::OutOfMemory (der Erfolgswert ist immer
// 'true', der Fehlerzweig wird hier bewusst auf 'false' abgebildet).
fn attempt(h: *mut RcHeap, out: *mut RefCount[Style]) -> bool {
    let w: Style = Style{ color: 1 as u32, size: 2 as u32, lines: 3 }
    return rc_new[Style](h, w, out) catch false
}

fn main() -> i32 {
    var h: RcHeap = heap_empty()

    // Kapazitaet 0: sichtbarer Fehlschlag, keine Halde.
    if rc_heap_init(&h, 0 as usize) { return 1 }
    if rc_heap_capacity(&h) != 0 as usize { return 2 }
    // Ohne Halde schlaegt jede Allokation fehl — und zwar sichtbar.
    var empty_v: RefCount[Style] = rc_empty[Style]()
    if attempt(&h, &empty_v) { return 3 }
    if rc_is_empty[Style](empty_v) == false { return 4 }

    // Eine Seite: 4096 / 64 = 64 Bloecke, danach ist Schluss.
    if rc_heap_init(&h, 4096 as usize) == false { return 90 }
    var holder: [usize; 64] = [0 as usize; 64]
    var n: i64 = 0
    var v: RefCount[Style] = rc_empty[Style]()
    while n < 200 {
        if attempt(&h, &v) == false {
            // Fehlerfall: der Ausgabeverweis bleibt leer.
            if rc_is_empty[Style](v) == false { return 5 }
            n = 0 - n
            break
        }
        holder[n as usize] = rc_raw_address[Style](v)
        n = n + 1
        if n >= 64 {
            // Sicherung: die 65. Allokation MUSS scheitern.
            if attempt(&h, &v) { return 6 }
            n = 0 - n
            break
        }
    }
    if n != 0 - 64 { return 7 }
    if rc_heap_live(&h) != 64 as usize { return 8 }

    // Nach einer Freigabe geht es wieder — der Block kommt aus der Freiliste.
    var back: RefCount[Style] = rc_raw_ref[Style](holder[0])
    rc_free[Style](&h, &back)
    if rc_heap_live(&h) != 63 as usize { return 9 }
    if attempt(&h, &v) == false { return 10 }
    if rc_heap_live(&h) != 64 as usize { return 11 }
    // Und danach ist wieder Schluss.
    if attempt(&h, &v) { return 12 }

    // Zu grosse Nutzlast: passt in keine Groessenklasse -> OutOfMemory,
    // auch wenn die Halde selbst gross genug waere.
    var h2: RcHeap = heap_empty()
    if rc_heap_init(&h2, 1048576 as usize) == false { return 91 }
    var big: RefCount[Huge] = rc_empty[Huge]()
    let ok: bool = rc_new[Huge](&h2, Huge{ data: [7 as u8; 9000] }, &big) catch false
    if ok { return 13 }
    if rc_is_empty[Huge](big) == false { return 14 }
    if rc_heap_live(&h2) != 0 as usize { return 15 }

    // 'try' in einer fehlbaren Funktion: die Fehlerunion wird durchgereicht.
    if chain(&h2) == false { return 16 }

    rc_heap_free(&h)
    rc_heap_free(&h2)
    return 0
}

// Zeigt den 'try'-Weg: der Fehler wandert nach oben, der Aufrufer entscheidet.
fn chain_inner(h: *mut RcHeap, out: *mut RefCount[Style]) -> AllocError!bool {
    let w: Style = Style{ color: 9 as u32, size: 9 as u32, lines: 9 }
    let ok: bool = try rc_new[Style](h, w, out)
    return ok
}

fn chain(h: *mut RcHeap) -> bool {
    var v: RefCount[Style] = rc_empty[Style]()
    let ok: bool = chain_inner(h, &v) catch false
    if ok == false { return false }
    if rc_read[Style](v).lines != 9 { return false }
    rc_free[Style](h, &v)
    return true
}
