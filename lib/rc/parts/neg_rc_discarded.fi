// expect_error: 393:5 das ergebnis darf nicht verworfen werden

// Fehlbare Allokation, ernst genommen: 'rc_neu' liefert 'AllocError!bool'
// und ist damit '#[must_consume]' (SPEC §5.1). Wer das Ergebnis wegwirft,
// bekommt einen Compilerfehler mit Zeile und Spalte.

struct Style { color: u32, size: u32, lines: i64 }

fn main() -> i32 {
    var h: RcHeap = RcHeap{
        base: 0 as usize, capacity: 0 as usize, next: 0 as usize,
        free: [0 as usize, 0 as usize, 0 as usize, 0 as usize,
               0 as usize, 0 as usize, 0 as usize, 0 as usize],
        live: 0 as usize, used: 0 as usize,
        allocations: 0 as usize, releases: 0 as usize,
    }
    if rc_heap_init(&h, 4096 as usize) == false { return 1 }
    var v: RefCount[Style] = rc_empty[Style]()
    rc_new[Style](&h, Style{ color: 1 as u32, size: 2 as u32, lines: 3 }, &v)
    return 0
}
