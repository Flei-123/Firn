// expect_error: 396:5 left side is not an assignable expression (variable, field, index or '*pointer')

// 'Rc' is ALWAYS immutable (SPEC 3.4): there is no RefCell equivalent and
// no writing function. 'rc_read' returns a copy; the attempt to change the
// shared value through it is a compile error -- and not a silent change to
// the copy.

struct Style { color: u32, size: u32, lines: i64 }

fn main() -> i32 {
    var h: RcHeap = RcHeap {
        base: 0 as usize, capacity: 0 as usize, next: 0 as usize,
        free: [0 as usize, 0 as usize, 0 as usize, 0 as usize,
            0 as usize, 0 as usize, 0 as usize, 0 as usize],
        live: 0 as usize, used: 0 as usize,
        allocations: 0 as usize, releases: 0 as usize,
    }
    if rc_heap_init(&h, 4096 as usize) == false { return 1 }
    var v: RefCount[Style] = rc_empty[Style]()
    let ok: bool = rc_new[Style](&h, Style { color: 1 as u32, size: 2 as u32, lines: 3 }, &v) catch false
    if ok == false { return 2 }
    rc_read[Style](v).color = 7 as u32
    return 0
}
