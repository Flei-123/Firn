// expect_exit: 0

// Rc (SPEC 3.4, requirement S7): create, read, clone, release.
// The counting is checked again at every step; after the last release the
// block returns into the free list (live blocks = 0) and gets
// reused.

struct Style { color: u32, size: u32, lines: i64 }

fn heap_empty() -> RcHeap {
    return RcHeap {
        base: 0 as usize, capacity: 0 as usize, next: 0 as usize,
        free: [0 as usize, 0 as usize, 0 as usize, 0 as usize,
            0 as usize, 0 as usize, 0 as usize, 0 as usize],
        live: 0 as usize, used: 0 as usize,
        allocations: 0 as usize, releases: 0 as usize,
    }
}

fn new_style(h: *mut RcHeap, out: *mut RefCount[Style]) -> bool {
    let w: Style = Style { color: 4278190080 as u32, size: 16 as u32, lines: 3 }
    return rc_new[Style](h, w, out) catch false
}

fn main() -> i32 {
    var h: RcHeap = heap_empty()
    if rc_heap_init(&h, 65536 as usize) == false {
        return 90
    }

    var a: RefCount[Style] = rc_empty[Style]()
    if rc_is_empty[Style](a) == false { return 1 }
    if rc_strong_number[Style](a) != 0 as u64 { return 2 }
    if new_style(&h, &a) == false { return 3 }
    if rc_strong_number[Style](a) != 1 as u64 { return 4 }
    if rc_is_empty[Style](a) { return 5 }

    let s: Style = rc_read[Style](a)
    if s.color != 4278190080 as u32 { return 6 }
    if s.size != 16 as u32 { return 7 }
    if s.lines != 3 { return 8 }

    var b: RefCount[Style] = rc_clone[Style](a)
    var c: RefCount[Style] = rc_clone[Style](b)
    if rc_strong_number[Style](a) != 3 as u64 { return 9 }
    if rc_equal[Style](a, c) == false { return 10 }
    // Every clone sees the same value, there is only ONE block.
    if rc_read[Style](c).size != 16 as u32 { return 11 }
    if rc_heap_live(&h) != 1 as usize { return 12 }
    if rc_heap_used_bytes(&h) != 64 as usize { return 13 }

    rc_free[Style](&h, &c)
    if rc_is_empty[Style](c) == false { return 14 }
    if rc_strong_number[Style](a) != 2 as u64 { return 15 }
    rc_free[Style](&h, &b)
    if rc_strong_number[Style](a) != 1 as u64 { return 16 }
    if rc_heap_live(&h) != 1 as usize { return 17 }
    rc_free[Style](&h, &a)
    if rc_is_empty[Style](a) == false { return 18 }
    if rc_heap_live(&h) != 0 as usize { return 19 }
    if rc_heap_used_bytes(&h) != 0 as usize { return 20 }

    // The released block is reused -- without new pages.
    let end_before: usize = h.next
    var d: RefCount[Style] = rc_empty[Style]()
    if new_style(&h, &d) == false { return 21 }
    if h.next != end_before { return 22 }
    if rc_heap_allocations(&h) != 2 as usize { return 23 }
    if rc_heap_releases(&h) != 1 as usize { return 24 }
    rc_free[Style](&h, &d)

    // A second instantiation of the same template (monomorphization).
    var z: RefCount[i64] = rc_empty[i64]()
    let ok2: bool = rc_new[i64](&h, 123456789 as i64, &z) catch false
    if ok2 == false { return 25 }
    if rc_read[i64](z) != 123456789 as i64 { return 26 }
    var z2: RefCount[i64] = rc_clone[i64](z)
    rc_free[i64](&h, &z)
    // The value lives on as long as ONE strong reference exists.
    if rc_read[i64](z2) != 123456789 as i64 { return 27 }
    if rc_strong_number[i64](z2) != 1 as u64 { return 28 }
    rc_free[i64](&h, &z2)
    if rc_heap_live(&h) != 0 as usize { return 29 }

    // Releasing an empty reference is allowed and changes nothing.
    rc_free[i64](&h, &z2)
    if rc_heap_releases(&h) != 3 as usize { return 30 }

    rc_heap_free(&h)
    if rc_heap_capacity(&h) != 0 as usize { return 31 }
    return 0
}
