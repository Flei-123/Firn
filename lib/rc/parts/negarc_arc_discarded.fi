// expect_error: 441:5 the result must not be discarded: the type 'AllocError!bool' is marked with #[must_consume]

// RUNDE 47 — auch bei `Arc[T]` ist die Allokation FEHLBAR und ihr Ergebnis
// '#[must_consume]' (DESIGN_GOALS §2, SPEC §5.1). Wer es wegwirft, bekommt
// einen Compilerfehler mit Zeile und Spalte — nicht ein stilles `null`.

struct Style { color: u32, size: u32, lines: i64 }

fn main() -> i32 {
    var h: ArcHeap = ArcHeap{
        base: 0 as usize, capacity: 0 as usize, next: 0 as usize,
        free: [0 as usize, 0 as usize, 0 as usize, 0 as usize,
               0 as usize, 0 as usize, 0 as usize, 0 as usize],
        live: 0 as usize, used: 0 as usize,
        allocations: 0 as usize, releases: 0 as usize,
    }
    if arc_heap_init(&h, 4096 as usize) == false { return 1 }
    var v: AtomicRef[Style] = arc_empty[Style]()
    arc_new[Style](&h, Style{ color: 1 as u32, size: 2 as u32, lines: 3 }, &v)
    return 0
}
