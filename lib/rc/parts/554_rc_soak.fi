// expect_out: 20000 0 0 192 1

// The counterpart to tests/552_rc_cycle_leak.fi: WITHOUT a cycle the
// counting does not leak. 20,000 rounds each create three values (three
// instantiations of the template) with clones and weak references and
// release them again. What is shown: live objects at the end 0, used bytes
// 0, and the heap does not grow beyond the pages fetched once (free lists
// are reused).
//
// The output: rounds live used next(high water mark) order_ok

struct Style { color: u32, size: u32, lines: i64 }

fn heap_empty() -> RcHeap {
    return RcHeap {
        base: 0 as usize, capacity: 0 as usize, next: 0 as usize,
        free: [0 as usize, 0 as usize, 0 as usize, 0 as usize,
            0 as usize, 0 as usize, 0 as usize, 0 as usize],
        live: 0 as usize, used: 0 as usize,
        allocations: 0 as usize, releases: 0 as usize,
    }
}

fn print_number(buf: *mut u8, pos: usize, v: u64) -> usize {
    var digits: [u8; 24] = [0 as u8; 24]
    var n: usize = 0 as usize
    var x: u64 = v
    if x == 0 as u64 {
        digits[0] = 48 as u8
        n = 1 as usize
    }
    while x > 0 as u64 {
        digits[n] = (x % 10 as u64) as u8 + 48 as u8
        x = x / 10 as u64
        n = n + 1 as usize
    }
    var i: usize = 0 as usize
    var p: usize = pos
    while i < n {
        *((buf as usize + p) as *mut u8) = digits[n - 1 as usize - i]
        p = p + 1 as usize
        i = i + 1 as usize
    }
    *((buf as usize + p) as *mut u8) = 32 as u8
    return p + 1 as usize
}

fn main() -> i32 {
    var h: RcHeap = heap_empty()
    if rc_heap_init(&h, 262144 as usize) == false { return 90 }

    var rounds: i64 = 0
    var order_ok: u64 = 1 as u64
    var highest: usize = 0 as usize
    while rounds < 20000 {
        var s: RefCount[Style] = rc_empty[Style]()
        let ok1: bool = rc_new[Style](&h,
            Style { color: rounds as u32, size: 8 as u32, lines: rounds }, &s) catch false
        if ok1 == false { return 1 }
        var z: RefCount[i64] = rc_empty[i64]()
        let ok2: bool = rc_new[i64](&h, rounds * 7, &z) catch false
        if ok2 == false { return 2 }
        var byte: RefCount[u8] = rc_empty[u8]()
        let ok3: bool = rc_new[u8](&h, (rounds % 251) as u8, &byte) catch false
        if ok3 == false { return 3 }

        // Clones and weak references as in real use.
        var s2: RefCount[Style] = rc_clone[Style](s)
        var w: WeakRef[Style] = weak_of[Style](s)
        var s3: RefCount[Style] = promote[Style](w)
        if rc_strong_number[Style](s) != 3 as u64 { order_ok = 0 as u64 }
        if rc_read[Style](s3).lines != rounds { order_ok = 0 as u64 }
        if rc_read[i64](z) != rounds * 7 { order_ok = 0 as u64 }
        if rc_read[u8](byte) != (rounds % 251) as u8 { order_ok = 0 as u64 }

        rc_free[Style](&h, &s3)
        rc_free[Style](&h, &s2)
        rc_free[Style](&h, &s)
        // Now the value is dead, the block still hangs on the weak reference.
        if rc_is_empty[Style](promote[Style](w)) == false { order_ok = 0 as u64 }
        weak_free[Style](&h, &w)
        rc_free[i64](&h, &z)
        rc_free[u8](&h, &byte)

        if h.next > highest { highest = h.next }
        if rc_heap_live(&h) != 0 as usize { return 4 }
        rounds = rounds + 1
    }

    var out: [u8; 128] = [0 as u8; 128]
    var p: usize = 0 as usize
    p = print_number(&out[0], p, rounds as u64)
    p = print_number(&out[0], p, rc_heap_live(&h) as u64)
    p = print_number(&out[0], p, rc_heap_used_bytes(&h) as u64)
    p = print_number(&out[0], p, highest as u64)
    p = print_number(&out[0], p, order_ok)
    out[p - 1 as usize] = 10 as u8
    syscall(1, 1, &out[0], p as i64)

    rc_heap_free(&h)
    return 0
}
