// expect_exit: 0

// RUNDE 47 — ZYKLEN AUS `Arc[T]` LECKEN. Sichtbar gemacht, nicht versteckt.
//
// Das ist dieselbe Aussage wie in tests/552 fuer `Rc`, und sie steht hier
// noch einmal, weil `Arc` genau so wenig Zyklen aufloest wie `Rc` — der
// atomare Zaehler aendert daran NICHTS. Wer Zyklen hat, nimmt entweder
// `AtomSchwachverweis` (bricht ihn von Hand) oder `gc class`/`Gc[T]`
// (loest ihn auf, SPEC 3.5).
//
// Der Test zeigt beides in EINEM Lauf:
//   A  1000 Zyklenpaare, beide Seiten stark -> nichts wird frei
//   B  dieselben 1000 Paare, eine Seite schwach -> alles wird frei
// Und er verlangt, dass A wirklich leckt: waere das Leck weg, waere die
// Aussage der Dokumentation falsch und der Test muesste anschlagen.

struct Cell {
    partner: usize,
    value: u64,
}

fn main() -> i32 {
    var h: ArcHeap = ArcHeap{
        base: 0 as usize, capacity: 0 as usize, next: 0 as usize,
        free: [0 as usize; 8], live: 0 as usize, used: 0 as usize,
        allocations: 0 as usize, releases: 0 as usize
    }
    if !arc_heap_init(&h, 1048576 as usize) {
        return 90
    }
    let rc: i32 = run(&h) catch 91
    arc_heap_free(&h)
    return rc
}

fn run(h: *mut ArcHeap) -> AllocError!i32 {
    let n: u64 = 1000 as u64

    // --- A: beide Seiten stark -> LECK ---------------------------------------
    var i: u64 = 0
    while i < n {
        var a: AtomicRef[Cell] = arc_empty[Cell]()
        var b: AtomicRef[Cell] = arc_empty[Cell]()
        if !(try arc_new[Cell](h, Cell{ partner: 0 as usize, value: i }, &a)) {
            return 1
        }
        if !(try arc_new[Cell](h, Cell{ partner: 0 as usize, value: i }, &b)) {
            return 2
        }
        // Der Zyklus: jede Zelle haelt einen STARKEN Verweis auf die andere.
        // Stufe 0 hat keine Destruktoren, deshalb liegt der Verweis als
        // Rohadresse im Wert (SPEC 3.6) und der Zaehler wird von Hand erhoeht.
        var ka: AtomicRef[Cell] = arc_clone[Cell](a)
        var kb: AtomicRef[Cell] = arc_clone[Cell](b)
        (*(arc_value_address[Cell](a) as *mut Cell)).partner = arc_raw_address[Cell](kb)
        (*(arc_value_address[Cell](b) as *mut Cell)).partner = arc_raw_address[Cell](ka)
        // Die aeusseren Verweise loslassen — die inneren bleiben.
        arc_free[Cell](h, &a)
        arc_free[Cell](h, &b)
        i = i + 1 as u64
    }
    let leak: usize = arc_heap_live(h)
    if leak != (2 as usize) * (n as usize) {
        return 3
    }
    if arc_heap_releases(h) != 0 as usize {
        return 4
    }

    // --- B: eine Seite schwach -> KEIN Leck ----------------------------------
    let before_b: usize = arc_heap_releases(h)
    var j: u64 = 0
    while j < n {
        var a: AtomicRef[Cell] = arc_empty[Cell]()
        var b: AtomicRef[Cell] = arc_empty[Cell]()
        if !(try arc_new[Cell](h, Cell{ partner: 0 as usize, value: j }, &a)) {
            return 5
        }
        if !(try arc_new[Cell](h, Cell{ partner: 0 as usize, value: j }, &b)) {
            return 6
        }
        // a haelt b STARK, b haelt a nur SCHWACH.
        var kb: AtomicRef[Cell] = arc_clone[Cell](b)
        var wa: AtomWeakRef[Cell] = aweak_of[Cell](a)
        (*(arc_value_address[Cell](a) as *mut Cell)).partner = arc_raw_address[Cell](kb)
        (*(arc_value_address[Cell](b) as *mut Cell)).partner = aweak_raw_address[Cell](wa)
        arc_free[Cell](h, &b)
        // a loslassen: a stirbt, gibt dabei seinen starken Verweis auf b von
        // Hand zurueck (Stufe 0 hat kein `drop`), dann stirbt b, dann faellt
        // der schwache Verweis.
        var inner: AtomicRef[Cell] = arc_raw_ref[Cell](
            (*(arc_value_address[Cell](a) as *mut Cell)).partner)
        arc_free[Cell](h, &a)
        arc_free[Cell](h, &inner)
        aweak_free[Cell](h, &wa)
        j = j + 1 as u64
    }
    if arc_heap_releases(h) - before_b != (2 as usize) * (n as usize) {
        return 7
    }
    // Genau das Leck aus Teil A ist uebrig — mehr nicht, weniger nicht.
    if arc_heap_live(h) != leak {
        return 8
    }
    return 0
}
