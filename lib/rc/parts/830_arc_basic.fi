// expect_exit: 0

// RUNDE 47 — `Arc[T]` (SPEC 3.4): geteilter Besitz mit ATOMAREM Zaehler.
//
// Geprueft wird:
//   * anlegen, lesen, klonen, freigeben; Zaehlerstaende an jeder Stelle
//   * der Block wird erst frei, wenn der LETZTE starke Verweis geht
//   * kein doppeltes Freigeben: ein zweites `arc_freigeben` auf denselben
//     (schon geleerten) Verweis tut nichts, und der Zaehler laeuft nicht
//     unter 0
//   * die Halde zaehlt Allokationen und Freigaben mit, ein freigegebener
//     Block wird WIEDERVERWENDET
//   * ein voller Dauerlauf endet mit lebende == 0

struct Style {
    color: u32,
    width: u32,
    height: u64,
}

fn main() -> i32 {
    var h: ArcHeap = ArcHeap{
        base: 0 as usize, capacity: 0 as usize, next: 0 as usize,
        free: [0 as usize; 8], live: 0 as usize, used: 0 as usize,
        allocations: 0 as usize, releases: 0 as usize
    }
    if !arc_heap_init(&h, 65536 as usize) {
        return 90
    }
    let rc: i32 = run(&h) catch 91
    arc_heap_free(&h)
    return rc
}

fn run(h: *mut ArcHeap) -> AllocError!i32 {
    var a: AtomicRef[Style] = arc_empty[Style]()
    if !arc_is_empty[Style](a) {
        return 1
    }
    if arc_strong_number[Style](a) != 0 as u64 {
        return 2
    }

    let ok: bool = try arc_new[Style](h, Style{ color: 7, width: 3, height: 99 as u64 }, &a)
    if !ok {
        return 3
    }
    if arc_is_empty[Style](a) {
        return 4
    }
    if arc_strong_number[Style](a) != 1 as u64 {
        return 5
    }
    if arc_weak_number[Style](a) != 0 as u64 {
        return 6
    }
    if arc_heap_live(h) != 1 as usize {
        return 7
    }

    // Lesen liefert eine KOPIE (Arc ist unveraenderlich, SPEC 3.4).
    var w: Style = arc_read[Style](a)
    if w.color != 7 || w.width != 3 || w.height != 99 as u64 {
        return 8
    }
    w.color = 42
    if arc_read[Style](a).color != 7 {
        return 9
    }

    // --- klonen: derselbe Block, Zaehler + 1 --------------------------------
    var b: AtomicRef[Style] = arc_clone[Style](a)
    if !arc_equal[Style](a, b) {
        return 10
    }
    if arc_strong_number[Style](a) != 2 as u64 {
        return 11
    }
    var c: AtomicRef[Style] = arc_clone[Style](b)
    if arc_strong_number[Style](a) != 3 as u64 {
        return 12
    }
    if arc_heap_live(h) != 1 as usize {
        return 13
    }

    // --- freigeben: erst beim LETZTEN wird der Block frei --------------------
    arc_free[Style](h, &c)
    if !arc_is_empty[Style](c) {
        return 14
    }
    if arc_strong_number[Style](a) != 2 as u64 {
        return 15
    }
    if arc_heap_live(h) != 1 as usize {
        return 16
    }
    arc_free[Style](h, &b)
    if arc_strong_number[Style](a) != 1 as u64 {
        return 17
    }
    if arc_heap_releases(h) != 0 as usize {
        return 18
    }
    let block_addr: usize = arc_raw_address[Style](a)
    arc_free[Style](h, &a)
    if arc_heap_live(h) != 0 as usize {
        return 19
    }
    if arc_heap_releases(h) != 1 as usize {
        return 20
    }

    // --- kein doppeltes Freigeben --------------------------------------------
    // `a` ist leer; ein zweiter Aufruf darf NICHTS tun (sonst kaeme derselbe
    // Block ein zweites Mal in die Freiliste — der klassische Fehler).
    arc_free[Style](h, &a)
    arc_free[Style](h, &b)
    if arc_heap_releases(h) != 1 as usize {
        return 21
    }
    if arc_heap_live(h) != 0 as usize {
        return 22
    }

    // --- der freie Block wird wiederverwendet --------------------------------
    var d: AtomicRef[Style] = arc_empty[Style]()
    if !(try arc_new[Style](h, Style{ color: 1, width: 1, height: 1 as u64 }, &d)) {
        return 23
    }
    if arc_raw_address[Style](d) != block_addr {
        return 24
    }
    if arc_heap_allocations(h) != 2 as usize {
        return 25
    }
    arc_free[Style](h, &d)

    // --- Dauerlauf: 20.000 Runden, danach ist nichts uebrig -------------------
    var round: u64 = 0
    while round < 20000 as u64 {
        var x: AtomicRef[Style] = arc_empty[Style]()
        if !(try arc_new[Style](h, Style{ color: 2, width: 2, height: round }, &x)) {
            return 26
        }
        var y: AtomicRef[Style] = arc_clone[Style](x)
        var z: AtomicRef[Style] = arc_clone[Style](y)
        if arc_strong_number[Style](x) != 3 as u64 {
            return 27
        }
        if arc_read[Style](z).height != round {
            return 28
        }
        arc_free[Style](h, &y)
        arc_free[Style](h, &z)
        arc_free[Style](h, &x)
        round = round + 1 as u64
    }
    if arc_heap_live(h) != 0 as usize {
        return 29
    }
    if arc_heap_allocations(h) != arc_heap_releases(h) {
        return 30
    }
    if arc_heap_used_bytes(h) != 0 as usize {
        return 31
    }
    return 0
}
