// expect_exit: 0

// Weak (SPEC §3.4): der schwache Verweis haelt den Wert NICHT am Leben.
// 'aufwerten' liefert sichtbar den LEEREN Verweis, sobald der starke Zaehler
// auf 0 gefallen ist. Der Block wird erst frei, wenn auch der letzte schwache
// Verweis weg ist — bis dahin ist er gehalten, aber nicht mehr lesbar.

struct Node { id: i64, depth: i64 }

fn heap_empty() -> RcHeap {
    return RcHeap{
        base: 0 as usize, capacity: 0 as usize, next: 0 as usize,
        free: [0 as usize, 0 as usize, 0 as usize, 0 as usize,
               0 as usize, 0 as usize, 0 as usize, 0 as usize],
        live: 0 as usize, used: 0 as usize,
        allocations: 0 as usize, releases: 0 as usize,
    }
}

fn new_node(h: *mut RcHeap, k: i64, out: *mut RefCount[Node]) -> bool {
    return rc_new[Node](h, Node{ id: k, depth: 0 }, out) catch false
}

fn main() -> i32 {
    var h: RcHeap = heap_empty()
    if rc_heap_init(&h, 65536 as usize) == false { return 90 }

    var a: RefCount[Node] = rc_empty[Node]()
    if new_node(&h, 7, &a) == false { return 1 }

    var w: WeakRef[Node] = weak_of[Node](a)
    if weak_is_empty[Node](w) { return 2 }
    if rc_strong_number[Node](a) != 1 as u64 { return 3 }
    if rc_weak_number[Node](a) != 1 as u64 { return 4 }

    // Aufwertung bei lebendem Ziel: starker Verweis, Zaehler steigt.
    var b: RefCount[Node] = promote[Node](w)
    if rc_is_empty[Node](b) { return 5 }
    if rc_strong_number[Node](a) != 2 as u64 { return 6 }
    if rc_read[Node](b).id != 7 { return 7 }
    rc_free[Node](&h, &b)
    if rc_strong_number[Node](a) != 1 as u64 { return 8 }

    // Letzten starken Verweis loesen: der Wert ist tot, der Block wird aber
    // noch vom schwachen Verweis gehalten (lebende bleibt 1).
    rc_free[Node](&h, &a)
    if weak_strong_number[Node](w) != 0 as u64 { return 9 }
    if rc_heap_live(&h) != 1 as usize { return 10 }

    // Sichtbar leer — genau das ist der Zweck von Weak.
    var c: RefCount[Node] = promote[Node](w)
    if rc_is_empty[Node](c) == false { return 11 }
    if rc_strong_number[Node](c) != 0 as u64 { return 12 }

    // Erst der letzte schwache Verweis gibt den Block frei.
    weak_free[Node](&h, &w)
    if weak_is_empty[Node](w) == false { return 13 }
    if rc_heap_live(&h) != 0 as usize { return 14 }
    if rc_heap_used_bytes(&h) != 0 as usize { return 15 }

    // Umgekehrte Reihenfolge: schwacher Verweis zuerst weg.
    var d: RefCount[Node] = rc_empty[Node]()
    if new_node(&h, 9, &d) == false { return 16 }
    var w2: WeakRef[Node] = weak_of[Node](d)
    var w3: WeakRef[Node] = weak_of[Node](d)
    if rc_weak_number[Node](d) != 2 as u64 { return 17 }
    weak_free[Node](&h, &w2)
    if rc_weak_number[Node](d) != 1 as u64 { return 18 }
    if rc_heap_live(&h) != 1 as usize { return 19 }
    weak_free[Node](&h, &w3)
    if rc_heap_live(&h) != 1 as usize { return 20 }
    rc_free[Node](&h, &d)
    if rc_heap_live(&h) != 0 as usize { return 21 }

    // Weak auf einen leeren Verweis bleibt leer, Aufwertung ebenfalls.
    var e: RefCount[Node] = rc_empty[Node]()
    var w4: WeakRef[Node] = weak_of[Node](e)
    if weak_is_empty[Node](w4) == false { return 22 }
    if rc_is_empty[Node](promote[Node](w4)) == false { return 23 }
    weak_free[Node](&h, &w4)

    rc_heap_free(&h)
    return 0
}
