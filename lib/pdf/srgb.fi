// SPDX-License-Identifier: MPL-2.0
// lib/pdf/srgb.fi -- the sRGB colour profile as an ICC file, built in code.
//
// PDF/A (ISO 19005) wants every file to say what its RGB numbers mean: an
// OutputIntent with an ICC profile. This module writes that profile, 440
// octets, so that no third-party profile file (with a licence of its own)
// has to be shipped. It is an ICC v4.2 "matrix/TRC" display profile with
//
//   - the sRGB primaries (IEC 61966-2-1) adapted to the D50 connection space:
//     red 0.4360 0.2225 0.0139, green 0.3851 0.7169 0.0971,
//     blue 0.1431 0.0606 0.7141, white point D50 (0.9642 1.0 0.8249);
//   - the sRGB transfer curve as ONE parametric curve (type 3):
//     y = (a x + b)^g for x >= d, else c x, with g = 2.4, a = 1/1.055,
//     b = 0.055/1.055, c = 1/12.92, d = 0.04045 -- exact, no table.
//
// The numbers are s15.16 fixed point, written big-endian like everything
// in ICC. The profile has no profile ID (all zero: allowed, "not
// calculated") and a fixed date, so the same call gives the same octets.
//
//     var b: rt.Buf = rt.buf_new()
//     srgb.srgb_icc(&b)       // 440 octets appended to b
import std.rt

export { srgb_icc, SRGB_ICC_SIZE }

const SRGB_ICC_SIZE: usize = 440

fn be16(b: *mut rt.Buf, v: u32) {
    rt.buf_push(b, ((v >> 8) & 255) as u8)
    rt.buf_push(b, (v & 255) as u8)
}

fn be32(b: *mut rt.Buf, v: u32) {
    be16(b, v >> 16)
    be16(b, v & 65535)
}

fn sig(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn zeros(b: *mut rt.Buf, n: usize) {
    var i: usize = 0
    while i < n {
        rt.buf_push(b, 0 as u8)
        i = i + 1
    }
}

// 'XYZ ' tag data: three s15.16 numbers
fn xyz(b: *mut rt.Buf, x: u32, y: u32, z: u32) {
    sig(b, "XYZ ")
    be32(b, 0)
    be32(b, x)
    be32(b, y)
    be32(b, z)
}

// 'mluc' tag data with one record (en-US) holding the ASCII text `s`;
// the answer is the tag's size in octets (padded to a multiple of 4)
fn mluc(b: *mut rt.Buf, s: str) -> usize {
    sig(b, "mluc")
    be32(b, 0)
    be32(b, 1) // one record
    be32(b, 12) // record size
    sig(b, "enUS")
    be32(b, (s.n * 2) as u32)
    be32(b, 28) // the string starts after the 28 octets before it
    var i: usize = 0
    while i < s.n {
        rt.buf_push(b, 0 as u8)
        rt.buf_push(b, rt.ld8(s.p as u64, i))
        i = i + 1
    }
    var size: usize = 28 + s.n * 2
    while size % 4 != 0 {
        rt.buf_push(b, 0 as u8)
        size = size + 1
    }
    return size
}

fn tag(b: *mut rt.Buf, name: str, offset: u32, size: u32) {
    sig(b, name)
    be32(b, offset)
    be32(b, size)
}

// Appends the profile (SRGB_ICC_SIZE octets) to `b`.
fn srgb_icc(b: *mut rt.Buf) {
    // header, 128 octets
    be32(b, SRGB_ICC_SIZE as u32)
    be32(b, 0) // no preferred CMM
    be32(b, 67239936) // version 4.2.0
    sig(b, "mntr")
    sig(b, "RGB ")
    sig(b, "XYZ ")
    be16(b, 2024)
    be16(b, 1)
    be16(b, 1)
    be16(b, 0)
    be16(b, 0)
    be16(b, 0)
    sig(b, "acsp")
    zeros(b, 4 + 4 + 4 + 4 + 8) // platform, flags, manufacturer, model, attributes
    be32(b, 0) // perceptual
    be32(b, 63190) // illuminant D50: 0.9642
    be32(b, 65536) // 1.0
    be32(b, 54061) // 0.8249
    zeros(b, 4) // creator
    zeros(b, 16) // profile ID
    zeros(b, 28)
    // tag table: 9 tags
    be32(b, 9)
    tag(b, "desc", 240, 36)
    tag(b, "cprt", 276, 52)
    tag(b, "wtpt", 328, 20)
    tag(b, "rXYZ", 348, 20)
    tag(b, "gXYZ", 368, 20)
    tag(b, "bXYZ", 388, 20)
    tag(b, "rTRC", 408, 32)
    tag(b, "gTRC", 408, 32)
    tag(b, "bTRC", 408, 32)
    // tag data
    mluc(b, "sRGB")
    mluc(b, "No copyright")
    xyz(b, 63190, 65536, 54061)
    xyz(b, 28578, 14581, 912) // 0.4360 0.2225 0.0139
    xyz(b, 25241, 46981, 6362) // 0.3851 0.7169 0.0971
    xyz(b, 9376, 3972, 46799) // 0.1431 0.0606 0.7141
    sig(b, "para")
    be32(b, 0)
    be16(b, 3) // y = (a x + b)^g for x >= d, else c x
    be16(b, 0)
    be32(b, 157286) // g = 2.4
    be32(b, 62119) // a = 1/1.055
    be32(b, 3417) // b = 0.055/1.055
    be32(b, 5072) // c = 1/12.92
    be32(b, 2651) // d = 0.04045
}
