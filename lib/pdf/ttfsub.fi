// SPDX-License-Identifier: MPL-2.0
// lib/pdf/ttfsub.fi -- a TrueType font cut down to the glyphs a document
// uses, for embedding in a PDF (FontFile2 of a CIDFontType2).
//
// THE METHOD keeps every glyph NUMBER and empties the glyphs that are not
// used: `loca` gets an entry for every glyph as before, but the unused ones
// have length 0. The PDF then addresses glyphs by their original numbers
// (CIDToGIDMap /Identity), nothing has to be renumbered, and hinting
// instructions that call glyphs by number keep working. What costs space in
// a font is `glyf`; an empty glyph costs four octets of `loca`.
//
// Composite glyphs (an "ä" built from "a" and a diaeresis) pull their
// components in, to any depth; glyph 0 (.notdef) is always kept, as the
// format demands.
//
// Tables copied unchanged: OS/2, cmap, cvt , fpgm, hhea, hmtx, maxp, name,
// prep; `post` is cut to its 32-octet header (format 3, no glyph names). Rebuilt: glyf, loca (always the long format) and head
// (indexToLocFormat = 1, checkSumAdjustment recomputed). Everything else
// (GSUB, GPOS, kern, DSIG, ...) is dropped: a PDF viewer does no shaping.
//
// CFF fonts (OTTO) and collections (ttcf) are refused: `ttf_subset`
// answers false.

import std.rt
import std.vec

export { ttf_subset, ttf_units_per_em, ttf_bbox, ttf_postscript_name }

fn be16(p: u64) -> u32 {
    return (rt.ld8(p, 0) as u32 << 8) | rt.ld8(p, 1) as u32
}

fn be32(p: u64) -> u32 {
    return (be16(p) << 16) | be16(p + 2)
}

fn put16(b: *mut rt.Buf, v: u32) {
    rt.buf_push(b, ((v >> 8) & 255) as u8)
    rt.buf_push(b, (v & 255) as u8)
}

fn put32(b: *mut rt.Buf, v: u32) {
    put16(b, (v >> 16) & 65535)
    put16(b, v & 65535)
}

fn tag(a: u32, b: u32, c: u32, d: u32) -> u32 {
    return (a << 24) | (b << 16) | (c << 8) | d
}

// the table `t`: offset and length, false if missing or out of range
fn table(src: u64, n: usize, t: u32, off: *mut usize, len: *mut usize) -> bool {
    if n < 12 {
        return false
    }
    let count: usize = be16(src + 4) as usize
    if 12 + count * 16 > n {
        return false
    }
    var i: usize = 0
    while i < count {
        let rec: u64 = src + 12 + (i * 16) as u64
        if be32(rec) == t {
            let o: usize = be32(rec + 8) as usize
            let l: usize = be32(rec + 12) as usize
            if o > n || l > n - o {
                return false
            }
            *off = o
            *len = l
            return true
        }
        i = i + 1
    }
    return false
}

fn is_truetype(src: u64, n: usize) -> bool {
    if n < 12 {
        return false
    }
    let v: u32 = be32(src)
    return v == 65536 as u32 || v == 1953658213 as u32 // 0x00010000, 'true'
}

fn ttf_units_per_em(src: u64, n: usize) -> u32 {
    var o: usize = 0
    var l: usize = 0
    if !table(src, n, tag(104, 101, 97, 100), &o, &l) || l < 54 {
        return 1000 as u32
    }
    let u: u32 = be16(src + o as u64 + 18)
    if u == 0 {
        return 1000 as u32
    }
    return u
}

fn s16(v: u32) -> i32 {
    if v >= 32768 {
        return v as i32 - 65536
    }
    return v as i32
}

// one of xMin, yMin, xMax, yMax of `head` (k = 0..3), in font units
fn ttf_bbox(src: u64, n: usize, k: usize) -> i32 {
    var o: usize = 0
    var l: usize = 0
    if !table(src, n, tag(104, 101, 97, 100), &o, &l) || l < 54 {
        if k >= 2 {
            return 1000 as i32
        }
        return 0 as i32
    }
    return s16(be16(src + o as u64 + 36 + (k * 2) as u64))
}

// The PostScript name (name ID 6) as ASCII letters, digits and "-" only,
// into `out`; "FirnFont" if the font has none.
fn ttf_postscript_name(src: u64, n: usize, out: *mut rt.Buf) {
    var o: usize = 0
    var l: usize = 0
    let before: usize = (*out).len
    if table(src, n, tag(110, 97, 109, 101), &o, &l) && l >= 6 {
        let t: u64 = src + o as u64
        let count: usize = be16(t + 2) as usize
        let strings: usize = be16(t + 4) as usize
        var i: usize = 0
        while i < count && 6 + (i + 1) * 12 <= l && (*out).len == before {
            let r: u64 = t + 6 + (i * 12) as u64
            let platform: u32 = be16(r)
            let id: u32 = be16(r + 6)
            let len: usize = be16(r + 8) as usize
            let off: usize = be16(r + 10) as usize
            if id == 6 && strings + off + len <= l {
                let s: u64 = t + (strings + off) as u64
                var step: usize = 1
                var first: usize = 0
                if platform == 0 || platform == 3 {
                    step = 2 // UTF-16BE: the low octet of each unit
                    first = 1
                }
                var k: usize = first
                while k < len && (*out).len - before < 63 {
                    let c: u8 = rt.ld8(s, k)
                    let ok: bool = (c >= 48 as u8 && c <= 57 as u8) || (c >= 65 as u8 && c <= 90 as u8) ||
                    (c >= 97 as u8 && c <= 122 as u8) || c == 45 as u8
                    if ok && (step == 1 || rt.ld8(s, k - 1) == 0 as u8) {
                        rt.buf_push(out, c)
                    }
                    k = k + step
                }
            }
            i = i + 1
        }
    }
    if (*out).len == before {
        let d: str = "FirnFont"
        rt.buf_push_bytes(out, d.p as u64, d.n)
    }
}

// the glyph `g` in `glyf`: offset (relative to glyf) and length
fn glyph_at(src: u64, loca: usize, long: bool, g: usize, off: *mut usize, len: *mut usize) {
    var a: usize = 0
    var b: usize = 0
    if long {
        a = be32(src + (loca + g * 4) as u64) as usize
        b = be32(src + (loca + g * 4 + 4) as u64) as usize
    } else {
        a = be16(src + (loca + g * 2) as u64) as usize * 2
        b = be16(src + (loca + g * 2 + 2) as u64) as usize * 2
    }
    *off = a
    if b > a {
        *len = b - a
    } else {
        *len = 0
    }
}

fn checksum(p: u64, n: usize) -> u32 {
    var sum: u32 = 0
    var i: usize = 0
    while i + 4 <= n {
        sum = sum +% be32(p + i as u64)
        i = i + 4
    }
    if i < n {
        var last: u32 = 0
        var k: usize = 0
        while k < 4 {
            last = last << 8
            if i + k < n {
                last = last | rt.ld8(p, i + k) as u32
            }
            k = k + 1
        }
        sum = sum +% last
    }
    return sum
}

fn put_be32_at(b: *mut rt.Buf, at: usize, v: u32) {
    rt.st8(rt.buf_ptr(b), at, ((v >> 24) & 255) as u8)
    rt.st8(rt.buf_ptr(b), at + 1, ((v >> 16) & 255) as u8)
    rt.st8(rt.buf_ptr(b), at + 2, ((v >> 8) & 255) as u8)
    rt.st8(rt.buf_ptr(b), at + 3, (v & 255) as u8)
}

// Writes the subset of the font `src`/`n` that keeps the glyphs listed in
// `keep` (and what they need) to `out`. false = not a TrueType font this
// function can cut.
fn ttf_subset(src: u64, n: usize, keep: *mut Vec[u32], out: *mut rt.Buf) -> bool {
    if !is_truetype(src, n) {
        return false
    }
    var ho: usize = 0
    var hl: usize = 0
    var mo: usize = 0
    var ml: usize = 0
    var lo: usize = 0
    var ll: usize = 0
    var go: usize = 0
    var gl: usize = 0
    if !table(src, n, tag(104, 101, 97, 100), &ho, &hl) || hl < 54 { return false }
    if !table(src, n, tag(109, 97, 120, 112), &mo, &ml) || ml < 6 { return false }
    if !table(src, n, tag(108, 111, 99, 97), &lo, &ll) { return false }
    if !table(src, n, tag(103, 108, 121, 102), &go, &gl) { return false }
    let glyphs: usize = be16(src + mo as u64 + 4) as usize
    let long: bool = be16(src + ho as u64 + 50) == 1
    if long && ll < (glyphs + 1) * 4 { return false }
    if !long && ll < (glyphs + 1) * 2 { return false }
    // --- which glyphs: the list, .notdef, and every component, to any depth
    var used: Vec[u8] = vec_new[u8]()
    var i: usize = 0
    while i < glyphs {
        vec_push[u8](&used, 0 as u8)
        i = i + 1
    }
    var todo: Vec[u32] = vec_new[u32]()
    vec_push[u32](&todo, 0 as u32)
    i = 0
    while i < vec_len[u32](keep) {
        vec_push[u32](&todo, vec_at[u32](keep, i))
        i = i + 1
    }
    while vec_len[u32](&todo) > 0 {
        let g: usize = vec_pop[u32](&todo) as usize
        if g < glyphs && vec_at[u8](&used, g) == 0 as u8 {
            vec_set[u8](&used, g, 1 as u8)
            var off: usize = 0
            var len: usize = 0
            glyph_at(src, lo, long, g, &off, &len)
            if len >= 10 && off + len <= gl {
                let p: u64 = src + (go + off) as u64
                if s16(be16(p)) < 0 {
                    // composite: flags, glyphIndex, arguments, scale
                    var q: usize = 10
                    var more: bool = true
                    while more && q + 4 <= len {
                        let flags: u32 = be16(p + q as u64)
                        let comp: u32 = be16(p + q as u64 + 2)
                        vec_push[u32](&todo, comp)
                        q = q + 4
                        if (flags & 1) != 0 { q = q + 4 } else { q = q + 2 }
                        if (flags & 8) != 0 { q = q + 2 }
                        if (flags & 64) != 0 { q = q + 4 }
                        if (flags & 128) != 0 { q = q + 8 }
                        more = (flags & 32) != 0
                    }
                }
            }
        }
    }
    vec_free[u32](&todo)
    // --- the new glyf and loca
    var glyf: rt.Buf = rt.buf_new()
    var loca: rt.Buf = rt.buf_new()
    i = 0
    while i < glyphs {
        put32(&loca, rt.buf_len(&glyf) as u32)
        if vec_at[u8](&used, i) != 0 as u8 {
            var off: usize = 0
            var len: usize = 0
            glyph_at(src, lo, long, i, &off, &len)
            if len > 0 && off + len <= gl {
                rt.buf_push_bytes(&glyf, src + (go + off) as u64, len)
                while rt.buf_len(&glyf) % 4 != 0 {
                    rt.buf_push(&glyf, 0 as u8)
                }
            }
        }
        i = i + 1
    }
    put32(&loca, rt.buf_len(&glyf) as u32)
    vec_free[u8](&used)
    // --- the tables, sorted by tag
    var tags: [u32; 13] = [
        tag(79, 83, 47, 50), // OS/2
        tag(99, 109, 97, 112), // cmap
        tag(99, 118, 116, 32), // cvt
        tag(102, 112, 103, 109), // fpgm
        tag(103, 108, 121, 102), // glyf
        tag(104, 101, 97, 100), // head
        tag(104, 104, 101, 97), // hhea
        tag(104, 109, 116, 120), // hmtx
        tag(108, 111, 99, 97), // loca
        tag(109, 97, 120, 112), // maxp
        tag(110, 97, 109, 101), // name
        tag(112, 111, 115, 116), // post
        tag(112, 114, 101, 112), // prep
    ]
    var offs: [usize; 13] = [0; 13]
    var lens: [usize; 13] = [0; 13]
    var present: [bool; 13] = [false; 13]
    var count: usize = 0
    i = 0
    while i < 13 {
        if i == 4 {
            present[i] = true
            lens[i] = rt.buf_len(&glyf)
        } else if i == 8 {
            present[i] = true
            lens[i] = rt.buf_len(&loca)
        } else {
            var o: usize = 0
            var l: usize = 0
            if table(src, n, tags[i], &o, &l) {
                present[i] = true
                offs[i] = o
                lens[i] = l
            }
        }
        if present[i] {
            count = count + 1
        }
        i = i + 1
    }
    // hhea and hmtx are required as well
    if !present[6] || !present[7] {
        rt.buf_free(&glyf)
        rt.buf_free(&loca)
        return false
    }
    let start: usize = (*out).len
    var sel: u32 = 0
    var pow: u32 = 1
    while pow * 2 <= count as u32 {
        pow = pow * 2
        sel = sel + 1
    }
    put32(out, 65536 as u32)
    put16(out, count as u32)
    put16(out, pow * 16)
    put16(out, sel)
    put16(out, count as u32 * 16 - pow * 16)
    let dir: usize = (*out).len
    i = 0
    while i < count * 16 {
        rt.buf_push(out, 0 as u8)
        i = i + 1
    }
    var slot: usize = 0
    var head_at: usize = 0
    i = 0
    while i < 13 {
        if present[i] {
            while ((*out).len - start) % 4 != 0 {
                rt.buf_push(out, 0 as u8)
            }
            let at: usize = (*out).len
            if i == 4 {
                rt.buf_push_bytes(out, rt.buf_ptr(&glyf), lens[i])
            } else if i == 8 {
                rt.buf_push_bytes(out, rt.buf_ptr(&loca), lens[i])
            } else if i == 11 && lens[i] >= 32 {
                // post: format 3 -- the glyph names (format 2) are the
                // largest table after glyf and nothing in a PDF reads them
                rt.buf_push_bytes(out, src + offs[i] as u64, 32)
                put_be32_at(out, at, 196608 as u32) // 0x00030000
                lens[i] = 32
            } else {
                rt.buf_push_bytes(out, src + offs[i] as u64, lens[i])
            }
            if i == 5 {
                head_at = at
                // checkSumAdjustment = 0 for now, indexToLocFormat = 1
                put_be32_at(out, at + 8, 0 as u32)
                rt.st8(rt.buf_ptr(out), at + 50, 0 as u8)
                rt.st8(rt.buf_ptr(out), at + 51, 1 as u8)
            }
            let sum: u32 = checksum(rt.buf_ptr(out) + at as u64, lens[i])
            let rec: usize = dir + slot * 16
            put_be32_at(out, rec, tags[i])
            put_be32_at(out, rec + 4, sum)
            put_be32_at(out, rec + 8, (at - start) as u32)
            put_be32_at(out, rec + 12, lens[i] as u32)
            slot = slot + 1
        }
        i = i + 1
    }
    while ((*out).len - start) % 4 != 0 {
        rt.buf_push(out, 0 as u8)
    }
    rt.buf_free(&glyf)
    rt.buf_free(&loca)
    // the whole font sums to 0xB1B0AFBA
    let total: u32 = checksum(rt.buf_ptr(out) + start as u64, (*out).len - start)
    put_be32_at(out, head_at + 8, 2981146554 as u32 -% total)
    return true
}
