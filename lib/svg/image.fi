// SPDX-License-Identifier: MPL-2.0
// Provenance: Certus, lib/svg/ (last changed in Certus commit 8f138f02), ported to
// Firn in 0e1a1196; released by the sole author Justin on 25.09.2026 for Firn
// under MPL-2.0.
// lib/svg/image.fi -- SVG AS AN IMAGE. The seam to the rest of the browser.
//
// This file is deliberately the ONLY place at which the SVG painter
// speaks with the rest of the browser, and it does exactly one thing: from
// SVG octets a `png.Image` is made. From there on a symbol is for Certus
// the same as a PNG -- the image store stores it, the painter draws
// it into a box, `background-image` uses it. No other part
// of the browser has to know anything about SVG.
//
// The reason for this cut is the merge: five rounds work
// at the same time on Certus, and lib/browser belongs to another one. The
// intervention there is thereby SIX LINES in `img_store_add` -- one
// query, one call. Everything else stands here.
//
// ------------------------------------------------ HOW LARGE THE IMAGE BECOMES
//
// An SVG has no pixels, but a size in user units.
// `svg_groesse` delivers it from `width`/`height`, alternatively from the
// `viewBox`, alternatively 300x150 (that is what the specification demands).
// RASTERISING IS DONE AT THE INTRINSIC SIZE, and `SKALA` stands at 1. The
// first attempt of this round rasterised with the factor 3, so that a
// 24 symbol in a 48 box is not visibly scaled up --
// and thereby brought a real error upon itself: the size of the
// `png.Image` IS the intrinsic size that the layout gives an `<img>` without
// `width`. A 24x24 symbol was afterwards 72x72 large and pushed half
// the page aside (measured: all three symbols 72x72 instead of 24, 48
// and 24). The enlargement belongs at the place that knows the USED
// size -- that is the layout, and that is in this round
// foreign territory. `svg_zu_bild_gross` can already do it, as soon as somebody from
// there passes in the target size; see docs/ROUNDGRAFIK.md.
// `MAX_KANTE` is the upper limit, so that an SVG with `width="10000"`
// does not occupy 400 MB.
import html.mem
import font.metrics
import paint.canvas
import paint.png
import svg.paint
import svg.xml

export {
    ist_svg, svg_to_image, svg_too_image_big, svg_too_image_color,
}

const SKALA: usize = 1
const MAX_EDGE: usize = 2048

// Does this smell like SVG? The first octets decide: whitespace, then
// `<?xml`, `<!--`, `<!DOCTYPE` or `<svg`.
//
// Why not by the file name: a page often delivers its symbols via
// a way without an extension (`data:` URL, a service, a `blob:`), and the
// content type does not arrive everywhere. The octets are the only
// reliable information, and the same way already decides in
// lib/browser/images.fi between PNG and JPEG.
#[no_gc]
fn ist_svg(p: u64, n: usize) -> bool {
    var i: usize = 0
    var rounds: usize = 0
    while rounds < 8 {
        rounds = rounds + 1
        while i < n && (read(p, i) == 32 || read(p, i) == 9
            || read(p, i) == 10 || read(p, i) == 13
            || read(p, i) == 0xEF || read(p, i) == 0xBB
            || read(p, i) == 0xBF) {
            i = i + 1
        }
        if i + 4 > n {
            return false
        }
        if read(p, i) != 60 {
            return false
        }
        // `<svg`
        if small(read(p, i + 1)) == 115 && small(read(p, i + 2)) == 118
        && small(read(p, i + 3)) == 103 {
            return true
        }
        // skip `<?xml ... ?>` or `<!-- -->` or `<!DOCTYPE >`
        if read(p, i + 1) != 63 && read(p, i + 1) != 33 {
            return false
        }
        var j: usize = i + 1
        while j < n && read(p, j) != 62 {
            j = j + 1
        }
        if j >= n {
            return false
        }
        i = j + 1
    }
    return false
}

#[no_gc]
fn read(p: u64, i: usize) -> u32 {
    let v: u8 = *((p + i as u64) as *mut u8)
    return v as u32
}

#[no_gc]
fn small(c: u32) -> u32 {
    if c >= 65 && c <= 90 {
        return c + 32
    }
    return c
}

// SVG octets into a `png.Image`. `fm` is the font collection for
// `<text>`; 0 means: no text.
//
// The result is STRAIGHT (not premultiplied) RGBA -- that is how
// `png.Image` holds its pixels, and that is how `painter.paint_image`
// expects them.
#[no_gc]
fn svg_to_image(p: u64, n: usize, im: *mut png.Image, fm: u64) -> bool {
    return svg_too_image_big(p, n, im, fm, 0, 0)
}

// WITH A GIVEN `currentColor`. The reason stands at
// `paint.male_baum_farbe`: fUi puts the accent colour of the theme in here,
// so that a symbol with `fill="currentColor"` takes it on.
#[no_gc]
fn svg_too_image_color(p: u64, n: usize, im: *mut png.Image, fm: u64,
    bw: usize, bh: usize, aktuell: u32) -> bool {
    return to_image(p, n, im, fm, bw, bh, aktuell)
}

// The same, but with a given target size. `bw`/`bh` equal to zero
// means: the own size of the file, multiplied by `SKALA`.
#[no_gc]
fn svg_too_image_big(p: u64, n: usize, im: *mut png.Image, fm: u64,
    bw: usize, bh: usize) -> bool {
    return to_image(p, n, im, fm, bw, bh, 4278190080 as u32)
}

#[no_gc]
fn to_image(p: u64, n: usize, im: *mut png.Image, fm: u64,
    bw: usize, bh: usize, aktuell: u32) -> bool {
    var tree: xml.Tree = xml.tree_new()
    xml.tree_init(&tree)
    if !xml.split_xml(&tree, p, n) {
        xml.tree_free(&tree)
        return false
    }
    var nw: f64 = 300.0
    var nh: f64 = 150.0
    if !paint.svg_size(&tree, &nw, &nh) {
        xml.tree_free(&tree)
        return false
    }
    var w: usize = bw
    var h: usize = bh
    if w == 0 || h == 0 {
        w = ((nw + 0.5) as usize) * SKALA
        h = ((nh + 0.5) as usize) * SKALA
    }
    if w < 1 {
        w = 1
    }
    if h < 1 {
        h = 1
    }
    if w > MAX_EDGE {
        w = MAX_EDGE
    }
    if h > MAX_EDGE {
        h = MAX_EDGE
    }
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, w, h) {
        xml.tree_free(&tree)
        return false
    }
    // TRANSPARENT, not white. A symbol lies on the page, and a
    // white box underneath would be immediately visible on every coloured
    // surface.
    canvas.canvas_clear(&cv, 0 as u32)
    var m: paint.Painter = paint.painter_new()
    if !paint.painter_init(&m, &cv) {
        canvas.canvas_free(&cv)
        xml.tree_free(&tree)
        return false
    }
    paint.painter_set_font(&m, fm)
    paint.times_tree_color(&m, &tree, 0.0, 0.0, w as f64, h as f64,
        aktuell)

    // Put the pixels into the `png.Image`, converted back to
    // straight alpha.
    (*im).w = w
    (*im).h = h
    (*im).cap = w * h * 4
    (*im).px = mem.heap_alloc((*im).cap)
    if (*im).px as usize == 0 {
        paint.painter_free(&m)
        canvas.canvas_free(&cv)
        xml.tree_free(&tree)
        return false
    }
    var y: usize = 0
    while y < h {
        var x: usize = 0
        while x < w {
            let v: u32 = canvas.canvas_get(&cv, x, y)
            let a: u32 = (v >> 24) & 255 as u32
            var r: u32 = 0 as u32
            var g: u32 = 0 as u32
            var b: u32 = 0 as u32
            if a != 0 as u32 {
                r = ((v >> 16) & 255 as u32) * 255 / a
                g = ((v >> 8) & 255 as u32) * 255 / a
                b = (v & 255 as u32) * 255 / a
                if r > 255 as u32 {
                    r = 255 as u32
                }
                if g > 255 as u32 {
                    g = 255 as u32
                }
                if b > 255 as u32 {
                    b = 255 as u32
                }
            }
            let o: u64 = ((*im).px as u64) + (((y * w + x) * 4) as u64)
            *(o as *mut u8) = r as u8
            *((o + 1) as *mut u8) = g as u8
            *((o + 2) as *mut u8) = b as u8
            *((o + 3) as *mut u8) = a as u8
            x = x + 1
        }
        y = y + 1
    }
    (*im).ok = 1
    paint.painter_free(&m)
    canvas.canvas_free(&cv)
    xml.tree_free(&tree)
    return true
}
