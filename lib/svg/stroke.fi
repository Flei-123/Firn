// SPDX-License-Identifier: MPL-2.0
// Herkunft: Certus, lib/svg/ (zuletzt geaendert in Certus-Commit 8f138f02), nach Firn
// portiert in 0e1a1196; vom alleinigen Urheber Justin am 25.09.2026 fuer Firn
// unter MPL-2.0 freigegeben.
// lib/svg/strich.fi -- DAS BESTREICHEN. Aus einer Linie wird eine Flaeche.
//
// Ein `stroke` ist keine Linie, sondern ein FLAECHENSTUECK: die Menge
// aller Punkte, die hoechstens `stroke-width / 2` von der Linie entfernt
// sind, an den Enden nach `stroke-linecap` und an den Knicken nach
// `stroke-linejoin` abgeschlossen. Der Rasterer kann nur Flaechen fuellen,
// also muss diese Flaeche als PFAD hingeschrieben werden.
//
// ------------------------------------------------- DER WEG, UND DER IRRWEG
//
// Der erste Versuch dieser Runde hat jede Strecke als eigenes Rechteck
// gestempelt und die Rechtecke sich ueberlagern lassen. Das ist einfach,
// es loest Selbstschnitte von selbst auf -- und es ist an einer Stelle
// MESSBAR falsch: an der INNENSEITE einer Kurve ueberlappen sich zwei
// benachbarte Rechtecke, und der Rasterer ADDIERT die Teildeckungen, bevor
// er bei eins abschneidet. Ein Bildpunkt, den zwei Rechtecke zu je 40 %
// beruehren, kommt mit 80 % heraus statt mit den 55 %, die die Vereinigung
// wirklich hat. Das Ergebnis ist ein etwa einen Bildpunkt breiter, zu
// harter Saum an jeder Kurveninnenkante. Gegen Chromium gemessen waren das
// auf dem ersten Testfall 1,58 % abweichende Bildpunkte, und sie lagen
// ALLE dort.
//
// Also: EIN EINZIGER UMRISS je Teilpfad. Die linke und die rechte
// Versatzlinie werden gebaut, an den Enden mit Kappen und an den Knicken
// mit Verbindungen verbunden, und das Ganze einmal geschlossen. Kein
// Bildpunkt wird zweimal gezaehlt, und die Kantenglaettung ist damit
// genau so exakt wie die des Rasterers.
//
// WAS MIT SELBSTSCHNITTEN PASSIERT, und warum das hier gutgeht: der
// Rasterer von lib/font/raster.fi nimmt den BETRAG der Umlaufzahl und
// deckelt ihn bei eins. Eine Schlaufe, die an einer engen Ecke entsteht,
// hat Umlaufzahl 2 oder -1 -- beides wird zu voller Deckung. Genau das ist
// bei einem Strich gewollt: die Schlaufe gehoert zum Strich. Mit der
// Gerade-Ungerade-Regel waere an derselben Stelle ein Loch.
//
// Bei einem GESCHLOSSENEN Teilpfad sind es zwei Ringe, und der innere
// laeuft ANDERSHERUM -- dann heben sich die Umlaufzahlen im Loch auf und
// der Ring ist ein Ring.
import html.mem
import svg.matrix
import svg.path

export {
    Strich,
    K_STUMPF, K_RUND, K_ECKIG,
    S_GEHRUNG, S_RUND, S_ABGE,
    strich_neu, strich_frei, strich_setze_striche, strich_hat_striche,
    strich_umriss,
}

const K_STUMPF: u32 = 0 // butt
const K_RUND: u32 = 1 // round
const K_ECKIG: u32 = 2 // square

const S_GEHRUNG: u32 = 0 // miter
const S_RUND: u32 = 1 // round
const S_ABGE: u32 = 2 // bevel

// Hoechstens so viele Werte in `stroke-dasharray`. Mehr hat keine echte
// Seite; wer mehr angibt, bekommt die ersten 32.
const STRICH_MAX: usize = 32

struct Strich {
    breite: f64,
    kappe: u32,
    stoss: u32,
    gehrung: f64, // stroke-miterlimit
    striche: [f64; 32],
    n_striche: usize,
    versatz: f64, // stroke-dashoffset
    // Drei Zwischenpuffer. Sie gehoeren zum Werkzeug und nicht zu jedem
    // Aufruf, damit eine Symbolsammlung mit dreitausend Pfaden nicht
    // dreitausendmal Speicher holt.
    tmp: mem.Buf, // die Punkte des laufenden Teilpfades
    lbuf: mem.Buf, // die linke Versatzlinie
    rbuf: mem.Buf, // die rechte Versatzlinie
}

#[no_gc]
fn strich_neu() -> Strich {
    return Strich {
        breite: 1.0,
        kappe: K_STUMPF,
        stoss: S_GEHRUNG,
        gehrung: 4.0,
        striche: [0.0; 32],
        n_striche: 0,
        versatz: 0.0,
        tmp: mem.buf_new(),
        lbuf: mem.buf_new(),
        rbuf: mem.buf_new(),
    }
}

#[no_gc]
fn strich_frei(s: *mut Strich) {
    mem.buf_free(&(*s).tmp)
    mem.buf_free(&(*s).lbuf)
    mem.buf_free(&(*s).rbuf)
}

#[no_gc]
fn strich_setze_striche(s: *mut Strich, i: usize, v: f64) {
    if i < STRICH_MAX {
        (*s).striche[i] = v
    }
}

// Ein `stroke-dasharray` zaehlt nur, wenn wenigstens ein Wert groesser
// null ist -- `stroke-dasharray: 0 0` ist nach der Spezifikation dasselbe
// wie `none` und darf keine Endlosschleife ausloesen.
#[no_gc]
fn strich_hat_striche(s: *mut Strich) -> bool {
    var i: usize = 0
    var summe: f64 = 0.0
    while i < (*s).n_striche {
        if (*s).striche[i] < 0.0 {
            return false
        }
        summe = summe + (*s).striche[i]
        i = i + 1
    }
    return (*s).n_striche > 0 && summe > 0.0
}

// ---------------------------------------------------------- Punktpuffer

#[no_gc]
fn buf_leere(b: *mut mem.Buf) {
    mem.buf_clear(b)
}

#[no_gc]
fn buf_an(b: *mut mem.Buf, x: f64, y: f64) {
    let n: usize = mem.buf_len(b)
    mem.buf_reserve(b, n + 16)
    mem.buf_set_len(b, n + 16)
    let p: u64 = mem.buf_ptr(b) as u64
    *((p + n as u64) as *mut f64) = x
    *((p + (n + 8) as u64) as *mut f64) = y
}

// Beim Sammeln der MITTELLINIE werden zwei gleiche Punkte hintereinander
// weggelassen: eine Strecke der Laenge null hat keine Richtung, und jede
// Rechnung mit ihrer Normalen waere eine Division durch null.
#[no_gc]
fn buf_an_neu(b: *mut mem.Buf, x: f64, y: f64) {
    let n: usize = mem.buf_len(b)
    if n >= 16 {
        let p: u64 = mem.buf_ptr(b) as u64
        let px: f64 = *((p + (n - 16) as u64) as *mut f64)
        let py: f64 = *((p + (n - 8) as u64) as *mut f64)
        if px == x && py == y {
            return
        }
    }
    buf_an(b, x, y)
}

#[no_gc]
fn buf_anz(b: *mut mem.Buf) -> usize {
    return mem.buf_len(b) / 16
}

#[no_gc]
fn buf_x(b: *mut mem.Buf, i: usize) -> f64 {
    return *((mem.buf_ptr(b) as u64 + (i * 16) as u64) as *mut f64)
}

#[no_gc]
fn buf_y(b: *mut mem.Buf, i: usize) -> f64 {
    return *((mem.buf_ptr(b) as u64 + (i * 16 + 8) as u64) as *mut f64)
}

// ------------------------------------------------- Die Verbindungsstuecke

// Ein Bogen um `cx`/`cy` vom Winkel `a0` zum Winkel `a1` (in Grad), im
// Abstand `h`. Die Punkte werden angehaengt, Anfang und Ende
// eingeschlossen. Die Feinheit richtet sich nach der Groesse: ein
// Verbindungsstueck von einem halben Bildpunkt braucht keine 16 Ecken.
#[no_gc]
fn bogen_an(b: *mut mem.Buf, cx: f64, cy: f64, h: f64, a0: f64, a1: f64) {
    var d: f64 = a1 - a0
    while d > 180.0 {
        d = d - 360.0
    }
    while d < 0.0 - 180.0 {
        d = d + 360.0
    }
    var k: i64 = ((matrix.m_abs(d) * h / 90.0) as i64) + 2
    if k > 48 {
        k = 48
    }
    var i: i64 = 0
    while i <= k {
        let t: f64 = a0 + d * ((i as f64) / (k as f64))
        buf_an(b, cx + h * matrix.m_cos(t), cy + h * matrix.m_sin(t))
        i = i + 1
    }
}

// Ein Knick. `sigma` ist +1 fuer die linke und -1 fuer die rechte Seite;
// `aussen` sagt, ob DIESE Seite die aeussere ist.
//
// Der Schnittpunkt der beiden Versatzgeraden ist auf beiden Seiten
// dieselbe Rechnung. Gesucht ist `q` mit `(q-p).npv = sigma*h` und
// `(q-p).ncur = sigma*h`; mit `q-p = t*(npv+ncur)` folgt
// `t = sigma*h / (1 + npv.ncur)`, und `npv.ncur` ist genau das
// Skalarprodukt der beiden RICHTUNGEN. Die Gehrungslaenge ist damit
// `h * sqrt(2/(1+c))` -- das ist die `1/sin(theta/2)` der Spezifikation,
// nur ohne Winkelfunktion.
#[no_gc]
fn knick_an(b: *mut mem.Buf, st: *mut Strich, px: f64, py: f64, npvx: f64,
    npvy: f64, ncux: f64, ncuy: f64, c: f64, kreuz: f64, h: f64,
    sigma: f64, aussen: bool, lvor: f64, lnach: f64) {
    let ax: f64 = px + sigma * npvx * h
    let ay: f64 = py + sigma * npvy * h
    let bx: f64 = px + sigma * ncux * h
    let by: f64 = py + sigma * ncuy * h
    // Fast gerade -- ein Punkt genuegt.
    if c > 0.99999999 {
        buf_an(b, ax, ay)
        return
    }
    var q_da: bool = false
    var qx: f64 = 0.0
    var qy: f64 = 0.0
    var laenge: f64 = 0.0
    if c > 0.0 - 0.99999999 {
        let t: f64 = sigma * h / (1.0 + c)
        qx = px + (npvx + ncux) * t
        qy = py + (npvy + ncuy) * t
        laenge = h * matrix.m_sqrt(2.0 / (1.0 + c))
        q_da = true
    }
    if !aussen {
        // DIE INNENSEITE. Hier faellt der Umriss in sich zusammen. Der
        // Schnittpunkt ist der richtige Punkt, SOLANGE er noch auf beiden
        // Strecken liegt; sonst wird die MITTELLINIE genommen. Das ist
        // die Stelle, an der eine naive Fassung eine Schlaufe erzeugt und
        // damit ein Loch in den Strich schneidet.
        //
        // GEMESSEN WIRD ENTLANG DER STRECKE, nicht die Laenge der
        // Gehrung. Der Schnittpunkt liegt um `h*tan(phi/2)` vor bzw.
        // hinter dem Knick, wobei `phi` der Knickwinkel ist -- also
        // `h*|kreuz|/(1+c)`. Wer stattdessen die Gehrungslaenge nimmt
        // (die bei einem flachen Knick fast genau `h` ist), verwirft den
        // Schnittpunkt bei JEDEM Knick, sobald die Strecken kuerzer als
        // die halbe Strichbreite sind -- und genau das sind die Stuecke
        // einer geglaetteten Kurve. Der Umriss faellt dann an jedem
        // Stueck bis auf die Mittellinie zurueck, die Innenkante wird zum
        // Saegezahn, und der Strich ist innen zu dick. Auf dem Testfall
        // 01 waren das 1,56 % abweichende Bildpunkte, alle an den
        // Innenkanten der Kreise.
        var entlang: f64 = 0.0
        if kreuz < 0.0 {
            entlang = h * (0.0 - kreuz) / (1.0 + c)
        } else {
            entlang = h * kreuz / (1.0 + c)
        }
        if q_da && entlang <= lvor && entlang <= lnach {
            buf_an(b, qx, qy)
        } else {
            buf_an(b, ax, ay)
            buf_an(b, px, py)
            buf_an(b, bx, by)
        }
        return
    }
    if (*st).stoss == S_RUND {
        let a0: f64 = matrix.m_atan2_grad(ay - py, ax - px)
        let a1: f64 = matrix.m_atan2_grad(by - py, bx - px)
        bogen_an(b, px, py, h, a0, a1)
        return
    }
    if (*st).stoss == S_GEHRUNG && q_da && laenge <= (*st).gehrung * h {
        buf_an(b, ax, ay)
        buf_an(b, qx, qy)
        buf_an(b, bx, by)
        return
    }
    // Abgeschraegt -- und der Rueckfall der Gehrung, wenn sie zu lang
    // wuerde.
    buf_an(b, ax, ay)
    buf_an(b, bx, by)
}

// --------------------------------------------------- Die Punktfolge

#[no_gc]
fn schreibe_vor(ziel: *mut path.Pfad, b: *mut mem.Buf, erster: bool) {
    let n: usize = buf_anz(b)
    var i: usize = 0
    while i < n {
        if i == 0 && erster {
            path.pfad_zug(ziel, buf_x(b, 0), buf_y(b, 0))
        } else {
            path.pfad_linie(ziel, buf_x(b, i), buf_y(b, i))
        }
        i = i + 1
    }
}

#[no_gc]
fn schreibe_rueck(ziel: *mut path.Pfad, b: *mut mem.Buf, erster: bool) {
    let n: usize = buf_anz(b)
    if n == 0 {
        return
    }
    var i: i64 = (n as i64) - 1
    while i >= 0 {
        let k: usize = i as usize
        if k == n - 1 && erster {
            path.pfad_zug(ziel, buf_x(b, k), buf_y(b, k))
        } else {
            path.pfad_linie(ziel, buf_x(b, k), buf_y(b, k))
        }
        i = i - 1
    }
}

// Die beiden Versatzlinien einer Punktfolge bauen. `zu` sagt, ob der
// Teilpfad geschlossen ist.
#[no_gc]
fn seiten_bauen(st: *mut Strich, s: *mut Strich, n: usize, zu: bool,
    h: f64) {
    buf_leere(&(*st).lbuf)
    buf_leere(&(*st).rbuf)
    var kanten: usize = n - 1
    if zu {
        kanten = n
    }
    // Ein offener Pfad beginnt mit dem Versatz der ERSTEN Strecke.
    if !zu {
        var dx: f64 = buf_x(&(*s).tmp, 1) - buf_x(&(*s).tmp, 0)
        var dy: f64 = buf_y(&(*s).tmp, 1) - buf_y(&(*s).tmp, 0)
        let l: f64 = matrix.m_sqrt(dx * dx + dy * dy)
        if l <= 0.0 {
            return
        }
        dx = dx / l
        dy = dy / l
        let nx: f64 = 0.0 - dy
        let ny: f64 = dx
        var sx: f64 = buf_x(&(*s).tmp, 0)
        var sy: f64 = buf_y(&(*s).tmp, 0)
        if (*st).kappe == K_ECKIG {
            // Die eckige Kappe ist der um `h` verlaengerte Anfang.
            sx = sx - dx * h
            sy = sy - dy * h
        }
        buf_an(&(*st).lbuf, sx + nx * h, sy + ny * h)
        buf_an(&(*st).rbuf, sx - nx * h, sy - ny * h)
    }
    // Die Knicke.
    var erster_knick: usize = 1
    var letzter_knick: usize = n - 1
    if zu {
        erster_knick = 0
        letzter_knick = n
    }
    var k: usize = erster_knick
    while k < letzter_knick {
        let vor: usize = (k + n - 1) % n
        let nach: usize = (k + 1) % n
        var d0x: f64 = buf_x(&(*s).tmp, k) - buf_x(&(*s).tmp, vor)
        var d0y: f64 = buf_y(&(*s).tmp, k) - buf_y(&(*s).tmp, vor)
        var d1x: f64 = buf_x(&(*s).tmp, nach) - buf_x(&(*s).tmp, k)
        var d1y: f64 = buf_y(&(*s).tmp, nach) - buf_y(&(*s).tmp, k)
        let l0: f64 = matrix.m_sqrt(d0x * d0x + d0y * d0y)
        let l1: f64 = matrix.m_sqrt(d1x * d1x + d1y * d1y)
        if l0 <= 0.0 || l1 <= 0.0 {
            k = k + 1
            continue
        }
        d0x = d0x / l0
        d0y = d0y / l0
        d1x = d1x / l1
        d1y = d1y / l1
        let n0x: f64 = 0.0 - d0y
        let n0y: f64 = d0x
        let n1x: f64 = 0.0 - d1y
        let n1y: f64 = d1x
        let c: f64 = d0x * d1x + d0y * d1y
        let kreuz: f64 = d0x * d1y - d0y * d1x
        // Bei `kreuz > 0` liegt die AUSSENseite rechts, sonst links.
        let links_aussen: bool = kreuz < 0.0
        let px: f64 = buf_x(&(*s).tmp, k)
        let py: f64 = buf_y(&(*s).tmp, k)
        knick_an(&(*st).lbuf, st, px, py, n0x, n0y, n1x, n1y, c, kreuz, h,
            1.0, links_aussen, l0, l1)
        knick_an(&(*st).rbuf, st, px, py, n0x, n0y, n1x, n1y, c, kreuz, h,
            0.0 - 1.0, !links_aussen, l0, l1)
        k = k + 1
    }
    // Das Ende eines offenen Pfades.
    if !zu {
        var dx: f64 = buf_x(&(*s).tmp, n - 1) - buf_x(&(*s).tmp, n - 2)
        var dy: f64 = buf_y(&(*s).tmp, n - 1) - buf_y(&(*s).tmp, n - 2)
        let l: f64 = matrix.m_sqrt(dx * dx + dy * dy)
        if l <= 0.0 {
            return
        }
        dx = dx / l
        dy = dy / l
        let nx: f64 = 0.0 - dy
        let ny: f64 = dx
        var ex: f64 = buf_x(&(*s).tmp, n - 1)
        var ey: f64 = buf_y(&(*s).tmp, n - 1)
        if (*st).kappe == K_ECKIG {
            ex = ex + dx * h
            ey = ey + dy * h
        }
        buf_an(&(*st).lbuf, ex + nx * h, ey + ny * h)
        buf_an(&(*st).rbuf, ex - nx * h, ey - ny * h)
    }
}

// Die RUNDE KAPPE, direkt in den Zielpfad.
//
// Sie ist immer ein HALBKREIS, und die Richtung ist NICHT die kuerzere
// von zweien -- bei genau 180 Grad gibt es keine kuerzere. Sie ergibt
// sich aus der Bauart des Umrisses: die linke Seite liegt bei der
// Normalen `n = (-dy, dx)`, die Laufrichtung `d` also bei
// `winkel(n) - 90`. Ein Bogen, der von der linken zur rechten Seite mit
// FALLENDEM Winkel laeuft, geht damit ueber `winkel(d)`, also ueber das
// Ende hinaus -- und das ist die Aussenseite.
//
// Wer stattdessen die kuerzere Richtung nimmt, bekommt bei einer Linie,
// die nach links laeuft, die Kappe auf der falschen Seite: der Halbkreis
// liegt dann IM Strich statt vor ihm. Gegen Chromium gemessen waren das
// auf tests/grafik/aufbau/striche_kappen.svg volle 255 Stufen
// Abweichung.
#[no_gc]
fn kappe_bogen(ziel: *mut path.Pfad, cx: f64, cy: f64, h: f64, a0: f64) {
    bogen_in_pfad(ziel, cx, cy, h, a0, 0.0 - 180.0)
}

// Ein Bogen direkt in den Zielpfad. `d` ist die vorzeichenbehaftete
// Weite in Grad, NICHT der Zielwinkel.
#[no_gc]
fn bogen_in_pfad(ziel: *mut path.Pfad, cx: f64, cy: f64, h: f64, a0: f64,
    d: f64) {
    var k: i64 = ((matrix.m_abs(d) * h / 90.0) as i64) + 2
    if k > 48 {
        k = 48
    }
    var i: i64 = 1
    while i <= k {
        let t: f64 = a0 + d * ((i as f64) / (k as f64))
        path.pfad_linie(ziel, cx + h * matrix.m_cos(t),
            cy + h * matrix.m_sin(t))
        i = i + 1
    }
}

// Eine offene oder geschlossene Punktfolge bestreichen.
#[no_gc]
fn folge_bestreichen(ziel: *mut path.Pfad, st: *mut Strich,
    s: *mut Strich, n: usize, zu: bool) {
    let h: f64 = (*st).breite / 2.0
    if h <= 0.0 || n == 0 {
        return
    }
    if n == 1 {
        // Ein einzelner Punkt. Nach SVG 1.1, 11.4 zeichnen runde und
        // eckige Kappen hier einen Punkt, stumpfe nichts.
        let x: f64 = buf_x(&(*s).tmp, 0)
        let y: f64 = buf_y(&(*s).tmp, 0)
        if (*st).kappe == K_RUND {
            path.pfad_kreis(ziel, x, y, h)
        } else if (*st).kappe == K_ECKIG {
            path.pfad_rechteck(ziel, x - h, y - h, h * 2.0, h * 2.0)
        }
        return
    }
    seiten_bauen(st, s, n, zu, h)
    let nl: usize = buf_anz(&(*st).lbuf)
    let nr: usize = buf_anz(&(*st).rbuf)
    if nl < 2 || nr < 2 {
        return
    }
    if zu {
        // ZWEI RINGE, gegenlaeufig -- sonst waere das Loch zu.
        schreibe_vor(ziel, &(*st).lbuf, true)
        path.pfad_zu(ziel)
        schreibe_rueck(ziel, &(*st).rbuf, true)
        path.pfad_zu(ziel)
        return
    }
    // EIN Umriss: linke Seite hin, Endkappe, rechte Seite zurueck,
    // Anfangskappe. Die stumpfe und die eckige Kappe brauchen keine
    // eigenen Punkte -- die eckige steckt schon im Versatz der Enden.
    schreibe_vor(ziel, &(*st).lbuf, true)
    if (*st).kappe == K_RUND {
        let ex: f64 = buf_x(&(*s).tmp, n - 1)
        let ey: f64 = buf_y(&(*s).tmp, n - 1)
        let a0: f64 = matrix.m_atan2_grad(buf_y(&(*st).lbuf, nl - 1) - ey,
            buf_x(&(*st).lbuf, nl - 1) - ex)
        kappe_bogen(ziel, ex, ey, h, a0)
        let unbenutzt: usize = nr
    }
    schreibe_rueck(ziel, &(*st).rbuf, false)
    if (*st).kappe == K_RUND {
        let sx: f64 = buf_x(&(*s).tmp, 0)
        let sy: f64 = buf_y(&(*s).tmp, 0)
        let a0: f64 = matrix.m_atan2_grad(buf_y(&(*st).rbuf, 0) - sy,
            buf_x(&(*st).rbuf, 0) - sx)
        kappe_bogen(ziel, sx, sy, h, a0)
    }
    path.pfad_zu(ziel)
}

// ------------------------------------------------------------- Striche
//
// `stroke-dasharray` wird auf der GEGLAETTETEN Linie abgetragen, also auf
// der Folge von Strecken. Das ist auch die Vorschrift: die Laenge, die
// gemeint ist, ist die Bogenlaenge des Pfades.
//
// Eine UNGERADE Zahl von Werten wird verdoppelt (`5 3 2` heisst
// `5 3 2 5 3 2`) -- das steht so in SVG 1.1, und ohne diese Regel saehe
// ein `stroke-dasharray: 4` (ein einziger Wert) falsch aus.

#[no_gc]
fn musterlaenge(s: *mut Strich) -> f64 {
    var summe: f64 = 0.0
    var i: usize = 0
    while i < (*s).n_striche {
        summe = summe + (*s).striche[i]
        i = i + 1
    }
    if (*s).n_striche % 2 == 1 {
        summe = summe * 2.0
    }
    return summe
}

#[no_gc]
fn strichwert(s: *mut Strich, i: usize) -> f64 {
    let n: usize = (*s).n_striche
    if n == 0 {
        return 0.0
    }
    return (*s).striche[i % n]
}

// Die Mittellinie mit dem Muster zerschneiden und die Stuecke einzeln
// bestreichen. `s` haelt die Punkte, `hilf` nimmt das laufende Stueck
// auf, `st` liefert den Stil.
#[no_gc]
fn folge_stricheln(ziel: *mut path.Pfad, st: *mut Strich, s: *mut Strich,
    hilf: *mut Strich, n: usize, zu: bool) {
    let gesamt: f64 = musterlaenge(st)
    if gesamt <= 0.0 || n < 2 {
        return
    }
    var rest: f64 = (*st).versatz
    rest = rest - matrix.m_floor(rest / gesamt) * gesamt
    var idx: usize = 0
    var wachhund: usize = 0
    while rest >= strichwert(st, idx) {
        rest = rest - strichwert(st, idx)
        idx = idx + 1
        wachhund = wachhund + 1
        if wachhund > 4096 {
            return
        }
    }
    var uebrig: f64 = strichwert(st, idx) - rest
    var an: bool = (idx % 2) == 0
    buf_leere(&(*hilf).tmp)
    if an {
        buf_an_neu(&(*hilf).tmp, buf_x(&(*s).tmp, 0), buf_y(&(*s).tmp, 0))
    }
    var kanten: usize = n - 1
    if zu {
        kanten = n
    }
    var i: usize = 0
    while i < kanten {
        let j: usize = (i + 1) % n
        var x0: f64 = buf_x(&(*s).tmp, i)
        var y0: f64 = buf_y(&(*s).tmp, i)
        let x1: f64 = buf_x(&(*s).tmp, j)
        let y1: f64 = buf_y(&(*s).tmp, j)
        var dx: f64 = x1 - x0
        var dy: f64 = y1 - y0
        var l: f64 = matrix.m_sqrt(dx * dx + dy * dy)
        if l <= 0.0 {
            i = i + 1
            continue
        }
        dx = dx / l
        dy = dy / l
        while l > uebrig {
            let nx: f64 = x0 + dx * uebrig
            let ny: f64 = y0 + dy * uebrig
            if an {
                buf_an_neu(&(*hilf).tmp, nx, ny)
                folge_bestreichen(ziel, st, hilf, buf_anz(&(*hilf).tmp),
                    false)
                buf_leere(&(*hilf).tmp)
            } else {
                buf_leere(&(*hilf).tmp)
                buf_an_neu(&(*hilf).tmp, nx, ny)
            }
            an = !an
            l = l - uebrig
            x0 = nx
            y0 = ny
            idx = idx + 1
            uebrig = strichwert(st, idx)
            if uebrig <= 0.0 {
                // Ein Muster wie `5 0`: der Aus-Teil hat Laenge null.
                // Ohne diesen Ausstieg dreht sich die Schleife ewig.
                uebrig = gesamt
            }
        }
        uebrig = uebrig - l
        if an {
            buf_an_neu(&(*hilf).tmp, x1, y1)
        }
        i = i + 1
    }
    if an && buf_anz(&(*hilf).tmp) > 0 {
        folge_bestreichen(ziel, st, hilf, buf_anz(&(*hilf).tmp), false)
    }
}

// DER EINSTIEG. `quelle` muss GEGLAETTET sein (nur `V_ZUG`, `V_LINIE`,
// `V_ZU`); `pfad.pfad_glaette` liefert genau das. Heraus kommt ein Pfad,
// den man mit der Nichtnull-Regel fuellt.
#[no_gc]
fn strich_umriss(ziel: *mut path.Pfad, quelle: *mut path.Pfad,
    s: *mut Strich, hilf: *mut Strich) {
    path.pfad_leere(ziel)
    if (*s).breite <= 0.0 {
        return
    }
    let strichelt: bool = strich_hat_striche(s)
    let nv: usize = path.pfad_verben(quelle)
    var pi: usize = 0
    var i: usize = 0
    var offen: bool = false
    buf_leere(&(*s).tmp)
    while i < nv {
        let v: u32 = path.pfad_verb(quelle, i)
        if v == path.V_ZUG {
            if offen && buf_anz(&(*s).tmp) > 0 {
                if strichelt {
                    folge_stricheln(ziel, s, s, hilf, buf_anz(&(*s).tmp),
                        false)
                } else {
                    folge_bestreichen(ziel, s, s, buf_anz(&(*s).tmp), false)
                }
            }
            buf_leere(&(*s).tmp)
            buf_an_neu(&(*s).tmp, path.pfad_px(quelle, pi),
                path.pfad_py(quelle, pi))
            pi = pi + 1
            offen = true
        } else if v == path.V_LINIE {
            buf_an_neu(&(*s).tmp, path.pfad_px(quelle, pi),
                path.pfad_py(quelle, pi))
            pi = pi + 1
        } else if v == path.V_ZU {
            if offen && buf_anz(&(*s).tmp) > 0 {
                // Ein geschlossener Teilpfad hat keine Kappen, aber einen
                // Knick auch am Anfangspunkt. Faellt der letzte Punkt mit
                // dem ersten zusammen, wird er gestrichen, sonst gaebe es
                // dort eine Strecke der Laenge null.
                var m: usize = buf_anz(&(*s).tmp)
                if m > 1 && buf_x(&(*s).tmp, m - 1) == buf_x(&(*s).tmp, 0)
                    && buf_y(&(*s).tmp, m - 1) == buf_y(&(*s).tmp, 0) {
                    mem.buf_set_len(&(*s).tmp, (m - 1) * 16)
                    m = m - 1
                }
                if strichelt {
                    folge_stricheln(ziel, s, s, hilf, m, true)
                } else {
                    folge_bestreichen(ziel, s, s, m, true)
                }
            }
            buf_leere(&(*s).tmp)
            offen = false
        } else {
            // Quadratische und kubische Stuecke duerfen hier nicht mehr
            // vorkommen; falls doch, werden ihre Endpunkte als Ecken
            // genommen, damit nichts still verschwindet.
            if v == path.V_QUAD {
                buf_an_neu(&(*s).tmp, path.pfad_px(quelle, pi + 1),
                    path.pfad_py(quelle, pi + 1))
                pi = pi + 2
            } else {
                buf_an_neu(&(*s).tmp, path.pfad_px(quelle, pi + 2),
                    path.pfad_py(quelle, pi + 2))
                pi = pi + 3
            }
        }
        i = i + 1
    }
    if offen && buf_anz(&(*s).tmp) > 0 {
        if strichelt {
            folge_stricheln(ziel, s, s, hilf, buf_anz(&(*s).tmp), false)
        } else {
            folge_bestreichen(ziel, s, s, buf_anz(&(*s).tmp), false)
        }
    }
    buf_leere(&(*s).tmp)
}
