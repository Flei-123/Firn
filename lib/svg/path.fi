// SPDX-License-Identifier: MPL-2.0
// Provenance: Certus, lib/svg/ (last changed in Certus commit 8f138f02), ported to
// Firn in 0e1a1196; released by the sole author Justin on 25.09.2026 for Firn
// under MPL-2.0.
// lib/svg/path.fi -- THE PATH. The language of the `d` attribute, and the
// memory in which a path lies between reading and painting.
//
// A path here is two buffers:
//
//   `vb`  one octet per COMMAND   -- move, line, quad, cubic, close
//   `pt`  two `f64` per POINT     -- the points in the order in which
//                                  the commands consume them
//
// Why separate and not one record per command: a `moveto` needs
// one point, a `curveto` three, a `closepath` none. A uniform
// record would be three times as large as necessary for every line, and
// a symbol collection like Remixicon consists almost only of lines.
//
// NO CIRCULAR ARCS IN MEMORY. The command `A` is converted already while reading into
// cubic Beziers. That is the important decision of this file:
// everything behind the parser sees only four kinds of command, and
// the rasteriser, the stroking, the outlines and the hit test
// need not each be able to do the arc individually.
//
// ---------------------------------------------------- THE ARC, RIGHT
//
// The command `A rx ry rotation large sweep x y` gives the END POINT; the
// ellipse behind it, however, has a CENTRE, and that stands nowhere.
// SVG 1.1, appendix F.6.5 converts the one into the other, and F.6.6 says
// what happens with impossible statements. Both are written out here,
// because exactly here most versions are wrong:
//
//   * If start and end are EQUAL, the arc is, by F.6.2, not a full circle, but
//     it is OMITTED entirely. Whoever draws a circle instead paints a blob
//     in every second symbol.
//   * If `rx` or `ry` is ZERO, the arc becomes a STRAIGHT LINE.
//   * If the radii are TOO SMALL to connect the two points, they are
//     both ENLARGED by the same factor (F.6.6.2), and exactly
//     so far that the arc works out. Whoever leaves that out gets a negative
//     number under the root and paints nothing at all -- that is the
//     counter-check (i) in docs/ROUNDGRAFIK.md.
//   * The radii are taken by MAGNITUDE; a negative radius is
//     no error, but the same arc.
import html.mem
import font.raster
import svg.matrix

export {
    Path,
    V_ZUG, V_LINE, V_QUAD, V_CUBIC, V_ZU,
    path_new, path_init, path_free, path_empty, path_ok,
    path_move, path_line, path_quad, path_cubic, path_too,
    path_verbs, path_verb, path_points, path_px, path_py,
    path_last_x, path_last_y, path_start_x, path_start_y,
    path_is_empty, path_has_area,
    path_rect, path_round_rect, path_ellipse, path_circle,
    path_arc_too, path_arc_mid,
    split_d, split_points,
    path_an_raster, path_limits, path_copy, path_attachments,
    path_smooth,
}

// The five kinds of command. There are no more, and that is deliberate.
const V_ZUG: u32 = 0 // moveto -- beginnt einen neuen Teilpfad
const V_LINE: u32 = 1 // lineto
const V_QUAD: u32 = 2 // quadratic curveto, zwei Punkte
const V_CUBIC: u32 = 3 // cubic curveto, drei Punkte
const V_ZU: u32 = 4 // closepath, kein Punkt

struct Path {
    vb: mem.Buf, // ein Oktett je Befehl
    pt: mem.Buf, // 16 Oktette je Punkt
    lx: f64, // der aktuelle Punkt
    ly: f64,
    ax: f64, // der Anfang des laufenden Teilpfades (fuer `Z`)
    ay: f64,
    open: usize, // 1, solange ein Teilpfad laeuft
}

#[no_gc]
fn path_new() -> Path {
    return Path {
        vb: mem.buf_new(),
        pt: mem.buf_new(),
        lx: 0.0,
        ly: 0.0,
        ax: 0.0,
        ay: 0.0,
        open: 0,
    }
}

#[no_gc]
fn path_init(p: *mut Path) {
    mem.buf_init(&(*p).vb)
    mem.buf_init(&(*p).pt)
    (*p).lx = 0.0
    (*p).ly = 0.0
    (*p).ax = 0.0
    (*p).ay = 0.0
    (*p).open = 0
}

#[no_gc]
fn path_free(p: *mut Path) {
    mem.buf_free(&(*p).vb)
    mem.buf_free(&(*p).pt)
    (*p).open = 0
}

#[no_gc]
fn path_empty(p: *mut Path) {
    mem.buf_clear(&(*p).vb)
    mem.buf_clear(&(*p).pt)
    (*p).lx = 0.0
    (*p).ly = 0.0
    (*p).ax = 0.0
    (*p).ay = 0.0
    (*p).open = 0
}

#[no_gc]
fn path_ok(p: *mut Path) -> bool {
    return true
}

#[no_gc]
fn path_verbs(p: *mut Path) -> usize {
    return mem.buf_len(&(*p).vb)
}

#[no_gc]
fn path_verb(p: *mut Path, i: usize) -> u32 {
    return mem.buf_at(&(*p).vb, i) as u32
}

#[no_gc]
fn path_points(p: *mut Path) -> usize {
    return mem.buf_len(&(*p).pt) / 16
}

#[no_gc]
fn path_px(p: *mut Path, i: usize) -> f64 {
    if i >= path_points(p) {
        return 0.0
    }
    return *((mem.buf_ptr(&(*p).pt) as u64 + (i * 16) as u64) as *mut f64)
}

#[no_gc]
fn path_py(p: *mut Path, i: usize) -> f64 {
    if i >= path_points(p) {
        return 0.0
    }
    return *((mem.buf_ptr(&(*p).pt) as u64 + (i * 16 + 8) as u64) as *mut f64)
}

#[no_gc]
fn path_last_x(p: *mut Path) -> f64 {
    return (*p).lx
}

#[no_gc]
fn path_last_y(p: *mut Path) -> f64 {
    return (*p).ly
}

#[no_gc]
fn path_start_x(p: *mut Path) -> f64 {
    return (*p).ax
}

#[no_gc]
fn path_start_y(p: *mut Path) -> f64 {
    return (*p).ay
}

#[no_gc]
fn path_is_empty(p: *mut Path) -> bool {
    return mem.buf_len(&(*p).vb) == 0
}

// Does the path have anything at all that can have an area? A path
// that consists only of `moveto` has none.
#[no_gc]
fn path_has_area(p: *mut Path) -> bool {
    let n: usize = mem.buf_len(&(*p).vb)
    var i: usize = 0
    while i < n {
        let v: u32 = mem.buf_at(&(*p).vb, i) as u32
        if v == V_LINE || v == V_QUAD || v == V_CUBIC {
            return true
        }
        i = i + 1
    }
    return false
}

#[no_gc]
fn dot_an(p: *mut Path, x: f64, y: f64) {
    let n: usize = mem.buf_len(&(*p).pt)
    mem.buf_reserve(&(*p).pt, n + 16)
    mem.buf_set_len(&(*p).pt, n + 16)
    let b: u64 = mem.buf_ptr(&(*p).pt) as u64
    *((b + n as u64) as *mut f64) = x
    *((b + (n + 8) as u64) as *mut f64) = y
}

#[no_gc]
fn path_move(p: *mut Path, x: f64, y: f64) {
    mem.buf_push(&(*p).vb, V_ZUG as u8)
    dot_an(p, x, y)
    (*p).lx = x
    (*p).ly = y
    (*p).ax = x
    (*p).ay = y
    (*p).open = 1
}

#[no_gc]
fn path_line(p: *mut Path, x: f64, y: f64) {
    if (*p).open == 0 {
        path_move(p, (*p).lx, (*p).ly)
    }
    mem.buf_push(&(*p).vb, V_LINE as u8)
    dot_an(p, x, y)
    (*p).lx = x
    (*p).ly = y
}

#[no_gc]
fn path_quad(p: *mut Path, cx: f64, cy: f64, x: f64, y: f64) {
    if (*p).open == 0 {
        path_move(p, (*p).lx, (*p).ly)
    }
    mem.buf_push(&(*p).vb, V_QUAD as u8)
    dot_an(p, cx, cy)
    dot_an(p, x, y)
    (*p).lx = x
    (*p).ly = y
}

#[no_gc]
fn path_cubic(p: *mut Path, c1x: f64, c1y: f64, c2x: f64, c2y: f64,
    x: f64, y: f64) {
    if (*p).open == 0 {
        path_move(p, (*p).lx, (*p).ly)
    }
    mem.buf_push(&(*p).vb, V_CUBIC as u8)
    dot_an(p, c1x, c1y)
    dot_an(p, c2x, c2y)
    dot_an(p, x, y)
    (*p).lx = x
    (*p).ly = y
}

// `closepath`. The current point jumps back to the start of the subpath
// -- that is the difference that a `M 10 10 L 20 20 Z l 5 0` makes
// visible: the `l` begins at (10,10) and not at (20,20).
#[no_gc]
fn path_too(p: *mut Path) {
    if (*p).open == 0 {
        return
    }
    mem.buf_push(&(*p).vb, V_ZU as u8)
    (*p).lx = (*p).ax
    (*p).ly = (*p).ay
    (*p).open = 0
}

// ----------------------------------------------------------- Grundformen

#[no_gc]
fn path_rect(p: *mut Path, x: f64, y: f64, w: f64, h: f64) {
    if w <= 0.0 || h <= 0.0 {
        return
    }
    path_move(p, x, y)
    path_line(p, x + w, y)
    path_line(p, x + w, y + h)
    path_line(p, x, y + h)
    path_too(p)
}

// The number with which a quarter circle is built as a cubic Bezier:
// 4/3 * (sqrt(2) - 1). As a function, because `const` in this language knows
// only whole numbers (SPEC 14.1, point 4).
#[no_gc]
fn kappa() -> f64 {
    return 0.5522847498307936
}

// `rect` with `rx`/`ry`, by SVG 1.1 section 9.2: the corners are
// quarter ellipses, and radii that are too large are shortened to half the side
// length.
#[no_gc]
fn path_round_rect(p: *mut Path, x: f64, y: f64, w: f64, h: f64,
    rx_in: f64, ry_in: f64) {
    if w <= 0.0 || h <= 0.0 {
        return
    }
    var rx: f64 = rx_in
    var ry: f64 = ry_in
    if rx < 0.0 {
        rx = 0.0
    }
    if ry < 0.0 {
        ry = 0.0
    }
    if rx > w / 2.0 {
        rx = w / 2.0
    }
    if ry > h / 2.0 {
        ry = h / 2.0
    }
    if rx <= 0.0 || ry <= 0.0 {
        path_rect(p, x, y, w, h)
        return
    }
    let kx: f64 = rx * kappa()
    let ky: f64 = ry * kappa()
    let x1: f64 = x + w
    let y1: f64 = y + h
    path_move(p, x + rx, y)
    path_line(p, x1 - rx, y)
    path_cubic(p, x1 - rx + kx, y, x1, y + ry - ky, x1, y + ry)
    path_line(p, x1, y1 - ry)
    path_cubic(p, x1, y1 - ry + ky, x1 - rx + kx, y1, x1 - rx, y1)
    path_line(p, x + rx, y1)
    path_cubic(p, x + rx - kx, y1, x, y1 - ry + ky, x, y1 - ry)
    path_line(p, x, y + ry)
    path_cubic(p, x, y + ry - ky, x + rx - kx, y, x + rx, y)
    path_too(p)
}

// An ellipse from four quarter arcs. The direction is clockwise
// in the screen system (y down) -- the same as with `rect`, so that
// a hole in a figure with `fill-rule: nonzero` is one only if
// it really runs the other way round.
#[no_gc]
fn path_ellipse(p: *mut Path, cx: f64, cy: f64, rx: f64, ry: f64) {
    if rx <= 0.0 || ry <= 0.0 {
        return
    }
    let kx: f64 = rx * kappa()
    let ky: f64 = ry * kappa()
    path_move(p, cx + rx, cy)
    path_cubic(p, cx + rx, cy + ky, cx + kx, cy + ry, cx, cy + ry)
    path_cubic(p, cx - kx, cy + ry, cx - rx, cy + ky, cx - rx, cy)
    path_cubic(p, cx - rx, cy - ky, cx - kx, cy - ry, cx, cy - ry)
    path_cubic(p, cx + kx, cy - ry, cx + rx, cy - ky, cx + rx, cy)
    path_too(p)
}

#[no_gc]
fn path_circle(p: *mut Path, cx: f64, cy: f64, r: f64) {
    path_ellipse(p, cx, cy, r, r)
}

// ---------------------------------------------------------- The arc
//
// An arc piece in CENTRE representation as cubic Beziers. The
// angles stand in DEGREES, `dtheta` may be negative.
//
// The approximation of an elliptical arc by a cubic Bezier is good
// as long as the piece is not too large; at 90 degrees the error is
// 2.7e-4 of the radius, so at a radius of 1000 pixels under
// a third of a pixel. That is why every arc is split into pieces of
// at most 90 degrees.
#[no_gc]
fn path_arc_mid(p: *mut Path, cx: f64, cy: f64, rx: f64, ry: f64,
    phi: f64, theta1: f64, dtheta: f64) {
    var d: f64 = dtheta
    if d == 0.0 {
        return
    }
    var pieces: i64 = ((matrix.m_abs(d) / 90.0) as i64) + 1
    if pieces > 64 {
        pieces = 64
    }
    let step: f64 = d / (pieces as f64)
    // alpha = 4/3 * tan(step/4), the length of the tangent pieces.
    let alpha: f64 = 4.0 / 3.0 * matrix.m_tan(step / 4.0)
    let cphi: f64 = matrix.m_cos(phi)
    let sphi: f64 = matrix.m_sin(phi)
    var k: i64 = 0
    var t: f64 = theta1
    while k < pieces {
        let t2: f64 = t + step
        let c1: f64 = matrix.m_cos(t)
        let s1: f64 = matrix.m_sin(t)
        let c2: f64 = matrix.m_cos(t2)
        let s2: f64 = matrix.m_sin(t2)
        // E(t) and E'(t) in world coordinates.
        let e1x: f64 = cx + rx * c1 * cphi - ry * s1 * sphi
        let e1y: f64 = cy + rx * c1 * sphi + ry * s1 * cphi
        let e2x: f64 = cx + rx * c2 * cphi - ry * s2 * sphi
        let e2y: f64 = cy + rx * c2 * sphi + ry * s2 * cphi
        let d1x: f64 = 0.0 - rx * s1 * cphi - ry * c1 * sphi
        let d1y: f64 = 0.0 - rx * s1 * sphi + ry * c1 * cphi
        let d2x: f64 = 0.0 - rx * s2 * cphi - ry * c2 * sphi
        let d2y: f64 = 0.0 - rx * s2 * sphi + ry * c2 * cphi
        path_cubic(p, e1x + alpha * d1x, e1y + alpha * d1y,
            e2x - alpha * d2x, e2y - alpha * d2y, e2x, e2y)
        t = t2
        k = k + 1
    }
}

// The angle between two vectors, in degrees, with sign, in
// (-180, 180].
#[no_gc]
fn winkel(ux: f64, uy: f64, vx: f64, vy: f64) -> f64 {
    return matrix.m_atan2_grad(ux * vy - uy * vx, ux * vx + uy * vy)
}

// THE ARC IN END-POINT REPRESENTATION -- SVG 1.1, F.6.5 and F.6.6.
// The start point is the current point of the path.
#[no_gc]
fn path_arc_too(p: *mut Path, rx_in: f64, ry_in: f64, phi_in: f64,
    big: bool, sweep: bool, x2: f64, y2: f64) {
    let x1: f64 = (*p).lx
    let y1: f64 = (*p).ly
    // F.6.2: same start and same end -> the arc is OMITTED.
    if x1 == x2 && y1 == y2 {
        return
    }
    var rx: f64 = matrix.m_abs(rx_in)
    var ry: f64 = matrix.m_abs(ry_in)
    // F.6.2: a radius of zero -> a STRAIGHT LINE.
    if rx == 0.0 || ry == 0.0 {
        path_line(p, x2, y2)
        return
    }
    let phi: f64 = phi_in
    let cphi: f64 = matrix.m_cos(phi)
    let sphi: f64 = matrix.m_sin(phi)
    // Step 1: into the rotated system relative to the middle of the chord.
    let hx: f64 = (x1 - x2) / 2.0
    let hy: f64 = (y1 - y2) / 2.0
    let x1s: f64 = cphi * hx + sphi * hy
    let y1s: f64 = 0.0 - sphi * hx + cphi * hy
    // F.6.6.2: radii that are too small are ENLARGED, both by the same
    // factor. Without that a negative number stands under the root in step 2.
    var rx2: f64 = rx * rx
    var ry2: f64 = ry * ry
    let lam: f64 = x1s * x1s / rx2 + y1s * y1s / ry2
    if lam > 1.0 {
        let s: f64 = matrix.m_sqrt(lam)
        rx = rx * s
        ry = ry * s
        rx2 = rx * rx
        ry2 = ry * ry
    }
    // Step 2: the centre in the rotated system.
    let nenner: f64 = rx2 * y1s * y1s + ry2 * x1s * x1s
    var factor: f64 = 0.0
    if nenner > 0.0 {
        var z: f64 = (rx2 * ry2 - nenner) / nenner
        if z < 0.0 {
            // Only rounding; after the correction above this can at most
            // be a tiny negative number.
            z = 0.0
        }
        factor = matrix.m_sqrt(z)
    }
    if big == sweep {
        factor = 0.0 - factor
    }
    let cxs: f64 = factor * rx * y1s / ry
    let cys: f64 = 0.0 - factor * ry * x1s / rx
    // Step 3: back into the world system.
    let cx: f64 = cphi * cxs - sphi * cys + (x1 + x2) / 2.0
    let cy: f64 = sphi * cxs + cphi * cys + (y1 + y2) / 2.0
    // Step 4: start angle and swept angle.
    let ux: f64 = (x1s - cxs) / rx
    let uy: f64 = (y1s - cys) / ry
    let vx: f64 = (0.0 - x1s - cxs) / rx
    let vy: f64 = (0.0 - y1s - cys) / ry
    let theta1: f64 = matrix.m_atan2_grad(uy, ux)
    var dtheta: f64 = winkel(ux, uy, vx, vy)
    if !sweep && dtheta > 0.0 {
        dtheta = dtheta - 360.0
    }
    if sweep && dtheta < 0.0 {
        dtheta = dtheta + 360.0
    }
    path_arc_mid(p, cx, cy, rx, ry, phi, theta1, dtheta)
    // The end point is set EXACTLY and not taken over from the Bezier:
    // the approximation hits it to 1e-16, and a following `z` is to
    // go back to the point that stands in the text.
    (*p).lx = x2
    (*p).ly = y2
}

// ------------------------------------------------------- The `d` attribute
//
// The grammar of SVG 1.1, appendix F.10 -- in short:
//
//   * a letter, then as many numbers as the command needs;
//   * if EVEN MORE numbers follow, the same command is repeated. The
//     exception is `M`/`m`: a repetition of `M` is an `L`, a
//     repetition of `m` an `l`. That is the rule that almost every
//     hand-written version forgets, and without it every polygon becomes
//     a cloud of points.
//   * Lower-case letters are RELATIVE to the current point.
//   * `S`/`s` and `T`/`t` mirror the last control point. If there was
//     NO curve of the same kind before it, the mirrored control point is
//     the current point itself.
//   * With the flags of `A` ONE character is a flag: `a1 1 0 011 5 5` is
//     valid and means large=0, sweep=1, x=1. Whoever calls `zahl` here
//     reads 011 as eleven and paints nonsense.
//
// ERROR: processing breaks off, the path up to there STAYS. That is how the
// specification says it (F.10, "error handling"), and that is how Chromium does it.

#[no_gc]
fn is_letter(c: u32) -> bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
}

#[no_gc]
fn small(c: u32) -> u32 {
    if c >= 65 && c <= 90 {
        return c + 32
    }
    return c
}

// A flag of `A`: exactly one character, `0` or `1`.
#[no_gc]
fn flag(p: u64, n: usize, i: *mut usize, ok: *mut bool) -> bool {
    matrix.skip_sep(p, n, i)
    if *i >= n {
        *ok = false
        return false
    }
    let c: u32 = matrix.read_byte(p, *i)
    if c == 48 {
        *i = *i + 1
        *ok = true
        return false
    }
    if c == 49 {
        *i = *i + 1
        *ok = true
        return true
    }
    *ok = false
    return false
}

#[no_gc]
fn next_number(p: u64, n: usize, i: *mut usize, ok: *mut bool) -> f64 {
    matrix.skip_sep(p, n, i)
    return matrix.number(p, n, i, ok)
}

// Does a number still stand at this place (so a repetition of the
// command)?
#[no_gc]
fn still_a_number(p: u64, n: usize, i: usize) -> bool {
    var j: usize = i
    matrix.skip_sep(p, n, &j)
    if j >= n {
        return false
    }
    let c: u32 = matrix.read_byte(p, j)
    return matrix.is_digit(c) || c == 43 || c == 45 || c == 46
}

#[no_gc]
fn split_d(pf: *mut Path, p: u64, n: usize) -> bool {
    var i: usize = 0
    var insn: u32 = 0
    var had: bool = false
    // The mirrored control point: `sk` for S/s (cubic), `sq` for
    // T/t (quadratic). If `gilt` stands at 0, it is the current point.
    var skx: f64 = 0.0
    var sky: f64 = 0.0
    var sk_gilt: usize = 0
    var sqx: f64 = 0.0
    var sqy: f64 = 0.0
    var sq_gilt: usize = 0
    matrix.skip_empty(p, n, &i)
    while i < n {
        var c: u32 = matrix.read_byte(p, i)
        if is_letter(c) {
            insn = c
            i = i + 1
        } else if !had {
            // A `d` that does not begin with a letter is
            // invalid -- and so is a `d` that does not begin with `M` or `m`.
            return false
        } else if !still_a_number(p, n, i) {
            return false
        }
        let kb: u32 = small(insn)
        let rel: bool = insn >= 97
        if !had && kb != 109 {
            return false
        }
        had = true
        var ok: bool = false
        var bx: f64 = 0.0
        var by: f64 = 0.0
        if rel {
            bx = (*pf).lx
            by = (*pf).ly
        }
        if kb == 109 {
            // M / m
            let x: f64 = next_number(p, n, &i, &ok) + bx
            if !ok {
                return false
            }
            let y: f64 = next_number(p, n, &i, &ok) + by
            if !ok {
                return false
            }
            path_move(pf, x, y)
            sk_gilt = 0
            sq_gilt = 0
            // The repetition of an `M` is an `L`.
            if insn == 77 {
                insn = 76
            } else {
                insn = 108
            }
        } else if kb == 108 {
            // L / l
            let x: f64 = next_number(p, n, &i, &ok) + bx
            if !ok {
                return false
            }
            let y: f64 = next_number(p, n, &i, &ok) + by
            if !ok {
                return false
            }
            path_line(pf, x, y)
            sk_gilt = 0
            sq_gilt = 0
        } else if kb == 104 {
            // H / h
            let x: f64 = next_number(p, n, &i, &ok) + bx
            if !ok {
                return false
            }
            path_line(pf, x, (*pf).ly)
            sk_gilt = 0
            sq_gilt = 0
        } else if kb == 118 {
            // V / v
            let y: f64 = next_number(p, n, &i, &ok) + by
            if !ok {
                return false
            }
            path_line(pf, (*pf).lx, y)
            sk_gilt = 0
            sq_gilt = 0
        } else if kb == 99 {
            // C / c
            let ax: f64 = next_number(p, n, &i, &ok) + bx
            if !ok {
                return false
            }
            let ay: f64 = next_number(p, n, &i, &ok) + by
            if !ok {
                return false
            }
            let cx: f64 = next_number(p, n, &i, &ok) + bx
            if !ok {
                return false
            }
            let cy: f64 = next_number(p, n, &i, &ok) + by
            if !ok {
                return false
            }
            let x: f64 = next_number(p, n, &i, &ok) + bx
            if !ok {
                return false
            }
            let y: f64 = next_number(p, n, &i, &ok) + by
            if !ok {
                return false
            }
            path_cubic(pf, ax, ay, cx, cy, x, y)
            skx = cx
            sky = cy
            sk_gilt = 1
            sq_gilt = 0
        } else if kb == 115 {
            // S / s -- the first control point is the mirroring of the
            // second of the previous cubic curve at the current point.
            var ax: f64 = (*pf).lx
            var ay: f64 = (*pf).ly
            if sk_gilt == 1 {
                ax = 2.0 * (*pf).lx - skx
                ay = 2.0 * (*pf).ly - sky
            }
            let cx: f64 = next_number(p, n, &i, &ok) + bx
            if !ok {
                return false
            }
            let cy: f64 = next_number(p, n, &i, &ok) + by
            if !ok {
                return false
            }
            let x: f64 = next_number(p, n, &i, &ok) + bx
            if !ok {
                return false
            }
            let y: f64 = next_number(p, n, &i, &ok) + by
            if !ok {
                return false
            }
            path_cubic(pf, ax, ay, cx, cy, x, y)
            skx = cx
            sky = cy
            sk_gilt = 1
            sq_gilt = 0
        } else if kb == 113 {
            // Q / q
            let cx: f64 = next_number(p, n, &i, &ok) + bx
            if !ok {
                return false
            }
            let cy: f64 = next_number(p, n, &i, &ok) + by
            if !ok {
                return false
            }
            let x: f64 = next_number(p, n, &i, &ok) + bx
            if !ok {
                return false
            }
            let y: f64 = next_number(p, n, &i, &ok) + by
            if !ok {
                return false
            }
            path_quad(pf, cx, cy, x, y)
            sqx = cx
            sqy = cy
            sq_gilt = 1
            sk_gilt = 0
        } else if kb == 116 {
            // T / t
            var cx: f64 = (*pf).lx
            var cy: f64 = (*pf).ly
            if sq_gilt == 1 {
                cx = 2.0 * (*pf).lx - sqx
                cy = 2.0 * (*pf).ly - sqy
            }
            let x: f64 = next_number(p, n, &i, &ok) + bx
            if !ok {
                return false
            }
            let y: f64 = next_number(p, n, &i, &ok) + by
            if !ok {
                return false
            }
            path_quad(pf, cx, cy, x, y)
            sqx = cx
            sqy = cy
            sq_gilt = 1
            sk_gilt = 0
        } else if kb == 97 {
            // A / a
            let rx: f64 = next_number(p, n, &i, &ok)
            if !ok {
                return false
            }
            let ry: f64 = next_number(p, n, &i, &ok)
            if !ok {
                return false
            }
            let dr: f64 = next_number(p, n, &i, &ok)
            if !ok {
                return false
            }
            let big: bool = flag(p, n, &i, &ok)
            if !ok {
                return false
            }
            let sweep: bool = flag(p, n, &i, &ok)
            if !ok {
                return false
            }
            let x: f64 = next_number(p, n, &i, &ok) + bx
            if !ok {
                return false
            }
            let y: f64 = next_number(p, n, &i, &ok) + by
            if !ok {
                return false
            }
            path_arc_too(pf, rx, ry, dr, big, sweep, x, y)
            sk_gilt = 0
            sq_gilt = 0
        } else if kb == 122 {
            // Z / z
            path_too(pf)
            sk_gilt = 0
            sq_gilt = 0
        } else {
            return false
        }
        matrix.skip_empty(p, n, &i)
    }
    return true
}

// `points` of `polyline` and `polygon`: only pairs of numbers. `zu` says whether at
// the end it is closed (`polygon` yes, `polyline` no).
//
// ERROR TOLERANCE as in SVG 1.1, 9.7: an odd number of values or
// rubbish at the end lets everything STAND that was read up to there.
#[no_gc]
fn split_points(pf: *mut Path, p: u64, n: usize, zu: bool) -> bool {
    var i: usize = 0
    var first: bool = true
    matrix.skip_empty(p, n, &i)
    while i < n {
        var ok: bool = false
        let x: f64 = matrix.number(p, n, &i, &ok)
        if !ok {
            break
        }
        matrix.skip_sep(p, n, &i)
        var ok2: bool = false
        let y: f64 = matrix.number(p, n, &i, &ok2)
        if !ok2 {
            break
        }
        if first {
            path_move(pf, x, y)
            first = false
        } else {
            path_line(pf, x, y)
        }
        matrix.skip_sep(p, n, &i)
    }
    if !first && zu {
        path_too(pf)
    }
    return !first
}

// ------------------------------------------------------- Into the rasteriser
//
// The path is sent through the matrix and passed to the rasteriser of
// lib/font/raster.fi. Two things happen in doing so:
//
//   * every subpath is CLOSED, even if no `Z` stood there. For
//     a FILL that is the rule of the specification; for a
//     STROKE it does not apply, but that does not go through here, but
//     through lib/svg/dash.fi, which already delivers a closed outline.
//   * the curves are NOT subdivided here: `raster_quad` and
//     `raster_cubic` do that themselves and adjust the fineness to the
//     length of the curve. The points thus come transformed, but as a
//     curve.
#[no_gc]
fn path_an_raster(pf: *mut Path, r: *mut raster.Raster, m: matrix.Mat) {
    let nv: usize = mem.buf_len(&(*pf).vb)
    var pi: usize = 0
    var cx: f64 = 0.0
    var cy: f64 = 0.0
    var sx: f64 = 0.0
    var sy: f64 = 0.0
    var open: bool = false
    var i: usize = 0
    while i < nv {
        let v: u32 = mem.buf_at(&(*pf).vb, i) as u32
        if v == V_ZUG {
            if open && (cx != sx || cy != sy) {
                raster.raster_line(r, cx, cy, sx, sy)
            }
            let x: f64 = path_px(pf, pi)
            let y: f64 = path_py(pf, pi)
            pi = pi + 1
            cx = matrix.mat_x(m, x, y)
            cy = matrix.mat_y(m, x, y)
            sx = cx
            sy = cy
            open = true
        } else if v == V_LINE {
            let x: f64 = path_px(pf, pi)
            let y: f64 = path_py(pf, pi)
            pi = pi + 1
            let nx: f64 = matrix.mat_x(m, x, y)
            let ny: f64 = matrix.mat_y(m, x, y)
            raster.raster_line(r, cx, cy, nx, ny)
            cx = nx
            cy = ny
        } else if v == V_QUAD {
            let ax: f64 = path_px(pf, pi)
            let ay: f64 = path_py(pf, pi)
            let bx: f64 = path_px(pf, pi + 1)
            let by: f64 = path_py(pf, pi + 1)
            pi = pi + 2
            let qx: f64 = matrix.mat_x(m, ax, ay)
            let qy: f64 = matrix.mat_y(m, ax, ay)
            let nx: f64 = matrix.mat_x(m, bx, by)
            let ny: f64 = matrix.mat_y(m, bx, by)
            raster.raster_quad(r, cx, cy, qx, qy, nx, ny)
            cx = nx
            cy = ny
        } else if v == V_CUBIC {
            let ax: f64 = path_px(pf, pi)
            let ay: f64 = path_py(pf, pi)
            let bx: f64 = path_px(pf, pi + 1)
            let by: f64 = path_py(pf, pi + 1)
            let ex: f64 = path_px(pf, pi + 2)
            let ey: f64 = path_py(pf, pi + 2)
            pi = pi + 3
            let c1x: f64 = matrix.mat_x(m, ax, ay)
            let c1y: f64 = matrix.mat_y(m, ax, ay)
            let c2x: f64 = matrix.mat_x(m, bx, by)
            let c2y: f64 = matrix.mat_y(m, bx, by)
            let nx: f64 = matrix.mat_x(m, ex, ey)
            let ny: f64 = matrix.mat_y(m, ex, ey)
            raster.raster_cubic(r, cx, cy, c1x, c1y, c2x, c2y, nx, ny)
            cx = nx
            cy = ny
        } else {
            if open && (cx != sx || cy != sy) {
                raster.raster_line(r, cx, cy, sx, sy)
            }
            cx = sx
            cy = sy
            open = false
        }
        i = i + 1
    }
    if open && (cx != sx || cy != sy) {
        raster.raster_line(r, cx, cy, sx, sy)
    }
}

// The bounding box of the path AFTER the mapping. For curves the
// control polygon is taken -- that is slightly too large, but never too small,
// and a window that is too large costs only time, one that is too small cuts
// the picture off.
#[no_gc]
fn path_limits(pf: *mut Path, m: matrix.Mat, x0: *mut f64, y0: *mut f64,
    x1: *mut f64, y1: *mut f64) -> bool {
    let np: usize = path_points(pf)
    if np == 0 {
        return false
    }
    var ax: f64 = 1.0e300
    var ay: f64 = 1.0e300
    var bx: f64 = 0.0 - 1.0e300
    var by: f64 = 0.0 - 1.0e300
    var i: usize = 0
    while i < np {
        let x: f64 = matrix.mat_x(m, path_px(pf, i), path_py(pf, i))
        let y: f64 = matrix.mat_y(m, path_px(pf, i), path_py(pf, i))
        if x < ax {
            ax = x
        }
        if y < ay {
            ay = y
        }
        if x > bx {
            bx = x
        }
        if y > by {
            by = y
        }
        i = i + 1
    }
    *x0 = ax
    *y0 = ay
    *x1 = bx
    *y1 = by
    return true
}

#[no_gc]
fn path_copy(target: *mut Path, source: *mut Path) {
    path_empty(target)
    path_attachments(target, source, matrix.mat_one())
}

// Append a path to another, sent through a matrix.
#[no_gc]
fn path_attachments(target: *mut Path, source: *mut Path, m: matrix.Mat) {
    let nv: usize = mem.buf_len(&(*source).vb)
    var pi: usize = 0
    var i: usize = 0
    while i < nv {
        let v: u32 = mem.buf_at(&(*source).vb, i) as u32
        if v == V_ZUG {
            let x: f64 = path_px(source, pi)
            let y: f64 = path_py(source, pi)
            pi = pi + 1
            path_move(target, matrix.mat_x(m, x, y), matrix.mat_y(m, x, y))
        } else if v == V_LINE {
            let x: f64 = path_px(source, pi)
            let y: f64 = path_py(source, pi)
            pi = pi + 1
            path_line(target, matrix.mat_x(m, x, y), matrix.mat_y(m, x, y))
        } else if v == V_QUAD {
            let ax: f64 = path_px(source, pi)
            let ay: f64 = path_py(source, pi)
            let bx: f64 = path_px(source, pi + 1)
            let by: f64 = path_py(source, pi + 1)
            pi = pi + 2
            path_quad(target, matrix.mat_x(m, ax, ay), matrix.mat_y(m, ax, ay),
                matrix.mat_x(m, bx, by), matrix.mat_y(m, bx, by))
        } else if v == V_CUBIC {
            let ax: f64 = path_px(source, pi)
            let ay: f64 = path_py(source, pi)
            let bx: f64 = path_px(source, pi + 1)
            let by: f64 = path_py(source, pi + 1)
            let ex: f64 = path_px(source, pi + 2)
            let ey: f64 = path_py(source, pi + 2)
            pi = pi + 3
            path_cubic(target, matrix.mat_x(m, ax, ay), matrix.mat_y(m, ax, ay),
                matrix.mat_x(m, bx, by), matrix.mat_y(m, bx, by),
                matrix.mat_x(m, ex, ey), matrix.mat_y(m, ex, ey))
        } else {
            path_too(target)
        }
        i = i + 1
    }
}

// ---------------------------------------------------------- Smoothing
//
// For stroking the curves have to become line segments -- a stroke width
// cannot be set off directly on a Bezier. The fineness depends on the size
// of the curve AFTER the mapping (`mass`, the length measure of the matrix): a
// curve that is two pixels large on the screen needs no 32 pieces.
//
// The result is again a `Path`, but only of `V_ZUG`, `V_LINIE` and
// `V_ZU`.
// How many segments a curve of size `d` (in pixels) needs.
//
// The chord error of a curve divided into `n` equal pieces falls
// with `1/n^2`; for a target accuracy of about a fiftieth of a
// pixel `n ~ 2.5 * sqrt(d)` is the right order of magnitude. The
// factor is MEASURED and not estimated: held against Chromium
// (tools/graphics/chrome_svg.py, case 04) the largest deviation falls from
// 73 at 1.5 to 63 at 2.5 and after that only to 60 at 6.0 -- the
// rest is no longer the chord, but the different edge smoothing and
// the four-Bezier approximation of the circle itself.
#[no_gc]
fn pieces_for(d: f64) -> i64 {
    var s: i64 = ((matrix.m_sqrt(d) * 2.5) as i64) + 1
    if s < 1 {
        s = 1
    }
    if s > 400 {
        s = 400
    }
    return s
}

#[no_gc]
fn path_smooth(target: *mut Path, source: *mut Path, mass: f64) {
    path_empty(target)
    let nv: usize = mem.buf_len(&(*source).vb)
    var pi: usize = 0
    var cx: f64 = 0.0
    var cy: f64 = 0.0
    var i: usize = 0
    var m: f64 = mass
    if m <= 0.0 {
        m = 1.0
    }
    while i < nv {
        let v: u32 = mem.buf_at(&(*source).vb, i) as u32
        if v == V_ZUG {
            cx = path_px(source, pi)
            cy = path_py(source, pi)
            pi = pi + 1
            path_move(target, cx, cy)
        } else if v == V_LINE {
            cx = path_px(source, pi)
            cy = path_py(source, pi)
            pi = pi + 1
            path_line(target, cx, cy)
        } else if v == V_QUAD {
            let ax: f64 = path_px(source, pi)
            let ay: f64 = path_py(source, pi)
            let bx: f64 = path_px(source, pi + 1)
            let by: f64 = path_py(source, pi + 1)
            pi = pi + 2
            let d: f64 = (matrix.m_abs(ax - cx) + matrix.m_abs(ay - cy)
                +matrix.m_abs(bx - ax) + matrix.m_abs(by - ay)) * m
            let s: i64 = pieces_for(d)
            var k: i64 = 1
            while k <= s {
                let t: f64 = (k as f64) / (s as f64)
                let u: f64 = 1.0 - t
                let x: f64 = u * u * cx + 2.0 * u * t * ax + t * t * bx
                let y: f64 = u * u * cy + 2.0 * u * t * ay + t * t * by
                path_line(target, x, y)
                k = k + 1
            }
            cx = bx
            cy = by
        } else if v == V_CUBIC {
            let ax: f64 = path_px(source, pi)
            let ay: f64 = path_py(source, pi)
            let bx: f64 = path_px(source, pi + 1)
            let by: f64 = path_py(source, pi + 1)
            let ex: f64 = path_px(source, pi + 2)
            let ey: f64 = path_py(source, pi + 2)
            pi = pi + 3
            let d: f64 = (matrix.m_abs(ax - cx) + matrix.m_abs(ay - cy)
                +matrix.m_abs(bx - ax) + matrix.m_abs(by - ay)
                +matrix.m_abs(ex - bx) + matrix.m_abs(ey - by)) * m
            let s: i64 = pieces_for(d)
            var k: i64 = 1
            while k <= s {
                let t: f64 = (k as f64) / (s as f64)
                let u: f64 = 1.0 - t
                let x: f64 = u * u * u * cx + 3.0 * u * u * t * ax
                +3.0 * u * t * t * bx + t * t * t * ex
                let y: f64 = u * u * u * cy + 3.0 * u * u * t * ay
                +3.0 * u * t * t * by + t * t * t * ey
                path_line(target, x, y)
                k = k + 1
            }
            cx = ex
            cy = ey
        } else {
            path_too(target)
            cx = (*target).lx
            cy = (*target).ly
        }
        i = i + 1
    }
}
