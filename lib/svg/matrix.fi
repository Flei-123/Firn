// SPDX-License-Identifier: MPL-2.0
// Provenance: Certus, lib/svg/ (last changed in Certus commit 8f138f02), ported to
// Firn in 0e1a1196; released by the sole author Justin on 25.09.2026 for Firn
// under MPL-2.0.
// lib/svg/matrix.fi -- THE AFFINE MATRIX of SVG, and the parser for
// the `transform` attribute.
//
// A matrix here is always `[a, b, c, d, e, f]` and means exactly what
// SVG 1.1 section 7.4 writes down:
//
//     | x' |   | a  c  e |   | x |
//     | y' | = | b  d  f | * | y |
//     | 1  |   | 0  0  1 |   | 1 |
//
// so `x' = a*x + c*y + e` and `y' = b*x + d*y + f`. The order of the
// six numbers is that of the notation `matrix(a b c d e f)` in the attribute,
// so that between the text on the page and the numbers in memory there lies no
// re-sorting that you could forget.
//
// WHY A VERSION OF ITS OWN. Round CSS2 has already built matrix arithmetic for `transform` in
// lib/css/cascade.fi, and round LAYOUT2
// builds on it further. This file is deliberately a SECOND, small version
// in its own territory: the SVG attribute `transform` has a different
// grammar from the CSS property (no `deg` suffix as a requirement, but
// `rotate(a cx cy)` with a pivot, which does not exist like that in CSS), and an
// intervention in foreign territory would be more expensive for the merge than these few
// hundred lines. When merging the branches the two belong
// put together -- that also stands in docs/ROUNDGRAFIK.md.
//
// Everything here is `#[no_gc]` and calculates only with `f64`. The file has
// NO imports: `std.math` is not `#[no_gc]`, and the four pieces of
// arithmetic that are needed here (sine, cosine, tangent,
// root) therefore stand below as a version of their own. That is the same
// decision that lib/font/raster.fi made, and for the same
// reason: a file that has nothing under it can also be used from a kernel.

export {
    Mat,
    mat_one, mat_set, mat_mal, mat_x, mat_y, mat_dx, mat_dy,
    mat_verschiebe, mat_scale, mat_rotate, mat_rotate_around,
    mat_neige_x, mat_neige_y, mat_of_six,
    mat_kehr, mat_determinante, mat_laengenmass,
    mat_get, mat_is_one,
    split_transform,
    m_sin, m_cos, m_tan, m_sqrt, m_abs, m_floor, m_ceil,
    m_atan_grad, m_atan2_grad,
    is_empty, is_digit, read_byte, skip_empty,
    skip_sep, number,
}

// ------------------------------------------------------ The arithmetic
//
// Sine and cosine with ARGUMENT REDUCTION IN DEGREES. That is the point at
// which a naive version becomes visibly wrong: `rotate(90)` must yield a
// matrix with an exact zero, otherwise a rotated rectangle stands
// crooked by 1e-16 and the edge lies on the wrong side of the
// pixel centre. If calculation is first done in radians, 90 degrees is
// `1.5707963267948966` and the cosine of it `6.12e-17` -- not zero.
//
// Therefore: first bring into `[0, 360)` in degrees, handle the four quarters
// exactly, and send only the remainder in `[0, 45]` through the series. The
// series itself is the Taylor series about zero; on `[0, pi/4]` it breaks off
// after the term x^15 below the resolution of an `f64`.

#[no_gc]
fn m_abs(x: f64) -> f64 {
    if x < 0.0 {
        return 0.0 - x
    }
    return x
}

#[no_gc]
fn m_floor(x: f64) -> f64 {
    if x != x || x > 9.0e15 || x < 0.0 - 9.0e15 {
        return x
    }
    let t: f64 = (x as i64) as f64
    if t > x {
        return t - 1.0
    }
    return t
}

#[no_gc]
fn m_ceil(x: f64) -> f64 {
    let f: f64 = m_floor(x)
    if f < x {
        return f + 1.0
    }
    return f
}

// Root by Newton. The starting value comes from a halving of the
// exponent, so that the loop from every order of magnitude stands in
// a few steps; six Newton steps double the digits
// every time and are more than enough for `f64`.
#[no_gc]
fn m_sqrt(x: f64) -> f64 {
    if x != x || x < 0.0 {
        return 0.0
    }
    if x == 0.0 {
        return 0.0
    }
    var g: f64 = x
    if g > 1.0 {
        var o: f64 = 1.0
        while o * o < x {
            o = o * 2.0
        }
        g = o
    } else {
        var o: f64 = 1.0
        while o * o > x {
            o = o / 2.0
        }
        g = o * 2.0
    }
    var i: i32 = 0
    while i < 24 {
        let ng: f64 = 0.5 * (g + x / g)
        if ng == g {
            return g
        }
        g = ng
        i = i + 1
    }
    return g
}

// The Taylor series of sin on `[-pi/4, pi/4]`.
#[no_gc]
fn row_sin(x: f64) -> f64 {
    let x2: f64 = x * x
    var s: f64 = 0.0 - 1.0 / 1307674368000.0
    s = s * x2 + 1.0 / 6227020800.0
    s = s * x2 - 1.0 / 39916800.0
    s = s * x2 + 1.0 / 362880.0
    s = s * x2 - 1.0 / 5040.0
    s = s * x2 + 1.0 / 120.0
    s = s * x2 - 1.0 / 6.0
    s = s * x2 + 1.0
    return s * x
}

// The Taylor series of cos on `[-pi/4, pi/4]`.
#[no_gc]
fn row_cos(x: f64) -> f64 {
    let x2: f64 = x * x
    var s: f64 = 0.0 - 1.0 / 87178291200.0
    s = s * x2 + 1.0 / 479001600.0
    s = s * x2 - 1.0 / 3628800.0
    s = s * x2 + 1.0 / 40320.0
    s = s * x2 - 1.0 / 720.0
    s = s * x2 + 1.0 / 24.0
    s = s * x2 - 1.0 / 2.0
    s = s * x2 + 1.0
    return s
}

// Grad auf `[0, 360)`.
#[no_gc]
fn grad_norm(g_in: f64) -> f64 {
    var g: f64 = g_in
    if g != g {
        return 0.0
    }
    if g >= 360.0 || g <= 0.0 - 360.0 {
        g = g - m_floor(g / 360.0) * 360.0
    }
    if g < 0.0 {
        g = g + 360.0
    }
    if g >= 360.0 {
        g = 0.0
    }
    return g
}

// Sine of an angle in DEGREES.
#[no_gc]
fn m_sin(grad: f64) -> f64 {
    let g: f64 = grad_norm(grad)
    // Die vier Viertelpunkte exakt.
    if g == 0.0 {
        return 0.0
    }
    if g == 90.0 {
        return 1.0
    }
    if g == 180.0 {
        return 0.0
    }
    if g == 270.0 {
        return 0.0 - 1.0
    }
    var q: f64 = g
    var sign: f64 = 1.0
    if q >= 180.0 {
        q = q - 180.0
        sign = 0.0 - 1.0
    }
    // Now q lies in (0, 180). Mirror onto (0, 90].
    if q > 90.0 {
        q = 180.0 - q
    }
    let r: f64 = q * 3.141592653589793 / 180.0
    if q <= 45.0 {
        return sign * row_sin(r)
    }
    return sign * row_cos(1.5707963267948966 - r)
}

// Cosine of an angle in DEGREES.
#[no_gc]
fn m_cos(grad: f64) -> f64 {
    return m_sin(grad + 90.0)
}

// Tangent of an angle in DEGREES. At 90 and 270 degrees there is none; SVG
// does allow `skewX(90)`, but the result is a degenerate
// mapping. Here a very large number comes out instead of infinity,
// so that the following calculation does not become NaN and the determinant
// stays cleanly zero.
#[no_gc]
fn m_tan(grad: f64) -> f64 {
    let c: f64 = m_cos(grad)
    if c == 0.0 {
        return 1.0e16
    }
    return m_sin(grad) / c
}

// Arctangent, ANSWER IN DEGREES. Two reductions bring the argument into
// the range in which the series stands quickly:
//
//   |t| > 1          ->  90 - atan(1/t)
//   t  > 2 - sqrt(3) ->  30 + atan((t - tan30) / (1 + t*tan30))
//
// After that |t| <= tan(15 degrees) = 0.2679, and there every term
// of the series falls by the factor 0.072; twenty terms lie below the
// resolution of an `f64`.
#[no_gc]
fn atan_row(x: f64) -> f64 {
    let x2: f64 = x * x
    var term: f64 = x
    var s: f64 = 0.0
    var k: i64 = 0
    while k < 20 {
        let d: f64 = ((2 * k + 1) as f64)
        if k % 2 == 0 {
            s = s + term / d
        } else {
            s = s - term / d
        }
        term = term * x2
        k = k + 1
    }
    return s
}

// atan for a non-negative argument, in degrees, result in [0, 90].
#[no_gc]
fn atan_pos_grad(t: f64) -> f64 {
    if t != t {
        return 0.0
    }
    if t > 1.0e17 {
        return 90.0
    }
    if t > 1.0 {
        return 90.0 - atan_pos_grad(1.0 / t)
    }
    if t == 1.0 {
        return 45.0
    }
    let tan30: f64 = 0.5773502691896258
    if t > 0.2679491924311227 {
        let u: f64 = (t - tan30) / (1.0 + t * tan30)
        return 30.0 + atan_row(u) * 180.0 / 3.141592653589793
    }
    return atan_row(t) * 180.0 / 3.141592653589793
}

#[no_gc]
fn m_atan_grad(t: f64) -> f64 {
    if t < 0.0 {
        return 0.0 - atan_pos_grad(0.0 - t)
    }
    return atan_pos_grad(t)
}

// atan2 in DEGREES, result in (-180, 180]. The four axis directions
// come out exactly -- that is the precondition for a
// semicircle as an arc to become exactly a semicircle and not 179.9999 degrees.
#[no_gc]
fn m_atan2_grad(y: f64, x: f64) -> f64 {
    if x != x || y != y {
        return 0.0
    }
    if x == 0.0 {
        if y > 0.0 {
            return 90.0
        }
        if y < 0.0 {
            return 0.0 - 90.0
        }
        return 0.0
    }
    if y == 0.0 {
        if x > 0.0 {
            return 0.0
        }
        return 180.0
    }
    let a: f64 = atan_pos_grad(m_abs(y / x))
    if x > 0.0 {
        if y > 0.0 {
            return a
        }
        return 0.0 - a
    }
    if y > 0.0 {
        return 180.0 - a
    }
    return a - 180.0
}

// Six numbers. As a `struct` and not as `[f64; 6]`, because a value can then
// be returned and assigned without the caller having to hold a
// pointer.
struct Mat {
    a: f64,
    b: f64,
    c: f64,
    d: f64,
    e: f64,
    f: f64,
}

#[no_gc]
fn mat_one() -> Mat {
    return Mat { a: 1.0, b: 0.0, c: 0.0, d: 1.0, e: 0.0, f: 0.0 }
}

#[no_gc]
fn mat_of_six(a: f64, b: f64, c: f64, d: f64, e: f64, f: f64) -> Mat {
    return Mat { a: a, b: b, c: c, d: d, e: e, f: f }
}

#[no_gc]
fn mat_set(m: *mut Mat, s: Mat) {
    (*m).a = s.a
    (*m).b = s.b
    (*m).c = s.c
    (*m).d = s.d
    (*m).e = s.e
    (*m).f = s.f
}

// One of the six numbers by number -- for loops and for the
// comparison in the check tools.
#[no_gc]
fn mat_get(m: Mat, i: usize) -> f64 {
    if i == 0 {
        return m.a
    }
    if i == 1 {
        return m.b
    }
    if i == 2 {
        return m.c
    }
    if i == 3 {
        return m.d
    }
    if i == 4 {
        return m.e
    }
    return m.f
}

#[no_gc]
fn mat_is_one(m: Mat) -> bool {
    return m.a == 1.0 && m.b == 0.0 && m.c == 0.0 && m.d == 1.0
    && m.e == 0.0 && m.f == 0.0
}

// `p * q`: first `q`, then `p`. That is the order in which SVG reads the
// transformation list of an element -- `transform="translate(10)
// scale(2)"` scales FIRST and then shifts, because the list is read from
// left to right as a matrix product.
#[no_gc]
fn mat_mal(p: Mat, q: Mat) -> Mat {
    return Mat {
        a: p.a * q.a + p.c * q.b,
        b: p.b * q.a + p.d * q.b,
        c: p.a * q.c + p.c * q.d,
        d: p.b * q.c + p.d * q.d,
        e: p.a * q.e + p.c * q.f + p.e,
        f: p.b * q.e + p.d * q.f + p.f,
    }
}

#[no_gc]
fn mat_x(m: Mat, x: f64, y: f64) -> f64 {
    return m.a * x + m.c * y + m.e
}

#[no_gc]
fn mat_y(m: Mat, x: f64, y: f64) -> f64 {
    return m.b * x + m.d * y + m.f
}

// A DIRECTION VECTOR is mapped without the shift. Everybody needs that who
// sends a normal or a tangent through the matrix.
#[no_gc]
fn mat_dx(m: Mat, x: f64, y: f64) -> f64 {
    return m.a * x + m.c * y
}

#[no_gc]
fn mat_dy(m: Mat, x: f64, y: f64) -> f64 {
    return m.b * x + m.d * y
}

#[no_gc]
fn mat_verschiebe(tx: f64, ty: f64) -> Mat {
    return Mat { a: 1.0, b: 0.0, c: 0.0, d: 1.0, e: tx, f: ty }
}

#[no_gc]
fn mat_scale(sx: f64, sy: f64) -> Mat {
    return Mat { a: sx, b: 0.0, c: 0.0, d: sy, e: 0.0, f: 0.0 }
}

// The angle in SVG stands in DEGREES, not in radians.
#[no_gc]
fn mat_rotate(grad: f64) -> Mat {
    let c: f64 = m_cos(grad)
    let s: f64 = m_sin(grad)
    return Mat { a: c, b: s, c: 0.0 - s, d: c, e: 0.0, f: 0.0 }
}

// `rotate(a cx cy)` is, according to the specification, exactly
// `translate(cx cy) rotate(a) translate(-cx -cy)`.
#[no_gc]
fn mat_rotate_around(grad: f64, cx: f64, cy: f64) -> Mat {
    let m: Mat = mat_mal(mat_verschiebe(cx, cy), mat_rotate(grad))
    return mat_mal(m, mat_verschiebe(0.0 - cx, 0.0 - cy))
}

#[no_gc]
fn mat_neige_x(grad: f64) -> Mat {
    let t: f64 = m_tan(grad)
    return Mat { a: 1.0, b: 0.0, c: t, d: 1.0, e: 0.0, f: 0.0 }
}

#[no_gc]
fn mat_neige_y(grad: f64) -> Mat {
    let t: f64 = m_tan(grad)
    return Mat { a: 1.0, b: t, c: 0.0, d: 1.0, e: 0.0, f: 0.0 }
}

#[no_gc]
fn mat_determinante(m: Mat) -> f64 {
    return m.a * m.d - m.b * m.c
}

// The inverse. For a degenerate matrix (determinant 0 -- say
// `scale(0)`) there is none; then the identity matrix comes back and
// `ok` stands at false. The caller must then draw nothing, because a
// degenerate mapping has no image with an area.
#[no_gc]
fn mat_kehr(m: Mat, ok: *mut bool) -> Mat {
    let det: f64 = mat_determinante(m)
    if det == 0.0 || det != det {
        *ok = false
        return mat_one()
    }
    *ok = true
    let ia: f64 = m.d / det
    let ib: f64 = (0.0 - m.b) / det
    let ic: f64 = (0.0 - m.c) / det
    let id: f64 = m.a / det
    return Mat {
        a: ia,
        b: ib,
        c: ic,
        d: id,
        e: 0.0 - (ia * m.e + ic * m.f),
        f: 0.0 - (ib * m.e + id * m.f),
    }
}

// A LENGTH MEASURE of the mapping: how strongly a distance is stretched on average. SVG
// needs that in two places -- for the
// stroke width under a non-uniform scaling and for the
// question how finely a curve has to be subdivided. The root of the
// magnitude of the determinant is the geometric mean of the two
// principal stretches and exactly what the specification means for
// `stroke-width` under a scaling.
#[no_gc]
fn mat_laengenmass(m: Mat) -> f64 {
    var d: f64 = mat_determinante(m)
    if d < 0.0 {
        d = 0.0 - d
    }
    if d <= 0.0 {
        return 0.0
    }
    return m_sqrt(d)
}

// ------------------------------------------------- The `transform` attribute
//
// The grammar of SVG 1.1, appendix on presentation:
//
//     transform-list  = *wsp [ transforms ] *wsp
//     transforms      = transform | transform comma-wsp+ transforms
//     transform       = matrix | translate | scale | rotate | skewX | skewY
//
// Numbers are separated by whitespace OR comma, either any number of times.
// Missing numbers have defaults: `translate(5)` means `translate(5 0)`,
// `scale(2)` means `scale(2 2)`, `rotate(45)` rotates about the origin.
//
// ERROR TOLERANCE. SVG says for a broken `transform`: the attribute
// counts as erroneous and is discarded entirely. Exactly that happens here --
// on an error the identity matrix comes back. Not "as far as
// possible", because a half-applied transformation list looks worse
// than none at all and is harder to find.

#[no_gc]
fn is_empty(c: u32) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13 || c == 12
}

#[no_gc]
fn read_byte(p: u64, i: usize) -> u32 {
    let v: u8 = *((p + i as u64) as *mut u8)
    return v as u32
}

#[no_gc]
fn skip_empty(p: u64, n: usize, i: *mut usize) {
    while *i < n && is_empty(read_byte(p, *i)) {
        *i = *i + 1
    }
}

// Whitespace and AT MOST ONE comma. Two commas in a row are an
// error and are not silently swallowed here.
#[no_gc]
fn skip_sep(p: u64, n: usize, i: *mut usize) {
    skip_empty(p, n, i)
    if *i < n && read_byte(p, *i) == 44 {
        *i = *i + 1
        skip_empty(p, n, i)
    }
}

#[no_gc]
fn is_digit(c: u32) -> bool {
    return c >= 48 && c <= 57
}

// A number by the SVG grammar: sign, digits, point, digits,
// exponent. `.5`, `5.`, `-.5e-3` are all valid.
//
// THE ARITHMETIC. The fractional part is collected as a WHOLE NUMBER and
// divided once at the end, not added up digit by digit. That is
// not cosmetics: `0.1 + 0.02 + 0.003` rounded at every step deviates
// from `123 / 1000` in the last place, and for a coordinate that is
// compared pixel for pixel against Chromium, the last place decides on which
// side of a pixel centre a point lies.
#[no_gc]
fn number(p: u64, n: usize, i: *mut usize, ok: *mut bool) -> f64 {
    var pos: usize = *i
    var sign: f64 = 1.0
    if pos < n && (read_byte(p, pos) == 43 || read_byte(p, pos) == 45) {
        if read_byte(p, pos) == 45 {
            sign = 0.0 - 1.0
        }
        pos = pos + 1
    }
    var whole: f64 = 0.0
    var digits: usize = 0
    while pos < n && is_digit(read_byte(p, pos)) {
        whole = whole * 10.0 + ((read_byte(p, pos) - 48) as f64)
        pos = pos + 1
        digits = digits + 1
    }
    var value: f64 = whole
    if pos < n && read_byte(p, pos) == 46 {
        pos = pos + 1
        var bruch: f64 = 0.0
        var divisor: f64 = 1.0
        while pos < n && is_digit(read_byte(p, pos)) {
            bruch = bruch * 10.0 + ((read_byte(p, pos) - 48) as f64)
            divisor = divisor * 10.0
            pos = pos + 1
            digits = digits + 1
        }
        if divisor > 1.0 {
            value = value + bruch / divisor
        }
    }
    if digits == 0 {
        *ok = false
        return 0.0
    }
    if pos < n && (read_byte(p, pos) == 101 || read_byte(p, pos) == 69) {
        var epos: usize = pos + 1
        var evorz: i64 = 1
        if epos < n && (read_byte(p, epos) == 43
            || read_byte(p, epos) == 45) {
            if read_byte(p, epos) == 45 {
                evorz = 0 - 1
            }
            epos = epos + 1
        }
        var ez: i64 = 0
        var eziffern: usize = 0
        while epos < n && is_digit(read_byte(p, epos)) {
            if ez < 10000 {
                ez = ez * 10 + (read_byte(p, epos) - 48) as i64
            }
            epos = epos + 1
            eziffern = eziffern + 1
        }
        // Only if digits really follow is it an exponent. `1e` is
        // the number 1, followed by a letter -- that is how Chromium
        // reads it too.
        if eziffern > 0 {
            pos = epos
            var k: i64 = ez * evorz
            if k > 308 {
                k = 308
            }
            if k < 0 - 324 {
                k = 0 - 324
            }
            while k > 0 {
                value = value * 10.0
                k = k - 1
            }
            while k < 0 {
                value = value / 10.0
                k = k + 1
            }
        }
    }
    *i = pos
    *ok = true
    return value * sign
}

// The name of a function, compared with a fixed word.
#[no_gc]
fn word_fits(p: u64, n: usize, i: usize, w0: u32, w1: u32, w2: u32,
    w3: u32, w4: u32, w5: u32, len: usize) -> bool {
    if i + len > n {
        return false
    }
    if len > 0 && read_byte(p, i) != w0 {
        return false
    }
    if len > 1 && read_byte(p, i + 1) != w1 {
        return false
    }
    if len > 2 && read_byte(p, i + 2) != w2 {
        return false
    }
    if len > 3 && read_byte(p, i + 3) != w3 {
        return false
    }
    if len > 4 && read_byte(p, i + 4) != w4 {
        return false
    }
    if len > 5 && read_byte(p, i + 5) != w5 {
        return false
    }
    return true
}

// Up to six numbers between round brackets. `min` and `max` say
// how many are allowed; `anz` says afterwards how many were really there.
#[no_gc]
fn paren_numbers(p: u64, n: usize, i: *mut usize, z: *mut f64,
    min: usize, max: usize, anz: *mut usize) -> bool {
    skip_empty(p, n, i)
    if *i >= n || read_byte(p, *i) != 40 {
        return false
    }
    *i = *i + 1
    var k: usize = 0
    while k < max {
        skip_sep(p, n, i)
        if *i < n && read_byte(p, *i) == 41 {
            break
        }
        var ok: bool = false
        let v: f64 = number(p, n, i, &ok)
        if !ok {
            return false
        }
        *((z as u64 + (k * 8) as u64) as *mut f64) = v
        k = k + 1
    }
    skip_empty(p, n, i)
    if *i >= n || read_byte(p, *i) != 41 {
        return false
    }
    *i = *i + 1
    if k < min {
        return false
    }
    *anz = k
    return true
}

// The whole list. On an error the identity matrix.
#[no_gc]
fn split_transform(p: u64, n: usize) -> Mat {
    var m: Mat = mat_one()
    var i: usize = 0
    var z: [f64; 6] = [0.0; 6]
    var anz: usize = 0
    skip_empty(p, n, &i)
    while i < n {
        if read_byte(p, i) == 44 {
            // A comma between two transformations is allowed.
            i = i + 1
            skip_empty(p, n, &i)
            continue
        }
        var g: Mat = mat_one()
        if word_fits(p, n, i, 109, 97, 116, 114, 105, 120, 6) {
            i = i + 6
            if !paren_numbers(p, n, &i, &z[0], 6, 6, &anz) {
                return mat_one()
            }
            g = mat_of_six(z[0], z[1], z[2], z[3], z[4], z[5])
        } else if word_fits(p, n, i, 116, 114, 97, 110, 115, 108, 6)
        && i + 9 <= n && read_byte(p, i + 6) == 97
        && read_byte(p, i + 7) == 116
        && read_byte(p, i + 8) == 101 {
            i = i + 9
            z[0] = 0.0
            z[1] = 0.0
            if !paren_numbers(p, n, &i, &z[0], 1, 2, &anz) {
                return mat_one()
            }
            if anz < 2 {
                z[1] = 0.0
            }
            g = mat_verschiebe(z[0], z[1])
        } else if word_fits(p, n, i, 115, 99, 97, 108, 101, 0, 5) {
            i = i + 5
            z[0] = 1.0
            z[1] = 1.0
            if !paren_numbers(p, n, &i, &z[0], 1, 2, &anz) {
                return mat_one()
            }
            if anz < 2 {
                z[1] = z[0]
            }
            g = mat_scale(z[0], z[1])
        } else if word_fits(p, n, i, 114, 111, 116, 97, 116, 101, 6) {
            i = i + 6
            z[0] = 0.0
            z[1] = 0.0
            z[2] = 0.0
            if !paren_numbers(p, n, &i, &z[0], 1, 3, &anz) {
                return mat_one()
            }
            if anz == 3 {
                g = mat_rotate_around(z[0], z[1], z[2])
            } else {
                g = mat_rotate(z[0])
            }
        } else if word_fits(p, n, i, 115, 107, 101, 119, 88, 0, 5) {
            i = i + 5
            if !paren_numbers(p, n, &i, &z[0], 1, 1, &anz) {
                return mat_one()
            }
            g = mat_neige_x(z[0])
        } else if word_fits(p, n, i, 115, 107, 101, 119, 89, 0, 5) {
            i = i + 5
            if !paren_numbers(p, n, &i, &z[0], 1, 1, &anz) {
                return mat_one()
            }
            g = mat_neige_y(z[0])
        } else {
            return mat_one()
        }
        m = mat_mal(m, g)
        skip_empty(p, n, &i)
    }
    return m
}
