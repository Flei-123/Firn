// SPDX-License-Identifier: MPL-2.0
// Provenance: Certus, lib/svg/ (last changed in Certus commit 8f138f02), ported to
// Firn in 0e1a1196; released by the sole author Justin on 25.09.2026 for Firn
// under MPL-2.0.
// lib/svg/paint.fi -- THE SVG PAINTER. From the tree become pixels.
//
// What happens here, in one sentence: the tree is walked from the root,
// every element gets a STATE inherited (matrix, fill, stroke, opacity,
// font size, viewport), and every element that is a shape builds from it
// a `path.Path` that is filled and/or stroked.
//
// ------------------------------------------------------ THE STATE INHERITS
//
// SVG has no cascade like CSS, but it has INHERITANCE, and that via
// `g`, `use`, `symbol` and nested `svg`. `fill="red"` on a
// `g` applies to every child that says nothing else. The state is
// therefore passed through the recursion as a VALUE: every call gets
// a copy, changes in it what its element says, and passes it on. Thereby
// there is no state stack that you can forget to clear away, and
// a `use` that jumps into the middle of a foreign subtree inherits
// automatically from the RIGHT place -- namely from the place at which the
// `use` stands, as the specification demands.
//
// --------------------------------------------- ATTRIBUTE OR PROPERTY
//
// Every paint attribute may stand in SVG in two ways:
//
//     <rect fill="red"/>            as an attribute
//     <rect style="fill: red"/>     as a CSS property
//
// and the second form WINS, because a `style` attribute stands in the cascade
// above every presentation property (SVG 1.1, 6.1: the
// presentation attributes count like a style sheet with the lowest
// importance). `hole_wert` therefore always looks first in `style` and then
// among the attributes. That is a test case of its own.
//
// WHAT DOES NOT EXIST HERE, and it is not forgotten, but assessed in
// docs/ROUNDGRAFIK.md: filters, masks, clip paths, patterns,
// SMIL animation. A `<style>` element with selectors is likewise
// not evaluated -- only the `style` ATTRIBUTE.
import html.mem
import font.raster
import font.ttf
// PORTED INTO THE FIRN TREE (13.09.2026): the font metrics go via
// svg.fontsel instead of directly to font.metrics. The reason and what is lost in doing so
// stand in the head of lib/svg/fontsel.fi. This file is
// otherwise taken over UNCHANGED from the Certus tree.
import svg.fontsel
import paint.canvas
import svg.matrix
import svg.path
import svg.dash
import svg.color
import svg.svgxml

export {
    Painter, State,
    painter_new, painter_init, painter_free, painter_ok,
    state_new,
    times_svg, times_tree, times_tree_color, svg_size,
    view_matrix, PAR_NONE, PAR_MEET, PAR_SLICE,
    painter_set_font, painter_ink,
    fill_path, stroke_path,
}

const RULE_NONZERO: u32 = 0
const RULE_EVEN: u32 = 1

const PAR_NONE: u32 = 0
const PAR_MEET: u32 = 1
const PAR_SLICE: u32 = 2

const ANCHOR_START: u32 = 0
const ANCHOR_MID: u32 = 1
const ANCHOR_END: u32 = 2

// How deep `use` and `g` may go. The value is not arbitrary:
// it is the LOOP LOCK. A `use` that points to its own ancestor
// would otherwise run forever -- test case (e) in
// docs/ROUNDGRAFIK.md does exactly that.
const DEPTH_MAX: usize = 24

const GLYPH_SCRATCH: usize = 1 << 20

// At most this many colour stops in a gradient.
const STOPP_MAX: usize = 32

// The names as an FNV-1a hash. One comparison instead of a
// string comparison per element -- with 3000 paths in a
// symbol collection that is the difference between one and twenty
// milliseconds.
const N_SVG: u32 = 3880226465
const N_G: u32 = 3792446982
const N_PATH: u32 = 2223459638
const N_RECT: u32 = 3940830471
const N_CIRCLE: u32 = 673280137
const N_ELLIPSE: u32 = 2667997009
const N_LINE: u32 = 400234023
const N_POLYLINE: u32 = 408269525
const N_POLYGON: u32 = 85768329
const N_USE: u32 = 1469170932
const N_DEFS: u32 = 2866998125
const N_SYMBOL: u32 = 4093333969
const N_TEXT: u32 = 3185987134
const N_TSPAN: u32 = 2965929447
const N_LINGRAD: u32 = 3919366736
const N_RADGRAD: u32 = 1884581770
const N_STOP: u32 = 3411225317
const N_TITLE: u32 = 2556802313
const N_DESC: u32 = 2198011936
const N_STYLE: u32 = 2888859350
const N_A: u32 = 3826002220
const N_SWITCH: u32 = 2480955249
const N_CLIPPATH: u32 = 948855084
const N_MASK: u32 = 3883353449
const N_FILTER: u32 = 3353438327
const N_PATTERN: u32 = 2268922153
const N_MARKER: u32 = 3086496151
const N_METADATA: u32 = 1713525568
const N_SCRIPT: u32 = 540962730

// ------------------------------------------------------------ The state

struct State {
    m: matrix.Mat, // Benutzerkoordinaten -> Bildpunkte
    f_art: u32, // farbe.F_*
    f_col: u32,
    f_va: usize, // Verweisname bei F_VERWEIS
    f_vn: usize,
    s_art: u32,
    s_col: u32,
    s_va: usize,
    s_vn: usize,
    width: f64,
    cap: u32,
    stoss: u32,
    gehrung: f64,
    strokes: [f64; 32],
    n_strokes: usize,
    offset: f64,
    f_deck: f64, // fill-opacity
    s_deck: f64, // stroke-opacity
    deck: f64, // opacity, aufmultipliziert
    rule: u32,
    aktuell: u32, // currentColor
    size: f64, // font-size
    anchor: u32,
    vw: f64, // das laufende Ansichtsfenster, fuer Prozentangaben
    vh: f64,
}

// The initial state by SVG 1.1: filled black, not stroked,
// stroke width 1, nonzero rule, everything opaque.
#[no_gc]
fn state_new(vw: f64, vh: f64) -> State {
    return State {
        m: matrix.mat_one(),
        f_art: color.F_COLOR,
        f_col: 4278190080 as u32,
        f_va: 0,
        f_vn: 0,
        s_art: color.F_NO,
        s_col: 4278190080 as u32,
        s_va: 0,
        s_vn: 0,
        width: 1.0,
        cap: dash.K_STUMPF,
        stoss: dash.S_GEHRUNG,
        gehrung: 4.0,
        strokes: [0.0; 32],
        n_strokes: 0,
        offset: 0.0,
        f_deck: 1.0,
        s_deck: 1.0,
        deck: 1.0,
        rule: RULE_NONZERO,
        aktuell: 4278190080 as u32,
        size: 16.0,
        anchor: ANCHOR_START,
        vw: vw,
        vh: vh,
    }
}

struct Painter {
    cv: *mut canvas.Canvas,
    ra: raster.Raster,
    abuf: *mut u8,
    rcap: usize,
    p1: path.Path, // die Form in Benutzerkoordinaten
    p2: path.Path, // geglaettet
    p3: path.Path, // der Umriss des Strichs
    st: dash.Dash,
    help: dash.Dash,
    scratch: *mut u8, // der Punktpuffer des TrueType-Lesers
    fm: u64, // die Schriftsammlung, 0 = keine
    ink: u64, // wieviele Bildpunkte wirklich gesetzt wurden
    // THE LOOP LOCK FOR `use`. Not the depth alone, but the
    // chain of the currently open targets: a `use` that points to an ancestor
    // would, with a pure depth limit, paint 24 copies before it
    // stops, and that looks like an error in the picture. If the target
    // already stands in the chain, it is SKIPPED -- exactly that is demanded by
    // SVG 1.1, 5.6 ("an invalid circular reference ... is an error").
    used: [u32; 24],
    n_used: usize,
    // THE LAYERS for `opacity` on a GROUP.
    //
    // `opacity` on a shape is simple: the colour becomes more transparent.
    // `opacity` on a GROUP is something different -- the group is
    // first painted FINISHED and then laid over as a whole transparently. The
    // difference is to be seen exactly where two children overlap:
    // multiplied through, the lower child shines through the upper one,
    // as a layer not. Measured against Chromium, on two overlapping rectangles with
    // `opacity="0.7"` that is 5.64 % deviating pixels -- too much to
    // call it an approximation.
    //
    // Four layers suffice; groups with opacity nested more deeply
    // fall back to multiplying through, and that stands in the
    // report.
    layer: [canvas.Canvas; 4],
    layer_present: [usize; 4],
    voriges: [u64; 4],
    n_layer: usize,
    ok: usize,
}

#[no_gc]
fn painter_new() -> Painter {
    return Painter {
        cv: 0 as *mut canvas.Canvas,
        ra: raster.raster_new(),
        abuf: 0 as *mut u8,
        rcap: 0,
        p1: path.path_new(),
        p2: path.path_new(),
        p3: path.path_new(),
        st: dash.dash_new(),
        help: dash.dash_new(),
        scratch: 0 as *mut u8,
        fm: 0,
        ink: 0,
        used: [0; 24],
        n_used: 0,
        layer: [canvas.canvas_new(); 4],
        layer_present: [0; 4],
        voriges: [0; 4],
        n_layer: 0,
        ok: 0,
    }
}

#[no_gc]
fn painter_init(m: *mut Painter, cv: *mut canvas.Canvas) -> bool {
    (*m).cv = cv
    let w: usize = canvas.canvas_width(cv)
    let h: usize = canvas.canvas_height(cv)
    let need: usize = raster.raster_bytes_needed(w, h)
    (*m).rcap = need
    (*m).abuf = mem.heap_alloc(need)
    (*m).scratch = mem.heap_alloc(GLYPH_SCRATCH)
    path.path_init(&(*m).p1)
    path.path_init(&(*m).p2)
    path.path_init(&(*m).p3)
    if (*m).abuf as usize == 0 || (*m).scratch as usize == 0 {
        return false
    }
    raster.raster_attach(&(*m).ra, (*m).abuf, need)
    (*m).ink = 0
    (*m).ok = 1
    return true
}

#[no_gc]
fn painter_free(m: *mut Painter) {
    var i: usize = 0
    while i < 4 {
        if (*m).layer_present[i] != 0 {
            canvas.canvas_free(&(*m).layer[i])
            (*m).layer_present[i] = 0
        }
        i = i + 1
    }
    mem.heap_free((*m).abuf, (*m).rcap)
    mem.heap_free((*m).scratch, GLYPH_SCRATCH)
    path.path_free(&(*m).p1)
    path.path_free(&(*m).p2)
    path.path_free(&(*m).p3)
    dash.dash_free(&(*m).st)
    dash.dash_free(&(*m).help)
    (*m).ok = 0
}

#[no_gc]
fn painter_ok(m: *mut Painter) -> bool {
    return (*m).ok != 0
}

// Open a layer. From now on everything goes onto the layer instead of onto
// the canvas.
#[no_gc]
fn layer_on(m: *mut Painter) -> bool {
    let k: usize = (*m).n_layer
    if k >= 4 {
        return false
    }
    let w: usize = canvas.canvas_width((*m).cv)
    let h: usize = canvas.canvas_height((*m).cv)
    if (*m).layer_present[k] == 0 {
        if !canvas.canvas_init(&(*m).layer[k], w, h) {
            return false
        }
        (*m).layer_present[k] = 1
    }
    if canvas.canvas_width(&(*m).layer[k]) != w
    || canvas.canvas_height(&(*m).layer[k]) != h {
        return false
    }
    canvas.canvas_clear(&(*m).layer[k], 0 as u32)
    (*m).voriges[k] = (*m).cv as u64
    (*m).cv = &(*m).layer[k]
    (*m).n_layer = k + 1
    return true
}

// Close the layer and lay it over with the opacity.
//
// The pixels of the layer are PREMULTIPLIED; `canvas_blend` wants
// a straight colour and an opacity. So it is converted back -- and
// only for pixels with opacity above zero, because at opacity zero
// the colour cannot be restored and is not needed either.
#[no_gc]
fn layer_ab(m: *mut Painter, deck: f64) {
    if (*m).n_layer == 0 {
        return
    }
    let k: usize = (*m).n_layer - 1
    (*m).n_layer = k
    let sch: *mut canvas.Canvas = &(*m).layer[k]
    (*m).cv = (*m).voriges[k] as *mut canvas.Canvas
    let w: usize = canvas.canvas_width(sch)
    let h: usize = canvas.canvas_height(sch)
    // Walk only the area that the clip of the canvas leaves over.
    let x0: i64 = klemmi(matrix.m_floor(canvas.clip_x0((*m).cv)), 0,
        w as i64)
    let y0: i64 = klemmi(matrix.m_floor(canvas.clip_y0((*m).cv)), 0,
        h as i64)
    let x1: i64 = klemmi(matrix.m_ceil(canvas.clip_x1((*m).cv)), 0, w as i64)
    let y1: i64 = klemmi(matrix.m_ceil(canvas.clip_y1((*m).cv)), 0, h as i64)
    var y: i64 = y0
    while y < y1 {
        var x: i64 = x0
        while x < x1 {
            let v: u32 = canvas.canvas_get(sch, x as usize, y as usize)
            let a: u32 = (v >> 24) & 255 as u32
            if a != 0 as u32 {
                let af: f64 = (a as f64) / 255.0
                let r: f64 = (((v >> 16) & 255 as u32) as f64) / af
                let g: f64 = (((v >> 8) & 255 as u32) as f64) / af
                let b: f64 = ((v & 255 as u32) as f64) / af
                let col: u32 = canvas.color_of(255 as u32, klemme255(r),
                    klemme255(g), klemme255(b))
                canvas.canvas_blend((*m).cv, x as usize, y as usize, col,
                    af * deck)
            }
            x = x + 1
        }
        y = y + 1
    }
}

#[no_gc]
fn klemme255(v: f64) -> u32 {
    if v != v || v <= 0.0 {
        return 0 as u32
    }
    if v >= 255.0 {
        return 255 as u32
    }
    return (v + 0.5) as u32
}

#[no_gc]
fn painter_set_font(m: *mut Painter, fm: u64) {
    (*m).fm = fm
}

#[no_gc]
fn painter_ink(m: *mut Painter) -> u64 {
    return (*m).ink
}

// --------------------------------------------------- Attributes and values

#[no_gc]
fn hash(p: u64, a: usize, n: usize) -> u32 {
    var v: u64 = 2166136261
    var i: usize = 0
    while i < n {
        v = (v ^ (matrix.read_byte(p, a + i) as u64)) & 4294967295
        v = (v * 16777619) & 4294967295
        i = i + 1
    }
    return v as u32
}

#[no_gc]
fn name_hash(b: *mut svgxml.Tree, i: u32) -> u32 {
    return hash(svgxml.tree_pool(b), svgxml.node_name_a(b, i),
        svgxml.node_name_n(b, i))
}

// A property from the `style` attribute. `style="fill:red;stroke:none"`
#[no_gc]
fn style_value(b: *mut svgxml.Tree, i: u32, w: u64, wn: usize, ra: *mut usize,
    rn: *mut usize) -> bool {
    var sa: usize = 0
    var sn: usize = 0
    var sw: [u8; 5] = "style"
    if !svgxml.attr_value(b, i, (&sw[0]) as u64, 5, &sa, &sn) {
        return false
    }
    return block_value(svgxml.tree_pool(b), sa, sn, w, wn, ra, rn)
}

// ONE PROPERTY FROM A DECLARATION BLOCK.
//
// That is the body that formerly stood in `style_wert`. It is now separated from
// the question WHERE the block comes from: from the `style` attribute
// of an element or from a rule of the `<style>` element in the
// document (see `blatt_sammeln`). Both look the same --
// `name: value; name: value`.
#[no_gc]
fn block_value(p: u64, ba: usize, bn: usize, w: u64, wn: usize,
    ra: *mut usize, rn: *mut usize) -> bool {
    let sa: usize = ba
    let end: usize = ba + bn
    var j: usize = sa
    while j < end {
        while j < end && (matrix.is_empty(matrix.read_byte(p, j))
            || matrix.read_byte(p, j) == 59) {
            j = j + 1
        }
        let nvon: usize = j
        while j < end && matrix.read_byte(p, j) != 58
        && matrix.read_byte(p, j) != 59 {
            j = j + 1
        }
        var nbis: usize = j
        while nbis > nvon && matrix.is_empty(matrix.read_byte(p, nbis - 1)) {
            nbis = nbis - 1
        }
        if j >= end || matrix.read_byte(p, j) != 58 {
            // No colon -- rubbish, skip to the next semicolon.
            while j < end && matrix.read_byte(p, j) != 59 {
                j = j + 1
            }
            continue
        }
        j = j + 1
        while j < end && matrix.is_empty(matrix.read_byte(p, j)) {
            j = j + 1
        }
        let wvon: usize = j
        while j < end && matrix.read_byte(p, j) != 59 {
            j = j + 1
        }
        var wbis: usize = j
        while wbis > wvon && matrix.is_empty(matrix.read_byte(p, wbis - 1)) {
            wbis = wbis - 1
        }
        if nbis - nvon == wn {
            var k: usize = 0
            var equal: bool = true
            while k < wn {
                if matrix.read_byte(p, nvon + k) != matrix.read_byte(w, k) {
                    equal = false
                    break
                }
                k = k + 1
            }
            if equal {
                *ra = wvon
                *rn = wbis - wvon
                return true
            }
        }
    }
    return false
}

// ===================================================================
// ROUND R3-2 -- THE STYLE SHEET IN THE SVG ITSELF
// ===================================================================
//
// The paint state so far came from two sources: the `style` attribute and
// the presentation attribute (`fill="red"`). Exactly a third was missing --
// the `<style>` ELEMENT IN THE DOCUMENT. `zeichne` expressly
// skipped it ("storage containers and descriptions").
//
// That is no edge case. Every tool that exports from Illustrator or
// Figma writes its colours exactly like this:
//
//     <defs><style>.cls-1 { fill: #19afff; }</style></defs>
//     <path class="cls-1" d="..."/>
//
// Without this source every path stays at the initial value of SVG 1.1 --
// BLACK. That is the black blob that the willhaben logo leaves
// in .gauntlet-shots/willhaben.png (the file
// /bbx-search/_next/static/assets/logo.*.svg has exactly this structure),
// and the same reason stands behind the black boxes of other
// symbols.
//
// What works here: type, class, id and universal selectors, also as a
// list with commas; comments; `@` rules are skipped. What does
// NOT work (descendants, pseudo-classes, attribute selectors) is
// recognised and the rule left out -- better no colour than the
// wrong one. The precedence is that of CSS 2.1, 6.4.4: the
// `style` attribute beats the rule, the rule beats the
// presentation attribute.
const REG_MAX: usize = 128
static mut G_REG_ART: [u32; 128] = [0 as u32; 128] // 0 Typ 1 Klasse 2 Id 3 *
static mut G_REG_HASH: [u32; 128] = [0 as u32; 128]
static mut G_REG_A: [usize; 128] = [0 as usize; 128]
static mut G_REG_N: [usize; 128] = [0 as usize; 128]
static mut G_REG_SPEZ: [u32; 128] = [0 as u32; 128]
static mut G_NREG: usize = 0

#[no_gc]
fn leaf_clear() {
    G_NREG = 0
}

// A selector, already cut to size. `false` means: not
// supported, the rule is left out.
#[no_gc]
fn picker_remember(p: u64, von_in: usize, bis_in: usize, ba: usize,
    bn: usize) {
    var von: usize = von_in
    var bis: usize = bis_in
    while von < bis && matrix.is_empty(matrix.read_byte(p, von)) {
        von = von + 1
    }
    while bis > von && matrix.is_empty(matrix.read_byte(p, bis - 1)) {
        bis = bis - 1
    }
    if bis <= von || G_NREG >= REG_MAX {
        return
    }
    // Everything that is more than ONE simple selector stays outside.
    var k: usize = von
    while k < bis {
        let c: u32 = matrix.read_byte(p, k)
        if matrix.is_empty(c) || c == 62 || c == 43 || c == 126 || c == 58
        || c == 91 || c == 40 {
            return
        }
        if k > von && (c == 46 || c == 35) {
            return
        }
        k = k + 1
    }
    let c0: u32 = matrix.read_byte(p, von)
    var art: u32 = 0
    var spez: u32 = 1
    var na: usize = von
    if c0 == 46 {
        art = 1
        spez = 10
        na = von + 1
    } else if c0 == 35 {
        art = 2
        spez = 100
        na = von + 1
    } else if c0 == 42 && bis - von == 1 {
        art = 3
        spez = 0
        na = von
    }
    if art != 3 && bis <= na {
        return
    }
    let k2: usize = G_NREG
    G_REG_ART[k2] = art
    G_REG_HASH[k2] = hash(p, na, bis - na)
    G_REG_A[k2] = ba
    G_REG_N[k2] = bn
    G_REG_SPEZ[k2] = spez
    G_NREG = k2 + 1
}

// The text of a `<style>` element: rule by rule.
#[no_gc]
fn leaf_read(p: u64, a: usize, n: usize) {
    let end: usize = a + n
    var j: usize = a
    while j < end {
        // Comments and whitespace away.
        if matrix.read_byte(p, j) == 47 && j + 1 < end
        && matrix.read_byte(p, j + 1) == 42 {
            j = j + 2
            while j + 1 < end && !(matrix.read_byte(p, j) == 42
                && matrix.read_byte(p, j + 1) == 47) {
                j = j + 1
            }
            j = j + 2
            continue
        }
        if matrix.is_empty(matrix.read_byte(p, j)) {
            j = j + 1
            continue
        }
        // An `@` rule: skip to the semicolon or over its block.
        if matrix.read_byte(p, j) == 64 {
            var depth: usize = 0
            while j < end {
                let c2: u32 = matrix.read_byte(p, j)
                if c2 == 123 {
                    depth = depth + 1
                } else if c2 == 125 {
                    j = j + 1
                    if depth <= 1 {
                        break
                    }
                    depth = depth - 1
                    continue
                } else if c2 == 59 && depth == 0 {
                    j = j + 1
                    break
                }
                j = j + 1
            }
            continue
        }
        let svon: usize = j
        while j < end && matrix.read_byte(p, j) != 123 {
            j = j + 1
        }
        if j >= end {
            return
        }
        let sbis: usize = j
        j = j + 1
        let bvon: usize = j
        while j < end && matrix.read_byte(p, j) != 125 {
            j = j + 1
        }
        let bbis: usize = j
        if j < end {
            j = j + 1
        }
        // Split the selector list at the commas.
        var t: usize = svon
        var piece: usize = svon
        while t <= sbis {
            if t == sbis || matrix.read_byte(p, t) == 44 {
                picker_remember(p, piece, t, bvon, bbis - bvon)
                piece = t + 1
            }
            t = t + 1
        }
    }
}

// Collect all `<style>` elements of the tree. Once per image.
#[no_gc]
fn leaf_collect(b: *mut svgxml.Tree) {
    leaf_clear()
    let p: u64 = svgxml.tree_pool(b)
    let n: usize = svgxml.node_count(b)
    var i: usize = 0
    while i < n {
        let e: u32 = i as u32
        if svgxml.node_type(b, e) == svgxml.K_ELEM && name_hash(b, e)
        == N_STYLE {
            var c: u32 = svgxml.node_kind(b, e)
            while c != svgxml.KEINER {
                if svgxml.node_type(b, c) == svgxml.K_TEXT {
                    leaf_read(p, svgxml.node_text_a(b, c),
                        svgxml.node_text_n(b, c))
                }
                c = svgxml.node_next(b, c)
            }
        }
        i = i + 1
    }
}

// Does rule `k` fit element `i`?
#[no_gc]
fn rule_fits(b: *mut svgxml.Tree, i: u32, k: usize) -> bool {
    let art: u32 = G_REG_ART[k]
    if art == 3 {
        return true
    }
    if art == 0 {
        return name_hash(b, i) == G_REG_HASH[k]
    }
    let p: u64 = svgxml.tree_pool(b)
    var a: usize = 0
    var n: usize = 0
    if art == 2 {
        var wid: [u8; 2] = "id"
        if !svgxml.attr_value(b, i, (&wid[0]) as u64, 2, &a, &n) {
            return false
        }
        return hash(p, a, n) == G_REG_HASH[k]
    }
    var wcl: [u8; 5] = "class"
    if !svgxml.attr_value(b, i, (&wcl[0]) as u64, 5, &a, &n) {
        return false
    }
    let end: usize = a + n
    var j: usize = a
    while j < end {
        while j < end && matrix.is_empty(matrix.read_byte(p, j)) {
            j = j + 1
        }
        let von: usize = j
        while j < end && !matrix.is_empty(matrix.read_byte(p, j)) {
            j = j + 1
        }
        if j > von && hash(p, von, j - von) == G_REG_HASH[k] {
            return true
        }
    }
    return false
}

// The value from the style sheet -- the one with the highest precedence, at
// a tie the later one.
#[no_gc]
fn leaf_value(b: *mut svgxml.Tree, i: u32, w: u64, wn: usize, ra: *mut usize,
    rn: *mut usize) -> bool {
    if G_NREG == 0 {
        return false
    }
    let p: u64 = svgxml.tree_pool(b)
    var found: bool = false
    var best: u32 = 0
    var k: usize = 0
    while k < G_NREG {
        var a: usize = 0
        var n: usize = 0
        if block_value(p, G_REG_A[k], G_REG_N[k], w, wn, &a, &n)
        && rule_fits(b, i, k) {
            if !found || G_REG_SPEZ[k] >= best {
                best = G_REG_SPEZ[k]
                *ra = a
                *rn = n
                found = true
            }
        }
        k = k + 1
    }
    return found
}

// The value of a paint statement: first `style`, then the style sheet, then the
// attribute (CSS 2.1, 6.4.4).
#[no_gc]
fn get_value(b: *mut svgxml.Tree, i: u32, w: u64, wn: usize, ra: *mut usize,
    rn: *mut usize) -> bool {
    if style_value(b, i, w, wn, ra, rn) {
        return true
    }
    if leaf_value(b, i, w, wn, ra, rn) {
        return true
    }
    return svgxml.attr_value(b, i, w, wn, ra, rn)
}

// A LENGTH. `bezug` is the reference size for percentages.
//
// The conversions are those of CSS: 1pt = 4/3 px, 1pc = 16 px,
// 1in = 96 px, 1cm = 96/2.54 px, 1mm = 96/25.4 px. `em` and `ex` depend
// on the font size; `ex` is taken as half of it, which is
// the usual approximation when the font reports no x-height.
#[no_gc]
fn length_of(p: u64, a: usize, n: usize, ref_node: f64, size: f64,
    ok: *mut bool) -> f64 {
    var i: usize = a
    let end: usize = a + n
    matrix.skip_empty(p, end, &i)
    let v: f64 = matrix.number(p, end, &i, ok)
    if !*ok {
        return 0.0
    }
    matrix.skip_empty(p, end, &i)
    if i >= end {
        return v
    }
    let c0: u32 = matrix.read_byte(p, i)
    if c0 == 37 {
        return v * ref_node / 100.0
    }
    if i + 1 >= end {
        return v
    }
    let c1: u32 = matrix.read_byte(p, i + 1)
    if c0 == 112 && c1 == 120 {
        return v
    }
    if c0 == 112 && c1 == 116 {
        return v * 4.0 / 3.0
    }
    if c0 == 112 && c1 == 99 {
        return v * 16.0
    }
    if c0 == 105 && c1 == 110 {
        return v * 96.0
    }
    if c0 == 99 && c1 == 109 {
        return v * 96.0 / 2.54
    }
    if c0 == 109 && c1 == 109 {
        return v * 96.0 / 25.4
    }
    if c0 == 101 && c1 == 109 {
        return v * size
    }
    if c0 == 101 && c1 == 120 {
        return v * size / 2.0
    }
    return v
}

// An attribute as a length, with a default value.
#[no_gc]
fn attr_length(b: *mut svgxml.Tree, i: u32, w: u64, wn: usize, ref_node: f64,
    z: *mut State, default: f64) -> f64 {
    var a: usize = 0
    var n: usize = 0
    if !get_value(b, i, w, wn, &a, &n) {
        return default
    }
    var ok: bool = false
    let v: f64 = length_of(svgxml.tree_pool(b), a, n, ref_node, (*z).size, &ok)
    if !ok {
        return default
    }
    return v
}

// The reference size for a percentage in a direction that is neither
// horizontal nor vertical (say `r` of a circle): the
// normalised diagonal of the viewport, SVG 1.1, 7.10.
#[no_gc]
fn diagonale(vw: f64, vh: f64) -> f64 {
    return matrix.m_sqrt(vw * vw + vh * vh) / 1.4142135623730951
}

// -------------------------------------------------------- The window

#[no_gc]
fn klemmi(v: f64, lo: i64, hi: i64) -> i64 {
    if v != v {
        return lo
    }
    if v < (lo as f64) {
        return lo
    }
    if v > (hi as f64) {
        return hi
    }
    return v as i64
}

// The rectangle of pixels that a shape can touch -- intersected with the
// clip of the canvas.
#[no_gc]
fn window(m: *mut Painter, x0: f64, y0: f64, x1: f64, y1: f64, wx: *mut i64,
    wy: *mut i64, w: *mut usize, h: *mut usize) -> bool {
    let cw: usize = canvas.canvas_width((*m).cv)
    let ch: usize = canvas.canvas_height((*m).cv)
    var a0: f64 = x0 - 1.0
    var b0: f64 = y0 - 1.0
    var a1: f64 = x1 + 1.0
    var b1: f64 = y1 + 1.0
    let cx0: f64 = canvas.clip_x0((*m).cv)
    let cy0: f64 = canvas.clip_y0((*m).cv)
    let cx1: f64 = canvas.clip_x1((*m).cv)
    let cy1: f64 = canvas.clip_y1((*m).cv)
    if a0 < cx0 {
        a0 = cx0
    }
    if b0 < cy0 {
        b0 = cy0
    }
    if a1 > cx1 {
        a1 = cx1
    }
    if b1 > cy1 {
        b1 = cy1
    }
    let ix0: i64 = klemmi(matrix.m_floor(a0), 0, cw as i64)
    let iy0: i64 = klemmi(matrix.m_floor(b0), 0, ch as i64)
    let ix1: i64 = klemmi(matrix.m_ceil(a1), 0, cw as i64)
    let iy1: i64 = klemmi(matrix.m_ceil(b1), 0, ch as i64)
    if ix1 <= ix0 || iy1 <= iy0 {
        return false
    }
    *wx = ix0
    *wy = iy0
    *w = (ix1 - ix0) as usize
    *h = (iy1 - iy0) as usize
    return true
}

// ------------------------------------------------------------ Verlaeufe

struct Gradient {
    da: bool,
    radial: bool,
    // Die Zahlen im Verlaufssystem.
    x1: f64,
    y1: f64,
    x2: f64,
    y2: f64,
    cx: f64,
    cy: f64,
    r: f64,
    fx: f64,
    fy: f64,
    unit_bbox: bool, // gradientUnits = objectBoundingBox
    gm: matrix.Mat, // gradientTransform
    spreiz: u32, // 0 pad, 1 reflect, 2 repeat
    off: [f64; 32],
    col: [u32; 32],
    n: usize,
}

#[no_gc]
fn gradient_new() -> Gradient {
    return Gradient {
        da: false,
        radial: false,
        x1: 0.0,
        y1: 0.0,
        x2: 1.0,
        y2: 0.0,
        cx: 0.5,
        cy: 0.5,
        r: 0.5,
        fx: 0.5,
        fy: 0.5,
        unit_bbox: true,
        gm: matrix.mat_one(),
        spreiz: 0,
        off: [0.0; 32],
        col: [0; 32],
        n: 0,
    }
}

// Look for an element with this `id`. Linear -- an SVG tree rarely has
// more than a few thousand nodes, and a directory would be a
// second store that would have to be kept in sync with the tree.
#[no_gc]
fn find_id(b: *mut svgxml.Tree, p: u64, a: usize, n: usize) -> u32 {
    if n == 0 {
        return svgxml.KEINER
    }
    var iw: [u8; 2] = "id"
    let anz: usize = svgxml.node_count(b)
    let pool: u64 = svgxml.tree_pool(b)
    var i: usize = 0
    while i < anz {
        let k: u32 = i as u32
        if svgxml.node_type(b, k) == svgxml.K_ELEM {
            var va: usize = 0
            var vn: usize = 0
            if svgxml.attr_value(b, k, (&iw[0]) as u64, 2, &va, &vn) {
                if vn == n {
                    var j: usize = 0
                    var equal: bool = true
                    while j < n {
                        if matrix.read_byte(pool, va + j)
                        != matrix.read_byte(p, a + j) {
                            equal = false
                            break
                        }
                        j = j + 1
                    }
                    if equal {
                        return k
                    }
                }
            }
        }
        i = i + 1
    }
    return svgxml.KEINER
}

#[no_gc]
fn stops_read(v: *mut Gradient, b: *mut svgxml.Tree, e: u32, z: *mut State) {
    var soff: [u8; 6] = "offset"
    var scol: [u8; 10] = "stop-color"
    var sop: [u8; 12] = "stop-opacity"
    let pool: u64 = svgxml.tree_pool(b)
    var k: u32 = svgxml.node_kind(b, e)
    while k != svgxml.KEINER {
        if svgxml.node_type(b, k) == svgxml.K_ELEM && name_hash(b, k) == N_STOP {
            if (*v).n < STOPP_MAX {
                var a: usize = 0
                var n: usize = 0
                var o: f64 = 0.0
                if get_value(b, k, (&soff[0]) as u64, 6, &a, &n) {
                    var ok: bool = false
                    o = length_of(pool, a, n, 1.0, (*z).size, &ok)
                    if !ok {
                        o = 0.0
                    }
                }
                if o < 0.0 {
                    o = 0.0
                }
                if o > 1.0 {
                    o = 1.0
                }
                // The stops must ascend; a smaller value is
                // raised to the previous one (SVG 1.1, 13.2.4).
                if (*v).n > 0 && o < (*v).off[(*v).n - 1] {
                    o = (*v).off[(*v).n - 1]
                }
                var c: u32 = 4278190080 as u32
                if get_value(b, k, (&scol[0]) as u64, 10, &a, &n) {
                    var va: usize = 0
                    var vn: usize = 0
                    let art: u32 = color.read_color(pool, a, n, &c, &va, &vn)
                    if art == color.F_AKTUELL {
                        c = (*z).aktuell
                    } else if art != color.F_COLOR {
                        c = 4278190080 as u32
                    }
                }
                var d: f64 = 1.0
                if get_value(b, k, (&sop[0]) as u64, 12, &a, &n) {
                    var ok2: bool = false
                    d = color.read_coverage(pool, a, n, &ok2)
                    if !ok2 {
                        d = 1.0
                    }
                }
                let al: f64 = (((c >> 24) & 255 as u32) as f64) * d
                var ai: u32 = 0 as u32
                if al > 0.0 {
                    ai = (al + 0.5) as u32
                    if ai > 255 as u32 {
                        ai = 255 as u32
                    }
                }
                (*v).off[(*v).n] = o
                (*v).col[(*v).n] = (ai << 24) | (c & 16777215 as u32)
                (*v).n = (*v).n + 1
            }
        }
        k = svgxml.node_next(b, k)
    }
}

// Read a gradient from an element. `tiefe` locks an `href` chain
// that goes in a circle.
#[no_gc]
fn gradient_read(v: *mut Gradient, b: *mut svgxml.Tree, e: u32, z: *mut State,
    depth: usize) {
    if e == svgxml.KEINER || depth > 8 {
        return
    }
    let art: u32 = name_hash(b, e)
    let radial: bool = art == N_RADGRAD
    if art != N_LINGRAD && !radial {
        return
    }
    (*v).da = true
    (*v).radial = radial
    let pool: u64 = svgxml.tree_pool(b)
    // First the reference: `href` inherits everything that does not stand here.
    var hw: [u8; 4] = "href"
    var ha: usize = 0
    var hn: usize = 0
    if svgxml.attr_value(b, e, (&hw[0]) as u64, 4, &ha, &hn) {
        if hn > 1 && matrix.read_byte(pool, ha) == 35 {
            let o: u32 = find_id(b, pool, ha + 1, hn - 1)
            if o != svgxml.KEINER && o != e {
                gradient_read(v, b, o, z, depth + 1)
                (*v).radial = radial
            }
        }
    }
    var a: usize = 0
    var n: usize = 0
    var wgu: [u8; 13] = "gradientUnits"
    if svgxml.attr_value(b, e, (&wgu[0]) as u64, 13, &a, &n) {
        var wus: [u8; 14] = "userSpaceOnUse"
        // Comparing only the first 13 characters is not enough; the length
        // is checked along.
        if n == 14 {
            var equal: bool = true
            var j: usize = 0
            while j < 14 {
                if matrix.read_byte(pool, a + j)
                != matrix.read_byte((&wus[0]) as u64, j) {
                    equal = false
                    break
                }
                j = j + 1
            }
            if equal {
                (*v).unit_bbox = false
            }
        }
    }
    var wgt: [u8; 17] = "gradientTransform"
    if svgxml.attr_value(b, e, (&wgt[0]) as u64, 17, &a, &n) {
        (*v).gm = matrix.split_transform(pool + a as u64, n)
    }
    var wsm: [u8; 12] = "spreadMethod"
    if svgxml.attr_value(b, e, (&wsm[0]) as u64, 12, &a, &n) {
        if n >= 3 {
            let c0: u32 = matrix.read_byte(pool, a)
            if c0 == 114 {
                if n == 7 {
                    (*v).spreiz = 1 // reflect
                } else {
                    (*v).spreiz = 2 // repeat
                }
            }
        }
    }
    // The numbers. With `objectBoundingBox` they are shares, otherwise
    // user coordinates; the percentage refers in both
    // cases to 1 or to the viewport.
    var bez_x: f64 = 1.0
    var bez_y: f64 = 1.0
    var bez_d: f64 = 1.0
    if !(*v).unit_bbox {
        bez_x = (*z).vw
        bez_y = (*z).vh
        bez_d = diagonale((*z).vw, (*z).vh)
    }
    var w1: [u8; 2] = "x1"
    var w2: [u8; 2] = "y1"
    var w3: [u8; 2] = "x2"
    var w4: [u8; 2] = "y2"
    if svgxml.attr_value(b, e, (&w1[0]) as u64, 2, &a, &n) {
        var ok: bool = false
        (*v).x1 = length_of(pool, a, n, bez_x, (*z).size, &ok)
    }
    if svgxml.attr_value(b, e, (&w2[0]) as u64, 2, &a, &n) {
        var ok: bool = false
        (*v).y1 = length_of(pool, a, n, bez_y, (*z).size, &ok)
    }
    if svgxml.attr_value(b, e, (&w3[0]) as u64, 2, &a, &n) {
        var ok: bool = false
        (*v).x2 = length_of(pool, a, n, bez_x, (*z).size, &ok)
    }
    if svgxml.attr_value(b, e, (&w4[0]) as u64, 2, &a, &n) {
        var ok: bool = false
        (*v).y2 = length_of(pool, a, n, bez_y, (*z).size, &ok)
    }
    var wcx: [u8; 2] = "cx"
    var wcy: [u8; 2] = "cy"
    var wr: [u8; 1] = "r"
    var wfx: [u8; 2] = "fx"
    var wfy: [u8; 2] = "fy"
    var hat_f: bool = false
    if svgxml.attr_value(b, e, (&wcx[0]) as u64, 2, &a, &n) {
        var ok: bool = false
        (*v).cx = length_of(pool, a, n, bez_x, (*z).size, &ok)
    }
    if svgxml.attr_value(b, e, (&wcy[0]) as u64, 2, &a, &n) {
        var ok: bool = false
        (*v).cy = length_of(pool, a, n, bez_y, (*z).size, &ok)
    }
    if svgxml.attr_value(b, e, (&wr[0]) as u64, 1, &a, &n) {
        var ok: bool = false
        (*v).r = length_of(pool, a, n, bez_d, (*z).size, &ok)
    }
    if svgxml.attr_value(b, e, (&wfx[0]) as u64, 2, &a, &n) {
        var ok: bool = false
        (*v).fx = length_of(pool, a, n, bez_x, (*z).size, &ok)
        hat_f = true
    }
    if svgxml.attr_value(b, e, (&wfy[0]) as u64, 2, &a, &n) {
        var ok: bool = false
        (*v).fy = length_of(pool, a, n, bez_y, (*z).size, &ok)
        hat_f = true
    }
    if !hat_f {
        // Without `fx`/`fy` the focal point lies in the middle.
        (*v).fx = (*v).cx
        (*v).fy = (*v).cy
    }
    // Eigene Stopps ueberschreiben geerbte.
    var own: usize = 0
    var k: u32 = svgxml.node_kind(b, e)
    while k != svgxml.KEINER {
        if name_hash(b, k) == N_STOP {
            own = own + 1
        }
        k = svgxml.node_next(b, k)
    }
    if own > 0 {
        (*v).n = 0
        stops_read(v, b, e, z)
    }
}

// The colour at the position `t`. Between two stops mixing is done in STRAIGHT
// (not premultiplied) representation -- that is what SVG 1.1 demands,
// and the difference is visible to the naked eye with a gradient to
// `transparent`.
#[no_gc]
fn gradient_color(v: *mut Gradient, t_in: f64) -> u32 {
    let n: usize = (*v).n
    if n == 0 {
        return 0 as u32
    }
    var t: f64 = t_in
    if (*v).spreiz == 2 {
        t = t - matrix.m_floor(t)
    } else if (*v).spreiz == 1 {
        var u: f64 = t - matrix.m_floor(t / 2.0) * 2.0
        if u > 1.0 {
            u = 2.0 - u
        }
        t = u
    } else {
        if t < 0.0 {
            t = 0.0
        }
        if t > 1.0 {
            t = 1.0
        }
    }
    if n == 1 {
        return (*v).col[0]
    }
    if t <= (*v).off[0] {
        return (*v).col[0]
    }
    if t >= (*v).off[n - 1] {
        return (*v).col[n - 1]
    }
    var i: usize = 1
    while i < n {
        if t <= (*v).off[i] {
            let o0: f64 = (*v).off[i - 1]
            let o1: f64 = (*v).off[i]
            var f: f64 = 0.0
            if o1 > o0 {
                f = (t - o0) / (o1 - o0)
            }
            let a: u32 = (*v).col[i - 1]
            let bb: u32 = (*v).col[i]
            return mix(a, bb, f)
        }
        i = i + 1
    }
    return (*v).col[n - 1]
}

#[no_gc]
fn channel(a: u32, b: u32, sh: u32, f: f64) -> u32 {
    let x: f64 = ((a >> sh) & 255 as u32) as f64
    let y: f64 = ((b >> sh) & 255 as u32) as f64
    var v: f64 = x + (y - x) * f
    if v < 0.0 {
        v = 0.0
    }
    if v > 255.0 {
        v = 255.0
    }
    return (v + 0.5) as u32
}

#[no_gc]
fn mix(a: u32, b: u32, f: f64) -> u32 {
    return (channel(a, b, 24, f) << 24) | (channel(a, b, 16, f) << 16)
    | (channel(a, b, 8, f) << 8) | channel(a, b, 0, f)
}

// ------------------------------------------------------- Filling and painting

// Multiply a colour by an opacity.
#[no_gc]
fn with_coverage(col: u32, d: f64) -> u32 {
    if d >= 1.0 {
        return col
    }
    var a: f64 = (((col >> 24) & 255 as u32) as f64) * d
    if a < 0.0 {
        a = 0.0
    }
    if a > 255.0 {
        a = 255.0
    }
    return (((a + 0.5) as u32) << 24) | (col & 16777215 as u32)
}

// THE ONE PLACE at which pixels are set. The rasteriser has already
// calculated the opacity; here only the colour is added -- either
// a fixed one or one from a gradient.
#[no_gc]
fn giesse(m: *mut Painter, wx: i64, wy: i64, w: usize, h: usize, col: u32,
    v: *mut Gradient, gv: bool, gi: matrix.Mat) {
    // THE LINE IN ONE PIECE. `raster_cov` checks per pixel the
    // bounds and calculates the index; with a long stroke the
    // window is easily 400 x 250 large, and then this loop runs
    // a hundred thousand times per shape. Measured on 1000 long strokes:
    // 2.62 s with the call per pixel against 0.55 s with the
    // row pointer -- the same raster content, the same calculation, only
    // without the call.
    var yy: usize = 0
    while yy < h {
        let line: u64 = raster.raster_cov_row(&(*m).ra, yy)
        var xx: usize = 0
        while xx < w {
            let cov: f64 = *((line + (xx * 8) as u64) as *mut f64)
            if cov > 0.0 {
                var c: u32 = col
                if gv {
                    let sx: f64 = ((wx + xx as i64) as f64) + 0.5
                    let sy: f64 = ((wy + yy as i64) as f64) + 0.5
                    let gx: f64 = matrix.mat_x(gi, sx, sy)
                    let gy: f64 = matrix.mat_y(gi, sx, sy)
                    var t: f64 = 0.0
                    if (*v).radial {
                        t = radial_t(v, gx, gy)
                    } else {
                        let dx: f64 = (*v).x2 - (*v).x1
                        let dy: f64 = (*v).y2 - (*v).y1
                        let l2: f64 = dx * dx + dy * dy
                        if l2 > 0.0 {
                            t = ((gx - (*v).x1) * dx + (gy - (*v).y1) * dy) / l2
                        }
                    }
                    c = gradient_color(v, t)
                    // The opacity of the shape acts on the gradient colour.
                    c = with_coverage(c, (((col >> 24) & 255 as u32) as f64)
                        / 255.0)
                }
                if (c >> 24) != 0 as u32 {
                    let a: f64 = (((c >> 24) & 255 as u32) as f64) / 255.0
                    canvas.canvas_blend((*m).cv, (wx + xx as i64) as usize,
                        (wy + yy as i64) as usize,
                        c | 4278190080 as u32, cov * a)
                    if cov > 0.5 {
                        (*m).ink = (*m).ink + 1
                    }
                }
            }
            xx = xx + 1
        }
        yy = yy + 1
    }
}

// The value of a radial gradient at a point, with a focal point.
#[no_gc]
fn radial_t(v: *mut Gradient, gx: f64, gy: f64) -> f64 {
    let r: f64 = (*v).r
    if r <= 0.0 {
        return 1.0
    }
    var fx: f64 = (*v).fx
    var fy: f64 = (*v).fy
    // A focal point OUTSIDE the circle is not allowed; the
    // specification pushes it to the edge.
    let ddx: f64 = fx - (*v).cx
    let ddy: f64 = fy - (*v).cy
    let dd: f64 = matrix.m_sqrt(ddx * ddx + ddy * ddy)
    if dd > r * 0.999 {
        let s: f64 = r * 0.999 / dd
        fx = (*v).cx + ddx * s
        fy = (*v).cy + ddy * s
    }
    let dx: f64 = gx - fx
    let dy: f64 = gy - fy
    let a: f64 = dx * dx + dy * dy
    if a <= 0.0 {
        return 0.0
    }
    let ex: f64 = fx - (*v).cx
    let ey: f64 = fy - (*v).cy
    let bb: f64 = 2.0 * (dx * ex + dy * ey)
    let cc: f64 = ex * ex + ey * ey - r * r
    let disk: f64 = bb * bb - 4.0 * a * cc
    if disk < 0.0 {
        return 1.0
    }
    let s: f64 = (0.0 - bb + matrix.m_sqrt(disk)) / (2.0 * a)
    if s <= 0.0 {
        return 1.0
    }
    return 1.0 / s
}

// FILL a path. `bx0..by1` is the bounding box of the shape in
// USER coordinates -- a gradient with `objectBoundingBox` needs it.
#[no_gc]
fn fill_path(m: *mut Painter, b: *mut svgxml.Tree, pf: *mut path.Path,
    z: *mut State, art: u32, col: u32, va: usize, vn: usize, deck: f64,
    rule: u32, bx0: f64, by0: f64, bx1: f64, by1: f64) {
    if art == color.F_NO {
        return
    }
    var farbwert: u32 = col
    if art == color.F_AKTUELL {
        farbwert = (*z).aktuell
    }
    var v: Gradient = gradient_new()
    var gv: bool = false
    var gi: matrix.Mat = matrix.mat_one()
    if art == color.F_REF {
        let e: u32 = find_id(b, svgxml.tree_pool(b), va, vn)
        if e != svgxml.KEINER {
            gradient_read(&v, b, e, z, 0)
        }
        if v.da && v.n > 0 {
            // The gradient system: user coordinates, then if need be the
            // unit box of the shape, then `gradientTransform`.
            var g: matrix.Mat = (*z).m
            if v.unit_bbox {
                let bw: f64 = bx1 - bx0
                let bh: f64 = by1 - by0
                if bw <= 0.0 || bh <= 0.0 {
                    return
                }
                g = matrix.mat_mal(g, matrix.mat_of_six(bw, 0.0, 0.0, bh,
                        bx0, by0))
            }
            g = matrix.mat_mal(g, v.gm)
            var ok: bool = false
            gi = matrix.mat_kehr(g, &ok)
            if !ok {
                return
            }
            gv = true
        } else if v.da {
            // A gradient without stops colours nothing (SVG 1.1, 13.2.4).
            return
        }
        // No gradient found -> the fallback colour in `col`.
    }
    var x0: f64 = 0.0
    var y0: f64 = 0.0
    var x1: f64 = 0.0
    var y1: f64 = 0.0
    if !path.path_limits(pf, (*z).m, &x0, &y0, &x1, &y1) {
        return
    }
    var wx: i64 = 0
    var wy: i64 = 0
    var w: usize = 0
    var h: usize = 0
    if !window(m, x0, y0, x1, y1, &wx, &wy, &w, &h) {
        return
    }
    if !raster.raster_begin(&(*m).ra, wx as f64, wy as f64, w, h) {
        return
    }
    path.path_an_raster(pf, &(*m).ra, (*z).m)
    if rule == RULE_EVEN {
        raster.raster_finish_evenodd(&(*m).ra)
    } else {
        raster.raster_finish(&(*m).ra)
    }
    giesse(m, wx, wy, w, h, with_coverage(farbwert, deck), &v, gv, gi)
}

// STROKE a path. The outline arises in user coordinates and
// is afterwards treated like a fill -- with the nonzero rule, because
// the outline is by construction a union of equally directed contours.
#[no_gc]
fn stroke_path(m: *mut Painter, b: *mut svgxml.Tree, pf: *mut path.Path,
    z: *mut State, bx0: f64, by0: f64, bx1: f64, by1: f64) {
    if (*z).s_art == color.F_NO || (*z).width <= 0.0 {
        return
    }
    let mass: f64 = matrix.mat_laengenmass((*z).m)
    path.path_smooth(&(*m).p2, pf, mass)
    (*m).st.width = (*z).width
    (*m).st.cap = (*z).cap
    (*m).st.stoss = (*z).stoss
    (*m).st.gehrung = (*z).gehrung
    (*m).st.n_strokes = (*z).n_strokes
    (*m).st.offset = (*z).offset
    var i: usize = 0
    while i < (*z).n_strokes {
        (*m).st.strokes[i] = (*z).strokes[i]
        i = i + 1
    }
    dash.dash_outline(&(*m).p3, &(*m).p2, &(*m).st, &(*m).help)
    fill_path(m, b, &(*m).p3, z, (*z).s_art, (*z).s_col, (*z).s_va,
        (*z).s_vn, (*z).s_deck * (*z).deck, RULE_NONZERO, bx0, by0,
        bx1, by1)
}

// Both, in the right order: first the fill, then the
// stroke. A stroke ALWAYS lies above the fill of the same shape.
#[no_gc]
fn times_shape(m: *mut Painter, b: *mut svgxml.Tree, z: *mut State) {
    var bx0: f64 = 0.0
    var by0: f64 = 0.0
    var bx1: f64 = 0.0
    var by1: f64 = 0.0
    if !path.path_limits(&(*m).p1, matrix.mat_one(), &bx0, &by0, &bx1,
        &by1) {
        return
    }
    fill_path(m, b, &(*m).p1, z, (*z).f_art, (*z).f_col, (*z).f_va,
        (*z).f_vn, (*z).f_deck * (*z).deck, (*z).rule, bx0, by0, bx1, by1)
    stroke_path(m, b, &(*m).p1, z, bx0, by0, bx1, by1)
}

// ------------------------------------------------- The state of an element
//
// Reads all paint statements of the element and changes the inherited state.
// The order is not arbitrary: `color` first, because `fill`
// may be `currentColor`; `transform` last, because it changes
// the matrix with which the children calculate.

#[no_gc]
fn set_paintsite(pool: u64, a: usize, n: usize, art: *mut u32,
    col: *mut u32, va: *mut usize, vn: *mut usize) {
    var c: u32 = 0
    var va2: usize = 0
    var vn2: usize = 0
    let k: u32 = color.read_color(pool, a, n, &c, &va2, &vn2)
    *art = k
    *col = c
    *va = va2
    *vn = vn2
}

// `stroke-dasharray`. The values are lengths, separated by comma or whitespace.
// A NEGATIVE value makes the whole statement invalid (SVG 1.1,
// 11.4) -- then it is painted solid, not "as well as possible".
#[no_gc]
fn read_strokes(z: *mut State, pool: u64, a: usize, n: usize) {
    var i: usize = a
    let end: usize = a + n
    (*z).n_strokes = 0
    matrix.skip_empty(pool, end, &i)
    // `none` schaltet ab.
    if i < end && matrix.read_byte(pool, i) == 110 {
        return
    }
    while i < end && (*z).n_strokes < 32 {
        var ok: bool = false
        var v: f64 = matrix.number(pool, end, &i, &ok)
        if !ok {
            break
        }
        // The unit stands directly behind the number.
        if i < end {
            let c0: u32 = matrix.read_byte(pool, i)
            if c0 == 37 {
                v = v * (*z).vw / 100.0
                i = i + 1
            } else if i + 1 < end {
                let c1: u32 = matrix.read_byte(pool, i + 1)
                if c0 == 112 && c1 == 116 {
                    v = v * 4.0 / 3.0
                    i = i + 2
                } else if c0 == 101 && c1 == 109 {
                    v = v * (*z).size
                    i = i + 2
                } else if c0 == 112 && c1 == 120 {
                    i = i + 2
                }
            }
        }
        if v < 0.0 {
            (*z).n_strokes = 0
            return
        }
        (*z).strokes[(*z).n_strokes] = v
        (*z).n_strokes = (*z).n_strokes + 1
        matrix.skip_sep(pool, end, &i)
    }
}

#[no_gc]
fn word_is(pool: u64, a: usize, n: usize, w: u64, wn: usize) -> bool {
    if n != wn {
        return false
    }
    var i: usize = 0
    while i < n {
        if matrix.read_byte(pool, a + i) != matrix.read_byte(w, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// The own opacity of ONE element, without the inherited.
#[no_gc]
fn elem_coverage(b: *mut svgxml.Tree, i: u32) -> f64 {
    var a: usize = 0
    var n: usize = 0
    var wop: [u8; 7] = "opacity"
    if !get_value(b, i, (&wop[0]) as u64, 7, &a, &n) {
        return 1.0
    }
    var ok: bool = false
    let v: f64 = color.read_coverage(svgxml.tree_pool(b), a, n, &ok)
    if !ok {
        return 1.0
    }
    return v
}

#[no_gc]
fn state_apply(b: *mut svgxml.Tree, i: u32, z: *mut State) {
    let pool: u64 = svgxml.tree_pool(b)
    var a: usize = 0
    var n: usize = 0
    var wcolor: [u8; 5] = "color"
    if get_value(b, i, (&wcolor[0]) as u64, 5, &a, &n) {
        var c: u32 = 0
        var va: usize = 0
        var vn: usize = 0
        if color.read_color(pool, a, n, &c, &va, &vn) == color.F_COLOR {
            (*z).aktuell = c
        }
    }
    var wfs: [u8; 9] = "font-size"
    if get_value(b, i, (&wfs[0]) as u64, 9, &a, &n) {
        var ok: bool = false
        let v: f64 = length_of(pool, a, n, (*z).size, (*z).size, &ok)
        if ok && v > 0.0 {
            (*z).size = v
        }
    }
    var wfill: [u8; 4] = "fill"
    if get_value(b, i, (&wfill[0]) as u64, 4, &a, &n) {
        set_paintsite(pool, a, n, &(*z).f_art, &(*z).f_col, &(*z).f_va,
            &(*z).f_vn)
    }
    var wstroke: [u8; 6] = "stroke"
    if get_value(b, i, (&wstroke[0]) as u64, 6, &a, &n) {
        set_paintsite(pool, a, n, &(*z).s_art, &(*z).s_col, &(*z).s_va,
            &(*z).s_vn)
    }
    var wsw: [u8; 12] = "stroke-width"
    if get_value(b, i, (&wsw[0]) as u64, 12, &a, &n) {
        var ok: bool = false
        let v: f64 = length_of(pool, a, n, diagonale((*z).vw, (*z).vh),
            (*z).size, &ok)
        if ok && v >= 0.0 {
            (*z).width = v
        }
    }
    var wlc: [u8; 14] = "stroke-linecap"
    if get_value(b, i, (&wlc[0]) as u64, 14, &a, &n) {
        var wr: [u8; 5] = "round"
        var wq: [u8; 6] = "square"
        if word_is(pool, a, n, (&wr[0]) as u64, 5) {
            (*z).cap = dash.K_ROUND
        } else if word_is(pool, a, n, (&wq[0]) as u64, 6) {
            (*z).cap = dash.K_ECKIG
        } else {
            (*z).cap = dash.K_STUMPF
        }
    }
    var wlj: [u8; 15] = "stroke-linejoin"
    if get_value(b, i, (&wlj[0]) as u64, 15, &a, &n) {
        var wr: [u8; 5] = "round"
        var wb: [u8; 5] = "bevel"
        if word_is(pool, a, n, (&wr[0]) as u64, 5) {
            (*z).stoss = dash.S_ROUND
        } else if word_is(pool, a, n, (&wb[0]) as u64, 5) {
            (*z).stoss = dash.S_ABGE
        } else {
            (*z).stoss = dash.S_GEHRUNG
        }
    }
    var wml: [u8; 17] = "stroke-miterlimit"
    if get_value(b, i, (&wml[0]) as u64, 17, &a, &n) {
        var ok: bool = false
        var j: usize = a
        let v: f64 = matrix.number(pool, a + n, &j, &ok)
        if ok && v >= 1.0 {
            (*z).gehrung = v
        }
    }
    var wda: [u8; 18] = "stroke-dasharray  "
    if get_value(b, i, (&wda[0]) as u64, 16, &a, &n) {
        read_strokes(z, pool, a, n)
    }
    var wdo: [u8; 19] = "stroke-dashoffset  "
    if get_value(b, i, (&wdo[0]) as u64, 17, &a, &n) {
        var ok: bool = false
        let v: f64 = length_of(pool, a, n, (*z).vw, (*z).size, &ok)
        if ok {
            (*z).offset = v
        }
    }
    var wfr: [u8; 9] = "fill-rule"
    if get_value(b, i, (&wfr[0]) as u64, 9, &a, &n) {
        var we: [u8; 7] = "evenodd"
        if word_is(pool, a, n, (&we[0]) as u64, 7) {
            (*z).rule = RULE_EVEN
        } else {
            (*z).rule = RULE_NONZERO
        }
    }
    var wfo: [u8; 12] = "fill-opacity"
    if get_value(b, i, (&wfo[0]) as u64, 12, &a, &n) {
        var ok: bool = false
        (*z).f_deck = color.read_coverage(pool, a, n, &ok)
    }
    var wso: [u8; 14] = "stroke-opacity"
    if get_value(b, i, (&wso[0]) as u64, 14, &a, &n) {
        var ok: bool = false
        (*z).s_deck = color.read_coverage(pool, a, n, &ok)
    }
    // `opacity` does NOT stand here. For a shape it is a factor on
    // the colour, for a group a layer of its own -- the
    // distinction is made by `zeichne`, not by this function.
    var wta: [u8; 11] = "text-anchor"
    if get_value(b, i, (&wta[0]) as u64, 11, &a, &n) {
        var wm: [u8; 6] = "middle"
        var we2: [u8; 3] = "end"
        if word_is(pool, a, n, (&wm[0]) as u64, 6) {
            (*z).anchor = ANCHOR_MID
        } else if word_is(pool, a, n, (&we2[0]) as u64, 3) {
            (*z).anchor = ANCHOR_END
        } else {
            (*z).anchor = ANCHOR_START
        }
    }
    var wtr: [u8; 9] = "transform"
    if svgxml.attr_value(b, i, (&wtr[0]) as u64, 9, &a, &n) {
        (*z).m = matrix.mat_mal((*z).m,
            matrix.split_transform(pool + a as u64, n))
    }
}

// --------------------------------------------- viewBox and preserveAspectRatio
//
// The most frequent source of error at all with SVG symbols. `viewBox`
// says which section of the user system appears in the viewport;
// `preserveAspectRatio` says what happens if the two aspect
// ratios do not fit together.
//
// The encoding of `ausricht`: 0 means `none` (distorting allowed),
// otherwise `1 + 3*xi + yi` with xi, yi from {0 = Min, 1 = Mid, 2 = Max}.

#[no_gc]
fn read_par(pool: u64, a: usize, n: usize, align: *mut u32,
    art: *mut u32) {
    *align = 1 + 3 * 1 + 1 // xMidYMid
    *art = PAR_MEET
    var i: usize = a
    let end: usize = a + n
    matrix.skip_empty(pool, end, &i)
    // A leading `defer` is overlooked.
    if i + 5 <= end && matrix.read_byte(pool, i) == 100 {
        while i < end && !matrix.is_empty(matrix.read_byte(pool, i)) {
            i = i + 1
        }
        matrix.skip_empty(pool, end, &i)
    }
    if i >= end {
        return
    }
    if matrix.read_byte(pool, i) == 110 {
        *align = 0
        i = i + 4
    } else if i + 8 <= end && matrix.read_byte(pool, i) == 120 {
        // xMinYMax: characters 1..3 are the x part, 5..7 the y part.
        var xi: u32 = 1
        var yi: u32 = 1
        let x2: u32 = matrix.read_byte(pool, i + 3)
        if x2 == 110 {
            xi = 0
        } else if x2 == 120 {
            xi = 2
        }
        let y2: u32 = matrix.read_byte(pool, i + 7)
        if y2 == 110 {
            yi = 0
        } else if y2 == 120 {
            yi = 2
        }
        *align = 1 + 3 * xi + yi
        i = i + 8
    }
    matrix.skip_empty(pool, end, &i)
    if i < end && matrix.read_byte(pool, i) == 115 {
        *art = PAR_SLICE
    }
}

// The matrix that lays the `viewBox` section into the viewport.
#[no_gc]
fn view_matrix(vx: f64, vy: f64, vw: f64, vh: f64, ex: f64, ey: f64,
    ew: f64, eh: f64, align: u32, art: u32) -> matrix.Mat {
    if vw <= 0.0 || vh <= 0.0 {
        return matrix.mat_verschiebe(ex, ey)
    }
    var sx: f64 = ew / vw
    var sy: f64 = eh / vh
    if align != 0 {
        if art == PAR_SLICE {
            if sy > sx {
                sx = sy
            } else {
                sy = sx
            }
        } else {
            if sy < sx {
                sx = sy
            } else {
                sy = sx
            }
        }
    }
    var tx: f64 = ex - vx * sx
    var ty: f64 = ey - vy * sy
    if align != 0 {
        let a: u32 = align - 1
        let xi: u32 = a / 3
        let yi: u32 = a % 3
        if xi == 1 {
            tx = tx + (ew - vw * sx) / 2.0
        } else if xi == 2 {
            tx = tx + (ew - vw * sx)
        }
        if yi == 1 {
            ty = ty + (eh - vh * sy) / 2.0
        } else if yi == 2 {
            ty = ty + (eh - vh * sy)
        }
    }
    return matrix.mat_of_six(sx, 0.0, 0.0, sy, tx, ty)
}

// The four numbers of a `viewBox`.
#[no_gc]
fn read_viewbox(pool: u64, a: usize, n: usize, v: *mut f64) -> bool {
    var i: usize = a
    let end: usize = a + n
    var k: usize = 0
    while k < 4 {
        matrix.skip_sep(pool, end, &i)
        var ok: bool = false
        let x: f64 = matrix.number(pool, end, &i, &ok)
        if !ok {
            return false
        }
        *((v as u64 + (k * 8) as u64) as *mut f64) = x
        k = k + 1
    }
    return true
}

// ---------------------------------------------------------- The shapes
//
// Every basic shape becomes a path. The rules for degenerate values
// stand in SVG 1.1, 9.2 to 9.7 and are written out here, because they are
// not all the same: a `rect` with `width="0"` is NOT painted,
// a `line` with equal start and end is (it can have a round cap),
// and a `circle` with `r="0"` again not.

#[no_gc]
fn form_rect(m: *mut Painter, b: *mut svgxml.Tree, i: u32, z: *mut State) {
    var wx: [u8; 1] = "x"
    var wy: [u8; 1] = "y"
    var ww: [u8; 5] = "width"
    var wh: [u8; 6] = "height"
    var wrx: [u8; 2] = "rx"
    var wry: [u8; 2] = "ry"
    let x: f64 = attr_length(b, i, (&wx[0]) as u64, 1, (*z).vw, z, 0.0)
    let y: f64 = attr_length(b, i, (&wy[0]) as u64, 1, (*z).vh, z, 0.0)
    let w: f64 = attr_length(b, i, (&ww[0]) as u64, 5, (*z).vw, z, 0.0)
    let h: f64 = attr_length(b, i, (&wh[0]) as u64, 6, (*z).vh, z, 0.0)
    if w <= 0.0 || h <= 0.0 {
        return
    }
    // If only one of `rx`/`ry` stands, it applies for both.
    var rx: f64 = attr_length(b, i, (&wrx[0]) as u64, 2, (*z).vw, z, 0.0 - 1.0)
    var ry: f64 = attr_length(b, i, (&wry[0]) as u64, 2, (*z).vh, z, 0.0 - 1.0)
    if rx < 0.0 && ry < 0.0 {
        rx = 0.0
        ry = 0.0
    } else if rx < 0.0 {
        rx = ry
    } else if ry < 0.0 {
        ry = rx
    }
    path.path_round_rect(&(*m).p1, x, y, w, h, rx, ry)
}

#[no_gc]
fn form_circle(m: *mut Painter, b: *mut svgxml.Tree, i: u32, z: *mut State) {
    var wcx: [u8; 2] = "cx"
    var wcy: [u8; 2] = "cy"
    var wr: [u8; 1] = "r"
    let cx: f64 = attr_length(b, i, (&wcx[0]) as u64, 2, (*z).vw, z, 0.0)
    let cy: f64 = attr_length(b, i, (&wcy[0]) as u64, 2, (*z).vh, z, 0.0)
    let r: f64 = attr_length(b, i, (&wr[0]) as u64, 1,
        diagonale((*z).vw, (*z).vh), z, 0.0)
    if r <= 0.0 {
        return
    }
    path.path_circle(&(*m).p1, cx, cy, r)
}

#[no_gc]
fn form_ellipse(m: *mut Painter, b: *mut svgxml.Tree, i: u32, z: *mut State) {
    var wcx: [u8; 2] = "cx"
    var wcy: [u8; 2] = "cy"
    var wrx: [u8; 2] = "rx"
    var wry: [u8; 2] = "ry"
    let cx: f64 = attr_length(b, i, (&wcx[0]) as u64, 2, (*z).vw, z, 0.0)
    let cy: f64 = attr_length(b, i, (&wcy[0]) as u64, 2, (*z).vh, z, 0.0)
    var rx: f64 = attr_length(b, i, (&wrx[0]) as u64, 2, (*z).vw, z,
        0.0 - 1.0)
    var ry: f64 = attr_length(b, i, (&wry[0]) as u64, 2, (*z).vh, z,
        0.0 - 1.0)
    // `auto` or missing: the other radius applies (SVG 2); if both are missing,
    // nothing is painted.
    if rx < 0.0 && ry < 0.0 {
        return
    }
    if rx < 0.0 {
        rx = ry
    }
    if ry < 0.0 {
        ry = rx
    }
    if rx <= 0.0 || ry <= 0.0 {
        return
    }
    path.path_ellipse(&(*m).p1, cx, cy, rx, ry)
}

#[no_gc]
fn form_line(m: *mut Painter, b: *mut svgxml.Tree, i: u32, z: *mut State) {
    var w1: [u8; 2] = "x1"
    var w2: [u8; 2] = "y1"
    var w3: [u8; 2] = "x2"
    var w4: [u8; 2] = "y2"
    let x1: f64 = attr_length(b, i, (&w1[0]) as u64, 2, (*z).vw, z, 0.0)
    let y1: f64 = attr_length(b, i, (&w2[0]) as u64, 2, (*z).vh, z, 0.0)
    let x2: f64 = attr_length(b, i, (&w3[0]) as u64, 2, (*z).vw, z, 0.0)
    let y2: f64 = attr_length(b, i, (&w4[0]) as u64, 2, (*z).vh, z, 0.0)
    path.path_move(&(*m).p1, x1, y1)
    path.path_line(&(*m).p1, x2, y2)
}

#[no_gc]
fn form_poly(m: *mut Painter, b: *mut svgxml.Tree, i: u32, zu: bool) {
    var wp: [u8; 6] = "points"
    var a: usize = 0
    var n: usize = 0
    if !svgxml.attr_value(b, i, (&wp[0]) as u64, 6, &a, &n) {
        return
    }
    let pool: u64 = svgxml.tree_pool(b)
    let ok: bool = path.split_points(&(*m).p1, pool + a as u64, n, zu)
}

#[no_gc]
fn form_path(m: *mut Painter, b: *mut svgxml.Tree, i: u32) {
    var wd: [u8; 1] = "d"
    var a: usize = 0
    var n: usize = 0
    if !get_value(b, i, (&wd[0]) as u64, 1, &a, &n) {
        return
    }
    let pool: u64 = svgxml.tree_pool(b)
    let ok: bool = path.split_d(&(*m).p1, pool + a as u64, n)
}

// ------------------------------------------------------------- The text
//
// What is built: `text` and `tspan`, `x`/`y`/`dx`/`dy` as a SINGLE VALUE
// (not as a list per character), `text-anchor`, `font-size`, fill and
// stroke as with every other shape. What is NOT built and stands in
// docs/ROUNDGRAFIK.md: `textPath`, `textLength`, lists of
// coordinates per character, `rotate`.

#[no_gc]
fn utf8_next(p: u64, n: usize, i: *mut usize) -> u32 {
    if *i >= n {
        return 0
    }
    let c: u32 = matrix.read_byte(p, *i)
    if c < 128 {
        *i = *i + 1
        return c
    }
    if c >= 240 && *i + 3 < n {
        let v: u32 = ((c & 7) << 18)
        | ((matrix.read_byte(p, *i + 1) & 63) << 12)
        | ((matrix.read_byte(p, *i + 2) & 63) << 6)
        | (matrix.read_byte(p, *i + 3) & 63)
        *i = *i + 4
        return v
    }
    if c >= 224 && *i + 2 < n {
        let v: u32 = ((c & 15) << 12)
        | ((matrix.read_byte(p, *i + 1) & 63) << 6)
        | (matrix.read_byte(p, *i + 2) & 63)
        *i = *i + 3
        return v
    }
    if c >= 192 && *i + 1 < n {
        let v: u32 = ((c & 31) << 6)
        | (matrix.read_byte(p, *i + 1) & 63)
        *i = *i + 2
        return v
    }
    *i = *i + 1
    return 65533
}

// The advance of a string. Without a font it is zero -- then
// nothing is painted either, and that is visible, not silently wrong.
#[no_gc]
fn text_width(m: *mut Painter, p: u64, a: usize, n: usize, size: f64)
-> f64 {
    if (*m).fm == 0 {
        return 0.0
    }
    var req: fontsel.FontReq = fontsel.req_new()
    var i: usize = a
    let end: usize = a + n
    var br: f64 = 0.0
    var before: u32 = 0
    while i < end {
        let cp: u32 = utf8_next(p, end, &i)
        if cp == 0 {
            break
        }
        br = br + fontsel.fm_advance((*m).fm, &req, size, cp)
        before = cp
    }
    return br
}

// The total width of a `text` element together with all `tspan`.
#[no_gc]
fn text_width_tree(m: *mut Painter, b: *mut svgxml.Tree, e: u32, size: f64,
    depth: usize) -> f64 {
    if depth > 8 {
        return 0.0
    }
    var br: f64 = 0.0
    let pool: u64 = svgxml.tree_pool(b)
    var k: u32 = svgxml.node_kind(b, e)
    while k != svgxml.KEINER {
        if svgxml.node_type(b, k) == svgxml.K_TEXT {
            br = br + text_width(m, pool, svgxml.node_text_a(b, k),
                svgxml.node_text_n(b, k), size)
        } else if name_hash(b, k) == N_TSPAN {
            br = br + text_width_tree(m, b, k, size, depth + 1)
        }
        k = svgxml.node_next(b, k)
    }
    return br
}

// Paint a piece of text at the pen.
#[no_gc]
fn times_run(m: *mut Painter, b: *mut svgxml.Tree, p: u64, a: usize, n: usize,
    z: *mut State, feder: *mut f64, gy: f64) {
    if (*m).fm == 0 || n == 0 {
        return
    }
    if (*z).f_art == color.F_NO && (*z).s_art == color.F_NO {
        // Advance nevertheless, otherwise the position of the next
        // piece is not right.
        *feder = *feder + text_width(m, p, a, n, (*z).size)
        return
    }
    var req: fontsel.FontReq = fontsel.req_new()
    let size: f64 = (*z).size
    let asc: f64 = fontsel.fm_ascent((*m).fm, &req, size)
    let desc: f64 = fontsel.fm_descent((*m).fm, &req, size)
    let br: f64 = text_width(m, p, a, n, size)
    // The window: the baseline plus ascent and descent, sent through
    // the matrix. All four corners, because the matrix may rotate.
    let ux0: f64 = *feder - size
    let uy0: f64 = gy - asc - size * 0.3
    let ux1: f64 = *feder + br + size
    let uy1: f64 = gy + desc + size * 0.3
    var bx0: f64 = 1.0e300
    var by0: f64 = 1.0e300
    var bx1: f64 = 0.0 - 1.0e300
    var by1: f64 = 0.0 - 1.0e300
    var e: usize = 0
    while e < 4 {
        var px: f64 = ux0
        var py: f64 = uy0
        if e == 1 {
            px = ux1
        }
        if e == 2 {
            py = uy1
        }
        if e == 3 {
            px = ux1
            py = uy1
        }
        let sx: f64 = matrix.mat_x((*z).m, px, py)
        let sy: f64 = matrix.mat_y((*z).m, px, py)
        if sx < bx0 {
            bx0 = sx
        }
        if sy < by0 {
            by0 = sy
        }
        if sx > bx1 {
            bx1 = sx
        }
        if sy > by1 {
            by1 = sy
        }
        e = e + 1
    }
    var wx: i64 = 0
    var wy: i64 = 0
    var w: usize = 0
    var h: usize = 0
    if !window(m, bx0, by0, bx1, by1, &wx, &wy, &w, &h) {
        *feder = *feder + br
        return
    }
    if !raster.raster_begin(&(*m).ra, wx as f64, wy as f64, w, h) {
        *feder = *feder + br
        return
    }
    // The outlines are drawn with the LINEAR part of the matrix,
    // conjugated with the y mirroring: the y axis of a font points up,
    // that of the page down. Without the conjugation the
    // letters would stand the wrong way round under a rotation -- the same calculation as
    // in lib/paint/painter.fi.
    let g00: f64 = (*z).m.a
    let g01: f64 = 0.0 - (*z).m.b
    let g10: f64 = 0.0 - (*z).m.c
    let g11: f64 = (*z).m.d
    var i: usize = a
    let end: usize = a + n
    var before: u32 = 0
    var before_face: u32 = fontsel.PICK_NONE
    while i < end {
        let cp: u32 = utf8_next(p, end, &i)
        if cp == 0 {
            break
        }
        let pick: u32 = fontsel.fm_pick((*m).fm, &req, cp)
        let f: *mut ttf.Font = fontsel.fm_face_of((*m).fm, pick)
        let up: f64 = ttf.font_upem(f) as f64
        let scale: f64 = size / up
        let gid: u32 = ttf.font_glyph_for(f, cp)
        if before != 0 as u32 && (pick & 65535 as u32) == before_face {
            *feder = *feder + (ttf.font_kern(f, before, gid) as f64) * scale
        }
        let px: f64 = matrix.mat_x((*z).m, *feder, gy)
        let py: f64 = matrix.mat_y((*z).m, *feder, gy)
        let okg: bool = ttf.font_outline_m(f, gid, &(*m).ra, px, py, scale,
            g00, g01, g10, g11, (*m).scratch, GLYPH_SCRATCH, 0)
        *feder = *feder + (ttf.font_advance(f, gid) as f64) * scale
        before = gid
        before_face = pick & 65535 as u32
    }
    raster.raster_finish(&(*m).ra)
    var col: u32 = (*z).f_col
    if (*z).f_art == color.F_AKTUELL {
        col = (*z).aktuell
    }
    var vl: Gradient = gradient_new()
    giesse(m, wx, wy, w, h, with_coverage(col, (*z).f_deck * (*z).deck), &vl,
        false, matrix.mat_one())
}

// A `text` or `tspan` together with children.
#[no_gc]
fn times_text_tree(m: *mut Painter, b: *mut svgxml.Tree, e: u32, z_in: State,
    feder: *mut f64, gy_in: f64, depth: usize) {
    if depth > 8 {
        return
    }
    var z: State = z_in
    state_apply(b, e, &z)
    var gy: f64 = gy_in
    var wx: [u8; 1] = "x"
    var wy: [u8; 1] = "y"
    var wdx: [u8; 2] = "dx"
    var wdy: [u8; 2] = "dy"
    var a: usize = 0
    var n: usize = 0
    if svgxml.attr_value(b, e, (&wx[0]) as u64, 1, &a, &n) {
        *feder = attr_length(b, e, (&wx[0]) as u64, 1, z.vw, &z, *feder)
    }
    if svgxml.attr_value(b, e, (&wy[0]) as u64, 1, &a, &n) {
        gy = attr_length(b, e, (&wy[0]) as u64, 1, z.vh, &z, gy)
    }
    *feder = *feder + attr_length(b, e, (&wdx[0]) as u64, 2, z.vw, &z, 0.0)
    gy = gy + attr_length(b, e, (&wdy[0]) as u64, 2, z.vh, &z, 0.0)
    let pool: u64 = svgxml.tree_pool(b)
    var k: u32 = svgxml.node_kind(b, e)
    while k != svgxml.KEINER {
        if svgxml.node_type(b, k) == svgxml.K_TEXT {
            times_run(m, b, pool, svgxml.node_text_a(b, k),
                svgxml.node_text_n(b, k), &z, feder, gy)
        } else if name_hash(b, k) == N_TSPAN {
            times_text_tree(m, b, k, z, feder, gy, depth + 1)
        }
        k = svgxml.node_next(b, k)
    }
}

#[no_gc]
fn times_text(m: *mut Painter, b: *mut svgxml.Tree, e: u32, z: *mut State) {
    if (*m).fm == 0 {
        return
    }
    var wx: [u8; 1] = "x"
    var wy: [u8; 1] = "y"
    var x: f64 = attr_length(b, e, (&wx[0]) as u64, 1, (*z).vw, z, 0.0)
    let y: f64 = attr_length(b, e, (&wy[0]) as u64, 1, (*z).vh, z, 0.0)
    if (*z).anchor != ANCHOR_START {
        let br: f64 = text_width_tree(m, b, e, (*z).size, 0)
        if (*z).anchor == ANCHOR_MID {
            x = x - br / 2.0
        } else {
            x = x - br
        }
    }
    var feder: f64 = x
    // The state is already applied; `male_text_baum` applies it
    // again, which gives the same result for the same element.
    times_text_tree(m, b, e, *z, &feder, y, 0)
}

// ---------------------------------------------------------- The traversal

// Is `moeglicher` an ancestor of `i`? A `use` whose target is its
// own ancestor is, by SVG 1.1, 5.6, an ERROR -- the `use`
// is then not drawn at all, not even once.
// Without this check a version that only limits the depth paints the
// target once (or 24 times), and that looks on the page like an
// error in the picture instead of like an error in the file. Exactly that was the
// first measured value of this round: 8.04 % deviation against Chromium on
// tests/grafik/aufbau/use_schleife.svg.
#[no_gc]
fn is_ancestor(b: *mut svgxml.Tree, possible: u32, i: u32) -> bool {
    var k: u32 = i
    var wach: usize = 0
    while k != svgxml.KEINER && wach < 4096 {
        if k == possible {
            return true
        }
        k = svgxml.node_parent(b, k)
        wach = wach + 1
    }
    return false
}

#[no_gc]
fn already_used(m: *mut Painter, e: u32) -> bool {
    var i: usize = 0
    while i < (*m).n_used {
        if (*m).used[i] == e {
            return true
        }
        i = i + 1
    }
    return false
}

#[no_gc]
fn draw_children(m: *mut Painter, b: *mut svgxml.Tree, e: u32, z: State,
    depth: usize) {
    var k: u32 = svgxml.node_kind(b, e)
    while k != svgxml.KEINER {
        draw(m, b, k, z, depth + 1)
        k = svgxml.node_next(b, k)
    }
}

// An `svg` or a `symbol` as a VIEWPORT. `ex`/`ey`/`ew`/`eh`
// is the window in the coordinates of the parent.
#[no_gc]
fn draw_view(m: *mut Painter, b: *mut svgxml.Tree, e: u32, z_in: State,
    ex: f64, ey: f64, ew: f64, eh: f64, replacement_w: f64, replacement_h: f64,
    depth: usize) {
    var z: State = z_in
    if ew <= 0.0 || eh <= 0.0 {
        return
    }
    let pool: u64 = svgxml.tree_pool(b)
    var a: usize = 0
    var n: usize = 0
    var wvb: [u8; 7] = "viewBox"
    var wpar: [u8; 19] = "preserveAspectRatio"
    var vb: [f64; 4] = [0.0; 4]
    var hat_vb: bool = false
    if svgxml.attr_value(b, e, (&wvb[0]) as u64, 7, &a, &n) {
        hat_vb = read_viewbox(pool, a, n, &vb[0])
    }
    // SUBSTITUTE viewBox FOR THE ROOT.
    //
    // A `<svg width="50" height="50">` WITHOUT `viewBox` has an
    // intrinsic size of 50x50, and a browser that lays it as an image into a
    // 200x200 box SCALES it to 200x200. Whoever here only
    // shifts paints it small into the corner. Exactly that happened with three
    // of four real Wikipedia symbols (49 %, 61 % and 26 %
    // deviation against Chromium; afterwards 0.4 %, 0.6 % and 0.5 %).
    //
    // For a NESTED `svg` this does NOT apply: there the
    // coordinate system of the child is that of the parent, and without
    // `viewBox` things are really only shifted. That is why the substitute box
    // does not stand fixed here, but comes from outside -- only `male_baum` passes
    // it along.
    var replacement: bool = false
    if !hat_vb && replacement_w > 0.0 && replacement_h > 0.0 {
        vb[0] = 0.0
        vb[1] = 0.0
        vb[2] = replacement_w
        vb[3] = replacement_h
        hat_vb = true
        replacement = true
    }
    var align: u32 = 5
    var art: u32 = PAR_MEET
    if svgxml.attr_value(b, e, (&wpar[0]) as u64, 19, &a, &n) {
        read_par(pool, a, n, &align, &art)
    }
    // The substitute box is STRETCHED, not fitted. The reason stands in
    // the image scaling, not in SVG: an `<img>` with width
    // AND height set pulls its picture to exactly this size, and an SVG without
    // `viewBox` is at this place an image of its intrinsic size. With
    // fitting it would stand with a margin in the middle -- measured against Chromium
    // 28.85 % deviation with a non-square frame,
    // with stretching 0.60 %.
    if replacement {
        align = 0
    }
    // The viewport CLIPS. `overflow: hidden` is the
    // default value for `svg` and `symbol`; without the clip a
    // symbol with `slice` runs out over its frame.
    let cx0: f64 = matrix.mat_x(z.m, ex, ey)
    let cy0: f64 = matrix.mat_y(z.m, ex, ey)
    let cx1: f64 = matrix.mat_x(z.m, ex + ew, ey + eh)
    let cy1: f64 = matrix.mat_y(z.m, ex + ew, ey + eh)
    var kx0: f64 = cx0
    var ky0: f64 = cy0
    var kx1: f64 = cx1
    var ky1: f64 = cy1
    if kx1 < kx0 {
        kx0 = cx1
        kx1 = cx0
    }
    if ky1 < ky0 {
        ky0 = cy1
        ky1 = cy0
    }
    // Only with an axis-parallel matrix is a rectangular clip
    // right; with a rotation it would be too large. Too large means: too much
    // is shown, not too little -- that is the more harmless
    // side, and it is named here.
    let clipped: bool = canvas.clip_push_rect((*m).cv, kx0, ky0, kx1, ky1)
    if hat_vb {
        z.m = matrix.mat_mal(z.m, view_matrix(vb[0], vb[1], vb[2], vb[3],
                ex, ey, ew, eh, align, art))
        z.vw = vb[2]
        z.vh = vb[3]
    } else {
        z.m = matrix.mat_mal(z.m, matrix.mat_verschiebe(ex, ey))
        z.vw = ew
        z.vh = eh
    }
    draw_children(m, b, e, z, depth)
    if clipped {
        canvas.clip_pop((*m).cv)
    }
}

// A NODE. Here only WHETHER and HOW is decided -- painting is done in
// `zeichne_kern`.
#[no_gc]
fn draw(m: *mut Painter, b: *mut svgxml.Tree, i: u32, z_in: State,
    depth: usize) {
    if depth > DEPTH_MAX {
        return
    }
    if svgxml.node_type(b, i) != svgxml.K_ELEM {
        return
    }
    let h: u32 = name_hash(b, i)
    // What is NOT painted: storage containers and descriptions.
    if h == N_DEFS || h == N_SYMBOL || h == N_TITLE || h == N_DESC
    || h == N_STYLE || h == N_METADATA || h == N_SCRIPT
    || h == N_LINGRAD || h == N_RADGRAD || h == N_CLIPPATH
    || h == N_MASK || h == N_FILTER || h == N_PATTERN || h == N_MARKER {
        return
    }
    // `display: none` switches off the whole subtree.
    var wdis: [u8; 7] = "display"
    var da: usize = 0
    var dn: usize = 0
    if get_value(b, i, (&wdis[0]) as u64, 7, &da, &dn) {
        var wnone: [u8; 4] = "none"
        if word_is(svgxml.tree_pool(b), da, dn, (&wnone[0]) as u64, 4) {
            return
        }
    }
    let own: f64 = elem_coverage(b, i)
    let behaelter: bool = h == N_G || h == N_A || h == N_SVG || h == N_USE
    || h == N_SWITCH
    if behaelter && own < 1.0 {
        var z2: State = z_in
        let geerbt: f64 = z2.deck
        z2.deck = 1.0
        if layer_on(m) {
            draw_core(m, b, i, z2, depth)
            layer_ab(m, own * geerbt)
            return
        }
        // No layer free any more -- then multiplying through is done. That
        // is the approximation, and it stands in the report.
    }
    var z3: State = z_in
    z3.deck = z3.deck * own
    draw_core(m, b, i, z3, depth)
}

// A NODE, really painted.
#[no_gc]
fn draw_core(m: *mut Painter, b: *mut svgxml.Tree, i: u32, z_in: State,
    depth: usize) {
    let h: u32 = name_hash(b, i)
    var a: usize = 0
    var n: usize = 0
    var z: State = z_in
    let pool: u64 = svgxml.tree_pool(b)
    if h == N_SVG {
        // A nested `svg`. The outer root is not treated here,
        // but in `male_baum`.
        var wx: [u8; 1] = "x"
        var wy: [u8; 1] = "y"
        var ww: [u8; 5] = "width"
        var wh: [u8; 6] = "height"
        state_apply(b, i, &z)
        let ex: f64 = attr_length(b, i, (&wx[0]) as u64, 1, z.vw, &z, 0.0)
        let ey: f64 = attr_length(b, i, (&wy[0]) as u64, 1, z.vh, &z, 0.0)
        let ew: f64 = attr_length(b, i, (&ww[0]) as u64, 5, z.vw, &z, z.vw)
        let eh: f64 = attr_length(b, i, (&wh[0]) as u64, 6, z.vh, &z, z.vh)
        draw_view(m, b, i, z, ex, ey, ew, eh, 0.0, 0.0, depth)
        return
    }
    if h == N_USE {
        state_apply(b, i, &z)
        var whref: [u8; 4] = "href"
        var ha: usize = 0
        var hn: usize = 0
        if !svgxml.attr_value(b, i, (&whref[0]) as u64, 4, &ha, &hn) {
            return
        }
        if hn < 2 || matrix.read_byte(pool, ha) != 35 {
            return
        }
        let target: u32 = find_id(b, pool, ha + 1, hn - 1)
        if target == svgxml.KEINER || target == i {
            return
        }
        // THE LOOP LOCK, twofold: the target may neither be an
        // ancestor of this `use` nor already stand further up in the
        // chain.
        if is_ancestor(b, target, i) {
            return
        }
        if already_used(m, target) || (*m).n_used >= 24 {
            return
        }
        var wx: [u8; 1] = "x"
        var wy: [u8; 1] = "y"
        var ww: [u8; 5] = "width"
        var wh: [u8; 6] = "height"
        let ux: f64 = attr_length(b, i, (&wx[0]) as u64, 1, z.vw, &z, 0.0)
        let uy: f64 = attr_length(b, i, (&wy[0]) as u64, 1, z.vh, &z, 0.0)
        z.m = matrix.mat_mal(z.m, matrix.mat_verschiebe(ux, uy))
        (*m).used[(*m).n_used] = target
        (*m).n_used = (*m).n_used + 1
        let zh: u32 = name_hash(b, target)
        if zh == N_SYMBOL || zh == N_SVG {
            // A `symbol` gets its window from the `use`: its
            // `width`/`height`, otherwise 100 %.
            var z2: State = z
            state_apply(b, target, &z2)
            var ew: f64 = attr_length(b, i, (&ww[0]) as u64, 5, z.vw, &z, z.vw)
            var eh: f64 = attr_length(b, i, (&wh[0]) as u64, 6, z.vh, &z, z.vh)
            if zh == N_SVG {
                ew = attr_length(b, target, (&ww[0]) as u64, 5, z.vw, &z, ew)
                eh = attr_length(b, target, (&wh[0]) as u64, 6, z.vh, &z, eh)
            }
            draw_view(m, b, target, z2, 0.0, 0.0, ew, eh, 0.0, 0.0,
                depth + 1)
        } else {
            draw(m, b, target, z, depth + 1)
        }
        (*m).n_used = (*m).n_used - 1
        return
    }
    state_apply(b, i, &z)
    if h == N_G || h == N_A {
        draw_children(m, b, i, z, depth)
        return
    }
    if h == N_SWITCH {
        // `switch` paints the FIRST child whose conditions are fulfilled.
        // Conditions (`requiredFeatures`, `systemLanguage`) do not exist here;
        // so the first child that is paintable at all applies.
        var k: u32 = svgxml.node_kind(b, i)
        while k != svgxml.KEINER {
            if svgxml.node_type(b, k) == svgxml.K_ELEM {
                draw(m, b, k, z, depth + 1)
                return
            }
            k = svgxml.node_next(b, k)
        }
        return
    }
    if h == N_TEXT {
        times_text(m, b, i, &z)
        return
    }
    // From here on: a shape.
    path.path_empty(&(*m).p1)
    if h == N_PATH {
        form_path(m, b, i)
    } else if h == N_RECT {
        form_rect(m, b, i, &z)
    } else if h == N_CIRCLE {
        form_circle(m, b, i, &z)
    } else if h == N_ELLIPSE {
        form_ellipse(m, b, i, &z)
    } else if h == N_LINE {
        form_line(m, b, i, &z)
    } else if h == N_POLYLINE {
        form_poly(m, b, i, false)
    } else if h == N_POLYGON {
        form_poly(m, b, i, true)
    } else {
        // An unknown element paints nothing, but its children may
        // paint -- that is also how Chromium behaves with an element from
        // a foreign namespace.
        draw_children(m, b, i, z, depth)
        return
    }
    if path.path_is_empty(&(*m).p1) {
        return
    }
    times_shape(m, b, &z)
}

// ----------------------------------------------------------- The entry point

// The size that an SVG file has by itself. It stands in
// `width`/`height`; if those are missing, it comes from the `viewBox`; if that is missing too,
// it is the 300x150 of the specification.
#[no_gc]
fn svg_size(b: *mut svgxml.Tree, bw: *mut f64, bh: *mut f64) -> bool {
    let e: u32 = svgxml.node_root(b)
    if e == svgxml.KEINER {
        return false
    }
    let pool: u64 = svgxml.tree_pool(b)
    var z: State = state_new(300.0, 150.0)
    var ww: [u8; 5] = "width"
    var wh: [u8; 6] = "height"
    var wvb: [u8; 7] = "viewBox"
    var a: usize = 0
    var n: usize = 0
    var vb: [f64; 4] = [0.0; 4]
    var hat_vb: bool = false
    if svgxml.attr_value(b, e, (&wvb[0]) as u64, 7, &a, &n) {
        hat_vb = read_viewbox(pool, a, n, &vb[0])
    }
    var w: f64 = 0.0 - 1.0
    var h: f64 = 0.0 - 1.0
    if svgxml.attr_value(b, e, (&ww[0]) as u64, 5, &a, &n) {
        var ok: bool = false
        // A percentage here means "as large as the frame"; without a
        // frame only the viewBox remains.
        if matrix.read_byte(pool, a + n - 1) != 37 {
            let v: f64 = length_of(pool, a, n, 0.0, 16.0, &ok)
            if ok && v > 0.0 {
                w = v
            }
        }
    }
    if svgxml.attr_value(b, e, (&wh[0]) as u64, 6, &a, &n) {
        var ok: bool = false
        if matrix.read_byte(pool, a + n - 1) != 37 {
            let v: f64 = length_of(pool, a, n, 0.0, 16.0, &ok)
            if ok && v > 0.0 {
                h = v
            }
        }
    }
    if w < 0.0 && hat_vb && vb[2] > 0.0 {
        w = vb[2]
    }
    if h < 0.0 && hat_vb && vb[3] > 0.0 {
        h = vb[3]
    }
    if w < 0.0 {
        w = 300.0
    }
    if h < 0.0 {
        h = 150.0
    }
    *bw = w
    *bh = h
    return true
}

// Paint the whole tree into the given rectangle.
#[no_gc]
fn times_tree(m: *mut Painter, b: *mut svgxml.Tree, ex: f64, ey: f64, ew: f64,
    eh: f64) {
    times_tree_color(m, b, ex, ey, ew, eh, 4278190080 as u32)
}

// THE SAME, WITH A GIVEN `currentColor`.
//
// PORTING INTO THE FIRN TREE (13.09.2026, round BILD+SVG): fUi needs
// this, and exactly for what `currentColor` was invented for.
//
// Justin: tinted surfaces are to draw the ACCENT COLOUR from theme.fi
// (TOK_ACCENT / TOK_TEXT_ON_ACCENT), because in parallel two rounds are
// switching the surfaces to it. A symbol from Lucide, Feather or
// Material writes `fill="currentColor"` or `stroke="currentColor"` --
// it EXPECTS the environment to set the colour.
//
// Until now `aktuell` stood at black and was not reachable from outside.
// A symbol on an accent button would thereby be black on blue instead of
// white on blue, and a symbol in the dark theme black on dark grey
// -- so invisible.
//
// WHY THIS IS THE RIGHT WAY and not tinting the finished
// mask: `currentColor` acts PER SURFACE. A two-colour symbol keeps
// its second colour, and a symbol with a hard-wired colour keeps
// its own -- as the author meant it. Tinting the alpha mask
// afterwards makes every symbol single-colour and is therefore only the emergency measure
// (lib/fui/uisvg.fi says when which way applies).
//
// `male_baum` stays as a call with black, so that Certus
// keeps running unchanged.
#[no_gc]
fn times_tree_color(m: *mut Painter, b: *mut svgxml.Tree, ex: f64, ey: f64,
    ew: f64, eh: f64, aktuell: u32) {
    let e: u32 = svgxml.node_root(b)
    if e == svgxml.KEINER {
        return
    }
    if name_hash(b, e) != N_SVG {
        return
    }
    (*m).n_used = 0
    // The style sheet of the document stands before everything else: `hole_wert`
    // asks it at EVERY element, also already at the root element here.
    leaf_collect(b)
    var z: State = state_new(ew, eh)
    // Before `zustand_anwenden`, so that a `color="..."` in the document itself
    // still wins -- that is the order that CSS prescribes.
    z.aktuell = aktuell
    state_apply(b, e, &z)
    // The intrinsic size of the file -- it serves as the substitute `viewBox` if
    // none stands there.
    var nw: f64 = 0.0
    var nh: f64 = 0.0
    if !svg_size(b, &nw, &nh) {
        nw = 0.0
        nh = 0.0
    }
    draw_view(m, b, e, z, ex, ey, ew, eh, nw, nh, 0)
}

// The convenient way: octets in, image on the canvas.
#[no_gc]
fn times_svg(m: *mut Painter, b: *mut svgxml.Tree, p: u64, n: usize, ex: f64,
    ey: f64, ew: f64, eh: f64) -> bool {
    if !svgxml.split_xml(b, p, n) {
        return false
    }
    times_tree(m, b, ex, ey, ew, eh)
    return true
}
