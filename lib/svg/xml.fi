// SPDX-License-Identifier: MPL-2.0
// Provenance: Certus, lib/svg/ (last changed in Certus commit 8f138f02), ported to
// Firn in 0e1a1196; released by the sole author Justin on 25.09.2026 for Firn
// under MPL-2.0.
// lib/svg/xml.fi -- THE XML READER for stand-alone SVG files.
//
// An `.svg` file is XML, and an `<svg>` in the middle of an HTML page
// is NOT -- that is read by the HTML parser in lib/browser with its
// own rules for foreign content, and that is in this round foreign
// territory. This file is therefore responsible exclusively for the case
// that an SVG file arrives as a WHOLE: as `<img src="...svg">`, as
// CSS `background-image` or from disk.
//
// WHAT IS READ. Elements, attributes, text, `<!-- -->`, `<![CDATA[]]>`,
// `<?xml ?>`, `<!DOCTYPE >`, the five built-in entities and the
// character references `&#123;` and `&#x1F;`. What is NOT read: an
// internal DTD with entities of its own. It does not occur in real SVG files,
// and whoever writes it gets here the text without the
// substitution -- visible, not silently wrong.
//
// ERROR TOLERANCE, AND DELIBERATELY. XML is the language that is SUPPOSED to
// break off on an error. A browser does not do that nevertheless: a symbol
// that lacks a `</g>` at the end is drawn by Chromium, and whoever
// delivers an empty image instead has holes on a real page.
// So: a closing tag that does not fit closes as many
// open elements as necessary; an element that is still open at the end
// is closed; an attribute without quotation marks is read to the
// next whitespace.
//
// ---------------------------------------------------------- THE MEMORY
//
// No object per node. Seven columns of `u32` and TWO pools:
//
//   `pool`  all names and all RESOLVED attribute values, one behind the other
//   `text`  the text content, likewise resolved
//
// A node thereby costs 32 octets plus its text; a symbol collection
// with 3000 paths stays under a megabyte. A `Gc` tree would here have had
// the collector run in a loop that can collect nothing at all
// -- an SVG tree lives exactly as long as the image and is thrown away as a
// whole.
import html.mem
import svg.matrix

export {
    Tree,
    tree_new, tree_init, tree_free,
    split_xml,
    K_ELEM, K_TEXT, KEINER,
    node_count, node_type, node_root,
    node_name_a, node_name_n, node_kind, node_next,
    node_parent, node_text_a, node_text_n,
    node_attr_count, node_attr_name_a, node_attr_name_n,
    node_attr_value_a, node_attr_value_n,
    tree_pool, tree_name_is, find_attr, attr_value,
    tree_error,
}

const K_ELEM: u32 = 0
const K_TEXT: u32 = 1
const KEINER: u32 = 4294967295

// How deeply elements may be nested. A page that goes deeper
// gets the rest appended flat -- no crash, no memory
// hogging.
const DEPTH_MAX: usize = 256

struct Tree {
    art: mem.CpBuf,
    name_a: mem.CpBuf,
    name_n: mem.CpBuf,
    parent: mem.CpBuf,
    kind: mem.CpBuf, // erstes Kind
    last: mem.CpBuf, // letztes Kind, nur beim Bauen gebraucht
    next: mem.CpBuf,
    attr_a: mem.CpBuf, // Index in die Attributspalten
    attr_n: mem.CpBuf,
    // die Attributspalten
    an_a: mem.CpBuf,
    an_n: mem.CpBuf,
    aw_a: mem.CpBuf,
    aw_n: mem.CpBuf,
    pool: mem.Buf, // Namen und Werte, aufgeloest
    root: u32,
    err: usize,
}

#[no_gc]
fn tree_new() -> Tree {
    return Tree {
        art: mem.cp_new(),
        name_a: mem.cp_new(),
        name_n: mem.cp_new(),
        parent: mem.cp_new(),
        kind: mem.cp_new(),
        last: mem.cp_new(),
        next: mem.cp_new(),
        attr_a: mem.cp_new(),
        attr_n: mem.cp_new(),
        an_a: mem.cp_new(),
        an_n: mem.cp_new(),
        aw_a: mem.cp_new(),
        aw_n: mem.cp_new(),
        pool: mem.buf_new(),
        root: KEINER,
        err: 0,
    }
}

#[no_gc]
fn tree_init(b: *mut Tree) {
    mem.cp_init(&(*b).art)
    mem.cp_init(&(*b).name_a)
    mem.cp_init(&(*b).name_n)
    mem.cp_init(&(*b).parent)
    mem.cp_init(&(*b).kind)
    mem.cp_init(&(*b).last)
    mem.cp_init(&(*b).next)
    mem.cp_init(&(*b).attr_a)
    mem.cp_init(&(*b).attr_n)
    mem.cp_init(&(*b).an_a)
    mem.cp_init(&(*b).an_n)
    mem.cp_init(&(*b).aw_a)
    mem.cp_init(&(*b).aw_n)
    mem.buf_init(&(*b).pool)
    (*b).root = KEINER
    (*b).err = 0
}

#[no_gc]
fn tree_free(b: *mut Tree) {
    mem.cp_free(&(*b).art)
    mem.cp_free(&(*b).name_a)
    mem.cp_free(&(*b).name_n)
    mem.cp_free(&(*b).parent)
    mem.cp_free(&(*b).kind)
    mem.cp_free(&(*b).last)
    mem.cp_free(&(*b).next)
    mem.cp_free(&(*b).attr_a)
    mem.cp_free(&(*b).attr_n)
    mem.cp_free(&(*b).an_a)
    mem.cp_free(&(*b).an_n)
    mem.cp_free(&(*b).aw_a)
    mem.cp_free(&(*b).aw_n)
    mem.buf_free(&(*b).pool)
}

// ------------------------------------------------------------ Zugriff

#[no_gc]
fn node_count(b: *mut Tree) -> usize {
    return mem.cp_len(&(*b).art)
}

#[no_gc]
fn node_type(b: *mut Tree, i: u32) -> u32 {
    if i == KEINER || (i as usize) >= mem.cp_len(&(*b).art) {
        return KEINER
    }
    return mem.cp_at(&(*b).art, i as usize)
}

#[no_gc]
fn node_root(b: *mut Tree) -> u32 {
    return (*b).root
}

#[no_gc]
fn node_name_a(b: *mut Tree, i: u32) -> usize {
    return mem.cp_at(&(*b).name_a, i as usize) as usize
}

#[no_gc]
fn node_name_n(b: *mut Tree, i: u32) -> usize {
    return mem.cp_at(&(*b).name_n, i as usize) as usize
}

#[no_gc]
fn node_kind(b: *mut Tree, i: u32) -> u32 {
    if i == KEINER || (i as usize) >= mem.cp_len(&(*b).art) {
        return KEINER
    }
    return mem.cp_at(&(*b).kind, i as usize)
}

#[no_gc]
fn node_next(b: *mut Tree, i: u32) -> u32 {
    if i == KEINER || (i as usize) >= mem.cp_len(&(*b).art) {
        return KEINER
    }
    return mem.cp_at(&(*b).next, i as usize)
}

#[no_gc]
fn node_parent(b: *mut Tree, i: u32) -> u32 {
    if i == KEINER || (i as usize) >= mem.cp_len(&(*b).art) {
        return KEINER
    }
    return mem.cp_at(&(*b).parent, i as usize)
}

// A text node puts its content into the same pool as the names; the
// name columns point to it.
#[no_gc]
fn node_text_a(b: *mut Tree, i: u32) -> usize {
    return node_name_a(b, i)
}

#[no_gc]
fn node_text_n(b: *mut Tree, i: u32) -> usize {
    return node_name_n(b, i)
}

#[no_gc]
fn node_attr_count(b: *mut Tree, i: u32) -> usize {
    if i == KEINER || (i as usize) >= mem.cp_len(&(*b).art) {
        return 0
    }
    return mem.cp_at(&(*b).attr_n, i as usize) as usize
}

#[no_gc]
fn node_attr_name_a(b: *mut Tree, i: u32, k: usize) -> usize {
    let a: usize = mem.cp_at(&(*b).attr_a, i as usize) as usize
    return mem.cp_at(&(*b).an_a, a + k) as usize
}

#[no_gc]
fn node_attr_name_n(b: *mut Tree, i: u32, k: usize) -> usize {
    let a: usize = mem.cp_at(&(*b).attr_a, i as usize) as usize
    return mem.cp_at(&(*b).an_n, a + k) as usize
}

#[no_gc]
fn node_attr_value_a(b: *mut Tree, i: u32, k: usize) -> usize {
    let a: usize = mem.cp_at(&(*b).attr_a, i as usize) as usize
    return mem.cp_at(&(*b).aw_a, a + k) as usize
}

#[no_gc]
fn node_attr_value_n(b: *mut Tree, i: u32, k: usize) -> usize {
    let a: usize = mem.cp_at(&(*b).attr_a, i as usize) as usize
    return mem.cp_at(&(*b).aw_n, a + k) as usize
}

#[no_gc]
fn tree_pool(b: *mut Tree) -> u64 {
    return mem.buf_ptr(&(*b).pool) as u64
}

#[no_gc]
fn tree_error(b: *mut Tree) -> usize {
    return (*b).err
}

// Is the node called this? SVG is CASE-SENSITIVE --
// `<clipPath>` and `<clippath>` are two different names. The
// comparison is therefore exact, not normalised to lower case.
#[no_gc]
fn tree_name_is(b: *mut Tree, i: u32, w: u64, wn: usize) -> bool {
    if node_type(b, i) != K_ELEM {
        return false
    }
    let n: usize = node_name_n(b, i)
    if n != wn {
        return false
    }
    let a: usize = node_name_a(b, i)
    let p: u64 = tree_pool(b)
    var k: usize = 0
    while k < n {
        if matrix.read_byte(p, a + k) != matrix.read_byte(w, k) {
            return false
        }
        k = k + 1
    }
    return true
}

// The number of an attribute, or `KEINER`.
#[no_gc]
fn find_attr(b: *mut Tree, i: u32, w: u64, wn: usize) -> u32 {
    let anz: usize = node_attr_count(b, i)
    let p: u64 = tree_pool(b)
    var k: usize = 0
    while k < anz {
        if node_attr_name_n(b, i, k) == wn {
            let a: usize = node_attr_name_a(b, i, k)
            var j: usize = 0
            var equal: bool = true
            while j < wn {
                if matrix.read_byte(p, a + j) != matrix.read_byte(w, j) {
                    equal = false
                    break
                }
                j = j + 1
            }
            if equal {
                return k as u32
            }
        }
        k = k + 1
    }
    return KEINER
}

// Start and length of the value; `false` if the attribute does not exist.
#[no_gc]
fn attr_value(b: *mut Tree, i: u32, w: u64, wn: usize, a: *mut usize,
    n: *mut usize) -> bool {
    let k: u32 = find_attr(b, i, w, wn)
    if k == KEINER {
        return false
    }
    *a = node_attr_value_a(b, i, k as usize)
    *n = node_attr_value_n(b, i, k as usize)
    return true
}

// ------------------------------------------------------------ The pool

#[no_gc]
fn pool_len(b: *mut Tree) -> usize {
    return mem.buf_len(&(*b).pool)
}

#[no_gc]
fn pool_push(b: *mut Tree, v: u32) {
    mem.buf_push(&(*b).pool, v as u8)
}

// A character as UTF-8 into the pool. Character references like `&#x2192;`
// can lie above 127, and the rest of the program expects UTF-8.
#[no_gc]
fn pool_push_cp(b: *mut Tree, cp: u32) {
    if cp < 128 {
        pool_push(b, cp)
        return
    }
    if cp < 2048 {
        pool_push(b, 192 + (cp >> 6))
        pool_push(b, 128 + (cp & 63))
        return
    }
    if cp < 65536 {
        pool_push(b, 224 + (cp >> 12))
        pool_push(b, 128 + ((cp >> 6) & 63))
        pool_push(b, 128 + (cp & 63))
        return
    }
    if cp < 1114112 {
        pool_push(b, 240 + (cp >> 18))
        pool_push(b, 128 + ((cp >> 12) & 63))
        pool_push(b, 128 + ((cp >> 6) & 63))
        pool_push(b, 128 + (cp & 63))
    }
}

// -------------------------------------------------------- The parser

#[no_gc]
fn is_namechar(c: u32) -> bool {
    if c >= 97 && c <= 122 {
        return true
    }
    if c >= 65 && c <= 90 {
        return true
    }
    if c >= 48 && c <= 57 {
        return true
    }
    // Dot, hyphen, underscore, colon and everything above 127
    // (for names with umlauts -- XML allows them).
    return c == 46 || c == 45 || c == 95 || c == 58 || c > 127
}

#[no_gc]
fn hex_digit(c: u32) -> i32 {
    if c >= 48 && c <= 57 {
        return (c - 48) as i32
    }
    if c >= 97 && c <= 102 {
        return (c - 97 + 10) as i32
    }
    if c >= 65 && c <= 70 {
        return (c - 65 + 10) as i32
    }
    return 0 - 1
}

// An entity from the `&`. Returns the length that was consumed,
// and puts the result into the pool. 0 means: no valid
// entity, the `&` belongs into the text as a character.
#[no_gc]
fn entitaet(b: *mut Tree, p: u64, n: usize, i: usize) -> usize {
    if i + 2 >= n {
        return 0
    }
    if matrix.read_byte(p, i + 1) == 35 {
        // Zeichenverweis
        var j: usize = i + 2
        var value: u32 = 0
        var hex: bool = false
        if j < n && (matrix.read_byte(p, j) == 120
            || matrix.read_byte(p, j) == 88) {
            hex = true
            j = j + 1
        }
        var digits: usize = 0
        while j < n {
            let c: u32 = matrix.read_byte(p, j)
            var d: i32 = 0 - 1
            if hex {
                d = hex_digit(c)
            } else if c >= 48 && c <= 57 {
                d = (c - 48) as i32
            }
            if d < 0 {
                break
            }
            if value < 1114112 {
                if hex {
                    value = value * 16 + (d as u32)
                } else {
                    value = value * 10 + (d as u32)
                }
            }
            digits = digits + 1
            j = j + 1
        }
        if digits == 0 || j >= n || matrix.read_byte(p, j) != 59 {
            return 0
        }
        if value == 0 || value > 1114111 {
            value = 65533
        }
        pool_push_cp(b, value)
        return j + 1 - i
    }
    // The five built-in names.
    let c1: u32 = matrix.read_byte(p, i + 1)
    if c1 == 108 && i + 3 < n && matrix.read_byte(p, i + 2) == 116
    && matrix.read_byte(p, i + 3) == 59 {
        pool_push(b, 60)
        return 4
    }
    if c1 == 103 && i + 3 < n && matrix.read_byte(p, i + 2) == 116
    && matrix.read_byte(p, i + 3) == 59 {
        pool_push(b, 62)
        return 4
    }
    if c1 == 97 && i + 4 < n && matrix.read_byte(p, i + 2) == 109
    && matrix.read_byte(p, i + 3) == 112
    && matrix.read_byte(p, i + 4) == 59 {
        pool_push(b, 38)
        return 5
    }
    if c1 == 97 && i + 5 < n && matrix.read_byte(p, i + 2) == 112
    && matrix.read_byte(p, i + 3) == 111
    && matrix.read_byte(p, i + 4) == 115
    && matrix.read_byte(p, i + 5) == 59 {
        pool_push(b, 39)
        return 6
    }
    if c1 == 113 && i + 5 < n && matrix.read_byte(p, i + 2) == 117
    && matrix.read_byte(p, i + 3) == 111
    && matrix.read_byte(p, i + 4) == 116
    && matrix.read_byte(p, i + 5) == 59 {
        pool_push(b, 34)
        return 6
    }
    return 0
}

// Write a stretch of text with resolved entities into the pool.
#[no_gc]
fn pool_text(b: *mut Tree, p: u64, von: usize, bis: usize) {
    var i: usize = von
    while i < bis {
        let c: u32 = matrix.read_byte(p, i)
        if c == 38 {
            let k: usize = entitaet(b, p, bis, i)
            if k > 0 {
                i = i + k
                continue
            }
        }
        pool_push(b, c)
        i = i + 1
    }
}

// Create a new node.
#[no_gc]
fn node_new(b: *mut Tree, art: u32, na: usize, nn: usize) -> u32 {
    let i: u32 = mem.cp_len(&(*b).art) as u32
    mem.cp_push(&(*b).art, art)
    mem.cp_push(&(*b).name_a, na as u32)
    mem.cp_push(&(*b).name_n, nn as u32)
    mem.cp_push(&(*b).parent, KEINER)
    mem.cp_push(&(*b).kind, KEINER)
    mem.cp_push(&(*b).last, KEINER)
    mem.cp_push(&(*b).next, KEINER)
    mem.cp_push(&(*b).attr_a, mem.cp_len(&(*b).an_a) as u32)
    mem.cp_push(&(*b).attr_n, 0)
    return i
}

#[no_gc]
fn kind_an(b: *mut Tree, parent: u32, kind: u32) {
    mem.cp_set(&(*b).parent, kind as usize, parent)
    if parent == KEINER {
        return
    }
    let l: u32 = mem.cp_at(&(*b).last, parent as usize)
    if l == KEINER {
        mem.cp_set(&(*b).kind, parent as usize, kind)
    } else {
        mem.cp_set(&(*b).next, l as usize, kind)
    }
    mem.cp_set(&(*b).last, parent as usize, kind)
}

// Skip a `<!-- -->`, `<![CDATA[ ]]>`, `<?...?>` or `<!DOCTYPE ...>`.
// Returns the position AFTER the section.
#[no_gc]
fn sonderabschnitt(b: *mut Tree, p: u64, n: usize, i_in: usize,
    parent: u32) -> usize {
    var i: usize = i_in
    // <!-- ... -->
    if i + 3 < n && matrix.read_byte(p, i + 1) == 33
    && matrix.read_byte(p, i + 2) == 45
    && matrix.read_byte(p, i + 3) == 45 {
        var j: usize = i + 4
        while j + 2 < n {
            if matrix.read_byte(p, j) == 45
            && matrix.read_byte(p, j + 1) == 45
            && matrix.read_byte(p, j + 2) == 62 {
                return j + 3
            }
            j = j + 1
        }
        return n
    }
    // <![CDATA[ ... ]]>  -- the content is TEXT, and without
    // entity resolution. It is taken up as a text node.
    if i + 8 < n && matrix.read_byte(p, i + 1) == 33
    && matrix.read_byte(p, i + 2) == 91
    && matrix.read_byte(p, i + 3) == 67
    && matrix.read_byte(p, i + 4) == 68
    && matrix.read_byte(p, i + 5) == 65
    && matrix.read_byte(p, i + 6) == 84
    && matrix.read_byte(p, i + 7) == 65
    && matrix.read_byte(p, i + 8) == 91 {
        var j: usize = i + 9
        let von: usize = j
        while j + 2 < n {
            if matrix.read_byte(p, j) == 93
            && matrix.read_byte(p, j + 1) == 93
            && matrix.read_byte(p, j + 2) == 62 {
                break
            }
            j = j + 1
        }
        var bis: usize = j
        if j + 2 >= n {
            bis = n
        }
        let a: usize = pool_len(b)
        var k: usize = von
        while k < bis {
            pool_push(b, matrix.read_byte(p, k))
            k = k + 1
        }
        let t: u32 = node_new(b, K_TEXT, a, pool_len(b) - a)
        kind_an(b, parent, t)
        if j + 2 >= n {
            return n
        }
        return j + 3
    }
    // <? ... ?> and <! ... >
    var j: usize = i + 1
    var depth: usize = 1
    while j < n {
        let c: u32 = matrix.read_byte(p, j)
        if c == 60 {
            depth = depth + 1
        } else if c == 62 {
            depth = depth - 1
            if depth == 0 {
                return j + 1
            }
        }
        j = j + 1
    }
    return n
}

// THE ENTRY POINT. `p`/`n` is the file. `true` if at least one
// element was found.
#[no_gc]
fn split_xml(b: *mut Tree, p: u64, n: usize) -> bool {
    var stack: [u32; 256] = [0; 256]
    var depth: usize = 0
    var aktuell: u32 = KEINER
    var i: usize = 0
    (*b).err = 0
    while i < n {
        let c: u32 = matrix.read_byte(p, i)
        if c != 60 {
            // Text up to the next `<`.
            let von: usize = i
            while i < n && matrix.read_byte(p, i) != 60 {
                i = i + 1
            }
            if aktuell != KEINER {
                let a: usize = pool_len(b)
                pool_text(b, p, von, i)
                let nn: usize = pool_len(b) - a
                if nn > 0 {
                    let t: u32 = node_new(b, K_TEXT, a, nn)
                    kind_an(b, aktuell, t)
                }
            }
            continue
        }
        if i + 1 >= n {
            break
        }
        let c1: u32 = matrix.read_byte(p, i + 1)
        if c1 == 33 || c1 == 63 {
            i = sonderabschnitt(b, p, n, i, aktuell)
            continue
        }
        if c1 == 47 {
            // A closing tag. The name is read and looked for in the
            // stack; if it fits nowhere, it is discarded.
            var j: usize = i + 2
            let von: usize = j
            while j < n && is_namechar(matrix.read_byte(p, j)) {
                j = j + 1
            }
            let ln: usize = j - von
            while j < n && matrix.read_byte(p, j) != 62 {
                j = j + 1
            }
            var k: i64 = (depth as i64) - 1
            var hit: i64 = 0 - 1
            while k >= 0 {
                let e: u32 = stack[k as usize]
                let na: usize = node_name_a(b, e)
                let nl: usize = node_name_n(b, e)
                if nl == ln {
                    var q: usize = 0
                    var equal: bool = true
                    let pl: u64 = tree_pool(b)
                    while q < ln {
                        if matrix.read_byte(pl, na + q)
                        != matrix.read_byte(p, von + q) {
                            equal = false
                            break
                        }
                        q = q + 1
                    }
                    if equal {
                        hit = k
                        break
                    }
                }
                k = k - 1
            }
            if hit >= 0 {
                if (hit as usize) + 1 != depth {
                    (*b).err = (*b).err + 1
                }
                depth = hit as usize
                if depth == 0 {
                    aktuell = KEINER
                } else {
                    aktuell = stack[depth - 1]
                }
            } else {
                (*b).err = (*b).err + 1
            }
            if j < n {
                j = j + 1
            }
            i = j
            continue
        }
        // An opening tag.
        var j: usize = i + 1
        let nvon: usize = j
        while j < n && is_namechar(matrix.read_byte(p, j)) {
            j = j + 1
        }
        var nlen: usize = j - nvon
        if nlen == 0 {
            // `<` without a name -- take as text and go on.
            i = i + 1
            continue
        }
        // A namespace prefix before the colon is dropped:
        // `<svg:rect>` is `rect`. The prefix itself is of no meaning for painting
        // as long as only SVG stands in the file.
        var na2: usize = nvon
        var q: usize = nvon
        while q < nvon + nlen {
            if matrix.read_byte(p, q) == 58 {
                na2 = q + 1
            }
            q = q + 1
        }
        let name_a: usize = pool_len(b)
        var r: usize = na2
        while r < nvon + nlen {
            pool_push(b, matrix.read_byte(p, r))
            r = r + 1
        }
        let name_n: usize = pool_len(b) - name_a
        let e: u32 = node_new(b, K_ELEM, name_a, name_n)
        // Die Attribute.
        var anz: usize = 0
        var slf: bool = false
        while j < n {
            while j < n && matrix.is_empty(matrix.read_byte(p, j)) {
                j = j + 1
            }
            if j >= n {
                break
            }
            let cj: u32 = matrix.read_byte(p, j)
            if cj == 62 {
                j = j + 1
                break
            }
            if cj == 47 {
                slf = true
                j = j + 1
                continue
            }
            if !is_namechar(cj) {
                j = j + 1
                continue
            }
            let avon: usize = j
            while j < n && is_namechar(matrix.read_byte(p, j)) {
                j = j + 1
            }
            var alen: usize = j - avon
            // `xlink:href` becomes `href`. That is the only place at which
            // the prefix of an attribute counts, and both
            // notations mean the same in SVG.
            var aa2: usize = avon
            var t: usize = avon
            while t < avon + alen {
                if matrix.read_byte(p, t) == 58 {
                    aa2 = t + 1
                }
                t = t + 1
            }
            let an: usize = pool_len(b)
            var u: usize = aa2
            while u < avon + alen {
                pool_push(b, matrix.read_byte(p, u))
                u = u + 1
            }
            let anl: usize = pool_len(b) - an
            while j < n && matrix.is_empty(matrix.read_byte(p, j)) {
                j = j + 1
            }
            var wa: usize = pool_len(b)
            var wn: usize = 0
            if j < n && matrix.read_byte(p, j) == 61 {
                j = j + 1
                while j < n && matrix.is_empty(matrix.read_byte(p, j)) {
                    j = j + 1
                }
                if j < n && (matrix.read_byte(p, j) == 34
                    || matrix.read_byte(p, j) == 39) {
                    let q2: u32 = matrix.read_byte(p, j)
                    j = j + 1
                    let wvon: usize = j
                    while j < n && matrix.read_byte(p, j) != q2 {
                        j = j + 1
                    }
                    pool_text(b, p, wvon, j)
                    wn = pool_len(b) - wa
                    if j < n {
                        j = j + 1
                    }
                } else {
                    // Without quotation marks -- up to the whitespace or
                    // up to the `>`.
                    let wvon: usize = j
                    while j < n && !matrix.is_empty(matrix.read_byte(p, j))
                    && matrix.read_byte(p, j) != 62 {
                        j = j + 1
                    }
                    pool_text(b, p, wvon, j)
                    wn = pool_len(b) - wa
                    (*b).err = (*b).err + 1
                }
            }
            mem.cp_push(&(*b).an_a, an as u32)
            mem.cp_push(&(*b).an_n, anl as u32)
            mem.cp_push(&(*b).aw_a, wa as u32)
            mem.cp_push(&(*b).aw_n, wn as u32)
            anz = anz + 1
        }
        mem.cp_set(&(*b).attr_n, e as usize, anz as u32)
        kind_an(b, aktuell, e)
        if (*b).root == KEINER {
            (*b).root = e
        }
        if !slf {
            if depth < DEPTH_MAX {
                stack[depth] = e
                depth = depth + 1
                aktuell = e
            } else {
                (*b).err = (*b).err + 1
            }
        }
        i = j
    }
    if depth > 0 {
        (*b).err = (*b).err + 1
    }
    return (*b).root != KEINER
}
