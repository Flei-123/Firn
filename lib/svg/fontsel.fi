// SPDX-License-Identifier: MPL-2.0
// Herkunft: Certus, lib/svg/ (zuletzt geaendert in Certus-Commit 8f138f02), nach Firn
// portiert in 0e1a1196; vom alleinigen Urheber Justin am 25.09.2026 fuer Firn
// unter MPL-2.0 freigegeben.
// lib/svg/fontsel.fi -- DER SCHRIFT-ADAPTER FUER DEN FIRN-BAUM.
//
// ======================================================== WARUM DIE DATEI
//
// `lib/svg` kommt aus dem Certus-Baum (portiert am 13.09.2026). Dort hat
// `lib/font/metrics.fi` die SCHRIFTAUSWAHL von css-fonts-4 mitbekommen
// (Runde CSS2): mehrere Schnitte je Satz, `FontReq` mit Familienliste,
// Gewicht und Neigung, und `fm_pick` waehlt je ZEICHEN den Schnitt.
//
// Im Firn-Baum ist `metrics.fi` die AELTERE Fassung mit EINEM Schnitt:
//
//     firn:    fm_advance(fm, size, cp)
//     certus:  fm_advance(fm, req, size, cp)   <- ein Argument mehr
//
// ==================================== WARUM NICHT DAS NEUE metrics.fi
//
// Naheliegend waere, die neuere Datei mitzuportieren. GEMESSEN, nicht
// vermutet (13.09.2026): das neue `metrics.fi` aendert die Signatur von
// `fm_ascent`, `fm_descent`, `fm_advance` und `fm_kern`, und die benutzen
// im Firn-Baum
//
//     lib/fui/painter.fi        sieben Stellen
//     lib/layout/box.fi         fuenf Stellen
//     lib/browser/window_main.fi, b5_main.fi, lib/paint/b3_main.fi
//
// Das ist der Textsatz des ganzen Browsers und die Textschicht von fUi.
// Diese Runde soll BILDER UND SVG einbauen; sie darf nicht dabei die
// Schriftauswahl des Baums austauschen -- zumal parallel ein langer
// Gauntlet auf Certus laeuft und genau diese Dateien anfasst.
//
// Also: NICHT das Fundament umbauen, sondern EINE Datei danebenlegen, die
// die neue Sprache auf die alte uebersetzt. Wenn der Firn-Baum das neue
// `metrics.fi` irgendwann uebernimmt, ist diese Datei ersatzlos
// loeschbar -- und `paint.fi` bleibt dabei unveraendert, weil es hier
// hindurchspricht und nicht daran vorbei.
//
// DER NAME. Zuerst hiess die Datei `svg.metrics`, damit in `paint.fi` nur
// die Importzeile zu tauschen war und jeder Aufruf `metrics.fm_...`
// woertlich stehen bleibt (Firn kennt kein `import ... as ...`). Das geht
// NICHT: innerhalb eines Moduls `metrics` zeigt `metrics.` auf das Modul
// SELBST, und an `font.metrics` kommt man dann nicht mehr heran -- Firn
// loest nur das letzte Glied eines Pfades auf. Darum `fontsel`, und die
// rund zwanzig Aufrufstellen in `paint.fi` heissen jetzt `fontsel.`.
//
// ============================================ WAS DABEI VERLOREN GEHT
//
// EHRLICH BENANNT, weil eine stille Einschraenkung schlimmer ist als eine
// fehlende Funktion:
//
//   * EIN SCHNITT. `fm_pick` gibt immer denselben Schnitt zurueck, egal
//     welche Familie, welches Gewicht, welche Neigung das SVG verlangt.
//     `font-family` in einem `<text>` wird also nicht befolgt.
//   * KEIN ERSATZ JE ZEICHEN. Hat die geladene Schrift kein Zeichen,
//     bleibt die Stelle leer, statt in einer zweiten Schrift zu suchen.
//   * KEIN KUNSTFETT, KEINE KUNSTNEIGUNG (SY_BOLD / SY_ITALIC).
//
// FUER SYMBOLE IST DAS GLEICHGUELTIG, und das ist der Punkt: ein Symbol
// ist ein PFAD. Ein `<text>` in einem Symbol ist ohnehin die Ausnahme,
// die man im Zeichenprogramm in Pfade wandelt -- lib/fui/icon.fi sagt
// genau das im Kopf, und im Kernel-Profil gibt es gar keine Schrift (K1
// in core.fi). Die neun geometrischen Marken bleiben davon unberuehrt.
import font.metrics
import font.ttf

export {
    FontReq, req_new, req_set_family, req_family_count,
    fm_advance, fm_ascent, fm_descent, fm_kern,
    fm_pick, fm_face_of,
    PICK_NONE, REQ_FAMILIES,
}

// Die Anforderung wird ENTGEGENGENOMMEN und nicht ausgewertet. Sie
// bleibt als Datensatz erhalten, damit `paint.fi` unveraendert bleibt:
// es darf `req_set_family` rufen, es hat hier nur keine Wirkung.
const REQ_FAMILIES: usize = 4

// Derselbe Wert wie im Certus-Baum -- "kein Schnitt gefunden".
const PICK_NONE: u32 = 4294967295

struct FontReq {
    fam: [u32; 4],
    generic: u32,
    weight: u32,
    italic: u32,
}

#[no_gc]
fn req_new() -> FontReq {
    return FontReq { fam: [0; 4], generic: 0, weight: 400, italic: 0 }
}

#[no_gc]
fn req_set_family(r: *mut FontReq, i: usize, h: u32) {
    if i < REQ_FAMILIES {
        (*r).fam[i] = h
    }
}

#[no_gc]
fn req_family_count(r: *mut FontReq) -> usize {
    var i: usize = 0
    while i < REQ_FAMILIES {
        if (*r).fam[i] == 0 as u32 {
            return i
        }
        i = i + 1
    }
    return REQ_FAMILIES
}

// ---- die vier Masse: die Anforderung wird verworfen, der Rest gereicht.

#[no_gc]
fn fm_advance(fm: u64, r: *mut FontReq, size: f64, cp: u32) -> f64 {
    return metrics.fm_advance(fm, size, cp)
}

#[no_gc]
fn fm_ascent(fm: u64, r: *mut FontReq, size: f64) -> f64 {
    return metrics.fm_ascent(fm, size)
}

#[no_gc]
fn fm_descent(fm: u64, r: *mut FontReq, size: f64) -> f64 {
    return metrics.fm_descent(fm, size)
}

#[no_gc]
fn fm_kern(fm: u64, r: *mut FontReq, size: f64, a: u32, b: u32) -> f64 {
    return metrics.fm_kern(fm, size, a, b)
}

// ---- die Schnittwahl: es gibt genau einen.

// 0 heisst "der erste (und einzige) Schnitt". `paint.fi` vergleicht den
// Rueckgabewert mit `& 65535` gegen sich selbst, um Kerning nur INNERHALB
// eines Schnitts zu erlauben; mit einem konstanten Wert ist das immer
// wahr, und das ist richtig -- es gibt nur den einen.
#[no_gc]
fn fm_pick(fm: u64, r: *mut FontReq, cp: u32) -> u32 {
    if fm == 0 {
        return PICK_NONE
    }
    return 0 as u32
}

#[no_gc]
fn fm_face_of(fm: u64, pick: u32) -> *mut ttf.Font {
    return metrics.fontset_font(fm)
}
