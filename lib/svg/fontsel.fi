// SPDX-License-Identifier: MPL-2.0
// Provenance: Certus, lib/svg/ (last changed in Certus commit 8f138f02), ported to
// Firn in 0e1a1196; released by the sole author Justin on 25.09.2026 for Firn
// under MPL-2.0.
// lib/svg/fontsel.fi -- THE FONT ADAPTER FOR THE FIRN TREE.
//
// ======================================================== WHY THE FILE
//
// `lib/svg` comes from the Certus tree (ported on 13.09.2026). There
// `lib/font/metrics.fi` got the FONT SELECTION of css-fonts-4
// (round CSS2): several faces per set, `FontReq` with family list,
// weight and slant, and `fm_pick` chooses per CHARACTER the face.
//
// In the Firn tree `metrics.fi` is the OLDER version with ONE face:
//
//     firn:    fm_advance(fm, size, cp)
//     certus:  fm_advance(fm, req, size, cp)   <- one argument more
//
// ==================================== WHY NOT THE NEW metrics.fi
//
// The obvious thing would be to port the newer file along. MEASURED, not
// presumed (13.09.2026): the new `metrics.fi` changes the signature of
// `fm_ascent`, `fm_descent`, `fm_advance` and `fm_kern`, and those are used
// in the Firn tree by
//
//     lib/fui/painter.fi        seven places
//     lib/layout/box.fi         five places
//     lib/browser/window_main.fi, b5_main.fi, lib/paint/b3_main.fi
//
// That is the text typesetting of the whole browser and the text layer of fUi.
// This round is to build in IMAGES AND SVG; it must not in doing so exchange
// the font selection of the tree -- the more so as a long
// Gauntlet is running on Certus in parallel and touches exactly these files.
//
// So: do NOT rebuild the foundation, but lay ONE file next to it that
// translates the new language to the old one. If the Firn tree one day adopts the new
// `metrics.fi`, this file can be deleted without replacement
// -- and `paint.fi` stays unchanged, because it speaks
// through here and not past it.
//
// THE NAME. At first the file was called `svg.metrics`, so that in `paint.fi` only
// the import line had to be swapped and every call `metrics.fm_...`
// stays literally standing (Firn knows no `import ... as ...`). That does
// NOT work: inside a module `metrics`, `metrics.` points to the module
// ITSELF, and `font.metrics` can then no longer be reached -- Firn
// resolves only the last member of a path. Hence `fontsel`, and the
// roughly twenty call sites in `paint.fi` are now called `fontsel.`.
//
// ============================================ WHAT IS LOST IN DOING SO
//
// HONESTLY NAMED, because a silent restriction is worse than a
// missing function:
//
//   * ONE FACE. `fm_pick` always returns the same face, no matter
//     which family, weight, slant the SVG demands.
//     `font-family` in a `<text>` is therefore not obeyed.
//   * NO FALLBACK PER CHARACTER. If the loaded font has no character,
//     the position stays empty, instead of searching in a second font.
//   * NO SYNTHETIC BOLD, NO SYNTHETIC SLANT (SY_BOLD / SY_ITALIC).
//
// FOR SYMBOLS THAT IS IRRELEVANT, and that is the point: a symbol
// is a PATH. A `<text>` in a symbol is anyway the exception
// that you convert to paths in the drawing program -- lib/fui/icon.fi says
// exactly that in its head, and in the kernel profile there is no font at all (K1
// in core.fi). The nine geometric marks remain untouched by it.
import font.metrics
import font.ttf

export {
    FontReq, req_new, req_set_family, req_family_count,
    fm_advance, fm_ascent, fm_descent, fm_kern,
    fm_pick, fm_face_of,
    PICK_NONE, REQ_FAMILIES,
}

// The request is ACCEPTED and not evaluated. It
// stays as a record, so that `paint.fi` stays unchanged:
// it may call `req_set_family`, it just has no effect here.
const REQ_FAMILIES: usize = 4

// The same value as in the Certus tree -- "no face found".
const PICK_NONE: u32 = 4294967295

struct FontReq {
    fam: [u32; 4],
    generic: u32,
    weight: u32,
    italic: u32,
}

#[no_gc]
fn req_new() -> FontReq {
    return FontReq { fam: [0; 4], generic: 0, weight: 400, italic: 0 }
}

#[no_gc]
fn req_set_family(r: *mut FontReq, i: usize, h: u32) {
    if i < REQ_FAMILIES {
        (*r).fam[i] = h
    }
}

#[no_gc]
fn req_family_count(r: *mut FontReq) -> usize {
    var i: usize = 0
    while i < REQ_FAMILIES {
        if (*r).fam[i] == 0 as u32 {
            return i
        }
        i = i + 1
    }
    return REQ_FAMILIES
}

// ---- the four dimensions: the request is discarded, the rest passed on.

#[no_gc]
fn fm_advance(fm: u64, r: *mut FontReq, size: f64, cp: u32) -> f64 {
    return metrics.fm_advance(fm, size, cp)
}

#[no_gc]
fn fm_ascent(fm: u64, r: *mut FontReq, size: f64) -> f64 {
    return metrics.fm_ascent(fm, size)
}

#[no_gc]
fn fm_descent(fm: u64, r: *mut FontReq, size: f64) -> f64 {
    return metrics.fm_descent(fm, size)
}

#[no_gc]
fn fm_kern(fm: u64, r: *mut FontReq, size: f64, a: u32, b: u32) -> f64 {
    return metrics.fm_kern(fm, size, a, b)
}

// ---- the face choice: there is exactly one.

// 0 means "the first (and only) face". `paint.fi` compares the
// return value with `& 65535` against itself, to allow kerning only WITHIN
// one face; with a constant value that is always
// true, and that is right -- there is only the one.
#[no_gc]
fn fm_pick(fm: u64, r: *mut FontReq, cp: u32) -> u32 {
    if fm == 0 {
        return PICK_NONE
    }
    return 0 as u32
}

#[no_gc]
fn fm_face_of(fm: u64, pick: u32) -> *mut ttf.Font {
    return metrics.fontset_font(fm)
}
