// Herkunft: Certus, lib/svg/ (zuletzt geaendert in Certus-Commit 8f138f02), nach Firn
// portiert in 0e1a1196; vom alleinigen Urheber Justin am 25.09.2026 fuer Firn
// unter MPL-2.0 freigegeben.
// lib/svg/svg_main.fi -- EINE SVG-DATEI HINEIN, EIN BILD HERAUS.
//
// Das Werkzeug, an dem der SVG-Maler gemessen wird. Es startet keinen
// Browser, liest kein HTML und braucht kein Stilblatt: es nimmt eine
// `.svg`-Datei und legt dieselben Bildpunkte hin, die auch auf einer Seite
// entstuenden. Damit laesst sich das Ergebnis Bildpunkt fuer Bildpunkt
// gegen Chromium halten (tools/graphics/chrome_svg.py), ohne dass der Rest
// des Browsers im Spiel ist.
//
// Das Auftragsformat auf der Standardeingabe (klein-endig):
//     u32  Breite            0 = die eigene Groesse der Datei nehmen
//     u32  Hoehe             0 = dito
//     u32  n ; u8[n]         die SVG-Datei
//     u32  n ; u8[n]         eine TrueType-Datei, n = 0 fuer keine
//     u32  flags             1 = PNG statt PPM, 2 = Bericht auf stderr
//
// Die Antwort auf der Standardausgabe ist das Bild. Mit Flag 2 kommt auf
// die Standardfehlerausgabe:
//     KNOTEN <n>      wieviele Knoten der Baum hat
//     FEHLER <n>      wieviele Stellen der Zerteiler ausbessern musste
//     TINTE <n>       wieviele Bildpunkte wirklich gesetzt wurden
//     US <n>          Mikrosekunden fuer Zerteilen und Malen zusammen
//     GROESSE <w> <h> die verwendete Bildgroesse
//
// Uebersetzen mit:  firnc -o build/svg lib/svg/svg_main.fi
import html.mem
import font.metrics
import paint.canvas
import paint.png
import svg.paint
import svg.xml

const MAX_BILD: usize = 4096

// Die Uhr. `clock_gettime(CLOCK_MONOTONIC)` -- Nummer 228 auf x86-64,
// dieselbe wie in lib/paint/b3_main.fi.
#[no_gc]
fn micros() -> u64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return (ts[0] as u64) * 1000000 + (ts[1] as u64) / 1000
}

#[no_gc]
fn lies_u32(b: *mut mem.Buf, off: usize) -> u32 {
    if off + 4 > mem.buf_len(b) {
        return 0 as u32
    }
    let p: u64 = mem.buf_ptr(b) as u64
    return *((p + off as u64) as *mut u32)
}

fn main() -> i32 {
    var inb: mem.Buf = mem.buf_new()
    mem.read_all_stdin(&inb)
    let n: usize = mem.buf_len(&inb)
    if n < 20 {
        return 1
    }
    var off: usize = 0
    let bw_in: u32 = lies_u32(&inb, 0)
    let bh_in: u32 = lies_u32(&inb, 4)
    off = 8
    let svg_n: usize = lies_u32(&inb, off) as usize
    off = off + 4
    let svg_at: usize = off
    off = off + svg_n
    var font_n: usize = 0
    var font_at: usize = 0
    if off + 4 <= n {
        font_n = lies_u32(&inb, off) as usize
        off = off + 4
        font_at = off
        off = off + font_n
    }
    var flags: u32 = 0
    if off + 4 <= n {
        flags = lies_u32(&inb, off)
        off = off + 4
    }
    if svg_at + svg_n > n {
        return 1
    }
    let t0: u64 = micros()
    let quelle: u64 = (mem.buf_ptr(&inb) as u64) + svg_at as u64

    var baum: xml.Baum = xml.baum_neu()
    xml.baum_init(&baum)
    if !xml.zerteile_xml(&baum, quelle, svg_n) {
        return 2
    }
    // Die Bildgroesse: entweder vorgegeben oder die eigene der Datei.
    var bw: f64 = bw_in as f64
    var bh: f64 = bh_in as f64
    if bw_in == 0 as u32 || bh_in == 0 as u32 {
        var nw: f64 = 300.0
        var nh: f64 = 150.0
        let ok: bool = paint.svg_groesse(&baum, &nw, &nh)
        if bw_in == 0 as u32 {
            bw = nw
        }
        if bh_in == 0 as u32 {
            bh = nh
        }
    }
    var w: usize = (bw + 0.5) as usize
    var h: usize = (bh + 0.5) as usize
    if w < 1 {
        w = 1
    }
    if h < 1 {
        h = 1
    }
    if w > MAX_BILD {
        w = MAX_BILD
    }
    if h > MAX_BILD {
        h = MAX_BILD
    }

    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, w, h) {
        return 3
    }
    // WEISS UND UNDURCHSICHTIG. Ein SVG hat keinen Hintergrund; damit die
    // Bilder mit denen von Chromium vergleichbar sind, wird derselbe
    // weisse Grund gelegt, den ein Browserfenster hat.
    canvas.canvas_clear(&cv, 4294967295 as u32)

    var fs: metrics.FontSet = metrics.fontset_new()
    var fm: u64 = 0
    if font_n > 0 && font_at + font_n <= n {
        if metrics.fontset_load(&fs,
            ((mem.buf_ptr(&inb) as u64 + font_at as u64) as *mut u8),
            font_n) {
            fm = (&fs) as u64
        }
    }

    var m: paint.Maler = paint.maler_neu()
    if !paint.maler_init(&m, &cv) {
        return 4
    }
    paint.maler_setze_schrift(&m, fm)
    paint.male_baum(&m, &baum, 0.0, 0.0, w as f64, h as f64)
    let t1: u64 = micros()

    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if (flags & (1 as u32)) != 0 as u32 {
        let ok: bool = png.write_png(&cv, &out)
    } else {
        png.write_ppm(&cv, &out)
    }
    mem.buf_flush(&out, 1)

    if (flags & (2 as u32)) != 0 as u32 {
        var rep: mem.Buf = mem.buf_new()
        mem.buf_init(&rep)
        var k1: [u8; 7] = "KNOTEN "
        var i: usize = 0
        while i < 7 {
            mem.buf_push(&rep, k1[i])
            i = i + 1
        }
        mem.buf_push_dec(&rep, xml.knoten_anzahl(&baum) as u64)
        mem.buf_push(&rep, 10 as u8)
        var k2: [u8; 7] = "FEHLER "
        i = 0
        while i < 7 {
            mem.buf_push(&rep, k2[i])
            i = i + 1
        }
        mem.buf_push_dec(&rep, xml.baum_fehler(&baum) as u64)
        mem.buf_push(&rep, 10 as u8)
        var k3: [u8; 6] = "TINTE "
        i = 0
        while i < 6 {
            mem.buf_push(&rep, k3[i])
            i = i + 1
        }
        mem.buf_push_dec(&rep, paint.maler_tinte(&m))
        mem.buf_push(&rep, 10 as u8)
        var k4: [u8; 3] = "US "
        i = 0
        while i < 3 {
            mem.buf_push(&rep, k4[i])
            i = i + 1
        }
        mem.buf_push_dec(&rep, t1 - t0)
        mem.buf_push(&rep, 10 as u8)
        var k5: [u8; 8] = "GROESSE "
        i = 0
        while i < 8 {
            mem.buf_push(&rep, k5[i])
            i = i + 1
        }
        mem.buf_push_dec(&rep, w as u64)
        mem.buf_push(&rep, 32 as u8)
        mem.buf_push_dec(&rep, h as u64)
        mem.buf_push(&rep, 10 as u8)
        mem.buf_flush(&rep, 2)
    }
    paint.maler_frei(&m)
    canvas.canvas_free(&cv)
    xml.baum_frei(&baum)
    return 0
}
