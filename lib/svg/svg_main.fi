// SPDX-License-Identifier: MPL-2.0
// Provenance: Certus, lib/svg/ (last changed in Certus commit 8f138f02), ported to
// Firn in 0e1a1196; released by the sole author Justin on 25.09.2026 for Firn
// under MPL-2.0.
// lib/svg/svg_main.fi -- AN SVG FILE IN, AN IMAGE OUT.
//
// The tool against which the SVG painter is measured. It starts no
// browser, reads no HTML and needs no style sheet: it takes an
// `.svg` file and lays down the same pixels that would also arise on a page.
// With that the result can be held pixel for pixel
// against Chromium (tools/graphics/chrome_svg.py), without the rest
// of the browser being involved.
//
// The job format on standard input (little-endian):
//     u32  width             0 = take the own size of the file
//     u32  height            0 = ditto
//     u32  n ; u8[n]         the SVG file
//     u32  n ; u8[n]         a TrueType file, n = 0 for none
//     u32  flags             1 = PNG instead of PPM, 2 = report on stderr
//
// The answer on standard output is the image. With flag 2 there comes on
// standard error:
//     NODES <n>       how many nodes the tree has
//     ERRORS <n>      how many places the parser had to repair
//     INK <n>          how many pixels were really set
//     US <n>          microseconds for parsing and painting together
//     SIZE <w> <h>    the image size used
//
// Translate with:  firnc -o build/svg lib/svg/svg_main.fi
import html.mem
import font.metrics
import paint.canvas
import paint.png
import svg.paint
import svg.svgxml

const MAX_IMAGE: usize = 4096

// The clock. `clock_gettime(CLOCK_MONOTONIC)` -- number 228 on x86-64,
// the same as in lib/paint/b3_main.fi.
#[no_gc]
fn micros() -> u64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return (ts[0] as u64) * 1000000 + (ts[1] as u64) / 1000
}

#[no_gc]
fn read_u32(b: *mut mem.Buf, off: usize) -> u32 {
    if off + 4 > mem.buf_len(b) {
        return 0 as u32
    }
    let p: u64 = mem.buf_ptr(b) as u64
    return *((p + off as u64) as *mut u32)
}

fn main() -> i32 {
    var inb: mem.Buf = mem.buf_new()
    mem.read_all_stdin(&inb)
    let n: usize = mem.buf_len(&inb)
    if n < 20 {
        return 1
    }
    var off: usize = 0
    let bw_in: u32 = read_u32(&inb, 0)
    let bh_in: u32 = read_u32(&inb, 4)
    off = 8
    let svg_n: usize = read_u32(&inb, off) as usize
    off = off + 4
    let svg_at: usize = off
    off = off + svg_n
    var font_n: usize = 0
    var font_at: usize = 0
    if off + 4 <= n {
        font_n = read_u32(&inb, off) as usize
        off = off + 4
        font_at = off
        off = off + font_n
    }
    var flags: u32 = 0
    if off + 4 <= n {
        flags = read_u32(&inb, off)
        off = off + 4
    }
    if svg_at + svg_n > n {
        return 1
    }
    let t0: u64 = micros()
    let source: u64 = (mem.buf_ptr(&inb) as u64) + svg_at as u64

    var tree: svgxml.Tree = svgxml.tree_new()
    svgxml.tree_init(&tree)
    if !svgxml.split_xml(&tree, source, svg_n) {
        return 2
    }
    // The image size: either given or the own one of the file.
    var bw: f64 = bw_in as f64
    var bh: f64 = bh_in as f64
    if bw_in == 0 as u32 || bh_in == 0 as u32 {
        var nw: f64 = 300.0
        var nh: f64 = 150.0
        let ok: bool = paint.svg_size(&tree, &nw, &nh)
        if bw_in == 0 as u32 {
            bw = nw
        }
        if bh_in == 0 as u32 {
            bh = nh
        }
    }
    var w: usize = (bw + 0.5) as usize
    var h: usize = (bh + 0.5) as usize
    if w < 1 {
        w = 1
    }
    if h < 1 {
        h = 1
    }
    if w > MAX_IMAGE {
        w = MAX_IMAGE
    }
    if h > MAX_IMAGE {
        h = MAX_IMAGE
    }

    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, w, h) {
        return 3
    }
    // WHITE AND OPAQUE. An SVG has no background; so that the
    // images are comparable with those of Chromium, the same
    // white background is laid that a browser window has.
    canvas.canvas_clear(&cv, 4294967295 as u32)

    var fs: metrics.FontSet = metrics.fontset_new()
    var fm: u64 = 0
    if font_n > 0 && font_at + font_n <= n {
        if metrics.fontset_load(&fs,
            ((mem.buf_ptr(&inb) as u64 + font_at as u64) as *mut u8),
            font_n) {
            fm = (&fs) as u64
        }
    }

    var m: paint.Painter = paint.painter_new()
    if !paint.painter_init(&m, &cv) {
        return 4
    }
    paint.painter_set_font(&m, fm)
    paint.times_tree(&m, &tree, 0.0, 0.0, w as f64, h as f64)
    let t1: u64 = micros()

    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if (flags & (1 as u32)) != 0 as u32 {
        let ok: bool = png.write_png(&cv, &out)
    } else {
        png.write_ppm(&cv, &out)
    }
    mem.buf_flush(&out, 1)

    if (flags & (2 as u32)) != 0 as u32 {
        var rep: mem.Buf = mem.buf_new()
        mem.buf_init(&rep)
        var k1: [u8; 6] = "NODES "
        var i: usize = 0
        while i < 6 {
            mem.buf_push(&rep, k1[i])
            i = i + 1
        }
        mem.buf_push_dec(&rep, svgxml.node_count(&tree) as u64)
        mem.buf_push(&rep, 10 as u8)
        var k2: [u8; 7] = "ERRORS "
        i = 0
        while i < 7 {
            mem.buf_push(&rep, k2[i])
            i = i + 1
        }
        mem.buf_push_dec(&rep, svgxml.tree_error(&tree) as u64)
        mem.buf_push(&rep, 10 as u8)
        var k3: [u8; 4] = "INK "
        i = 0
        while i < 4 {
            mem.buf_push(&rep, k3[i])
            i = i + 1
        }
        mem.buf_push_dec(&rep, paint.painter_ink(&m))
        mem.buf_push(&rep, 10 as u8)
        var k4: [u8; 3] = "US "
        i = 0
        while i < 3 {
            mem.buf_push(&rep, k4[i])
            i = i + 1
        }
        mem.buf_push_dec(&rep, t1 - t0)
        mem.buf_push(&rep, 10 as u8)
        var k5: [u8; 5] = "SIZE "
        i = 0
        while i < 5 {
            mem.buf_push(&rep, k5[i])
            i = i + 1
        }
        mem.buf_push_dec(&rep, w as u64)
        mem.buf_push(&rep, 32 as u8)
        mem.buf_push_dec(&rep, h as u64)
        mem.buf_push(&rep, 10 as u8)
        mem.buf_flush(&rep, 2)
    }
    paint.painter_free(&m)
    canvas.canvas_free(&cv)
    svgxml.tree_free(&tree)
    return 0
}
