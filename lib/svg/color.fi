// ------------------------------------------------------- Zahlen und Anteile

#[no_gc]
fn hexwert(c: u32) -> i32 {
    if c >= 48 && c <= 57 {
        return (c - 48) as i32
    }
    if c >= 97 && c <= 102 {
        return (c - 97 + 10) as i32
    }
    if c >= 65 && c <= 70 {
        return (c - 65 + 10) as i32
    }
    return 0 - 1
}

#[no_gc]
fn klemme255(v: f64) -> u32 {
    if v != v {
        return 0 as u32
    }
    if v <= 0.0 {
        return 0 as u32
    }
    if v >= 255.0 {
        return 255 as u32
    }
    return (v + 0.5) as u32
}

// Eine Zahl, die auch mit `%` enden darf. `voll` sagt, wofuer 100 %
// steht -- 255 bei einem Farbkanal, 1 bei einer Deckung.
#[no_gc]
fn lies_zahl_oder_prozent(p: u64, n: usize, i: *mut usize, voll: f64,
    ok: *mut bool) -> f64 {
    matrix.ueberspringe_leer(p, n, i)
    var v: f64 = matrix.zahl(p, n, i, ok)
    if !*ok {
        return 0.0
    }
    if *i < n && matrix.lies_oktett(p, *i) == 37 {
        *i = *i + 1
        v = v * voll / 100.0
    }
    return v
}

// Die Deckung eines `fill-opacity`/`stroke-opacity`/`opacity`: eine Zahl
// zwischen 0 und 1, auch als Prozent. Ausserhalb wird geklemmt, wie es
// css-color-4 verlangt.
#[no_gc]
fn lies_deckung(p: u64, a: usize, n: usize, ok: *mut bool) -> f64 {
    var i: usize = a
    let ende: usize = a + n
    let v: f64 = lies_zahl_oder_prozent(p, ende, &i, 1.0, ok)
    if !*ok {
        return 1.0
    }
    if v < 0.0 {
        return 0.0
    }
    if v > 1.0 {
        return 1.0
    }
    return v
}

// hsl nach rgb, css-color-4 Abschnitt 7. `h` in Grad, `s` und `l` als
// Anteile zwischen 0 und 1.
#[no_gc]
fn hsl_kanal(m1: f64, m2: f64, h_in: f64) -> f64 {
    var h: f64 = h_in
    while h < 0.0 {
        h = h + 360.0
    }
    while h >= 360.0 {
        h = h - 360.0
    }
    if h < 60.0 {
        return m1 + (m2 - m1) * h / 60.0
    }
    if h < 180.0 {
        return m2
    }
    if h < 240.0 {
        return m1 + (m2 - m1) * (240.0 - h) / 60.0
    }
    return m1
}

// ---------------------------------------------------------- Der Farbleser

#[no_gc]
fn ist_wort(p: u64, a: usize, n: usize, w: u64, wn: usize) -> bool {
    if n != wn {
        return false
    }
    var i: usize = 0
    while i < n {
        if klein(matrix.lies_oktett(p, a + i)) != klein(matrix.lies_oktett(w, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

// Der ganze Wert einer Malstelle. `p` zeigt auf den Text, `a`/`n` sind
// Anfang und Laenge; Leerraum an beiden Enden wird abgeschnitten.
//
// Bei `url(#name)` kommt `F_VERWEIS` heraus, und `va`/`vn` zeigen auf den
// Namen OHNE das Doppelkreuz. Steht hinter dem `url()` noch eine
// Ersatzfarbe (`url(#g) red`), wird sie in `*out` gelegt -- die
// Spezifikation verlangt genau das fuer den Fall, dass der Verweis ins
// Leere geht.
#[no_gc]
fn lies_farbe(p: u64, a_in: usize, n_in: usize, out: *mut u32,
    va: *mut usize, vn: *mut usize) -> u32 {
    var a: usize = a_in
    var n: usize = n_in
    while n > 0 && matrix.ist_leer(matrix.lies_oktett(p, a)) {
        a = a + 1
        n = n - 1
    }
    while n > 0 && matrix.ist_leer(matrix.lies_oktett(p, a + n - 1)) {
        n = n - 1
    }
    *out = 4278190080 as u32
    *va = 0
    *vn = 0
    if n == 0 {
        return F_KEINE
    }
    let c0: u32 = matrix.lies_oktett(p, a)
    // ---- #rgb, #rgba, #rrggbb, #rrggbbaa
    if c0 == 35 {
        let m: usize = n - 1
        if m != 3 && m != 4 && m != 6 && m != 8 {
            return F_KEINE
        }
        var d: [i32; 8] = [0; 8]
        var i: usize = 0
        while i < m {
            let v: i32 = hexwert(matrix.lies_oktett(p, a + 1 + i))
            if v < 0 {
                return F_KEINE
            }
            d[i] = v
            i = i + 1
        }
        var r: u32 = 0 as u32
        var g: u32 = 0 as u32
        var b: u32 = 0 as u32
        var al: u32 = 255 as u32
        if m == 3 || m == 4 {
            r = (d[0] * 17) as u32
            g = (d[1] * 17) as u32
            b = (d[2] * 17) as u32
            if m == 4 {
                al = (d[3] * 17) as u32
            }
        } else {
            r = (d[0] * 16 + d[1]) as u32
            g = (d[2] * 16 + d[3]) as u32
            b = (d[4] * 16 + d[5]) as u32
            if m == 8 {
                al = (d[6] * 16 + d[7]) as u32
            }
        }
        *out = (al << 24) | (r << 16) | (g << 8) | b
        return F_FARBE
    }
    // ---- die drei Schluesselwoerter
    var wnone: [u8; 4] = "none"
    if ist_wort(p, a, n, (&wnone[0]) as u64, 4) {
        return F_KEINE
    }
    var wtr: [u8; 11] = "transparent"
    if ist_wort(p, a, n, (&wtr[0]) as u64, 11) {
        *out = 0 as u32
        return F_FARBE
    }
    var wcc: [u8; 12] = "currentColor"
    if ist_wort(p, a, n, (&wcc[0]) as u64, 12) {
        return F_AKTUELL
    }
    // ---- url(#name)
    var wurl: [u8; 4] = "url("
    if n > 4 && ist_wort(p, a, 4, (&wurl[0]) as u64, 4) {
        var i: usize = a + 4
        let ende: usize = a + n
        matrix.ueberspringe_leer(p, ende, &i)
        // Ein Anfuehrungszeichen ist erlaubt.
        var q: u32 = 0
        if i < ende && (matrix.lies_oktett(p, i) == 34
            || matrix.lies_oktett(p, i) == 39) {
            q = matrix.lies_oktett(p, i)
            i = i + 1
        }
        if i < ende && matrix.lies_oktett(p, i) == 35 {
            i = i + 1
            let s: usize = i
            while i < ende && matrix.lies_oktett(p, i) != 41
                && matrix.lies_oktett(p, i) != q
                && !matrix.ist_leer(matrix.lies_oktett(p, i)) {
                i = i + 1
            }
            *va = s
            *vn = i - s
            // Eine Ersatzfarbe hinter der Klammer?
            while i < ende && matrix.lies_oktett(p, i) != 41 {
                i = i + 1
            }
            if i < ende {
                i = i + 1
            }
            matrix.ueberspringe_leer(p, ende, &i)
            if i < ende {
                var ea: usize = 0
                var en: usize = 0
                let art: u32 = lies_farbe(p, i, ende - i, out, &ea, &en)
                if art != F_FARBE {
                    *out = 4278190080 as u32
                }
            }
            return F_VERWEIS
        }
        return F_KEINE
    }
    // ---- rgb() / rgba() / hsl() / hsla()
    var wrgb: [u8; 3] = "rgb"
    var whsl: [u8; 3] = "hsl"
    let ist_rgb: bool = n > 4 && ist_wort(p, a, 3, (&wrgb[0]) as u64, 3)
    let ist_hsl: bool = n > 4 && ist_wort(p, a, 3, (&whsl[0]) as u64, 3)
    if ist_rgb || ist_hsl {
        var i: usize = a + 3
        let ende: usize = a + n
        if i < ende && klein(matrix.lies_oktett(p, i)) == 97 {
            i = i + 1
        }
        if i >= ende || matrix.lies_oktett(p, i) != 40 {
            return F_KEINE
        }
        i = i + 1
        var ok: bool = false
        var z: [f64; 4] = [0.0; 4]
        var k: usize = 0
        var alpha: f64 = 1.0
        while k < 4 {
            matrix.ueberspringe_trenner(p, ende, &i)
            if i < ende && matrix.lies_oktett(p, i) == 41 {
                break
            }
            // Ein Schraegstrich trennt in der neuen Schreibweise die
            // Deckung ab: `rgb(1 2 3 / 0.5)`.
            if i < ende && matrix.lies_oktett(p, i) == 47 {
                i = i + 1
                matrix.ueberspringe_leer(p, ende, &i)
            }
            var voll: f64 = 255.0
            if k == 3 {
                voll = 1.0
            }
            if ist_hsl && k > 0 && k < 3 {
                voll = 1.0
            }
            if ist_hsl && k == 0 {
                voll = 360.0
            }
            let v: f64 = lies_zahl_oder_prozent(p, ende, &i, voll, &ok)
            if !ok {
                return F_KEINE
            }
            z[k] = v
            k = k + 1
        }
        if k < 3 {
            return F_KEINE
        }
        if k == 4 {
            alpha = z[3]
            if alpha < 0.0 {
                alpha = 0.0
            }
            if alpha > 1.0 {
                alpha = 1.0
            }
        }
        var r: f64 = 0.0
        var g: f64 = 0.0
        var b: f64 = 0.0
        if ist_hsl {
            var s: f64 = z[1]
            var l: f64 = z[2]
            if s < 0.0 {
                s = 0.0
            }
            if s > 1.0 {
                s = 1.0
            }
            if l < 0.0 {
                l = 0.0
            }
            if l > 1.0 {
                l = 1.0
            }
            var m2: f64 = l * (s + 1.0)
            if l > 0.5 {
                m2 = l + s - l * s
            }
            let m1: f64 = l * 2.0 - m2
            r = hsl_kanal(m1, m2, z[0] + 120.0) * 255.0
            g = hsl_kanal(m1, m2, z[0]) * 255.0
            b = hsl_kanal(m1, m2, z[0] - 120.0) * 255.0
        } else {
            r = z[0]
            g = z[1]
            b = z[2]
        }
        *out = (klemme255(alpha * 255.0) << 24) | (klemme255(r) << 16)
            | (klemme255(g) << 8) | klemme255(b)
        return F_FARBE
    }
    // ---- ein Name
    var ok2: bool = false
    let v: u32 = name_farbe(p, a, n, &ok2)
    if ok2 {
        *out = v
        return F_FARBE
    }
    return F_KEINE
}
