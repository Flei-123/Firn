// SPDX-License-Identifier: GPL-2.0-only
// lib/svg/farbe.fi -- FARBEN aus rohem Text.
//
// SVG erlaubt an einer Malstelle (`fill`, `stroke`, `stop-color`,
// `flood-color`) genau das, was CSS erlaubt: `#rgb`, `#rrggbb`, `#rgba`,
// `#rrggbbaa`, `rgb()`, `rgba()`, `hsl()`, `hsla()`, die 148 Namen und
// die drei Schluesselwoerter `none`, `transparent`, `currentColor`.
//
// WARUM NICHT lib/css. Der Farbleser dort (`cascade.named_color`) arbeitet
// auf ZERTEILTEN CSS-Werten (`Gc[Cv]`), also auf dem Ergebnis des
// CSS-Tokenizers. Ein SVG-Attribut ist aber eine ROHE Zeichenkette, die
// nirgends durch den CSS-Tokenizer gelaufen ist, und lib/css gehoert in
// dieser Runde einer anderen Baustelle (LAYOUT2). Diese Datei liest darum
// direkt aus einem Oktettfeld und fasst lib/css nicht an.
//
// DIE NAMENSTABELLE ist ein FNV-1a-Streuwert ueber den kleingeschriebenen
// Namen, zusammen mit der LAENGE, dem ERSTEN und dem LETZTEN Zeichen. Alle
// vier muessen passen. Der Grund fuer die drei Zusatzangaben ist Ehrlichkeit:
// ein reiner 32-Bit-Streuwert koennte theoretisch auch von einem
// UNGUELTIGEN Wort getroffen werden, und dann bekaeme eine kaputte Seite
// still eine Farbe statt eines Fehlers. Mit Laenge, Anfang und Ende
// zusammen ist das praktisch ausgeschlossen. Dass die 148 echten Namen
// untereinander kollisionsfrei sind, ist beim Erzeugen dieser Datei
// geprueft worden (tools/graphics/pruefe_farben.py faehrt es nach).
//
// Der Rueckgabewert ist immer ein `u32` als `0xAARRGGBB` -- dieselbe
// Kodierung wie in lib/paint/canvas.fi, damit zwischen hier und dem Malen
// keine Umrechnung liegt.
import svg.matrix

export {
    F_KEINE, F_FARBE, F_AKTUELL, F_VERWEIS,
    lies_farbe, name_farbe, streu_name,
    lies_zahl_oder_prozent, lies_deckung,
}

// Was an einer Malstelle stehen kann.
const F_KEINE: u32 = 0 // `none` -- es wird NICHT gemalt
const F_FARBE: u32 = 1 // eine Farbe, in `*out`
const F_AKTUELL: u32 = 2 // `currentColor` -- der Aufrufer setzt sie ein
const F_VERWEIS: u32 = 3 // `url(#name)` -- ein Verlauf oder ein Muster

#[no_gc]
fn klein(c: u32) -> u32 {
    if c >= 65 && c <= 90 {
        return c + 32
    }
    return c
}

// FNV-1a ueber den kleingeschriebenen Namen.
//
// GERECHNET WIRD IN `u64`, und das ist kein Schoenheitsfehler: seit Runde
// 72 panikt `*` bei einem Ueberlauf, und FNV LEBT vom Ueberlauf -- die
// Multiplikation mit 16777619 laeuft in `u32` bei fast jedem Zeichen
// ueber. In `u64` gerechnet und danach auf 32 Bit abgeschnitten kommt
// genau derselbe Streuwert heraus wie bei der ueblichen umlaufenden
// Fassung, ohne dass irgendwo eine Pruefung abgeschaltet werden muss.
#[no_gc]
fn streu_name(p: u64, a: usize, n: usize) -> u32 {
    var v: u64 = 2166136261
    var i: usize = 0
    while i < n {
        v = (v ^ (klein(matrix.lies_oktett(p, a + i)) as u64)) & 4294967295
        v = (v * 16777619) & 4294967295
        i = i + 1
    }
    return v as u32
}

// Der Wert eines Namens, oder 0, wenn es keiner ist (`ok` sagt es).
#[no_gc]
fn name_farbe(p: u64, a: usize, n: usize, ok: *mut bool) -> u32 {
    *ok = false
    if n < 3 || n > 20 {
        return 0 as u32
    }
    let h: u32 = streu_name(p, a, n)
    let e: u32 = klein(matrix.lies_oktett(p, a))
    let z: u32 = klein(matrix.lies_oktett(p, a + n - 1))
    if h == 18738364 as u32 && n == 5 && e == 103 && z == 110 {
        *ok = true
        return (4278190080 as u32) | (32768 as u32) // green
    }
