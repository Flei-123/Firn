const S_CARDS: u64 = 2544
const S_CARDON: u64 = 2552
const S_CARDBASE: u64 = 2560
const S_CARDVIOL: u64 = 2568
const S_CARDCHK: u64 = 2576
const S_CARDINFO: u64 = 2584
const S_CARDRUNS: u64 = 2592
const S_CARDINFO2: u64 = 2600
const CARD_SHIFT: u64 = 9
const CARD_MASK: u64 = 1048575
const CARD_BYTES: u64 = 1048576

fn __gc_card_fill(t: u64, v: u64) {
    var i: u64 = 0
    while i < CARD_BYTES {
        __gc_st64(t + i, v)
        i = i + 8
    }
}

fn gc_cards_enable() -> bool {
    let st: u64 = __gc_state() as u64
    if __gc_ld64(st + S_CARDON) != 0 {
        return true
    }
    if __gc_ld64(st + S_MULTI) != 0 {
        return false
    }
    var t: u64 = __gc_ld64(st + S_CARDS)
    if t == 0 {
        t = __gc_mmap(CARD_BYTES)
        if t == 0 {
            return false
        }
        __gc_st64(st + S_CARDS, t)
    }
    __gc_card_fill(t, 72340172838076673)
    __gc_st64(st + S_CARDBASE, __gc_ld64(st + S_SERIES))
    __gc_st64(st + S_CARDVIOL, 0)
    __gc_st64(st + S_CARDCHK, 0)
    __gc_st64(st + S_CARDINFO, 0)
    __gc_st64(st + S_CARDRUNS, 0)
    __gc_st64(st + S_CARDON, 1)
    return true
}

fn gc_cards_diag(k: u64) -> u64 {
    let st: u64 = __gc_state() as u64
    if k == 0 {
        return __gc_ld64(st + S_CARDON)
    }
    if k == 1 {
        return __gc_ld64(st + S_CARDVIOL)
    }
    if k == 2 {
        return __gc_ld64(st + S_CARDCHK)
    }
    if k == 3 {
        return __gc_ld64(st + S_CARDINFO)
    }
    if k == 4 {
        return __gc_ld64(st + S_CARDRUNS)
    }
    return __gc_ld64(st + S_CARDINFO2)
}

fn __gc_card_mark(st: u64, field: u64) {
    let t: u64 = __gc_ld64(st + S_CARDS)
    *((t +% ((field >> CARD_SHIFT) & CARD_MASK)) as *mut u8) = 1 as u8
}

fn __gc_card_check(st: u64, t: u64, owner_tid: u64, obj: u64, fa: u64, base: u64, hlo: u64, hhi: u64) {
    let v: u64 = __gc_ld64(fa)
    if v < hlo || v >= hhi {
        return
    }
    let y: u64 = __gc_block_of(v)
    if y == 0 || __gc_ld32(y) == 0 {
        return
    }
    if __gc_ld64(y + 8) <= base {
        return
    }
    __gc_st64(st + S_CARDCHK, __gc_ld64(st + S_CARDCHK) + 1)
    let card: u64 = (*((t +% ((fa >> CARD_SHIFT) & CARD_MASK)) as *mut u8)) as u64
    if card == 0 {
        if __gc_ld64(st + S_CARDVIOL) == 0 {
            __gc_st64(st + S_CARDINFO, owner_tid | (__gc_ld32(y) as u64) << 32)
            __gc_st64(st + S_CARDINFO2, ((fa - obj) & 4095) | (((base - __gc_ld64(obj - HEADER + 8)) & 67108863) << 12) | (((__gc_ld64(y + 8) - base) & 67108863) << 38))
        }
        __gc_st64(st + S_CARDVIOL, __gc_ld64(st + S_CARDVIOL) + 1)
    }
}

fn __gc_card_scan_block(st: u64, t: u64, b: u64, base: u64, hlo: u64, hhi: u64) {
    let tid: u64 = __gc_ld32(b) as u64
    let zw: u32 = __gc_ld32(b + 4)
    if (zw & F_WART) != 0 {
        return
    }
    if __gc_ld64(b + 8) > base {
        return
    }
    let obj: u64 = b + HEADER
    if (zw & F_SLOTS) != 0 {
        let n: u64 = __gc_ld64(obj)
        let desc: u64 = __gc_ld64(obj + 8)
        let mask: u64 = desc >> 8
        let step: u64 = desc & 255
        if mask == 0 {
            return
        }
        var i: u64 = 0
        while i < n {
            var j: u64 = 0
            while j < step {
                if ((mask >> j) & 1) != 0 {
                    __gc_card_check(st, t, tid, obj, obj + SLOT_HEADER + (i * step + j) * 8, base, hlo, hhi)
                }
                j = j + 1
            }
            i = i + 1
        }
        return
    }
    let tab: u64 = __gc_ld64(st + S_TABLE)
    if tid > __gc_ld64(tab) {
        return
    }
    let entry: u64 = tab + 8 + (tid - 1) * 64
    let n: u64 = __gc_ld64(entry + 16)
    let offs: u64 = __gc_ld64(entry + 24)
    var i: u64 = 0
    while i < n {
        __gc_card_check(st, t, tid, obj, obj + __gc_ld64(offs + i * 8), base, hlo, hhi)
        i = i + 1
    }
}

fn __gc_cards_cycle_end(st: u64) {
    let t: u64 = __gc_ld64(st + S_CARDS)
    let base: u64 = __gc_ld64(st + S_CARDBASE)
    let hlo: u64 = __gc_ld64(st + S_HEAPLO)
    let hhi: u64 = __gc_ld64(st + S_HEAPHI)
    var c: u64 = __gc_ld64(st + S_CHUNKS)
    while c != 0 {
        let data: u64 = c + CHUNK_HEADER
        let block: u64 = __gc_ld64(c + 16)
        let count: u64 = __gc_ld64(c + 24)
        var i: u64 = 0
        while i < count {
            let b: u64 = data + i * block
            if __gc_ld32(b) != 0 {
                __gc_card_scan_block(st, t, b, base, hlo, hhi)
            }
            i = i + 1
        }
        c = __gc_ld64(c)
    }
    __gc_card_fill(t, 0)
    __gc_st64(st + S_CARDBASE, __gc_ld64(st + S_SERIES))
    __gc_st64(st + S_CARDRUNS, __gc_ld64(st + S_CARDRUNS) + 1)
}
