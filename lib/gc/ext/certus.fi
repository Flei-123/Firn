fn __gc_threads_scan() {
    let st: u64 = __gc_state() as u64
    if __gc_ld64(st +% S_MULTI) == 0 {
        return
    }
    let tab: u64 = __gc_ld64(st +% S_THREAD_TAB)
    if tab == 0 {
        return
    }
    let slf: u64 = __thread_tcb()
    let hi: u64 = __gc_ld64(st + S_THREAD_HI)
    var i: u64 = 0
    while i < hi {
        let t: u64 = tab + i * FT_BYTES
        let z: u64 = __gc_ld64(t +% FT_STATE)
        if t != slf && z != Z_FREE {
            __gc_scan(t + FT_REGS, t + FT_REGS + 48)
            __gc_scan(t + FT_RES, t + FT_RES + 8)
            if z != Z_DEAD {
                let sp: u64 = __gc_ld64(t +% FT_SP)
                let bottom: u64 = __gc_ld64(t +% FT_BOTTOM)
                if sp != 0 && bottom > sp && (__gc_ld64(t + FT_HOST) != 1 || __thread_stack_mapped(sp, bottom)) {
