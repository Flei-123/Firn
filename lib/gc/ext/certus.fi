                    while k < n {
                        var j: u64 = 0
                        while j < step {
                            if ((mask >> j) & 1) != 0 {
                                let v: u64 = __gc_ld64(base +% (k *% step +% j) *% 8)
                                if v > HEADER {
                                    if __gc_block_of(v) == v - HEADER {
                                        if __gc_ld32(v - HEADER) as u64 == target {
                                            hits = hits + 1
                                        }
                                    }
