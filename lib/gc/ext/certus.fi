fn thread_init() -> bool {
    let st: u64 = __gc_state() as u64
    if __gc_ld64(st +% S_THREAD_TAB) != 0 {
        return true
    }
    if __gc_ld64(st +% S_INIT) != 1 {
        if !gc_init() {
            return false
        }
    }
    let tab: u64 = __gc_mmap(THREAD_MAX * FT_BYTES)
    if tab == 0 {
        return false
    }
    __gc_st64(tab + FT_SELF, tab)
    __gc_st64(tab + FT_STATE, Z_LAUFEND)
    __gc_st64(tab + FT_BOTTOM, __gc_ld64(st + S_BOTTOM))
    __gc_st64(tab + FT_TID, __thread_gettid())
    __gc_st64(st + S_MAIN, tab)
    __gc_st64(st + S_THREAD_MAX, THREAD_MAX)
    __gc_st64(st + S_THREAD_HI, 1)
    __gc_st64(st + S_THREAD_N, 1)
    if __gc_ld64(st + S_STAPELN) == 0 {
        __gc_st64(st + S_STAPELN, STACK_BYTES)
    }
    if syscall(SYS_ARCH_PRCTL, ARCH_SET_FS, tab as i64, 0, 0, 0, 0) == THREAD_NO_SLOT {
        __gc_munmap(tab, THREAD_MAX * FT_BYTES)
        __gc_st64(st + S_MAIN, 0)
        __gc_st64(st + S_THREAD_HI, 0)
        __gc_st64(st + S_THREAD_N, 0)
        return false
    }
    __gc_st64(st + S_THREAD_TAB, tab)
    return true
}
