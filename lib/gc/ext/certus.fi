    var c: u64 = __gc_ld64(st + S_CHUNKS)
    while c != 0 {
        let next: u64 = __gc_ld64(c)
        let data: u64 = c + CHUNK_HEADER
        let block: u64 = __gc_ld64(c + 16)
        let count: u64 = __gc_ld64(c + 24)
        var i: u64 = 0
        while i < count {
            let b: u64 = data + i * block
            let tid: u64 = __gc_ld32(b) as u64
            if tid != 0 && tid <= __gc_ld64(tab) {
                if holder == 0 || tid == holder {
                    let obj: u64 = b + HEADER
                    let entry: u64 = tab + 8 + (tid - 1) * 64
                    let n: u64 = __gc_ld64(entry +% 16)
                    let offs: u64 = __gc_ld64(entry +% 24)
                    var k: u64 = 0
                    while k < n {
                        let z: u64 = __gc_ld64(obj +% __gc_ld64(offs +% k *% 8))
                        if z > HEADER && __gc_block_of(z) == z - HEADER {
                            if __gc_ld32(z - HEADER) as u64 == target {
                                hits = hits + 1
                            }
                        }
                        k = k + 1
                    }
                }
            }
            i = i + 1
        }
        c = next
    }
    return hits
}
fn gc_slot_refs_to(target: u64) -> u64 {
    let st: u64 = __gc_state() as u64
    var hits: u64 = 0
    var c: u64 = __gc_ld64(st +% S_CHUNKS)
    while c != 0 {
        let next: u64 = __gc_ld64(c)
        let data: u64 = c + CHUNK_HEADER
        let block: u64 = __gc_ld64(c +% 16)
        let count: u64 = __gc_ld64(c +% 24)
        var i: u64 = 0
        while i < count {
            let b: u64 = data + i * block
            let tid: u64 = __gc_ld32(b) as u64
            if tid != 0 && (__gc_ld32(b +% 4) & F_SLOTS) != 0 {
                let obj: u64 = b + HEADER
                let n: u64 = __gc_ld64(obj)
                let desc: u64 = __gc_ld64(obj +% 8)
                let mask: u64 = desc >> 8
                if mask != 0 {
                    let step: u64 = desc & 255
                    let base: u64 = obj + SLOT_HEADER
