const S_GP_CTL: u64 = 2536
const GCP_KIND: u64 = 4790
const GCP_MAXP: u64 = 8
const GCP_PAR_MIN: u64 = 2048
const GCP_DEQ_BYTES: u64 = 2097152
const GCP_DEQ_CAP: u64 = 262144
const GCP_DEQ_MASK: u64 = 262143
const GCP_HSTACK: u64 = 262144
const GCP_TAKE_MAX: u64 = 128
const GCP_GIVE_MAX: u64 = 128
const GCP_SPIN: u64 = 20000
const GCP_BURST_NS: u64 = 800000
const GCP_CTL_BYTES: u64 = 4096
const GCP_MASK32: u64 = 4294967295

const GPC_LOCK: u64 = 0
const GPC_GEN: u64 = 8
const GPC_OPEN: u64 = 16
const GPC_FIN: u64 = 24
const GPC_STOP: u64 = 32
const GPC_IDLE: u64 = 40
const GPC_PARTS: u64 = 48
const GPC_LEFT: u64 = 56
const GPC_SLEEP: u64 = 64
const GPC_DEADLINE: u64 = 72
const GPC_NHELP: u64 = 80
const GPC_WANT: u64 = 88
const GPC_BURST: u64 = 96
const GPC_D_BURSTS: u64 = 112
const GPC_D_STOPS: u64 = 120
const GPC_D_FINS: u64 = 128
const GPC_D_NS: u64 = 136
const GPC_D_OBJ_MAIN: u64 = 144
const GPC_D_OBJ_HELP: u64 = 152
const GPC_D_GIVES: u64 = 160
const GPC_D_OVF: u64 = 168
const GPC_D_SPAWNFAIL: u64 = 176
const GPC_D_JOINED: u64 = 184
const GPC_MIN: u64 = 192
const GPC_CTX: u64 = 512
const GPC_CTX_BYTES: u64 = 256

const GPX_DEQ: u64 = 0
const GPX_HEAD: u64 = 8
const GPX_TAIL: u64 = 16
const GPX_CC: u64 = 24
const GPX_BUF: u64 = 32
const GPX_PAR: u64 = 56
const GPX_HLO: u64 = 64
const GPX_HHI: u64 = 72

fn __gcp_ctx(ctl: u64, pi: u64) -> u64 {
    return ctl +% GPC_CTX +% pi *% GPC_CTX_BYTES
}

fn __gcp_diag_add(ctl: u64, off: u64, v: u64) {
    __atomic_add((ctl +% off) as *mut u64, v)
}

fn __gcp_now(st: u64, ctx: u64) -> u64 {
    let buf: u64 = ctx +% GPX_BUF
    __gc_st64(buf, 0)
    __gc_st64(buf +% 8, 0)
    let code: u64 = __gc_ld64(st +% S_VDSO)
    if code > 1 {
        __gc_vdso_call(st +% S_VDSO, GC_CLOCK_MONOTONIC, buf)
    } else {
        syscall(GC_SYS_CLOCK_GETTIME, GC_CLOCK_MONOTONIC, buf as i64, 0, 0, 0, 0)
    }
    return __gc_ld64(buf) *% 1000000000 +% __gc_ld64(buf +% 8)
}

fn __gcp_check_deadline(st: u64, ctl: u64, ctx: u64) {
    let dl: u64 = __gc_ld64(ctl +% GPC_DEADLINE)
    if dl == 0 {
        return
    }
    if __gcp_now(st, ctx) >= dl {
        __gc_st64(ctl +% GPC_STOP, 1)
    }
}

fn __gcp_ctx_init(st: u64, ctx: u64) {
    __gc_st64(ctx +% GPX_HEAD, 0)
    __gc_st64(ctx +% GPX_TAIL, 0)
    __gc_st64(ctx +% GPX_CC, 0)
    __gc_st64(ctx +% GPX_PAR, __gc_ld64(st +% S_PAR))
    __gc_st64(ctx +% GPX_HLO, __gc_ld64(st +% S_HEAPLO))
    __gc_st64(ctx +% GPX_HHI, __gc_ld64(st +% S_HEAPHI))
}

fn __gcp_idx_chunk(a: u64) -> u64 {
    let st: u64 = __gc_state() as u64
    let base: u64 = __gc_ld64(st +% S_IDXP)
    let n: u64 = __gc_ld64(st +% S_IDXN)
    if base == 0 || n == 0 {
        return 0
    }
    let k: u64 = __gc_idx_pos(a)
    if k < n && __gc_ld64(base +% k *% 8) == a {
        return a
    }
    if k == 0 {
        return 0
    }
    let c: u64 = __gc_ld64(base +% (k - 1) *% 8)
    if a < c +% __gc_ld64(c +% 8) {
        return c
    }
    return 0
}

fn __gcp_block_of(ctx: u64, a: u64) -> u64 {
    if a < __gc_ld64(ctx +% GPX_HLO) || a >= __gc_ld64(ctx +% GPX_HHI) {
        return 0
    }
    let cc: u64 = __gc_ld64(ctx +% GPX_CC)
    let d0: u64 = cc +% CHUNK_HEADER
    if cc != 0 && a >= d0 && a < __gc_ld64(cc +% 32) {
        return d0 +% ((((a -% d0) *% __gc_ld64(cc +% 56)) >> 32) *% __gc_ld64(cc +% 16))
    }
    let st: u64 = __gc_state() as u64
    let bt: u64 = __gc_ld64(st +% S_BOCACHE)
    if bt > 1 {
        let c2: u64 = __gc_ld64(bt +% (((a >> 18) & (BOCACHE_N - 1)) *% 8))
        let d2: u64 = c2 +% CHUNK_HEADER
        if c2 != 0 && a >= d2 && a < __gc_ld64(c2 +% 32) {
            __gc_st64(ctx +% GPX_CC, c2)
            return d2 +% ((((a -% d2) *% __gc_ld64(c2 +% 56)) >> 32) *% __gc_ld64(c2 +% 16))
        }
    }
    let ci: u64 = __gcp_idx_chunk(a)
    if ci == 0 {
        return 0
    }
    let di: u64 = ci +% CHUNK_HEADER
    if a >= di && a < __gc_ld64(ci +% 32) {
        __gc_st64(ctx +% GPX_CC, ci)
        return di +% ((((a -% di) *% __gc_ld64(ci +% 56)) >> 32) *% __gc_ld64(ci +% 16))
    }
    return 0
}

fn __gcp_pool_give(st: u64, ctx: u64, want: u64) -> u64 {
    let head: u64 = __gc_ld64(ctx +% GPX_HEAD)
    let deq: u64 = __gc_ld64(ctx +% GPX_DEQ)
    let len: u64 = __gc_ld64(st +% S_MLEN)
    let cap: u64 = __gc_ld64(st +% S_MKAP)
    var g: u64 = want
    if cap -% len < g {
        g = cap -% len
    }
    if g == 0 {
        return 0
    }
    let pool: u64 = __gc_ld64(st +% S_MSTACK)
    var i: u64 = 0
    while i < g {
        __gc_st64(pool +% (len +% i) *% 8, __gc_ld64(deq +% ((head +% i) & GCP_DEQ_MASK) *% 8))
        i = i + 1
    }
    __gc_st64(st +% S_MLEN, len +% g)
    __gc_st64(ctx +% GPX_HEAD, head +% g)
    return g
}

fn __gcp_push(st: u64, ctl: u64, ctx: u64, obj: u64) {
    var tail: u64 = __gc_ld64(ctx +% GPX_TAIL)
    if tail -% __gc_ld64(ctx +% GPX_HEAD) >= GCP_DEQ_CAP {
        __thread_lock_raw(ctl +% GPC_LOCK)
        __gcp_pool_give(st, ctx, GCP_DEQ_CAP / 2)
        __thread_unlock_raw(ctl +% GPC_LOCK)
        if tail -% __gc_ld64(ctx +% GPX_HEAD) >= GCP_DEQ_CAP {
            __gc_st64(st +% S_OVERFLOW, 1)
            __gcp_diag_add(ctl, GPC_D_OVF, 1)
            return
        }
    }
    __gc_st64(__gc_ld64(ctx +% GPX_DEQ) +% (tail & GCP_DEQ_MASK) *% 8, obj)
    __gc_st64(ctx +% GPX_TAIL, tail +% 1)
}

fn __gcp_mark(st: u64, ctl: u64, ctx: u64, a: u64) {
    let b: u64 = __gcp_block_of(ctx, a)
    if b == 0 {
        return
    }
    let w: u64 = __gc_ld64(b)
    if (w & GCP_MASK32) == 0 {
        return
    }
    let zw: u64 = w >> 32
    if (zw & (M_MARK as u64)) != __gc_ld64(ctx +% GPX_PAR) {
        return
    }
    let nw: u64 = (w & GCP_MASK32) | (((zw & (M_WITHOUT_MARK as u64)) | 1) << 32)
    if __atomic_swap(b as *mut u64, w, nw) == w {
        __gcp_push(st, ctl, ctx, b +% HEADER)
    }
}

fn __gcp_trace_slots(st: u64, ctl: u64, ctx: u64, obj: u64) -> bool {
    let n: u64 = __gc_ld64(obj)
    let desc: u64 = __gc_ld64(obj +% 8)
    let mask: u64 = desc >> 8
    var i: u64 = __gc_ld64(obj +% 16)
    if mask == 0 || i >= n {
        __gc_st64(obj +% 16, 0)
        return true
    }
    let step: u64 = desc & 255
    let base: u64 = obj +% SLOT_HEADER
    var rest: u64 = SLOT_SLICE
    let hlo: u64 = __gc_ld64(ctx +% GPX_HLO)
    let hhi: u64 = __gc_ld64(ctx +% GPX_HHI)
    if step == 1 {
        while i < n && rest > 0 {
            let v: u64 = __gc_ld64(base +% i *% 8)
            if v >= hlo && v < hhi {
                __gcp_mark(st, ctl, ctx, v)
            }
            i = i + 1
            rest = rest - 1
        }
    } else {
        while i < n && rest > 0 {
            let e: u64 = base +% i *% step *% 8
            var j: u64 = 0
            while j < step {
                if ((mask >> j) & 1) != 0 {
                    let v: u64 = __gc_ld64(e +% j *% 8)
                    if v >= hlo && v < hhi {
                        __gcp_mark(st, ctl, ctx, v)
                    }
                }
                j = j + 1
            }
            i = i + 1
            rest = rest - 1
        }
    }
    if i >= n {
        __gc_st64(obj +% 16, 0)
        return true
    }
    __gc_st64(obj +% 16, i)
    __gcp_push(st, ctl, ctx, obj)
    return false
}

fn __gcp_trace(st: u64, ctl: u64, ctx: u64, obj: u64) {
    let b: u64 = obj -% HEADER
    let zw: u32 = __gc_ld32(b +% 4)
    let black: u32 = (2 - __gc_ld64(ctx +% GPX_PAR)) as u32
    if (zw & F_SLOTS) != 0 {
        if __gcp_trace_slots(st, ctl, ctx, obj) {
            __gc_st32(b +% 4, (zw & M_WITHOUT_MARK) | black)
        }
        return
    }
    __gc_st32(b +% 4, (zw & M_WITHOUT_MARK) | black)
    let tid: u64 = __gc_ld32(b) as u64
    let tab: u64 = __gc_ld64(st +% S_TABLE)
    if tid == 0 || tid > __gc_ld64(tab) {
        return
    }
    let entry: u64 = tab +% 8 +% ((tid -% 1) *% 64)
    let n: u64 = __gc_ld64(entry +% 16)
    let offs: u64 = __gc_ld64(entry +% 24)
    let hlo: u64 = __gc_ld64(ctx +% GPX_HLO)
    let hhi: u64 = __gc_ld64(ctx +% GPX_HHI)
    var i: u64 = 0
    while i < n {
        let kind: u64 = __gc_ld64(obj +% __gc_ld64(offs +% (i *% 8)))
        if kind >= hlo && kind < hhi {
            __gcp_mark(st, ctl, ctx, kind)
        }
        i = i +% 1
    }
}

fn __gcp_take(st: u64, ctx: u64) {
    let len: u64 = __gc_ld64(st +% S_MLEN)
    var n: u64 = (len +% 1) / 2
    if n > GCP_TAKE_MAX {
        n = GCP_TAKE_MAX
    }
    let nl: u64 = len -% n
    let pool: u64 = __gc_ld64(st +% S_MSTACK)
    let deq: u64 = __gc_ld64(ctx +% GPX_DEQ)
    let tail: u64 = __gc_ld64(ctx +% GPX_TAIL)
    var i: u64 = 0
    while i < n {
        __gc_st64(deq +% ((tail +% i) & GCP_DEQ_MASK) *% 8, __gc_ld64(pool +% (nl +% i) *% 8))
        i = i + 1
    }
    __gc_st64(st +% S_MLEN, nl)
    __gc_st64(ctx +% GPX_TAIL, tail +% n)
}

fn __gcp_acquire(st: u64, ctl: u64, ctx: u64) -> bool {
    var idle: bool = false
    while true {
        __thread_lock_raw(ctl +% GPC_LOCK)
        if __gc_ld64(ctl +% GPC_STOP) != 0 || __gc_ld64(ctl +% GPC_FIN) != 0 {
            __thread_unlock_raw(ctl +% GPC_LOCK)
            return false
        }
        if __gc_ld64(st +% S_MLEN) > 0 {
            if idle {
                __gc_st64(ctl +% GPC_IDLE, __gc_ld64(ctl +% GPC_IDLE) -% 1)
            }
            __gcp_take(st, ctx)
            __thread_unlock_raw(ctl +% GPC_LOCK)
            return true
        }
        if !idle {
            idle = true
            let ni: u64 = __gc_ld64(ctl +% GPC_IDLE) +% 1
            __gc_st64(ctl +% GPC_IDLE, ni)
            if ni >= __gc_ld64(ctl +% GPC_PARTS) {
                __gc_st64(ctl +% GPC_FIN, 1)
                __thread_unlock_raw(ctl +% GPC_LOCK)
                return false
            }
        }
        __thread_unlock_raw(ctl +% GPC_LOCK)
        var spins: u64 = 0
        while spins < 4096 && __gc_ld64(st +% S_MLEN) == 0 && __gc_ld64(ctl +% GPC_FIN) == 0 && __gc_ld64(ctl +% GPC_STOP) == 0 {
            spins = spins + 1
            if (spins & 255) == 0 {
                __gcp_check_deadline(st, ctl, ctx)
                if spins > 1024 {
                    __thread_yield()
                }
            }
        }
    }
    return false
}

fn __gcp_share(st: u64, ctl: u64, ctx: u64) {
    let count: u64 = __gc_ld64(ctx +% GPX_TAIL) -% __gc_ld64(ctx +% GPX_HEAD)
    if count < 32 {
        return
    }
    if __gc_ld64(st +% S_MLEN) >= 128 && count < 4096 {
        return
    }
    var g: u64 = count / 2
    if g > GCP_GIVE_MAX {
        g = GCP_GIVE_MAX
    }
    __thread_lock_raw(ctl +% GPC_LOCK)
    let done: u64 = __gcp_pool_give(st, ctx, g)
    __thread_unlock_raw(ctl +% GPC_LOCK)
    if done > 0 {
        __gcp_diag_add(ctl, GPC_D_GIVES, 1)
    }
}

fn __gcp_flush(st: u64, ctl: u64, ctx: u64) {
    let count: u64 = __gc_ld64(ctx +% GPX_TAIL) -% __gc_ld64(ctx +% GPX_HEAD)
    if count > 0 {
        __thread_lock_raw(ctl +% GPC_LOCK)
        let done: u64 = __gcp_pool_give(st, ctx, count)
        __thread_unlock_raw(ctl +% GPC_LOCK)
        if done < count {
            __gc_st64(st +% S_OVERFLOW, 1)
            __gcp_diag_add(ctl, GPC_D_OVF, 1)
        }
    }
    __gc_st64(ctx +% GPX_HEAD, 0)
    __gc_st64(ctx +% GPX_TAIL, 0)
}

fn __gcp_run(st: u64, ctl: u64, ctx: u64) -> u64 {
    var cnt: u64 = 0
    var go: bool = true
    while go {
        if __gc_ld64(ctx +% GPX_TAIL) == __gc_ld64(ctx +% GPX_HEAD) {
            if !__gcp_acquire(st, ctl, ctx) {
                go = false
                break
            }
        }
        let tail: u64 = __gc_ld64(ctx +% GPX_TAIL) -% 1
        let obj: u64 = __gc_ld64(__gc_ld64(ctx +% GPX_DEQ) +% (tail & GCP_DEQ_MASK) *% 8)
        __gc_st64(ctx +% GPX_TAIL, tail)
        __gcp_trace(st, ctl, ctx, obj)
        cnt = cnt + 1
        if (cnt & 15) == 0 {
            if __gc_ld64(ctl +% GPC_STOP) != 0 {
                go = false
            } else {
                __gcp_share(st, ctl, ctx)
                if (cnt & 63) == 0 {
                    __gcp_check_deadline(st, ctl, ctx)
                }
            }
        }
    }
    __gcp_flush(st, ctl, ctx)
    return cnt
}

fn __gcp_helper_main(tcb: u64) -> i32 {
    let ctl: u64 = __gc_ld64(tcb +% FT_ARG)
    let st: u64 = __gc_state() as u64
    var seen: u64 = __gc_ld64(ctl +% GPC_GEN)
    while true {
        var g: u64 = __gc_ld64(ctl +% GPC_GEN)
        var spins: u64 = 0
        while g == seen && spins < GCP_SPIN {
            spins = spins + 1
            g = __gc_ld64(ctl +% GPC_GEN)
        }
        if g == seen {
            __atomic_add((ctl +% GPC_SLEEP) as *mut u64, 1)
            if __gc_ld64(ctl +% GPC_GEN) == seen {
                __thread_futex_wait(ctl +% GPC_GEN, seen & GCP_MASK32)
            }
            __atomic_add((ctl +% GPC_SLEEP) as *mut u64, THREAD_MINUS1)
            g = __gc_ld64(ctl +% GPC_GEN)
        }
        if g != seen {
            seen = g
            var pi: u64 = 0
            __thread_lock_raw(ctl +% GPC_LOCK)
            if __gc_ld64(ctl +% GPC_OPEN) == 1 && __gc_ld64(ctl +% GPC_FIN) == 0 && __gc_ld64(ctl +% GPC_STOP) == 0 && __gc_ld64(ctl +% GPC_GEN) == g {
                let np: u64 = __gc_ld64(ctl +% GPC_PARTS)
                if np < GCP_MAXP {
                    pi = np
                    __gc_st64(ctl +% GPC_PARTS, np +% 1)
                }
            }
            __thread_unlock_raw(ctl +% GPC_LOCK)
            if pi != 0 {
                let ctx: u64 = __gcp_ctx(ctl, pi)
                __gcp_ctx_init(st, ctx)
                let n: u64 = __gcp_run(st, ctl, ctx)
                __gcp_diag_add(ctl, GPC_D_OBJ_HELP, n)
                __gcp_diag_add(ctl, GPC_D_JOINED, 1)
                __atomic_add((ctl +% GPC_LEFT) as *mut u64, 1)
            }
        }
    }
    return 0
}

fn __gcp_spawn(ctl: u64, index: u64) -> bool {
    let tcb: u64 = __gc_mmap(FT_BYTES)
    if tcb == 0 {
        return false
    }
    let sp: u64 = __gc_mmap(GCP_HSTACK)
    if sp == 0 {
        __gc_munmap(tcb, FT_BYTES)
        return false
    }
    syscall(GC_SYS_MPROTECT, sp as i64, 4096, 0, 0, 0, 0)
    __gc_st64(tcb +% FT_SELF, tcb)
    __gc_st64(tcb +% FT_STACK, sp)
    __gc_st64(tcb +% FT_STAPELN, GCP_HSTACK)
    __gc_st64(tcb +% FT_BOTTOM, sp +% GCP_HSTACK)
    __gc_st64(tcb +% FT_SP, sp +% GCP_HSTACK)
    __gc_st64(tcb +% FT_ARG, ctl)
    __gc_st64(tcb +% FT_KIND, GCP_KIND)
    __gc_st64(tcb +% FT_REGS, index)
    let r: i64 = __thread_start(tcb, sp +% GCP_HSTACK, (tcb +% FT_TID) as *mut u8)
    if r <= 0 {
        __gc_munmap(sp, GCP_HSTACK)
        __gc_munmap(tcb, FT_BYTES)
        return false
    }
    return true
}

fn __gcp_prepare(ctl: u64) -> bool {
    var i: u64 = 0
    while i < GCP_MAXP {
        let ctx: u64 = __gcp_ctx(ctl, i)
        if __gc_ld64(ctx +% GPX_DEQ) == 0 {
            let d: u64 = __gc_mmap(GCP_DEQ_BYTES)
            if d == 0 {
                return false
            }
            __gc_st64(ctx +% GPX_DEQ, d)
        }
        i = i + 1
    }
    return true
}

fn gc_par_set(helpers: u64, burst_us: u64) -> u64 {
    let st: u64 = __gc_state() as u64
    var ctl: u64 = __gc_ld64(st +% S_GP_CTL)
    if helpers == 0 {
        if ctl != 0 {
            __gc_st64(ctl +% GPC_WANT, 0)
        }
        return 0
    }
    if ctl == 0 {
        ctl = __gc_mmap(GCP_CTL_BYTES)
        if ctl == 0 {
            return 0
        }
        __gc_st64(st +% S_GP_CTL, ctl)
    }
    var h: u64 = helpers
    if h > GCP_MAXP - 1 {
        h = GCP_MAXP - 1
    }
    __gc_st64(ctl +% GPC_WANT, h)
    var b: u64 = burst_us *% 1000
    if b == 0 {
        b = GCP_BURST_NS
    }
    __gc_st64(ctl +% GPC_BURST, b)
    return h
}

fn gc_par_min_set(n: u64) {
    let ctl: u64 = __gc_ld64(__gc_state() as u64 +% S_GP_CTL)
    if ctl != 0 {
        __gc_st64(ctl +% GPC_MIN, n)
    }
}

fn gc_par_diag(i: u64) -> u64 {
    let ctl: u64 = __gc_ld64(__gc_state() as u64 +% S_GP_CTL)
    if ctl == 0 {
        return 0
    }
    if i == 0 {
        return __gc_ld64(ctl +% GPC_D_BURSTS)
    }
    if i == 1 {
        return __gc_ld64(ctl +% GPC_D_STOPS)
    }
    if i == 2 {
        return __gc_ld64(ctl +% GPC_D_FINS)
    }
    if i == 3 {
        return __gc_ld64(ctl +% GPC_D_NS)
    }
    if i == 4 {
        return __gc_ld64(ctl +% GPC_D_OBJ_MAIN)
    }
    if i == 5 {
        return __gc_ld64(ctl +% GPC_D_OBJ_HELP)
    }
    if i == 6 {
        return __gc_ld64(ctl +% GPC_D_GIVES)
    }
    if i == 7 {
        return __gc_ld64(ctl +% GPC_D_OVF)
    }
    if i == 8 {
        return __gc_ld64(ctl +% GPC_D_SPAWNFAIL)
    }
    if i == 9 {
        return __gc_ld64(ctl +% GPC_D_JOINED)
    }
    return __gc_ld64(ctl +% GPC_NHELP)
}

fn __gcp_burst(st: u64, t0: u64, mode: u64) {
    let ctl: u64 = __gc_ld64(st +% S_GP_CTL)
    if ctl == 0 {
        return
    }
    let want: u64 = __gc_ld64(ctl +% GPC_WANT)
    if want == 0 {
        return
    }
    var pmin: u64 = __gc_ld64(ctl +% GPC_MIN)
    if pmin == 0 {
        pmin = GCP_PAR_MIN
    }
    if __gc_ld64(st +% S_MLEN) < pmin || __gc_ld64(st +% S_MULTI) != 0 || __gc_ld64(st +% S_IDXBAD) != 0 {
        return
    }
    if __gc_ld64(__gcp_ctx(ctl, 0) +% GPX_DEQ) == 0 {
        if !__gcp_prepare(ctl) {
            return
        }
    }
    var nh: u64 = __gc_ld64(ctl +% GPC_NHELP)
    while nh < want {
        if __gcp_spawn(ctl, nh +% 1) {
            nh = nh + 1
            __gc_st64(ctl +% GPC_NHELP, nh)
        } else {
            __gcp_diag_add(ctl, GPC_D_SPAWNFAIL, 1)
            break
        }
    }
    if nh == 0 {
        return
    }
    let ctx: u64 = __gcp_ctx(ctl, 0)
    __gcp_ctx_init(st, ctx)
    var start: u64 = t0
    if start == 0 {
        start = __gcp_now(st, ctx)
    }
    var dl: u64 = 0
    if mode == 0 {
        dl = start +% __gc_ld64(ctl +% GPC_BURST)
    }
    __thread_lock_raw(ctl +% GPC_LOCK)
    __gc_st64(ctl +% GPC_FIN, 0)
    __gc_st64(ctl +% GPC_STOP, 0)
    __gc_st64(ctl +% GPC_IDLE, 0)
    __gc_st64(ctl +% GPC_PARTS, 1)
    __gc_st64(ctl +% GPC_LEFT, 0)
    __gc_st64(ctl +% GPC_DEADLINE, dl)
    __gc_st64(ctl +% GPC_OPEN, 1)
    __thread_unlock_raw(ctl +% GPC_LOCK)
    __atomic_add((ctl +% GPC_GEN) as *mut u64, 1)
    if __gc_ld64(ctl +% GPC_SLEEP) > 0 {
        __thread_futex_wake(ctl +% GPC_GEN, 64)
    }
    let n: u64 = __gcp_run(st, ctl, ctx)
    __thread_lock_raw(ctl +% GPC_LOCK)
    __gc_st64(ctl +% GPC_OPEN, 0)
    let p: u64 = __gc_ld64(ctl +% GPC_PARTS)
    __thread_unlock_raw(ctl +% GPC_LOCK)
    var spins: u64 = 0
    while __gc_ld64(ctl +% GPC_LEFT) < p -% 1 {
        spins = spins + 1
        if spins > 200 {
            __thread_yield()
        }
    }
    __gcp_diag_add(ctl, GPC_D_BURSTS, 1)
    __gcp_diag_add(ctl, GPC_D_OBJ_MAIN, n)
    if __gc_ld64(ctl +% GPC_STOP) != 0 {
        __gcp_diag_add(ctl, GPC_D_STOPS, 1)
    }
    if __gc_ld64(ctl +% GPC_FIN) != 0 {
        __gcp_diag_add(ctl, GPC_D_FINS, 1)
    }
    __gcp_diag_add(ctl, GPC_D_NS, __gcp_now(st, ctx) -% start)
}
