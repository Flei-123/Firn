// lib/gc/gc.fi — Laufzeit des Opt-in-Tracing-GC (SPEC §3.5).
//
// Diese Datei wird vom Compiler per `include_str!` eingebettet und automatisch
// als zusaetzliches Modul eingezogen, sobald im Programm ein `gc class`
// vorkommt (`compiler/src/gc.rs`, `compiler/src/modules.rs`). Sie braucht
// KEIN `import` und keine Kommandozeilenoption; ihre Namen liegen im
// Wurzelnamensraum.
//
// Verfahren (SPEC §3.5.3, keine Abweichung):
//   * Mark-Sweep, anhaltend, Sammlung NUR an Allokationsstellen und bei
//     gc_collect().
//   * PRAEZISE Heap-Verfolgung ueber die compilergenerierte Typtabelle
//     (Feldoffsets je Klasse, aus dem Feldlayout erzeugt).
//   * KONSERVATIVER Scan von Stapel UND Registern. Die callee-saved Register
//     werden vor dem Scan vom Codegenerator in den Zustandsblock gerettet
//     (`__gc_save_regs`), sonst waere die Zusage falsch.
//   * KEIN Kompaktieren (Adressen bleiben gueltig — Voraussetzung fuer den
//     konservativen Scan), Groessenklassen-Allokator gegen Fragmentierung.
//   * Ein Heap je Faden (SPEC §7): der Zustandsblock ist fadenlokal gedacht;
//     Stufe 0 hat nur einen Faden.
//   * mmap OHNE feste Adresse, ohne MAP_FIXED; ein fehlgeschlagenes mmap ist
//     sichtbar (gc_init() -> false bzw. AllocError::OutOfMemory).
//
// Aufbau eines Blocks (16 Byte Kopf, danach die Nutzdaten):
//   [0..4)   u32 Typkennung (0 = frei)
//   [4..8)   u32 Zustandswort — Runde 47:
//              Bits 0..1  Marke (0 weiss, 1 grau, 2 schwarz)
//              Bit  2     F_FIN    das Objekt hat einen Finalisierer
//              Bit  3     F_WART   es steht in der Finalisierungs-Schlange
//              Bit  4     F_GETAN  sein Finalisierer ist gelaufen
//              Bits 8..31 Aufraeumart (24 Bit, 0 = keine)
//   [8..16)  u64 Seriennummer (fuer GcWeak; 0 = frei). Waehrend ein Block in
//              der Finalisierungs-Schlange haengt, traegt dieses Wort statt
//              der Seriennummer den Verweis auf den naechsten Wartenden —
//              deshalb braucht die Schlange keinen eigenen Speicher.
//   [16..)   Nutzdaten — das ist die Adresse, die `Gc[T]` traegt.
//
// Aufbau eines Chunks (64 Byte Kopf):
//   [0]  naechster Chunk   [8]  Groesse in Bytes   [16] Blockgroesse
//   [24] Anzahl Bloecke    [32] Datenanfang (64)   [40] Groessenklasse
//   [48] Leer-Hysterese    (1 = war beim letzten Sweep schon leer)

const SYS_WRITE: i64 = 1
const SYS_OPEN: i64 = 2
const SYS_CLOSE: i64 = 3
const SYS_MMAP: i64 = 9
const SYS_MUNMAP: i64 = 11
const SYS_READ: i64 = 0
const SYS_EXIT_GROUP: i64 = 231
const SYS_CLOCK_GETTIME: i64 = 228
const PROT_RW: i64 = 3
const MAP_PRIVATE_ANON: i64 = 34
const CLOCK_MONOTONIC: i64 = 1
// Runde 44: Rechenzeit DIESES Fadens. Damit laesst sich eine lange Pause,
// die der Sammler wirklich verursacht hat, von einer unterscheiden, in der
// die Maschine den Prozess nur verdraengt hat (parallele Runden auf
// derselben Maschine — der Fehlbefund der Runde 40).
const CLOCK_THREAD_CPUTIME: i64 = 3

// Zustandsblock: Offsets in Bytes (siehe compiler/src/gc.rs).
const S_TABELLE: u64 = 0
const S_INIT: u64 = 8
const S_CHUNKS: u64 = 16
const S_BODEN: u64 = 24
const S_LAEUFE: u64 = 32
const S_LEBENDE: u64 = 40
const S_HEAP: u64 = 48
const S_LEBBYTES: u64 = 56
const S_PAUSE_LAST: u64 = 64
const S_PAUSE_MAX: u64 = 72
const S_PAUSE_TOTAL: u64 = 80
const S_SEIT: u64 = 88
const S_GRENZE: u64 = 96
const S_SERIE: u64 = 104
const S_MSTACK: u64 = 112
const S_MKAP: u64 = 120
const S_MLEN: u64 = 128
const S_UEBERLAUF: u64 = 136
const S_BARRIEREN: u64 = 144
const S_ZEIT: u64 = 152
const S_FREI: u64 = 168
const S_GESAMT: u64 = 296
const S_BLOCKGROESSE: u64 = 304
const S_MAXHEAP: u64 = 312
// Inkrementeller Zyklus (Runde 38): Phase 0 Ruhe, 1 Markieren, 2 Fegen.
const S_PHASE: u64 = 320
// Merker des gestueckelten Sweeps: aktueller Chunk, vorheriger, und die
// Akkumulatoren fuer lebende Objekte/Bytes (werden am Zyklusende uebernommen).
const S_SWC: u64 = 328
const S_SWV: u64 = 336
const S_SWLEB: u64 = 344
const S_SWLEBB: u64 = 352
// Weiss-Paritaet: 0 oder 2. Grau ist immer 1, schwarz ist 2 - weiss.
// Am Zyklusende wird die Paritaet umgeschaltet: alles Ueberlebende ist dann
// schwarz_alt = weiss_neu — der naechste Zyklus startet ohne Marken-Reset.
const S_PAR: u64 = 360
// Diagnose der Runde 38: laengste Pause je Scheibentyp.
const S_PMAX_START: u64 = 368
const S_PMAX_MARK: u64 = 376
const S_PMAX_SWEEP: u64 = 384
const S_PMAX_ENDE: u64 = 392
const S_PMAX_VOLL: u64 = 400
// Eintraegiger Chunk-Zwischenspeicher fuer __gc_block_von: Schreibbarrieren
// treffen meist denselben Chunk mehrfach hintereinander.
const S_CHUNK_CACHE: u64 = 408
// Letzte Scheibe bei diesem S_SEIT-Stand (Scheiben bytegekoppelt).
const S_SCHRT: u64 = 416
// Laengste Scheibe des laufenden Zyklus — wird am Zyklusende nach
// S_PAUSE_LAST uebernommen, damit das Histogramm pro Zyklus die
// spuerbarste Unterbrechung sieht (statt nur der letzten Scheibe).
const S_PZYK: u64 = 424
// Diagnose: wie oft lief der Markstapel ueber (atomarer Nachtragslauf).
const S_NOV: u64 = 432
// Diagnose (Runde 41): wie viele Sammellaeufe waren VOLLE Stop-the-World-
// Laeufe (Aufbauphase unter INKR_AB oder Erschoepfungs-Fallback).
const S_VOLL: u64 = 440
// Histogramm der EINZELNEN Scheiben (Runde 41): 16 Faecher, verdoppelnd
// ab 1 us. Fach 0 = unter 1 us, Fach k = [2^(k-1) us, 2^k us), Fach 15 =
// alles ab 16,384 ms. Bisher konnte das Messwerkzeug nur die laengste
// Scheibe JE ZYKLUS sehen (S_PZYK) — damit rauschten Einzelmaxima zu
// stark, um Scheibengroessen zu vergleichen. Hier zaehlt jede Scheibe.
const S_HIST: u64 = 448
const HIST_FAECHER: u64 = 16
// Runde 44: acht Typen statt sieben. Typ 7 ist die GANZE Unterbrechung an
// einer Allokationsstelle (Start + Markieren + Fegen + Ende, soweit sie in
// DEMSELBEN Aufruf anfallen) — die Zahl, die ein Bild wirklich sieht. Die
// Typen 0..5 messen nur einzelne Abschnitte und untertreiben damit, sobald
// ein Aufruf mehrere Abschnitte enthaelt. S_HIST belegt 8*16*8 = 1024 Byte.
const HIST_TYPEN: u64 = 8
// Laengste ganze Unterbrechung (Typ 7).
const S_STOPMAX: u64 = 1472
// Diagnose der Runde 44: WO entsteht Heapwachstum und wie viele Scheiben
// laufen ueberhaupt. Der Zustandsblock ist 4096 Byte gross (compiler/src/gc.rs,
// STATE_SIZE), die Registerrettung liegt ab 3968 — ab 1344 ist Platz.
const S_D_CN_RUHE: u64 = 1480
const S_D_CN_MARK: u64 = 1488
const S_D_CN_SWEEP: u64 = 1496
const S_D_SCH_MARK: u64 = 1504
const S_D_SCH_SWEEP: u64 = 1512
const S_D_GRAU: u64 = 1520
const S_D_ALLOK: u64 = 1528
// Runde 44: Umschaltschwelle zur Laufzeit (Voreinstellung INKR_AB). So laesst
// sich der atomare gegen den inkrementellen Pfad IM SELBEN PROZESS und mit
// BITGLEICHEM Code messen — ohne Codelayout-Unterschiede, die bei Messungen
// im Prozentbereich sonst alles ueberdecken.
const S_INKRAB: u64 = 1536
// Fegen: je Groessenklasse ein Merker, ob ihre Freiliste in DIESEM Fegedurchlauf
// schon geleert wurde (13 Klassen, 1544..1648).
const S_SWKL: u64 = 1544
// Histogramm der ganzen Unterbrechung in REINER RECHENZEIT (16 Faecher wie
// S_HIST), sein Maximum, und der Schalter dafuer (0 = aus, keine zusaetzliche
// Uhr; nur Messprogramme schalten ihn ein).
const S_CHIST: u64 = 1704
const S_CSTOPMAX: u64 = 1832
const S_CPUUHR: u64 = 1840
// ------------------------------------------------------------ Runde 47
// Finalisierer: Kopf und Laenge der Warteschlange, Zaehler, laengste
// Finalisiererscheibe. Schwache Felder: wie viele wurden je genullt.
// Externe Wurzelbereiche: Feld, Kapazitaet, Belegung.
const S_FINQ: u64 = 1848
const S_FINQ_N: u64 = 1856
const S_FIN_LAEUFE: u64 = 1864
const S_FIN_NS: u64 = 1872
const S_FIN_MAX: u64 = 1880
const S_FIN_REG: u64 = 1888
const S_WEAK_NULL: u64 = 1896
const S_WROOT_P: u64 = 1904
const S_WROOT_KAP: u64 = 1912
const S_WROOT_N: u64 = 1920
const S_PMAX_FIN: u64 = 1928
// 1 = mindestens eine Klasse hat ein GcWeak-Feld. Einmal beim Start aus der
// Typtabelle bestimmt, damit das Fegen bei Programmen ohne schwache Felder
// keinen einzigen zusaetzlichen Tabellenzugriff macht.
const S_HATWEAK: u64 = 1936
// Uhr je EINZELNEM Finalisierer (0 = aus). Sie kostet zwei Systemaufrufe je
// Finalisierer — bei knapp einer Million Finalisierern in drei Sekunden sind
// das gemessen ~3 % Laufzeit. Die Scheibenzeit (S_PMAX_FIN) wird IMMER
// gemessen, sie kostet nur zwei Aufrufe je Scheibe. Wie bei S_CPUUHR
// schalten nur Messprogramme das hier ein.
const S_FINUHR: u64 = 1944
// Bitmaske der Typkennungen MIT schwachem Feld (Bit i = Typkennung i+1).
// Damit kostet die Frage "hat dieses Objekt ueberhaupt ein GcWeak-Feld?" im
// Fegen eine Verschiebung und ein Und statt vier abhaengiger Speicherzugriffe
// in die Typtabelle. Gemessen hat genau das den Durchsatzverlust der Runde
// von 3,0 % auf 0,4 % gedrueckt (docs/RUNDE47.md).
// Mehr als 64 Klassen: dann steht Bit 63 fuer "koennte sein" und es wird
// nachgesehen — richtig bleibt es immer, nur nicht mehr ganz so billig.
const S_WEAKMASK: u64 = 1952
// ------------------------------------------------------------ Runde 49
// Der Rettungsbereich der callee-saved Register. Er liegt am ENDE des
// Zustandsblocks (compiler/src/gc.rs, REG_SAVE_OFF = 3968).
//
// BEFUND DER RUNDE 49: bis hierher stand in `__gc_collect_now`
// `__gc_scan(regs, regs + 48)` mit `regs = __gc_save_regs()` — und
// `__gc_save_regs()` liefert die Adresse des BLOCKS, nicht die des
// Rettungsbereichs. Gescannt wurden also die ersten 48 Oktette des
// Zustandsblocks (Typtabelle, S_INIT, Chunkliste, Stapelboden, zwei Zaehler)
// statt der Register. Der KONSERVATIVE REGISTERSCAN aus SPEC §3.5.3 lief
// damit ins Leere. Das faellt hier auf, weil die Runde denselben Mechanismus
// je Faden braucht; die Zeile ist repariert und der Nachweis steht in
// tools/thread/run.sh.
const S_REGS: u64 = 3968
// Fadentafel: Zeiger, Platzzahl, lebende Faeden, je gestartete Faeden.
const S_FADEN_TAB: u64 = 1960
const S_FADEN_MAX: u64 = 1968
const S_FADEN_N: u64 = 1976
const S_FADEN_GES: u64 = 1984
// 1 = es gibt (oder gab) mehr als einen Faden. DER Schalter des heissen Weges:
// solange er 0 ist, kostet die ganze Runde 49 nichts ausser einem
// Speicherzugriff und einem immer gleich vorhergesagten Sprung.
const S_MULTI: u64 = 1992
// Futex-Wort: 1 = die Welt haelt an.
const S_STOPP: u64 = 2000
// Die GC-Sperre. Wer sie haelt, darf als Einziger die Welt anhalten (R1).
const S_SPERRE: u64 = 2008
// Drehsperre um den EINEN Registerrettungsbereich.
const S_REGSPERRE: u64 = 2016
// Sperre um die Fadentafel.
const S_TSPERRE: u64 = 2024
const S_HAUPT: u64 = 2032
const S_STAPELN: u64 = 2040
// Diagnose des Anhaltens.
const S_STW_N: u64 = 2048
const S_STW_MAX: u64 = 2056
const S_STW_WARTE: u64 = 2064
const S_STW_NS: u64 = 2072
const S_STW_T0: u64 = 2080
const S_STW_ARBEIT_MAX: u64 = 2088
const S_SPERR_W: u64 = 2096
// 1 = Freilisten pro Faden (Variante B), 0 = alles unter der GC-Sperre (A).
const S_LOKAL: u64 = 2104
const S_LOKAL_N: u64 = 2112
// So viele Bloecke holt ein Faden auf einmal in seine eigene Freiliste.
const SCHWUNG: u64 = 32

// ---------------------------------------------------------------- Runde 53
// MERGE R49+R53: die drei Slots lagen urspruenglich auf 1960/1968/1976 —
// genau dort, wo Runde 49 ihre Fadentafel angelegt hat. Beide Zweige haben
// die Nummern unabhaengig vergeben und den anderen nicht gesehen. Runde 53
// zieht auf 2120/2128/2136 um (frei, unterhalb REG_SAVE_OFF = 3968).
// Typkennung des Slot-Puffers (lib/gc/gcvec.fi setzt sie einmal je Prozess).
const S_SLOTS_TID: u64 = 2120
// Scheibengroesse und Zeitbudget des Markierens ZUR LAUFZEIT stellbar;
// 0 = Voreinstellung (SCHEIBE_TRACE bzw. ZEIT_BUDGET_NS).
//
// WOZU: der kritische Fall der Runde 53 ist eine Sammlung, die WAEHREND
// einer laufenden Markierung waechst. Wie oft er von selbst eintritt, ist
// nachgemessen und ernuechternd: bei 200.000 Anhaengungen fielen 526 in
// Phase 1 und KEIN EINZIGES Wachsen des Puffers (0,26 %). Ein Test, der
// darauf wartet, prueft nichts. Mit `gc_set_scheibe(1)` verfolgt eine
// Scheibe genau EIN Objekt — die Markierphase erstreckt sich dann ueber so
// viele Allokationen, wie es lebende Objekte gibt, und der kritische Fall
// wird zum Normalfall. Derselbe Kunstgriff wie S_CPUUHR und S_INKRAB:
// bitgleicher Code, nur ein anderer Zustand.
const S_SCHEIBE: u64 = 2128
const S_ZBUDGET: u64 = 2136

// Zustandswort eines Blockkopfes (siehe Kopfkommentar).
const M_MARKE: u32 = 3
const M_OHNE_MARKE: u32 = 4294967292
const F_FIN: u32 = 4
const F_WART: u32 = 8
const F_GETAN: u32 = 16
// ---------------------------------------------------------------- Runde 53
// SLOT-PUFFER: der Block traegt statt fester Felder ein FELD von Elementen,
// deren Zahl erst zur Laufzeit feststeht (`GcVec`, `GcMap` — lib/gc/gcvec.fi,
// lib/gc/gcmap.fi). Die compilergenerierte Typtabelle kann so etwas nicht
// beschreiben, sie kennt nur feste Offsets. Dieses Bit im Zustandswort
// schaltet die Verfolgung auf `__gc_trace_slots` um. Es kostet NICHTS: das
// Wort wird in `__gc_trace` ohnehin gelesen und geschrieben. Bits 5..7 waren
// frei (0..1 Marke, 2 F_FIN, 3 F_WART, 4 F_GETAN, 8..31 Aufraeumart).
const F_SLOTS: u32 = 32
// Kopf eines Slot-Puffers, in Bytes (Nutzdaten, nicht Blockkopf):
//   [0..8)   u64 n            Zahl der Elemente, die verfolgt werden
//   [8..16)  u64 desc         schritt | (maske << 8)
//   [16..24) u64 fortschritt  Wiederaufnahmepunkt der Markierung
//   [24..32) u64 kap          Kapazitaet in Elementen
//   [32..)   die Elemente
// 32 Byte, damit die Elemente 16-byte-ausgerichtet liegen.
const SLOT_KOPF: u64 = 32
// Elemente je Markierscheibe eines Slot-Puffers. Siehe __gc_trace_slots:
// ein Puffer mit Millionen Elementen darf das Zeitbudget einer Scheibe
// (ZEIT_BUDGET_NS) nicht sprengen, sonst ist die Pausenzusage der Runde 44
// hin. Die Uhr wird in __gc_zyklus_schritt nur alle ZEIT_PROBE Objekte
// gelesen, also ist die schlimmste Strecke ohne Uhr ZEIT_PROBE * SLOT_SCHEIBE
// Markierungen. Bei 16 * 64 = 1024 bleibt sie in derselben Groessenordnung
// wie ein gewoehnliches Objekt mit acht Zeigerfeldern.
const SLOT_SCHEIBE: u64 = 64
const ART_MAX: u64 = 16777215
// Anfangsgroesse des Feldes externer Wurzelbereiche (Eintraege zu 16 Byte).
const WROOT_START: u64 = 256
// Scheibengroessen: so viele Objekte pro Allokation tracen bzw. Chunks fegen.
const SCHEIBE_TRACE: u64 = 512
// Runde 41: Zeitbudget einer Markierscheibe (ns). Die Objektzahl allein
// taugt nicht als Mass — ein Objekt mit vielen Zeigerfeldern kostet ein
// Vielfaches eines Textknotens, deshalb streuten die Scheiben im Histogramm
// ueber drei Zehnerpotenzen. Die Uhr wird nur alle ZEIT_PROBE Objekte
// gelesen (clock_gettime kostet selbst ~25 ns).
const ZEIT_BUDGET_NS: u64 = 100000
const ZEIT_PROBE: u64 = 16
// Chunks je Zeitprobe im Fegen (Runde 44). Das Fegen haengt seit Runde 44
// wie das Markieren an ZEIT_BUDGET_NS; diese Zahl sagt nur, nach wie vielen
// Chunks die Uhr befragt wird.
const SCHEIBE_SWEEP: u64 = 2
// Voreinstellung der Umschaltschwelle atomar/inkrementell in Heapbytes.
// Zur Laufzeit mit gc_set_inkr_ab() stellbar.
//
// RUNDE 44 — WARUM JETZT 0 (immer inkrementell):
// Bis Runde 43 stand hier 8 MiB. Unterhalb der Schwelle lief ein ATOMARER
// Vollzyklus, und in der AUFBAUPHASE (Heap waechst von 0 auf seine Groesse)
// waren das gemessen drei Stop-the-World-Laeufe von 0,88 / 2,90 / 11,81 ms
// (tools/gc_meas/build.fi, 120.000 lebende Knoten). Fuer ein 16-ms-Bild ist
// der letzte Wert allein schon zu viel.
//
// Die Begruendung der Schwelle (Runde 38: rein inkrementell kostete 8 bis
// 26 % Durchsatz bei kleinem Heap) war RICHTIG GEMESSEN, aber die Ursache
// lag nicht im inkrementellen Verfahren, sondern in __gc_sweep_init(): es
// leerte ALLE Freilisten auf einen Schlag, und weil das Fegen in Scheiben
// laeuft, fiel danach jede Allokation bis zum Ende des Fegens auf eine leere
// Liste und musste einen frischen Chunk mmapen. Gemessen: 113 von 119 neuen
// Chunks entstanden im Fegen, der Heap verdoppelte sich (1,5 -> 3,7 MiB),
// und weil __gc_block_von die Chunkliste linear absucht, wurde damit jede
// Markierung teurer. Seit die Freilisten klassenweise erst beim ersten Chunk
// ihrer Klasse geleert werden und das Fegen ein Zeitbudget hat, bleibt der
// Heap gleich gross wie im atomaren Pfad, und der inkrementelle Zyklus
// kostet bei 2000 lebenden Knoten noch 2 % Durchsatz (A/B im selben Prozess,
// tools/gc_meas/ab.fi) statt 26 %.
const INKR_AB: u64 = 0

const KOPF: u64 = 16
const CHUNK_KOPF: u64 = 64
const CHUNK_BYTES: u64 = 262144
const KLASSEN: u64 = 13
const MARK_BYTES: u64 = 1048576
const MIN_GRENZE: u64 = 1048576
// Maximaler Abstand zwischen zwei Sammellaeufen (in frisch allozierten
// Bytes): der Speicherueberhang ueber der Lebendmenge bleibt so immer
// kleiner als dieser Betrag — egal, wie gross der Heap einmal war.
const MAX_GRENZE: u64 = 4194304
const WEAK_XOR: u64 = 6510615555426900570

// ---------------------------------------------------------------- Speicher

fn __gc_ld64(a: u64) -> u64 {
    return *(a as *mut u64)
}

fn __gc_st64(a: u64, v: u64) {
    *(a as *mut u64) = v
}

fn __gc_ld32(a: u64) -> u32 {
    return *(a as *mut u32)
}

fn __gc_st32(a: u64, v: u32) {
    *(a as *mut u32) = v
}

// n Bytes vom Betriebssystem, nullinitialisiert. 0 = fehlgeschlagen.
// OHNE feste Adresse, ohne MAP_FIXED.
fn __gc_mmap(n: u64) -> u64 {
    let len: u64 = (n + 4095) / 4096 * 4096
    let r: i64 = syscall(SYS_MMAP, 0, len as i64, PROT_RW, MAP_PRIVATE_ANON, -1, 0)
    if r < 0 && r > -4096 {
        return 0
    }
    if r == 0 {
        return 0
    }
    return r as u64
}

fn __gc_munmap(p: u64, n: u64) {
    let len: u64 = (n + 4095) / 4096 * 4096
    syscall(SYS_MUNMAP, p as i64, len as i64, 0, 0, 0, 0)
}

fn __gc_cpu_ns() -> u64 {
    let st: u64 = __gc_state() as u64
    let buf: u64 = st + S_ZEIT
    __gc_st64(buf, 0)
    __gc_st64(buf + 8, 0)
    syscall(SYS_CLOCK_GETTIME, CLOCK_THREAD_CPUTIME, buf as i64, 0, 0, 0, 0)
    return __gc_ld64(buf) * 1000000000 + __gc_ld64(buf + 8)
}

fn __gc_now_ns() -> u64 {
    let st: u64 = __gc_state() as u64
    let buf: u64 = st + S_ZEIT
    __gc_st64(buf, 0)
    __gc_st64(buf + 8, 0)
    syscall(SYS_CLOCK_GETTIME, CLOCK_MONOTONIC, buf as i64, 0, 0, 0, 0)
    return __gc_ld64(buf) * 1000000000 + __gc_ld64(buf + 8)
}

// Sichtbares Scheitern statt stiller Falschantwort.
fn __gc_abort(code: i64) {
    var m: [u8; 42] = "firn-gc: gc_init() wurde nicht aufgerufen\n"
    let p: u64 = (&m) as u64
    syscall(SYS_WRITE, 2, p as i64, 42, 0, 0, 0)
    syscall(SYS_EXIT_GROUP, code, 0, 0, 0, 0, 0)
}

// Runde 47: dieselbe Regel fuer die drei Verstoesse gegen den
// Finalisierer-Vertrag. Ein Finalisierer, der alloziert, sammelt oder
// wiederbelebt, wuerde den Sammler von innen zerlegen — das MUSS sichtbar
// abbrechen und darf nicht still weiterlaufen.
fn __gc_write(p: u64, n: i64, code: i64) {
    syscall(SYS_WRITE, 2, p as i64, n, 0, 0, 0)
    syscall(SYS_EXIT_GROUP, code, 0, 0, 0, 0, 0)
}

fn __gc_error_fin_alloc() {
    var m: [u8; 65] = "firn-gc: allokation waehrend eines finalisierers (SPEC 3.5.3 S4)\n"
    __gc_write((&m) as u64, 65, 71)
}

fn __gc_error_fin_collect() {
    var m: [u8; 67] = "firn-gc: gc_collect() waehrend eines finalisierers (SPEC 3.5.3 S4)\n"
    __gc_write((&m) as u64, 67, 72)
}

fn __gc_error_fin_again() {
    var m: [u8; 56] = "firn-gc: wiederbelebung im finalisierer (SPEC 3.5.3 S4)\n"
    __gc_write((&m) as u64, 56, 73)
}

// ------------------------------------------------------- Stapelboden ermitteln

// RUNDE 47 — DER STAPELBODEN AUS /proc/self/maps.
//
// Feld 28 aus /proc/self/stat ist die Startadresse des Stapels, wie der Kern
// sie beim Programmstart notiert hat. Das ist EXAKT, solange das Programm auf
// genau diesem Stapel laeuft — unter valgrind aber NICHT: dort laeuft der
// Klient auf einem von valgrind bereitgestellten Stapel, waehrend Feld 28
// weiterhin den urspruenglichen nennt. Der konservative Scan lief dann von
// seinem Stapelzeiger bis zu einer Adresse, die gar nicht dazugehoert, und
// das Programm starb mit einem Speicherzugriffsfehler.
//
// Folge, bis diese Runde: KEIN Programm mit `gc class` liess sich unter
// callgrind messen (mit dem Compiler der Runde 44 genauso wenig — es ist
// kein neuer Fehler, nur ein bisher nicht benannter). Damit fehlte
// ausgerechnet fuer den Sammler das einzige Messmittel, das nicht streut.
//
// Jetzt wird ZUERST /proc/self/maps gelesen und die Abbildung gesucht, in der
// der eigene Stapelzeiger wirklich liegt; ihr Ende ist der Boden. Das gilt
// auf beiden Wegen. Schlaegt es fehl, bleibt Feld 28 als Rueckfall.
fn __gc_hex_digit(c: u8) -> i64 {
    if c >= 48 && c <= 57 {
        return c as i64 - 48
    }
    if c >= 97 && c <= 102 {
        return c as i64 - 87
    }
    if c >= 65 && c <= 70 {
        return c as i64 - 55
    }
    return -1
}

fn __gc_stack_bottom_maps(sp: u64) -> u64 {
    var path: [u8; 16] = "/proc/self/maps\0"
    let cap: u64 = 262144
    let buffer: u64 = __gc_mmap(cap)
    if buffer == 0 {
        return 0
    }
    let pp: u64 = (&path) as u64
    let fd: i64 = syscall(SYS_OPEN, pp as i64, 0, 0, 0, 0, 0)
    if fd < 0 {
        __gc_munmap(buffer, cap)
        return 0
    }
    var len: u64 = 0
    var next: bool = true
    while next {
        let n: i64 = syscall(SYS_READ, fd, (buffer + len) as i64,
                             (cap - len - 1) as i64, 0, 0, 0)
        if n <= 0 {
            next = false
        } else {
            len = len + n as u64
            if len + 1 >= cap {
                next = false
            }
        }
    }
    syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0)
    if len == 0 {
        __gc_munmap(buffer, cap)
        return 0
    }
    // Zeilen der Form "7ffd0a1b2000-7ffd0a1d3000 rw-p ..." — gesucht ist die,
    // in der `sp` liegt; ihr Ende ist der Stapelboden.
    var i: u64 = 0
    var hit: u64 = 0
    while i < len {
        var of: u64 = 0
        var digits: u64 = 0
        while i < len {
            let z: i64 = __gc_hex_digit(*((buffer + i) as *mut u8))
            if z < 0 {
                break
            }
            of = of * 16 + z as u64
            digits = digits + 1
            i = i + 1
        }
        var to: u64 = 0
        if digits > 0 && i < len && *((buffer + i) as *mut u8) == 45 {
            i = i + 1
            var st2: u64 = 0
            while i < len {
                let z2: i64 = __gc_hex_digit(*((buffer + i) as *mut u8))
                if z2 < 0 {
                    break
                }
                to = to * 16 + z2 as u64
                st2 = st2 + 1
                i = i + 1
            }
            if st2 > 0 && sp >= of && sp < to {
                hit = to
            }
        }
        // Rest der Zeile ueberspringen.
        while i < len && *((buffer + i) as *mut u8) != 10 {
            i = i + 1
        }
        if i < len {
            i = i + 1
        }
        if hit != 0 {
            i = len
        }
    }
    __gc_munmap(buffer, cap)
    return hit
}

// Feld 28 aus /proc/self/stat ist die Startadresse des Stapels. Rueckfall,
// wenn /proc/self/maps nichts hergibt.
fn __gc_stack_bottom() -> u64 {
    var path: [u8; 16] = "/proc/self/stat\0"
    let buffer: u64 = __gc_mmap(8192)
    if buffer == 0 {
        return 0
    }
    let pp: u64 = (&path) as u64
    let fd: i64 = syscall(SYS_OPEN, pp as i64, 0, 0, 0, 0, 0)
    if fd < 0 {
        __gc_munmap(buffer, 8192)
        return 0
    }
    let n: i64 = syscall(SYS_READ, fd, buffer as i64, 8000, 0, 0, 0)
    syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0)
    if n <= 0 {
        __gc_munmap(buffer, 8192)
        return 0
    }
    let len: u64 = n as u64
    // Der Kommandoname steht in Klammern und darf Leerzeichen enthalten:
    // hinter der LETZTEN ')' beginnt Feld 3.
    var paren: u64 = 0
    var i: u64 = 0
    while i < len {
        if *((buffer + i) as *mut u8) == 41 {
            paren = i
        }
        i = i + 1
    }
    if paren == 0 {
        __gc_munmap(buffer, 8192)
        return 0
    }
    // Feld 28 = das 26. Feld hinter der Klammer.
    var pos: u64 = paren + 1
    var field: u64 = 0
    var value: u64 = 0
    while field < 26 {
        while pos < len && *((buffer + pos) as *mut u8) == 32 {
            pos = pos + 1
        }
        value = 0
        var digits: u64 = 0
        while pos < len {
            let c: u8 = *((buffer + pos) as *mut u8)
            if c < 48 || c > 57 {
                break
            }
            value = value * 10 + (c as u64 - 48)
            digits = digits + 1
            pos = pos + 1
        }
        // Nichtnumerische Felder ueberspringen
        while pos < len && *((buffer + pos) as *mut u8) != 32 {
            pos = pos + 1
        }
        if digits == 0 {
            value = 0
        }
        field = field + 1
    }
    __gc_munmap(buffer, 8192)
    return value
}

// ------------------------------------------------------------ Groessenklassen

fn __gc_diag_inc(off: u64) {
    let st: u64 = __gc_state() as u64
    __gc_st64(st + off, __gc_ld64(st + off) + 1)
}

// Diagnose 0..6: neue Chunks in Ruhe/Mark/Sweep, Mark-Scheiben, Sweep-Scheiben,
// graue (waehrend eines Zyklus getaetigte) Allokationen, Allokationen gesamt.
fn gc_diag(i: u64) -> u64 {
    if i > 6 {
        return 0
    }
    return __gc_ld64(__gc_state() as u64 + S_D_CN_RUHE + i * 8)
}

fn __gc_classes_bytes(k: u64) -> u64 {
    if k == 0 {
        return 32
    }
    if k == 1 {
        return 48
    }
    if k == 2 {
        return 64
    }
    if k == 3 {
        return 96
    }
    if k == 4 {
        return 128
    }
    if k == 5 {
        return 192
    }
    if k == 6 {
        return 256
    }
    if k == 7 {
        return 384
    }
    if k == 8 {
        return 512
    }
    if k == 9 {
        return 768
    }
    if k == 10 {
        return 1024
    }
    if k == 11 {
        return 2048
    }
    return 4096
}

fn __gc_class_for(size: u64) -> u64 {
    var k: u64 = 0
    while k < KLASSEN {
        if size <= __gc_classes_bytes(k) {
            return k
        }
        k = k + 1
    }
    return KLASSEN
}

// ----------------------------------------------------------------- Chunks

fn __gc_chunk_new(class: u64, payload: u64) -> u64 {
    let st: u64 = __gc_state() as u64
    var block: u64 = 0
    var total: u64 = 0
    if class < KLASSEN {
        block = KOPF + __gc_classes_bytes(class)
        total = CHUNK_BYTES
    } else {
        block = KOPF + (payload + 15) / 16 * 16
        total = CHUNK_KOPF + block
    }
    // Speichergrenze je Heap (Grundlage fuer eine Grenze je Tab, S6).
    let max: u64 = __gc_ld64(st + S_MAXHEAP)
    if max != 0 && __gc_ld64(st + S_HEAP) + total > max {
        return 0
    }
    let p: u64 = __gc_mmap(total)
    if p == 0 {
        return 0
    }
    let real: u64 = (total + 4095) / 4096 * 4096
    let count: u64 = (real - CHUNK_KOPF) / block
    __gc_st64(p, __gc_ld64(st + S_CHUNKS))
    __gc_st64(p + 8, real)
    __gc_st64(p + 16, block)
    __gc_st64(p + 24, count)
    __gc_st64(p + 32, CHUNK_KOPF)
    __gc_st64(p + 40, class)
    __gc_st64(st + S_CHUNKS, p)
    __gc_st64(st + S_HEAP, __gc_ld64(st + S_HEAP) + real)
    // Alle Bloecke in die Freiliste der Klasse
    if class < KLASSEN {
        let header: u64 = st + S_FREI + class * 8
        var i: u64 = 0
        while i < count {
            let b: u64 = p + CHUNK_KOPF + i * block
            __gc_st64(b + KOPF, __gc_ld64(header))
            __gc_st64(header, b)
            i = i + 1
        }
    }
    let ph: u64 = __gc_ld64(st + S_PHASE)
    if ph == 0 {
        __gc_diag_inc(S_D_CN_RUHE)
    } else {
        if ph == 1 {
            __gc_diag_inc(S_D_CN_MARK)
        } else {
            __gc_diag_inc(S_D_CN_SWEEP)
        }
    }
    return p
}

// Zu welchem Block gehoert die Adresse? 0 = keine Heapadresse.
// Innenzeiger sind ausdruecklich erlaubt (konservativer Scan).
fn __gc_block_of(a: u64) -> u64 {
    let st: u64 = __gc_state() as u64
    let cc: u64 = __gc_ld64(st + S_CHUNK_CACHE)
    if cc != 0 {
        let daten0: u64 = cc + CHUNK_KOPF
        let ende0: u64 = daten0 + __gc_ld64(cc + 16) * __gc_ld64(cc + 24)
        if a >= daten0 && a < ende0 {
            return daten0 + (a - daten0) / __gc_ld64(cc + 16) * __gc_ld64(cc + 16)
        }
    }
    var c: u64 = __gc_ld64(st + S_CHUNKS)
    while c != 0 {
        let data: u64 = c + CHUNK_KOPF
        let block: u64 = __gc_ld64(c + 16)
        let count: u64 = __gc_ld64(c + 24)
        let end: u64 = data + block * count
        if a >= data && a < end {
            __gc_st64(st + S_CHUNK_CACHE, c)
            let idx: u64 = (a - data) / block
            return data + idx * block
        }
        c = __gc_ld64(c)
    }
    return 0
}

// Zu welchem Chunk gehoert die Adresse? 0 = keine Heapadresse. Wird nur
// selten gebraucht (Freigabe nach einem Finalisierer), deshalb ohne
// Zwischenspeicher.
fn __gc_chunk_of(a: u64) -> u64 {
    let st: u64 = __gc_state() as u64
    // Derselbe eintraegige Zwischenspeicher wie in __gc_block_von: aufeinander
    // folgende Finalisierer treffen fast immer denselben Chunk.
    let cc: u64 = __gc_ld64(st + S_CHUNK_CACHE)
    if cc != 0 {
        let d0: u64 = cc + CHUNK_KOPF
        let e0: u64 = d0 + __gc_ld64(cc + 16) * __gc_ld64(cc + 24)
        if a >= d0 && a < e0 {
            return cc
        }
    }
    var c: u64 = __gc_ld64(st + S_CHUNKS)
    while c != 0 {
        let data: u64 = c + CHUNK_KOPF
        let end: u64 = data + __gc_ld64(c + 16) * __gc_ld64(c + 24)
        if a >= data && a < end {
            __gc_st64(st + S_CHUNK_CACHE, c)
            return c
        }
        c = __gc_ld64(c)
    }
    return 0
}

// ------------------------------------------------------------- Markierung

fn __gc_mark_push(obj: u64) {
    let st: u64 = __gc_state() as u64
    let len: u64 = __gc_ld64(st + S_MLEN)
    let cap: u64 = __gc_ld64(st + S_MKAP)
    if len >= cap {
        __gc_st64(st + S_UEBERLAUF, 1)
        __gc_st64(st + S_NOV, __gc_ld64(st + S_NOV) + 1)
        return
    }
    __gc_st64(__gc_ld64(st + S_MSTACK) + len * 8, obj)
    __gc_st64(st + S_MLEN, len + 1)
}

// Kandidat (auch Innenzeiger) markieren.
fn __gc_mark(a: u64) {
    if a == 0 {
        return
    }
    let b: u64 = __gc_block_of(a)
    if b == 0 {
        return
    }
    if __gc_ld32(b) == 0 {
        return
    }
    let st: u64 = __gc_state() as u64
    // Runde 47: die Marke sind nur noch die untersten zwei Bits.
    let zw: u32 = __gc_ld32(b + 4)
    if (zw & M_MARKE) != __gc_ld64(st + S_PAR) as u32 {
        return
    }
    __gc_st32(b + 4, (zw & M_OHNE_MARKE) | 1)
    __gc_mark_push(b + KOPF)
}

// ------------------------------------------------------------- Runde 53
// Verfolgung eines SLOT-PUFFERS: der Block, in dem `GcVec`/`GcMap` ihre
// Elemente halten. Layout siehe SLOT_KOPF.
//
// `desc = schritt | (maske << 8)`: `schritt` ist die Zahl der Woerter je
// Element, Bit `j` der Maske sagt, dass Wort `j` eines Elements ein
// Gc-Zeiger ist. Damit deckt ein einziger Puffertyp alles ab, was gebraucht
// wird — `GcVec[Gc[T]]` (1/1), `GcVec[u64]` (1/0), `GcMap[Gc[K],Gc[V]]`
// (2/3), `GcMap[u64,Gc[V]]` (2/2).
//
// STUECKELUNG: ein Puffer kann Millionen Elemente tragen. In einem Stueck
// verfolgt risse er das Zeitbudget einer Markierscheibe und damit die
// Pausenzusage der Runde 44. Also hoechstens SLOT_SCHEIBE Elemente je
// Aufruf, Wiederaufnahmepunkt IM Puffer, und der Puffer legt sich selbst
// wieder auf den Markstapel. Laeuft der Markstapel dabei ueber, findet
// `__gc_nachtragen` ihn als grauen Block wieder und macht weiter — die
// Vollstaendigkeit haengt also nicht am Stapel.
//
// Rueckgabe: true = fertig verfolgt (der Aufrufer faerbt schwarz),
//            false = noch Arbeit offen (der Puffer bleibt grau).
fn __gc_trace_slots(obj: u64) -> bool {
    let n: u64 = __gc_ld64(obj)
    let desc: u64 = __gc_ld64(obj + 8)
    let mask: u64 = desc >> 8
    var i: u64 = __gc_ld64(obj + 16)
    if mask == 0 || i >= n {
        __gc_st64(obj + 16, 0)
        return true
    }
    let step: u64 = desc & 255
    let base: u64 = obj + SLOT_KOPF
    var rest: u64 = SLOT_SCHEIBE
    if step == 1 {
        // Der haeufige Fall (GcVec[Gc[T]]) ohne innere Schleife.
        while i < n && rest > 0 {
            let v: u64 = __gc_ld64(base + i * 8)
            if v != 0 {
                __gc_mark(v)
            }
            i = i + 1
            rest = rest - 1
        }
    } else {
        while i < n && rest > 0 {
            let e: u64 = base + i * step * 8
            var j: u64 = 0
            while j < step {
                if ((mask >> j) & 1) != 0 {
                    let v: u64 = __gc_ld64(e + j * 8)
                    if v != 0 {
                        __gc_mark(v)
                    }
                }
                j = j + 1
            }
            i = i + 1
            rest = rest - 1
        }
    }
    if i >= n {
        __gc_st64(obj + 16, 0)
        return true
    }
    __gc_st64(obj + 16, i)
    __gc_mark_push(obj)
    return false
}

// Praezise Verfolgung eines Objekts ueber die compilergenerierte Typtabelle.
fn __gc_trace(obj: u64) {
    let st: u64 = __gc_state() as u64
    let b: u64 = obj - KOPF
    let zw: u32 = __gc_ld32(b + 4)
    let black: u32 = (2 - __gc_ld64(st + S_PAR)) as u32
    // Runde 53: Sammlungen veraenderlicher Laenge. Ein Slot-Puffer wird
    // stueckweise verfolgt und bleibt GRAU, bis er durch ist — grau heisst
    // genau "noch nicht fertig". Der Test kostet keinen Speicherzugriff, das
    // Zustandswort wird hier ohnehin gelesen.
    if (zw & F_SLOTS) != 0 {
        if __gc_trace_slots(obj) {
            __gc_st32(b + 4, (zw & M_OHNE_MARKE) | black)
        }
        return
    }
    __gc_st32(b + 4, (zw & M_OHNE_MARKE) | black)
    let tid: u64 = __gc_ld32(b) as u64
    let tab: u64 = __gc_ld64(st + S_TABELLE)
    if tid == 0 || tid > __gc_ld64(tab) {
        return
    }
    let entry: u64 = tab + 8 + (tid - 1) * 64
    let n: u64 = __gc_ld64(entry + 16)
    let offs: u64 = __gc_ld64(entry + 24)
    var i: u64 = 0
    while i < n {
        let kind: u64 = __gc_ld64(obj + __gc_ld64(offs + i * 8))
        if kind != 0 {
            __gc_mark(kind)
        }
        i = i + 1
    }
}

fn __gc_drain() {
    let st: u64 = __gc_state() as u64
    while __gc_ld64(st + S_MLEN) > 0 {
        let len: u64 = __gc_ld64(st + S_MLEN) - 1
        __gc_st64(st + S_MLEN, len)
        let obj: u64 = __gc_ld64(__gc_ld64(st + S_MSTACK) + len * 8)
        __gc_trace(obj)
    }
}

// Nach einem Ueberlauf des Markstapels: alle grauen Bloecke im Heap suchen und
// nachtragen. Damit ist die Markierung auch ohne unbegrenzten Stapel
// vollstaendig.
fn __gc_catchup() {
    let st: u64 = __gc_state() as u64
    var next: bool = true
    while next {
        next = false
        if __gc_ld64(st + S_UEBERLAUF) == 0 {
            return
        }
        __gc_st64(st + S_UEBERLAUF, 0)
        var c: u64 = __gc_ld64(st + S_CHUNKS)
        while c != 0 {
            let data: u64 = c + CHUNK_KOPF
            let block: u64 = __gc_ld64(c + 16)
            let count: u64 = __gc_ld64(c + 24)
            var i: u64 = 0
            while i < count {
                let b: u64 = data + i * block
                if __gc_ld32(b) != 0 && (__gc_ld32(b + 4) & M_MARKE) == 1 {
                    __gc_trace(b + KOPF)
                    __gc_drain()
                    next = true
                }
                i = i + 1
            }
            c = __gc_ld64(c)
        }
    }
}

// Konservativer Scan eines Speicherbereichs (Stapel bzw. Registerrettung).
fn __gc_scan(lo: u64, hi: u64) {
    var a: u64 = (lo + 7) / 8 * 8
    while a + 8 <= hi {
        __gc_mark(__gc_ld64(a))
        a = a + 8
    }
}

// -------------------------------------------------------------------- Sweep

// Beginn des gestueckelten Fegens: Freilisten leeren, Merker setzen.
fn __gc_sweep_init() {
    let st: u64 = __gc_state() as u64
    // Runde 44: die Freilisten werden hier NICHT mehr geleert, sondern erst,
    // wenn der erste Chunk der jeweiligen Klasse gefegt wird (S_SWKL).
    //
    // WARUM: das Fegen laeuft in Scheiben, zwischen den Scheiben alloziert
    // das Programm weiter. Wurden alle Freilisten auf einen Schlag geleert,
    // fiel JEDE Allokation bis zum Ende des Fegens auf eine leere Liste und
    // musste einen frischen Chunk mmapen. Gemessen (Runde 44, Kleinlauf mit
    // 2000 lebenden Knoten, 200.000 Runden): 113 von 119 neuen Chunks
    // entstanden waehrend des Fegens, der Heap verdoppelte sich von 1,5 auf
    // 3,7 MiB und die Sammelzeit stieg von 23 auf 61 ms. Genau das war der
    // Grund, warum der inkrementelle Zyklus bei kleinem Heap teuer aussah.
    //
    // Sicher ist das, weil die Liste beim ERSTEN Chunk ihrer Klasse geleert
    // wird: danach enthaelt sie nur noch Bloecke bereits gefegter Chunks
    // derselben Klasse. Ein Block eines noch nicht gefegten Chunks kann
    // nicht doppelt vergeben werden — er faellt beim Leeren aus der Liste
    // und kommt erst wieder hinein, wenn sein Chunk gefegt ist.
    // Runde 49: die Bloecke in den Freilisten der einzelnen Faeden zurueck in
    // die globalen Listen. Ein solcher Block ist frei (Typkennung 0) und kaeme
    // beim Fegen ein zweites Mal in eine Liste — er stuende dann in zweien und
    // wuerde doppelt vergeben. Die Welt steht hier.
    __thread_lists_all_back()
    var k: u64 = 0
    while k < KLASSEN {
        __gc_st64(st + S_SWKL + k * 8, 0)
        k = k + 1
    }
    __gc_st64(st + S_SWC, __gc_ld64(st + S_CHUNKS))
    __gc_st64(st + S_SWV, 0)
    __gc_st64(st + S_SWLEB, 0)
    __gc_st64(st + S_SWLEBB, 0)
}

// Eine Fegescheibe: hoechstens SCHEIBE_SWEEP Chunks ab dem Merker.
// Rueckgabe 1 = fertig (Merker am Ende), 0 = es gibt noch Chunks.
fn __gc_sweep_step(t0: u64) -> u64 {
    let st: u64 = __gc_state() as u64
    let white: u32 = __gc_ld64(st + S_PAR) as u32
    var live: u64 = __gc_ld64(st + S_SWLEB)
    var live_bytes: u64 = __gc_ld64(st + S_SWLEBB)
    var before: u64 = __gc_ld64(st + S_SWV)
    var c: u64 = __gc_ld64(st + S_SWC)
    let weakmask: u64 = __gc_ld64(st + S_WEAKMASK)
    var probe: u64 = SCHEIBE_SWEEP
    while c != 0 {
        let next: u64 = __gc_ld64(c)
        let data: u64 = c + CHUNK_KOPF
        let block: u64 = __gc_ld64(c + 16)
        let count: u64 = __gc_ld64(c + 24)
        let class: u64 = __gc_ld64(c + 40)
        // Erster Chunk dieser Klasse in diesem Durchlauf: Freiliste leeren.
        if class < KLASSEN {
            if __gc_ld64(st + S_SWKL + class * 8) == 0 {
                __gc_st64(st + S_SWKL + class * 8, 1)
                __gc_st64(st + S_FREI + class * 8, 0)
            }
        }
        var dead: u64 = 0
        var i: u64 = 0
        // Listenkopf VOR diesem Chunk merken: die toten Bloecke werden
        // sofort eingehangen; wird der Chunk hinterher ans OS gegeben,
        // schneidet ein einziger Ruecksprung des Kopfes sein (zusammen-
        // haengendes) Segment wieder ab — kein zweiter Durchgang noetig.
        let header_addr: u64 = st + S_FREI + class * 8
        let old_header: u64 = __gc_ld64(header_addr)
        while i < count {
            let b: u64 = data + i * block
            let tid: u32 = __gc_ld32(b)
            // Das Zustandswort wird ERST gelesen, wenn der Block ueberhaupt
            // belegt ist: die weitaus meisten besuchten Bloecke sind frei
            // (tid == 0). Gegenprobe gemessen — die Typkennung stattdessen
            // zweimal zu lesen statt sie zu binden, war um 0,3 Mio.
            // Instruktionen SCHLECHTER (docs/RUNDE47.md).
            if tid != 0 && (__gc_ld32(b + 4) & M_MARKE) != white {
                // Lebt (grau oder schwarz). Die Marke bleibt STEHEN — das
                // Umschalten der Weiss-Paritaet am Zyklusende macht alle
                // Ueberlebenden in einem Zug wieder weiss, ohne dass dieser
                // Block je wieder angefasst wird.
                live = live + 1
                live_bytes = live_bytes + block
                // Runde 47: schwache Felder dieses lebenden Objekts, deren
                // Ziel in DIESEM Lauf stirbt, werden hier wirklich genullt
                // (SPEC 3.5.3 S3) — nicht erst beim naechsten `stark()`.
                // Eine Verschiebung, ein Und, ein Sprung. Bei weakmask == 0
                // (kein Programm mit schwachen Feldern) ist das Ergebnis
                // immer 0 — dann kostet die ganze Zusage NICHTS.
                if (weakmask >> ((tid as u64) - 1)) & 1 != 0 {
                    __gc_weak_clean(b, white)
                }
            } else {
                if tid != 0 {
                    // Der Finalisiererfall steht in einer eigenen Funktion:
                    // in der Fegeschleife zaehlt jede Instruktion (sie laeuft
                    // je Sammellauf ueber JEDEN Block des Heaps).
                    if (__gc_ld32(b + 4) & F_FIN) != 0 {
                        if __gc_fin_enqueue(b) != 0 {
                            live = live + 1
                            live_bytes = live_bytes + block
                            i = i + 1
                            continue
                        }
                    }
                    __gc_st32(b, 0)
                    __gc_st64(b + 8, 0)
                }
                dead = dead + 1
                if class < KLASSEN {
                    __gc_st64(b + KOPF, __gc_ld64(header_addr))
                    __gc_st64(header_addr, b)
                }
            }
            i = i + 1
        }
        // Hysterese: ein leerer Chunk wird erst zurueckgegeben, wenn er
        // ZWEI Sweeps in Folge leer war (Marke im Chunk-Kopf, Offset 48).
        // Sonst pendelt ein phasenweiser Workload zwischen munmap und mmap.
        var away: u64 = 0
        if dead == count {
            if __gc_ld64(c + 48) != 0 {
                away = 1
            } else {
                __gc_st64(c + 48, 1)
            }
        } else {
            __gc_st64(c + 48, 0)
        }
        if away == 1 {
            if class < KLASSEN {
                __gc_st64(header_addr, old_header)
            }
            let bytes: u64 = __gc_ld64(c + 8)
            if before == 0 {
                __gc_st64(st + S_CHUNKS, next)
            } else {
                __gc_st64(before, next)
            }
            __gc_st64(st + S_HEAP, __gc_ld64(st + S_HEAP) - bytes)
            if __gc_ld64(st + S_CHUNK_CACHE) == c {
                __gc_st64(st + S_CHUNK_CACHE, 0)
            }
            __gc_munmap(c, bytes)
        } else {
            before = c
        }
        c = next
        // Runde 44: das Fegen haengt nicht mehr an einer festen Chunkzahl,
        // sondern am selben Zeitbudget wie das Markieren (Runde 41). Ein
        // kleiner Heap wird damit in EINER Scheibe fertig — und nur dann
        // sieht die ausloesende Allokation wieder volle Freilisten.
        // t0 == 0 heisst: kein Zeitlimit (atomarer Vollsweep).
        probe = probe - 1
        if probe == 0 {
            probe = SCHEIBE_SWEEP
            if t0 != 0 {
                var budget: u64 = __gc_ld64(st + S_ZBUDGET)
                if budget == 0 {
                    budget = ZEIT_BUDGET_NS
                }
                if __gc_now_ns() - t0 >= budget {
                    break
                }
            }
        }
    }
    __gc_st64(st + S_SWC, c)
    __gc_st64(st + S_SWV, before)
    __gc_st64(st + S_SWLEB, live)
    __gc_st64(st + S_SWLEBB, live_bytes)
    if c == 0 {
        return 1
    }
    return 0
}

// Der ganze Sweep auf einmal (manueller Vollzyklus, Erschoepfungs-Fallback).
fn __gc_sweep() {
    __gc_sweep_init()
    while __gc_sweep_step(0) == 0 {
    }
    // Runde 47: erst die Finalisierer, dann die Buchhaltung — sie geben
    // ihre Bloecke frei und veraendern S_SWLEB/S_SWLEBB noch.
    __gc_fin_all()
    let st: u64 = __gc_state() as u64
    __gc_st64(st + S_LEBENDE, __gc_ld64(st + S_SWLEB))
    __gc_st64(st + S_LEBBYTES, __gc_ld64(st + S_SWLEBB))
}

// ---------------------------------------------------------------- Sammellauf

// Toten Stapelbereich unter dem aktuellen Rahmen nullen.
//
// WARUM: der Stapelscan ist KONSERVATIV. In den Rahmen bereits
// zurueckgekehrter Aufrufe stehen noch alte Zeiger; die Rahmen des Sammlers
// legen sich daneben und erben in nicht beschriebenen Zellen deren Inhalt.
// Ohne dieses Nullen haelt ein einzelner Zufallswert ein laengst unerreichbares
// Objekt am Leben — nachweisbar an einem GcWeak-Ziel, das nicht eingesammelt
// wird. Das ist der ehrliche Preis des konservativen Scans; hier wird er
// bezahlt, statt ihn zu verschweigen.
// Der Selbstaufruf ist Absicht: eine rekursive Funktion wird NIE eingebettet
// (inline.rs), und nur so liegen die genullten Rahmen wirklich UNTERHALB des
// Aufrufers — eingebettet waeren sie Teil seines eigenen Rahmens und wuerden
// gar nichts saeubern.
fn __gc_scrub_deep(n: u64) {
    var buffer: [u64; 512] = [0; 512]
    let p: u64 = (&buffer) as u64
    var i: u64 = 0
    while i < 512 {
        __gc_st64(p + i * 8, 0)
        i = i + 1
    }
    if n > 0 {
        __gc_scrub_deep(n - 1)
    }
}

fn __gc_scrub() {
    __gc_scrub_deep(3)
}

// RUNDE 49 — DASSELBE, ABER VOM AUFRUFER AUS.
//
// `__gc_scrub()` laeuft aus dem Rahmen von `gc_collect` heraus und saeubert
// deshalb nur, was UNTER diesem Rahmen liegt. Die toten Rahmen, die das
// Programm unmittelbar vor dem Sammellauf hinterlassen hat, liegen aber
// GENAU DORT, wo `gc_collect` seinen eigenen Rahmen hinlegt — und was der
// nicht ueberschreibt, bleibt stehen und haelt als Zufallstreffer des
// konservativen Scans tote Objekte am Leben.
//
// Ein Test, der belegen will, dass ein schwacher Verweis sein Ziel NICHT
// haelt, haengt damit an der Rahmenaufteilung des Sammlers: waechst die
// Laufzeit, kippt er. Genau das ist in Runde 47 (tests/520, 535) und wieder
// in Runde 49 (tests/833, lib/dom) passiert. Wer das ausschliessen will,
// ruft dies HIER auf — aus seinem eigenen Rahmen, VOR `gc_collect()`.
//
// Das ist kein Trick, sondern die ehrliche Bedingung: ein konservativer
// Sammler darf tote Objekte behalten. Wer das Gegenteil beweisen will, muss
// zuerst dafuer sorgen, dass wirklich kein Bitmuster mehr auf sie zeigt.
fn gc_stack_clean() {
    __gc_scrub_deep(3)
}

// RUNDE 49 — EINE ADRESSE UNTERHALB DES EIGENEN RAHMENS.
//
// BEFUND: der konservative Stapelscan begann bisher bei der Adresse einer
// LOKALEN Variablen (`var anker`). Das ist NICHT der untere Rand des Rahmens.
// Die Registerzuteilung (regalloc.rs::layout) legt die Rettungsplaetze der
// callee-saved Register ZULETZT an — sie bekommen also die groessten
// Abstaende zu `rbp` und liegen damit UNTER allen Allocas, auch unter
// `anker`. Genau dort steht aber das `rbx`/`r12`…`r15` des AUFRUFERS, und
// wenn dessen einziger Verweis auf ein Objekt in so einem Register lag, war
// das Objekt fuer den Sammler unsichtbar und wurde eingesammelt, obwohl es
// noch benutzt wurde.
//
// Sichtbar wurde das in Runde 49 an tests/820 (nur `release-fast`, also nur
// mit Registerzuteilung): eine Umstellung in `gc_collect` verschob die
// Zuteilung, und das Programm starb mit einem Speicherzugriffsfehler. Der
// Fehler ist AELTER als diese Runde; er war bisher nur nicht ausgeloest.
//
// Der Selbstaufruf ist Absicht — eine rekursive Funktion wird NIE eingebettet
// (inline.rs), also liegt ihr Rahmen wirklich UNTER dem des Aufrufers. Dieselbe
// Technik benutzt `__gc_scrub_tief` seit Runde 4.
// Der Stapelboden DIESES Fadens. Ohne Faeden ist das der des Hauptfadens
// (S_BODEN). Mit Faeden waere genau das falsch: ein Faden, der den Sammler
// fuehrt, scannte dann von SEINEM Stapelzeiger bis zum Boden des HAUPTfadens
// — quer durch nicht abgebildeten Speicher. Gemessen: Speicherzugriffsfehler
// beim ersten Zyklus, den ein Nebenfaden startet.
fn __gc_own_bottom(st: u64) -> u64 {
    let tcb: u64 = __thread_tcb()
    if tcb == 0 {
        return __gc_ld64(st + S_BODEN)
    }
    let b: u64 = __gc_ld64(tcb + FT_BODEN)
    if b == 0 {
        return __gc_ld64(st + S_BODEN)
    }
    return b
}

fn __gc_sp_below(n: u64) -> u64 {
    var a: u64 = 0
    if n > 0 {
        return __gc_sp_below(n - 1)
    }
    return (&a) as u64
}

fn __gc_collect_now() -> u64 {
    let st: u64 = __gc_state() as u64
    if __gc_ld64(st + S_INIT) != 1 {
        return 0
    }
    let t0: u64 = __gc_now_ns()
    __gc_st64(st + S_MLEN, 0)
    __gc_st64(st + S_UEBERLAUF, 0)
    // Wurzeln 1: die callee-saved Register (vom Codegenerator gerettet).
    // Runde 49: unter der Drehsperre, weil der Rettungsbereich EINER ist und
    // ein parkender Faden in denselben schreibt — und ab `+ S_REGS`, weil
    // `__gc_save_regs()` die Adresse des Blocks liefert, nicht die des
    // Bereichs (der Befund steht bei S_REGS).
    __thread_lock_raw(st + S_REGSPERRE)
    let regs: u64 = __gc_save_regs() as u64
    __gc_scan(regs + S_REGS, regs + S_REGS + 48)
    __thread_unlock_raw(st + S_REGSPERRE)
    // Wurzeln 2: der Stapel, konservativ, von hier bis zum Stapelboden.
    let sp: u64 = __gc_sp_below(0)
    __gc_scan(sp, __gc_own_bottom(st))
    // Wurzeln 3 (Runde 47): angemeldete Bereiche ausserhalb des GC-Heaps.
    __gc_roots_scan()
    // Wurzeln 4 (Runde 49): JEDER andere Faden — seine geretteten Register
    // und sein Stapel. Die Welt steht hier.
    __gc_threads_scan()
    __gc_drain()
    __gc_catchup()
    __gc_sweep()
    // Weiss-Paritaet umschalten: alle Ueberlebenden (schwarz) sind ab jetzt
    // weiss — der naechste Zyklus startet ohne Marken-Reset im Heap.
    __gc_st64(st + S_PAR, 2 - __gc_ld64(st + S_PAR))
    let t1: u64 = __gc_now_ns()
    var duration: u64 = 0
    if t1 > t0 {
        duration = t1 - t0
    }
    __gc_st64(st + S_LAEUFE, __gc_ld64(st + S_LAEUFE) + 1)
    __gc_st64(st + S_PAUSE_LAST, duration)
    if duration > __gc_ld64(st + S_PAUSE_MAX) {
        __gc_st64(st + S_PAUSE_MAX, duration)
    }
    __gc_st64(st + S_PAUSE_TOTAL, __gc_ld64(st + S_PAUSE_TOTAL) + duration)
    // Runde 41: der VOLLE Lauf ist Typ 4. Vorher buchte er nur in
    // S_PAUSE_MAX und tauchte in keiner Scheibenklasse auf — dadurch war das
    // globale Maximum (11,8 ms) groesser als jedes Typmaximum (3,6 ms) und
    // niemand konnte sehen, woher es kam.
    let tf: u64 = st + S_PMAX_START + 4 * 8
    if duration > __gc_ld64(tf) {
        __gc_st64(tf, duration)
    }
    __gc_st64(st + S_VOLL, __gc_ld64(st + S_VOLL) + 1)
    __gc_st64(st + S_SEIT, 0)
    // Naechster Sammellauf, wenn seither so viel alloziert wurde wie lebt
    // (mindestens MIN_GRENZE) — das haelt den Verbrauch beschraenkt.
    // Nach oben gekappt (MAX_GRENZE): bricht die Lebendmenge gerade massiv
    // ein (Phasenwechsel), war die alte Grenze riesig und es wurde NIE
    // wieder gesammelt — die toten Chunks der alten Phase blieben gemappt
    // (gemessen im Phasen-Test: 300 Runden, 3,8 MiB Allokation, 0 Laeufe).
    var limit: u64 = __gc_ld64(st + S_LEBBYTES)
    if limit < MIN_GRENZE {
        limit = MIN_GRENZE
    }
    if limit > MAX_GRENZE {
        limit = MAX_GRENZE
    }
    __gc_st64(st + S_GRENZE, limit)
    return duration
}

// ------------------------------------------------- Inkrementeller Zyklus

// Eine Scheibe verbuchen: die Pausen-Zaehler messen jetzt die laengste
// UNTERBRECHUNG (eine Scheibe), nicht mehr den ganzen Zyklus.
fn __gc_bucket(duration: u64) -> u64 {
    var i: u64 = 0
    var g: u64 = 1000
    while i + 1 < HIST_FAECHER {
        if duration < g {
            break
        }
        g = g * 2
        i = i + 1
    }
    return i
}

// Dieselbe Unterbrechung, aber in reiner Rechenzeit des Fadens gebucht.
fn __gc_chist_record(duration: u64) {
    let st: u64 = __gc_state() as u64
    let f: u64 = st + S_CHIST + __gc_bucket(duration) * 8
    __gc_st64(f, __gc_ld64(f) + 1)
    if duration > __gc_ld64(st + S_CSTOPMAX) {
        __gc_st64(st + S_CSTOPMAX, duration)
    }
}

fn __gc_hist_record(duration: u64, ty: u64) {
    let st: u64 = __gc_state() as u64
    let i: u64 = __gc_bucket(duration)
    let f: u64 = st + S_HIST + (ty * HIST_FAECHER + i) * 8
    __gc_st64(f, __gc_ld64(f) + 1)
    // Typ 6 ist die Summe der SCHEIBEN; die ganze Unterbrechung (Typ 7)
    // enthaelt dieselbe Zeit noch einmal und darf dort nicht mitzaehlen.
    if ty < 6 {
        let g2: u64 = st + S_HIST + (6 * HIST_FAECHER + i) * 8
        __gc_st64(g2, __gc_ld64(g2) + 1)
    }
    if ty == 7 {
        if duration > __gc_ld64(st + S_STOPMAX) {
            __gc_st64(st + S_STOPMAX, duration)
        }
    }
}

// Diagnose: wie viele EINZELNE Scheiben fielen in Fach `i` (siehe S_HIST).
// typ 0..4 wie gc_pause_max_typ, typ 5 = Nachtragen nach Markstapel-
// Ueberlauf (im Pausenmaximum steckt es unter Typ 1), typ 6 = alle
// Scheiben zusammen.
fn gc_hist(ty: u64, i: u64) -> u64 {
    if i >= HIST_FAECHER {
        return 0
    }
    if ty >= HIST_TYPEN {
        return 0
    }
    return __gc_ld64(__gc_state() as u64 + S_HIST + (ty * HIST_FAECHER + i) * 8)
}

// Histogramm nullen (Messungen ohne Aufbauphase).
fn gc_hist_reset() {
    let st: u64 = __gc_state() as u64
    var i: u64 = 0
    while i < HIST_FAECHER * HIST_TYPEN {
        __gc_st64(st + S_HIST + i * 8, 0)
        i = i + 1
    }
    __gc_st64(st + S_STOPMAX, 0)
    var j: u64 = 0
    while j < HIST_FAECHER {
        __gc_st64(st + S_CHIST + j * 8, 0)
        j = j + 1
    }
    __gc_st64(st + S_CSTOPMAX, 0)
}

// Histogramm der ganzen Unterbrechung in REINER RECHENZEIT (Faecher wie
// gc_hist). Nur belegt, wenn gc_set_cpu_uhr(1) gesetzt ist.
fn gc_chist(i: u64) -> u64 {
    if i >= HIST_FAECHER {
        return 0
    }
    return __gc_ld64(__gc_state() as u64 + S_CHIST + i * 8)
}

fn gc_cpu_stop_max() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_CSTOPMAX)
}

// Zweite Uhr einschalten (Rechenzeit statt Wanduhr). Kostet zwei zusaetzliche
// Systemaufrufe je Allokationsstelle MIT Sammlerarbeit, deshalb standardmaessig
// aus.
fn gc_set_cpu_clock(an: u64) {
    __gc_st64(__gc_state() as u64 + S_CPUUHR, an)
}

// Laengste GANZE Unterbrechung an einer Allokationsstelle (Typ 7).
fn gc_stop_max() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_STOPMAX)
}

fn __gc_pause_record(t0: u64, ty: u64) {
    __gc_pause_record_h(t0, ty, ty)
}

// Wie __gc_pause_buche, aber das Histogramm bucht auf `htyp` — damit das
// Nachtragen (Typ 1 in den Maxima) im Histogramm getrennt sichtbar wird.
fn __gc_pause_record_h(t0: u64, ty: u64, htyp: u64) {
    let st: u64 = __gc_state() as u64
    let t1: u64 = __gc_now_ns()
    var duration: u64 = 0
    if t1 > t0 {
        duration = t1 - t0
    }
    __gc_st64(st + S_PAUSE_LAST, duration)
    if duration > __gc_ld64(st + S_PZYK) {
        __gc_st64(st + S_PZYK, duration)
    }
    if duration > __gc_ld64(st + S_PAUSE_MAX) {
        __gc_st64(st + S_PAUSE_MAX, duration)
    }
    __gc_st64(st + S_PAUSE_TOTAL, __gc_ld64(st + S_PAUSE_TOTAL) + duration)
    let tfield: u64 = st + S_PMAX_START + ty * 8
    if duration > __gc_ld64(tfield) {
        __gc_st64(tfield, duration)
    }
    __gc_hist_record(duration, htyp)
}

// Runde 47: eine Finalisiererscheibe. Sie bekommt kein eigenes Fach in den
// Typmaxima (dort stehen nur die fuenf Sammlerabschnitte), sondern ein
// eigenes Feld S_PMAX_FIN — und im Histogramm zaehlt sie unter Typ 6
// ("alle Scheiben") mit, weil sie eine ist.
fn __gc_pause_record_fin(t0: u64) {
    let st: u64 = __gc_state() as u64
    let t1: u64 = __gc_now_ns()
    var duration: u64 = 0
    if t1 > t0 {
        duration = t1 - t0
    }
    __gc_st64(st + S_PAUSE_LAST, duration)
    if duration > __gc_ld64(st + S_PZYK) {
        __gc_st64(st + S_PZYK, duration)
    }
    if duration > __gc_ld64(st + S_PAUSE_MAX) {
        __gc_st64(st + S_PAUSE_MAX, duration)
    }
    __gc_st64(st + S_PAUSE_TOTAL, __gc_ld64(st + S_PAUSE_TOTAL) + duration)
    if duration > __gc_ld64(st + S_PMAX_FIN) {
        __gc_st64(st + S_PMAX_FIN, duration)
    }
    __gc_hist_record(duration, 6)
}

// Diagnose-Zugriff: laengste Pause je Scheibentyp (0 Start, 1 Mark, 2 Sweep,
// 3 Ende, 4 Voll).
fn gc_overflows() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_NOV)
}

// Anzahl VOLLER Sammellaeufe (Runde 41).
fn gc_full_runs() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_VOLL)
}

fn gc_pause_max_ty(ty: u64) -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_PMAX_START + ty * 8)
}

// Zyklus beginnen: einzige atomare Wurzelarbeit — Register und Stapel
// scannen, graue Menge fuellen. Das ist die kuerzeste denkbare Pause;
// das eigentliche Verfolgen und Fegen laeuft danach in Scheiben.
fn __gc_cycle_start() {
    let st: u64 = __gc_state() as u64
    let t0: u64 = __gc_now_ns()
    __gc_st64(st + S_MLEN, 0)
    __gc_st64(st + S_UEBERLAUF, 0)
    __gc_scrub()
    __thread_lock_raw(st + S_REGSPERRE)
    let regs: u64 = __gc_save_regs() as u64
    __gc_scan(regs + S_REGS, regs + S_REGS + 48)
    __thread_unlock_raw(st + S_REGSPERRE)
    let sp: u64 = __gc_sp_below(0)
    __gc_scan(sp, __gc_own_bottom(st))
    // Wurzeln 3 (Runde 47): angemeldete Bereiche ausserhalb des GC-Heaps.
    __gc_roots_scan()
    // Wurzeln 4 (Runde 49): JEDER andere Faden. Die Welt steht hier.
    __gc_threads_scan()
    __gc_st64(st + S_SCHRT, __gc_ld64(st + S_SEIT))
    __gc_st64(st + S_PZYK, 0)
    __gc_st64(st + S_PHASE, 1)
    __gc_pause_record(t0, 0)
}

// Zyklus abschliessen (nach dem letzten Fegeschritt): restliche Graue —
// durch Einfuegebarrieren und frische Allokationen waehrend des Fegens —
// noch verfolgen, Zaehler uebernehmen, Paritaet umschalten, Grenze neu.
fn __gc_cycle_end() {
    let st: u64 = __gc_state() as u64
    let t0: u64 = __gc_now_ns()
    __gc_drain()
    __gc_catchup()
    __gc_drain()
    __gc_st64(st + S_LEBENDE, __gc_ld64(st + S_SWLEB))
    __gc_st64(st + S_LEBBYTES, __gc_ld64(st + S_SWLEBB))
    var limit: u64 = __gc_ld64(st + S_LEBBYTES)
    if limit < MIN_GRENZE {
        limit = MIN_GRENZE
    }
    if limit > MAX_GRENZE {
        limit = MAX_GRENZE
    }
    __gc_st64(st + S_GRENZE, limit)
    __gc_st64(st + S_SEIT, 0)
    __gc_st64(st + S_SCHRT, 0)
    __gc_st64(st + S_LAEUFE, __gc_ld64(st + S_LAEUFE) + 1)
    __gc_st64(st + S_PAR, 2 - __gc_ld64(st + S_PAR))
    __gc_st64(st + S_PHASE, 0)
    __gc_pause_record(t0, 3)
    __gc_st64(st + S_PAUSE_LAST, __gc_ld64(st + S_PZYK))
}

// Ein Schritt des laufenden Zyklus, an einer Allokationsstelle aufgerufen.
fn __gc_cycle_step() {
    let st: u64 = __gc_state() as u64
    let phase: u64 = __gc_ld64(st + S_PHASE)
    if phase == 1 {
        // Markierscheibe: bis zu SCHEIBE_TRACE Objekte verfolgen.
        __gc_diag_inc(S_D_SCH_MARK)
        let t0: u64 = __gc_now_ns()
        var n: u64 = __gc_ld64(st + S_SCHEIBE)
        if n == 0 {
            n = SCHEIBE_TRACE
        }
        var budget: u64 = __gc_ld64(st + S_ZBUDGET)
        if budget == 0 {
            budget = ZEIT_BUDGET_NS
        }
        var probe: u64 = ZEIT_PROBE
        while __gc_ld64(st + S_MLEN) > 0 && n > 0 {
            let len: u64 = __gc_ld64(st + S_MLEN) - 1
            __gc_st64(st + S_MLEN, len)
            let obj: u64 = __gc_ld64(__gc_ld64(st + S_MSTACK) + len * 8)
            __gc_trace(obj)
            n = n - 1
            probe = probe - 1
            if probe == 0 {
                probe = ZEIT_PROBE
                if __gc_now_ns() - t0 >= budget {
                    n = 0
                }
            }
        }
        __gc_pause_record(t0, 1)
        if __gc_ld64(st + S_MLEN) == 0 {
            // Ueberlauf des Markstapels: graue Bloecke im Heap nachtragen
            // (atomar, aber nur wenn der Stapel uebergelaufen ist — selten).
            if __gc_ld64(st + S_UEBERLAUF) != 0 {
                let t1: u64 = __gc_now_ns()
                __gc_catchup()
                __gc_pause_record_h(t1, 1, 5)
            }
            if __gc_ld64(st + S_MLEN) == 0 {
                __gc_sweep_init()
                __gc_st64(st + S_PHASE, 2)
            }
        }
        return
    }
    if phase == 2 {
        __gc_diag_inc(S_D_SCH_SWEEP)
        let t0: u64 = __gc_now_ns()
        let done: u64 = __gc_sweep_step(t0)
        __gc_pause_record(t0, 2)
        if done == 1 {
            // Runde 47: warten Finalisierer, kommt die eigene Phase 3 dazwischen.
            if __gc_ld64(st + S_FINQ) != 0 {
                __gc_st64(st + S_PHASE, 3)
            } else {
                __gc_cycle_end()
            }
        }
        return
    }
    if phase == 3 {
        if __gc_fin_slice() == 1 {
            __gc_cycle_end()
        }
        return
    }
}

// Einen laufenden Zyklus auf einen Schlag beenden (Erschoepfungs-Fallback
// und gc_collect): Markieren fertig, Fegen fertig, Abschluss.
fn __gc_cycle_done() {
    let st: u64 = __gc_state() as u64
    let phase: u64 = __gc_ld64(st + S_PHASE)
    if phase == 1 {
        __gc_drain()
        __gc_catchup()
        __gc_sweep_init()
        __gc_st64(st + S_PHASE, 2)
    }
    if __gc_ld64(st + S_PHASE) == 2 {
        while __gc_sweep_step(0) == 0 {
        }
        __gc_st64(st + S_PHASE, 3)
    }
    if __gc_ld64(st + S_PHASE) == 3 {
        __gc_fin_all()
        __gc_cycle_end()
    }
}

// -------------------------------------------------------------- Allokation

// Der kalte Zweig der Allokation. Er steht in einer EIGENEN Funktion, damit
// `__gc_alloc_raw` genau einen zusaetzlichen Block bekommt und nicht zwei:
// gemessen kosteten die zwei Bloecke dort 3,3 Mio. Instruktionen, weil die
// Registerzuteilung in der heissesten Funktion des Sammlers kippte.
fn __gc_alloc_locked(st: u64) {
    if __gc_ld64(st + S_INIT) == 0 {
        __gc_abort(70)
    }
    __gc_error_fin_alloc()
}

// Liefert die Nutzdatenadresse (= der Wert eines `Gc[T]`) oder 0.
// Bei Erschoepfung: ERST ein Sammellauf, DANN das Scheitern.
fn __gc_alloc_raw(tid: u64, size: u64) -> *mut u8 {
    let st: u64 = __gc_state() as u64
    // S_INIT: 0 = gc_init() fehlt, 1 = bereit, 2 = ein Finalisierer laeuft.
    // Die Sperre steckt ABSICHTLICH in dieser einen, ohnehin vorhandenen
    // Pruefung — ein Finalisierer, der alloziert, wuerde einen Sammellauf
    // aus dem Sammellauf heraus starten (Reentranz), und der kostet sonst
    // jeden Allokationspfad einen zusaetzlichen Speicherzugriff.
    if __gc_ld64(st + S_INIT) != 1 {
        __gc_alloc_locked(st)
        return 0 as *mut u8
    }
    // RUNDE 49. Einfaedig kostet das genau einen Aufruf, der sofort
    // zurueckkehrt (ein Speicherzugriff, ein Sprung). Mehrfaedig steckt darin
    // der Safepoint und ENTWEDER ein fertiger Block aus der Freiliste dieses
    // Fadens (dann sind wir schon fertig, ganz ohne Sperre) ODER die genommene
    // GC-Sperre. Der Rumpf darunter bleibt Zeile fuer Zeile der alte —
    // Absicht: er bestimmt die Rahmenaufteilung, und die bestimmt beim
    // konservativen Scan, welche toten Objekte zufaellig ueberleben.
    let upfront: u64 = __gc_alloc_in(st, tid, size)
    if upfront != 0 {
        return upfront as *mut u8
    }
    let class: u64 = __gc_class_for(size)
    // Runde 44: die GANZE Unterbrechung an dieser Allokationsstelle messen.
    // Ein Bild sieht nicht die einzelne Scheibe, sondern die Summe dessen,
    // was hier hintereinander laeuft (Zyklusstart UND Scheibe UND Abschluss).
    // Die Uhr wird nur gelesen, wenn ueberhaupt Sammlerarbeit anfaellt.
    var tstop: u64 = 0
    var tcpu: u64 = 0
    if __gc_ld64(st + S_PHASE) == 0 && __gc_ld64(st + S_SEIT) >= __gc_ld64(st + S_GRENZE) {
        tstop = __gc_now_ns()
        if __gc_ld64(st + S_CPUUHR) != 0 {
            tcpu = __gc_cpu_ns()
        }
        __gc_stw_an()
        if __gc_ld64(st + S_HEAP) < __gc_ld64(st + S_INKRAB) {
            __gc_scrub()
            __gc_collect_now()
        } else {
            __gc_cycle_start()
        }
        __gc_stw_out()
    }
    if __gc_ld64(st + S_PHASE) != 0 {
        if tstop == 0 {
            tstop = __gc_now_ns()
            if __gc_ld64(st + S_CPUUHR) != 0 {
                tcpu = __gc_cpu_ns()
            }
        }
        __gc_stw_an()
        __gc_cycle_step()
        __gc_stw_out()
    }
    var b: u64 = __gc_get_block(class, size)
    if b == 0 {
        // Erst sammeln, dann scheitern (DESIGNZIELE §2): einen laufenden
        // Zyklus zuende bringen, sonst einen kompletten Lauf erzwingen.
        if tstop == 0 {
            tstop = __gc_now_ns()
            if __gc_ld64(st + S_CPUUHR) != 0 {
                tcpu = __gc_cpu_ns()
            }
        }
        __gc_stw_an()
        if __gc_ld64(st + S_PHASE) != 0 {
            __gc_cycle_done()
        } else {
            __gc_scrub()
            __gc_collect_now()
        }
        __gc_stw_out()
        b = __gc_get_block(class, size)
    }
    if tstop != 0 {
        let te: u64 = __gc_now_ns()
        var dstop: u64 = 0
        if te > tstop {
            dstop = te - tstop
        }
        __gc_hist_record(dstop, 7)
        if tcpu != 0 {
            let ce: u64 = __gc_cpu_ns()
            var dcpu: u64 = 0
            if ce > tcpu {
                dcpu = ce - tcpu
            }
            __gc_chist_record(dcpu)
        }
    }
    if b == 0 {
        __gc_alloc_out(st)
        return 0 as *mut u8
    }
    let series: u64 = __gc_ld64(st + S_SERIE) + 1
    __gc_st64(st + S_SERIE, series)
    __gc_st32(b, tid as u32)
    // Waehrend eines Zyklus frisch allokierte Objekte sind GRAU und kommen
    // auf den Markstapel: der Stapel wird nicht erneut gescannt, sonst
    // koennte ein nur stapellebendes Objekt gefegt werden, bevor es je an
    // ein Heapfeld angeschlossen wurde. In Ruhe: aktuelles Weiss.
    __gc_diag_inc(S_D_ALLOK)
    if __gc_ld64(st + S_PHASE) == 0 {
        __gc_st32(b + 4, __gc_ld64(st + S_PAR) as u32)
    } else {
        __gc_diag_inc(S_D_GRAU)
        __gc_st32(b + 4, 1)
        __gc_mark_push(b + KOPF)
    }
    __gc_st64(b + 8, series)
    // Nutzdaten nullen: ein halb gefuelltes Objekt muss jederzeit verfolgbar
    // sein (eine Feldinitialisierung kann selbst wieder allozieren).
    let obj: u64 = b + KOPF
    var i: u64 = 0
    while i < size {
        __gc_st64(obj + i, 0)
        i = i + 8
    }
    let block: u64 = __gc_ld64(st + S_BLOCKGROESSE)
    __gc_st64(st + S_SEIT, __gc_ld64(st + S_SEIT) + block)
    __gc_st64(st + S_GESAMT, __gc_ld64(st + S_GESAMT) + block)
    __gc_alloc_out(st)
    return obj as *mut u8
}

// Eintritt in die Allokation (Runde 49).
//   einfaedig  -> 0, sonst nichts
//   mehrfaedig -> Safepoint; danach entweder ein FERTIGER Block aus der
//                 Freiliste dieses Fadens (Rueckgabe != 0, KEINE Sperre
//                 genommen) oder die genommene GC-Sperre (Rueckgabe 0).
fn __gc_alloc_in(st: u64, tid: u64, size: u64) -> u64 {
    if __gc_ld64(st + S_MULTI) == 0 {
        return 0
    }
    __thread_safepoint()
    if __gc_ld64(st + S_LOKAL) != 0 {
        let p: u64 = __gc_alloc_local(st, tid, size)
        if p != 0 {
            return p
        }
    }
    __thread_lock(st + S_SPERRE)
    return 0
}

fn __gc_alloc_out(st: u64) {
    if __gc_ld64(st + S_MULTI) == 0 {
        return
    }
    __thread_unlock(st + S_SPERRE)
}

// RUNDE 49, Variante B — die Allokation OHNE Sperre.
//
// Sie ist genau dann erlaubt, wenn keine Sammlerarbeit ansteht: Phase 0, und
// die Allokationsgrenze ist noch nicht erreicht. Der Block kommt aus der
// Freiliste DIESES Fadens, sonst waere er nicht sein Eigentum.
//
// Warum das trotz laufender anderer Faeden richtig ist: eine Phase wechselt
// NUR bei stehender Welt, und die Welt steht nur, wenn kein Faden mehr
// LAUFEND ist. Dieser Faden ist waehrend der ganzen Funktion LAUFEND — also
// kann zwischen der Pruefung und dem fertigen Block keine Phase wechseln und
// keine Weiss-Paritaet umschlagen. Ein hier erzeugtes Objekt ist weiss und
// haengt am Stapel oder in einem Register dieses Fadens; beides wird beim
// naechsten Anhalten gescannt, denn der Sammler wartet, bis dieser Faden
// parkt, und scannt ihn ERST DANN.
//
// Die drei gemeinsamen Zaehler (Seriennummer, Bytes seit dem letzten Lauf,
// Gesamtbytes) laufen atomar. Ohne das waeren die Zahlen unter
// Nebenlaeufigkeit einfach falsch.
fn __gc_alloc_local(st: u64, tid: u64, size: u64) -> u64 {
    if __gc_ld64(st + S_PHASE) != 0 {
        return 0
    }
    if __gc_ld64(st + S_SEIT) >= __gc_ld64(st + S_GRENZE) {
        return 0
    }
    let class: u64 = __gc_class_for(size)
    if class >= KLASSEN {
        return 0
    }
    let tcb: u64 = __thread_tcb()
    if tcb == 0 {
        return 0
    }
    let b: u64 = __thread_block_local(tcb, class)
    if b == 0 {
        return 0
    }
    let series: u64 = __atomic_add((st + S_SERIE) as *mut u64, 1) + 1
    __gc_st32(b, tid as u32)
    __gc_st32(b + 4, __gc_ld64(st + S_PAR) as u32)
    __gc_st64(b + 8, series)
    let obj: u64 = b + KOPF
    var i: u64 = 0
    while i < size {
        __gc_st64(obj + i, 0)
        i = i + 8
    }
    let block: u64 = KOPF + __gc_classes_bytes(class)
    __atomic_add((st + S_SEIT) as *mut u64, block)
    __atomic_add((st + S_GESAMT) as *mut u64, block)
    __gc_diag_inc(S_D_ALLOK)
    return obj
}

fn __gc_get_block(class: u64, size: u64) -> u64 {
    let st: u64 = __gc_state() as u64
    // Runde 49, Variante B: solange die Sperre ohnehin gehalten wird, einen
    // SCHWUNG Bloecke in die Freiliste dieses Fadens holen. Der naechste
    // Aufruf wird dann in __gc_alloc_lokal sperrenfrei bedient.
    if __gc_ld64(st + S_LOKAL) != 0 && __gc_ld64(st + S_MULTI) != 0 {
        let bl: u64 = __gc_get_block_local(st, class, size)
        if bl != 0 {
            return bl
        }
    }
    if class >= KLASSEN {
        let c: u64 = __gc_chunk_new(class, size)
        if c == 0 {
            return 0
        }
        __gc_st64(st + S_BLOCKGROESSE, __gc_ld64(c + 16))
        return c + CHUNK_KOPF
    }
    let header: u64 = st + S_FREI + class * 8
    var b: u64 = __gc_ld64(header)
    if b == 0 {
        if __gc_chunk_new(class, size) == 0 {
            return 0
        }
        b = __gc_ld64(header)
        if b == 0 {
            return 0
        }
    }
    __gc_st64(header, __gc_ld64(b + KOPF))
    __gc_st64(st + S_BLOCKGROESSE, KOPF + __gc_classes_bytes(class))
    return b
}

// Nachfuellen und sofort einen Block liefern (Variante B). 0 = nicht moeglich.
fn __gc_get_block_local(st: u64, class: u64, size: u64) -> u64 {
    if class >= KLASSEN || __gc_ld64(st + S_PHASE) != 0 {
        return 0
    }
    let tcb: u64 = __thread_tcb()
    if tcb == 0 {
        return 0
    }
    __thread_refill(tcb, class, size)
    let b: u64 = __thread_block_local(tcb, class)
    if b == 0 {
        return 0
    }
    __gc_st64(st + S_BLOCKGROESSE, KOPF + __gc_classes_bytes(class))
    return b
}

// ------------------------------------------------------------ Schwache Verweise

struct GcWeakRaw {
    __p: u64,
    __s: u64,
}

// `weak(g)`: Zeiger VERSCHLEIERT ablegen, damit der konservative Stapelscan ihn
// nicht als starke Wurzel liest, dazu die Seriennummer des Zielblocks.
fn __gc_weak_raw(p: *mut u8) -> GcWeakRaw {
    let a: u64 = p as u64
    if a == 0 {
        return GcWeakRaw{ __p: 0, __s: 0 }
    }
    return GcWeakRaw{ __p: a ^ WEAK_XOR, __s: __gc_ld64(a - KOPF + 8) }
}

// `stark(w)`: Aufwertung. Nullwert, wenn das Ziel eingesammelt wurde — die
// Seriennummer schuetzt gegen einen inzwischen wiederverwendeten Block.
fn __gc_strong_raw(w: GcWeakRaw) -> *mut u8 {
    if w.__p == 0 {
        return 0 as *mut u8
    }
    let a: u64 = w.__p ^ WEAK_XOR
    let b: u64 = __gc_block_of(a)
    if b == 0 {
        return 0 as *mut u8
    }
    if b + KOPF != a {
        return 0 as *mut u8
    }
    if __gc_ld32(b) == 0 {
        return 0 as *mut u8
    }
    // Runde 47: ein Block, der auf seinen Finalisierer wartet oder ihn
    // gerade durchlaeuft, ist TOT. Er darf nie wieder stark werden — sonst
    // waere `stark()` der Hintereingang zur Wiederbelebung.
    if (__gc_ld32(b + 4) & F_WART) != 0 {
        return 0 as *mut u8
    }
    if __gc_ld64(b + 8) != w.__s {
        return 0 as *mut u8
    }
    return a as *mut u8
}

// ------------------------------------------------- Gepruefte Abwaertsumwandlung

fn __gc_as_raw(p: *mut u8, target: u64) -> *mut u8 {
    let a: u64 = p as u64
    if a == 0 {
        return 0 as *mut u8
    }
    let st: u64 = __gc_state() as u64
    let tab: u64 = __gc_ld64(st + S_TABELLE)
    var tid: u64 = __gc_ld32(a - KOPF) as u64
    var depth: u64 = 0
    while tid != 0 && depth < 64 {
        if tid == target {
            return p
        }
        if tid > __gc_ld64(tab) {
            return 0 as *mut u8
        }
        tid = __gc_ld64(tab + 8 + (tid - 1) * 64 + 8)
        depth = depth + 1
    }
    return 0 as *mut u8
}

// ------------------------------------------------------------ Einfuegebarriere

// Die Einfuegebarriere sitzt an genau dieser Stelle: dem Schreiben eines
// Gc-Zeigers in ein Heapfeld. Der Sammler dieser Stufe haelt an (Mark-Sweep,
// nicht inkrementell), deshalb muss hier nichts gefaerbt werden; gezaehlt wird
// trotzdem, damit der Weg nachweisbar durchlaufen wird (gc_barriers()).
fn __gc_barrier(field: *mut u8, value: *mut u8) {
    let st: u64 = __gc_state() as u64
    if (field as u64) == 0 && (value as u64) == 0 {
        return
    }
    __gc_st64(st + S_BARRIEREN, __gc_ld64(st + S_BARRIEREN) + 1)
    // Inkrementeller Zyklus: Dijkstra-Einfuegebarriere. Wird waehrend des
    // Markierens/Fegens ein Zeiger in ein Heapfeld geschrieben, wird das
    // Ziel grau — sonst koennte ein weisses Objekt hinter einem bereits
    // verfolgten (schwarzen) verschwinden, ohne je gesehen zu werden.
    if __gc_ld64(st + S_PHASE) != 0 {
        __gc_barrier_cycle(st, value)
    }
}

// Der Teil der Barriere, der NUR waehrend eines Zyklus laeuft. Er steht in
// einer eigenen Funktion, damit `__gc_barrier` klein genug bleibt, um
// eingebettet zu werden (gemessen: sonst kostet jeder Zeigerschreibzugriff
// einen echten Aufruf).
//
// WIEDERBELEBUNG: waehrend ein Finalisierer laeuft, steht S_INIT auf 2. Ein
// Gc-Zeiger, der jetzt in ein Heapfeld geschrieben wird, koennte das gerade
// sterbende Objekt zurueck in den lebenden Graphen holen — der Block wird
// aber gleich freigegeben. Also: kein stiller Zeiger ins Nichts, sondern
// sichtbarer Abbruch.
fn __gc_barrier_cycle(st: u64, value: *mut u8) {
    if __gc_ld64(st + S_INIT) != 1 {
        __gc_error_fin_again()
    }
    // Runde 49: Faerben heisst Chunkliste lesen und auf den Markstapel legen —
    // beides gehoert unter die GC-Sperre, sobald es mehr als einen Faden gibt.
    // Die Pruefung auf S_INIT steht BEWUSST davor: waehrend eines Finalisierers
    // haelt dieser Faden die Sperre schon, und ein zweites Nehmen waere ein
    // Selbstverklemmer. Der Abbruch kommt also, bevor gesperrt wird.
    if __gc_ld64(st + S_MULTI) != 0 {
        __thread_lock(st + S_SPERRE)
        __gc_mark(value as u64)
        __thread_unlock(st + S_SPERRE)
        return
    }
    __gc_mark(value as u64)
}

// ------------------------------------------------------------ Finalisierer
//
// SEMANTIK (verbindlich; Begruendungen in docs/RUNDE47.md, SPEC 3.5.3 `S4`):
//
//  1. REGISTRIERUNG je OBJEKT, nicht je Klasse: `gc_finalisierer_setzen(p, art)`
//     traegt eine AUFRAEUMART (1..16777215) in das Zustandswort des Blockkopfes
//     ein. Kein Seitentisch, keine Allokation, kein zusaetzliches Byte je
//     Objekt — und die Erkennung beim Fegen kostet nur den Test eines Bits,
//     das dort ohnehin gelesen wird.
//
//  2. WAS GERUFEN WIRD: die Funktion `__gc_finalisiere(art: u64, p: *mut u8)`.
//     Deklariert das Programm sie in seiner WURZELDATEI selbst, nimmt der
//     Compiler diese; sonst legt er eine leere Voreinstellung dazu
//     (`gc.rs::laufzeit_quelle`). Firn hat in Stufe 0 keine Funktionszeiger —
//     eine Verteilerfunktion mit einer Kennung ist die ehrliche Entsprechung
//     und braucht keinen indirekten Aufruf im Codegenerator.
//
//  3. ZEITPUNKT: NACHDEM der Sammler das Objekt als unerreichbar erkannt hat.
//     Der Zyklus hat dafuer eine eigene Phase 3, die wie Markieren und Fegen
//     in Scheiben laeuft. Ein Finalisierer selbst wird NICHT unterbrochen —
//     seine Laufzeit gehoert dem Programm, nicht dem Sammler
//     (`gc_fin_ns_max()` weist sie getrennt aus).
//
//  4. WIEDERBELEBUNG IST UNMOEGLICH — und zwar erzwungen, nicht erbeten:
//       * vor dem Aufruf werden ALLE `Gc[T]`- und `GcWeak[T]`-Felder des
//         Objekts genullt. Ein Finalisierer sieht nie einen Zeiger auf ein
//         Nachbarobjekt, das im selben Lauf schon eingesammelt sein kann;
//       * `stark(w)` auf das sterbende Objekt liefert 0 (Merker F_WART);
//       * eine GC-Allokation im Finalisierer bricht sichtbar ab (Code 71),
//         `gc_collect()` ebenso (72) — damit kann ein Finalisierer den
//         Sammler nicht reentrant aufreissen;
//       * das Schreiben eines Gc-Zeigers in ein Heapfeld bricht ab (73);
//       * der Block wird freigegeben, SOBALD der Finalisierer zurueckkehrt —
//         unabhaengig davon, was er getan hat.
//     Java-artige Auferstehung mit einem zweiten Zyklus gibt es also nicht.
//     Der Preis ist benannt: ein Finalisierer kann seinem Objekt kein
//     laengeres Leben verschaffen, auch nicht absichtlich.
//
//  5. REIHENFOLGE: keine Zusage zwischen zwei Objekten. Die Warteschlange
//     folgt der Fegereihenfolge (Chunkliste, innerhalb eines Chunks von hinten
//     nach vorn, weil vorne eingehaengt wird). Wer eine Reihenfolge braucht,
//     nimmt keinen Finalisierer.
//
//  6. HOECHSTENS EINMAL je Objekt (Merker F_GETAN).
//
//  7. Ein Programm, das gar keinen Finalisierer registriert, zahlt NICHTS:
//     der Zweig im Fegen wird nur betreten, wenn ein Block wirklich stirbt
//     UND F_FIN traegt.

fn gc_finalizer_set(p: *mut u8, kind: u64) -> bool {
    let a: u64 = p as u64
    if a == 0 {
        return false
    }
    if kind == 0 || kind > ART_MAX {
        return false
    }
    let b: u64 = __gc_block_of(a)
    if b == 0 {
        return false
    }
    if b + KOPF != a {
        return false
    }
    if __gc_ld32(b) == 0 {
        return false
    }
    let zw: u32 = __gc_ld32(b + 4)
    if (zw & F_FIN) != 0 {
        return false
    }
    __gc_st32(b + 4, (zw & M_MARKE) | F_FIN | ((kind as u32) << 8))
    let st: u64 = __gc_state() as u64
    __gc_st64(st + S_FIN_REG, __gc_ld64(st + S_FIN_REG) + 1)
    return true
}

// 0 = kein Finalisierer (oder er ist schon gelaufen).
fn gc_finalizer_kind(p: *mut u8) -> u64 {
    let a: u64 = p as u64
    if a == 0 {
        return 0
    }
    let b: u64 = __gc_block_of(a)
    if b == 0 {
        return 0
    }
    if b + KOPF != a {
        return 0
    }
    if __gc_ld32(b) == 0 {
        return 0
    }
    let zw: u32 = __gc_ld32(b + 4)
    if (zw & F_FIN) == 0 {
        return 0
    }
    if (zw & F_GETAN) != 0 {
        return 0
    }
    return (zw as u64) >> 8
}

// Registrierung zuruecknehmen. false, wenn keine da war oder das Objekt schon
// in der Warteschlange haengt — dann ist es zu spaet, und das wird gesagt.
fn gc_finalizer_delete(p: *mut u8) -> bool {
    let a: u64 = p as u64
    if a == 0 {
        return false
    }
    let b: u64 = __gc_block_of(a)
    if b == 0 {
        return false
    }
    if b + KOPF != a {
        return false
    }
    if __gc_ld32(b) == 0 {
        return false
    }
    let zw: u32 = __gc_ld32(b + 4)
    if (zw & F_FIN) == 0 {
        return false
    }
    if (zw & F_WART) != 0 {
        return false
    }
    __gc_st32(b + 4, zw & M_MARKE)
    return true
}

// Alle Zeigerfelder des Objekts nullen, bevor sein Finalisierer laeuft.
fn __gc_fields_zeros(b: u64) {
    let st: u64 = __gc_state() as u64
    let tab: u64 = __gc_ld64(st + S_TABELLE)
    let tid: u64 = __gc_ld32(b) as u64
    if tid == 0 || tid > __gc_ld64(tab) {
        return
    }
    let obj: u64 = b + KOPF
    let entry: u64 = tab + 8 + (tid - 1) * 64
    let ns: u64 = __gc_ld64(entry + 16)
    let os: u64 = __gc_ld64(entry + 24)
    var i: u64 = 0
    while i < ns {
        __gc_st64(obj + __gc_ld64(os + i * 8), 0)
        i = i + 1
    }
    let nw: u64 = __gc_ld64(entry + 32)
    let ow: u64 = __gc_ld64(entry + 40)
    var j: u64 = 0
    while j < nw {
        let wp: u64 = obj + __gc_ld64(ow + j * 8)
        __gc_st64(wp, 0)
        __gc_st64(wp + 8, 0)
        j = j + 1
    }
}

// Einen fertig finalisierten Block wirklich freigeben.
fn __gc_block_free(b: u64) {
    let st: u64 = __gc_state() as u64
    let c: u64 = __gc_chunk_of(b)
    __gc_st32(b, 0)
    __gc_st32(b + 4, 0)
    __gc_st64(b + 8, 0)
    if c == 0 {
        return
    }
    let class: u64 = __gc_ld64(c + 40)
    if class < KLASSEN {
        let header: u64 = st + S_FREI + class * 8
        __gc_st64(b + KOPF, __gc_ld64(header))
        __gc_st64(header, b)
    }
    // Beim Fegen wurde der Wartende als belegt gezaehlt (er WAR es auch) —
    // jetzt ist er es nicht mehr.
    let bl: u64 = __gc_ld64(c + 16)
    let live: u64 = __gc_ld64(st + S_SWLEB)
    if live > 0 {
        __gc_st64(st + S_SWLEB, live - 1)
    }
    let lbb: u64 = __gc_ld64(st + S_SWLEBB)
    if lbb >= bl {
        __gc_st64(st + S_SWLEBB, lbb - bl)
    }
}

// Genau einen Wartenden abarbeiten. 1 = einer lief, 0 = Schlange leer.
fn __gc_fin_a() -> u64 {
    let st: u64 = __gc_state() as u64
    let b: u64 = __gc_ld64(st + S_FINQ)
    if b == 0 {
        return 0
    }
    __gc_st64(st + S_FINQ, __gc_ld64(b + 8))
    __gc_st64(st + S_FINQ_N, __gc_ld64(st + S_FINQ_N) - 1)
    let zw: u32 = __gc_ld32(b + 4)
    let kind: u64 = (zw as u64) >> 8
    // F_WART bleibt gesetzt, solange der Finalisierer laeuft: `stark()` auf
    // dieses Objekt liefert dadurch weiterhin 0. F_GETAN kommt dazu, damit
    // es auch nach einem Abbruch nie ein zweites Mal drankommt.
    __gc_st32(b + 4, zw | F_GETAN)
    __gc_st64(b + 8, 0)
    __gc_fields_zeros(b)
    __gc_st64(st + S_INIT, 2)
    var t0: u64 = 0
    if __gc_ld64(st + S_FINUHR) != 0 {
        t0 = __gc_now_ns()
    }
    __gc_finalize(kind, (b + KOPF) as *mut u8)
    if t0 != 0 {
        let t1: u64 = __gc_now_ns()
        var d: u64 = 0
        if t1 > t0 {
            d = t1 - t0
        }
        __gc_st64(st + S_FIN_NS, __gc_ld64(st + S_FIN_NS) + d)
        if d > __gc_ld64(st + S_FIN_MAX) {
            __gc_st64(st + S_FIN_MAX, d)
        }
    }
    __gc_st64(st + S_INIT, 1)
    __gc_st64(st + S_FIN_LAEUFE, __gc_ld64(st + S_FIN_LAEUFE) + 1)
    __gc_block_free(b)
    return 1
}

// Eine Finalisiererscheibe (Phase 3). 1 = Schlange leer.
fn __gc_fin_slice() -> u64 {
    let st: u64 = __gc_state() as u64
    let t0: u64 = __gc_now_ns()
    var n: u64 = 0
    while __gc_fin_a() == 1 {
        n = n + 1
        if __gc_now_ns() - t0 >= ZEIT_BUDGET_NS {
            break
        }
    }
    if n > 0 {
        __gc_pause_record_fin(t0)
    }
    if __gc_ld64(st + S_FINQ) == 0 {
        return 1
    }
    return 0
}

// Alle Wartenden auf einen Schlag (atomarer Pfad und gc_collect).
fn __gc_fin_all() {
    let st: u64 = __gc_state() as u64
    if __gc_ld64(st + S_FINQ) == 0 {
        return
    }
    let ph: u64 = __gc_ld64(st + S_PHASE)
    __gc_st64(st + S_PHASE, 3)
    let t0: u64 = __gc_now_ns()
    var n: u64 = 0
    while __gc_fin_a() == 1 {
        n = n + 1
    }
    if n > 0 {
        __gc_pause_record_fin(t0)
    }
    __gc_st64(st + S_PHASE, ph)
}

fn gc_fin_runs() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_FIN_LAEUFE)
}

fn gc_fin_waiting() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_FINQ_N)
}

fn gc_fin_registered() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_FIN_REG)
}

fn gc_fin_ns_total() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_FIN_NS)
}

fn gc_fin_ns_max() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_FIN_MAX)
}

// Uhr je einzelnem Finalisierer einschalten (Voreinstellung aus, siehe
// S_FINUHR). Ohne sie bleiben gc_fin_ns_max/_total 0.
fn gc_set_fin_clock(an: u64) {
    __gc_st64(__gc_state() as u64 + S_FINUHR, an)
}

// Laengste Finalisiererscheibe (Sammlerarbeit + die Finalisierer, die in
// DERSELBEN Scheibe liefen).
fn gc_pause_ns_fin_max() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_PMAX_FIN)
}

// -------------------------------------------------- Schwache Felder nullen
//
// SPEC 3.5.3 `S3` verlangt, dass ein schwacher Verweis beim Einsammeln leer
// wird. Bis Runde 46 war das nur SCHEINBAR so: `stark(w)` lieferte 0, weil
// die Seriennummer nicht mehr passte — im Feld stand aber weiter das alte
// (verschleierte) Bitmuster. Seit Runde 47 nullt das Fegen die schwachen
// Felder LEBENDER Objekte wirklich.
//
// Was das NICHT kann, offen benannt: ein `GcWeak[T]` in einer lokalen
// Variablen oder in einem gewoehnlichen `struct` ausserhalb des GC-Heaps
// wird nicht angefasst — der Sammler kennt den Stapel nur konservativ und
// hat dort keine Feldkarte. Dort schuetzt weiterhin die Seriennummer, und
// `stark()` liefert 0.
fn __gc_weak_present() -> u64 {
    let st: u64 = __gc_state() as u64
    let tab: u64 = __gc_ld64(st + S_TABELLE)
    if tab == 0 {
        return 0
    }
    let n: u64 = __gc_ld64(tab)
    var i: u64 = 0
    while i < n {
        if __gc_ld64(tab + 8 + i * 64 + 32) != 0 {
            return 1
        }
        i = i + 1
    }
    return 0
}

// Bitmaske der Klassen mit schwachem Feld (siehe S_WEAKMASK).
fn __gc_weak_mask() -> u64 {
    let st: u64 = __gc_state() as u64
    let tab: u64 = __gc_ld64(st + S_TABELLE)
    if tab == 0 {
        return 0
    }
    let n: u64 = __gc_ld64(tab)
    var m: u64 = 0
    var i: u64 = 0
    var many: bool = false
    while i < n {
        if __gc_ld64(tab + 8 + i * 64 + 32) != 0 {
            if i < 64 {
                m = m | (1 << i)
            } else {
                many = true
            }
        }
        i = i + 1
    }
    // Mehr als 64 Klassen mit schwachem Feld: die Maske kann das nicht mehr
    // abbilden, also wird jedes Objekt nachgesehen (richtig, nur nicht mehr
    // ganz so billig). Alle Bits gesetzt heisst: die Verschiebung im Fegen
    // liefert immer 1, egal um wie viel verschoben wird.
    if many {
        return 18446744073709551615
    }
    return m
}

// Runde 47: einen unerreichbaren Block mit Finalisierer in die Warteschlange
// haengen. 1 = eingereiht (der Block bleibt stehen), 0 = nichts zu tun.
// Verkettet wird ueber das Seriennummernwort des toten Blocks — die
// Warteschlange braucht damit keinen eigenen Speicher und kann nicht
// ueberlaufen.
fn __gc_fin_enqueue(b: u64) -> u64 {
    let zw: u32 = __gc_ld32(b + 4)
    if (zw & F_GETAN) != 0 {
        return 0
    }
    let st: u64 = __gc_state() as u64
    __gc_st32(b + 4, zw | F_WART)
    __gc_st64(b + 8, __gc_ld64(st + S_FINQ))
    __gc_st64(st + S_FINQ, b)
    __gc_st64(st + S_FINQ_N, __gc_ld64(st + S_FINQ_N) + 1)
    return 1
}

// Ist das Ziel eines schwachen Verweises in diesem Lauf tot?
fn __gc_weak_dead(a: u64, series: u64, white: u32) -> bool {
    let tb: u64 = __gc_block_of(a)
    if tb == 0 {
        return true
    }
    if tb + KOPF != a {
        return true
    }
    if __gc_ld32(tb) == 0 {
        return true
    }
    if __gc_ld64(tb + 8) != series {
        return true
    }
    let zw: u32 = __gc_ld32(tb + 4)
    if (zw & F_WART) != 0 {
        return true
    }
    if (zw & M_MARKE) == white {
        return true
    }
    return false
}

fn __gc_weak_clean(b: u64, white: u32) {
    let st: u64 = __gc_state() as u64
    let tab: u64 = __gc_ld64(st + S_TABELLE)
    let tid: u64 = __gc_ld32(b) as u64
    if tid == 0 || tid > __gc_ld64(tab) {
        return
    }
    let entry: u64 = tab + 8 + (tid - 1) * 64
    let nw: u64 = __gc_ld64(entry + 32)
    if nw == 0 {
        return
    }
    let ow: u64 = __gc_ld64(entry + 40)
    let obj: u64 = b + KOPF
    var j: u64 = 0
    while j < nw {
        let wp: u64 = obj + __gc_ld64(ow + j * 8)
        let pv: u64 = __gc_ld64(wp)
        if pv != 0 {
            if __gc_weak_dead(pv ^ WEAK_XOR, __gc_ld64(wp + 8), white) {
                __gc_st64(wp, 0)
                __gc_st64(wp + 8, 0)
                __gc_st64(st + S_WEAK_NULL, __gc_ld64(st + S_WEAK_NULL) + 1)
            }
        }
        j = j + 1
    }
}

fn gc_weak_zeroed() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_WEAK_NULL)
}

// ------------------------------------------------- Externe Wurzelbereiche
//
// Ein Speicherbereich AUSSERHALB des GC-Heaps, der `Gc[T]`-Zeiger enthalten
// darf. Angemeldete Bereiche werden bei JEDEM Zyklusstart konservativ
// mitgescannt, genau wie der Stapel.
//
// WOZU (Runde 47): `Arc[T]` legt seinen Wert auf einer eigenen Halde ab, die
// der Sammler nicht kennt. Ohne Anmeldung waere ein `Gc[T]` in einem
// Arc-Wert fuer den Sammler unsichtbar und sein Ziel wuerde eingesammelt,
// obwohl es noch benutzt wird. Mit Anmeldung gilt die klare Arbeitsteilung:
// der Zaehler entscheidet ueber den ARC-BLOCK, der Sammler ueber die
// GC-OBJEKTE — keiner gibt frei, was dem anderen gehoert.
//
// PREIS, offen benannt: die Startpause eines Zyklus waechst mit der
// angemeldeten Gesamtgroesse (konservativer Scan, 8 Byte je Wort).
fn __gc_wroot_slot() -> bool {
    let st: u64 = __gc_state() as u64
    let n: u64 = __gc_ld64(st + S_WROOT_N)
    let cap: u64 = __gc_ld64(st + S_WROOT_KAP)
    if n < cap {
        return true
    }
    var new: u64 = cap * 2
    if new == 0 {
        new = WROOT_START
    }
    let p: u64 = __gc_mmap(new * 16)
    if p == 0 {
        return false
    }
    let old: u64 = __gc_ld64(st + S_WROOT_P)
    if old != 0 {
        var i: u64 = 0
        while i < n * 2 {
            __gc_st64(p + i * 8, __gc_ld64(old + i * 8))
            i = i + 1
        }
        __gc_munmap(old, cap * 16)
    }
    __gc_st64(st + S_WROOT_P, p)
    __gc_st64(st + S_WROOT_KAP, new)
    return true
}

// Runde 49: An- und Abmelden aendern das Wurzelfeld und laufen deshalb unter
// der GC-Sperre. Beides ist selten (einmal je Arc mit Gc-Inhalt).
fn gc_root_register(p: *mut u8, bytes: u64) -> bool {
    let a: u64 = p as u64
    if a == 0 || bytes == 0 {
        return false
    }
    if !__gc_wroot_slot() {
        return false
    }
    let st: u64 = __gc_state() as u64
    let n: u64 = __gc_ld64(st + S_WROOT_N)
    let t: u64 = __gc_ld64(st + S_WROOT_P) + n * 16
    __gc_st64(t, a)
    __gc_st64(t + 8, bytes)
    __gc_st64(st + S_WROOT_N, n + 1)
    return true
}

fn gc_root_unregister(p: *mut u8) -> bool {
    let a: u64 = p as u64
    let st: u64 = __gc_state() as u64
    let n: u64 = __gc_ld64(st + S_WROOT_N)
    let f: u64 = __gc_ld64(st + S_WROOT_P)
    if f == 0 {
        return false
    }
    var i: u64 = 0
    while i < n {
        if __gc_ld64(f + i * 16) == a {
            __gc_st64(f + i * 16, __gc_ld64(f + (n - 1) * 16))
            __gc_st64(f + i * 16 + 8, __gc_ld64(f + (n - 1) * 16 + 8))
            __gc_st64(st + S_WROOT_N, n - 1)
            return true
        }
        i = i + 1
    }
    return false
}

fn gc_roots() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_WROOT_N)
}

fn __gc_roots_scan() {
    let st: u64 = __gc_state() as u64
    let n: u64 = __gc_ld64(st + S_WROOT_N)
    if n == 0 {
        return
    }
    let f: u64 = __gc_ld64(st + S_WROOT_P)
    var i: u64 = 0
    while i < n {
        let a: u64 = __gc_ld64(f + i * 16)
        __gc_scan(a, a + __gc_ld64(f + i * 16 + 8))
        i = i + 1
    }
}

// ------------------------------------------------------------- Schnittstelle

// Einmal als Erstes in main: Heap vorbereiten, Stapelboden merken.
// false = mmap bzw. Stapelboden fehlgeschlagen; der Aufrufer MUSS dann
// sichtbar scheitern.
fn gc_init() -> bool {
    let st: u64 = __gc_state() as u64
    if __gc_ld64(st + S_INIT) != 0 {
        return true
    }
    var anker0: u64 = 0
    let sp0: u64 = (&anker0) as u64
    anker0 = 0
    var bottom: u64 = __gc_stack_bottom_maps(sp0)
    if bottom == 0 {
        bottom = __gc_stack_bottom()
    }
    if bottom == 0 || bottom <= sp0 {
        return false
    }
    let ms: u64 = __gc_mmap(MARK_BYTES)
    if ms == 0 {
        return false
    }
    __gc_st64(st + S_BODEN, bottom)
    __gc_st64(st + S_MSTACK, ms)
    __gc_st64(st + S_MKAP, MARK_BYTES / 8)
    __gc_st64(st + S_MLEN, 0)
    __gc_st64(st + S_GRENZE, MIN_GRENZE)
    __gc_st64(st + S_INKRAB, INKR_AB)
    // Runde 47: einmal feststellen, ob ueberhaupt eine Klasse ein schwaches
    // Feld hat. Programme ohne GcWeak zahlen fuers Nullen dann gar nichts.
    __gc_st64(st + S_HATWEAK, __gc_weak_present())
    __gc_st64(st + S_WEAKMASK, __gc_weak_mask())
    __gc_st64(st + S_INIT, 1)
    return true
}

// Runde 44: Umschaltschwelle (Heapbytes) zwischen atomarem und inkrementellem
// Zyklus zur Laufzeit setzen. 0 = immer inkrementell. Dient der Messung und
// laesst sich fuer Sonderfaelle stellen; Voreinstellung ist INKR_AB.
fn gc_set_incr_ab(n: u64) {
    __gc_st64(__gc_state() as u64 + S_INKRAB, n)
}

fn gc_incr_ab() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_INKRAB)
}

// Obergrenze des Heaps in Bytes; 0 = unbegrenzt. Wird die Grenze erreicht,
// sammelt der Sammler erst und meldet dann AllocError::OutOfMemory.
fn gc_set_max_bytes(n: u64) {
    __gc_st64(__gc_state() as u64 + S_MAXHEAP, n)
}

fn gc_max_bytes() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_MAXHEAP)
}

fn gc_collect() -> u64 {
    let st: u64 = __gc_state() as u64
    if __gc_ld64(st + S_INIT) != 1 {
        if __gc_ld64(st + S_INIT) == 2 {
            __gc_error_fin_collect()
        }
        return 0
    }
    let multi: u64 = __gc_ld64(st + S_MULTI)
    if multi != 0 {
        __thread_safepoint()
        __thread_lock(st + S_SPERRE)
        __gc_stw_an()
    }
    if __gc_ld64(st + S_PHASE) != 0 {
        __gc_cycle_done()
    }
    __gc_scrub()
    let d: u64 = __gc_collect_now()
    if multi != 0 {
        __gc_stw_out()
        __thread_unlock(st + S_SPERRE)
    }
    return d
}

fn gc_collections() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_LAEUFE)
}

fn gc_live_objects() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_LEBENDE)
}

fn gc_heap_bytes() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_HEAP)
}

fn gc_live_bytes() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_LEBBYTES)
}

fn gc_pause_ns_last() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_PAUSE_LAST)
}

fn gc_pause_ns_max() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_PAUSE_MAX)
}

fn gc_pause_ns_total() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_PAUSE_TOTAL)
}

// Runde 53: die Phase des laufenden Zyklus (0 Ruhe, 1 Markieren, 2 Fegen,
// 3 Finalisierer). Nur lesend — Messprogramme brauchen sie, um zu BELEGEN,
// dass ein Eintrag wirklich in eine laufende Markierung gefallen ist, statt
// es zu behaupten (tests/841_gcvec_inkrementell.fi).
// Runde 53: Scheibengroesse (Objekte je Markierscheibe) und Zeitbudget
// (ns) stellen. 0 = Voreinstellung. NUR fuer Tests und Messprogramme; im
// Normalbetrieb bleibt beides 0 und der Code ist bitgleich zu vorher.
fn gc_set_slice(n: u64) {
    __gc_st64(__gc_state() as u64 + S_SCHEIBE, n)
}

fn gc_set_time_budget(ns: u64) {
    __gc_st64(__gc_state() as u64 + S_ZBUDGET, ns)
}

fn gc_phase() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_PHASE)
}

fn gc_barriers() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_BARRIEREN)
}

fn gc_total_bytes() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_GESAMT)
}

// ==========================================================================
// RUNDE 49 — FAEDEN
// ==========================================================================
//
// Diese Haelfte der Datei ist die Laufzeit der Nebenlaeufigkeit. Sie steht
// bewusst HIER und nicht in einem eigenen Modul: sie braucht denselben
// statischen Zustandsblock wie der Sammler (Stufe 0 hat keine veraenderlichen
// globalen Variablen — genau deshalb gibt es den Block ueberhaupt), und der
// Sammler braucht sie umgekehrt, um alle Fadenstapel als Wurzeln zu sehen.
// Zwei getrennte Bloecke waeren zwei Wahrheiten ueber denselben Zustand.
//
// ENTWURF IN EINEM ABSATZ
//
//   Ein Faden entsteht mit `clone(2)` (`__faden_starten`, compiler/src/thread.rs),
//   bekommt einen eigenen mmap-Stapel mit Schutzseite und einen Fadenblock
//   (TCB), auf den sein `fs`-Register zeigt. Der Sammler fuehrt eine Tafel
//   dieser Bloecke. Ein Faden ist LAUFEND, GEPARKT (er steht in einem
//   Safepoint) oder BLOCKIERT (er wartet auf eine Sperre/einen Futex und sein
//   Stapel liegt still). Sammlerarbeit macht immer nur EIN Faden, und zwar der
//   Halter der GC-Sperre; bevor er anfaengt, haelt er die Welt an (S_STOPP=1)
//   und wartet, bis kein anderer Faden mehr LAUFEND ist. Dann scannt er JEDEN
//   Fadenstapel und die je Faden geretteten Register.
//
// DIE ZWEI REGELN, AUS DENEN DIE VERKLEMMUNGSFREIHEIT FOLGT
//
//   R1  Nur der Halter der GC-Sperre haelt die Welt an.
//   R2  Wer auf eine Sperre oder einen Futex wartet, meldet sich vorher als
//       BLOCKIERT (Stapel + Register veroeffentlicht).
//
//   Aus R2 folgt: ein Faden, der auf die GC-Sperre wartet, ist fuer das
//   Anhalten bereits "stehend". Aus R1 folgt: waehrend die Welt steht, kann
//   kein zweiter Faden ein Anhalten beginnen. Ohne R2 wuerde der Sammler auf
//   einen Faden warten, der auf ihn wartet — der klassische Verklemmer.
//
// WAS DIESE STUFE NICHT KANN (ehrlich, siehe docs/RUNDE49.md §7)
//
//   * Ein Faden, der WEDER alloziert NOCH blockiert (reine Rechenschleife),
//     erreicht keinen Safepoint. Die Welt haelt dann nicht an. Abhilfe:
//     `faden_safepoint()` von Hand in solche Schleifen. Ein Safepoint an
//     jeder Rueckwaertskante waere die vollstaendige Loesung und kostet den
//     einfaedigen Fall — das ist eine Codegenerator-Runde, nicht diese.
//   * `Gc[T]` ueber Fadengrenzen ist NICHT zugesagt (SPEC §7). Der Sammler
//     ist jetzt fadensicher, die SPRACHE hat aber noch keine `#[sendable]`-
//     Markierung, die das pruefen wuerde.

const SYS_MPROTECT: i64 = 10
const SYS_SCHED_YIELD: i64 = 24
const SYS_GETTID: i64 = 186
const SYS_ARCH_PRCTL: i64 = 158
const SYS_FUTEX: i64 = 202
const SYS_NANOSLEEP: i64 = 35
const ARCH_SET_FS: i64 = 4098
// FUTEX_WAIT/FUTEX_WAKE, jeweils mit FUTEX_PRIVATE_FLAG (128): der Futex
// gehoert nur diesem Prozess, der Kern spart sich die Abbildung auf ein
// globales Schluesselobjekt.
const FUTEX_WARTEN: i64 = 128
const FUTEX_WECKEN: i64 = 129
// Zweierkomplement von 1 (Erniedrigen ist die Addition davon, wie in arc.fi).
const FADEN_MINUS1: u64 = 18446744073709551615

// Fadenblock (TCB), 512 Byte. Offset 0 ist die eigene Adresse: `fs:0` liefert
// damit den Block in EINER Instruktion (compiler/src/thread.rs, Op::ThreadSelf).
const FT_SELBST: u64 = 0
const FT_ZUSTAND: u64 = 8
// Die Fadenkennung. Der Kern SCHREIBT sie beim Start (CLONE_PARENT_SETTID)
// und NULLT sie beim Fadenende (CLONE_CHILD_CLEARTID) — auf genau dieses
// Wort wartet `faden_warten`. Es ist ein 32-Bit-Wort (der Kern schreibt
// `int`), liegt aber in einem 64-Bit-Platz.
const FT_TID: u64 = 16
const FT_STAPEL: u64 = 24
const FT_STAPELN: u64 = 32
const FT_BODEN: u64 = 40
const FT_SP: u64 = 48
const FT_ARG: u64 = 56
const FT_ART: u64 = 64
const FT_ERG: u64 = 72
// 6 callee-saved Register (rbx, rbp, r12..r15), je Faden.
const FT_REGS: u64 = 80
// Freilisten dieses Fadens (Variante B, `gc_set_lokal(1)`): je Groessenklasse
// eine Liste, dazu die Anzahl der darin liegenden Bloecke.
const FT_FREI: u64 = 128
const FT_FREIN: u64 = 240
const FT_BYTES: u64 = 512
const FADEN_MAX: u64 = 64
// Voreinstellung der Stapelgroesse je Faden (1 MiB, davon 4 KiB Schutzseite).
const STAPEL_BYTES: u64 = 1048576

const Z_FREI: u64 = 0
const Z_LAUFEND: u64 = 1
const Z_GEPARKT: u64 = 2
const Z_BLOCKIERT: u64 = 3
const Z_TOT: u64 = 4

// -------------------------------------------------------------- Systemdienste

fn __thread_gettid() -> u64 {
    return syscall(SYS_GETTID, 0, 0, 0, 0, 0, 0) as u64
}

fn __thread_yield() {
    syscall(SYS_SCHED_YIELD, 0, 0, 0, 0, 0, 0)
}

fn __thread_futex_wait(a: u64, v: u64) {
    syscall(SYS_FUTEX, a as i64, FUTEX_WARTEN, v as i64, 0, 0, 0)
}

// Warten OHNE FUTEX_PRIVATE_FLAG. Das ist kein Schoenheitsfehler, sondern
// Pflicht fuer genau EINEN Fall: das TID-Wort. Der KERN weckt es beim
// Fadenende selbst (CLONE_CHILD_CLEARTID) und benutzt dafuer den GETEILTEN
// Futex-Schluessel. Ein privater Warter haengt an einem anderen Schluessel und
// wird nie geweckt — gemessen: `faden_warten` blieb fuer immer stehen,
// obwohl der Faden laengst zu Ende war.
fn __thread_futex_wait_split(a: u64, v: u64) {
    syscall(SYS_FUTEX, a as i64, 0, v as i64, 0, 0, 0)
}

fn __thread_futex_wake(a: u64, n: u64) {
    syscall(SYS_FUTEX, a as i64, FUTEX_WECKEN, n as i64, 0, 0, 0)
}

// --------------------------------------------------------------- Fadenblock

// Der eigene Fadenblock — 0, solange keine Fadentafel besteht. Die Abfrage
// auf die Tafel ist NICHT Zierde: ohne `arch_prctl(ARCH_SET_FS)` ist die
// `fs`-Basis 0 und `fs:0` waere ein Zugriff auf Adresse 0.
fn __thread_tcb() -> u64 {
    let st: u64 = __gc_state() as u64
    if __gc_ld64(st + S_FADEN_TAB) == 0 {
        return 0
    }
    return __thread_self() as u64
}

// ------------------------------------------------------------------- Sperren
//
// Mutex nach Drepper („Futexes are Tricky"), drei Zustaende:
//   0 = frei · 1 = belegt, kein Warter · 2 = belegt, mindestens ein Warter
// Im unbestrittenen Fall kostet Nehmen und Geben je EINE atomare Instruktion
// und KEINEN Systemaufruf.

// Tausch ohne eigenes Primitiv. `xchg` waere eine Instruktion; dafuer haette
// es einen vierten Opcode gebraucht (docs/RUNDE49.md §2.3 — verworfen, weil
// die Schleife nur im bestrittenen Fall laeuft).
fn __thread_swap(a: u64, new: u64) -> u64 {
    var old: u64 = __gc_ld64(a)
    var done: bool = false
    while !done {
        let g: u64 = __atomic_swap(a as *mut u64, old, new)
        if g == old {
            done = true
        } else {
            old = g
        }
    }
    return old
}

// Reine Drehsperre OHNE Zustandsmeldung. Nur fuer sehr kurze Abschnitte, die
// selbst Teil der Zustandsmeldung sind (sonst gaebe es eine Rekursion).
fn __thread_lock_raw(a: u64) {
    var i: u64 = 0
    var g: u64 = __atomic_swap(a as *mut u64, 0, 1)
    while g != 0 {
        i = i + 1
        if i > 64 {
            __thread_yield()
        }
        g = __atomic_swap(a as *mut u64, 0, 1)
    }
}

fn __thread_unlock_raw(a: u64) {
    __atomic_add(a as *mut u64, FADEN_MINUS1)
}

fn __thread_lock(a: u64) {
    let g: u64 = __atomic_swap(a as *mut u64, 0, 1)
    if g == 0 {
        return
    }
    __thread_lock_slow(a)
}

fn __thread_lock_slow(a: u64) {
    let st: u64 = __gc_state() as u64
    __gc_st64(st + S_SPERR_W, __gc_ld64(st + S_SPERR_W) + 1)
    // REGEL R2: wer wartet, meldet sich als BLOCKIERT. Ohne das kann die Welt
    // nicht anhalten, solange ein Faden auf die GC-Sperre wartet.
    __thread_blocked_an()
    var c: u64 = __thread_swap(a, 2)
    while c != 0 {
        __thread_futex_wait(a, 2)
        c = __thread_swap(a, 2)
    }
    __thread_blocked_out()
}

fn __thread_unlock(a: u64) {
    // Ergebnis ist der ALTE Wert: war er 1, gab es keinen Warter und das Wort
    // steht jetzt auf 0. War er 2, muss es auf 0 gesetzt und geweckt werden.
    let old: u64 = __atomic_add(a as *mut u64, FADEN_MINUS1)
    if old != 1 {
        __gc_st64(a, 0)
        __thread_futex_wake(a, 1)
    }
}

// Oeffentlich: ein Mutex ist ein genulltes u64-Wort, mehr nicht.
fn thread_lock(a: *mut u64) {
    __thread_lock(a as u64)
}

fn thread_unlock(a: *mut u64) {
    __thread_unlock(a as u64)
}

// ------------------------------------------------------- Zustand veroeffentlichen

// Der Faden macht seinen Stapel und seine Register fuer den Sammler lesbar
// und geht in den Zustand `z`.
//
// WARUM DIE REGISTER UEBER DEN GLOBALEN BEREICH LAUFEN: `__gc_save_regs()` ist
// ein Compilerintrinsic, das an seiner Aufrufstelle EINGEBETTET wird und die
// callee-saved Register in den Zustandsblock schreibt — es gibt genau einen
// solchen Bereich. Zwei Faeden, die gleichzeitig retten, wuerden sich
// ueberschreiben; deshalb die kurze Drehsperre. Der Bereich wird sofort in den
// eigenen Fadenblock kopiert, und erst der wird gescannt.
//
// Und warum ueberhaupt: ein `Gc[T]`, das nur in `rbx` steht, liegt auf KEINEM
// Stapel. Ohne diese Rettung waere die Zusage „konservativer Stapel- UND
// Registerscan" (SPEC §3.5.3) fuer jeden Faden ausser dem Sammler falsch.
fn __thread_state_report(z: u64) {
    let tcb: u64 = __thread_tcb()
    if tcb == 0 {
        return
    }
    let st: u64 = __gc_state() as u64
    __thread_lock_raw(st + S_REGSPERRE)
    let g: u64 = __gc_save_regs() as u64
    var i: u64 = 0
    while i < 6 {
        __gc_st64(tcb + FT_REGS + i * 8, __gc_ld64(g + S_REGS + i * 8))
        i = i + 1
    }
    __thread_unlock_raw(st + S_REGSPERRE)
    let sp: u64 = __gc_sp_below(0)
    __gc_st64(tcb + FT_SP, sp)
    __gc_st64(tcb + FT_ZUSTAND, z)
}

fn __thread_blocked_an() {
    __thread_state_report(Z_BLOCKIERT)
}

// Zurueck in den Zustand LAUFEND. Die Reihenfolge ist wichtig: ERST sichtbar
// machen, dass wieder gerechnet wird, DANN pruefen, ob die Welt steht. In der
// umgekehrten Reihenfolge koennte zwischen Pruefung und Zustandswechsel ein
// Anhalten beginnen, und dieser Faden liefe waehrend des Wurzelscans weiter.
fn __thread_blocked_out() {
    let tcb: u64 = __thread_tcb()
    if tcb == 0 {
        return
    }
    __gc_st64(tcb + FT_ZUSTAND, Z_LAUFEND)
    __thread_safepoint()
}

// ---------------------------------------------------------------- Safepoint

fn __thread_safepoint() {
    let st: u64 = __gc_state() as u64
    if __gc_ld64(st + S_STOPP) == 0 {
        return
    }
    __thread_park()
}

fn __thread_park() {
    let st: u64 = __gc_state() as u64
    __thread_state_report(Z_GEPARKT)
    while __gc_ld64(st + S_STOPP) != 0 {
        __thread_futex_wait(st + S_STOPP, 1)
    }
    let tcb: u64 = __thread_tcb()
    if tcb != 0 {
        __gc_st64(tcb + FT_ZUSTAND, Z_LAUFEND)
    }
}

// Oeffentlich: in eine lange Rechenschleife ohne Allokation gehoert das hier,
// sonst wartet ein Sammellauf auf diesen Faden (siehe Kopfkommentar).
fn thread_safepoint() {
    __thread_safepoint()
}

// Oeffentlich: um JEDEN blockierenden Systemaufruf, den ein Faden selbst
// macht (lesen, schreiben, schlafen, warten). Dazwischen gilt sein Stapel als
// stillstehend, der Sammler darf ihn scannen und muss nicht auf ihn warten.
//
// WARUM DAS NOETIG IST — gemessen, nicht vermutet: der erste Dauerlauf dieser
// Runde kam in 20 Sekunden auf 112 Runden statt auf Hunderttausende. Der
// Hauptfaden schlief zwischen den Stichproben in `nanosleep` und galt dabei
// als LAUFEND; jedes Anhalten der Welt wartete auf ihn, bis er von selbst
// aufwachte. Die laengste Wartezeit bis die Welt stand war 19,997 s — also
// praktisch der ganze Lauf. Mit diesen beiden Aufrufen um den Schlaf herum
// sind es Mikrosekunden.
fn thread_blocking_an() {
    __thread_blocked_an()
}

fn thread_blocking_out() {
    __thread_blocked_out()
}

// Schlafen und dabei als blockiert gelten. `ms` in Millisekunden.
fn thread_sleep(ms: u64) {
    var ts: [i64; 2] = [0; 2]
    ts[0] = (ms / 1000) as i64
    ts[1] = ((ms % 1000) * 1000000) as i64
    __thread_blocked_an()
    syscall(SYS_NANOSLEEP, (&ts) as i64, 0, 0, 0, 0, 0)
    __thread_blocked_out()
}

// ------------------------------------------------------------ Welt anhalten

// Vorbedingung: der Aufrufer HAELT die GC-Sperre (Regel R1).
fn __gc_stw_an() {
    let st: u64 = __gc_state() as u64
    if __gc_ld64(st + S_MULTI) == 0 {
        return
    }
    let t0: u64 = __gc_now_ns()
    __gc_st64(st + S_STOPP, 1)
    let slf: u64 = __thread_tcb()
    let tab: u64 = __gc_ld64(st + S_FADEN_TAB)
    var i: u64 = 0
    while i < FADEN_MAX {
        let t: u64 = tab + i * FT_BYTES
        if t != slf {
            var n: u64 = 0
            while __gc_ld64(t + FT_ZUSTAND) == Z_LAUFEND {
                n = n + 1
                if n > 16 {
                    __thread_yield()
                }
            }
        }
        i = i + 1
    }
    let t1: u64 = __gc_now_ns()
    var d: u64 = 0
    if t1 > t0 {
        d = t1 - t0
    }
    __gc_st64(st + S_STW_N, __gc_ld64(st + S_STW_N) + 1)
    __gc_st64(st + S_STW_WARTE, __gc_ld64(st + S_STW_WARTE) + d)
    if d > __gc_ld64(st + S_STW_MAX) {
        __gc_st64(st + S_STW_MAX, d)
    }
    __gc_st64(st + S_STW_T0, t1)
}

fn __gc_stw_out() {
    let st: u64 = __gc_state() as u64
    if __gc_ld64(st + S_MULTI) == 0 {
        return
    }
    let t1: u64 = __gc_now_ns()
    let t0: u64 = __gc_st_t0(st)
    if t1 > t0 {
        let d: u64 = t1 - t0
        __gc_st64(st + S_STW_NS, __gc_ld64(st + S_STW_NS) + d)
        if d > __gc_ld64(st + S_STW_ARBEIT_MAX) {
            __gc_st64(st + S_STW_ARBEIT_MAX, d)
        }
    }
    __gc_st64(st + S_STOPP, 0)
    __thread_futex_wake(st + S_STOPP, FADEN_MAX)
}

fn __gc_st_t0(st: u64) -> u64 {
    return __gc_ld64(st + S_STW_T0)
}

// ------------------------------------------------------- Fadenstapel als Wurzeln

// Alle ANDEREN Faeden konservativ scannen: erst ihre geretteten Register,
// dann ihren Stapel von dem Zeiger, den sie beim Anhalten veroeffentlicht
// haben, bis zu ihrem Stapelboden. Vorbedingung: die Welt steht.
//
// Ein toter Faden (Z_TOT) wird nicht mehr ueber den Stapel gescannt — er hat
// keinen mehr, der etwas hielte. Sein ERGEBNISWORT wird aber gescannt: es
// steht bis zum `faden_warten` in seinem Block und waere sonst die einzige
// Stelle im ganzen System, an der ein Wert unbemerkt verschwaende.
fn __gc_threads_scan() {
    let st: u64 = __gc_state() as u64
    if __gc_ld64(st + S_MULTI) == 0 {
        return
    }
    let tab: u64 = __gc_ld64(st + S_FADEN_TAB)
    if tab == 0 {
        return
    }
    let slf: u64 = __thread_tcb()
    var i: u64 = 0
    while i < FADEN_MAX {
        let t: u64 = tab + i * FT_BYTES
        let z: u64 = __gc_ld64(t + FT_ZUSTAND)
        if t != slf && z != Z_FREI {
            __gc_scan(t + FT_REGS, t + FT_REGS + 48)
            __gc_scan(t + FT_ERG, t + FT_ERG + 8)
            if z != Z_TOT {
                let sp: u64 = __gc_ld64(t + FT_SP)
                let bottom: u64 = __gc_ld64(t + FT_BODEN)
                if sp != 0 && bottom > sp {
                    __gc_scan(sp, bottom)
                }
            }
        }
        i = i + 1
    }
}

// --------------------------------------------------------------- Fadentafel

fn __thread_slot_new(st: u64) -> u64 {
    let tab: u64 = __gc_ld64(st + S_FADEN_TAB)
    var i: u64 = 1
    while i < FADEN_MAX {
        let t: u64 = tab + i * FT_BYTES
        if __gc_ld64(t + FT_ZUSTAND) == Z_FREI {
            return t
        }
        i = i + 1
    }
    return 0
}

// Einmal vor dem ersten `faden_starten`. Meldet den HAUPTFADEN an — ohne das
// wuesste der Sammler von dessen Stapel nichts, sobald es einen zweiten Faden
// gibt. Idempotent.
fn thread_init() -> bool {
    let st: u64 = __gc_state() as u64
    if __gc_ld64(st + S_FADEN_TAB) != 0 {
        return true
    }
    if __gc_ld64(st + S_INIT) != 1 {
        if !gc_init() {
            return false
        }
    }
    let tab: u64 = __gc_mmap(FADEN_MAX * FT_BYTES)
    if tab == 0 {
        return false
    }
    __gc_st64(tab + FT_SELBST, tab)
    __gc_st64(tab + FT_ZUSTAND, Z_LAUFEND)
    __gc_st64(tab + FT_BODEN, __gc_ld64(st + S_BODEN))
    __gc_st64(tab + FT_TID, __thread_gettid())
    __gc_st64(st + S_HAUPT, tab)
    __gc_st64(st + S_FADEN_MAX, FADEN_MAX)
    __gc_st64(st + S_FADEN_N, 1)
    if __gc_ld64(st + S_STAPELN) == 0 {
        __gc_st64(st + S_STAPELN, STAPEL_BYTES)
    }
    // ERST die `fs`-Basis setzen, DANN die Tafel eintragen: `__faden_tcb()`
    // liest `fs:0`, sobald die Tafel steht. Andersherum waere zwischen den
    // beiden Zeilen ein Zugriff auf Adresse 0 moeglich.
    syscall(SYS_ARCH_PRCTL, ARCH_SET_FS, tab as i64, 0, 0, 0, 0)
    __gc_st64(st + S_FADEN_TAB, tab)
    return true
}

// Stapelgroesse je Faden in Bytes (vor dem ersten `faden_starten` zu setzen).
fn thread_stack_set(n: u64) {
    __gc_st64(__gc_state() as u64 + S_STAPELN, n)
}

// Einen Faden starten. `art` und `arg` gehen unveraendert an den Verteiler
// `__faden_arbeit(art, arg)` des Programms — dieselbe Loesung wie beim
// Verteiler der Finalisierer (Runde 47), weil Stufe 0 keine Funktionszeiger
// hat. Rueckgabe: das Handle (1..63) fuer `faden_warten`, 0 = fehlgeschlagen.
fn thread_start(kind: u64, arg: u64) -> u64 {
    let st: u64 = __gc_state() as u64
    if __gc_ld64(st + S_FADEN_TAB) == 0 {
        if !thread_init() {
            return 0
        }
    }
    __thread_safepoint()
    __thread_lock(st + S_TSPERRE)
    let tcb: u64 = __thread_slot_new(st)
    if tcb == 0 {
        __thread_unlock(st + S_TSPERRE)
        return 0
    }
    let n: u64 = __gc_ld64(st + S_STAPELN)
    let sp: u64 = __gc_mmap(n)
    if sp == 0 {
        __thread_unlock(st + S_TSPERRE)
        return 0
    }
    // Schutzseite ganz unten: ein Stapelueberlauf endet mit einem sauberen
    // Speicherzugriffsfehler statt mit stiller Zerstoerung fremden Speichers.
    syscall(SYS_MPROTECT, sp as i64, 4096, 0, 0, 0, 0)
    __gc_st64(tcb + FT_SELBST, tcb)
    __gc_st64(tcb + FT_STAPEL, sp)
    __gc_st64(tcb + FT_STAPELN, n)
    __gc_st64(tcb + FT_BODEN, sp + n)
    __gc_st64(tcb + FT_SP, sp + n)
    __gc_st64(tcb + FT_ARG, arg)
    __gc_st64(tcb + FT_ART, kind)
    __gc_st64(tcb + FT_ERG, 0)
    __gc_st64(tcb + FT_TID, 0)
    __gc_st64(tcb + FT_FREIN, 0)
    var i: u64 = 0
    while i < 6 {
        __gc_st64(tcb + FT_REGS + i * 8, 0)
        i = i + 1
    }
    var k: u64 = 0
    while k < KLASSEN {
        __gc_st64(tcb + FT_FREI + k * 8, 0)
        k = k + 1
    }
    // Der Platz gilt AB JETZT als laufender Faden. Andersherum koennte ein
    // Anhalten der Welt zwischen `clone` und der ersten Meldung des Kindes
    // fallen, und sein Stapel bliebe ungescannt.
    __gc_st64(tcb + FT_ZUSTAND, Z_LAUFEND)
    __gc_st64(st + S_FADEN_N, __gc_ld64(st + S_FADEN_N) + 1)
    __gc_st64(st + S_FADEN_GES, __gc_ld64(st + S_FADEN_GES) + 1)
    // Ab hier laeuft der Sammler im Mehrfadenbetrieb. Der Schalter geht NIE
    // wieder zurueck: ein Wechsel waehrend eines laufenden Zyklus waere ein
    // Wettrennen ohne Nutzen (docs/RUNDE49.md §4.2).
    __gc_st64(st + S_MULTI, 1)
    let r: i64 = __thread_start(tcb, sp + n, (tcb + FT_TID) as *mut u8)
    if r <= 0 {
        __gc_st64(tcb + FT_ZUSTAND, Z_FREI)
        __gc_st64(st + S_FADEN_N, __gc_ld64(st + S_FADEN_N) - 1)
        __gc_munmap(sp, n)
        __thread_unlock(st + S_TSPERRE)
        return 0
    }
    __thread_unlock(st + S_TSPERRE)
    return (tcb - __gc_ld64(st + S_FADEN_TAB)) / FT_BYTES
}

// Der Einstieg, den das Kind aus der `clone`-Folge heraus ruft
// (compiler/src/thread.rs, `EINSTIEG`). Argument ist der Fadenblock.
fn __thread_entry(tcb: u64) -> i32 {
    // Als Allererstes die eigene `fs`-Basis: davor liefert `__faden_selbst()`
    // die des Erzeugers, und der Faden wuerde in fremden Zustand schreiben.
    syscall(SYS_ARCH_PRCTL, ARCH_SET_FS, tcb as i64, 0, 0, 0, 0)
    __gc_st64(tcb + FT_ZUSTAND, Z_LAUFEND)
    let r: u64 = __thread_work(__gc_ld64(tcb + FT_ART), __gc_ld64(tcb + FT_ARG))
    __gc_st64(tcb + FT_ERG, r)
    // Lokale Freilisten zurueckgeben, sonst waeren ihre Bloecke bis zum
    // naechsten Fegen weder frei noch belegt.
    __thread_lists_back(tcb)
    __gc_st64(tcb + FT_ZUSTAND, Z_TOT)
    let st: u64 = __gc_state() as u64
    __atomic_add((st + S_FADEN_N) as *mut u64, FADEN_MINUS1)
    return 0
}

// Auf das Ende eines Fadens warten und sein Ergebnis holen. Der Kern nullt
// beim Fadenende das TID-Wort und weckt darauf — genau der Mechanismus, mit
// dem auch `pthread_join` arbeitet, nur ohne pthread.
fn thread_wait(h: u64) -> u64 {
    let st: u64 = __gc_state() as u64
    let tab: u64 = __gc_ld64(st + S_FADEN_TAB)
    if tab == 0 || h == 0 || h >= FADEN_MAX {
        return 0
    }
    let tcb: u64 = tab + h * FT_BYTES
    __thread_blocked_an()
    var t: u32 = __gc_ld32(tcb + FT_TID)
    while t != 0 {
        __thread_futex_wait_split(tcb + FT_TID, t as u64)
        t = __gc_ld32(tcb + FT_TID)
    }
    __thread_blocked_out()
    let r: u64 = __gc_ld64(tcb + FT_ERG)
    let sp: u64 = __gc_ld64(tcb + FT_STAPEL)
    let n: u64 = __gc_ld64(tcb + FT_STAPELN)
    __gc_st64(tcb + FT_STAPEL, 0)
    __gc_st64(tcb + FT_SP, 0)
    __gc_st64(tcb + FT_BODEN, 0)
    __gc_st64(tcb + FT_ERG, 0)
    __gc_st64(tcb + FT_ZUSTAND, Z_FREI)
    if sp != 0 {
        __gc_munmap(sp, n)
    }
    return r
}

fn thread_count() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_FADEN_N)
}

fn thread_started() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_FADEN_GES)
}

fn thread_multithreaded() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_MULTI)
}

fn thread_tid() -> u64 {
    return __thread_gettid()
}

// Diagnose: Anlaeufe, laengste Wartezeit bis die Welt stand, laengste Zeit
// mit stehender Welt, Summe, Sperrenwartungen.
fn gc_stw_runs() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_STW_N)
}

fn gc_stw_wait_max() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_STW_MAX)
}

fn gc_stw_work_max() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_STW_ARBEIT_MAX)
}

fn gc_stw_ns_total() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_STW_NS)
}

fn gc_lock_maintenance() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_SPERR_W)
}

fn gc_local_refills() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_LOKAL_N)
}

// ------------------------------------------------- Freilisten pro Faden (B)
//
// Variante B der Allokation: statt fuer JEDE Allokation die GC-Sperre zu
// nehmen, holt sich ein Faden unter der Sperre einen SCHWUNG Bloecke in seine
// eigene Liste und bedient sich daraus sperrenfrei. Die Messung, welche der
// beiden Varianten gewinnt, steht in docs/RUNDE49.md §5 — deshalb sind beide
// da und zur Laufzeit umschaltbar (`gc_set_lokal`), im selben Prozess und mit
// bitgleichem Code.

fn gc_set_local(an: u64) {
    __gc_st64(__gc_state() as u64 + S_LOKAL, an)
}

fn gc_local() -> u64 {
    return __gc_ld64(__gc_state() as u64 + S_LOKAL)
}

// Einen Block aus der eigenen Liste; 0 = leer.
fn __thread_block_local(tcb: u64, class: u64) -> u64 {
    let header: u64 = tcb + FT_FREI + class * 8
    let b: u64 = __gc_ld64(header)
    if b == 0 {
        return 0
    }
    __gc_st64(header, __gc_ld64(b + KOPF))
    __gc_st64(tcb + FT_FREIN, __gc_ld64(tcb + FT_FREIN) - 1)
    return b
}

// Nachfuellen: unter der GC-Sperre bis zu SCHWUNG Bloecke aus der globalen
// Liste in die eigene haengen.
fn __thread_refill(tcb: u64, class: u64, size: u64) -> u64 {
    let st: u64 = __gc_state() as u64
    let source: u64 = st + S_FREI + class * 8
    let target: u64 = tcb + FT_FREI + class * 8
    var n: u64 = 0
    while n < SCHWUNG {
        var b: u64 = __gc_ld64(source)
        if b == 0 {
            if __gc_chunk_new(class, size) == 0 {
                n = SCHWUNG
            } else {
                b = __gc_ld64(source)
            }
        }
        if b != 0 {
            __gc_st64(source, __gc_ld64(b + KOPF))
            __gc_st64(b + KOPF, __gc_ld64(target))
            __gc_st64(target, b)
            __gc_st64(tcb + FT_FREIN, __gc_ld64(tcb + FT_FREIN) + 1)
            n = n + 1
        } else {
            n = SCHWUNG
        }
    }
    __gc_st64(st + S_LOKAL_N, __gc_ld64(st + S_LOKAL_N) + 1)
    return __gc_ld64(target)
}

// Alle lokalen Listen eines Fadens zurueck in die globalen. Aufrufer haelt
// entweder die GC-Sperre oder die Welt steht.
fn __thread_lists_back(tcb: u64) {
    let st: u64 = __gc_state() as u64
    if __gc_ld64(tcb + FT_FREIN) == 0 {
        return
    }
    var k: u64 = 0
    while k < KLASSEN {
        let header: u64 = tcb + FT_FREI + k * 8
        var b: u64 = __gc_ld64(header)
        while b != 0 {
            let n: u64 = __gc_ld64(b + KOPF)
            __gc_st64(b + KOPF, __gc_ld64(st + S_FREI + k * 8))
            __gc_st64(st + S_FREI + k * 8, b)
            b = n
        }
        __gc_st64(header, 0)
        k = k + 1
    }
    __gc_st64(tcb + FT_FREIN, 0)
}

// Vor dem Fegen: die lokalen Listen ALLER Faeden aufloesen. Ein Block in einer
// lokalen Liste ist frei (Typkennung 0) und wuerde beim Fegen erneut in die
// globale Liste kommen — er stuende dann in zwei Listen. Die Welt steht hier.
fn __thread_lists_all_back() {
    let st: u64 = __gc_state() as u64
    if __gc_ld64(st + S_MULTI) == 0 {
        return
    }
    let tab: u64 = __gc_ld64(st + S_FADEN_TAB)
    if tab == 0 {
        return
    }
    var i: u64 = 0
    while i < FADEN_MAX {
        let t: u64 = tab + i * FT_BYTES
        if __gc_ld64(t + FT_ZUSTAND) != Z_FREI {
            __thread_lists_back(t)
        }
        i = i + 1
    }
}

// ------------------------------------------------------------------- Kanal
//
// Ein beschraenkter Ringpuffer fuer u64-Werte, mit Sperre und Futex. Bewusst
// die einfachste Form, die stimmt: EIN Futex-Wort (die Belegung) und ein
// Wecken ALLER Warter. Ein Kanal mit getrennten Warteschlangen fuer Sender
// und Empfaenger waere schneller; das ist nicht die Frage dieser Runde und
// steht als offener Punkt in docs/RUNDE49.md §8.
//
//   +0 sperre · +8 kapazitaet · +16 kopf · +24 schwanz · +32 belegt · +40 bytes
//   +48 daten
const KA_SPERRE: u64 = 0
const KA_KAP: u64 = 8
const KA_KOPF: u64 = 16
const KA_SCHWANZ: u64 = 24
const KA_BELEGT: u64 = 32
const KA_BYTES: u64 = 40
const KA_DATEN: u64 = 48

fn thread_channel_new(cap: u64) -> u64 {
    if cap == 0 {
        return 0
    }
    let bytes: u64 = KA_DATEN + cap * 8
    let k: u64 = __gc_mmap(bytes)
    if k == 0 {
        return 0
    }
    __gc_st64(k + KA_KAP, cap)
    __gc_st64(k + KA_BYTES, bytes)
    return k
}

fn thread_channel_free(k: u64) {
    if k == 0 {
        return
    }
    __gc_munmap(k, __gc_ld64(k + KA_BYTES))
}

fn thread_channel_send(k: u64, v: u64) {
    let cap: u64 = __gc_ld64(k + KA_KAP)
    var done: bool = false
    while !done {
        __thread_lock(k + KA_SPERRE)
        if __gc_ld64(k + KA_BELEGT) < cap {
            let s: u64 = __gc_ld64(k + KA_SCHWANZ)
            __gc_st64(k + KA_DATEN + s * 8, v)
            __gc_st64(k + KA_SCHWANZ, (s + 1) % cap)
            __gc_st64(k + KA_BELEGT, __gc_ld64(k + KA_BELEGT) + 1)
            __thread_unlock(k + KA_SPERRE)
            __thread_futex_wake(k + KA_BELEGT, FADEN_MAX)
            done = true
        } else {
            __thread_unlock(k + KA_SPERRE)
            __thread_blocked_an()
            __thread_futex_wait(k + KA_BELEGT, cap)
            __thread_blocked_out()
        }
    }
}

fn thread_channel_receive(k: u64) -> u64 {
    let cap: u64 = __gc_ld64(k + KA_KAP)
    var out: u64 = 0
    var done: bool = false
    while !done {
        __thread_lock(k + KA_SPERRE)
        if __gc_ld64(k + KA_BELEGT) > 0 {
            let h: u64 = __gc_ld64(k + KA_KOPF)
            out = __gc_ld64(k + KA_DATEN + h * 8)
            __gc_st64(k + KA_KOPF, (h + 1) % cap)
            __gc_st64(k + KA_BELEGT, __gc_ld64(k + KA_BELEGT) - 1)
            __thread_unlock(k + KA_SPERRE)
            __thread_futex_wake(k + KA_BELEGT, FADEN_MAX)
            done = true
        } else {
            __thread_unlock(k + KA_SPERRE)
            __thread_blocked_an()
            __thread_futex_wait(k + KA_BELEGT, 0)
            __thread_blocked_out()
        }
    }
    return out
}

fn thread_channel_used(k: u64) -> u64 {
    return __gc_ld64(k + KA_BELEGT)
}
