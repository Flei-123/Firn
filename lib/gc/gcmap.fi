// lib/gc/gcmap.fi — `GcMap[K,V]`: die Abbildung mit veraenderlicher Groesse
// im GC-Heap (SPEC §3.5.2 `attrs: GcMap[Atom, Str]`, Runde 53).
//
// Wird an `lib/gc/gc.fi` und `lib/gc/gcvec.fi` ANGEHAENGT und bildet mit
// ihnen EIN Modul. Sie benutzt denselben Slot-Puffer wie `GcVec`, nur mit
// Schrittweite 2: je Platz ein Schluessel und ein Wert.
//
//     desc = 2 | (maske << 8),  Bit 0 = Schluessel ist Gc-Zeiger,
//                               Bit 1 = Wert ist Gc-Zeiger
//
// Damit verfolgt `__gc_trace_slots` SCHLUESSEL UND WERTE — beide koennen
// Zyklen tragen, und beide muessen es koennen: im DOM ist der Schluessel ein
// Atom (rohe Kennung), der Wert aber ein Objekt auf dem GC-Heap.
//
// VERFAHREN: offene Adressierung, lineares Sondieren, Kapazitaet immer eine
// Zweierpotenz (`hash & (kap-1)` statt Division), Lastgrenze 3/4 — dieselbe
// Bauart wie `lib/rt/map.fi`, damit sich beide gleich verhalten.
//
// ZUSTAND je Platz steht IM SCHLUESSEL, nicht in einem Nebenfeld:
//
//     Schluessel 0 = nie belegt   (Suche darf abbrechen)
//     Schluessel 1 = geloescht    (Suche darf NICHT abbrechen)
//
// Warum das geht und warum es hier sicher ist: `__gc_mark(1)` sucht ueber
// `__gc_block_von` den Chunk zur Adresse 1 — es gibt keinen, also passiert
// nichts. Ein Grabstein kann den Sammler also nicht in die Irre fuehren.
// Der Preis ist eine Zusage nach aussen:
//
//     0 und 1 sind als Schluessel RESERVIERT.
//
// Fuer Gc-Zeiger ist das umsonst (keine Adresse ist 0 oder 1), fuer rohe
// Kennungen kostet es die beiden kleinsten Werte. Die Alternative waere ein
// zweites Feld je Platz — ein Drittel mehr Speicher und ein zweiter
// Speicherzugriff je Sondierschritt, fuer nichts.

const GCMAP_LEER: u64 = 0
const GCMAP_GRAB: u64 = 1
// Anfangskapazitaet in Plaetzen (Zweierpotenz).
const GCMAP_START: u64 = 8

gc class GcMap {
    puffer: Gc[GcSlots],
    n: u64,
    tot: u64,
    desc: u64,
}

// Streuung wie `lib/rt/map.fi::map_hash` — bitgleich, damit sich die beiden
// Abbildungen der Sprache nicht unterschiedlich verhalten.
fn gcmap_hash(k: u64) -> u64 {
    var x: u64 = k
    x = x ^ (x >> 33)
    x = x * 14181476777654086739 as u64
    x = x ^ (x >> 29)
    x = x * 12297829382473034411 as u64
    x = x ^ (x >> 32)
    return x
}

// `k_zeiger`/`w_zeiger`: sind Schluessel bzw. Wert Gc-Zeiger und damit vom
// Sammler zu verfolgen?
fn gcmap_neu(k_zeiger: bool, w_zeiger: bool) -> AllocError!Gc[GcMap] {
    var maske: u64 = 0
    if k_zeiger {
        maske = maske + 1
    }
    if w_zeiger {
        maske = maske + 2
    }
    return try gc GcMap{
        puffer: gc_null[GcSlots](),
        n: 0,
        tot: 0,
        desc: 2 + (maske * 256),
    }
}

fn gcmap_groesse(m: Gc[GcMap]) -> u64 {
    return m.n
}

fn gcmap_kapazitaet(m: Gc[GcMap]) -> u64 {
    let s: Gc[GcSlots] = m.puffer
    if (s as u64) == 0 {
        return 0
    }
    return s.kap
}

// Platz von `k` suchen. Liefert entweder den belegten Platz mit diesem
// Schluessel oder den ersten Platz, an dem eingefuegt werden darf; `kap`
// heisst „voll" (kann nur bei Lastgrenze 1 passieren, also nie).
//
// WICHTIG: der ERSTE Grabstein wird gemerkt, aber die Suche laeuft weiter,
// bis sie den Schluessel oder einen nie belegten Platz findet. Nur so kann
// ein Eintrag nicht doppelt entstehen, wenn er hinter einem Grabstein liegt.
fn __gcmap_platz(m: Gc[GcMap], k: u64) -> u64 {
    let s: Gc[GcSlots] = m.puffer
    if (s as u64) == 0 {
        return 0
    }
    let kap: u64 = s.kap
    let maske: u64 = kap - 1
    let basis: u64 = (s as u64) + SLOT_KOPF
    var i: u64 = gcmap_hash(k) & maske
    var grab: u64 = kap
    var schritte: u64 = 0
    while schritte < kap {
        let sk: u64 = __gc_ld64(basis + i * 16)
        if sk == k {
            return i
        }
        if sk == GCMAP_LEER {
            if grab < kap {
                return grab
            }
            return i
        }
        if sk == GCMAP_GRAB {
            if grab == kap {
                grab = i
            }
        }
        i = (i + 1) & maske
        schritte = schritte + 1
    }
    if grab < kap {
        return grab
    }
    return kap
}

// Neuen Puffer anlegen und alles einstreuen. Wie beim Vektor liegt die
// Allokation VOR dem Umstreuen: waehrend `__gcslots_neu` kann eine
// Sammlerscheibe laufen, waehrend des Umstreuens nicht. Die Barriere auf
// `m.puffer = neu` legt der Compiler.
fn __gcmap_wachsen(m: Gc[GcMap], neukap: u64) -> AllocError!bool {
    let alt: Gc[GcSlots] = m.puffer
    var altkap: u64 = 0
    if (alt as u64) != 0 {
        altkap = alt.kap
    }
    let neu: Gc[GcSlots] = try __gcslots_neu(neukap, m.desc)
    __gc_st64((neu as u64), neukap)
    let nbasis: u64 = (neu as u64) + SLOT_KOPF
    let abasis: u64 = (alt as u64) + SLOT_KOPF
    let nmaske: u64 = neukap - 1
    var j: u64 = 0
    while j < altkap {
        let sk: u64 = __gc_ld64(abasis + j * 16)
        if sk != GCMAP_LEER && sk != GCMAP_GRAB {
            let sw: u64 = __gc_ld64(abasis + j * 16 + 8)
            var i: u64 = gcmap_hash(sk) & nmaske
            while __gc_ld64(nbasis + i * 16) != GCMAP_LEER {
                i = (i + 1) & nmaske
            }
            __gc_st64(nbasis + i * 16, sk)
            __gc_st64(nbasis + i * 16 + 8, sw)
        }
        j = j + 1
    }
    m.tot = 0
    m.puffer = neu
    return true
}

// Der ganze verfolgte Bereich einer Abbildung ist IMMER die volle Kapazitaet
// (n im Slot-Puffer = kap), nicht die Zahl der Eintraege: die Plaetze liegen
// gestreut, nicht dicht. Leere Plaetze tragen 0 und kosten beim Verfolgen
// einen Vergleich.
fn gcmap_setzen(m: Gc[GcMap], k: u64, w: u64) -> AllocError!bool {
    if k == GCMAP_LEER || k == GCMAP_GRAB {
        return false
    }
    var kap: u64 = gcmap_kapazitaet(m)
    if kap == 0 {
        if !(try __gcmap_wachsen(m, GCMAP_START)) {
            return false
        }
        kap = GCMAP_START
    }
    // Lastgrenze 3/4, Grabsteine zaehlen mit — sonst laeuft eine Abbildung,
    // in der viel geloescht und wieder eingefuegt wird, in eine volle
    // Sondierkette.
    if (m.n + m.tot + 1) * 4 > kap * 3 {
        if !(try __gcmap_wachsen(m, kap * 2)) {
            return false
        }
        kap = kap * 2
    }
    let s: Gc[GcSlots] = m.puffer
    let i: u64 = __gcmap_platz(m, k)
    if i >= kap {
        return false
    }
    let a: u64 = (s as u64) + SLOT_KOPF + i * 16
    let alt: u64 = __gc_ld64(a)
    let maske: u64 = s.desc >> 8
    if alt != k {
        if alt == GCMAP_GRAB {
            m.tot = m.tot - 1
        }
        // Einfuegebarriere fuer den SCHLUESSEL (der Compiler kennt den
        // Puffer nicht, also ruft die Bibliothek sie selbst).
        if (maske & 1) != 0 {
            __gc_barrier(a as *mut u8, k as *mut u8)
        }
        __gc_st64(a, k)
        m.n = m.n + 1
    }
    if (maske & 2) != 0 {
        __gc_barrier((a + 8) as *mut u8, w as *mut u8)
    }
    __gc_st64(a + 8, w)
    return true
}

fn gcmap_hat(m: Gc[GcMap], k: u64) -> bool {
    if k == GCMAP_LEER || k == GCMAP_GRAB {
        return false
    }
    let kap: u64 = gcmap_kapazitaet(m)
    if kap == 0 {
        return false
    }
    let i: u64 = __gcmap_platz(m, k)
    if i >= kap {
        return false
    }
    return __gc_ld64((m.puffer as u64) + SLOT_KOPF + i * 16) == k
}

fn gcmap_holen(m: Gc[GcMap], k: u64, fehlt: u64) -> u64 {
    if k == GCMAP_LEER || k == GCMAP_GRAB {
        return fehlt
    }
    let kap: u64 = gcmap_kapazitaet(m)
    if kap == 0 {
        return fehlt
    }
    let i: u64 = __gcmap_platz(m, k)
    if i >= kap {
        return fehlt
    }
    let a: u64 = (m.puffer as u64) + SLOT_KOPF + i * 16
    if __gc_ld64(a) != k {
        return fehlt
    }
    return __gc_ld64(a + 8)
}

// Loeschen hinterlaesst einen GRABSTEIN. Schluessel und Wert werden dabei
// wirklich ueberschrieben — ein geloeschter Eintrag darf sein Objekt nicht
// weiter am Leben halten, sonst waere die Abbildung ein Leck.
fn gcmap_entfernen(m: Gc[GcMap], k: u64) -> bool {
    if k == GCMAP_LEER || k == GCMAP_GRAB {
        return false
    }
    let kap: u64 = gcmap_kapazitaet(m)
    if kap == 0 {
        return false
    }
    let i: u64 = __gcmap_platz(m, k)
    if i >= kap {
        return false
    }
    let a: u64 = (m.puffer as u64) + SLOT_KOPF + i * 16
    if __gc_ld64(a) != k {
        return false
    }
    __gc_st64(a, GCMAP_GRAB)
    __gc_st64(a + 8, 0)
    m.n = m.n - 1
    m.tot = m.tot + 1
    return true
}

fn gcmap_leeren(m: Gc[GcMap]) {
    let s: Gc[GcSlots] = m.puffer
    if (s as u64) == 0 {
        return
    }
    let basis: u64 = (s as u64) + SLOT_KOPF
    let worte: u64 = s.kap * 2
    var i: u64 = 0
    while i < worte {
        __gc_st64(basis + i * 8, 0)
        i = i + 1
    }
    m.n = 0
    m.tot = 0
}

// ------------------------------------------------------------- Durchlauf
//
// Stufe 0 hat keine Iteratoren. Der Durchlauf ist deshalb der ehrliche:
// ueber alle Plaetze laufen und die leeren ueberspringen.
//
//     var i: u64 = 0
//     while i < gcmap_kapazitaet(m) {
//         if gcmap_platz_belegt(m, i) { … gcmap_platz_schluessel(m, i) … }
//         i = i + 1
//     }

fn gcmap_platz_belegt(m: Gc[GcMap], i: u64) -> bool {
    if i >= gcmap_kapazitaet(m) {
        return false
    }
    let sk: u64 = __gc_ld64((m.puffer as u64) + SLOT_KOPF + i * 16)
    return sk != GCMAP_LEER && sk != GCMAP_GRAB
}

fn gcmap_platz_schluessel(m: Gc[GcMap], i: u64) -> u64 {
    if i >= gcmap_kapazitaet(m) {
        return 0
    }
    return __gc_ld64((m.puffer as u64) + SLOT_KOPF + i * 16)
}

fn gcmap_platz_wert(m: Gc[GcMap], i: u64) -> u64 {
    if i >= gcmap_kapazitaet(m) {
        return 0
    }
    return __gc_ld64((m.puffer as u64) + SLOT_KOPF + i * 16 + 8)
}

// ------------------------------------------------------- Typisierte Sicht

fn gcmap_setzen_wert[V: Any](m: Gc[GcMap], k: u64, w: Gc[V]) -> AllocError!bool {
    return try gcmap_setzen(m, k, w as u64)
}

fn gcmap_holen_wert[V: Any](m: Gc[GcMap], k: u64) -> Gc[V] {
    return gcmap_holen(m, k, 0) as Gc[V]
}

fn gcmap_platz_wert_als[V: Any](m: Gc[GcMap], i: u64) -> Gc[V] {
    return gcmap_platz_wert(m, i) as Gc[V]
}
