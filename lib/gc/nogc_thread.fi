const NT_SYS_MMAP: i64 = 9
const NT_SYS_MPROTECT: i64 = 10
const NT_SYS_MUNMAP: i64 = 11
const NT_SYS_SCHED_YIELD: i64 = 24
const NT_SYS_FUTEX: i64 = 202
const NT_PROT_RW: i64 = 3
const NT_MAP_PRIVATE_ANON: i64 = 34
const NT_PAGE: u64 = 4096
const NT_STACK_BYTES: u64 = 1048576
const NT_TOP_RESERVE: u64 = 4096
const NT_KIND: u64 = 0
const NT_ARG: u64 = 8
const NT_RESULT: u64 = 16
const NT_TID: u64 = 24
const NT_STACK: u64 = 32
const NT_SPIN_LIMIT: u64 = 64

fn __nt_map(n: u64) -> u64 {
    let r: i64 = syscall(NT_SYS_MMAP, 0, n as i64, NT_PROT_RW, NT_MAP_PRIVATE_ANON, -1, 0)
    if r < 0 && r > -4096 {
        return 0
    }
    if r == 0 {
        return 0
    }
    return r as u64
}

fn __nt_unmap(p: u64, n: u64) {
    syscall(NT_SYS_MUNMAP, p as i64, n as i64, 0, 0, 0, 0)
}

fn __thread_entry(tcb: u64) -> i32 {
    let r: u64 = __thread_work(*((tcb +% NT_KIND) as *mut u64), *((tcb +% NT_ARG) as *mut u64))
    *((tcb +% NT_RESULT) as *mut u64) = r
    return 0
}

fn thread_start(kind: u64, arg: u64) -> u64 {
    let tcb: u64 = __nt_map(NT_PAGE)
    if tcb == 0 {
        return 0
    }
    let sp: u64 = __nt_map(NT_STACK_BYTES)
    if sp == 0 {
        __nt_unmap(tcb, NT_PAGE)
        return 0
    }
    syscall(NT_SYS_MPROTECT, sp as i64, NT_PAGE as i64, 0, 0, 0, 0)
    *((tcb +% NT_KIND) as *mut u64) = kind
    *((tcb +% NT_ARG) as *mut u64) = arg
    *((tcb +% NT_RESULT) as *mut u64) = 0
    *((tcb +% NT_TID) as *mut u64) = 0
    *((tcb +% NT_STACK) as *mut u64) = sp
    let top: u64 = sp +% NT_STACK_BYTES -% NT_TOP_RESERVE
    let r: i64 = __thread_start(tcb, top, (tcb +% NT_TID) as *mut u8)
    if r <= 0 {
        __nt_unmap(sp, NT_STACK_BYTES)
        __nt_unmap(tcb, NT_PAGE)
        return 0
    }
    return tcb
}

fn thread_wait(h: u64) -> u64 {
    if h == 0 {
        return 0
    }
    var t: u32 = *((h +% NT_TID) as *mut u32)
    while t != 0 {
        syscall(NT_SYS_FUTEX, (h +% NT_TID) as i64, 0, t as i64, 0, 0, 0)
        t = *((h +% NT_TID) as *mut u32)
    }
    let r: u64 = *((h +% NT_RESULT) as *mut u64)
    __nt_unmap(*((h +% NT_STACK) as *mut u64), NT_STACK_BYTES)
    __nt_unmap(h, NT_PAGE)
    return r
}

fn thread_lock(a: *mut u64) {
    var spins: u64 = 0
    var held: u64 = __atomic_swap(a, 0, 1)
    while held != 0 {
        spins = spins +% 1
        if spins > NT_SPIN_LIMIT {
            syscall(NT_SYS_SCHED_YIELD, 0, 0, 0, 0, 0, 0)
        }
        held = __atomic_swap(a, 0, 1)
    }
}

fn thread_unlock(a: *mut u64) {
    __atomic_swap(a, 1, 0)
}
