fn __str_eq(a: str, b: str) -> bool {
    if a.n != b.n {
        return false
    }
    if (a.p as u64) == (b.p as u64) {
        return true
    }
    var x: u64 = a.p as u64
    var y: u64 = b.p as u64
    var left: usize = a.n
    while left >= 8 {
        if *(x as *mut u64) != *(y as *mut u64) {
            return false
        }
        x = x +% 8
        y = y +% 8
        left = left -% 8
    }
    while left > 0 {
        if *(x as *mut u8) != *(y as *mut u8) {
            return false
        }
        x = x +% 1
        y = y +% 1
        left = left -% 1
    }
    return true
}

fn __gc_blit(dst: u64, src: u64, n: u64) {
    var i: u64 = 0
    while i +% 8 <= n {
        *((dst +% i) as *mut u64) = *((src +% i) as *mut u64)
        i = i +% 8
    }
    while i < n {
        *((dst +% i) as *mut u8) = *((src +% i) as *mut u8)
        i = i +% 1
    }
}

fn __str_copy(a: str) -> str {
    var msg: [u8; 47] = "firn: --no-gc: str allocation is not available\n"
    syscall(1, 2, ((&msg[0]) as u64) as i64, 47, 0, 0, 0)
    syscall(231, 70, 0, 0, 0, 0, 0)
    return str { p: 0 as *mut u8, n: 0 }
}
