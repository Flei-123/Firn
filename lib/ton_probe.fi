import std.io
import std.math
import std.rt

fn to_fixed_kern(x: f64, d: u64) -> u64 {
    var v: f64 = x
    if v < 0.0 {
        v = 0.0 - v
    }
    var scale: f64 = 1.0
    var i: u64 = 0
    while i < d {
        scale = scale * 10.0
        i = i + 1
    }
    let scaled: f64 = math.floor(v * scale + 0.5)
    var digits: [u8; 40] = [0 as u8; 40]
    var n: usize = 0
    var t: f64 = scaled
    if t == 0.0 {
        digits[0] = 48 as u8
        n = 1
    }
    while t >= 1.0 && n < 40 {
        let dd: u64 = (math.fmod(t, 10.0)) as u64
        digits[n] = (48 + dd) as u8
        t = math.floor(t / 10.0)
        n = n + 1
    }
    var summe: u64 = 0
    var k: usize = 0
    while k < n {
        summe = summe * 10 + (digits[k] as u64 - 48)
        k = k + 1
    }
    return summe
}

fn main() -> i32 {
    var s: u64 = 0
    s = s + to_fixed_kern(1.005, 2)
    s = s + to_fixed_kern(3.14159, 3)
    s = s + to_fixed_kern(0.30000000000000004, 5)
    s = s + to_fixed_kern(-2.5, 1)
    s = s + to_fixed_kern(1e10, 0)
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&b, s)
    rt.buf_push(&b, 10 as u8)
    io.print_bytes(rt.buf_ptr(&b), rt.buf_len(&b))
    return 0
}
