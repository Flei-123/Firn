import std.math
import scene3d.vec3
import scene3d.camera
import scene3d.render_types

export {
    horizon_setup, bg_fogged,
}

fn horizon_setup(r: *mut render_types.Renderer, cam: *mut camera.Camera) {
    let f: vec3.V3 = camera.cam_forward(*cam)
    let rt0: vec3.V3 = vec3.v3_norm(vec3.v3_cross(f, (*cam).up))
    let up: vec3.V3 = vec3.v3_cross(rt0, f)
    let th: f64 = math.tan((*cam).fov * vec3.DEG * 0.5)
    (*r).hz_c = f.y
    (*r).hz_x = th * camera.cam_aspect(*cam) * rt0.y
    (*r).hz_y = th * up.y
}

fn bg_fogged(r: *mut render_types.Renderer, x: i32, y: i32, c: vec3.V3) -> vec3.V3 {
    if (*r).fog_on == false { return c }
    let nx: f64 = (((x as f64) + 0.5) / ((*r).sw as f64)) * 2.0 - 1.0
    let ny: f64 = 1.0 - (((y as f64) + 0.5) / ((*r).sh as f64)) * 2.0
    let dy: f64 = (*r).hz_c + (*r).hz_x * nx + (*r).hz_y * ny
    let k: f64 = vec3.smoothstep(vec3.clamp01(dy / 0.4))
    return vec3.v3_lerp((*r).fog_color, c, k)
}
