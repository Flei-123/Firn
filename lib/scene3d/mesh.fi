// SPDX-License-Identifier: MPL-2.0
import std.vec
import std.math
import scene3d.vec3
import scene3d.mat4

export {
    Mesh, mesh_new, mesh_free, mesh_clear, mesh_add_vertex, mesh_add_tri, mesh_add_tri_checked, mesh_add_quad,
    mesh_append, mesh_translate, mesh_vertex_count, mesh_tri_count, mesh_smooth_normals, mesh_bounds,
    mesh_pos, mesh_nrm, mesh_uv_u, mesh_uv_v, mesh_index, mesh_tri_normal, mesh_volume, mesh_area,
}

struct Mesh {
    pos: vec.Vec[f64],
    nrm: vec.Vec[f64],
    uv: vec.Vec[f64],
    idx: vec.Vec[u32],
}

fn mesh_new() -> Mesh {
    return Mesh {
        pos: vec.vec_new[f64](),
        nrm: vec.vec_new[f64](),
        uv: vec.vec_new[f64](),
        idx: vec.vec_new[u32](),
    }
}

fn mesh_free(m: *mut Mesh) {
    vec.vec_free[f64](&(*m).pos)
    vec.vec_free[f64](&(*m).nrm)
    vec.vec_free[f64](&(*m).uv)
    vec.vec_free[u32](&(*m).idx)
}

fn mesh_clear(m: *mut Mesh) {
    vec.vec_clear[f64](&(*m).pos)
    vec.vec_clear[f64](&(*m).nrm)
    vec.vec_clear[f64](&(*m).uv)
    vec.vec_clear[u32](&(*m).idx)
}

fn mesh_vertex_count(m: *mut Mesh) -> usize {
    return vec.vec_len[f64](&(*m).pos) / 3
}

fn mesh_tri_count(m: *mut Mesh) -> usize {
    return vec.vec_len[u32](&(*m).idx) / 3
}

fn fget(v: *mut vec.Vec[f64], i: usize) -> f64 {
    return *vec.vec_elem_ptr[f64](v, i)
}

fn fput(v: *mut vec.Vec[f64], i: usize, x: f64) {
    *vec.vec_elem_ptr[f64](v, i) = x
}

fn mesh_pos(m: *mut Mesh, i: usize) -> vec3.V3 {
    return vec3.v3(fget(&(*m).pos, i * 3), fget(&(*m).pos, i * 3 + 1), fget(&(*m).pos, i * 3 + 2))
}

fn mesh_nrm(m: *mut Mesh, i: usize) -> vec3.V3 {
    return vec3.v3(fget(&(*m).nrm, i * 3), fget(&(*m).nrm, i * 3 + 1), fget(&(*m).nrm, i * 3 + 2))
}

fn mesh_uv_u(m: *mut Mesh, i: usize) -> f64 {
    return fget(&(*m).uv, i * 2)
}

fn mesh_uv_v(m: *mut Mesh, i: usize) -> f64 {
    return fget(&(*m).uv, i * 2 + 1)
}

fn mesh_index(m: *mut Mesh, k: usize) -> u32 {
    return *vec.vec_elem_ptr[u32](&(*m).idx, k)
}

fn mesh_add_vertex(m: *mut Mesh, p: vec3.V3, n: vec3.V3, u: f64, v: f64) -> u32 {
    let id: u32 = mesh_vertex_count(m) as u32
    vec.vec_push[f64](&(*m).pos, p.x)
    vec.vec_push[f64](&(*m).pos, p.y)
    vec.vec_push[f64](&(*m).pos, p.z)
    vec.vec_push[f64](&(*m).nrm, n.x)
    vec.vec_push[f64](&(*m).nrm, n.y)
    vec.vec_push[f64](&(*m).nrm, n.z)
    vec.vec_push[f64](&(*m).uv, u)
    vec.vec_push[f64](&(*m).uv, v)
    return id
}

fn mesh_add_tri(m: *mut Mesh, a: u32, b: u32, c: u32) {
    vec.vec_push[u32](&(*m).idx, a)
    vec.vec_push[u32](&(*m).idx, b)
    vec.vec_push[u32](&(*m).idx, c)
}

fn mesh_add_tri_checked(m: *mut Mesh, a: u32, b: u32, c: u32) {
    let pa: vec3.V3 = mesh_pos(m, a as usize)
    let pb: vec3.V3 = mesh_pos(m, b as usize)
    let pc: vec3.V3 = mesh_pos(m, c as usize)
    let cr: vec3.V3 = vec3.v3_cross(vec3.v3_sub(pb, pa), vec3.v3_sub(pc, pa))
    if vec3.v3_len2(cr) < 0.00000000000001 { return }
    mesh_add_tri(m, a, b, c)
}

fn mesh_add_quad(m: *mut Mesh, a: u32, b: u32, c: u32, d: u32) {
    mesh_add_tri(m, a, b, c)
    mesh_add_tri(m, a, c, d)
}

fn mesh_tri_normal(m: *mut Mesh, t: usize) -> vec3.V3 {
    let pa: vec3.V3 = mesh_pos(m, mesh_index(m, t * 3) as usize)
    let pb: vec3.V3 = mesh_pos(m, mesh_index(m, t * 3 + 1) as usize)
    let pc: vec3.V3 = mesh_pos(m, mesh_index(m, t * 3 + 2) as usize)
    return vec3.v3_cross(vec3.v3_sub(pb, pa), vec3.v3_sub(pc, pa))
}

fn mesh_append(dst: *mut Mesh, src: *mut Mesh, xf: mat4.M4) {
    let base: u32 = mesh_vertex_count(dst) as u32
    let nv: usize = mesh_vertex_count(src)
    let nt: usize = mesh_tri_count(src)
    let cof: mat4.M4 = mat4.m4_cofactor3(xf)
    let det: f64 = xf.m[0] * cof.m[0] + xf.m[1] * cof.m[1] + xf.m[2] * cof.m[2]
    var i: usize = 0
    while i < nv {
        let p: vec3.V3 = mat4.m4_point(xf, mesh_pos(src, i))
        var n: vec3.V3 = vec3.v3_norm(mat4.m4_dir(cof, mesh_nrm(src, i)))
        if det < 0.0 { n = vec3.v3_neg(n) }
        mesh_add_vertex(dst, p, n, mesh_uv_u(src, i), mesh_uv_v(src, i))
        i = i + 1
    }
    var t: usize = 0
    while t < nt {
        let a: u32 = mesh_index(src, t * 3) + base
        let b: u32 = mesh_index(src, t * 3 + 1) + base
        let c: u32 = mesh_index(src, t * 3 + 2) + base
        if det < 0.0 {
            mesh_add_tri(dst, a, c, b)
        } else {
            mesh_add_tri(dst, a, b, c)
        }
        t = t + 1
    }
}

fn mesh_translate(m: *mut Mesh, d: vec3.V3) {
    let nv: usize = mesh_vertex_count(m)
    var i: usize = 0
    while i < nv {
        fput(&(*m).pos, i * 3, fget(&(*m).pos, i * 3) + d.x)
        fput(&(*m).pos, i * 3 + 1, fget(&(*m).pos, i * 3 + 1) + d.y)
        fput(&(*m).pos, i * 3 + 2, fget(&(*m).pos, i * 3 + 2) + d.z)
        i = i + 1
    }
}

struct WeldEntry { qx: i64, qy: i64, qz: i64, id: u32 }

fn weld_less(a: *WeldEntry, b: *WeldEntry) -> bool {
    if (*a).qx != (*b).qx { return (*a).qx < (*b).qx }
    if (*a).qy != (*b).qy { return (*a).qy < (*b).qy }
    if (*a).qz != (*b).qz { return (*a).qz < (*b).qz }
    return (*a).id < (*b).id
}

fn weld_same(a: *WeldEntry, b: *WeldEntry) -> bool {
    return (*a).qx == (*b).qx && (*a).qy == (*b).qy && (*a).qz == (*b).qz
}

fn quant(x: f64) -> i64 {
    return math.floor(x * 1000000.0 + 0.5) as i64
}

fn weld_entry(p: vec3.V3, id: u32) -> WeldEntry {
    return WeldEntry { qx: quant(p.x), qy: quant(p.y), qz: quant(p.z), id: id }
}

fn mesh_smooth_normals(m: *mut Mesh) {
    let nv: usize = mesh_vertex_count(m)
    let nt: usize = mesh_tri_count(m)
    var acc: vec.Vec[f64] = vec.vec_new[f64]()
    var i: usize = 0
    while i < nv * 3 {
        vec.vec_push[f64](&acc, 0.0)
        i = i + 1
    }
    var t: usize = 0
    while t < nt {
        let fnrm: vec3.V3 = mesh_tri_normal(m, t)
        var k: usize = 0
        while k < 3 {
            let vi: usize = mesh_index(m, t * 3 + k) as usize
            fput(&acc, vi * 3, fget(&acc, vi * 3) + fnrm.x)
            fput(&acc, vi * 3 + 1, fget(&acc, vi * 3 + 1) + fnrm.y)
            fput(&acc, vi * 3 + 2, fget(&acc, vi * 3 + 2) + fnrm.z)
            k = k + 1
        }
        t = t + 1
    }
    var ents: vec.Vec[WeldEntry] = vec.vec_new[WeldEntry]()
    i = 0
    while i < nv {
        vec.vec_push[WeldEntry](&ents, weld_entry(mesh_pos(m, i), i as u32))
        i = i + 1
    }
    vec.vec_sort_by[WeldEntry](&ents, weld_less)
    var lo: usize = 0
    while lo < nv {
        let head: *mut WeldEntry = vec.vec_elem_ptr[WeldEntry](&ents, lo)
        var hi: usize = lo
        var sum: vec3.V3 = vec3.v3_zero()
        while hi < nv && weld_same(head, vec.vec_elem_ptr[WeldEntry](&ents, hi)) {
            let vi: usize = (*vec.vec_elem_ptr[WeldEntry](&ents, hi)).id as usize
            sum = vec3.v3_add(sum, vec3.v3(fget(&acc, vi * 3), fget(&acc, vi * 3 + 1), fget(&acc, vi * 3 + 2)))
            hi = hi + 1
        }
        let n: vec3.V3 = vec3.v3_norm(sum)
        var q: usize = lo
        while q < hi {
            let vi: usize = (*vec.vec_elem_ptr[WeldEntry](&ents, q)).id as usize
            fput(&(*m).nrm, vi * 3, n.x)
            fput(&(*m).nrm, vi * 3 + 1, n.y)
            fput(&(*m).nrm, vi * 3 + 2, n.z)
            q = q + 1
        }
        lo = hi
    }
    vec.vec_free[WeldEntry](&ents)
    vec.vec_free[f64](&acc)
}

fn mesh_bounds(m: *mut Mesh, lo: *mut vec3.V3, hi: *mut vec3.V3) {
    let nv: usize = mesh_vertex_count(m)
    if nv == 0 {
        *lo = vec3.v3_zero()
        *hi = vec3.v3_zero()
        return
    }
    var mn: vec3.V3 = mesh_pos(m, 0)
    var mx: vec3.V3 = mn
    var i: usize = 1
    while i < nv {
        let p: vec3.V3 = mesh_pos(m, i)
        mn = vec3.v3_min(mn, p)
        mx = vec3.v3_max(mx, p)
        i = i + 1
    }
    *lo = mn
    *hi = mx
}

fn mesh_volume(m: *mut Mesh) -> f64 {
    let nt: usize = mesh_tri_count(m)
    var sum: f64 = 0.0
    var t: usize = 0
    while t < nt {
        let pa: vec3.V3 = mesh_pos(m, mesh_index(m, t * 3) as usize)
        let pb: vec3.V3 = mesh_pos(m, mesh_index(m, t * 3 + 1) as usize)
        let pc: vec3.V3 = mesh_pos(m, mesh_index(m, t * 3 + 2) as usize)
        sum = sum + vec3.v3_dot(pa, vec3.v3_cross(pb, pc))
        t = t + 1
    }
    return sum / 6.0
}

fn mesh_area(m: *mut Mesh) -> f64 {
    let nt: usize = mesh_tri_count(m)
    var sum: f64 = 0.0
    var t: usize = 0
    while t < nt {
        sum = sum + vec3.v3_len(mesh_tri_normal(m, t)) * 0.5
        t = t + 1
    }
    return sum
}
