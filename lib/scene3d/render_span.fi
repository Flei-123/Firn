import std.math
import scene3d.render_types

export {
    col_of, span_of,
}

fn col_of(v: f64, hi: i32) -> i32 {
    var c: f64 = math.ceil(v - 0.5)
    if c < 0.0 { c = 0.0 }
    if c > (hi as f64) { c = hi as f64 }
    return c as i32
}

fn span_of(t: *mut render_types.Tri, yc: f64, xa: *mut f64, xb: *mut f64) {
    *xa = 1.0e30
    *xb = 0.0 - 1.0e30
    if (*t).e0y <= yc && yc < (*t).e0q {
        let x: f64 = (*t).e0x + (yc - (*t).e0y) * (*t).e0s
        if x < *xa { *xa = x }
        if x > *xb { *xb = x }
    }
    if (*t).e1y <= yc && yc < (*t).e1q {
        let x: f64 = (*t).e1x + (yc - (*t).e1y) * (*t).e1s
        if x < *xa { *xa = x }
        if x > *xb { *xb = x }
    }
    if (*t).e2y <= yc && yc < (*t).e2q {
        let x: f64 = (*t).e2x + (yc - (*t).e2y) * (*t).e2s
        if x < *xa { *xa = x }
        if x > *xb { *xb = x }
    }
}
