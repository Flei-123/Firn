// SPDX-License-Identifier: MPL-2.0
import std.rt

export {
    Surface, surface_new, surface_free, surface_clear, surface_get, surface_set, surface_ok, surface_bytes,
    surface_copy,
}

struct Surface {
    px: u64,
    w: i32,
    h: i32,
}

fn surface_bytes(w: i32, h: i32) -> usize {
    return (w as usize) * (h as usize) * 4
}

fn surface_new(w: i32, h: i32) -> Surface {
    if w <= 0 || h <= 0 {
        return Surface { px: 0 as u64, w: 0, h: 0 }
    }
    return Surface { px: rt.heap_alloc(surface_bytes(w, h)), w: w, h: h }
}

fn surface_ok(s: *mut Surface) -> bool {
    return (*s).px != 0 as u64
}

fn surface_free(s: *mut Surface) {
    if (*s).px != 0 as u64 {
        rt.heap_free((*s).px, surface_bytes((*s).w, (*s).h))
        (*s).px = 0 as u64
    }
    (*s).w = 0
    (*s).h = 0
}

fn surface_clear(s: *mut Surface, color: u32) {
    if (*s).px == 0 as u64 { return }
    let n: usize = (*s).w as usize * ((*s).h as usize)
    if color == 0 as u32 {
        rt.mem_set((*s).px, 0 as u8, n * 4)
        return
    }
    var i: usize = 0
    while i < n {
        rt.st32((*s).px, i, color)
        i = i + 1
    }
}

fn surface_get(s: *mut Surface, x: i32, y: i32) -> u32 {
    if x < 0 || y < 0 || x >= (*s).w || y >= (*s).h { return 0 as u32 }
    return rt.ld32((*s).px, (y as usize) * ((*s).w as usize) + (x as usize))
}

fn surface_set(s: *mut Surface, x: i32, y: i32, color: u32) {
    if x < 0 || y < 0 || x >= (*s).w || y >= (*s).h { return }
    rt.st32((*s).px, (y as usize) * ((*s).w as usize) + (x as usize), color)
}

fn surface_copy(dst: *mut Surface, src: *mut Surface) {
    if (*dst).px == 0 as u64 || (*src).px == 0 as u64 { return }
    if (*dst).w != (*src).w || (*dst).h != (*src).h { return }
    rt.mem_copy((*dst).px, (*src).px, surface_bytes((*src).w, (*src).h))
}
