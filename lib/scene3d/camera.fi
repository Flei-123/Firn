// SPDX-License-Identifier: MPL-2.0
import std.math
import scene3d.vec3
import scene3d.mat4

export {
    Camera, cam_new, cam_look_at, cam_view, cam_proj, cam_view_proj, cam_project, cam_forward, cam_aspect,
}

struct Camera {
    pos: vec3.V3,
    target: vec3.V3,
    up: vec3.V3,
    fov: f64,
    near: f64,
    far: f64,
    w: i32,
    h: i32,
}

fn cam_new(w: i32, h: i32) -> Camera {
    return Camera {
        pos: vec3.v3(0.0, 0.0, 10.0),
        target: vec3.v3(0.0, 0.0, 0.0),
        up: vec3.v3(0.0, 1.0, 0.0),
        fov: 40.0,
        near: 0.5,
        far: 400.0,
        w: w,
        h: h,
    }
}

fn cam_look_at(c: *mut Camera, pos: vec3.V3, target: vec3.V3) {
    (*c).pos = pos
    (*c).target = target
}

fn cam_aspect(c: Camera) -> f64 {
    return (c.w as f64) / (c.h as f64)
}

fn cam_view(c: Camera) -> mat4.M4 {
    return mat4.m4_look_at(c.pos, c.target, c.up)
}

fn cam_proj(c: Camera) -> mat4.M4 {
    return mat4.m4_perspective(c.fov * vec3.DEG, cam_aspect(c), c.near, c.far)
}

fn cam_view_proj(c: Camera) -> mat4.M4 {
    return mat4.m4_mul(cam_proj(c), cam_view(c))
}

fn cam_forward(c: Camera) -> vec3.V3 {
    return vec3.v3_norm(vec3.v3_sub(c.target, c.pos))
}

fn cam_project(c: Camera, p: vec3.V3, out: *mut vec3.V3) -> bool {
    let vp: mat4.M4 = cam_view_proj(c)
    let q: mat4.V4 = mat4.m4_xform4(vp, p)
    if q.w <= c.near * 0.5 { return false }
    let nx: f64 = q.x / q.w
    let ny: f64 = q.y / q.w
    (*out).x = (nx * 0.5 + 0.5) * (c.w as f64)
    (*out).y = (0.5 - ny * 0.5) * (c.h as f64)
    (*out).z = q.w
    return true
}
