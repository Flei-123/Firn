// SPDX-License-Identifier: MPL-2.0
import std.math
import scene3d.vec3
import scene3d.quat

export {
    M4, V4, m4_identity, m4_mul, m4_translate, m4_scale, m4_from_quat, m4_compose, m4_perspective,
    m4_look_at, m4_point, m4_dir, m4_xform4, m4_cofactor3, m4_transpose, m4_rot_x, m4_rot_y, m4_rot_z,
    m4_get, m4_set, m4_inverse_affine, v4,
}

struct M4 { m: [f64; 16] }

struct V4 { x: f64, y: f64, z: f64, w: f64 }

fn v4(x: f64, y: f64, z: f64, w: f64) -> V4 {
    return V4 { x: x, y: y, z: z, w: w }
}

fn m4_identity() -> M4 {
    var r: M4 = M4 { m: [0.0; 16] }
    r.m[0] = 1.0
    r.m[5] = 1.0
    r.m[10] = 1.0
    r.m[15] = 1.0
    return r
}

fn m4_get(a: M4, row: i32, col: i32) -> f64 {
    return a.m[(row * 4 + col) as usize]
}

fn m4_set(a: *mut M4, row: i32, col: i32, v: f64) {
    (*a).m[(row * 4 + col) as usize] = v
}

fn m4_mul(a: M4, b: M4) -> M4 {
    var r: M4 = M4 { m: [0.0; 16] }
    var i: i32 = 0
    while i < 4 {
        var j: i32 = 0
        while j < 4 {
            let a0: f64 = a.m[(i * 4) as usize]
            let a1: f64 = a.m[(i * 4 + 1) as usize]
            let a2: f64 = a.m[(i * 4 + 2) as usize]
            let a3: f64 = a.m[(i * 4 + 3) as usize]
            r.m[(i * 4 + j) as usize] = a0 * b.m[j as usize] + a1 * b.m[(4 + j) as usize] + a2 * b.m[(8 + j) as usize] + a3 * b.m[(12 + j) as usize]
            j = j + 1
        }
        i = i + 1
    }
    return r
}

fn m4_translate(t: vec3.V3) -> M4 {
    var r: M4 = m4_identity()
    r.m[3] = t.x
    r.m[7] = t.y
    r.m[11] = t.z
    return r
}

fn m4_scale(s: vec3.V3) -> M4 {
    var r: M4 = m4_identity()
    r.m[0] = s.x
    r.m[5] = s.y
    r.m[10] = s.z
    return r
}

fn m4_from_quat(q: quat.Q4) -> M4 {
    var r: M4 = m4_identity()
    let xx: f64 = q.x * q.x
    let yy: f64 = q.y * q.y
    let zz: f64 = q.z * q.z
    let xy: f64 = q.x * q.y
    let xz: f64 = q.x * q.z
    let yz: f64 = q.y * q.z
    let wx: f64 = q.w * q.x
    let wy: f64 = q.w * q.y
    let wz: f64 = q.w * q.z
    r.m[0] = 1.0 - 2.0 * (yy + zz)
    r.m[1] = 2.0 * (xy - wz)
    r.m[2] = 2.0 * (xz + wy)
    r.m[4] = 2.0 * (xy + wz)
    r.m[5] = 1.0 - 2.0 * (xx + zz)
    r.m[6] = 2.0 * (yz - wx)
    r.m[8] = 2.0 * (xz - wy)
    r.m[9] = 2.0 * (yz + wx)
    r.m[10] = 1.0 - 2.0 * (xx + yy)
    return r
}

fn m4_compose(pos: vec3.V3, rot: quat.Q4, sc: vec3.V3) -> M4 {
    var r: M4 = m4_from_quat(rot)
    r.m[0] = r.m[0] * sc.x
    r.m[4] = r.m[4] * sc.x
    r.m[8] = r.m[8] * sc.x
    r.m[1] = r.m[1] * sc.y
    r.m[5] = r.m[5] * sc.y
    r.m[9] = r.m[9] * sc.y
    r.m[2] = r.m[2] * sc.z
    r.m[6] = r.m[6] * sc.z
    r.m[10] = r.m[10] * sc.z
    r.m[3] = pos.x
    r.m[7] = pos.y
    r.m[11] = pos.z
    return r
}

fn m4_rot_x(a: f64) -> M4 {
    return m4_from_quat(quat.q_axis_angle(vec3.v3(1.0, 0.0, 0.0), a))
}

fn m4_rot_y(a: f64) -> M4 {
    return m4_from_quat(quat.q_axis_angle(vec3.v3(0.0, 1.0, 0.0), a))
}

fn m4_rot_z(a: f64) -> M4 {
    return m4_from_quat(quat.q_axis_angle(vec3.v3(0.0, 0.0, 1.0), a))
}

fn m4_perspective(fov_y: f64, aspect: f64, near: f64, far: f64) -> M4 {
    var r: M4 = M4 { m: [0.0; 16] }
    let f: f64 = 1.0 / math.tan(fov_y * 0.5)
    r.m[0] = f / aspect
    r.m[5] = f
    r.m[10] = (far + near) / (near - far)
    r.m[11] = 2.0 * far * near / (near - far)
    r.m[14] = 0.0 - 1.0
    return r
}

fn m4_look_at(eye: vec3.V3, target: vec3.V3, up: vec3.V3) -> M4 {
    let f: vec3.V3 = vec3.v3_norm(vec3.v3_sub(target, eye))
    var s: vec3.V3 = vec3.v3_cross(f, up)
    if vec3.v3_len2(s) < 0.000000000001 { s = vec3.v3_cross(f, vec3.v3(0.0, 0.0, 1.0)) }
    s = vec3.v3_norm(s)
    let u: vec3.V3 = vec3.v3_cross(s, f)
    var r: M4 = m4_identity()
    r.m[0] = s.x
    r.m[1] = s.y
    r.m[2] = s.z
    r.m[3] = 0.0 - vec3.v3_dot(s, eye)
    r.m[4] = u.x
    r.m[5] = u.y
    r.m[6] = u.z
    r.m[7] = 0.0 - vec3.v3_dot(u, eye)
    r.m[8] = 0.0 - f.x
    r.m[9] = 0.0 - f.y
    r.m[10] = 0.0 - f.z
    r.m[11] = vec3.v3_dot(f, eye)
    return r
}

fn m4_point(a: M4, p: vec3.V3) -> vec3.V3 {
    return vec3.V3 {
        x: a.m[0] * p.x + a.m[1] * p.y + a.m[2] * p.z + a.m[3],
        y: a.m[4] * p.x + a.m[5] * p.y + a.m[6] * p.z + a.m[7],
        z: a.m[8] * p.x + a.m[9] * p.y + a.m[10] * p.z + a.m[11],
    }
}

fn m4_dir(a: M4, d: vec3.V3) -> vec3.V3 {
    return vec3.V3 {
        x: a.m[0] * d.x + a.m[1] * d.y + a.m[2] * d.z,
        y: a.m[4] * d.x + a.m[5] * d.y + a.m[6] * d.z,
        z: a.m[8] * d.x + a.m[9] * d.y + a.m[10] * d.z,
    }
}

fn m4_xform4(a: M4, p: vec3.V3) -> V4 {
    return V4 {
        x: a.m[0] * p.x + a.m[1] * p.y + a.m[2] * p.z + a.m[3],
        y: a.m[4] * p.x + a.m[5] * p.y + a.m[6] * p.z + a.m[7],
        z: a.m[8] * p.x + a.m[9] * p.y + a.m[10] * p.z + a.m[11],
        w: a.m[12] * p.x + a.m[13] * p.y + a.m[14] * p.z + a.m[15],
    }
}

fn m4_transpose(a: M4) -> M4 {
    var r: M4 = M4 { m: [0.0; 16] }
    var i: i32 = 0
    while i < 4 {
        var j: i32 = 0
        while j < 4 {
            r.m[(j * 4 + i) as usize] = a.m[(i * 4 + j) as usize]
            j = j + 1
        }
        i = i + 1
    }
    return r
}

fn m4_cofactor3(a: M4) -> M4 {
    var r: M4 = m4_identity()
    r.m[0] = a.m[5] * a.m[10] - a.m[6] * a.m[9]
    r.m[1] = a.m[6] * a.m[8] - a.m[4] * a.m[10]
    r.m[2] = a.m[4] * a.m[9] - a.m[5] * a.m[8]
    r.m[4] = a.m[2] * a.m[9] - a.m[1] * a.m[10]
    r.m[5] = a.m[0] * a.m[10] - a.m[2] * a.m[8]
    r.m[6] = a.m[1] * a.m[8] - a.m[0] * a.m[9]
    r.m[8] = a.m[1] * a.m[6] - a.m[2] * a.m[5]
    r.m[9] = a.m[2] * a.m[4] - a.m[0] * a.m[6]
    r.m[10] = a.m[0] * a.m[5] - a.m[1] * a.m[4]
    return r
}

fn m4_inverse_affine(a: M4) -> M4 {
    let c: M4 = m4_cofactor3(a)
    let det: f64 = a.m[0] * c.m[0] + a.m[1] * c.m[1] + a.m[2] * c.m[2]
    var r: M4 = m4_identity()
    if absdet(det) < 0.000000000001 { return r }
    let k: f64 = 1.0 / det
    r.m[0] = c.m[0] * k
    r.m[1] = c.m[4] * k
    r.m[2] = c.m[8] * k
    r.m[4] = c.m[1] * k
    r.m[5] = c.m[5] * k
    r.m[6] = c.m[9] * k
    r.m[8] = c.m[2] * k
    r.m[9] = c.m[6] * k
    r.m[10] = c.m[10] * k
    let t: vec3.V3 = vec3.v3(a.m[3], a.m[7], a.m[11])
    let ti: vec3.V3 = m4_dir(r, t)
    r.m[3] = 0.0 - ti.x
    r.m[7] = 0.0 - ti.y
    r.m[11] = 0.0 - ti.z
    return r
}

fn absdet(d: f64) -> f64 {
    if d < 0.0 { return 0.0 - d }
    return d
}
