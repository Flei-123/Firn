import std.math
import scene3d.vec3
import scene3d.mesh
import scene3d.curve

export {
    geom_box, geom_box_open, geom_cylinder, geom_sphere, geom_plane, geom_torus, geom_tube,
}

fn seg_count(n: i32) -> i32 {
    if n < 1 { return 1 }
    return n
}

fn grid_face(m: *mut mesh.Mesh, p0: vec3.V3, du: vec3.V3, dv: vec3.V3, su: i32, sv: i32) {
    let n: vec3.V3 = vec3.v3_norm(vec3.v3_cross(du, dv))
    let base: u32 = mesh.mesh_vertex_count(m) as u32
    var j: i32 = 0
    while j <= sv {
        var i: i32 = 0
        while i <= su {
            let fu: f64 = (i as f64) / (su as f64)
            let fv: f64 = (j as f64) / (sv as f64)
            let p: vec3.V3 = vec3.v3_add(p0, vec3.v3_add(vec3.v3_scale(du, fu), vec3.v3_scale(dv, fv)))
            mesh.mesh_add_vertex(m, p, n, fu, fv)
            i = i + 1
        }
        j = j + 1
    }
    j = 0
    while j < sv {
        var i: i32 = 0
        while i < su {
            let a: u32 = base + (j * (su + 1) + i) as u32
            let b: u32 = a + 1
            let c: u32 = a + (su + 1) as u32
            let d: u32 = c + 1
            mesh.mesh_add_quad(m, a, b, d, c)
            i = i + 1
        }
        j = j + 1
    }
}

fn geom_box(w: f64, h: f64, d: f64) -> mesh.Mesh {
    var m: mesh.Mesh = mesh.mesh_new()
    let hw: f64 = w * 0.5
    let hh: f64 = h * 0.5
    let hd: f64 = d * 0.5
    grid_face(&m, vec3.v3(0.0 - hw, 0.0 - hh, hd), vec3.v3(w, 0.0, 0.0), vec3.v3(0.0, h, 0.0), 1, 1)
    grid_face(&m, vec3.v3(hw, 0.0 - hh, 0.0 - hd), vec3.v3(0.0 - w, 0.0, 0.0), vec3.v3(0.0, h, 0.0), 1, 1)
    grid_face(&m, vec3.v3(hw, 0.0 - hh, hd), vec3.v3(0.0, 0.0, 0.0 - d), vec3.v3(0.0, h, 0.0), 1, 1)
    grid_face(&m, vec3.v3(0.0 - hw, 0.0 - hh, 0.0 - hd), vec3.v3(0.0, 0.0, d), vec3.v3(0.0, h, 0.0), 1, 1)
    grid_face(&m, vec3.v3(0.0 - hw, hh, hd), vec3.v3(w, 0.0, 0.0), vec3.v3(0.0, 0.0, 0.0 - d), 1, 1)
    grid_face(&m, vec3.v3(0.0 - hw, 0.0 - hh, 0.0 - hd), vec3.v3(w, 0.0, 0.0), vec3.v3(0.0, 0.0, d), 1, 1)
    return m
}

fn geom_box_open(w: f64, h: f64, d: f64, wall: f64) -> mesh.Mesh {
    var m: mesh.Mesh = mesh.mesh_new()
    var t: f64 = wall
    let lim: f64 = vec3.minf(vec3.minf(w, h) * 0.49, d * 0.9)
    if t > lim { t = lim }
    if t < 0.000001 { t = 0.000001 }
    let hw: f64 = w * 0.5
    let hh: f64 = h * 0.5
    let hd: f64 = d * 0.5
    let iw: f64 = w - 2.0 * t
    let ih: f64 = h - 2.0 * t
    let zb: f64 = 0.0 - hd + t
    let len: f64 = d - t
    grid_face(&m, vec3.v3(hw, 0.0 - hh, 0.0 - hd), vec3.v3(0.0 - w, 0.0, 0.0), vec3.v3(0.0, h, 0.0), 1, 1)
    grid_face(&m, vec3.v3(hw, 0.0 - hh, hd), vec3.v3(0.0, 0.0, 0.0 - d), vec3.v3(0.0, h, 0.0), 1, 1)
    grid_face(&m, vec3.v3(0.0 - hw, 0.0 - hh, 0.0 - hd), vec3.v3(0.0, 0.0, d), vec3.v3(0.0, h, 0.0), 1, 1)
    grid_face(&m, vec3.v3(0.0 - hw, hh, hd), vec3.v3(w, 0.0, 0.0), vec3.v3(0.0, 0.0, 0.0 - d), 1, 1)
    grid_face(&m, vec3.v3(0.0 - hw, 0.0 - hh, 0.0 - hd), vec3.v3(w, 0.0, 0.0), vec3.v3(0.0, 0.0, d), 1, 1)
    grid_face(&m, vec3.v3(0.0 - iw * 0.5, 0.0 - ih * 0.5, zb), vec3.v3(iw, 0.0, 0.0), vec3.v3(0.0, ih, 0.0), 1, 1)
    grid_face(&m, vec3.v3(0.0 - iw * 0.5, 0.0 - ih * 0.5, hd), vec3.v3(0.0, 0.0, 0.0 - len), vec3.v3(0.0, ih, 0.0), 1, 1)
    grid_face(&m, vec3.v3(iw * 0.5, 0.0 - ih * 0.5, zb), vec3.v3(0.0, 0.0, len), vec3.v3(0.0, ih, 0.0), 1, 1)
    grid_face(&m, vec3.v3(0.0 - iw * 0.5, 0.0 - ih * 0.5, hd), vec3.v3(iw, 0.0, 0.0), vec3.v3(0.0, 0.0, 0.0 - len), 1, 1)
    grid_face(&m, vec3.v3(0.0 - iw * 0.5, ih * 0.5, zb), vec3.v3(iw, 0.0, 0.0), vec3.v3(0.0, 0.0, len), 1, 1)
    grid_face(&m, vec3.v3(0.0 - hw, 0.0 - hh, hd), vec3.v3(t, 0.0, 0.0), vec3.v3(0.0, h, 0.0), 1, 1)
    grid_face(&m, vec3.v3(hw - t, 0.0 - hh, hd), vec3.v3(t, 0.0, 0.0), vec3.v3(0.0, h, 0.0), 1, 1)
    grid_face(&m, vec3.v3(0.0 - iw * 0.5, hh - t, hd), vec3.v3(iw, 0.0, 0.0), vec3.v3(0.0, t, 0.0), 1, 1)
    grid_face(&m, vec3.v3(0.0 - iw * 0.5, 0.0 - hh, hd), vec3.v3(iw, 0.0, 0.0), vec3.v3(0.0, t, 0.0), 1, 1)
    return m
}

fn geom_plane(w: f64, d: f64, sx: i32, sz: i32) -> mesh.Mesh {
    var m: mesh.Mesh = mesh.mesh_new()
    grid_face(&m, vec3.v3(0.0 - w * 0.5, 0.0, d * 0.5), vec3.v3(w, 0.0, 0.0), vec3.v3(0.0, 0.0, 0.0 - d), seg_count(sx), seg_count(sz))
    return m
}

fn geom_cylinder(r_top: f64, r_bottom: f64, h: f64, segs: i32, open_ended: bool) -> mesh.Mesh {
    var m: mesh.Mesh = mesh.mesh_new()
    let sg: i32 = seg_count(segs)
    var sgm: i32 = sg
    if sgm < 3 { sgm = 3 }
    let hh: f64 = h * 0.5
    let slope: f64 = r_bottom - r_top
    var j: i32 = 0
    while j <= sgm {
        let f: f64 = (j as f64) / (sgm as f64)
        let a: f64 = f * vec3.TAU
        let ca: f64 = math.cos(a)
        let sa: f64 = 0.0 - math.sin(a)
        let n: vec3.V3 = vec3.v3_norm(vec3.v3(ca * h, slope, sa * h))
        mesh.mesh_add_vertex(&m, vec3.v3(r_bottom * ca, 0.0 - hh, r_bottom * sa), n, f, 0.0)
        j = j + 1
    }
    j = 0
    while j <= sgm {
        let f: f64 = (j as f64) / (sgm as f64)
        let a: f64 = f * vec3.TAU
        let ca: f64 = math.cos(a)
        let sa: f64 = 0.0 - math.sin(a)
        let n: vec3.V3 = vec3.v3_norm(vec3.v3(ca * h, slope, sa * h))
        mesh.mesh_add_vertex(&m, vec3.v3(r_top * ca, hh, r_top * sa), n, f, 1.0)
        j = j + 1
    }
    j = 0
    while j < sgm {
        let a: u32 = j as u32
        let b: u32 = a + 1
        let c: u32 = a + (sgm + 1) as u32
        let d: u32 = c + 1
        mesh.mesh_add_tri_checked(&m, a, b, d)
        mesh.mesh_add_tri_checked(&m, a, d, c)
        j = j + 1
    }
    if !open_ended {
        add_disc(&m, r_top, hh, sgm, true)
        add_disc(&m, r_bottom, 0.0 - hh, sgm, false)
    }
    return m
}

fn add_disc(m: *mut mesh.Mesh, r: f64, y: f64, segs: i32, up: bool) {
    if r <= 0.0 { return }
    var ny: f64 = 0.0 - 1.0
    if up { ny = 1.0 }
    let n: vec3.V3 = vec3.v3(0.0, ny, 0.0)
    let center: u32 = mesh.mesh_add_vertex(m, vec3.v3(0.0, y, 0.0), n, 0.5, 0.5)
    let first: u32 = mesh.mesh_vertex_count(m) as u32
    var j: i32 = 0
    while j <= segs {
        let a: f64 = ((j as f64) / (segs as f64)) * vec3.TAU
        let ca: f64 = math.cos(a)
        let sa: f64 = math.sin(a)
        mesh.mesh_add_vertex(m, vec3.v3(r * ca, y, 0.0 - r * sa), n, 0.5 + 0.5 * ca, 0.5 + 0.5 * sa)
        j = j + 1
    }
    j = 0
    while j < segs {
        let a: u32 = first + j as u32
        if up {
            mesh.mesh_add_tri(m, center, a, a + 1)
        } else {
            mesh.mesh_add_tri(m, center, a + 1, a)
        }
        j = j + 1
    }
}

fn geom_sphere(r: f64, wseg: i32, hseg: i32) -> mesh.Mesh {
    var m: mesh.Mesh = mesh.mesh_new()
    var ws: i32 = seg_count(wseg)
    if ws < 3 { ws = 3 }
    var hs: i32 = seg_count(hseg)
    if hs < 2 { hs = 2 }
    var k: i32 = 0
    while k <= hs {
        let fv: f64 = (k as f64) / (hs as f64)
        let th: f64 = fv * vec3.PI
        let st: f64 = math.sin(th)
        let ct: f64 = math.cos(th)
        var j: i32 = 0
        while j <= ws {
            let fu: f64 = (j as f64) / (ws as f64)
            let ph: f64 = fu * vec3.TAU
            let n: vec3.V3 = vec3.v3(st * math.cos(ph), ct, 0.0 - st * math.sin(ph))
            mesh.mesh_add_vertex(&m, vec3.v3_scale(n, r), n, fu, 1.0 - fv)
            j = j + 1
        }
        k = k + 1
    }
    k = 0
    while k < hs {
        var j: i32 = 0
        while j < ws {
            let a: u32 = (k * (ws + 1) + j) as u32
            let b: u32 = a + 1
            let c: u32 = a + (ws + 1) as u32
            let d: u32 = c + 1
            mesh.mesh_add_tri_checked(&m, a, c, d)
            mesh.mesh_add_tri_checked(&m, a, d, b)
            j = j + 1
        }
        k = k + 1
    }
    return m
}

fn geom_torus(big_r: f64, small_r: f64, rseg: i32, tseg: i32) -> mesh.Mesh {
    var m: mesh.Mesh = mesh.mesh_new()
    var rs: i32 = seg_count(rseg)
    if rs < 3 { rs = 3 }
    var ts: i32 = seg_count(tseg)
    if ts < 3 { ts = 3 }
    var i: i32 = 0
    while i <= ts {
        let fu: f64 = (i as f64) / (ts as f64)
        let th: f64 = fu * vec3.TAU
        let ct: f64 = math.cos(th)
        let st: f64 = 0.0 - math.sin(th)
        var j: i32 = 0
        while j <= rs {
            let fv: f64 = (j as f64) / (rs as f64)
            let ph: f64 = fv * vec3.TAU
            let cp: f64 = math.cos(ph)
            let sp: f64 = math.sin(ph)
            let n: vec3.V3 = vec3.v3(cp * ct, sp, cp * st)
            let ring: f64 = big_r + small_r * cp
            mesh.mesh_add_vertex(&m, vec3.v3(ring * ct, small_r * sp, ring * st), n, fu, fv)
            j = j + 1
        }
        i = i + 1
    }
    i = 0
    while i < ts {
        var j: i32 = 0
        while j < rs {
            let a: u32 = (i * (rs + 1) + j) as u32
            let b: u32 = a + (rs + 1) as u32
            let c: u32 = a + 1
            let d: u32 = b + 1
            mesh.mesh_add_quad(&m, a, b, d, c)
            j = j + 1
        }
        i = i + 1
    }
    return m
}

fn initial_normal(t: vec3.V3) -> vec3.V3 {
    var axis: vec3.V3 = vec3.v3(1.0, 0.0, 0.0)
    if vec3.absf(t.x) > 0.6 { axis = vec3.v3(0.0, 1.0, 0.0) }
    let proj: vec3.V3 = vec3.v3_sub(axis, vec3.v3_scale(t, vec3.v3_dot(axis, t)))
    return vec3.v3_norm(proj)
}

fn transport(nrm: vec3.V3, t0: vec3.V3, t1: vec3.V3) -> vec3.V3 {
    let ax: vec3.V3 = vec3.v3_cross(t0, t1)
    let s: f64 = vec3.v3_len(ax)
    let c: f64 = vec3.v3_dot(t0, t1)
    var r: vec3.V3 = nrm
    if s > 0.000000001 {
        let k: vec3.V3 = vec3.v3_scale(ax, 1.0 / s)
        r = vec3.v3_scale(nrm, c)
        r = vec3.v3_add(r, vec3.v3_scale(vec3.v3_cross(k, nrm), s))
        r = vec3.v3_add(r, vec3.v3_scale(k, vec3.v3_dot(k, nrm) * (1.0 - c)))
    }
    let flat: vec3.V3 = vec3.v3_sub(r, vec3.v3_scale(t1, vec3.v3_dot(r, t1)))
    return vec3.v3_norm(flat)
}

fn tube_cap(m: *mut mesh.Mesh, p: vec3.V3, nrm: vec3.V3, bin: vec3.V3, axis: vec3.V3, r: f64, rs: i32, end: bool) {
    var cn: vec3.V3 = axis
    if !end { cn = vec3.v3_neg(axis) }
    let center: u32 = mesh.mesh_add_vertex(m, p, cn, 0.5, 0.5)
    let first: u32 = mesh.mesh_vertex_count(m) as u32
    var j: i32 = 0
    while j <= rs {
        let a: f64 = ((j as f64) / (rs as f64)) * vec3.TAU
        let ca: f64 = math.cos(a)
        let sa: f64 = math.sin(a)
        let dir: vec3.V3 = vec3.v3_add(vec3.v3_scale(nrm, ca), vec3.v3_scale(bin, sa))
        mesh.mesh_add_vertex(m, vec3.v3_madd(p, dir, r), cn, 0.5 + 0.5 * ca, 0.5 + 0.5 * sa)
        j = j + 1
    }
    j = 0
    while j < rs {
        let a: u32 = first + j as u32
        if end {
            mesh.mesh_add_tri(m, center, a, a + 1)
        } else {
            mesh.mesh_add_tri(m, center, a + 1, a)
        }
        j = j + 1
    }
}

fn geom_tube(c: *mut curve.Curve, r: f64, tseg: i32, rseg: i32, caps: bool) -> mesh.Mesh {
    var m: mesh.Mesh = mesh.mesh_new()
    if curve.curve_point_count(c) < 2 { return m }
    if curve.curve_length(c) <= 0.0 {
        curve.curve_build(c)
    }
    let total: f64 = curve.curve_length(c)
    if total <= 0.0 { return m }
    var ts: i32 = seg_count(tseg)
    var rs: i32 = seg_count(rseg)
    if rs < 3 { rs = 3 }
    var tprev: vec3.V3 = curve.curve_tangent_at_len(c, 0.0)
    var nrm: vec3.V3 = initial_normal(tprev)
    var first_n: vec3.V3 = nrm
    var last_n: vec3.V3 = nrm
    var last_t: vec3.V3 = tprev
    var last_p: vec3.V3 = curve.curve_point_at_len(c, 0.0)
    var first_p: vec3.V3 = last_p
    var first_t: vec3.V3 = tprev
    var i: i32 = 0
    while i <= ts {
        let fv: f64 = (i as f64) / (ts as f64)
        let p: vec3.V3 = curve.curve_point_at_len(c, total * fv)
        let tg: vec3.V3 = curve.curve_tangent_at_len(c, total * fv)
        if i > 0 { nrm = transport(nrm, tprev, tg) }
        tprev = tg
        let bin: vec3.V3 = vec3.v3_cross(tg, nrm)
        var j: i32 = 0
        while j <= rs {
            let fu: f64 = (j as f64) / (rs as f64)
            let a: f64 = fu * vec3.TAU
            let dir: vec3.V3 = vec3.v3_add(vec3.v3_scale(nrm, math.cos(a)), vec3.v3_scale(bin, math.sin(a)))
            mesh.mesh_add_vertex(&m, vec3.v3_madd(p, dir, r), dir, fu, fv)
            j = j + 1
        }
        last_n = nrm
        last_t = tg
        last_p = p
        i = i + 1
    }
    i = 0
    while i < ts {
        var j: i32 = 0
        while j < rs {
            let a: u32 = (i * (rs + 1) + j) as u32
            let b: u32 = a + 1
            let cc: u32 = a + (rs + 1) as u32
            let d: u32 = cc + 1
            mesh.mesh_add_quad(&m, a, b, d, cc)
            j = j + 1
        }
        i = i + 1
    }
    if caps {
        tube_cap(&m, first_p, first_n, vec3.v3_cross(first_t, first_n), first_t, r, rs, false)
        tube_cap(&m, last_p, last_n, vec3.v3_cross(last_t, last_n), last_t, r, rs, true)
    }
    return m
}
