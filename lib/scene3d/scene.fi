import std.vec
import scene3d.vec3
import scene3d.quat
import scene3d.mat4
import scene3d.mesh
import scene3d.material
import scene3d.light
import scene3d.surface

export {
    Node, Fog, Scene,
    scene_new, scene_free, scene_add_mesh, scene_add_material, scene_add_texture, scene_add_surface,
    scene_texture, scene_add_node, scene_add_mesh_node, scene_node, scene_node_count, scene_mesh,
    scene_material, scene_add_light, scene_update,
    node_set_pos, node_set_rot, node_set_scale, node_set_visible, node_set_opacity, node_set_material,
    node_set_mesh, node_set_euler, node_set_render_order, node_set_sort_group, node_set_shadow,
}

struct Node {
    parent: i32,
    mesh_id: i32,
    mat_id: i32,
    pos: vec3.V3,
    rot: quat.Q4,
    scl: vec3.V3,
    visible: bool,
    opacity: f64,
    cast_shadow: bool,
    receive_shadow: bool,
    world: mat4.M4,
    eff_visible: bool,
    eff_opacity: f64,
    render_order: i32,
    sort_group: i32,
}

struct Fog {
    on: bool,
    color: vec3.V3,
    near: f64,
    far: f64,
}

struct Scene {
    nodes: vec.Vec[Node],
    meshes: vec.Vec[mesh.Mesh],
    mats: vec.Vec[material.Material],
    texs: vec.Vec[surface.Surface],
    lights: vec.Vec[light.Light],
    hemi_sky: vec3.V3,
    hemi_ground: vec3.V3,
    ambient: vec3.V3,
    bg_top: vec3.V3,
    bg_bottom: vec3.V3,
    fog: Fog,
}

fn scene_new() -> Scene {
    return Scene {
        nodes: vec.vec_new[Node](),
        meshes: vec.vec_new[mesh.Mesh](),
        mats: vec.vec_new[material.Material](),
        texs: vec.vec_new[surface.Surface](),
        lights: vec.vec_new[light.Light](),
        hemi_sky: vec3.v3(0.30, 0.34, 0.42),
        hemi_ground: vec3.v3(0.12, 0.11, 0.10),
        ambient: vec3.v3(0.02, 0.02, 0.025),
        bg_top: vec3.rgb_hex(0x10151f),
        bg_bottom: vec3.rgb_hex(0x2a3446),
        fog: Fog { on: false, color: vec3.v3(0.1, 0.12, 0.16), near: 20.0, far: 120.0 },
    }
}

fn scene_free(s: *mut Scene) {
    var i: usize = 0
    let nm: usize = vec.vec_len[mesh.Mesh](&(*s).meshes)
    while i < nm {
        mesh.mesh_free(vec.vec_elem_ptr[mesh.Mesh](&(*s).meshes, i))
        i = i + 1
    }
    i = 0
    let nt: usize = vec.vec_len[surface.Surface](&(*s).texs)
    while i < nt {
        surface.surface_free(vec.vec_elem_ptr[surface.Surface](&(*s).texs, i))
        i = i + 1
    }
    vec.vec_free[Node](&(*s).nodes)
    vec.vec_free[mesh.Mesh](&(*s).meshes)
    vec.vec_free[material.Material](&(*s).mats)
    vec.vec_free[surface.Surface](&(*s).texs)
    vec.vec_free[light.Light](&(*s).lights)
}

fn scene_add_mesh(s: *mut Scene, m: mesh.Mesh) -> i32 {
    vec.vec_push[mesh.Mesh](&(*s).meshes, m)
    return (vec.vec_len[mesh.Mesh](&(*s).meshes) as i32) - 1
}

fn scene_add_material(s: *mut Scene, m: material.Material) -> i32 {
    vec.vec_push[material.Material](&(*s).mats, m)
    return (vec.vec_len[material.Material](&(*s).mats) as i32) - 1
}

fn scene_add_surface(s: *mut Scene, t: surface.Surface) -> i32 {
    vec.vec_push[surface.Surface](&(*s).texs, t)
    return (vec.vec_len[surface.Surface](&(*s).texs) as i32) - 1
}

fn scene_add_texture(s: *mut Scene, w: i32, h: i32) -> i32 {
    return scene_add_surface(s, surface.surface_new(w, h))
}

fn scene_texture(s: *mut Scene, id: i32) -> *mut surface.Surface {
    return vec.vec_elem_ptr[surface.Surface](&(*s).texs, id as usize)
}

fn scene_mesh(s: *mut Scene, id: i32) -> *mut mesh.Mesh {
    return vec.vec_elem_ptr[mesh.Mesh](&(*s).meshes, id as usize)
}

fn scene_material(s: *mut Scene, id: i32) -> *mut material.Material {
    return vec.vec_elem_ptr[material.Material](&(*s).mats, id as usize)
}

fn scene_add_light(s: *mut Scene, l: light.Light) -> i32 {
    vec.vec_push[light.Light](&(*s).lights, l)
    return (vec.vec_len[light.Light](&(*s).lights) as i32) - 1
}

fn node_blank(parent: i32, mesh_id: i32, mat_id: i32) -> Node {
    return Node {
        parent: parent,
        mesh_id: mesh_id,
        mat_id: mat_id,
        pos: vec3.v3_zero(),
        rot: quat.q_identity(),
        scl: vec3.v3_one(),
        visible: true,
        opacity: 1.0,
        cast_shadow: true,
        receive_shadow: true,
        world: mat4.m4_identity(),
        eff_visible: true,
        eff_opacity: 1.0,
        render_order: 0,
        sort_group: 0 - 1,
    }
}

fn scene_add_node(s: *mut Scene, parent: i32) -> i32 {
    vec.vec_push[Node](&(*s).nodes, node_blank(parent, 0 - 1, 0 - 1))
    return (vec.vec_len[Node](&(*s).nodes) as i32) - 1
}

fn scene_add_mesh_node(s: *mut Scene, parent: i32, mesh_id: i32, mat_id: i32) -> i32 {
    vec.vec_push[Node](&(*s).nodes, node_blank(parent, mesh_id, mat_id))
    return (vec.vec_len[Node](&(*s).nodes) as i32) - 1
}

fn scene_node(s: *mut Scene, id: i32) -> *mut Node {
    return vec.vec_elem_ptr[Node](&(*s).nodes, id as usize)
}

fn scene_node_count(s: *mut Scene) -> i32 {
    return vec.vec_len[Node](&(*s).nodes) as i32
}

fn node_set_pos(n: *mut Node, p: vec3.V3) {
    (*n).pos = p
}

fn node_set_rot(n: *mut Node, q: quat.Q4) {
    (*n).rot = q
}

fn node_set_euler(n: *mut Node, rx: f64, ry: f64, rz: f64) {
    (*n).rot = quat.q_euler(rx, ry, rz)
}

fn node_set_scale(n: *mut Node, sc: vec3.V3) {
    (*n).scl = sc
}

fn node_set_visible(n: *mut Node, v: bool) {
    (*n).visible = v
}

fn node_set_opacity(n: *mut Node, o: f64) {
    (*n).opacity = vec3.clamp01(o)
}

fn node_set_shadow(n: *mut Node, cast: bool, receive: bool) {
    (*n).cast_shadow = cast
    (*n).receive_shadow = receive
}

fn node_set_material(n: *mut Node, mat_id: i32) {
    (*n).mat_id = mat_id
}

fn node_set_mesh(n: *mut Node, mesh_id: i32) {
    (*n).mesh_id = mesh_id
}

fn node_set_render_order(n: *mut Node, o: i32) {
    (*n).render_order = o
}

fn node_set_sort_group(n: *mut Node, g: i32) {
    (*n).sort_group = g
}

fn scene_update(s: *mut Scene) {
    let n: usize = vec.vec_len[Node](&(*s).nodes)
    var i: usize = 0
    while i < n {
        let nd: *mut Node = vec.vec_elem_ptr[Node](&(*s).nodes, i)
        let local: mat4.M4 = mat4.m4_compose((*nd).pos, (*nd).rot, (*nd).scl)
        let par: i32 = (*nd).parent
        if par >= 0 && (par as usize) < i {
            let pn: *mut Node = vec.vec_elem_ptr[Node](&(*s).nodes, par as usize)
            (*nd).world = mat4.m4_mul((*pn).world, local)
            (*nd).eff_visible = (*nd).visible && (*pn).eff_visible
            (*nd).eff_opacity = (*nd).opacity * (*pn).eff_opacity
        } else {
            (*nd).world = local
            (*nd).eff_visible = (*nd).visible
            (*nd).eff_opacity = (*nd).opacity
        }
        i = i + 1
    }
}
