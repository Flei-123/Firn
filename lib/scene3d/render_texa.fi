// SPDX-License-Identifier: MPL-2.0
import std.rt
import scene3d.vec3
import scene3d.surface
import scene3d.render_types

export {
    TexAlpha, sample_alpha,
}

struct TexAlpha {
    r: f64,
    g: f64,
    b: f64,
    a: f64,
}

fn chan(r: *mut render_types.Renderer, p: u32, sh: u32) -> f64 {
    return render_types.ldf((*r).lut_tex, ((p >> sh) & 255 as u32) as usize)
}

fn fetch(ts: *mut surface.Surface, x: i32, y: i32) -> u32 {
    return rt.ld32((*ts).px, (y as usize) * ((*ts).w as usize) + (x as usize))
}

fn accum(r: *mut render_types.Renderer, out: *mut TexAlpha, p: u32, wt: f64) {
    let a: f64 = (((p >> 24 as u32) & 255 as u32) as f64) * (1.0 / 255.0)
    let k: f64 = wt * a
    (*out).r = (*out).r + chan(r, p, 0 as u32) * k
    (*out).g = (*out).g + chan(r, p, 8 as u32) * k
    (*out).b = (*out).b + chan(r, p, 16 as u32) * k
    (*out).a = (*out).a + k
}

fn sample_alpha(r: *mut render_types.Renderer, tp: u64, u: f64, v: f64, out: *mut TexAlpha) {
    let ts: *mut surface.Surface = tp as *mut surface.Surface
    let w: i32 = (*ts).w
    let h: i32 = (*ts).h
    let fx: f64 = vec3.clamp01(u) * ((w - 1) as f64)
    let fy: f64 = (1.0 - vec3.clamp01(v)) * ((h - 1) as f64)
    let x0: i32 = fx as i32
    let y0: i32 = fy as i32
    var x1: i32 = x0 + 1
    var y1: i32 = y0 + 1
    if x1 >= w { x1 = w - 1 }
    if y1 >= h { y1 = h - 1 }
    let tx: f64 = fx - (x0 as f64)
    let ty: f64 = fy - (y0 as f64)
    (*out).r = 0.0
    (*out).g = 0.0
    (*out).b = 0.0
    (*out).a = 0.0
    accum(r, out, fetch(ts, x0, y0), (1.0 - tx) * (1.0 - ty))
    accum(r, out, fetch(ts, x1, y0), tx * (1.0 - ty))
    accum(r, out, fetch(ts, x0, y1), (1.0 - tx) * ty)
    accum(r, out, fetch(ts, x1, y1), tx * ty)
    if (*out).a > 0.000001 {
        let k: f64 = 1.0 / (*out).a
        (*out).r = (*out).r * k
        (*out).g = (*out).g * k
        (*out).b = (*out).b * k
    } else {
        (*out).r = 0.0
        (*out).g = 0.0
        (*out).b = 0.0
    }
}
