// SPDX-License-Identifier: MPL-2.0
import std.math
import scene3d.vec3
import scene3d.material
import scene3d.render_types
import scene3d.shadow_types

export {
    factor,
}

const MAX_SOFT: f64 = 6.0
const MIN_SOFT: f64 = 0.5
const MIN_NDL: f64 = 0.1

fn texel_visibility(m: *mut shadow_types.ShadowMap, ix: i32, iy: i32, dr: f64, bias: f64) -> f64 {
    if ix < 0 || iy < 0 || ix >= (*m).size || iy >= (*m).size { return 1.0 }
    let at: usize = (iy as usize) * ((*m).size as usize) + (ix as usize)
    var v: f64 = 1.0
    if dr > (render_types.ldf32((*m).depth.p, at) as f64) + bias { v = 0.0 }
    if (*m).has_trans {
        if dr > (render_types.ldf32((*m).tdepth.p, at) as f64) + bias {
            v = v * (render_types.ldf32((*m).tfac.p, at) as f64)
        }
    }
    return v
}

fn overlap(i: i32, lo: f64, hi: f64) -> f64 {
    let a: f64 = vec3.maxf(i as f64, lo)
    let b: f64 = vec3.minf((i + 1) as f64, hi)
    if b <= a { return 0.0 }
    return b - a
}

fn pcf_open(m: *mut shadow_types.ShadowMap, ix0: i32, ix1: i32, iy0: i32, iy1: i32, x_lo: f64, x_hi: f64, y_lo: f64, y_hi: f64, dr: f64, bias: f64) -> f64 {
    let dp: u64 = (*m).depth.p
    let tp: u64 = (*m).tdepth.p
    let fp: u64 = (*m).tfac.p
    let trans: bool = (*m).has_trans
    let n: usize = (*m).size as usize
    let wfirst: f64 = overlap(ix0, x_lo, x_hi)
    let wlast: f64 = overlap(ix1, x_lo, x_hi)
    var num: f64 = 0.0
    var den: f64 = 0.0
    var iy: i32 = iy0
    while iy <= iy1 {
        let wy: f64 = overlap(iy, y_lo, y_hi)
        let row: usize = (iy as usize) * n
        var ix: i32 = ix0
        while ix <= ix1 {
            var wx: f64 = 1.0
            if ix == ix0 {
                wx = wfirst
            } else if ix == ix1 {
                wx = wlast
            }
            let w: f64 = wx * wy
            if w > 0.0 {
                let at: usize = row + (ix as usize)
                var v: f64 = 1.0
                if dr > (render_types.ldf32(dp, at) as f64) + bias {
                    v = 0.0
                } else if trans {
                    if dr > (render_types.ldf32(tp, at) as f64) + bias { v = render_types.ldf32(fp, at) as f64 }
                }
                if v > 0.0 { num = num + w * v }
                den = den + w
            }
            ix = ix + 1
        }
        iy = iy + 1
    }
    if den <= 0.0 { return 1.0 }
    return num / den
}

fn sample_map(m: *mut shadow_types.ShadowMap, px: f64, py: f64, pz: f64, nx: f64, ny: f64, nz: f64, ndl: f64) -> f64 {
    var soft: f64 = (*m).soft
    if soft < MIN_SOFT { soft = MIN_SOFT }
    if soft > MAX_SOFT { soft = MAX_SOFT }
    var sin2: f64 = 1.0 - ndl * ndl
    if sin2 < 0.0 { sin2 = 0.0 }
    let sin_t: f64 = math.sqrt(sin2)
    var cos_t: f64 = ndl
    if cos_t < MIN_NDL { cos_t = MIN_NDL }
    let tan_t: f64 = sin_t / cos_t
    let ofs: f64 = (*m).texel * sin_t * 1.5
    let q: vec3.V3 = vec3.v3(px + nx * ofs, py + ny * ofs, pz + nz * ofs)
    let tcx: f64 = (vec3.v3_dot((*m).right, q) - (*m).umin) / (*m).texel
    let tcy: f64 = (vec3.v3_dot((*m).up, q) - (*m).vmin) / (*m).texel
    let n: f64 = (*m).size as f64
    if tcx + soft < 0.0 || tcy + soft < 0.0 || tcx - soft > n || tcy - soft > n { return 1.0 }
    let dr: f64 = (*m).zmax - vec3.v3_dot((*m).to_light, q)
    let bias: f64 = (*m).bias + (*m).texel * tan_t * (soft + 0.5)
    let x_lo: f64 = tcx - soft
    let x_hi: f64 = tcx + soft
    let y_lo: f64 = tcy - soft
    let y_hi: f64 = tcy + soft
    let ix0: i32 = math.floor(x_lo) as i32
    let ix1: i32 = math.floor(x_hi) as i32
    let iy0: i32 = math.floor(y_lo) as i32
    let iy1: i32 = math.floor(y_hi) as i32
    if ix0 >= 0 && iy0 >= 0 && ix1 < (*m).size && iy1 < (*m).size {
        return pcf_open(m, ix0, ix1, iy0, iy1, x_lo, x_hi, y_lo, y_hi, dr, bias)
    }
    var num: f64 = 0.0
    var den: f64 = 0.0
    var iy: i32 = iy0
    while iy <= iy1 {
        let wy: f64 = overlap(iy, y_lo, y_hi)
        var ix: i32 = ix0
        while ix <= ix1 {
            let w: f64 = overlap(ix, x_lo, x_hi) * wy
            ix = ix + 1
            if w <= 0.0 { continue }
            num = num + w * texel_visibility(m, ix - 1, iy, dr, bias)
            den = den + w
        }
        iy = iy + 1
    }
    if den <= 0.0 { return 1.0 }
    return num / den
}

fn factor(r: *mut render_types.Renderer, t: *mut render_types.Tri, light: i32, px: f64, py: f64, pz: f64, nx: f64, ny: f64, nz: f64, ndl: f64) -> f64 {
    if (*r).shadow == 0 as u64 { return 1.0 }
    if (*t).recv == false { return 1.0 }
    let mt: *mut material.Material = (*t).mat as *mut material.Material
    if (*mt).receive_shadow == false { return 1.0 }
    let mp: u64 = shadow_types.map_for((*r).shadow as *mut shadow_types.ShadowSet, light)
    if mp == 0 as u64 { return 1.0 }
    return sample_map(mp as *mut shadow_types.ShadowMap, px, py, pz, nx, ny, nz, ndl)
}
