import std.rt
import scene3d.vec3
import scene3d.render_types

export {
    ShadowMap, ShadowSet, MAX_SHADOW_LIGHTS, WSTRIDE, PSTRIDE, FAR_DEPTH,
    set_alloc, set_release, map_release, map_for,
}

const MAX_SHADOW_LIGHTS: i32 = 2
const WSTRIDE: usize = 10
const PSTRIDE: usize = 16
const FAR_DEPTH: f64 = 1.0e30

struct ShadowMap {
    active: bool,
    has_trans: bool,
    light: i32,
    size: i32,
    ntris: i32,
    world: u64,
    right: vec3.V3,
    up: vec3.V3,
    to_light: vec3.V3,
    umin: f64,
    vmin: f64,
    texel: f64,
    zmax: f64,
    bias: f64,
    soft: f64,
    depth: render_types.Block,
    tdepth: render_types.Block,
    tfac: render_types.Block,
    proj: render_types.Block,
}

struct ShadowSet {
    world: render_types.Block,
    nworld: i32,
    has_trans: bool,
    have_bounds: bool,
    bmin: vec3.V3,
    bmax: vec3.V3,
    m0: ShadowMap,
    m1: ShadowMap,
}

fn blk0() -> render_types.Block {
    return render_types.Block { p: 0 as u64, cap: 0 }
}

fn map_blank() -> ShadowMap {
    let z: vec3.V3 = vec3.v3_zero()
    return ShadowMap {
        active: false, has_trans: false, light: 0 - 1, size: 0, ntris: 0, world: 0 as u64,
        right: z, up: z, to_light: z, umin: 0.0, vmin: 0.0, texel: 1.0, zmax: 0.0, bias: 0.0, soft: 1.0,
        depth: blk0(), tdepth: blk0(), tfac: blk0(), proj: blk0(),
    }
}

fn shadow_zalloc[T]() -> u64 {
    return rt.heap_alloc(size_of[T]())
}

fn shadow_zfree[T](p: u64) {
    rt.heap_free(p, size_of[T]())
}

fn set_alloc() -> u64 {
    let p: u64 = shadow_zalloc[ShadowSet]()
    let z: vec3.V3 = vec3.v3_zero()
    *(p as *mut ShadowSet) = ShadowSet {
        world: blk0(), nworld: 0, has_trans: false, have_bounds: false, bmin: z, bmax: z,
        m0: map_blank(), m1: map_blank(),
    }
    return p
}

fn map_release(m: *mut ShadowMap) {
    render_types.blk_free(&(*m).depth)
    render_types.blk_free(&(*m).tdepth)
    render_types.blk_free(&(*m).tfac)
    render_types.blk_free(&(*m).proj)
    (*m).active = false
}

fn set_release(p: u64) {
    if p == 0 as u64 { return }
    let s: *mut ShadowSet = p as *mut ShadowSet
    map_release(&(*s).m0)
    map_release(&(*s).m1)
    render_types.blk_free(&(*s).world)
    shadow_zfree[ShadowSet](p)
}

fn map_for(s: *mut ShadowSet, light: i32) -> u64 {
    if (*s).m0.active && (*s).m0.light == light { return (&(*s).m0) as u64 }
    if (*s).m1.active && (*s).m1.light == light { return (&(*s).m1) as u64 }
    return 0 as u64
}
