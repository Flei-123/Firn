import scene3d.vec3

export {
    Light, LIGHT_DIR, LIGHT_POINT, light_dir, light_point,
}

const LIGHT_DIR: i32 = 0
const LIGHT_POINT: i32 = 1

struct Light {
    kind: i32,
    vec: vec3.V3,
    color: vec3.V3,
    intensity: f64,
    range: f64,
}

fn light_dir(to_light: vec3.V3, color: vec3.V3, intensity: f64) -> Light {
    return Light { kind: LIGHT_DIR, vec: vec3.v3_norm(to_light), color: color, intensity: intensity, range: 0.0 }
}

fn light_point(pos: vec3.V3, color: vec3.V3, intensity: f64, range: f64) -> Light {
    return Light { kind: LIGHT_POINT, vec: pos, color: color, intensity: intensity, range: range }
}
