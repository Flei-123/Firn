import scene3d.vec3

export {
    Light, LIGHT_DIR, LIGHT_POINT, light_dir, light_point, light_set_shadow,
}

const LIGHT_DIR: i32 = 0
const LIGHT_POINT: i32 = 1

struct Light {
    kind: i32,
    vec: vec3.V3,
    color: vec3.V3,
    intensity: f64,
    range: f64,
    shadow: bool,
    shadow_size: i32,
    shadow_bias: f64,
    shadow_soft: f64,
}

fn light_dir(to_light: vec3.V3, color: vec3.V3, intensity: f64) -> Light {
    return Light { kind: LIGHT_DIR, vec: vec3.v3_norm(to_light), color: color, intensity: intensity, range: 0.0, shadow: false, shadow_size: 2048, shadow_bias: 0.004, shadow_soft: 1.5 }
}

fn light_point(pos: vec3.V3, color: vec3.V3, intensity: f64, range: f64) -> Light {
    return Light { kind: LIGHT_POINT, vec: pos, color: color, intensity: intensity, range: range, shadow: false, shadow_size: 2048, shadow_bias: 0.004, shadow_soft: 1.5 }
}

fn light_set_shadow(l: *mut Light, size: i32, bias: f64, soft: f64) {
    (*l).shadow = true
    (*l).shadow_size = size
    (*l).shadow_bias = bias
    (*l).shadow_soft = soft
}
