import std.vec
import jobs.jobs
import scene3d.light
import scene3d.scene
import scene3d.render_types
import scene3d.shadow_types
import scene3d.shadow_collect
import scene3d.shadow_fit
import scene3d.shadow_raster

export {
    shadow_frame, shadow_free,
}

fn run_range(r: *mut render_types.Renderer, body: fn(u64, u64, u64), n: u64, chunk: u64, ctx: u64) {
    if (*r).use_pool {
        jobs.parallel_for(&(*r).pool, 0 as u64, n, chunk, body, ctx)
    } else {
        body(ctx, 0 as u64, n)
    }
}

fn build_map(r: *mut render_types.Renderer, s: *mut shadow_types.ShadowSet, m: *mut shadow_types.ShadowMap, slot: i32, l: *mut light.Light) {
    shadow_fit.fit(s, m, (*l).vec, (*l).shadow_size, (*l).shadow_bias, (*l).shadow_soft)
    (*m).light = slot
    shadow_fit.prepare_buffers(m)
    let ctx: u64 = m as u64
    run_range(r, shadow_raster.project_task, (*m).ntris as u64, 2048 as u64, ctx)
    let bands: u64 = (((*m).size + shadow_raster.BAND_ROWS - 1) / shadow_raster.BAND_ROWS) as u64
    run_range(r, shadow_raster.raster_task, bands, 1 as u64, ctx)
    (*m).active = true
}

fn wants_shadow(l: *mut light.Light) -> bool {
    return (*l).shadow && (*l).kind == light.LIGHT_DIR
}

#[allow_escape]
fn shadow_frame(r: *mut render_types.Renderer, sc: *mut scene.Scene) {
    var n: i32 = vec.vec_len[light.Light](&(*sc).lights) as i32
    if n > render_types.MAX_LIGHTS { n = render_types.MAX_LIGHTS }
    var want: i32 = 0
    var i: i32 = 0
    while i < n {
        if wants_shadow(vec.vec_elem_ptr[light.Light](&(*sc).lights, i as usize)) { want = want + 1 }
        i = i + 1
    }
    if (*r).shadow == 0 as u64 {
        if want == 0 { return }
        (*r).shadow = shadow_types.set_alloc()
    }
    let s: *mut shadow_types.ShadowSet = (*r).shadow as *mut shadow_types.ShadowSet
    (*s).m0.active = false
    (*s).m1.active = false
    if want == 0 { return }
    shadow_collect.collect(r, sc, s)
    if (*s).have_bounds == false || (*s).nworld == 0 { return }
    var used: i32 = 0
    i = 0
    while i < n && used < shadow_types.MAX_SHADOW_LIGHTS {
        let l: *mut light.Light = vec.vec_elem_ptr[light.Light](&(*sc).lights, i as usize)
        if wants_shadow(l) {
            if used == 0 { build_map(r, s, &(*s).m0, i, l) }
            if used == 1 { build_map(r, s, &(*s).m1, i, l) }
            used = used + 1
        }
        i = i + 1
    }
}

fn shadow_free(r: *mut render_types.Renderer) {
    shadow_types.set_release((*r).shadow)
    (*r).shadow = 0 as u64
}
