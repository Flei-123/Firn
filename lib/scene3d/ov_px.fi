// SPDX-License-Identifier: MPL-2.0
import std.rt
import scene3d.vec3
import scene3d.surface

export {
    rgba, rgb, color_alpha, color_fade, color_with_alpha, px_blend, px_read,
    color_r, color_g, color_b,
}

fn clamp255(v: i32) -> u32 {
    if v < 0 { return 0 as u32 }
    if v > 255 { return 255 as u32 }
    return v as u32
}

fn rgba(r: i32, g: i32, b: i32, a: i32) -> u32 {
    return (clamp255(a) << 24 as u32) | (clamp255(b) << 16 as u32) | (clamp255(g) << 8 as u32) | clamp255(r)
}

fn rgb(r: i32, g: i32, b: i32) -> u32 {
    return rgba(r, g, b, 255)
}

fn color_r(c: u32) -> i32 {
    return (c & 255 as u32) as i32
}

fn color_g(c: u32) -> i32 {
    return ((c >> 8 as u32) & 255 as u32) as i32
}

fn color_b(c: u32) -> i32 {
    return ((c >> 16 as u32) & 255 as u32) as i32
}

fn color_alpha(c: u32) -> i32 {
    return ((c >> 24 as u32) & 255 as u32) as i32
}

fn color_with_alpha(c: u32, a: i32) -> u32 {
    return rgba(color_r(c), color_g(c), color_b(c), a)
}

fn color_fade(c: u32, f: f64) -> u32 {
    let a: f64 = (color_alpha(c) as f64) * vec3.clamp01(f)
    return color_with_alpha(c, (a + 0.5) as i32)
}

fn px_read(dst: *mut surface.Surface, x: i32, y: i32) -> u32 {
    if x < 0 || y < 0 || x >= (*dst).w || y >= (*dst).h {
        return 0 as u32
    }
    return rt.ld32((*dst).px, (y as usize) * ((*dst).w as usize) + (x as usize))
}

fn px_blend(dst: *mut surface.Surface, x: i32, y: i32, col: u32, cov: f64) {
    if x < 0 || y < 0 || x >= (*dst).w || y >= (*dst).h {
        return
    }
    let sa: f64 = (color_alpha(col) as f64) / 255.0 * cov
    if sa <= 0.0 {
        return
    }
    let at: usize = (y as usize) * ((*dst).w as usize) + (x as usize)
    let d: u32 = rt.ld32((*dst).px, at)
    let da: f64 = (color_alpha(d) as f64) / 255.0
    let oa: f64 = sa + da * (1.0 - sa)
    let wd: f64 = da * (1.0 - sa)
    let r: f64 = ((color_r(col) as f64) * sa + (color_r(d) as f64) * wd) / oa
    let g: f64 = ((color_g(col) as f64) * sa + (color_g(d) as f64) * wd) / oa
    let b: f64 = ((color_b(col) as f64) * sa + (color_b(d) as f64) * wd) / oa
    rt.st32((*dst).px, at, rgba((r + 0.5) as i32, (g + 0.5) as i32, (b + 0.5) as i32, (oa * 255.0 + 0.5) as i32))
}
