import std.rt
import std.vec
import jobs.jobs
import scene3d.vec3
import scene3d.mat4
import scene3d.camera
import scene3d.mesh
import scene3d.material
import scene3d.scene
import scene3d.surface
import scene3d.render_types
import scene3d.render_vertex
import scene3d.render_tri
import scene3d.render_bins
import scene3d.setup_state

export {
    setup_frame,
}

const VERTEX_CHUNK: usize = 2048
const TRI_CHUNK: usize = 1024

fn unit_of(st: *mut setup_state.State, node: i32, group: i32) -> i32 {
    if group < 0 { return node }
    let n: usize = vec.vec_len[i32](&(*st).groups)
    var i: usize = 0
    while i < n {
        if *vec.vec_elem_ptr[i32](&(*st).groups, i) == group {
            return *vec.vec_elem_ptr[i32](&(*st).groups, i + 1)
        }
        i = i + 2
    }
    vec.vec_push[i32](&(*st).groups, group)
    vec.vec_push[i32](&(*st).groups, node)
    return node
}

fn collect_jobs(r: *mut render_types.Renderer, sc: *mut scene.Scene, vp: mat4.M4) -> usize {
    let st: *mut setup_state.State = &(*r).ps
    vec.vec_clear[setup_state.SetupJob](&(*st).jobs)
    vec.vec_clear[i32](&(*st).groups)
    let nn: i32 = scene.scene_node_count(sc)
    let n_mats: usize = vec.vec_len[material.Material](&(*sc).mats)
    let n_tex: usize = vec.vec_len[surface.Surface](&(*sc).texs)
    let n_mesh: usize = vec.vec_len[mesh.Mesh](&(*sc).meshes)
    var total_v: usize = 0
    var ni: i32 = 0
    while ni < nn {
        let nd: *mut scene.Node = scene.scene_node(sc, ni)
        let node: i32 = ni
        ni = ni + 1
        if (*nd).eff_visible == false { continue }
        if (*nd).mesh_id < 0 || ((*nd).mesh_id as usize) >= n_mesh { continue }
        if (*nd).eff_opacity <= 0.0 { continue }
        var mp: u64 = (&(*r).def_mat) as u64
        if (*nd).mat_id >= 0 && ((*nd).mat_id as usize) < n_mats {
            mp = scene.scene_material(sc, (*nd).mat_id) as u64
        }
        let mt: *mut material.Material = mp as *mut material.Material
        let alpha: f64 = (*mt).opacity * (*nd).eff_opacity
        if alpha <= 0.0 { continue }
        var tp: u64 = 0 as u64
        if (*mt).tex >= 0 && ((*mt).tex as usize) < n_tex {
            let ts: *mut surface.Surface = scene.scene_texture(sc, (*mt).tex)
            if (*ts).px != 0 as u64 { tp = ts as u64 }
        }
        let m: *mut mesh.Mesh = scene.scene_mesh(sc, (*nd).mesh_id)
        let nt: usize = mesh.mesh_tri_count(m)
        if nt == 0 { continue }
        let nv: usize = mesh.mesh_vertex_count(m)
        let w: mat4.M4 = (*nd).world
        vec.vec_push[setup_state.SetupJob](&(*st).jobs, setup_state.SetupJob {
            node: node, mesh: m as u64, mp: mp, tp: tp, alpha: alpha, recv: (*nd).receive_shadow,
            unit: unit_of(st, node, (*nd).sort_group), order: (*nd).render_order,
            voff: total_v, nv: nv, nt: nt,
            w: w, mvp: mat4.m4_mul(vp, w), cf: mat4.m4_cofactor3(w),
        })
        total_v = total_v + nv
    }
    return total_v
}

fn split_chunks(st: *mut setup_state.State, out: *mut vec.Vec[setup_state.Chunk], by_vertex: bool, size: usize) {
    vec.vec_clear[setup_state.Chunk](out)
    let nj: usize = vec.vec_len[setup_state.SetupJob](&(*st).jobs)
    var j: usize = 0
    while j < nj {
        let jb: *mut setup_state.SetupJob = vec.vec_elem_ptr[setup_state.SetupJob](&(*st).jobs, j)
        var total: usize = (*jb).nt
        if by_vertex { total = (*jb).nv }
        var lo: usize = 0
        while lo < total {
            var hi: usize = lo + size
            if hi > total { hi = total }
            vec.vec_push[setup_state.Chunk](out, setup_state.Chunk { job: j as i32, lo: lo, hi: hi, count: 0, dest: 0 })
            lo = hi
        }
        j = j + 1
    }
}

fn vertex_task(ctx: u64, lo: u64, hi: u64) {
    let r: *mut render_types.Renderer = ctx as *mut render_types.Renderer
    var c: usize = lo as usize
    while c < (hi as usize) {
        let ck: *mut setup_state.Chunk = vec.vec_elem_ptr[setup_state.Chunk](&(*r).ps.vch, c)
        let jb: *mut setup_state.SetupJob = vec.vec_elem_ptr[setup_state.SetupJob](&(*r).ps.jobs, (*ck).job as usize)
        render_vertex.load_range(r, jb, (*ck).lo, (*ck).hi)
        c = c + 1
    }
}

fn run_chunk_tris(r: *mut render_types.Renderer, jb: *mut setup_state.SetupJob, sk: *mut render_tri.Sink, k0: usize, k1: usize) {
    let m: *mut mesh.Mesh = (*jb).mesh as *mut mesh.Mesh
    let ip: u64 = vec.vec_ptr[u32](&(*m).idx)
    let nv: usize = (*jb).nv
    let base: u64 = (*r).vbuf.p +% (((*jb).voff * render_types.VSTRIDE * 8) as u64)
    var k: usize = k0
    while k < k1 {
        let ia: usize = rt.ld32(ip, k * 3) as usize
        let ib: usize = rt.ld32(ip, k * 3 + 1) as usize
        let ic: usize = rt.ld32(ip, k * 3 + 2) as usize
        k = k + 1
        if ia >= nv || ib >= nv || ic >= nv { continue }
        let va: u64 = base +% ((ia * render_types.VSTRIDE * 8) as u64)
        let vb: u64 = base +% ((ib * render_types.VSTRIDE * 8) as u64)
        let vc: u64 = base +% ((ic * render_types.VSTRIDE * 8) as u64)
        render_tri.process_tri(r, sk, va, vb, vc)
    }
}

fn tri_chunk(r: *mut render_types.Renderer, c: usize, dry: bool) {
    let ck: *mut setup_state.Chunk = vec.vec_elem_ptr[setup_state.Chunk](&(*r).ps.tch, c)
    let jb: *mut setup_state.SetupJob = vec.vec_elem_ptr[setup_state.SetupJob](&(*r).ps.jobs, (*ck).job as usize)
    var sk: render_tri.Sink = render_tri.Sink {
        base: vec.vec_ptr[render_types.Tri](&(*r).tris), at: (*ck).dest, dry: dry,
        unit: (*jb).unit, order: (*jb).order,
        tmp: vec.vec_ptr[f64](&(*r).ps.tmp) +% ((c * 2 * render_types.VSTRIDE * 8) as u64),
        mp: (*jb).mp, tp: (*jb).tp, alpha: (*jb).alpha, recv: (*jb).recv,
    }
    run_chunk_tris(r, jb, &sk, (*ck).lo, (*ck).hi)
    if dry { (*ck).count = sk.at - (*ck).dest }
}

fn count_task(ctx: u64, lo: u64, hi: u64) {
    let r: *mut render_types.Renderer = ctx as *mut render_types.Renderer
    var c: usize = lo as usize
    while c < (hi as usize) {
        tri_chunk(r, c, true)
        c = c + 1
    }
}

fn fill_task(ctx: u64, lo: u64, hi: u64) {
    let r: *mut render_types.Renderer = ctx as *mut render_types.Renderer
    var c: usize = lo as usize
    while c < (hi as usize) {
        tri_chunk(r, c, false)
        c = c + 1
    }
}

fn run_parallel(r: *mut render_types.Renderer, body: fn(u64, u64, u64), n: usize) {
    if n == 0 { return }
    if (*r).use_pool {
        jobs.parallel_for(&(*r).pool, 0 as u64, n as u64, 1 as u64, body, r as u64)
    } else {
        body(r as u64, 0 as u64, n as u64)
    }
}

#[allow_escape]
fn setup_frame(r: *mut render_types.Renderer, sc: *mut scene.Scene, cam: *mut camera.Camera) {
    let vp: mat4.M4 = camera.cam_view_proj(*cam)
    (*r).near = vec3.maxf((*cam).near, 0.00001)
    (*r).far = (*cam).far
    (*r).cam_x = (*cam).pos.x
    (*r).cam_y = (*cam).pos.y
    (*r).cam_z = (*cam).pos.z
    vec.vec_clear[render_types.Tri](&(*r).tris)
    let st: *mut setup_state.State = &(*r).ps
    let total_v: usize = collect_jobs(r, sc, vp)
    render_types.blk_ensure(&(*r).vbuf, total_v * render_types.VSTRIDE * 8)
    split_chunks(st, &(*st).vch, true, VERTEX_CHUNK)
    run_parallel(r, vertex_task, vec.vec_len[setup_state.Chunk](&(*st).vch))
    split_chunks(st, &(*st).tch, false, TRI_CHUNK)
    let nc: usize = vec.vec_len[setup_state.Chunk](&(*st).tch)
    vec.vec_clear[f64](&(*st).tmp)
    vec.vec_reserve[f64](&(*st).tmp, nc * 2 * render_types.VSTRIDE + 1)
    run_parallel(r, count_task, nc)
    var total: usize = 0
    var c: usize = 0
    while c < nc {
        let ck: *mut setup_state.Chunk = vec.vec_elem_ptr[setup_state.Chunk](&(*st).tch, c)
        (*ck).dest = total
        total = total + (*ck).count
        c = c + 1
    }
    vec.vec_reserve[render_types.Tri](&(*r).tris, total + 1)
    (*r).tris.len = total
    run_parallel(r, fill_task, nc)
    render_bins.build_bins(r, scene.scene_node_count(sc) as usize)
}
