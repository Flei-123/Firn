import std.rt
import std.vec
import std.math
import scene3d.vec3
import scene3d.mat4
import scene3d.camera
import scene3d.mesh
import scene3d.material
import scene3d.scene
import scene3d.surface
import scene3d.render_types

export {
    setup_frame,
}

struct Edge {
    x: f64,
    y: f64,
    q: f64,
    s: f64,
}

fn edge_of(ax: f64, ay: f64, bx: f64, by: f64) -> Edge {
    if ay < by {
        return Edge { x: ax, y: ay, q: by, s: (bx - ax) / (by - ay) }
    }
    if by < ay {
        return Edge { x: bx, y: by, q: ay, s: (ax - bx) / (ay - by) }
    }
    return Edge { x: 0.0, y: 1.0e30, q: 0.0 - 1.0e30, s: 0.0 }
}

fn row_of(v: f64, hi: i32) -> i32 {
    var c: f64 = math.ceil(v - 0.5)
    if c < 0.0 { c = 0.0 }
    if c > (hi as f64) { c = hi as f64 }
    return c as i32
}

fn vtx_screen(r: *mut render_types.Renderer, v: u64) {
    let cw: f64 = render_types.ldf(v, 10)
    let iw: f64 = 1.0 / cw
    render_types.stf(v, 13, iw)
    render_types.stf(v, 11, (render_types.ldf(v, 8) * iw * 0.5 + 0.5) * ((*r).sw as f64))
    render_types.stf(v, 12, (0.5 - render_types.ldf(v, 9) * iw * 0.5) * ((*r).sh as f64))
}

fn load_vertices(r: *mut render_types.Renderer, nd: *mut scene.Node, m: *mut mesh.Mesh, vp: mat4.M4) {
    let nv: usize = mesh.mesh_vertex_count(m)
    render_types.blk_ensure(&(*r).vbuf, nv * render_types.VSTRIDE * 8)
    let w: mat4.M4 = (*nd).world
    let mvp: mat4.M4 = mat4.m4_mul(vp, w)
    let cf: mat4.M4 = mat4.m4_cofactor3(w)
    let base: u64 = (*r).vbuf.p
    let pp: u64 = vec.vec_ptr[f64](&(*m).pos)
    let np: u64 = vec.vec_ptr[f64](&(*m).nrm)
    let up: u64 = vec.vec_ptr[f64](&(*m).uv)
    let has_n: bool = vec.vec_len[f64](&(*m).nrm) >= nv * 3
    let has_uv: bool = vec.vec_len[f64](&(*m).uv) >= nv * 2
    var i: usize = 0
    while i < nv {
        let x: f64 = render_types.ldf(pp, i * 3)
        let y: f64 = render_types.ldf(pp, i * 3 + 1)
        let z: f64 = render_types.ldf(pp, i * 3 + 2)
        let v: u64 = base +% ((i * render_types.VSTRIDE * 8) as u64)
        render_types.stf(v, 0, w.m[0] * x + w.m[1] * y + w.m[2] * z + w.m[3])
        render_types.stf(v, 1, w.m[4] * x + w.m[5] * y + w.m[6] * z + w.m[7])
        render_types.stf(v, 2, w.m[8] * x + w.m[9] * y + w.m[10] * z + w.m[11])
        var nx: f64 = 0.0
        var ny: f64 = 1.0
        var nz: f64 = 0.0
        if has_n {
            let ox: f64 = render_types.ldf(np, i * 3)
            let oy: f64 = render_types.ldf(np, i * 3 + 1)
            let oz: f64 = render_types.ldf(np, i * 3 + 2)
            nx = cf.m[0] * ox + cf.m[1] * oy + cf.m[2] * oz
            ny = cf.m[4] * ox + cf.m[5] * oy + cf.m[6] * oz
            nz = cf.m[8] * ox + cf.m[9] * oy + cf.m[10] * oz
            let l2: f64 = nx * nx + ny * ny + nz * nz
            if l2 > 0.000000000001 {
                let k: f64 = 1.0 / math.sqrt(l2)
                nx = nx * k
                ny = ny * k
                nz = nz * k
            } else {
                nx = 0.0
                ny = 1.0
                nz = 0.0
            }
        }
        render_types.stf(v, 3, nx)
        render_types.stf(v, 4, ny)
        render_types.stf(v, 5, nz)
        if has_uv {
            render_types.stf(v, 6, render_types.ldf(up, i * 2))
            render_types.stf(v, 7, render_types.ldf(up, i * 2 + 1))
        } else {
            render_types.stf(v, 6, 0.0)
            render_types.stf(v, 7, 0.0)
        }
        render_types.stf(v, 8, mvp.m[0] * x + mvp.m[1] * y + mvp.m[2] * z + mvp.m[3])
        render_types.stf(v, 9, mvp.m[4] * x + mvp.m[5] * y + mvp.m[6] * z + mvp.m[7])
        render_types.stf(v, 10, mvp.m[12] * x + mvp.m[13] * y + mvp.m[14] * z + mvp.m[15])
        if render_types.ldf(v, 10) >= (*r).near {
            vtx_screen(r, v)
        } else {
            render_types.stf(v, 11, 0.0)
            render_types.stf(v, 12, 0.0)
            render_types.stf(v, 13, 0.0)
        }
        i = i + 1
    }
}

fn clip_at(r: *mut render_types.Renderer, p: u64, q: u64, slot: usize) -> u64 {
    let out: u64 = (*r).tmpv.p +% ((slot * render_types.VSTRIDE * 8) as u64)
    let wp: f64 = render_types.ldf(p, 10)
    let wq: f64 = render_types.ldf(q, 10)
    let t: f64 = (wp - (*r).near) / (wp - wq)
    var i: usize = 0
    while i < 10 {
        let a: f64 = render_types.ldf(p, i)
        render_types.stf(out, i, a + (render_types.ldf(q, i) - a) * t)
        i = i + 1
    }
    render_types.stf(out, 10, (*r).near)
    vtx_screen(r, out)
    return out
}

fn pick(i: i32, a: u64, b: u64, c: u64) -> u64 {
    let k: i32 = i % 3
    if k == 0 { return a }
    if k == 1 { return b }
    return c
}

fn emit_tri(r: *mut render_types.Renderer, a: u64, b: u64, c: u64, mp: u64, tp: u64, alpha: f64) {
    let mt: *mut material.Material = mp as *mut material.Material
    let x0: f64 = render_types.ldf(a, 11)
    let y0: f64 = render_types.ldf(a, 12)
    let x1: f64 = render_types.ldf(b, 11)
    let y1: f64 = render_types.ldf(b, 12)
    let x2: f64 = render_types.ldf(c, 11)
    let y2: f64 = render_types.ldf(c, 12)
    let area2: f64 = (x1 - x0) * (y2 - y0) - (x2 - x0) * (y1 - y0)
    if area2 > 0.0 - 0.000000001 && area2 < 0.000000001 { return }
    let back: bool = area2 > 0.0
    if back && (*mt).double_sided == false { return }
    let sw: f64 = (*r).sw as f64
    let sh: f64 = (*r).sh as f64
    let xmin: f64 = vec3.minf(x0, vec3.minf(x1, x2))
    let xmax: f64 = vec3.maxf(x0, vec3.maxf(x1, x2))
    let ymin: f64 = vec3.minf(y0, vec3.minf(y1, y2))
    let ymax: f64 = vec3.maxf(y0, vec3.maxf(y1, y2))
    if xmax <= 0.0 || xmin >= sw || ymax <= 0.0 || ymin >= sh { return }
    let row_lo: i32 = row_of(ymin, (*r).sh)
    let row_hi: i32 = row_of(ymax, (*r).sh)
    if row_lo >= row_hi { return }
    let iw0: f64 = render_types.ldf(a, 13)
    let iw1: f64 = render_types.ldf(b, 13)
    let iw2: f64 = render_types.ldf(c, 13)
    let ia: f64 = 1.0 / area2
    let dw1: f64 = iw1 - iw0
    let dw2: f64 = iw2 - iw0
    let pa: f64 = (dw1 * (y2 - y0) - dw2 * (y1 - y0)) * ia
    let pb: f64 = (dw2 * (x1 - x0) - dw1 * (x2 - x0)) * ia
    let l1a: f64 = (y2 - y0) * ia
    let l1b: f64 = 0.0 - (x2 - x0) * ia
    let l2a: f64 = 0.0 - (y1 - y0) * ia
    let l2b: f64 = (x1 - x0) * ia
    let e0: Edge = edge_of(x0, y0, x1, y1)
    let e1: Edge = edge_of(x1, y1, x2, y2)
    let e2: Edge = edge_of(x2, y2, x0, y0)
    vec.vec_push[render_types.Tri](&(*r).tris, render_types.tri_blank())
    let idx: usize = vec.vec_len[render_types.Tri](&(*r).tris) - 1
    let t: *mut render_types.Tri = vec.vec_elem_ptr[render_types.Tri](&(*r).tris, idx)
    (*t).x0 = x0
    (*t).y0 = y0
    (*t).x1 = x1
    (*t).y1 = y1
    (*t).x2 = x2
    (*t).y2 = y2
    (*t).iw0 = iw0
    (*t).iw1 = iw1
    (*t).iw2 = iw2
    (*t).pa = pa
    (*t).pb = pb
    (*t).pc = iw0 - pa * x0 - pb * y0
    (*t).l1a = l1a
    (*t).l1b = l1b
    (*t).l1c = 0.0 - (l1a * x0 + l1b * y0)
    (*t).l2a = l2a
    (*t).l2b = l2b
    (*t).l2c = 0.0 - (l2a * x0 + l2b * y0)
    (*t).e0x = e0.x
    (*t).e0y = e0.y
    (*t).e0q = e0.q
    (*t).e0s = e0.s
    (*t).e1x = e1.x
    (*t).e1y = e1.y
    (*t).e1q = e1.q
    (*t).e1s = e1.s
    (*t).e2x = e2.x
    (*t).e2y = e2.y
    (*t).e2q = e2.q
    (*t).e2s = e2.s
    (*t).p0 = vec3.V3 { x: render_types.ldf(a, 0), y: render_types.ldf(a, 1), z: render_types.ldf(a, 2) }
    (*t).p1 = vec3.V3 { x: render_types.ldf(b, 0), y: render_types.ldf(b, 1), z: render_types.ldf(b, 2) }
    (*t).p2 = vec3.V3 { x: render_types.ldf(c, 0), y: render_types.ldf(c, 1), z: render_types.ldf(c, 2) }
    (*t).n0 = vec3.V3 { x: render_types.ldf(a, 3), y: render_types.ldf(a, 4), z: render_types.ldf(a, 5) }
    (*t).n1 = vec3.V3 { x: render_types.ldf(b, 3), y: render_types.ldf(b, 4), z: render_types.ldf(b, 5) }
    (*t).n2 = vec3.V3 { x: render_types.ldf(c, 3), y: render_types.ldf(c, 4), z: render_types.ldf(c, 5) }
    (*t).u0 = render_types.ldf(a, 6)
    (*t).v0 = render_types.ldf(a, 7)
    (*t).u1 = render_types.ldf(b, 6)
    (*t).v1 = render_types.ldf(b, 7)
    (*t).u2 = render_types.ldf(c, 6)
    (*t).v2 = render_types.ldf(c, 7)
    (*t).alpha = alpha
    (*t).key = (render_types.ldf(a, 10) + render_types.ldf(b, 10) + render_types.ldf(c, 10)) / 3.0
    (*t).mat = mp
    (*t).tex = tp
    (*t).row_lo = row_lo
    (*t).row_hi = row_hi
    (*t).back = back
    (*t).opaque = alpha >= 0.999
}

fn process_tri(r: *mut render_types.Renderer, va: u64, vb: u64, vc: u64, mp: u64, tp: u64, alpha: f64) {
    let near: f64 = (*r).near
    let ina: bool = render_types.ldf(va, 10) >= near
    let inb: bool = render_types.ldf(vb, 10) >= near
    let inc: bool = render_types.ldf(vc, 10) >= near
    if ina && inb && inc {
        emit_tri(r, va, vb, vc, mp, tp, alpha)
        return
    }
    if ina == false && inb == false && inc == false { return }
    var count: i32 = 0
    if ina { count = count + 1 }
    if inb { count = count + 1 }
    if inc { count = count + 1 }
    if count == 1 {
        var s: i32 = 0
        if inb { s = 1 }
        if inc { s = 2 }
        let v0: u64 = pick(s, va, vb, vc)
        let v1: u64 = pick(s + 1, va, vb, vc)
        let v2: u64 = pick(s + 2, va, vb, vc)
        let i01: u64 = clip_at(r, v0, v1, 0)
        let i02: u64 = clip_at(r, v0, v2, 1)
        emit_tri(r, v0, i01, i02, mp, tp, alpha)
        return
    }
    var o: i32 = 0
    if inb == false { o = 1 }
    if inc == false { o = 2 }
    let w2: u64 = pick(o, va, vb, vc)
    let w0: u64 = pick(o + 1, va, vb, vc)
    let w1: u64 = pick(o + 2, va, vb, vc)
    let i12: u64 = clip_at(r, w1, w2, 0)
    let i02: u64 = clip_at(r, w0, w2, 1)
    emit_tri(r, w0, w1, i12, mp, tp, alpha)
    emit_tri(r, w0, i12, i02, mp, tp, alpha)
}

fn item_less(a: *render_types.SortItem, b: *render_types.SortItem) -> bool {
    if (*a).key > (*b).key { return true }
    if (*a).key < (*b).key { return false }
    return (*a).id < (*b).id
}

fn bin_count(r: *mut render_types.Renderer, starts: u64, t: *mut render_types.Tri) {
    let bh: i32 = (*r).band_h
    var b: i32 = (*t).row_lo / bh
    let b1: i32 = ((*t).row_hi - 1) / bh
    while b <= b1 {
        rt.st32(starts, (b + 1) as usize, rt.ld32(starts, (b + 1) as usize) + 1 as u32)
        b = b + 1
    }
}

fn bin_fill(r: *mut render_types.Renderer, starts: u64, cursor: u64, items: u64, t: *mut render_types.Tri, id: u32) {
    let bh: i32 = (*r).band_h
    var b: i32 = (*t).row_lo / bh
    let b1: i32 = ((*t).row_hi - 1) / bh
    while b <= b1 {
        let at: u32 = rt.ld32(cursor, b as usize)
        rt.st32(items, at as usize, id)
        rt.st32(cursor, b as usize, at + 1 as u32)
        b = b + 1
    }
}

fn build_bins(r: *mut render_types.Renderer) {
    let nb: usize = (*r).nbands as usize
    let nt: usize = vec.vec_len[render_types.Tri](&(*r).tris)
    render_types.blk_ensure(&(*r).bs_op, (nb + 1) * 4)
    render_types.blk_ensure(&(*r).bs_tr, (nb + 1) * 4)
    render_types.blk_ensure(&(*r).cnt, nb * 8 + 16)
    let so: u64 = (*r).bs_op.p
    let st: u64 = (*r).bs_tr.p
    var i: usize = 0
    while i <= nb {
        rt.st32(so, i, 0 as u32)
        rt.st32(st, i, 0 as u32)
        i = i + 1
    }
    vec.vec_clear[render_types.SortItem](&(*r).order)
    var n_op: i32 = 0
    var n_tr: i32 = 0
    i = 0
    while i < nt {
        let t: *mut render_types.Tri = vec.vec_elem_ptr[render_types.Tri](&(*r).tris, i)
        if (*t).opaque {
            bin_count(r, so, t)
            n_op = n_op + 1
        } else {
            bin_count(r, st, t)
            vec.vec_push[render_types.SortItem](&(*r).order, render_types.SortItem { key: (*t).key, id: i as u32 })
            n_tr = n_tr + 1
        }
        i = i + 1
    }
    (*r).n_opaque = n_op
    (*r).n_transp = n_tr
    i = 0
    while i < nb {
        rt.st32(so, i + 1, rt.ld32(so, i + 1) + rt.ld32(so, i))
        rt.st32(st, i + 1, rt.ld32(st, i + 1) + rt.ld32(st, i))
        i = i + 1
    }
    render_types.blk_ensure(&(*r).bi_op, (rt.ld32(so, nb) as usize) * 4 + 16)
    render_types.blk_ensure(&(*r).bi_tr, (rt.ld32(st, nb) as usize) * 4 + 16)
    let cur: u64 = (*r).cnt.p
    i = 0
    while i < nb {
        rt.st32(cur, i, rt.ld32(so, i))
        rt.st32(cur, nb + i, rt.ld32(st, i))
        i = i + 1
    }
    i = 0
    while i < nt {
        let t: *mut render_types.Tri = vec.vec_elem_ptr[render_types.Tri](&(*r).tris, i)
        if (*t).opaque {
            bin_fill(r, so, cur, (*r).bi_op.p, t, i as u32)
        }
        i = i + 1
    }
    vec.vec_sort_by[render_types.SortItem](&(*r).order, item_less)
    let curt: u64 = cur +% ((nb * 4) as u64)
    i = 0
    while i < (n_tr as usize) {
        let it: *mut render_types.SortItem = vec.vec_elem_ptr[render_types.SortItem](&(*r).order, i)
        let t: *mut render_types.Tri = vec.vec_elem_ptr[render_types.Tri](&(*r).tris, (*it).id as usize)
        bin_fill(r, st, curt, (*r).bi_tr.p, t, (*it).id)
        i = i + 1
    }
}

fn mark_no_receive(r: *mut render_types.Renderer, from: usize) {
    var i: usize = from
    let n: usize = vec.vec_len[render_types.Tri](&(*r).tris)
    while i < n {
        (*vec.vec_elem_ptr[render_types.Tri](&(*r).tris, i)).recv = false
        i = i + 1
    }
}

fn setup_frame(r: *mut render_types.Renderer, sc: *mut scene.Scene, cam: *mut camera.Camera) {
    let vp: mat4.M4 = camera.cam_view_proj(*cam)
    (*r).near = vec3.maxf((*cam).near, 0.00001)
    (*r).far = (*cam).far
    (*r).cam_x = (*cam).pos.x
    (*r).cam_y = (*cam).pos.y
    (*r).cam_z = (*cam).pos.z
    vec.vec_clear[render_types.Tri](&(*r).tris)
    render_types.blk_ensure(&(*r).tmpv, render_types.VSTRIDE * 8 * 2)
    let nn: i32 = scene.scene_node_count(sc)
    let n_mats: usize = vec.vec_len[material.Material](&(*sc).mats)
    let n_tex: usize = vec.vec_len[surface.Surface](&(*sc).texs)
    let n_mesh: usize = vec.vec_len[mesh.Mesh](&(*sc).meshes)
    var ni: i32 = 0
    while ni < nn {
        let nd: *mut scene.Node = scene.scene_node(sc, ni)
        ni = ni + 1
        if (*nd).eff_visible == false { continue }
        if (*nd).mesh_id < 0 || ((*nd).mesh_id as usize) >= n_mesh { continue }
        if (*nd).eff_opacity <= 0.0 { continue }
        var mp: u64 = (&(*r).def_mat) as u64
        if (*nd).mat_id >= 0 && ((*nd).mat_id as usize) < n_mats {
            mp = scene.scene_material(sc, (*nd).mat_id) as u64
        }
        let mt: *mut material.Material = mp as *mut material.Material
        let alpha: f64 = (*mt).opacity * (*nd).eff_opacity
        if alpha <= 0.0 { continue }
        var tp: u64 = 0 as u64
        if (*mt).tex >= 0 && ((*mt).tex as usize) < n_tex {
            let ts: *mut surface.Surface = scene.scene_texture(sc, (*mt).tex)
            if (*ts).px != 0 as u64 { tp = ts as u64 }
        }
        let m: *mut mesh.Mesh = scene.scene_mesh(sc, (*nd).mesh_id)
        let nt: usize = mesh.mesh_tri_count(m)
        if nt == 0 { continue }
        let tri_from: usize = vec.vec_len[render_types.Tri](&(*r).tris)
        load_vertices(r, nd, m, vp)
        let ip: u64 = vec.vec_ptr[u32](&(*m).idx)
        let nv: usize = mesh.mesh_vertex_count(m)
        let base: u64 = (*r).vbuf.p
        var k: usize = 0
        while k < nt {
            let ia: usize = rt.ld32(ip, k * 3) as usize
            let ib: usize = rt.ld32(ip, k * 3 + 1) as usize
            let ic: usize = rt.ld32(ip, k * 3 + 2) as usize
            k = k + 1
            if ia >= nv || ib >= nv || ic >= nv { continue }
            let va: u64 = base +% ((ia * render_types.VSTRIDE * 8) as u64)
            let vb: u64 = base +% ((ib * render_types.VSTRIDE * 8) as u64)
            let vc: u64 = base +% ((ic * render_types.VSTRIDE * 8) as u64)
            process_tri(r, va, vb, vc, mp, tp, alpha)
        }
        if (*nd).receive_shadow == false { mark_no_receive(r, tri_from) }
    }
    build_bins(r)
}
