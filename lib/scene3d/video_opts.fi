// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.str
import std.num
import std.args
import std.cpus
import std.io

export {
    VideoOpts, video_opts_default, video_parse_args, video_frame_count, video_frame_range,
}

struct VideoOpts {
    out: str,
    fps: i32,
    duration: f64,
    width: i32,
    height: i32,
    threads: i32,
    ss: i32,
    crf: i32,
    still: f64,
    has_still: bool,
    from: i64,
    to: i64,
}

fn video_opts_default() -> VideoOpts {
    return VideoOpts {
        out: "out.mp4", fps: 25, duration: 1.0, width: 1280, height: 720,
        threads: cpus.cpu_count(), ss: 2, crf: 21, still: 0.0, has_still: false,
        from: 0, to: -1,
    }
}

fn parse_float(s: str, fallback: f64) -> f64 {
    let r: num.ParsedF64 = num.parse_f64(str.span(s.p, s.n))
    return num.f64_or(r, fallback)
}

fn video_frame_count(o: *mut VideoOpts) -> i64 {
    var n: i64 = ((*o).duration * ((*o).fps as f64) + 0.5) as i64
    if n < 1 { n = 1 }
    return n
}

fn video_frame_range(o: *mut VideoOpts, lo: *mut i64, hi: *mut i64) {
    let total: i64 = video_frame_count(o)
    var a: i64 = (*o).from
    var b: i64 = (*o).to
    if a < 0 { a = 0 }
    if b < 0 || b > total { b = total }
    if a > b { a = b }
    *lo = a
    *hi = b
}

fn video_parse_args(o: *mut VideoOpts, prog: str, desc: str, start: u64) -> i32 {
    var p: args.Cmd = args.cmd(prog, desc)
    args.opt(&p, "--out", args.STR, (*o).out, "output file (.mp4)")
    args.opt(&p, "--fps", args.INT, "25", "frames per second")
    args.opt(&p, "--duration", args.STR, "", "seconds of video")
    args.opt(&p, "--width", args.INT, "1280", "frame width")
    args.opt(&p, "--height", args.INT, "720", "frame height")
    args.opt(&p, "--threads", args.INT, "0", "render threads (0 = all cores)")
    args.opt(&p, "--ss", args.INT, "2", "supersampling per axis")
    args.opt(&p, "--crf", args.INT, "21", "x264 quality")
    args.opt(&p, "--still", args.STR, "", "render one PNG at this time instead of a video")
    args.opt(&p, "--from", args.INT, "0", "first frame")
    args.opt(&p, "--to", args.INT, "-1", "end frame (exclusive)")
    var r: args.Result = args.parse_argv(&p, start)
    if r.status == args.HELP {
        io.print_line(r.text)
        return 0
    }
    if r.status != args.OK {
        io.eprint_line(r.text)
        return 2
    }
    (*o).out = args.get(&r, "out")
    (*o).fps = args.get_int(&r, "fps") as i32
    (*o).width = args.get_int(&r, "width") as i32
    (*o).height = args.get_int(&r, "height") as i32
    let th: i32 = args.get_int(&r, "threads") as i32
    if th > 0 { (*o).threads = th }
    (*o).ss = args.get_int(&r, "ss") as i32
    (*o).crf = args.get_int(&r, "crf") as i32
    (*o).from = args.get_int(&r, "from")
    (*o).to = args.get_int(&r, "to")
    let ds: str = args.get(&r, "duration")
    if ds.length() > 0 { (*o).duration = parse_float(ds, (*o).duration) }
    let st: str = args.get(&r, "still")
    if st.length() > 0 {
        (*o).still = parse_float(st, 0.0)
        (*o).has_still = true
    }
    if (*o).fps < 1 || (*o).width < 2 || (*o).height < 2 || (*o).ss < 1 {
        io.eprint_line("invalid fps, size or ss")
        return 2
    }
    return -1
}
