// SPDX-License-Identifier: MPL-2.0
import std.vec
import std.math
import scene3d.vec3

export {
    Curve, curve_new, curve_free, curve_add, curve_build, curve_point_count, curve_control,
    curve_point, curve_tangent, curve_length, curve_point_at_len, curve_tangent_at_len, curve_helix,
}

const SUB: usize = 48

struct Curve {
    pts: vec.Vec[f64],
    tbl: vec.Vec[f64],
    total: f64,
}

struct Coef { a: vec3.V3, b: vec3.V3, c: vec3.V3, d: vec3.V3, t: f64 }

fn curve_new() -> Curve {
    return Curve { pts: vec.vec_new[f64](), tbl: vec.vec_new[f64](), total: 0.0 }
}

fn curve_free(c: *mut Curve) {
    vec.vec_free[f64](&(*c).pts)
    vec.vec_free[f64](&(*c).tbl)
    (*c).total = 0.0
}

fn curve_add(c: *mut Curve, p: vec3.V3) {
    vec.vec_push[f64](&(*c).pts, p.x)
    vec.vec_push[f64](&(*c).pts, p.y)
    vec.vec_push[f64](&(*c).pts, p.z)
}

fn curve_point_count(c: *mut Curve) -> usize {
    return vec.vec_len[f64](&(*c).pts) / 3
}

fn curve_control(c: *mut Curve, i: usize) -> vec3.V3 {
    let x: f64 = *vec.vec_elem_ptr[f64](&(*c).pts, i * 3)
    let y: f64 = *vec.vec_elem_ptr[f64](&(*c).pts, i * 3 + 1)
    let z: f64 = *vec.vec_elem_ptr[f64](&(*c).pts, i * 3 + 2)
    return vec3.v3(x, y, z)
}

fn ctrl_ext(c: *mut Curve, i: i64) -> vec3.V3 {
    let n: i64 = curve_point_count(c) as i64
    if i < 0 {
        return vec3.v3_sub(vec3.v3_scale(curve_control(c, 0), 2.0), curve_control(c, 1))
    }
    if i >= n {
        return vec3.v3_sub(vec3.v3_scale(curve_control(c, (n - 1) as usize), 2.0), curve_control(c, (n - 2) as usize))
    }
    return curve_control(c, i as usize)
}

fn coef_at(c: *mut Curve, t: f64) -> Coef {
    let n: i64 = curve_point_count(c) as i64
    var tt: f64 = t
    if tt < 0.0 { tt = 0.0 }
    let maxt: f64 = (n - 1) as f64
    if tt > maxt { tt = maxt }
    var i: i64 = tt as i64
    if i > n - 2 { i = n - 2 }
    let p0: vec3.V3 = ctrl_ext(c, i - 1)
    let p1: vec3.V3 = ctrl_ext(c, i)
    let p2: vec3.V3 = ctrl_ext(c, i + 1)
    let p3: vec3.V3 = ctrl_ext(c, i + 2)
    var r: Coef = Coef {
        a: vec3.v3_scale(p1, 2.0),
        b: vec3.v3_sub(p2, p0),
        c: vec3.v3_zero(),
        d: vec3.v3_zero(),
        t: tt - (i as f64),
    }
    r.c = vec3.v3_sub(vec3.v3_add(vec3.v3_scale(p0, 2.0), vec3.v3_scale(p2, 4.0)), vec3.v3_add(vec3.v3_scale(p1, 5.0), p3))
    r.d = vec3.v3_add(vec3.v3_sub(vec3.v3_scale(p1, 3.0), p0), vec3.v3_sub(p3, vec3.v3_scale(p2, 3.0)))
    return r
}

fn eval_t(c: *mut Curve, t: f64) -> vec3.V3 {
    let n: usize = curve_point_count(c)
    if n == 0 { return vec3.v3_zero() }
    if n == 1 { return curve_control(c, 0) }
    let k: Coef = coef_at(c, t)
    var s: vec3.V3 = vec3.v3_add(k.a, vec3.v3_scale(k.b, k.t))
    s = vec3.v3_add(s, vec3.v3_scale(k.c, k.t * k.t))
    s = vec3.v3_add(s, vec3.v3_scale(k.d, k.t * k.t * k.t))
    return vec3.v3_scale(s, 0.5)
}

fn deriv_t(c: *mut Curve, t: f64) -> vec3.V3 {
    let n: usize = curve_point_count(c)
    if n < 2 { return vec3.v3(0.0, 1.0, 0.0) }
    let k: Coef = coef_at(c, t)
    var s: vec3.V3 = k.b
    s = vec3.v3_add(s, vec3.v3_scale(k.c, 2.0 * k.t))
    s = vec3.v3_add(s, vec3.v3_scale(k.d, 3.0 * k.t * k.t))
    s = vec3.v3_scale(s, 0.5)
    if vec3.v3_len2(s) < 0.000000000001 {
        var i: usize = t as usize
        if i > n - 2 { i = n - 2 }
        s = vec3.v3_sub(curve_control(c, i + 1), curve_control(c, i))
    }
    return vec3.v3_norm(s)
}

fn curve_build(c: *mut Curve) {
    vec.vec_clear[f64](&(*c).tbl)
    (*c).total = 0.0
    let n: usize = curve_point_count(c)
    vec.vec_push[f64](&(*c).tbl, 0.0)
    if n < 2 { return }
    let steps: usize = (n - 1) * SUB
    var prev: vec3.V3 = eval_t(c, 0.0)
    var acc: f64 = 0.0
    var k: usize = 1
    while k <= steps {
        let cur: vec3.V3 = eval_t(c, (k as f64) / (SUB as f64))
        acc = acc + vec3.v3_dist(cur, prev)
        vec.vec_push[f64](&(*c).tbl, acc)
        prev = cur
        k = k + 1
    }
    (*c).total = acc
}

fn curve_length(c: *mut Curve) -> f64 {
    return (*c).total
}

fn curve_param(c: *mut Curve, u: f64) -> f64 {
    let n: usize = curve_point_count(c)
    if n < 2 { return 0.0 }
    return vec3.clamp01(u) * ((n - 1) as f64)
}

fn curve_point(c: *mut Curve, u: f64) -> vec3.V3 {
    return eval_t(c, curve_param(c, u))
}

fn curve_tangent(c: *mut Curve, u: f64) -> vec3.V3 {
    return deriv_t(c, curve_param(c, u))
}

fn param_at_len(c: *mut Curve, s: f64) -> f64 {
    let n: usize = curve_point_count(c)
    if n < 2 || (*c).total <= 0.0 { return 0.0 }
    var q: f64 = s
    if q < 0.0 { q = 0.0 }
    if q > (*c).total { q = (*c).total }
    var lo: usize = 0
    var hi: usize = vec.vec_len[f64](&(*c).tbl) - 1
    while hi - lo > 1 {
        let mid: usize = (lo + hi) / 2
        if *vec.vec_elem_ptr[f64](&(*c).tbl, mid) <= q {
            lo = mid
        } else {
            hi = mid
        }
    }
    let a: f64 = *vec.vec_elem_ptr[f64](&(*c).tbl, lo)
    let b: f64 = *vec.vec_elem_ptr[f64](&(*c).tbl, hi)
    var f: f64 = 0.0
    if b - a > 0.000000000001 { f = (q - a) / (b - a) }
    return ((lo as f64) + f) / (SUB as f64)
}

fn curve_point_at_len(c: *mut Curve, s: f64) -> vec3.V3 {
    return eval_t(c, param_at_len(c, s))
}

fn curve_tangent_at_len(c: *mut Curve, s: f64) -> vec3.V3 {
    return deriv_t(c, param_at_len(c, s))
}

fn curve_helix(center: vec3.V3, radius: f64, pitch: f64, turns: f64, segs_per_turn: i32) -> Curve {
    var c: Curve = curve_new()
    var spt: i32 = segs_per_turn
    if spt < 3 { spt = 3 }
    var total: i32 = (turns * (spt as f64) + 0.5) as i32
    if total < 1 { total = 1 }
    let height: f64 = pitch * turns
    var i: i32 = 0
    while i <= total {
        let f: f64 = (i as f64) / (total as f64)
        let a: f64 = f * turns * vec3.TAU
        curve_add(&c, vec3.v3(
            center.x + radius * math.cos(a),
            center.y + (f - 0.5) * height,
            center.z - radius * math.sin(a),
        ))
        i = i + 1
    }
    curve_build(&c)
    return c
}
