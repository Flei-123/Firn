import scene3d.vec3

export {
    Material, MAT_STANDARD, MAT_UNLIT,
    mat_blank, mat_standard, mat_glass, mat_emissive, mat_unlit, mat_textured, mat_with_opacity,
}

const MAT_STANDARD: i32 = 0
const MAT_UNLIT: i32 = 1

struct Material {
    kind: i32,
    color: vec3.V3,
    metal: f64,
    rough: f64,
    emissive: vec3.V3,
    opacity: f64,
    tex: i32,
    double_sided: bool,
    rim: f64,
    spec: f64,
}

fn mat_blank() -> Material {
    return Material {
        kind: MAT_STANDARD,
        color: vec3.v3(0.8, 0.8, 0.8),
        metal: 0.0,
        rough: 0.6,
        emissive: vec3.v3_zero(),
        opacity: 1.0,
        tex: 0 - 1,
        double_sided: false,
        rim: 0.0,
        spec: 0.5,
    }
}

fn mat_standard(color: vec3.V3, metal: f64, rough: f64) -> Material {
    var m: Material = mat_blank()
    m.color = color
    m.metal = vec3.clamp01(metal)
    m.rough = vec3.clamp01(rough)
    return m
}

fn mat_glass(color: vec3.V3, opacity: f64) -> Material {
    var m: Material = mat_blank()
    m.color = color
    m.rough = 0.08
    m.spec = 1.0
    m.opacity = vec3.clamp01(opacity)
    m.double_sided = true
    m.rim = 0.55
    return m
}

fn mat_emissive(color: vec3.V3, intensity: f64) -> Material {
    var m: Material = mat_blank()
    m.color = vec3.v3_scale(color, 0.25)
    m.rough = 0.8
    m.spec = 0.1
    m.emissive = vec3.v3_scale(color, intensity)
    return m
}

fn mat_unlit(color: vec3.V3) -> Material {
    var m: Material = mat_blank()
    m.kind = MAT_UNLIT
    m.color = color
    return m
}

fn mat_textured(tex: i32) -> Material {
    var m: Material = mat_blank()
    m.kind = MAT_UNLIT
    m.color = vec3.v3_one()
    m.tex = tex
    return m
}

fn mat_with_opacity(m: Material, opacity: f64) -> Material {
    var r: Material = m
    r.opacity = vec3.clamp01(opacity)
    return r
}
