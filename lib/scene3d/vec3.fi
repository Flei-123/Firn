// SPDX-License-Identifier: MPL-2.0
import std.math

export {
    V3, PI, TAU, DEG,
    v3, v3_zero, v3_one, v3_add, v3_sub, v3_scale, v3_mul, v3_neg, v3_dot, v3_cross,
    v3_len, v3_len2, v3_norm, v3_lerp, v3_dist, v3_madd, v3_min, v3_max, v3_clamp01, v3_same,
    clampf, clamp01, lerpf, minf, maxf, absf, smoothstep, smootherstep, sqrtf64,
    rgb8, rgb_hex, srgb_to_linear, linear_to_srgb,
}

const PI: f64 = 3.141592653589793
const TAU: f64 = 6.283185307179586
const DEG: f64 = 0.017453292519943295

struct V3 { x: f64, y: f64, z: f64 }

fn v3(x: f64, y: f64, z: f64) -> V3 {
    return V3 { x: x, y: y, z: z }
}

fn v3_zero() -> V3 {
    return V3 { x: 0.0, y: 0.0, z: 0.0 }
}

fn v3_one() -> V3 {
    return V3 { x: 1.0, y: 1.0, z: 1.0 }
}

fn v3_add(a: V3, b: V3) -> V3 {
    return V3 { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z }
}

fn v3_sub(a: V3, b: V3) -> V3 {
    return V3 { x: a.x - b.x, y: a.y - b.y, z: a.z - b.z }
}

fn v3_scale(a: V3, s: f64) -> V3 {
    return V3 { x: a.x * s, y: a.y * s, z: a.z * s }
}

fn v3_mul(a: V3, b: V3) -> V3 {
    return V3 { x: a.x * b.x, y: a.y * b.y, z: a.z * b.z }
}

fn v3_neg(a: V3) -> V3 {
    return V3 { x: 0.0 - a.x, y: 0.0 - a.y, z: 0.0 - a.z }
}

fn v3_madd(a: V3, b: V3, s: f64) -> V3 {
    return V3 { x: a.x + b.x * s, y: a.y + b.y * s, z: a.z + b.z * s }
}

fn v3_dot(a: V3, b: V3) -> f64 {
    return a.x * b.x + a.y * b.y + a.z * b.z
}

fn v3_cross(a: V3, b: V3) -> V3 {
    return V3 { x: a.y * b.z - a.z * b.y, y: a.z * b.x - a.x * b.z, z: a.x * b.y - a.y * b.x }
}

fn v3_len2(a: V3) -> f64 {
    return a.x * a.x + a.y * a.y + a.z * a.z
}

fn sqrtf64(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    return math.sqrt(x)
}

fn v3_len(a: V3) -> f64 {
    return sqrtf64(a.x * a.x + a.y * a.y + a.z * a.z)
}

fn v3_norm(a: V3) -> V3 {
    let l: f64 = v3_len(a)
    if l < 0.000000000001 { return V3 { x: 0.0, y: 1.0, z: 0.0 } }
    let k: f64 = 1.0 / l
    return V3 { x: a.x * k, y: a.y * k, z: a.z * k }
}

fn v3_dist(a: V3, b: V3) -> f64 {
    return v3_len(v3_sub(a, b))
}

fn v3_lerp(a: V3, b: V3, t: f64) -> V3 {
    return V3 { x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t, z: a.z + (b.z - a.z) * t }
}

fn minf(a: f64, b: f64) -> f64 {
    if a < b { return a }
    return b
}

fn maxf(a: f64, b: f64) -> f64 {
    if a > b { return a }
    return b
}

fn absf(a: f64) -> f64 {
    if a < 0.0 { return 0.0 - a }
    return a
}

fn clampf(x: f64, lo: f64, hi: f64) -> f64 {
    if x < lo { return lo }
    if x > hi { return hi }
    return x
}

fn clamp01(x: f64) -> f64 {
    if x < 0.0 { return 0.0 }
    if x > 1.0 { return 1.0 }
    return x
}

fn lerpf(a: f64, b: f64, t: f64) -> f64 {
    return a + (b - a) * t
}

fn smoothstep(t: f64) -> f64 {
    let c: f64 = clamp01(t)
    return c * c * (3.0 - 2.0 * c)
}

fn smootherstep(t: f64) -> f64 {
    let c: f64 = clamp01(t)
    return c * c * c * (c * (c * 6.0 - 15.0) + 10.0)
}

fn v3_min(a: V3, b: V3) -> V3 {
    return V3 { x: minf(a.x, b.x), y: minf(a.y, b.y), z: minf(a.z, b.z) }
}

fn v3_max(a: V3, b: V3) -> V3 {
    return V3 { x: maxf(a.x, b.x), y: maxf(a.y, b.y), z: maxf(a.z, b.z) }
}

fn v3_clamp01(a: V3) -> V3 {
    return V3 { x: clamp01(a.x), y: clamp01(a.y), z: clamp01(a.z) }
}

fn v3_same(a: V3, b: V3, eps: f64) -> bool {
    return absf(a.x - b.x) <= eps && absf(a.y - b.y) <= eps && absf(a.z - b.z) <= eps
}

fn srgb_to_linear(c: f64) -> f64 {
    if c <= 0.04045 { return c / 12.92 }
    return math.powf((c + 0.055) / 1.055, 2.4)
}

fn linear_to_srgb(c: f64) -> f64 {
    if c <= 0.0031308 { return c * 12.92 }
    return 1.055 * math.powf(c, 1.0 / 2.4) - 0.055
}

fn rgb8(r: i32, g: i32, b: i32) -> V3 {
    return V3 {
        x: srgb_to_linear((r as f64) / 255.0),
        y: srgb_to_linear((g as f64) / 255.0),
        z: srgb_to_linear((b as f64) / 255.0),
    }
}

fn rgb_hex(hex: u32) -> V3 {
    let r: i32 = ((hex >> 16 as u32) & 255 as u32) as i32
    let g: i32 = ((hex >> 8 as u32) & 255 as u32) as i32
    let b: i32 = (hex & 255 as u32) as i32
    return rgb8(r, g, b)
}
