// SPDX-License-Identifier: MPL-2.0
import std.math
import std.vec
import scene3d.vec3
import scene3d.surface
import scene3d.ov_px

export {
    ov_fill_rect, ov_round_rect, ov_line, ov_disc, ov_ring, ov_polyline, ov_plot, seg_dist,
}

fn fl(v: f64) -> i32 {
    return math.floor(v) as i32
}

fn ce(v: f64) -> i32 {
    return math.ceil(v) as i32
}

fn maxi(a: i32, b: i32) -> i32 {
    if a > b { return a }
    return b
}

fn mini(a: i32, b: i32) -> i32 {
    if a < b { return a }
    return b
}

fn seg_dist(px: f64, py: f64, x0: f64, y0: f64, x1: f64, y1: f64) -> f64 {
    let dx: f64 = x1 - x0
    let dy: f64 = y1 - y0
    let l2: f64 = dx * dx + dy * dy
    var t: f64 = 0.0
    if l2 > 0.0 {
        t = vec3.clamp01(((px - x0) * dx + (py - y0) * dy) / l2)
    }
    let ex: f64 = px - (x0 + t * dx)
    let ey: f64 = py - (y0 + t * dy)
    return vec3.sqrtf64(ex * ex + ey * ey)
}

fn ov_fill_rect(dst: *mut surface.Surface, x: f64, y: f64, w: f64, h: f64, color: u32) {
    if w <= 0.0 || h <= 0.0 || ov_px.color_alpha(color) == 0 {
        return
    }
    let x1: f64 = x + w
    let y1: f64 = y + h
    let ia: i32 = maxi(fl(x), 0)
    let ib: i32 = mini(ce(x1), (*dst).w)
    let ja: i32 = maxi(fl(y), 0)
    let jb: i32 = mini(ce(y1), (*dst).h)
    var j: i32 = ja
    while j < jb {
        let cy: f64 = vec3.minf((j + 1) as f64, y1) - vec3.maxf(j as f64, y)
        var i: i32 = ia
        while i < ib {
            let cx: f64 = vec3.minf((i + 1) as f64, x1) - vec3.maxf(i as f64, x)
            ov_px.px_blend(dst, i, j, color, vec3.clamp01(cx) * vec3.clamp01(cy))
            i = i + 1
        }
        j = j + 1
    }
}

fn round_rect_dist(px: f64, py: f64, cx: f64, cy: f64, hw: f64, hh: f64, r: f64) -> f64 {
    let qx: f64 = vec3.absf(px - cx) - (hw - r)
    let qy: f64 = vec3.absf(py - cy) - (hh - r)
    let ox: f64 = vec3.maxf(qx, 0.0)
    let oy: f64 = vec3.maxf(qy, 0.0)
    return vec3.sqrtf64(ox * ox + oy * oy) + vec3.minf(vec3.maxf(qx, qy), 0.0) - r
}

fn ov_round_rect(dst: *mut surface.Surface, x: f64, y: f64, w: f64, h: f64, radius: f64,
    fill: u32, border: u32, border_w: f64) {
    if w <= 0.0 || h <= 0.0 {
        return
    }
    let hw: f64 = w * 0.5
    let hh: f64 = h * 0.5
    let r: f64 = vec3.clampf(radius, 0.0, vec3.minf(hw, hh))
    let cx: f64 = x + hw
    let cy: f64 = y + hh
    let has_fill: bool = ov_px.color_alpha(fill) != 0
    let has_border: bool = ov_px.color_alpha(border) != 0 && border_w > 0.0
    let ia: i32 = maxi(fl(x) - 1, 0)
    let ib: i32 = mini(ce(x + w) + 1, (*dst).w)
    let ja: i32 = maxi(fl(y) - 1, 0)
    let jb: i32 = mini(ce(y + h) + 1, (*dst).h)
    var j: i32 = ja
    while j < jb {
        var i: i32 = ia
        while i < ib {
            let d: f64 = round_rect_dist((i as f64) + 0.5, (j as f64) + 0.5, cx, cy, hw, hh, r)
            if d < 0.5 {
                if has_fill {
                    ov_px.px_blend(dst, i, j, fill, vec3.clamp01(0.5 - d))
                }
                if has_border {
                    let ring: f64 = vec3.absf(d + border_w * 0.5) - border_w * 0.5
                    ov_px.px_blend(dst, i, j, border, vec3.clamp01(0.5 - ring))
                }
            }
            i = i + 1
        }
        j = j + 1
    }
}

fn ov_disc(dst: *mut surface.Surface, cx: f64, cy: f64, r: f64, color: u32) {
    if r <= 0.0 || ov_px.color_alpha(color) == 0 {
        return
    }
    let ia: i32 = maxi(fl(cx - r - 1.0), 0)
    let ib: i32 = mini(ce(cx + r + 1.0), (*dst).w)
    let ja: i32 = maxi(fl(cy - r - 1.0), 0)
    let jb: i32 = mini(ce(cy + r + 1.0), (*dst).h)
    var j: i32 = ja
    while j < jb {
        var i: i32 = ia
        while i < ib {
            let dx: f64 = (i as f64) + 0.5 - cx
            let dy: f64 = (j as f64) + 0.5 - cy
            let d: f64 = vec3.sqrtf64(dx * dx + dy * dy)
            ov_px.px_blend(dst, i, j, color, vec3.clamp01(r + 0.5 - d))
            i = i + 1
        }
        j = j + 1
    }
}

fn ov_ring(dst: *mut surface.Surface, cx: f64, cy: f64, r: f64, width: f64, color: u32) {
    if r <= 0.0 || width <= 0.0 || ov_px.color_alpha(color) == 0 {
        return
    }
    let ext: f64 = r + width * 0.5 + 1.0
    let ia: i32 = maxi(fl(cx - ext), 0)
    let ib: i32 = mini(ce(cx + ext), (*dst).w)
    let ja: i32 = maxi(fl(cy - ext), 0)
    let jb: i32 = mini(ce(cy + ext), (*dst).h)
    var j: i32 = ja
    while j < jb {
        var i: i32 = ia
        while i < ib {
            let dx: f64 = (i as f64) + 0.5 - cx
            let dy: f64 = (j as f64) + 0.5 - cy
            let d: f64 = vec3.sqrtf64(dx * dx + dy * dy)
            ov_px.px_blend(dst, i, j, color, vec3.clamp01(width * 0.5 + 0.5 - vec3.absf(d - r)))
            i = i + 1
        }
        j = j + 1
    }
}

fn ov_line(dst: *mut surface.Surface, x0: f64, y0: f64, x1: f64, y1: f64, width: f64, color: u32) {
    if ov_px.color_alpha(color) == 0 {
        return
    }
    let hw: f64 = vec3.maxf(width, 0.5) * 0.5
    let steep: bool = vec3.absf(y1 - y0) > vec3.absf(x1 - x0)
    var a0: f64 = x0
    var b0: f64 = y0
    var a1: f64 = x1
    var b1: f64 = y1
    var amax: i32 = (*dst).w
    var bmax: i32 = (*dst).h
    if steep {
        a0 = y0
        b0 = x0
        a1 = y1
        b1 = x1
        amax = (*dst).h
        bmax = (*dst).w
    }
    let span: f64 = (hw + 1.5) * 1.5
    let ia: i32 = maxi(fl(vec3.minf(a0, a1) - hw - 1.0), 0)
    let ib: i32 = mini(ce(vec3.maxf(a0, a1) + hw + 1.0), amax)
    var a: i32 = ia
    while a < ib {
        let ac: f64 = (a as f64) + 0.5
        var t: f64 = 0.0
        if a1 != a0 {
            t = vec3.clamp01((ac - a0) / (a1 - a0))
        }
        let bc: f64 = b0 + t * (b1 - b0)
        let jb0: i32 = maxi(fl(bc - span), 0)
        let jb1: i32 = mini(ce(bc + span), bmax)
        var b: i32 = jb0
        while b < jb1 {
            let d: f64 = seg_dist(ac, (b as f64) + 0.5, a0, b0, a1, b1)
            let cov: f64 = vec3.clamp01(hw + 0.5 - d)
            if cov > 0.0 {
                if steep {
                    ov_px.px_blend(dst, b, a, color, cov)
                } else {
                    ov_px.px_blend(dst, a, b, color, cov)
                }
            }
            b = b + 1
        }
        a = a + 1
    }
}

fn ov_polyline(dst: *mut surface.Surface, pts: *mut vec.Vec[f64], width: f64, color: u32) {
    let n: usize = vec.vec_len[f64](pts) / 2
    if n == 0 {
        return
    }
    if n == 1 {
        ov_disc(dst, *vec.vec_elem_ptr[f64](pts, 0), *vec.vec_elem_ptr[f64](pts, 1), width * 0.5, color)
        return
    }
    var i: usize = 0
    while i + 1 < n {
        ov_line(dst, *vec.vec_elem_ptr[f64](pts, i * 2), *vec.vec_elem_ptr[f64](pts, i * 2 + 1),
            *vec.vec_elem_ptr[f64](pts, i * 2 + 2), *vec.vec_elem_ptr[f64](pts, i * 2 + 3), width, color)
        i = i + 1
    }
}

fn ov_plot(dst: *mut surface.Surface, x: f64, y: f64, w: f64, h: f64, ys: *mut vec.Vec[f64],
    ymin: f64, ymax: f64, width: f64, color: u32) {
    let n: usize = vec.vec_len[f64](ys)
    if n == 0 || ymax <= ymin {
        return
    }
    var pts: vec.Vec[f64] = vec.vec_new[f64]()
    var i: usize = 0
    while i < n {
        var u: f64 = 0.0
        if n > 1 {
            u = (i as f64) / ((n - 1) as f64)
        }
        let v: f64 = vec3.clamp01((*vec.vec_elem_ptr[f64](ys, i) - ymin) / (ymax - ymin))
        vec.vec_push[f64](&pts, x + w * u)
        vec.vec_push[f64](&pts, y + h * (1.0 - v))
        i = i + 1
    }
    ov_polyline(dst, &pts, width, color)
    vec.vec_free[f64](&pts)
}
