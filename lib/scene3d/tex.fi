// SPDX-License-Identifier: MPL-2.0
import std.rt
import scene3d.vec3
import scene3d.surface
import scene3d.render_types

export {
    sample,
}

fn wrap(i: i32, n: i32, repeat: bool) -> i32 {
    if repeat {
        var m: i32 = i % n
        if m < 0 { m = m + n }
        return m
    }
    if i < 0 { return 0 }
    if i >= n { return n - 1 }
    return i
}

fn texel(r: *mut render_types.Renderer, ts: *mut surface.Surface, x: i32, y: i32, ch: i32) -> f64 {
    let p: u32 = rt.ld32((*ts).px, (y as usize) * ((*ts).w as usize) + (x as usize))
    var v: u32 = p & 255 as u32
    if ch == 1 { v = (p >> 8 as u32) & 255 as u32 }
    if ch == 2 { v = (p >> 16 as u32) & 255 as u32 }
    return render_types.ldf((*r).lut_tex, v as usize)
}

fn floor_i(v: f64) -> i32 {
    let i: i32 = v as i32
    if (i as f64) > v { return i - 1 }
    return i
}

fn sample(r: *mut render_types.Renderer, tp: u64, u: f64, v: f64, repeat: bool) -> vec3.V3 {
    let ts: *mut surface.Surface = tp as *mut surface.Surface
    let w: i32 = (*ts).w
    let h: i32 = (*ts).h
    var uu: f64 = u
    var vv: f64 = v
    if repeat == false {
        uu = vec3.clamp01(u)
        vv = vec3.clamp01(v)
    }
    var fx: f64 = uu * (w as f64) - 0.5
    var fy: f64 = (1.0 - vv) * (h as f64) - 0.5
    if repeat == false {
        fx = vec3.clampf(fx, 0.0, (w - 1) as f64)
        fy = vec3.clampf(fy, 0.0, (h - 1) as f64)
    }
    let ix: i32 = floor_i(fx)
    let iy: i32 = floor_i(fy)
    let tx: f64 = fx - (ix as f64)
    let ty: f64 = fy - (iy as f64)
    let x0: i32 = wrap(ix, w, repeat)
    let x1: i32 = wrap(ix + 1, w, repeat)
    let y0: i32 = wrap(iy, h, repeat)
    let y1: i32 = wrap(iy + 1, h, repeat)
    let w00: f64 = (1.0 - tx) * (1.0 - ty)
    let w10: f64 = tx * (1.0 - ty)
    let w01: f64 = (1.0 - tx) * ty
    let w11: f64 = tx * ty
    return vec3.V3 {
        x: texel(r, ts, x0, y0, 0) * w00 + texel(r, ts, x1, y0, 0) * w10 + texel(r, ts, x0, y1, 0) * w01 + texel(r, ts, x1, y1, 0) * w11,
        y: texel(r, ts, x0, y0, 1) * w00 + texel(r, ts, x1, y0, 1) * w10 + texel(r, ts, x0, y1, 1) * w01 + texel(r, ts, x1, y1, 1) * w11,
        z: texel(r, ts, x0, y0, 2) * w00 + texel(r, ts, x1, y0, 2) * w10 + texel(r, ts, x0, y1, 2) * w01 + texel(r, ts, x1, y1, 2) * w11,
    }
}
