import std.vec
import scene3d.vec3
import scene3d.camera
import scene3d.scene

export {
    CamKeys, CamKey, Timeline, Track, NodeState,
    TRACK_FLY_IN, TRACK_FADE, TRACK_SHOW, TRACK_HIDE,
    ease_linear, ease_in_out, ease_out_cubic, ease_in_cubic, ease_out_back, ease_apply,
    EASE_LINEAR, EASE_IN_OUT, EASE_OUT_CUBIC, EASE_IN_CUBIC, EASE_OUT_BACK,
    camkeys_new, camkeys_free, camkeys_add, camkeys_count, camkeys_at,
    timeline_new, timeline_free, timeline_fly_in, timeline_fade, timeline_show, timeline_hide,
    timeline_track_count, timeline_eval, timeline_end, timeline_apply,
}

const EASE_LINEAR: i32 = 0
const EASE_IN_OUT: i32 = 1
const EASE_OUT_CUBIC: i32 = 2
const EASE_IN_CUBIC: i32 = 3
const EASE_OUT_BACK: i32 = 4

const TRACK_FLY_IN: i32 = 1
const TRACK_FADE: i32 = 2
const TRACK_SHOW: i32 = 3
const TRACK_HIDE: i32 = 4

fn ease_linear(u: f64) -> f64 {
    return vec3.clamp01(u)
}

fn ease_in_out(u: f64) -> f64 {
    return vec3.smoothstep(u)
}

fn ease_out_cubic(u: f64) -> f64 {
    let v: f64 = 1.0 - vec3.clamp01(u)
    return 1.0 - v * v * v
}

fn ease_in_cubic(u: f64) -> f64 {
    let v: f64 = vec3.clamp01(u)
    return v * v * v
}

fn ease_out_back(u: f64) -> f64 {
    let v: f64 = vec3.clamp01(u) - 1.0
    let c: f64 = 1.70158
    return 1.0 + v * v * ((c + 1.0) * v + c)
}

fn ease_apply(kind: i32, u: f64) -> f64 {
    if kind == EASE_IN_OUT { return ease_in_out(u) }
    if kind == EASE_OUT_CUBIC { return ease_out_cubic(u) }
    if kind == EASE_IN_CUBIC { return ease_in_cubic(u) }
    if kind == EASE_OUT_BACK { return ease_out_back(u) }
    return ease_linear(u)
}

struct CamKey {
    t: f64,
    pos: vec3.V3,
    target: vec3.V3,
    fov: f64,
}

struct CamKeys {
    keys: Vec[CamKey],
}

fn camkeys_new() -> CamKeys {
    return CamKeys { keys: vec.vec_new[CamKey]() }
}

fn camkeys_free(k: *mut CamKeys) {
    vec.vec_free[CamKey](&(*k).keys)
}

fn camkeys_count(k: *mut CamKeys) -> usize {
    return vec.vec_len[CamKey](&(*k).keys)
}

fn camkeys_add(k: *mut CamKeys, t: f64, pos: vec3.V3, target: vec3.V3, fov: f64) {
    let n: usize = vec.vec_len[CamKey](&(*k).keys)
    var at: usize = n
    while at > 0 {
        let prev: *mut CamKey = vec.vec_elem_ptr[CamKey](&(*k).keys, at - 1)
        if (*prev).t <= t { break }
        at = at - 1
    }
    vec.vec_push[CamKey](&(*k).keys, CamKey { t: t, pos: pos, target: target, fov: fov })
    var i: usize = n
    while i > at {
        let a: *mut CamKey = vec.vec_elem_ptr[CamKey](&(*k).keys, i)
        let b: *mut CamKey = vec.vec_elem_ptr[CamKey](&(*k).keys, i - 1)
        let tmp: CamKey = *a
        *a = *b
        *b = tmp
        i = i - 1
    }
}

fn camkeys_at(k: *mut CamKeys, t: f64, c: *mut camera.Camera) {
    let n: usize = vec.vec_len[CamKey](&(*k).keys)
    if n == 0 { return }
    let first: *mut CamKey = vec.vec_elem_ptr[CamKey](&(*k).keys, 0)
    if n == 1 || t <= (*first).t {
        (*c).pos = (*first).pos
        (*c).target = (*first).target
        (*c).fov = (*first).fov
        return
    }
    let last: *mut CamKey = vec.vec_elem_ptr[CamKey](&(*k).keys, n - 1)
    if t >= (*last).t {
        (*c).pos = (*last).pos
        (*c).target = (*last).target
        (*c).fov = (*last).fov
        return
    }
    var i: usize = 1
    while i < n - 1 {
        let nx: *mut CamKey = vec.vec_elem_ptr[CamKey](&(*k).keys, i)
        if t < (*nx).t { break }
        i = i + 1
    }
    let a: *mut CamKey = vec.vec_elem_ptr[CamKey](&(*k).keys, i - 1)
    let b: *mut CamKey = vec.vec_elem_ptr[CamKey](&(*k).keys, i)
    let span: f64 = (*b).t - (*a).t
    var u: f64 = 1.0
    if span > 0.0 { u = vec3.smoothstep((t - (*a).t) / span) }
    (*c).pos = vec3.v3_lerp((*a).pos, (*b).pos, u)
    (*c).target = vec3.v3_lerp((*a).target, (*b).target, u)
    (*c).fov = vec3.lerpf((*a).fov, (*b).fov, u)
}

struct Track {
    kind: i32,
    node: i32,
    t0: f64,
    dur: f64,
    base: vec3.V3,
    offset: vec3.V3,
    from: f64,
    to: f64,
    fade: bool,
    ease: i32,
}

struct Timeline {
    tracks: Vec[Track],
}

struct NodeState {
    has_pos: bool,
    pos: vec3.V3,
    has_opacity: bool,
    opacity: f64,
    has_visible: bool,
    visible: bool,
}

fn timeline_new() -> Timeline {
    return Timeline { tracks: vec.vec_new[Track]() }
}

fn timeline_free(tl: *mut Timeline) {
    vec.vec_free[Track](&(*tl).tracks)
}

fn timeline_track_count(tl: *mut Timeline) -> usize {
    return vec.vec_len[Track](&(*tl).tracks)
}

fn track_blank(kind: i32, node: i32, t0: f64, dur: f64) -> Track {
    return Track {
        kind: kind, node: node, t0: t0, dur: dur,
        base: vec3.v3_zero(), offset: vec3.v3_zero(),
        from: 0.0, to: 1.0, fade: false, ease: EASE_OUT_CUBIC,
    }
}

fn timeline_fly_in(tl: *mut Timeline, node: i32, base: vec3.V3, t0: f64, dur: f64, offset: vec3.V3, fade: bool, ease: i32) {
    var tr: Track = track_blank(TRACK_FLY_IN, node, t0, dur)
    tr.base = base
    tr.offset = offset
    tr.fade = fade
    tr.ease = ease
    vec.vec_push[Track](&(*tl).tracks, tr)
}

fn timeline_fade(tl: *mut Timeline, node: i32, t0: f64, dur: f64, from: f64, to: f64, ease: i32) {
    var tr: Track = track_blank(TRACK_FADE, node, t0, dur)
    tr.from = from
    tr.to = to
    tr.ease = ease
    vec.vec_push[Track](&(*tl).tracks, tr)
}

fn timeline_show(tl: *mut Timeline, node: i32, t0: f64) {
    vec.vec_push[Track](&(*tl).tracks, track_blank(TRACK_SHOW, node, t0, 0.0))
}

fn timeline_hide(tl: *mut Timeline, node: i32, t0: f64) {
    vec.vec_push[Track](&(*tl).tracks, track_blank(TRACK_HIDE, node, t0, 0.0))
}

fn timeline_end(tl: *mut Timeline) -> f64 {
    var e: f64 = 0.0
    var i: usize = 0
    let n: usize = vec.vec_len[Track](&(*tl).tracks)
    while i < n {
        let tr: *mut Track = vec.vec_elem_ptr[Track](&(*tl).tracks, i)
        let te: f64 = (*tr).t0 + (*tr).dur
        if te > e { e = te }
        i = i + 1
    }
    return e
}

fn track_progress(tr: *mut Track, t: f64) -> f64 {
    if (*tr).dur <= 0.0 {
        if t >= (*tr).t0 { return 1.0 }
        return 0.0
    }
    return ease_apply((*tr).ease, (t - (*tr).t0) / (*tr).dur)
}

fn timeline_eval(tl: *mut Timeline, node: i32, t: f64, out: *mut NodeState) {
    (*out).has_pos = false
    (*out).has_opacity = false
    (*out).has_visible = false
    (*out).pos = vec3.v3_zero()
    (*out).opacity = 1.0
    (*out).visible = true
    var i: usize = 0
    let n: usize = vec.vec_len[Track](&(*tl).tracks)
    while i < n {
        let tr: *mut Track = vec.vec_elem_ptr[Track](&(*tl).tracks, i)
        i = i + 1
        if (*tr).node != node { continue }
        if (*tr).kind == TRACK_FLY_IN {
            let e: f64 = track_progress(tr, t)
            (*out).has_pos = true
            (*out).pos = vec3.v3_madd((*tr).base, (*tr).offset, 1.0 - e)
            (*out).has_visible = true
            (*out).visible = t >= (*tr).t0
            if (*tr).fade {
                (*out).has_opacity = true
                (*out).opacity = vec3.clamp01(e * 1.6)
            }
        } else if (*tr).kind == TRACK_FADE {
            let e: f64 = track_progress(tr, t)
            (*out).has_opacity = true
            (*out).opacity = vec3.lerpf((*tr).from, (*tr).to, e)
            if !(*out).has_visible {
                (*out).has_visible = true
                (*out).visible = (*out).opacity > 0.001
            }
        } else if (*tr).kind == TRACK_SHOW {
            (*out).has_visible = true
            (*out).visible = t >= (*tr).t0
        } else if (*tr).kind == TRACK_HIDE {
            if t >= (*tr).t0 {
                (*out).has_visible = true
                (*out).visible = false
            }
        }
    }
}

fn timeline_apply(tl: *mut Timeline, sc: *mut scene.Scene, t: f64) {
    var st: NodeState = NodeState {
        has_pos: false, pos: vec3.v3_zero(), has_opacity: false, opacity: 1.0, has_visible: false, visible: true,
    }
    let total: i32 = scene.scene_node_count(sc)
    var i: usize = 0
    let n: usize = vec.vec_len[Track](&(*tl).tracks)
    while i < n {
        let tr: *mut Track = vec.vec_elem_ptr[Track](&(*tl).tracks, i)
        i = i + 1
        let id: i32 = (*tr).node
        if id < 0 || id >= total { continue }
        timeline_eval(tl, id, t, &st)
        let nd: *mut scene.Node = scene.scene_node(sc, id)
        if st.has_pos { scene.node_set_pos(nd, st.pos) }
        if st.has_opacity { scene.node_set_opacity(nd, st.opacity) }
        if st.has_visible { scene.node_set_visible(nd, st.visible) }
    }
}
