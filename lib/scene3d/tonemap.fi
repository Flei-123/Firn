// SPDX-License-Identifier: MPL-2.0
export {
    TONEMAP_NONE, TONEMAP_REINHARD, TONEMAP_ACES, TONEMAP_FILMIC,
    tm_apply, tm_curve, tm_curve_aces,
}

const TONEMAP_NONE: i32 = 0
const TONEMAP_REINHARD: i32 = 1
const TONEMAP_ACES: i32 = 2
const TONEMAP_FILMIC: i32 = 3
const HABLE_WHITE: f64 = 0.7251293784387428

fn tm_curve_aces(x: f64) -> f64 {
    let n: f64 = x * (2.51 * x + 0.03)
    let d: f64 = x * (2.43 * x + 0.59) + 0.14
    var v: f64 = n / d
    if v < 0.0 { v = 0.0 }
    if v > 1.0 { v = 1.0 }
    return v
}

fn hable(x: f64) -> f64 {
    return ((x * (0.15 * x + 0.05) + 0.004) / (x * (0.15 * x + 0.5) + 0.06)) - 0.0666666666666667
}

fn tm_curve(mode: i32, x: f64) -> f64 {
    if mode == TONEMAP_REINHARD { return x / (1.0 + x) }
    if mode == TONEMAP_ACES { return tm_curve_aces(x) }
    if mode == TONEMAP_FILMIC {
        let v: f64 = hable(x * 2.0) / HABLE_WHITE
        if v > 1.0 { return 1.0 }
        return v
    }
    return x
}

fn tm_apply(mode: i32, exposure: f64, x: f64) -> f64 {
    if mode == TONEMAP_NONE { return x * exposure }
    var v: f64 = x * exposure
    if v < 0.0 { v = 0.0 }
    return tm_curve(mode, v)
}
