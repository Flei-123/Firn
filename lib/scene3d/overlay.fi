// SPDX-License-Identifier: MPL-2.0
import std.rt
import font.ttf
import font.fallback
import scene3d.surface
import scene3d.ov_px

export {
    Overlay, PLACED_MAX, FONT_REGULAR, FONT_BOLD,
    overlay_new, overlay_new2, overlay_default, overlay_free, overlay_frame_begin,
    ov_text, ov_text_ex, ov_text_raw, ov_text_width, ov_text_width_ex, ov_text_width_raw, ov_line_height,
}

const PLACED_MAX: usize = 32
const FONT_REGULAR: str = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"
const FONT_BOLD: str = "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"

struct Overlay {
    reg: fallback.Chain,
    bold: fallback.Chain,
    ctx: fallback.PaintCtx,
    f_reg: *mut ttf.Font,
    f_bold: *mut ttf.Font,
    d_reg: rt.Buf,
    d_bold: rt.Buf,
    shared_bold: bool,
    placed: [f64; 128],
    placed_n: usize,
}

fn zalloc[T]() -> u64 {
    let p: u64 = rt.heap_alloc(size_of[T]())
    gc_track[T](p, size_of[T]())
    return p
}

fn zfree[T](p: u64) {
    gc_untrack[T](p)
    rt.heap_free(p, size_of[T]())
}

fn load_font(path: str, data: *mut rt.Buf) -> *mut ttf.Font {
    var cp: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&cp, path.p as u64, path.n)
    rt.buf_push(&cp, 0 as u8)
    let ok: bool = rt.read_file(cp.ptr, data)
    rt.buf_free(&cp)
    if !ok {
        return 0 as *mut ttf.Font
    }
    let f: *mut ttf.Font = zalloc[ttf.Font]() as *mut ttf.Font
    *f = ttf.font_new()
    if !ttf.font_init(f, (*data).ptr as *mut u8, (*data).len) {
        zfree[ttf.Font](f as u64)
        return 0 as *mut ttf.Font
    }
    return f
}

fn overlay_new2(regular_path: str, bold_path: str) -> *mut Overlay {
    let o: *mut Overlay = zalloc[Overlay]() as *mut Overlay
    (*o).d_reg = rt.buf_new()
    (*o).d_bold = rt.buf_new()
    (*o).f_reg = load_font(regular_path, &(*o).d_reg)
    if (*o).f_reg as u64 == 0 {
        rt.buf_free(&(*o).d_reg)
        rt.buf_free(&(*o).d_bold)
        zfree[Overlay](o as u64)
        return 0 as *mut Overlay
    }
    (*o).f_bold = load_font(bold_path, &(*o).d_bold)
    (*o).shared_bold = false
    if (*o).f_bold as u64 == 0 {
        (*o).f_bold = (*o).f_reg
        (*o).shared_bold = true
    }
    (*o).reg = fallback.chain_new()
    (*o).bold = fallback.chain_new()
    fallback.chain_add(&(*o).reg, (*o).f_reg, fallback.K_LATIN)
    fallback.chain_add(&(*o).bold, (*o).f_bold, fallback.K_LATIN)
    (*o).ctx = fallback.ctx_new()
    fallback.ctx_set_straight(&(*o).ctx, true)
    (*o).placed_n = 0
    return o
}

fn overlay_new(path: str) -> *mut Overlay {
    return overlay_new2(path, path)
}

fn overlay_default() -> *mut Overlay {
    return overlay_new2(FONT_REGULAR, FONT_BOLD)
}

fn overlay_free(o: *mut Overlay) {
    if o as u64 == 0 {
        return
    }
    fallback.chain_free(&(*o).reg)
    fallback.chain_free(&(*o).bold)
    fallback.ctx_free(&(*o).ctx)
    if !(*o).shared_bold {
        zfree[ttf.Font]((*o).f_bold as u64)
    }
    zfree[ttf.Font]((*o).f_reg as u64)
    rt.buf_free(&(*o).d_reg)
    rt.buf_free(&(*o).d_bold)
    zfree[Overlay](o as u64)
}

fn overlay_frame_begin(o: *mut Overlay) {
    (*o).placed_n = 0
}

fn ov_line_height(size_px: f64) -> f64 {
    return size_px * 1.25
}

fn ov_text_raw(o: *mut Overlay, dst: *mut surface.Surface, x: f64, baseline_y: f64, size_px: f64,
    color: u32, p: u64, n: usize, shadow: bool, bold: bool) -> f64 {
    var shadow_col: u32 = 0 as u32
    if shadow {
        shadow_col = ov_px.color_with_alpha(ov_px.rgba(0, 0, 0, 255), (ov_px.color_alpha(color) * 150) / 255)
    }
    if bold {
        return fallback.chain_paint(&(*o).ctx, &(*o).bold, p, n, size_px, x, baseline_y, color, shadow_col,
            (*dst).px, (*dst).w, (*dst).h)
    }
    return fallback.chain_paint(&(*o).ctx, &(*o).reg, p, n, size_px, x, baseline_y, color, shadow_col,
        (*dst).px, (*dst).w, (*dst).h)
}

fn ov_text_ex(o: *mut Overlay, dst: *mut surface.Surface, x: f64, baseline_y: f64, size_px: f64,
    color: u32, text: str, shadow: bool, bold: bool) -> f64 {
    return ov_text_raw(o, dst, x, baseline_y, size_px, color, text.p as u64, text.n, shadow, bold)
}

fn ov_text(o: *mut Overlay, dst: *mut surface.Surface, x: f64, baseline_y: f64, size_px: f64,
    color: u32, text: str, shadow: bool) -> f64 {
    return ov_text_raw(o, dst, x, baseline_y, size_px, color, text.p as u64, text.n, shadow, false)
}

fn ov_text_width_raw(o: *mut Overlay, size_px: f64, p: u64, n: usize, bold: bool) -> f64 {
    if bold {
        return fallback.chain_width(&(*o).bold, p, n, size_px)
    }
    return fallback.chain_width(&(*o).reg, p, n, size_px)
}

fn ov_text_width_ex(o: *mut Overlay, size_px: f64, text: str, bold: bool) -> f64 {
    return ov_text_width_raw(o, size_px, text.p as u64, text.n, bold)
}

fn ov_text_width(o: *mut Overlay, size_px: f64, text: str) -> f64 {
    return ov_text_width_raw(o, size_px, text.p as u64, text.n, false)
}
