import scene3d.vec3
import scene3d.fresnel
import scene3d.render_types

export {
    env_add_spec,
}

fn env_chan(sky: f64, ground: f64, e: f64, k: f64, glow: f64) -> f64 {
    let mean: f64 = (sky + ground) * 0.5
    let sk: f64 = ground + (sky - ground) * e
    let base: f64 = sk + (mean - sk) * k
    return base + sky * glow
}

fn spec_chan(env: f64, color: f64, f0d: f64, metal: f64, rough: f64, p5: f64, occ: f64) -> f64 {
    let f0: f64 = f0d + (color - f0d) * metal
    var top: f64 = 1.0 - rough
    if top < f0 { top = f0 }
    return env * (f0 + (top - f0) * p5) * occ
}

fn env_add_spec(r: *mut render_types.Renderer, color: vec3.V3, metal: f64, spec: f64, rough: f64, ny: f64, vy: f64, ndv: f64, out: *mut render_types.Shade) {
    let ry: f64 = 2.0 * ndv * ny - vy
    let w: f64 = 0.03 + rough * rough * 0.9
    let e: f64 = vec3.smoothstep(vec3.clamp01((ry + w) / (2.0 * w)))
    let k: f64 = rough * rough
    let hor: f64 = 1.0 - vec3.clamp01(vec3.absf(ry) * 4.0)
    let glow: f64 = hor * 0.35 * (1.0 - k)
    let f0d: f64 = 0.08 * spec
    let occ: f64 = 1.0 - 0.35 * rough * (1.0 - metal)
    let p5: f64 = fresnel.pow5(1.0 - vec3.clamp01(ndv))
    let er: f64 = env_chan((*r).hemi_sky.x, (*r).hemi_ground.x, e, k, glow)
    let eg: f64 = env_chan((*r).hemi_sky.y, (*r).hemi_ground.y, e, k, glow)
    let eb: f64 = env_chan((*r).hemi_sky.z, (*r).hemi_ground.z, e, k, glow)
    (*out).sr = (*out).sr + spec_chan(er, color.x, f0d, metal, rough, p5, occ)
    (*out).sg = (*out).sg + spec_chan(eg, color.y, f0d, metal, rough, p5, occ)
    (*out).sb = (*out).sb + spec_chan(eb, color.z, f0d, metal, rough, p5, occ)
}
