import scene3d.vec3
import scene3d.fresnel
import scene3d.render_types

export {
    env_color, env_add_spec,
}

fn env_color(r: *mut render_types.Renderer, ry: f64, rough: f64) -> vec3.V3 {
    let w: f64 = 0.03 + rough * rough * 0.9
    let e: f64 = vec3.smoothstep(vec3.clamp01((ry + w) / (2.0 * w)))
    let mean: vec3.V3 = vec3.v3_scale(vec3.v3_add((*r).hemi_sky, (*r).hemi_ground), 0.5)
    let k: f64 = rough * rough
    let sk: vec3.V3 = vec3.v3_lerp((*r).hemi_ground, (*r).hemi_sky, e)
    let hor: f64 = 1.0 - vec3.clamp01(vec3.absf(ry) * 4.0)
    let glow: f64 = hor * 0.35 * (1.0 - k)
    let base: vec3.V3 = vec3.v3_lerp(sk, mean, k)
    return vec3.v3_madd(base, (*r).hemi_sky, glow)
}

fn env_add_spec(r: *mut render_types.Renderer, color: vec3.V3, metal: f64, spec: f64, rough: f64, ny: f64, vy: f64, ndv: f64, out: *mut render_types.Shade) {
    let ry: f64 = 2.0 * ndv * ny - vy
    let e: vec3.V3 = env_color(r, ry, rough)
    let f0d: f64 = 0.08 * spec
    let f0r: f64 = f0d + (color.x - f0d) * metal
    let f0g: f64 = f0d + (color.y - f0d) * metal
    let f0b: f64 = f0d + (color.z - f0d) * metal
    let occ: f64 = 1.0 - 0.35 * rough * (1.0 - metal)
    (*out).sr = (*out).sr + e.x * fresnel.schlick_rough(f0r, rough, ndv) * occ
    (*out).sg = (*out).sg + e.y * fresnel.schlick_rough(f0g, rough, ndv) * occ
    (*out).sb = (*out).sb + e.z * fresnel.schlick_rough(f0b, rough, ndv) * occ
}
