// SPDX-License-Identifier: MPL-2.0
import std.math
import scene3d.vec3

export {
    Q4, q_identity, q_axis_angle, q_euler, q_mul, q_norm, q_conj, q_rotate, q_slerp, q_dot,
}

struct Q4 { x: f64, y: f64, z: f64, w: f64 }

fn q_identity() -> Q4 {
    return Q4 { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }
}

fn q_axis_angle(axis: vec3.V3, angle: f64) -> Q4 {
    let a: vec3.V3 = vec3.v3_norm(axis)
    let h: f64 = angle * 0.5
    let s: f64 = math.sin(h)
    return Q4 { x: a.x * s, y: a.y * s, z: a.z * s, w: math.cos(h) }
}

fn q_mul(a: Q4, b: Q4) -> Q4 {
    return Q4 {
        x: a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y,
        y: a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x,
        z: a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w,
        w: a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z,
    }
}

fn q_euler(rx: f64, ry: f64, rz: f64) -> Q4 {
    let qx: Q4 = q_axis_angle(vec3.v3(1.0, 0.0, 0.0), rx)
    let qy: Q4 = q_axis_angle(vec3.v3(0.0, 1.0, 0.0), ry)
    let qz: Q4 = q_axis_angle(vec3.v3(0.0, 0.0, 1.0), rz)
    return q_mul(qy, q_mul(qx, qz))
}

fn q_dot(a: Q4, b: Q4) -> f64 {
    return a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w
}

fn q_norm(a: Q4) -> Q4 {
    let l: f64 = vec3.sqrtf64(q_dot(a, a))
    if l < 0.000000000001 { return q_identity() }
    let k: f64 = 1.0 / l
    return Q4 { x: a.x * k, y: a.y * k, z: a.z * k, w: a.w * k }
}

fn q_conj(a: Q4) -> Q4 {
    return Q4 { x: 0.0 - a.x, y: 0.0 - a.y, z: 0.0 - a.z, w: a.w }
}

fn q_rotate(q: Q4, v: vec3.V3) -> vec3.V3 {
    let u: vec3.V3 = vec3.v3(q.x, q.y, q.z)
    let t: vec3.V3 = vec3.v3_scale(vec3.v3_cross(u, v), 2.0)
    return vec3.v3_add(vec3.v3_add(v, vec3.v3_scale(t, q.w)), vec3.v3_cross(u, t))
}

fn q_slerp(a: Q4, b0: Q4, t: f64) -> Q4 {
    var b: Q4 = b0
    var d: f64 = q_dot(a, b)
    if d < 0.0 {
        b = Q4 { x: 0.0 - b.x, y: 0.0 - b.y, z: 0.0 - b.z, w: 0.0 - b.w }
        d = 0.0 - d
    }
    if d > 0.9995 {
        return q_norm(Q4 {
            x: a.x + (b.x - a.x) * t,
            y: a.y + (b.y - a.y) * t,
            z: a.z + (b.z - a.z) * t,
            w: a.w + (b.w - a.w) * t,
        })
    }
    let th: f64 = math.atan2(vec3.sqrtf64(1.0 - d * d), d)
    let s: f64 = math.sin(th)
    let wa: f64 = math.sin((1.0 - t) * th) / s
    let wb: f64 = math.sin(t * th) / s
    return Q4 { x: a.x * wa + b.x * wb, y: a.y * wa + b.y * wb, z: a.z * wa + b.z * wb, w: a.w * wa + b.w * wb }
}
