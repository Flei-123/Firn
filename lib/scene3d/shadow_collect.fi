import std.rt
import std.vec
import scene3d.vec3
import scene3d.mat4
import scene3d.mesh
import scene3d.material
import scene3d.scene
import scene3d.render_types
import scene3d.shadow_types

export {
    collect,
}

fn node_material(r: *mut render_types.Renderer, sc: *mut scene.Scene, nd: *mut scene.Node) -> *mut material.Material {
    let n_mats: usize = vec.vec_len[material.Material](&(*sc).mats)
    if (*nd).mat_id >= 0 && ((*nd).mat_id as usize) < n_mats {
        return scene.scene_material(sc, (*nd).mat_id)
    }
    return &(*r).def_mat
}

fn usable(sc: *mut scene.Scene, nd: *mut scene.Node) -> bool {
    if (*nd).eff_visible == false { return false }
    if (*nd).mesh_id < 0 || ((*nd).mesh_id as usize) >= vec.vec_len[mesh.Mesh](&(*sc).meshes) { return false }
    return (*nd).eff_opacity > 0.0
}

fn caster_factor(mt: *mut material.Material, nd: *mut scene.Node) -> f64 {
    if (*nd).cast_shadow == false || (*mt).cast_shadow == false { return 0.0 - 2.0 }
    let alpha: f64 = (*mt).opacity * (*nd).eff_opacity
    if alpha <= 0.0 { return 0.0 - 2.0 }
    if alpha >= 0.999 { return 0.0 - 1.0 }
    if (*mt).shadow_strength <= 0.0 { return 0.0 - 2.0 }
    return 1.0 - alpha * vec3.clamp01((*mt).shadow_strength)
}

fn grow_bounds(s: *mut shadow_types.ShadowSet, p: vec3.V3) {
    if (*s).have_bounds == false {
        (*s).bmin = p
        (*s).bmax = p
        (*s).have_bounds = true
        return
    }
    (*s).bmin = vec3.v3_min((*s).bmin, p)
    (*s).bmax = vec3.v3_max((*s).bmax, p)
}

fn put_vertex(w: u64, o: usize, p: vec3.V3) {
    render_types.stf(w, o, p.x)
    render_types.stf(w, o + 1, p.y)
    render_types.stf(w, o + 2, p.z)
}

fn emit_tris(s: *mut shadow_types.ShadowSet, m: *mut mesh.Mesh, world: mat4.M4, tr: f64) {
    let ip: u64 = vec.vec_ptr[u32](&(*m).idx)
    let nt: usize = mesh.mesh_tri_count(m)
    let nv: usize = mesh.mesh_vertex_count(m)
    var k: usize = 0
    while k < nt {
        let ia: usize = rt.ld32(ip, k * 3) as usize
        let ib: usize = rt.ld32(ip, k * 3 + 1) as usize
        let ic: usize = rt.ld32(ip, k * 3 + 2) as usize
        k = k + 1
        if ia >= nv || ib >= nv || ic >= nv { continue }
        let o: usize = ((*s).nworld as usize) * shadow_types.WSTRIDE
        put_vertex((*s).world.p, o, mat4.m4_point(world, mesh.mesh_pos(m, ia)))
        put_vertex((*s).world.p, o + 3, mat4.m4_point(world, mesh.mesh_pos(m, ib)))
        put_vertex((*s).world.p, o + 6, mat4.m4_point(world, mesh.mesh_pos(m, ic)))
        render_types.stf((*s).world.p, o + 9, tr)
        (*s).nworld = (*s).nworld + 1
    }
}

fn collect(r: *mut render_types.Renderer, sc: *mut scene.Scene, s: *mut shadow_types.ShadowSet) {
    (*s).nworld = 0
    (*s).has_trans = false
    (*s).have_bounds = false
    let nn: i32 = scene.scene_node_count(sc)
    var total: usize = 0
    var ni: i32 = 0
    while ni < nn {
        let nd: *mut scene.Node = scene.scene_node(sc, ni)
        ni = ni + 1
        if usable(sc, nd) == false { continue }
        total = total + mesh.mesh_tri_count(scene.scene_mesh(sc, (*nd).mesh_id))
    }
    render_types.blk_ensure(&(*s).world, total * shadow_types.WSTRIDE * 8)
    ni = 0
    while ni < nn {
        let nd: *mut scene.Node = scene.scene_node(sc, ni)
        ni = ni + 1
        if usable(sc, nd) == false { continue }
        let m: *mut mesh.Mesh = scene.scene_mesh(sc, (*nd).mesh_id)
        let mt: *mut material.Material = node_material(r, sc, nd)
        let nv: usize = mesh.mesh_vertex_count(m)
        var v: usize = 0
        while v < nv {
            grow_bounds(s, mat4.m4_point((*nd).world, mesh.mesh_pos(m, v)))
            v = v + 1
        }
        let tr: f64 = caster_factor(mt, nd)
        if tr < 0.0 - 1.5 { continue }
        if tr >= 0.0 { (*s).has_trans = true }
        emit_tris(s, m, (*nd).world, tr)
    }
}
