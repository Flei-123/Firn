// SPDX-License-Identifier: MPL-2.0
import std.rt
import scene3d.vec3
import scene3d.render_types

export {
    build_luts, free_luts, resolve_rows,
}

fn build_luts(r: *mut render_types.Renderer) {
    (*r).lut_srgb = rt.heap_alloc(render_types.LUT_SIZE as usize)
    (*r).lut_tex = rt.heap_alloc(256 * 8)
    var i: i32 = 0
    while i < render_types.LUT_SIZE {
        let s: f64 = vec3.linear_to_srgb((i as f64) / ((render_types.LUT_SIZE - 1) as f64)) * 255.0 + 0.5
        rt.st8((*r).lut_srgb, i as usize, vec3.clampf(s, 0.0, 255.0) as u8)
        i = i + 1
    }
    i = 0
    while i < 256 {
        render_types.stf((*r).lut_tex, i as usize, vec3.srgb_to_linear((i as f64) / 255.0))
        i = i + 1
    }
}

fn free_luts(r: *mut render_types.Renderer) {
    if (*r).lut_srgb != 0 as u64 { rt.heap_free((*r).lut_srgb, render_types.LUT_SIZE as usize) }
    if (*r).lut_tex != 0 as u64 { rt.heap_free((*r).lut_tex, 256 * 8) }
    (*r).lut_srgb = 0 as u64
    (*r).lut_tex = 0 as u64
}

fn lut_byte(r: *mut render_types.Renderer, v: f64) -> u32 {
    let c: f64 = vec3.clamp01(v) * ((render_types.LUT_SIZE - 1) as f64) + 0.5
    return rt.ld8((*r).lut_srgb, c as usize) as u32
}

fn resolve_rows(r: *mut render_types.Renderer, oy0: i32, oy1: i32) {
    let ss: i32 = (*r).ss
    let sw: i32 = (*r).sw
    let inv: f64 = 1.0 / ((ss * ss) as f64)
    var oy: i32 = oy0
    while oy < oy1 {
        var ox: i32 = 0
        while ox < (*r).w {
            var sr: f64 = 0.0
            var sg: f64 = 0.0
            var sb: f64 = 0.0
            var j: i32 = 0
            while j < ss {
                let rowb: usize = ((oy * ss + j) as usize) * (sw as usize) + (ox * ss) as usize
                var i: i32 = 0
                while i < ss {
                    let at: usize = (rowb + (i as usize)) * 3
                    sr = sr + (render_types.ldf32((*r).color, at) as f64)
                    sg = sg + (render_types.ldf32((*r).color, at + 1) as f64)
                    sb = sb + (render_types.ldf32((*r).color, at + 2) as f64)
                    i = i + 1
                }
                j = j + 1
            }
            let px: u32 = ((255 as u32) << 24 as u32) | (lut_byte(r, sb * inv) << 16 as u32) | (lut_byte(r, sg * inv) << 8 as u32) | lut_byte(r, sr * inv)
            rt.st32((*r).out_px, (oy as usize) * ((*r).w as usize) + (ox as usize), px)
            ox = ox + 1
        }
        oy = oy + 1
    }
}
