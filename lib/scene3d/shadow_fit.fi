import std.math
import std.rt
import scene3d.vec3
import scene3d.render_types
import scene3d.shadow_types

export {
    fit, prepare_buffers,
}

const BORDER_TEXELS: f64 = 4.0

fn corner(s: *mut shadow_types.ShadowSet, i: i32) -> vec3.V3 {
    var x: f64 = (*s).bmin.x
    var y: f64 = (*s).bmin.y
    var z: f64 = (*s).bmin.z
    if (i & 1) != 0 { x = (*s).bmax.x }
    if (i & 2) != 0 { y = (*s).bmax.y }
    if (i & 4) != 0 { z = (*s).bmax.z }
    return vec3.v3(x, y, z)
}

fn clamp_size(size: i32) -> i32 {
    var n: i32 = size
    if n < 16 { n = 16 }
    if n > 8192 { n = 8192 }
    return n
}

fn fit(s: *mut shadow_types.ShadowSet, m: *mut shadow_types.ShadowMap, to_light: vec3.V3, size: i32, bias: f64, soft: f64) {
    let l: vec3.V3 = vec3.v3_norm(to_light)
    var hint: vec3.V3 = vec3.v3(0.0, 1.0, 0.0)
    if vec3.absf(l.y) > 0.99 { hint = vec3.v3(1.0, 0.0, 0.0) }
    let right: vec3.V3 = vec3.v3_norm(vec3.v3_cross(hint, l))
    let up: vec3.V3 = vec3.v3_cross(l, right)
    var umin: f64 = 1.0e30
    var umax: f64 = 0.0 - 1.0e30
    var vmin: f64 = 1.0e30
    var vmax: f64 = 0.0 - 1.0e30
    var zmax: f64 = 0.0 - 1.0e30
    var i: i32 = 0
    while i < 8 {
        let c: vec3.V3 = corner(s, i)
        let u: f64 = vec3.v3_dot(right, c)
        let v: f64 = vec3.v3_dot(up, c)
        let z: f64 = vec3.v3_dot(l, c)
        umin = vec3.minf(umin, u)
        umax = vec3.maxf(umax, u)
        vmin = vec3.minf(vmin, v)
        vmax = vec3.maxf(vmax, v)
        zmax = vec3.maxf(zmax, z)
        i = i + 1
    }
    let n: i32 = clamp_size(size)
    var ext: f64 = vec3.maxf(umax - umin, vmax - vmin)
    if ext < 0.000001 { ext = 0.000001 }
    let texel: f64 = ext / ((n as f64) - BORDER_TEXELS)
    (*m).right = right
    (*m).up = up
    (*m).to_light = l
    (*m).size = n
    (*m).texel = texel
    (*m).umin = math.floor((umin + umax) * 0.5 / texel - (n as f64) * 0.5) * texel
    (*m).vmin = math.floor((vmin + vmax) * 0.5 / texel - (n as f64) * 0.5) * texel
    (*m).zmax = zmax + texel * 2.0
    (*m).bias = bias
    (*m).soft = soft
    (*m).world = (*s).world.p
    (*m).ntris = (*s).nworld
    (*m).has_trans = (*s).has_trans
}

fn prepare_buffers(m: *mut shadow_types.ShadowMap) {
    let cells: usize = ((*m).size as usize) * ((*m).size as usize)
    render_types.blk_ensure(&(*m).depth, cells * 4)
    if (*m).has_trans {
        render_types.blk_ensure(&(*m).tdepth, cells * 4)
        render_types.blk_ensure(&(*m).tfac, cells * 4)
    }
    render_types.blk_ensure(&(*m).proj, ((*m).ntris as usize) * shadow_types.PSTRIDE * 8)
}
