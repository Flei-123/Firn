import std.rt
import std.vec
import std.math
import scene3d.vec3
import scene3d.material
import scene3d.render_types
import scene3d.render_vertex

export {
    Sink, process_tri,
}

struct Sink {
    base: u64,
    at: usize,
    dry: bool,
    unit: i32,
    order: i32,
    tmp: u64,
    mp: u64,
    tp: u64,
    alpha: f64,
}

struct Edge {
    x: f64,
    y: f64,
    q: f64,
    s: f64,
}

fn edge_of(ax: f64, ay: f64, bx: f64, by: f64) -> Edge {
    if ay < by {
        return Edge { x: ax, y: ay, q: by, s: (bx - ax) / (by - ay) }
    }
    if by < ay {
        return Edge { x: bx, y: by, q: ay, s: (ax - bx) / (ay - by) }
    }
    return Edge { x: 0.0, y: 1.0e30, q: 0.0 - 1.0e30, s: 0.0 }
}

fn row_of(v: f64, hi: i32) -> i32 {
    var c: f64 = math.ceil(v - 0.5)
    if c < 0.0 { c = 0.0 }
    if c > (hi as f64) { c = hi as f64 }
    return c as i32
}

fn clip_at(r: *mut render_types.Renderer, sk: *mut Sink, p: u64, q: u64, slot: usize) -> u64 {
    let out: u64 = (*sk).tmp +% ((slot * render_types.VSTRIDE * 8) as u64)
    let wp: f64 = render_types.ldf(p, 10)
    let wq: f64 = render_types.ldf(q, 10)
    let t: f64 = (wp - (*r).near) / (wp - wq)
    var i: usize = 0
    while i < 10 {
        let a: f64 = render_types.ldf(p, i)
        render_types.stf(out, i, a + (render_types.ldf(q, i) - a) * t)
        i = i + 1
    }
    render_types.stf(out, 10, (*r).near)
    render_vertex.vtx_screen(r, out)
    return out
}

fn pick(i: i32, a: u64, b: u64, c: u64) -> u64 {
    let k: i32 = i % 3
    if k == 0 { return a }
    if k == 1 { return b }
    return c
}

fn emit_tri(r: *mut render_types.Renderer, sk: *mut Sink, a: u64, b: u64, c: u64) {
    let mt: *mut material.Material = (*sk).mp as *mut material.Material
    let x0: f64 = render_types.ldf(a, 11)
    let y0: f64 = render_types.ldf(a, 12)
    let x1: f64 = render_types.ldf(b, 11)
    let y1: f64 = render_types.ldf(b, 12)
    let x2: f64 = render_types.ldf(c, 11)
    let y2: f64 = render_types.ldf(c, 12)
    let area2: f64 = (x1 - x0) * (y2 - y0) - (x2 - x0) * (y1 - y0)
    if area2 > 0.0 - 0.000000001 && area2 < 0.000000001 { return }
    let back: bool = area2 > 0.0
    if back && (*mt).double_sided == false { return }
    let sw: f64 = (*r).sw as f64
    let sh: f64 = (*r).sh as f64
    let xmin: f64 = vec3.minf(x0, vec3.minf(x1, x2))
    let xmax: f64 = vec3.maxf(x0, vec3.maxf(x1, x2))
    let ymin: f64 = vec3.minf(y0, vec3.minf(y1, y2))
    let ymax: f64 = vec3.maxf(y0, vec3.maxf(y1, y2))
    if xmax <= 0.0 || xmin >= sw || ymax <= 0.0 || ymin >= sh { return }
    let row_lo: i32 = row_of(ymin, (*r).sh)
    let row_hi: i32 = row_of(ymax, (*r).sh)
    if row_lo >= row_hi { return }
    let iw0: f64 = render_types.ldf(a, 13)
    let iw1: f64 = render_types.ldf(b, 13)
    let iw2: f64 = render_types.ldf(c, 13)
    let ia: f64 = 1.0 / area2
    let dw1: f64 = iw1 - iw0
    let dw2: f64 = iw2 - iw0
    let pa: f64 = (dw1 * (y2 - y0) - dw2 * (y1 - y0)) * ia
    let pb: f64 = (dw2 * (x1 - x0) - dw1 * (x2 - x0)) * ia
    let l1a: f64 = (y2 - y0) * ia
    let l1b: f64 = 0.0 - (x2 - x0) * ia
    let l2a: f64 = 0.0 - (y1 - y0) * ia
    let l2b: f64 = (x1 - x0) * ia
    let e0: Edge = edge_of(x0, y0, x1, y1)
    let e1: Edge = edge_of(x1, y1, x2, y2)
    let e2: Edge = edge_of(x2, y2, x0, y0)
    if (*sk).dry {
        (*sk).at = (*sk).at + 1
        return
    }
    let t: *mut render_types.Tri = render_types.tri_ptr((*sk).base, (*sk).at)
    (*sk).at = (*sk).at + 1
    *t = render_types.tri_blank()
    (*t).x0 = x0
    (*t).y0 = y0
    (*t).x1 = x1
    (*t).y1 = y1
    (*t).x2 = x2
    (*t).y2 = y2
    (*t).iw0 = iw0
    (*t).iw1 = iw1
    (*t).iw2 = iw2
    (*t).pa = pa
    (*t).pb = pb
    (*t).pc = iw0 - pa * x0 - pb * y0
    (*t).l1a = l1a
    (*t).l1b = l1b
    (*t).l1c = 0.0 - (l1a * x0 + l1b * y0)
    (*t).l2a = l2a
    (*t).l2b = l2b
    (*t).l2c = 0.0 - (l2a * x0 + l2b * y0)
    (*t).e0x = e0.x
    (*t).e0y = e0.y
    (*t).e0q = e0.q
    (*t).e0s = e0.s
    (*t).e1x = e1.x
    (*t).e1y = e1.y
    (*t).e1q = e1.q
    (*t).e1s = e1.s
    (*t).e2x = e2.x
    (*t).e2y = e2.y
    (*t).e2q = e2.q
    (*t).e2s = e2.s
    (*t).p0 = vec3.V3 { x: render_types.ldf(a, 0), y: render_types.ldf(a, 1), z: render_types.ldf(a, 2) }
    (*t).p1 = vec3.V3 { x: render_types.ldf(b, 0), y: render_types.ldf(b, 1), z: render_types.ldf(b, 2) }
    (*t).p2 = vec3.V3 { x: render_types.ldf(c, 0), y: render_types.ldf(c, 1), z: render_types.ldf(c, 2) }
    (*t).n0 = vec3.V3 { x: render_types.ldf(a, 3), y: render_types.ldf(a, 4), z: render_types.ldf(a, 5) }
    (*t).n1 = vec3.V3 { x: render_types.ldf(b, 3), y: render_types.ldf(b, 4), z: render_types.ldf(b, 5) }
    (*t).n2 = vec3.V3 { x: render_types.ldf(c, 3), y: render_types.ldf(c, 4), z: render_types.ldf(c, 5) }
    (*t).u0 = render_types.ldf(a, 6)
    (*t).v0 = render_types.ldf(a, 7)
    (*t).u1 = render_types.ldf(b, 6)
    (*t).v1 = render_types.ldf(b, 7)
    (*t).u2 = render_types.ldf(c, 6)
    (*t).v2 = render_types.ldf(c, 7)
    (*t).alpha = (*sk).alpha
    (*t).key = (render_types.ldf(a, 10) + render_types.ldf(b, 10) + render_types.ldf(c, 10)) / 3.0
    (*t).mat = (*sk).mp
    (*t).tex = (*sk).tp
    (*t).row_lo = row_lo
    (*t).row_hi = row_hi
    (*t).back = back
    (*t).group = (*sk).unit
    (*t).order = (*sk).order
    (*t).opaque = (*sk).alpha >= 0.999 && (*mt).tex_alpha == false
}

fn process_tri(r: *mut render_types.Renderer, sk: *mut Sink, va: u64, vb: u64, vc: u64) {
    let near: f64 = (*r).near
    let ina: bool = render_types.ldf(va, 10) >= near
    let inb: bool = render_types.ldf(vb, 10) >= near
    let inc: bool = render_types.ldf(vc, 10) >= near
    if ina && inb && inc {
        emit_tri(r, sk, va, vb, vc)
        return
    }
    if ina == false && inb == false && inc == false { return }
    var count: i32 = 0
    if ina { count = count + 1 }
    if inb { count = count + 1 }
    if inc { count = count + 1 }
    if count == 1 {
        var s: i32 = 0
        if inb { s = 1 }
        if inc { s = 2 }
        let v0: u64 = pick(s, va, vb, vc)
        let v1: u64 = pick(s + 1, va, vb, vc)
        let v2: u64 = pick(s + 2, va, vb, vc)
        let i01: u64 = clip_at(r, sk, v0, v1, 0)
        let i02: u64 = clip_at(r, sk, v0, v2, 1)
        emit_tri(r, sk, v0, i01, i02)
        return
    }
    var o: i32 = 0
    if inb == false { o = 1 }
    if inc == false { o = 2 }
    let w2: u64 = pick(o, va, vb, vc)
    let w0: u64 = pick(o + 1, va, vb, vc)
    let w1: u64 = pick(o + 2, va, vb, vc)
    let i12: u64 = clip_at(r, sk, w1, w2, 0)
    let i02: u64 = clip_at(r, sk, w0, w2, 1)
    emit_tri(r, sk, w0, w1, i12)
    emit_tri(r, sk, w0, i12, i02)
}
