import std.rt
import std.vec
import scene3d.vec3
import scene3d.render_types
import scene3d.render_span
import scene3d.render_transp
import scene3d.render_resolve
import scene3d.render_rows

export {
    band_task,
}

fn raster_opaque(r: *mut render_types.Renderer, t: *mut render_types.Tri, id: u32, y0: i32, y1: i32) {
    var ya: i32 = (*t).row_lo
    if ya < y0 { ya = y0 }
    var yb: i32 = (*t).row_hi
    if yb > y1 { yb = y1 }
    var y: i32 = ya
    while y < yb {
        let yc: f64 = (y as f64) + 0.5
        var xa: f64 = 0.0
        var xb: f64 = 0.0
        render_span.span_of(t, yc, &xa, &xb)
        if xa < xb {
            var x: i32 = render_span.col_of(xa, (*r).sw)
            let xe: i32 = render_span.col_of(xb, (*r).sw)
            let rowb: usize = (y as usize) * ((*r).sw as usize)
            let base: f64 = (*t).pb * yc + (*t).pc
            while x < xe {
                let d: f32 = ((*t).pa * ((x as f64) + 0.5) + base) as f32
                let at: usize = rowb + (x as usize)
                if d > render_types.ldf32((*r).depth, at) {
                    render_types.stf32((*r).depth, at, d)
                    rt.st32((*r).tid, at, id + 1 as u32)
                }
                x = x + 1
            }
        }
        y = y + 1
    }
}

fn band_task(ctx: u64, lo: u64, hi: u64) {
    let r: *mut render_types.Renderer = ctx as *mut render_types.Renderer
    var b: i32 = lo as i32
    while b < (hi as i32) {
        let y0: i32 = b * (*r).band_h
        var y1: i32 = y0 + (*r).band_h
        if y1 > (*r).sh { y1 = (*r).sh }
        let off: usize = (y0 as usize) * ((*r).sw as usize) * 4
        let n: usize = ((y1 - y0) as usize) * ((*r).sw as usize) * 4
        rt.mem_set((*r).depth +% (off as u64), 0 as u8, n)
        rt.mem_set((*r).tid +% (off as u64), 0 as u8, n)
        var k: u32 = rt.ld32((*r).bs_op.p, b as usize)
        let ke: u32 = rt.ld32((*r).bs_op.p, (b + 1) as usize)
        while k < ke {
            let id: u32 = rt.ld32((*r).bi_op.p, k as usize)
            raster_opaque(r, vec.vec_elem_ptr[render_types.Tri](&(*r).tris, id as usize), id, y0, y1)
            k = k + 1 as u32
        }
        render_rows.shade_rows(r, y0, y1)
        k = rt.ld32((*r).bs_tr.p, b as usize)
        let kt: u32 = rt.ld32((*r).bs_tr.p, (b + 1) as usize)
        while k < kt {
            let id: u32 = rt.ld32((*r).bi_tr.p, k as usize)
            render_transp.transp_tri(r, vec.vec_elem_ptr[render_types.Tri](&(*r).tris, id as usize), y0, y1)
            k = k + 1 as u32
        }
        let oy0: i32 = b * render_types.BAND_OUT_ROWS
        var oy1: i32 = oy0 + render_types.BAND_OUT_ROWS
        if oy1 > (*r).h { oy1 = (*r).h }
        render_resolve.resolve_rows(r, oy0, oy1)
        b = b + 1
    }
}
