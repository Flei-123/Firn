import std.rt
import std.vec
import std.math
import scene3d.vec3
import scene3d.render_types
import scene3d.render_shade
import scene3d.render_resolve

export {
    band_task,
}

fn col_of(v: f64, hi: i32) -> i32 {
    var c: f64 = math.ceil(v - 0.5)
    if c < 0.0 { c = 0.0 }
    if c > (hi as f64) { c = hi as f64 }
    return c as i32
}

fn span_of(t: *mut render_types.Tri, yc: f64, xa: *mut f64, xb: *mut f64) {
    *xa = 1.0e30
    *xb = 0.0 - 1.0e30
    if (*t).e0y <= yc && yc < (*t).e0q {
        let x: f64 = (*t).e0x + (yc - (*t).e0y) * (*t).e0s
        if x < *xa { *xa = x }
        if x > *xb { *xb = x }
    }
    if (*t).e1y <= yc && yc < (*t).e1q {
        let x: f64 = (*t).e1x + (yc - (*t).e1y) * (*t).e1s
        if x < *xa { *xa = x }
        if x > *xb { *xb = x }
    }
    if (*t).e2y <= yc && yc < (*t).e2q {
        let x: f64 = (*t).e2x + (yc - (*t).e2y) * (*t).e2s
        if x < *xa { *xa = x }
        if x > *xb { *xb = x }
    }
}

fn raster_opaque(r: *mut render_types.Renderer, t: *mut render_types.Tri, id: u32, y0: i32, y1: i32) {
    var ya: i32 = (*t).row_lo
    if ya < y0 { ya = y0 }
    var yb: i32 = (*t).row_hi
    if yb > y1 { yb = y1 }
    var y: i32 = ya
    while y < yb {
        let yc: f64 = (y as f64) + 0.5
        var xa: f64 = 0.0
        var xb: f64 = 0.0
        span_of(t, yc, &xa, &xb)
        if xa < xb {
            var x: i32 = col_of(xa, (*r).sw)
            let xe: i32 = col_of(xb, (*r).sw)
            let rowb: usize = (y as usize) * ((*r).sw as usize)
            let base: f64 = (*t).pb * yc + (*t).pc
            while x < xe {
                let d: f32 = ((*t).pa * ((x as f64) + 0.5) + base) as f32
                let at: usize = rowb + (x as usize)
                if d > render_types.ldf32((*r).depth, at) {
                    render_types.stf32((*r).depth, at, d)
                    rt.st32((*r).tid, at, id + 1 as u32)
                }
                x = x + 1
            }
        }
        y = y + 1
    }
}

fn put_color(r: *mut render_types.Renderer, at: usize, cr: f64, cg: f64, cb: f64) {
    render_types.stf32((*r).color, at * 3, cr as f32)
    render_types.stf32((*r).color, at * 3 + 1, cg as f32)
    render_types.stf32((*r).color, at * 3 + 2, cb as f32)
}

fn shade_rows(r: *mut render_types.Renderer, y0: i32, y1: i32) {
    var sh: render_types.Shade = render_types.Shade { dr: 0.0, dg: 0.0, db: 0.0, sr: 0.0, sg: 0.0, sb: 0.0, alpha: 1.0 }
    var y: i32 = y0
    while y < y1 {
        let ty: f64 = ((y as f64) + 0.5) / ((*r).sh as f64)
        let bgr: f64 = vec3.lerpf((*r).bg_top.x, (*r).bg_bottom.x, ty)
        let bgg: f64 = vec3.lerpf((*r).bg_top.y, (*r).bg_bottom.y, ty)
        let bgb: f64 = vec3.lerpf((*r).bg_top.z, (*r).bg_bottom.z, ty)
        var x: i32 = 0
        while x < (*r).sw {
            let at: usize = (y as usize) * ((*r).sw as usize) + (x as usize)
            let id: u32 = rt.ld32((*r).tid, at)
            if id == 0 as u32 {
                put_color(r, at, bgr, bgg, bgb)
            } else {
                let t: *mut render_types.Tri = vec.vec_elem_ptr[render_types.Tri](&(*r).tris, (id - 1 as u32) as usize)
                render_shade.shade_sample(r, t, (x as f64) + 0.5, (y as f64) + 0.5, &sh)
                let f: f64 = render_shade.fog_factor(r, 1.0 / (render_types.ldf32((*r).depth, at) as f64))
                put_color(r, at, vec3.lerpf(sh.dr + sh.sr, (*r).fog_color.x, f), vec3.lerpf(sh.dg + sh.sg, (*r).fog_color.y, f), vec3.lerpf(sh.db + sh.sb, (*r).fog_color.z, f))
            }
            x = x + 1
        }
        y = y + 1
    }
}

fn raster_transp(r: *mut render_types.Renderer, t: *mut render_types.Tri, y0: i32, y1: i32) {
    var sh: render_types.Shade = render_types.Shade { dr: 0.0, dg: 0.0, db: 0.0, sr: 0.0, sg: 0.0, sb: 0.0, alpha: 1.0 }
    var ya: i32 = (*t).row_lo
    if ya < y0 { ya = y0 }
    var yb: i32 = (*t).row_hi
    if yb > y1 { yb = y1 }
    var y: i32 = ya
    while y < yb {
        let yc: f64 = (y as f64) + 0.5
        var xa: f64 = 0.0
        var xb: f64 = 0.0
        span_of(t, yc, &xa, &xb)
        if xa < xb {
            var x: i32 = col_of(xa, (*r).sw)
            let xe: i32 = col_of(xb, (*r).sw)
            let rowb: usize = (y as usize) * ((*r).sw as usize)
            while x < xe {
                let iw: f64 = (*t).pa * ((x as f64) + 0.5) + (*t).pb * yc + (*t).pc
                let at: usize = rowb + (x as usize)
                if (iw as f32) > render_types.ldf32((*r).depth, at) {
                    render_shade.shade_sample(r, t, (x as f64) + 0.5, yc, &sh)
                    let f: f64 = render_shade.fog_factor(r, 1.0 / iw)
                    let a: f64 = sh.alpha
                    let dr: f64 = vec3.lerpf(sh.dr, (*r).fog_color.x, f)
                    let dg: f64 = vec3.lerpf(sh.dg, (*r).fog_color.y, f)
                    let db: f64 = vec3.lerpf(sh.db, (*r).fog_color.z, f)
                    let sk: f64 = 1.0 - f
                    let c0: f64 = render_types.ldf32((*r).color, at * 3) as f64
                    let c1: f64 = render_types.ldf32((*r).color, at * 3 + 1) as f64
                    let c2: f64 = render_types.ldf32((*r).color, at * 3 + 2) as f64
                    put_color(r, at, c0 * (1.0 - a) + dr * a + sh.sr * sk, c1 * (1.0 - a) + dg * a + sh.sg * sk, c2 * (1.0 - a) + db * a + sh.sb * sk)
                }
                x = x + 1
            }
        }
        y = y + 1
    }
}

fn band_task(ctx: u64, lo: u64, hi: u64) {
    let r: *mut render_types.Renderer = ctx as *mut render_types.Renderer
    var b: i32 = lo as i32
    while b < (hi as i32) {
        let y0: i32 = b * (*r).band_h
        var y1: i32 = y0 + (*r).band_h
        if y1 > (*r).sh { y1 = (*r).sh }
        let off: usize = (y0 as usize) * ((*r).sw as usize) * 4
        let n: usize = ((y1 - y0) as usize) * ((*r).sw as usize) * 4
        rt.mem_set((*r).depth +% (off as u64), 0 as u8, n)
        rt.mem_set((*r).tid +% (off as u64), 0 as u8, n)
        var k: u32 = rt.ld32((*r).bs_op.p, b as usize)
        let ke: u32 = rt.ld32((*r).bs_op.p, (b + 1) as usize)
        while k < ke {
            let id: u32 = rt.ld32((*r).bi_op.p, k as usize)
            raster_opaque(r, vec.vec_elem_ptr[render_types.Tri](&(*r).tris, id as usize), id, y0, y1)
            k = k + 1 as u32
        }
        shade_rows(r, y0, y1)
        k = rt.ld32((*r).bs_tr.p, b as usize)
        let kt: u32 = rt.ld32((*r).bs_tr.p, (b + 1) as usize)
        while k < kt {
            let id: u32 = rt.ld32((*r).bi_tr.p, k as usize)
            raster_transp(r, vec.vec_elem_ptr[render_types.Tri](&(*r).tris, id as usize), y0, y1)
            k = k + 1 as u32
        }
        let oy0: i32 = b * render_types.BAND_OUT_ROWS
        var oy1: i32 = oy0 + render_types.BAND_OUT_ROWS
        if oy1 > (*r).h { oy1 = (*r).h }
        render_resolve.resolve_rows(r, oy0, oy1)
        b = b + 1
    }
}
