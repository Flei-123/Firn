import std.rt
import std.vec
import scene3d.render_types
import scene3d.render_order

export {
    build_bins,
}

fn bin_count(r: *mut render_types.Renderer, starts: u64, t: *mut render_types.Tri) {
    let bh: i32 = (*r).band_h
    var b: i32 = (*t).row_lo / bh
    let b1: i32 = ((*t).row_hi - 1) / bh
    while b <= b1 {
        rt.st32(starts, (b + 1) as usize, rt.ld32(starts, (b + 1) as usize) + 1 as u32)
        b = b + 1
    }
}

fn bin_fill(r: *mut render_types.Renderer, starts: u64, cursor: u64, items: u64, t: *mut render_types.Tri, id: u32) {
    let bh: i32 = (*r).band_h
    var b: i32 = (*t).row_lo / bh
    let b1: i32 = ((*t).row_hi - 1) / bh
    while b <= b1 {
        let at: u32 = rt.ld32(cursor, b as usize)
        rt.st32(items, at as usize, id)
        rt.st32(cursor, b as usize, at + 1 as u32)
        b = b + 1
    }
}

fn build_bins(r: *mut render_types.Renderer, units: usize) {
    let nb: usize = (*r).nbands as usize
    let nt: usize = vec.vec_len[render_types.Tri](&(*r).tris)
    render_types.blk_ensure(&(*r).bs_op, (nb + 1) * 4)
    render_types.blk_ensure(&(*r).bs_tr, (nb + 1) * 4)
    render_types.blk_ensure(&(*r).cnt, nb * 8 + 16)
    let so: u64 = (*r).bs_op.p
    let st: u64 = (*r).bs_tr.p
    var i: usize = 0
    while i <= nb {
        rt.st32(so, i, 0 as u32)
        rt.st32(st, i, 0 as u32)
        i = i + 1
    }
    vec.vec_clear[render_types.SortItem](&(*r).order)
    render_order.stats_reset(&(*r).ps.ustat, units)
    var n_op: i32 = 0
    var n_tr: i32 = 0
    i = 0
    while i < nt {
        let t: *mut render_types.Tri = vec.vec_elem_ptr[render_types.Tri](&(*r).tris, i)
        if (*t).opaque {
            bin_count(r, so, t)
            n_op = n_op + 1
        } else {
            bin_count(r, st, t)
            render_order.stats_add(&(*r).ps.ustat, (*t).group, (*t).key)
            vec.vec_push[render_types.SortItem](&(*r).order, render_types.SortItem {
                order: (*t).order, unit: (*t).group, uk: 0.0, ue: 0.0, key: (*t).key, back: (*t).back, id: i as u32,
            })
            n_tr = n_tr + 1
        }
        i = i + 1
    }
    (*r).n_opaque = n_op
    (*r).n_transp = n_tr
    i = 0
    while i < nb {
        rt.st32(so, i + 1, rt.ld32(so, i + 1) + rt.ld32(so, i))
        rt.st32(st, i + 1, rt.ld32(st, i + 1) + rt.ld32(st, i))
        i = i + 1
    }
    render_types.blk_ensure(&(*r).bi_op, (rt.ld32(so, nb) as usize) * 4 + 16)
    render_types.blk_ensure(&(*r).bi_tr, (rt.ld32(st, nb) as usize) * 4 + 16)
    let cur: u64 = (*r).cnt.p
    i = 0
    while i < nb {
        rt.st32(cur, i, rt.ld32(so, i))
        rt.st32(cur, nb + i, rt.ld32(st, i))
        i = i + 1
    }
    i = 0
    while i < nt {
        let t: *mut render_types.Tri = vec.vec_elem_ptr[render_types.Tri](&(*r).tris, i)
        if (*t).opaque {
            bin_fill(r, so, cur, (*r).bi_op.p, t, i as u32)
        }
        i = i + 1
    }
    i = 0
    while i < (n_tr as usize) {
        render_order.stats_apply(&(*r).ps.ustat, vec.vec_elem_ptr[render_types.SortItem](&(*r).order, i))
        i = i + 1
    }
    vec.vec_sort_by[render_types.SortItem](&(*r).order, render_order.item_less)
    let curt: u64 = cur +% ((nb * 4) as u64)
    i = 0
    while i < (n_tr as usize) {
        let it: *mut render_types.SortItem = vec.vec_elem_ptr[render_types.SortItem](&(*r).order, i)
        let t: *mut render_types.Tri = vec.vec_elem_ptr[render_types.Tri](&(*r).tris, (*it).id as usize)
        bin_fill(r, st, curt, (*r).bi_tr.p, t, (*it).id)
        i = i + 1
    }
}
