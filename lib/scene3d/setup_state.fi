// SPDX-License-Identifier: MPL-2.0
import std.vec
import scene3d.mat4

export {
    SetupJob, Chunk, State, state_new, state_free,
}

struct SetupJob {
    node: i32,
    mesh: u64,
    mp: u64,
    tp: u64,
    alpha: f64,
    unit: i32,
    order: i32,
    voff: usize,
    nv: usize,
    nt: usize,
    w: mat4.M4,
    mvp: mat4.M4,
    cf: mat4.M4,
}

struct Chunk {
    job: i32,
    lo: usize,
    hi: usize,
    count: usize,
    dest: usize,
}

struct State {
    jobs: vec.Vec[SetupJob],
    vch: vec.Vec[Chunk],
    tch: vec.Vec[Chunk],
    groups: vec.Vec[i32],
    ustat: vec.Vec[f64],
    tmp: vec.Vec[f64],
    perm: vec.Vec[u32],
    ptmp: vec.Vec[u32],
    bcnt: vec.Vec[u32],
}

fn state_new() -> State {
    return State {
        jobs: vec.vec_new[SetupJob](),
        vch: vec.vec_new[Chunk](),
        tch: vec.vec_new[Chunk](),
        groups: vec.vec_new[i32](),
        ustat: vec.vec_new[f64](),
        tmp: vec.vec_new[f64](),
        perm: vec.vec_new[u32](),
        ptmp: vec.vec_new[u32](),
        bcnt: vec.vec_new[u32](),
    }
}

fn state_free(s: *mut State) {
    vec.vec_free[SetupJob](&(*s).jobs)
    vec.vec_free[Chunk](&(*s).vch)
    vec.vec_free[Chunk](&(*s).tch)
    vec.vec_free[i32](&(*s).groups)
    vec.vec_free[f64](&(*s).ustat)
    vec.vec_free[f64](&(*s).tmp)
    vec.vec_free[u32](&(*s).perm)
    vec.vec_free[u32](&(*s).ptmp)
    vec.vec_free[u32](&(*s).bcnt)
}
