import std.vec
import scene3d.render_types

export {
    item_less, stats_reset, stats_add, stats_apply,
}

fn item_less(a: *render_types.SortItem, b: *render_types.SortItem) -> bool {
    if (*a).order != (*b).order { return (*a).order < (*b).order }
    if (*a).uk != (*b).uk { return (*a).uk > (*b).uk }
    if (*a).ue != (*b).ue { return (*a).ue > (*b).ue }
    if (*a).unit != (*b).unit { return (*a).unit < (*b).unit }
    if (*a).back != (*b).back { return (*a).back }
    if (*a).key != (*b).key { return (*a).key > (*b).key }
    return (*a).id < (*b).id
}

fn stats_reset(st: *mut vec.Vec[f64], units: usize) {
    vec.vec_clear[f64](st)
    vec.vec_reserve[f64](st, units * 2)
    var i: usize = 0
    while i < units {
        vec.vec_push[f64](st, 1.0e30)
        vec.vec_push[f64](st, 0.0 - 1.0e30)
        i = i + 1
    }
}

fn stats_add(st: *mut vec.Vec[f64], unit: i32, key: f64) {
    let lo: *mut f64 = vec.vec_elem_ptr[f64](st, (unit as usize) * 2)
    let hi: *mut f64 = vec.vec_elem_ptr[f64](st, (unit as usize) * 2 + 1)
    if key < *lo { *lo = key }
    if key > *hi { *hi = key }
}

fn stats_apply(st: *mut vec.Vec[f64], it: *mut render_types.SortItem) {
    let lo: f64 = *vec.vec_elem_ptr[f64](st, ((*it).unit as usize) * 2)
    let hi: f64 = *vec.vec_elem_ptr[f64](st, ((*it).unit as usize) * 2 + 1)
    (*it).uk = (lo + hi) * 0.5
    (*it).ue = hi
}
