import std.math
import scene3d.vec3
import scene3d.render_types
import scene3d.shadow_types

export {
    project_task, raster_task, BAND_ROWS,
}

const BAND_ROWS: i32 = 64

fn range_lo(v: f64, hi: i32) -> i32 {
    var c: f64 = math.floor(v - 0.5)
    if c < 0.0 { c = 0.0 }
    if c > (hi as f64) { c = hi as f64 }
    return c as i32
}

fn range_hi(v: f64, hi: i32) -> i32 {
    var c: f64 = math.floor(v + 0.5) + 1.0
    if c < 0.0 { c = 0.0 }
    if c > (hi as f64) { c = hi as f64 }
    return c as i32
}

fn skip_tri(pp: u64, o: usize) {
    render_types.stf(pp, o, 0.0)
    render_types.stf(pp, o + 1, 0.0)
}

fn project_one(m: *mut shadow_types.ShadowMap, i: usize) {
    let w: u64 = (*m).world
    let pp: u64 = (*m).proj.p
    let o: usize = i * shadow_types.PSTRIDE
    let wo: usize = i * shadow_types.WSTRIDE
    let p0: vec3.V3 = vec3.v3(render_types.ldf(w, wo), render_types.ldf(w, wo + 1), render_types.ldf(w, wo + 2))
    let p1: vec3.V3 = vec3.v3(render_types.ldf(w, wo + 3), render_types.ldf(w, wo + 4), render_types.ldf(w, wo + 5))
    let p2: vec3.V3 = vec3.v3(render_types.ldf(w, wo + 6), render_types.ldf(w, wo + 7), render_types.ldf(w, wo + 8))
    let tr: f64 = render_types.ldf(w, wo + 9)
    if tr >= 0.0 {
        let fnrm: vec3.V3 = vec3.v3_cross(vec3.v3_sub(p1, p0), vec3.v3_sub(p2, p0))
        if vec3.v3_dot(fnrm, (*m).to_light) <= 0.0 {
            skip_tri(pp, o)
            return
        }
    }
    let inv: f64 = 1.0 / (*m).texel
    let x0: f64 = (vec3.v3_dot((*m).right, p0) - (*m).umin) * inv
    let y0: f64 = (vec3.v3_dot((*m).up, p0) - (*m).vmin) * inv
    let x1: f64 = (vec3.v3_dot((*m).right, p1) - (*m).umin) * inv
    let y1: f64 = (vec3.v3_dot((*m).up, p1) - (*m).vmin) * inv
    let x2: f64 = (vec3.v3_dot((*m).right, p2) - (*m).umin) * inv
    let y2: f64 = (vec3.v3_dot((*m).up, p2) - (*m).vmin) * inv
    let d0: f64 = (*m).zmax - vec3.v3_dot((*m).to_light, p0)
    let d1: f64 = (*m).zmax - vec3.v3_dot((*m).to_light, p1)
    let d2: f64 = (*m).zmax - vec3.v3_dot((*m).to_light, p2)
    let area2: f64 = (x1 - x0) * (y2 - y0) - (x2 - x0) * (y1 - y0)
    if area2 > 0.0 - 0.000000000001 && area2 < 0.000000000001 {
        skip_tri(pp, o)
        return
    }
    let n: i32 = (*m).size
    let ymin: f64 = vec3.minf(y0, vec3.minf(y1, y2))
    let ymax: f64 = vec3.maxf(y0, vec3.maxf(y1, y2))
    let xmin: f64 = vec3.minf(x0, vec3.minf(x1, x2))
    let xmax: f64 = vec3.maxf(x0, vec3.maxf(x1, x2))
    let ia: f64 = 1.0 / area2
    let dd1: f64 = d1 - d0
    let dd2: f64 = d2 - d0
    let pa: f64 = (dd1 * (y2 - y0) - dd2 * (y1 - y0)) * ia
    let pb: f64 = (dd2 * (x1 - x0) - dd1 * (x2 - x0)) * ia
    let l1a: f64 = (y2 - y0) * ia
    let l1b: f64 = 0.0 - (x2 - x0) * ia
    let l2a: f64 = 0.0 - (y1 - y0) * ia
    let l2b: f64 = (x1 - x0) * ia
    render_types.stf(pp, o, range_lo(ymin, n) as f64)
    render_types.stf(pp, o + 1, range_hi(ymax, n) as f64)
    render_types.stf(pp, o + 2, range_lo(xmin, n) as f64)
    render_types.stf(pp, o + 3, range_hi(xmax, n) as f64)
    render_types.stf(pp, o + 4, pa)
    render_types.stf(pp, o + 5, pb)
    render_types.stf(pp, o + 6, d0 - pa * x0 - pb * y0)
    render_types.stf(pp, o + 7, l1a)
    render_types.stf(pp, o + 8, l1b)
    render_types.stf(pp, o + 9, 0.0 - (l1a * x0 + l1b * y0))
    render_types.stf(pp, o + 10, l2a)
    render_types.stf(pp, o + 11, l2b)
    render_types.stf(pp, o + 12, 0.0 - (l2a * x0 + l2b * y0))
    render_types.stf(pp, o + 13, tr)
}

fn project_task(ctx: u64, lo: u64, hi: u64) {
    let m: *mut shadow_types.ShadowMap = ctx as *mut shadow_types.ShadowMap
    var i: usize = lo as usize
    while i < (hi as usize) {
        project_one(m, i)
        i = i + 1
    }
}

fn clear_rows(m: *mut shadow_types.ShadowMap, y0: i32, y1: i32) {
    let n: usize = (*m).size as usize
    let far: f32 = shadow_types.FAR_DEPTH as f32
    var i: usize = (y0 as usize) * n
    let e: usize = (y1 as usize) * n
    while i < e {
        render_types.stf32((*m).depth.p, i, far)
        if (*m).has_trans {
            render_types.stf32((*m).tdepth.p, i, far)
            render_types.stf32((*m).tfac.p, i, 1.0 as f32)
        }
        i = i + 1
    }
}

fn raster_tri(m: *mut shadow_types.ShadowMap, pp: u64, o: usize, y0: i32, y1: i32) {
    var ya: i32 = render_types.ldf(pp, o) as i32
    var yb: i32 = render_types.ldf(pp, o + 1) as i32
    if ya < y0 { ya = y0 }
    if yb > y1 { yb = y1 }
    if ya >= yb { return }
    let xa: i32 = render_types.ldf(pp, o + 2) as i32
    let xb: i32 = render_types.ldf(pp, o + 3) as i32
    let pa: f64 = render_types.ldf(pp, o + 4)
    let pb: f64 = render_types.ldf(pp, o + 5)
    let pc: f64 = render_types.ldf(pp, o + 6)
    let l1a: f64 = render_types.ldf(pp, o + 7)
    let l1b: f64 = render_types.ldf(pp, o + 8)
    let l1c: f64 = render_types.ldf(pp, o + 9)
    let l2a: f64 = render_types.ldf(pp, o + 10)
    let l2b: f64 = render_types.ldf(pp, o + 11)
    let l2c: f64 = render_types.ldf(pp, o + 12)
    let tr: f64 = render_types.ldf(pp, o + 13)
    let eps: f64 = 0.0 - 0.000001
    let n: usize = (*m).size as usize
    var y: i32 = ya
    while y < yb {
        let yc: f64 = (y as f64) + 0.5
        let row: usize = (y as usize) * n
        var x: i32 = xa
        while x < xb {
            let xc: f64 = (x as f64) + 0.5
            let l1: f64 = l1a * xc + l1b * yc + l1c
            let l2: f64 = l2a * xc + l2b * yc + l2c
            let l0: f64 = 1.0 - l1 - l2
            x = x + 1
            if l0 < eps || l1 < eps || l2 < eps { continue }
            let at: usize = row + ((x - 1) as usize)
            let d: f32 = (pa * xc + pb * yc + pc) as f32
            if tr < 0.0 {
                if d < render_types.ldf32((*m).depth.p, at) { render_types.stf32((*m).depth.p, at, d) }
            } else {
                if d < render_types.ldf32((*m).tdepth.p, at) { render_types.stf32((*m).tdepth.p, at, d) }
                render_types.stf32((*m).tfac.p, at, render_types.ldf32((*m).tfac.p, at) * (tr as f32))
            }
        }
        y = y + 1
    }
}

fn raster_task(ctx: u64, lo: u64, hi: u64) {
    let m: *mut shadow_types.ShadowMap = ctx as *mut shadow_types.ShadowMap
    var b: i32 = lo as i32
    while b < (hi as i32) {
        let y0: i32 = b * BAND_ROWS
        var y1: i32 = y0 + BAND_ROWS
        if y1 > (*m).size { y1 = (*m).size }
        clear_rows(m, y0, y1)
        var i: usize = 0
        while i < ((*m).ntris as usize) {
            raster_tri(m, (*m).proj.p, i * shadow_types.PSTRIDE, y0, y1)
            i = i + 1
        }
        b = b + 1
    }
}
