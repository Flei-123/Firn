import scene3d.vec3

export {
    schlick, schlick_rough, glass_alpha,
}

fn pow5(x: f64) -> f64 {
    let x2: f64 = x * x
    return x2 * x2 * x
}

fn schlick(f0: f64, ndv: f64) -> f64 {
    let g: f64 = 1.0 - vec3.clamp01(ndv)
    return f0 + (1.0 - f0) * pow5(g)
}

fn schlick_rough(f0: f64, rough: f64, ndv: f64) -> f64 {
    let g: f64 = 1.0 - vec3.clamp01(ndv)
    var top: f64 = 1.0 - rough
    if top < f0 { top = f0 }
    return f0 + (top - f0) * pow5(g)
}

fn glass_alpha(alpha: f64, rim: f64, ndv: f64) -> f64 {
    let g: f64 = 1.0 - vec3.clamp01(ndv)
    let f: f64 = 0.04 + 0.96 * pow5(g)
    let edge: f64 = g * g * g * 0.6
    return alpha + (1.0 - alpha) * vec3.clamp01(rim * (edge + f))
}
