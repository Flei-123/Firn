import std.rt
import scene3d.vec3
import scene3d.render_types
import scene3d.render_shade
import scene3d.render_span
import scene3d.render_rows

export {
    transp_tri,
}

fn blend_sample(r: *mut render_types.Renderer, at: usize, iw: f64, sh: *mut render_types.Shade) {
    let f: f64 = render_shade.fog_factor(r, 1.0 / iw)
    let a: f64 = (*sh).alpha
    let dr: f64 = vec3.lerpf((*sh).dr, (*r).fog_color.x, f)
    let dg: f64 = vec3.lerpf((*sh).dg, (*r).fog_color.y, f)
    let db: f64 = vec3.lerpf((*sh).db, (*r).fog_color.z, f)
    let sk: f64 = 1.0 - f
    let c0: f64 = render_types.ldf32((*r).color, at * 3) as f64
    let c1: f64 = render_types.ldf32((*r).color, at * 3 + 1) as f64
    let c2: f64 = render_types.ldf32((*r).color, at * 3 + 2) as f64
    render_rows.put_color(r, at, c0 * (1.0 - a) + dr * a + (*sh).sr * sk, c1 * (1.0 - a) + dg * a + (*sh).sg * sk, c2 * (1.0 - a) + db * a + (*sh).sb * sk)
}

fn raster_plain(r: *mut render_types.Renderer, t: *mut render_types.Tri, y0: i32, y1: i32) {
    var sh: render_types.Shade = render_types.Shade { dr: 0.0, dg: 0.0, db: 0.0, sr: 0.0, sg: 0.0, sb: 0.0, alpha: 1.0 }
    var ya: i32 = (*t).row_lo
    if ya < y0 { ya = y0 }
    var yb: i32 = (*t).row_hi
    if yb > y1 { yb = y1 }
    var y: i32 = ya
    while y < yb {
        let yc: f64 = (y as f64) + 0.5
        var xa: f64 = 0.0
        var xb: f64 = 0.0
        render_span.span_of(t, yc, &xa, &xb)
        if xa < xb {
            var x: i32 = render_span.col_of(xa, (*r).sw)
            let xe: i32 = render_span.col_of(xb, (*r).sw)
            let rowb: usize = (y as usize) * ((*r).sw as usize)
            while x < xe {
                let iw: f64 = (*t).pa * ((x as f64) + 0.5) + (*t).pb * yc + (*t).pc
                let at: usize = rowb + (x as usize)
                if (iw as f32) > render_types.ldf32((*r).depth, at) {
                    render_shade.shade_sample(r, t, (x as f64) + 0.5, yc, &sh)
                    blend_sample(r, at, iw, &sh)
                }
                x = x + 1
            }
        }
        y = y + 1
    }
}

fn sample_iw(t: *mut render_types.Tri, x: i32, y: i32) -> f64 {
    return (*t).pa * ((x as f64) + 0.5) + (*t).pb * ((y as f64) + 0.5) + (*t).pc
}

fn pixel_passes(r: *mut render_types.Renderer, t: *mut render_types.Tri, ox: i32, oy: i32) -> bool {
    let ss: i32 = (*r).ss
    var j: i32 = 0
    while j < ss {
        let y: i32 = oy * ss + j
        var i: i32 = 0
        while i < ss {
            let x: i32 = ox * ss + i
            let at: usize = (y as usize) * ((*r).sw as usize) + (x as usize)
            if (sample_iw(t, x, y) as f32) > render_types.ldf32((*r).depth, at) {
            } else {
                return false
            }
            i = i + 1
        }
        j = j + 1
    }
    return true
}

fn blend_pixel(r: *mut render_types.Renderer, t: *mut render_types.Tri, ox: i32, oy: i32, sh: *mut render_types.Shade) {
    let ss: i32 = (*r).ss
    var j: i32 = 0
    while j < ss {
        let y: i32 = oy * ss + j
        var i: i32 = 0
        while i < ss {
            let x: i32 = ox * ss + i
            blend_sample(r, (y as usize) * ((*r).sw as usize) + (x as usize), sample_iw(t, x, y), sh)
            i = i + 1
        }
        j = j + 1
    }
}

fn shade_pixel_samples(r: *mut render_types.Renderer, t: *mut render_types.Tri, ox: i32, oy: i32, sh: *mut render_types.Shade) {
    let ss: i32 = (*r).ss
    var j: i32 = 0
    while j < ss {
        let y: i32 = oy * ss + j
        j = j + 1
        if y < (*t).row_lo || y >= (*t).row_hi { continue }
        var xa: f64 = 0.0
        var xb: f64 = 0.0
        render_span.span_of(t, (y as f64) + 0.5, &xa, &xb)
        if xa >= xb { continue }
        let c0: i32 = render_span.col_of(xa, (*r).sw)
        let c1: i32 = render_span.col_of(xb, (*r).sw)
        var i: i32 = 0
        while i < ss {
            let x: i32 = ox * ss + i
            if x >= c0 && x < c1 { sample_one(r, t, x, y, sh) }
            i = i + 1
        }
    }
}

fn sample_one(r: *mut render_types.Renderer, t: *mut render_types.Tri, x: i32, y: i32, sh: *mut render_types.Shade) {
    let iw: f64 = sample_iw(t, x, y)
    let at: usize = (y as usize) * ((*r).sw as usize) + (x as usize)
    if (iw as f32) > render_types.ldf32((*r).depth, at) {
        render_shade.shade_sample(r, t, (x as f64) + 0.5, (y as f64) + 0.5, sh)
        blend_sample(r, at, iw, sh)
    }
}

fn pixel_full(r: *mut render_types.Renderer, t: *mut render_types.Tri, ox: i32, oy: i32) -> bool {
    let ss: i32 = (*r).ss
    var j: i32 = 0
    while j < ss {
        let y: i32 = oy * ss + j
        if y < (*t).row_lo || y >= (*t).row_hi { return false }
        var xa: f64 = 0.0
        var xb: f64 = 0.0
        render_span.span_of(t, (y as f64) + 0.5, &xa, &xb)
        if xa >= xb { return false }
        if render_span.col_of(xa, (*r).sw) > ox * ss { return false }
        if render_span.col_of(xb, (*r).sw) < ox * ss + ss { return false }
        j = j + 1
    }
    return true
}

fn raster_shared(r: *mut render_types.Renderer, t: *mut render_types.Tri, y0: i32, y1: i32) {
    var sh: render_types.Shade = render_types.Shade { dr: 0.0, dg: 0.0, db: 0.0, sr: 0.0, sg: 0.0, sb: 0.0, alpha: 1.0 }
    let ss: i32 = (*r).ss
    let half: f64 = (ss as f64) * 0.5
    var ya: i32 = (*t).row_lo
    if ya < y0 { ya = y0 }
    var yb: i32 = (*t).row_hi
    if yb > y1 { yb = y1 }
    if ya >= yb { return }
    var oy: i32 = ya / ss
    let oye: i32 = (yb - 1) / ss
    while oy <= oye {
        var lo: i32 = (*r).sw
        var hi: i32 = 0
        var j: i32 = 0
        while j < ss {
            let y: i32 = oy * ss + j
            if y >= (*t).row_lo && y < (*t).row_hi {
                var xa: f64 = 0.0
                var xb: f64 = 0.0
                render_span.span_of(t, (y as f64) + 0.5, &xa, &xb)
                if xa < xb {
                    let c0: i32 = render_span.col_of(xa, (*r).sw)
                    let c1: i32 = render_span.col_of(xb, (*r).sw)
                    if c0 < c1 {
                        if c0 < lo { lo = c0 }
                        if c1 > hi { hi = c1 }
                    }
                }
            }
            j = j + 1
        }
        if lo < hi {
            var ox: i32 = lo / ss
            let oxe: i32 = (hi - 1) / ss
            while ox <= oxe {
                if pixel_full(r, t, ox, oy) && pixel_passes(r, t, ox, oy) {
                    render_shade.shade_sample(r, t, ((ox * ss) as f64) + half, ((oy * ss) as f64) + half, &sh)
                    blend_pixel(r, t, ox, oy, &sh)
                } else {
                    shade_pixel_samples(r, t, ox, oy, &sh)
                }
                ox = ox + 1
            }
        }
        oy = oy + 1
    }
}

fn transp_tri(r: *mut render_types.Renderer, t: *mut render_types.Tri, y0: i32, y1: i32) {
    if (*r).share_shading && (*r).ss > 1 && (*t).tex == 0 as u64 {
        raster_shared(r, t, y0, y1)
        return
    }
    raster_plain(r, t, y0, y1)
}
