import std.rt
import std.vec
import jobs.jobs
import scene3d.vec3
import scene3d.material
import scene3d.setup_state

export {
    Tri, SortItem, Block, Shade, Renderer,
    VSTRIDE, MAX_LIGHTS, LIGHT_STRIDE, LUT_SIZE, BAND_OUT_ROWS,
    ldf, stf, ldf32, stf32,
    blk_ensure, blk_free, tri_blank, tri_ptr, elem_at,
}

const VSTRIDE: usize = 14
const MAX_LIGHTS: i32 = 8
const LIGHT_STRIDE: usize = 8
const LUT_SIZE: i32 = 16384
const BAND_OUT_ROWS: i32 = 8

struct Block {
    p: u64,
    cap: usize,
}

struct SortItem {
    order: i32,
    unit: i32,
    uk: f64,
    ue: f64,
    key: f64,
    back: bool,
    id: u32,
}

struct Shade {
    dr: f64,
    dg: f64,
    db: f64,
    sr: f64,
    sg: f64,
    sb: f64,
    alpha: f64,
}

struct Tri {
    x0: f64,
    y0: f64,
    x1: f64,
    y1: f64,
    x2: f64,
    y2: f64,
    iw0: f64,
    iw1: f64,
    iw2: f64,
    pa: f64,
    pb: f64,
    pc: f64,
    l1a: f64,
    l1b: f64,
    l1c: f64,
    l2a: f64,
    l2b: f64,
    l2c: f64,
    e0x: f64,
    e0y: f64,
    e0q: f64,
    e0s: f64,
    e1x: f64,
    e1y: f64,
    e1q: f64,
    e1s: f64,
    e2x: f64,
    e2y: f64,
    e2q: f64,
    e2s: f64,
    p0: vec3.V3,
    p1: vec3.V3,
    p2: vec3.V3,
    n0: vec3.V3,
    n1: vec3.V3,
    n2: vec3.V3,
    u0: f64,
    v0: f64,
    u1: f64,
    v1: f64,
    u2: f64,
    v2: f64,
    alpha: f64,
    key: f64,
    mat: u64,
    tex: u64,
    row_lo: i32,
    row_hi: i32,
    group: i32,
    order: i32,
    back: bool,
    opaque: bool,
    recv: bool,
}

struct Renderer {
    w: i32,
    h: i32,
    ss: i32,
    threads: i32,
    sw: i32,
    sh: i32,
    band_h: i32,
    nbands: i32,
    depth: u64,
    tid: u64,
    color: u64,
    lut_srgb: u64,
    lut_tex: u64,
    lights_blk: u64,
    nlights: i32,
    shadow: u64,
    pool: jobs.Jobs,
    use_pool: bool,
    tris: vec.Vec[Tri],
    order: vec.Vec[SortItem],
    vbuf: Block,
    tmpv: Block,
    cnt: Block,
    bs_op: Block,
    bi_op: Block,
    bs_tr: Block,
    bi_tr: Block,
    cam_x: f64,
    cam_y: f64,
    cam_z: f64,
    near: f64,
    far: f64,
    hemi_sky: vec3.V3,
    hemi_ground: vec3.V3,
    ambient: vec3.V3,
    bg_top: vec3.V3,
    bg_bottom: vec3.V3,
    fog_on: bool,
    fog_color: vec3.V3,
    fog_near: f64,
    fog_far: f64,
    exposure: f64,
    tonemap: i32,
    hz_c: f64,
    hz_x: f64,
    hz_y: f64,
    def_mat: material.Material,
    n_opaque: i32,
    n_transp: i32,
    ps: setup_state.State,
    sc: u64,
    out_px: u64,
}

#[inline]
fn ldf(base: u64, i: usize) -> f64 {
    return *((base +% ((i as u64) * (8 as u64))) as *mut f64)
}

#[inline]
fn stf(base: u64, i: usize, v: f64) {
    *((base +% ((i as u64) * (8 as u64))) as *mut f64) = v
}

#[inline]
fn ldf32(base: u64, i: usize) -> f32 {
    return *((base +% ((i as u64) * (4 as u64))) as *mut f32)
}

#[inline]
fn stf32(base: u64, i: usize, v: f32) {
    *((base +% ((i as u64) * (4 as u64))) as *mut f32) = v
}

fn blk_ensure(b: *mut Block, bytes: usize) {
    if bytes <= (*b).cap { return }
    if (*b).p != 0 as u64 { rt.heap_free((*b).p, (*b).cap) }
    let c: usize = bytes + bytes / 2 + 64
    (*b).p = rt.heap_alloc(c)
    (*b).cap = c
}

fn blk_free(b: *mut Block) {
    if (*b).p != 0 as u64 { rt.heap_free((*b).p, (*b).cap) }
    (*b).p = 0 as u64
    (*b).cap = 0
}

fn tri_blank() -> Tri {
    let z: vec3.V3 = vec3.v3_zero()
    return Tri {
        x0: 0.0, y0: 0.0, x1: 0.0, y1: 0.0, x2: 0.0, y2: 0.0,
        iw0: 0.0, iw1: 0.0, iw2: 0.0,
        pa: 0.0, pb: 0.0, pc: 0.0,
        l1a: 0.0, l1b: 0.0, l1c: 0.0, l2a: 0.0, l2b: 0.0, l2c: 0.0,
        e0x: 0.0, e0y: 0.0, e0q: 0.0, e0s: 0.0,
        e1x: 0.0, e1y: 0.0, e1q: 0.0, e1s: 0.0,
        e2x: 0.0, e2y: 0.0, e2q: 0.0, e2s: 0.0,
        p0: z, p1: z, p2: z, n0: z, n1: z, n2: z,
        u0: 0.0, v0: 0.0, u1: 0.0, v1: 0.0, u2: 0.0, v2: 0.0,
        alpha: 1.0, key: 0.0, mat: 0 as u64, tex: 0 as u64,
        row_lo: 0, row_hi: 0, group: 0, order: 0, back: false, opaque: true, recv: true,
    }
}


#[inline]
fn elem_at[T](base: u64, i: usize) -> *mut T {
    return (base +% ((i * size_of[T]()) as u64)) as *mut T
}

#[inline]
fn tri_ptr(base: u64, i: usize) -> *mut Tri {
    return elem_at[Tri](base, i)
}
