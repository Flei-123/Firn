import std.math
import std.rt
import scene3d.vec3
import scene3d.material
import scene3d.surface
import scene3d.render_types

export {
    shade_sample, tex_sample, fog_factor,
}

fn texel(r: *mut render_types.Renderer, ts: *mut surface.Surface, x: i32, y: i32, ch: i32) -> f64 {
    let p: u32 = rt.ld32((*ts).px, (y as usize) * ((*ts).w as usize) + (x as usize))
    var v: u32 = p & 255 as u32
    if ch == 1 { v = (p >> 8 as u32) & 255 as u32 }
    if ch == 2 { v = (p >> 16 as u32) & 255 as u32 }
    return render_types.ldf((*r).lut_tex, v as usize)
}

fn tex_sample(r: *mut render_types.Renderer, tp: u64, u: f64, v: f64) -> vec3.V3 {
    let ts: *mut surface.Surface = tp as *mut surface.Surface
    let w: i32 = (*ts).w
    let h: i32 = (*ts).h
    let fx: f64 = vec3.clamp01(u) * ((w - 1) as f64)
    let fy: f64 = (1.0 - vec3.clamp01(v)) * ((h - 1) as f64)
    let x0: i32 = fx as i32
    let y0: i32 = fy as i32
    var x1: i32 = x0 + 1
    var y1: i32 = y0 + 1
    if x1 >= w { x1 = w - 1 }
    if y1 >= h { y1 = h - 1 }
    let tx: f64 = fx - (x0 as f64)
    let ty: f64 = fy - (y0 as f64)
    let w00: f64 = (1.0 - tx) * (1.0 - ty)
    let w10: f64 = tx * (1.0 - ty)
    let w01: f64 = (1.0 - tx) * ty
    let w11: f64 = tx * ty
    return vec3.V3 {
        x: texel(r, ts, x0, y0, 0) * w00 + texel(r, ts, x1, y0, 0) * w10 + texel(r, ts, x0, y1, 0) * w01 + texel(r, ts, x1, y1, 0) * w11,
        y: texel(r, ts, x0, y0, 1) * w00 + texel(r, ts, x1, y0, 1) * w10 + texel(r, ts, x0, y1, 1) * w01 + texel(r, ts, x1, y1, 1) * w11,
        z: texel(r, ts, x0, y0, 2) * w00 + texel(r, ts, x1, y0, 2) * w10 + texel(r, ts, x0, y1, 2) * w01 + texel(r, ts, x1, y1, 2) * w11,
    }
}

fn fog_factor(r: *mut render_types.Renderer, depth: f64) -> f64 {
    if (*r).fog_on == false { return 0.0 }
    let span: f64 = (*r).fog_far - (*r).fog_near
    if span <= 0.0000001 { return 0.0 }
    return vec3.clamp01((depth - (*r).fog_near) / span)
}

fn shade_sample(r: *mut render_types.Renderer, t: *mut render_types.Tri, fx: f64, fy: f64, out: *mut render_types.Shade) {
    let l1: f64 = (*t).l1a * fx + (*t).l1b * fy + (*t).l1c
    let l2: f64 = (*t).l2a * fx + (*t).l2b * fy + (*t).l2c
    let l0: f64 = 1.0 - l1 - l2
    let a0: f64 = l0 * (*t).iw0
    let a1: f64 = l1 * (*t).iw1
    let a2: f64 = l2 * (*t).iw2
    var s: f64 = a0 + a1 + a2
    if s < 0.000000000001 { s = 0.000000000001 }
    let k: f64 = 1.0 / s
    let q0: f64 = a0 * k
    let q1: f64 = a1 * k
    let q2: f64 = a2 * k
    let px: f64 = q0 * (*t).p0.x + q1 * (*t).p1.x + q2 * (*t).p2.x
    let py: f64 = q0 * (*t).p0.y + q1 * (*t).p1.y + q2 * (*t).p2.y
    let pz: f64 = q0 * (*t).p0.z + q1 * (*t).p1.z + q2 * (*t).p2.z
    var nx: f64 = q0 * (*t).n0.x + q1 * (*t).n1.x + q2 * (*t).n2.x
    var ny: f64 = q0 * (*t).n0.y + q1 * (*t).n1.y + q2 * (*t).n2.y
    var nz: f64 = q0 * (*t).n0.z + q1 * (*t).n1.z + q2 * (*t).n2.z
    let nl2: f64 = nx * nx + ny * ny + nz * nz
    if nl2 < 0.000000000001 {
        nx = 0.0
        ny = 1.0
        nz = 0.0
    } else {
        let kn: f64 = 1.0 / math.sqrt(nl2)
        nx = nx * kn
        ny = ny * kn
        nz = nz * kn
    }
    if (*t).back {
        nx = 0.0 - nx
        ny = 0.0 - ny
        nz = 0.0 - nz
    }
    var vx: f64 = (*r).cam_x - px
    var vy: f64 = (*r).cam_y - py
    var vz: f64 = (*r).cam_z - pz
    var vl2: f64 = vx * vx + vy * vy + vz * vz
    if vl2 < 0.000000000001 { vl2 = 0.000000000001 }
    let kv: f64 = 1.0 / math.sqrt(vl2)
    vx = vx * kv
    vy = vy * kv
    vz = vz * kv
    var ndv: f64 = nx * vx + ny * vy + nz * vz
    if ndv < 0.0 { ndv = 0.0 }
    let mt: *mut material.Material = (*t).mat as *mut material.Material
    var ar: f64 = (*mt).color.x
    var ag: f64 = (*mt).color.y
    var ab: f64 = (*mt).color.z
    if (*t).tex != 0 as u64 {
        let tu: f64 = q0 * (*t).u0 + q1 * (*t).u1 + q2 * (*t).u2
        let tv: f64 = q0 * (*t).v0 + q1 * (*t).v1 + q2 * (*t).v2
        let tc: vec3.V3 = tex_sample(r, (*t).tex, tu, tv)
        ar = ar * tc.x
        ag = ag * tc.y
        ab = ab * tc.z
    }
    var alpha: f64 = (*t).alpha
    if alpha < 0.999 && (*mt).rim > 0.0 {
        let g: f64 = 1.0 - ndv
        alpha = alpha + (1.0 - alpha) * vec3.clamp01((*mt).rim * g * g)
    }
    (*out).alpha = alpha
    if (*mt).kind == material.MAT_UNLIT {
        (*out).dr = ar + (*mt).emissive.x
        (*out).dg = ag + (*mt).emissive.y
        (*out).db = ab + (*mt).emissive.z
        (*out).sr = 0.0
        (*out).sg = 0.0
        (*out).sb = 0.0
        return
    }
    let metal: f64 = (*mt).metal
    let rough: f64 = (*mt).rough
    let hemi: f64 = ny * 0.5 + 0.5
    var ir: f64 = (*r).hemi_ground.x + ((*r).hemi_sky.x - (*r).hemi_ground.x) * hemi + (*r).ambient.x
    var ig: f64 = (*r).hemi_ground.y + ((*r).hemi_sky.y - (*r).hemi_ground.y) * hemi + (*r).ambient.y
    var ib: f64 = (*r).hemi_ground.z + ((*r).hemi_sky.z - (*r).hemi_ground.z) * hemi + (*r).ambient.z
    var sr: f64 = 0.0
    var sg: f64 = 0.0
    var sb: f64 = 0.0
    var ke: i32 = 1 + (((1.0 - rough) * 7.0 + 0.5) as i32)
    if ke < 1 { ke = 1 }
    if ke > 8 { ke = 8 }
    let shin_norm: f64 = (((1 << ke) as f64) + 8.0) * 0.03125
    let lb: u64 = (*r).lights_blk
    var li: i32 = 0
    while li < (*r).nlights {
        let o: usize = (li as usize) * render_types.LIGHT_STRIDE
        li = li + 1
        let kind: f64 = render_types.ldf(lb, o)
        var lx: f64 = render_types.ldf(lb, o + 1)
        var ly: f64 = render_types.ldf(lb, o + 2)
        var lz: f64 = render_types.ldf(lb, o + 3)
        var att: f64 = 1.0
        if kind > 0.5 {
            let dx: f64 = lx - px
            let dy: f64 = ly - py
            let dz: f64 = lz - pz
            let d2: f64 = dx * dx + dy * dy + dz * dz
            let rng: f64 = render_types.ldf(lb, o + 7)
            let xr: f64 = d2 / (rng * rng)
            if xr >= 1.0 { continue }
            let dd: f64 = math.sqrt(d2) + 0.000000001
            lx = dx / dd
            ly = dy / dd
            lz = dz / dd
            att = (1.0 - xr) * (1.0 - xr)
        }
        let ndl: f64 = nx * lx + ny * ly + nz * lz
        if ndl <= 0.0 { continue }
        let cr: f64 = render_types.ldf(lb, o + 4) * att
        let cg: f64 = render_types.ldf(lb, o + 5) * att
        let cb: f64 = render_types.ldf(lb, o + 6) * att
        ir = ir + cr * ndl
        ig = ig + cg * ndl
        ib = ib + cb * ndl
        var hx: f64 = lx + vx
        var hy: f64 = ly + vy
        var hz: f64 = lz + vz
        let hl2: f64 = hx * hx + hy * hy + hz * hz
        if hl2 > 0.000000000001 {
            let kh: f64 = 1.0 / math.sqrt(hl2)
            hx = hx * kh
            hy = hy * kh
            hz = hz * kh
            var ndh: f64 = nx * hx + ny * hy + nz * hz
            if ndh > 0.0 {
                var j: i32 = 0
                while j < ke {
                    ndh = ndh * ndh
                    j = j + 1
                }
                let sp: f64 = ndh * shin_norm
                sr = sr + cr * sp
                sg = sg + cg * sp
                sb = sb + cb * sp
            }
        }
    }
    let spec: f64 = (*mt).spec
    let scr: f64 = spec + (ar - spec) * metal
    let scg: f64 = spec + (ag - spec) * metal
    let scb: f64 = spec + (ab - spec) * metal
    let dk: f64 = 1.0 - metal
    var dr: f64 = ar * dk * ir + (*mt).emissive.x
    var dg: f64 = ag * dk * ig + (*mt).emissive.y
    var db: f64 = ab * dk * ib + (*mt).emissive.z
    sr = sr * scr
    sg = sg * scg
    sb = sb * scb
    let wenv: f64 = (1.0 - rough) * (1.0 - rough)
    if wenv > 0.0001 {
        let ry: f64 = 2.0 * ndv * ny - vy
        let ev: f64 = vec3.clamp01(ry * 0.5 + 0.5)
        let g: f64 = 1.0 - ndv
        let g2: f64 = g * g
        let fp: f64 = g2 * g2 * g
        let f0r: f64 = 0.04 + (ar - 0.04) * metal
        let f0g: f64 = 0.04 + (ag - 0.04) * metal
        let f0b: f64 = 0.04 + (ab - 0.04) * metal
        let er: f64 = (*r).hemi_ground.x + ((*r).hemi_sky.x - (*r).hemi_ground.x) * ev
        let eg: f64 = (*r).hemi_ground.y + ((*r).hemi_sky.y - (*r).hemi_ground.y) * ev
        let eb: f64 = (*r).hemi_ground.z + ((*r).hemi_sky.z - (*r).hemi_ground.z) * ev
        sr = sr + er * (f0r + (1.0 - f0r) * fp) * wenv
        sg = sg + eg * (f0g + (1.0 - f0g) * fp) * wenv
        sb = sb + eb * (f0b + (1.0 - f0b) * fp) * wenv
    }
    (*out).dr = dr
    (*out).dg = dg
    (*out).db = db
    (*out).sr = sr
    (*out).sg = sg
    (*out).sb = sb
}
