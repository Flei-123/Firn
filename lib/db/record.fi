// SPDX-License-Identifier: MPL-2.0
// lib/db/record.fi -- SQL values and the SQLite record format.
//
// A `Val` is one SQL value: NULL, INTEGER (i64), REAL (f64), TEXT (UTF-8) or
// BLOB. TEXT and BLOB point at memory somebody else owns (a page of the
// cache, a row arena); a `Val` never frees anything.
//
// A record is how a row (or an index key) is stored:
//   header size (varint) | one serial type per column (varint) | the data
// serial type 0 NULL, 1..6 integers of 1,2,3,4,6,8 octets (big endian, two's
// complement), 7 float64 (big endian), 8 = 0, 9 = 1, N >= 12 even: BLOB of
// (N-12)/2 octets, N >= 13 odd: TEXT of (N-13)/2 octets.
//
// Ordering (what an index tree and ORDER BY use): NULL < numbers (INTEGER and
// REAL compared by value, exactly -- an INTEGER above 2^53 is not rounded)
// < TEXT (octet order, i.e. UTF-8 code point order) < BLOB (octet order).

import std.rt
import db.dberr
import db.util

export {
    Val, UKey, T_NULL, T_INT, T_REAL, T_TEXT, T_BLOB,
    val_null, val_int, val_real, val_text, val_blob,
    rec_size, rec_encode, rec_decode, rec_column_count, rec_column,
    val_compare, int_float_cmp, rec_compare_key, ukey_new,
    f64_of_bits, bits_of_f64, serial_len, serial_for_int,
    MAX_COLUMNS,
}

const T_NULL: i64 = 0
const T_INT: i64 = 1
const T_REAL: i64 = 2
const T_TEXT: i64 = 3
const T_BLOB: i64 = 4

const MAX_COLUMNS: usize = 2000

struct Val {
    t: i64,
    i: i64,
    f: f64,
    p: u64,
    n: usize,
}

// A search key for an index: the first `n` columns of a record, with a bit per
// column that says "descending" (a DESC index column compares reversed).
struct UKey {
    n: usize,
    desc: u64,
    vals: u64, // address of n Vals
}

fn ukey_new(vals: u64, n: usize, desc: u64) -> UKey {
    return UKey { n: n, desc: desc, vals: vals }
}

fn val_null() -> Val {
    return Val { t: 0, i: 0, f: 0.0, p: 0, n: 0 }
}

fn val_int(v: i64) -> Val {
    return Val { t: 1, i: v, f: 0.0, p: 0, n: 0 }
}

fn val_real(v: f64) -> Val {
    return Val { t: 2, i: 0, f: v, p: 0, n: 0 }
}

fn val_text(p: u64, n: usize) -> Val {
    return Val { t: 3, i: 0, f: 0.0, p: p, n: n }
}

fn val_blob(p: u64, n: usize) -> Val {
    return Val { t: 4, i: 0, f: 0.0, p: p, n: n }
}

fn f64_of_bits(b: u64) -> f64 {
    return __f64_from_bits(b)
}

fn bits_of_f64(x: f64) -> u64 {
    return __bits(x)
}

// octets of data for a serial type
fn serial_len(st: u64) -> usize {
    if st < 12 {
        if st == 0 || st == 8 || st == 9 {
            return 0
        }
        if st == 1 {
            return 1
        }
        if st == 2 {
            return 2
        }
        if st == 3 {
            return 3
        }
        if st == 4 {
            return 4
        }
        if st == 5 {
            return 6
        }
        return 8
    }
    if st % 2 == 0 {
        return ((st - 12) / 2) as usize
    }
    return ((st - 13) / 2) as usize
}

// the serial type of an INTEGER value (0 and 1 get the constant types)
fn serial_for_int(v: i64) -> u64 {
    if v == 0 {
        return 8
    }
    if v == 1 {
        return 9
    }
    if v >= -128 && v <= 127 {
        return 1
    }
    if v >= -32768 && v <= 32767 {
        return 2
    }
    if v >= -8388608 && v <= 8388607 {
        return 3
    }
    if v >= -2147483648 && v <= 2147483647 {
        return 4
    }
    if v >= -140737488355328 && v <= 140737488355327 {
        return 5
    }
    return 6
}

fn serial_of(v: *mut Val) -> u64 {
    let t: i64 = (*v).t
    if t == 0 {
        return 0
    }
    if t == 1 {
        return serial_for_int((*v).i)
    }
    if t == 2 {
        return 7
    }
    if t == 3 {
        return 13 + 2 * ((*v).n as u64)
    }
    return 12 + 2 * ((*v).n as u64)
}

// the number of octets `rec_encode` writes for these values
fn rec_size(vals: *mut Val, n: usize) -> usize {
    var hdr: usize = 0
    var data: usize = 0
    var i: usize = 0
    while i < n {
        let st: u64 = serial_of(vals + i)
        hdr = hdr + util.varint_len(st)
        data = data + serial_len(st)
        i = i + 1
    }
    // the header size counts its own varint (always one octet below 128)
    var total_hdr: usize = hdr + 1
    if total_hdr > 127 {
        total_hdr = hdr + 2
        if total_hdr > 16383 {
            total_hdr = hdr + 3
        }
    }
    return total_hdr + data
}

// Appends the record to `out`.
fn rec_encode(vals: *mut Val, n: usize, out: *mut rt.Buf) {
    var hdr: usize = 0
    var i: usize = 0
    while i < n {
        hdr = hdr + util.varint_len(serial_of(vals + i))
        i = i + 1
    }
    var total_hdr: usize = hdr + 1
    if total_hdr > 127 {
        total_hdr = hdr + 2
        if total_hdr > 16383 {
            total_hdr = hdr + 3
        }
    }
    let size: usize = rec_size(vals, n)
    let base: usize = rt.buf_len(out)
    rt.buf_reserve(out, base + size + 16)
    let p: u64 = rt.buf_ptr(out) + (base as u64)
    var off: usize = util.varint_put(p, total_hdr as u64)
    i = 0
    while i < n {
        off = off + util.varint_put(p + (off as u64), serial_of(vals + i))
        i = i + 1
    }
    i = 0
    while i < n {
        let v: *mut Val = vals + i
        let t: i64 = (*v).t
        if t == 1 {
            let st: u64 = serial_for_int((*v).i)
            let len: usize = serial_len(st)
            var x: u64 = (*v).i as u64
            var k: usize = len
            while k > 0 {
                k = k - 1
                rt.st8(p, off + k, (x & 255) as u8)
                x = x >> 8
            }
            off = off + len
        } else if t == 2 {
            util.wr64(p, off, bits_of_f64((*v).f))
            off = off + 8
        } else if t == 3 || t == 4 {
            util.move_bytes(p + (off as u64), (*v).p, (*v).n)
            off = off + (*v).n
        }
        i = i + 1
    }
    rt.buf_set_len(out, base + size)
}

// The number of columns in a record, or 0 if the header is damaged.
fn rec_column_count(p: u64, len: usize) -> usize {
    var hs: u64 = 0
    let c: usize = util.varint_get(p, len, &hs)
    if c == 0 || hs > (len as u64) || (hs as usize) < c {
        return 0
    }
    var off: usize = c
    var n: usize = 0
    while off < (hs as usize) {
        var st: u64 = 0
        let k: usize = util.varint_get(p + (off as u64), (hs as usize) - off, &st)
        if k == 0 {
            return 0
        }
        off = off + k
        n = n + 1
    }
    return n
}

fn load_int(p: u64, len: usize) -> i64 {
    var x: u64 = 0
    var i: usize = 0
    if len > 0 && rt.ld8(p, 0) >= 128 as u8 {
        x = 18446744073709551615
    }
    while i < len {
        x = (x << 8) | (rt.ld8(p, i) as u64)
        i = i + 1
    }
    return x as i64
}

// Decodes up to `maxn` columns into `out`; TEXT/BLOB point INTO the record.
// The answer is the number of columns decoded (the record may have more).
fn rec_decode(p: u64, len: usize, out: *mut Val, maxn: usize) -> DbError!usize {
    var hs: u64 = 0
    let c: usize = util.varint_get(p, len, &hs)
    if c == 0 || hs > (len as u64) || (hs as usize) < c {
        return dberr.fail(DbError::Corrupt, "malformed record header")
    }
    var hoff: usize = c
    var doff: usize = hs as usize
    var n: usize = 0
    while hoff < (hs as usize) && n < maxn {
        var st: u64 = 0
        let k: usize = util.varint_get(p + (hoff as u64), (hs as usize) - hoff, &st)
        if k == 0 {
            return dberr.fail(DbError::Corrupt, "malformed record header")
        }
        hoff = hoff + k
        let sl: usize = serial_len(st)
        if st == 10 || st == 11 || doff + sl > len {
            return dberr.fail(DbError::Corrupt, "record data runs past the end of the payload")
        }
        let v: *mut Val = out + n
        if st == 0 {
            *v = val_null()
        } else if st == 8 {
            *v = val_int(0)
        } else if st == 9 {
            *v = val_int(1)
        } else if st < 7 {
            *v = val_int(load_int(p + (doff as u64), sl))
        } else if st == 7 {
            var f: f64 = f64_of_bits(util.rd64(p, doff))
            if f != f {
                *v = val_null()
            } else {
                *v = val_real(f)
            }
        } else if st % 2 == 0 {
            *v = val_blob(p + (doff as u64), sl)
        } else {
            *v = val_text(p + (doff as u64), sl)
        }
        doff = doff + sl
        n = n + 1
    }
    return n
}

// One column of a record (NULL if the record has fewer columns).
fn rec_column(p: u64, len: usize, col: usize) -> DbError!Val {
    var tmp: [Val; 1] = [val_null()]
    var hs: u64 = 0
    let c: usize = util.varint_get(p, len, &hs)
    if c == 0 || hs > (len as u64) || (hs as usize) < c {
        return dberr.fail(DbError::Corrupt, "malformed record header")
    }
    var hoff: usize = c
    var doff: usize = hs as usize
    var n: usize = 0
    while hoff < (hs as usize) {
        var st: u64 = 0
        let k: usize = util.varint_get(p + (hoff as u64), (hs as usize) - hoff, &st)
        if k == 0 {
            return dberr.fail(DbError::Corrupt, "malformed record header")
        }
        hoff = hoff + k
        let sl: usize = serial_len(st)
        if n == col {
            if st == 10 || st == 11 || doff + sl > len {
                return dberr.fail(DbError::Corrupt, "record data runs past the end of the payload")
            }
            if st == 0 {
                return val_null()
            }
            if st == 8 {
                return val_int(0)
            }
            if st == 9 {
                return val_int(1)
            }
            if st < 7 {
                return val_int(load_int(p + (doff as u64), sl))
            }
            if st == 7 {
                let f: f64 = f64_of_bits(util.rd64(p, doff))
                if f != f {
                    return val_null()
                }
                return val_real(f)
            }
            if st % 2 == 0 {
                return val_blob(p + (doff as u64), sl)
            }
            return val_text(p + (doff as u64), sl)
        }
        doff = doff + sl
        n = n + 1
    }
    return val_null()
}

// INTEGER against REAL, exactly: -1, 0, 1
fn int_float_cmp(i: i64, r: f64) -> i64 {
    if r < -9223372036854775808.0 {
        return 1
    }
    if r >= 9223372036854775808.0 {
        return -1
    }
    let y: i64 = r as i64
    if i < y {
        return -1
    }
    if i > y {
        return 1
    }
    let x: f64 = i as f64
    if x < r {
        return -1
    }
    if x > r {
        return 1
    }
    return 0
}

fn class_of(t: i64) -> i64 {
    if t == 0 {
        return 0
    }
    if t == 1 || t == 2 {
        return 1
    }
    if t == 3 {
        return 2
    }
    return 3
}

// The order of two values: -1, 0, 1 (NULL equals NULL here: this is the
// order of a sort or an index, not the SQL `=`)
fn val_compare(a: *mut Val, b: *mut Val) -> i64 {
    let ca: i64 = class_of((*a).t)
    let cb: i64 = class_of((*b).t)
    if ca != cb {
        if ca < cb {
            return -1
        }
        return 1
    }
    if ca == 0 {
        return 0
    }
    if ca == 1 {
        if (*a).t == 1 && (*b).t == 1 {
            if (*a).i < (*b).i {
                return -1
            }
            if (*a).i > (*b).i {
                return 1
            }
            return 0
        }
        if (*a).t == 2 && (*b).t == 2 {
            if (*a).f < (*b).f {
                return -1
            }
            if (*a).f > (*b).f {
                return 1
            }
            return 0
        }
        if (*a).t == 1 {
            return int_float_cmp((*a).i, (*b).f)
        }
        return 0 - int_float_cmp((*b).i, (*a).f)
    }
    return util.bytes_compare((*a).p, (*a).n, (*b).p, (*b).n)
}

// Compares the record at (p, len) with the key over the key's first n
// columns, honouring the DESC bits: negative if the record sorts BEFORE
// the key, 0 if its first n columns equal the key, positive if after.
fn rec_compare_key(p: u64, len: usize, key: *mut UKey) -> DbError!i64 {
    var hs: u64 = 0
    let c: usize = util.varint_get(p, len, &hs)
    if c == 0 || hs > (len as u64) || (hs as usize) < c {
        return dberr.fail(DbError::Corrupt, "malformed record header")
    }
    var hoff: usize = c
    var doff: usize = hs as usize
    var i: usize = 0
    let kn: usize = (*key).n
    while i < kn {
        var cur: Val = val_null()
        if hoff < (hs as usize) {
            var st: u64 = 0
            let k: usize = util.varint_get(p + (hoff as u64), (hs as usize) - hoff, &st)
            if k == 0 {
                return dberr.fail(DbError::Corrupt, "malformed record header")
            }
            hoff = hoff + k
            let sl: usize = serial_len(st)
            if st == 10 || st == 11 || doff + sl > len {
                return dberr.fail(DbError::Corrupt, "record data runs past the end of the payload")
            }
            if st == 0 {
                cur = val_null()
            } else if st == 8 {
                cur = val_int(0)
            } else if st == 9 {
                cur = val_int(1)
            } else if st < 7 {
                cur = val_int(load_int(p + (doff as u64), sl))
            } else if st == 7 {
                let f: f64 = f64_of_bits(util.rd64(p, doff))
                if f != f {
                    cur = val_null()
                } else {
                    cur = val_real(f)
                }
            } else if st % 2 == 0 {
                cur = val_blob(p + (doff as u64), sl)
            } else {
                cur = val_text(p + (doff as u64), sl)
            }
            doff = doff + sl
        }
        let kv: *mut Val = ((*key).vals as *mut Val) + i
        var r: i64 = val_compare(&cur, kv)
        if r != 0 {
            if ((*key).desc >> (i as u64)) & 1 == 1 {
                r = 0 - r
            }
            return r
        }
        i = i + 1
    }
    return 0
}
