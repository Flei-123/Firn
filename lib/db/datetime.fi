// SPDX-License-Identifier: MPL-2.0
// lib/db/datetime.fi -- date() time() datetime() julianday() unixepoch() strftime(), and
// CURRENT_DATE / CURRENT_TIME / CURRENT_TIMESTAMP: a port of the algorithms of SQLite's date.c
// (the same Julian day arithmetic in milliseconds, the same time string forms and modifiers),
// so the same string gives the same answer.
//
// TIME STRINGS: YYYY-MM-DD, YYYY-MM-DD HH:MM[:SS[.SSS]] (also with a T), HH:MM[:SS[.SSS]],
// each with an optional Z or +HH:MM / -HH:MM, "now", a number (Julian day, or Unix seconds
// with the 'unixepoch' modifier).
// MODIFIERS: [+-]NNN days|hours|minutes|seconds|months|years, [+-]HH:MM[:SS[.SSS]],
// start of month|year|day, weekday N, unixepoch, julianday, auto, localtime, utc.
// strftime: %d %f %H %j %J %m %M %s %S %w %W %Y %%  (what SQLite 3.40 has).
//
// HONEST (T1) "now" is the clock at the START of the statement, the same value everywhere
// inside it (SQLite does the same). (T2) localtime / utc use the zone of the machine through
// std.time (TZif files); with none they are UTC. (T3) A year outside 0000..9999 is an error
// (NULL), as in SQLite.

import std.rt
import std.time
import db.record as rc
import db.value as vl
import db.arena as ar
import db.dbcore as dc

export { date_func, DT_DATE, DT_TIME, DT_DATETIME, DT_JULIAN, DT_STRFTIME, DT_UNIXEPOCH }

const DT_DATE: u32 = 1
const DT_TIME: u32 = 2
const DT_DATETIME: u32 = 3
const DT_JULIAN: u32 = 4
const DT_STRFTIME: u32 = 5
const DT_UNIXEPOCH: u32 = 6

struct DT {
    ijd: i64,
    y: i64,
    m: i64,
    d: i64,
    h: i64,
    mi: i64,
    s: f64,
    tz: i64,
    valid_jd: bool,
    valid_ymd: bool,
    valid_hms: bool,
    raw_s: bool,
    tz_set: bool,
    is_error: bool,
}

fn dt_blank() -> DT {
    return DT { ijd: 0, y: 0, m: 0, d: 0, h: 0, mi: 0, s: 0.0, tz: 0, valid_jd: false, valid_ymd: false,
        valid_hms: false, raw_s: false, tz_set: false, is_error: false }
}

fn is_space(c: u8) -> bool {
    return c == 32 as u8 || c == 9 as u8 || c == 10 as u8 || c == 11 as u8 || c == 12 as u8 || c == 13 as u8
}

fn is_digit(c: u8) -> bool {
    return c >= 48 as u8 && c <= 57 as u8
}

fn at(p: u64, n: usize, i: usize) -> u8 {
    if i >= n {
        return 0 as u8
    }
    return rt.ld8(p, i)
}

// `ndig` digits with the value in [mn, mx]; the answer is the value or -1
fn digits(p: u64, n: usize, pos: usize, ndig: usize, mn: i64, mx: i64) -> i64 {
    var v: i64 = 0
    var i: usize = 0
    while i < ndig {
        let c: u8 = at(p, n, pos + i)
        if !is_digit(c) {
            return -1
        }
        v = v * 10 + ((c as i64) - 48)
        i = i + 1
    }
    if v < mn || v > mx {
        return -1
    }
    return v
}

fn valid_jd(ijd: i64) -> bool {
    return ijd >= 0 && ijd <= 464269060799999
}

fn compute_jd(x: *mut DT) {
    if (*x).valid_jd {
        return
    }
    var y: i64 = 2000
    var m: i64 = 1
    var d: i64 = 1
    if (*x).valid_ymd {
        y = (*x).y
        m = (*x).m
        d = (*x).d
    }
    if y < -4713 || y > 9999 || (*x).raw_s {
        (*x).is_error = true
        return
    }
    if m <= 2 {
        y = y - 1
        m = m + 12
    }
    let a: i64 = y / 100
    let b: i64 = 2 - a + (a / 4)
    let x1: i64 = 36525 * (y + 4716) / 100
    let x2: i64 = 306001 * (m + 1) / 10000
    let jd: f64 = ((x1 + x2 + d + b) as f64 - 1524.5) * 86400000.0
    (*x).ijd = jd as i64
    (*x).valid_jd = true
    if (*x).valid_hms {
        (*x).ijd = (*x).ijd + (*x).h * 3600000 + (*x).mi * 60000 + (((*x).s * 1000.0 + 0.5) as i64)
        if (*x).tz_set {
            (*x).ijd = (*x).ijd - (*x).tz * 60000
            (*x).valid_ymd = false
            (*x).valid_hms = false
            (*x).tz_set = false
        }
    }
}

fn compute_ymd(x: *mut DT) {
    if (*x).valid_ymd {
        return
    }
    if !(*x).valid_jd {
        (*x).y = 2000
        (*x).m = 1
        (*x).d = 1
    } else if !valid_jd((*x).ijd) {
        (*x).is_error = true
    } else {
        // a raw number that is a valid Julian day has become a date
        (*x).raw_s = false
        let z: i64 = ((*x).ijd + 43200000) / 86400000
        var a: i64 = ((z as f64 - 1867216.25) / 36524.25) as i64
        a = z + 1 + a - (a / 4)
        let b: i64 = a + 1524
        let c: i64 = ((b as f64 - 122.1) / 365.25) as i64
        var dd: i64 = (36525 * (c & 32767)) / 100
        let e: i64 = ((b - dd) as f64 / 30.6001) as i64
        let x1: i64 = (30.6001 * (e as f64)) as i64
        (*x).d = b - dd - x1
        if e < 14 {
            (*x).m = e - 1
        } else {
            (*x).m = e - 13
        }
        if (*x).m > 2 {
            (*x).y = c - 4716
        } else {
            (*x).y = c - 4715
        }
    }
    (*x).valid_ymd = true
}

fn compute_hms(x: *mut DT) {
    if (*x).valid_hms {
        return
    }
    compute_jd(x)
    let day_ms: i64 = ((*x).ijd + 43200000) % 86400000
    (*x).s = ((day_ms % 60000) as f64) / 1000.0
    let day_min: i64 = day_ms / 60000
    (*x).h = day_min / 60
    (*x).mi = day_min % 60
    (*x).valid_hms = true
}

fn compute_ymd_hms(x: *mut DT) {
    compute_ymd(x)
    compute_hms(x)
}

fn clear_ymd_hms_tz(x: *mut DT) {
    (*x).valid_ymd = false
    (*x).valid_hms = false
    (*x).tz_set = false
}

// zone suffix; true if the text ends there (after it)
fn parse_tz(p: u64, n: usize, pos: usize, x: *mut DT) -> bool {
    var i: usize = pos
    while is_space(at(p, n, i)) {
        i = i + 1
    }
    (*x).tz = 0
    let c: u8 = at(p, n, i)
    var sgn: i64 = 0
    if c == 45 as u8 {
        sgn = -1
    } else if c == 43 as u8 {
        sgn = 1
    } else if c == 90 as u8 || c == 122 as u8 {
        i = i + 1
        while is_space(at(p, n, i)) {
            i = i + 1
        }
        (*x).tz_set = true
        return i >= n
    } else {
        return c == 0 as u8 && i >= n
    }
    i = i + 1
    let hh: i64 = digits(p, n, i, 2, 0, 14)
    if hh < 0 || at(p, n, i + 2) != 58 as u8 {
        return false
    }
    let mm: i64 = digits(p, n, i + 3, 2, 0, 59)
    if mm < 0 {
        return false
    }
    i = i + 5
    (*x).tz = sgn * (mm + hh * 60)
    while is_space(at(p, n, i)) {
        i = i + 1
    }
    (*x).tz_set = true
    return i >= n
}

// HH:MM[:SS[.SSS]][zone] at `pos`; true on success (the text must end)
fn parse_hms(p: u64, n: usize, pos: usize, x: *mut DT) -> bool {
    let h: i64 = digits(p, n, pos, 2, 0, 24)
    if h < 0 || at(p, n, pos + 2) != 58 as u8 {
        return false
    }
    let m: i64 = digits(p, n, pos + 3, 2, 0, 59)
    if m < 0 {
        return false
    }
    var i: usize = pos + 5
    var s: i64 = 0
    var ms: f64 = 0.0
    if at(p, n, i) == 58 as u8 {
        i = i + 1
        s = digits(p, n, i, 2, 0, 59)
        if s < 0 {
            return false
        }
        i = i + 2
        if at(p, n, i) == 46 as u8 && is_digit(at(p, n, i + 1)) {
            var scale: f64 = 1.0
            i = i + 1
            while is_digit(at(p, n, i)) {
                ms = ms * 10.0 + ((at(p, n, i) as i64) - 48) as f64
                scale = scale * 10.0
                i = i + 1
            }
            ms = ms / scale
        }
    }
    (*x).valid_jd = false
    (*x).raw_s = false
    (*x).valid_hms = true
    (*x).h = h
    (*x).mi = m
    (*x).s = (s as f64) + ms
    return parse_tz(p, n, i, x)
}

fn parse_ymd(p: u64, n: usize, x: *mut DT) -> bool {
    var i: usize = 0
    var neg: bool = false
    if at(p, n, 0) == 45 as u8 {
        neg = true
        i = 1
    }
    let y: i64 = digits(p, n, i, 4, 0, 14712)
    if y < 0 || at(p, n, i + 4) != 45 as u8 {
        return false
    }
    let mo: i64 = digits(p, n, i + 5, 2, 1, 12)
    if mo < 0 || at(p, n, i + 7) != 45 as u8 {
        return false
    }
    let d: i64 = digits(p, n, i + 8, 2, 1, 31)
    if d < 0 {
        return false
    }
    i = i + 10
    while is_space(at(p, n, i)) || at(p, n, i) == 84 as u8 {
        i = i + 1
    }
    if parse_hms(p, n, i, x) {
        // got the time
    } else if i >= n {
        (*x).valid_hms = false
    } else {
        return false
    }
    (*x).valid_jd = false
    (*x).valid_ymd = true
    if neg {
        (*x).y = 0 - y
    } else {
        (*x).y = y
    }
    (*x).m = mo
    (*x).d = d
    if (*x).tz_set {
        compute_jd(x)
    }
    return true
}

fn set_raw_number(x: *mut DT, r: f64) {
    (*x).s = r
    (*x).raw_s = true
    if r >= 0.0 && r < 5373484.5 {
        (*x).ijd = (r * 86400000.0 + 0.5) as i64
        (*x).valid_jd = true
    }
}

fn set_now(x: *mut DT, db: *mut dc.Db) {
    var ms: i64 = (*db).now_ms
    if ms == 0 {
        ms = time.now_unix_ms()
        (*db).now_ms = ms
    }
    (*x).ijd = ms + 210866760000000
    (*x).valid_jd = true
}

fn eq_ci(p: u64, n: usize, w: str) -> bool {
    if n != w.length() {
        return false
    }
    var i: usize = 0
    while i < n {
        var c: u8 = rt.ld8(p, i)
        if c >= 65 as u8 && c <= 90 as u8 {
            c = c + 32 as u8
        }
        if c != w.chars(i) {
            return false
        }
        i = i + 1
    }
    return true
}

// the text form of a time string, or the number of the first argument
fn parse_value(v: *mut rc.Val, x: *mut DT, db: *mut dc.Db) -> bool {
    if (*v).t == 1 {
        set_raw_number(x, (*v).i as f64)
        return true
    }
    if (*v).t == 2 {
        set_raw_number(x, (*v).f)
        return true
    }
    if (*v).t != 3 && (*v).t != 4 {
        return false
    }
    let p: u64 = (*v).p
    let n: usize = (*v).n
    if parse_ymd(p, n, x) {
        return true
    }
    *x = dt_blank()
    if parse_hms(p, n, 0, x) {
        return true
    }
    *x = dt_blank()
    if eq_ci(p, n, "now") {
        set_now(x, db)
        return true
    }
    var num: rc.Val = rc.val_null()
    var full: bool = false
    let k: i64 = vl.parse_num(p, n, &num, &full)
    if k != 0 && full {
        if k == 1 {
            set_raw_number(x, num.i as f64)
        } else {
            set_raw_number(x, num.f)
        }
        return true
    }
    return false
}

fn local_offset_ms(ijd: i64) -> i64 {
    let unix_ms: i64 = ijd - 210866760000000
    let off: i32 = time.local_offset_min(unix_ms) catch 0
    return (off as i64) * 60000
}

// apply a modifier; true if it was understood
fn parse_modifier(p: u64, n: usize, x: *mut DT, idx: usize) -> bool {
    var buf: [u8; 32] = [0; 32]
    if n >= 30 {
        return false
    }
    var i: usize = 0
    while i < n {
        var c: u8 = rt.ld8(p, i)
        if c >= 65 as u8 && c <= 90 as u8 {
            c = c + 32 as u8
        }
        buf[i] = c
        i = i + 1
    }
    let z: u64 = (&buf[0]) as u64
    let c0: u8 = buf[0]
    if c0 == 97 as u8 && eq_ci(p, n, "auto") {
        if idx > 1 {
            return false
        }
        if !(*x).raw_s || (*x).valid_jd {
            (*x).raw_s = false
            return true
        }
        if (*x).s >= -210866760000.0 && (*x).s <= 253402300799.0 {
            let r: f64 = (*x).s * 1000.0 + 210866760000000.0
            clear_ymd_hms_tz(x)
            (*x).ijd = (r + 0.5) as i64
            (*x).valid_jd = true
            (*x).raw_s = false
            return true
        }
        return false
    }
    if c0 == 106 as u8 && eq_ci(p, n, "julianday") {
        if idx > 1 {
            return false
        }
        if (*x).raw_s && (*x).valid_jd {
            (*x).raw_s = false
            return true
        }
        return false
    }
    if c0 == 108 as u8 && eq_ci(p, n, "localtime") {
        compute_jd(x)
        let off: i64 = local_offset_ms((*x).ijd)
        clear_ymd_hms_tz(x)
        (*x).ijd = (*x).ijd + off
        return true
    }
    if c0 == 117 as u8 && eq_ci(p, n, "unixepoch") {
        if idx > 1 {
            return false
        }
        if (*x).raw_s {
            let r: f64 = (*x).s * 1000.0 + 210866760000000.0
            if r >= 0.0 && r < 464269060800000.0 {
                clear_ymd_hms_tz(x)
                (*x).ijd = (r + 0.5) as i64
                (*x).valid_jd = true
                (*x).raw_s = false
                return true
            }
        }
        return false
    }
    if c0 == 117 as u8 && eq_ci(p, n, "utc") {
        compute_jd(x)
        let off: i64 = local_offset_ms((*x).ijd)
        clear_ymd_hms_tz(x)
        (*x).ijd = (*x).ijd - off
        return true
    }
    if c0 == 119 as u8 && n > 8 && buf[1] == 101 as u8 && buf[2] == 101 as u8 && buf[3] == 107 as u8 && buf[4] == 100 as u8
    && buf[5] == 97 as u8 && buf[6] == 121 as u8 && buf[7] == 32 as u8 {
        // weekday N
        var num: rc.Val = rc.val_null()
        var full: bool = false
        let k: i64 = vl.parse_num(z + 8, n - 8, &num, &full)
        if k == 0 || !full {
            return false
        }
        var r: f64 = 0.0
        if k == 1 {
            r = num.i as f64
        } else {
            r = num.f
        }
        let w: i64 = r as i64
        if (w as f64) != r || w < 0 || w > 6 {
            return false
        }
        compute_ymd_hms(x)
        (*x).tz_set = false
        (*x).valid_jd = false
        compute_jd(x)
        var zz: i64 = (((*x).ijd + 129600000) / 86400000) % 7
        if zz > w {
            zz = zz - 7
        }
        (*x).ijd = (*x).ijd + (w - zz) * 86400000
        clear_ymd_hms_tz(x)
        return true
    }
    if c0 == 115 as u8 && n > 9 && buf[1] == 116 as u8 && buf[2] == 97 as u8 && buf[3] == 114 as u8 && buf[4] == 116 as u8
    && buf[5] == 32 as u8 && buf[6] == 111 as u8 && buf[7] == 102 as u8 && buf[8] == 32 as u8 {
        // start of month|year|day
        if !valid_jd((*x).ijd) && (*x).valid_jd {
            return false
        }
        compute_ymd_hms(x)
        (*x).valid_hms = true
        (*x).h = 0
        (*x).mi = 0
        (*x).s = 0.0
        (*x).raw_s = false
        (*x).tz_set = false
        (*x).valid_jd = false
        let rest: u64 = z + 9
        let rn: usize = n - 9
        if rn == 5 && buf[9] == 109 as u8 && buf[10] == 111 as u8 && buf[11] == 110 as u8 && buf[12] == 116 as u8 && buf[13] == 104 as u8 {
            (*x).d = 1
            return true
        }
        if rn == 4 && buf[9] == 121 as u8 && buf[10] == 101 as u8 && buf[11] == 97 as u8 && buf[12] == 114 as u8 {
            (*x).m = 1
            (*x).d = 1
            return true
        }
        if rn == 3 && buf[9] == 100 as u8 && buf[10] == 97 as u8 && buf[11] == 121 as u8 {
            return true
        }
        return false
    }
    // [+-]NNN unit   or   [+-]HH:MM[:SS[.SSS]]
    if c0 == 43 as u8 || c0 == 45 as u8 || is_digit(c0) {
        var m: usize = 1
        while m < n && buf[m] != 58 as u8 && !is_space(buf[m]) {
            m = m + 1
        }
        var num: rc.Val = rc.val_null()
        var full: bool = false
        let k: i64 = vl.parse_num(z, m, &num, &full)
        if k == 0 || !full {
            return false
        }
        var r: f64 = 0.0
        if k == 1 {
            r = num.i as f64
        } else {
            r = num.f
        }
        if m < n && buf[m] == 58 as u8 {
            // a time to add
            var tx: DT = dt_blank()
            var off: usize = 0
            var sign: i64 = 1
            if c0 == 45 as u8 {
                sign = -1
                off = 1
            } else if c0 == 43 as u8 {
                off = 1
            }
            if !parse_hms(z, n, off, &tx) {
                return false
            }
            compute_jd(x)
            // the time of day as milliseconds
            let ms: i64 = tx.h * 3600000 + tx.mi * 60000 + ((tx.s * 1000.0 + 0.5) as i64)
            (*x).ijd = (*x).ijd + sign * ms
            clear_ymd_hms_tz(x)
            return true
        }
        var q: usize = m
        while q < n && is_space(buf[q]) {
            q = q + 1
        }
        var un: usize = n - q
        if un > 10 || un < 3 {
            return false
        }
        if buf[q + un - 1] == 115 as u8 {
            un = un - 1
        }
        compute_jd(x)
        let rounder: f64 = if r < 0.0 { -0.5 } else { 0.5 }
        let unit: u64 = z + (q as u64)
        var kind: i64 = -1
        var limit: f64 = 0.0
        var xform: f64 = 0.0
        if un == 6 && buf[q] == 115 as u8 && buf[q + 1] == 101 as u8 && buf[q + 2] == 99 as u8 && buf[q + 3] == 111 as u8 && buf[q + 4] == 110 as u8 && buf[q + 5] == 100 as u8 {
            kind = 0
            limit = 4.6427e+14
            xform = 1000.0
        } else if un == 6 && buf[q] == 109 as u8 && buf[q + 1] == 105 as u8 && buf[q + 2] == 110 as u8 && buf[q + 3] == 117 as u8 && buf[q + 4] == 116 as u8 && buf[q + 5] == 101 as u8 {
            kind = 1
            limit = 7.7379e+12
            xform = 60000.0
        } else if un == 4 && buf[q] == 104 as u8 && buf[q + 1] == 111 as u8 && buf[q + 2] == 117 as u8 && buf[q + 3] == 114 as u8 {
            kind = 2
            limit = 1.2897e+11
            xform = 3600000.0
        } else if un == 3 && buf[q] == 100 as u8 && buf[q + 1] == 97 as u8 && buf[q + 2] == 121 as u8 {
            kind = 3
            limit = 5373485.0
            xform = 86400000.0
        } else if un == 5 && buf[q] == 109 as u8 && buf[q + 1] == 111 as u8 && buf[q + 2] == 110 as u8 && buf[q + 3] == 116 as u8 && buf[q + 4] == 104 as u8 {
            kind = 4
            limit = 176546.0
            xform = 2592000000.0
        } else if un == 4 && buf[q] == 121 as u8 && buf[q + 1] == 101 as u8 && buf[q + 2] == 97 as u8 && buf[q + 3] == 114 as u8 {
            kind = 5
            limit = 14713.0
            xform = 31536000000.0
        }
        if kind < 0 || !(r > 0.0 - limit && r < limit) {
            return false
        }
        if kind == 4 {
            compute_ymd_hms(x)
            (*x).m = (*x).m + (r as i64)
            var xx: i64 = 0
            if (*x).m > 0 {
                xx = ((*x).m - 1) / 12
            } else {
                xx = ((*x).m - 12) / 12
            }
            (*x).y = (*x).y + xx
            (*x).m = (*x).m - xx * 12
            (*x).valid_jd = false
            r = r - ((r as i64) as f64)
        } else if kind == 5 {
            let yy: i64 = r as i64
            compute_ymd_hms(x)
            (*x).y = (*x).y + yy
            (*x).valid_jd = false
            r = r - (yy as f64)
        }
        compute_jd(x)
        (*x).ijd = (*x).ijd + ((r * xform + rounder) as i64)
        clear_ymd_hms_tz(x)
        return true
    }
    return false
}

// all arguments to one DT; false = the answer is NULL
fn args_to_dt(db: *mut dc.Db, args: *mut rc.Val, argc: usize, first: usize, x: *mut DT) -> bool {
    *x = dt_blank()
    if argc <= first {
        set_now(x, db)
    } else {
        if !parse_value(args + first, x, db) {
            return false
        }
        var i: usize = first + 1
        while i < argc {
            let a: *mut rc.Val = args + i
            if (*a).t != 3 && (*a).t != 4 {
                return false
            }
            if !parse_modifier((*a).p, (*a).n, x, i - first) {
                return false
            }
            i = i + 1
        }
    }
    compute_jd(x)
    if (*x).is_error || !valid_jd((*x).ijd) {
        return false
    }
    // a raw number has become a time: the later conversions (the day of the year) may start from it
    (*x).raw_s = false
    return true
}

// "%.16g" of a Julian day. A value of seven integer digits (every date from the year 0 to 9999)
// has nine decimals; they are cut from the EXACT binary value with integer arithmetic (rounded to
// nearest, ties to even, like printf), so the last digit is right. Other values: the shortest form.
fn put_julian(b: *mut rt.Buf, v: f64) {
    if v >= 1000000.0 && v < 10000000.0 {
        let bits: u64 = rc.bits_of_f64(v)
        let e: u64 = (bits >> 52) & 2047
        let m: u64 = (bits & 4503599627370495) | 4503599627370496
        let shift: u64 = 1075 - e
        var whole: u64 = m >> shift
        let fnum: u64 = m & ((1 << shift) - 1)
        let t: u64 = fnum * 1000000000
        var q: u64 = t >> shift
        let r: u64 = t & ((1 << shift) - 1)
        let half: u64 = 1 << (shift - 1)
        if r > half || (r == half && (q & 1) == 1) {
            q = q + 1
        }
        if q >= 1000000000 {
            q = q - 1000000000
            whole = whole + 1
        }
        rt.buf_push_dec_u64(b, whole)
        if q != 0 {
            var digs: [u8; 9] = [48; 9]
            var i: usize = 9
            var z: u64 = q
            while i > 0 {
                i = i - 1
                digs[i] = (48 + z % 10) as u8
                z = z / 10
            }
            var last: usize = 9
            while last > 0 && digs[last - 1] == 48 as u8 {
                last = last - 1
            }
            rt.buf_push(b, 46 as u8)
            var k: usize = 0
            while k < last {
                rt.buf_push(b, digs[k])
                k = k + 1
            }
        }
        return
    }
    vl.fmt_g16(b, v)
}

// "%04d" of a year: a minus sign counts into the width (-001)
fn put_year(b: *mut rt.Buf, y: i64) {
    if y < 0 {
        rt.buf_push(b, 45 as u8)
        put_n(b, 0 - y, 3)
    } else {
        put_n(b, y, 4)
    }
}

fn put2(b: *mut rt.Buf, v: i64) {
    if v < 10 {
        rt.buf_push(b, 48 as u8)
    }
    rt.buf_push_dec_i64(b, v)
}

fn put_n(b: *mut rt.Buf, v: i64, width: usize) {
    var digits: usize = 1
    var t: i64 = v
    while t >= 10 {
        t = t / 10
        digits = digits + 1
    }
    var z: usize = digits
    while z < width {
        rt.buf_push(b, 48 as u8)
        z = z + 1
    }
    rt.buf_push_dec_i64(b, v)
}

// kind: DT_*; `args` are the SQL arguments. Answers false for NULL.
fn date_func(db: *mut dc.Db, kind: u32, args: *mut rc.Val, argc: usize, a: *mut ar.Arena, out: *mut rc.Val) -> bool {
    var x: DT = dt_blank()
    var first: usize = 0
    if kind == DT_STRFTIME {
        first = 1
        if (*args).t == 0 {
            return false
        }
    }
    // a NULL time value gives NULL
    if argc > first && (*(args + first)).t == 0 {
        return false
    }
    if !args_to_dt(db, args, argc, first, &x) {
        return false
    }
    var b: rt.Buf = rt.buf_new()
    if kind == DT_JULIAN {
        rt.buf_free(&b)
        *out = rc.val_real((x.ijd as f64) / 86400000.0)
        return true
    }
    if kind == DT_UNIXEPOCH {
        rt.buf_free(&b)
        *out = rc.val_int(x.ijd / 1000 - 210866760000)
        return true
    }
    compute_ymd_hms(&x)
    if x.is_error {
        rt.buf_free(&b)
        return false
    }
    if kind == DT_DATE || kind == DT_DATETIME {
        if x.y < 0 {
            rt.buf_push(&b, 45 as u8)
            put_n(&b, 0 - x.y, 4)
        } else {
            put_n(&b, x.y, 4)
        }
        rt.buf_push(&b, 45 as u8)
        put2(&b, x.m)
        rt.buf_push(&b, 45 as u8)
        put2(&b, x.d)
    }
    if kind == DT_DATETIME {
        rt.buf_push(&b, 32 as u8)
    }
    if kind == DT_TIME || kind == DT_DATETIME {
        put2(&b, x.h)
        rt.buf_push(&b, 58 as u8)
        put2(&b, x.mi)
        rt.buf_push(&b, 58 as u8)
        put2(&b, x.s as i64)
    }
    if kind == DT_STRFTIME {
        let f: *mut rc.Val = args
        var fmt: rc.Val = rc.val_null()
        vl.val_to_text(f, a, &fmt)
        var i: usize = 0
        while i < fmt.n {
            let c: u8 = rt.ld8(fmt.p, i)
            if c != 37 as u8 {
                rt.buf_push(&b, c)
                i = i + 1
                continue
            }
            i = i + 1
            if i >= fmt.n {
                rt.buf_free(&b)
                return false
            }
            let k: u8 = rt.ld8(fmt.p, i)
            i = i + 1
            if k == 100 as u8 {
                put2(&b, x.d)
            } else if k == 102 as u8 {
                // seconds with three decimals: %06.3f
                var sec: f64 = x.s
                if sec > 59.999 {
                    sec = 59.999
                }
                let ms: i64 = (sec * 1000.0 + 0.5) as i64
                put_n(&b, ms / 1000, 2)
                rt.buf_push(&b, 46 as u8)
                put_n(&b, ms % 1000, 3)
            } else if k == 72 as u8 {
                put2(&b, x.h)
            } else if k == 106 as u8 {
                var y: DT = x
                y.valid_jd = false
                y.m = 1
                y.d = 1
                compute_jd(&y)
                let nday: i64 = (x.ijd - y.ijd + 43200000) / 86400000 + 1
                put_n(&b, nday, 3)
            } else if k == 74 as u8 {
                put_julian(&b, (x.ijd as f64) / 86400000.0)
            } else if k == 109 as u8 {
                put2(&b, x.m)
            } else if k == 77 as u8 {
                put2(&b, x.mi)
            } else if k == 115 as u8 {
                rt.buf_push_dec_i64(&b, x.ijd / 1000 - 210866760000)
            } else if k == 83 as u8 {
                put2(&b, x.s as i64)
            } else if k == 119 as u8 {
                rt.buf_push_dec_i64(&b, ((x.ijd + 129600000) / 86400000) % 7)
            } else if k == 87 as u8 {
                var y2: DT = x
                y2.valid_jd = false
                y2.m = 1
                y2.d = 1
                compute_jd(&y2)
                let nday2: i64 = (x.ijd - y2.ijd + 43200000) / 86400000
                let wd: i64 = ((x.ijd + 43200000) / 86400000) % 7
                put2(&b, (nday2 + 7 - wd) / 7)
            } else if k == 89 as u8 {
                put_year(&b, x.y)
            } else if k == 37 as u8 {
                rt.buf_push(&b, 37 as u8)
            } else {
                rt.buf_free(&b)
                return false
            }
        }
    }
    let p: u64 = ar.arena_copy(a, rt.buf_ptr(&b), rt.buf_len(&b))
    *out = rc.val_text(p, rt.buf_len(&b))
    rt.buf_free(&b)
    return true
}
