// SPDX-License-Identifier: MPL-2.0
// lib/db/util.fi -- big-endian integers, SQLite varints and memmove on raw
// addresses. Every offset is in OCTETS from the address `p`.

import std.rt

export {
    rd8, rd16, rd32, rd64, wr8, wr16, wr32, wr64,
    varint_get, varint_put, varint_len, move_bytes, zero_bytes, bytes_equal,
    bytes_compare, put_text, buf_put_be32,
}

#[inline]
fn rd8(p: u64, off: usize) -> u64 {
    return rt.ld8(p, off) as u64
}

#[inline]
fn rd16(p: u64, off: usize) -> u64 {
    return (rt.ld8(p, off) as u64) << 8 | (rt.ld8(p, off + 1) as u64)
}

#[inline]
fn rd32(p: u64, off: usize) -> u64 {
    return (rt.ld8(p, off) as u64) << 24 | (rt.ld8(p, off + 1) as u64) << 16
    | (rt.ld8(p, off + 2) as u64) << 8 | (rt.ld8(p, off + 3) as u64)
}

fn rd64(p: u64, off: usize) -> u64 {
    return rd32(p, off) << 32 | rd32(p, off + 4)
}

#[inline]
fn wr8(p: u64, off: usize, v: u64) {
    rt.st8(p, off, (v & 255) as u8)
}

#[inline]
fn wr16(p: u64, off: usize, v: u64) {
    rt.st8(p, off, ((v >> 8) & 255) as u8)
    rt.st8(p, off + 1, (v & 255) as u8)
}

#[inline]
fn wr32(p: u64, off: usize, v: u64) {
    rt.st8(p, off, ((v >> 24) & 255) as u8)
    rt.st8(p, off + 1, ((v >> 16) & 255) as u8)
    rt.st8(p, off + 2, ((v >> 8) & 255) as u8)
    rt.st8(p, off + 3, (v & 255) as u8)
}

fn wr64(p: u64, off: usize, v: u64) {
    wr32(p, off, v >> 32)
    wr32(p, off + 4, v & 4294967295)
}

// Reads a varint of 1..9 octets. `avail` is how many octets may be read;
// the answer is the octet count, 0 if the varint is cut off by `avail`.
fn varint_get(p: u64, avail: usize, out: *mut u64) -> usize {
    var v: u64 = 0
    var i: usize = 0
    while i < 8 {
        if i >= avail {
            return 0
        }
        let b: u64 = rt.ld8(p, i) as u64
        v = (v << 7) | (b & 127)
        if b < 128 {
            *out = v
            return i + 1
        }
        i = i + 1
    }
    if avail < 9 {
        return 0
    }
    v = (v << 8) | (rt.ld8(p, 8) as u64)
    *out = v
    return 9
}

fn varint_len(v: u64) -> usize {
    if v < 128 {
        return 1
    }
    if v < 16384 {
        return 2
    }
    if v < 2097152 {
        return 3
    }
    if v < 268435456 {
        return 4
    }
    if v < 34359738368 {
        return 5
    }
    if v < 4398046511104 {
        return 6
    }
    if v < 562949953421312 {
        return 7
    }
    if v < 72057594037927936 {
        return 8
    }
    return 9
}

// Writes `v` as a varint at `p`; the answer is the octet count.
fn varint_put(p: u64, v0: u64) -> usize {
    var v: u64 = v0
    if v >= 72057594037927936 {
        rt.st8(p, 8, (v & 255) as u8)
        v = v >> 8
        var i: usize = 8
        while i > 0 {
            i = i - 1
            rt.st8(p, i, ((v & 127) | 128) as u8)
            v = v >> 7
        }
        return 9
    }
    let n: usize = varint_len(v)
    var i: usize = n
    var first: bool = true
    while i > 0 {
        i = i - 1
        var b: u64 = v & 127
        if !first {
            b = b | 128
        }
        first = false
        rt.st8(p, i, b as u8)
        v = v >> 7
    }
    return n
}

// memmove: overlapping ranges are fine.
fn move_bytes(dst: u64, src: u64, n: usize) {
    if n == 0 || dst == src {
        return
    }
    if dst < src {
        var i: usize = 0
        while i + 8 <= n {
            rt.st64(dst + i as u64, 0, rt.ld64(src + i as u64, 0))
            i = i + 8
        }
        while i < n {
            rt.st8(dst, i, rt.ld8(src, i))
            i = i + 1
        }
    } else {
        var i: usize = n
        while i >= 8 {
            i = i - 8
            rt.st64(dst + i as u64, 0, rt.ld64(src + i as u64, 0))
        }
        while i > 0 {
            i = i - 1
            rt.st8(dst, i, rt.ld8(src, i))
        }
    }
}

fn zero_bytes(p: u64, n: usize) {
    var i: usize = 0
    while i + 8 <= n {
        rt.st64(p + i as u64, 0, 0)
        i = i + 8
    }
    while i < n {
        rt.st8(p, i, 0 as u8)
        i = i + 1
    }
}

fn bytes_equal(a: u64, b: u64, n: usize) -> bool {
    var i: usize = 0
    while i + 8 <= n {
        if rt.ld64(a + i as u64, 0) != rt.ld64(b + i as u64, 0) {
            return false
        }
        i = i + 8
    }
    while i < n {
        if rt.ld8(a, i) != rt.ld8(b, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// memcmp over min(na, nb) octets, then the shorter one is smaller: -1, 0, 1
fn bytes_compare(a: u64, na: usize, b: u64, nb: usize) -> i64 {
    var n: usize = na
    if nb < n {
        n = nb
    }
    var i: usize = 0
    while i < n {
        let x: u8 = rt.ld8(a, i)
        let y: u8 = rt.ld8(b, i)
        if x != y {
            if x < y {
                return -1
            }
            return 1
        }
        i = i + 1
    }
    if na < nb {
        return -1
    }
    if na > nb {
        return 1
    }
    return 0
}

fn put_text(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.length())
}

fn buf_put_be32(b: *mut rt.Buf, v: u64) {
    rt.buf_push(b, ((v >> 24) & 255) as u8)
    rt.buf_push(b, ((v >> 16) & 255) as u8)
    rt.buf_push(b, ((v >> 8) & 255) as u8)
    rt.buf_push(b, (v & 255) as u8)
}
