// SPDX-License-Identifier: MPL-2.0
// lib/db/dberr.fi -- the one error set of the whole database library, and the
// text of the last error.
//
// Every layer (pager, B-tree, SQL) returns `DbError!...`, so `try` works
// through all of them. The SET says what kind of failure it was; the TEXT
// (`last_message`) says what exactly -- "no such table: foo", "UNIQUE
// constraint failed: t.a", "database disk image is malformed (page 7: ...)".
//
//   Busy         another process holds a lock for longer than the busy timeout
//   Locked       this process already has the file open (see vfsos.fi V1)
//   Io           the operating system refused a read, write, sync or delete
//   Corrupt      the file contradicts itself (a hostile or damaged file)
//   NotADb       the first 16 octets are not "SQLite format 3\0"
//   Unsupported  a valid SQLite file or statement this library does not do
//                (UTF-16 text, WAL mode, auto-vacuum, WITHOUT ROWID ...)
//   Full         no space left / the size limit of the file is reached
//   ReadOnly     a write on a connection opened read-only
//   TooBig       a value, row or statement over a limit
//   NoMemory     the allocator said no
//   Misuse       the API was called in the wrong order (step after finalize ...)
//   Constraint   UNIQUE / NOT NULL / PRIMARY KEY / CHECK violated
//   Syntax       the SQL text does not parse
//   NoSuchTable, NoSuchColumn, Exists   names the schema does not (or does) have
//   Range        a parameter or column index out of range
//   Sql          any other error of a statement (type mismatch, wrong column count)

export { DbError, set_message, last_message, clear_message, fail, to_code, from_code, failed_bool, failed_i32, failed_i64, failed_usize }

error DbError {
    Busy,
    Locked,
    Io,
    Corrupt,
    NotADb,
    Unsupported,
    Full,
    ReadOnly,
    TooBig,
    NoMemory,
    Misuse,
    Constraint,
    Syntax,
    NoSuchTable,
    NoSuchColumn,
    Exists,
    Range,
    Sql,
}

static mut msg_buf: [u8; 300] = [0; 300]
static mut msg_len: usize = 0

// Remembers `s` (cut to 300 octets) as the text of the last error.
fn set_message(s: str) {
    var n: usize = s.length()
    if n > 300 {
        n = 300
    }
    var i: usize = 0
    while i < n {
        msg_buf[i] = s.chars(i)
        i = i + 1
    }
    msg_len = n
}

// Message + number, e.g. set_message_num("page ", 7)
fn clear_message() {
    msg_len = 0
}

// The text of the last error ("" if none). Valid until the next error.
fn last_message() -> str {
    return __str_copy(str { p: (&msg_buf[0]) as *mut u8, n: msg_len })
}

// Sets the message and answers the error: `return dberr.fail(DbError::Corrupt, "bad page")`
fn fail(e: DbError, s: str) -> DbError {
    set_message(s)
    return e
}

// An error set member as a small number (for crossing a function pointer) and back.
fn to_code(e: DbError) -> i64 {
    if e == DbError::Busy { return 1 }
    if e == DbError::Locked { return 2 }
    if e == DbError::Io { return 3 }
    if e == DbError::Corrupt { return 4 }
    if e == DbError::NotADb { return 5 }
    if e == DbError::Unsupported { return 6 }
    if e == DbError::Full { return 7 }
    if e == DbError::ReadOnly { return 8 }
    if e == DbError::TooBig { return 9 }
    if e == DbError::NoMemory { return 10 }
    if e == DbError::Misuse { return 11 }
    if e == DbError::Constraint { return 12 }
    if e == DbError::Syntax { return 13 }
    if e == DbError::NoSuchTable { return 14 }
    if e == DbError::NoSuchColumn { return 15 }
    if e == DbError::Exists { return 16 }
    if e == DbError::Range { return 17 }
    return 18
}

fn from_code(c: i64) -> DbError {
    if c == 1 { return DbError::Busy }
    if c == 2 { return DbError::Locked }
    if c == 3 { return DbError::Io }
    if c == 4 { return DbError::Corrupt }
    if c == 5 { return DbError::NotADb }
    if c == 6 { return DbError::Unsupported }
    if c == 7 { return DbError::Full }
    if c == 8 { return DbError::ReadOnly }
    if c == 9 { return DbError::TooBig }
    if c == 10 { return DbError::NoMemory }
    if c == 11 { return DbError::Misuse }
    if c == 12 { return DbError::Constraint }
    if c == 13 { return DbError::Syntax }
    if c == 14 { return DbError::NoSuchTable }
    if c == 15 { return DbError::NoSuchColumn }
    if c == 16 { return DbError::Exists }
    if c == 17 { return DbError::Range }
    return DbError::Sql
}

fn mark_flag(f: *mut bool) -> bool {
    *f = true
    return false
}

fn mark_flag_i32(f: *mut bool) -> i32 {
    *f = true
    return 0
}

fn mark_flag_i64(f: *mut bool) -> i64 {
    *f = true
    return 0
}

fn mark_flag_usize(f: *mut bool) -> usize {
    *f = true
    return 0
}

// Did the call fail? (`r catch false` cannot tell a failure from a legitimate false)
fn failed_bool(r: DbError!bool) -> bool {
    var failed: bool = false
    let v: bool = r catch | e | (mark_flag(&failed))
    return failed
}

fn failed_i32(r: DbError!i32) -> bool {
    var failed: bool = false
    let v: i32 = r catch | e | (mark_flag_i32(&failed))
    return failed
}

fn failed_i64(r: DbError!i64) -> bool {
    var failed: bool = false
    let v: i64 = r catch | e | (mark_flag_i64(&failed))
    return failed
}

fn failed_usize(r: DbError!usize) -> bool {
    var failed: bool = false
    let v: usize = r catch | e | (mark_flag_usize(&failed))
    return failed
}
