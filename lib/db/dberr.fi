// SPDX-License-Identifier: MPL-2.0
// lib/db/dberr.fi -- the one error set of the whole database library, and the
// text of the last error.
//
// Every layer (pager, B-tree, SQL) returns `DbError!...`, so `try` works
// through all of them. The SET says what kind of failure it was; the TEXT
// (`last_message`) says what exactly -- "no such table: foo", "UNIQUE
// constraint failed: t.a", "database disk image is malformed (page 7: ...)".
//
//   Busy         another process holds a lock for longer than the busy timeout
//   Locked       this process already has the file open (see vfsos.fi V1)
//   Io           the operating system refused a read, write, sync or delete
//   Corrupt      the file contradicts itself (a hostile or damaged file)
//   NotADb       the first 16 octets are not "SQLite format 3\0"
//   Unsupported  a valid SQLite file or statement this library does not do
//                (UTF-16 text, WAL mode, auto-vacuum, WITHOUT ROWID ...)
//   Full         no space left / the size limit of the file is reached
//   ReadOnly     a write on a connection opened read-only
//   TooBig       a value, row or statement over a limit
//   NoMemory     the allocator said no
//   Misuse       the API was called in the wrong order (step after finalize ...)
//   Constraint   UNIQUE / NOT NULL / PRIMARY KEY / CHECK violated
//   Syntax       the SQL text does not parse
//   NoSuchTable, NoSuchColumn, Exists   names the schema does not (or does) have
//   Range        a parameter or column index out of range
//   Sql          any other error of a statement (type mismatch, wrong column count)

export { DbError, set_message, last_message, clear_message, fail }

error DbError {
    Busy,
    Locked,
    Io,
    Corrupt,
    NotADb,
    Unsupported,
    Full,
    ReadOnly,
    TooBig,
    NoMemory,
    Misuse,
    Constraint,
    Syntax,
    NoSuchTable,
    NoSuchColumn,
    Exists,
    Range,
    Sql,
}

static mut msg_buf: [u8; 300] = [0; 300]
static mut msg_len: usize = 0

// Remembers `s` (cut to 300 octets) as the text of the last error.
fn set_message(s: str) {
    var n: usize = s.length()
    if n > 300 {
        n = 300
    }
    var i: usize = 0
    while i < n {
        msg_buf[i] = s.chars(i)
        i = i + 1
    }
    msg_len = n
}

// Message + number, e.g. set_message_num("page ", 7)
fn clear_message() {
    msg_len = 0
}

// The text of the last error ("" if none). Valid until the next error.
fn last_message() -> str {
    return __str_copy(str { p: (&msg_buf[0]) as *mut u8, n: msg_len })
}

// Sets the message and answers the error: `return dberr.fail(DbError::Corrupt, "bad page")`
fn fail(e: DbError, s: str) -> DbError {
    set_message(s)
    return e
}
