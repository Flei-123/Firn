// SPDX-License-Identifier: MPL-2.0
// lib/db/sqllex.fi -- the tokenizer of the SQL dialect (SQLite's).
//
// Tokens: identifiers and keywords (`TK_ID`, the keyword number in `code`
// when it is one and was not quoted), quoted identifiers ("x", `x`, [x]),
// strings ('it''s', raw span, `esc` set when it holds '' pairs), integer and
// real numbers (decimal, 0x hex, exponent), blobs (X'4142'), parameters
// (?, ?NNN, :name, @name, $name) and operators. Comments (-- and /* */) and
// white space are skipped. Text is UTF-8 and is never validated here.

import std.rt
import std.num
import db.util

export {
    Lexer, Token, lex_new, lex_next, kw_code, tok_is_op, lex_eq_ci, tok_text,
    TK_EOF, TK_ID, TK_STR, TK_INT, TK_FLOAT, TK_BLOB, TK_PARAM, TK_OP, TK_ERR,
    P_PLUS, P_MINUS, P_STAR, P_SLASH, P_PERCENT, P_LPAREN, P_RPAREN, P_COMMA, P_SEMI, P_DOT,
    P_EQ, P_NE, P_LT, P_LE, P_GT, P_GE, P_CONCAT, P_BITAND, P_BITOR, P_LSHIFT, P_RSHIFT,
    P_TILDE,
    K_SELECT, K_FROM, K_WHERE, K_GROUP, K_BY, K_HAVING, K_ORDER, K_LIMIT, K_OFFSET, K_DISTINCT, K_ALL, K_AS, K_JOIN, K_INNER, K_LEFT, K_RIGHT, K_FULL, K_OUTER, K_CROSS, K_NATURAL, K_ON, K_USING, K_UNION, K_INTERSECT, K_EXCEPT, K_AND, K_OR, K_NOT, K_IN, K_IS, K_NULL, K_LIKE, K_GLOB, K_BETWEEN, K_ESCAPE, K_CASE, K_WHEN, K_THEN, K_ELSE, K_END, K_EXISTS, K_CAST, K_COLLATE, K_ASC, K_DESC, K_NULLS, K_FIRST, K_LAST, K_INSERT, K_INTO, K_VALUES, K_DEFAULT, K_UPDATE, K_SET, K_DELETE, K_REPLACE, K_CREATE, K_TABLE, K_INDEX, K_UNIQUE, K_PRIMARY, K_KEY, K_AUTOINCREMENT, K_CHECK, K_REFERENCES, K_FOREIGN, K_CONSTRAINT, K_IF, K_DROP, K_ALTER, K_ADD, K_COLUMN, K_RENAME, K_TO, K_BEGIN, K_COMMIT, K_ROLLBACK, K_TRANSACTION, K_DEFERRED, K_IMMEDIATE, K_EXCLUSIVE, K_PRAGMA, K_VACUUM, K_ANALYZE, K_TEMP, K_TEMPORARY, K_ISNULL, K_NOTNULL, K_MATCH, K_REGEXP, K_IGNORE, K_ABORT, K_FAIL, K_WITHOUT, K_ROWID, K_TRUE, K_FALSE, K_VIEW, K_TRIGGER, K_EXPLAIN, K_SAVEPOINT, K_RELEASE, K_DEFERRABLE, K_INITIALLY, K_WITH, K_RECURSIVE, K_CURRENT_TIME, K_CURRENT_DATE, K_CURRENT_TIMESTAMP, K_CONFLICT, K_DO, K_NOTHING, K_RETURNING, K_OVER, K_WINDOW, K_PARTITION, K_GENERATED, K_ALWAYS, K_STORED, K_VIRTUAL, K_DATABASE, K_ATTACH, K_DETACH, K_REINDEX
}

