struct Lexer {
    p: u64,
    n: usize,
    pos: usize,
}

struct Token {
    kind: u32,
    code: u32, // keyword number (TK_ID) or operator number (TK_OP)
    p: u64, // the text (inside the quotes for a quoted name or string)
    n: usize,
    start: usize, // offset of the first octet of the token (with quotes)
    end: usize, // offset after the token
    ival: i64,
    fval: f64,
    esc: bool, // the text holds doubled quotes
    quoted: bool,
}

fn lex_new(p: u64, n: usize) -> Lexer {
    return Lexer { p: p, n: n, pos: 0 }
}

fn tok_blank() -> Token {
    return Token { kind: 0, code: 0, p: 0, n: 0, start: 0, end: 0, ival: 0, fval: 0.0, esc: false,
        quoted: false }
}

fn lower(c: u8) -> u8 {
    if c >= 65 as u8 && c <= 90 as u8 {
        return c + 32 as u8
    }
    return c
}

// text of p[0..n] equals the (upper case) word, ignoring case
fn eq_ci_at(p: u64, word: str) -> bool {
    let n: usize = word.length()
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        let w: u8 = word.chars(i)
        if c != w && c != w + 32 as u8 {
            return false
        }
        i = i + 1
    }
    return true
}

fn eq_ci(p: u64, word: str) -> bool {
    return eq_ci_at(p, word)
}

fn lex_eq_ci(p: u64, n: usize, word: str) -> bool {
    if n != word.length() {
        return false
    }
    return eq_ci_at(p, word)
}

fn tok_text(t: *mut Token) -> str {
    return str { p: (*t).p as *mut u8, n: (*t).n }
}

fn tok_is_op(t: *mut Token, code: u32) -> bool {
    return (*t).kind == TK_OP && (*t).code == code
}

// the keyword number of the word at p (n octets), 0 if it is none
fn kw_code(p: u64, n: usize) -> u32 {
    if n < 2 || n > 17 {
        return 0
    }
    if n == 6 && eq_ci(p, "SELECT") {
        return K_SELECT
    }
    if n == 4 && eq_ci(p, "FROM") {
        return K_FROM
    }
    if n == 5 && eq_ci(p, "WHERE") {
        return K_WHERE
    }
    if n == 5 && eq_ci(p, "GROUP") {
        return K_GROUP
    }
