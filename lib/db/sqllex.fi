fn is_idstart(c: u8) -> bool {
    return (c >= 97 as u8 && c <= 122 as u8) || (c >= 65 as u8 && c <= 90 as u8) || c == 95 as u8
    || c >= 128 as u8
}

fn is_digit(c: u8) -> bool {
    return c >= 48 as u8 && c <= 57 as u8
}

fn is_idchar(c: u8) -> bool {
    return is_idstart(c) || is_digit(c) || c == 36 as u8
}

fn is_hex(c: u8) -> bool {
    return is_digit(c) || (c >= 97 as u8 && c <= 102 as u8) || (c >= 65 as u8 && c <= 70 as u8)
}

fn hexval(c: u8) -> i64 {
    if is_digit(c) {
        return (c as i64) - 48
    }
    return ((lower(c) as i64) - 97) + 10
}

// Reads the next token into `t`. At the end t.kind is TK_EOF.
fn lex_next(lx: *mut Lexer, t: *mut Token) {
    let p: u64 = (*lx).p
    let n: usize = (*lx).n
    var i: usize = (*lx).pos
    *t = tok_blank()
    // white space and comments
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c == 32 as u8 || c == 9 as u8 || c == 10 as u8 || c == 13 as u8 || c == 12 as u8 {
            i = i + 1
        } else if c == 45 as u8 && i + 1 < n && rt.ld8(p, i + 1) == 45 as u8 {
            while i < n && rt.ld8(p, i) != 10 as u8 {
                i = i + 1
            }
        } else if c == 47 as u8 && i + 1 < n && rt.ld8(p, i + 1) == 42 as u8 {
            i = i + 2
            while i < n && !(rt.ld8(p, i) == 42 as u8 && i + 1 < n && rt.ld8(p, i + 1) == 47 as u8) {
                i = i + 1
            }
            if i < n {
                i = i + 2
            } else {
                i = n
            }
        } else {
            break
        }
    }
    (*t).start = i
    if i >= n {
        (*t).kind = TK_EOF
        (*t).end = i
        (*lx).pos = i
        return
    }
    let c: u8 = rt.ld8(p, i)
    // identifiers and keywords
    if is_idstart(c) {
        let s: usize = i
        while i < n && is_idchar(rt.ld8(p, i)) {
            i = i + 1
        }
        // X'..' blob literal
        if (c == 120 as u8 || c == 88 as u8) && i == s + 1 && i < n && rt.ld8(p, i) == 39 as u8 {
            var j: usize = i + 1
            while j < n && rt.ld8(p, j) != 39 as u8 {
                j = j + 1
            }
            if j >= n {
                (*t).kind = TK_ERR
                (*t).end = n
                (*lx).pos = n
                return
            }
            (*t).kind = TK_BLOB
            (*t).p = p + ((i + 1) as u64)
            (*t).n = j - i - 1
            (*t).end = j + 1
            (*lx).pos = j + 1
            return
        }
        (*t).kind = TK_ID
        (*t).p = p + (s as u64)
        (*t).n = i - s
        (*t).code = kw_code((*t).p, (*t).n)
        (*t).end = i
        (*lx).pos = i
        return
    }
    // quoted identifiers
    if c == 34 as u8 || c == 96 as u8 || c == 91 as u8 {
        var close: u8 = c
        if c == 91 as u8 {
            close = 93 as u8
        }
        var j: usize = i + 1
        var esc: bool = false
        while j < n {
            let d: u8 = rt.ld8(p, j)
            if d == close {
                if close != 93 as u8 && j + 1 < n && rt.ld8(p, j + 1) == close {
                    esc = true
                    j = j + 2
                    continue
                }
                break
            }
            j = j + 1
        }
        if j >= n {
            (*t).kind = TK_ERR
            (*t).end = n
            (*lx).pos = n
            return
        }
        (*t).kind = TK_ID
        (*t).p = p + ((i + 1) as u64)
        (*t).n = j - i - 1
        (*t).esc = esc
        (*t).quoted = true
        (*t).end = j + 1
        (*lx).pos = j + 1
        return
    }
    // strings
    if c == 39 as u8 {
        var j: usize = i + 1
        var esc: bool = false
        while j < n {
            if rt.ld8(p, j) == 39 as u8 {
                if j + 1 < n && rt.ld8(p, j + 1) == 39 as u8 {
                    esc = true
                    j = j + 2
                    continue
                }
                break
            }
            j = j + 1
        }
        if j >= n {
            (*t).kind = TK_ERR
            (*t).end = n
            (*lx).pos = n
            return
        }
        (*t).kind = TK_STR
        (*t).p = p + ((i + 1) as u64)
        (*t).n = j - i - 1
        (*t).esc = esc
        (*t).end = j + 1
        (*lx).pos = j + 1
        return
    }
    // numbers
    if is_digit(c) || (c == 46 as u8 && i + 1 < n && is_digit(rt.ld8(p, i + 1))) {
        let s: usize = i
        // hex integer
        if c == 48 as u8 && i + 2 < n && (rt.ld8(p, i + 1) == 120 as u8 || rt.ld8(p, i + 1) == 88 as u8)
        && is_hex(rt.ld8(p, i + 2)) {
            i = i + 2
            var v: u64 = 0
            var digits: usize = 0
            while i < n && is_hex(rt.ld8(p, i)) {
                v = (v << 4) | (hexval(rt.ld8(p, i)) as u64)
                digits = digits + 1
                i = i + 1
            }
            if digits > 16 {
                (*t).kind = TK_ERR
            } else {
                (*t).kind = TK_INT
                (*t).ival = v as i64
            }
            (*t).p = p + (s as u64)
            (*t).n = i - s
            (*t).end = i
            (*lx).pos = i
            return
        }
        var is_real: bool = false
        while i < n && is_digit(rt.ld8(p, i)) {
            i = i + 1
        }
        if i < n && rt.ld8(p, i) == 46 as u8 {
            is_real = true
            i = i + 1
            while i < n && is_digit(rt.ld8(p, i)) {
                i = i + 1
            }
        }
        if i < n && (rt.ld8(p, i) == 101 as u8 || rt.ld8(p, i) == 69 as u8) {
            var j: usize = i + 1
            if j < n && (rt.ld8(p, j) == 43 as u8 || rt.ld8(p, j) == 45 as u8) {
                j = j + 1
            }
            if j < n && is_digit(rt.ld8(p, j)) {
                while j < n && is_digit(rt.ld8(p, j)) {
                    j = j + 1
                }
                is_real = true
                i = j
            }
        }
        (*t).p = p + (s as u64)
        (*t).n = i - s
        (*t).end = i
        (*lx).pos = i
        // an identifier glued to a number is an error ("123abc")
        if i < n && is_idstart(rt.ld8(p, i)) {
            (*t).kind = TK_ERR
            return
        }
        if !is_real && i - s == 19 && rt.ld8(p, s) == 57 as u8 && rt.ld8(p, s + 1) == 50 as u8
        && rt.ld8(p, s + 2) == 50 as u8 && rt.ld8(p, s + 3) == 51 as u8 && rt.ld8(p, s + 4) == 51 as u8
        && rt.ld8(p, s + 5) == 55 as u8 && rt.ld8(p, s + 6) == 50 as u8 && rt.ld8(p, s + 7) == 48 as u8
        && rt.ld8(p, s + 8) == 51 as u8 && rt.ld8(p, s + 9) == 54 as u8 && rt.ld8(p, s + 10) == 56 as u8
        && rt.ld8(p, s + 11) == 53 as u8 && rt.ld8(p, s + 12) == 52 as u8 && rt.ld8(p, s + 13) == 55 as u8
        && rt.ld8(p, s + 14) == 55 as u8 && rt.ld8(p, s + 15) == 53 as u8 && rt.ld8(p, s + 16) == 56 as u8
        && rt.ld8(p, s + 17) == 48 as u8 && rt.ld8(p, s + 18) == 56 as u8 {
            (*t).kind = TK_INT
            (*t).ival = 0 - 9223372036854775807 - 1
            (*t).esc = true
            return
        }
        if !is_real {
            // integer if it fits an i64, else a real
            var v: u64 = 0
            var over: bool = false
            var k: usize = s
            while k < i {
                let d: u64 = (rt.ld8(p, k) as u64) - 48
                if v > 922337203685477580 || (v == 922337203685477580 && d > 7) {
                    over = true
                    break
                }
                v = v * 10 + d
                k = k + 1
            }
            if !over {
                (*t).kind = TK_INT
                (*t).ival = v as i64
                return
            }
        }
        var f: f64 = 0.0
        num.text_to_f64((*t).p as *mut u8, (*t).n, &f)
        (*t).kind = TK_FLOAT
        (*t).fval = f
        return
    }
    // parameters
    if c == 63 as u8 {
        var j: usize = i + 1
        var v: i64 = 0
        while j < n && is_digit(rt.ld8(p, j)) {
            v = v * 10 + ((rt.ld8(p, j) as i64) - 48)
            if v > 100000 {
                (*t).kind = TK_ERR
                (*t).end = j
                (*lx).pos = j
                return
            }
            j = j + 1
        }
        (*t).kind = TK_PARAM
        (*t).ival = v
        (*t).p = p + (i as u64)
        (*t).n = j - i
        (*t).end = j
        (*lx).pos = j
        return
    }
    if c == 58 as u8 || c == 64 as u8 || c == 36 as u8 {
        var j: usize = i + 1
        while j < n && is_idchar(rt.ld8(p, j)) {
            j = j + 1
        }
        if j == i + 1 {
            (*t).kind = TK_ERR
            (*t).end = j
            (*lx).pos = j
            return
        }
        (*t).kind = TK_PARAM
        (*t).ival = 0 - 1
        (*t).p = p + (i as u64)
        (*t).n = j - i
        (*t).end = j
        (*lx).pos = j
        return
    }
    // operators
    (*t).kind = TK_OP
    (*t).p = p + (i as u64)
    (*t).n = 1
    var code: u32 = 0
    var len: usize = 1
    let d: u8 = if i + 1 < n { rt.ld8(p, i + 1) } else { 0 as u8 }
    if c == 43 as u8 {
        code = P_PLUS
    } else if c == 45 as u8 {
        code = P_MINUS
    } else if c == 42 as u8 {
        code = P_STAR
    } else if c == 47 as u8 {
        code = P_SLASH
    } else if c == 37 as u8 {
        code = P_PERCENT
    } else if c == 40 as u8 {
        code = P_LPAREN
    } else if c == 41 as u8 {
        code = P_RPAREN
    } else if c == 44 as u8 {
        code = P_COMMA
    } else if c == 59 as u8 {
        code = P_SEMI
    } else if c == 46 as u8 {
        code = P_DOT
    } else if c == 126 as u8 {
        code = P_TILDE
    } else if c == 38 as u8 {
        code = P_BITAND
    } else if c == 61 as u8 {
        code = P_EQ
        if d == 61 as u8 {
            len = 2
        }
    } else if c == 33 as u8 {
        if d == 61 as u8 {
            code = P_NE
            len = 2
        }
    } else if c == 60 as u8 {
        code = P_LT
        if d == 61 as u8 {
            code = P_LE
            len = 2
        } else if d == 62 as u8 {
            code = P_NE
            len = 2
        } else if d == 60 as u8 {
            code = P_LSHIFT
            len = 2
        }
    } else if c == 62 as u8 {
        code = P_GT
        if d == 61 as u8 {
            code = P_GE
            len = 2
        } else if d == 62 as u8 {
            code = P_RSHIFT
            len = 2
        }
    } else if c == 124 as u8 {
        code = P_BITOR
        if d == 124 as u8 {
            code = P_CONCAT
            len = 2
        }
    }
    if code == 0 {
        (*t).kind = TK_ERR
        len = 1
    }
    (*t).code = code
    (*t).n = len
    (*t).end = i + len
    (*lx).pos = i + len
}
