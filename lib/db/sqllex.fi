    }
    if n == 2 && eq_ci(p, "ON") {
        return K_ON
    }
    if n == 5 && eq_ci(p, "USING") {
        return K_USING
    }
    if n == 5 && eq_ci(p, "UNION") {
        return K_UNION
    }
    if n == 9 && eq_ci(p, "INTERSECT") {
