    }
    if n == 4 && eq_ci(p, "GLOB") {
        return K_GLOB
    }
    if n == 7 && eq_ci(p, "BETWEEN") {
        return K_BETWEEN
    }
    if n == 6 && eq_ci(p, "ESCAPE") {
        return K_ESCAPE
    }
    if n == 4 && eq_ci(p, "CASE") {
        return K_CASE
    }
    if n == 4 && eq_ci(p, "WHEN") {
        return K_WHEN
