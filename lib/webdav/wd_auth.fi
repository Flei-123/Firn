// SPDX-License-Identifier: MPL-2.0
// lib/webdav/wd_auth.fi -- webdav.wd_auth: HTTP Basic and Digest (RFC 7616: MD5, SHA-256, -sess, qop=auth) for the WebDAV client.
import std.rt
import std.str
import std.md5
import std.base64
import std.crypto.sha256
import std.crypto.random
import webdav.wd_path

export {
    Auth, auth_new, auth_free, auth_set_user, auth_has_user, auth_set_cnonce,
    auth_challenge, auth_scheme, auth_ready, auth_header, auth_forget,
    SCHEME_NONE, SCHEME_BASIC, SCHEME_DIGEST,
    ALG_MD5, ALG_MD5_SESS, ALG_SHA256, ALG_SHA256_SESS,
    hash_hex,
}

const SCHEME_NONE: u32 = 0
const SCHEME_BASIC: u32 = 1
const SCHEME_DIGEST: u32 = 2
const ALG_MD5: u32 = 0
const ALG_MD5_SESS: u32 = 1
const ALG_SHA256: u32 = 2
const ALG_SHA256_SESS: u32 = 3

struct Auth {
    scheme: u32,
    user: rt.Buf,
    pass: rt.Buf,
    realm: rt.Buf,
    nonce: rt.Buf,
    opaque: rt.Buf,
    cnonce: rt.Buf,
    algo: u32,
    use_qop: bool,
    nc: u32,
    stale: bool,
    fixed_cnonce: bool,
    have_user: bool,
}

fn auth_new() -> Auth {
    return Auth {
        scheme: 0 as u32, user: rt.buf_new(), pass: rt.buf_new(),
        realm: rt.buf_new(), nonce: rt.buf_new(), opaque: rt.buf_new(),
        cnonce: rt.buf_new(), algo: 0 as u32, use_qop: false, nc: 0 as u32,
        stale: false, fixed_cnonce: false, have_user: false,
    }
}

fn auth_free(a: *mut Auth) {
    rt.buf_free(&(*a).user)
    rt.buf_free(&(*a).pass)
    rt.buf_free(&(*a).realm)
    rt.buf_free(&(*a).nonce)
    rt.buf_free(&(*a).opaque)
    rt.buf_free(&(*a).cnonce)
}

fn auth_forget(a: *mut Auth) {
    (*a).scheme = 0 as u32
    (*a).nc = 0 as u32
}

fn auth_set_user(a: *mut Auth, user: str, pass: str) {
    rt.buf_clear(&(*a).user)
    rt.buf_clear(&(*a).pass)
    rt.buf_push_bytes(&(*a).user, user.p as u64, user.n)
    rt.buf_push_bytes(&(*a).pass, pass.p as u64, pass.n)
    (*a).have_user = true
}

fn auth_has_user(a: *mut Auth) -> bool { return (*a).have_user }
fn auth_scheme(a: *mut Auth) -> u32 { return (*a).scheme }
fn auth_ready(a: *mut Auth) -> bool { return (*a).scheme != 0 as u32 }

fn auth_set_cnonce(a: *mut Auth, s: str) {
    rt.buf_clear(&(*a).cnonce)
    rt.buf_push_bytes(&(*a).cnonce, s.p as u64, s.n)
    (*a).fixed_cnonce = true
}

fn lower(c: u8) -> u8 {
    if c >= 65 as u8 && c <= 90 as u8 {
        return c + 32 as u8
    }
    return c
}

fn is_tok_end(c: u8) -> bool {
    return c == 32 as u8 || c == 44 as u8 || c == 9 as u8
}

fn find_scheme(p: u64, n: usize, lit: str) -> i64 {
    var i: usize = 0
    while i + lit.length() <= n {
        var boundary: bool = i == 0
        if !boundary {
            let prev: u8 = rt.ld8(p, i - 1)
            boundary = prev == 32 as u8 || prev == 44 as u8 || prev == 9 as u8
        }
        if boundary && wd_path.starts_with_ci(p + i as u64, n - i, lit) {
            let after: usize = i + lit.length()
            if after == n || is_tok_end(rt.ld8(p, after)) {
                return after as i64
            }
        }
        i = i + 1
    }
    return -1
}

fn key_is(p: u64, n: usize, lit: str) -> bool {
    if n != lit.length() {
        return false
    }
    return wd_path.starts_with_ci(p, n, lit)
}

fn param_get(p: u64, n: usize, from: usize, key: str, out: *mut rt.Buf) -> bool {
    var i: usize = from
    while i < n {
        while i < n && (is_tok_end(rt.ld8(p, i))) {
            i = i + 1
        }
        let ks: usize = i
        while i < n && rt.ld8(p, i) != 61 as u8 && !is_tok_end(rt.ld8(p, i)) {
            i = i + 1
        }
        if i >= n || rt.ld8(p, i) != 61 as u8 {
            return false
        }
        let kl: usize = i - ks
        i = i + 1
        let want: bool = key_is(p + ks as u64, kl, key)
        if i < n && rt.ld8(p, i) == 34 as u8 {
            i = i + 1
            while i < n && rt.ld8(p, i) != 34 as u8 {
                var c: u8 = rt.ld8(p, i)
                if c == 92 as u8 && i + 1 < n {
                    i = i + 1
                    c = rt.ld8(p, i)
                }
                if want {
                    rt.buf_push(out, c)
                }
                i = i + 1
            }
            i = i + 1
        } else {
            while i < n && rt.ld8(p, i) != 44 as u8 {
                if want && rt.ld8(p, i) != 32 as u8 {
                    rt.buf_push(out, rt.ld8(p, i))
                }
                i = i + 1
            }
        }
        if want {
            return true
        }
    }
    return false
}

fn hex_push(out: *mut rt.Buf, p: u64, n: usize) {
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        let hi: u8 = c >> 4 as u8
        let lo: u8 = c & 15 as u8
        if hi < 10 as u8 {
            rt.buf_push(out, 48 as u8 + hi)
        } else {
            rt.buf_push(out, 87 as u8 + hi)
        }
        if lo < 10 as u8 {
            rt.buf_push(out, 48 as u8 + lo)
        } else {
            rt.buf_push(out, 87 as u8 + lo)
        }
        i = i + 1
    }
}

fn hash_hex(algo: u32, p: u64, n: usize, out: *mut rt.Buf) {
    var dg: [u8; 32] = [0; 32]
    if algo == ALG_SHA256 || algo == ALG_SHA256_SESS {
        sha256.sha256(p, n, (&dg[0]) as u64)
        hex_push(out, (&dg[0]) as u64, 32)
    } else {
        md5.md5(p, n, (&dg[0]) as u64)
        hex_push(out, (&dg[0]) as u64, 16)
    }
}

fn auth_challenge(a: *mut Auth, p: u64, n: usize) -> u32 {
    let dg: i64 = find_scheme(p, n, "digest")
    if dg >= 0 {
        var algo: u32 = ALG_MD5
        var tmp: rt.Buf = rt.buf_new()
        if param_get(p, n, dg as usize, "algorithm", &tmp) {
            if key_is(tmp.ptr, tmp.len, "md5") {
                algo = ALG_MD5
            } else if key_is(tmp.ptr, tmp.len, "md5-sess") {
                algo = ALG_MD5_SESS
            } else if key_is(tmp.ptr, tmp.len, "sha-256") {
                algo = ALG_SHA256
            } else if key_is(tmp.ptr, tmp.len, "sha-256-sess") {
                algo = ALG_SHA256_SESS
            } else {
                rt.buf_free(&tmp)
                return 0 as u32
            }
        }
        rt.buf_clear(&tmp)
        var use_qop: bool = false
        if param_get(p, n, dg as usize, "qop", &tmp) {
            var found: bool = false
            var s: usize = 0
            var i: usize = 0
            while i <= tmp.len {
                if i == tmp.len || rt.ld8(tmp.ptr, i) == 44 as u8 {
                    if key_is(tmp.ptr + s as u64, i - s, "auth") {
                        found = true
                    }
                    s = i + 1
                }
                i = i + 1
            }
            if !found {
                rt.buf_free(&tmp)
                return 0 as u32
            }
            use_qop = true
        }
        rt.buf_clear(&(*a).nonce)
        if !param_get(p, n, dg as usize, "nonce", &(*a).nonce) {
            rt.buf_free(&tmp)
            return 0 as u32
        }
        rt.buf_clear(&(*a).realm)
        param_get(p, n, dg as usize, "realm", &(*a).realm)
        rt.buf_clear(&(*a).opaque)
        param_get(p, n, dg as usize, "opaque", &(*a).opaque)
        rt.buf_clear(&tmp)
        (*a).stale = false
        if param_get(p, n, dg as usize, "stale", &tmp) && key_is(tmp.ptr, tmp.len, "true") {
            (*a).stale = true
        }
        rt.buf_free(&tmp)
        (*a).algo = algo
        (*a).use_qop = use_qop
        (*a).nc = 0 as u32
        if !(*a).fixed_cnonce {
            var rnd: [u8; 8] = [0; 8]
            rt.buf_clear(&(*a).cnonce)
            if random.random_bytes((&rnd[0]) as u64, 8) {
                hex_push(&(*a).cnonce, (&rnd[0]) as u64, 8)
            } else {
                return 0 as u32
            }
        }
        (*a).scheme = SCHEME_DIGEST
        return SCHEME_DIGEST
    }
    let bs: i64 = find_scheme(p, n, "basic")
    if bs >= 0 {
        (*a).scheme = SCHEME_BASIC
        return SCHEME_BASIC
    }
    return 0 as u32
}

fn push_str(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn push_quoted(b: *mut rt.Buf, p: u64, n: usize) {
    rt.buf_push(b, 34 as u8)
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c == 34 as u8 || c == 92 as u8 {
            rt.buf_push(b, 92 as u8)
        }
        rt.buf_push(b, c)
        i = i + 1
    }
    rt.buf_push(b, 34 as u8)
}

fn hex8(b: *mut rt.Buf, v: u32) {
    var i: i32 = 7
    while i >= 0 {
        let d: u32 = (v >> (i * 4) as u32) & 15 as u32
        if d < 10 as u32 {
            rt.buf_push(b, (48 as u32 + d) as u8)
        } else {
            rt.buf_push(b, (87 as u32 + d) as u8)
        }
        i = i - 1
    }
}

fn auth_header(a: *mut Auth, method: str, uri_p: u64, uri_n: usize, out: *mut rt.Buf) -> bool {
    if (*a).scheme == SCHEME_BASIC {
        var cred: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&cred, (*a).user.ptr, (*a).user.len)
        rt.buf_push(&cred, 58 as u8)
        rt.buf_push_bytes(&cred, (*a).pass.ptr, (*a).pass.len)
        push_str(out, "Basic ")
        base64.encode(cred.ptr, cred.len, out)
        rt.buf_free(&cred)
        return true
    }
    if (*a).scheme != SCHEME_DIGEST {
        return false
    }
    (*a).nc = (*a).nc + 1 as u32
    var t: rt.Buf = rt.buf_new()
    var ha1: rt.Buf = rt.buf_new()
    var ha2: rt.Buf = rt.buf_new()
    var rsp: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, (*a).user.ptr, (*a).user.len)
    rt.buf_push(&t, 58 as u8)
    rt.buf_push_bytes(&t, (*a).realm.ptr, (*a).realm.len)
    rt.buf_push(&t, 58 as u8)
    rt.buf_push_bytes(&t, (*a).pass.ptr, (*a).pass.len)
    hash_hex((*a).algo, t.ptr, t.len, &ha1)
    if (*a).algo == ALG_MD5_SESS || (*a).algo == ALG_SHA256_SESS {
        rt.buf_clear(&t)
        rt.buf_push_bytes(&t, ha1.ptr, ha1.len)
        rt.buf_push(&t, 58 as u8)
        rt.buf_push_bytes(&t, (*a).nonce.ptr, (*a).nonce.len)
        rt.buf_push(&t, 58 as u8)
        rt.buf_push_bytes(&t, (*a).cnonce.ptr, (*a).cnonce.len)
        rt.buf_clear(&ha1)
        hash_hex((*a).algo, t.ptr, t.len, &ha1)
    }
    rt.buf_clear(&t)
    push_str(&t, method)
    rt.buf_push(&t, 58 as u8)
    rt.buf_push_bytes(&t, uri_p, uri_n)
    hash_hex((*a).algo, t.ptr, t.len, &ha2)
    rt.buf_clear(&t)
    rt.buf_push_bytes(&t, ha1.ptr, ha1.len)
    rt.buf_push(&t, 58 as u8)
    rt.buf_push_bytes(&t, (*a).nonce.ptr, (*a).nonce.len)
    rt.buf_push(&t, 58 as u8)
    if (*a).use_qop {
        hex8(&t, (*a).nc)
        rt.buf_push(&t, 58 as u8)
        rt.buf_push_bytes(&t, (*a).cnonce.ptr, (*a).cnonce.len)
        push_str(&t, ":auth:")
    }
    rt.buf_push_bytes(&t, ha2.ptr, ha2.len)
    hash_hex((*a).algo, t.ptr, t.len, &rsp)
    push_str(out, "Digest username=")
    push_quoted(out, (*a).user.ptr, (*a).user.len)
    push_str(out, ", realm=")
    push_quoted(out, (*a).realm.ptr, (*a).realm.len)
    push_str(out, ", nonce=")
    push_quoted(out, (*a).nonce.ptr, (*a).nonce.len)
    push_str(out, ", uri=")
    push_quoted(out, uri_p, uri_n)
    if (*a).algo == ALG_MD5 {
        push_str(out, ", algorithm=MD5")
    } else if (*a).algo == ALG_MD5_SESS {
        push_str(out, ", algorithm=MD5-sess")
    } else if (*a).algo == ALG_SHA256 {
        push_str(out, ", algorithm=SHA-256")
    } else {
        push_str(out, ", algorithm=SHA-256-sess")
    }
    push_str(out, ", response=\"")
    rt.buf_push_bytes(out, rsp.ptr, rsp.len)
    rt.buf_push(out, 34 as u8)
    if (*a).use_qop {
        push_str(out, ", qop=auth, nc=")
        hex8(out, (*a).nc)
        push_str(out, ", cnonce=")
        push_quoted(out, (*a).cnonce.ptr, (*a).cnonce.len)
    }
    if (*a).opaque.len > 0 {
        push_str(out, ", opaque=")
        push_quoted(out, (*a).opaque.ptr, (*a).opaque.len)
    }
    rt.buf_free(&t)
    rt.buf_free(&ha1)
    rt.buf_free(&ha2)
    rt.buf_free(&rsp)
    return true
}
