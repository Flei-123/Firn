// SPDX-License-Identifier: MPL-2.0
// lib/webdav/wd_xml.fi -- webdav.wd_xml: the PROPFIND body and the Multistatus reader (any namespace prefix) into a flat Listing of paths, sizes, times, etags.
import std.rt
import std.str
import std.xml
import net.httpstate
import webdav.wd_path

export {
    Listing, listing_new, listing_free, listing_clear, parse_multistatus,
    propfind_body, list_count, list_path, list_name, list_is_dir, list_size,
    list_mtime, list_etag, list_ctype, list_status, list_display, status_code_of,
}

const REC: usize = 14
const F_PATH_OFF: usize = 0
const F_PATH_LEN: usize = 1
const F_NAME_OFF: usize = 2
const F_NAME_LEN: usize = 3
const F_IS_DIR: usize = 4
const F_SIZE: usize = 5
const F_MTIME: usize = 6
const F_ETAG_OFF: usize = 7
const F_ETAG_LEN: usize = 8
const F_CTYPE_OFF: usize = 9
const F_CTYPE_LEN: usize = 10
const F_STATUS: usize = 11
const F_DISP_OFF: usize = 12
const F_DISP_LEN: usize = 13

struct Listing {
    text: rt.Buf,
    rec: rt.Buf,
    count: usize,
}

fn listing_new() -> Listing {
    return Listing { text: rt.buf_new(), rec: rt.buf_new(), count: 0 }
}

fn listing_free(l: *mut Listing) {
    rt.buf_free(&(*l).text)
    rt.buf_free(&(*l).rec)
    (*l).count = 0
}

fn listing_clear(l: *mut Listing) {
    rt.buf_clear(&(*l).text)
    rt.buf_clear(&(*l).rec)
    (*l).count = 0
}

fn field(l: *mut Listing, i: usize, f: usize) -> u64 {
    if i >= (*l).count {
        return 0 as u64
    }
    return rt.ld64((*l).rec.ptr, i * REC + f)
}

fn view(l: *mut Listing, off: u64, len: u64) -> str {
    return str { p: ((*l).text.ptr + off) as *u8, n: len as usize }
}

fn list_count(l: *mut Listing) -> usize { return (*l).count }
fn list_path(l: *mut Listing, i: usize) -> str {
    return view(l, field(l, i, F_PATH_OFF), field(l, i, F_PATH_LEN))
}
fn list_name(l: *mut Listing, i: usize) -> str {
    return view(l, field(l, i, F_NAME_OFF), field(l, i, F_NAME_LEN))
}
fn list_etag(l: *mut Listing, i: usize) -> str {
    return view(l, field(l, i, F_ETAG_OFF), field(l, i, F_ETAG_LEN))
}
fn list_ctype(l: *mut Listing, i: usize) -> str {
    return view(l, field(l, i, F_CTYPE_OFF), field(l, i, F_CTYPE_LEN))
}
fn list_display(l: *mut Listing, i: usize) -> str {
    return view(l, field(l, i, F_DISP_OFF), field(l, i, F_DISP_LEN))
}
fn list_is_dir(l: *mut Listing, i: usize) -> bool { return field(l, i, F_IS_DIR) != 0 as u64 }
fn list_size(l: *mut Listing, i: usize) -> u64 { return field(l, i, F_SIZE) }
fn list_mtime(l: *mut Listing, i: usize) -> u64 { return field(l, i, F_MTIME) }
fn list_status(l: *mut Listing, i: usize) -> u32 { return field(l, i, F_STATUS) as u32 }

fn propfind_body(out: *mut rt.Buf) {
    let s: str = "<?xml version=\"1.0\" encoding=\"utf-8\"?><D:propfind xmlns:D=\"DAV:\"><D:prop><D:resourcetype/><D:getcontentlength/><D:getlastmodified/><D:getetag/><D:getcontenttype/><D:displayname/></D:prop></D:propfind>"
    rt.buf_push_bytes(out, s.p as u64, s.n)
}

fn local_is(d: *mut xml.Doc, node: u32, want: str) -> bool {
    let nm: str = xml.name(d, node)
    var start: usize = 0
    var i: usize = 0
    while i < nm.length() {
        if nm.chars(i) == 58 as u8 {
            start = i + 1
        }
        i = i + 1
    }
    let ln: usize = nm.length() - start
    if ln != want.length() {
        return false
    }
    return rt.mem_eq(nm.p as u64 + start as u64, want.p as u64, ln)
}

fn find_local(d: *mut xml.Doc, parent: u32, want: str) -> u32 {
    var c: u32 = xml.first(d, parent)
    while c != xml.NONE {
        if xml.kind(d, c) == xml.ELEMENT && local_is(d, c, want) {
            return c
        }
        c = xml.next(d, c)
    }
    return xml.NONE
}

fn node_text(d: *mut xml.Doc, node: u32, tmp: *mut rt.Buf, at: *mut usize) -> usize {
    rt.buf_clear(tmp)
    if node == xml.NONE {
        *at = 0
        return 0
    }
    xml.text_all(d, node, tmp)
    var s: usize = 0
    var e: usize = (*tmp).len
    while s < e && is_blank(rt.ld8((*tmp).ptr, s)) {
        s = s + 1
    }
    while e > s && is_blank(rt.ld8((*tmp).ptr, e - 1)) {
        e = e - 1
    }
    *at = s
    return e - s
}

fn is_blank(c: u8) -> bool {
    return c == 32 as u8 || c == 9 as u8 || c == 10 as u8 || c == 13 as u8
}

fn status_code_of(p: u64, n: usize) -> u32 {
    var i: usize = 0
    while i < n && rt.ld8(p, i) != 32 as u8 {
        i = i + 1
    }
    while i < n && rt.ld8(p, i) == 32 as u8 {
        i = i + 1
    }
    if i + 3 > n {
        return 0 as u32
    }
    var v: u32 = 0 as u32
    var k: usize = 0
    while k < 3 {
        let c: u8 = rt.ld8(p, i + k)
        if c < 48 as u8 || c > 57 as u8 {
            return 0 as u32
        }
        v = v * 10 as u32 + (c - 48 as u8) as u32
        k = k + 1
    }
    return v
}

fn parse_u64(p: u64, n: usize) -> u64 {
    var v: u64 = 0 as u64
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c < 48 as u8 || c > 57 as u8 {
            return v
        }
        v = v * 10 as u64 + (c - 48 as u8) as u64
        i = i + 1
    }
    return v
}

fn arena_push(l: *mut Listing, p: u64, n: usize) -> u64 {
    let off: u64 = (*l).text.len as u64
    rt.buf_push_bytes(&(*l).text, p, n)
    return off
}

fn rec_put(l: *mut Listing, f: usize, v: u64) {
    rt.buf_reserve(&(*l).rec, (*l).rec.len + 8)
    rt.st64((*l).rec.ptr, (*l).count * REC + f, v)
}

fn read_prop(l: *mut Listing, d: *mut xml.Doc, prop: u32, tmp: *mut rt.Buf, is_dir: *mut bool) {
    var at: usize = 0
    var n: usize = 0
    let rt_node: u32 = find_local(d, prop, "resourcetype")
    if rt_node != xml.NONE && find_local(d, rt_node, "collection") != xml.NONE {
        *is_dir = true
    }
    n = node_text(d, find_local(d, prop, "getcontentlength"), tmp, &at)
    if n > 0 {
        rec_put(l, F_SIZE, parse_u64((*tmp).ptr + at as u64, n))
    }
    n = node_text(d, find_local(d, prop, "getlastmodified"), tmp, &at)
    if n > 0 {
        rec_put(l, F_MTIME, httpstate.http_date((*tmp).ptr + at as u64, n))
    }
    n = node_text(d, find_local(d, prop, "getetag"), tmp, &at)
    if n > 0 {
        rec_put(l, F_ETAG_OFF, arena_push(l, (*tmp).ptr + at as u64, n))
        rec_put(l, F_ETAG_LEN, n as u64)
    }
    n = node_text(d, find_local(d, prop, "getcontenttype"), tmp, &at)
    if n > 0 {
        rec_put(l, F_CTYPE_OFF, arena_push(l, (*tmp).ptr + at as u64, n))
        rec_put(l, F_CTYPE_LEN, n as u64)
    }
    n = node_text(d, find_local(d, prop, "displayname"), tmp, &at)
    if n > 0 {
        rec_put(l, F_DISP_OFF, arena_push(l, (*tmp).ptr + at as u64, n))
        rec_put(l, F_DISP_LEN, n as u64)
    }
}

fn add_response(l: *mut Listing, d: *mut xml.Doc, resp: u32, root: str) -> bool {
    var tmp: rt.Buf = rt.buf_new()
    var raw: rt.Buf = rt.buf_new()
    var dec: rt.Buf = rt.buf_new()
    var at: usize = 0
    rt.buf_reserve(&(*l).rec, ((*l).count + 1) * REC * 8)
    rt.mem_set((*l).rec.ptr + ((*l).count * REC * 8) as u64, 0 as u8, REC * 8)
    let hn: usize = node_text(d, find_local(d, resp, "href"), &tmp, &at)
    if hn == 0 {
        rt.buf_free(&tmp)
        rt.buf_free(&raw)
        rt.buf_free(&dec)
        return false
    }
    wd_path.href_to_path(tmp.ptr + at as u64, hn, &raw)
    if !wd_path.pct_decode(raw.ptr, raw.len, &dec) {
        rt.buf_free(&tmp)
        rt.buf_free(&raw)
        rt.buf_free(&dec)
        return false
    }
    var is_dir: bool = false
    if dec.len > 0 && rt.ld8(dec.ptr, dec.len - 1) == 47 as u8 {
        is_dir = true
    }
    var rs: usize = 0
    let rl: usize = root.length()
    if rl > 0 && dec.len >= rl && rt.mem_eq(dec.ptr, root.p as u64, rl) &&
    (dec.len == rl || rt.ld8(dec.ptr, rl) == 47 as u8) {
        rs = rl
    }
    var rel: rt.Buf = rt.buf_new()
    if !wd_path.path_normalize(dec.ptr + rs as u64, dec.len - rs, &rel) {
        rt.buf_free(&tmp)
        rt.buf_free(&raw)
        rt.buf_free(&dec)
        rt.buf_free(&rel)
        return false
    }
    rec_put(l, F_PATH_OFF, arena_push(l, rel.ptr, rel.len))
    rec_put(l, F_PATH_LEN, rel.len as u64)
    var nat: usize = 0
    let nlen: usize = wd_path.path_last_segment(rel.ptr, rel.len, &nat)
    rec_put(l, F_NAME_OFF, (*l).text.len as u64 - rel.len as u64 + nat as u64)
    rec_put(l, F_NAME_LEN, nlen as u64)
    var status: u32 = 0 as u32
    let st_node: u32 = find_local(d, resp, "status")
    if st_node != xml.NONE {
        let sn: usize = node_text(d, st_node, &tmp, &at)
        status = status_code_of(tmp.ptr + at as u64, sn)
    }
    var ps: u32 = xml.first(d, resp)
    var best: u32 = 0 as u32
    var have_prop: bool = false
    while ps != xml.NONE {
        if xml.kind(d, ps) == xml.ELEMENT && local_is(d, ps, "propstat") {
            var code: u32 = 200 as u32
            let sn2: u32 = find_local(d, ps, "status")
            if sn2 != xml.NONE {
                let n2: usize = node_text(d, sn2, &tmp, &at)
                code = status_code_of(tmp.ptr + at as u64, n2)
            }
            if best == 0 as u32 {
                best = code
            }
            if code >= 200 as u32 && code < 300 as u32 && !have_prop {
                have_prop = true
                best = code
                let prop: u32 = find_local(d, ps, "prop")
                if prop != xml.NONE {
                    read_prop(l, d, prop, &tmp, &is_dir)
                }
            }
        }
        ps = xml.next(d, ps)
    }
    if status == 0 as u32 {
        status = best
    }
    rec_put(l, F_STATUS, status as u64)
    if is_dir {
        rec_put(l, F_IS_DIR, 1 as u64)
    }
    (*l).count = (*l).count + 1
    rt.buf_set_len(&(*l).rec, (*l).count * REC * 8)
    rt.buf_free(&tmp)
    rt.buf_free(&raw)
    rt.buf_free(&dec)
    rt.buf_free(&rel)
    return true
}

fn parse_multistatus(l: *mut Listing, root: str, p: u64, n: usize) -> bool {
    var d: xml.Doc = xml.doc_new()
    defer xml.doc_free(&d)
    let ok: bool = xml.parse(&d, p, n) catch false
    if !ok {
        return false
    }
    let r: u32 = xml.root(&d)
    if !local_is(&d, r, "multistatus") {
        return false
    }
    var resp: u32 = xml.first(&d, r)
    while resp != xml.NONE {
        if xml.kind(&d, resp) == xml.ELEMENT && local_is(&d, resp, "response") {
            if !add_response(l, &d, resp, root) {
                return false
            }
        }
        resp = xml.next(&d, resp)
    }
    return true
}
