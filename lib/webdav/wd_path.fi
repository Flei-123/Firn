// SPDX-License-Identifier: MPL-2.0
// lib/webdav/wd_path.fi -- webdav.wd_path: percent encoding of WebDAV paths, href to path, normalisation without "..", join, last segment.
import std.rt
import std.str

export {
    pct_encode_path, pct_decode, hex_val, href_to_path, path_join,
    path_last_segment, path_normalize, starts_with_ci,
}

fn hex_val(c: u8) -> i32 {
    if c >= 48 as u8 && c <= 57 as u8 {
        return (c - 48 as u8) as i32
    }
    if c >= 65 as u8 && c <= 70 as u8 {
        return (c - 55 as u8) as i32
    }
    if c >= 97 as u8 && c <= 102 as u8 {
        return (c - 87 as u8) as i32
    }
    return -1
}

fn path_safe(c: u8) -> bool {
    if c >= 48 as u8 && c <= 57 as u8 {
        return true
    }
    if c >= 65 as u8 && c <= 90 as u8 {
        return true
    }
    if c >= 97 as u8 && c <= 122 as u8 {
        return true
    }
    return c == 45 as u8 || c == 46 as u8 || c == 95 as u8 || c == 126 as u8 || c == 47 as u8
}

fn hex_digit_up(v: u8) -> u8 {
    if v < 10 as u8 {
        return 48 as u8 + v
    }
    return 55 as u8 + v
}

fn pct_encode_path(p: u64, n: usize, out: *mut rt.Buf) {
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if path_safe(c) {
            rt.buf_push(out, c)
        } else {
            rt.buf_push(out, 37 as u8)
            rt.buf_push(out, hex_digit_up(c >> 4 as u8))
            rt.buf_push(out, hex_digit_up(c & 15 as u8))
        }
        i = i + 1
    }
}

fn pct_decode(p: u64, n: usize, out: *mut rt.Buf) -> bool {
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c == 37 as u8 {
            if i + 2 >= n {
                return false
            }
            let a: i32 = hex_val(rt.ld8(p, i + 1))
            let b: i32 = hex_val(rt.ld8(p, i + 2))
            if a < 0 || b < 0 {
                return false
            }
            rt.buf_push(out, (a * 16 + b) as u8)
            i = i + 3
        } else {
            rt.buf_push(out, c)
            i = i + 1
        }
    }
    return true
}

fn starts_with_ci(p: u64, n: usize, lit: str) -> bool {
    if n < lit.length() {
        return false
    }
    var i: usize = 0
    while i < lit.length() {
        var a: u8 = rt.ld8(p, i)
        var b: u8 = lit.chars(i)
        if a >= 65 as u8 && a <= 90 as u8 {
            a = a + 32 as u8
        }
        if b >= 65 as u8 && b <= 90 as u8 {
            b = b + 32 as u8
        }
        if a != b {
            return false
        }
        i = i + 1
    }
    return true
}

fn href_to_path(p: u64, n: usize, out: *mut rt.Buf) {
    var start: usize = 0
    if starts_with_ci(p, n, "http://") {
        start = 7
    } else if starts_with_ci(p, n, "https://") {
        start = 8
    }
    if start > 0 {
        var i: usize = start
        while i < n && rt.ld8(p, i) != 47 as u8 {
            i = i + 1
        }
        if i >= n {
            rt.buf_push(out, 47 as u8)
            return
        }
        start = i
    }
    var end: usize = n
    var k: usize = start
    while k < n {
        let c: u8 = rt.ld8(p, k)
        if c == 63 as u8 || c == 35 as u8 {
            end = k
            break
        }
        k = k + 1
    }
    rt.buf_push_bytes(out, p + start as u64, end - start)
}

fn path_normalize(p: u64, n: usize, out: *mut rt.Buf) -> bool {
    rt.buf_push(out, 47 as u8)
    var i: usize = 0
    var seg_start: usize = 0
    var first: bool = true
    while i <= n {
        var at_end: bool = i == n
        if !at_end && rt.ld8(p, i) != 47 as u8 {
            i = i + 1
            continue
        }
        let len: usize = i - seg_start
        if len == 0 {
        } else if len == 1 && rt.ld8(p, seg_start) == 46 as u8 {
        } else if len == 2 && rt.ld8(p, seg_start) == 46 as u8 && rt.ld8(p, seg_start + 1) == 46 as u8 {
            return false
        } else {
            if !first {
                rt.buf_push(out, 47 as u8)
            }
            rt.buf_push_bytes(out, p + seg_start as u64, len)
            first = false
        }
        seg_start = i + 1
        i = i + 1
    }
    return true
}

fn path_join(a: u64, na: usize, b: u64, nb: usize, out: *mut rt.Buf) {
    var ea: usize = na
    while ea > 0 && rt.ld8(a, ea - 1) == 47 as u8 {
        ea = ea - 1
    }
    var sb: usize = 0
    while sb < nb && rt.ld8(b, sb) == 47 as u8 {
        sb = sb + 1
    }
    rt.buf_push_bytes(out, a, ea)
    rt.buf_push(out, 47 as u8)
    rt.buf_push_bytes(out, b + sb as u64, nb - sb)
}

fn path_last_segment(p: u64, n: usize, at: *mut usize) -> usize {
    var e: usize = n
    while e > 0 && rt.ld8(p, e - 1) == 47 as u8 {
        e = e - 1
    }
    var s: usize = e
    while s > 0 && rt.ld8(p, s - 1) != 47 as u8 {
        s = s - 1
    }
    *at = s
    return e - s
}
