// SPDX-License-Identifier: MPL-2.0
// lib/async/fut.fi -- futures for `async fn` / `.await` (docs/ASYNC.md, r1563).
import std.gcobj
import async.loop

export {
    Fut, fut_new, fut_set, fut_ready, fut_wait, fut_take, fut_discard,
    fut_frame_new, fut_frame_free, fut_value,
    sleep_ms, block_on, block_on_unit,
}

struct Fut[T] {
    done: bool,
    waiting: bool,
    val: T,
    cb: fn(u64),
    ud: u64,
}

fn fut_bytes[T]() -> usize {
    return size_of[T]() + 64
}

fn fut_new[T]() -> *mut Fut[T] {
    return gcobj.alloc[Fut[T]](fut_bytes[T]()) as *mut Fut[T]
}

fn fut_set[T](f: *mut Fut[T], v: T) {
    (*f).val = v
    (*f).done = true
    if (*f).waiting {
        (*f).waiting = false
        let cb: fn(u64) = (*f).cb
        cb((*f).ud)
    }
}

fn fut_ready[T](f: *mut Fut[T]) -> bool {
    return (*f).done
}

fn fut_wait[T](f: *mut Fut[T], cb: fn(u64), ud: u64) {
    (*f).cb = cb
    (*f).ud = ud
    (*f).waiting = true
}

fn fut_value[T](f: *mut Fut[T]) -> T {
    return (*f).val
}

fn fut_take[T](f: *mut Fut[T]) -> T {
    let v: T = (*f).val
    gcobj.free[Fut[T]](f as u64, fut_bytes[T]())
    return v
}

fn fut_discard[T](f: *mut Fut[T]) {
    gcobj.free[Fut[T]](f as u64, fut_bytes[T]())
}

fn fut_frame_new[F]() -> *mut F {
    return gcobj.alloc[F](size_of[F]()) as *mut F
}

fn fut_frame_free[F](p: *mut F) {
    gcobj.free[F](p as u64, size_of[F]())
}

fn sleep_fired(l: *mut loop.Loop, ud: u64) {
    fut_set[bool](ud as *mut Fut[bool], true)
}

fn sleep_ms(l: *mut loop.Loop, ms: i64) -> *mut Fut[bool] {
    let f: *mut Fut[bool] = fut_new[bool]()
    loop.timer_after(l, ms, sleep_fired, f as u64)
    return f
}

fn block_on[T](l: *mut loop.Loop, f: *mut Fut[T]) -> T {
    while !(*f).done {
        loop.run_once(l, 50)
    }
    return fut_take[T](f)
}

fn block_on_unit[T](l: *mut loop.Loop, f: *mut Fut[T]) {
    while !(*f).done {
        loop.run_once(l, 50)
    }
    fut_discard[T](f)
}
