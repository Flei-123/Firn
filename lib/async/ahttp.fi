// SPDX-License-Identifier: MPL-2.0
// lib/async/ahttp.fi -- an HTTP/1.1 client that never blocks: requests run
// on the event loop and answer through a callback.
//
//     import async.loop
//     import async.ahttp
//
//     fn done(r: *mut ahttp.Request, ud: u64) {
//         if ahttp.areq_error(r) != 0 { ... return }
//         let status: u32 = ahttp.areq_status(r)
//         // ahttp.areq_body_ptr(r) .. areq_body_len(r)
//     }                                     // `r` is freed when this returns
//
//     var a: ahttp.AClient = ahttp.aclient_new()
//     ahttp.aclient_init(&a, &l)
//     ahttp.aclient_get_str(&a, "https://example.com/", 15000, done, 0)
//     loop.run(&l)
//
// It SHARES the parts of net.http that are not about waiting: the request
// is written by `http.build_request` (headers, cookies of the jar, gzip),
// the response head by `http.parse_head`, `Content-Type` by
// `http.split_content_type`, `Content-Encoding: gzip/deflate` by
// `http.undo_encoding`, cookies by `http.harvest_cookies`, and the answer is
// an ordinary `http.Response` (`areq_response`) so every `resp_*` accessor
// of net.http works on it. What it adds is the framing as a PUSH parser: the
// head, then `Content-Length`, `Transfer-Encoding: chunked` or "until the
// peer closes", fed with whatever the stream has delivered so far. https
// goes through the non-blocking TLS handshake of async.stream; the roots,
// jar, redirect limit and gzip switch are those of the embedded
// `net.http.Client` (`aclient_http`), so one program configures both clients
// the same way.
//
// HOW ONE REQUEST GOES (the states are `P_*` below)
//   resolve -> connect (stream_open[_tls]) -> write request -> HEAD ->
//   BODY(len | chunked | close) -> finish: decode, cookies, then either
//   a redirect (a NEW connection, same rules as net.http: 303 and 301/302 of
//   a POST become GET, 307/308 keep method and body, loop and hop limit)
//   or the callback.
//
// ERRORS. `areq_error` is 0 or one of the numbers of `net.http.err_num`
// (1 Url, 2 Scheme, 3 Tls, 4 Resolve, 5 Connect, 6 Send, 7 Recv, 8 Closed,
// 9 Status, 10 Header, 11 Body, 12 Encoding, 13 TooManyRedirects,
// 14 RedirectLoop, 15 TooLarge, 16 OutOfMemory) or, new here,
// AE_TIMEOUT (100: the idle or the total time ran out) / AE_CANCELLED (101).
// `areq_error_name` spells either kind. For a Tls error `areq_tls_error`
// holds the tls.tls_err_num (9 = the certificate was refused).
//
// LAYER. `areq_layer` sorts a failed request into ONE layer a program can
// show to a user (0 = no failure; an HTTP status is not a failure here, read
// `areq_status`): NL_URL 1 (bad URL / scheme), NL_DNS 2 (name not resolved),
// NL_TCP 3 (no connection to the port), NL_TLS_NOROOTS 4 (no trusted roots
// loaded at all -- the platform has no store and the program added none),
// NL_TLS_CERT 5 (the certificate was refused; `areq_tls_verify` says why:
// x509.V_EXPIRED, V_NAME, V_UNKNOWN_ISSUER, V_BAD_SIGNATURE, ...), NL_TLS_OTHER 6
// (handshake or protocol failure; `areq_tls_error` = tls.tls_err_num),
// NL_TIMEOUT 7, NL_CLOSED 8 (connection dropped mid-message / send / recv
// error), NL_CANCELLED 9, NL_OTHER 10. `areq_layer_name` spells it.
//
// ==================================================================== HONEST
//
// H1  ONE REQUEST, ONE CONNECTION AT A TIME. By default every request sends
//     `Connection: close` and opens its own socket (1000 requests = 1000
//     handshakes). `aclient_set_keepalive(a, true)` switches on a SMALL pool
//     (POOL_MAX = 8 idle connections, parked PARK_MS): a finished request whose
//     answer was framed (Content-Length / chunked, HTTP/1.1, no
//     `Connection: close`) parks its stream; the next request to the same
//     address/port/host name takes it and skips connect + TLS handshake. A
//     parked connection that died meanwhile is retried ONCE on a fresh one
//     when no answer octet had arrived. No pipelining: one request per
//     connection at a time.
// H2  NAMES ARE RESOLVED ON THE LOOP (lib/async/adns.fi: non-blocking UDP, the
//     TTL cache of lib/net/dns.fi): a lookup never stalls the loop, phase
//     P_RESOLVE. Cached, numeric and `localhost` names are answered at once.
//     Only when adns cannot start (no IPv4 name server, no socket) the old
//     blocking lookup is used. Only the first address of an answer is tried,
//     then the next ones in order when the connect fails.
// H3  NO RESPONSE CACHE and no conditional requests; that stays in the
//     blocking client. Cookies and redirects are handled.
// H4  THE BODY IS HELD IN MEMORY (limit `BODY_MAX` = 32 MiB, `areq_set_max_body`
//     lowers it). A download to a file belongs to a streaming API, not here.
// H5  `Expect: 100-continue` is not sent; a 1xx answer is skipped.
// H6  TLS 1.3 only, as net.http (T-notes of lib/tls/tls.fi apply).
// H7  An https request needs roots: the system's (unless
//     `client_set_system_trust(false)`) plus `client_add_trust_pem`. None at
//     all is a refusal (error 3), never an unverified connection.
import std.rt
import std.vec
import net.url
import net.http
import net.dns
import async.adns
import std.crypto.sha256
import tls.x509
import tls.trust
import tls.tls
import async.loop
import async.stream

export {
    AClient, Request,
    AE_TIMEOUT, AE_CANCELLED,
    aclient_new, aclient_init, aclient_free, aclient_http,
    aclient_request, aclient_request_inm, aclient_get, aclient_get_inm, aclient_get_str, aclient_post,
    areq_error, areq_tls_error, areq_tls_verify, areq_layer, areq_layer_name,
    NL_NONE, NL_URL, NL_DNS, NL_TCP, NL_TLS_NOROOTS, NL_TLS_CERT, NL_TLS_OTHER,
    NL_TIMEOUT, NL_CLOSED, NL_CANCELLED, NL_OTHER,
    areq_status, areq_body_ptr, areq_body_len,
    areq_header, areq_response, areq_final_url_ptr, areq_final_url_len,
    ahttp_trust_ms, ahttp_trust_roots, ahttp_pre_ms, aclient_warm, ahttp_open_call_ms, ahttp_ready_ms,
    areq_set_sink, areq_sink_got, areq_sink_digest, areq_sink_failed,
    areq_hops, areq_is_tls, areq_cancel, areq_set_max_body, areq_error_name,
    areq_elapsed_ms, areq_first_ms, aclient_active, aclient_completed,
    aclient_set_keepalive, areq_reused, ahttp_parked, ahttp_reuse_count,
    Got, get_all, got_free_all, got_body,
}

const NL_NONE: u32 = 0
const NL_URL: u32 = 1
const NL_DNS: u32 = 2
const NL_TCP: u32 = 3
const NL_TLS_NOROOTS: u32 = 4
const NL_TLS_CERT: u32 = 5
const NL_TLS_OTHER: u32 = 6
const NL_TIMEOUT: u32 = 7
const NL_CLOSED: u32 = 8
const NL_CANCELLED: u32 = 9
const NL_OTHER: u32 = 10

const AE_TIMEOUT: u32 = 100
const AE_CANCELLED: u32 = 101

const P_CONNECT: u32 = 1
const P_RESOLVE: u32 = 10
const P_HEAD: u32 = 2
const P_BODY_LEN: u32 = 3
const P_CHUNK_SIZE: u32 = 4
const P_CHUNK_DATA: u32 = 5
const P_CHUNK_CRLF: u32 = 6
const P_CHUNK_TRAILER: u32 = 7
const P_BODY_CLOSE: u32 = 8
const P_DONE: u32 = 9

struct AClient {
    c: http.Client,
    l: *mut loop.Loop,
    active: usize,
    completed: u64,
}

struct Request {
    a: *mut AClient,
    cur: url.Url,
    meth: rt.Buf,
    body: rt.Buf,
    ctype: rt.Buf,
    chain: rt.Buf, // URLs seen (loop guard): u32 length + octets
    r: http.Response,
    st: *mut stream.Stream,
    phase: u32,
    cb: fn(*mut Request, u64),
    ud: u64,
    err: u32,
    tlserr: u32,
    tlsverify: u32,
    hops: u32,
    timeout_ms: i64,
    deadline_timer: u64,
    t0: i64,
    t_end: i64,
    t_first: i64, // loop.mono_ms() when the response head was complete (time to first byte), 0 = not yet
    scan: usize, // where the search for CRLFCRLF goes on
    remaining: usize, // octets of the current body / chunk still to come
    maxbody: usize,
    addrs: [u32; 8],
    naddr: usize,
    iaddr: usize,
    port: u16,
    secure: bool,
    is_tls_done: bool,
    gone: bool, // freed or being freed: ignore late events
    defer_pending: bool, // deferred_fail will still look at this request
    busy: u32,
    dq: *mut adns.AQuery, // the DNS lookup in flight (phase P_RESOLVE), else 0
    // a sink: the body of a 200 answer goes to this file (not into memory), hashed on the way
    sink_fd: i64, // -1 = none
    sink_got: u64,
    sink_failed: bool, // the write to the file failed
    sink_sha: sha256.Sha256,
    sink_cb: fn(u64, u64) -> u32, // (ud, octets so far) -> nonzero = abort
    sink_ud: u64,
    keepable: bool, // the answer was framed and not `Connection: close`: the stream may be parked
    reused: bool, // this request runs on a parked connection
    nopool: bool, // do not take a parked connection (the retry after a dead one)
    in0: u64, // stream octets-in when the parked connection was taken
    inm: rt.Buf, // If-None-Match value to send (conditional GET), empty = none
}

// `size_of` needs a generic parameter outside the root file (see stream.fi).
fn ah_obj_alloc[T]() -> u64 {
    let p: u64 = rt.heap_alloc(size_of[T]())
    gc_track[T](p, size_of[T]())
    return p
}

fn ah_obj_free[T](p: u64) {
    gc_untrack[T](p)
    rt.heap_free(p, size_of[T]())
}

// ------------------------------------------------------------------ Client

fn aclient_new() -> AClient {
    return AClient { c: http.client_new(), l: 0 as *mut loop.Loop, active: 0, completed: 0 }
}

// Sets up the embedded blocking client as a CONFIGURATION holder: jar, roots,
// limits. No cache, no keep-alive (H1, H3).
fn aclient_init(a: *mut AClient, l: *mut loop.Loop) -> bool {
    (*a).l = l
    if !http.client_init(&(*a).c) {
        return false
    }
    (*a).c.keep_alive = false
    (*a).c.use_cache = false
    return true
}

fn aclient_free(a: *mut AClient) {
    pool_drop_client(a)
    http.client_free(&(*a).c)
}

// On: requests send `Connection: keep-alive` and finished connections are parked for the next request (H1).
fn aclient_set_keepalive(a: *mut AClient, on: bool) {
    (*a).c.keep_alive = on
    if !on {
        pool_drop_client(a)
    }
}

// The embedded net.http client: `client_add_trust_pem`,
// `client_set_system_trust`, `client_set_max_redirects`, `client_set_gzip`,
// `client_jar` ... all apply.
fn aclient_http(a: *mut AClient) -> *mut http.Client {
    return &(*a).c
}

fn aclient_active(a: *mut AClient) -> usize { return (*a).active }
fn aclient_completed(a: *mut AClient) -> u64 { return (*a).completed }

// ---------------------------------------------------------------- Accessors

fn areq_error(r: *mut Request) -> u32 { return (*r).err }
fn areq_tls_error(r: *mut Request) -> u32 { return (*r).tlserr }
fn areq_tls_verify(r: *mut Request) -> u32 { return (*r).tlsverify }

fn areq_layer(r: *mut Request) -> u32 {
    let e: u32 = (*r).err
    if e == 0 { return NL_NONE }
    if e == 1 || e == 2 { return NL_URL }
    if e == 4 { return NL_DNS }
    if e == 5 { return NL_TCP }
    if e == 3 {
        if (*r).tlserr == 100 as u32 { return NL_TLS_NOROOTS }
        if (*r).tlserr == 9 as u32 || (*r).tlserr == 10 as u32 { return NL_TLS_CERT }
        return NL_TLS_OTHER
    }
    if e == AE_TIMEOUT { return NL_TIMEOUT }
    if e == AE_CANCELLED || e == 17 { return NL_CANCELLED }
    if e == 6 || e == 7 || e == 8 { return NL_CLOSED }
    return NL_OTHER
}

fn areq_layer_name(l: u32) -> str {
    if l == NL_NONE { return "none" }
    if l == NL_URL { return "url" }
    if l == NL_DNS { return "dns" }
    if l == NL_TCP { return "tcp" }
    if l == NL_TLS_NOROOTS { return "tls-noroots" }
    if l == NL_TLS_CERT { return "tls-cert" }
    if l == NL_TLS_OTHER { return "tls-other" }
    if l == NL_TIMEOUT { return "timeout" }
    if l == NL_CLOSED { return "closed" }
    if l == NL_CANCELLED { return "cancelled" }
    return "other"
}
fn areq_status(r: *mut Request) -> u32 { return (*r).r.status }
fn areq_body_ptr(r: *mut Request) -> u64 { return (*r).r.body.ptr }
fn areq_body_len(r: *mut Request) -> usize { return (*r).r.body.len }
fn areq_response(r: *mut Request) -> *mut http.Response { return &(*r).r }
fn areq_final_url_ptr(r: *mut Request) -> u64 { return (&(*r).r.final_url[0]) as u64 }
fn areq_final_url_len(r: *mut Request) -> usize { return (*r).r.nfinal }
fn areq_hops(r: *mut Request) -> u32 { return (*r).hops }
fn areq_is_tls(r: *mut Request) -> bool { return (*r).secure }
fn areq_set_max_body(r: *mut Request, n: usize) { (*r).maxbody = n }
// Milliseconds from the start of the request to the complete response head (0 = no head yet).
fn areq_first_ms(r: *mut Request) -> i64 {
    if (*r).t_first == 0 { return 0 }
    return (*r).t_first - (*r).t0
}

fn areq_elapsed_ms(r: *mut Request) -> i64 {
    var e: i64 = (*r).t_end
    if e == 0 {
        e = loop.mono_ms()
    }
    return e - (*r).t0
}

// The value of a response header (case-insensitive), length 0 = none.
fn areq_header(r: *mut Request, name: u64, n: usize, at: *mut u64) -> usize {
    return http.resp_header(&(*r).r, name, n, at)
}

fn areq_error_name(code: u32, out: *mut rt.Buf) {
    if code == AE_TIMEOUT {
        rt.buf_push_bytes(out, "Timeout".p as u64, 7)
        return
    }
    if code == AE_CANCELLED {
        rt.buf_push_bytes(out, "Cancelled".p as u64, 9)
        return
    }
    if code == 0 {
        rt.buf_push_bytes(out, "Ok".p as u64, 2)
        return
    }
    http.err_name_of(http.err_of(code), out)
}

// ----------------------------------------------------------------- Starting

fn aclient_get_str(a: *mut AClient, u: str, timeout_ms: i64,
    cb: fn(*mut Request, u64), ud: u64) -> *mut Request {
    return aclient_get(a, u.p as u64, u.n, timeout_ms, cb, ud)
}

fn aclient_get(a: *mut AClient, u: u64, n: usize, timeout_ms: i64,
    cb: fn(*mut Request, u64), ud: u64) -> *mut Request {
    return aclient_request(a, "GET".p as u64, 3, u, n, 0 as u64, 0, 0 as u64, 0, timeout_ms, cb, ud)
}

// A conditional GET: `inm` (n octets, 0 = none) is sent as `If-None-Match`; a 304 answer has no body (areq_status == 304).
fn aclient_get_inm(a: *mut AClient, u: u64, n: usize, timeout_ms: i64, inm: u64, ninm: usize,
    cb: fn(*mut Request, u64), ud: u64) -> *mut Request {
    return aclient_request_inm(a, "GET".p as u64, 3, u, n, 0 as u64, 0, 0 as u64, 0, timeout_ms, inm, ninm, cb, ud)
}

fn aclient_post(a: *mut AClient, u: u64, n: usize, body: u64, nb: usize,
    ctype: u64, nct: usize, timeout_ms: i64,
    cb: fn(*mut Request, u64), ud: u64) -> *mut Request {
    return aclient_request(a, "POST".p as u64, 4, u, n, body, nb, ctype, nct, timeout_ms, cb, ud)
}

// `timeout_ms`: the TOTAL time of the request (redirects included); 0 = none.
// The idle time (nothing read or written) is the embedded client's
// `client_set_timeout`. The callback is called exactly once -- also when
// starting fails (then from the NEXT round of the loop, never inside this
// call). Returns 0 only when there is no memory for the request itself.
fn aclient_request(a: *mut AClient, method: u64, nm: usize, u: u64, n: usize,
    body: u64, nb: usize, ctype: u64, nct: usize, timeout_ms: i64,
    cb: fn(*mut Request, u64), ud: u64) -> *mut Request {
    return aclient_request_inm(a, method, nm, u, n, body, nb, ctype, nct, timeout_ms, 0 as u64, 0, cb, ud)
}

// aclient_request plus an `If-None-Match` value (ninm == 0 = none).
fn aclient_request_inm(a: *mut AClient, method: u64, nm: usize, u: u64, n: usize,
    body: u64, nb: usize, ctype: u64, nct: usize, timeout_ms: i64, inm: u64, ninm: usize,
    cb: fn(*mut Request, u64), ud: u64) -> *mut Request {
    let p: u64 = ah_obj_alloc[Request]()
    if p == 0 {
        return 0 as *mut Request
    }
    let rq: *mut Request = p as *mut Request
    *rq = Request { a: a, cur: url.url_new(), meth: rt.buf_new(), body: rt.buf_new(),
        ctype: rt.buf_new(), chain: rt.buf_new(), r: http.resp_new(),
        st: 0 as *mut stream.Stream, phase: P_CONNECT, cb: cb, ud: ud, err: 0,
        tlserr: 0, tlsverify: 0, hops: 0, timeout_ms: timeout_ms, deadline_timer: 0,
        t0: loop.mono_ms(), t_end: 0, t_first: 0, scan: 0, remaining: 0, maxbody: http.BODY_MAX,
        addrs: [0; 8], naddr: 0, iaddr: 0, port: 0 as u16, secure: false,
        is_tls_done: false, gone: false, defer_pending: false, busy: 0,
        dq: 0 as *mut adns.AQuery, sink_fd: 0 - 1, sink_got: 0, sink_failed: false,
        sink_sha: sha256.sha256_new(), sink_cb: sink_none, sink_ud: 0,
        keepable: false, reused: false, nopool: false, in0: 0, inm: rt.buf_new() }
    rt.buf_push_bytes(&(*rq).meth, method, nm)
    rt.buf_push_bytes(&(*rq).body, body, nb)
    rt.buf_push_bytes(&(*rq).ctype, ctype, nct)
    rt.buf_push_bytes(&(*rq).inm, inm, ninm)
    (*a).active = (*a).active + 1
    if !url.url_parse(u, n, &(*rq).cur) {
        (*rq).err = 1
        (*rq).defer_pending = true
        loop.defer_call((*a).l, deferred_fail, p)
        return rq
    }
    if timeout_ms > 0 {
        (*rq).deadline_timer = loop.timer_after((*a).l, timeout_ms, on_deadline, p)
    }
    if !begin(rq) {
        (*rq).defer_pending = true
        loop.defer_call((*a).l, deferred_fail, p)
    }
    return rq
}

// A failure found while starting is reported from the loop, not from inside
// the call that started it.
fn deferred_fail(l: *mut loop.Loop, ud: u64) {
    let rq: *mut Request = ud as *mut Request
    (*rq).defer_pending = false
    if (*rq).gone {
        if (*rq).busy == 0 {
            release(rq)
        }
        return
    }
    finish(rq)
}

fn on_deadline(l: *mut loop.Loop, ud: u64) {
    let rq: *mut Request = ud as *mut Request
    (*rq).deadline_timer = 0
    if (*rq).gone || (*rq).phase == P_DONE {
        return
    }
    fail(rq, AE_TIMEOUT)
}

// Resolves the host and opens the stream for `cur`. false = (*rq).err is set.
fn begin(rq: *mut Request) -> bool {
    let a: *mut AClient = (*rq).a
    if !url.url_is_http(&(*rq).cur) && !url.url_is_https(&(*rq).cur) {
        (*rq).err = 2
        return false
    }
    (*rq).secure = url.url_is_https(&(*rq).cur)
    (*rq).port = url.url_port(&(*rq).cur)
    // H2: a name is looked up on the loop (async.adns), never blocking it.
    let hp: u64 = url.url_host_ptr(&(*rq).cur)
    let hn: usize = url.url_host_len(&(*rq).cur)
    let res: *mut dns.Resolver = http.client_resolver(&(*a).c)
    var o: dns.Resolved = dns.resolved_new()
    let k: u32 = adns.adns_local(res, hp, hn, &o)
    if k == dns.LOCAL_HIT {
        take_addrs(rq, &o)
    } else if k == dns.LOCAL_FAIL {
        (*rq).err = 4
        return false
    } else {
        (*rq).phase = P_RESOLVE
        (*rq).dq = adns.adns_start((*a).l, res, hp, hn, on_dns, rq as u64)
        if (*rq).dq as u64 != 0 {
            // r449: the CPU work of a TLS connect (roots, key shares) runs NOW, while the name server answers (a round trip of idle
            // time), not after it. Both are idempotent: a warmed client / an already drawn pair makes this free.
            if (*rq).secure { prewarm_tls(a) }
            return true // the callback goes on with connect_next
        }
        // could not start (no IPv4 server, no socket): the blocking way
        (*rq).naddr = http.addrs_of_host(&(*a).c, hp, hn, &(*rq).addrs)
    }
    if (*rq).naddr == 0 {
        (*rq).err = 4
        return false
    }
    (*rq).iaddr = 0
    return connect_next(rq)
}

// roots + one pregenerated key-share pair, once; the same work connect_next would do right before the handshake
fn prewarm_tls(a: *mut AClient) {
    if !(*a).c.store_ready {
        if (*a).c.sys_trust {
            let tt0: i64 = loop.mono_ms()
            G_TRUST_ROOTS = trust.trust_load_system(&(*a).c.store)
            G_TRUST_MS = loop.mono_ms() - tt0
        }
        (*a).c.store_ready = true
    }
    let kp: bool = tls.tls_pregen()
}

fn take_addrs(rq: *mut Request, o: *mut dns.Resolved) {
    var i: usize = 0
    while i < (*o).n && i < 8 {
        (*rq).addrs[i] = (*o).addr[i]
        i = i + 1
    }
    (*rq).naddr = i
}

// The lookup of begin() is over (called from the loop).
fn on_dns(ud: u64, ok: bool, o: *mut dns.Resolved) {
    let rq: *mut Request = ud as *mut Request
    (*rq).dq = 0 as *mut adns.AQuery
    if (*rq).gone || (*rq).phase != P_RESOLVE {
        return
    }
    (*rq).busy = (*rq).busy + 1
    if !ok || (*o).n == 0 {
        (*rq).err = 4
        finish(rq)
    } else {
        take_addrs(rq, o)
        (*rq).iaddr = 0
        if !connect_next(rq) {
            finish(rq)
        }
    }
    (*rq).busy = (*rq).busy - 1
    if (*rq).busy == 0 && (*rq).gone && !(*rq).defer_pending {
        release(rq)
    }
}

// ------------------------------------------------------------------ the pool of parked connections (H1)
const POOL_MAX: usize = 8
const PARK_MS: i64 = 20000 // a parked connection is closed after this idle time (servers close idle ones after 60-75 s)

static mut G_PK_S: [u64; 8] = [0; 8]
static mut G_PK_A: [u64; 8] = [0; 8]
static mut G_PK_ADDR: [u32; 8] = [0; 8]
static mut G_PK_PORT: [u32; 8] = [0; 8]
static mut G_PK_SEC: [u32; 8] = [0; 8]
static mut G_PK_HH: [u64; 8] = [0; 8]
static mut G_PK_AT: [i64; 8] = [0; 8]
static mut G_REUSED: u64 = 0

fn ahttp_parked() -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < POOL_MAX {
        if G_PK_S[i] != 0 { n = n + 1 }
        i = i + 1
    }
    return n
}

fn ahttp_reuse_count() -> u64 { return G_REUSED }
fn areq_reused(r: *mut Request) -> bool { return (*r).reused }

fn host_hash(rq: *mut Request) -> u64 {
    var h: u64 = 5381 as u64
    let p: u64 = url.url_host_ptr(&(*rq).cur)
    let n: usize = url.url_host_len(&(*rq).cur)
    var i: usize = 0
    while i < n {
        h = (h * 131 as u64 + (rt.ld8(p, i) as u64)) & 281474976710655 as u64
        i = i + 1
    }
    return h
}

fn pool_drop_slot(i: usize) {
    let s: u64 = G_PK_S[i]
    G_PK_S[i] = 0
    if s != 0 {
        stream.stream_abort(s as *mut stream.Stream)
    }
}

fn pool_drop_client(a: *mut AClient) {
    var i: usize = 0
    while i < POOL_MAX {
        if G_PK_S[i] != 0 && G_PK_A[i] == a as u64 { pool_drop_slot(i) }
        i = i + 1
    }
}

// events of a PARKED stream: closed (by the server or the idle timer) = forget it; data nobody asked for = drop it
fn park_cb(s: *mut stream.Stream, ud: u64, kind: u32, arg: i64) {
    var i: usize = 0
    while i < POOL_MAX {
        if G_PK_S[i] == s as u64 {
            if kind == stream.SE_CLOSED {
                G_PK_S[i] = 0
            } else if kind == stream.SE_DATA {
                pool_drop_slot(i)
            }
            return
        }
        i = i + 1
    }
}

fn pool_find(rq: *mut Request, addr: u32) -> i64 {
    let hh: u64 = host_hash(rq)
    let sec: u32 = if (*rq).secure { 1 } else { 0 }
    var i: usize = 0
    while i < POOL_MAX {
        if G_PK_S[i] != 0 && G_PK_A[i] == (*rq).a as u64 && G_PK_ADDR[i] == addr && G_PK_PORT[i] == (*rq).port as u32 && G_PK_SEC[i] == sec && G_PK_HH[i] == hh {
            return i as i64
        }
        i = i + 1
    }
    return 0 - 1
}

fn pool_park(rq: *mut Request, s: *mut stream.Stream) -> bool {
    var slot: usize = POOL_MAX
    var oldest: usize = 0
    var i: usize = 0
    while i < POOL_MAX {
        if G_PK_S[i] == 0 && slot == POOL_MAX { slot = i }
        if G_PK_S[i] != 0 && G_PK_AT[i] < G_PK_AT[oldest] { oldest = i }
        i = i + 1
    }
    if slot == POOL_MAX {
        pool_drop_slot(oldest)
        slot = oldest
    }
    G_PK_S[slot] = s as u64
    G_PK_A[slot] = (*rq).a as u64
    G_PK_ADDR[slot] = stream.stream_peer(s)
    G_PK_PORT[slot] = (*rq).port as u32
    G_PK_SEC[slot] = if (*rq).secure { 1 } else { 0 }
    G_PK_HH[slot] = host_hash(rq)
    G_PK_AT[slot] = loop.mono_ms()
    stream.stream_set_callback(s, park_cb, 0)
    stream.stream_set_timeout(s, PARK_MS)
    return true
}

// may the stream of this finished request be parked?
fn can_park(rq: *mut Request, s: *mut stream.Stream) -> bool {
    if !(*(*rq).a).c.keep_alive || !(*rq).keepable || (*rq).err != 0 || (*rq).sink_fd >= 0 { return false }
    if !stream.stream_is_open(s) || stream.stream_in_len(s) != 0 || stream.stream_out_pending(s) != 0 { return false }
    return true
}

// the request goes out on a parked connection one loop turn later (never from inside aclient_request)
fn reuse_go(l: *mut loop.Loop, ud: u64) {
    let rq: *mut Request = ud as *mut Request
    (*rq).defer_pending = false
    if (*rq).gone || (*rq).phase != P_CONNECT || (*rq).st as u64 == 0 {
        if (*rq).gone && (*rq).busy == 0 { release(rq) }
        return
    }
    (*rq).busy = (*rq).busy + 1
    send_request(rq, (*rq).st)
    (*rq).busy = (*rq).busy - 1
    if (*rq).busy == 0 && (*rq).gone && !(*rq).defer_pending { release(rq) }
}

// a parked connection was dead (nothing of an answer arrived): ask again on a fresh one, once
fn retry_fresh(rq: *mut Request, s: *mut stream.Stream) -> bool {
    if !(*rq).reused || stream.stream_bytes_in(s) != (*rq).in0 { return false }
    (*rq).reused = false
    (*rq).nopool = true
    (*rq).err = 0
    (*rq).phase = P_CONNECT
    return connect_next(rq)
}

fn connect_next(rq: *mut Request) -> bool {
    let a: *mut AClient = (*rq).a
    let addr: u32 = (*rq).addrs[(*rq).iaddr]
    (*rq).phase = P_CONNECT
    (*rq).scan = 0
    rt.buf_clear(&(*rq).r.raw)
    (*rq).keepable = false
    if (*a).c.keep_alive && !(*rq).nopool {
        let k: i64 = pool_find(rq, addr)
        if k >= 0 {
            let ps: *mut stream.Stream = G_PK_S[k as usize] as *mut stream.Stream
            G_PK_S[k as usize] = 0
            stream.stream_set_callback(ps, on_stream, rq as u64)
            stream.stream_set_timeout(ps, (*a).c.timeout_ms as i64)
            (*rq).st = ps
            (*rq).reused = true
            (*rq).in0 = stream.stream_bytes_in(ps)
            G_REUSED = G_REUSED + 1 as u64
            (*rq).defer_pending = true
            loop.defer_call((*a).l, reuse_go, rq as u64)
            return true
        }
    }
    var s: *mut stream.Stream = 0 as *mut stream.Stream
    let idle: i64 = (*a).c.timeout_ms as i64
    if (*rq).secure {
        if !(*a).c.store_ready {
            if (*a).c.sys_trust {
                let tt0: i64 = loop.mono_ms()
                G_TRUST_ROOTS = trust.trust_load_system(&(*a).c.store)
                G_TRUST_MS = loop.mono_ms() - tt0
            }
            (*a).c.store_ready = true
        }
        if x509.store_count(&(*a).c.store) == 0 {
            (*rq).err = 3
            (*rq).tlserr = 100 as u32 // no roots
            return false
        }
        let hn: usize = url.url_host_len(&(*rq).cur)
        let hs: str = str { p: url.url_host_ptr(&(*rq).cur) as *mut u8, n: hn }
        G_OPEN_T0 = loop.mono_ms()
        G_PRE_MS = G_OPEN_T0 - (*rq).t0
        s = stream.stream_open_tls((*a).l, addr, (*rq).port, hs, &(*a).c.store,
            http.client_now(&(*a).c), idle, on_stream, rq as u64)
        G_OPEN_CALL_MS = loop.mono_ms() - G_OPEN_T0
    } else {
        s = stream.stream_open((*a).l, addr, (*rq).port, idle, on_stream, rq as u64)
    }
    if s as u64 == 0 {
        (*rq).err = 5
        return false
    }
    (*rq).st = s
    return true
}

// -------------------------------------------------------------- The stream

fn on_stream(s: *mut stream.Stream, ud: u64, kind: u32, arg: i64) {
    let rq: *mut Request = ud as *mut Request
    if (*rq).gone || s != (*rq).st {
        return // an old stream (before a redirect / after a cancel)
    }
    (*rq).busy = (*rq).busy + 1
    handle(rq, s, kind, arg)
    (*rq).busy = (*rq).busy - 1
    if (*rq).busy == 0 && (*rq).gone {
        release(rq)
    }
}

fn handle(rq: *mut Request, s: *mut stream.Stream, kind: u32, arg: i64) {
    if kind == stream.SE_CONNECTED {
        G_READY_MS = loop.mono_ms() - G_OPEN_T0
        send_request(rq, s)
    } else if kind == stream.SE_DATA {
        feed(rq, s)
    } else if kind == stream.SE_CLOSED {
        (*rq).st = 0 as *mut stream.Stream
        on_closed(rq, s, arg)
    }
}

fn send_request(rq: *mut Request, s: *mut stream.Stream) {
    let a: *mut AClient = (*rq).a
    var req: rt.Buf = rt.buf_new()
    http.build_request(&(*a).c, &(*rq).cur, (*rq).meth.ptr, (*rq).meth.len,
        (*rq).body.ptr, (*rq).body.len, (*rq).ctype.ptr, (*rq).ctype.len,
        (*rq).inm.ptr, (*rq).inm.len, 0 as u64, 0, &req)
    let ok: bool = stream.stream_write(s, req.ptr, req.len)
    rt.buf_free(&req)
    if !ok {
        fail(rq, 6)
        return
    }
    (*rq).phase = P_HEAD
    (*rq).scan = 0
    (*rq).is_tls_done = true
}

fn on_closed(rq: *mut Request, s: *mut stream.Stream, reason: i64) {
    if (*rq).phase == P_DONE {
        return
    }
    if (*rq).reused && (*rq).phase <= P_HEAD && reason != stream.CL_TIMEOUT && retry_fresh(rq, s) {
        return
    }
    if (*rq).phase == P_BODY_CLOSE && reason == stream.CL_EOF {
        finish_response(rq)
        return
    }
    if (*rq).phase == P_CONNECT {
        if reason == stream.CL_TIMEOUT {
            (*rq).err = AE_TIMEOUT
        } else if reason == stream.CL_TLS {
            (*rq).err = 3
            (*rq).tlserr = stream.stream_tls_error(s)
            (*rq).tlsverify = stream.stream_tls_verify(s)
        } else {
            // a connect that failed: the next address, if the answer had more
            if (*rq).iaddr + 1 < (*rq).naddr {
                (*rq).iaddr = (*rq).iaddr + 1
                if connect_next(rq) {
                    return
                }
                finish(rq)
                return
            }
            (*rq).err = 5
        }
        finish(rq)
        return
    }
    if reason == stream.CL_TIMEOUT {
        (*rq).err = AE_TIMEOUT
    } else if reason == stream.CL_TLS {
        (*rq).err = 3
        (*rq).tlserr = stream.stream_tls_error(s)
        (*rq).tlsverify = stream.stream_tls_verify(s)
    } else if reason == stream.CL_EOF {
        (*rq).err = 8 // closed in the middle of a message
    } else {
        (*rq).err = 7
    }
    finish(rq)
}

// ----------------------------------------------------------- The push parser

fn find_crlfcrlf(p: u64, n: usize, from: usize) -> usize {
    var i: usize = from
    while i + 4 <= n {
        if rt.ld8(p, i) == 13 as u8 && rt.ld8(p, i + 1) == 10 as u8 &&
        rt.ld8(p, i + 2) == 13 as u8 && rt.ld8(p, i + 3) == 10 as u8 {
            return i + 4
        }
        i = i + 1
    }
    return 0
}

fn hexv(ch: u8) -> i32 {
    if ch >= 48 as u8 && ch <= 57 as u8 {
        return (ch - 48 as u8) as i32
    }
    if ch >= 97 as u8 && ch <= 102 as u8 {
        return (ch - 97 as u8) as i32 + 10
    }
    if ch >= 65 as u8 && ch <= 70 as u8 {
        return (ch - 65 as u8) as i32 + 10
    }
    return 0 - 1
}

// Timing of the last https request (r110 measurement): the system roots load, the
// stream_open_tls call, and open -> ready (TCP + TLS handshake), in ms.
static mut G_TRUST_MS: i64 = 0 - 1
static mut G_TRUST_ROOTS: usize = 0
static mut G_OPEN_T0: i64 = 0
static mut G_OPEN_CALL_MS: i64 = 0 - 1
static mut G_READY_MS: i64 = 0 - 1
static mut G_PRE_MS: i64 = 0 - 1
// request created -> TLS stream opened (name lookup + system roots load), ms
fn ahttp_pre_ms() -> i64 { return G_PRE_MS }

// Loads the system trust roots NOW (off the request's critical path): call it once at start-up or when the user is about to go
// online. A no-op when they are loaded already or when system trust is switched off. Returns the number of roots in the store.
fn aclient_warm(a: *mut AClient) -> usize {
    if !(*a).c.store_ready {
        if (*a).c.sys_trust {
            let tt0: i64 = loop.mono_ms()
            G_TRUST_ROOTS = trust.trust_load_system(&(*a).c.store)
            G_TRUST_MS = loop.mono_ms() - tt0
        }
        (*a).c.store_ready = true
    }
    // the key shares of the next TLS handshake too (see tls.tls_pregen)
    let kp: bool = tls.tls_pregen()
    return x509.store_count(&(*a).c.store)
}
fn ahttp_trust_ms() -> i64 { return G_TRUST_MS }
fn ahttp_trust_roots() -> usize { return G_TRUST_ROOTS }
fn ahttp_open_call_ms() -> i64 { return G_OPEN_CALL_MS }
fn ahttp_ready_ms() -> i64 { return G_READY_MS }

fn sink_none(ud: u64, got: u64) -> u32 {
    return 0 as u32
}

// H4b  A SINK (`areq_set_sink`): a 200 answer's body is written to an open
//     file descriptor as it comes (and hashed with SHA-256), never held in
//     memory; the size limit is `areq_set_max_body` over the octets written.
//     Call it right after `aclient_get` returns (the first byte of the answer
//     comes later, from the loop). The descriptor stays the caller's.
//     `cb(ud, got)` runs after every write; a nonzero result aborts the
//     request with AE_CANCELLED. Redirect bodies and error pages are not written.
fn areq_set_sink(rq: *mut Request, fd: i64, cb: fn(u64, u64) -> u32, ud: u64) {
    (*rq).sink_fd = fd
    (*rq).sink_cb = cb
    (*rq).sink_ud = ud
    (*rq).sink_got = 0
    (*rq).sink_failed = false
    (*rq).sink_sha = sha256.sha256_new()
}

fn areq_sink_got(rq: *mut Request) -> u64 { return (*rq).sink_got }
fn areq_sink_failed(rq: *mut Request) -> bool { return (*rq).sink_failed }

// The SHA-256 of what was written (call once, from the done callback).
fn areq_sink_digest(rq: *mut Request, out: u64) {
    sha256.sha256_final(&(*rq).sink_sha, out)
}

fn sink_take(rq: *mut Request, s: *mut stream.Stream, n: usize) -> bool {
    if (*rq).sink_got + n as u64 > (*rq).maxbody as u64 {
        fail(rq, 15)
        return false
    }
    let p: u64 = stream.stream_in_ptr(s)
    var done: usize = 0
    while done < n {
        let w: i64 = syscall(1, (*rq).sink_fd, (p + done as u64) as i64, (n - done) as i64, 0, 0, 0)
        if w == 0 - 4 {
            continue
        }
        if w <= 0 {
            (*rq).sink_failed = true
            fail(rq, 7)
            return false
        }
        done = done + w as usize
    }
    sha256.sha256_update(&(*rq).sink_sha, p, n)
    (*rq).sink_got = (*rq).sink_got + n as u64
    stream.stream_consume(s, n)
    let cb: fn(u64, u64) -> u32 = (*rq).sink_cb
    if cb((*rq).sink_ud, (*rq).sink_got) != 0 as u32 {
        fail(rq, AE_CANCELLED)
        return false
    }
    return true
}

// Takes `n` octets of the stream's input into the body.
fn take_body(rq: *mut Request, s: *mut stream.Stream, n: usize) -> bool {
    if (*rq).sink_fd >= 0 && (*rq).r.status == 200 {
        return sink_take(rq, s, n)
    }
    if (*rq).r.body.len + n > (*rq).maxbody {
        fail(rq, 15)
        return false
    }
    rt.buf_push_bytes(&(*rq).r.body, stream.stream_in_ptr(s), n)
    stream.stream_consume(s, n)
    return true
}

// Called whenever input has arrived. Goes on as far as the input allows.
fn feed(rq: *mut Request, s: *mut stream.Stream) {
    while !(*rq).gone && (*rq).phase != P_DONE && (*rq).st == s {
        let have: usize = stream.stream_in_len(s)
        let p: u64 = stream.stream_in_ptr(s)
        if (*rq).phase == P_HEAD {
            let end: usize = find_crlfcrlf(p, have, (*rq).scan)
            if end == 0 {
                if have > http.HDR_MAX {
                    fail(rq, 10)
                    return
                }
                (*rq).scan = 0
                if have > 3 {
                    (*rq).scan = have - 3
                }
                return
            }
            if (*rq).t_first == 0 { (*rq).t_first = loop.mono_ms() }
            rt.buf_clear(&(*rq).r.raw)
            rt.buf_push_bytes(&(*rq).r.raw, p, end)
            stream.stream_consume(s, end)
            (*rq).scan = 0
            let okp: bool = http.parse_head(&(*rq).r) catch | e | set_err(rq, http.err_num(e))
            if !okp {
                finish(rq)
                return
            }
            if (*rq).r.status < 200 as u32 && (*rq).r.status != 101 as u32 {
                continue // 1xx: the real answer follows (H5)
            }
            if !start_body(rq) {
                return
            }
            continue
        }
        if (*rq).phase == P_BODY_LEN {
            var k: usize = (*rq).remaining
            if have < k {
                k = have
            }
            if k > 0 {
                if !take_body(rq, s, k) {
                    return
                }
                (*rq).remaining = (*rq).remaining - k
            }
            if (*rq).remaining == 0 {
                finish_response(rq)
                return
            }
            return
        }
        if (*rq).phase == P_BODY_CLOSE {
            if have > 0 {
                if !take_body(rq, s, have) {
                    return
                }
            }
            return
        }
        // --- chunked
        if (*rq).phase == P_CHUNK_SIZE || (*rq).phase == P_CHUNK_TRAILER ||
        (*rq).phase == P_CHUNK_CRLF {
            // one line: up to LF
            var le: usize = 0
            var i: usize = 0
            while i < have {
                if rt.ld8(p, i) == 10 as u8 {
                    le = i + 1
                    break
                }
                i = i + 1
            }
            if le == 0 {
                if have > 8192 {
                    fail(rq, 11)
                }
                return
            }
            var ll: usize = le - 1
            if ll > 0 && rt.ld8(p, ll - 1) == 13 as u8 {
                ll = ll - 1
            }
            if (*rq).phase == P_CHUNK_CRLF {
                if ll != 0 {
                    fail(rq, 11)
                    return
                }
                stream.stream_consume(s, le)
                (*rq).phase = P_CHUNK_SIZE
                continue
            }
            if (*rq).phase == P_CHUNK_TRAILER {
                stream.stream_consume(s, le)
                if ll == 0 {
                    (*rq).r.wire = (*rq).r.body.len
                    finish_response(rq)
                    return
                }
                continue
            }
            // the chunk size line: hex digits, then an optional extension
            var size: usize = 0
            var any: bool = false
            var q: usize = 0
            while q < ll {
                let ch: u8 = rt.ld8(p, q)
                if ch == 59 as u8 || ch == 32 as u8 || ch == 9 as u8 {
                    break
                }
                let v: i32 = hexv(ch)
                if v < 0 {
                    fail(rq, 11)
                    return
                }
                any = true
                size = size * 16 + v as usize
                if size > (*rq).maxbody {
                    fail(rq, 15)
                    return
                }
                q = q + 1
            }
            if !any {
                fail(rq, 11)
                return
            }
            stream.stream_consume(s, le)
            if size == 0 {
                (*rq).phase = P_CHUNK_TRAILER
            } else {
                (*rq).r.chunks = (*rq).r.chunks + 1 as u32
                (*rq).remaining = size
                (*rq).phase = P_CHUNK_DATA
            }
            continue
        }
        if (*rq).phase == P_CHUNK_DATA {
            var k2: usize = (*rq).remaining
            if have < k2 {
                k2 = have
            }
            if k2 > 0 {
                if !take_body(rq, s, k2) {
                    return
                }
                (*rq).remaining = (*rq).remaining - k2
            }
            if (*rq).remaining == 0 {
                (*rq).phase = P_CHUNK_CRLF
                continue
            }
            return
        }
        return
    }
}

// `catch |e| set_err(rq, http.err_num(e))`: parks the error number and
// answers false (an error type of another module cannot be named here).
fn set_err(rq: *mut Request, n: u32) -> bool {
    (*rq).err = n
    return false
}

// The head is parsed: decide how long the body is (RFC 9112 6.3).
fn start_body(rq: *mut Request) -> bool {
    let r: *mut http.Response = &(*rq).r
    var h_te: [u8; 17] = "Transfer-Encoding"
    var h_cl: [u8; 14] = "Content-Length"
    var h_cn: [u8; 10] = "Connection"
    var at: u64 = 0
    let nte: usize = http.resp_header(r, (&h_te[0]) as u64, 17, &at)
    var chunked: bool = false
    if nte > 0 {
        var ck: [u8; 7] = "chunked"
        if nte >= 7 && http.ci_eq(at + (nte - 7) as u64, 7, (&ck[0]) as u64, 7) {
            chunked = true
        } else {
            fail(rq, 11)
            return false
        }
    }
    var clen: usize = 0
    var have_clen: bool = false
    var atc: u64 = 0
    let ncl: usize = http.resp_header(r, (&h_cl[0]) as u64, 14, &atc)
    if ncl > 0 {
        var acc: usize = 0
        var any: bool = false
        var i: usize = 0
        while i < ncl {
            let ch: u8 = rt.ld8(atc, i)
            if ch < 48 as u8 || ch > 57 as u8 {
                any = false
                break
            }
            any = true
            acc = acc * 10 + (ch - 48 as u8) as usize
            if acc > (*rq).maxbody {
                fail(rq, 15)
                return false
            }
            i = i + 1
        }
        if !any {
            fail(rq, 10)
            return false
        }
        clen = acc
        have_clen = true
    }
    let bodyless: bool = (*r).status < 200 as u32 || (*r).status == 204 as u32 ||
    (*r).status == 304 as u32 || (*r).status == 101 as u32
    var is_head: bool = false
    if http.ci_eq((*rq).meth.ptr, (*rq).meth.len, "HEAD".p as u64, 4) {
        is_head = true
    }
    (*r).keep = false
    // may the connection stay open after this answer? (HTTP/1.1, no `Connection: close`, body framed)
    var ka: bool = (*rq).sink_fd < 0 && rt.ld8((*r).raw.ptr, 7) == 49 as u8
    if ka {
        var atn: u64 = 0
        let ncn: usize = http.resp_header(r, (&h_cn[0]) as u64, 10, &atn)
        if ncn > 0 {
            var cl: [u8; 5] = "close"
            if http.ci_eq(atn, ncn, (&cl[0]) as u64, 5) { ka = false }
        }
    }
    (*rq).keepable = ka && (bodyless || is_head || chunked || have_clen)
    if bodyless || is_head {
        (*r).wire = 0
        finish_response(rq)
        return false
    }
    if chunked {
        (*rq).phase = P_CHUNK_SIZE
    } else if have_clen {
        (*rq).remaining = clen
        (*r).wire = clen
        (*rq).phase = P_BODY_LEN
        if clen == 0 {
            finish_response(rq)
            return false
        }
    } else {
        (*rq).phase = P_BODY_CLOSE
    }
    return true
}

// -------------------------------------------------------- Finishing

fn finish_response(rq: *mut Request) {
    let r: *mut http.Response = &(*rq).r
    var h_ce: [u8; 16] = "Content-Encoding"
    var atE: u64 = 0
    let nce: usize = http.resp_header(r, (&h_ce[0]) as u64, 16, &atE)
    if nce > 0 && (*r).body.len > 0 {
        let oke: bool = http.undo_encoding(r, atE, nce) catch | e | set_err(rq, http.err_num(e))
        if !oke {
            finish(rq)
            return
        }
    }
    http.split_content_type(r)
    http.harvest_cookies(&(*(*rq).a).c, r, &(*rq).cur)
    // a redirect?
    if http.status_is_redirect((*r).status) {
        var h_loc: [u8; 8] = "Location"
        var atl: u64 = 0
        let nloc: usize = http.resp_header(r, (&h_loc[0]) as u64, 8, &atl)
        if nloc > 0 {
            follow(rq, atl, nloc)
            return
        }
    }
    record_final(rq)
    finish(rq)
}

fn record_final(rq: *mut Request) {
    var key: rt.Buf = rt.buf_new()
    url.url_write(&(*rq).cur, &key)
    var fl: usize = key.len
    if fl > 768 {
        fl = 768
    }
    rt.mem_copy((&(*rq).r.final_url[0]) as u64, key.ptr, fl)
    (*rq).r.nfinal = fl
    (*rq).r.hops = (*rq).hops
    rt.buf_free(&key)
}

fn follow(rq: *mut Request, loc: u64, nloc: usize) {
    let a: *mut AClient = (*rq).a
    if (*rq).hops >= (*a).c.max_redirects {
        (*rq).err = 13
        finish(rq)
        return
    }
    var next: url.Url = url.url_new()
    if !url.url_parse_rel(&(*rq).cur, loc, nloc, &next) {
        (*rq).err = 1
        finish(rq)
        return
    }
    // loop guard: has this URL been fetched on the way here?
    var key: rt.Buf = rt.buf_new()
    url.url_write(&next, &key)
    var i: usize = 0
    var seen: bool = false
    while i + 4 <= (*rq).chain.len {
        let l: usize = rt.ld8((*rq).chain.ptr, i) as usize | ((rt.ld8((*rq).chain.ptr, i + 1) as usize) << 8)
        if l == key.len && rt.mem_eq((*rq).chain.ptr + (i + 4) as u64, key.ptr, l) {
            seen = true
        }
        i = i + 4 + l
    }
    if !seen {
        // the URL we are on counts too (A -> B -> A is a loop)
        var cur_key: rt.Buf = rt.buf_new()
        url.url_write(&(*rq).cur, &cur_key)
        if cur_key.len == key.len && rt.mem_eq(cur_key.ptr, key.ptr, key.len) {
            seen = true
        }
        if (*rq).chain.len == 0 {
            rt.buf_push(&(*rq).chain, (cur_key.len & 255) as u8)
            rt.buf_push(&(*rq).chain, ((cur_key.len >> 8) & 255) as u8)
            rt.buf_push(&(*rq).chain, 0 as u8)
            rt.buf_push(&(*rq).chain, 0 as u8)
            rt.buf_push_bytes(&(*rq).chain, cur_key.ptr, cur_key.len)
        }
        rt.buf_free(&cur_key)
    }
    if seen {
        rt.buf_free(&key)
        (*rq).err = 14
        finish(rq)
        return
    }
    rt.buf_push(&(*rq).chain, (key.len & 255) as u8)
    rt.buf_push(&(*rq).chain, ((key.len >> 8) & 255) as u8)
    rt.buf_push(&(*rq).chain, 0 as u8)
    rt.buf_push(&(*rq).chain, 0 as u8)
    rt.buf_push_bytes(&(*rq).chain, key.ptr, key.len)
    rt.buf_free(&key)
    // 303, and 301/302 of a POST: GET without a body (as net.http)
    let st: u32 = (*rq).r.status
    if st == 303 as u32 || st == 301 as u32 || st == 302 as u32 {
        if http.ci_eq((*rq).meth.ptr, (*rq).meth.len, "POST".p as u64, 4) {
            rt.buf_clear(&(*rq).meth)
            rt.buf_push_bytes(&(*rq).meth, "GET".p as u64, 3)
            rt.buf_clear(&(*rq).body)
            rt.buf_clear(&(*rq).ctype)
        }
    }
    (*rq).cur = next
    (*rq).hops = (*rq).hops + 1
    (*a).c.redirects = (*a).c.redirects + 1
    // the old connection goes (its close event is ignored: st != rq.st)
    let old: *mut stream.Stream = (*rq).st
    (*rq).st = 0 as *mut stream.Stream
    if old as u64 != 0 {
        stream.stream_abort(old)
    }
    http.resp_reset(&(*rq).r)
    rt.buf_clear(&(*rq).r.raw)
    (*rq).err = 0
    if !begin(rq) {
        finish(rq)
    }
}

fn fail(rq: *mut Request, code: u32) {
    if (*rq).phase == P_DONE || (*rq).gone {
        return
    }
    (*rq).err = code
    finish(rq)
}

// The end of every request: stops the stream and the timer, tells the
// program ONCE, frees the request (unless a callback of ours is on the stack).
fn finish(rq: *mut Request) {
    if (*rq).phase == P_DONE {
        return
    }
    (*rq).phase = P_DONE
    (*rq).t_end = loop.mono_ms()
    let a: *mut AClient = (*rq).a
    if (*rq).dq as u64 != 0 {
        adns.adns_cancel((*rq).dq)
        (*rq).dq = 0 as *mut adns.AQuery
    }
    if (*rq).deadline_timer != 0 {
        loop.timer_cancel((*a).l, (*rq).deadline_timer)
        (*rq).deadline_timer = 0
    }
    let old: *mut stream.Stream = (*rq).st
    (*rq).st = 0 as *mut stream.Stream
    if old as u64 != 0 {
        if can_park(rq, old) {
            let pk: bool = pool_park(rq, old)
        } else {
            stream.stream_close(old)
        }
    }
    if (*rq).err != 0 {
        (*rq).r.status = 0
    } else if (*rq).r.nfinal == 0 {
        record_final(rq)
    }
    (*a).active = (*a).active - 1
    (*a).completed = (*a).completed + 1
    (*rq).busy = (*rq).busy + 1
    let cb: fn(*mut Request, u64) = (*rq).cb
    cb(rq, (*rq).ud)
    (*rq).busy = (*rq).busy - 1
    (*rq).gone = true
    if (*rq).busy == 0 && !(*rq).defer_pending {
        release(rq)
    }
}

// Silent: no callback. The request is gone afterwards.
fn areq_cancel(rq: *mut Request) {
    if (*rq).phase == P_DONE || (*rq).gone {
        return
    }
    let a: *mut AClient = (*rq).a
    (*rq).phase = P_DONE
    if (*rq).dq as u64 != 0 {
        adns.adns_cancel((*rq).dq)
        (*rq).dq = 0 as *mut adns.AQuery
    }
    if (*rq).deadline_timer != 0 {
        loop.timer_cancel((*a).l, (*rq).deadline_timer)
        (*rq).deadline_timer = 0
    }
    let old: *mut stream.Stream = (*rq).st
    (*rq).st = 0 as *mut stream.Stream
    if old as u64 != 0 {
        stream.stream_abort(old)
    }
    (*a).active = (*a).active - 1
    (*rq).gone = true
    if (*rq).busy == 0 && !(*rq).defer_pending {
        release(rq)
    }
}

fn release(rq: *mut Request) {
    rt.buf_free(&(*rq).meth)
    rt.buf_free(&(*rq).body)
    rt.buf_free(&(*rq).ctype)
    rt.buf_free(&(*rq).chain)
    rt.buf_free(&(*rq).inm)
    http.resp_free(&(*rq).r)
    ah_obj_free[Request](rq as u64)
}

// ------------------------------------------------------------------ get_all
//
// The `asyncio.gather` / `ThreadPoolExecutor.map` of a script: all URLs at once, one call.
//
//     var urls: Vec[str] = vec_new[str]()
//     vec_push[str](&urls, "http://host/a")
//     vec_push[str](&urls, "http://host/b")
//     var res: Vec[ahttp.Got] = vec_new[ahttp.Got]()
//     let ok: usize = ahttp.get_all(&urls, &res, 5000)         // blocks until every request is over
//     let g: *mut ahttp.Got = vec_elem_ptr[ahttp.Got](&res, 0) // (*g).status, (*g).err, ahttp.got_body(g)
//     ahttp.got_free_all(&res)
//
// `res` gets one entry per URL, in the order of `urls`. All requests run on one private loop and
// one private client (no keep-alive, no connection limit: 100 URLs are 100 sockets at once).

// The result of one request of `get_all`: status 0 = no answer, then `err` is the net.http error
// number (or AE_TIMEOUT / AE_CANCELLED).
struct Got {
    status: u32,
    err: u32,
    body: rt.Buf,
}

fn got_body(g: *mut Got) -> str {
    return str { p: rt.buf_ptr(&(*g).body) as *mut u8, n: rt.buf_len(&(*g).body) }
}

fn got_free_all(res: *mut Vec[Got]) {
    var i: usize = 0
    let n: usize = vec_len[Got](res)
    while i < n {
        rt.buf_free(&(*vec_elem_ptr[Got](res, i)).body)
        i = i + 1
    }
    vec_free[Got](res)
}

fn get_all_done(r: *mut Request, ud: u64) {
    let g: *mut Got = ud as *mut Got
    (*g).err = areq_error(r)
    if (*g).err == 0 {
        (*g).status = areq_status(r)
        rt.buf_push_bytes(&(*g).body, areq_body_ptr(r), areq_body_len(r))
    }
}

// Fetches every URL of `urls` at the same time; `res` is cleared and refilled. `timeout_ms` is per
// request. Returns how many got an answer (any status).
#[allow_escape]
fn get_all(urls: *mut Vec[str], res: *mut Vec[Got], timeout_ms: i64) -> usize {
    let n: usize = vec_len[str](urls)
    vec_free[Got](res)
    *res = vec_new[Got]()
    var i: usize = 0
    while i < n {
        vec_push[Got](res, Got { status: 0 as u32, err: 0 as u32, body: rt.buf_new() })
        i = i + 1
    }
    var l: loop.Loop = loop.loop_new()
    var a: AClient = aclient_new()
    if !loop.loop_init(&l) || !aclient_init(&a, &l) {
        i = 0
        while i < n {
            (*vec_elem_ptr[Got](res, i)).err = 16 as u32
            i = i + 1
        }
        return 0
    }
    i = 0
    while i < n {
        let g: *mut Got = vec_elem_ptr[Got](res, i)
        let u: str = *vec_elem_ptr[str](urls, i)
        if aclient_get_str(&a, u, timeout_ms, get_all_done, g as u64) as u64 == 0 {
            (*g).err = 2 as u32
        }
        i = i + 1
    }
    loop.run(&l)
    aclient_free(&a)
    loop.loop_free(&l)
    var ok: usize = 0
    i = 0
    while i < n {
        if (*vec_elem_ptr[Got](res, i)).status != 0 as u32 {
            ok = ok + 1
        }
        i = i + 1
    }
    return ok
}
