import jxl.jxl_bits
import jxl.jxl_err
import jxl.jxl_frame
import jxl.jxl_lfdata
import jxl.jxl_lfglobal
import jxl.jxl_lfgroup
import jxl.jxl_open

export { JxlVardct, vd_new, vd_open, vd_free, vd_decode_lf_group }

struct JxlVardct {
    doc: jxl_open.JxlDoc,
    lfg: jxl_lfglobal.JxlLfGlobal,
    lfg_end: usize,
    lfg_end_bit: u64,
    data: jxl_lfdata.JxlLfData,
}

fn vd_new() -> JxlVardct {
    return JxlVardct { doc: jxl_open.doc_new(), lfg: jxl_lfglobal.lfg_new(), lfg_end: 0, lfg_end_bit: 0, data: jxl_lfdata.lfd_new() }
}

fn vd_open(p: u64, n: usize, v: *mut JxlVardct) -> i32 {
    var r: i32 = jxl_open.doc_open(p, n, &(*v).doc)
    if r != jxl_err.JX_OK {
        return r
    }
    if (*v).doc.frame.encoding != jxl_frame.JF_VARDCT || !(*v).doc.meta.xyb_encoded || (*v).doc.meta.have_animation {
        return jxl_err.JX_UNSUPPORTED
    }
    var sb: jxl_bits.JxlBits = jxl_open.doc_section(&(*v).doc, 0)
    r = jxl_lfglobal.lfg_read(&sb, &(*v).doc.meta, &(*v).doc.frame, &(*v).lfg)
    if r == jxl_err.JX_OK {
        (*v).lfg_end_bit = jxl_bits.jb_bit_pos(&sb)
        jxl_bits.jb_align(&sb)
        (*v).lfg_end = jxl_bits.jb_byte_pos(&sb)
        if !jxl_lfdata.lfd_init(&(*v).data, (*v).doc.frame.width as usize, (*v).doc.frame.height as usize) {
            r = jxl_err.JX_MEMORY
        }
    }
    return r
}

fn vd_decode_lf_group(v: *mut JxlVardct, g: usize, end: *mut usize) -> i32 {
    var sb: jxl_bits.JxlBits = jxl_open.doc_section(&(*v).doc, 1 + g)
    if (*v).doc.frame.toc_count == 1 {
        sb = jxl_open.doc_section(&(*v).doc, 0)
        jxl_bits.jb_skip_bits(&sb, (*v).lfg_end_bit)
    }
    var r: i32 = jxl_lfgroup.lfgroup_decode(&sb, &(*v).doc.meta, &(*v).doc.frame, &(*v).lfg.ms, &(*v).lfg.quant, &(*v).lfg.cmap, &(*v).lfg.bctx, g, &(*v).data)
    if r == jxl_err.JX_OK {
        jxl_bits.jb_align(&sb)
        *end = jxl_bits.jb_byte_pos(&sb)
    }
    return r
}

fn vd_free(v: *mut JxlVardct) {
    jxl_lfdata.lfd_free(&(*v).data)
    jxl_lfglobal.lfg_free(&(*v).lfg)
    jxl_open.doc_free(&(*v).doc)
}
