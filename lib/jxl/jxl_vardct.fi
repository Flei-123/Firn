import jxl.jxl_acgroup
import jxl.jxl_bits
import jxl.jxl_err
import jxl.jxl_frame
import jxl.jxl_group
import jxl.jxl_hfglobal
import jxl.jxl_img
import jxl.jxl_lfdata
import jxl.jxl_lfglobal
import jxl.jxl_lfgroup
import jxl.jxl_open
import jxl.jxl_stream

export { JxlVardct, vd_new, vd_open, vd_free, vd_decode_lf_group, vd_decode_hf_global, vd_decode_ac_group, vd_finish_extras }

struct JxlVardct {
    doc: jxl_open.JxlDoc,
    lfg: jxl_lfglobal.JxlLfGlobal,
    lfg_end: usize,
    lfg_end_bit: u64,
    lf_end_bit: u64,
    hf_end_bit: u64,
    hf: jxl_hfglobal.JxlHfGlobal,
    data: jxl_lfdata.JxlLfData,
}

fn vd_new() -> JxlVardct {
    return JxlVardct { doc: jxl_open.doc_new(), lfg: jxl_lfglobal.lfg_new(), lfg_end: 0, lfg_end_bit: 0, lf_end_bit: 0, hf_end_bit: 0, hf: jxl_hfglobal.hfg_new(), data: jxl_lfdata.lfd_new() }
}

fn vd_open(p: u64, n: usize, v: *mut JxlVardct) -> i32 {
    var r: i32 = jxl_open.doc_open(p, n, &(*v).doc)
    if r != jxl_err.JX_OK {
        return r
    }
    if (*v).doc.frame.encoding != jxl_frame.JF_VARDCT || !(*v).doc.meta.xyb_encoded || (*v).doc.meta.have_animation {
        return jxl_err.JX_UNSUPPORTED
    }
    var sb: jxl_bits.JxlBits = jxl_open.doc_section(&(*v).doc, 0)
    r = jxl_lfglobal.lfg_read(&sb, &(*v).doc.meta, &(*v).doc.frame, &(*v).lfg)
    if r == jxl_err.JX_OK {
        (*v).lfg_end_bit = jxl_bits.jb_bit_pos(&sb)
        jxl_bits.jb_align(&sb)
        (*v).lfg_end = jxl_bits.jb_byte_pos(&sb)
        if !jxl_lfdata.lfd_init(&(*v).data, (*v).doc.frame.width as usize, (*v).doc.frame.height as usize) {
            r = jxl_err.JX_MEMORY
        }
    }
    return r
}

fn vd_decode_lf_group(v: *mut JxlVardct, g: usize, end: *mut usize) -> i32 {
    var sb: jxl_bits.JxlBits = jxl_open.doc_section(&(*v).doc, 1 + g)
    if (*v).doc.frame.toc_count == 1 {
        sb = jxl_open.doc_section(&(*v).doc, 0)
        jxl_bits.jb_skip_bits(&sb, (*v).lfg_end_bit)
    }
    var r: i32 = jxl_lfgroup.lfgroup_decode(&sb, &(*v).doc.meta, &(*v).doc.frame, &(*v).lfg.ms, &(*v).lfg.quant, &(*v).lfg.cmap, &(*v).lfg.bctx, g, &(*v).data, &(*v).lfg.img)
    if r == jxl_err.JX_OK {
        (*v).lf_end_bit = jxl_bits.jb_bit_pos(&sb)
        jxl_bits.jb_align(&sb)
        *end = jxl_bits.jb_byte_pos(&sb)
    }
    return r
}

fn vd_decode_hf_global(v: *mut JxlVardct, end: *mut usize) -> i32 {
    let nlf: usize = (*v).doc.frame.num_lf_groups as usize
    var sb: jxl_bits.JxlBits = jxl_open.doc_section(&(*v).doc, 1 + nlf)
    if (*v).doc.frame.toc_count == 1 {
        sb = jxl_open.doc_section(&(*v).doc, 0)
        jxl_bits.jb_skip_bits(&sb, (*v).lf_end_bit)
    }
    var r: i32 = jxl_hfglobal.hfg_read(&sb, &(*v).doc.frame, (*v).data.used_acs, &(*v).lfg.bctx, &(*v).hf)
    if r == jxl_err.JX_OK && !jxl_lfdata.lfd_prepare_coefs(&(*v).data) {
        r = jxl_err.JX_MEMORY
    }
    if r == jxl_err.JX_OK {
        (*v).hf_end_bit = jxl_bits.jb_bit_pos(&sb)
        jxl_bits.jb_align(&sb)
        *end = jxl_bits.jb_byte_pos(&sb)
    }
    return r
}

fn vd_decode_ac_group(v: *mut JxlVardct, pass: u32, g: usize, end: *mut usize) -> i32 {
    let f: *mut jxl_frame.JxlFrame = &(*v).doc.frame
    if pass >= (*f).num_passes {
        return jxl_err.JX_BAD
    }
    let nlf: usize = (*f).num_lf_groups as usize
    var sb: jxl_bits.JxlBits = jxl_open.doc_section(&(*v).doc, 2 + nlf + (pass as usize) * ((*f).num_groups as usize) + g)
    if (*f).toc_count == 1 {
        sb = jxl_open.doc_section(&(*v).doc, 0)
        jxl_bits.jb_skip_bits(&sb, (*v).hf_end_bit)
    }
    var r: i32 = jxl_acgroup.acgroup_decode(&sb, f, &(*v).lfg.bctx, &(*v).hf, &(*v).data, pass, g)
    if r == jxl_err.JX_OK && jxl_img.img_count(&(*v).lfg.img) > 0 {
        let gd: usize = (*f).group_dim as usize
        let gx: usize = g % ((*f).groups_x as usize)
        let gy: usize = g / ((*f).groups_x as usize)
        r = jxl_group.group_decode(&sb, &(*v).lfg.img, &(*v).lfg.ms, (*v).doc.meta.depth.bits as i64, gd, gx * gd, gy * gd, gd, gd,
            jxl_frame.jf_pass_min_shift(f, pass), jxl_frame.jf_pass_max_shift(f, pass), (1 + 3 * nlf + 17 + ((*f).num_groups as usize) * (pass as usize) + g) as u32)
    }
    if r == jxl_err.JX_OK {
        jxl_bits.jb_align(&sb)
        *end = jxl_bits.jb_byte_pos(&sb)
    }
    return r
}

fn vd_finish_extras(v: *mut JxlVardct) -> i32 {
    return jxl_stream.xfs_inverse(&(*v).lfg.xfs, &(*v).lfg.img, &(*v).lfg.wph, (*v).doc.meta.depth.bits as i64)
}

fn vd_free(v: *mut JxlVardct) {
    jxl_hfglobal.hfg_free(&(*v).hf)
    jxl_lfdata.lfd_free(&(*v).data)
    jxl_lfglobal.lfg_free(&(*v).lfg)
    jxl_open.doc_free(&(*v).doc)
}
