export { ldi, sti, ldq, stq, abs64, min64, max64, floor_log2 }

fn ldi(p: u64, i: usize) -> i32 {
    return *((p +% i as u64 *% 4) as *mut i32)
}

fn sti(p: u64, i: usize, v: i32) {
    *((p +% i as u64 *% 4) as *mut i32) = v
}

fn ldq(p: u64, i: usize) -> i64 {
    return *((p +% i as u64 *% 8) as *mut i64)
}

fn stq(p: u64, i: usize, v: i64) {
    *((p +% i as u64 *% 8) as *mut i64) = v
}

fn abs64(v: i64) -> i64 {
    if v < 0 {
        return 0 - v
    }
    return v
}

fn min64(a: i64, b: i64) -> i64 {
    if a < b {
        return a
    }
    return b
}

fn max64(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    }
    return b
}

fn floor_log2(v: u64) -> u32 {
    var r: u32 = 0
    var x: u64 = v
    while x > 1 {
        x = x >> 1
        r = r + 1
    }
    return r
}
