// lib/jxl/jxl_container.fi -- jxl_container: bare codestream (ff 0a) or ISOBMFF boxes (jxlc / jxlp) to one codestream
import std.rt
import jxl.jxl_err

export {
    jc_extract, jc_is_bare, jc_is_boxed, jc_sniff,
}

fn be32(p: u64, i: usize) -> u32 {
    return ((rt.ld8(p, i) as u32) << 24) | ((rt.ld8(p, i + 1) as u32) << 16)
    | ((rt.ld8(p, i + 2) as u32) << 8) | (rt.ld8(p, i + 3) as u32)
}

fn jc_is_bare(p: u64, n: usize) -> bool {
    return n >= 2 && rt.ld8(p, 0) == 255 as u8 && rt.ld8(p, 1) == 10 as u8
}

fn jc_is_boxed(p: u64, n: usize) -> bool {
    if n < 12 {
        return false
    }
    if be32(p, 0) != 12 || be32(p, 4) != 1247300640 || be32(p, 8) != 218793738 {
        return false
    }
    return true
}

fn jc_sniff(p: u64, n: usize) -> bool {
    return jc_is_bare(p, n) || jc_is_boxed(p, n)
}

fn jc_extract(p: u64, n: usize, out: *mut rt.Buf) -> i32 {
    rt.buf_clear(out)
    if jc_is_bare(p, n) {
        rt.buf_push_bytes(out, p, n)
        return jxl_err.JX_OK
    }
    if !jc_is_boxed(p, n) {
        return jxl_err.JX_NOT_JXL
    }
    var pos: usize = 12
    var found: bool = false
    var last_part: bool = false
    while pos + 8 <= n && !last_part {
        var size: u64 = be32(p, pos) as u64
        let kind: u32 = be32(p, pos + 4)
        var hdr: usize = 8
        if size == 1 {
            if pos + 16 > n {
                return jxl_err.JX_TRUNCATED
            }
            size = ((be32(p, pos + 8) as u64) << 32) | (be32(p, pos + 12) as u64)
            hdr = 16
        } else if size == 0 {
            size = (n - pos) as u64
        }
        if size < hdr as u64 || pos as u64 + size > n as u64 {
            if pos as u64 + size > n as u64 && size >= hdr as u64 {
                size = (n - pos) as u64
            } else {
                return jxl_err.JX_BAD
            }
        }
        let body: usize = pos + hdr
        let blen: usize = (size as usize) - hdr
        if kind == 1786276963 {
            rt.buf_push_bytes(out, p + body as u64, blen)
            found = true
            last_part = true
        } else if kind == 1786276976 {
            if blen < 4 {
                return jxl_err.JX_BAD
            }
            let idx: u32 = be32(p, body)
            rt.buf_push_bytes(out, p + (body + 4) as u64, blen - 4)
            found = true
            if (idx >> 31) != 0 {
                last_part = true
            }
        }
        pos = pos + (size as usize)
    }
    if !found {
        return jxl_err.JX_BAD
    }
    return jxl_err.JX_OK
}
