// lib/jxl/jxl_qweights.fi -- jxl_qweights: JPEG XL quant bias
import jxl.jxl_f32
import jxl.jxl_fastmath

export { qw_bias_adjust }

static BIASES: [f64; 4] = [0.945349926692846, 0.9299455010825140, 0.9500648966626566, 0.145]

fn bias_value(c: usize) -> f64 {
    if c == 3 {
        return jxl_f32.round32(0.145)
    }
    let sub: [f64; 3] = [0.05465007330715401, 0.07005449891748593, 0.049935103337343655]
    return jxl_f32.round32(1.0 - jxl_f32.round32(sub[c]))
}

fn qw_bias_adjust(q: i32, c: usize) -> f64 {
    if q == 0 {
        return 0.0
    }
    if q == 1 {
        return bias_value(c)
    }
    if q == -1 {
        return 0.0 - bias_value(c)
    }
    let qf: f64 = q as f64
    return jxl_f32.fma32(0.0 - bias_value(3), jxl_fastmath.rcp_approx(qf), qf)
}
