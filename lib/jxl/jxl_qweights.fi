// SPDX-License-Identifier: MPL-2.0
// lib/jxl/jxl_qweights.fi -- jxl_qweights: JPEG XL default DCT8 dequantization weights and quant bias
import std.math

export { qw_dct8_table, qw_bias_adjust }

const BAND_COUNT: usize = 6

static BANDS: [f64; 18] = [3150.0, 0.0, -0.4, -0.4, -0.4, -2.0, 560.0, 0.0, -0.3, -0.3, -0.3, -0.3, 512.0, -2.0, -1.0, 0.0, -1.0, -2.0]
static BIASES: [f64; 4] = [0.9453499266928460, 0.9299455010825140, 0.9500648966626566, 0.145]

fn mult(v: f64) -> f64 {
    if v > 0.0 {
        return 1.0 + v
    }
    return 1.0 / (1.0 - v)
}

fn fst(p: u64, i: usize, v: f64) {
    *((p +% ((i * 8) as u64)) as *mut f64) = v
}

fn qw_dct8_table(out: u64) {
    var c: usize = 0
    while c < 3 {
        var bands: [f64; 6] = [0.0; 6]
        bands[0] = BANDS[c * BAND_COUNT]
        var i: usize = 1
        while i < BAND_COUNT {
            bands[i] = bands[i - 1] * mult(BANDS[c * BAND_COUNT + i])
            i = i + 1
        }
        let scale: f64 = 5.0 / (math.sqrt(2.0) + 0.000001)
        let rcp: f64 = scale / 7.0
        var y: usize = 0
        while y < 8 {
            var x: usize = 0
            while x < 8 {
                let dx: f64 = (x as f64) * rcp
                let dy: f64 = (y as f64) * rcp
                let pos: f64 = math.sqrt(dx * dx + dy * dy)
                var idx: usize = pos as usize
                if idx > 4 {
                    idx = 4
                }
                let a: f64 = bands[idx]
                let b: f64 = bands[idx + 1]
                let w: f64 = a * math.powf(b / a, pos - (idx as f64))
                fst(out, c * 64 + y * 8 + x, 1.0 / w)
                x = x + 1
            }
            y = y + 1
        }
        c = c + 1
    }
}

fn qw_bias_adjust(q: i32, c: usize) -> f64 {
    if q == 0 {
        return 0.0
    }
    if q == 1 {
        return BIASES[c]
    }
    if q == -1 {
        return 0.0 - BIASES[c]
    }
    return (q as f64) - BIASES[3] / (q as f64)
}
