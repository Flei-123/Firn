// lib/jxl/jxl_order.fi -- jxl_order: JPEG XL natural coefficient orders and per-order table offsets
import std.rt
import jxl.jxl_acs

export { ORDER_TOTAL, ORDER_COUNT, order_offset, order_blocks, natural_order }

const ORDER_COUNT: usize = 13
const ORDER_TOTAL: usize = 393984

static OFFSETS: [u32; 40] = [
    0, 1, 2, 3, 4, 5, 6, 10, 14, 18,
    34, 50, 66, 68, 70, 72, 76, 80, 84, 92,
    100, 108, 172, 236, 300, 332, 364, 396, 652, 908,
    1164, 1292, 1420, 1548, 2572, 3596, 4620, 5132, 5644, 6156]

static BLOCKS: [u16; 13] = [1, 1, 4, 16, 2, 4, 8, 64, 32, 256, 128, 1024, 512]

fn order_offset(ord: usize, c: usize) -> usize {
    return (OFFSETS[3 * ord + c] as usize) * 64
}

fn order_blocks(ord: usize) -> usize {
    return BLOCKS[ord] as usize
}

fn natural_order(t: u32, out: u64) {
    var cx: usize = jxl_acs.acs_cover_x(t)
    var cy: usize = jxl_acs.acs_cover_y(t)
    if cy > cx {
        let tmp: usize = cx
        cx = cy
        cy = tmp
    }
    let xs: usize = cx / cy
    let xsm: usize = xs - 1
    var xss: usize = 0
    var q: usize = xs
    while q > 1 {
        q = q >> 1
        xss = xss + 1
    }
    let dim: usize = cx * 8
    var cur: usize = cx * cy
    var i: usize = 0
    while i < dim {
        var j: usize = 0
        while j <= i {
            var x: usize = j
            var y: usize = i - j
            if i % 2 == 1 {
                let tmp: usize = x
                x = y
                y = tmp
            }
            if (y & xsm) == 0 {
                y = y >> xss
                var val: usize = cur
                if x < cx && y < cy {
                    val = y * cx + x
                } else {
                    cur = cur + 1
                }
                rt.st32(out, val, (y * dim + x) as u32)
            }
            j = j + 1
        }
        i = i + 1
    }
    var ip: usize = dim - 1
    while ip > 0 {
        let i2: usize = ip - 1
        var j: usize = 0
        while j <= i2 {
            var x: usize = dim - 1 - (i2 - j)
            var y: usize = dim - 1 - j
            if i2 % 2 == 1 {
                let tmp: usize = x
                x = y
                y = tmp
            }
            if (y & xsm) == 0 {
                y = y >> xss
                rt.st32(out, cur, (y * dim + x) as u32)
                cur = cur + 1
            }
            j = j + 1
        }
        ip = ip - 1
    }
}
