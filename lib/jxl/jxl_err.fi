// lib/jxl/jxl_err.fi -- jxl_err: status codes shared by the lib/jxl modules
export {
    JX_OK, JX_BAD, JX_UNSUPPORTED, JX_TRUNCATED, JX_MEMORY, JX_TOO_LARGE, JX_NOT_JXL,
    JxlError, jx_fail,
}

const JX_OK: i32 = 0
const JX_BAD: i32 = 1
const JX_UNSUPPORTED: i32 = 2
const JX_TRUNCATED: i32 = 3
const JX_MEMORY: i32 = 4
const JX_TOO_LARGE: i32 = 5
const JX_NOT_JXL: i32 = 6

error JxlError {
    NotJxl,
    Corrupt,
    Unsupported,
    Truncated,
    OutOfMemory,
    TooLarge,
}

fn jx_fail(r: i32) -> JxlError!bool {
    if r == JX_NOT_JXL { return JxlError::NotJxl }
    if r == JX_UNSUPPORTED { return JxlError::Unsupported }
    if r == JX_TRUNCATED { return JxlError::Truncated }
    if r == JX_MEMORY { return JxlError::OutOfMemory }
    if r == JX_TOO_LARGE { return JxlError::TooLarge }
    return JxlError::Corrupt
}
