// SPDX-License-Identifier: MPL-2.0
// lib/jxl/jxl_epf.fi -- jxl_epf: JPEG XL edge-preserving filter (3 passes) on XYB planes
import jxl.jxl_acs
import jxl.jxl_f32
import jxl.jxl_lfdata
import jxl.jxl_loopf
import jxl.jxl_pad
import jxl.jxl_quant
import std.math
import std.rt
import std.vec

export { epf_apply, epf_apply_uniform }

const INV_SIGMA_NUM: f64 = -1.1715728752538099
const MIN_SIGMA: f64 = -3.9052429175126997
const SIGMA_FLOOR: f64 = -0.0001

static OFF12: [i32; 24] = [-2, 0, -1, -1, -1, 0, -1, 1, 0, -2, 0, -1, 0, 1, 0, 2, 1, -1, 1, 0, 1, 1, 2, 0]
static OFF4: [i32; 8] = [-1, 0, 0, -1, 0, 1, 1, 0]

struct EpfCtx {
    width: usize,
    height: usize,
    stride: usize,
    plane_len: usize,
    bw: usize,
    sigma: u64,
    padded: u64,
    pw: usize,
    pad_plane: usize,
}

fn fld(p: u64, i: usize) -> f64 {
    return *((p +% ((i * 8) as u64)) as *mut f64)
}

fn fst(p: u64, i: usize, v: f64) {
    *((p +% ((i * 8) as u64)) as *mut f64) = v
}

fn r32(v: f64) -> f64 {
    return jxl_f32.round32(v)
}

fn ad(p: u64, i: usize, k: usize) -> f64 {
    return math.fabs(fld(p, i) - fld(p, k))
}

fn plus_sad(p: u64, i: usize, k: usize, pw: usize, kind: u32) -> f64 {
    if kind == 0 {
        var s: f64 = r32(ad(p, i, k))
        s = r32(s + ad(p, i - pw, k - pw))
        s = r32(s + ad(p, i - 1, k - 1))
        s = r32(s + ad(p, i + pw, k + pw))
        return r32(s + ad(p, i + 1, k + 1))
    }
    var s: f64 = r32(ad(p, i - pw, k - pw))
    s = r32(s + ad(p, i - 1, k - 1))
    s = r32(s + ad(p, i, k))
    s = r32(s + ad(p, i + 1, k + 1))
    return r32(s + ad(p, i + pw, k + pw))
}

fn load_padded(e: *mut EpfCtx, planes: u64) {
    var c: usize = 0
    while c < 3 {
        jxl_pad.pad_fill(planes +% ((c * (*e).plane_len * 8) as u64), (*e).width, (*e).height, (*e).stride, 3, (*e).padded +% ((c * (*e).pad_plane * 8) as u64))
        c = c + 1
    }
}

fn epf_pass(e: *mut EpfCtx, planes: u64, lf: *mut jxl_loopf.JxlLoopFilter, kind: u32) {
    load_padded(e, planes)
    var count: usize = 4
    var sm: f64 = r32(1.65)
    if kind == 0 {
        count = 12
        sm = r32(r32((*lf).epf_pass0_sigma_scale) * 1.65)
    }
    if kind == 2 {
        sm = r32(r32((*lf).epf_pass2_sigma_scale) * 1.65)
    }
    let bsm: f64 = r32(sm * r32((*lf).epf_border_sad_mul))
    let pw: usize = (*e).pw
    let pwi: i64 = pw as i64
    var doff: [i64; 12] = [0; 12]
    var i0: usize = 0
    while i0 < count {
        if kind == 0 {
            doff[i0] = (OFF12[i0 * 2] as i64) * pwi + (OFF12[i0 * 2 + 1] as i64)
        } else {
            doff[i0] = (OFF4[i0 * 2] as i64) * pwi + (OFF4[i0 * 2 + 1] as i64)
        }
        i0 = i0 + 1
    }
    let p0: u64 = (*e).padded
    let p1: u64 = p0 +% (((*e).pad_plane * 8) as u64)
    let p2: u64 = p1 +% (((*e).pad_plane * 8) as u64)
    let sc0: f64 = r32((*lf).epf_channel_scale[0])
    let sc1: f64 = r32((*lf).epf_channel_scale[1])
    let sc2: f64 = r32((*lf).epf_channel_scale[2])
    let o0: u64 = planes
    let o1: u64 = planes +% (((*e).plane_len * 8) as u64)
    let o2: u64 = o1 +% (((*e).plane_len * 8) as u64)
    var y: usize = 0
    while y < (*e).height {
        let ym: usize = y % 8
        var x: usize = 0
        while x < (*e).width {
            let sg: f64 = fld((*e).sigma, (y / 8) * (*e).bw + x / 8)
            if sg >= r32(MIN_SIGMA) {
                let xm: usize = x % 8
                var mul: f64 = sm
                if ym == 0 || ym == 7 || xm == 0 || xm == 7 {
                    mul = bsm
                }
                let inv_sigma: f64 = r32(sg * mul)
                let o: usize = (y + 3) * pw + x + 3
                var a0: f64 = fld(p0, o)
                var a1: f64 = fld(p1, o)
                var a2: f64 = fld(p2, o)
                var wsum: f64 = 1.0
                var i: usize = 0
                while i < count {
                    let k: usize = ((o as i64) + doff[i]) as usize
                    var sad: f64 = 0.0
                    if kind == 2 {
                        sad = r32(ad(p0, o, k) * sc0)
                        sad = jxl_f32.fma32(ad(p1, o, k), sc1, sad)
                        sad = jxl_f32.fma32(ad(p2, o, k), sc2, sad)
                    } else {
                        sad = r32(plus_sad(p0, o, k, pw, kind) * sc0)
                        sad = jxl_f32.fma32(plus_sad(p1, o, k, pw, kind), sc1, sad)
                        sad = jxl_f32.fma32(plus_sad(p2, o, k, pw, kind), sc2, sad)
                    }
                    var w: f64 = jxl_f32.fma32(sad, inv_sigma, 1.0)
                    if w < 0.0 {
                        w = 0.0
                    }
                    if w != 0.0 {
                        a0 = jxl_f32.fma32(w, fld(p0, k), a0)
                        a1 = jxl_f32.fma32(w, fld(p1, k), a1)
                        a2 = jxl_f32.fma32(w, fld(p2, k), a2)
                    }
                    wsum = r32(wsum + w)
                    i = i + 1
                }
                let oo: usize = y * (*e).stride + x
                let inv_w: f64 = r32(1.0 / wsum)
                fst(o0, oo, r32(a0 * inv_w))
                fst(o1, oo, r32(a1 * inv_w))
                fst(o2, oo, r32(a2 * inv_w))
            }
            x = x + 1
        }
        y = y + 1
    }
}

fn fill_sigma(e: *mut EpfCtx, d: *mut jxl_lfdata.JxlLfData, q: *mut jxl_quant.JxlQuant, lf: *mut jxl_loopf.JxlLoopFilter) {
    let scale: f64 = r32((*q).global_scale as f64 * (1.0 / 65536.0))
    var by: usize = 0
    while by < (*d).bh {
        var bx: usize = 0
        while bx < (*d).bw {
            if jxl_lfdata.lfd_acs_is_first(d, bx, by) {
                let t: u32 = jxl_lfdata.lfd_acs_type(d, bx, by)
                let qf: f64 = vec.vec_at[i32](&(*d).qf, jxl_lfdata.lfd_idx(d, bx, by)) as f64
                let sigma_quant: f64 = r32(r32((*lf).epf_quant_mul) / r32(r32(scale * qf) * r32(INV_SIGMA_NUM)))
                var iy: usize = 0
                while iy < jxl_acs.acs_cover_y(t) {
                    var ix: usize = 0
                    while ix < jxl_acs.acs_cover_x(t) {
                        let sh: usize = vec.vec_at[u8](&(*d).epf, jxl_lfdata.lfd_idx(d, bx + ix, by + iy)) as usize
                        var sigma: f64 = r32(sigma_quant * r32((*lf).epf_sharp[sh]))
                        if sigma > r32(SIGMA_FLOOR) {
                            sigma = r32(SIGMA_FLOOR)
                        }
                        fst((*e).sigma, (by + iy) * (*e).bw + bx + ix, r32(1.0 / sigma))
                        ix = ix + 1
                    }
                    iy = iy + 1
                }
            }
            bx = bx + 1
        }
        by = by + 1
    }
}

fn epf_run(e: *mut EpfCtx, planes: u64, lf: *mut jxl_loopf.JxlLoopFilter) {
    if (*lf).epf_iters >= 3 {
        epf_pass(e, planes, lf, 0)
    }
    epf_pass(e, planes, lf, 1)
    if (*lf).epf_iters >= 2 {
        epf_pass(e, planes, lf, 2)
    }
}

fn epf_apply(planes: u64, width: usize, height: usize, stride: usize, plane_len: usize, d: *mut jxl_lfdata.JxlLfData, q: *mut jxl_quant.JxlQuant, lf: *mut jxl_loopf.JxlLoopFilter) -> bool {
    if (*lf).epf_iters == 0 {
        return true
    }
    let nb: usize = (*d).bw * (*d).bh
    let sigma: u64 = rt.heap_alloc(nb * 8)
    let pad_plane: usize = jxl_pad.pad_len(width, height, 3)
    let padded: u64 = rt.heap_alloc(pad_plane * 3 * 8)
    if sigma == 0 || padded == 0 {
        return false
    }
    var e: EpfCtx = EpfCtx { width: width, height: height, stride: stride, plane_len: plane_len, bw: (*d).bw, sigma: sigma, padded: padded, pw: jxl_pad.pad_stride(width, 3), pad_plane: pad_plane }
    fill_sigma(&e, d, q, lf)
    epf_run(&e, planes, lf)
    rt.heap_free(sigma, nb * 8)
    rt.heap_free(padded, pad_plane * 3 * 8)
    return true
}

fn epf_apply_uniform(planes: u64, width: usize, height: usize, stride: usize, plane_len: usize, lf: *mut jxl_loopf.JxlLoopFilter) -> bool {
    if (*lf).epf_iters == 0 {
        return true
    }
    let bw: usize = (width + 7) / 8
    let nb: usize = bw * ((height + 7) / 8)
    let sigma: u64 = rt.heap_alloc(nb * 8)
    let pad_plane: usize = jxl_pad.pad_len(width, height, 3)
    let padded: u64 = rt.heap_alloc(pad_plane * 3 * 8)
    if sigma == 0 || padded == 0 {
        if sigma != 0 {
            rt.heap_free(sigma, nb * 8)
        }
        if padded != 0 {
            rt.heap_free(padded, pad_plane * 3 * 8)
        }
        return false
    }
    var i: usize = 0
    while i < nb {
        fst(sigma, i, r32(r32(INV_SIGMA_NUM) / r32((*lf).epf_sigma_for_modular)))
        i = i + 1
    }
    var e: EpfCtx = EpfCtx { width: width, height: height, stride: stride, plane_len: plane_len, bw: bw, sigma: sigma, padded: padded, pw: jxl_pad.pad_stride(width, 3), pad_plane: pad_plane }
    epf_run(&e, planes, lf)
    rt.heap_free(sigma, nb * 8)
    rt.heap_free(padded, pad_plane * 3 * 8)
    return true
}
