// SPDX-License-Identifier: MPL-2.0
// lib/jxl/jxl_epf.fi -- jxl_epf: JPEG XL edge-preserving filter (3 passes) on XYB planes
import jxl.jxl_acs
import jxl.jxl_gaborish
import jxl.jxl_lfdata
import jxl.jxl_loopf
import jxl.jxl_quant
import std.math
import std.rt
import std.vec

export { epf_apply }

const INV_SIGMA_NUM: f64 = -1.1715728752538099
const MIN_SIGMA: f64 = -3.9052429175126997
const SIGMA_FLOOR: f64 = -0.0001

static OFF12: [i32; 24] = [-2, 0, -1, -1, -1, 0, -1, 1, 0, -2, 0, -1, 0, 1, 0, 2, 1, -1, 1, 0, 1, 1, 2, 0]
static OFF4: [i32; 8] = [-1, 0, 0, -1, 0, 1, 1, 0]
static PLUS: [i32; 10] = [0, 0, -1, 0, 0, -1, 1, 0, 0, 1]

struct EpfCtx {
    width: usize,
    height: usize,
    stride: usize,
    plane_len: usize,
    bw: usize,
    sigma: u64,
}

fn fld(p: u64, i: usize) -> f64 {
    return *((p +% ((i * 8) as u64)) as *mut f64)
}

fn fst(p: u64, i: usize, v: f64) {
    *((p +% ((i * 8) as u64)) as *mut f64) = v
}

fn px(e: *mut EpfCtx, src: u64, c: usize, x: i64, y: i64) -> f64 {
    let xi: usize = jxl_gaborish.mirror_index(x, (*e).width as i64)
    let yi: usize = jxl_gaborish.mirror_index(y, (*e).height as i64)
    return fld(src, c * (*e).plane_len + yi * (*e).stride + xi)
}

fn sad_plus(e: *mut EpfCtx, src: u64, lf: *mut jxl_loopf.JxlLoopFilter, x: i64, y: i64, dx: i32, dy: i32) -> f64 {
    var total: f64 = 0.0
    var c: usize = 0
    while c < 3 {
        var s: f64 = 0.0
        var j: usize = 0
        while j < 5 {
            let ox: i64 = PLUS[j * 2 + 1] as i64
            let oy: i64 = PLUS[j * 2] as i64
            s = s + math.fabs(px(e, src, c, x + ox, y + oy) - px(e, src, c, x + (dx as i64) + ox, y + (dy as i64) + oy))
            j = j + 1
        }
        total = total + s * (*lf).epf_channel_scale[c]
        c = c + 1
    }
    return total
}

fn sad_single(e: *mut EpfCtx, src: u64, lf: *mut jxl_loopf.JxlLoopFilter, x: i64, y: i64, dx: i32, dy: i32) -> f64 {
    var total: f64 = 0.0
    var c: usize = 0
    while c < 3 {
        total = total + math.fabs(px(e, src, c, x, y) - px(e, src, c, x + (dx as i64), y + (dy as i64))) * (*lf).epf_channel_scale[c]
        c = c + 1
    }
    return total
}

fn epf_pass(e: *mut EpfCtx, src: u64, dst: u64, lf: *mut jxl_loopf.JxlLoopFilter, kind: u32) {
    var count: usize = 4
    var sm: f64 = 1.65
    if kind == 0 {
        count = 12
        sm = (*lf).epf_pass0_sigma_scale * 1.65
    }
    if kind == 2 {
        sm = (*lf).epf_pass2_sigma_scale * 1.65
    }
    let bsm: f64 = sm * (*lf).epf_border_sad_mul
    var y: usize = 0
    while y < (*e).height {
        var x: usize = 0
        while x < (*e).width {
            let sg: f64 = fld((*e).sigma, (y / 8) * (*e).bw + x / 8)
            var c: usize = 0
            if sg < MIN_SIGMA {
                while c < 3 {
                    fst(dst, c * (*e).plane_len + y * (*e).stride + x, px(e, src, c, x as i64, y as i64))
                    c = c + 1
                }
            } else {
                var mul: f64 = sm
                if y % 8 == 0 || y % 8 == 7 || x % 8 == 0 || x % 8 == 7 {
                    mul = bsm
                }
                let inv_sigma: f64 = sg * mul
                var acc: [f64; 3] = [px(e, src, 0, x as i64, y as i64), px(e, src, 1, x as i64, y as i64), px(e, src, 2, x as i64, y as i64)]
                var wsum: f64 = 1.0
                var i: usize = 0
                while i < count {
                    var dy: i32 = 0
                    var dx: i32 = 0
                    if kind == 0 {
                        dy = OFF12[i * 2]
                        dx = OFF12[i * 2 + 1]
                    } else {
                        dy = OFF4[i * 2]
                        dx = OFF4[i * 2 + 1]
                    }
                    var sad: f64 = 0.0
                    if kind == 2 {
                        sad = sad_single(e, src, lf, x as i64, y as i64, dx, dy)
                    } else {
                        sad = sad_plus(e, src, lf, x as i64, y as i64, dx, dy)
                    }
                    var w: f64 = sad * inv_sigma + 1.0
                    if w < 0.0 {
                        w = 0.0
                    }
                    if w != 0.0 {
                        var cc: usize = 0
                        while cc < 3 {
                            acc[cc] = acc[cc] + w * px(e, src, cc, (x as i64) + (dx as i64), (y as i64) + (dy as i64))
                            cc = cc + 1
                        }
                    }
                    wsum = wsum + w
                    i = i + 1
                }
                c = 0
                while c < 3 {
                    fst(dst, c * (*e).plane_len + y * (*e).stride + x, acc[c] / wsum)
                    c = c + 1
                }
            }
            x = x + 1
        }
        y = y + 1
    }
    var c2: usize = 0
    while c2 < 3 {
        var yy: usize = 0
        while yy < (*e).height {
            var xx: usize = 0
            while xx < (*e).width {
                let o: usize = c2 * (*e).plane_len + yy * (*e).stride + xx
                fst(src, o, fld(dst, o))
                xx = xx + 1
            }
            yy = yy + 1
        }
        c2 = c2 + 1
    }
}

fn fill_sigma(e: *mut EpfCtx, d: *mut jxl_lfdata.JxlLfData, q: *mut jxl_quant.JxlQuant, lf: *mut jxl_loopf.JxlLoopFilter) {
    let scale: f64 = (*q).global_scale as f64 / 65536.0
    var by: usize = 0
    while by < (*d).bh {
        var bx: usize = 0
        while bx < (*d).bw {
            if jxl_lfdata.lfd_acs_is_first(d, bx, by) {
                let t: u32 = jxl_lfdata.lfd_acs_type(d, bx, by)
                let qf: f64 = vec.vec_at[i32](&(*d).qf, jxl_lfdata.lfd_idx(d, bx, by)) as f64
                let sigma_quant: f64 = (*lf).epf_quant_mul / (scale * qf * INV_SIGMA_NUM)
                var iy: usize = 0
                while iy < jxl_acs.acs_cover_y(t) {
                    var ix: usize = 0
                    while ix < jxl_acs.acs_cover_x(t) {
                        let sh: usize = vec.vec_at[u8](&(*d).epf, jxl_lfdata.lfd_idx(d, bx + ix, by + iy)) as usize
                        var sigma: f64 = sigma_quant * (*lf).epf_sharp[sh]
                        if sigma > SIGMA_FLOOR {
                            sigma = SIGMA_FLOOR
                        }
                        fst((*e).sigma, (by + iy) * (*e).bw + bx + ix, 1.0 / sigma)
                        ix = ix + 1
                    }
                    iy = iy + 1
                }
            }
            bx = bx + 1
        }
        by = by + 1
    }
}

fn epf_apply(planes: u64, width: usize, height: usize, stride: usize, plane_len: usize, d: *mut jxl_lfdata.JxlLfData, q: *mut jxl_quant.JxlQuant, lf: *mut jxl_loopf.JxlLoopFilter) -> bool {
    if (*lf).epf_iters == 0 {
        return true
    }
    let nb: usize = (*d).bw * (*d).bh
    let sigma: u64 = rt.heap_alloc(nb * 8)
    let dst: u64 = rt.heap_alloc(plane_len * 3 * 8)
    if sigma == 0 || dst == 0 {
        return false
    }
    var e: EpfCtx = EpfCtx { width: width, height: height, stride: stride, plane_len: plane_len, bw: (*d).bw, sigma: sigma }
    fill_sigma(&e, d, q, lf)
    if (*lf).epf_iters >= 3 {
        epf_pass(&e, planes, dst, lf, 0)
    }
    epf_pass(&e, planes, dst, lf, 1)
    if (*lf).epf_iters >= 2 {
        epf_pass(&e, planes, dst, lf, 2)
    }
    rt.heap_free(sigma, nb * 8)
    rt.heap_free(dst, plane_len * 3 * 8)
    return true
}
