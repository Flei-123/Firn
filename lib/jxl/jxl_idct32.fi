// SPDX-License-Identifier: MPL-2.0
// lib/jxl/jxl_idct32.fi -- jxl_idct32: libjxl-ordered single-precision IDCT (even/odd recursion with FMA) for square blocks
import jxl.jxl_f32
import std.math
import std.rt

export { idct32_square }

fn fld(p: u64, i: usize) -> f64 {
    return *((p +% ((i * 8) as u64)) as *mut f64)
}

fn fst(p: u64, i: usize, v: f64) {
    *((p +% ((i * 8) as u64)) as *mut f64) = v
}

fn wc_mult(n: usize, i: usize) -> f64 {
    return jxl_f32.round32(0.5 / math.cos(((i as f64) + 0.5) * math.PI() / (n as f64)))
}

fn idct_1d(buf: u64, n: usize, scratch: u64) {
    if n == 1 {
        return
    }
    if n == 2 {
        let a: f64 = fld(buf, 0)
        let b: f64 = fld(buf, 1)
        fst(buf, 0, jxl_f32.round32(a + b))
        fst(buf, 1, jxl_f32.round32(a - b))
        return
    }
    let h: usize = n / 2
    var i: usize = 0
    while i < h {
        fst(scratch, i, fld(buf, 2 * i))
        fst(scratch, h + i, fld(buf, 2 * i + 1))
        i = i + 1
    }
    let next: u64 = scratch +% ((n * 8) as u64)
    idct_1d(scratch, h, next)
    let hi: u64 = scratch +% ((h * 8) as u64)
    i = h - 1
    while i > 0 {
        fst(hi, i, jxl_f32.round32(fld(hi, i) + fld(hi, i - 1)))
        i = i - 1
    }
    fst(hi, 0, jxl_f32.round32(fld(hi, 0) * jxl_f32.round32(1.41421356237)))
    idct_1d(hi, h, next)
    i = 0
    while i < h {
        let m: f64 = wc_mult(n, i)
        let o: f64 = fld(hi, i)
        let e: f64 = fld(scratch, i)
        fst(buf, i, jxl_f32.fma32(m, o, e))
        fst(buf, n - 1 - i, jxl_f32.fma32(0.0 - m, o, e))
        i = i + 1
    }
}

fn idct32_square(n: usize, inp: u64, out: u64) -> bool {
    let tmp: u64 = rt.heap_alloc(n * n * 8)
    let col: u64 = rt.heap_alloc(n * 8)
    let scratch: u64 = rt.heap_alloc(n * 8 * 4 + 64)
    if tmp == 0 || col == 0 || scratch == 0 {
        return false
    }
    var c: usize = 0
    while c < n {
        var r: usize = 0
        while r < n {
            fst(col, r, fld(inp, r * n + c))
            r = r + 1
        }
        idct_1d(col, n, scratch)
        r = 0
        while r < n {
            fst(tmp, r * n + c, fld(col, r))
            r = r + 1
        }
        c = c + 1
    }
    var r2: usize = 0
    while r2 < n {
        var k: usize = 0
        while k < n {
            fst(col, k, fld(tmp, r2 * n + k))
            k = k + 1
        }
        idct_1d(col, n, scratch)
        k = 0
        while k < n {
            fst(out, r2 * n + k, fld(col, k))
            k = k + 1
        }
        r2 = r2 + 1
    }
    rt.heap_free(tmp, n * n * 8)
    rt.heap_free(col, n * 8)
    rt.heap_free(scratch, n * 8 * 4 + 64)
    return true
}
