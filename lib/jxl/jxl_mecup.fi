// lib/jxl/jxl_mecup.fi -- jxl_mecup: finish extra channels of a non-XYB modular frame (float normalization, per-channel upsampling)
import std.rt
import jxl.jxl_dither
import jxl.jxl_ecup
import jxl.jxl_err
import jxl.jxl_frame
import jxl.jxl_header
import jxl.jxl_img
import jxl.jxl_mem
import jxl.jxl_upsample

export { mecup_finish }

fn copy_plane(dst: *mut jxl_img.JxlImage, src: *mut jxl_img.JxlImage, c: usize) -> i32 {
    let w: usize = jxl_img.img_w(src, c)
    let h: usize = jxl_img.img_h(src, c)
    jxl_img.img_add(dst, w, h, jxl_img.img_hs(src, c), jxl_img.img_vs(src, c))
    let d: usize = jxl_img.img_count(dst) - 1
    if jxl_img.img_data(dst, d) == 0 && w * h != 0 {
        return jxl_err.JX_MEMORY
    }
    if w * h != 0 {
        rt.mem_copy(jxl_img.img_data(dst, d), jxl_img.img_data(src, c), w * h * 4)
    }
    return jxl_err.JX_OK
}

fn extra_supported(e: *mut jxl_header.JxlExtra) -> bool {
    let d: jxl_header.JxlBitDepth = (*e).depth
    if d.bits == 0 {
        return false
    }
    if d.is_float {
        return d.bits >= 16
    }
    return d.bits <= 16
}

fn mecup_finish(m: *mut jxl_header.JxlMeta, f: *mut jxl_frame.JxlFrame, img: *mut jxl_img.JxlImage) -> i32 {
    let nchan: usize = jxl_header.jm_color_channels(m) as usize
    let nextra: usize = jxl_header.jm_extra_count(m)
    if nextra == 0 || jxl_img.img_count(img) < nchan + nextra {
        return jxl_err.JX_OK
    }
    var out: jxl_img.JxlImage = jxl_img.img_new()
    var dth: jxl_dither.JxlDither = jxl_dither.dither_new((*m).orientation, (*m).width as usize, (*m).height as usize, (*f).x0 as i64, (*f).y0 as i64)
    var r: i32 = jxl_err.JX_OK
    var c: usize = 0
    while r == jxl_err.JX_OK && c < jxl_img.img_count(img) {
        if c < nchan {
            r = copy_plane(&out, img, c)
            c = c + 1
            continue
        }
        let idx: usize = c - nchan
        let e: *mut jxl_header.JxlExtra = jxl_header.jm_extra(m, idx)
        let n: usize = jxl_frame.jf_ec_ups(f, idx) as usize
        if n <= 1 {
            r = copy_plane(&out, img, c)
            if r == jxl_err.JX_OK && (*e).depth.is_float {
                jxl_ecup.ecup_normalize_float(&out, jxl_img.img_count(&out) - 1, (*e).depth)
            }
            c = c + 1
            continue
        }
        let ow: usize = (*f).full_w as usize
        let oh: usize = (*f).full_h as usize
        if !extra_supported(e) || ow == 0 || oh == 0 || (ow as u64) * (oh as u64) > 67108864 {
            r = jxl_err.JX_UNSUPPORTED
            break
        }
        let kern: u64 = jxl_upsample.ups_kernel_new(m, n)
        if kern == 0 {
            r = jxl_err.JX_MEMORY
            break
        }
        var dither_c: i32 = 0 - 1
        if (idx as i32) == jxl_header.jm_alpha_index(m) {
            dither_c = nchan as i32
        }
        r = jxl_ecup.ecup_channel(kern, n, img, c, (*e).depth, &out, ow, oh, dither_c, &dth)
        jxl_upsample.ups_kernel_free(kern, n)
        c = c + 1
    }
    if r == jxl_err.JX_OK {
        jxl_img.img_free(img)
        *img = out
    } else {
        jxl_img.img_free(&out)
    }
    return r
}
