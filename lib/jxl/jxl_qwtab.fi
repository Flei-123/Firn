// SPDX-License-Identifier: MPL-2.0
// lib/jxl/jxl_qwtab.fi -- jxl_qwtab: JPEG XL default dequantization tables for every quant kind
import jxl.jxl_qwdata
import std.math
import std.rt

export { QW_KIND_COUNT, QW_REC_WORDS, QW_MODE_LIBRARY, QW_MODE_RAW, qw_kind_of, qw_kind_rows, qw_kind_cols, qw_table, qw_table_rec, qw_default_rec, qw_rec_set_f, qw_rec_f }

const QW_KIND_COUNT: usize = 17
const QW_REC_WORDS: usize = 164
const QW_MODE_LIBRARY: u64 = 0
const QW_MODE_RAW: u64 = 7
const REC_HEAD: usize = 4
const MULT_AT: usize = 48
const AFV_BANDS_AT: usize = 27
const AFV_4X4_AT: usize = 75

static KIND_OF: [u8; 27] = [0, 1, 2, 3, 4, 5, 6, 6, 7, 7, 8, 8, 9, 9, 10, 10, 10, 10, 11, 12, 12, 13, 14, 14, 15, 16, 16]
static KIND_ROWS: [usize; 17] = [8, 8, 8, 8, 16, 32, 8, 8, 16, 8, 8, 64, 32, 128, 64, 256, 128]
static KIND_COLS: [usize; 17] = [8, 8, 8, 8, 16, 32, 16, 32, 32, 8, 8, 64, 64, 128, 128, 256, 256]
static KIND_MODE: [u8; 17] = [0, 1, 2, 3, 0, 0, 0, 0, 0, 4, 5, 0, 0, 0, 0, 0, 0]
static KIND_BANDS: [usize; 17] = [6, 0, 0, 4, 7, 8, 7, 8, 8, 4, 0, 8, 8, 8, 8, 8, 8]
static AFV_FREQS: [f64; 16] = [0.0, 0.0, 0.8517778890324296, 5.37778436506804, 0.0, 0.0, 4.734747904497923, 5.449245381693219, 1.6598270267479331, 4.0, 7.275749096817861, 10.423227632456525, 2.662932286148962, 7.630657783650829, 8.962388608184032, 12.97166202570235]

fn fld(p: u64, i: usize) -> f64 {
    return *((p +% ((i * 8) as u64)) as *mut f64)
}

fn fst(p: u64, i: usize, v: f64) {
    *((p +% ((i * 8) as u64)) as *mut f64) = v
}

fn qw_kind_of(t: u32) -> usize {
    return KIND_OF[t as usize] as usize
}

fn qw_kind_rows(kind: usize) -> usize {
    return KIND_ROWS[kind]
}

fn qw_kind_cols(kind: usize) -> usize {
    return KIND_COLS[kind]
}

fn mult(v: f64) -> f64 {
    if v > 0.0 {
        return 1.0 + v
    }
    return 1.0 / (1.0 - v)
}

fn qw_rec_f(rec: u64, i: usize) -> f64 {
    return fld(rec, REC_HEAD + i)
}

fn qw_rec_set_f(rec: u64, i: usize, v: f64) {
    fst(rec, REC_HEAD + i, v)
}

fn load_bands(bands: u64, rec: u64, off: usize, nb: usize) -> bool {
    fst(bands, 0, qw_rec_f(rec, off))
    if fld(bands, 0) < 0.00000001 {
        return false
    }
    var i: usize = 1
    while i < nb {
        fst(bands, i, fld(bands, i - 1) * mult(qw_rec_f(rec, off + i)))
        if fld(bands, i) < 0.00000001 {
            return false
        }
        i = i + 1
    }
    return true
}


fn interpolate(pos: f64, max: f64, bands: u64, len: usize) -> f64 {
    let scaled: f64 = pos * ((len - 1) as f64) / max
    var idx: usize = scaled as usize
    if idx + 2 > len {
        idx = len - 2
    }
    let a: f64 = fld(bands, idx)
    let b: f64 = fld(bands, idx + 1)
    return a * math.powf(b / a, scaled - (idx as f64))
}

fn bands_weights(rows: usize, cols: usize, rec: u64, off: usize, nb: usize, out: u64) -> bool {
    let bands: u64 = rt.heap_alloc(64 * 8)
    if bands == 0 {
        return false
    }
    var ok: bool = true
    var c: usize = 0
    while c < 3 && ok {
        ok = load_bands(bands, rec, off + c * nb, nb)
        if ok {
            let scale: f64 = ((nb - 1) as f64) / (math.sqrt(2.0) + 0.000001)
            let rcpcol: f64 = scale / ((cols - 1) as f64)
            let rcprow: f64 = scale / ((rows - 1) as f64)
            var y: usize = 0
            while y < rows {
                let dy: f64 = (y as f64) * rcprow
                var x: usize = 0
                while x < cols {
                    let dx: f64 = (x as f64) * rcpcol
                    var w: f64 = fld(bands, 0)
                    if nb > 1 {
                        w = interpolate(math.sqrt(dx * dx + dy * dy), (nb - 1) as f64, bands, nb)
                    }
                    fst(out, c * rows * cols + y * cols + x, w)
                    x = x + 1
                }
                y = y + 1
            }
        }
        c = c + 1
    }
    rt.heap_free(bands, 64 * 8)
    return ok
}

fn identity_weights(rec: u64, w: u64) {
    var c: usize = 0
    while c < 3 {
        var i: usize = 0
        while i < 64 {
            fst(w, c * 64 + i, qw_rec_f(rec, c * 3))
            i = i + 1
        }
        fst(w, c * 64 + 1, qw_rec_f(rec, c * 3 + 1))
        fst(w, c * 64 + 8, qw_rec_f(rec, c * 3 + 1))
        fst(w, c * 64 + 9, qw_rec_f(rec, c * 3 + 2))
        c = c + 1
    }
}

fn dct2_fill(w: u64, start: usize, x0: usize, y0: usize, n: usize, v: f64) {
    var y: usize = 0
    while y < n {
        var x: usize = 0
        while x < n {
            fst(w, start + (y0 + y) * 8 + x0 + x, v)
            x = x + 1
        }
        y = y + 1
    }
}

fn dct2_weights(rec: u64, w: u64) {
    var c: usize = 0
    while c < 3 {
        let s: usize = c * 64
        let p: usize = c * 6
        fst(w, s, 1.0)
        fst(w, s + 1, qw_rec_f(rec, p))
        fst(w, s + 8, qw_rec_f(rec, p))
        fst(w, s + 9, qw_rec_f(rec, p + 1))
        dct2_fill(w, s, 2, 0, 2, qw_rec_f(rec, p + 2))
        dct2_fill(w, s, 0, 2, 2, qw_rec_f(rec, p + 2))
        dct2_fill(w, s, 2, 2, 2, qw_rec_f(rec, p + 3))
        dct2_fill(w, s, 4, 0, 4, qw_rec_f(rec, p + 4))
        dct2_fill(w, s, 0, 4, 4, qw_rec_f(rec, p + 4))
        dct2_fill(w, s, 4, 4, 4, qw_rec_f(rec, p + 5))
        c = c + 1
    }
}

fn dct4_weights(rec: u64, w: u64) -> bool {
    let w4: u64 = rt.heap_alloc(3 * 16 * 8)
    if w4 == 0 {
        return false
    }
    var ok: bool = bands_weights(4, 4, rec, 0, rt.ld64(rec, 1) as usize, w4)
    if ok {
        var c: usize = 0
        while c < 3 {
            var y: usize = 0
            while y < 8 {
                var x: usize = 0
                while x < 8 {
                    fst(w, c * 64 + y * 8 + x, fld(w4, c * 16 + (y / 2) * 4 + x / 2))
                    x = x + 1
                }
                y = y + 1
            }
            let m0: f64 = qw_rec_f(rec, MULT_AT + c * 2)
            let m1: f64 = qw_rec_f(rec, MULT_AT + c * 2 + 1)
            fst(w, c * 64 + 1, fld(w, c * 64 + 1) / m0)
            fst(w, c * 64 + 8, fld(w, c * 64 + 8) / m0)
            fst(w, c * 64 + 9, fld(w, c * 64 + 9) / m1)
            c = c + 1
        }
    }
    rt.heap_free(w4, 3 * 16 * 8)
    return ok
}

fn dct4x8_weights(rec: u64, w: u64) -> bool {
    let w48: u64 = rt.heap_alloc(3 * 32 * 8)
    if w48 == 0 {
        return false
    }
    var ok: bool = bands_weights(4, 8, rec, 0, rt.ld64(rec, 1) as usize, w48)
    if ok {
        var c: usize = 0
        while c < 3 {
            var y: usize = 0
            while y < 8 {
                var x: usize = 0
                while x < 8 {
                    fst(w, c * 64 + y * 8 + x, fld(w48, c * 32 + (y / 2) * 8 + x))
                    x = x + 1
                }
                y = y + 1
            }
            fst(w, c * 64 + 8, fld(w, c * 64 + 8) / qw_rec_f(rec, MULT_AT + c))
            c = c + 1
        }
    }
    rt.heap_free(w48, 3 * 32 * 8)
    return ok
}

fn afv_weights(rec: u64, w: u64) -> bool {
    let w48: u64 = rt.heap_alloc(3 * 32 * 8)
    let w44: u64 = rt.heap_alloc(3 * 16 * 8)
    let bands: u64 = rt.heap_alloc(8 * 8)
    if w48 == 0 || w44 == 0 || bands == 0 {
        return false
    }
    var ok: bool = bands_weights(4, 8, rec, AFV_BANDS_AT, rt.ld64(rec, 1) as usize, w48)
    if ok {
        ok = bands_weights(4, 4, rec, AFV_4X4_AT, rt.ld64(rec, 2) as usize, w44)
    }
    let lo: f64 = 0.8517778890324296
    let hi: f64 = 12.97166202570235 - lo + 0.000001
    var c: usize = 0
    while c < 3 && ok {
        let p: usize = c * 9
        fst(bands, 0, qw_rec_f(rec, p + 5))
        if fld(bands, 0) < 0.00000001 {
            ok = false
        }
        var i: usize = 1
        while i < 4 && ok {
            fst(bands, i, fld(bands, i - 1) * mult(qw_rec_f(rec, p + 5 + i)))
            if fld(bands, i) < 0.00000001 {
                ok = false
            }
            i = i + 1
        }
        if ok {
            let s: usize = c * 64
            fst(w, s, 1.0)
            fst(w, s + 8, qw_rec_f(rec, p))
            fst(w, s + 1, qw_rec_f(rec, p + 1))
            fst(w, s + 16, qw_rec_f(rec, p + 2))
            fst(w, s + 2, qw_rec_f(rec, p + 3))
            fst(w, s + 18, qw_rec_f(rec, p + 4))
            var y: usize = 0
            while y < 4 {
                var x: usize = 0
                while x < 4 {
                    if x >= 2 || y >= 2 {
                        fst(w, s + 2 * y * 8 + 2 * x, interpolate(AFV_FREQS[y * 4 + x] - lo, hi, bands, 4))
                    }
                    x = x + 1
                }
                y = y + 1
            }
            y = 0
            while y < 4 {
                var x2: usize = 0
                while x2 < 8 {
                    if x2 != 0 || y != 0 {
                        fst(w, s + (2 * y + 1) * 8 + x2, fld(w48, c * 32 + y * 8 + x2))
                    }
                    x2 = x2 + 1
                }
                var x3: usize = 0
                while x3 < 4 {
                    if x3 != 0 || y != 0 {
                        fst(w, s + 2 * y * 8 + 2 * x3 + 1, fld(w44, c * 16 + y * 4 + x3))
                    }
                    x3 = x3 + 1
                }
                y = y + 1
            }
        }
        c = c + 1
    }
    rt.heap_free(w48, 3 * 32 * 8)
    rt.heap_free(w44, 3 * 16 * 8)
    rt.heap_free(bands, 8 * 8)
    return ok
}

fn copy_params(rec: u64, dst: usize, src: usize, n: usize) {
    var i: usize = 0
    while i < n {
        qw_rec_set_f(rec, dst + i, jxl_qwdata.qwd_param(src + i))
        i = i + 1
    }
}

fn qw_default_rec(kind: usize, rec: u64) {
    let off: usize = jxl_qwdata.qwd_offset(kind)
    let mode: u8 = KIND_MODE[kind]
    rt.st64(rec, 1, 0)
    rt.st64(rec, 2, 0)
    rt.st64(rec, 3, 0)
    if mode == 0 {
        rt.st64(rec, 0, 6)
        rt.st64(rec, 1, KIND_BANDS[kind] as u64)
        copy_params(rec, 0, off, 3 * KIND_BANDS[kind])
    }
    if mode == 1 {
        rt.st64(rec, 0, 1)
        copy_params(rec, 0, off, 9)
    }
    if mode == 2 {
        rt.st64(rec, 0, 2)
        copy_params(rec, 0, off, 18)
    }
    if mode == 3 {
        rt.st64(rec, 0, 3)
        rt.st64(rec, 1, 4)
        copy_params(rec, 0, off, 12)
        copy_params(rec, MULT_AT, off + 12, 6)
    }
    if mode == 4 {
        rt.st64(rec, 0, 4)
        rt.st64(rec, 1, 4)
        copy_params(rec, 0, off, 12)
        copy_params(rec, MULT_AT, off + 12, 3)
    }
    if mode == 5 {
        rt.st64(rec, 0, 5)
        rt.st64(rec, 1, 4)
        rt.st64(rec, 2, 4)
        copy_params(rec, 0, off, 27)
        copy_params(rec, AFV_BANDS_AT, jxl_qwdata.qwd_offset(9), 12)
        copy_params(rec, AFV_4X4_AT, jxl_qwdata.qwd_offset(3), 12)
    }
}

fn qw_table_rec(kind: usize, rec: u64, out: u64) -> bool {
    let rows: usize = KIND_ROWS[kind]
    let cols: usize = KIND_COLS[kind]
    let num: usize = rows * cols
    let mode: u64 = rt.ld64(rec, 0)
    var ok: bool = true
    if mode == 6 {
        ok = bands_weights(rows, cols, rec, 0, rt.ld64(rec, 1) as usize, out)
    }
    if mode == 1 {
        identity_weights(rec, out)
    }
    if mode == 2 {
        dct2_weights(rec, out)
    }
    if mode == 3 {
        ok = dct4_weights(rec, out)
    }
    if mode == 4 {
        ok = dct4x8_weights(rec, out)
    }
    if mode == 5 {
        ok = afv_weights(rec, out)
    }
    if mode == QW_MODE_RAW {
        rt.mem_copy(out, rt.ld64(rec, 3), 3 * num * 8)
    }
    var i: usize = 0
    while i < 3 * num && ok {
        let w: f64 = fld(out, i)
        if w < 0.00000001 || w >= 100000000.0 {
            ok = false
        } else {
            fst(out, i, 1.0 / w)
        }
        i = i + 1
    }
    return ok
}

fn qw_table(kind: usize, out: u64) -> bool {
    let rec: u64 = rt.heap_alloc(QW_REC_WORDS * 8)
    if rec == 0 {
        return false
    }
    rt.mem_set(rec, 0 as u8, QW_REC_WORDS * 8)
    qw_default_rec(kind, rec)
    let ok: bool = qw_table_rec(kind, rec, out)
    rt.heap_free(rec, QW_REC_WORDS * 8)
    return ok
}
