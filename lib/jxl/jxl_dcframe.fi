// lib/jxl/jxl_dcframe.fi -- jxl_dcframe: fill VarDCT LF data from a previously decoded DC frame (progressive_dc)
import jxl.jxl_err
import jxl.jxl_lfdata
import jxl.jxl_refs
import std.rt

export { dcf_fill }

fn dcf_fill(d: *mut jxl_lfdata.JxlLfData, refs: *mut jxl_refs.JxlRefs, level: u32) -> i32 {
    if !jxl_refs.refs_dc_valid(refs, level as usize) {
        return jxl_err.JX_BAD
    }
    let s: *mut jxl_refs.JxlRefSlot = &(*refs).dc[level as usize]
    if (*s).w != (*d).bw || (*s).h != (*d).bh {
        return jxl_err.JX_BAD
    }
    var c: usize = 0
    while c < 3 {
        var y: usize = 0
        while y < (*d).bh {
            var x: usize = 0
            while x < (*d).bw {
                let at: u64 = (*s).planes +% ((((c * (*s).plane_len) + y * (*s).stride + x) * 8) as u64)
                jxl_lfdata.lfd_dc_set(d, c, x, y, *(at as *mut f64))
                x = x + 1
            }
            y = y + 1
        }
        c = c + 1
    }
    return jxl_err.JX_OK
}
