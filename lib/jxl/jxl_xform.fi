import std.rt
import jxl.jxl_bits
import jxl.jxl_chan
import jxl.jxl_err
import jxl.jxl_img
import jxl.jxl_mem
import jxl.jxl_squeeze
import jxl.jxl_wp

export {
    JxlXform, xf_new, xf_free, xf_read, xf_meta, xf_inverse, XF_RCT, XF_PALETTE, XF_SQUEEZE,
}

const XF_RCT: u32 = 0
const XF_PALETTE: u32 = 1
const XF_SQUEEZE: u32 = 2
const NO_SHIFT: u32 = 4294967295

static DELTA_PALETTE: [i16; 216] = [
    0, 0, 0, 4, 4, 4, 11, 0, 0, 0, 0, -13, 0, -12, 0, -10, -10, -10,
    -18, -18, -18, -27, -27, -27, -18, -18, 0, 0, 0, -32, -32, 0, 0, -37, -37, -37,
    0, -32, -32, 24, 24, 45, 50, 50, 50, -45, -24, -24, -24, -45, -45, 0, -24, -24,
    -34, -34, 0, -24, 0, -24, -45, -45, -24, 64, 64, 64, -32, 0, -32, 0, -32, 0,
    -32, 0, 32, -24, -45, -24, 45, 24, 45, 24, -24, -45, -45, -24, 24, 80, 80, 80,
    64, 0, 0, 0, 0, -64, 0, -64, -64, -24, -24, 45, 96, 96, 96, 64, 64, 0,
    45, -24, -24, 34, -34, 0, 112, 112, 112, 24, -45, -45, 45, 45, -24, 0, -32, 32,
    24, -24, 45, 0, 96, 96, 45, -24, 24, 24, -45, -24, -24, -45, 24, 0, -64, 0,
    96, 0, 0, 128, 128, 128, 64, 0, 64, 144, 144, 144, 96, 96, 0, -36, -36, 36,
    45, -24, -45, 45, -45, -24, 0, 0, -96, 0, 128, 128, 0, 96, 0, 45, 24, -45,
    -128, 0, 0, 24, -45, 24, -45, 24, -45, 64, 0, -64, 64, -64, -64, 96, 0, 96,
    45, -45, 24, 24, 45, -45, 64, 64, -64, 128, 128, 0, 0, 0, -128, -24, 45, -45]

struct JxlXform {
    id: u32,
    begin_c: u32,
    rct_type: u32,
    num_c: u32,
    nb_colors: u32,
    nb_deltas: u32,
    predictor: u32,
    nsq: u32,
    sq: u64,
}

fn xf_new() -> JxlXform {
    return JxlXform { id: 0, begin_c: 0, rct_type: 6, num_c: 3, nb_colors: 256, nb_deltas: 0, predictor: 0, nsq: 0, sq: 0 }
}

fn xf_free(x: *mut JxlXform) {
    if (*x).sq != 0 {
        rt.heap_free((*x).sq, (*x).nsq as usize * 16)
    }
    *x = xf_new()
}

fn read_begin_c(b: *mut jxl_bits.JxlBits) -> u32 {
    return jxl_bits.jb_u32(b, jxl_bits.jd_bits(3), jxl_bits.jd_off(6, 8), jxl_bits.jd_off(10, 72), jxl_bits.jd_off(13, 1096))
}

fn xf_read(b: *mut jxl_bits.JxlBits, x: *mut JxlXform) -> i32 {
    *x = xf_new()
    (*x).id = jxl_bits.jb_u32(b, jxl_bits.jd_val(0), jxl_bits.jd_val(1), jxl_bits.jd_val(2), jxl_bits.jd_val(3))
    if (*x).id == 3 {
        return jxl_err.JX_BAD
    }
    if (*x).id == XF_RCT || (*x).id == XF_PALETTE {
        (*x).begin_c = read_begin_c(b)
    }
    if (*x).id == XF_RCT {
        (*x).rct_type = jxl_bits.jb_u32(b, jxl_bits.jd_val(6), jxl_bits.jd_bits(2), jxl_bits.jd_off(4, 2), jxl_bits.jd_off(6, 10))
        if (*x).rct_type >= 42 {
            return jxl_err.JX_BAD
        }
    }
    if (*x).id == XF_PALETTE {
        (*x).num_c = jxl_bits.jb_u32(b, jxl_bits.jd_val(1), jxl_bits.jd_val(3), jxl_bits.jd_val(4), jxl_bits.jd_off(13, 1))
        (*x).nb_colors = jxl_bits.jb_u32(b, jxl_bits.jd_off(8, 0), jxl_bits.jd_off(10, 256), jxl_bits.jd_off(12, 1280), jxl_bits.jd_off(16, 5376))
        (*x).nb_deltas = jxl_bits.jb_u32(b, jxl_bits.jd_val(0), jxl_bits.jd_off(8, 1), jxl_bits.jd_off(10, 257), jxl_bits.jd_off(16, 1281))
        (*x).predictor = jxl_bits.jb_read(b, 4)
        if (*x).predictor >= 14 {
            return jxl_err.JX_BAD
        }
    }
    if (*x).id == XF_SQUEEZE {
        (*x).nsq = jxl_bits.jb_u32(b, jxl_bits.jd_val(0), jxl_bits.jd_off(4, 1), jxl_bits.jd_off(6, 9), jxl_bits.jd_off(8, 41))
        if (*x).nsq > 0 {
            (*x).sq = rt.heap_alloc((*x).nsq as usize * 16)
            if (*x).sq == 0 {
                return jxl_err.JX_MEMORY
            }
            var i: usize = 0
            while i < (*x).nsq as usize {
                rt.st32((*x).sq, i * 4, jxl_bits.jb_read(b, 1))
                rt.st32((*x).sq, i * 4 + 1, jxl_bits.jb_read(b, 1))
                rt.st32((*x).sq, i * 4 + 2, jxl_bits.jb_u32(b, jxl_bits.jd_bits(3), jxl_bits.jd_off(6, 8), jxl_bits.jd_off(10, 72), jxl_bits.jd_off(13, 1096)))
                rt.st32((*x).sq, i * 4 + 3, jxl_bits.jb_u32(b, jxl_bits.jd_val(1), jxl_bits.jd_val(2), jxl_bits.jd_val(3), jxl_bits.jd_off(4, 4)))
                i = i + 1
            }
        }
    }
    if jxl_bits.jb_over(b) {
        return jxl_err.JX_TRUNCATED
    }
    return jxl_err.JX_OK
}

fn check_equal(img: *mut jxl_img.JxlImage, c1: usize, c2: usize) -> bool {
    if c1 > img_count(img) || c2 >= img_count(img) || c2 < c1 {
        return false
    }
    if c1 < (*img).nb_meta && c2 >= (*img).nb_meta {
        return false
    }
    var c: usize = c1 + 1
    while c <= c2 {
        if jxl_img.img_w(img, c) != jxl_img.img_w(img, c1) || jxl_img.img_h(img, c) != jxl_img.img_h(img, c1) {
            return false
        }
        if jxl_img.img_hs(img, c) != jxl_img.img_hs(img, c1) || jxl_img.img_vs(img, c) != jxl_img.img_vs(img, c1) {
            return false
        }
        c = c + 1
    }
    return true
}

fn img_count(img: *mut jxl_img.JxlImage) -> usize {
    return jxl_img.img_count(img)
}

fn xf_meta(x: *mut JxlXform, img: *mut jxl_img.JxlImage) -> i32 {
    if (*x).id == XF_RCT {
        if !check_equal(img, (*x).begin_c as usize, (*x).begin_c as usize + 2) {
            return jxl_err.JX_BAD
        }
        return jxl_err.JX_OK
    }
    if (*x).id == XF_PALETTE {
        let begin_c: usize = (*x).begin_c as usize
        let end_c: usize = begin_c + (*x).num_c as usize - 1
        if (*x).num_c == 0 || !check_equal(img, begin_c, end_c) {
            return jxl_err.JX_BAD
        }
        let nb: usize = (*x).num_c as usize
        if begin_c >= (*img).nb_meta {
            (*img).nb_meta = (*img).nb_meta + 1
        } else {
            if end_c >= (*img).nb_meta || nb > 2 + (*img).nb_meta {
                return jxl_err.JX_BAD
            }
            (*img).nb_meta = (*img).nb_meta + 2 - nb
        }
        var k: usize = begin_c + 1
        while k <= end_c {
            jxl_img.img_remove(img, begin_c + 1)
            k = k + 1
        }
        jxl_img.img_insert(img, 0, ((*x).nb_colors + (*x).nb_deltas) as usize, nb, NO_SHIFT, NO_SHIFT)
        return jxl_err.JX_OK
    }
    if (*x).id == XF_SQUEEZE {
        if (*x).nsq == 0 {
            let r: i32 = jxl_squeeze.sq_default(img, &(*x).sq, &(*x).nsq)
            if r != jxl_err.JX_OK {
                return r
            }
        }
        return jxl_squeeze.sq_meta((*x).sq, (*x).nsq as usize, img)
    }
    return jxl_err.JX_UNSUPPORTED
}

fn inv_rct(x: *mut JxlXform, img: *mut jxl_img.JxlImage) -> i32 {
    let m: usize = (*x).begin_c as usize
    if !check_equal(img, m, m + 2) {
        return jxl_err.JX_BAD
    }
    let rct: u32 = (*x).rct_type
    if rct == 0 {
        return jxl_err.JX_OK
    }
    let w: usize = jxl_img.img_w(img, m)
    let h: usize = jxl_img.img_h(img, m)
    let perm: u32 = rct / 7
    let custom: u32 = rct % 7
    if perm >= 6 {
        return jxl_err.JX_BAD
    }
    let o0: usize = m + (perm % 3) as usize
    let o1: usize = m + ((perm + 1 + perm / 3) % 3) as usize
    let o2: usize = m + ((perm + 2 - perm / 3) % 3) as usize
    if custom == 0 {
        let s0: u64 = jxl_img.img_data(img, m)
        let s1: u64 = jxl_img.img_data(img, m + 1)
        let s2: u64 = jxl_img.img_data(img, m + 2)
        var y: usize = 0
        var i: usize = 0
        let n: usize = w * h
        let tmp: u64 = rt.heap_alloc(n * 12 + 4)
        rt.mem_copy(tmp, s0, n * 4)
        rt.mem_copy(tmp + (n * 4) as u64, s1, n * 4)
        rt.mem_copy(tmp + (n * 8) as u64, s2, n * 4)
        rt.mem_copy(jxl_img.img_data(img, o0), tmp, n * 4)
        rt.mem_copy(jxl_img.img_data(img, o1), tmp + (n * 4) as u64, n * 4)
        rt.mem_copy(jxl_img.img_data(img, o2), tmp + (n * 8) as u64, n * 4)
        rt.heap_free(tmp, n * 12 + 4)
        return jxl_err.JX_OK
    }
    let second: u32 = custom >> 1
    let third: u32 = custom & 1
    let d0: u64 = jxl_img.img_data(img, m)
    let d1: u64 = jxl_img.img_data(img, m + 1)
    let d2: u64 = jxl_img.img_data(img, m + 2)
    let t0: u64 = jxl_img.img_data(img, o0)
    let t1: u64 = jxl_img.img_data(img, o1)
    let t2: u64 = jxl_img.img_data(img, o2)
    var i: usize = 0
    while i < w * h {
        var a: i64 = jxl_mem.ldi(d0, i) as i64
        var bb: i64 = jxl_mem.ldi(d1, i) as i64
        var c: i64 = jxl_mem.ldi(d2, i) as i64
        var r0: i64 = a
        var r1: i64 = bb
        var r2: i64 = c
        if custom == 6 {
            let tmp: i64 = a - (c >> 1)
            r1 = c + tmp
            r2 = tmp - (bb >> 1)
            r0 = r2 + bb
        } else {
            if third == 1 {
                r2 = c + a
            }
            if second == 1 {
                r1 = bb + a
            } else if second == 2 {
                r1 = bb + ((a + r2) >> 1)
            }
        }
        jxl_mem.sti(t0, i, r0 as i32)
        jxl_mem.sti(t1, i, r1 as i32)
        jxl_mem.sti(t2, i, r2 as i32)
        i = i + 1
    }
    return jxl_err.JX_OK
}

fn scale(v: i64, bit_depth: i64) -> i64 {
    return (v * (((1 as i64) << bit_depth) - 1)) >> 2
}

fn palette_value(pal: u64, index_in: i64, c: usize, size: i64, bit_depth: i64) -> i64 {
    var index: i64 = index_in
    if index < 0 {
        if c >= 3 {
            return 0
        }
        index = 0 - (index + 1)
        index = index % 143
        var res: i64 = DELTA_PALETTE[(((index + 1) >> 1) as usize) * 3 + c] as i64
        if (index & 1) == 0 {
            res = 0 - res
        }
        if bit_depth > 8 {
            res = res * (((1 as i64) << (bit_depth - 8)))
        }
        return res
    }
    if size <= index && index < size + 64 {
        if c >= 3 {
            return 0
        }
        index = index - size
        index = index >> ((c * 2) as i64)
        return scale(index % 4, bit_depth) + ((1 as i64) << jxl_mem.max64(0, bit_depth - 3))
    }
    if size + 64 <= index {
        if c >= 3 {
            return 0
        }
        index = index - (size + 64)
        if c == 1 {
            index = index / 5
        }
        if c == 2 {
            index = index / 25
        }
        return scale(index % 5, bit_depth)
    }
    return jxl_mem.ldi(pal, c * (size as usize) + (index as usize)) as i64
}

fn inv_palette(x: *mut JxlXform, img: *mut jxl_img.JxlImage, wph: *mut jxl_wp.JxlWpHeader, bit_depth: i64) -> i32 {
    if (*img).nb_meta < 1 {
        return jxl_err.JX_BAD
    }
    let nb: usize = jxl_img.img_h(img, 0)
    let c0: usize = (*x).begin_c as usize + 1
    if c0 >= jxl_img.img_count(img) || nb < 1 {
        return jxl_err.JX_BAD
    }
    let w: usize = jxl_img.img_w(img, c0)
    let h: usize = jxl_img.img_h(img, c0)
    var i: usize = 1
    while i < nb {
        jxl_img.img_insert(img, c0 + 1, w, h, jxl_img.img_hs(img, c0), jxl_img.img_vs(img, c0))
        i = i + 1
    }
    let pal: u64 = jxl_img.img_data(img, 0)
    let psize: i64 = jxl_img.img_w(img, 0) as i64
    let bd: i64 = jxl_mem.min64(bit_depth, 24)
    if w > 0 {
        if (*x).nb_deltas == 0 && (*x).predictor == 0 {
            if nb == 1 {
                let d: u64 = jxl_img.img_data(img, c0)
                var k: usize = 0
                while k < w * h {
                    let idx: i64 = jxl_mem.min64(jxl_mem.max64(jxl_mem.ldi(d, k) as i64, 0), psize - 1)
                    jxl_mem.sti(d, k, palette_value(pal, idx, 0, psize, bd) as i32)
                    k = k + 1
                }
            } else {
                let n: usize = w * h
                let idxs: u64 = rt.heap_alloc(n * 4 + 4)
                rt.mem_copy(idxs, jxl_img.img_data(img, c0), n * 4)
                var c: usize = 0
                while c < nb {
                    let d: u64 = jxl_img.img_data(img, c0 + c)
                    var k: usize = 0
                    while k < n {
                        jxl_mem.sti(d, k, palette_value(pal, jxl_mem.ldi(idxs, k) as i64, c, psize, bd) as i32)
                        k = k + 1
                    }
                    c = c + 1
                }
                rt.heap_free(idxs, n * 4 + 4)
            }
        } else {
            let n: usize = w * h
            let idxs: u64 = rt.heap_alloc(n * 4 + 4)
            rt.mem_copy(idxs, jxl_img.img_data(img, c0), n * 4)
            var c: usize = 0
            while c < nb {
                let d: u64 = jxl_img.img_data(img, c0 + c)
                var wp: jxl_wp.JxlWp = jxl_wp.wp_new(wph, w)
                var y: usize = 0
                while y < h {
                    var xx: usize = 0
                    while xx < w {
                        let index: i64 = jxl_mem.ldi(idxs, y * w + xx) as i64
                        let entry: i64 = palette_value(pal, index, c, psize, bd)
                        var val: i64 = entry
                        if index < ((*x).nb_deltas as i64) {
                            var left: i64 = 0
                            if xx > 0 {
                                left = jxl_mem.ldi(d, y * w + xx - 1) as i64
                            } else if y > 0 {
                                left = jxl_mem.ldi(d, (y - 1) * w + xx) as i64
                            }
                            var top: i64 = left
                            if y > 0 {
                                top = jxl_mem.ldi(d, (y - 1) * w + xx) as i64
                            }
                            var tl: i64 = left
                            if xx > 0 && y > 0 {
                                tl = jxl_mem.ldi(d, (y - 1) * w + xx - 1) as i64
                            }
                            var tr: i64 = top
                            if xx + 1 < w && y > 0 {
                                tr = jxl_mem.ldi(d, (y - 1) * w + xx + 1) as i64
                            }
                            var ll: i64 = left
                            if xx > 1 {
                                ll = jxl_mem.ldi(d, y * w + xx - 2) as i64
                            }
                            var tt: i64 = top
                            if y > 1 {
                                tt = jxl_mem.ldi(d, (y - 2) * w + xx) as i64
                            }
                            var trr: i64 = tr
                            if xx + 2 < w && y > 0 {
                                trr = jxl_mem.ldi(d, (y - 1) * w + xx + 2) as i64
                            }
                            var wpv: i64 = 0
                            if (*x).predictor == 6 {
                                wpv = jxl_wp.wp_predict(&wp, xx, y, top, left, tr, tl, tt, 0)
                            }
                            val = entry + jxl_chan.predict_one((*x).predictor, left, top, tt, tl, tr, ll, trr, wpv)
                        }
                        jxl_mem.sti(d, y * w + xx, val as i32)
                        if (*x).predictor == 6 {
                            jxl_wp.wp_update(&wp, val, xx, y)
                        }
                        xx = xx + 1
                    }
                    y = y + 1
                }
                jxl_wp.wp_free(&wp)
                c = c + 1
            }
            rt.heap_free(idxs, n * 4 + 4)
        }
    }
    if c0 >= (*img).nb_meta {
        (*img).nb_meta = (*img).nb_meta - 1
    } else {
        (*img).nb_meta = (*img).nb_meta + nb - 2
    }
    jxl_img.img_remove(img, 0)
    return jxl_err.JX_OK
}

fn xf_inverse(x: *mut JxlXform, img: *mut jxl_img.JxlImage, wph: *mut jxl_wp.JxlWpHeader, bit_depth: i64) -> i32 {
    if (*x).id == XF_RCT {
        return inv_rct(x, img)
    }
    if (*x).id == XF_PALETTE {
        return inv_palette(x, img, wph, bit_depth)
    }
    if (*x).id == XF_SQUEEZE {
        return jxl_squeeze.sq_inverse((*x).sq, (*x).nsq as usize, img)
    }
    return jxl_err.JX_UNSUPPORTED
}
