// lib/jxl/jxl_features.fi -- jxl_features: apply patches, splines and noise to reconstructed XYB planes
import jxl.jxl_cmap
import jxl.jxl_err
import jxl.jxl_frame
import jxl.jxl_lfglobal
import jxl.jxl_noise
import jxl.jxl_patches
import jxl.jxl_refs
import jxl.jxl_splines

export { feat_apply, feat_apply_late }

fn feat_apply(g: *mut jxl_lfglobal.JxlLfGlobal, f: *mut jxl_frame.JxlFrame, refs: *mut jxl_refs.JxlRefs, planes: u64, stride: usize, plane_len: usize) -> i32 {
    let w: usize = (*f).width as usize
    let h: usize = (*f).height as usize
    if ((*f).flags & jxl_frame.JF_FLAG_PATCHES) != 0 {
        let pr: i32 = jxl_patches.patches_apply(&(*g).patches, refs, planes, stride, plane_len, w, h)
        if pr != jxl_err.JX_OK {
            return pr
        }
    }
    let ytox: f64 = jxl_cmap.cmap_ratio_x(&(*g).cmap, 0)
    let ytob: f64 = jxl_cmap.cmap_ratio_b(&(*g).cmap, 0)
    if ((*f).flags & jxl_frame.JF_FLAG_SPLINES) != 0 {
        let sr: i32 = jxl_splines.splines_apply(&(*g).splines, ytox, ytob, planes, stride, plane_len, w, h)
        if sr != jxl_err.JX_OK {
            return sr
        }
    }
    if ((*f).flags & jxl_frame.JF_FLAG_NOISE) != 0 && (*f).upsampling == 1 {
        return feat_noise(g, f, refs, planes, stride, plane_len, w, h)
    }
    return jxl_err.JX_OK
}

fn feat_noise(g: *mut jxl_lfglobal.JxlLfGlobal, f: *mut jxl_frame.JxlFrame, refs: *mut jxl_refs.JxlRefs, planes: u64, stride: usize, plane_len: usize, w: usize, h: usize) -> i32 {
    let ytox: f64 = jxl_cmap.cmap_ratio_x(&(*g).cmap, 0)
    let ytob: f64 = jxl_cmap.cmap_ratio_b(&(*g).cmap, 0)
    var vis: u64 = 1
    var nonvis: u64 = 0
    if refs != (0 as *mut jxl_refs.JxlRefs) {
        vis = (*refs).visible
        nonvis = (*refs).nonvisible
    }
    if !jxl_noise.noise_apply(planes, stride, plane_len, w, h, (*f).group_dim as usize, &(*g).noise, ytox, ytob, vis, nonvis) {
        return jxl_err.JX_MEMORY
    }
    return jxl_err.JX_OK
}

fn feat_apply_late(g: *mut jxl_lfglobal.JxlLfGlobal, f: *mut jxl_frame.JxlFrame, refs: *mut jxl_refs.JxlRefs, planes: u64, stride: usize, plane_len: usize, w: usize, h: usize) -> i32 {
    if ((*f).flags & jxl_frame.JF_FLAG_NOISE) != 0 && (*f).upsampling != 1 {
        return feat_noise(g, f, refs, planes, stride, plane_len, w, h)
    }
    return jxl_err.JX_OK
}
