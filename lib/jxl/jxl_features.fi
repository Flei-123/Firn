// lib/jxl/jxl_features.fi -- jxl_features: apply patches, splines and noise to reconstructed XYB planes
import jxl.jxl_cmap
import jxl.jxl_err
import jxl.jxl_frame
import jxl.jxl_lfglobal
import jxl.jxl_noise
import jxl.jxl_refs

export { feat_apply }

fn feat_apply(g: *mut jxl_lfglobal.JxlLfGlobal, f: *mut jxl_frame.JxlFrame, refs: *mut jxl_refs.JxlRefs, planes: u64, stride: usize, plane_len: usize) -> i32 {
    let w: usize = (*f).width as usize
    let h: usize = (*f).height as usize
    if ((*f).flags & jxl_frame.JF_FLAG_NOISE) != 0 {
        var vis: u64 = 1
        var nonvis: u64 = 0
        if refs != (0 as *mut jxl_refs.JxlRefs) {
            vis = (*refs).visible
            nonvis = (*refs).nonvisible
        }
        let ytox: f64 = jxl_cmap.cmap_ratio_x(&(*g).cmap, 0)
        let ytob: f64 = jxl_cmap.cmap_ratio_b(&(*g).cmap, 0)
        if !jxl_noise.noise_apply(planes, stride, plane_len, w, h, (*f).group_dim as usize, &(*g).noise, ytox, ytob, vis, nonvis) {
            return jxl_err.JX_MEMORY
        }
    }
    return jxl_err.JX_OK
}
