// lib/jxl/jxl_pad.fi -- jxl_pad: mirror-padded copies of f64 planes for border-free filters
import std.rt

export { mirror_index, pad_fill, pad_stride, pad_len }

fn mirror_index(i: i64, n: i64) -> usize {
    var v: i64 = i
    while v < 0 || v >= n {
        if v < 0 {
            v = 0 - v - 1
        } else {
            v = 2 * n - v - 1
        }
    }
    return v as usize
}

fn pad_stride(width: usize, pad: usize) -> usize {
    return width + 2 * pad
}

fn pad_len(width: usize, height: usize, pad: usize) -> usize {
    return (width + 2 * pad) * (height + 2 * pad)
}

fn pad_fill(src: u64, width: usize, height: usize, stride: usize, pad: usize, dst: u64) {
    let pw: usize = width + 2 * pad
    var y: usize = 0
    while y < height + 2 * pad {
        let sy: usize = mirror_index((y as i64) - (pad as i64), height as i64)
        let row: u64 = dst +% ((y * pw * 8) as u64)
        let srow: u64 = src +% ((sy * stride * 8) as u64)
        rt.mem_copy(row +% ((pad * 8) as u64), srow, width * 8)
        var k: usize = 0
        while k < pad {
            let lx: usize = mirror_index((k as i64) - (pad as i64), width as i64)
            let rx: usize = mirror_index((width + k) as i64, width as i64)
            *((row +% ((k * 8) as u64)) as *mut f64) = *((srow +% ((lx * 8) as u64)) as *mut f64)
            *((row +% (((pad + width + k) * 8) as u64)) as *mut f64) = *((srow +% ((rx * 8) as u64)) as *mut f64)
            k = k + 1
        }
        y = y + 1
    }
}
