export { int_to_float_bits }

fn int_to_float_bits(raw: i64, bits: u32, exp_bits: u32) -> u64 {
    var f: i64 = raw & 4294967295
    if bits == 32 {
        return f as u64
    }
    let sign_shift: i64 = (bits as i64) - 1
    let mant_bits: i64 = (bits as i64) - (exp_bits as i64) - 1
    let mant_shift: i64 = 23 - mant_bits
    let sign: i64 = f >> sign_shift
    f = f & (((1 as i64) << sign_shift) - 1)
    var sign_out: i64 = 0
    if sign != 0 {
        sign_out = 2147483648
    }
    if f == 0 {
        return sign_out as u64
    }
    var exp: i64 = f >> mant_bits
    var mantissa: i64 = (f & (((1 as i64) << mant_bits) - 1)) << mant_shift
    if exp == 0 && exp_bits < 8 {
        while (mantissa & 8388608) == 0 {
            mantissa = mantissa << 1
            exp = exp - 1
        }
        exp = exp + 1
        mantissa = mantissa & 8388607
    }
    exp = exp - (((1 as i64) << ((exp_bits as i64) - 1)) - 1) + 127
    return (sign_out | (exp << 23) | mantissa) as u64
}
