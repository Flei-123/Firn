import std.rt
import std.vec
import jxl.jxl_bits
import jxl.jxl_chan
import jxl.jxl_code
import jxl.jxl_container
import jxl.jxl_err
import jxl.jxl_frame
import jxl.jxl_header
import jxl.jxl_icc
import jxl.jxl_img
import jxl.jxl_group
import jxl.jxl_stream
import jxl.jxl_tree
import jxl.jxl_wp
import jxl.jxl_xform

export { modular_decode, decode_global }

fn decode_global(b: *mut jxl_bits.JxlBits, m: *mut jxl_header.JxlMeta, f: *mut jxl_frame.JxlFrame, img: *mut jxl_img.JxlImage, ms: *mut jxl_stream.JxlModState, wph: *mut jxl_wp.JxlWpHeader, xfs: *mut vec.Vec[jxl_xform.JxlXform]) -> i32 {
    let nchan: usize = jxl_header.jm_color_channels(m) as usize
    var nimg: usize = 0
    if (*f).encoding == jxl_frame.JF_MODULAR {
        nimg = nchan
    }
    let nextra: usize = vec.vec_len[jxl_header.JxlExtra](&(*m).extra)
    var c: usize = 0
    while c < nimg + nextra {
        jxl_img.img_add(img, (*f).width as usize, (*f).height as usize, 0, 0)
        c = c + 1
    }
    var r: i32 = jxl_err.JX_OK
    (*ms).has_tree = jxl_bits.jb_bit(b)
    if (*ms).has_tree {
        var limit: usize = 1024 + ((*f).width as usize) * ((*f).height as usize) * (nchan + nextra) / 16
        if limit > 4194304 {
            limit = 4194304
        }
        r = jxl_tree.tree_read(b, limit, &(*ms).tree)
        if r == jxl_err.JX_OK {
            r = jxl_code.code_read(b, (jxl_tree.tree_count(&(*ms).tree) + 1) / 2, false, &(*ms).code)
        }
    }
    if r == jxl_err.JX_OK {
        r = jxl_stream.stream_decode(b, img, ms, 0, (*f).group_dim as usize, wph, xfs)
    }
    return r
}

fn decode_groups(cs: *mut rt.Buf, f: *mut jxl_frame.JxlFrame, img: *mut jxl_img.JxlImage, ms: *mut jxl_stream.JxlModState, depth: i64) -> i32 {
    let gd: usize = (*f).group_dim as usize
    let nlf: usize = (*f).num_lf_groups as usize
    let ng: usize = (*f).num_groups as usize
    var r: i32 = jxl_err.JX_OK
    var g: usize = 0
    while r == jxl_err.JX_OK && g < nlf {
        let gx: usize = g % ((*f).lf_groups_x as usize)
        let gy: usize = g / ((*f).lf_groups_x as usize)
        var sb: jxl_bits.JxlBits = section(cs, f, 1 + g)
        r = jxl_group.group_decode(&sb, img, ms, depth, gd, gx * gd * 8, gy * gd * 8, gd * 8, gd * 8, 3, 1000, (1 + nlf + g) as u32)
        g = g + 1
    }
    var pass: u32 = 0
    while r == jxl_err.JX_OK && pass < (*f).num_passes {
        g = 0
        while r == jxl_err.JX_OK && g < ng {
            let gx: usize = g % ((*f).groups_x as usize)
            let gy: usize = g / ((*f).groups_x as usize)
            let sid: u32 = (1 + 3 * nlf + 17 + ng * (pass as usize) + g) as u32
            let mn: i32 = jxl_frame.jf_pass_min_shift(f, pass)
            let mx: i32 = jxl_frame.jf_pass_max_shift(f, pass)
            var sb: jxl_bits.JxlBits = section(cs, f, 2 + nlf + (pass as usize) * ng + g)
            r = jxl_group.group_decode(&sb, img, ms, depth, gd, gx * gd, gy * gd, gd, gd, mn, mx, sid)
            g = g + 1
        }
        pass = pass + 1
    }
    return r
}

fn section(cs: *mut rt.Buf, f: *mut jxl_frame.JxlFrame, i: usize) -> jxl_bits.JxlBits {
    let off: usize = jxl_frame.jf_section_offset(f, i)
    var len: usize = jxl_frame.jf_section_size(f, i)
    if off > rt.buf_len(cs) {
        len = 0
    } else if len > rt.buf_len(cs) - off {
        len = rt.buf_len(cs) - off
    }
    return jxl_bits.jb_new(rt.buf_ptr(cs) + (off as u64), len)
}

fn modular_decode(p: u64, n: usize, img: *mut jxl_img.JxlImage) -> i32 {
    var cs: rt.Buf = rt.buf_new()
    var r: i32 = jxl_container.jc_extract(p, n, &cs)
    if r != jxl_err.JX_OK {
        rt.buf_free(&cs)
        return r
    }
    var b: jxl_bits.JxlBits = jxl_bits.jb_new(rt.buf_ptr(&cs), rt.buf_len(&cs))
    jxl_bits.jb_skip_bits(&b, 16)
    var m: jxl_header.JxlMeta = jxl_header.jm_new()
    r = jxl_header.jm_read(&b, &m)
    if r == jxl_err.JX_OK {
        r = jxl_header.jm_read_custom_transform(&b, &m)
    }
    if r == jxl_err.JX_OK && m.color.want_icc {
        r = jxl_icc.icc_discard(&b)
    }
    if r == jxl_err.JX_OK && (m.have_preview || m.xyb_encoded || m.have_animation) {
        r = jxl_err.JX_UNSUPPORTED
    }
    if r == jxl_err.JX_OK && !jxl_bits.jb_zero_pad(&b) {
        r = jxl_err.JX_BAD
    }
    var f: jxl_frame.JxlFrame = jxl_frame.jf_new()
    if r == jxl_err.JX_OK {
        r = jxl_frame.jf_read(&b, &m, &f)
    }
    if r == jxl_err.JX_OK {
        r = jxl_frame.jf_read_toc(&b, &f)
    }
    if r == jxl_err.JX_OK && (f.encoding != jxl_frame.JF_MODULAR || f.do_ycbcr || f.upsampling != 1 || f.ec_upsampled || (f.flags & 19) != 0) {
        r = jxl_err.JX_UNSUPPORTED
    }
    if r == jxl_err.JX_OK && (f.width as u64) * (f.height as u64) > 67108864 {
        r = jxl_err.JX_TOO_LARGE
    }
    var ms: jxl_stream.JxlModState = jxl_stream.ms_new()
    var wph: jxl_wp.JxlWpHeader = jxl_wp.wp_header_default()
    var xfs: vec.Vec[jxl_xform.JxlXform] = vec.vec_new[jxl_xform.JxlXform]()
    if r == jxl_err.JX_OK {
        var sb: jxl_bits.JxlBits = section(&cs, &f, 0)
        if !jxl_bits.jb_bit(&sb) {
            var k: u32 = 0
            while k < 3 {
                jxl_bits.jb_f16(&sb)
                k = k + 1
            }
        }
        r = decode_global(&sb, &m, &f, img, &ms, &wph, &xfs)
    }
    if r == jxl_err.JX_OK && f.toc_count != 1 {
        r = decode_groups(&cs, &f, img, &ms, m.depth.bits as i64)
    }
    if r == jxl_err.JX_OK {
        r = jxl_stream.xfs_inverse(&xfs, img, &wph, m.depth.bits as i64)
    }
    jxl_stream.xfs_free(&xfs)
    jxl_stream.ms_free(&ms)
    jxl_frame.jf_free(&f)
    jxl_header.jm_free(&m)
    rt.buf_free(&cs)
    return r
}
