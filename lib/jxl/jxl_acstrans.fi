// SPDX-License-Identifier: MPL-2.0
// lib/jxl/jxl_acstrans.fi -- jxl_acstrans: JPEG XL inverse AC strategy transforms (DCT family, IDENTITY, DCT2X2, 4x4/4x8/8x4, AFV) and LLF from DC
import jxl.jxl_acs
import jxl.jxl_dct
import jxl.jxl_idct32
import jxl.jxl_lfdata
import jxl.jxl_qwdata
import std.rt

export { ats_scratch_bytes, ats_max_coefs, ats_pixels, ats_llf }

const CLASS_DCT: u8 = 0
const CLASS_IDENTITY: u8 = 1
const CLASS_DCT2: u8 = 2
const CLASS_DCT4: u8 = 3
const CLASS_DCT4X8: u8 = 4
const CLASS_DCT8X4: u8 = 5
const CLASS_AFV: u8 = 6

static CLASS_OF: [u8; 27] = [0, 1, 2, 3, 0, 0, 0, 0, 0, 0, 0, 0, 4, 5, 6, 6, 6, 6, 0, 0, 0, 0, 0, 0, 0, 0, 0]

fn fld(p: u64, i: usize) -> f64 {
    return *((p +% ((i * 8) as u64)) as *mut f64)
}

fn fst(p: u64, i: usize, v: f64) {
    *((p +% ((i * 8) as u64)) as *mut f64) = v
}

fn ats_max_coefs() -> usize {
    return 65536
}

fn ats_scratch_bytes() -> usize {
    return 2 * 65536 * 8
}

fn log2_of(n: usize) -> usize {
    var r: usize = 0
    var m: usize = n
    while m > 1 {
        m = m >> 1
        r = r + 1
    }
    return r
}

fn dct_pixels(t: u32, coef: u64, out: u64, scratch: u64) -> bool {
    let pr: usize = jxl_acs.acs_cover_y(t) * 8
    let pc: usize = jxl_acs.acs_cover_x(t) * 8
    if pr == pc {
        if !jxl_idct32.idct32_square(pr, coef, scratch) {
            return false
        }
        var y: usize = 0
        while y < pr {
            var x: usize = 0
            while x < pc {
                fst(out, y * pc + x, fld(scratch, x * pr + y))
                x = x + 1
            }
            y = y + 1
        }
        return true
    }
    return jxl_idct32.idct32_rect(pr, pc, coef, out)
}

fn tile_transposed(blk: u64, n: usize, out: u64, ostride: usize, ox: usize, oy: usize, scratch: u64) -> bool {
    if !jxl_dct.idct_2d(n, n, blk, scratch) {
        return false
    }
    var r: usize = 0
    while r < n {
        var c: usize = 0
        while c < n {
            fst(out, (oy + r) * ostride + ox + c, fld(scratch, c * n + r))
            c = c + 1
        }
        r = r + 1
    }
    return true
}

fn identity_pixels(coef: u64, out: u64) {
    let b00: f64 = fld(coef, 0)
    let b01: f64 = fld(coef, 1)
    let b10: f64 = fld(coef, 8)
    let b11: f64 = fld(coef, 9)
    var dcs: [f64; 4] = [b00 + b01 + b10 + b11, b00 + b01 - b10 - b11, b00 - b01 + b10 - b11, b00 - b01 - b10 + b11]
    var y: usize = 0
    while y < 2 {
        var x: usize = 0
        while x < 2 {
            var residual: f64 = 0.0
            var iy: usize = 0
            while iy < 4 {
                var ix: usize = 0
                while ix < 4 {
                    if ix != 0 || iy != 0 {
                        residual = residual + fld(coef, (y + iy * 2) * 8 + x + ix * 2)
                    }
                    ix = ix + 1
                }
                iy = iy + 1
            }
            let centre: f64 = dcs[y * 2 + x] - residual * (1.0 / 16.0)
            fst(out, (4 * y + 1) * 8 + 4 * x + 1, centre)
            iy = 0
            while iy < 4 {
                var ix2: usize = 0
                while ix2 < 4 {
                    if ix2 != 1 || iy != 1 {
                        fst(out, (y * 4 + iy) * 8 + x * 4 + ix2, fld(coef, (y + iy * 2) * 8 + x + ix2 * 2) + centre)
                    }
                    ix2 = ix2 + 1
                }
                iy = iy + 1
            }
            fst(out, y * 4 * 8 + x * 4, fld(coef, (y + 2) * 8 + x + 2) + centre)
            x = x + 1
        }
        y = y + 1
    }
}

fn dct2_top(buf: u64, tmp: u64, s: usize) {
    let h: usize = s / 2
    var y: usize = 0
    while y < h {
        var x: usize = 0
        while x < h {
            let c00: f64 = fld(buf, y * 8 + x)
            let c01: f64 = fld(buf, y * 8 + h + x)
            let c10: f64 = fld(buf, (y + h) * 8 + x)
            let c11: f64 = fld(buf, (y + h) * 8 + h + x)
            fst(tmp, y * 2 * 8 + x * 2, c00 + c01 + c10 + c11)
            fst(tmp, y * 2 * 8 + x * 2 + 1, c00 + c01 - c10 - c11)
            fst(tmp, (y * 2 + 1) * 8 + x * 2, c00 - c01 + c10 - c11)
            fst(tmp, (y * 2 + 1) * 8 + x * 2 + 1, c00 - c01 - c10 + c11)
            x = x + 1
        }
        y = y + 1
    }
    y = 0
    while y < s {
        var x2: usize = 0
        while x2 < s {
            fst(buf, y * 8 + x2, fld(tmp, y * 8 + x2))
            x2 = x2 + 1
        }
        y = y + 1
    }
}

fn dct2_pixels(coef: u64, out: u64, scratch: u64) {
    let tmp: u64 = scratch +% (64 * 8)
    var i: usize = 0
    while i < 64 {
        fst(out, i, fld(coef, i))
        i = i + 1
    }
    dct2_top(out, tmp, 2)
    dct2_top(out, tmp, 4)
    dct2_top(out, tmp, 8)
}

fn dct4_pixels(coef: u64, out: u64, scratch: u64) -> bool {
    let b00: f64 = fld(coef, 0)
    let b01: f64 = fld(coef, 1)
    let b10: f64 = fld(coef, 8)
    let b11: f64 = fld(coef, 9)
    var dcs: [f64; 4] = [b00 + b01 + b10 + b11, b00 + b01 - b10 - b11, b00 - b01 + b10 - b11, b00 - b01 - b10 + b11]
    let blk: u64 = scratch
    let work: u64 = scratch +% (64 * 8)
    var y: usize = 0
    while y < 2 {
        var x: usize = 0
        while x < 2 {
            fst(blk, 0, dcs[y * 2 + x])
            var iy: usize = 0
            while iy < 4 {
                var ix: usize = 0
                while ix < 4 {
                    if ix != 0 || iy != 0 {
                        fst(blk, iy * 4 + ix, fld(coef, (y + iy * 2) * 8 + x + ix * 2))
                    }
                    ix = ix + 1
                }
                iy = iy + 1
            }
            if !tile_transposed(blk, 4, out, 8, x * 4, y * 4, work) {
                return false
            }
            x = x + 1
        }
        y = y + 1
    }
    return true
}

fn dct4x8_pixels(coef: u64, out: u64, scratch: u64) -> bool {
    let blk: u64 = scratch
    let work: u64 = scratch +% (64 * 8)
    let dc0: f64 = fld(coef, 0) + fld(coef, 8)
    let dc1: f64 = fld(coef, 0) - fld(coef, 8)
    var y: usize = 0
    while y < 2 {
        fst(blk, 0, dc0)
        if y == 1 {
            fst(blk, 0, dc1)
        }
        var iy: usize = 0
        while iy < 4 {
            var ix: usize = 0
            while ix < 8 {
                if ix != 0 || iy != 0 {
                    fst(blk, iy * 8 + ix, fld(coef, (y + iy * 2) * 8 + ix))
                }
                ix = ix + 1
            }
            iy = iy + 1
        }
        if !jxl_dct.idct_2d(4, 8, blk, work) {
            return false
        }
        var i: usize = 0
        while i < 32 {
            fst(out, y * 32 + i, fld(work, i))
            i = i + 1
        }
        y = y + 1
    }
    return true
}

fn dct8x4_pixels(coef: u64, out: u64, scratch: u64) -> bool {
    let blk: u64 = scratch
    let work: u64 = scratch +% (64 * 8)
    let dc0: f64 = fld(coef, 0) + fld(coef, 8)
    let dc1: f64 = fld(coef, 0) - fld(coef, 8)
    var x: usize = 0
    while x < 2 {
        fst(blk, 0, dc0)
        if x == 1 {
            fst(blk, 0, dc1)
        }
        var iy: usize = 0
        while iy < 4 {
            var ix: usize = 0
            while ix < 8 {
                if ix != 0 || iy != 0 {
                    fst(blk, iy * 8 + ix, fld(coef, (x + iy * 2) * 8 + ix))
                }
                ix = ix + 1
            }
            iy = iy + 1
        }
        if !jxl_dct.idct_2d(4, 8, blk, work) {
            return false
        }
        var r: usize = 0
        while r < 8 {
            var c: usize = 0
            while c < 4 {
                fst(out, r * 8 + x * 4 + c, fld(work, c * 8 + r))
                c = c + 1
            }
            r = r + 1
        }
        x = x + 1
    }
    return true
}

fn afv_pixels(t: u32, coef: u64, out: u64, scratch: u64) -> bool {
    let kind: u32 = t - 14
    let afv_x: usize = (kind & 1) as usize
    let afv_y: usize = (kind / 2) as usize
    let b00: f64 = fld(coef, 0)
    let b01: f64 = fld(coef, 1)
    let b10: f64 = fld(coef, 8)
    let dc0: f64 = (b00 + b10 + b01) * 4.0
    let dc1: f64 = b00 + b10 - b01
    let dc2: f64 = b00 - b10
    let blk: u64 = scratch
    let work: u64 = scratch +% (64 * 8)
    let cf: u64 = scratch +% (128 * 8)
    let bl4: u64 = scratch +% (160 * 8)
    fst(cf, 0, dc0)
    var iy: usize = 0
    while iy < 4 {
        var ix: usize = 0
        while ix < 4 {
            if ix != 0 || iy != 0 {
                fst(cf, iy * 4 + ix, fld(coef, iy * 2 * 8 + ix * 2))
            }
            ix = ix + 1
        }
        iy = iy + 1
    }
    var i: usize = 0
    while i < 16 {
        var s: f64 = 0.0
        var j: usize = 0
        while j < 16 {
            s = s + fld(cf, j) * jxl_qwdata.qwd_afv_basis(j, i)
            j = j + 1
        }
        fst(bl4, i, s)
        i = i + 1
    }
    iy = 0
    while iy < 4 {
        var ix2: usize = 0
        while ix2 < 4 {
            var sy: usize = iy
            if afv_y == 1 {
                sy = 3 - iy
            }
            var sx: usize = ix2
            if afv_x == 1 {
                sx = 3 - ix2
            }
            fst(out, (iy + afv_y * 4) * 8 + afv_x * 4 + ix2, fld(bl4, sy * 4 + sx))
            ix2 = ix2 + 1
        }
        iy = iy + 1
    }
    fst(blk, 0, dc1)
    iy = 0
    while iy < 4 {
        var ix3: usize = 0
        while ix3 < 4 {
            if ix3 != 0 || iy != 0 {
                fst(blk, iy * 4 + ix3, fld(coef, iy * 2 * 8 + ix3 * 2 + 1))
            }
            ix3 = ix3 + 1
        }
        iy = iy + 1
    }
    var ox: usize = 4
    if afv_x == 1 {
        ox = 0
    }
    if !tile_transposed(blk, 4, out, 8, ox, afv_y * 4, work) {
        return false
    }
    fst(blk, 0, dc2)
    iy = 0
    while iy < 4 {
        var ix4: usize = 0
        while ix4 < 8 {
            if ix4 != 0 || iy != 0 {
                fst(blk, iy * 8 + ix4, fld(coef, (1 + iy * 2) * 8 + ix4))
            }
            ix4 = ix4 + 1
        }
        iy = iy + 1
    }
    if !jxl_dct.idct_2d(4, 8, blk, work) {
        return false
    }
    var oy: usize = 4
    if afv_y == 1 {
        oy = 0
    }
    var r: usize = 0
    while r < 4 {
        var c: usize = 0
        while c < 8 {
            fst(out, (oy + r) * 8 + c, fld(work, r * 8 + c))
            c = c + 1
        }
        r = r + 1
    }
    return true
}

fn ats_pixels(t: u32, coef: u64, out: u64, scratch: u64) -> bool {
    let cls: u8 = CLASS_OF[t as usize]
    if cls == CLASS_DCT {
        return dct_pixels(t, coef, out, scratch)
    }
    if cls == CLASS_IDENTITY {
        identity_pixels(coef, out)
        return true
    }
    if cls == CLASS_DCT2 {
        dct2_pixels(coef, out, scratch)
        return true
    }
    if cls == CLASS_DCT4 {
        return dct4_pixels(coef, out, scratch)
    }
    if cls == CLASS_DCT4X8 {
        return dct4x8_pixels(coef, out, scratch)
    }
    if cls == CLASS_DCT8X4 {
        return dct8x4_pixels(coef, out, scratch)
    }
    return afv_pixels(t, coef, out, scratch)
}

fn ats_llf(t: u32, d: *mut jxl_lfdata.JxlLfData, c: usize, bx: usize, by: usize, coef: u64, scratch: u64) -> bool {
    let cy: usize = jxl_acs.acs_cover_y(t)
    let cx: usize = jxl_acs.acs_cover_x(t)
    if cy == 1 && cx == 1 {
        fst(coef, 0, jxl_lfdata.lfd_dc_get(d, c, bx, by))
        return true
    }
    let src: u64 = scratch
    let dst: u64 = scratch +% ((cy * cx * 8) as u64)
    var y: usize = 0
    while y < cy {
        var x: usize = 0
        while x < cx {
            fst(src, y * cx + x, jxl_lfdata.lfd_dc_get(d, c, bx + x, by + y))
            x = x + 1
        }
        y = y + 1
    }
    jxl_dct.dct_2d_slow(cy, cx, src, dst)
    let ly: usize = log2_of(cy)
    let lx: usize = log2_of(cx)
    let stride: usize = cy * 8
    var fy: usize = 0
    while fy < cy {
        var fx: usize = 0
        while fx < cx {
            let v: f64 = fld(dst, fy * cx + fx) * jxl_qwdata.qwd_up_scale(ly, fy) * jxl_qwdata.qwd_up_scale(lx, fx)
            if cy >= cx {
                fst(coef, fx * stride + fy, v)
            } else {
                fst(coef, fy * (cx * 8) + fx, v)
            }
            fx = fx + 1
        }
        fy = fy + 1
    }
    return true
}
