import std.rt
import jxl.jxl_bits
import jxl.jxl_code
import jxl.jxl_err

export { perm_read }

const PERM_CONTEXTS: usize = 8

fn lowest_bit(v: u32) -> u32 {
    return v & (0 -% v)
}

fn context_of(val: u32) -> u32 {
    var token: u32 = 0
    var x: u32 = val
    while x > 0 {
        token = token + 1
        x = x >> 1
    }
    if token > 7 {
        token = 7
    }
    return token
}

fn lehmer_decode(code: u64, n: usize, out: u64) -> bool {
    var padded: usize = 1
    var log2n: u32 = 0
    while padded < n {
        padded = padded * 2
        log2n = log2n + 1
    }
    let temp: u64 = rt.heap_alloc(padded * 4)
    if temp == 0 {
        return false
    }
    var i: usize = 0
    while i < padded {
        rt.st32(temp, i, lowest_bit((i + 1) as u32))
        i = i + 1
    }
    i = 0
    while i < n {
        var rank: u32 = rt.ld32(code, i) + 1
        var bit: usize = padded
        var next: usize = 0
        var k: u32 = 0
        while k <= log2n {
            let cand: usize = next + bit
            bit = bit >> 1
            if cand >= 1 && cand <= padded && rt.ld32(temp, cand - 1) < rank {
                next = cand
                rank = rank - rt.ld32(temp, cand - 1)
            }
            k = k + 1
        }
        rt.st32(out, i, next as u32)
        next = next + 1
        while next <= padded {
            rt.st32(temp, next - 1, rt.ld32(temp, next - 1) - 1)
            next = next + (lowest_bit(next as u32) as usize)
        }
        i = i + 1
    }
    rt.heap_free(temp, padded * 4)
    return true
}

fn perm_read(b: *mut jxl_bits.JxlBits, n: usize, out: u64) -> i32 {
    var code: jxl_code.JxlCode = jxl_code.code_new()
    var r: i32 = jxl_code.code_read(b, PERM_CONTEXTS, false, &code)
    if r != jxl_err.JX_OK {
        jxl_code.code_free(&code)
        return r
    }
    var rd: jxl_code.JxlReader = jxl_code.reader_new()
    r = jxl_code.reader_init(&rd, &code, b, 0)
    let lehmer: u64 = rt.heap_alloc(n * 4)
    if lehmer == 0 {
        jxl_code.reader_free(&rd)
        jxl_code.code_free(&code)
        return jxl_err.JX_MEMORY
    }
    rt.mem_set(lehmer, 0 as u8, n * 4)
    if r == jxl_err.JX_OK {
        let end: usize = jxl_code.reader_read(&rd, b, context_of(n as u32)) as usize
        if end > n {
            r = jxl_err.JX_BAD
        }
        var last: u32 = 0
        var i: usize = 0
        while r == jxl_err.JX_OK && i < end {
            let v: u32 = jxl_code.reader_read(&rd, b, context_of(last))
            last = v
            if (v as usize) + i >= n {
                r = jxl_err.JX_BAD
            } else {
                rt.st32(lehmer, i, v)
            }
            i = i + 1
        }
    }
    if r == jxl_err.JX_OK && jxl_bits.jb_over(b) {
        r = jxl_err.JX_TRUNCATED
    }
    if r == jxl_err.JX_OK && !jxl_code.reader_final_ok(&rd) {
        r = jxl_err.JX_BAD
    }
    if r == jxl_err.JX_OK && !lehmer_decode(lehmer, n, out) {
        r = jxl_err.JX_MEMORY
    }
    rt.heap_free(lehmer, n * 4)
    jxl_code.reader_free(&rd)
    jxl_code.code_free(&code)
    return r
}
