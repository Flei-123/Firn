import std.rt
import jxl.jxl_bits
import jxl.jxl_container
import jxl.jxl_err
import jxl.jxl_frame
import jxl.jxl_header
import jxl.jxl_icc

export { JxlDoc, doc_new, doc_open, doc_section, doc_free }

struct JxlDoc {
    cs: rt.Buf,
    meta: jxl_header.JxlMeta,
    frame: jxl_frame.JxlFrame,
}

fn doc_new() -> JxlDoc {
    return JxlDoc { cs: rt.buf_new(), meta: jxl_header.jm_new(), frame: jxl_frame.jf_new() }
}

fn doc_open(p: u64, n: usize, d: *mut JxlDoc) -> i32 {
    var r: i32 = jxl_container.jc_extract(p, n, &(*d).cs)
    if r != jxl_err.JX_OK {
        return r
    }
    var b: jxl_bits.JxlBits = jxl_bits.jb_new(rt.buf_ptr(&(*d).cs), rt.buf_len(&(*d).cs))
    jxl_bits.jb_skip_bits(&b, 16)
    r = jxl_header.jm_read(&b, &(*d).meta)
    if r == jxl_err.JX_OK {
        r = jxl_header.jm_read_custom_transform(&b, &(*d).meta)
    }
    if r == jxl_err.JX_OK && (*d).meta.color.want_icc {
        r = jxl_icc.icc_discard(&b)
    }
    if r == jxl_err.JX_OK && (*d).meta.have_preview {
        r = jxl_err.JX_UNSUPPORTED
    }
    if r == jxl_err.JX_OK && !jxl_bits.jb_zero_pad(&b) {
        r = jxl_err.JX_BAD
    }
    if r == jxl_err.JX_OK {
        r = jxl_frame.jf_read(&b, &(*d).meta, &(*d).frame)
    }
    if r == jxl_err.JX_OK {
        r = jxl_frame.jf_read_toc(&b, &(*d).frame)
    }
    return r
}

fn doc_section(d: *mut JxlDoc, i: usize) -> jxl_bits.JxlBits {
    let off: usize = jxl_frame.jf_section_offset(&(*d).frame, i)
    var len: usize = jxl_frame.jf_section_size(&(*d).frame, i)
    let total: usize = rt.buf_len(&(*d).cs)
    if off > total {
        len = 0
    } else if len > total - off {
        len = total - off
    }
    return jxl_bits.jb_new(rt.buf_ptr(&(*d).cs) + (off as u64), len)
}

fn doc_free(d: *mut JxlDoc) {
    jxl_frame.jf_free(&(*d).frame)
    jxl_header.jm_free(&(*d).meta)
    rt.buf_free(&(*d).cs)
}
