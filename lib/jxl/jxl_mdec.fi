// SPDX-License-Identifier: MPL-2.0
// lib/jxl/jxl_mdec.fi -- jxl_mdec: Modular-encoded XYB frame body decode into float XYB planes
import std.rt
import jxl.jxl_bits
import jxl.jxl_epf
import jxl.jxl_err
import jxl.jxl_frame
import jxl.jxl_gaborish
import jxl.jxl_img
import jxl.jxl_lfglobal
import jxl.jxl_mem
import jxl.jxl_modular
import jxl.jxl_open
import jxl.jxl_quant
import jxl.jxl_stream

export { mdec_read, mdec_planes, mdec_check, MDEC_MAX_PIXELS }

const MDEC_MAX_PIXELS: u64 = 67108864

fn fst(p: u64, i: usize, v: f64) {
    *((p +% ((i * 8) as u64)) as *mut f64) = v
}

fn mdec_check(d: *mut jxl_open.JxlDoc) -> i32 {
    let f: *mut jxl_frame.JxlFrame = &(*d).frame
    if (*f).encoding != jxl_frame.JF_MODULAR || !(*d).meta.xyb_encoded || (*f).do_ycbcr || ((*f).flags & jxl_frame.JF_FLAG_USE_LF) != 0 {
        return jxl_err.JX_UNSUPPORTED
    }
    if (*f).width == 0 || (*f).height == 0 || ((*f).width as u64) * ((*f).height as u64) > MDEC_MAX_PIXELS {
        return jxl_err.JX_TOO_LARGE
    }
    return jxl_err.JX_OK
}

fn mdec_read(d: *mut jxl_open.JxlDoc, g: *mut jxl_lfglobal.JxlLfGlobal) -> i32 {
    let f: *mut jxl_frame.JxlFrame = &(*d).frame
    var sb: jxl_bits.JxlBits = jxl_open.doc_section(d, 0)
    var r: i32 = jxl_lfglobal.lfg_read_features(&sb, &(*d).meta, f, g)
    if r == jxl_err.JX_OK {
        r = jxl_quant.lf_dequant_read(&sb, &(*g).quant)
    }
    if r == jxl_err.JX_OK {
        r = jxl_modular.decode_global(&sb, &(*d).meta, f, &(*g).img, &(*g).ms, &(*g).wph, &(*g).xfs)
    }
    if r == jxl_err.JX_OK && (*f).toc_count != 1 {
        r = jxl_modular.decode_groups(&(*d).cs, f, &(*g).img, &(*g).ms, (*d).meta.depth.bits as i64)
    }
    if r == jxl_err.JX_OK {
        r = jxl_stream.xfs_inverse(&(*g).xfs, &(*g).img, &(*g).wph, (*d).meta.depth.bits as i64)
    }
    if r == jxl_err.JX_OK {
        let w: usize = (*f).width as usize
        let h: usize = (*f).height as usize
        var c: usize = 0
        if jxl_img.img_count(&(*g).img) < 3 {
            r = jxl_err.JX_BAD
        }
        while r == jxl_err.JX_OK && c < 3 {
            if jxl_img.img_w(&(*g).img, c) != w || jxl_img.img_h(&(*g).img, c) != h || jxl_img.img_data(&(*g).img, c) == 0 {
                r = jxl_err.JX_BAD
            }
            c = c + 1
        }
    }
    return r
}

fn mdec_planes(d: *mut jxl_open.JxlDoc, g: *mut jxl_lfglobal.JxlLfGlobal) -> u64 {
    let f: *mut jxl_frame.JxlFrame = &(*d).frame
    let w: usize = (*f).width as usize
    let h: usize = (*f).height as usize
    let n: usize = w * h
    let planes: u64 = rt.heap_alloc(n * 3 * 8)
    if planes == 0 {
        return 0
    }
    let y: u64 = jxl_img.img_data(&(*g).img, 0)
    let x: u64 = jxl_img.img_data(&(*g).img, 1)
    let b: u64 = jxl_img.img_data(&(*g).img, 2)
    let qx: f64 = (*g).quant.dc_quant_x
    let qy: f64 = (*g).quant.dc_quant_y
    let qb: f64 = (*g).quant.dc_quant_b
    var i: usize = 0
    while i < n {
        let yv: i32 = jxl_mem.ldi(y, i)
        fst(planes, i, (jxl_mem.ldi(x, i) as f64) * qx)
        fst(planes, n + i, (yv as f64) * qy)
        fst(planes, 2 * n + i, ((jxl_mem.ldi(b, i) as f64) + (yv as f64)) * qb)
        i = i + 1
    }
    if (*f).lf.gab {
        if !jxl_gaborish.gab_apply(planes, w, h, w, n, &(*f).lf) {
            rt.heap_free(planes, n * 3 * 8)
            return 0
        }
    }
    if (*f).lf.epf_iters > 0 {
        if !jxl_epf.epf_apply_uniform(planes, w, h, w, n, &(*f).lf) {
            rt.heap_free(planes, n * 3 * 8)
            return 0
        }
    }
    return planes
}
