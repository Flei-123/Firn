// SPDX-License-Identifier: MPL-2.0
import jxl.jxl_bits
import jxl.jxl_err

export { JxlLoopFilter, loopf_default, loopf_read, loopf_skip_extensions }

struct JxlLoopFilter {
    gab: bool,
    gab_weights: [f64; 6],
    epf_iters: u32,
    epf_sharp: [f64; 8],
    epf_channel_scale: [f64; 3],
    epf_pass1_zeroflush: f64,
    epf_pass2_zeroflush: f64,
    epf_quant_mul: f64,
    epf_pass0_sigma_scale: f64,
    epf_pass2_sigma_scale: f64,
    epf_border_sad_mul: f64,
    epf_sigma_for_modular: f64,
}

fn loopf_default() -> JxlLoopFilter {
    var lf: JxlLoopFilter = JxlLoopFilter { gab: true, gab_weights: [0.0; 6], epf_iters: 2, epf_sharp: [0.0; 8],
        epf_channel_scale: [40.0, 5.0, 3.5], epf_pass1_zeroflush: 0.45, epf_pass2_zeroflush: 0.6, epf_quant_mul: 0.46,
        epf_pass0_sigma_scale: 0.9, epf_pass2_sigma_scale: 6.5, epf_border_sad_mul: 0.6666666666666666, epf_sigma_for_modular: 1.0 }
    var i: usize = 0
    while i < 3 {
        lf.gab_weights[i * 2] = 1.1 * 0.104699568
        lf.gab_weights[i * 2 + 1] = 1.1 * 0.055680538
        i = i + 1
    }
    i = 0
    while i < 8 {
        lf.epf_sharp[i] = (i as f64) / 7.0
        i = i + 1
    }
    return lf
}

fn loopf_skip_extensions(b: *mut jxl_bits.JxlBits) {
    let mask: u64 = jxl_bits.jb_u64(b)
    var sizes: [u64; 64] = [0; 64]
    var i: u64 = 0
    while i < 64 {
        if ((mask >> i) & 1) != 0 {
            sizes[i as usize] = jxl_bits.jb_u64(b)
        }
        i = i + 1
    }
    i = 0
    while i < 64 {
        if sizes[i as usize] != 0 {
            jxl_bits.jb_skip_bits(b, sizes[i as usize])
        }
        i = i + 1
    }
}

fn loopf_read(b: *mut jxl_bits.JxlBits, modular: bool, lf: *mut JxlLoopFilter) -> i32 {
    *lf = loopf_default()
    if jxl_bits.jb_bit(b) {
        return jxl_err.JX_OK
    }
    (*lf).gab = jxl_bits.jb_bit(b)
    if (*lf).gab {
        if jxl_bits.jb_bit(b) {
            var i: usize = 0
            while i < 6 {
                (*lf).gab_weights[i] = jxl_bits.jb_f16(b)
                i = i + 1
            }
            i = 0
            while i < 3 {
                let d: f64 = 1.0 + ((*lf).gab_weights[i * 2] + (*lf).gab_weights[i * 2 + 1]) * 4.0
                if d < 0.00000001 && d > -0.00000001 {
                    return jxl_err.JX_BAD
                }
                i = i + 1
            }
        }
    }
    (*lf).epf_iters = jxl_bits.jb_read(b, 2)
    if (*lf).epf_iters > 0 {
        if !modular {
            if jxl_bits.jb_bit(b) {
                var i: usize = 0
                while i < 8 {
                    (*lf).epf_sharp[i] = jxl_bits.jb_f16(b)
                    i = i + 1
                }
            }
        }
        if jxl_bits.jb_bit(b) {
            var i: usize = 0
            while i < 3 {
                (*lf).epf_channel_scale[i] = jxl_bits.jb_f16(b)
                i = i + 1
            }
            (*lf).epf_pass1_zeroflush = jxl_bits.jb_f16(b)
            (*lf).epf_pass2_zeroflush = jxl_bits.jb_f16(b)
        }
        if jxl_bits.jb_bit(b) {
            if !modular {
                (*lf).epf_quant_mul = jxl_bits.jb_f16(b)
            }
            (*lf).epf_pass0_sigma_scale = jxl_bits.jb_f16(b)
            (*lf).epf_pass2_sigma_scale = jxl_bits.jb_f16(b)
            (*lf).epf_border_sad_mul = jxl_bits.jb_f16(b)
        }
        if modular {
            (*lf).epf_sigma_for_modular = jxl_bits.jb_f16(b)
            if (*lf).epf_sigma_for_modular < 0.00000001 {
                return jxl_err.JX_BAD
            }
        }
    }
    loopf_skip_extensions(b)
    if jxl_bits.jb_over(b) {
        return jxl_err.JX_TRUNCATED
    }
    return jxl_err.JX_OK
}
