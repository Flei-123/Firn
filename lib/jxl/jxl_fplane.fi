// lib/jxl/jxl_fplane.fi -- jxl_fplane: raw f64 plane element access
export { fp_ld, fp_st }

fn fp_ld(p: u64, i: usize) -> f64 {
    return *((p +% ((i * 8) as u64)) as *mut f64)
}

fn fp_st(p: u64, i: usize, v: f64) {
    *((p +% ((i * 8) as u64)) as *mut f64) = v
}
