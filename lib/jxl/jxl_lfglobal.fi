import std.vec
import jxl.jxl_bctx
import jxl.jxl_bits
import jxl.jxl_cmap
import jxl.jxl_err
import jxl.jxl_frame
import jxl.jxl_header
import jxl.jxl_img
import jxl.jxl_modular
import jxl.jxl_patches
import jxl.jxl_quant
import jxl.jxl_splines
import jxl.jxl_stream
import jxl.jxl_wp
import jxl.jxl_xform

export { JxlLfGlobal, lfg_new, lfg_read, lfg_read_features, lfg_free }

struct JxlLfGlobal {
    quant: jxl_quant.JxlQuant,
    bctx: jxl_bctx.JxlBlockCtx,
    cmap: jxl_cmap.JxlCmap,
    noise: [f64; 8],
    has_noise: bool,
    patches: jxl_patches.JxlPatches,
    splines: jxl_splines.JxlSplines,
    img: jxl_img.JxlImage,
    ms: jxl_stream.JxlModState,
    wph: jxl_wp.JxlWpHeader,
    xfs: vec.Vec[jxl_xform.JxlXform],
}

fn lfg_new() -> JxlLfGlobal {
    var g: JxlLfGlobal = JxlLfGlobal { quant: jxl_quant.quant_default(), bctx: jxl_bctx.JxlBlockCtx { dc_counts: [0; 3],
        dc_thresholds: [0; 48], qf_count: 0, qf_thresholds: [0; 16], num_ctxs: 15, num_dc_ctxs: 1, map: [0 as u8; 2496] },
        cmap: jxl_cmap.cmap_default(), noise: [0.0; 8], has_noise: false, patches: jxl_patches.patches_new(), splines: jxl_splines.splines_new(), img: jxl_img.img_new(), ms: jxl_stream.ms_new(),
        wph: jxl_wp.wp_header_default(), xfs: vec.vec_new[jxl_xform.JxlXform]() }
    jxl_bctx.bctx_default(&g.bctx)
    return g
}

fn lfg_free(g: *mut JxlLfGlobal) {
    jxl_patches.patches_free(&(*g).patches)
    jxl_splines.splines_free(&(*g).splines)
    jxl_stream.xfs_free(&(*g).xfs)
    jxl_stream.ms_free(&(*g).ms)
    jxl_img.img_free(&(*g).img)
}

fn lfg_read_features(b: *mut jxl_bits.JxlBits, m: *mut jxl_header.JxlMeta, f: *mut jxl_frame.JxlFrame, g: *mut JxlLfGlobal) -> i32 {
    if ((*f).flags & jxl_frame.JF_FLAG_PATCHES) != 0 {
        let pr: i32 = jxl_patches.patches_read(b, (*f).width as usize, (*f).height as usize, vec.vec_len[jxl_header.JxlExtra](&(*m).extra), &(*g).patches)
        if pr != jxl_err.JX_OK {
            return pr
        }
    }
    if ((*f).flags & jxl_frame.JF_FLAG_SPLINES) != 0 {
        let sr: i32 = jxl_splines.splines_read(b, ((*f).width as usize) * ((*f).height as usize), &(*g).splines)
        if sr != jxl_err.JX_OK {
            return sr
        }
    }
    if ((*f).flags & jxl_frame.JF_FLAG_NOISE) != 0 {
        var i: usize = 0
        while i < 8 {
            (*g).noise[i] = (jxl_bits.jb_read(b, 10) as f64) / 1024.0
            i = i + 1
        }
        (*g).has_noise = true
    }
    return jxl_err.JX_OK
}

fn lfg_read(b: *mut jxl_bits.JxlBits, m: *mut jxl_header.JxlMeta, f: *mut jxl_frame.JxlFrame, g: *mut JxlLfGlobal) -> i32 {
    var r: i32 = lfg_read_features(b, m, f, g)
    if r == jxl_err.JX_OK {
        r = jxl_quant.lf_dequant_read(b, &(*g).quant)
    }
    if r == jxl_err.JX_OK {
        r = jxl_quant.quant_read(b, &(*g).quant)
    }
    if r == jxl_err.JX_OK {
        r = jxl_bctx.bctx_read(b, &(*g).bctx)
    }
    if r == jxl_err.JX_OK {
        r = jxl_cmap.cmap_read(b, &(*g).cmap)
    }
    if r == jxl_err.JX_OK {
        r = jxl_modular.decode_global(b, m, f, &(*g).img, &(*g).ms, &(*g).wph, &(*g).xfs)
    }
    if r == jxl_err.JX_OK && jxl_bits.jb_over(b) {
        r = jxl_err.JX_TRUNCATED
    }
    return r
}
