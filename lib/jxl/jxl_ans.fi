// SPDX-License-Identifier: MPL-2.0
// lib/jxl/jxl_ans.fi -- jxl_ans: JPEG XL ANS histograms (simple, flat, logcount coded) and the alias table
import std.rt
import jxl.jxl_bits
import jxl.jxl_huff

export {
    ans_read_histogram, ans_build_alias, ALIAS_WORDS, ANS_LOG_TAB, ANS_TAB, ANS_MAX_ALPHA,
}

const ANS_LOG_TAB: u32 = 12
const ANS_TAB: u32 = 4096
const ANS_MAX_ALPHA: usize = 272
const ALIAS_WORDS: usize = 5

static LC_BITS: [u8; 128] = [
    3, 7, 3, 4, 3, 3, 3, 4, 3, 4, 3, 4, 3, 3, 3, 4, 3, 5, 3, 4, 3, 3, 3, 4, 3, 4, 3, 4, 3, 3, 3, 4,
    3, 6, 3, 4, 3, 3, 3, 4, 3, 4, 3, 4, 3, 3, 3, 4, 3, 5, 3, 4, 3, 3, 3, 4, 3, 4, 3, 4, 3, 3, 3, 4,
    3, 7, 3, 4, 3, 3, 3, 4, 3, 4, 3, 4, 3, 3, 3, 4, 3, 5, 3, 4, 3, 3, 3, 4, 3, 4, 3, 4, 3, 3, 3, 4,
    3, 6, 3, 4, 3, 3, 3, 4, 3, 4, 3, 4, 3, 3, 3, 4, 3, 5, 3, 4, 3, 3, 3, 4, 3, 4, 3, 4, 3, 3, 3, 4]
static LC_SYM: [u8; 128] = [
    10, 12, 7, 3, 6, 8, 9, 5, 10, 4, 7, 1, 6, 8, 9, 2, 10, 0, 7, 3, 6, 8, 9, 5, 10, 4, 7, 1, 6, 8, 9, 2,
    10, 11, 7, 3, 6, 8, 9, 5, 10, 4, 7, 1, 6, 8, 9, 2, 10, 0, 7, 3, 6, 8, 9, 5, 10, 4, 7, 1, 6, 8, 9, 2,
    10, 13, 7, 3, 6, 8, 9, 5, 10, 4, 7, 1, 6, 8, 9, 2, 10, 0, 7, 3, 6, 8, 9, 5, 10, 4, 7, 1, 6, 8, 9, 2,
    10, 11, 7, 3, 6, 8, 9, 5, 10, 4, 7, 1, 6, 8, 9, 2, 10, 0, 7, 3, 6, 8, 9, 5, 10, 4, 7, 1, 6, 8, 9, 2]

fn population_precision(logcount: u32, shift: u32) -> u32 {
    let r: i32 = (shift as i32) - (((ANS_LOG_TAB - logcount) >> 1) as i32)
    var m: i32 = logcount as i32
    if r < m {
        m = r
    }
    if m < 0 {
        return 0
    }
    return m as u32
}

fn ans_read_histogram(b: *mut jxl_bits.JxlBits, counts: u64, n: *mut usize) -> bool {
    var i: usize = 0
    while i < ANS_MAX_ALPHA {
        rt.st32(counts, i, 0 as u32)
        i = i + 1
    }
    if jxl_bits.jb_bit(b) {
        let two: bool = jxl_bits.jb_bit(b)
        var s0: u32 = jxl_huff.huff_var_len_u8(b)
        var s1: u32 = 0
        var num: u32 = 1
        if two {
            s1 = jxl_huff.huff_var_len_u8(b)
            num = 2
        }
        var mx: u32 = s0
        if s1 > mx {
            mx = s1
        }
        if mx as usize >= ANS_MAX_ALPHA {
            return false
        }
        *n = (mx + 1) as usize
        if num == 1 {
            rt.st32(counts, s0 as usize, ANS_TAB)
        } else {
            if s0 == s1 {
                return false
            }
            let c0: u32 = jxl_bits.jb_read(b, ANS_LOG_TAB)
            rt.st32(counts, s0 as usize, c0)
            rt.st32(counts, s1 as usize, ANS_TAB - c0)
        }
        return true
    }
    if jxl_bits.jb_bit(b) {
        let alpha: u32 = jxl_huff.huff_var_len_u8(b) + 1
        *n = alpha as usize
        var k: u32 = 0
        let base: u32 = ANS_TAB / alpha
        let rem: u32 = ANS_TAB % alpha
        while k < alpha {
            var c: u32 = base
            if k < rem {
                c = c + 1
            }
            rt.st32(counts, k as usize, c)
            k = k + 1
        }
        return true
    }
    var log: u32 = 0
    while log < 3 {
        if !jxl_bits.jb_bit(b) {
            break
        }
        log = log + 1
    }
    let shift: u32 = (jxl_bits.jb_read(b, log) | ((1 as u32) << log)) - 1
    if shift > ANS_LOG_TAB + 1 {
        return false
    }
    let length: usize = (jxl_huff.huff_var_len_u8(b) + 3) as usize
    if length > ANS_MAX_ALPHA {
        return false
    }
    *n = length
    var logc: [u32; 272] = [0; 272]
    var same: [u32; 272] = [0; 272]
    var omit_log: i32 = 0 - 1
    var omit_pos: i32 = 0 - 1
    i = 0
    while i < length {
        let idx: usize = jxl_bits.jb_peek(b, 7) as usize
        jxl_bits.jb_consume(b, LC_BITS[idx] as u32)
        logc[i] = LC_SYM[idx] as u32
        if logc[i] == ANS_LOG_TAB + 1 {
            let rle: u32 = jxl_huff.huff_var_len_u8(b)
            same[i] = rle + 5
            i = i + (rle as usize) + 4
            continue
        }
        if (logc[i] as i32) > omit_log {
            omit_log = logc[i] as i32
            omit_pos = i as i32
        }
        i = i + 1
    }
    if omit_pos < 0 {
        return false
    }
    var prev: u32 = 0
    var numsame: u32 = 0
    var total: u32 = 0
    i = 0
    while i < length {
        if same[i] != 0 {
            numsame = same[i] - 1
            if i > 0 {
                prev = rt.ld32(counts, i - 1)
            } else {
                prev = 0
            }
        }
        if numsame > 0 {
            rt.st32(counts, i, prev)
            numsame = numsame - 1
            total = total + prev
        } else if i as i32 == omit_pos {
        } else if logc[i] == 0 {
        } else if logc[i] == 1 {
            rt.st32(counts, i, 1 as u32)
            total = total + 1
        } else {
            let code: u32 = logc[i]
            let bitcount: u32 = population_precision(code - 1, shift)
            let c: u32 = ((1 as u32) << (code - 1)) + (jxl_bits.jb_read(b, bitcount) << (code - 1 - bitcount))
            rt.st32(counts, i, c)
            total = total + c
        }
        if jxl_bits.jb_over(b) {
            return false
        }
        i = i + 1
    }
    if total >= ANS_TAB {
        return false
    }
    rt.st32(counts, omit_pos as usize, ANS_TAB - total)
    return true
}

fn ans_build_alias(counts: u64, n_in: usize, log_alpha: u32, dst: u64) -> bool {
    var n: usize = n_in
    while n > 0 && rt.ld32(counts, n - 1) == 0 {
        n = n - 1
    }
    var dist: [u32; 272] = [0; 272]
    var k: usize = 0
    while k < n {
        dist[k] = rt.ld32(counts, k)
        k = k + 1
    }
    if n == 0 {
        dist[0] = ANS_TAB
        n = 1
    }
    let table: usize = (1 as usize) << (log_alpha as usize)
    let entry: u32 = ANS_TAB >> log_alpha
    if n > table {
        return false
    }
    var sum: u32 = 0
    k = 0
    while k < n {
        sum = sum + dist[k]
        k = k + 1
    }
    if sum != ANS_TAB {
        return false
    }
    k = 0
    while k < n {
        if dist[k] == ANS_TAB {
            var i: usize = 0
            while i < table {
                let e: usize = i * ALIAS_WORDS
                rt.st32(dst, e, 0 as u32)
                rt.st32(dst, e + 1, k as u32)
                rt.st32(dst, e + 2, entry * (i as u32))
                rt.st32(dst, e + 3, 0 as u32)
                rt.st32(dst, e + 4, ANS_TAB)
                i = i + 1
            }
            return true
        }
        k = k + 1
    }
    var cut: [u32; 256] = [0; 256]
    var right: [u32; 256] = [0; 256]
    var off1: [u32; 256] = [0; 256]
    var under: [u32; 256] = [0; 256]
    var over: [u32; 256] = [0; 256]
    var nu: usize = 0
    var no: usize = 0
    k = 0
    while k < table {
        if k < n {
            cut[k] = dist[k]
            if cut[k] > entry {
                over[no] = k as u32
                no = no + 1
            } else if cut[k] < entry {
                under[nu] = k as u32
                nu = nu + 1
            }
        } else {
            cut[k] = 0
            under[nu] = k as u32
            nu = nu + 1
        }
        k = k + 1
    }
    while no > 0 {
        no = no - 1
        let oi: usize = over[no] as usize
        if nu == 0 {
            return false
        }
        nu = nu - 1
        let ui: usize = under[nu] as usize
        let by: u32 = entry - cut[ui]
        cut[oi] = cut[oi] - by
        right[ui] = oi as u32
        off1[ui] = cut[oi]
        if cut[oi] < entry {
            under[nu] = oi as u32
            nu = nu + 1
        } else if cut[oi] > entry {
            over[no] = oi as u32
            no = no + 1
        }
    }
    k = 0
    while k < table {
        var cutoff: u32 = 0
        var rv: u32 = right[k]
        var o1: u32 = off1[k]
        if cut[k] == entry {
            rv = k as u32
            o1 = 0
            cutoff = 0
        } else {
            o1 = o1 - cut[k]
            cutoff = cut[k]
        }
        var f0: u32 = 0
        if k < n {
            f0 = dist[k]
        }
        var f1: u32 = 0
        if (rv as usize) < n {
            f1 = dist[rv as usize]
        }
        let e: usize = k * ALIAS_WORDS
        rt.st32(dst, e, cutoff)
        rt.st32(dst, e + 1, rv)
        rt.st32(dst, e + 2, o1)
        rt.st32(dst, e + 3, f0)
        rt.st32(dst, e + 4, f1)
        k = k + 1
    }
    return true
}
