import std.rt
import jxl.jxl_err
import jxl.jxl_img
import jxl.jxl_mem

export {
    sq_default, sq_meta, sq_inverse, SQ_REC,
}

const SQ_REC: usize = 4
const NO_SHIFT: u32 = 4294967295
const MAX_FIRST_PREVIEW: usize = 8
const F_HORIZONTAL: usize = 0
const F_IN_PLACE: usize = 1
const F_BEGIN: usize = 2
const F_COUNT: usize = 3

fn sq_field(sq: u64, i: usize, f: usize) -> u32 {
    return rt.ld32(sq, i * SQ_REC + f)
}

fn push_rec(buf: u64, n: usize, horizontal: u32, in_place: u32, begin: u32, count: u32) {
    rt.st32(buf, n * SQ_REC + F_HORIZONTAL, horizontal)
    rt.st32(buf, n * SQ_REC + F_IN_PLACE, in_place)
    rt.st32(buf, n * SQ_REC + F_BEGIN, begin)
    rt.st32(buf, n * SQ_REC + F_COUNT, count)
}

fn sq_default(img: *mut jxl_img.JxlImage, out_sq: *mut u64, out_n: *mut u32) -> i32 {
    let nb_meta: usize = (*img).nb_meta
    if jxl_img.img_count(img) <= nb_meta {
        return jxl_err.JX_BAD
    }
    let nb_channels: usize = jxl_img.img_count(img) - nb_meta
    var w: usize = jxl_img.img_w(img, nb_meta)
    var h: usize = jxl_img.img_h(img, nb_meta)
    let buf: u64 = rt.heap_alloc(96 * SQ_REC * 4)
    if buf == 0 {
        return jxl_err.JX_MEMORY
    }
    var n: usize = 0
    let wide: bool = w > h
    if nb_channels > 2 && jxl_img.img_w(img, nb_meta + 1) == w && jxl_img.img_h(img, nb_meta + 1) == h {
        push_rec(buf, n, 1, 0, (nb_meta + 1) as u32, 2)
        n = n + 1
        push_rec(buf, n, 0, 0, (nb_meta + 1) as u32, 2)
        n = n + 1
    }
    if !wide && h > MAX_FIRST_PREVIEW {
        push_rec(buf, n, 0, 1, nb_meta as u32, nb_channels as u32)
        n = n + 1
        h = (h + 1) / 2
    }
    while (w > MAX_FIRST_PREVIEW || h > MAX_FIRST_PREVIEW) && n + 2 <= 96 {
        if w > MAX_FIRST_PREVIEW {
            push_rec(buf, n, 1, 1, nb_meta as u32, nb_channels as u32)
            n = n + 1
            w = (w + 1) / 2
        }
        if h > MAX_FIRST_PREVIEW {
            push_rec(buf, n, 0, 1, nb_meta as u32, nb_channels as u32)
            n = n + 1
            h = (h + 1) / 2
        }
    }
    var exact: u64 = 0
    if n > 0 {
        exact = rt.heap_alloc(n * SQ_REC * 4)
        if exact == 0 {
            rt.heap_free(buf, 96 * SQ_REC * 4)
            return jxl_err.JX_MEMORY
        }
        rt.mem_copy(exact, buf, n * SQ_REC * 4)
    }
    rt.heap_free(buf, 96 * SQ_REC * 4)
    *out_sq = exact
    *out_n = n as u32
    return jxl_err.JX_OK
}

fn check_range(begin: usize, count: usize, nchan: usize) -> bool {
    if count == 0 || begin >= nchan {
        return false
    }
    return begin + count <= nchan
}

fn sq_meta(sq: u64, n: usize, img: *mut jxl_img.JxlImage) -> i32 {
    var i: usize = 0
    while i < n {
        let horizontal: bool = sq_field(sq, i, F_HORIZONTAL) != 0
        let in_place: bool = sq_field(sq, i, F_IN_PLACE) != 0
        let begin: usize = sq_field(sq, i, F_BEGIN) as usize
        let count: usize = sq_field(sq, i, F_COUNT) as usize
        if !check_range(begin, count, jxl_img.img_count(img)) {
            return jxl_err.JX_BAD
        }
        let end: usize = begin + count - 1
        if begin < (*img).nb_meta {
            if end >= (*img).nb_meta || !in_place {
                return jxl_err.JX_BAD
            }
            (*img).nb_meta = (*img).nb_meta + count
        }
        var offset: usize = jxl_img.img_count(img)
        if in_place {
            offset = end + 1
        }
        var c: usize = begin
        while c <= end {
            var hs: u32 = jxl_img.img_hs(img, c)
            var vs: u32 = jxl_img.img_vs(img, c)
            if (hs != NO_SHIFT && hs > 30) || (vs != NO_SHIFT && vs > 30) {
                return jxl_err.JX_BAD
            }
            var w: usize = jxl_img.img_w(img, c)
            var h: usize = jxl_img.img_h(img, c)
            if w == 0 || h == 0 {
                return jxl_err.JX_BAD
            }
            if horizontal {
                let nw: usize = (w + 1) / 2
                w = w - nw
                if hs != NO_SHIFT {
                    hs = hs + 1
                }
                jxl_img.img_resize(img, c, nw, jxl_img.img_h(img, c), hs, vs)
            } else {
                let nh: usize = (h + 1) / 2
                h = h - nh
                if vs != NO_SHIFT {
                    vs = vs + 1
                }
                jxl_img.img_resize(img, c, jxl_img.img_w(img, c), nh, hs, vs)
            }
            jxl_img.img_insert(img, offset + (c - begin), w, h, hs, vs)
            c = c + 1
        }
        i = i + 1
    }
    return jxl_err.JX_OK
}

fn smooth_tendency(b: i64, a: i64, n: i64) -> i64 {
    var diff: i64 = 0
    if b >= a && a >= n {
        diff = (4 * b - 3 * n - a + 6) / 12
        if diff - (diff & 1) > 2 * (b - a) {
            diff = 2 * (b - a) + 1
        }
        if diff + (diff & 1) > 2 * (a - n) {
            diff = 2 * (a - n)
        }
    } else if b <= a && a <= n {
        diff = (4 * b - 3 * n - a - 6) / 12
        if diff + (diff & 1) < 2 * (b - a) {
            diff = 2 * (b - a) - 1
        }
        if diff - (diff & 1) < 2 * (a - n) {
            diff = 2 * (a - n)
        }
    }
    return diff
}

fn shift_down(s: u32) -> u32 {
    if s == NO_SHIFT || s == 0 {
        return s
    }
    return s - 1
}

fn inv_horizontal(img: *mut jxl_img.JxlImage, c: usize, rc: usize) -> i32 {
    let cw: usize = jxl_img.img_w(img, c)
    let ch: usize = jxl_img.img_h(img, c)
    let rw: usize = jxl_img.img_w(img, rc)
    let rh: usize = jxl_img.img_h(img, rc)
    if rw > cw || cw > rw + 1 || (rw != 0 && rh != ch) {
        return jxl_err.JX_BAD
    }
    let hs: u32 = shift_down(jxl_img.img_hs(img, c))
    let vs: u32 = jxl_img.img_vs(img, c)
    if rw == 0 {
        jxl_img.img_set_shift(img, c, hs, vs)
        return jxl_err.JX_OK
    }
    let ow: usize = cw + rw
    if ch == 0 {
        jxl_img.img_replace(img, c, ow, 0, hs, vs, 0)
        return jxl_err.JX_OK
    }
    let out: u64 = rt.heap_alloc(ow * ch * 4)
    if out == 0 {
        return jxl_err.JX_MEMORY
    }
    let avg: u64 = jxl_img.img_data(img, c)
    let res: u64 = jxl_img.img_data(img, rc)
    var y: usize = 0
    while y < ch {
        var x: usize = 0
        while x < rw {
            let a: i64 = jxl_mem.ldi(avg, y * cw + x) as i64
            var na: i64 = a
            if x + 1 < cw {
                na = jxl_mem.ldi(avg, y * cw + x + 1) as i64
            }
            var left: i64 = a
            if x > 0 {
                left = jxl_mem.ldi(out, y * ow + 2 * x - 1) as i64
            }
            let diff: i64 = (jxl_mem.ldi(res, y * rw + x) as i64) + smooth_tendency(left, a, na)
            let first: i64 = a + diff / 2
            jxl_mem.sti(out, y * ow + 2 * x, first as i32)
            jxl_mem.sti(out, y * ow + 2 * x + 1, (first - diff) as i32)
            x = x + 1
        }
        if (ow & 1) != 0 {
            jxl_mem.sti(out, y * ow + ow - 1, jxl_mem.ldi(avg, y * cw + cw - 1))
        }
        y = y + 1
    }
    jxl_img.img_replace(img, c, ow, ch, hs, vs, out)
    return jxl_err.JX_OK
}

fn inv_vertical(img: *mut jxl_img.JxlImage, c: usize, rc: usize) -> i32 {
    let cw: usize = jxl_img.img_w(img, c)
    let ch: usize = jxl_img.img_h(img, c)
    let rw: usize = jxl_img.img_w(img, rc)
    let rh: usize = jxl_img.img_h(img, rc)
    if rh > ch || ch > rh + 1 || (rh != 0 && rw != cw) {
        return jxl_err.JX_BAD
    }
    let hs: u32 = jxl_img.img_hs(img, c)
    let vs: u32 = shift_down(jxl_img.img_vs(img, c))
    if rh == 0 {
        jxl_img.img_set_shift(img, c, hs, vs)
        return jxl_err.JX_OK
    }
    let oh: usize = ch + rh
    if cw == 0 {
        jxl_img.img_replace(img, c, 0, oh, hs, vs, 0)
        return jxl_err.JX_OK
    }
    let out: u64 = rt.heap_alloc(cw * oh * 4)
    if out == 0 {
        return jxl_err.JX_MEMORY
    }
    let avg: u64 = jxl_img.img_data(img, c)
    let res: u64 = jxl_img.img_data(img, rc)
    var y: usize = 0
    while y < rh {
        var ny: usize = y
        if y + 1 < ch {
            ny = y + 1
        }
        var x: usize = 0
        while x < cw {
            let a: i64 = jxl_mem.ldi(avg, y * cw + x) as i64
            let na: i64 = jxl_mem.ldi(avg, ny * cw + x) as i64
            var top: i64 = a
            if y > 0 {
                top = jxl_mem.ldi(out, (2 * y - 1) * cw + x) as i64
            }
            let diff: i64 = (jxl_mem.ldi(res, y * cw + x) as i64) + smooth_tendency(top, a, na)
            let first: i64 = a + diff / 2
            jxl_mem.sti(out, (2 * y) * cw + x, first as i32)
            jxl_mem.sti(out, (2 * y + 1) * cw + x, (first - diff) as i32)
            x = x + 1
        }
        y = y + 1
    }
    if (oh & 1) != 0 {
        var x: usize = 0
        while x < cw {
            jxl_mem.sti(out, (oh - 1) * cw + x, jxl_mem.ldi(avg, (ch - 1) * cw + x))
            x = x + 1
        }
    }
    jxl_img.img_replace(img, c, cw, oh, hs, vs, out)
    return jxl_err.JX_OK
}

fn sq_inverse(sq: u64, n: usize, img: *mut jxl_img.JxlImage) -> i32 {
    var i: usize = n
    while i > 0 {
        i = i - 1
        let horizontal: bool = sq_field(sq, i, F_HORIZONTAL) != 0
        let in_place: bool = sq_field(sq, i, F_IN_PLACE) != 0
        let begin: usize = sq_field(sq, i, F_BEGIN) as usize
        let count: usize = sq_field(sq, i, F_COUNT) as usize
        let nchan: usize = jxl_img.img_count(img)
        if !check_range(begin, count, nchan) {
            return jxl_err.JX_BAD
        }
        let end: usize = begin + count - 1
        var offset: usize = 0
        if in_place {
            offset = end + 1
        } else {
            if nchan + begin < end + 1 {
                return jxl_err.JX_BAD
            }
            offset = nchan + begin - end - 1
        }
        if begin < (*img).nb_meta {
            if (*img).nb_meta <= count {
                return jxl_err.JX_BAD
            }
            (*img).nb_meta = (*img).nb_meta - count
        }
        var c: usize = begin
        while c <= end {
            let rc: usize = offset + c - begin
            if rc >= nchan {
                return jxl_err.JX_BAD
            }
            if jxl_img.img_w(img, c) < jxl_img.img_w(img, rc) || jxl_img.img_h(img, c) < jxl_img.img_h(img, rc) {
                return jxl_err.JX_BAD
            }
            var r: i32 = jxl_err.JX_OK
            if horizontal {
                r = inv_horizontal(img, c, rc)
            } else {
                r = inv_vertical(img, c, rc)
            }
            if r != jxl_err.JX_OK {
                return r
            }
            c = c + 1
        }
        var k: usize = 0
        while k < count {
            jxl_img.img_remove(img, offset)
            k = k + 1
        }
    }
    return jxl_err.JX_OK
}
