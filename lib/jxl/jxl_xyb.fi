// SPDX-License-Identifier: MPL-2.0
// lib/jxl/jxl_xyb.fi -- jxl_xyb: JPEG XL XYB to sRGB conversion
import jxl.jxl_dither
import jxl.jxl_f32
import jxl.jxl_srgb
import std.rt

export { xyb_to_rgb8, xyb_to_samples }

const OPSIN_BIAS: f64 = 0.0037930732552754493
const CBRT_BIAS: f64 = 0.15595419704914093

static INV_MATRIX: [f64; 9] = [11.031566901960783, -9.866943921568629, -0.16462299647058826,
    -3.254147380392157, 4.418770392156863, -0.16462299647058826,
    -3.6588512862745097, 2.7129230470588235, 1.9459282392156863]

fn fld(p: u64, i: usize) -> f64 {
    return *((p +% ((i * 8) as u64)) as *mut f64)
}

fn xyb_to_rgb8(planes: u64, width: usize, height: usize, stride: usize, plane_len: usize, intensity: f64, out: u64, dc: *mut jxl_dither.JxlDither) {
    xyb_convert(planes, width, height, stride, plane_len, intensity, 255.0, out, false, dc)
}

fn xyb_to_samples(planes: u64, width: usize, height: usize, stride: usize, plane_len: usize, intensity: f64, bits: u32, out: u64, dc: *mut jxl_dither.JxlDither) {
    xyb_convert(planes, width, height, stride, plane_len, intensity, (((1 as u64) << (bits as u64)) - 1) as f64, out, true, dc)
}

fn xyb_convert(planes: u64, width: usize, height: usize, stride: usize, plane_len: usize, intensity: f64, maxv: f64, out: u64, planar: bool, dc: *mut jxl_dither.JxlDither) {
    let scale32: f64 = jxl_f32.round32(255.0 / jxl_f32.round32(intensity))
    let bias32: f64 = jxl_f32.round32(OPSIN_BIAS)
    let m0: f64 = jxl_f32.round32(jxl_f32.round32(INV_MATRIX[0]) * scale32)
    let m1: f64 = jxl_f32.round32(jxl_f32.round32(INV_MATRIX[1]) * scale32)
    let m2: f64 = jxl_f32.round32(jxl_f32.round32(INV_MATRIX[2]) * scale32)
    let m3: f64 = jxl_f32.round32(jxl_f32.round32(INV_MATRIX[3]) * scale32)
    let m4: f64 = jxl_f32.round32(jxl_f32.round32(INV_MATRIX[4]) * scale32)
    let m5: f64 = jxl_f32.round32(jxl_f32.round32(INV_MATRIX[5]) * scale32)
    let m6: f64 = jxl_f32.round32(jxl_f32.round32(INV_MATRIX[6]) * scale32)
    let m7: f64 = jxl_f32.round32(jxl_f32.round32(INV_MATRIX[7]) * scale32)
    let m8: f64 = jxl_f32.round32(jxl_f32.round32(INV_MATRIX[8]) * scale32)
    let dither: bool = jxl_dither.dither_active(dc, maxv)
    var table: u64 = 0
    if !dither && jxl_srgb.srgb_table_worthwhile(width * height, maxv) {
        table = jxl_srgb.srgb_table_new(maxv)
    }
    var y: usize = 0
    while y < height {
        var x: usize = 0
        while x < width {
            let i: usize = y * stride + x
            let px: f64 = jxl_f32.round32(fld(planes, i))
            let py: f64 = jxl_f32.round32(fld(planes, plane_len + i))
            let pb: f64 = jxl_f32.round32(fld(planes, 2 * plane_len + i))
            let gl: f64 = jxl_f32.round32(jxl_f32.round32(py + px) + CBRT_BIAS)
            let gm: f64 = jxl_f32.round32(jxl_f32.round32(py - px) + CBRT_BIAS)
            let gs: f64 = jxl_f32.round32(pb + CBRT_BIAS)
            let ml: f64 = jxl_f32.fma32(jxl_f32.round32(gl * gl), gl, -bias32)
            let mm: f64 = jxl_f32.fma32(jxl_f32.round32(gm * gm), gm, -bias32)
            let ms: f64 = jxl_f32.fma32(jxl_f32.round32(gs * gs), gs, -bias32)
            var c: usize = 0
            while c < 3 {
                var lin: f64 = 0.0
                if c == 0 {
                    lin = jxl_f32.fma32(m2, ms, jxl_f32.fma32(m1, mm, jxl_f32.round32(m0 * ml)))
                } else if c == 1 {
                    lin = jxl_f32.fma32(m5, ms, jxl_f32.fma32(m4, mm, jxl_f32.round32(m3 * ml)))
                } else {
                    lin = jxl_f32.fma32(m8, ms, jxl_f32.fma32(m7, mm, jxl_f32.round32(m6 * ml)))
                }
                var q: i32 = 0
                if dither {
                    q = jxl_dither.dither_quantize(dc, jxl_srgb.srgb_value(lin), maxv, x, y, c)
                } else if table != 0 {
                    q = jxl_srgb.srgb_table_encode(table, lin, maxv)
                } else {
                    q = jxl_srgb.srgb_encode(lin, maxv)
                }
                if planar {
                    rt.st32(out, c * width * height + y * width + x, q as u32)
                } else {
                    rt.st8(out, (y * width + x) * 3 + c, q as u8)
                }
                c = c + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    if table != 0 {
        jxl_srgb.srgb_table_free(table, maxv)
    }
}
