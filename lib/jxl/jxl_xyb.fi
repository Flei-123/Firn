// SPDX-License-Identifier: MPL-2.0
// lib/jxl/jxl_xyb.fi -- jxl_xyb: JPEG XL XYB to sRGB conversion
import std.math
import std.rt

export { xyb_to_rgb8 }

const OPSIN_BIAS: f64 = 0.0037930732552754493
const CBRT_BIAS: f64 = 0.15595420054924863

static INV_MATRIX: [f64; 9] = [11.031566901960783, -9.866943921568629, -0.16462299647058826,
    -3.254147380392157, 4.418770392156863, -0.16462299647058826,
    -3.6588512862745097, 2.7129230470588235, 1.9459282392156863]

fn fld(p: u64, i: usize) -> f64 {
    return *((p +% ((i * 8) as u64)) as *mut f64)
}

fn srgb_encode(v: f64) -> u8 {
    var l: f64 = v
    if l < 0.0 {
        l = 0.0
    }
    if l > 1.0 {
        l = 1.0
    }
    var e: f64 = 12.92 * l
    if l > 0.0031308 {
        e = 1.055 * math.powf(l, 1.0 / 2.4) - 0.055
    }
    var r: i64 = (e * 255.0 + 0.5) as i64
    if r > 255 {
        r = 255
    }
    return r as u8
}

fn xyb_to_rgb8(planes: u64, width: usize, height: usize, stride: usize, plane_len: usize, intensity: f64, out: u64) {
    let scale: f64 = 255.0 / intensity
    var y: usize = 0
    while y < height {
        var x: usize = 0
        while x < width {
            let i: usize = y * stride + x
            let px: f64 = fld(planes, i)
            let py: f64 = fld(planes, plane_len + i)
            let pb: f64 = fld(planes, 2 * plane_len + i)
            let gl: f64 = py + px + CBRT_BIAS
            let gm: f64 = py - px + CBRT_BIAS
            let gs: f64 = pb + CBRT_BIAS
            let ml: f64 = gl * gl * gl - OPSIN_BIAS
            let mm: f64 = gm * gm * gm - OPSIN_BIAS
            let ms: f64 = gs * gs * gs - OPSIN_BIAS
            var c: usize = 0
            while c < 3 {
                let lin: f64 = (INV_MATRIX[c * 3] * ml + INV_MATRIX[c * 3 + 1] * mm + INV_MATRIX[c * 3 + 2] * ms) * scale
                rt.st8(out, (y * width + x) * 3 + c, srgb_encode(lin))
                c = c + 1
            }
            x = x + 1
        }
        y = y + 1
    }
}
