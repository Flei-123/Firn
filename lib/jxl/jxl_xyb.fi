// SPDX-License-Identifier: MPL-2.0
// lib/jxl/jxl_xyb.fi -- jxl_xyb: JPEG XL XYB to sRGB conversion
import jxl.jxl_dither
import jxl.jxl_srgb
import std.rt

export { xyb_to_rgb8, xyb_to_samples }

const OPSIN_BIAS: f64 = 0.0037930732552754493
const CBRT_BIAS: f64 = 0.15595420054924863

static INV_MATRIX: [f64; 9] = [11.031566901960783, -9.866943921568629, -0.16462299647058826,
    -3.254147380392157, 4.418770392156863, -0.16462299647058826,
    -3.6588512862745097, 2.7129230470588235, 1.9459282392156863]

fn fld(p: u64, i: usize) -> f64 {
    return *((p +% ((i * 8) as u64)) as *mut f64)
}

fn xyb_to_rgb8(planes: u64, width: usize, height: usize, stride: usize, plane_len: usize, intensity: f64, out: u64) {
    xyb_convert(planes, width, height, stride, plane_len, intensity, 255.0, out, false)
}

fn xyb_to_samples(planes: u64, width: usize, height: usize, stride: usize, plane_len: usize, intensity: f64, bits: u32, out: u64) {
    xyb_convert(planes, width, height, stride, plane_len, intensity, (((1 as u64) << (bits as u64)) - 1) as f64, out, true)
}

fn xyb_convert(planes: u64, width: usize, height: usize, stride: usize, plane_len: usize, intensity: f64, maxv: f64, out: u64, planar: bool) {
    let scale: f64 = 255.0 / intensity
    let dither: bool = maxv == 255.0 && jxl_dither.dither_enabled()
    var table: u64 = 0
    if !dither && jxl_srgb.srgb_table_worthwhile(width * height, maxv) {
        table = jxl_srgb.srgb_table_new(maxv)
    }
    var y: usize = 0
    while y < height {
        var x: usize = 0
        while x < width {
            let i: usize = y * stride + x
            let px: f64 = fld(planes, i)
            let py: f64 = fld(planes, plane_len + i)
            let pb: f64 = fld(planes, 2 * plane_len + i)
            let gl: f64 = py + px + CBRT_BIAS
            let gm: f64 = py - px + CBRT_BIAS
            let gs: f64 = pb + CBRT_BIAS
            let ml: f64 = gl * gl * gl - OPSIN_BIAS
            let mm: f64 = gm * gm * gm - OPSIN_BIAS
            let ms: f64 = gs * gs * gs - OPSIN_BIAS
            var c: usize = 0
            while c < 3 {
                let lin: f64 = (INV_MATRIX[c * 3] * ml + INV_MATRIX[c * 3 + 1] * mm + INV_MATRIX[c * 3 + 2] * ms) * scale
                var q: i32 = 0
                if dither {
                    q = jxl_dither.dither_quantize(jxl_srgb.srgb_value(lin), maxv, x, y, c)
                } else if table != 0 {
                    q = jxl_srgb.srgb_table_encode(table, lin, maxv)
                } else {
                    q = jxl_srgb.srgb_encode(lin, maxv)
                }
                if planar {
                    rt.st32(out, c * width * height + y * width + x, q as u32)
                } else {
                    rt.st8(out, (y * width + x) * 3 + c, q as u8)
                }
                c = c + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    if table != 0 {
        jxl_srgb.srgb_table_free(table, maxv)
    }
}
