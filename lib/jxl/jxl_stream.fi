import std.rt
import std.vec
import jxl.jxl_bits
import jxl.jxl_chan
import jxl.jxl_code
import jxl.jxl_err
import jxl.jxl_img
import jxl.jxl_tree
import jxl.jxl_wp
import jxl.jxl_xform

export {
    JxlModState, ms_new, ms_free, stream_decode, xfs_free, xfs_inverse,
}

struct JxlModState {
    tree: jxl_tree.JxlTree,
    code: jxl_code.JxlCode,
    has_tree: bool,
}

fn ms_new() -> JxlModState {
    return JxlModState { tree: jxl_tree.tree_new(), code: jxl_code.code_new(), has_tree: false }
}

fn ms_free(ms: *mut JxlModState) {
    jxl_tree.tree_free(&(*ms).tree)
    jxl_code.code_free(&(*ms).code)
    (*ms).has_tree = false
}

fn xfs_free(xfs: *mut vec.Vec[jxl_xform.JxlXform]) {
    var i: usize = 0
    while i < vec.vec_len[jxl_xform.JxlXform](xfs) {
        jxl_xform.xf_free(vec.vec_elem_ptr[jxl_xform.JxlXform](xfs, i))
        i = i + 1
    }
    vec.vec_free[jxl_xform.JxlXform](xfs)
}

fn xfs_inverse(xfs: *mut vec.Vec[jxl_xform.JxlXform], img: *mut jxl_img.JxlImage, wph: *mut jxl_wp.JxlWpHeader, bit_depth: i64) -> i32 {
    var i: usize = vec.vec_len[jxl_xform.JxlXform](xfs)
    var r: i32 = jxl_err.JX_OK
    while r == jxl_err.JX_OK && i > 0 {
        i = i - 1
        r = jxl_xform.xf_inverse(vec.vec_elem_ptr[jxl_xform.JxlXform](xfs, i), img, wph, bit_depth)
    }
    return r
}

fn read_header(b: *mut jxl_bits.JxlBits, use_global: *mut bool, wph: *mut jxl_wp.JxlWpHeader, xfs: *mut vec.Vec[jxl_xform.JxlXform]) -> i32 {
    *use_global = jxl_bits.jb_bit(b)
    jxl_wp.wp_header_read(b, wph)
    let n: u32 = jxl_bits.jb_u32(b, jxl_bits.jd_val(0), jxl_bits.jd_val(1), jxl_bits.jd_off(4, 2), jxl_bits.jd_off(8, 18))
    var i: u32 = 0
    while i < n {
        var x: jxl_xform.JxlXform = jxl_xform.xf_new()
        let r: i32 = jxl_xform.xf_read(b, &x)
        if r != jxl_err.JX_OK {
            jxl_xform.xf_free(&x)
            return r
        }
        if !vec.vec_push[jxl_xform.JxlXform](xfs, x) {
            return jxl_err.JX_MEMORY
        }
        i = i + 1
    }
    if jxl_bits.jb_over(b) {
        return jxl_err.JX_TRUNCATED
    }
    return jxl_err.JX_OK
}

fn first_big(img: *mut jxl_img.JxlImage, max_size: usize) -> usize {
    var c: usize = 0
    while c < jxl_img.img_count(img) {
        if c >= (*img).nb_meta && (jxl_img.img_w(img, c) > max_size || jxl_img.img_h(img, c) > max_size) && jxl_img.img_nonempty(img, c) {
            return c
        }
        c = c + 1
    }
    return c
}

fn buffers_ok(img: *mut jxl_img.JxlImage) -> bool {
    var c: usize = 0
    while c < jxl_img.img_count(img) {
        if jxl_img.img_nonempty(img, c) && jxl_img.img_data(img, c) == 0 {
            return false
        }
        c = c + 1
    }
    return true
}

fn decode_planes(b: *mut jxl_bits.JxlBits, img: *mut jxl_img.JxlImage, tree: *mut jxl_tree.JxlTree, code: *mut jxl_code.JxlCode, wph: *mut jxl_wp.JxlWpHeader, stop: usize, dist_mul: usize, stream_id: u32) -> i32 {
    var rd: jxl_code.JxlReader = jxl_code.reader_new()
    var r: i32 = jxl_code.reader_init(&rd, code, b, dist_mul as u32)
    var c: usize = 0
    while r == jxl_err.JX_OK && c < stop {
        r = jxl_chan.chan_decode(b, &rd, tree, wph, img, c, stream_id)
        c = c + 1
    }
    if r == jxl_err.JX_OK && !jxl_code.reader_final_ok(&rd) {
        r = jxl_err.JX_BAD
    }
    jxl_code.reader_free(&rd)
    return r
}

fn stream_decode(b: *mut jxl_bits.JxlBits, img: *mut jxl_img.JxlImage, ms: *mut JxlModState, stream_id: u32, max_size: usize, wph: *mut jxl_wp.JxlWpHeader, xfs: *mut vec.Vec[jxl_xform.JxlXform]) -> i32 {
    var use_global: bool = false
    var r: i32 = read_header(b, &use_global, wph, xfs)
    var i: usize = 0
    while r == jxl_err.JX_OK && i < vec.vec_len[jxl_xform.JxlXform](xfs) {
        r = jxl_xform.xf_meta(vec.vec_elem_ptr[jxl_xform.JxlXform](xfs, i), img)
        i = i + 1
    }
    if r != jxl_err.JX_OK {
        return r
    }
    if !buffers_ok(img) {
        return jxl_err.JX_MEMORY
    }
    let stop: usize = first_big(img, max_size)
    var dist_mul: usize = 0
    var pixels: usize = 0
    var num: usize = 0
    var c: usize = 0
    while c < stop {
        if jxl_img.img_nonempty(img, c) {
            num = num + 1
            if jxl_img.img_w(img, c) > dist_mul {
                dist_mul = jxl_img.img_w(img, c)
            }
            pixels = pixels + jxl_img.img_w(img, c) * jxl_img.img_h(img, c)
        }
        c = c + 1
    }
    if num == 0 {
        return jxl_err.JX_OK
    }
    if use_global {
        if !(*ms).has_tree || jxl_tree.tree_count(&(*ms).tree) == 0 {
            return jxl_err.JX_BAD
        }
        return decode_planes(b, img, &(*ms).tree, &(*ms).code, wph, stop, dist_mul, stream_id)
    }
    var limit: usize = 1024 + pixels
    if limit > 1048576 {
        limit = 1048576
    }
    var tree: jxl_tree.JxlTree = jxl_tree.tree_new()
    var code: jxl_code.JxlCode = jxl_code.code_new()
    r = jxl_tree.tree_read(b, limit, &tree)
    if r == jxl_err.JX_OK {
        r = jxl_code.code_read(b, (jxl_tree.tree_count(&tree) + 1) / 2, false, &code)
    }
    if r == jxl_err.JX_OK {
        r = decode_planes(b, img, &tree, &code, wph, stop, dist_mul, stream_id)
    }
    jxl_tree.tree_free(&tree)
    jxl_code.code_free(&code)
    return r
}
