// SPDX-License-Identifier: MPL-2.0
// lib/jxl/jxl.fi -- jxl: JPEG XL decoder entry points (header info; Modular lossless pixels as the stages land)
import std.rt
import std.vec
import jxl.jxl_bits
import jxl.jxl_container
import jxl.jxl_err
import jxl.jxl_header
import jxl.jxl_frame

export {
    JxlInfo, JxlFrameInfo, JxlError, jxl_info, jxl_frame_info, jxl_sniff,
}

struct JxlInfo {
    width: u32,
    height: u32,
    color_channels: u32,
    extra_channels: u32,
    has_alpha: bool,
    bits: u32,
    is_float: bool,
    xyb: bool,
    want_icc: bool,
    animated: bool,
    orientation: u32,
    boxed: bool,
}

fn jxl_sniff(p: u64, n: usize) -> bool {
    return jxl_container.jc_sniff(p, n)
}

fn info_status(p: u64, n: usize, info: *mut JxlInfo) -> i32 {
    var cs: rt.Buf = rt.buf_new()
    var r: i32 = jxl_container.jc_extract(p, n, &cs)
    if r != jxl_err.JX_OK {
        rt.buf_free(&cs)
        return r
    }
    (*info).boxed = jxl_container.jc_is_boxed(p, n)
    var b: jxl_bits.JxlBits = jxl_bits.jb_new(rt.buf_ptr(&cs), rt.buf_len(&cs))
    if rt.buf_len(&cs) < 2 || rt.buf_at(&cs, 0) != 255 as u8 || rt.buf_at(&cs, 1) != 10 as u8 {
        rt.buf_free(&cs)
        return jxl_err.JX_NOT_JXL
    }
    jxl_bits.jb_skip_bits(&b, 16)
    var m: jxl_header.JxlMeta = jxl_header.jm_new()
    r = jxl_header.jm_read(&b, &m)
    if r == jxl_err.JX_OK {
        r = jxl_header.jm_read_custom_transform(&b, &m)
    }
    if r == jxl_err.JX_OK {
        (*info).width = m.width
        (*info).height = m.height
        (*info).color_channels = jxl_header.jm_color_channels(&m)
        (*info).extra_channels = vec.vec_len[jxl_header.JxlExtra](&m.extra) as u32
        (*info).has_alpha = jxl_header.jm_alpha_index(&m) >= 0
        (*info).bits = m.depth.bits
        (*info).is_float = m.depth.is_float
        (*info).xyb = m.xyb_encoded
        (*info).want_icc = m.color.want_icc
        (*info).animated = m.have_animation
        (*info).orientation = m.orientation
    }
    jxl_header.jm_free(&m)
    rt.buf_free(&cs)
    return r
}

fn jxl_info(p: u64, n: usize, info: *mut JxlInfo) -> JxlError!bool {
    let r: i32 = info_status(p, n, info)
    if r != jxl_err.JX_OK {
        return jxl_err.jx_fail(r)
    }
    return true
}

struct JxlFrameInfo {
    encoding: u32,
    flags: u64,
    width: u32,
    height: u32,
    num_passes: u32,
    num_groups: u32,
    num_lf_groups: u32,
    is_last: bool,
    toc_count: usize,
    toc_total: usize,
    body_start: usize,
    remaining: usize,
}

fn frame_status(p: u64, n: usize, fi: *mut JxlFrameInfo) -> i32 {
    var cs: rt.Buf = rt.buf_new()
    var r: i32 = jxl_container.jc_extract(p, n, &cs)
    if r != jxl_err.JX_OK {
        rt.buf_free(&cs)
        return r
    }
    if rt.buf_len(&cs) < 2 || rt.buf_at(&cs, 0) != 255 as u8 || rt.buf_at(&cs, 1) != 10 as u8 {
        rt.buf_free(&cs)
        return jxl_err.JX_NOT_JXL
    }
    var b: jxl_bits.JxlBits = jxl_bits.jb_new(rt.buf_ptr(&cs), rt.buf_len(&cs))
    jxl_bits.jb_skip_bits(&b, 16)
    var m: jxl_header.JxlMeta = jxl_header.jm_new()
    r = jxl_header.jm_read(&b, &m)
    if r == jxl_err.JX_OK {
        r = jxl_header.jm_read_custom_transform(&b, &m)
    }
    if r == jxl_err.JX_OK && m.color.want_icc {
        r = jxl_err.JX_UNSUPPORTED
    }
    if r == jxl_err.JX_OK && m.have_preview {
        r = jxl_err.JX_UNSUPPORTED
    }
    if r == jxl_err.JX_OK {
        if !jxl_bits.jb_zero_pad(&b) {
            r = jxl_err.JX_BAD
        }
    }
    var f: jxl_frame.JxlFrame = jxl_frame.jf_new()
    if r == jxl_err.JX_OK {
        r = jxl_frame.jf_read(&b, &m, &f)
    }
    if r == jxl_err.JX_OK {
        r = jxl_frame.jf_read_toc(&b, &f)
    }
    if r == jxl_err.JX_OK {
        (*fi).encoding = f.encoding
        (*fi).flags = f.flags
        (*fi).width = f.width
        (*fi).height = f.height
        (*fi).num_passes = f.num_passes
        (*fi).num_groups = f.num_groups
        (*fi).num_lf_groups = f.num_lf_groups
        (*fi).is_last = f.is_last
        (*fi).toc_count = f.toc_count
        (*fi).body_start = f.body_start
        var total: usize = 0
        var i: usize = 0
        while i < f.toc_count {
            total = total + jxl_frame.jf_section_size(&f, i)
            i = i + 1
        }
        (*fi).toc_total = total
        (*fi).remaining = rt.buf_len(&cs) - f.body_start
    }
    jxl_frame.jf_free(&f)
    jxl_header.jm_free(&m)
    rt.buf_free(&cs)
    return r
}

fn jxl_frame_info(p: u64, n: usize, fi: *mut JxlFrameInfo) -> JxlError!bool {
    let r: i32 = frame_status(p, n, fi)
    if r != jxl_err.JX_OK {
        return jxl_err.jx_fail(r)
    }
    return true
}
