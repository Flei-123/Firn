// SPDX-License-Identifier: MPL-2.0
import jxl.jxl_f32
import jxl.jxl_idct32
import jxl.jxl_qwdata

export { ac_identity, ac_dct2, ac_dct4, ac_dct4x8, ac_dct8x4, ac_afv }

fn fld(p: u64, i: usize) -> f64 {
    return *((p +% ((i * 8) as u64)) as *mut f64)
}

fn fst(p: u64, i: usize, v: f64) {
    *((p +% ((i * 8) as u64)) as *mut f64) = v
}

fn r32(v: f64) -> f64 {
    return jxl_f32.round32(v)
}

fn quad(a: f64, b: f64, c: f64, d: f64, i: usize) -> f64 {
    if i == 0 {
        return r32(r32(r32(a + b) + c) + d)
    }
    if i == 1 {
        return r32(r32(r32(a + b) - c) - d)
    }
    if i == 2 {
        return r32(r32(r32(a - b) + c) - d)
    }
    return r32(r32(r32(a - b) - c) + d)
}

fn ac_identity(coef: u64, out: u64) {
    let b00: f64 = fld(coef, 0)
    let b01: f64 = fld(coef, 1)
    let b10: f64 = fld(coef, 8)
    let b11: f64 = fld(coef, 9)
    var y: usize = 0
    while y < 2 {
        var x: usize = 0
        while x < 2 {
            var residual: f64 = 0.0
            var iy: usize = 0
            while iy < 4 {
                var ix: usize = 0
                while ix < 4 {
                    if ix != 0 || iy != 0 {
                        residual = r32(residual + fld(coef, (y + iy * 2) * 8 + x + ix * 2))
                    }
                    ix = ix + 1
                }
                iy = iy + 1
            }
            let centre: f64 = r32(quad(b00, b01, b10, b11, y * 2 + x) - r32(residual * (1.0 / 16.0)))
            fst(out, (4 * y + 1) * 8 + 4 * x + 1, centre)
            iy = 0
            while iy < 4 {
                var ix2: usize = 0
                while ix2 < 4 {
                    if ix2 != 1 || iy != 1 {
                        fst(out, (y * 4 + iy) * 8 + x * 4 + ix2, r32(fld(coef, (y + iy * 2) * 8 + x + ix2 * 2) + centre))
                    }
                    ix2 = ix2 + 1
                }
                iy = iy + 1
            }
            fst(out, y * 4 * 8 + x * 4, r32(fld(coef, (y + 2) * 8 + x + 2) + centre))
            x = x + 1
        }
        y = y + 1
    }
}

fn dct2_top(buf: u64, tmp: u64, s: usize) {
    let h: usize = s / 2
    var y: usize = 0
    while y < h {
        var x: usize = 0
        while x < h {
            let c00: f64 = fld(buf, y * 8 + x)
            let c01: f64 = fld(buf, y * 8 + h + x)
            let c10: f64 = fld(buf, (y + h) * 8 + x)
            let c11: f64 = fld(buf, (y + h) * 8 + h + x)
            fst(tmp, y * 2 * 8 + x * 2, quad(c00, c01, c10, c11, 0))
            fst(tmp, y * 2 * 8 + x * 2 + 1, quad(c00, c01, c10, c11, 1))
            fst(tmp, (y * 2 + 1) * 8 + x * 2, quad(c00, c01, c10, c11, 2))
            fst(tmp, (y * 2 + 1) * 8 + x * 2 + 1, quad(c00, c01, c10, c11, 3))
            x = x + 1
        }
        y = y + 1
    }
    y = 0
    while y < s {
        var x2: usize = 0
        while x2 < s {
            fst(buf, y * 8 + x2, fld(tmp, y * 8 + x2))
            x2 = x2 + 1
        }
        y = y + 1
    }
}

fn ac_dct2(coef: u64, out: u64, scratch: u64) {
    let tmp: u64 = scratch +% (64 * 8)
    var i: usize = 0
    while i < 64 {
        fst(out, i, fld(coef, i))
        i = i + 1
    }
    dct2_top(out, tmp, 2)
    dct2_top(out, tmp, 4)
    dct2_top(out, tmp, 8)
}

fn put_square4(out: u64, ox: usize, oy: usize, work: u64) {
    var r: usize = 0
    while r < 4 {
        var c: usize = 0
        while c < 4 {
            fst(out, (oy + r) * 8 + ox + c, fld(work, c * 4 + r))
            c = c + 1
        }
        r = r + 1
    }
}

fn put_wide(out: u64, oy: usize, work: u64) {
    var r: usize = 0
    while r < 4 {
        var c: usize = 0
        while c < 8 {
            fst(out, (oy + r) * 8 + c, fld(work, r * 8 + c))
            c = c + 1
        }
        r = r + 1
    }
}

fn ac_dct4(coef: u64, out: u64, scratch: u64) -> bool {
    let b00: f64 = fld(coef, 0)
    let b01: f64 = fld(coef, 1)
    let b10: f64 = fld(coef, 8)
    let b11: f64 = fld(coef, 9)
    let blk: u64 = scratch
    let work: u64 = scratch +% (64 * 8)
    var y: usize = 0
    while y < 2 {
        var x: usize = 0
        while x < 2 {
            fst(blk, 0, quad(b00, b01, b10, b11, y * 2 + x))
            var iy: usize = 0
            while iy < 4 {
                var ix: usize = 0
                while ix < 4 {
                    if ix != 0 || iy != 0 {
                        fst(blk, iy * 4 + ix, fld(coef, (y + iy * 2) * 8 + x + ix * 2))
                    }
                    ix = ix + 1
                }
                iy = iy + 1
            }
            if !jxl_idct32.idct32_square(4, blk, work) {
                return false
            }
            put_square4(out, x * 4, y * 4, work)
            x = x + 1
        }
        y = y + 1
    }
    return true
}

fn ac_dct4x8(coef: u64, out: u64, scratch: u64) -> bool {
    let blk: u64 = scratch
    let work: u64 = scratch +% (64 * 8)
    let b0: f64 = fld(coef, 0)
    let b1: f64 = fld(coef, 8)
    var y: usize = 0
    while y < 2 {
        if y == 0 {
            fst(blk, 0, r32(b0 + b1))
        } else {
            fst(blk, 0, r32(b0 - b1))
        }
        var iy: usize = 0
        while iy < 4 {
            var ix: usize = 0
            while ix < 8 {
                if ix != 0 || iy != 0 {
                    fst(blk, iy * 8 + ix, fld(coef, (y + iy * 2) * 8 + ix))
                }
                ix = ix + 1
            }
            iy = iy + 1
        }
        if !jxl_idct32.idct32_rect(4, 8, blk, work) {
            return false
        }
        put_wide(out, y * 4, work)
        y = y + 1
    }
    return true
}

fn ac_dct8x4(coef: u64, out: u64, scratch: u64) -> bool {
    let blk: u64 = scratch
    let work: u64 = scratch +% (64 * 8)
    let b0: f64 = fld(coef, 0)
    let b1: f64 = fld(coef, 8)
    var x: usize = 0
    while x < 2 {
        if x == 0 {
            fst(blk, 0, r32(b0 + b1))
        } else {
            fst(blk, 0, r32(b0 - b1))
        }
        var iy: usize = 0
        while iy < 4 {
            var ix: usize = 0
            while ix < 8 {
                if ix != 0 || iy != 0 {
                    fst(blk, iy * 8 + ix, fld(coef, (x + iy * 2) * 8 + ix))
                }
                ix = ix + 1
            }
            iy = iy + 1
        }
        if !jxl_idct32.idct32_rect(8, 4, blk, work) {
            return false
        }
        var r: usize = 0
        while r < 8 {
            var c: usize = 0
            while c < 4 {
                fst(out, r * 8 + x * 4 + c, fld(work, r * 4 + c))
                c = c + 1
            }
            r = r + 1
        }
        x = x + 1
    }
    return true
}

fn ac_afv(t: u32, coef: u64, out: u64, scratch: u64) -> bool {
    let kind: u32 = t - 14
    let afv_x: usize = (kind & 1) as usize
    let afv_y: usize = (kind / 2) as usize
    let b00: f64 = fld(coef, 0)
    let b01: f64 = fld(coef, 1)
    let b10: f64 = fld(coef, 8)
    let dc0: f64 = r32(r32(r32(b00 + b10) + b01) * 4.0)
    let dc1: f64 = r32(r32(b00 + b10) - b01)
    let dc2: f64 = r32(b00 - b10)
    let blk: u64 = scratch
    let work: u64 = scratch +% (64 * 8)
    let cf: u64 = scratch +% (128 * 8)
    let bl4: u64 = scratch +% (160 * 8)
    fst(cf, 0, dc0)
    var iy: usize = 0
    while iy < 4 {
        var ix: usize = 0
        while ix < 4 {
            if ix != 0 || iy != 0 {
                fst(cf, iy * 4 + ix, fld(coef, iy * 2 * 8 + ix * 2))
            }
            ix = ix + 1
        }
        iy = iy + 1
    }
    var i: usize = 0
    while i < 16 {
        var s: f64 = 0.0
        var j: usize = 0
        while j < 16 {
            s = jxl_f32.fma32(fld(cf, j), r32(jxl_qwdata.qwd_afv_basis(j, i)), s)
            j = j + 1
        }
        fst(bl4, i, s)
        i = i + 1
    }
    iy = 0
    while iy < 4 {
        var ix2: usize = 0
        while ix2 < 4 {
            var sy: usize = iy
            if afv_y == 1 {
                sy = 3 - iy
            }
            var sx: usize = ix2
            if afv_x == 1 {
                sx = 3 - ix2
            }
            fst(out, (iy + afv_y * 4) * 8 + afv_x * 4 + ix2, fld(bl4, sy * 4 + sx))
            ix2 = ix2 + 1
        }
        iy = iy + 1
    }
    fst(blk, 0, dc1)
    iy = 0
    while iy < 4 {
        var ix3: usize = 0
        while ix3 < 4 {
            if ix3 != 0 || iy != 0 {
                fst(blk, iy * 4 + ix3, fld(coef, iy * 2 * 8 + ix3 * 2 + 1))
            }
            ix3 = ix3 + 1
        }
        iy = iy + 1
    }
    var ox: usize = 4
    if afv_x == 1 {
        ox = 0
    }
    if !jxl_idct32.idct32_square(4, blk, work) {
        return false
    }
    put_square4(out, ox, afv_y * 4, work)
    fst(blk, 0, dc2)
    iy = 0
    while iy < 4 {
        var ix4: usize = 0
        while ix4 < 8 {
            if ix4 != 0 || iy != 0 {
                fst(blk, iy * 8 + ix4, fld(coef, (1 + iy * 2) * 8 + ix4))
            }
            ix4 = ix4 + 1
        }
        iy = iy + 1
    }
    if !jxl_idct32.idct32_rect(4, 8, blk, work) {
        return false
    }
    var oy: usize = 4
    if afv_y == 1 {
        oy = 0
    }
    put_wide(out, oy, work)
    return true
}
