// SPDX-License-Identifier: MPL-2.0
// lib/jxl/jxl_bits.fi -- jxl_bits: LSB-first bit reader with the JPEG XL field codes (U32, U64, F16, Enum)
import std.rt

export {
    JxlBits, jb_new, jb_read, jb_peek, jb_consume, jb_bit, jb_u32, jb_u64, jb_f16, jb_enum, jb_zero_pad, jb_align,
    jb_bit_pos, jb_byte_pos, jb_over, jb_skip_bits, jb_signed,
    jd_val, jd_bits, jd_off,
}

struct JxlBits {
    p: u64,
    n: usize,
    pos: u64,
    over: bool,
}

fn jb_new(p: u64, n: usize) -> JxlBits {
    return JxlBits { p: p, n: n, pos: 0, over: false }
}

fn jb_over(b: *mut JxlBits) -> bool {
    return (*b).over
}

fn jb_bit_pos(b: *mut JxlBits) -> u64 {
    return (*b).pos
}

fn jb_byte_pos(b: *mut JxlBits) -> usize {
    return (((*b).pos + 7) >> 3) as usize
}

fn jb_peek(b: *mut JxlBits, nbits: u32) -> u32 {
    if nbits == 0 {
        return 0
    }
    let byte: usize = ((*b).pos >> 3) as usize
    let sh: u64 = (*b).pos & 7
    var v: u64 = 0
    if byte + 8 <= (*b).n {
        v = *(((*b).p + byte as u64) as *mut u64)
    } else {
        var i: usize = 0
        while byte + i < (*b).n && i < 8 {
            v = v | ((rt.ld8((*b).p, byte + i) as u64) << (i as u64 * 8))
            i = i + 1
        }
    }
    v = v >> sh
    return (v & (((1 as u64) << (nbits as u64)) - 1)) as u32
}

fn jb_consume(b: *mut JxlBits, nbits: u32) {
    let total: u64 = (*b).n as u64 * 8
    if (*b).pos + nbits as u64 > total {
        (*b).over = true
        (*b).pos = total
        return
    }
    (*b).pos = (*b).pos + nbits as u64
}

fn jb_read(b: *mut JxlBits, nbits: u32) -> u32 {
    let v: u32 = jb_peek(b, nbits)
    jb_consume(b, nbits)
    return v
}

fn jb_bit(b: *mut JxlBits) -> bool {
    return jb_read(b, 1) != 0
}

fn jb_skip_bits(b: *mut JxlBits, n: u64) {
    let total: u64 = (*b).n as u64 * 8
    if (*b).pos + n > total {
        (*b).over = true
        (*b).pos = total
        return
    }
    (*b).pos = (*b).pos + n
}

fn jd_val(v: u32) -> u64 {
    return v as u64
}

fn jd_bits(n: u32) -> u64 {
    return ((1 as u64) << 48) | ((n as u64) << 32)
}

fn jd_off(n: u32, off: u32) -> u64 {
    return ((2 as u64) << 48) | ((n as u64) << 32) | off as u64
}

fn jb_u32(b: *mut JxlBits, d0: u64, d1: u64, d2: u64, d3: u64) -> u32 {
    let sel: u32 = jb_read(b, 2)
    var d: u64 = d0
    if sel == 1 { d = d1 }
    if sel == 2 { d = d2 }
    if sel == 3 { d = d3 }
    let kind: u64 = d >> 48
    let nb: u32 = ((d >> 32) & 255) as u32
    let lo: u32 = (d & 4294967295) as u32
    if kind == 0 {
        return lo
    }
    let v: u32 = jb_read(b, nb)
    if kind == 1 {
        return v
    }
    return v + lo
}

fn jb_u64(b: *mut JxlBits) -> u64 {
    let sel: u32 = jb_read(b, 2)
    if sel == 0 {
        return 0
    }
    if sel == 1 {
        return 1 + jb_read(b, 4) as u64
    }
    if sel == 2 {
        return 17 + jb_read(b, 8) as u64
    }
    var v: u64 = jb_read(b, 12) as u64
    var shift: u64 = 12
    while jb_bit(b) && !(*b).over {
        if shift == 60 {
            v = v | ((jb_read(b, 4) as u64) << 60)
            break
        }
        v = v | ((jb_read(b, 8) as u64) << shift)
        shift = shift + 8
    }
    return v
}

fn jb_enum(b: *mut JxlBits) -> u32 {
    return jb_u32(b, jd_val(0), jd_val(1), jd_off(4, 2), jd_off(6, 18))
}

fn jb_signed(u: u32) -> i32 {
    if (u & 1) == 0 {
        return (u >> 1) as i32
    }
    let v: i64 = ((u as i64) + 1) >> 1
    return (0 - v) as i32
}

fn jb_f16(b: *mut JxlBits) -> f64 {
    let v: u32 = jb_read(b, 16)
    let sign: u32 = v >> 15
    let ex: u32 = (v >> 10) & 31
    let mant: u32 = v & 1023
    var r: f64 = 0.0
    if ex == 0 {
        r = (mant as f64) / 16777216.0
    } else {
        var e: i32 = (ex as i32) - 15
        var m: f64 = 1.0 + (mant as f64) / 1024.0
        while e > 0 {
            m = m * 2.0
            e = e - 1
        }
        while e < 0 {
            m = m / 2.0
            e = e + 1
        }
        r = m
    }
    if sign != 0 {
        return 0.0 - r
    }
    return r
}

fn jb_zero_pad(b: *mut JxlBits) -> bool {
    let rem: u64 = (*b).pos & 7
    if rem == 0 {
        return true
    }
    return jb_read(b, (8 - rem) as u32) == 0
}

fn jb_align(b: *mut JxlBits) {
    let rem: u64 = (*b).pos & 7
    if rem != 0 {
        (*b).pos = (*b).pos + (8 - rem)
    }
}
