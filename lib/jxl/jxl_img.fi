import std.rt
import jxl.jxl_mem

export {
    JxlImage, img_new, img_free, img_add, img_insert, img_remove, img_resize, img_swap,
    img_w, img_h, img_hs, img_vs, img_data, img_get, img_set, img_count,
}

const REC: usize = 5

struct JxlImage {
    chans: u64,
    n: usize,
    cap: usize,
    nb_meta: usize,
}

fn img_new() -> JxlImage {
    return JxlImage { chans: 0, n: 0, cap: 0, nb_meta: 0 }
}

fn img_count(m: *mut JxlImage) -> usize {
    return (*m).n
}

fn img_w(m: *mut JxlImage, i: usize) -> usize {
    return rt.ld64((*m).chans, i * REC) as usize
}

fn img_h(m: *mut JxlImage, i: usize) -> usize {
    return rt.ld64((*m).chans, i * REC + 1) as usize
}

fn img_hs(m: *mut JxlImage, i: usize) -> u32 {
    return rt.ld64((*m).chans, i * REC + 2) as u32
}

fn img_vs(m: *mut JxlImage, i: usize) -> u32 {
    return rt.ld64((*m).chans, i * REC + 3) as u32
}

fn img_data(m: *mut JxlImage, i: usize) -> u64 {
    return rt.ld64((*m).chans, i * REC + 4)
}

fn img_get(m: *mut JxlImage, i: usize, x: usize, y: usize) -> i32 {
    return jxl_mem.ldi(img_data(m, i), y * img_w(m, i) + x)
}

fn img_set(m: *mut JxlImage, i: usize, x: usize, y: usize, v: i32) {
    jxl_mem.sti(img_data(m, i), y * img_w(m, i) + x, v)
}

fn make_data(w: usize, h: usize) -> u64 {
    let bytes: usize = w * h * 4
    if bytes == 0 {
        return 0
    }
    let p: u64 = rt.heap_alloc(bytes)
    if p != 0 {
        rt.mem_set(p, 0 as u8, bytes)
    }
    return p
}

fn reserve(m: *mut JxlImage) {
    if (*m).n < (*m).cap {
        return
    }
    var ncap: usize = (*m).cap * 2
    if ncap < 8 {
        ncap = 8
    }
    let np: u64 = rt.heap_alloc(ncap * REC * 8)
    if (*m).chans != 0 {
        rt.mem_copy(np, (*m).chans, (*m).n * REC * 8)
        rt.heap_free((*m).chans, (*m).cap * REC * 8)
    }
    (*m).chans = np
    (*m).cap = ncap
}

fn img_insert(m: *mut JxlImage, at: usize, w: usize, h: usize, hs: u32, vs: u32) {
    reserve(m)
    var i: usize = (*m).n
    while i > at {
        var k: usize = 0
        while k < REC {
            rt.st64((*m).chans, i * REC + k, rt.ld64((*m).chans, (i - 1) * REC + k))
            k = k + 1
        }
        i = i - 1
    }
    rt.st64((*m).chans, at * REC, w as u64)
    rt.st64((*m).chans, at * REC + 1, h as u64)
    rt.st64((*m).chans, at * REC + 2, hs as u64)
    rt.st64((*m).chans, at * REC + 3, vs as u64)
    rt.st64((*m).chans, at * REC + 4, make_data(w, h))
    (*m).n = (*m).n + 1
}

fn img_add(m: *mut JxlImage, w: usize, h: usize, hs: u32, vs: u32) {
    img_insert(m, (*m).n, w, h, hs, vs)
}

fn img_remove(m: *mut JxlImage, at: usize) {
    rt.heap_free(img_data(m, at), img_w(m, at) * img_h(m, at) * 4)
    var i: usize = at
    while i + 1 < (*m).n {
        var k: usize = 0
        while k < REC {
            rt.st64((*m).chans, i * REC + k, rt.ld64((*m).chans, (i + 1) * REC + k))
            k = k + 1
        }
        i = i + 1
    }
    (*m).n = (*m).n - 1
}

fn img_resize(m: *mut JxlImage, i: usize, w: usize, h: usize, hs: u32, vs: u32) {
    rt.heap_free(img_data(m, i), img_w(m, i) * img_h(m, i) * 4)
    rt.st64((*m).chans, i * REC, w as u64)
    rt.st64((*m).chans, i * REC + 1, h as u64)
    rt.st64((*m).chans, i * REC + 2, hs as u64)
    rt.st64((*m).chans, i * REC + 3, vs as u64)
    rt.st64((*m).chans, i * REC + 4, make_data(w, h))
}

fn img_swap(m: *mut JxlImage, a: usize, b: usize) {
    var k: usize = 0
    while k < REC {
        let t: u64 = rt.ld64((*m).chans, a * REC + k)
        rt.st64((*m).chans, a * REC + k, rt.ld64((*m).chans, b * REC + k))
        rt.st64((*m).chans, b * REC + k, t)
        k = k + 1
    }
}

fn img_free(m: *mut JxlImage) {
    var i: usize = 0
    while i < (*m).n {
        rt.heap_free(img_data(m, i), img_w(m, i) * img_h(m, i) * 4)
        i = i + 1
    }
    if (*m).chans != 0 {
        rt.heap_free((*m).chans, (*m).cap * REC * 8)
    }
    *m = img_new()
}
