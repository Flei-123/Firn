// lib/jxl/jxl_refs.fi -- jxl_refs: reference frame slots (XYB planes) and frame sequence counters
import std.rt

export { JxlRefSlot, JxlRefs, refs_new, refs_free, refs_store, refs_store_dc, refs_valid, refs_dc_valid }

struct JxlRefSlot {
    planes: u64,
    stride: usize,
    plane_len: usize,
    w: usize,
    h: usize,
}

struct JxlRefs {
    slots: [JxlRefSlot; 4],
    dc: [JxlRefSlot; 4],
    visible: u64,
    nonvisible: u64,
}

fn slot_empty() -> JxlRefSlot {
    return JxlRefSlot { planes: 0, stride: 0, plane_len: 0, w: 0, h: 0 }
}

fn refs_new() -> JxlRefs {
    return JxlRefs { slots: [slot_empty(); 4], dc: [slot_empty(); 4], visible: 0, nonvisible: 0 }
}

fn refs_free(r: *mut JxlRefs) {
    var i: usize = 0
    while i < 4 {
        if (*r).slots[i].planes != 0 {
            rt.heap_free((*r).slots[i].planes, (*r).slots[i].plane_len * 3 * 8)
            (*r).slots[i].planes = 0
        }
        if (*r).dc[i].planes != 0 {
            rt.heap_free((*r).dc[i].planes, (*r).dc[i].plane_len * 3 * 8)
            (*r).dc[i].planes = 0
        }
        i = i + 1
    }
}

fn refs_store(r: *mut JxlRefs, idx: usize, planes: u64, stride: usize, plane_len: usize, w: usize, h: usize) {
    if (*r).slots[idx].planes != 0 {
        rt.heap_free((*r).slots[idx].planes, (*r).slots[idx].plane_len * 3 * 8)
    }
    (*r).slots[idx] = JxlRefSlot { planes: planes, stride: stride, plane_len: plane_len, w: w, h: h }
}

fn refs_valid(r: *mut JxlRefs, idx: usize) -> bool {
    return idx < 4 && (*r).slots[idx].planes != 0
}

fn refs_store_dc(r: *mut JxlRefs, idx: usize, planes: u64, stride: usize, plane_len: usize, w: usize, h: usize) {
    if (*r).dc[idx].planes != 0 {
        rt.heap_free((*r).dc[idx].planes, (*r).dc[idx].plane_len * 3 * 8)
    }
    (*r).dc[idx] = JxlRefSlot { planes: planes, stride: stride, plane_len: plane_len, w: w, h: h }
}

fn refs_dc_valid(r: *mut JxlRefs, idx: usize) -> bool {
    return idx < 4 && (*r).dc[idx].planes != 0
}
