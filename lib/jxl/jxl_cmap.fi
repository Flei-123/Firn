import jxl.jxl_bits
import jxl.jxl_err
import jxl.jxl_f32

export { JxlCmap, cmap_default, cmap_read, cmap_ratio_x, cmap_ratio_b, cmap_ratio_x_fused, cmap_ratio_b_fused }

const DEFAULT_COLOR_FACTOR: u32 = 84

struct JxlCmap {
    color_factor: u32,
    base_x: f64,
    base_b: f64,
    ytox_dc: i32,
    ytob_dc: i32,
}

fn cmap_default() -> JxlCmap {
    return JxlCmap { color_factor: DEFAULT_COLOR_FACTOR, base_x: 0.0, base_b: 1.0, ytox_dc: 0, ytob_dc: 0 }
}

fn cmap_ratio_x(c: *mut JxlCmap, factor: i32) -> f64 {
    return jxl_f32.round32((*c).base_x + jxl_f32.round32((factor as f64) * jxl_f32.round32(1.0 / ((*c).color_factor as f64))))
}

fn cmap_ratio_b(c: *mut JxlCmap, factor: i32) -> f64 {
    return jxl_f32.round32((*c).base_b + jxl_f32.round32((factor as f64) * jxl_f32.round32(1.0 / ((*c).color_factor as f64))))
}

fn cmap_ratio_x_fused(c: *mut JxlCmap, factor: i32) -> f64 {
    return jxl_f32.fma32(factor as f64, jxl_f32.round32(1.0 / ((*c).color_factor as f64)), (*c).base_x)
}

fn cmap_ratio_b_fused(c: *mut JxlCmap, factor: i32) -> f64 {
    return jxl_f32.fma32(factor as f64, jxl_f32.round32(1.0 / ((*c).color_factor as f64)), (*c).base_b)
}

fn cmap_read(b: *mut jxl_bits.JxlBits, c: *mut JxlCmap) -> i32 {
    *c = cmap_default()
    if jxl_bits.jb_bit(b) {
        return jxl_err.JX_OK
    }
    (*c).color_factor = jxl_bits.jb_u32(b, jxl_bits.jd_val(84), jxl_bits.jd_val(256), jxl_bits.jd_off(8, 2), jxl_bits.jd_off(16, 258))
    (*c).base_x = jxl_bits.jb_f16(b)
    (*c).base_b = jxl_bits.jb_f16(b)
    (*c).ytox_dc = (jxl_bits.jb_read(b, 8) as i32) - 128
    (*c).ytob_dc = (jxl_bits.jb_read(b, 8) as i32) - 128
    if jxl_bits.jb_over(b) {
        return jxl_err.JX_TRUNCATED
    }
    if (*c).base_x > 4.0 || (*c).base_x < -4.0 || (*c).base_b > 4.0 || (*c).base_b < -4.0 {
        return jxl_err.JX_BAD
    }
    return jxl_err.JX_OK
}
