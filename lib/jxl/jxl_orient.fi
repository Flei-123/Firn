// SPDX-License-Identifier: MPL-2.0
// lib/jxl/jxl_orient.fi -- jxl_orient: apply the EXIF orientation (1-8) to an interleaved pixel buffer
import std.rt

export { orient_swaps_axes, orient_apply }

fn orient_swaps_axes(orientation: u32) -> bool {
    return orientation >= 5 && orientation <= 8
}

fn source_x(o: u32, x: usize, y: usize, w: usize, h: usize) -> usize {
    if o == 2 || o == 3 {
        return w - 1 - x
    }
    if o == 5 {
        return y
    }
    if o == 6 {
        return y
    }
    if o == 7 || o == 8 {
        return w - 1 - y
    }
    return x
}

fn source_y(o: u32, x: usize, y: usize, w: usize, h: usize) -> usize {
    if o == 3 || o == 4 {
        return h - 1 - y
    }
    if o == 5 {
        return x
    }
    if o == 6 {
        return h - 1 - x
    }
    if o == 7 {
        return h - 1 - x
    }
    if o == 8 {
        return x
    }
    return y
}

fn orient_apply(src: u64, w: usize, h: usize, pixel_bytes: usize, orientation: u32, dst: u64) {
    var ow: usize = w
    var oh: usize = h
    if orient_swaps_axes(orientation) {
        ow = h
        oh = w
    }
    var y: usize = 0
    while y < oh {
        var x: usize = 0
        while x < ow {
            let sx: usize = source_x(orientation, x, y, w, h)
            let sy: usize = source_y(orientation, x, y, w, h)
            rt.mem_copy(dst +% (((y * ow + x) * pixel_bytes) as u64), src +% (((sy * w + sx) * pixel_bytes) as u64), pixel_bytes)
            x = x + 1
        }
        y = y + 1
    }
}
