static OFFSETS: [usize; 17] = [0, 18, 27, 45, 63, 84, 108, 129, 153, 177, 192, 219, 243, 267, 291, 315, 339]
static UP_OFFSETS: [usize; 6] = [0, 1, 3, 7, 15, 31]

fn qwd_param(i: usize) -> f64 {
    return PARAMS[i]
}

fn qwd_offset(kind: usize) -> usize {
    return OFFSETS[kind]
}

fn qwd_up_scale(log2n: usize, k: usize) -> f64 {
    return UPS[UP_OFFSETS[log2n] + k]
}

fn qwd_afv_basis(j: usize, i: usize) -> f64 {
    return AFV[j * 16 + i]
}
