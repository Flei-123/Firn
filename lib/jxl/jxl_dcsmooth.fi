// SPDX-License-Identifier: MPL-2.0
// lib/jxl/jxl_dcsmooth.fi -- jxl_dcsmooth: JPEG XL adaptive DC smoothing
import jxl.jxl_f32
import jxl.jxl_lfdata
import jxl.jxl_quant
import std.math
import std.rt

export { dcs_apply }

const W1: f64 = 0.20345139757231578
const W2: f64 = 0.0334829185968739

fn at(p: u64, c: usize, bw: usize, bh: usize, x: usize, y: usize) -> f64 {
    return *((p +% (((c * bw * bh + y * bw + x) * 8) as u64)) as *mut f64)
}

fn dcs_apply(d: *mut jxl_lfdata.JxlLfData, q: *mut jxl_quant.JxlQuant) -> bool {
    let bw: usize = (*d).bw
    let bh: usize = (*d).bh
    if bw <= 2 || bh <= 2 {
        return true
    }
    let n: usize = bw * bh * 3 * 8
    let src: u64 = rt.heap_alloc(n)
    if src == 0 {
        return false
    }
    var c: usize = 0
    while c < 3 {
        var y: usize = 0
        while y < bh {
            var x: usize = 0
            while x < bw {
                *((src +% (((c * bw * bh + y * bw + x) * 8) as u64)) as *mut f64) = jxl_lfdata.lfd_dc_get(d, c, x, y)
                x = x + 1
            }
            y = y + 1
        }
        c = c + 1
    }
    let w1: f64 = jxl_f32.round32(W1)
    let w2: f64 = jxl_f32.round32(W2)
    let w0: f64 = jxl_f32.round32(1.0 - jxl_f32.round32(4.0 * jxl_f32.round32(w1 + w2)))
    var steps: [f64; 3] = [0.0; 3]
    c = 0
    while c < 3 {
        steps[c] = jxl_quant.quant_dc_step(q, c)
        c = c + 1
    }
    var y: usize = 1
    while y + 1 < bh {
        var x: usize = 1
        while x + 1 < bw {
            var sm: [f64; 3] = [0.0; 3]
            var mc: [f64; 3] = [0.0; 3]
            var gap: f64 = 0.5
            c = 0
            while c < 3 {
                let tl: f64 = at(src, c, bw, bh, x - 1, y - 1)
                let tr: f64 = at(src, c, bw, bh, x + 1, y - 1)
                let bl: f64 = at(src, c, bw, bh, x - 1, y + 1)
                let br: f64 = at(src, c, bw, bh, x + 1, y + 1)
                let ml: f64 = at(src, c, bw, bh, x - 1, y)
                let mr: f64 = at(src, c, bw, bh, x + 1, y)
                let tc: f64 = at(src, c, bw, bh, x, y - 1)
                let bc: f64 = at(src, c, bw, bh, x, y + 1)
                let corner: f64 = jxl_f32.round32(jxl_f32.round32(tl + tr) + jxl_f32.round32(bl + br))
                let side: f64 = jxl_f32.round32(jxl_f32.round32(ml + mr) + jxl_f32.round32(tc + bc))
                mc[c] = at(src, c, bw, bh, x, y)
                sm[c] = jxl_f32.fma32(corner, w2, jxl_f32.fma32(side, w1, jxl_f32.round32(mc[c] * w0)))
                let g: f64 = math.fabs(jxl_f32.round32(jxl_f32.round32(mc[c] - sm[c]) / steps[c]))
                if g > gap {
                    gap = g
                }
                c = c + 1
            }
            var factor: f64 = jxl_f32.fma32(-4.0, gap, 3.0)
            if factor < 0.0 {
                factor = 0.0
            }
            c = 0
            while c < 3 {
                jxl_lfdata.lfd_dc_set(d, c, x, y, jxl_f32.fma32(jxl_f32.round32(sm[c] - mc[c]), factor, mc[c]))
                c = c + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    rt.heap_free(src, n)
    return true
}
