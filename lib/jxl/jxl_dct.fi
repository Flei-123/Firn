// SPDX-License-Identifier: MPL-2.0
import std.math
import std.rt

export {
    idct_1d, idct_2d, dct_1d_slow, dct_2d_slow, idct_1d_slow, valid_size,
}

fn fld(p: u64, i: usize) -> f64 {
    return *((p +% ((i * 8) as u64)) as *mut f64)
}

fn fst(p: u64, i: usize, v: f64) {
    *((p +% ((i * 8) as u64)) as *mut f64) = v
}

static mut DENOM: [f64; 256] = [0.0; 256]
static mut DENOM_READY: bool = false

fn denom_init() {
    var n: usize = 2
    while n <= 256 {
        let h: usize = n / 2
        var i: usize = 0
        while i < h {
            let theta: f64 = ((i as f64) + 0.5) * math.PI() / (n as f64)
            DENOM[h - 1 + i] = math.SQRT2() * math.cos(theta)
            i = i + 1
        }
        n = n * 2
    }
    DENOM_READY = true
}

static mut COS_TAB: [f64; 1365] = [0.0; 1365]
static mut COS_READY: bool = false

fn cos_expr(n: usize, u: usize, y: usize) -> f64 {
    return math.cos(((y as f64) + 0.5) * (u as f64) * math.PI() / (n as f64))
}

fn cos_init() {
    var n: usize = 1
    var base: usize = 0
    while n <= 32 {
        var u: usize = 0
        while u < n {
            var y: usize = 0
            while y < n {
                COS_TAB[base + u * n + y] = cos_expr(n, u, y)
                y = y + 1
            }
            u = u + 1
        }
        base = base + n * n
        n = n * 2
    }
    COS_READY = true
}

fn cos_term(n: usize, u: usize, y: usize) -> f64 {
    if n > 32 || (n & (n - 1)) != 0 {
        return cos_expr(n, u, y)
    }
    if !COS_READY {
        cos_init()
    }
    return COS_TAB[(n * n - 1) / 3 + u * n + y]
}

fn valid_size(n: usize) -> bool {
    return n >= 1 && n <= 256 && (n & (n - 1)) == 0
}

fn idct_rec(x: u64, n: usize, out: u64, scratch: u64) {
    if n == 1 {
        fst(out, 0, fld(x, 0))
        return
    }
    if !DENOM_READY {
        denom_init()
    }
    if n == 2 {
        let e2: f64 = fld(x, 0)
        let o2: f64 = fld(x, 1) / DENOM[0]
        fst(out, 0, e2 + o2)
        fst(out, 1, e2 - o2)
        return
    }
    let h: usize = n / 2
    let even: u64 = scratch
    let odd: u64 = scratch +% ((h * 8) as u64)
    let e_out: u64 = scratch +% ((h * 16) as u64)
    let d_out: u64 = scratch +% ((h * 24) as u64)
    let next: u64 = scratch +% ((h * 32) as u64)
    var k: usize = 0
    while k < h {
        fst(even, k, fld(x, 2 * k))
        if k == 0 {
            fst(odd, 0, fld(x, 1))
        } else {
            fst(odd, k, (fld(x, 2 * k + 1) + fld(x, 2 * k - 1)) / math.SQRT2())
        }
        k = k + 1
    }
    idct_rec(even, h, e_out, next)
    idct_rec(odd, h, d_out, next)
    var i: usize = 0
    while i < h {
        let o: f64 = fld(d_out, i) / DENOM[h - 1 + i]
        let e: f64 = fld(e_out, i)
        fst(out, i, e + o)
        fst(out, n - 1 - i, e - o)
        i = i + 1
    }
}

fn idct_1d(x: u64, n: usize, out: u64) -> bool {
    if !valid_size(n) {
        return false
    }
    let scratch: u64 = rt.heap_alloc(n * 8 * 4 + 64)
    if scratch == 0 {
        return false
    }
    idct_rec(x, n, out, scratch)
    rt.heap_free(scratch, n * 8 * 4 + 64)
    return true
}

fn idct_2d(rows: usize, cols: usize, inp: u64, out: u64) -> bool {
    if !valid_size(rows) || !valid_size(cols) {
        return false
    }
    let mx: usize = if rows > cols { rows } else { cols }
    let total: usize = (mx * 6 + rows * cols + 8) * 8
    let base: u64 = rt.heap_alloc(total)
    if base == 0 {
        return false
    }
    let col_in: u64 = base
    let col_out: u64 = base +% ((mx * 8) as u64)
    let scratch: u64 = col_out +% ((mx * 8) as u64)
    let tmp: u64 = scratch +% ((mx * 32 + 64) as u64)
    var c: usize = 0
    while c < cols {
        var r: usize = 0
        while r < rows {
            fst(col_in, r, fld(inp, r * cols + c))
            r = r + 1
        }
        idct_rec(col_in, rows, col_out, scratch)
        r = 0
        while r < rows {
            fst(tmp, r * cols + c, fld(col_out, r))
            r = r + 1
        }
        c = c + 1
    }
    var r2: usize = 0
    while r2 < rows {
        idct_rec(tmp +% ((r2 * cols * 8) as u64), cols, out +% ((r2 * cols * 8) as u64), scratch)
        r2 = r2 + 1
    }
    rt.heap_free(base, total)
    return true
}

fn weight(u: usize) -> f64 {
    if u == 0 {
        return 1.0
    }
    return math.SQRT2()
}

fn idct_1d_slow(x: u64, n: usize, out: u64) {
    var y: usize = 0
    while y < n {
        var s: f64 = 0.0
        var u: usize = 0
        while u < n {
            s = s + weight(u) * fld(x, u) * cos_term(n, u, y)
            u = u + 1
        }
        fst(out, y, s)
        y = y + 1
    }
}

fn dct_1d_slow(x: u64, n: usize, out: u64) {
    var u: usize = 0
    while u < n {
        var s: f64 = 0.0
        var y: usize = 0
        while y < n {
            s = s + fld(x, y) * cos_term(n, u, y)
            y = y + 1
        }
        fst(out, u, weight(u) * s / (n as f64))
        u = u + 1
    }
}

fn dct_2d_slow(rows: usize, cols: usize, inp: u64, out: u64) {
    let tmp: u64 = rt.heap_alloc(rows * cols * 8)
    let a: u64 = rt.heap_alloc(256 * 8)
    let b: u64 = rt.heap_alloc(256 * 8)
    var c: usize = 0
    while c < cols {
        var r: usize = 0
        while r < rows {
            fst(a, r, fld(inp, r * cols + c))
            r = r + 1
        }
        dct_1d_slow(a, rows, b)
        r = 0
        while r < rows {
            fst(tmp, r * cols + c, fld(b, r))
            r = r + 1
        }
        c = c + 1
    }
    var r2: usize = 0
    while r2 < rows {
        dct_1d_slow(tmp +% ((r2 * cols * 8) as u64), cols, out +% ((r2 * cols * 8) as u64))
        r2 = r2 + 1
    }
    rt.heap_free(tmp, rows * cols * 8)
    rt.heap_free(a, 256 * 8)
    rt.heap_free(b, 256 * 8)
}
