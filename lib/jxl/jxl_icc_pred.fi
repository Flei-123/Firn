import std.rt

export {
    HEADER_SIZE, NUM_CONTEXTS, TAG_RXYZ, TAG_GXYZ, TAG_BXYZ, TAG_KXYZ, TAG_WTPT, TAG_BKPT, TAG_LUMI, TAG_RTRC, TAG_GTRC, TAG_BTRC,
    TAG_XYZ_TYPE, NUM_TAG_STRINGS, NUM_TYPE_STRINGS, tag_string, type_string, be32_at, push_be32, put_be32, shuffle_bytes,
    linear_predict, initial_header, predict_header, ans_context, read_varint,
}

const HEADER_SIZE: usize = 128
const NUM_CONTEXTS: usize = 41
const NUM_TAG_STRINGS: usize = 17
const NUM_TYPE_STRINGS: usize = 8
const TAG_RXYZ: u32 = 0x7258595a
const TAG_GXYZ: u32 = 0x6758595a
const TAG_BXYZ: u32 = 0x6258595a
const TAG_KXYZ: u32 = 0x6b58595a
const TAG_WTPT: u32 = 0x77747074
const TAG_BKPT: u32 = 0x626b7074
const TAG_LUMI: u32 = 0x6c756d69
const TAG_RTRC: u32 = 0x72545243
const TAG_GTRC: u32 = 0x67545243
const TAG_BTRC: u32 = 0x62545243
const TAG_XYZ_TYPE: u32 = 0x58595a20
const TAG_MNTR: u32 = 0x6d6e7472
const TAG_RGB: u32 = 0x52474220
const TAG_ACSP: u32 = 0x61637370

static TAG_STRINGS: [u32; 17] = [
    0x63707274, 0x77747074, 0x626b7074, 0x7258595a, 0x6758595a, 0x6258595a, 0x6b58595a, 0x72545243, 0x67545243,
    0x62545243, 0x6b545243, 0x63686164, 0x64657363, 0x6368726d, 0x646d6e64, 0x646d6464, 0x6c756d69]

static TYPE_STRINGS: [u32; 8] = [0x58595a20, 0x64657363, 0x74657874, 0x6d6c7563, 0x70617261, 0x63757276, 0x73663332, 0x67626420]

fn tag_string(i: usize) -> u32 {
    return TAG_STRINGS[i]
}

fn type_string(i: usize) -> u32 {
    return TYPE_STRINGS[i]
}

fn be32_at(p: u64, size: usize, pos: usize) -> u32 {
    if pos + 4 > size {
        return 0
    }
    return ((rt.ld8(p, pos) as u32) << 24) | ((rt.ld8(p, pos + 1) as u32) << 16) | ((rt.ld8(p, pos + 2) as u32) << 8) | (rt.ld8(p, pos + 3) as u32)
}

fn push_be32(out: *mut rt.Buf, v: u32) {
    rt.buf_push(out, ((v >> 24) & 255) as u8)
    rt.buf_push(out, ((v >> 16) & 255) as u8)
    rt.buf_push(out, ((v >> 8) & 255) as u8)
    rt.buf_push(out, (v & 255) as u8)
}

fn put_be32(p: u64, pos: usize, v: u32) {
    rt.st8(p, pos, ((v >> 24) & 255) as u8)
    rt.st8(p, pos + 1, ((v >> 16) & 255) as u8)
    rt.st8(p, pos + 2, ((v >> 8) & 255) as u8)
    rt.st8(p, pos + 3, (v & 255) as u8)
}

fn read_varint(p: u64, size: usize, pos: *mut usize) -> u64 {
    var ret: u64 = 0
    var i: usize = 0
    while *pos + i < size && i < 10 {
        let v: u8 = rt.ld8(p, *pos + i)
        ret = ret | (((v & 127) as u64) << ((7 * i) as u64))
        if (v & 128) == 0 {
            break
        }
        i = i + 1
    }
    *pos = *pos + i + 1
    return ret
}

fn shuffle_bytes(data: u64, size: usize, width: usize) -> bool {
    let tmp: u64 = rt.heap_alloc(size + 1)
    if tmp == 0 {
        return false
    }
    let height: usize = (size + width - 1) / width
    var s: usize = 0
    var j: usize = 0
    var i: usize = 0
    while i < size {
        rt.st8(tmp, i, rt.ld8(data, j))
        j = j + height
        if j >= size {
            s = s + 1
            j = s
        }
        i = i + 1
    }
    rt.mem_copy(data, tmp, size)
    rt.heap_free(tmp, size + 1)
    return true
}

fn predict_value(p1: u32, p2: u32, p3: u32, order: u32) -> u32 {
    if order == 0 {
        return p1
    }
    if order == 1 {
        return (2 as u32) *% p1 -% p2
    }
    if order == 2 {
        return (3 as u32) *% p1 -% (3 as u32) *% p2 +% p3
    }
    return 0
}

fn linear_predict(data: u64, start: usize, i: usize, stride: usize, width: usize, order: u32) -> u8 {
    let pos: usize = start + i
    if width == 1 {
        let p1: u32 = rt.ld8(data, pos - stride) as u32
        let p2: u32 = rt.ld8(data, pos - stride * 2) as u32
        let p3: u32 = rt.ld8(data, pos - stride * 3) as u32
        return (predict_value(p1, p2, p3, order) & 255) as u8
    }
    if width == 2 {
        let p: usize = start + (i - (i & 1))
        let p1: u32 = ((rt.ld8(data, p - stride) as u32) << 8) + (rt.ld8(data, p - stride + 1) as u32)
        let p2: u32 = ((rt.ld8(data, p - stride * 2) as u32) << 8) + (rt.ld8(data, p - stride * 2 + 1) as u32)
        let p3: u32 = ((rt.ld8(data, p - stride * 3) as u32) << 8) + (rt.ld8(data, p - stride * 3 + 1) as u32)
        let pred: u32 = predict_value(p1, p2, p3, order) & 65535
        if (i & 1) == 1 {
            return (pred & 255) as u8
        }
        return ((pred >> 8) & 255) as u8
    }
    let p: usize = start + (i - (i & 3))
    let p1: u32 = be32_at(data, pos, p - stride)
    let p2: u32 = be32_at(data, pos, p - stride * 2)
    let p3: u32 = be32_at(data, pos, p - stride * 3)
    let pred: u32 = predict_value(p1, p2, p3, order)
    let shift: u32 = ((3 - (i & 3)) * 8) as u32
    return ((pred >> shift) & 255) as u8
}

fn initial_header(h: *mut rt.Buf) {
    rt.buf_clear(h)
    var i: usize = 0
    while i < HEADER_SIZE {
        rt.buf_push(h, 0 as u8)
        i = i + 1
    }
    let p: u64 = rt.buf_ptr(h)
    rt.st8(p, 8, 4 as u8)
    put_be32(p, 12, TAG_MNTR)
    put_be32(p, 16, TAG_RGB)
    put_be32(p, 20, TAG_XYZ_TYPE)
    put_be32(p, 36, TAG_ACSP)
    rt.st8(p, 70, 246 as u8)
    rt.st8(p, 71, 214 as u8)
    rt.st8(p, 73, 1 as u8)
    rt.st8(p, 78, 211 as u8)
    rt.st8(p, 79, 45 as u8)
}

fn predict_header(icc: u64, size: usize, header: u64, pos: usize) {
    if pos == 8 && size >= 8 {
        rt.st8(header, 80, rt.ld8(icc, 4))
        rt.st8(header, 81, rt.ld8(icc, 5))
        rt.st8(header, 82, rt.ld8(icc, 6))
        rt.st8(header, 83, rt.ld8(icc, 7))
    }
    if pos == 41 && size >= 41 {
        let c: u8 = rt.ld8(icc, 40)
        if c == 65 as u8 {
            rt.st8(header, 41, 80 as u8)
            rt.st8(header, 42, 80 as u8)
            rt.st8(header, 43, 76 as u8)
        }
        if c == 77 as u8 {
            rt.st8(header, 41, 83 as u8)
            rt.st8(header, 42, 70 as u8)
            rt.st8(header, 43, 84 as u8)
        }
    }
    if pos == 42 && size >= 42 {
        let c0: u8 = rt.ld8(icc, 40)
        let c1: u8 = rt.ld8(icc, 41)
        if c0 == 83 as u8 && c1 == 71 as u8 {
            rt.st8(header, 42, 73 as u8)
            rt.st8(header, 43, 32 as u8)
        }
        if c0 == 83 as u8 && c1 == 85 as u8 {
            rt.st8(header, 42, 78 as u8)
            rt.st8(header, 43, 87 as u8)
        }
    }
}

fn byte_kind1(b: u32) -> u32 {
    if (b >= 97 && b <= 122) || (b >= 65 && b <= 90) {
        return 0
    }
    if (b >= 48 && b <= 57) || b == 46 || b == 44 {
        return 1
    }
    if b == 0 {
        return 2
    }
    if b == 1 {
        return 3
    }
    if b < 16 {
        return 4
    }
    if b == 255 {
        return 6
    }
    if b > 240 {
        return 5
    }
    return 7
}

fn byte_kind2(b: u32) -> u32 {
    if (b >= 97 && b <= 122) || (b >= 65 && b <= 90) {
        return 0
    }
    if (b >= 48 && b <= 57) || b == 46 || b == 44 {
        return 1
    }
    if b < 16 {
        return 2
    }
    if b > 240 {
        return 3
    }
    return 4
}

fn ans_context(i: usize, b1: u32, b2: u32) -> u32 {
    if i <= 128 {
        return 0
    }
    return 1 + byte_kind1(b1) + byte_kind2(b2) * 8
}
