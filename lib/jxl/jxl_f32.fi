// lib/jxl/jxl_f32.fi -- jxl_f32: single-precision emulation helpers matching libjxl SIMD arithmetic
export { round32, fma32, nearest_int, fast_erff }

fn round32(v: f64) -> f64 {
    return (v as f32) as f64
}

fn fma32(a: f64, b: f64, c: f64) -> f64 {
    return round32(a * b + c)
}

fn nearest_int(v: f64) -> i64 {
    let t: i64 = v as i64
    let f: f64 = v - (t as f64)
    if f > 0.5 {
        return t + 1
    }
    if f == 0.5 {
        return t + (t & 1)
    }
    return t
}

fn fast_erff(x: f64) -> f64 {
    var a: f64 = x
    if a < 0.0 {
        a = -a
    }
    var d: f64 = fma32(a, round32(7.77394369e-02), round32(2.05260015e-04))
    d = fma32(d, a, round32(2.32120216e-01))
    d = fma32(d, a, round32(2.77820801e-01))
    d = fma32(d, a, 1.0)
    let d5: f64 = round32(d * d)
    let inv: f64 = round32(1.0 / d5)
    let r: f64 = fma32(-inv, inv, 1.0)
    if x <= 0.0 {
        return -r
    }
    return r
}
