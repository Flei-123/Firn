// lib/jxl/jxl_fastmath.fi -- jxl_fastmath: libjxl FastLog2f/FastPow2f/FastPowf and x86 rcpps emulation in exact f32 arithmetic
import jxl.jxl_f32
import jxl.jxl_rcptab
import std.core

export { fast_log2f, fast_pow2f, fast_powf, rcp_approx }

fn fast_log2f(x: f64) -> f64 {
    let bits: i64 = core.f32_bits(x as f32) as i64
    let exp_bits: i64 = bits - 1059760811
    let exp_shifted: i64 = exp_bits >> 23
    let mant_bits: i64 = bits - (exp_shifted << 23)
    let mant: f64 = core.bits_f32(mant_bits as u32) as f64
    let t: f64 = jxl_f32.round32(mant - 1.0)
    var yp: f64 = jxl_f32.round32(0.7424587332782057)
    var yq: f64 = jxl_f32.round32(0.1740934300336685)
    yp = jxl_f32.fma32(yp, t, jxl_f32.round32(1.4287160470083755))
    yq = jxl_f32.fma32(yq, t, jxl_f32.round32(1.0096718572241148))
    yp = jxl_f32.fma32(yp, t, jxl_f32.round32(-0.000001850383340051831))
    yq = jxl_f32.fma32(yq, t, jxl_f32.round32(0.9903281427759072))
    return jxl_f32.round32(jxl_f32.round32(yp / yq) + (exp_shifted as f64))
}

fn floor_f(x: f64) -> f64 {
    let t: i64 = x as i64
    var f: f64 = t as f64
    if f > x {
        f = f - 1.0
    }
    return f
}

fn fast_pow2f(x: f64) -> f64 {
    let fl: f64 = floor_f(x)
    let ebits: i64 = ((fl as i64) + 127) << 23
    let e: f64 = core.bits_f32(ebits as u32) as f64
    let frac: f64 = jxl_f32.round32(x - fl)
    var num: f64 = jxl_f32.round32(frac + jxl_f32.round32(10.1749063))
    num = jxl_f32.fma32(num, frac, jxl_f32.round32(48.8687798))
    num = jxl_f32.fma32(num, frac, jxl_f32.round32(98.5506591))
    num = jxl_f32.round32(num * e)
    var den: f64 = jxl_f32.fma32(frac, jxl_f32.round32(0.210242958), jxl_f32.round32(-0.0222328856))
    den = jxl_f32.fma32(den, frac, jxl_f32.round32(-19.441499))
    den = jxl_f32.fma32(den, frac, jxl_f32.round32(98.5506633))
    return jxl_f32.round32(num / den)
}

fn fast_powf(base: f64, e: f64) -> f64 {
    return fast_pow2f(jxl_f32.round32(fast_log2f(base) * e))
}

fn rcp_approx(x: f64) -> f64 {
    let bits: u32 = core.f32_bits(x as f32)
    let sign: u32 = bits & 2147483648
    let ex: u32 = (bits >> 23) & 255
    let k: usize = ((bits >> 11) & 4095) as usize
    let rb: u32 = ((253 - ex) << 23) | (jxl_rcptab.rcp_table_get(k) << 11) | sign
    return core.bits_f32(rb) as f64
}
