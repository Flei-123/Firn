export { ACS_COUNT, ACS_INVALID, ACS_FIRST, acs_valid_type, acs_cover_x, acs_cover_y, acs_order, acs_log2_blocks }

const ACS_COUNT: u32 = 27
const ACS_INVALID: u8 = 255
const ACS_FIRST: u8 = 128

static COVER_X: [u8; 27] = [1, 1, 1, 1, 2, 4, 1, 2, 1, 4, 2, 4, 1, 1, 1, 1, 1, 1, 8, 4, 8, 16, 8, 16, 32, 16, 32]
static COVER_Y: [u8; 27] = [1, 1, 1, 1, 2, 4, 2, 1, 4, 1, 4, 2, 1, 1, 1, 1, 1, 1, 8, 8, 4, 16, 16, 8, 32, 32, 16]

static ORDER_OF: [u8; 27] = [0, 1, 1, 1, 2, 3, 4, 4, 5, 5, 6, 6, 1, 1, 1, 1, 1, 1, 7, 8, 8, 9, 10, 10, 11, 12, 12]

fn acs_valid_type(t: i32) -> bool {
    return t >= 0 && t < (ACS_COUNT as i32)
}

fn acs_cover_x(t: u32) -> usize {
    return COVER_X[t as usize] as usize
}

fn acs_cover_y(t: u32) -> usize {
    return COVER_Y[t as usize] as usize
}

fn acs_order(t: u32) -> usize {
    return ORDER_OF[t as usize] as usize
}

fn acs_log2_blocks(t: u32) -> u32 {
    var n: usize = acs_cover_x(t) * acs_cover_y(t)
    var r: u32 = 0
    while n > 1 {
        n = n >> 1
        r = r + 1
    }
    return r
}
