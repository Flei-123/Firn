// SPDX-License-Identifier: MPL-2.0
import jxl.jxl_f32
import jxl.jxl_idct32
import std.rt

export { dct32_2d }

fn fld(p: u64, i: usize) -> f64 {
    return *((p +% ((i * 8) as u64)) as *mut f64)
}

fn fst(p: u64, i: usize, v: f64) {
    *((p +% ((i * 8) as u64)) as *mut f64) = v
}

fn dct_1d(buf: u64, n: usize, scratch: u64) {
    if n == 1 {
        return
    }
    if n == 2 {
        let a: f64 = fld(buf, 0)
        let b: f64 = fld(buf, 1)
        fst(buf, 0, jxl_f32.round32(a + b))
        fst(buf, 1, jxl_f32.round32(a - b))
        return
    }
    let h: usize = n / 2
    let next: u64 = scratch +% ((n * 8) as u64)
    let hi: u64 = scratch +% ((h * 8) as u64)
    var i: usize = 0
    while i < h {
        fst(scratch, i, jxl_f32.round32(fld(buf, i) + fld(buf, n - 1 - i)))
        i = i + 1
    }
    dct_1d(scratch, h, next)
    i = 0
    while i < h {
        fst(hi, i, jxl_f32.round32(jxl_f32.round32(fld(buf, i) - fld(buf, n - 1 - i)) * jxl_idct32.wc_mult(n, i)))
        i = i + 1
    }
    dct_1d(hi, h, next)
    fst(hi, 0, jxl_f32.fma32(fld(hi, 0), jxl_f32.round32(1.41421356237), fld(hi, 1)))
    i = 1
    while i + 1 < h {
        fst(hi, i, jxl_f32.round32(fld(hi, i) + fld(hi, i + 1)))
        i = i + 1
    }
    i = 0
    while i < h {
        fst(buf, 2 * i, fld(scratch, i))
        fst(buf, 2 * i + 1, fld(scratch, h + i))
        i = i + 1
    }
}

fn dct32_2d(rows: usize, cols: usize, inp: u64, out: u64) -> bool {
    var mx: usize = rows
    if cols > mx {
        mx = cols
    }
    let col: u64 = rt.heap_alloc(mx * 8)
    let scratch: u64 = rt.heap_alloc(mx * 8 * 4 + 64)
    if col == 0 || scratch == 0 {
        return false
    }
    var x: usize = 0
    while x < cols {
        var y: usize = 0
        while y < rows {
            fst(col, y, fld(inp, y * cols + x))
            y = y + 1
        }
        dct_1d(col, rows, scratch)
        y = 0
        while y < rows {
            fst(out, y * cols + x, jxl_f32.round32(fld(col, y) * (1.0 / (rows as f64))))
            y = y + 1
        }
        x = x + 1
    }
    var y2: usize = 0
    while y2 < rows {
        var x2: usize = 0
        while x2 < cols {
            fst(col, x2, fld(out, y2 * cols + x2))
            x2 = x2 + 1
        }
        dct_1d(col, cols, scratch)
        x2 = 0
        while x2 < cols {
            fst(out, y2 * cols + x2, jxl_f32.round32(fld(col, x2) * (1.0 / (cols as f64))))
            x2 = x2 + 1
        }
        y2 = y2 + 1
    }
    rt.heap_free(col, mx * 8)
    rt.heap_free(scratch, mx * 8 * 4 + 64)
    return true
}
