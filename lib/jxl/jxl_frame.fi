// lib/jxl/jxl_frame.fi -- jxl_frame: JPEG XL frame header and table of contents
import std.rt
import std.vec
import jxl.jxl_bits
import jxl.jxl_code
import jxl.jxl_mem
import jxl.jxl_perm
import jxl.jxl_err
import jxl.jxl_header
import jxl.jxl_loopf

export {
    JxlFrame, jf_new, jf_free, jf_read, jf_read_toc, jf_section_offset, jf_section_size, jf_pass_min_shift, jf_pass_max_shift, jf_pass_shift, jf_visible,
    JF_FLAG_NOISE, JF_FLAG_PATCHES, JF_FLAG_SPLINES, JF_FLAG_USE_LF, JF_REGULAR, JF_MODULAR, JF_VARDCT,
}

const JF_FLAG_NOISE: u64 = 1
const JF_FLAG_PATCHES: u64 = 2
const JF_FLAG_SPLINES: u64 = 16
const JF_FLAG_USE_LF: u64 = 32
const JF_REGULAR: u32 = 0
const JF_VARDCT: u32 = 0
const JF_MODULAR: u32 = 1

struct JxlFrame {
    frame_type: u32,
    encoding: u32,
    flags: u64,
    do_ycbcr: bool,
    upsampling: u32,
    group_shift: u32,
    num_passes: u32,
    x0: i32,
    y0: i32,
    width: u32,
    height: u32,
    full_w: u32,
    full_h: u32,
    dc_level: u32,
    is_last: bool,
    group_dim: u32,
    groups_x: u32,
    groups_y: u32,
    num_groups: u32,
    lf_groups_x: u32,
    lf_groups_y: u32,
    num_lf_groups: u32,
    blend_mode: u32,
    duration: u32,
    save_slot: u32,
    save_before_ct: bool,
    toc_count: usize,
    toc: u64,
    permuted: bool,
    body_start: usize,
    perm: u64,
    brk: u64,
    ec_upsampled: bool,
    dl: u64,
    nds: u32,
    offs: u64,
    x_qm_scale: u32,
    b_qm_scale: u32,
    lf: jxl_loopf.JxlLoopFilter,
}

fn jf_new() -> JxlFrame {
    return JxlFrame { frame_type: 0, encoding: 0, flags: 0, do_ycbcr: false, upsampling: 1, group_shift: 1,
        num_passes: 1, x0: 0, y0: 0, width: 0, height: 0, full_w: 0, full_h: 0, dc_level: 0, is_last: true, group_dim: 256, groups_x: 0, groups_y: 0,
        num_groups: 0, lf_groups_x: 0, lf_groups_y: 0, num_lf_groups: 0, blend_mode: 0, duration: 0, save_slot: 0, save_before_ct: false, toc_count: 0,
        toc: 0, permuted: false, body_start: 0, perm: 0, brk: 0, ec_upsampled: false, dl: 0, nds: 0, offs: 0,
        x_qm_scale: 2, b_qm_scale: 2, lf: jxl_loopf.loopf_default() }
}

fn jf_free(f: *mut JxlFrame) {
    rt.heap_free((*f).toc, (*f).toc_count * 4)
    rt.heap_free((*f).offs, ((*f).toc_count + 1) * 8)
    (*f).offs = 0
    rt.heap_free((*f).perm, (*f).toc_count * 4)
    rt.heap_free((*f).brk, ((*f).num_passes as usize) * 8)
    rt.heap_free((*f).dl, 80)
    (*f).dl = 0
    (*f).toc = 0
    (*f).perm = 0
    (*f).brk = 0
    (*f).toc_count = 0
}

fn div_ceil(a: u32, b: u32) -> u32 {
    return (a + b - 1) / b
}

fn read_dim(b: *mut jxl_bits.JxlBits) -> u32 {
    return jxl_bits.jb_u32(b, jxl_bits.jd_bits(8), jxl_bits.jd_off(11, 256), jxl_bits.jd_off(14, 2304), jxl_bits.jd_off(30, 18688))
}

fn read_blending(b: *mut jxl_bits.JxlBits, num_extra: usize, mode_out: *mut u32) {
    let mode: u32 = jxl_bits.jb_u32(b, jxl_bits.jd_val(0), jxl_bits.jd_val(1), jxl_bits.jd_val(2), jxl_bits.jd_off(2, 3))
    if num_extra > 0 && (mode == 2 || mode == 3) {
        jxl_bits.jb_u32(b, jxl_bits.jd_val(0), jxl_bits.jd_val(1), jxl_bits.jd_val(2), jxl_bits.jd_off(3, 3))
        jxl_bits.jb_bit(b)
    } else if mode == 4 {
        jxl_bits.jb_bit(b)
    }
    if mode != 0 {
        jxl_bits.jb_read(b, 2)
    }
    *mode_out = mode
}

fn jf_pass_min_shift(f: *mut JxlFrame, pass: u32) -> i32 {
    return jxl_mem.ldi((*f).brk, (pass as usize) * 2)
}

fn jf_pass_max_shift(f: *mut JxlFrame, pass: u32) -> i32 {
    return jxl_mem.ldi((*f).brk, (pass as usize) * 2 + 1)
}

fn jf_pass_shift(f: *mut JxlFrame, pass: u32) -> u32 {
    if (*f).dl == 0 || pass + 1 >= (*f).num_passes {
        return 0
    }
    return rt.ld32((*f).dl, 8 + pass as usize)
}

fn fill_brackets(f: *mut JxlFrame, nds: u32) -> bool {
    let np: u32 = (*f).num_passes
    (*f).brk = rt.heap_alloc((np as usize) * 8)
    if (*f).brk == 0 {
        return false
    }
    var pass: u32 = 0
    while pass < np {
        var max_shift: i32 = 2
        var min_shift: i32 = 3
        var i: u32 = 0
        var done: bool = false
        while !done {
            var j: u32 = 0
            while j < nds {
                if i == rt.ld32((*f).dl, 4 + j as usize) {
                    let d: u32 = rt.ld32((*f).dl, j as usize)
                    if d == 8 {
                        min_shift = 3
                    }
                    if d == 4 {
                        min_shift = 2
                    }
                    if d == 2 {
                        min_shift = 1
                    }
                    if d == 1 {
                        min_shift = 0
                    }
                }
                j = j + 1
            }
            if i + 1 == np {
                min_shift = 0
            }
            if i == pass {
                done = true
            } else {
                max_shift = min_shift - 1
                i = i + 1
            }
        }
        jxl_mem.sti((*f).brk, (pass as usize) * 2, min_shift)
        jxl_mem.sti((*f).brk, (pass as usize) * 2 + 1, max_shift)
        pass = pass + 1
    }
    return true
}

fn jf_read(b: *mut jxl_bits.JxlBits, m: *mut jxl_header.JxlMeta, f: *mut JxlFrame) -> i32 {
    *f = jf_new()
    let num_extra: usize = vec.vec_len[jxl_header.JxlExtra](&(*m).extra)
    (*f).width = (*m).width
    (*f).height = (*m).height
    if jxl_bits.jb_bit(b) {
        (*f).group_dim = 256
        (*f).is_last = true
        if (*m).xyb_encoded {
            (*f).x_qm_scale = 3
        }
    } else {
        (*f).frame_type = jxl_bits.jb_read(b, 2)
        (*f).encoding = jxl_bits.jb_read(b, 1)
        (*f).flags = jxl_bits.jb_u64(b)
        if !(*m).xyb_encoded {
            (*f).do_ycbcr = jxl_bits.jb_bit(b)
        }
        if ((*f).flags & JF_FLAG_USE_LF) == 0 {
            if (*f).do_ycbcr {
                jxl_bits.jb_read(b, 6)
            }
            (*f).upsampling = jxl_bits.jb_u32(b, jxl_bits.jd_val(1), jxl_bits.jd_val(2), jxl_bits.jd_val(4), jxl_bits.jd_val(8))
            var e: usize = 0
            while e < num_extra {
                if jxl_bits.jb_u32(b, jxl_bits.jd_val(1), jxl_bits.jd_val(2), jxl_bits.jd_val(4), jxl_bits.jd_val(8)) != (*f).upsampling {
                    (*f).ec_upsampled = true
                }
                e = e + 1
            }
        }
        if (*f).encoding == JF_MODULAR {
            (*f).group_shift = jxl_bits.jb_read(b, 2)
        }
        if (*f).encoding == JF_VARDCT && (*m).xyb_encoded {
            (*f).x_qm_scale = jxl_bits.jb_read(b, 3)
            (*f).b_qm_scale = jxl_bits.jb_read(b, 3)
        }
        if (*f).frame_type != 2 {
            (*f).num_passes = jxl_bits.jb_u32(b, jxl_bits.jd_val(1), jxl_bits.jd_val(2), jxl_bits.jd_val(3), jxl_bits.jd_off(3, 4))
            if (*f).num_passes > 11 {
                return jxl_err.JX_BAD
            }
            (*f).dl = rt.heap_alloc(80)
            if (*f).dl == 0 {
                return jxl_err.JX_MEMORY
            }
            rt.mem_set((*f).dl, 0 as u8, 80)
            if (*f).num_passes != 1 {
                let nds: u32 = jxl_bits.jb_u32(b, jxl_bits.jd_val(0), jxl_bits.jd_val(1), jxl_bits.jd_val(2), jxl_bits.jd_off(1, 3))
                if nds > 4 || nds > (*f).num_passes {
                    return jxl_err.JX_BAD
                }
                (*f).nds = nds
                var i: u32 = 0
                while i + 1 < (*f).num_passes {
                    rt.st32((*f).dl, 8 + i as usize, jxl_bits.jb_read(b, 2))
                    i = i + 1
                }
                i = 0
                while i < nds {
                    let v: u32 = jxl_bits.jb_u32(b, jxl_bits.jd_val(1), jxl_bits.jd_val(2), jxl_bits.jd_val(4), jxl_bits.jd_val(8))
                    if i > 0 && v >= rt.ld32((*f).dl, (i - 1) as usize) {
                        return jxl_err.JX_BAD
                    }
                    rt.st32((*f).dl, i as usize, v)
                    i = i + 1
                }
                i = 0
                while i < nds {
                    let v: u32 = jxl_bits.jb_u32(b, jxl_bits.jd_val(0), jxl_bits.jd_val(1), jxl_bits.jd_val(2), jxl_bits.jd_bits(3))
                    if (i > 0 && v <= rt.ld32((*f).dl, 4 + (i - 1) as usize)) || v >= (*f).num_passes {
                        return jxl_err.JX_BAD
                    }
                    rt.st32((*f).dl, 4 + i as usize, v)
                    i = i + 1
                }
            }
        }
        if (*f).frame_type == 1 {
            (*f).dc_level = jxl_bits.jb_u32(b, jxl_bits.jd_val(1), jxl_bits.jd_val(2), jxl_bits.jd_val(3), jxl_bits.jd_val(4))
        }
        if (*f).frame_type != 1 {
            if jxl_bits.jb_bit(b) {
                if (*f).frame_type != 2 {
                    (*f).x0 = jxl_bits.jb_signed(read_dim(b))
                    (*f).y0 = jxl_bits.jb_signed(read_dim(b))
                }
                (*f).width = read_dim(b)
                (*f).height = read_dim(b)
            }
        }
        if (*f).frame_type == 0 || (*f).frame_type == 3 {
            read_blending(b, num_extra, &(*f).blend_mode)
            var e: usize = 0
            var dummy: u32 = 0
            while e < num_extra {
                read_blending(b, num_extra, &dummy)
                e = e + 1
            }
            if (*m).have_animation {
                (*f).duration = jxl_bits.jb_u32(b, jxl_bits.jd_val(0), jxl_bits.jd_val(1), jxl_bits.jd_bits(8), jxl_bits.jd_bits(32))
                if (*m).have_timecodes {
                    jxl_bits.jb_read(b, 32)
                }
            }
            if (*f).frame_type == 0 {
                (*f).is_last = jxl_bits.jb_bit(b)
            } else {
                (*f).is_last = false
            }
        } else {
            (*f).is_last = false
        }
        if !(*f).is_last && (*f).frame_type != 1 {
            (*f).save_slot = jxl_bits.jb_read(b, 2)
        }
        if (*f).frame_type == 2 {
            (*f).save_before_ct = jxl_bits.jb_bit(b)
        }
        let name_len: u32 = jxl_bits.jb_u32(b, jxl_bits.jd_val(0), jxl_bits.jd_bits(4), jxl_bits.jd_off(5, 16), jxl_bits.jd_off(10, 48))
        jxl_bits.jb_skip_bits(b, name_len as u64 * 8)
        let lr: i32 = jxl_loopf.loopf_read(b, (*f).encoding == JF_MODULAR, &(*f).lf)
        if lr != jxl_err.JX_OK {
            return lr
        }
        jxl_loopf.loopf_skip_extensions(b)
    }
    if jxl_bits.jb_over(b) {
        return jxl_err.JX_TRUNCATED
    }
    if !fill_brackets(f, (*f).nds) {
        return jxl_err.JX_MEMORY
    }
    if (*f).frame_type == 1 {
        if (*f).dc_level > 4 {
            return jxl_err.JX_BAD
        }
        (*f).width = div_ceil((*f).width, (1 as u32) << (3 * (*f).dc_level))
        (*f).height = div_ceil((*f).height, (1 as u32) << (3 * (*f).dc_level))
    }
    (*f).full_w = (*f).width
    (*f).full_h = (*f).height
    if (*f).upsampling != 1 {
        (*f).width = div_ceil((*f).width, (*f).upsampling)
        (*f).height = div_ceil((*f).height, (*f).upsampling)
    }
    (*f).group_dim = (128 as u32) << (*f).group_shift
    (*f).groups_x = div_ceil((*f).width, (*f).group_dim)
    (*f).groups_y = div_ceil((*f).height, (*f).group_dim)
    if ((*f).groups_x as u64) * ((*f).groups_y as u64) > 65536 {
        return jxl_err.JX_TOO_LARGE
    }
    (*f).num_groups = (*f).groups_x * (*f).groups_y
    (*f).lf_groups_x = div_ceil((*f).width, (*f).group_dim * 8)
    (*f).lf_groups_y = div_ceil((*f).height, (*f).group_dim * 8)
    (*f).num_lf_groups = (*f).lf_groups_x * (*f).lf_groups_y
    return jxl_err.JX_OK
}

fn jf_read_toc(b: *mut jxl_bits.JxlBits, f: *mut JxlFrame) -> i32 {
    var count: usize = 1
    if (*f).num_groups != 1 || (*f).num_passes != 1 {
        count = 2 + (*f).num_lf_groups as usize + ((*f).num_passes as usize) * ((*f).num_groups as usize)
    }
    if count > 65536 {
        return jxl_err.JX_TOO_LARGE
    }
    (*f).permuted = jxl_bits.jb_bit(b)
    (*f).toc_count = count
    if (*f).permuted {
        (*f).perm = rt.heap_alloc(count * 4)
        if (*f).perm == 0 {
            return jxl_err.JX_MEMORY
        }
        let pr: i32 = jxl_perm.perm_read(b, count, (*f).perm)
        if pr != jxl_err.JX_OK {
            return pr
        }
    }
    if !jxl_bits.jb_zero_pad(b) {
        return jxl_err.JX_BAD
    }
    (*f).toc = rt.heap_alloc(count * 4)
    if (*f).toc == 0 {
        return jxl_err.JX_MEMORY
    }
    var i: usize = 0
    while i < count {
        let v: u32 = jxl_bits.jb_u32(b, jxl_bits.jd_bits(10), jxl_bits.jd_off(14, 1024), jxl_bits.jd_off(22, 17408), jxl_bits.jd_off(30, 4211712))
        rt.st32((*f).toc, i, v)
        i = i + 1
    }
    if !jxl_bits.jb_zero_pad(b) || jxl_bits.jb_over(b) {
        return jxl_err.JX_BAD
    }
    (*f).offs = rt.heap_alloc((count + 1) * 8)
    if (*f).offs == 0 {
        return jxl_err.JX_MEMORY
    }
    var acc: u64 = 0
    i = 0
    while i < count {
        rt.st64((*f).offs, i, acc)
        acc = acc + (rt.ld32((*f).toc, i) as u64)
        i = i + 1
    }
    rt.st64((*f).offs, count, acc)
    (*f).body_start = jxl_bits.jb_byte_pos(b)
    return jxl_err.JX_OK
}

fn phys_index(f: *mut JxlFrame, i: usize) -> usize {
    if (*f).perm == 0 {
        return i
    }
    return rt.ld32((*f).perm, i) as usize
}

fn jf_section_size(f: *mut JxlFrame, i: usize) -> usize {
    return rt.ld32((*f).toc, phys_index(f, i)) as usize
}

fn jf_section_offset(f: *mut JxlFrame, i: usize) -> usize {
    return (*f).body_start + (rt.ld64((*f).offs, phys_index(f, i)) as usize)
}

fn jf_visible(f: *mut JxlFrame) -> bool {
    return ((*f).is_last || (*f).duration > 0) && ((*f).frame_type == JF_REGULAR || (*f).frame_type == 3)
}
