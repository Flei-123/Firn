// SPDX-License-Identifier: MPL-2.0
import std.vec
import jxl.jxl_acs

export {
    JxlLfData, lfd_new, lfd_init, lfd_free, lfd_dc_set, lfd_dc_get, lfd_acs_valid, lfd_acs_type, lfd_acs_is_first, lfd_acs_set,
    lfd_idx, lfd_tile_idx, lfd_prepare_coefs,
}

struct JxlLfData {
    bw: usize,
    bh: usize,
    tw: usize,
    th: usize,
    dc: vec.Vec[f64],
    qdc: vec.Vec[u8],
    acs: vec.Vec[u8],
    qf: vec.Vec[i32],
    epf: vec.Vec[u8],
    ytox: vec.Vec[i32],
    ytob: vec.Vec[i32],
    used_acs: u32,
    qoff: vec.Vec[u32],
    coefs: vec.Vec[i32],
    coef_stride: usize,
}

fn lfd_new() -> JxlLfData {
    return JxlLfData { bw: 0, bh: 0, tw: 0, th: 0, dc: vec.vec_new[f64](), qdc: vec.vec_new[u8](), acs: vec.vec_new[u8](),
        qf: vec.vec_new[i32](), epf: vec.vec_new[u8](), ytox: vec.vec_new[i32](), ytob: vec.vec_new[i32](), used_acs: 0, qoff: vec.vec_new[u32](), coefs: vec.vec_new[i32](), coef_stride: 0 }
}

fn sized[T](v: *mut vec.Vec[T], n: usize, value: T) -> bool {
    if !vec.vec_reserve[T](v, n) {
        return false
    }
    var i: usize = 0
    while i < n {
        if !vec.vec_push[T](v, value) {
            return false
        }
        i = i + 1
    }
    return true
}

fn lfd_init(d: *mut JxlLfData, width: usize, height: usize) -> bool {
    (*d).bw = (width + 7) / 8
    (*d).bh = (height + 7) / 8
    (*d).tw = ((*d).bw + 7) / 8
    (*d).th = ((*d).bh + 7) / 8
    let nb: usize = (*d).bw * (*d).bh
    let nt: usize = (*d).tw * (*d).th
    return sized[f64](&(*d).dc, nb * 3, 0.0) && sized[u8](&(*d).qdc, nb, 0 as u8) && sized[u8](&(*d).acs, nb, jxl_acs.ACS_INVALID)
        && sized[i32](&(*d).qf, nb, 0) && sized[u8](&(*d).epf, nb, 0 as u8) && sized[i32](&(*d).ytox, nt, 0) && sized[i32](&(*d).ytob, nt, 0) && sized[u32](&(*d).qoff, nb, 0 as u32)
}

fn lfd_free(d: *mut JxlLfData) {
    vec.vec_free[f64](&(*d).dc)
    vec.vec_free[u8](&(*d).qdc)
    vec.vec_free[u8](&(*d).acs)
    vec.vec_free[i32](&(*d).qf)
    vec.vec_free[u8](&(*d).epf)
    vec.vec_free[i32](&(*d).ytox)
    vec.vec_free[i32](&(*d).ytob)
    vec.vec_free[u32](&(*d).qoff)
    vec.vec_free[i32](&(*d).coefs)
}

fn lfd_idx(d: *mut JxlLfData, x: usize, y: usize) -> usize {
    return y * (*d).bw + x
}

fn lfd_tile_idx(d: *mut JxlLfData, tx: usize, ty: usize) -> usize {
    return ty * (*d).tw + tx
}

fn lfd_dc_set(d: *mut JxlLfData, c: usize, x: usize, y: usize, v: f64) {
    *vec.vec_elem_ptr[f64](&(*d).dc, c * (*d).bw * (*d).bh + lfd_idx(d, x, y)) = v
}

fn lfd_dc_get(d: *mut JxlLfData, c: usize, x: usize, y: usize) -> f64 {
    return *vec.vec_elem_ptr[f64](&(*d).dc, c * (*d).bw * (*d).bh + lfd_idx(d, x, y))
}

fn lfd_acs_valid(d: *mut JxlLfData, x: usize, y: usize) -> bool {
    return vec.vec_at[u8](&(*d).acs, lfd_idx(d, x, y)) != jxl_acs.ACS_INVALID
}

fn lfd_acs_type(d: *mut JxlLfData, x: usize, y: usize) -> u32 {
    return (vec.vec_at[u8](&(*d).acs, lfd_idx(d, x, y)) & 127) as u32
}

fn lfd_acs_is_first(d: *mut JxlLfData, x: usize, y: usize) -> bool {
    let v: u8 = vec.vec_at[u8](&(*d).acs, lfd_idx(d, x, y))
    return v != jxl_acs.ACS_INVALID && (v & jxl_acs.ACS_FIRST) != 0
}

fn lfd_acs_set(d: *mut JxlLfData, x: usize, y: usize, t: u32) {
    (*d).used_acs = (*d).used_acs | ((1 as u32) << t)
    let cx: usize = jxl_acs.acs_cover_x(t)
    let cy: usize = jxl_acs.acs_cover_y(t)
    var j: usize = 0
    while j < cy {
        var i: usize = 0
        while i < cx {
            var v: u8 = t as u8
            if i == 0 && j == 0 {
                v = v | jxl_acs.ACS_FIRST
            }
            vec.vec_set[u8](&(*d).acs, lfd_idx(d, x + i, y + j), v)
            i = i + 1
        }
        j = j + 1
    }
}

fn lfd_prepare_coefs(d: *mut JxlLfData) -> bool {
    let nb: usize = (*d).bw * (*d).bh
    (*d).coef_stride = nb * 64
    vec.vec_free[i32](&(*d).coefs)
    (*d).coefs = vec.vec_new[i32]()
    if !sized[i32](&(*d).coefs, nb * 192, 0) {
        return false
    }
    var off: u32 = 0
    var y: usize = 0
    while y < (*d).bh {
        var x: usize = 0
        while x < (*d).bw {
            if lfd_acs_is_first(d, x, y) {
                vec.vec_set[u32](&(*d).qoff, lfd_idx(d, x, y), off)
                off = off + ((jxl_acs.acs_cover_x(lfd_acs_type(d, x, y)) * jxl_acs.acs_cover_y(lfd_acs_type(d, x, y)) * 64) as u32)
            }
            x = x + 1
        }
        y = y + 1
    }
    return true
}
