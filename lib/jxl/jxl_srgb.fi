// SPDX-License-Identifier: MPL-2.0
// lib/jxl/jxl_srgb.fi -- jxl_srgb: sRGB transfer encoding with exact threshold table
import jxl.jxl_f32
import std.math
import std.rt

export { srgb_value, srgb_encode, srgb_table_new, srgb_table_free, srgb_table_encode, srgb_table_worthwhile }

fn horner(c0: f32, c1: f32, c2: f32, c3: f32, c4: f32, x: f64) -> f64 {
    var y: f64 = c4 as f64
    y = jxl_f32.round32(y * x + (c3 as f64))
    y = jxl_f32.round32(y * x + (c2 as f64))
    y = jxl_f32.round32(y * x + (c1 as f64))
    y = jxl_f32.round32(y * x + (c0 as f64))
    return y
}

fn srgb_value(v: f64) -> f64 {
    var l: f64 = v
    if l < 0.0 {
        l = 0.0
    }
    if l > 1.0 {
        l = 1.0
    }
    let x: f64 = jxl_f32.round32(l)
    if x > jxl_f32.round32(0.0031308) {
        let r: f64 = jxl_f32.round32(math.sqrt(x))
        let num: f64 = horner(-5.135152395e-04 as f32, 5.287254571e-03 as f32, 3.903842876e-01 as f32, 1.474205315e+00 as f32, 7.352629620e-01 as f32, r)
        let den: f64 = horner(1.004519624e-02 as f32, 3.036675394e-01 as f32, 1.340816930e+00 as f32, 9.258482155e-01 as f32, 2.424867759e-02 as f32, r)
        return jxl_f32.round32(num / den)
    }
    return jxl_f32.round32(x * jxl_f32.round32(12.92))
}

fn srgb_encode(v: f64, maxv: f64) -> i32 {
    var r: i64 = jxl_f32.nearest_int(jxl_f32.round32(srgb_value(v) * maxv))
    if r > (maxv as i64) {
        r = maxv as i64
    }
    return r as i32
}

fn srgb_table_worthwhile(pixels: usize, maxv: f64) -> bool {
    return pixels * 3 > (maxv as usize) * 62
}

fn srgb_table_new(maxv: f64) -> u64 {
    let n: usize = maxv as usize
    let t: u64 = rt.heap_alloc((n + 1) * 8)
    if t == 0 {
        return 0
    }
    var q: usize = 1
    while q <= n {
        var lo: u64 = 0
        var hi: u64 = math.math_bits(1.0)
        while hi - lo > 1 {
            let mid: u64 = lo + (hi - lo) / 2
            if srgb_encode(math.math_f64(mid), maxv) >= (q as i32) {
                hi = mid
            } else {
                lo = mid
            }
        }
        *((t +% ((q * 8) as u64)) as *mut f64) = math.math_f64(hi)
        q = q + 1
    }
    return t
}

fn srgb_table_free(t: u64, maxv: f64) {
    rt.heap_free(t, ((maxv as usize) + 1) * 8)
}

fn srgb_table_encode(t: u64, v: f64, maxv: f64) -> i32 {
    var l: f64 = v
    if l < 0.0 {
        l = 0.0
    }
    if l > 1.0 {
        l = 1.0
    }
    var lo: usize = 0
    var hi: usize = maxv as usize
    while lo < hi {
        let mid: usize = (lo + hi + 1) / 2
        if *((t +% ((mid * 8) as u64)) as *mut f64) <= l {
            lo = mid
        } else {
            hi = mid - 1
        }
    }
    if lo > 0 && l < *((t +% ((lo * 8) as u64)) as *mut f64) * (1.0 + 1e-5) {
        return srgb_encode(l, maxv)
    }
    if lo < (maxv as usize) && l > *((t +% (((lo + 1) * 8) as u64)) as *mut f64) * (1.0 - 1e-5) {
        return srgb_encode(l, maxv)
    }
    return lo as i32
}
