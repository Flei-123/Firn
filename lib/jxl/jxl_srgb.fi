// SPDX-License-Identifier: MPL-2.0
// lib/jxl/jxl_srgb.fi -- jxl_srgb: sRGB transfer encoding with exact threshold table
import std.math
import std.rt

export { srgb_encode, srgb_table_new, srgb_table_free, srgb_table_encode, srgb_table_worthwhile }

fn srgb_encode(v: f64, maxv: f64) -> i32 {
    var l: f64 = v
    if l < 0.0 {
        l = 0.0
    }
    if l > 1.0 {
        l = 1.0
    }
    var e: f64 = 12.92 * l
    if l > 0.0031308 {
        e = 1.055 * math.powf(l, 1.0 / 2.4) - 0.055
    }
    var r: i64 = (e * maxv + 0.5) as i64
    if r > (maxv as i64) {
        r = maxv as i64
    }
    return r as i32
}

fn srgb_table_worthwhile(pixels: usize, maxv: f64) -> bool {
    return pixels * 3 > (maxv as usize) * 62
}

fn srgb_table_new(maxv: f64) -> u64 {
    let n: usize = maxv as usize
    let t: u64 = rt.heap_alloc((n + 1) * 8)
    if t == 0 {
        return 0
    }
    var q: usize = 1
    while q <= n {
        var lo: u64 = 0
        var hi: u64 = math.math_bits(1.0)
        while hi - lo > 1 {
            let mid: u64 = lo + (hi - lo) / 2
            if srgb_encode(math.math_f64(mid), maxv) >= (q as i32) {
                hi = mid
            } else {
                lo = mid
            }
        }
        *((t +% ((q * 8) as u64)) as *mut f64) = math.math_f64(hi)
        q = q + 1
    }
    return t
}

fn srgb_table_free(t: u64, maxv: f64) {
    rt.heap_free(t, ((maxv as usize) + 1) * 8)
}

fn srgb_table_encode(t: u64, v: f64, maxv: f64) -> i32 {
    var l: f64 = v
    if l < 0.0 {
        l = 0.0
    }
    if l > 1.0 {
        l = 1.0
    }
    var lo: usize = 0
    var hi: usize = maxv as usize
    while lo < hi {
        let mid: usize = (lo + hi + 1) / 2
        if *((t +% ((mid * 8) as u64)) as *mut f64) <= l {
            lo = mid
        } else {
            hi = mid - 1
        }
    }
    return lo as i32
}
