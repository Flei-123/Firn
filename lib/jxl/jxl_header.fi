// SPDX-License-Identifier: MPL-2.0
// lib/jxl/jxl_header.fi -- jxl_header: SizeHeader, ImageMetadata, ColorEncoding, CustomTransformData of a JPEG XL codestream
import std.rt
import std.vec
import jxl.jxl_bits
import jxl.jxl_err

export {
    JxlBitDepth, JxlExtra, JxlColor, JxlMeta,
    jm_new, jm_free, jm_read, jm_extra, jm_color_channels, jm_alpha_index,
    jm_read_size, jm_read_custom_transform,
}

struct JxlBitDepth {
    is_float: bool,
    bits: u32,
    exp_bits: u32,
}

struct JxlExtra {
    kind: u32,
    depth: JxlBitDepth,
    dim_shift: u32,
    alpha_assoc: bool,
    cfa_channel: u32,
}

struct JxlColor {
    want_icc: bool,
    color_space: u32,
    white_point: u32,
    wx: i32,
    wy: i32,
    primaries: u32,
    rx: i32,
    ry: i32,
    gx: i32,
    gy: i32,
    bx: i32,
    by: i32,
    have_gamma: bool,
    gamma: u32,
    transfer: u32,
    intent: u32,
}

struct JxlMeta {
    width: u32,
    height: u32,
    orientation: u32,
    have_intrinsic: bool,
    intrinsic_w: u32,
    intrinsic_h: u32,
    have_preview: bool,
    preview_w: u32,
    preview_h: u32,
    have_animation: bool,
    tps_num: u32,
    tps_den: u32,
    loops: u32,
    have_timecodes: bool,
    depth: JxlBitDepth,
    modular_16bit: bool,
    extra: vec.Vec[JxlExtra],
    xyb_encoded: bool,
    color: JxlColor,
    intensity_target: f64,
    min_nits: f64,
    relative_to_max: bool,
    linear_below: f64,
    ct_default: bool,
    opsin: [f64; 16],
    has_opsin: bool,
    weights_mask: u32,
}

fn depth_default() -> JxlBitDepth {
    return JxlBitDepth { is_float: false, bits: 8, exp_bits: 0 }
}

fn color_default() -> JxlColor {
    return JxlColor { want_icc: false, color_space: 0, white_point: 1, wx: 0, wy: 0, primaries: 1,
        rx: 0, ry: 0, gx: 0, gy: 0, bx: 0, by: 0, have_gamma: false, gamma: 0, transfer: 13, intent: 1 }
}

fn jm_new() -> JxlMeta {
    return JxlMeta { width: 0, height: 0, orientation: 1, have_intrinsic: false, intrinsic_w: 0, intrinsic_h: 0,
        have_preview: false, preview_w: 0, preview_h: 0, have_animation: false, tps_num: 1, tps_den: 1,
        loops: 0, have_timecodes: false, depth: depth_default(), modular_16bit: true,
        extra: vec.vec_new[JxlExtra](), xyb_encoded: true, color: color_default(),
        intensity_target: 255.0, min_nits: 0.0, relative_to_max: false, linear_below: 0.0,
        ct_default: true, opsin: [0.0; 16], has_opsin: false, weights_mask: 0 }
}

fn jm_free(m: *mut JxlMeta) {
    vec.vec_free[JxlExtra](&(*m).extra)
}

fn jm_extra(m: *mut JxlMeta, i: usize) -> *mut JxlExtra {
    return vec.vec_elem_ptr[JxlExtra](&(*m).extra, i)
}

fn jm_color_channels(m: *mut JxlMeta) -> u32 {
    if (*m).color.color_space == 1 {
        return 1
    }
    return 3
}

fn jm_alpha_index(m: *mut JxlMeta) -> i32 {
    var i: usize = 0
    while i < vec.vec_len[JxlExtra](&(*m).extra) {
        if (*jm_extra(m, i)).kind == 0 {
            return i as i32
        }
        i = i + 1
    }
    return 0 - 1
}

fn ratio_width(h: u32, ratio: u32) -> u32 {
    let hh: u64 = h as u64
    if ratio == 1 { return h }
    if ratio == 2 { return (hh * 12 / 10) as u32 }
    if ratio == 3 { return (hh * 4 / 3) as u32 }
    if ratio == 4 { return (hh * 3 / 2) as u32 }
    if ratio == 5 { return (hh * 16 / 9) as u32 }
    if ratio == 6 { return (hh * 5 / 4) as u32 }
    return (hh * 2) as u32
}

fn jm_read_size(b: *mut jxl_bits.JxlBits, w: *mut u32, h: *mut u32) {
    let small: bool = jxl_bits.jb_bit(b)
    var ysize: u32 = 0
    if small {
        ysize = (jxl_bits.jb_read(b, 5) + 1) * 8
    } else {
        ysize = jxl_bits.jb_u32(b, jxl_bits.jd_off(9, 1), jxl_bits.jd_off(13, 1), jxl_bits.jd_off(18, 1), jxl_bits.jd_off(30, 1))
    }
    let ratio: u32 = jxl_bits.jb_read(b, 3)
    var xsize: u32 = 0
    if ratio == 0 {
        if small {
            xsize = (jxl_bits.jb_read(b, 5) + 1) * 8
        } else {
            xsize = jxl_bits.jb_u32(b, jxl_bits.jd_off(9, 1), jxl_bits.jd_off(13, 1), jxl_bits.jd_off(18, 1), jxl_bits.jd_off(30, 1))
        }
    } else {
        xsize = ratio_width(ysize, ratio)
    }
    *w = xsize
    *h = ysize
}

fn read_preview(b: *mut jxl_bits.JxlBits, m: *mut JxlMeta) {
    let div8: bool = jxl_bits.jb_bit(b)
    var ysize: u32 = 0
    if div8 {
        ysize = 8 * jxl_bits.jb_u32(b, jxl_bits.jd_val(16), jxl_bits.jd_val(32), jxl_bits.jd_off(5, 1), jxl_bits.jd_off(9, 33))
    } else {
        ysize = jxl_bits.jb_u32(b, jxl_bits.jd_off(6, 1), jxl_bits.jd_off(8, 65), jxl_bits.jd_off(10, 321), jxl_bits.jd_off(12, 1345))
    }
    let ratio: u32 = jxl_bits.jb_read(b, 3)
    var xsize: u32 = 0
    if ratio != 0 {
        xsize = ratio_width(ysize, ratio)
    } else if div8 {
        xsize = 8 * jxl_bits.jb_u32(b, jxl_bits.jd_val(16), jxl_bits.jd_val(32), jxl_bits.jd_off(5, 1), jxl_bits.jd_off(9, 33))
    } else {
        xsize = jxl_bits.jb_u32(b, jxl_bits.jd_off(6, 1), jxl_bits.jd_off(8, 65), jxl_bits.jd_off(10, 321), jxl_bits.jd_off(12, 1345))
    }
    (*m).preview_w = xsize
    (*m).preview_h = ysize
}

fn read_depth(b: *mut jxl_bits.JxlBits, d: *mut JxlBitDepth) -> i32 {
    (*d).is_float = jxl_bits.jb_bit(b)
    if !(*d).is_float {
        (*d).bits = jxl_bits.jb_u32(b, jxl_bits.jd_val(8), jxl_bits.jd_val(10), jxl_bits.jd_val(12), jxl_bits.jd_off(6, 1))
        (*d).exp_bits = 0
        if (*d).bits > 31 {
            return jxl_err.JX_BAD
        }
    } else {
        (*d).bits = jxl_bits.jb_u32(b, jxl_bits.jd_val(32), jxl_bits.jd_val(16), jxl_bits.jd_val(24), jxl_bits.jd_off(6, 1))
        (*d).exp_bits = jxl_bits.jb_read(b, 4) + 1
        if (*d).exp_bits < 2 || (*d).exp_bits > 8 {
            return jxl_err.JX_BAD
        }
        let mant: i32 = ((*d).bits as i32) - ((*d).exp_bits as i32) - 1
        if mant < 2 || mant > 23 {
            return jxl_err.JX_BAD
        }
    }
    return jxl_err.JX_OK
}

fn skip_name(b: *mut jxl_bits.JxlBits) {
    let len: u32 = jxl_bits.jb_u32(b, jxl_bits.jd_val(0), jxl_bits.jd_bits(4), jxl_bits.jd_off(5, 16), jxl_bits.jd_off(10, 48))
    jxl_bits.jb_skip_bits(b, (len as u64) * 8)
}

fn read_extra_channel(b: *mut jxl_bits.JxlBits, e: *mut JxlExtra) -> i32 {
    (*e).kind = 0
    (*e).depth = depth_default()
    (*e).dim_shift = 0
    (*e).alpha_assoc = false
    (*e).cfa_channel = 1
    if jxl_bits.jb_bit(b) {
        return jxl_err.JX_OK
    }
    (*e).kind = jxl_bits.jb_enum(b)
    let r: i32 = read_depth(b, &(*e).depth)
    if r != jxl_err.JX_OK {
        return r
    }
    (*e).dim_shift = jxl_bits.jb_u32(b, jxl_bits.jd_val(0), jxl_bits.jd_val(3), jxl_bits.jd_val(4), jxl_bits.jd_off(3, 1))
    if (*e).dim_shift > 3 {
        return jxl_err.JX_BAD
    }
    skip_name(b)
    if (*e).kind == 0 {
        (*e).alpha_assoc = jxl_bits.jb_bit(b)
    }
    if (*e).kind == 2 {
        var i: u32 = 0
        while i < 4 {
            jxl_bits.jb_f16(b)
            i = i + 1
        }
    }
    if (*e).kind == 5 {
        (*e).cfa_channel = jxl_bits.jb_u32(b, jxl_bits.jd_val(1), jxl_bits.jd_bits(2), jxl_bits.jd_off(4, 3), jxl_bits.jd_off(8, 19))
    }
    if (*e).kind >= 7 && (*e).kind <= 15 {
        return jxl_err.JX_UNSUPPORTED
    }
    if (*e).kind > 16 {
        return jxl_err.JX_BAD
    }
    return jxl_err.JX_OK
}

fn read_xy(b: *mut jxl_bits.JxlBits, x: *mut i32, y: *mut i32) {
    let ux: u32 = jxl_bits.jb_u32(b, jxl_bits.jd_bits(19), jxl_bits.jd_off(19, 524288), jxl_bits.jd_off(20, 1048576), jxl_bits.jd_off(21, 2097152))
    *x = jxl_bits.jb_signed(ux)
    let uy: u32 = jxl_bits.jb_u32(b, jxl_bits.jd_bits(19), jxl_bits.jd_off(19, 524288), jxl_bits.jd_off(20, 1048576), jxl_bits.jd_off(21, 2097152))
    *y = jxl_bits.jb_signed(uy)
}

fn read_color(b: *mut jxl_bits.JxlBits, c: *mut JxlColor) -> i32 {
    *c = color_default()
    if jxl_bits.jb_bit(b) {
        return jxl_err.JX_OK
    }
    (*c).want_icc = jxl_bits.jb_bit(b)
    (*c).color_space = jxl_bits.jb_enum(b)
    if (*c).color_space > 3 {
        return jxl_err.JX_BAD
    }
    if (*c).want_icc {
        return jxl_err.JX_OK
    }
    if (*c).color_space != 2 {
        (*c).white_point = jxl_bits.jb_enum(b)
        if (*c).white_point == 2 {
            read_xy(b, &(*c).wx, &(*c).wy)
        } else if (*c).white_point != 1 && (*c).white_point != 10 && (*c).white_point != 11 {
            return jxl_err.JX_BAD
        }
    }
    if (*c).color_space == 0 || (*c).color_space == 3 {
        (*c).primaries = jxl_bits.jb_enum(b)
        if (*c).primaries == 2 {
            read_xy(b, &(*c).rx, &(*c).ry)
            read_xy(b, &(*c).gx, &(*c).gy)
            read_xy(b, &(*c).bx, &(*c).by)
        } else if (*c).primaries != 1 && (*c).primaries != 9 && (*c).primaries != 11 {
            return jxl_err.JX_BAD
        }
    }
    if (*c).color_space == 2 {
        (*c).have_gamma = true
        (*c).gamma = 3333333
    } else {
        (*c).have_gamma = jxl_bits.jb_bit(b)
        if (*c).have_gamma {
            (*c).gamma = jxl_bits.jb_read(b, 24)
            if (*c).gamma > 10000000 || (*c).gamma == 0 {
                return jxl_err.JX_BAD
            }
        } else {
            (*c).transfer = jxl_bits.jb_enum(b)
            let t: u32 = (*c).transfer
            if t != 1 && t != 2 && t != 8 && t != 13 && t != 16 && t != 17 && t != 18 {
                return jxl_err.JX_BAD
            }
        }
    }
    (*c).intent = jxl_bits.jb_enum(b)
    if (*c).intent > 3 {
        return jxl_err.JX_BAD
    }
    if (*c).color_space == 3 {
        return jxl_err.JX_BAD
    }
    return jxl_err.JX_OK
}

fn skip_extensions(b: *mut jxl_bits.JxlBits) {
    let mask: u64 = jxl_bits.jb_u64(b)
    if mask == 0 {
        return
    }
    var total: u64 = 0
    var i: u64 = 0
    while i < 64 {
        if ((mask >> i) & 1) != 0 {
            total = total + jxl_bits.jb_u64(b)
        }
        i = i + 1
    }
    jxl_bits.jb_skip_bits(b, total)
}

fn read_tone_mapping(b: *mut jxl_bits.JxlBits, m: *mut JxlMeta) -> i32 {
    (*m).intensity_target = 255.0
    (*m).min_nits = 0.0
    (*m).relative_to_max = false
    (*m).linear_below = 0.0
    if jxl_bits.jb_bit(b) {
        return jxl_err.JX_OK
    }
    (*m).intensity_target = jxl_bits.jb_f16(b)
    if (*m).intensity_target <= 0.0 {
        return jxl_err.JX_BAD
    }
    (*m).min_nits = jxl_bits.jb_f16(b)
    if (*m).min_nits < 0.0 || (*m).min_nits > (*m).intensity_target {
        return jxl_err.JX_BAD
    }
    (*m).relative_to_max = jxl_bits.jb_bit(b)
    (*m).linear_below = jxl_bits.jb_f16(b)
    if (*m).linear_below < 0.0 || ((*m).relative_to_max && (*m).linear_below > 1.0) {
        return jxl_err.JX_BAD
    }
    return jxl_err.JX_OK
}

fn jm_read(b: *mut jxl_bits.JxlBits, m: *mut JxlMeta) -> i32 {
    jm_read_size(b, &(*m).width, &(*m).height)
    if (*m).width == 0 || (*m).height == 0 {
        return jxl_err.JX_BAD
    }
    if jxl_bits.jb_bit(b) {
        return jxl_err.JX_OK
    }
    let extra_fields: bool = jxl_bits.jb_bit(b)
    if extra_fields {
        (*m).orientation = jxl_bits.jb_read(b, 3) + 1
        (*m).have_intrinsic = jxl_bits.jb_bit(b)
        if (*m).have_intrinsic {
            jm_read_size(b, &(*m).intrinsic_w, &(*m).intrinsic_h)
        }
        (*m).have_preview = jxl_bits.jb_bit(b)
        if (*m).have_preview {
            read_preview(b, m)
        }
        (*m).have_animation = jxl_bits.jb_bit(b)
        if (*m).have_animation {
            (*m).tps_num = jxl_bits.jb_u32(b, jxl_bits.jd_val(100), jxl_bits.jd_val(1000), jxl_bits.jd_off(10, 1), jxl_bits.jd_off(30, 1))
            (*m).tps_den = jxl_bits.jb_u32(b, jxl_bits.jd_val(1), jxl_bits.jd_val(1001), jxl_bits.jd_off(8, 1), jxl_bits.jd_off(10, 1))
            (*m).loops = jxl_bits.jb_u32(b, jxl_bits.jd_val(0), jxl_bits.jd_bits(3), jxl_bits.jd_bits(16), jxl_bits.jd_bits(32))
            (*m).have_timecodes = jxl_bits.jb_bit(b)
        }
    }
    var r: i32 = read_depth(b, &(*m).depth)
    if r != jxl_err.JX_OK {
        return r
    }
    (*m).modular_16bit = jxl_bits.jb_bit(b)
    let ne: u32 = jxl_bits.jb_u32(b, jxl_bits.jd_val(0), jxl_bits.jd_val(1), jxl_bits.jd_off(4, 2), jxl_bits.jd_off(12, 1))
    var i: u32 = 0
    while i < ne {
        var e: JxlExtra = JxlExtra { kind: 0, depth: depth_default(), dim_shift: 0, alpha_assoc: false, cfa_channel: 1 }
        r = read_extra_channel(b, &e)
        if r != jxl_err.JX_OK {
            return r
        }
        if !vec.vec_push[JxlExtra](&(*m).extra, e) {
            return jxl_err.JX_MEMORY
        }
        if jxl_bits.jb_over(b) {
            return jxl_err.JX_TRUNCATED
        }
        i = i + 1
    }
    (*m).xyb_encoded = jxl_bits.jb_bit(b)
    r = read_color(b, &(*m).color)
    if r != jxl_err.JX_OK {
        return r
    }
    if extra_fields {
        r = read_tone_mapping(b, m)
        if r != jxl_err.JX_OK {
            return r
        }
    }
    skip_extensions(b)
    if jxl_bits.jb_over(b) {
        return jxl_err.JX_TRUNCATED
    }
    return jxl_err.JX_OK
}

fn jm_read_custom_transform(b: *mut jxl_bits.JxlBits, m: *mut JxlMeta) -> i32 {
    (*m).ct_default = true
    (*m).has_opsin = false
    (*m).weights_mask = 0
    if jxl_bits.jb_bit(b) {
        return jxl_err.JX_OK
    }
    (*m).ct_default = false
    if (*m).xyb_encoded {
        if !jxl_bits.jb_bit(b) {
            var i: usize = 0
            while i < 16 {
                (*m).opsin[i] = jxl_bits.jb_f16(b)
                i = i + 1
            }
            (*m).has_opsin = true
        }
    }
    (*m).weights_mask = jxl_bits.jb_read(b, 3)
    var count: u32 = 0
    if ((*m).weights_mask & 1) != 0 { count = count + 15 }
    if ((*m).weights_mask & 2) != 0 { count = count + 55 }
    if ((*m).weights_mask & 4) != 0 { count = count + 210 }
    var k: u32 = 0
    while k < count {
        jxl_bits.jb_f16(b)
        k = k + 1
    }
    if jxl_bits.jb_over(b) {
        return jxl_err.JX_TRUNCATED
    }
    return jxl_err.JX_OK
}
