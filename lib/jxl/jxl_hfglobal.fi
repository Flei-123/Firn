// lib/jxl/jxl_hfglobal.fi -- jxl_hfglobal: JPEG XL VarDCT HfGlobal (coefficient orders, AC histograms)
import std.rt
import std.vec
import jxl.jxl_acs
import jxl.jxl_bctx
import jxl.jxl_bits
import jxl.jxl_code
import jxl.jxl_dequant
import jxl.jxl_err
import jxl.jxl_frame
import jxl.jxl_order
import jxl.jxl_perm
import jxl.jxl_stream

export { JxlHfGlobal, hfg_new, hfg_free, hfg_read, hfg_order_ptr, hfg_dequant }

const ORDER_CONTEXTS: usize = 8
const MAX_NATURAL: usize = 65536

struct JxlHfGlobal {
    num_histograms: u32,
    num_passes: u32,
    orders: u64,
    dequant: u64,
    codes: vec.Vec[jxl_code.JxlCode],
}

fn hfg_new() -> JxlHfGlobal {
    return JxlHfGlobal { num_histograms: 1, num_passes: 0, orders: 0, dequant: 0, codes: vec.vec_new[jxl_code.JxlCode]() }
}

fn hfg_free(g: *mut JxlHfGlobal) {
    var i: usize = 0
    while i < vec.vec_len[jxl_code.JxlCode](&(*g).codes) {
        jxl_code.code_free(vec.vec_elem_ptr[jxl_code.JxlCode](&(*g).codes, i))
        i = i + 1
    }
    vec.vec_free[jxl_code.JxlCode](&(*g).codes)
    jxl_dequant.dq_free((*g).dequant)
    (*g).dequant = 0
    if (*g).orders != 0 {
        rt.heap_free((*g).orders, ((*g).num_passes as usize) * jxl_order.ORDER_TOTAL * 4)
        (*g).orders = 0
    }
}

fn hfg_order_ptr(g: *mut JxlHfGlobal, pass: u32, ord: usize, c: usize) -> u64 {
    return (*g).orders + (((pass as usize) * jxl_order.ORDER_TOTAL + jxl_order.order_offset(ord, c)) as u64) * 4
}

fn hfg_dequant(g: *mut JxlHfGlobal) -> u64 {
    return (*g).dequant
}

fn ceil_log2_nonzero(n: usize) -> u32 {
    var v: usize = n - 1
    var r: u32 = 0
    while v > 0 {
        r = r + 1
        v = v >> 1
    }
    return r
}

fn decode_orders(b: *mut jxl_bits.JxlBits, used_orders: u32, used_acs: u32, base: u64) -> i32 {
    var code: jxl_code.JxlCode = jxl_code.code_new()
    var rd: jxl_code.JxlReader = jxl_code.reader_new()
    var r: i32 = jxl_err.JX_OK
    if used_orders != 0 {
        r = jxl_code.code_read(b, ORDER_CONTEXTS, false, &code)
        if r == jxl_err.JX_OK {
            r = jxl_code.reader_init(&rd, &code, b, 0)
        }
    }
    let nat: u64 = rt.heap_alloc(MAX_NATURAL * 4)
    if nat == 0 {
        jxl_code.reader_free(&rd)
        jxl_code.code_free(&code)
        return jxl_err.JX_MEMORY
    }
    var acs_mask: u32 = 0
    var o: u32 = 0
    while o < jxl_acs.ACS_COUNT {
        if (used_acs & ((1 as u32) << o)) != 0 {
            acs_mask = acs_mask | ((1 as u32) << (jxl_acs.acs_order(o) as u32))
        }
        o = o + 1
    }
    var computed: u32 = 0
    o = 0
    while r == jxl_err.JX_OK && o < jxl_acs.ACS_COUNT {
        let ord: usize = jxl_acs.acs_order(o)
        let bit: u32 = (1 as u32) << (ord as u32)
        if (computed & bit) == 0 {
            computed = computed | bit
            let used: bool = (acs_mask & bit) != 0
            let llf: usize = jxl_acs.acs_cover_x(o) * jxl_acs.acs_cover_y(o)
            let size: usize = llf * 64
            let has_perm: bool = (used_orders & bit) != 0
            if used || has_perm {
                jxl_order.natural_order(o, nat)
            }
            var c: usize = 0
            while r == jxl_err.JX_OK && c < 3 {
                var dest: u64 = 0
                if used {
                    dest = base + (jxl_order.order_offset(ord, c) as u64) * 4
                }
                if !has_perm {
                    if used {
                        rt.mem_copy(dest, nat, size * 4)
                    }
                } else {
                    r = jxl_perm.perm_read_with(b, &rd, llf, size, dest)
                    if r == jxl_err.JX_OK && dest != 0 {
                        var k: usize = 0
                        while k < size {
                            let idx: usize = rt.ld32(dest, k) as usize
                            rt.st32(dest, k, rt.ld32(nat, idx))
                            k = k + 1
                        }
                    }
                }
                c = c + 1
            }
        }
        o = o + 1
    }
    if r == jxl_err.JX_OK && used_orders != 0 && !jxl_code.reader_final_ok(&rd) {
        r = jxl_err.JX_BAD
    }
    rt.heap_free(nat, MAX_NATURAL * 4)
    jxl_code.reader_free(&rd)
    jxl_code.code_free(&code)
    return r
}

fn hfg_read(b: *mut jxl_bits.JxlBits, f: *mut jxl_frame.JxlFrame, used_acs: u32, bc: *mut jxl_bctx.JxlBlockCtx, ms: *mut jxl_stream.JxlModState, g: *mut JxlHfGlobal) -> i32 {
    let dr: i32 = jxl_dequant.dq_read(b, (*f).num_lf_groups as usize, ms, &(*g).dequant)
    if dr != jxl_err.JX_OK {
        return dr
    }
    (*g).num_histograms = 1 + jxl_bits.jb_read(b, ceil_log2_nonzero((*f).num_groups as usize))
    (*g).num_passes = (*f).num_passes
    let total: usize = ((*g).num_passes as usize) * jxl_order.ORDER_TOTAL * 4
    (*g).orders = rt.heap_alloc(total)
    if (*g).orders == 0 {
        return jxl_err.JX_MEMORY
    }
    rt.mem_set((*g).orders, 0 as u8, total)
    var pass: u32 = 0
    while pass < (*g).num_passes {
        let used_orders: u32 = jxl_bits.jb_u32(b, jxl_bits.jd_val(95), jxl_bits.jd_val(19), jxl_bits.jd_val(0), jxl_bits.jd_bits(13))
        var r: i32 = decode_orders(b, used_orders, used_acs, hfg_order_ptr(g, pass, 0, 0))
        if r != jxl_err.JX_OK {
            return r
        }
        var code: jxl_code.JxlCode = jxl_code.code_new()
        r = jxl_code.code_read(b, ((*g).num_histograms as usize) * (jxl_bctx.bctx_num_ac_contexts(bc) as usize), false, &code)
        if r != jxl_err.JX_OK {
            jxl_code.code_free(&code)
            return r
        }
        if !vec.vec_push[jxl_code.JxlCode](&(*g).codes, code) {
            jxl_code.code_free(&code)
            return jxl_err.JX_MEMORY
        }
        pass = pass + 1
    }
    if jxl_bits.jb_over(b) {
        return jxl_err.JX_TRUNCATED
    }
    return jxl_err.JX_OK
}
