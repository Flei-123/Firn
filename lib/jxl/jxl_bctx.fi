import std.rt
import jxl.jxl_bits
import jxl.jxl_code
import jxl.jxl_err

export { JxlBlockCtx, bctx_default, bctx_read, bctx_context, bctx_zero_density_offset, bctx_num_ac_contexts, bctx_nonzero_context, NUM_ORDERS }

const NUM_ORDERS: usize = 13
const MAP_CAP: usize = 2496
const NONZERO_BUCKETS: u32 = 37
const ZERO_DENSITY_CONTEXTS: u32 = 458

static DEFAULT_MAP: [u8; 39] = [
    0, 1, 2, 2, 3, 3, 4, 5, 6, 6, 6, 6, 6,
    7, 8, 9, 9, 10, 11, 12, 13, 14, 14, 14, 14, 14,
    7, 8, 9, 9, 10, 11, 12, 13, 14, 14, 14, 14, 14]

struct JxlBlockCtx {
    dc_counts: [u32; 3],
    dc_thresholds: [i32; 48],
    qf_count: u32,
    qf_thresholds: [u32; 16],
    num_ctxs: u32,
    num_dc_ctxs: u32,
    map: [u8; 2496],
}

fn bctx_default(x: *mut JxlBlockCtx) {
    (*x).dc_counts = [0; 3]
    (*x).dc_thresholds = [0; 48]
    (*x).qf_count = 0
    (*x).qf_thresholds = [0; 16]
    (*x).num_ctxs = 15
    (*x).num_dc_ctxs = 1
    (*x).map = [0 as u8; 2496]
    var i: usize = 0
    while i < 39 {
        (*x).map[i] = DEFAULT_MAP[i]
        i = i + 1
    }
}

fn unpack_signed(v: u32) -> i32 {
    if (v & 1) != 0 {
        return 0 - (((v + 1) >> 1) as i32)
    }
    return (v >> 1) as i32
}

fn bctx_read(b: *mut jxl_bits.JxlBits, x: *mut JxlBlockCtx) -> i32 {
    bctx_default(x)
    if jxl_bits.jb_bit(b) {
        return jxl_err.JX_OK
    }
    (*x).num_dc_ctxs = 1
    var j: usize = 0
    while j < 3 {
        let cnt: u32 = jxl_bits.jb_read(b, 4)
        (*x).dc_counts[j] = cnt
        (*x).num_dc_ctxs = (*x).num_dc_ctxs * (cnt + 1)
        var i: u32 = 0
        while i < cnt {
            let u: u32 = jxl_bits.jb_u32(b, jxl_bits.jd_bits(4), jxl_bits.jd_off(8, 16), jxl_bits.jd_off(16, 272), jxl_bits.jd_off(32, 65808))
            (*x).dc_thresholds[j * 16 + i as usize] = unpack_signed(u)
            i = i + 1
        }
        j = j + 1
    }
    (*x).qf_count = jxl_bits.jb_read(b, 4)
    var q: u32 = 0
    while q < (*x).qf_count {
        (*x).qf_thresholds[q as usize] = jxl_bits.jb_u32(b, jxl_bits.jd_bits(2), jxl_bits.jd_off(3, 4), jxl_bits.jd_off(5, 12), jxl_bits.jd_off(8, 44)) + 1
        q = q + 1
    }
    if jxl_bits.jb_over(b) {
        return jxl_err.JX_TRUNCATED
    }
    if (*x).num_dc_ctxs * ((*x).qf_count + 1) > 64 {
        return jxl_err.JX_BAD
    }
    let n: usize = 3 * NUM_ORDERS * ((*x).num_dc_ctxs as usize) * (((*x).qf_count + 1) as usize)
    let tmp: u64 = rt.heap_alloc(n)
    if tmp == 0 {
        return jxl_err.JX_MEMORY
    }
    var nh: u32 = 0
    let ok: bool = jxl_code.read_context_map(b, tmp, n, &nh)
    var i: usize = 0
    while ok && i < n {
        (*x).map[i] = rt.ld8(tmp, i)
        i = i + 1
    }
    rt.heap_free(tmp, n)
    if !ok {
        return jxl_err.JX_BAD
    }
    (*x).num_ctxs = nh
    if nh > 16 {
        return jxl_err.JX_BAD
    }
    return jxl_err.JX_OK
}

fn bctx_context(x: *mut JxlBlockCtx, dc_idx: usize, qf: u32, ord: usize, c: usize) -> u32 {
    var qf_idx: usize = 0
    var t: u32 = 0
    while t < (*x).qf_count {
        if qf > (*x).qf_thresholds[t as usize] {
            qf_idx = qf_idx + 1
        }
        t = t + 1
    }
    var idx: usize = 2
    if c < 2 {
        idx = c ^ 1
    }
    idx = idx * NUM_ORDERS + ord
    idx = idx * (((*x).qf_count + 1) as usize) + qf_idx
    idx = idx * ((*x).num_dc_ctxs as usize) + dc_idx
    return (*x).map[idx] as u32
}

fn bctx_zero_density_offset(x: *mut JxlBlockCtx, block_ctx: u32) -> u32 {
    return (*x).num_ctxs * NONZERO_BUCKETS + ZERO_DENSITY_CONTEXTS * block_ctx
}

fn bctx_num_ac_contexts(x: *mut JxlBlockCtx) -> u32 {
    return (*x).num_ctxs * (NONZERO_BUCKETS + ZERO_DENSITY_CONTEXTS)
}

fn bctx_nonzero_context(x: *mut JxlBlockCtx, non_zeros: u32, block_ctx: u32) -> u32 {
    var nz: u32 = non_zeros
    if nz >= 64 {
        nz = 64
    }
    var ctx: u32 = nz
    if nz >= 8 {
        ctx = 4 + nz / 2
    }
    return ctx * (*x).num_ctxs + block_ctx
}
