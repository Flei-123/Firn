// SPDX-License-Identifier: MPL-2.0
// lib/jxl/jxl_gaborish.fi -- jxl_gaborish: JPEG XL Gaborish 3x3 smoothing filter on XYB planes
import jxl.jxl_loopf
import std.rt

export { gab_apply, mirror_index }

fn mirror_index(i: i64, n: i64) -> usize {
    var v: i64 = i
    while v < 0 || v >= n {
        if v < 0 {
            v = 0 - v - 1
        } else {
            v = 2 * n - v - 1
        }
    }
    return v as usize
}

fn fld(p: u64, i: usize) -> f64 {
    return *((p +% ((i * 8) as u64)) as *mut f64)
}

fn fst(p: u64, i: usize, v: f64) {
    *((p +% ((i * 8) as u64)) as *mut f64) = v
}

fn gab_apply(planes: u64, width: usize, height: usize, stride: usize, plane_len: usize, lf: *mut jxl_loopf.JxlLoopFilter) -> bool {
    let tmp: u64 = rt.heap_alloc(width * height * 8)
    if tmp == 0 {
        return false
    }
    var c: usize = 0
    while c < 3 {
        let p: u64 = planes +% ((c * plane_len * 8) as u64)
        let w1: f64 = (*lf).gab_weights[c * 2]
        let w2: f64 = (*lf).gab_weights[c * 2 + 1]
        let norm: f64 = 1.0 / (1.0 + 4.0 * (w1 + w2))
        var y: usize = 0
        while y < height {
            let ym: usize = mirror_index((y as i64) - 1, height as i64)
            let yp: usize = mirror_index((y as i64) + 1, height as i64)
            var x: usize = 0
            while x < width {
                let xm: usize = mirror_index((x as i64) - 1, width as i64)
                let xp: usize = mirror_index((x as i64) + 1, width as i64)
                let side: f64 = fld(p, y * stride + xm) + fld(p, y * stride + xp) + fld(p, ym * stride + x) + fld(p, yp * stride + x)
                let corner: f64 = fld(p, ym * stride + xm) + fld(p, ym * stride + xp) + fld(p, yp * stride + xm) + fld(p, yp * stride + xp)
                fst(tmp, y * width + x, (fld(p, y * stride + x) + side * w1 + corner * w2) * norm)
                x = x + 1
            }
            y = y + 1
        }
        y = 0
        while y < height {
            var x2: usize = 0
            while x2 < width {
                fst(p, y * stride + x2, fld(tmp, y * width + x2))
                x2 = x2 + 1
            }
            y = y + 1
        }
        c = c + 1
    }
    rt.heap_free(tmp, width * height * 8)
    return true
}
