// SPDX-License-Identifier: MPL-2.0
// lib/jxl/jxl_gaborish.fi -- jxl_gaborish: JPEG XL Gaborish 3x3 smoothing filter on XYB planes
import jxl.jxl_loopf
import jxl.jxl_pad
import std.rt

export { gab_apply }

fn fld(p: u64, i: usize) -> f64 {
    return *((p +% ((i * 8) as u64)) as *mut f64)
}

fn fst(p: u64, i: usize, v: f64) {
    *((p +% ((i * 8) as u64)) as *mut f64) = v
}

fn gab_apply(planes: u64, width: usize, height: usize, stride: usize, plane_len: usize, lf: *mut jxl_loopf.JxlLoopFilter) -> bool {
    let pw: usize = width + 2
    let tmp: u64 = rt.heap_alloc(pw * (height + 2) * 8)
    if tmp == 0 {
        return false
    }
    var c: usize = 0
    while c < 3 {
        let p: u64 = planes +% ((c * plane_len * 8) as u64)
        jxl_pad.pad_fill(p, width, height, stride, 1, tmp)
        let w1: f64 = (*lf).gab_weights[c * 2]
        let w2: f64 = (*lf).gab_weights[c * 2 + 1]
        let norm: f64 = 1.0 / (1.0 + 4.0 * (w1 + w2))
        var y: usize = 0
        while y < height {
            let r0: u64 = tmp +% ((y * pw * 8) as u64)
            let r1: u64 = r0 +% ((pw * 8) as u64)
            let r2: u64 = r1 +% ((pw * 8) as u64)
            let out: u64 = p +% ((y * stride * 8) as u64)
            var x: usize = 0
            while x < width {
                let side: f64 = fld(r1, x) + fld(r1, x + 2) + fld(r0, x + 1) + fld(r2, x + 1)
                let corner: f64 = fld(r0, x) + fld(r0, x + 2) + fld(r2, x) + fld(r2, x + 2)
                fst(out, x, (fld(r1, x + 1) + side * w1 + corner * w2) * norm)
                x = x + 1
            }
            y = y + 1
        }
        c = c + 1
    }
    rt.heap_free(tmp, pw * (height + 2) * 8)
    return true
}
