// lib/jxl/jxl_vdrun.fi -- jxl_vdrun: JPEG XL VarDCT frame decode driver (sections, passes, extra channels, sRGB samples)
import jxl.jxl_dcframe
import jxl.jxl_ecup
import jxl.jxl_err
import jxl.jxl_features
import jxl.jxl_frame
import jxl.jxl_header
import jxl.jxl_img
import jxl.jxl_mdec
import jxl.jxl_upsample
import jxl.jxl_open
import jxl.jxl_refdec
import jxl.jxl_refs
import jxl.jxl_vardct
import jxl.jxl_vdrecon
import jxl.jxl_xyb
import std.rt

export { vdr_decode, vdr_decode_sections }

fn vdr_decode_sections(v: *mut jxl_vardct.JxlVardct) -> i32 {
    var r: i32 = jxl_err.JX_OK
    var end: usize = 0
    var g: usize = 0
    while r == jxl_err.JX_OK && g < ((*v).doc.frame.num_lf_groups as usize) {
        r = jxl_vardct.vd_decode_lf_group(v, g, &end)
        g = g + 1
    }
    if r == jxl_err.JX_OK {
        r = jxl_vardct.vd_decode_hf_global(v, &end)
    }
    var pass: u32 = 0
    while r == jxl_err.JX_OK && pass < (*v).doc.frame.num_passes {
        g = 0
        while r == jxl_err.JX_OK && g < ((*v).doc.frame.num_groups as usize) {
            r = jxl_vardct.vd_decode_ac_group(v, pass, g, &end)
            g = g + 1
        }
        pass = pass + 1
    }
    if r == jxl_err.JX_OK {
        r = jxl_vardct.vd_finish_extras(v)
    }
    return r
}

fn copy_channel(dst: *mut jxl_img.JxlImage, src_data: u64, w: usize, h: usize) -> i32 {
    jxl_img.img_add(dst, w, h, 0, 0)
    let c: usize = jxl_img.img_count(dst) - 1
    if jxl_img.img_data(dst, c) == 0 {
        return jxl_err.JX_MEMORY
    }
    rt.mem_copy(jxl_img.img_data(dst, c), src_data, w * h * 4)
    return jxl_err.JX_OK
}

fn begin_vardct(v: *mut jxl_vardct.JxlVardct, refs: *mut jxl_refs.JxlRefs) -> i32 {
    var r: i32 = jxl_vardct.vd_begin(v)
    if r == jxl_err.JX_OK && ((*v).doc.frame.flags & jxl_frame.JF_FLAG_USE_LF) != 0 {
        r = jxl_dcframe.dcf_fill(&(*v).data, refs, (*v).doc.frame.dc_level)
    }
    return r
}

fn decode_vardct_ref(v: *mut jxl_vardct.JxlVardct, refs: *mut jxl_refs.JxlRefs) -> i32 {
    let f: *mut jxl_frame.JxlFrame = &(*v).doc.frame
    if (*f).do_ycbcr || (*f).upsampling != 1 || (*f).ec_upsampled {
        return jxl_err.JX_UNSUPPORTED
    }
    if (*f).frame_type == 2 && !(*f).save_before_ct {
        return jxl_err.JX_UNSUPPORTED
    }
    var r: i32 = begin_vardct(v, refs)
    if r == jxl_err.JX_OK {
        r = vdr_decode_sections(v)
    }
    var planes: u64 = 0
    var stride: usize = 0
    var plane_len: usize = 0
    if r == jxl_err.JX_OK {
        r = jxl_vdrecon.vr_xyb(v, refs, &planes, &stride, &plane_len)
    }
    if r == jxl_err.JX_OK {
        if (*f).frame_type == 1 {
            jxl_refs.refs_store_dc(refs, ((*f).dc_level as usize) - 1, planes, stride, plane_len, (*f).width as usize, (*f).height as usize)
        } else {
            jxl_refs.refs_store(refs, (*f).save_slot as usize, planes, stride, plane_len, (*f).width as usize, (*f).height as usize)
        }
    }
    return r
}

fn decode_reference_frames(v: *mut jxl_vardct.JxlVardct, refs: *mut jxl_refs.JxlRefs) -> i32 {
    var r: i32 = jxl_err.JX_OK
    while r == jxl_err.JX_OK && ((*v).doc.frame.frame_type == 2 || (*v).doc.frame.frame_type == 1) {
        jxl_refdec.refdec_note_frame(refs, false)
        if (*v).doc.frame.encoding == jxl_frame.JF_MODULAR {
            r = jxl_refdec.refdec_modular(&(*v).doc, refs)
        } else {
            r = decode_vardct_ref(v, refs)
        }
        if r == jxl_err.JX_OK {
            r = jxl_vardct.vd_next_frame(v)
        }
    }
    return r
}

fn copy_one_extra(v: *mut jxl_vardct.JxlVardct, img: *mut jxl_img.JxlImage, src: *mut jxl_img.JxlImage, c: usize, idx: usize) -> i32 {
    let f: *mut jxl_frame.JxlFrame = &(*v).doc.frame
    let n: usize = jxl_frame.jf_ec_ups(f, idx) as usize
    let e: *mut jxl_header.JxlExtra = jxl_header.jm_extra(&(*v).doc.meta, idx)
    if n == 1 {
        let cr: i32 = copy_channel(img, jxl_img.img_data(src, c), jxl_img.img_w(src, c), jxl_img.img_h(src, c))
        if cr == jxl_err.JX_OK && (*e).depth.is_float {
            jxl_ecup.ecup_normalize_float(img, jxl_img.img_count(img) - 1, (*e).depth)
        }
        return cr
    }
    let ow: usize = (*f).full_w as usize
    let oh: usize = (*f).full_h as usize
    if ow == 0 || oh == 0 || (ow as u64) * (oh as u64) > jxl_mdec.MDEC_MAX_PIXELS {
        return jxl_err.JX_TOO_LARGE
    }
    if (*e).depth.bits == 0 || (!(*e).depth.is_float && (*e).depth.bits > 16) || ((*e).depth.is_float && (*e).depth.bits < 16) {
        return jxl_err.JX_UNSUPPORTED
    }
    let kern: u64 = jxl_upsample.ups_kernel_new(&(*v).doc.meta, n)
    if kern == 0 {
        return jxl_err.JX_MEMORY
    }
    var dither_c: i32 = 0 - 1
    if (idx as i32) == jxl_header.jm_alpha_index(&(*v).doc.meta) {
        dither_c = jxl_header.jm_color_channels(&(*v).doc.meta) as i32
    }
    let r: i32 = jxl_ecup.ecup_channel(kern, n, src, c, (*e).depth, img, ow, oh, dither_c, &(*v).doc.dither)
    jxl_upsample.ups_kernel_free(kern, n)
    return r
}

fn copy_extras(v: *mut jxl_vardct.JxlVardct, img: *mut jxl_img.JxlImage, src: *mut jxl_img.JxlImage, first: usize) -> i32 {
    var r: i32 = jxl_err.JX_OK
    var c: usize = first
    while r == jxl_err.JX_OK && c < jxl_img.img_count(src) {
        r = copy_one_extra(v, img, src, c, c - first)
        c = c + 1
    }
    return r
}

fn upsample_frame(v: *mut jxl_vardct.JxlVardct, planes: *mut u64, stride: *mut usize, plane_len: *mut usize, w: *mut usize, h: *mut usize) -> i32 {
    let f: *mut jxl_frame.JxlFrame = &(*v).doc.frame
    *w = (*f).width as usize
    *h = (*f).height as usize
    if (*f).upsampling == 1 {
        return jxl_err.JX_OK
    }
    let ow: usize = (*f).full_w as usize
    let oh: usize = (*f).full_h as usize
    if ow == 0 || oh == 0 || (ow as u64) * (oh as u64) > jxl_mdec.MDEC_MAX_PIXELS {
        return jxl_err.JX_TOO_LARGE
    }
    let np: u64 = jxl_upsample.ups_planes(&(*v).doc.meta, *planes, *stride, *plane_len, *w, *h, (*f).upsampling, ow, oh)
    if np == 0 {
        return jxl_err.JX_MEMORY
    }
    rt.heap_free(*planes, *plane_len * 3 * 8)
    *planes = np
    *stride = ow
    *plane_len = ow * oh
    *w = ow
    *h = oh
    return jxl_err.JX_OK
}

fn pack_samples(planes: u64, stride: usize, plane_len: usize, w: usize, h: usize, v: *mut jxl_vardct.JxlVardct, bits: u32, img: *mut jxl_img.JxlImage) -> i32 {
    let bytes: usize = w * h * 3 * 4
    let out: u64 = rt.heap_alloc(bytes)
    if out == 0 {
        return jxl_err.JX_MEMORY
    }
    jxl_xyb.xyb_to_samples(planes, w, h, stride, plane_len, (*v).doc.meta.intensity_target, bits, out, &(*v).doc.dither)
    var r: i32 = jxl_err.JX_OK
    var c: usize = 0
    while r == jxl_err.JX_OK && c < 3 {
        r = copy_channel(img, out +% ((c * w * h * 4) as u64), w, h)
        c = c + 1
    }
    rt.heap_free(out, bytes)
    return r
}

fn decode_modular_main(v: *mut jxl_vardct.JxlVardct, refs: *mut jxl_refs.JxlRefs, bits: u32, img: *mut jxl_img.JxlImage) -> i32 {
    let f: *mut jxl_frame.JxlFrame = &(*v).doc.frame
    if (*f).frame_type != jxl_frame.JF_REGULAR || bits == 0 || bits > 16 || (*v).doc.meta.have_animation {
        return jxl_err.JX_UNSUPPORTED
    }
    var r: i32 = jxl_mdec.mdec_check(&(*v).doc)
    if r == jxl_err.JX_OK {
        r = jxl_mdec.mdec_read(&(*v).doc, &(*v).lfg)
    }
    if r != jxl_err.JX_OK {
        return r
    }
    jxl_refdec.refdec_note_frame(refs, true)
    var planes: u64 = jxl_mdec.mdec_planes(&(*v).doc, &(*v).lfg)
    if planes == 0 {
        return jxl_err.JX_MEMORY
    }
    var stride: usize = (*f).width as usize
    var plane_len: usize = stride * ((*f).height as usize)
    var w: usize = 0
    var h: usize = 0
    r = jxl_features.feat_apply(&(*v).lfg, f, refs, planes, stride, plane_len)
    if r == jxl_err.JX_OK {
        r = upsample_frame(v, &planes, &stride, &plane_len, &w, &h)
    }
    if r == jxl_err.JX_OK {
        r = jxl_features.feat_apply_late(&(*v).lfg, f, refs, planes, stride, plane_len, w, h)
    }
    if r == jxl_err.JX_OK {
        r = pack_samples(planes, stride, plane_len, w, h, v, bits, img)
    }
    if r == jxl_err.JX_OK {
        r = copy_extras(v, img, &(*v).lfg.img, 3)
    }
    rt.heap_free(planes, plane_len * 3 * 8)
    return r
}

fn decode_vardct_main(v: *mut jxl_vardct.JxlVardct, refs: *mut jxl_refs.JxlRefs, bits: u32, img: *mut jxl_img.JxlImage) -> i32 {
    var r: i32 = begin_vardct(v, refs)
    if r == jxl_err.JX_OK {
        let f: *mut jxl_frame.JxlFrame = &(*v).doc.frame
        if (*f).frame_type != jxl_frame.JF_REGULAR || (*f).do_ycbcr || bits == 0 || bits > 16 {
            r = jxl_err.JX_UNSUPPORTED
        } else if ((*f).width as u64) * ((*f).height as u64) > jxl_mdec.MDEC_MAX_PIXELS {
            r = jxl_err.JX_TOO_LARGE
        }
    }
    if r == jxl_err.JX_OK {
        r = vdr_decode_sections(v)
    }
    if r == jxl_err.JX_OK {
        jxl_refdec.refdec_note_frame(refs, true)
        var planes: u64 = 0
        var stride: usize = 0
        var plane_len: usize = 0
        r = jxl_vdrecon.vr_xyb(v, refs, &planes, &stride, &plane_len)
        var w: usize = 0
        var h: usize = 0
        if r == jxl_err.JX_OK {
            r = upsample_frame(v, &planes, &stride, &plane_len, &w, &h)
        }
        if r == jxl_err.JX_OK {
            r = jxl_features.feat_apply_late(&(*v).lfg, &(*v).doc.frame, refs, planes, stride, plane_len, w, h)
        }
        if r == jxl_err.JX_OK {
            r = pack_samples(planes, stride, plane_len, w, h, v, bits, img)
            rt.heap_free(planes, plane_len * 3 * 8)
        }
    }
    if r == jxl_err.JX_OK {
        r = copy_extras(v, img, &(*v).lfg.img, 0)
    }
    return r
}

fn vdr_decode(p: u64, n: usize, bits: u32, img: *mut jxl_img.JxlImage) -> i32 {
    var v: jxl_vardct.JxlVardct = jxl_vardct.vd_new()
    var refs: jxl_refs.JxlRefs = jxl_refs.refs_new()
    var r: i32 = jxl_open.doc_open(p, n, &v.doc)
    if r == jxl_err.JX_OK {
        r = decode_reference_frames(&v, &refs)
    }
    if r == jxl_err.JX_OK {
        if v.doc.frame.encoding == jxl_frame.JF_MODULAR {
            r = decode_modular_main(&v, &refs, bits, img)
        } else {
            r = decode_vardct_main(&v, &refs, bits, img)
        }
    }
    jxl_refs.refs_free(&refs)
    jxl_vardct.vd_free(&v)
    return r
}
