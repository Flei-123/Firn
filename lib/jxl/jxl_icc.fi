import std.rt
import jxl.jxl_bits
import jxl.jxl_code
import jxl.jxl_err
import jxl.jxl_icc_pred

export {
    icc_read, icc_discard, icc_unpredict,
}

const MAX_ENC_SIZE: u64 = 268435456
const MAX_OUT_SIZE: usize = 1073741824
const CMD_TAG_UNKNOWN: u32 = 1
const CMD_TAG_TRC: u32 = 2
const CMD_TAG_XYZ: u32 = 3
const CMD_TAG_STRING_FIRST: u32 = 4
const CMD_INSERT: u32 = 1
const CMD_SHUFFLE2: u32 = 2
const CMD_SHUFFLE4: u32 = 3
const CMD_PREDICT: u32 = 4
const CMD_XYZ: u32 = 10
const CMD_TYPE_FIRST: u32 = 16
const FLAG_OFFSET: u32 = 64
const FLAG_SIZE: u32 = 128

fn fits32(v: u64) -> bool {
    return v <= 4294967295
}

fn within(pos: usize, n: u64, size: usize) -> bool {
    return pos <= size && n <= ((size - pos) as u64)
}

fn is_xyz_tag(t: u32) -> bool {
    return t == jxl_icc_pred.TAG_RXYZ || t == jxl_icc_pred.TAG_GXYZ || t == jxl_icc_pred.TAG_BXYZ || t == jxl_icc_pred.TAG_KXYZ || t == jxl_icc_pred.TAG_WTPT || t == jxl_icc_pred.TAG_BKPT || t == jxl_icc_pred.TAG_LUMI
}

fn tag_list(enc: u64, size: usize, cpos: *mut usize, commands_end: usize, pos: *mut usize, osize: u64, out: *mut rt.Buf) -> i32 {
    let numtags_raw: u64 = jxl_icc_pred.read_varint(enc, size, cpos)
    if numtags_raw == 0 {
        return jxl_err.JX_OK
    }
    let numtags: u64 = numtags_raw - 1
    if !fits32(numtags) {
        return jxl_err.JX_BAD
    }
    jxl_icc_pred.push_be32(out, numtags as u32)
    var prev_start: u64 = (jxl_icc_pred.HEADER_SIZE as u64) + numtags * 12
    var prev_size: u64 = 0
    while true {
        if (rt.buf_len(out) as u64) > osize {
            return jxl_err.JX_BAD
        }
        if *cpos > commands_end {
            return jxl_err.JX_BAD
        }
        if *cpos == commands_end {
            break
        }
        let command: u32 = rt.ld8(enc, *cpos) as u32
        *cpos = *cpos + 1
        let tagcode: u32 = command & 63
        var tag: u32 = 0
        if tagcode == 0 {
            break
        } else if tagcode == CMD_TAG_UNKNOWN {
            if !within(*pos, 4, size) {
                return jxl_err.JX_BAD
            }
            tag = jxl_icc_pred.be32_at(enc, size, *pos)
            *pos = *pos + 4
        } else if tagcode == CMD_TAG_TRC {
            tag = jxl_icc_pred.TAG_RTRC
        } else if tagcode == CMD_TAG_XYZ {
            tag = jxl_icc_pred.TAG_RXYZ
        } else {
            let k: u32 = tagcode - CMD_TAG_STRING_FIRST
            if (k as usize) >= jxl_icc_pred.NUM_TAG_STRINGS {
                return jxl_err.JX_BAD
            }
            tag = jxl_icc_pred.tag_string(k as usize)
        }
        jxl_icc_pred.push_be32(out, tag)
        var tag_size: u64 = prev_size
        if is_xyz_tag(tag) {
            tag_size = 20
        }
        var tag_start: u64 = 0
        if (command & FLAG_OFFSET) != 0 {
            if *cpos >= commands_end {
                return jxl_err.JX_BAD
            }
            tag_start = jxl_icc_pred.read_varint(enc, size, cpos)
        } else {
            if !fits32(prev_start) {
                return jxl_err.JX_BAD
            }
            tag_start = prev_start + prev_size
        }
        if !fits32(tag_start) {
            return jxl_err.JX_BAD
        }
        jxl_icc_pred.push_be32(out, tag_start as u32)
        if (command & FLAG_SIZE) != 0 {
            if *cpos >= commands_end {
                return jxl_err.JX_BAD
            }
            tag_size = jxl_icc_pred.read_varint(enc, size, cpos)
        }
        if !fits32(tag_size) {
            return jxl_err.JX_BAD
        }
        jxl_icc_pred.push_be32(out, tag_size as u32)
        prev_start = tag_start
        prev_size = tag_size
        if tagcode == CMD_TAG_TRC {
            jxl_icc_pred.push_be32(out, jxl_icc_pred.TAG_GTRC)
            jxl_icc_pred.push_be32(out, tag_start as u32)
            jxl_icc_pred.push_be32(out, tag_size as u32)
            jxl_icc_pred.push_be32(out, jxl_icc_pred.TAG_BTRC)
            jxl_icc_pred.push_be32(out, tag_start as u32)
            jxl_icc_pred.push_be32(out, tag_size as u32)
        }
        if tagcode == CMD_TAG_XYZ {
            if !fits32(tag_start + tag_size * 2) {
                return jxl_err.JX_BAD
            }
            jxl_icc_pred.push_be32(out, jxl_icc_pred.TAG_GXYZ)
            jxl_icc_pred.push_be32(out, (tag_start + tag_size) as u32)
            jxl_icc_pred.push_be32(out, tag_size as u32)
            jxl_icc_pred.push_be32(out, jxl_icc_pred.TAG_BXYZ)
            jxl_icc_pred.push_be32(out, (tag_start + tag_size * 2) as u32)
            jxl_icc_pred.push_be32(out, tag_size as u32)
        }
    }
    return jxl_err.JX_OK
}

fn copy_data(enc: u64, pos: *mut usize, n: usize, out: *mut rt.Buf) {
    rt.buf_push_bytes(out, enc +% ((*pos) as u64), n)
    *pos = *pos + n
}

fn cmd_shuffle(enc: u64, size: usize, cpos: *mut usize, commands_end: usize, pos: *mut usize, width: usize, out: *mut rt.Buf) -> i32 {
    if *cpos >= commands_end {
        return jxl_err.JX_BAD
    }
    let num: u64 = jxl_icc_pred.read_varint(enc, size, cpos)
    if !within(*pos, num, size) {
        return jxl_err.JX_BAD
    }
    let n: usize = num as usize
    var tmp: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&tmp, enc +% ((*pos) as u64), n)
    if n > 0 && !jxl_icc_pred.shuffle_bytes(rt.buf_ptr(&tmp), n, width) {
        rt.buf_free(&tmp)
        return jxl_err.JX_MEMORY
    }
    rt.buf_push_bytes(out, rt.buf_ptr(&tmp), n)
    *pos = *pos + n
    rt.buf_free(&tmp)
    return jxl_err.JX_OK
}

fn cmd_predict(enc: u64, size: usize, cpos: *mut usize, commands_end: usize, pos: *mut usize, out: *mut rt.Buf) -> i32 {
    if !within(*cpos, 2, commands_end) {
        return jxl_err.JX_BAD
    }
    let flags: u32 = rt.ld8(enc, *cpos) as u32
    *cpos = *cpos + 1
    let width: usize = ((flags & 3) + 1) as usize
    if width == 3 {
        return jxl_err.JX_BAD
    }
    let order: u32 = (flags & 12) >> 2
    if order == 3 {
        return jxl_err.JX_BAD
    }
    var stride: u64 = width as u64
    if (flags & 16) != 0 {
        if *cpos >= commands_end {
            return jxl_err.JX_BAD
        }
        stride = jxl_icc_pred.read_varint(enc, size, cpos)
        if stride < (width as u64) {
            return jxl_err.JX_BAD
        }
    }
    let len: usize = rt.buf_len(out)
    if len == 0 || (((len - 1) >> 2) as u64) < stride {
        return jxl_err.JX_BAD
    }
    if *cpos >= commands_end {
        return jxl_err.JX_BAD
    }
    let num: u64 = jxl_icc_pred.read_varint(enc, size, cpos)
    if !within(*pos, num, size) {
        return jxl_err.JX_BAD
    }
    let n: usize = num as usize
    var tmp: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&tmp, enc +% ((*pos) as u64), n)
    if n > 0 && width > 1 && !jxl_icc_pred.shuffle_bytes(rt.buf_ptr(&tmp), n, width) {
        rt.buf_free(&tmp)
        return jxl_err.JX_MEMORY
    }
    var i: usize = 0
    while i < n {
        let pred: u8 = jxl_icc_pred.linear_predict(rt.buf_ptr(out), len, i, stride as usize, width, order)
        let v: u32 = ((pred as u32) + (rt.ld8(rt.buf_ptr(&tmp), i) as u32)) & 255
        rt.buf_push(out, v as u8)
        i = i + 1
    }
    *pos = *pos + n
    rt.buf_free(&tmp)
    return jxl_err.JX_OK
}

fn main_content(enc: u64, size: usize, cpos: *mut usize, commands_end: usize, pos: *mut usize, osize: u64, out: *mut rt.Buf) -> i32 {
    while true {
        if (rt.buf_len(out) as u64) > osize {
            return jxl_err.JX_BAD
        }
        if *cpos > commands_end {
            return jxl_err.JX_BAD
        }
        if *cpos == commands_end {
            break
        }
        let command: u32 = rt.ld8(enc, *cpos) as u32
        *cpos = *cpos + 1
        var r: i32 = jxl_err.JX_OK
        if command == CMD_INSERT {
            if *cpos >= commands_end {
                return jxl_err.JX_BAD
            }
            let num: u64 = jxl_icc_pred.read_varint(enc, size, cpos)
            if !within(*pos, num, size) {
                return jxl_err.JX_BAD
            }
            copy_data(enc, pos, num as usize, out)
        } else if command == CMD_SHUFFLE2 {
            r = cmd_shuffle(enc, size, cpos, commands_end, pos, 2, out)
        } else if command == CMD_SHUFFLE4 {
            r = cmd_shuffle(enc, size, cpos, commands_end, pos, 4, out)
        } else if command == CMD_PREDICT {
            r = cmd_predict(enc, size, cpos, commands_end, pos, out)
        } else if command == CMD_XYZ {
            jxl_icc_pred.push_be32(out, jxl_icc_pred.TAG_XYZ_TYPE)
            jxl_icc_pred.push_be32(out, 0)
            if !within(*pos, 12, size) {
                return jxl_err.JX_BAD
            }
            copy_data(enc, pos, 12, out)
        } else if command >= CMD_TYPE_FIRST && command < CMD_TYPE_FIRST + (jxl_icc_pred.NUM_TYPE_STRINGS as u32) {
            jxl_icc_pred.push_be32(out, jxl_icc_pred.type_string((command - CMD_TYPE_FIRST) as usize))
            jxl_icc_pred.push_be32(out, 0)
        } else {
            return jxl_err.JX_BAD
        }
        if r != jxl_err.JX_OK {
            return r
        }
        if rt.buf_len(out) > MAX_OUT_SIZE {
            return jxl_err.JX_TOO_LARGE
        }
    }
    return jxl_err.JX_OK
}

fn header_stage(enc: u64, size: usize, cpos: usize, commands_end: usize, pos: *mut usize, osize: u64, out: *mut rt.Buf, done: *mut bool) -> i32 {
    var header: rt.Buf = rt.buf_new()
    jxl_icc_pred.initial_header(&header)
    jxl_icc_pred.put_be32(rt.buf_ptr(&header), 0, osize as u32)
    var i: usize = 0
    var r: i32 = jxl_err.JX_OK
    while i <= jxl_icc_pred.HEADER_SIZE {
        if (rt.buf_len(out) as u64) == osize {
            if cpos != commands_end || *pos != size {
                r = jxl_err.JX_BAD
            }
            *done = true
            break
        }
        if i == jxl_icc_pred.HEADER_SIZE {
            break
        }
        jxl_icc_pred.predict_header(rt.buf_ptr(out), rt.buf_len(out), rt.buf_ptr(&header), i)
        if *pos >= size {
            r = jxl_err.JX_BAD
            break
        }
        let v: u32 = ((rt.ld8(enc, *pos) as u32) + (rt.buf_at(&header, i) as u32)) & 255
        rt.buf_push(out, v as u8)
        *pos = *pos + 1
        i = i + 1
    }
    rt.buf_free(&header)
    return r
}

fn icc_unpredict(enc: u64, size: usize, out: *mut rt.Buf) -> i32 {
    rt.buf_clear(out)
    var cpos: usize = 0
    if size == 0 {
        return jxl_err.JX_BAD
    }
    let osize: u64 = jxl_icc_pred.read_varint(enc, size, &cpos)
    if !fits32(osize) || cpos >= size {
        return jxl_err.JX_BAD
    }
    let csize: u64 = jxl_icc_pred.read_varint(enc, size, &cpos)
    if !fits32(csize) || !within(cpos, csize, size) {
        return jxl_err.JX_BAD
    }
    if (osize as usize) > MAX_OUT_SIZE {
        return jxl_err.JX_TOO_LARGE
    }
    let commands_end: usize = cpos + (csize as usize)
    var pos: usize = commands_end
    var done: bool = false
    var r: i32 = header_stage(enc, size, cpos, commands_end, &pos, osize, out, &done)
    if r != jxl_err.JX_OK || done {
        return r
    }
    if cpos >= commands_end {
        return jxl_err.JX_BAD
    }
    r = tag_list(enc, size, &cpos, commands_end, &pos, osize, out)
    if r != jxl_err.JX_OK {
        return r
    }
    r = main_content(enc, size, &cpos, commands_end, &pos, osize, out)
    if r != jxl_err.JX_OK {
        return r
    }
    if pos != size || (rt.buf_len(out) as u64) != osize {
        return jxl_err.JX_BAD
    }
    return jxl_err.JX_OK
}

fn read_symbols(b: *mut jxl_bits.JxlBits, rd: *mut jxl_code.JxlReader, enc_size: usize, dec: *mut rt.Buf) -> i32 {
    var i: usize = 0
    while i < enc_size {
        if (i & 1023) == 0 && jxl_bits.jb_over(b) {
            return jxl_err.JX_TRUNCATED
        }
        if (i & 65535) == 0 && i > 0 {
            let used_bytes: u64 = jxl_bits.jb_bit_pos(b) / 8
            if (i as u64) > used_bytes * 256 {
                return jxl_err.JX_BAD
            }
        }
        var b1: u32 = 0
        var b2: u32 = 0
        if i > 0 {
            b1 = rt.buf_at(dec, i - 1) as u32
        }
        if i > 1 {
            b2 = rt.buf_at(dec, i - 2) as u32
        }
        let v: u32 = jxl_code.reader_read(rd, b, jxl_icc_pred.ans_context(i, b1, b2))
        rt.buf_push(dec, (v & 255) as u8)
        i = i + 1
    }
    if jxl_bits.jb_over(b) {
        return jxl_err.JX_TRUNCATED
    }
    return jxl_err.JX_OK
}

fn icc_read(b: *mut jxl_bits.JxlBits, out: *mut rt.Buf) -> i32 {
    rt.buf_clear(out)
    let enc_size64: u64 = jxl_bits.jb_u64(b)
    if jxl_bits.jb_over(b) {
        return jxl_err.JX_TRUNCATED
    }
    if enc_size64 > MAX_ENC_SIZE {
        return jxl_err.JX_BAD
    }
    var code: jxl_code.JxlCode = jxl_code.code_new()
    var r: i32 = jxl_code.code_read(b, jxl_icc_pred.NUM_CONTEXTS, false, &code)
    if r != jxl_err.JX_OK {
        jxl_code.code_free(&code)
        return r
    }
    var rd: jxl_code.JxlReader = jxl_code.reader_new()
    r = jxl_code.reader_init(&rd, &code, b, 0)
    var dec: rt.Buf = rt.buf_new()
    if r == jxl_err.JX_OK {
        r = read_symbols(b, &rd, enc_size64 as usize, &dec)
    }
    if r == jxl_err.JX_OK && !jxl_code.reader_final_ok(&rd) {
        r = jxl_err.JX_BAD
    }
    if r == jxl_err.JX_OK {
        r = icc_unpredict(rt.buf_ptr(&dec), rt.buf_len(&dec), out)
    }
    rt.buf_free(&dec)
    jxl_code.reader_free(&rd)
    jxl_code.code_free(&code)
    return r
}

fn icc_discard(b: *mut jxl_bits.JxlBits) -> i32 {
    var out: rt.Buf = rt.buf_new()
    let r: i32 = icc_read(b, &out)
    rt.buf_free(&out)
    return r
}
