// SPDX-License-Identifier: MPL-2.0
import jxl.jxl_bits
import jxl.jxl_err
import jxl.jxl_f32

export {
    JxlQuant, quant_default, quant_read, lf_dequant_read, quant_inv_global_scale, quant_dc_step, quant_inv_dc_step,
}

const GLOBAL_SCALE_DENOM: f64 = 65536.0
const DC_ALMOST_ZERO: f64 = 0.0000000000000000000000000000000000001

struct JxlQuant {
    global_scale: u32,
    quant_dc: u32,
    dc_quant_x: f64,
    dc_quant_y: f64,
    dc_quant_b: f64,
}

fn quant_default() -> JxlQuant {
    return JxlQuant { global_scale: 32768, quant_dc: 64, dc_quant_x: 1.0 / 4096.0, dc_quant_y: 1.0 / 512.0, dc_quant_b: 1.0 / 256.0 }
}

fn quant_read(b: *mut jxl_bits.JxlBits, q: *mut JxlQuant) -> i32 {
    (*q).global_scale = jxl_bits.jb_u32(b, jxl_bits.jd_off(11, 1), jxl_bits.jd_off(11, 2049), jxl_bits.jd_off(12, 4097), jxl_bits.jd_off(16, 8193))
    (*q).quant_dc = jxl_bits.jb_u32(b, jxl_bits.jd_val(16), jxl_bits.jd_off(5, 1), jxl_bits.jd_off(8, 1), jxl_bits.jd_off(16, 1))
    if jxl_bits.jb_over(b) {
        return jxl_err.JX_TRUNCATED
    }
    return jxl_err.JX_OK
}

fn lf_dequant_read(b: *mut jxl_bits.JxlBits, q: *mut JxlQuant) -> i32 {
    let all_default: bool = jxl_bits.jb_bit(b)
    if jxl_bits.jb_over(b) {
        return jxl_err.JX_TRUNCATED
    }
    if all_default {
        return jxl_err.JX_OK
    }
    let x: f64 = jxl_bits.jb_f16(b) / 128.0
    let y: f64 = jxl_bits.jb_f16(b) / 128.0
    let z: f64 = jxl_bits.jb_f16(b) / 128.0
    if jxl_bits.jb_over(b) {
        return jxl_err.JX_TRUNCATED
    }
    if x < DC_ALMOST_ZERO || y < DC_ALMOST_ZERO || z < DC_ALMOST_ZERO {
        return jxl_err.JX_BAD
    }
    (*q).dc_quant_x = x
    (*q).dc_quant_y = y
    (*q).dc_quant_b = z
    return jxl_err.JX_OK
}

fn quant_inv_global_scale(q: *mut JxlQuant) -> f64 {
    return GLOBAL_SCALE_DENOM / ((*q).global_scale as f64)
}

fn dc_quant_of(q: *mut JxlQuant, c: usize) -> f64 {
    if c == 0 {
        return (*q).dc_quant_x
    }
    if c == 1 {
        return (*q).dc_quant_y
    }
    return (*q).dc_quant_b
}

fn quant_dc_step(q: *mut JxlQuant, c: usize) -> f64 {
    let inv_global: f64 = jxl_f32.round32(quant_inv_global_scale(q))
    let inv_quant_dc: f64 = jxl_f32.round32(inv_global / jxl_f32.round32((*q).quant_dc as f64))
    return jxl_f32.round32(inv_quant_dc * jxl_f32.round32(dc_quant_of(q, c)))
}

fn quant_inv_dc_step(q: *mut JxlQuant, c: usize) -> f64 {
    return (1.0 / dc_quant_of(q, c)) * (((*q).global_scale as f64) / GLOBAL_SCALE_DENOM * ((*q).quant_dc as f64))
}
