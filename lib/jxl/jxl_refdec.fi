// lib/jxl/jxl_refdec.fi -- jxl_refdec: decode reference-only frames into XYB float planes for patches
import jxl.jxl_err
import jxl.jxl_frame
import jxl.jxl_lfglobal
import jxl.jxl_mdec
import jxl.jxl_open
import jxl.jxl_refs

export { refdec_modular, refdec_note_frame }

const MAX_REF_PIXELS: u64 = 16777216
const UNSUPPORTED_FLAGS: u64 = 19

fn refdec_note_frame(refs: *mut jxl_refs.JxlRefs, visible: bool) {
    if visible {
        (*refs).visible = (*refs).visible + 1
        (*refs).nonvisible = 0
    } else {
        (*refs).nonvisible = (*refs).nonvisible + 1
    }
}

fn refdec_modular(d: *mut jxl_open.JxlDoc, refs: *mut jxl_refs.JxlRefs) -> i32 {
    let f: *mut jxl_frame.JxlFrame = &(*d).frame
    if !(*f).save_before_ct || (*f).upsampling != 1 || ((*f).flags & UNSUPPORTED_FLAGS) != 0 {
        return jxl_err.JX_UNSUPPORTED
    }
    var r: i32 = jxl_mdec.mdec_check(d)
    if r != jxl_err.JX_OK {
        return r
    }
    if ((*f).width as u64) * ((*f).height as u64) > MAX_REF_PIXELS {
        return jxl_err.JX_TOO_LARGE
    }
    var g: jxl_lfglobal.JxlLfGlobal = jxl_lfglobal.lfg_new()
    r = jxl_mdec.mdec_read(d, &g)
    if r == jxl_err.JX_OK {
        let w: usize = (*f).width as usize
        let h: usize = (*f).height as usize
        let planes: u64 = jxl_mdec.mdec_planes(d, &g)
        if planes == 0 {
            r = jxl_err.JX_MEMORY
        } else {
            jxl_refs.refs_store(refs, (*f).save_slot as usize, planes, w, w * h, w, h)
        }
    }
    jxl_lfglobal.lfg_free(&g)
    return r
}
