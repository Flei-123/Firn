// lib/jxl/jxl_refdec.fi -- jxl_refdec: decode reference-only frames into XYB float planes for patches
import std.rt
import std.vec
import jxl.jxl_bits
import jxl.jxl_err
import jxl.jxl_frame
import jxl.jxl_img
import jxl.jxl_mem
import jxl.jxl_modular
import jxl.jxl_open
import jxl.jxl_refs
import jxl.jxl_stream
import jxl.jxl_wp
import jxl.jxl_xform

export { refdec_modular, refdec_note_frame }

const MAX_REF_PIXELS: u64 = 16777216
const UNSUPPORTED_FLAGS: u64 = 19

fn refdec_note_frame(refs: *mut jxl_refs.JxlRefs, visible: bool) {
    if visible {
        (*refs).visible = (*refs).visible + 1
        (*refs).nonvisible = 0
    } else {
        (*refs).nonvisible = (*refs).nonvisible + 1
    }
}

fn read_dc_quant(b: *mut jxl_bits.JxlBits, q: *mut [f64; 3]) {
    (*q)[0] = 1.0 / 4096.0
    (*q)[1] = 1.0 / 512.0
    (*q)[2] = 1.0 / 256.0
    if !jxl_bits.jb_bit(b) {
        var k: usize = 0
        while k < 3 {
            (*q)[k] = jxl_bits.jb_f16(b) / 128.0
            k = k + 1
        }
    }
}

fn fst(p: u64, i: usize, v: f64) {
    *((p +% ((i * 8) as u64)) as *mut f64) = v
}

fn to_planes(img: *mut jxl_img.JxlImage, q: *mut [f64; 3], w: usize, h: usize, planes: u64) {
    let y: u64 = jxl_img.img_data(img, 0)
    let x: u64 = jxl_img.img_data(img, 1)
    let b: u64 = jxl_img.img_data(img, 2)
    let n: usize = w * h
    var i: usize = 0
    while i < n {
        let yv: i32 = jxl_mem.ldi(y, i)
        fst(planes, i, (jxl_mem.ldi(x, i) as f64) * (*q)[0])
        fst(planes, n + i, (yv as f64) * (*q)[1])
        fst(planes, 2 * n + i, ((jxl_mem.ldi(b, i) as f64) + (yv as f64)) * (*q)[2])
        i = i + 1
    }
}

fn refdec_modular(d: *mut jxl_open.JxlDoc, refs: *mut jxl_refs.JxlRefs) -> i32 {
    let f: *mut jxl_frame.JxlFrame = &(*d).frame
    let slot: usize = (*f).save_slot as usize
    if (*f).encoding != jxl_frame.JF_MODULAR || !(*d).meta.xyb_encoded || !(*f).save_before_ct || (*f).do_ycbcr || (*f).upsampling != 1 || (*f).ec_upsampled || ((*f).flags & UNSUPPORTED_FLAGS) != 0 {
        return jxl_err.JX_UNSUPPORTED
    }
    let w: usize = (*f).width as usize
    let h: usize = (*f).height as usize
    if w == 0 || h == 0 || (w as u64) * (h as u64) > MAX_REF_PIXELS {
        return jxl_err.JX_TOO_LARGE
    }
    var img: jxl_img.JxlImage = jxl_img.img_new()
    var ms: jxl_stream.JxlModState = jxl_stream.ms_new()
    var wph: jxl_wp.JxlWpHeader = jxl_wp.wp_header_default()
    var xfs: vec.Vec[jxl_xform.JxlXform] = vec.vec_new[jxl_xform.JxlXform]()
    var q: [f64; 3] = [0.0; 3]
    var sb: jxl_bits.JxlBits = jxl_open.doc_section(d, 0)
    read_dc_quant(&sb, &q)
    var r: i32 = jxl_modular.decode_global(&sb, &(*d).meta, f, &img, &ms, &wph, &xfs)
    if r == jxl_err.JX_OK && (*f).toc_count != 1 {
        r = jxl_modular.decode_groups(&(*d).cs, f, &img, &ms, (*d).meta.depth.bits as i64)
    }
    if r == jxl_err.JX_OK {
        r = jxl_stream.xfs_inverse(&xfs, &img, &wph, (*d).meta.depth.bits as i64)
    }
    if r == jxl_err.JX_OK {
        var c: usize = 0
        if jxl_img.img_count(&img) < 3 {
            r = jxl_err.JX_BAD
        }
        while r == jxl_err.JX_OK && c < 3 {
            if jxl_img.img_w(&img, c) != w || jxl_img.img_h(&img, c) != h || jxl_img.img_data(&img, c) == 0 {
                r = jxl_err.JX_BAD
            }
            c = c + 1
        }
    }
    if r == jxl_err.JX_OK {
        let planes: u64 = rt.heap_alloc(w * h * 3 * 8)
        if planes == 0 {
            r = jxl_err.JX_MEMORY
        } else {
            to_planes(&img, &q, w, h, planes)
            jxl_refs.refs_store(refs, slot, planes, w, w * h, w, h)
        }
    }
    jxl_stream.xfs_free(&xfs)
    jxl_stream.ms_free(&ms)
    jxl_img.img_free(&img)
    return r
}
