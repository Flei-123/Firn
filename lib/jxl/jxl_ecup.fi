// SPDX-License-Identifier: MPL-2.0
// lib/jxl/jxl_ecup.fi -- jxl_ecup: upsample integer extra channels (alpha, depth, ...) with the frame upsampling kernel
import std.rt
import jxl.jxl_err
import jxl.jxl_header
import jxl.jxl_img
import jxl.jxl_mem
import jxl.jxl_upsample

export { ecup_channel }

fn ecup_channel(m: *mut jxl_header.JxlMeta, kern: u64, factor: usize, src: *mut jxl_img.JxlImage, c: usize, maxval: f64, dst: *mut jxl_img.JxlImage, out_w: usize, out_h: usize) -> i32 {
    let w: usize = jxl_img.img_w(src, c)
    let h: usize = jxl_img.img_h(src, c)
    let in_bytes: usize = w * h * 8
    let out_bytes: usize = out_w * out_h * 8
    let fin: u64 = rt.heap_alloc(in_bytes)
    let fout: u64 = rt.heap_alloc(out_bytes)
    if fin == 0 || fout == 0 {
        if fin != 0 {
            rt.heap_free(fin, in_bytes)
        }
        if fout != 0 {
            rt.heap_free(fout, out_bytes)
        }
        return jxl_err.JX_MEMORY
    }
    let sp: u64 = jxl_img.img_data(src, c)
    var i: usize = 0
    while i < w * h {
        *((fin +% ((i * 8) as u64)) as *mut f64) = (jxl_mem.ldi(sp, i) as f64) / maxval
        i = i + 1
    }
    jxl_upsample.ups_plane(kern, factor, fin, w, h, w, fout, out_w, out_h)
    jxl_img.img_add(dst, out_w, out_h, 0, 0)
    let dc: usize = jxl_img.img_count(dst) - 1
    let dp: u64 = jxl_img.img_data(dst, dc)
    var r: i32 = jxl_err.JX_OK
    if dp == 0 {
        r = jxl_err.JX_MEMORY
    }
    i = 0
    while r == jxl_err.JX_OK && i < out_w * out_h {
        var v: f64 = *((fout +% ((i * 8) as u64)) as *mut f64) * maxval + 0.5
        if v < 0.0 {
            v = 0.0
        }
        if v > maxval {
            v = maxval
        }
        jxl_mem.sti(dp, i, v as i32)
        i = i + 1
    }
    rt.heap_free(fin, in_bytes)
    rt.heap_free(fout, out_bytes)
    return r
}
