// lib/jxl/jxl_ecup.fi -- jxl_ecup: upsample extra channels (integer and float samples) with a per-channel factor
import std.core
import std.rt
import jxl.jxl_dither
import jxl.jxl_err
import jxl.jxl_float
import jxl.jxl_header
import jxl.jxl_img
import jxl.jxl_mem
import jxl.jxl_upsample

export { ecup_channel, ecup_normalize_float }

fn sample_in(sp: u64, i: usize, depth: jxl_header.JxlBitDepth, maxval: f64) -> f64 {
    let raw: i32 = jxl_mem.ldi(sp, i)
    if depth.is_float {
        return core.bits_f32(jxl_float.int_to_float_bits(raw as i64, depth.bits, depth.exp_bits) as u32) as f64
    }
    return (raw as f64) / maxval
}

fn sample_out(dp: u64, i: usize, depth: jxl_header.JxlBitDepth, maxval: f64, value: f64, dither_c: i32, out_w: usize) {
    if depth.is_float {
        jxl_mem.sti(dp, i, jxl_mem.wrap_i32(core.f32_bits(value as f32) as i64))
        return
    }
    if dither_c >= 0 && depth.bits == 8 && jxl_dither.dither_enabled() {
        jxl_mem.sti(dp, i, jxl_dither.dither_quantize(value, maxval, i % out_w, i / out_w, dither_c as usize))
        return
    }
    var v: f64 = value * maxval + 0.5
    if v < 0.0 {
        v = 0.0
    }
    if v > maxval {
        v = maxval
    }
    jxl_mem.sti(dp, i, v as i32)
}

fn depth_max(depth: jxl_header.JxlBitDepth) -> f64 {
    if depth.is_float {
        return 1.0
    }
    return (((1 as u32) << depth.bits) - 1) as f64
}

fn ecup_normalize_float(img: *mut jxl_img.JxlImage, c: usize, depth: jxl_header.JxlBitDepth) {
    let p: u64 = jxl_img.img_data(img, c)
    let n: usize = jxl_img.img_w(img, c) * jxl_img.img_h(img, c)
    var i: usize = 0
    while p != 0 && i < n {
        jxl_mem.sti(p, i, jxl_mem.wrap_i32(jxl_float.int_to_float_bits(jxl_mem.ldi(p, i) as i64, depth.bits, depth.exp_bits) as i64))
        i = i + 1
    }
}

fn ecup_channel(kern: u64, factor: usize, src: *mut jxl_img.JxlImage, c: usize, depth: jxl_header.JxlBitDepth, dst: *mut jxl_img.JxlImage, out_w: usize, out_h: usize, dither_c: i32) -> i32 {
    let w: usize = jxl_img.img_w(src, c)
    let h: usize = jxl_img.img_h(src, c)
    let in_bytes: usize = w * h * 8
    let out_bytes: usize = out_w * out_h * 8
    let fin: u64 = rt.heap_alloc(in_bytes)
    let fout: u64 = rt.heap_alloc(out_bytes)
    if fin == 0 || fout == 0 {
        if fin != 0 {
            rt.heap_free(fin, in_bytes)
        }
        if fout != 0 {
            rt.heap_free(fout, out_bytes)
        }
        return jxl_err.JX_MEMORY
    }
    let maxval: f64 = depth_max(depth)
    let sp: u64 = jxl_img.img_data(src, c)
    var i: usize = 0
    while i < w * h {
        *((fin +% ((i * 8) as u64)) as *mut f64) = sample_in(sp, i, depth, maxval)
        i = i + 1
    }
    jxl_upsample.ups_plane(kern, factor, fin, w, h, w, fout, out_w, out_h)
    jxl_img.img_add(dst, out_w, out_h, 0, 0)
    let dc: usize = jxl_img.img_count(dst) - 1
    let dp: u64 = jxl_img.img_data(dst, dc)
    var r: i32 = jxl_err.JX_OK
    if dp == 0 {
        r = jxl_err.JX_MEMORY
    }
    i = 0
    while r == jxl_err.JX_OK && i < out_w * out_h {
        sample_out(dp, i, depth, maxval, *((fout +% ((i * 8) as u64)) as *mut f64), dither_c, out_w)
        i = i + 1
    }
    rt.heap_free(fin, in_bytes)
    rt.heap_free(fout, out_bytes)
    return r
}
