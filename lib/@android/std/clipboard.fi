// lib/@android/std/clipboard.fi -- std.clipboard on Android (picked instead of
// lib/std/clipboard.fi by the Android target): there is NO windowless clipboard
// there. The system clipboard of an Android program is the one of its Window
// (lib/window/android.fi, `window.clipboard_set` / `clipboard_get`), and a
// program with a window uses those. Every function answers false (no crash).

import std.rt
import std.str

export {
    copy_text, paste_text, has_text, clear,
    copy_png, paste_png, has_png,
    serve, backend_name,
    copy_html, paste_html, has_html, copy_multi, change_token, token_exact, types, paste_format, add_format,
}

fn copy_text(s: str) -> bool {
    return false
}

fn paste_text(out: *mut rt.Buf) -> bool {
    return false
}

fn has_text() -> bool {
    return false
}

fn clear() -> bool {
    return false
}

fn copy_png(p: u64, n: usize) -> bool {
    return false
}

fn paste_png(out: *mut rt.Buf) -> bool {
    return false
}

fn has_png() -> bool {
    return false
}

fn serve(ms: i64) {
}

fn backend_name() -> str {
    return "none"
}

// HTML, several formats at once and the change token: not here (the browser reads one type per call; Android has no
// clipboard through this file). Same names as the Linux/Windows file so a program builds everywhere.
fn copy_html(html: str, plain: str) -> bool {
    return false
}

fn paste_html(out: *mut rt.Buf) -> bool {
    return false
}

fn has_html() -> bool {
    return false
}

fn copy_multi(text: str, html: str, png_p: u64, png_n: usize) -> bool {
    if text.length() > 0 && png_n == 0 && html.length() == 0 {
        return copy_text(text)
    }
    return false
}

fn change_token() -> u64 {
    return 0 as u64
}

fn token_exact() -> bool {
    return false
}

fn types(out: *mut rt.Buf) -> usize {
    return 0
}

fn paste_format(mime: str, out: *mut rt.Buf) -> bool {
    return false
}

fn add_format(mime: str, p: u64, n: usize) -> bool {
    return false
}
