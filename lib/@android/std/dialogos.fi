// SPDX-License-Identifier: MPL-2.0
// lib/@android/std/dialogos.fi -- the operating system half of std.dialog on Android (picked instead of
// lib/std/dialogos.fi by the Android target). There is NO windowless dialog on Android: the system pickers
// (ACTION_OPEN_DOCUMENT, ACTION_CREATE_DOCUMENT, the colour and font choosers a program draws itself) are started
// from an Activity and answer through onActivityResult, which a program with a window handles (lib/window/android.fi).
// Every call answers NO_BACKEND, nothing crashes. Roadmap: the document picker through the window layer.

import std.rt
import std.str

export { os_name, os_file, os_color, os_font, os_message }

const NO_BACKEND: i32 = 2

fn os_name() -> str {
    return "none"
}

fn os_file(mode: i32, title: str, dir: str, name: str, filters: str, out: *mut rt.Buf) -> i32 {
    return NO_BACKEND
}

fn os_color(title: str, initial: u32, out: *mut u32) -> i32 {
    return NO_BACKEND
}

fn os_font(title: str, family: str, size: u32, out_family: *mut rt.Buf, out_size: *mut u32, out_flags: *mut u32) -> i32 {
    return NO_BACKEND
}

fn os_message(kind: i32, title: str, text: str, buttons: i32, answer: *mut i32) -> i32 {
    return NO_BACKEND
}
