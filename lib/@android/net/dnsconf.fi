// SPDX-License-Identifier: MPL-2.0
// lib/@android/net/dnsconf.fi -- WHERE THE NAME SERVERS AND THE HOSTS TABLE
// COME FROM, on Android. `import net.dnsconf` takes this file on the
// android targets (target::platform_dir, lib/@android/ before lib/); the
// Linux reference is lib/net/dnsconf.fi, the Windows twin
// lib/net/dnsconf.windows.fi. Same contract: TEXT in the format of
// resolv.conf / hosts, false when there is nothing.
//
// WHY A FILE OF ITS OWN. Android has no /etc/resolv.conf: a program that
// reads it gets nothing and the resolver (lib/net/dns.fi, D6) falls back
// to 1.1.1.1 and 8.8.8.8. That works on an open network, but ignores the
// resolver of the network the phone is on (a company network that blocks
// public DNS, a captive portal, the emulator's 10.0.2.3). The sources, in
// this order:
//
//   1. /etc/resolv.conf       (rooted devices, Termux-like chroots)
//   2. the system properties  net.dns1 .. net.dns4, then
//                             dhcp.wlan0.dns1 .. 4, dhcp.eth0.dns1 .. 4
//                             (bionic's __system_property_get)
//   3. ConnectivityManager -> LinkProperties.getDnsServers() through JNI
//      (the reliable source since Android 8; needs the activity, so only
//      inside an app, and ACCESS_NETWORK_STATE -- without it the call throws,
//      the exception is cleared and source 4 applies)
//   4. nothing -> false -> the public fallback of dns.fi
//
// HONEST
//   A1 Since Android 8 (API 26) an app cannot read net.dns* any more: the
//      properties are hidden from it (SELinux), the call returns an empty
//      value. Then source 3 applies -- the same behaviour as before this
//      file, never worse. The reliable source on those versions is
//      ConnectivityManager -> LinkProperties.getDnsServers() through JNI,
//      which needs a Context: source 3 (`jni_dns_servers`) does that.
//   A2 Property values that are not a dotted IPv4 address (an IPv6 server,
//      a name) are skipped; the resolver text only gets what the parser of
//      dns.fi would accept anyway.
//   A3 The hosts table is /system/etc/hosts (Android's own, localhost
//      only on a stock system), then /etc/hosts.
import std.rt
import android.ndk
import android.activity
import android.jnicall

export { conf_resolv, conf_hosts, prop_ipv4_ok }

// bionic: int __system_property_get(const char *name, char *value);
// value has room for PROP_VALUE_MAX = 92 octets. Plain C, cannot start a
// collection.
#[no_gc]
#[link_name(__system_property_get)]
extern fn system_property_get(name: u64, value: u64) -> i32;

const PROP_VALUE_MAX: usize = 92

// "a.b.c.d" with 1-3 digits per octet, each <= 255, and nothing else
// (no sign, no space, no port): the only form a property is trusted in.
fn prop_ipv4_ok(p: u64, n: usize) -> bool {
    var parts: usize = 1
    var digits: usize = 0
    var val: u32 = 0
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c >= 48 as u8 && c <= 57 as u8 {
            val = val * 10 as u32 + (c - 48 as u8) as u32
            digits = digits + 1
            if digits > 3 || val > 255 as u32 {
                return false
            }
        } else if c == 46 as u8 && digits > 0 {
            parts = parts + 1
            digits = 0
            val = 0 as u32
        } else {
            return false
        }
        i = i + 1
    }
    return parts == 4 && digits > 0
}

// One property -> "nameserver <value>\n". `name` is zero terminated.
fn push_prop(out: *mut rt.Buf, name: u64) -> bool {
    var val: [u8; 92] = [0 as u8; 92]
    let n: i32 = system_property_get(name, (&val[0]) as u64)
    if n <= 0 || n as usize >= PROP_VALUE_MAX {
        return false
    }
    if !prop_ipv4_ok((&val[0]) as u64, n as usize) {
        return false
    }
    var word: [u8; 11] = "nameserver "
    rt.buf_push_bytes(out, (&word[0]) as u64, 11)
    rt.buf_push_bytes(out, (&val[0]) as u64, n as usize)
    rt.buf_push(out, 10 as u8)
    return true
}

// "<prefix><k>\0" for k = 1 .. 4 -> push_prop; returns how many were taken.
fn push_prefix(out: *mut rt.Buf, prefix: u64, plen: usize) -> usize {
    var name: [u8; 40] = [0 as u8; 40]
    var i: usize = 0
    while i < plen && i < 32 {
        name[i] = rt.ld8(prefix, i)
        i = i + 1
    }
    var taken: usize = 0
    var k: usize = 1
    while k <= 4 {
        name[plen] = (48 + k) as u8
        name[plen + 1] = 0 as u8
        if push_prop(out, (&name[0]) as u64) {
            taken = taken + 1
        }
        k = k + 1
    }
    return taken
}

// ConnectivityManager.getActiveNetwork() -> getLinkProperties(net) ->
// getDnsServers() -> each InetAddress.getHostAddress(); the IPv4 ones become
// text of the addresses (16 octet slots, NUL ended, at most 4) is copied to
// `slots`; jni_dns_servers turns the IPv4 ones into resolv.conf lines.
// Runs once per resolver init, not per lookup. #[no_gc]: JNI.
#[no_gc]
fn jni_dns_raw(slots: u64) -> usize {
    let act: u64 = activity.activity_pointer()
    if act == 0 {
        return 0
    }
    let env: u64 = jnicall.j_env(ndk.peek64(act + 8))
    let ctx: u64 = ndk.peek64(act + 24)
    if env == 0 || ctx == 0 {
        return 0
    }
    var s_conn: [u8; _] = "connectivity\0"
    var n_gss: [u8; _] = "getSystemService\0"
    var sg_gss: [u8; _] = "(Ljava/lang/String;)Ljava/lang/Object;\0"
    var n_gan: [u8; _] = "getActiveNetwork\0"
    var sg_gan: [u8; _] = "()Landroid/net/Network;\0"
    var n_glp: [u8; _] = "getLinkProperties\0"
    var sg_glp: [u8; _] = "(Landroid/net/Network;)Landroid/net/LinkProperties;\0"
    var n_gds: [u8; _] = "getDnsServers\0"
    var sg_gds: [u8; _] = "()Ljava/util/List;\0"
    var n_size: [u8; _] = "size\0"
    var sg_size: [u8; _] = "()I\0"
    var n_get: [u8; _] = "get\0"
    var sg_get: [u8; _] = "(I)Ljava/lang/Object;\0"
    var n_gha: [u8; _] = "getHostAddress\0"
    var sg_gha: [u8; _] = "()Ljava/lang/String;\0"
    var a: [u64; 2] = [0; 2]
    let ap: u64 = (&a[0]) as u64
    let kc: u64 = jnicall.j_obj_class(env, ctx)
    let jn: u64 = jnicall.j_str(env, (&s_conn[0]) as u64)
    a[0] = jn
    let cm: u64 = jnicall.j_obj(env, ctx,
        jnicall.j_method(env, kc, (&n_gss[0]) as u64, (&sg_gss[0]) as u64), ap)
    jnicall.j_del(env, jn)
    jnicall.j_del(env, kc)
    if cm == 0 {
        return 0
    }
    let kcm: u64 = jnicall.j_obj_class(env, cm)
    let net: u64 = jnicall.j_obj(env, cm,
        jnicall.j_method(env, kcm, (&n_gan[0]) as u64, (&sg_gan[0]) as u64), 0)
    if net == 0 {
        jnicall.j_del(env, kcm)
        jnicall.j_del(env, cm)
        return 0
    }
    a[0] = net
    let lp: u64 = jnicall.j_obj(env, cm,
        jnicall.j_method(env, kcm, (&n_glp[0]) as u64, (&sg_glp[0]) as u64), ap)
    jnicall.j_del(env, net)
    jnicall.j_del(env, kcm)
    jnicall.j_del(env, cm)
    if lp == 0 {
        return 0
    }
    let klp: u64 = jnicall.j_obj_class(env, lp)
    let list: u64 = jnicall.j_obj(env, lp,
        jnicall.j_method(env, klp, (&n_gds[0]) as u64, (&sg_gds[0]) as u64), 0)
    jnicall.j_del(env, klp)
    jnicall.j_del(env, lp)
    if list == 0 {
        return 0
    }
    let kl: u64 = jnicall.j_obj_class(env, list)
    let m_size: u64 = jnicall.j_method(env, kl, (&n_size[0]) as u64, (&sg_size[0]) as u64)
    let m_get: u64 = jnicall.j_method(env, kl, (&n_get[0]) as u64, (&sg_get[0]) as u64)
    let total: i32 = jnicall.j_int(env, list, m_size, 0)
    var taken: usize = 0
    var i: i32 = 0
    while i < total && i < 8 && taken < 4 {
        a[0] = i as u64
        let ia: u64 = jnicall.j_obj(env, list, m_get, ap)
        if ia != 0 {
            let kia: u64 = jnicall.j_obj_class(env, ia)
            let js: u64 = jnicall.j_obj(env, ia,
                jnicall.j_method(env, kia, (&n_gha[0]) as u64, (&sg_gha[0]) as u64), 0)
            jnicall.j_del(env, kia)
            jnicall.j_del(env, ia)
            if js != 0 {
                let chars: u64 = jnicall.j_utf_chars(env, js)
                if chars != 0 {
                    // copy the text (<= 15 octets) into slot `taken` of 16 octets, NUL ended
                    var n: usize = 0
                    while n < 15 && *((chars + n as u64) as *mut u8) != 0 as u8 {
                        *((slots + (taken * 16 + n) as u64) as *mut u8) = *((chars + n as u64) as *mut u8)
                        n = n + 1
                    }
                    *((slots + (taken * 16 + n) as u64) as *mut u8) = 0 as u8
                    if *((chars + n as u64) as *mut u8) == 0 as u8 && n > 0 {
                        taken = taken + 1
                    }
                    jnicall.j_utf_release(env, js, chars)
                }
                jnicall.j_del(env, js)
            }
        }
        i = i + 1
    }
    jnicall.j_del(env, kl)
    jnicall.j_del(env, list)
    return taken
}

fn jni_dns_servers(out: *mut rt.Buf) -> usize {
    var slots: [u8; 64] = [0 as u8; 64]
    let k: usize = jni_dns_raw((&slots[0]) as u64)
    var taken: usize = 0
    var i: usize = 0
    while i < k {
        let p: u64 = ((&slots[0]) as u64) + (i * 16) as u64
        var n: usize = 0
        while n < 16 && rt.ld8(p, n) != 0 as u8 {
            n = n + 1
        }
        // an IPv6 text has colons and fails prop_ipv4_ok: skipped (A2)
        if prop_ipv4_ok(p, n) {
            var word: [u8; 11] = "nameserver "
            rt.buf_push_bytes(out, (&word[0]) as u64, 11)
            rt.buf_push_bytes(out, p, n)
            rt.buf_push(out, 10 as u8)
            taken = taken + 1
        }
        i = i + 1
    }
    return taken
}

fn conf_resolv(out: *mut rt.Buf) -> bool {
    var path: [u8; 17] = "/etc/resolv.conf\0"
    var file: rt.Buf = rt.buf_new()
    let have: bool = rt.read_file((&path[0]) as u64, &file)
    if have && file.len > 0 {
        rt.buf_push_bytes(out, file.ptr, file.len)
        rt.buf_free(&file)
        return true
    }
    rt.buf_free(&file)
    var taken: usize = jni_dns_servers(out)
    if taken > 0 {
        return true
    }
    var p1: [u8; 7] = "net.dns"
    taken = push_prefix(out, (&p1[0]) as u64, 7)
    if taken == 0 {
        var p2: [u8; 14] = "dhcp.wlan0.dns"
        taken = push_prefix(out, (&p2[0]) as u64, 14)
    }
    if taken == 0 {
        var p3: [u8; 13] = "dhcp.eth0.dns"
        taken = push_prefix(out, (&p3[0]) as u64, 13)
    }
    return taken > 0
}

fn conf_hosts(out: *mut rt.Buf) -> bool {
    var sys: [u8; 18] = "/system/etc/hosts\0"
    if rt.read_file((&sys[0]) as u64, out) {
        return true
    }
    var path: [u8; 11] = "/etc/hosts\0"
    return rt.read_file((&path[0]) as u64, out)
}
