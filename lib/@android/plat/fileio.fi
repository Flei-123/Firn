// SPDX-License-Identifier: MPL-2.0
// lib/@android/plat/fileio.fi -- the Android side of lib/plat/fileio.fi: MediaStore Downloads/Jarvis (no storage permission),
// then ACTION_VIEW or the chooser (plat.android.share).
import std.rt
import plat.android.share

export { fio_available, fio_open, fio_share, fio_open_url }

fn fio_available() -> bool { return true }

fn cstr(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
    rt.buf_push(b, 0 as u8)
}

// 0 = failed; saved, the Uri is remembered for view / send
fn save(data: u64, n: usize, name: str, mime: str) -> bool {
    if data == 0 || n == 0 || name.n == 0 { return false }
    var nb: rt.Buf = rt.buf_new()
    var mb: rt.Buf = rt.buf_new()
    var sb: rt.Buf = rt.buf_new()
    cstr(&nb, name)
    cstr(&mb, mime)
    cstr(&sb, "Jarvis")
    let r: i32 = share.share_save(data, n, nb.ptr, mb.ptr, sb.ptr)
    rt.buf_free(&nb)
    rt.buf_free(&mb)
    rt.buf_free(&sb)
    return r != 0
}

fn fio_open(data: u64, n: usize, name: str, mime: str) -> bool {
    if !save(data, n, name, mime) { return false }
    return share.share_view_last()
}

fn fio_share(data: u64, n: usize, name: str, mime: str) -> bool {
    if !save(data, n, name, mime) { return false }
    var tb: rt.Buf = rt.buf_new()
    cstr(&tb, "Send")
    let ok: bool = share.share_send_last(tb.ptr)
    rt.buf_free(&tb)
    return ok
}

// ACTION_VIEW on an https:// address (the browser); false = not an https address or no activity
fn fio_open_url(url: str) -> bool {
    if url.n < 9 || url.n > 2000 { return false }
    if rt.ld8(url.p as u64, 0) != 104 as u8 || rt.ld8(url.p as u64, 4) != 115 as u8 { return false }
    var b: rt.Buf = rt.buf_new()
    cstr(&b, url)
    let ok: bool = share.share_open_url(b.ptr)
    rt.buf_free(&b)
    return ok
}
