// lib/@android/plat/cliptext.fi -- the Android side of lib/plat/cliptext.fi: ClipboardManager.setPrimaryClip through JNI.
// (window.clipboard_set answers false on this backend, so apps call this instead.)
import plat.android.share

export { clip_put, CLIP_NATIVE }

const CLIP_NATIVE: bool = true

fn clip_put(p: u64, n: usize) -> bool { return share.clip_write(p, n) }
