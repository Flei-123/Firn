import std.rt
import std.time
import plat.hostev
import plat.android.hostbus
import plat.android.hostfetch
import plat.android.hoststream
import plat.android.hoststore
import plat.android.hostorigin
import plat.android.hostedit
import plat.android.hostroute
import plat.android.hostpick
import plat.android.hostshare
import plat.android.hostinsets
import plat.android.share
import plat.tzinfo

export {
    fetch, stream_open, stream_close, navigate, location,
    store_get, store_set,
    keyboard, edit_mode, edit_wrap, edit_set,
    tz_offset, tz_reset, wake_in, dark, font_extra,
    clip_write, clip_read, backend_name,
    notify, pick, save, share, back_hold, insets, origin,
}

const CLIP_TEXT_CAP: usize = 65536
const SECONDS_PER_MINUTE: i64 = 60
const MS_PER_SECOND: i64 = 1000

fn backend_name() -> str { return "android" }

fn fetch(id: u32, method: u64, mn: usize, url: u64, un: usize, body: u64, bn: usize) {
    hostfetch.fetch_start(id, method, mn, url, un, body, bn)
}

fn stream_open(url: u64, un: usize) {
    hoststream.stream_begin(url, un)
}

fn stream_close() {
    hoststream.stream_end()
}

fn navigate(url: u64, un: usize) {
    hostroute.navigate(url, un)
}

fn location(out: u64, cap: usize) -> usize {
    return hostroute.location(out, cap)
}

fn store_get(key: u64, kn: usize, out: u64, cap: usize) -> usize {
    return hoststore.store_read(key, kn, out, cap)
}

fn store_set(key: u64, kn: usize, v: u64, vn: usize) {
    let saved: bool = hoststore.store_write(key, kn, v, vn)
}

fn keyboard(show: bool, x: f64, y: f64, fw: f64, fh: f64) {
    hostedit.keyboard(show, x, y, fw, fh)
}

fn edit_mode(on: bool, font: f64, line: f64, left: f64, top: f64, right: f64) {
    hostedit.edit_mode(on, font, line, left, top, right)
}

fn edit_wrap(wrap: bool) {
    hostedit.edit_wrap(wrap)
}

fn edit_set(p: u64, n: usize, cur: usize, anc: usize, scroll: f64) {
    hostedit.edit_set(p, n, cur, anc, scroll)
}

fn tz_offset(stamp: u64) -> i64 {
    let minutes: i64 = tzinfo.tz_offset_min((stamp as i64) * MS_PER_SECOND)
    if minutes == tzinfo.TZ_UNKNOWN { return 0 as i64 }
    return minutes * SECONDS_PER_MINUTE
}

fn tz_reset() {}

fn wake_in(ms: f64) {
    hostbus.bus_wake_in(time.monotonic_ns() as f64 / 1000000.0, ms)
}

fn dark() -> bool { return hostbus.bus_dark() }

fn font_extra(slot: usize) -> u64 { return 0 as u64 }

fn clip_write(mime: str, p: u64, n: usize) -> bool {
    if n > CLIP_TEXT_CAP { return false }
    return share.clip_write(p, n)
}

fn clip_read(mime: str) {
    var buf: [u8; 65536] = [0; 65536]
    let n: usize = share.clip_read((&buf[0]) as u64, CLIP_TEXT_CAP)
    var e: hostev.HostEvent = hostev.blank(hostev.WE_CLIP)
    e.q = mime.p as u64
    e.qn = mime.n
    if n > 0 {
        e.p = (&buf[0]) as u64
        e.n = n
        e.status = 1 as u32
    }
    let used: bool = hostbus.bus_emit(&e)
}

fn notify(key: u64, title: str, text: str) -> bool {
    return hostshare.notify(key, title, text)
}

fn pick(kind: u32) -> bool {
    return hostpick.pick_begin(kind)
}

fn save(name: str, mime: str, p: u64, n: usize) -> bool {
    return hostshare.save(name, mime, p, n)
}

fn share(title: str, text: str) -> bool {
    return hostshare.share_text(title, text)
}

fn back_hold(on: bool) {
    hostroute.back_hold(on)
}

fn insets(out: u64) -> bool {
    return hostinsets.insets(out)
}

fn origin(url: str) {
    hostorigin.origin_set(url)
}
