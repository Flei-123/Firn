// lib/@android/plat/kbd.fi -- Android: the bottom edge of the part of the window the keyboard does not cover.
import android.hostinfo
import android.inputmethod

export { kbd_visible_bottom, kbd_reset_input }

fn kbd_visible_bottom() -> i32 { return hostinfo.hostinfo_visible_bottom() }

// the program cleared or replaced the focused field: the keyboard forgets its copy of the text and its composing word
fn kbd_reset_input() { inputmethod.ime_restart() }
