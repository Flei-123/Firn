import std.rt
import std.time
import paint.canvas
import fui.theme
import fui.painter
import fui.render
import fui.anim
import fui.tap
import fui.hotreg
import fui.face
import window.window
import window.pointers
import plat.fuiblit
import plat.hostev
import plat.android.hostbus
import plat.android.hostkeys

export {
    app, ctx, theme_of, css_width, css_height, want_frame, cursor, damage,
    transitions, fade_busy, set_keep, set_opaque, on_demand, use_gpu,
    gpu_enable, font_apply, backend_name,
}

const START_SIZE: usize = 360
const IDLE_WAIT_MS: i64 = 1000
const FRAME_WAIT_MS: i64 = 8
const PROMILLE: f64 = 1000.0
const MS_PER_NS: f64 = 1000000.0
const NOTCH_CSS_PX: f64 = 100.0
const MIN_DPR: usize = 250
const MOD_STATE_SHIFT: u32 = 1
const MOD_STATE_CTRL: u32 = 4
const MOD_STATE_ALT: u32 = 8
const UTF8_BUF: usize = 4

struct Win {
    f: window.Window,
    cv: canvas.Canvas,
    z: painter.Painter,
    m: theme.Theme,
    c: render.Ctx,
    bgrx: u64,
    bgrx_n: usize,
    css_w: usize,
    css_h: usize,
    dpr: usize,
    w: usize,
    h: usize,
    ud: u64,
    paint: fn(u64, u64) -> bool,
    event: fn(u64, u64, *mut hostev.HostEvent) -> bool,
    keep: bool,
    opaque: bool,
    on_demand: bool,
    again: bool,
    dirty: bool,
    quit: bool,
    tr: u64,
    tap: tap.Tap,
}

static mut G_WIN: u64 = 0

fn paint_none(ud: u64, w: u64) -> bool { return false }

fn event_none(ud: u64, w: u64, e: *mut hostev.HostEvent) -> bool { return false }

fn win_blank() -> Win {
    return Win { f: window.window_new(), cv: canvas.canvas_new(), z: painter.painter_new(),
        m: theme.theme_new(true), c: render.ctx_new(0 as *mut theme.Theme, 0 as *mut painter.Painter),
        bgrx: 0, bgrx_n: 0, css_w: 0, css_h: 0, dpr: 1000, w: 0, h: 0, ud: 0,
        paint: paint_none, event: event_none, keep: false, opaque: false,
        on_demand: false, again: false, dirty: true, quit: false, tr: 0, tap: tap.tap_new() }
}

fn win_bytes() -> usize {
    var probe: [Win; 2] = [win_blank(); 2]
    return ((&probe[1]) as usize) - ((&probe[0]) as usize)
}

fn tr_bytes() -> usize {
    var probe: [anim.TransReg; 2] = [anim.transreg_new(); 2]
    return ((&probe[1]) as usize) - ((&probe[0]) as usize)
}

fn the() -> *mut Win { return G_WIN as *mut Win }

fn now_ms() -> f64 { return time.monotonic_ns() as f64 / MS_PER_NS }

fn backend_name() -> str { return "android" }

fn ctx(w: u64) -> *mut render.Ctx { return &(*(w as *mut Win)).c }

fn theme_of(w: u64) -> *mut theme.Theme { return &(*(w as *mut Win)).m }

fn css_width(w: u64) -> usize { return (*(w as *mut Win)).css_w }

fn css_height(w: u64) -> usize { return (*(w as *mut Win)).css_h }

fn want_frame(w: u64) { (*(w as *mut Win)).again = true }

fn cursor(kind: u32) {}

fn damage(w: u64, x: f64, y: f64, dw: f64, dh: f64) {}

fn set_keep(on: bool) { if G_WIN != 0 { (*the()).keep = on } }

fn set_opaque(on: bool) { if G_WIN != 0 { (*the()).opaque = on } }

fn on_demand(on: bool) { if G_WIN != 0 { (*the()).on_demand = on } }

fn use_gpu(on: bool) {}

fn gpu_enable() {}

fn font_apply(z: *mut painter.Painter) -> bool { return false }

fn transitions(w: u64) -> bool {
    let x: *mut Win = w as *mut Win
    if (*x).tr != 0 { return true }
    let p: u64 = rt.heap_alloc(tr_bytes())
    if p == 0 { return false }
    let r: *mut anim.TransReg = p as *mut anim.TransReg
    *r = anim.transreg_new()
    anim.transreg_bind(r, &(*x).c)
    (*x).tr = p
    return true
}

fn fade_busy(w: u64) -> bool {
    let x: *mut Win = w as *mut Win
    if (*x).tr == 0 { return false }
    return anim.transreg_dirty((*x).tr as *mut anim.TransReg)
}

fn css_of(x: *mut Win, v: f64) -> f64 { return v * PROMILLE / ((*x).dpr as f64) }

fn deliver(x: *mut Win, e: *mut hostev.HostEvent) -> bool {
    if ((*x).event)((*x).ud, x as u64, e) {
        (*x).dirty = true
        return true
    }
    return false
}

fn bus_event(e: *mut hostev.HostEvent) -> bool {
    if G_WIN == 0 { return false }
    return deliver(the(), e)
}

fn release_surfaces(x: *mut Win) {
    if canvas.canvas_ok(&(*x).cv) {
        painter.painter_free(&(*x).z)
        canvas.canvas_free(&(*x).cv)
    }
    if (*x).bgrx_n > 0 {
        rt.heap_free((*x).bgrx, (*x).bgrx_n)
        (*x).bgrx_n = 0
    }
}

fn build_surfaces(x: *mut Win, w: usize, h: usize) -> bool {
    release_surfaces(x)
    if !canvas.canvas_init(&(*x).cv, w, h) { return false }
    if !painter.painter_init(&(*x).z, &(*x).cv, w, h) { return false }
    face.install(&(*x).z)
    (*x).bgrx = rt.heap_alloc(w * h * 4)
    if (*x).bgrx == 0 { return false }
    (*x).bgrx_n = w * h * 4
    return true
}

fn measure(x: *mut Win) -> bool {
    let f: *mut window.Window = &(*x).f
    var r: usize = window.uiscale(f)
    if r < MIN_DPR { r = 1000 }
    let w: usize = window.width(f)
    let h: usize = window.height(f)
    if w == 0 || h == 0 { return false }
    if w != (*x).w || h != (*x).h {
        if !build_surfaces(x, w, h) { return false }
    }
    (*x).dpr = r
    (*x).w = w
    (*x).h = h
    (*x).css_w = (w * 1000 + r / 2) / r
    (*x).css_h = (h * 1000 + r / 2) / r
    theme.theme_set_scale(&(*x).m, r)
    return true
}

fn announce_size(x: *mut Win) {
    var e: hostev.HostEvent = hostev.blank(hostev.WE_RESIZE)
    e.x = (*x).css_w as f64
    e.y = (*x).css_h as f64
    let used: bool = deliver(x, &e)
}

fn pointer_event(x: *mut Win, pr: *mut pointers.Pointer) {
    var e: hostev.HostEvent = hostev.blank(hostev.WE_MOVE)
    var tapped: bool = false
    let cx: f64 = css_of(x, (*pr).x)
    let cy: f64 = css_of(x, (*pr).y)
    let touch: bool = (*pr).ptype == pointers.PTR_TOUCH
    let t0: f64 = now_ms()
    if (*pr).kind == pointers.PK_DOWN {
        e.kind = hostev.WE_DOWN
        tap.tap_down(&(*x).tap, (*pr).id, (*pr).primary != 0 as u32, touch, cx, cy, t0)
        if touch { hostbus.bus_wake_in(t0, tap.PRESS_DELAY_MS + 8.0) }
    } else if (*pr).kind == pointers.PK_UP {
        e.kind = hostev.WE_UP
        tapped = tap.tap_up(&(*x).tap, (*pr).id, cx, cy, t0)
    } else if (*pr).kind == pointers.PK_CANCEL {
        e.kind = hostev.WE_UP
        tap.tap_cancel(&(*x).tap)
        let cancelled: bool = hotreg.press_cancel()
    } else if tap.tap_move(&(*x).tap, (*pr).id, cx, cy) && hotreg.press_cancel() {
        (*x).dirty = true
    }
    e.x = cx
    e.y = cy
    e.pid = (*pr).id
    e.ptype = (*pr).ptype
    e.primary = (*pr).primary
    e.ms = t0
    e.pressure = (*pr).pressure
    if touch { e.mods = hostev.MOD_TOUCH }
    let used: bool = deliver(x, &e)
    if tapped {
        var te: hostev.HostEvent = hostev.blank(hostev.WE_TAP)
        te.x = cx
        te.y = cy
        te.pid = (*pr).id
        te.ptype = (*pr).ptype
        te.primary = (*pr).primary
        te.ms = t0
        te.mods = e.mods
        let tapped_used: bool = deliver(x, &te)
    }
}

fn mods_of(state: u32) -> u32 {
    var m: u32 = 0
    if (state & MOD_STATE_SHIFT) != 0 as u32 { m = m | hostev.MOD_SHIFT }
    if (state & MOD_STATE_CTRL) != 0 as u32 { m = m | hostev.MOD_CTRL }
    if (state & MOD_STATE_ALT) != 0 as u32 { m = m | hostev.MOD_ALT }
    return m
}

fn key_event(x: *mut Win, code: u32, state: u32) {
    let name: str = hostkeys.key_name(code)
    if name.n == 0 { return }
    var e: hostev.HostEvent = hostev.blank(hostev.WE_KEY)
    e.p = name.p as u64
    e.n = name.n
    e.mods = mods_of(state)
    e.status = 1 as u32
    let used: bool = deliver(x, &e)
}

fn utf8_put(cp: u32, out: u64) -> usize {
    if cp < 128 as u32 {
        rt.st8(out, 0, cp as u8)
        return 1
    }
    if cp < 2048 as u32 {
        rt.st8(out, 0, (192 as u32 | (cp >> 6)) as u8)
        rt.st8(out, 1, (128 as u32 | (cp & 63 as u32)) as u8)
        return 2
    }
    if cp < 65536 as u32 {
        rt.st8(out, 0, (224 as u32 | (cp >> 12)) as u8)
        rt.st8(out, 1, (128 as u32 | ((cp >> 6) & 63 as u32)) as u8)
        rt.st8(out, 2, (128 as u32 | (cp & 63 as u32)) as u8)
        return 3
    }
    rt.st8(out, 0, (240 as u32 | (cp >> 18)) as u8)
    rt.st8(out, 1, (128 as u32 | ((cp >> 12) & 63 as u32)) as u8)
    rt.st8(out, 2, (128 as u32 | ((cp >> 6) & 63 as u32)) as u8)
    rt.st8(out, 3, (128 as u32 | (cp & 63 as u32)) as u8)
    return 4
}

fn text_event(x: *mut Win, cp: u32) {
    var buf: [u8; 4] = [0; 4]
    let n: usize = utf8_put(cp, (&buf[0]) as u64)
    var e: hostev.HostEvent = hostev.blank(hostev.WE_TEXT)
    e.p = (&buf[0]) as u64
    e.n = n
    let used: bool = deliver(x, &e)
}

fn wheel_event(x: *mut Win, up: bool, px: u32, py: u32) {
    var e: hostev.HostEvent = hostev.blank(hostev.WE_WHEEL)
    e.x = css_of(x, px as f64)
    e.y = css_of(x, py as f64)
    if up { e.dy = 0.0 - NOTCH_CSS_PX } else { e.dy = NOTCH_CSS_PX }
    let used: bool = deliver(x, &e)
}

fn handle_event(x: *mut Win, kind: u32) {
    let f: *mut window.Window = &(*x).f
    if kind == window.EV_CLOSED {
        (*x).quit = true
    } else if kind == window.EV_CONFIGURE {
        if measure(x) { announce_size(x) }
        (*x).dirty = true
    } else if kind == window.EV_EXPOSE {
        (*x).dirty = true
    } else if kind == window.EV_THEME {
        hostbus.bus_set_dark(window.dark(f))
        (*x).dirty = true
    } else if kind == window.EV_KEY {
        key_event(x, window.ev_a(f), window.ev_state(f))
    } else if kind == window.EV_CHAR {
        text_event(x, window.ev_a(f))
    } else if kind == window.EV_BUTTON {
        let b: u32 = window.ev_a(f)
        if b == window.BTN_WHEEL_UP || b == window.BTN_WHEEL_DOWN {
            wheel_event(x, b == window.BTN_WHEEL_UP, window.ev_x(f), window.ev_y(f))
        }
    }
}

fn drain_window(x: *mut Win) {
    let f: *mut window.Window = &(*x).f
    var pr: pointers.Pointer = pointers.ptr_blank()
    while window.next_pointer(f, (&pr) as u64) {
        pointer_event(x, &pr)
    }
    var k: u32 = window.next_event(f)
    while k != window.EV_NONE && !(*x).quit {
        handle_event(x, k)
        k = window.next_event(f)
    }
}

fn present(x: *mut Win) {
    let f: *mut window.Window = &(*x).f
    let direct: bool = window.rgba_native(f)
    let px: u64 = canvas.canvas_pixels(&(*x).cv) as u64
    fuiblit.full_prepare(direct, px, (*x).bgrx, (*x).w * (*x).h)
    let put: bool = fuiblit.full_put(f, direct, px, (*x).bgrx, (*x).w, (*x).h)
    let shown: bool = window.present(f)
}

fn paint_frame(x: *mut Win, now: f64) {
    render.ctx_set_time(&(*x).c, now as i64)
    if !(*x).keep {
        let colors: *mut theme.Colors = theme.theme_colors(&(*x).m)
        canvas.canvas_clear(&(*x).cv, theme.opaque((*colors).base))
    }
    if (*x).tr != 0 { anim.transreg_new_frame((*x).tr as *mut anim.TransReg) }
    let painted: bool = ((*x).paint)((*x).ud, x as u64)
    if fade_busy(x as u64) { (*x).again = true }
    present(x)
}

fn press_check(x: *mut Win, now: f64) {
    if tap.tap_take_press(&(*x).tap, now) {
        let settled: bool = hotreg.press_settle()
        var pe: hostev.HostEvent = hostev.blank(hostev.WE_PRESS)
        pe.x = tap.tap_x0(&(*x).tap)
        pe.y = tap.tap_y0(&(*x).tap)
        pe.mods = hostev.MOD_TOUCH
        pe.ptype = 2 as u32
        let used: bool = deliver(x, &pe)
    } else if !tap.tap_live(&(*x).tap) {
        let cancelled: bool = hotreg.press_cancel()
    }
}

fn run_frame(x: *mut Win) {
    let now: f64 = now_ms()
    if hostbus.bus_wake_due(now) { (*x).again = true }
    let wanted: bool = !(*x).on_demand || (*x).again || (*x).dirty
    if !wanted { return }
    (*x).again = false
    press_check(x, now)
    var te: hostev.HostEvent = hostev.blank(hostev.WE_TICK)
    te.ms = now
    let ticked: bool = deliver(x, &te)
    if (*x).dirty {
        (*x).dirty = false
        paint_frame(x, now)
    }
    if !(*x).on_demand { (*x).again = true }
}

fn wait_ms(x: *mut Win) -> i64 {
    if (*x).dirty || (*x).again || !(*x).on_demand { return FRAME_WAIT_MS }
    return hostbus.bus_wait_ms(IDLE_WAIT_MS)
}

fn wait_input(x: *mut Win) {
    let wins: [u64; 8] = [((&(*x).f) as u64), 0, 0, 0, 0, 0, 0, 0]
    let hit: i64 = window.wait_any_fd(&wins, 1, hostbus.bus_fd(), wait_ms(x))
}

fn open_window(x: *mut Win) -> bool {
    let f: *mut window.Window = &(*x).f
    if !window.open_window(f, 0) { return false }
    let full: bool = window.full_input(f, true)
    let real: bool = window.real_pointers(f, true)
    if !window.make(f, START_SIZE, START_SIZE) { return false }
    if !window.show_window(f) { return false }
    return true
}

#[allow_escape]
fn app(ud: u64, paint: fn(u64, u64) -> bool,
    event: fn(u64, u64, *mut hostev.HostEvent) -> bool) -> bool {
    let p: u64 = rt.heap_alloc(win_bytes())
    if p == 0 { return false }
    G_WIN = p
    let x: *mut Win = the()
    *x = win_blank()
    (*x).c = render.ctx_new(&(*x).m, &(*x).z)
    (*x).ud = ud
    (*x).paint = paint
    (*x).event = event
    if !open_window(x) { return false }
    hostbus.bus_set_dark(window.dark(&(*x).f))
    (*x).m = theme.theme_new(hostbus.bus_dark())
    if !measure(x) { return false }
    (*x).c = render.ctx_new(&(*x).m, &(*x).z)
    hostbus.bus_set_sink(bus_event)
    announce_size(x)
    while !(*x).quit {
        wait_input(x)
        let pumped: bool = hostbus.bus_pump()
        drain_window(x)
        run_frame(x)
    }
    window.close_window(&(*x).f)
    return true
}
