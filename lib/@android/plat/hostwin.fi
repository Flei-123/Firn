import std.rt
import fui.theme
import fui.painter
import fui.render
import fui.anim
import window.window
import plat.hostev
import plat.android.hostbus
import plat.android.winstate
import plat.android.winsurface
import plat.android.wininput
import plat.android.winframe

export {
    app, ctx, theme_of, css_width, css_height, want_frame, cursor, damage,
    transitions, fade_busy, set_keep, set_opaque, on_demand, use_gpu,
    gpu_enable, font_apply, backend_name,
}

fn backend_name() -> str { return "android" }

fn ctx(w: u64) -> *mut render.Ctx { return &(*(w as *mut winstate.Win)).c }

fn theme_of(w: u64) -> *mut theme.Theme { return &(*(w as *mut winstate.Win)).m }

fn css_width(w: u64) -> usize { return (*(w as *mut winstate.Win)).css_w }

fn css_height(w: u64) -> usize { return (*(w as *mut winstate.Win)).css_h }

fn want_frame(w: u64) { (*(w as *mut winstate.Win)).again = true }

fn cursor(kind: u32) {}

fn damage(w: u64, x: f64, y: f64, dw: f64, dh: f64) {}

fn set_keep(on: bool) { if winstate.G_WIN != 0 { (*winstate.the()).keep = on } }

fn set_opaque(on: bool) { if winstate.G_WIN != 0 { (*winstate.the()).opaque = on } }

fn on_demand(on: bool) { if winstate.G_WIN != 0 { (*winstate.the()).on_demand = on } }

fn use_gpu(on: bool) {}

fn gpu_enable() {}

fn font_apply(z: *mut painter.Painter) -> bool { return false }

fn fade_busy(w: u64) -> bool { return winframe.fade_busy(w) }

fn transitions(w: u64) -> bool {
    let x: *mut winstate.Win = w as *mut winstate.Win
    if (*x).tr != 0 { return true }
    let p: u64 = rt.heap_alloc(winstate.tr_bytes())
    if p == 0 { return false }
    let r: *mut anim.TransReg = p as *mut anim.TransReg
    *r = anim.transreg_new()
    anim.transreg_bind(r, &(*x).c)
    (*x).tr = p
    return true
}

fn run_loop(x: *mut winstate.Win) {
    while !(*x).quit {
        winframe.wait_input(x)
        let pumped: bool = hostbus.bus_pump()
        wininput.drain_window(x)
        hostbus.bus_turn()
        winframe.run_frame(x)
    }
}

#[allow_escape]
fn app(ud: u64, paint: fn(u64, u64) -> bool,
    event: fn(u64, u64, *mut hostev.HostEvent) -> bool) -> bool {
    let p: u64 = rt.heap_alloc(winstate.win_bytes())
    if p == 0 { return false }
    winstate.G_WIN = p
    let x: *mut winstate.Win = winstate.the()
    *x = winstate.win_blank()
    (*x).c = render.ctx_new(&(*x).m, &(*x).z)
    (*x).ud = ud
    (*x).paint = paint
    (*x).event = event
    if !winframe.open_window(x) { return false }
    hostbus.bus_set_window(&(*x).f)
    hostbus.bus_set_dark(window.dark(&(*x).f))
    (*x).m = theme.theme_new(hostbus.bus_dark())
    if !winsurface.measure(x) { return false }
    (*x).c = render.ctx_new(&(*x).m, &(*x).z)
    hostbus.bus_set_sink(winstate.bus_event)
    winsurface.announce_size(x)
    run_loop(x)
    window.close_window(&(*x).f)
    return true
}
