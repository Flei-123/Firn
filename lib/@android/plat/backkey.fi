// lib/@android/plat/backkey.fi -- the Android side of lib/plat/backkey.fi: lib/window/android.fi asks android.activity what to do with
// KEYCODE_BACK (mode 2 = swallow + count, mode 1 = system default, 0 = old behaviour).
import android.activity

export { back_hold, back_take }

fn back_hold(on: bool) {
    if on {
        activity.activity_back_set(2 as u64)
    } else {
        activity.activity_back_set(1 as u64)
    }
}

fn back_take() -> bool {
    return activity.activity_back_take() > 0 as u64
}
