// SPDX-License-Identifier: MPL-2.0
// lib/@android/plat/tzinfo.fi -- the Android side of lib/plat/tzinfo.fi: java.util.TimeZone.getDefault() through JNI
// (getID() and getOffset(long)). Every step that fails answers "not known" (the caller keeps its fallback zone).
import std.rt
import android.ndk
import android.activity
import android.jnicall

export { tz_id, tz_offset_min, TZ_UNKNOWN }

const TZ_UNKNOWN: i64 = 100000

static mut G_ID: [u8; 64] = [0; 64]

const N_CLASS: str = "java/util/TimeZone\0"
const N_GET_DEFAULT: str = "getDefault\0"
const S_GET_DEFAULT: str = "()Ljava/util/TimeZone;\0"
const N_GET_ID: str = "getID\0"
const S_GET_ID: str = "()Ljava/lang/String;\0"
const N_GET_OFFSET: str = "getOffset\0"
const S_GET_OFFSET: str = "(J)I\0"

// The JNIEnv of this thread; 0 = no activity / no VM.
#[no_gc]
fn env_of() -> u64 {
    let act: u64 = activity.activity_pointer()
    if act == 0 { return 0 }
    let vm: u64 = ndk.peek64(act + 8)
    if vm == 0 { return 0 }
    return jnicall.j_env(vm)
}

// The default zone object (new local reference, 0 = failed) and its class (the caller deletes both).
#[no_gc]
fn default_zone(env: u64, cls: *mut u64) -> u64 {
    let k: u64 = jnicall.j_class(env, N_CLASS.p as u64)
    if k == 0 { return 0 }
    let m: u64 = jnicall.j_smethod(env, k, N_GET_DEFAULT.p as u64, S_GET_DEFAULT.p as u64)
    if m == 0 {
        jnicall.j_del(env, k)
        return 0
    }
    let z: u64 = jnicall.j_sobj(env, k, m, 0)
    if z == 0 {
        jnicall.j_del(env, k)
        return 0
    }
    *cls = k
    return z
}

#[no_gc]
fn tz_id() -> str {
    let env: u64 = env_of()
    if env == 0 { return "" }
    var k: u64 = 0
    let z: u64 = default_zone(env, &k)
    if z == 0 { return "" }
    var n: usize = 0
    let m: u64 = jnicall.j_method(env, k, N_GET_ID.p as u64, S_GET_ID.p as u64)
    let js: u64 = jnicall.j_obj(env, z, m, 0)
    if js != 0 {
        let ch: u64 = jnicall.j_utf_chars(env, js)
        if ch != 0 {
            while *((ch + n as u64) as *mut u8) != 0 as u8 && n < 63 {
                G_ID[n] = *((ch + n as u64) as *mut u8)
                n = n + 1
            }
            jnicall.j_utf_release(env, js, ch)
        }
        jnicall.j_del(env, js)
    }
    jnicall.j_del(env, z)
    jnicall.j_del(env, k)
    return str { p: (&G_ID[0]) as *mut u8, n: n }
}

#[no_gc]
fn tz_offset_min(ms: i64) -> i64 {
    let env: u64 = env_of()
    if env == 0 { return TZ_UNKNOWN }
    var k: u64 = 0
    let z: u64 = default_zone(env, &k)
    if z == 0 { return TZ_UNKNOWN }
    var r: i64 = TZ_UNKNOWN
    let m: u64 = jnicall.j_method(env, k, N_GET_OFFSET.p as u64, S_GET_OFFSET.p as u64)
    if m != 0 {
        var a: [u64; 1] = [0; 1]
        a[0] = ms as u64
        let off: i32 = jnicall.j_int(env, z, m, (&a[0]) as u64)
        r = (off as i64) / 60000
    }
    jnicall.j_del(env, z)
    jnicall.j_del(env, k)
    return r
}
