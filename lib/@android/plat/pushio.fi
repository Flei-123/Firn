// SPDX-License-Identifier: MPL-2.0
// lib/@android/plat/pushio.fi -- the Android side of lib/plat/pushio.fi: plat.android.push (foreground service, TCP relay line
// per notification). The hello line is kept in firn-push.cfg for the restarted service.
import std.rt
import plat.android.push

export { pio_available, pio_start, pio_keep, pio_notify, pio_notify_cid, pio_launch_cid, pio_shown, pio_dismissed, pio_cancel, pio_stop, pio_running }

fn pio_available() -> bool { return true }

// a NUL-terminated copy of s (the JNI side wants C strings); the caller frees the buffer
fn cstr(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
    rt.buf_push(b, 0 as u8)
}

fn pio_start(host: str, port: i64, hello: str) -> bool {
    if host.n == 0 || port <= 0 || port > 65535 { return false }
    var hb: rt.Buf = rt.buf_new()
    var tb: rt.Buf = rt.buf_new()
    cstr(&hb, host)
    cstr(&tb, hello)
    // the hello BEFORE the start, like push.fi documents; an empty text clears it
    let h: bool = push.push_set_hello(tb.ptr)
    let ok: bool = push.push_start(hb.ptr, port as u32)
    rt.buf_free(&hb)
    rt.buf_free(&tb)
    return ok
}

// The service without a relay connection (port 0 = no push thread); the program polls over HTTPS itself.
fn pio_keep() -> bool { return push.push_keep() }

// One notification now (app thread). Title and text are copied NUL-terminated.
fn pio_notify(title: str, text: str) -> bool {
    var tb: rt.Buf = rt.buf_new()
    var xb: rt.Buf = rt.buf_new()
    cstr(&tb, title)
    cstr(&xb, text)
    let ok: bool = push.push_notify(tb.ptr, xb.ptr)
    rt.buf_free(&tb)
    rt.buf_free(&xb)
    return ok
}

// A keyed notification: a new text for the same key replaces the old one. A tap starts the app with `cid` attached (pio_launch_cid).
fn pio_notify_cid(key: u64, title: str, text: str, cid: str) -> bool {
    var tb: rt.Buf = rt.buf_new()
    var xb: rt.Buf = rt.buf_new()
    var cb: rt.Buf = rt.buf_new()
    cstr(&tb, title)
    cstr(&xb, text)
    cstr(&cb, cid)
    let ok: bool = push.push_notify_cid(key, tb.ptr, xb.ptr, cb.ptr)
    rt.buf_free(&tb)
    rt.buf_free(&xb)
    rt.buf_free(&cb)
    return ok
}

// The chat id the app was started with by a tap on a notification ("" = none). Taken once.
static mut G_LAUNCH: [u8; 160] = [0; 160]

fn pio_launch_cid() -> str {
    let n: usize = push.push_intent_cid((&G_LAUNCH[0]) as u64, 160)
    if n == 0 { return "" }
    return __str_copy(str { p: (&G_LAUNCH[0]) as u64 as *mut u8, n: n })
}

// 1 = the notification of `key` is in the status bar, 0 = it is not (tapped, swiped away, cancelled), -1 = cannot tell
fn pio_shown(key: u64) -> i32 { return push.push_shown(key) }
// 1 = the notification of `key` was SWIPED away (the system told the service; taken once), 0 = no such mark -- gone without it = tapped
fn pio_dismissed(key: u64) -> i32 { return push.push_gone_take(key) }
fn pio_cancel(key: u64) -> bool { return push.push_cancel(key) }

fn pio_stop() { let ok: bool = push.push_stop() }
fn pio_running() -> bool { return push.push_running() }
