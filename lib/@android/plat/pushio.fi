// SPDX-License-Identifier: MPL-2.0
// lib/@android/plat/pushio.fi -- the Android side of lib/plat/pushio.fi: plat.android.push (foreground service, TCP relay line
// per notification). The hello line is kept in firn-push.cfg for the restarted service.
import std.rt
import plat.android.push

export { pio_available, pio_start, pio_keep, pio_notify, pio_stop, pio_running }

fn pio_available() -> bool { return true }

// a NUL-terminated copy of s (the JNI side wants C strings); the caller frees the buffer
fn cstr(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
    rt.buf_push(b, 0 as u8)
}

fn pio_start(host: str, port: i64, hello: str) -> bool {
    if host.n == 0 || port <= 0 || port > 65535 { return false }
    var hb: rt.Buf = rt.buf_new()
    var tb: rt.Buf = rt.buf_new()
    cstr(&hb, host)
    cstr(&tb, hello)
    // the hello BEFORE the start, like push.fi documents; an empty text clears it
    let h: bool = push.push_set_hello(tb.ptr)
    let ok: bool = push.push_start(hb.ptr, port as u32)
    rt.buf_free(&hb)
    rt.buf_free(&tb)
    return ok
}

// The service without a relay connection (port 0 = no push thread); the program polls over HTTPS itself.
fn pio_keep() -> bool { return push.push_keep() }

// One notification now (app thread). Title and text are copied NUL-terminated.
fn pio_notify(title: str, text: str) -> bool {
    var tb: rt.Buf = rt.buf_new()
    var xb: rt.Buf = rt.buf_new()
    cstr(&tb, title)
    cstr(&xb, text)
    let ok: bool = push.push_notify(tb.ptr, xb.ptr)
    rt.buf_free(&tb)
    rt.buf_free(&xb)
    return ok
}

fn pio_stop() { let ok: bool = push.push_stop() }
fn pio_running() -> bool { return push.push_running() }
