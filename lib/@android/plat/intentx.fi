// lib/@android/plat/intentx.fi -- the Android side of lib/plat/intentx.fi: extras of the activity's Intent (android.intentextra, JNI).
import android.intentextra

export { ix_str, ix_int, ix_bool }

#[allow_escape]
fn ix_str(key: str, dflt: str) -> str {
    var b: [u8; 96] = [0; 96]
    let n: usize = intentextra.extra_str(key + "\0", (&b[0]) as u64, 96)
    if n == 0 { return dflt }
    return __str_copy(str { p: (&b[0]) as *mut u8, n: n })
}

fn ix_int(key: str, dflt: i64) -> i64 {
    return intentextra.extra_int(key + "\0", dflt as i32) as i64
}

fn ix_bool(key: str, dflt: bool) -> bool {
    return intentextra.extra_bool(key + "\0", dflt)
}
