// SPDX-License-Identifier: MPL-2.0
// lib/@android/plat/blog.fi -- the Android side of lib/plat/blog.fi: logcat line (priority INFO) with the given tag.
import std.rt
import std.fs
import android.ndk

export { log, since_start_ms }

fn log(tag: str, text: str) {
    let t: str = tag + "\0"
    let x: str = text + "\0"
    ndk.log_write(ndk.LOG_INFO, t.p as u64, x.p as u64)
}

fn stat_token(p: u64, n: usize, k: usize) -> i64 {
    var last: usize = 0
    var i: usize = 0
    while i < n {
        if rt.ld8(p, i) == 41 as u8 { last = i }
        i = i + 1
    }
    var tok: usize = 0
    i = last + 1
    while i < n {
        while i < n && rt.ld8(p, i) == 32 as u8 { i = i + 1 }
        if i >= n { return 0 - 1 }
        tok = tok + 1
        var v: i64 = 0
        while i < n && rt.ld8(p, i) != 32 as u8 {
            let c: u8 = rt.ld8(p, i)
            if c >= 48 as u8 && c <= 57 as u8 { v = v * 10 + (c as i64 - 48) }
            i = i + 1
        }
        if tok == k { return v }
    }
    return 0 - 1
}

fn uptime_cs(p: u64, n: usize) -> i64 {
    var v: i64 = 0
    var i: usize = 0
    while i < n && rt.ld8(p, i) != 46 as u8 {
        v = v * 10 + (rt.ld8(p, i) as i64 - 48)
        i = i + 1
    }
    v = v * 100
    if i + 2 < n {
        v = v + (rt.ld8(p, i + 1) as i64 - 48) * 10 + (rt.ld8(p, i + 2) as i64 - 48)
    }
    return v
}

fn since_start_ms() -> i64 {
    var a: rt.Buf = rt.buf_new()
    var b: rt.Buf = rt.buf_new()
    let na: usize = fs.read_file("/proc/self/stat", &a) catch 0
    let nb: usize = fs.read_file("/proc/uptime", &b) catch 0
    var r: i64 = 0 - 1
    if na > 0 && nb > 0 {
        let st: i64 = stat_token(rt.buf_ptr(&a), na, 20)
        let up: i64 = uptime_cs(rt.buf_ptr(&b), nb)
        if st >= 0 && up >= st { r = (up - st) * 10 }
    }
    rt.buf_free(&a)
    rt.buf_free(&b)
    return r
}
