// SPDX-License-Identifier: MPL-2.0
// lib/@android/plat/voiceio.fi -- the Android side of lib/plat/voiceio.fi: AAudio microphone (plat.android.speech) and
// TextToSpeech (plat.android.tts). Build the app with `--speech --tts` (tools/android/build.sh).
//
// The microphone permission is asked on the FIRST toggle (VIO_PERMISSION: the system dialog is up, the user taps the button
// again after allowing). vio_poll must run on the program's own thread at least every 200 ms while recording (the AAudio
// buffer holds ~2 s, a stalled app loses samples).
import plat.android.speech
import plat.android.tts

export {
    VIO_STARTED, VIO_STOPPED, VIO_PERMISSION, VIO_FAILED,
    vio_available, vio_mic_toggle, vio_mic_recording, vio_mic_level, vio_mic_wav, vio_mic_wav_len, vio_mic_free,
    vio_poll, vio_say, vio_say_stop, vio_error_text,
}

const VIO_STARTED: i32 = 0
const VIO_STOPPED: i32 = 1
const VIO_PERMISSION: i32 = 2
const VIO_FAILED: i32 = 3

const MAX_RECORD_MS: i32 = 60000

static mut G_ERR: i32 = 0
static mut G_LANG: [u8; 3] = [0; 3] // "de" (filled in vio_say): the answers of JARVIS are German

fn vio_available() -> bool { return true }

fn vio_mic_recording() -> bool { return speech.speech_state() == speech.SP_RECORDING }
fn vio_mic_level() -> i32 { return speech.speech_level() }

fn vio_mic_toggle() -> i32 {
    if speech.speech_state() == speech.SP_RECORDING {
        let n: usize = speech.speech_stop()
        if n == 0 || speech.speech_wav() == 0 {
            G_ERR = 99
            return VIO_FAILED
        }
        return VIO_STOPPED
    }
    if speech.speech_permission() != 1 {
        let r: bool = speech.speech_request_permission()
        return VIO_PERMISSION
    }
    speech.speech_free()
    let e: i32 = speech.speech_start(MAX_RECORD_MS)
    G_ERR = e
    if e != speech.E_OK { return VIO_FAILED }
    return VIO_STARTED
}

fn vio_mic_wav() -> u64 { return speech.speech_wav() }
fn vio_mic_wav_len() -> usize { return speech.speech_wav_len() }
fn vio_mic_free() { speech.speech_free() }

fn vio_poll() {
    if speech.speech_state() == speech.SP_RECORDING {
        let s: i32 = speech.speech_poll()
    }
    let t: i32 = tts.tts_state()
    if t == tts.TTS_WAIT || t == tts.TTS_SPEAKING {
        let s: i32 = tts.tts_poll()
    }
}

fn vio_say(text: str) -> bool {
    if text.n == 0 { return false }
    G_LANG[0] = 100 as u8
    G_LANG[1] = 101 as u8
    G_LANG[2] = 0 as u8
    return tts.tts_speak(text.p as u64, text.n, (&G_LANG[0]) as u64)
}

fn vio_say_stop() {
    let s: bool = tts.tts_stop()
}

fn vio_error_text() -> str {
    if G_ERR == 99 { return "nothing recorded" }
    return speech.speech_error_text(G_ERR)
}
