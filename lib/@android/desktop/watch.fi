// SPDX-License-Identifier: MPL-2.0
// lib/@android/desktop/watch.fi -- desktop.watch for Android. STUB: FileObserver (inotify underneath: the Linux back end's code would work on files the app may read, but the NDK build does not link it yet) is not something a Firn program does on Android through this module.
//
// Every function answers "not available" (false / 0 / nothing) and has the signature of the Linux
// reference lib/desktop/watch.fi; `tools/desktop/platforms.py` compares export lists and signatures and
// type-checks this file. A real back end replaces the bodies, not the interface.
import std.rt

export {
    Watcher, WatchEvent,
    watch_new, watch_add, watch_poll, watch_event_path, watch_event_zero, watch_close, watch_fd,
    EV_NONE, EV_CREATED, EV_MODIFIED, EV_DELETED, EV_RENAMED_FROM, EV_RENAMED_TO, EV_ATTRIB,
    EV_OVERFLOW, EV_ROOT_GONE,
}

const EV_NONE: u32 = 0
const EV_CREATED: u32 = 1
const EV_MODIFIED: u32 = 2
const EV_DELETED: u32 = 3
const EV_RENAMED_FROM: u32 = 4
const EV_RENAMED_TO: u32 = 5
const EV_ATTRIB: u32 = 6
const EV_OVERFLOW: u32 = 7
const EV_ROOT_GONE: u32 = 8

struct WatchEvent {
    kind: u32,
    is_dir: bool,
    cookie: u32,
}

struct Watcher {
    open: bool,
}

fn watch_event_zero() -> WatchEvent {
    return WatchEvent { kind: 0 as u32, is_dir: false, cookie: 0 as u32 }
}

fn watch_new() -> Watcher { return Watcher { open: false } }
fn watch_add(w: *mut Watcher, path: str, recursive: bool) -> bool { return false }
fn watch_poll(w: *mut Watcher, ms: i64, ev: *mut WatchEvent) -> bool { return false }
fn watch_event_path(w: *mut Watcher) -> str { return "" }
fn watch_close(w: *mut Watcher) {}
fn watch_fd(w: *mut Watcher) -> i32 { return -1 }
