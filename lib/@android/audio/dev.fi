// lib/@android/audio/dev.fi -- audio.dev for Android. STUB: AAudio (API 26+) or OpenSL ES through the NDK is not something a Firn program does on Android through this module.
//
// Every function answers "not available" (false / 0 / nothing) and has the signature of the Linux
// reference lib/audio/dev.fi; `tools/desktop/platforms.py` compares export lists and signatures and
// type-checks this file. A real back end replaces the bodies, not the interface.
import std.rt

export { Dev, dev_open, dev_is_open, dev_writable, dev_write, dev_drain, dev_flush, dev_pause, dev_close, dev_null }

struct Dev {
    open: bool,
}

fn dev_null() -> Dev { return Dev { open: false } }
fn dev_open(app: str, rate: u32, channels: u32) -> Dev { return Dev { open: false } }
fn dev_is_open(d: *mut Dev) -> bool { return false }
fn dev_writable(d: *mut Dev) -> usize { return 0 }
fn dev_write(d: *mut Dev, p: u64, frames: usize) -> bool { return false }
fn dev_drain(d: *mut Dev) -> bool { return false }
fn dev_flush(d: *mut Dev) -> bool { return false }
fn dev_pause(d: *mut Dev, on: bool) -> bool { return false }
fn dev_close(d: *mut Dev) {}
