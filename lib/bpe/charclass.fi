// SPDX-License-Identifier: MPL-2.0
// lib/bpe/charclass.fi -- bpe.charclass: fast UTF-8 character classes (letter, digit, space, newline, other) for the pretokenizer.
import std.rt

export { CLS_LETTER, CLS_DIGIT, CLS_SPACE, CLS_NEWLINE, CLS_OTHER, class_at, cp_class, utf8_need }

const CLS_LETTER: u32 = 1
const CLS_DIGIT: u32 = 2
const CLS_SPACE: u32 = 3
const CLS_NEWLINE: u32 = 4
const CLS_OTHER: u32 = 5

fn in_range(cp: u32, lo: u32, hi: u32) -> bool {
    return cp >= lo && cp <= hi
}

fn latin1_class(cp: u32) -> u32 {
    if cp == 160 {
        return CLS_SPACE
    }
    if cp == 170 || cp == 181 || cp == 186 {
        return CLS_LETTER
    }
    if cp == 178 || cp == 179 || cp == 185 || in_range(cp, 188, 190) {
        return CLS_DIGIT
    }
    if cp < 192 || cp == 215 || cp == 247 {
        return CLS_OTHER
    }
    return CLS_LETTER
}

fn punct_class(cp: u32) -> u32 {
    if in_range(cp, 8192, 8202) || cp == 8232 || cp == 8233 || cp == 8239 || cp == 8287 {
        return CLS_SPACE
    }
    if cp == 8304 || in_range(cp, 8308, 8313) || in_range(cp, 8320, 8329) {
        return CLS_DIGIT
    }
    return CLS_OTHER
}

fn bmp_high_class(cp: u32) -> u32 {
    if cp >= 57344 && cp <= 63743 {
        return CLS_OTHER
    }
    if in_range(cp, 65024, 65135) || cp == 65279 {
        return CLS_OTHER
    }
    if cp < 65280 {
        return CLS_LETTER
    }
    if in_range(cp, 65296, 65305) {
        return CLS_DIGIT
    }
    if in_range(cp, 65313, 65338) || in_range(cp, 65345, 65370) || in_range(cp, 65382, 65500) {
        return CLS_LETTER
    }
    return CLS_OTHER
}

fn cp_class(cp: u32) -> u32 {
    if cp < 128 {
        if cp == 10 || cp == 13 {
            return CLS_NEWLINE
        }
        if cp == 32 || (cp >= 9 && cp <= 12) {
            return CLS_SPACE
        }
        if cp >= 48 && cp <= 57 {
            return CLS_DIGIT
        }
        if (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122) {
            return CLS_LETTER
        }
        return CLS_OTHER
    }
    if cp < 256 {
        if cp == 133 {
            return CLS_SPACE
        }
        return latin1_class(cp)
    }
    if cp < 880 {
        if cp >= 768 && cp <= 879 {
            return CLS_OTHER
        }
        return CLS_LETTER
    }
    if cp < 8192 {
        if in_range(cp, 1632, 1641) || in_range(cp, 1776, 1785) || in_range(cp, 2406, 2415) {
            return CLS_DIGIT
        }
        if cp == 5760 {
            return CLS_SPACE
        }
        return CLS_LETTER
    }
    if cp < 11264 {
        return punct_class(cp)
    }
    if cp < 11776 {
        return CLS_LETTER
    }
    if cp < 12288 {
        return CLS_OTHER
    }
    if cp < 12352 {
        if cp == 12288 {
            return CLS_SPACE
        }
        return CLS_OTHER
    }
    if cp < 65536 {
        return bmp_high_class(cp)
    }
    if cp >= 127744 && cp <= 129791 {
        return CLS_OTHER
    }
    if in_range(cp, 118784, 120831) || cp >= 917504 {
        return CLS_OTHER
    }
    return CLS_LETTER
}

fn utf8_need(lead: u32) -> usize {
    if lead >= 240 && lead <= 244 {
        return 4
    }
    if lead >= 224 {
        if lead < 240 {
            return 3
        }
        return 0
    }
    if lead >= 194 && lead < 224 {
        return 2
    }
    return 0
}

fn class_at(p: u64, n: usize, i: usize) -> u32 {
    let b0: u32 = rt.ld8(p, i) as u32
    if b0 < 128 {
        return (1 << 8) | cp_class(b0)
    }
    let need: usize = utf8_need(b0)
    if need == 0 || i + need > n {
        return (1 << 8) | CLS_OTHER
    }
    let b1: u32 = rt.ld8(p, i + 1) as u32
    if (b1 & 192) != 128 {
        return (1 << 8) | CLS_OTHER
    }
    var cp: u32 = 0
    if need == 2 {
        cp = ((b0 & 31) << 6) | (b1 & 63)
        return (2 << 8) | cp_class(cp)
    }
    let b2: u32 = rt.ld8(p, i + 2) as u32
    if (b2 & 192) != 128 {
        return (1 << 8) | CLS_OTHER
    }
    if need == 3 {
        cp = ((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63)
        if cp < 2048 || (cp >= 55296 && cp <= 57343) {
            return (1 << 8) | CLS_OTHER
        }
        return (3 << 8) | cp_class(cp)
    }
    let b3: u32 = rt.ld8(p, i + 3) as u32
    if (b3 & 192) != 128 {
        return (1 << 8) | CLS_OTHER
    }
    cp = ((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63)
    if cp < 65536 || cp > 1114111 {
        return (1 << 8) | CLS_OTHER
    }
    return (4 << 8) | cp_class(cp)
}
