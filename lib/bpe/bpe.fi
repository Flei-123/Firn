// SPDX-License-Identifier: MPL-2.0
// lib/bpe/bpe.fi -- bpe: byte-level BPE tokenizer facade (train, encode, decode, stream, save/load, tokenizer.json export); u16 token ids: 256 byte tokens, then merges, then special tokens.
import std.rt
import std.vec
import bpe.model as bm
import bpe.train as bt
import bpe.encode as be
import bpe.decode as bd
import bpe.stream as bs
import bpe.serial as sr
import bpe.pretok as pt

export { model_new, model_free, train, train_opts, train_text, model_load, model_save, export_tokenizer_json, encoder_new, encoder_free, encode, encode_with, decode, decode_plain, vocab_size, merge_count, special_count, special_id, token_bytes, stream_new, stream_free, stream_feed, stream_finish, thread_work, PIECE_MAX }

const PIECE_MAX: usize = pt.PIECE_MAX

fn model_new() -> bm.Model {
    return bm.model_new()
}

fn model_free(m: *mut bm.Model) {
    bm.model_free(m)
}


fn train_opts(vocab_size: usize, min_count: i64, threads: u64) -> bt.TrainOpts {
    return bt.TrainOpts { vocab_size: vocab_size, min_count: min_count, threads: threads }
}

fn train(files: *mut Vec[str], vocab_size: usize, specials: *mut Vec[str], m: *mut bm.Model) -> bool {
    return bt.train_files(files, bt.opts_default(vocab_size), specials, m)
}

fn train_text(text: str, vocab_size: usize, specials: *mut Vec[str], m: *mut bm.Model) -> bool {
    return bt.train_text(text, bt.opts_default(vocab_size), specials, m)
}

fn thread_work(kind: u64, arg: u64) -> u64 {
    return bt.thread_work(kind, arg)
}

fn model_load(path: str, m: *mut bm.Model) -> bool {
    return sr.model_load(path, m)
}

fn model_save(m: *mut bm.Model, path: str) -> bool {
    return sr.model_save(m, path)
}

fn export_tokenizer_json(m: *mut bm.Model, out: *mut rt.Buf) {
    sr.export_json(m, out)
}

fn vocab_size(m: *mut bm.Model) -> usize {
    return bm.vocab_size(m)
}

fn merge_count(m: *mut bm.Model) -> usize {
    return bm.merge_count(m)
}

fn special_count(m: *mut bm.Model) -> usize {
    return bm.special_count(m)
}

fn special_id(m: *mut bm.Model, name: str) -> i64 {
    return bm.special_id(m, name)
}

fn token_bytes(m: *mut bm.Model, id: usize) -> str {
    return str { p: bm.token_ptr(m, id) as *mut u8, n: bm.token_len(m, id) }
}

fn encoder_new(m: *mut bm.Model) -> be.Enc {
    return be.enc_new(m)
}

fn encoder_free(e: *mut be.Enc) {
    be.enc_free(e)
}

fn encode_with(e: *mut be.Enc, text: str, out: *mut Vec[u16]) {
    be.encode_bytes(e, text.p as u64, text.n, out)
}

fn encode(m: *mut bm.Model, text: str, out: *mut Vec[u16]) {
    var e: be.Enc = be.enc_new(m)
    be.encode_bytes(&e, text.p as u64, text.n, out)
    be.enc_free(&e)
}

fn decode(m: *mut bm.Model, ids: *mut Vec[u16], out: *mut rt.Buf) -> bool {
    return bd.decode_ids(m, ids, out)
}

fn decode_plain(m: *mut bm.Model, ids: *mut Vec[u16], out: *mut rt.Buf) -> bool {
    return bd.decode_ids_plain(m, ids, out)
}

fn stream_new(m: *mut bm.Model) -> bs.Stream {
    return bs.stream_new(m)
}

fn stream_free(s: *mut bs.Stream) {
    bs.stream_free(s)
}

fn stream_feed(s: *mut bs.Stream, bytes: str, out: *mut Vec[u16]) {
    bs.stream_feed(s, bytes, out)
}

fn stream_finish(s: *mut bs.Stream, out: *mut Vec[u16]) {
    bs.stream_finish(s, out)
}
