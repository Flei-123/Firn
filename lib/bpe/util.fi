// SPDX-License-Identifier: MPL-2.0
// lib/bpe/util.fi -- bpe.util: small helpers for tools and tests (decimal text, argv strings, byte escaping, id lists, whole-file reads).
import std.rt
import std.vec
import std.fs

export { dec, arg_str, escape_bytes, unescape_bytes, ids_to_text, parse_ids, read_all, hex_digit }

fn dec(v: u64) -> str {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&b, v)
    return rt.buf_str(&b)
}

fn arg_str(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    if p == 0 {
        return ""
    }
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn hex_digit(v: u32) -> u8 {
    if v < 10 {
        return (48 + v) as u8
    }
    return (87 + v) as u8
}

fn escape_bytes(p: u64, n: usize, out: *mut rt.Buf) {
    var i: usize = 0
    while i < n {
        let c: u32 = rt.ld8(p, i) as u32
        if c >= 32 && c < 127 && c != 92 && c != 124 {
            rt.buf_push(out, c as u8)
        } else {
            rt.buf_push(out, 92 as u8)
            rt.buf_push(out, 120 as u8)
            rt.buf_push(out, hex_digit(c >> 4))
            rt.buf_push(out, hex_digit(c & 15))
        }
        i = i + 1
    }
}

fn hex_val(c: u32) -> i32 {
    if c >= 48 && c <= 57 {
        return (c - 48) as i32
    }
    if c >= 97 && c <= 102 {
        return (c - 87) as i32
    }
    return -1
}

fn unescape_bytes(s: str, out: *mut rt.Buf) -> bool {
    var i: usize = 0
    let p: u64 = s.p as u64
    while i < s.n {
        let c: u32 = rt.ld8(p, i) as u32
        if c != 92 {
            rt.buf_push(out, c as u8)
            i = i + 1
        } else {
            if i + 3 >= s.n {
                return false
            }
            let h: i32 = hex_val(rt.ld8(p, i + 2) as u32)
            let l: i32 = hex_val(rt.ld8(p, i + 3) as u32)
            if rt.ld8(p, i + 1) != 120 || h < 0 || l < 0 {
                return false
            }
            rt.buf_push(out, ((h * 16) + l) as u8)
            i = i + 4
        }
    }
    return true
}

fn ids_to_text(ids: *mut Vec[u16], out: *mut rt.Buf) {
    var i: usize = 0
    while i < vec_len[u16](ids) {
        if i > 0 {
            rt.buf_push(out, 44 as u8)
        }
        rt.buf_push_dec_u64(out, vec_at[u16](ids, i) as u64)
        i = i + 1
    }
}

fn parse_ids(s: str, out: *mut Vec[u16]) -> bool {
    var v: u64 = 0
    var have: bool = false
    var i: usize = 0
    while i <= s.n {
        var c: u32 = 44
        if i < s.n {
            c = rt.ld8(s.p as u64, i) as u32
        }
        if c >= 48 && c <= 57 {
            v = v * 10 + ((c - 48) as u64)
            have = true
        } else {
            if c != 44 {
                return false
            }
            if have {
                vec_push[u16](out, v as u16)
            }
            v = 0
            have = false
        }
        i = i + 1
    }
    return true
}

fn read_all(path: str, b: *mut rt.Buf) -> bool {
    let got: usize = fs.read_file(path, b) catch | e | (0 -% 1)
    return got != (0 -% 1)
}
