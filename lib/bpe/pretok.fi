// SPDX-License-Identifier: MPL-2.0
// lib/bpe/pretok.fi -- bpe.pretok: regex-free GPT-2/Llama3-style pretokenizer (single digits, contractions, letter runs with one leading symbol, punctuation runs, whitespace rules), pieces capped at PIECE_MAX bytes.
import std.rt
import bpe.charclass as cc

export { PIECE_MAX, next_piece, count_pieces }

const PIECE_MAX: usize = 64

fn lower(b: u32) -> u32 {
    if b >= 65 && b <= 90 {
        return b + 32
    }
    return b
}

fn capped(p: u64, i: usize, e: usize) -> usize {
    if e - i <= PIECE_MAX {
        return e
    }
    var cut: usize = i + PIECE_MAX
    var back: usize = 0
    while back < 4 && cut > i + 1 && (rt.ld8(p, cut) & 192) == 128 {
        cut = cut - 1
        back = back + 1
    }
    if (rt.ld8(p, cut) & 192) == 128 {
        return i + PIECE_MAX
    }
    return cut
}

fn contraction_len(p: u64, n: usize, i: usize) -> usize {
    if i + 1 >= n {
        return 0
    }
    let c1: u32 = lower(rt.ld8(p, i + 1) as u32)
    if c1 == 115 || c1 == 116 || c1 == 109 || c1 == 100 {
        return 2
    }
    if i + 2 < n {
        let c2: u32 = lower(rt.ld8(p, i + 2) as u32)
        if (c1 == 114 && c2 == 101) || (c1 == 118 && c2 == 101) || (c1 == 108 && c2 == 108) {
            return 3
        }
    }
    return 0
}

fn letters_end(p: u64, n: usize, start: usize) -> usize {
    var j: usize = start
    while j < n {
        let c: u32 = cc.class_at(p, n, j)
        if (c & 255) != cc.CLS_LETTER {
            return j
        }
        j = j + ((c >> 8) as usize)
    }
    return j
}

fn punct_piece_end(p: u64, n: usize, start: usize) -> usize {
    var j: usize = start
    while j < n {
        let c: u32 = cc.class_at(p, n, j)
        if (c & 255) != cc.CLS_OTHER {
            break
        }
        j = j + ((c >> 8) as usize)
    }
    while j < n {
        let b: u32 = rt.ld8(p, j) as u32
        if b != 10 && b != 13 {
            break
        }
        j = j + 1
    }
    return j
}

fn space_piece_end(p: u64, n: usize, i: usize) -> usize {
    var j: usize = i
    var last_start: usize = i
    var last_nl_end: usize = 0
    var count: usize = 0
    while j < n {
        let c: u32 = cc.class_at(p, n, j)
        let k: u32 = c & 255
        if k != cc.CLS_SPACE && k != cc.CLS_NEWLINE {
            break
        }
        last_start = j
        j = j + ((c >> 8) as usize)
        count = count + 1
        if k == cc.CLS_NEWLINE {
            last_nl_end = j
        }
    }
    if last_nl_end > 0 {
        return last_nl_end
    }
    if j >= n || count < 2 {
        return j
    }
    return last_start
}

fn next_piece(p: u64, n: usize, i: usize) -> usize {
    let c0: u32 = cc.class_at(p, n, i)
    let k0: u32 = c0 & 255
    let l0: usize = (c0 >> 8) as usize
    if rt.ld8(p, i) == 39 {
        let cl: usize = contraction_len(p, n, i)
        if cl > 0 {
            return capped(p, i, i + cl)
        }
    }
    if k0 == cc.CLS_LETTER {
        return capped(p, i, letters_end(p, n, i + l0))
    }
    if k0 != cc.CLS_NEWLINE && k0 != cc.CLS_DIGIT && i + l0 < n {
        let c1: u32 = cc.class_at(p, n, i + l0)
        if (c1 & 255) == cc.CLS_LETTER {
            return capped(p, i, letters_end(p, n, i + l0 + ((c1 >> 8) as usize)))
        }
    }
    if k0 == cc.CLS_DIGIT {
        return i + l0
    }
    var j: usize = i
    if rt.ld8(p, i) == 32 {
        j = i + 1
    }
    if j < n {
        let cj: u32 = cc.class_at(p, n, j)
        if (cj & 255) == cc.CLS_OTHER {
            return capped(p, i, punct_piece_end(p, n, j))
        }
    }
    return capped(p, i, space_piece_end(p, n, i))
}

fn count_pieces(p: u64, n: usize) -> usize {
    var i: usize = 0
    var c: usize = 0
    while i < n {
        i = next_piece(p, n, i)
        c = c + 1
    }
    return c
}
