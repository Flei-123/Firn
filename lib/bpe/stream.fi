// lib/bpe/stream.fi -- bpe.stream: streaming encoder; chunk bytes in, token ids out; pieces are emitted only once final, the last piece and an incomplete UTF-8 tail are carried to the next chunk.
import std.rt
import std.vec
import bpe.model as bm
import bpe.pretok as pt
import bpe.encode as be
import bpe.charclass as cc

export { Stream, stream_new, stream_free, stream_feed, stream_finish, stream_pending }

struct Stream {
    enc: be.Enc,
    carry: rt.Buf,
}

fn stream_new(m: *mut bm.Model) -> Stream {
    return Stream { enc: be.enc_new(m), carry: rt.buf_new() }
}

fn stream_free(s: *mut Stream) {
    be.enc_free(&(*s).enc)
    rt.buf_free(&(*s).carry)
}

fn stream_pending(s: *mut Stream) -> usize {
    return rt.buf_len(&(*s).carry)
}

fn incomplete_tail(p: u64, n: usize) -> usize {
    var back: usize = 1
    while back <= 3 && back <= n {
        let b: u32 = rt.ld8(p, n - back) as u32
        if (b & 192) != 128 {
            let need: usize = cc.utf8_need(b)
            if need > back {
                return back
            }
            return 0
        }
        back = back + 1
    }
    return 0
}

fn stream_feed(s: *mut Stream, bytes: str, out: *mut Vec[u16]) {
    rt.buf_push_bytes(&(*s).carry, bytes.p as u64, bytes.n)
    let p: u64 = rt.buf_ptr(&(*s).carry)
    let total: usize = rt.buf_len(&(*s).carry)
    let n: usize = total - incomplete_tail(p, total)
    var i: usize = 0
    var last: usize = 0
    while i < n {
        let end: usize = pt.next_piece(p, n, i)
        if end >= n {
            break
        }
        be.encode_piece(&(*s).enc, p + (i as u64), end - i, out)
        i = end
        last = i
    }
    let keep: usize = total - last
    rt.mem_copy(p, p + (last as u64), keep)
    rt.buf_set_len(&(*s).carry, keep)
}

fn stream_finish(s: *mut Stream, out: *mut Vec[u16]) {
    let p: u64 = rt.buf_ptr(&(*s).carry)
    let n: usize = rt.buf_len(&(*s).carry)
    be.encode_bytes(&(*s).enc, p, n, out)
    rt.buf_set_len(&(*s).carry, 0)
}
