// lib/bpe/decode.fi -- bpe.decode: token ids back to bytes (special tokens decode to their literal text, or are skipped).
import std.rt
import std.vec
import bpe.model as bm

export { decode_range, decode_ids, decode_ids_plain }

fn decode_range(m: *mut bm.Model, ids: u64, n: usize, out: *mut rt.Buf, skip_specials: bool) -> bool {
    let first_special: usize = bm.first_special_id(m)
    let vocab: usize = bm.vocab_size(m)
    var i: usize = 0
    var ok: bool = true
    while i < n {
        let id: usize = rt.ld16(ids, i) as usize
        i = i + 1
        if id >= vocab {
            ok = false
            continue
        }
        if skip_specials && id >= first_special {
            continue
        }
        rt.buf_push_bytes(out, bm.token_ptr(m, id), bm.token_len(m, id))
    }
    return ok
}

fn decode_ids(m: *mut bm.Model, ids: *mut Vec[u16], out: *mut rt.Buf) -> bool {
    return decode_range(m, vec_ptr[u16](ids), vec_len[u16](ids), out, false)
}

fn decode_ids_plain(m: *mut bm.Model, ids: *mut Vec[u16], out: *mut rt.Buf) -> bool {
    return decode_range(m, vec_ptr[u16](ids), vec_len[u16](ids), out, true)
}
