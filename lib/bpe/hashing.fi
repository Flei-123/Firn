// lib/bpe/hashing.fi -- bpe.hashing: FNV-1a based hash of a byte span used by the word cache and the trainer word table.
import std.rt

export { piece_hash }

const HASH_PRIME: u64 = 1099511628211
const HASH_BASIS: u64 = 14695981039346656037

fn piece_hash(p: u64, len: usize) -> u64 {
    var h: u64 = HASH_BASIS
    var i: usize = 0
    while i < len {
        h = (h ^ (rt.ld8(p, i) as u64)) *% HASH_PRIME
        i = i + 1
    }
    return h ^ (h >> 29)
}
