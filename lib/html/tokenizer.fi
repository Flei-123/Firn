                    tokens.tok_set_force_quirks(s, true)
                    tokens.tok_emit_at(s, pos)
                    state = State::Done
                } else {
                    tokens.tok_pubid_push(s, null_replacement(c, s, input, idx))
                }
            }
            State::AfterDoctypePublicIdentifier => {
                if is_space(c) {
                    state = State::BetweenDoctypePublicAndSystem
                } else if c == 62 as u32 {
                    tokens.tok_emit_at(s, pos)
                    state = State::Data
                } else if c == 34 as u32 {
                    tokens.sink_error_at(s, error_codes.F_MISSING_WHITESPACE_BETWEEN_DOCTYPE_PUBLIC_AND_SYSTEM_IDENTIFIERS, input, idx)
                    tokens.tok_sysid_start(s)
                    state = State::DoctypeSystemIdentifierDouble
                } else if c == 39 as u32 {
                    tokens.sink_error_at(s, error_codes.F_MISSING_WHITESPACE_BETWEEN_DOCTYPE_PUBLIC_AND_SYSTEM_IDENTIFIERS, input, idx)
                    tokens.tok_sysid_start(s)
                    state = State::DoctypeSystemIdentifierSingle
                } else if c == EOF {
                    tokens.sink_error_at(s, error_codes.F_EOF_IN_DOCTYPE, input, idx)
                    tokens.tok_set_force_quirks(s, true)
                    tokens.tok_emit_at(s, pos)
                    state = State::Done
                } else {
                    tokens.sink_error_at(s, error_codes.F_MISSING_QUOTE_BEFORE_DOCTYPE_SYSTEM_IDENTIFIER, input, idx)
                    tokens.tok_set_force_quirks(s, true)
                    pos = pos - 1
                    state = State::BogusDoctype
                }
            }
            State::BetweenDoctypePublicAndSystem => {
                if is_space(c) {
                    // skip
                } else if c == 62 as u32 {
                    tokens.tok_emit_at(s, pos)
                    state = State::Data
                } else if c == 34 as u32 {
                    tokens.tok_sysid_start(s)
                    state = State::DoctypeSystemIdentifierDouble
                } else if c == 39 as u32 {
                    tokens.tok_sysid_start(s)
                    state = State::DoctypeSystemIdentifierSingle
                } else if c == EOF {
                    tokens.sink_error_at(s, error_codes.F_EOF_IN_DOCTYPE, input, idx)
                    tokens.tok_set_force_quirks(s, true)
                    tokens.tok_emit_at(s, pos)
                    state = State::Done
                } else {
                    tokens.sink_error_at(s, error_codes.F_MISSING_QUOTE_BEFORE_DOCTYPE_SYSTEM_IDENTIFIER, input, idx)
                    tokens.tok_set_force_quirks(s, true)
                    pos = pos - 1
                    state = State::BogusDoctype
                }
            }
            State::AfterDoctypeSystemKeyword => {
                if is_space(c) {
                    state = State::BeforeDoctypeSystemIdentifier
                } else if c == 34 as u32 {
                    tokens.sink_error_at(s, error_codes.F_MISSING_WHITESPACE_AFTER_DOCTYPE_SYSTEM_KEYWORD, input, idx)
                    tokens.tok_sysid_start(s)
