                    tokens.tok_set_force_quirks(s, true)
                    tokens.tok_emit_at(s, pos)
                    state = State::Done
                } else {
                    tokens.tok_pubid_push(s, null_replacement(c, s, input, idx))
                }
            }
            State::DoctypePublicIdentifierSingle => {
                if c == 39 as u32 {
                    state = State::AfterDoctypePublicIdentifier
                } else if c == 62 as u32 {
                    tokens.sink_error_at(s, error_codes.F_ABRUPT_DOCTYPE_PUBLIC_IDENTIFIER, input, idx)
                    tokens.tok_set_force_quirks(s, true)
                    tokens.tok_emit_at(s, pos)
