                } else {
                    tokens.tok_sysid_push(s, null_replacement(c, s, input, idx))
                }
            }
            State::DoctypeSystemIdentifierSingle => {
                if c == 39 as u32 {
                    state = State::AfterDoctypeSystemIdentifier
                } else if c == 62 as u32 {
                    tokens.sink_error_at(s, error_codes.F_ABRUPT_DOCTYPE_SYSTEM_IDENTIFIER, input, idx)
                    tokens.tok_set_force_quirks(s, true)
                    tokens.tok_emit_at(s, pos)
                    state = State::Data
                } else if c == EOF {
                    tokens.sink_error_at(s, error_codes.F_EOF_IN_DOCTYPE, input, idx)
                    tokens.tok_set_force_quirks(s, true)
                    tokens.tok_emit_at(s, pos)
                    state = State::Done
                } else {
