                    tokens.tok_set_force_quirks(s, true)
                    pos = pos - 1
                    state = State::BogusDoctype
                }
            }
            State::BeforeDoctypeSystemIdentifier => {
                if is_space(c) {
                    // skip
                } else if c == 34 as u32 {
                    tokens.tok_sysid_start(s)
                    state = State::DoctypeSystemIdentifierDouble
                } else if c == 39 as u32 {
                    tokens.tok_sysid_start(s)
                    state = State::DoctypeSystemIdentifierSingle
                } else if c == 62 as u32 {
