// lib/html/tokenize_main.fi — Treiber des HTML5-Tokenizers (Wurzeldatei).
//
// Liest von der Standardeingabe einen Strom von AUFTRAEGEN und schreibt je
// Auftrag EINE Zeile html5lib-JSON auf die Standardausgabe.
//
// Auftragsformat (little-endian, siehe tools/tokenizer/PROTOKOLL.md):
//     u32  startzustand   0=Data 1=PLAINTEXT 2=RCDATA 3=RAWTEXT 4=ScriptData 5=CDATA
//     u32  flaggen       Bit 0 = XML-Anpassung (xmlViolationTests), sonst 0
//     u32  len_lasttag    Laenge des lastStartTag in Bytes (WTF-8)
//     u8[] lasttag
//     u32  len_input      Laenge der Eingabe in Bytes (WTF-8)
//     u8[] input
// Ende des Stroms = Ende der Eingabe.
//
// Ausgabe je Auftrag:
//     [ ... ]                     Tokenliste (html5lib-JSON, reines ASCII)
//     ["NICHT-UNTERSTUETZT"]      der Tokenizer hat einen Zustand erreicht,
//                                 den er noch nicht kennt -> der Harness zaehlt
//                                 den Fall als FEHLSCHLAG (nie als uebersprungen)
//
// Uebersetzen:  firnc -o build/tokenize lib/html/tokenize_main.fi
import mem
import tokens
import tokenizer

// Liest ein u32 (little-endian) aus dem Eingabepuffer.
#[no_gc]
fn read_u32(b: *mut mem.Buf, off: usize) -> u32 {
    var v: u32 = 0
    var i: usize = 0
    while i < 4 {
        v = v | ((mem.buf_at(b, off + i) as u32) << (8 * i as u32))
        i = i + 1
    }
    return v
}

// WTF-8 -> Codepunkte. Ungepaarte Surrogate (ED A0 80 …) bleiben erhalten.
// Zeilenenden werden nach HTML-Standard normalisiert (\r\n und \r -> \n).
// Byte an der absoluten Position `k`, 0 jenseits des Endes — wortgleich mit
// `mem.buf_at`, aber mit VORGELADENEM Basiszeiger und vorgeladener Laenge.
//
// WARUM: `mem.buf_at(b, k)` liest je Aufruf zwei Felder aus dem Struct —
// `(*b).len` fuer die Bereichspruefung und `(*b).ptr` fuer die Adresse. Der
// Optimierer darf diese Ladevorgaenge nicht ueber die Schleife hinweg
// zusammenfassen, weil dazwischen ueber einen anderen Zeiger (`out`)
// geschrieben wird und Firn noch keine Aliasanalyse hat: er kann nicht
// beweisen, dass `out` und `b` verschiedene Objekte sind.
//
// Gemessen (callgrind, Korpus realweb): `dekodiere` brauchte dadurch 225
// Instruktionen je Byte und war mit 28 % der groesste Einzelposten des
// Tokenizers — bei bis zu fuenf Zugriffen je Zeichen.
#[no_gc]
fn byte_at(base: u64, total: usize, k: usize) -> u32 {
    if k >= total {
        return 0 as u32
    }
    return (*((base + k as u64) as *mut u8)) as u32
}

#[no_gc]
fn decode(b: *mut mem.Buf, off: usize, len: usize, out: *mut mem.CpBuf) {
    mem.cp_clear(out)
    // EINMAL laden statt bei jedem Zugriff (siehe byte_bei).
    let base: u64 = mem.buf_ptr(b) as u64
    let total: usize = mem.buf_len(b)
    // Ein Codepunkt kostet mindestens ein Byte: `len` Plaetze reichen IMMER.
    mem.cp_reserve(out, len)
    let target: u64 = mem.cp_ptr(out) as u64
    var outi: usize = 0
    var i: usize = 0
    while i < len {
        let c0: u32 = byte_at(base, total, off + i)
        // Schnellweg (Runde 40): reines ASCII ausser CR.
        if c0 < 0x80 as u32 && c0 != 13 as u32 {
            *((target + outi as u64 * 4) as *mut u32) = c0
            outi = outi + 1
            i = i + 1
            continue
        }
        var cp: u32 = c0
        var width: usize = 1
        if c0 >= 0xF0 as u32 {
            width = 4
            cp = ((c0 & 0x07 as u32) << 18) |
                ((byte_at(base, total, off + i + 1) & 0x3F as u32) << 12) |
                ((byte_at(base, total, off + i + 2) & 0x3F as u32) << 6) |
                (byte_at(base, total, off + i + 3) & 0x3F as u32)
        } else if c0 >= 0xE0 as u32 {
            width = 3
            cp = ((c0 & 0x0F as u32) << 12) |
                ((byte_at(base, total, off + i + 1) & 0x3F as u32) << 6) |
                (byte_at(base, total, off + i + 2) & 0x3F as u32)
        } else if c0 >= 0xC0 as u32 {
            width = 2
            cp = ((c0 & 0x1F as u32) << 6) |
                (byte_at(base, total, off + i + 1) & 0x3F as u32)
        }
        i = i + width
        if cp == 13 as u32 {
            // \r bzw. \r\n -> \n
            cp = 10 as u32
            if i < len && byte_at(base, total, off + i) == 10 as u32 {
                i = i + 1
            }
        }
        *((target + outi as u64 * 4) as *mut u32) = cp
        outi = outi + 1
    }
    mem.cp_set_len(out, outi)
}

#[no_gc]
fn main() -> i32 {
    var ins: mem.Buf = mem.buf_new()
    mem.read_all_stdin(&ins)

    var s: tokens.Sink = tokens.sink_new()
    tokens.sink_init(&s)

    var text: mem.CpBuf = mem.cp_new()
    var lasttag: mem.CpBuf = mem.cp_new()

    let total: usize = mem.buf_len(&ins)
    var off: usize = 0
    while off + 16 <= total {
        let state: u32 = read_u32(&ins, off)
        let flags: u32 = read_u32(&ins, off + 4)
        let ltlen: usize = read_u32(&ins, off + 8) as usize
        decode(&ins, off + 12, ltlen, &lasttag)
        let inlen: usize = read_u32(&ins, off + 12 + ltlen) as usize
        decode(&ins, off + 16 + ltlen, inlen, &text)
        off = off + 16 + ltlen + inlen

        tokens.sink_set_xml_mode(&s, (flags & 1 as u32) != 0 as u32)
        tokens.sink_set_last_start_tag_cp(&s, &lasttag)
        tokens.sink_begin(&s)
        let ok: bool = tokenizer.tokenize(&text, state, &s)
        if ok {
            tokens.sink_end(&s)
        } else {
            tokens.sink_abort(&s)
        }
    }
    tokens.sink_flush_out(&s)
    return 0
}
