// lib/html/entities_ausfall.fi — Nachweis zweier Zusagen der Namenstabelle aus
// lib/html/entities.fi. Beides in Firn geprueft, kein Werkzeugtrick:
//
//   1. KEINE FESTE ADRESSE. Die Tabelle wird mit `mmap` OHNE `MAP_FIXED` an
//      einer vom Kern gewaehlten Adresse angelegt und ueber den `Sink`
//      durchgereicht. Nachweis: dieses Programm gibt die Adresse aus;
//      `tools/tokenizer/run.sh` startet es zweimal und verlangt VERSCHIEDENE
//      Adressen (ASLR) — mit einer fest verdrahteten Adresse waere das
//      unmoeglich.
//
//   2. AUSFALL IST SICHTBAR. Liefert `entities.tabelle()` den Nullzeiger (mmap
//      fehlgeschlagen), meldet `char_ref` REF_UNMOEGLICH und der Tokenizer
//      setzt `nicht_unterstuetzt` (`tokenize` -> false), statt still falsch zu
//      tokenisieren. Der Ausfall wird hier ohne Kunstgriff erzwungen:
//      `sink_set_entities_versucht(s, true)` bei Tabellenzeiger 0 ist genau der
//      Zustand nach einem fehlgeschlagenen mmap.
//
// Exit-Code 0 nur, wenn beide Zusagen gehalten werden.
//
// Uebersetzen:  firnc -o build/entities_ausfall lib/html/entities_ausfall.fi
import mem
import tokens
import tokenizer
import entities

// Stufe 0 kennt keine Zeichenkettenliterale (SPEC §14.1.str S1) — die
// Meldungen stehen deshalb als Bytefolgen da, der Text jeweils im Kommentar.
fn schreibe(b: *mut mem.Buf, t: *mut u8, n: usize) {
    var i: usize = 0
    while i < n {
        mem.buf_push(b, *((t as usize + i) as *mut u8))
        i = i + 1
    }
}

fn push_hex(b: *mut mem.Buf, v: u64) {
    if v == 0 {
        mem.buf_push(b, 48 as u8)
        return
    }
    var d: [u8; 16] = [0 as u8; 16]
    var n: usize = 0
    var x: u64 = v
    while x > 0 {
        let z: u64 = x % 16
        if z < 10 {
            d[n] = (z as u8) + 48 as u8
        } else {
            d[n] = (z as u8) + 87 as u8
        }
        x = x / 16
        n = n + 1
    }
    while n > 0 {
        n = n - 1
        mem.buf_push(b, d[n])
    }
}

// 'tabelle-adresse 0x'
fn m_addr(b: *mut mem.Buf) {
    var t: [u8; 18] = [116, 97, 98, 101, 108, 108, 101, 45, 97, 100, 114, 101, 115, 115, 101, 32, 48, 120]
    schreibe(b, &t[0], 18)
}

// '\n'
fn m_nl(b: *mut mem.Buf) {
    var t: [u8; 1] = [10]
    schreibe(b, &t[0], 1)
}

// 'FEHLER: tabelle() lieferte 0, obwohl mmap moeglich sein sollte\n'
fn m_f1(b: *mut mem.Buf) {
    var t: [u8; 63] = [70, 69, 72, 76, 69, 82, 58, 32, 116, 97, 98, 101, 108, 108, 101, 40, 41, 32, 108, 105, 101, 102, 101, 114, 116, 101, 32, 48, 44, 32, 111, 98, 119, 111, 104, 108, 32, 109, 109, 97, 112, 32, 109, 111, 101, 103, 108, 105, 99, 104, 32, 115, 101, 105, 110, 32, 115, 111, 108, 108, 116, 101, 10]
    schreibe(b, &t[0], 63)
}

// "regelfall: '&amp;' tokenisiert, kein Abbruch\n"
fn m_reg(b: *mut mem.Buf) {
    var t: [u8; 45] = [114, 101, 103, 101, 108, 102, 97, 108, 108, 58, 32, 39, 38, 97, 109, 112, 59, 39, 32, 116, 111, 107, 101, 110, 105, 115, 105, 101, 114, 116, 44, 32, 107, 101, 105, 110, 32, 65, 98, 98, 114, 117, 99, 104, 10]
    schreibe(b, &t[0], 45)
}

// 'FEHLER: Regelfall brach ab\n'
fn m_f2(b: *mut mem.Buf) {
    var t: [u8; 27] = [70, 69, 72, 76, 69, 82, 58, 32, 82, 101, 103, 101, 108, 102, 97, 108, 108, 32, 98, 114, 97, 99, 104, 32, 97, 98, 10]
    schreibe(b, &t[0], 27)
}

// 'FEHLER: tabelle() lieferte trotz Ausfall einen Zeiger\n'
fn m_f3(b: *mut mem.Buf) {
    var t: [u8; 54] = [70, 69, 72, 76, 69, 82, 58, 32, 116, 97, 98, 101, 108, 108, 101, 40, 41, 32, 108, 105, 101, 102, 101, 114, 116, 101, 32, 116, 114, 111, 116, 122, 32, 65, 117, 115, 102, 97, 108, 108, 32, 101, 105, 110, 101, 110, 32, 90, 101, 105, 103, 101, 114, 10]
    schreibe(b, &t[0], 54)
}

// 'FEHLER: Ausfall verschluckt - still falsch tokenisiert\n'
fn m_f4(b: *mut mem.Buf) {
    var t: [u8; 55] = [70, 69, 72, 76, 69, 82, 58, 32, 65, 117, 115, 102, 97, 108, 108, 32, 118, 101, 114, 115, 99, 104, 108, 117, 99, 107, 116, 32, 45, 32, 115, 116, 105, 108, 108, 32, 102, 97, 108, 115, 99, 104, 32, 116, 111, 107, 101, 110, 105, 115, 105, 101, 114, 116, 10]
    schreibe(b, &t[0], 55)
}

// 'ausfall: tabelle()==0 -> nicht_unterstuetzt, Abbruch statt falscher Ausgabe\n'
fn m_aus(b: *mut mem.Buf) {
    var t: [u8; 76] = [97, 117, 115, 102, 97, 108, 108, 58, 32, 116, 97, 98, 101, 108, 108, 101, 40, 41, 61, 61, 48, 32, 45, 62, 32, 110, 105, 99, 104, 116, 95, 117, 110, 116, 101, 114, 115, 116, 117, 101, 116, 122, 116, 44, 32, 65, 98, 98, 114, 117, 99, 104, 32, 115, 116, 97, 116, 116, 32, 102, 97, 108, 115, 99, 104, 101, 114, 32, 65, 117, 115, 103, 97, 98, 101, 10]
    schreibe(b, &t[0], 76)
}

// "&amp;" als Codepunkte.
fn eingabe(t: *mut mem.CpBuf) {
    mem.cp_clear(t)
    mem.cp_push(t, 38 as u32)    // &
    mem.cp_push(t, 97 as u32)    // a
    mem.cp_push(t, 109 as u32)   // m
    mem.cp_push(t, 112 as u32)   // p
    mem.cp_push(t, 59 as u32)    // ;
}

fn main() -> i32 {
    var aus: mem.Buf = mem.buf_neu()
    var text: mem.CpBuf = mem.cp_neu()
    var fehler: i32 = 0

    // ---- 1. Regelfall: Tabelle wird gebaut, Adresse waehlt der Kern.
    var s1: tokens.Sink = tokens.sink_neu()
    tokens.sink_init(&s1)
    let p: *mut u8 = entities.tabelle(&s1)
    if p as usize == 0 {
        m_f1(&aus)
        fehler = 1
    } else {
        m_addr(&aus)
        push_hex(&aus, p as u64)
        m_nl(&aus)
    }

    eingabe(&text)
    tokens.sink_begin(&s1)
    let ok1: bool = tokenizer.tokenize(&text, 0 as u32, &s1)
    if ok1 {
        tokens.sink_end(&s1)
        m_reg(&aus)
    } else {
        tokens.sink_abort(&s1)
        m_f2(&aus)
        fehler = 2
    }

    // ---- 2. Ausfall: Tabelle nicht verfuegbar (mmap fehlgeschlagen).
    var s2: tokens.Sink = tokens.sink_neu()
    tokens.sink_init(&s2)
    tokens.sink_set_entities_versucht(&s2, true)   // Zustand nach mmap-Fehler
    if entities.tabelle(&s2) as usize != 0 {
        m_f3(&aus)
        fehler = 3
    }
    eingabe(&text)
    tokens.sink_begin(&s2)
    let ok2: bool = tokenizer.tokenize(&text, 0 as u32, &s2)
    tokens.sink_abort(&s2)
    if ok2 {
        m_f4(&aus)
        fehler = 4
    } else {
        m_aus(&aus)
    }

    mem.buf_flush(&aus, 1)
    return fehler
}
