// SPDX-License-Identifier: GPL-2.0-only
// lib/html/entities_failure.fi -- the proof of two promises of the name table
// from lib/html/entities.fi. Both checked in Firn, no tool trickery:
//
//   1. NO FIXED ADDRESS. The table is created with `mmap` WITHOUT `MAP_FIXED`
//      at an address chosen by the kernel and passed through the `Sink`.
//      The proof: this program prints the address;
//      `tools/tokenizer/run.sh` starts it twice and demands DIFFERENT
//      addresses (ASLR) -- with a hard wired address that would be
//      impossible.
//
//   2. A FAILURE IS VISIBLE. If `entities.table()` returns the null pointer
//      (mmap failed), `char_ref` reports REF_UNMOEGLICH and the tokenizer
//      reports the case as unsupported (`tokenize` -> false) instead of
//      tokenizing wrongly in silence. The failure is forced here without any
//      trick: `sink_set_entities_tries(s, true)` with a table pointer of 0 is
//      exactly the state after a failed mmap.
//
// Exit code 0 only when both promises hold.
//
// Compile with:  firnc -o build/entities_failure lib/html/entities_failure.fi
import mem
import tokens
import tokenizer
import entities

// The messages below are fixed byte sequences; the comment above each
// one gives its meaning in English (the wire text itself stays as it is).
#[no_gc]
fn write(b: *mut mem.Buf, t: *mut u8, n: usize) {
    var i: usize = 0
    while i < n {
        mem.buf_push(b, *((t as usize + i) as *mut u8))
        i = i + 1
    }
}

#[no_gc]
fn push_hex(b: *mut mem.Buf, v: u64) {
    if v == 0 {
        mem.buf_push(b, 48 as u8)
        return
    }
    var d: [u8; 16] = [0 as u8; 16]
    var n: usize = 0
    var x: u64 = v
    while x > 0 {
        let z: u64 = x % 16
        if z < 10 {
            d[n] = (z as u8) + 48 as u8
        } else {
            d[n] = (z as u8) + 87 as u8
        }
        x = x / 16
        n = n + 1
    }
    while n > 0 {
        n = n - 1
        mem.buf_push(b, d[n])
    }
}

// the label in front of the table address
#[no_gc]
fn m_addr(b: *mut mem.Buf) {
    var t: [u8; 16] = "table address 0x"
    write(b, &t[0], 16)
}

// '\n'
#[no_gc]
fn m_nl(b: *mut mem.Buf) {
    var t: [u8; 1] = "\n"
    write(b, &t[0], 1)
}

// failure: the table came back as 0 even though mmap should be possible
#[no_gc]
fn m_f1(b: *mut mem.Buf) {
    var t: [u8; 63] = "ERROR: table() came back as 0 although mmap should be possible\n"
    write(b, &t[0], 63)
}

// the normal case: '&amp;' was tokenized, no abort
#[no_gc]
fn m_reg(b: *mut mem.Buf) {
    var t: [u8; 41] = "normal case: '&amp;' tokenized, no abort\n"
    write(b, &t[0], 41)
}

// failure: the normal case aborted
#[no_gc]
fn m_f2(b: *mut mem.Buf) {
    var t: [u8; 31] = "ERROR: the normal case aborted\n"
    write(b, &t[0], 31)
}

// failure: the table came back as a pointer even though it was forced to fail
#[no_gc]
fn m_f3(b: *mut mem.Buf) {
    var t: [u8; 57] = "ERROR: table() gave a pointer despite the forced failure\n"
    write(b, &t[0], 57)
}

// failure: the forced failure was swallowed - tokenized wrongly in silence
#[no_gc]
fn m_f4(b: *mut mem.Buf) {
    var t: [u8; 56] = "ERROR: failure swallowed - tokenized wrongly in silence\n"
    write(b, &t[0], 56)
}

// the failure line: table()==0 -> unsupported, abort instead of wrong output
#[no_gc]
fn m_out(b: *mut mem.Buf) {
    var t: [u8; 66] = "failure: table()==0 -> unsupported, abort instead of wrong output\n"
    write(b, &t[0], 66)
}

// "&amp;" as code points.
#[no_gc]
fn input(t: *mut mem.CpBuf) {
    mem.cp_clear(t)
    mem.cp_push(t, 38 as u32) // &
    mem.cp_push(t, 97 as u32) // a
    mem.cp_push(t, 109 as u32) // m
    mem.cp_push(t, 112 as u32) // p
    mem.cp_push(t, 59 as u32) // ;
}

#[no_gc]
fn main() -> i32 {
    var out: mem.Buf = mem.buf_new()
    var text: mem.CpBuf = mem.cp_new()
    var err: i32 = 0

    // ---- 1. The normal case: the table is built, the kernel picks the address.
    var s1: tokens.Sink = tokens.sink_new()
    tokens.sink_init(&s1)
    let p: *mut u8 = entities.table(&s1)
    if p as usize == 0 {
        m_f1(&out)
        err = 1
    } else {
        m_addr(&out)
        push_hex(&out, p as u64)
        m_nl(&out)
    }

    input(&text)
    tokens.sink_begin(&s1)
    let ok1: bool = tokenizer.tokenize(&text, 0 as u32, &s1)
    if ok1 {
        tokens.sink_end(&s1)
        m_reg(&out)
    } else {
        tokens.sink_abort(&s1)
        m_f2(&out)
        err = 2
    }

    // ---- 2. The failure: the table is not available (mmap failed).
    var s2: tokens.Sink = tokens.sink_new()
    tokens.sink_init(&s2)
    tokens.sink_set_entities_tries(&s2, true) // The state after an mmap failure
    if entities.table(&s2) as usize != 0 {
        m_f3(&out)
        err = 3
    }
    input(&text)
    tokens.sink_begin(&s2)
    let ok2: bool = tokenizer.tokenize(&text, 0 as u32, &s2)
    tokens.sink_abort(&s2)
    if ok2 {
        m_f4(&out)
        err = 4
    } else {
        m_out(&out)
    }

    mem.buf_flush(&out, 1)
    return err
}
