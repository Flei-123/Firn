// SPDX-License-Identifier: GPL-2.0-only
// lib/html/mem.fi -- the memory and buffer layer of the HTML5 tokenizer.
//
// WHY ITS OWN AND NOT lib/str: `lib/str/*.fi` is pulled in through the
// includer tools/strlib/expand.py (`//#include`), not through the module
// system -- those files do not qualify their calls with module names.
// Using them here through `import` would mean rewriting them and would break
// the tests generated by expand.py. This file is therefore a small,
// self contained layer (an mmap heap + two vectors). Named honestly: that is
// a duplication of about 80 lines from lib/str/alloc.fi.
//
// The interface (the contract for every module under lib/html/):
//   heap_alloc(n) -> *mut u8      n bytes, zero initialized, 0 on failure
//   heap_free(p, n)
//   mem_copy(dst, src, n)
//   write_all(fd, p, n)
//
//   Buf   -- a vector of u8   (the output buffer, raw bytes)
//   CpBuf -- a vector of u32  (code point sequences: tag names, attribute values, text)
export {
    heap_alloc, heap_free, mem_copy, write_all, read_all_stdin,
    Buf, buf_new, buf_init, buf_free, buf_clear, buf_reserve, buf_push, buf_len, buf_at,
    buf_ptr, buf_flush, buf_push_dec, buf_set_len,
    CpBuf, cp_new, cp_init, cp_free, cp_clear, cp_push, cp_len, cp_at, cp_set,
    cp_reserve, cp_ptr, cp_set_len,
    cp_truncate, cp_eq_cp, cp_copy_from, cp_eq_ascii_lower,
}

const SYS_READ: i64 = 0
const SYS_WRITE: i64 = 1
const SYS_MMAP: i64 = 9
const SYS_MUNMAP: i64 = 11
const PROT_READ_WRITE: i64 = 3
const MAP_PRIVATE_ANON: i64 = 34

#[no_gc]
fn page_round(n: usize) -> usize {
    return (n + 4095) / 4096 * 4096
}

// n contiguous, zero initialized bytes; 0 on failure.
#[no_gc]
fn heap_alloc(n: usize) -> *mut u8 {
    if n == 0 {
        return 0 as *mut u8
    }
    let len: usize = page_round(n)
    let r: i64 = syscall(SYS_MMAP, 0, len as i64, PROT_READ_WRITE, MAP_PRIVATE_ANON, -1, 0)
    if r < 0 && r > -4096 {
        return 0 as *mut u8
    }
    return r as *mut u8
}

#[no_gc]
fn heap_free(p: *mut u8, n: usize) {
    if p as usize != 0 {
        syscall(SYS_MUNMAP, p as i64, page_round(n) as i64)
    }
}

// WORD BY WORD, NOT BYTE BY BYTE.
//
// Measured (callgrind, corpus realweb, round 43): copying byte by byte was,
// with **332.9 million instructions = 25.7 % of the whole measured run**, the
// second largest item of all -- and not inside the tokenizer but while
// READING the input: `read_all_stdin` doubles the buffer from 64 KiB to
// 8 MiB and copies a total of 8,323,072 bytes while doing so. Compiled over
// the base path (without register allocation), every single byte cost
// **40 instructions**.
//
// Eight bytes per pass are allowed: both areas are at least `n` bytes large,
// so an access at `i + 8 <= n` lies entirely inside, and x86-64 permits
// unaligned 8 byte accesses. The remainder runs byte by byte.
//
// UNCHANGED: the copying goes forwards. Overlapping areas with dst > src
// were not allowed before and still are not.
#[no_gc]
fn mem_copy(dst: *mut u8, src: *mut u8, n: usize) {
    var i: usize = 0
    while i + 8 <= n {
        *((dst as usize + i) as *mut u64) = *((src as usize + i) as *mut u64)
        i = i + 8
    }
    while i < n {
        *((dst as usize + i) as *mut u8) = *((src as usize + i) as *mut u8)
        i = i + 1
    }
}

#[no_gc]
fn write_all(fd: i64, p: *mut u8, n: usize) {
    var off: usize = 0
    while off < n {
        let r: i64 = syscall(SYS_WRITE, fd, (p as usize + off) as i64, (n - off) as i64, 0, 0, 0)
        if r <= 0 {
            return
        }
        off = off + r as usize
    }
}

// ---------------------------------------------------------------- Buf (u8)

struct Buf {
    ptr: *mut u8,
    len: usize,
    cap: usize,
}

// An empty, immediately usable buffer (stage 0 has no constructors).
#[no_gc]
fn buf_new() -> Buf {
    return Buf { ptr: 0 as *mut u8, len: 0, cap: 0 }
}

#[no_gc]
fn buf_init(b: *mut Buf) {
    (*b).ptr = 0 as *mut u8
    (*b).len = 0
    (*b).cap = 0
}

#[no_gc]
fn buf_free(b: *mut Buf) {
    heap_free((*b).ptr, (*b).cap)
    buf_init(b)
}

#[no_gc]
fn buf_clear(b: *mut Buf) {
    (*b).len = 0
}

#[no_gc]
fn buf_len(b: *mut Buf) -> usize {
    return (*b).len
}

#[no_gc]
fn buf_set_len(b: *mut Buf, n: usize) {
    (*b).len = n
}

#[no_gc]
fn buf_ptr(b: *mut Buf) -> *mut u8 {
    return (*b).ptr
}

#[no_gc]
fn buf_reserve(b: *mut Buf, need: usize) {
    if (*b).cap >= need {
        return
    }
    buf_grow(b, need)
}

#[no_gc]
fn buf_grow(b: *mut Buf, need: usize) {
    var cap: usize = (*b).cap
    if cap == 0 {
        cap = 64
    }
    while cap < need {
        cap = cap * 2
    }
    let p: *mut u8 = heap_alloc(cap)
    if (*b).len > 0 {
        mem_copy(p, (*b).ptr, (*b).len)
    }
    heap_free((*b).ptr, (*b).cap)
    (*b).ptr = p
    (*b).cap = cap
}

#[no_gc]
fn buf_push(b: *mut Buf, v: u8) {
    if (*b).len >= (*b).cap {
        buf_grow(b, (*b).len + 1)
    }
    *(((*b).ptr as usize + (*b).len) as *mut u8) = v
    (*b).len = (*b).len + 1
}

#[no_gc]
fn buf_at(b: *mut Buf, i: usize) -> u8 {
    if i >= (*b).len {
        return 0 as u8
    }
    return *(((*b).ptr as usize + i) as *mut u8)
}

// Append a decimal number (for counters and diagnostics).
#[no_gc]
fn buf_push_dec(b: *mut Buf, v: u64) {
    if v == 0 {
        buf_push(b, 48 as u8)
        return
    }
    var d: [u8; 24] = [0 as u8; 24]
    var n: usize = 0
    var x: u64 = v
    while x > 0 {
        d[n] = (x % 10) as u8 + 48 as u8
        x = x / 10
        n = n + 1
    }
    while n > 0 {
        n = n - 1
        buf_push(b, d[n])
    }
}

// Write the buffer onto a file descriptor and empty it.
#[no_gc]
fn buf_flush(b: *mut Buf, fd: i64) {
    if (*b).len > 0 {
        write_all(fd, (*b).ptr, (*b).len)
        (*b).len = 0
    }
}

// Reads standard input completely into `b`.
#[no_gc]
fn read_all_stdin(b: *mut Buf) {
    buf_clear(b)
    var next: bool = true
    while next {
        buf_reserve(b, (*b).len + 65536)
        let r: i64 = syscall(SYS_READ, 0, ((*b).ptr as usize + (*b).len) as i64, 65536, 0, 0, 0)
        if r <= 0 {
            next = false
        } else {
            (*b).len = (*b).len + r as usize
        }
    }
}

// ------------------------------------------------------------- CpBuf (u32)

struct CpBuf {
    ptr: *mut u8,
    len: usize,
    cap: usize,
}

#[no_gc]
fn cp_new() -> CpBuf {
    return CpBuf { ptr: 0 as *mut u8, len: 0, cap: 0 }
}

#[no_gc]
fn cp_init(c: *mut CpBuf) {
    (*c).ptr = 0 as *mut u8
    (*c).len = 0
    (*c).cap = 0
}

#[no_gc]
fn cp_free(c: *mut CpBuf) {
    heap_free((*c).ptr, (*c).cap * 4)
    cp_init(c)
}

#[no_gc]
fn cp_clear(c: *mut CpBuf) {
    (*c).len = 0
}

#[no_gc]
fn cp_len(c: *mut CpBuf) -> usize {
    return (*c).len
}

#[no_gc]
// THE FAST PATH ON TOP, THE SLOW ONE MOVED OUT.
//
// Measured (callgrind, corpus realweb, 2026-08-14): `cp_reserve` and
// `buf_reserve` together were **33 % of all executed instructions** of the
// tokenizer -- not the growing, but the check "is there still room?", which
// happened as a function call per character. With 71 instructions and 14
// blocks the full function is too large to inline (the limits: 40 and 8).
//
// So `cp_push`/`buf_push` now contain nothing but the comparison, and the
// growing is a function of its own. `cp_push` thereby falls below the
// inlining limit; the call remains exactly when something really is
// enlarged -- so once per doubling instead of once per character.
fn cp_reserve(c: *mut CpBuf, need: usize) {
    if (*c).cap >= need {
        return
    }
    cp_grow(c, need)
}

#[no_gc]
fn cp_grow(c: *mut CpBuf, need: usize) {
    var cap: usize = (*c).cap
    if cap == 0 {
        cap = 32
    }
    while cap < need {
        cap = cap * 2
    }
    let p: *mut u8 = heap_alloc(cap * 4)
    if (*c).len > 0 {
        mem_copy(p, (*c).ptr, (*c).len * 4)
    }
    heap_free((*c).ptr, (*c).cap * 4)
    (*c).ptr = p
    (*c).cap = cap
}

// A raw pointer and a length setter: they make it possible to fill a
// sequence reserved in advance without a check per character (decode, round 40).
#[no_gc]
fn cp_ptr(c: *mut CpBuf) -> *mut u8 {
    return (*c).ptr
}

#[no_gc]
fn cp_set_len(c: *mut CpBuf, n: usize) {
    (*c).len = n
}

#[no_gc]
fn cp_push(c: *mut CpBuf, v: u32) {
    if (*c).len >= (*c).cap {
        cp_grow(c, (*c).len + 1)
    }
    *(((*c).ptr as usize + (*c).len * 4) as *mut u32) = v
    (*c).len = (*c).len + 1
}

#[no_gc]
fn cp_at(c: *mut CpBuf, i: usize) -> u32 {
    if i >= (*c).len {
        return 0 as u32
    }
    return *(((*c).ptr as usize + i * 4) as *mut u32)
}

#[no_gc]
fn cp_set(c: *mut CpBuf, i: usize, v: u32) {
    if i < (*c).len {
        *(((*c).ptr as usize + i * 4) as *mut u32) = v
    }
}

#[no_gc]
fn cp_truncate(c: *mut CpBuf, n: usize) {
    if n < (*c).len {
        (*c).len = n
    }
}

#[no_gc]
fn cp_copy_from(dst: *mut CpBuf, src: *mut CpBuf) {
    cp_clear(dst)
    var i: usize = 0
    while i < cp_len(src) {
        cp_push(dst, cp_at(src, i))
        i = i + 1
    }
}

#[no_gc]
fn cp_eq_cp(a: *mut CpBuf, b: *mut CpBuf) -> bool {
    if cp_len(a) != cp_len(b) {
        return false
    }
    var i: usize = 0
    while i < cp_len(a) {
        if cp_at(a, i) != cp_at(b, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// Compares `a` with `b`, with A-Z in `a` lowercased beforehand
// (ASCII case insensitive; `b` has to be lower case already).
#[no_gc]
fn cp_eq_ascii_lower(a: *mut CpBuf, b: *mut CpBuf) -> bool {
    if cp_len(a) != cp_len(b) {
        return false
    }
    var i: usize = 0
    while i < cp_len(a) {
        var x: u32 = cp_at(a, i)
        if x >= 65 as u32 && x <= 90 as u32 {
            x = x + 32 as u32
        }
        if x != cp_at(b, i) {
            return false
        }
        i = i + 1
    }
    return true
}
