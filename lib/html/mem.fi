// lib/html/mem.fi — Speicher- und Pufferschicht des HTML5-Tokenizers.
//
// WARUM EIGEN UND NICHT lib/str: `lib/str/*.fi` wird ueber den Einbinder
// tools/strlib/expand.py (`//#include`) eingezogen, nicht ueber das
// Modulsystem — die Dateien qualifizieren ihre Aufrufe nicht mit Modulnamen.
// Sie hier per `import` zu benutzen wuerde sie umschreiben und die von
// expand.py erzeugten Tests brechen. Diese Datei ist deshalb eine kleine,
// eigenstaendige Schicht (mmap-Heap + zwei Vektoren). Ehrlich benannt: das ist
// eine Dopplung von rund 80 Zeilen aus lib/str/alloc.fi.
//
// Schnittstelle (Vertrag fuer alle Module unter lib/html/):
//   heap_alloc(n) -> *mut u8      n Bytes, nullinitialisiert, 0 bei Fehler
//   heap_free(p, n)
//   mem_copy(dst, src, n)
//   write_all(fd, p, n)
//
//   Buf   — Vektor aus u8   (Ausgabepuffer, Rohbytes)
//   CpBuf — Vektor aus u32  (Codepunkt-Folgen: Tagnamen, Attributwerte, Text)
export {
    heap_alloc, heap_free, mem_copy, write_all, read_all_stdin,
    Buf, buf_neu, buf_init, buf_free, buf_clear, buf_reserve, buf_push, buf_len, buf_at,
    buf_ptr, buf_flush, buf_push_dec, buf_set_len,
    CpBuf, cp_neu, cp_init, cp_free, cp_clear, cp_push, cp_len, cp_at, cp_set,
    cp_reserve, cp_ptr, cp_set_len,
    cp_truncate, cp_eq_cp, cp_copy_from, cp_eq_ascii_lower,
}

const SYS_READ: i64 = 0
const SYS_WRITE: i64 = 1
const SYS_MMAP: i64 = 9
const SYS_MUNMAP: i64 = 11
const PROT_READ_WRITE: i64 = 3
const MAP_PRIVATE_ANON: i64 = 34

#[no_gc]
fn page_round(n: usize) -> usize {
    return (n + 4095) / 4096 * 4096
}

// n zusammenhaengende, nullinitialisierte Bytes; 0 bei Fehler.
#[no_gc]
fn heap_alloc(n: usize) -> *mut u8 {
    if n == 0 {
        return 0 as *mut u8
    }
    let len: usize = page_round(n)
    let r: i64 = syscall(SYS_MMAP, 0, len as i64, PROT_READ_WRITE, MAP_PRIVATE_ANON, -1, 0)
    if r < 0 && r > -4096 {
        return 0 as *mut u8
    }
    return r as *mut u8
}

#[no_gc]
fn heap_free(p: *mut u8, n: usize) {
    if p as usize != 0 {
        syscall(SYS_MUNMAP, p as i64, page_round(n) as i64)
    }
}

// WORTWEISE, NICHT BYTEWEISE.
//
// Gemessen (callgrind, Korpus realweb, Runde 43): das byteweise Kopieren war
// mit **332,9 Mio Instruktionen = 25,7 % des gesamten Messlaufs** der zweit-
// groesste Posten ueberhaupt — und zwar nicht im Tokenizer, sondern beim
// EINLESEN der Eingabe: `read_all_stdin` verdoppelt den Puffer von 64 KiB auf
// 8 MiB und kopiert dabei insgesamt 8.323.072 Byte um. Ueber den Grundpfad
// (ohne Registerzuteilung) uebersetzt kostete jedes einzelne Byte
// **40 Instruktionen**.
//
// Acht Byte je Durchgang sind erlaubt: beide Bereiche sind mindestens `n` Byte
// gross, ein Zugriff bei `i + 8 <= n` liegt also vollstaendig innerhalb, und
// x86-64 erlaubt unausgerichtete 8-Byte-Zugriffe. Der Rest laeuft byteweise.
//
// UNVERAENDERT: kopiert wird vorwaerts. Ueberlappende Bereiche mit dst > src
// waren schon vorher nicht erlaubt und sind es weiterhin nicht.
#[no_gc]
fn mem_copy(dst: *mut u8, src: *mut u8, n: usize) {
    var i: usize = 0
    while i + 8 <= n {
        *((dst as usize + i) as *mut u64) = *((src as usize + i) as *mut u64)
        i = i + 8
    }
    while i < n {
        *((dst as usize + i) as *mut u8) = *((src as usize + i) as *mut u8)
        i = i + 1
    }
}

#[no_gc]
fn write_all(fd: i64, p: *mut u8, n: usize) {
    var off: usize = 0
    while off < n {
        let r: i64 = syscall(SYS_WRITE, fd, (p as usize + off) as i64, (n - off) as i64, 0, 0, 0)
        if r <= 0 {
            return
        }
        off = off + r as usize
    }
}

// ---------------------------------------------------------------- Buf (u8)

struct Buf {
    ptr: *mut u8,
    len: usize,
    cap: usize,
}

// Ein leerer, fertig benutzbarer Puffer (Stufe 0 hat keine Konstruktoren).
#[no_gc]
fn buf_neu() -> Buf {
    return Buf{ ptr: 0 as *mut u8, len: 0, cap: 0 }
}

#[no_gc]
fn buf_init(b: *mut Buf) {
    (*b).ptr = 0 as *mut u8
    (*b).len = 0
    (*b).cap = 0
}

#[no_gc]
fn buf_free(b: *mut Buf) {
    heap_free((*b).ptr, (*b).cap)
    buf_init(b)
}

#[no_gc]
fn buf_clear(b: *mut Buf) {
    (*b).len = 0
}

#[no_gc]
fn buf_len(b: *mut Buf) -> usize {
    return (*b).len
}

#[no_gc]
fn buf_set_len(b: *mut Buf, n: usize) {
    (*b).len = n
}

#[no_gc]
fn buf_ptr(b: *mut Buf) -> *mut u8 {
    return (*b).ptr
}

#[no_gc]
fn buf_reserve(b: *mut Buf, need: usize) {
    if (*b).cap >= need {
        return
    }
    buf_wachse(b, need)
}

#[no_gc]
fn buf_wachse(b: *mut Buf, need: usize) {
    var cap: usize = (*b).cap
    if cap == 0 {
        cap = 64
    }
    while cap < need {
        cap = cap * 2
    }
    let p: *mut u8 = heap_alloc(cap)
    if (*b).len > 0 {
        mem_copy(p, (*b).ptr, (*b).len)
    }
    heap_free((*b).ptr, (*b).cap)
    (*b).ptr = p
    (*b).cap = cap
}

#[no_gc]
fn buf_push(b: *mut Buf, v: u8) {
    if (*b).len >= (*b).cap {
        buf_wachse(b, (*b).len + 1)
    }
    *(((*b).ptr as usize + (*b).len) as *mut u8) = v
    (*b).len = (*b).len + 1
}

#[no_gc]
fn buf_at(b: *mut Buf, i: usize) -> u8 {
    if i >= (*b).len {
        return 0 as u8
    }
    return *(((*b).ptr as usize + i) as *mut u8)
}

// Dezimalzahl anhaengen (fuer Zaehler und Diagnose).
#[no_gc]
fn buf_push_dec(b: *mut Buf, v: u64) {
    if v == 0 {
        buf_push(b, 48 as u8)
        return
    }
    var d: [u8; 24] = [0 as u8; 24]
    var n: usize = 0
    var x: u64 = v
    while x > 0 {
        d[n] = (x % 10) as u8 + 48 as u8
        x = x / 10
        n = n + 1
    }
    while n > 0 {
        n = n - 1
        buf_push(b, d[n])
    }
}

// Puffer auf einen Dateideskriptor schreiben und leeren.
#[no_gc]
fn buf_flush(b: *mut Buf, fd: i64) {
    if (*b).len > 0 {
        write_all(fd, (*b).ptr, (*b).len)
        (*b).len = 0
    }
}

// Liest die Standardeingabe vollstaendig in `b`.
#[no_gc]
fn read_all_stdin(b: *mut Buf) {
    buf_clear(b)
    var weiter: bool = true
    while weiter {
        buf_reserve(b, (*b).len + 65536)
        let r: i64 = syscall(SYS_READ, 0, ((*b).ptr as usize + (*b).len) as i64, 65536, 0, 0, 0)
        if r <= 0 {
            weiter = false
        } else {
            (*b).len = (*b).len + r as usize
        }
    }
}

// -------------------------------------------------------------- CpBuf (u32)

struct CpBuf {
    ptr: *mut u8,
    len: usize,
    cap: usize,
}

#[no_gc]
fn cp_neu() -> CpBuf {
    return CpBuf{ ptr: 0 as *mut u8, len: 0, cap: 0 }
}

#[no_gc]
fn cp_init(c: *mut CpBuf) {
    (*c).ptr = 0 as *mut u8
    (*c).len = 0
    (*c).cap = 0
}

#[no_gc]
fn cp_free(c: *mut CpBuf) {
    heap_free((*c).ptr, (*c).cap * 4)
    cp_init(c)
}

#[no_gc]
fn cp_clear(c: *mut CpBuf) {
    (*c).len = 0
}

#[no_gc]
fn cp_len(c: *mut CpBuf) -> usize {
    return (*c).len
}

#[no_gc]
// SCHNELLER PFAD OBEN, LANGSAMER AUSGELAGERT.
//
// Gemessen (callgrind, Korpus realweb, 14.08.2026): `cp_reserve` und
// `buf_reserve` zusammen waren **33 % aller ausgefuehrten Instruktionen** des
// Tokenizers — nicht das Wachsen, sondern die Pruefung „ist noch Platz?", die
// je Zeichen als Funktionsaufruf anfiel. Mit 71 Instruktionen und 14 Bloecken
// ist die volle Funktion zu gross zum Einbetten (Grenze: 40 bzw. 8).
//
// Deshalb steht in `cp_push`/`buf_push` nur noch der Vergleich, und das
// Wachsen ist eine eigene Funktion. `cp_push` faellt damit unter die
// Einbettungsgrenze; der Aufruf bleibt genau dann uebrig, wenn wirklich
// vergroessert wird — also einmal je Verdopplung statt einmal je Zeichen.
fn cp_reserve(c: *mut CpBuf, need: usize) {
    if (*c).cap >= need {
        return
    }
    cp_wachse(c, need)
}

#[no_gc]
fn cp_wachse(c: *mut CpBuf, need: usize) {
    var cap: usize = (*c).cap
    if cap == 0 {
        cap = 32
    }
    while cap < need {
        cap = cap * 2
    }
    let p: *mut u8 = heap_alloc(cap * 4)
    if (*c).len > 0 {
        mem_copy(p, (*c).ptr, (*c).len * 4)
    }
    heap_free((*c).ptr, (*c).cap * 4)
    (*c).ptr = p
    (*c).cap = cap
}

// Rohzeiger und Laengensetzer: erlauben es, eine im Voraus reservierte
// Folge ohne Pruefung je Zeichen zu fuellen (dekodiere, Runde 40).
#[no_gc]
fn cp_ptr(c: *mut CpBuf) -> *mut u8 {
    return (*c).ptr
}

#[no_gc]
fn cp_set_len(c: *mut CpBuf, n: usize) {
    (*c).len = n
}

#[no_gc]
fn cp_push(c: *mut CpBuf, v: u32) {
    if (*c).len >= (*c).cap {
        cp_wachse(c, (*c).len + 1)
    }
    *(((*c).ptr as usize + (*c).len * 4) as *mut u32) = v
    (*c).len = (*c).len + 1
}

#[no_gc]
fn cp_at(c: *mut CpBuf, i: usize) -> u32 {
    if i >= (*c).len {
        return 0 as u32
    }
    return *(((*c).ptr as usize + i * 4) as *mut u32)
}

#[no_gc]
fn cp_set(c: *mut CpBuf, i: usize, v: u32) {
    if i < (*c).len {
        *(((*c).ptr as usize + i * 4) as *mut u32) = v
    }
}

#[no_gc]
fn cp_truncate(c: *mut CpBuf, n: usize) {
    if n < (*c).len {
        (*c).len = n
    }
}

#[no_gc]
fn cp_copy_from(dst: *mut CpBuf, src: *mut CpBuf) {
    cp_clear(dst)
    var i: usize = 0
    while i < cp_len(src) {
        cp_push(dst, cp_at(src, i))
        i = i + 1
    }
}

#[no_gc]
fn cp_eq_cp(a: *mut CpBuf, b: *mut CpBuf) -> bool {
    if cp_len(a) != cp_len(b) {
        return false
    }
    var i: usize = 0
    while i < cp_len(a) {
        if cp_at(a, i) != cp_at(b, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// Vergleicht `a` mit `b`, wobei A-Z in `a` vorher kleingeschrieben werden
// (ASCII-case-insensitive; `b` muss bereits klein sein).
#[no_gc]
fn cp_eq_ascii_lower(a: *mut CpBuf, b: *mut CpBuf) -> bool {
    if cp_len(a) != cp_len(b) {
        return false
    }
    var i: usize = 0
    while i < cp_len(a) {
        var x: u32 = cp_at(a, i)
        if x >= 65 as u32 && x <= 90 as u32 {
            x = x + 32 as u32
        }
        if x != cp_at(b, i) {
            return false
        }
        i = i + 1
    }
    return true
}
