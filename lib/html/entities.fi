// lib/html/entities.fi — Zeichenreferenzen des HTML5-Tokenizers (in Firn).
//
// Setzt WHATWG-HTML §13.2.5.72 ff. um:
//   Character reference state, Named character reference state,
//   Ambiguous ampersand state, Numeric character reference state,
//   Hexadecimal/Decimal character reference (start) state,
//   Numeric character reference end state (mit der Ersetzungstabelle).
//
// SCHNITTSTELLE (Vertrag mit `tokenizer-kern`, PLAN.md §2.3):
//
//   fn char_ref(input: *mut mem.CpBuf, pos: usize, in_attr: bool,
//               s: *mut tokens.Sink) -> usize
//
//   `pos` zeigt HINTER das '&'. `in_attr` = true, wenn die Referenz in einem
//   Attributwert steht: dann gilt die Sonderregel des Standards (Name ohne
//   Semikolon, gefolgt von '=' oder alphanumerisch -> nicht ersetzen) UND die
//   Ausgabe geht nach `tokens.tok_attr_value_push` statt `sink_emit_char`.
//   Rueckgabe: die neue Position in der Eingabe (das erste nicht verbrauchte
//   Zeichen). Es wird IMMER etwas ausgegeben — im schlimmsten Fall das '&'
//   selbst. EINE Ausnahme: konnte die Namenstabelle nicht angelegt werden,
//   kommt `REF_UNMOEGLICH` zurueck; der Aufrufer MUSS den Fall dann als
//   "nicht unterstuetzt" abbrechen (lib/html/tokenizer.fi tut das).
//
//   `char_ref_out(input, pos, in_attr, s, out)` ist dieselbe Funktion mit dem
//   Ausgabeschalter aus PLAN.md §2.3 (out == 0 -> sink_emit_char, sonst
//   tok_attr_value_push); `in_attr` steuert dort nur die Standard-Sonderregel.
//
// NAMENSTABELLE: 2.231 Eintraege aus `html.entities.html5`, erzeugt nach
// lib/html/entities_data.fi (tools/tokenizer/gen_entities.py). Stufe 0 kennt
// keine globalen Felder; die Tabelle wird deshalb beim ersten '&' eines Laufes
// mit mmap OHNE MAP_FIXED an einer BELIEBIGEN, vom Kern gewaehlten Adresse
// angelegt, gefuellt — und der Zeiger im `tokens.Sink` gehalten und von dort
// durch den Tokenizer gereicht (`tokens.sink_entities`). Es gibt keine feste
// Adresse und keine Annahme ueber das Speicherbild des Prozesses.
// Schlaegt der Aufbau fehl (mmap liefert einen Fehler), liefert `tabelle()`
// den Nullzeiger; `char_ref` meldet dann REF_UNMOEGLICH und der Tokenizer
// setzt `nicht_unterstuetzt` — es wird NIE still falsch tokenisiert.
// Die Suche ist eine Binaersuche ueber die sortierten Namen, laengster Treffer
// zuerst (bis zu 32 Zeichen).
import mem
import tokens
import entities_data
import error_codes

export { char_ref, char_ref_out, lookup, numeric_map, table, REF_UNMOEGLICH }

const SYS_MMAP: i64 = 9
const PROT_READ_WRITE: i64 = 3
// MAP_PRIVATE|MAP_ANONYMOUS — ausdruecklich OHNE MAP_FIXED/MAP_FIXED_NOREPLACE
const MAP_FLAGS: i64 = 0x22

// Rueckgabe von `char_ref`, wenn die Namenstabelle nicht angelegt werden
// konnte. Der Aufrufer MUSS daraufhin abbrechen (nicht_unterstuetzt).
const REF_UNMOEGLICH: usize = 0xFFFFFFFFFFFFFFFF

const MAX_NAME: usize = 32

// ------------------------------------------------------------- Tabellenzugriff

// Hinter der erzeugten Tabelle liegt ein Verzeichnis nach erstem Zeichen:
// je Bytewert zwei u32 (erster Eintrag, hinter dem letzten Eintrag). Es
// verkuerzt die Binaersuche und wird beim ersten Aufruf mitberechnet.
const OFF_INDEX: usize = 0            // wird zu entities_data.BYTES addiert
const INDEX_BYTES: usize = 2048

// Legt die Namenstabelle an einer beliebigen Adresse an und fuellt sie.
// Liefert 0, wenn der Speicher nicht beschafft werden konnte.
#[no_gc]
fn table_build() -> *mut u8 {
    let total: usize = entities_data.BYTES + OFF_INDEX + INDEX_BYTES
    let pages: i64 = ((total + 4095) / 4096 * 4096) as i64
    let r: i64 = syscall(SYS_MMAP, 0, pages, PROT_READ_WRITE, MAP_FLAGS, -1, 0)
    // mmap meldet Fehler als -1..-4095 (errno); jede andere Rueckgabe ist die
    // vom Kern gewaehlte Adresse.
    if r > -4096 && r < 0 {
        return 0 as *mut u8
    }
    if r == 0 {
        return 0 as *mut u8
    }
    let p: *mut u8 = r as *mut u8
    entities_data.load(p)
    // Anfangsposition je Name aus den Laengen aufsummieren.
    var off: usize = 0
    var i: usize = 0
    while i < entities_data.ANZAHL {
        *((p as usize + entities_data.OFF_POS + i * 4) as *mut u32) = off as u32
        off = off + (*((p as usize + entities_data.OFF_LEN + i) as *mut u8)) as usize
        i = i + 1
    }
    // Verzeichnis nach erstem Zeichen (die Namen sind sortiert).
    var b: usize = 0
    while b < 256 {
        *((p as usize + entities_data.BYTES + b * 8) as *mut u32) = 0 as u32
        *((p as usize + entities_data.BYTES + b * 8 + 4) as *mut u32) = 0 as u32
        b = b + 1
    }
    i = 0
    while i < entities_data.ANZAHL {
        let first: usize = name_byte(p, i, 0) as usize
        let z: usize = p as usize + entities_data.BYTES + first * 8
        if *(z as *mut u32) == *((z + 4) as *mut u32) {
            *(z as *mut u32) = i as u32
        }
        *((z + 4) as *mut u32) = (i + 1) as u32
        i = i + 1
    }
    *((p as usize) as *mut u64) = entities_data.KENNUNG
    return p
}

// Liefert die Namenstabelle aus dem Sink; beim ersten Aufruf wird sie gebaut.
// Rueckgabe 0 heisst: die Tabelle steht nicht zur Verfuegung.
#[no_gc]
fn table(s: *mut tokens.Sink) -> *mut u8 {
    let present: *mut u8 = tokens.sink_entities(s)
    if present as usize != 0 {
        return present
    }
    if tokens.sink_entities_tries(s) {
        return 0 as *mut u8
    }
    tokens.sink_set_entities_tries(s, true)
    let p: *mut u8 = table_build()
    if p as usize != 0 {
        if *((p as usize) as *mut u64) != entities_data.KENNUNG {
            return 0 as *mut u8
        }
        tokens.sink_set_entities(s, p)
    }
    return p
}

#[no_gc]
fn name_length(p: *mut u8, i: usize) -> usize {
    return (*((p as usize + entities_data.OFF_LEN + i) as *mut u8)) as usize
}

#[no_gc]
fn name_pos(p: *mut u8, i: usize) -> usize {
    return (*((p as usize + entities_data.OFF_POS + i * 4) as *mut u32)) as usize
}

#[no_gc]
fn name_byte(p: *mut u8, i: usize, k: usize) -> u32 {
    return (*((p as usize + entities_data.OFF_NAMEN + name_pos(p, i) + k) as *mut u8)) as u32
}

#[no_gc]
fn value(p: *mut u8, i: usize) -> u64 {
    return *((p as usize + entities_data.OFF_WERT + i * 8) as *mut u64)
}

// ------------------------------------------------------------------ Hilfsmittel

#[no_gc]
fn is_alnum(c: u32) -> bool {
    return (c >= 48 as u32 && c <= 57 as u32) ||
           (c >= 65 as u32 && c <= 90 as u32) ||
           (c >= 97 as u32 && c <= 122 as u32)
}

#[no_gc]
fn hex_value(c: u32) -> i32 {
    if c >= 48 as u32 && c <= 57 as u32 {
        return (c - 48 as u32) as i32
    }
    if c >= 97 as u32 && c <= 102 as u32 {
        return (c - 97 as u32 + 10 as u32) as i32
    }
    if c >= 65 as u32 && c <= 70 as u32 {
        return (c - 65 as u32 + 10 as u32) as i32
    }
    return -1 as i32
}

#[no_gc]
fn char_at(input: *mut mem.CpBuf, i: usize) -> u32 {
    if i >= mem.cp_len(input) {
        return 0xFFFFFFFF as u32
    }
    return mem.cp_at(input, i)
}

// Ein Zeichen ausgeben — in den Attributwert oder in den Zeichenstrom.
#[no_gc]
fn out(s: *mut tokens.Sink, cp: u32, after_attr: bool) {
    if after_attr {
        tokens.tok_attr_value_push(s, cp)
    } else {
        tokens.sink_emit_char(s, cp)
    }
}

// ---------------------------------------------------------------- Namenssuche

// Vergleicht den Eintrag `i` mit den ersten `len` Zeichen von `kand`.
// -1: Eintrag ist kleiner, 0: gleich, 1: Eintrag ist groesser.
#[no_gc]
fn compare(p: *mut u8, i: usize, cand: *mut u32, len: usize) -> i32 {
    let el: usize = name_length(p, i)
    // Anfang des Namens EINMAL berechnen — nicht je Zeichen (heisser Pfad).
    let np: usize = p as usize + entities_data.OFF_NAMEN + name_pos(p, i)
    var k: usize = 0
    while k < el && k < len {
        let a: u32 = (*((np + k) as *mut u8)) as u32
        let b: u32 = *((cand as usize + k * 4) as *mut u32)
        if a < b {
            return -1 as i32
        }
        if a > b {
            return 1 as i32
        }
        k = k + 1
    }
    if el < len {
        return -1 as i32
    }
    if el > len {
        return 1 as i32
    }
    return 0 as i32
}

// Sucht den Namen `kand[0..len]` (Feld aus Codepunkten) in der Tabelle.
// Rueckgabe: Index + 1, oder 0 wenn es ihn nicht gibt.
#[no_gc]
fn lookup(p: *mut u8, cand: *mut u32, len: usize) -> usize {
    if p as usize == 0 || len == 0 {
        return 0
    }
    let first: u32 = *(cand as *mut u32)
    if first > 255 as u32 {
        return 0
    }
    let z: usize = p as usize + entities_data.BYTES + first as usize * 8
    var lo: usize = (*(z as *mut u32)) as usize
    var hi: usize = (*((z + 4) as *mut u32)) as usize
    while lo < hi {
        let mid: usize = lo + (hi - lo) / 2
        let v: i32 = compare(p, mid, cand, len)
        if v == 0 as i32 {
            return mid + 1
        }
        if v < 0 as i32 {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return 0
}

// Nichtzeichen nach Unicode: U+FDD0..U+FDEF und alle ...FFFE/...FFFF.
#[no_gc]
fn is_non_char(n: u32) -> bool {
    if n >= 0xFDD0 as u32 && n <= 0xFDEF as u32 {
        return true
    }
    let below: u32 = n & 0xFFFF as u32
    return below == 0xFFFE as u32 || below == 0xFFFF as u32
}

// "control-character-reference": C0/C1-Steuerzeichen ohne die ASCII-
// Leerraumzeichen (Tab, LF, FF, CR) und ohne U+0000 (eigener Code).
#[no_gc]
fn is_control_char_ref(n: u32) -> bool {
    if n == 0 as u32 {
        return false
    }
    if n == 13 as u32 {
        // Der Standard nennt U+000D ausdruecklich (auch wenn es Leerraum ist).
        return true
    }
    if n == 9 as u32 || n == 10 as u32 || n == 12 as u32 || n == 32 as u32 {
        return false
    }
    if n < 0x20 as u32 {
        return true
    }
    return n >= 0x7F as u32 && n <= 0x9F as u32
}

// ------------------------------------------------- numerische Zeichenreferenz

// Numeric character reference end state: Ersetzungen des Standards.
#[no_gc]
fn numeric_map(n: u32) -> u32 {
    if n == 0 as u32 {
        return 0xFFFD as u32
    }
    if n > 0x10FFFF as u32 {
        return 0xFFFD as u32
    }
    if n >= 0xD800 as u32 && n <= 0xDFFF as u32 {
        return 0xFFFD as u32
    }
    if n < 0x80 as u32 || n > 0x9F as u32 {
        return n
    }
    // C1-Ersetzungstabelle (WHATWG-HTML §13.2.5.80)
    if n == 0x80 as u32 { return 0x20AC as u32 }
    if n == 0x82 as u32 { return 0x201A as u32 }
    if n == 0x83 as u32 { return 0x0192 as u32 }
    if n == 0x84 as u32 { return 0x201E as u32 }
    if n == 0x85 as u32 { return 0x2026 as u32 }
    if n == 0x86 as u32 { return 0x2020 as u32 }
    if n == 0x87 as u32 { return 0x2021 as u32 }
    if n == 0x88 as u32 { return 0x02C6 as u32 }
    if n == 0x89 as u32 { return 0x2030 as u32 }
    if n == 0x8A as u32 { return 0x0160 as u32 }
    if n == 0x8B as u32 { return 0x2039 as u32 }
    if n == 0x8C as u32 { return 0x0152 as u32 }
    if n == 0x8E as u32 { return 0x017D as u32 }
    if n == 0x91 as u32 { return 0x2018 as u32 }
    if n == 0x92 as u32 { return 0x2019 as u32 }
    if n == 0x93 as u32 { return 0x201C as u32 }
    if n == 0x94 as u32 { return 0x201D as u32 }
    if n == 0x95 as u32 { return 0x2022 as u32 }
    if n == 0x96 as u32 { return 0x2013 as u32 }
    if n == 0x97 as u32 { return 0x2014 as u32 }
    if n == 0x98 as u32 { return 0x02DC as u32 }
    if n == 0x99 as u32 { return 0x2122 as u32 }
    if n == 0x9A as u32 { return 0x0161 as u32 }
    if n == 0x9B as u32 { return 0x203A as u32 }
    if n == 0x9C as u32 { return 0x0153 as u32 }
    if n == 0x9E as u32 { return 0x017E as u32 }
    if n == 0x9F as u32 { return 0x0178 as u32 }
    return n
}

// &#...  bzw.  &#x...  — `pos` zeigt auf das '#'.
#[no_gc]
fn numeric_reference(input: *mut mem.CpBuf, pos: usize, s: *mut tokens.Sink,
                       after_attr: bool) -> usize {
    var j: usize = pos + 1
    var hex: bool = false
    let c1: u32 = char_at(input, j)
    if c1 == 120 as u32 || c1 == 88 as u32 {       // 'x' / 'X'
        hex = true
        j = j + 1
    }
    let start: usize = j
    var number: u32 = 0
    var runs: bool = true
    while runs {
        let c: u32 = char_at(input, j)
        var d: i32 = -1 as i32
        if hex {
            d = hex_value(c)
        } else if c >= 48 as u32 && c <= 57 as u32 {
            d = (c - 48 as u32) as i32
        }
        if d < 0 as i32 {
            runs = false
        } else {
            if number <= 0x10FFFF as u32 {
                var base: u32 = 10
                if hex {
                    base = 16
                }
                number = number * base + d as u32
                if number > 0x10FFFF as u32 {
                    number = 0x110000 as u32          // Ueberlauf: bleibt zu gross
                }
            }
            j = j + 1
        }
    }
    if j == start {
        // absence-of-digits-in-numeric-character-reference: nichts ersetzen.
        tokens.sink_error_at(s, error_codes.F_ABSENCE_OF_DIGITS_IN_NUMERIC_CHARACTER_REFERENCE,
            input, start)
        out(s, 38 as u32, after_attr)
        out(s, 35 as u32, after_attr)
        if hex {
            out(s, c1, after_attr)
        }
        return start
    }
    if char_at(input, j) == 59 as u32 {         // ';'
        j = j + 1
    } else {
        tokens.sink_error_at(s, error_codes.F_MISSING_SEMICOLON_AFTER_CHARACTER_REFERENCE,
            input, j)
    }
    // Fehlercodes des "numeric character reference end state" — gemeldet an
    // der Stelle HINTER der Referenz (so fuehrt html5lib-tests Buch).
    if number == 0 as u32 {
        tokens.sink_error_at(s, error_codes.F_NULL_CHARACTER_REFERENCE, input, j)
    } else if number > 0x10FFFF as u32 {
        tokens.sink_error_at(s, error_codes.F_CHARACTER_REFERENCE_OUTSIDE_UNICODE_RANGE,
            input, j)
    } else if number >= 0xD800 as u32 && number <= 0xDFFF as u32 {
        tokens.sink_error_at(s, error_codes.F_SURROGATE_CHARACTER_REFERENCE, input, j)
    } else if is_non_char(number) {
        tokens.sink_error_at(s, error_codes.F_NONCHARACTER_CHARACTER_REFERENCE, input, j)
    } else if is_control_char_ref(number) {
        tokens.sink_error_at(s, error_codes.F_CONTROL_CHARACTER_REFERENCE, input, j)
    }
    out(s, numeric_map(number), after_attr)
    return j
}

// ------------------------------------------------------------------ Einstieg

#[no_gc]
fn reference(input: *mut mem.CpBuf, pos: usize, in_attr: bool, s: *mut tokens.Sink,
            after_attr: bool) -> usize {
    let c: u32 = char_at(input, pos)
    if c == 35 as u32 {                              // '#'
        return numeric_reference(input, pos, s, after_attr)
    }
    if !is_alnum(c) {
        // Character reference state, "anything else": nur das '&'.
        out(s, 38 as u32, after_attr)
        return pos
    }

    // Bewerber einsammeln: alphanumerisch, hoechstens ein abschliessendes ';'.
    // Bewusst ein Feld auf dem Stapel und KEIN mem.CpBuf: eine Zeichenreferenz
    // darf keinen Speicher anfordern (mmap/munmap je '&' kostete das Zehnfache
    // der gesamten uebrigen Arbeit).
    var cand: [u32; 33] = [0 as u32; 33]
    let kp: *mut u32 = (&cand[0]) as *mut u32
    var cnt: usize = 0
    var j: usize = pos
    var collect: bool = true
    while collect {
        if cnt >= MAX_NAME {
            collect = false
        } else {
            let x: u32 = char_at(input, j)
            if is_alnum(x) {
                cand[cnt] = x
                cnt = cnt + 1
                j = j + 1
            } else if x == 59 as u32 {
                cand[cnt] = x
                cnt = cnt + 1
                j = j + 1
                collect = false
            } else {
                collect = false
            }
        }
    }

    let p: *mut u8 = table(s)
    if p as usize == 0 {
        // Ohne Namenstabelle kann diese Referenz nicht aufgeloest werden:
        // ehrlich abbrechen statt still falsch zu tokenisieren.
        return REF_UNMOEGLICH
    }
    var len: usize = cnt
    var hit: usize = 0
    while len > 0 && hit == 0 {
        hit = lookup(p, kp, len)
        if hit == 0 {
            len = len - 1
        }
    }

    var end: usize = pos
    if hit > 0 {
        let idx: usize = hit - 1
        let with_semicolon: bool = cand[len - 1] == 59 as u32
        let after: u32 = char_at(input, pos + len)
        var literal: bool = false
        if in_attr && !with_semicolon {
            if after == 61 as u32 || is_alnum(after) {
                literal = true
            }
        }
        if !with_semicolon && !literal {
            tokens.sink_error_at(s, error_codes.F_MISSING_SEMICOLON_AFTER_CHARACTER_REFERENCE,
                input, pos + len)
        }
        if literal {
            // Sonderregel im Attributwert: unveraendert uebernehmen.
            out(s, 38 as u32, after_attr)
            var k: usize = 0
            while k < len {
                out(s, cand[k], after_attr)
                k = k + 1
            }
        } else {
            let v: u64 = value(p, idx)
            out(s, (v & 0xFFFFFFFF as u64) as u32, after_attr)
            let second: u32 = (v >> 32) as u32
            if second != 0 as u32 {
                out(s, second, after_attr)
            }
        }
        end = pos + len
    } else {
        // Kein Treffer: '&' ausgeben, danach ambiguous ampersand state —
        // alle alphanumerischen Zeichen unveraendert, dann zurueck in den
        // Ausgangszustand (auch bei ';', das dort erneut betrachtet wird).
        out(s, 38 as u32, after_attr)
        var k: usize = pos
        while is_alnum(char_at(input, k)) {
            out(s, char_at(input, k), after_attr)
            k = k + 1
        }
        if char_at(input, k) == 59 as u32 {
            // Ambiguous ampersand state: das ';' loest den Fehler aus.
            tokens.sink_error_at(s, error_codes.F_UNKNOWN_NAMED_CHARACTER_REFERENCE, input, k)
        }
        end = k
    }
    return end
}

// Zeichenreferenz ab `pos` (hinter dem '&'); Ausgabe je nach `in_attr`.
#[no_gc]
fn char_ref(input: *mut mem.CpBuf, pos: usize, in_attr: bool, s: *mut tokens.Sink) -> usize {
    return reference(input, pos, in_attr, s, in_attr)
}

// Wie `char_ref`, aber mit getrenntem Ausgabeschalter (PLAN.md §2.3):
// out == 0 -> tokens.sink_emit_char, sonst tokens.tok_attr_value_push.
#[no_gc]
fn char_ref_out(input: *mut mem.CpBuf, pos: usize, in_attr: bool, s: *mut tokens.Sink,
                out: u32) -> usize {
    return reference(input, pos, in_attr, s, out != 0 as u32)
}
