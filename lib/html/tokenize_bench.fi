// SPDX-License-Identifier: GPL-2.0-only
// lib/html/tokenize_bench.fi -- the measuring version of the tokenizer driver.
//
// THE REASON: `tokenize_main.fi` writes one line of html5lib JSON per job.
// The comparison partner `html5ever` in `bench/tokenizer/` only counts
// tokens. Measured with callgrind (corpus `realweb`, 2026-08-14),
// **14.7 % of all instructions** went into an output the other side does not
// produce at all (`out_json_cp` 7.93 %, `out_json_cpbuf` 4.22 %, `out_wort` 2.55 %).
// A factor that counts such work in does not measure the tokenizer.
//
// This program reads THE SAME jobs, runs THE SAME tokenizer and prints only
// the number of tokens at the end. That makes the comparison fair.
//
// What is NOT left out here, although it would be tempting:
//   * the decoding to UTF-32 (`decode`, 28 % of the instructions) -- it
//     belongs to the build of the tokenizer and is therefore measured along.
//     That html5ever does not need it is a real disadvantage of Firn's
//     version and no unfairness of the measuring setup.
//   * the position and error bookkeeping (`input_check`, 16.7 %) -- html5ever
//     reports parse errors too.
//
// Compile with:  firnc -o .tokenizer-work/tokenize_bench lib/html/tokenize_bench.fi
import mem
import tokens
import tokenizer

#[no_gc]
fn read_u32(b: *mut mem.Buf, off: usize) -> u32 {
    var v: u32 = 0
    var i: usize = 0
    while i < 4 {
        v = v | ((mem.buf_at(b, off + i) as u32) << (8 * i as u32))
        i = i + 1
    }
    return v
}

// WTF-8 -> code points, word for word the same as tokenize_main.fi.
// The byte at the absolute position `k`, 0 beyond the end -- word for word
// the same as `mem.buf_at`, but with a PRELOADED base pointer and length.
//
// WHY: `mem.buf_at(b, k)` reads two fields out of the struct per call --
// `(*b).len` for the range check and `(*b).ptr` for the address. The
// optimizer must not merge these loads across the loop, because in between
// something is written through another pointer (`out`) and Firn has no alias
// analysis yet: it cannot prove that `out` and `b` are different
// objects.
//
// Measured (callgrind, corpus realweb): `decode` therefore needed 225
// instructions per byte and was, with 28 %, the largest single item of the
// tokenizer -- at up to five accesses per character.
#[no_gc]
fn byte_at(base: u64, total: usize, k: usize) -> u32 {
    if k >= total {
        return 0 as u32
    }
    return (*((base + k as u64) as *mut u8)) as u32
}

#[no_gc]
fn decode(b: *mut mem.Buf, off: usize, len: usize, out: *mut mem.CpBuf) {
    mem.cp_clear(out)
    // Load ONCE instead of at every access (see byte_at).
    let base: u64 = mem.buf_ptr(b) as u64
    let total: usize = mem.buf_len(b)
    // A code point costs at least one byte: `len` slots are ALWAYS enough.
    // That removes the capacity check per character (round 40).
    mem.cp_reserve(out, len)
    let target: u64 = mem.cp_ptr(out) as u64
    var outi: usize = 0
    var i: usize = 0
    while i < len {
        let c0: u32 = byte_at(base, total, off + i)
        // The fast path (round 40): pure ASCII except CR is the normal case of
        // real pages -- one comparison, then write directly.
        if c0 < 0x80 as u32 && c0 != 13 as u32 {
            *((target + outi as u64 * 4) as *mut u32) = c0
            outi = outi + 1
            i = i + 1
            continue
        }
        var cp: u32 = c0
        var width: usize = 1
        if c0 >= 0xF0 as u32 {
            width = 4
            cp = ((c0 & 0x07 as u32) << 18) |
            ((byte_at(base, total, off + i + 1) & 0x3F as u32) << 12) |
            ((byte_at(base, total, off + i + 2) & 0x3F as u32) << 6) |
            (byte_at(base, total, off + i + 3) & 0x3F as u32)
        } else if c0 >= 0xE0 as u32 {
            width = 3
            cp = ((c0 & 0x0F as u32) << 12) |
            ((byte_at(base, total, off + i + 1) & 0x3F as u32) << 6) |
            (byte_at(base, total, off + i + 2) & 0x3F as u32)
        } else if c0 >= 0xC0 as u32 {
            width = 2
            cp = ((c0 & 0x1F as u32) << 6) |
            (byte_at(base, total, off + i + 1) & 0x3F as u32)
        }
        i = i + width
        if cp == 13 as u32 {
            cp = 10 as u32
            if i < len && byte_at(base, total, off + i) == 10 as u32 {
                i = i + 1
            }
        }
        *((target + outi as u64 * 4) as *mut u32) = cp
        outi = outi + 1
    }
    mem.cp_set_len(out, outi)
}

// A decimal number + a line break onto standard output.
#[no_gc]
fn write_number(v: u64) {
    var d: [u8; 24] = [0 as u8; 24]
    var n: usize = 0
    var x: u64 = v
    if x == 0 {
        d[0] = 48 as u8
        n = 1
    }
    while x > 0 {
        d[n] = (x % 10) as u8 + 48 as u8
        x = x / 10
        n = n + 1
    }
    var outi: [u8; 26] = [0 as u8; 26]
    var i: usize = 0
    while i < n {
        outi[i] = d[n - 1 - i]
        i = i + 1
    }
    outi[n] = 10 as u8
    let p: u64 = (&outi[0]) as u64
    syscall(1, 1, p as i64, (n + 1) as i64, 0, 0, 0)
}

#[no_gc]
fn main() -> i32 {
    var ins: mem.Buf = mem.buf_new()
    mem.read_all_stdin(&ins)

    var s: tokens.Sink = tokens.sink_new()
    tokens.sink_init(&s)
    tokens.sink_set_count_mode(&s, true)

    var text: mem.CpBuf = mem.cp_new()
    var lasttag: mem.CpBuf = mem.cp_new()

    let total: usize = mem.buf_len(&ins)
    var off: usize = 0
    var jobs: u64 = 0
    while off + 16 <= total {
        let state: u32 = read_u32(&ins, off)
        let flags: u32 = read_u32(&ins, off + 4)
        let ltlen: usize = read_u32(&ins, off + 8) as usize
        decode(&ins, off + 12, ltlen, &lasttag)
        let inlen: usize = read_u32(&ins, off + 12 + ltlen) as usize
        decode(&ins, off + 16 + ltlen, inlen, &text)
        off = off + 16 + ltlen + inlen

        tokens.sink_set_xml_mode(&s, (flags & 1 as u32) != 0 as u32)
        tokens.sink_set_last_start_tag_cp(&s, &lasttag)
        tokens.sink_begin(&s)
        let ok: bool = tokenizer.tokenize(&text, state, &s)
        if ok {
            tokens.sink_end(&s)
        } else {
            tokens.sink_abort(&s)
        }
        jobs = jobs + 1
    }
    write_number(tokens.sink_token_count(&s))
    write_number(jobs)
    return 0
}
