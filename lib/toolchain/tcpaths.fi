import std.env
import std.rt
import std.fs
import std.fsx
import std.pystr
import toolchain.tcplat

const NONE: usize = 18446744073709551615

fn home() -> str {
    let h: str = env.get("FIRN_HOME")
    if h.length() > 0 {
        return h
    }
    return tcplat.home_default()
}

fn join(a: str, b: str) -> str {
    return a + tcplat.sep() + b
}

fn versions_dir() -> str {
    return join(home(), "versions")
}

fn version_dir(v: str) -> str {
    return join(versions_dir(), v)
}

fn current_link() -> str {
    return join(home(), "current")
}

fn bin_dir() -> str {
    return join(home(), "bin")
}

fn config_path() -> str {
    return join(home(), "config")
}

fn projects_path() -> str {
    return join(home(), "projects")
}

fn tool_of(dir: str, name: str) -> str {
    return join(join(dir, "bin"), name + tcplat.exe_suffix())
}

fn firnc_of(v: str) -> str {
    return tool_of(version_dir(v), "firnc")
}

fn ready_marker(v: str) -> str {
    return join(version_dir(v), ".ready")
}

fn is_installed(v: str) -> bool {
    return fs.exists(ready_marker(v))
}

fn read_text(path: str) -> str {
    if !fs.is_file(path) {
        return ""
    }
    return pystr.read_text(path)
}

fn write_text_atomic(path: str, text: str) -> bool {
    let tmp: str = path + ".tmp"
    let w: usize = fs.write_file(tmp, text.p as u64, text.n) catch NONE
    if w != text.n {
        return false
    }
    let ok: bool = fs.rename(tmp, path) catch false
    return ok
}

fn copy_text(s: str) -> str {
    return __str_copy(s)
}

fn read_into(path: str, out: *mut rt.Buf) -> bool {
    let n: usize = fs.read_file(path, out) catch NONE
    return n != NONE
}

fn make_dir(path: str) -> bool {
    let made: bool = fs.mkdir_all(path) catch false
    return made || fs.is_dir(path)
}

fn no_temp() -> fsx.TempDir {
    return fsx.TempDir { path: rt.buf_new(), armed: false }
}

fn platform() -> str {
    let p: str = env.get("FIRN_PLATFORM")
    if p.length() > 0 {
        return p
    }
    let f: str = pystr.strip(read_text(join(home(), "platform")))
    if f.length() > 0 {
        return f
    }
    return tcplat.default_platform()
}

fn current_version() -> str {
    if tcplat.links_supported() {
        let t: str = fs.readlink(current_link()) catch ""
        if t.length() == 0 {
            return ""
        }
        let cut: i64 = pystr.rfind(t, tcplat.sep())
        if cut < 0 {
            return t
        }
        return t.part((cut + 1) as usize, t.length() - (cut + 1) as usize)
    }
    return pystr.strip(read_text(current_link() + ".txt"))
}
