import std.rt
import std.env
import std.process
import toolchain.tcpaths
import toolchain.tcproject

struct Choice {
    version: str,
    err: str,
}

fn choose() -> Choice {
    let forced: str = env.get("FIRN_TOOLCHAIN")
    if forced.length() > 0 {
        if !tcpaths.is_installed(forced) {
            return Choice { version: "", err: "FIRN_TOOLCHAIN=" + forced + " is not installed (firn install " + forced + ")" }
        }
        return Choice { version: forced, err: "" }
    }
    let pin: tcproject.Pin = tcproject.project_pin()
    if pin.err.length() > 0 {
        return Choice { version: "", err: pin.err }
    }
    if pin.file.length() > 0 && pin.spec.length() > 0 {
        let v: str = tcproject.best_installed(pin.spec)
        if v.length() == 0 {
            return Choice { version: "", err: pin.file + " wants firn " + pin.spec + ", none installed (firn install)" }
        }
        return Choice { version: v, err: "" }
    }
    let cur: str = tcpaths.current_version()
    if cur.length() == 0 || !tcpaths.is_installed(cur) {
        return Choice { version: "", err: "no Firn toolchain installed (firn install)" }
    }
    return Choice { version: cur, err: "" }
}

fn exec_tool(name: str, version: str, args: *mut Vec[str], from: usize) -> i32 {
    var c: process.Command = process.command(tcpaths.tool_of(tcpaths.version_dir(version), name))
    var i: usize = from
    while i < vec_len[str](args) {
        process.add_arg(&c, *vec_elem_ptr[str](args, i))
        i = i + 1
    }
    process.unset_env(&c, "FIRNLIB")
    let code: i32 = process.run(&c) catch |e| -1
    process.command_free(&c)
    return code
}
