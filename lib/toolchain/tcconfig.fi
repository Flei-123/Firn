import std.rt
import std.pystr
import toolchain.tcpaths

fn config_get(key: str) -> str {
    var lines: Vec[str] = vec_new[str]()
    pystr.splitlines(tcpaths.read_text(tcpaths.config_path()), &lines)
    var val: str = ""
    for i in 0..vec_len[str](&lines) {
        let l: str = pystr.strip(*vec_elem_ptr[str](&lines, i))
        let at: i64 = pystr.find(l, "=")
        if at > 0 && pystr.strip(l.part(0, at as usize)) == key {
            val = pystr.strip(l.part((at + 1) as usize, l.length() - (at + 1) as usize))
        }
    }
    vec_free[str](&lines)
    return val
}

fn config_set(key: str, value: str) -> bool {
    var lines: Vec[str] = vec_new[str]()
    pystr.splitlines(tcpaths.read_text(tcpaths.config_path()), &lines)
    var out: str = ""
    for i in 0..vec_len[str](&lines) {
        let l: str = pystr.strip(*vec_elem_ptr[str](&lines, i))
        let at: i64 = pystr.find(l, "=")
        if l.length() > 0 && !(at > 0 && pystr.strip(l.part(0, at as usize)) == key) {
            out = out + l + "\n"
        }
    }
    vec_free[str](&lines)
    if value.length() > 0 {
        out = out + key + "=" + value + "\n"
    }
    return tcpaths.write_text_atomic(tcpaths.config_path(), out)
}
