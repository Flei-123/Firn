import std.rt
import std.str
import std.json
import toolchain.tcver

struct Release {
    version: str,
    min_version: str,
    channel: str,
    date: str,
    commit: str,
    file: str,
    sha256: str,
    size: u64,
    signature: str,
    err: str,
}

fn release_empty() -> Release {
    return Release { version: "", min_version: "", channel: "", date: "", commit: "",
        file: "", sha256: "", size: 0, signature: "", err: "" }
}

fn span_text(sp: str.Span) -> str {
    return __str_copy(str { p: sp.p, n: sp.n })
}

fn child_of(d: *mut json.Json, obj: u32, key: str) -> u32 {
    if obj == json.JSON_NONE {
        return json.JSON_NONE
    }
    return json.json_get(d, obj, key.p as u64, key.n)
}

fn text_of(d: *mut json.Json, obj: u32, key: str) -> str {
    let i: u32 = child_of(d, obj, key)
    if i == json.JSON_NONE || json.json_kind(d, i) != json.JSON_STRING {
        return ""
    }
    return span_text(json.json_string(d, i))
}

fn int_of(d: *mut json.Json, obj: u32, key: str) -> u64 {
    let i: u32 = child_of(d, obj, key)
    if i == json.JSON_NONE || json.json_kind(d, i) != json.JSON_NUMBER {
        return 0
    }
    return json.json_int(d, i) as u64
}

fn is_hex64(s: str) -> bool {
    if s.length() != 64 {
        return false
    }
    var i: usize = 0
    while i < 64 {
        let c: u8 = s.chars(i)
        i = i + 1
        if !((c >= 48 as u8 && c <= 57 as u8) || (c >= 97 as u8 && c <= 102 as u8)) {
            return false
        }
    }
    return true
}

fn manifest_parse(text: str, platform: str) -> Release {
    var r: Release = release_empty()
    var d: json.Json = json.json_new()
    let ok: bool = json.json_parse(&d, text.p as u64, text.n) catch false
    if !ok || !json.json_valid(&d) {
        json.json_free(&d)
        r.err = "manifest is not valid JSON"
        return r
    }
    let root: u32 = json.json_root(&d)
    r.version = text_of(&d, root, "version")
    r.min_version = text_of(&d, root, "min_version")
    r.channel = text_of(&d, root, "channel")
    r.date = text_of(&d, root, "date")
    r.commit = text_of(&d, root, "commit")
    let plats: u32 = child_of(&d, root, "platforms")
    let entry: u32 = child_of(&d, plats, platform)
    r.file = text_of(&d, entry, "file")
    r.sha256 = text_of(&d, entry, "sha256")
    r.size = int_of(&d, entry, "size")
    r.signature = text_of(&d, entry, "signature")
    json.json_free(&d)
    if !tcver.ver_valid(r.version) {
        r.err = "manifest has no valid version"
    } else if r.min_version.length() > 0 && !tcver.ver_valid(r.min_version) {
        r.err = "manifest has an invalid min_version"
    } else if entry == json.JSON_NONE {
        r.err = "release " + r.version + " has no build for platform " + platform
    } else if r.file.length() == 0 || !is_hex64(r.sha256) || r.size == 0 {
        r.err = "manifest entry for " + platform + " lacks file, sha256 or size"
    }
    return r
}
