// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.fs
import std.fsx
import std.pystr
import std.process
import toolchain.tcpaths
import toolchain.tcplat

const HELLO_SRC: str = "import std.io\nfn main() -> i32 {\n    io.print_line(\"firn-selftest-ok\")\n    return 0\n}\n"

fn run_out(program: str, a1: str, a2: str, a3: str, out: *mut rt.Buf) -> i32 {
    var c: process.Command = process.command(program)
    if a1.length() > 0 { process.add_arg(&c, a1) }
    if a2.length() > 0 { process.add_arg(&c, a2) }
    if a3.length() > 0 { process.add_arg(&c, a3) }
    process.unset_env(&c, "FIRNLIB")
    var err: rt.Buf = rt.buf_new()
    let code: i32 = process.run_capture(&c, out, &err, 600000) catch |e| -1
    rt.buf_push_bytes(out, rt.buf_ptr(&err), rt.buf_len(&err))
    rt.buf_free(&err)
    process.command_free(&c)
    return code
}

fn selftest(dir: str) -> str {
    let firnc: str = tcpaths.tool_of(dir, "firnc")
    if !fs.is_file(firnc) {
        return "selftest: " + firnc + " is missing"
    }
    var td: fsx.TempDir = fsx.temp_dir("firn-selftest") catch tcpaths.no_temp()
    if rt.buf_len(&td.path) == 0 {
        return "selftest: no temp directory"
    }
    let base: str = fsx.temp_dir_path(&td)
    let src: str = tcpaths.join(base, "hello.fi")
    let exe: str = tcpaths.join(base, "hello" + tcplat.exe_suffix())
    var verdict: str = ""
    let wrote: bool = (fs.write_file(src, HELLO_SRC.p as u64, HELLO_SRC.n) catch 0) == HELLO_SRC.n
    var out: rt.Buf = rt.buf_new()
    if !wrote {
        verdict = "selftest: cannot write " + src
    } else if run_out(firnc, src, "-o", exe, &out) != 0 {
        verdict = "selftest: compiling hello failed: " + pystr.strip(rt.buf_str(&out))
    } else {
        rt.buf_clear(&out)
        let code: i32 = run_out(exe, "", "", "", &out)
        if code != 0 || !pystr.contains(rt.buf_str(&out), "firn-selftest-ok") {
            verdict = "selftest: hello did not run"
        }
    }
    rt.buf_free(&out)
    fsx.temp_dir_drop(&td)
    return verdict
}
