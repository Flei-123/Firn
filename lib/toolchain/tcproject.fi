import std.rt
import std.fs
import std.fsx
import std.dir
import std.pystr
import toolchain.tcver
import toolchain.tcpaths

const TOOLCHAIN_FILE: str = "firn.toolchain"

struct Pin {
    file: str,
    spec: str,
    err: str,
}

fn find_file(start: str) -> str {
    var dir: str = fsx.abspath(start)
    for depth in 0..64 {
        let cand: str = tcpaths.join(dir, TOOLCHAIN_FILE)
        if fs.is_file(cand) {
            return cand
        }
        let up: str = fsx.normpath(tcpaths.join(dir, ".."))
        if up == dir {
            return ""
        }
        dir = up
    }
    return ""
}

fn read_pin(file: str) -> Pin {
    var p: Pin = Pin { file: file, spec: "", err: "" }
    var lines: Vec[str] = vec_new[str]()
    pystr.splitlines(tcpaths.read_text(file), &lines)
    for i in 0..vec_len[str](&lines) {
        var l: str = *vec_elem_ptr[str](&lines, i)
        let hash: i64 = pystr.find(l, "#")
        if hash >= 0 {
            l = l.part(0, hash as usize)
        }
        l = pystr.strip(l)
        if pystr.startswith(l, "firn ") {
            p.spec = pystr.strip(l.part(5, l.length() - 5))
        } else if l.length() > 0 {
            p.err = file + ": unknown line '" + l + "' (allowed: firn <version> | firn >=<version>)"
        }
    }
    vec_free[str](&lines)
    if p.err.length() == 0 && !tcver.spec_valid(p.spec) {
        p.err = file + ": invalid version wish '" + p.spec + "'"
    }
    return p
}

fn project_pin() -> Pin {
    let f: str = find_file(fsx.cwd())
    if f.length() == 0 {
        return Pin { file: "", spec: "", err: "" }
    }
    let p: Pin = read_pin(f)
    remember(f)
    return p
}

fn remember(file: str) {
    let all: str = tcpaths.read_text(tcpaths.projects_path())
    if pystr.contains(all, file + "\n") {
        return
    }
    tcpaths.make_dir(tcpaths.home())
    tcpaths.write_text_atomic(tcpaths.projects_path(), all + file + "\n")
}

fn installed(out: *mut Vec[str]) {
    var d: dir.Dir = dir.open(tcpaths.versions_dir())
    var names: rt.Buf = rt.buf_new()
    while dir.next(&d) {
        rt.buf_push_bytes(&names, d.name.p as u64, d.name.n)
        rt.buf_push(&names, 10 as u8)
    }
    dir.close(&d)
    let text: str = tcpaths.copy_text(rt.buf_str(&names))
    rt.buf_free(&names)
    var lines: Vec[str] = vec_new[str]()
    pystr.splitlines(text, &lines)
    for i in 0..vec_len[str](&lines) {
        let n: str = *vec_elem_ptr[str](&lines, i)
        if tcver.ver_valid(n) && tcpaths.is_installed(n) {
            vec_push[str](out, n)
        }
    }
    vec_free[str](&lines)
}

fn best_installed(spec: str) -> str {
    let cur: str = tcpaths.current_version()
    if tcver.spec_matches(spec, cur) && tcpaths.is_installed(cur) {
        return cur
    }
    var all: Vec[str] = vec_new[str]()
    installed(&all)
    var best: str = ""
    for i in 0..vec_len[str](&all) {
        let v: str = *vec_elem_ptr[str](&all, i)
        if tcver.spec_matches(spec, v) && (best.length() == 0 || tcver.ver_cmp(v, best) > 0) {
            best = v
        }
    }
    vec_free[str](&all)
    return best
}

fn stale_projects(newest: str, out: *mut Vec[str]) {
    var lines: Vec[str] = vec_new[str]()
    pystr.splitlines(tcpaths.read_text(tcpaths.projects_path()), &lines)
    for i in 0..vec_len[str](&lines) {
        let f: str = pystr.strip(*vec_elem_ptr[str](&lines, i))
        if f.length() > 0 && fs.is_file(f) {
            let p: Pin = read_pin(f)
            if p.err.length() == 0 && !tcver.spec_matches(p.spec, newest) {
                vec_push[str](out, f + " (firn " + p.spec + ")")
            }
        }
    }
    vec_free[str](&lines)
}
