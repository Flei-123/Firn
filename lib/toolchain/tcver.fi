import std.rt
import std.pystr

struct Ver {
    a: u64,
    b: u64,
    c: u64,
    ok: bool,
}

fn ver_bad() -> Ver {
    return Ver { a: 0, b: 0, c: 0, ok: false }
}

fn ver_parse(s: str) -> Ver {
    var parts: [u64; 3] = [0, 0, 0]
    var k: usize = 0
    var digits: usize = 0
    var i: usize = 0
    while i < s.length() {
        let ch: u8 = s.chars(i)
        if ch == 46 as u8 {
            if digits == 0 || k == 2 {
                return ver_bad()
            }
            k = k + 1
            digits = 0
        } else if ch >= 48 as u8 && ch <= 57 as u8 {
            if digits >= 12 {
                return ver_bad()
            }
            parts[k] = parts[k] * 10 + (ch - 48 as u8) as u64
            digits = digits + 1
        } else {
            return ver_bad()
        }
        i = i + 1
    }
    if k != 2 || digits == 0 {
        return ver_bad()
    }
    return Ver { a: parts[0], b: parts[1], c: parts[2], ok: true }
}

fn ver_valid(s: str) -> bool {
    return ver_parse(s).ok
}

fn ver_cmp(x: str, y: str) -> i32 {
    let p: Ver = ver_parse(x)
    let q: Ver = ver_parse(y)
    if p.a != q.a {
        if p.a < q.a { return 0 - 1 }
        return 1
    }
    if p.b != q.b {
        if p.b < q.b { return 0 - 1 }
        return 1
    }
    if p.c != q.c {
        if p.c < q.c { return 0 - 1 }
        return 1
    }
    return 0
}

fn spec_valid(spec: str) -> bool {
    let s: str = pystr.strip(spec)
    if s.length() == 0 || s == "*" {
        return true
    }
    if pystr.startswith(s, ">=") {
        return ver_valid(pystr.strip(s.part(2, s.length() - 2)))
    }
    return ver_valid(s)
}

fn spec_is_exact(spec: str) -> bool {
    return ver_valid(pystr.strip(spec))
}

fn spec_matches(spec: str, have: str) -> bool {
    let s: str = pystr.strip(spec)
    if s.length() == 0 || s == "*" {
        return ver_valid(have)
    }
    if pystr.startswith(s, ">=") {
        return ver_cmp(have, pystr.strip(s.part(2, s.length() - 2))) >= 0
    }
    return ver_cmp(have, s) == 0
}

fn u64_text(v: u64) -> str {
    if v == 0 {
        return "0"
    }
    var tmp: [u8; 24] = [0; 24]
    var n: usize = 0
    var x: u64 = v
    while x > 0 {
        tmp[n] = (48 + x % 10) as u8
        x = x / 10
        n = n + 1
    }
    var b: rt.Buf = rt.buf_new()
    while n > 0 {
        n = n - 1
        rt.buf_push(&b, tmp[n])
    }
    let out: str = __str_copy(str { p: rt.buf_data(&b), n: rt.buf_len(&b) })
    rt.buf_free(&b)
    return out
}
