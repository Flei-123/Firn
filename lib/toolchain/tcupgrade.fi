import std.rt
import std.io
import toolchain.tcver
import toolchain.tcpaths
import toolchain.tcconfig
import toolchain.tcinstall
import toolchain.tcproject
import toolchain.tcmanifest

fn report_stale(newest: str) {
    var stale: Vec[str] = vec_new[str]()
    tcproject.stale_projects(newest, &stale)
    for i in 0..vec_len[str](&stale) {
        io.print_line("note: project pinned to an older Firn: " + *vec_elem_ptr[str](&stale, i))
    }
    vec_free[str](&stale)
}

fn install_and_use(channel: str, version: str, force: bool, switch: bool) -> i32 {
    let o: tcinstall.Outcome = tcinstall.install(channel, version, force)
    if o.err.length() > 0 {
        io.eprint_line("firn: " + o.err)
        return 1
    }
    if o.fresh {
        io.print_line("installed firn " + o.version)
    } else {
        io.print_line("firn " + o.version + " is already installed")
    }
    if switch && tcpaths.current_version() != o.version {
        let e: str = tcinstall.switch_to(o.version)
        if e.length() > 0 {
            io.eprint_line("firn: " + e)
            return 1
        }
        io.print_line("now using firn " + o.version)
    }
    return 0
}

fn cmd_install(version: str, channel: str, force: bool) -> i32 {
    let first: bool = tcpaths.current_version().length() == 0
    return install_and_use(channel, version, force, first || version.length() == 0)
}

fn cmd_upgrade(channel: str, pin: str, unpin: bool, force: bool) -> i32 {
    if unpin {
        tcconfig.config_set("pin", "")
        io.print_line("unpinned")
    }
    if pin.length() > 0 {
        if !tcver.ver_valid(pin) {
            io.eprint_line("firn: invalid version '" + pin + "'")
            return 2
        }
        tcconfig.config_set("pin", pin)
        let code: i32 = install_and_use(channel, pin, force, true)
        if code == 0 {
            io.print_line("pinned to " + pin)
        }
        return code
    }
    let held: str = tcconfig.config_get("pin")
    if held.length() > 0 {
        io.print_line("pinned to " + held + ", not upgrading (firn upgrade --unpin)")
        return 0
    }
    let r: tcmanifest.Release = tcinstall.fetch_release(tcinstall.channel_name(channel), "")
    if r.err.length() > 0 {
        io.eprint_line("firn: " + r.err)
        return 1
    }
    let cur: str = tcpaths.current_version()
    if !force && tcver.ver_valid(cur) && tcver.ver_cmp(r.version, cur) <= 0 {
        io.print_line("firn " + cur + " is up to date")
        report_stale(cur)
        return 0
    }
    let code: i32 = install_and_use(tcinstall.channel_name(channel), r.version, force, true)
    if code == 0 {
        report_stale(r.version)
    }
    return code
}
