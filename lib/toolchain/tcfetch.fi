import std.rt
import std.fs
import std.pystr
import appkit.fetch
import toolchain.tcpaths

const FETCH_MAX: u64 = 1073741824

fn fetch_text(url: str, out: *mut rt.Buf) -> str {
    rt.buf_clear(out)
    if pystr.startswith(url, "file://") {
        let path: str = url.part(7, url.length() - 7)
        if !tcpaths.read_into(path, out) {
            return "cannot read " + path
        }
        return ""
    }
    if pystr.startswith(url, "http://") || pystr.startswith(url, "https://") {
        var status: u32 = 0
        let r: u32 = fetch.fetch_get_mem(url, FETCH_MAX, 30000, true, out, &status)
        if r != fetch.FE_OK {
            return "download failed: " + url + " (" + fetch.fetch_err_text(r) + ")"
        }
        return ""
    }
    if fs.is_file(url) {
        if !tcpaths.read_into(url, out) {
            return "cannot read " + url
        }
        return ""
    }
    return "unsupported channel address: " + url
}

fn url_dir(url: str) -> str {
    let cut: i64 = pystr.rfind(url, "/")
    if cut < 0 {
        return "."
    }
    return url.part(0, cut as usize)
}

fn url_join(base: str, rel: str) -> str {
    if pystr.endswith(base, "/") {
        return base + rel
    }
    return base + "/" + rel
}
