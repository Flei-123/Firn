import std.rt
import std.io
import std.fs
import std.env
import std.pystr
import toolchain.tcver
import toolchain.tcpaths
import toolchain.tcplat
import toolchain.tcconfig
import toolchain.tcinstall
import toolchain.tcproject
import toolchain.tcrun
import toolchain.tcupgrade
import toolchain.tcdoctor

const USAGE: str = "usage: firn <command>\n  install [VERSION] [--channel C] [--force]\n  upgrade [--pin VERSION | --unpin] [--channel C] [--force]\n  list\n  use VERSION\n  version\n  doctor\n  channel URL [NAME]\n  build ARGS...    (= firnc ARGS...)\n  run FILE [ARGS...]\n"

fn arg(v: *mut Vec[str], i: usize) -> str {
    if i >= vec_len[str](v) {
        return ""
    }
    return *vec_elem_ptr[str](v, i)
}

fn base_name(p: str) -> str {
    var cut: i64 = pystr.rfind(p, "/")
    let back: i64 = pystr.rfind(p, "\\")
    if back > cut {
        cut = back
    }
    var b: str = p.part((cut + 1) as usize, p.length() - (cut + 1) as usize)
    if pystr.endswith(b, ".exe") {
        b = b.part(0, b.length() - 4)
    }
    return b
}

fn option(v: *mut Vec[str], name: str) -> str {
    for i in 0..vec_len[str](v) {
        if arg(v, i) == name {
            return arg(v, i + 1)
        }
    }
    return ""
}

fn flag(v: *mut Vec[str], name: str) -> bool {
    for i in 0..vec_len[str](v) {
        if arg(v, i) == name {
            return true
        }
    }
    return false
}

fn positional(v: *mut Vec[str], k: usize) -> str {
    var seen: usize = 0
    var i: usize = 2
    while i < vec_len[str](v) {
        let a: str = arg(v, i)
        if a == "--channel" || a == "--pin" {
            i = i + 2
        } else if pystr.startswith(a, "--") {
            i = i + 1
        } else {
            if seen == k {
                return a
            }
            seen = seen + 1
            i = i + 1
        }
    }
    return ""
}

fn proxy(name: str, v: *mut Vec[str], from: usize) -> i32 {
    let ch: tcrun.Choice = tcrun.choose()
    if ch.err.length() > 0 {
        io.eprint_line("firn: " + ch.err)
        return 1
    }
    return tcrun.exec_tool(name, ch.version, v, from)
}

fn cmd_list() -> i32 {
    var all: Vec[str] = vec_new[str]()
    tcproject.installed(&all)
    let cur: str = tcpaths.current_version()
    let pin: str = tcconfig.config_get("pin")
    for i in 0..vec_len[str](&all) {
        let n: str = *vec_elem_ptr[str](&all, i)
        var line: str = "  " + n
        if n == cur { line = "* " + n }
        if n == pin { line = line + " (pinned)" }
        io.print_line(line)
    }
    if vec_len[str](&all) == 0 {
        io.print_line("no versions installed")
    }
    vec_free[str](&all)
    return 0
}

fn cmd_use(v: str) -> i32 {
    if !tcver.ver_valid(v) {
        io.eprint_line("firn: use needs a version (firn list)")
        return 2
    }
    let e: str = tcinstall.switch_to(v)
    if e.length() > 0 {
        io.eprint_line("firn: " + e)
        return 1
    }
    io.print_line("now using firn " + v)
    return 0
}

fn cmd_version() -> i32 {
    let ch: tcrun.Choice = tcrun.choose()
    if ch.err.length() > 0 {
        io.eprint_line("firn: " + ch.err)
        return 1
    }
    io.print_line("firn " + ch.version + " (" + tcpaths.platform() + ", channel " + tcinstall.channel_name("") + ")")
    return 0
}

fn cmd_channel(url: str, name: str) -> i32 {
    if url.length() == 0 {
        io.print_line("url=" + tcconfig.config_get("url") + " channel=" + tcinstall.channel_name(""))
        return 0
    }
    if !tcpaths.make_dir(tcpaths.home()) {
        return 1
    }
    tcconfig.config_set("url", url)
    if name.length() > 0 {
        tcconfig.config_set("channel", name)
    }
    return 0
}

fn dispatch(v: *mut Vec[str]) -> i32 {
    let me: str = base_name(arg(v, 0))
    if me == "firnc" || me == "firnc1" {
        return proxy(me, v, 1)
    }
    let cmd: str = arg(v, 1)
    let channel: str = option(v, "--channel")
    let force: bool = flag(v, "--force")
    if cmd == "install" {
        return tcupgrade.cmd_install(positional(v, 0), tcinstall.channel_name(channel), force)
    }
    if cmd == "upgrade" {
        return tcupgrade.cmd_upgrade(channel, option(v, "--pin"), flag(v, "--unpin"), force)
    }
    if cmd == "list" { return cmd_list() }
    if cmd == "use" { return cmd_use(positional(v, 0)) }
    if cmd == "version" || cmd == "--version" { return cmd_version() }
    if cmd == "doctor" { return tcdoctor.cmd_doctor() }
    if cmd == "channel" { return cmd_channel(positional(v, 0), positional(v, 1)) }
    if cmd == "build" { return proxy("firnc", v, 2) }
    if cmd == "run" { return tcdoctor.cmd_run(v) }
    io.print(USAGE)
    if cmd == "help" || cmd == "--help" || cmd == "-h" {
        return 0
    }
    return 2
}
