import std.env
import toolchain.tcbrand

fn home_default() -> str {
    let h: str = env.get("LOCALAPPDATA")
    if h.length() == 0 {
        return ""
    }
    return h + "\\" + tcbrand.CLI
}

fn sep() -> str {
    return "\\"
}

fn default_platform() -> str {
    return "windows-x86_64"
}

fn exe_suffix() -> str {
    return ".exe"
}

fn symlinks_supported() -> bool {
    return false
}
