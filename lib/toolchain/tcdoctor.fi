import std.rt
import std.io
import std.fs
import std.fsx
import std.env
import std.pystr
import std.process
import toolchain.tcver
import toolchain.tcpaths
import toolchain.tcplat
import toolchain.tcconfig
import toolchain.tcrun
import toolchain.tcselftest

fn check(ok: bool, what: str, hint: str) -> u32 {
    if ok {
        io.print_line("ok    " + what)
        return 0
    }
    io.print_line("FAIL  " + what + " -- " + hint)
    return 1
}

fn cmd_doctor() -> i32 {
    var bad: u32 = 0
    let home: str = tcpaths.home()
    bad = bad + check(home.length() > 0 && fs.is_dir(home), "home " + home, "run the installer")
    let cur: str = tcpaths.current_version()
    bad = bad + check(tcpaths.is_installed(cur), "current version " + cur, "firn install")
    let url: str = tcconfig.config_get("url")
    bad = bad + check(url.length() > 0, "channel " + url, "firn channel <url>")
    let bin: str = tcpaths.bin_dir()
    let path: str = env.get("PATH")
    var sep: str = ":"
    if tcplat.sep() == "\\" { sep = ";" }
    bad = bad + check(pystr.contains(sep + path + sep, sep + bin + sep), bin + " in PATH", "add it to PATH")
    bad = bad + check(fs.exists(tcpaths.tool_of(tcpaths.home(), "firnc")), "shim firnc", "re-run the installer")
    if env.get("FIRNLIB").length() > 0 {
        io.print_line("warn  FIRNLIB is set; the shims ignore it, other firnc binaries use it")
    }
    if tcpaths.is_installed(cur) {
        let st: str = tcselftest.selftest(tcpaths.version_dir(cur))
        bad = bad + check(st.length() == 0, "selftest of " + cur, st)
    }
    if bad > 0 {
        return 1
    }
    return 0
}

fn cmd_run(v: *mut Vec[str]) -> i32 {
    if vec_len[str](v) < 3 {
        io.eprint_line("firn: run needs a source file")
        return 2
    }
    let ch: tcrun.Choice = tcrun.choose()
    if ch.err.length() > 0 {
        io.eprint_line("firn: " + ch.err)
        return 1
    }
    var td: fsx.TempDir = fsx.temp_dir("firn-run") catch tcpaths.no_temp()
    if rt.buf_len(&td.path) == 0 {
        return 1
    }
    let exe: str = tcpaths.join(fsx.temp_dir_path(&td), "prog" + tcplat.exe_suffix())
    var build: Vec[str] = vec_new[str]()
    vec_push[str](&build, *vec_elem_ptr[str](v, 2))
    vec_push[str](&build, "-o")
    vec_push[str](&build, exe)
    var code: i32 = tcrun.exec_tool("firnc", ch.version, &build, 0)
    vec_free[str](&build)
    if code == 0 {
        var c: process.Command = process.command(exe)
        var i: usize = 3
        while i < vec_len[str](v) {
            process.add_arg(&c, *vec_elem_ptr[str](v, i))
            i = i + 1
        }
        code = process.run(&c) catch |e| -1
        process.command_free(&c)
    }
    fsx.temp_dir_drop(&td)
    return code
}
