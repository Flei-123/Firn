import std.env
import toolchain.tcbrand

fn prefix() -> str {
    return tcbrand.CLI + ": "
}

fn env_name(suffix: str) -> str {
    return tcbrand.ENV_PREFIX + "_" + suffix
}

fn sysroot_env() -> str {
    return tcbrand.ENV_PREFIX + "LIB"
}

fn env_get(suffix: str) -> str {
    let v: str = env.get(env_name(suffix))
    if v.length() > 0 || tcbrand.LEGACY_ENV_PREFIX.length() == 0 {
        return v
    }
    return env.get(tcbrand.LEGACY_ENV_PREFIX + "_" + suffix)
}

fn sysroot_get() -> str {
    let v: str = env.get(sysroot_env())
    if v.length() > 0 || tcbrand.LEGACY_ENV_PREFIX.length() == 0 {
        return v
    }
    return env.get(tcbrand.LEGACY_ENV_PREFIX + "LIB")
}
