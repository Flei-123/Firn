import std.env

fn home_default() -> str {
    let h: str = env.get("HOME")
    if h.length() == 0 {
        return ""
    }
    return h + "/.firn"
}

fn sep() -> str {
    return "/"
}

fn default_platform() -> str {
    return "linux-x86_64"
}

fn exe_suffix() -> str {
    return ""
}

fn links_supported() -> bool {
    return true
}
