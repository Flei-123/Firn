// SPDX-License-Identifier: MPL-2.0
// lib/gpu/vk_shaders.fi -- gpu.vk_shaders: the SPIR-V of the Vulkan MC renderer (sources lib/gpu/vk_glsl/*.glsl, build
// tools/gpu/mkspv.sh, interface docs/VK-RENDERER.md (Shaders)) embedded as octets plus every interface number the host code needs:
// descriptor bindings, push constant layout, std140 offsets of the `Frame` UBO, vertex formats and strides.
// No GPU import: this module is pure data, so programs that do not draw stay static.
//
//     import gpu.vk_shaders
//     let code: u64 = vk_shaders.MC_VS.p as u64          // pCode of vkCreateShaderModule (4-aligned copy needed, see vk.shader_make)
//     let size: usize = vk_shaders.MC_VS.n
//
// Pipeline recipe: docs/VK-RENDERER.md (Shaders) (viewport flip, depth 0..1, blend / depth state per pass).

export {
    MC_VS, MC_FS, SKY_VS, SKY_FS, ENT_VS, ENT_FS, HUD_VS, HUD_FS, TINT_VS, TINT_FS, MODEL_VS, MODEL_FS,
    SHADER_COUNT, shader_code, shader_size, shader_name, shader_stage,
    SET, B_FRAME, B_ATLAS0, B_ATLAS1, B_ATLAS2, B_ATLAS3, B_GRAN, B_ORG,
    PC_SIZE, PC_ORIGIN, PC_POOL,
    FRAME_SIZE, U_RV, U_FOG, U_FADE, U_LIGHT, U_CAM, U_SUN, U_FOGC, U_R, U_U, U_F, U_ZEN, U_HOR, U_GLC, U_TINT,
    U_TILES, U_SIZE, U_PAGEL, U_TRANS, U_FILTER, U_DISCS, U_INVERT, U_H,
    MC_STRIDE, MODEL_STRIDE, ENT_VERT_STRIDE, ENT_INST_STRIDE, HUD_STRIDE, ENT_VERTS, SKY_VERTS,
    STAGE_VERT, STAGE_FRAG,
}

const MC_VS: str = __include_str("spv/vk_mc.vert.spv")
const MC_FS: str = __include_str("spv/vk_mc.frag.spv")
const SKY_VS: str = __include_str("spv/vk_sky.vert.spv")
const SKY_FS: str = __include_str("spv/vk_sky.frag.spv")
const ENT_VS: str = __include_str("spv/vk_ent.vert.spv")
const ENT_FS: str = __include_str("spv/vk_ent.frag.spv")
const HUD_VS: str = __include_str("spv/vk_hud.vert.spv")
const HUD_FS: str = __include_str("spv/vk_hud.frag.spv")
const TINT_VS: str = __include_str("spv/vk_sky.vert.spv") // the tint pass reuses the full-screen strip
const TINT_FS: str = __include_str("spv/vk_tint.frag.spv")
const MODEL_VS: str = __include_str("spv/vk_model.vert.spv") // MESH_MODEL / MESH_MODEL_T pass (float vertices, stride MODEL_STRIDE)
const MODEL_FS: str = __include_str("spv/vk_model.frag.spv")

const STAGE_VERT: i32 = 0
const STAGE_FRAG: i32 = 4

const SHADER_COUNT: i32 = 11 // distinct modules, index = shader_code(i): mc vs/fs, sky vs/fs, ent vs/fs, hud vs/fs, tint fs, model vs/fs

// ---- descriptor set 0 (the only set) -------------------------------------------------------------------------
const SET: i32 = 0
const B_FRAME: i32 = 0 // UNIFORM_BUFFER (dynamic offset allowed), vertex + fragment, FRAME_SIZE octets
const B_ATLAS0: i32 = 1 // COMBINED_IMAGE_SAMPLER, 2D_ARRAY view, fragment
const B_ATLAS1: i32 = 2
const B_ATLAS2: i32 = 3
const B_ATLAS3: i32 = 4
const B_GRAN: i32 = 5 // UNIFORM_TEXEL_BUFFER R32_UINT, vertex (pool mode)
const B_ORG: i32 = 6 // UNIFORM_TEXEL_BUFFER R32G32B32A32_SFLOAT, vertex (pool mode)

// ---- push constants (vertex stage, mc_vs only) ---------------------------------------------------------------
const PC_SIZE: usize = 16
const PC_ORIGIN: usize = 0 // vec3 section origin minus camera
const PC_POOL: usize = 12 // int 0 / 1

// ---- Frame UBO (std140) offsets, FRAME_SIZE octets ----------------------------------------------------------
const FRAME_SIZE: usize = 320
const U_RV: usize = 0 // mat4, column-major
const U_FOG: usize = 64 // vec4
const U_FADE: usize = 80 // vec4
const U_LIGHT: usize = 96 // vec4
const U_CAM: usize = 112 // vec4
const U_SUN: usize = 128 // vec4
const U_FOGC: usize = 144 // vec3 (+ 4 octets pad)
const U_R: usize = 160
const U_U: usize = 176
const U_F: usize = 192
const U_ZEN: usize = 208
const U_HOR: usize = 224
const U_GLC: usize = 240
const U_TINT: usize = 256
const U_TILES: usize = 272 // vec2
const U_SIZE: usize = 280 // vec2
const U_PAGEL: usize = 288 // int
const U_TRANS: usize = 292 // int
const U_FILTER: usize = 296 // int
const U_DISCS: usize = 300 // int
const U_INVERT: usize = 304 // int
const U_H: usize = 308 // float

// ---- vertex formats ----------------------------------------------------------------------------------------
const MC_STRIDE: usize = 8 // binding 0, per vertex: loc 0 = R32G32_UINT
const MODEL_STRIDE: usize = 48 // model pass, binding 0, per vertex: loc 0 = R32G32B32_SFLOAT (+0), loc 1 = R32G32B32A32_SFLOAT (+12), loc 2 = R32G32B32A32_SFLOAT (+28)
const ENT_VERT_STRIDE: usize = 16 // binding 0, per vertex: loc 0 = R32G32B32_SFLOAT pos (+0), loc 1 = R32_SFLOAT face (+12)
const ENT_INST_STRIDE: usize = 48 // binding 1, per INSTANCE: loc 2/3/4 = R32G32B32A32_SFLOAT at +0 / +16 / +32
const HUD_STRIDE: usize = 20 // binding 0, per INSTANCE: loc 0 = R32G32B32A32_SINT (+0), loc 1 = R32_UINT (+16)
const ENT_VERTS: i32 = 24 // unit cube: 24 vertices (index buffer 36)
const SKY_VERTS: i32 = 4 // sky + tint: vkCmdDraw(4, 1, 0, 0), TRIANGLE_STRIP, no vertex buffer

fn shader_code(i: i32) -> u64 {
    if i == 0 { return MC_VS.p as u64 }
    if i == 1 { return MC_FS.p as u64 }
    if i == 2 { return SKY_VS.p as u64 }
    if i == 3 { return SKY_FS.p as u64 }
    if i == 4 { return ENT_VS.p as u64 }
    if i == 5 { return ENT_FS.p as u64 }
    if i == 6 { return HUD_VS.p as u64 }
    if i == 7 { return HUD_FS.p as u64 }
    if i == 8 { return TINT_FS.p as u64 }
    if i == 9 { return MODEL_VS.p as u64 }
    if i == 10 { return MODEL_FS.p as u64 }
    return 0
}

fn shader_size(i: i32) -> usize {
    if i == 0 { return MC_VS.n }
    if i == 1 { return MC_FS.n }
    if i == 2 { return SKY_VS.n }
    if i == 3 { return SKY_FS.n }
    if i == 4 { return ENT_VS.n }
    if i == 5 { return ENT_FS.n }
    if i == 6 { return HUD_VS.n }
    if i == 7 { return HUD_FS.n }
    if i == 8 { return TINT_FS.n }
    if i == 9 { return MODEL_VS.n }
    if i == 10 { return MODEL_FS.n }
    return 0
}

fn shader_name(i: i32) -> str {
    if i == 0 { return "mc.vert" }
    if i == 1 { return "mc.frag" }
    if i == 2 { return "sky.vert" }
    if i == 3 { return "sky.frag" }
    if i == 4 { return "ent.vert" }
    if i == 5 { return "ent.frag" }
    if i == 6 { return "hud.vert" }
    if i == 7 { return "hud.frag" }
    if i == 8 { return "tint.frag" }
    if i == 9 { return "model.vert" }
    if i == 10 { return "model.frag" }
    return ""
}

fn shader_stage(i: i32) -> i32 {
    if i == 0 || i == 2 || i == 4 || i == 6 || i == 9 { return STAGE_VERT }
    return STAGE_FRAG
}
