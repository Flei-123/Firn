// SPDX-License-Identifier: MPL-2.0
// lib/gpu/vkplat.windows.fi -- gpu.vkplat, Windows twin (vulkan-1.dll + VK_KHR_win32_surface). BUILD ONLY: not run on a real
// Windows machine (Wine has no Vulkan ICD here). Same names as the Linux file; `native` is the HWND, `mode` is ignored.
import std.rt
import std.dynlib
import std.env

export {
    PlatState, plat_new, plat_close, lib_open, surface_ext_count, surface_ext_name, surface_create, read_window, plat_name,
}

struct PlatState {
    k32: u64, // kernel32 handle
}

fn plat_new() -> PlatState {
    return PlatState { k32: 0 }
}

fn plat_name() -> str {
    return "win32"
}

fn lib_open() -> u64 {
    if env.has("FIRN_VK_LIB") {
        return dynlib.open(env.get("FIRN_VK_LIB"))
    }
    return dynlib.open("vulkan-1.dll")
}

// 0 = VK_KHR_surface, 1 = win32
fn surface_ext_count() -> i32 {
    return 2
}

fn surface_ext_name(i: i32) -> str {
    if i == 0 {
        return "VK_KHR_surface"
    }
    return "VK_KHR_win32_surface"
}

fn call6(f: u64, a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64) -> u64 {
    var a: [u64; 8] = [0; 8]
    a[0] = a0
    a[1] = a1
    a[2] = a2
    a[3] = a3
    a[4] = a4
    a[5] = a5
    return dynlib.callx(f, "iiiiii", (&a[0]) as u64, false)
}

fn put_name(p: u64, s: str) {
    let n: usize = s.length()
    var i: usize = 0
    while i < n {
        rt.st8(p, i, s.chars(i))
        i = i + 1
    }
    rt.st8(p, n, 0 as u8)
}

// `mask` bit 1 = VK_KHR_win32_surface enabled. scratch: >= 256 zeroed bytes. out: the VkSurfaceKHR.
fn surface_create(p: *mut PlatState, gipa: u64, inst: u64, mask: u64, native: u64, mode: i32, scratch: u64, out: u64) -> bool {
    if (mask & 2) == 0 {
        return false
    }
    if (*p).k32 == 0 {
        (*p).k32 = dynlib.open("kernel32.dll")
    }
    let gm: u64 = dynlib.sym((*p).k32, "GetModuleHandleW")
    if gm == 0 {
        return false
    }
    rt.mem_set(scratch, 0 as u8, 256)
    put_name(scratch + 128, "vkCreateWin32SurfaceKHR")
    let f: u64 = call6(gipa, inst, scratch + 128, 0, 0, 0, 0)
    if f == 0 {
        return false
    }
    rt.st32(scratch, 0, 1000009000 as u32) // VK_STRUCTURE_TYPE_WIN32_SURFACE_CREATE_INFO_KHR
    rt.st64(scratch, 3, call6(gm, 0, 0, 0, 0, 0, 0))
    rt.st64(scratch, 4, native)
    let r: u64 = call6(f, inst, scratch, 0, out, 0, 0)
    return (r & 0xFFFFFFFF) == 0
}

// not implemented on Windows (the X11 test reads the window back with XGetImage)
fn read_window(p: *mut PlatState, xid: u64, w: i32, h: i32, out: u64) -> bool {
    return false
}

fn plat_close(p: *mut PlatState) {
    (*p).k32 = 0
}
