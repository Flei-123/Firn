// SPDX-License-Identifier: MPL-2.0
// lib/gpu/gl33.fi -- gpu.gl33: an OpenGL 3.3 core API wrapper on top of std.dynlib (no link-time GL).
//
//     import gpu.glctx
//     import gpu.gl33
//     var c: glctx.GlCtx = glctx.ctx_open(0, 0)
//     var g: gl33.Gl = gl33.gl_new()
//     if gl33.gl_load(&c, &g) { ... }               // every function below is now callable
//
// All GL functions are looked up once by glctx.ctx_proc (the context must be current) and called through
// dynlib.callx; this file has NO platform code, so the Windows build uses it unchanged (the call gate of
// dynlib.windows.fi numbers floats by position: the signatures below list integers and floats in argument order).
//
// Sections: state, buffers + VAO, textures, framebuffers, shaders + uniforms, draw, read back.
// Shapes: a "u32" result is masked (rax of a 32-bit return has undefined upper bits), floats travel as f32.
// Call from the MAIN thread only (docs/FFI.md).

import std.rt
import std.dynlib
import gpu.glctx

export {
    Gl, Fbo, gl_new, gl_load, gl_string, gl_get_error, gl_get_int,
    gl_viewport, gl_scissor, gl_enable, gl_disable, gl_clear, gl_clear_color, gl_depth_func, gl_depth_mask,
    gl_color_mask, gl_cull_face, gl_front_face, gl_blend_func, gl_pixel_store, gl_finish, gl_flush,
    gl_gen_buffer, gl_bind_buffer, gl_buffer_data, gl_buffer_sub_data, gl_delete_buffer,
    gl_gen_vao, gl_bind_vao, gl_delete_vao, gl_enable_attrib, gl_attrib_i, gl_attrib_f,
    gl_tex_rgba8, gl_tex_update, gl_bind_tex, gl_delete_tex,
    gl_fbo_new, gl_fbo_bind, gl_fbo_unbind, gl_fbo_free,
    gl_program, gl_use, gl_delete_program, gl_uniform_loc, gl_u1i, gl_u1f, gl_u2f, gl_u3f, gl_u4f,
    gl_uniform_mat4, gl_mat4_f64_to_f32,
    gl_draw_elements, gl_draw_arrays, gl_read_rgba, gl_read_rgba_top_down,
    gl_draw_elements_bv, gl_multi_draw_elements_bv, gl_multi_draw_indirect, gl_draw_elements_instanced,
    gl_attrib_divisor, gl_copy_buffer, gl_gen_texture, gl_bind_tex_target, gl_tex_buffer,
    gl_tex_array_rgba8, gl_tex_param_f, gl_get_float, gl_map_range, gl_unmap, gl_flush_mapped, gl_buffer_storage,
    gl_fence, gl_fence_wait, gl_fence_delete, gl_tex_array_filter,
    GL_TEXTURE_BUFFER, GL_TEXTURE_2D_ARRAY, GL_COPY_READ_BUFFER, GL_COPY_WRITE_BUFFER, GL_DRAW_INDIRECT_BUFFER,
    GL_R32UI, GL_RGBA32F, GL_REPEAT, GL_MAP_WRITE_BIT, GL_MAP_UNSYNCHRONIZED_BIT, GL_MAP_FLUSH_EXPLICIT_BIT,
    GL_MAP_INVALIDATE_RANGE_BIT, GL_MAP_PERSISTENT_BIT, GL_MAP_COHERENT_BIT, GL_DYNAMIC_STORAGE_BIT,
    GL_TEXTURE_MAX_ANISOTROPY, GL_MAX_TEXTURE_MAX_ANISOTROPY,
    GL_FALSE, GL_TRUE, GL_DEPTH_BUFFER_BIT, GL_COLOR_BUFFER_BIT, GL_TRIANGLES, GL_LESS, GL_LEQUAL, GL_DEPTH_TEST,
    GL_CULL_FACE, GL_BLEND, GL_SCISSOR_TEST, GL_BACK, GL_FRONT, GL_CCW, GL_CW, GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA,
    GL_ARRAY_BUFFER, GL_ELEMENT_ARRAY_BUFFER, GL_STATIC_DRAW, GL_DYNAMIC_DRAW, GL_STREAM_DRAW,
    GL_UNSIGNED_BYTE, GL_UNSIGNED_SHORT, GL_UNSIGNED_INT, GL_FLOAT, GL_RGBA, GL_RGBA8, GL_TEXTURE_2D,
    GL_NEAREST, GL_LINEAR, GL_NEAREST_MIPMAP_NEAREST, GL_LINEAR_MIPMAP_NEAREST, GL_NEAREST_MIPMAP_LINEAR,
    GL_LINEAR_MIPMAP_LINEAR, GL_VERTEX_SHADER, GL_FRAGMENT_SHADER, GL_NO_ERROR,
    GL_VERSION, GL_RENDERER, GL_VENDOR,
}

const GL_FALSE: u32 = 0
const GL_TRUE: u32 = 1
const GL_DEPTH_BUFFER_BIT: u32 = 0x100
const GL_COLOR_BUFFER_BIT: u32 = 0x4000
const GL_TRIANGLES: u32 = 4
const GL_LESS: u32 = 0x201
const GL_LEQUAL: u32 = 0x203
const GL_DEPTH_TEST: u32 = 0xB71
const GL_CULL_FACE: u32 = 0xB44
const GL_BLEND: u32 = 0xBE2
const GL_SCISSOR_TEST: u32 = 0xC11
const GL_BACK: u32 = 0x405
const GL_FRONT: u32 = 0x404
const GL_CCW: u32 = 0x901
const GL_CW: u32 = 0x900
const GL_SRC_ALPHA: u32 = 0x302
const GL_ONE_MINUS_SRC_ALPHA: u32 = 0x303
const GL_ARRAY_BUFFER: u32 = 0x8892
const GL_ELEMENT_ARRAY_BUFFER: u32 = 0x8893
const GL_STATIC_DRAW: u32 = 0x88E4
const GL_DYNAMIC_DRAW: u32 = 0x88E8
const GL_STREAM_DRAW: u32 = 0x88E0
const GL_UNSIGNED_BYTE: u32 = 0x1401
const GL_UNSIGNED_SHORT: u32 = 0x1403
const GL_UNSIGNED_INT: u32 = 0x1405
const GL_FLOAT: u32 = 0x1406
const GL_RGBA: u32 = 0x1908
const GL_RGBA8: u32 = 0x8058
const GL_TEXTURE_2D: u32 = 0xDE1
const GL_NEAREST: u32 = 0x2600
const GL_LINEAR: u32 = 0x2601
const GL_NEAREST_MIPMAP_NEAREST: u32 = 0x2700
const GL_LINEAR_MIPMAP_NEAREST: u32 = 0x2701
const GL_NEAREST_MIPMAP_LINEAR: u32 = 0x2702
const GL_LINEAR_MIPMAP_LINEAR: u32 = 0x2703
const GL_VERTEX_SHADER: u32 = 0x8B31
const GL_FRAGMENT_SHADER: u32 = 0x8B30
const GL_NO_ERROR: u32 = 0
const GL_VENDOR: u32 = 0x1F00
const GL_RENDERER: u32 = 0x1F01
const GL_VERSION: u32 = 0x1F02

const GL_TEXTURE_BUFFER: u32 = 0x8C2A
const GL_TEXTURE_2D_ARRAY: u32 = 0x8C1A
const GL_COPY_READ_BUFFER: u32 = 0x8F36
const GL_COPY_WRITE_BUFFER: u32 = 0x8F37
const GL_DRAW_INDIRECT_BUFFER: u32 = 0x8F3F
const GL_R32UI: u32 = 0x8236
const GL_RGBA32F: u32 = 0x8814
const GL_REPEAT: u32 = 0x2901
const GL_MAP_WRITE_BIT: u32 = 2
const GL_MAP_INVALIDATE_RANGE_BIT: u32 = 4
const GL_MAP_FLUSH_EXPLICIT_BIT: u32 = 0x10
const GL_MAP_UNSYNCHRONIZED_BIT: u32 = 0x20
const GL_MAP_PERSISTENT_BIT: u32 = 0x40
const GL_MAP_COHERENT_BIT: u32 = 0x80
const GL_DYNAMIC_STORAGE_BIT: u32 = 0x100
const GL_TEXTURE_MAX_ANISOTROPY: u32 = 0x84FE
const GL_MAX_TEXTURE_MAX_ANISOTROPY: u32 = 0x84FF
const GL_TEXTURE_MAG_FILTER: u32 = 0x2800
const GL_TEXTURE_MIN_FILTER: u32 = 0x2801
const GL_TEXTURE_WRAP_S: u32 = 0x2802
const GL_TEXTURE_WRAP_T: u32 = 0x2803
const GL_TEXTURE_MAX_LEVEL: u32 = 0x813D
const GL_CLAMP_TO_EDGE: u32 = 0x812F
const GL_TEXTURE0: u32 = 0x84C0
const GL_FRAMEBUFFER: u32 = 0x8D40
const GL_RENDERBUFFER: u32 = 0x8D41
const GL_COLOR_ATTACHMENT0: u32 = 0x8CE0
const GL_DEPTH_ATTACHMENT: u32 = 0x8D00
const GL_DEPTH_COMPONENT24: u32 = 0x81A6
const GL_FRAMEBUFFER_COMPLETE: u32 = 0x8CD5
const GL_COMPILE_STATUS: u32 = 0x8B81
const GL_LINK_STATUS: u32 = 0x8B82
const GL_PACK_ALIGNMENT: u32 = 0xD05
const GL_UNPACK_ALIGNMENT: u32 = 0xCF5

const F_GET_STRING: usize = 0
const F_GET_ERROR: usize = 1
const F_GET_INTEGERV: usize = 2
const F_VIEWPORT: usize = 3
const F_SCISSOR: usize = 4
const F_ENABLE: usize = 5
const F_DISABLE: usize = 6
const F_CLEAR: usize = 7
const F_CLEAR_COLOR: usize = 8
const F_DEPTH_FUNC: usize = 9
const F_DEPTH_MASK: usize = 10
const F_COLOR_MASK: usize = 11
