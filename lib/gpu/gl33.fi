const F_BIND_VERTEX_ARRAY: usize = 25
const F_DELETE_VERTEX_ARRAYS: usize = 26
const F_ENABLE_VERTEX_ATTRIB_ARRAY: usize = 27
const F_VERTEX_ATTRIB_POINTER: usize = 28
const F_VERTEX_ATTRIB_IPOINTER: usize = 29
const F_DRAW_ARRAYS: usize = 30
const F_DRAW_ELEMENTS: usize = 31
const F_GEN_TEXTURES: usize = 32
const F_BIND_TEXTURE: usize = 33
const F_ACTIVE_TEXTURE: usize = 34
const F_TEX_IMAGE2D: usize = 35
const F_TEX_SUB_IMAGE2D: usize = 36
const F_TEX_PARAMETERI: usize = 37
const F_GENERATE_MIPMAP: usize = 38
const F_DELETE_TEXTURES: usize = 39
const F_GEN_FRAMEBUFFERS: usize = 40
const F_BIND_FRAMEBUFFER: usize = 41
const F_FRAMEBUFFER_TEXTURE2D: usize = 42
const F_FRAMEBUFFER_RENDERBUFFER: usize = 43
const F_CHECK_FRAMEBUFFER_STATUS: usize = 44
const F_DELETE_FRAMEBUFFERS: usize = 45
const F_GEN_RENDERBUFFERS: usize = 46
const F_BIND_RENDERBUFFER: usize = 47
const F_RENDERBUFFER_STORAGE: usize = 48
const F_DELETE_RENDERBUFFERS: usize = 49
const F_CREATE_SHADER: usize = 50
const F_SHADER_SOURCE: usize = 51
const F_COMPILE_SHADER: usize = 52
const F_GET_SHADERIV: usize = 53
const F_GET_SHADER_INFO_LOG: usize = 54
const F_DELETE_SHADER: usize = 55
const F_CREATE_PROGRAM: usize = 56
const F_ATTACH_SHADER: usize = 57
const F_LINK_PROGRAM: usize = 58
const F_GET_PROGRAMIV: usize = 59
const F_GET_PROGRAM_INFO_LOG: usize = 60
const F_USE_PROGRAM: usize = 61
const F_DELETE_PROGRAM: usize = 62
const F_GET_UNIFORM_LOCATION: usize = 63
const F_UNIFORM1I: usize = 64
const F_UNIFORM1F: usize = 65
const F_UNIFORM2F: usize = 66
const F_UNIFORM3F: usize = 67
const F_UNIFORM4F: usize = 68
const F_UNIFORM_MATRIX4FV: usize = 69
const F_BIND_ATTRIB_LOCATION: usize = 70
const F_DRAW_ELEMENTS_BASE_VERTEX: usize = 71
const F_MULTI_DRAW_ELEMENTS_BASE_VERTEX: usize = 72
const F_COPY_BUFFER_SUB_DATA: usize = 73
const F_TEX_BUFFER: usize = 74
const F_TEX_IMAGE3D: usize = 75
const F_TEX_PARAMETERF: usize = 76
const F_GET_FLOATV: usize = 77
const F_DRAW_ELEMENTS_INSTANCED: usize = 78
const F_VERTEX_ATTRIB_DIVISOR: usize = 79
const F_MAP_BUFFER_RANGE: usize = 80
const F_UNMAP_BUFFER: usize = 81
const F_FLUSH_MAPPED_BUFFER_RANGE: usize = 82
const F_FENCE_SYNC: usize = 83
const F_CLIENT_WAIT_SYNC: usize = 84
const F_DELETE_SYNC: usize = 85
// optional (GL 4.x): a missing one only clears has_indirect / has_storage
const F_MULTI_DRAW_ELEMENTS_INDIRECT: usize = 86
const F_BUFFER_STORAGE: usize = 87
const NFN: usize = 88

struct Gl {
    ok: bool,
    missing: i32, // functions the driver did not give
    fns: [u64; 96],
    args: [u64; 16], // scratch for one call
    tmp: [u32; 8], // scratch for glGen* / glGet* results
    major: i32,
    minor: i32,
    has_indirect: bool, // glMultiDrawElementsIndirect (GL 4.3) resolved and the context is >= 4.3
    has_storage: bool, // glBufferStorage (GL 4.4) resolved and the context is >= 4.4
    max_aniso: f64, // GL_MAX_TEXTURE_MAX_ANISOTROPY (EXT_texture_filter_anisotropic), 0 = not available
}

struct Fbo {
    fbo: u32,
    color: u32, // RGBA8 texture
    depth: u32, // DEPTH24 renderbuffer
    w: i32,
    h: i32,
}

fn gl_new() -> Gl {
    return Gl { ok: false, missing: 0, fns: [0; 96], args: [0; 16], tmp: [0; 8], major: 0, minor: 0, has_indirect: false,
        has_storage: false, max_aniso: 0.0 }
}

fn reg(c: *mut glctx.GlCtx, g: *mut Gl, id: usize, name: str) -> bool {
    let p: u64 = glctx.ctx_proc(c, name)
    (*g).fns[id] = p
    return p != 0
}

// Looks up every function of this file in the (current) context. False if one is missing or the context is
// older than 3.3 (the version string is parsed: "3.3 ..." / "4.5 ...").
fn gl_load(c: *mut glctx.GlCtx, g: *mut Gl) -> bool {
    var miss: i32 = 0
    if !reg(c, g, F_GET_STRING, "glGetString") { miss = miss + 1 }
    if !reg(c, g, F_GET_ERROR, "glGetError") { miss = miss + 1 }
    if !reg(c, g, F_GET_INTEGERV, "glGetIntegerv") { miss = miss + 1 }
    if !reg(c, g, F_VIEWPORT, "glViewport") { miss = miss + 1 }
    if !reg(c, g, F_SCISSOR, "glScissor") { miss = miss + 1 }
    if !reg(c, g, F_ENABLE, "glEnable") { miss = miss + 1 }
    if !reg(c, g, F_DISABLE, "glDisable") { miss = miss + 1 }
    if !reg(c, g, F_CLEAR, "glClear") { miss = miss + 1 }
    if !reg(c, g, F_CLEAR_COLOR, "glClearColor") { miss = miss + 1 }
    if !reg(c, g, F_DEPTH_FUNC, "glDepthFunc") { miss = miss + 1 }
    if !reg(c, g, F_DEPTH_MASK, "glDepthMask") { miss = miss + 1 }
    if !reg(c, g, F_COLOR_MASK, "glColorMask") { miss = miss + 1 }
    if !reg(c, g, F_CULL_FACE, "glCullFace") { miss = miss + 1 }
    if !reg(c, g, F_FRONT_FACE, "glFrontFace") { miss = miss + 1 }
    if !reg(c, g, F_BLEND_FUNC, "glBlendFunc") { miss = miss + 1 }
    if !reg(c, g, F_PIXEL_STOREI, "glPixelStorei") { miss = miss + 1 }
    if !reg(c, g, F_READ_PIXELS, "glReadPixels") { miss = miss + 1 }
    if !reg(c, g, F_FINISH, "glFinish") { miss = miss + 1 }
    if !reg(c, g, F_FLUSH, "glFlush") { miss = miss + 1 }
    if !reg(c, g, F_GEN_BUFFERS, "glGenBuffers") { miss = miss + 1 }
    if !reg(c, g, F_BIND_BUFFER, "glBindBuffer") { miss = miss + 1 }
    if !reg(c, g, F_BUFFER_DATA, "glBufferData") { miss = miss + 1 }
    if !reg(c, g, F_BUFFER_SUB_DATA, "glBufferSubData") { miss = miss + 1 }
    if !reg(c, g, F_DELETE_BUFFERS, "glDeleteBuffers") { miss = miss + 1 }
    if !reg(c, g, F_GEN_VERTEX_ARRAYS, "glGenVertexArrays") { miss = miss + 1 }
    if !reg(c, g, F_BIND_VERTEX_ARRAY, "glBindVertexArray") { miss = miss + 1 }
    if !reg(c, g, F_DELETE_VERTEX_ARRAYS, "glDeleteVertexArrays") { miss = miss + 1 }
    if !reg(c, g, F_ENABLE_VERTEX_ATTRIB_ARRAY, "glEnableVertexAttribArray") { miss = miss + 1 }
    if !reg(c, g, F_VERTEX_ATTRIB_POINTER, "glVertexAttribPointer") { miss = miss + 1 }
    if !reg(c, g, F_VERTEX_ATTRIB_IPOINTER, "glVertexAttribIPointer") { miss = miss + 1 }
    if !reg(c, g, F_DRAW_ARRAYS, "glDrawArrays") { miss = miss + 1 }
    if !reg(c, g, F_DRAW_ELEMENTS, "glDrawElements") { miss = miss + 1 }
    if !reg(c, g, F_GEN_TEXTURES, "glGenTextures") { miss = miss + 1 }
    if !reg(c, g, F_BIND_TEXTURE, "glBindTexture") { miss = miss + 1 }
    if !reg(c, g, F_ACTIVE_TEXTURE, "glActiveTexture") { miss = miss + 1 }
    if !reg(c, g, F_TEX_IMAGE2D, "glTexImage2D") { miss = miss + 1 }
    if !reg(c, g, F_TEX_SUB_IMAGE2D, "glTexSubImage2D") { miss = miss + 1 }
    if !reg(c, g, F_TEX_PARAMETERI, "glTexParameteri") { miss = miss + 1 }
    if !reg(c, g, F_GENERATE_MIPMAP, "glGenerateMipmap") { miss = miss + 1 }
    if !reg(c, g, F_DELETE_TEXTURES, "glDeleteTextures") { miss = miss + 1 }
    if !reg(c, g, F_GEN_FRAMEBUFFERS, "glGenFramebuffers") { miss = miss + 1 }
    if !reg(c, g, F_BIND_FRAMEBUFFER, "glBindFramebuffer") { miss = miss + 1 }
    if !reg(c, g, F_FRAMEBUFFER_TEXTURE2D, "glFramebufferTexture2D") { miss = miss + 1 }
    if !reg(c, g, F_FRAMEBUFFER_RENDERBUFFER, "glFramebufferRenderbuffer") { miss = miss + 1 }
    if !reg(c, g, F_CHECK_FRAMEBUFFER_STATUS, "glCheckFramebufferStatus") { miss = miss + 1 }
    if !reg(c, g, F_DELETE_FRAMEBUFFERS, "glDeleteFramebuffers") { miss = miss + 1 }
    if !reg(c, g, F_GEN_RENDERBUFFERS, "glGenRenderbuffers") { miss = miss + 1 }
    if !reg(c, g, F_BIND_RENDERBUFFER, "glBindRenderbuffer") { miss = miss + 1 }
    if !reg(c, g, F_RENDERBUFFER_STORAGE, "glRenderbufferStorage") { miss = miss + 1 }
    if !reg(c, g, F_DELETE_RENDERBUFFERS, "glDeleteRenderbuffers") { miss = miss + 1 }
    if !reg(c, g, F_CREATE_SHADER, "glCreateShader") { miss = miss + 1 }
    if !reg(c, g, F_SHADER_SOURCE, "glShaderSource") { miss = miss + 1 }
    if !reg(c, g, F_COMPILE_SHADER, "glCompileShader") { miss = miss + 1 }
    if !reg(c, g, F_GET_SHADERIV, "glGetShaderiv") { miss = miss + 1 }
    if !reg(c, g, F_GET_SHADER_INFO_LOG, "glGetShaderInfoLog") { miss = miss + 1 }
    if !reg(c, g, F_DELETE_SHADER, "glDeleteShader") { miss = miss + 1 }
    if !reg(c, g, F_CREATE_PROGRAM, "glCreateProgram") { miss = miss + 1 }
    if !reg(c, g, F_ATTACH_SHADER, "glAttachShader") { miss = miss + 1 }
    if !reg(c, g, F_LINK_PROGRAM, "glLinkProgram") { miss = miss + 1 }
    if !reg(c, g, F_GET_PROGRAMIV, "glGetProgramiv") { miss = miss + 1 }
    if !reg(c, g, F_GET_PROGRAM_INFO_LOG, "glGetProgramInfoLog") { miss = miss + 1 }
    if !reg(c, g, F_USE_PROGRAM, "glUseProgram") { miss = miss + 1 }
    if !reg(c, g, F_DELETE_PROGRAM, "glDeleteProgram") { miss = miss + 1 }
    if !reg(c, g, F_GET_UNIFORM_LOCATION, "glGetUniformLocation") { miss = miss + 1 }
    if !reg(c, g, F_UNIFORM1I, "glUniform1i") { miss = miss + 1 }
    if !reg(c, g, F_UNIFORM1F, "glUniform1f") { miss = miss + 1 }
    if !reg(c, g, F_UNIFORM2F, "glUniform2f") { miss = miss + 1 }
    if !reg(c, g, F_UNIFORM3F, "glUniform3f") { miss = miss + 1 }
    if !reg(c, g, F_UNIFORM4F, "glUniform4f") { miss = miss + 1 }
    if !reg(c, g, F_UNIFORM_MATRIX4FV, "glUniformMatrix4fv") { miss = miss + 1 }
    if !reg(c, g, F_BIND_ATTRIB_LOCATION, "glBindAttribLocation") { miss = miss + 1 }
    if !reg(c, g, F_DRAW_ELEMENTS_BASE_VERTEX, "glDrawElementsBaseVertex") { miss = miss + 1 }
    if !reg(c, g, F_MULTI_DRAW_ELEMENTS_BASE_VERTEX, "glMultiDrawElementsBaseVertex") { miss = miss + 1 }
    if !reg(c, g, F_COPY_BUFFER_SUB_DATA, "glCopyBufferSubData") { miss = miss + 1 }
    if !reg(c, g, F_TEX_BUFFER, "glTexBuffer") { miss = miss + 1 }
    if !reg(c, g, F_TEX_IMAGE3D, "glTexImage3D") { miss = miss + 1 }
    if !reg(c, g, F_TEX_PARAMETERF, "glTexParameterf") { miss = miss + 1 }
    if !reg(c, g, F_GET_FLOATV, "glGetFloatv") { miss = miss + 1 }
    if !reg(c, g, F_DRAW_ELEMENTS_INSTANCED, "glDrawElementsInstanced") { miss = miss + 1 }
    if !reg(c, g, F_VERTEX_ATTRIB_DIVISOR, "glVertexAttribDivisor") { miss = miss + 1 }
    if !reg(c, g, F_MAP_BUFFER_RANGE, "glMapBufferRange") { miss = miss + 1 }
    if !reg(c, g, F_UNMAP_BUFFER, "glUnmapBuffer") { miss = miss + 1 }
    if !reg(c, g, F_FLUSH_MAPPED_BUFFER_RANGE, "glFlushMappedBufferRange") { miss = miss + 1 }
    if !reg(c, g, F_FENCE_SYNC, "glFenceSync") { miss = miss + 1 }
    if !reg(c, g, F_CLIENT_WAIT_SYNC, "glClientWaitSync") { miss = miss + 1 }
    if !reg(c, g, F_DELETE_SYNC, "glDeleteSync") { miss = miss + 1 }
    (*g).missing = miss
    (*g).ok = false
    if miss > 0 {
        return false
    }
    let vp: u64 = gl_string(g, GL_VERSION)
    if vp == 0 {
        return false
    }
    // "3.3.0 NVIDIA ..." / "4.5 (Core Profile) Mesa ..." : first two numbers
    (*g).major = (rt.ld8(vp, 0) as i32) - 48
    (*g).minor = (rt.ld8(vp, 2) as i32) - 48
    if (*g).major < 3 || ((*g).major == 3 && (*g).minor < 3) {
        return false
    }
    (*g).ok = true
    // optional GL 4.x entry points: only usable when the context version says so too
    let ind: bool = reg(c, g, F_MULTI_DRAW_ELEMENTS_INDIRECT, "glMultiDrawElementsIndirect")
    let sto: bool = reg(c, g, F_BUFFER_STORAGE, "glBufferStorage")
    (*g).has_indirect = ind && ((*g).major > 4 || ((*g).major == 4 && (*g).minor >= 3))
    (*g).has_storage = sto && ((*g).major > 4 || ((*g).major == 4 && (*g).minor >= 4))
    // anisotropic filtering is an extension (core since 4.6): ask for the limit; an unknown enum leaves the value 0
    (*g).tmp[0] = 0 as u32
    gl_get_error(g)
    let mx: f64 = gl_get_float(g, GL_MAX_TEXTURE_MAX_ANISOTROPY)
    if gl_get_error(g) == GL_NO_ERROR && mx > 1.0 {
        (*g).max_aniso = mx
    }
    return true
}

// ---- call helpers ---------------------------------------------------------------------------------------
fn ic(g: *mut Gl, id: usize, sig: str) -> u64 {
    return dynlib.callx((*g).fns[id], sig, (&(*g).args[0]) as u64, false)
}

fn c1(g: *mut Gl, id: usize, a0: u64) -> u64 {
    (*g).args[0] = a0
    return ic(g, id, "i")
}

fn c2(g: *mut Gl, id: usize, a0: u64, a1: u64) -> u64 {
    (*g).args[0] = a0
    (*g).args[1] = a1
    return ic(g, id, "ii")
}

fn c3(g: *mut Gl, id: usize, a0: u64, a1: u64, a2: u64) -> u64 {
    (*g).args[0] = a0
    (*g).args[1] = a1
    (*g).args[2] = a2
    return ic(g, id, "iii")
}

fn c4(g: *mut Gl, id: usize, a0: u64, a1: u64, a2: u64, a3: u64) -> u64 {
    (*g).args[0] = a0
    (*g).args[1] = a1
    (*g).args[2] = a2
    (*g).args[3] = a3
    return ic(g, id, "iiii")
}

fn c5(g: *mut Gl, id: usize, a0: u64, a1: u64, a2: u64, a3: u64, a4: u64) -> u64 {
    (*g).args[0] = a0
    (*g).args[1] = a1
    (*g).args[2] = a2
    (*g).args[3] = a3
    (*g).args[4] = a4
    return ic(g, id, "iiiii")
}

fn c7(g: *mut Gl, id: usize, a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, a6: u64) -> u64 {
    (*g).args[0] = a0
    (*g).args[1] = a1
    (*g).args[2] = a2
    (*g).args[3] = a3
    (*g).args[4] = a4
    (*g).args[5] = a5
    (*g).args[6] = a6
    return ic(g, id, "iiiiiii")
}

fn c9(g: *mut Gl, id: usize, a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, a6: u64, a7: u64, a8: u64) -> u64 {
    (*g).args[0] = a0
    (*g).args[1] = a1
    (*g).args[2] = a2
    (*g).args[3] = a3
    (*g).args[4] = a4
    (*g).args[5] = a5
    (*g).args[6] = a6
    (*g).args[7] = a7
    (*g).args[8] = a8
    return ic(g, id, "iiiiiiiii")
}

fn fb(x: f64) -> u64 {
    return __bits(x as f32) as u64
}

fn m32(v: u64) -> u32 {
    return (v & 0xFFFFFFFF as u64) as u32
}

// ---- state ----------------------------------------------------------------------------------------------
// Address of a NUL-terminated GL string (GL_VERSION, GL_RENDERER, GL_VENDOR); 0 if unavailable.
fn gl_string(g: *mut Gl, name: u32) -> u64 {
    return c1(g, F_GET_STRING, name as u64)
}

fn gl_get_error(g: *mut Gl) -> u32 {
    return m32(c1(g, F_GET_ERROR, 0))
}

fn gl_get_float(g: *mut Gl, pname: u32) -> f64 {
    (*g).tmp[0] = 0 as u32
    c2(g, F_GET_FLOATV, pname as u64, (&(*g).tmp[0]) as u64)
    return (*((&(*g).tmp[0]) as *mut f32)) as f64
}

fn gl_get_int(g: *mut Gl, pname: u32) -> i32 {
    (*g).tmp[0] = 0 as u32
    c2(g, F_GET_INTEGERV, pname as u64, (&(*g).tmp[0]) as u64)
    return (*g).tmp[0] as i32
}

fn gl_viewport(g: *mut Gl, x: i32, y: i32, w: i32, h: i32) {
    c4(g, F_VIEWPORT, x as u64, y as u64, w as u64, h as u64)
}

fn gl_scissor(g: *mut Gl, x: i32, y: i32, w: i32, h: i32) {
    c4(g, F_SCISSOR, x as u64, y as u64, w as u64, h as u64)
}

fn gl_enable(g: *mut Gl, cap: u32) {
    c1(g, F_ENABLE, cap as u64)
}

fn gl_disable(g: *mut Gl, cap: u32) {
    c1(g, F_DISABLE, cap as u64)
}

fn gl_clear(g: *mut Gl, mask: u32) {
    c1(g, F_CLEAR, mask as u64)
}

fn gl_clear_color(g: *mut Gl, r: f64, gr: f64, b: f64, a: f64) {
    (*g).args[0] = fb(r)
    (*g).args[1] = fb(gr)
    (*g).args[2] = fb(b)
    (*g).args[3] = fb(a)
    ic(g, F_CLEAR_COLOR, "ffff")
}

fn gl_depth_func(g: *mut Gl, f: u32) {
    c1(g, F_DEPTH_FUNC, f as u64)
}

fn gl_depth_mask(g: *mut Gl, on: bool) {
    var v: u64 = 0
    if on {
        v = 1
    }
    c1(g, F_DEPTH_MASK, v)
}

fn gl_color_mask(g: *mut Gl, r: bool, gr: bool, b: bool, a: bool) {
    var x0: u64 = 0
    var x1: u64 = 0
    var x2: u64 = 0
    var x3: u64 = 0
    if r { x0 = 1 }
    if gr { x1 = 1 }
    if b { x2 = 1 }
    if a { x3 = 1 }
    c4(g, F_COLOR_MASK, x0, x1, x2, x3)
}

fn gl_cull_face(g: *mut Gl, mode: u32) {
    c1(g, F_CULL_FACE, mode as u64)
}

fn gl_front_face(g: *mut Gl, mode: u32) {
    c1(g, F_FRONT_FACE, mode as u64)
}

fn gl_blend_func(g: *mut Gl, src: u32, dst: u32) {
    c2(g, F_BLEND_FUNC, src as u64, dst as u64)
}

fn gl_pixel_store(g: *mut Gl, pname: u32, v: i32) {
    c2(g, F_PIXEL_STOREI, pname as u64, v as u64)
}

fn gl_finish(g: *mut Gl) {
    c1(g, F_FINISH, 0)
}

fn gl_flush(g: *mut Gl) {
    c1(g, F_FLUSH, 0)
}

// ---- buffers + vertex arrays ----------------------------------------------------------------------------
fn gl_gen_buffer(g: *mut Gl) -> u32 {
    (*g).tmp[0] = 0 as u32
    c2(g, F_GEN_BUFFERS, 1, (&(*g).tmp[0]) as u64)
    return (*g).tmp[0]
}

fn gl_bind_buffer(g: *mut Gl, target: u32, id: u32) {
    c2(g, F_BIND_BUFFER, target as u64, id as u64)
}

// glBufferData: (re)allocates `bytes` and copies from `data` (0 = allocate only).
fn gl_buffer_data(g: *mut Gl, target: u32, data: u64, bytes: usize, usage: u32) {
    c4(g, F_BUFFER_DATA, target as u64, bytes as u64, data, usage as u64)
}

fn gl_buffer_sub_data(g: *mut Gl, target: u32, offset: usize, bytes: usize, data: u64) {
    c4(g, F_BUFFER_SUB_DATA, target as u64, offset as u64, bytes as u64, data)
}

fn gl_delete_buffer(g: *mut Gl, id: u32) {
    (*g).tmp[0] = id
    c2(g, F_DELETE_BUFFERS, 1, (&(*g).tmp[0]) as u64)
}

fn gl_gen_vao(g: *mut Gl) -> u32 {
    (*g).tmp[0] = 0 as u32
    c2(g, F_GEN_VERTEX_ARRAYS, 1, (&(*g).tmp[0]) as u64)
    return (*g).tmp[0]
}

fn gl_bind_vao(g: *mut Gl, id: u32) {
    c1(g, F_BIND_VERTEX_ARRAY, id as u64)
}

fn gl_delete_vao(g: *mut Gl, id: u32) {
    (*g).tmp[0] = id
    c2(g, F_DELETE_VERTEX_ARRAYS, 1, (&(*g).tmp[0]) as u64)
}

fn gl_enable_attrib(g: *mut Gl, idx: u32) {
    c1(g, F_ENABLE_VERTEX_ATTRIB_ARRAY, idx as u64)
}

// Integer attribute (glVertexAttribIPointer): `size` components of `ty` (GL_UNSIGNED_INT ...), reads the bound
// GL_ARRAY_BUFFER at byte `offset`, `stride` bytes per vertex. The mc_mesh vertex is gl_attrib_i(0, 2, GL_UNSIGNED_INT, 8, 0).
fn gl_attrib_i(g: *mut Gl, idx: u32, size: i32, ty: u32, stride: i32, offset: usize) {
    c5(g, F_VERTEX_ATTRIB_IPOINTER, idx as u64, size as u64, ty as u64, stride as u64, offset as u64)
}

fn gl_attrib_f(g: *mut Gl, idx: u32, size: i32, ty: u32, normalized: bool, stride: i32, offset: usize) {
    var n: u64 = 0
    if normalized {
        n = 1
    }
    (*g).args[0] = idx as u64
    (*g).args[1] = size as u64
    (*g).args[2] = ty as u64
    (*g).args[3] = n
    (*g).args[4] = stride as u64
    (*g).args[5] = offset as u64
    ic(g, F_VERTEX_ATTRIB_POINTER, "iiiiii")
}

// ---- textures -------------------------------------------------------------------------------------------
// RGBA8 2D texture from `px` (w*h*4 bytes, row 0 = texture row 0 = the TOP row of a Canvas/Atlas) with the
// given min/mag filter (GL_NEAREST ... GL_LINEAR_MIPMAP_LINEAR; a MIPMAP min filter builds the mipmap chain),
// clamped to the edge. Returns the texture id (0 = failure).
fn gl_tex_rgba8(g: *mut Gl, w: i32, h: i32, px: u64, min_filter: u32, mag_filter: u32) -> u32 {
    (*g).tmp[0] = 0 as u32
    c2(g, F_GEN_TEXTURES, 1, (&(*g).tmp[0]) as u64)
    let id: u32 = (*g).tmp[0]
    if id == 0 as u32 {
        return 0 as u32
    }
    c2(g, F_BIND_TEXTURE, GL_TEXTURE_2D as u64, id as u64)
    gl_pixel_store(g, GL_UNPACK_ALIGNMENT, 1)
    c3(g, F_TEX_PARAMETERI, GL_TEXTURE_2D as u64, GL_TEXTURE_MIN_FILTER as u64, min_filter as u64)
    c3(g, F_TEX_PARAMETERI, GL_TEXTURE_2D as u64, GL_TEXTURE_MAG_FILTER as u64, mag_filter as u64)
    c3(g, F_TEX_PARAMETERI, GL_TEXTURE_2D as u64, GL_TEXTURE_WRAP_S as u64, GL_CLAMP_TO_EDGE as u64)
    c3(g, F_TEX_PARAMETERI, GL_TEXTURE_2D as u64, GL_TEXTURE_WRAP_T as u64, GL_CLAMP_TO_EDGE as u64)
    c9(g, F_TEX_IMAGE2D, GL_TEXTURE_2D as u64, 0, GL_RGBA8 as u64, w as u64, h as u64, 0, GL_RGBA as u64,
        GL_UNSIGNED_BYTE as u64, px)
    if min_filter >= GL_NEAREST_MIPMAP_NEAREST {
        c1(g, F_GENERATE_MIPMAP, GL_TEXTURE_2D as u64)
    }
    return id
}

// Replaces the whole image of texture `id` (same size) and rebuilds the mipmap chain when `mipmap`.
fn gl_tex_update(g: *mut Gl, id: u32, w: i32, h: i32, px: u64, mipmap: bool) {
    c2(g, F_BIND_TEXTURE, GL_TEXTURE_2D as u64, id as u64)
    gl_pixel_store(g, GL_UNPACK_ALIGNMENT, 1)
    c9(g, F_TEX_SUB_IMAGE2D, GL_TEXTURE_2D as u64, 0, 0, 0, w as u64, h as u64, GL_RGBA as u64, GL_UNSIGNED_BYTE as u64, px)
    if mipmap {
        c1(g, F_GENERATE_MIPMAP, GL_TEXTURE_2D as u64)
    }
}

fn gl_bind_tex(g: *mut Gl, unit: u32, id: u32) {
    c1(g, F_ACTIVE_TEXTURE, (GL_TEXTURE0 + unit) as u64)
    c2(g, F_BIND_TEXTURE, GL_TEXTURE_2D as u64, id as u64)
}

fn gl_delete_tex(g: *mut Gl, id: u32) {
    (*g).tmp[0] = id
    c2(g, F_DELETE_TEXTURES, 1, (&(*g).tmp[0]) as u64)
}

// ---- framebuffer object: RGBA8 colour texture + 24-bit depth renderbuffer ----------------------------------
// fbo == 0 in the result: it could not be built (incomplete).
fn gl_fbo_new(g: *mut Gl, w: i32, h: i32) -> Fbo {
    var f: Fbo = Fbo { fbo: 0 as u32, color: 0 as u32, depth: 0 as u32, w: w, h: h }
    f.color = gl_tex_rgba8(g, w, h, 0, GL_NEAREST, GL_NEAREST)
    (*g).tmp[0] = 0 as u32
    c2(g, F_GEN_RENDERBUFFERS, 1, (&(*g).tmp[0]) as u64)
    f.depth = (*g).tmp[0]
    c2(g, F_BIND_RENDERBUFFER, GL_RENDERBUFFER as u64, f.depth as u64)
    c4(g, F_RENDERBUFFER_STORAGE, GL_RENDERBUFFER as u64, GL_DEPTH_COMPONENT24 as u64, w as u64, h as u64)
    (*g).tmp[0] = 0 as u32
    c2(g, F_GEN_FRAMEBUFFERS, 1, (&(*g).tmp[0]) as u64)
    let id: u32 = (*g).tmp[0]
    c2(g, F_BIND_FRAMEBUFFER, GL_FRAMEBUFFER as u64, id as u64)
    c5(g, F_FRAMEBUFFER_TEXTURE2D, GL_FRAMEBUFFER as u64, GL_COLOR_ATTACHMENT0 as u64, GL_TEXTURE_2D as u64, f.color as u64, 0)
    c4(g, F_FRAMEBUFFER_RENDERBUFFER, GL_FRAMEBUFFER as u64, GL_DEPTH_ATTACHMENT as u64, GL_RENDERBUFFER as u64, f.depth as u64)
    if m32(c1(g, F_CHECK_FRAMEBUFFER_STATUS, GL_FRAMEBUFFER as u64)) == GL_FRAMEBUFFER_COMPLETE {
        f.fbo = id
    }
    return f
}

fn gl_fbo_bind(g: *mut Gl, f: *mut Fbo) {
    c2(g, F_BIND_FRAMEBUFFER, GL_FRAMEBUFFER as u64, (*f).fbo as u64)
}

fn gl_fbo_unbind(g: *mut Gl) {
    c2(g, F_BIND_FRAMEBUFFER, GL_FRAMEBUFFER as u64, 0)
}

fn gl_fbo_free(g: *mut Gl, f: *mut Fbo) {
    if (*f).fbo != 0 as u32 {
        (*g).tmp[0] = (*f).fbo
        c2(g, F_DELETE_FRAMEBUFFERS, 1, (&(*g).tmp[0]) as u64)
    }
    if (*f).depth != 0 as u32 {
        (*g).tmp[0] = (*f).depth
        c2(g, F_DELETE_RENDERBUFFERS, 1, (&(*g).tmp[0]) as u64)
    }
    if (*f).color != 0 as u32 {
        gl_delete_tex(g, (*f).color)
    }
    (*f).fbo = 0 as u32
    (*f).color = 0 as u32
    (*f).depth = 0 as u32
}

// ---- shaders + uniforms ---------------------------------------------------------------------------------
// One shader stage out of source text (address, length). 0 = it did not compile; the info log goes to `log`
// (cap bytes, NUL terminated) when log != 0.
#[allow_escape]
fn compile(g: *mut Gl, kind: u32, src: u64, n: usize, log: u64, cap: usize) -> u32 {
    let sh: u32 = m32(c1(g, F_CREATE_SHADER, kind as u64))
    if sh == 0 as u32 {
        return 0 as u32
    }
    var ptrs: [u64; 1] = [src]
    var lens: [i32; 1] = [n as i32]
    c4(g, F_SHADER_SOURCE, sh as u64, 1, (&ptrs[0]) as u64, (&lens[0]) as u64)
    c1(g, F_COMPILE_SHADER, sh as u64)
    (*g).tmp[0] = 0 as u32
    c3(g, F_GET_SHADERIV, sh as u64, GL_COMPILE_STATUS as u64, (&(*g).tmp[0]) as u64)
    if (*g).tmp[0] == 0 as u32 {
        if log != 0 && cap > 1 {
            rt.st8(log, 0, 0 as u8)
            c4(g, F_GET_SHADER_INFO_LOG, sh as u64, (cap - 1) as u64, 0, log)
        }
        c1(g, F_DELETE_SHADER, sh as u64)
        return 0 as u32
    }
    return sh
}

// A program out of a vertex and a fragment shader source (address, length each). `binds`: attribute names are
// bound by `layout(location = N)` in the shader, so nothing else is needed. 0 = failure, with the log in `log`.
fn gl_program(g: *mut Gl, vs: u64, vlen: usize, fs: u64, flen: usize, log: u64, cap: usize) -> u32 {
    let v: u32 = compile(g, GL_VERTEX_SHADER, vs, vlen, log, cap)
    if v == 0 as u32 {
        return 0 as u32
    }
    let f: u32 = compile(g, GL_FRAGMENT_SHADER, fs, flen, log, cap)
    if f == 0 as u32 {
        c1(g, F_DELETE_SHADER, v as u64)
        return 0 as u32
    }
    let p: u32 = m32(c1(g, F_CREATE_PROGRAM, 0))
    c2(g, F_ATTACH_SHADER, p as u64, v as u64)
    c2(g, F_ATTACH_SHADER, p as u64, f as u64)
    c1(g, F_LINK_PROGRAM, p as u64)
    c1(g, F_DELETE_SHADER, v as u64)
    c1(g, F_DELETE_SHADER, f as u64)
    (*g).tmp[0] = 0 as u32
    c3(g, F_GET_PROGRAMIV, p as u64, GL_LINK_STATUS as u64, (&(*g).tmp[0]) as u64)
    if (*g).tmp[0] == 0 as u32 {
        if log != 0 && cap > 1 {
            rt.st8(log, 0, 0 as u8)
            c4(g, F_GET_PROGRAM_INFO_LOG, p as u64, (cap - 1) as u64, 0, log)
        }
        c1(g, F_DELETE_PROGRAM, p as u64)
        return 0 as u32
    }
    return p
}

fn gl_use(g: *mut Gl, p: u32) {
    c1(g, F_USE_PROGRAM, p as u64)
}

fn gl_delete_program(g: *mut Gl, p: u32) {
    c1(g, F_DELETE_PROGRAM, p as u64)
}

// Uniform location by name (-1 = not active in the program).
#[allow_escape]
fn gl_uniform_loc(g: *mut Gl, p: u32, name: str) -> i32 {
    var b: [u8; 128] = [0; 128]
    let n: usize = name.length()
    if n > 126 {
        return 0 - 1
    }
    var i: usize = 0
    while i < n {
        b[i] = name.chars(i)
        i = i + 1
    }
    b[n] = 0 as u8
    return m32(c2(g, F_GET_UNIFORM_LOCATION, p as u64, (&b[0]) as u64)) as i32
}

fn gl_u1i(g: *mut Gl, loc: i32, v: i32) {
    c2(g, F_UNIFORM1I, (loc as u32) as u64, ((v as i64) & (0xFFFFFFFF as i64)) as u64) // negative values are legal
}

fn gl_u1f(g: *mut Gl, loc: i32, x: f64) {
    (*g).args[0] = (loc as u32) as u64
    (*g).args[1] = fb(x)
    ic(g, F_UNIFORM1F, "if")
}

fn gl_u2f(g: *mut Gl, loc: i32, x: f64, y: f64) {
    (*g).args[0] = (loc as u32) as u64
    (*g).args[1] = fb(x)
    (*g).args[2] = fb(y)
    ic(g, F_UNIFORM2F, "iff")
}

fn gl_u3f(g: *mut Gl, loc: i32, x: f64, y: f64, z: f64) {
    (*g).args[0] = (loc as u32) as u64
    (*g).args[1] = fb(x)
    (*g).args[2] = fb(y)
    (*g).args[3] = fb(z)
    ic(g, F_UNIFORM3F, "ifff")
}

fn gl_u4f(g: *mut Gl, loc: i32, x: f64, y: f64, z: f64, w: f64) {
    (*g).args[0] = (loc as u32) as u64
    (*g).args[1] = fb(x)
    (*g).args[2] = fb(y)
    (*g).args[3] = fb(z)
    (*g).args[4] = fb(w)
    ic(g, F_UNIFORM4F, "iffff")
}

// A 4x4 matrix uniform out of 16 f32 at `m32p` (column-major, the layout of mc_math.mat4_to_f32).
fn gl_uniform_mat4(g: *mut Gl, loc: i32, m32p: u64) {
    c4(g, F_UNIFORM_MATRIX4FV, (loc as u32) as u64, 1, 0, m32p)
}

// 16 f64 (column-major, mc_math.Mat4.m) -> 16 f32 at `dst`.
fn gl_mat4_f64_to_f32(src: u64, dst: u64) {
    var i: usize = 0
    while i < 16 {
        *((dst + (i as u64) * (4 as u64)) as *mut f32) = (*((src + (i as u64) * (8 as u64)) as *mut f64)) as f32
        i = i + 1
    }
}

// ---- draw + read back -----------------------------------------------------------------------------------
// glDrawElements from the bound GL_ELEMENT_ARRAY_BUFFER (of the bound VAO): `count` indices of `ty` starting at byte `offset`.
fn gl_draw_elements(g: *mut Gl, mode: u32, count: i32, ty: u32, offset: usize) {
    c4(g, F_DRAW_ELEMENTS, mode as u64, count as u64, ty as u64, offset as u64)
}

fn gl_draw_arrays(g: *mut Gl, mode: u32, first: i32, count: i32) {
    c3(g, F_DRAW_ARRAYS, mode as u64, first as u64, count as u64)
}

// RGBA8 pixels of the bound framebuffer, rows BOTTOM-UP (the GL order), w*h*4 bytes at `out`.
fn gl_read_rgba(g: *mut Gl, x: i32, y: i32, w: i32, h: i32, out: u64) {
    gl_pixel_store(g, GL_PACK_ALIGNMENT, 1)
    c7(g, F_READ_PIXELS, x as u64, y as u64, w as u64, h as u64, GL_RGBA as u64, GL_UNSIGNED_BYTE as u64, out)
}

// The same, rows TOP-DOWN (the order of mc_raster / a Canvas). `tmp` = w*h*4 scratch bytes.
fn gl_read_rgba_top_down(g: *mut Gl, w: i32, h: i32, out: u64, tmp: u64) {
    gl_read_rgba(g, 0, 0, w, h, tmp)
    let row: usize = (w as usize) * 4
    var y: usize = 0
    while y < (h as usize) {
        rt.mem_copy(out + ((((h as usize) - 1 - y) * row) as u64), tmp + ((y * row) as u64), row)
        y = y + 1
    }
}

// ---- pooled world rendering (docs/mc/gpu-world.md): base vertex, multi draw, copy, buffer textures, texture array ----
// glDrawElementsBaseVertex (GL 3.2): like gl_draw_elements, every index gets `base_vertex` added (and gl_VertexID too).
fn gl_draw_elements_bv(g: *mut Gl, mode: u32, count: i32, ty: u32, offset: usize, base_vertex: i32) {
    c5(g, F_DRAW_ELEMENTS_BASE_VERTEX, mode as u64, count as u64, ty as u64, offset as u64, (base_vertex as u32) as u64)
}

// glMultiDrawElementsBaseVertex (GL 3.2): `n` draws in ONE call. counts = n x i32, offsets = n x u64 (byte offsets into
// the bound element buffer, passed as pointers), base_vertex = n x i32 (all addresses of caller memory).
fn gl_multi_draw_elements_bv(g: *mut Gl, mode: u32, counts: u64, ty: u32, offsets: u64, n: i32, base_vertex: u64) {
    (*g).args[0] = mode as u64
    (*g).args[1] = counts
    (*g).args[2] = ty as u64
    (*g).args[3] = offsets
    (*g).args[4] = (n as u32) as u64
    (*g).args[5] = base_vertex
    ic(g, F_MULTI_DRAW_ELEMENTS_BASE_VERTEX, "iiiiii")
}

// glMultiDrawElementsIndirect (GL 4.3, only when gl.has_indirect): `n` commands of 5 x u32 (count, instances, first index,
// base vertex, base instance) read from the bound GL_DRAW_INDIRECT_BUFFER at byte `offset`; stride 0 = tightly packed.
fn gl_multi_draw_indirect(g: *mut Gl, mode: u32, ty: u32, offset: usize, n: i32, stride: i32) {
    c5(g, F_MULTI_DRAW_ELEMENTS_INDIRECT, mode as u64, ty as u64, offset as u64, (n as u32) as u64, (stride as u32) as u64)
}

fn gl_draw_elements_instanced(g: *mut Gl, mode: u32, count: i32, ty: u32, offset: usize, instances: i32) {
    c5(g, F_DRAW_ELEMENTS_INSTANCED, mode as u64, count as u64, ty as u64, offset as u64, (instances as u32) as u64)
}

fn gl_attrib_divisor(g: *mut Gl, idx: u32, divisor: u32) {
    c2(g, F_VERTEX_ATTRIB_DIVISOR, idx as u64, divisor as u64)
}

// glCopyBufferSubData between two buffers (GL_COPY_READ_BUFFER / GL_COPY_WRITE_BUFFER must be bound by the caller).
fn gl_copy_buffer(g: *mut Gl, src_off: usize, dst_off: usize, bytes: usize) {
    c5(g, F_COPY_BUFFER_SUB_DATA, GL_COPY_READ_BUFFER as u64, GL_COPY_WRITE_BUFFER as u64, src_off as u64, dst_off as u64,
        bytes as u64)
}

fn gl_gen_texture(g: *mut Gl) -> u32 {
    (*g).tmp[0] = 0 as u32
    c2(g, F_GEN_TEXTURES, 1, (&(*g).tmp[0]) as u64)
    return (*g).tmp[0]
}

// Binds texture `id` of `target` (GL_TEXTURE_2D, GL_TEXTURE_2D_ARRAY, GL_TEXTURE_BUFFER) to texture unit `unit`.
fn gl_bind_tex_target(g: *mut Gl, unit: u32, target: u32, id: u32) {
    c1(g, F_ACTIVE_TEXTURE, (GL_TEXTURE0 + unit) as u64)
    c2(g, F_BIND_TEXTURE, target as u64, id as u64)
}

// Buffer texture: texture `tex` reads buffer `buf` as `internal` (GL_R32UI, GL_RGBA32F); texelFetch(samplerBuffer, i).
fn gl_tex_buffer(g: *mut Gl, tex: u32, internal: u32, buf: u32) {
    c2(g, F_BIND_TEXTURE, GL_TEXTURE_BUFFER as u64, tex as u64)
    c3(g, F_TEX_BUFFER, GL_TEXTURE_BUFFER as u64, internal as u64, buf as u64)
}

fn gl_tex_param_f(g: *mut Gl, target: u32, pname: u32, v: f64) {
    (*g).args[0] = target as u64
    (*g).args[1] = pname as u64
    (*g).args[2] = fb(v)
    ic(g, F_TEX_PARAMETERF, "iif")
}

// RGBA8 2D ARRAY texture of `layers` layers (w x h each, layer after layer in `px`), wrapping (GL_REPEAT: a greedy quad
// repeats a tile without leaking into the neighbour tile -- the reason to prefer it over an atlas for mipmaps) with the
// given filters (a MIPMAP min filter builds the chain) and anisotropy `aniso` (> 1 and <= gl.max_aniso). 0 = failure.
fn gl_tex_array_rgba8(g: *mut Gl, w: i32, h: i32, layers: i32, px: u64, min_filter: u32, mag_filter: u32, aniso: f64) -> u32 {
    let id: u32 = gl_gen_texture(g)
    if id == 0 as u32 {
        return 0 as u32
    }
    c2(g, F_BIND_TEXTURE, GL_TEXTURE_2D_ARRAY as u64, id as u64)
    gl_pixel_store(g, GL_UNPACK_ALIGNMENT, 1)
    c3(g, F_TEX_PARAMETERI, GL_TEXTURE_2D_ARRAY as u64, GL_TEXTURE_MIN_FILTER as u64, min_filter as u64)
    c3(g, F_TEX_PARAMETERI, GL_TEXTURE_2D_ARRAY as u64, GL_TEXTURE_MAG_FILTER as u64, mag_filter as u64)
    c3(g, F_TEX_PARAMETERI, GL_TEXTURE_2D_ARRAY as u64, GL_TEXTURE_WRAP_S as u64, GL_REPEAT as u64)
    c3(g, F_TEX_PARAMETERI, GL_TEXTURE_2D_ARRAY as u64, GL_TEXTURE_WRAP_T as u64, GL_REPEAT as u64)
    (*g).args[0] = GL_TEXTURE_2D_ARRAY as u64
    (*g).args[1] = 0
    (*g).args[2] = GL_RGBA8 as u64
    (*g).args[3] = (w as u32) as u64
    (*g).args[4] = (h as u32) as u64
    (*g).args[5] = (layers as u32) as u64
    (*g).args[6] = 0
    (*g).args[7] = GL_RGBA as u64
    (*g).args[8] = GL_UNSIGNED_BYTE as u64
    (*g).args[9] = px
    ic(g, F_TEX_IMAGE3D, "iiiiiiiiii")
    if min_filter >= GL_NEAREST_MIPMAP_NEAREST {
        c1(g, F_GENERATE_MIPMAP, GL_TEXTURE_2D_ARRAY as u64)
    }
    if aniso > 1.0 && (*g).max_aniso > 1.0 {
        var a: f64 = aniso
        if a > (*g).max_aniso {
            a = (*g).max_aniso
        }
        gl_tex_param_f(g, GL_TEXTURE_2D_ARRAY, GL_TEXTURE_MAX_ANISOTROPY, a)
    }
    return id
}

// glMapBufferRange (GL 3.0): address of [offset, offset+len) of the bound buffer, 0 = failure. `access` = GL_MAP_* bits.
fn gl_map_range(g: *mut Gl, target: u32, offset: usize, len: usize, access: u32) -> u64 {
    return c4(g, F_MAP_BUFFER_RANGE, target as u64, offset as u64, len as u64, access as u64)
}

fn gl_unmap(g: *mut Gl, target: u32) -> bool {
    return (c1(g, F_UNMAP_BUFFER, target as u64) & 255 as u64) != 0 as u64
}

fn gl_flush_mapped(g: *mut Gl, target: u32, offset: usize, len: usize) {
    c3(g, F_FLUSH_MAPPED_BUFFER_RANGE, target as u64, offset as u64, len as u64)
}

// glBufferStorage (GL 4.4, only when gl.has_storage): immutable storage; with GL_MAP_PERSISTENT_BIT | GL_MAP_COHERENT_BIT
// | GL_MAP_WRITE_BIT it can stay mapped (gl_map_range with the same bits) for the whole run.
fn gl_buffer_storage(g: *mut Gl, target: u32, bytes: usize, data: u64, flags: u32) {
    c4(g, F_BUFFER_STORAGE, target as u64, bytes as u64, data, flags as u64)
}

// Fence after the commands issued so far (GL_SYNC_GPU_COMMANDS_COMPLETE); returns the sync object (0 = failure).
fn gl_fence(g: *mut Gl) -> u64 {
    return c2(g, F_FENCE_SYNC, 0x9117 as u64, 0)
}

// glClientWaitSync with flush: 1 = already signaled, 2 = signaled during the wait, 0 = timeout, 3 = failed.
fn gl_fence_wait(g: *mut Gl, sync: u64, timeout_ns: u64) -> i32 {
    let r: u32 = m32(c3(g, F_CLIENT_WAIT_SYNC, sync, 1 as u64, timeout_ns))
    if r == 0x911A as u32 { return 1 }
    if r == 0x911C as u32 { return 2 }
    if r == 0x911B as u32 { return 0 }
    return 3
}

fn gl_fence_delete(g: *mut Gl, sync: u64) {
    c1(g, F_DELETE_SYNC, sync)
}

// Changes filter + anisotropy of an array texture made by gl_tex_array_rgba8 and rebuilds the mipmap chain when the min
// filter uses mipmaps (the base level is kept; call after the texture exists).
fn gl_tex_array_filter(g: *mut Gl, id: u32, min_filter: u32, mag_filter: u32, aniso: f64) {
    c2(g, F_BIND_TEXTURE, GL_TEXTURE_2D_ARRAY as u64, id as u64)
    c3(g, F_TEX_PARAMETERI, GL_TEXTURE_2D_ARRAY as u64, GL_TEXTURE_MIN_FILTER as u64, min_filter as u64)
    c3(g, F_TEX_PARAMETERI, GL_TEXTURE_2D_ARRAY as u64, GL_TEXTURE_MAG_FILTER as u64, mag_filter as u64)
    if min_filter >= GL_NEAREST_MIPMAP_NEAREST {
        c1(g, F_GENERATE_MIPMAP, GL_TEXTURE_2D_ARRAY as u64)
    }
    var a: f64 = 1.0
    if aniso > 1.0 && (*g).max_aniso > 1.0 {
        a = aniso
        if a > (*g).max_aniso {
            a = (*g).max_aniso
        }
    }
    if (*g).max_aniso > 1.0 {
        gl_tex_param_f(g, GL_TEXTURE_2D_ARRAY, GL_TEXTURE_MAX_ANISOTROPY, a)
    }
}
