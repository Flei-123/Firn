    v[4] = a4
    v[5] = a5
    v[6] = a6
    v[7] = a7
    v[8] = a8
    v[9] = a9
    v[10] = a10
    return win64_call(f, (&v[0]) as u64, 11)
}

fn call12(f: u64, a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, a6: u64, a7: u64, a8: u64, a9: u64, a10: u64, a11: u64) -> u64 {
    if f == 0 {
        return 0
    }
    var v: [u64; 12] = [0; 12]
    v[0] = a0
    v[1] = a1
    v[2] = a2
    v[3] = a3
    v[4] = a4
    v[5] = a5
    v[6] = a6
    v[7] = a7
    v[8] = a8
    v[9] = a9
    v[10] = a10
    v[11] = a11
    return win64_call(f, (&v[0]) as u64, 12)
}

// ---------------------------------------------------------------------
// the loader
// ---------------------------------------------------------------------
// The address of GL function `name` ("glClear", "glCreateShader", an
// extension "glDebugMessageCallback", ...). 0 = not found. GL 1.2+ and
// extensions only resolve while a context is current on this thread.
fn proc(name: str) -> u64 {
    if !init() {
        return 0
    }
    let p: u64 = cname(name)
    if p == 0 {
        return 0
    }
    let a: u64 = call1(G_WPROC, p)
    // wglGetProcAddress answers 0, 1, 2, 3 or -1 for "not there"
    if a > 3 && a != 0xFFFFFFFFFFFFFFFF {
        return a
    }
    return GetProcAddress(G_GL32, p)
}

// Copy a GL string (GL_VERSION = 0x1F02, GL_RENDERER = 0x1F01,
// GL_VENDOR = 0x1F00) into `out` (cap bytes, NUL ended). Returns its length.
fn get_string(name: u32, out: u64, cap: usize) -> usize {
    if cap == 0 || out == 0 {
        return 0
    }
    rt.st8(out, 0, 0 as u8)
    if G_GETSTRING == 0 {
        return 0
    }
    let s: u64 = call1(G_GETSTRING, name as u64)
    if s == 0 {
        return 0
    }
    var n: usize = 0
    while n + 1 < cap {
        let c: u8 = rt.ld8(s, n)
        if c == 0 as u8 {
            break
        }
        rt.st8(out, n, c)
        n = n + 1
    }
    rt.st8(out, n, 0 as u8)
    return n
}

// ---------------------------------------------------------------------
// the context
// ---------------------------------------------------------------------
fn is_open(w: *mut Wgl) -> bool {
    return (*w).ok && (*w).ctx != 0
}

// A double-buffered RGBA8 format with `depth` and `stencil` bits.
fn pick_format(hdc: u64, depth: u32, stencil: u32) -> u32 {
    var pfd: [u8; 40] = [0 as u8; 40]
    let p: u64 = (&pfd[0]) as u64
    rt.st16(p, 0, 40 as u16) // nSize
    rt.st16(p, 1, 1 as u16) // nVersion
    // PFD_DRAW_TO_WINDOW 4 | PFD_SUPPORT_OPENGL 0x20 | PFD_DOUBLEBUFFER 1
    // | PFD_SUPPORT_COMPOSITION 0x8000
    rt.st32(p, 1, 0x8025 as u32)
    pfd[8] = 0 as u8 // PFD_TYPE_RGBA
    pfd[9] = 32 as u8 // cColorBits
    pfd[16] = 8 as u8 // cAlphaBits
    pfd[23] = depth as u8 // cDepthBits
    pfd[24] = stencil as u8 // cStencilBits
    let f: u64 = call2(G_CHOOSE, hdc, p) & 0xFFFFFFFF
    if f == 0 {
        G_ERR = 3 as u32
        return 0 as u32
    }
    if (call3(G_SETFMT, hdc, f, p) & 0xFFFFFFFF) == 0 {
        G_ERR = 4 as u32
        return 0 as u32
    }
    return f as u32
}

fn read_version(w: *mut Wgl) {
    if G_GETINTV == 0 {
        return
    }
    var v: [i32; 2] = [0; 2]
    // GL_MAJOR_VERSION 0x821B, GL_MINOR_VERSION 0x821C (GL 3.0+; an older
    // context leaves the numbers 0 and keeps the GL_VERSION string)
    call2(G_GETINTV, 0x821B, (&v[0]) as u64)
    call2(G_GETINTV, 0x821C, (&v[1]) as u64)
    (*w).major = v[0] as u32
    (*w).minor = v[1] as u32
}

// Make a GL context of at least `major.minor` for the window `hwnd`. `kind`
// is C_CORE (core profile, what GL 3.3 programs want) or C_COMPAT. `depth`
// and `stencil` are bit counts (24 / 8 are the usual). The context is current
// on this thread when this returns true; on false `last_error()` says why.
fn open(w: *mut Wgl, hwnd: u64, major: u32, minor: u32, kind: u32,
    depth: u32, stencil: u32) -> bool {
    *w = wgl_new()
    G_ERR = 0 as u32
    if hwnd == 0 || !init() {
        if G_ERR == 0 as u32 { G_ERR = 2 as u32 }
        return false
    }
    let hdc: u64 = call1(G_GETDC, hwnd)
    if hdc == 0 {
        G_ERR = 2 as u32
        return false
    }
    (*w).hwnd = hwnd
    (*w).hdc = hdc
    let fmt: u32 = pick_format(hdc, depth, stencil)
    if fmt == 0 as u32 {
        call2(G_RELEASEDC, hwnd, hdc)
        (*w).hdc = 0
        return false
    }
    (*w).pixel_format = fmt
    let legacy: u64 = call1(G_WCREATE, hdc)
    if legacy == 0 {
        G_ERR = 5 as u32
        return false
    }
    if (call2(G_WMAKE, hdc, legacy) & 0xFFFFFFFF) == 0 {
        G_ERR = 6 as u32
        call1(G_WDELETE, legacy)
        return false
    }
    // WGL_CONTEXT_MAJOR_VERSION_ARB 0x2091, MINOR 0x2092, PROFILE_MASK 0x9126
    let mk: u64 = proc("wglCreateContextAttribsARB")
    var ctx: u64 = 0
    if mk != 0 {
        var attrs: [i32; 7] = [0; 7]
        attrs[0] = 0x2091
        attrs[1] = major as i32
        attrs[2] = 0x2092
        attrs[3] = minor as i32
        var n: usize = 4
        if kind == C_CORE || kind == C_COMPAT {
            attrs[4] = 0x9126
            if kind == C_CORE { attrs[5] = 1 } else { attrs[5] = 2 }
            n = 6
        }
        attrs[n] = 0
        ctx = call3(mk, hdc, 0, (&attrs[0]) as u64)
    }
    if ctx != 0 {
        if (call2(G_WMAKE, hdc, ctx) & 0xFFFFFFFF) == 0 {
            G_ERR = 6 as u32
            call1(G_WDELETE, ctx)
            ctx = 0
        } else {
            call1(G_WDELETE, legacy)
            (*w).core = kind == C_CORE
        }
    }
    if ctx == 0 {
        // no ARB entry point (or the version was refused): keep the legacy
        // context, if it is good enough
        if major >= 3 as u32 {
            // the program asked for 3.x and the driver said no
            G_ERR = 7 as u32
            call2(G_WMAKE, 0, 0)
            call1(G_WDELETE, legacy)
            return false
        }
        ctx = legacy
    }
    (*w).ctx = ctx
    (*w).swap_fn = proc("wglSwapIntervalEXT")
    read_version(w)
    (*w).ok = true
    return true
}

// The GL context current on this thread (0 = none), e.g. one that
// window.gpu_gl made for a lib/window window.
fn current_context() -> u64 {
    if !init() {
        return 0
    }
    return call0(sym(G_GL32, "wglGetCurrentContext"))
}

fn make_current(w: *mut Wgl) -> bool {
    if (*w).ctx == 0 {
        return false
    }
    return (call2(G_WMAKE, (*w).hdc, (*w).ctx) & 0xFFFFFFFF) != 0
}

fn release_current() {
    if G_WMAKE != 0 {
        call2(G_WMAKE, 0, 0)
    }
}

// Show the finished frame (gdi32 SwapBuffers).
fn swap(w: *mut Wgl) -> bool {
    if (*w).hdc == 0 {
        return false
    }
    return (call1(G_SWAP, (*w).hdc) & 0xFFFFFFFF) != 0
}

// 0 = no vertical sync, 1 = every refresh. False: the driver has no
// WGL_EXT_swap_control.
fn swap_interval(w: *mut Wgl, n: u32) -> bool {
    if (*w).swap_fn == 0 || (*w).ctx == 0 {
        return false
    }
    return (call1((*w).swap_fn, n as u64) & 0xFFFFFFFF) != 0
}

fn close(w: *mut Wgl) {
    if G_WMAKE != 0 {
        call2(G_WMAKE, 0, 0)
    }
    if (*w).ctx != 0 {
        call1(G_WDELETE, (*w).ctx)
    }
    if (*w).hdc != 0 && (*w).hwnd != 0 && G_RELEASEDC != 0 {
        call2(G_RELEASEDC, (*w).hwnd, (*w).hdc)
    }
    *w = wgl_new()
}
