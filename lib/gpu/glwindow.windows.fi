// SPDX-License-Identifier: MPL-2.0
// lib/gpu/glwindow.windows.fi -- gpu.glwindow on Windows (round gpu-a): the twin of lib/gpu/glwindow.fi, same names.
//
//     import gpu.glwindow
//     var g: glwindow.GlWin = glwindow.glwindow_new()
//     if !glwindow.open(&g, 640, 360, "title", glwindow.opts_default()) { ... g.step says what failed ... }
//     while !g.closed { glwindow.pump(&g, 0); if g.resized { glwindow.resize_done(&g) }; ...draw...; glwindow.swap(&g) }
//     glwindow.close(&g)
//
// THE WAY: the window is the Firn window of lib/window (win32 back end: messages, input, DPI, full screen stay
// there); the GL 3.3 core context is the one the window makes for its own HWND (window.gpu_gl -> WGL, lib/gpu/
// wgl.windows.fi, depth 24 / stencil 8). `g.ctx` is a borrowed gpu.glctx context: gl33.gl_load(&g.ctx, &gl) works,
// swap goes through window.gpu_swap. opts.api and opts.display are ignored (there is only WGL).
// TESTED UNDER WINE + MESA ONLY (tools/gpu/win/run.sh, section Wine); real Windows with a real driver: UNTESTED.
import std.dynlib
import window.window
import window.backend
import gpu.glctx

export {
    GlWin, Opts, opts_default, glwindow_new, open, close, make_current, swap, swap_interval, swap_interval_get,
    pump, resize, resize_done, set_fullscreen, is_fullscreen, dpi, surface_size, api_name, take_ctx, viewport,
    API_AUTO, API_EGL, API_GLX, USED_EGL, USED_GLX, USED_WGL,
}

const API_AUTO: i32 = 0
const API_EGL: i32 = 1
const API_GLX: i32 = 2
const USED_EGL: i32 = 1
const USED_GLX: i32 = 2
const USED_WGL: i32 = 3

struct Opts {
    api: i32, // API_AUTO / API_EGL / API_GLX
    vsync: i32, // swap interval to set after opening: 0, 1, or -1 (adaptive, falls back to 1)
    display: usize, // X display number, 0 = $DISPLAY
    full_input: bool, // window.full_input BEFORE make: mouse button releases, motion, raw keys (an own event pump needs it)
}

fn opts_default() -> Opts {
    return Opts { api: 0, vsync: 1, display: 0, full_input: false }
}

struct GlWin {
    ok: bool,
    step: i32, // 0 = ok; 1 no X window, 2 window not made, 3 no GL context (EGL and GLX), 4 interval
    api: i32, // USED_EGL / USED_GLX
    win: window.Window, // the Firn window (events, input, dpi, clipboard ...)
    ctx: glctx.GlCtx, // the GL context on the window; gl33.gl_load(&g.ctx, ...) takes it
    lent: bool, // take_ctx handed the context to a GlBackend: it closes the context
    w: i32, // size of the window's content (pixels)
    h: i32,
    closed: bool, // EV_CLOSED seen
    resized: bool, // EV_CONFIGURE seen since resize_done
    fs: bool,
    f_viewport: u64,
    frames: u64,
    ival: i32, // swap interval in force (0 / 1)
}

fn glwindow_new() -> GlWin {
    return GlWin { ok: false, step: 0, api: 0, win: window.window_new(), ctx: glctx.ctx_blank(), lent: false,
        w: 0, h: 0, closed: false, resized: false, fs: false, f_viewport: 0, frames: 0, ival: 1 }
}

fn api_name(g: *mut GlWin) -> str {
    if (*g).api == 3 {
        return "wgl"
    }
    return "none"
}

// Opens the window and a GL 3.3 core context on it, makes it current, sets the swap interval of `o.vsync`.
fn open(g: *mut GlWin, w: i32, h: i32, title: str, o: Opts) -> bool {
    (*g).ok = false
    if !window.open_window(&(*g).win, o.display) {
        (*g).step = 1
        return false
    }
    if o.full_input {
        window.full_input(&(*g).win, true)
    }
    if !window.make(&(*g).win, w as usize, h as usize) {
        (*g).step = 2
        return false
    }
    window.title(&(*g).win, title.p as u64, title.n)
    window.show_window(&(*g).win)
    (*g).w = window.width(&(*g).win) as i32
    (*g).h = window.height(&(*g).win) as i32
    if !window.gpu_gl(&(*g).win, 3 as u32, 3 as u32, 24 as u32, 8 as u32) {
        (*g).step = 3
        window.close_window(&(*g).win)
        return false
    }
    (*g).ctx = glctx.ctx_borrow()
    if !(*g).ctx.ok {
        (*g).step = 3
        window.gpu_close(&(*g).win)
        window.close_window(&(*g).win)
        return false
    }
    (*g).api = USED_WGL
    (*g).ok = true
    (*g).step = 0
    swap_interval(g, o.vsync)
    return true
}

// Hands the context to a GlBackend (gl_mc.glbe_open_with): the backend's glbe_close closes it, `close` then skips it.
fn take_ctx(g: *mut GlWin) -> glctx.GlCtx {
    (*g).lent = true
    return (*g).ctx
}

fn make_current(g: *mut GlWin) -> bool {
    return window.gpu_gl(&(*g).win, 3 as u32, 3 as u32, 24 as u32, 8 as u32)
}

fn swap(g: *mut GlWin) -> bool {
    (*g).frames = (*g).frames + 1
    return window.gpu_swap(&(*g).win)
}

// Sets the swap interval: 0 = no wait, otherwise (1, -1 adaptive) = vertical blank. WGL has two states here.
// Returns the interval now in force, -99 if the driver cannot (no WGL_EXT_swap_control).
fn swap_interval(g: *mut GlWin, n: i32) -> i32 {
    var on: bool = true
    if n == 0 {
        on = false
    }
    if !window.gpu_vsync(&(*g).win, on) {
        return 0 - 99
    }
    if on {
        (*g).ival = 1
    } else {
        (*g).ival = 0
    }
    return (*g).ival
}

fn swap_interval_get(g: *mut GlWin) -> i32 {
    return (*g).ival
}

// Waits up to `ms` for window events (0 = only look) and handles all of them: EV_CONFIGURE sets w/h/resized,
// EV_CLOSED sets closed. Returns the number of events taken.
fn pump(g: *mut GlWin, ms: i64) -> i32 {
    var n: i32 = 0
    window.wait_event(&(*g).win, ms)
    var k: u32 = window.next_event(&(*g).win)
    while k != window.EV_NONE && n < 10000 {
        n = n + 1
        if k == window.EV_CONFIGURE {
            (*g).w = window.width(&(*g).win) as i32
            (*g).h = window.height(&(*g).win) as i32
            (*g).resized = true
        }
        if k == window.EV_CLOSED {
            (*g).closed = true
        }
        k = window.next_event(&(*g).win)
    }
    return n
}

// glViewport(0, 0, w, h) on the current context.
fn viewport(g: *mut GlWin, w: i32, h: i32) {
    if (*g).f_viewport == 0 {
        (*g).f_viewport = glctx.ctx_proc(&(*g).ctx, "glViewport")
    }
    if (*g).f_viewport == 0 {
        return
    }
    var a: [u64; 8] = [0; 8]
    a[2] = w as u64
    a[3] = h as u64
    dynlib.callx((*g).f_viewport, "iiii", (&a[0]) as u64, false)
}

// After EV_CONFIGURE: the viewport follows the window size. (A GlBackend's FBO has its own size: glbe_resize.)
fn resize_done(g: *mut GlWin) {
    (*g).resized = false
    viewport(g, (*g).w, (*g).h)
}

// Asks the system for a new client size and waits (at most `ms`) for the matching EV_CONFIGURE; then viewport.
// False if the size did not arrive (the window manager may refuse or change it: g.w / g.h hold what we got).
fn resize(g: *mut GlWin, w: i32, h: i32, ms: i64) -> bool {
    if !backend.r_set_size(&(*g).win.p, w as usize, h as usize) {
        return false
    }
    var waited: i64 = 0
    while ((*g).w != w || (*g).h != h) && waited < ms {
        pump(g, 20)
        waited = waited + 20
    }
    resize_done(g)
    return (*g).w == w && (*g).h == h
}

// Full screen request (borderless over the monitor). True = request sent;
// the size arrives as EV_CONFIGURE (pump).
fn set_fullscreen(g: *mut GlWin, on: bool) -> bool {
    let ok: bool = window.fullscreen(&(*g).win, on)
    (*g).fs = on
    return ok
}

fn is_fullscreen(g: *mut GlWin) -> bool {
    return window.is_fullscreen(&(*g).win)
}

fn dpi(g: *mut GlWin) -> usize {
    return window.dpi(&(*g).win)
}

// The size the GL surface has: the client area of the window (WGL has no separate surface).
fn surface_size(g: *mut GlWin, w: *mut i32, h: *mut i32) -> bool {
    *w = window.width(&(*g).win) as i32
    *h = window.height(&(*g).win) as i32
    return true
}

fn close(g: *mut GlWin) {
    if !(*g).lent {
        window.gpu_close(&(*g).win)
    }
    window.close_window(&(*g).win)
    (*g).ok = false
}
