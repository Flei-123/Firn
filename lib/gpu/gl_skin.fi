import std.rt
import gpu.gl33
import gpu.gl_ext
import gpu.gl_prog
import gpu.gl_tex

export { GlSkin, skin_new, skin_open, skin_close, skin_upload, skin_draw }

const SKIN_VS: str = __include_str("gl_skin_vs.glsl")
const SKIN_FS: str = __include_str("gl_skin_fs.glsl")
const REC_F32: usize = 28
const REC_BYTES: usize = 112
const SKIN_W: i32 = 64
const SKIN_H: i32 = 640
const SKIN_UNIT: u32 = 6 as u32

struct GlSkin {
    ok: bool,
    prog: gl_prog.Prog,
    vao: u32,
    inst_vbo: u32,
    tex: u32,
    scratch: u64,
    cap: usize,
}

fn skin_new() -> GlSkin {
    return GlSkin { ok: false, prog: gl_prog.prog_new(), vao: 0 as u32, inst_vbo: 0 as u32, tex: 0 as u32, scratch: 0 as u64, cap: 0 as usize }
}

fn skin_open(s: *mut GlSkin, x: *mut gl_ext.GlX, g: *mut gl33.Gl, cube_vbo: u32, cube_ibo: u32) -> bool {
    if !gl_prog.prog_build(x, &(*s).prog, SKIN_VS.p as u64, SKIN_VS.n, SKIN_FS.p as u64, SKIN_FS.n) { return false }
    (*s).vao = gl33.gl_gen_vao(g)
    gl33.gl_bind_vao(g, (*s).vao)
    gl33.gl_bind_buffer(g, gl33.GL_ARRAY_BUFFER, cube_vbo)
    gl33.gl_enable_attrib(g, 0 as u32)
    gl33.gl_attrib_f(g, 0 as u32, 3, gl33.GL_FLOAT, false, 16, 0)
    gl33.gl_enable_attrib(g, 1 as u32)
    gl33.gl_attrib_f(g, 1 as u32, 1, gl33.GL_FLOAT, false, 16, 12)
    gl33.gl_bind_buffer(g, gl33.GL_ELEMENT_ARRAY_BUFFER, cube_ibo)
    (*s).inst_vbo = gl33.gl_gen_buffer(g)
    gl33.gl_bind_buffer(g, gl33.GL_ARRAY_BUFFER, (*s).inst_vbo)
    gl33.gl_buffer_data(g, gl33.GL_ARRAY_BUFFER, 0, 1024, gl33.GL_STREAM_DRAW)
    var a: u32 = 2 as u32
    while a < 9 as u32 {
        gl33.gl_enable_attrib(g, a)
        gl33.gl_attrib_f(g, a, 4, gl33.GL_FLOAT, false, REC_BYTES as i32, ((a - 2 as u32) as usize) * 16)
        gl33.gl_attrib_divisor(g, a, 1 as u32)
        a = a + 1 as u32
    }
    gl33.gl_bind_vao(g, 0 as u32)
    (*s).ok = (*s).vao != 0 as u32 && (*s).inst_vbo != 0 as u32
    return (*s).ok
}

fn skin_close(s: *mut GlSkin, x: *mut gl_ext.GlX) {
    if (*s).tex != 0 as u32 { gl_tex.tex_free(x, (*s).tex) }
    (*s).tex = 0 as u32
    if (*s).scratch != 0 as u64 { rt.heap_free((*s).scratch, (*s).cap * REC_BYTES) }
    (*s).scratch = 0 as u64
    (*s).cap = 0
}

fn skin_upload(s: *mut GlSkin, x: *mut gl_ext.GlX, px: u64) {
    if !(*s).ok || px == 0 as u64 { return }
    if (*s).tex != 0 as u32 { gl_tex.tex_free(x, (*s).tex) }
    (*s).tex = gl_tex.tex2d_new(x, SKIN_W, SKIN_H, px, false)
}

fn ensure_scratch(s: *mut GlSkin, n: usize) {
    if (*s).cap >= n { return }
    var cap: usize = (*s).cap * 2
    if cap < n { cap = n }
    if cap < 64 { cap = 64 }
    let p: u64 = rt.heap_alloc(cap * REC_BYTES)
    if (*s).scratch != 0 as u64 { rt.heap_free((*s).scratch, (*s).cap * REC_BYTES) }
    (*s).scratch = p
    (*s).cap = cap
}

fn ldf(p: u64, i: usize) -> f32 {
    return *((p + (i as u64) * (4 as u64)) as *mut f32)
}

fn skin_draw(s: *mut GlSkin, x: *mut gl_ext.GlX, g: *mut gl33.Gl, recs: u64, n: usize, rv: u64, cx: f64, cy: f64, cz: f64,
    fog_on: f64, fog_start: f64, fog_end: f64, fr: f64, fg: f64, fb: f64) -> u64 {
    if !(*s).ok || (*s).tex == 0 as u32 || n == 0 { return 0 as u64 }
    ensure_scratch(s, n)
    var i: usize = 0
    while i < n {
        let src: u64 = recs + (i * REC_BYTES) as u64
        let dst: u64 = (*s).scratch + (i * REC_BYTES) as u64
        var k: usize = 0
        while k < REC_F32 {
            *((dst + (k as u64) * (4 as u64)) as *mut f32) = ldf(src, k)
            k = k + 1
        }
        *((dst) as *mut f32) = ((ldf(src, 0) as f64) - cx) as f32
        *((dst + 4 as u64) as *mut f32) = ((ldf(src, 1) as f64) - cy) as f32
        *((dst + 8 as u64) as *mut f32) = ((ldf(src, 2) as f64) - cz) as f32
        i = i + 1
    }
    let p: *mut gl_prog.Prog = &(*s).prog
    gl33.gl_enable(g, gl33.GL_DEPTH_TEST)
    gl33.gl_depth_func(g, gl33.GL_LESS)
    gl33.gl_depth_mask(g, true)
    gl_prog.prog_use(x, p)
    gl_prog.u_mat4(x, p, "u_rv", rv)
    gl_prog.u_4f(x, p, "u_fog", fog_on, fog_start, fog_end, 0.0)
    gl_prog.u_3f(x, p, "u_fogc", fr, fg, fb)
    gl_tex.tex_bind(x, gl_tex.GL_TEXTURE_2D, SKIN_UNIT, (*s).tex)
    gl_prog.u_1i(x, p, "u_skin", SKIN_UNIT as i32)
    gl33.gl_bind_vao(g, (*s).vao)
    gl33.gl_bind_buffer(g, gl33.GL_ARRAY_BUFFER, (*s).inst_vbo)
    gl33.gl_buffer_data(g, gl33.GL_ARRAY_BUFFER, (*s).scratch, n * REC_BYTES, gl33.GL_STREAM_DRAW)
    gl_ext.glx_draw_elements_instanced(x, gl33.GL_TRIANGLES, 36, gl33.GL_UNSIGNED_SHORT, 0, n as i32)
    gl33.gl_bind_vao(g, 0 as u32)
    return n as u64
}
