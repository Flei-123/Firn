extern fn firn_glw_ctx_state() -> i32; // 0 = context alive, 1 = webglcontextlost seen and not yet restored
extern fn firn_glw_ctx_gen() -> i32; // +1 on every webglcontextrestored (all WebGL object ids from before are dead)

// ---- GL constants (the numbers of WebGL2 = GL ES 3.0 = GL 3.3 for these) --------------------------------------
const GL_DEPTH_BUFFER_BIT: i32 = 0x100
const GL_COLOR_BUFFER_BIT: i32 = 0x4000
const GL_TRIANGLES: i32 = 4
const GL_LESS: i32 = 0x201
const GL_DEPTH_TEST: i32 = 0xB71
const GL_CULL_FACE: i32 = 0xB44
const GL_BLEND: i32 = 0xBE2
const GL_SCISSOR_TEST: i32 = 0xC11
const GL_BACK: i32 = 0x405
const GL_CCW: i32 = 0x901
const GL_ARRAY_BUFFER: i32 = 0x8892
const GL_ELEMENT_ARRAY_BUFFER: i32 = 0x8893
const GL_STATIC_DRAW: i32 = 0x88E4
const GL_UNSIGNED_BYTE: i32 = 0x1401
const GL_UNSIGNED_INT: i32 = 0x1405
const GL_RGBA: i32 = 0x1908
const GL_RGBA8: i32 = 0x8058
const GL_TEXTURE_2D: i32 = 0xDE1
const GL_TEXTURE_2D_ARRAY: i32 = 0x8C1A
const GL_MAX_ARRAY_TEXTURE_LAYERS: i32 = 0x88FF
const MAX_PAGES: usize = 4 // atlas pages (texture arrays) the fragment shader can address
const GL_NEAREST: i32 = 0x2600
const GL_TEXTURE_MAG_FILTER: i32 = 0x2800
const GL_TEXTURE_MIN_FILTER: i32 = 0x2801
const GL_TEXTURE_WRAP_S: i32 = 0x2802
const GL_TEXTURE_WRAP_T: i32 = 0x2803
const GL_REPEAT: i32 = 0x2901
const GL_CLAMP_TO_EDGE: i32 = 0x812F
const GL_FRAMEBUFFER: i32 = 0x8D40
const GL_READ_FRAMEBUFFER: i32 = 0x8CA8
const GL_DRAW_FRAMEBUFFER: i32 = 0x8CA9
const GL_RENDERBUFFER: i32 = 0x8D41
const GL_COLOR_ATTACHMENT0: i32 = 0x8CE0
const GL_DEPTH_ATTACHMENT: i32 = 0x8D00
const GL_DEPTH_COMPONENT24: i32 = 0x81A6
const GL_FRAMEBUFFER_COMPLETE: i32 = 0x8CD5
const GL_UNPACK_ALIGNMENT: i32 = 0xCF5
const GL_TEXTURE0: i32 = 0x84C0

// mesh slot (words): vao, vbo, ibo, nidx, used
const SLOT_WORDS: usize = 8
const S_VCOPY: usize = 5 // CPU copy of the vertices (only with keep_meshes, for context restore)
const S_ICOPY: usize = 6
const S_NV: usize = 7
const S_VAO: usize = 0
const S_VBO: usize = 1
const S_IBO: usize = 2
const S_NIDX: usize = 3
const S_USED: usize = 4

struct GlWeb {
    ok: bool,
    step: i32, // 0 = ok, 1 no WebGL2 context, 2 program, 3 framebuffer, 4 memory
    w: i32,
    h: i32,
    prog: i32,
    l_rv: i32,
    l_origin: i32,
    l_atlas: i32,
    l_tiles: i32,
    l_fog: i32,
    l_fogc: i32,
    l_light: i32,
    l_fade: i32, // u_fade = (a, inv, frame height, 0): screen-door of the LOD cross-fade (mc_backend.set_fade)
    fade_a: i32, // 64 = off
    fade_inv: i32,
    fbo: i32,
    color: i32, // RGBA8 texture
    depth: i32, // DEPTH24 renderbuffer
    atlas_tex: i32, // texture array of atlas page 0: layer = tile - 1 (page p holds tiles p*page_layers .. (p+1)*page_layers - 1)
    atlas_x: [i32; 3], // texture arrays of atlas pages 1..3 (only when the atlas has more layers than MAX_ARRAY_TEXTURE_LAYERS)
    n_apages: i32, // atlas pages in use (1..MAX_PAGES)
    page_layers: i32, // layers per page; the shader splits the tile id with it (u_pagel), >= 1048576 = single array
    limit_set: i32, // > 0: test hook, caps the driver layer limit (glweb_set_layer_limit)
    max_layers: i32, // MAX_ARRAY_TEXTURE_LAYERS of the driver (read on the first atlas upload; WebGL2 guarantees 256)
    layers_lost: i32, // layers of the last atlas that did not fit (0 = all uploaded); those tiles read garbage
    l_atlas_x: [i32; 3],
    l_pagel: i32,
    atile: i32,
    acols: i32,
    slots: u64,
    slot_cap: usize,
    cx: f64,
    cy: f64,
    cz: f64,
    rv: [f32; 16],
    fog_on: bool,
    fog_start: f64,
    fog_end: f64,
    fog_r: f64,
    fog_g: f64,
    fog_b: f64,
    day: f64,
    tint_r: f64, tint_g: f64, tint_b: f64,
    cull: bool,
    pix: u64, // w*h*4 bytes, row 0 = top (present)
    tmp: u64,
    fresh: bool, // pix is the finished frame
    cur_vao: i32,
    draws: u64,
    tris: u64,
    calls: u64,
    up_bytes: u64,
    gen: i32, // host context generation this object set was created for
    keep: bool, // keep CPU copies of every mesh (restore after context loss)
    lost_meshes: u32, // meshes dropped by the last glweb_recreate (no CPU copy)
    atlas_src: u64, // the mc_texture.Atlas last given to upload_atlas (must stay alive; re-uploaded on restore)
    log: [u8; 512], // shader / link log of a failed open
}

fn empty(w: i32, h: i32) -> GlWeb {
    return GlWeb { ok: false, step: 0, w: w, h: h, prog: 0, l_rv: 0 - 1, l_origin: 0 - 1, l_atlas: 0 - 1, l_tiles: 0 - 1,
        l_fog: 0 - 1, l_fogc: 0 - 1, l_light: 0 - 1, l_fade: 0 - 1, fade_a: 64, fade_inv: 0, fbo: 0, color: 0, depth: 0, atlas_tex: 0, atlas_x: [0; 3], n_apages: 0, page_layers: 1048576, limit_set: 0, max_layers: 0, layers_lost: 0,
        l_atlas_x: [0 - 1; 3], l_pagel: 0 - 1, atile: 16, acols: 16, slots: 0, slot_cap: 0,
        cx: 0.0, cy: 0.0, cz: 0.0, rv: [0.0 as f32; 16], fog_on: false, fog_start: 0.0, fog_end: 1.0, fog_r: 0.0,
        fog_g: 0.0, fog_b: 0.0, day: 256.0, tint_r: 256.0, tint_g: 224.0, tint_b: 176.0, cull: true, pix: 0, tmp: 0, fresh: false, cur_vao: 0, draws: 0, tris: 0, calls: 0,
        up_bytes: 0, gen: 0, keep: true, lost_meshes: 0, atlas_src: 0, log: [0; 512] }
}

const VS_SRC: str = __include_str("glweb_vs.glsl")
const FS_SRC: str = __include_str("glweb_fs.glsl")

fn uloc(gw: *mut GlWeb, name: str) -> i32 {
    return firn_glw_uniform_location((*gw).prog, name.p as u32, name.n as u32)
}

// (Re)creates colour texture + depth renderbuffer + FBO of w x h. False = incomplete.
fn make_fbo(gw: *mut GlWeb, w: i32, h: i32) -> bool {
    (*gw).color = firn_glw_create_texture()
    firn_glw_bind_texture(GL_TEXTURE_2D, (*gw).color)
    firn_glw_tex_image_2d(GL_TEXTURE_2D, 0, GL_RGBA8, w, h, GL_RGBA, GL_UNSIGNED_BYTE, 0 as u32)
    firn_glw_tex_parameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST)
    firn_glw_tex_parameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST)
    firn_glw_tex_parameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE)
    firn_glw_tex_parameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE)
    (*gw).depth = firn_glw_create_renderbuffer()
    firn_glw_bind_renderbuffer(GL_RENDERBUFFER, (*gw).depth)
    firn_glw_renderbuffer_storage(GL_RENDERBUFFER, GL_DEPTH_COMPONENT24, w, h)
    (*gw).fbo = firn_glw_create_framebuffer()
    firn_glw_bind_framebuffer(GL_FRAMEBUFFER, (*gw).fbo)
    firn_glw_framebuffer_texture_2d(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, (*gw).color, 0)
    firn_glw_framebuffer_renderbuffer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER, (*gw).depth)
    return firn_glw_check_framebuffer_status(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE
}

fn free_fbo(gw: *mut GlWeb) {
    if (*gw).fbo != 0 { firn_glw_delete_framebuffer((*gw).fbo) }
    if (*gw).color != 0 { firn_glw_delete_texture((*gw).color) }
    if (*gw).depth != 0 { firn_glw_delete_renderbuffer((*gw).depth) }
    (*gw).fbo = 0
    (*gw).color = 0
    (*gw).depth = 0
}

// Asks the host for a WebGL2 context on the page's canvas (w x h device pixels), builds program + FBO.
// `ok` false = see `step` (1: the browser has no WebGL2 / blocks it, 2: shader compile or link failed, 3: FBO incomplete).
#[allow_escape]
fn glweb_open(w: i32, h: i32) -> GlWeb {
    var gw: GlWeb = empty(w, h)
    if firn_glw_init(w, h, 0) == 0 {
        gw.step = 1
        return gw
    }
    gw.gen = firn_glw_ctx_gen()
    gw.step = make_gpu_objects(&gw)
    if gw.step != 0 { return gw }
    let n: usize = (w as usize) * (h as usize) * 4
    gw.pix = rt.heap_alloc(n)
    gw.tmp = rt.heap_alloc(n)
    if gw.pix == 0 || gw.tmp == 0 {
        gw.step = 4
        return gw
    }
    gw.ok = true
    return gw
}

// Program + uniform locations + FBO (the objects that die with a lost context). 0 = ok, 2 program, 3 FBO.
fn make_gpu_objects(gw: *mut GlWeb) -> i32 {
    (*gw).prog = firn_glw_program(VS_SRC.p as u32, VS_SRC.n as u32, FS_SRC.p as u32, FS_SRC.n as u32,
        (&(*gw).log[0]) as u32, 512 as u32)
    if (*gw).prog == 0 { return 2 }
    (*gw).l_rv = uloc(gw, "u_rv")
    (*gw).l_origin = uloc(gw, "u_origin")
    (*gw).l_atlas = uloc(gw, "u_atlas")
    (*gw).l_atlas_x[0] = uloc(gw, "u_atlas1")
    (*gw).l_atlas_x[1] = uloc(gw, "u_atlas2")
    (*gw).l_atlas_x[2] = uloc(gw, "u_atlas3")
    (*gw).l_pagel = uloc(gw, "u_pagel")
    (*gw).l_tiles = uloc(gw, "u_tiles")
    (*gw).l_fog = uloc(gw, "u_fog")
    (*gw).l_fogc = uloc(gw, "u_fogc")
    (*gw).l_light = uloc(gw, "u_light")
    (*gw).l_fade = uloc(gw, "u_fade")
    if !make_fbo(gw, (*gw).w, (*gw).h) { return 3 }
    return 0
}

fn glweb_width(gw: *mut GlWeb) -> i32 { return (*gw).w }
fn glweb_height(gw: *mut GlWeb) -> i32 { return (*gw).h }
fn glweb_draws(gw: *mut GlWeb) -> u64 { return (*gw).draws }
fn glweb_tris(gw: *mut GlWeb) -> u64 { return (*gw).tris }
fn glweb_calls(gw: *mut GlWeb) -> u64 { return (*gw).calls }
fn glweb_upload_bytes(gw: *mut GlWeb) -> u64 { return (*gw).up_bytes }
fn glweb_error(gw: *mut GlWeb) -> i32 { return firn_glw_get_error() }
fn glweb_finish(gw: *mut GlWeb) { firn_glw_finish() }

// Light uniforms (see mc_raster.raster_set_light).
fn glweb_set_light(gw: *mut GlWeb, day: i32, tint_r: i32, tint_g: i32, tint_b: i32) {
    (*gw).day = day as f64
    (*gw).tint_r = tint_r as f64
    (*gw).tint_g = tint_g as f64
    (*gw).tint_b = tint_b as f64
}

fn glweb_set_fog(gw: *mut GlWeb, on: bool, start: f64, end: f64, r: u32, g: u32, b: u32) {
    (*gw).fog_on = on
    (*gw).fog_start = start
    (*gw).fog_end = end
    (*gw).fog_r = r as f64
    (*gw).fog_g = g as f64
    (*gw).fog_b = b as f64
}

fn glweb_set_cull(gw: *mut GlWeb, on: bool) {
    (*gw).cull = on
}

// New frame size (canvas resize): FBO and read back buffers are made again; meshes, atlas and program stay.
// The caller adapts its camera (mc_camera aspect) itself. False = the new FBO is incomplete (back end not ok then).
fn glweb_resize(gw: *mut GlWeb, w: i32, h: i32) -> bool {
    if !(*gw).ok || w <= 0 || h <= 0 { return false }
    free_fbo(gw)
    if (*gw).pix != 0 { rt.heap_free((*gw).pix, ((*gw).w as usize) * ((*gw).h as usize) * 4) }
    if (*gw).tmp != 0 { rt.heap_free((*gw).tmp, ((*gw).w as usize) * ((*gw).h as usize) * 4) }
    (*gw).w = w
    (*gw).h = h
    firn_glw_size(w, h)
    (*gw).ok = false
    if !make_fbo(gw, w, h) {
        (*gw).step = 3
        return false
    }
    let n: usize = (w as usize) * (h as usize) * 4
    (*gw).pix = rt.heap_alloc(n)
    (*gw).tmp = rt.heap_alloc(n)
    if (*gw).pix == 0 || (*gw).tmp == 0 {
        (*gw).step = 4
        return false
    }
    (*gw).fresh = false
    (*gw).ok = true
    return true
}

fn glweb_close(gw: *mut GlWeb) {
    if (*gw).slots != 0 {
        var s: usize = 0
        while s < (*gw).slot_cap {
            free_slot(gw, s + 1)
            s = s + 1
        }
        rt.heap_free((*gw).slots, (*gw).slot_cap * SLOT_WORDS * 8)
        (*gw).slots = 0
        (*gw).slot_cap = 0
    }
    free_atlas_pages(gw, true)
    free_fbo(gw)
    if (*gw).prog != 0 { firn_glw_delete_program((*gw).prog) }
    (*gw).prog = 0
    if (*gw).pix != 0 { rt.heap_free((*gw).pix, ((*gw).w as usize) * ((*gw).h as usize) * 4) }
    if (*gw).tmp != 0 { rt.heap_free((*gw).tmp, ((*gw).w as usize) * ((*gw).h as usize) * 4) }
    (*gw).pix = 0
    (*gw).tmp = 0
    (*gw).ok = false
}

// ---- Backend table ---------------------------------------------------------------------------------------------

// Deletes (del) or only forgets (context lost: the host dropped the ids) the atlas page textures.
fn free_atlas_pages(gw: *mut GlWeb, del: bool) {
    if del && (*gw).atlas_tex != 0 { firn_glw_delete_texture((*gw).atlas_tex) }
    (*gw).atlas_tex = 0
    var i: usize = 0
    while i < 3 {
        if del && (*gw).atlas_x[i] != 0 { firn_glw_delete_texture((*gw).atlas_x[i]) }
        (*gw).atlas_x[i] = 0
        i = i + 1
    }
    (*gw).n_apages = 0
}

// The atlas as texture ARRAY(s) (layer = tile - 1), NEAREST, REPEAT -- the same copy loop as gl_mc.fi be_atlas.
// MAX_ARRAY_TEXTURE_LAYERS caps one array (WebGL2 only guarantees 256): a bigger atlas is split into up to MAX_PAGES arrays of
// `page_layers` layers each (tile id t - 1 lives in page (t - 1) / page_layers, layer (t - 1) % page_layers; the fragment shader
// picks the sampler). Only layers beyond MAX_PAGES * limit are lost (glweb_layers_lost).
fn be_atlas(o: u64, a: u64) {
    let gw: *mut GlWeb = o as *mut GlWeb
    let at: *mut mc_texture.Atlas = a as *mut mc_texture.Atlas
    if (*at).px == 0 { return }
    (*gw).atlas_src = a
    free_atlas_pages(gw, true)
    let t: usize = (*at).tile as usize
    let total: usize = ((*at).cols as usize) * ((*at).rows as usize)
    if (*gw).max_layers == 0 {
        (*gw).max_layers = firn_glw_get_int(GL_MAX_ARRAY_TEXTURE_LAYERS)
        if (*gw).max_layers < 256 { (*gw).max_layers = 256 }
    }
    var lim: usize = (*gw).max_layers as usize
    if (*gw).limit_set > 0 && ((*gw).limit_set as usize) < lim { lim = (*gw).limit_set as usize }
    var np: usize = 1
    var pl: usize = total
    if total > lim {
        np = (total + lim - 1) / lim
        pl = lim
        if np > MAX_PAGES { np = MAX_PAGES }
    }
    (*gw).layers_lost = 0
    if total > np * pl { (*gw).layers_lost = (total - np * pl) as i32 }
    let row: usize = t * 4
    let lbytes: usize = t * row
    let stride: usize = ((*at).w as usize) * 4
    firn_glw_active_texture(GL_TEXTURE0)
    var pg: usize = 0
    while pg < np {
        var layers: usize = total - pg * pl
        if layers > pl { layers = pl }
        let buf: u64 = rt.heap_alloc(layers * lbytes)
        if buf == 0 { return }
        var l: usize = 0
        while l < layers {
            let g: usize = pg * pl + l
            let col: usize = g % ((*at).cols as usize)
            let rw: usize = g / ((*at).cols as usize)
            var y: usize = 0
            while y < t {
                rt.mem_copy(buf + (l * lbytes + y * row) as u64, (*at).px + ((rw * t + y) * stride + col * row) as u64, row)
                y = y + 1
            }
            l = l + 1
        }
        let id: i32 = firn_glw_create_texture()
        firn_glw_bind_texture(GL_TEXTURE_2D_ARRAY, id)
        firn_glw_pixel_storei(GL_UNPACK_ALIGNMENT, 1)
        firn_glw_tex_parameteri(GL_TEXTURE_2D_ARRAY, GL_TEXTURE_MIN_FILTER, GL_NEAREST)
        firn_glw_tex_parameteri(GL_TEXTURE_2D_ARRAY, GL_TEXTURE_MAG_FILTER, GL_NEAREST)
        firn_glw_tex_parameteri(GL_TEXTURE_2D_ARRAY, GL_TEXTURE_WRAP_S, GL_REPEAT)
        firn_glw_tex_parameteri(GL_TEXTURE_2D_ARRAY, GL_TEXTURE_WRAP_T, GL_REPEAT)
        firn_glw_tex_image_3d(GL_TEXTURE_2D_ARRAY, 0, GL_RGBA8, (*at).tile, (*at).tile, layers as i32, GL_RGBA, GL_UNSIGNED_BYTE, buf as u32)
        rt.heap_free(buf, layers * lbytes)
        if pg == 0 {
            (*gw).atlas_tex = id
        } else {
            (*gw).atlas_x[pg - 1] = id
        }
        pg = pg + 1
    }
    (*gw).n_apages = np as i32
    if np == 1 {
        (*gw).page_layers = 1048576 // single array: the shader never splits
    } else {
        (*gw).page_layers = pl as i32
    }
    (*gw).atile = (*at).tile
    (*gw).acols = (*at).cols
}

// Test hook: caps the driver's array layer limit (0 = driver limit) so the multi-page path can be exercised on a driver that
// allows thousands of layers. Takes effect on the next upload_atlas.
fn glweb_set_layer_limit(gw: *mut GlWeb, n: i32) { (*gw).limit_set = n }
fn glweb_atlas_pages(gw: *mut GlWeb) -> i32 { return (*gw).n_apages }
fn glweb_layers_lost(gw: *mut GlWeb) -> i32 { return (*gw).layers_lost }
fn glweb_max_layers(gw: *mut GlWeb) -> i32 { return (*gw).max_layers }

// Returns a free slot index (the table grows by doubling), NONE (all ones) on failure.
fn alloc_slot(gw: *mut GlWeb) -> usize {
    var s: usize = 0
    while s < (*gw).slot_cap {
        if rt.ld64((*gw).slots, s * SLOT_WORDS + S_USED) == 0 as u64 { return s }
        s = s + 1
    }
    let ncap: usize = (*gw).slot_cap * 2 + 64
    let ns: u64 = rt.heap_alloc(ncap * SLOT_WORDS * 8)
    if ns == 0 { return 0xFFFFFFFFFFFFFFFF as usize }
    var i: usize = 0
    while i < ncap * SLOT_WORDS {
        var v: u64 = 0
        if i < (*gw).slot_cap * SLOT_WORDS { v = rt.ld64((*gw).slots, i) }
        rt.st64(ns, i, v)
        i = i + 1
    }
    if (*gw).slots != 0 { rt.heap_free((*gw).slots, (*gw).slot_cap * SLOT_WORDS * 8) }
    s = (*gw).slot_cap
    (*gw).slots = ns
    (*gw).slot_cap = ncap
    return s
}

// verts = 2 x u32 per vertex (mc_mesh), idx = u32. Handle = slot + 1, 0 = failed.
fn be_upload(o: u64, key: u64, verts: u64, nverts: usize, idx: u64, nidx: usize) -> usize {
    let gw: *mut GlWeb = o as *mut GlWeb
    let s: usize = alloc_slot(gw)
    if s == 0xFFFFFFFFFFFFFFFF as usize { return 0 }
    let b: usize = s * SLOT_WORDS
    var i: usize = 0
    while i < SLOT_WORDS {
        rt.st64((*gw).slots, b + i, 0 as u64)
        i = i + 1
    }
    if nverts == 0 || nidx == 0 {
        rt.st64((*gw).slots, b + S_USED, 1 as u64) // empty section: nothing to draw
        return s + 1
    }
    if (*gw).keep {
        let vc: u64 = rt.heap_alloc(nverts * 8)
        let ic: u64 = rt.heap_alloc(nidx * 4)
        if vc != 0 && ic != 0 {
            rt.mem_copy(vc, verts, nverts * 8)
            rt.mem_copy(ic, idx, nidx * 4)
            rt.st64((*gw).slots, b + S_VCOPY, vc)
            rt.st64((*gw).slots, b + S_ICOPY, ic)
        } else {
            if vc != 0 { rt.heap_free(vc, nverts * 8) }
            if ic != 0 { rt.heap_free(ic, nidx * 4) }
        }
    }
    rt.st64((*gw).slots, b + S_NV, nverts as u64)
    gpu_mesh(gw, b, verts, nverts, idx, nidx)
    return s + 1
}

// Creates VAO + VBO + IBO of slot word base `b` from CPU data.
fn gpu_mesh(gw: *mut GlWeb, b: usize, verts: u64, nverts: usize, idx: u64, nidx: usize) {
    let vao: i32 = firn_glw_create_vao()
    firn_glw_bind_vao(vao)
    let vbo: i32 = firn_glw_create_buffer()
    firn_glw_bind_buffer(GL_ARRAY_BUFFER, vbo)
    firn_glw_buffer_data(GL_ARRAY_BUFFER, verts as u32, (nverts * 8) as u32, GL_STATIC_DRAW)
    firn_glw_enable_attrib(0)
    firn_glw_attrib_ipointer(0, 2, GL_UNSIGNED_INT, 8, 0)
    let ibo: i32 = firn_glw_create_buffer()
    firn_glw_bind_buffer(GL_ELEMENT_ARRAY_BUFFER, ibo) // recorded in the VAO
    firn_glw_buffer_data(GL_ELEMENT_ARRAY_BUFFER, idx as u32, (nidx * 4) as u32, GL_STATIC_DRAW)
    firn_glw_bind_vao(0)
    (*gw).cur_vao = 0
    rt.st64((*gw).slots, b + S_VAO, vao as u64)
    rt.st64((*gw).slots, b + S_VBO, vbo as u64)
    rt.st64((*gw).slots, b + S_IBO, ibo as u64)
    rt.st64((*gw).slots, b + S_NIDX, nidx as u64)
    rt.st64((*gw).slots, b + S_USED, 1 as u64)
    (*gw).up_bytes = (*gw).up_bytes + ((nverts * 8 + nidx * 4) as u64)
}

fn free_slot(gw: *mut GlWeb, handle: usize) {
    if handle < 1 || handle > (*gw).slot_cap { return }
    let b: usize = (handle - 1) * SLOT_WORDS
    if rt.ld64((*gw).slots, b + S_USED) == 0 as u64 { return }
    let vao: i32 = rt.ld64((*gw).slots, b + S_VAO) as i32
    let vbo: i32 = rt.ld64((*gw).slots, b + S_VBO) as i32
    let ibo: i32 = rt.ld64((*gw).slots, b + S_IBO) as i32
    if vao != 0 { firn_glw_delete_vao(vao) }
    if vbo != 0 { firn_glw_delete_buffer(vbo) }
    if ibo != 0 { firn_glw_delete_buffer(ibo) }
    drop_copies(gw, b)
    rt.st64((*gw).slots, b + S_USED, 0 as u64)
}

fn drop_copies(gw: *mut GlWeb, b: usize) {
    let vc: u64 = rt.ld64((*gw).slots, b + S_VCOPY)
    let ic: u64 = rt.ld64((*gw).slots, b + S_ICOPY)
    let nv: usize = rt.ld64((*gw).slots, b + S_NV) as usize
    let ni: usize = rt.ld64((*gw).slots, b + S_NIDX) as usize
    if vc != 0 { rt.heap_free(vc, nv * 8) }
    if ic != 0 { rt.heap_free(ic, ni * 4) }
    rt.st64((*gw).slots, b + S_VCOPY, 0 as u64)
    rt.st64((*gw).slots, b + S_ICOPY, 0 as u64)
}

fn be_free(o: u64, h: usize) {
    free_slot(o as *mut GlWeb, h)
}

// The voxel pass state (FBO, depth, cull) without clearing.
fn voxel_state(gw: *mut GlWeb) {
    firn_glw_bind_framebuffer(GL_FRAMEBUFFER, (*gw).fbo)
    firn_glw_viewport(0, 0, (*gw).w, (*gw).h)
    firn_glw_disable(GL_BLEND)
    firn_glw_disable(GL_SCISSOR_TEST)
    firn_glw_enable(GL_DEPTH_TEST)
    firn_glw_depth_func(GL_LESS)
    firn_glw_depth_mask(1)
    firn_glw_color_mask(1, 1, 1, 1)
    firn_glw_front_face(GL_CCW)
    if (*gw).cull {
        firn_glw_enable(GL_CULL_FACE)
        firn_glw_cull_face(GL_BACK)
    } else {
        firn_glw_disable(GL_CULL_FACE)
    }
}

// Program, atlas and per-frame uniforms of the voxel pass.
fn voxel_program(gw: *mut GlWeb) {
    firn_glw_use_program((*gw).prog)
    firn_glw_active_texture(GL_TEXTURE0)
    firn_glw_bind_texture(GL_TEXTURE_2D_ARRAY, (*gw).atlas_tex)
    firn_glw_uniform1i((*gw).l_atlas, 0)
    var xi: usize = 0
    while xi < 3 {
        // pages 1..3 on units 3..5; unused samplers point at page 0 (every sampler must hold an array texture of its type)
        var xt: i32 = (*gw).atlas_x[xi]
        if xt == 0 { xt = (*gw).atlas_tex }
        firn_glw_active_texture(GL_TEXTURE0 + 3 + (xi as i32))
        firn_glw_bind_texture(GL_TEXTURE_2D_ARRAY, xt)
        firn_glw_uniform1i((*gw).l_atlas_x[xi], 3 + (xi as i32))
        xi = xi + 1
    }
    firn_glw_active_texture(GL_TEXTURE0)
    firn_glw_uniform1i((*gw).l_pagel, (*gw).page_layers)
    firn_glw_uniform_matrix4fv((*gw).l_rv, ((&(*gw).rv[0]) as u64) as u32)
    firn_glw_uniform2f((*gw).l_tiles, (*gw).atile as f64, (*gw).acols as f64)
    var fogf: f64 = 0.0
    if (*gw).fog_on { fogf = 1.0 }
    firn_glw_uniform4f((*gw).l_fog, fogf, (*gw).fog_start, (*gw).fog_end, 0.0)
    firn_glw_uniform3f((*gw).l_fogc, (*gw).fog_r, (*gw).fog_g, (*gw).fog_b)
    firn_glw_uniform4f((*gw).l_light, (*gw).day, (*gw).tint_r, (*gw).tint_g, (*gw).tint_b)
    apply_fade(gw)
    firn_glw_bind_vao(0)
    (*gw).cur_vao = 0
}

// After another pass (gpu.glweb_scene) drew: voxel state is back, further b.draw calls work (glbe_rebind twin).
fn glweb_rebind(gw: *mut GlWeb) {
    voxel_state(gw)
    voxel_program(gw)
}

fn be_begin(o: u64, cam: u64, rgba: u32) {
    let gw: *mut GlWeb = o as *mut GlWeb
    let c: *mut mc_camera.Camera = cam as *mut mc_camera.Camera
    (*gw).cx = (*c).x
    (*gw).cy = (*c).y
    (*gw).cz = (*c).z
    // projection * view rotation: the camera translation is applied on the CPU per draw (origin)
    var rot: mc_math.Mat4 = (*c).view
    rot.m[12] = 0.0
    rot.m[13] = 0.0
    rot.m[14] = 0.0
    var rv: mc_math.Mat4 = mc_math.Mat4 { m: [0.0; 16] }
    mc_math.mat4_mul(&rv, &(*c).proj, &rot)
    var i: usize = 0
    while i < 16 {
        (*gw).rv[i] = rv.m[i] as f32
        i = i + 1
    }
    voxel_state(gw)
    let r: f64 = ((rgba & 255 as u32) as f64) / 255.0
    let gr: f64 = (((rgba >> 8 as u32) & 255 as u32) as f64) / 255.0
    let b: f64 = (((rgba >> 16 as u32) & 255 as u32) as f64) / 255.0
    let a: f64 = (((rgba >> 24 as u32) & 255 as u32) as f64) / 255.0
    firn_glw_clear_color(r, gr, b, a)
    firn_glw_clear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT)
    voxel_program(gw)
    (*gw).fresh = false
}

fn be_draw(o: u64, h: usize, ox: f64, oy: f64, oz: f64) -> u64 {
    let gw: *mut GlWeb = o as *mut GlWeb
    if h < 1 || h > (*gw).slot_cap { return 0 as u64 }
    let b: usize = (h - 1) * SLOT_WORDS
    if rt.ld64((*gw).slots, b + S_USED) == 0 as u64 { return 0 as u64 }
    let nidx: usize = rt.ld64((*gw).slots, b + S_NIDX) as usize
    if nidx < 3 { return 0 as u64 }
    let t: u64 = (nidx / 3) as u64
    (*gw).draws = (*gw).draws + 1 as u64
    (*gw).tris = (*gw).tris + t
    firn_glw_uniform3f((*gw).l_origin, ox - (*gw).cx, oy - (*gw).cy, oz - (*gw).cz)
    let vao: i32 = rt.ld64((*gw).slots, b + S_VAO) as i32
    if vao != (*gw).cur_vao {
        firn_glw_bind_vao(vao)
        (*gw).cur_vao = vao
    }
    firn_glw_draw_elements(GL_TRIANGLES, nidx as i32, GL_UNSIGNED_INT, 0)
    (*gw).calls = (*gw).calls + 1 as u64
    return t
}

fn be_end(o: u64) {
    let gw: *mut GlWeb = o as *mut GlWeb
    firn_glw_bind_vao(0)
    (*gw).cur_vao = 0
    firn_glw_flush()
}

// Reads the finished frame back (blocks until the GPU is done): w*h*4 bytes RGBA, row 0 = top.
fn be_present(o: u64) -> u64 {
    let gw: *mut GlWeb = o as *mut GlWeb
    if !(*gw).fresh {
        firn_glw_bind_framebuffer(GL_FRAMEBUFFER, (*gw).fbo)
        firn_glw_read_pixels(0, 0, (*gw).w, (*gw).h, (*gw).tmp as u32)
        let row: usize = ((*gw).w as usize) * 4
        var y: usize = 0
        while y < ((*gw).h as usize) {
            rt.mem_copy((*gw).pix + ((((*gw).h as usize) - 1 - y) * row) as u64, (*gw).tmp + (y * row) as u64, row)
            y = y + 1
        }
        (*gw).fresh = true
    }
    return (*gw).pix
}

fn be_read(o: u64, out: u64) {
    let gw: *mut GlWeb = o as *mut GlWeb
    let p: u64 = be_present(o)
    rt.mem_copy(out, p, ((*gw).w as usize) * ((*gw).h as usize) * 4)
}

// The finished frame onto the page's canvas: blitFramebuffer FBO -> default framebuffer, 1:1, no readback.
// Then the host is told (`firn_glw_present`), e.g. to take a snapshot in a test.
fn glweb_show(gw: *mut GlWeb) {
    firn_glw_bind_framebuffer(GL_READ_FRAMEBUFFER, (*gw).fbo)
    firn_glw_bind_framebuffer(GL_DRAW_FRAMEBUFFER, 0)
    firn_glw_blit_framebuffer(0, 0, (*gw).w, (*gw).h, 0, 0, (*gw).w, (*gw).h, GL_COLOR_BUFFER_BIT, GL_NEAREST)
    firn_glw_bind_framebuffer(GL_FRAMEBUFFER, 0)
    firn_glw_present((*gw).w, (*gw).h)
}

// The WebGL2 back end as a mc_backend.Backend table. `gw` must outlive the table.
fn apply_fade(gw: *mut GlWeb) {
    firn_glw_uniform4f((*gw).l_fade, (*gw).fade_a as f64, (*gw).fade_inv as f64, (*gw).h as f64, 0.0)
}

// mc_backend set_fade (same contract as the GL / CPU back ends): draws are immediate here, so only the uniform changes.
fn be_set_fade(o: u64, a: i32, inv: i32) {
    let gw: *mut GlWeb = o as *mut GlWeb
    var v: i32 = a
    if v > 64 { v = 64 }
    if v < 0 { v = 0 }
    var iv: i32 = 0
    if inv != 0 { iv = 1 }
    if v == (*gw).fade_a && (v >= 64 || iv == (*gw).fade_inv) { return }
    (*gw).fade_a = v
    (*gw).fade_inv = iv
    apply_fade(gw)
}

fn be_set_light(o: u64, day: i32, tr: i32, tg: i32, tb: i32) {
    glweb_set_light(o as *mut GlWeb, day, tr, tg, tb)
}

fn glweb_backend(gw: *mut GlWeb) -> mc_backend.Backend {
    var b: mc_backend.Backend = mc_backend.backend_new()
    b.kind = mc_backend.KIND_GL
    b.obj = gw as u64
    b.upload_atlas = be_atlas
    b.mesh_upload = be_upload
    b.mesh_free = be_free
    b.begin = be_begin
    b.draw = be_draw
    b.end = be_end
    b.present = be_present
    b.set_light = be_set_light
    b.set_fade = be_set_fade
    b.read_pixels = be_read
    return b
}

// ---- context loss (webglcontextlost / webglcontextrestored) ---------------------------------------------------
// The host (demos/mcweb/glweb.js) calls preventDefault on `webglcontextlost`, so the browser may restore the context; while
// it is lost every WebGL call of the host is a no-op and `firn_glw_ctx_state` says 1. On `webglcontextrestored` the host
// forgets ALL object ids (they are dead) and raises `firn_glw_ctx_gen`. The frame loop calls glweb_poll_context first:
//     CTX_LOST     skip the frame (nothing is drawn, nothing is uploaded)
//     CTX_RESTORED the context came back and glweb_recreate has rebuilt program, FBO, atlas and the meshes that have a CPU
//                  copy (keep_meshes, default on) -- recreate your own objects too (gpu.glweb_scene: wscene_recreate)
//     CTX_OK       draw
const CTX_OK: i32 = 0
const CTX_LOST: i32 = 1
const CTX_RESTORED: i32 = 2

fn glweb_keep_meshes(gw: *mut GlWeb, on: bool) {
    (*gw).keep = on
}

// Meshes without a CPU copy that the last glweb_recreate had to drop (their handles draw nothing; re-upload them).
fn glweb_lost_meshes(gw: *mut GlWeb) -> u32 {
    return (*gw).lost_meshes
}

fn glweb_fbo(gw: *mut GlWeb) -> i32 {
    return (*gw).fbo
}

// Rebuilds everything that lived in the dead context. The ids in the struct are stale and are NOT deleted (the host dropped them).
fn glweb_recreate(gw: *mut GlWeb) -> bool {
    (*gw).gen = firn_glw_ctx_gen()
    (*gw).prog = 0
    (*gw).fbo = 0
    (*gw).color = 0
    (*gw).depth = 0
    free_atlas_pages(gw, false) // the host dropped the ids of the dead context: just forget them
    (*gw).cur_vao = 0
    (*gw).fresh = false
    (*gw).lost_meshes = 0 as u32
    (*gw).ok = false
    firn_glw_size((*gw).w, (*gw).h)
    let st: i32 = make_gpu_objects(gw)
    if st != 0 {
        (*gw).step = st
        return false
    }
    if (*gw).atlas_src != 0 {
        be_atlas(gw as u64, (*gw).atlas_src)
    }
    var s: usize = 0
    while s < (*gw).slot_cap {
        let b: usize = s * SLOT_WORDS
        if rt.ld64((*gw).slots, b + S_USED) != 0 as u64 && rt.ld64((*gw).slots, b + S_NIDX) != 0 as u64 {
            let vc: u64 = rt.ld64((*gw).slots, b + S_VCOPY)
            let ic: u64 = rt.ld64((*gw).slots, b + S_ICOPY)
            if vc != 0 && ic != 0 {
                gpu_mesh(gw, b, vc, rt.ld64((*gw).slots, b + S_NV) as usize, ic, rt.ld64((*gw).slots, b + S_NIDX) as usize)
            } else {
                rt.st64((*gw).slots, b + S_VAO, 0 as u64)
                rt.st64((*gw).slots, b + S_VBO, 0 as u64)
                rt.st64((*gw).slots, b + S_IBO, 0 as u64)
                rt.st64((*gw).slots, b + S_NIDX, 0 as u64)
                (*gw).lost_meshes = (*gw).lost_meshes + 1 as u32
            }
        }
        s = s + 1
    }
    (*gw).ok = true
    return true
}

fn glweb_poll_context(gw: *mut GlWeb) -> i32 {
    if firn_glw_ctx_state() != 0 { return CTX_LOST }
    if firn_glw_ctx_gen() != (*gw).gen {
        if !glweb_recreate(gw) {
            (*gw).gen = 0 - 1 // try again next poll
            return CTX_LOST
        }
        return CTX_RESTORED
    }
    return CTX_OK
}

// ---- accessors for gpu.glweb_scene ---------------------------------------------------------------------------
fn glweb_fog_on(gw: *mut GlWeb) -> bool { return (*gw).fog_on }
fn glweb_fog_start(gw: *mut GlWeb) -> f64 { return (*gw).fog_start }
fn glweb_fog_end(gw: *mut GlWeb) -> f64 { return (*gw).fog_end }
fn glweb_fog_r(gw: *mut GlWeb) -> f64 { return (*gw).fog_r }
fn glweb_fog_g(gw: *mut GlWeb) -> f64 { return (*gw).fog_g }
fn glweb_fog_b(gw: *mut GlWeb) -> f64 { return (*gw).fog_b }

// The camera of the last begin: projection * view rotation (16 f32 to `rv`) and the position the origins are relative to.
fn glweb_camera_rv(gw: *mut GlWeb, rv: u64, cx: *mut f64, cy: *mut f64, cz: *mut f64) {
    rt.mem_copy(rv, (&(*gw).rv[0]) as u64, 64)
    *cx = (*gw).cx
    *cy = (*gw).cy
    *cz = (*gw).cz
}
