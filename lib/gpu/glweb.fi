extern fn firn_glw_bind_vao(v: i32);
extern fn firn_glw_delete_vao(v: i32);
extern fn firn_glw_enable_attrib(i: i32);
extern fn firn_glw_attrib_ipointer(i: i32, size: i32, ty: i32, stride: i32, off: i32);
