extern fn firn_glw_tex_image_2d(t: i32, l: i32, ifmt: i32, w: i32, h: i32, fmt: i32, ty: i32, p: u32);
extern fn firn_glw_tex_image_3d(t: i32, l: i32, ifmt: i32, w: i32, h: i32, d: i32, fmt: i32, ty: i32, p: u32);
