extern fn firn_glw_blit_framebuffer(sx0: i32, sy0: i32, sx1: i32, sy1: i32, dx0: i32, dy0: i32, dx1: i32, dy1: i32, mask: i32, filter: i32);
extern fn firn_glw_viewport(x: i32, y: i32, w: i32, h: i32);
