// SPDX-License-Identifier: MPL-2.0
// lib/gpu/glweb.fi -- gpu.glweb: the WebGL2 back end of the voxel client (docs/WEBGL2.md).
//
// The browser twin of lib/gpu/gl_mc.fi: the SAME mc_backend.Backend table (upload_atlas / mesh_upload / mesh_free /
// begin / draw / end / present / read_pixels), the same shading arithmetic (integer shading of mc_raster, GLSL ES 3.00
// variants lib/gpu/glweb_vs.glsl + glweb_fs.glsl), the same names with the prefix `glweb_` instead of `glbe_`.
//
//     import gpu.glweb                                  // only for --target=wasm32-browser
//     var gw: glweb.GlWeb = glweb.glweb_open(640, 360)  // WebGL2 context on the page's canvas + FBO + program
//     if gw.ok {
//         var b: mc_backend.Backend = glweb.glweb_backend(&gw)   // same table as gl_mc.glbe_backend
//         b.upload_atlas(b.obj, (&atlas) as u64)
//         b.begin(b.obj, (&cam) as u64, 0xFFE6BE96 as u32)
//         let h: usize = b.mesh_upload(b.obj, key, verts, nverts, idx, nidx)
//         b.draw(b.obj, h, ox, oy, oz)
//         b.end(b.obj)
//         glweb.glweb_show(&gw)                         // FBO -> the canvas (blitFramebuffer, no readback)
//         let px: u64 = b.present(b.obj)                // OR: w*h*4 bytes RGBA, row 0 = top (readPixels)
//     }
//
// HOST CALLS. Every `firn_glw_*` below is answered by demos/mcweb/glweb.js with the WebGL2 call of the same name,
// 1:1 and without logic (objects are small integers on this side, the host keeps the table of WebGL objects; 0 = none /
// the default framebuffer). They are imports of module `env`; a host that does not provide them cannot instantiate the
// program -- this file is for the browser build only, a native program imports gpu.gl_mc instead.
//
// WHAT THIS FILE DOES NOT HAVE (docs/WEBGL2.md section 2): buffer textures, base vertex / multi draw / indirect (no pool
// modes, one VAO + VBO + IBO per section = MODE_LEGACY), mapped buffers, timer queries (an extension, not in the
// prototype), the filtered texture path, MSAA, context loss handling. Camera: u_rv = projection * view rotation, the
// section origin minus the camera position is computed in f64 on the CPU, exactly as in gl_mc.fi.

import std.rt
import mc.mc_backend
import mc.mc_camera
import mc.mc_texture
import mc.mc_math

export {
    GlWeb, glweb_open, glweb_close, glweb_backend, glweb_show, glweb_set_fog, glweb_set_light, glweb_set_cull, glweb_resize,
    glweb_draws, glweb_tris, glweb_finish, glweb_calls, glweb_upload_bytes, glweb_error, glweb_set_layer_limit, glweb_atlas_pages, glweb_layers_lost, glweb_max_layers, glweb_width, glweb_height,
    glweb_camera_rv, glweb_fog_on, glweb_fog_start, glweb_fog_end, glweb_fog_r, glweb_fog_g, glweb_fog_b,
    glweb_rebind, glweb_poll_context, glweb_recreate, glweb_keep_meshes, glweb_lost_meshes, glweb_fbo,
    CTX_OK, CTX_LOST, CTX_RESTORED,
}

// ---- the host (demos/mcweb/glweb.js) --------------------------------------------------------------------------
extern fn firn_glw_init(w: i32, h: i32, flags: i32) -> i32;
extern fn firn_glw_size(w: i32, h: i32);
extern fn firn_glw_program(vp: u32, vn: u32, fp: u32, fnn: u32, lp: u32, lcap: u32) -> i32;
extern fn firn_glw_delete_program(p: i32);
extern fn firn_glw_use_program(p: i32);
extern fn firn_glw_uniform_location(p: i32, np: u32, nn: u32) -> i32;
extern fn firn_glw_uniform1i(l: i32, v: i32);
extern fn firn_glw_uniform2f(l: i32, a: f64, b: f64);
extern fn firn_glw_uniform3f(l: i32, a: f64, b: f64, c: f64);
extern fn firn_glw_uniform4f(l: i32, a: f64, b: f64, c: f64, d: f64);
extern fn firn_glw_uniform_matrix4fv(l: i32, p: u32);
extern fn firn_glw_create_buffer() -> i32;
