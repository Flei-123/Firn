import std.time

export { stat_enable, stat_begin, stat_end, stat_calls, stat_ns }

static mut G_ON: u64 = 0
static mut G_CALLS: u64 = 0
static mut G_NS: u64 = 0

fn stat_enable(on: bool) {
    if on { G_ON = 1 as u64 } else { G_ON = 0 as u64 }
}

fn stat_begin() -> u64 {
    if G_ON == 0 as u64 { return 0 as u64 }
    return time.monotonic_ns()
}

fn stat_end(t0: u64) {
    if G_ON == 0 as u64 { return }
    G_CALLS = G_CALLS + 1 as u64
    G_NS = G_NS + (time.monotonic_ns() - t0)
}

fn stat_calls() -> u64 {
    return G_CALLS
}

fn stat_ns() -> u64 {
    return G_NS
}
