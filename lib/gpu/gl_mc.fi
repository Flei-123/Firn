// SPDX-License-Identifier: MPL-2.0
// lib/gpu/gl_mc.fi -- gpu.gl_mc: the OpenGL 3.3 back end of the voxel client (docs/GPU.md, docs/mc/gpu-world.md).
//
//     import gpu.gl_mc
//     var gb: gl_mc.GlBackend = gl_mc.glbe_open(640, 360)        // EGL / wgl context + FBO + program
//     if gb.ok {
//         var b: mc_backend.Backend = gl_mc.glbe_backend(&gb)    // same table as mc_backend.backend_cpu
//         b.upload_atlas(b.obj, (&atlas) as u64)
//         b.begin(b.obj, (&cam) as u64, 0xFFE6BE96 as u32)
//         let h: usize = b.mesh_upload(b.obj, key, verts, nverts, idx, nidx)
//         b.draw(b.obj, h, ox, oy, oz)
//         b.end(b.obj)
//         let px: u64 = b.present(b.obj)                         // w*h*4 bytes RGBA, row 0 = top
//     }
//
// Rendering goes into an FBO (RGBA8 colour texture + D24); `present` reads it back top-down, so a window layer
// shows the frame exactly like the CPU rasterizer's colour buffer (variant b of docs/FFI.md: Firn window + PutImage).
// Shaders: lib/gpu/mc_vs.glsl + mc_fs.glsl (embedded). Camera: u_rv = projection * view rotation (no translation,
// f64 -> f32), the section origin minus the camera position is computed in f64 on the CPU (small f32 values, no jitter
// far from the world origin). Call from the thread that made the context (docs/FFI.md).
//
// MESH STORAGE / DRAW MODES (glbe_set_mode, before the first upload; default MODE_MULTI):
//   MODE_LEGACY   one VAO + VBO + IBO per section, one glDrawElements per section (the old path, kept as fallback + baseline)
//   MODE_POOL     sections are blocks inside a few big VBO / IBO "pages" (glpool.fi free lists), one
//                 glDrawElementsBaseVertex per section
//   MODE_MULTI    like POOL but all sections of a page in ONE glMultiDrawElementsBaseVertex (the section origin comes from
//                 a buffer texture, see mc_vs.glsl); the draws are collected by `draw` and submitted by `end`
//   MODE_INDIRECT like MULTI with glMultiDrawElementsIndirect (GL >= 4.3, otherwise MULTI)
// Upload: immediate, or with glbe_set_upload_budget(bytes) the mesh data is staged on the CPU and `begin` uploads at most
// `bytes` per frame (a staged section is not drawn until uploaded). glbe_defrag compacts fragmented pages.
// Textures: a texture array (layer = tile - 1). Default NEAREST without mips = the raster's texel fetch;
// glbe_set_filter(mip, aniso) switches to mipmaps + anisotropic filtering.

import std.rt
import mc.mc_backend
import mc.mc_prof
import mc.mc_camera
import mc.mc_texture
import mc.mc_math
import gpu.glctx
import gpu.gl33
import gpu.glpool
import gpu.gl_ext
import gpu.gl_fbo

export {
    GlBackend, glbe_open, glbe_open_with, glbe_close, glbe_backend, glbe_set_fog, glbe_set_light, glbe_set_cull,
    glbe_gl, glbe_renderer, glbe_draws, glbe_tris, glbe_resize, glbe_fbo_texture,
    MODE_LEGACY, MODE_POOL, MODE_MULTI, MODE_INDIRECT,
    glbe_set_mode, glbe_mode, glbe_set_page_verts, glbe_set_upload_budget, glbe_set_filter, glbe_defrag,
    glbe_max_layers, glbe_layers_lost, glbe_set_layer_limit, glbe_atlas_pages, glbe_calls, glbe_tris_submitted, glbe_set_facecull, glbe_upload_bytes, glbe_frame_upload_bytes, glbe_staged, glbe_pages, glbe_pool_used_bytes,
    glbe_pool_cap_bytes, glbe_pool_frag_permille, glbe_defrags, glbe_reset_stats, glbe_flush_uploads,
    // scene layer (lib/gpu/gl_scene.fi): extra passes around the Backend table, MSAA, resolve
    glbe_x, glbe_near, glbe_rebind, glbe_flush, glbe_bind_draw, glbe_set_msaa, glbe_msaa, glbe_resolve, glbe_width, glbe_height, glbe_camera_rv,
}

const MAX_PAGES: usize = 4 // atlas pages (texture arrays) the fragment shader can address
const VS_SRC: str = __include_str("mc_vs.glsl")
const FS_SRC: str = __include_str("mc_fs.glsl")
const MVS_SRC: str = __include_str("mc_model_vs.glsl")
const MFS_SRC: str = __include_str("mc_model_fs.glsl")

const MLOC_RV: usize = 0
const MLOC_ORIGIN: usize = 1
const MLOC_ATLAS: usize = 2
const MLOC_ATLAS1: usize = 3 // 3, 4, 5
const MLOC_PAGEL: usize = 6
const MLOC_TILES: usize = 7
const MLOC_FOG: usize = 8
const MLOC_FOGC: usize = 9
const MLOC_LIGHT: usize = 10
const MLOC_FILTER: usize = 11
const MLOC_TRANS: usize = 12
const MLOC_FADE: usize = 13
const MODE_LEGACY: i32 = 0
const MODE_POOL: i32 = 1
const MODE_MULTI: i32 = 2
const MODE_INDIRECT: i32 = 3

const GRAN: usize = 64 // vertices per granule of a page (the section lookup table of the shader, mc_vs.glsl)
const DEFAULT_PAGE_VERTS: usize = 131072 // first page: 1 MB of vertices + 0.75 MB of indices (a fresh big buffer costs zero-fill time)
const MAX_PAGE_VERTS: usize = 1048576 // later pages grow x4 up to 8 MB + 6 MB
const NONE: usize = 0xFFFFFFFFFFFFFFFF as usize

// mesh slot (words): vao, vbo, ibo (legacy only), nidx, used, key, page, voff, ioff, nverts, staged, stage_v, stage_i, scratch, stamp
const SLOT_WORDS: usize = 24
const S_VAO: usize = 0
const S_VBO: usize = 1
const S_IBO: usize = 2
const S_NIDX: usize = 3
const S_USED: usize = 4
const S_KEY: usize = 5
const S_PAGE: usize = 6
const S_VOFF: usize = 7
const S_IOFF: usize = 8
const S_NV: usize = 9
const S_STAGED: usize = 10
const S_SV: usize = 11
const S_SI: usize = 12
const S_OLDI: usize = 13 // defrag scratch: old index offset
const S_STAMP: usize = 14 // batch number of the last collected draw (a slot drawn twice in one batch splits the batch)
const S_BK: usize = 15 // 1 = the indices are sorted by face direction (glbe_set_facecull), S_BKE.. hold the bucket ends
const S_BKE: usize = 16 // 4 words: bucket ends (index counts, 7 buckets: faces -x +x -y +y -z +z, other), 2 x u32 per word
const FB_N: usize = 7
const S_MODEL: usize = 20 // 0 = voxel mesh, 2 = MESH_MODEL, 3 = MESH_MODEL_T (model quads, own program + float vertices)
const S_MV: usize = 21 // CPU copy of the model vertices (12 f32 per vertex, 4 per quad), for the far-to-near sort of MESH_MODEL_T
const S_MNQ: usize = 22 // quads
const MQW: usize = 30 // f64 per model quad (mc_model_mesh.MQ_WORDS)
const MV_F: usize = 12 // f32 per model vertex

// page (words): vbo, ibo, vao, vertex pool, index pool, granule buffer, granule texture, granule CPU copy, vcap, icap, live
const PAGE_WORDS: usize = 12
const P_VBO: usize = 0
const P_IBO: usize = 1
const P_VAO: usize = 2
const P_VPOOL: usize = 3
const P_IPOOL: usize = 4
const P_GBUF: usize = 5
const P_GTEX: usize = 6
const P_GCPU: usize = 7
const P_VCAP: usize = 8
const P_ICAP: usize = 9
const P_LIVE: usize = 10

struct GlBackend {
    ok: bool,
    step: i32, // 0 = ok, 1 context, 2 GL load, 3 program, 4 framebuffer
    ctx: glctx.GlCtx,
    g: gl33.Gl,
    fbo: gl33.Fbo,
    prog: u32,
    mprog: u32, // model quad program (mc_model_vs/fs.glsl); 0 = not available (model meshes are skipped)
    ml: [i32; 20], // its uniform locations (MLOC_*)
    mcls: i32, // class of the NEXT mesh_upload (mc_backend MESH_*)
    atlas_tex: u32, // texture array of atlas page 0: layer = tile - 1 (page p holds tiles p*page_layers .. (p+1)*page_layers - 1)
    atlas_x: [u32; 3], // texture arrays of atlas pages 1..3 (only when the atlas has more layers than GL_MAX_ARRAY_TEXTURE_LAYERS)
    n_apages: i32, // atlas pages in use (1..MAX_PAGES)
    page_layers: i32, // layers per page; the shader splits the tile id with it (u_pagel)
    limit_set: i32, // > 0: test hook, caps the driver layer limit (glbe_set_layer_limit)
    l_atlas_x: [i32; 3],
    l_pagel: i32,
    l_rv: i32,
    l_origin: i32,
    l_atlas: i32,
    l_tiles: i32,
    l_fog: i32,
    l_fogc: i32,
    l_light: i32,
    l_pool: i32,
    l_gran: i32,
    l_org: i32,
    l_filter: i32,
    l_trans: i32,
    l_fade: i32,
    fade_a: i32, // LOD cross-fade (mc_backend set_fade): 64 = off
    fade_inv: i32,
    trans_pass: bool, // PASS_TRANS is active (blend on, depth write off)
    near: f64, // camera near plane of the last begin (entity culling in gl_scene)
    w: i32,
    h: i32,
    atile: i32,
    acols: i32,
    max_layers: i32, // GL_MAX_ARRAY_TEXTURE_LAYERS of the driver (read on the first atlas upload; GL 3.3 only guarantees 256)
    layers_lost: i32, // layers of the last atlas that did not fit (0 = all uploaded); those tiles read the last layer
    cx: f64,
    cy: f64,
    cz: f64,
    rv: [f32; 16],
    fog_on: bool,
    fog_start: f64,
    fog_end: f64,
    fog_r: f64,
    fog_g: f64,
    fog_b: f64,
    day: f64, // sky light multiplier 0..256
    tint_r: f64, tint_g: f64, tint_b: f64, // block light tint 0..256
    cull: bool,
    slots: u64,
    slot_cap: usize,
    pix: u64, // w*h*4, the read back frame
    tmp: u64, // w*h*4 scratch of the flip
    fresh: bool, // pix holds the current frame
    draws: u64, // logical section draws
    tris: u64,
    calls: u64, // GL draw calls really issued
    log: [u8; 512], // shader / link log of a failed open
    // ---- pool
    mode: i32,
    page_verts: usize,
    pages: u64,
    npages: usize,
    page_cap: usize,
    cur_vao: u32,
    defrags: u64,
    // ---- multi draw: origins per slot (buffer texture) + the draws of the frame
    org_cpu: u64, // f32 x 4 per slot
    org_buf: u32,
    org_tex: u32,
    org_cap: usize,
    org_max: usize,
    pend: u64, // slot index per collected draw
    pend_n: usize,
    pend_cap: usize,
    sc_counts: u64, // scratch: i32 per draw
    sc_offs: u64, // scratch: u64 per draw (byte offset into the index buffer)
    sc_bv: u64, // scratch: i32 per draw (base vertex); indirect: 5 x u32 per draw
    ind_buf: u32,
    facecull: bool, // sort the indices of opaque meshes by face direction; draw only the directions that can face the camera
    up_keep: bool, // the next uploads keep their index order (MESH_TRANS)
    tris_sub: u64, // triangles really submitted (after the face buckets), glbe_tris_submitted
    batch: u64, // batch counter (see S_STAMP)
    // ---- textures
    mip: bool,
    aniso: f64,
    // ---- upload
    budget: usize, // bytes per frame, 0 = immediate
    staged: usize,
    up_bytes: u64,
    frame_up: u64,
    // ---- extension table (gl_ext: instancing, queries, MSAA) + multisample target
    x: gl_ext.GlX,
    xok: bool,
    msaa: i32, // samples in force (0 = off)
    mt: gl_fbo.Target, // multisample draw target (colour renderbuffer + D24 renderbuffer); resolved into `fbo`
    dirty: bool, // an MSAA frame was drawn and not resolved yet
}

fn empty(c: glctx.GlCtx, w: i32, h: i32) -> GlBackend {
    return GlBackend { ok: false, step: 0, ctx: c, g: gl33.gl_new(),
        fbo: gl33.Fbo { fbo: 0 as u32, color: 0 as u32, depth: 0 as u32, w: w, h: h },
        prog: 0 as u32, mprog: 0 as u32, ml: [0 - 1; 20], mcls: 0, atlas_tex: 0 as u32, atlas_x: [0 as u32; 3], n_apages: 0, page_layers: 1048576, limit_set: 0, l_atlas_x: [0 - 1; 3], l_pagel: 0 - 1, l_rv: 0 - 1, l_origin: 0 - 1, l_atlas: 0 - 1, l_tiles: 0 - 1, l_fog: 0 - 1,
        l_fogc: 0 - 1, l_light: 0 - 1, l_pool: 0 - 1, l_gran: 0 - 1, l_org: 0 - 1, l_filter: 0 - 1, l_trans: 0 - 1, l_fade: 0 - 1, fade_a: 64, fade_inv: 0, trans_pass: false, near: 0.05,
        w: w, h: h, atile: 16, acols: 16, max_layers: 0, layers_lost: 0, cx: 0.0, cy: 0.0, cz: 0.0, rv: [0.0 as f32; 16],
        fog_on: false, fog_start: 0.0, fog_end: 1.0, fog_r: 0.0, fog_g: 0.0, fog_b: 0.0, day: 256.0, tint_r: 256.0, tint_g: 224.0, tint_b: 176.0, cull: true,
        slots: 0, slot_cap: 0, pix: 0, tmp: 0, fresh: false, draws: 0, tris: 0, calls: 0, log: [0; 512],
        mode: MODE_MULTI, page_verts: DEFAULT_PAGE_VERTS, pages: 0, npages: 0, page_cap: 0, cur_vao: 0 as u32, defrags: 0,
        org_cpu: 0, org_buf: 0 as u32, org_tex: 0 as u32, org_cap: 0, org_max: 0, pend: 0, pend_n: 0, pend_cap: 0,
        sc_counts: 0, sc_offs: 0, sc_bv: 0, ind_buf: 0 as u32, facecull: false, up_keep: false, tris_sub: 0 as u64, batch: 1 as u64, mip: false, aniso: 1.0, budget: 0, staged: 0,
        up_bytes: 0, frame_up: 0, x: gl_ext.glx_new(), xok: false, msaa: 0,
        mt: gl_fbo.Target { ok: false, w: w, h: h, n_color: 1, depth_mode: gl_fbo.DEPTH_RENDERBUFFER, samples: 0, fbo: 0 as u32,
            rfbo: 0 as u32, color: [0 as u32; 4], msrb: [0 as u32; 4], depth_tex: 0 as u32, depth_rb: 0 as u32 }, dirty: false }
}

// Opens a headless context (EGL surfaceless / pbuffer on Linux, a hidden window + wgl on Windows) of w x h and
// builds the program + FBO. `ok` false = see `step` and `log` (glbe_renderer is empty then).
fn glbe_open(w: i32, h: i32) -> GlBackend {
    return glbe_open_with(glctx.ctx_open(w, h), w, h)
}

// The same on a context the caller already made (it must be current on this thread).
#[allow_escape]
fn glbe_open_with(c: glctx.GlCtx, w: i32, h: i32) -> GlBackend {
    var gb: GlBackend = empty(c, w, h)
    if !gb.ctx.ok {
        gb.step = 1
        return gb
    }
    if !gl33.gl_load(&gb.ctx, &gb.g) {
        gb.step = 2
        return gb
    }
    gb.xok = gl_ext.glx_load(&gb.ctx, &gb.x)
    gb.prog = gl33.gl_program(&gb.g, VS_SRC.p as u64, VS_SRC.n, FS_SRC.p as u64, FS_SRC.n, (&gb.log[0]) as u64, 512)
    if gb.prog == 0 as u32 {
        gb.step = 3
        return gb
    }
    gb.l_rv = gl33.gl_uniform_loc(&gb.g, gb.prog, "u_rv")
    gb.l_origin = gl33.gl_uniform_loc(&gb.g, gb.prog, "u_origin")
    gb.l_atlas = gl33.gl_uniform_loc(&gb.g, gb.prog, "u_atlas")
    gb.l_tiles = gl33.gl_uniform_loc(&gb.g, gb.prog, "u_tiles")
    gb.l_atlas_x[0] = gl33.gl_uniform_loc(&gb.g, gb.prog, "u_atlas1")
    gb.l_atlas_x[1] = gl33.gl_uniform_loc(&gb.g, gb.prog, "u_atlas2")
    gb.l_atlas_x[2] = gl33.gl_uniform_loc(&gb.g, gb.prog, "u_atlas3")
    gb.l_pagel = gl33.gl_uniform_loc(&gb.g, gb.prog, "u_pagel")
    gb.l_fog = gl33.gl_uniform_loc(&gb.g, gb.prog, "u_fog")
    gb.l_fogc = gl33.gl_uniform_loc(&gb.g, gb.prog, "u_fogc")
    gb.l_light = gl33.gl_uniform_loc(&gb.g, gb.prog, "u_light")
    gb.l_pool = gl33.gl_uniform_loc(&gb.g, gb.prog, "u_pool")
    gb.l_gran = gl33.gl_uniform_loc(&gb.g, gb.prog, "u_gran")
    gb.l_org = gl33.gl_uniform_loc(&gb.g, gb.prog, "u_org")
    gb.l_filter = gl33.gl_uniform_loc(&gb.g, gb.prog, "u_filter")
    gb.l_trans = gl33.gl_uniform_loc(&gb.g, gb.prog, "u_trans")
    gb.l_fade = gl33.gl_uniform_loc(&gb.g, gb.prog, "u_fade")
    // model quad program: optional (a failed build only disables MESH_MODEL on this back end)
    gb.mprog = gl33.gl_program(&gb.g, MVS_SRC.p as u64, MVS_SRC.n, MFS_SRC.p as u64, MFS_SRC.n, (&gb.log[0]) as u64, 512)
    if gb.mprog != 0 as u32 {
        gb.ml[MLOC_RV] = gl33.gl_uniform_loc(&gb.g, gb.mprog, "u_rv")
        gb.ml[MLOC_ORIGIN] = gl33.gl_uniform_loc(&gb.g, gb.mprog, "u_origin")
        gb.ml[MLOC_ATLAS] = gl33.gl_uniform_loc(&gb.g, gb.mprog, "u_atlas")
        gb.ml[MLOC_ATLAS1] = gl33.gl_uniform_loc(&gb.g, gb.mprog, "u_atlas1")
        gb.ml[MLOC_ATLAS1 + 1] = gl33.gl_uniform_loc(&gb.g, gb.mprog, "u_atlas2")
        gb.ml[MLOC_ATLAS1 + 2] = gl33.gl_uniform_loc(&gb.g, gb.mprog, "u_atlas3")
        gb.ml[MLOC_PAGEL] = gl33.gl_uniform_loc(&gb.g, gb.mprog, "u_pagel")
        gb.ml[MLOC_TILES] = gl33.gl_uniform_loc(&gb.g, gb.mprog, "u_tiles")
        gb.ml[MLOC_FOG] = gl33.gl_uniform_loc(&gb.g, gb.mprog, "u_fog")
        gb.ml[MLOC_FOGC] = gl33.gl_uniform_loc(&gb.g, gb.mprog, "u_fogc")
        gb.ml[MLOC_LIGHT] = gl33.gl_uniform_loc(&gb.g, gb.mprog, "u_light")
        gb.ml[MLOC_FILTER] = gl33.gl_uniform_loc(&gb.g, gb.mprog, "u_filter")
        gb.ml[MLOC_TRANS] = gl33.gl_uniform_loc(&gb.g, gb.mprog, "u_trans")
        gb.ml[MLOC_FADE] = gl33.gl_uniform_loc(&gb.g, gb.mprog, "u_fade")
    }
    gb.fbo = gl33.gl_fbo_new(&gb.g, w, h)
    if gb.fbo.fbo == 0 as u32 {
        gb.step = 4
        return gb
    }
    let n: usize = (w as usize) * (h as usize) * 4
    gb.pix = rt.heap_alloc(n)
    gb.tmp = rt.heap_alloc(n)
    if gb.pix == 0 || gb.tmp == 0 {
        gb.step = 4
        return gb
    }
    gb.ok = true
    return gb
}

fn glbe_gl(gb: *mut GlBackend) -> *mut gl33.Gl {
    return &(*gb).g
}

// GL_RENDERER of the context ("llvmpipe ...", the GPU name) as a C string address.
fn glbe_renderer(gb: *mut GlBackend) -> u64 {
    return gl33.gl_string(&(*gb).g, gl33.GL_RENDERER)
}

fn glbe_draws(gb: *mut GlBackend) -> u64 {
    return (*gb).draws
}

fn glbe_tris(gb: *mut GlBackend) -> u64 {
    return (*gb).tris
}

// GL draw calls really issued (MODE_MULTI: one per page and frame; LEGACY / POOL: one per section).
// Triangles really handed to GL (with glbe_set_facecull: only the face directions that can face the camera).
fn glbe_tris_submitted(gb: *mut GlBackend) -> u64 {
    return (*gb).tris_sub
}

// Face buckets (MODE_MULTI / MODE_INDIRECT, GL back-face culling on): opaque meshes uploaded afterwards are sorted by face direction
// (stable) and a section draws only the directions whose face plane the camera is in front of. The image is the same as
// with GL back-face culling (those triangles would be culled anyway), the vertex shader and the setup skip them. Off by default.
fn glbe_set_facecull(gb: *mut GlBackend, on: bool) {
    (*gb).facecull = on
}

fn be_mesh_class(o: u64, c: i32) {
    let gb: *mut GlBackend = o as *mut GlBackend
    (*gb).up_keep = c != 0
    (*gb).mcls = c
}

fn glbe_calls(gb: *mut GlBackend) -> u64 {
    return (*gb).calls
}

fn glbe_upload_bytes(gb: *mut GlBackend) -> u64 {
    return (*gb).up_bytes
}

// Bytes uploaded by the last begin / flush (the budget counter of the current frame).
fn glbe_frame_upload_bytes(gb: *mut GlBackend) -> u64 {
    return (*gb).frame_up
}

// Sections staged on the CPU, not yet uploaded (upload budget).
fn glbe_staged(gb: *mut GlBackend) -> usize {
    return (*gb).staged
}

fn glbe_pages(gb: *mut GlBackend) -> usize {
    return (*gb).npages
}

fn glbe_defrags(gb: *mut GlBackend) -> u64 {
    return (*gb).defrags
}

fn glbe_reset_stats(gb: *mut GlBackend) {
    (*gb).draws = 0 as u64
    (*gb).tris_sub = 0 as u64
    (*gb).tris = 0 as u64
    (*gb).calls = 0 as u64
    (*gb).up_bytes = 0 as u64
}

fn glbe_mode(gb: *mut GlBackend) -> i32 {
    return (*gb).mode
}

fn live_slots(gb: *mut GlBackend) -> usize {
    var n: usize = 0
    var s: usize = 0
    while s < (*gb).slot_cap {
        if rt.ld64((*gb).slots, s * SLOT_WORDS + S_USED) != 0 as u64 {
            n = n + 1
        }
        s = s + 1
    }
    return n
}

// Chooses the storage / draw mode. Only allowed while no section is uploaded; MODE_INDIRECT needs GL >= 4.3 and becomes
// MODE_MULTI otherwise. Returns the mode that is now active.
fn glbe_set_mode(gb: *mut GlBackend, mode: i32) -> i32 {
    if live_slots(gb) != 0 {
        return (*gb).mode
    }
    var m: i32 = mode
    if m < MODE_LEGACY {
        m = MODE_LEGACY
    }
    if m > MODE_INDIRECT {
        m = MODE_INDIRECT
    }
    if m == MODE_INDIRECT && !(*gb).g.has_indirect {
        m = MODE_MULTI
    }
    (*gb).mode = m
    return m
}

// Vertices per page (default 1048576 = 8 MB); before the first upload. Rounded down to a multiple of 64, minimum 4096.
fn glbe_set_page_verts(gb: *mut GlBackend, n: usize) {
    if (*gb).npages != 0 {
        return
    }
    var v: usize = (n / GRAN) * GRAN
    if v < 4096 {
        v = 4096
    }
    (*gb).page_verts = v
}

// 0 = upload at once; else `begin` uploads at most this many bytes of staged sections per frame.
fn glbe_set_upload_budget(gb: *mut GlBackend, bytes: usize) {
    (*gb).budget = bytes
}

// mip = mipmaps (+ cut-out at alpha 0.5 on the filtered sample); aniso >= 2 = anisotropic filtering (limited by the
// driver, gl.max_aniso). (false, 1.0) = the raster-exact texel fetch.
fn glbe_set_filter(gb: *mut GlBackend, mip: bool, aniso: f64) {
    (*gb).mip = mip
    (*gb).aniso = aniso
    if (*gb).atlas_tex != 0 as u32 {
        apply_filter(gb)
    }
}

fn filtered(gb: *mut GlBackend) -> bool {
    return (*gb).mip || (*gb).aniso > 1.0
}

fn apply_filter(gb: *mut GlBackend) {
    var minf: u32 = gl33.GL_NEAREST
    var magf: u32 = gl33.GL_NEAREST
    if (*gb).mip {
        minf = gl33.GL_LINEAR_MIPMAP_LINEAR
    } else if (*gb).aniso > 1.0 {
        minf = gl33.GL_LINEAR
    }
    if (*gb).aniso > 1.0 {
        magf = gl33.GL_LINEAR
    }
    gl33.gl_tex_array_filter(&(*gb).g, (*gb).atlas_tex, minf, magf, (*gb).aniso)
    var i: usize = 0
    while i < 3 {
        if (*gb).atlas_x[i] != 0 as u32 {
            gl33.gl_tex_array_filter(&(*gb).g, (*gb).atlas_x[i], minf, magf, (*gb).aniso)
        }
        i = i + 1
    }
}

// Light uniforms (same meaning as mc_raster.raster_set_light): day 0..256, block light tint per channel 0..256.
fn glbe_set_light(gb: *mut GlBackend, day: i32, tint_r: i32, tint_g: i32, tint_b: i32) {
    (*gb).day = day as f64
    (*gb).tint_r = tint_r as f64
    (*gb).tint_g = tint_g as f64
    (*gb).tint_b = tint_b as f64
}

fn glbe_set_fog(gb: *mut GlBackend, on: bool, start: f64, end: f64, r: u32, g: u32, b: u32) {
    (*gb).fog_on = on
    (*gb).fog_start = start
    (*gb).fog_end = end
    (*gb).fog_r = r as f64
    (*gb).fog_g = g as f64
    (*gb).fog_b = b as f64
}

fn glbe_set_cull(gb: *mut GlBackend, on: bool) {
    (*gb).cull = on
}

// New frame size (window resize): the FBO and the read back buffers are made again; meshes, atlas and program stay.
// The caller adapts its camera (mc_camera aspect) itself. False = the new FBO is incomplete (backend not ok then).
fn glbe_resize(gb: *mut GlBackend, w: i32, h: i32) -> bool {
    if !(*gb).ok || w <= 0 || h <= 0 {
        return false
    }
    gl33.gl_fbo_free(&(*gb).g, &(*gb).fbo)
    (*gb).fbo = gl33.gl_fbo_new(&(*gb).g, w, h)
    if (*gb).fbo.fbo == 0 as u32 {
        (*gb).ok = false
        return false
    }
    let on: usize = ((*gb).w as usize) * ((*gb).h as usize) * 4
    rt.heap_free((*gb).pix, on)
    rt.heap_free((*gb).tmp, on)
    let n: usize = (w as usize) * (h as usize) * 4
    (*gb).pix = rt.heap_alloc(n)
    (*gb).tmp = rt.heap_alloc(n)
    (*gb).w = w
    (*gb).h = h
    (*gb).fresh = false
    (*gb).dirty = false
    if (*gb).msaa > 0 {
        if !gl_fbo.target_resize(&(*gb).x, &(*gb).mt, w, h) {
            (*gb).msaa = 0
        }
    }
    return (*gb).pix != 0 && (*gb).tmp != 0
}

// The colour texture of the frame (bottom row first): glshow.show_draw(.., flip = false) puts it into a window
// without read back.
fn glbe_fbo_texture(gb: *mut GlBackend) -> u32 {
    glbe_resolve(gb)
    return (*gb).fbo.color
}

fn glbe_close(gb: *mut GlBackend) {
    if (*gb).ctx.ok {
        var s: usize = 0
        while s < (*gb).slot_cap {
            free_slot(gb, s + 1)
            s = s + 1
        }
        var p: usize = 0
        while p < (*gb).npages {
            page_destroy(gb, p)
            p = p + 1
        }
        if (*gb).org_buf != 0 as u32 {
            gl33.gl_delete_buffer(&(*gb).g, (*gb).org_buf)
        }
        if (*gb).org_tex != 0 as u32 {
            gl33.gl_delete_tex(&(*gb).g, (*gb).org_tex)
        }
        if (*gb).ind_buf != 0 as u32 {
            gl33.gl_delete_buffer(&(*gb).g, (*gb).ind_buf)
        }
        free_atlas_pages(gb)
        if (*gb).prog != 0 as u32 {
            gl33.gl_delete_program(&(*gb).g, (*gb).prog)
        }
        if (*gb).mprog != 0 as u32 {
            gl33.gl_delete_program(&(*gb).g, (*gb).mprog)
        }
        if (*gb).msaa > 0 {
            gl_fbo.target_free(&(*gb).x, &(*gb).mt)
            (*gb).msaa = 0
        }
        gl33.gl_fbo_free(&(*gb).g, &(*gb).fbo)
        glctx.ctx_close(&(*gb).ctx)
    }
    let n: usize = ((*gb).w as usize) * ((*gb).h as usize) * 4
    if (*gb).pix != 0 {
        rt.heap_free((*gb).pix, n)
    }
    if (*gb).tmp != 0 {
        rt.heap_free((*gb).tmp, n)
    }
    if (*gb).slots != 0 {
        rt.heap_free((*gb).slots, (*gb).slot_cap * SLOT_WORDS * 8)
    }
    if (*gb).pages != 0 {
        rt.heap_free((*gb).pages, (*gb).page_cap * PAGE_WORDS * 8)
    }
    if (*gb).org_cpu != 0 {
        rt.heap_free((*gb).org_cpu, (*gb).org_cap * 16)
    }
    if (*gb).pend != 0 {
        rt.heap_free((*gb).pend, (*gb).pend_cap * 8)
        rt.heap_free((*gb).sc_counts, (*gb).pend_cap * FB_N * 4)
        rt.heap_free((*gb).sc_offs, (*gb).pend_cap * FB_N * 8)
        rt.heap_free((*gb).sc_bv, (*gb).pend_cap * FB_N * 20)
    }
    (*gb).pix = 0
    (*gb).tmp = 0
    (*gb).slots = 0
    (*gb).slot_cap = 0
    (*gb).pages = 0
    (*gb).npages = 0
    (*gb).org_cpu = 0
    (*gb).pend = 0
    (*gb).ok = false
}

// ---- pages (pool storage) ---------------------------------------------------------------------------

fn pw(gb: *mut GlBackend, p: usize, w: usize) -> u64 {
    return rt.ld64((*gb).pages, p * PAGE_WORDS + w)
}

fn pset(gb: *mut GlBackend, p: usize, w: usize, v: u64) {
    rt.st64((*gb).pages, p * PAGE_WORDS + w, v)
}

// (Re)points the page's VAO at its VBO / IBO.
fn page_bind_vao(gb: *mut GlBackend, p: usize) {
    let g: *mut gl33.Gl = &(*gb).g
    gl33.gl_bind_vao(g, pw(gb, p, P_VAO) as u32)
    gl33.gl_bind_buffer(g, gl33.GL_ARRAY_BUFFER, pw(gb, p, P_VBO) as u32)
    gl33.gl_enable_attrib(g, 0 as u32)
    gl33.gl_attrib_i(g, 0 as u32, 2, gl33.GL_UNSIGNED_INT, 8, 0)
    gl33.gl_bind_buffer(g, gl33.GL_ELEMENT_ARRAY_BUFFER, pw(gb, p, P_IBO) as u32)
    gl33.gl_bind_vao(g, 0 as u32)
    (*gb).cur_vao = 0 as u32
}

// New empty page of vcap vertices and icap indices. Returns its number or NONE.
fn page_new(gb: *mut GlBackend, vcap: usize, icap: usize) -> usize {
    if (*gb).npages == (*gb).page_cap {
        let ncap: usize = (*gb).page_cap * 2 + 4
        let np: u64 = rt.heap_alloc(ncap * PAGE_WORDS * 8)
        if np == 0 {
            return NONE
        }
        var i: usize = 0
        while i < ncap * PAGE_WORDS {
            var v: u64 = 0
            if i < (*gb).page_cap * PAGE_WORDS {
                v = rt.ld64((*gb).pages, i)
            }
            rt.st64(np, i, v)
            i = i + 1
        }
        if (*gb).pages != 0 {
            rt.heap_free((*gb).pages, (*gb).page_cap * PAGE_WORDS * 8)
        }
        (*gb).pages = np
        (*gb).page_cap = ncap
    }
    let p: usize = (*gb).npages
    let vpool: u64 = glpool.pool_new(vcap, GRAN)
    let ipool: u64 = glpool.pool_new(icap, 1)
    let ng: usize = vcap / GRAN
    let gcpu: u64 = rt.heap_alloc(ng * 4)
    if vpool == 0 || ipool == 0 || gcpu == 0 {
        return NONE
    }
    rt.mem_set(gcpu, 0 as u8, ng * 4)
    let g: *mut gl33.Gl = &(*gb).g
    let vbo: u32 = gl33.gl_gen_buffer(g)
    gl33.gl_bind_buffer(g, gl33.GL_COPY_WRITE_BUFFER, vbo)
    gl33.gl_buffer_data(g, gl33.GL_COPY_WRITE_BUFFER, 0, vcap * 8, gl33.GL_STATIC_DRAW)
    let ibo: u32 = gl33.gl_gen_buffer(g)
    gl33.gl_bind_buffer(g, gl33.GL_COPY_WRITE_BUFFER, ibo)
    gl33.gl_buffer_data(g, gl33.GL_COPY_WRITE_BUFFER, 0, icap * 4, gl33.GL_STATIC_DRAW)
    let gbuf: u32 = gl33.gl_gen_buffer(g)
    gl33.gl_bind_buffer(g, gl33.GL_COPY_WRITE_BUFFER, gbuf)
    gl33.gl_buffer_data(g, gl33.GL_COPY_WRITE_BUFFER, gcpu, ng * 4, gl33.GL_DYNAMIC_DRAW)
    let gtex: u32 = gl33.gl_gen_texture(g)
    gl33.gl_tex_buffer(g, gtex, gl33.GL_R32UI, gbuf)
    let vao: u32 = gl33.gl_gen_vao(g)
    pset(gb, p, P_VBO, vbo as u64)
    pset(gb, p, P_IBO, ibo as u64)
    pset(gb, p, P_VAO, vao as u64)
    pset(gb, p, P_VPOOL, vpool)
    pset(gb, p, P_IPOOL, ipool)
    pset(gb, p, P_GBUF, gbuf as u64)
    pset(gb, p, P_GTEX, gtex as u64)
    pset(gb, p, P_GCPU, gcpu)
    pset(gb, p, P_VCAP, vcap as u64)
    pset(gb, p, P_ICAP, icap as u64)
    pset(gb, p, P_LIVE, 0 as u64)
    page_bind_vao(gb, p)
    (*gb).npages = p + 1
    return p
}

fn page_destroy(gb: *mut GlBackend, p: usize) {
    let g: *mut gl33.Gl = &(*gb).g
    gl33.gl_delete_vao(g, pw(gb, p, P_VAO) as u32)
    gl33.gl_delete_buffer(g, pw(gb, p, P_VBO) as u32)
    gl33.gl_delete_buffer(g, pw(gb, p, P_IBO) as u32)
    gl33.gl_delete_buffer(g, pw(gb, p, P_GBUF) as u32)
    gl33.gl_delete_tex(g, pw(gb, p, P_GTEX) as u32)
    glpool.pool_destroy(pw(gb, p, P_VPOOL))
    glpool.pool_destroy(pw(gb, p, P_IPOOL))
    rt.heap_free(pw(gb, p, P_GCPU), ((pw(gb, p, P_VCAP) as usize) / GRAN) * 4)
}

// Writes granules [first, first+n) of the CPU copy to the GL buffer.
fn gran_upload(gb: *mut GlBackend, p: usize, first: usize, n: usize) {
    let g: *mut gl33.Gl = &(*gb).g
    gl33.gl_bind_buffer(g, gl33.GL_COPY_WRITE_BUFFER, pw(gb, p, P_GBUF) as u32)
    gl33.gl_buffer_sub_data(g, gl33.GL_COPY_WRITE_BUFFER, first * 4, n * 4, pw(gb, p, P_GCPU) + (first * 4) as u64)
}

fn gran_set(gb: *mut GlBackend, p: usize, voff: usize, nverts: usize, slot: usize) {
    let first: usize = voff / GRAN
    let n: usize = (nverts + GRAN - 1) / GRAN
    var i: usize = 0
    while i < n {
        rt.st32(pw(gb, p, P_GCPU), first + i, slot as u32)
        i = i + 1
    }
    gran_upload(gb, p, first, n)
}

// Tries to give slot `s` (nverts / nidx) a block in page p. Returns true and sets page / offsets.
fn page_place(gb: *mut GlBackend, p: usize, s: usize, nverts: usize, nidx: usize) -> bool {
    let vp: u64 = pw(gb, p, P_VPOOL)
    let ip: u64 = pw(gb, p, P_IPOOL)
    let vo: usize = glpool.pool_alloc(vp, nverts)
    if vo == NONE {
        return false
    }
    let io: usize = glpool.pool_alloc(ip, nidx)
    if io == NONE {
        glpool.pool_free(vp, vo, nverts)
        return false
    }
    let b: usize = s * SLOT_WORDS
    rt.st64((*gb).slots, b + S_PAGE, p as u64)
    rt.st64((*gb).slots, b + S_VOFF, vo as u64)
    rt.st64((*gb).slots, b + S_IOFF, io as u64)
    rt.st64((*gb).slots, b + S_NV, nverts as u64)
    pset(gb, p, P_LIVE, pw(gb, p, P_LIVE) + 1 as u64)
    gran_set(gb, p, vo, nverts, s)
    return true
}

// Compacts page p: new buffers, live blocks copied back to back (glCopyBufferSubData), slots / granules / VAO updated.
// Returns false if something failed (the page is left as it was).
// Live pool section of page p?
fn in_page(gb: *mut GlBackend, s: usize, p: usize) -> bool {
    let b: usize = s * SLOT_WORDS
    if rt.ld64((*gb).slots, b + S_USED) == 0 as u64 {
        return false
    }
    if rt.ld64((*gb).slots, b + S_PAGE) != p as u64 {
        return false
    }
    return rt.ld64((*gb).slots, b + S_NIDX) != 0 as u64 && rt.ld64((*gb).slots, b + S_NV) != 0 as u64
}

fn page_defrag(gb: *mut GlBackend, p: usize) -> bool {
    let g: *mut gl33.Gl = &(*gb).g
    let vcap: usize = pw(gb, p, P_VCAP) as usize
    let icap: usize = pw(gb, p, P_ICAP) as usize
    let old_v: u32 = pw(gb, p, P_VBO) as u32
    let old_i: u32 = pw(gb, p, P_IBO) as u32
    let nv: u32 = gl33.gl_gen_buffer(g)
    gl33.gl_bind_buffer(g, gl33.GL_COPY_WRITE_BUFFER, nv)
    gl33.gl_buffer_data(g, gl33.GL_COPY_WRITE_BUFFER, 0, vcap * 8, gl33.GL_STATIC_DRAW)
    let ni: u32 = gl33.gl_gen_buffer(g)
    gl33.gl_bind_buffer(g, gl33.GL_COPY_WRITE_BUFFER, ni)
    gl33.gl_buffer_data(g, gl33.GL_COPY_WRITE_BUFFER, 0, icap * 4, gl33.GL_STATIC_DRAW)
    let vp: u64 = pw(gb, p, P_VPOOL)
    let ip: u64 = pw(gb, p, P_IPOOL)
    glpool.pool_free_all(vp)
    glpool.pool_free_all(ip)
    gl33.gl_bind_buffer(g, gl33.GL_COPY_READ_BUFFER, old_v)
    gl33.gl_bind_buffer(g, gl33.GL_COPY_WRITE_BUFFER, nv)
    var s: usize = 0
    while s < (*gb).slot_cap {
        let b: usize = s * SLOT_WORDS
        if in_page(gb, s, p) {
            let nvv: usize = rt.ld64((*gb).slots, b + S_NV) as usize
            let nidx: usize = rt.ld64((*gb).slots, b + S_NIDX) as usize
            let ov: usize = rt.ld64((*gb).slots, b + S_VOFF) as usize
            let vo: usize = glpool.pool_alloc(vp, nvv)
            let io: usize = glpool.pool_alloc(ip, nidx)
            if vo == NONE || io == NONE {
                return false // cannot happen: the live blocks fit into an empty page of the same size
            }
            if rt.ld64((*gb).slots, b + S_STAGED) == 0 as u64 {
                gl33.gl_copy_buffer(g, ov * 8, vo * 8, nvv * 8)
            }
            rt.st64((*gb).slots, b + S_VOFF, vo as u64)
            // index copy is done below (second pass over the same slots in the same order)
            rt.st64((*gb).slots, b + S_OLDI, rt.ld64((*gb).slots, b + S_IOFF)) // spare word: old index offset
            rt.st64((*gb).slots, b + S_IOFF, io as u64)
        }
        s = s + 1
    }
    gl33.gl_bind_buffer(g, gl33.GL_COPY_READ_BUFFER, old_i)
    gl33.gl_bind_buffer(g, gl33.GL_COPY_WRITE_BUFFER, ni)
    s = 0
    while s < (*gb).slot_cap {
        let b: usize = s * SLOT_WORDS
        if in_page(gb, s, p) {
            if rt.ld64((*gb).slots, b + S_STAGED) == 0 as u64 {
                let oi: usize = rt.ld64((*gb).slots, b + S_OLDI) as usize
                let ni2: usize = rt.ld64((*gb).slots, b + S_IOFF) as usize
                let nidx: usize = rt.ld64((*gb).slots, b + S_NIDX) as usize
                gl33.gl_copy_buffer(g, oi * 4, ni2 * 4, nidx * 4)
            }
            gran_set_cpu(gb, p, rt.ld64((*gb).slots, b + S_VOFF) as usize, rt.ld64((*gb).slots, b + S_NV) as usize, s)
        }
        s = s + 1
    }
    gl33.gl_delete_buffer(g, old_v)
    gl33.gl_delete_buffer(g, old_i)
    pset(gb, p, P_VBO, nv as u64)
    pset(gb, p, P_IBO, ni as u64)
    page_bind_vao(gb, p)
    gran_upload(gb, p, 0, vcap / GRAN)
    (*gb).defrags = (*gb).defrags + 1 as u64
    return true
}

fn gran_set_cpu(gb: *mut GlBackend, p: usize, voff: usize, nverts: usize, slot: usize) {
    let first: usize = voff / GRAN
    let n: usize = (nverts + GRAN - 1) / GRAN
    var i: usize = 0
    while i < n {
        rt.st32(pw(gb, p, P_GCPU), first + i, slot as u32)
        i = i + 1
    }
}

// Compacts every page whose free space is fragmented by at least `min_permille` (1/1000 of the free units not in the
// largest free block). Returns the number of pages rebuilt.
fn glbe_defrag(gb: *mut GlBackend, min_permille: usize) -> usize {
    var n: usize = 0
    var p: usize = 0
    while p < (*gb).npages {
        let fv: usize = glpool.pool_frag_permille(pw(gb, p, P_VPOOL))
        let fi: usize = glpool.pool_frag_permille(pw(gb, p, P_IPOOL))
        if fv >= min_permille || fi >= min_permille {
            if glpool.pool_free_total(pw(gb, p, P_VPOOL)) > 0 && page_defrag(gb, p) {
                n = n + 1
            }
        }
        p = p + 1
    }
    return n
}

// Finds room for slot s: first page that fits; else defrag a page that has enough free units but too fragmented; else a new page.
fn place_slot(gb: *mut GlBackend, s: usize, nverts: usize, nidx: usize) -> bool {
    var p: usize = 0
    while p < (*gb).npages {
        if page_place(gb, p, s, nverts, nidx) {
            return true
        }
        p = p + 1
    }
    p = 0
    while p < (*gb).npages {
        let vp: u64 = pw(gb, p, P_VPOOL)
        let ip: u64 = pw(gb, p, P_IPOOL)
        let room: bool = glpool.pool_free_total(vp) >= nverts + GRAN && glpool.pool_free_total(ip) >= nidx
        let split: bool = glpool.pool_largest(vp) < nverts || glpool.pool_largest(ip) < nidx
        if room && split {
            if page_defrag(gb, p) && page_place(gb, p, s, nverts, nidx) {
                return true
            }
        }
        p = p + 1
    }
    var vcap: usize = (*gb).page_verts
    if vcap == DEFAULT_PAGE_VERTS && (*gb).npages > 0 {
        // default sizing: every further page is 4x the previous (capped), so small worlds never pay for a huge buffer
        vcap = DEFAULT_PAGE_VERTS
        var k: usize = 0
        while k < (*gb).npages && vcap < MAX_PAGE_VERTS {
            vcap = vcap * 4
            k = k + 1
        }
        if vcap > MAX_PAGE_VERTS {
            vcap = MAX_PAGE_VERTS
        }
    }
    if vcap < nverts + GRAN {
        vcap = ((nverts + GRAN - 1) / GRAN) * GRAN
    }
    var icap: usize = (vcap / 4) * 6
    if icap < nidx {
        icap = nidx
    }
    let np: usize = page_new(gb, vcap, icap)
    if np == NONE {
        return false
    }
    return page_place(gb, np, s, nverts, nidx)
}

fn glbe_pool_used_bytes(gb: *mut GlBackend) -> usize {
    var n: usize = 0
    var p: usize = 0
    while p < (*gb).npages {
        n = n + glpool.pool_used(pw(gb, p, P_VPOOL)) * 8 + glpool.pool_used(pw(gb, p, P_IPOOL)) * 4
        p = p + 1
    }
    return n
}

fn glbe_pool_cap_bytes(gb: *mut GlBackend) -> usize {
    var n: usize = 0
    var p: usize = 0
    while p < (*gb).npages {
        n = n + glpool.pool_cap(pw(gb, p, P_VPOOL)) * 8 + glpool.pool_cap(pw(gb, p, P_IPOOL)) * 4
        p = p + 1
    }
    return n
}

// Worst fragmentation of any page's vertex pool, 1/1000.
fn glbe_pool_frag_permille(gb: *mut GlBackend) -> usize {
    var m: usize = 0
    var p: usize = 0
    while p < (*gb).npages {
        let f: usize = glpool.pool_frag_permille(pw(gb, p, P_VPOOL))
        if f > m {
            m = f
        }
        p = p + 1
    }
    return m
}

// ---- Backend table ----------------------------------------------------------------------------------

// Texture array(s) out of the atlas: layer l = tile l + 1 (col = l % cols, row = l / cols), tile x tile texels.
// GL_MAX_ARRAY_TEXTURE_LAYERS (GL 3.3 only guarantees 256) caps one array: a bigger atlas is split into up to MAX_PAGES arrays of
// `page_layers` layers each (tile id t - 1 lives in page (t - 1) / page_layers, layer (t - 1) % page_layers; the fragment shader picks
// the sampler). Only layers beyond MAX_PAGES * limit are lost (glbe_layers_lost; those tiles read garbage).
fn be_atlas(o: u64, a: u64) {
    let gb: *mut GlBackend = o as *mut GlBackend
    let at: *mut mc_texture.Atlas = a as *mut mc_texture.Atlas
    if (*at).px == 0 {
        return
    }
    free_atlas_pages(gb)
    let t: usize = (*at).tile as usize
    let total: usize = ((*at).cols as usize) * ((*at).rows as usize)
    if (*gb).max_layers == 0 {
        (*gb).max_layers = gl33.gl_get_int(&(*gb).g, 0x88FF as u32)
        if (*gb).max_layers < 256 { (*gb).max_layers = 256 }
    }
    var lim: usize = (*gb).max_layers as usize
    if (*gb).limit_set > 0 && ((*gb).limit_set as usize) < lim { lim = (*gb).limit_set as usize }
    var np: usize = 1
    var pl: usize = total
    if total > lim {
        np = (total + lim - 1) / lim
        pl = lim
        if np > MAX_PAGES { np = MAX_PAGES }
    }
    (*gb).layers_lost = 0
    if total > np * pl {
        (*gb).layers_lost = (total - np * pl) as i32
    }
    var minf: u32 = gl33.GL_NEAREST
    var magf: u32 = gl33.GL_NEAREST
    if (*gb).mip {
        minf = gl33.GL_LINEAR_MIPMAP_LINEAR
    } else if (*gb).aniso > 1.0 {
        minf = gl33.GL_LINEAR
    }
    if (*gb).aniso > 1.0 {
        magf = gl33.GL_LINEAR
    }
    let row: usize = t * 4
    let lbytes: usize = t * row
    let stride: usize = ((*at).w as usize) * 4
    var pg: usize = 0
    while pg < np {
        var layers: usize = total - pg * pl
        if layers > pl { layers = pl }
        let buf: u64 = rt.heap_alloc(layers * lbytes)
        if buf == 0 {
            return
        }
        var l: usize = 0
        while l < layers {
            let g: usize = pg * pl + l
            let col: usize = g % ((*at).cols as usize)
            let rw: usize = g / ((*at).cols as usize)
            var y: usize = 0
            while y < t {
                rt.mem_copy(buf + (l * lbytes + y * row) as u64, (*at).px + ((rw * t + y) * stride + col * row) as u64, row)
                y = y + 1
            }
            l = l + 1
        }
        let id: u32 = gl33.gl_tex_array_rgba8(&(*gb).g, (*at).tile, (*at).tile, layers as i32, buf, minf, magf, (*gb).aniso)
        rt.heap_free(buf, layers * lbytes)
        if pg == 0 {
            (*gb).atlas_tex = id
        } else {
            (*gb).atlas_x[pg - 1] = id
        }
        pg = pg + 1
    }
    (*gb).n_apages = np as i32
    if np == 1 {
        (*gb).page_layers = 1048576 // single array: the shader never splits
    } else {
        (*gb).page_layers = pl as i32
    }
    (*gb).atile = (*at).tile
    (*gb).acols = (*at).cols
}

fn free_atlas_pages(gb: *mut GlBackend) {
    if (*gb).atlas_tex != 0 as u32 {
        gl33.gl_delete_tex(&(*gb).g, (*gb).atlas_tex)
        (*gb).atlas_tex = 0 as u32
    }
    var i: usize = 0
    while i < 3 {
        if (*gb).atlas_x[i] != 0 as u32 {
            gl33.gl_delete_tex(&(*gb).g, (*gb).atlas_x[i])
            (*gb).atlas_x[i] = 0 as u32
        }
        i = i + 1
    }
    (*gb).n_apages = 0
}

// Test hook: caps the driver's array layer limit (0 = driver limit) so the multi-page path can be exercised on a driver that allows
// thousands of layers. Takes effect on the next upload_atlas.
fn glbe_set_layer_limit(gb: *mut GlBackend, n: i32) {
    (*gb).limit_set = n
}

fn glbe_atlas_pages(gb: *mut GlBackend) -> i32 {
    return (*gb).n_apages
}

// Returns a free slot index (the table grows by doubling), NONE on failure.
fn alloc_slot(gb: *mut GlBackend) -> usize {
    var s: usize = 0
    while s < (*gb).slot_cap {
        if rt.ld64((*gb).slots, s * SLOT_WORDS + S_USED) == 0 as u64 {
            return s
        }
        s = s + 1
    }
    let ncap: usize = (*gb).slot_cap * 2 + 64
    let ns: u64 = rt.heap_alloc(ncap * SLOT_WORDS * 8)
    if ns == 0 {
        return NONE
    }
    var i: usize = 0
    while i < ncap * SLOT_WORDS {
        var v: u64 = 0
        if i < (*gb).slot_cap * SLOT_WORDS {
            v = rt.ld64((*gb).slots, i)
        }
        rt.st64(ns, i, v)
        i = i + 1
    }
    if (*gb).slots != 0 {
        rt.heap_free((*gb).slots, (*gb).slot_cap * SLOT_WORDS * 8)
    }
    s = (*gb).slot_cap
    (*gb).slots = ns
    (*gb).slot_cap = ncap
    return s
}

// Copies the mesh bytes of slot s into its pool block.
fn upload_block(gb: *mut GlBackend, s: usize, verts: u64, idx: u64) {
    let b: usize = s * SLOT_WORDS
    let p: usize = rt.ld64((*gb).slots, b + S_PAGE) as usize
    let nv: usize = rt.ld64((*gb).slots, b + S_NV) as usize
    let ni: usize = rt.ld64((*gb).slots, b + S_NIDX) as usize
    let vo: usize = rt.ld64((*gb).slots, b + S_VOFF) as usize
    let io: usize = rt.ld64((*gb).slots, b + S_IOFF) as usize
    let g: *mut gl33.Gl = &(*gb).g
    gl33.gl_bind_buffer(g, gl33.GL_COPY_WRITE_BUFFER, pw(gb, p, P_VBO) as u32)
    gl33.gl_buffer_sub_data(g, gl33.GL_COPY_WRITE_BUFFER, vo * 8, nv * 8, verts)
    gl33.gl_bind_buffer(g, gl33.GL_COPY_WRITE_BUFFER, pw(gb, p, P_IBO) as u32)
    gl33.gl_buffer_sub_data(g, gl33.GL_COPY_WRITE_BUFFER, io * 4, ni * 4, idx)
    let bytes: u64 = (nv * 8 + ni * 4) as u64
    (*gb).up_bytes = (*gb).up_bytes + bytes
    (*gb).frame_up = (*gb).frame_up + bytes
}

// Stable counting sort of the triangles by the face direction of their first vertex (mc_mesh face 0..5, 6/7 = other -> bucket 6).
// Returns a new index array (caller frees nidx * 4 bytes) and stores the 7 bucket ends in the slot; 0 = no allocation.
fn sort_by_face(gb: *mut GlBackend, s: usize, verts: u64, nverts: usize, idx: u64, nidx: usize) -> u64 {
    let out: u64 = rt.heap_alloc(nidx * 4)
    if out == 0 {
        return 0
    }
    let cnt: u64 = rt.heap_alloc(FB_N * 8 * 2)
    var k: usize = 0
    while k < FB_N * 2 {
        rt.st64(cnt, k, 0 as u64)
        k = k + 1
    }
    let ntri: usize = nidx / 3
    var t: usize = 0
    while t < ntri {
        let vi: usize = rt.ld32(idx, t * 3) as usize
        var f: usize = 6
        if vi < nverts {
            let fc: usize = ((rt.ld32(verts, vi * 2) >> 24 as u32) & 7 as u32) as usize
            if fc < 6 {
                f = fc
            }
        }
        rt.st64(cnt, f, rt.ld64(cnt, f) + 1 as u64)
        t = t + 1
    }
    // cnt[0..6] = counts, cnt[7..13] = write cursors (in triangles), the bucket ends go to the slot
    var acc: usize = 0
    k = 0
    while k < FB_N {
        rt.st64(cnt, FB_N + k, acc as u64)
        acc = acc + (rt.ld64(cnt, k) as usize)
        rt.st64(cnt, k, acc as u64) // end (triangles)
        k = k + 1
    }
    t = 0
    while t < ntri {
        let vi: usize = rt.ld32(idx, t * 3) as usize
        var f: usize = 6
        if vi < nverts {
            let fc: usize = ((rt.ld32(verts, vi * 2) >> 24 as u32) & 7 as u32) as usize
            if fc < 6 {
                f = fc
            }
        }
        let w: usize = rt.ld64(cnt, FB_N + f) as usize
        rt.st64(cnt, FB_N + f, (w + 1) as u64)
        rt.st32(out, w * 3, rt.ld32(idx, t * 3))
        rt.st32(out, w * 3 + 1, rt.ld32(idx, t * 3 + 1))
        rt.st32(out, w * 3 + 2, rt.ld32(idx, t * 3 + 2))
        t = t + 1
    }
    let b: usize = s * SLOT_WORDS
    rt.st64((*gb).slots, b + S_BK, 1 as u64)
    var e: usize = 0
    while e < 4 {
        let lo: u64 = if e * 2 < FB_N { rt.ld64(cnt, e * 2) * 3 as u64 } else { 0 as u64 }
        let hi: u64 = if e * 2 + 1 < FB_N { rt.ld64(cnt, e * 2 + 1) * 3 as u64 } else { 0 as u64 }
        rt.st64((*gb).slots, b + S_BKE + e, lo | (hi << 32 as u64))
        e = e + 1
    }
    rt.heap_free(cnt, FB_N * 8 * 2)
    return out
}

fn bk_end(gb: *mut GlBackend, b: usize, k: usize) -> usize {
    let w: u64 = rt.ld64((*gb).slots, b + S_BKE + k / 2)
    if k % 2 == 0 {
        return (w & 4294967295 as u64) as usize
    }
    return (w >> 32 as u64) as usize
}

// Face direction k (0..5) can face a camera at (-rx, -ry, -rz) relative to the section corner (rx = corner - camera)? Conservative by 1/100 block.
fn bk_visible(k: usize, rx: f64, ry: f64, rz: f64) -> bool {
    if k == 0 { return rx + 16.0 > 0.0 - 0.01 }
    if k == 1 { return rx < 0.01 }
    if k == 2 { return ry + 16.0 > 0.0 - 0.01 }
    if k == 3 { return ry < 0.01 }
    if k == 4 { return rz + 16.0 > 0.0 - 0.01 }
    if k == 5 { return rz < 0.01 }
    return true
}

// MESH_MODEL / MESH_MODEL_T: nq quads of MQW f64 (mc_raster.raster_draw_models) -> 4 float vertices (MV_F f32: pos xyz | u v tile fk |
// sky block tint ao) + 6 u32 indices per quad in a private VAO / VBO / IBO (not in the pool pages: model meshes are few and may be re-sorted).
fn upload_models(gb: *mut GlBackend, s: usize, q: u64, nq: usize, cls: i32) {
    let g: *mut gl33.Gl = &(*gb).g
    let b: usize = s * SLOT_WORDS
    let vbytes: usize = nq * 4 * MV_F * 4
    let cv: u64 = rt.heap_alloc(vbytes)
    let ci: u64 = rt.heap_alloc(nq * 6 * 4)
    if cv == 0 || ci == 0 {
        if cv != 0 { rt.heap_free(cv, vbytes) }
        if ci != 0 { rt.heap_free(ci, nq * 6 * 4) }
        rt.st64((*gb).slots, b + S_USED, 1 as u64)
        return
    }
    var i: usize = 0
    while i < nq {
        let qb: usize = i * MQW
        var k: usize = 0
        while k < 4 {
            let vo: u64 = cv + ((i * 4 + k) * MV_F * 4) as u64
            *(vo as *mut f32) = qd(q, qb + k) as f32
            *((vo + 4 as u64) as *mut f32) = qd(q, qb + 4 + k) as f32
            *((vo + 8 as u64) as *mut f32) = qd(q, qb + 8 + k) as f32
            *((vo + 12 as u64) as *mut f32) = qd(q, qb + 12 + k) as f32
            *((vo + 16 as u64) as *mut f32) = qd(q, qb + 16 + k) as f32
            *((vo + 20 as u64) as *mut f32) = qd(q, qb + 20) as f32
            *((vo + 24 as u64) as *mut f32) = qd(q, qb + 21) as f32
            *((vo + 28 as u64) as *mut f32) = qd(q, qb + 22) as f32
            *((vo + 32 as u64) as *mut f32) = qd(q, qb + 23) as f32
            *((vo + 36 as u64) as *mut f32) = qd(q, qb + 24) as f32
            *((vo + 40 as u64) as *mut f32) = qd(q, qb + 26 + k) as f32
            k = k + 1
        }
        // quads without a tile (tile 0) are skipped by the CPU raster: degenerate here (index 0 0 0 ...)
        let io: u64 = ci + (i * 6 * 4) as u64
        if qd(q, qb + 20) as u32 == 0 as u32 {
            var z: usize = 0
            while z < 6 {
                *((io + (z * 4) as u64) as *mut u32) = (i * 4) as u32
                z = z + 1
            }
        } else {
            let base: u32 = (i * 4) as u32
            *(io as *mut u32) = base
            *((io + 4 as u64) as *mut u32) = base + 1 as u32
            *((io + 8 as u64) as *mut u32) = base + 2 as u32
            *((io + 12 as u64) as *mut u32) = base
            *((io + 16 as u64) as *mut u32) = base + 2 as u32
            *((io + 20 as u64) as *mut u32) = base + 3 as u32
        }
        i = i + 1
    }
    let vao: u32 = gl33.gl_gen_vao(g)
    gl33.gl_bind_vao(g, vao)
    let vbo: u32 = gl33.gl_gen_buffer(g)
    gl33.gl_bind_buffer(g, gl33.GL_ARRAY_BUFFER, vbo)
    gl33.gl_buffer_data(g, gl33.GL_ARRAY_BUFFER, cv, vbytes, gl33.GL_STATIC_DRAW)
    gl33.gl_enable_attrib(g, 0 as u32)
    gl33.gl_attrib_f(g, 0 as u32, 3, gl33.GL_FLOAT, false, 48, 0)
    gl33.gl_enable_attrib(g, 1 as u32)
    gl33.gl_attrib_f(g, 1 as u32, 4, gl33.GL_FLOAT, false, 48, 12)
    gl33.gl_enable_attrib(g, 2 as u32)
    gl33.gl_attrib_f(g, 2 as u32, 4, gl33.GL_FLOAT, false, 48, 28)
    let ibo: u32 = gl33.gl_gen_buffer(g)
    gl33.gl_bind_buffer(g, gl33.GL_ELEMENT_ARRAY_BUFFER, ibo)
    var usage: u32 = gl33.GL_STATIC_DRAW
    if cls == 3 { usage = gl33.GL_DYNAMIC_DRAW }
    gl33.gl_buffer_data(g, gl33.GL_ELEMENT_ARRAY_BUFFER, ci, nq * 6 * 4, usage)
    gl33.gl_bind_vao(g, 0 as u32)
    (*gb).cur_vao = 0 as u32
    rt.heap_free(ci, nq * 6 * 4)
    rt.st64((*gb).slots, b + S_VAO, vao as u64)
    rt.st64((*gb).slots, b + S_VBO, vbo as u64)
    rt.st64((*gb).slots, b + S_IBO, ibo as u64)
    rt.st64((*gb).slots, b + S_NIDX, (nq * 6) as u64)
    rt.st64((*gb).slots, b + S_MODEL, cls as u64)
    rt.st64((*gb).slots, b + S_MNQ, nq as u64)
    if cls == 3 {
        rt.st64((*gb).slots, b + S_MV, cv) // kept for the sort
    } else {
        rt.heap_free(cv, vbytes)
    }
    rt.st64((*gb).slots, b + S_USED, 1 as u64)
    (*gb).up_bytes = (*gb).up_bytes + (vbytes + nq * 24) as u64
}

fn qd(p: u64, i: usize) -> f64 {
    return *((p + (i as u64) * (8 as u64)) as *mut f64)
}

// Draws a model slot now (the collected voxel draws are submitted first so the draw order stays the submission order).
// MESH_MODEL_T: the quads are sorted far to near by the mean view depth of their corners (like raster_draw_models_ex) and the index buffer
// is rewritten; blending / depth write come from the pass state (apply_pass).
fn draw_model(gb: *mut GlBackend, h: usize, ox: f64, oy: f64, oz: f64) -> u64 {
    let g: *mut gl33.Gl = &(*gb).g
    let b: usize = (h - 1) * SLOT_WORDS
    let nq: usize = rt.ld64((*gb).slots, b + S_MNQ) as usize
    if nq == 0 || (*gb).mprog == 0 as u32 { return 0 as u64 }
    if (*gb).mode >= MODE_MULTI {
        flush_batch(gb)
    }
    let vao: u32 = rt.ld64((*gb).slots, b + S_VAO) as u32
    if rt.ld64((*gb).slots, b + S_MODEL) == 3 as u64 && rt.ld64((*gb).slots, b + S_MV) != 0 as u64 {
        let cv: u64 = rt.ld64((*gb).slots, b + S_MV)
        let ord: u64 = rt.heap_alloc(nq * 8 * 2 + nq * 24)
        if ord != 0 {
            let ix: u64 = ord + (nq * 16) as u64 // u32 x 6 per quad
            var i: usize = 0
            while i < nq {
                var dsum: f64 = 0.0
                var k: usize = 0
                while k < 4 {
                    let vo: u64 = cv + ((i * 4 + k) * MV_F * 4) as u64
                    let x: f64 = ox - (*gb).cx + (*(vo as *mut f32)) as f64
                    let y: f64 = oy - (*gb).cy + (*((vo + 4 as u64) as *mut f32)) as f64
                    let z: f64 = oz - (*gb).cz + (*((vo + 8 as u64) as *mut f32)) as f64
                    dsum = dsum + (*gb).rv[3] as f64 * x + (*gb).rv[7] as f64 * y + (*gb).rv[11] as f64 * z
                    k = k + 1
                }
                *((ord + (nq * 8 + i * 8) as u64) as *mut f64) = dsum
                rt.st64(ord, i, i as u64)
                i = i + 1
            }
            // stable insertion sort, descending depth (same as the CPU raster)
            var a1: usize = 1
            while a1 < nq {
                let ki: u64 = rt.ld64(ord, a1)
                let kd: f64 = *((ord + (nq * 8) as u64 + ki * 8 as u64) as *mut f64)
                var j: usize = a1
                while j > 0 && *((ord + (nq * 8) as u64 + rt.ld64(ord, j - 1) * 8 as u64) as *mut f64) < kd {
                    rt.st64(ord, j, rt.ld64(ord, j - 1))
                    j = j - 1
                }
                rt.st64(ord, j, ki)
                a1 = a1 + 1
            }
            var n: usize = 0
            while n < nq {
                let qi: u32 = (rt.ld64(ord, n) as u32) * 4 as u32
                let io: u64 = ix + (n * 24) as u64
                *(io as *mut u32) = qi
                *((io + 4 as u64) as *mut u32) = qi + 1 as u32
                *((io + 8 as u64) as *mut u32) = qi + 2 as u32
                *((io + 12 as u64) as *mut u32) = qi
                *((io + 16 as u64) as *mut u32) = qi + 2 as u32
                *((io + 20 as u64) as *mut u32) = qi + 3 as u32
                n = n + 1
            }
            gl33.gl_bind_vao(g, vao)
            gl33.gl_bind_buffer(g, gl33.GL_ELEMENT_ARRAY_BUFFER, rt.ld64((*gb).slots, b + S_IBO) as u32)
            gl33.gl_buffer_sub_data(g, gl33.GL_ELEMENT_ARRAY_BUFFER, 0, nq * 24, ix)
            rt.heap_free(ord, nq * 8 * 2 + nq * 24)
        }
    }
    gl33.gl_use(g, (*gb).mprog)
    gl33.gl_u1i(g, (*gb).ml[MLOC_ATLAS], 0)
    gl33.gl_u1i(g, (*gb).ml[MLOC_ATLAS1], 3)
    gl33.gl_u1i(g, (*gb).ml[MLOC_ATLAS1 + 1], 4)
    gl33.gl_u1i(g, (*gb).ml[MLOC_ATLAS1 + 2], 5)
    gl33.gl_u1i(g, (*gb).ml[MLOC_PAGEL], (*gb).page_layers)
    var fl: i32 = 0
    if filtered(gb) { fl = 1 }
    gl33.gl_u1i(g, (*gb).ml[MLOC_FILTER], fl)
    gl33.gl_u1i(g, (*gb).ml[MLOC_TRANS], if (*gb).trans_pass { 1 } else { 0 })
    gl33.gl_u4f(g, (*gb).ml[MLOC_FADE], (*gb).fade_a as f64, (*gb).fade_inv as f64, (*gb).h as f64, (*gb).w as f64)
    gl33.gl_uniform_mat4(g, (*gb).ml[MLOC_RV], (&(*gb).rv[0]) as u64)
    gl33.gl_u2f(g, (*gb).ml[MLOC_TILES], (*gb).atile as f64, (*gb).acols as f64)
    gl33.gl_u4f(g, (*gb).ml[MLOC_FOG], if (*gb).fog_on { 1.0 } else { 0.0 }, (*gb).fog_start, (*gb).fog_end, 0.0)
    gl33.gl_u3f(g, (*gb).ml[MLOC_FOGC], (*gb).fog_r, (*gb).fog_g, (*gb).fog_b)
    gl33.gl_u4f(g, (*gb).ml[MLOC_LIGHT], (*gb).day, (*gb).tint_r, (*gb).tint_g, (*gb).tint_b)
    gl33.gl_u3f(g, (*gb).ml[MLOC_ORIGIN], ox - (*gb).cx, oy - (*gb).cy, oz - (*gb).cz)
    gl33.gl_bind_vao(g, vao)
    gl33.gl_draw_elements(g, gl33.GL_TRIANGLES, (nq * 6) as i32, gl33.GL_UNSIGNED_INT, 0)
    gl33.gl_bind_vao(g, 0 as u32)
    (*gb).cur_vao = 0 as u32
    gl33.gl_use(g, (*gb).prog)
    (*gb).calls = (*gb).calls + 1 as u64
    (*gb).fresh = false
    return (nq * 2) as u64
}

fn be_upload(o: u64, key: u64, verts: u64, nverts: usize, idx: u64, nidx: usize) -> usize {
    let gb: *mut GlBackend = o as *mut GlBackend
    let s: usize = alloc_slot(gb)
    if s == NONE {
        return 0
    }
    let b: usize = s * SLOT_WORDS
    var i: usize = 0
    while i < SLOT_WORDS {
        rt.st64((*gb).slots, b + i, 0 as u64)
        i = i + 1
    }
    rt.st64((*gb).slots, b + S_KEY, key)
    if (*gb).mcls >= 2 {
        if (*gb).mprog == 0 as u32 || nverts < MQW {
            rt.st64((*gb).slots, b + S_USED, 1 as u64)
            return s + 1 // no model program / no quads: nothing to draw
        }
        upload_models(gb, s, verts, nverts / MQW, (*gb).mcls)
        return s + 1
    }
    if nverts == 0 || nidx == 0 {
        rt.st64((*gb).slots, b + S_USED, 1 as u64) // empty section: nothing to draw
        return s + 1
    }
    if (*gb).mode == MODE_LEGACY {
        let g: *mut gl33.Gl = &(*gb).g
        let vao: u32 = gl33.gl_gen_vao(g)
        gl33.gl_bind_vao(g, vao)
        let vbo: u32 = gl33.gl_gen_buffer(g)
        gl33.gl_bind_buffer(g, gl33.GL_ARRAY_BUFFER, vbo)
        gl33.gl_buffer_data(g, gl33.GL_ARRAY_BUFFER, verts, nverts * 8, gl33.GL_STATIC_DRAW)
        gl33.gl_enable_attrib(g, 0 as u32)
        gl33.gl_attrib_i(g, 0 as u32, 2, gl33.GL_UNSIGNED_INT, 8, 0)
        let ibo: u32 = gl33.gl_gen_buffer(g)
        gl33.gl_bind_buffer(g, gl33.GL_ELEMENT_ARRAY_BUFFER, ibo)
        gl33.gl_buffer_data(g, gl33.GL_ELEMENT_ARRAY_BUFFER, idx, nidx * 4, gl33.GL_STATIC_DRAW)
        gl33.gl_bind_vao(g, 0 as u32)
        (*gb).cur_vao = 0 as u32
        rt.st64((*gb).slots, b + S_VAO, vao as u64)
        rt.st64((*gb).slots, b + S_VBO, vbo as u64)
        rt.st64((*gb).slots, b + S_IBO, ibo as u64)
        rt.st64((*gb).slots, b + S_NIDX, nidx as u64)
        rt.st64((*gb).slots, b + S_USED, 1 as u64)
        let bytes: u64 = (nverts * 8 + nidx * 4) as u64
        (*gb).up_bytes = (*gb).up_bytes + bytes
        return s + 1
    }
    rt.st64((*gb).slots, b + S_NIDX, nidx as u64)
    rt.st64((*gb).slots, b + S_USED, 1 as u64)
    if !place_slot(gb, s, nverts, nidx) {
        rt.st64((*gb).slots, b + S_USED, 0 as u64)
        return 0
    }
    var uidx: u64 = idx
    var sorted: u64 = 0
    if (*gb).facecull && !(*gb).up_keep && (*gb).mode >= MODE_MULTI && nidx % 3 == 0 {
        sorted = sort_by_face(gb, s, verts, nverts, idx, nidx)
        if sorted != 0 {
            uidx = sorted
        }
    }
    if (*gb).budget > 0 {
        // stage the bytes on the CPU; begin uploads them within the per-frame budget
        let sv: u64 = rt.heap_alloc(nverts * 8)
        let si: u64 = rt.heap_alloc(nidx * 4)
        if sv != 0 && si != 0 {
            rt.mem_copy(sv, verts, nverts * 8)
            rt.mem_copy(si, uidx, nidx * 4)
            rt.st64((*gb).slots, b + S_SV, sv)
            rt.st64((*gb).slots, b + S_SI, si)
            rt.st64((*gb).slots, b + S_STAGED, 1 as u64)
            (*gb).staged = (*gb).staged + 1
            if sorted != 0 {
                rt.heap_free(sorted, nidx * 4)
            }
            return s + 1
        }
        if sv != 0 { rt.heap_free(sv, nverts * 8) }
        if si != 0 { rt.heap_free(si, nidx * 4) }
    }
    upload_block(gb, s, verts, uidx)
    if sorted != 0 {
        rt.heap_free(sorted, nidx * 4)
    }
    return s + 1
}

// Uploads staged sections (slot order) until `budget` bytes of this frame are used (at least one per call, so a big
// section cannot starve). budget 0 = all. Returns the number of sections uploaded.
fn glbe_flush_uploads(gb: *mut GlBackend, budget: usize) -> usize {
    var n: usize = 0
    if (*gb).staged == 0 {
        return 0
    }
    var s: usize = 0
    while s < (*gb).slot_cap && (*gb).staged > 0 {
        let b: usize = s * SLOT_WORDS
        if rt.ld64((*gb).slots, b + S_USED) != 0 as u64 && rt.ld64((*gb).slots, b + S_STAGED) != 0 as u64 {
            if budget > 0 && n > 0 && (*gb).frame_up >= budget as u64 {
                break
            }
            let sv: u64 = rt.ld64((*gb).slots, b + S_SV)
            let si: u64 = rt.ld64((*gb).slots, b + S_SI)
            upload_block(gb, s, sv, si)
            rt.heap_free(sv, (rt.ld64((*gb).slots, b + S_NV) as usize) * 8)
            rt.heap_free(si, (rt.ld64((*gb).slots, b + S_NIDX) as usize) * 4)
            rt.st64((*gb).slots, b + S_STAGED, 0 as u64)
            rt.st64((*gb).slots, b + S_SV, 0 as u64)
            rt.st64((*gb).slots, b + S_SI, 0 as u64)
            (*gb).staged = (*gb).staged - 1
            n = n + 1
        }
        s = s + 1
    }
    return n
}

fn free_slot(gb: *mut GlBackend, handle: usize) {
    if handle < 1 || handle > (*gb).slot_cap {
        return
    }
    let b: usize = (handle - 1) * SLOT_WORDS
    if rt.ld64((*gb).slots, b + S_USED) == 0 as u64 {
        return
    }
    let g: *mut gl33.Gl = &(*gb).g
    let vao: u32 = rt.ld64((*gb).slots, b + S_VAO) as u32
    let vbo: u32 = rt.ld64((*gb).slots, b + S_VBO) as u32
    let ibo: u32 = rt.ld64((*gb).slots, b + S_IBO) as u32
    if vao != 0 as u32 {
        gl33.gl_delete_vao(g, vao)
    }
    if vbo != 0 as u32 {
        gl33.gl_delete_buffer(g, vbo)
    }
    if ibo != 0 as u32 {
        gl33.gl_delete_buffer(g, ibo)
    }
    let nv: usize = rt.ld64((*gb).slots, b + S_NV) as usize
    if nv != 0 && (*gb).mode != MODE_LEGACY {
        let p: usize = rt.ld64((*gb).slots, b + S_PAGE) as usize
        glpool.pool_free(pw(gb, p, P_VPOOL), rt.ld64((*gb).slots, b + S_VOFF) as usize, nv)
        glpool.pool_free(pw(gb, p, P_IPOOL), rt.ld64((*gb).slots, b + S_IOFF) as usize, rt.ld64((*gb).slots, b + S_NIDX) as usize)
        pset(gb, p, P_LIVE, pw(gb, p, P_LIVE) - 1 as u64)
    }
    if rt.ld64((*gb).slots, b + S_STAGED) != 0 as u64 {
        rt.heap_free(rt.ld64((*gb).slots, b + S_SV), nv * 8)
        rt.heap_free(rt.ld64((*gb).slots, b + S_SI), (rt.ld64((*gb).slots, b + S_NIDX) as usize) * 4)
        (*gb).staged = (*gb).staged - 1
    }
    if rt.ld64((*gb).slots, b + S_MV) != 0 as u64 {
        rt.heap_free(rt.ld64((*gb).slots, b + S_MV), (rt.ld64((*gb).slots, b + S_MNQ) as usize) * 4 * MV_F * 4)
        rt.st64((*gb).slots, b + S_MV, 0 as u64)
    }
    rt.st64((*gb).slots, b + S_MODEL, 0 as u64)
    rt.st64((*gb).slots, b + S_USED, 0 as u64)
    rt.st64((*gb).slots, b + S_NV, 0 as u64)
    rt.st64((*gb).slots, b + S_STAGED, 0 as u64)
}

fn be_free(o: u64, h: usize) {
    free_slot(o as *mut GlBackend, h)
}

// Origin buffer texture: 16 bytes per slot (xyz = section origin - camera, f32).
fn ensure_org(gb: *mut GlBackend) {
    if (*gb).org_cap >= (*gb).slot_cap {
        return
    }
    if (*gb).org_cpu != 0 {
        rt.heap_free((*gb).org_cpu, (*gb).org_cap * 16)
    }
    let g: *mut gl33.Gl = &(*gb).g
    (*gb).org_cap = (*gb).slot_cap
    (*gb).org_cpu = rt.heap_alloc((*gb).org_cap * 16)
    rt.mem_set((*gb).org_cpu, 0 as u8, (*gb).org_cap * 16)
    if (*gb).org_buf == 0 as u32 {
        (*gb).org_buf = gl33.gl_gen_buffer(g)
        (*gb).org_tex = gl33.gl_gen_texture(g)
    }
    gl33.gl_bind_buffer(g, gl33.GL_COPY_WRITE_BUFFER, (*gb).org_buf)
    gl33.gl_buffer_data(g, gl33.GL_COPY_WRITE_BUFFER, 0, (*gb).org_cap * 16, gl33.GL_DYNAMIC_DRAW)
    gl33.gl_tex_buffer(g, (*gb).org_tex, gl33.GL_RGBA32F, (*gb).org_buf)
}

fn ensure_pend(gb: *mut GlBackend) {
    if (*gb).pend_n < (*gb).pend_cap {
        return
    }
    let ncap: usize = (*gb).pend_cap * 2 + 256
    let np: u64 = rt.heap_alloc(ncap * 8)
    let nc: u64 = rt.heap_alloc(ncap * FB_N * 4)
    let no: u64 = rt.heap_alloc(ncap * FB_N * 8)
    let nb: u64 = rt.heap_alloc(ncap * FB_N * 20)
    if (*gb).pend != 0 {
        rt.mem_copy(np, (*gb).pend, (*gb).pend_n * 8)
        rt.heap_free((*gb).pend, (*gb).pend_cap * 8)
        rt.heap_free((*gb).sc_counts, (*gb).pend_cap * FB_N * 4)
        rt.heap_free((*gb).sc_offs, (*gb).pend_cap * FB_N * 8)
        rt.heap_free((*gb).sc_bv, (*gb).pend_cap * FB_N * 20)
    }
    (*gb).pend = np
    (*gb).sc_counts = nc
    (*gb).sc_offs = no
    (*gb).sc_bv = nb
    (*gb).pend_cap = ncap
}

fn be_begin(o: u64, cam: u64, rgba: u32) {
    let gb: *mut GlBackend = o as *mut GlBackend
    let c: *mut mc_camera.Camera = cam as *mut mc_camera.Camera
    let g: *mut gl33.Gl = &(*gb).g
    (*gb).cx = (*c).x
    (*gb).cy = (*c).y
    (*gb).cz = (*c).z
    (*gb).frame_up = 0 as u64
    (*gb).near = (*c).near
    (*gb).trans_pass = false
    if (*gb).staged > 0 {
        glbe_flush_uploads(gb, (*gb).budget)
    }
    // projection * view rotation: the camera translation is applied on the CPU per draw (origin)
    var rot: mc_math.Mat4 = (*c).view
    rot.m[12] = 0.0
    rot.m[13] = 0.0
    rot.m[14] = 0.0
    var rv: mc_math.Mat4 = mc_math.Mat4 { m: [0.0; 16] }
    mc_math.mat4_mul(&rv, &(*c).proj, &rot)
    gl33.gl_mat4_f64_to_f32((&rv.m[0]) as u64, (&(*gb).rv[0]) as u64)
    draw_fbo_bind(gb)
    gl33.gl_viewport(g, 0, 0, (*gb).w, (*gb).h)
    (*gb).dirty = (*gb).msaa > 0
    gl33.gl_disable(g, gl33.GL_BLEND)
    gl33.gl_disable(g, gl33.GL_SCISSOR_TEST)
    gl33.gl_enable(g, gl33.GL_DEPTH_TEST)
    gl33.gl_depth_func(g, gl33.GL_LESS)
    gl33.gl_depth_mask(g, true)
    gl33.gl_color_mask(g, true, true, true, true)
    gl33.gl_front_face(g, gl33.GL_CCW)
    if (*gb).cull {
        gl33.gl_enable(g, gl33.GL_CULL_FACE)
        gl33.gl_cull_face(g, gl33.GL_BACK)
    } else {
        gl33.gl_disable(g, gl33.GL_CULL_FACE)
    }
    let r: f64 = ((rgba & 255 as u32) as f64) / 255.0
    let gr: f64 = (((rgba >> 8 as u32) & 255 as u32) as f64) / 255.0
    let b: f64 = (((rgba >> 16 as u32) & 255 as u32) as f64) / 255.0
    let a: f64 = (((rgba >> 24 as u32) & 255 as u32) as f64) / 255.0
    gl33.gl_clear_color(g, r, gr, b, a)
    gl33.gl_clear(g, gl33.GL_COLOR_BUFFER_BIT | gl33.GL_DEPTH_BUFFER_BIT)
    bind_state(gb)
}

// Program, textures and uniforms of the voxel pass (everything be_begin sets after the clear). The scene layer calls it
// through glbe_rebind after its own passes changed the program / VAO / blend state.
fn bind_state(gb: *mut GlBackend) {
    let g: *mut gl33.Gl = &(*gb).g
    gl33.gl_use(g, (*gb).prog)
    gl33.gl_bind_tex_target(g, 0 as u32, gl33.GL_TEXTURE_2D_ARRAY, (*gb).atlas_tex)
    var xi: usize = 0
    while xi < 3 {
        // pages 1..3 on units 3..5; unused samplers point at page 0 (every sampler must hold an array texture of its type)
        var xt: u32 = (*gb).atlas_x[xi]
        if xt == 0 as u32 { xt = (*gb).atlas_tex }
        gl33.gl_bind_tex_target(g, (3 + xi) as u32, gl33.GL_TEXTURE_2D_ARRAY, xt)
        gl33.gl_u1i(g, (*gb).l_atlas_x[xi], (3 + xi) as i32)
        xi = xi + 1
    }
    gl33.gl_u1i(g, (*gb).l_pagel, (*gb).page_layers)
    gl33.gl_u1i(g, (*gb).l_atlas, 0)
    gl33.gl_u1i(g, (*gb).l_gran, 1)
    gl33.gl_u1i(g, (*gb).l_org, 2)
    var pool: i32 = 0
    if (*gb).mode >= MODE_MULTI {
        pool = 1
        ensure_org(gb)
        gl33.gl_bind_tex_target(g, 2 as u32, gl33.GL_TEXTURE_BUFFER, (*gb).org_tex)
    }
    gl33.gl_u1i(g, (*gb).l_pool, pool)
    var fl: i32 = 0
    if filtered(gb) {
        fl = 1
    }
    gl33.gl_u1i(g, (*gb).l_filter, fl)
    apply_pass(gb)
    apply_fade(gb)
    gl33.gl_uniform_mat4(g, (*gb).l_rv, (&(*gb).rv[0]) as u64)
    gl33.gl_u2f(g, (*gb).l_tiles, (*gb).atile as f64, (*gb).acols as f64)
    gl33.gl_u4f(g, (*gb).l_fog, if (*gb).fog_on { 1.0 } else { 0.0 }, (*gb).fog_start, (*gb).fog_end, 0.0)
    gl33.gl_u3f(g, (*gb).l_fogc, (*gb).fog_r, (*gb).fog_g, (*gb).fog_b)
    gl33.gl_u4f(g, (*gb).l_light, (*gb).day, (*gb).tint_r, (*gb).tint_g, (*gb).tint_b)
    (*gb).pend_n = 0
    (*gb).org_max = 0
    (*gb).batch = (*gb).batch + 1 as u64
    gl33.gl_bind_vao(g, 0 as u32)
    (*gb).cur_vao = 0 as u32
    (*gb).fresh = false
}

// Blend / depth write / u_trans of the active pass (PASS_OPAQUE: no blend, depth write; PASS_TRANS: src-alpha blend, depth test only,
// colour alpha channel untouched so the frame stays opaque like the CPU reference).
fn apply_pass(gb: *mut GlBackend) {
    let g: *mut gl33.Gl = &(*gb).g
    if (*gb).trans_pass {
        gl33.gl_enable(g, gl33.GL_BLEND)
        gl33.gl_blend_func(g, gl33.GL_SRC_ALPHA, gl33.GL_ONE_MINUS_SRC_ALPHA)
        gl33.gl_depth_mask(g, false)
        gl33.gl_color_mask(g, true, true, true, false)
        gl33.gl_u1i(g, (*gb).l_trans, 1)
    } else {
        gl33.gl_disable(g, gl33.GL_BLEND)
        gl33.gl_depth_mask(g, true)
        gl33.gl_color_mask(g, true, true, true, true)
        gl33.gl_u1i(g, (*gb).l_trans, 0)
    }
}

// u_fade = (a, inv, frame height, 0): the screen-door of mc_backend.set_fade (shader: bayer8 of the CPU raster)
fn apply_fade(gb: *mut GlBackend) {
    gl33.gl_u4f(&(*gb).g, (*gb).l_fade, (*gb).fade_a as f64, (*gb).fade_inv as f64, (*gb).h as f64, (*gb).w as f64)
}

// mc_backend set_fade: submits what is collected (it belongs to the old fade), then switches the uniform.
fn be_set_fade(o: u64, a: i32, inv: i32) {
    let gb: *mut GlBackend = o as *mut GlBackend
    var v: i32 = a
    if v > 64 { v = 64 }
    if v < 0 { v = 0 }
    var iv: i32 = 0
    if inv != 0 { iv = 1 }
    if v == (*gb).fade_a && (v >= 64 || iv == (*gb).fade_inv) { return }
    if (*gb).mode >= MODE_MULTI {
        flush_batch(gb)
    }
    (*gb).fade_a = v
    (*gb).fade_inv = iv
    apply_fade(gb)
}

// mc_backend set_pass: submits what MODE_MULTI / MODE_INDIRECT collected (it belongs to the old pass), then switches the state.
fn be_set_light(o: u64, day: i32, tr: i32, tg: i32, tb: i32) {
    glbe_set_light(o as *mut GlBackend, day, tr, tg, tb)
}

fn be_set_pass(o: u64, pass: i32) {
    let gb: *mut GlBackend = o as *mut GlBackend
    let want: bool = pass == mc_backend.PASS_TRANS
    if want == (*gb).trans_pass { return }
    if (*gb).mode >= MODE_MULTI {
        flush_batch(gb)
    }
    (*gb).trans_pass = want
    apply_pass(gb)
}

fn glbe_max_layers(gb: *mut GlBackend) -> i32 {
    return (*gb).max_layers
}

fn glbe_layers_lost(gb: *mut GlBackend) -> i32 {
    return (*gb).layers_lost
}

fn glbe_near(gb: *mut GlBackend) -> f64 {
    return (*gb).near
}

// The framebuffer the passes draw into: the multisample target while MSAA is on, else the plain FBO.
fn draw_fbo_bind(gb: *mut GlBackend) {
    var f: gl33.Fbo = (*gb).fbo
    if (*gb).msaa > 0 {
        f.fbo = (*gb).mt.fbo
    }
    gl33.gl_fbo_bind(&(*gb).g, &f)
}

// Scene layer: bind the draw target + full viewport (a pass of its own starts here).
fn glbe_bind_draw(gb: *mut GlBackend) {
    draw_fbo_bind(gb)
    gl33.gl_viewport(&(*gb).g, 0, 0, (*gb).w, (*gb).h)
}

// Scene layer: issue the draws that MODE_MULTI / MODE_INDIRECT have only collected so far (what b.end does, without the
// flush). Call it BEFORE a pass with its own program so the collected sections are drawn with the voxel state.
fn glbe_flush(gb: *mut GlBackend) {
    if (*gb).mode >= MODE_MULTI {
        flush_batch(gb)
    }
}

// Scene layer: put the voxel pass state back (call after a sky / entity / HUD pass, before the next b.draw).
// It does NOT issue collected draws (bind_state forgets them): call glbe_flush before the extra pass.
fn glbe_rebind(gb: *mut GlBackend) {
    let g: *mut gl33.Gl = &(*gb).g
    glbe_bind_draw(gb)
    gl33.gl_disable(g, gl33.GL_BLEND)
    gl33.gl_enable(g, gl33.GL_DEPTH_TEST)
    gl33.gl_depth_func(g, gl33.GL_LESS)
    gl33.gl_depth_mask(g, true)
    gl33.gl_color_mask(g, true, true, true, true)
    if (*gb).cull {
        gl33.gl_enable(g, gl33.GL_CULL_FACE)
    } else {
        gl33.gl_disable(g, gl33.GL_CULL_FACE)
    }
    bind_state(gb)
}

fn glbe_x(gb: *mut GlBackend) -> *mut gl_ext.GlX {
    return &(*gb).x
}

fn glbe_width(gb: *mut GlBackend) -> i32 {
    return (*gb).w
}

fn glbe_height(gb: *mut GlBackend) -> i32 {
    return (*gb).h
}

// projection * view rotation of the current frame, column-major f32 (the `u_rv` of the voxel pass); camera position f64.
fn glbe_camera_rv(gb: *mut GlBackend, out: u64, cx: *mut f64, cy: *mut f64, cz: *mut f64) {
    rt.mem_copy(out, (&(*gb).rv[0]) as u64, 64)
    *cx = (*gb).cx
    *cy = (*gb).cy
    *cz = (*gb).cz
}

// MSAA: samples 0 = off, else the multisample target is built with min(samples, driver max). Returns the samples in force
// (0 when the driver cannot do it). Draw passes go to the multisample target; `present`, `glbe_fbo_texture` and
// `glbe_resolve` resolve it into the plain FBO first. Needs a current context; call between frames.
fn glbe_set_msaa(gb: *mut GlBackend, samples: i32) -> i32 {
    if !(*gb).ok || !(*gb).xok {
        return 0
    }
    if (*gb).msaa > 0 {
        gl_fbo.target_free(&(*gb).x, &(*gb).mt)
        (*gb).msaa = 0
    }
    (*gb).dirty = false
    if samples <= 0 {
        return 0
    }
    (*gb).mt = gl_fbo.target_new(&(*gb).x, (*gb).w, (*gb).h, 1, gl_fbo.DEPTH_RENDERBUFFER, samples)
    if !(*gb).mt.ok || (*gb).mt.samples <= 0 {
        gl_fbo.target_free(&(*gb).x, &(*gb).mt)
        return 0
    }
    (*gb).msaa = (*gb).mt.samples
    return (*gb).msaa
}

fn glbe_msaa(gb: *mut GlBackend) -> i32 {
    return (*gb).msaa
}

// Resolves the multisample target into the plain FBO colour texture (no-op without MSAA or when already resolved).
fn glbe_resolve(gb: *mut GlBackend) {
    if (*gb).msaa > 0 && (*gb).dirty {
        gl_fbo.blit_fbo(&(*gb).x, (*gb).mt.fbo, (*gb).fbo.fbo, (*gb).w, (*gb).h, gl33.GL_COLOR_BUFFER_BIT)
        (*gb).dirty = false
        (*gb).fresh = false
    }
}

fn bind_vao(gb: *mut GlBackend, v: u32) {
    if (*gb).cur_vao != v {
        gl33.gl_bind_vao(&(*gb).g, v)
        (*gb).cur_vao = v
    }
}

fn be_draw(o: u64, h: usize, ox: f64, oy: f64, oz: f64) -> u64 {
    let gb: *mut GlBackend = o as *mut GlBackend
    if h < 1 || h > (*gb).slot_cap {
        return 0 as u64
    }
    let b: usize = (h - 1) * SLOT_WORDS
    if rt.ld64((*gb).slots, b + S_USED) == 0 as u64 || rt.ld64((*gb).slots, b + S_STAGED) != 0 as u64 {
        return 0 as u64
    }
    if rt.ld64((*gb).slots, b + S_MODEL) != 0 as u64 {
        let mt: u64 = draw_model(gb, h, ox, oy, oz)
        (*gb).draws = (*gb).draws + 1 as u64
        (*gb).tris = (*gb).tris + mt
        return mt
    }
    let nidx: usize = rt.ld64((*gb).slots, b + S_NIDX) as usize
    if nidx < 3 {
        return 0 as u64
    }
    let g: *mut gl33.Gl = &(*gb).g
    let t: u64 = (nidx / 3) as u64
    (*gb).draws = (*gb).draws + 1 as u64
    (*gb).tris = (*gb).tris + t
    if (*gb).mode >= MODE_MULTI {
        // collected, submitted by be_end in ONE call per page; the origin goes to the origin table
        if (*gb).trans_pass && (*gb).pend_n > 0 {
            // translucent draws must stay in submission order (back to front): a page change ends the batch
            let last: usize = rt.ld64((*gb).pend, (*gb).pend_n - 1) as usize
            if rt.ld64((*gb).slots, last * SLOT_WORDS + S_PAGE) != rt.ld64((*gb).slots, b + S_PAGE) {
                flush_batch(gb)
            }
        }
        if rt.ld64((*gb).slots, b + S_STAMP) == (*gb).batch {
            flush_batch(gb) // the same section twice in one batch (two origins): submit what is collected first
        }
        rt.st64((*gb).slots, b + S_STAMP, (*gb).batch)
        ensure_org(gb)
        ensure_pend(gb)
        let q: u64 = (*gb).org_cpu + ((h - 1) * 16) as u64
        *(q as *mut f32) = (ox - (*gb).cx) as f32
        *((q + 4 as u64) as *mut f32) = (oy - (*gb).cy) as f32
        *((q + 8 as u64) as *mut f32) = (oz - (*gb).cz) as f32
        rt.st64((*gb).pend, (*gb).pend_n, (h - 1) as u64)
        (*gb).pend_n = (*gb).pend_n + 1
        if h > (*gb).org_max {
            (*gb).org_max = h
        }
        return t
    }
    gl33.gl_u3f(g, (*gb).l_origin, ox - (*gb).cx, oy - (*gb).cy, oz - (*gb).cz)
    if (*gb).mode == MODE_LEGACY {
        bind_vao(gb, rt.ld64((*gb).slots, b + S_VAO) as u32)
        gl33.gl_draw_elements(g, gl33.GL_TRIANGLES, nidx as i32, gl33.GL_UNSIGNED_INT, 0)
    } else {
        let p: usize = rt.ld64((*gb).slots, b + S_PAGE) as usize
        bind_vao(gb, pw(gb, p, P_VAO) as u32)
        gl33.gl_draw_elements_bv(g, gl33.GL_TRIANGLES, nidx as i32, gl33.GL_UNSIGNED_INT,
            (rt.ld64((*gb).slots, b + S_IOFF) as usize) * 4, rt.ld64((*gb).slots, b + S_VOFF) as i32)
    }
    (*gb).calls = (*gb).calls + 1 as u64
    return t
}

// Submits the collected draws: per page ONE multi draw (or one indirect call).
fn flush_batch(gb: *mut GlBackend) {
    let g: *mut gl33.Gl = &(*gb).g
    if (*gb).pend_n == 0 {
        return
    }
    var tfl: u64 = mc_prof.prof_active_now()
    var tglsum: u64 = 0 as u64
    ensure_org(gb)
    gl33.gl_bind_buffer(g, gl33.GL_COPY_WRITE_BUFFER, (*gb).org_buf)
    gl33.gl_buffer_sub_data(g, gl33.GL_COPY_WRITE_BUFFER, 0, (*gb).org_max * 16, (*gb).org_cpu)
    gl33.gl_bind_tex_target(g, 2 as u32, gl33.GL_TEXTURE_BUFFER, (*gb).org_tex)
    tglsum = mc_prof.prof_active_now() - tfl
    var p: usize = 0
    while p < (*gb).npages {
        var n: usize = 0
        var k: usize = 0
        while k < (*gb).pend_n {
            let s: usize = rt.ld64((*gb).pend, k) as usize
            let b: usize = s * SLOT_WORDS
            if rt.ld64((*gb).slots, b + S_PAGE) == p as u64 {
                var cnt: u32 = rt.ld64((*gb).slots, b + S_NIDX) as u32
                var io: u32 = rt.ld64((*gb).slots, b + S_IOFF) as u32
                let vo: u32 = rt.ld64((*gb).slots, b + S_VOFF) as u32
                var nr: usize = 1 // ranges of this section (face buckets: up to FB_N)
                var rn: [u32; 8] = [0 as u32; 8]
                var rc: [u32; 8] = [0 as u32; 8]
                rn[0] = io
                rc[0] = cnt
                if rt.ld64((*gb).slots, b + S_BK) != 0 as u64 && (*gb).cull {
                    let q: u64 = (*gb).org_cpu + (s * 16) as u64
                    let rx: f64 = (*(q as *mut f32)) as f64
                    let ry: f64 = (*((q + 4 as u64) as *mut f32)) as f64
                    let rz: f64 = (*((q + 8 as u64) as *mut f32)) as f64
                    nr = 0
                    var kb: usize = 0
                    var prev_end: usize = 0
                    while kb < FB_N {
                        let be: usize = bk_end(gb, b, kb)
                        if be > prev_end && bk_visible(kb, rx, ry, rz) {
                            let st: u32 = io + (prev_end as u32)
                            let ln: u32 = (be - prev_end) as u32
                            if nr > 0 && rn[nr - 1] + rc[nr - 1] == st {
                                rc[nr - 1] = rc[nr - 1] + ln
                            } else {
                                rn[nr] = st
                                rc[nr] = ln
                                nr = nr + 1
                            }
                        }
                        prev_end = be
                        kb = kb + 1
                    }
                }
                var ri: usize = 0
                while ri < nr {
                    cnt = rc[ri]
                    io = rn[ri]
                    (*gb).tris_sub = (*gb).tris_sub + ((cnt / 3 as u32) as u64)
                    if (*gb).mode == MODE_INDIRECT {
                        // command: count, instance count, first index, base vertex, base instance
                        let c: u64 = (*gb).sc_bv + (n * 20) as u64
                        rt.st32(c, 0, cnt)
                        rt.st32(c, 1, 1 as u32)
                        rt.st32(c, 2, io)
                        rt.st32(c, 3, vo)
                        rt.st32(c, 4, 0 as u32)
                    } else {
                        rt.st32((*gb).sc_counts, n, cnt)
                        rt.st64((*gb).sc_offs, n, (io as u64) * (4 as u64))
                        rt.st32((*gb).sc_bv, n, vo)
                    }
                    n = n + 1
                    ri = ri + 1
                }
            }
            k = k + 1
        }
        if n > 0 {
            let tg0: u64 = mc_prof.prof_active_now()
            bind_vao(gb, pw(gb, p, P_VAO) as u32)
            gl33.gl_bind_tex_target(g, 1 as u32, gl33.GL_TEXTURE_BUFFER, pw(gb, p, P_GTEX) as u32)
            if (*gb).mode == MODE_INDIRECT {
                if (*gb).ind_buf == 0 as u32 {
                    (*gb).ind_buf = gl33.gl_gen_buffer(g)
                }
                gl33.gl_bind_buffer(g, gl33.GL_DRAW_INDIRECT_BUFFER, (*gb).ind_buf)
                gl33.gl_buffer_data(g, gl33.GL_DRAW_INDIRECT_BUFFER, (*gb).sc_bv, n * 20, gl33.GL_STREAM_DRAW)
                gl33.gl_multi_draw_indirect(g, gl33.GL_TRIANGLES, gl33.GL_UNSIGNED_INT, 0, n as i32, 0)
            } else {
                gl33.gl_multi_draw_elements_bv(g, gl33.GL_TRIANGLES, (*gb).sc_counts, gl33.GL_UNSIGNED_INT,
                    (*gb).sc_offs, n as i32, (*gb).sc_bv)
            }
            (*gb).calls = (*gb).calls + 1 as u64
            tglsum = tglsum + (mc_prof.prof_active_now() - tg0)
        }
        p = p + 1
    }
    (*gb).pend_n = 0
    (*gb).org_max = 0
    (*gb).batch = (*gb).batch + 1 as u64
    let tfe: u64 = mc_prof.prof_active_now()
    mc_prof.prof_add(mc_prof.PH_FLG, tglsum)
    mc_prof.prof_add(mc_prof.PH_FLB, (tfe - tfl) - tglsum)
}

fn be_end(o: u64) {
    let gb: *mut GlBackend = o as *mut GlBackend
    if (*gb).mode >= MODE_MULTI {
        flush_batch(gb)
    }
    bind_vao(gb, 0 as u32)
    gl33.gl_flush(&(*gb).g)
}

// Reads the finished frame back (blocks until the GPU is done): w*h*4 bytes RGBA, row 0 = top.
fn be_present(o: u64) -> u64 {
    let gb: *mut GlBackend = o as *mut GlBackend
    glbe_resolve(gb)
    if !(*gb).fresh {
        gl33.gl_fbo_bind(&(*gb).g, &(*gb).fbo)
        gl33.gl_read_rgba_top_down(&(*gb).g, (*gb).w, (*gb).h, (*gb).pix, (*gb).tmp)
        (*gb).fresh = true
    }
    return (*gb).pix
}

fn be_read(o: u64, out: u64) {
    let gb: *mut GlBackend = o as *mut GlBackend
    let p: u64 = be_present(o)
    rt.mem_copy(out, p, ((*gb).w as usize) * ((*gb).h as usize) * 4)
}

// The GL back end as a mc_backend.Backend table. `gb` must outlive the table.
fn glbe_backend(gb: *mut GlBackend) -> mc_backend.Backend {
    var b: mc_backend.Backend = mc_backend.backend_new()
    b.kind = mc_backend.KIND_GL
    b.obj = gb as u64
    b.upload_atlas = be_atlas
    b.mesh_upload = be_upload
    b.mesh_free = be_free
    b.begin = be_begin
    b.draw = be_draw
    b.end = be_end
    b.present = be_present
    b.read_pixels = be_read
    b.set_pass = be_set_pass
    b.set_light = be_set_light
    b.set_fade = be_set_fade
    b.mesh_class = be_mesh_class
    return b
}
