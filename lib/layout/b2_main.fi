// SPDX-License-Identifier: GPL-2.0-only
// lib/layout/b2_main.fi -- the driver of round B2 (root file).
//
// The same path as `layout_main.fi` -- HTML plus CSS in, geometry out --
// but it answers the questions the OFFICIAL Web Platform Tests ask. A
// layout test of the WPT css/ area carries its expectation IN the
// document:
//
//     <div data-expected-width="100" data-offset-y="20">
//
// and `resources/check-layout-th.js` holds those numbers against
// `offsetWidth`, `offsetLeft`, `clientHeight` and their kin -- the CSSOM
// View accessors, not pixels. That is a reference comparison a layout
// engine without a rasteriser can run in full, and it is why this round
// can be measured against a foreign suite at all.
//
// So this driver prints, for every element that carries at least one
// `data-` attribute, exactly the values check-layout-th.js reads:
//
//     offsetLeft offsetTop offsetWidth offsetHeight   (CSSOM View 5.3)
//     clientLeft clientTop clientWidth clientHeight
//     getBoundingClientRect().width / .height
//     scrollWidth scrollHeight
//     the computed `display`, the used margins and paddings
//
// plus the `data-` attributes themselves, so that the harness never has to
// parse the HTML a second time with a foreign parser. Comparing is then
// subtracting two numbers.
//
// The job format is the one of `layout_main.fi` (little-endian):
//     u32  viewport width in px
//     u32  viewport height in px
//     u32  n ; u8[n]   the HTML document (WTF-8)
//     u32  n ; u8[n]   the user agent stylesheet   (origin 0)
//     u32  n ; u8[n]   the author stylesheet       (origin 2)
//
// The output per job:
//     E <index> <parent> <tag>                       every element
//     G <index> ol ot ow oh cl ct cw ch rw rh sw sh  elements with data-
//     S <index> <display> mt mr mb ml pt pr pb pl    likewise
//     A <index> <attribute> <value>                  likewise
//     #END
//
// Compile with:  firnc -o build/layoutb2 lib/layout/b2_main.fi
import std.rt
import html.mem
import browser.node
import browser.names
import browser.driver
import css.tok
import css.cv
import css.sel
import css.cascade
import layout.box
import layout.build
import layout.flow

#[no_gc]
fn read_u32(b: *mut mem.Buf, off: usize) -> u32 {
    var v: u32 = 0
    var i: usize = 0
    while i < 4 {
        v = v | ((mem.buf_at(b, off + i) as u32) << (8 * i as u32))
        i = i + 1
    }
    return v
}

#[no_gc]
fn byte_at(base: u64, total: usize, k: usize) -> u32 {
    if k >= total {
        return 0 as u32
    }
    return (*((base + k as u64) as *mut u8)) as u32
}

#[no_gc]
fn decode_wtf8(b: *mut mem.Buf, off: usize, len: usize, out: *mut mem.CpBuf) {
    mem.cp_clear(out)
    let base: u64 = mem.buf_ptr(b) as u64
    let total: usize = mem.buf_len(b)
    var i: usize = 0
    while i < len {
        let c0: u32 = byte_at(base, total, off + i)
        if c0 < 0x80 as u32 {
            mem.cp_push(out, c0)
            i = i + 1
        } else if c0 >= 0xF0 as u32 {
            mem.cp_push(out, ((c0 & 0x07 as u32) << 18) |
                ((byte_at(base, total, off + i + 1) & 0x3F as u32) << 12) |
                ((byte_at(base, total, off + i + 2) & 0x3F as u32) << 6) |
                (byte_at(base, total, off + i + 3) & 0x3F as u32))
            i = i + 4
        } else if c0 >= 0xE0 as u32 {
            mem.cp_push(out, ((c0 & 0x0F as u32) << 12) |
                ((byte_at(base, total, off + i + 1) & 0x3F as u32) << 6) |
                (byte_at(base, total, off + i + 2) & 0x3F as u32))
            i = i + 3
        } else {
            mem.cp_push(out, ((c0 & 0x1F as u32) << 6) |
                (byte_at(base, total, off + i + 1) & 0x3F as u32))
            i = i + 2
        }
    }
}

// ------------------------------------------------------------ The output

#[no_gc]
fn lit(out: *mut mem.Buf, p: u64, n: usize) {
    var i: usize = 0
    while i < n {
        mem.buf_push(out, *((p + i as u64) as *mut u8))
        i = i + 1
    }
}

#[no_gc]
fn out_nl(out: *mut mem.Buf) {
    mem.buf_push(out, 10 as u8)
}

#[no_gc]
fn out_space(out: *mut mem.Buf) {
    mem.buf_push(out, 32 as u8)
}

#[no_gc]
fn out_i64(out: *mut mem.Buf, v: i64) {
    if v < 0 {
        mem.buf_push(out, 45 as u8)
        mem.buf_push_dec(out, (0 - v) as u64)
    } else {
        mem.buf_push_dec(out, v as u64)
    }
}

// Four decimal places, as in `layout_main.fi`: a browser computes in
// 1/64 px, and the fourth place is below anything that could be a real
// difference of the algorithm.
#[no_gc]
fn out_fixed(out: *mut mem.Buf, v: f64) {
    var x: f64 = v
    var negative: bool = false
    if x < 0.0 {
        negative = true
        x = 0.0 - x
    }
    let scaled: i64 = (x * 10000.0 + 0.5) as i64
    if negative && scaled != 0 {
        mem.buf_push(out, 45 as u8)
    }
    mem.buf_push_dec(out, (scaled / 10000) as u64)
    mem.buf_push(out, 46 as u8)
    var rest: i64 = scaled % 10000
    mem.buf_push(out, (48 + rest / 1000) as u8)
    mem.buf_push(out, (48 + (rest / 100) % 10) as u8)
    mem.buf_push(out, (48 + (rest / 10) % 10) as u8)
    mem.buf_push(out, (48 + rest % 10) as u8)
}

#[no_gc]
fn out_name(out: *mut mem.Buf, nm: *mut names.Names, id: u32) {
    let p: *mut u8 = names.names_ptr(nm, id)
    let n: usize = names.names_length(nm, id)
    if n == 0 {
        mem.buf_push(out, 63 as u8)
        return
    }
    var i: usize = 0
    while i < n {
        mem.buf_push(out, *((p as u64 + i as u64) as *mut u8))
        i = i + 1
    }
}

// An attribute value. Everything outside printable ASCII becomes `?`: the
// values this suite compares are numbers and keywords, and a value that
// needs more than that is one the harness must not silently mangle -- it
// would show up as a difference, which is the right place for it.
#[no_gc]
fn out_cp_ascii(out: *mut mem.Buf, c: *mut mem.CpBuf) {
    let n: usize = mem.cp_len(c)
    if n == 0 {
        mem.buf_push(out, 45 as u8)
        return
    }
    var i: usize = 0
    while i < n {
        let v: u32 = mem.cp_at(c, i)
        if v >= 33 as u32 && v < 127 as u32 {
            mem.buf_push(out, v as u8)
        } else {
            mem.buf_push(out, 63 as u8)
        }
        i = i + 1
    }
}

// ------------------------------------------- Stylesheets INSIDE the document

fn elem_text(k: Gc[Node], out: *mut mem.CpBuf) {
    mem.cp_clear(out)
    var c: Gc[Node] = k.first_child
    while c != gc_null[Node]() {
        if c.kind == node.K_TEXT {
            let t: Gc[Text] = c as Gc[Text]
            node.chain_after_cpbuf(t.data, out)
        }
        c = c.next
    }
}

fn chain_to_cpbuf(k: Gc[Chain], out: *mut mem.CpBuf) {
    mem.cp_clear(out)
    if k == gc_null[Chain]() {
        return
    }
    node.chain_after_cpbuf(k, out)
}

// ---------------------------------------------------------- The DOM walk

fn next_in_order(k: Gc[Node], root: Gc[Node]) -> Gc[Node] {
    if k.first_child != gc_null[Node]() {
        return k.first_child
    }
    var c: Gc[Node] = k
    while c != gc_null[Node]() && c != root {
        if c.next != gc_null[Node]() {
            return c.next
        }
        c = c.parent
    }
    return gc_null[Node]()
}

fn index_boxes(b: Gc[Box], table: Gc[GcMap]) -> AllocError!bool {
    if b.elem != gc_null[Node]() && b.elem.kind == node.K_ELEM {
        let ok: bool = try gcmap_set_value[Box](table, b.elem as u64, b)
    }
    var i: u64 = 0
    let n: u64 = box.box_kids(b)
    while i < n {
        let ok2: bool = try index_boxes(box.box_kid(b, i), table)
        i = i + 1
    }
    return true
}

// --------------------------------------------------------- The CSSOM View
//
// Everything below is CSSOM View 5.3 -- `offsetParent`, `offsetLeft`,
// `clientWidth` and their kin -- written out of the standard, because that
// is what the suite reads. Two things are worth naming:
//
//   * `offsetLeft` is measured against the PADDING edge of the
//     offsetParent, not against its border edge. Forget that and every
//     test whose container has a border is off by the border width.
//   * `clientWidth` of an INLINE box is zero, and of the ROOT element it
//     is the viewport -- not the padding box.

struct Names5 {
    body: u32,
    td: u32,
    th: u32,
    table: u32,
    style: u32,
}

fn box_of(table: Gc[GcMap], k: Gc[Node]) -> Gc[Box] {
    return gcmap_get_value[Box](table, k as u64)
}

fn style_of(styles: Gc[GcMap], k: Gc[Node]) -> Gc[Style] {
    return gcmap_get_value[Style](styles, k as u64)
}

fn elem_position(styles: Gc[GcMap], k: Gc[Node]) -> u32 {
    let s: Gc[Style] = style_of(styles, k)
    if s == gc_null[Style]() {
        return cascade.POS_STATIC
    }
    return cascade.style_position(s)
}

fn is_named(k: Gc[Node], id: u32) -> bool {
    if k == gc_null[Node]() || k.kind != node.K_ELEM {
        return false
    }
    return node.elem_name(k) == id
}

// The root element: the element child of the document.
fn is_root_elem(k: Gc[Node]) -> bool {
    let p: Gc[Node] = k.parent
    if p == gc_null[Node]() {
        return true
    }
    return p.kind == node.K_DOCUMENT
}

fn offset_parent(k: Gc[Node], styles: Gc[GcMap], table: Gc[GcMap],
    nn: *mut Names5) -> Gc[Node] {
    if box_of(table, k) == gc_null[Box]() {
        return gc_null[Node]()
    }
    if is_root_elem(k) || is_named(k, (*nn).body) {
        return gc_null[Node]()
    }
    let own: u32 = elem_position(styles, k)
    if own == cascade.POS_FIXED {
        return gc_null[Node]()
    }
    var a: Gc[Node] = k.parent
    while a != gc_null[Node]() && a.kind == node.K_ELEM {
        if elem_position(styles, a) != cascade.POS_STATIC {
            return a
        }
        if is_named(a, (*nn).body) {
            return a
        }
        if own == cascade.POS_STATIC {
            if is_named(a, (*nn).td) || is_named(a, (*nn).th) ||
            is_named(a, (*nn).table) {
                return a
            }
        }
        a = a.parent
    }
    return gc_null[Node]()
}

// THE BODY IS NOT SUBTRACTED. CSSOM View says `offsetLeft` is measured
// against the PADDING EDGE of the offsetParent -- but when that
// offsetParent is the unpositioned `body`, every engine returns the
// coordinate in the initial containing block instead, and the WPT
// expectations are written for that. Measured, not guessed: a `div` in a
// `body` with `margin: 8px; border: 4px; padding: 6px` reports
// `offsetLeft` 18 in Chromium 141, and 18 is its distance from the ICB,
// not 0 from the padding edge of the body (tools/layoutb2/chrome_check.py
// asks the browser the same question for the whole corpus).
fn is_body_reference(op: Gc[Node], styles: Gc[GcMap], nn: *mut Names5) -> bool {
    if !is_named(op, (*nn).body) {
        return false
    }
    return elem_position(styles, op) == cascade.POS_STATIC
}

fn offset_left(k: Gc[Node], styles: Gc[GcMap], table: Gc[GcMap],
    nn: *mut Names5) -> f64 {
    let b: Gc[Box] = box_of(table, k)
    if b == gc_null[Box]() || is_named(k, (*nn).body) {
        return 0.0
    }
    let op: Gc[Node] = offset_parent(k, styles, table, nn)
    if op == gc_null[Node]() || is_body_reference(op, styles, nn) {
        return b.x
    }
    let ob: Gc[Box] = box_of(table, op)
    if ob == gc_null[Box]() {
        return b.x
    }
    return b.x - (ob.x + ob.bl)
}

fn offset_top(k: Gc[Node], styles: Gc[GcMap], table: Gc[GcMap],
    nn: *mut Names5) -> f64 {
    let b: Gc[Box] = box_of(table, k)
    if b == gc_null[Box]() || is_named(k, (*nn).body) {
        return 0.0
    }
    let op: Gc[Node] = offset_parent(k, styles, table, nn)
    if op == gc_null[Node]() || is_body_reference(op, styles, nn) {
        return b.y
    }
    let ob: Gc[Box] = box_of(table, op)
    if ob == gc_null[Box]() {
        return b.y
    }
    return b.y - (ob.y + ob.bt)
}

// An inline box has no client rectangle at all (CSSOM View: "or if the CSS
// layout box is inline").
fn is_inline_box(b: Gc[Box]) -> bool {
    return b.kind == box.BK_INLINE
}

fn client_width(k: Gc[Node], table: Gc[GcMap], vw: f64) -> f64 {
    let b: Gc[Box] = box_of(table, k)
    if b == gc_null[Box]() || is_inline_box(b) {
        return 0.0
    }
    if is_root_elem(k) {
        return vw
    }
    var v: f64 = b.w - b.bl - b.br
    if v < 0.0 {
        v = 0.0
    }
    return v
}

fn client_height(k: Gc[Node], table: Gc[GcMap], vh: f64) -> f64 {
    let b: Gc[Box] = box_of(table, k)
    if b == gc_null[Box]() || is_inline_box(b) {
        return 0.0
    }
    if is_root_elem(k) {
        return vh
    }
    var v: f64 = b.h - b.bt - b.bb
    if v < 0.0 {
        v = 0.0
    }
    return v
}

// The scrolling area of an element (CSSOM View 5.3, "scrolling area"): the
// union of its padding box with the border boxes of everything below it.
// Overflow to the left and to the top is CUT AWAY -- the area never
// reaches past the padding edge on the start side, which is why only the
// right and the bottom edge are collected here.
fn scroll_extent(b: Gc[Box], right: *mut f64, bottom: *mut f64) {
    var i: u64 = 0
    let n: u64 = box.box_kids(b)
    while i < n {
        let c: Gc[Box] = box.box_kid(b, i)
        if c.x + c.w > *right {
            *right = c.x + c.w
        }
        if c.y + c.h > *bottom {
            *bottom = c.y + c.h
        }
        scroll_extent(c, right, bottom)
        i = i + 1
    }
}

fn scroll_width(k: Gc[Node], table: Gc[GcMap], vw: f64) -> f64 {
    let b: Gc[Box] = box_of(table, k)
    if b == gc_null[Box]() {
        return 0.0
    }
    let left: f64 = b.x + b.bl
    var right: f64 = b.x + b.w - b.br
    var bottom_ignored: f64 = 0.0
    scroll_extent(b, &right, &bottom_ignored)
    var v: f64 = right - left
    if is_root_elem(k) && v < vw {
        v = vw
    }
    if v < 0.0 {
        v = 0.0
    }
    return v
}

fn scroll_height(k: Gc[Node], table: Gc[GcMap], vh: f64) -> f64 {
    let b: Gc[Box] = box_of(table, k)
    if b == gc_null[Box]() {
        return 0.0
    }
    let top: f64 = b.y + b.bt
    var bottom: f64 = b.y + b.h - b.bb
    var right_ignored: f64 = 0.0
    scroll_extent(b, &right_ignored, &bottom)
    var v: f64 = bottom - top
    if is_root_elem(k) && v < vh {
        v = vh
    }
    if v < 0.0 {
        v = 0.0
    }
    return v
}

// The computed `display`, as `getComputedStyle().display` spells it.
fn out_display(out: *mut mem.Buf, s: Gc[Style]) {
    var w_inline: [u8; 6] = "inline"
    var w_block: [u8; 5] = "block"
    var w_ib: [u8; 12] = "inline-block"
    var w_none: [u8; 4] = "none"
    var w_li: [u8; 9] = "list-item"
    var w_flex: [u8; 4] = "flex"
    var w_iflex: [u8; 11] = "inline-flex"
    var w_grid: [u8; 4] = "grid"
    var w_table: [u8; 5] = "table"
    var w_row: [u8; 9] = "table-row"
    var w_cell: [u8; 10] = "table-cell"
    var w_itable: [u8; 12] = "inline-table"
    if s == gc_null[Style]() {
        lit(out, (&w_inline[0]) as u64, 6)
        return
    }
    let d: u32 = cascade.style_display(s)
    if d == cascade.D_BLOCK {
        lit(out, (&w_block[0]) as u64, 5)
    } else if d == cascade.D_INLINE_BLOCK {
        lit(out, (&w_ib[0]) as u64, 12)
    } else if d == cascade.D_NONE {
        lit(out, (&w_none[0]) as u64, 4)
    } else if d == cascade.D_LIST_ITEM {
        lit(out, (&w_li[0]) as u64, 9)
    } else if d == cascade.D_FLEX {
        lit(out, (&w_flex[0]) as u64, 4)
    } else if d == cascade.D_INLINE_FLEX {
        lit(out, (&w_iflex[0]) as u64, 11)
    } else if d == cascade.D_GRID {
        lit(out, (&w_grid[0]) as u64, 4)
    } else if d == cascade.D_TABLE {
        lit(out, (&w_table[0]) as u64, 5)
    } else if d == cascade.D_TABLE_ROW {
        lit(out, (&w_row[0]) as u64, 9)
    } else if d == cascade.D_TABLE_CELL {
        lit(out, (&w_cell[0]) as u64, 10)
    } else if d == cascade.D_INLINE_TABLE {
        lit(out, (&w_itable[0]) as u64, 12)
    } else {
        lit(out, (&w_inline[0]) as u64, 6)
    }
}

// ------------------------------------------------------------ The job

fn parse_sheet(text: *mut mem.CpBuf, t: *mut tok.Tokens) -> AllocError!Gc[Cv] {
    tok.tokenize(t, text)
    var p: cv.Parser = cv.parser_new(t)
    return try cv.parse_stylesheet(&p)
}

fn chain_last(r: Gc[Rule]) -> Gc[Rule] {
    var x: Gc[Rule] = r
    while x != gc_null[Rule]() && x.next != gc_null[Rule]() {
        x = x.next
    }
    return x
}

fn add_sheet(head: Gc[Rule], sheet: Gc[Cv], origin: u32, order: *mut u32,
    nm: *mut names.Names, tmp: *mut mem.CpBuf) -> AllocError!Gc[Rule] {
    var next_order: u32 = *order
    let part = try cascade.collect_rules(sheet, origin, next_order, nm, tmp,
        &next_order)
    *order = next_order
    if part == gc_null[Rule]() {
        return head
    }
    if head == gc_null[Rule]() {
        return part
    }
    let last: Gc[Rule] = chain_last(head)
    last.next = part
    return head
}

#[no_gc]
fn name_is_data(nm: *mut names.Names, id: u32) -> bool {
    let n: usize = names.names_length(nm, id)
    if n < 6 {
        return false
    }
    let p: u64 = names.names_ptr(nm, id) as u64
    var d: [u8; 5] = "data-"
    var i: usize = 0
    while i < 5 {
        if *((p + i as u64) as *mut u8) != d[i] {
            return false
        }
        i = i + 1
    }
    return true
}

fn has_data_attr(k: Gc[Node], nm: *mut names.Names) -> bool {
    let e: Gc[Elem] = node.node_as_elem(k)
    if e == gc_null[Elem]() {
        return false
    }
    var a: Gc[Attr] = node.attr_first(e)
    while a != gc_null[Attr]() {
        if name_is_data(nm, a.name) {
            return true
        }
        a = a.next
    }
    return false
}

// THE REFLOW MODE. With the argument `--reflow` every document is laid
// out THREE times -- at the asked width, at 400 px, and at the asked
// width again -- and only the last result is printed. A document whose
// output then differs from the one of a single layout has a layout that
// remembers something it must not (docs/ROUNDB2.md).
fn wants_reflow(start: u64) -> bool {
    var i: usize = 1
    let n: usize = rt.arg_count(start)
    var word: [u8; 8] = "--reflow"
    while i < n {
        let p: u64 = rt.arg_ptr(start, i)
        if p != 0 && rt.c_length(p) == 8 {
            var k: usize = 0
            var same: bool = true
            while k < 8 {
                if rt.ld8(p, k) != word[k] {
                    same = false
                }
                k = k + 1
            }
            if same {
                return true
            }
        }
        i = i + 1
    }
    return false
}

fn main(start: u64) -> i32 {
    if !gc_init() {
        return 90
    }
    let reflow: bool = wants_reflow(start)
    var run: driver.Run = driver.run_new()
    if !driver.run_init(&run) {
        return 91
    }
    var t: tok.Tokens = tok.tokens_new()
    tok.tokens_init(&t)
    var text: mem.CpBuf = mem.cp_new()
    var tmp: mem.CpBuf = mem.cp_new()
    var cx: sel.Ctx = sel.ctx_new(driver.run_names(&run))
    sel.ctx_init(&cx)
    var w: cascade.Winner = cascade.winner_new()

    var ins: mem.Buf = mem.buf_new()
    mem.read_all_stdin(&ins)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)

    var style_word: [u8; 5] = "style"
    var body_word: [u8; 4] = "body"
    var td_word: [u8; 2] = "td"
    var th_word: [u8; 2] = "th"
    var table_word: [u8; 5] = "table"
    let nm0: *mut names.Names = driver.run_names(&run)
    var nn: Names5 = Names5 {
        body: names.names_of_bytes(nm0, &body_word[0], 4),
        td: names.names_of_bytes(nm0, &td_word[0], 2),
        th: names.names_of_bytes(nm0, &th_word[0], 2),
        table: names.names_of_bytes(nm0, &table_word[0], 5),
        style: names.names_of_bytes(nm0, &style_word[0], 5),
    }

    let total: usize = mem.buf_len(&ins)
    var off: usize = 0
    while off + 20 <= total {
        let vw: f64 = read_u32(&ins, off) as f64
        let vh: f64 = read_u32(&ins, off + 4) as f64
        let n_html: usize = read_u32(&ins, off + 8) as usize
        let o_html: usize = off + 12
        let n_ua: usize = read_u32(&ins, o_html + n_html) as usize
        let o_ua: usize = o_html + n_html + 4
        let n_author: usize = read_u32(&ins, o_ua + n_ua) as usize
        let o_author: usize = o_ua + n_ua + 4
        if o_html + n_html > total || o_ua + n_ua > total ||
        o_author + n_author > total {
            off = total
            break
        }
        off = o_author + n_author

        // ---- 1. HTML -> DOM
        driver.run_text_out_bytes(&run,
            ((mem.buf_ptr(&ins) as u64) + o_html as u64) as *mut u8, n_html)
        let rc: u32 = driver.run_document_build(&run)
        if rc != 0 as u32 {
            var broken: [u8; 8] = "#BROKEN "
            lit(&out, (&broken[0]) as u64, 8)
            mem.buf_push_dec(&out, rc as u64)
            out_nl(&out)
        }
        let doc: Gc[Document] = driver.run_document(&run)
        let nm: *mut names.Names = driver.run_names(&run)

        // ---- 2. the stylesheets
        var rules: Gc[Rule] = gc_null[Rule]()
        var order: u32 = 0
        decode_wtf8(&ins, o_ua, n_ua, &text)
        let ua = parse_sheet(&text, &t) catch gc_null[Cv]()
        rules = add_sheet(rules, ua, cascade.ORIGIN_UA, &order, nm, &tmp)
        catch gc_null[Rule]()
        decode_wtf8(&ins, o_author, n_author, &text)
        let author = parse_sheet(&text, &t) catch gc_null[Cv]()
        rules = add_sheet(rules, author, cascade.ORIGIN_AUTHOR, &order, nm, &tmp)
        catch gc_null[Rule]()
        var sk: Gc[Node] = doc
        while sk != gc_null[Node]() {
            if sk.kind == node.K_ELEM && node.elem_name(sk) == nn.style {
                elem_text(sk, &text)
                let inner = parse_sheet(&text, &t) catch gc_null[Cv]()
                rules = add_sheet(rules, inner, cascade.ORIGIN_AUTHOR, &order,
                    nm, &tmp) catch gc_null[Rule]()
            }
            sk = next_in_order(sk, doc)
        }

        // ---- 3. the cascade per elem
        var styles: Gc[GcMap] = gcmap_new(true, true) catch gc_null[GcMap]()
        let root_style = cascade.style_root() catch gc_null[Style]()
        sel.ctx_set_hover(&cx, gc_null[Node]())
        var k: Gc[Node] = doc
        while k != gc_null[Node]() {
            if k.kind == node.K_ELEM {
                var parent_style: Gc[Style] = root_style
                let parent: Gc[Node] = k.parent
                if parent != gc_null[Node]() && parent.kind == node.K_ELEM {
                    let found: Gc[Style] = gcmap_get_value[Style](styles,
                        parent as u64)
                    if found != gc_null[Style]() {
                        parent_style = found
                    }
                }
                var inline_decls: Gc[GcVec] = gc_null[GcVec]()
                let e: Gc[Elem] = node.node_as_elem(k)
                let av: Gc[Chain] = node.attr_value(e, nn.style, 0)
                if av != gc_null[Chain]() && node.chain_len(av) > 0 {
                    chain_to_cpbuf(av, &tmp)
                    tok.tokenize(&t, &tmp)
                    var ip: cv.Parser = cv.parser_new(&t)
                    let values = cv.parse_component_value_list(&ip)
                    catch gc_null[Cv]()
                    if values != gc_null[Cv]() {
                        inline_decls = cascade.parse_inline_declarations(values)
                        catch gc_null[GcVec]()
                    }
                }
                let s = cascade.cascade_elem_inline(rules, k, parent_style,
                    &cx, &w, inline_decls)
                catch gc_null[Style]()
                if s != gc_null[Style]() {
                    let ok: bool = gcmap_set_value[Style](styles, k as u64, s)
                    catch false
                }
            }
            k = next_in_order(k, doc)
        }

        // ---- 4. DOM -> box tree -> geometry
        let root: Gc[Box] = build.build_document(doc, styles, root_style, nm)
        catch gc_null[Box]()
        var table: Gc[GcMap] = gcmap_new(true, true) catch gc_null[GcMap]()
        if root != gc_null[Box]() {
            let okl: bool = flow.layout_document(root, vw, vh) catch false
            if reflow {
                let ok2: bool = flow.relayout_document(root, 400.0, vh)
                catch false
                let ok3: bool = flow.relayout_document(root, vw, vh) catch false
            }
            let oki: bool = index_boxes(root, table) catch false
        }

        // ---- 5. the report
        var index: Gc[GcMap] = gcmap_new(true, false) catch gc_null[GcMap]()
        var count: u64 = 0
        k = doc
        while k != gc_null[Node]() {
            if k.kind == node.K_ELEM {
                let ok2: bool = gcmap_set(index, k as u64, count + 1) catch false
                count = count + 1
            }
            k = next_in_order(k, doc)
        }
        k = doc
        var walk: u64 = 0
        while k != gc_null[Node]() {
            if k.kind == node.K_ELEM {
                var e0: [u8; 2] = "E "
                lit(&out, (&e0[0]) as u64, 2)
                mem.buf_push_dec(&out, walk)
                out_space(&out)
                let parent: Gc[Node] = k.parent
                var pi: u64 = 0
                if parent != gc_null[Node]() && parent.kind == node.K_ELEM {
                    pi = gcmap_get(index, parent as u64, 0)
                }
                if pi == 0 {
                    out_i64(&out, 0 - 1)
                } else {
                    mem.buf_push_dec(&out, pi - 1)
                }
                out_space(&out)
                out_name(&out, nm, node.elem_name(k))
                out_nl(&out)

                if has_data_attr(k, nm) {
                    let b: Gc[Box] = box_of(table, k)
                    var g0: [u8; 2] = "G "
                    lit(&out, (&g0[0]) as u64, 2)
                    mem.buf_push_dec(&out, walk)
                    out_space(&out)
                    out_fixed(&out, offset_left(k, styles, table, &nn))
                    out_space(&out)
                    out_fixed(&out, offset_top(k, styles, table, &nn))
                    out_space(&out)
                    if b == gc_null[Box]() {
                        out_fixed(&out, 0.0)
                        out_space(&out)
                        out_fixed(&out, 0.0)
                        out_space(&out)
                        out_fixed(&out, 0.0)
                        out_space(&out)
                        out_fixed(&out, 0.0)
                    } else {
                        out_fixed(&out, b.w)
                        out_space(&out)
                        out_fixed(&out, b.h)
                        out_space(&out)
                        if is_inline_box(b) {
                            out_fixed(&out, 0.0)
                            out_space(&out)
                            out_fixed(&out, 0.0)
                        } else {
                            out_fixed(&out, b.bl)
                            out_space(&out)
                            out_fixed(&out, b.bt)
                        }
                    }
                    out_space(&out)
                    out_fixed(&out, client_width(k, table, vw))
                    out_space(&out)
                    out_fixed(&out, client_height(k, table, vh))
                    out_space(&out)
                    if b == gc_null[Box]() {
                        out_fixed(&out, 0.0)
                        out_space(&out)
                        out_fixed(&out, 0.0)
                    } else {
                        out_fixed(&out, b.w)
                        out_space(&out)
                        out_fixed(&out, b.h)
                    }
                    out_space(&out)
                    out_fixed(&out, scroll_width(k, table, vw))
                    out_space(&out)
                    out_fixed(&out, scroll_height(k, table, vh))
                    out_nl(&out)

                    var s0: [u8; 2] = "S "
                    lit(&out, (&s0[0]) as u64, 2)
                    mem.buf_push_dec(&out, walk)
                    out_space(&out)
                    out_display(&out, style_of(styles, k))
                    var mi: usize = 0
                    while mi < 8 {
                        out_space(&out)
                        if b == gc_null[Box]() {
                            out_fixed(&out, 0.0)
                        } else if mi == 0 {
                            out_fixed(&out, b.mt)
                        } else if mi == 1 {
                            out_fixed(&out, b.mr)
                        } else if mi == 2 {
                            out_fixed(&out, b.mb)
                        } else if mi == 3 {
                            out_fixed(&out, b.ml)
                        } else if mi == 4 {
                            out_fixed(&out, b.pt)
                        } else if mi == 5 {
                            out_fixed(&out, b.pr)
                        } else if mi == 6 {
                            out_fixed(&out, b.pb)
                        } else {
                            out_fixed(&out, b.pl)
                        }
                        mi = mi + 1
                    }
                    out_nl(&out)

                    let e2: Gc[Elem] = node.node_as_elem(k)
                    var a: Gc[Attr] = node.attr_first(e2)
                    while a != gc_null[Attr]() {
                        if name_is_data(nm, a.name) {
                            var a0: [u8; 2] = "A "
                            lit(&out, (&a0[0]) as u64, 2)
                            mem.buf_push_dec(&out, walk)
                            out_space(&out)
                            out_name(&out, nm, a.name)
                            out_space(&out)
                            chain_to_cpbuf(a.value, &tmp)
                            out_cp_ascii(&out, &tmp)
                            out_nl(&out)
                        }
                        a = a.next
                    }
                }
                walk = walk + 1
            }
            k = next_in_order(k, doc)
        }

        var tail: [u8; 5] = "#END\n"
        lit(&out, (&tail[0]) as u64, 5)
        if mem.buf_len(&out) > 65536 {
            mem.buf_flush(&out, 1)
        }
        driver.run_tree_release(&run)
    }
    mem.buf_flush(&out, 1)
    return 0
}
