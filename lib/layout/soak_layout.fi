// SPDX-License-Identifier: GPL-2.0-only
// lib/layout/soak_layout.fi -- THE ENDURANCE RUN of the layout path.
//
// Every round builds the WHOLE chain out of one document and one
// stylesheet -- DOM, component values, rules, the style table, the BOX
// TREE with its line boxes, the inline items and the fragments -- and then
// drops all of it. The memory consumption has to stay FLAT.
//
// Why the box tree is the harder test of the two: it has more back
// references than the DOM. A box holds its style, its elem, its
// children, its inline items and its line boxes; an item holds a box; a
// fragment holds the box it belongs to; and an inline box that runs over
// three lines is pointed at by three fragments. A reference count would
// keep all of it alive as soon as any one of them survived.
//
// The input (stdin, 12 bytes): u32 rounds, u32 budget_ms, u32 leak.
//
// `leak != 0` turns the COUNTER CHECK on: every box tree built is held on
// to in a GC chain. Then the consumption MUST rise -- a measurement that
// cannot show a leak is worthless, which is why tools/layout/gc_layout.sh
// aborts when the counter check stays flat.
//
// The output: TSV on stdout, one line per SAMPLE rounds:
//     t_ms  rounds  boxes  rss_kib  live  runs  heap_bytes  pause_max_ns
import html.mem
import browser.node
import browser.names
import browser.driver
import css.tok
import css.cv
import css.sel
import css.cascade
import layout.box
import layout.build
import layout.flow
import dom.meas

const DEFAULT_ROUNDS: u64 = 20000
const DEFAULT_BUDGET_MS: i64 = 10000
const SAMPLE: u64 = 100
const SOURCE_LEN: usize = 425
const SHEET_LEN: usize = 462

// The document of each round: block flow, inline flow over several lines,
// a float, an inline-block, an absolutely positioned box and a flex
// container -- so that every path of lib/layout/ is walked in every round.
#[no_gc]
fn source(out: *mut mem.Buf) {
    var t: [u8; 425] = "<!DOCTYPE html><html><head><title>soak</title></head><body class=\"page\"><div class=\"wrap\"><div class=\"float\"></div><p class=\"lead\">one two three four five six seven eight nine ten</p><p>tail <span class=\"in\">inline box</span> end</p></div><div class=\"rel\"><div class=\"abs\"></div></div><div class=\"flex\"><div class=\"a\"></div><div class=\"b\"></div><div class=\"c\"></div></div><ul><li>a</li><li>b</li><li>c</li></ul></body></html>"
    mem.buf_clear(out)
    var i: usize = 0
    while i < SOURCE_LEN {
        mem.buf_push(out, t[i])
        i = i + 1
    }
}

#[no_gc]
fn sheet(out: *mut mem.CpBuf) {
    var t: [u8; 462] = "html{font-size:16px}body{display:block;margin:8px}div,p,ul,li{display:block}.wrap{width:400px;padding:5px;border:2px solid #000;margin:10px}.float{float:left;width:80px;height:60px;margin-right:8px}.lead{margin:0 0 12px 0}.in{padding:2px 4px;border-left:1px solid red}.rel{position:relative;left:5px;width:200px;height:50px}.abs{position:absolute;left:10px;top:10px;width:30px;height:30px}.flex{display:flex;width:300px}.a{flex:1 1 0}.b{width:50px}.c{flex:2 1 0}"
    mem.cp_clear(out)
    var i: usize = 0
    while i < SHEET_LEN {
        mem.cp_push(out, t[i] as u32)
        i = i + 1
    }
}

// Holds a box tree fast -- for the counter check only.
gc class Holder {
    tree: Gc[Box],
    next: Gc[Holder],
}

fn scrub_deep(n: u64) {
    var buffer: [u64; 512] = [0; 512]
    var i: usize = 0
    while i < 512 {
        buffer[i] = 0
        i = i + 1
    }
    barrier(&buffer)
    if n > 0 {
        scrub_deep(n - 1)
    }
}

fn line(t_ms: u64, rounds: u64, boxes: u64, rss: u64, live: u64,
    runs: u64, heap: u64, pause: u64) {
    meas.meas_u64(t_ms)
    meas.meas_tab()
    meas.meas_u64(rounds)
    meas.meas_tab()
    meas.meas_u64(boxes)
    meas.meas_tab()
    meas.meas_u64(rss)
    meas.meas_tab()
    meas.meas_u64(live)
    meas.meas_tab()
    meas.meas_u64(runs)
    meas.meas_tab()
    meas.meas_u64(heap)
    meas.meas_tab()
    meas.meas_u64(pause)
    meas.meas_nl()
}

fn text_out(p: u64, n: i64) {
    meas.meas_write(p, n)
}

fn next_in_order(k: Gc[Node], root: Gc[Node]) -> Gc[Node] {
    if k.first_child != gc_null[Node]() {
        return k.first_child
    }
    var c: Gc[Node] = k
    while c != gc_null[Node]() && c != root {
        if c.next != gc_null[Node]() {
            return c.next
        }
        c = c.parent
    }
    return gc_null[Node]()
}

fn count_boxes(b: Gc[Box]) -> u64 {
    var n: u64 = 1
    var i: u64 = 0
    while i < box.box_kids(b) {
        n = n + count_boxes(box.box_kid(b, i))
        i = i + 1
    }
    return n
}

// One complete round. Returns the number of boxes, 0 = error.
fn one_round(l: *mut driver.Run, src: *mut mem.Buf, css: *mut mem.CpBuf,
    t: *mut tok.Tokens, tmp: *mut mem.CpBuf, cx: *mut sel.Ctx,
    w: *mut cascade.Winner, keep: *mut Gc[Box]) -> AllocError!u64 {
    driver.run_text_out_bytes(l, mem.buf_ptr(src), mem.buf_len(src))
    let rc: u32 = driver.run_document_build(l)
    if rc != 0 as u32 {
        return 0
    }
    let doc: Gc[Document] = driver.run_document(l)
    let nm: *mut names.Names = driver.run_names(l)
    tok.tokenize(t, css)
    var p: cv.Parser = cv.parser_new(t)
    let sheet_tree = try cv.parse_stylesheet(&p)
    var order: u32 = 0
    let rules = try cascade.collect_rules(sheet_tree, cascade.ORIGIN_AUTHOR, 0,
        nm, tmp, &order)
    let styles = try gcmap_new(true, true)
    let root_style = try cascade.style_root()
    var k: Gc[Node] = doc
    while k != gc_null[Node]() {
        if k.kind == node.K_ELEM {
            var parent_style: Gc[Style] = root_style
            let parent: Gc[Node] = k.parent
            if parent != gc_null[Node]() && parent.kind == node.K_ELEM {
                let found: Gc[Style] = gcmap_get_value[Style](styles,
                    parent as u64)
                if found != gc_null[Style]() {
                    parent_style = found
                }
            }
            let s = try cascade.cascade_elem(rules, k, parent_style, cx, w)
            let ok: bool = try gcmap_set_value[Style](styles, k as u64, s)
        }
        k = next_in_order(k, doc)
    }
    let root = try build.build_document(doc, styles, root_style, nm)
    if root == gc_null[Box]() {
        return 0
    }
    let okl: bool = try flow.layout_document(root, 800.0, 600.0)
    *keep = root
    return count_boxes(root)
}

fn main() -> i32 {
    if !gc_init() {
        return 2
    }
    var rounds_max: u64 = DEFAULT_ROUNDS
    var budget: i64 = DEFAULT_BUDGET_MS
    var leak: bool = false
    var ins: mem.Buf = mem.buf_new()
    mem.read_all_stdin(&ins)
    if mem.buf_len(&ins) >= 8 {
        var v: u64 = 0
        var i: usize = 0
        while i < 4 {
            v = v | ((mem.buf_at(&ins, i) as u64) << (8 * i as u64))
            i = i + 1
        }
        if v > 0 {
            rounds_max = v
        }
        var x: u64 = 0
        i = 0
        while i < 4 {
            x = x | ((mem.buf_at(&ins, 4 + i) as u64) << (8 * i as u64))
            i = i + 1
        }
        if x > 0 {
            budget = x as i64
        }
        if mem.buf_len(&ins) >= 12 {
            var lw: u64 = 0
            i = 0
            while i < 4 {
                lw = lw | ((mem.buf_at(&ins, 8 + i) as u64) << (8 * i as u64))
                i = i + 1
            }
            leak = lw != 0
        }
    }
    mem.buf_free(&ins)

    var header: [u8; 93] = "# firn-layout-soak v1\n# columns: t_ms\trounds\tboxes\trss_kib\tlive\truns\theap_bytes\tpause_max_ns\n"
    text_out((&header) as u64, 93)

    var src: mem.Buf = mem.buf_new()
    mem.buf_init(&src)
    source(&src)
    var css: mem.CpBuf = mem.cp_new()
    mem.cp_init(&css)
    sheet(&css)
    var t: tok.Tokens = tok.tokens_new()
    tok.tokens_init(&t)
    var tmp: mem.CpBuf = mem.cp_new()

    var l: driver.Run = driver.run_new()
    if !driver.run_init(&l) {
        return 3
    }
    var cx: sel.Ctx = sel.ctx_new(driver.run_names(&l))
    sel.ctx_init(&cx)
    var w: cascade.Winner = cascade.winner_new()

    let t0: u64 = meas.meas_now_ms()
    var rounds: u64 = 0
    var per_round: u64 = 0
    var chain: Gc[Holder] = gc_null[Holder]()
    var keep: Gc[Box] = gc_null[Box]()
    while rounds < rounds_max {
        keep = gc_null[Box]()
        let n: u64 = one_round(&l, &src, &css, &t, &tmp, &cx, &w, &keep)
        catch 0
        if n == 0 {
            var f: [u8; 19] = "# error in a round\n"
            text_out((&f) as u64, 19)
            return 4
        }
        if per_round == 0 {
            per_round = n
        } else if per_round != n {
            var f2: [u8; 24] = "# the box count wobbles\n"
            text_out((&f2) as u64, 24)
            return 5
        }
        if leak {
            let h = gc Holder { tree: keep, next: chain } catch gc_null[Holder]()
            if h == gc_null[Holder]() {
                var fo: [u8; 21] = "# out of memory (gc)\n"
                text_out((&fo) as u64, 21)
                return 6
            }
            chain = h
        }
        keep = gc_null[Box]()
        rounds = rounds + 1
        if rounds % SAMPLE == 0 {
            driver.run_tree_release(&l)
            scrub_deep(3)
            let ms: u64 = meas.meas_now_ms() - t0
            line(ms, rounds, per_round, meas.meas_rss_kib(),
                gc_live_objects(), gc_collections(), gc_heap_bytes(),
                gc_pause_ns_max())
            if ms as i64 >= budget {
                break
            }
        }
    }
    var ez: [u8; 10] = "# created="
    text_out((&ez) as u64, 10)
    meas.meas_u64(gc_diag(6))
    var ez2: [u8; 6] = " live="
    text_out((&ez2) as u64, 6)
    meas.meas_u64(gc_live_objects())
    var ez3: [u8; 6] = " leak="
    text_out((&ez3) as u64, 6)
    if leak {
        meas.meas_u64(1)
    } else {
        meas.meas_u64(0)
    }
    meas.meas_nl()
    if leak && chain == gc_null[Holder]() {
        return 7
    }
    var e: [u8; 7] = "# done\n"
    text_out((&e) as u64, 7)
    driver.run_free(&l)
    return 0
}
