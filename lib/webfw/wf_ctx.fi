import std.rt
import std.vec
import std.json
import std.io
import http.server as http
import webfw.wf_types
import webfw.wf_text

export {
    ctx_new, ctx_free, method, path, header, param, query, form, cookie, body, client_ip,
    set_status, set_header, set_cookie, text, html, json_raw, json_out, json_error, redirect,
    send_bytes, json_in, json_str, json_int, json_bool_or, header_block, status_error,
}

fn ctx_new(r: *mut http.Req, w: *mut wf_types.Web) -> wf_types.Ctx {
    return wf_types.Ctx { req: r, web: w, status: 200, ctype: "text/plain; charset=utf-8",
        headers: rt.buf_new(), body: rt.buf_new(), pkeys: vec_new[str](), pvals: vec_new[str](),
        sid: "", sid_new: false, jdoc: json.json_new(), jstate: 0 }
}

fn ctx_free(c: *mut wf_types.Ctx) {
    rt.buf_free(&(*c).headers)
    rt.buf_free(&(*c).body)
    vec_free[str](&(*c).pkeys)
    vec_free[str](&(*c).pvals)
    json.json_free(&(*c).jdoc)
}

fn method(c: *mut wf_types.Ctx) -> str { return http.method((*c).req) }
fn path(c: *mut wf_types.Ctx) -> str { return http.path((*c).req) }
fn header(c: *mut wf_types.Ctx, name: str) -> str { return http.header((*c).req, name) }
fn body(c: *mut wf_types.Ctx) -> str { return http.body((*c).req) }
fn client_ip(c: *mut wf_types.Ctx) -> str { return http.peer_text((*c).req) }

fn param(c: *mut wf_types.Ctx, name: str) -> str {
    var i: usize = 0
    while i < vec_len[str](&(*c).pkeys) {
        if *vec_elem_ptr[str](&(*c).pkeys, i) == name { return *vec_elem_ptr[str](&(*c).pvals, i) }
        i = i + 1
    }
    return ""
}

fn query(c: *mut wf_types.Ctx, name: str) -> str {
    var v: str = ""
    wf_text.pair_find(http.query((*c).req), name, 38 as u8, true, &v)
    return v
}

fn form(c: *mut wf_types.Ctx, name: str) -> str {
    var v: str = ""
    wf_text.pair_find(http.body((*c).req), name, 38 as u8, true, &v)
    return v
}

fn cookie(c: *mut wf_types.Ctx, name: str) -> str {
    var v: str = ""
    wf_text.pair_find(http.header((*c).req, "Cookie"), name, 59 as u8, false, &v)
    return v
}

fn set_status(c: *mut wf_types.Ctx, status: u32) { (*c).status = status }

fn set_header(c: *mut wf_types.Ctx, name: str, value: str) {
    wf_text.push(&(*c).headers, name)
    wf_text.push(&(*c).headers, ": ")
    wf_text.push(&(*c).headers, value)
    wf_text.push(&(*c).headers, "\r\n")
}

fn set_cookie(c: *mut wf_types.Ctx, name: str, value: str, max_age: i64, http_only: bool) {
    var b: rt.Buf = rt.buf_new()
    wf_text.push(&b, name)
    wf_text.push(&b, "=")
    wf_text.push(&b, wf_text.url_encode(value))
    wf_text.push(&b, "; Path=/; SameSite=Lax")
    if max_age >= 0 {
        wf_text.push(&b, "; Max-Age=")
        rt.buf_push_dec_i64(&b, max_age)
    }
    if http_only { wf_text.push(&b, "; HttpOnly") }
    set_header(c, "Set-Cookie", rt.buf_str(&b))
    rt.buf_free(&b)
}

fn send_bytes(c: *mut wf_types.Ctx, status: u32, ctype: str, p: u64, n: usize) {
    (*c).status = status
    (*c).ctype = ctype
    rt.buf_clear(&(*c).body)
    rt.buf_push_bytes(&(*c).body, p, n)
}

fn text(c: *mut wf_types.Ctx, status: u32, s: str) {
    send_bytes(c, status, "text/plain; charset=utf-8", s.p as u64, s.n)
}

fn html(c: *mut wf_types.Ctx, status: u32, s: str) {
    send_bytes(c, status, "text/html; charset=utf-8", s.p as u64, s.n)
}

fn json_raw(c: *mut wf_types.Ctx, status: u32, s: str) {
    send_bytes(c, status, "application/json", s.p as u64, s.n)
}

fn json_out(c: *mut wf_types.Ctx, status: u32) -> json.JsonWriter {
    (*c).status = status
    (*c).ctype = "application/json"
    rt.buf_clear(&(*c).body)
    return json.jw_new(&(*c).body, false)
}

fn json_error(c: *mut wf_types.Ctx, status: u32, message: str) {
    var w: json.JsonWriter = json_out(c, status)
    json.jw_begin_object(&w)
    json.jw_key(&w, "error".p as u64, 5)
    json.jw_string(&w, message.p as u64, message.n)
    json.jw_end(&w)
    json.jw_free(&w)
}

fn status_error(c: *mut wf_types.Ctx, status: u32, message: str) {
    if wf_text.eq_ci(header(c, "Accept"), "application/json") {
        json_error(c, status, message)
    } else {
        text(c, status, message + "\n")
        (*c).status = status
    }
}

fn redirect(c: *mut wf_types.Ctx, status: u32, location: str) {
    set_header(c, "Location", location)
    send_bytes(c, status, "text/plain; charset=utf-8", "".p as u64, 0)
}

fn header_block(c: *mut wf_types.Ctx) -> str { return rt.buf_str(&(*c).headers) }

fn json_in(c: *mut wf_types.Ctx) -> bool {
    if (*c).jstate == 1 { return true }
    if (*c).jstate == 2 { return false }
    let b: str = http.body((*c).req)
    let ok: bool = json.json_parse(&(*c).jdoc, b.p as u64, b.n) catch false
    if ok { (*c).jstate = 1 } else { (*c).jstate = 2 }
    return ok
}

fn json_field(c: *mut wf_types.Ctx, key: str) -> u32 {
    if !json_in(c) { return json.JSON_NONE }
    let root: u32 = json.json_root(&(*c).jdoc)
    if json.json_kind(&(*c).jdoc, root) != json.JSON_OBJECT { return json.JSON_NONE }
    return json.json_get(&(*c).jdoc, root, key.p as u64, key.n)
}

fn json_str(c: *mut wf_types.Ctx, key: str) -> str {
    let n: u32 = json_field(c, key)
    if n == json.JSON_NONE { return "" }
    let sp = json.json_string(&(*c).jdoc, n)
    return __str_copy(str { p: sp.p, n: sp.n })
}

fn json_int(c: *mut wf_types.Ctx, key: str, fallback: i64) -> i64 {
    let n: u32 = json_field(c, key)
    if n == json.JSON_NONE || json.json_kind(&(*c).jdoc, n) != json.JSON_NUMBER { return fallback }
    return json.json_int(&(*c).jdoc, n)
}

fn json_bool_or(c: *mut wf_types.Ctx, key: str, fallback: bool) -> bool {
    let n: u32 = json_field(c, key)
    if n == json.JSON_NONE { return fallback }
    if json.json_kind(&(*c).jdoc, n) == json.JSON_TRUE { return true }
    if json.json_kind(&(*c).jdoc, n) == json.JSON_FALSE { return false }
    return fallback
}
