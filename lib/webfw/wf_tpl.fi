// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.dict
import std.pystr
import webfw.wf_text

export { tpl_new, tpl_free, tpl_set, tpl_list_push, render, render_str }

fn tpl_new() -> Dict[str] { return dict_new[str]() }
fn tpl_free(d: *mut Dict[str]) { dict_free[str](d) }
fn tpl_set(d: *mut Dict[str], key: str, value: str) { dict_set[str](d, key, value) }

fn tpl_list_push(d: *mut Dict[str], name: str, item: str) {
    var n: u64 = 0
    wf_text.parse_u64(dict_get_or[str](d, name + "#n", "0"), &n)
    dict_set[str](d, name + "#" + wf_text.num_text(n), item)
    dict_set[str](d, name + "#n", wf_text.num_text(n + 1))
}

fn find_at(t: str, needle: str, from: usize) -> usize {
    if from >= t.n { return t.n }
    let at: i64 = pystr.find(wf_text.slice(t, from, t.n), needle)
    if at < 0 { return t.n }
    return from + at as usize
}

fn lookup(d: *mut Dict[str], name: str, dot: str) -> str {
    if name == "." { return dot }
    return dict_get_or[str](d, name, "")
}

fn truthy(v: str) -> bool {
    return v.n > 0 && v != "0" && v != "false"
}

fn block_bounds(t: str, from: usize, else_at: *mut usize, close_at: *mut usize) -> bool {
    var depth: usize = 1
    var i: usize = from
    *else_at = t.n
    while true {
        let at: usize = find_at(t, "{{", i)
        if at >= t.n { return false }
        let rest: str = wf_text.slice(t, at, t.n)
        if pystr.startswith(rest, "{{#") {
            depth = depth + 1
        } else if pystr.startswith(rest, "{{/") {
            depth = depth - 1
            if depth == 0 {
                *close_at = at
                return true
            }
        } else if depth == 1 && pystr.startswith(rest, "{{else}}") && *else_at == t.n {
            *else_at = at
        }
        i = at + 2
    }
    return false
}

fn after_tag(t: str, at: usize, open: usize) -> usize {
    return find_at(t, "}}", at + open) + 2
}

fn render_block(t: str, d: *mut Dict[str], dot: str, out: *mut rt.Buf, kind: str, name: str, inner: str, other: str) {
    if kind == "each" {
        var n: u64 = 0
        wf_text.parse_u64(dict_get_or[str](d, name + "#n", "0"), &n)
        var j: u64 = 0
        while j < n {
            render(inner, d, dict_get_or[str](d, name + "#" + wf_text.num_text(j), ""), out)
            j = j + 1
        }
        return
    }
    var show: bool = truthy(lookup(d, name, dot))
    if kind == "unless" { show = !show }
    if show {
        render(inner, d, dot, out)
    } else {
        render(other, d, dot, out)
    }
}

fn render(t: str, d: *mut Dict[str], dot: str, out: *mut rt.Buf) {
    var i: usize = 0
    while i < t.n {
        let at: usize = find_at(t, "{{", i)
        wf_text.push(out, wf_text.slice(t, i, at))
        if at >= t.n { return }
        let rest: str = wf_text.slice(t, at, t.n)
        if pystr.startswith(rest, "{{{") {
            let e: usize = find_at(t, "}}}", at + 3)
            wf_text.push(out, lookup(d, pystr.strip(wf_text.slice(t, at + 3, e)), dot))
            i = e + 3
        } else if pystr.startswith(rest, "{{#") {
            let head_end: usize = find_at(t, "}}", at + 3)
            let head: str = pystr.strip(wf_text.slice(t, at + 3, head_end))
            var sp: usize = 0
            while sp < head.n && *(head.p + sp) != 32 as u8 { sp = sp + 1 }
            let kind: str = wf_text.slice(head, 0, sp)
            let name: str = pystr.strip(wf_text.slice(head, sp, head.n))
            var else_at: usize = t.n
            var close_at: usize = t.n
            if !block_bounds(t, head_end + 2, &else_at, &close_at) { return }
            let body_end: usize = if_else(else_at, close_at)
            let inner: str = wf_text.slice(t, head_end + 2, body_end)
            var other: str = ""
            if else_at < close_at { other = wf_text.slice(t, else_at + 8, close_at) }
            render_block(t, d, dot, out, kind, name, inner, other)
            i = after_tag(t, close_at, 3)
        } else if pystr.startswith(rest, "{{/") || pystr.startswith(rest, "{{else}}") {
            i = after_tag(t, at, 2)
        } else {
            let e: usize = find_at(t, "}}", at + 2)
            wf_text.html_escape(lookup(d, pystr.strip(wf_text.slice(t, at + 2, e)), dot), out)
            i = e + 2
        }
    }
}

fn if_else(else_at: usize, close_at: usize) -> usize {
    if else_at < close_at { return else_at }
    return close_at
}

fn render_str(t: str, d: *mut Dict[str]) -> str {
    var b: rt.Buf = rt.buf_new()
    render(t, d, "", &b)
    let out: str = __str_copy(rt.buf_str(&b))
    rt.buf_free(&b)
    return out
}
