import std.rt
import std.pystr
import std.deflate
import compress.zstd_enc
import webfw.wf_types
import webfw.wf_ctx
import webfw.wf_web
import webfw.wf_mime

export { enable_compress }

fn accepts(c: *mut wf_types.Ctx, coding: str) -> bool {
    return pystr.contains(pystr.lower(wf_ctx.header(c, "Accept-Encoding")), coding)
}

fn eligible(c: *mut wf_types.Ctx) -> bool {
    let w: *mut wf_types.Web = (*c).web
    if (*c).status != 200 { return false }
    if rt.buf_len(&(*c).body) < (*w).compress_min { return false }
    if !wf_mime.compressible((*c).ctype) { return false }
    return !pystr.contains(wf_ctx.header_block(c), "Content-Encoding:")
}

fn compress_after(c: *mut wf_types.Ctx) {
    if !eligible(c) { return }
    let w: *mut wf_types.Web = (*c).web
    var out: rt.Buf = rt.buf_new()
    var coding: str = ""
    let src: u64 = rt.buf_ptr(&(*c).body)
    let n: usize = rt.buf_len(&(*c).body)
    var done: usize = 0
    if accepts(c, "zstd") {
        done = zstd_enc.zstd_compress(src, n, (*w).compress_level, &out) catch 0
        coding = "zstd"
    } else if accepts(c, "gzip") {
        done = deflate.gzip_compress(src, n, (*w).compress_level as usize, &out) catch 0
        coding = "gzip"
    }
    if done > 0 && done < n {
        rt.buf_clear(&(*c).body)
        rt.buf_push_bytes(&(*c).body, rt.buf_ptr(&out), rt.buf_len(&out))
        wf_ctx.set_header(c, "Content-Encoding", coding)
        wf_ctx.set_header(c, "Vary", "Accept-Encoding")
    }
    rt.buf_free(&out)
}

fn enable_compress(w: *mut wf_types.Web, min_size: usize, level: u32) {
    (*w).compress_min = min_size
    (*w).compress_level = level
    wf_web.use_after(w, compress_after)
}
