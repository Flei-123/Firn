import std.pystr
import webfw.wf_text

export { mime_for, compressible }

fn ext_of(path: str) -> str {
    var i: usize = path.n
    while i > 0 {
        let c: u8 = *(path.p + i - 1)
        if c == 46 as u8 { return wf_text.slice(path, i, path.n) }
        if c == 47 as u8 { return "" }
        i = i - 1
    }
    return ""
}

fn mime_for(path: str) -> str {
    let e: str = pystr.lower(ext_of(path))
    if e == "html" || e == "htm" { return "text/html; charset=utf-8" }
    if e == "css" { return "text/css; charset=utf-8" }
    if e == "js" || e == "mjs" { return "text/javascript; charset=utf-8" }
    if e == "json" { return "application/json" }
    if e == "txt" { return "text/plain; charset=utf-8" }
    if e == "xml" { return "application/xml" }
    if e == "svg" { return "image/svg+xml" }
    if e == "png" { return "image/png" }
    if e == "jpg" || e == "jpeg" { return "image/jpeg" }
    if e == "gif" { return "image/gif" }
    if e == "webp" { return "image/webp" }
    if e == "ico" { return "image/x-icon" }
    if e == "pdf" { return "application/pdf" }
    if e == "wasm" { return "application/wasm" }
    if e == "mp4" { return "video/mp4" }
    if e == "webm" { return "video/webm" }
    if e == "mp3" { return "audio/mpeg" }
    if e == "woff2" { return "font/woff2" }
    if e == "zip" { return "application/zip" }
    return "application/octet-stream"
}

fn compressible(ctype: str) -> bool {
    if pystr.startswith(ctype, "text/") { return true }
    if pystr.startswith(ctype, "application/json") { return true }
    if pystr.startswith(ctype, "application/xml") { return true }
    if pystr.startswith(ctype, "application/javascript") { return true }
    if pystr.startswith(ctype, "image/svg+xml") { return true }
    return false
}
