import std.rt
import std.vec
import webfw.wf_types
import webfw.wf_text

export { add_route, find_route, join_path, match_path }

fn join_path(prefix: str, p: str) -> str {
    if p == "/" || p.n == 0 {
        if prefix.n == 0 { return "/" }
        return prefix
    }
    return prefix + p
}

fn seg_end(s: str, from: usize) -> usize {
    var e: usize = from
    while e < s.n && *(s.p + e) != 47 as u8 { e = e + 1 }
    return e
}

fn is_marker(seg: str, m: u8) -> bool {
    return seg.n > 0 && *(seg.p) == m
}

fn bind(keys: *mut Vec[str], vals: *mut Vec[str], name: str, value: str) {
    vec_push[str](keys, name)
    vec_push[str](vals, wf_text.url_decode(value, false))
}

fn match_path(pattern0: str, path0: str, keys: *mut Vec[str], vals: *mut Vec[str]) -> bool {
    let pattern: str = wf_text.trim_slash(pattern0)
    let path: str = wf_text.trim_slash(path0)
    var pi: usize = 1
    var si: usize = 1
    while true {
        let pdone: bool = pi >= pattern.n
        let sdone: bool = si >= path.n
        if pdone && sdone { return true }
        if pdone { return false }
        let pe: usize = seg_end(pattern, pi)
        let pseg: str = wf_text.slice(pattern, pi, pe)
        if is_marker(pseg, 42 as u8) {
            var rest: str = ""
            if !sdone { rest = wf_text.slice(path, si, path.n) }
            bind(keys, vals, wf_text.slice(pseg, 1, pseg.n), rest)
            return true
        }
        if sdone { return false }
        let se: usize = seg_end(path, si)
        let sseg: str = wf_text.slice(path, si, se)
        if is_marker(pseg, 58 as u8) {
            if sseg.n == 0 { return false }
            bind(keys, vals, wf_text.slice(pseg, 1, pseg.n), sseg)
        } else if pseg != sseg {
            return false
        }
        pi = pe + 1
        si = se + 1
    }
    return false
}

fn add_route(w: *mut wf_types.Web, method: str, pattern: str, handler: fn(*mut wf_types.Ctx), mws: *mut Vec[wf_types.Mw]) {
    var copy: Vec[wf_types.Mw] = vec_new[wf_types.Mw]()
    var i: usize = 0
    while i < vec_len[wf_types.Mw](mws) {
        vec_push[wf_types.Mw](&copy, *vec_elem_ptr[wf_types.Mw](mws, i))
        i = i + 1
    }
    vec_push[wf_types.Route](&(*w).routes, wf_types.Route { method: method, pattern: pattern, handler: handler, mws: copy })
}

fn method_ok(route_method: str, method: str) -> bool {
    if route_method.n == 0 { return true }
    if route_method == method { return true }
    return method == "HEAD" && route_method == "GET"
}

fn add_allow(allow: *mut rt.Buf, m: str) {
    if (*allow).len > 0 { wf_text.push(allow, ", ") }
    if m.n == 0 {
        wf_text.push(allow, "GET, POST, PUT, PATCH, DELETE")
    } else {
        wf_text.push(allow, m)
    }
}

fn find_route(w: *mut wf_types.Web, method: str, path: str, keys: *mut Vec[str], vals: *mut Vec[str], allow: *mut rt.Buf) -> usize {
    var i: usize = 0
    while i < vec_len[wf_types.Route](&(*w).routes) {
        let r: *mut wf_types.Route = vec_elem_ptr[wf_types.Route](&(*w).routes, i)
        vec_clear[str](keys)
        vec_clear[str](vals)
        if match_path((*r).pattern, path, keys, vals) {
            if method_ok((*r).method, method) { return i }
            add_allow(allow, (*r).method)
        }
        i = i + 1
    }
    vec_clear[str](keys)
    vec_clear[str](vals)
    return wf_types.NO_ROUTE
}
