// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.vec
import std.dict
import std.json
import http.server as http

export { Ctx, Web, Route, Group, Mw, After, StaticMount, NO_ROUTE }

const NO_ROUTE: usize = 18446744073709551615

struct Mw {
    f: fn(*mut Ctx) -> bool,
}

struct After {
    f: fn(*mut Ctx),
}

struct Route {
    method: str,
    pattern: str,
    handler: fn(*mut Ctx),
    mws: Vec[Mw],
}

struct StaticMount {
    prefix: str,
    dir: str,
}

struct Web {
    app: http.App,
    routes: Vec[Route],
    before: Vec[Mw],
    after: Vec[After],
    statics: Vec[StaticMount],
    not_found: fn(*mut Ctx),
    cors_origin: str,
    cors_methods: str,
    cors_headers: str,
    cors_max_age: u32,
    rate_max: u32,
    rate_window_ms: i64,
    rate_count: Dict[i64],
    rate_start: Dict[i64],
    auth_hook: fn(*mut Ctx) -> bool,
    auth_realm: str,
    session_secret: str,
    session_ttl_ms: i64,
    session_ids: Dict[i64],
    session_vals: Dict[str],
    compress_min: usize,
    compress_level: u32,
}

struct Group {
    web: *mut Web,
    prefix: str,
    mws: Vec[Mw],
}

struct Ctx {
    req: *mut http.Req,
    web: *mut Web,
    status: u32,
    ctype: str,
    headers: rt.Buf,
    body: rt.Buf,
    pkeys: Vec[str],
    pvals: Vec[str],
    sid: str,
    sid_new: bool,
    jdoc: json.Json,
    jstate: u32,
}
