// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.pystr

export { num_text, slice, push, hex_val, url_decode, url_encode, html_escape, pair_find, eq_ci, parse_u64, lower_byte, trim_slash }

fn slice(s: str, a: usize, b: usize) -> str {
    return str { p: s.p + a, n: b - a }
}

fn push(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn lower_byte(c: u8) -> u8 {
    if c >= 65 as u8 && c <= 90 as u8 { return c + 32 as u8 }
    return c
}

fn eq_ci(a: str, b: str) -> bool {
    if a.n != b.n { return false }
    var i: usize = 0
    while i < a.n {
        if lower_byte(*(a.p + i)) != lower_byte(*(b.p + i)) { return false }
        i = i + 1
    }
    return true
}

fn hex_val(c: u8) -> i64 {
    if c >= 48 as u8 && c <= 57 as u8 { return (c - 48 as u8) as i64 }
    if c >= 97 as u8 && c <= 102 as u8 { return (c - 87 as u8) as i64 }
    if c >= 65 as u8 && c <= 70 as u8 { return (c - 55 as u8) as i64 }
    return 0 - 1
}

fn url_decode(s: str, plus: bool) -> str {
    var b: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < s.n {
        let c: u8 = *(s.p + i)
        if c == 37 as u8 && i + 2 < s.n {
            let h: i64 = hex_val(*(s.p + i + 1))
            let l: i64 = hex_val(*(s.p + i + 2))
            if h >= 0 && l >= 0 {
                rt.buf_push(&b, (h * 16 + l) as u8)
                i = i + 3
                continue
            }
        }
        if c == 43 as u8 && plus {
            rt.buf_push(&b, 32 as u8)
        } else {
            rt.buf_push(&b, c)
        }
        i = i + 1
    }
    let out: str = __str_copy(rt.buf_str(&b))
    rt.buf_free(&b)
    return out
}

fn unreserved(c: u8) -> bool {
    if c >= 48 as u8 && c <= 57 as u8 { return true }
    if c >= 65 as u8 && c <= 90 as u8 { return true }
    if c >= 97 as u8 && c <= 122 as u8 { return true }
    return c == 45 as u8 || c == 46 as u8 || c == 95 as u8 || c == 126 as u8
}

fn url_encode(s: str) -> str {
    var b: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < s.n {
        let c: u8 = *(s.p + i)
        if unreserved(c) {
            rt.buf_push(&b, c)
        } else {
            rt.buf_push(&b, 37 as u8)
            rt.buf_push_hex_u64(&b, c as u64, 2)
        }
        i = i + 1
    }
    let out: str = __str_copy(rt.buf_str(&b))
    rt.buf_free(&b)
    return out
}

fn html_escape(s: str, out: *mut rt.Buf) {
    var i: usize = 0
    while i < s.n {
        let c: u8 = *(s.p + i)
        if c == 38 as u8 { push(out, "&amp;") }
        else if c == 60 as u8 { push(out, "&lt;") }
        else if c == 62 as u8 { push(out, "&gt;") }
        else if c == 34 as u8 { push(out, "&quot;") }
        else if c == 39 as u8 { push(out, "&#39;") }
        else { rt.buf_push(out, c) }
        i = i + 1
    }
}

fn pair_find(s: str, name: str, sep: u8, plus: bool, out: *mut str) -> bool {
    var i: usize = 0
    while i <= s.n {
        while i < s.n && *(s.p + i) == 32 as u8 { i = i + 1 }
        var e: usize = i
        while e < s.n && *(s.p + e) != sep { e = e + 1 }
        var eq: usize = i
        while eq < e && *(s.p + eq) != 61 as u8 { eq = eq + 1 }
        if eq > i || eq < e {
            if url_decode(slice(s, i, eq), plus) == name {
                if eq < e {
                    *out = url_decode(slice(s, eq + 1, e), plus)
                } else {
                    *out = ""
                }
                return true
            }
        }
        i = e + 1
    }
    return false
}

fn parse_u64(s: str, out: *mut u64) -> bool {
    if s.n == 0 || s.n > 19 { return false }
    var v: u64 = 0
    var i: usize = 0
    while i < s.n {
        let c: u8 = *(s.p + i)
        if c < 48 as u8 || c > 57 as u8 { return false }
        v = v * 10 + (c - 48 as u8) as u64
        i = i + 1
    }
    *out = v
    return true
}

fn trim_slash(s: str) -> str {
    if s.n > 1 && *(s.p + s.n - 1) == 47 as u8 { return slice(s, 0, s.n - 1) }
    return s
}

fn num_text(v: u64) -> str {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&b, v)
    let out: str = __str_copy(rt.buf_str(&b))
    rt.buf_free(&b)
    return out
}
