import std.dict
import std.time
import webfw.wf_types
import webfw.wf_ctx
import webfw.wf_web
import webfw.wf_text

export { enable_rate_limit }

const MAX_TRACKED: usize = 10000

fn rate_mw(c: *mut wf_types.Ctx) -> bool {
    let w: *mut wf_types.Web = (*c).web
    let key: str = wf_ctx.client_ip(c)
    let now: i64 = time.now_unix_ms()
    if dict_len[i64](&(*w).rate_start) > MAX_TRACKED {
        dict_clear[i64](&(*w).rate_start)
        dict_clear[i64](&(*w).rate_count)
    }
    let start: i64 = dict_get_or[i64](&(*w).rate_start, key, 0)
    if start == 0 || now - start >= (*w).rate_window_ms {
        dict_set[i64](&(*w).rate_start, key, now)
        dict_set[i64](&(*w).rate_count, key, 0)
    }
    let used: i64 = dict_inc[i64](&(*w).rate_count, key, 1)
    let limit: i64 = (*w).rate_max as i64
    var left: i64 = limit - used
    if left < 0 { left = 0 }
    wf_ctx.set_header(c, "X-RateLimit-Limit", wf_text.num_text(limit as u64))
    wf_ctx.set_header(c, "X-RateLimit-Remaining", wf_text.num_text(left as u64))
    if used <= limit { return true }
    let begun: i64 = dict_get_or[i64](&(*w).rate_start, key, now)
    let wait_s: i64 = ((*w).rate_window_ms - (now - begun) + 999) / 1000
    wf_ctx.set_header(c, "Retry-After", wf_text.num_text(wait_s as u64))
    wf_ctx.status_error(c, 429, "too many requests")
    return false
}

fn enable_rate_limit(w: *mut wf_types.Web, max: u32, window_ms: i64) {
    (*w).rate_max = max
    (*w).rate_window_ms = window_ms
    wf_web.use_before(w, rate_mw)
}
