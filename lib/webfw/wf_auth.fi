import std.rt
import std.base64
import std.pystr
import webfw.wf_types
import webfw.wf_ctx
import webfw.wf_text

export { require_auth, set_auth_hook, basic_credentials, bearer_token }

fn set_auth_hook(w: *mut wf_types.Web, realm: str, hook: fn(*mut wf_types.Ctx) -> bool) {
    (*w).auth_hook = hook
    (*w).auth_realm = realm
}

fn require_auth(c: *mut wf_types.Ctx) -> bool {
    let w: *mut wf_types.Web = (*c).web
    let hook: fn(*mut wf_types.Ctx) -> bool = (*w).auth_hook
    if hook(c) { return true }
    wf_ctx.set_header(c, "WWW-Authenticate", "Basic realm=\"" + (*w).auth_realm + "\", Bearer")
    wf_ctx.status_error(c, 401, "authentication required")
    return false
}

fn bearer_token(c: *mut wf_types.Ctx) -> str {
    let h: str = wf_ctx.header(c, "Authorization")
    if h.n > 7 && wf_text.eq_ci(wf_text.slice(h, 0, 7), "bearer ") { return wf_text.slice(h, 7, h.n) }
    return ""
}

fn basic_credentials(c: *mut wf_types.Ctx, user: *mut str, pass: *mut str) -> bool {
    let h: str = wf_ctx.header(c, "Authorization")
    if h.n <= 6 || !wf_text.eq_ci(wf_text.slice(h, 0, 6), "basic ") { return false }
    let enc: str = wf_text.slice(h, 6, h.n)
    var raw: rt.Buf = rt.buf_new()
    let ok: bool = base64.decode(enc.p as u64, enc.n, &raw)
    let text: str = rt.buf_str(&raw)
    let colon: i64 = pystr.find(text, ":")
    if !ok || colon < 0 {
        rt.buf_free(&raw)
        return false
    }
    *user = __str_copy(wf_text.slice(text, 0, colon as usize))
    *pass = __str_copy(wf_text.slice(text, colon as usize + 1, text.n))
    rt.buf_free(&raw)
    return true
}
