import webfw.wf_types
import webfw.wf_ctx
import webfw.wf_web
import webfw.wf_text

export { enable_cors }

fn cors_mw(c: *mut wf_types.Ctx) -> bool {
    let w: *mut wf_types.Web = (*c).web
    let origin: str = wf_ctx.header(c, "Origin")
    if origin.n == 0 { return true }
    let any_origin: bool = (*w).cors_origin == "*"
    let allowed: bool = any_origin || (*w).cors_origin == origin
    let preflight: bool = wf_ctx.method(c) == "OPTIONS" && wf_ctx.header(c, "Access-Control-Request-Method").n > 0
    if !allowed {
        if preflight { wf_ctx.status_error(c, 403, "origin not allowed") }
        return !preflight
    }
    wf_ctx.set_header(c, "Access-Control-Allow-Origin", if_any(any_origin, origin))
    if !any_origin { wf_ctx.set_header(c, "Vary", "Origin") }
    if !preflight { return true }
    wf_ctx.set_header(c, "Access-Control-Allow-Methods", (*w).cors_methods)
    wf_ctx.set_header(c, "Access-Control-Allow-Headers", (*w).cors_headers)
    wf_ctx.set_header(c, "Access-Control-Max-Age", wf_text.num_text((*w).cors_max_age as u64))
    wf_ctx.send_bytes(c, 204, "", "".p as u64, 0)
    return false
}

fn if_any(any_origin: bool, origin: str) -> str {
    if any_origin { return "*" }
    return origin
}

fn enable_cors(w: *mut wf_types.Web, origin: str, methods: str, headers: str, max_age: u32) {
    (*w).cors_origin = origin
    (*w).cors_methods = methods
    (*w).cors_headers = headers
    (*w).cors_max_age = max_age
    wf_web.use_before(w, cors_mw)
}
