import std.vec
import bezier.geom

export { dedupe, rdp, resample, path_length }

fn dedupe(pts: *mut Vec[f64], n: usize, mind: f64, out: *mut Vec[f64]) {
    geom.pts_clear(out)
    if n == 0 {
        return
    }
    var lx: f64 = geom.pts_x(pts, 0)
    var ly: f64 = geom.pts_y(pts, 0)
    geom.pts_add(out, lx, ly)
    var i: usize = 1
    while i < n {
        let x: f64 = geom.pts_x(pts, i)
        let y: f64 = geom.pts_y(pts, i)
        if geom.dist(x, y, lx, ly) > mind {
            geom.pts_add(out, x, y)
            lx = x
            ly = y
        }
        i = i + 1
    }
    let ex: f64 = geom.pts_x(pts, n - 1)
    let ey: f64 = geom.pts_y(pts, n - 1)
    let m: usize = geom.pts_n(out)
    if m > 1 && (geom.pts_x(out, m - 1) != ex || geom.pts_y(out, m - 1) != ey) {
        geom.pts_set(out, m - 1, ex, ey)
    }
}

fn rdp(pts: *mut Vec[f64], n: usize, eps: f64, out: *mut Vec[f64]) {
    geom.pts_clear(out)
    if n < 3 {
        var k: usize = 0
        while k < n {
            geom.pts_add(out, geom.pts_x(pts, k), geom.pts_y(pts, k))
            k = k + 1
        }
        return
    }
    var keep: Vec[u8] = vec_new[u8]()
    var i: usize = 0
    while i < n {
        vec_push[u8](&keep, 0 as u8)
        i = i + 1
    }
    keep[0] = 1 as u8
    keep[n - 1] = 1 as u8
    var stack: Vec[u32] = vec_new[u32]()
    vec_push[u32](&stack, 0 as u32)
    vec_push[u32](&stack, (n - 1) as u32)
    while vec_len[u32](&stack) > 0 {
        let hi: usize = vec_pop[u32](&stack) as usize
        let lo: usize = vec_pop[u32](&stack) as usize
        var worst: f64 = -1.0
        var wi: usize = lo
        let ax: f64 = geom.pts_x(pts, lo)
        let ay: f64 = geom.pts_y(pts, lo)
        let bx: f64 = geom.pts_x(pts, hi)
        let by: f64 = geom.pts_y(pts, hi)
        var j: usize = lo + 1
        while j < hi {
            let d: f64 = geom.seg_dist(geom.pts_x(pts, j), geom.pts_y(pts, j), ax, ay, bx, by)
            if d > worst {
                worst = d
                wi = j
            }
            j = j + 1
        }
        if worst > eps {
            keep[wi] = 1 as u8
            vec_push[u32](&stack, lo as u32)
            vec_push[u32](&stack, wi as u32)
            vec_push[u32](&stack, wi as u32)
            vec_push[u32](&stack, hi as u32)
        }
    }
    i = 0
    while i < n {
        if keep[i] != 0 {
            geom.pts_add(out, geom.pts_x(pts, i), geom.pts_y(pts, i))
        }
        i = i + 1
    }
    vec_free[u8](&keep)
    vec_free[u32](&stack)
}

fn path_length(pts: *mut Vec[f64], n: usize) -> f64 {
    var total: f64 = 0.0
    var i: usize = 1
    while i < n {
        total = total + geom.dist(geom.pts_x(pts, i - 1), geom.pts_y(pts, i - 1), geom.pts_x(pts, i), geom.pts_y(pts, i))
        i = i + 1
    }
    return total
}

fn resample(pts: *mut Vec[f64], n: usize, step: f64, out: *mut Vec[f64]) {
    geom.pts_clear(out)
    if n == 0 {
        return
    }
    geom.pts_add(out, geom.pts_x(pts, 0), geom.pts_y(pts, 0))
    var carry: f64 = 0.0
    var i: usize = 1
    while i < n {
        let ax: f64 = geom.pts_x(pts, i - 1)
        let ay: f64 = geom.pts_y(pts, i - 1)
        let bx: f64 = geom.pts_x(pts, i)
        let by: f64 = geom.pts_y(pts, i)
        let seg: f64 = geom.dist(ax, ay, bx, by)
        var pos: f64 = step - carry
        while pos <= seg && seg > 0.0 {
            let t: f64 = pos / seg
            geom.pts_add(out, ax + (bx - ax) * t, ay + (by - ay) * t)
            pos = pos + step
        }
        carry = seg - (pos - step)
        if carry < 0.0 {
            carry = 0.0
        }
        i = i + 1
    }
    let ex: f64 = geom.pts_x(pts, n - 1)
    let ey: f64 = geom.pts_y(pts, n - 1)
    let m: usize = geom.pts_n(out)
    if geom.dist(geom.pts_x(out, m - 1), geom.pts_y(out, m - 1), ex, ey) > step * 0.25 {
        geom.pts_add(out, ex, ey)
    } else if m > 1 {
        geom.pts_set(out, m - 1, ex, ey)
    }
}
