import std.math
import svg.path
import bezier.geom

export { path_flatten, flatten_cubic, flatten_quad }

fn seg_count(m: f64, k: f64, tol: f64) -> usize {
    var n: f64 = math.ceil(math.sqrt(k * m / tol))
    if n < 1.0 {
        n = 1.0
    }
    if n > 512.0 {
        n = 512.0
    }
    return n as usize
}

fn flatten_quad(out: *mut geom.Poly, x0: f64, y0: f64, cx: f64, cy: f64, x: f64, y: f64, tol: f64) {
    let m: f64 = geom.len2(x0 - 2.0 * cx + x, y0 - 2.0 * cy + y)
    let n: usize = seg_count(m, 0.25, tol)
    var i: usize = 1
    while i <= n {
        let t: f64 = i as f64 / n as f64
        let s: f64 = 1.0 - t
        geom.poly_add(out, s * s * x0 + 2.0 * s * t * cx + t * t * x, s * s * y0 + 2.0 * s * t * cy + t * t * y)
        i = i + 1
    }
}

fn flatten_cubic(out: *mut geom.Poly, x0: f64, y0: f64, x1: f64, y1: f64, x2: f64, y2: f64, x3: f64, y3: f64, tol: f64) {
    let d1: f64 = geom.len2(x0 - 2.0 * x1 + x2, y0 - 2.0 * y1 + y2)
    let d2: f64 = geom.len2(x1 - 2.0 * x2 + x3, y1 - 2.0 * y2 + y3)
    var m: f64 = d1
    if d2 > m {
        m = d2
    }
    let n: usize = seg_count(m, 0.75, tol)
    var i: usize = 1
    while i <= n {
        let t: f64 = i as f64 / n as f64
        let s: f64 = 1.0 - t
        let a: f64 = s * s * s
        let b: f64 = 3.0 * s * s * t
        let c: f64 = 3.0 * s * t * t
        let d: f64 = t * t * t
        geom.poly_add(out, a * x0 + b * x1 + c * x2 + d * x3, a * y0 + b * y1 + c * y2 + d * y3)
        i = i + 1
    }
}

fn path_flatten(p: *mut path.Path, tol: f64, out: *mut geom.Poly) {
    let nv: usize = path.path_verbs(p)
    var pi: usize = 0
    var cx: f64 = 0.0
    var cy: f64 = 0.0
    var open: bool = false
    var i: usize = 0
    while i < nv {
        let v: u32 = path.path_verb(p, i)
        if v == path.V_ZUG {
            if open {
                geom.poly_close(out)
            }
            cx = path.path_px(p, pi)
            cy = path.path_py(p, pi)
            pi = pi + 1
            geom.poly_add(out, cx, cy)
            open = true
        } else if v == path.V_LINE {
            cx = path.path_px(p, pi)
            cy = path.path_py(p, pi)
            pi = pi + 1
            geom.poly_add(out, cx, cy)
        } else if v == path.V_QUAD {
            let ax: f64 = path.path_px(p, pi)
            let ay: f64 = path.path_py(p, pi)
            let bx: f64 = path.path_px(p, pi + 1)
            let by: f64 = path.path_py(p, pi + 1)
            pi = pi + 2
            flatten_quad(out, cx, cy, ax, ay, bx, by, tol)
            cx = bx
            cy = by
        } else if v == path.V_CUBIC {
            let ax: f64 = path.path_px(p, pi)
            let ay: f64 = path.path_py(p, pi)
            let bx: f64 = path.path_px(p, pi + 1)
            let by: f64 = path.path_py(p, pi + 1)
            let ex: f64 = path.path_px(p, pi + 2)
            let ey: f64 = path.path_py(p, pi + 2)
            pi = pi + 3
            flatten_cubic(out, cx, cy, ax, ay, bx, by, ex, ey, tol)
            cx = ex
            cy = ey
        }
        i = i + 1
    }
    if open {
        geom.poly_close(out)
    }
}
