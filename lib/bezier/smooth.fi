import std.vec
import std.math
import bezier.geom

export { corners, average, smooth, chaikin }

fn turn_angle(pts: *mut Vec[f64], n: usize, i: usize, win: f64) -> f64 {
    let px: f64 = geom.pts_x(pts, i)
    let py: f64 = geom.pts_y(pts, i)
    var a: usize = i
    while a > 0 && geom.dist(px, py, geom.pts_x(pts, a), geom.pts_y(pts, a)) < win {
        a = a - 1
    }
    var b: usize = i
    while b + 1 < n && geom.dist(px, py, geom.pts_x(pts, b), geom.pts_y(pts, b)) < win {
        b = b + 1
    }
    if geom.dist(px, py, geom.pts_x(pts, a), geom.pts_y(pts, a)) < win * 0.5 {
        return 0.0
    }
    if geom.dist(px, py, geom.pts_x(pts, b), geom.pts_y(pts, b)) < win * 0.5 {
        return 0.0
    }
    let ux: f64 = px - geom.pts_x(pts, a)
    let uy: f64 = py - geom.pts_y(pts, a)
    let vx: f64 = geom.pts_x(pts, b) - px
    let vy: f64 = geom.pts_y(pts, b) - py
    let ang: f64 = math.atan2(ux * vy - uy * vx, ux * vx + uy * vy)
    return math.fabs(ang) * 180.0 / math.PI()
}

fn corners(pts: *mut Vec[f64], n: usize, win: f64, min_angle: f64, out: *mut Vec[u32]) {
    vec_clear[u32](out)
    if n < 3 {
        return
    }
    var best: f64 = 0.0
    var best_i: usize = 0
    var run: bool = false
    var i: usize = 1
    while i < n {
        var ang: f64 = 0.0
        if i + 1 < n {
            ang = turn_angle(pts, n, i, win)
        }
        if ang >= min_angle {
            if !run || ang > best {
                best = ang
                best_i = i
            }
            run = true
        } else if run {
            vec_push[u32](out, best_i as u32)
            run = false
            best = 0.0
        }
        i = i + 1
    }
    if run {
        vec_push[u32](out, best_i as u32)
    }
}

fn average(pts: *mut Vec[f64], n: usize, passes: usize, pinned: *mut Vec[u32], out: *mut Vec[f64]) {
    geom.pts_copy(pts, out)
    if n < 3 {
        return
    }
    var pin: Vec[u8] = vec_new[u8]()
    var i: usize = 0
    while i < n {
        vec_push[u8](&pin, 0 as u8)
        i = i + 1
    }
    pin[0] = 1 as u8
    pin[n - 1] = 1 as u8
    i = 0
    while i < vec_len[u32](pinned) {
        let k: usize = (*pinned)[i] as usize
        if k < n {
            pin[k] = 1 as u8
        }
        i = i + 1
    }
    var tmp: Vec[f64] = geom.pts_new()
    var pass: usize = 0
    while pass < passes {
        geom.pts_copy(out, &tmp)
        i = 1
        while i + 1 < n {
            if pin[i] == 0 {
                geom.pts_set(out, i,
                    0.25 * geom.pts_x(&tmp, i - 1) + 0.5 * geom.pts_x(&tmp, i) + 0.25 * geom.pts_x(&tmp, i + 1),
                    0.25 * geom.pts_y(&tmp, i - 1) + 0.5 * geom.pts_y(&tmp, i) + 0.25 * geom.pts_y(&tmp, i + 1))
            }
            i = i + 1
        }
        pass = pass + 1
    }
    vec_free[u8](&pin)
    geom.pts_free(&tmp)
}

fn smooth(pts: *mut Vec[f64], n: usize, passes: usize, win: f64, min_angle: f64, out: *mut Vec[f64]) {
    var cs: Vec[u32] = vec_new[u32]()
    corners(pts, n, win, min_angle, &cs)
    average(pts, n, passes, &cs, out)
    vec_free[u32](&cs)
}

fn chaikin(pts: *mut Vec[f64], n: usize, rounds: usize, out: *mut Vec[f64]) {
    geom.pts_copy(pts, out)
    var r: usize = 0
    while r < rounds {
        let m: usize = geom.pts_n(out)
        if m < 3 {
            return
        }
        var next: Vec[f64] = geom.pts_new()
        geom.pts_add(&next, geom.pts_x(out, 0), geom.pts_y(out, 0))
        var i: usize = 0
        while i + 1 < m {
            let ax: f64 = geom.pts_x(out, i)
            let ay: f64 = geom.pts_y(out, i)
            let bx: f64 = geom.pts_x(out, i + 1)
            let by: f64 = geom.pts_y(out, i + 1)
            if i > 0 {
                geom.pts_add(&next, 0.75 * ax + 0.25 * bx, 0.75 * ay + 0.25 * by)
            }
            if i + 2 < m {
                geom.pts_add(&next, 0.25 * ax + 0.75 * bx, 0.25 * ay + 0.75 * by)
            }
            i = i + 1
        }
        geom.pts_add(&next, geom.pts_x(out, m - 1), geom.pts_y(out, m - 1))
        geom.pts_copy(&next, out)
        geom.pts_free(&next)
        r = r + 1
    }
}
