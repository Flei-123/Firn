import std.vec
import std.math
import svg.path
import bezier.geom
import bezier.cubic
import bezier.simplify
import bezier.smooth

export { fit, fit_ex, fit_append, fit_loop, fit_loop_cuts, fit_error }

const DEFAULT_CORNER: f64 = 50.0
const MAX_REPARAM: usize = 8

struct Tan {
    x: f64,
    y: f64,
}

fn tan_unit(x: f64, y: f64, fx: f64, fy: f64) -> Tan {
    let l: f64 = geom.len2(x, y)
    if l <= 0.0 {
        let fl: f64 = geom.len2(fx, fy)
        if fl <= 0.0 {
            return Tan { x: 1.0, y: 0.0 }
        }
        return Tan { x: fx / fl, y: fy / fl }
    }
    return Tan { x: x / l, y: y / l }
}

fn tan_start(pts: *mut Vec[f64], first: usize, last: usize) -> Tan {
    let x0: f64 = geom.pts_x(pts, first)
    let y0: f64 = geom.pts_y(pts, first)
    let x1: f64 = geom.pts_x(pts, first + 1)
    let y1: f64 = geom.pts_y(pts, first + 1)
    if last - first >= 2 {
        let x2: f64 = geom.pts_x(pts, first + 2)
        let y2: f64 = geom.pts_y(pts, first + 2)
        return tan_unit(-3.0 * x0 + 4.0 * x1 - x2, -3.0 * y0 + 4.0 * y1 - y2, x1 - x0, y1 - y0)
    }
    return tan_unit(x1 - x0, y1 - y0, 1.0, 0.0)
}

fn tan_end(pts: *mut Vec[f64], first: usize, last: usize) -> Tan {
    let x0: f64 = geom.pts_x(pts, last)
    let y0: f64 = geom.pts_y(pts, last)
    let x1: f64 = geom.pts_x(pts, last - 1)
    let y1: f64 = geom.pts_y(pts, last - 1)
    if last - first >= 2 {
        let x2: f64 = geom.pts_x(pts, last - 2)
        let y2: f64 = geom.pts_y(pts, last - 2)
        return tan_unit(-3.0 * x0 + 4.0 * x1 - x2, -3.0 * y0 + 4.0 * y1 - y2, x1 - x0, y1 - y0)
    }
    return tan_unit(x1 - x0, y1 - y0, 1.0, 0.0)
}

fn chord_params(pts: *mut Vec[f64], first: usize, last: usize, u: *mut Vec[f64]) {
    vec_clear[f64](u)
    vec_push[f64](u, 0.0)
    var total: f64 = 0.0
    var i: usize = first + 1
    while i <= last {
        total = total + geom.dist(geom.pts_x(pts, i), geom.pts_y(pts, i), geom.pts_x(pts, i - 1), geom.pts_y(pts, i - 1))
        vec_push[f64](u, total)
        i = i + 1
    }
    i = 1
    let m: usize = vec_len[f64](u)
    while i < m {
        if total > 0.0 {
            (*u)[i] = (*u)[i] / total
        } else {
            (*u)[i] = i as f64 / (m - 1) as f64
        }
        i = i + 1
    }
}

fn build_cubic(pts: *mut Vec[f64], first: usize, last: usize, u: *mut Vec[f64], t1: Tan, t2: Tan, c: *mut cubic.Cub) {
    let x0: f64 = geom.pts_x(pts, first)
    let y0: f64 = geom.pts_y(pts, first)
    let x3: f64 = geom.pts_x(pts, last)
    let y3: f64 = geom.pts_y(pts, last)
    var c00: f64 = 0.0
    var c01: f64 = 0.0
    var c11: f64 = 0.0
    var xa: f64 = 0.0
    var xb: f64 = 0.0
    let m: usize = last - first + 1
    var i: usize = 0
    while i < m {
        let t: f64 = (*u)[i]
        let s: f64 = 1.0 - t
        let b0: f64 = s * s * s
        let b1: f64 = 3.0 * s * s * t
        let b2: f64 = 3.0 * s * t * t
        let b3: f64 = t * t * t
        let a1x: f64 = t1.x * b1
        let a1y: f64 = t1.y * b1
        let a2x: f64 = t2.x * b2
        let a2y: f64 = t2.y * b2
        c00 = c00 + a1x * a1x + a1y * a1y
        c01 = c01 + a1x * a2x + a1y * a2y
        c11 = c11 + a2x * a2x + a2y * a2y
        let rx: f64 = geom.pts_x(pts, first + i) - ((b0 + b1) * x0 + (b2 + b3) * x3)
        let ry: f64 = geom.pts_y(pts, first + i) - ((b0 + b1) * y0 + (b2 + b3) * y3)
        xa = xa + a1x * rx + a1y * ry
        xb = xb + a2x * rx + a2y * ry
        i = i + 1
    }
    let det: f64 = c00 * c11 - c01 * c01
    let seg: f64 = geom.dist(x0, y0, x3, y3)
    var al: f64 = seg / 3.0
    var ar: f64 = seg / 3.0
    if math.fabs(det) > 1e-12 {
        let dl: f64 = (xa * c11 - xb * c01) / det
        let dr: f64 = (c00 * xb - c01 * xa) / det
        if dl > seg * 1e-6 && dr > seg * 1e-6 && dl < seg * 4.0 && dr < seg * 4.0 {
            al = dl
            ar = dr
        }
    }
    cubic.cub_set(c, x0, y0, x0 + t1.x * al, y0 + t1.y * al, x3 + t2.x * ar, y3 + t2.y * ar, x3, y3)
}

fn reparam(pts: *mut Vec[f64], first: usize, last: usize, u: *mut Vec[f64], c: *mut cubic.Cub) {
    let m: usize = last - first + 1
    var i: usize = 0
    while i < m {
        let t: f64 = (*u)[i]
        let dx: f64 = cubic.cub_x(c, t) - geom.pts_x(pts, first + i)
        let dy: f64 = cubic.cub_y(c, t) - geom.pts_y(pts, first + i)
        let d1x: f64 = cubic.cub_dx(c, t)
        let d1y: f64 = cubic.cub_dy(c, t)
        let d2x: f64 = cubic.cub_ddx(c, t)
        let d2y: f64 = cubic.cub_ddy(c, t)
        let num: f64 = dx * d1x + dy * d1y
        let den: f64 = d1x * d1x + d1y * d1y + dx * d2x + dy * d2y
        if math.fabs(den) > 1e-12 {
            var nt: f64 = t - num / den
            if nt < 0.0 {
                nt = 0.0
            }
            if nt > 1.0 {
                nt = 1.0
            }
            (*u)[i] = nt
        }
        i = i + 1
    }
}

fn max_error(pts: *mut Vec[f64], first: usize, last: usize, c: *mut cubic.Cub, u: *mut Vec[f64], split: *mut usize) -> f64 {
    var worst: f64 = 0.0
    var wi: usize = (first + last) / 2
    let m: usize = last - first + 1
    var i: usize = 1
    while i + 1 < m {
        let t: f64 = (*u)[i]
        let d: f64 = geom.dist2(cubic.cub_x(c, t), cubic.cub_y(c, t), geom.pts_x(pts, first + i), geom.pts_y(pts, first + i))
        if d >= worst {
            worst = d
            wi = first + i
        }
        i = i + 1
    }
    *split = wi
    return worst
}

fn is_straight(pts: *mut Vec[f64], first: usize, last: usize, tol: f64) -> bool {
    let ax: f64 = geom.pts_x(pts, first)
    let ay: f64 = geom.pts_y(pts, first)
    let bx: f64 = geom.pts_x(pts, last)
    let by: f64 = geom.pts_y(pts, last)
    var i: usize = first + 1
    while i < last {
        if geom.seg_dist(geom.pts_x(pts, i), geom.pts_y(pts, i), ax, ay, bx, by) > tol {
            return false
        }
        i = i + 1
    }
    return true
}

fn fit_range(pts: *mut Vec[f64], first: usize, last: usize, t1: Tan, t2: Tan, maxerr: f64, out: *mut path.Path) {
    if last - first == 1 || is_straight(pts, first, last, maxerr * 0.5) {
        path.path_line(out, geom.pts_x(pts, last), geom.pts_y(pts, last))
        return
    }
    var u: Vec[f64] = geom.pts_new()
    chord_params(pts, first, last, &u)
    var c: cubic.Cub = cubic.Cub { x0: 0.0, y0: 0.0, x1: 0.0, y1: 0.0, x2: 0.0, y2: 0.0, x3: 0.0, y3: 0.0 }
    build_cubic(pts, first, last, &u, t1, t2, &c)
    var split: usize = (first + last) / 2
    let lim: f64 = maxerr * maxerr
    var err: f64 = max_error(pts, first, last, &c, &u, &split)
    var it: usize = 0
    while err >= lim && err < lim * 64.0 && it < MAX_REPARAM {
        reparam(pts, first, last, &u, &c)
        build_cubic(pts, first, last, &u, t1, t2, &c)
        err = max_error(pts, first, last, &c, &u, &split)
        it = it + 1
    }
    if err < lim {
        path.path_cubic(out, c.x1, c.y1, c.x2, c.y2, c.x3, c.y3)
        vec_free[f64](&u)
        return
    }
    vec_free[f64](&u)
    if split <= first {
        split = first + 1
    }
    if split >= last {
        split = last - 1
    }
    let cx: f64 = geom.pts_x(pts, split - 1) - geom.pts_x(pts, split + 1)
    let cy: f64 = geom.pts_y(pts, split - 1) - geom.pts_y(pts, split + 1)
    let tc: Tan = tan_unit(cx, cy, 1.0, 0.0)
    fit_range(pts, first, split, t1, tc, maxerr, out)
    fit_range(pts, split, last, Tan { x: -tc.x, y: -tc.y }, t2, maxerr, out)
}

fn clean(pts: *mut Vec[f64], n: usize, maxerr: f64, out: *mut Vec[f64]) {
    simplify.dedupe(pts, n, maxerr * 1e-3, out)
}

fn avg_spacing(pts: *mut Vec[f64], n: usize) -> f64 {
    if n < 2 {
        return 1.0
    }
    return simplify.path_length(pts, n) / (n - 1) as f64
}

fn fit_pieces(pts: *mut Vec[f64], n: usize, cuts: *mut Vec[u32], maxerr: f64, out: *mut path.Path) {
    var a: usize = 0
    var k: usize = 0
    while k <= vec_len[u32](cuts) {
        var b: usize = n - 1
        if k < vec_len[u32](cuts) {
            b = (*cuts)[k] as usize
        }
        if b > a {
            fit_range(pts, a, b, tan_start(pts, a, b), tan_end(pts, a, b), maxerr, out)
            a = b
        }
        k = k + 1
    }
}

fn fit_append(pts: *mut Vec[f64], n: usize, maxerr: f64, corner_angle: f64, start: bool, out: *mut path.Path) {
    var d: Vec[f64] = geom.pts_new()
    clean(pts, n, maxerr, &d)
    let m: usize = geom.pts_n(&d)
    if m == 0 {
        geom.pts_free(&d)
        return
    }
    if start {
        path.path_move(out, geom.pts_x(&d, 0), geom.pts_y(&d, 0))
    }
    if m >= 2 {
        var cs: Vec[u32] = vec_new[u32]()
        smooth.corners(&d, m, avg_spacing(&d, m) * 3.0, corner_angle, &cs)
        fit_pieces(&d, m, &cs, maxerr, out)
        vec_free[u32](&cs)
    }
    geom.pts_free(&d)
}

fn fit_ex(pts: *mut Vec[f64], n: usize, maxerr: f64, corner_angle: f64, out: *mut path.Path) {
    fit_append(pts, n, maxerr, corner_angle, true, out)
}

fn fit(pts: *mut Vec[f64], n: usize, maxerr: f64, out: *mut path.Path) {
    fit_ex(pts, n, maxerr, DEFAULT_CORNER, out)
}

fn wrap_tan(r: *mut Vec[f64], n: usize, i: usize) -> Tan {
    let p: usize = (i + n - 1) % n
    let q: usize = (i + 1) % n
    return tan_unit(geom.pts_x(r, q) - geom.pts_x(r, p), geom.pts_y(r, q) - geom.pts_y(r, p), 1.0, 0.0)
}

fn drop_closing_duplicate(d: *mut Vec[f64], maxerr: f64) -> usize {
    var m: usize = geom.pts_n(d)
    if m > 1 && geom.dist(geom.pts_x(d, 0), geom.pts_y(d, 0), geom.pts_x(d, m - 1), geom.pts_y(d, m - 1)) <= maxerr * 1e-3 {
        (*d).len = (*d).len - 2
        m = m - 1
    }
    return m
}

fn loop_corners(d: *mut Vec[f64], m: usize, corner_angle: f64, out: *mut Vec[u32]) {
    vec_clear[u32](out)
    let pad: usize = if m < 12 { m } else { 12 }
    var ext: Vec[f64] = geom.pts_new()
    var i: usize = 0
    while i < m + 2 * pad {
        let k: usize = (i + m - pad % m) % m
        geom.pts_add(&ext, geom.pts_x(d, k), geom.pts_y(d, k))
        i = i + 1
    }
    var raw: Vec[u32] = vec_new[u32]()
    smooth.corners(&ext, m + 2 * pad, avg_spacing(d, m) * 3.0, corner_angle, &raw)
    i = 0
    while i < vec_len[u32](&raw) {
        let e: usize = raw[i] as usize
        if e >= pad && e < pad + m {
            vec_push[u32](out, (e - pad) as u32)
        }
        i = i + 1
    }
    vec_free[f64](&ext)
    vec_free[u32](&raw)
}

fn contains_idx(v: *mut Vec[u32], x: usize) -> bool {
    var i: usize = 0
    while i < vec_len[u32](v) {
        if (*v)[i] as usize == x {
            return true
        }
        i = i + 1
    }
    return false
}

fn sort_u32(v: *mut Vec[u32]) {
    var i: usize = 1
    while i < vec_len[u32](v) {
        let x: u32 = (*v)[i]
        var j: usize = i
        while j > 0 && (*v)[j - 1] > x {
            (*v)[j] = (*v)[j - 1]
            j = j - 1
        }
        (*v)[j] = x
        i = i + 1
    }
}

fn fit_loop_cuts(pts: *mut Vec[f64], n: usize, hard: *mut Vec[u32], maxerr: f64, out: *mut path.Path) {
    var d: Vec[f64] = geom.pts_new()
    clean(pts, n, maxerr, &d)
    let m: usize = drop_closing_duplicate(&d, maxerr)
    if m < 3 {
        var i: usize = 0
        while i < m {
            if i == 0 {
                path.path_move(out, geom.pts_x(&d, 0), geom.pts_y(&d, 0))
            } else {
                path.path_line(out, geom.pts_x(&d, i), geom.pts_y(&d, i))
            }
            i = i + 1
        }
        path.path_too(out)
        geom.pts_free(&d)
        return
    }
    var cs: Vec[u32] = vec_new[u32]()
    var i: usize = 0
    while i < vec_len[u32](hard) {
        if (*hard)[i] as usize >= m {
            i = i + 1
            continue
        }
        if !contains_idx(&cs, (*hard)[i] as usize) {
            vec_push[u32](&cs, (*hard)[i])
        }
        i = i + 1
    }
    sort_u32(&cs)
    var hardn: usize = vec_len[u32](&cs)
    if hardn == 0 {
        vec_push[u32](&cs, 0 as u32)
        vec_push[u32](&cs, (m / 2) as u32)
    } else if hardn == 1 {
        vec_push[u32](&cs, ((cs[0] as usize + m / 2) % m) as u32)
        sort_u32(&cs)
    }
    let c0: usize = cs[0] as usize
    var r: Vec[f64] = geom.pts_new()
    i = 0
    while i <= m {
        let k: usize = (c0 + i) % m
        geom.pts_add(&r, geom.pts_x(&d, k), geom.pts_y(&d, k))
        i = i + 1
    }
    path.path_move(out, geom.pts_x(&r, 0), geom.pts_y(&r, 0))
    let ncut: usize = vec_len[u32](&cs)
    var j: usize = 0
    while j < ncut {
        let a: usize = (cs[j] as usize + m - c0) % m
        var b: usize = m
        if j + 1 < ncut {
            b = (cs[j + 1] as usize + m - c0) % m
        }
        let corner_a: bool = contains_idx(hard, cs[j] as usize)
        let corner_b: bool = contains_idx(hard, cs[(j + 1) % ncut] as usize)
        var t1: Tan = tan_start(&r, a, b)
        var t2: Tan = tan_end(&r, a, b)
        if !corner_a {
            t1 = wrap_tan(&r, m, a)
        }
        if !corner_b {
            let w: Tan = wrap_tan(&r, m, b % m)
            t2 = Tan { x: -w.x, y: -w.y }
        }
        if b > a {
            fit_range(&r, a, b, t1, t2, maxerr, out)
        }
        j = j + 1
    }
    path.path_too(out)
    vec_free[u32](&cs)
    geom.pts_free(&r)
    geom.pts_free(&d)
}

fn fit_loop(pts: *mut Vec[f64], n: usize, maxerr: f64, corner_angle: f64, out: *mut path.Path) {
    var d: Vec[f64] = geom.pts_new()
    clean(pts, n, maxerr, &d)
    let m: usize = drop_closing_duplicate(&d, maxerr)
    var cs: Vec[u32] = vec_new[u32]()
    if m >= 3 {
        loop_corners(&d, m, corner_angle, &cs)
    }
    fit_loop_cuts(&d, m, &cs, maxerr, out)
    vec_free[u32](&cs)
    geom.pts_free(&d)
}

fn fit_error(p: *mut path.Path, pts: *mut Vec[f64], n: usize) -> f64 {
    var worst: f64 = 0.0
    var i: usize = 0
    while i < n {
        let d: f64 = nearest_on_path(p, geom.pts_x(pts, i), geom.pts_y(pts, i))
        if d > worst {
            worst = d
        }
        i = i + 1
    }
    return worst
}

fn nearest_on_path(p: *mut path.Path, x: f64, y: f64) -> f64 {
    var best: f64 = 1e30
    let nv: usize = path.path_verbs(p)
    var pi: usize = 0
    var cx: f64 = 0.0
    var cy: f64 = 0.0
    var i: usize = 0
    while i < nv {
        let v: u32 = path.path_verb(p, i)
        if v == path.V_ZUG {
            cx = path.path_px(p, pi)
            cy = path.path_py(p, pi)
            pi = pi + 1
        } else if v == path.V_LINE {
            let nx: f64 = path.path_px(p, pi)
            let ny: f64 = path.path_py(p, pi)
            pi = pi + 1
            let d: f64 = geom.seg_dist(x, y, cx, cy, nx, ny)
            if d < best {
                best = d
            }
            cx = nx
            cy = ny
        } else if v == path.V_CUBIC {
            var c: cubic.Cub = cubic.Cub { x0: cx, y0: cy, x1: path.path_px(p, pi), y1: path.path_py(p, pi), x2: path.path_px(p, pi + 1), y2: path.path_py(p, pi + 1), x3: path.path_px(p, pi + 2), y3: path.path_py(p, pi + 2) }
            pi = pi + 3
            var s: usize = 0
            var px: f64 = cx
            var py: f64 = cy
            while s < 64 {
                let t: f64 = (s + 1) as f64 / 64.0
                let nx: f64 = cubic.cub_x(&c, t)
                let ny: f64 = cubic.cub_y(&c, t)
                let d: f64 = geom.seg_dist(x, y, px, py, nx, ny)
                if d < best {
                    best = d
                }
                px = nx
                py = ny
                s = s + 1
            }
            cx = c.x3
            cy = c.y3
        } else if v == path.V_QUAD {
            pi = pi + 2
        }
        i = i + 1
    }
    return best
}
