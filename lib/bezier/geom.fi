import std.vec
import std.math

export {
    Poly,
    pts_new, pts_free, pts_add, pts_n, pts_x, pts_y, pts_set, pts_clear, pts_copy,
    dist2, dist, len2, lerp, seg_dist, seg_param,
    poly_new, poly_free, poly_clear, poly_add, poly_close, poly_contours,
    poly_start, poly_end, poly_len, poly_x, poly_y,
}

struct Poly {
    pts: Vec[f64],
    ends: Vec[u32],
}

fn pts_new() -> Vec[f64] {
    return vec_new[f64]()
}

fn pts_free(v: *mut Vec[f64]) {
    vec_free[f64](v)
}

fn pts_clear(v: *mut Vec[f64]) {
    vec_clear[f64](v)
}

fn pts_add(v: *mut Vec[f64], x: f64, y: f64) {
    vec_push[f64](v, x)
    vec_push[f64](v, y)
}

fn pts_n(v: *mut Vec[f64]) -> usize {
    return vec_len[f64](v) / 2
}

fn pts_x(v: *mut Vec[f64], i: usize) -> f64 {
    return (*v)[i * 2]
}

fn pts_y(v: *mut Vec[f64], i: usize) -> f64 {
    return (*v)[i * 2 + 1]
}

fn pts_set(v: *mut Vec[f64], i: usize, x: f64, y: f64) {
    (*v)[i * 2] = x
    (*v)[i * 2 + 1] = y
}

fn pts_copy(src: *mut Vec[f64], dst: *mut Vec[f64]) {
    vec_clear[f64](dst)
    var i: usize = 0
    let n: usize = vec_len[f64](src)
    while i < n {
        vec_push[f64](dst, (*src)[i])
        i = i + 1
    }
}

fn dist2(ax: f64, ay: f64, bx: f64, by: f64) -> f64 {
    let dx: f64 = ax - bx
    let dy: f64 = ay - by
    return dx * dx + dy * dy
}

fn dist(ax: f64, ay: f64, bx: f64, by: f64) -> f64 {
    return math.sqrt(dist2(ax, ay, bx, by))
}

fn len2(x: f64, y: f64) -> f64 {
    return math.sqrt(x * x + y * y)
}

fn lerp(a: f64, b: f64, t: f64) -> f64 {
    return a + (b - a) * t
}

fn seg_param(px: f64, py: f64, ax: f64, ay: f64, bx: f64, by: f64) -> f64 {
    let dx: f64 = bx - ax
    let dy: f64 = by - ay
    let l2: f64 = dx * dx + dy * dy
    if l2 <= 0.0 {
        return 0.0
    }
    var t: f64 = ((px - ax) * dx + (py - ay) * dy) / l2
    if t < 0.0 {
        t = 0.0
    }
    if t > 1.0 {
        t = 1.0
    }
    return t
}

fn seg_dist(px: f64, py: f64, ax: f64, ay: f64, bx: f64, by: f64) -> f64 {
    let t: f64 = seg_param(px, py, ax, ay, bx, by)
    return dist(px, py, ax + (bx - ax) * t, ay + (by - ay) * t)
}

fn poly_new() -> Poly {
    return Poly { pts: vec_new[f64](), ends: vec_new[u32]() }
}

fn poly_free(p: *mut Poly) {
    vec_free[f64](&(*p).pts)
    vec_free[u32](&(*p).ends)
}

fn poly_clear(p: *mut Poly) {
    vec_clear[f64](&(*p).pts)
    vec_clear[u32](&(*p).ends)
}

fn poly_add(p: *mut Poly, x: f64, y: f64) {
    pts_add(&(*p).pts, x, y)
}

fn poly_close(p: *mut Poly) {
    let n: usize = pts_n(&(*p).pts)
    var last: usize = 0
    let c: usize = vec_len[u32](&(*p).ends)
    if c > 0 {
        last = (*p).ends[c - 1] as usize
    }
    if n > last {
        vec_push[u32](&(*p).ends, n as u32)
    }
}

fn poly_contours(p: *mut Poly) -> usize {
    return vec_len[u32](&(*p).ends)
}

fn poly_start(p: *mut Poly, c: usize) -> usize {
    if c == 0 {
        return 0
    }
    return (*p).ends[c - 1] as usize
}

fn poly_end(p: *mut Poly, c: usize) -> usize {
    return (*p).ends[c] as usize
}

fn poly_len(p: *mut Poly, c: usize) -> usize {
    return poly_end(p, c) - poly_start(p, c)
}

fn poly_x(p: *mut Poly, i: usize) -> f64 {
    return pts_x(&(*p).pts, i)
}

fn poly_y(p: *mut Poly, i: usize) -> f64 {
    return pts_y(&(*p).pts, i)
}
