import std.vec
import std.math
import svg.path
import bezier.geom
import bezier.cubic

export {
    NodeSet, NONE, NODE_CORNER, NODE_SMOOTH, NODE_SYMMETRIC,
    ns_new, ns_free, ns_count, ns_get, ns_put, ns_has_in, ns_has_out,
    ns_contour_of, ns_cstart, ns_cend, ns_next, ns_prev,
    ns_from_path, ns_to_path,
    ns_move_anchor, ns_move_handle, ns_retract_handle, ns_delete, ns_insert,
}

const NONE: usize = 4294967295
const NODE_CORNER: u32 = 0
const NODE_SMOOTH: u32 = 1
const NODE_SYMMETRIC: u32 = 2
const STRIDE: usize = 8
const F_X: usize = 0
const F_Y: usize = 1
const F_IX: usize = 2
const F_IY: usize = 3
const F_OX: usize = 4
const F_OY: usize = 5
const F_FLAGS: usize = 6

struct NodeSet {
    v: Vec[f64],
    ends: Vec[u32],
    closed: Vec[u32],
}

fn ns_new() -> NodeSet {
    return NodeSet { v: vec_new[f64](), ends: vec_new[u32](), closed: vec_new[u32]() }
}

fn ns_free(s: *mut NodeSet) {
    vec_free[f64](&(*s).v)
    vec_free[u32](&(*s).ends)
    vec_free[u32](&(*s).closed)
}

fn ns_count(s: *mut NodeSet) -> usize {
    return vec_len[f64](&(*s).v) / STRIDE
}

fn ns_get(s: *mut NodeSet, i: usize, k: usize) -> f64 {
    return (*s).v[i * STRIDE + k]
}

fn ns_put(s: *mut NodeSet, i: usize, k: usize, x: f64) {
    (*s).v[i * STRIDE + k] = x
}

fn flags(s: *mut NodeSet, i: usize) -> u32 {
    return ns_get(s, i, F_FLAGS) as u32
}

fn ns_has_in(s: *mut NodeSet, i: usize) -> bool {
    return (flags(s, i) & 1) != 0
}

fn ns_has_out(s: *mut NodeSet, i: usize) -> bool {
    return (flags(s, i) & 2) != 0
}

fn set_flag(s: *mut NodeSet, i: usize, bit: u32, on: bool) {
    var f: u32 = flags(s, i)
    if on {
        f = f | bit
    } else {
        f = f & (7 ^ bit)
    }
    ns_put(s, i, F_FLAGS, f as f64)
}

fn push_node(s: *mut NodeSet, x: f64, y: f64) {
    vec_push[f64](&(*s).v, x)
    vec_push[f64](&(*s).v, y)
    var k: usize = 2
    while k < STRIDE {
        vec_push[f64](&(*s).v, 0.0)
        k = k + 1
    }
}

fn ns_cstart(s: *mut NodeSet, c: usize) -> usize {
    if c == 0 {
        return 0
    }
    return (*s).ends[c - 1] as usize
}

fn ns_cend(s: *mut NodeSet, c: usize) -> usize {
    return (*s).ends[c] as usize
}

fn ns_contour_of(s: *mut NodeSet, i: usize) -> usize {
    var c: usize = 0
    while c < vec_len[u32](&(*s).ends) {
        if i < ns_cend(s, c) {
            return c
        }
        c = c + 1
    }
    return NONE
}

fn ns_next(s: *mut NodeSet, i: usize) -> usize {
    let c: usize = ns_contour_of(s, i)
    if i + 1 < ns_cend(s, c) {
        return i + 1
    }
    if (*s).closed[c] != 0 {
        return ns_cstart(s, c)
    }
    return NONE
}

fn ns_prev(s: *mut NodeSet, i: usize) -> usize {
    let c: usize = ns_contour_of(s, i)
    if i > ns_cstart(s, c) {
        return i - 1
    }
    if (*s).closed[c] != 0 {
        return ns_cend(s, c) - 1
    }
    return NONE
}

fn set_out(s: *mut NodeSet, i: usize, x: f64, y: f64) {
    ns_put(s, i, F_OX, x)
    ns_put(s, i, F_OY, y)
    set_flag(s, i, 2, true)
}

fn set_in(s: *mut NodeSet, i: usize, x: f64, y: f64) {
    ns_put(s, i, F_IX, x)
    ns_put(s, i, F_IY, y)
    set_flag(s, i, 1, true)
}

fn ns_from_path(p: *mut path.Path, s: *mut NodeSet, pmap: *mut Vec[u32], smap: *mut Vec[u32]) {
    let nv: usize = path.path_verbs(p)
    var pi: usize = 0
    var cur: usize = NONE
    var first: usize = NONE
    var open: bool = false
    var i: usize = 0
    while i < nv {
        let v: u32 = path.path_verb(p, i)
        vec_push[u32](smap, NONE as u32)
        if v == path.V_ZUG {
            if open {
                vec_push[u32](&(*s).ends, ns_count(s) as u32)
                vec_push[u32](&(*s).closed, 0 as u32)
            }
            push_node(s, path.path_px(p, pi), path.path_py(p, pi))
            vec_push[u32](pmap, (((ns_count(s) - 1) * 3) as u32))
            cur = ns_count(s) - 1
            first = cur
            open = true
            pi = pi + 1
        } else if v == path.V_LINE {
            (*smap)[i] = cur as u32
            push_node(s, path.path_px(p, pi), path.path_py(p, pi))
            cur = ns_count(s) - 1
            vec_push[u32](pmap, (cur * 3) as u32)
            pi = pi + 1
        } else if v == path.V_QUAD {
            (*smap)[i] = cur as u32
            let qx: f64 = path.path_px(p, pi)
            let qy: f64 = path.path_py(p, pi)
            let ex: f64 = path.path_px(p, pi + 1)
            let ey: f64 = path.path_py(p, pi + 1)
            let sx: f64 = ns_get(s, cur, F_X)
            let sy: f64 = ns_get(s, cur, F_Y)
            set_out(s, cur, sx + (qx - sx) * 2.0 / 3.0, sy + (qy - sy) * 2.0 / 3.0)
            vec_push[u32](pmap, (cur * 3 + 2) as u32)
            push_node(s, ex, ey)
            let nn: usize = ns_count(s) - 1
            set_in(s, nn, ex + (qx - ex) * 2.0 / 3.0, ey + (qy - ey) * 2.0 / 3.0)
            vec_push[u32](pmap, (nn * 3) as u32)
            cur = nn
            pi = pi + 2
        } else if v == path.V_CUBIC {
            (*smap)[i] = cur as u32
            set_out(s, cur, path.path_px(p, pi), path.path_py(p, pi))
            vec_push[u32](pmap, (cur * 3 + 2) as u32)
            push_node(s, path.path_px(p, pi + 2), path.path_py(p, pi + 2))
            let nn: usize = ns_count(s) - 1
            set_in(s, nn, path.path_px(p, pi + 1), path.path_py(p, pi + 1))
            vec_push[u32](pmap, (nn * 3 + 1) as u32)
            vec_push[u32](pmap, (nn * 3) as u32)
            cur = nn
            pi = pi + 3
        } else if v == path.V_ZU {
            if open {
                let same: bool = cur != first && geom.dist(ns_get(s, cur, F_X), ns_get(s, cur, F_Y), ns_get(s, first, F_X), ns_get(s, first, F_Y)) < 1e-9
                if same {
                    if ns_has_in(s, cur) {
                        set_in(s, first, ns_get(s, cur, F_IX), ns_get(s, cur, F_IY))
                    }
                    var k: usize = 0
                    while k < vec_len[u32](pmap) {
                        if (*pmap)[k] as usize / 3 == cur {
                            (*pmap)[k] = ((first * 3) + ((*pmap)[k] as usize % 3)) as u32
                        }
                        k = k + 1
                    }
                    (*s).v.len = (*s).v.len - STRIDE
                } else {
                    (*smap)[i] = cur as u32
                }
                vec_push[u32](&(*s).ends, ns_count(s) as u32)
                vec_push[u32](&(*s).closed, 1 as u32)
                open = false
            }
        }
        i = i + 1
    }
    if open {
        vec_push[u32](&(*s).ends, ns_count(s) as u32)
        vec_push[u32](&(*s).closed, 0 as u32)
    }
}

fn emit_segment(s: *mut NodeSet, a: usize, b: usize, out: *mut path.Path) {
    let ax: f64 = ns_get(s, a, F_X)
    let ay: f64 = ns_get(s, a, F_Y)
    let bx: f64 = ns_get(s, b, F_X)
    let by: f64 = ns_get(s, b, F_Y)
    if ns_has_out(s, a) || ns_has_in(s, b) {
        var c1x: f64 = ax
        var c1y: f64 = ay
        var c2x: f64 = bx
        var c2y: f64 = by
        if ns_has_out(s, a) {
            c1x = ns_get(s, a, F_OX)
            c1y = ns_get(s, a, F_OY)
        }
        if ns_has_in(s, b) {
            c2x = ns_get(s, b, F_IX)
            c2y = ns_get(s, b, F_IY)
        }
        path.path_cubic(out, c1x, c1y, c2x, c2y, bx, by)
    } else {
        path.path_line(out, bx, by)
    }
}

fn ns_to_path(s: *mut NodeSet, out: *mut path.Path) {
    var c: usize = 0
    while c < vec_len[u32](&(*s).ends) {
        let a: usize = ns_cstart(s, c)
        let b: usize = ns_cend(s, c)
        if b > a {
            path.path_move(out, ns_get(s, a, F_X), ns_get(s, a, F_Y))
            var i: usize = a + 1
            while i < b {
                emit_segment(s, i - 1, i, out)
                i = i + 1
            }
            if (*s).closed[c] != 0 {
                if b - a > 1 && (ns_has_out(s, b - 1) || ns_has_in(s, a)) {
                    emit_segment(s, b - 1, a, out)
                }
                path.path_too(out)
            }
        }
        c = c + 1
    }
}

fn ns_move_anchor(s: *mut NodeSet, i: usize, x: f64, y: f64) {
    let dx: f64 = x - ns_get(s, i, F_X)
    let dy: f64 = y - ns_get(s, i, F_Y)
    ns_put(s, i, F_X, x)
    ns_put(s, i, F_Y, y)
    ns_put(s, i, F_IX, ns_get(s, i, F_IX) + dx)
    ns_put(s, i, F_IY, ns_get(s, i, F_IY) + dy)
    ns_put(s, i, F_OX, ns_get(s, i, F_OX) + dx)
    ns_put(s, i, F_OY, ns_get(s, i, F_OY) + dy)
}

fn ns_move_handle(s: *mut NodeSet, i: usize, role: usize, x: f64, y: f64, mode: u32) {
    let ax: f64 = ns_get(s, i, F_X)
    let ay: f64 = ns_get(s, i, F_Y)
    var kx: usize = F_IX
    var ky: usize = F_IY
    var ox: usize = F_OX
    var oy: usize = F_OY
    var other_bit: u32 = 2
    if role == 2 {
        kx = F_OX
        ky = F_OY
        ox = F_IX
        oy = F_IY
        other_bit = 1
    }
    ns_put(s, i, kx, x)
    ns_put(s, i, ky, y)
    set_flag(s, i, if role == 2 { 2 } else { 1 }, true)
    if (flags(s, i) & other_bit) == 0 || mode == NODE_CORNER {
        return
    }
    let hx: f64 = x - ax
    let hy: f64 = y - ay
    let hl: f64 = geom.len2(hx, hy)
    if hl <= 0.0 {
        return
    }
    var keep: f64 = hl
    if mode == NODE_SMOOTH {
        keep = geom.len2(ns_get(s, i, ox) - ax, ns_get(s, i, oy) - ay)
    }
    ns_put(s, i, ox, ax - hx / hl * keep)
    ns_put(s, i, oy, ay - hy / hl * keep)
}

fn ns_retract_handle(s: *mut NodeSet, i: usize, role: usize) {
    set_flag(s, i, if role == 2 { 2 } else { 1 }, false)
}

fn ns_delete(s: *mut NodeSet, i: usize) {
    var nv: Vec[f64] = vec_new[f64]()
    var k: usize = 0
    let total: usize = vec_len[f64](&(*s).v)
    while k < total {
        if k / STRIDE != i {
            vec_push[f64](&nv, (*s).v[k])
        }
        k = k + 1
    }
    vec_free[f64](&(*s).v)
    (*s).v = nv
    var ne: Vec[u32] = vec_new[u32]()
    var nc: Vec[u32] = vec_new[u32]()
    var c: usize = 0
    var prev_end: usize = 0
    while c < vec_len[u32](&(*s).ends) {
        var e: usize = (*s).ends[c] as usize
        if i < e {
            e = e - 1
        }
        if e > prev_end {
            vec_push[u32](&ne, e as u32)
            vec_push[u32](&nc, (*s).closed[c])
            prev_end = e
        }
        c = c + 1
    }
    vec_free[u32](&(*s).ends)
    vec_free[u32](&(*s).closed)
    (*s).ends = ne
    (*s).closed = nc
}

fn ns_insert(s: *mut NodeSet, a: usize, t: f64) -> usize {
    let b: usize = ns_next(s, a)
    if b == NONE {
        return NONE
    }
    let ax: f64 = ns_get(s, a, F_X)
    let ay: f64 = ns_get(s, a, F_Y)
    let bx: f64 = ns_get(s, b, F_X)
    let by: f64 = ns_get(s, b, F_Y)
    let curved: bool = ns_has_out(s, a) || ns_has_in(s, b)
    var nx: f64 = geom.lerp(ax, bx, t)
    var ny: f64 = geom.lerp(ay, by, t)
    var l: cubic.Cub = cubic.Cub { x0: 0.0, y0: 0.0, x1: 0.0, y1: 0.0, x2: 0.0, y2: 0.0, x3: 0.0, y3: 0.0 }
    var r: cubic.Cub = cubic.Cub { x0: 0.0, y0: 0.0, x1: 0.0, y1: 0.0, x2: 0.0, y2: 0.0, x3: 0.0, y3: 0.0 }
    if curved {
        var c: cubic.Cub = cubic.Cub { x0: ax, y0: ay, x1: ax, y1: ay, x2: bx, y2: by, x3: bx, y3: by }
        if ns_has_out(s, a) {
            c.x1 = ns_get(s, a, F_OX)
            c.y1 = ns_get(s, a, F_OY)
        }
        if ns_has_in(s, b) {
            c.x2 = ns_get(s, b, F_IX)
            c.y2 = ns_get(s, b, F_IY)
        }
        cubic.cub_split(&c, t, &l, &r)
        nx = l.x3
        ny = l.y3
    }
    let c: usize = ns_contour_of(s, a)
    var at: usize = a + 1
    if b < a {
        at = ns_cend(s, c)
    }
    var nv: Vec[f64] = vec_new[f64]()
    var k: usize = 0
    let total: usize = ns_count(s)
    while k <= total {
        if k == at {
            vec_push[f64](&nv, nx)
            vec_push[f64](&nv, ny)
            var z: usize = 2
            while z < STRIDE {
                vec_push[f64](&nv, 0.0)
                z = z + 1
            }
        }
        if k < total {
            var z: usize = 0
            while z < STRIDE {
                vec_push[f64](&nv, (*s).v[k * STRIDE + z])
                z = z + 1
            }
        }
        k = k + 1
    }
    vec_free[f64](&(*s).v)
    (*s).v = nv
    var q: usize = c
    while q < vec_len[u32](&(*s).ends) {
        (*s).ends[q] = (*s).ends[q] + 1
        q = q + 1
    }
    if curved {
        set_out(s, a, l.x1, l.y1)
        set_in(s, at, l.x2, l.y2)
        set_out(s, at, r.x1, r.y1)
        let bb: usize = if b < a { ns_cstart(s, c) } else { b + 1 }
        set_in(s, bb, r.x2, r.y2)
    }
    return at
}
