import std.vec
import svg.path
import bezier.quad

export { path_to_quads }

fn path_to_quads(src: *mut path.Path, dst: *mut path.Path, tol: f64) {
    path.path_empty(dst)
    let verbs: usize = path.path_verbs(src)
    var pieces: vec.Vec[f64] = vec.vec_new[f64]()
    var v: usize = 0
    var at: usize = 0
    var cx: f64 = 0.0
    var cy: f64 = 0.0
    while v < verbs {
        let kind: u32 = path.path_verb(src, v)
        if kind == path.V_ZUG {
            cx = path.path_px(src, at)
            cy = path.path_py(src, at)
            path.path_move(dst, cx, cy)
            at = at + 1
        } else if kind == path.V_LINE {
            cx = path.path_px(src, at)
            cy = path.path_py(src, at)
            path.path_line(dst, cx, cy)
            at = at + 1
        } else if kind == path.V_QUAD {
            path.path_quad(dst, path.path_px(src, at), path.path_py(src, at), path.path_px(src, at + 1), path.path_py(src, at + 1))
            cx = path.path_px(src, at + 1)
            cy = path.path_py(src, at + 1)
            at = at + 2
        } else if kind == path.V_CUBIC {
            vec.vec_clear[f64](&pieces)
            let ex: f64 = path.path_px(src, at + 2)
            let ey: f64 = path.path_py(src, at + 2)
            let n: usize = quad.cubic_to_quads(cx, cy, path.path_px(src, at), path.path_py(src, at),
                path.path_px(src, at + 1), path.path_py(src, at + 1), ex, ey, tol, &pieces)
            var q: usize = 0
            while q < n {
                path.path_quad(dst, quad.coord_at(&pieces, q * 4), quad.coord_at(&pieces, q * 4 + 1),
                    quad.coord_at(&pieces, q * 4 + 2), quad.coord_at(&pieces, q * 4 + 3))
                q = q + 1
            }
            cx = ex
            cy = ey
            at = at + 3
        } else {
            path.path_too(dst)
        }
        v = v + 1
    }
    vec.vec_free[f64](&pieces)
}
