export { Cub, cub_set, cub_x, cub_y, cub_dx, cub_dy, cub_ddx, cub_ddy, cub_split, bez3, bez3d, bez3dd }

struct Cub {
    x0: f64, y0: f64,
    x1: f64, y1: f64,
    x2: f64, y2: f64,
    x3: f64, y3: f64,
}

fn cub_set(c: *mut Cub, x0: f64, y0: f64, x1: f64, y1: f64, x2: f64, y2: f64, x3: f64, y3: f64) {
    (*c).x0 = x0
    (*c).y0 = y0
    (*c).x1 = x1
    (*c).y1 = y1
    (*c).x2 = x2
    (*c).y2 = y2
    (*c).x3 = x3
    (*c).y3 = y3
}

fn bez3(a: f64, b: f64, c: f64, d: f64, t: f64) -> f64 {
    let s: f64 = 1.0 - t
    return s * s * s * a + 3.0 * s * s * t * b + 3.0 * s * t * t * c + t * t * t * d
}

fn bez3d(a: f64, b: f64, c: f64, d: f64, t: f64) -> f64 {
    let s: f64 = 1.0 - t
    return 3.0 * (s * s * (b - a) + 2.0 * s * t * (c - b) + t * t * (d - c))
}

fn bez3dd(a: f64, b: f64, c: f64, d: f64, t: f64) -> f64 {
    let s: f64 = 1.0 - t
    return 6.0 * (s * (c - 2.0 * b + a) + t * (d - 2.0 * c + b))
}

fn cub_x(c: *mut Cub, t: f64) -> f64 {
    return bez3((*c).x0, (*c).x1, (*c).x2, (*c).x3, t)
}

fn cub_y(c: *mut Cub, t: f64) -> f64 {
    return bez3((*c).y0, (*c).y1, (*c).y2, (*c).y3, t)
}

fn cub_dx(c: *mut Cub, t: f64) -> f64 {
    return bez3d((*c).x0, (*c).x1, (*c).x2, (*c).x3, t)
}

fn cub_dy(c: *mut Cub, t: f64) -> f64 {
    return bez3d((*c).y0, (*c).y1, (*c).y2, (*c).y3, t)
}

fn cub_ddx(c: *mut Cub, t: f64) -> f64 {
    return bez3dd((*c).x0, (*c).x1, (*c).x2, (*c).x3, t)
}

fn cub_ddy(c: *mut Cub, t: f64) -> f64 {
    return bez3dd((*c).y0, (*c).y1, (*c).y2, (*c).y3, t)
}

fn cub_split(c: *mut Cub, t: f64, l: *mut Cub, r: *mut Cub) {
    let ax: f64 = (*c).x0 + ((*c).x1 - (*c).x0) * t
    let ay: f64 = (*c).y0 + ((*c).y1 - (*c).y0) * t
    let bx: f64 = (*c).x1 + ((*c).x2 - (*c).x1) * t
    let by: f64 = (*c).y1 + ((*c).y2 - (*c).y1) * t
    let cx: f64 = (*c).x2 + ((*c).x3 - (*c).x2) * t
    let cy: f64 = (*c).y2 + ((*c).y3 - (*c).y2) * t
    let dx: f64 = ax + (bx - ax) * t
    let dy: f64 = ay + (by - ay) * t
    let ex: f64 = bx + (cx - bx) * t
    let ey: f64 = by + (cy - by) * t
    let fx: f64 = dx + (ex - dx) * t
    let fy: f64 = dy + (ey - dy) * t
    cub_set(l, (*c).x0, (*c).y0, ax, ay, dx, dy, fx, fy)
    cub_set(r, fx, fy, ex, ey, cx, cy, (*c).x3, (*c).y3)
}
