import std.math
import std.vec

export {
    MAX_SPLITS,
    cubic_error_bound, cubic_split_count, cubic_to_quads,
    cubic_point_x, cubic_point_y, quad_point_x, quad_point_y, coord_at,
}

const MAX_SPLITS: usize = 64

fn sqrt3_over_36() -> f64 {
    return 0.04811252243246881
}

fn cubic_error_bound(x0: f64, y0: f64, c1x: f64, c1y: f64, c2x: f64, c2y: f64, x1: f64, y1: f64) -> f64 {
    let dx: f64 = x1 - 3.0 * c2x + 3.0 * c1x - x0
    let dy: f64 = y1 - 3.0 * c2y + 3.0 * c1y - y0
    return sqrt3_over_36() * math.sqrt(dx * dx + dy * dy)
}

fn cubic_split_count(x0: f64, y0: f64, c1x: f64, c1y: f64, c2x: f64, c2y: f64, x1: f64, y1: f64, tol: f64) -> usize {
    let bound: f64 = cubic_error_bound(x0, y0, c1x, c1y, c2x, c2y, x1, y1)
    var n: usize = 1
    while n < MAX_SPLITS {
        let nf: f64 = n as f64
        if bound / (nf * nf * nf) <= tol {
            return n
        }
        n = n + 1
    }
    return MAX_SPLITS
}

fn coord_at(v: *mut vec.Vec[f64], i: usize) -> f64 {
    return *vec.vec_elem_ptr[f64](v, i)
}

fn lerp(a: f64, b: f64, t: f64) -> f64 {
    return a + (b - a) * t
}

fn cubic_point_x(x0: f64, c1x: f64, c2x: f64, x1: f64, t: f64) -> f64 {
    let u: f64 = 1.0 - t
    return u * u * u * x0 + 3.0 * u * u * t * c1x + 3.0 * u * t * t * c2x + t * t * t * x1
}

fn cubic_point_y(y0: f64, c1y: f64, c2y: f64, y1: f64, t: f64) -> f64 {
    return cubic_point_x(y0, c1y, c2y, y1, t)
}

fn quad_point_x(x0: f64, cx: f64, x1: f64, t: f64) -> f64 {
    let u: f64 = 1.0 - t
    return u * u * x0 + 2.0 * u * t * cx + t * t * x1
}

fn quad_point_y(y0: f64, cy: f64, y1: f64, t: f64) -> f64 {
    return quad_point_x(y0, cy, y1, t)
}

fn sub_cubic(v: *mut f64, t0: f64, t1: f64, out: *mut f64) {
    var left: [f64; 8] = [0.0; 8]
    var tmp: [f64; 8] = [0.0; 8]
    var k: usize = 0
    while k < 2 {
        let p0: f64 = *(v + k)
        let p1: f64 = *(v + 2 + k)
        let p2: f64 = *(v + 4 + k)
        let p3: f64 = *(v + 6 + k)
        let a: f64 = lerp(p0, p1, t1)
        let b: f64 = lerp(p1, p2, t1)
        let c: f64 = lerp(p2, p3, t1)
        let ab: f64 = lerp(a, b, t1)
        let bc: f64 = lerp(b, c, t1)
        let abc: f64 = lerp(ab, bc, t1)
        left[k] = p0
        left[2 + k] = a
        left[4 + k] = ab
        left[6 + k] = abc
        k = k + 1
    }
    var s: f64 = 0.0
    if t1 > 0.0 {
        s = t0 / t1
    }
    k = 0
    while k < 2 {
        let q0: f64 = left[k]
        let q1: f64 = left[2 + k]
        let q2: f64 = left[4 + k]
        let q3: f64 = left[6 + k]
        let r: f64 = lerp(q2, q3, s)
        let r1: f64 = lerp(q1, q2, s)
        let r0: f64 = lerp(q0, q1, s)
        let m1: f64 = lerp(r0, r1, s)
        let m2: f64 = lerp(r1, r, s)
        let m: f64 = lerp(m1, m2, s)
        tmp[k] = m
        tmp[2 + k] = m2
        tmp[4 + k] = r
        tmp[6 + k] = q3
        k = k + 1
    }
    var i: usize = 0
    while i < 8 {
        *(out + i) = tmp[i]
        i = i + 1
    }
}

fn cubic_to_quads(x0: f64, y0: f64, c1x: f64, c1y: f64, c2x: f64, c2y: f64, x1: f64, y1: f64,
    tol: f64, out: *mut vec.Vec[f64]) -> usize {
    let n: usize = cubic_split_count(x0, y0, c1x, c1y, c2x, c2y, x1, y1, tol)
    var whole: [f64; 8] = [x0, y0, c1x, c1y, c2x, c2y, x1, y1]
    var piece: [f64; 8] = [0.0; 8]
    var i: usize = 0
    while i < n {
        let t0: f64 = (i as f64) / (n as f64)
        let t1: f64 = ((i + 1) as f64) / (n as f64)
        sub_cubic(&whole[0], t0, t1, &piece[0])
        let qx: f64 = (3.0 * (piece[2] + piece[4]) - piece[0] - piece[6]) / 4.0
        let qy: f64 = (3.0 * (piece[3] + piece[5]) - piece[1] - piece[7]) / 4.0
        vec.vec_push[f64](out, qx)
        vec.vec_push[f64](out, qy)
        vec.vec_push[f64](out, piece[6])
        vec.vec_push[f64](out, piece[7])
        i = i + 1
    }
    return n
}
