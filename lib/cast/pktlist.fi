import std.rt

export { PktList, pl_new, pl_free, pl_clear, pl_add, pl_next, pl_count }

struct PktList {
    data: rt.Buf,
    count: usize,
}

fn pl_new() -> PktList {
    return PktList { data: rt.buf_new(), count: 0 }
}

fn pl_free(l: *mut PktList) {
    rt.buf_free(&(*l).data)
}

fn pl_clear(l: *mut PktList) {
    rt.buf_clear(&(*l).data)
    (*l).count = 0
}

fn pl_count(l: *mut PktList) -> usize {
    return (*l).count
}

fn pl_add(l: *mut PktList, p: u64, n: usize) {
    rt.buf_push(&(*l).data, (n >> 8) as u8)
    rt.buf_push(&(*l).data, (n & 255) as u8)
    rt.buf_push_bytes(&(*l).data, p, n)
    (*l).count = (*l).count + 1
}

fn pl_next(l: *mut PktList, pos: *mut usize, p: *mut u64, n: *mut usize) -> bool {
    if (*pos) + 2 > (*l).data.len { return false }
    let len: usize = ((rt.ld8((*l).data.ptr, (*pos)) as usize) << 8) | (rt.ld8((*l).data.ptr, (*pos) + 1) as usize)
    if (*pos) + 2 + len > (*l).data.len { return false }
    (*p) = (*l).data.ptr + ((*pos) + 2) as u64
    (*n) = len
    (*pos) = (*pos) + 2 + len
    return true
}
