// SPDX-License-Identifier: MPL-2.0
import std.rt

export { rtcp_pli, rtcp_is_pli, rtcp_sender_report, rtcp_bye, rtcp_kind, RTCP_SR, RTCP_RR, RTCP_BYE, RTCP_PSFB }

const RTCP_SR: u32 = 200
const RTCP_RR: u32 = 201
const RTCP_BYE: u32 = 203
const RTCP_PSFB: u32 = 206

fn put32(out: *mut rt.Buf, v: u32) {
    rt.buf_push(out, ((v >> 24) & 255 as u32) as u8)
    rt.buf_push(out, ((v >> 16) & 255 as u32) as u8)
    rt.buf_push(out, ((v >> 8) & 255 as u32) as u8)
    rt.buf_push(out, (v & 255 as u32) as u8)
}

fn rtcp_pli(out: *mut rt.Buf, sender_ssrc: u32, media_ssrc: u32) {
    rt.buf_push(out, 129 as u8)
    rt.buf_push(out, RTCP_PSFB as u8)
    rt.buf_push(out, 0 as u8)
    rt.buf_push(out, 2 as u8)
    put32(out, sender_ssrc)
    put32(out, media_ssrc)
}

fn rtcp_kind(p: u64, n: usize) -> u32 {
    if n < 8 { return 0 as u32 }
    if (rt.ld8(p, 0) as u32 >> 6) != 2 as u32 { return 0 as u32 }
    return rt.ld8(p, 1) as u32
}

fn rtcp_is_pli(p: u64, n: usize) -> bool {
    if rtcp_kind(p, n) != RTCP_PSFB || n < 12 { return false }
    return (rt.ld8(p, 0) as u32 & 31 as u32) == 1 as u32
}

fn rtcp_sender_report(out: *mut rt.Buf, ssrc: u32, ntp_hi: u32, ntp_lo: u32, rtp_ts: u32, packets: u32, octets: u32) {
    rt.buf_push(out, 128 as u8)
    rt.buf_push(out, RTCP_SR as u8)
    rt.buf_push(out, 0 as u8)
    rt.buf_push(out, 6 as u8)
    put32(out, ssrc)
    put32(out, ntp_hi)
    put32(out, ntp_lo)
    put32(out, rtp_ts)
    put32(out, packets)
    put32(out, octets)
}

fn rtcp_bye(out: *mut rt.Buf, ssrc: u32) {
    rt.buf_push(out, 129 as u8)
    rt.buf_push(out, RTCP_BYE as u8)
    rt.buf_push(out, 0 as u8)
    rt.buf_push(out, 1 as u8)
    put32(out, ssrc)
}
