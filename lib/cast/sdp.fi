import std.rt
import std.base64
import cast.nal
import cast.rtsp

export { sdp_h264, sdp_sprop_to_annexb, sdp_control }

fn hex_digit(v: u32) -> u8 {
    if v < 10 as u32 { return (48 + v) as u8 }
    return (55 + v) as u8
}

fn put_hex2(out: *mut rt.Buf, v: u32) {
    rt.buf_push(out, hex_digit((v >> 4) & 15 as u32))
    rt.buf_push(out, hex_digit(v & 15 as u32))
}

fn sdp_h264(out: *mut rt.Buf, host: str, pt: u32, headers_annexb: u64, hn: usize, fps: u32, control: str) -> bool {
    var it: nal.NalIter = nal.nal_iter_new(headers_annexb, hn)
    var off: usize = 0
    var len: usize = 0
    var sps_off: usize = 0
    var sps_len: usize = 0
    var pps_off: usize = 0
    var pps_len: usize = 0
    while nal.nal_iter_next(&it, &off, &len) {
        let k: u32 = nal.nal_type(rt.ld8(headers_annexb, off))
        if k == 7 as u32 {
            sps_off = off
            sps_len = len
        }
        if k == 8 as u32 {
            pps_off = off
            pps_len = len
        }
    }
    if sps_len < 4 || pps_len < 1 { return false }
    rtsp.rtsp_push_text(out, "v=0\r\no=- 0 0 IN IP4 ")
    rtsp.rtsp_push_text(out, host)
    rtsp.rtsp_push_text(out, "\r\ns=Firn Cast\r\nc=IN IP4 0.0.0.0\r\nt=0 0\r\nm=video 0 RTP/AVP ")
    rt.buf_push_dec_u64(out, pt as u64)
    rtsp.rtsp_push_text(out, "\r\na=rtpmap:")
    rt.buf_push_dec_u64(out, pt as u64)
    rtsp.rtsp_push_text(out, " H264/90000\r\na=fmtp:")
    rt.buf_push_dec_u64(out, pt as u64)
    rtsp.rtsp_push_text(out, " packetization-mode=1;profile-level-id=")
    put_hex2(out, rt.ld8(headers_annexb, sps_off + 1) as u32)
    put_hex2(out, rt.ld8(headers_annexb, sps_off + 2) as u32)
    put_hex2(out, rt.ld8(headers_annexb, sps_off + 3) as u32)
    rtsp.rtsp_push_text(out, ";sprop-parameter-sets=")
    base64.encode(headers_annexb + sps_off as u64, sps_len, out)
    rt.buf_push(out, 44 as u8)
    base64.encode(headers_annexb + pps_off as u64, pps_len, out)
    rtsp.rtsp_push_text(out, "\r\na=framerate:")
    rt.buf_push_dec_u64(out, fps as u64)
    rtsp.rtsp_push_text(out, "\r\na=control:")
    rtsp.rtsp_push_text(out, control)
    rtsp.rtsp_push_text(out, "\r\n")
    return true
}

fn sdp_sprop_to_annexb(p: u64, n: usize, out: *mut rt.Buf) -> bool {
    let at: i64 = rtsp.rtsp_find(p, n, 0, "sprop-parameter-sets=")
    if at < 0 { return false }
    var i: usize = at as usize + 21
    var seg_start: usize = i
    var count: u32 = 0 as u32
    var done: bool = false
    while !done {
        let end: bool = i >= n || rt.ld8(p, i) == 13 as u8 || rt.ld8(p, i) == 10 as u8 || rt.ld8(p, i) == 59 as u8 || rt.ld8(p, i) == 32 as u8
        if end || rt.ld8(p, i) == 44 as u8 {
            var raw: rt.Buf = rt.buf_new()
            if !base64.decode(p + seg_start as u64, i - seg_start, &raw) || raw.len == 0 {
                rt.buf_free(&raw)
                return false
            }
            rt.buf_push(out, 0 as u8)
            rt.buf_push(out, 0 as u8)
            rt.buf_push(out, 0 as u8)
            rt.buf_push(out, 1 as u8)
            rt.buf_push_bytes(out, raw.ptr, raw.len)
            rt.buf_free(&raw)
            count = count + 1 as u32
            seg_start = i + 1
            if end { done = true }
        }
        i = i + 1
    }
    return count >= 2 as u32
}

fn sdp_control(p: u64, n: usize, off: *mut usize, len: *mut usize) -> bool {
    let at: i64 = rtsp.rtsp_find(p, n, 0, "a=control:")
    if at < 0 { return false }
    var s: usize = at as usize + 10
    var e: usize = s
    while e < n && rt.ld8(p, e) != 13 as u8 && rt.ld8(p, e) != 10 as u8 { e = e + 1 }
    (*off) = s
    (*len) = e - s
    return true
}
