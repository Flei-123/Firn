import std.rt

export {
    RtspMsg,
    rtsp_parse, rtsp_header, rtsp_cseq, rtsp_is_method, rtsp_build_request, rtsp_build_response,
    rtsp_text_eq, rtsp_find, rtsp_number,
    RTSP_NEED_MORE, RTSP_INVALID,
}

const RTSP_NEED_MORE: i64 = 0
const RTSP_INVALID: i64 = -1

struct RtspMsg {
    is_response: bool,
    status: u32,
    m_off: usize,
    m_len: usize,
    u_off: usize,
    u_len: usize,
    h_off: usize,
    h_end: usize,
    b_off: usize,
    b_len: usize,
    used: usize,
}

fn lower(c: u8) -> u8 {
    if c >= 65 as u8 && c <= 90 as u8 { return c + 32 as u8 }
    return c
}

fn rtsp_text_eq(p: u64, n: usize, s: str) -> bool {
    if n != s.n { return false }
    var i: usize = 0
    while i < n {
        if lower(rt.ld8(p, i)) != lower(rt.ld8(s.p as u64, i)) { return false }
        i = i + 1
    }
    return true
}

fn rtsp_find(p: u64, n: usize, from: usize, s: str) -> i64 {
    if s.n == 0 || n < s.n { return -1 }
    var i: usize = from
    while i + s.n <= n {
        var k: usize = 0
        while k < s.n && rt.ld8(p, i + k) == rt.ld8(s.p as u64, k) { k = k + 1 }
        if k == s.n { return i as i64 }
        i = i + 1
    }
    return -1
}

fn line_end(p: u64, n: usize, from: usize) -> i64 {
    var i: usize = from
    while i + 1 < n {
        if rt.ld8(p, i) == 13 as u8 && rt.ld8(p, i + 1) == 10 as u8 { return i as i64 }
        i = i + 1
    }
    return -1
}

fn rtsp_number(p: u64, n: usize) -> i64 {
    var v: i64 = 0
    var i: usize = 0
    var any: bool = false
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c >= 48 as u8 && c <= 57 as u8 {
            v = v * 10 + (c - 48 as u8) as i64
            any = true
            if v > 100000000 { return -1 }
        } else if c != 32 as u8 {
            return -1
        }
        i = i + 1
    }
    if !any { return -1 }
    return v
}

fn rtsp_parse(p: u64, n: usize, m: *mut RtspMsg) -> i64 {
    let hend: i64 = rtsp_find(p, n, 0, "\r\n\r\n")
    if hend < 0 {
        if n > 65536 { return RTSP_INVALID }
        return RTSP_NEED_MORE
    }
    let first_end: i64 = line_end(p, n, 0)
    if first_end <= 0 { return RTSP_INVALID }
    let fe: usize = first_end as usize
    var sp1: usize = 0
    while sp1 < fe && rt.ld8(p, sp1) != 32 as u8 { sp1 = sp1 + 1 }
    if sp1 == 0 || sp1 >= fe { return RTSP_INVALID }
    var sp2: usize = sp1 + 1
    while sp2 < fe && rt.ld8(p, sp2) != 32 as u8 { sp2 = sp2 + 1 }
    if sp2 >= fe { return RTSP_INVALID }
    if rtsp_text_eq(p, sp1, "RTSP/1.0") {
        (*m).is_response = true
        let st: i64 = rtsp_number(p + (sp1 + 1) as u64, sp2 - sp1 - 1)
        if st < 100 || st > 599 { return RTSP_INVALID }
        (*m).status = st as u32
        (*m).m_off = 0
        (*m).m_len = 0
        (*m).u_off = 0
        (*m).u_len = 0
    } else {
        if !rtsp_text_eq(p + (sp2 + 1) as u64, fe - sp2 - 1, "RTSP/1.0") { return RTSP_INVALID }
        (*m).is_response = false
        (*m).status = 0 as u32
        (*m).m_off = 0
        (*m).m_len = sp1
        (*m).u_off = sp1 + 1
        (*m).u_len = sp2 - sp1 - 1
    }
    (*m).h_off = fe + 2
    (*m).h_end = hend as usize + 2
    (*m).b_off = hend as usize + 4
    (*m).b_len = 0
    var off: usize = 0
    var len: usize = 0
    if rtsp_header(p, m, "Content-Length", &off, &len) {
        let cl: i64 = rtsp_number(p + off as u64, len)
        if cl < 0 || cl > 1048576 { return RTSP_INVALID }
        (*m).b_len = cl as usize
    }
    if (*m).b_off + (*m).b_len > n { return RTSP_NEED_MORE }
    (*m).used = (*m).b_off + (*m).b_len
    return (*m).used as i64
}

fn rtsp_header(p: u64, m: *mut RtspMsg, name: str, off: *mut usize, len: *mut usize) -> bool {
    var pos: usize = (*m).h_off
    while pos < (*m).h_end {
        var e: usize = pos
        while e + 1 < (*m).h_end + 2 && !(rt.ld8(p, e) == 13 as u8 && rt.ld8(p, e + 1) == 10 as u8) { e = e + 1 }
        var colon: usize = pos
        while colon < e && rt.ld8(p, colon) != 58 as u8 { colon = colon + 1 }
        if colon < e && rtsp_text_eq(p + pos as u64, colon - pos, name) {
            var v: usize = colon + 1
            while v < e && rt.ld8(p, v) == 32 as u8 { v = v + 1 }
            (*off) = v
            (*len) = e - v
            return true
        }
        pos = e + 2
    }
    return false
}

fn rtsp_cseq(p: u64, m: *mut RtspMsg) -> i64 {
    var off: usize = 0
    var len: usize = 0
    if !rtsp_header(p, m, "CSeq", &off, &len) { return -1 }
    return rtsp_number(p + off as u64, len)
}

fn rtsp_is_method(p: u64, m: *mut RtspMsg, name: str) -> bool {
    if (*m).is_response { return false }
    return rtsp_text_eq(p + (*m).m_off as u64, (*m).m_len, name)
}

fn finish(out: *mut rt.Buf, headers: str, body: u64, body_n: usize) {
    if headers.n > 0 { rt.buf_push_bytes(out, headers.p as u64, headers.n) }
    if body_n > 0 {
        rt.buf_push_bytes(out, "Content-Length: ".p as u64, 16)
        rt.buf_push_dec_u64(out, body_n as u64)
        rt.buf_push(out, 13 as u8)
        rt.buf_push(out, 10 as u8)
    }
    rt.buf_push(out, 13 as u8)
    rt.buf_push(out, 10 as u8)
    if body_n > 0 { rt.buf_push_bytes(out, body, body_n) }
}

fn push_str(out: *mut rt.Buf, s: str) {
    if s.n > 0 { rt.buf_push_bytes(out, s.p as u64, s.n) }
}

fn rtsp_build_request(out: *mut rt.Buf, method: str, uri: str, cseq: u32, headers: str, body: u64, body_n: usize) {
    push_str(out, method)
    rt.buf_push(out, 32 as u8)
    push_str(out, uri)
    push_str(out, " RTSP/1.0\r\nCSeq: ")
    rt.buf_push_dec_u64(out, cseq as u64)
    rt.buf_push(out, 13 as u8)
    rt.buf_push(out, 10 as u8)
    finish(out, headers, body, body_n)
}

fn rtsp_build_response(out: *mut rt.Buf, status: u32, cseq: i64, headers: str, body: u64, body_n: usize) {
    push_str(out, "RTSP/1.0 ")
    rt.buf_push_dec_u64(out, status as u64)
    rt.buf_push(out, 32 as u8)
    if status == 200 as u32 {
        push_str(out, "OK")
    } else if status == 400 as u32 {
        push_str(out, "Bad Request")
    } else if status == 404 as u32 {
        push_str(out, "Not Found")
    } else if status == 454 as u32 {
        push_str(out, "Session Not Found")
    } else if status == 455 as u32 {
        push_str(out, "Method Not Valid In This State")
    } else if status == 461 as u32 {
        push_str(out, "Unsupported Transport")
    } else if status == 501 as u32 {
        push_str(out, "Not Implemented")
    } else {
        push_str(out, "Error")
    }
    push_str(out, "\r\nCSeq: ")
    rt.buf_push_dec_u64(out, cseq as u64)
    rt.buf_push(out, 13 as u8)
    rt.buf_push(out, 10 as u8)
    finish(out, headers, body, body_n)
}

export { rtsp_param_u32, rtsp_push_text }

fn rtsp_push_text(out: *mut rt.Buf, s: str) {
    push_str(out, s)
}

fn rtsp_param_u32(p: u64, n: usize, name: str) -> i64 {
    let at: i64 = rtsp_find(p, n, 0, name)
    if at < 0 { return -1 }
    var i: usize = at as usize + name.n
    var v: i64 = 0
    var any: bool = false
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c < 48 as u8 || c > 57 as u8 { break }
        v = v * 10 + (c - 48 as u8) as i64
        any = true
        if v > 4294967295 { return -1 }
        i = i + 1
    }
    if !any { return -1 }
    return v
}
