// SPDX-License-Identifier: MPL-2.0
import std.rt

export {
    BitW, BitR,
    bw_new, bw_free, bw_clear, bw_bits, bw_ue, bw_se, bw_aligned, bw_align_zero,
    bw_bytes, bw_trailing, bw_len, bw_data,
    br_new, br_bits, br_ue, br_se, br_bit_pos, br_aligned, br_align, br_more_data,
    br_bytes_left, br_ptr_here, br_skip_bytes,
}

struct BitW {
    out: rt.Buf,
    cur: u32,
    ncur: u32,
}

struct BitR {
    p: u64,
    n: usize,
    pos: usize,
    stop: usize,
    err: bool,
}

fn bw_new() -> BitW {
    return BitW { out: rt.buf_new(), cur: 0 as u32, ncur: 0 as u32 }
}

fn bw_free(w: *mut BitW) {
    rt.buf_free(&(*w).out)
}

fn bw_clear(w: *mut BitW) {
    rt.buf_clear(&(*w).out)
    (*w).cur = 0 as u32
    (*w).ncur = 0 as u32
}

fn bw_len(w: *mut BitW) -> usize {
    return (*w).out.len
}

fn bw_data(w: *mut BitW) -> u64 {
    return (*w).out.ptr
}

fn bw_bit(w: *mut BitW, b: u32) {
    (*w).cur = ((*w).cur << 1) | (b & 1 as u32)
    (*w).ncur = (*w).ncur + 1 as u32
    if (*w).ncur == 8 as u32 {
        rt.buf_push(&(*w).out, (*w).cur as u8)
        (*w).cur = 0 as u32
        (*w).ncur = 0 as u32
    }
}

fn bw_bits(w: *mut BitW, v: u32, n: u32) {
    var i: u32 = n
    while i > 0 as u32 {
        i = i - 1 as u32
        bw_bit(w, (v >> i) & 1 as u32)
    }
}

fn bw_ue(w: *mut BitW, v: u32) {
    let x: u64 = (v as u64) + 1
    var len: u32 = 0 as u32
    while (x >> (len + 1 as u32)) != 0 {
        len = len + 1 as u32
    }
    var i: u32 = 0 as u32
    while i < len {
        bw_bit(w, 0 as u32)
        i = i + 1 as u32
    }
    var j: u32 = len + 1 as u32
    while j > 0 as u32 {
        j = j - 1 as u32
        bw_bit(w, ((x >> j) & 1) as u32)
    }
}

fn bw_se(w: *mut BitW, v: i32) {
    if v > 0 {
        bw_ue(w, (2 * v - 1) as u32)
    } else {
        bw_ue(w, (-2 * v) as u32)
    }
}

fn bw_aligned(w: *mut BitW) -> bool {
    return (*w).ncur == 0 as u32
}

fn bw_align_zero(w: *mut BitW) {
    while (*w).ncur != 0 as u32 {
        bw_bit(w, 0 as u32)
    }
}

fn bw_bytes(w: *mut BitW, p: u64, n: usize) {
    rt.buf_push_bytes(&(*w).out, p, n)
}

fn bw_trailing(w: *mut BitW) {
    bw_bit(w, 1 as u32)
    bw_align_zero(w)
}

fn br_new(p: u64, n: usize) -> BitR {
    var stop: usize = 0
    var i: usize = n
    while i > 0 {
        i = i - 1
        let b: u32 = rt.ld8(p, i) as u32
        if b != 0 as u32 {
            var k: u32 = 0 as u32
            while ((b >> k) & 1 as u32) == 0 as u32 {
                k = k + 1 as u32
            }
            stop = i * 8 + (7 - k as usize)
            i = 0
        }
    }
    return BitR { p: p, n: n, pos: 0, stop: stop, err: n == 0 }
}

fn br_bit(r: *mut BitR) -> u32 {
    if (*r).pos >= (*r).n * 8 {
        (*r).err = true
        return 0 as u32
    }
    let b: u32 = rt.ld8((*r).p, (*r).pos >> 3) as u32
    let v: u32 = (b >> (7 - ((*r).pos & 7)) as u32) & 1 as u32
    (*r).pos = (*r).pos + 1
    return v
}

fn br_bits(r: *mut BitR, n: u32) -> u32 {
    var v: u32 = 0 as u32
    var i: u32 = 0 as u32
    while i < n {
        v = (v << 1) | br_bit(r)
        i = i + 1 as u32
    }
    return v
}

fn br_ue(r: *mut BitR) -> u32 {
    var zeros: u32 = 0 as u32
    while br_bit(r) == 0 as u32 {
        if (*r).err || zeros > 31 as u32 {
            (*r).err = true
            return 0 as u32
        }
        zeros = zeros + 1 as u32
    }
    if zeros == 0 as u32 { return 0 as u32 }
    let rest: u64 = br_bits(r, zeros) as u64
    return (((1 as u64) << zeros) - 1 + rest) as u32
}

fn br_se(r: *mut BitR) -> i32 {
    let k: u32 = br_ue(r)
    if (k & 1 as u32) == 1 as u32 {
        return ((k + 1 as u32) >> 1) as i32
    }
    return -((k >> 1) as i32)
}

fn br_bit_pos(r: *mut BitR) -> usize {
    return (*r).pos
}

fn br_aligned(r: *mut BitR) -> bool {
    return ((*r).pos & 7) == 0
}

fn br_align(r: *mut BitR) {
    (*r).pos = ((*r).pos + 7) & ~7
}

fn br_more_data(r: *mut BitR) -> bool {
    return !(*r).err && (*r).pos < (*r).stop
}

fn br_bytes_left(r: *mut BitR) -> usize {
    return (*r).n - ((*r).pos >> 3)
}

fn br_ptr_here(r: *mut BitR) -> u64 {
    return (*r).p + ((*r).pos >> 3) as u64
}

fn br_skip_bytes(r: *mut BitR, n: usize) {
    if (*r).pos / 8 + n > (*r).n {
        (*r).err = true
        return
    }
    (*r).pos = (*r).pos + n * 8
}
