// SPDX-License-Identifier: MPL-2.0
import std.rt

export {
    NalIter,
    nal_write, nal_unescape, nal_iter_new, nal_iter_next, nal_type, nal_ref_idc,
    NAL_SLICE, NAL_IDR, NAL_SPS, NAL_PPS,
}

const NAL_SLICE: u32 = 1
const NAL_IDR: u32 = 5
const NAL_SPS: u32 = 7
const NAL_PPS: u32 = 8

struct NalIter {
    p: u64,
    n: usize,
    pos: usize,
}

fn nal_write(out: *mut rt.Buf, ref_idc: u32, kind: u32, rbsp: u64, n: usize) {
    rt.buf_push(out, 0 as u8)
    rt.buf_push(out, 0 as u8)
    rt.buf_push(out, 0 as u8)
    rt.buf_push(out, 1 as u8)
    rt.buf_push(out, ((ref_idc << 5) | kind) as u8)
    var zeros: u32 = 0 as u32
    var i: usize = 0
    while i < n {
        let b: u8 = rt.ld8(rbsp, i)
        if zeros >= 2 as u32 && b <= 3 as u8 {
            rt.buf_push(out, 3 as u8)
            zeros = 0 as u32
        }
        rt.buf_push(out, b)
        if b == 0 as u8 {
            zeros = zeros + 1 as u32
        } else {
            zeros = 0 as u32
        }
        i = i + 1
    }
}

fn nal_unescape(p: u64, n: usize, out: *mut rt.Buf) {
    var zeros: u32 = 0 as u32
    var i: usize = 0
    while i < n {
        let b: u8 = rt.ld8(p, i)
        if zeros >= 2 as u32 && b == 3 as u8 {
            zeros = 0 as u32
        } else {
            rt.buf_push(out, b)
            if b == 0 as u8 {
                zeros = zeros + 1 as u32
            } else {
                zeros = 0 as u32
            }
        }
        i = i + 1
    }
}

fn nal_iter_new(p: u64, n: usize) -> NalIter {
    var it: NalIter = NalIter { p: p, n: n, pos: 0 }
    return it
}

fn start_len_at(p: u64, n: usize, i: usize) -> usize {
    if i + 3 <= n && rt.ld8(p, i) == 0 as u8 && rt.ld8(p, i + 1) == 0 as u8 && rt.ld8(p, i + 2) == 1 as u8 {
        return 3
    }
    return 0
}

fn nal_iter_next(it: *mut NalIter, off: *mut usize, len: *mut usize) -> bool {
    var i: usize = (*it).pos
    var found: usize = 0
    var start: usize = 0
    while i + 3 <= (*it).n {
        let s: usize = start_len_at((*it).p, (*it).n, i)
        if s > 0 {
            start = i + s
            found = 1
            i = (*it).n
        } else {
            i = i + 1
        }
    }
    if found == 0 { return false }
    var e: usize = start
    var stop: bool = false
    while !stop {
        if e + 3 <= (*it).n && start_len_at((*it).p, (*it).n, e) > 0 {
            stop = true
        } else if e >= (*it).n {
            stop = true
        } else {
            e = e + 1
        }
    }
    var end: usize = e
    while end > start && rt.ld8((*it).p, end - 1) == 0 as u8 {
        end = end - 1
    }
    (*off) = start
    (*len) = end - start
    (*it).pos = e
    return true
}

fn nal_type(first: u8) -> u32 {
    return (first as u32) & 31 as u32
}

fn nal_ref_idc(first: u8) -> u32 {
    return ((first as u32) >> 5) & 3 as u32
}
