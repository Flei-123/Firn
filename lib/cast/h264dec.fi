import std.rt
import cast.bits
import cast.nal
import cast.yuv

export {
    Dec,
    dec_new, dec_free, dec_nal, dec_annexb, dec_ready, dec_width, dec_height, dec_to_rgb,
    dec_pictures, dec_frame,
    DEC_OK, DEC_ERR_SYNTAX, DEC_ERR_UNSUPPORTED, DEC_ERR_NO_SPS,
}

const DEC_OK: i32 = 0
const DEC_ERR_SYNTAX: i32 = -1
const DEC_ERR_UNSUPPORTED: i32 = -2
const DEC_ERR_NO_SPS: i32 = -3

struct Dec {
    ready: bool,
    w: usize,
    h: usize,
    mbw: usize,
    mbh: usize,
    log2_frame_num: u32,
    deblock_ctl: bool,
    have_pps: bool,
    frame: yuv.Yuv,
    pictures: u64,
    last_first: usize,
    slices_in_pic: u32,
}

fn dec_new() -> Dec {
    return Dec {
        ready: false, w: 0, h: 0, mbw: 0, mbh: 0, log2_frame_num: 4 as u32, deblock_ctl: false,
        have_pps: false, frame: yuv.yuv_new(16, 16), pictures: 0 as u64, last_first: 0, slices_in_pic: 0 as u32,
    }
}

fn dec_free(d: *mut Dec) {
    yuv.yuv_free(&(*d).frame)
}

fn dec_ready(d: *mut Dec) -> bool { return (*d).ready }
fn dec_width(d: *mut Dec) -> usize { return (*d).w }
fn dec_height(d: *mut Dec) -> usize { return (*d).h }
fn dec_pictures(d: *mut Dec) -> u64 { return (*d).pictures }
fn dec_frame(d: *mut Dec) -> *mut yuv.Yuv { return &(*d).frame }

fn parse_sps(d: *mut Dec, r: *mut bits.BitR) -> i32 {
    let profile_idc: u32 = bits.br_bits(r, 8)
    bits.br_bits(r, 8)
    bits.br_bits(r, 8)
    bits.br_ue(r)
    if profile_idc != 66 as u32 && profile_idc != 77 as u32 && profile_idc != 88 as u32 { return DEC_ERR_UNSUPPORTED }
    let l2: u32 = bits.br_ue(r) + 4 as u32
    let poc: u32 = bits.br_ue(r)
    if poc != 2 as u32 { return DEC_ERR_UNSUPPORTED }
    bits.br_ue(r)
    bits.br_bits(r, 1)
    let mbw: usize = bits.br_ue(r) as usize + 1
    let mbh: usize = bits.br_ue(r) as usize + 1
    let frame_mbs_only: u32 = bits.br_bits(r, 1)
    if (*r).err { return DEC_ERR_SYNTAX }
    if frame_mbs_only != 1 as u32 { return DEC_ERR_UNSUPPORTED }
    bits.br_bits(r, 1)
    var cl: usize = 0
    var cr: usize = 0
    var ct: usize = 0
    var cb: usize = 0
    if bits.br_bits(r, 1) == 1 as u32 {
        cl = bits.br_ue(r) as usize
        cr = bits.br_ue(r) as usize
        ct = bits.br_ue(r) as usize
        cb = bits.br_ue(r) as usize
    }
    if (*r).err { return DEC_ERR_SYNTAX }
    if mbw > 512 || mbh > 512 { return DEC_ERR_UNSUPPORTED }
    let w: usize = mbw * 16 - (cl + cr) * 2
    let h: usize = mbh * 16 - (ct + cb) * 2
    if cl != 0 || ct != 0 { return DEC_ERR_UNSUPPORTED }
    if mbw != (*d).mbw || mbh != (*d).mbh || w != (*d).w || h != (*d).h {
        yuv.yuv_free(&(*d).frame)
        (*d).frame = yuv.yuv_new(mbw * 16, mbh * 16)
        (*d).mbw = mbw
        (*d).mbh = mbh
        (*d).w = w
        (*d).h = h
    }
    (*d).log2_frame_num = l2
    (*d).ready = true
    return DEC_OK
}

fn parse_pps(d: *mut Dec, r: *mut bits.BitR) -> i32 {
    bits.br_ue(r)
    bits.br_ue(r)
    let cabac: u32 = bits.br_bits(r, 1)
    bits.br_bits(r, 1)
    let groups: u32 = bits.br_ue(r)
    bits.br_ue(r)
    bits.br_ue(r)
    let wp: u32 = bits.br_bits(r, 1)
    let wb: u32 = bits.br_bits(r, 2)
    bits.br_se(r)
    bits.br_se(r)
    bits.br_se(r)
    let dbc: u32 = bits.br_bits(r, 1)
    bits.br_bits(r, 1)
    let red: u32 = bits.br_bits(r, 1)
    if (*r).err { return DEC_ERR_SYNTAX }
    if cabac != 0 as u32 || groups != 0 as u32 || wp != 0 as u32 || wb != 0 as u32 || red != 0 as u32 { return DEC_ERR_UNSUPPORTED }
    (*d).deblock_ctl = dbc == 1 as u32
    (*d).have_pps = true
    return DEC_OK
}

fn put_pcm(d: *mut Dec, r: *mut bits.BitR, mbx: usize, mby: usize) -> bool {
    bits.br_align(r)
    if bits.br_bytes_left(r) < 384 { return false }
    var row: usize = 0
    while row < 16 {
        rt.mem_copy((*d).frame.y.ptr + ((mby * 16 + row) * (*d).frame.w + mbx * 16) as u64, bits.br_ptr_here(r), 16)
        bits.br_skip_bytes(r, 16)
        row = row + 1
    }
    row = 0
    while row < 8 {
        rt.mem_copy((*d).frame.u.ptr + ((mby * 8 + row) * (*d).frame.cw + mbx * 8) as u64, bits.br_ptr_here(r), 8)
        bits.br_skip_bytes(r, 8)
        row = row + 1
    }
    row = 0
    while row < 8 {
        rt.mem_copy((*d).frame.v.ptr + ((mby * 8 + row) * (*d).frame.cw + mbx * 8) as u64, bits.br_ptr_here(r), 8)
        bits.br_skip_bytes(r, 8)
        row = row + 1
    }
    return true
}

fn parse_slice(d: *mut Dec, idr: bool, r: *mut bits.BitR) -> i32 {
    if !(*d).ready || !(*d).have_pps { return DEC_ERR_NO_SPS }
    let first: usize = bits.br_ue(r) as usize
    let stype: u32 = bits.br_ue(r) % 5 as u32
    bits.br_ue(r)
    bits.br_bits(r, (*d).log2_frame_num)
    if idr { bits.br_ue(r) }
    let is_i: bool = stype == 2 as u32
    if !is_i && stype != 0 as u32 { return DEC_ERR_UNSUPPORTED }
    if idr && !is_i { return DEC_ERR_SYNTAX }
    if !is_i {
        if bits.br_bits(r, 1) == 1 as u32 { return DEC_ERR_UNSUPPORTED }
        if bits.br_bits(r, 1) == 1 as u32 { return DEC_ERR_UNSUPPORTED }
    }
    if idr {
        bits.br_bits(r, 1)
        bits.br_bits(r, 1)
    } else {
        if bits.br_bits(r, 1) == 1 as u32 { return DEC_ERR_UNSUPPORTED }
    }
    bits.br_se(r)
    if (*d).deblock_ctl {
        let idc: u32 = bits.br_ue(r)
        if idc != 1 as u32 {
            if idc > 2 as u32 { return DEC_ERR_SYNTAX }
            bits.br_se(r)
            bits.br_se(r)
        }
    }
    if (*r).err { return DEC_ERR_SYNTAX }
    let total: usize = (*d).mbw * (*d).mbh
    var addr: usize = first
    while addr < total {
        if !is_i {
            if !bits.br_more_data(r) { return DEC_OK }
            let run: usize = bits.br_ue(r) as usize
            if (*r).err || addr + run > total { return DEC_ERR_SYNTAX }
            addr = addr + run
            if !bits.br_more_data(r) { return DEC_OK }
            if addr >= total { return DEC_ERR_SYNTAX }
        } else if !bits.br_more_data(r) {
            return DEC_OK
        }
        let mt: u32 = bits.br_ue(r)
        var want: u32 = 25 as u32
        if !is_i { want = 30 as u32 }
        if (*r).err { return DEC_ERR_SYNTAX }
        if mt != want { return DEC_ERR_UNSUPPORTED }
        if !put_pcm(d, r, addr % (*d).mbw, addr / (*d).mbw) { return DEC_ERR_SYNTAX }
        addr = addr + 1
    }
    return DEC_OK
}

fn dec_nal(d: *mut Dec, p: u64, n: usize) -> i32 {
    if n < 1 { return DEC_ERR_SYNTAX }
    let kind: u32 = nal.nal_type(rt.ld8(p, 0))
    if kind == 9 as u32 {
        if (*d).slices_in_pic > 0 as u32 {
            (*d).pictures = (*d).pictures + 1 as u64
            (*d).slices_in_pic = 0 as u32
        }
        return DEC_OK
    }
    if kind != 7 as u32 && kind != 8 as u32 && kind != 1 as u32 && kind != 5 as u32 { return DEC_OK }
    var rbsp: rt.Buf = rt.buf_new()
    nal.nal_unescape(p + 1 as u64, n - 1, &rbsp)
    var r: bits.BitR = bits.br_new(rbsp.ptr, rbsp.len)
    var rc: i32 = DEC_OK
    if kind == 7 as u32 {
        rc = parse_sps(d, &r)
    } else if kind == 8 as u32 {
        rc = parse_pps(d, &r)
    } else {
        rc = parse_slice(d, kind == 5 as u32, &r)
        if rc == DEC_OK { (*d).slices_in_pic = (*d).slices_in_pic + 1 as u32 }
    }
    rt.buf_free(&rbsp)
    return rc
}

fn dec_annexb(d: *mut Dec, p: u64, n: usize) -> i32 {
    var it: nal.NalIter = nal.nal_iter_new(p, n)
    var off: usize = 0
    var len: usize = 0
    var worst: i32 = DEC_OK
    while nal.nal_iter_next(&it, &off, &len) {
        if len > 0 {
            let rc: i32 = dec_nal(d, p + off as u64, len)
            if rc != DEC_OK { worst = rc }
        }
    }
    if (*d).slices_in_pic > 0 as u32 {
        (*d).pictures = (*d).pictures + 1 as u64
        (*d).slices_in_pic = 0 as u32
    }
    return worst
}

fn dec_to_rgb(d: *mut Dec, out: u64, stride: usize, fmt: u32) {
    yuv.yuv_to_rgb(&(*d).frame, out, stride, (*d).w, (*d).h, fmt)
}
