// SPDX-License-Identifier: MPL-2.0
// lib/image/picture.fi -- image.picture: a Pillow-like picture facade.
//
//     import image.picture
//     var im: picture.Picture = picture.open("in.jpg")      // PNG / JPEG / WebP / GIF by its first octets
//     var small: picture.Picture = picture.resized(&im, picture.width(&im) / 2, picture.height(&im) / 2)
//     picture.save(&small, "out.png")                        // format by extension: .png .jpg .jpeg .ppm
//     picture.free(&im)
//     picture.free(&small)
//
// (The module is called `picture`, not `image`: module names are flat and
// `image` is lib/photo/image.fi.)
//
// ONE VALUE, NO ERROR UNION. `open`, `from_bytes`, `resized`, `cropped`,
// `gray` return a Picture that is EMPTY when something went wrong (missing
// file, not a picture, over the pixel limit, zero size, out of memory); an
// empty Picture passed to any later call stays empty, and `save` of it
// returns false. So a script checks once at the end (`picture.ok`, or the
// result of `save`) instead of catching every call -- the way Pillow code
// reads. A Picture owns its pixels: `picture.free` releases them.
//
// PIXELS are straight (not premultiplied) RGBA, 8 bit, row 0 at the top;
// `picture.pixels(&im)` is the pointer, `width * height * 4` octets.
//
// DECODERS are the existing ones: lib/paint/png.fi, lib/jpeg (the EXIF
// orientation is applied), lib/webp, lib/gif (first frame). Hostile input
// is bounded by `PICTURE_MAX_PIXELS` (16,777,216) from the header.
// ENCODERS: PNG = pack.icons.png_encode, JPEG = photo.jpegenc (quality 92,
// 4:2:0; `save_jpeg` takes a quality), PPM (P6). JPEG and PPM have no
// alpha: transparent pixels are put on white, as Pillow's users do by hand.
// RESIZING is pack.icons.resample: an area filter down, bilinear up, colour
// weighted by alpha so a transparent pixel never bleeds into an edge.
import std.rt
import std.fs
import paint.png
import jpeg.jpeg
import webp.webp
import gif.gif
import pack.icons
import photo.jpegenc

export {
    Picture, PICTURE_MAX_PIXELS,
    picture_new, free, ok, width, height, pixels, pixel, format,
    open, from_bytes, from_rgba, resized, fit, cropped, gray,
    encode, save, save_jpeg,
    FMT_NONE, FMT_PNG, FMT_JPEG, FMT_WEBP, FMT_GIF,
}

const PICTURE_MAX_PIXELS: u64 = 16777216
const FMT_NONE: u32 = 0
const FMT_PNG: u32 = 1
const FMT_JPEG: u32 = 2
const FMT_WEBP: u32 = 3
const FMT_GIF: u32 = 4

struct Picture {
    px: rt.Buf, // w * h * 4, straight RGBA
    w: usize,
    h: usize,
    fmt: u32, // the format it was opened from (FMT_*), FMT_NONE for made ones
}

fn picture_new() -> Picture {
    return Picture { px: rt.buf_new(), w: 0, h: 0, fmt: 0 }
}

fn free(im: *mut Picture) {
    rt.buf_free(&(*im).px)
    (*im).w = 0
    (*im).h = 0
    (*im).fmt = 0
}

fn ok(im: *mut Picture) -> bool {
    return (*im).w > 0 && (*im).h > 0 && rt.buf_len(&(*im).px) == (*im).w * (*im).h * 4
}

fn width(im: *mut Picture) -> usize {
    return (*im).w
}

fn height(im: *mut Picture) -> usize {
    return (*im).h
}

fn pixels(im: *mut Picture) -> u64 {
    return rt.buf_ptr(&(*im).px)
}

fn format(im: *mut Picture) -> u32 {
    return (*im).fmt
}

// Straight RGBA as 0xAARRGGBB; 0 outside the picture.
fn pixel(im: *mut Picture, x: usize, y: usize) -> u32 {
    if !ok(im) || x >= (*im).w || y >= (*im).h {
        return 0 as u32
    }
    let p: u64 = rt.buf_ptr(&(*im).px) + ((y * (*im).w + x) * 4) as u64
    return ((rt.ld8(p, 3) as u32) << 24) | ((rt.ld8(p, 0) as u32) << 16) |
    ((rt.ld8(p, 1) as u32) << 8) | rt.ld8(p, 2) as u32
}

// A Picture that owns a COPY of `w * h` straight RGBA pixels.
fn from_rgba(src: u64, w: usize, h: usize) -> Picture {
    var im: Picture = picture_new()
    if src == 0 || w == 0 || h == 0 || (w as u64) * (h as u64) > PICTURE_MAX_PIXELS {
        return im
    }
    rt.buf_reserve(&im.px, w * h * 4)
    if im.px.cap < w * h * 4 {
        rt.buf_free(&im.px)
        return im
    }
    rt.mem_copy(rt.buf_ptr(&im.px), src, w * h * 4)
    rt.buf_set_len(&im.px, w * h * 4)
    im.w = w
    im.h = h
    return im
}

fn sniff(p: u64, n: usize) -> u32 {
    if n >= 8 && rt.ld8(p, 0) == 137 as u8 && rt.ld8(p, 1) == 80 as u8 && rt.ld8(p, 2) == 78 as u8 &&
    rt.ld8(p, 3) == 71 as u8 {
        return FMT_PNG
    }
    if n >= 3 && rt.ld8(p, 0) == 255 as u8 && rt.ld8(p, 1) == 216 as u8 && rt.ld8(p, 2) == 255 as u8 {
        return FMT_JPEG
    }
    if n >= 12 && rt.ld8(p, 0) == 82 as u8 && rt.ld8(p, 1) == 73 as u8 && rt.ld8(p, 2) == 70 as u8 &&
    rt.ld8(p, 3) == 70 as u8 && rt.ld8(p, 8) == 87 as u8 && rt.ld8(p, 9) == 69 as u8 &&
    rt.ld8(p, 10) == 66 as u8 && rt.ld8(p, 11) == 80 as u8 {
        return FMT_WEBP
    }
    if n >= 6 && rt.ld8(p, 0) == 71 as u8 && rt.ld8(p, 1) == 73 as u8 && rt.ld8(p, 2) == 70 as u8 &&
    rt.ld8(p, 3) == 56 as u8 {
        return FMT_GIF
    }
    return FMT_NONE
}

// Decodes the octets src[0..n]; empty Picture when they are no picture.
fn from_bytes(src: u64, n: usize) -> Picture {
    let f: u32 = sniff(src, n)
    var im: Picture = picture_new()
    if f == FMT_PNG {
        var d: png.Image = png.image_new()
        if png.decode_png_limited(src, n, PICTURE_MAX_PIXELS, &d) {
            im = from_rgba(d.px as u64, png.image_width(&d), png.image_height(&d))
        }
        png.image_free(&d)
    } else if f == FMT_JPEG {
        var d: jpeg.JpegImage = jpeg.jpeg_image_new()
        let good: bool = jpeg.jpeg_decode_limited(src, n, PICTURE_MAX_PIXELS, &d) catch false
        if good {
            im = from_rgba(rt.buf_ptr(&d.px), d.w as usize, d.h as usize)
        }
        jpeg.jpeg_image_free(&d)
    } else if f == FMT_WEBP {
        var d: webp.WebpImage = webp.webp_image_new()
        let good: bool = webp.webp_decode_limited(src, n, PICTURE_MAX_PIXELS, &d) catch false
        if good {
            im = from_rgba(rt.buf_ptr(&d.px), d.w as usize, d.h as usize)
        }
        webp.webp_image_free(&d)
    } else if f == FMT_GIF {
        var d: gif.GifImage = gif.gif_image_new()
        let good: bool = gif.gif_decode_limited(src, n, PICTURE_MAX_PIXELS, &d) catch false
        if good {
            im = from_rgba(rt.buf_ptr(&d.px), d.w as usize, d.h as usize)
        }
        gif.gif_image_free(&d)
    }
    if ok(&im) {
        im.fmt = f
    }
    return im
}

// Reads and decodes a file; empty Picture when it is missing or no picture.
fn open(path: str) -> Picture {
    var raw: rt.Buf = rt.buf_new()
    let got: usize = fs.read_file(path, &raw) catch 0
    var im: Picture = picture_new()
    if got > 0 {
        im = from_bytes(rt.buf_ptr(&raw), rt.buf_len(&raw))
    }
    rt.buf_free(&raw)
    return im
}

// A new Picture of w x h pixels (area filter down, bilinear up).
fn resized(im: *mut Picture, w: usize, h: usize) -> Picture {
    var out: Picture = picture_new()
    if !ok(im) || w == 0 || h == 0 || (w as u64) * (h as u64) > PICTURE_MAX_PIXELS {
        return out
    }
    var tmp: rt.Buf = rt.buf_new()
    if icons.resample(rt.buf_ptr(&(*im).px), (*im).w, (*im).h, &tmp, w, h) &&
    rt.buf_len(&tmp) == w * h * 4 {
        out = from_rgba(rt.buf_ptr(&tmp), w, h)
    }
    rt.buf_free(&tmp)
    return out
}

// Scaled to fit inside max_w x max_h, keeping the proportions (never
// enlarges): Pillow's `thumbnail`.
fn fit(im: *mut Picture, max_w: usize, max_h: usize) -> Picture {
    if !ok(im) || max_w == 0 || max_h == 0 {
        return picture_new()
    }
    var w: usize = (*im).w
    var h: usize = (*im).h
    if w > max_w {
        h = (h * max_w + w / 2) / w
        w = max_w
    }
    if h > max_h {
        w = (w * max_h + h / 2) / h
        h = max_h
    }
    if w == 0 {
        w = 1
    }
    if h == 0 {
        h = 1
    }
    return resized(im, w, h)
}

// The rectangle x, y, w, h (clipped to the picture); empty when nothing is left.
fn cropped(im: *mut Picture, x: usize, y: usize, w: usize, h: usize) -> Picture {
    var out: Picture = picture_new()
    if !ok(im) || x >= (*im).w || y >= (*im).h || w == 0 || h == 0 {
        return out
    }
    var cw: usize = w
    var ch: usize = h
    if x + cw > (*im).w {
        cw = (*im).w - x
    }
    if y + ch > (*im).h {
        ch = (*im).h - y
    }
    rt.buf_reserve(&out.px, cw * ch * 4)
    if out.px.cap < cw * ch * 4 {
        rt.buf_free(&out.px)
        return out
    }
    var r: usize = 0
    while r < ch {
        rt.mem_copy(rt.buf_ptr(&out.px) + (r * cw * 4) as u64,
            rt.buf_ptr(&(*im).px) + (((y + r) * (*im).w + x) * 4) as u64, cw * 4)
        r = r + 1
    }
    rt.buf_set_len(&out.px, cw * ch * 4)
    out.w = cw
    out.h = ch
    return out
}

// Greyscale (BT.601 luma, like Pillow's convert("L")), alpha kept.
fn gray(im: *mut Picture) -> Picture {
    var out: Picture = from_rgba(rt.buf_ptr(&(*im).px), (*im).w, (*im).h)
    if !ok(&out) {
        return out
    }
    let p: u64 = rt.buf_ptr(&out.px)
    var i: usize = 0
    while i < out.w * out.h {
        let r: u32 = rt.ld8(p, i * 4) as u32
        let g: u32 = rt.ld8(p, i * 4 + 1) as u32
        let b: u32 = rt.ld8(p, i * 4 + 2) as u32
        let l: u8 = ((r * 299 + g * 587 + b * 114 + 500) / 1000) as u8
        rt.st8(p, i * 4, l)
        rt.st8(p, i * 4 + 1, l)
        rt.st8(p, i * 4 + 2, l)
        i = i + 1
    }
    return out
}

// Opaque RGBA of the picture on a white page, into `dst` (cleared first).
fn on_white(im: *mut Picture, dst: *mut rt.Buf, with_alpha_byte: bool) {
    rt.buf_clear(dst)
    let n: usize = (*im).w * (*im).h
    rt.buf_reserve(dst, n * 4)
    let p: u64 = rt.buf_ptr(&(*im).px)
    var i: usize = 0
    while i < n {
        let a: u32 = rt.ld8(p, i * 4 + 3) as u32
        var c: usize = 0
        while c < 3 {
            let v: u32 = rt.ld8(p, i * 4 + c) as u32
            rt.buf_push(dst, ((v * a + 255 * (255 - a) + 127) / 255) as u8)
            c = c + 1
        }
        if with_alpha_byte {
            rt.buf_push(dst, 255 as u8)
        }
        i = i + 1
    }
}

fn lower(c: u8) -> u8 {
    if c >= 65 as u8 && c <= 90 as u8 {
        return c + 32 as u8
    }
    return c
}

// true when `path` ends in `ext` (a lower case ".png"), ignoring case.
fn has_ext(path: str, ext: str) -> bool {
    if path.n < ext.n {
        return false
    }
    var i: usize = 0
    while i < ext.n {
        if lower(rt.ld8(path.p as u64, path.n - ext.n + i)) != rt.ld8(ext.p as u64, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// JPEG into `out` (appended); false when the picture is empty.
fn encode_jpeg(im: *mut Picture, quality: i32, out: *mut rt.Buf) -> bool {
    if !ok(im) {
        return false
    }
    var rgba: rt.Buf = rt.buf_new()
    on_white(im, &rgba, true)
    var o: jpegenc.EncOpts = jpegenc.enc_default()
    o.quality = quality
    let cap: usize = jpegenc.jpeg_max_size((*im).w as i32, (*im).h as i32)
    var tmp: rt.Buf = rt.buf_new()
    rt.buf_reserve(&tmp, cap)
    var good: bool = false
    if tmp.cap >= cap {
        let got: usize = jpegenc.jpeg_encode_rgba(rt.buf_ptr(&rgba), (*im).w as i32, (*im).h as i32, &o,
            rt.buf_ptr(&tmp), cap)
        if got > 0 {
            rt.buf_push_bytes(out, rt.buf_ptr(&tmp), got)
            good = true
        }
    }
    rt.buf_free(&tmp)
    rt.buf_free(&rgba)
    return good
}

fn encode_ppm(im: *mut Picture, out: *mut rt.Buf) -> bool {
    if !ok(im) {
        return false
    }
    let head: str = "P6\n"
    rt.buf_push_bytes(out, head.p as u64, head.n)
    rt.buf_push_dec_u64(out, (*im).w as u64)
    rt.buf_push(out, 32 as u8)
    rt.buf_push_dec_u64(out, (*im).h as u64)
    rt.buf_push(out, 10 as u8)
    let maxv: str = "255\n"
    rt.buf_push_bytes(out, maxv.p as u64, maxv.n)
    var flat: rt.Buf = rt.buf_new()
    on_white(im, &flat, false)
    rt.buf_push_bytes(out, rt.buf_ptr(&flat), rt.buf_len(&flat))
    rt.buf_free(&flat)
    return true
}

// Encodes into `out` (appended) as the format `ext` names (".png", ".jpg",
// ".jpeg", ".ppm", any case; a whole path works too); false for an empty
// Picture or another extension.
fn encode(im: *mut Picture, ext: str, out: *mut rt.Buf) -> bool {
    if !ok(im) {
        return false
    }
    if has_ext(ext, ".png") {
        var tmp: rt.Buf = rt.buf_new()
        let good: bool = icons.png_encode(rt.buf_ptr(&(*im).px), (*im).w, (*im).h, &tmp)
        if good {
            rt.buf_push_bytes(out, rt.buf_ptr(&tmp), rt.buf_len(&tmp))
        }
        rt.buf_free(&tmp)
        return good
    }
    if has_ext(ext, ".jpg") || has_ext(ext, ".jpeg") {
        return encode_jpeg(im, 92, out)
    }
    if has_ext(ext, ".ppm") {
        return encode_ppm(im, out)
    }
    return false
}

fn write_out(out: *mut rt.Buf, path: str) -> bool {
    let n: usize = fs.write_file(path, rt.buf_ptr(out), rt.buf_len(out)) catch 0
    return n == rt.buf_len(out) && n > 0
}

// Writes the picture; the format is taken from the extension of `path`.
fn save(im: *mut Picture, path: str) -> bool {
    var out: rt.Buf = rt.buf_new()
    var good: bool = encode(im, path, &out)
    if good {
        good = write_out(&out, path)
    }
    rt.buf_free(&out)
    return good
}

// JPEG with a quality 1..100.
fn save_jpeg(im: *mut Picture, path: str, quality: i32) -> bool {
    var out: rt.Buf = rt.buf_new()
    var good: bool = encode_jpeg(im, quality, &out)
    if good {
        good = write_out(&out, path)
    }
    rt.buf_free(&out)
    return good
}
