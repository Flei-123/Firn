// SPDX-License-Identifier: MPL-2.0
// lib/fui/kit.fi -- THE APP KIT: the parts a launcher-style program is made of.
//
// ========================================================= WHAT IS HERE
//
// What fUi already has (lib/fui/wave2.fi, wave3.fi, listrow.fi, ...) is the
// control set of a desktop window: buttons, text fields, checkboxes, tabs,
// menus, lists, tables, a modal dialog frame. What a program like a game
// launcher or a mod manager also needs, and fUi did not have, is here:
//
//   button        primary / secondary / ghost / danger, with a symbol
//   toasts        a stack of transient messages (info, success, warning,
//                 error) with an optional action ("Undo") and a close
//                 button -- also the replacement for a system tray balloon
//                 on a platform without one
//   modal         the scrim, the panel, the title bar; and a FOCUS TRAP:
//                 Tab and Shift+Tab cycle inside the dialog, Escape asks
//                 to close, the background is told it is blocked
//   tab bar       tabs with a Lucide symbol, a label and a count badge
//   sidebar       a vertical navigation: symbol + label + badge, section
//                 headers, the active item marked, collapsible to symbols
//   tile grid     cards with a picture (or an avatar / symbol placeholder),
//                 a title and a subtitle; hover, selection, wheel scroll,
//                 arrow keys; as many columns as fit
//   avatar        a disc with initials, one of eight hues per identity
//   search field  the text field of lib/fui/editor.fi with a magnifier and a
//                 clear button (Escape clears too)
//   progress      a bar with a label that stays readable on both the fill
//                 and the track ("42 %", "Downloading 3 of 7"), and an
//                 indeterminate sweep
//
// ========================================================= HOW IT WORKS
//
// Immediate mode, like lib/fui/markdownview.fi and the FirnChat window: every
// frame the program calls `*_draw(c, ...)` with the state it keeps; there is
// no node tree and no allocation (the search field's text buffer apart).
// Every part has the matching `*_hit` that answers WHICH piece is at a point
// from the same geometry function that painted it, so picture and operation
// cannot drift apart (the lesson of lib/fui/viewport.fi). Keys are the
// numbers of lib/fui/editor.fi (what fui.apphost hands to a program).
//
// THE LOOK: only theme tokens (style.TOK_*); the accent as text or as a
// graphic goes through lib/fui/kitcolor.fi so it reads on a white page as
// well as on the dark one (the launcher green #1bd96a: 9:1 on dark, darkened
// automatically to 4.5:1 / 3:1 on light). Lengths are design points through
// render.len_of, on a 4-point grid. Symbols are Lucide (lib/fui/lucide.fi).
// Every symbol is optional: give ICON_NONE and the part lays itself out
// without it (the icon-free variant -- also what a text-only theme wants).
//
// WHERE THE STATE LIVES. `Toasts` and `Modal` hold text the painter reads while it
// draws; keep every state struct of the kit in the program's long-lived storage
// (a `static mut`, the heap, the App struct) and not in the frame of a function
// that returns -- the compiler's escape check says so if it is not.
//
// HONEST LIMITS: no right-to-left mirroring of the parts, no touch gestures
// (the tile grid scrolls with the wheel, bars and keys; a program wanting
// fling feeds viewport_fling), one line of text per toast and per tile line
// (cut with "..."), no animation of hover (the program repaints on a state
// change), the modal does not move focus INTO the program's own widgets --
// it gives the program an index (0..n-1) to draw its focus ring on.
import std.rt
import fui.theme
import fui.style
import fui.painter
import fui.render
import fui.icons
import fui.lucide
import fui.icon
import fui.kitcolor
import fui.editor
import fui.textbuf
import fui.widget
import fui.viewport
import fui.uiimage
import paint.canvas

export {
    NONE, ICON_NONE,
    kit_set_rtl, kit_rtl, rx, label_in,
    ST_HOVER, ST_ACTIVE, ST_FOCUS, ST_DISABLED,
    // helpers
    ln, tokc, with_alpha, text_width, draw_label, focus_ring, fmt_uint, initials,
    // button
    BTN_PRIMARY, BTN_SECONDARY, BTN_GHOST, BTN_DANGER,
    button_draw, button_width, button_height,
    // avatar
    avatar_draw,
    // progress
    PB_NORMAL, PB_SUCCESS, PB_ERROR, progress_draw, progress_height,
    // search
    Search, search_new, search_free, search_draw, search_key, search_char,
    search_press, search_text_ptr, search_text_len, search_set_text,
    search_clear, search_focus, search_has_focus, search_blink, search_clear_rect,
    SEARCH_HIT_NONE, SEARCH_HIT_FIELD, SEARCH_HIT_CLEAR,
    // tabs
    Tab, tabbar_draw, tabbar_hit, tabbar_key, tabbar_height, tab_at, tab_rect,
    // sidebar
    NavItem, nav_draw, nav_hit, nav_key, nav_width, nav_at,
    // tiles
    Tile, TileGrid, tile_at, grid_new, grid_set_rect, grid_layout, grid_paint, grid_hit,
    grid_move, grid_leave, grid_wheel, grid_key, grid_select, grid_selected,
    grid_hover, grid_tile_rect, grid_content_height, grid_tick, grid_bar_press,
    grid_bar_drag, grid_bar_release,
    grid_touch_pan, grid_touch_fling, grid_touch_tap,
    // toasts
    Toast, Toasts, toasts_new, toast_push, toast_dismiss, toasts_tick,
    toasts_active, toasts_count, toasts_draw, toasts_hit, toasts_geometry,
    TK_INFO, TK_SUCCESS, TK_WARNING, TK_ERROR,
    TOAST_PART_BODY, TOAST_PART_ACTION, TOAST_PART_CLOSE,
    TOAST_FADE_IN, TOAST_FADE_OUT, TOAST_MAX,
    // modal
    Modal, modal_new, modal_open, modal_close, modal_blocks, modal_focus,
    modal_set_focus, modal_rect, modal_content_rect, modal_draw, modal_hit,
    modal_key, ring_next, modal_animating,
    MODAL_HIT_SCRIM, MODAL_HIT_PANEL, MODAL_HIT_CLOSE,
    MODAL_KEY_NONE, MODAL_KEY_FOCUS, MODAL_KEY_CLOSE, MODAL_KEY_ACTIVATE,
}

const NONE: usize = 18446744073709551615
const ICON_NONE: i64 = -1

// ====================================================================
// THE LAYOUT DIRECTION
// ====================================================================
//
// `kit_set_rtl(true)` mirrors every part of the kit: the order of tabs and tiles, the side of
// the symbol, the label, the badge, the close button, the sidebar's edge and active mark, the
// fill of a progress bar, the clear button of the search field; labels are right-aligned in
// their boxes; the hit functions answer for the mirrored picture (they use the same geometry
// the drawing used). The flag is the program's environment, like the locale -- one for the
// whole window, set when the language changes -- not a field of every state struct. Text
// itself is ordered by the painter's bidi path (lib/fui/painter.fi); Latin text in a Hebrew
// interface keeps its own direction.
static mut KIT_RTL: bool = false

fn kit_set_rtl(on: bool) {
    KIT_RTL = on
}

fn kit_rtl() -> bool {
    return KIT_RTL
}

// The x of an element [ex, ex + ew) that was laid out left to right inside the box
// [bx, bx + bw), as it stands in the current direction (itself, or mirrored in the box).
fn rx(ex: f64, ew: f64, bx: f64, bw: f64) -> f64 {
    if !KIT_RTL {
        return ex
    }
    return bx + bw - (ex - bx) - ew
}

// the state bits a part is drawn with
const ST_HOVER: u32 = 1
const ST_ACTIVE: u32 = 2
const ST_FOCUS: u32 = 4
const ST_DISABLED: u32 = 8

// ====================================================================
// HELPERS
// ====================================================================

// A design length (points) in device points.
fn ln(c: *mut render.Ctx, pt: usize) -> f64 {
    return render.len_of(c, pt)
}

// A theme token as the painter's colour.
fn tokc(c: *mut render.Ctx, tok: u32) -> u32 {
    return render.color_of(c, style.color_token(tok))
}

// A colour with its alpha multiplied by `a` / 255. THE PAINTER READS ALPHA 0 AS
// "OPAQUE" (a plain 0xRRGGBB means a solid colour, painter.mit_alpha), so the
// result never has alpha 0: the faintest colour is alpha 1 and callers that
// mean "nothing" draw nothing instead.
fn with_alpha(col: u32, a: u32) -> u32 {
    var ca: u32 = (col >> 24) & 255 as u32
    if ca == 0 as u32 {
        ca = 255 as u32
    }
    var na: u32 = (ca * a + 127 as u32) / 255 as u32
    if na == 0 as u32 {
        na = 1 as u32
    }
    return (col & 16777215 as u32) | (na << 24)
}

fn theme_of(c: *mut render.Ctx) -> *mut theme.Theme {
    return render.ctx_theme(c)
}

fn colors_of(c: *mut render.Ctx) -> *mut theme.Colors {
    return theme.theme_colors(render.ctx_theme(c))
}

// The accent as text on the ground token `bg`, as the painter's colour.
fn accent_on(c: *mut render.Ctx, bg_tok: u32) -> u32 {
    let bg: u32 = tokc(c, bg_tok) & 16777215 as u32
    return theme.opaque(kitcolor.accent_text(theme_of(c), bg))
}

// The accent as a graphic on the ground token `bg`.
fn accent_gfx(c: *mut render.Ctx, bg_tok: u32) -> u32 {
    let bg: u32 = tokc(c, bg_tok) & 16777215 as u32
    return theme.opaque(kitcolor.accent_ui(theme_of(c), bg))
}

fn text_run(size: f64, weight: usize) -> painter.TextRun {
    var r: painter.TextRun = painter.run_new(size)
    if weight >= 700 {
        r = painter.run_set_weight(r, 700)
    }
    return r
}

// The width of a one-line label.
fn text_width(c: *mut render.Ctx, size: f64, weight: usize, s: str) -> f64 {
    var r: painter.TextRun = text_run(size, weight)
    return painter.run_width(render.ctx_painter(c), &r, s.p as u64, s.n)
}

// A one-line label, vertically centred in [y, y + h]; cut with "..." if wider
// than `max_w` (0 = no limit). Returns the width it took.
fn draw_label(c: *mut render.Ctx, x: f64, y: f64, h: f64, size: f64, weight: usize,
    col: u32, s: str, max_w: f64) -> f64 {
    if s.n == 0 {
        return 0.0
    }
    let z: *mut painter.Painter = render.ctx_painter(c)
    var r: painter.TextRun = text_run(size, weight)
    let by: f64 = painter.text_baseline_mid(z, y, h, size)
    var room: f64 = max_w
    if room <= 0.0 {
        room = painter.run_width(z, &r, s.p as u64, s.n) + 4.0
    }
    let x1: f64 = painter.run_draw_ellipsis(z, &r, x, by, room, col, s.p as u64, s.n, painter.TEXT_L)
    return x1 - x
}

// A label that STARTS at the start edge of the box [x, x + box_w): at the left in the
// default direction, at the right (right-aligned) in RTL; cut with "..." if wider than the
// box. Returns the width it took.
fn label_in(c: *mut render.Ctx, x: f64, y: f64, h: f64, size: f64, weight: usize,
    col: u32, s: str, box_w: f64) -> f64 {
    if !KIT_RTL {
        return draw_label(c, x, y, h, size, weight, col, s, box_w)
    }
    if s.n == 0 {
        return 0.0
    }
    var room: f64 = box_w
    let tw: f64 = text_width(c, size, weight, s) + 2.0
    if room <= 0.0 {
        room = tw
    }
    var dw: f64 = tw
    if dw > room {
        dw = room
    }
    return draw_label(c, x + room - dw, y, h, size, weight, col, s, dw)
}

// A SOFT SHADOW WITHOUT A BLUR. fui.effect's drop_shadow_round blurs a layer
// every frame (measured: ~100 ms for a dialog on a 1000 x 666 window with an
// optimising build) -- too slow for a hover to feel immediate. This lays a few
// translucent rounded rectangles, each a little larger than the one before,
// under the panel: the same soft edge for ~1 ms, and corners that stay round
// (the tooltip rule of wave 2: never a rectangle sticking out). `a` scales the
// theme's shadow strength (0..255).
fn soft_shadow(c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, r: f64, spread: f64, dy: f64, a: u32) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let base: u32 = render.shadow_color(c) >> 24
    let steps: usize = 8
    var i: usize = steps
    while i >= 1 {
        let e: f64 = spread * (i as f64) / (steps as f64)
        // each layer is a small part of the full strength; they add up towards the panel
        var al: u32 = (base * a / 255 as u32) / ((steps * 5 / 2) as u32)
        if al < 1 as u32 {
            al = 1 as u32
        }
        painter.round_rect(z, x - e, y - e + dy, w + 2.0 * e, h + 2.0 * e, r + e, (al << 24) | 0 as u32)
        i = i - 1
    }
}

// The keyboard focus ring: the accent as a graphic, 2 pt, 2 pt outside.
fn focus_ring(c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, radius: f64, bg_tok: u32) {
    let g: f64 = ln(c, 2)
    painter.round_ring(render.ctx_painter(c), x - g, y - g, w + 2.0 * g, h + 2.0 * g, radius + g,
        ln(c, 2), accent_gfx(c, bg_tok))
}

// A symbol (nothing for ICON_NONE).
fn sym(c: *mut render.Ctx, id: i64, x: f64, y: f64, size: f64, col: u32) {
    if id >= 0 as i64 {
        icons.icon_stroke(render.ctx_painter(c), id, x, y, size, col, icons.STROKE_DEFAULT)
    }
}

// An unsigned number as decimal into `out`; its length.
fn fmt_uint(v: u64, out: *mut [u8; 24]) -> usize {
    var tmp: [u8; 24] = [0 as u8; 24]
    var n: usize = 0
    var x: u64 = v
    if x == 0 {
        tmp[0] = 48 as u8
        n = 1
    }
    while x > 0 {
        tmp[n] = (48 + (x % 10)) as u8
        x = x / 10
        n = n + 1
    }
    var i: usize = 0
    while i < n {
        (*out)[i] = tmp[n - 1 - i]
        i = i + 1
    }
    return n
}

// The UTF-8 length of the character at p[0].
fn cp_n(p: u64, rest: usize) -> usize {
    let c: u8 = rt.ld8(p, 0)
    var l: usize = 1
    if c >= 240 as u8 {
        l = 4
    } else if c >= 224 as u8 {
        l = 3
    } else if c >= 192 as u8 {
        l = 2
    }
    if l > rest {
        l = rest
    }
    return l
}

// The initials of a name: the first character of the first two words, ASCII
// letters upper-cased ("Fabric API" -> "FA", "sodium" -> "S"). Into `out`
// (8 octets); the length.
fn initials(s: str, out: *mut [u8; 8]) -> usize {
    var n: usize = 0
    var i: usize = 0
    var words: usize = 0
    var at_start: bool = true
    while i < s.n && words < 2 {
        let ch: u8 = rt.ld8(s.p as u64, i)
        if ch == 32 as u8 || ch == 45 as u8 || ch == 95 as u8 || ch == 46 as u8 {
            at_start = true
            i = i + 1
        } else if at_start {
            let l: usize = cp_n(s.p as u64 + (i as u64), s.n - i)
            if n + l <= 8 {
                var k: usize = 0
                while k < l {
                    var b: u8 = rt.ld8(s.p as u64, i + k)
                    if l == 1 && b >= 97 as u8 && b <= 122 as u8 {
                        b = b - 32 as u8
                    }
                    (*out)[n + k] = b
                    k = k + 1
                }
                n = n + l
            }
            words = words + 1
            at_start = false
            i = i + l
        } else {
            i = i + 1
        }
    }
    return n
}

// ====================================================================
// BUTTON
// ====================================================================

const BTN_PRIMARY: u32 = 0
const BTN_SECONDARY: u32 = 1
const BTN_GHOST: u32 = 2
const BTN_DANGER: u32 = 3

fn button_height(c: *mut render.Ctx) -> f64 {
    return ln(c, 36)
}

// The width a button wants: padding, symbol, gap, label.
fn button_width(c: *mut render.Ctx, label: str, icon_id: i64) -> f64 {
    var w: f64 = ln(c, 32) + text_width(c, ln(c, 14), 400, label)
    if icon_id >= 0 as i64 {
        w = w + ln(c, 16) + ln(c, 8)
        if label.n == 0 {
            w = w - ln(c, 8) - ln(c, 16)
        }
    }
    return w
}

// The ground colour of a button in a state (0xAARRGGBB), and what is written on it.
fn button_colors(c: *mut render.Ctx, kind: u32, st: u32, bg: *mut u32, fg: *mut u32) {
    let f: *mut theme.Colors = colors_of(c)
    let m: *mut theme.Theme = theme_of(c)
    var fill: u32 = 0 as u32
    var text: u32 = 0 as u32
    let hover: bool = (st & ST_HOVER) != 0 as u32
    let active: bool = (st & ST_ACTIVE) != 0 as u32
    if (st & ST_DISABLED) != 0 as u32 {
        *bg = tokc(c, style.TOK_BUTTON)
        *fg = tokc(c, style.TOK_TEXT_DISABLED)
        return
    }
    if kind == BTN_PRIMARY || kind == BTN_DANGER {
        var base: u32 = (*f).accent
        if kind == BTN_DANGER {
            base = (*f).err_col
        }
        fill = base
        if active {
            fill = theme.mix(base, 0 as u32, 100)
        } else if hover {
            fill = theme.mix(base, 16777215 as u32, 140)
        }
        text = kitcolor.on_color(m, fill)
        *bg = theme.opaque(fill)
        *fg = theme.opaque(text)
        return
    }
    if kind == BTN_SECONDARY {
        var tk: u32 = style.TOK_BUTTON
        if active {
            tk = style.TOK_BUTTON_ACTIVE
        } else if hover {
            tk = style.TOK_BUTTON_HOVER
        }
        *bg = tokc(c, tk)
        *fg = tokc(c, style.TOK_TEXT)
        return
    }
    // ghost: nothing until the pointer comes
    if active {
        *bg = tokc(c, style.TOK_BUTTON_ACTIVE)
    } else if hover {
        *bg = tokc(c, style.TOK_BUTTON_HOVER)
    } else {
        *bg = 0 as u32
    }
    *fg = tokc(c, style.TOK_TEXT)
}

// A button of the size (w, h) at (x, y).
fn button_draw(c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, label: str,
    icon_id: i64, kind: u32, st: u32) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    var bg: u32 = 0 as u32
    var fg: u32 = 0 as u32
    button_colors(c, kind, st, &bg, &fg)
    let r: f64 = ln(c, 8)
    if bg != 0 as u32 {
        painter.round_rect(z, x, y, w, h, r, bg)
    }
    if kind == BTN_SECONDARY {
        painter.round_ring(z, x, y, w, h, r, ln(c, 1), tokc(c, style.TOK_BORDER))
    }
    // symbol + label, centred as a group
    let size: f64 = ln(c, 14)
    let isz: f64 = ln(c, 16)
    var lw: f64 = text_width(c, size, 400, label)
    var gw: f64 = lw
    let has_icon: bool = icon_id >= 0 as i64
    if has_icon {
        gw = gw + isz
        if label.n > 0 {
            gw = gw + ln(c, 8)
        }
    }
    var cx: f64 = x + (w - gw) / 2.0
    if cx < x + ln(c, 8) {
        cx = x + ln(c, 8)
    }
    var icon_x: f64 = cx
    if has_icon {
        cx = cx + isz
        if label.n > 0 {
            cx = cx + ln(c, 8)
        }
    }
    let room: f64 = x + w - ln(c, 8) - cx
    var lab_w: f64 = room
    if lw + 2.0 < room {
        lab_w = lw + 2.0
    }
    if KIT_RTL {
        // the label first, the symbol after it (to its right)
        var lx: f64 = x + (w - gw) / 2.0
        if lx < x + ln(c, 8) {
            lx = x + ln(c, 8)
        }
        let usedr: f64 = draw_label(c, lx, y, h, size, 400, fg, label, lab_w)
        if has_icon {
            var ig: f64 = 0.0
            if label.n > 0 {
                ig = ln(c, 8)
            }
            sym(c, icon_id, lx + usedr + ig, y + (h - isz) / 2.0, isz, fg)
        }
    } else {
        if has_icon {
            sym(c, icon_id, icon_x, y + (h - isz) / 2.0, isz, fg)
        }
    }
    var used: f64 = 0.0
    if !KIT_RTL {
        used = draw_label(c, cx, y, h, size, 400, fg, label, lab_w)
    }
    if (st & ST_FOCUS) != 0 as u32 {
        var gtok: u32 = style.TOK_BASE
        focus_ring(c, x, y, w, h, r, gtok)
    }
}

// ====================================================================
// AVATAR
// ====================================================================

// A disc of diameter `d` at (x, y): a hue picked by `seed`, the initials of
// `name` (or a Lucide symbol if `icon_id` is given) in the colour that reads.
fn avatar_draw(c: *mut render.Ctx, x: f64, y: f64, d: f64, seed: u32, name: str, icon_id: i64) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let fill: u32 = theme.opaque(kitcolor.avatar_color(seed))
    painter.round_rect(z, x, y, d, d, d / 2.0, fill)
    let fg: u32 = theme.opaque(kitcolor.on_color(theme_of(c), fill))
    if icon_id >= 0 as i64 {
        let s: f64 = d * 0.5
        sym(c, icon_id, x + (d - s) / 2.0, y + (d - s) / 2.0, s, fg)
        return
    }
    var ini: [u8; 8] = [0 as u8; 8]
    let n: usize = initials(name, &ini)
    if n == 0 {
        return
    }
    let size: f64 = d * 0.42
    var r: painter.TextRun = text_run(size, 700)
    let by: f64 = painter.text_baseline_mid(z, y, d, size)
    let tw: f64 = painter.run_width(z, &r, (&ini[0]) as u64, n)
    let x1: f64 = painter.run_draw(z, &r, x + (d - tw) / 2.0, by, tw + 4.0, fg, (&ini[0]) as u64, n, painter.TEXT_L)
}

// ====================================================================
// PROGRESS
// ====================================================================

const PB_NORMAL: u32 = 0
const PB_SUCCESS: u32 = 1
const PB_ERROR: u32 = 2

fn progress_height(c: *mut render.Ctx, with_text: bool) -> f64 {
    if with_text {
        return ln(c, 24)
    }
    return ln(c, 8)
}

// A progress bar at (x, y, w, h). `permille` 0..1000, or < 0 for "I do not
// know" (a sweep driven by `phase_ms`). `label` is the text inside; an empty
// label shows the percentage ("42 %") unless the bar is too thin for text
// (h < 16 pt) or indeterminate.
//
// THE LABEL READS ON BOTH GROUNDS: it is painted twice -- in the text colour
// clipped to the track, in the colour that reads on the fill clipped to the
// filled part -- so the letters that straddle the edge change colour in the
// middle, the way the bar of a browser's download list does.
fn progress_draw(c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, permille: i64,
    label: str, phase_ms: i64, kind: u32) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let cv: *mut canvas.Canvas = painter.painter_canvas(z)
    let m: *mut theme.Theme = theme_of(c)
    let f: *mut theme.Colors = colors_of(c)
    let r: f64 = h / 2.0
    let track: u32 = tokc(c, style.TOK_BUTTON)
    painter.round_rect(z, x, y, w, h, r, track)
    var fill_base: u32 = (*f).accent
    if kind == PB_SUCCESS {
        fill_base = (*f).success
    } else if kind == PB_ERROR {
        fill_base = (*f).err_col
    }
    // the fill needs 3:1 against the track (a graphic), whatever the accent is
    let fill: u32 = theme.opaque(kitcolor.tone(m, fill_base, track & 16777215 as u32, kitcolor.MIN_UI_CONTRAST))
    var fx0: f64 = x
    var fx1: f64 = x
    if permille >= 0 as i64 {
        var pm: i64 = permille
        if pm > 1000 as i64 {
            pm = 1000
        }
        fx1 = x + w * (pm as f64) / 1000.0
    } else {
        // a sweep: a segment 35 % of the bar wide runs from left to right
        let seg: f64 = w * 0.35
        let period: i64 = 1400
        let t: f64 = ((phase_ms % period) as f64) / (period as f64)
        fx0 = x - seg + (w + seg) * t
        fx1 = fx0 + seg
        if fx0 < x {
            fx0 = x
        }
        if fx1 > x + w {
            fx1 = x + w
        }
    }
    if KIT_RTL {
        // the fill grows from the right
        let a: f64 = x + w - (fx1 - x)
        let b: f64 = x + w - (fx0 - x)
        fx0 = a
        fx1 = b
    }
    if fx1 > fx0 {
        // the fill, with the track's rounded ends
        if canvas.clip_push_rect(cv, fx0, y, fx1, y + h) {
            painter.round_rect(z, x, y, w, h, r, fill)
            canvas.clip_pop(cv)
        }
    }
    painter.round_ring(z, x, y, w, h, r, ln(c, 1), tokc(c, style.TOK_BORDER))
    // the text
    var buf: [u8; 24] = [0 as u8; 24]
    var tp: u64 = label.p as u64
    var tn: usize = label.n
    if tn == 0 && permille >= 0 as i64 && h >= ln(c, 16) {
        var pc: i64 = permille / 10
        if pc > 100 as i64 {
            pc = 100
        }
        let k: usize = fmt_uint(pc as u64, &buf)
        buf[k] = 32 as u8
        buf[k + 1] = 37 as u8
        tp = (&buf[0]) as u64
        tn = k + 2
    }
    if tn == 0 || h < ln(c, 16) {
        return
    }
    let size: f64 = ln(c, 12)
    var run: painter.TextRun = text_run(size, 700)
    let tw: f64 = painter.run_width(z, &run, tp, tn)
    var room: f64 = w - ln(c, 16)
    var x0: f64 = x + (w - tw) / 2.0
    if tw > room {
        x0 = x + ln(c, 8)
    }
    let by: f64 = painter.text_baseline_mid(z, y, h, size)
    // on the track
    var track_x0: f64 = fx1
    var track_x1: f64 = x + w
    if KIT_RTL {
        track_x0 = x
        track_x1 = fx0
    }
    if canvas.clip_push_rect(cv, track_x0, y, track_x1, y + h) {
        let a: f64 = painter.run_draw(z, &run, x0, by, room + 4.0, tokc(c, style.TOK_TEXT), tp, tn, painter.TEXT_L)
        canvas.clip_pop(cv)
    }
    // on the fill
    if fx1 > fx0 && canvas.clip_push_rect(cv, fx0, y, fx1, y + h) {
        let b: f64 = painter.run_draw(z, &run, x0, by, room + 4.0,
            theme.opaque(kitcolor.on_color(m, fill)), tp, tn, painter.TEXT_L)
        canvas.clip_pop(cv)
    }
}

// ====================================================================
// SEARCH FIELD
// ====================================================================

const SEARCH_CAP: usize = 256
const SEARCH_HIT_NONE: u32 = 0
const SEARCH_HIT_FIELD: u32 = 1
const SEARCH_HIT_CLEAR: u32 = 2

struct Search {
    ed: editor.Editor,
    buf: u64,
    focus: bool,
    ok: bool,
}

fn search_new() -> Search {
    var s: Search = Search { ed: editor.editor_new(), buf: 0, focus: false, ok: false }
    s.buf = rt.heap_alloc(SEARCH_CAP)
    if s.buf != 0 {
        s.ok = editor.editor_init(&s.ed, s.buf, SEARCH_CAP)
    }
    return s
}

fn search_free(s: *mut Search) {
    editor.editor_free(&(*s).ed)
    if (*s).buf != 0 {
        rt.heap_free((*s).buf, SEARCH_CAP)
        (*s).buf = 0
    }
    (*s).ok = false
}

fn search_text_ptr(s: *mut Search) -> u64 {
    return textbuf.tb_ptr(editor.editor_buf(&(*s).ed))
}

fn search_text_len(s: *mut Search) -> usize {
    return textbuf.tb_len(editor.editor_buf(&(*s).ed))
}

fn search_set_text(s: *mut Search, t: str) {
    editor.editor_set_text(&(*s).ed, t.p as u64, t.n)
}

fn search_clear(s: *mut Search) {
    editor.editor_clear(&(*s).ed)
}

fn search_focus(s: *mut Search, on: bool) {
    (*s).focus = on
    if on {
        editor.editor_caret_wake(&(*s).ed)
    }
}

fn search_has_focus(s: *mut Search) -> bool {
    return (*s).focus
}

// The caret blinks: call with the time; true when the picture changed.
fn search_blink(s: *mut Search, now_us: u64) -> bool {
    if !(*s).focus {
        return false
    }
    return editor.editor_caret_tick(&(*s).ed, now_us)
}

// The text-field widget the editor paints into: the whole field rectangle,
// the padding leaves room for the symbol on the left and the clear button on
// the right.
fn search_widget(c: *mut render.Ctx, s: *mut Search, x: f64, y: f64, w: f64, h: f64) -> widget.Widget {
    var e: widget.Widget = widget.widget_new(widget.KIND_TEXTBOX)
    widget.w_place(&e, x, y, w, h)
    var st: style.Style = style.style_new()
    // 12 + 16 + 8 on the left; the same on the right (clear button 24 + 12)
    st = style.style_set_pad(st, 36, 8)
    st = style.style_set_radius(st, 8)
    if KIT_RTL {
        st = style.style_set_direction(st, style.DIR_RTL)
    }
    widget.w_set_style(&e, st)
    widget.w_set_focus(&e, (*s).focus)
    return e
}

fn search_clear_rect(c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, cx: *mut f64, cy: *mut f64, cd: *mut f64) {
    let d: f64 = ln(c, 24)
    *cd = d
    *cx = x + w - ln(c, 8) - d
    if KIT_RTL {
        *cx = x + ln(c, 8)
    }
    *cy = y + (h - d) / 2.0
}

// The field at (x, y, w, h): a magnifier, the text (or the hint while empty
// and not focused), and the clear button while there is text. `hover_clear`
// is the program's knowledge of the pointer.
fn search_draw(c: *mut render.Ctx, s: *mut Search, x: f64, y: f64, w: f64, h: f64,
    hint: str, hover_clear: bool) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    var e: widget.Widget = search_widget(c, s, x, y, w, h)
    render.draw_textfield(c, &e, &(*s).ed, (*s).focus && editor.editor_caret_on(&(*s).ed))
    let empty: bool = search_text_len(s) == 0
    let isz: f64 = ln(c, 16)
    sym(c, lucide.SEARCH, rx(x + ln(c, 12), isz, x, w), y + (h - isz) / 2.0, isz, tokc(c, style.TOK_TEXT_MUTED))
    if empty && hint.n > 0 {
        // the hint: the theme's placeholder colour (what fui.app uses for a hint)
        label_in(c, x + ln(c, 36), y, h, ln(c, 14), 400, tokc(c, style.TOK_TEXT_DISABLED), hint,
            w - ln(c, 72))
    }
    if !empty {
        var cx: f64 = 0.0
        var cy: f64 = 0.0
        var cd: f64 = 0.0
        search_clear_rect(c, x, y, w, h, &cx, &cy, &cd)
        if hover_clear {
            painter.round_rect(z, cx, cy, cd, cd, cd / 2.0, tokc(c, style.TOK_BUTTON_HOVER))
        }
        sym(c, lucide.X, cx + (cd - isz) / 2.0, cy + (cd - isz) / 2.0, isz, tokc(c, style.TOK_TEXT))
    }
}

// A key (editor.KEY_*): Escape clears a non-empty field. The editor's answer
// (editor.RES_*); RES_CHANGED when the text differs.
fn search_key(s: *mut Search, key: u32, mods: u32) -> u32 {
    if key == editor.KEY_ESC && search_text_len(s) > 0 {
        editor.editor_clear(&(*s).ed)
        return editor.RES_CHANGED
    }
    return editor.editor_key(&(*s).ed, key, mods)
}

fn search_char(s: *mut Search, cp: u32, mods: u32) -> u32 {
    return editor.editor_char(&(*s).ed, cp, mods)
}

// A press at (px, py): the clear button empties the field; a press in the
// field gives it the focus and puts the caret there. SEARCH_HIT_*.
fn search_press(c: *mut render.Ctx, s: *mut Search, x: f64, y: f64, w: f64, h: f64,
    px: f64, py: f64, now_us: u64) -> u32 {
    if px < x || py < y || px >= x + w || py >= y + h {
        return SEARCH_HIT_NONE
    }
    if search_text_len(s) > 0 {
        var cx: f64 = 0.0
        var cy: f64 = 0.0
        var cd: f64 = 0.0
        search_clear_rect(c, x, y, w, h, &cx, &cy, &cd)
        if px >= cx && px < cx + cd && py >= cy && py < cy + cd {
            editor.editor_clear(&(*s).ed)
            return SEARCH_HIT_CLEAR
        }
    }
    (*s).focus = true
    var e: widget.Widget = search_widget(c, s, x, y, w, h)
    var fm: render.FieldMeas = render.field_meas_new(c, &e)
    let rr: u32 = editor.editor_mouse_down(&(*s).ed, px - render.field_text_x0(c, &e), now_us,
        render.field_meas, (&fm) as u64, false)
    return SEARCH_HIT_FIELD
}

// ====================================================================
// TAB BAR
// ====================================================================

struct Tab {
    icon: i64,
    label: str,
    badge: usize,
}

fn tabbar_height(c: *mut render.Ctx) -> f64 {
    return ln(c, 44)
}

fn tab_natural_w(c: *mut render.Ctx, t: *mut Tab) -> f64 {
    var w: f64 = ln(c, 32) + text_width(c, ln(c, 14), 400, (*t).label)
    if (*t).icon >= 0 as i64 {
        w = w + ln(c, 16) + ln(c, 8)
    }
    if (*t).badge > 0 {
        w = w + ln(c, 8) + badge_width(c, (*t).badge)
    }
    return w
}

fn badge_width(c: *mut render.Ctx, n: usize) -> f64 {
    var buf: [u8; 24] = [0 as u8; 24]
    let k: usize = fmt_uint(n as u64, &buf)
    var r: painter.TextRun = text_run(ln(c, 12), 700)
    let w: f64 = painter.run_width(render.ctx_painter(c), &r, (&buf[0]) as u64, k) + ln(c, 12)
    if w < ln(c, 20) {
        return ln(c, 20)
    }
    return w
}

// A count pill: the accent with the colour that reads on it.
fn draw_badge(c: *mut render.Ctx, x: f64, y: f64, h: f64, n: usize, on_active: bool) -> f64 {
    var buf: [u8; 24] = [0 as u8; 24]
    var cnt: usize = n
    var k: usize = 0
    if cnt > 99 {
        buf[0] = 57 as u8
        buf[1] = 57 as u8
        buf[2] = 43 as u8
        k = 3
    } else {
        k = fmt_uint(cnt as u64, &buf)
    }
    let z: *mut painter.Painter = render.ctx_painter(c)
    var r: painter.TextRun = text_run(ln(c, 12), 700)
    let tw: f64 = painter.run_width(z, &r, (&buf[0]) as u64, k)
    var w: f64 = tw + ln(c, 12)
    if w < ln(c, 20) {
        w = ln(c, 20)
    }
    let bh: f64 = ln(c, 20)
    let by0: f64 = y + (h - bh) / 2.0
    let fill: u32 = tokc(c, style.TOK_ACCENT)
    painter.round_rect(z, x, by0, w, bh, bh / 2.0, fill)
    let by: f64 = painter.text_baseline_mid(z, by0, bh, ln(c, 12))
    let x1: f64 = painter.run_draw(z, &r, x + (w - tw) / 2.0, by, tw + 4.0, tokc(c, style.TOK_TEXT_ON_ACCENT),
        (&buf[0]) as u64, k, painter.TEXT_L)
    return w
}

// The rectangle of tab `i` in a bar of width `w` starting at x; tabs are as
// wide as they want to be, shrunk equally when they do not all fit.
fn tab_rect(c: *mut render.Ctx, tabs: *mut Tab, n: usize, i: usize, x: f64, w: f64,
    tx: *mut f64, tw: *mut f64) {
    var total: f64 = 0.0
    var k: usize = 0
    while k < n {
        total = total + tab_natural_w(c, vec_tab(tabs, k))
        k = k + 1
    }
    var scale: f64 = 1.0
    if total > w {
        scale = w / total
    }
    var px: f64 = x
    k = 0
    while k < i {
        px = px + tab_natural_w(c, vec_tab(tabs, k)) * scale
        k = k + 1
    }
    let ww: f64 = tab_natural_w(c, vec_tab(tabs, i)) * scale
    *tx = rx(px, ww, x, w)
    *tw = ww
}

// The tab `i` of an array of tabs (for lib/fui/kita11y.fi and other readers of the same array).
fn tab_at(tabs: *mut Tab, i: usize) -> *mut Tab {
    return vec_tab(tabs, i)
}

fn vec_tab(tabs: *mut Tab, i: usize) -> *mut Tab {
    return (tabs as usize + i * tab_size()) as *mut Tab
}

fn tab_size() -> usize {
    var probe: [Tab; 2] = [Tab { icon: ICON_NONE, label: "", badge: 0 }, Tab { icon: ICON_NONE, label: "", badge: 0 }]
    return ((&probe[1]) as usize) - ((&probe[0]) as usize)
}

// Draw the bar: tabs from the left, the active one with the accent underline,
// a separator under all of it.
fn tabbar_draw(c: *mut render.Ctx, tabs: *mut Tab, n: usize, sel: usize, hover: usize,
    focus: bool, x: f64, y: f64, w: f64) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let h: f64 = tabbar_height(c)
    painter.surface(z, x, y + h - ln(c, 1), w, ln(c, 1), tokc(c, style.TOK_SEPARATOR))
    var i: usize = 0
    while i < n {
        var tx: f64 = 0.0
        var tw: f64 = 0.0
        tab_rect(c, tabs, n, i, x, w, &tx, &tw)
        let t: *mut Tab = vec_tab(tabs, i)
        let active: bool = i == sel
        if i == hover && !active {
            painter.round_rect(z, tx + ln(c, 4), y + ln(c, 4), tw - ln(c, 8), h - ln(c, 8), ln(c, 8),
                tokc(c, style.TOK_BUTTON_HOVER))
        }
        var fg: u32 = tokc(c, style.TOK_TEXT_MUTED)
        if i == hover && !active {
            fg = tokc(c, style.TOK_TEXT)
        }
        var icol: u32 = fg
        if active {
            fg = tokc(c, style.TOK_TEXT)
            icol = accent_on(c, style.TOK_BASE)
        }
        var cx: f64 = tx + ln(c, 16)
        let isz: f64 = ln(c, 16)
        var weight: usize = 400
        if active {
            weight = 700
        }
        if KIT_RTL {
            // from the right: the symbol, the label (right-aligned), the badge on the left of it
            var rr: f64 = tx + tw - ln(c, 16)
            if (*t).icon >= 0 as i64 {
                sym(c, (*t).icon, rr - isz, y + (h - isz) / 2.0, isz, icol)
                rr = rr - isz - ln(c, 8)
            }
            let roomr: f64 = rr - (tx + ln(c, 16))
            let usedr: f64 = label_in(c, tx + ln(c, 16), y, h, ln(c, 14), weight, fg, (*t).label, roomr)
            if (*t).badge > 0 {
                let bwr: f64 = badge_width(c, (*t).badge)
                let bxr: f64 = rr - usedr - ln(c, 8) - bwr
                if bxr >= tx {
                    let bw: f64 = draw_badge(c, bxr, y, h, (*t).badge, active)
                }
            }
        } else {
            if (*t).icon >= 0 as i64 {
                sym(c, (*t).icon, cx, y + (h - isz) / 2.0, isz, icol)
                cx = cx + isz + ln(c, 8)
            }
            let room: f64 = tx + tw - ln(c, 16) - cx
            let used: f64 = draw_label(c, cx, y, h, ln(c, 14), weight, fg, (*t).label, room)
            if (*t).badge > 0 {
                let bx: f64 = cx + used + ln(c, 8)
                if bx + ln(c, 20) <= tx + tw {
                    let bw: f64 = draw_badge(c, bx, y, h, (*t).badge, active)
                }
            }
        }
        if active {
            painter.surface(z, tx + ln(c, 8), y + h - ln(c, 2), tw - ln(c, 16), ln(c, 2),
                accent_gfx(c, style.TOK_BASE))
            if focus {
                focus_ring(c, tx + ln(c, 4), y + ln(c, 4), tw - ln(c, 8), h - ln(c, 8), ln(c, 8), style.TOK_BASE)
            }
        }
        i = i + 1
    }
}

// Which tab is at (px, py); NONE if none.
fn tabbar_hit(c: *mut render.Ctx, tabs: *mut Tab, n: usize, x: f64, y: f64, w: f64,
    px: f64, py: f64) -> usize {
    if py < y || py >= y + tabbar_height(c) || px < x || px >= x + w {
        return NONE
    }
    var i: usize = 0
    while i < n {
        var tx: f64 = 0.0
        var tw: f64 = 0.0
        tab_rect(c, tabs, n, i, x, w, &tx, &tw)
        if px >= tx && px < tx + tw {
            return i
        }
        i = i + 1
    }
    return NONE
}

// Left / Right / Home / End move the selection (wrapping at the ends is NOT
// done: a tab bar is a line, not a ring). The new selection.
fn tabbar_key(n: usize, sel0: usize, key0: u32) -> usize {
    var sel: usize = sel0
    var key: u32 = key0
    if KIT_RTL {
        // the tabs run right to left: Left goes on, Right goes back
        if key == editor.KEY_LEFT {
            key = editor.KEY_RIGHT
        } else if key == editor.KEY_RIGHT {
            key = editor.KEY_LEFT
        }
    }
    if n == 0 {
        return sel
    }
    if key == editor.KEY_LEFT && sel > 0 {
        return sel - 1
    }
    if key == editor.KEY_RIGHT && sel + 1 < n {
        return sel + 1
    }
    if key == editor.KEY_HOME {
        return 0
    }
    if key == editor.KEY_END {
        return n - 1
    }
    return sel
}

// ====================================================================
// SIDEBAR NAVIGATION
// ====================================================================

struct NavItem {
    icon: i64,
    label: str,
    badge: usize,
    // a section title, not an item
    header: bool,
}

fn nav_item_size() -> usize {
    var probe: [NavItem; 2] = [NavItem { icon: ICON_NONE, label: "", badge: 0, header: false },
        NavItem { icon: ICON_NONE, label: "", badge: 0, header: false }]
    return ((&probe[1]) as usize) - ((&probe[0]) as usize)
}

fn nav_at(items: *mut NavItem, i: usize) -> *mut NavItem {
    return (items as usize + i * nav_item_size()) as *mut NavItem
}

// 240 wide, or 64 collapsed to the symbols.
fn nav_width(c: *mut render.Ctx, collapsed: bool) -> f64 {
    if collapsed {
        return ln(c, 64)
    }
    return ln(c, 240)
}

fn nav_item_h(c: *mut render.Ctx, it: *mut NavItem) -> f64 {
    if (*it).header {
        return ln(c, 32)
    }
    return ln(c, 40)
}

// The y offset (from the top of the list) and height of item `i`.
fn nav_item_y(c: *mut render.Ctx, items: *mut NavItem, i: usize) -> f64 {
    var y: f64 = ln(c, 8)
    var k: usize = 0
    while k < i {
        y = y + nav_item_h(c, nav_at(items, k)) + ln(c, 4)
        k = k + 1
    }
    return y
}

// The column: a ground of the surface colour, a separator on its right edge,
// the items. `active` is the item shown as current (NONE = none), `hover` the
// one under the pointer, `focus` draws the keyboard ring on `active`.
fn nav_draw(c: *mut render.Ctx, items: *mut NavItem, n: usize, active: usize, hover: usize,
    focus: bool, x: f64, y: f64, w: f64, h: f64, collapsed: bool) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    painter.surface(z, x, y, w, h, tokc(c, style.TOK_SURFACE))
    // the separator is on the edge towards the page: right in the default direction, left in RTL
    painter.surface(z, rx(x + w - ln(c, 1), ln(c, 1), x, w), y, ln(c, 1), h, tokc(c, style.TOK_SEPARATOR))
    var i: usize = 0
    while i < n {
        let it: *mut NavItem = nav_at(items, i)
        let iy: f64 = y + nav_item_y(c, items, i)
        let ih: f64 = nav_item_h(c, it)
        if (*it).header {
            if !collapsed {
                label_in(c, x + ln(c, 20), iy, ih, ln(c, 12), 700, tokc(c, style.TOK_TEXT_MUTED), (*it).label,
                    w - ln(c, 40))
            } else {
                painter.surface(z, x + ln(c, 20), iy + ih / 2.0, w - ln(c, 40) - ln(c, 1), ln(c, 1),
                    tokc(c, style.TOK_SEPARATOR))
            }
            i = i + 1
            continue
        }
        let is_active: bool = i == active
        // the row rectangle: inside the column, beside the separator
        var rx0: f64 = x + ln(c, 8)
        if KIT_RTL {
            rx0 = x + ln(c, 8) + ln(c, 1)
        }
        let rw: f64 = w - ln(c, 16) - ln(c, 1)
        var fg: u32 = tokc(c, style.TOK_TEXT_MUTED)
        var icol: u32 = fg
        var gnd: u32 = style.TOK_SURFACE
        if is_active {
            painter.round_rect(z, rx0, iy, rw, ih, ln(c, 8), tokc(c, style.TOK_SELECTION))
            gnd = style.TOK_SELECTION
            fg = tokc(c, style.TOK_SELECTION_TEXT)
            icol = fg
            // the mark on the left edge
            painter.round_rect(z, rx(x, ln(c, 4), x, w), iy + ln(c, 8), ln(c, 4), ih - ln(c, 16), ln(c, 2), accent_gfx(c, style.TOK_SURFACE))
        } else if i == hover {
            painter.round_rect(z, rx0, iy, rw, ih, ln(c, 8), tokc(c, style.TOK_BUTTON_HOVER))
            gnd = style.TOK_BUTTON_HOVER
            fg = tokc(c, style.TOK_TEXT)
            icol = fg
        }
        let isz: f64 = ln(c, 20)
        if collapsed {
            if (*it).icon >= 0 as i64 {
                sym(c, (*it).icon, rx0 - ln(c, 8) + (w - ln(c, 1) - isz) / 2.0, iy + (ih - isz) / 2.0, isz, icol)
            } else {
                // icon-free item in a collapsed column: its first letter
                var ini: [u8; 8] = [0 as u8; 8]
                let k: usize = initials((*it).label, &ini)
                if k > 0 {
                    var rr: painter.TextRun = text_run(ln(c, 14), 700)
                    let tw: f64 = painter.run_width(z, &rr, (&ini[0]) as u64, k)
                    let by: f64 = painter.text_baseline_mid(z, iy, ih, ln(c, 14))
                    let x1: f64 = painter.run_draw(z, &rr, rx0 - ln(c, 8) + (w - ln(c, 1) - tw) / 2.0, by, tw + 4.0, fg,
                        (&ini[0]) as u64, k, painter.TEXT_L)
                }
            }
            if (*it).badge > 0 {
                painter.round_rect(z, rx(x + w - ln(c, 20), ln(c, 8), x, w), iy + ln(c, 6), ln(c, 8), ln(c, 8), ln(c, 4),
                    tokc(c, style.TOK_ACCENT))
            }
        } else {
            var wgt: usize = 400
            if is_active {
                wgt = 700
            }
            if KIT_RTL {
                // from the right: the symbol, the label (right-aligned), the badge at the left end
                var rr: f64 = rx0 + rw - ln(c, 12)
                if (*it).icon >= 0 as i64 {
                    sym(c, (*it).icon, rr - isz, iy + (ih - isz) / 2.0, isz, icol)
                    rr = rr - isz - ln(c, 12)
                }
                var left: f64 = rx0 + ln(c, 12)
                if (*it).badge > 0 {
                    let bwr: f64 = badge_width(c, (*it).badge)
                    let bw2: f64 = draw_badge(c, left, iy, ih, (*it).badge, is_active)
                    left = left + bwr + ln(c, 8)
                }
                label_in(c, left, iy, ih, ln(c, 14), wgt, fg, (*it).label, rr - left)
            } else {
                var cx: f64 = rx0 + ln(c, 12)
                if (*it).icon >= 0 as i64 {
                    sym(c, (*it).icon, cx, iy + (ih - isz) / 2.0, isz, icol)
                    cx = cx + isz + ln(c, 12)
                }
                var right: f64 = rx0 + rw - ln(c, 12)
                if (*it).badge > 0 {
                    let bw: f64 = badge_width(c, (*it).badge)
                    let bx: f64 = right - bw
                    let bw2: f64 = draw_badge(c, bx, iy, ih, (*it).badge, is_active)
                    right = bx - ln(c, 8)
                }
                draw_label(c, cx, iy, ih, ln(c, 14), wgt, fg, (*it).label, right - cx)
            }
        }
        if is_active && focus {
            focus_ring(c, rx0, iy, rw, ih, ln(c, 8), gnd)
        }
        i = i + 1
    }
}

// Which item is at (px, py) of a column drawn at (x, y, w): its index, NONE
// for a header or empty space.
fn nav_hit(c: *mut render.Ctx, items: *mut NavItem, n: usize, x: f64, y: f64, w: f64,
    collapsed: bool, px: f64, py: f64) -> usize {
    if px < x || px >= x + w {
        return NONE
    }
    var i: usize = 0
    while i < n {
        let it: *mut NavItem = nav_at(items, i)
        let iy: f64 = y + nav_item_y(c, items, i)
        let ih: f64 = nav_item_h(c, it)
        if py >= iy && py < iy + ih {
            if (*it).header {
                return NONE
            }
            return i
        }
        i = i + 1
    }
    return NONE
}

// Up / Down move to the previous / next item that is no header; Home / End to
// the first / last. The new active index (the old one if nothing moved).
fn nav_key(items: *mut NavItem, n: usize, active: usize, key: u32) -> usize {
    if n == 0 {
        return active
    }
    var cur: usize = active
    if key == editor.KEY_DOWN {
        var k: usize = 0
        if cur != NONE {
            k = cur + 1
        }
        while k < n {
            if !(*nav_at(items, k)).header {
                return k
            }
            k = k + 1
        }
        return active
    }
    if key == editor.KEY_UP {
        var k: usize = n
        if cur != NONE {
            k = cur
        }
        while k > 0 {
            k = k - 1
            if !(*nav_at(items, k)).header {
                return k
            }
        }
        return active
    }
    if key == editor.KEY_HOME {
        var k: usize = 0
        while k < n {
            if !(*nav_at(items, k)).header {
                return k
            }
            k = k + 1
        }
    }
    if key == editor.KEY_END {
        var k: usize = n
        while k > 0 {
            k = k - 1
            if !(*nav_at(items, k)).header {
                return k
            }
        }
    }
    return active
}

// ====================================================================
// TILE GRID
// ====================================================================

// One card. A picture is optional: pixels are RGBA bytes (see
// lib/fui/uiimage.fi), the caller keeps them alive. Without a picture the
// card shows an avatar (hue from `seed`, initials of the title) or, with
// `icon` set, a symbol.
struct Tile {
    title: str,
    sub: str,
    badge: str,
    icon: i64,
    seed: u32,
    px: u64,
    w: usize,
    h: usize,
    stride: usize,
}

struct TileGrid {
    vp: viewport.Viewport,
    cols: usize,
    tw: f64,
    th: f64,
    img_h: f64,
    gap: f64,
    pad: f64,
    hover: usize,
    sel: usize,
    count: usize,
}

fn grid_new() -> TileGrid {
    return TileGrid { vp: viewport.viewport_new(0.0, 0.0, 100.0, 100.0, 100.0, 100.0), cols: 1,
        tw: 0.0, th: 0.0, img_h: 0.0, gap: 0.0, pad: 0.0, hover: NONE, sel: NONE, count: 0 }
}

fn grid_set_rect(g: *mut TileGrid, x: f64, y: f64, w: f64, h: f64) {
    viewport.viewport_set_rect(&(*g).vp, x, y, w, h)
}

fn grid_hover(g: *mut TileGrid) -> usize { return (*g).hover }
fn grid_selected(g: *mut TileGrid) -> usize { return (*g).sel }
fn grid_select(g: *mut TileGrid, i: usize) { (*g).sel = i }
fn grid_content_height(g: *mut TileGrid) -> f64 { return viewport.viewport_content_h(&(*g).vp) }

fn grid_tick(g: *mut TileGrid, now_ms: i64) -> bool {
    return viewport.viewport_tick(&(*g).vp, now_ms)
}

// Work out the columns and sizes for `n` tiles in the grid's rectangle and
// tell the viewport how tall the content is. Call after set_rect / when the
// tile count or the scale changes (grid_paint does it by itself when needed).
fn grid_layout(c: *mut render.Ctx, g: *mut TileGrid, n: usize) {
    (*g).count = n
    (*g).gap = ln(c, 16)
    (*g).pad = ln(c, 16)
    var w: f64 = viewport.viewport_w(&(*g).vp)
    // first without a scrollbar; if the rows overflow, once more with its width
    var pass: usize = 0
    while pass < 2 {
        let avail: f64 = w - 2.0 * (*g).pad
        let minw: f64 = ln(c, 176)
        var cols: usize = 1
        if avail > minw {
            cols = ((avail + (*g).gap) / (minw + (*g).gap)) as usize
        }
        if cols < 1 {
            cols = 1
        }
        (*g).cols = cols
        (*g).tw = (avail - ((cols - 1) as f64) * (*g).gap) / (cols as f64)
        (*g).img_h = (*g).tw * 9.0 / 16.0
        (*g).th = (*g).img_h + ln(c, 64)
        let rows: usize = (n + cols - 1) / cols
        var ch: f64 = 2.0 * (*g).pad
        if rows > 0 {
            ch = ch + (rows as f64) * (*g).th + ((rows - 1) as f64) * (*g).gap
        }
        viewport.viewport_set_content(&(*g).vp, w, ch)
        let iw: f64 = viewport.viewport_inner_w(&(*g).vp)
        if iw == w || pass == 1 {
            break
        }
        w = iw
        pass = pass + 1
    }
}

// The rectangle of tile `i` in CONTENT coordinates.
fn grid_tile_rect(g: *mut TileGrid, i: usize, x: *mut f64, y: *mut f64, w: *mut f64, h: *mut f64) {
    let col: usize = i % (*g).cols
    let row: usize = i / (*g).cols
    var colm: usize = col
    if KIT_RTL {
        colm = (*g).cols - 1 - col
    }
    *x = (*g).pad + (colm as f64) * ((*g).tw + (*g).gap)
    *y = (*g).pad + (row as f64) * ((*g).th + (*g).gap)
    *w = (*g).tw
    *h = (*g).th
}

fn grid_paint_tile(c: *mut render.Ctx, g: *mut TileGrid, t: *mut Tile, i: usize, x: f64, y: f64) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let w: f64 = (*g).tw
    let h: f64 = (*g).th
    let r: f64 = ln(c, 12)
    let hov: bool = i == (*g).hover
    let selected: bool = i == (*g).sel
    // the hover is the accent ring only: the muted subtitle must keep its 4.5:1
    // on the ground it was checked against (TOK_SURFACE)
    painter.round_rect(z, x, y, w, h, r, tokc(c, style.TOK_SURFACE))
    painter.round_ring(z, x, y, w, h, r, ln(c, 1), tokc(c, style.TOK_BORDER))
    // the picture area
    let ih: f64 = (*g).img_h
    var cv: *mut canvas.Canvas = painter.painter_canvas(z)
    if canvas.clip_push_rect(cv, x, y, x + w, y + ih) {
        painter.round_rect(z, x, y, w, ih + r, r, tokc(c, style.TOK_BUTTON))
        if (*t).px != 0 && (*t).w > 0 && (*t).h > 0 {
            var im: uiimage.Image = uiimage.image_wrap((*t).px, (*t).w, (*t).h, (*t).stride)
            uiimage.image_draw(z, &im, x, y, w, ih, uiimage.FIT_CONTAIN, 0)
        } else {
            let d: f64 = ih * 0.5
            avatar_draw(c, x + (w - d) / 2.0, y + (ih - d) / 2.0, d, (*t).seed, (*t).title, (*t).icon)
        }
        canvas.clip_pop(cv)
    }
    // the badge on the picture ("Mod", "Pack")
    if (*t).badge.n > 0 {
        let bsz: f64 = ln(c, 12)
        let bw: f64 = text_width(c, bsz, 700, (*t).badge) + ln(c, 16)
        let bh: f64 = ln(c, 20)
        let bxx: f64 = rx(x + ln(c, 8), bw, x, w)
        painter.round_rect(z, bxx, y + ln(c, 8), bw, bh, bh / 2.0, tokc(c, style.TOK_BASE))
        draw_label(c, bxx + ln(c, 8), y + ln(c, 8), bh, bsz, 700, tokc(c, style.TOK_TEXT), (*t).badge, bw - ln(c, 16))
    }
    // the lines
    let ty: f64 = y + ih + ln(c, 12)
    label_in(c, x + ln(c, 12), ty, ln(c, 20), ln(c, 14), 700, tokc(c, style.TOK_TEXT), (*t).title, w - ln(c, 24))
    label_in(c, x + ln(c, 12), ty + ln(c, 20), ln(c, 16), ln(c, 12), 400, tokc(c, style.TOK_TEXT_MUTED),
        (*t).sub, w - ln(c, 24))
    if hov || selected {
        painter.round_ring(z, x, y, w, h, r, ln(c, 2), accent_gfx(c, style.TOK_SURFACE))
    }
    if selected {
        let d: f64 = ln(c, 24)
        let bx: f64 = rx(x + w - d - ln(c, 8), d, x, w)
        let by: f64 = y + ln(c, 8)
        painter.round_rect(z, bx, by, d, d, d / 2.0, tokc(c, style.TOK_ACCENT))
        icon.check(z, bx + d * 0.2, by + d * 0.2, d * 0.6, ln(c, 2), tokc(c, style.TOK_TEXT_ON_ACCENT))
    }
}

fn tile_at(tiles: *mut Tile, i: usize) -> *mut Tile {
    return (tiles as usize + i * tile_size()) as *mut Tile
}

fn tile_size() -> usize {
    var probe: [Tile; 2] = [Tile { title: "", sub: "", badge: "", icon: ICON_NONE, seed: 0 as u32, px: 0, w: 0, h: 0, stride: 0 },
        Tile { title: "", sub: "", badge: "", icon: ICON_NONE, seed: 0 as u32, px: 0, w: 0, h: 0, stride: 0 }]
    return ((&probe[1]) as usize) - ((&probe[0]) as usize)
}

// Paint the visible tiles (the rest is not touched) and the scrollbar.
fn grid_paint(c: *mut render.Ctx, g: *mut TileGrid, tiles: *mut Tile, n: usize) {
    if n != (*g).count || (*g).tw == 0.0 {
        grid_layout(c, g, n)
    }
    let ox: f64 = viewport.viewport_content_x(&(*g).vp)
    let oy: f64 = viewport.viewport_content_y(&(*g).vp)
    let top: f64 = viewport.viewport_off_y(&(*g).vp)
    let bot: f64 = top + viewport.viewport_inner_h(&(*g).vp)
    if viewport.viewport_begin(c, &(*g).vp) {
        var i: usize = 0
        while i < n {
            var tx: f64 = 0.0
            var ty: f64 = 0.0
            var tw: f64 = 0.0
            var th: f64 = 0.0
            grid_tile_rect(g, i, &tx, &ty, &tw, &th)
            if ty + th >= top && ty <= bot {
                grid_paint_tile(c, g, tile_at(tiles, i), i, ox + tx, oy + ty)
            }
            i = i + 1
        }
        viewport.viewport_end(c, &(*g).vp)
    }
    viewport.viewport_draw_bars(c, &(*g).vp)
}

// Which tile is at a window point; NONE if none (also in the gaps).
fn grid_hit(g: *mut TileGrid, px: f64, py: f64, n: usize) -> usize {
    var cx: f64 = 0.0
    var cy: f64 = 0.0
    if !viewport.viewport_hit(&(*g).vp, px, py, &cx, &cy) {
        return NONE
    }
    if (*g).tw == 0.0 {
        return NONE
    }
    var i: usize = 0
    while i < n {
        var tx: f64 = 0.0
        var ty: f64 = 0.0
        var tw: f64 = 0.0
        var th: f64 = 0.0
        grid_tile_rect(g, i, &tx, &ty, &tw, &th)
        if cx >= tx && cx < tx + tw && cy >= ty && cy < ty + th {
            return i
        }
        i = i + 1
    }
    return NONE
}

// The pointer moved: the hovered tile changes. True when the picture changed.
fn grid_move(g: *mut TileGrid, px: f64, py: f64, n: usize) -> bool {
    let h: usize = grid_hit(g, px, py, n)
    if h != (*g).hover {
        (*g).hover = h
        return true
    }
    return false
}

fn grid_leave(g: *mut TileGrid) -> bool {
    if (*g).hover != NONE {
        (*g).hover = NONE
        return true
    }
    return false
}

fn grid_wheel(g: *mut TileGrid, dy: f64) {
    viewport.viewport_wheel(&(*g).vp, 0.0, dy)
}

fn grid_bar_press(c: *mut render.Ctx, g: *mut TileGrid, px: f64, py: f64) -> bool {
    return viewport.viewport_bar_press(c, &(*g).vp, px, py)
}

fn grid_bar_drag(c: *mut render.Ctx, g: *mut TileGrid, px: f64, py: f64) -> bool {
    return viewport.viewport_bar_drag(c, &(*g).vp, px, py)
}

fn grid_bar_release(g: *mut TileGrid) {
    viewport.viewport_bar_release(&(*g).vp)
}

// ---- TOUCH. The plain calls the gestures of lib/fui/kittouch.fi become: a pan scrolls by
// the step the finger moved (content follows the finger), a fling carries on with the
// finger's velocity (px per second; the viewport's own ease-out, `grid_tick` runs it), a tap
// selects the tile under it and returns its index (NONE: no tile there).
fn grid_touch_pan(g: *mut TileGrid, dy: f64) {
    viewport.viewport_scroll_by(&(*g).vp, 0.0, 0.0 - dy)
}

fn grid_touch_fling(g: *mut TileGrid, vy_per_s: f64, now_ms: i64) {
    viewport.viewport_fling(&(*g).vp, 0.0, (0.0 - vy_per_s) / 1000.0, now_ms)
}

fn grid_touch_tap(g: *mut TileGrid, px: f64, py: f64, n: usize) -> usize {
    let i: usize = grid_hit(g, px, py, n)
    if i != NONE {
        (*g).sel = i
    }
    return i
}

// Arrow keys move the selection (Left/Right by one, Up/Down by a row, Home /
// End to the ends) and scroll it into view; PageUp / PageDown scroll. True
// when something changed.
fn grid_key(g: *mut TileGrid, key0: u32, n: usize) -> bool {
    var key: u32 = key0
    if KIT_RTL {
        // tile 0 stands at the right: Left goes on, Right goes back
        if key == editor.KEY_LEFT {
            key = editor.KEY_RIGHT
        } else if key == editor.KEY_RIGHT {
            key = editor.KEY_LEFT
        }
    }
    if n == 0 || (*g).tw == 0.0 {
        return false
    }
    var cur: usize = (*g).sel
    var next: usize = cur
    if cur == NONE {
        if key == editor.KEY_LEFT || key == editor.KEY_RIGHT || key == editor.KEY_UP
        || key == editor.KEY_DOWN || key == editor.KEY_HOME || key == editor.KEY_END {
            next = 0
        }
    } else if key == editor.KEY_LEFT && cur > 0 {
        next = cur - 1
    } else if key == editor.KEY_RIGHT && cur + 1 < n {
        next = cur + 1
    } else if key == editor.KEY_UP && cur >= (*g).cols {
        next = cur - (*g).cols
    } else if key == editor.KEY_DOWN && cur + (*g).cols < n {
        next = cur + (*g).cols
    } else if key == editor.KEY_HOME {
        next = 0
    } else if key == editor.KEY_END {
        next = n - 1
    }
    if key == editor.KEY_PGDN {
        viewport.viewport_scroll_by(&(*g).vp, 0.0, viewport.viewport_inner_h(&(*g).vp))
        return true
    }
    if key == editor.KEY_PGUP {
        viewport.viewport_scroll_by(&(*g).vp, 0.0, 0.0 - viewport.viewport_inner_h(&(*g).vp))
        return true
    }
    if next == cur {
        return false
    }
    (*g).sel = next
    var tx: f64 = 0.0
    var ty: f64 = 0.0
    var tw: f64 = 0.0
    var th: f64 = 0.0
    grid_tile_rect(g, next, &tx, &ty, &tw, &th)
    let ig: bool = viewport.viewport_ensure_visible(&(*g).vp, tx, ty - (*g).pad, tw, th + 2.0 * (*g).pad)
    return true
}

// ====================================================================
// TOASTS
// ====================================================================

const TOAST_MAX: usize = 4
const TOAST_TEXT_CAP: usize = 112
const TOAST_ACTION_CAP: usize = 24
const TOAST_FADE_IN: i64 = 160
const TOAST_FADE_OUT: i64 = 240

const TK_INFO: u32 = 0
const TK_SUCCESS: u32 = 1
const TK_WARNING: u32 = 2
const TK_ERROR: u32 = 3

const TOAST_PART_BODY: u32 = 1
const TOAST_PART_ACTION: u32 = 2
const TOAST_PART_CLOSE: u32 = 3

struct Toast {
    alive: bool,
    id: u32,
    kind: u32,
    text: [u8; 112],
    n: usize,
    action: [u8; 24],
    an: usize,
    born: i64,
    // 0 = stays until dismissed
    dur: i64,
    // when the fade-out began, 0 = not closing
    closing: i64,
}

struct Toasts {
    t: [Toast; 4],
    next_id: u32,
}

fn toast_blank() -> Toast {
    return Toast { alive: false, id: 0 as u32, kind: 0 as u32, text: [0 as u8; 112], n: 0,
        action: [0 as u8; 24], an: 0, born: 0, dur: 0, closing: 0 }
}

fn toasts_new() -> Toasts {
    return Toasts { t: [toast_blank(); 4], next_id: 1 as u32 }
}

// Copy at most `cap` octets of s, cut on a character boundary.
fn copy_cut(dst: *mut u8, cap: usize, s: str) -> usize {
    var n: usize = s.n
    if n > cap {
        n = cap
        while n > 0 {
            let b: u8 = rt.ld8(s.p as u64, n)
            if b >= 128 as u8 && b < 192 as u8 {
                n = n - 1
            } else {
                break
            }
        }
    }
    var i: usize = 0
    while i < n {
        rt.st8(dst as u64, i, rt.ld8(s.p as u64, i))
        i = i + 1
    }
    return n
}

// Show a message. `dur_ms` 0 keeps it until dismissed. With four showing the
// oldest goes. The id comes back (toast_dismiss / toasts_hit use it).
fn toast_push(q: *mut Toasts, kind: u32, text: str, action: str, now_ms: i64, dur_ms: i64) -> u32 {
    var slot: usize = NONE
    var i: usize = 0
    while i < TOAST_MAX {
        if !(*q).t[i].alive {
            slot = i
            break
        }
        i = i + 1
    }
    if slot == NONE {
        // the oldest
        var oldest: i64 = (*q).t[0].born
        slot = 0
        i = 1
        while i < TOAST_MAX {
            if (*q).t[i].born < oldest {
                oldest = (*q).t[i].born
                slot = i
            }
            i = i + 1
        }
    }
    let id: u32 = (*q).next_id
    (*q).next_id = (*q).next_id + 1 as u32
    (*q).t[slot] = toast_blank()
    (*q).t[slot].alive = true
    (*q).t[slot].id = id
    (*q).t[slot].kind = kind
    (*q).t[slot].n = copy_cut(&(*q).t[slot].text[0], TOAST_TEXT_CAP, text)
    (*q).t[slot].an = copy_cut(&(*q).t[slot].action[0], TOAST_ACTION_CAP, action)
    (*q).t[slot].born = now_ms
    (*q).t[slot].dur = dur_ms
    return id
}

// Start the fade-out of a toast.
fn toast_dismiss(q: *mut Toasts, id: u32, now_ms: i64) {
    var i: usize = 0
    while i < TOAST_MAX {
        if (*q).t[i].alive && (*q).t[i].id == id && (*q).t[i].closing == 0 {
            (*q).t[i].closing = now_ms
            if now_ms == 0 {
                (*q).t[i].closing = 1
            }
        }
        i = i + 1
    }
}

// Move the clock: toasts whose time is up start fading, faded ones go. True
// while any is showing (the program keeps asking for frames).
fn toasts_tick(q: *mut Toasts, now_ms: i64) -> bool {
    var any: bool = false
    var i: usize = 0
    while i < TOAST_MAX {
        if (*q).t[i].alive {
            if (*q).t[i].closing == 0 && (*q).t[i].dur > 0 && now_ms - (*q).t[i].born >= (*q).t[i].dur {
                (*q).t[i].closing = now_ms
                if now_ms == 0 {
                    (*q).t[i].closing = 1
                }
            }
            if (*q).t[i].closing != 0 && now_ms - (*q).t[i].closing >= TOAST_FADE_OUT {
                (*q).t[i].alive = false
            } else {
                any = true
            }
        }
        i = i + 1
    }
    return any
}

fn toasts_active(q: *mut Toasts) -> bool {
    var i: usize = 0
    while i < TOAST_MAX {
        if (*q).t[i].alive {
            return true
        }
        i = i + 1
    }
    return false
}

fn toasts_count(q: *mut Toasts) -> usize {
    var k: usize = 0
    var i: usize = 0
    while i < TOAST_MAX {
        if (*q).t[i].alive {
            k = k + 1
        }
        i = i + 1
    }
    return k
}

// 0..255: fading in over TOAST_FADE_IN, full, fading out over TOAST_FADE_OUT.
fn toast_alpha(t: *mut Toast, now_ms: i64) -> u32 {
    var a: i64 = 255
    let age: i64 = now_ms - (*t).born
    if age < TOAST_FADE_IN {
        a = age * 255 / TOAST_FADE_IN
    }
    if (*t).closing != 0 {
        let k: i64 = 255 - (now_ms - (*t).closing) * 255 / TOAST_FADE_OUT
        if k < a {
            a = k
        }
    }
    if a < 0 as i64 {
        a = 0
    }
    if a > 255 as i64 {
        a = 255
    }
    return a as u32
}

// The rectangle of the toast in slot `i` (bottom right, oldest on top); false
// when the slot is empty.
fn toasts_geometry(c: *mut render.Ctx, q: *mut Toasts, win_w: f64, win_h: f64, slot: usize,
    x: *mut f64, y: *mut f64, w: *mut f64, h: *mut f64) -> bool {
    if slot >= TOAST_MAX || !(*q).t[slot].alive {
        return false
    }
    // rank among the living by birth (older = higher up)
    var rank: usize = 0
    var total: usize = 0
    var i: usize = 0
    while i < TOAST_MAX {
        if (*q).t[i].alive {
            total = total + 1
            if (*q).t[i].born < (*q).t[slot].born
            || ((*q).t[i].born == (*q).t[slot].born && (*q).t[i].id < (*q).t[slot].id) {
                rank = rank + 1
            }
        }
        i = i + 1
    }
    let th: f64 = ln(c, 48)
    let gap: f64 = ln(c, 8)
    let margin: f64 = ln(c, 16)
    var tw: f64 = ln(c, 380)
    if tw > win_w - 2.0 * margin {
        tw = win_w - 2.0 * margin
    }
    let from_bottom: usize = total - 1 - rank
    *w = tw
    *h = th
    *x = win_w - margin - tw
    *y = win_h - margin - th - (from_bottom as f64) * (th + gap)
    return true
}

fn toast_icon(kind: u32) -> i64 {
    if kind == TK_SUCCESS {
        return lucide.CIRCLE_CHECK
    }
    if kind == TK_WARNING {
        return lucide.TRIANGLE_ALERT
    }
    if kind == TK_ERROR {
        return lucide.CIRCLE_ALERT
    }
    return lucide.INFO
}

// The colour of a toast's symbol: the token of its kind, adjusted to 3:1
// against the card.
fn toast_color(c: *mut render.Ctx, kind: u32) -> u32 {
    let f: *mut theme.Colors = colors_of(c)
    var base: u32 = (*f).accent
    if kind == TK_SUCCESS {
        base = (*f).success
    } else if kind == TK_WARNING {
        base = (*f).warning
    } else if kind == TK_ERROR {
        base = (*f).err_col
    }
    let bg: u32 = tokc(c, style.TOK_SURFACE_RAISED) & 16777215 as u32
    return theme.opaque(kitcolor.tone(theme_of(c), base, bg, kitcolor.MIN_UI_CONTRAST))
}

// The parts of the toast at slot `i`: the action's rectangle and the close
// button's. (ax = 0 when there is no action.)
fn toast_parts(c: *mut render.Ctx, t: *mut Toast, x: f64, y: f64, w: f64, h: f64,
    ax: *mut f64, aw: *mut f64, cx: *mut f64, cd: *mut f64) {
    let d: f64 = ln(c, 28)
    *cd = d
    *cx = x + w - ln(c, 8) - d
    if KIT_RTL {
        *cx = x + ln(c, 8)
    }
    *ax = 0.0
    *aw = 0.0
    if (*t).an > 0 {
        var a: str = str { p: (&(*t).action[0]) as *mut u8, n: (*t).an }
        let tw: f64 = text_width(c, ln(c, 14), 700, a) + ln(c, 16)
        *aw = tw
        *ax = *cx - ln(c, 8) - tw
        if KIT_RTL {
            *ax = *cx + d + ln(c, 8)
        }
    }
}

fn toasts_draw(c: *mut render.Ctx, q: *mut Toasts, win_w: f64, win_h: f64, now_ms: i64) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    var slot: usize = 0
    while slot < TOAST_MAX {
        var x: f64 = 0.0
        var y: f64 = 0.0
        var w: f64 = 0.0
        var h: f64 = 0.0
        if toasts_geometry(c, q, win_w, win_h, slot, &x, &y, &w, &h) {
            let t: *mut Toast = &(*q).t[slot]
            let a: u32 = toast_alpha(t, now_ms)
            if a == 0 as u32 {
                slot = slot + 1
                continue
            }
            // a little rise while it fades in
            var rise: f64 = 0.0
            if now_ms - (*t).born < TOAST_FADE_IN {
                rise = ln(c, 8) * (1.0 - ((now_ms - (*t).born) as f64) / (TOAST_FADE_IN as f64))
            }
            let yy: f64 = y + rise
            let r: f64 = ln(c, 12)
            // the shadow, then the card
            soft_shadow(c, x, yy, w, h, r, ln(c, 12), ln(c, 4), a)
            painter.round_rect(z, x, yy, w, h, r, with_alpha(tokc(c, style.TOK_SURFACE_RAISED), a))
            painter.round_ring(z, x, yy, w, h, r, ln(c, 1), with_alpha(tokc(c, style.TOK_BORDER), a))
            let isz: f64 = ln(c, 20)
            sym(c, toast_icon((*t).kind), rx(x + ln(c, 12), isz, x, w), yy + (h - isz) / 2.0, isz, with_alpha(toast_color(c, (*t).kind), a))
            var ax: f64 = 0.0
            var aw: f64 = 0.0
            var cx: f64 = 0.0
            var cd: f64 = 0.0
            toast_parts(c, t, x, yy, w, h, &ax, &aw, &cx, &cd)
            var right: f64 = cx - ln(c, 8)
            if (*t).an > 0 {
                right = ax - ln(c, 8)
                var act: str = str { p: (&(*t).action[0]) as *mut u8, n: (*t).an }
                draw_label(c, ax + ln(c, 8), yy, h, ln(c, 14), 700,
                    with_alpha(accent_on(c, style.TOK_SURFACE_RAISED), a), act, aw - ln(c, 16))
            }
            var tx: str = str { p: (&(*t).text[0]) as *mut u8, n: (*t).n }
            if KIT_RTL {
                // the text between the controls on the left and the symbol on the right
                var left: f64 = cx + cd + ln(c, 8)
                if (*t).an > 0 {
                    left = ax + aw + ln(c, 8)
                }
                let tr: f64 = x + w - ln(c, 12) - isz - ln(c, 12)
                label_in(c, left, yy, h, ln(c, 14), 400, with_alpha(tokc(c, style.TOK_TEXT), a), tx, tr - left)
            } else {
                let tx0: f64 = x + ln(c, 12) + isz + ln(c, 12)
                draw_label(c, tx0, yy, h, ln(c, 14), 400, with_alpha(tokc(c, style.TOK_TEXT), a), tx, right - tx0)
            }
            let xs: f64 = ln(c, 16)
            sym(c, lucide.X, cx + (cd - xs) / 2.0, yy + (h - xs) / 2.0, xs, with_alpha(tokc(c, style.TOK_TEXT_MUTED), a))
        }
        slot = slot + 1
    }
}

// Which toast and which part of it is at (px, py). False when none.
fn toasts_hit(c: *mut render.Ctx, q: *mut Toasts, win_w: f64, win_h: f64, px: f64, py: f64,
    id: *mut u32, part: *mut u32) -> bool {
    var slot: usize = 0
    while slot < TOAST_MAX {
        var x: f64 = 0.0
        var y: f64 = 0.0
        var w: f64 = 0.0
        var h: f64 = 0.0
        if toasts_geometry(c, q, win_w, win_h, slot, &x, &y, &w, &h) {
            if px >= x && px < x + w && py >= y && py < y + h && (*q).t[slot].closing == 0 {
                var ax: f64 = 0.0
                var aw: f64 = 0.0
                var cx: f64 = 0.0
                var cd: f64 = 0.0
                toast_parts(c, &(*q).t[slot], x, y, w, h, &ax, &aw, &cx, &cd)
                *id = (*q).t[slot].id
                *part = TOAST_PART_BODY
                if px >= cx && px < cx + cd {
                    *part = TOAST_PART_CLOSE
                } else if aw > 0.0 && px >= ax && px < ax + aw {
                    *part = TOAST_PART_ACTION
                }
                return true
            }
        }
        slot = slot + 1
    }
    return false
}

// ====================================================================
// MODAL
// ====================================================================

const MODAL_HIT_SCRIM: u32 = 1
const MODAL_HIT_PANEL: u32 = 2
const MODAL_HIT_CLOSE: u32 = 3

const MODAL_KEY_NONE: u32 = 0
const MODAL_KEY_FOCUS: u32 = 1
const MODAL_KEY_CLOSE: u32 = 2
const MODAL_KEY_ACTIVATE: u32 = 3

const MODAL_TITLE_CAP: usize = 64
const MODAL_FADE_MS: i64 = 160

struct Modal {
    open: bool,
    w_pt: usize,
    h_pt: usize,
    title: [u8; 64],
    tn: usize,
    // the focus trap: `n_focus` things inside the dialog can have the focus
    // (buttons, fields); `focus` is the one that has it, NONE = none yet
    n_focus: usize,
    focus: usize,
    opened: i64,
}

fn modal_new() -> Modal {
    return Modal { open: false, w_pt: 400, h_pt: 240, title: [0 as u8; 64], tn: 0,
        n_focus: 0, focus: NONE, opened: 0 }
}

// Open the dialog: a content size in points (without the title bar), and how
// many focusable things the program draws inside.
fn modal_open(m: *mut Modal, title: str, w_pt: usize, h_pt: usize, n_focus: usize, now_ms: i64) {
    (*m).open = true
    (*m).w_pt = w_pt
    (*m).h_pt = h_pt
    (*m).tn = copy_cut(&(*m).title[0], MODAL_TITLE_CAP, title)
    (*m).n_focus = n_focus
    (*m).focus = NONE
    (*m).opened = now_ms
}

fn modal_close(m: *mut Modal) {
    (*m).open = false
}

// True while the dialog is still fading in (the program keeps asking for
// frames until it is not).
fn modal_animating(m: *mut Modal, now_ms: i64) -> bool {
    return (*m).open && now_ms - (*m).opened < MODAL_FADE_MS + 40
}

// While true the background must not get keys or clicks: the program routes
// them to modal_key / modal_hit and to the dialog's own widgets.
fn modal_blocks(m: *mut Modal) -> bool {
    return (*m).open
}

// The index (0..n_focus-1) that has the focus, NONE if none.
fn modal_focus(m: *mut Modal) -> usize {
    return (*m).focus
}

fn modal_set_focus(m: *mut Modal, i: usize) {
    if i == NONE || i < (*m).n_focus {
        (*m).focus = i
    }
}

// THE RING: the next index with wrap-around. From "none", Tab goes to the
// first and Shift+Tab to the last. n == 0 gives NONE.
fn ring_next(cur: usize, n: usize, back: bool) -> usize {
    if n == 0 {
        return NONE
    }
    if cur == NONE || cur >= n {
        if back {
            return n - 1
        }
        return 0
    }
    if back {
        return (cur + n - 1) % n
    }
    return (cur + 1) % n
}

// A key while the dialog is open (editor.KEY_*): Tab / Shift+Tab move the
// focus round the ring and never leave the dialog; Escape asks to close;
// Enter asks to activate the focused thing. The background never sees any
// of them (the program does not pass them on while modal_blocks).
fn modal_key(m: *mut Modal, key: u32, mods: u32) -> u32 {
    if !(*m).open {
        return MODAL_KEY_NONE
    }
    if key == editor.KEY_TAB {
        (*m).focus = ring_next((*m).focus, (*m).n_focus, (mods & editor.MOD_SHIFT) != 0 as u32)
        return MODAL_KEY_FOCUS
    }
    if key == editor.KEY_ESC {
        return MODAL_KEY_CLOSE
    }
    if key == editor.KEY_ENTER && (*m).focus != NONE {
        return MODAL_KEY_ACTIVATE
    }
    return MODAL_KEY_NONE
}

const MODAL_TITLE_H: usize = 56

// The panel (title bar and content) centred in the window, never larger than
// the window minus a margin.
fn modal_rect(c: *mut render.Ctx, m: *mut Modal, win_w: f64, win_h: f64,
    x: *mut f64, y: *mut f64, w: *mut f64, h: *mut f64) {
    var pw: f64 = ln(c, (*m).w_pt)
    var ph: f64 = ln(c, (*m).h_pt + MODAL_TITLE_H)
    let margin: f64 = ln(c, 32)
    if pw > win_w - 2.0 * margin {
        pw = win_w - 2.0 * margin
    }
    if ph > win_h - 2.0 * margin {
        ph = win_h - 2.0 * margin
    }
    *w = pw
    *h = ph
    *x = (win_w - pw) / 2.0
    *y = (win_h - ph) / 2.0
}

// The content area: below the title bar, inside the panel's padding (16 pt).
fn modal_content_rect(c: *mut render.Ctx, m: *mut Modal, win_w: f64, win_h: f64,
    x: *mut f64, y: *mut f64, w: *mut f64, h: *mut f64) {
    var px: f64 = 0.0
    var py: f64 = 0.0
    var pw: f64 = 0.0
    var ph: f64 = 0.0
    modal_rect(c, m, win_w, win_h, &px, &py, &pw, &ph)
    let th: f64 = ln(c, MODAL_TITLE_H)
    let pad: f64 = ln(c, 16)
    *x = px + pad
    *y = py + th
    *w = pw - 2.0 * pad
    *h = ph - th - pad
}

fn modal_close_rect(c: *mut render.Ctx, px: f64, py: f64, pw: f64, cx: *mut f64, cy: *mut f64, cd: *mut f64) {
    let d: f64 = ln(c, 32)
    *cd = d
    *cx = px + pw - ln(c, 12) - d
    if KIT_RTL {
        *cx = px + ln(c, 12)
    }
    *cy = py + ln(c, 12)
}

// The scrim, the panel and its title bar. `hover_close` is the program's
// knowledge of the pointer on the close button.
fn modal_draw(c: *mut render.Ctx, m: *mut Modal, win_w: f64, win_h: f64, now_ms: i64, hover_close: bool) {
    if !(*m).open {
        return
    }
    let z: *mut painter.Painter = render.ctx_painter(c)
    var a: i64 = (now_ms - (*m).opened) * 255 / MODAL_FADE_MS
    if a > 255 as i64 {
        a = 255
    }
    if a < 0 as i64 {
        a = 0
    }
    let al: u32 = a as u32
    if al == 0 as u32 {
        return
    }
    // the scrim: the whole window, no edge that could stick out
    let sc: u32 = theme.scrim_color(theme_of(c))
    painter.surface(z, 0.0, 0.0, win_w, win_h, with_alpha(sc, (al * 180 as u32) / 255 as u32))
    var px: f64 = 0.0
    var py: f64 = 0.0
    var pw: f64 = 0.0
    var ph: f64 = 0.0
    modal_rect(c, m, win_w, win_h, &px, &py, &pw, &ph)
    let r: f64 = ln(c, 12)
    soft_shadow(c, px, py, pw, ph, r, ln(c, 24), ln(c, 8), al)
    painter.round_rect(z, px, py, pw, ph, r, with_alpha(tokc(c, style.TOK_SURFACE), al))
    painter.round_ring(z, px, py, pw, ph, r, ln(c, 1), with_alpha(tokc(c, style.TOK_BORDER), al))
    let th: f64 = ln(c, MODAL_TITLE_H)
    painter.surface(z, px + ln(c, 1), py + th - ln(c, 1), pw - ln(c, 2), ln(c, 1), with_alpha(tokc(c, style.TOK_SEPARATOR), al))
    var t: str = str { p: (&(*m).title[0]) as *mut u8, n: (*m).tn }
    var cx: f64 = 0.0
    var cy: f64 = 0.0
    var cd: f64 = 0.0
    modal_close_rect(c, px, py, pw, &cx, &cy, &cd)
    if KIT_RTL {
        // the title between the close button (left) and the right edge
        label_in(c, cx + cd + ln(c, 8), py, th, ln(c, 16), 700, with_alpha(tokc(c, style.TOK_TEXT), al), t,
            px + pw - ln(c, 20) - (cx + cd + ln(c, 8)))
    } else {
        draw_label(c, px + ln(c, 20), py, th, ln(c, 16), 700, with_alpha(tokc(c, style.TOK_TEXT), al), t,
            cx - px - ln(c, 28))
    }
    if hover_close {
        painter.round_rect(z, cx, cy, cd, cd, ln(c, 8), with_alpha(tokc(c, style.TOK_BUTTON_HOVER), al))
    }
    let xs: f64 = ln(c, 16)
    sym(c, lucide.X, cx + (cd - xs) / 2.0, cy + (cd - xs) / 2.0, xs, with_alpha(tokc(c, style.TOK_TEXT), al))
}

// What is at (px, py): the close button, the panel, or the scrim around it
// (a click there usually closes). 0 when the dialog is not open.
fn modal_hit(c: *mut render.Ctx, m: *mut Modal, win_w: f64, win_h: f64, px: f64, py: f64) -> u32 {
    if !(*m).open {
        return 0 as u32
    }
    var x: f64 = 0.0
    var y: f64 = 0.0
    var w: f64 = 0.0
    var h: f64 = 0.0
    modal_rect(c, m, win_w, win_h, &x, &y, &w, &h)
    if px < x || py < y || px >= x + w || py >= y + h {
        return MODAL_HIT_SCRIM
    }
    var cx: f64 = 0.0
    var cy: f64 = 0.0
    var cd: f64 = 0.0
    modal_close_rect(c, x, y, w, &cx, &cy, &cd)
    if px >= cx && px < cx + cd && py >= cy && py < cy + cd {
        return MODAL_HIT_CLOSE
    }
    return MODAL_HIT_PANEL
}
