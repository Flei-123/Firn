// SPDX-License-Identifier: MPL-2.0
// lib/fui/cursorreq.fi -- THE MOUSE CURSOR, THE WAY A BROWSER DOES IT.
//
// Every control says what cursor it wants over its rectangle: `zone(x, y, w, h, kind)`, called while it is
// drawn. The standard widgets of lib/fui do that on their own (button, search field, tabs, sidebar items,
// tiles, toasts, modal, composer, text area, splitter, menus), so an app gets pointer / text / resize cursors
// without a line of its own. The registry is rebuilt every frame (`begin`), the pointer position comes from the
// window layer (`pointer_set`), the host applies `wanted()` after each frame and `kind_at(x, y)` on each move
// (so the cursor follows the pointer without a repaint).
//
//   begin()                    a frame starts: the zones and the explicit request are cleared
//   zone(x, y, w, h, kind)     the later zone wins where zones overlap (it is drawn on top); CURSOR_DEFAULT
//                              as a kind is a zone too: an overlay uses it to hide the zones below
//   request(kind)              an explicit cursor for the whole frame (a drag in progress); beats the zones
//   kind_at(x, y) -> u32       what the cursor is at a point
//   pointer_set(x, y), pointer_gone()
//   wanted() -> u32            the cursor for the last known pointer position
//
// The numbers are the window layer's SHAPE_* (lib/window/window.fi).
export {
    begin, request, zone, kind_at, pointer_set, pointer_gone, wanted, zone_count,
    SHAPE_ARROW, CURSOR_DEFAULT, CURSOR_TEXT, CURSOR_POINTER, CURSOR_CROSSHAIR, CURSOR_WAIT,
    CURSOR_RESIZE_EW, CURSOR_RESIZE_NS, CURSOR_MOVE, CURSOR_NOT_ALLOWED, ZONE_MAX,
}

const SHAPE_ARROW: u32 = 0
const CURSOR_DEFAULT: u32 = 0
const CURSOR_TEXT: u32 = 1
const CURSOR_POINTER: u32 = 2
const CURSOR_CROSSHAIR: u32 = 3
const CURSOR_WAIT: u32 = 4
const CURSOR_RESIZE_EW: u32 = 5
const CURSOR_RESIZE_NS: u32 = 6
const CURSOR_MOVE: u32 = 7
const CURSOR_NOT_ALLOWED: u32 = 8
const ZONE_MAX: usize = 1024

static mut G_WANT: u32 = 0
static mut G_N: usize = 0
static mut G_X: [f64; 1024] = [0.0; 1024]
static mut G_Y: [f64; 1024] = [0.0; 1024]
static mut G_W: [f64; 1024] = [0.0; 1024]
static mut G_H: [f64; 1024] = [0.0; 1024]
static mut G_KIND: [u32; 1024] = [0 as u32; 1024]
static mut G_PX: f64 = -1.0
static mut G_PY: f64 = -1.0
static mut G_INSIDE: bool = false

fn begin() {
    G_WANT = CURSOR_DEFAULT
    G_N = 0
}

fn request(kind: u32) {
    G_WANT = kind
}

fn zone(x: f64, y: f64, w: f64, h: f64, kind: u32) {
    if G_N >= ZONE_MAX || w <= 0.0 || h <= 0.0 {
        return
    }
    G_X[G_N] = x
    G_Y[G_N] = y
    G_W[G_N] = w
    G_H[G_N] = h
    G_KIND[G_N] = kind
    G_N = G_N + 1
}

fn zone_count() -> usize {
    return G_N
}

fn kind_at(x: f64, y: f64) -> u32 {
    if G_WANT != CURSOR_DEFAULT {
        return G_WANT
    }
    var i: usize = G_N
    while i > 0 {
        i = i - 1
        if x >= G_X[i] && x < G_X[i] + G_W[i] && y >= G_Y[i] && y < G_Y[i] + G_H[i] {
            return G_KIND[i]
        }
    }
    return CURSOR_DEFAULT
}

fn pointer_set(x: f64, y: f64) {
    G_PX = x
    G_PY = y
    G_INSIDE = true
}

fn pointer_gone() {
    G_INSIDE = false
}

fn wanted() -> u32 {
    if !G_INSIDE {
        return G_WANT
    }
    return kind_at(G_PX, G_PY)
}
