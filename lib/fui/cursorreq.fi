// lib/fui/cursorreq.fi -- the mouse cursor shape an app wants for the frame being painted (apphost applies it).
export { begin, request, wanted, SHAPE_ARROW }

const SHAPE_ARROW: u32 = 0

static mut G_WANT: u32 = 0

fn begin() {
    G_WANT = SHAPE_ARROW
}

fn request(shape: u32) {
    G_WANT = shape
}

fn wanted() -> u32 {
    return G_WANT
}
