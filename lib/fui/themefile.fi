// SPDX-License-Identifier: MPL-2.0
// lib/fui/themefile.fi -- A THEME FROM A TEXT FILE, CHECKED BEFORE IT IS USED.
//
// ========================================================= WHY IT EXISTS
//
// Justin, 26.09.2026: fUi themes -- colour and shape overrides out of a
// text file, with a contrast check, chosen in the settings. Not a
// Certus feature: every fUi program (OrientOS, Certus, FirnChat) paints
// through lib/fui/theme.fi, so the file is read HERE and every one of
// them gets it by calling one function.
//
// ============================================================ THE FORMAT
//
//     # a comment (a line that starts with '#' or ';')
//     name   = Nord
//     mode   = dark            light | dark: the built-in set to start from
//     shape  = osum            osum | classic: the built-in shape
//     accent = #88C0D0         the accent; text_on_accent and selection
//                              are DERIVED from it (theme.accent_derive)
//     base   = #2E3440         any colour role of theme.Colors
//     r_button = 6             any length of theme.Shape, in design points
//
// Colours are #RRGGBB, RRGGBB or 0xRRGGBB. Lengths are decimal and have
// a range each (shape_min/shape_max below). Line order does not matter.
// The file is read in four passes:
//
//   1. name, mode, shape            the built-in starting point
//   2. every colour except the four below
//   3. accent -- and text_on_accent + selection DERIVED from it against
//      the final base and text. A file that changes base or text but
//      not the accent gets the derivation redone with the old accent,
//      or a dark text on a now dark accent would slip through
//   4. text_on_accent, selection, selection_text (an explicit value
//      beats the derived one), every length, and every error
//
// The colour roles are named as the style tokens are named
// (style.TOK_*): `border` and `error`, not the field names `border_col`
// and `err_col`.
//
// ======================================================= WHAT IS CHECKED
//
// A theme is NOT applied if
//
//   1. a line has no '=', a key nobody knows, or a value that is not a
//      colour / a number in range -- a typo such as `acent` must show
//      up, not be ignored quietly;
//   2. any text pair fUi paints (CHECK_PAIRS, the same list
//      tools/fui/contrast_main.fi checks the built-in sets with) is
//      under 4.5:1 (WCAG 2, text);
//   3. the ranking breaks: disabled text must be weaker than normal
//      text, and the three button surfaces must be three;
//   4. THE FILL RULE breaks (Justin, 02.10.2026): a widget with a border
//      must not have the same fill as the ground it sits on. The resting
//      field, the focused field and the button must each differ from
//      base, surface and surface_raised, and the resting field from the
//      focused one, by an OKLab distance of at least 0.012 (the step the
//      layers of a scheme are already held to, tools/fui/contrast_main.fi).
//      A field whose fill is its ground looks like a hole with an outline,
//      and a focused one that turns into the page colour shows no focus
//      at all but the ring. (Reported with ERR_RANK and the name of the
//      pair: field-ground, focus-ground, button-ground, field-focus.)
//
// Then the theme the program had stays, and `ThemeFile` says why --
// line and key for 1, the pair and its ratio for 2. A program can show
// that sentence in its settings instead of a screen nobody can read.
//
// ==================================================== WHAT IS NOT HERE
//
// No file access. The caller reads the bytes (Certus from
// ~/.certus/themes, OrientOS from /etc, the web from a fetch) and hands
// them over; this module only needs a pointer and a length. That keeps
// it usable in every profile fUi runs in.
//
// No animated background. fUi has no clock of its own yet; that is a
// follow-up point of its own.
import fui.theme
import fui.anim
import svg.matrix

export {
    ThemeFile, themefile_new, themefile_apply, themefile_check,
    themefile_ok, themefile_name, themefile_name_len,
    themefile_err, themefile_err_line, themefile_err_key,
    themefile_err_key_len, themefile_fails, themefile_min,
    themefile_worst, themefile_rank_fails,
    check_pair_count, check_pair, check_pair_name,
    check_rank_disabled, check_rank_surfaces, check_fill_distinct,
    fill_delta_e, FILL_DE_MIN, FILL_FIELD_GROUND, FILL_FOCUS_GROUND,
    FILL_BUTTON_GROUND, FILL_FIELD_FOCUS,
    ERR_NONE, ERR_SYNTAX, ERR_KEY, ERR_VALUE, ERR_CONTRAST, ERR_RANK,
    CONTRAST_MIN,
}

// What went wrong first. ERR_NONE = the theme was applied.
const ERR_NONE: u32 = 0
const ERR_SYNTAX: u32 = 1 // a line without '='
const ERR_KEY: u32 = 2 // a key nobody knows
const ERR_VALUE: u32 = 3 // not a colour / not a number / out of range
const ERR_CONTRAST: u32 = 4 // a text pair under 4.5:1
const ERR_RANK: u32 = 5 // disabled not weaker, or button surfaces equal

// 4.5:1 in hundredths.
const CONTRAST_MIN: i64 = 450

const NAME_MAX: usize = 48
const KEY_MAX: usize = 32

struct ThemeFile {
    name: [u8; 48],
    name_n: usize,
    err: u32,
    err_line: usize, // 1-based; 0 = not a line (contrast / rank)
    err_key: [u8; 32], // the key of that line, or the pair name
    err_key_n: usize,
    fails: usize, // text pairs under 4.5:1
    rank_fails: usize,
    min: i64, // the weakest pair, hundredths
    worst: usize, // its index in CHECK_PAIRS
    touched: bool, // a colour the accent derives from was set
    accent_seen: bool,
}

fn themefile_new() -> ThemeFile {
    return ThemeFile {
        name: [0; 48], name_n: 0, err: ERR_NONE, err_line: 0,
        err_key: [0; 32], err_key_n: 0, fails: 0, rank_fails: 0,
        min: 2100, worst: 0, touched: false, accent_seen: false,
    }
}

fn themefile_ok(r: *mut ThemeFile) -> bool { return (*r).err == ERR_NONE }
fn themefile_name(r: *mut ThemeFile) -> u64 { return (&(*r).name[0]) as u64 }
fn themefile_name_len(r: *mut ThemeFile) -> usize { return (*r).name_n }
fn themefile_err(r: *mut ThemeFile) -> u32 { return (*r).err }
fn themefile_err_line(r: *mut ThemeFile) -> usize { return (*r).err_line }
fn themefile_err_key(r: *mut ThemeFile) -> u64 {
    return (&(*r).err_key[0]) as u64
}
fn themefile_err_key_len(r: *mut ThemeFile) -> usize {
    return (*r).err_key_n
}
fn themefile_fails(r: *mut ThemeFile) -> usize { return (*r).fails }
fn themefile_min(r: *mut ThemeFile) -> i64 { return (*r).min }
fn themefile_worst(r: *mut ThemeFile) -> usize { return (*r).worst }
fn themefile_rank_fails(r: *mut ThemeFile) -> usize {
    return (*r).rank_fails
}

// ================================================================ TABLES
//
// Word lists, one space between two words. The ORDER is the order of
// the slots below (`color_slot`, `shape_slot`, `check_pair`) -- whoever
// adds a word adds the slot in the same place.

// The colour roles, in the order of theme.Colors. `accent` is among
// them only so that it counts as a known key; it is applied through
// accent_derive and not through its slot.
static COLOR_KEYS: [u8; 195] = "base surface surface_raised button button_hover button_active field field_focus border separator text text_muted text_disabled text_on_accent accent selection selection_text error warning success"
const COLOR_COUNT: usize = 20
const ACCENT_SLOT: usize = 14

static SHAPE_KEYS: [u8; 139] = "r_window r_panel r_button r_field border_w focus_w sep_strength sp_xs sp_s sp_m sp_l pad_x pad_y gap ctrl_h row font motion shadow shadow_r"
const SHAPE_COUNT: usize = 20

// The fifteen text pairs fUi paints: foreground/background. This is
// THE list -- tools/fui/contrast_main.fi reads it from here.
static PAIR_NAMES: [u8; 252] = "text/button text/button_hover text/button_active text/field text/field_focus text/surface text/surface_raised text/base text_muted/surface text_disabled/button selection_text/selection text_on_accent/accent error/surface warning/surface success/surface"
const PAIR_COUNT: usize = 15

static W_NAME: [u8; 4] = "name"
static W_MODE: [u8; 4] = "mode"
static W_SHAPE: [u8; 5] = "shape"
static W_LIGHT: [u8; 5] = "light"
static W_DARK: [u8; 4] = "dark"
static W_OSUM: [u8; 4] = "osum"
static W_CLASSIC: [u8; 7] = "classic"
static W_RANK1: [u8; 15] = "disabled-weaker"
static W_RANK2: [u8; 15] = "button-surfaces"
static W_FILL1: [u8; 12] = "field-ground"
static W_FILL2: [u8; 12] = "focus-ground"
static W_FILL3: [u8; 13] = "button-ground"
static W_FILL4: [u8; 11] = "field-focus"

// ================================================================ BYTES
fn at(p: u64, i: usize) -> u32 {
    let b: u8 = *((p + i as u64) as *mut u8)
    return b as u32
}

fn is_space(c: u32) -> bool {
    return c == 32 as u32 || c == 9 as u32 || c == 13 as u32
}

fn same(a: u64, an: usize, b: u64, bn: usize) -> bool {
    if an != bn {
        return false
    }
    var i: usize = 0
    while i < an {
        if at(a, i) != at(b, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// The index of word `key` in the space separated list `tbl`, or -1.
fn table_find(tbl: u64, tn: usize, key: u64, kn: usize) -> i64 {
    var i: usize = 0
    var idx: i64 = 0
    while i < tn {
        var j: usize = i
        while j < tn && at(tbl, j) != 32 as u32 {
            j = j + 1
        }
        if same(tbl + i as u64, j - i, key, kn) {
            return idx
        }
        idx = idx + 1
        i = j + 1
    }
    return 0 - 1
}

// Word `k` of the list: its start, and its length through `len`.
fn table_word(tbl: u64, tn: usize, k: usize, len: *mut usize) -> u64 {
    var i: usize = 0
    var idx: usize = 0
    while i < tn {
        var j: usize = i
        while j < tn && at(tbl, j) != 32 as u32 {
            j = j + 1
        }
        if idx == k {
            *len = j - i
            return tbl + i as u64
        }
        idx = idx + 1
        i = j + 1
    }
    *len = 0
    return tbl
}

fn hexval(c: u32) -> i64 {
    if c >= 48 as u32 && c <= 57 as u32 { return (c - 48 as u32) as i64 }
    if c >= 97 as u32 && c <= 102 as u32 { return (c - 87 as u32) as i64 }
    if c >= 65 as u32 && c <= 70 as u32 { return (c - 55 as u32) as i64 }
    return 0 - 1
}

// #RRGGBB, RRGGBB or 0xRRGGBB. -1 if it is none of them.
fn parse_color(p: u64, n: usize) -> i64 {
    var s: usize = 0
    if n == 7 && at(p, 0) == 35 as u32 {
        s = 1
    } else if n == 8 && at(p, 0) == 48 as u32
    && (at(p, 1) == 120 as u32 || at(p, 1) == 88 as u32) {
        s = 2
    } else if n != 6 {
        return 0 - 1
    }
    var v: i64 = 0
    var i: usize = s
    while i < n {
        let h: i64 = hexval(at(p, i))
        if h < 0 {
            return 0 - 1
        }
        v = v * 16 + h
        i = i + 1
    }
    return v
}

// A decimal number, at most five digits. -1 if it is not one.
fn parse_num(p: u64, n: usize) -> i64 {
    if n == 0 || n > 5 {
        return 0 - 1
    }
    var v: i64 = 0
    var i: usize = 0
    while i < n {
        let c: u32 = at(p, i)
        if c < 48 as u32 || c > 57 as u32 {
            return 0 - 1
        }
        v = v * 10 + (c - 48 as u32) as i64
        i = i + 1
    }
    return v
}

// ================================================================ SLOTS
fn color_slot(f: *mut theme.Colors, i: usize) -> *mut u32 {
    if i == 0 { return &(*f).base }
    if i == 1 { return &(*f).surface }
    if i == 2 { return &(*f).surface_raised }
    if i == 3 { return &(*f).button }
    if i == 4 { return &(*f).button_hover }
    if i == 5 { return &(*f).button_active }
    if i == 6 { return &(*f).field }
    if i == 7 { return &(*f).field_focus }
    if i == 8 { return &(*f).border_col }
    if i == 9 { return &(*f).separator }
    if i == 10 { return &(*f).text }
    if i == 11 { return &(*f).text_muted }
    if i == 12 { return &(*f).text_disabled }
    if i == 13 { return &(*f).text_on_accent }
    if i == 14 { return &(*f).accent }
    if i == 15 { return &(*f).selection }
    if i == 16 { return &(*f).selection_text }
    if i == 17 { return &(*f).err_col }
    if i == 18 { return &(*f).warning }
    return &(*f).success
}

fn shape_slot(s: *mut theme.Shape, i: usize) -> *mut usize {
    if i == 0 { return &(*s).r_window }
    if i == 1 { return &(*s).r_panel }
    if i == 2 { return &(*s).r_button }
    if i == 3 { return &(*s).r_field }
    if i == 4 { return &(*s).border_w }
    if i == 5 { return &(*s).focus_w }
    if i == 6 { return &(*s).sep_strength }
    if i == 7 { return &(*s).sp_xs }
    if i == 8 { return &(*s).sp_s }
    if i == 9 { return &(*s).sp_m }
    if i == 10 { return &(*s).sp_l }
    if i == 11 { return &(*s).pad_x }
    if i == 12 { return &(*s).pad_y }
    if i == 13 { return &(*s).gap }
    if i == 14 { return &(*s).ctrl_h }
    if i == 15 { return &(*s).row }
    if i == 16 { return &(*s).font }
    if i == 17 { return &(*s).motion }
    if i == 18 { return &(*s).shadow }
    return &(*s).shadow_r
}

// The allowed range per length. Radii and spacings up to 64 design
// points, a stroke at most 8, a control at least 16 high ("what you
// touch" -- below that it is a pixel, not a button), a font 8..48, a
// motion at most two seconds, the shadow opacity 0..255.
fn shape_min(i: usize) -> i64 {
    if i == 5 { return 1 } // focus_w: a ring of 0 is no ring
    if i == 14 { return 16 } // ctrl_h
    if i == 15 { return 12 } // row
    if i == 16 { return 8 } // font
    return 0
}

fn shape_max(i: usize) -> i64 {
    if i == 4 || i == 5 { return 8 }
    if i == 6 { return 100 }
    if i == 14 || i == 15 { return 96 }
    if i == 16 { return 48 }
    if i == 17 { return 2000 }
    if i == 18 { return 255 }
    return 64
}

// ====================================================== THE CHECK LIST
fn check_pair_count() -> usize {
    return PAIR_COUNT
}

// Pair `i`: foreground and background.
fn check_pair(f: *mut theme.Colors, i: usize, fg: *mut u32, bg: *mut u32) {
    if i < 8 {
        *fg = (*f).text
        if i == 0 { *bg = (*f).button }
        if i == 1 { *bg = (*f).button_hover }
        if i == 2 { *bg = (*f).button_active }
        if i == 3 { *bg = (*f).field }
        if i == 4 { *bg = (*f).field_focus }
        if i == 5 { *bg = (*f).surface }
        if i == 6 { *bg = (*f).surface_raised }
        if i == 7 { *bg = (*f).base }
        return
    }
    if i == 8 { *fg = (*f).text_muted
        *bg = (*f).surface
        return }
    if i == 9 { *fg = (*f).text_disabled
        *bg = (*f).button
        return }
    if i == 10 { *fg = (*f).selection_text
        *bg = (*f).selection
        return }
    if i == 11 { *fg = (*f).text_on_accent
        *bg = (*f).accent
        return }
    *bg = (*f).surface
    if i == 12 { *fg = (*f).err_col
        return }
    if i == 13 { *fg = (*f).warning
        return }
    *fg = (*f).success
}

// The name of pair `i` ("text/button"), its length through `len`.
fn check_pair_name(i: usize, len: *mut usize) -> u64 {
    return table_word((&PAIR_NAMES[0]) as u64, 252 as usize, i, len)
}

// Disabled text is weaker than ordinary text on the same button.
fn check_rank_disabled(f: *mut theme.Colors) -> bool {
    return theme.contrast((*f).text_disabled, (*f).button)
    < theme.contrast((*f).text, (*f).button)
}

// THE FILL RULE. The OKLab distance of two colours (anim.fi has the
// conversion; there is no second place for it) and the smallest one a
// bordered widget may have to the ground under it.
const FILL_DE_MIN: f64 = 0.012

// What failed first: 0 = nothing.
const FILL_FIELD_GROUND: u32 = 1
const FILL_FOCUS_GROUND: u32 = 2
const FILL_BUTTON_GROUND: u32 = 3
const FILL_FIELD_FOCUS: u32 = 4

fn fill_delta_e(a: u32, b: u32) -> f64 {
    var l0: f64 = 0.0
    var a0: f64 = 0.0
    var b0: f64 = 0.0
    var l1: f64 = 0.0
    var a1: f64 = 0.0
    var b1: f64 = 0.0
    anim.srgb_to_oklab(((a >> 16) & 255 as u32) as f64 / 255.0,
        ((a >> 8) & 255 as u32) as f64 / 255.0, (a & 255 as u32) as f64 / 255.0,
        &l0, &a0, &b0)
    anim.srgb_to_oklab(((b >> 16) & 255 as u32) as f64 / 255.0,
        ((b >> 8) & 255 as u32) as f64 / 255.0, (b & 255 as u32) as f64 / 255.0,
        &l1, &a1, &b1)
    let dl: f64 = l1 - l0
    let da: f64 = a1 - a0
    let db: f64 = b1 - b0
    return matrix.m_sqrt(dl * dl + da * da + db * db)
}

fn fill_apart(a: u32, b: u32) -> bool {
    return a != b && fill_delta_e(a, b) >= FILL_DE_MIN
}

// A bordered widget (the resting field, the focused field, the button) never
// has the fill of a ground it can sit on (base, surface, surface_raised),
// and the resting field is not the focused one. 0 = the rule holds,
// otherwise FILL_*: the first pair that breaks it.
fn check_fill_distinct(f: *mut theme.Colors) -> u32 {
    if !fill_apart((*f).field, (*f).base) || !fill_apart((*f).field, (*f).surface)
    || !fill_apart((*f).field, (*f).surface_raised) {
        return FILL_FIELD_GROUND
    }
    if !fill_apart((*f).field_focus, (*f).base)
    || !fill_apart((*f).field_focus, (*f).surface)
    || !fill_apart((*f).field_focus, (*f).surface_raised) {
        return FILL_FOCUS_GROUND
    }
    if !fill_apart((*f).button, (*f).base) || !fill_apart((*f).button, (*f).surface)
    || !fill_apart((*f).button, (*f).surface_raised) {
        return FILL_BUTTON_GROUND
    }
    if !fill_apart((*f).field, (*f).field_focus) {
        return FILL_FIELD_FOCUS
    }
    return 0 as u32
}

// Resting, hovered and pressed are three different surfaces.
fn check_rank_surfaces(f: *mut theme.Colors) -> bool {
    return (*f).button != (*f).button_hover
    && (*f).button_hover != (*f).button_active
    && (*f).button != (*f).button_active
}

fn set_key(r: *mut ThemeFile, p: u64, n: usize) {
    var k: usize = n
    if k > KEY_MAX {
        k = KEY_MAX
    }
    var i: usize = 0
    while i < k {
        (*r).err_key[i] = at(p, i) as u8
        i = i + 1
    }
    (*r).err_key_n = k
}

// Check a set of colours. Fills fails / min / worst / rank_fails and,
// if something fails and nothing failed before, `err`. Returns true if
// the set keeps every promise.
fn themefile_check(f: *mut theme.Colors, r: *mut ThemeFile) -> bool {
    (*r).fails = 0
    (*r).rank_fails = 0
    (*r).min = 2100
    (*r).worst = 0
    var i: usize = 0
    while i < PAIR_COUNT {
        var fg: u32 = 0
        var bg: u32 = 0
        check_pair(f, i, &fg, &bg)
        let h: i64 = (theme.contrast(fg, bg) * 100.0 + 0.5) as i64
        if h < (*r).min {
            (*r).min = h
            (*r).worst = i
        }
        if h < CONTRAST_MIN {
            (*r).fails = (*r).fails + 1
        }
        i = i + 1
    }
    if !check_rank_disabled(f) {
        (*r).rank_fails = (*r).rank_fails + 1
    }
    if !check_rank_surfaces(f) {
        (*r).rank_fails = (*r).rank_fails + 1
    }
    let fill: u32 = check_fill_distinct(f)
    if fill != 0 as u32 {
        (*r).rank_fails = (*r).rank_fails + 1
    }
    if (*r).err != ERR_NONE {
        return false
    }
    if (*r).fails > 0 {
        (*r).err = ERR_CONTRAST
        (*r).err_line = 0
        var n: usize = 0
        let p: u64 = check_pair_name((*r).worst, &n)
        set_key(r, p, n)
        return false
    }
    if (*r).rank_fails > 0 {
        (*r).err = ERR_RANK
        (*r).err_line = 0
        if !check_rank_disabled(f) {
            set_key(r, (&W_RANK1[0]) as u64, 15 as usize)
        } else if !check_rank_surfaces(f) {
            set_key(r, (&W_RANK2[0]) as u64, 15 as usize)
        } else if fill == FILL_FIELD_GROUND {
            set_key(r, (&W_FILL1[0]) as u64, 12 as usize)
        } else if fill == FILL_FOCUS_GROUND {
            set_key(r, (&W_FILL2[0]) as u64, 12 as usize)
        } else if fill == FILL_BUTTON_GROUND {
            set_key(r, (&W_FILL3[0]) as u64, 13 as usize)
        } else {
            set_key(r, (&W_FILL4[0]) as u64, 11 as usize)
        }
        return false
    }
    return true
}

// ============================================================ THE READER
//
// One line at a time: key and value, both trimmed. `pass` says which
// keys are applied in this round (see the head of the file). Returns false as soon as an
// error has been recorded.
fn fail(r: *mut ThemeFile, e: u32, line: usize, k: u64, kn: usize) -> bool {
    if (*r).err == ERR_NONE {
        (*r).err = e
        (*r).err_line = line
        set_key(r, k, kn)
    }
    return false
}

fn do_line(t: *mut theme.Theme, r: *mut ThemeFile, pass: u32, line: usize,
    p: u64, n: usize) -> bool {
    // trim
    var a: usize = 0
    var b: usize = n
    while a < b && is_space(at(p, a)) {
        a = a + 1
    }
    while b > a && is_space(at(p, b - 1)) {
        b = b - 1
    }
    if a == b {
        return true
    }
    let c0: u32 = at(p, a)
    if c0 == 35 as u32 || c0 == 59 as u32 {
        return true
    }
    // split at '='
    var e: usize = a
    while e < b && at(p, e) != 61 as u32 {
        e = e + 1
    }
    if e == b {
        if pass == 4 as u32 {
            return fail(r, ERR_SYNTAX, line, p + a as u64, b - a)
        }
        return true
    }
    var ke: usize = e
    while ke > a && is_space(at(p, ke - 1)) {
        ke = ke - 1
    }
    var vs: usize = e + 1
    while vs < b && is_space(at(p, vs)) {
        vs = vs + 1
    }
    let k: u64 = p + a as u64
    let kn: usize = ke - a
    let v: u64 = p + vs as u64
    let vn: usize = b - vs

    // ---- name / mode / shape
    if same(k, kn, (&W_NAME[0]) as u64, 4 as usize) {
        if pass == 1 as u32 {
            var m: usize = vn
            if m > NAME_MAX {
                m = NAME_MAX
            }
            var i: usize = 0
            while i < m {
                (*r).name[i] = at(v, i) as u8
                i = i + 1
            }
            (*r).name_n = m
        }
        return true
    }
    if same(k, kn, (&W_MODE[0]) as u64, 4 as usize) {
        if pass != 1 as u32 {
            return true
        }
        if same(v, vn, (&W_DARK[0]) as u64, 4 as usize) {
            theme.theme_set_dark(t, true)
            return true
        }
        if same(v, vn, (&W_LIGHT[0]) as u64, 5 as usize) {
            theme.theme_set_dark(t, false)
            return true
        }
        return fail(r, ERR_VALUE, line, k, kn)
    }
    if same(k, kn, (&W_SHAPE[0]) as u64, 5 as usize) {
        if pass != 1 as u32 {
            return true
        }
        if same(v, vn, (&W_OSUM[0]) as u64, 4 as usize) {
            var s: theme.Shape = theme.shape_osum()
            theme.theme_set_shape(t, &s)
            return true
        }
        if same(v, vn, (&W_CLASSIC[0]) as u64, 7 as usize) {
            var s2: theme.Shape = theme.shape_classic()
            theme.theme_set_shape(t, &s2)
            return true
        }
        return fail(r, ERR_VALUE, line, k, kn)
    }

    // ---- a colour role
    let ci: i64 = table_find((&COLOR_KEYS[0]) as u64, 195 as usize, k, kn)
    if ci >= 0 {
        let slot: usize = ci as usize
        var want: u32 = 2
        if slot == ACCENT_SLOT {
            want = 3
        } else if slot == 13 || slot == 15 || slot == 16 {
            want = 4
        }
        // the value is checked in pass 2, whatever pass applies it, so
        // a bad colour is reported before anything else of the file
        let col: i64 = parse_color(v, vn)
        if col < 0 {
            if pass == 2 as u32 {
                return fail(r, ERR_VALUE, line, k, kn)
            }
            return true
        }
        if pass != want {
            return true
        }
        if slot == ACCENT_SLOT {
            theme.theme_set_accent(t, col as u32)
            (*r).accent_seen = true
        } else {
            *color_slot(theme.theme_colors(t), slot) = col as u32
            if slot == 0 || slot == 10 {
                (*r).touched = true
            }
        }
        return true
    }

    // ---- a length
    let si: i64 = table_find((&SHAPE_KEYS[0]) as u64, 139 as usize, k, kn)
    if si >= 0 {
        if pass != 4 as u32 {
            return true
        }
        let x: i64 = parse_num(v, vn)
        if x < shape_min(si as usize) || x > shape_max(si as usize) {
            return fail(r, ERR_VALUE, line, k, kn)
        }
        *shape_slot(theme.theme_shape(t), si as usize) = x as usize
        return true
    }

    if pass == 4 as u32 {
        return fail(r, ERR_KEY, line, k, kn)
    }
    return true
}

fn run_pass(t: *mut theme.Theme, r: *mut ThemeFile, pass: u32, p: u64,
    n: usize) -> bool {
    var i: usize = 0
    var line: usize = 1
    while i < n {
        var j: usize = i
        while j < n && at(p, j) != 10 as u32 {
            j = j + 1
        }
        if !do_line(t, r, pass, line, p + i as u64, j - i) {
            return false
        }
        line = line + 1
        i = j + 1
    }
    return true
}

// READ, CHECK, APPLY. The theme `m` is changed ONLY if the whole file
// is valid and the result keeps every contrast promise; otherwise `m`
// is exactly what it was and `r` says why. The scale of `m` is never
// touched -- it belongs to the device, not to the theme.
//
// A file without `mode` starts from the set `m` has now (light or
// dark); without `shape`, from the shape `m` has now.
fn themefile_apply(m: *mut theme.Theme, p: u64, n: usize,
    r: *mut ThemeFile) -> bool {
    *r = themefile_new()
    var t: theme.Theme = *m
    // A file changes colours relative to a BUILT-IN set, not relative
    // to whatever theme was loaded before -- otherwise loading A then
    // B would give "B on top of A".
    theme.theme_set_dark(&t, theme.theme_is_dark(m))
    var s0: theme.Shape = theme.shape_osum()
    theme.theme_set_shape(&t, &s0)
    if !run_pass(&t, r, 1 as u32, p, n) {
        return false
    }
    if !run_pass(&t, r, 2 as u32, p, n) {
        return false
    }
    if !run_pass(&t, r, 3 as u32, p, n) {
        return false
    }
    if (*r).touched && !(*r).accent_seen {
        let a: u32 = (*theme.theme_colors(&t)).accent
        theme.theme_set_accent(&t, a)
    }
    if !run_pass(&t, r, 4 as u32, p, n) {
        return false
    }
    if !themefile_check(theme.theme_colors(&t), r) {
        return false
    }
    *m = t
    return true
}
