// SPDX-License-Identifier: MPL-2.0
// lib/fui/face.fi -- THE FACES OF A SCREEN, INSTALLED INTO A PAINTER IN ONE CALL.
//
// `face.install(z)`: Inter (400 as the main face, 500/600/700 as weight faces) when
// lib/plat/uifont.fi finds it, the system face of the painter plus its real bold
// otherwise; the monospace face in font slot 1 (`style.font_id` 1). The face the
// painter had before stays as the fallback for every character Inter does not hold.
import std.rt
import font.metrics
import fui.painter
import plat.sysfont
import plat.uifont

export { install, install_family, install_system_bold, install_mono, MONO_SLOT }

const MONO_SLOT: usize = 1

fn new_set() -> *mut metrics.FontSet {
    return rt.heap_alloc(4096) as *mut metrics.FontSet
}

fn install_family(z: *mut painter.Painter) -> bool {
    let regular: *mut metrics.FontSet = new_set()
    if !uifont.load_face(0, regular) { return false }
    painter.painter_set_fallback(z, 0, painter.painter_font(z))
    painter.painter_set_font(z, regular as u64)
    var i: usize = 1
    while i < uifont.FACE_COUNT {
        let f: *mut metrics.FontSet = new_set()
        if uifont.load_face(i, f) { painter.painter_set_weight_face(z, i - 1, uifont.face_weight(i), f as u64) }
        i = i + 1
    }
    return true
}

fn install_system_bold(z: *mut painter.Painter) {
    let bold: *mut metrics.FontSet = new_set()
    if sysfont.sysfont_load_bold(bold) { painter.painter_set_weight_face(z, 0, 700, bold as u64) }
}

fn install_mono(z: *mut painter.Painter) {
    let m: *mut metrics.FontSet = new_set()
    if uifont.load_mono(m) { painter.painter_set_font_slot(z, MONO_SLOT, m as u64) }
}

fn install(z: *mut painter.Painter) {
    if !install_family(z) { install_system_bold(z) }
    install_mono(z)
}
