import fui.ds_icons
import fui.ds_icons_data16
import fui.ds_icons_data20
import fui.ds_icons_data24

export { install }

fn look(id: i64, grade: i64, filled: bool) -> str {
    if grade == 0 {
        if filled { return ds_icons_data16.filled(id) }
        return ds_icons_data16.regular(id)
    }
    if grade == 1 {
        if filled { return ds_icons_data20.filled(id) }
        return ds_icons_data20.regular(id)
    }
    if filled { return ds_icons_data24.filled(id) }
    return ds_icons_data24.regular(id)
}

fn install() {
    ds_icons.set_full(look)
}
