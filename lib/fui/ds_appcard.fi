import std.math
import fui.ds_catalog_tok
import fui.editor
import fui.kit
import fui.kitapp
import fui.painter
import fui.render
import fui.screenax
import fui.style
import fui.wave8
import fui.widget

export {
    Card, card_new, set_state, state_of, set_progress, progress_of, set_focus, has_focus, preferred_h, draw, hit,
    press, release, click, key, text, button_rect, label_of, action_of, ring_draw,
    S_INSTALL, S_OPEN, S_UPDATE, S_INSTALLING, S_UNAVAILABLE,
    ACT_NONE, ACT_CARD, ACT_INSTALL, ACT_OPEN, ACT_UPDATE, ACT_CANCEL,
    HIT_NONE, HIT_CARD, HIT_BUTTON,
}

const S_INSTALL: u32 = 0
const S_OPEN: u32 = 1
const S_UPDATE: u32 = 2
const S_INSTALLING: u32 = 3
const S_UNAVAILABLE: u32 = 4

const ACT_NONE: u32 = 0
const ACT_CARD: u32 = 1
const ACT_INSTALL: u32 = 2
const ACT_OPEN: u32 = 3
const ACT_UPDATE: u32 = 4
const ACT_CANCEL: u32 = 5

const HIT_NONE: u32 = 0
const HIT_CARD: u32 = 1
const HIT_BUTTON: u32 = 2

const RING_DOTS: usize = 16

struct Card {
    state: u32,
    permille: i64,
    foc: bool,
    kbd: bool,
    down: u32,
    hov: u32,
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    bx: f64,
    by: f64,
    bw: f64,
    bh: f64,
}

fn card_new() -> Card {
    return Card { state: S_INSTALL, permille: 0 as i64, foc: false, kbd: false, down: HIT_NONE, hov: HIT_NONE,
        x: 0.0, y: 0.0, w: 0.0, h: 0.0, bx: 0.0, by: 0.0, bw: 0.0, bh: 0.0 }
}

fn set_state(k: *mut Card, s: u32) { (*k).state = s }
fn state_of(k: *mut Card) -> u32 { return (*k).state }

fn set_progress(k: *mut Card, permille: i64) {
    var p: i64 = permille
    if p > 1000 as i64 { p = 1000 }
    if p < 0 as i64 { p = 0 - 1 }
    (*k).permille = p
}

fn progress_of(k: *mut Card) -> i64 { return (*k).permille }

fn set_focus(k: *mut Card, on: bool, by_key: bool) {
    (*k).foc = on
    (*k).kbd = on && by_key
}

fn has_focus(k: *mut Card) -> bool { return (*k).foc }

fn label_of(s: u32) -> str {
    if s == S_OPEN { return "Open" }
    if s == S_UPDATE { return "Update" }
    if s == S_INSTALLING { return "Cancel" }
    return "Install"
}

fn action_of(s: u32) -> u32 {
    if s == S_INSTALL { return ACT_INSTALL }
    if s == S_OPEN { return ACT_OPEN }
    if s == S_UPDATE { return ACT_UPDATE }
    if s == S_INSTALLING { return ACT_CANCEL }
    return ACT_NONE
}

fn preferred_h(c: *mut render.Ctx) -> f64 {
    return ds_catalog_tok.pad(c) * 2.0 + ds_catalog_tok.tile_size(c) + ds_catalog_tok.gap(c) + kit.button_height(c)
}

fn button_rect(k: *mut Card, out: *mut [f64; 4]) {
    (*out)[0] = (*k).bx
    (*out)[1] = (*k).by
    (*out)[2] = (*k).bw
    (*out)[3] = (*k).bh
}

fn inside(px: f64, py: f64, x: f64, y: f64, w: f64, h: f64) -> bool {
    return px >= x && px < x + w && py >= y && py < y + h
}

fn hit(k: *mut Card, px: f64, py: f64) -> u32 {
    if (*k).w <= 0.0 { return HIT_NONE }
    if inside(px, py, (*k).bx, (*k).by, (*k).bw, (*k).bh) && (*k).state != S_UNAVAILABLE { return HIT_BUTTON }
    if inside(px, py, (*k).x, (*k).y, (*k).w, (*k).h) { return HIT_CARD }
    return HIT_NONE
}

fn ring_draw(c: *mut render.Ctx, x: f64, y: f64, d: f64, permille: i64, fill: u32, track: u32) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let dd: f64 = d / 5.0
    let rad: f64 = (d - dd) / 2.0
    let cx: f64 = x + d / 2.0
    let cy: f64 = y + d / 2.0
    let lit: usize = ((permille * (RING_DOTS as i64) + 500 as i64) / 1000 as i64) as usize
    var i: usize = 0
    while i < RING_DOTS {
        let ang: f64 = (i as f64) * 2.0 * math.PI() / (RING_DOTS as f64) - math.PI() / 2.0
        var col: u32 = track
        if i < lit { col = fill }
        painter.round_rect(z, cx + rad * math.cos(ang) - dd / 2.0, cy + rad * math.sin(ang) - dd / 2.0, dd, dd, dd / 2.0, col)
        i = i + 1
    }
}

fn percent_text(permille: i64, buf: *mut [u8; 24]) -> usize {
    var d: [u8; 24] = [0 as u8; 24]
    let n: usize = kit.fmt_uint((permille / 10 as i64) as u64, &d)
    var i: usize = 0
    while i < n {
        (*buf)[i] = d[i]
        i = i + 1
    }
    (*buf)[n] = 32 as u8
    (*buf)[n + 1] = 37 as u8
    return n + 2
}

#[allow_escape]
fn draw_button(k: *mut Card, c: *mut render.Ctx) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let x: f64 = (*k).bx
    let y: f64 = (*k).by
    let w: f64 = (*k).bw
    let h: f64 = (*k).bh
    let r: f64 = ds_catalog_tok.radius_item(c)
    let hot: bool = (*k).hov == HIT_BUTTON
    let pressed: bool = (*k).down == HIT_BUTTON
    let st: u32 = (*k).state
    var fg: u32 = ds_catalog_tok.text(c)
    if st == S_INSTALL || st == S_UPDATE {
        var fill: u32 = ds_catalog_tok.accent_fill(c)
        if pressed {
            fill = kit.with_alpha(fill, 200 as u32)
        } else if hot {
            fill = kit.with_alpha(fill, 235 as u32)
        }
        painter.round_rect(z, x, y, w, h, r, fill)
        fg = ds_catalog_tok.on_accent(c)
    } else if st == S_OPEN {
        var fill: u32 = kit.tokc(c, style.TOK_BUTTON)
        if pressed {
            fill = ds_catalog_tok.fill_pressed(c)
        } else if hot {
            fill = ds_catalog_tok.fill_hover(c)
        }
        painter.round_rect(z, x, y, w, h, r, fill)
        painter.round_ring(z, x, y, w, h, r, kit.ln(c, 1), ds_catalog_tok.border(c))
    } else if st == S_INSTALLING {
        if pressed {
            painter.round_rect(z, x, y, w, h, r, ds_catalog_tok.fill_pressed(c))
        } else if hot {
            painter.round_rect(z, x, y, w, h, r, ds_catalog_tok.fill_hover(c))
        }
        let d: f64 = ds_catalog_tok.ring_size(c)
        let ry: f64 = y + (h - d) / 2.0
        var lw: f64 = 0.0
        var buf: [u8; 24] = [0 as u8; 24]
        var n: usize = 0
        if (*k).permille >= 0 as i64 {
            n = percent_text((*k).permille, &buf)
            lw = kit.text_width(c, kit.ln(c, 13), 400, str { p: (&buf[0]) as *mut u8, n: n })
        }
        var gw: f64 = d
        if n > 0 { gw = d + kit.ln(c, 8) + lw }
        let gx: f64 = x + (w - gw) / 2.0
        if (*k).permille >= 0 as i64 {
            ring_draw(c, gx, ry, d, (*k).permille, ds_catalog_tok.accent(c), kit.with_alpha(ds_catalog_tok.muted(c), 90 as u32))
            kit.draw_label(c, gx + d + kit.ln(c, 8), y, h, kit.ln(c, 13), 400, fg, str { p: (&buf[0]) as *mut u8, n: n }, 0.0)
        } else {
            wave8.spinner_draw(c, gx, ry, d, render.ctx_time(c), ds_catalog_tok.accent(c))
        }
        return
    } else {
        painter.round_rect(z, x, y, w, h, r, kit.tokc(c, style.TOK_BUTTON))
        fg = ds_catalog_tok.disabled(c)
    }
    let lab: str = label_of(st)
    let tw: f64 = kit.text_width(c, kit.ln(c, 14), 600, lab)
    kit.draw_label(c, x + (w - tw) / 2.0, y, h, kit.ln(c, 14), 600, fg, lab, w)
}

fn ax_note(k: *mut Card, name: str) {
    var f: u32 = 0 as u32
    if (*k).foc { f = screenax.F_FOCUS }
    screenax.note(widget.KIND_CARD, 0 as u32, name, (*k).x, (*k).y, (*k).w, (*k).h, 0)
    if (*k).state == S_INSTALLING {
        screenax.note_join(widget.KIND_PROGRESS, f, "Installing", name, (*k).bx, (*k).by, (*k).bw, (*k).bh, (*k).permille)
        return
    }
    if (*k).state == S_UNAVAILABLE {
        screenax.note_join(widget.KIND_BUTTON, f | screenax.F_DISABLED, "Unavailable", name, (*k).bx, (*k).by, (*k).bw, (*k).bh, 0)
        return
    }
    screenax.note_join(widget.KIND_BUTTON, f, label_of((*k).state), name, (*k).bx, (*k).by, (*k).bw, (*k).bh, 0)
}

fn draw(k: *mut Card, c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, icon: i64, name: str, sub: str, meta: str,
    px: f64, py: f64) {
    let pad: f64 = ds_catalog_tok.pad(c)
    let tile: f64 = ds_catalog_tok.tile_size(c)
    (*k).x = x
    (*k).y = y
    (*k).w = w
    (*k).h = h
    (*k).bh = kit.button_height(c)
    (*k).bw = kit.ln(c, 104)
    if (*k).bw > w - pad * 2.0 { (*k).bw = w - pad * 2.0 }
    (*k).bx = x + pad
    (*k).by = y + h - pad - (*k).bh
    (*k).hov = hit(k, px, py)
    var lit: f64 = 0.0
    if (*k).hov != HIT_NONE { lit = 1.0 }
    kitapp.card_r_t(c, x, y, w, h, ds_catalog_tok.radius_card(c), lit, style.TOK_SURFACE_RAISED)
    let z: *mut painter.Painter = render.ctx_painter(c)
    let tx: f64 = x + pad
    let ty: f64 = y + pad
    painter.round_rect(z, tx, ty, tile, tile, ds_catalog_tok.radius_tile(c), ds_catalog_tok.accent_tint(c))
    let isz: f64 = tile / 2.0
    kit.sym(c, icon, tx + (tile - isz) / 2.0, ty + (tile - isz) / 2.0, isz, ds_catalog_tok.accent(c))
    let nx: f64 = tx + tile + ds_catalog_tok.gap(c)
    let room: f64 = x + w - pad - nx
    var rows: f64 = 2.0
    if meta.n > 0 { rows = 3.0 }
    let rh: f64 = tile / rows
    kit.draw_label(c, nx, ty, rh, kit.ln(c, 15), 700, ds_catalog_tok.text(c), name, room)
    kit.draw_label(c, nx, ty + rh, rh, kit.ln(c, 12), 400, ds_catalog_tok.muted(c), sub, room)
    if meta.n > 0 { kit.draw_label(c, nx, ty + rh * 2.0, rh, kit.ln(c, 12), 400, ds_catalog_tok.muted(c), meta, room) }
    draw_button(k, c)
    if (*k).foc && (*k).kbd {
        kit.focus_ring(c, (*k).bx, (*k).by, (*k).bw, (*k).bh, ds_catalog_tok.radius_item(c), style.TOK_SURFACE)
    }
    ax_note(k, name)
}

fn press(k: *mut Card, x: f64, y: f64) -> bool {
    let h: u32 = hit(k, x, y)
    (*k).down = h
    return h != HIT_NONE
}

fn release(k: *mut Card, x: f64, y: f64) -> u32 {
    let was: u32 = (*k).down
    (*k).down = HIT_NONE
    if was == HIT_NONE { return ACT_NONE }
    let now: u32 = hit(k, x, y)
    if now != was { return ACT_NONE }
    if now == HIT_BUTTON { return action_of((*k).state) }
    return ACT_CARD
}

fn click(k: *mut Card, x: f64, y: f64) -> u32 {
    press(k, x, y)
    return release(k, x, y)
}

fn key(k: *mut Card, code: u32, mods: u32) -> u32 {
    if !(*k).foc { return ACT_NONE }
    if code == editor.KEY_ENTER { return action_of((*k).state) }
    return ACT_NONE
}

fn text(k: *mut Card, cp: u32, mods: u32) -> u32 {
    if !(*k).foc { return ACT_NONE }
    if cp == 32 as u32 { return action_of((*k).state) }
    return ACT_NONE
}
