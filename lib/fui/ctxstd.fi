// SPDX-License-Identifier: MPL-2.0
// lib/fui/ctxstd.fi -- THE STANDARD ENTRIES (docs/CONTEXT-MENUS.md, roadmap
// r161): what every program's context menu has, written once.
//
// ========================================================= WHAT IS HERE
//
// Six FAMILIES of entries, each with its labels (English and German), icons,
// shortcuts and group, and a provider that puts them into a menu:
//
//   edit      Undo, Redo | Cut, Copy, Paste, Delete | Select all   (a text field)
//   list      Select all, Invert selection                          (a list, a table)
//   file      Open | Cut, Copy, Paste, Rename, Properties | Delete  (a file element,
//             with the tags "dir" / ".txt" so plugins add "Open with ...")
//   window    Restore, Move, Size, Minimize, Maximize | Close       (a title bar)
//   task      Pin / Unpin, | Close window                           (a taskbar entry)
//   proc      Go to details, Open file location | End task, End tree (a process list)
//
// WHAT THE PROGRAM DOES: it fills ONE `StdOps` per family it uses -- an `act`
// function that carries out an entry (`op` says which) and a `can` function
// that says whether the entry is switched off, hidden or ticked right now --
// registers the family (`std_register`), and hangs the family's provider on
// the node or the widget kind it belongs to:
//
//     ctxmenu.ctx_provider_kind(cm, widget.KIND_TEXTBOX, ctxstd.std_prov_edit, 0)
//     ctxmenu.ctx_provider_key(cm, key_of_the_list, ctxstd.std_prov_list, 0)
//
// The entries are ordinary actions of the registry (action.fi): they get the
// shortcut dispatch, the bus manifest and the a11y default action for free.
// Their ids are `edit-cut`, `file-delete`, `window-close` ... (a hyphen, so
// the bus name `notes.edit-cut` stays "<app>.<verb>").
//
// WHAT IT DOES NOT DO: the work itself. "Copy" in a text field is
// editor.editor_copy, "Copy" on a file is the file manager's business; this
// file only knows the NAME, the LOOK and the PLACE of the entry.
export {
    StdOps, StdSet, std_set_new, std_register, std_catalog_en, std_catalog_de,
    std_prov_edit, std_prov_list, std_prov_file, std_prov_window,
    std_prov_task, std_prov_proc, std_def_count, std_family_of, std_op_id,
    FAM_EDIT, FAM_LIST, FAM_FILE, FAM_WINDOW, FAM_TASK, FAM_PROC,
    CAN_OFF, CAN_HIDE, CAN_ON,
    OP_UNDO, OP_REDO, OP_CUT, OP_COPY, OP_PASTE, OP_DELETE, OP_SELECT_ALL,
    OP_LIST_ALL, OP_LIST_INVERT,
    OP_OPEN, OP_FILE_CUT, OP_FILE_COPY, OP_FILE_PASTE, OP_RENAME,
    OP_FILE_DELETE, OP_PROPERTIES,
    OP_RESTORE, OP_MOVE, OP_SIZE, OP_MINIMIZE, OP_MAXIMIZE, OP_CLOSE,
    OP_PIN, OP_UNPIN, OP_CLOSE_WINDOW,
    OP_END_TASK, OP_END_TREE, OP_DETAILS, OP_LOCATION,
}

import fui.action
import fui.ctxmenu
import fui.lucide

// WHAT `can` ANSWERS (bits; 0 = enabled, visible, not ticked).
const CAN_OFF: u32 = 1 // greyed out
const CAN_HIDE: u32 = 2 // not in the menu at all
const CAN_ON: u32 = 4 // ticked

const FAM_EDIT: u32 = 1
const FAM_LIST: u32 = 2
const FAM_FILE: u32 = 3
const FAM_WINDOW: u32 = 4
const FAM_TASK: u32 = 5
const FAM_PROC: u32 = 6

const OP_UNDO: u32 = 1
const OP_REDO: u32 = 2
const OP_CUT: u32 = 3
const OP_COPY: u32 = 4
const OP_PASTE: u32 = 5
const OP_DELETE: u32 = 6
const OP_SELECT_ALL: u32 = 7
const OP_LIST_ALL: u32 = 20
const OP_LIST_INVERT: u32 = 21
const OP_OPEN: u32 = 30
const OP_FILE_CUT: u32 = 31
const OP_FILE_COPY: u32 = 32
const OP_FILE_PASTE: u32 = 33
const OP_RENAME: u32 = 34
const OP_FILE_DELETE: u32 = 35
const OP_PROPERTIES: u32 = 36
const OP_RESTORE: u32 = 50
const OP_MOVE: u32 = 51
const OP_SIZE: u32 = 52
const OP_MINIMIZE: u32 = 53
const OP_MAXIMIZE: u32 = 54
const OP_CLOSE: u32 = 55
const OP_PIN: u32 = 60
const OP_UNPIN: u32 = 61
const OP_CLOSE_WINDOW: u32 = 62
const OP_END_TASK: u32 = 70
const OP_END_TREE: u32 = 71
const OP_DETAILS: u32 = 72
const OP_LOCATION: u32 = 73

// ONE ENTRY'S DEFINITION: id, catalog key, the English and German text, the
// Lucide icon, shortcut, group, whether it is dangerous (red, last) or just
// last (Close).
struct Def {
    op: u32,
    id: str,
    key: str,
    icon: str,
    sk: u32,
    mods: u32,
    group: u32,
    danger: u32, // 1 = red and critical, 2 = last only
}

fn def_of(op: u32) -> Def {
    var d: Def = Def { op: op, id: "", key: "", icon: "", sk: 0 as u32,
        mods: 0 as u32, group: action.G_EDIT, danger: 0 as u32 }
    let ctrl: u32 = action.MOD_CTRL
    if op == OP_UNDO {
        d = Def { op: op, id: "edit-undo", key: "ctx.undo",
            icon: "undo-2", sk: 90 as u32, mods: ctrl, group: action.G_PRIMARY, danger: 0 as u32 }
    } else if op == OP_REDO {
        d = Def { op: op, id: "edit-redo", key: "ctx.redo",
            icon: "redo-2", sk: 89 as u32, mods: ctrl, group: action.G_PRIMARY, danger: 0 as u32 }
    } else if op == OP_CUT {
        d = Def { op: op, id: "edit-cut", key: "ctx.cut",
            icon: "scissors", sk: 88 as u32, mods: ctrl, group: action.G_EDIT, danger: 0 as u32 }
    } else if op == OP_COPY {
        d = Def { op: op, id: "edit-copy", key: "ctx.copy",
            icon: "copy", sk: 67 as u32, mods: ctrl, group: action.G_EDIT, danger: 0 as u32 }
    } else if op == OP_PASTE {
        d = Def { op: op, id: "edit-paste", key: "ctx.paste",
            icon: "clipboard-paste", sk: 86 as u32, mods: ctrl, group: action.G_EDIT, danger: 0 as u32 }
    } else if op == OP_DELETE {
        d = Def { op: op, id: "edit-delete", key: "ctx.delete",
            icon: "trash", sk: action.SK_DELETE, mods: 0 as u32, group: action.G_EDIT, danger: 0 as u32 }
    } else if op == OP_SELECT_ALL {
        d = Def { op: op, id: "edit-selectall", key: "ctx.selectall",
            icon: "text-select", sk: 65 as u32, mods: ctrl, group: action.G_SELECTION, danger: 0 as u32 }
    } else if op == OP_LIST_ALL {
        d = Def { op: op, id: "list-selectall", key: "ctx.selectall",
            icon: "list-checks", sk: 65 as u32, mods: ctrl, group: action.G_SELECTION, danger: 0 as u32 }
    } else if op == OP_LIST_INVERT {
        d = Def { op: op, id: "list-invert", key: "ctx.invert",
            icon: "", sk: 0 as u32, mods: 0 as u32, group: action.G_SELECTION, danger: 0 as u32 }
    } else if op == OP_OPEN {
        d = Def { op: op, id: "file-open", key: "ctx.open",
            icon: "folder-open", sk: action.SK_ENTER, mods: 0 as u32, group: action.G_PRIMARY, danger: 0 as u32 }
    } else if op == OP_FILE_CUT {
        d = Def { op: op, id: "file-cut", key: "ctx.cut",
            icon: "scissors", sk: 88 as u32, mods: ctrl, group: action.G_EDIT, danger: 0 as u32 }
    } else if op == OP_FILE_COPY {
        d = Def { op: op, id: "file-copy", key: "ctx.copy",
            icon: "copy", sk: 67 as u32, mods: ctrl, group: action.G_EDIT, danger: 0 as u32 }
    } else if op == OP_FILE_PASTE {
        d = Def { op: op, id: "file-paste", key: "ctx.paste",
            icon: "clipboard-paste", sk: 86 as u32, mods: ctrl, group: action.G_EDIT, danger: 0 as u32 }
    } else if op == OP_RENAME {
        d = Def { op: op, id: "file-rename", key: "ctx.rename",
            icon: "pencil", sk: action.SK_F1 + (1 as u32), mods: 0 as u32, group: action.G_EDIT, danger: 0 as u32 }
    } else if op == OP_FILE_DELETE {
        d = Def { op: op, id: "file-delete", key: "ctx.delete",
            icon: "trash", sk: action.SK_DELETE, mods: 0 as u32, group: action.G_DANGER, danger: 1 as u32 }
    } else if op == OP_PROPERTIES {
        d = Def { op: op, id: "file-properties", key: "ctx.properties",
            icon: "info", sk: action.SK_ENTER, mods: action.MOD_ALT, group: action.G_VIEW, danger: 0 as u32 }
    } else if op == OP_RESTORE {
        d = Def { op: op, id: "window-restore", key: "ctx.restore",
            icon: "minimize-2", sk: 0 as u32, mods: 0 as u32, group: action.G_PRIMARY, danger: 0 as u32 }
    } else if op == OP_MOVE {
        d = Def { op: op, id: "window-move", key: "ctx.move",
            icon: "move", sk: 0 as u32, mods: 0 as u32, group: action.G_PRIMARY, danger: 0 as u32 }
    } else if op == OP_SIZE {
        d = Def { op: op, id: "window-size", key: "ctx.size",
            icon: "move-diagonal-2", sk: 0 as u32, mods: 0 as u32, group: action.G_PRIMARY, danger: 0 as u32 }
    } else if op == OP_MINIMIZE {
        d = Def { op: op, id: "window-minimize", key: "ctx.minimize",
            icon: "minus", sk: 0 as u32, mods: 0 as u32, group: action.G_PRIMARY, danger: 0 as u32 }
    } else if op == OP_MAXIMIZE {
        d = Def { op: op, id: "window-maximize", key: "ctx.maximize",
            icon: "square", sk: 0 as u32, mods: 0 as u32, group: action.G_PRIMARY, danger: 0 as u32 }
    } else if op == OP_CLOSE {
        d = Def { op: op, id: "window-close", key: "ctx.close",
            icon: "x", sk: action.SK_F1 + (3 as u32), mods: action.MOD_ALT, group: action.G_DANGER, danger: 2 as u32 }
    } else if op == OP_PIN {
        d = Def { op: op, id: "task-pin", key: "ctx.pin",
            icon: "pin", sk: 0 as u32, mods: 0 as u32, group: action.G_PRIMARY, danger: 0 as u32 }
    } else if op == OP_UNPIN {
        d = Def { op: op, id: "task-unpin", key: "ctx.unpin",
            icon: "pin-off", sk: 0 as u32, mods: 0 as u32, group: action.G_PRIMARY, danger: 0 as u32 }
    } else if op == OP_CLOSE_WINDOW {
        d = Def { op: op, id: "task-close", key: "ctx.closewindow",
            icon: "x", sk: 0 as u32, mods: 0 as u32, group: action.G_DANGER, danger: 2 as u32 }
    } else if op == OP_END_TASK {
        d = Def { op: op, id: "proc-end", key: "ctx.endtask",
            icon: "circle-x", sk: action.SK_DELETE, mods: 0 as u32, group: action.G_DANGER, danger: 1 as u32 }
    } else if op == OP_END_TREE {
        d = Def { op: op, id: "proc-endtree", key: "ctx.endtree",
            icon: "circle-x", sk: 0 as u32, mods: 0 as u32, group: action.G_DANGER, danger: 1 as u32 }
    } else if op == OP_DETAILS {
        d = Def { op: op, id: "proc-details", key: "ctx.details",
            icon: "info", sk: 0 as u32, mods: 0 as u32, group: action.G_PRIMARY, danger: 0 as u32 }
    } else if op == OP_LOCATION {
        d = Def { op: op, id: "proc-location", key: "ctx.location",
            icon: "folder-open", sk: 0 as u32, mods: 0 as u32, group: action.G_PRIMARY, danger: 0 as u32 }
    }
    return d
}

// The operations of a family, in the order of the menu; 0 ends the list.
fn family_op(fam: u32, k: usize) -> u32 {
    if fam == FAM_EDIT {
        if k == 0 { return OP_UNDO }
        if k == 1 { return OP_REDO }
        if k == 2 { return OP_CUT }
        if k == 3 { return OP_COPY }
        if k == 4 { return OP_PASTE }
        if k == 5 { return OP_DELETE }
        if k == 6 { return OP_SELECT_ALL }
    } else if fam == FAM_LIST {
        if k == 0 { return OP_LIST_ALL }
        if k == 1 { return OP_LIST_INVERT }
    } else if fam == FAM_FILE {
        if k == 0 { return OP_OPEN }
        if k == 1 { return OP_FILE_CUT }
        if k == 2 { return OP_FILE_COPY }
        if k == 3 { return OP_FILE_PASTE }
        if k == 4 { return OP_RENAME }
        if k == 5 { return OP_PROPERTIES }
        if k == 6 { return OP_FILE_DELETE }
    } else if fam == FAM_WINDOW {
        if k == 0 { return OP_RESTORE }
        if k == 1 { return OP_MOVE }
        if k == 2 { return OP_SIZE }
        if k == 3 { return OP_MINIMIZE }
        if k == 4 { return OP_MAXIMIZE }
        if k == 5 { return OP_CLOSE }
    } else if fam == FAM_TASK {
        if k == 0 { return OP_PIN }
        if k == 1 { return OP_UNPIN }
        if k == 2 { return OP_CLOSE_WINDOW }
    } else if fam == FAM_PROC {
        if k == 0 { return OP_DETAILS }
        if k == 1 { return OP_LOCATION }
        if k == 2 { return OP_END_TASK }
        if k == 3 { return OP_END_TREE }
    }
    return 0 as u32
}

// How many entries there are in all (for the catalogs).
fn std_def_count() -> usize {
    var n: usize = 0
    var f: u32 = 1 as u32
    while f <= FAM_PROC {
        var k: usize = 0
        while family_op(f, k) != 0 as u32 {
            n = n + 1
            k = k + 1
        }
        f = f + (1 as u32)
    }
    return n
}

// The family an op belongs to (0 = none) and its action id.
fn std_family_of(op: u32) -> u32 {
    var f: u32 = 1 as u32
    while f <= FAM_PROC {
        var k: usize = 0
        while family_op(f, k) != 0 as u32 {
            if family_op(f, k) == op { return f }
            k = k + 1
        }
        f = f + (1 as u32)
    }
    return 0 as u32
}

fn std_op_id(op: u32) -> str {
    return def_of(op).id
}

// ======================================================= THE PROGRAM'S SAY

// What a program tells about one family: `act(ud, op, cx)` carries an entry
// out, `can(ud, op, cx)` answers CAN_* bits, `tag(ud, cx)` names what the
// request is about for plugin entries ("dir", ".txt") -- or "" for none.
// `ud` is the program's pointer.
struct StdOps {
    ud: u64,
    act: fn(u64, u32, *mut action.ActCtx),
    can: fn(u64, u32, *mut action.ActCtx) -> u32,
    tag: fn(u64, *mut action.ActCtx) -> str,
}

fn op_act_none(ud: u64, op: u32, cx: *mut action.ActCtx) {
}

fn op_can_none(ud: u64, op: u32, cx: *mut action.ActCtx) -> u32 { return 0 as u32 }

fn op_tag_none(ud: u64, cx: *mut action.ActCtx) -> str { return "" }

fn ops_blank() -> StdOps {
    return StdOps { ud: 0, act: op_act_none, can: op_can_none, tag: op_tag_none }
}

struct Bind {
    ops: u64, // *mut StdOps (inside the StdSet)
    op: u32,
}

// The bindings of every registered family. It must stay where it is once
// entries were registered (the actions point into it).
struct StdSet {
    ops: [StdOps; 8],
    binds: [Bind; 40],
    nb: usize,
}

fn std_set_new() -> StdSet {
    return StdSet { ops: [ops_blank(); 8], binds: [Bind { ops: 0, op: 0 as u32 }; 40], nb: 0 }
}

fn bind_ops(b: u64) -> *mut StdOps {
    return (*(b as *mut Bind)).ops as *mut StdOps
}

fn std_run(ud: u64, cx: *mut action.ActCtx) {
    let b: *mut Bind = ud as *mut Bind
    let o: *mut StdOps = (*b).ops as *mut StdOps
    let f: fn(u64, u32, *mut action.ActCtx) = (*o).act
    f((*o).ud, (*b).op, cx)
}

fn std_can_bits(ud: u64, cx: *mut action.ActCtx) -> u32 {
    let b: *mut Bind = ud as *mut Bind
    let o: *mut StdOps = (*b).ops as *mut StdOps
    let f: fn(u64, u32, *mut action.ActCtx) -> u32 = (*o).can
    return f((*o).ud, (*b).op, cx)
}

fn std_enabled(ud: u64, cx: *mut action.ActCtx) -> bool {
    return (std_can_bits(ud, cx) & CAN_OFF) == 0 as u32
}

fn std_visible(ud: u64, cx: *mut action.ActCtx) -> bool {
    return (std_can_bits(ud, cx) & CAN_HIDE) == 0 as u32
}

fn std_checked(ud: u64, cx: *mut action.ActCtx) -> u32 {
    if (std_can_bits(ud, cx) & CAN_ON) != 0 as u32 { return action.CHK_ON }
    return action.CHK_NONE
}

// REGISTER a family: its actions go into the registry `r` (label keys, icons,
// shortcuts, groups, levels), bound to `ops`. `set` keeps the bindings.
// false when the set or the registry is full.
fn std_register(r: *mut action.Actions, set: *mut StdSet, fam: u32, ops: StdOps) -> bool {
    if fam == 0 as u32 || fam >= 8 as u32 { return false }
    (*set).ops[fam as usize] = ops
    var k: usize = 0
    while family_op(fam, k) != 0 as u32 {
        let op: u32 = family_op(fam, k)
        if (*set).nb >= 40 { return false }
        let d: Def = def_of(op)
        let bi: usize = (*set).nb
        (*set).nb = bi + 1
        (*set).binds[bi] = Bind { ops: (&(*set).ops[fam as usize]) as u64, op: op }
        let i: usize = action.act_add(r, d.id, d.key, std_run, (&(*set).binds[bi]) as u64)
        if i == action.ACT_NONE { return false }
        action.act_set_enabled(r, i, std_enabled)
        action.act_set_visible(r, i, std_visible)
        if op == OP_PIN || op == OP_UNPIN {
            // nothing: shown or hidden by `can`
        }
        action.act_set_group(r, i, d.group)
        if d.icon.n > 0 {
            action.act_set_icon(r, i, lucide.lucide_find(d.icon.p as u64, d.icon.n))
        }
        if d.sk != 0 as u32 {
            action.act_set_shortcut(r, i, d.sk, d.mods)
        }
        if d.danger == 1 as u32 {
            action.act_danger(r, i)
        } else if d.danger == 2 as u32 {
            action.act_set_group(r, i, action.G_DANGER)
        }
        k = k + 1
    }
    return true
}

// The built-in catalogs: key -> text, English and German. The texts are in
// lib/fui/locale/ctx.en.opmsg and ctx.de.opmsg (`key = text`, one per line);
// they are embedded in the program, and the catalog points into them.
const EN_TEXT: str = __include_str("locale/ctx.en.opmsg")
const DE_TEXT: str = __include_str("locale/ctx.de.opmsg")

fn std_catalog_en(c: *mut action.Catalog) {
    let n: usize = action.catalog_parse(c, EN_TEXT)
}
fn std_catalog_de(c: *mut action.Catalog) {
    let n: usize = action.catalog_parse(c, DE_TEXT)
}

// ============================================================ THE PROVIDERS

// Add every operation of `fam` to the menu. ud is unused.
fn add_family(pc: *mut ctxmenu.ProviderCtx, fam: u32) {
    let r: *mut action.Actions = ctxmenu.pc_actions(pc)
    var k: usize = 0
    while family_op(fam, k) != 0 as u32 {
        let i: usize = action.act_find(r, def_of(family_op(fam, k)).id)
        if i != action.ACT_NONE {
            let e: usize = ctxmenu.pc_add(pc, i)
        }
        k = k + 1
    }
}

// The tag a family's `tag` hook names, for plugin entries.
fn tag_family(pc: *mut ctxmenu.ProviderCtx, fam: u32) {
    let r: *mut action.Actions = ctxmenu.pc_actions(pc)
    let i: usize = action.act_find(r, def_of(family_op(fam, 0)).id)
    if i == action.ACT_NONE { return }
    // the bind of the family's first action leads to its StdOps
    let b: *mut Bind = action_ud(r, i) as *mut Bind
    if b as u64 == 0 { return }
    let o: *mut StdOps = (*b).ops as *mut StdOps
    let f: fn(u64, *mut action.ActCtx) -> str = (*o).tag
    let t: str = f((*o).ud, ctxmenu.pc_actx(pc))
    if t.n > 0 {
        ctxmenu.pc_tag(pc, t)
    }
}

fn action_ud(r: *mut action.Actions, i: usize) -> u64 {
    return action.act_ud(r, i)
}

// A TEXT FIELD: Undo, Redo | Cut, Copy, Paste, Delete | Select all.
fn std_prov_edit(ud: u64, pc: *mut ctxmenu.ProviderCtx) {
    add_family(pc, FAM_EDIT)
    tag_family(pc, FAM_EDIT)
}

// A LIST OR TABLE: Select all, Invert selection.
fn std_prov_list(ud: u64, pc: *mut ctxmenu.ProviderCtx) {
    add_family(pc, FAM_LIST)
    tag_family(pc, FAM_LIST)
}

// A FILE ELEMENT: Open | Cut, Copy, Paste, Rename | Properties | Delete, and
// the tag its `tag` hook names ("dir", ".txt") so plugins can add "Open with".
fn std_prov_file(ud: u64, pc: *mut ctxmenu.ProviderCtx) {
    add_family(pc, FAM_FILE)
    tag_family(pc, FAM_FILE)
}

// A TITLE BAR: Restore, Move, Size, Minimize, Maximize | Close.
fn std_prov_window(ud: u64, pc: *mut ctxmenu.ProviderCtx) {
    add_family(pc, FAM_WINDOW)
    tag_family(pc, FAM_WINDOW)
}

// A TASKBAR ENTRY: Pin / Unpin | Close window.
fn std_prov_task(ud: u64, pc: *mut ctxmenu.ProviderCtx) {
    add_family(pc, FAM_TASK)
    tag_family(pc, FAM_TASK)
}

// A PROCESS LIST ROW: Go to details, Open file location | End task, End tree.
fn std_prov_proc(ud: u64, pc: *mut ctxmenu.ProviderCtx) {
    add_family(pc, FAM_PROC)
    tag_family(pc, FAM_PROC)
}
