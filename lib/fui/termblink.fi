import fui.termwstate

export { blink_tick, blink_wait_ms }

const BLINK_US: i64 = 530000
const US_PER_MS: i64 = 1000
const NO_WAIT: i64 = 0 - 1

fn active(tw: *mut termwstate.TermWidget) -> bool {
    return (*tw).blink && (*tw).focus && !(*tw).closed
}

fn blink_tick(tw: *mut termwstate.TermWidget, now_us: i64) -> bool {
    if !active(tw) { return false }
    if (*tw).blink_us == 0 {
        (*tw).blink_us = now_us
        return false
    }
    if now_us - (*tw).blink_us < BLINK_US { return false }
    (*tw).blink_us = now_us
    (*tw).fr.cursor_on = !(*tw).fr.cursor_on
    return true
}

fn blink_wait_ms(tw: *mut termwstate.TermWidget, now_us: i64) -> i64 {
    if !active(tw) { return NO_WAIT }
    if (*tw).blink_us == 0 { return BLINK_US / US_PER_MS }
    var left: i64 = (BLINK_US - (now_us - (*tw).blink_us)) / US_PER_MS
    if left < 1 { left = 1 }
    return left
}
