// SPDX-License-Identifier: MPL-2.0
import std.rt

export {
    SLOTS, SLOT_CAP, MODE_NONE, MODE_POLITE, MODE_ASSERTIVE,
    ring_alloc, ring_free, ring_push, ring_seq, ring_get, ring_oldest,
}

const SLOTS: usize = 8
const SLOT_CAP: usize = 160
const HEADER: usize = 16
const META: usize = 8
const MODE_NONE: u32 = 0
const MODE_POLITE: u32 = 1
const MODE_ASSERTIVE: u32 = 2

fn ring_bytes() -> usize { return HEADER + SLOTS * META + SLOTS * SLOT_CAP }

fn ring_alloc() -> u64 {
    let p: u64 = rt.heap_alloc(ring_bytes())
    rt.mem_set(p, 0, ring_bytes())
    return p
}

fn ring_free(p: u64) {
    if p != 0 { rt.heap_free(p, ring_bytes()) }
}

fn ring_seq(p: u64) -> u64 {
    if p == 0 { return 0 }
    return *(p as *mut u64)
}

fn ring_oldest(p: u64) -> u64 {
    let s: u64 = ring_seq(p)
    if s > SLOTS as u64 { return s - (SLOTS as u64) + 1 }
    return 1
}

fn meta_at(p: u64, slot: usize) -> u64 { return p + (HEADER + slot * META) as u64 }

fn text_at(p: u64, slot: usize) -> u64 { return p + (HEADER + SLOTS * META + slot * SLOT_CAP) as u64 }

fn cut_len(s: str) -> usize {
    var n: usize = s.n
    if n > SLOT_CAP {
        n = SLOT_CAP
        while n > 0 {
            let b: u8 = rt.ld8(s.p as u64, n)
            if b >= 128 as u8 && b < 192 as u8 { n = n - 1 } else { break }
        }
    }
    return n
}

fn ring_push(p: u64, text: str, mode: u32) -> bool {
    if p == 0 || text.n == 0 || mode == MODE_NONE { return false }
    let seq: u64 = ring_seq(p) + 1
    let slot: usize = (seq % (SLOTS as u64)) as usize
    let n: usize = cut_len(text)
    var i: usize = 0
    let dst: u64 = text_at(p, slot)
    while i < n {
        rt.st8(dst, i, rt.ld8(text.p as u64, i))
        i = i + 1
    }
    let m: u64 = meta_at(p, slot)
    rt.st32(m, 0, n as u32)
    rt.st32(m, 1, mode)
    *(p as *mut u64) = seq
    return true
}

fn ring_get(p: u64, seq: u64, out: u64, cap: usize, mode: *mut u32) -> usize {
    if p == 0 || seq == 0 || seq > ring_seq(p) || seq < ring_oldest(p) { return 0 }
    let slot: usize = (seq % (SLOTS as u64)) as usize
    let m: u64 = meta_at(p, slot)
    var n: usize = rt.ld32(m, 0) as usize
    if n > cap { n = cap }
    let src: u64 = text_at(p, slot)
    var i: usize = 0
    while i < n {
        rt.st8(out, i, rt.ld8(src, i))
        i = i + 1
    }
    *mode = rt.ld32(m, 1)
    return n
}
