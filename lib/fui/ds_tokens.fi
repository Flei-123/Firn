import fui.theme
import fui.ds_tokens_prim
import fui.ds_tokens_color
import fui.ds_tokens_type
import fui.ds_tokens_motion

export {
    C_BASE, C_SURFACE, C_RAISED, C_BUTTON, C_BUTTON_HOVER, C_BUTTON_ACTIVE,
    C_FIELD, C_FIELD_FOCUS, C_BORDER, C_SEPARATOR, C_TEXT, C_TEXT_MUTED,
    C_TEXT_DISABLED, C_TEXT_ON_ACCENT, C_ACCENT, C_SELECTION, C_SELECTION_TEXT, C_ERROR,
    C_WARNING, C_SUCCESS, C_ACCENT_HOVER, C_ACCENT_ACTIVE, C_ACCENT_TEXT, C_FOCUS_RING,
    C_CARD, C_CARD_BORDER, C_INFO, C_INFO_BG, C_SUCCESS_BG, C_WARNING_BG,
    C_ERROR_BG, C_SUBTLE_HOVER, C_SUBTLE_ACTIVE, C_SCRIM, C_COUNT, C_ALPHA_FIRST,
    SP_NONE, SP_XXS, SP_XS, SP_SNUDGE, SP_S, SP_MNUDGE,
    SP_M, SP_L, SP_XL, SP_XXL, SP_XXXL, SP_HUGE,
    SP_HUGER, SP_MAX, RAD_NONE, RAD_SMALL, RAD_CONTROL, RAD_FIELD,
    RAD_CARD, RAD_FLYOUT, RAD_WINDOW, RAD_PILL, RAD_COUNT,
    M_PRESS, M_HOVER, M_FOCUS, M_FADE, M_EXPAND, M_COLLAPSE, M_FLYOUT_OPEN, M_FLYOUT_CLOSE, M_DIALOG_OPEN, M_DIALOG_CLOSE, M_SLIDE, M_PAGE, M_TOAST_IN, M_TOAST_OUT, M_COUNT,
    T_CAPTION, T_BODY, T_BODY_LARGE, T_SUBTITLE, T_TITLE, T_TITLE_LARGE, T_BODY_STRONG, T_DISPLAY, T_COUNT,
    TypeTok, ElevTok, MotionTok,
    color, paint, space, radius, type_of, elevation, motion, role_count,
    on_fill, readable, apply, set_accent, accent_count, accent_color,
}

const C_BASE: usize = ds_tokens_color.C_BASE
const C_SURFACE: usize = ds_tokens_color.C_SURFACE
const C_RAISED: usize = ds_tokens_color.C_RAISED
const C_BUTTON: usize = ds_tokens_color.C_BUTTON
const C_BUTTON_HOVER: usize = ds_tokens_color.C_BUTTON_HOVER
const C_BUTTON_ACTIVE: usize = ds_tokens_color.C_BUTTON_ACTIVE
const C_FIELD: usize = ds_tokens_color.C_FIELD
const C_FIELD_FOCUS: usize = ds_tokens_color.C_FIELD_FOCUS
const C_BORDER: usize = ds_tokens_color.C_BORDER
const C_SEPARATOR: usize = ds_tokens_color.C_SEPARATOR
const C_TEXT: usize = ds_tokens_color.C_TEXT
const C_TEXT_MUTED: usize = ds_tokens_color.C_TEXT_MUTED
const C_TEXT_DISABLED: usize = ds_tokens_color.C_TEXT_DISABLED
const C_TEXT_ON_ACCENT: usize = ds_tokens_color.C_TEXT_ON_ACCENT
const C_ACCENT: usize = ds_tokens_color.C_ACCENT
const C_SELECTION: usize = ds_tokens_color.C_SELECTION
const C_SELECTION_TEXT: usize = ds_tokens_color.C_SELECTION_TEXT
const C_ERROR: usize = ds_tokens_color.C_ERROR
const C_WARNING: usize = ds_tokens_color.C_WARNING
const C_SUCCESS: usize = ds_tokens_color.C_SUCCESS
const C_ACCENT_HOVER: usize = 20
const C_ACCENT_ACTIVE: usize = 21
const C_ACCENT_TEXT: usize = 22
const C_FOCUS_RING: usize = 23
const C_CARD: usize = 24
const C_CARD_BORDER: usize = 25
const C_INFO: usize = 26
const C_INFO_BG: usize = 27
const C_SUCCESS_BG: usize = 28
const C_WARNING_BG: usize = 29
const C_ERROR_BG: usize = 30
const C_SUBTLE_HOVER: usize = 31
const C_SUBTLE_ACTIVE: usize = 32
const C_SCRIM: usize = 33
const C_COUNT: usize = 34
const C_ALPHA_FIRST: usize = C_SUBTLE_HOVER

const SP_NONE: usize = 0
const SP_XXS: usize = 1
const SP_XS: usize = 2
const SP_SNUDGE: usize = 3
const SP_S: usize = 4
const SP_MNUDGE: usize = 5
const SP_M: usize = 6
const SP_L: usize = 7
const SP_XL: usize = 8
const SP_XXL: usize = 9
const SP_XXXL: usize = 10
const SP_HUGE: usize = 11
const SP_HUGER: usize = 12
const SP_MAX: usize = 13
const RAD_NONE: usize = 0
const RAD_SMALL: usize = 1
const RAD_CONTROL: usize = 2
const RAD_FIELD: usize = 3
const RAD_CARD: usize = 4
const RAD_FLYOUT: usize = 5
const RAD_WINDOW: usize = 6
const RAD_PILL: usize = 7
const RAD_COUNT: usize = 8

const M_PRESS: usize = ds_tokens_motion.M_PRESS
const M_HOVER: usize = ds_tokens_motion.M_HOVER
const M_FOCUS: usize = ds_tokens_motion.M_FOCUS
const M_FADE: usize = ds_tokens_motion.M_FADE
const M_EXPAND: usize = ds_tokens_motion.M_EXPAND
const M_COLLAPSE: usize = ds_tokens_motion.M_COLLAPSE
const M_FLYOUT_OPEN: usize = ds_tokens_motion.M_FLYOUT_OPEN
const M_FLYOUT_CLOSE: usize = ds_tokens_motion.M_FLYOUT_CLOSE
const M_DIALOG_OPEN: usize = ds_tokens_motion.M_DIALOG_OPEN
const M_DIALOG_CLOSE: usize = ds_tokens_motion.M_DIALOG_CLOSE
const M_SLIDE: usize = ds_tokens_motion.M_SLIDE
const M_PAGE: usize = ds_tokens_motion.M_PAGE
const M_TOAST_IN: usize = ds_tokens_motion.M_TOAST_IN
const M_TOAST_OUT: usize = ds_tokens_motion.M_TOAST_OUT
const M_COUNT: usize = ds_tokens_motion.M_COUNT
const T_CAPTION: usize = ds_tokens_type.T_CAPTION
const T_BODY: usize = ds_tokens_type.T_BODY
const T_BODY_LARGE: usize = ds_tokens_type.T_BODY_LARGE
const T_SUBTITLE: usize = ds_tokens_type.T_SUBTITLE
const T_TITLE: usize = ds_tokens_type.T_TITLE
const T_TITLE_LARGE: usize = ds_tokens_type.T_TITLE_LARGE
const T_BODY_STRONG: usize = ds_tokens_type.T_BODY_STRONG
const T_DISPLAY: usize = ds_tokens_type.T_DISPLAY
const T_COUNT: usize = ds_tokens_type.T_COUNT

struct TypeTok {
    size: usize,
    line: usize,
    weight: usize,
}

struct ElevTok {
    dy: usize,
    blur: usize,
    alpha: usize,
    ambient_blur: usize,
    ambient_alpha: usize,
}

struct MotionTok {
    ms: usize,
    ease: usize,
    x1: usize,
    y1: usize,
    x2: usize,
    y2: usize,
}

#[no_gc]
fn role_count() -> usize {
    return C_COUNT
}

#[no_gc]
fn on_fill(bg: u32) -> u32 {
    if theme.contrast(bg, 0xFFFFFF as u32) >= theme.contrast(bg, 0 as u32) {
        return 0xFFFFFF as u32
    }
    return 0 as u32
}

#[no_gc]
fn readable(fg: u32, bg: u32, toward: u32) -> u32 {
    var c: u32 = fg
    var t: usize = 0
    while theme.contrast(c, bg) < 4.5 && t < 1000 {
        t = t + 50
        c = theme.mix(fg, toward, t)
    }
    return c
}

#[no_gc]
fn tint(m: *mut theme.Theme, status: u32) -> u32 {
    let f: *mut theme.Colors = theme.theme_colors(m)
    return theme.mix((*f).surface_raised, status, 100)
}

#[no_gc]
fn derived(m: *mut theme.Theme, role: usize) -> u32 {
    let f: *mut theme.Colors = theme.theme_colors(m)
    let dark: bool = (*f).dark
    if role == C_ACCENT_HOVER {
        if dark { return theme.mix((*f).accent, 0xFFFFFF as u32, 100) }
        return theme.mix((*f).accent, 0 as u32, 100)
    }
    if role == C_ACCENT_ACTIVE {
        if dark { return theme.mix((*f).accent, 0xFFFFFF as u32, 180) }
        return theme.mix((*f).accent, 0 as u32, 180)
    }
    if role == C_ACCENT_TEXT || role == C_INFO {
        if dark { return readable((*f).accent, (*f).surface_raised, (*f).text) }
        return readable((*f).accent, (*f).base, (*f).text)
    }
    if role == C_FOCUS_RING { return (*f).text }
    if role == C_CARD { return (*f).surface_raised }
    if role == C_CARD_BORDER { return (*f).separator }
    if role == C_INFO_BG { return tint(m, (*f).accent) }
    if role == C_SUCCESS_BG { return tint(m, (*f).success) }
    if role == C_WARNING_BG { return tint(m, (*f).warning) }
    if role == C_ERROR_BG { return tint(m, (*f).err_col) }
    if role == C_SUBTLE_HOVER {
        if dark { return 0x0FFFFFFF as u32 }
        return 0x0D000000 as u32
    }
    if role == C_SUBTLE_ACTIVE {
        if dark { return 0x0AFFFFFF as u32 }
        return 0x08000000 as u32
    }
    return 0x4D000000 as u32
}

#[no_gc]
fn color(m: *mut theme.Theme, role: usize) -> u32 {
    let f: *mut theme.Colors = theme.theme_colors(m)
    if role == C_BASE { return (*f).base }
    if role == C_SURFACE { return (*f).surface }
    if role == C_RAISED { return (*f).surface_raised }
    if role == C_BUTTON { return (*f).button }
    if role == C_BUTTON_HOVER { return (*f).button_hover }
    if role == C_BUTTON_ACTIVE { return (*f).button_active }
    if role == C_FIELD { return (*f).field }
    if role == C_FIELD_FOCUS { return (*f).field_focus }
    if role == C_BORDER { return (*f).border_col }
    if role == C_SEPARATOR { return (*f).separator }
    if role == C_TEXT { return (*f).text }
    if role == C_TEXT_MUTED { return (*f).text_muted }
    if role == C_TEXT_DISABLED { return (*f).text_disabled }
    if role == C_TEXT_ON_ACCENT { return (*f).text_on_accent }
    if role == C_ACCENT { return (*f).accent }
    if role == C_SELECTION { return (*f).selection }
    if role == C_SELECTION_TEXT { return (*f).selection_text }
    if role == C_ERROR { return (*f).err_col }
    if role == C_WARNING { return (*f).warning }
    if role == C_SUCCESS { return (*f).success }
    return derived(m, role)
}

#[no_gc]
fn paint(m: *mut theme.Theme, role: usize) -> u32 {
    let c: u32 = color(m, role)
    if role >= C_ALPHA_FIRST { return c }
    return theme.opaque(c)
}

#[no_gc]
fn space(m: *mut theme.Theme, n: usize) -> usize {
    return theme.theme_px(m, ds_tokens_prim.space_px(n))
}

#[no_gc]
fn radius(m: *mut theme.Theme, role: usize) -> usize {
    let s: *mut theme.Shape = theme.theme_shape(m)
    if role == RAD_NONE { return 0 }
    if role == RAD_PILL { return ds_tokens_prim.radius_px(ds_tokens_prim.R_PILL) }
    if role == RAD_SMALL { return theme.theme_px(m, ds_tokens_prim.radius_px(ds_tokens_prim.R_XS)) }
    if role == RAD_CONTROL { return theme.theme_px(m, (*s).r_button) }
    if role == RAD_FIELD { return theme.theme_px(m, (*s).r_field) }
    if role == RAD_WINDOW { return theme.theme_px(m, (*s).r_window) }
    return theme.theme_px(m, (*s).r_panel)
}

#[no_gc]
fn type_of(m: *mut theme.Theme, role: usize) -> TypeTok {
    let t: ds_tokens_type.TypeSpec = ds_tokens_type.spec(role)
    return TypeTok { size: theme.theme_text_px(m, t.size), line: theme.theme_text_px(m, t.line), weight: t.weight }
}

#[no_gc]
fn elevation(m: *mut theme.Theme, level: usize) -> ElevTok {
    let e: ds_tokens_prim.ShadowSpec = ds_tokens_prim.shadow_spec(level)
    if (*theme.theme_shape(m)).shadow == 0 {
        return ElevTok { dy: 0, blur: 0, alpha: 0, ambient_blur: 0, ambient_alpha: 0 }
    }
    return ElevTok { dy: theme.theme_px(m, e.dy), blur: theme.theme_px(m, e.blur), alpha: e.alpha,
        ambient_blur: theme.theme_px(m, e.ambient_blur), ambient_alpha: e.ambient_alpha }
}

#[no_gc]
fn motion(m: *mut theme.Theme, role: usize) -> MotionTok {
    let s: ds_tokens_motion.MotionSpec = ds_tokens_motion.spec(role)
    let b: ds_tokens_prim.Bezier = ds_tokens_prim.ease_curve(s.ease)
    var ms: usize = s.ms
    if (*theme.theme_shape(m)).motion == 0 { ms = 0 }
    return MotionTok { ms: ms, ease: s.ease, x1: b.x1, y1: b.y1, x2: b.x2, y2: b.y2 }
}

#[no_gc]
fn accent_count() -> usize {
    return ds_tokens_prim.ACCENT_COUNT
}

#[no_gc]
fn accent_color(idx: usize, dark: bool) -> u32 {
    if dark { return ds_tokens_prim.accent_dark(idx) }
    return ds_tokens_prim.accent_light(idx)
}

#[no_gc]
fn set_accent(m: *mut theme.Theme, idx: usize) {
    let f: *mut theme.Colors = theme.theme_colors(m)
    let dark: bool = (*f).dark
    if idx == 0 {
        (*f).accent = ds_tokens_color.core(ds_tokens_color.C_ACCENT, dark)
        (*f).text_on_accent = ds_tokens_color.core(ds_tokens_color.C_TEXT_ON_ACCENT, dark)
        (*f).selection = ds_tokens_color.core(ds_tokens_color.C_SELECTION, dark)
        (*f).selection_text = ds_tokens_color.core(ds_tokens_color.C_SELECTION_TEXT, dark)
        return
    }
    let a: u32 = accent_color(idx, dark)
    theme.theme_set_accent(m, a)
    (*f).text_on_accent = on_fill(a)
}

#[no_gc]
fn apply(m: *mut theme.Theme, dark: bool, accent_idx: usize) {
    theme.theme_set_dark(m, dark)
    if accent_idx != 0 { set_accent(m, accent_idx) }
}
