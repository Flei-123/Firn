// SPDX-License-Identifier: GPL-2.0-only
// lib/fui/element.fi -- WAS JEDES BEDIENELEMENT IST.
//
// ====================================================== WARUM ES SIE GIBT
//
// Justin will die volle Liste: Knopf, Beschriftung, Ankreuzfeld,
// Aufklappliste, Reiter, Tabelle, Baum, Dialoge -- "wirklich alles".
// Das geht nur, wenn alle dasselbe SIND. Sonst hat Welle 3 eine andere
// Bauart als Welle 1, und dann war der Schnitt falsch (JARVIS'
// Bedingung: "Wenn Welle 3 die Bauart von Welle 1 umwirft, hast du
// falsch geschnitten").
//
// Diese Datei ist dieser Schnitt. Ein Element ist:
//
//   * ein RECHTECK          wo es liegt
//   * ein ZUSTAND           normal/ueber/druck/fokus/sperr/gewaehlt
//   * ein STILSATZ          wie es aussehen soll (lib/fui/stil.fi)
//   * eine ART              was es ist (Knopf, Beschriftung, ...)
//   * ein PAAR ZAHLEN       Beschriftung, Wert, Kennung
//
// und sonst nichts. Alles, was ein Element TUT, sind Funktionen darauf.
//
// ================================================ WAS HIER NICHT STEHT
//
// E1 KEIN eigener Speicher. Der Text einer Beschriftung ist ein Zeiger
//    des Aufrufers, kein kopierter Puffer. Damit bleibt ein Element
//    eine Wertestruktur und die Bibliothek allokationsfrei.
// E2 KEIN Zeichnen. Das steht in lib/fui/male.fi, damit diese Datei
//    ohne Leinwand pruefbar bleibt.
// E3 KEINE Kinderliste. Ein Element weiss nicht, wer in ihm liegt --
//    das weiss die Anordnung (lib/fui/anordnung.fi). Ein Baum aus
//    Zeigern waere das Ende der Allokationsfreiheit.
import std.rt
import fui.stil

export {
    Element, element_neu,
    el_lege, el_x, el_y, el_w, el_h, el_trifft,
    el_setz_zustand, el_zustand, el_setz_ueber, el_setz_druck,
    el_setz_fokus, el_setz_sperr, el_setz_gewaehlt,
    el_ist_ueber, el_ist_druck, el_ist_fokus, el_ist_sperr,
    el_ist_gewaehlt, el_ist_bedienbar,
    el_satz, el_setz_satz, el_stil, el_setz_stil,
    el_setz_text, el_text, el_text_len,
    el_setz_wert, el_wert, el_setz_kennung, el_kennung,
    el_art, el_setz_art,
    el_wunsch_w, el_wunsch_h, el_setz_wunsch, el_setz_dehnbar,
    el_dehnt_x, el_dehnt_y,
    AR_LEER, AR_BESCHRIFTUNG, AR_KNOPF, AR_UMSCHALT, AR_ANKREUZ,
    AR_AUSWAHL, AR_TEXTFELD, AR_SCHIEBER, AR_FORTSCHRITT,
    AR_AUFKLAPP, AR_LISTE, AR_REITER, AR_WERKZEUG, AR_MENUE,
    AR_BILDLAUF, AR_TRENNER, AR_GRUPPE, AR_TABELLE, AR_BAUM,
    AR_KACHEL, AR_KARTE, AR_ABZEICHEN, AR_HINWEIS,
}

// ============================================================ DIE ARTEN
//
// Die volle Liste aus Justins Auftrag, gleich hier -- auch die, die
// erst in Welle 3 und 4 gebaut werden. Eine Nummer kostet nichts, und
// eine Art, die spaeter dazukommt, verschiebt sonst die Zahlen.
const AR_LEER: u32 = 0
const AR_BESCHRIFTUNG: u32 = 1
const AR_KNOPF: u32 = 2
const AR_UMSCHALT: u32 = 3
const AR_ANKREUZ: u32 = 4
const AR_AUSWAHL: u32 = 5
const AR_TEXTFELD: u32 = 6
const AR_SCHIEBER: u32 = 7
const AR_FORTSCHRITT: u32 = 8
const AR_AUFKLAPP: u32 = 9
const AR_LISTE: u32 = 10
const AR_REITER: u32 = 11
const AR_WERKZEUG: u32 = 12
const AR_MENUE: u32 = 13
const AR_BILDLAUF: u32 = 14
const AR_TRENNER: u32 = 15
const AR_GRUPPE: u32 = 16
const AR_TABELLE: u32 = 17
const AR_BAUM: u32 = 18
const AR_KACHEL: u32 = 19
const AR_KARTE: u32 = 20
const AR_ABZEICHEN: u32 = 21
const AR_HINWEIS: u32 = 22

// ===================================================== DIE ZUSTANDSBITS
//
// Als BITS und nicht als eine Zahl, weil sie gleichzeitig gelten:
// ein Knopf kann fokussiert UND ueberfahren sein. Welcher davon das
// AUSSEHEN bestimmt, entscheidet `el_zustand` -- an einer Stelle.
const B_UEBER: u32 = 1
const B_DRUCK: u32 = 2
const B_FOKUS: u32 = 4
const B_SPERR: u32 = 8
const B_GEWAEHLT: u32 = 16

struct Element {
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    art: u32,
    bits: u32,
    satz: stil.Satz,
    // Der Text gehoert dem AUFRUFER (E1). Ein Element haelt nur den
    // Zeiger -- so bleibt es kopierbar und die Bibliothek
    // allokationsfrei.
    t_p: u64,
    t_n: usize,
    // Der Wert: bei einem Schieber die Stellung, bei einem Ankreuzfeld
    // 0/1, bei einem Reiter die Nummer. EINE Zahl, weil jedes Element
    // genau eine braucht -- und wer zwei braucht, hat zwei Elemente.
    wert: i64,
    // Was der Aufrufer beim Treffer zurueckbekommt.
    kennung: u32,
    // Wunschgroesse und Dehnbarkeit -- die Anordnung fragt danach.
    wunsch_w: f64,
    wunsch_h: f64,
    dehnt: u32,   // Bit 0 = waagerecht, Bit 1 = senkrecht
}

fn element_neu(art: u32) -> Element {
    return Element {
        x: 0.0, y: 0.0, w: 0.0, h: 0.0,
        art: art, bits: 0, satz: stil.satz_neu(),
        t_p: 0, t_n: 0, wert: 0, kennung: 0,
        wunsch_w: 0.0, wunsch_h: 0.0, dehnt: 0,
    }
}

// ------------------------------------------------------- die Geometrie
fn el_lege(e: *mut Element, x: f64, y: f64, w: f64, h: f64) {
    (*e).x = x
    (*e).y = y
    (*e).w = w
    (*e).h = h
}

fn el_x(e: *mut Element) -> f64 { return (*e).x }
fn el_y(e: *mut Element) -> f64 { return (*e).y }
fn el_w(e: *mut Element) -> f64 { return (*e).w }
fn el_h(e: *mut Element) -> f64 { return (*e).h }

// DIE TREFFERFLAECHE IST DAS GANZE RECHTECK.
//
// Die Vorlage sagt es ausdruecklich: "sichtbare Flaeche und
// Trefferflaeche sind dasselbe Rechteck. Ein Symbol, das kleiner ist
// als sein Knopf, aendert daran nichts." Ein gesperrtes Element wird
// NICHT getroffen -- sonst faengt es Klicks ab, die an das Element
// darunter gehen sollten.
fn el_trifft(e: *mut Element, px: f64, py: f64) -> bool {
    if ((*e).bits & B_SPERR) != 0 as u32 {
        return false
    }
    return px >= (*e).x && px < (*e).x + (*e).w
        && py >= (*e).y && py < (*e).y + (*e).h
}

// ------------------------------------------------------- die Zustaende
fn setz_bit(e: *mut Element, bit: u32, an: bool) {
    if an {
        (*e).bits = (*e).bits | bit
    } else {
        (*e).bits = (*e).bits & (4294967295 as u32 - bit)
    }
}

fn el_setz_ueber(e: *mut Element, an: bool) { setz_bit(e, B_UEBER, an) }
fn el_setz_druck(e: *mut Element, an: bool) { setz_bit(e, B_DRUCK, an) }
fn el_setz_fokus(e: *mut Element, an: bool) { setz_bit(e, B_FOKUS, an) }
fn el_setz_gewaehlt(e: *mut Element, an: bool) {
    setz_bit(e, B_GEWAEHLT, an)
}

// Sperren loescht Zeiger und Druck mit: ein gesperrtes Element, das
// noch "gedrueckt" im Speicher haelt, springt beim Entsperren an.
fn el_setz_sperr(e: *mut Element, an: bool) {
    setz_bit(e, B_SPERR, an)
    if an {
        setz_bit(e, B_UEBER, false)
        setz_bit(e, B_DRUCK, false)
    }
}

fn el_ist_ueber(e: *mut Element) -> bool {
    return ((*e).bits & B_UEBER) != 0 as u32
}
fn el_ist_druck(e: *mut Element) -> bool {
    return ((*e).bits & B_DRUCK) != 0 as u32
}
fn el_ist_fokus(e: *mut Element) -> bool {
    return ((*e).bits & B_FOKUS) != 0 as u32
}
fn el_ist_sperr(e: *mut Element) -> bool {
    return ((*e).bits & B_SPERR) != 0 as u32
}
fn el_ist_gewaehlt(e: *mut Element) -> bool {
    return ((*e).bits & B_GEWAEHLT) != 0 as u32
}
fn el_ist_bedienbar(e: *mut Element) -> bool {
    return ((*e).bits & B_SPERR) == 0 as u32
}

// ================================================= DER SICHTBARE ZUSTAND
//
// DIE RANGFOLGE, EINMAL UND FUER ALLE ELEMENTE. Mehrere Bits gelten
// gleichzeitig; welches das Aussehen bestimmt, steht hier:
//
//   1. SPERR    schlaegt alles. Ein gesperrter Knopf unter dem Zeiger
//               ist gesperrt, nicht ueberfahren.
//   2. DRUCK    was gerade gedrueckt wird, sieht man.
//   3. GEWAEHLT ein ausgewaehlter Reiter bleibt ausgewaehlt, auch wenn
//               der Zeiger woanders steht.
//   4. UEBER
//   5. FOKUS    zuletzt, weil der Fokus ein RING ist und die Flaeche
//               nicht faerbt (siehe marke.flaeche_fuer). Ein Element,
//               das fokussiert UND ueberfahren ist, soll die
//               Ueberfahren-Flaeche zeigen und den Fokusring dazu.
fn el_zustand(e: *mut Element) -> u32 {
    let b: u32 = (*e).bits
    if (b & B_SPERR) != 0 as u32 {
        return stil.ZU_SPERR
    }
    if (b & B_DRUCK) != 0 as u32 {
        return stil.ZU_DRUCK
    }
    if (b & B_GEWAEHLT) != 0 as u32 {
        return stil.ZU_GEWAEHLT
    }
    if (b & B_UEBER) != 0 as u32 {
        return stil.ZU_UEBER
    }
    if (b & B_FOKUS) != 0 as u32 {
        return stil.ZU_FOKUS
    }
    return stil.ZU_NORMAL
}

fn el_setz_zustand(e: *mut Element, bits: u32) { (*e).bits = bits }

// ------------------------------------------------------------ der Stil
fn el_satz(e: *mut Element) -> *mut stil.Satz { return &(*e).satz }
fn el_setz_satz(e: *mut Element, z: stil.Satz) { (*e).satz = z }
fn el_stil(e: *mut Element) -> *mut stil.Stil {
    return stil.satz_stil(&(*e).satz)
}
fn el_setz_stil(e: *mut Element, s: stil.Stil) {
    let p: *mut stil.Stil = stil.satz_stil(&(*e).satz)
    *p = s
}

// ------------------------------------------------------- Text und Wert
fn el_setz_text(e: *mut Element, p: u64, n: usize) {
    (*e).t_p = p
    (*e).t_n = n
}
fn el_text(e: *mut Element) -> u64 { return (*e).t_p }
fn el_text_len(e: *mut Element) -> usize { return (*e).t_n }

fn el_setz_wert(e: *mut Element, v: i64) { (*e).wert = v }
fn el_wert(e: *mut Element) -> i64 { return (*e).wert }

fn el_setz_kennung(e: *mut Element, k: u32) { (*e).kennung = k }
fn el_kennung(e: *mut Element) -> u32 { return (*e).kennung }

fn el_art(e: *mut Element) -> u32 { return (*e).art }
fn el_setz_art(e: *mut Element, a: u32) { (*e).art = a }

// ------------------------------------------------- fuer die Anordnung
fn el_setz_wunsch(e: *mut Element, w: f64, h: f64) {
    (*e).wunsch_w = w
    (*e).wunsch_h = h
}
fn el_wunsch_w(e: *mut Element) -> f64 { return (*e).wunsch_w }
fn el_wunsch_h(e: *mut Element) -> f64 { return (*e).wunsch_h }

// Dehnbar heisst: nimm den Platz, der uebrig bleibt. Ein Adressfeld in
// einer Leiste dehnt sich waagerecht, die Knoepfe daneben nicht.
fn el_setz_dehnbar(e: *mut Element, x: bool, y: bool) {
    var d: u32 = 0
    if x {
        d = d | 1 as u32
    }
    if y {
        d = d | 2 as u32
    }
    (*e).dehnt = d
}
fn el_dehnt_x(e: *mut Element) -> bool {
    return ((*e).dehnt & 1 as u32) != 0 as u32
}
fn el_dehnt_y(e: *mut Element) -> bool {
    return ((*e).dehnt & 2 as u32) != 0 as u32
}
