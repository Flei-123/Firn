import std.rt
import fui.scene
import fui.flex
import fui.painter

export {
    count_lines, label_width, LINES_MAX,
}

const LINES_MAX: usize = 64

fn count_lines(z: *mut painter.Painter, r: *mut painter.TextRun, p: u64, n: usize, w: f64) -> usize {
    var lines: usize = 0
    var i: usize = 0
    while i < n && lines < LINES_MAX {
        var j: usize = i
        while j < n && rt.ld8(p, j) == 32 as u8 {
            j = j + 1
        }
        if j >= n {
            return lines
        }
        var next: usize = 0
        let upto: usize = painter.run_line_upto(z, r, p + (i as u64), n - i, w, &next)
        if upto == 0 || next == 0 {
            return lines + 1
        }
        lines = lines + 1
        i = i + next
    }
    return lines
}

fn siblings_take(sc: *mut scene.Scene, parent: usize, node: usize, s: f64) -> f64 {
    var taken: f64 = 0.0
    var kids: usize = 0
    var k: usize = scene.scene_first_child(sc, parent)
    while k != scene.SCENE_NONE {
        if k != node {
            taken = taken + scene.node_pref_w(sc, k)
        }
        kids = kids + 1
        k = scene.scene_next_sibling(sc, k)
    }
    return taken + ((kids - 1) as f64) * (scene.node_gap_main(sc, parent) as f64) * s
}

fn room_inside(sc: *mut scene.Scene, i: usize, window_px: f64, s: f64) -> f64 {
    var outer: f64 = window_px
    let p: usize = scene.scene_parent(sc, i)
    if p != scene.SCENE_NONE {
        outer = room_inside(sc, p, window_px, s)
        if scene.node_flex_dir(sc, p) == flex.FLEX_ROW {
            outer = outer - siblings_take(sc, p, i, s)
        }
    }
    let fixed: f64 = scene.node_fixed_w(sc, i)
    if fixed > 0.0 && fixed * s < outer {
        outer = fixed * s
    }
    return outer - (scene.node_pad_lr(sc, i) as f64) * s
}

fn label_width(sc: *mut scene.Scene, i: usize, window_px: f64, s: f64) -> f64 {
    let p: usize = scene.scene_parent(sc, i)
    let room: f64 = room_inside(sc, p, window_px, s)
    if scene.node_flex_dir(sc, p) == flex.FLEX_ROW {
        return room - siblings_take(sc, p, i, s)
    }
    return room
}
