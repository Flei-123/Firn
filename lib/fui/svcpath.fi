import std.rt
import fui.safeout

export { read_path, write_path }

fn cpath(path: str, out: *mut rt.Buf) {
    rt.buf_push_bytes(out, path.p as u64, path.n)
    rt.buf_push(out, 0 as u8)
}

fn read_path(path: str, out: *mut rt.Buf) -> bool {
    var c: rt.Buf = rt.buf_new()
    cpath(path, &c)
    let ok: bool = rt.read_file(rt.buf_ptr(&c), out)
    rt.buf_free(&c)
    return ok
}

fn write_path(path: str, p: u64, n: usize) -> bool {
    var c: rt.Buf = rt.buf_new()
    cpath(path, &c)
    let ok: bool = safeout.write_file(rt.buf_ptr(&c), p, n)
    rt.buf_free(&c)
    return ok
}
