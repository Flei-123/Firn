// SPDX-License-Identifier: MPL-2.0
// lib/fui/navnum.fi -- THE NUMBERS OF A FILE MANAGER AND A TASK MANAGER (fUi gallery, no painter).
//
// Integer-only parts of lib/fui/navkit.fi, in a module of their own so that a program in the KERNEL
// profile (no floating point, no heap) can use them too: the file manager's model writes the size
// column with `size_text`, the same words every fUi program shows. Nothing here imports anything.
//
//   size_text       bytes -> "354 B", "1.2 KB", "12 MB", "3.4 GB"
//   mid_base        the baseline of a text of `px` pixels in a box of height `h`
//   row_indent      the left edge of a tree row of a given level
//   thumb_len       the length of a scroll bar thumb
//   thumb_off       its offset
//   heat_alpha      the tint of a heat cell for a value 0..1000
//   graph_y         where a value 0..1000 lands in a graph of height h
//   lerp_at         the value of a history at a position (linear)

export {
    size_text, mid_base, row_indent, thumb_len, thumb_off, heat_alpha, graph_y, lerp_at, sample_x,
    ROW_H, TREE_STEP, HEAT_MIN, HEAT_MAX,
}

// The row height of every list of the gallery (points) and the step of one tree level.
const ROW_H: u64 = 32
const TREE_STEP: u64 = 16
// The alpha of a heat plate at value 0 and at 1000 (of 255).
const HEAT_MIN: u64 = 20
const HEAT_MAX: u64 = 110

static mut U_B: [u8; 4] = " B\0\0"
static mut U_KB: [u8; 4] = " KB\0"
static mut U_MB: [u8; 4] = " MB\0"
static mut U_GB: [u8; 4] = " GB\0"

// ------------------------------------------------------------ sizes

fn put_digit(out: u64, at: usize, cap: usize, d: u64) -> usize {
    if at + 1 >= cap {
        return at
    }
    *((out + at as u64) as *mut u8) = (48 + d) as u8
    return at + 1
}

fn put_num(out: u64, at: usize, cap: usize, v: u64) -> usize {
    var a: usize = at
    var div: u64 = 1
    while v / div >= 10 {
        div = div * 10
    }
    while div > 0 {
        a = put_digit(out, a, cap, (v / div) % 10)
        div = div / 10
    }
    return a
}

fn put_str(out: u64, at: usize, cap: usize, s: u64) -> usize {
    var a: usize = at
    var i: u64 = 0
    while *((s + i) as *mut u8) != 0 as u8 && a + 1 < cap {
        *((out + a as u64) as *mut u8) = *((s + i) as *mut u8)
        a = a + 1
        i = i + 1
    }
    return a
}

// A SIZE FOR A PERSON. Units of 1024; one decimal below 10 of a unit
// ("1.2 KB"), none from there on ("12 KB"); bytes stay whole. The text
// is NUL-terminated inside `cap`; the return value is its length.
fn size_text(bytes: u64, out: u64, cap: usize) -> usize {
    if cap < 2 {
        return 0
    }
    var a: usize = 0
    if bytes < 1024 {
        a = put_num(out, a, cap, bytes)
        a = put_str(out, a, cap, (&U_B[0]) as u64)
        *((out + a as u64) as *mut u8) = 0 as u8
        return a
    }
    var unit: u64 = 1024
    var name: u64 = (&U_KB[0]) as u64
    if bytes >= 1024 * 1024 * 1024 {
        unit = 1024 * 1024 * 1024
        name = (&U_GB[0]) as u64
    } else if bytes >= 1024 * 1024 {
        unit = 1024 * 1024
        name = (&U_MB[0]) as u64
    }
    // tenths, rounded half up; 9.95 KB would print "10.0": carry it into the whole part
    var tenths: u64 = (bytes * 10 + unit / 2) / unit
    if tenths >= 100 {
        a = put_num(out, a, cap, (bytes + unit / 2) / unit)
    } else {
        a = put_num(out, a, cap, tenths / 10)
        *((out + a as u64) as *mut u8) = 46 as u8
        a = a + 1
        a = put_digit(out, a, cap, tenths % 10)
    }
    a = put_str(out, a, cap, name)
    *((out + a as u64) as *mut u8) = 0 as u8
    return a
}

// ------------------------------------------------------------ rows

// THE BASELINE ON THE CENTRE LINE. The middle between the x-height and
// the cap height of Inter (0.546 and 0.727 em) is 0.6365 em above the
// baseline; that point goes on the middle of the box. Integer arithmetic,
// whole pixels: `top` + (h * 500 + px * 318 + 500) / 1000.
fn mid_base(top: u64, h: u64, px: u64) -> u64 {
    return top + (h * 500 + px * 318 + 500) / 1000
}

// The left edge of a tree row (in pixels, `step` per level).
fn row_indent(x: u64, level: u64, step: u64) -> u64 {
    return x + level * step
}

// ------------------------------------------------------------ scroll bars

// The length of the thumb of `track` pixels for `vis` of `total` rows;
// never shorter than `min` and never longer than the track.
fn thumb_len(track: u64, vis: u64, total: u64, min: u64) -> u64 {
    if total == 0 || vis >= total {
        return track
    }
    var t: u64 = track * vis / total
    if t < min {
        t = min
    }
    if t > track {
        t = track
    }
    return t
}

// The offset of the thumb when the first visible row is `top`.
fn thumb_off(track: u64, tl: u64, top: u64, total: u64, vis: u64) -> u64 {
    if total <= vis {
        return 0
    }
    return (track - tl) * top / (total - vis)
}

// ------------------------------------------------------------ heat

// The alpha (0..255) of the plate for a value 0..1000.
fn heat_alpha(v: u64) -> u64 {
    var vv: u64 = v
    if vv > 1000 {
        vv = 1000
    }
    return HEAT_MIN + vv * (HEAT_MAX - HEAT_MIN) / 1000
}

// ------------------------------------------------------------ graphs

// Where a value 0..1000 lands in a graph whose box is `h` high: 0 on the
// bottom edge, 1000 on the top edge (whole pixels, y counted from the top).
fn graph_y(h: u64, v: u64) -> u64 {
    var vv: u64 = v
    if vv > 1000 {
        vv = 1000
    }
    return h - vv * h / 1000
}

// The x of sample `i` of `n` laid over `span + 1` columns: the first sample at column 0, the last at column `span`.
fn sample_x(i: u64, n: u64, span: u64) -> u64 {
    if n < 2 {
        return 0
    }
    return i * span / (n - 1)
}

// THE VALUE AT COLUMN `px` (0..span) of a history of `n` samples laid over `span + 1` columns: EXACTLY the sample
// at the columns `sample_x` gives (a test can look for the sample where it is reported), linear in between.
fn lerp_at(hist: u64, n: u64, px: u64, span: u64) -> u64 {
    if n == 0 {
        return 0
    }
    if n == 1 || span == 0 {
        return *(hist as *mut u64)
    }
    var i: u64 = px * (n - 1) / span
    if i + 1 >= n {
        i = n - 2
    }
    while i + 2 < n && sample_x(i + 1, n, span) <= px {
        i = i + 1
    }
    while i > 0 && sample_x(i, n, span) > px {
        i = i - 1
    }
    let x0: u64 = sample_x(i, n, span)
    let x1: u64 = sample_x(i + 1, n, span)
    let a: u64 = *((hist + i * 8) as *mut u64)
    let b: u64 = *((hist + (i + 1) * 8) as *mut u64)
    if px >= x1 || x1 <= x0 {
        return b
    }
    let f: u64 = (px - x0) * 256 / (x1 - x0)
    if b >= a {
        return a + (b - a) * f / 256
    }
    return a - (a - b) * f / 256
}

