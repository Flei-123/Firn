// SPDX-License-Identifier: MPL-2.0
import fui.theme
import fui.ds_tokens
import fui.ds_tokens_motion

export {
    BTN_STANDARD, BTN_PRIMARY, BTN_SUBTLE, BTN_CRITICAL, BTN_COUNT,
    SEV_INFO, SEV_SUCCESS, SEV_WARNING, SEV_ERROR, SEV_COUNT,
    ButtonTok, CardTok, RowTok, InputTok, NavTok, InfoBarTok, ToastTok,
    button, card, row, input, nav, infobar, toast, severity_color,
}

const BTN_STANDARD: usize = 0
const BTN_PRIMARY: usize = 1
const BTN_SUBTLE: usize = 2
const BTN_CRITICAL: usize = 3
const BTN_COUNT: usize = 4

const SEV_INFO: usize = 0
const SEV_SUCCESS: usize = 1
const SEV_WARNING: usize = 2
const SEV_ERROR: usize = 3
const SEV_COUNT: usize = 4

struct ButtonTok {
    bg: u32,
    bg_hover: u32,
    bg_pressed: u32,
    bg_disabled: u32,
    fg: u32,
    fg_disabled: u32,
    border: u32,
    border_disabled: u32,
    ring: u32,
    radius: usize,
    height: usize,
    pad_x: usize,
    pad_y: usize,
    gap: usize,
    icon_px: usize,
    border_w: usize,
    ring_w: usize,
    text_role: usize,
}

struct CardTok {
    bg: u32,
    bg_hover: u32,
    border: u32,
    radius: usize,
    pad: usize,
    gap: usize,
    border_w: usize,
    elevation: usize,
}

struct RowTok {
    bg: u32,
    bg_hover: u32,
    bg_pressed: u32,
    bg_selected: u32,
    fg: u32,
    fg_secondary: u32,
    divider: u32,
    indicator: u32,
    height: usize,
    pad_x: usize,
    gap: usize,
    radius: usize,
    indicator_w: usize,
    indicator_h: usize,
    icon_px: usize,
}

struct InputTok {
    bg: u32,
    bg_hover: u32,
    bg_focus: u32,
    bg_disabled: u32,
    fg: u32,
    fg_placeholder: u32,
    fg_disabled: u32,
    border: u32,
    border_error: u32,
    accent_line: u32,
    ring: u32,
    radius: usize,
    height: usize,
    pad_x: usize,
    border_w: usize,
    line_w: usize,
    text_role: usize,
}

struct NavTok {
    pane_bg: u32,
    bg_hover: u32,
    bg_selected: u32,
    fg: u32,
    fg_selected: u32,
    indicator: u32,
    pane_w: usize,
    pane_w_compact: usize,
    item_h: usize,
    item_radius: usize,
    item_pad_x: usize,
    item_gap: usize,
    indicator_w: usize,
    indicator_h: usize,
    icon_px: usize,
    text_role: usize,
}

struct InfoBarTok {
    bg: u32,
    border: u32,
    icon: u32,
    fg: u32,
    fg_secondary: u32,
    radius: usize,
    min_h: usize,
    pad_x: usize,
    pad_y: usize,
    gap: usize,
    icon_px: usize,
    border_w: usize,
    title_role: usize,
    body_role: usize,
}

struct ToastTok {
    bg: u32,
    fg: u32,
    fg_secondary: u32,
    border: u32,
    accent_bar: u32,
    radius: usize,
    pad_x: usize,
    pad_y: usize,
    gap: usize,
    width: usize,
    icon_px: usize,
    border_w: usize,
    elevation: usize,
    enter_ms: usize,
    exit_ms: usize,
    duration_ms: usize,
    title_role: usize,
    body_role: usize,
}

#[no_gc]
fn pc(m: *mut theme.Theme, role: usize) -> u32 {
    return ds_tokens.paint(m, role)
}

#[no_gc]
fn shade(m: *mut theme.Theme, c: u32, t: usize) -> u32 {
    let toward: u32 = if theme.theme_is_dark(m) { 0xFFFFFF as u32 } else { 0 as u32 }
    return theme.opaque(theme.mix(c, toward, t))
}

#[no_gc]
fn severity_color(m: *mut theme.Theme, sev: usize) -> u32 {
    if sev == SEV_SUCCESS { return pc(m, ds_tokens.C_SUCCESS) }
    if sev == SEV_WARNING { return pc(m, ds_tokens.C_WARNING) }
    if sev == SEV_ERROR { return pc(m, ds_tokens.C_ERROR) }
    return pc(m, ds_tokens.C_INFO)
}

#[no_gc]
fn severity_bg(m: *mut theme.Theme, sev: usize) -> u32 {
    if sev == SEV_SUCCESS { return pc(m, ds_tokens.C_SUCCESS_BG) }
    if sev == SEV_WARNING { return pc(m, ds_tokens.C_WARNING_BG) }
    if sev == SEV_ERROR { return pc(m, ds_tokens.C_ERROR_BG) }
    return pc(m, ds_tokens.C_INFO_BG)
}

#[no_gc]
fn button(m: *mut theme.Theme, variant: usize) -> ButtonTok {
    let s: *mut theme.Shape = theme.theme_shape(m)
    var t: ButtonTok = ButtonTok {
        bg: pc(m, ds_tokens.C_BUTTON), bg_hover: pc(m, ds_tokens.C_BUTTON_HOVER), bg_pressed: pc(m, ds_tokens.C_BUTTON_ACTIVE),
        bg_disabled: pc(m, ds_tokens.C_BUTTON), fg: pc(m, ds_tokens.C_TEXT), fg_disabled: pc(m, ds_tokens.C_TEXT_DISABLED),
        border: pc(m, ds_tokens.C_BORDER), border_disabled: pc(m, ds_tokens.C_SEPARATOR), ring: pc(m, ds_tokens.C_FOCUS_RING),
        radius: ds_tokens.radius(m, ds_tokens.RAD_CONTROL), height: theme.theme_px(m, (*s).ctrl_h),
        pad_x: ds_tokens.space(m, ds_tokens.SP_M), pad_y: ds_tokens.space(m, ds_tokens.SP_XS), gap: ds_tokens.space(m, ds_tokens.SP_S),
        icon_px: theme.theme_px(m, 16), border_w: theme.theme_px(m, (*s).border_w), ring_w: theme.theme_px(m, (*s).focus_w),
        text_role: ds_tokens.T_BODY,
    }
    if variant == BTN_PRIMARY {
        t.bg = pc(m, ds_tokens.C_ACCENT)
        t.bg_hover = pc(m, ds_tokens.C_ACCENT_HOVER)
        t.bg_pressed = pc(m, ds_tokens.C_ACCENT_ACTIVE)
        t.fg = pc(m, ds_tokens.C_TEXT_ON_ACCENT)
        t.border = 0 as u32
    }
    if variant == BTN_SUBTLE {
        t.bg = 0 as u32
        t.bg_hover = pc(m, ds_tokens.C_SUBTLE_HOVER)
        t.bg_pressed = pc(m, ds_tokens.C_SUBTLE_ACTIVE)
        t.bg_disabled = 0 as u32
        t.border = 0 as u32
        t.border_disabled = 0 as u32
    }
    if variant == BTN_CRITICAL {
        let e: u32 = pc(m, ds_tokens.C_ERROR)
        t.bg = e
        t.bg_hover = shade(m, e, 100)
        t.bg_pressed = shade(m, e, 180)
        t.fg = theme.opaque(ds_tokens.on_fill(e))
        t.border = 0 as u32
    }
    return t
}

#[no_gc]
fn card(m: *mut theme.Theme) -> CardTok {
    let s: *mut theme.Shape = theme.theme_shape(m)
    return CardTok { bg: pc(m, ds_tokens.C_CARD), bg_hover: pc(m, ds_tokens.C_SUBTLE_HOVER), border: pc(m, ds_tokens.C_CARD_BORDER),
        radius: ds_tokens.radius(m, ds_tokens.RAD_CARD), pad: ds_tokens.space(m, ds_tokens.SP_L), gap: ds_tokens.space(m, ds_tokens.SP_S),
        border_w: theme.theme_px(m, (*s).border_w), elevation: 1 }
}

#[no_gc]
fn row(m: *mut theme.Theme) -> RowTok {
    let f: *mut theme.Colors = theme.theme_colors(m)
    let sel: u32 = ((36 as u32) << 24) | ((*f).accent & 16777215 as u32)
    return RowTok { bg: 0 as u32, bg_hover: pc(m, ds_tokens.C_SUBTLE_HOVER), bg_pressed: pc(m, ds_tokens.C_SUBTLE_ACTIVE), bg_selected: sel,
        fg: pc(m, ds_tokens.C_TEXT), fg_secondary: pc(m, ds_tokens.C_TEXT_MUTED), divider: pc(m, ds_tokens.C_SEPARATOR),
        indicator: pc(m, ds_tokens.C_ACCENT_TEXT), height: theme.theme_px(m, 40), pad_x: ds_tokens.space(m, ds_tokens.SP_M),
        gap: ds_tokens.space(m, ds_tokens.SP_M), radius: ds_tokens.radius(m, ds_tokens.RAD_CONTROL), indicator_w: theme.theme_px(m, 3),
        indicator_h: theme.theme_px(m, 16), icon_px: theme.theme_px(m, 20) }
}

#[no_gc]
fn input(m: *mut theme.Theme) -> InputTok {
    let s: *mut theme.Shape = theme.theme_shape(m)
    return InputTok { bg: pc(m, ds_tokens.C_FIELD), bg_hover: pc(m, ds_tokens.C_BUTTON_HOVER), bg_focus: pc(m, ds_tokens.C_FIELD_FOCUS),
        bg_disabled: pc(m, ds_tokens.C_BUTTON), fg: pc(m, ds_tokens.C_TEXT), fg_placeholder: pc(m, ds_tokens.C_TEXT_MUTED),
        fg_disabled: pc(m, ds_tokens.C_TEXT_DISABLED), border: pc(m, ds_tokens.C_BORDER), border_error: pc(m, ds_tokens.C_ERROR),
        accent_line: pc(m, ds_tokens.C_ACCENT_TEXT), ring: pc(m, ds_tokens.C_FOCUS_RING),
        radius: ds_tokens.radius(m, ds_tokens.RAD_FIELD), height: theme.theme_px(m, (*s).ctrl_h), pad_x: ds_tokens.space(m, ds_tokens.SP_MNUDGE),
        border_w: theme.theme_px(m, (*s).border_w), line_w: theme.theme_px(m, (*s).focus_w), text_role: ds_tokens.T_BODY }
}

#[no_gc]
fn nav(m: *mut theme.Theme) -> NavTok {
    return NavTok { pane_bg: pc(m, ds_tokens.C_SURFACE), bg_hover: pc(m, ds_tokens.C_SUBTLE_HOVER), bg_selected: pc(m, ds_tokens.C_SUBTLE_ACTIVE),
        fg: pc(m, ds_tokens.C_TEXT), fg_selected: pc(m, ds_tokens.C_TEXT), indicator: pc(m, ds_tokens.C_ACCENT_TEXT),
        pane_w: theme.theme_px(m, 320), pane_w_compact: theme.theme_px(m, 48), item_h: theme.theme_px(m, 40),
        item_radius: ds_tokens.radius(m, ds_tokens.RAD_CONTROL), item_pad_x: ds_tokens.space(m, ds_tokens.SP_M),
        item_gap: ds_tokens.space(m, ds_tokens.SP_XXS), indicator_w: theme.theme_px(m, 3), indicator_h: theme.theme_px(m, 16),
        icon_px: theme.theme_px(m, 16), text_role: ds_tokens.T_BODY }
}

#[no_gc]
fn infobar(m: *mut theme.Theme, sev: usize) -> InfoBarTok {
    let s: *mut theme.Shape = theme.theme_shape(m)
    return InfoBarTok { bg: severity_bg(m, sev), border: pc(m, ds_tokens.C_CARD_BORDER), icon: severity_color(m, sev),
        fg: pc(m, ds_tokens.C_TEXT), fg_secondary: pc(m, ds_tokens.C_TEXT_MUTED), radius: ds_tokens.radius(m, ds_tokens.RAD_CONTROL),
        min_h: theme.theme_px(m, 48), pad_x: ds_tokens.space(m, ds_tokens.SP_L), pad_y: ds_tokens.space(m, ds_tokens.SP_M),
        gap: ds_tokens.space(m, ds_tokens.SP_M), icon_px: theme.theme_px(m, 20), border_w: theme.theme_px(m, (*s).border_w),
        title_role: ds_tokens.T_BODY_STRONG, body_role: ds_tokens.T_BODY }
}

#[no_gc]
fn toast(m: *mut theme.Theme, sev: usize) -> ToastTok {
    let s: *mut theme.Shape = theme.theme_shape(m)
    return ToastTok { bg: pc(m, ds_tokens.C_RAISED), fg: pc(m, ds_tokens.C_TEXT), fg_secondary: pc(m, ds_tokens.C_TEXT_MUTED),
        border: pc(m, ds_tokens.C_CARD_BORDER), accent_bar: severity_color(m, sev), radius: ds_tokens.radius(m, ds_tokens.RAD_CARD),
        pad_x: ds_tokens.space(m, ds_tokens.SP_L), pad_y: ds_tokens.space(m, ds_tokens.SP_M), gap: ds_tokens.space(m, ds_tokens.SP_M),
        width: theme.theme_px(m, 360), icon_px: theme.theme_px(m, 20), border_w: theme.theme_px(m, (*s).border_w), elevation: 3,
        enter_ms: ds_tokens.motion(m, ds_tokens.M_TOAST_IN).ms, exit_ms: ds_tokens.motion(m, ds_tokens.M_TOAST_OUT).ms,
        duration_ms: 5000, title_role: ds_tokens.T_BODY_STRONG, body_role: ds_tokens.T_BODY }
}
