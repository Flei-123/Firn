// SPDX-License-Identifier: GPL-2.0-only
// lib/fui/editor.fi -- DIE BEDIENUNG EINES TEXTFELDES.
//
// ====================================================== WARUM ES SIE GIBT
//
// Justins Beschwerde vom 10.09.2026, von JARVIS auf seinem Laptop
// nachgestellt: in der Adresszeile von Certus markiert Strg+A nichts.
// Wer eine neue Adresse tippt, bekommt sie an die alte ANGEHAENGT und
// landet auf `https://xoffi.ai/https://de.wikipedia`.
//
// DIE URSACHE, GEFUNDEN UND NICHT VERMUTET. lib/fui/textbuf.fi (align
// certus lib/widget/textbuf.fi) kann Auswahl seit Runde TEXTBOX-2 --
// `tb_select_all`, `tb_sel_a`, `tb_has_sel`, `tb_insert` ersetzt eine
// bestehende Auswahl. Es kann das alles. Aber:
//
//     lib/android/a_main.fi:121   import widget.textfeld   <- benutzt es
//     lib/browser/certus_app.fi   ---                      <- benutzt es NICHT
//
// Der Schreibtisch-Browser haelt seine Adresszeile als rohen `mem.Buf`
// und haengt bei EV_CHAR mit `mem.buf_push` an. Es gibt dort keinen
// Zeiger, keinen Anker, kein Strg-A -- nicht weil es schwer waere,
// sondern weil das fertige TextBuf eine Datei weiter liegt und niemand
// es angeschlossen hat. Das Telefon hat eine richtige Textbox, der
// Schreibtisch nicht.
//
// Diese Datei ist die fehlende Haelfte: align dem MODELL (was der Text
// ist) wird BEDIENUNG (was eine Taste damit macht).
//
// ==================================================== DIE ARBEITSTEILUNG
//
//   textbuf.fi   der Text, der Zeiger, der Anker, Wortgrenzen.
//                 Kennt keine Taste und keinen Bildschirm.
//   editor.fi       DIESE DATEI: Tasten, Maus, Rueckgaengig, Bildlauf.
//                 Kennt keine Leinwand.
//   field.fi       das Malen und die Lage auf dem Schirm.
//
// Der Schnitt ist Absicht: `editor.fi` laesst sich ohne Fenster pruefen,
// und genau das tut tools/fui/tasten_main.fi -- jedes Tastenkuerzel
// einzeln, mit Soll und Ist.
//
// ========================================= WAS EINE PLATTFORM LIEFERN MUSS
//
// Die Zwischenablage. Sie ist der einzige Teil, den diese Datei nicht
// selbst kann, und sie kommt als zwei Funktionszeiger herein
// (`editor_set_clipboard`). Unter Android steht sie in lib/android/ime.fi
// (`ime_zwischenablage_lesen`/`-_schreiben`), unter Windows in
// lib/fenster/win32.fi, unter X11 in lib/fenster/x11.fi. Fehlt sie,
// arbeitet Strg+C/X/V auf einer INTERNEN Ablage -- das Feld
// funktioniert dann in sich, nur nicht mit anderen Programmen.
import std.rt
import fui.textbuf

export {
    Editor, editor_new, editor_init, editor_free,
    editor_buf, editor_set_clipboard, editor_set_width, editor_scroll,
    editor_key, editor_char, editor_mouse_down, editor_mouse_drag, editor_mouse_up,
    editor_caret_on, editor_caret_tick, editor_caret_wake,
    editor_undo, editor_redo, editor_push_undo,
    editor_select_all, editor_set_text, editor_clear,
    editor_copy, editor_cut, editor_paste,
    editor_scroll_to_caret, editor_scroll_x,
    KEY_LEFT, KEY_RIGHT, KEY_HOME, KEY_END, KEY_BACKSPACE, KEY_DELETE, KEY_ENTER,
    KEY_ESC, KEY_TAB, KEY_UP, KEY_DOWN,
    MOD_SHIFT, MOD_CTRL, MOD_ALT,
    RES_NONE, RES_CHANGED, RES_MOVED, RES_COMMIT,
    RES_CANCEL, RES_PASS,
}

// ===================================================== DIE TASTEN
//
// EIGENE Nummern und nicht die von lib/fenster. Der Grund: diese Datei
// soll ohne Fenster pruefbar sein, und ein Pruefprogramm, das
// `fenster.K_LEFT` importiert, zieht X11 und Win32 mit herein. Die
// Umsetzung steht an EINER Stelle (`field.fi`).
const KEY_LEFT: u32 = 1
const KEY_RIGHT: u32 = 2
const KEY_HOME: u32 = 3
const KEY_END: u32 = 4
const KEY_BACKSPACE: u32 = 5
const KEY_DELETE: u32 = 6
const KEY_ENTER: u32 = 7
const KEY_ESC: u32 = 8
const KEY_TAB: u32 = 9
const KEY_UP: u32 = 10
const KEY_DOWN: u32 = 11

// Die Umschalttasten, als Bitmaske. Bit 0 und Bit 2 sind die von X11,
// die lib/fenster/win32.fi nachbildet -- hier ausdruecklich benannt.
const MOD_SHIFT: u32 = 1
const MOD_CTRL: u32 = 4
const MOD_ALT: u32 = 8

// ==================================================== DIE ANTWORTEN
//
// Was der Aufrufer nach einer Taste tun muss. `RES_PASS` heisst
// "die Taste geht mich nichts an" -- dann darf das Programm sie selbst
// deuten (F5, Strg+T fuer einen neuen Reiter). Ohne diese Antwort
// wuerde ein fokussiertes TextBuf jede Tastenkombination des ganzen
// Programms schlucken.
const RES_NONE: u32 = 0
const RES_CHANGED: u32 = 1  // der Text ist anders -> neu malen
const RES_MOVED: u32 = 2     // nur Zeiger/Auswahl -> neu malen
const RES_COMMIT: u32 = 3     // Eingabetaste
const RES_CANCEL: u32 = 4    // Esc
const RES_PASS: u32 = 5     // nicht meine Taste

// =============================================== DER RUECKGAENGIG-STAPEL
//
// Justin verlangt Strg+Z und Strg+Y. Das gibt es in Certus heute
// nirgends, auch nicht auf dem Telefon.
//
// GESPEICHERT WIRD DER GANZE TEXT, nicht die einzelne Aenderung. Bei
// einer Adresszeile von hoechstens ein paar hundert Oktett ist das die
// richtige Wahl: 16 Stufen a 512 Oktett sind 8 KiB, und dafuer gibt es
// keine einzige Klasse von Fehlern, die align falsch verrechneten
// Umkehrungen entsteht. (Fuer einen Texteditor mit einem Megabyte waere
// es die falsche Wahl -- dann werden es Aenderungssaetze, und der Rest
// dieser Datei bleibt, how er ist.)
//
// EIN SCHRITT IST EINE WORTGRENZE UND KEIN ZEICHEN. Wer "wikipedia"
// tippt und einmal Strg+Z drueckt, will nicht "wikipedi" sehen.
// `editor_push_undo` wird darum vor jeder Aenderung gerufen, legt
// aber nur dann ab, wenn seit dem letzten Ablegen etwas anderes als ein
// weiteres Zeichen passiert ist (`sammelt`).
const UNDO_N: usize = 16
const UNDO_CAP: usize = 512

struct Editor {
    tf: textbuf.TextBuf,
    // --- Rueckgaengig
    u_buf: *mut u8,       // UNDO_N * UNDO_CAP
    u_len: [usize; 16],
    u_caret: [usize; 16],
    u_n: usize,           // wieviele Stufen belegt
    u_at: usize,          // wo wir im Box stehen
    sammelt: u32,         // 1 = die letzte Aenderung war ein Zeichen
    // --- die Zwischenablage der Plattform
    ab_lesen: fn(u64, usize) -> usize,
    ab_schreiben: fn(u64, usize) -> bool,
    ab_da: u32,
    // --- die INTERNE Ablage, wenn die Plattform keine hat
    ab_buf: *mut u8,
    ab_n: usize,
    // --- der Bildlauf bei langem Text
    width: f64,          // sichtbare Breite in Bildpunkten
    scroll: f64,           // wieviel nach left geschoben ist
    // --- die blinkende Einfuegemarke
    blink_us: u64,        // wann sie zuletzt umgeschaltet hat
    blink_an: u32,
    // --- die Maus
    klick_zeit: u64,
    klick_n: usize,       // 1 = einfach, 2 = doppelt, 3 = dreifach
    klick_x: f64,
}

#[no_gc]
fn clip_read_none(p: u64, cap: usize) -> usize { return 0 }
#[no_gc]
fn clip_write_none(p: u64, n: usize) -> bool { return false }

#[no_gc]
fn editor_new() -> Editor {
    return Editor {
        tf: textbuf.tb_new(),
        u_buf: 0 as *mut u8, u_len: [0; 16], u_caret: [0; 16],
        u_n: 0, u_at: 0, sammelt: 0,
        ab_lesen: clip_read_none, ab_schreiben: clip_write_none, ab_da: 0,
        ab_buf: 0 as *mut u8, ab_n: 0,
        width: 0.0, scroll: 0.0,
        blink_us: 0, blink_an: 1,
        klick_zeit: 0, klick_n: 0, klick_x: 0.0,
    }
}

// `p`/`cap` ist der Textpuffer und gehoert dem Aufrufer -- dieselbe
// Regel how in textbuf.fi.
fn editor_init(e: *mut Editor, p: u64, cap: usize) -> bool {
    textbuf.tb_init(&(*e).tf, p, cap)
    (*e).u_buf = rt.heap_alloc(UNDO_N * UNDO_CAP) as *mut u8
    if (*e).u_buf as usize == 0 {
        return false
    }
    (*e).ab_buf = rt.heap_alloc(UNDO_CAP) as *mut u8
    if (*e).ab_buf as usize == 0 {
        return false
    }
    (*e).u_n = 0
    (*e).u_at = 0
    return true
}

fn editor_free(e: *mut Editor) {
    if (*e).u_buf as usize != 0 {
        rt.heap_free((*e).u_buf as u64, UNDO_N * UNDO_CAP)
        (*e).u_buf = 0 as *mut u8
    }
    if (*e).ab_buf as usize != 0 {
        rt.heap_free((*e).ab_buf as u64, UNDO_CAP)
        (*e).ab_buf = 0 as *mut u8
    }
}

#[no_gc]
fn editor_buf(e: *mut Editor) -> *mut textbuf.TextBuf {
    return &(*e).tf
}

fn editor_set_clipboard(e: *mut Editor, lesen: fn(u64, usize) -> usize,
    schreiben: fn(u64, usize) -> bool) {
    (*e).ab_lesen = lesen
    (*e).ab_schreiben = schreiben
    (*e).ab_da = 1
}

#[no_gc]
fn editor_set_width(e: *mut Editor, w: f64) { (*e).width = w }

#[no_gc]
fn editor_scroll(e: *mut Editor) -> f64 { return (*e).scroll }

// ================================================== RUECKGAENGIG

// Den jetzigen Stand ablegen. `wegen_zeichen` sagt, ob die Aenderung,
// die gleich kommt, ein einzelnes getipptes Zeichen ist -- dann wird
// nur abgelegt, wenn der letzte Schritt KEIN Zeichen war.
fn editor_push_undo(e: *mut Editor, from_char: bool) {
    if from_char && (*e).sammelt != 0 {
        return
    }
    let n: usize = textbuf.tb_len(&(*e).tf)
    if n > UNDO_CAP {
        return
    }
    // Alles, was nach der jetzigen Stelle liegt, ist ueberholt: wer
    // rueckgaengig macht und dann tippt, hat einen neuen Ast.
    var at: usize = (*e).u_at
    if at >= UNDO_N {
        // Der Box ist voll: die aelteste Stufe faellt weg.
        var i: usize = 1
        while i < UNDO_N {
            rt.mem_copy(((*e).u_buf as u64) + ((i - 1) * UNDO_CAP) as u64,
                ((*e).u_buf as u64) + (i * UNDO_CAP) as u64, UNDO_CAP)
            (*e).u_len[i - 1] = (*e).u_len[i]
            (*e).u_caret[i - 1] = (*e).u_caret[i]
            i = i + 1
        }
        at = UNDO_N - 1
    }
    rt.mem_copy(((*e).u_buf as u64) + (at * UNDO_CAP) as u64,
        textbuf.tb_ptr(&(*e).tf), n)
    (*e).u_len[at] = n
    (*e).u_caret[at] = textbuf.tb_caret(&(*e).tf)
    (*e).u_at = at + 1
    (*e).u_n = at + 1
    if from_char {
        (*e).sammelt = 1
    } else {
        (*e).sammelt = 0
    }
}

fn editor_undo(e: *mut Editor) -> bool {
    if (*e).u_at == 0 {
        return false
    }
    // Steht der Zeiger am oberen Ende, muss der JETZIGE Stand zuerst
    // abgelegt werden -- sonst waere er nach dem ersten Strg+Z verloren
    // und Strg+Y haette nichts, wohin es zurueckkehrt.
    if (*e).u_at == (*e).u_n {
        let n: usize = textbuf.tb_len(&(*e).tf)
        if n <= UNDO_CAP && (*e).u_n < UNDO_N {
            rt.mem_copy(((*e).u_buf as u64) + ((*e).u_n * UNDO_CAP) as u64,
                textbuf.tb_ptr(&(*e).tf), n)
            (*e).u_len[(*e).u_n] = n
            (*e).u_caret[(*e).u_n] = textbuf.tb_caret(&(*e).tf)
            (*e).u_n = (*e).u_n + 1
        }
    }
    (*e).u_at = (*e).u_at - 1
    let at: usize = (*e).u_at
    textbuf.tb_set_text(&(*e).tf,
        ((*e).u_buf as u64) + (at * UNDO_CAP) as u64, (*e).u_len[at])
    textbuf.tb_set_range(&(*e).tf, (*e).u_caret[at], (*e).u_caret[at])
    (*e).sammelt = 0
    return true
}

fn editor_redo(e: *mut Editor) -> bool {
    if (*e).u_at + 1 >= (*e).u_n {
        return false
    }
    (*e).u_at = (*e).u_at + 1
    let at: usize = (*e).u_at
    textbuf.tb_set_text(&(*e).tf,
        ((*e).u_buf as u64) + (at * UNDO_CAP) as u64, (*e).u_len[at])
    textbuf.tb_set_range(&(*e).tf, (*e).u_caret[at], (*e).u_caret[at])
    (*e).sammelt = 0
    return true
}

// ================================================ DIE ZWISCHENABLAGE

fn editor_copy(e: *mut Editor) -> bool {
    if !textbuf.tb_has_sel(&(*e).tf) {
        return false
    }
    if textbuf.tb_secret(&(*e).tf) {
        // Ein Passwortfeld gibt nichts heraus.
        return false
    }
    let a: usize = textbuf.tb_sel_a(&(*e).tf)
    let b: usize = textbuf.tb_sel_b(&(*e).tf)
    let n: usize = b - a
    let von: u64 = textbuf.tb_ptr(&(*e).tf) + a as u64
    if (*e).ab_da != 0 {
        let f: fn(u64, usize) -> bool = (*e).ab_schreiben
        if f(von, n) {
            return true
        }
    }
    // Die interne Ablage -- besser als gar nichts.
    var k: usize = n
    if k > UNDO_CAP {
        k = UNDO_CAP
    }
    rt.mem_copy((*e).ab_buf as u64, von, k)
    (*e).ab_n = k
    return true
}

fn editor_cut(e: *mut Editor) -> bool {
    if !textbuf.tb_has_sel(&(*e).tf) {
        return false
    }
    if !editor_copy(e) {
        return false
    }
    editor_push_undo(e, false)
    return textbuf.tb_delete_sel(&(*e).tf)
}

fn editor_paste(e: *mut Editor) -> bool {
    var puf: [u8; 512] = [0; 512]
    var n: usize = 0
    if (*e).ab_da != 0 {
        let f: fn(u64, usize) -> usize = (*e).ab_lesen
        n = f((&puf[0]) as u64, 512)
    }
    if n == 0 && (*e).ab_n > 0 {
        n = (*e).ab_n
        rt.mem_copy((&puf[0]) as u64, (*e).ab_buf as u64, n)
    }
    if n == 0 {
        return false
    }
    // ZEILENUMBRUECHE WERDEN ZU LEERZEICHEN. Ein einzeiliges Feld mit
    // einem Zeilenumbruch darin malt einen leeren Rect -- und eine
    // align einer Textdatei kopierte Adresse bringt fast immer einen mit.
    var i: usize = 0
    while i < n {
        let c: u8 = *(((&puf[0]) as u64 + i as u64) as *mut u8)
        if c == 10 as u8 || c == 13 as u8 || c == 9 as u8 {
            *(((&puf[0]) as u64 + i as u64) as *mut u8) = 32 as u8
        }
        i = i + 1
    }
    editor_push_undo(e, false)
    return textbuf.tb_insert(&(*e).tf, (&puf[0]) as u64, n)
}

// ==================================================== DIE TASTEN

// EINE TASTE MIT BEDEUTUNG. `mods` ist die Bitmaske M_*.
//
// Hier steht die ganze Tastenbelegung eines Textfeldes an EINER Stelle
// -- und das ist der Punkt: heute steht sie in lib/android/a_main.fi
// (Telefon) und gar nicht in lib/browser/certus_app.fi (Schreibtisch).
fn editor_key(e: *mut Editor, key: u32, mods: u32) -> u32 {
    let t: *mut textbuf.TextBuf = &(*e).tf
    let extend: bool = (mods & MOD_SHIFT) != 0 as u32
    let ctrl: bool = (mods & MOD_CTRL) != 0 as u32
    editor_caret_wake(e)

    if key == KEY_LEFT {
        if ctrl {
            word_left(e, extend)
        } else {
            textbuf.tb_left(t, extend)
        }
        (*e).sammelt = 0
        return RES_MOVED
    }
    if key == KEY_RIGHT {
        if ctrl {
            word_right(e, extend)
        } else {
            textbuf.tb_right(t, extend)
        }
        (*e).sammelt = 0
        return RES_MOVED
    }
    if key == KEY_HOME {
        textbuf.tb_home(t, extend)
        (*e).sammelt = 0
        return RES_MOVED
    }
    if key == KEY_END {
        textbuf.tb_end(t, extend)
        (*e).sammelt = 0
        return RES_MOVED
    }
    if key == KEY_BACKSPACE {
        editor_push_undo(e, false)
        // Strg+Rueck loescht das Wort left -- so macht es jedes Feld.
        if ctrl && !textbuf.tb_has_sel(t) {
            let bis: usize = textbuf.tb_caret(t)
            word_left(e, true)
            let von: usize = textbuf.tb_caret(t)
            textbuf.tb_set_range(t, von, von)
            let ok: bool = textbuf.tb_delete(t, von, bis)
            return RES_CHANGED
        }
        let ok2: bool = textbuf.tb_backspace(t)
        return RES_CHANGED
    }
    if key == KEY_DELETE {
        editor_push_undo(e, false)
        if ctrl && !textbuf.tb_has_sel(t) {
            let von: usize = textbuf.tb_caret(t)
            word_right(e, true)
            let bis: usize = textbuf.tb_caret(t)
            textbuf.tb_set_range(t, von, von)
            let ok: bool = textbuf.tb_delete(t, von, bis)
            return RES_CHANGED
        }
        let ok2: bool = textbuf.tb_delete_fwd(t)
        return RES_CHANGED
    }
    if key == KEY_ENTER {
        return RES_COMMIT
    }
    if key == KEY_ESC {
        return RES_CANCEL
    }
    return RES_PASS
}

// EIN GETIPPTES ZEICHEN. Getrennt von `editor_key`, weil die
// Fensterschicht es getrennt liefert (EV_CHAR gegen EV_KEY) -- die
// Trennung, die Windows mit WM_CHAR/WM_KEYDOWN vorgibt und die X11
// nachbildet.
//
// HIER LIEGEN AUCH DIE STRG-KUERZEL. Grund: Windows schickt Strg+A als
// WM_CHAR mit dem Wert 1 (Steuerzeichen), nicht als Taste. Wer nur
// `editor_key` bedient, bekommt Strg+A NIE zu sehen -- und genau das
// ist ein Weg, auf dem Justins Fehler entstanden sein kann.
fn editor_char(e: *mut Editor, cp: u32, mods: u32) -> u32 {
    let t: *mut textbuf.TextBuf = &(*e).tf
    editor_caret_wake(e)
    let ctrl: bool = (mods & MOD_CTRL) != 0 as u32

    // Strg-Kuerzel: entweder als Steuerzeichen (1..26) oder als
    // Buchstabe mit gesetztem Strg-Bit. Beide Wege werden bedient.
    var k: u32 = 0
    if cp >= 1 as u32 && cp <= 26 as u32 {
        k = cp + 96 as u32           // 1 -> 'a'
    } else if ctrl {
        if cp >= 65 as u32 && cp <= 90 as u32 {
            k = cp + 32 as u32       // 'A' -> 'a'
        } else if cp >= 97 as u32 && cp <= 122 as u32 {
            k = cp
        }
    }
    if k != 0 as u32 {
        // ============================================================
        // STRG+A -- JUSTINS FEHLER.
        // ============================================================
        // `tb_select_all` setzt Anker auf 0 und Zeiger auf n. Das naechste
        // getippte Zeichen geht durch `tb_insert`, und das ruft
        // `tb_replace(sel_a, sel_b, ...)` -- die Auswahl wird also
        // ERSETZT und nicht ergaenzt. Damit ist
        // "https://xoffi.ai/https://de.wikipedia" nicht mehr moeglich.
        if k == 97 as u32 {                    // a
            textbuf.tb_select_all(t)
            return RES_MOVED
        }
        if k == 99 as u32 {                    // c
            let ok: bool = editor_copy(e)
            return RES_NONE
        }
        if k == 120 as u32 {                   // x
            if editor_cut(e) {
                return RES_CHANGED
            }
            return RES_NONE
        }
        if k == 118 as u32 {                   // v
            if editor_paste(e) {
                return RES_CHANGED
            }
            return RES_NONE
        }
        if k == 122 as u32 {                   // z
            // Strg+Umschalt+Z ist die zweite uebliche Belegung fuer
            // Wiederholen.
            if (mods & MOD_SHIFT) != 0 as u32 {
                if editor_redo(e) {
                    return RES_CHANGED
                }
                return RES_NONE
            }
            if editor_undo(e) {
                return RES_CHANGED
            }
            return RES_NONE
        }
        if k == 121 as u32 {                   // y
            if editor_redo(e) {
                return RES_CHANGED
            }
            return RES_NONE
        }
        // Ein Strg-Kuerzel, das dem Feld nichts sagt, gehoert dem
        // Programm: Strg+T macht einen Reiter auf und darf hier nicht
        // als Buchstabe im Text landen.
        return RES_PASS
    }

    // Steuerzeichen ausser den Kuerzeln landen nie im Text.
    if cp < 32 as u32 || cp == 127 as u32 {
        return RES_PASS
    }
    editor_push_undo(e, true)
    if !textbuf.tb_insert_cp(t, cp) {
        return RES_NONE
    }
    return RES_CHANGED
}

// ---- die Wortspruenge
//
// `tb_word_at` gibt die Grenzen des Wortes AN einer Stelle. Fuer den
// Sprung braucht es die naechste Grenze in eine Richtung, und das ist
// eine andere Frage: von der Mitte eines Wortes geht Strg+Links an
// seinen Anfang, von dessen Anfang an den Anfang des Wortes davor.
fn word_left(e: *mut Editor, extend: bool) {
    let t: *mut textbuf.TextBuf = &(*e).tf
    var i: usize = textbuf.tb_caret(t)
    if i == 0 {
        textbuf.tb_set_caret(t, 0, extend)
        return
    }
    // erst ueber die Nicht-Wortzeichen left
    while i > 0 {
        let j: usize = textbuf.tb_prev(t, i)
        if textbuf.tb_is_word_byte(byte_at(t, j)) {
            break
        }
        i = j
    }
    // dann ueber das Wort
    while i > 0 {
        let j: usize = textbuf.tb_prev(t, i)
        if !textbuf.tb_is_word_byte(byte_at(t, j)) {
            break
        }
        i = j
    }
    textbuf.tb_set_caret(t, i, extend)
}

fn word_right(e: *mut Editor, extend: bool) {
    let t: *mut textbuf.TextBuf = &(*e).tf
    let n: usize = textbuf.tb_len(t)
    var i: usize = textbuf.tb_caret(t)
    // ueber das Wort
    while i < n {
        if !textbuf.tb_is_word_byte(byte_at(t, i)) {
            break
        }
        i = textbuf.tb_next(t, i)
    }
    // ueber die Nicht-Wortzeichen
    while i < n {
        if textbuf.tb_is_word_byte(byte_at(t, i)) {
            break
        }
        i = textbuf.tb_next(t, i)
    }
    textbuf.tb_set_caret(t, i, extend)
}

#[no_gc]
fn byte_at(t: *mut textbuf.TextBuf, i: usize) -> u8 {
    if i >= textbuf.tb_len(t) {
        return 0 as u8
    }
    return *((textbuf.tb_ptr(t) + i as u64) as *mut u8)
}

// ======================================================= DIE MAUS
//
// `x` ist die Stelle IM TEXT (also schon um `scroll` bereinigt), `mess`
// misst die Breite der ersten n Oktett -- dieselbe Rueckrufform, die
// textbuf.fi schon benutzt.
//
// Einfach-, Doppel- und Dreifachklick unterscheiden sich nur in der
// Zeit und in der Strecke. 400 ms ist die Frist, die Windows
// (GetDoubleClickTime) voreingestellt liefert.
const DOPPEL_US: u64 = 400000

fn editor_mouse_down(e: *mut Editor, x: f64, jetzt_us: u64,
    mess: fn(u64, u64, usize) -> f64, ctx: u64, extend: bool) -> u32 {
    let t: *mut textbuf.TextBuf = &(*e).tf
    editor_caret_wake(e)
    var dx: f64 = x - (*e).klick_x
    if dx < 0.0 {
        dx = 0.0 - dx
    }
    if jetzt_us - (*e).klick_zeit < DOPPEL_US && dx < 4.0 {
        (*e).klick_n = (*e).klick_n + 1
    } else {
        (*e).klick_n = 1
    }
    (*e).klick_zeit = jetzt_us
    (*e).klick_x = x
    let pos: usize = textbuf.tb_caret_from_x(t, x + (*e).scroll, mess, ctx)

    if (*e).klick_n >= 3 {
        // Dreifachklick: alles.
        textbuf.tb_select_all(t)
        textbuf.tb_set_drag(t, 0)
        return RES_MOVED
    }
    if (*e).klick_n == 2 {
        // Doppelklick: das Wort.
        textbuf.tb_select_word(t, pos)
        textbuf.tb_set_drag(t, 0)
        return RES_MOVED
    }
    textbuf.tb_set_caret(t, pos, extend)
    textbuf.tb_set_drag(t, 1)
    (*e).sammelt = 0
    return RES_MOVED
}

fn editor_mouse_drag(e: *mut Editor, x: f64,
    mess: fn(u64, u64, usize) -> f64, ctx: u64) -> u32 {
    let t: *mut textbuf.TextBuf = &(*e).tf
    if textbuf.tb_drag(t) == 0 as u32 {
        return RES_NONE
    }
    let pos: usize = textbuf.tb_caret_from_x(t, x + (*e).scroll, mess, ctx)
    // `extend` ist beim Ziehen immer wahr: der Anker bleibt, wo die
    // Maus heruntergegangen ist.
    textbuf.tb_set_caret(t, pos, true)
    editor_caret_wake(e)
    return RES_MOVED
}

fn editor_mouse_up(e: *mut Editor) -> u32 {
    textbuf.tb_set_drag(&(*e).tf, 0)
    return RES_NONE
}

// ============================================ DIE BLINKENDE MARKE
//
// 530 ms ist die Voreinstellung von Windows (Systemsteuerung, Tastatur)
// und liegt zwischen den 500 ms von GTK und den 600 ms von macOS.
const BLINK_US: u64 = 530000

// Nach jeder Eingabe steht die Theme wieder SICHTBAR da. Eine Theme,
// die genau in dem Augenblick unsichtbar ist, in dem jemand tippt,
// sieht align how ein Feld, das die Taste verschluckt hat.
#[no_gc]
fn editor_caret_wake(e: *mut Editor) {
    (*e).blink_an = 1
    (*e).blink_us = 0
}

// Ist die Theme JETZT visible? `jetzt_us` kommt vom Aufrufer, damit
// diese Datei keine Uhr braucht und im Pruefstand steuerbar bleibt.
fn editor_caret_tick(e: *mut Editor, jetzt_us: u64) -> bool {
    if (*e).blink_us == 0 {
        (*e).blink_us = jetzt_us
        (*e).blink_an = 1
        return true
    }
    if jetzt_us - (*e).blink_us >= BLINK_US {
        (*e).blink_us = jetzt_us
        if (*e).blink_an != 0 {
            (*e).blink_an = 0
        } else {
            (*e).blink_an = 1
        }
    }
    return (*e).blink_an != 0
}

#[no_gc]
fn editor_caret_on(e: *mut Editor) -> bool {
    return (*e).blink_an != 0
}

// ========================================== DER BILDLAUF BEI LANGEM TEXT
//
// Die Theme muss visible bleiben, sonst tippt man ins Blinde. Gerollt
// wird NUR so weit how noetig -- wer die Theme immer mittig haelt,
// laesst den Text bei jedem Zeichen springen.
fn editor_scroll_to_caret(e: *mut Editor, mess: fn(u64, u64, usize) -> f64,
    ctx: u64) {
    let t: *mut textbuf.TextBuf = &(*e).tf
    if (*e).width <= 0.0 {
        return
    }
    let cx: f64 = textbuf.tb_x_of(t, textbuf.tb_caret(t), mess, ctx)
    // left herausgelaufen
    if cx < (*e).scroll {
        (*e).scroll = cx
    }
    // right herausgelaufen. Zwei Bildpunkte Luft, damit die Theme
    // nicht auf der Kante klebt.
    let right: f64 = (*e).scroll + (*e).width - 2.0
    if cx > right {
        (*e).scroll = cx - (*e).width + 2.0
    }
    // Nie weiter rollen, als Text da ist.
    let total: f64 = textbuf.tb_x_of(t, textbuf.tb_len(t), mess, ctx)
    if (*e).scroll > total - (*e).width {
        (*e).scroll = total - (*e).width
    }
    if (*e).scroll < 0.0 {
        (*e).scroll = 0.0
    }
}

#[no_gc]
fn editor_scroll_x(e: *mut Editor) -> f64 { return (*e).scroll }

// ======================================================== BEQUEMES

fn editor_select_all(e: *mut Editor) {
    textbuf.tb_select_all(&(*e).tf)
}

// Text von aussen setzen (eine neue Adresse nach dem Laden). Die
// Auswahl ist danach weg und der Zeiger steht am Ende.
fn editor_set_text(e: *mut Editor, p: u64, n: usize) {
    editor_push_undo(e, false)
    textbuf.tb_set_text(&(*e).tf, p, n)
    (*e).scroll = 0.0
    editor_caret_wake(e)
}

fn editor_clear(e: *mut Editor) {
    editor_push_undo(e, false)
    textbuf.tb_clear(&(*e).tf)
    (*e).scroll = 0.0
    editor_caret_wake(e)
}
