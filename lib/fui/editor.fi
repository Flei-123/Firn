// SPDX-License-Identifier: MPL-2.0
// lib/fui/editor.fi -- THE OPERATION OF A TEXT FIELD.
//
// ========================================================= WHY IT EXISTS
//
// Justin's complaint of 10.09.2026, reproduced by JARVIS on his laptop:
// in the address line of Certus, Ctrl+A selects nothing. Whoever types
// a new address gets it APPENDED to the old one and lands on
// `https://xoffi.ai/https://de.wikipedia`.
//
// THE CAUSE, FOUND AND NOT GUESSED. lib/fui/textbuf.fi (in certus
// lib/widget/textbuf.fi) has been able to select since round TEXTBOX-2
// -- `tb_select_all`, `tb_sel_a`, `tb_has_sel`, `tb_insert` replaces an
// existing selection. It can do all of it. But:
//
//     lib/android/a_main.fi:121   import widget.textfeld   <- uses it
//     lib/browser/certus_app.fi   ---                      <- does NOT use it
//
// The desktop browser holds its address line as a raw `mem.Buf` and
// appends on EV_CHAR with `mem.buf_push`. There is no caret there, no
// anchor, no Ctrl+A -- not because it would be hard, but because the
// finished TextBuf lies one file further on and nobody connected it.
// The phone has a proper text box, the desktop does not.
//
// This file is the missing half: out of the MODEL (what the text is)
// comes OPERATION (what a key does with it).
//
// ==================================================== THE DIVISION OF WORK
//
//   textbuf.fi    the text, the caret, the anchor, word boundaries.
//                 Knows no key and no screen.
//   editor.fi     THIS FILE: keys, mouse, undo, scrolling.
//                 Knows no canvas.
//   the field     the painting and the position on the screen.
//
// The cut is deliberate: `editor.fi` can be checked without a window,
// and that is exactly what a key test does -- every shortcut on its
// own, with expected and actual.
//
// ============================================ WHAT A PLATFORM HAS TO SUPPLY
//
// The clipboard. It is the only part this file cannot do itself, and it
// comes in as two function pointers (`editor_set_clipboard`). Under
// Android it stands in lib/android/ime.fi, under Windows in
// lib/fenster/win32.fi, under X11 in lib/fenster/x11.fi. If it is
// missing, Ctrl+C/X/V work on an INTERNAL clipboard -- the field then
// works within itself, only not with other programs.
//
// ============================================= DIE ZWEIRICHTUNGSSCHRIFT
//
// In einem arabischen oder hebraeischen Text ist die Schreibmarke hinter
// Zeichen i NICHT "so weit rechts, wie die ersten i Zeichen breit
// sind": hinter einem hebraeischen Wort steht sie LINKS davon, und in
// einem gemischten Satz springt sie an der Grenze zweier Richtungen.
// Diese Datei rechnet das nicht selbst -- sie kennt keine Schrift --,
// sondern fragt vier Funktionen, die der Aufrufer ueber
// `editor_set_visual` einhaengt (painter.measure_* rechnet sie mit
// lib/fui/bidi.fi):
//
//   x(ctx, p, n, i)       wo die Marke fuer die Grenze i steht
//   hit(ctx, p, n, x)     welche Grenze unter dem Punkt x liegt
//   width(ctx, p, n)      wie breit der ganze Text ist
//   rtl(ctx, p, n)        ob der Absatz von rechts nach links laeuft
//
// DIE PFEILTASTEN LAUFEN LOGISCH: ein Druck ist ein Zeichen im Text, nie
// ein Sprung auf dem Schirm -- das ist die Bewegung, die Windows in
// Eingabefeldern macht, und sie laesst sich pruefen, ohne eine Glyphe
// zu kennen. In einem Absatz von rechts nach links geht "links" dabei
// zum NAECHSTEN Zeichen (dort liegt der Lesefluss), "rechts" zum
// vorigen. Ohne eingehaengte Funktionen bleibt alles, wie es war.
//
import std.rt
import fui.textbuf

export {
    Editor, editor_new, editor_init, editor_free,
    editor_buf, editor_set_clipboard, editor_set_width, editor_scroll,
    editor_key, editor_char, editor_mouse_down, editor_mouse_drag, editor_mouse_up,
    editor_caret_on, editor_caret_tick, editor_caret_wake,
    editor_undo, editor_redo, editor_push_undo,
    editor_select_all, editor_set_text, editor_clear,
    editor_copy, editor_cut, editor_paste,
    editor_scroll_to_caret, editor_scroll_x,
    editor_set_visual, editor_caret_x, editor_is_rtl, editor_visual_on,
    KEY_LEFT, KEY_RIGHT, KEY_HOME, KEY_END, KEY_BACKSPACE, KEY_DELETE, KEY_ENTER,
    KEY_ESC, KEY_TAB, KEY_UP, KEY_DOWN,
    MOD_SHIFT, MOD_CTRL, MOD_ALT,
    RES_NONE, RES_CHANGED, RES_MOVED, RES_COMMIT,
    RES_CANCEL, RES_PASS,
}

// ============================================================= THE KEYS
//
// OWN numbers and not those of lib/fenster. The reason: this file
// should be checkable without a window, and a test program that
// imports `fenster.K_LEFT` drags X11 and Win32 in with it. The mapping
// stands in ONE place.
const KEY_LEFT: u32 = 1
const KEY_RIGHT: u32 = 2
const KEY_HOME: u32 = 3
const KEY_END: u32 = 4
const KEY_BACKSPACE: u32 = 5
const KEY_DELETE: u32 = 6
const KEY_ENTER: u32 = 7
const KEY_ESC: u32 = 8
const KEY_TAB: u32 = 9
const KEY_UP: u32 = 10
const KEY_DOWN: u32 = 11

// The modifier keys, as a bit mask. Bit 0 and bit 2 are those of X11,
// which lib/fenster/win32.fi reproduces -- named here outright.
const MOD_SHIFT: u32 = 1
const MOD_CTRL: u32 = 4
const MOD_ALT: u32 = 8

// ======================================================== THE ANSWERS
//
// What the caller has to do after a key. `RES_PASS` means "the key is
// none of my business" -- then the program may interpret it itself (F5,
// Ctrl+T for a new tab). Without this answer a focused TextBuf would
// swallow every key combination of the whole program.
// Programms schlucken.
const RES_NONE: u32 = 0
const RES_CHANGED: u32 = 1  // the text differs -> repaint
const RES_MOVED: u32 = 2     // caret/selection only -> repaint
const RES_COMMIT: u32 = 3     // Eingabetaste
const RES_CANCEL: u32 = 4    // Esc
const RES_PASS: u32 = 5     // not my key

// ================================================== THE UNDO STACK
//
// Justin asks for Ctrl+Z and Ctrl+Y. That exists nowhere in Certus
// today, not on the phone either.
//
// WHAT IS STORED IS THE WHOLE TEXT, not the single change. On an
// address line of at most a few hundred bytes that is the right choice:
// 16 steps of 512 bytes are 8 KiB, and for that there is not a single
// class of mistakes arising from wrongly computed inversions. (For a
// text editor with a megabyte it would be the wrong choice -- then they
// become change sets, and the rest of this file stays as it is.)
//
// ONE STEP IS A WORD BOUNDARY AND NOT A CHARACTER. Whoever types
// "wikipedia" and presses Ctrl+Z once does not want to see "wikipedi".
// `editor_push_undo` is therefore called before every change, but only
// stores when something other than one more character has happened
// since the last store (`coalescing`).
const UNDO_N: usize = 16
const UNDO_CAP: usize = 512

struct Editor {
    tf: textbuf.TextBuf,
    // --- undo
    u_buf: *mut u8,       // UNDO_N * UNDO_CAP
    u_len: [usize; 16],
    u_caret: [usize; 16],
    u_n: usize,           // how many levels are in use
    u_at: usize,          // where we are in the ring
    coalescing: u32,      // 1 = the last change was a character
    // --- the clipboard of the platform
    clip_read: fn(u64, usize) -> usize,
    clip_write: fn(u64, usize) -> bool,
    ab_da: u32,
    // --- the INTERNAL clipboard, when the platform has none
    ab_buf: *mut u8,
    ab_n: usize,
    // --- the scrolling on long text
    width: f64,          // visible width in pixels
    scroll: f64,           // how far it is shifted to the left
    // --- the blinking caret
    blink_us: u64,        // when it last toggled
    blink_an: u32,
    // --- the mouse
    klick_zeit: u64,
    klick_n: usize,       // 1 = einfach, 2 = doppelt, 3 = dreifach
    klick_x: f64,
    // --- die Zweirichtungsschrift (siehe Kopf)
    v_on: u32,
    v_ctx: u64,
    v_x: fn(u64, u64, usize, usize) -> f64,
    v_hit: fn(u64, u64, usize, f64) -> usize,
    v_w: fn(u64, u64, usize) -> f64,
    v_rtl: fn(u64, u64, usize) -> bool,
}

#[no_gc]
fn clip_read_none(p: u64, cap: usize) -> usize { return 0 }
#[no_gc]
fn clip_write_none(p: u64, n: usize) -> bool { return false }
// Die Vorgaben ohne eingehaengte Messung. Sie werden nie gerufen,
// solange `v_on` 0 ist; ein Funktionszeiger braucht trotzdem ein Ziel.
fn vis_x_none(c: u64, p: u64, n: usize, i: usize) -> f64 { return 0.0 }
fn vis_hit_none(c: u64, p: u64, n: usize, x: f64) -> usize { return 0 }
fn vis_w_none(c: u64, p: u64, n: usize) -> f64 { return 0.0 }
fn vis_rtl_none(c: u64, p: u64, n: usize) -> bool { return false }

#[no_gc]
fn editor_new() -> Editor {
    return Editor {
        tf: textbuf.tb_new(),
        u_buf: 0 as *mut u8, u_len: [0; 16], u_caret: [0; 16],
        u_n: 0, u_at: 0, coalescing: 0,
        clip_read: clip_read_none, clip_write: clip_write_none, ab_da: 0,
        ab_buf: 0 as *mut u8, ab_n: 0,
        width: 0.0, scroll: 0.0,
        blink_us: 0, blink_an: 1,
        klick_zeit: 0, klick_n: 0, klick_x: 0.0,
        v_on: 0, v_ctx: 0, v_x: vis_x_none, v_hit: vis_hit_none,
        v_w: vis_w_none, v_rtl: vis_rtl_none,
    }
}

// `p`/`cap` is the text buffer and belongs to the caller -- the same
// rule as in textbuf.fi.
fn editor_init(e: *mut Editor, p: u64, cap: usize) -> bool {
    textbuf.tb_init(&(*e).tf, p, cap)
    (*e).u_buf = rt.heap_alloc(UNDO_N * UNDO_CAP) as *mut u8
    if (*e).u_buf as usize == 0 {
        return false
    }
    (*e).ab_buf = rt.heap_alloc(UNDO_CAP) as *mut u8
    if (*e).ab_buf as usize == 0 {
        return false
    }
    (*e).u_n = 0
    (*e).u_at = 0
    return true
}

fn editor_free(e: *mut Editor) {
    if (*e).u_buf as usize != 0 {
        rt.heap_free((*e).u_buf as u64, UNDO_N * UNDO_CAP)
        (*e).u_buf = 0 as *mut u8
    }
    if (*e).ab_buf as usize != 0 {
        rt.heap_free((*e).ab_buf as u64, UNDO_CAP)
        (*e).ab_buf = 0 as *mut u8
    }
}

#[no_gc]
fn editor_buf(e: *mut Editor) -> *mut textbuf.TextBuf {
    return &(*e).tf
}

fn editor_set_clipboard(e: *mut Editor, lesen: fn(u64, usize) -> usize,
    schreiben: fn(u64, usize) -> bool) {
    (*e).clip_read = lesen
    (*e).clip_write = schreiben
    (*e).ab_da = 1
}

#[no_gc]
fn editor_set_width(e: *mut Editor, w: f64) { (*e).width = w }

// DIE MESSUNG DER ZWEIRICHTUNGSSCHRIFT einhaengen (siehe Kopf).
fn editor_set_visual(e: *mut Editor, x: fn(u64, u64, usize, usize) -> f64,
    hit: fn(u64, u64, usize, f64) -> usize, w: fn(u64, u64, usize) -> f64,
    rtl: fn(u64, u64, usize) -> bool, ctx: u64) {
    (*e).v_x = x
    (*e).v_hit = hit
    (*e).v_w = w
    (*e).v_rtl = rtl
    (*e).v_ctx = ctx
    (*e).v_on = 1
}

fn editor_visual_on(e: *mut Editor) -> bool { return (*e).v_on != 0 }

// Laeuft der Absatz im Feld von rechts nach links? Ohne eingehaengte
// Messung: nein.
fn editor_is_rtl(e: *mut Editor) -> bool {
    if (*e).v_on == 0 {
        return false
    }
    let t: *mut textbuf.TextBuf = &(*e).tf
    return (*e).v_rtl((*e).v_ctx, textbuf.tb_ptr(t), textbuf.tb_len(t))
}

// Wo steht die Schreibmarke, relativ zum linken Textrand (vor dem
// Rollen)? Nur mit eingehaengter Messung -- sonst 0.
fn editor_caret_x(e: *mut Editor) -> f64 {
    if (*e).v_on == 0 {
        return 0.0
    }
    let t: *mut textbuf.TextBuf = &(*e).tf
    return (*e).v_x((*e).v_ctx, textbuf.tb_ptr(t), textbuf.tb_len(t),
        textbuf.tb_caret(t))
}

// Die Grenze unter x (Textkoordinate, also schon mit `scroll`).
fn vis_pos(e: *mut Editor, x: f64) -> usize {
    let t: *mut textbuf.TextBuf = &(*e).tf
    return (*e).v_hit((*e).v_ctx, textbuf.tb_ptr(t), textbuf.tb_len(t), x)
}

#[no_gc]
fn editor_scroll(e: *mut Editor) -> f64 { return (*e).scroll }

// ============================================================== UNDO

// Store the current state. `wegen_zeichen` says whether the change
// about to come is a single typed character -- then it is only stored
// when the last step was NOT a character.
fn editor_push_undo(e: *mut Editor, from_char: bool) {
    if from_char && (*e).coalescing != 0 {
        return
    }
    let n: usize = textbuf.tb_len(&(*e).tf)
    if n > UNDO_CAP {
        return
    }
    // Everything after the current position is overtaken: whoever
    // undoes and then types has a new branch.
    var at: usize = (*e).u_at
    if at >= UNDO_N {
        // The stack is full: the oldest step falls away.
        var i: usize = 1
        while i < UNDO_N {
            rt.mem_copy(((*e).u_buf as u64) + ((i - 1) * UNDO_CAP) as u64,
                ((*e).u_buf as u64) + (i * UNDO_CAP) as u64, UNDO_CAP)
            (*e).u_len[i - 1] = (*e).u_len[i]
            (*e).u_caret[i - 1] = (*e).u_caret[i]
            i = i + 1
        }
        at = UNDO_N - 1
    }
    rt.mem_copy(((*e).u_buf as u64) + (at * UNDO_CAP) as u64,
        textbuf.tb_ptr(&(*e).tf), n)
    (*e).u_len[at] = n
    (*e).u_caret[at] = textbuf.tb_caret(&(*e).tf)
    (*e).u_at = at + 1
    (*e).u_n = at + 1
    if from_char {
        (*e).coalescing = 1
    } else {
        (*e).coalescing = 0
    }
}

fn editor_undo(e: *mut Editor) -> bool {
    if (*e).u_at == 0 {
        return false
    }
    // If the pointer stands at the top end, the CURRENT state has to be
    // stored first -- otherwise it would be lost after the first Ctrl+Z
    // and Ctrl+Y would have nothing to return to.
    if (*e).u_at == (*e).u_n {
        let n: usize = textbuf.tb_len(&(*e).tf)
        if n <= UNDO_CAP && (*e).u_n < UNDO_N {
            rt.mem_copy(((*e).u_buf as u64) + ((*e).u_n * UNDO_CAP) as u64,
                textbuf.tb_ptr(&(*e).tf), n)
            (*e).u_len[(*e).u_n] = n
            (*e).u_caret[(*e).u_n] = textbuf.tb_caret(&(*e).tf)
            (*e).u_n = (*e).u_n + 1
        }
    }
    (*e).u_at = (*e).u_at - 1
    let at: usize = (*e).u_at
    textbuf.tb_set_text(&(*e).tf,
        ((*e).u_buf as u64) + (at * UNDO_CAP) as u64, (*e).u_len[at])
    textbuf.tb_set_range(&(*e).tf, (*e).u_caret[at], (*e).u_caret[at])
    (*e).coalescing = 0
    return true
}

fn editor_redo(e: *mut Editor) -> bool {
    if (*e).u_at + 1 >= (*e).u_n {
        return false
    }
    (*e).u_at = (*e).u_at + 1
    let at: usize = (*e).u_at
    textbuf.tb_set_text(&(*e).tf,
        ((*e).u_buf as u64) + (at * UNDO_CAP) as u64, (*e).u_len[at])
    textbuf.tb_set_range(&(*e).tf, (*e).u_caret[at], (*e).u_caret[at])
    (*e).coalescing = 0
    return true
}

// ======================================================= THE CLIPBOARD

fn editor_copy(e: *mut Editor) -> bool {
    if !textbuf.tb_has_sel(&(*e).tf) {
        return false
    }
    if textbuf.tb_secret(&(*e).tf) {
        // A password field gives nothing out.
        return false
    }
    let a: usize = textbuf.tb_sel_a(&(*e).tf)
    let b: usize = textbuf.tb_sel_b(&(*e).tf)
    let n: usize = b - a
    let von: u64 = textbuf.tb_ptr(&(*e).tf) + a as u64
    if (*e).ab_da != 0 {
        let f: fn(u64, usize) -> bool = (*e).clip_write
        if f(von, n) {
            return true
        }
    }
    // The internal clipboard -- better than nothing at all.
    var k: usize = n
    if k > UNDO_CAP {
        k = UNDO_CAP
    }
    rt.mem_copy((*e).ab_buf as u64, von, k)
    (*e).ab_n = k
    return true
}

fn editor_cut(e: *mut Editor) -> bool {
    if !textbuf.tb_has_sel(&(*e).tf) {
        return false
    }
    if !editor_copy(e) {
        return false
    }
    editor_push_undo(e, false)
    return textbuf.tb_delete_sel(&(*e).tf)
}

fn editor_paste(e: *mut Editor) -> bool {
    var puf: [u8; 512] = [0; 512]
    var n: usize = 0
    if (*e).ab_da != 0 {
        let f: fn(u64, usize) -> usize = (*e).clip_read
        n = f((&puf[0]) as u64, 512)
    }
    if n == 0 && (*e).ab_n > 0 {
        n = (*e).ab_n
        rt.mem_copy((&puf[0]) as u64, (*e).ab_buf as u64, n)
    }
    if n == 0 {
        return false
    }
    // LINE BREAKS BECOME SPACES. A one-line field with a line break in
    // it paints an empty rect -- and an address copied out of a text
    // file almost always brings one with it.
    var i: usize = 0
    while i < n {
        let c: u8 = *(((&puf[0]) as u64 + i as u64) as *mut u8)
        if c == 10 as u8 || c == 13 as u8 || c == 9 as u8 {
            *(((&puf[0]) as u64 + i as u64) as *mut u8) = 32 as u8
        }
        i = i + 1
    }
    editor_push_undo(e, false)
    return textbuf.tb_insert(&(*e).tf, (&puf[0]) as u64, n)
}

// ============================================================= THE KEYS

// A KEY WITH A MEANING. `mods` is the bit mask M_*.
//
// Here stands the whole key mapping of a text field in ONE place -- and
// that is the point: today it stands in lib/android/a_main.fi (phone)
// and not at all in lib/browser/certus_app.fi (desktop).
fn editor_key(e: *mut Editor, key: u32, mods: u32) -> u32 {
    let t: *mut textbuf.TextBuf = &(*e).tf
    let extend: bool = (mods & MOD_SHIFT) != 0 as u32
    let ctrl: bool = (mods & MOD_CTRL) != 0 as u32
    editor_caret_wake(e)

    if key == KEY_LEFT || key == KEY_RIGHT {
        // Logisch, mit der Richtung des Absatzes (siehe Kopf): in einem
        // RTL-Absatz fuehrt "links" im Text VORWAERTS.
        var fwd: bool = key == KEY_RIGHT
        if editor_is_rtl(e) {
            fwd = !fwd
        }
        if fwd {
            if ctrl {
                word_right(e, extend)
            } else {
                textbuf.tb_right(t, extend)
            }
        } else {
            if ctrl {
                word_left(e, extend)
            } else {
                textbuf.tb_left(t, extend)
            }
        }
        (*e).coalescing = 0
        return RES_MOVED
    }
    if key == KEY_HOME {
        textbuf.tb_home(t, extend)
        (*e).coalescing = 0
        return RES_MOVED
    }
    if key == KEY_END {
        textbuf.tb_end(t, extend)
        (*e).coalescing = 0
        return RES_MOVED
    }
    if key == KEY_BACKSPACE {
        editor_push_undo(e, false)
        // Ctrl+Backspace deletes the word to the left -- that is what
        // every field does. Only when nothing is selected: with a
        // selection, Backspace removes exactly that selection, and the
        // plain `tb_backspace` below already does it.
        if ctrl && !textbuf.tb_has_sel(t) {
            let bis: usize = textbuf.tb_caret(t)
            word_left(e, true)
            let von: usize = textbuf.tb_caret(t)
            textbuf.tb_set_range(t, von, von)
            let ok: bool = textbuf.tb_delete(t, von, bis)
            return RES_CHANGED
        }
        let ok2: bool = textbuf.tb_backspace(t)
        return RES_CHANGED
    }
    if key == KEY_DELETE {
        editor_push_undo(e, false)
        if ctrl && !textbuf.tb_has_sel(t) {
            let von: usize = textbuf.tb_caret(t)
            word_right(e, true)
            let bis: usize = textbuf.tb_caret(t)
            textbuf.tb_set_range(t, von, von)
            let ok: bool = textbuf.tb_delete(t, von, bis)
            return RES_CHANGED
        }
        let ok2: bool = textbuf.tb_delete_fwd(t)
        return RES_CHANGED
    }
    if key == KEY_ENTER {
        return RES_COMMIT
    }
    if key == KEY_ESC {
        return RES_CANCEL
    }
    return RES_PASS
}

// A TYPED CHARACTER. Separate from `editor_key`, because the window
// layer delivers it separately (EV_CHAR against EV_KEY) -- the
// separation Windows lays down with WM_CHAR/WM_KEYDOWN and X11
// reproduces.
//
// THE CTRL SHORTCUTS LIE HERE TOO. Reason: Windows sends Ctrl+A as
// WM_CHAR with the value 1 (a control character), not as a key. Whoever
// only serves `editor_key` NEVER gets to see Ctrl+A -- and that is
// exactly one way Justin's bug can have come about.
fn editor_char(e: *mut Editor, cp: u32, mods: u32) -> u32 {
    let t: *mut textbuf.TextBuf = &(*e).tf
    editor_caret_wake(e)
    let ctrl: bool = (mods & MOD_CTRL) != 0 as u32

    // Ctrl shortcuts: either as a control character (1..26) or as a
    // letter with the Ctrl bit set. Both ways are served.
    var k: u32 = 0
    if cp >= 1 as u32 && cp <= 26 as u32 {
        k = cp + 96 as u32           // 1 -> 'a'
    } else if ctrl {
        if cp >= 65 as u32 && cp <= 90 as u32 {
            k = cp + 32 as u32       // 'A' -> 'a'
        } else if cp >= 97 as u32 && cp <= 122 as u32 {
            k = cp
        }
    }
    if k != 0 as u32 {
        // ============================================================
        // CTRL+A -- JUSTIN'S BUG.
        // ============================================================
        // `tb_select_all` sets the anchor to 0 and the caret to n. The
        // next typed character goes through `tb_insert`, and that calls
        // `tb_replace(sel_a, sel_b, ...)` -- so the selection is
        // REPLACED and not added to. With that
        // "https://xoffi.ai/https://de.wikipedia" is no longer possible.
        if k == 97 as u32 {                    // a
            textbuf.tb_select_all(t)
            return RES_MOVED
        }
        if k == 99 as u32 {                    // c
            let ok: bool = editor_copy(e)
            return RES_NONE
        }
        if k == 120 as u32 {                   // x
            if editor_cut(e) {
                return RES_CHANGED
            }
            return RES_NONE
        }
        if k == 118 as u32 {                   // v
            if editor_paste(e) {
                return RES_CHANGED
            }
            return RES_NONE
        }
        if k == 122 as u32 {                   // z
            // Ctrl+Shift+Z is the second usual binding for redo.
            //
            if (mods & MOD_SHIFT) != 0 as u32 {
                if editor_redo(e) {
                    return RES_CHANGED
                }
                return RES_NONE
            }
            if editor_undo(e) {
                return RES_CHANGED
            }
            return RES_NONE
        }
        if k == 121 as u32 {                   // y
            if editor_redo(e) {
                return RES_CHANGED
            }
            return RES_NONE
        }
        // A Ctrl shortcut that means nothing to the field belongs to
        // the program: Ctrl+T opens a tab and must not land here as a
        // letter in the text.
        return RES_PASS
    }

    // Control characters other than the shortcuts never land in the text.
    if cp < 32 as u32 || cp == 127 as u32 {
        return RES_PASS
    }
    editor_push_undo(e, true)
    if !textbuf.tb_insert_cp(t, cp) {
        return RES_NONE
    }
    return RES_CHANGED
}

// ---- the word jumps
//
// `tb_word_at` gives the boundaries of the word AT a position. For the
// jump the next boundary in a direction is needed, and that is a
// different question: from the middle of a word Ctrl+Left goes to its
// start, from that start to the start of the word before it.
fn word_left(e: *mut Editor, extend: bool) {
    let t: *mut textbuf.TextBuf = &(*e).tf
    var i: usize = textbuf.tb_caret(t)
    if i == 0 {
        textbuf.tb_set_caret(t, 0, extend)
        return
    }
    // first over the non-word characters to the left
    while i > 0 {
        let j: usize = textbuf.tb_prev(t, i)
        if textbuf.tb_is_word_byte(byte_at(t, j)) {
            break
        }
        i = j
    }
    // then over the word
    while i > 0 {
        let j: usize = textbuf.tb_prev(t, i)
        if !textbuf.tb_is_word_byte(byte_at(t, j)) {
            break
        }
        i = j
    }
    textbuf.tb_set_caret(t, i, extend)
}

fn word_right(e: *mut Editor, extend: bool) {
    let t: *mut textbuf.TextBuf = &(*e).tf
    let n: usize = textbuf.tb_len(t)
    var i: usize = textbuf.tb_caret(t)
    // over the word
    while i < n {
        if !textbuf.tb_is_word_byte(byte_at(t, i)) {
            break
        }
        i = textbuf.tb_next(t, i)
    }
    // over the non-word characters
    while i < n {
        if textbuf.tb_is_word_byte(byte_at(t, i)) {
            break
        }
        i = textbuf.tb_next(t, i)
    }
    textbuf.tb_set_caret(t, i, extend)
}

#[no_gc]
fn byte_at(t: *mut textbuf.TextBuf, i: usize) -> u8 {
    if i >= textbuf.tb_len(t) {
        return 0 as u8
    }
    return *((textbuf.tb_ptr(t) + i as u64) as *mut u8)
}

// ============================================================= THE MOUSE
//
// `x` is the position IN THE TEXT (so already cleaned of `scroll`),
// `mess` measures the width of the first n bytes -- the same callback
// form textbuf.fi already uses.
//
// Single, double and triple click differ only in the time and in the
// distance. 400 ms is the span Windows (GetDoubleClickTime) supplies by
// default.
const DOPPEL_US: u64 = 400000

fn editor_mouse_down(e: *mut Editor, x: f64, jetzt_us: u64,
    mess: fn(u64, u64, usize) -> f64, ctx: u64, extend: bool) -> u32 {
    let t: *mut textbuf.TextBuf = &(*e).tf
    editor_caret_wake(e)
    var dx: f64 = x - (*e).klick_x
    if dx < 0.0 {
        dx = 0.0 - dx
    }
    if jetzt_us - (*e).klick_zeit < DOPPEL_US && dx < 4.0 {
        (*e).klick_n = (*e).klick_n + 1
    } else {
        (*e).klick_n = 1
    }
    (*e).klick_zeit = jetzt_us
    (*e).klick_x = x
    var pos: usize = 0
    if (*e).v_on != 0 {
        pos = vis_pos(e, x + (*e).scroll)
    } else {
        pos = textbuf.tb_caret_from_x(t, x + (*e).scroll, mess, ctx)
    }

    if (*e).klick_n >= 3 {
        // Triple click: everything.
        textbuf.tb_select_all(t)
        textbuf.tb_set_drag(t, 0)
        return RES_MOVED
    }
    if (*e).klick_n == 2 {
        // Double click: the word.
        textbuf.tb_select_word(t, pos)
        textbuf.tb_set_drag(t, 0)
        return RES_MOVED
    }
    textbuf.tb_set_caret(t, pos, extend)
    textbuf.tb_set_drag(t, 1)
    (*e).coalescing = 0
    return RES_MOVED
}

fn editor_mouse_drag(e: *mut Editor, x: f64,
    mess: fn(u64, u64, usize) -> f64, ctx: u64) -> u32 {
    let t: *mut textbuf.TextBuf = &(*e).tf
    if textbuf.tb_drag(t) == 0 as u32 {
        return RES_NONE
    }
    var pos: usize = 0
    if (*e).v_on != 0 {
        pos = vis_pos(e, x + (*e).scroll)
    } else {
        pos = textbuf.tb_caret_from_x(t, x + (*e).scroll, mess, ctx)
    }
    // `extend` is always true while dragging: the anchor stays where
    // the mouse went down.
    textbuf.tb_set_caret(t, pos, true)
    editor_caret_wake(e)
    return RES_MOVED
}

fn editor_mouse_up(e: *mut Editor) -> u32 {
    textbuf.tb_set_drag(&(*e).tf, 0)
    return RES_NONE
}

// ==================================================== THE BLINKING CARET
//
// 530 ms is the default of Windows (Control Panel, Keyboard) and lies
// between the 500 ms of GTK and the 600 ms of macOS.
const BLINK_US: u64 = 530000

// After every input the caret stands VISIBLE again. A caret that is
// invisible at exactly the moment somebody types looks like a field
// that has swallowed the key.
#[no_gc]
fn editor_caret_wake(e: *mut Editor) {
    (*e).blink_an = 1
    (*e).blink_us = 0
}

// Is the caret visible NOW? `jetzt_us` comes from the caller, so that
// this file needs no clock and stays controllable in the test bench.
fn editor_caret_tick(e: *mut Editor, jetzt_us: u64) -> bool {
    if (*e).blink_us == 0 {
        (*e).blink_us = jetzt_us
        (*e).blink_an = 1
        return true
    }
    if jetzt_us - (*e).blink_us >= BLINK_US {
        (*e).blink_us = jetzt_us
        if (*e).blink_an != 0 {
            (*e).blink_an = 0
        } else {
            (*e).blink_an = 1
        }
    }
    return (*e).blink_an != 0
}

#[no_gc]
fn editor_caret_on(e: *mut Editor) -> bool {
    return (*e).blink_an != 0
}

// ================================================ THE SCROLLING ON LONG TEXT
//
// The caret has to stay visible, otherwise you type blind. It is
// scrolled ONLY as far as necessary -- whoever keeps the caret always
// centred makes the text jump at every character.
fn editor_scroll_to_caret(e: *mut Editor, mess: fn(u64, u64, usize) -> f64,
    ctx: u64) {
    let t: *mut textbuf.TextBuf = &(*e).tf
    if (*e).width <= 0.0 {
        return
    }
    // Mit der Zweirichtungsschrift: die visuelle Lage der Marke und die
    // ganze Breite -- die Breite "bis zum letzten Oktett" ist in einem
    // RTL-Text die linke Kante und nicht die Breite.
    var cx: f64 = 0.0
    var total: f64 = 0.0
    if (*e).v_on != 0 {
        cx = editor_caret_x(e)
        total = (*e).v_w((*e).v_ctx, textbuf.tb_ptr(t), textbuf.tb_len(t))
    } else {
        cx = textbuf.tb_x_of(t, textbuf.tb_caret(t), mess, ctx)
        total = textbuf.tb_x_of(t, textbuf.tb_len(t), mess, ctx)
    }
    // run out to the left
    if cx < (*e).scroll {
        (*e).scroll = cx
    }
    // run out to the right. Two pixels of air, so that the caret does
    // not stick to the edge.
    let right: f64 = (*e).scroll + (*e).width - 2.0
    if cx > right {
        (*e).scroll = cx - (*e).width + 2.0
    }
    // Never scroll further than there is text.
    if (*e).scroll > total - (*e).width {
        (*e).scroll = total - (*e).width
    }
    if (*e).scroll < 0.0 {
        (*e).scroll = 0.0
    }
}

#[no_gc]
fn editor_scroll_x(e: *mut Editor) -> f64 { return (*e).scroll }

// ========================================================== CONVENIENCE

fn editor_select_all(e: *mut Editor) {
    textbuf.tb_select_all(&(*e).tf)
}

// Set text from outside (a new address after loading). The selection is
// gone afterwards and the caret stands at the end.
fn editor_set_text(e: *mut Editor, p: u64, n: usize) {
    editor_push_undo(e, false)
    textbuf.tb_set_text(&(*e).tf, p, n)
    (*e).scroll = 0.0
    editor_caret_wake(e)
}

fn editor_clear(e: *mut Editor) {
    editor_push_undo(e, false)
    textbuf.tb_clear(&(*e).tf)
    (*e).scroll = 0.0
    editor_caret_wake(e)
}
