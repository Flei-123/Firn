// SPDX-License-Identifier: MPL-2.0
import std.rt
import fui.svcq

export {
    read_path, write_path, store_get, store_set, clip_copy, clip_text,
    pick_open, pick_save, clip_request, script_pick, script_answer, answer, reset,
}

const FILES: usize = 16
const CELL: usize = 64
const STORE_PREFIX: str = "store/"
const ANS_OK: i32 = 1

static mut M_NAME: [u64; 16] = [0; 16]
static mut M_DATA: [u64; 16] = [0; 16]
static mut M_COUNT: usize = 0
static mut M_CLIP: u64 = 0
static mut M_PICK: u64 = 0
static mut M_ANSWER: i32 = 1

fn new_cell() -> u64 {
    let cell: *mut rt.Buf = rt.heap_alloc(CELL) as *mut rt.Buf
    *cell = rt.buf_new()
    return cell as u64
}

fn free_cell(addr: u64) {
    if addr == 0 as u64 {
        return
    }
    rt.buf_free(addr as *mut rt.Buf)
    rt.heap_free(addr, CELL)
}

fn fill_cell(addr: u64, p: u64, n: usize) {
    let b: *mut rt.Buf = addr as *mut rt.Buf
    rt.buf_clear(b)
    rt.buf_push_bytes(b, p, n)
}

fn cell_str(addr: u64) -> str {
    return rt.buf_str(addr as *mut rt.Buf)
}

fn same(a: str, b: str) -> bool {
    return a.n == b.n && rt.mem_eq(a.p as u64, b.p as u64, a.n)
}

fn find(name: str) -> usize {
    var i: usize = 0
    while i < M_COUNT {
        if same(cell_str(M_NAME[i]), name) {
            return i
        }
        i = i + 1
    }
    return FILES
}

fn read_path(name: str, out: *mut rt.Buf) -> bool {
    let at: usize = find(name)
    if at == FILES {
        return false
    }
    let s: str = cell_str(M_DATA[at])
    rt.buf_push_bytes(out, s.p as u64, s.n)
    return true
}

fn write_path(name: str, p: u64, n: usize) -> bool {
    var at: usize = find(name)
    if at == FILES {
        if M_COUNT == FILES {
            return false
        }
        at = M_COUNT
        M_COUNT = M_COUNT + 1
        M_NAME[at] = new_cell()
        M_DATA[at] = new_cell()
        fill_cell(M_NAME[at], name.p as u64, name.n)
    }
    fill_cell(M_DATA[at], p, n)
    return true
}

fn store_key(key: str, out: *mut rt.Buf) {
    rt.buf_push_bytes(out, STORE_PREFIX.p as u64, STORE_PREFIX.n)
    rt.buf_push_bytes(out, key.p as u64, key.n)
}

fn store_get(key: str, out: *mut rt.Buf) -> bool {
    var k: rt.Buf = rt.buf_new()
    store_key(key, &k)
    let ok: bool = read_path(rt.buf_str(&k), out)
    rt.buf_free(&k)
    return ok
}

fn store_set(key: str, p: u64, n: usize) -> bool {
    var k: rt.Buf = rt.buf_new()
    store_key(key, &k)
    let ok: bool = write_path(rt.buf_str(&k), p, n)
    rt.buf_free(&k)
    return ok
}

fn clip_copy(s: str) -> bool {
    if M_CLIP == 0 as u64 {
        M_CLIP = new_cell()
    }
    fill_cell(M_CLIP, s.p as u64, s.n)
    return true
}

fn clip_text() -> str {
    if M_CLIP == 0 as u64 {
        return ""
    }
    return cell_str(M_CLIP)
}

fn clip_request() -> bool {
    let s: str = clip_text()
    var status: u32 = 1 as u32
    if s.n == 0 {
        status = 0 as u32
    }
    return svcq.push(svcq.EV_CLIP, status, "", s.p as u64, s.n)
}

fn script_pick(name: str) {
    if M_PICK == 0 as u64 {
        M_PICK = new_cell()
    }
    fill_cell(M_PICK, name.p as u64, name.n)
}

fn picked() -> str {
    if M_PICK == 0 as u64 {
        return ""
    }
    return cell_str(M_PICK)
}

fn pick_open() -> bool {
    let name: str = picked()
    var data: rt.Buf = rt.buf_new()
    var ok: bool = name.n > 0 && read_path(name, &data)
    var status: u32 = 0 as u32
    if ok {
        status = 1 as u32
    }
    let r: bool = svcq.push(svcq.EV_OPENED, status, name, rt.buf_ptr(&data), rt.buf_len(&data))
    rt.buf_free(&data)
    return r
}

fn pick_save(suggested: str, p: u64, n: usize) -> bool {
    let name: str = picked()
    var status: u32 = 0 as u32
    if name.n > 0 && write_path(name, p, n) {
        status = 1 as u32
    }
    return svcq.push(svcq.EV_SAVED, status, name, 0, 0)
}

fn script_answer(a: i32) {
    M_ANSWER = a
}

fn answer() -> i32 {
    return M_ANSWER
}

fn reset() {
    var i: usize = 0
    while i < M_COUNT {
        free_cell(M_NAME[i])
        free_cell(M_DATA[i])
        i = i + 1
    }
    M_COUNT = 0
    free_cell(M_CLIP)
    free_cell(M_PICK)
    M_CLIP = 0
    M_PICK = 0
    M_ANSWER = ANS_OK
    svcq.clear()
}
