import std.rt
import std.time
import fui.ds_tokens
import fui.kitcolor
import fui.theme

export { skin, min_f, max_f, count_of, arg_num, arg_str, now_ms, inside }

fn skin(m: *mut theme.Theme, dark: bool) {
    ds_tokens.apply(m, dark, 0)
    ds_tokens.set_accent(m, 0)
    kitcolor.set_accent(ds_tokens.accent_color(0, dark))
}

fn min_f(a: f64, b: f64) -> f64 {
    if a < b { return a }
    return b
}

fn max_f(a: f64, b: f64) -> f64 {
    if a > b { return a }
    return b
}

fn inside(px: f64, py: f64, x: f64, y: f64, w: f64, h: f64) -> bool {
    return px >= x && px < x + w && py >= y && py < y + h
}

fn count_of(list: str) -> usize {
    if list.n == 0 { return 0 }
    var k: usize = 1
    var j: usize = 0
    while j < list.n {
        if rt.ld8(list.p as u64, j) == 124 as u8 { k = k + 1 }
        j = j + 1
    }
    return k
}

fn now_ms() -> i64 { return (time.monotonic_ns() / 1000000 as u64) as i64 }

fn flag_value(start: u64, name: str) -> u64 {
    var i: usize = 1
    while i + 1 < rt.arg_count(start) {
        let p: u64 = rt.arg_ptr(start, i)
        var k: usize = 0
        var same: bool = true
        while k < name.n {
            if rt.ld8(p, k) != rt.ld8(name.p as u64, k) { same = false }
            k = k + 1
        }
        if same && rt.ld8(p, name.n) == 0 as u8 { return rt.arg_ptr(start, i + 1) }
        i = i + 1
    }
    return 0
}

fn arg_num(start: u64, name: str) -> i64 {
    let p: u64 = flag_value(start, name)
    if p == 0 { return 0 - 1 }
    var v: i64 = 0
    var k: usize = 0
    while rt.ld8(p, k) >= 48 as u8 && rt.ld8(p, k) <= 57 as u8 {
        v = v * 10 + (rt.ld8(p, k) - 48 as u8) as i64
        k = k + 1
    }
    return v
}

fn arg_str(start: u64, name: str) -> str {
    let p: u64 = flag_value(start, name)
    if p == 0 { return "" }
    var n: usize = 0
    while rt.ld8(p, n) != 0 as u8 { n = n + 1 }
    return str { p: p as *mut u8, n: n }
}
