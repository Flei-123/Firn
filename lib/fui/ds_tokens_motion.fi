import fui.ds_tokens_prim

export {
    M_PRESS, M_HOVER, M_FOCUS, M_FADE, M_EXPAND, M_COLLAPSE, M_FLYOUT_OPEN, M_FLYOUT_CLOSE, M_DIALOG_OPEN, M_DIALOG_CLOSE, M_SLIDE, M_PAGE, M_TOAST_IN, M_TOAST_OUT,
    M_COUNT, MotionSpec, spec,
}

const M_PRESS: usize = 0
const M_HOVER: usize = 1
const M_FOCUS: usize = 2
const M_FADE: usize = 3
const M_EXPAND: usize = 4
const M_COLLAPSE: usize = 5
const M_FLYOUT_OPEN: usize = 6
const M_FLYOUT_CLOSE: usize = 7
const M_DIALOG_OPEN: usize = 8
const M_DIALOG_CLOSE: usize = 9
const M_SLIDE: usize = 10
const M_PAGE: usize = 11
const M_TOAST_IN: usize = 12
const M_TOAST_OUT: usize = 13
const M_COUNT: usize = 14

struct MotionSpec {
    ms: usize,
    ease: usize,
}

#[no_gc]
fn spec(role: usize) -> MotionSpec {
    if role == M_PRESS { return MotionSpec { ms: ds_tokens_prim.duration_ms(ds_tokens_prim.D_ULTRA_FAST), ease: ds_tokens_prim.EASE_LINEAR } }
    if role == M_HOVER { return MotionSpec { ms: ds_tokens_prim.duration_ms(ds_tokens_prim.D_QUICK), ease: ds_tokens_prim.EASE_LINEAR } }
    if role == M_FOCUS { return MotionSpec { ms: ds_tokens_prim.duration_ms(ds_tokens_prim.D_FASTER), ease: ds_tokens_prim.EASE_STANDARD } }
    if role == M_FADE { return MotionSpec { ms: ds_tokens_prim.duration_ms(ds_tokens_prim.D_FAST), ease: ds_tokens_prim.EASE_STANDARD } }
    if role == M_EXPAND { return MotionSpec { ms: ds_tokens_prim.duration_ms(ds_tokens_prim.D_SNAPPY), ease: ds_tokens_prim.EASE_DECELERATE } }
    if role == M_COLLAPSE { return MotionSpec { ms: ds_tokens_prim.duration_ms(ds_tokens_prim.D_QUICK), ease: ds_tokens_prim.EASE_ACCELERATE } }
    if role == M_FLYOUT_OPEN { return MotionSpec { ms: ds_tokens_prim.duration_ms(ds_tokens_prim.D_SNAPPY), ease: ds_tokens_prim.EASE_DECELERATE } }
    if role == M_FLYOUT_CLOSE { return MotionSpec { ms: ds_tokens_prim.duration_ms(ds_tokens_prim.D_QUICK), ease: ds_tokens_prim.EASE_ACCELERATE } }
    if role == M_DIALOG_OPEN { return MotionSpec { ms: ds_tokens_prim.duration_ms(ds_tokens_prim.D_GENTLE), ease: ds_tokens_prim.EASE_DECELERATE } }
    if role == M_DIALOG_CLOSE { return MotionSpec { ms: ds_tokens_prim.duration_ms(ds_tokens_prim.D_SNAPPY), ease: ds_tokens_prim.EASE_ACCELERATE } }
    if role == M_SLIDE { return MotionSpec { ms: ds_tokens_prim.duration_ms(ds_tokens_prim.D_GENTLE), ease: ds_tokens_prim.EASE_DECELERATE } }
    if role == M_PAGE { return MotionSpec { ms: ds_tokens_prim.duration_ms(ds_tokens_prim.D_SLOW), ease: ds_tokens_prim.EASE_STANDARD } }
    if role == M_TOAST_IN { return MotionSpec { ms: ds_tokens_prim.duration_ms(ds_tokens_prim.D_GENTLE), ease: ds_tokens_prim.EASE_DECELERATE } }
    return MotionSpec { ms: ds_tokens_prim.duration_ms(ds_tokens_prim.D_SNAPPY), ease: ds_tokens_prim.EASE_ACCELERATE }
}
