// SPDX-License-Identifier: MPL-2.0
import std.rt
import media.video.vidsource
import media.video.sync

export {
    KpVideo, kv_new, kv_open, kv_close, kv_seek, kv_update, kv_done, kv_has_frame, kv_frame, kv_width, kv_height,
    kv_duration_ms, kv_frame_no, kv_dropped, kv_shown, kv_pending_force, kv_cur_pts,
    UP_NONE, UP_FRAME,
}

const UP_NONE: u32 = 0
const UP_FRAME: u32 = 1
const DECODE_BUDGET: i32 = 8
const EARLY_US: i64 = 12000
const LATE_US: i64 = 90000
const RESYNC_US: i64 = 1500000

struct KpVideo {
    src: vidsource.VideoSource,
    open: bool,
    cur: u64,
    nxt: u64,
    bytes: usize,
    have_cur: bool,
    have_nxt: bool,
    cur_pts: i64,
    nxt_pts: i64,
    ended: bool,
    force: bool,
    holding: bool,
    dropped: u64,
    shown: u64,
    frame_no: u64,
}

fn kv_new() -> KpVideo {
    return KpVideo { src: vidsource.vs_new(), open: false, cur: 0 as u64, nxt: 0 as u64, bytes: 0, have_cur: false,
        have_nxt: false, cur_pts: 0, nxt_pts: 0, ended: false, force: false, holding: false, dropped: 0 as u64,
        shown: 0 as u64, frame_no: 0 as u64 }
}

fn kv_close(v: *mut KpVideo) {
    if (*v).cur != 0 as u64 {
        rt.heap_free((*v).cur, (*v).bytes)
        (*v).cur = 0 as u64
    }
    if (*v).nxt != 0 as u64 {
        rt.heap_free((*v).nxt, (*v).bytes)
        (*v).nxt = 0 as u64
    }
    vidsource.vs_close(&(*v).src)
    (*v).open = false
    (*v).bytes = 0
    (*v).have_cur = false
    (*v).have_nxt = false
    (*v).ended = false
    (*v).force = false
    (*v).holding = false
}

fn kv_open(v: *mut KpVideo, data: u64, n: usize) -> i32 {
    kv_close(v)
    (*v).src = vidsource.vs_new()
    (*v).dropped = 0 as u64
    (*v).shown = 0 as u64
    (*v).frame_no = 0 as u64
    let rc: i32 = vidsource.vs_open(&(*v).src, data, n)
    if rc != vidsource.VS_OK {
        return rc
    }
    let bytes: usize = vidsource.vs_rgba_bytes(&(*v).src)
    if bytes == 0 || bytes > 1 << 30 {
        vidsource.vs_close(&(*v).src)
        return vidsource.VS_ERR_FORMAT
    }
    (*v).bytes = bytes
    (*v).cur = rt.heap_alloc(bytes)
    (*v).nxt = rt.heap_alloc(bytes)
    if (*v).cur == 0 as u64 || (*v).nxt == 0 as u64 {
        kv_close(v)
        return vidsource.VS_ERR_DECODE
    }
    rt.mem_set((*v).cur, 0 as u8, bytes)
    (*v).open = true
    return vidsource.VS_OK
}

fn kv_width(v: *mut KpVideo) -> u32 {
    return vidsource.vs_width(&(*v).src)
}

fn kv_height(v: *mut KpVideo) -> u32 {
    return vidsource.vs_height(&(*v).src)
}

fn kv_duration_ms(v: *mut KpVideo) -> u64 {
    let d: i64 = vidsource.vs_duration_us(&(*v).src)
    if d <= 0 {
        return 0 as u64
    }
    return (d / 1000) as u64
}

fn kv_has_frame(v: *mut KpVideo) -> bool {
    return (*v).have_cur
}

fn kv_frame(v: *mut KpVideo) -> u64 {
    return (*v).cur
}

fn kv_frame_no(v: *mut KpVideo) -> u64 {
    return (*v).frame_no
}

fn kv_cur_pts(v: *mut KpVideo) -> i64 {
    return (*v).cur_pts
}

fn kv_dropped(v: *mut KpVideo) -> u64 {
    return (*v).dropped
}

fn kv_shown(v: *mut KpVideo) -> u64 {
    return (*v).shown
}

fn kv_done(v: *mut KpVideo) -> bool {
    return (*v).ended && !(*v).have_nxt
}

fn kv_pending_force(v: *mut KpVideo) -> bool {
    return (*v).force && !kv_done(v)
}

fn kv_seek(v: *mut KpVideo, target_us: i64) {
    if !(*v).open {
        return
    }
    var t: i64 = target_us
    if t < 0 {
        t = 0
    }
    vidsource.vs_seek(&(*v).src, t)
    (*v).have_nxt = false
    (*v).ended = false
    (*v).force = true
    (*v).holding = false
}

fn swap_frames(v: *mut KpVideo) {
    let t: u64 = (*v).cur
    (*v).cur = (*v).nxt
    (*v).nxt = t
    (*v).cur_pts = (*v).nxt_pts
    (*v).have_cur = true
    (*v).have_nxt = false
    (*v).shown = (*v).shown + (1 as u64)
    (*v).frame_no = (*v).frame_no + (1 as u64)
    (*v).force = false
    (*v).holding = false
}

fn fetch(v: *mut KpVideo) -> bool {
    var pts: i64 = 0
    let r: i32 = vidsource.vs_next_frame(&(*v).src, (*v).nxt, &pts)
    if r > 0 {
        (*v).have_nxt = true
        (*v).nxt_pts = pts
        return true
    }
    (*v).ended = true
    return false
}

fn kv_update(v: *mut KpVideo, clock_us: i64) -> u32 {
    if !(*v).open {
        return UP_NONE
    }
    var budget: i32 = DECODE_BUDGET
    while budget > 0 {
        budget = budget - 1
        if !(*v).have_nxt {
            if (*v).ended || !fetch(v) {
                return UP_NONE
            }
        }
        var d: i32 = sync.sync_decide((*v).nxt_pts, clock_us, EARLY_US, LATE_US)
        if (*v).force && d != sync.SYNC_DROP {
            d = sync.SYNC_SHOW
        }
        if d == sync.SYNC_SHOW {
            swap_frames(v)
            return UP_FRAME
        }
        if d == sync.SYNC_WAIT {
            return UP_NONE
        }
        if !(*v).holding && clock_us - (*v).nxt_pts > RESYNC_US {
            (*v).holding = true
            vidsource.vs_seek(&(*v).src, clock_us)
            (*v).have_nxt = false
            (*v).ended = false
            (*v).dropped = (*v).dropped + (1 as u64)
        } else {
            (*v).have_nxt = false
            (*v).dropped = (*v).dropped + (1 as u64)
        }
    }
    return UP_NONE
}
