// SPDX-License-Identifier: MPL-2.0
// lib/fui/app.fi -- A WINDOW IN TEN LINES.
//
// ========================================================= WHY IT EXISTS
//
// Justin, 29.09.2026: "Can you open a window with Firn as easily as with
// Python's tkinter?" The honest answer that day was no. The tkinter
// "Test Window" -- a label in a 16 point font, a Close button -- took 81
// lines of code against scene.fi, sheet.fi, fuiwirt.fi and fuiwin.fi,
// plus a symlink window/backend.fi next to the program
// (examples/fui/lowlevel/hello_lowlevel.fi keeps that version). Every
// one of those lines was plumbing the program does not care about: a
// font set, a canvas, a render context, a host, a stylesheet rule for
// one font size, a hand-written event loop.
//
// This file is the layer on top. The same window:
//
//     import fui.app
//
//     fn close(a: *mut app.App) {
//         app.quit(a)
//     }
//
//     fn main() -> i32 {
//         let a: *mut app.App = app.window("Test Window", 400, 250)
//         app.label(a, "Hello, this is a test window!", 16)
//         app.button(a, "Close", close)
//         return app.run(a)
//     }
//
// ========================================================= WHAT IS HIDDEN
//
// The platform. `import fui.apphost` resolves by TARGET, not by symlink:
// firnc looks into lib/@<platform>/ first (compiler/src/target.rs,
// `platform_dir`), so a native build gets lib/@linux/fui/apphost.fi (an
// X11 window through lib/plat/fuiwin.fi) and `--target=wasm32-browser`
// gets lib/@web/fui/apphost.fi (the canvas of lib/plat/web.fi). This file
// imports neither; it only fills in `apphost.Hooks`. The window loop, the
// font (DejaVu Sans natively, the page's font in the browser), the theme
// (light or dark as the system says), the scale (Xft.dpi, devicePixelRatio),
// the focus chain (Tab / Shift+Tab), Enter and the space bar on a button,
// the mouse -- all of it lives in those two files and in fuiwirt.fi,
// which is ONE implementation of the controls for every platform.
//
// ========================================================= THE MODEL
//
// Widgets are added top to bottom into the current CONTAINER. The window
// itself is a column whose children stand centred with a gap -- tkinter's
// `pack()` default. `row(a)` / `column(a)` open a nested container,
// `end(a)` closes it. Every add returns an id (the node of the scene),
// which `set_text`, `text`, `set_number` take.
//
// Callbacks are plain functions `fn(*mut app.App)`; state lives in
// `static mut` of the program or behind `app.data(a)`.
//
// ========================================================= LIMITS (today)
//
//   * 4096 nodes per window (scene.SCENE_MAX), 8 text fields, 256 octets
//     per text; beyond that an add returns NONE and changes nothing.
//   * One window. A second one is lib/plat/fuiwin.fi's window_step.
//   * A click into a text field focuses it and puts the caret at the click;
//     dragging selects, a double click selects the word. A text area
//     (`textarea`) wraps and scrolls; its wheel and Shift-less clicks work
//     the same way.
//   * No Win32 / Android host yet (lib/@win32, lib/@android): the fUi
//     roadmap has them.
import std.rt
import std.time
import fui.theme
import fui.style
import fui.painter
import fui.render
import fui.control
import fui.scene
import fui.sheet
import fui.flex
import fui.widget
import fui.editor
import fui.textbuf
import fui.textarea
import fui.listrow
import fui.anim
import fui.query
import plat.fuiwirt
import fui.event
import fui.audit
import fui.a11y
import fui.action
import fui.ctxmenu
import fui.ctxstd
import fui.menuview
import fui.apphost
import fui.vlist
import fui.vlistview
import fui.viewport
import fui.uiimage
import fui.uisvg
import paint.canvas
import window.hostmetrics

export {
    node_set_click, node_clear_click, vlist_forget_click, activated, area_height_pt, area_set_metrics,
    // r145: more containers and display nodes
    card, groupbox, separator, separator_v, badge, image, icon, open_kind_box,
    App, window, label, button, entry, textarea, textarea_auto, lines_of, row, column, grid_box, end, spacer,
    list, list_item, chosen,
    set_text, append_text, set_number, text, number, quit, run, touch_rotated, set_text_scoped, rot_only_frames,
    focused_field, set_data, data, set_text_mn, text_caret, set_text_caret, set_pump, set_window_hooks, set_pre_open, follow_host, set_insets, set_root_pad, inset, set_text_scale, set_secret, set_ime_next, set_focus, set_dark, focus, root, on, audit,
    // r161: context menus and actions
    actions, context, action_add, on_context, on_context_global, std_edit,
    set_language, open_context, ctx_view, bind_action, set_locked, menu_manifest,
    set_proxy_call,
    // additive hooks for dialogs (colordlg): a custom node, key and edit hooks
    custom, ax, on_key, on_edit, on_pointer, set_width, set_invalid,
    // lib/fui/lay.fi (CSS-style layout): a container with the caller's own settings, text alignment of one node
    open_box, set_text_align,
    // r177 (file dialog): the keys, characters and wheel a program with a custom
    // control wants before anyone else (KEYX_* = keys the hosts forward as codes
    // of their own)
    set_keys, set_wheel, set_motion, KEYX_F5,
    // lib/fui/appctl.fi: the standard controls plug into the window here
    set_ctl, set_ctl_edit, node_new, app_ctx, ctl_ready, ctl_data,
    // r631: the virtual list (lib/fui/vlist.fi + vlistview.fi) as a node of the window
    vlist_new, vlist_set_count, vlist_changed, vlist_model, vlist_selected, vlist_select,
    vlist_set_row_pt, vlist_set_bar_pt, vlist_on_pick, vlist_on_activate, vlist_on_long, vlist_on_sort, vlist_moving, set_extra_wake, extra_wake_tick, extra_wake_wait,
    VL_MAX,
    NONE,
    // the side a host and the tests see (lib/@*/fui/apphost.fi,
    // tools/fui/app_main.fi)
    refresh_hz, fit_stat, frame_wait_ms, frame_stats_on, frame_stats_reset, frame_stat, frame_phase, FS_FRAMES, FS_AVG_US, FS_MAX_US, FS_SLOW, FS_IV_P95_US, FS_IV_MAX_US,
    app_paint, app_attach, app_key, app_char, app_press, app_act,
    app_done, app_host, app_theme, app_entry_box, app_entry_buf, app_scene, app_reduced_motion,
    app_hook,
    ENTRIES_MAX, TEXT_CAP,
}

const NONE: usize = 4294967295
// keys beyond editor.KEY_*: F5 (a host that forwards it uses this code)
const KEYX_F5: u32 = 100
const ENTRIES_MAX: usize = 16
const TEXT_CAP: usize = 256
const STACK_MAX: usize = 16
// design points: tkinter's pack() puts widgets close together; these are
// fUi's own spacing steps (theme.fi)
const GAP: i64 = 14
const ROW_GAP: i64 = 10
const PAD: i64 = 16
const ENTRY_W: usize = 240
// a text area: its width and one row's height in design points, the text it
// holds (bytes; undo steps are as big, so a whole text can always be undone)
const AREA_W: usize = 320
const AREA_ROW_PT: usize = 20
const AREA_PAD_PT: usize = 16
const AREA_CAP: usize = 4096
// a finger moves this far (pixels) before it is a swipe and no longer a tap
const TOUCH_SLOP: f64 = 8.0
// virtual lists in one window (each is ONE scene node, whatever its row count)
const VL_MAX: usize = 8
// what the pointer is dragging in a virtual list
const VD_NONE: u32 = 0
const VD_BAR: u32 = 1
const VD_COL: u32 = 2
const VD_TOUCH: u32 = 3
// a second click on the same row within this many ms is a double click
const VL_DBL_MS: i64 = 500
// a finger slower than this (px per ms) does not fling
const VL_FLING_MIN: f64 = 0.05

// ONE VIRTUAL LIST of the window (vlist_new): the model, the source of the rows, the three callbacks
// and the pointer state. The scene node paints through vl_draw with a pointer to this slot as `ud`.
struct VlSlot {
    a: u64,
    node: usize,
    v: vlist.Vlist,
    src: fn(u64, usize, *mut vlist.VRow),
    src_ud: u64,
    pick: fn(*mut App, usize, usize),
    act: fn(*mut App, usize, usize),
    sort: fn(*mut App, usize, usize),
    // long press / tap on the right edge of a row (touch): true = handled, no click
    lp: fn(*mut App, usize, usize) -> bool,
    // row height in design points (0 = the theme's row height)
    row_pt: usize,
    // painted in the last frame: a list on a hidden page keeps a stale rectangle and must not hear the pointer
    live: bool,
    drag: u32,
    last_row: usize,
    last_ms: i64,
    t_y0: f64,
    t_y: f64,
    t_ms: i64,
    t_vy: f64,
    // a48: velocity tracker ring (finger y in px, monotonic microseconds); the last ~100 ms decide the fling
    tr_y: [f64; 16],
    tr_t: [i64; 16],
    tr_n: usize,
    t_moved: bool,
    t_row: usize,
    t_x: f64,
}

struct App {
    sc: scene.Scene,
    sh: sheet.Sheet,
    m: theme.Theme,
    c: render.Ctx,
    w: fuiwirt.Host,
    hk: apphost.Hooks,
    // the open containers, innermost last
    stack: [usize; 16],
    depth: usize,
    // per node: a click handler, and the node's own text
    // (r102: heap blocks of scene.SCENE_MAX entries, mapped in `window`;
    // read and written through cb_get/cb_put, hcb_*, tlen_*, wrp_*)
    cbs: u64,
    hcbs: u64,
    texts: u64,
    tlens: u64,
    // labels this frame had to wrap (fit_labels)
    wrps: u64,
    // the text fields: their editor, their node, their hint
    ed: [editor.Editor; 16],
    ed_node: [usize; 16],
    // r444b: where the focused field's caret was painted last (x, y, height in window pixels) -> the input method's candidate window
    spot: [f64; 3],
    spot_ok: bool,
    hint: [str; 16],
    // a text area is a slot of the same table (several lines, textarea.fi)
    area: [bool; 16],
    lines: [textarea.Lines; 16],
    // r385: rows of each text area, its sheet rule, and the text scale its height was last computed for
    area_rows: [usize; 16],
    area_row_pt: [usize; 16], // a64: per text area row height / padding in pt (0 = the AREA_ROW_PT / AREA_PAD_PT default)
    area_pad_pt: [usize; 16],
    area_rule: [usize; 16],
    // textarea_auto: the smallest and largest row count of a growing text area (area_max 0 = fixed height)
    area_min: [usize; 16],
    area_max: [usize; 16],
    area_ts: usize,
    // the slot the mouse is dragging a selection in (NONE = none), and the
    // pointer where it was last seen (the wheel has no position of its own)
    drag_k: usize,
    // a finger on a text area (r127): it scrolls instead of selecting; a tap
    // that did not move puts the caret. touch_k = NONE: no finger down there
    touch_k: usize,
    touch_x: f64,
    touch_y: f64,
    touch_moved: bool,
    ptr_x: f64,
    ptr_y: f64,
    n_ed: usize,
    ed_bufs: u64,
    quit: bool,
    user: u64,
    // THE EVENT ROUTER (lib/fui/event.fi), attached to the host by the first
    // `on`; next_key numbers the nodes that get a key for their handlers
    rt: event.Router,
    next_key: u32,
    rt_on: bool,
    // the hover/press transitions of the buttons (r126), bound to c and the host
    tr: anim.TransReg,
    // lists with rows (list / list_item): the rules are in the sheet
    lists_on: bool,
    // what the program says for accessibility: a text field is named by its
    // hint (the grey text in the empty field)
    ax: a11y.A11y,
    // the context menu state (CtxApp), made on first use; 0 = none (r161)
    cs: u64,
    // W44-c: the system bars over the window (device pixels: left, top, right, bottom), put on the root column as padding by `set_insets`
    ins: [f64; 4],
    // a68: the padding of the root column besides the insets (default PAD; an app that draws edge to edge sets 0 with set_root_pad)
    rpad: i64,
    // dialogs: a key hook that hears every key BEFORE the focused text field
    // (true = taken) and an edit hook that hears a text field AFTER it changed
    key_hook: fn(*mut App, u32, u32) -> bool,
    has_key_hook: bool,
    edit_hook: fn(*mut App, usize),
    has_edit_hook: bool,
    // dialogs: the raw pointer (HOOK_MOVE / LEAVE / DOWN / UP) with its position
    ptr_hook: fn(*mut App, u32, f64, f64) -> bool,
    has_ptr_hook: bool,
    // dialogs: a text field whose text is not valid (yet) is ringed in the
    // error colour (set_invalid)
    bad: [bool; 16],
    // r177: a program's first look at keys, characters and the wheel (set_keys,
    // set_wheel); kh_on false = nobody
    kh_on: bool,
    // '&' mnemonics in label/button texts (set_text_mn)
    mn_on: bool,
    kh_ud: u64,
    kh_key: fn(u64, u32, u32) -> bool,
    kh_chr: fn(u64, u32, u32) -> bool,
    wh_on: bool,
    wh_f: fn(u64, f64, f64, f64, f64) -> bool,
    mo_on: bool,
    mo_f: fn(u64, u32, f64, f64) -> bool,
    // lib/fui/appctl.fi: ONE plug for the standard controls (checkbox, slider, menu bar,
    // dialogs ...): their key / character / pointer / activation / overlay-paint handlers
    ctl_on: bool,
    ctl_ud: u64,
    ctl_key: fn(u64, u32, u32) -> bool,
    ctl_chr: fn(u64, u32, u32) -> bool,
    ctl_ptr: fn(u64, u32, f64, f64) -> bool,
    ctl_act: fn(u64, usize),
    ctl_paint: fn(u64, *mut render.Ctx, usize, usize),
    ctl_edit: fn(u64, usize),
    // r631: the virtual lists
    vl: [VlSlot; 8],
    vl_n: usize,
    // a63: an extra program timer (a view that scrolls/animates by itself, e.g. the chat's markdown view): tick(ud, now) = paint again, wait(ud, now) = ms to the next tick (-1: none)
    xw_ud: u64,
    xw_tick: fn(u64, i64) -> bool,
    xw_wait: fn(u64, i64) -> i64,
    last_act: usize,
}

fn cb_none(a: *mut App) {
}

fn key_none(a: *mut App, key: u32, mods: u32) -> bool {
    return false
}

fn edit_none(a: *mut App, id: usize) {
}

fn ptr_none(a: *mut App, kind: u32, x: f64, y: f64) -> bool {
    return false
}
fn kh_key_none(ud: u64, key: u32, mods: u32) -> bool { return false }
fn wh_none(ud: u64, x: f64, y: f64, nx: f64, ny: f64) -> bool { return false }
fn mo_none(ud: u64, kind: u32, x: f64, y: f64) -> bool { return false }
fn mo_none_b(ud: u64, kind: u32, x: f64, y: f64) -> bool { return false }
fn ctl_act_none(ud: u64, i: usize) {}
fn ctl_paint_none(ud: u64, c: *mut render.Ctx, w: usize, h: usize) {}
fn ctl_edit_none(ud: u64, node: usize) {}
fn vl_src_none(ud: u64, i: usize, r: *mut vlist.VRow) {}
fn vl_cb_none(a: *mut App, id: usize, i: usize) {}
fn vl_lp_none(a: *mut App, id: usize, i: usize) -> bool { return false }

fn vslot_blank() -> VlSlot {
    return VlSlot { a: 0, node: 4294967295, v: vlist.vl_new(), src: vl_src_none, src_ud: 0,
        pick: vl_cb_none, act: vl_cb_none, sort: vl_cb_none, lp: vl_lp_none, row_pt: 0, live: false, drag: VD_NONE,
        last_row: 4294967295, last_ms: 0 - 1000000, t_y0: 0.0, t_y: 0.0, t_ms: 0, t_vy: 0.0, tr_y: [0.0; 16], tr_t: [0; 16], tr_n: 0,
        t_moved: false, t_row: 4294967295, t_x: 0.0 }
}

// How big an App is -- measured like lib/plat/web.fi measures a Web:
// there is no size_of in stage 0, and a written number would be wrong the
// day a field is added.
fn app_size() -> usize {
    var probe: [App; 2] = [app_blank(); 2]
    return ((&probe[1]) as usize) - ((&probe[0]) as usize)
}

// ====================================================== PER-NODE TABLES
//
// The click handler, the own text length and the "wrapped" flag of every
// node. They were [..; 128] arrays inside the App; now they are heap
// blocks of scene.SCENE_MAX entries (zero pages: only the used part costs
// memory). An index past SCENE_MAX reads as "none" and writes nothing.
fn cb_get(a: *mut App, i: usize) -> fn(*mut App) {
    if i >= scene.SCENE_MAX || (*a).cbs == 0 {
        return cb_none
    }
    return *(((*a).cbs + (i * 8) as u64) as *mut fn(*mut App))
}

fn cb_put(a: *mut App, i: usize, f: fn(*mut App)) {
    if i < scene.SCENE_MAX && (*a).cbs != 0 {
        *(((*a).cbs + (i * 8) as u64) as *mut fn(*mut App)) = f
    }
}

fn hcb_get(a: *mut App, i: usize) -> bool {
    if i >= scene.SCENE_MAX || (*a).hcbs == 0 {
        return false
    }
    return *(((*a).hcbs + i as u64) as *mut u8) != (0 as u8)
}

fn hcb_put(a: *mut App, i: usize, v: bool) {
    if i < scene.SCENE_MAX && (*a).hcbs != 0 {
        if v {
            *(((*a).hcbs + i as u64) as *mut u8) = 1 as u8
        } else {
            *(((*a).hcbs + i as u64) as *mut u8) = 0 as u8
        }
    }
}

fn tlen_get(a: *mut App, i: usize) -> usize {
    if i >= scene.SCENE_MAX || (*a).tlens == 0 {
        return 0
    }
    return *(((*a).tlens + (i * 8) as u64) as *mut usize)
}

fn tlen_put(a: *mut App, i: usize, n: usize) {
    if i < scene.SCENE_MAX && (*a).tlens != 0 {
        *(((*a).tlens + (i * 8) as u64) as *mut usize) = n
    }
}

fn wrp_get(a: *mut App, i: usize) -> bool {
    if i >= scene.SCENE_MAX || (*a).wrps == 0 {
        return false
    }
    return *(((*a).wrps + i as u64) as *mut u8) != (0 as u8)
}

fn wrp_put(a: *mut App, i: usize, v: bool) {
    if i < scene.SCENE_MAX && (*a).wrps != 0 {
        if v {
            *(((*a).wrps + i as u64) as *mut u8) = 1 as u8
        } else {
            *(((*a).wrps + i as u64) as *mut u8) = 0 as u8
        }
    }
}

// For library widgets built on the tree (file dialog): attach / remove a
// click handler of node `i`.
// The node whose activation (tap, Enter, space, screen-reader action) ran the
// click handler that is running now; NONE before the first one. A handler of
// type fn(*mut App) has no id parameter -- this is how a shared handler learns
// which node it was called for (lib/fui/mobile.fi uses it).
fn activated(a: *mut App) -> usize {
    return (*a).last_act
}

fn node_set_click(a: *mut App, i: usize, f: fn(*mut App)) {
    cb_put(a, i, f)
    hcb_put(a, i, true)
}

fn node_clear_click(a: *mut App, i: usize) {
    hcb_put(a, i, false)
}

fn app_blank() -> App {
    return App { sc: scene.scene_new(), sh: sheet.sheet_new(),
        m: theme.theme_new(false),
        c: render.ctx_new(0 as u64 as *mut theme.Theme,
            0 as u64 as *mut painter.Painter),
        w: fuiwirt.host_new(0 as u64 as *mut scene.Scene,
            0 as u64 as *mut render.Ctx),
        hk: apphost.hooks_blank(),
        stack: [0; 16], depth: 0,
        cbs: 0, hcbs: 0, texts: 0,
        tlens: 0, wrps: 0,
        ed: [editor.editor_new(); 16], ed_node: [NONE; 16], spot: [0.0; 3], spot_ok: false, hint: [""; 16],
        area: [false; 16], lines: [textarea.ta_new(); 16], area_rows: [0; 16], area_row_pt: [0; 16], area_pad_pt: [0; 16], area_rule: [0; 16], area_min: [0; 16], area_max: [0; 16], area_ts: 1000, drag_k: NONE,
        touch_k: NONE, touch_x: 0.0, touch_y: 0.0, touch_moved: false,
        ptr_x: 0.0, ptr_y: 0.0,
        n_ed: 0, ed_bufs: 0, quit: false, user: 0,
        rt: event.router_new(), next_key: 60000 as u32, rt_on: false, lists_on: false,
        ax: a11y.a11y_new(), tr: anim.transreg_new(), cs: 0, ins: [0.0; 4], rpad: PAD,
        key_hook: key_none, has_key_hook: false, edit_hook: edit_none,
        has_edit_hook: false, ptr_hook: ptr_none, has_ptr_hook: false, bad: [false; 16],
        kh_on: false, mn_on: false, kh_ud: 0, kh_key: kh_key_none, kh_chr: kh_key_none,
        wh_on: false, wh_f: wh_none, mo_on: false, mo_f: mo_none,
        ctl_on: false, ctl_ud: 0, ctl_key: kh_key_none, ctl_chr: kh_key_none, ctl_ptr: mo_none_b,
        ctl_act: ctl_act_none, ctl_paint: ctl_paint_none, ctl_edit: ctl_edit_none,
        vl: [vslot_blank(); 8], vl_n: 0, xw_ud: 0, xw_tick: xw_tick_none, xw_wait: xw_wait_none, last_act: NONE }
}

// ============================================================ ACTIONS AND CONTEXT MENUS (r161)
//
// ONE registry of actions (lib/fui/action.fi), ONE manager (lib/fui/ctxmenu.fi)
// and ONE popup widget (lib/fui/menuview.fi) per window, made on the first
// use -- a program that never asks for a menu pays nothing but the pointer.
//
//     fn copy(ud: u64, cx: *mut action.ActCtx) {
//         let a: *mut app.App = ud as *mut app.App
//         ...
//     }
//     fn rows_menu(ud: u64, pc: *mut ctxmenu.ProviderCtx) {
//         let e: usize = ctxmenu.pc_add(pc, action.act_find(app.actions(a), "copy"))
//     }
//     let c: usize = app.action(a, "copy", "&Copy", copy)
//     action.act_set_shortcut(app.actions(a), c, 67 as u32, action.MOD_CTRL)
//     app.on_context(a, list, rows_menu)         // right click, long press,
//                                                // menu key, Shift+F10: one menu
//     app.std_edit(a)                            // text fields: Cut Copy Paste ...
//
// The handler's `ud` is the App. The same action serves the menu, its
// shortcut, the screen reader's default action and the action bus
// (`action.act_manifest`, `action.act_run_bus`).

struct CtxApp {
    acts: action.Actions,
    cm: ctxmenu.Ctxm,
    set: ctxstd.StdSet,
    cat_en: action.Catalog,
    cat_de: action.Catalog,
    mv: *mut menuview.MenuView,
    edit_on: bool,
}

fn app_sel_item(ud: u64, sc: *mut scene.Scene, n: usize) -> u32 {
    let row: u32 = listrow.listrow_names().row
    var k: usize = n
    while k != scene.SCENE_NONE && k < scene.scene_count(sc) {
        if scene.node_has_class(sc, k, row) {
            return scene.node_id(sc, k)
        }
        k = scene.scene_parent(sc, k)
    }
    return 0 as u32
}

fn app_sel_is(ud: u64, key: u32) -> bool {
    let a: *mut App = ud as *mut App
    let n: usize = scene.scene_find_id(&(*a).sc, key)
    if n == scene.SCENE_NONE { return false }
    return scene.node_has_class(&(*a).sc, n, listrow.listrow_names().sel)
}

fn app_sel_only(ud: u64, key: u32) {
    let a: *mut App = ud as *mut App
    let n: usize = scene.scene_find_id(&(*a).sc, key)
    if n == scene.SCENE_NONE { return }
    let ok: bool = listrow.listrow_select(&(*a).sc, scene.scene_parent(&(*a).sc, n), key)
    fuiwirt.host_touch(&(*a).w)
}

fn app_sel_clear(ud: u64) {
    let a: *mut App = ud as *mut App
    let cl: u32 = listrow.listrow_names().list
    var i: usize = 0
    while i < scene.scene_count(&(*a).sc) {
        if scene.node_has_class(&(*a).sc, i, cl) {
            let ok: bool = listrow.listrow_select(&(*a).sc, i, 0 as u32)
        }
        i = i + 1
    }
    fuiwirt.host_touch(&(*a).w)
}

fn app_sel_count(ud: u64) -> usize {
    let a: *mut App = ud as *mut App
    let sel: u32 = listrow.listrow_names().sel
    var c: usize = 0
    var i: usize = 0
    while i < scene.scene_count(&(*a).sc) {
        if scene.node_has_class(&(*a).sc, i, sel) { c = c + 1 }
        i = i + 1
    }
    return c
}

// A menu closed: the page repaints; the focus stays where it was.
fn app_ctx_closed(ud: u64, reason: u32) {
    let a: *mut App = ud as *mut App
    fuiwirt.host_touch(&(*a).w)
}

// A LONG PRESS of a finger or a pen = a context request (the mouse has its
// right button). The router's arena sends it only when somebody listens.
fn app_long_press(ud: u64, e: *mut event.Ev) -> u32 {
    let a: *mut App = ud as *mut App
    var src: u32 = action.SRC_TOUCH
    if event.ev_ptype(e) == event.PT_MOUSE { return event.H_GO }
    if event.ev_ptype(e) == event.PT_PEN { src = action.SRC_PEN }
    let ch: u32 = fuiwirt.host_context(&(*a).w, src, event.ev_target(e),
        event.ev_x(e), event.ev_y(e), event.ev_y(e))
    return event.H_PREVENT
}

// The state, made on first use. 0 when there is no memory.
fn ctx_state(a: *mut App) -> *mut CtxApp {
    if (*a).cs != 0 {
        return (*a).cs as *mut CtxApp
    }
    var probe: [CtxApp; 2] = [ctxapp_blank(); 2]
    let n: usize = ((&probe[1]) as usize) - ((&probe[0]) as usize)
    let p: u64 = rt.heap_alloc(n)
    if p == 0 {
        return 0 as u64 as *mut CtxApp
    }
    let cs: *mut CtxApp = p as *mut CtxApp
    *cs = ctxapp_blank()
    (*a).cs = p
    ctxmenu.ctxm_set_actions(&(*cs).cm, &(*cs).acts)
    ctxmenu.ctxm_set_ud(&(*cs).cm, a as u64)
    ctxstd.std_catalog_en(&(*cs).cat_en)
    ctxstd.std_catalog_de(&(*cs).cat_de)
    action.act_set_catalog(&(*cs).acts, &(*cs).cat_en)
    (*cs).mv = menuview.mv_new(&(*cs).cm)
    menuview.mv_attach((*cs).mv, &(*a).sc)
    ctxmenu.ctx_set_sel_hooks(&(*cs).cm, ctxmenu.SelHooks { ud: a as u64,
            item_of: app_sel_item, is_selected: app_sel_is, select_only: app_sel_only,
            clear: app_sel_clear, count: app_sel_count, on: true })
    ctxmenu.ctx_set_on_close(&(*cs).cm, a as u64, app_ctx_closed)
    fuiwirt.host_set_context(&(*a).w, (*cs).mv as u64, menuview.mv_request)
    fuiwirt.host_set_popup(&(*a).w, (*cs).mv as u64, menuview.mv_is_open,
        menuview.mv_pointer, menuview.mv_key, menuview.mv_char, menuview.mv_tick,
        menuview.mv_wait)
    fuiwirt.host_set_popup_note(&(*a).w, menuview.mv_note)
    // a long press on a finger or pen: the router has to be listening
    let lp: bool = on(a, root(a), event.ev_bit(event.EV_LONG_PRESS), app_long_press)
    return cs
}

fn ctxapp_blank() -> CtxApp {
    return CtxApp { acts: action.actions_new(), cm: ctxmenu.ctxm_new(),
        set: ctxstd.std_set_new(), cat_en: action.catalog_new(),
        cat_de: action.catalog_new(), mv: 0 as u64 as *mut menuview.MenuView,
        edit_on: false }
}

// The window's action registry (made on first use); null without memory.
fn actions(a: *mut App) -> *mut action.Actions {
    let cs: *mut CtxApp = ctx_state(a)
    if cs as u64 == 0 { return 0 as u64 as *mut action.Actions }
    return &(*cs).acts
}

// The window's context-menu manager (providers, plugin entries, state).
fn context(a: *mut App) -> *mut ctxmenu.Ctxm {
    let cs: *mut CtxApp = ctx_state(a)
    if cs as u64 == 0 { return 0 as u64 as *mut ctxmenu.Ctxm }
    return &(*cs).cm
}

// The popup widget (menuview.fi), for a test or a program that sets bounds.
fn ctx_view(a: *mut App) -> *mut menuview.MenuView {
    let cs: *mut CtxApp = ctx_state(a)
    if cs as u64 == 0 { return 0 as u64 as *mut menuview.MenuView }
    return (*cs).mv
}

// DECLARE an action: id (a verb), label (catalog key or text, "&Copy" marks
// the mnemonic), handler `f(ud, cx)` where `ud` is the App. Returns its index
// in the registry (action.ACT_NONE when full).
fn action_add(a: *mut App, id: str, label: str, f: fn(u64, *mut action.ActCtx)) -> usize {
    let r: *mut action.Actions = actions(a)
    if r as u64 == 0 { return action.ACT_NONE }
    return action.act_add(r, id, label, f, a as u64)
}

// A PROVIDER for the node `node` and everything under it: it adds entries
// (ctxmenu.pc_add ...) when a menu is requested there. false when the node is
// bad or the table is full.
fn on_context(a: *mut App, node: usize, f: fn(u64, *mut ctxmenu.ProviderCtx)) -> bool {
    if node >= scene.scene_count(&(*a).sc) { return false }
    let cm: *mut ctxmenu.Ctxm = context(a)
    if cm as u64 == 0 { return false }
    var key: u32 = scene.node_id(&(*a).sc, node)
    if key == 0 as u32 {
        key = (*a).next_key
        (*a).next_key = (*a).next_key + 1 as u32
        scene.node_set_id(&(*a).sc, node, key)
    }
    return ctxmenu.ctx_provider_key(cm, key, f, a as u64)
}

// A PROVIDER for every request in the window.
fn on_context_global(a: *mut App, f: fn(u64, *mut ctxmenu.ProviderCtx)) -> bool {
    let cm: *mut ctxmenu.Ctxm = context(a)
    if cm as u64 == 0 { return false }
    return ctxmenu.ctx_provider_global(cm, f, a as u64)
}

// OPEN THE MENU OF `node` from the program (source API): at the node's lower
// left corner. true = a menu is open.
fn open_context(a: *mut App, node: usize) -> bool {
    if node >= scene.scene_count(&(*a).sc) { return false }
    let y0: f64 = scene.node_y(&(*a).sc, node)
    let ch: u32 = fuiwirt.host_context(&(*a).w, action.SRC_API, node,
        scene.node_x(&(*a).sc, node), y0 + scene.node_h(&(*a).sc, node), y0)
    return ctxmenu.ctx_is_open(context(a))
}

// BIND an element to an action (the element's DEFAULT ACTION): a click or
// Enter on it runs the action, and so does the screen reader's "activate" and
// the bus's "press this" (action.act_run_node). The element is a node
// (a button, a list row ...).
fn bind_action(a: *mut App, node: usize, act: usize) -> bool {
    if node >= scene.scene_count(&(*a).sc) { return false }
    let r: *mut action.Actions = actions(a)
    if r as u64 == 0 { return false }
    var key: u32 = scene.node_id(&(*a).sc, node)
    if key == 0 as u32 {
        key = (*a).next_key
        (*a).next_key = (*a).next_key + 1 as u32
        scene.node_set_id(&(*a).sc, node, key)
    }
    return action.act_bind_node(r, key, act)
}

// THE SCREEN LOCK (OrientOS lockseal): while locked no menu opens and an open
// one closes -- nothing may stand above the lock.
fn set_locked(a: *mut App, on: bool) {
    let cm: *mut ctxmenu.Ctxm = context(a)
    if cm as u64 == 0 { return }
    let r: u32 = ctxmenu.ctx_set_locked(cm, on)
    fuiwirt.host_touch(&(*a).w)
}

// ENTRIES OTHER PROGRAMS OR PLUGINS ADD (ctxmenu.ctx_manifest_load): one
// `menu <verb> on <tag> [prio N] [level L] "<label>"` per line; `text` must
// outlive the window. Returns how many entries were taken in.
fn menu_manifest(a: *mut App, owner: str, text: str) -> usize {
    let cm: *mut ctxmenu.Ctxm = context(a)
    if cm as u64 == 0 { return 0 }
    return ctxmenu.ctx_manifest_load(cm, owner, text)
}

// What running such an entry does: `f(ud, owner, verb, cx)`, `ud` the App's
// pointer (on OrientOS: a call on the action bus).
fn set_proxy_call(a: *mut App, f: fn(u64, str, str, *mut action.ActCtx)) {
    let cm: *mut ctxmenu.Ctxm = context(a)
    if cm as u64 == 0 { return }
    ctxmenu.ctx_set_proxy_call(cm, a as u64, f)
}

// "en" or "de": the language of the standard entries (the built-in catalogs).
fn set_language(a: *mut App, lang: str) {
    let cs: *mut CtxApp = ctx_state(a)
    if cs as u64 == 0 { return }
    if lang.n >= 2 && *((lang.p as u64) as *mut u8) == (100 as u8)
    && *((lang.p as u64 + 1) as *mut u8) == (101 as u8) {
        action.act_set_catalog(&(*cs).acts, &(*cs).cat_de)
    } else {
        action.act_set_catalog(&(*cs).acts, &(*cs).cat_en)
    }
}

// The menu view of this window for the platform host (0 = no menu feature used
// yet): a desktop host gives its menus windows of their own.
fn app_popups(ud: u64) -> u64 {
    let a: *mut App = ud as *mut App
    if (*a).cs == 0 { return 0 }
    return (*((*a).cs as *mut CtxApp)).mv as u64
}

// ---- the text field's share: Undo Redo Cut Copy Paste Delete Select all

fn edit_slot(a: *mut App, cx: *mut action.ActCtx) -> usize {
    if cx as u64 != 0 && (*cx).target != action.ACT_NONE {
        let k: usize = slot_of(a, (*cx).target)
        if k != NONE { return k }
    }
    return focused_slot(a)
}

fn app_edit_act(ud: u64, op: u32, cx: *mut action.ActCtx) {
    let a: *mut App = ud as *mut App
    let k: usize = edit_slot(a, cx)
    if k == NONE { return }
    // the same paths a key takes, so the layout of a text area follows
    var ch: u32 = 0 as u32
    var r: u32 = 0 as u32
    if op == ctxstd.OP_UNDO { ch = 122 as u32 }
    if op == ctxstd.OP_REDO { ch = 121 as u32 }
    if op == ctxstd.OP_CUT { ch = 120 as u32 }
    if op == ctxstd.OP_COPY { ch = 99 as u32 }
    if op == ctxstd.OP_PASTE { ch = 118 as u32 }
    if op == ctxstd.OP_SELECT_ALL { ch = 97 as u32 }
    if ch != 0 as u32 {
        if (*a).area[k] {
            r = textarea.ta_char(&(*a).lines[k], &(*a).ed[k], ch, editor.MOD_CTRL)
        } else {
            r = editor.editor_char(&(*a).ed[k], ch, editor.MOD_CTRL)
        }
    } else if op == ctxstd.OP_DELETE {
        if (*a).area[k] {
            r = textarea.ta_key(&(*a).lines[k], &(*a).ed[k], editor.KEY_DELETE, 0 as u32)
        } else {
            r = editor.editor_key(&(*a).ed[k], editor.KEY_DELETE, 0 as u32)
        }
    }
    fuiwirt.host_touch(&(*a).w)
    edit_done(a, k)
}

fn app_edit_can(ud: u64, op: u32, cx: *mut action.ActCtx) -> u32 {
    let a: *mut App = ud as *mut App
    let k: usize = edit_slot(a, cx)
    if k == NONE { return ctxstd.CAN_OFF }
    let t: *mut textbuf.TextBuf = editor.editor_buf(&(*a).ed[k])
    let sel: bool = textbuf.tb_has_sel(t)
    let secret: bool = textbuf.tb_secret(t)
    if op == ctxstd.OP_CUT || op == ctxstd.OP_COPY {
        if !sel || secret { return ctxstd.CAN_OFF }
    }
    if op == ctxstd.OP_DELETE && !sel { return ctxstd.CAN_OFF }
    if op == ctxstd.OP_SELECT_ALL && textbuf.tb_len(t) == 0 { return ctxstd.CAN_OFF }
    return 0 as u32
}

fn app_edit_tag(ud: u64, cx: *mut action.ActCtx) -> str {
    return "text"
}

// THE STANDARD ENTRIES FOR EVERY TEXT FIELD AND TEXT AREA of the window:
// Undo, Redo | Cut, Copy, Paste, Delete | Select all (English or German,
// `set_language`), with Ctrl+Z / Y / X / C / V / A. Call once.
fn std_edit(a: *mut App) {
    let cs: *mut CtxApp = ctx_state(a)
    if cs as u64 == 0 || (*cs).edit_on { return }
    (*cs).edit_on = true
    let ok: bool = ctxstd.std_register(&(*cs).acts, &(*cs).set, ctxstd.FAM_EDIT,
        ctxstd.StdOps { ud: a as u64, act: app_edit_act, can: app_edit_can,
            tag: app_edit_tag })
    let ok2: bool = ctxmenu.ctx_provider_kind(&(*cs).cm, widget.KIND_TEXTBOX,
        ctxstd.std_prov_edit, a as u64)
}

// ---- the shortcuts: the key a text field did not want runs an action

fn shortcut_run(a: *mut App, key: u32, mods: u32) -> bool {
    if (*a).cs == 0 { return false }
    let cs: *mut CtxApp = (*a).cs as *mut CtxApp
    var cx: action.ActCtx = action.actx_new(a as u64)
    cx.source = action.SRC_NONE
    cx.mods = mods
    let ok: bool = action.act_dispatch_key(&(*cs).acts, key, mods, &cx)
    if ok { fuiwirt.host_touch(&(*a).w) }
    return ok
}

fn shortcut_char(a: *mut App, cp: u32, mods: u32) -> bool {
    if (mods & (editor.MOD_CTRL | editor.MOD_ALT)) == 0 as u32 { return false }
    if (mods & editor.MOD_ALT) != 0 as u32 && (mods & editor.MOD_CTRL) == 0 as u32 {
        // Alt+letter: a control's mnemonic first, then the action registry
        if fuiwirt.host_alt_char(&(*a).w, cp) != control.CH_NONE { return true }
    }
    return shortcut_run(a, action.key_logical(cp), mods)
}

fn shortcut_key(a: *mut App, key: u32, mods: u32) -> bool {
    var sk: u32 = 0 as u32
    if key == editor.KEY_DELETE { sk = action.SK_DELETE }
    if key == editor.KEY_ENTER { sk = action.SK_ENTER }
    if key == editor.KEY_BACKSPACE { sk = action.SK_BACKSPACE }
    // Escape and the arrows reach a shortcut too (a dialog's Esc, Left / Right between its buttons);
    // an action must be registered on them, else the host keeps them (the arrows scroll)
    if key == editor.KEY_ESC { sk = action.SK_ESCAPE }
    if key == editor.KEY_LEFT { sk = action.SK_LEFT }
    if key == editor.KEY_RIGHT { sk = action.SK_RIGHT }
    if sk == 0 as u32 { return false }
    return shortcut_run(a, sk, mods)
}

// ============================================================ THE WINDOW

// A window of `w` x `h` design points (at 96 dpi: pixels) titled `title`.
// Nothing is shown before `run`. Returns 0 only when there is no memory.
fn window(title: str, w: usize, h: usize) -> *mut App {
    let n: usize = app_size()
    let p: u64 = rt.heap_alloc(n)
    if p == 0 {
        return 0 as u64 as *mut App
    }
    let a: *mut App = p as *mut App
    *a = app_blank()
    (*a).texts = rt.heap_alloc(scene.SCENE_MAX * TEXT_CAP)
    (*a).cbs = rt.heap_alloc(scene.SCENE_MAX * 8)
    (*a).hcbs = rt.heap_alloc(scene.SCENE_MAX)
    (*a).tlens = rt.heap_alloc(scene.SCENE_MAX * 8)
    (*a).wrps = rt.heap_alloc(scene.SCENE_MAX)
    (*a).ed_bufs = rt.heap_alloc(ENTRIES_MAX * TEXT_CAP)
    (*a).w = fuiwirt.host_new(&(*a).sc, &(*a).c)
    // buttons glide between rest, hover and press; a node's key path (or its
    // address) names the transition, so it stays with its button
    (*a).tr = anim.transreg_new()
    anim.transreg_set_keyer(&(*a).tr, (&(*a).sc) as u64, query.query_widget_key)
    // the Fluent feel: 83 ms hover / 50 ms press / 100 ms focus, decelerate
    // curve, and the first step already in the frame that handles the event
    anim.transreg_set_fluent(&(*a).tr)
    anim.transreg_set_fresh_style(&(*a).tr)
    fuiwirt.host_set_transitions(&(*a).w, &(*a).tr)
    let root: usize = scene.scene_box(&(*a).sc, scene.SCENE_NONE, 0 as u32,
        flex.FLEX_COLUMN, flex.JUSTIFY_CENTER, flex.AL_CENTER)
    scene.node_set_gap(&(*a).sc, root, GAP, GAP)
    scene.node_set_padding(&(*a).sc, root, PAD, PAD, PAD, PAD)
    (*a).stack[0] = root
    (*a).depth = 1
    // A label that has to wrap (fit_labels) keeps its lines centred, like
    // the column it stands in; per-label rules (a font size) only add. A
    // text node is selected by 1000 + its node kind (scene.desc_kind_of).
    let r: usize = sheet.sheet_rule(&(*a).sh, sheet.sel_kind(1000 as u32 + scene.N_TEXT),
        style.style_set_align(style.style_new(), style.ALIGN_CENTER))
    (*a).hk = apphost.hooks_new(a as u64, &(*a).m, &(*a).w, app_attach,
        app_paint, app_key, app_char, app_press, app_act, app_done,
        app_entry_box, title, w, h)
    // the mouse for the text fields: a click puts the caret there, a drag
    // selects, the wheel scrolls a text area
    fuiwirt.host_set_hook(&(*a).w, a as u64, app_hook)
    apphost.hooks_set_audit(&(*a).hk, app_audit)
    apphost.hooks_set_buf(&(*a).hk, app_entry_buf)
    apphost.hooks_set_edited(&(*a).hk, app_entry_edited)
    apphost.hooks_set_popups(&(*a).hk, app_popups)
    apphost.hooks_set_ime(&(*a).hk, app_ime_pre, app_ime_commit, app_ime_end, app_ime_del, app_ime_confirm, app_ime_spot)
    return a
}

// Show the window and run until it is closed or `quit` is called. The
// answer is the exit code for `main` (0 = closed normally). In the
// browser `run` returns at once and the page lives on in the host.
fn run(a: *mut App) -> i32 {
    if a as u64 == 0 {
        return 12
    }
    fuiwirt.host_bind(&(*a).w)
    return apphost.run(&(*a).hk)
}

// The window's own column -- a node that every other node sits under, so a
// handler on it hears what happens anywhere in the window.
fn root(a: *mut App) -> usize {
    return (*a).stack[0]
}

// POINTERS AND GESTURES. `on(a, node, kinds, handler)` lets `handler` hear the
// events of lib/fui/event.fi that happen on `node` or below it (they bubble):
//
//     fn pinched(ud: u64, e: *mut event.Ev) -> u32 {
//         let a: *mut app.App = ud as *mut app.App
//         ... event.ev_scale(e), event.ev_angle(e) ...
//         return event.H_GO
//     }
//     app.on(a, app.root(a), event.EV_PINCH_ALL | event.ev_bit(event.EV_TAP), pinched)
//
// `kinds` is a bit mask: event.ev_bit(event.EV_TAP), or the groups
// event.EV_POINTER_ALL, EV_PAN_ALL, EV_PINCH_ALL. The handler's answer is
// event.H_GO, H_STOP, H_STOP_NOW or H_PREVENT (|). `ud` is the App.
// Every pointer carries its id (event.ev_pid), type (ev_ptype: mouse, touch,
// pen) and ev_primary; a browser's pointerId and every Android finger arrive
// as such (r111). False when the handler table is full or the node is bad.
fn on(a: *mut App, node: usize, kinds: u32,
    f: fn(u64, *mut event.Ev) -> u32) -> bool {
    if a as u64 == 0 || node >= scene.scene_count(&(*a).sc) {
        return false
    }
    if !(*a).rt_on {
        fuiwirt.host_set_router(&(*a).w, &(*a).rt)
        (*a).rt_on = true
    }
    var key: u32 = scene.node_id(&(*a).sc, node)
    if key == 0 as u32 {
        key = (*a).next_key
        (*a).next_key = (*a).next_key + 1 as u32
        scene.node_set_id(&(*a).sc, node, key)
    }
    return event.ev_on(&(*a).rt, key, kinds, false, f, a as u64)
}

// THE ACCESSIBILITY AUDIT (r98, lib/fui/audit.fi) of the tree built so far:
// every operable node named, no duplicate key, no secret in the export.
// Returns 0 when everything holds. `run` does this by itself, WITHOUT opening a
// window, when the environment variable FUI_AUDIT is set (natively), prints
// one line and returns the result as the exit code -- that is how
// tools/fui/audit.sh checks every program of examples/fui/.
fn audit(a: *mut App) -> i32 {
    var ra: audit.Audit = audit.audit_tree_ax(&(*a).sc, &(*a).ax)
    var b: rt.Buf = rt.buf_new()
    audit.audit_line(&ra, &b)
    rt.write_everything(1, rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
    if audit.audit_ok(&ra) {
        return 0
    }
    return 1
}

fn app_audit(ud: u64) -> i32 {
    return audit(ud as *mut App)
}

// Close the window (from a callback). In the browser the page goes blank.
fn quit(a: *mut App) {
    (*a).quit = true
    fuiwirt.host_touch(&(*a).w)
}

// Anything the program wants to reach from its callbacks.
fn set_data(a: *mut App, p: u64) {
    (*a).user = p
}

fn data(a: *mut App) -> u64 {
    return (*a).user
}

// A SECOND THING THE WINDOW LOOP SERVES (fUi and the network in ONE thread).
// `fd` answers a descriptor that is readable while there is work (-1 = none),
// `ms(ud, wanted)` the longest sleep the pump allows (timers), `step(ud)`
// serves the work once and answers true when the picture may have changed.
// Most programs use lib/fui/looppump.fi, which does this for an async.loop.
// Call it before `run`. A browser page has its own loop: no effect there.
fn set_pump(a: *mut App, ud: u64, fd: fn(u64) -> i32, ms: fn(u64, i64) -> i64, step: fn(u64) -> bool) {
    apphost.hooks_set_pump(&(*a).hk, ud, fd, ms, step)
}

// THE WINDOW AND ITS HOTKEYS (lib/window/extras.fi): `opened(ud, win)` runs once when the native window is open
// (`win` = the *mut window.Window as u64: topmost, place_corner, fit_height, hotkey_set ...), `hotkey(ud, id)` hears
// window.EV_HOTKEY. Call it before `run`. A browser page has no such window: no effect there.
fn set_window_hooks(a: *mut App, ud: u64, opened: fn(u64, u64), hotkey: fn(u64, u32)) {
    apphost.hooks_set_window(&(*a).hk, ud, opened, hotkey)
}

// THE HOST'S SAFE AREA AND TEXT SIZE (W44-c, opt-in; nothing changes unless a program asks).
//   follow_host(a, insets, text): `insets` = the system bars over the window (taskbar, panel, status bar, notch; Win32 work area,
//     X11 _NET_WORKAREA, Android WindowInsets) become PADDING on the root column; `text` = the user's text size (Windows Text size,
//     GNOME text-scaling-factor, Android fontScale) multiplies the FONT sizes (theme.theme_set_text_scale). Both are read at open and on
//     every theme/settings change. FUI_INSETS=l,t,r,b and FUI_TEXT_SCALE=1.25 override the system (tests, kiosks). Call before `run`.
//     A browser page: no effect.
fn follow_host(a: *mut App, insets: bool, text: bool) {
    apphost.hooks_set_host_metrics(&(*a).hk, insets, text, host_insets_cb)
}

fn host_insets_cb(ud: u64, l: f64, t: f64, r: f64, b: f64) {
    set_insets(ud as *mut App, l, t, r, b)
}

// Put the insets (DEVICE pixels) on the root column: padding = the root pad (PAD, see set_root_pad) + the inset in design points. All
// zero = back to the plain root pad. The layout runs again on the next frame.
fn set_insets(a: *mut App, l: f64, t: f64, r: f64, b: f64) {
    if a as u64 == 0 {
        return
    }
    (*a).ins[0] = l
    (*a).ins[1] = t
    (*a).ins[2] = r
    (*a).ins[3] = b
    let sc: usize = theme.theme_scale(&(*a).m)
    let rp: i64 = (*a).rpad
    scene.node_set_padding(&(*a).sc, root(a), rp + hostmetrics.inset_points(l, sc), rp + hostmetrics.inset_points(t, sc),
        rp + hostmetrics.inset_points(r, sc), rp + hostmetrics.inset_points(b, sc))
}

// a68: the padding of the root column without the insets (design points). Default PAD. An edge-to-edge app (the Jarvis phone app)
// calls set_root_pad(a, 0) once: every later set_insets (keyboard, host bars) then gives padding = inset only, instead of PAD + inset
// (that put a 16 pt frame around the whole app after the first keyboard).
fn set_root_pad(a: *mut App, pad: i64) {
    if a as u64 == 0 {
        return
    }
    var p: i64 = pad
    if p < 0 {
        p = 0
    }
    (*a).rpad = p
    set_insets(a, (*a).ins[0], (*a).ins[1], (*a).ins[2], (*a).ins[3])
}

// The insets last given (0 left, 1 top, 2 right, 3 bottom), device pixels.
fn inset(a: *mut App, side: usize) -> f64 {
    if a as u64 == 0 || side >= 4 {
        return 0.0
    }
    return (*a).ins[side]
}

// The text scale of this app by hand (per mille, 1000 = off): the same as the host's text size, for a program that has its own setting.
fn set_text_scale(a: *mut App, promille: usize) {
    theme.theme_set_text_scale(&(*a).m, promille)
}

// THE WINDOW BEFORE IT OPENS (opt-in GPU painting): `f(fx)` runs once, right before the native window is opened, with the
// *mut fuiwin.Window as u64. A program that wants FUI_GPU=1 (fUi painted on Vulkan, automatic CPU fallback) imports plat.fuiwinvk and
// passes `fuiwinvk.pre_open_env`: `app.set_pre_open(a, fuiwinvk.pre_open_env)`. The import stays in the PROGRAM on purpose (it makes the
// image dynamically linked; lib/fui stays static). Call it before `run`. A browser page has no such window: no effect there.
fn set_pre_open(a: *mut App, f: fn(u64)) {
    apphost.hooks_set_pre_open(&(*a).hk, f)
}

// THE FIRST LOOK AT THE KEYBOARD (r177). A program with a control of its own
// (a list that is one node with its own painter) hears every key and every
// character BEFORE the text fields and the shortcuts do, whoever has the
// focus: `key(ud, key, mods)` with editor.KEY_* (and KEYX_F5), `chr(ud, cp,
// mods)` with the code point. true = taken. `ud` is passed back.
fn set_keys(a: *mut App, ud: u64, key: fn(u64, u32, u32) -> bool,
    chr: fn(u64, u32, u32) -> bool) {
    (*a).kh_ud = ud
    (*a).kh_key = key
    (*a).kh_chr = chr
    (*a).kh_on = true
}

// THE WHEEL WHERE NO SCROLL AREA IS (r177): `f(ud, x, y, nx, ny)` with the
// pointer and the notches (positive = down / right). true = something changed.
fn set_wheel(a: *mut App, ud: u64, f: fn(u64, f64, f64, f64, f64) -> bool) {
    (*a).kh_ud = ud
    (*a).wh_f = f
    (*a).wh_on = true
}

// THE POINTER FOR A CONTROL OF THE PROGRAM'S OWN (r177): `f(ud, kind, x, y)` hears every move, leave, press and
// release (fuiwirt.HOOK_*) with the pointer in device pixels. true = the picture changed (a hovered row of a list
// that is one node): paint again. Nobody else needs to know where the pointer is: `ptr_x` / `ptr_y` of the App
// stay where the last event put them.
fn set_motion(a: *mut App, ud: u64, f: fn(u64, u32, f64, f64) -> bool) {
    (*a).kh_ud = ud
    (*a).mo_f = f
    (*a).mo_on = true
}

// A text field shows dots instead of its text (a password). No effect on other nodes.
fn set_secret(a: *mut App, id: usize, on: bool) {
    let k: usize = slot_of(a, id)
    if k == NONE {
        return
    }
    textbuf.tb_set_secret(editor.editor_buf(&(*a).ed[k]), on)
    fuiwirt.host_touch(&(*a).w)
}

// A text field whose on-screen keyboard shows "Next" instead of "Done" (Android; elsewhere no effect): the first fields of a
// form. The action key arrives as Enter (on_key); the program then calls set_focus on the next field.
fn set_ime_next(a: *mut App, id: usize, on: bool) {
    let k: usize = slot_of(a, id)
    if k == NONE {
        return
    }
    textbuf.tb_set_ime_next(editor.editor_buf(&(*a).ed[k]), on)
}

// Give the keyboard focus to node `id` (a text field or a button); no effect on a node that cannot take it.
fn set_focus(a: *mut App, id: usize) {
    if id == NONE {
        return
    }
    let ch: u32 = control.panel_set_focus(&(*a).w.pn, id)
    fuiwirt.host_touch(&(*a).w)
}

// Force light (false) or dark (true) instead of the system's choice.
fn set_dark(a: *mut App, dark: bool) {
    theme.theme_set_dark(&(*a).m, dark)
    fuiwirt.host_touch(&(*a).w)
}

// ============================================================ CONTAINERS

fn parent(a: *mut App) -> usize {
    return (*a).stack[(*a).depth - 1]
}

fn open_box(a: *mut App, dir: u32) -> usize {
    if (*a).depth >= STACK_MAX {
        return NONE
    }
    let b: usize = scene.scene_box(&(*a).sc, parent(a), 0 as u32, dir,
        flex.JUSTIFY_CENTER, flex.AL_CENTER)
    if b == scene.SCENE_NONE {
        return NONE
    }
    scene.node_set_gap(&(*a).sc, b, ROW_GAP, ROW_GAP)
    (*a).stack[(*a).depth] = b
    (*a).depth = (*a).depth + 1
    return b
}

// Widgets after this stand side by side, until `end`.
fn row(a: *mut App) -> usize {
    return open_box(a, flex.FLEX_ROW)
}

// Widgets after this stand one below the other, until `end`.
fn column(a: *mut App) -> usize {
    return open_box(a, flex.FLEX_COLUMN)
}

// A GRID: the widgets after this sit in cells (tracks are set by
// appctl.grid, a cell by appctl.grid_cell), until `end`. Without a cell a child
// is placed automatically, row by row.
fn grid_box(a: *mut App) -> usize {
    if (*a).depth >= STACK_MAX {
        return NONE
    }
    let b: usize = scene.scene_box(&(*a).sc, parent(a), 0 as u32, flex.FLEX_COLUMN,
        flex.JUSTIFY_CENTER, flex.AL_CENTER)
    if b == scene.SCENE_NONE {
        return NONE
    }
    if !scene.node_set_grid(&(*a).sc, b) {
        return NONE
    }
    scene.node_grid_gap(&(*a).sc, b, ROW_GAP, ROW_GAP)
    (*a).stack[(*a).depth] = b
    (*a).depth = (*a).depth + 1
    return b
}

// Close the innermost row/column. The window itself cannot be closed so.
fn end(a: *mut App) {
    if (*a).depth > 1 {
        (*a).depth = (*a).depth - 1
    }
}

// Empty room of `w` x `h` design points.
fn spacer(a: *mut App, w: usize, h: usize) -> usize {
    let i: usize = scene.scene_add(&(*a).sc, parent(a), scene.N_BOX)
    if i == scene.SCENE_NONE {
        return NONE
    }
    scene.node_set_size(&(*a).sc, i, w as f64, h as f64)
    return i
}

// ============================================================ HOOKS FOR DIALOGS
//
// ADDITIVE (09.10.2026, lib/fui/colordlg.fi). A dialog has parts the stock
// widgets are not: a colour field, a grid of swatches. They are ONE node each
// with a painter of their own (scene.node_set_draw) and need three things the
// app layer did not give yet:
//
//   custom   a node of a widget kind (focusable, in the Tab chain) with a
//            fixed size, standing in the current row/column
//   ax       the accessibility statements of the window (a11y_set_name/role)
//   on_key   hears every key BEFORE the focused text field; true = taken
//            (arrows on a grid, Enter = OK, Esc = Cancel). Keys are editor.KEY_*.
//   on_edit  hears a text field AFTER its text changed (typing, paste, cut):
//            `id` is the field's node
//   on_pointer  hears the raw pointer (fuiwirt.HOOK_MOVE / LEAVE / DOWN / UP) with
//            its position, also while a button is held outside the window
//            (a drag); true = paint again

// A node of widget kind `kind` (widget.KIND_*) of `w` x `h` design points in
// the current container. NONE when the window is full.
fn custom(a: *mut App, kind: u32, w: usize, h: usize) -> usize {
    let i: usize = scene.scene_add(&(*a).sc, parent(a), scene.N_WIDGET)
    if i == scene.SCENE_NONE {
        return NONE
    }
    scene.node_set_widget_kind(&(*a).sc, i, kind)
    scene.node_set_size(&(*a).sc, i, w as f64, h as f64)
    return i
}

// ============================================ MORE NODES AND CONTAINERS (r145)
//
// What a window of ten lines still lacked: a card and a group box that hold
// other widgets, a rule between them, a badge, a picture and an icon. Each is
// ONE call and ONE node; the painters exist (wave2 / wave3 / uiimage / uisvg).

// A container drawn as a widget of kind `kind` (card, group box): its children
// stand inside it, until `end`. NONE when the window or the stack is full.
fn open_kind_box(a: *mut App, kind: u32, dir: u32, pad: i64) -> usize {
    if (*a).depth >= STACK_MAX {
        return NONE
    }
    let b: usize = scene.scene_add(&(*a).sc, parent(a), scene.N_WIDGET)
    if b == scene.SCENE_NONE {
        return NONE
    }
    scene.node_set_widget_kind(&(*a).sc, b, kind)
    scene.node_set_flex(&(*a).sc, b, dir, flex.JUSTIFY_START, flex.AL_STRETCH)
    scene.node_set_gap(&(*a).sc, b, ROW_GAP, ROW_GAP)
    scene.node_set_padding(&(*a).sc, b, pad, pad, pad, pad)
    (*a).stack[(*a).depth] = b
    (*a).depth = (*a).depth + 1
    return b
}

// A raised panel with a border; what follows stands in it (a column) until `end`.
fn card(a: *mut App) -> usize {
    return open_kind_box(a, widget.KIND_CARD, flex.FLEX_COLUMN, 12)
}

// A frame with a caption on its top line; what follows stands in it (a column)
// until `end`. The caption is pointed at, not copied.
fn groupbox(a: *mut App, title: str) -> usize {
    let g: usize = open_kind_box(a, widget.KIND_GROUPBOX, flex.FLEX_COLUMN, 14)
    if g != NONE {
        keep_text(a, g, title, 0)
    }
    return g
}

// A thin rule across the container (1 point high); `separator_v`: a rule
// down it (1 point wide).
fn separator(a: *mut App) -> usize {
    let i: usize = custom(a, widget.KIND_SEPARATOR, 0, 1)
    if i != NONE {
        scene.node_set_align_self(&(*a).sc, i, flex.AL_STRETCH)
    }
    return i
}

fn separator_v(a: *mut App) -> usize {
    let i: usize = custom(a, widget.KIND_SEPARATOR, 1, 0)
    if i != NONE {
        scene.node_set_align_self(&(*a).sc, i, flex.AL_STRETCH)
    }
    return i
}

// A small status pill with the text `s`.
fn badge(a: *mut App, s: str) -> usize {
    return node_new(a, widget.KIND_BADGE, s)
}

// A picture of `w` x `h` design points (the image is not copied).
fn image(a: *mut App, img: *mut uiimage.Image, w: usize, h: usize) -> usize {
    let i: usize = scene.scene_add(&(*a).sc, parent(a), scene.N_IMAGE)
    if i == scene.SCENE_NONE {
        return NONE
    }
    scene.node_set_image(&(*a).sc, i, img, w, h)
    scene.node_set_size(&(*a).sc, i, w as f64, h as f64)
    return i
}

// A vector icon of `w` x `h` design points (the icon is not copied).
fn icon(a: *mut App, ic: *mut uisvg.Icon, w: usize, h: usize) -> usize {
    let i: usize = scene.scene_add(&(*a).sc, parent(a), scene.N_SVG)
    if i == scene.SCENE_NONE {
        return NONE
    }
    scene.node_set_svg(&(*a).sc, i, ic, w, h)
    scene.node_set_size(&(*a).sc, i, w as f64, h as f64)
    return i
}

fn ax(a: *mut App) -> *mut a11y.A11y {
    return &(*a).ax
}

fn on_key(a: *mut App, f: fn(*mut App, u32, u32) -> bool) {
    (*a).key_hook = f
    (*a).has_key_hook = true
}

// Ring the text field `id` in the error colour (true) or not (false): the
// text in it is not a valid value (yet).
fn set_invalid(a: *mut App, id: usize, bad: bool) {
    let k: usize = slot_of(a, id)
    if k == NONE || (*a).bad[k] == bad {
        return
    }
    (*a).bad[k] = bad
    fuiwirt.host_touch(&(*a).w)
}

fn on_pointer(a: *mut App, f: fn(*mut App, u32, f64, f64) -> bool) {
    (*a).ptr_hook = f
    (*a).has_ptr_hook = true
}

fn on_edit(a: *mut App, f: fn(*mut App, usize)) {
    (*a).edit_hook = f
    (*a).has_edit_hook = true
}

// A fixed width (design points) for one node of the window: a text field
// that is not the stock 240 wide, a label that lines up with its neighbours.
fn set_width(a: *mut App, id: usize, w: usize) {
    if id >= scene.scene_count(&(*a).sc) {
        return
    }
    node_rule(a, id, style.style_set_width(style.style_new(), w))
    fuiwirt.host_touch(&(*a).w)
}

// Text alignment (style.ALIGN_*) of one text node: lay.fi uses it to make a label
// read like web text (start) instead of the window's centred default.
fn set_text_align(a: *mut App, id: usize, al: u32) {
    if id >= scene.scene_count(&(*a).sc) {
        return
    }
    node_rule(a, id, style.style_set_align(style.style_new(), al))
    fuiwirt.host_touch(&(*a).w)
}

fn edit_done(a: *mut App, k: usize) {
    if (*a).has_edit_hook && k < ENTRIES_MAX {
        let f: fn(*mut App, usize) = (*a).edit_hook
        f(a, (*a).ed_node[k])
    }
    if (*a).ctl_on && k < ENTRIES_MAX {
        let cf: fn(u64, usize) = (*a).ctl_edit
        cf((*a).ctl_ud, (*a).ed_node[k])
    }
}

// ============================================================ THE PLUG FOR appctl.fi
//
// lib/fui/appctl.fi adds the standard controls (checkbox, radio, toggle, slider, progress,
// drop-down, tabs, menu bar, tooltip, dialogs, number box, expander) on top of this file.
// It needs five things from here, all additive: a handler each for a key, a character, the
// raw pointer, an activated node and the overlay paint, a node of a kind with its text, and
// the render context.

// Plug `ud` in: the handlers hear every event BEFORE the focused text field (key, chr,
// ptr: true = taken) and `act` hears every activated node AFTER the program's own handler.
// `paint` runs last in every frame, above the page and its menus.
fn set_ctl(a: *mut App, ud: u64, key: fn(u64, u32, u32) -> bool, chr: fn(u64, u32, u32) -> bool,
    ptr: fn(u64, u32, f64, f64) -> bool, act: fn(u64, usize),
    paint: fn(u64, *mut render.Ctx, usize, usize)) {
    (*a).ctl_ud = ud
    (*a).ctl_key = key
    (*a).ctl_chr = chr
    (*a).ctl_ptr = ptr
    (*a).ctl_act = act
    (*a).ctl_paint = paint
    (*a).ctl_on = true
}

// The plug also hears every text field AFTER its text changed by the user (typing, paste, cut): `f(ud, node)`.
// The program's own `on_edit` stays free.
fn set_ctl_edit(a: *mut App, f: fn(u64, usize)) {
    (*a).ctl_edit = f
}

// A widget node of kind `kind` (widget.KIND_*) with the text `s` in the current container.
// Its size is the text's. NONE when the window is full.
fn node_new(a: *mut App, kind: u32, s: str) -> usize {
    let i: usize = scene.scene_add(&(*a).sc, parent(a), scene.N_WIDGET)
    if i == scene.SCENE_NONE {
        return NONE
    }
    scene.node_set_widget_kind(&(*a).sc, i, kind)
    keep_text(a, i, s, 0)
    return i
}

fn app_ctx(a: *mut App) -> *mut render.Ctx { return &(*a).c }
fn ctl_ready(a: *mut App) -> bool { return (*a).ctl_on }
fn ctl_data(a: *mut App) -> u64 { return (*a).ctl_ud }

// ============================================================ VIRTUAL LISTS (r631)
//
// A LIST OF 100000 ROWS IN A WINDOW. The list is ONE node of the scene (kind LIST, drawn by
// lib/fui/vlistview.fi), whatever its row count: only the rows that show are asked for and painted
// (lib/fui/vlist.fi has the model: heights, scrolling, selection, keys, typeahead, columns).
//
//     fn row_of(ud: u64, i: usize, out: *mut vlist.VRow) {
//         vlist.vrow_text(out, "name of row i")      // out.col says the column of a table
//     }
//     fn picked(a: *mut app.App, id: usize, i: usize) { ... }      // selection changed (i = row, NONE = none)
//     let l: usize = app.vlist_new(a, "Files", 400, 300, 100000, row_of, 0)
//     app.vlist_on_pick(a, l, picked)
//
// The program owns the rows. What this adds to the model is the window: the mouse (click, Ctrl / Shift
// click, double click, header click = sort, divider drag, scroll bar), the keys and characters of the
// FOCUSED list (arrows, PgUp / PgDn, Home / End, Enter, Space, typeahead), the wheel, a finger (drag =
// scroll, lift = fling, tap = click), the focus ring, and the accessibility statements (role LIST, a name).
// A table: `vlist.vl_set_columns(app.vlist_model(a, l), 3)` and `vl_set_col_title`; the program sorts its
// own data in the `on_sort` callback and calls `vlist_changed`.
//
// HONEST: VL_MAX lists per window; the rows are not nodes of the scene tree but the a11y tree reports the rows that show as virtual listitems (a11y_bind_vlist); no context menu on a row; the name is POINTED AT.

fn vl_find(a: *mut App, node: usize) -> usize {
    var k: usize = 0
    while k < (*a).vl_n {
        if (*a).vl[k].node == node {
            return k
        }
        k = k + 1
    }
    return NONE
}

fn vl_draw(ud: u64, c: *mut render.Ctx, e: *mut widget.Widget) {
    let s: *mut VlSlot = ud as *mut VlSlot
    let a: *mut App = (*s).a as *mut App
    let v: *mut vlist.Vlist = &(*s).v
    let rh: f64 = vlistview.vv_row_px(c, (*s).row_pt)
    if !vlist.vl_is_variable(v) && vlist.vl_row_height(v) != rh {
        vlist.vl_set_row_height(v, rh)
    }
    var hh: f64 = 0.0
    if vlist.vl_columns(v) > 0 {
        hh = vlistview.vv_header_px(c)
    }
    if vlist.vl_header_h(v) != hh {
        vlist.vl_set_header(v, hh)
    }
    (*s).live = true
    let moving: bool = vlistview.vv_paint(v, c, e, focus(a) == (*s).node, (*s).src_ud, (*s).src)
}

// true while a list is still running out (a fling, a wheel tween): the window has to paint again
fn vlist_moving(a: *mut App) -> bool {
    var k: usize = 0
    while k < (*a).vl_n {
        if viewport.viewport_moving(vlist.vl_viewport(&(*a).vl[k].v)) {
            return true
        }
        k = k + 1
    }
    return false
}

fn xw_tick_none(ud: u64, now: i64) -> bool { return false }
fn xw_wait_none(ud: u64, now: i64) -> i64 { return 0 - 1 }

// a63: register the extra timer (call once, after the window exists). The window repaints when `tick` says so and wakes
// every `wait` ms; this is what runs a fling / animated pictures of a view that is no virtual list.
fn set_extra_wake(a: *mut App, ud: u64, tick: fn(u64, i64) -> bool, wait: fn(u64, i64) -> i64) {
    (*a).xw_ud = ud
    (*a).xw_tick = tick
    (*a).xw_wait = wait
    fuiwirt.host_set_wake(&(*a).w, a as u64, vl_wake_tick, vl_wake_wait)
}

// the extra timer: true = paint again
fn extra_wake_tick(a: *mut App, now: i64) -> bool {
    let f: fn(u64, i64) -> bool = (*a).xw_tick
    return f((*a).xw_ud, now)
}

// the extra timer: ms to the next tick (-1: none)
fn extra_wake_wait(a: *mut App, now: i64) -> i64 {
    let f: fn(u64, i64) -> i64 = (*a).xw_wait
    return f((*a).xw_ud, now)
}

// the program timer of the window (fuiwirt.host_set_wake); appctl takes it over and calls vlist_moving itself
fn vl_wake_tick(ud: u64, now: i64) -> bool {
    let a: *mut App = ud as *mut App
    var r: bool = vlist_moving(a)
    if extra_wake_tick(a, now) { r = true }
    return r
}

// a48: a running list ticks at half a display frame (4 ms at 120 Hz), not a fixed 16 ms (that capped a 120 Hz screen at ~62 fps)
fn frame_wait_ms(a: *mut App) -> i64 {
    var hz: i64 = fuiwirt.host_refresh_hz(&(*a).w)
    if hz < 30 { hz = 60 }
    var w: i64 = 500 / hz
    if w < 1 { w = 1 }
    return w
}

fn vl_wake_wait(ud: u64, now: i64) -> i64 {
    let a: *mut App = ud as *mut App
    var w: i64 = 0 - 1
    if vlist_moving(a) { w = frame_wait_ms(a) }
    let x: i64 = extra_wake_wait(a, now)
    if x >= 0 && (w < 0 || x < w) { w = x }
    return w
}

// A virtual list of `w` x `h` design points in the current container with `n` rows. `src(ud, i, &row)`
// fills in row i (and column row.col of a table). `name` is the list's accessible name (pointed at, not
// copied). Returns the node (the id of all vlist_* calls); NONE when the window or VL_MAX is full.
fn vlist_new(a: *mut App, name: str, w: usize, h: usize, n: usize,
    src: fn(u64, usize, *mut vlist.VRow), ud: u64) -> usize {
    if (*a).vl_n >= VL_MAX {
        return NONE
    }
    let i: usize = scene.scene_add(&(*a).sc, parent(a), scene.N_WIDGET)
    if i == scene.SCENE_NONE {
        return NONE
    }
    scene.node_set_widget_kind(&(*a).sc, i, widget.KIND_LIST)
    scene.node_set_size(&(*a).sc, i, w as f64, h as f64)
    let k: usize = (*a).vl_n
    (*a).vl_n = k + 1
    (*a).vl[k] = vslot_blank()
    let s: *mut VlSlot = &(*a).vl[k]
    (*s).a = a as u64
    (*s).node = i
    (*s).src = src
    (*s).src_ud = ud
    vlist.vl_set_count(&(*s).v, n)
    scene.node_set_draw(&(*a).sc, i, s as u64, vl_draw)
    a11y.a11y_set_role(&(*a).ax, i, a11y.ROLE_LIST)
    // W5: the rows that show are reported to the a11y tree as virtual listitem children
    a11y.a11y_bind_vlist(&(*a).ax, i, &(*s).v, src, ud)
    if name.n > 0 {
        a11y.a11y_set_name(&(*a).ax, i, name.p as u64, name.n)
    }
    // a window without the standard controls has no timer yet: ours runs the fling out
    if !(*a).ctl_on {
        fuiwirt.host_set_wake(&(*a).w, a as u64, vl_wake_tick, vl_wake_wait)
    }
    return i
}

// The model of list `id` (columns, multi-select, heights ...); 0 when `id` is no virtual list.
fn vlist_model(a: *mut App, id: usize) -> *mut vlist.Vlist {
    let k: usize = vl_find(a, id)
    if k == NONE {
        return 0 as u64 as *mut vlist.Vlist
    }
    return &(*a).vl[k].v
}

// Forget the last click of the list: the next click is never a double click. A drag (drag and drop) starts
// from a press, and press + drag + press again must not count as a double click.
fn vlist_forget_click(a: *mut App, id: usize) {
    let k: usize = vl_find(a, id)
    if k == NONE {
        return
    }
    (*a).vl[k].last_row = NONE
}

// The row count changed (clears the selection).
fn vlist_set_count(a: *mut App, id: usize, n: usize) {
    let k: usize = vl_find(a, id)
    if k == NONE {
        return
    }
    vlist.vl_set_count(&(*a).vl[k].v, n)
    fuiwirt.host_touch(&(*a).w)
}

// The rows or their order changed (after a sort, an edit): paint them again.
fn vlist_changed(a: *mut App, id: usize) {
    let k: usize = vl_find(a, id)
    if k == NONE {
        return
    }
    vlist.vl_changed(&(*a).vl[k].v)
    fuiwirt.host_touch(&(*a).w)
}

// The scrollbar strip of the list in design points (0 = no strip: the rows use the full width, the bar is not drawn; the web
// mobile list has none either). Default: what viewport_new gives.
fn vlist_set_bar_pt(a: *mut App, id: usize, pt: usize) {
    let k: usize = vl_find(a, id)
    if k == NONE {
        return
    }
    viewport.viewport_set_bar(vlist.vl_viewport(&(*a).vl[k].v), pt)
    fuiwirt.host_touch(&(*a).w)
}

// The row height in design points (0 = the theme's row height).
fn vlist_set_row_pt(a: *mut App, id: usize, pt: usize) {
    let k: usize = vl_find(a, id)
    if k == NONE {
        return
    }
    (*a).vl[k].row_pt = pt
    fuiwirt.host_touch(&(*a).w)
}

// The focused row (the chosen one of a single-select list); NONE if none.
fn vlist_selected(a: *mut App, id: usize) -> usize {
    let k: usize = vl_find(a, id)
    if k == NONE {
        return NONE
    }
    return vlist.vl_cur(&(*a).vl[k].v)
}

// Choose row `i` (NONE = nothing) and scroll it into view. Does not call `on_pick`.
fn vlist_select(a: *mut App, id: usize, i: usize) {
    let k: usize = vl_find(a, id)
    if k == NONE {
        return
    }
    let v: *mut vlist.Vlist = &(*a).vl[k].v
    if i >= vlist.vl_count(v) {
        vlist.vl_clear_selection(v)
    } else {
        vlist.vl_select_only(v, i)
        let ok: bool = vlist.vl_reveal(v, i)
    }
    fuiwirt.host_touch(&(*a).w)
}

// `f(a, id, row)` runs when the USER changed the selection (click, arrows, typeahead).
fn vlist_on_pick(a: *mut App, id: usize, f: fn(*mut App, usize, usize)) {
    let k: usize = vl_find(a, id)
    if k != NONE {
        (*a).vl[k].pick = f
    }
}

// `f(a, id, row)` runs on Enter or a double click / double tap on a row.
fn vlist_on_activate(a: *mut App, id: usize, f: fn(*mut App, usize, usize)) {
    let k: usize = vl_find(a, id)
    if k != NONE {
        (*a).vl[k].act = f
    }
}

// `f(a, id, row)` runs on a touch lift that did not move when the finger was held >= 500 ms or lifted in the right edge
// strip (46 pt) of the list. It returns true when it handled the gesture (the normal click is then skipped).
fn vlist_on_long(a: *mut App, id: usize, f: fn(*mut App, usize, usize) -> bool) {
    let k: usize = vl_find(a, id)
    if k != NONE {
        (*a).vl[k].lp = f
    }
}

// `f(a, id, column)` runs when the user clicked a header cell. The sort column and direction are
// already set in the model (vl_sort_col / vl_sort_desc): sort your data, then `vlist_changed`.
fn vlist_on_sort(a: *mut App, id: usize, f: fn(*mut App, usize, usize)) {
    let k: usize = vl_find(a, id)
    if k != NONE {
        (*a).vl[k].sort = f
    }
}

// What the model answered (RES_* bits) becomes the program's callbacks.
fn vl_result(a: *mut App, k: usize, r: u32) {
    let s: *mut VlSlot = &(*a).vl[k]
    let cur: usize = vlist.vl_cur(&(*s).v)
    if (r & vlist.RES_MOVED) != 0 as u32 && cur != NONE {
        let ok: bool = vlist.vl_reveal(&(*s).v, cur)
    }
    if (r & vlist.RES_SELECT) != 0 as u32 {
        let f: fn(*mut App, usize, usize) = (*s).pick
        f(a, (*s).node, cur)
    }
    if (r & vlist.RES_ACTIVATE) != 0 as u32 && cur != NONE {
        let g: fn(*mut App, usize, usize) = (*s).act
        g(a, (*s).node, cur)
    }
    fuiwirt.host_touch(&(*a).w)
}

// The focused list hears the key first. true = taken.
fn vl_key_route(a: *mut App, key: u32, mods: u32) -> bool {
    if (*a).vl_n == 0 {
        return false
    }
    let k: usize = vl_find(a, focus(a))
    if k == NONE {
        return false
    }
    let r: u32 = vlist.vl_key(&(*a).vl[k].v, key, mods)
    if r == 0 as u32 {
        return false
    }
    vl_result(a, k, r)
    return true
}

fn vl_char_route(a: *mut App, cp: u32, mods: u32) -> bool {
    if (*a).vl_n == 0 {
        return false
    }
    let k: usize = vl_find(a, focus(a))
    if k == NONE {
        return false
    }
    let s: *mut VlSlot = &(*a).vl[k]
    let r: u32 = vlist.vl_char(&(*s).v, cp, mods, fuiwirt.host_now(&(*a).w), (*s).src_ud, (*s).src)
    if r == 0 as u32 {
        return false
    }
    vl_result(a, k, r)
    return true
}

// A click (or a tap) on row `row`; a second one on the same row within VL_DBL_MS activates it.
fn vl_click_row(a: *mut App, k: usize, row: usize, mods: u32) {
    let s: *mut VlSlot = &(*a).vl[k]
    var r: u32 = vlist.vl_click(&(*s).v, row, mods)
    let now: i64 = fuiwirt.host_now(&(*a).w)
    if row != NONE && row == (*s).last_row && now >= (*s).last_ms && now - (*s).last_ms <= VL_DBL_MS {
        r = r | vlist.RES_ACTIVATE
        (*s).last_row = NONE
    } else {
        (*s).last_row = row
        (*s).last_ms = now
    }
    vl_result(a, k, r)
}

// The pointer went down in list `k` at (x, y).
fn vl_down(a: *mut App, k: usize, x: f64, y: f64) -> bool {
    let s: *mut VlSlot = &(*a).vl[k]
    let v: *mut vlist.Vlist = &(*s).v
    let c: *mut render.Ctx = &(*a).c
    let z: u32 = vlist.vl_zone(v, x, y)
    if z == vlist.ZONE_BAR {
        if viewport.viewport_bar_press(c, vlist.vl_viewport(v), x, y) {
            (*s).drag = VD_BAR
        }
        return true
    }
    if z == vlist.ZONE_HEADER {
        let d: usize = vlist.vl_divider_at(v, x, render.len_of(c, 6))
        if d != NONE {
            vlist.vl_col_drag_begin(v, d, x)
            (*s).drag = VD_COL
            return true
        }
        let col: usize = vlist.vl_col_at(v, x)
        if col != NONE && vlist.vl_header_click(v, col) {
            let f: fn(*mut App, usize, usize) = (*s).sort
            f(a, (*s).node, col)
        }
        return true
    }
    // the body
    let row: usize = vlist.vl_hit(v, x, y)
    if fuiwirt.host_pointer_type(&(*a).w) == event.PT_TOUCH {
        // a finger: a drag scrolls, a tap that did not move clicks (on the lift)
        viewport.viewport_scroll_by(vlist.vl_viewport(v), 0.0, 0.0)
        (*s).drag = VD_TOUCH
        (*s).t_y0 = y
        (*s).t_y = y
        (*s).t_ms = fuiwirt.host_now(&(*a).w)
        (*s).t_vy = 0.0
        (*s).tr_n = 0
        tr_add(s, y)
        (*s).t_moved = false
        (*s).t_row = row
        (*s).t_x = x
        return true
    }
    // a mouse: a click in the right edge strip is the row's long-press action (the "..." of a sidebar entry)
    if row != NONE && x >= (*s).v.x + (*s).v.w - render.len_of(c, 46) {
        let g: fn(*mut App, usize, usize) -> bool = (*s).lp
        if g(a, (*s).node, row) {
            fuiwirt.host_touch(&(*a).w)
            return true
        }
    }
    vl_click_row(a, k, row, fuiwirt.host_mods(&(*a).w))
    return true
}

// a48: the finger velocity tracker. The loop's `host_now` is the TICK time: all moves of one pump batch share it, so a speed from
// `host_now` deltas was garbage (spikes, halved by the closing zero-move). Samples carry their own monotonic microseconds; the
// speed is (newest - oldest sample inside the last 100 ms), like Android's VelocityTracker horizon.
const TR_HORIZON_US: i64 = 100000
// the finger rested longer than this before the lift: no fling
const TR_REST_US: i64 = 80000

fn tr_add(s: *mut VlSlot, y: f64) {
    let t: i64 = (time.monotonic_ns() / 1000 as u64) as i64
    var n: usize = (*s).tr_n
    if n >= 16 {
        var i: usize = 1
        while i < 16 {
            (*s).tr_y[i - 1] = (*s).tr_y[i]
            (*s).tr_t[i - 1] = (*s).tr_t[i]
            i = i + 1
        }
        n = 15
    }
    (*s).tr_y[n] = y
    (*s).tr_t[n] = t
    (*s).tr_n = n + 1
}

// px per ms of the content (positive = content moves down the list = finger moved up), 0 when the finger rested or there is no span
fn tr_velocity(s: *mut VlSlot) -> f64 {
    let n: usize = (*s).tr_n
    if n < 2 { return 0.0 }
    let t_last: i64 = (*s).tr_t[n - 1]
    let now: i64 = (time.monotonic_ns() / 1000 as u64) as i64
    if now - t_last > TR_REST_US { return 0.0 }
    var i: usize = n - 1
    while i > 0 && t_last - (*s).tr_t[i - 1] <= TR_HORIZON_US {
        i = i - 1
    }
    let span: i64 = t_last - (*s).tr_t[i]
    if span < 4000 as i64 { return 0.0 }
    return (0.0 - ((*s).tr_y[n - 1] - (*s).tr_y[i])) / ((span as f64) / 1000.0)
}

// A finger moved to y: scroll by the distance (1:1 with the finger), feed the velocity tracker. The slop is 8 dp (ViewConfiguration);
// after it the list follows the finger from where the slop ended (no jump).
fn vl_pan(a: *mut App, k: usize, y: f64) -> bool {
    let s: *mut VlSlot = &(*a).vl[k]
    tr_add(s, y)
    if !(*s).t_moved {
        let d: f64 = y - (*s).t_y0
        let slop: f64 = render.len_of(&(*a).c, 8)
        if d < slop && d > 0.0 - slop {
            return false
        }
        (*s).t_moved = true
        (*s).t_y = (*s).t_y0
        if d > 0.0 { (*s).t_y = (*s).t_y0 + slop } else { (*s).t_y = (*s).t_y0 - slop }
    }
    let dy: f64 = y - (*s).t_y
    let vp: *mut viewport.Viewport = vlist.vl_viewport(&(*s).v)
    let before: f64 = viewport.viewport_off_y(vp)
    viewport.viewport_scroll_by(vp, 0.0, 0.0 - dy)
    (*s).t_y = y
    (*s).t_ms = fuiwirt.host_now(&(*a).w)
    return viewport.viewport_off_y(vp) != before
}

fn vl_up(a: *mut App, k: usize) -> bool {
    let s: *mut VlSlot = &(*a).vl[k]
    let d: u32 = (*s).drag
    (*s).drag = VD_NONE
    if d == VD_BAR {
        viewport.viewport_bar_release(vlist.vl_viewport(&(*s).v))
        return true
    }
    if d == VD_COL {
        vlist.vl_col_drag_end(&(*s).v)
        return true
    }
    if d == VD_TOUCH {
        let now: i64 = fuiwirt.host_now(&(*a).w)
        if !(*s).t_moved {
            let held: bool = now - (*s).t_ms >= 500 as i64
            let edge: bool = (*s).t_x >= (*s).v.x + (*s).v.w - render.len_of(&(*a).c, 46)
            if (held || edge) && (*s).t_row != NONE {
                let g: fn(*mut App, usize, usize) -> bool = (*s).lp
                if g(a, (*s).node, (*s).t_row) {
                    fuiwirt.host_touch(&(*a).w)
                    return true
                }
            }
            vl_click_row(a, k, (*s).t_row, 0 as u32)
            return true
        }
        let vy: f64 = tr_velocity(s)
        var avy: f64 = vy
        if avy < 0.0 { avy = 0.0 - avy }
        if avy >= VL_FLING_MIN {
            viewport.viewport_fling_android(vlist.vl_viewport(&(*s).v), 0.0, vy, now, render.len_of(&(*a).c, 160))
        }
        return true
    }
    return false
}

// The raw pointer (fuiwirt.HOOK_*) for all virtual lists. true = paint again.
fn vl_pointer(a: *mut App, kind: u32, x: f64, y: f64) -> bool {
    var changed: bool = false
    let c: *mut render.Ctx = &(*a).c
    var k: usize = 0
    if kind == fuiwirt.HOOK_DOWN {
        var hit: usize = NONE
        while k < (*a).vl_n {
            (*a).vl[k].drag = VD_NONE
            if hit == NONE && (*a).vl[k].live && vlist.vl_zone(&(*a).vl[k].v, x, y) != vlist.ZONE_NONE {
                hit = k
            }
            k = k + 1
        }
        if hit != NONE {
            return vl_down(a, hit, x, y)
        }
        return false
    }
    while k < (*a).vl_n {
        let s: *mut VlSlot = &(*a).vl[k]
        let v: *mut vlist.Vlist = &(*s).v
        if kind == fuiwirt.HOOK_UP {
            if vl_up(a, k) {
                changed = true
            }
        } else if kind == fuiwirt.HOOK_LEAVE {
            if vlist.vl_set_hover(v, NONE) {
                changed = true
            }
        } else if kind == fuiwirt.HOOK_MOVE {
            if (*s).drag == VD_BAR {
                if viewport.viewport_bar_drag(c, vlist.vl_viewport(v), x, y) {
                    changed = true
                }
            } else if (*s).drag == VD_COL {
                if vlist.vl_col_drag(v, x) {
                    changed = true
                }
            } else if (*s).drag == VD_TOUCH {
                if vl_pan(a, k, y) {
                    changed = true
                }
            } else if (*s).live && fuiwirt.host_pointer_type(&(*a).w) != event.PT_TOUCH {
                if vlist.vl_set_hover(v, vlist.vl_hit(v, x, y)) {
                    changed = true
                }
            }
        }
        k = k + 1
    }
    return changed
}

// The wheel over a list scrolls it. true = taken.
fn vl_wheel_at(a: *mut App, x: f64, y: f64, notches: f64) -> bool {
    var k: usize = 0
    while k < (*a).vl_n {
        let s: *mut VlSlot = &(*a).vl[k]
        if (*s).live && vlist.vl_zone(&(*s).v, x, y) != vlist.ZONE_NONE {
            vlist.vl_wheel(&(*s).v, notches)
            return true
        }
        k = k + 1
    }
    return false
}

// ============================================================ LISTS

// A LIST OF ROWS. The rows after this stand one below the other, until `end`:
//
//     app.list(a)
//     app.list_item(a, "folder", "Documents", "12 items", "3", open_docs)
//     app.list_item(a, "pencil", "notes.txt", "2 KB", "", open_notes)
//     app.end(a)
//
// Every row has a symbol on the left (the name of a Lucide icon, "" = none),
// its text, and on the right an optional detail text and badge ("" = none).
// A click on a row chooses it (one at a time) and runs its handler; the row
// under the mouse is highlighted (lib/fui/listrow.fi describes the look and
// the keys). 24 rows are about what the 128 nodes of a window hold.
fn list(a: *mut App) -> usize {
    if (*a).depth >= STACK_MAX {
        return NONE
    }
    if !(*a).lists_on {
        listrow.listrow_rules(&(*a).sh)
        (*a).lists_on = true
    }
    let l: usize = listrow.listrow_list(&(*a).sc, parent(a))
    if l == scene.SCENE_NONE {
        return NONE
    }
    a11y.a11y_set_role(&(*a).ax, l, a11y.ROLE_LIST)
    (*a).stack[(*a).depth] = l
    (*a).depth = (*a).depth + 1
    return l
}

// One row in the open list. Returns its node. The texts are copied into the
// window, so they may be temporary. `on_pick(a)` runs when the row is
// clicked; `chosen(a, list)` then says which one it was.
fn list_item(a: *mut App, icon: str, text: str, detail: str, badge: str,
    on_pick: fn(*mut App)) -> usize {
    let l: usize = parent(a)
    if (*a).depth < 2 || !scene.node_has_class(&(*a).sc, l, listrow.listrow_names().list) {
        return NONE
    }
    var r: listrow.Row = listrow.row_new((*a).next_key, text)
    (*a).next_key = (*a).next_key + 1 as u32
    if icon.n > 0 {
        r.icon = listrow.icon_named(icon)
    }
    r.detail = detail
    r.badge = badge
    let z: usize = listrow.listrow_add(&(*a).sc, l, &r)
    if z == scene.SCENE_NONE {
        return NONE
    }
    // the texts live in the window: the text nodes are the children that
    // are text (text, then detail, then badge, in this order)
    var k: usize = 0
    var c: usize = scene.scene_first_child(&(*a).sc, z)
    while c != scene.SCENE_NONE {
        if scene.node_kind(&(*a).sc, c) == scene.N_TEXT {
            if k == 0 {
                keep_text(a, c, text, 0)
            } else if k == 1 && detail.n > 0 {
                keep_text(a, c, detail, 0)
            } else {
                keep_text(a, c, badge, 0)
            }
            k = k + 1
        }
        c = scene.scene_next_sibling(&(*a).sc, c)
    }
    cb_put(a, z, on_pick)
    hcb_put(a, z, true)
    a11y.a11y_set_role(&(*a).ax, z, a11y.ROLE_LISTITEM)
    a11y.a11y_set_name(&(*a).ax, z, text.p as u64, text.n)
    return z
}

// The chosen row of a list (the node `list` returned), NONE if none.
fn chosen(a: *mut App, l: usize) -> usize {
    let key: u32 = listrow.listrow_selected(&(*a).sc, l)
    if key == 0 as u32 {
        return NONE
    }
    return listrow.listrow_row_of(&(*a).sc, l, key)
}

// The pointer's part (app_hook): the row under it is highlighted (key 0: no
// row), and a press on a row chooses it. True when the page changed.
fn lists_hover(a: *mut App, key: u32) -> bool {
    var changed: bool = false
    let cl: u32 = listrow.listrow_names().list
    var i: usize = 0
    while i < scene.scene_count(&(*a).sc) {
        if scene.node_has_class(&(*a).sc, i, cl) {
            if listrow.listrow_hover(&(*a).sc, i, key) {
                changed = true
            }
        }
        i = i + 1
    }
    return changed
}

// Choose the row with `key` and run its handler. False when there is none.
fn lists_pick(a: *mut App, key: u32) -> bool {
    let cl: u32 = listrow.listrow_names().list
    var i: usize = 0
    while i < scene.scene_count(&(*a).sc) {
        if scene.node_has_class(&(*a).sc, i, cl) {
            let z: usize = listrow.listrow_row_of(&(*a).sc, i, key)
            if z != scene.SCENE_NONE {
                let ch: bool = listrow.listrow_select(&(*a).sc, i, key)
                if hcb_get(a, z) {
                    let f: fn(*mut App) = cb_get(a, z)
                    f(a)
                }
                return true
            }
        }
        i = i + 1
    }
    return false
}

// ============================================================ WIDGETS

// The node's own copy of `s`: a node only POINTS at its text
// (scene.node_set_text), so the text has to live as long as the window.
fn keep_text(a: *mut App, i: usize, s: str, at: usize) {
    var n: usize = s.n
    if at + n > TEXT_CAP {
        n = TEXT_CAP - at
        // cut at a character boundary, not in the middle of one
        while n > 0 && (rt.ld8(s.p as u64, n) & 192 as u8) == 128 as u8 {
            n = n - 1
        }
    }
    let dst: u64 = (*a).texts + (i * TEXT_CAP) as u64
    if (*a).mn_on && at == 0 && n > 0 && n == s.n {
        // MNEMONICS: show the text without its '&', tell the panel the letter
        let lt: u32 = control.mn_letter(s.p as u64, n)
        if lt != 0 as u32 {
            let ix: usize = control.mn_index(s.p as u64, n)
            n = control.mn_clean(s.p as u64, n, dst as *mut u8, TEXT_CAP)
            let ok: bool = fuiwirt.host_mn_bind(&(*a).w, i, lt, ix)
            tlen_put(a, i, n)
            scene.node_set_text(&(*a).sc, i, dst, n)
            return
        }
    }
    if n > 0 {
        rt.mem_copy(dst + at as u64, s.p as u64, n)
    }
    tlen_put(a, i, at + n)
    scene.node_set_text(&(*a).sc, i, dst, at + n)
}

// One stylesheet rule for this node alone (by its id).
fn node_rule(a: *mut App, i: usize, st: style.Style) {
    scene.node_set_id(&(*a).sc, i, (i + 1) as u32)
    let r: usize = sheet.sheet_rule(&(*a).sh, sheet.sel_id((i + 1) as u32), st)
}

// A line of text. `size` in POINTS like tkinter's font=("Arial", 16):
// 1 pt = 4/3 design points (pixels at 96 dpi), so 16 is a 21 pixel font.
// 0 = the theme's text size.
fn label(a: *mut App, s: str, size: usize) -> usize {
    let i: usize = scene.scene_add(&(*a).sc, parent(a), scene.N_TEXT)
    if i == scene.SCENE_NONE {
        return NONE
    }
    keep_text(a, i, s, 0)
    if size > 0 {
        let px: usize = points_to_px(size)
        node_rule(a, i, style.style_set_font(style.style_new(), 0, px))
    }
    return i
}

// Read '&' in the texts of labels and buttons as a mnemonic marker ("&Save" shows
// "Save", Alt+S presses it; "&&" is a literal '&'). Off by default. Call BEFORE
// building the widgets.
fn set_text_mn(a: *mut App, on: bool) {
    (*a).mn_on = on
}

fn points_to_px(pt: usize) -> usize {
    return (pt * 4 + 1) / 3
}

// A push button; `on_click(a)` runs on a click, on Enter and on the space
// bar while it has the focus.
fn button(a: *mut App, s: str, on_click: fn(*mut App)) -> usize {
    let i: usize = scene.scene_add(&(*a).sc, parent(a), scene.N_WIDGET)
    if i == scene.SCENE_NONE {
        return NONE
    }
    scene.node_set_widget_kind(&(*a).sc, i, widget.KIND_BUTTON)
    keep_text(a, i, s, 0)
    cb_put(a, i, on_click)
    hcb_put(a, i, true)
    return i
}

// a65: the hint (and the accessible name) of a field is held by pointer in native memory (App.hint, the a11y node), which the garbage
// collector does not scan: a hint built with a GC string (jtexts.tp, a catalog text, a concatenation) was freed and its block reused, so
// the empty composer showed the latest log line ("tab=3 bar_y=..." / "n=27 avg_us=..." on the device). Keep a private copy in
// permanent (non-GC) memory; it is made once per field.
fn hint_keep(s: str) -> str {
    if s.n == 0 {
        return ""
    }
    let m: u64 = rt.heap_alloc(s.n)
    if m == 0 {
        return ""
    }
    rt.mem_copy(m, s.p as u64, s.n)
    return str { p: m as *mut u8, n: s.n }
}

// A one-line text field; `hint` stands in it (dimmed) while it is empty.
fn entry(a: *mut App, hint0: str) -> usize {
    let hint: str = hint_keep(hint0)
    if (*a).n_ed >= ENTRIES_MAX {
        return NONE
    }
    let i: usize = scene.scene_add(&(*a).sc, parent(a), scene.N_WIDGET)
    if i == scene.SCENE_NONE {
        return NONE
    }
    let k: usize = (*a).n_ed
    scene.node_set_widget_kind(&(*a).sc, i, widget.KIND_TEXTBOX)
    if !editor.editor_init(&(*a).ed[k],
        (*a).ed_bufs + (k * TEXT_CAP) as u64, TEXT_CAP) {
        return NONE
    }
    (*a).ed_node[k] = i
    (*a).hint[k] = hint
    (*a).n_ed = k + 1
    // the hint is the field's accessible name (a screen reader says it, and
    // the audit counts a field without a name as an error)
    a11y.a11y_set_name(&(*a).ax, i, hint.p as u64, hint.n)
    // an empty field measures only its padding: it gets a width here
    node_rule(a, i, style.style_set_width(style.style_new(), ENTRY_W))
    scene.node_set_draw(&(*a).sc, i, a as u64, draw_entry)
    return i
}

// A text area: several lines of text that wrap at the box and scroll,
// `rows` lines tall. Enter is a line break (Ctrl+Enter does nothing here);
// `text` / `set_text` read and write the whole text with its LF bytes. 4096
// bytes at most. A text area counts against the same eight slots as `entry`.
fn textarea(a: *mut App, hint: str, rows: usize) -> usize {
    return textarea_make(a, hint, rows, 2)
}

// A text area that grows with its text: `rows_min` lines tall while it is empty (1 is allowed), one more row per line of text
// (wrapped lines count) up to `rows_max`, then it scrolls; it shrinks again when text is deleted. The height follows the line
// count of the previous frame (sync_areas), so a change shows one frame late. `textarea` itself keeps its fixed height.
fn textarea_auto(a: *mut App, hint: str, rows_min: usize, rows_max: usize) -> usize {
    var lo: usize = rows_min
    if lo < 1 {
        lo = 1
    }
    var hi: usize = rows_max
    if hi < lo {
        hi = lo
    }
    let i: usize = textarea_make(a, hint, lo, 1)
    if i == NONE {
        return NONE
    }
    let k: usize = slot_of(a, i)
    if k < ENTRIES_MAX {
        (*a).area_min[k] = lo
        (*a).area_max[k] = hi
    }
    return i
}

fn textarea_make(a: *mut App, hint0: str, rows: usize, floor: usize) -> usize {
    let hint: str = hint_keep(hint0)
    if (*a).n_ed >= ENTRIES_MAX {
        return NONE
    }
    let i: usize = scene.scene_add(&(*a).sc, parent(a), scene.N_WIDGET)
    if i == scene.SCENE_NONE {
        return NONE
    }
    let k: usize = (*a).n_ed
    let buf: u64 = rt.heap_alloc(AREA_CAP)
    if buf == 0 {
        return NONE
    }
    scene.node_set_widget_kind(&(*a).sc, i, widget.KIND_TEXTBOX)
    if !editor.editor_init_cap(&(*a).ed[k], buf, AREA_CAP, AREA_CAP) {
        return NONE
    }
    editor.editor_set_multiline(&(*a).ed[k], true)
    if !textarea.ta_init(&(*a).lines[k], 0) {
        return NONE
    }
    (*a).area[k] = true
    (*a).ed_node[k] = i
    (*a).hint[k] = hint
    (*a).n_ed = k + 1
    a11y.a11y_set_name(&(*a).ax, i, hint.p as u64, hint.n)
    var r: usize = rows
    if r < floor {
        r = floor
    }
    (*a).area_rows[k] = r
    scene.node_set_id(&(*a).sc, i, (i + 1) as u32)
    (*a).area_rule[k] = sheet.sheet_rule(&(*a).sh, sheet.sel_id((i + 1) as u32), style.style_set_height(
            style.style_set_width(style.style_new(), AREA_W),
            area_height_slot(a, k, r)))
    scene.node_set_draw(&(*a).sc, i, a as u64, draw_entry)
    return i
}

// r385: the design height of a text area of `rows` rows: the row follows the text scale (the font grows, so does the row), the
// padding does not. With the text scale at 1000 this is rows * AREA_ROW_PT + AREA_PAD_PT as before.
fn area_height_pt(a: *mut App, rows: usize) -> usize {
    return rows * hostmetrics.scale_text_px(AREA_ROW_PT, theme.theme_text_scale(&(*a).m)) + AREA_PAD_PT
}

// a64: the height of the rows of slot k (its own row / padding when set, else the defaults)
fn area_height_slot(a: *mut App, k: usize, rows: usize) -> usize {
    var row: usize = AREA_ROW_PT
    var pad: usize = AREA_PAD_PT
    if (*a).area_row_pt[k] > 0 { row = (*a).area_row_pt[k] }
    if (*a).area_pad_pt[k] > 0 { pad = (*a).area_pad_pt[k] }
    return rows * hostmetrics.scale_text_px(row, theme.theme_text_scale(&(*a).m)) + pad
}

// a64: own row height / padding (pt) for one text area, e.g. the web composer (24 / 14); applied on the next frame
fn area_set_metrics(a: *mut App, id: usize, row_pt: usize, pad_pt: usize) {
    let k: usize = slot_of(a, id)
    if k == NONE || !(*a).area[k] { return }
    (*a).area_row_pt[k] = row_pt
    (*a).area_pad_pt[k] = pad_pt
    (*a).area_ts = 0
}

// r385: runs every frame before the layout; when the text scale changed (app.set_text_scale or the host's setting) every text area
// gets the height of its rows at the new scale, so `rows` rows stay visible.
fn sync_areas(a: *mut App) {
    let ts: usize = theme.theme_text_scale(&(*a).m)
    let scaled: bool = ts != (*a).area_ts
    (*a).area_ts = ts
    var k: usize = 0
    while k < (*a).n_ed {
        if (*a).area[k] {
            var rows: usize = (*a).area_rows[k]
            if (*a).area_max[k] > 0 {
                rows = auto_rows(a, k)
            }
            if scaled || rows != (*a).area_rows[k] {
                (*a).area_rows[k] = rows
                let d: *mut sheet.Decl = sheet.sheet_decl(&(*a).sh, (*a).area_rule[k])
                sheet.decl_set_style(d, style.style_set_height(*sheet.decl_style(d), area_height_slot(a, k, rows)))
            }
        }
        k = k + 1
    }
}

// Rows a growing text area (textarea_auto) shows now: its line count of the last layout, between area_min and area_max.
fn auto_rows(a: *mut App, k: usize) -> usize {
    var rows: usize = (*a).area_min[k]
    let n: usize = textarea.ta_line_count(&(*a).lines[k])
    if n > rows {
        rows = n
    }
    if rows > (*a).area_max[k] {
        rows = (*a).area_max[k]
    }
    return rows
}

// The line layout of a text area (textarea.ta_line_count, ta_scroll_y ...);
// 0 when `id` is not a text area. Valid after the first frame.
fn lines_of(a: *mut App, id: usize) -> *mut textarea.Lines {
    let k: usize = slot_of(a, id)
    if k == NONE || !(*a).area[k] {
        return 0 as u64 as *mut textarea.Lines
    }
    return &(*a).lines[k]
}

fn slot_of(a: *mut App, i: usize) -> usize {
    var k: usize = 0
    while k < (*a).n_ed {
        if (*a).ed_node[k] == i {
            return k
        }
        k = k + 1
    }
    return NONE
}

// r444b: the caret of the focused field in window pixels (for the input method's candidate window). The scroll of the field
// may still move while it is painted (scroll_to_caret), so this is the value of the frame before; it is current by the next turn.
fn note_spot(a: *mut App, k: usize, c: *mut render.Ctx, e: *mut widget.Widget) {
    let ed: *mut editor.Editor = &(*a).ed[k]
    let t: *mut textbuf.TextBuf = editor.editor_buf(ed)
    if (*a).area[k] {
        var bx: f64 = 0.0
        var by: f64 = 0.0
        var bh: f64 = 0.0
        textarea.ta_caret_box(&(*a).lines[k], ed, &bx, &by, &bh)
        (*a).spot[0] = render.field_text_x0(c, e) + bx
        (*a).spot[1] = widget.w_y(e) + render.pady_of(c, e) + by
        (*a).spot[2] = bh
    } else {
        var top: f64 = 0.0
        var lh: f64 = 0.0
        let bl: f64 = render.field_line(c, e, &top, &lh)
        (*a).spot[0] = render.field_caret_x(c, e, t, editor.editor_scroll(ed))
        (*a).spot[1] = top
        (*a).spot[2] = lh
    }
    (*a).spot_ok = true
}

// The field over the button base that wave3 already painted: text, caret,
// selection (render.draw_textfield) -- or the dimmed hint.
fn draw_entry(ud: u64, c: *mut render.Ctx, e: *mut widget.Widget) {
    let a: *mut App = ud as *mut App
    let k: usize = slot_of(a, scene.scene_node_of(&(*a).sc, e))
    if k == NONE {
        return
    }
    let ed: *mut editor.Editor = &(*a).ed[k]
    let focus: bool = widget.w_is_focus(e)
    if focus {
        note_spot(a, k, c, e)
    }
    if (*a).area[k] {
        textarea.ta_draw(c, e, ed, &(*a).lines[k], focus)
        let ha: str = (*a).hint[k]
        if textbuf.tb_len(editor.editor_buf(ed)) == 0 && !focus && ha.n > 0 {
            let z: *mut painter.Painter = render.ctx_painter(c)
            let px: f64 = render.field_px(c, e)
            var r: painter.TextRun = render.text_run_of(c, e, px)
            let top: f64 = widget.w_y(e) + render.pady_of(c, e)
            let by: f64 = painter.text_baseline_mid(z, top,
                textarea.ta_row_h(&(*a).lines[k]), px)
            let col: u32 = render.color_of(c,
                style.color_token(style.TOK_TEXT_DISABLED))
            let x1: f64 = painter.run_draw(z, &r, render.field_text_x0(c, e),
                by, 0.0, col, ha.p as u64, ha.n, painter.TEXT_L)
        }
        return
    }
    render.draw_textfield(c, e, ed, focus)
    let h: str = (*a).hint[k]
    if textbuf.tb_len(editor.editor_buf(ed)) == 0 && !focus && h.n > 0 {
        let z: *mut painter.Painter = render.ctx_painter(c)
        let px: f64 = render.field_px(c, e)
        var r: painter.TextRun = render.text_run_of(c, e, px)
        let by: f64 = painter.text_baseline_mid(z, widget.w_y(e),
            widget.w_h(e), px)
        let col: u32 = render.color_of(c,
            style.color_token(style.TOK_TEXT_DISABLED))
        let x1: f64 = painter.run_draw(z, &r, render.field_text_x0(c, e), by,
            0.0, col, h.p as u64, h.n, painter.TEXT_L)
    } if (*a).bad[k] {
        let z2: *mut painter.Painter = render.ctx_painter(c)
        let fo: *mut theme.Shape = theme.theme_shape(render.ctx_theme(c))
        painter.round_ring(z2, widget.w_x(e), widget.w_y(e), widget.w_w(e),
            widget.w_h(e), render.radius_of(c, e), render.len_of(c, (*fo).focus_w),
            render.color_of(c, style.color_token(style.TOK_ERROR)))
    }
}

// ============================================================ TEXT

// Replace the text of a label, a button or a text field.
// a66: true when the node already shows exactly this text (a plain text node, no field, no mnemonic): setting it again changes nothing
fn text_same(a: *mut App, id: usize, s: str) -> bool {
    if (*a).mn_on {
        return false
    }
    let e: *mut widget.Widget = scene.node_widget(&(*a).sc, id)
    let n: usize = widget.w_text_len(e)
    if n != s.n || n > TEXT_CAP {
        return false
    }
    return rt.mem_eq(widget.w_text(e), s.p as u64, n)
}

fn set_text(a: *mut App, id: usize, s: str) {
    if id >= scene.scene_count(&(*a).sc) {
        return
    }
    let k: usize = slot_of(a, id)
    // a66: the same text again (a 2 s refresh that sets twenty labels) must not cost a frame: no scene edit, no repaint
    if k == NONE && text_same(a, id, s) {
        return
    }
    if k != NONE {
        editor.editor_set_text(&(*a).ed[k], s.p as u64, s.n)
    } else {
        keep_text(a, id, s, 0)
    }
    fuiwirt.host_touch(&(*a).w)
}

// r459: set_text for a timer / pump callback: only the ink rectangle of the node is repainted (a fps label that changes once a second
// no longer repaints the window). If the new text changes the layout, the partial paint notices (layout_stable) and paints everything.
// Falls back to a full repaint when the node's ink bounds are not known.
fn set_text_scoped(a: *mut App, id: usize, s: str) {
    if id >= scene.scene_count(&(*a).sc) {
        return
    }
    let k: usize = slot_of(a, id)
    if k == NONE && text_same(a, id, s) {
        return
    }
    if k != NONE {
        editor.editor_set_text(&(*a).ed[k], s.p as u64, s.n)
    } else {
        keep_text(a, id, s, 0)
    }
    var r: [f64; 4] = [0.0; 4]
    if k == NONE && scene.scene_ink_rect(&(*a).sc, id, &r) {
        fuiwirt.host_touch_scoped_text(&(*a).w, r[0], r[1], r[2], r[3])
    } else {
        fuiwirt.host_touch(&(*a).w)
    }
}

// r444: node `id` (which only rotates, e.g. a spinner) changed its angle inside a timer / pump callback: repaint ONLY the square it
// turns in, not the window. Falls back to a full repaint when the node does something else than rotate. Call it instead of relying on
// the pump's "something happened" repaint; other changes in the same callback (set_text ...) still repaint everything.
fn touch_rotated(a: *mut App, id: usize) {
    var r: [f64; 4] = [0.0; 4]
    if scene.scene_rot_bounds(&(*a).sc, &(*a).c, id, &r) {
        fuiwirt.host_touch_scoped(&(*a).w, r[0], r[1], r[2], r[3])
    } else {
        fuiwirt.host_touch(&(*a).w)
    }
}

// Add `s` to the end of the text of a label or a button.
fn append_text(a: *mut App, id: usize, s: str) {
    if id >= scene.scene_count(&(*a).sc) || slot_of(a, id) != NONE {
        return
    }
    keep_text(a, id, s, tlen_get(a, id))
    fuiwirt.host_touch(&(*a).w)
}

// The text of a label, a button or a text field. It is a view: it stays
// valid until the text is changed.
fn text(a: *mut App, id: usize) -> str {
    if id >= scene.scene_count(&(*a).sc) {
        return ""
    }
    let k: usize = slot_of(a, id)
    if k != NONE {
        let t: *mut textbuf.TextBuf = editor.editor_buf(&(*a).ed[k])
        return str { p: textbuf.tb_ptr(t) as *mut u8, n: textbuf.tb_len(t) }
    }
    return str { p: ((*a).texts + (id * TEXT_CAP) as u64) as *mut u8,
        n: tlen_get(a, id) }
}

// The caret and the selection anchor (byte offsets) of a text field; false for a node
// that is not one. For the accessibility bridge (AT-SPI Text).
fn text_caret(a: *mut App, id: usize, caret: *mut usize, anchor: *mut usize) -> bool {
    if id >= scene.scene_count(&(*a).sc) { return false }
    let k: usize = slot_of(a, id)
    if k == NONE { return false }
    let t: *mut textbuf.TextBuf = editor.editor_buf(&(*a).ed[k])
    *caret = textbuf.tb_caret(t)
    *anchor = textbuf.tb_anchor(t)
    return true
}

// Put the caret at byte offset `caret` and the anchor at `anchor` (equal = no selection).
fn set_text_caret(a: *mut App, id: usize, anchor: usize, caret: usize) -> bool {
    if id >= scene.scene_count(&(*a).sc) { return false }
    let k: usize = slot_of(a, id)
    if k == NONE { return false }
    let t: *mut textbuf.TextBuf = editor.editor_buf(&(*a).ed[k])
    textbuf.tb_set_caret(t, anchor, false)
    textbuf.tb_set_caret(t, caret, anchor != caret)
    fuiwirt.host_touch(&(*a).w)
    return true
}

// A whole number as the text of a label or a button.
// `#[allow_escape]`: `d` only passes through set_text, which copies it
// (keep_text / editor_set_text) before this frame ends.
#[allow_escape]
fn set_number(a: *mut App, id: usize, v: i64) {
    var d: [u8; 24] = [0 as u8; 24]
    var n: usize = 0
    var neg: bool = v < 0
    var u: u64 = v as u64
    if neg {
        u = (0 - v) as u64
    }
    if u == 0 {
        d[23] = 48 as u8
        n = 1
    }
    while u > 0 {
        d[23 - n] = (48 + u % 10) as u8
        u = u / 10
        n = n + 1
    }
    if neg {
        d[23 - n] = 45 as u8
        n = n + 1
    }
    set_text(a, id, str { p: (&d[24 - n]) as *mut u8, n: n })
}

// The text of a node read as a whole number (0 when it is none).
fn number(a: *mut App, id: usize) -> i64 {
    let s: str = text(a, id)
    var v: i64 = 0
    var i: usize = 0
    var neg: bool = false
    if s.n > 0 && rt.ld8(s.p as u64, 0) == 45 as u8 {
        neg = true
        i = 1
    }
    while i < s.n && rt.ld8(s.p as u64, i) >= 48 as u8
    && rt.ld8(s.p as u64, i) <= 57 as u8 {
        v = v * 10 + (rt.ld8(s.p as u64, i) - 48 as u8) as i64
        i = i + 1
    }
    if neg {
        return 0 - v
    }
    return v
}

// Who has the keyboard (NONE = nobody).
fn focus(a: *mut App) -> usize {
    let f: usize = fuiwirt.host_focus(&(*a).w)
    if f == fuiwirt.KEINER {
        return NONE
    }
    return f
}

// ============================================================ THE HOST SIDE
//
// What lib/@*/fui/apphost.fi calls. Positions are device pixels, keys
// are editor.KEY_*, modifiers editor.MOD_*.

fn app_host(a: *mut App) -> *mut fuiwirt.Host { return &(*a).w }
fn app_theme(a: *mut App) -> *mut theme.Theme { return &(*a).m }
fn app_scene(a: *mut App) -> *mut scene.Scene { return &(*a).sc }

// the system asked for reduced motion (syspref.motion_apply put it on the transition registry)
fn app_reduced_motion(a: *mut App) -> bool { return anim.transreg_reduced(&(*a).tr) }

// The painter the platform paints with is known: the render context.
fn app_attach(ud: u64, z: *mut painter.Painter) {
    let a: *mut App = ud as *mut App
    (*a).c = render.ctx_new(&(*a).m, z)
    // a new Ctx has no transitions: bind the registry again (r126); the
    // buttons it already knows keep their entries
    anim.transreg_bind(&(*a).tr, &(*a).c)
}

// FRAME TIME (opt-in): how long painting one frame takes, in microseconds. frame_stats_on(true) starts the measurement; frame_stat(k)
// then reads the frames painted since the last frame_stats_reset(): FS_FRAMES count, FS_AVG_US mean, FS_MAX_US slowest, FS_SLOW number of
// frames over 16 ms (60 Hz budget). It is the paint (scene layout + draw into the painter), not the display's present.
const FS_FRAMES: usize = 0
const FS_AVG_US: usize = 1
const FS_MAX_US: usize = 2
const FS_SLOW: usize = 3
const FS_BUDGET_US: i64 = 16000
// FRAME INTERVALS (time between two painted frames, microseconds; only gaps under 200 ms count -- an idle window is not a slow one):
// FS_IV_P95_US the 95th percentile (250 us buckets), FS_IV_MAX_US the longest.
const FS_IV_P95_US: usize = 4
const FS_IV_MAX_US: usize = 5
const FS_IV_BUCKETS: usize = 800
static mut FS_IV_H: [i64; 800] = [0; 800]
static mut FS_IV_N: i64 = 0
static mut FS_IV_MAX: i64 = 0
static mut FS_IV_LAST: i64 = 0
static mut FS_ON: bool = false
// per phase microseconds since the last frame_stats_reset: 0 clear+sync+fit, 1 style, 2 measure, 3 layout, 4 draw, 5 overlays
static mut FS_PH: [i64; 8] = [0; 8]
fn frame_phase(k: usize) -> i64 {
    if k >= 8 { return 0 }
    return FS_PH[k]
}
fn ph_tick(k: usize, t: i64) -> i64 {
    if !FS_ON { return t }
    let n: i64 = time.now_unix_ns()
    FS_PH[k] = FS_PH[k] + (n - t) / 1000
    return n
}
static mut FS_N: i64 = 0
static mut FS_SUM: i64 = 0
static mut FS_MAX: i64 = 0
static mut FS_OVER: i64 = 0

fn frame_stats_on(on: bool) { FS_ON = on }

// r426: the refresh rate (Hz) the host paces its frames on: the display's (Android: highest mode, X11: RandR), FUI_REFRESH_HZ, else 60.
// An app with its own animation timer should tick at (1000 / refresh_hz) / 2 ms or faster, NOT at a fixed 16 ms (that caps a 120 Hz screen at 62 fps).
fn refresh_hz(a: *mut App) -> i64 { return fuiwirt.host_refresh_hz(&(*a).w) }

fn frame_stats_reset() {
    var pk: usize = 0
    while pk < 8 {
        FS_PH[pk] = 0
        pk = pk + 1
    }
    FS_N = 0
    FS_SUM = 0
    FS_MAX = 0
    FS_OVER = 0
    var q: usize = 0
    while q < FS_IV_BUCKETS {
        FS_IV_H[q] = 0
        q = q + 1
    }
    FS_IV_N = 0
    FS_IV_MAX = 0
    FS_IV_LAST = 0
}

fn iv_p95() -> i64 {
    if FS_IV_N == 0 { return 0 }
    let want: i64 = (FS_IV_N * 95 + 99) / 100
    var acc: i64 = 0
    var q: usize = 0
    while q < FS_IV_BUCKETS {
        acc = acc + FS_IV_H[q]
        if acc >= want { return (q as i64 + 1) * 250 }
        q = q + 1
    }
    return FS_IV_BUCKETS as i64 * 250
}

fn frame_stat(k: usize) -> i64 {
    if k == FS_FRAMES { return FS_N }
    if k == FS_AVG_US {
        if FS_N == 0 { return 0 }
        return FS_SUM / FS_N
    }
    if k == FS_MAX_US { return FS_MAX }
    if k == FS_SLOW { return FS_OVER }
    if k == FS_IV_P95_US { return iv_p95() }
    if k == FS_IV_MAX_US { return FS_IV_MAX }
    return 0
}

// One frame of `w` x `h` device pixels into the attached painter.
fn app_paint(ud: u64, w: usize, h: usize) {
    if !FS_ON {
        app_paint_frame(ud, w, h)
        return
    }
    let t0: i64 = time.now_unix_ns()
    if FS_IV_LAST > 0 {
        let iv: i64 = (t0 - FS_IV_LAST) / 1000
        if iv < 200000 {
            var b: i64 = iv / 250
            if b >= FS_IV_BUCKETS as i64 { b = FS_IV_BUCKETS as i64 - 1 }
            FS_IV_H[b as usize] = FS_IV_H[b as usize] + 1
            FS_IV_N = FS_IV_N + 1
            if iv > FS_IV_MAX { FS_IV_MAX = iv }
        }
    }
    FS_IV_LAST = t0
    app_paint_frame(ud, w, h)
    let us: i64 = (time.now_unix_ns() - t0) / 1000
    FS_N = FS_N + 1
    FS_SUM = FS_SUM + us
    if us > FS_MAX { FS_MAX = us }
    if us > FS_BUDGET_US { FS_OVER = FS_OVER + 1 }
}

fn app_paint_frame(ud: u64, w: usize, h: usize) {
    let a: *mut App = ud as *mut App
    let f: *mut theme.Colors = theme.theme_colors(&(*a).m)
    painter.bgcache_frame()
    // PARTIAL REPAINT: only the rectangles the host noted as damaged (a hover,
    // a press, a focus ring) are painted and later presented.
    var rs: [i64; 16] = [0; 16]
    let m: usize = fuiwirt.host_damage_rects(&(*a).w, w, h, &rs)
    if m > 0 && !(*a).quit {
        // r455: only a rotation (a spinner) is pending: style + draw under the clip, no wrapping / layout pass
        if fuiwirt.host_pure_rot(&(*a).w) && paint_rot_only(a, w, h, &rs, m) {
            return
        }
        if paint_part(a, w, h, &rs, m) {
            return
        }
    }
    painter.bgcache_frame()
    var pt: i64 = 0
    if FS_ON { pt = time.now_unix_ns() }
    painter.painter_clear(render.ctx_painter(&(*a).c), theme.opaque((*f).base))
    if (*a).quit {
        return
    }
    var q: usize = 0
    while q < (*a).vl_n {
        (*a).vl[q].live = false
        q = q + 1
    }
    pt = ph_tick(0, pt)
    sync_areas(a)
    sync_areas(a)
    pt = ph_tick(6, pt)
    // fit_labels styled + measured the scene a moment ago and only set label sizes since (style does not read them):
    // the second full style pass is skipped when it ran
    let styled: bool = fit_labels(a, w)
    anim.transreg_new_frame(&(*a).tr)
    pt = ph_tick(7, pt)
    if !styled {
        scene.scene_style(&(*a).sc, &(*a).sh)
    }
    pt = ph_tick(1, pt)
    scene.scene_measure(&(*a).sc, &(*a).c)
    pt = ph_tick(2, pt)
    scene.scene_layout(&(*a).sc, &(*a).c, 0.0, 0.0, w as f64, h as f64)
    pt = ph_tick(3, pt)
    scene.scene_draw(&(*a).sc, &(*a).c)
    pt = ph_tick(4, pt)
    paint_overlays(a, w, h)
    pt = ph_tick(5, pt)
}

// A MENU IS PAINTED ABOVE THE PAGE (r161), and the overlays of the standard
// controls (appctl): a drop-down list, a tooltip, a dialog.
fn paint_overlays(a: *mut App, w: usize, h: usize) {
    if (*a).cs != 0 {
        let cs: *mut CtxApp = (*a).cs as *mut CtxApp
        menuview.mv_bind((*cs).mv, &(*a).c)
        menuview.mv_set_bounds((*cs).mv, 0.0, 0.0, w as f64, h as f64)
        menuview.mv_draw((*cs).mv, &(*a).c)
    }
    if (*a).ctl_on {
        let pf: fn(u64, *mut render.Ctx, usize, usize) = (*a).ctl_paint
        pf((*a).ctl_ud, &(*a).c, w, h)
    }
}

// The page painted under a clip of each damaged rectangle. False when the
// layout moved something (a hover that changes a size): the rectangles do not
// cover the change, the host is told "everything" and the caller paints the
// whole window (the layout is done already, painting it again is cheap).
fn paint_part(a: *mut App, w: usize, h: usize, rs: *mut [i64; 16], m: usize) -> bool {
    painter.bgcache_frame()
    let z: *mut painter.Painter = render.ctx_painter(&(*a).c)
    let cv: *mut canvas.Canvas = painter.painter_canvas(z)
    if canvas.canvas_width(cv) != w || canvas.canvas_height(cv) != h {
        return false
    }
    var q: usize = 0
    while q < (*a).vl_n {
        (*a).vl[q].live = false
        q = q + 1
    }
    sync_areas(a)
    let fl: bool = fit_labels(a, w)
    anim.transreg_new_frame(&(*a).tr)
    if !scene.scene_layout_stable(&(*a).sc, &(*a).c, &(*a).sh, 0.0, 0.0, w as f64, h as f64) {
        fuiwirt.host_touch(&(*a).w)
        painter.painter_clear(z, theme.opaque((*theme.theme_colors(&(*a).m)).base))
        scene.scene_draw(&(*a).sc, &(*a).c)
        paint_overlays(a, w, h)
        return true
    }
    paint_rects(a, w, h, rs, m)
    return true
}

// r455: the frame after host_touch_scoped (only a node's rotation changed). The text did not change, so nothing wraps differently;
// no size changed, so nothing moves: restyle (the new angle) and paint the damage rectangles. False = paint the usual way.
static mut ROT_ONLY_N: i64 = 0

// How many frames took the paint-only path (tests, bench logs).
fn rot_only_frames() -> i64 { return ROT_ONLY_N }

fn paint_rot_only(a: *mut App, w: usize, h: usize, rs: *mut [i64; 16], m: usize) -> bool {
    let z: *mut painter.Painter = render.ctx_painter(&(*a).c)
    let cv: *mut canvas.Canvas = painter.painter_canvas(z)
    if canvas.canvas_width(cv) != w || canvas.canvas_height(cv) != h {
        return false
    }
    ROT_ONLY_N = ROT_ONLY_N + 1
    anim.transreg_new_frame(&(*a).tr)
    scene.scene_style(&(*a).sc, &(*a).sh)
    paint_rects(a, w, h, rs, m)
    return true
}

// The page (draw only, the layout is current) under a clip of each damaged rectangle.
fn paint_rects(a: *mut App, w: usize, h: usize, rs: *mut [i64; 16], m: usize) {
    let z: *mut painter.Painter = render.ctx_painter(&(*a).c)
    let cv: *mut canvas.Canvas = painter.painter_canvas(z)
    let base: u32 = theme.opaque((*theme.theme_colors(&(*a).m)).base)
    var k: usize = 0
    while k < m {
        let x0: f64 = (*rs)[k * 4] as f64
        let y0: f64 = (*rs)[k * 4 + 1] as f64
        let x1: f64 = (*rs)[k * 4 + 2] as f64
        let y1: f64 = (*rs)[k * 4 + 3] as f64
        let pushed: bool = canvas.clip_push_rect(cv, x0, y0, x1, y1)
        canvas.canvas_fill_rect(cv, x0, y0, x1, y1, base)
        scene.scene_draw(&(*a).sc, &(*a).c)
        paint_overlays(a, w, h)
        if pushed {
            canvas.clip_pop(cv)
        }
        k = k + 1
    }
}

// How many lines `p`/`n` needs at width `w` -- the loop of
// painter.run_draw_wrapped without the drawing, so the count is the
// picture's count.
fn count_lines(z: *mut painter.Painter, r: *mut painter.TextRun, p: u64,
    n: usize, w: f64) -> usize {
    var lines: usize = 0
    var i: usize = 0
    while i < n && lines < 8 {
        var j: usize = i
        while j < n && rt.ld8(p, j) == 32 as u8 {
            j = j + 1
        }
        if j >= n {
            return lines
        }
        var next: usize = 0
        let upto: usize = painter.run_line_upto(z, r, p + (i as u64), n - i,
            w, &next)
        if upto == 0 || next == 0 {
            return lines + 1
        }
        lines = lines + 1
        i = i + next
    }
    return lines
}

// A LABEL WIDER THAN THE WINDOW WRAPS. Measured, a flex item keeps its
// text width, and a centred child wider than its column starts left of
// the window -- the whole line then vanished (tools/fui/app_main.fi,
// "an answer wider than the window"). So before each frame: every text
// node that measures wider than the window's inner width gets that width
// and as many lines as run_line_upto says it needs (at most 8), and gives
// both back when it fits again.
// a63: FIT CACHE. fit_labels (style + measure of the whole scene + a line count per wide label) cost 6-14 ms per frame on the phone, also when the
// frame only scrolled a view. Its result (label sizes + wrap flags) depends on the node tree / texts (scene epoch), the width and the text scale only.
// Same inputs as at the end of the last run = skip it: the labels keep their sizes, the caller styles as usual (return false).
static mut FIT_EPOCH: u64 = 0
static mut FIT_W: usize = 0
static mut FIT_SCALE: usize = 0
static mut FIT_VALID: bool = false
static mut FIT_RUNS: i64 = 0
static mut FIT_HITS: i64 = 0

// FIT_RUNS (0) / FIT_HITS (1): how often fit_labels ran / was skipped (since start)
fn fit_stat(k: usize) -> i64 {
    if k == 0 { return FIT_RUNS }
    return FIT_HITS
}

fn fit_labels(a: *mut App, w: usize) -> bool {
    let sc0: *mut scene.Scene = &(*a).sc
    let scl: usize = (theme.theme_scale(&(*a).m) as usize) + 100000 * (theme.theme_text_scale(&(*a).m) as usize)
    if FIT_VALID && FIT_EPOCH == scene.scene_epoch() && FIT_W == w && FIT_SCALE == scl && scene.scene_count(sc0) > 0 {
        FIT_HITS = FIT_HITS + 1
        return false
    }
    FIT_RUNS = FIT_RUNS + 1
    let r: bool = fit_labels_run(a, w)
    FIT_EPOCH = scene.scene_epoch()
    FIT_W = w
    FIT_SCALE = scl
    FIT_VALID = r
    return r
}

fn fit_labels_run(a: *mut App, w: usize) -> bool {
    let sc: *mut scene.Scene = &(*a).sc
    let n: usize = scene.scene_count(sc)
    var i: usize = 0
    while i < n {
        if wrp_get(a, i) {
            scene.node_set_size(sc, i, 0.0, 0.0)
            widget.w_set_text_lines(scene.node_widget(sc, i), 1)
            wrp_put(a, i, false)
        }
        i = i + 1
    }
    let s: f64 = (theme.theme_scale(&(*a).m) as f64) / 1000.0
    let avail: f64 = (w as f64) - 2.0 * (PAD as f64) * s
    if avail <= 0.0 {
        return false
    }
    scene.scene_style(sc, &(*a).sh)
    scene.scene_measure(sc, &(*a).c)
    let z: *mut painter.Painter = render.ctx_painter(&(*a).c)
    i = 0
    while i < n {
        if scene.node_kind(sc, i) == scene.N_TEXT
        && scene.node_pref_w(sc, i) > avail {
            let e: *mut widget.Widget = scene.node_widget(sc, i)
            let px: f64 = render.field_px(&(*a).c, e)
            var r: painter.TextRun = render.text_run_of(&(*a).c, e, px)
            var lines: usize = count_lines(z, &r, widget.w_text(e),
                widget.w_text_len(e), avail)
            if lines < 1 {
                lines = 1
            }
            let lh: f64 = painter.run_line_height(z, &r)
            let hh: f64 = scene.node_pref_h(sc, i) + ((lines - 1) as f64) * lh
            scene.node_set_size(sc, i, avail / s, hh / s)
            widget.w_set_text_lines(e, lines)
            wrp_put(a, i, true)
        }
        i = i + 1
    }
    return true
}

// The node of the text field that has the keyboard focus; NONE = no text field has it (a button may).
fn focused_field(a: *mut App) -> usize {
    let k: usize = focused_slot(a)
    if k == NONE {
        return NONE
    }
    return (*a).ed_node[k]
}

fn focused_slot(a: *mut App) -> usize {
    let f: usize = fuiwirt.host_focus(&(*a).w)
    if f == fuiwirt.KEINER {
        return NONE
    }
    return slot_of(a, f)
}

// A key. true = a text field took it; false = it goes on to the host
// (Tab moves the focus, Enter presses the focused button).
fn app_key(ud: u64, key: u32, mods: u32) -> bool {
    let a: *mut App = ud as *mut App
    if (*a).has_key_hook {
        let hf: fn(*mut App, u32, u32) -> bool = (*a).key_hook
        if hf(a, key, mods) {
            fuiwirt.host_touch(&(*a).w)
            return true
        }
    }
    if (*a).kh_on {
        let f: fn(u64, u32, u32) -> bool = (*a).kh_key
        if f((*a).kh_ud, key, mods) {
            fuiwirt.host_touch(&(*a).w)
            return true
        }
    }
    if (*a).ctl_on {
        let cf: fn(u64, u32, u32) -> bool = (*a).ctl_key
        if cf((*a).ctl_ud, key, mods) {
            fuiwirt.host_touch(&(*a).w)
            return true
        }
    }
    if vl_key_route(a, key, mods) {
        return true
    }
    let k: usize = focused_slot(a)
    if k == NONE {
        return shortcut_key(a, key, mods)
    }
    var r: u32 = 0 as u32
    if (*a).area[k] {
        r = textarea.ta_key(&(*a).lines[k], &(*a).ed[k], key, mods)
    } else {
        r = editor.editor_key(&(*a).ed[k], key, mods)
    }
    if r == editor.RES_PASS || r == editor.RES_COMMIT
    || r == editor.RES_CANCEL {
        return shortcut_key(a, key, mods)
    }
    fuiwirt.host_touch(&(*a).w)
    edit_done(a, k)
    return true
}

// A character (a code point). true = a text field took it.
fn app_char(ud: u64, cp: u32, mods: u32) -> bool {
    let a: *mut App = ud as *mut App
    if (*a).kh_on {
        let f: fn(u64, u32, u32) -> bool = (*a).kh_chr
        if f((*a).kh_ud, cp, mods) {
            fuiwirt.host_touch(&(*a).w)
            return true
        }
    }
    if (*a).ctl_on {
        let cf: fn(u64, u32, u32) -> bool = (*a).ctl_chr
        if cf((*a).ctl_ud, cp, mods) {
            fuiwirt.host_touch(&(*a).w)
            return true
        }
    }
    if vl_char_route(a, cp, mods) {
        return true
    }
    // Alt+letter is a mnemonic BEFORE a focused field sees it (a field does not type it)
    if (*a).mn_on && (mods & editor.MOD_ALT) != 0 as u32 && (mods & editor.MOD_CTRL) == 0 as u32 {
        if fuiwirt.host_alt_char(&(*a).w, cp) != control.CH_NONE { return true }
    }
    let k: usize = focused_slot(a)
    if k == NONE {
        return shortcut_char(a, cp, mods)
    }
    var r: u32 = 0 as u32
    if (*a).area[k] {
        r = textarea.ta_char(&(*a).lines[k], &(*a).ed[k], cp, mods)
    } else {
        r = editor.editor_char(&(*a).ed[k], cp, mods)
    }
    if r == editor.RES_PASS {
        return shortcut_char(a, cp, mods)
    }
    fuiwirt.host_touch(&(*a).w)
    edit_done(a, k)
    return true
}

// A press at (x, y) -- only reported; focus and clicks stay the host's (the
// caret goes to the click through `app_hook`).
fn app_press(ud: u64, x: f64, y: f64) {
}

// The text fields' share of the mouse (fuiwirt.host_set_hook, called AFTER the
// host did its own work, so the click has focused the field already):
//   down   the caret goes to the click; double click = word, triple click =
//          line (all of it in a one-line field, the paragraph in an area)
//   move   with the button down: the selection follows
//   up     ends the drag
//   wheel  scrolls the text area under the pointer
// true = something changed, paint again.
// The mouse (or a tap) goes down in text slot `k` at (x, y): the caret goes
// to that place; a text area takes it line by line.
fn press_field(a: *mut App, k: usize, x: f64, y: f64) {
    let e: *mut widget.Widget = scene.node_widget(&(*a).sc, (*a).ed_node[k])
    let c: *mut render.Ctx = &(*a).c
    let now: u64 = ((*c).ms as u64) * 1000
    let x0: f64 = render.field_text_x0(c, e)
    if (*a).area[k] {
        let y0: f64 = widget.w_y(e) + render.pady_of(c, e)
        let r: u32 = textarea.ta_mouse_down(&(*a).lines[k], &(*a).ed[k],
            x - x0, y - y0, now, false)
    } else {
        var fm: render.FieldMeas = render.field_meas_new(c, e)
        let r2: u32 = editor.editor_mouse_down(&(*a).ed[k], x - x0, now,
            render.field_meas, (&fm) as u64, false)
    }
}

fn app_hook(ud: u64, kind: u32, x: f64, y: f64) -> bool {
    let a: *mut App = ud as *mut App
    var heard: bool = false
    if (*a).has_ptr_hook && kind != fuiwirt.HOOK_WHEEL {
        let pf: fn(*mut App, u32, f64, f64) -> bool = (*a).ptr_hook
        heard = pf(a, kind, x, y)
    }
    var extra: bool = false
    if (*a).mo_on && kind != fuiwirt.HOOK_WHEEL {
        (*a).ptr_x = x
        (*a).ptr_y = y
        let mf: fn(u64, u32, f64, f64) -> bool = (*a).mo_f
        extra = mf((*a).kh_ud, kind, x, y)
    }
    var ctl: bool = false
    if (*a).ctl_on {
        let pf2: fn(u64, u32, f64, f64) -> bool = (*a).ctl_ptr
        ctl = pf2((*a).ctl_ud, kind, x, y)
    }
    var vlp: bool = false
    if (*a).vl_n > 0 && kind != fuiwirt.HOOK_WHEEL {
        vlp = vl_pointer(a, kind, x, y)
    }
    let r: bool = app_hook_text(ud, kind, x, y)
    return r || heard || extra || ctl || vlp
}

fn app_hook_text(ud: u64, kind: u32, x: f64, y: f64) -> bool {
    let a: *mut App = ud as *mut App
    if kind == fuiwirt.HOOK_WHEEL {
        if (*a).vl_n > 0 && vl_wheel_at(a, (*a).ptr_x, (*a).ptr_y, y) {
            return true
        }
        if (*a).wh_on {
            let wf: fn(u64, f64, f64, f64, f64) -> bool = (*a).wh_f
            if wf((*a).kh_ud, (*a).ptr_x, (*a).ptr_y, x, y) {
                return true
            }
        }
        let k: usize = slot_at(a, (*a).ptr_x, (*a).ptr_y)
        if k == NONE || !(*a).area[k] {
            return false
        }
        textarea.ta_wheel(&(*a).lines[k], y * 3.0 * textarea.ta_row_h(&(*a).lines[k]))
        return true
    }
    (*a).ptr_x = x
    (*a).ptr_y = y
    if (*a).lists_on {
        if kind == fuiwirt.HOOK_LEAVE {
            if lists_hover(a, 0 as u32) {
                return true
            }
        }
        if kind == fuiwirt.HOOK_MOVE {
            if lists_hover(a, listrow.listrow_hit(&(*a).sc, x, y)) {
                return true
            }
        }
        if kind == fuiwirt.HOOK_DOWN {
            let key: u32 = listrow.listrow_hit(&(*a).sc, x, y)
            if key != 0 as u32 && lists_pick(a, key) {
                (*a).drag_k = NONE
                return true
            }
        }
    }
    if kind == fuiwirt.HOOK_UP {
        if (*a).touch_k != NONE {
            let tk: usize = (*a).touch_k
            (*a).touch_k = NONE
            if !(*a).touch_moved {
                press_field(a, tk, x, y)
                editor.editor_mouse_up(&(*a).ed[tk])
                return true
            }
            return false
        }
        if (*a).drag_k == NONE {
            return false
        }
        editor.editor_mouse_up(&(*a).ed[(*a).drag_k])
        (*a).drag_k = NONE
        return false
    }
    if kind == fuiwirt.HOOK_DOWN {
        (*a).drag_k = NONE
        (*a).touch_k = NONE
        let k: usize = slot_at(a, x, y)
        if k == NONE {
            return false
        }
        // A FINGER ON A TEXT AREA scrolls it: the caret waits for the lift
        // (a tap that did not move), so a swipe never selects a word.
        if (*a).area[k] && fuiwirt.host_pointer_type(&(*a).w) == event.PT_TOUCH {
            (*a).touch_k = k
            (*a).touch_x = x
            (*a).touch_y = y
            (*a).touch_moved = false
            return false
        }
        press_field(a, k, x, y)
        (*a).drag_k = k
        return true
    }
    if kind == fuiwirt.HOOK_MOVE && (*a).touch_k != NONE {
        let dy: f64 = y - (*a).touch_y
        if !(*a).touch_moved && dy < TOUCH_SLOP && dy > 0.0 - TOUCH_SLOP {
            return false
        }
        (*a).touch_moved = true
        (*a).touch_y = y
        textarea.ta_wheel(&(*a).lines[(*a).touch_k], 0.0 - dy)
        return true
    }
    if kind == fuiwirt.HOOK_MOVE && (*a).drag_k != NONE {
        let k: usize = (*a).drag_k
        let e: *mut widget.Widget = scene.node_widget(&(*a).sc, (*a).ed_node[k])
        let c: *mut render.Ctx = &(*a).c
        let x0: f64 = render.field_text_x0(c, e)
        if (*a).area[k] {
            let y0: f64 = widget.w_y(e) + render.pady_of(c, e)
            let r: u32 = textarea.ta_mouse_drag(&(*a).lines[k], &(*a).ed[k],
                x - x0, y - y0)
        } else {
            var fm: render.FieldMeas = render.field_meas_new(c, e)
            let r2: u32 = editor.editor_mouse_drag(&(*a).ed[k], x - x0,
                render.field_meas, (&fm) as u64)
        }
        return true
    }
    return false
}

// The text field (slot) under a point, NONE if there is none.
fn slot_at(a: *mut App, x: f64, y: f64) -> usize {
    let n: usize = scene.scene_hit(&(*a).sc, x, y)
    if n == scene.SCENE_NONE {
        return NONE
    }
    return slot_of(a, n)
}

// The host says node `i` was activated (click, Enter, space).
fn app_act(ud: u64, i: usize) {
    let a: *mut App = ud as *mut App
    (*a).last_act = i
    // an element bound to an action (bind_action) runs it
    if (*a).cs != 0 && i < scene.scene_count(&(*a).sc) {
        let key: u32 = scene.node_id(&(*a).sc, i)
        if key != 0 as u32 {
            let cs: *mut CtxApp = (*a).cs as *mut CtxApp
            if action.act_node_action(&(*cs).acts, key) != action.ACT_NONE {
                var cx: action.ActCtx = action.actx_new(a as u64)
                cx.target = i
                cx.source = action.SRC_NONE
                let rr: u32 = action.act_run_node(&(*cs).acts, key, &cx)
                fuiwirt.host_touch(&(*a).w)
            }
        }
    }
    if i < scene.SCENE_MAX && hcb_get(a, i) {
        let f: fn(*mut App) = cb_get(a, i)
        f(a)
        fuiwirt.host_touch(&(*a).w)
    }
    if (*a).ctl_on {
        let cf: fn(u64, usize) = (*a).ctl_act
        cf((*a).ctl_ud, i)
        fuiwirt.host_touch(&(*a).w)
    }
}

fn app_done(ud: u64) -> bool {
    let a: *mut App = ud as *mut App
    return (*a).quit
}

// The focused text field's buffer (a *mut textbuf.TextBuf as u64), 0 = no
// text field has the focus: the phone's on-screen keyboard types into it
// (lib/@linux/fui/apphost.fi, r114).
fn app_entry_buf(ud: u64) -> u64 {
    let a: *mut App = ud as *mut App
    let k: usize = focused_slot(a)
    if k == NONE {
        return 0
    }
    return editor.editor_buf(&(*a).ed[k]) as u64
}

// The phone's keyboard changed the focused field: its caret stands visible
// again (a caret that is off at the moment somebody types looks like a field
// that swallowed the key).
fn app_entry_edited(ud: u64) {
    let a: *mut App = ud as *mut App
    let k: usize = focused_slot(a)
    if k != NONE {
        editor.editor_caret_wake(&(*a).ed[k])
        edit_done(a, k)
    }
}

// The focused text field's rectangle in device pixels (for a phone's
// keyboard); false = no text field has the focus.
fn app_entry_box(ud: u64, out: *mut [f64; 4]) -> bool {
    let a: *mut App = ud as *mut App
    let k: usize = focused_slot(a)
    if k == NONE {
        return false
    }
    let i: usize = (*a).ed_node[k]
    (*out)[0] = scene.node_x(&(*a).sc, i)
    (*out)[1] = scene.node_y(&(*a).sc, i)
    (*out)[2] = scene.node_w(&(*a).sc, i)
    (*out)[3] = scene.node_h(&(*a).sc, i)
    return true
}

// ---- r444b: the input method's sink (lib/plat/fuitext.fi) -- pre-edit text, commit, cancel, delete-surrounding of the FOCUSED field.
// Each answers true when a field took it. A field that is a text area keeps its lines in step through edit_done.

fn ime_field(a: *mut App) -> usize {
    return focused_slot(a)
}

fn ime_done(a: *mut App, k: usize, r: u32) -> bool {
    if r == editor.RES_NONE {
        return false
    }
    fuiwirt.host_touch(&(*a).w)
    edit_done(a, k)
    return true
}

fn app_ime_pre(ud: u64, p: u64, n: usize, caret: usize) -> bool {
    let a: *mut App = ud as *mut App
    let k: usize = ime_field(a)
    if k == NONE { return false }
    return ime_done(a, k, editor.editor_ime_preedit(&(*a).ed[k], p, n, caret))
}

fn app_ime_commit(ud: u64, p: u64, n: usize) -> bool {
    let a: *mut App = ud as *mut App
    let k: usize = ime_field(a)
    if k == NONE { return false }
    return ime_done(a, k, editor.editor_ime_commit(&(*a).ed[k], p, n))
}

fn app_ime_end(ud: u64) {
    let a: *mut App = ud as *mut App
    let k: usize = ime_field(a)
    if k == NONE { return }
    let ok: bool = ime_done(a, k, editor.editor_ime_cancel(&(*a).ed[k]))
}

fn app_ime_del(ud: u64, before: usize, after: usize) -> bool {
    let a: *mut App = ud as *mut App
    let k: usize = ime_field(a)
    if k == NONE { return false }
    return ime_done(a, k, editor.editor_delete_surrounding(&(*a).ed[k], before, after))
}

// A mouse click (or the focus moved to another field) while pre-edit text stands: the field takes the text as it is.
fn app_ime_confirm(ud: u64) {
    let a: *mut App = ud as *mut App
    let k: usize = ime_field(a)
    if k == NONE { return }
    editor.editor_ime_end(&(*a).ed[k])
    fuiwirt.host_touch(&(*a).w)
    edit_done(a, k)
}

// The caret of the focused field; false = no field has the focus.
fn app_ime_spot(ud: u64, out: *mut [f64; 3]) -> bool {
    let a: *mut App = ud as *mut App
    if !(*a).spot_ok || ime_field(a) == NONE { return false }
    (*out)[0] = (*a).spot[0]
    (*out)[1] = (*a).spot[1]
    (*out)[2] = (*a).spot[2]
    return true
}
