// SPDX-License-Identifier: GPL-2.0-only
// lib/fui/edit.fi -- DIE BEDIENUNG EINES TEXTFELDES.
//
// ====================================================== WARUM ES SIE GIBT
//
// Justins Beschwerde vom 10.09.2026, von JARVIS auf seinem Laptop
// nachgestellt: in der Adresszeile von Certus markiert Strg+A nichts.
// Wer eine neue Adresse tippt, bekommt sie an die alte ANGEHAENGT und
// landet auf `https://xoffi.ai/https://de.wikipedia`.
//
// DIE URSACHE, GEFUNDEN UND NICHT VERMUTET. lib/fui/textfeld.fi (aus
// certus lib/widget/textfeld.fi) kann Auswahl seit Runde TEXTBOX-2 --
// `tf_alles`, `tf_sel_a`, `tf_hat_sel`, `tf_einfuegen` ersetzt eine
// bestehende Auswahl. Es kann das alles. Aber:
//
//     lib/android/a_main.fi:121   import widget.textfeld   <- benutzt es
//     lib/browser/certus_app.fi   ---                      <- benutzt es NICHT
//
// Der Schreibtisch-Browser haelt seine Adresszeile als rohen `mem.Buf`
// und haengt bei EV_CHAR mit `mem.buf_push` an. Es gibt dort keinen
// Zeiger, keinen Anker, kein Strg-A -- nicht weil es schwer waere,
// sondern weil das fertige Textfeld eine Datei weiter liegt und niemand
// es angeschlossen hat. Das Telefon hat eine richtige Textbox, der
// Schreibtisch nicht.
//
// Diese Datei ist die fehlende Haelfte: aus dem MODELL (was der Text
// ist) wird BEDIENUNG (was eine Taste damit macht).
//
// ==================================================== DIE ARBEITSTEILUNG
//
//   textfeld.fi   der Text, der Zeiger, der Anker, Wortgrenzen.
//                 Kennt keine Taste und keinen Bildschirm.
//   edit.fi       DIESE DATEI: Tasten, Maus, Rueckgaengig, Bildlauf.
//                 Kennt keine Leinwand.
//   feld.fi       das Malen und die Lage auf dem Schirm.
//
// Der Schnitt ist Absicht: `edit.fi` laesst sich ohne Fenster pruefen,
// und genau das tut tools/fui/tasten_main.fi -- jedes Tastenkuerzel
// einzeln, mit Soll und Ist.
//
// ========================================= WAS EINE PLATTFORM LIEFERN MUSS
//
// Die Zwischenablage. Sie ist der einzige Teil, den diese Datei nicht
// selbst kann, und sie kommt als zwei Funktionszeiger herein
// (`edit_setz_ablage`). Unter Android steht sie in lib/android/ime.fi
// (`ime_zwischenablage_lesen`/`-_schreiben`), unter Windows in
// lib/fenster/win32.fi, unter X11 in lib/fenster/x11.fi. Fehlt sie,
// arbeitet Strg+C/X/V auf einer INTERNEN Ablage -- das Feld
// funktioniert dann in sich, nur nicht mit anderen Programmen.
import std.rt
import fui.textfeld

export {
    Edit, edit_neu, edit_init, edit_frei,
    edit_feld, edit_setz_ablage, edit_setz_breite, edit_rolle,
    edit_taste, edit_zeichen, edit_maus_ab, edit_maus_zieh, edit_maus_auf,
    edit_marke_an, edit_marke_takt, edit_marke_wecken,
    edit_rueckgaengig, edit_wiederholen, edit_schritt_merken,
    edit_alles, edit_text_setzen, edit_leeren,
    edit_kopieren, edit_ausschneiden, edit_einfuegen,
    edit_sicht_setzen, edit_sicht,
    T_LINKS, T_RECHTS, T_POS1, T_ENDE, T_RUECK, T_ENTF, T_EINGABE,
    T_ESC, T_TAB, T_HOCH, T_RUNTER,
    M_UMSCH, M_STRG, M_ALT,
    ANTWORT_NICHTS, ANTWORT_GEAENDERT, ANTWORT_BEWEGT, ANTWORT_FERTIG,
    ANTWORT_ABBRUCH, ANTWORT_WEITER,
}

// ===================================================== DIE TASTEN
//
// EIGENE Nummern und nicht die von lib/fenster. Der Grund: diese Datei
// soll ohne Fenster pruefbar sein, und ein Pruefprogramm, das
// `fenster.K_LEFT` importiert, zieht X11 und Win32 mit herein. Die
// Umsetzung steht an EINER Stelle (`feld.fi`).
const T_LINKS: u32 = 1
const T_RECHTS: u32 = 2
const T_POS1: u32 = 3
const T_ENDE: u32 = 4
const T_RUECK: u32 = 5
const T_ENTF: u32 = 6
const T_EINGABE: u32 = 7
const T_ESC: u32 = 8
const T_TAB: u32 = 9
const T_HOCH: u32 = 10
const T_RUNTER: u32 = 11

// Die Umschalttasten, als Bitmaske. Bit 0 und Bit 2 sind die von X11,
// die lib/fenster/win32.fi nachbildet -- hier ausdruecklich benannt.
const M_UMSCH: u32 = 1
const M_STRG: u32 = 4
const M_ALT: u32 = 8

// ==================================================== DIE ANTWORTEN
//
// Was der Aufrufer nach einer Taste tun muss. `ANTWORT_WEITER` heisst
// "die Taste geht mich nichts an" -- dann darf das Programm sie selbst
// deuten (F5, Strg+T fuer einen neuen Reiter). Ohne diese Antwort
// wuerde ein fokussiertes Textfeld jede Tastenkombination des ganzen
// Programms schlucken.
const ANTWORT_NICHTS: u32 = 0
const ANTWORT_GEAENDERT: u32 = 1  // der Text ist anders -> neu malen
const ANTWORT_BEWEGT: u32 = 2     // nur Zeiger/Auswahl -> neu malen
const ANTWORT_FERTIG: u32 = 3     // Eingabetaste
const ANTWORT_ABBRUCH: u32 = 4    // Esc
const ANTWORT_WEITER: u32 = 5     // nicht meine Taste

// =============================================== DER RUECKGAENGIG-STAPEL
//
// Justin verlangt Strg+Z und Strg+Y. Das gibt es in Certus heute
// nirgends, auch nicht auf dem Telefon.
//
// GESPEICHERT WIRD DER GANZE TEXT, nicht die einzelne Aenderung. Bei
// einer Adresszeile von hoechstens ein paar hundert Oktett ist das die
// richtige Wahl: 16 Stufen a 512 Oktett sind 8 KiB, und dafuer gibt es
// keine einzige Klasse von Fehlern, die aus falsch verrechneten
// Umkehrungen entsteht. (Fuer einen Texteditor mit einem Megabyte waere
// es die falsche Wahl -- dann werden es Aenderungssaetze, und der Rest
// dieser Datei bleibt, wie er ist.)
//
// EIN SCHRITT IST EINE WORTGRENZE UND KEIN ZEICHEN. Wer "wikipedia"
// tippt und einmal Strg+Z drueckt, will nicht "wikipedi" sehen.
// `edit_schritt_merken` wird darum vor jeder Aenderung gerufen, legt
// aber nur dann ab, wenn seit dem letzten Ablegen etwas anderes als ein
// weiteres Zeichen passiert ist (`sammelt`).
const UNDO_N: usize = 16
const UNDO_CAP: usize = 512

struct Edit {
    tf: textfeld.Textfeld,
    // --- Rueckgaengig
    u_buf: *mut u8,       // UNDO_N * UNDO_CAP
    u_len: [usize; 16],
    u_zeiger: [usize; 16],
    u_n: usize,           // wieviele Stufen belegt
    u_at: usize,          // wo wir im Stapel stehen
    sammelt: u32,         // 1 = die letzte Aenderung war ein Zeichen
    // --- die Zwischenablage der Plattform
    ab_lesen: fn(u64, usize) -> usize,
    ab_schreiben: fn(u64, usize) -> bool,
    ab_da: u32,
    // --- die INTERNE Ablage, wenn die Plattform keine hat
    ab_buf: *mut u8,
    ab_n: usize,
    // --- der Bildlauf bei langem Text
    breite: f64,          // sichtbare Breite in Bildpunkten
    rolle: f64,           // wieviel nach links geschoben ist
    // --- die blinkende Einfuegemarke
    blink_us: u64,        // wann sie zuletzt umgeschaltet hat
    blink_an: u32,
    // --- die Maus
    klick_zeit: u64,
    klick_n: usize,       // 1 = einfach, 2 = doppelt, 3 = dreifach
    klick_x: f64,
}

#[no_gc]
fn nichts_lesen(p: u64, cap: usize) -> usize { return 0 }
#[no_gc]
fn nichts_schreiben(p: u64, n: usize) -> bool { return false }

#[no_gc]
fn edit_neu() -> Edit {
    return Edit {
        tf: textfeld.tf_new(),
        u_buf: 0 as *mut u8, u_len: [0; 16], u_zeiger: [0; 16],
        u_n: 0, u_at: 0, sammelt: 0,
        ab_lesen: nichts_lesen, ab_schreiben: nichts_schreiben, ab_da: 0,
        ab_buf: 0 as *mut u8, ab_n: 0,
        breite: 0.0, rolle: 0.0,
        blink_us: 0, blink_an: 1,
        klick_zeit: 0, klick_n: 0, klick_x: 0.0,
    }
}

// `p`/`cap` ist der Textpuffer und gehoert dem Aufrufer -- dieselbe
// Regel wie in textfeld.fi.
fn edit_init(e: *mut Edit, p: u64, cap: usize) -> bool {
    textfeld.tf_init(&(*e).tf, p, cap)
    (*e).u_buf = rt.heap_alloc(UNDO_N * UNDO_CAP) as *mut u8
    if (*e).u_buf as usize == 0 {
        return false
    }
    (*e).ab_buf = rt.heap_alloc(UNDO_CAP) as *mut u8
    if (*e).ab_buf as usize == 0 {
        return false
    }
    (*e).u_n = 0
    (*e).u_at = 0
    return true
}

fn edit_frei(e: *mut Edit) {
    if (*e).u_buf as usize != 0 {
        rt.heap_free((*e).u_buf as u64, UNDO_N * UNDO_CAP)
        (*e).u_buf = 0 as *mut u8
    }
    if (*e).ab_buf as usize != 0 {
        rt.heap_free((*e).ab_buf as u64, UNDO_CAP)
        (*e).ab_buf = 0 as *mut u8
    }
}

#[no_gc]
fn edit_feld(e: *mut Edit) -> *mut textfeld.Textfeld {
    return &(*e).tf
}

fn edit_setz_ablage(e: *mut Edit, lesen: fn(u64, usize) -> usize,
    schreiben: fn(u64, usize) -> bool) {
    (*e).ab_lesen = lesen
    (*e).ab_schreiben = schreiben
    (*e).ab_da = 1
}

#[no_gc]
fn edit_setz_breite(e: *mut Edit, w: f64) { (*e).breite = w }

#[no_gc]
fn edit_rolle(e: *mut Edit) -> f64 { return (*e).rolle }

// ================================================== RUECKGAENGIG

// Den jetzigen Stand ablegen. `wegen_zeichen` sagt, ob die Aenderung,
// die gleich kommt, ein einzelnes getipptes Zeichen ist -- dann wird
// nur abgelegt, wenn der letzte Schritt KEIN Zeichen war.
fn edit_schritt_merken(e: *mut Edit, wegen_zeichen: bool) {
    if wegen_zeichen && (*e).sammelt != 0 {
        return
    }
    let n: usize = textfeld.tf_len(&(*e).tf)
    if n > UNDO_CAP {
        return
    }
    // Alles, was nach der jetzigen Stelle liegt, ist ueberholt: wer
    // rueckgaengig macht und dann tippt, hat einen neuen Ast.
    var at: usize = (*e).u_at
    if at >= UNDO_N {
        // Der Stapel ist voll: die aelteste Stufe faellt weg.
        var i: usize = 1
        while i < UNDO_N {
            rt.mem_copy(((*e).u_buf as u64) + ((i - 1) * UNDO_CAP) as u64,
                ((*e).u_buf as u64) + (i * UNDO_CAP) as u64, UNDO_CAP)
            (*e).u_len[i - 1] = (*e).u_len[i]
            (*e).u_zeiger[i - 1] = (*e).u_zeiger[i]
            i = i + 1
        }
        at = UNDO_N - 1
    }
    rt.mem_copy(((*e).u_buf as u64) + (at * UNDO_CAP) as u64,
        textfeld.tf_ptr(&(*e).tf), n)
    (*e).u_len[at] = n
    (*e).u_zeiger[at] = textfeld.tf_zeiger(&(*e).tf)
    (*e).u_at = at + 1
    (*e).u_n = at + 1
    if wegen_zeichen {
        (*e).sammelt = 1
    } else {
        (*e).sammelt = 0
    }
}

fn edit_rueckgaengig(e: *mut Edit) -> bool {
    if (*e).u_at == 0 {
        return false
    }
    // Steht der Zeiger am oberen Ende, muss der JETZIGE Stand zuerst
    // abgelegt werden -- sonst waere er nach dem ersten Strg+Z verloren
    // und Strg+Y haette nichts, wohin es zurueckkehrt.
    if (*e).u_at == (*e).u_n {
        let n: usize = textfeld.tf_len(&(*e).tf)
        if n <= UNDO_CAP && (*e).u_n < UNDO_N {
            rt.mem_copy(((*e).u_buf as u64) + ((*e).u_n * UNDO_CAP) as u64,
                textfeld.tf_ptr(&(*e).tf), n)
            (*e).u_len[(*e).u_n] = n
            (*e).u_zeiger[(*e).u_n] = textfeld.tf_zeiger(&(*e).tf)
            (*e).u_n = (*e).u_n + 1
        }
    }
    (*e).u_at = (*e).u_at - 1
    let at: usize = (*e).u_at
    textfeld.tf_text_setzen(&(*e).tf,
        ((*e).u_buf as u64) + (at * UNDO_CAP) as u64, (*e).u_len[at])
    textfeld.tf_setze(&(*e).tf, (*e).u_zeiger[at], (*e).u_zeiger[at])
    (*e).sammelt = 0
    return true
}

fn edit_wiederholen(e: *mut Edit) -> bool {
    if (*e).u_at + 1 >= (*e).u_n {
        return false
    }
    (*e).u_at = (*e).u_at + 1
    let at: usize = (*e).u_at
    textfeld.tf_text_setzen(&(*e).tf,
        ((*e).u_buf as u64) + (at * UNDO_CAP) as u64, (*e).u_len[at])
    textfeld.tf_setze(&(*e).tf, (*e).u_zeiger[at], (*e).u_zeiger[at])
    (*e).sammelt = 0
    return true
}

// ================================================ DIE ZWISCHENABLAGE

fn edit_kopieren(e: *mut Edit) -> bool {
    if !textfeld.tf_hat_sel(&(*e).tf) {
        return false
    }
    if textfeld.tf_geheim(&(*e).tf) {
        // Ein Passwortfeld gibt nichts heraus.
        return false
    }
    let a: usize = textfeld.tf_sel_a(&(*e).tf)
    let b: usize = textfeld.tf_sel_b(&(*e).tf)
    let n: usize = b - a
    let von: u64 = textfeld.tf_ptr(&(*e).tf) + a as u64
    if (*e).ab_da != 0 {
        let f: fn(u64, usize) -> bool = (*e).ab_schreiben
        if f(von, n) {
            return true
        }
    }
    // Die interne Ablage -- besser als gar nichts.
    var k: usize = n
    if k > UNDO_CAP {
        k = UNDO_CAP
    }
    rt.mem_copy((*e).ab_buf as u64, von, k)
    (*e).ab_n = k
    return true
}

fn edit_ausschneiden(e: *mut Edit) -> bool {
    if !textfeld.tf_hat_sel(&(*e).tf) {
        return false
    }
    if !edit_kopieren(e) {
        return false
    }
    edit_schritt_merken(e, false)
    return textfeld.tf_auswahl_loeschen(&(*e).tf)
}

fn edit_einfuegen(e: *mut Edit) -> bool {
    var puf: [u8; 512] = [0; 512]
    var n: usize = 0
    if (*e).ab_da != 0 {
        let f: fn(u64, usize) -> usize = (*e).ab_lesen
        n = f((&puf[0]) as u64, 512)
    }
    if n == 0 && (*e).ab_n > 0 {
        n = (*e).ab_n
        rt.mem_copy((&puf[0]) as u64, (*e).ab_buf as u64, n)
    }
    if n == 0 {
        return false
    }
    // ZEILENUMBRUECHE WERDEN ZU LEERZEICHEN. Ein einzeiliges Feld mit
    // einem Zeilenumbruch darin malt einen leeren Kasten -- und eine
    // aus einer Textdatei kopierte Adresse bringt fast immer einen mit.
    var i: usize = 0
    while i < n {
        let c: u8 = *(((&puf[0]) as u64 + i as u64) as *mut u8)
        if c == 10 as u8 || c == 13 as u8 || c == 9 as u8 {
            *(((&puf[0]) as u64 + i as u64) as *mut u8) = 32 as u8
        }
        i = i + 1
    }
    edit_schritt_merken(e, false)
    return textfeld.tf_einfuegen(&(*e).tf, (&puf[0]) as u64, n)
}

// ==================================================== DIE TASTEN

// EINE TASTE MIT BEDEUTUNG. `mods` ist die Bitmaske M_*.
//
// Hier steht die ganze Tastenbelegung eines Textfeldes an EINER Stelle
// -- und das ist der Punkt: heute steht sie in lib/android/a_main.fi
// (Telefon) und gar nicht in lib/browser/certus_app.fi (Schreibtisch).
fn edit_taste(e: *mut Edit, taste: u32, mods: u32) -> u32 {
    let t: *mut textfeld.Textfeld = &(*e).tf
    let halten: bool = (mods & M_UMSCH) != 0 as u32
    let strg: bool = (mods & M_STRG) != 0 as u32
    edit_marke_wecken(e)

    if taste == T_LINKS {
        if strg {
            wort_links(e, halten)
        } else {
            textfeld.tf_links(t, halten)
        }
        (*e).sammelt = 0
        return ANTWORT_BEWEGT
    }
    if taste == T_RECHTS {
        if strg {
            wort_rechts(e, halten)
        } else {
            textfeld.tf_rechts(t, halten)
        }
        (*e).sammelt = 0
        return ANTWORT_BEWEGT
    }
    if taste == T_POS1 {
        textfeld.tf_anfang(t, halten)
        (*e).sammelt = 0
        return ANTWORT_BEWEGT
    }
    if taste == T_ENDE {
        textfeld.tf_ende(t, halten)
        (*e).sammelt = 0
        return ANTWORT_BEWEGT
    }
    if taste == T_RUECK {
        edit_schritt_merken(e, false)
        // Strg+Rueck loescht das Wort links -- so macht es jedes Feld.
        if strg && !textfeld.tf_hat_sel(t) {
            let bis: usize = textfeld.tf_zeiger(t)
            wort_links(e, true)
            let von: usize = textfeld.tf_zeiger(t)
            textfeld.tf_setze(t, von, von)
            let ok: bool = textfeld.tf_loesche(t, von, bis)
            return ANTWORT_GEAENDERT
        }
        let ok2: bool = textfeld.tf_rueck(t)
        return ANTWORT_GEAENDERT
    }
    if taste == T_ENTF {
        edit_schritt_merken(e, false)
        if strg && !textfeld.tf_hat_sel(t) {
            let von: usize = textfeld.tf_zeiger(t)
            wort_rechts(e, true)
            let bis: usize = textfeld.tf_zeiger(t)
            textfeld.tf_setze(t, von, von)
            let ok: bool = textfeld.tf_loesche(t, von, bis)
            return ANTWORT_GEAENDERT
        }
        let ok2: bool = textfeld.tf_entf(t)
        return ANTWORT_GEAENDERT
    }
    if taste == T_EINGABE {
        return ANTWORT_FERTIG
    }
    if taste == T_ESC {
        return ANTWORT_ABBRUCH
    }
    return ANTWORT_WEITER
}

// EIN GETIPPTES ZEICHEN. Getrennt von `edit_taste`, weil die
// Fensterschicht es getrennt liefert (EV_CHAR gegen EV_KEY) -- die
// Trennung, die Windows mit WM_CHAR/WM_KEYDOWN vorgibt und die X11
// nachbildet.
//
// HIER LIEGEN AUCH DIE STRG-KUERZEL. Grund: Windows schickt Strg+A als
// WM_CHAR mit dem Wert 1 (Steuerzeichen), nicht als Taste. Wer nur
// `edit_taste` bedient, bekommt Strg+A NIE zu sehen -- und genau das
// ist ein Weg, auf dem Justins Fehler entstanden sein kann.
fn edit_zeichen(e: *mut Edit, cp: u32, mods: u32) -> u32 {
    let t: *mut textfeld.Textfeld = &(*e).tf
    edit_marke_wecken(e)
    let strg: bool = (mods & M_STRG) != 0 as u32

    // Strg-Kuerzel: entweder als Steuerzeichen (1..26) oder als
    // Buchstabe mit gesetztem Strg-Bit. Beide Wege werden bedient.
    var k: u32 = 0
    if cp >= 1 as u32 && cp <= 26 as u32 {
        k = cp + 96 as u32           // 1 -> 'a'
    } else if strg {
        if cp >= 65 as u32 && cp <= 90 as u32 {
            k = cp + 32 as u32       // 'A' -> 'a'
        } else if cp >= 97 as u32 && cp <= 122 as u32 {
            k = cp
        }
    }
    if k != 0 as u32 {
        // ============================================================
        // STRG+A -- JUSTINS FEHLER.
        // ============================================================
        // `tf_alles` setzt Anker auf 0 und Zeiger auf n. Das naechste
        // getippte Zeichen geht durch `tf_einfuegen`, und das ruft
        // `tf_ersetzen(sel_a, sel_b, ...)` -- die Auswahl wird also
        // ERSETZT und nicht ergaenzt. Damit ist
        // "https://xoffi.ai/https://de.wikipedia" nicht mehr moeglich.
        if k == 97 as u32 {                    // a
            textfeld.tf_alles(t)
            return ANTWORT_BEWEGT
        }
        if k == 99 as u32 {                    // c
            let ok: bool = edit_kopieren(e)
            return ANTWORT_NICHTS
        }
        if k == 120 as u32 {                   // x
            if edit_ausschneiden(e) {
                return ANTWORT_GEAENDERT
            }
            return ANTWORT_NICHTS
        }
        if k == 118 as u32 {                   // v
            if edit_einfuegen(e) {
                return ANTWORT_GEAENDERT
            }
            return ANTWORT_NICHTS
        }
        if k == 122 as u32 {                   // z
            // Strg+Umschalt+Z ist die zweite uebliche Belegung fuer
            // Wiederholen.
            if (mods & M_UMSCH) != 0 as u32 {
                if edit_wiederholen(e) {
                    return ANTWORT_GEAENDERT
                }
                return ANTWORT_NICHTS
            }
            if edit_rueckgaengig(e) {
                return ANTWORT_GEAENDERT
            }
            return ANTWORT_NICHTS
        }
        if k == 121 as u32 {                   // y
            if edit_wiederholen(e) {
                return ANTWORT_GEAENDERT
            }
            return ANTWORT_NICHTS
        }
        // Ein Strg-Kuerzel, das dem Feld nichts sagt, gehoert dem
        // Programm: Strg+T macht einen Reiter auf und darf hier nicht
        // als Buchstabe im Text landen.
        return ANTWORT_WEITER
    }

    // Steuerzeichen ausser den Kuerzeln landen nie im Text.
    if cp < 32 as u32 || cp == 127 as u32 {
        return ANTWORT_WEITER
    }
    edit_schritt_merken(e, true)
    if !textfeld.tf_einfuegen_cp(t, cp) {
        return ANTWORT_NICHTS
    }
    return ANTWORT_GEAENDERT
}

// ---- die Wortspruenge
//
// `tf_wort_um` gibt die Grenzen des Wortes AN einer Stelle. Fuer den
// Sprung braucht es die naechste Grenze in eine Richtung, und das ist
// eine andere Frage: von der Mitte eines Wortes geht Strg+Links an
// seinen Anfang, von dessen Anfang an den Anfang des Wortes davor.
fn wort_links(e: *mut Edit, halten: bool) {
    let t: *mut textfeld.Textfeld = &(*e).tf
    var i: usize = textfeld.tf_zeiger(t)
    if i == 0 {
        textfeld.tf_zeiger_setzen(t, 0, halten)
        return
    }
    // erst ueber die Nicht-Wortzeichen links
    while i > 0 {
        let j: usize = textfeld.tf_vor(t, i)
        if textfeld.tf_ist_wortzeichen(okt_bei(t, j)) {
            break
        }
        i = j
    }
    // dann ueber das Wort
    while i > 0 {
        let j: usize = textfeld.tf_vor(t, i)
        if !textfeld.tf_ist_wortzeichen(okt_bei(t, j)) {
            break
        }
        i = j
    }
    textfeld.tf_zeiger_setzen(t, i, halten)
}

fn wort_rechts(e: *mut Edit, halten: bool) {
    let t: *mut textfeld.Textfeld = &(*e).tf
    let n: usize = textfeld.tf_len(t)
    var i: usize = textfeld.tf_zeiger(t)
    // ueber das Wort
    while i < n {
        if !textfeld.tf_ist_wortzeichen(okt_bei(t, i)) {
            break
        }
        i = textfeld.tf_nach(t, i)
    }
    // ueber die Nicht-Wortzeichen
    while i < n {
        if textfeld.tf_ist_wortzeichen(okt_bei(t, i)) {
            break
        }
        i = textfeld.tf_nach(t, i)
    }
    textfeld.tf_zeiger_setzen(t, i, halten)
}

#[no_gc]
fn okt_bei(t: *mut textfeld.Textfeld, i: usize) -> u8 {
    if i >= textfeld.tf_len(t) {
        return 0 as u8
    }
    return *((textfeld.tf_ptr(t) + i as u64) as *mut u8)
}

// ======================================================= DIE MAUS
//
// `x` ist die Stelle IM TEXT (also schon um `rolle` bereinigt), `mess`
// misst die Breite der ersten n Oktett -- dieselbe Rueckrufform, die
// textfeld.fi schon benutzt.
//
// Einfach-, Doppel- und Dreifachklick unterscheiden sich nur in der
// Zeit und in der Strecke. 400 ms ist die Frist, die Windows
// (GetDoubleClickTime) voreingestellt liefert.
const DOPPEL_US: u64 = 400000

fn edit_maus_ab(e: *mut Edit, x: f64, jetzt_us: u64,
    mess: fn(u64, u64, usize) -> f64, ctx: u64, halten: bool) -> u32 {
    let t: *mut textfeld.Textfeld = &(*e).tf
    edit_marke_wecken(e)
    var dx: f64 = x - (*e).klick_x
    if dx < 0.0 {
        dx = 0.0 - dx
    }
    if jetzt_us - (*e).klick_zeit < DOPPEL_US && dx < 4.0 {
        (*e).klick_n = (*e).klick_n + 1
    } else {
        (*e).klick_n = 1
    }
    (*e).klick_zeit = jetzt_us
    (*e).klick_x = x
    let pos: usize = textfeld.tf_zeiger_aus_x(t, x + (*e).rolle, mess, ctx)

    if (*e).klick_n >= 3 {
        // Dreifachklick: alles.
        textfeld.tf_alles(t)
        textfeld.tf_set_zieh(t, 0)
        return ANTWORT_BEWEGT
    }
    if (*e).klick_n == 2 {
        // Doppelklick: das Wort.
        textfeld.tf_wort_markieren(t, pos)
        textfeld.tf_set_zieh(t, 0)
        return ANTWORT_BEWEGT
    }
    textfeld.tf_zeiger_setzen(t, pos, halten)
    textfeld.tf_set_zieh(t, 1)
    (*e).sammelt = 0
    return ANTWORT_BEWEGT
}

fn edit_maus_zieh(e: *mut Edit, x: f64,
    mess: fn(u64, u64, usize) -> f64, ctx: u64) -> u32 {
    let t: *mut textfeld.Textfeld = &(*e).tf
    if textfeld.tf_zieh(t) == 0 as u32 {
        return ANTWORT_NICHTS
    }
    let pos: usize = textfeld.tf_zeiger_aus_x(t, x + (*e).rolle, mess, ctx)
    // `halten` ist beim Ziehen immer wahr: der Anker bleibt, wo die
    // Maus heruntergegangen ist.
    textfeld.tf_zeiger_setzen(t, pos, true)
    edit_marke_wecken(e)
    return ANTWORT_BEWEGT
}

fn edit_maus_auf(e: *mut Edit) -> u32 {
    textfeld.tf_set_zieh(&(*e).tf, 0)
    return ANTWORT_NICHTS
}

// ============================================ DIE BLINKENDE MARKE
//
// 530 ms ist die Voreinstellung von Windows (Systemsteuerung, Tastatur)
// und liegt zwischen den 500 ms von GTK und den 600 ms von macOS.
const BLINK_US: u64 = 530000

// Nach jeder Eingabe steht die Marke wieder SICHTBAR da. Eine Marke,
// die genau in dem Augenblick unsichtbar ist, in dem jemand tippt,
// sieht aus wie ein Feld, das die Taste verschluckt hat.
#[no_gc]
fn edit_marke_wecken(e: *mut Edit) {
    (*e).blink_an = 1
    (*e).blink_us = 0
}

// Ist die Marke JETZT sichtbar? `jetzt_us` kommt vom Aufrufer, damit
// diese Datei keine Uhr braucht und im Pruefstand steuerbar bleibt.
fn edit_marke_takt(e: *mut Edit, jetzt_us: u64) -> bool {
    if (*e).blink_us == 0 {
        (*e).blink_us = jetzt_us
        (*e).blink_an = 1
        return true
    }
    if jetzt_us - (*e).blink_us >= BLINK_US {
        (*e).blink_us = jetzt_us
        if (*e).blink_an != 0 {
            (*e).blink_an = 0
        } else {
            (*e).blink_an = 1
        }
    }
    return (*e).blink_an != 0
}

#[no_gc]
fn edit_marke_an(e: *mut Edit) -> bool {
    return (*e).blink_an != 0
}

// ========================================== DER BILDLAUF BEI LANGEM TEXT
//
// Die Marke muss sichtbar bleiben, sonst tippt man ins Blinde. Gerollt
// wird NUR so weit wie noetig -- wer die Marke immer mittig haelt,
// laesst den Text bei jedem Zeichen springen.
fn edit_sicht_setzen(e: *mut Edit, mess: fn(u64, u64, usize) -> f64,
    ctx: u64) {
    let t: *mut textfeld.Textfeld = &(*e).tf
    if (*e).breite <= 0.0 {
        return
    }
    let cx: f64 = textfeld.tf_x_von(t, textfeld.tf_zeiger(t), mess, ctx)
    // links herausgelaufen
    if cx < (*e).rolle {
        (*e).rolle = cx
    }
    // rechts herausgelaufen. Zwei Bildpunkte Luft, damit die Marke
    // nicht auf der Kante klebt.
    let rechts: f64 = (*e).rolle + (*e).breite - 2.0
    if cx > rechts {
        (*e).rolle = cx - (*e).breite + 2.0
    }
    // Nie weiter rollen, als Text da ist.
    let ganz: f64 = textfeld.tf_x_von(t, textfeld.tf_len(t), mess, ctx)
    if (*e).rolle > ganz - (*e).breite {
        (*e).rolle = ganz - (*e).breite
    }
    if (*e).rolle < 0.0 {
        (*e).rolle = 0.0
    }
}

#[no_gc]
fn edit_sicht(e: *mut Edit) -> f64 { return (*e).rolle }

// ======================================================== BEQUEMES

fn edit_alles(e: *mut Edit) {
    textfeld.tf_alles(&(*e).tf)
}

// Text von aussen setzen (eine neue Adresse nach dem Laden). Die
// Auswahl ist danach weg und der Zeiger steht am Ende.
fn edit_text_setzen(e: *mut Edit, p: u64, n: usize) {
    edit_schritt_merken(e, false)
    textfeld.tf_text_setzen(&(*e).tf, p, n)
    (*e).rolle = 0.0
    edit_marke_wecken(e)
}

fn edit_leeren(e: *mut Edit) {
    edit_schritt_merken(e, false)
    textfeld.tf_leeren(&(*e).tf)
    (*e).rolle = 0.0
    edit_marke_wecken(e)
}
