// SPDX-License-Identifier: MPL-2.0
export {
    Route, Routes, Match, NavEntry, Nav,
    NAV_NONE, NAV_MAX_ROUTES, NAV_MAX_PARAMS, NAV_MAX_URL, NAV_MAX_STACK,
    nroute_new, nroute_add, nroute_find, nroute_count, nroute_id,
    nroute_parse, nroute_match_new, nroute_set, nroute_get, nroute_query,
    nroute_build, nroute_make, nroute_decode,
    nnav_new, nnav_push, nnav_pop, nnav_replace, nnav_clear, nnav_depth,
    nnav_can_back, nnav_top, nnav_at, nnav_save, nnav_restore,
}

const NAV_NONE: usize = 0xFFFFFFFF
const NAV_MAX_ROUTES: usize = 24
const NAV_MAX_PARAMS: usize = 4
const NAV_MAX_URL: usize = 160
const NAV_MAX_STACK: usize = 24

struct Route {
    id: str,
    scheme: str,
    pattern: str,
    nparams: usize,
}

struct Routes {
    r: [Route; 24],
    n: usize,
}

struct Match {
    ok: bool,
    route: usize,
    np: usize,
    names: [str; 4],
    vals: [str; 4],
    query: str,
}

struct NavEntry {
    url: [u8; 160],
    len: usize,
}

struct Nav {
    e: [NavEntry; 24],
    n: usize,
}

fn bt(s: str, i: usize) -> u8 {
    return *((s.p as u64 + i as u64) as *mut u8)
}

fn sub(s: str, from: usize, to: usize) -> str {
    if from >= s.n || to <= from { return str { p: s.p, n: 0 } }
    var e: usize = to
    if e > s.n { e = s.n }
    return str { p: (s.p as u64 + from as u64) as *mut u8, n: e - from }
}

fn same(a: str, b: str) -> bool {
    if a.n != b.n { return false }
    var i: usize = 0
    while i < a.n {
        if bt(a, i) != bt(b, i) { return false }
        i = i + 1
    }
    return true
}

fn find_byte(s: str, ch: u8, from: usize) -> usize {
    var i: usize = from
    while i < s.n {
        if bt(s, i) == ch { return i }
        i = i + 1
    }
    return s.n
}

fn find_scheme_end(s: str) -> usize {
    var i: usize = 0
    while i + 2 < s.n {
        if bt(s, i) == (58 as u8) && bt(s, i + 1) == (47 as u8) && bt(s, i + 2) == (47 as u8) { return i }
        i = i + 1
    }
    return NAV_NONE
}

fn is_param(seg: str) -> bool {
    return seg.n > 1 && bt(seg, 0) == (58 as u8)
}

fn seg_at(s: str, k: usize) -> str {
    var from: usize = 0
    var idx: usize = 0
    while true {
        let e: usize = find_byte(s, 47 as u8, from)
        if idx == k { return sub(s, from, e) }
        if e >= s.n { return str { p: s.p, n: 0 } }
        from = e + 1
        idx = idx + 1
    }
    return str { p: s.p, n: 0 }
}

fn seg_count(s: str) -> usize {
    if s.n == 0 { return 0 }
    var n: usize = 1
    var i: usize = 0
    while i < s.n {
        if bt(s, i) == (47 as u8) { n = n + 1 }
        i = i + 1
    }
    return n
}

fn blank_route() -> Route {
    return Route { id: "", scheme: "", pattern: "", nparams: 0 }
}

fn nroute_new() -> Routes {
    return Routes { r: [blank_route(); 24], n: 0 }
}

fn nroute_count(rs: *mut Routes) -> usize { return (*rs).n }

fn nroute_id(rs: *mut Routes, i: usize) -> str {
    if i >= (*rs).n { return "" }
    return (*rs).r[i].id
}

fn nroute_find(rs: *mut Routes, id: str) -> usize {
    var i: usize = 0
    while i < (*rs).n {
        if same((*rs).r[i].id, id) { return i }
        i = i + 1
    }
    return NAV_NONE
}

fn pattern_ok(pattern: str) -> bool {
    let n: usize = seg_count(pattern)
    var np: usize = 0
    var i: usize = 0
    while i < n {
        let sg: str = seg_at(pattern, i)
        if sg.n == 0 { return false }
        if is_param(sg) {
            np = np + 1
            var j: usize = i
            while j > 0 {
                j = j - 1
                if same(seg_at(pattern, j), sg) { return false }
            }
        }
        i = i + 1
    }
    return np <= NAV_MAX_PARAMS
}

fn nroute_add(rs: *mut Routes, id: str, scheme: str, pattern: str) -> usize {
    if (*rs).n >= NAV_MAX_ROUTES || id.n == 0 || scheme.n == 0 { return NAV_NONE }
    if nroute_find(rs, id) != NAV_NONE { return NAV_NONE }
    if !pattern_ok(pattern) { return NAV_NONE }
    var np: usize = 0
    var i: usize = 0
    let n: usize = seg_count(pattern)
    while i < n {
        if is_param(seg_at(pattern, i)) { np = np + 1 }
        i = i + 1
    }
    let at: usize = (*rs).n
    (*rs).r[at] = Route { id: id, scheme: scheme, pattern: pattern, nparams: np }
    (*rs).n = at + 1
    return at
}

fn match_blank() -> Match {
    return Match { ok: false, route: NAV_NONE, np: 0, names: [""; 4], vals: [""; 4], query: "" }
}

fn nroute_parse(rs: *mut Routes, url: str) -> Match {
    var m: Match = match_blank()
    let se: usize = find_scheme_end(url)
    if se == NAV_NONE { return m }
    let scheme: str = sub(url, 0, se)
    var rest: str = sub(url, se + 3, url.n)
    let h: usize = find_byte(rest, 35 as u8, 0)
    if h < rest.n { rest = sub(rest, 0, h) }
    let q: usize = find_byte(rest, 63 as u8, 0)
    if q < rest.n {
        m.query = sub(rest, q + 1, rest.n)
        rest = sub(rest, 0, q)
    }
    let ns: usize = seg_count(rest)
    var ri: usize = 0
    while ri < (*rs).n {
        let r: Route = (*rs).r[ri]
        if same(r.scheme, scheme) && seg_count(r.pattern) == ns {
            var good: bool = true
            var np: usize = 0
            var k: usize = 0
            while k < ns {
                let ps: str = seg_at(r.pattern, k)
                let us: str = seg_at(rest, k)
                if is_param(ps) {
                    if us.n == 0 { good = false }
                    m.names[np] = sub(ps, 1, ps.n)
                    m.vals[np] = us
                    np = np + 1
                } else if !same(ps, us) {
                    good = false
                }
                k = k + 1
            }
            if good {
                m.ok = true
                m.route = ri
                m.np = np
                return m
            }
        }
        ri = ri + 1
    }
    m.query = ""
    return m
}

fn nroute_match_new(rs: *mut Routes, id: str) -> Match {
    var m: Match = match_blank()
    let ri: usize = nroute_find(rs, id)
    if ri == NAV_NONE { return m }
    let pat: str = (*rs).r[ri].pattern
    let n: usize = seg_count(pat)
    var k: usize = 0
    while k < n {
        let sg: str = seg_at(pat, k)
        if is_param(sg) {
            m.names[m.np] = sub(sg, 1, sg.n)
            m.np = m.np + 1
        }
        k = k + 1
    }
    m.ok = true
    m.route = ri
    return m
}

fn nroute_set(m: *mut Match, name: str, value: str) -> bool {
    var i: usize = 0
    while i < (*m).np {
        if same((*m).names[i], name) {
            (*m).vals[i] = value
            return true
        }
        i = i + 1
    }
    return false
}

fn nroute_get(m: *mut Match, name: str) -> str {
    var i: usize = 0
    while i < (*m).np {
        if same((*m).names[i], name) { return (*m).vals[i] }
        i = i + 1
    }
    return ""
}

fn nroute_query(m: *mut Match, key: str) -> str {
    let q: str = (*m).query
    var from: usize = 0
    while from < q.n {
        let e: usize = find_byte(q, 38 as u8, from)
        let pair: str = sub(q, from, e)
        let eq: usize = find_byte(pair, 61 as u8, 0)
        if same(sub(pair, 0, eq), key) {
            if eq < pair.n { return sub(pair, eq + 1, pair.n) }
            return ""
        }
        from = e + 1
    }
    return ""
}

fn hex_digit(v: u8) -> u8 {
    if v < (10 as u8) { return 48 as u8 + v }
    return 55 as u8 + v
}

fn unreserved(c: u8) -> bool {
    if c >= (48 as u8) && c <= (57 as u8) { return true }
    if c >= (65 as u8) && c <= (90 as u8) { return true }
    if c >= (97 as u8) && c <= (122 as u8) { return true }
    return c == (45 as u8) || c == (46 as u8) || c == (95 as u8) || c == (126 as u8)
}

fn put(out: u64, cap: usize, at: usize, c: u8) -> usize {
    if at + 1 < cap { *((out + at as u64) as *mut u8) = c }
    return at + 1
}

fn put_str(out: u64, cap: usize, at: usize, s: str) -> usize {
    var a: usize = at
    var i: usize = 0
    while i < s.n {
        a = put(out, cap, a, bt(s, i))
        i = i + 1
    }
    return a
}

fn put_encoded(out: u64, cap: usize, at: usize, s: str) -> usize {
    var a: usize = at
    var i: usize = 0
    while i < s.n {
        let c: u8 = bt(s, i)
        if unreserved(c) {
            a = put(out, cap, a, c)
        } else {
            a = put(out, cap, a, 37 as u8)
            a = put(out, cap, a, hex_digit(c >> (4 as u8)))
            a = put(out, cap, a, hex_digit(c & (15 as u8)))
        }
        i = i + 1
    }
    return a
}

fn nroute_build(rs: *mut Routes, m: *mut Match, out: u64, cap: usize) -> usize {
    if cap < 2 || !(*m).ok || (*m).route >= (*rs).n { return 0 }
    let r: Route = (*rs).r[(*m).route]
    var at: usize = put_str(out, cap, 0, r.scheme)
    at = put_str(out, cap, at, "://")
    let n: usize = seg_count(r.pattern)
    var k: usize = 0
    var pi: usize = 0
    while k < n {
        if k > 0 { at = put(out, cap, at, 47 as u8) }
        let sg: str = seg_at(r.pattern, k)
        if is_param(sg) {
            if (*m).vals[pi].n == 0 { return 0 }
            at = put_encoded(out, cap, at, (*m).vals[pi])
            pi = pi + 1
        } else {
            at = put_str(out, cap, at, sg)
        }
        k = k + 1
    }
    if (*m).query.n > 0 {
        at = put(out, cap, at, 63 as u8)
        at = put_str(out, cap, at, (*m).query)
    }
    if at + 1 > cap { return 0 }
    *((out + at as u64) as *mut u8) = 0 as u8
    return at
}

fn nroute_make(rs: *mut Routes, id: str, a: str, b: str, c: str, out: u64, cap: usize) -> usize {
    var m: Match = nroute_match_new(rs, id)
    if !m.ok { return 0 }
    if m.np > 0 { m.vals[0] = a }
    if m.np > 1 { m.vals[1] = b }
    if m.np > 2 { m.vals[2] = c }
    return nroute_build(rs, &m, out, cap)
}

fn unhex(c: u8) -> u32 {
    if c >= (48 as u8) && c <= (57 as u8) { return (c - (48 as u8)) as u32 }
    if c >= (65 as u8) && c <= (70 as u8) { return (c - (55 as u8)) as u32 }
    if c >= (97 as u8) && c <= (102 as u8) { return (c - (87 as u8)) as u32 }
    return 0xFFFF as u32
}

fn nroute_decode(value: str, out: u64, cap: usize) -> usize {
    if cap < 1 { return 0 }
    var at: usize = 0
    var i: usize = 0
    while i < value.n && at + 1 < cap {
        var c: u8 = bt(value, i)
        if c == (37 as u8) && i + 2 < value.n {
            let h: u32 = unhex(bt(value, i + 1))
            let l: u32 = unhex(bt(value, i + 2))
            if h < (16 as u32) && l < (16 as u32) {
                c = (h * (16 as u32) + l) as u8
                i = i + 2
            }
        }
        *((out + at as u64) as *mut u8) = c
        at = at + 1
        i = i + 1
    }
    *((out + at as u64) as *mut u8) = 0 as u8
    return at
}

fn entry_blank() -> NavEntry {
    return NavEntry { url: [0 as u8; 160], len: 0 }
}

fn nnav_new() -> Nav {
    return Nav { e: [entry_blank(); 24], n: 0 }
}

fn entry_str(n: *mut Nav, i: usize) -> str {
    return str { p: (&(*n).e[i].url[0]) as *mut u8, n: (*n).e[i].len }
}

fn entry_set(n: *mut Nav, i: usize, url: str) {
    var k: usize = 0
    while k < url.n {
        (*n).e[i].url[k] = bt(url, k)
        k = k + 1
    }
    (*n).e[i].len = url.n
}

fn entry_copy(dst: *mut Nav, i: usize, src: *mut Nav, j: usize) {
    var k: usize = 0
    while k < (*src).e[j].len {
        (*dst).e[i].url[k] = (*src).e[j].url[k]
        k = k + 1
    }
    (*dst).e[i].len = (*src).e[j].len
}

fn valid_url(rs: *mut Routes, url: str) -> bool {
    if url.n == 0 || url.n > NAV_MAX_URL { return false }
    let m: Match = nroute_parse(rs, url)
    return m.ok
}

fn nnav_depth(n: *mut Nav) -> usize { return (*n).n }

fn nnav_can_back(n: *mut Nav) -> bool { return (*n).n > 1 }

fn nnav_clear(n: *mut Nav) { (*n).n = 0 }

fn nnav_top(n: *mut Nav) -> str {
    if (*n).n == 0 { return "" }
    return entry_str(n, (*n).n - 1)
}

fn nnav_at(n: *mut Nav, i: usize) -> str {
    if i >= (*n).n { return "" }
    return entry_str(n, i)
}

fn nnav_push(n: *mut Nav, rs: *mut Routes, url: str) -> bool {
    if !valid_url(rs, url) { return false }
    if (*n).n > 0 && same(nnav_top(n), url) { return true }
    if (*n).n == NAV_MAX_STACK {
        var i: usize = 1
        while i < NAV_MAX_STACK {
            entry_set(n, i - 1, entry_str(n, i))
            i = i + 1
        }
        (*n).n = NAV_MAX_STACK - 1
    }
    entry_set(n, (*n).n, url)
    (*n).n = (*n).n + 1
    return true
}

fn nnav_replace(n: *mut Nav, rs: *mut Routes, url: str) -> bool {
    if !valid_url(rs, url) { return false }
    if (*n).n == 0 { return nnav_push(n, rs, url) }
    entry_set(n, (*n).n - 1, url)
    return true
}

fn nnav_pop(n: *mut Nav) -> bool {
    if (*n).n <= 1 { return false }
    (*n).n = (*n).n - 1
    return true
}

fn nnav_save(n: *mut Nav, out: u64, cap: usize) -> usize {
    if cap < 8 { return 0 }
    var at: usize = put_str(out, cap, 0, "nav1\n")
    var i: usize = 0
    while i < (*n).n {
        at = put_str(out, cap, at, entry_str(n, i))
        at = put(out, cap, at, 10 as u8)
        i = i + 1
    }
    if at + 1 > cap { return 0 }
    *((out + at as u64) as *mut u8) = 0 as u8
    return at
}

fn nnav_restore(n: *mut Nav, rs: *mut Routes, data: str) -> usize {
    let head: usize = find_byte(data, 10 as u8, 0)
    if !same(sub(data, 0, head), "nav1") { return 0 }
    (*n).n = 0
    var from: usize = head + 1
    while from < data.n {
        let e: usize = find_byte(data, 10 as u8, from)
        let line: str = sub(data, from, e)
        if line.n > 0 { nnav_push(n, rs, line) }
        from = e + 1
    }
    return (*n).n
}
