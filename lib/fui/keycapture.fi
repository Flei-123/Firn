// lib/fui/keycapture.fi -- THE "PRESS THE NEW SHORTCUT" STATE MACHINE (gap list row 109, the rebinding UI).
//
// action.fi already knows how to rebind (act_rebind: RB_OK / RB_CONFLICT / RB_INVALID, act_reset_shortcut) -- this is the
// little dialog logic on top of it, so every settings page behaves the same:
//
//     cap_begin(&cap, i)                       the user clicked "change" on action i; the field says "Press a key..."
//     cap_key(&cap, reg, key, mods)            every key press while capturing:
//                                                key 0            only a modifier is down: keep waiting (CAP_WAIT)
//                                                Esc              give up (CAP_CANCEL)
//                                                Backspace/Delete shortcut removed (CAP_CLEARED)
//                                                a free combination  bound (CAP_DONE)
//                                                a taken combination CAP_CONFLICT: nothing changed, cap.owner = the holder;
//                                                                    the page asks "take it from <owner>?"
//                                                a bare printable key CAP_INVALID (it would eat typing)
//     cap_confirm(&cap, reg)                   the user said yes to the conflict: the holder loses it (CAP_DONE)
//     cap_cancel(&cap)                         the user said no / closed the page
//
// While `cap.active` the program must give ALL key presses to cap_key (so Esc and Ctrl+S do not run actions).
// HONEST LIMITS: one action at a time; the combination is shown by action.shortcut_text; no chords (Ctrl+K, Ctrl+C).
import fui.action

export {
    Capture, cap_new, cap_begin, cap_key, cap_confirm, cap_cancel,
    CAP_IDLE, CAP_WAIT, CAP_DONE, CAP_CANCEL, CAP_CLEARED, CAP_CONFLICT, CAP_INVALID,
}

const CAP_IDLE: u32 = 0
const CAP_WAIT: u32 = 1
const CAP_DONE: u32 = 2
const CAP_CANCEL: u32 = 3
const CAP_CLEARED: u32 = 4
const CAP_CONFLICT: u32 = 5
const CAP_INVALID: u32 = 6

struct Capture {
    active: bool,
    target: usize, // the action being rebound
    owner: usize, // on CAP_CONFLICT: the action that holds the combination
    key: u32, // on CAP_CONFLICT: the combination waiting for the answer
    mods: u32,
    state: u32, // the last CAP_* result
}

fn cap_new() -> Capture {
    return Capture { active: false, target: action.ACT_NONE, owner: action.ACT_NONE, key: 0 as u32, mods: 0 as u32, state: CAP_IDLE }
}

fn cap_begin(c: *mut Capture, i: usize) {
    (*c).active = true
    (*c).target = i
    (*c).owner = action.ACT_NONE
    (*c).key = 0 as u32
    (*c).mods = 0 as u32
    (*c).state = CAP_WAIT
}

fn cap_cancel(c: *mut Capture) {
    (*c).active = false
    (*c).owner = action.ACT_NONE
    (*c).state = CAP_CANCEL
}

fn cap_key(c: *mut Capture, reg: *mut action.Actions, key: u32, mods: u32) -> u32 {
    if !(*c).active {
        return CAP_IDLE
    }
    if key == 0 as u32 {
        (*c).state = CAP_WAIT
        return CAP_WAIT
    }
    if key == action.SK_ESCAPE {
        cap_cancel(c)
        return CAP_CANCEL
    }
    if (key == action.SK_BACKSPACE || key == action.SK_DELETE) && (mods & (action.MOD_CTRL | action.MOD_ALT | action.MOD_META)) == 0 as u32 {
        action.act_rebind(reg, (*c).target, 0 as u32, 0 as u32, false, 0 as u64 as *mut usize)
        (*c).active = false
        (*c).state = CAP_CLEARED
        return CAP_CLEARED
    }
    var owner: usize = action.ACT_NONE
    let r: u32 = action.act_rebind(reg, (*c).target, key, mods, false, &owner)
    if r == action.RB_OK {
        (*c).active = false
        (*c).state = CAP_DONE
        return CAP_DONE
    }
    if r == action.RB_CONFLICT {
        (*c).owner = owner
        (*c).key = key
        (*c).mods = mods
        (*c).state = CAP_CONFLICT
        return CAP_CONFLICT
    }
    if r == action.RB_INVALID {
        (*c).state = CAP_INVALID
        return CAP_INVALID
    }
    (*c).active = false
    (*c).state = CAP_CANCEL
    return CAP_CANCEL
}

// the answer "yes, take it" to a CAP_CONFLICT
fn cap_confirm(c: *mut Capture, reg: *mut action.Actions) -> u32 {
    if !(*c).active || (*c).state != CAP_CONFLICT {
        return CAP_IDLE
    }
    let r: u32 = action.act_rebind(reg, (*c).target, (*c).key, (*c).mods, true, 0 as u64 as *mut usize)
    (*c).active = false
    if r == action.RB_OK {
        (*c).state = CAP_DONE
        return CAP_DONE
    }
    (*c).state = CAP_CANCEL
    return CAP_CANCEL
}
