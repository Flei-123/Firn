// SPDX-License-Identifier: MPL-2.0
// lib/fui/skin.fi -- the modern app look for fui.app windows: panels, cards, side bars, chips, as style
// classes made of theme tokens only (a theme switch restyles everything).
//
//     skin.install(a)                       once per window, before the first frame
//     let side: usize = lay.vbox(a)         any box or widget ...
//     skin.add(a, side, skin.K_SIDE)        ... gets a look
//
// K_SIDE   side bar: surface ground, thin line at the edge
// K_PANEL  rounded panel on the page (12 pt radius, 1 px line)
// K_CARD   raised card: rounded, line and a soft drop shadow
// K_CHIP   small rounded pill (accent tinted by the theme)
// K_SOFT   page ground (the base colour, square)
import fui.app
import fui.scene
import fui.sheet
import fui.style

export { install, add, K_SIDE, K_PANEL, K_CARD, K_CHIP, K_SOFT, R_CARD }

const K_SIDE: u32 = 9101
const K_PANEL: u32 = 9102
const K_CARD: u32 = 9103
const K_CHIP: u32 = 9104
const K_SOFT: u32 = 9105
const R_CARD: usize = 12

fn tok(t: u32) -> u32 { return style.color_token(t) }

fn rule(a: *mut app.App, k: u32, st: style.Style) {
    let r: usize = sheet.sheet_rule(&(*a).sh, sheet.sel_class(k), st)
}

fn install(a: *mut app.App) {
    var s: style.Style = style.style_new()
    s = style.style_set_bg(s, tok(style.TOK_SURFACE))
    s = style.style_set_radius(s, 0)
    rule(a, K_SIDE, s)
    var p: style.Style = style.style_new()
    p = style.style_set_bg(p, tok(style.TOK_SURFACE))
    p = style.style_set_radius(p, R_CARD)
    p = style.style_set_border(p, tok(style.TOK_SEPARATOR), 1)
    rule(a, K_PANEL, p)
    var c: style.Style = style.style_new()
    c = style.style_set_bg(c, tok(style.TOK_SURFACE_RAISED))
    c = style.style_set_radius(c, R_CARD)
    c = style.style_set_border(c, tok(style.TOK_SEPARATOR), 1)
    c = style.style_set_box_shadow(c, 6, 18, 0, 90)
    rule(a, K_CARD, c)
    var h: style.Style = style.style_new()
    h = style.style_set_bg(h, tok(style.TOK_BUTTON))
    h = style.style_set_radius(h, 999)
    h = style.style_set_fg(h, tok(style.TOK_ACCENT))
    rule(a, K_CHIP, h)
    var g: style.Style = style.style_new()
    g = style.style_set_bg(g, tok(style.TOK_BASE))
    g = style.style_set_radius(g, 0)
    rule(a, K_SOFT, g)
}

fn add(a: *mut app.App, node: usize, k: u32) {
    if node != app.NONE {
        let r: bool = scene.node_add_class(app.app_scene(a), node, k)
    }
}
