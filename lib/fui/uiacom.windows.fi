// SPDX-License-Identifier: MPL-2.0
// lib/fui/uiacom.windows.fi -- the COM glue of the Windows UI Automation bridge (roadmap r19).
//
//     import fui.uiacom
//
//     app.set_window_hooks(a, a as u64, uiacom.opened, my_hotkey)   // or: uiacom.enable_from_env(a, "My app")
//
// WHAT IT IS. lib/fui/uia.fi answers every question a UIA provider gets (control type, name, patterns, navigation,
// rectangle ...). This file is the part that speaks COM: it hands those answers to Windows. Narrator, Inspect.exe,
// NVDA and every other UIA client send WM_GETOBJECT(UiaRootObjectId) to the window; the window procedure is
// SUBCLASSED here (SetWindowLongPtrW), and the answer is `UiaReturnRawElementProvider(hwnd, wParam, lParam, root)`.
// The root is an IRawElementProviderSimple that also is a Fragment and a FragmentRoot; every other element of the
// tree is created on demand (Navigate) from the live scene.
//
// OBJECTS. One element = one entry of a fixed pool (NENT entries, never freed by the GC: `rt.heap_alloc`). An entry
// has nine interface slots [vtable, entry index]: Simple, Fragment, FragmentRoot, Invoke, Toggle, Value, RangeValue,
// ExpandCollapse, SelectionItem. `this` of every method is the address of a slot, so the entry is one load away. One
// reference count per entry (all interfaces share it); a released entry is reused. The vtables are shared. The
// methods are `#[win_callback]` functions (Win64 -> System V thunk), the vtable words are the thunk addresses
// (`code_of4`, as in lib/window/win32.fi). Every Windows function other than the window procedure is reached with
// `gpu.wgl.dll_sym` + `callN` (no import-table entry).
//
// THREADS. The provider is registered with ProviderOptions_UseComThreading: UIA marshals every call into the
// thread that owns the window (an STA, `CoInitializeEx(STA)` in `attach`), so the scene is only ever touched from
// the window thread. If that thread already is an MTA, `attach` refuses (false) rather than run unsafe.
//
// HONEST
//   C1  NOT TESTED against a live UIA client (Narrator / Inspect): no Windows machine was reachable. What IS
//       tested: the vtables, QueryInterface, Navigate, properties, patterns by calling the objects through their
//       own vtables (tools/fui/uiacom_main.fi, Wine 8, `win64_call`) and the cross build.
//   C2  SOLVED (W23-c). RangeValue.SetValue(double) and ElementProviderFromPoint(double, double): the doubles
//       travel in xmm1/xmm2, which the `#[win_callback]` thunk (integer slots only) does not pass on. The two
//       vtable words therefore point at a tiny machine code STUB (`stub_write`, one page made executable with
//       VirtualAlloc + VirtualProtect): `movq rdx, xmm1; movq r8, xmm2; mov rax, <callback thunk>; jmp rax` --
//       the callbacks (m_rsetvalue, m_frompoint) see the double BITS in their 2nd/3rd integer parameter
//       (`f64_of`). If the page cannot be made executable the old fallbacks stay (SetValue = NOTSUPPORTED,
//       FromPoint = GetCursorPos). SetValue drives the slider through the pointer path (click at the computed
//       position, corrected by the measured value) so the app's callbacks run like for a mouse.
//   C3  SOLVED (W23-c), by POLLING like atspi.bridge_poll: a timer of the subclassed window (WM_TIMER, id 0xF0A1,
//       100 ms) calls `poll`. While no UIA client listens (UiaClientsAreListening = FALSE) it only drains its
//       queue and forgets the snapshot (one call per tick). While one listens it compares the scene with the
//       snapshot of the last tick and raises: AutomationFocusChanged (20005), property changes (Name, IsEnabled,
//       HasKeyboardFocus, ToggleState, ExpandCollapseState, SelectionItem.IsSelected, RangeValue.Value,
//       Value.Value) with UiaRaiseAutomationPropertyChangedEvent (old value VT_EMPTY), StructureChanged
//       (ChildrenInvalidated) when the node count or a node's child count changes, and Invoke.Invoked (20009,
//       queued by m_invoke, raised from the poll, never from inside the provider call). At most 64 events per tick.
//   C4  Value pattern is read only (the text field's text through the a11y name); SetValue = NOTSUPPORTED.
//   C5  Rows of virtual lists are reachable and readable, but offer no actions (like the AT-SPI bridge).
//   C6  One window per process (the globals below).
import std.rt
import std.env
import fui.scene
import fui.app
import fui.uia
import fui.control
import fui.widget
import plat.fuiwirt
import window.window
import gpu.wgl

export {
    attach, opened, enable_from_env, is_attached, root_interface, entry_count, test_attach, getobject_count,
    poll, event_count, event_at, force_listening, double_caller,
    S_SIMPLE, S_FRAGMENT, S_ROOT, S_INVOKE, S_TOGGLE, S_VALUE, S_RANGE, S_EXPAND, S_SELITEM,
}

const NENT: usize = 512
const NSLOT: usize = 9
const MW: usize = 6 // meta words per entry: used, kind, node, row, refs, pad

const S_SIMPLE: usize = 0
const S_FRAGMENT: usize = 1
const S_ROOT: usize = 2
const S_INVOKE: usize = 3
const S_TOGGLE: usize = 4
const S_VALUE: usize = 5
const S_RANGE: usize = 6
const S_EXPAND: usize = 7
const S_SELITEM: usize = 8

const NONE: usize = 4294967295

const S_OK: u64 = 0
const E_NOINTERFACE: u64 = 0x80004002
const E_POINTER: u64 = 0x80004003
const E_FAIL: u64 = 0x80004005
const E_INVALIDARG: u64 = 0x80070057
const UIA_E_ELEMENTNOTENABLED: u64 = 0x80040200
const UIA_E_ELEMENTNOTAVAILABLE: u64 = 0x80040201
const UIA_E_NOTSUPPORTED: u64 = 0x80040204

static mut G_PV: u64 = 0 // *mut uia.Provider
static mut G_APP: u64 = 0 // *mut app.App
static mut G_HWND: u64 = 0
static mut G_OLD: u64 = 0 // the window procedure we replaced
static mut G_POOL: u64 = 0 // NENT * NSLOT * 16 octets
static mut G_META: u64 = 0 // NENT * MW words
static mut G_VT: u64 = 0 // 9 vtables of 16 words
static mut G_GUID: u64 = 0 // 10 GUIDs of 16 octets
static mut G_ROOT: usize = 4294967295 // the entry of the root (never released)
static mut G_READY: bool = false
static mut G_COUNT: u64 = 0 // WM_GETOBJECT answers

// dynamic Windows functions
static mut F_RETURN: u64 = 0 // UiaReturnRawElementProvider
static mut F_HOST: u64 = 0 // UiaHostProviderFromHwnd
static mut F_CALLWND: u64 = 0 // CallWindowProcW
static mut F_SETLONG: u64 = 0 // SetWindowLongPtrW
static mut F_CLIENT2SCREEN: u64 = 0
static mut F_CURSOR: u64 = 0
static mut F_MB2WC: u64 = 0
static mut F_BSTR: u64 = 0 // SysAllocStringLen
static mut F_SACREATE: u64 = 0 // SafeArrayCreateVector
static mut F_SAPUT: u64 = 0 // SafeArrayPutElement
static mut F_VALLOC: u64 = 0 // VirtualAlloc
static mut F_VPROT: u64 = 0 // VirtualProtect
static mut F_FLUSH: u64 = 0 // FlushInstructionCache
static mut F_LISTEN: u64 = 0 // UiaClientsAreListening
static mut F_RAISE: u64 = 0 // UiaRaiseAutomationEvent
static mut F_RAISEPROP: u64 = 0 // UiaRaiseAutomationPropertyChangedEvent
static mut F_RAISESTRUCT: u64 = 0 // UiaRaiseStructureChangedEvent
static mut F_SETTIMER: u64 = 0 // SetTimer
static mut F_SYSFREE: u64 = 0 // SysFreeString

// poll state (W23-c)
const NSNAP: usize = 1024
const SW: usize = 4 // words per node in the snapshot: state, name hash, range value, child count
const NLOG: usize = 64
const TIMER_ID: u64 = 61601 // 0xF0A1
static mut G_SNAP: u64 = 0
static mut G_SNAP_N: usize = 0
static mut G_SNAP_OK: bool = false
static mut G_SNAP_FOCUS: usize = 4294967295
static mut G_FORCE: bool = false // tests: behave as if a client listened
static mut G_EV_N: u64 = 0 // events raised (also logged when the call is not available)
static mut G_ELOG: u64 = 0 // NLOG * 3 words: kind (1 event, 2 property, 3 structure), id, node
static mut G_PEND: u64 = 0 // 8 nodes whose Invoke happened
static mut G_PEND_N: usize = 0
static mut G_NB: u64 = 0 // 1024 octets of name scratch
static mut G_TRAMP: u64 = 0 // the executable stub page (0 = none)
static mut G_STUB_SET: u64 = 0
static mut G_STUB_PT: u64 = 0

// ------------------------------------------------------------------ small helpers

fn pv() -> *mut uia.Provider { return G_PV as *mut uia.Provider }

fn word(p: u64, i: usize) -> u64 { return rt.ld64(p, i) }

fn put_word(p: u64, i: usize, v: u64) { rt.st64(p, i, v) }

fn slot_ptr(e: usize, s: usize) -> u64 {
    return G_POOL + (((e * NSLOT + s) * 16) as u64)
}

fn meta(e: usize, k: usize) -> u64 { return word(G_META, e * MW + k) }

fn set_meta(e: usize, k: usize, v: u64) { put_word(G_META, e * MW + k, v) }

// the entry a `this` belongs to (NONE = not ours / released)
fn entry_of(this: u64) -> usize {
    if this == 0 || G_POOL == 0 {
        return NONE
    }
    if this < G_POOL || this >= G_POOL + ((NENT * NSLOT * 16) as u64) {
        return NONE
    }
    let e: usize = word(this, 1) as usize
    if e >= NENT || meta(e, 0) == 0 {
        return NONE
    }
    return e
}

fn el_of(e: usize) -> uia.El {
    return uia.El { kind: meta(e, 1) as u32, node: meta(e, 2) as usize, row: meta(e, 3) as usize }
}

// The entry of an element: the one that exists, else a free one (refs 0). NONE = pool full.
fn entry_for(el: uia.El) -> usize {
    var free: usize = NONE
    var i: usize = 0
    while i < NENT {
        if meta(i, 0) != 0 {
            if meta(i, 1) == (el.kind as u64) && meta(i, 2) == (el.node as u64) && meta(i, 3) == (el.row as u64) {
                return i
            }
        } else if free == NONE {
            free = i
        }
        i = i + 1
    }
    if free == NONE {
        return NONE
    }
    set_meta(free, 0, 1)
    set_meta(free, 1, el.kind as u64)
    set_meta(free, 2, el.node as u64)
    set_meta(free, 3, el.row as u64)
    set_meta(free, 4, 0)
    return free
}

fn entry_count() -> usize {
    var n: usize = 0
    var i: usize = 0
    while G_META != 0 && i < NENT {
        if meta(i, 0) != 0 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// An interface pointer for an element, AddRef'd (0 = none / pool full).
fn give(el: uia.El, s: usize) -> u64 {
    if uia.el_is_none(el) {
        return 0
    }
    let e: usize = entry_for(el)
    if e == NONE {
        return 0
    }
    set_meta(e, 4, meta(e, 4) + 1)
    return slot_ptr(e, s)
}

fn out_ptr(p: u64, v: u64) {
    if p != 0 {
        put_word(p, 0, v)
    }
}

fn out_i32(p: u64, v: i32) {
    if p != 0 {
        rt.st32(p, 0, v as u32)
    }
}

fn out_f64(p: u64, v: f64) {
    if p != 0 {
        *(p as *mut f64) = v
    }
}

// the window's client origin on the screen, refreshed before every geometry answer (the window may have moved)
fn refresh_origin() {
    if G_HWND == 0 || F_CLIENT2SCREEN == 0 {
        return
    }
    var pt: [i32; 2] = [0; 2]
    if wgl.call2(F_CLIENT2SCREEN, G_HWND, (&pt[0]) as u64) != 0 {
        uia.provider_set_origin(pv(), pt[0] as i64, pt[1] as i64)
    }
}

// BSTR from UTF-8 (0 = failed or empty)
fn bstr_of(p: u64, n: usize) -> u64 {
    if n == 0 || F_MB2WC == 0 || F_BSTR == 0 {
        return 0
    }
    var wb: [u16; 600] = [0 as u16; 600]
    var m: usize = n
    if m > 590 {
        m = 590
    }
    let c: u64 = wgl.call6(F_MB2WC, 65001, 0, p, m as u64, (&wb[0]) as u64, 600) & 4294967295
    if c == 0 {
        return 0
    }
    return wgl.call2(F_BSTR, (&wb[0]) as u64, c)
}

fn bstr_lit(s: str) -> u64 {
    return bstr_of(s.p as u64, s.n)
}

// ------------------------------------------------------------------ actions (same path as a mouse click)

fn click_node(node: usize) -> bool {
    let a: *mut app.App = G_APP as *mut app.App
    let w: *mut fuiwirt.Host = app.app_host(a)
    let sc: *mut scene.Scene = app.app_scene(a)
    if node >= scene.scene_count(sc) {
        return false
    }
    let x: f64 = scene.node_x(sc, node) + scene.node_w(sc, node) / 2.0
    let y: f64 = scene.node_y(sc, node) + scene.node_h(sc, node) / 2.0
    pointer_click(x, y)
    return true
}

// a left click at window coordinates (x, y) through the host's pointer path
fn pointer_click(x: f64, y: f64) {
    let a: *mut app.App = G_APP as *mut app.App
    let w: *mut fuiwirt.Host = app.app_host(a)
    let c1: u32 = fuiwirt.host_pointer_move(w, x, y)
    let c2: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_LEFT)
    let c3: u32 = fuiwirt.host_pointer_up(w, x, y, fuiwirt.BTN_LEFT)
    let i: usize = fuiwirt.host_take_activated(w)
    if i != fuiwirt.KEINER {
        app.app_act(a as u64, i)
    }
    fuiwirt.host_touch(w)
}

// The double whose bits are `b` (a callback gets xmm values in an integer slot through the stub).
fn f64_of(b: u64) -> f64 {
    var t: [u64; 1] = [b]
    return *((&t[0]) as *mut f64)
}

// Set a slider / progress / scrollbar node to `target` (0 .. a11y max) the way a mouse does: click on the
// computed track position, measure, correct (the handle size is not known here). Last resort: write the value.
fn set_range_node(node: usize, target: i64) -> bool {
    let a: *mut app.App = G_APP as *mut app.App
    let w: *mut fuiwirt.Host = app.app_host(a)
    let sc: *mut scene.Scene = app.app_scene(a)
    if node >= scene.scene_count(sc) {
        return false
    }
    let wd: *mut widget.Widget = scene.node_widget(sc, node)
    let x0: f64 = scene.node_x(sc, node)
    let y0: f64 = scene.node_y(sc, node)
    let w0: f64 = scene.node_w(sc, node)
    let h0: f64 = scene.node_h(sc, node)
    let horiz: bool = w0 >= h0
    var len: f64 = h0
    var lo: f64 = y0
    var thick: f64 = w0
    if horiz {
        len = w0
        lo = x0
        thick = h0
    }
    var handle: f64 = thick
    if handle > len / 2.0 {
        handle = len / 2.0
    }
    let travel: f64 = len - handle
    let span: f64 = (uia.el_range_max() - uia.el_range_min()) as f64
    var c: f64 = lo + handle / 2.0 + ((target as f64) / span) * travel
    var k: usize = 0
    while k < 6 {
        if c < lo + 1.0 {
            c = lo + 1.0
        }
        if c > lo + len - 1.0 {
            c = lo + len - 1.0
        }
        if horiz {
            pointer_click(c, y0 + h0 / 2.0)
        } else {
            pointer_click(x0 + w0 / 2.0, c)
        }
        let cur: i64 = widget.w_value(wd)
        if cur == target {
            return true
        }
        c = c + (((target - cur) as f64) / span) * travel
        k = k + 1
    }
    widget.w_set_value(wd, target)
    fuiwirt.host_touch(w)
    return widget.w_value(wd) == target
}

// 0 = S_OK, else the HRESULT
fn do_click(this: u64) -> u64 {
    let e: usize = entry_of(this)
    if e == NONE {
        return UIA_E_ELEMENTNOTAVAILABLE
    }
    let el: uia.El = el_of(e)
    if el.kind != 1 as u32 {
        return UIA_E_NOTSUPPORTED
    }
    if !uia.el_enabled(pv(), el) {
        return UIA_E_ELEMENTNOTENABLED
    }
    if !click_node(el.node) {
        return UIA_E_ELEMENTNOTAVAILABLE
    }
    return S_OK
}

// ------------------------------------------------------------------ IUnknown (shared by all nine vtables)

fn guid_is(p: u64, k: usize) -> bool {
    return word(p, 0) == word(G_GUID, k * 2) && word(p, 1) == word(G_GUID, k * 2 + 1)
}

#[win_callback]
fn m_qi(this: u64, riid: u64, ppv: u64, x: u64) -> u64 {
    if ppv == 0 || riid == 0 {
        return E_POINTER
    }
    put_word(ppv, 0, 0)
    let e: usize = entry_of(this)
    if e == NONE {
        return UIA_E_ELEMENTNOTAVAILABLE
    }
    let el: uia.El = el_of(e)
    var s: usize = NONE
    if guid_is(riid, 0) || guid_is(riid, 1) {
        s = S_SIMPLE
    } else if guid_is(riid, 2) {
        s = S_FRAGMENT
    } else if guid_is(riid, 3) {
        if e == G_ROOT {
            s = S_ROOT
        }
    } else if guid_is(riid, 4) {
        if uia.el_has_pattern(pv(), el, uia.PAT_INVOKE) { s = S_INVOKE }
    } else if guid_is(riid, 5) {
        if uia.el_has_pattern(pv(), el, uia.PAT_TOGGLE) { s = S_TOGGLE }
    } else if guid_is(riid, 6) {
        if uia.el_has_pattern(pv(), el, uia.PAT_VALUE) { s = S_VALUE }
    } else if guid_is(riid, 7) {
        if uia.el_has_pattern(pv(), el, uia.PAT_RANGE) { s = S_RANGE }
    } else if guid_is(riid, 8) {
        if uia.el_has_pattern(pv(), el, uia.PAT_EXPAND) { s = S_EXPAND }
    } else if guid_is(riid, 9) {
        if uia.el_has_pattern(pv(), el, uia.PAT_SELITEM) { s = S_SELITEM }
    }
    if s == NONE {
        return E_NOINTERFACE
    }
    set_meta(e, 4, meta(e, 4) + 1)
    put_word(ppv, 0, slot_ptr(e, s))
    return S_OK
}

#[win_callback]
fn m_addref(this: u64, b: u64, c: u64, d: u64) -> u64 {
    let e: usize = entry_of(this)
    if e == NONE {
        return 0
    }
    set_meta(e, 4, meta(e, 4) + 1)
    return meta(e, 4)
}

#[win_callback]
fn m_release(this: u64, b: u64, c: u64, d: u64) -> u64 {
    let e: usize = entry_of(this)
    if e == NONE {
        return 0
    }
    var r: u64 = meta(e, 4)
    if r > 0 {
        r = r - 1
    }
    set_meta(e, 4, r)
    if r == 0 && e != G_ROOT {
        set_meta(e, 0, 0)
    }
    return r
}

#[win_callback]
fn m_notsup(this: u64, b: u64, c: u64, d: u64) -> u64 {
    return UIA_E_NOTSUPPORTED
}

// ------------------------------------------------------------------ IRawElementProviderSimple

#[win_callback]
fn m_options(this: u64, out: u64, c: u64, d: u64) -> u64 {
    if out == 0 {
        return E_POINTER
    }
    // ServerSideProvider (2) | UseComThreading (0x20)
    rt.st32(out, 0, 34 as u32)
    return S_OK
}

#[win_callback]
fn m_getpattern(this: u64, pid: u64, out: u64, d: u64) -> u64 {
    if out == 0 {
        return E_POINTER
    }
    put_word(out, 0, 0)
    let e: usize = entry_of(this)
    if e == NONE {
        return UIA_E_ELEMENTNOTAVAILABLE
    }
    let el: uia.El = el_of(e)
    var s: usize = NONE
    let id: u32 = (pid & 4294967295) as u32
    if id == uia.pattern_id(uia.PAT_INVOKE) && uia.el_has_pattern(pv(), el, uia.PAT_INVOKE) { s = S_INVOKE }
    if id == uia.pattern_id(uia.PAT_TOGGLE) && uia.el_has_pattern(pv(), el, uia.PAT_TOGGLE) { s = S_TOGGLE }
    if id == uia.pattern_id(uia.PAT_VALUE) && uia.el_has_pattern(pv(), el, uia.PAT_VALUE) { s = S_VALUE }
    if id == uia.pattern_id(uia.PAT_RANGE) && uia.el_has_pattern(pv(), el, uia.PAT_RANGE) { s = S_RANGE }
    if id == uia.pattern_id(uia.PAT_EXPAND) && uia.el_has_pattern(pv(), el, uia.PAT_EXPAND) { s = S_EXPAND }
    if id == uia.pattern_id(uia.PAT_SELITEM) && uia.el_has_pattern(pv(), el, uia.PAT_SELITEM) { s = S_SELITEM }
    if s == NONE {
        return S_OK
    }
    set_meta(e, 4, meta(e, 4) + 1)
    put_word(out, 0, slot_ptr(e, s))
    return S_OK
}

// VARIANT (24 octets on x64): vt at 0, value at 8
fn var_empty(v: u64) {
    put_word(v, 0, 0)
    put_word(v, 1, 0)
    put_word(v, 2, 0)
}

fn var_i32(v: u64, x: i32) {
    rt.st16(v, 0, 3 as u16)
    rt.st32(v, 2, x as u32)
}

fn var_bool(v: u64, b: bool) {
    rt.st16(v, 0, 11 as u16)
    if b {
        rt.st16(v, 4, 65535 as u16)
    } else {
        rt.st16(v, 4, 0 as u16)
    }
}

fn var_bstr(v: u64, b: u64) {
    if b == 0 {
        return
    }
    rt.st16(v, 0, 8 as u16)
    put_word(v, 1, b)
}

#[win_callback]
fn m_getprop(this: u64, prop: u64, v: u64, d: u64) -> u64 {
    if v == 0 {
        return E_POINTER
    }
    var_empty(v)
    let e: usize = entry_of(this)
    if e == NONE {
        return UIA_E_ELEMENTNOTAVAILABLE
    }
    let el: uia.El = el_of(e)
    let p: u64 = prop & 4294967295
    if p == 30003 {
        var_i32(v, uia.el_control_type(pv(), el) as i32)
    } else if p == 30005 {
        var nb: [u8; 1024] = [0 as u8; 1024]
        let n: usize = uia.el_name(pv(), el, (&nb[0]) as u64, 1024)
        var_bstr(v, bstr_of((&nb[0]) as u64, n))
    } else if p == 30011 {
        var ab: rt.Buf = rt.buf_new()
        let n: usize = uia.el_automation_id(el, &ab)
        var_bstr(v, bstr_of(rt.buf_ptr(&ab), n))
        rt.buf_free(&ab)
    } else if p == 30004 {
        var_bstr(v, bstr_lit(uia.el_type_name(pv(), el)))
    } else if p == 30010 {
        var_bool(v, uia.el_enabled(pv(), el))
    } else if p == 30009 {
        var_bool(v, uia.el_focusable(pv(), el))
    } else if p == 30008 {
        var_bool(v, uia.el_has_focus(pv(), el))
    } else if p == 30016 || p == 30017 {
        var_bool(v, true)
    } else if p == 30022 || p == 30019 {
        var_bool(v, false)
    } else if p == 30024 {
        var_bstr(v, bstr_lit("fUi"))
    } else if p == 30107 {
        var_bstr(v, bstr_lit("fUi UIA bridge"))
    } else if p == 30020 && e == G_ROOT {
        var_i32(v, G_HWND as i32)
    }
    return S_OK
}

#[win_callback]
fn m_host(this: u64, out: u64, c: u64, d: u64) -> u64 {
    if out == 0 {
        return E_POINTER
    }
    put_word(out, 0, 0)
    let e: usize = entry_of(this)
    if e == NONE {
        return UIA_E_ELEMENTNOTAVAILABLE
    }
    if e == G_ROOT && F_HOST != 0 {
        // the window's own provider (non-client area, window patterns) is merged in by UIA
        let r: u64 = wgl.call2(F_HOST, G_HWND, out)
        if (r & 4294967295) != 0 {
            put_word(out, 0, 0)
        }
    }
    return S_OK
}

// ------------------------------------------------------------------ IRawElementProviderFragment

#[win_callback]
fn m_navigate(this: u64, dir: u64, out: u64, d: u64) -> u64 {
    if out == 0 {
        return E_POINTER
    }
    put_word(out, 0, 0)
    let e: usize = entry_of(this)
    if e == NONE {
        return UIA_E_ELEMENTNOTAVAILABLE
    }
    let r: uia.El = uia.el_navigate(pv(), el_of(e), (dir & 4294967295) as u32)
    put_word(out, 0, give(r, S_FRAGMENT))
    return S_OK
}

#[win_callback]
fn m_runtimeid(this: u64, out: u64, c: u64, d: u64) -> u64 {
    if out == 0 {
        return E_POINTER
    }
    put_word(out, 0, 0)
    let e: usize = entry_of(this)
    if e == NONE || F_SACREATE == 0 || F_SAPUT == 0 {
        return UIA_E_ELEMENTNOTAVAILABLE
    }
    var ids: [i32; 3] = [0; 3]
    uia.el_runtime_id(el_of(e), &ids)
    let sa: u64 = wgl.call3(F_SACREATE, 3, 0, 3)
    if sa == 0 {
        return E_FAIL
    }
    var k: usize = 0
    while k < 3 {
        var idx: [i32; 1] = [k as i32]
        var val: [i32; 1] = [ids[k]]
        wgl.call3(F_SAPUT, sa, (&idx[0]) as u64, (&val[0]) as u64)
        k = k + 1
    }
    put_word(out, 0, sa)
    return S_OK
}

#[win_callback]
fn m_bounds(this: u64, out: u64, c: u64, d: u64) -> u64 {
    if out == 0 {
        return E_POINTER
    }
    let e: usize = entry_of(this)
    if e == NONE {
        return UIA_E_ELEMENTNOTAVAILABLE
    }
    refresh_origin()
    var q: [i64; 4] = [0; 4]
    uia.el_rect(pv(), el_of(e), &q)
    // UiaRect { left, top, width, height } as doubles
    out_f64(out, q[0] as f64)
    out_f64(out + 8, q[1] as f64)
    out_f64(out + 16, q[2] as f64)
    out_f64(out + 24, q[3] as f64)
    return S_OK
}

#[win_callback]
fn m_embedded(this: u64, out: u64, c: u64, d: u64) -> u64 {
    if out == 0 {
        return E_POINTER
    }
    put_word(out, 0, 0)
    return S_OK
}

#[win_callback]
fn m_setfocus(this: u64, b: u64, c: u64, d: u64) -> u64 {
    let e: usize = entry_of(this)
    if e == NONE {
        return UIA_E_ELEMENTNOTAVAILABLE
    }
    let el: uia.El = el_of(e)
    if el.kind != 1 as u32 {
        return UIA_E_NOTSUPPORTED
    }
    let w: *mut fuiwirt.Host = app.app_host(G_APP as *mut app.App)
    let pn: *mut control.Panel = fuiwirt.host_panel(w)
    let r: u32 = control.panel_set_focus(pn, el.node)
    fuiwirt.host_touch(w)
    return S_OK
}

#[win_callback]
fn m_fragroot(this: u64, out: u64, c: u64, d: u64) -> u64 {
    if out == 0 {
        return E_POINTER
    }
    put_word(out, 0, 0)
    if G_ROOT == NONE || meta(G_ROOT, 0) == 0 {
        return UIA_E_ELEMENTNOTAVAILABLE
    }
    set_meta(G_ROOT, 4, meta(G_ROOT, 4) + 1)
    put_word(out, 0, slot_ptr(G_ROOT, S_ROOT))
    return S_OK
}

// ------------------------------------------------------------------ IRawElementProviderFragmentRoot

// (this, double x, double y, out): reached through the xmm stub, x and y arrive as double BITS (C2).
#[win_callback]
fn m_frompoint(this: u64, xb: u64, yb: u64, out: u64) -> u64 {
    if out == 0 {
        return E_POINTER
    }
    put_word(out, 0, 0)
    let x: f64 = f64_of(xb)
    let y: f64 = f64_of(yb)
    if !(x == x) || !(y == y) || x < -100000000.0 || x > 100000000.0 || y < -100000000.0 || y > 100000000.0 {
        return S_OK
    }
    refresh_origin()
    let el: uia.El = uia.el_from_point(pv(), (x as i64) - (*pv()).ox, (y as i64) - (*pv()).oy)
    put_word(out, 0, give(el, S_FRAGMENT))
    return S_OK
}

// The fallback when no executable stub page could be made: the point is the mouse position.
#[win_callback]
fn m_frompoint_cursor(this: u64, x: u64, y: u64, out: u64) -> u64 {
    if out == 0 {
        return E_POINTER
    }
    put_word(out, 0, 0)
    if F_CURSOR == 0 {
        return S_OK
    }
    refresh_origin()
    var pt: [i32; 2] = [0; 2]
    if wgl.call1(F_CURSOR, (&pt[0]) as u64) == 0 {
        return S_OK
    }
    let el: uia.El = uia.el_from_point(pv(), (pt[0] as i64) - (*pv()).ox, (pt[1] as i64) - (*pv()).oy)
    put_word(out, 0, give(el, S_FRAGMENT))
    return S_OK
}

#[win_callback]
fn m_getfocus(this: u64, out: u64, c: u64, d: u64) -> u64 {
    if out == 0 {
        return E_POINTER
    }
    put_word(out, 0, 0)
    let n: usize = scene.scene_count((*pv()).sc)
    var i: usize = 0
    while i < n {
        let el: uia.El = uia.el_from_node(pv(), i)
        if uia.el_has_focus(pv(), el) {
            put_word(out, 0, give(el, S_FRAGMENT))
            return S_OK
        }
        i = i + 1
    }
    return S_OK
}

// ------------------------------------------------------------------ patterns

#[win_callback]
fn m_invoke(this: u64, b: u64, c: u64, d: u64) -> u64 {
    let r: u64 = do_click(this)
    if r == S_OK {
        let e: usize = entry_of(this)
        if e != NONE && G_PEND != 0 && G_PEND_N < 8 {
            put_word(G_PEND, G_PEND_N, meta(e, 2))
            G_PEND_N = G_PEND_N + 1
        }
    }
    return r
}

#[win_callback]
fn m_toggle(this: u64, b: u64, c: u64, d: u64) -> u64 {
    return do_click(this)
}

#[win_callback]
fn m_togglestate(this: u64, out: u64, c: u64, d: u64) -> u64 {
    let e: usize = entry_of(this)
    if e == NONE || out == 0 {
        return UIA_E_ELEMENTNOTAVAILABLE
    }
    out_i32(out, uia.el_toggle_state(pv(), el_of(e)) as i32)
    return S_OK
}

#[win_callback]
fn m_value(this: u64, out: u64, c: u64, d: u64) -> u64 {
    let e: usize = entry_of(this)
    if e == NONE || out == 0 {
        return UIA_E_ELEMENTNOTAVAILABLE
    }
    var nb: [u8; 1024] = [0 as u8; 1024]
    let n: usize = uia.el_name(pv(), el_of(e), (&nb[0]) as u64, 1024)
    put_word(out, 0, bstr_of((&nb[0]) as u64, n))
    return S_OK
}

fn bool_out(out: u64, b: bool) -> u64 {
    if out == 0 {
        return E_POINTER
    }
    if b {
        rt.st32(out, 0, 1 as u32)
    } else {
        rt.st32(out, 0, 0 as u32)
    }
    return S_OK
}

#[win_callback]
fn m_readonly(this: u64, out: u64, c: u64, d: u64) -> u64 {
    let e: usize = entry_of(this)
    if e == NONE {
        return UIA_E_ELEMENTNOTAVAILABLE
    }
    return bool_out(out, true)
}

#[win_callback]
fn m_rreadonly(this: u64, out: u64, c: u64, d: u64) -> u64 {
    let e: usize = entry_of(this)
    if e == NONE {
        return UIA_E_ELEMENTNOTAVAILABLE
    }
    return bool_out(out, !uia.el_enabled(pv(), el_of(e)))
}

// (this, double value): reached through the xmm stub, the value arrives as double BITS (C2).
#[win_callback]
fn m_rsetvalue(this: u64, bits: u64, c: u64, d: u64) -> u64 {
    let e: usize = entry_of(this)
    if e == NONE {
        return UIA_E_ELEMENTNOTAVAILABLE
    }
    let el: uia.El = el_of(e)
    if el.kind != 1 as u32 {
        return UIA_E_NOTSUPPORTED
    }
    if !uia.el_enabled(pv(), el) {
        return UIA_E_ELEMENTNOTENABLED
    }
    let v: f64 = f64_of(bits)
    let lo: f64 = uia.el_range_min() as f64
    let hi: f64 = uia.el_range_max() as f64
    if !(v >= lo && v <= hi) {
        return E_INVALIDARG
    }
    if !set_range_node(el.node, (v + 0.5) as i64) {
        return UIA_E_ELEMENTNOTAVAILABLE
    }
    return S_OK
}

#[win_callback]
fn m_rvalue(this: u64, out: u64, c: u64, d: u64) -> u64 {
    let e: usize = entry_of(this)
    if e == NONE || out == 0 {
        return UIA_E_ELEMENTNOTAVAILABLE
    }
    out_f64(out, uia.el_range_value(pv(), el_of(e)) as f64)
    return S_OK
}

#[win_callback]
fn m_rmax(this: u64, out: u64, c: u64, d: u64) -> u64 {
    if out == 0 {
        return E_POINTER
    }
    out_f64(out, uia.el_range_max() as f64)
    return S_OK
}

#[win_callback]
fn m_rmin(this: u64, out: u64, c: u64, d: u64) -> u64 {
    if out == 0 {
        return E_POINTER
    }
    out_f64(out, uia.el_range_min() as f64)
    return S_OK
}

#[win_callback]
fn m_rlarge(this: u64, out: u64, c: u64, d: u64) -> u64 {
    if out == 0 {
        return E_POINTER
    }
    out_f64(out, ((uia.el_range_max() - uia.el_range_min()) as f64) / 10.0)
    return S_OK
}

#[win_callback]
fn m_rsmall(this: u64, out: u64, c: u64, d: u64) -> u64 {
    if out == 0 {
        return E_POINTER
    }
    out_f64(out, ((uia.el_range_max() - uia.el_range_min()) as f64) / 100.0)
    return S_OK
}

#[win_callback]
fn m_expand(this: u64, b: u64, c: u64, d: u64) -> u64 {
    let e: usize = entry_of(this)
    if e == NONE {
        return UIA_E_ELEMENTNOTAVAILABLE
    }
    if uia.el_expand_state(pv(), el_of(e)) == uia.EXP_EXPANDED_S {
        return S_OK
    }
    return do_click(this)
}

#[win_callback]
fn m_collapse(this: u64, b: u64, c: u64, d: u64) -> u64 {
    let e: usize = entry_of(this)
    if e == NONE {
        return UIA_E_ELEMENTNOTAVAILABLE
    }
    if uia.el_expand_state(pv(), el_of(e)) != uia.EXP_EXPANDED_S {
        return S_OK
    }
    return do_click(this)
}

#[win_callback]
fn m_expstate(this: u64, out: u64, c: u64, d: u64) -> u64 {
    let e: usize = entry_of(this)
    if e == NONE || out == 0 {
        return UIA_E_ELEMENTNOTAVAILABLE
    }
    out_i32(out, uia.el_expand_state(pv(), el_of(e)) as i32)
    return S_OK
}

#[win_callback]
fn m_select(this: u64, b: u64, c: u64, d: u64) -> u64 {
    return do_click(this)
}

#[win_callback]
fn m_addsel(this: u64, b: u64, c: u64, d: u64) -> u64 {
    let e: usize = entry_of(this)
    if e == NONE {
        return UIA_E_ELEMENTNOTAVAILABLE
    }
    if uia.el_is_selected(pv(), el_of(e)) {
        return S_OK
    }
    return do_click(this)
}

#[win_callback]
fn m_remsel(this: u64, b: u64, c: u64, d: u64) -> u64 {
    let e: usize = entry_of(this)
    if e == NONE {
        return UIA_E_ELEMENTNOTAVAILABLE
    }
    if !uia.el_is_selected(pv(), el_of(e)) {
        return S_OK
    }
    return do_click(this)
}

#[win_callback]
fn m_issel(this: u64, out: u64, c: u64, d: u64) -> u64 {
    let e: usize = entry_of(this)
    if e == NONE {
        return UIA_E_ELEMENTNOTAVAILABLE
    }
    return bool_out(out, uia.el_is_selected(pv(), el_of(e)))
}

#[win_callback]
fn m_selcont(this: u64, out: u64, c: u64, d: u64) -> u64 {
    if out == 0 {
        return E_POINTER
    }
    put_word(out, 0, 0)
    let e: usize = entry_of(this)
    if e == NONE {
        return UIA_E_ELEMENTNOTAVAILABLE
    }
    put_word(out, 0, give(uia.el_parent(pv(), el_of(e)), S_SIMPLE))
    return S_OK
}

// ------------------------------------------------------------------ xmm stubs (C2)

fn st_b(p: u64, i: usize, v: u32) {
    rt.st8(p, i, v as u8)
}

// One stub at p+off, returns the offset after it.
//   rev = false: Win64 caller put doubles in xmm1 / xmm2, the callback wants their BITS in rdx / r8:
//                  movq rdx, xmm1 (mask bit 0) ; movq r8, xmm2 (mask bit 1) ; mov rax, target ; jmp rax
//   rev = true (a test caller): the other way round, and the integer slots are zeroed so that only the xmm
//                registers carry the values:  movq xmm1, rdx ; xor edx, edx ; movq xmm2, r8 ; xor r8d, r8d ; ...
fn stub_write(p: u64, off: usize, target: u64, mask: usize, rev: bool) -> usize {
    var o: usize = off
    if (mask & 1) != 0 {
        st_b(p, o, 0x66)
        st_b(p, o + 1, 0x48)
        st_b(p, o + 2, 0x0F)
        if rev {
            st_b(p, o + 3, 0x6E)
        } else {
            st_b(p, o + 3, 0x7E)
        }
        st_b(p, o + 4, 0xCA)
        o = o + 5
        if rev {
            st_b(p, o, 0x31)
            st_b(p, o + 1, 0xD2)
            o = o + 2
        }
    }
    if (mask & 2) != 0 {
        st_b(p, o, 0x66)
        st_b(p, o + 1, 0x49)
        st_b(p, o + 2, 0x0F)
        if rev {
            st_b(p, o + 3, 0x6E)
        } else {
            st_b(p, o + 3, 0x7E)
        }
        st_b(p, o + 4, 0xD0)
        o = o + 5
        if rev {
            st_b(p, o, 0x45)
            st_b(p, o + 1, 0x31)
            st_b(p, o + 2, 0xC0)
            o = o + 3
        }
    }
    // mov rax, imm64 ; jmp rax
    st_b(p, o, 0x48)
    st_b(p, o + 1, 0xB8)
    var k: usize = 0
    while k < 8 {
        st_b(p, o + 2 + k, ((target >> ((k * 8) as u64)) & 255) as u32)
        k = k + 1
    }
    st_b(p, o + 10, 0xFF)
    st_b(p, o + 11, 0xE0)
    return o + 12
}

// a page to write stubs into (read/write; `exec_seal` makes it executable). 0 = not possible.
fn exec_alloc() -> u64 {
    if F_VALLOC == 0 || F_VPROT == 0 {
        return 0
    }
    // MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE
    return wgl.call4(F_VALLOC, 0, 4096, 12288, 4)
}

fn exec_seal(p: u64) -> bool {
    var old: [u32; 2] = [0 as u32; 2]
    // PAGE_EXECUTE_READ
    let r: u64 = wgl.call4(F_VPROT, p, 4096, 32, (&old[0]) as u64)
    if (r & 4294967295) == 0 {
        return false
    }
    if F_FLUSH != 0 {
        // the current process is the pseudo handle -1
        let f: u64 = wgl.call3(F_FLUSH, 18446744073709551615, p, 4096)
    }
    return true
}

fn make_stubs() {
    G_STUB_SET = 0
    G_STUB_PT = 0
    let p: u64 = exec_alloc()
    if p == 0 {
        return
    }
    let n1: usize = stub_write(p, 0, code_of4(m_rsetvalue), 1, false)
    let n2: usize = stub_write(p, 32, code_of4(m_frompoint), 3, false)
    if !exec_seal(p) {
        return
    }
    G_TRAMP = p
    G_STUB_SET = p
    G_STUB_PT = p + 32
}

// Test aid: a Win64 function that takes its first two floating arguments from the INTEGER slots rdx / r8 (put into
// xmm1 / xmm2, the integer slots zeroed) and then jumps to `target` -- how a client with doubles would call.
// `mask` bit 0 = xmm1, bit 1 = xmm2. 0 = no executable page.
fn double_caller(target: u64, mask: usize) -> u64 {
    let p: u64 = exec_alloc()
    if p == 0 {
        return 0
    }
    let n: usize = stub_write(p, 0, target, mask, true)
    if !exec_seal(p) {
        return 0
    }
    return p
}

// ------------------------------------------------------------------ events by polling (C3)

fn force_listening(on: bool) { G_FORCE = on }

fn listening() -> bool {
    if G_FORCE {
        return true
    }
    if F_LISTEN == 0 {
        return false
    }
    return (wgl.call0(F_LISTEN) & 4294967295) != 0
}

fn event_count() -> u64 { return G_EV_N }

// field 0 = kind (1 event, 2 property, 3 structure), 1 = event / property id, 2 = node. 0 = out of the log window.
fn event_at(seq: u64, field: usize) -> u64 {
    if G_ELOG == 0 || seq >= G_EV_N || seq + (NLOG as u64) < G_EV_N || field > 2 {
        return 0
    }
    return word(G_ELOG, ((seq % (NLOG as u64)) as usize) * 3 + field)
}

fn log_event(kind: u64, id: u64, node: usize) {
    let k: usize = (G_EV_N % (NLOG as u64)) as usize
    put_word(G_ELOG, k * 3, kind)
    put_word(G_ELOG, k * 3 + 1, id)
    put_word(G_ELOG, k * 3 + 2, node as u64)
    G_EV_N = G_EV_N + 1
}

fn free_bstr(b: u64) {
    if b != 0 && F_SYSFREE != 0 {
        let r: u64 = wgl.call1(F_SYSFREE, b)
    }
}

// UiaRaiseAutomationEvent for an element
fn raise_event(el: uia.El, id: u32) {
    log_event(1, id as u64, el.node)
    if F_RAISE == 0 {
        return
    }
    let p: u64 = give(el, S_SIMPLE)
    if p == 0 {
        return
    }
    let r: u64 = wgl.call2(F_RAISE, p, id as u64)
    let q: u64 = m_release(p, 0, 0, 0)
}

const PK_I4: u32 = 0
const PK_BOOL: u32 = 1
const PK_BSTR: u32 = 2
const PK_R8: u32 = 3

// UiaRaiseAutomationPropertyChangedEvent: old value empty, new value of the kind (`iv` is the number; PK_BSTR: the
// element's name, PK_R8: iv as a double)
fn raise_prop(el: uia.El, prop: u32, kind: u32, iv: i64) {
    log_event(2, prop as u64, el.node)
    if F_RAISEPROP == 0 {
        return
    }
    let p: u64 = give(el, S_SIMPLE)
    if p == 0 {
        return
    }
    var ov: [u64; 3] = [0; 3]
    var nv: [u64; 3] = [0; 3]
    let ovp: u64 = (&ov[0]) as u64
    let nvp: u64 = (&nv[0]) as u64
    var bs: u64 = 0
    if kind == PK_I4 {
        var_i32(nvp, iv as i32)
    } else if kind == PK_BOOL {
        var_bool(nvp, iv != 0)
    } else if kind == PK_R8 {
        rt.st16(nvp, 0, 5 as u16)
        *((nvp + 8) as *mut f64) = iv as f64
    } else {
        let n: usize = uia.el_name(pv(), el, G_NB, 1024)
        bs = bstr_of(G_NB, n)
        var_bstr(nvp, bs)
    }
    // VARIANTs are passed by value = by pointer to a copy on Win64
    let r: u64 = wgl.call4(F_RAISEPROP, p, prop as u64, ovp, nvp)
    free_bstr(bs)
    let q: u64 = m_release(p, 0, 0, 0)
}

// UiaRaiseStructureChangedEvent(ChildrenInvalidated)
fn raise_structure(el: uia.El) {
    log_event(3, 2, el.node)
    if F_RAISESTRUCT == 0 {
        return
    }
    let p: u64 = give(el, S_SIMPLE)
    if p == 0 {
        return
    }
    let r: u64 = wgl.call4(F_RAISESTRUCT, p, 2, 0, 0)
    let q: u64 = m_release(p, 0, 0, 0)
}

fn name_hash(el: uia.El) -> u64 {
    let n: usize = uia.el_name(pv(), el, G_NB, 1024)
    var h: u64 = 2166136261
    var i: usize = 0
    while i < n {
        h = ((h ^ (rt.ld8(G_NB, i) as u64)) * 16777619) & 4294967295
        i = i + 1
    }
    return h
}

// bit 0 enabled, 1-2 toggle state, 3-4 expand state, 5 selected, 6 has focus
fn state_word(el: uia.El) -> u64 {
    var s: u64 = 0
    if uia.el_enabled(pv(), el) {
        s = s | 1
    }
    s = s | ((uia.el_toggle_state(pv(), el) as u64) << 1)
    s = s | ((uia.el_expand_state(pv(), el) as u64) << 3)
    if uia.el_is_selected(pv(), el) {
        s = s | 32
    }
    if uia.el_has_focus(pv(), el) {
        s = s | 64
    }
    return s
}

// One tick of the poll: compares the scene with the snapshot of the last tick and raises what changed. Returns the
// number of events raised. Nothing is raised while no UIA client listens (the snapshot is dropped, so the next
// listener starts from a fresh baseline).
fn poll() -> usize {
    if !G_READY || G_SNAP == 0 {
        return 0
    }
    if !listening() {
        G_SNAP_OK = false
        G_PEND_N = 0
        return 0
    }
    let before: u64 = G_EV_N
    // the Invoke events the provider queued (never raised from inside the provider call)
    var q: usize = 0
    while q < G_PEND_N {
        let el: uia.El = uia.el_from_node(pv(), word(G_PEND, q) as usize)
        if !uia.el_is_none(el) {
            raise_event(el, 20009)
        }
        q = q + 1
    }
    G_PEND_N = 0
    let total: usize = scene.scene_count((*pv()).sc)
    var n: usize = total
    if n > NSNAP {
        n = NSNAP
    }
    let have: bool = G_SNAP_OK
    var focus_now: usize = 4294967295
    var i: usize = 0
    while i < n {
        let el: uia.El = uia.el_from_node(pv(), i)
        var st: u64 = 0
        var nh: u64 = 0
        var rv: u64 = 0
        var kids: u64 = 0
        if !uia.el_is_none(el) {
            st = state_word(el)
            nh = name_hash(el)
            if uia.el_has_pattern(pv(), el, uia.PAT_RANGE) {
                rv = uia.el_range_value(pv(), el) as u64
            }
            kids = uia.el_child_count(pv(), el) as u64
            if (st & 64) != 0 && focus_now == 4294967295 {
                focus_now = i
            }
            if have && i < G_SNAP_N && (G_EV_N - before) < (NLOG as u64) {
                let b: usize = i * SW
                let os: u64 = word(G_SNAP, b)
                let d: u64 = os ^ st
                if d != 0 {
                    if (d & 1) != 0 {
                        raise_prop(el, 30010, PK_BOOL, (st & 1) as i64)
                    }
                    if (d & 6) != 0 && uia.el_has_pattern(pv(), el, uia.PAT_TOGGLE) {
                        raise_prop(el, 30086, PK_I4, ((st >> 1) & 3) as i64)
                    }
                    if (d & 24) != 0 && uia.el_has_pattern(pv(), el, uia.PAT_EXPAND) {
                        raise_prop(el, 30070, PK_I4, ((st >> 3) & 3) as i64)
                    }
                    if (d & 32) != 0 && uia.el_has_pattern(pv(), el, uia.PAT_SELITEM) {
                        raise_prop(el, 30079, PK_BOOL, ((st >> 5) & 1) as i64)
                    }
                    if (d & 64) != 0 {
                        raise_prop(el, 30008, PK_BOOL, ((st >> 6) & 1) as i64)
                    }
                }
                if word(G_SNAP, b + 1) != nh {
                    raise_prop(el, 30005, PK_BSTR, 0)
                    if uia.el_has_pattern(pv(), el, uia.PAT_VALUE) {
                        raise_prop(el, 30045, PK_BSTR, 0)
                    }
                }
                if word(G_SNAP, b + 2) != rv && uia.el_has_pattern(pv(), el, uia.PAT_RANGE) {
                    raise_prop(el, 30047, PK_R8, rv as i64)
                }
                if word(G_SNAP, b + 3) != kids {
                    raise_structure(el)
                }
            }
        }
        put_word(G_SNAP, i * SW, st)
        put_word(G_SNAP, i * SW + 1, nh)
        put_word(G_SNAP, i * SW + 2, rv)
        put_word(G_SNAP, i * SW + 3, kids)
        i = i + 1
    }
    if have {
        if n != G_SNAP_N {
            raise_structure(uia.el_root(pv()))
        }
        if focus_now != 4294967295 && focus_now != G_SNAP_FOCUS {
            raise_event(uia.el_from_node(pv(), focus_now), 20005)
        }
    }
    G_SNAP_N = n
    G_SNAP_FOCUS = focus_now
    G_SNAP_OK = true
    return (G_EV_N - before) as usize
}

// ------------------------------------------------------------------ vtables

struct Holder4 {
    f: fn(u64, u64, u64, u64) -> u64,
}

fn code_of4(f: fn(u64, u64, u64, u64) -> u64) -> u64 {
    var roh: [u64; 1] = [0; 1]
    let h: *mut Holder4 = (&roh[0]) as *mut Holder4
    (*h).f = f
    return *((roh[0]) as *mut u64)
}

fn vt_set(k: usize, i: usize, f: fn(u64, u64, u64, u64) -> u64) {
    put_word(G_VT, k * 16 + i, code_of4(f))
}

fn vt_unknown(k: usize) {
    vt_set(k, 0, m_qi)
    vt_set(k, 1, m_addref)
    vt_set(k, 2, m_release)
}

fn guid_set(k: usize, w0: u64, w1: u64) {
    put_word(G_GUID, k * 2, w0)
    put_word(G_GUID, k * 2 + 1, w1)
}

fn build_tables() {
    // IUnknown, Simple, Fragment, FragmentRoot, Invoke, Toggle, Value, RangeValue, ExpandCollapse, SelectionItem
    guid_set(0, 0x0, 0x46000000000000c0)
    guid_set(1, 0x433286fdd6dd68d1, 0x4cd2a2debe9a6686)
    guid_set(2, 0x439c8359f7063da8, 0x877d9a29c5bb9792)
    guid_set(3, 0x40a9ab8f620ce2a5, 0x589b59753cdecb86)
    guid_set(4, 0x47a2e18e54fcb24b, 0xa29975e7cbecd3b4)
    guid_set(5, 0x433cc4f456d00bd0, 0x92087ea5521a36a8)
    guid_set(6, 0x42016fb3c7935180, 0x4af6db3af77d74b1)
    guid_set(7, 0x469133e636dc7aef, 0x333d4b27e72be1af)
    guid_set(8, 0x4a98cab0d847d3a5, 0x24ad595cb4ec328c)
    guid_set(9, 0x452db2d42acad808, 0xb267d11aff9107a4)
    var k: usize = 0
    while k < NSLOT {
        vt_unknown(k)
        k = k + 1
    }
    // Simple: ProviderOptions, GetPatternProvider, GetPropertyValue, HostRawElementProvider
    vt_set(S_SIMPLE, 3, m_options)
    vt_set(S_SIMPLE, 4, m_getpattern)
    vt_set(S_SIMPLE, 5, m_getprop)
    vt_set(S_SIMPLE, 6, m_host)
    // Fragment: Navigate, GetRuntimeId, BoundingRectangle, GetEmbeddedFragmentRoots, SetFocus, FragmentRoot
    vt_set(S_FRAGMENT, 3, m_navigate)
    vt_set(S_FRAGMENT, 4, m_runtimeid)
    vt_set(S_FRAGMENT, 5, m_bounds)
    vt_set(S_FRAGMENT, 6, m_embedded)
    vt_set(S_FRAGMENT, 7, m_setfocus)
    vt_set(S_FRAGMENT, 8, m_fragroot)
    // FragmentRoot: ElementProviderFromPoint, GetFocus
    vt_set(S_ROOT, 3, m_frompoint)
    vt_set(S_ROOT, 4, m_getfocus)
    // Invoke: Invoke
    vt_set(S_INVOKE, 3, m_invoke)
    // Toggle: Toggle, ToggleState
    vt_set(S_TOGGLE, 3, m_toggle)
    vt_set(S_TOGGLE, 4, m_togglestate)
    // Value: SetValue, Value, IsReadOnly
    vt_set(S_VALUE, 3, m_notsup)
    vt_set(S_VALUE, 4, m_value)
    vt_set(S_VALUE, 5, m_readonly)
    // RangeValue: SetValue, Value, IsReadOnly, Maximum, Minimum, LargeChange, SmallChange
    vt_set(S_RANGE, 3, m_notsup)
    vt_set(S_RANGE, 4, m_rvalue)
    vt_set(S_RANGE, 5, m_rreadonly)
    vt_set(S_RANGE, 6, m_rmax)
    vt_set(S_RANGE, 7, m_rmin)
    vt_set(S_RANGE, 8, m_rlarge)
    vt_set(S_RANGE, 9, m_rsmall)
    // ExpandCollapse: Expand, Collapse, ExpandCollapseState
    vt_set(S_EXPAND, 3, m_expand)
    vt_set(S_EXPAND, 4, m_collapse)
    vt_set(S_EXPAND, 5, m_expstate)
    // SelectionItem: Select, AddToSelection, RemoveFromSelection, IsSelected, SelectionContainer
    vt_set(S_SELITEM, 3, m_select)
    vt_set(S_SELITEM, 4, m_addsel)
    vt_set(S_SELITEM, 5, m_remsel)
    vt_set(S_SELITEM, 6, m_issel)
    vt_set(S_SELITEM, 7, m_selcont)
    // the two methods with doubles go through the xmm stubs (C2); without an executable page: the old fallbacks
    make_stubs()
    if G_STUB_SET != 0 {
        put_word(G_VT, S_RANGE * 16 + 3, G_STUB_SET)
    }
    if G_STUB_PT != 0 {
        put_word(G_VT, S_ROOT * 16 + 3, G_STUB_PT)
    } else {
        vt_set(S_ROOT, 3, m_frompoint_cursor)
    }
    // every slot of the pool points at its vtable
    var e: usize = 0
    while e < NENT {
        var s: usize = 0
        while s < NSLOT {
            let sp: u64 = slot_ptr(e, s)
            put_word(sp, 0, G_VT + ((s * 16 * 8) as u64))
            put_word(sp, 1, e as u64)
            s = s + 1
        }
        e = e + 1
    }
}

// ------------------------------------------------------------------ the window procedure (subclass)

#[win_callback]
fn uia_wndproc(hwnd: u64, msg: u64, wp: u64, lp: u64) -> u64 {
    if msg == 275 && wp == TIMER_ID && G_READY {
        // WM_TIMER of the event poll (C3)
        let n: usize = poll()
        return 0
    }
    if msg == 61 && (lp & 4294967295) == 4294967271 && G_READY && F_RETURN != 0 {
        // WM_GETOBJECT, objid UiaRootObjectId (-25)
        refresh_origin()
        let root: uia.El = uia.el_root(pv())
        if !uia.el_is_none(root) {
            let e: usize = entry_for(root)
            if e != NONE {
                if G_ROOT == NONE {
                    G_ROOT = e
                    set_meta(e, 4, meta(e, 4) + 1) // the permanent reference
                }
                G_COUNT = G_COUNT + 1
                let r: u64 = wgl.call4(F_RETURN, hwnd, wp, lp, slot_ptr(e, S_SIMPLE))
                if r != 0 {
                    return r
                }
            }
        }
    }
    return wgl.call5(F_CALLWND, G_OLD, hwnd, msg, wp, lp)
}

// ------------------------------------------------------------------ set up

fn load_functions() -> bool {
    F_RETURN = wgl.dll_sym("uiautomationcore.dll", "UiaReturnRawElementProvider")
    F_HOST = wgl.dll_sym("uiautomationcore.dll", "UiaHostProviderFromHwnd")
    F_CALLWND = wgl.dll_sym("user32.dll", "CallWindowProcW")
    F_SETLONG = wgl.dll_sym("user32.dll", "SetWindowLongPtrW")
    F_CLIENT2SCREEN = wgl.dll_sym("user32.dll", "ClientToScreen")
    F_CURSOR = wgl.dll_sym("user32.dll", "GetCursorPos")
    F_MB2WC = wgl.dll_sym("kernel32.dll", "MultiByteToWideChar")
    F_BSTR = wgl.dll_sym("oleaut32.dll", "SysAllocStringLen")
    F_SACREATE = wgl.dll_sym("oleaut32.dll", "SafeArrayCreateVector")
    F_SAPUT = wgl.dll_sym("oleaut32.dll", "SafeArrayPutElement")
    F_SYSFREE = wgl.dll_sym("oleaut32.dll", "SysFreeString")
    F_VALLOC = wgl.dll_sym("kernel32.dll", "VirtualAlloc")
    F_VPROT = wgl.dll_sym("kernel32.dll", "VirtualProtect")
    F_FLUSH = wgl.dll_sym("kernel32.dll", "FlushInstructionCache")
    F_LISTEN = wgl.dll_sym("uiautomationcore.dll", "UiaClientsAreListening")
    F_RAISE = wgl.dll_sym("uiautomationcore.dll", "UiaRaiseAutomationEvent")
    F_RAISEPROP = wgl.dll_sym("uiautomationcore.dll", "UiaRaiseAutomationPropertyChangedEvent")
    F_RAISESTRUCT = wgl.dll_sym("uiautomationcore.dll", "UiaRaiseStructureChangedEvent")
    F_SETTIMER = wgl.dll_sym("user32.dll", "SetTimer")
    return F_RETURN != 0 && F_CALLWND != 0 && F_SETLONG != 0 && F_BSTR != 0 && F_SACREATE != 0 && F_SAPUT != 0
    && F_MB2WC != 0
}

// The state without a window: tables, pool, provider. `test_attach` and `attach` both start here.
#[allow_escape]
fn setup(a: *mut app.App, title: str) -> bool {
    if G_READY {
        return true
    }
    if !load_functions() {
        return false
    }
    G_POOL = rt.heap_alloc(NENT * NSLOT * 16)
    G_META = rt.heap_alloc(NENT * MW * 8)
    G_VT = rt.heap_alloc(NSLOT * 16 * 8)
    G_GUID = rt.heap_alloc(10 * 16)
    G_PV = rt.heap_alloc(4096)
    G_SNAP = rt.heap_alloc(NSNAP * SW * 8)
    G_ELOG = rt.heap_alloc(NLOG * 3 * 8)
    G_PEND = rt.heap_alloc(8 * 8)
    G_NB = rt.heap_alloc(1024)
    if G_POOL == 0 || G_META == 0 || G_VT == 0 || G_GUID == 0 || G_PV == 0 || G_SNAP == 0 || G_ELOG == 0
    || G_PEND == 0 || G_NB == 0 {
        return false
    }
    *(G_PV as *mut uia.Provider) = uia.provider_new(app.app_scene(a), app.ax(a), title)
    G_APP = a as u64
    build_tables()
    G_READY = true
    return true
}

// The root's Simple interface (AddRef'd): what a test hands to `win64_call`. 0 = not set up / no tree.
fn root_interface() -> u64 {
    if !G_READY {
        return 0
    }
    let root: uia.El = uia.el_root(pv())
    if uia.el_is_none(root) {
        return 0
    }
    let e: usize = entry_for(root)
    if e == NONE {
        return 0
    }
    if G_ROOT == NONE {
        G_ROOT = e
        set_meta(e, 4, meta(e, 4) + 1)
    }
    set_meta(e, 4, meta(e, 4) + 1)
    return slot_ptr(e, S_SIMPLE)
}

// Set up WITHOUT a window (the check in tools/fui/uiacom_main.fi walks the objects through their vtables).
#[allow_escape]
fn test_attach(a: *mut app.App, title: str) -> bool {
    return setup(a, title)
}

fn is_attached() -> bool { return G_READY && G_OLD != 0 }

// How many WM_GETOBJECT(UiaRootObjectId) the subclass has answered (a test sends one).
fn getobject_count() -> u64 { return G_COUNT }

// Hook the native window `hwnd` (the window thread must call this). false = no UIA on this machine, or the thread
// is an MTA.
#[allow_escape]
fn attach(a: *mut app.App, hwnd: u64, title: str) -> bool {
    if hwnd == 0 {
        return false
    }
    if G_OLD != 0 {
        return true
    }
    if !setup(a, title) {
        return false
    }
    // an STA for the window thread: UseComThreading marshals every UIA call here (S_OK / S_FALSE = fine)
    let co: u64 = wgl.dll_sym("ole32.dll", "CoInitializeEx")
    if co != 0 {
        let hr: u64 = wgl.call2(co, 0, 2) & 4294967295
        if hr != 0 && hr != 1 {
            return false
        }
    }
    G_HWND = hwnd
    // GWLP_WNDPROC = -4
    let old: u64 = wgl.call3(F_SETLONG, hwnd, 18446744073709551612, code_of4(uia_wndproc))
    if old == 0 {
        G_HWND = 0
        return false
    }
    G_OLD = old
    // the event poll (C3): WM_TIMER, handled by the subclass
    if F_SETTIMER != 0 {
        let t: u64 = wgl.call4(F_SETTIMER, hwnd, TIMER_ID, 100, 0)
    }
    return true
}

// `app.set_window_hooks(a, a as u64, uiacom.opened, hotkey)`: the native window is open.
fn opened(ud: u64, win: u64) {
    let a: *mut app.App = ud as *mut app.App
    let f: *mut window.Window = win as *mut window.Window
    let ok: bool = attach(a, window.ime_handle(f), (*pv()).title)
}

fn no_hotkey(ud: u64, id: u32) {}

// With FUI_UIA unset UIA is ON (a screen reader only costs a thing when it asks); FUI_UIA=0 turns it off.
// Call before `app.run`.
#[allow_escape]
fn enable_from_env(a: *mut app.App, title: str) -> bool {
    let v: str = env.get("FUI_UIA")
    if v == "0" {
        return false
    }
    if !setup(a, title) {
        return false
    }
    app.set_window_hooks(a, a as u64, opened, no_hotkey)
    return true
}
