// SPDX-License-Identifier: MPL-2.0
// lib/fui/syntaxcolor.fi -- THE COLOURS OF SYNTAX HIGHLIGHTING for a code ground.
//
// lib/highlight says WHAT a stretch of code is (a keyword, a string, a comment,
// ...: `TK_*`); this file says what it looks like. One hue per kind (the soft
// Tokyo Night palette the avatar colours of lib/fui/kitcolor.fi already use), and
// every hue is pulled towards black or white until it has 4.5:1 against the
// ground it is drawn on (kitcolor.tone: WCAG 2.1 AA for normal text) -- so the
// same call is right on the light page's code block and on the dark one's, and
// the comment colour is not allowed to be the unreadable grey that many themes
// choose.
//
//     let col: u32 = syntaxcolor.syntax_color(theme, highlight.TK_KEYWORD, ground)
//
// `ground` is the 0xRRGGBB of the code block's background; the result is 0xRRGGBB.
// `syntax_plain` is the text colour of the theme (TK_PLAIN, TK_PUNCT, TK_OPERATOR
// and unknown kinds: code that is not a keyword or a string reads as text).
import fui.theme
import fui.kitcolor
import highlight.highlight

export { syntax_color, syntax_hue, syntax_contrast_ok }

// The hue of a kind before it is adjusted to a ground (0xRRGGBB); 0 for kinds
// that take the text colour.
fn syntax_hue(kind: u32) -> u32 {
    if kind == highlight.TK_KEYWORD { return 0xBB9AF7 as u32 } // violet
    if kind == highlight.TK_STRING { return 0x9ECE6A as u32 } // green
    if kind == highlight.TK_NUMBER { return 0xFF9E64 as u32 } // orange
    if kind == highlight.TK_COMMENT { return 0x7F8AB3 as u32 } // slate
    if kind == highlight.TK_FUNCTION { return 0x7AA2F7 as u32 } // blue
    if kind == highlight.TK_TYPE { return 0x2AC3DE as u32 } // cyan
    if kind == highlight.TK_KEY { return 0x73DACA as u32 } // teal
    if kind == highlight.TK_ATTR { return 0xE0AF68 as u32 } // amber
    if kind == highlight.TK_CONSTANT { return 0xFF9E64 as u32 } // orange
    if kind == highlight.TK_VARIABLE { return 0xF7768E as u32 } // rose
    if kind == highlight.TK_HEADING { return 0x7AA2F7 as u32 } // blue
    if kind == highlight.TK_EMPH { return 0xE0AF68 as u32 } // amber
    if kind == highlight.TK_LINK { return 0x7DCFFF as u32 } // sky
    return 0 as u32
}

// The colour (0xRRGGBB) of `kind` on `ground` (0xRRGGBB), >= 4.5:1.
fn syntax_color(m: *mut theme.Theme, kind: u32, ground: u32) -> u32 {
    let f: *mut theme.Colors = theme.theme_colors(m)
    let h: u32 = syntax_hue(kind)
    if h == 0 as u32 {
        return kitcolor.tone(m, (*f).text, ground, kitcolor.MIN_TEXT_CONTRAST)
    }
    return kitcolor.tone(m, h, ground, kitcolor.MIN_TEXT_CONTRAST)
}

// Does every kind read on this ground? (the tests ask for both themes)
fn syntax_contrast_ok(m: *mut theme.Theme, ground: u32) -> bool {
    var k: u32 = 0
    while k < highlight.TK_COUNT {
        let c: u32 = syntax_color(m, k, ground)
        if theme.contrast(c & 16777215 as u32, ground & 16777215 as u32) < kitcolor.MIN_TEXT_CONTRAST {
            return false
        }
        k = k + 1
    }
    return true
}
