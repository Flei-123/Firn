// SPDX-License-Identifier: MPL-2.0
// lib/fui/anim.fi -- TIME IN THE PICTURE. Tweens, easings, state transitions.
//
// ========================================================= WHY IT EXISTS
//
// A surface that JUMPS between two states looks old.
// What makes modern surfaces look young is not a higher colour
// depth, but that a button takes on its colour on hover OVER
// A TIME -- exactly what CSS calls `transition`. In fUi
// there was no place for that so far, so every widget would have
// got its own clock. That is the kind of repetition that this tree does not
// tolerate: here the clock stands ONCE.
//
// ======================================================= WHAT STANDS HERE
//
//   Animation   a tween: from -> to, over a duration, with easing
//   Animator    a registry of running tweens; `anim_tick` advances all
//               of them and REPORTS whether something has changed -- on that
//               hangs the demand-driven redrawing. Whoever always redraws
//               burns power; whoever never redraws freezes.
//   Easings     linear, ease-in/out/in-out as cubic-bezier with freely
//               selectable control points (Newton for t from x, exactly
//               as the CSS curve demands), steps(n), and a
//               real spring (mass/stiffness/damping, solved ANALYTICALLY
//               -- an Euler step drifts and with
//               a long run time never comes cleanly to rest).
//   Transition  the state change of a widget (normal/hover/pressed/
//               focus) as an interpolated style: colour, radius, border,
//               alpha, offset.
//
// ============================================== THE COLOURS, AND THE GREY SPOT
//
// Colour interpolation is the place where it looks wrong without you
// being able to say why. Two traps:
//
//   1. ALPHA. Whoever mixes RGB and A separately linearly runs from a
//      transparent black to an opaque red through a
//      dark grey. Right is to mix PREMULTIPLIED and divide back
//      afterwards.
//   2. THE COLOUR SPACE. sRGB mixing from blue to yellow goes through a
//      dead grey. In OKLab the path stays colourful. That is why both exist:
//      `mix_srgb` (cheap, exactly as CSS does it by default) and
//      `mix_oklab` (prettier, for gradients).
//
// NO SECOND PLACE: the root comes from lib/svg/matrix.fi (`m_sqrt`),
// e^x and the cosines from `std.math`. No arithmetic of its own stands here.
//
// WHICH OF THE TWO PLACES APPLIES FOR floor/ceil/abs. `std.math` and
// lib/svg/matrix.fi can both round down, and that is exactly the
// trap: two modules in lib/fui/ calculated with two different
// roundings the same raster edge, and the edge lay one
// pixel off. That is why in ALL of lib/fui/ exclusively
// `matrix.m_floor`, `matrix.m_ceil`, `matrix.m_abs` apply -- also here, where
// `std.math` is already imported for exp/cos/sin/powf.
// `math.floor`, `math.ceil` and `math.abs` are forbidden in lib/fui/;
// section 19 of tools/fui/run.sh re-calculates that and aborts
// the run as soon as one of these names appears here again.
//
// ============================================ WHERE THE TARGET VALUES COME FROM
//
// A transition needs TARGET VALUES, and those already stand in the tree: the
// colour of a state in `render.def_bg_state` via `style.resolve_bg`
// and `theme.color_from_style`, the radius in `render.def_radius`, the
// border width in `render.def_border_width`, the opacity in
// `style.resolve_alpha`. That is why `trans_from_widget` asks exactly there
// and does NOT copy the cascade a second time -- otherwise
// a button in motion would run towards a different colour from the one
// it would have at rest, and nobody would find the difference.
//
// What is newly decided HERE is solely the MOTION RULE (which
// state rises, sinks or becomes rounder by how much) -- that stands in
// `state_dy`/`state_radius_delta`/`state_border_delta` and nowhere else.
import std.math
import svg.matrix
import fui.style
import fui.theme
import fui.widget
import fui.render
import fui.damage

export {
    // --- Easings
    EASE_LINEAR, EASE_IN, EASE_OUT, EASE_IN_OUT, EASE_STEPS, EASE_SPRING,
    Easing, easing_linear, easing_bezier, easing_bezier_kind,
    easing_steps, easing_spring,
    easing_named, ease_eval,
    bezier_t_for_x, spring_eval,
    // --- A tween
    Animation, anim_new, anim_set_delay, anim_set_repeat,
    anim_set_direction, anim_value, anim_done, anim_progress,
    anim_start, anim_stop, anim_active,
    DIR_NORMAL, DIR_ALTERNATE, REPEAT_FOREVER,
    // --- The registry
    Animator, animator_new, animator_add, animator_count, animator_at,
    animator_clear, anim_tick, animator_dirty, animator_busy,
    ANIM_MAX,
    // --- Farben
    mix_srgb, mix_oklab, srgb_to_oklab, oklab_to_srgb,
    // --- Zustandsuebergang
    Transition, trans_new, trans_set_duration, trans_set_easing,
    trans_to_state, trans_tick, trans_state, trans_alpha,
    trans_color, trans_radius, trans_border, trans_dx, trans_dy,
    trans_set_oklab, trans_oklab, trans_progress,
    trans_set_state_duration, trans_state_duration, trans_duration,
    // --- The transition AT THE WIDGET
    state_dy, state_dx, state_radius_delta, state_border_delta,
    widget_target_bg, widget_target_radius, widget_target_border,
    widget_target_alpha,
    trans_from_widget, trans_force_widget, trans_apply, trans_place,
    // --- The registry that the drawing path keeps
    TransReg, transreg_new, transreg_bind, transreg_unbind,
    transreg_hook, transreg_slot, transreg_find, transreg_count,
    transreg_index, transreg_clear, transreg_set_keyer, transreg_key,
    transreg_set_duration, transreg_set_easing, transreg_set_oklab,
    transreg_kind_ok, transreg_dirty, transreg_new_frame, TRANS_MAX,
    // --- W3 feel: Fluent curves, lead-in, per-state durations, channels
    easing_fluent_decel, easing_fluent_standard, easing_spring_critical,
    transreg_set_lead, transreg_set_state_duration, transreg_set_fluent,
    transreg_busy_mark, transreg_set_reduced, transreg_reduced,
    Tween, tween_new, tween_busy, tween_set_ease,
    color_to, value_to,
    chan_f, chan_color, chan_f_w, chan_color_w, CHAN_MAX,
    chan_bounds, chan_bounds_end, transreg_bounded, transreg_damage,
    fling_pos, fling_vel, fling_total, predict_ahead,
    DUR_HOVER, DUR_PRESS, DUR_FOCUS, DUR_PANEL, FRAME_LEAD_MS,
}

// ================================================================ EASINGS
const EASE_LINEAR: u32 = 0
const EASE_IN: u32 = 1
const EASE_OUT: u32 = 2
const EASE_IN_OUT: u32 = 3
const EASE_STEPS: u32 = 4
const EASE_SPRING: u32 = 5

// An easing curve as a VALUE. Four Bezier control points for the
// curve cases, `n` for steps(n), and three spring numbers. A value and
// no pointer, so that an animation has its curve WITH it and does not
// point into a table that somebody else moves on.
struct Easing {
    kind: u32,
    x1: f64,
    y1: f64,
    x2: f64,
    y2: f64,
    steps: i64,
    mass: f64,
    stiff: f64,
    damp: f64,
}

fn easing_linear() -> Easing {
    return Easing { kind: EASE_LINEAR, x1: 0.0, y1: 0.0, x2: 1.0, y2: 1.0,
        steps: 1, mass: 1.0, stiff: 100.0, damp: 10.0 }
}

// cubic-bezier(x1,y1,x2,y2) as in CSS. The two end points are fixed
// (0,0) and (1,1), exactly as there.
//
// THE KIND IS AN ARGUMENT, NOT AN ASSUMPTION. Formerly every curve built
// here carried EASE_IN_OUT, also the one that `easing_named(EASE_IN)`
// returned: whoever then read `(*e).kind` -- say a proof that labels the
// rows, or a cache that merges equal curves -- got the same
// information for three different curves. `ease_eval` falls for EVERY kind except linear,
// steps and spring into the Bezier branch, so the kind may freely
// name the curve. Whoever builds a curve of their own without a name takes
// `easing_bezier` and gets EASE_IN_OUT as before.
fn easing_bezier_kind(kind: u32, x1: f64, y1: f64, x2: f64, y2: f64) -> Easing {
    var e: Easing = easing_linear()
    e.kind = kind
    e.x1 = x1
    e.y1 = y1
    e.x2 = x2
    e.y2 = y2
    return e
}

// The nameless form: a freely chosen curve carries EASE_IN_OUT,
// because in the general case it IS neither purely accelerating nor purely
// braking.
fn easing_bezier(x1: f64, y1: f64, x2: f64, y2: f64) -> Easing {
    return easing_bezier_kind(EASE_IN_OUT, x1, y1, x2, y2)
}

fn easing_steps(n: i64) -> Easing {
    var e: Easing = easing_linear()
    e.kind = EASE_STEPS
    if n < 1 {
        e.steps = 1
    } else {
        e.steps = n
    }
    return e
}

fn easing_spring(mass: f64, stiff: f64, damp: f64) -> Easing {
    var e: Easing = easing_linear()
    e.kind = EASE_SPRING
    e.mass = mass
    e.stiff = stiff
    e.damp = damp
    return e
}

// The three named CSS curves with their real control points
// (css-easing-1, 3.1): ease-in = (0.42,0,1,1), ease-out = (0,0,0.58,1),
// ease-in-out = (0.42,0,0.58,1).
// Each of them carries ITS OWN kind, not that of the
// general Bezier curve -- `easing_named(EASE_IN).kind` is EASE_IN.
fn easing_named(kind: u32) -> Easing {
    if kind == EASE_IN {
        return easing_bezier_kind(EASE_IN, 0.42, 0.0, 1.0, 1.0)
    }
    if kind == EASE_OUT {
        return easing_bezier_kind(EASE_OUT, 0.0, 0.0, 0.58, 1.0)
    }
    if kind == EASE_IN_OUT {
        return easing_bezier_kind(EASE_IN_OUT, 0.42, 0.0, 0.58, 1.0)
    }
    return easing_linear()
}

// WinUI / Fluent curves (the numbers of ControlFastOutSlowInKeySpline and
// the "standard" curve): decelerate is the one for state changes (hover,
// press, fade in): it covers ~60 % of the way in the first 20 % of the time,
// so the eye sees the reaction in the very first frame.
fn easing_fluent_decel() -> Easing {
    return easing_bezier_kind(EASE_OUT, 0.0, 0.0, 0.0, 1.0)
}

fn easing_fluent_standard() -> Easing {
    return easing_bezier_kind(EASE_IN_OUT, 0.1, 0.9, 0.2, 1.0)
}

// A spring at CRITICAL damping (no overshoot, fastest settling): c = 2 sqrt(k m).
fn easing_spring_critical(mass: f64, stiff: f64) -> Easing {
    var m: f64 = mass
    if m <= 0.0 {
        m = 1.0
    }
    var k: f64 = stiff
    if k <= 0.0 {
        k = 1.0
    }
    return easing_spring(m, k, 2.0 * matrix.m_sqrt(k * m))
}

// Durations of the feel (ms), the numbers of WinUI's motion table: a hover
// colour 83, a press 50, the focus ring 100, a dialog or menu appearing 167.
const DUR_HOVER: i64 = 83
const DUR_PRESS: i64 = 50
const DUR_FOCUS: i64 = 100
const DUR_PANEL: i64 = 167
// One frame at 60 Hz. A transition that starts from rest is back-dated by
// this much, so the frame that HANDLES the event already shows motion.
const FRAME_LEAD_MS: i64 = 16

// A Bezier polynomial in one coordinate, with P0 = 0 and P3 = 1.
fn bez(a1: f64, a2: f64, t: f64) -> f64 {
    let u: f64 = 1.0 - t
    return 3.0 * u * u * t * a1 + 3.0 * u * t * t * a2 + t * t * t
}

fn bez_ableitung(a1: f64, a2: f64, t: f64) -> f64 {
    let u: f64 = 1.0 - t
    return 3.0 * u * u * a1 + 6.0 * u * t * (a2 - a1) + 3.0 * t * t * (1.0 - a2)
}

// THE CORE OF THE CSS CURVE. The curve gives x and y both via one
// parameter t -- but what is asked is y at a POSITION x. So first solve t
// from x. Newton, and where the derivative becomes too flat (the curve
// has horizontal places at the ends), bisection as a net underneath.
fn bezier_t_for_x(x1: f64, x2: f64, x: f64) -> f64 {
    if x <= 0.0 {
        return 0.0
    }
    if x >= 1.0 {
        return 1.0
    }
    var t: f64 = x
    var i: i32 = 0
    while i < 8 {
        let fx: f64 = bez(x1, x2, t) - x
        if matrix.m_abs(fx) < 1.0e-9 {
            return t
        }
        let d: f64 = bez_ableitung(x1, x2, t)
        if matrix.m_abs(d) < 1.0e-6 {
            i = 8
        } else {
            t = t - fx / d
            if t < 0.0 {
                t = 0.0
            }
            if t > 1.0 {
                t = 1.0
            }
            i = i + 1
        }
    }
    // The net: bisection on [0,1], 40 halvings are 1e-12.
    var lo: f64 = 0.0
    var hi: f64 = 1.0
    var m: f64 = t
    var k: i32 = 0
    while k < 40 {
        m = (lo + hi) * 0.5
        if bez(x1, x2, m) < x {
            lo = m
        } else {
            hi = m
        }
        k = k + 1
    }
    return m
}

// THE SPRING, ANALYTICALLY. Mass m, stiffness k, damping c; the
// displacement starts at 1 (= "still entirely at the start") and runs to 0.
// Returned is the progress 1 - x(t).
//
// Three cases, and all three must stand there, otherwise the formula breaks
// exactly at the aperiodic limit case (w == 0 in the denominator):
//
//   underdamped    z < 1: e^(-z*w0*t) * (cos(wd*t) + z*w0/wd * sin(wd*t))
//   critical       z = 1: e^(-w0*t) * (1 + w0*t)
//   overdamped     z > 1: two real exponents
fn spring_eval(mass: f64, stiff: f64, damp: f64, t: f64) -> f64 {
    var m: f64 = mass
    if m <= 0.0 {
        m = 1.0
    }
    var k: f64 = stiff
    if k <= 0.0 {
        k = 1.0
    }
    let w0: f64 = matrix.m_sqrt(k / m)
    let z: f64 = damp / (2.0 * matrix.m_sqrt(k * m))
    var x: f64 = 0.0
    if z < 0.999999 {
        let wd: f64 = w0 * matrix.m_sqrt(1.0 - z * z)
        x = math.exp(0.0 - z * w0 * t) *
        (math.cos(wd * t) + (z * w0 / wd) * math.sin(wd * t))
    } else if z <= 1.000001 {
        x = math.exp(0.0 - w0 * t) * (1.0 + w0 * t)
    } else {
        let r: f64 = matrix.m_sqrt(z * z - 1.0)
        let a: f64 = 0.0 - w0 * (z - r)
        let b: f64 = 0.0 - w0 * (z + r)
        // x(0) = 1, x'(0) = 0 resolves to these two weights.
        let ca: f64 = 0.0 - b / (a - b)
        let cb: f64 = a / (a - b)
        x = ca * math.exp(a * t) + cb * math.exp(b * t)
    }
    return 1.0 - x
}

// An easing at the position `p` from [0,1]. For the spring `p` is the
// normalised time; the duration of the animation is then the time after which
// the spring counts as having swung out.
fn ease_eval(e: *mut Easing, p: f64) -> f64 {
    var t: f64 = p
    if t < 0.0 {
        t = 0.0
    }
    if t > 1.0 {
        t = 1.0
    }
    let k: u32 = (*e).kind
    if k == EASE_LINEAR {
        return t
    }
    if k == EASE_STEPS {
        // steps(n, jump-end): the jump happens AT THE END of each
        // section, t = 1 gives exactly 1.
        let n: f64 = (*e).steps as f64
        let s: f64 = matrix.m_floor(t * n) / n
        if s > 1.0 {
            return 1.0
        }
        return s
    }
    if k == EASE_SPRING {
        // The spring time runs over the duration; 1.0 at the end of the parameter
        // means "one second of spring time" -- at stiffness 100 that
        // is plenty of time to swing out.
        return spring_eval((*e).mass, (*e).stiff, (*e).damp, t)
    }
    let u: f64 = bezier_t_for_x((*e).x1, (*e).x2, t)
    return bez((*e).y1, (*e).y2, u)
}

// ============================================================= A TWEEN
const DIR_NORMAL: u32 = 0
const DIR_ALTERNATE: u32 = 1
const REPEAT_FOREVER: i64 = 0 - 1

struct Animation {
    start_ms: i64,
    delay_ms: i64,
    dur_ms: i64,
    von: f64,
    bis: f64,
    ease: Easing,
    repeat: i64, // wie oft im Ganzen; REPEAT_FOREVER = endlos
    richtung: u32,
    active: u32,
    now_ms: i64,
}

fn anim_new(start_ms: i64, dur_ms: i64, von: f64, bis: f64,
    e: Easing) -> Animation {
    var d: i64 = dur_ms
    if d < 1 {
        d = 1
    }
    return Animation { start_ms: start_ms, delay_ms: 0, dur_ms: d,
        von: von, bis: bis, ease: e, repeat: 1, richtung: DIR_NORMAL,
        active: 1, now_ms: start_ms }
}

fn anim_set_delay(a: *mut Animation, ms: i64) { (*a).delay_ms = ms }
fn anim_set_repeat(a: *mut Animation, n: i64) { (*a).repeat = n }
fn anim_set_direction(a: *mut Animation, d: u32) { (*a).richtung = d }
fn anim_start(a: *mut Animation, ms: i64) {
    (*a).start_ms = ms
    (*a).now_ms = ms
    (*a).active = 1
}
fn anim_stop(a: *mut Animation) { (*a).active = 0 }
fn anim_active(a: *mut Animation) -> bool { return (*a).active != 0 }

// The progress in [0,1] at time `ms`, WITH delay, repetition
// and direction, but WITHOUT easing.
fn anim_progress(a: *mut Animation, ms: i64) -> f64 {
    let t: i64 = ms - (*a).start_ms - (*a).delay_ms
    if t <= 0 {
        return 0.0
    }
    let d: i64 = (*a).dur_ms
    var cycle: i64 = t / d
    var rest: f64 = ((t - cycle * d) as f64) / (d as f64)
    if (*a).repeat != REPEAT_FOREVER && cycle >= (*a).repeat {
        // Finished: stay standing at the end value of the LAST cycle.
        cycle = (*a).repeat - 1
        rest = 1.0
    }
    if (*a).richtung == DIR_ALTERNATE && (cycle & 1) == 1 {
        return 1.0 - rest
    }
    return rest
}

fn anim_done(a: *mut Animation, ms: i64) -> bool {
    if (*a).repeat == REPEAT_FOREVER {
        return false
    }
    return ms - (*a).start_ms - (*a).delay_ms >= (*a).dur_ms * (*a).repeat
}

// The value at time `ms`.
fn anim_value(a: *mut Animation, ms: i64) -> f64 {
    let p: f64 = ease_eval(&(*a).ease, anim_progress(a, ms))
    return (*a).von + ((*a).bis - (*a).von) * p
}

// ========================================================== THE REGISTRY
//
// Fixed size, no allocator: fUi also runs where there is none.
// Whoever has more than ANIM_MAX tweens running at the same time has a
// different problem than the upper limit.
const ANIM_MAX: usize = 32

struct Animator {
    a: [Animation; 32],
    n: usize,
    dirty: u32,
}

fn animator_new() -> Animator {
    return Animator {
        a: [anim_new(0, 1, 0.0, 0.0, easing_linear()); 32],
        n: 0, dirty: 0,
    }
}

fn animator_count(g: *mut Animator) -> usize { return (*g).n }
fn animator_clear(g: *mut Animator) { (*g).n = 0 }
fn animator_at(g: *mut Animator, i: usize) -> *mut Animation {
    return &(*g).a[i]
}

// Returned is the slot, so that the caller finds his tween
// again; ANIM_MAX means "no more room".
fn animator_add(g: *mut Animator, a: Animation) -> usize {
    if (*g).n >= ANIM_MAX {
        return ANIM_MAX
    }
    let i: usize = (*g).n
    (*g).a[i] = a
    (*g).n = i + 1
    return i
}

// THE CLOCK. Set all running tweens to `ms` and say whether
// a value has changed. Only then must it be redrawn.
//
// `dirty` APPLIES FOR THIS TICK, not forever. Until 23.09.2026
// it was set here and nowhere cleared again: after the first
// tween `animator_dirty` said "redraw" for the rest of the program,
// and a window loop that goes by it painted sixty frames per second
// while idle. Found when the first real window loop (lib/plat/fuiwirt.fi)
// really asked the question.
// The same rule `TransReg.dirty` has always had further down.
fn anim_tick(g: *mut Animator, ms: i64) -> bool {
    (*g).dirty = 0
    var geaendert: bool = false
    var i: usize = 0
    while i < (*g).n {
        let a: *mut Animation = &(*g).a[i]
        if (*a).active != 0 {
            let alt: f64 = anim_value(a, (*a).now_ms)
            (*a).now_ms = ms
            let neu: f64 = anim_value(a, ms)
            if neu != alt {
                geaendert = true
            }
            if anim_done(a, ms) {
                (*a).active = 0
                geaendert = true
            }
        }
        i = i + 1
    }
    if geaendert {
        (*g).dirty = 1
    }
    return geaendert
}

fn animator_dirty(g: *mut Animator) -> bool { return (*g).dirty != 0 }

// Is a tween still running? Then the page needs the next frame too
// (lib/plat/web.fi, the frame clock: without a running tween it asks for
// none any more).
fn animator_busy(g: *mut Animator) -> bool {
    var i: usize = 0
    while i < (*g).n {
        if (*g).a[i].active != 0 {
            return true
        }
        i = i + 1
    }
    return false
}

// ================================================================ COLOURS
//
// Both mixers take and give 0xAARRGGBB and calculate PREMULTIPLIED.
fn channel(c: u32, s: u32) -> f64 {
    return (((c >> s) & 255 as u32) as f64) / 255.0
}

fn pack(a: f64, r: f64, g: f64, b: f64) -> u32 {
    return (eight(a) << 24) | (eight(r) << 16) | (eight(g) << 8) | eight(b)
}

fn eight(v: f64) -> u32 {
    var x: f64 = v * 255.0 + 0.5
    if x < 0.0 {
        x = 0.0
    }
    if x > 255.0 {
        x = 255.0
    }
    return (x as i64) as u32
}

// Linear in sRGB, with correct alpha: the colour components are mixed
// WITH alpha weighting and afterwards divided out again. Without that
// the path from transparent to opaque runs through a grey that occurs in
// neither of the two colours.
fn mix_srgb(c0: u32, c1: u32, t: f64) -> u32 {
    var u: f64 = t
    if u < 0.0 {
        u = 0.0
    }
    if u > 1.0 {
        u = 1.0
    }
    let a0: f64 = channel(c0, 24)
    let a1: f64 = channel(c1, 24)
    let a: f64 = a0 + (a1 - a0) * u
    if a <= 0.0 {
        return 0 as u32
    }
    let r: f64 = (channel(c0, 16) * a0 + (channel(c1, 16) * a1 - channel(c0, 16) * a0) * u) / a
    let g: f64 = (channel(c0, 8) * a0 + (channel(c1, 8) * a1 - channel(c0, 8) * a0) * u) / a
    let b: f64 = (channel(c0, 0) * a0 + (channel(c1, 0) * a1 - channel(c0, 0) * a0) * u) / a
    return pack(a, r, g, b)
}

// sRGB -> OKLab (Björn Ottosson, 2020). First take the gamma curve out,
// then the LMS matrix, then the cube root, then the second matrix.
fn zu_linear(c: f64) -> f64 {
    if c <= 0.04045 {
        return c / 12.92
    }
    return math.powf((c + 0.055) / 1.055, 2.4)
}

fn zu_srgb(c: f64) -> f64 {
    if c <= 0.0031308 {
        return c * 12.92
    }
    return 1.055 * math.powf(c, 1.0 / 2.4) - 0.055
}

fn kubikwurzel(x: f64) -> f64 {
    if x == 0.0 {
        return 0.0
    }
    if x < 0.0 {
        return 0.0 - math.powf(0.0 - x, 1.0 / 3.0)
    }
    return math.powf(x, 1.0 / 3.0)
}

fn srgb_to_oklab(r: f64, g: f64, b: f64, ol: *mut f64, oa: *mut f64,
    ob: *mut f64) {
    let lr: f64 = zu_linear(r)
    let lg: f64 = zu_linear(g)
    let lb: f64 = zu_linear(b)
    let l: f64 = kubikwurzel(0.4122214708 * lr + 0.5363325363 * lg + 0.0514459929 * lb)
    let m: f64 = kubikwurzel(0.2119034982 * lr + 0.6806995451 * lg + 0.1073969566 * lb)
    let s: f64 = kubikwurzel(0.0883024619 * lr + 0.2817188376 * lg + 0.6299787005 * lb)
    *ol = 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s
    *oa = 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s
    *ob = 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s
}

fn oklab_to_srgb(ll: f64, aa: f64, bb: f64, orr: *mut f64, og: *mut f64,
    ob: *mut f64) {
    let l_: f64 = ll + 0.3963377774 * aa + 0.2158037573 * bb
    let m_: f64 = ll - 0.1055613458 * aa - 0.0638541728 * bb
    let s_: f64 = ll - 0.0894841775 * aa - 1.2914855480 * bb
    let l: f64 = l_ * l_ * l_
    let m: f64 = m_ * m_ * m_
    let s: f64 = s_ * s_ * s_
    *orr = zu_srgb(4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s)
    *og = zu_srgb(0.0 - 1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s)
    *ob = zu_srgb(0.0 - 0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s)
}

// The pretty way: mix in OKLab. Alpha stays linear and is NOT
// pulled into the colour space -- it is an opacity, not a colour.
fn mix_oklab(c0: u32, c1: u32, t: f64) -> u32 {
    var u: f64 = t
    if u < 0.0 {
        u = 0.0
    }
    if u > 1.0 {
        u = 1.0
    }
    var l0: f64 = 0.0
    var a0v: f64 = 0.0
    var b0v: f64 = 0.0
    var l1: f64 = 0.0
    var a1v: f64 = 0.0
    var b1v: f64 = 0.0
    srgb_to_oklab(channel(c0, 16), channel(c0, 8), channel(c0, 0), &l0, &a0v, &b0v)
    srgb_to_oklab(channel(c1, 16), channel(c1, 8), channel(c1, 0), &l1, &a1v, &b1v)
    var r: f64 = 0.0
    var g: f64 = 0.0
    var b: f64 = 0.0
    oklab_to_srgb(l0 + (l1 - l0) * u, a0v + (a1v - a0v) * u,
        b0v + (b1v - b0v) * u, &r, &g, &b)
    let al: f64 = channel(c0, 24) + (channel(c1, 24) - channel(c0, 24)) * u
    return pack(al, r, g, b)
}

// ==================================================== THE STATE CHANGE
//
// This is CSS `transition` for a widget: on the change of state
// a tween runs from the OLD values to the NEW ones. The old values
// are the ones that are currently on the screen -- not those of the previous
// state. Only so does a change in the middle of the motion stay continuous
// (mouse back off before the motion is finished).
struct Transition {
    state: u32,
    dur_ms: i64,
    ease: Easing,
    t0_ms: i64,
    // from / to for every quantity
    bg_von: u32,
    bg_bis: u32,
    rad_von: f64,
    rad_bis: f64,
    bor_von: f64,
    bor_bis: f64,
    alp_von: f64,
    alp_bis: f64,
    dx_von: f64,
    dx_bis: f64,
    dy_von: f64,
    dy_bis: f64,
    p: f64, // the last computed progress after easing
    oklab: u32, // 1 = Farbe in OKLab mischen
    // EACH STATE ITS OWN DURATION. CSS can do that through several
    // `transition` rules, and you need it: a button should react
    // immediately when PRESSED (short) and flow back softly when released
    // (long). A single duration for both directions
    // makes the surface seem either sluggish or nervous.
    // 0 means "nothing set, take dur_ms".
    dur_state: [i64; 6],
    // back-dating of a start FROM REST (ms), see FRAME_LEAD_MS; 0 = off
    lead_ms: i64,
}

fn trans_new(bg: u32, radius: f64, border: f64, alpha: f64) -> Transition {
    return Transition {
        state: 0, dur_ms: 120, ease: easing_named(EASE_OUT), t0_ms: 0,
        bg_von: bg, bg_bis: bg, rad_von: radius, rad_bis: radius,
        bor_von: border, bor_bis: border, alp_von: alpha, alp_bis: alpha,
        dx_von: 0.0, dx_bis: 0.0, dy_von: 0.0, dy_bis: 0.0,
        p: 1.0, oklab: 0, dur_state: [0 as i64; 6], lead_ms: 0,
    }
}

fn trans_set_duration(t: *mut Transition, ms: i64) {
    if ms < 1 {
        (*t).dur_ms = 1
    } else {
        (*t).dur_ms = ms
    }
}

fn trans_set_easing(t: *mut Transition, e: Easing) { (*t).ease = e }

// OKLab switchable from outside. The default stays sRGB, because CSS does it that way
// and because two neighbouring greys look the same in both spaces;
// whoever runs from blue to yellow switches over and keeps
// a colourful path instead of the dead grey in the middle.
fn trans_set_oklab(t: *mut Transition, an: bool) {
    if an {
        (*t).oklab = 1
    } else {
        (*t).oklab = 0
    }
}

fn trans_oklab(t: *mut Transition) -> bool { return (*t).oklab != 0 }

// The progress AFTER easing -- that is the value with which all
// quantities are mixed. Visible from outside, so that a check can
// re-calculate it without comparing six getters.
fn trans_progress(t: *mut Transition) -> f64 { return (*t).p }

// A duration of its own for ONE target state. `ms <= 0` takes the
// default back.
fn trans_set_state_duration(t: *mut Transition, state: u32, ms: i64) {
    if (state as usize) >= style.STATE_COUNT {
        return
    }
    if ms < 0 {
        (*t).dur_state[state as usize] = 0
    } else {
        (*t).dur_state[state as usize] = ms
    }
}

fn trans_state_duration(t: *mut Transition, state: u32) -> i64 {
    if (state as usize) >= style.STATE_COUNT {
        return (*t).dur_ms
    }
    let d: i64 = (*t).dur_state[state as usize]
    if d > 0 {
        return d
    }
    return (*t).dur_ms
}

// The currently effective duration: that of the TARGET state. The run
// belongs to the state that is being run towards -- that is the reading of CSS,
// where the `transition` statement of the target state applies.
fn trans_duration(t: *mut Transition) -> i64 {
    return trans_state_duration(t, (*t).state)
}

// The change. What is to be seen now becomes the start; the target values
// come from the caller, who fetches them from theme and style.
fn trans_to_state(t: *mut Transition, now_ms: i64, state: u32, bg: u32,
    radius: f64, border: f64, alpha: f64, dx: f64, dy: f64) {
    // a start FROM REST that really changes something is back-dated by the
    // lead, so the frame that handles the event already shows motion; a
    // start in mid-motion keeps continuity (no jump of the visible value)
    var lead: i64 = 0
    if (*t).p >= 0.999 && (*t).lead_ms > 0 {
        if trans_color(t) != bg || trans_radius(t) != radius
        || trans_border(t) != border || trans_alpha(t) != alpha
        || trans_dx(t) != dx || trans_dy(t) != dy {
            lead = (*t).lead_ms
        }
    }
    (*t).bg_von = trans_color(t)
    (*t).rad_von = trans_radius(t)
    (*t).bor_von = trans_border(t)
    (*t).alp_von = trans_alpha(t)
    (*t).dx_von = trans_dx(t)
    (*t).dy_von = trans_dy(t)
    (*t).bg_bis = bg
    (*t).rad_bis = radius
    (*t).bor_bis = border
    (*t).alp_bis = alpha
    (*t).dx_bis = dx
    (*t).dy_bis = dy
    (*t).state = state
    (*t).t0_ms = now_ms - lead
    (*t).p = 0.0
}

// Keep calculating. `true` means: the picture is stale.
fn trans_tick(t: *mut Transition, now_ms: i64) -> bool {
    let alt: f64 = (*t).p
    var roh: f64 = ((now_ms - (*t).t0_ms) as f64) / (trans_duration(t) as f64)
    if roh < 0.0 {
        roh = 0.0
    }
    if roh > 1.0 {
        roh = 1.0
    }
    (*t).p = ease_eval(&(*t).ease, roh)
    return (*t).p != alt
}

fn trans_state(t: *mut Transition) -> u32 { return (*t).state }

fn trans_color(t: *mut Transition) -> u32 {
    if (*t).oklab != 0 {
        return mix_oklab((*t).bg_von, (*t).bg_bis, (*t).p)
    }
    return mix_srgb((*t).bg_von, (*t).bg_bis, (*t).p)
}

fn lerp(a: f64, b: f64, p: f64) -> f64 { return a + (b - a) * p }

fn trans_radius(t: *mut Transition) -> f64 {
    return lerp((*t).rad_von, (*t).rad_bis, (*t).p)
}
fn trans_border(t: *mut Transition) -> f64 {
    return lerp((*t).bor_von, (*t).bor_bis, (*t).p)
}
fn trans_alpha(t: *mut Transition) -> f64 {
    return lerp((*t).alp_von, (*t).alp_bis, (*t).p)
}
fn trans_dx(t: *mut Transition) -> f64 {
    return lerp((*t).dx_von, (*t).dx_bis, (*t).p)
}
fn trans_dy(t: *mut Transition) -> f64 {
    return lerp((*t).dy_von, (*t).dy_bis, (*t).p)
}

// ============================================ THE TRANSITION AT THE WIDGET
//
// Until here the `Transition` is a calculating mechanism without connection: the
// caller had to procure six target values himself. With that every
// program would have got its own idea of which colour a
// pressed button heads for -- exactly the kind of repetition
// that lib/fui set out against. The path from widget to tween stands
// therefore HERE, once, and it asks the existing sources:
//
//   colour       style.resolve_bg(Styleset, state, render.def_bg_state)
//                -> theme.color_from_style (token -> real colour)
//   radius       style.resolve_num(SF_RADIUS, ..., render.def_radius)
//   border width style.resolve_num(SF_BORDER_W, ..., render.def_border_width)
//   opacity      style.resolve_alpha
//
// ALL lengths here are STYLE UNITS, not pixels: `trans_apply`
// writes them back into the style, and render then scales them with
// `render.len_of`. Whoever paints directly scales himself.

// ==================================================== THE MOTION RULE
//
// This is the only place at which this house fixes something NEW, and
// the rule is the one you know from Material and Fluent: hovering
// raises, pressing lowers. A button that does NOT move when pressed
// feels like a picture of a button.
fn state_dy(state: u32) -> f64 {
    if state == style.STATE_HOVER {
        return 0.0 - 1.0
    }
    if state == style.STATE_ACTIVE {
        return 1.0
    }
    return 0.0
}

// Horizontally no state shifts. The size nevertheless belongs in
// the transition (a slider, a tab change needs it), and it is
// freely settable via `trans_to_state` -- that is why the rule
// stands as a named function and not as a scattered zero.
fn state_dx(state: u32) -> f64 {
    return 0.0
}

// When pressed the corner becomes tighter, when hovered wider: the same reading
// as with the height -- what comes closer becomes rounder.
fn state_radius_delta(state: u32) -> f64 {
    if state == style.STATE_HOVER {
        return 2.0
    }
    if state == style.STATE_ACTIVE {
        return 0.0 - 2.0
    }
    return 0.0
}

// In focus the border becomes stronger by `shape.focus_w`. That is NO
// second focus ring -- render.draw_focus_ring still paints that; it
// is the soft preliminary stage, so that the ring does not pop up.
fn state_border_delta(m: *mut theme.Theme, state: u32) -> f64 {
    if state == style.STATE_FOCUS {
        return (*theme.theme_shape(m)).focus_w as f64
    }
    return 0.0
}

// ======================================================== THE TARGET VALUES
//
// The surface colour that the widget WOULD have in state `state`. A
// colour that is not visible (transparent/inherit) becomes the
// transparent zero -- and because mixing is premultiplied,
// the path from there runs in the target colour and not through grey.
fn widget_target_bg(c: *mut render.Ctx, e: *mut widget.Widget,
    state: u32) -> u32 {
    let sz: *mut style.StyleSet = widget.w_styleset(e)
    let kind: u32 = widget.w_kind(e)
    let w: u32 = style.resolve_bg(sz, state, render.def_bg_state(kind, state))
    if !style.color_is_visible(w) {
        return 0 as u32
    }
    return theme.opaque(theme.color_from_style(render.ctx_theme(c), w))
}

fn widget_target_radius(c: *mut render.Ctx, e: *mut widget.Widget,
    state: u32) -> f64 {
    let sz: *mut style.StyleSet = widget.w_styleset(e)
    let kind: u32 = widget.w_kind(e)
    let r: f64 = style.resolve_num(sz, style.SF_RADIUS,
        (*style.styleset_base(sz)).radius as usize,
        render.def_radius(c, kind)) as f64
    var v: f64 = r + state_radius_delta(state)
    if v < 0.0 {
        v = 0.0
    }
    return v
}

fn widget_target_border(c: *mut render.Ctx, e: *mut widget.Widget,
    state: u32) -> f64 {
    let sz: *mut style.StyleSet = widget.w_styleset(e)
    let kind: u32 = widget.w_kind(e)
    let b: f64 = style.resolve_num(sz, style.SF_BORDER_W,
        (*style.styleset_base(sz)).border_w as usize,
        render.def_border_width(c, kind)) as f64
    return b + state_border_delta(render.ctx_theme(c), state)
}

// The opacity as a fraction. 255 is the default of the cascade, so
// 1.0 is the normal case -- a widget becomes transparent only if
// somebody expressly says so.
fn widget_target_alpha(c: *mut render.Ctx, e: *mut widget.Widget,
    state: u32) -> f64 {
    let sz: *mut style.StyleSet = widget.w_styleset(e)
    return (style.resolve_alpha(sz, state) as f64) / 255.0
}

// THE CONNECTION. If the widget stands in a different state from the
// transition, the tween is set anew FROM THE CURRENT PICTURE
// and `true` is reported. Otherwise nothing happens -- in particular nothing is
// restarted, because one call per frame is the normal case.
fn trans_from_widget(t: *mut Transition, c: *mut render.Ctx,
    e: *mut widget.Widget, now_ms: i64) -> bool {
    let zu: u32 = widget.w_state(e)
    if zu == (*t).state {
        // SAME STATE, BUT THE TARGET MOVED: the theme (light/dark, accent,
        // shape) or the widget's own style changed under a resting widget.
        // Nothing animates a state change here, so the written-back colour
        // would stay the OLD theme's literal forever (light face + light
        // text in dark). A theme switch is not a hover: snap, don't fade.
        if trans_target_moved(t, c, e, zu) {
            trans_snap_widget(t, c, e, now_ms)
            return true
        }
        return false
    }
    trans_force_widget(t, c, e, now_ms)
    return true
}

fn trans_target_moved(t: *mut Transition, c: *mut render.Ctx,
    e: *mut widget.Widget, zu: u32) -> bool {
    return widget_target_bg(c, e, zu) != (*t).bg_bis
    || widget_target_radius(c, e, zu) != (*t).rad_bis
    || widget_target_border(c, e, zu) != (*t).bor_bis
    || widget_target_alpha(c, e, zu) != (*t).alp_bis
}

// Jump to the current target values without any motion.
fn trans_snap_widget(t: *mut Transition, c: *mut render.Ctx,
    e: *mut widget.Widget, now_ms: i64) {
    let zu: u32 = widget.w_state(e)
    (*t).bg_bis = widget_target_bg(c, e, zu)
    (*t).rad_bis = widget_target_radius(c, e, zu)
    (*t).bor_bis = widget_target_border(c, e, zu)
    (*t).alp_bis = widget_target_alpha(c, e, zu)
    (*t).bg_von = (*t).bg_bis
    (*t).rad_von = (*t).rad_bis
    (*t).bor_von = (*t).bor_bis
    (*t).alp_von = (*t).alp_bis
    (*t).dx_von = (*t).dx_bis
    (*t).dy_von = (*t).dy_bis
    // finished already: the tick that follows must not restart the clock
    (*t).t0_ms = now_ms - trans_duration(t) - 1
    (*t).p = 1.0
}

// Take the same path WITHOUT waiting for a change: that is needed
// once at construction (so that the transition stands on the true values
// of the widget) and in the gallery, which sets a state by
// hand.
fn trans_force_widget(t: *mut Transition, c: *mut render.Ctx,
    e: *mut widget.Widget, now_ms: i64) {
    let zu: u32 = widget.w_state(e)
    trans_to_state(t, now_ms, zu,
        widget_target_bg(c, e, zu),
        widget_target_radius(c, e, zu),
        widget_target_border(c, e, zu),
        widget_target_alpha(c, e, zu),
        state_dx(zu), state_dy(zu))
}

// Write the intermediate state back into the style of the widget, so that
// render.draw_* paints it without any special treatment. The colour thereby
// becomes a LITERAL -- it is mixed after all and no longer a role.
fn trans_apply(t: *mut Transition, e: *mut widget.Widget) {
    let s: *mut style.Style = widget.w_style(e)
    let col: u32 = trans_color(t)
    var a: f64 = trans_alpha(t) * (((col >> 24) & 255 as u32) as f64) / 255.0
    if a < 0.0 {
        a = 0.0
    }
    if a > 1.0 {
        a = 1.0
    }
    var r: f64 = trans_radius(t) + 0.5
    if r < 0.0 {
        r = 0.0
    }
    var b: f64 = trans_border(t) + 0.5
    if b < 0.0 {
        b = 0.0
    }
    *s = style.style_set_bg(*s, style.color_literal(col & 16777215 as u32))
    *s = style.style_set_radius(*s, (r as i64) as usize)
    *s = style.style_set_border_width(*s, (b as i64) as usize)
    *s = style.style_set_alpha(*s, ((a * 255.0) as i64) as usize)
}

// Put the widget in its place, offset by the shift of the
// transition. Separate from `trans_apply`, because a caller
// with a layout of his own wants to take over the colour but calculate the offset
// himself.
fn trans_place(t: *mut Transition, e: *mut widget.Widget, x: f64, y: f64,
    w: f64, h: f64) {
    widget.w_place(e, x + trans_dx(t), y + trans_dy(t), w, h)
}

// ======================================================================
// THE REGISTRY THAT THE DRAWING PATH KEEPS ITSELF
// ======================================================================
//
// WHY IT EXISTS. Everything above this line calculates correctly and
// waits for somebody to call it -- and until round
// FEHLERBEHEBUNG exactly one program called it (demos/fuidemo). Thereby
// `anim.Transition` would have become what this library set out
// against: a capability that every application assembles for itself,
// and nineteen out of twenty assemble it differently.
//
// The registry holds ONE TRANSITION PER WIDGET and is prodded by
// `render.draw_button` on every frame. A caller
// needs two lines for it:
//
//     var reg: anim.TransReg = anim.transreg_new()
//     anim.transreg_bind(&reg, &ctx)
//
// After that the change normal -> hover -> pressed -> focus of
// every button runs over time without the application knowing anything
// about it. `render.anim_run` returns whether the picture is stale --
// on that hangs the demand-driven redrawing.
//
// THE KEY IS THE ADDRESS OF THE WIDGET -- or, if the program says how
// (`transreg_set_keyer`), THE KEY PATH OF ITS NODE (roadmap r110, T2 of
// docs/APP-TREE.md). That fits the way fUi holds widgets (the caller owns
// an array that lives longer than a frame -- widget.fi E1). Short-lived
// building blocks on the stack therefore do NOT belong here, and that is
// why render.fi prods the registry in `draw_button` and not in
// `draw_base`; the reason stands written out there.
//
// Why a second kind of key. A tree that is REBUILT (the scene of a program
// that describes its page again after every change) puts a node on another
// number when something is inserted before it, and its widget -- the
// carrier inside the node -- on another address. A transition keyed by
// address then follows the wrong widget: the button that was half way to
// its hover colour jumps back, and its neighbour starts to glow. Keyed by
// the key path (lib/fui/query.fi `query_key_hash`: the keys of the keyed
// ancestors and the node's own, folded) the entry stays with the SAME
// control through any number of rebuilds. A widget without a key (or a
// registry without a keyer) is still found by its address, as before.
const TRANS_MAX: usize = 32
// An entry nobody asked for during this long is an orphan (r115): the widget
// it belonged to was an unkeyed one that a rebuild put at another address.
const STALE_MS: i64 = 2000

struct TransReg {
    k: [u64; 32], // the widgets, by address
    // THE REST STYLE OF THE WIDGET, as it looked at the first frame.
    //
    // `trans_apply` writes the intermediate state INTO the style of the
    // widget -- that is the reason why render.fi need know nothing of it.
    // But exactly from that follows a trap, and it snapped shut
    // at the first attempt: at the next frame `widget_target_bg`
    // fetches the TARGET colour again from the same cascade, and
    // there now stands the mixed colour from just now. The
    // transition would then run towards its own intermediate state and
    // never budge (measured: the button stayed standing at
    // 0x42414D).
    //
    // That is why the registry remembers the style that the widget had at the
    // first frame and resets it before every question about the
    // target values. WHOEVER CHANGES THE STYLE OF A WIDGET LATER
    // says so with `transreg_clear` -- otherwise the registry keeps painting
    // the old one.
    b: [style.Style; 32],
    t: [Transition; 32],
    n: usize,
    // when each entry was last asked for (ms): an entry nobody has asked for
    // since STALE_MS belonged to a widget that is gone (a rebuild put an
    // unkeyed one elsewhere) and its slot may be taken over (r115)
    seen: [i64; 32],
    dur: i64, // the duration a new entry gets
    ease: Easing,
    oklab: u32,
    dirty: u32, // did it do any work in the last tick?
    // The keyer (transreg_set_keyer): widget address -> key path number, 0 =
    // no key. has_keyer 0: the address is the key.
    kf: fn(u64, u64) -> u64,
    kud: u64,
    has_keyer: u32,
    // W3: lead-in and per-state durations handed to every new entry
    lead: i64,
    dstate: [i64; 6],
    // W3: the channel registry (chan_f / chan_color): values of controls
    // that are not widgets with a Transition (knob position, tick progress ...)
    ch_key: [u64; 48],
    ch_id: [u32; 48],
    ch_seen: [i64; 48],
    ch_tw: [Tween; 48],
    ch_n: usize,
    // W7: where the running work is. `unb` = something is dirty without a
    // rectangle (a widget transition, a busy mark): paint everything.
    // Otherwise `dm` holds the rectangles of the busy channels only.
    unb: u32,
    dm: damage.Damage,
    bx0: f64,
    by0: f64,
    bx1: f64,
    by1: f64,
    has_b: u32,
}

fn keyer_none(ud: u64, wx: u64) -> u64 {
    return 0
}

// 120 ms and ease-out is the default that Material and Fluent name for
// a state change: short enough that it does not seem sluggish,
// long enough that the eye sees the motion.
fn transreg_new() -> TransReg {
    return TransReg {
        k: [0 as u64; 32],
        b: [style.style_new(); 32],
        t: [trans_new(0 as u32, 0.0, 0.0, 1.0); 32],
        n: 0, seen: [0 as i64; 32], dur: 120, ease: easing_named(EASE_OUT),
        oklab: 0,
        dirty: 0, kf: keyer_none, kud: 0, has_keyer: 0 as u32,
        lead: 0, dstate: [0 as i64; 6],
        ch_key: [0 as u64; 48], ch_id: [0 as u32; 48], ch_seen: [0 as i64; 48],
        ch_tw: [tween_new(); 48], ch_n: 0,
        unb: 0, dm: damage.dmg_new(), bx0: 0.0, by0: 0.0, bx1: 0.0, by1: 0.0,
        has_b: 0,
    }
}

// Key the entries by key path. `f(ud, widget address)` answers the number of
// the widget's key path with the top bit set (so it can never be taken for
// an address), or 0 for a widget without a key -- then the address is the key.
// lib/fui/query.fi `query_widget_key` is the one for a scene:
//
//     anim.transreg_set_keyer(&reg, &sc as u64, query.query_widget_key)
//
// Set it BEFORE the first frame; entries made earlier stay under their address.
fn transreg_set_keyer(r: *mut TransReg, ud: u64, f: fn(u64, u64) -> u64) {
    (*r).kf = f
    (*r).kud = ud
    (*r).has_keyer = 1 as u32
}

// A LOAD out of memory carries no taint (escape.rs): the address of a widget
// as a bare number is only a name for it, the registry never uses it as a
// pointer. Without this the escape check follows `e as u64` into the table.
fn addr_name(a: u64) -> u64 {
    var cell: u64 = a
    let q: *mut u64 = &cell
    return *q
}

// The same with the widget's address as a bare number (no pointer travels).
fn transreg_key_u(r: *mut TransReg, a0: u64) -> u64 {
    let a: u64 = addr_name(a0)
    if (*r).has_keyer != 0 as u32 {
        let f: fn(u64, u64) -> u64 = (*r).kf
        let h: u64 = f((*r).kud, a)
        if h != 0 as u64 {
            return h
        }
    }
    return a
}

fn transreg_key(r: *mut TransReg, e: *mut widget.Widget) -> u64 {
    if (*r).has_keyer != 0 as u32 {
        let f: fn(u64, u64) -> u64 = (*r).kf
        let h: u64 = f((*r).kud, e as u64)
        if h != 0 as u64 {
            return h
        }
    }
    return e as u64
}

fn transreg_count(r: *mut TransReg) -> usize { return (*r).n }

// Forget everything. After that every widget is taken up anew at the next frame
// -- with the style that it has THEN.
fn transreg_clear(r: *mut TransReg) {
    (*r).n = 0
    (*r).dirty = 0
    (*r).unb = 0
    damage.dmg_reset(&(*r).dm)
}
fn transreg_dirty(r: *mut TransReg) -> bool { return (*r).dirty != 0 }

// A NEW FRAME BEGINS: `dirty` is "something worked during THIS frame" and
// only the caller knows where a frame starts (the hook sets the flag, nobody
// else lowers it). A host that wants "paint again while a transition runs"
// calls this before it paints and `transreg_dirty` after (r126,
// fuiwirt.host_set_transitions).
fn transreg_new_frame(r: *mut TransReg) {
    (*r).dirty = 0
    (*r).unb = 0
    damage.dmg_reset(&(*r).dm)
}

// W7: true when everything that is running has a named rectangle (only
// channels with `chan_bounds`): the host adds `transreg_damage` to its own
// damage instead of repainting the window.
fn transreg_bounded(r: *mut TransReg) -> bool {
    return (*r).dirty != 0 && (*r).unb == 0 && !damage.dmg_is_empty(&(*r).dm)
}

fn transreg_damage(r: *mut TransReg) -> *mut damage.Damage {
    return &(*r).dm
}

fn transreg_set_duration(r: *mut TransReg, ms: i64) {
    if ms < 1 {
        (*r).dur = 1
    } else {
        (*r).dur = ms
    }
}

fn transreg_set_easing(r: *mut TransReg, e: Easing) { (*r).ease = e }

fn transreg_set_oklab(r: *mut TransReg, an: bool) {
    if an {
        (*r).oklab = 1
    } else {
        (*r).oklab = 0
    }
}

// WHICH ELEMENTS GET A TRANSITION. Those whose surface colour
// depends on the state -- exactly the list that `render.def_bg_state`
// keeps. A label has no state that you could see, and
// a separator even less; for them the entry in the
// registry would be only used-up space.
fn transreg_kind_ok(k: u32) -> bool {
    return k == widget.KIND_BUTTON || k == widget.KIND_TOGGLE
    || k == widget.KIND_TILE || k == widget.KIND_TAB
    || k == widget.KIND_TEXTBOX
}

// Look for the entry of a widget. TRANS_MAX means "none".
fn transreg_find(r: *mut TransReg, e: *mut widget.Widget) -> usize {
    let key: u64 = transreg_key(r, e)
    var i: usize = 0
    while i < (*r).n {
        if (*r).k[i] == key {
            return i
        }
        i = i + 1
    }
    return TRANS_MAX
}

// Fetch the entry and, if it does not exist yet, create it -- on the
// TRUE values of the widget (`trans_force_widget`), so that the
// first change starts from where the button stands, and not from
// a black.
//
// If the registry is full, 0 comes back. That is visible and honest:
// the button then jumps as before, instead of memory being
// requested somewhere that fUi does not have.
fn transreg_index(r: *mut TransReg, c: *mut render.Ctx,
    e: *mut widget.Widget, now_ms: i64) -> usize {
    let i: usize = transreg_find(r, e)
    if i < TRANS_MAX {
        (*r).seen[i] = now_ms
        return i
    }
    var j: usize = (*r).n
    if j >= TRANS_MAX {
        // FULL: take over the slot of the entry that has gone the longest
        // without being asked for, if that is longer than STALE_MS. A live
        // widget is asked for in every painted frame, so what is stale is an
        // orphan -- or a widget in a picture that has not been painted for
        // seconds, which then simply starts again from its true values
        // (`trans_force_widget`), no jump. Nothing stale: the registry is
        // really full and the newcomer jumps, as before.
        var oldest: usize = TRANS_MAX
        var t0: i64 = now_ms - STALE_MS
        var k: usize = 0
        while k < TRANS_MAX {
            if (*r).seen[k] < t0 {
                t0 = (*r).seen[k]
                oldest = k
            }
            k = k + 1
        }
        if oldest >= TRANS_MAX {
            return TRANS_MAX
        }
        j = oldest
    } else {
        (*r).n = j + 1
    }
    (*r).seen[j] = now_ms
    (*r).k[j] = transreg_key(r, e)
    (*r).b[j] = *widget.w_style(e)
    (*r).t[j] = trans_new(widget_target_bg(c, e, widget.w_state(e)),
        widget_target_radius(c, e, widget.w_state(e)),
        widget_target_border(c, e, widget.w_state(e)),
        widget_target_alpha(c, e, widget.w_state(e)))
    trans_set_duration(&(*r).t[j], (*r).dur)
    trans_set_easing(&(*r).t[j], (*r).ease)
    trans_set_oklab(&(*r).t[j], (*r).oklab != 0)
    var si: u32 = 0
    while si < 6 as u32 {
        if (*r).dstate[si as usize] > 0 {
            trans_set_state_duration(&(*r).t[j], si, (*r).dstate[si as usize])
        }
        si = si + 1 as u32
    }
    (*r).t[j].lead_ms = (*r).lead
    trans_force_widget(&(*r).t[j], c, e, now_ms)
    // a new entry STANDS on the true values: it is at rest, not at the start
    // of a run (otherwise it would repaint for a whole duration for nothing,
    // and a hover in that time would count as mid-motion)
    (*r).t[j].t0_ms = now_ms - 100000
    (*r).t[j].p = 1.0
    return j
}

fn transreg_slot(r: *mut TransReg, c: *mut render.Ctx,
    e: *mut widget.Widget, now_ms: i64) -> *mut Transition {
    let i: usize = transreg_index(r, c, e, now_ms)
    if i >= TRANS_MAX {
        return 0 as *mut Transition
    }
    return &(*r).t[i]
}

// THE FUNCTION THAT render.fi CALLS. The pointers arrive as numbers,
// because render.fi must not know this file (the reason stands there
// at `Ctx`): anim.fi asks render.fi for the target values, so the
// dependency points in this direction and not back.
//
// The sequence is that of a frame: on a state change set the tween
// anew, calculate to the time of day, write the intermediate state back into the style.
// Returned is "the picture is stale".
fn transreg_hook(reg: u64, cx: u64, wx: u64, now_ms: i64) -> bool {
    if reg == 0 || cx == 0 || wx == 0 {
        return false
    }
    let r: *mut TransReg = reg as *mut TransReg
    let c: *mut render.Ctx = cx as *mut render.Ctx
    let e: *mut widget.Widget = wx as *mut widget.Widget
    if !transreg_kind_ok(widget.w_kind(e)) {
        return false
    }
    let i: usize = transreg_index(r, c, e, now_ms)
    if i >= TRANS_MAX {
        return false
    }
    // First the rest style back, THEN ask for the target values --
    // the reason stands above at the field `b`.
    *widget.w_style(e) = (*r).b[i]
    let t: *mut Transition = &(*r).t[i]
    // The change sets the tween anew; the duration of the TARGET state
    // applies, and that stands in the transition itself.
    var d: bool = trans_from_widget(t, c, e, now_ms)
    if trans_tick(t, now_ms) {
        d = true
    }
    trans_apply(t, e)
    if d {
        (*r).dirty = 1
        trans_mark_bounds(r, c, e)
    }
    return d
}

// A running colour transition dirties the widget's own ink rectangle (box +
// focus ring + anti-aliasing), not the window -- a hover frame repaints about
// the button, as the pointer move itself does. A widget with a box shadow
// (its reach is the theme's shadow + lift) stays unbounded: whole window.
fn trans_mark_bounds(r: *mut TransReg, c: *mut render.Ctx, e: *mut widget.Widget) {
    let st: *mut style.Style = widget.w_style(e)
    if ((*st).set_mask & style.SF_BOX_SHADOW) != 0 as u32
    || widget.w_w(e) <= 0.0 || widget.w_h(e) <= 0.0 {
        (*r).unb = 1
        return
    }
    let fo: *mut theme.Shape = theme.theme_shape(render.ctx_theme(c))
    let pad: f64 = render.len_of(c, 4) + (*fo).focus_w as f64
    damage.dmg_add(&(*r).dm, widget.w_x(e) - pad, widget.w_y(e) - pad,
        widget.w_x(e) + widget.w_w(e) + pad, widget.w_y(e) + widget.w_h(e) + pad)
}

fn transreg_bind(r: *mut TransReg, c: *mut render.Ctx) {
    render.ctx_bind_anim(c, r as u64, transreg_hook)
}

fn transreg_unbind(r: *mut TransReg, c: *mut render.Ctx) {
    render.ctx_unbind_anim(c)
}

// ===================================================== W3: THE FEEL PRESET
//
// What the user feels as "fast and smooth" is (1) the reaction in the SAME
// frame as the event, (2) short Fluent durations with a decelerating curve,
// (3) a per-state duration (press snaps, release flows back).
// `transreg_set_fluent` sets all three on a registry; App calls it.
fn transreg_set_lead(r: *mut TransReg, ms: i64) {
    if ms < 0 {
        (*r).lead = 0
    } else {
        (*r).lead = ms
    }
}

// Duration of ONE target state for every entry made AFTER this call.
fn transreg_set_state_duration(r: *mut TransReg, state: u32, ms: i64) {
    if (state as usize) >= style.STATE_COUNT {
        return
    }
    if ms < 0 {
        (*r).dstate[state as usize] = 0
    } else {
        (*r).dstate[state as usize] = ms
    }
}

fn transreg_set_fluent(r: *mut TransReg) {
    (*r).dur = DUR_HOVER
    (*r).ease = easing_fluent_decel()
    (*r).lead = FRAME_LEAD_MS
    (*r).dstate[style.STATE_NORMAL as usize] = DUR_FOCUS
    (*r).dstate[style.STATE_HOVER as usize] = DUR_HOVER
    (*r).dstate[style.STATE_ACTIVE as usize] = DUR_PRESS
    (*r).dstate[style.STATE_FOCUS as usize] = DUR_FOCUS
    (*r).dstate[style.STATE_DISABLED as usize] = DUR_HOVER
    (*r).dstate[style.STATE_SELECTED as usize] = DUR_FOCUS
}

// REDUCED MOTION (system setting, gap list #71): every new transition lasts 1 ms and has no lead-in, so a
// state change shows its END colour in the next frame. `transreg_set_fluent` brings the normal feel back.
// (The channel registry of `chan_f` takes its duration from the caller and is not changed here.)
fn transreg_set_reduced(r: *mut TransReg) {
    (*r).dur = 1
    (*r).lead = 0
    var i: usize = 0
    while i < 6 {
        (*r).dstate[i] = 1
        i = i + 1
    }
}

// true after `transreg_set_reduced` (until `transreg_set_fluent` / a new duration comes back): animations of the program (timelines)
// ask this to jump to their end instead of playing.
fn transreg_reduced(r: *mut TransReg) -> bool {
    return (*r).dur == 1 && (*r).lead == 0 && (*r).dstate[style.STATE_NORMAL as usize] == 1
}

// Ask the host for another frame (a painter running its own motion).
fn transreg_busy_mark(r: *mut TransReg) {
    (*r).dirty = 1
    (*r).unb = 1
}

// ============================================ W3: TWEEN, COLOR_TO, VALUE_TO
//
// ONE small state any control can own (or get from the channel registry):
// you say every frame WHERE YOU WANT TO BE, it glides there.
//
//     var k: anim.Tween = anim.tween_new()
//     let x: f64 = anim.value_to(&k, now, if on { 1.0 } else { 0.0 }, anim.DUR_FOCUS)
//     let col: u32 = anim.color_to(&bgt, now, target_color, anim.DUR_HOVER)
//     if anim.tween_busy(&k) { ... ask for another frame ... }
//
// The first call jumps to the target (no start-up animation). A new target
// starts from the CURRENT visible value (retargeting in mid-motion has no
// jump). Frame-rate independent: only `now` matters, never the call count.
struct Tween {
    f0: f64,
    f1: f64,
    c0: u32,
    c1: u32,
    t0: i64,
    dur: i64,
    p: f64,
    ease: Easing,
    init: u32,
}

fn tween_new() -> Tween {
    return Tween { f0: 0.0, f1: 0.0, c0: 0 as u32, c1: 0 as u32, t0: 0,
        dur: 1, p: 1.0, ease: easing_fluent_decel(), init: 0 as u32 }
}

fn tween_set_ease(s: *mut Tween, e: Easing) { (*s).ease = e }
fn tween_busy(s: *mut Tween) -> bool { return (*s).p < 1.0 }

fn tween_advance(s: *mut Tween, now_ms: i64) {
    if (*s).p >= 1.0 {
        return
    }
    let el: i64 = now_ms - (*s).t0
    if el >= (*s).dur {
        (*s).p = 1.0
        return
    }
    var roh: f64 = (el as f64) / ((*s).dur as f64)
    if roh < 0.0 {
        roh = 0.0
    }
    (*s).p = ease_eval(&(*s).ease, roh)
    if (*s).p >= 1.0 {
        (*s).p = 0.999999
    }
}

fn value_to(s: *mut Tween, now_ms: i64, target: f64, dur_ms: i64) -> f64 {
    if (*s).init == 0 as u32 {
        (*s).f0 = target
        (*s).f1 = target
        (*s).p = 1.0
        (*s).init = 1 as u32
        return target
    }
    if target != (*s).f1 {
        (*s).f0 = lerp((*s).f0, (*s).f1, (*s).p)
        (*s).f1 = target
        (*s).t0 = now_ms
        (*s).dur = dur_ms
        (*s).p = 0.0
        if dur_ms < 1 {
            (*s).p = 1.0
        }
    }
    tween_advance(s, now_ms)
    return lerp((*s).f0, (*s).f1, (*s).p)
}

fn color_to(s: *mut Tween, now_ms: i64, target: u32, dur_ms: i64) -> u32 {
    if (*s).init == 0 as u32 {
        (*s).c0 = target
        (*s).c1 = target
        (*s).p = 1.0
        (*s).init = 1 as u32
        return target
    }
    if target != (*s).c1 {
        (*s).c0 = mix_srgb((*s).c0, (*s).c1, (*s).p)
        (*s).c1 = target
        (*s).t0 = now_ms
        (*s).dur = dur_ms
        (*s).p = 0.0
        if dur_ms < 1 {
            (*s).p = 1.0
        }
    }
    tween_advance(s, now_ms)
    return mix_srgb((*s).c0, (*s).c1, (*s).p)
}

// ------------------------------------------------ the channels of a Ctx
//
// A control that paints from a bare Ctx has no place to keep a Tween. The
// registry bound to the Ctx keeps one per (key, channel id): `key` = the
// widget (chan_f_w/chan_color_w use the registry's own key path), `id` = what
// moves (1 = knob, 2 = check progress, 3 = thumb scale ...; the control picks).
// While a channel runs, the registry is dirty and the host paints again.
// Without a bound registry the target is returned at once (no motion).
const CHAN_MAX: usize = 48

fn chan_slot(r: *mut TransReg, now_ms: i64, key: u64, id: u32) -> *mut Tween {
    var i: usize = 0
    while i < (*r).ch_n {
        if (*r).ch_key[i] == key && (*r).ch_id[i] == id {
            (*r).ch_seen[i] = now_ms
            return &(*r).ch_tw[i]
        }
        i = i + 1
    }
    var j: usize = (*r).ch_n
    if j >= CHAN_MAX {
        var oldest: usize = CHAN_MAX
        var t0: i64 = now_ms - STALE_MS
        var k: usize = 0
        while k < CHAN_MAX {
            if (*r).ch_seen[k] < t0 {
                t0 = (*r).ch_seen[k]
                oldest = k
            }
            k = k + 1
        }
        if oldest >= CHAN_MAX {
            return 0 as *mut Tween
        }
        j = oldest
    } else {
        (*r).ch_n = j + 1
    }
    (*r).ch_key[j] = key
    (*r).ch_id[j] = id
    (*r).ch_seen[j] = now_ms
    (*r).ch_tw[j] = tween_new()
    return &(*r).ch_tw[j]
}

// A running channel asks for another frame. With bounds named (`chan_bounds`)
// only that rectangle is dirty; without, the whole window.
fn chan_mark(r: *mut TransReg) {
    (*r).dirty = 1
    if (*r).has_b != 0 as u32 {
        damage.dmg_add(&(*r).dm, (*r).bx0, (*r).by0, (*r).bx1, (*r).by1)
    } else {
        (*r).unb = 1
    }
}

// The control about to ask for channels says where it paints (ink rectangle,
// window pixels). Call `chan_bounds_end` when it is done.
fn chan_bounds(c: *mut render.Ctx, x0: f64, y0: f64, x1: f64, y1: f64) {
    let reg: u64 = render.ctx_anim_reg(c)
    if reg == 0 {
        return
    }
    let r: *mut TransReg = reg as *mut TransReg
    (*r).bx0 = x0
    (*r).by0 = y0
    (*r).bx1 = x1
    (*r).by1 = y1
    (*r).has_b = 1 as u32
}

fn chan_bounds_end(c: *mut render.Ctx) {
    let reg: u64 = render.ctx_anim_reg(c)
    if reg == 0 {
        return
    }
    (*(reg as *mut TransReg)).has_b = 0 as u32
}

fn chan_f(c: *mut render.Ctx, key: u64, id: u32, target: f64, dur_ms: i64) -> f64 {
    let reg: u64 = render.ctx_anim_reg(c)
    if reg == 0 {
        return target
    }
    let r: *mut TransReg = reg as *mut TransReg
    let now: i64 = render.ctx_time(c)
    let s: *mut Tween = chan_slot(r, now, key, id)
    if s as u64 == 0 {
        return target
    }
    let v: f64 = value_to(s, now, target, dur_ms)
    if tween_busy(s) {
        chan_mark(r)
    }
    return v
}

fn chan_color(c: *mut render.Ctx, key: u64, id: u32, target: u32, dur_ms: i64) -> u32 {
    let reg: u64 = render.ctx_anim_reg(c)
    if reg == 0 {
        return target
    }
    let r: *mut TransReg = reg as *mut TransReg
    let now: i64 = render.ctx_time(c)
    let s: *mut Tween = chan_slot(r, now, key, id)
    if s as u64 == 0 {
        return target
    }
    let v: u32 = color_to(s, now, target, dur_ms)
    if tween_busy(s) {
        chan_mark(r)
    }
    return v
}

// `wx` = the widget's address as a number (`e as u64`): the registry only
// derives a key from it and never keeps the pointer, and a number tells the
// escape check exactly that (a pointer argument would be reported as stored).
fn chan_f_w(c: *mut render.Ctx, wx: u64, id: u32, target: f64, dur_ms: i64) -> f64 {
    let reg: u64 = render.ctx_anim_reg(c)
    if reg == 0 {
        return target
    }
    return chan_f(c, transreg_key_u(reg as *mut TransReg, wx), id, target, dur_ms)
}

fn chan_color_w(c: *mut render.Ctx, wx: u64, id: u32, target: u32, dur_ms: i64) -> u32 {
    let reg: u64 = render.ctx_anim_reg(c)
    if reg == 0 {
        return target
    }
    return chan_color(c, transreg_key_u(reg as *mut TransReg, wx), id, target, dur_ms)
}

// ======================================== W3: FLING AND POINTER PREDICTION
//
// Scroll inertia with friction: the velocity decays exponentially,
// v(t) = v0 e^(-k t), so the position is x0 + v0/k (1 - e^(-k t)) and the
// total run-out is v0/k. Units: px, ms, k per ms (0.003 = a calm touchpad
// glide, 0.006 = brisk). Closed form: frame-rate independent by construction.
fn fling_pos(x0: f64, v0: f64, k: f64, t_ms: f64) -> f64 {
    if k <= 0.0 {
        return x0 + v0 * t_ms
    }
    return x0 + (v0 / k) * (1.0 - math.exp(0.0 - k * t_ms))
}

fn fling_vel(v0: f64, k: f64, t_ms: f64) -> f64 {
    return v0 * math.exp(0.0 - k * t_ms)
}

fn fling_total(v0: f64, k: f64) -> f64 {
    if k <= 0.0 {
        return 0.0
    }
    return v0 / k
}

// Pointer prediction: where will the pointer be `ahead_ms` from now, given
// its last two samples `dt_ms` apart. The speed is capped (a jump of the
// device must not fling the prediction across the screen) at 4 px/ms.
fn predict_ahead(prev: f64, cur: f64, dt_ms: i64, ahead_ms: i64) -> f64 {
    if dt_ms <= 0 {
        return cur
    }
    var v: f64 = (cur - prev) / (dt_ms as f64)
    if v > 4.0 {
        v = 4.0
    }
    if v < 0.0 - 4.0 {
        v = 0.0 - 4.0
    }
    return cur + v * (ahead_ms as f64)
}
