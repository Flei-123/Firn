import fui.editor
import fui.kit
import fui.render
import fui.screenax
import fui.viewport
import fui.widget

export {
    Grid, grid_new, set_count, count, set_cell, set_pad, layout, columns, rows, cell_w, cell_h, content_h,
    first, end_index, cell_rect, index_at, begin, finish, move, press, drag, release, wheel, pan, fling, tick, moving,
    key, scroll_by, select, selected, hovered, set_focus, has_focus, scroll_y, scroll_to, bar_dragging, viewport_of,
    NONE,
}

const NONE: usize = 18446744073709551615

struct Grid {
    n: usize,
    min_w: usize,
    h_pt: usize,
    gap_pt: usize,
    pad_pt: usize,
    cols: usize,
    nrows: usize,
    cw: f64,
    ch: f64,
    pad: f64,
    gap: f64,
    ctx: u64,
    vp: viewport.Viewport,
    sel: usize,
    hov: usize,
    foc: bool,
    kbd: bool,
    x: f64,
    y: f64,
    w: f64,
    h: f64,
}

fn grid_new() -> Grid {
    return Grid { n: 0, min_w: 240, h_pt: 148, gap_pt: 12, pad_pt: 16, cols: 1, nrows: 0, cw: 0.0, ch: 0.0, pad: 0.0, gap: 0.0, ctx: 0 as u64,
        vp: viewport.viewport_new(0.0, 0.0, 100.0, 100.0, 100.0, 100.0), sel: NONE, hov: NONE, foc: false, kbd: false,
        x: 0.0, y: 0.0, w: 0.0, h: 0.0 }
}

fn set_count(g: *mut Grid, n: usize) {
    (*g).n = n
    if (*g).sel != NONE && (*g).sel >= n { (*g).sel = NONE }
    if (*g).hov != NONE && (*g).hov >= n { (*g).hov = NONE }
}

fn count(g: *mut Grid) -> usize { return (*g).n }

fn set_cell(g: *mut Grid, min_w_pt: usize, h_pt: usize, gap_pt: usize) {
    (*g).min_w = min_w_pt
    (*g).h_pt = h_pt
    (*g).gap_pt = gap_pt
}

fn set_pad(g: *mut Grid, pad_pt: usize) { (*g).pad_pt = pad_pt }

fn viewport_of(g: *mut Grid) -> *mut viewport.Viewport { return &(*g).vp }

fn columns(g: *mut Grid) -> usize { return (*g).cols }
fn rows(g: *mut Grid) -> usize { return (*g).nrows }
fn cell_w(g: *mut Grid) -> f64 { return (*g).cw }
fn cell_h(g: *mut Grid) -> f64 { return (*g).ch }
fn selected(g: *mut Grid) -> usize { return (*g).sel }
fn hovered(g: *mut Grid) -> usize { return (*g).hov }
fn scroll_y(g: *mut Grid) -> f64 { return viewport.viewport_off_y(&(*g).vp) }
fn content_h(g: *mut Grid) -> f64 { return viewport.viewport_content_h(&(*g).vp) }

fn fit(g: *mut Grid, inner: f64, min_w: f64) -> usize {
    let q: f64 = (inner - (*g).pad * 2.0 + (*g).gap) / (min_w + (*g).gap)
    if q < 1.0 { return 1 }
    return q as usize
}

fn apply_columns(g: *mut Grid, inner: f64, cols: usize) {
    (*g).cols = cols
    (*g).cw = (inner - (*g).pad * 2.0 - (*g).gap * ((cols - 1) as f64)) / (cols as f64)
    (*g).nrows = ((*g).n + cols - 1) / cols
    var total: f64 = (*g).pad * 2.0
    if (*g).nrows > 0 { total = total + (*g).ch * ((*g).nrows as f64) + (*g).gap * (((*g).nrows - 1) as f64) }
    viewport.viewport_set_content(&(*g).vp, inner, total)
}

fn layout(g: *mut Grid, c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64) {
    (*g).ctx = c as u64
    (*g).x = x
    (*g).y = y
    (*g).w = w
    (*g).h = h
    (*g).pad = kit.ln(c, (*g).pad_pt)
    (*g).gap = kit.ln(c, (*g).gap_pt)
    (*g).ch = kit.ln(c, (*g).h_pt)
    let min_w: f64 = kit.ln(c, (*g).min_w)
    viewport.viewport_set_bar(&(*g).vp, kit.ln(c, 12) as usize)
    viewport.viewport_set_rect(&(*g).vp, x, y, w, h)
    apply_columns(g, w, fit(g, w, min_w))
    let inner: f64 = viewport.viewport_inner_w(&(*g).vp)
    if inner != w { apply_columns(g, inner, fit(g, inner, min_w)) }
}

fn first(g: *mut Grid) -> usize {
    let stride: f64 = (*g).ch + (*g).gap
    var r: f64 = (viewport.viewport_off_y(&(*g).vp) - (*g).pad) / stride
    if r < 0.0 { r = 0.0 }
    return (r as usize) * (*g).cols
}

fn end_index(g: *mut Grid) -> usize {
    let stride: f64 = (*g).ch + (*g).gap
    let bottom: f64 = viewport.viewport_off_y(&(*g).vp) + (*g).h - (*g).pad
    var r: f64 = bottom / stride
    if r < 0.0 { r = 0.0 }
    var e: usize = ((r as usize) + 1) * (*g).cols
    if e > (*g).n { e = (*g).n }
    return e
}

fn cell_rect(g: *mut Grid, i: usize, out: *mut [f64; 4]) {
    let col: usize = i % (*g).cols
    let row: usize = i / (*g).cols
    (*out)[0] = (*g).x + (*g).pad + ((*g).cw + (*g).gap) * (col as f64)
    (*out)[1] = viewport.viewport_content_y(&(*g).vp) + (*g).pad + ((*g).ch + (*g).gap) * (row as f64)
    (*out)[2] = (*g).cw
    (*out)[3] = (*g).ch
}

fn index_at(g: *mut Grid, px: f64, py: f64) -> usize {
    var cx: f64 = 0.0
    var cy: f64 = 0.0
    if !viewport.viewport_hit(&(*g).vp, px, py, &cx, &cy) { return NONE }
    let ux: f64 = cx - (*g).pad
    let uy: f64 = cy - (*g).pad
    if ux < 0.0 || uy < 0.0 { return NONE }
    let sx: f64 = (*g).cw + (*g).gap
    let sy: f64 = (*g).ch + (*g).gap
    let col: usize = (ux / sx) as usize
    let row: usize = (uy / sy) as usize
    if col >= (*g).cols { return NONE }
    if ux - (col as f64) * sx >= (*g).cw { return NONE }
    if uy - (row as f64) * sy >= (*g).ch { return NONE }
    let i: usize = row * (*g).cols + col
    if i >= (*g).n { return NONE }
    return i
}

fn begin(g: *mut Grid, c: *mut render.Ctx, name: str) -> bool {
    var f: u32 = 0 as u32
    if (*g).foc { f = screenax.F_FOCUS }
    screenax.note(widget.KIND_LIST, f, name, (*g).x, (*g).y, (*g).w, (*g).h, (*g).n as i64)
    return viewport.viewport_begin(c, &(*g).vp)
}

fn finish(g: *mut Grid, c: *mut render.Ctx) {
    viewport.viewport_end(c, &(*g).vp)
    viewport.viewport_draw_bars(c, &(*g).vp)
}

fn move(g: *mut Grid, px: f64, py: f64) -> bool {
    let h: usize = index_at(g, px, py)
    if h == (*g).hov { return false }
    (*g).hov = h
    return true
}

fn select(g: *mut Grid, i: usize) {
    if i != NONE && i >= (*g).n { return }
    (*g).sel = i
}

fn set_focus(g: *mut Grid, on: bool, by_key: bool) {
    (*g).foc = on
    (*g).kbd = on && by_key
}

fn has_focus(g: *mut Grid) -> bool { return (*g).foc }

fn reveal(g: *mut Grid, i: usize) {
    if i == NONE || i >= (*g).n { return }
    let col: usize = i % (*g).cols
    let row: usize = i / (*g).cols
    let rx: f64 = (*g).pad + ((*g).cw + (*g).gap) * (col as f64)
    let ry: f64 = (*g).pad + ((*g).ch + (*g).gap) * (row as f64)
    viewport.viewport_ensure_visible(&(*g).vp, rx, ry - (*g).pad, (*g).cw, (*g).ch + (*g).pad * 2.0)
}

fn scroll_to(g: *mut Grid, i: usize) { reveal(g, i) }

fn scroll_by(g: *mut Grid, dy: f64) { viewport.viewport_scroll_by(&(*g).vp, 0.0, dy) }

fn press(g: *mut Grid, x: f64, y: f64) -> usize {
    let c: *mut render.Ctx = (*g).ctx as *mut render.Ctx
    if viewport.viewport_bar_press(c, &(*g).vp, x, y) { return NONE }
    let i: usize = index_at(g, x, y)
    if viewport.viewport_bar_hit(&(*g).vp, x, y) != viewport.VP_BAR_NONE { return NONE }
    (*g).foc = true
    (*g).kbd = false
    if i != NONE { (*g).sel = i }
    return i
}

fn drag(g: *mut Grid, x: f64, y: f64) -> bool {
    let c: *mut render.Ctx = (*g).ctx as *mut render.Ctx
    return viewport.viewport_bar_drag(c, &(*g).vp, x, y)
}

fn release(g: *mut Grid) { viewport.viewport_bar_release(&(*g).vp) }
fn bar_dragging(g: *mut Grid) -> bool { return viewport.viewport_bar_dragging(&(*g).vp) != viewport.VP_BAR_NONE }

fn wheel(g: *mut Grid, notches: f64, now_ms: i64) {
    viewport.viewport_scroll_smooth(&(*g).vp, 0.0, notches * viewport.VP_WHEEL_STEP, now_ms)
}

fn pan(g: *mut Grid, dy: f64, now_ms: i64) {
    viewport.viewport_drag(&(*g).vp, 0.0, 0.0 - dy, now_ms)
}

fn fling(g: *mut Grid, vy_per_s: f64, now_ms: i64) {
    let c: *mut render.Ctx = (*g).ctx as *mut render.Ctx
    viewport.viewport_fling_android(&(*g).vp, 0.0, 0.0 - vy_per_s / 1000.0, now_ms, kit.ln(c, 160))
}

fn tick(g: *mut Grid, now_ms: i64) -> bool { return viewport.viewport_tick(&(*g).vp, now_ms) }
fn moving(g: *mut Grid) -> bool { return viewport.viewport_moving(&(*g).vp) }

fn step_to(g: *mut Grid, i: usize) -> bool {
    if (*g).n == 0 { return false }
    var t: usize = i
    if t >= (*g).n { t = (*g).n - 1 }
    if t == (*g).sel { return false }
    (*g).sel = t
    (*g).kbd = true
    reveal(g, t)
    return true
}

fn page_rows(g: *mut Grid) -> usize {
    var r: usize = ((*g).h / ((*g).ch + (*g).gap)) as usize
    if r < 1 { r = 1 }
    return r
}

fn key(g: *mut Grid, code: u32, mods: u32) -> bool {
    if (*g).n == 0 { return false }
    let cur: usize = (*g).sel
    if cur == NONE {
        if code == editor.KEY_DOWN || code == editor.KEY_RIGHT || code == editor.KEY_HOME || code == editor.KEY_PGDN {
            return step_to(g, first(g))
        }
        if code == editor.KEY_END { return step_to(g, (*g).n - 1) }
        return false
    }
    if code == editor.KEY_RIGHT { return step_to(g, cur + 1) }
    if code == editor.KEY_LEFT {
        if cur == 0 { return false }
        return step_to(g, cur - 1)
    }
    if code == editor.KEY_DOWN {
        var t: usize = cur + (*g).cols
        if t >= (*g).n {
            if cur / (*g).cols == ((*g).n - 1) / (*g).cols { return false }
            t = (*g).n - 1
        }
        return step_to(g, t)
    }
    if code == editor.KEY_UP {
        if cur < (*g).cols { return false }
        return step_to(g, cur - (*g).cols)
    }
    if code == editor.KEY_HOME { return step_to(g, 0) }
    if code == editor.KEY_END { return step_to(g, (*g).n - 1) }
    if code == editor.KEY_PGDN { return step_to(g, cur + page_rows(g) * (*g).cols) }
    if code == editor.KEY_PGUP {
        let d: usize = page_rows(g) * (*g).cols
        if cur < d { return step_to(g, cur % (*g).cols) }
        return step_to(g, cur - d)
    }
    return false
}
