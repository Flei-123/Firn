// SPDX-License-Identifier: MPL-2.0
// lib/fui/kitform.fi -- THE PARTS OF A FORM / WIZARD on top of lib/fui/kit.fi.
//
// Immediate mode like kit.fi: the app keeps the state, `*_draw` paints it.
//
//   field_new / field_draw / field_press   a labelled text field with an error line (editor inside)
//   field_text                             the text of a field as a str
//   steps_draw                             numbered step header ("Person|Address|...") + progress bar
//   check                                  validate a text: REQ, EMAIL, ZIP, CARD (Luhn), EXP (MM/YY) -> "" or a message
//   nth                                    the i-th part of "a|b|c"
//
//     let f: *mut kit.Search = kitform.field_new()
//     let h: f64 = kitform.field_draw(c, f, x, y, w, "Email", "you@example.com", kitform.check(kitform.EMAIL, kitform.field_text(f)), focused)
import std.rt
import fui.kit
import fui.kitapp
import fui.editor
import fui.lucide
import fui.painter
import fui.render
import fui.screenanim
import fui.style
import fui.widget

const REQ: u32 = 0
const EMAIL: u32 = 1
const ZIP: u32 = 2
const CARD: u32 = 3
const EXP: u32 = 4

fn size_of_search() -> usize {
    var probe: [kit.Search; 2] = [kit.search_new(), kit.search_new()]
    let n: usize = ((&probe[1]) as usize) - ((&probe[0]) as usize)
    kit.search_free(&probe[0])
    kit.search_free(&probe[1])
    return n
}

// A field on the heap (lives as long as the program).
fn field_new() -> *mut kit.Search {
    let f: *mut kit.Search = rt.heap_alloc(size_of_search()) as *mut kit.Search
    *f = kit.search_new()
    return f
}

fn field_text(f: *mut kit.Search) -> str {
    return str { p: kit.search_text_ptr(f) as *mut u8, n: kit.search_text_len(f) }
}

// the text field's widget: 12 pt side padding, 8 pt corners
fn field_widget(c: *mut render.Ctx, f: *mut kit.Search, x: f64, y: f64, w: f64, h: f64) -> widget.Widget {
    var e: widget.Widget = widget.widget_new(widget.KIND_TEXTBOX)
    widget.w_place(&e, x, y, w, h)
    var st: style.Style = style.style_new()
    st = style.style_set_pad(st, 12, 8)
    st = style.style_set_radius(st, 8)
    widget.w_set_style(&e, st)
    widget.w_set_focus(&e, kit.search_has_focus(f))
    return e
}

// kit.ST_HOVER when the pointer (px, py) is inside the box, else 0
fn hover(px: f64, py: f64, x: f64, y: f64, w: f64, h: f64) -> u32 {
    if px >= x && px < x + w && py >= y && py < y + h { return kit.ST_HOVER }
    return 0 as u32
}

// The bare field: a 38 pt text box at (x, y) with the hint while empty and unfocused, a red ring when `err` is set.
fn field_box(c: *mut render.Ctx, f: *mut kit.Search, x: f64, y: f64, w: f64, h: f64, hint: str, err: bool, caret: bool) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    var e: widget.Widget = field_widget(c, f, x, y, w, h)
    render.draw_textfield(c, &e, &(*f).ed, caret && screenanim.caret_on(c, &(*f).ed, kit.search_has_focus(f)))
    if kit.search_text_len(f) == 0 && !kit.search_has_focus(f) {
        kit.draw_label(c, x + kit.ln(c, 12), y, h, kit.ln(c, 14), 400, kit.with_alpha(kit.tokc(c, style.TOK_TEXT_MUTED), 110 as u32), hint, w - kit.ln(c, 24))
    }
    if err { painter.round_ring(z, x, y, w, h, kit.ln(c, 8), kit.ln(c, 2), kit.tokc(c, style.TOK_ERROR)) }
}

// Label (12 pt, bold, muted) above a 38 pt field, the error (red, 11 pt) or nothing below it.
// Returns the height of the block (82 pt).
fn field_draw(c: *mut render.Ctx, f: *mut kit.Search, x: f64, y: f64, w: f64, label: str, hint: str, err: str, caret: bool) -> f64 {
    kit.draw_label(c, x, y, kit.ln(c, 18), kit.ln(c, 12), 700, kit.tokc(c, style.TOK_TEXT_MUTED), label, 0.0)
    let fy: f64 = y + kit.ln(c, 22)
    field_box(c, f, x, fy, w, kit.ln(c, 38), hint, err.n > 0, caret)
    if err.n > 0 { kit.draw_label(c, x + kit.ln(c, 2), fy + kit.ln(c, 40), kit.ln(c, 16), kit.ln(c, 11), 400, kit.tokc(c, style.TOK_ERROR), err, w) }
    return kit.ln(c, 82)
}

// A press on a bare field drawn by field_box at (x, y, w, h): focus + caret. true = hit.
fn field_box_press(c: *mut render.Ctx, f: *mut kit.Search, x: f64, y: f64, w: f64, h: f64, px: f64, py: f64, now_us: u64) -> bool {
    return kit.search_press(c, f, x, y, w, h, px, py, now_us) != kit.SEARCH_HIT_NONE
}

// A press at (px, py) on the field drawn by field_draw at (x, y, w): focus + caret. true = hit.
fn field_press(c: *mut render.Ctx, f: *mut kit.Search, x: f64, y: f64, w: f64, px: f64, py: f64, now_us: u64) -> bool {
    return field_box_press(c, f, x, y + kit.ln(c, 22), w, kit.ln(c, 38), px, py, now_us)
}

// the i-th part of "a|b|c" ("" if there is none)
fn nth(s: str, i: usize) -> str {
    var k: usize = 0
    var a: usize = 0
    var j: usize = 0
    while j <= s.n {
        if j == s.n || rt.ld8(s.p as u64, j) == 124 as u8 {
            if k == i { return str { p: (s.p as u64 + a as u64) as *mut u8, n: j - a } }
            k = k + 1
            a = j + 1
        }
        j = j + 1
    }
    return str { p: s.p, n: 0 }
}

// Step header: numbered discs (done = check, current = accent, later = outline) with their names,
// spread over `w`, and a progress bar under them. `labels` = "Person|Address|Payment|Summary".
#[allow_escape]
fn steps_draw(c: *mut render.Ctx, x: f64, y: f64, w: f64, labels: str, n: usize, cur: usize) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let d: f64 = kit.ln(c, 28)
    var tot: f64 = 0.0
    var i: usize = 0
    while i < n {
        tot = tot + d + kit.ln(c, 8) + kit.text_width(c, kit.ln(c, 14), 700, nth(labels, i))
        i = i + 1
    }
    let short: bool = tot > w
    if short {
        tot = 0.0
        i = 0
        while i < n {
            tot = tot + d
            if i == cur { tot = tot + kit.ln(c, 8) + kit.text_width(c, kit.ln(c, 14), 700, nth(labels, i)) }
            i = i + 1
        }
    }
    let gap: f64 = (w - tot) / ((n - 1) as f64)
    var px: f64 = x
    i = 0
    while i < n {
        let name: str = nth(labels, i)
        if i < cur {
            painter.round_rect(z, px, y, d, d, d / 2.0, kit.with_alpha(kit.tokc(c, style.TOK_ACCENT), 60 as u32))
            kit.sym(c, lucide.CHECK, px + kit.ln(c, 6), y + kit.ln(c, 6), kit.ln(c, 16), kit.accent_gfx(c, style.TOK_SURFACE))
        } else if i == cur {
            painter.round_rect(z, px, y, d, d, d / 2.0, kit.tokc(c, style.TOK_ACCENT))
        } else {
            painter.round_rect(z, px, y, d, d, d / 2.0, kit.tokc(c, style.TOK_BUTTON))
            painter.round_ring(z, px, y, d, d, d / 2.0, kit.ln(c, 1), kit.tokc(c, style.TOK_BORDER))
        }
        if i >= cur {
            var num: [u8; 24] = [0 as u8; 24]
            let nl: usize = kit.fmt_uint((i + 1) as u64, &num)
            var col: u32 = kit.tokc(c, style.TOK_TEXT_MUTED)
            if i == cur { col = kit.tokc(c, style.TOK_TEXT_ON_ACCENT) }
            let nw: f64 = kit.text_width(c, kit.ln(c, 12), 700, str { p: (&num[0]) as *mut u8, n: nl })
            kit.draw_label(c, px + (d - nw) / 2.0, y, d, kit.ln(c, 12), 700, col, str { p: (&num[0]) as *mut u8, n: nl }, 0.0)
        }
        var tc: u32 = kit.tokc(c, style.TOK_TEXT_MUTED)
        if i == cur { tc = kit.tokc(c, style.TOK_TEXT) }
        if short && i != cur {
            px = px + d + gap
        } else {
            let tw: f64 = kit.draw_label(c, px + d + kit.ln(c, 8), y, d, kit.ln(c, 14), 700, tc, name, 0.0)
            px = px + d + kit.ln(c, 8) + tw + gap
        }
        i = i + 1
    }
    kit.progress_draw(c, x, y + d + kit.ln(c, 12), w, kit.ln(c, 4), (((cur + 1) * 1000) / n) as i64, "", 0, kit.PB_NORMAL)
}

fn digits(s: str) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < s.n {
        let b: u8 = rt.ld8(s.p as u64, i)
        if b >= 48 as u8 && b <= 57 as u8 { n = n + 1 }
        i = i + 1
    }
    return n
}

fn luhn(s: str) -> bool {
    var sum: usize = 0
    var dbl: bool = false
    var i: usize = s.n
    while i > 0 {
        i = i - 1
        let b: u8 = rt.ld8(s.p as u64, i)
        if b >= 48 as u8 && b <= 57 as u8 {
            var v: usize = (b - 48 as u8) as usize
            if dbl {
                v = v * 2
                if v > 9 { v = v - 9 }
            }
            sum = sum + v
            dbl = !dbl
        }
    }
    return sum % 10 == 0
}

// Validate `s` against a rule (REQ, EMAIL, ZIP, CARD, EXP). "" = fine, else the message.
fn check(kind: u32, s: str) -> str {
    if s.n == 0 { return "Required" }
    if kind == EMAIL {
        var at: usize = s.n
        var dot: bool = false
        var i: usize = 0
        while i < s.n {
            let b: u8 = rt.ld8(s.p as u64, i)
            if b == 64 as u8 && at == s.n { at = i }
            if b == 46 as u8 && at < s.n && i > at + 1 && i + 1 < s.n { dot = true }
            i = i + 1
        }
        if at == 0 || at == s.n || !dot { return "Enter a valid email, e.g. you@example.com" }
    }
    if kind == ZIP && (digits(s) != s.n || (s.n != 4 && s.n != 5)) { return "ZIP: 4 or 5 digits" }
    if kind == CARD && (digits(s) < 13 || digits(s) > 19 || !luhn(s)) { return "Card number is not valid" }
    if kind == EXP {
        if s.n != 5 || rt.ld8(s.p as u64, 2) != 47 as u8 || digits(s) != 4 { return "Use MM/YY" }
        let mm: usize = (rt.ld8(s.p as u64, 0) as usize) * 10 + (rt.ld8(s.p as u64, 1) as usize) - 528
        if mm < 1 || mm > 12 { return "Use MM/YY" }
    }
    return ""
}

// ====================================================================
// WIZARD: steps of PER fields each, then a summary step. The app gives strings only:
//   steps "Person|Address|Payment|Summary", labels / hints / keys of the fields "a|b|c|...",
//   width = one digit per field (quarters of the row: "224" = two halves, then a full row),
//   kind = one digit per field (REQ, EMAIL, ZIP, CARD, EXP).
// Next validates the step (errors show under the fields), Back goes back, Tab / Enter / mouse work.
//
//   let z: *mut kitform.Wiz = kitform.wiz_new(steps, labels, hints, width, kind)
//   screen.run_text(start, "Form", 1100, 700, z as u64, kitform.wiz_paint, kitform.wiz_press, kitform.wiz_key, kitform.wiz_text, skin)
// ====================================================================

const PER: usize = 3

struct Wiz {
    f: [u64; 12],
    r: [f64; 48],
    n: usize,
    step: usize,
    show: bool,
    done: bool,
    ctx: u64,
    now: u64,
    steps: str,
    labels: str,
    hints: str,
    width: str,
    kind: str,
}

fn parts(s: str) -> usize {
    var n: usize = 1
    var i: usize = 0
    while i < s.n {
        if rt.ld8(s.p as u64, i) == 124 as u8 { n = n + 1 }
        i = i + 1
    }
    return n
}

fn wiz_new(steps: str, labels: str, hints: str, width: str, kind: str) -> *mut Wiz {
    let z: *mut Wiz = rt.heap_alloc(1 << 12) as *mut Wiz
    (*z).n = parts(labels)
    (*z).step = 0
    (*z).show = false
    (*z).done = false
    (*z).steps = steps
    (*z).labels = labels
    (*z).hints = hints
    (*z).width = width
    (*z).kind = kind
    var i: usize = 0
    while i < (*z).n {
        (*z).f[i] = field_new() as u64
        i = i + 1
    }
    return z
}

fn wf(z: *mut Wiz, i: usize) -> *mut kit.Search { return (*z).f[i] as *mut kit.Search }
fn dig(s: str, i: usize) -> usize { return (rt.ld8(s.p as u64, i) - 48 as u8) as usize }
fn bad(z: *mut Wiz, i: usize) -> str { return check(dig((*z).kind, i) as u32, field_text(wf(z, i))) }

fn unfocus(z: *mut Wiz) {
    var i: usize = 0
    while i < (*z).n {
        kit.search_focus(wf(z, i), false)
        i = i + 1
    }
}

// the field at position k of the current step that has the focus (PER = none)
fn focused(z: *mut Wiz) -> usize {
    var i: usize = 0
    while i < PER && (*z).step < (*z).n / PER {
        if kit.search_has_focus(wf(z, (*z).step * PER + i)) { return i }
        i = i + 1
    }
    return PER
}

fn wiz_next(z: *mut Wiz) {
    if (*z).step == (*z).n / PER { (*z).done = true; return }
    var k: usize = 0
    while k < PER {
        if bad(z, (*z).step * PER + k).n > 0 { (*z).show = true; return }
        k = k + 1
    }
    (*z).step = (*z).step + 1
    (*z).show = false
    unfocus(z)
}

fn wiz_summary(c: *mut render.Ctx, z: *mut Wiz, x: f64, y0: f64, w: f64, stacked: bool) {
    var gw: f64 = (w - kit.ln(c, 24)) / 3.0
    var dx: f64 = gw + kit.ln(c, 12)
    var dy: f64 = 0.0
    var done_y: f64 = kit.ln(c, 160)
    if stacked {
        gw = w
        dx = 0.0
        dy = kit.ln(c, 162)
        done_y = kit.ln(c, 3 * 162)
    }
    var g: usize = 0
    while g < (*z).n / PER {
        let gx: f64 = x + dx * (g as f64)
        let y: f64 = y0 + dy * (g as f64)
        kitapp.card_draw(c, gx, y, gw, kit.ln(c, 150), false)
        kitapp.text(c, gx + kit.ln(c, 14), y + kit.ln(c, 10), kit.ln(c, 22), 14, 700, style.TOK_ACCENT, nth((*z).steps, g))
        var k: usize = 0
        while k < PER {
            let i: usize = g * PER + k
            kitapp.text(c, gx + kit.ln(c, 14), y + kit.ln(c, 40) + kit.ln(c, 36) * (k as f64), kit.ln(c, 14), 11, 400, style.TOK_TEXT_MUTED, nth((*z).labels, i))
            kitapp.text(c, gx + kit.ln(c, 14), y + kit.ln(c, 54) + kit.ln(c, 36) * (k as f64), kit.ln(c, 18), 13, 400, style.TOK_TEXT, field_text(wf(z, i)))
            k = k + 1
        }
        g = g + 1
    }
    if (*z).done { kitapp.text(c, x, y0 + done_y, kit.ln(c, 24), 14, 700, style.TOK_SUCCESS, "Submitted - thank you!") }
}

fn wiz_bottom(c: *mut render.Ctx, z: *mut Wiz, ns: usize) -> f64 {
    if (*z).step == ns { return kit.ln(c, 130 + 3 * 162 + 34) }
    return kit.ln(c, 130 + 82 * PER)
}

// screen.run_text paint hook: a 640 x 430 card centred in the window; on a narrow window a full-width card with one field per row
fn wiz_paint(ud: u64, c: *mut render.Ctx, w: f64, h: f64, px: f64, py: f64) {
    let z: *mut Wiz = ud as *mut Wiz
    (*z).ctx = c as u64
    let ns: usize = (*z).n / PER
    let nr: bool = kit.narrow(c, w)
    var cw: f64 = kit.ln(c, 640)
    var ch: f64 = kit.ln(c, 430)
    var x: f64 = (w - cw) / 2.0
    var y: f64 = (h - ch) / 2.0
    var pad: f64 = kit.ln(c, 36)
    if nr {
        cw = w - kit.ln(c, 24)
        ch = wiz_bottom(c, z, ns) + kit.ln(c, 86)
        x = kit.ln(c, 12)
        y = kit.ln(c, 12)
        pad = kit.ln(c, 20)
    }
    let ix: f64 = x + pad
    let iw: f64 = cw - pad * 2.0
    kit.soft_shadow_under(c, x, y, cw, ch, kit.ln(c, 12), kit.ln(c, 40), kit.ln(c, 10), 200)
    kitapp.card_draw(c, x, y, cw, ch, false)
    steps_draw(c, ix, y + kit.ln(c, 30), iw, (*z).steps, ns + 1, (*z).step)
    kitapp.text(c, ix, y + kit.ln(c, 90), kit.ln(c, 32), 22, 700, style.TOK_TEXT, nth((*z).steps, (*z).step))
    let unit: f64 = (iw + kit.ln(c, 16)) / 4.0
    var col: usize = 0
    var fy: f64 = y + kit.ln(c, 130)
    var k: usize = 0
    while k < PER && (*z).step < ns {
        let i: usize = (*z).step * PER + k
        var q: usize = dig((*z).width, i)
        if nr { q = 4 }
        if col + q > 4 { col = 0; fy = fy + kit.ln(c, 82) }
        (*z).r[i * 3] = ix + unit * (col as f64)
        (*z).r[i * 3 + 1] = fy
        (*z).r[i * 3 + 2] = unit * (q as f64) - kit.ln(c, 16)
        var e: str = ""
        if (*z).show { e = bad(z, i) }
        field_draw(c, wf(z, i), (*z).r[i * 3], fy, (*z).r[i * 3 + 2], nth((*z).labels, i), nth((*z).hints, i), e, true)
        col = col + q
        k = k + 1
    }
    if (*z).step == ns { wiz_summary(c, z, ix, y + kit.ln(c, 130), iw, nr) }
    let by: f64 = y + ch - kit.ln(c, 74)
    (*z).r[36] = ix
    (*z).r[37] = by
    (*z).r[38] = kit.ln(c, 92)
    (*z).r[39] = kit.ln(c, 38)
    (*z).r[40] = ix + iw - kit.ln(c, 92)
    var back: u32 = hover(px, py, ix, by, (*z).r[38], (*z).r[39])
    if (*z).step == 0 { back = kit.ST_DISABLED }
    kit.button_draw(c, ix, by, (*z).r[38], (*z).r[39], "Back", kit.ICON_NONE, kit.BTN_SECONDARY, back)
    var lab: str = "Next"
    if (*z).step == ns { lab = "Submit" }
    kit.button_draw(c, (*z).r[40], by, (*z).r[38], (*z).r[39], lab, kit.ICON_NONE, kit.BTN_PRIMARY, hover(px, py, (*z).r[40], by, (*z).r[38], (*z).r[39]))
}

fn wiz_press(ud: u64, x: f64, y: f64) {
    let z: *mut Wiz = ud as *mut Wiz
    let c: *mut render.Ctx = (*z).ctx as *mut render.Ctx
    (*z).now = (*z).now + 1000000
    if hover(x, y, (*z).r[36], (*z).r[37], (*z).r[38], (*z).r[39]) != 0 as u32 && (*z).step > 0 {
        (*z).step = (*z).step - 1
        (*z).show = false
        unfocus(z)
    }
    if hover(x, y, (*z).r[40], (*z).r[37], (*z).r[38], (*z).r[39]) != 0 as u32 { wiz_next(z) }
    var k: usize = 0
    while k < PER && (*z).step < (*z).n / PER {
        let i: usize = (*z).step * PER + k
        kit.search_focus(wf(z, i), false)
        field_press(c, wf(z, i), (*z).r[i * 3], (*z).r[i * 3 + 1], (*z).r[i * 3 + 2], x, y, (*z).now)
        k = k + 1
    }
}

fn wiz_key(ud: u64, k: u32, mods: u32) -> bool {
    let z: *mut Wiz = ud as *mut Wiz
    if k == editor.KEY_ENTER { wiz_next(z); return true }
    let cur: usize = focused(z)
    if cur == PER { return false }
    let i: usize = (*z).step * PER + cur
    if k == editor.KEY_TAB {
        kit.search_focus(wf(z, i), false)
        kit.search_focus(wf(z, (*z).step * PER + (cur + 1) % PER), true)
        return true
    }
    return kit.search_key(wf(z, i), k, mods) != editor.RES_PASS
}

fn wiz_text(ud: u64, cp: u32, mods: u32) -> bool {
    let z: *mut Wiz = ud as *mut Wiz
    let cur: usize = focused(z)
    if cur == PER { return false }
    kit.search_char(wf(z, (*z).step * PER + cur), cp, mods)
    return true
}
