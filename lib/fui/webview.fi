import std.rt
import std.core
import fui.editor
import fui.painter
import fui.uiimage
import fui.webview_types

export {
    WebView, webview_new, webview_open, webview_close, webview_load, webview_resize, webview_tick,
    webview_pointer, webview_wheel, webview_key, webview_char, webview_char_mods, webview_preedit, webview_commit,
    webview_focus, webview_reply, webview_on_nav, webview_on_service, webview_on_spot, webview_set_perms,
    webview_draw, webview_wait_ms,
    webview_state, webview_title, webview_hover, webview_scroll, webview_doc_height, webview_cursor,
    webview_frames, webview_size, webview_focused, webview_preediting, webview_caret, webview_has_caret, webview_caps,
    webview_perms, webview_last_nav, webview_overflows, webview_pixels, webview_damage,
}

const FAILED_FILL: u32 = 4281545523

struct WebView {
    be: webview_types.Backend,
    state: u32,
    created: bool,
    w: u32,
    h: u32,
    scale: u32,
    want_w: u32,
    want_h: u32,
    resize_pending: bool,
    force_paint: bool,
    buf: u64,
    cap: usize,
    img: uiimage.Image,
    damage: webview_types.DamageRect,
    focused: bool,
    preedit_on: bool,
    perms: u32,
    nav: fn(u64, u64, usize) -> u32,
    nav_ud: u64,
    svc: fn(u64, *mut webview_types.Event),
    svc_ud: u64,
    spot: fn(u64, f64, f64, f64),
    spot_ud: u64,
    cursor: u32,
    scroll: u32,
    doc_h: u32,
    frames: u64,
    overflows: u32,
    caret: webview_types.Rect,
    has_caret: bool,
    title: rt.Buf,
    hover: rt.Buf,
    last_nav: rt.Buf,
    ev: webview_types.Event,
    inp: webview_types.Input,
}

fn nav_deny(ud: u64, p: u64, n: usize) -> u32 { return webview_types.NAV_DENY }
fn svc_none(ud: u64, ev: *mut webview_types.Event) {}
fn spot_none(ud: u64, x: f64, y: f64, h: f64) {}

fn webview_new() -> WebView {
    return WebView {
        be: webview_types.backend_null(), state: webview_types.ST_NEW, created: false, w: 0, h: 0, scale: 1000, want_w: 0, want_h: 0,
        resize_pending: false, force_paint: false, buf: 0, cap: 0, img: uiimage.image_new(),
        damage: webview_types.DamageRect { x: 0, y: 0, w: 0, h: 0 }, focused: false, preedit_on: false, perms: 0,
        nav: nav_deny, nav_ud: 0, svc: svc_none, svc_ud: 0, spot: spot_none, spot_ud: 0,
        cursor: 0, scroll: 0, doc_h: 0, frames: 0, overflows: 0,
        caret: webview_types.Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 }, has_caret: false,
        title: rt.buf_new(), hover: rt.buf_new(), last_nav: rt.buf_new(),
        ev: webview_types.event_new(), inp: webview_types.input_new(),
    }
}

fn alive(wv: *mut WebView) -> bool {
    return (*wv).state == webview_types.ST_LOADING || (*wv).state == webview_types.ST_READY
}

fn fail(wv: *mut WebView) {
    (*wv).state = webview_types.ST_FAILED
}

fn alloc_surface(wv: *mut WebView, w: u32, h: u32) -> bool {
    if (*wv).buf != 0 {
        rt.heap_free((*wv).buf, (*wv).cap)
        (*wv).buf = 0
        (*wv).cap = 0
    }
    let cap: usize = (w as usize) * (h as usize) * 4
    let p: u64 = rt.heap_alloc(cap)
    if p == 0 {
        return false
    }
    rt.mem_set(p, 0 as u8, cap)
    (*wv).buf = p
    (*wv).cap = cap
    (*wv).w = w
    (*wv).h = h
    (*wv).img = uiimage.image_wrap(p, w as usize, h as usize, (w as usize) * 4)
    (*wv).force_paint = true
    return true
}

fn webview_open(wv: *mut WebView, be: *mut webview_types.Backend, w: u32, h: u32) -> bool {
    if w == 0 || h == 0 || alive(wv) {
        return false
    }
    (*wv).be = *be
    if !alloc_surface(wv, w, h) {
        fail(wv)
        return false
    }
    let create: fn(u64, u32, u32) -> bool = (*wv).be.create
    if !create((*wv).be.ud, w, h) {
        fail(wv)
        return false
    }
    (*wv).created = true
    (*wv).want_w = w
    (*wv).want_h = h
    (*wv).state = webview_types.ST_READY
    return true
}

fn webview_close(wv: *mut WebView) {
    if (*wv).created {
        let destroy: fn(u64) = (*wv).be.destroy
        destroy((*wv).be.ud)
        (*wv).created = false
    }
    if (*wv).buf != 0 {
        rt.heap_free((*wv).buf, (*wv).cap)
    }
    rt.buf_free(&(*wv).title)
    rt.buf_free(&(*wv).hover)
    rt.buf_free(&(*wv).last_nav)
    webview_types.event_free(&(*wv).ev)
    webview_types.input_free(&(*wv).inp)
    (*wv).buf = 0
    (*wv).cap = 0
    (*wv).state = webview_types.ST_NEW
    (*wv).focused = false
}

fn webview_load(wv: *mut WebView, p: u64, n: usize, kind: u32) -> bool {
    if !alive(wv) {
        return false
    }
    rt.buf_clear(&(*wv).title)
    rt.buf_clear(&(*wv).hover)
    let load: fn(u64, u32, u64, usize) -> bool = (*wv).be.load
    if !load((*wv).be.ud, kind, p, n) {
        fail(wv)
        return false
    }
    (*wv).state = webview_types.ST_LOADING
    (*wv).force_paint = true
    return true
}

fn webview_resize(wv: *mut WebView, w: u32, h: u32, scale_milli: u32) {
    if w == 0 || h == 0 {
        return
    }
    if w == (*wv).want_w && h == (*wv).want_h && scale_milli == (*wv).scale {
        return
    }
    (*wv).want_w = w
    (*wv).want_h = h
    (*wv).scale = scale_milli
    (*wv).resize_pending = true
}

fn apply_resize(wv: *mut WebView) {
    (*wv).resize_pending = false
    if !alloc_surface(wv, (*wv).want_w, (*wv).want_h) {
        fail(wv)
        return
    }
    let resize: fn(u64, u32, u32, u32) -> bool = (*wv).be.resize
    if !resize((*wv).be.ud, (*wv).w, (*wv).h, (*wv).scale) {
        fail(wv)
    }
}

fn copy_text(dst: *mut rt.Buf, src: *mut rt.Buf) {
    rt.buf_clear(dst)
    rt.buf_push_bytes(dst, rt.buf_ptr(src), rt.buf_len(src))
}

fn handle_nav(wv: *mut WebView, ev: *mut webview_types.Event) {
    copy_text(&(*wv).last_nav, &(*ev).text)
    let hook: fn(u64, u64, usize) -> u32 = (*wv).nav
    let verdict: u32 = hook((*wv).nav_ud, rt.buf_ptr(&(*ev).text), rt.buf_len(&(*ev).text))
    if verdict != webview_types.NAV_ALLOW {
        return
    }
    let load: fn(u64, u32, u64, usize) -> bool = (*wv).be.load
    if load((*wv).be.ud, webview_types.LOAD_URL, rt.buf_ptr(&(*ev).text), rt.buf_len(&(*ev).text)) {
        (*wv).state = webview_types.ST_LOADING
    }
}

fn handle_service(wv: *mut WebView, ev: *mut webview_types.Event) {
    let hook: fn(u64, *mut webview_types.Event) = (*wv).svc
    hook((*wv).svc_ud, ev)
}

fn dispatch(wv: *mut WebView, ev: *mut webview_types.Event) {
    let k: u32 = (*ev).kind
    if k == webview_types.EV_TITLE {
        copy_text(&(*wv).title, &(*ev).text)
    } else if k == webview_types.EV_LOADED {
        (*wv).doc_h = (*ev).b
        (*wv).force_paint = true
        if (*ev).a == 0 {
            fail(wv)
        } else {
            (*wv).state = webview_types.ST_READY
        }
    } else if k == webview_types.EV_NAV {
        handle_nav(wv, ev)
    } else if k == webview_types.EV_HOVER {
        copy_text(&(*wv).hover, &(*ev).text)
    } else if k == webview_types.EV_CURSOR {
        (*wv).cursor = (*ev).a
    } else if k == webview_types.EV_SCROLLED {
        (*wv).scroll = (*ev).a
    } else if k == webview_types.EV_OVERFLOW {
        (*wv).overflows = (*wv).overflows + 1
    } else if k >= webview_types.EV_CLIP_WRITE {
        handle_service(wv, ev)
    }
}

fn drain_events(wv: *mut WebView) {
    let next: fn(u64, *mut webview_types.Event) -> bool = (*wv).be.next_event
    var n: usize = 0
    while n < webview_types.EVENT_BUDGET && alive(wv) && next((*wv).be.ud, &(*wv).ev) {
        dispatch(wv, &(*wv).ev)
        n = n + 1
    }
}

fn paint_frame(wv: *mut WebView) -> bool {
    let paint: fn(u64, u64, usize, usize, *mut webview_types.DamageRect) -> u32 = (*wv).be.paint
    (*wv).force_paint = false
    let r: u32 = paint((*wv).be.ud, (*wv).buf, ((*wv).w as usize) * 4, (*wv).cap, &(*wv).damage)
    if r != webview_types.RENDER_CHANGED {
        return false
    }
    (*wv).frames = (*wv).frames + 1
    return true
}

fn poll_caret(wv: *mut WebView) -> bool {
    if !(*wv).focused || ((*wv).be.caps & webview_types.CAP_IME) == 0 as u32 {
        return false
    }
    var r: webview_types.Rect = webview_types.Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 }
    let caret: fn(u64, *mut webview_types.Rect) -> bool = (*wv).be.caret
    let has: bool = caret((*wv).be.ud, &r)
    var same: bool = has == (*wv).has_caret
    if has && same {
        same = r.x == (*wv).caret.x && r.y == (*wv).caret.y && r.h == (*wv).caret.h
    }
    if same {
        return false
    }
    (*wv).has_caret = has
    (*wv).caret = r
    if has {
        let spot: fn(u64, f64, f64, f64) = (*wv).spot
        spot((*wv).spot_ud, r.x, r.y, r.h)
    }
    return true
}

fn webview_tick(wv: *mut WebView, now_us: i64) -> bool {
    if !alive(wv) {
        return false
    }
    var changed: bool = false
    if (*wv).resize_pending {
        apply_resize(wv)
        changed = true
    }
    let tick: fn(u64, i64) -> u32 = (*wv).be.tick
    let t: u32 = tick((*wv).be.ud, now_us)
    if t == webview_types.TICK_DEAD {
        fail(wv)
        return true
    }
    if alive(wv) && (t == webview_types.TICK_DIRTY || (*wv).force_paint) && paint_frame(wv) {
        changed = true
    }
    drain_events(wv)
    if (*wv).force_paint && alive(wv) && paint_frame(wv) {
        changed = true
    }
    if poll_caret(wv) {
        changed = true
    }
    if !alive(wv) {
        changed = true
    }
    return changed
}

fn webview_wait_ms(wv: *mut WebView, now_us: i64) -> i64 {
    if !alive(wv) {
        return 0 - 1
    }
    let wait: fn(u64, i64) -> i64 = (*wv).be.wait_ms
    return wait((*wv).be.ud, now_us)
}

fn begin_input(wv: *mut WebView, kind: u32) {
    let i: *mut webview_types.Input = &(*wv).inp
    (*i).kind = kind
    (*i).x = 0.0
    (*i).y = 0.0
    (*i).dx = 0.0
    (*i).dy = 0.0
    (*i).button = 0
    (*i).mods = 0
    (*i).key = 0
    (*i).cp = 0
    (*i).cursor = 0 - 1
    (*i).id = 0
    (*i).status = 0
    rt.buf_clear(&(*i).text)
}

fn send_input(wv: *mut WebView) -> bool {
    if !alive(wv) {
        return false
    }
    let input: fn(u64, *mut webview_types.Input) -> bool = (*wv).be.input
    return input((*wv).be.ud, &(*wv).inp)
}

fn webview_pointer(wv: *mut WebView, kind: u32, x: f64, y: f64, button: u32, mods: u32) -> bool {
    if !alive(wv) {
        return false
    }
    if kind == webview_types.IN_DOWN {
        webview_focus(wv, true)
    }
    begin_input(wv, kind)
    (*wv).inp.x = x
    (*wv).inp.y = y
    (*wv).inp.button = button
    (*wv).inp.mods = mods
    return send_input(wv)
}

fn webview_wheel(wv: *mut WebView, x: f64, y: f64, dx: f64, dy: f64, mods: u32) -> bool {
    begin_input(wv, webview_types.IN_WHEEL)
    (*wv).inp.x = x
    (*wv).inp.y = y
    (*wv).inp.dx = dx
    (*wv).inp.dy = dy
    (*wv).inp.mods = mods
    return send_input(wv)
}

fn webview_key(wv: *mut WebView, down: bool, key: u32, mods: u32) -> bool {
    if !(*wv).focused || key == editor.KEY_TAB {
        return false
    }
    var kind: u32 = webview_types.IN_KEY_UP
    if down {
        kind = webview_types.IN_KEY_DOWN
    }
    begin_input(wv, kind)
    (*wv).inp.key = key
    (*wv).inp.mods = mods
    return send_input(wv)
}

fn webview_char(wv: *mut WebView, cp: u32) -> bool {
    return webview_char_mods(wv, cp, 0 as u32)
}

fn webview_char_mods(wv: *mut WebView, cp: u32, mods: u32) -> bool {
    if !(*wv).focused {
        return false
    }
    begin_input(wv, webview_types.IN_CHAR)
    (*wv).inp.cp = cp
    (*wv).inp.mods = mods
    return send_input(wv)
}

fn webview_preedit(wv: *mut WebView, p: u64, n: usize, cursor: i32) -> bool {
    if !(*wv).focused || ((*wv).be.caps & webview_types.CAP_IME) == 0 as u32 {
        return false
    }
    begin_input(wv, webview_types.IN_PREEDIT)
    rt.buf_push_bytes(&(*wv).inp.text, p, n)
    (*wv).inp.cursor = cursor
    (*wv).preedit_on = n > 0
    return send_input(wv)
}

fn commit_as_chars(wv: *mut WebView, p: u64, n: usize) -> bool {
    let s: core.Span = core.span(rt.ptr_of(p), n)
    var i: usize = 0
    var used: bool = false
    while i < n {
        let hit: core.CharHit = core.utf8_read(s, i)
        if webview_char(wv, hit.cp) {
            used = true
        }
        i = i + hit.length
    }
    return used
}

fn webview_commit(wv: *mut WebView, p: u64, n: usize) -> bool {
    if !(*wv).focused {
        return false
    }
    if ((*wv).be.caps & webview_types.CAP_IME) == 0 as u32 {
        return commit_as_chars(wv, p, n)
    }
    begin_input(wv, webview_types.IN_COMMIT)
    rt.buf_push_bytes(&(*wv).inp.text, p, n)
    (*wv).preedit_on = false
    return send_input(wv)
}

fn webview_focus(wv: *mut WebView, on: bool) {
    if on == (*wv).focused {
        return
    }
    if !on && (*wv).preedit_on {
        webview_preedit(wv, 0, 0, 0 - 1)
    }
    (*wv).focused = on
    if on {
        begin_input(wv, webview_types.IN_FOCUS)
    } else {
        begin_input(wv, webview_types.IN_BLUR)
        (*wv).has_caret = false
    }
    send_input(wv)
}

fn webview_reply(wv: *mut WebView, id: u32, status: u32, p: u64, n: usize) -> bool {
    begin_input(wv, webview_types.IN_REPLY)
    (*wv).inp.id = id
    (*wv).inp.status = status
    rt.buf_push_bytes(&(*wv).inp.text, p, n)
    return send_input(wv)
}

fn webview_on_nav(wv: *mut WebView, ud: u64, hook: fn(u64, u64, usize) -> u32) {
    (*wv).nav_ud = ud
    (*wv).nav = hook
}

fn webview_on_service(wv: *mut WebView, ud: u64, hook: fn(u64, *mut webview_types.Event)) {
    (*wv).svc_ud = ud
    (*wv).svc = hook
}

fn webview_on_spot(wv: *mut WebView, ud: u64, hook: fn(u64, f64, f64, f64)) {
    (*wv).spot_ud = ud
    (*wv).spot = hook
}

fn webview_set_perms(wv: *mut WebView, bits: u32) {
    (*wv).perms = bits
}

fn webview_draw(wv: *mut WebView, z: *mut painter.Painter, x: f64, y: f64) {
    if (*wv).buf == 0 {
        return
    }
    if (*wv).state == webview_types.ST_FAILED || (*wv).state == webview_types.ST_NEW {
        painter.surface(z, x, y, (*wv).w as f64, (*wv).h as f64, FAILED_FILL)
        return
    }
    uiimage.image_draw(z, &(*wv).img, x, y, (*wv).w as f64, (*wv).h as f64, uiimage.FIT_NONE, 0 as u32)
}

fn webview_state(wv: *mut WebView) -> u32 { return (*wv).state }
fn webview_title(wv: *mut WebView) -> str { return rt.buf_str(&(*wv).title) }
fn webview_hover(wv: *mut WebView) -> str { return rt.buf_str(&(*wv).hover) }
fn webview_last_nav(wv: *mut WebView) -> str { return rt.buf_str(&(*wv).last_nav) }
fn webview_scroll(wv: *mut WebView) -> u32 { return (*wv).scroll }
fn webview_doc_height(wv: *mut WebView) -> u32 { return (*wv).doc_h }
fn webview_cursor(wv: *mut WebView) -> u32 { return (*wv).cursor }
fn webview_frames(wv: *mut WebView) -> u64 { return (*wv).frames }
fn webview_focused(wv: *mut WebView) -> bool { return (*wv).focused }
fn webview_preediting(wv: *mut WebView) -> bool { return (*wv).preedit_on }
fn webview_has_caret(wv: *mut WebView) -> bool { return (*wv).has_caret }
fn webview_caps(wv: *mut WebView) -> u32 { return (*wv).be.caps }
fn webview_perms(wv: *mut WebView) -> u32 { return (*wv).perms }
fn webview_overflows(wv: *mut WebView) -> u32 { return (*wv).overflows }
fn webview_pixels(wv: *mut WebView) -> u64 { return (*wv).buf }

fn webview_size(wv: *mut WebView, w: *mut u32, h: *mut u32) {
    *w = (*wv).w
    *h = (*wv).h
}

fn webview_caret(wv: *mut WebView, out: *mut webview_types.Rect) {
    *out = (*wv).caret
}

fn webview_damage(wv: *mut WebView, out: *mut webview_types.DamageRect) {
    *out = (*wv).damage
}
