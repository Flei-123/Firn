// SPDX-License-Identifier: MPL-2.0
// lib/fui/icons.fi -- LUCIDE ICONS, DRAWN AS PATHS AT ANY SIZE.
//
// ========================================================= WHY IT EXISTS
//
// Every fUi program drew its icons by hand out of round rectangles: a
// person was two rings, a moon a disc with a bite out of it, a door a
// ring and a bar. They took the colour of the text, which was right, and
// they looked like what they were -- shapes stacked by somebody who was
// not drawing an icon. FirnChat's head showed it best.
//
// This file draws a real icon set instead: Lucide (lib/fui/lucide.fi,
// ISC), 24 x 24 grid, stroked two units wide with round caps and round
// joins -- the same outlines a browser shows for lucide-static.
//
// ========================================================== HOW IT DRAWS
//
// NO BITMAP, NO CACHE OF PIXELS, NO XML. An icon is one path string. It
// is parsed by svg.path (`zerteile_d`, the parser lib/svg uses for
// `<path d>`), flattened at the size it is drawn at (`pfad_glaette`),
// turned into its stroke outline by svg.stroke (`strich_umriss`, the
// same code that strokes SVG in Certus) and filled with the non-zero
// rule into the canvas through the painter's own rasteriser. So:
//
//   * it is SHARP AT EVERY SCALE: the outline is rasterised at the pixel
//     size it is drawn at, 16 points on a phone with ratio 3 are 48
//     pixels of real outline, not 16 pixels made bigger;
//   * it takes ANY COLOUR, with alpha, like a letter: `col` is the text
//     colour of the theme, the accent, or a faded version of either;
//   * it respects the canvas clip (canvas_fill_raster blends through
//     clip_factor), so it slides and fades with whatever it sits in.
//
// `lib/fui/uisvg.fi` still has its place: it rasters a whole SVG
// DOCUMENT (gradients, use, text) into an image once. For the fifty line icons of an interface a document per
// icon is an XML parse and a canvas per draw -- this path does neither.
//
// ======================================================== THE COMMON RULE
//
// Like lib/fui/icon.fi: every call gets a SQUARE (x, y, size) and draws
// the icon's 24 x 24 grid into it. Whoever wants it centred in a button
// works the square out and calls -- the icon does not know what it sits
// in. Coordinates are DEVICE PIXELS for `icon`, `icon_filled` and
// `icon_stroke`, and DESIGN POINTS (times the theme's scale) for the
// `*_pt` doors, which is what a page that thinks in points wants.
//
// ================================================================ USE
//
//     import fui.icons
//     import fui.lucide
//     icons.icon_pt(c, lucide.SEND, x, y, 20.0, col)
//
// To add an icon to the set: tools/fui/lucide_icons.py.
import std.rt
import paint.canvas
import font.raster
import svg.matrix
import svg.path
import svg.stroke
import fui.theme
import fui.painter
import fui.fcache
import fui.gpu
import fui.render
import fui.lucide

export {
    icon, icon_stroke, icon_filled,
    icon_pt, icon_stroke_pt, icon_filled_pt,
    icon_ok, STROKE_DEFAULT, GRID,
}

// Lucide's grid and its stroke, in grid units.
const GRID: f64 = 24.0
const STROKE_DEFAULT: f64 = 2.0

// ------------------------------------------------------ the work space
//
// Three paths and two stroke tools, made once for the program and kept.
// The stroke tool holds its buffers between calls on purpose (see
// svg/stroke.fi, `Strich`): fifty icons a frame do not fetch memory
// fifty times.
struct Work {
    src: path.Path, // the icon as parsed, grid units
    flat: path.Path, // flattened for the size it is drawn at
    out: path.Path, // the outline of the stroke
    st: stroke.Dash,
    help: stroke.Dash,
}

struct WorkPair {
    two: [Work; 2],
}

static mut G_WORK: u64 = 0

fn work_bytes() -> usize {
    let base: u64 = 4096
    let pp: *mut WorkPair = base as *mut WorkPair
    return (((&(*pp).two[1]) as u64) - base) as usize
}

fn work() -> *mut Work {
    if G_WORK != 0 {
        return G_WORK as *mut Work
    }
    let n: usize = work_bytes()
    let p: u64 = rt.heap_alloc(n)
    if p == 0 {
        return 0 as *mut Work
    }
    var i: usize = 0
    while i < n {
        rt.st8(p, i, 0 as u8)
        i = i + 1
    }
    let w: *mut Work = p as *mut Work
    (*w).src = path.path_new()
    (*w).flat = path.path_new()
    (*w).out = path.path_new()
    path.path_init(&(*w).src)
    path.path_init(&(*w).flat)
    path.path_init(&(*w).out)
    (*w).st = stroke.dash_new()
    (*w).help = stroke.dash_new()
    G_WORK = p
    return w
}

// Does this set carry the id?
fn icon_ok(id: i64) -> bool {
    return id >= 0 && id < lucide.LUCIDE_N
}

fn floor_px(v: f64) -> f64 {
    let t: f64 = (v as i64) as f64
    if t > v {
        return t - 1.0
    }
    return t
}

// Fill `pf` (grid units) at scale `k` with its origin at (x, y) into the
// painter's canvas. `luft` is how far the shape may reach over the
// square (half a stroke plus the antialiasing seam).
fn fill_path(z: *mut painter.Painter, pf: *mut path.Path, x: f64, y: f64,
    size: f64, k: f64, luft: f64, col: u32, evenodd: bool) {
    fill_path_kept(z, pf, x, y, size, k, luft, col, evenodd,
        0 as u64 as *mut fcache.CKey)
}

// Is the window of the icon square (x, y, size, luft) wholly on the
// canvas? Only such a coverage is kept or taken from the cache (see
// lib/fui/fcache.fi, WHAT KEEPS IT EXACT).
fn whole_on_canvas(z: *mut painter.Painter, x: f64, y: f64, size: f64,
    luft: f64) -> bool {
    let cv: *mut canvas.Canvas = painter.painter_canvas(z)
    return x - luft >= 0.0 && y - luft >= 0.0 &&
        x + size + luft + 1.0 <= canvas.canvas_width(cv) as f64 &&
        y + size + luft + 1.0 <= canvas.canvas_height(cv) as f64
}

// THE KEPT ICON: the key of an icon of this id, size, stroke and fraction
// of its position (the whole pixels only move it).
fn icon_key(id: i64, x: f64, y: f64, size: f64, sw: f64, filled: bool) -> fcache.CKey {
    var k: fcache.CKey = fcache.ckey_new(fcache.KIND_ICON)
    k.a = id as u64
    k.b = __bits(size)
    k.c = __bits(sw)
    k.d = __bits(x - floor_px(x))
    k.e = __bits(y - floor_px(y))
    if filled {
        k.f = 1
    }
    return k
}

// Written back from the cache: true. Nothing kept (or a window the canvas
// edge would cut): false, and the caller rasters.
fn icon_hit(z: *mut painter.Painter, k: *mut fcache.CKey, x: f64, y: f64,
    size: f64, luft: f64, col: u32) -> bool {
    if !fcache.fc_on() || !whole_on_canvas(z, x, y, size, luft) ||
        gpu.gpu_of(painter.painter_canvas(z)) as u64 != 0 {
        return false
    }
    let e: u64 = fcache.fc_lookup(k, 0, 0)
    if e == 0 {
        return false
    }
    return fcache.fc_fill(painter.painter_canvas(z), e, floor_px(x) as i64,
        floor_px(y) as i64, painter.mit_alpha(col))
}

// ON THE GPU (lib/fui/gpu.fi): the icon's coverage in the GPU's atlas,
// under the same key as the cache's; true when it was drawn from there.
fn gpu_key(k: *mut fcache.CKey) -> gpu.AKey {
    var a: gpu.AKey = gpu.akey_new()
    a.k[0] = 2 // an icon (painter.fi: 1 = a glyph)
    a.k[1] = (*k).a
    a.k[2] = (*k).b
    a.k[3] = (*k).c
    a.k[4] = (*k).d
    a.k[5] = (*k).e
    a.k[6] = (*k).f
    return a
}

fn icon_gpu_hit(z: *mut painter.Painter, k: *mut fcache.CKey, x: f64, y: f64,
    col: u32) -> bool {
    let g: *mut gpu.Gpu = gpu.gpu_of(painter.painter_canvas(z))
    if g as u64 == 0 {
        return false
    }
    var a: gpu.AKey = gpu_key(k)
    let e: u64 = gpu.gpu_atlas_find(g, &a)
    if e == 0 {
        return false
    }
    gpu.gpu_atlas_draw(g, e, floor_px(x) as i64, floor_px(y) as i64,
        painter.mit_alpha(col), false, 0 as u32, 0.0, 0.0)
    return true
}

// fill_path, and with a key the coverage is kept: then the window is not
// cut to the rows of the clip (a kept coverage needs all of them).
fn fill_path_kept(z: *mut painter.Painter, pf: *mut path.Path, x: f64, y: f64,
    size: f64, k: f64, luft: f64, col: u32, evenodd: bool,
    key: *mut fcache.CKey) {
    let g: *mut gpu.Gpu = gpu.gpu_of(painter.painter_canvas(z))
    if g as u64 != 0 && key as u64 != 0 {
        // the whole square, wherever it stands (the GPU cuts at drawing)
        let gx: f64 = floor_px(x - luft)
        let gy: f64 = floor_px(y - luft)
        let gw: usize = (size + 2.0 * luft + 2.0) as usize + 1
        if gw <= (*z).w && gw <= (*z).h && raster.raster_begin(&(*z).ra, gx, gy, gw, gw) {
            path.path_an_raster(pf, &(*z).ra, matrix.mat_of_six(k, 0.0, 0.0, k,
                x, y))
            if evenodd {
                raster.raster_finish_evenodd(&(*z).ra)
            } else {
                raster.raster_finish(&(*z).ra)
            }
            var a: gpu.AKey = gpu_key(key)
            let e: u64 = gpu.gpu_atlas_put(g, &a, &(*z).ra, gx as i64, gy as i64,
                floor_px(x) as i64, floor_px(y) as i64)
            if e != 0 {
                gpu.gpu_atlas_draw(g, e, floor_px(x) as i64, floor_px(y) as i64,
                    painter.mit_alpha(col), false, 0 as u32, 0.0, 0.0)
            }
        }
        return
    }
    let keep: bool = key as u64 != 0 && fcache.fc_on() &&
        whole_on_canvas(z, x, y, size, luft)
    let cv: *mut canvas.Canvas = painter.painter_canvas(z)
    let cw: f64 = canvas.canvas_width(cv) as f64
    let ch: f64 = canvas.canvas_height(cv) as f64
    var ax: f64 = floor_px(x - luft)
    var ay: f64 = floor_px(y - luft)
    if ax < 0.0 {
        ax = 0.0
    }
    if ay < 0.0 {
        ay = 0.0
    }
    var bx: f64 = x + size + luft + 1.0
    var by: f64 = y + size + luft + 1.0
    if bx > cw {
        bx = cw
    }
    if by > ch {
        by = ch
    }
    // only the rows of the clip (painter.clip_rows: exact, rows only)
    if !keep && !painter.clip_rows(cv, x - luft, x + size + luft + 1.0, &ay, &by) {
        return
    }
    if bx <= ax || by <= ay {
        return
    }
    let rw: usize = (bx - ax) as usize + 1
    let rh: usize = (by - ay) as usize + 1
    if rw > (*z).w || rh > (*z).h {
        return
    }
    if !raster.raster_begin(&(*z).ra, ax, ay, rw, rh) {
        return
    }
    path.path_an_raster(pf, &(*z).ra, matrix.mat_of_six(k, 0.0, 0.0, k,
        x, y))
    if evenodd {
        raster.raster_finish_evenodd(&(*z).ra)
    } else {
        raster.raster_finish(&(*z).ra)
    }
    if keep {
        fcache.fc_store(key, 0, 0, &(*z).ra, ax, ay, floor_px(x) as i64,
            floor_px(y) as i64)
    }
    let g2: *mut gpu.Gpu = gpu.gpu_of(cv)
    if g2 as u64 != 0 {
        gpu.gpu_fill_raster(g2, &(*z).ra, ax as usize, ay as usize, painter.mit_alpha(col))
        return
    }
    canvas.canvas_fill_raster(cv, &(*z).ra, ax as usize, ay as usize,
        painter.mit_alpha(col))
}

// Is the square (x, y, size) with `luft` around it wholly outside the
// canvas clip? Then nothing of the icon could show.
fn off_clip(z: *mut painter.Painter, x: f64, y: f64, size: f64,
    luft: f64) -> bool {
    let cv: *mut canvas.Canvas = painter.painter_canvas(z)
    return x + size + luft + 1.0 <= canvas.clip_x0(cv) ||
        x - luft >= canvas.clip_x1(cv) ||
        y + size + luft + 1.0 <= canvas.clip_y0(cv) ||
        y - luft >= canvas.clip_y1(cv)
}

// Parse the icon into the work space. False for an unknown id.
fn load(w: *mut Work, id: i64) -> bool {
    if !icon_ok(id) {
        return false
    }
    let s: str = lucide.lucide_d(id)
    if s.n == 0 {
        return false
    }
    path.path_empty(&(*w).src)
    return path.split_d(&(*w).src, s.p as u64, s.n)
}

// THE ICON, STROKED `sw` GRID UNITS WIDE (Lucide's own is 2; 1.5 reads
// lighter at big sizes, 2.5 bolder at small ones). Device pixels. A
// colour with alpha 0 is taken as opaque, the painter's rule; to fade an
// icon out, give it an alpha of 1 and not 0 -- or do not draw it.
fn icon_stroke(z: *mut painter.Painter, id: i64, x: f64, y: f64, size: f64,
    col: u32, sw: f64) {
    if (*z).ok == 0 || size <= 0.0 || sw <= 0.0 {
        return
    }
    // outside the clip: not parsed, not stroked (fUi tempo, stage 1)
    let luft: f64 = sw * (size / GRID) + 2.0
    if off_clip(z, x, y, size, luft) {
        return
    }
    // painted before at this size: written back (lib/fui/fcache.fi), or
    // drawn out of the GPU's atlas
    var key: fcache.CKey = icon_key(id, x, y, size, sw, false)
    if icon_gpu_hit(z, &key, x, y, col) || icon_hit(z, &key, x, y, size, luft, col) {
        return
    }
    let w: *mut Work = work()
    if (w as u64) == 0 {
        return
    }
    if !load(w, id) {
        return
    }
    let k: f64 = size / GRID
    path.path_smooth(&(*w).flat, &(*w).src, k)
    (*w).st.width = sw
    (*w).st.cap = stroke.K_ROUND
    (*w).st.stoss = stroke.S_ROUND
    (*w).st.gehrung = 4.0
    (*w).st.n_strokes = 0
    (*w).st.offset = 0.0
    stroke.dash_outline(&(*w).out, &(*w).flat, &(*w).st, &(*w).help)
    fill_path_kept(z, &(*w).out, x, y, size, k, sw * k + 2.0, col, false, &key)
}

// The icon with Lucide's stroke of 2.
fn icon(z: *mut painter.Painter, id: i64, x: f64, y: f64, size: f64,
    col: u32) {
    icon_stroke(z, id, x, y, size, col, STROKE_DEFAULT)
}

// THE ICON FILLED instead of stroked: every subpath becomes an area,
// the paper plane of SEND_HORIZONTAL a solid dart, the body of LOCK a
// block. An open subpath is closed by a straight line, as SVG fills it
// (the shackle of LOCK becomes a half disc) -- so this is for icons whose
// shape IS their outline. Even-odd, so a ring stays a ring.
fn icon_filled(z: *mut painter.Painter, id: i64, x: f64, y: f64, size: f64,
    col: u32) {
    if (*z).ok == 0 || size <= 0.0 {
        return
    }
    if off_clip(z, x, y, size, 2.0) {
        return
    }
    var key: fcache.CKey = icon_key(id, x, y, size, 0.0, true)
    if icon_gpu_hit(z, &key, x, y, col) || icon_hit(z, &key, x, y, size, 2.0, col) {
        return
    }
    let w: *mut Work = work()
    if (w as u64) == 0 {
        return
    }
    if !load(w, id) {
        return
    }
    let k: f64 = size / GRID
    path.path_smooth(&(*w).flat, &(*w).src, k)
    fill_path_kept(z, &(*w).flat, x, y, size, k, 2.0, col, true, &key)
}

// ------------------------------------------- the doors in design points
//
// A page that thinks in points (FirnChat's view, a fUi dialog) hands the
// square in points; the theme's scale (per mille, set from the device
// ratio) turns it into pixels here, and the origin is put on a whole
// pixel so a 2 unit stroke at 24 pixels stays two crisp columns.
fn scale_of(c: *mut render.Ctx) -> f64 {
    var s: f64 = (theme.theme_scale(render.ctx_theme(c)) as f64) / 1000.0
    if s <= 0.0 {
        s = 1.0
    }
    return s
}

fn round_px(v: f64) -> f64 {
    return floor_px(v + 0.5)
}

fn icon_stroke_pt(c: *mut render.Ctx, id: i64, x: f64, y: f64, size: f64,
    col: u32, sw: f64) {
    let k: f64 = scale_of(c)
    icon_stroke(render.ctx_painter(c), id, round_px(x * k), round_px(y * k),
        size * k, col, sw)
}

fn icon_pt(c: *mut render.Ctx, id: i64, x: f64, y: f64, size: f64,
    col: u32) {
    icon_stroke_pt(c, id, x, y, size, col, STROKE_DEFAULT)
}

fn icon_filled_pt(c: *mut render.Ctx, id: i64, x: f64, y: f64, size: f64,
    col: u32) {
    let k: f64 = scale_of(c)
    icon_filled(render.ctx_painter(c), id, round_px(x * k), round_px(y * k),
        size * k, col)
}
