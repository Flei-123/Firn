// SPDX-License-Identifier: MPL-2.0
// lib/fui/glasspane.fi -- GLASS FOR THE SURFACES THAT FLOAT: dialog, menu,
// title bar, tooltip.
//
// glass.fi is the engine (blur, tint, cache). THIS file is the glue the
// widgets call, so that every surface asks the same question the same way:
//
//     if glasspane.pane(c, glasspane.SLOT_TIP, x, y, w, h, r, glass.KIND_ACRYLIC) {
//         // glass is painted: paint only the rim / content, NOT the flat fill
//     } else {
//         // glass is off (theme token Shape.glass == 0, the default):
//         // paint the flat fill as before
//     }
//
// The level comes from the theme (`glass = 0|1|2` in a theme file, see
// themefile.fi). Level 0 returns false BEFORE any memory is touched, so a
// theme without glass costs one load and one compare per surface.
//
// Every slot owns one `glass.Glass` (heap, created on first use) so that
// the cached pane of the menu is not thrown away by the tooltip.
import std.rt
import paint.canvas
import fui.theme
import fui.glass
import fui.render
import fui.painter
import fui.gpu
import fui.effect

export {
    pane, pane_cv, frost_panes, pane_active, pane_free_all, pane_cold, pane_hits,
    SLOT_MENU, SLOT_SUB, SLOT_MODAL, SLOT_TITLE, SLOT_TIP, SLOT_COUNT,
}

const SLOT_MENU: usize = 0
const SLOT_SUB: usize = 1
const SLOT_MODAL: usize = 2
const SLOT_TITLE: usize = 3
const SLOT_TIP: usize = 4
const SLOT_COUNT: usize = 5

static mut G_SLOT: [u64; 5] = [0; 5]

fn glass_size() -> usize {
    var probe: [glass.Glass; 2] = [glass.glass_new(); 2]
    return ((&probe[1]) as usize) - ((&probe[0]) as usize)
}

fn slot_glass(slot: usize) -> *mut glass.Glass {
    if slot >= SLOT_COUNT {
        return 0 as u64 as *mut glass.Glass
    }
    if G_SLOT[slot] == 0 {
        let p: u64 = rt.heap_alloc(glass_size())
        if p == 0 {
            return 0 as u64 as *mut glass.Glass
        }
        let g: *mut glass.Glass = p as *mut glass.Glass
        *g = glass.glass_new()
        G_SLOT[slot] = p
    }
    return G_SLOT[slot] as *mut glass.Glass
}

// The glass level of the context's theme: 0 off, 1 subtle, 2 strong.
fn pane_active(c: *mut render.Ctx) -> usize {
    return glass.glass_level_of(render.ctx_theme(c))
}

// Paint the glass pane at (x, y, w, h) with corner radius r (all window
// pixels). true = the pane is there. false = paint the flat fill yourself.
fn pane(c: *mut render.Ctx, slot: usize, x: f64, y: f64, w: f64, h: f64, r: f64, kind: usize) -> bool {
    let level: usize = glass.glass_level_of(render.ctx_theme(c))
    if level == 0 {
        return false
    }
    let cv: *mut canvas.Canvas = painter.painter_canvas(render.ctx_painter(c))
    if cv as u64 == 0 {
        return false
    }
    let g: *mut glass.Glass = slot_glass(slot)
    if g as u64 == 0 {
        return false
    }
    let dark: bool = theme.theme_is_dark(render.ctx_theme(c))
    return pane_cv(cv, slot, x, y, w, h, r, kind, level, dark)
}

// The pane on a canvas. On a GPU canvas (r264) the band under the pane is read back into the canvas memory, the glass engine (CPU,
// cached) paints it there with the corners and the rim exactly as on the CPU, and the band goes back up: the same pixels as the CPU
// path, and a pane whose backdrop did not change costs one read-back + one upload and no blur. The caller paints the backdrop first
// (on the GPU too: the read-back waits for what was queued).
#[allow_escape]
fn pane_cv(cv: *mut canvas.Canvas, slot: usize, x: f64, y: f64, w: f64, h: f64, r: f64, kind: usize,
    level: usize, dark: bool) -> bool {
    if level == 0 || cv as u64 == 0 {
        return false
    }
    let g: *mut glass.Glass = slot_glass(slot)
    if g as u64 == 0 {
        return false
    }
    let gg: *mut gpu.Gpu = gpu.gpu_of(cv)
    if gg as u64 == 0 {
        return glass.glass_draw(g, cv, x as i64, y as i64, w as i64, h as i64, r as i64,
            kind, level, dark, glass.HINT_AUTO)
    }
    // the glass looks up the backdrop `pad` pixels beyond the pane (blur reach, refraction): that much is read back, only the pane goes up
    let pr: glass.Params = glass.glass_params(kind, level, dark)
    let pad: i64 = 2 * pr.rs * ((1 as i64) << pr.flog) + pr.disp + 4 + ((1 as i64) << pr.flog)
    let cw: i64 = canvas.canvas_width(cv) as i64
    let ch: i64 = canvas.canvas_height(cv) as i64
    var ux0: i64 = (x as i64) - 2
    var uy0: i64 = (y as i64) - 2
    var ux1: i64 = (x + w) as i64 + 3
    var uy1: i64 = (y + h) as i64 + 3
    if ux0 < 0 { ux0 = 0 }
    if uy0 < 0 { uy0 = 0 }
    if ux1 > cw { ux1 = cw }
    if uy1 > ch { uy1 = ch }
    if ux1 <= ux0 || uy1 <= uy0 {
        return true
    }
    var rx0: i64 = ux0 - pad
    var ry0: i64 = uy0 - pad
    var rx1: i64 = ux1 + pad
    var ry1: i64 = uy1 + pad
    if rx0 < 0 { rx0 = 0 }
    if ry0 < 0 { ry0 = 0 }
    if rx1 > cw { rx1 = cw }
    if ry1 > ch { ry1 = ch }
    gpu.gpu_sw_begin(gg, cv, rx0 as i32, ry0 as i32, rx1 as i32, ry1 as i32)
    let ok: bool = glass.glass_draw(g, cv, x as i64, y as i64, w as i64, h as i64, r as i64,
        kind, level, dark, glass.HINT_AUTO)
    gpu.gpu_sw_end(gg, cv, ux0 as i32, uy0 as i32, ux1 as i32, uy1 as i32)
    return ok
}

// SEVERAL flat frosted panes of one frame in ONE batch (r264 / W28): `rects` = n * (x, y, w, h) in window pixels, `tints` = n colours
// (0xAARRGGBB). On a GPU canvas the panes that do not overlap share the render passes (effect.frost_rects: 12 panels 2516 -> 316 passes);
// on the CPU it is one frost_rect each, the same pixels. Level 0 of the theme paints nothing and returns false (draw the flat fills).
// The paint is the plain frost (box blur + tint), NOT the glass engine of `pane` (rim, noise, cache): use it for rows of cards / docks /
// panels that need no rim; the backdrop must be painted before.
fn frost_panes(c: *mut render.Ctx, rects: *mut f64, tints: *mut u32, n: usize, blur: i64) -> bool {
    if glass.glass_level_of(render.ctx_theme(c)) == 0 || n == 0 {
        return false
    }
    return effect.frost_rects(render.ctx_painter(c), rects, tints, n, blur)
}

fn pane_cold(slot: usize) -> usize {
    if slot >= SLOT_COUNT || G_SLOT[slot] == 0 {
        return 0
    }
    return glass.glass_cold(G_SLOT[slot] as *mut glass.Glass)
}

fn pane_hits(slot: usize) -> usize {
    if slot >= SLOT_COUNT || G_SLOT[slot] == 0 {
        return 0
    }
    return glass.glass_hits(G_SLOT[slot] as *mut glass.Glass)
}

// Give every cached pane back (a theme change, shutdown).
fn pane_free_all() {
    var i: usize = 0
    while i < SLOT_COUNT {
        if G_SLOT[i] != 0 {
            glass.glass_free(G_SLOT[i] as *mut glass.Glass)
        }
        i = i + 1
    }
}
