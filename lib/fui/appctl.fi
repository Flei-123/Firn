// SPDX-License-Identifier: MPL-2.0
// lib/fui/appctl.fi -- THE STANDARD CONTROLS IN THE TEN-LINE APP API.
//
// ========================================================= WHY IT EXISTS
//
// `fui.app` knew label, button, entry, textarea, list, row and column. A real
// settings window needs more: check boxes, radio groups, switches, sliders,
// progress bars, drop-downs, tabs, a menu bar with Alt+letter, tooltips,
// message / confirm / input dialogs, number boxes and expanders. The painters
// and the state of all of them exist since wave 2 / 3 (lib/fui/wave2.fi,
// wave3.fi, kit.fi); what was missing is the door: one call, a named
// callback, done. This file is that door. It adds NO new look -- every part
// is drawn by the painter that was there (render / wave2 / kit) and flipped
// by the host that was there (control.fi: a click or space flips a check box,
// a drag moves a slider). What this file adds is the glue the host does not
// do for the app: the change callback, radio groups, tab pages, the popup
// list of a drop-down, the keyboard (arrows on a slider / radio / tab /
// number box), the menu bar with Alt+letter mnemonics and shortcuts, the
// tooltip delay and the modal dialog with its focus trap.
//
//     import fui.app
//     import fui.appctl
//
//     fn changed(a: *mut app.App, id: usize) {
//         // id = the control; appctl.checked(a, id) / appctl.value(a, id) ...
//     }
//     fn main() -> i32 {
//         let a: *mut app.App = app.window("Settings", 480, 420)
//         let dark: usize = appctl.checkbox(a, "Dark mode", false, changed)
//         let vol: usize = appctl.slider(a, "Volume", 0, 100, 40, changed)
//         appctl.tooltip(a, vol, "Output volume")
//         return app.run(a)
//     }
//
// CALLBACKS are plain functions `fn(a: *mut app.App, id: usize)` -- no
// closures; the state lives in `static mut` or behind `app.data(a)`. `id` is
// the node the control was made with. A callback runs when the USER changed a
// control (mouse, keyboard); `set_*` calls from the program never call it.
//
// STRINGS (names, option texts, menu labels) are POINTED AT, not copied: pass
// literals or text that lives as long as the window.
//
// ========================================================= THE LIST
//
//   DONE:  checkbox  radio (group)  toggle  slider  progress  spinbox
//          dropdown (+ dropdown_add)  tabs / tab / tab_page  expander / expander_body
//          menubar / menu / menu_item / menu_check / menu_sep / menu_shortcut (Alt+letter, Left / Right
//          between menus; the items are actions of the window), popup_menu + context_menu (right
//          click, menu key, Shift+F10), tooltip (500 ms delay), message / confirm / input (modal,
//          kit.Modal focus trap, answers by callback)
//   WAVE 5 (r45): rating  segmented (+ segment_add)  chips (+ chip_add)  skeleton  chart (+ chart_set)  pager --
//          see the section WAVE 5 CONTROLS at the end of this file
//   WAVE 6 (r45): sheet_setup / sheet_show / sheet_hide (bottom sheet overlay, body callback)  propgrid (property grid
//          node, inline editor, edit callback) -- see the section WAVE 6 CONTROLS at the end of this file
//
// ========================================================= HONEST
//
//   L1  Every control is one or two of the 128 nodes of a window (scene.SCENE_MAX).
//   L2  48 controls and 96 option / menu entries per window; beyond that an add
//       returns NONE and changes nothing.
//   L3  The drop-down list and the dialogs are drawn inside the window (they
//       cannot reach past its border); a popup menu of the menu bar is the same
//       (menuview.fi).
//   L4  A hidden tab page / collapsed expander body keeps a 1 point rest in the
//       layout (scene bounds are "0 = no limit").
//   L5  The menu bar does not switch menus on hover while one is open.
//   L6  The dialogs are drawn by the library, not nodes of the scene: a screen reader does not
//       list their buttons (the window behind is shut off while one is open). One at a time.
//   L7  The input dialog's field has no mouse caret placement / selection (keys only) and no
//       IME; a tooltip is one line.
import std.rt
import fui.app
import fui.scene
import fui.splitter
import fui.ripple
import fui.theme
import fui.flex
import fui.widget
import fui.render
import fui.style
import fui.painter
import fui.kit
import fui.wave2
import fui.wave5
import fui.wave6
import fui.wave7
import fui.wave9
import fui.wave10
import fui.dnd
import fui.timeline
import fui.grid
import fui.wave8
import fui.a11y
import fui.action
import fui.ctxmenu
import fui.menuview
import fui.editor
import fui.textbuf
import fui.control
import plat.fuiwirt
import fui.uistr

export {
    checkbox, radio, toggle, slider, progress, spinbox, dropdown, dropdown_add,
    tabs, tab, tab_page, tabs_end, expander, expander_body,
    checked, set_checked, value, set_value, selected, set_selected, set_enabled,
    open_dropdown, dropdown_is_open, expanded, set_expanded, popup_rect,
    menubar, menubar_end, menu, popup_menu, context_menu, menu_item, menu_check, menu_sep,
    menu_shortcut, menu_enable, menu_checked, menu_set_checked, open_menu_id, menu_is_open,
    tooltip, tooltip_shown, message, confirm, input, dialog_open, dialog_text, dialog_answer,
    dialog_rect,
    rating, rating_value, set_rating_value, segmented, segment_add, segmented_selected, set_segmented_selected,
    chips, chip_add, chip_count, chip_selected, chip_changed, chip_was_removed, skeleton, skeleton_on,
    chart, chart_set, pager, pager_page, pager_show,
    sheet_setup, sheet_snaps, sheet_dismiss, sheet_on_pointer, sheet_show, sheet_hide, sheet_snap, sheet_visible,
    sheet_height, sheet_body, sheet_handle, sheet_node, sheet_describe, sheet_item, sheet_item_rect,
    propgrid, propgrid_event, propgrid_row, propgrid_selected, propgrid_select, propgrid_top, propgrid_set_top,
    propgrid_label_pm, propgrid_inline, propgrid_cell, propgrid_row_rect, propgrid_editing, propgrid_edit_text,
    propgrid_commit, propgrid_cancel, propgrid_refresh, PGE_COMMIT,
    range_slider, range_lo, range_hi, set_range_values, range_focus_thumb,
    combobox, combobox_add, combobox_open, combobox_close, combobox_is_open, combobox_results, combobox_picked,
    combobox_active, combobox_row_text, combobox_list_node, combobox_item_node, combobox_row_rect, combobox_rect,
    combobox_count, combobox_top,
    dnd_source, dnd_target, dnd_on_start, dnd_on_drop, dnd_ghost, dnd_busy, dnd_cancel, dnd_effect, dnd_from, dnd_from_row,
    dnd_to, dnd_gap, dnd_zone, dnd_to_row, dnd_drops, dnd_keyboard,
    size_class, height_class, nav_mode, on_size_class, size_columns, size_dp_width, size_changes,
    timeline, timeline_ref, timeline_play, timeline_pause, timeline_stop, timeline_value, timeline_playing, timeline_finished,
    timeline_reduced, TL_APP,
    spinner, spinner_on, spinner_is_on, timepicker, timepicker_hour, timepicker_minute, set_time,
    breadcrumb, breadcrumb_add, breadcrumb_clear, breadcrumb_event, BREADCRUMB_OVERFLOW,
    infobar, infobar_action, infobar_closable, infobar_event, infobar_open, infobar_show,
    stepper, stepper_add, stepper_current, stepper_set,
    grid, grid_cell, grid_gap, grid_pad, grid_rtl, grid_name,
    ripple_on, split_begin, split_mid, split_end, split_ratio, split_set_ratio, split_limits, split_hovered, split_dragging,
    ANS_OK, ANS_CANCEL,
    CTL_MAX, OPT_MAX, NONE,
}

const NONE: usize = 4294967295
const CTL_MAX: usize = 48
const OPT_MAX: usize = 96
const GROUP_MAX: usize = 16

// the kinds of an entry
const K_CHECK: u32 = 1
const K_RADIO: u32 = 2
const K_TOGGLE: u32 = 3
const K_SLIDER: u32 = 4
const K_PROGRESS: u32 = 5
const K_DROP: u32 = 6
const K_TAB: u32 = 7
const K_SPIN: u32 = 8
const K_EXPAND: u32 = 9
const K_MENU: u32 = 10
const K_POPUP: u32 = 11
const K_CTXMAP: u32 = 12
const K_TIP: u32 = 13
const K_SPLIT: u32 = 14

// the answers of a dialog
const ANS_OK: u32 = 1
const ANS_CANCEL: u32 = 2

// the dialog kinds
const D_MSG: u32 = 1
const D_CONFIRM: u32 = 2
const D_INPUT: u32 = 3

// the delay before a tooltip shows (ms)
const TIP_DELAY: i64 = 500
const SPIN_ZONE_PT: usize = 28
const DLG_W_PT: usize = 380
const BTN_W_PT: usize = 88
// ids of menus made by popup_menu (no node): MENU_VIRT + entry; SEP_MARK in the menu pool = a line
const MENU_VIRT: usize = 1000000
const SEP_MARK: usize = 4294967294
const INPUT_CAP: usize = 256

// the pointer kinds of the host hook / popup sink

fn cb_none(a: *mut app.App, id: usize) {
}

// one menu item: the action's data (the pool slot)
struct Rec {
    c: *mut Ctl,
    k: usize,
}

struct Ctl {
    a: *mut app.App,
    n: usize,
    kind: [u32; 48],
    node: [usize; 48],
    // radio / tab group, tab: the page node, expander: the body node, spin: step
    aux: [usize; 48],
    page: [usize; 48],
    lo: [i64; 48],
    hi: [i64; 48],
    last: [i64; 48],
    cb: [fn(*mut app.App, usize); 48],
    has_cb: [bool; 48],
    tip: [str; 48],
    // option / menu entries of an entry: opts[base .. base + cnt]
    base: [usize; 48],
    cnt: [usize; 48],
    opts: [str; 96],
    n_opts: usize,
    macts: [usize; 96],
    n_macts: usize,
    irec: [Rec; 96],
    ien: [bool; 96],
    ichk: [u32; 96],
    icb: [fn(*mut app.App, usize); 96],
    mhdr: usize,
    groups: usize,
    // the open drop-down
    drop_open: bool,
    drop_ctl: usize,
    drop_hot: usize,
    // the tooltip
    tip_node: usize,
    tip_on: bool,
    tip_since: i64,
    // RIPPLE (theme token Shape.ripple): the press wave of the pressed button
    rp: ripple.Ripples,
    rp_node: usize,
    tip_x: f64,
    tip_y: f64,
    // the window size of the last frame (the overlays are placed in it)
    win_w: f64,
    win_h: f64,
    // the dialog
    dlg: u32,
    dlg_m: kit.Modal,
    dlg_title: str,
    dlg_text: str,
    dlg_cb: fn(*mut app.App, u32),
    dlg_ed: editor.Editor,
    dlg_buf: u64,
    dlg_hot: usize,
    dlg_hclose: bool,
    // the menu bar row (container) while it is open
    mbar: bool,
    // the wave 5 entry whose pager is being dragged
    w5_drag: usize,
    // wave 6: the bottom sheet (one per window), the property grid whose divider is dragged, the inline editor
    sh: wave6.Sheet,
    sh_on: bool,
    sh_node: usize,
    sh_body: fn(*mut app.App, *mut render.Ctx, f64, f64, f64, f64),
    sh_bptr: fn(*mut app.App, u32, f64, f64),
    sh_kb: bool,
    sh_ms: i64,
    // the accessible side of the sheet: the description (a heap copy), the item nodes below the marker with
    // their rectangles in points relative to the body (x, y, w, h)
    sh_desc: u64,
    sh_dn: usize,
    sh_ni: usize,
    sh_it: [usize; 8],
    sh_ir: [f64; 32],
    sh_irole: [u32; 8],
    sh_iname: [str; 8],
    sh_name: str,
    w6_drag: usize,
    pg_ed: editor.Editor,
    pg_buf: u64,
    pg_edit_i: usize,
    pg_edit_row: usize,
    px: f64,
    py: f64,
    // the timelines of the window (heap, made on first use), see `timeline`
    w7: u64,
    // the size class of the window (heap Sz, made on first use), its callback
    sz: u64,
    sz_cb: fn(*mut app.App, u32),
    sz_has: bool,
    // drag and drop of the window (heap Dd, made on first use)
    dd: u64,
}

fn dlg_cb_none(a: *mut app.App, ans: u32) {
}

fn ctl_blank() -> Ctl {
    return Ctl { a: 0 as u64 as *mut app.App, n: 0, kind: [0 as u32; 48], node: [NONE; 48],
        aux: [0; 48], page: [NONE; 48], lo: [0; 48], hi: [0; 48], last: [0; 48],
        cb: [cb_none; 48], has_cb: [false; 48], tip: [""; 48], base: [0; 48], cnt: [0; 48],
        opts: [""; 96], n_opts: 0, macts: [0; 96], n_macts: 0, groups: 0,
        irec: [Rec { c: 0 as u64 as *mut Ctl, k: 0 }; 96], ien: [true; 96], ichk: [0 as u32; 96],
        icb: [cb_none; 96], mhdr: NONE,
        drop_open: false, drop_ctl: NONE, drop_hot: NONE,
        tip_node: NONE, tip_on: false, tip_since: 0, rp: ripple.ripples_new(), rp_node: NONE, tip_x: 0.0, tip_y: 0.0, win_w: 640.0, win_h: 480.0,
        dlg: 0 as u32, dlg_m: kit.modal_new(), dlg_title: "", dlg_text: "", dlg_cb: dlg_cb_none,
        dlg_ed: editor.editor_new(), dlg_buf: 0, dlg_hot: NONE, dlg_hclose: false, mbar: false, w5_drag: NONE,
        sh: wave6.sheet_new(true), sh_on: false, sh_node: NONE, sh_body: sh_body_none, sh_bptr: sh_bptr_none,
        sh_kb: false, sh_ms: 0, sh_desc: 0, sh_dn: 0, sh_ni: 0, sh_it: [NONE; 8], sh_ir: [0.0; 32], sh_irole: [0 as u32; 8], sh_iname: [""; 8], sh_name: "", w6_drag: NONE, pg_ed: editor.editor_new(), pg_buf: 0, pg_edit_i: NONE,
        pg_edit_row: NONE, px: 0.0, py: 0.0, w7: 0,
        sz: 0, sz_cb: sz_cb_none, sz_has: false, dd: 0 }
}

// ============================================================ THE STATE

// The state of a window, made on first use and plugged into the app.
fn st(a: *mut app.App) -> *mut Ctl {
    if app.ctl_ready(a) {
        return app.ctl_data(a) as *mut Ctl
    }
    var probe: [Ctl; 2] = [ctl_blank(); 2]
    let sz: usize = ((&probe[1]) as usize) - ((&probe[0]) as usize)
    let p: u64 = rt.heap_alloc(sz)
    if p == 0 {
        return 0 as u64 as *mut Ctl
    }
    let c: *mut Ctl = p as *mut Ctl
    *c = ctl_blank()
    (*c).a = a
    (*c).dlg_buf = rt.heap_alloc(INPUT_CAP)
    let ok: bool = editor.editor_init(&(*c).dlg_ed, (*c).dlg_buf, INPUT_CAP)
    (*c).pg_buf = rt.heap_alloc(INPUT_CAP)
    let ok2: bool = editor.editor_init(&(*c).pg_ed, (*c).pg_buf, INPUT_CAP)
    app.set_ctl(a, p, ctl_key, ctl_chr, ctl_ptr, ctl_act, ctl_paint)
    // the popup sink of the host: ours first (drop-down, dialog), the menu's otherwise.
    // ctx_view makes the menu state (and installs the menu's own sink) before we override it.
    let mv: *mut menuview.MenuView = app.ctx_view(a)
    fuiwirt.host_set_popup(app.app_host(a), p, sink_open, sink_ptr, sink_key, sink_chr,
        sink_tick, sink_wait)
    fuiwirt.host_set_wake(app.app_host(a), p, wake_tick, wake_wait)
    fuiwirt.host_set_shield(app.app_host(a), p, sh_shield)
    app.set_ctl_edit(a, ctl_edit)
    return c
}

fn sc_of(c: *mut Ctl) -> *mut scene.Scene { return app.app_scene((*c).a) }

fn find(c: *mut Ctl, node: usize) -> usize {
    var i: usize = 0
    while i < (*c).n {
        if (*c).node[i] == node && (*c).kind[i] != K_CTXMAP && (*c).kind[i] != K_TIP {
            return i
        }
        i = i + 1
    }
    return NONE
}

fn add_entry(c: *mut Ctl, kind: u32, node: usize) -> usize {
    if (*c).n >= CTL_MAX {
        return NONE
    }
    let i: usize = (*c).n
    (*c).n = i + 1
    (*c).kind[i] = kind
    (*c).node[i] = node
    (*c).aux[i] = 0
    (*c).page[i] = NONE
    (*c).lo[i] = 0
    (*c).hi[i] = 0
    (*c).last[i] = 0
    (*c).has_cb[i] = false
    (*c).base[i] = 0
    (*c).cnt[i] = 0
    return i
}

fn set_cb(c: *mut Ctl, i: usize, f: fn(*mut app.App, usize)) {
    (*c).cb[i] = f
    (*c).has_cb[i] = true
}

fn fire(c: *mut Ctl, i: usize) {
    if (*c).has_cb[i] {
        let f: fn(*mut app.App, usize) = (*c).cb[i]
        f((*c).a, (*c).node[i])
    }
}

fn touch(c: *mut Ctl) {
    fuiwirt.host_touch(app.app_host((*c).a))
}

fn wid(c: *mut Ctl, i: usize) -> *mut widget.Widget {
    return scene.node_widget(sc_of(c), (*c).node[i])
}

fn name_node(c: *mut Ctl, node: usize, name: str) {
    if name.n > 0 {
        a11y.a11y_set_name(app.ax((*c).a), node, name.p as u64, name.n)
    }
}

// ============================================================ CHECK, RADIO, TOGGLE

// A check box with its text. `on_change(a, id)` runs after a click or the space bar.
fn checkbox(a: *mut app.App, text: str, on: bool, on_change: fn(*mut app.App, usize)) -> usize {
    return bool_control(a, K_CHECK, widget.KIND_CHECKBOX, text, on, 0, on_change)
}

// A switch (on / off) with its text.
fn toggle(a: *mut app.App, text: str, on: bool, on_change: fn(*mut app.App, usize)) -> usize {
    return bool_control(a, K_TOGGLE, widget.KIND_TOGGLE, text, on, 0, on_change)
}

// A radio button of the group `group` (any number you pick; the buttons with the same one
// are exclusive). `on_change` runs for the button that BECAME selected.
fn radio(a: *mut app.App, group: usize, text: str, on: bool,
    on_change: fn(*mut app.App, usize)) -> usize {
    return bool_control(a, K_RADIO, widget.KIND_RADIO, text, on, group, on_change)
}

fn bool_control(a: *mut app.App, kind: u32, wk: u32, text: str, on: bool, group: usize,
    f: fn(*mut app.App, usize)) -> usize {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 {
        return NONE
    }
    if (*c).n >= CTL_MAX {
        return NONE
    }
    let node: usize = app.node_new(a, wk, text)
    if node == NONE {
        return NONE
    }
    let i: usize = add_entry(c, kind, node)
    (*c).aux[i] = group
    set_cb(c, i, f)
    var v: i64 = 0
    if on {
        v = 1
    }
    let e: *mut widget.Widget = scene.node_widget(sc_of(c), node)
    widget.w_set_value(e, v)
    widget.w_set_selected(e, on)
    (*c).last[i] = v
    if kind == K_RADIO && on {
        radio_exclusive(c, i)
    }
    return node
}

// make `i` the only selected button of its group (no callback)
fn radio_exclusive(c: *mut Ctl, i: usize) {
    var j: usize = 0
    while j < (*c).n {
        if j != i && (*c).kind[j] == K_RADIO && (*c).aux[j] == (*c).aux[i] {
            let e: *mut widget.Widget = wid(c, j)
            widget.w_set_value(e, 0)
            widget.w_set_selected(e, false)
            (*c).last[j] = 0
        }
        j = j + 1
    }
}

fn checked(a: *mut app.App, id: usize) -> bool {
    let c: *mut Ctl = st(a)
    let i: usize = find(c, id)
    if i == NONE {
        return false
    }
    return widget.w_value(wid(c, i)) != 0
}

fn set_checked(a: *mut app.App, id: usize, on: bool) {
    let c: *mut Ctl = st(a)
    let i: usize = find(c, id)
    if i == NONE {
        return
    }
    var v: i64 = 0
    if on {
        v = 1
    }
    let e: *mut widget.Widget = wid(c, i)
    widget.w_set_value(e, v)
    widget.w_set_selected(e, on)
    (*c).last[i] = v
    if (*c).kind[i] == K_RADIO && on {
        radio_exclusive(c, i)
    }
    touch(c)
}

// Enable or disable a control (a disabled one takes neither mouse nor focus).
fn set_enabled(a: *mut app.App, id: usize, on: bool) {
    let c: *mut Ctl = st(a)
    if id >= scene.scene_count(sc_of(c)) {
        return
    }
    widget.w_set_disabled(scene.node_widget(sc_of(c), id), !on)
    touch(c)
}

// ============================================================ SLIDER, PROGRESS, SPINBOX

fn permille(v: i64, lo: i64, hi: i64) -> i64 {
    if hi <= lo {
        return 0
    }
    return control.clamp_i64(((v - lo) * 1000 + (hi - lo) / 2) / (hi - lo), 0, 1000)
}

fn from_permille(p: i64, lo: i64, hi: i64) -> i64 {
    return lo + (p * (hi - lo) + 500) / 1000
}

// A horizontal slider over `lo ..= hi`, starting at `init`; `name` is what a screen reader says.
// Drag it, or use the arrows / Home / End / Page keys.
fn slider(a: *mut app.App, name: str, lo: i64, hi: i64, init: i64,
    on_change: fn(*mut app.App, usize)) -> usize {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 || (*c).n >= CTL_MAX {
        return NONE
    }
    let node: usize = app.custom(a, widget.KIND_SLIDER, 220, 24)
    if node == NONE {
        return NONE
    }
    let i: usize = add_entry(c, K_SLIDER, node)
    (*c).lo[i] = lo
    (*c).hi[i] = hi
    set_cb(c, i, on_change)
    let p: i64 = permille(init, lo, hi)
    widget.w_set_value(scene.node_widget(sc_of(c), node), p)
    (*c).last[i] = p
    name_node(c, node, name)
    return node
}

// A progress bar over `lo ..= hi`.
fn progress(a: *mut app.App, name: str, lo: i64, hi: i64, init: i64) -> usize {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 || (*c).n >= CTL_MAX {
        return NONE
    }
    let node: usize = app.custom(a, widget.KIND_PROGRESS, 220, 14)
    if node == NONE {
        return NONE
    }
    let i: usize = add_entry(c, K_PROGRESS, node)
    (*c).lo[i] = lo
    (*c).hi[i] = hi
    let p: i64 = permille(init, lo, hi)
    widget.w_set_value(scene.node_widget(sc_of(c), node), p)
    (*c).last[i] = p
    name_node(c, node, name)
    return node
}

// A number box over `lo ..= hi` changing by `step`: "-" and "+" at its ends, Up / Down / Page keys.
fn spinbox(a: *mut app.App, name: str, lo: i64, hi: i64, step: i64, init: i64,
    on_change: fn(*mut app.App, usize)) -> usize {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 || (*c).n >= CTL_MAX {
        return NONE
    }
    let node: usize = app.node_new(a, widget.KIND_BUTTON, "0")
    if node == NONE {
        return NONE
    }
    app.set_width(a, node, 120)
    let i: usize = add_entry(c, K_SPIN, node)
    (*c).lo[i] = lo
    (*c).hi[i] = hi
    (*c).aux[i] = step as usize
    set_cb(c, i, on_change)
    var v: i64 = control.clamp_i64(init, lo, hi)
    (*c).last[i] = v
    widget.w_set_value(scene.node_widget(sc_of(c), node), v)
    app.set_number(a, node, v)
    scene.node_set_draw(sc_of(c), node, c as u64, draw_spin)
    name_node(c, node, name)
    return node
}

fn spin_step(c: *mut Ctl, i: usize) -> i64 {
    let s: i64 = (*c).aux[i] as i64
    if s < 1 {
        return 1
    }
    return s
}

// move a spin box by `d` (clamped); true when the number changed
fn spin_move(c: *mut Ctl, i: usize, d: i64) -> bool {
    let v: i64 = control.clamp_i64((*c).last[i] + d, (*c).lo[i], (*c).hi[i])
    if v == (*c).last[i] {
        return false
    }
    (*c).last[i] = v
    widget.w_set_value(wid(c, i), v)
    app.set_number((*c).a, (*c).node[i], v)
    fire(c, i)
    return true
}

// the "-" and "+" marks of a number box, on top of the button's own picture
fn draw_spin(ud: u64, rc: *mut render.Ctx, e: *mut widget.Widget) {
    let zone: f64 = kit.ln(rc, SPIN_ZONE_PT)
    let size: f64 = kit.ln(rc, 16)
    let col: u32 = kit.tokc(rc, style.TOK_TEXT)
    let x0: f64 = widget.w_x(e)
    let y0: f64 = widget.w_y(e)
    let h: f64 = widget.w_h(e)
    let tw: f64 = kit.text_width(rc, size, 400, "-")
    let t1: f64 = kit.draw_label(rc, x0 + (zone - tw) / 2.0, y0, h, size, 400, col, "-", 0.0)
    let pw: f64 = kit.text_width(rc, size, 400, "+")
    let t2: f64 = kit.draw_label(rc, x0 + widget.w_w(e) - zone + (zone - pw) / 2.0, y0, h, size,
        400, col, "+", 0.0)
}

// The value of a slider / progress / spin box in ITS units (lo ..= hi).
fn value(a: *mut app.App, id: usize) -> i64 {
    let c: *mut Ctl = st(a)
    let i: usize = find(c, id)
    if i == NONE {
        return 0
    }
    if (*c).kind[i] == K_SPIN {
        return (*c).last[i]
    }
    return from_permille(widget.w_value(wid(c, i)), (*c).lo[i], (*c).hi[i])
}

fn set_value(a: *mut app.App, id: usize, v: i64) {
    let c: *mut Ctl = st(a)
    let i: usize = find(c, id)
    if i == NONE {
        return
    }
    if (*c).kind[i] == K_SPIN {
        let w: i64 = control.clamp_i64(v, (*c).lo[i], (*c).hi[i])
        (*c).last[i] = w
        widget.w_set_value(wid(c, i), w)
        app.set_number(a, id, w)
        return
    }
    let p: i64 = permille(v, (*c).lo[i], (*c).hi[i])
    widget.w_set_value(wid(c, i), p)
    (*c).last[i] = p
    touch(c)
}

// ============================================================ DROP-DOWN

// A drop-down list (not editable). Add the entries with `dropdown_add`; the first is chosen.
// `on_change(a, id)` runs when the user picks another one.
fn dropdown(a: *mut app.App, name: str, on_change: fn(*mut app.App, usize)) -> usize {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 || (*c).n >= CTL_MAX {
        return NONE
    }
    let node: usize = app.node_new(a, widget.KIND_DROPDOWN, " ")
    if node == NONE {
        return NONE
    }
    app.set_width(a, node, 180)
    let i: usize = add_entry(c, K_DROP, node)
    (*c).base[i] = (*c).n_opts
    (*c).last[i] = 0
    set_cb(c, i, on_change)
    name_node(c, node, name)
    return node
}

// Add an entry (its text must outlive the window). false when full.
fn dropdown_add(a: *mut app.App, id: usize, text: str) -> bool {
    let c: *mut Ctl = st(a)
    let i: usize = find(c, id)
    if i == NONE || (*c).kind[i] != K_DROP {
        return false
    }
    // the entries of one drop-down must be the last ones added (they stand in a row of the pool)
    if (*c).base[i] + (*c).cnt[i] != (*c).n_opts || (*c).n_opts >= OPT_MAX {
        return false
    }
    (*c).opts[(*c).n_opts] = text
    (*c).n_opts = (*c).n_opts + 1
    (*c).cnt[i] = (*c).cnt[i] + 1
    if (*c).cnt[i] == 1 {
        app.set_text(a, id, text)
    }
    return true
}

// The index chosen in a drop-down / the selected tab (0 ..).
fn selected(a: *mut app.App, id: usize) -> usize {
    let c: *mut Ctl = st(a)
    let i: usize = find(c, id)
    if i == NONE {
        return NONE
    }
    if (*c).kind[i] == K_DROP {
        return (*c).last[i] as usize
    }
    if (*c).kind[i] == K_TAB {
        return tab_index(c, i)
    }
    return NONE
}

fn set_selected(a: *mut app.App, id: usize, k: usize) {
    let c: *mut Ctl = st(a)
    let i: usize = find(c, id)
    if i == NONE {
        return
    }
    if (*c).kind[i] == K_DROP {
        drop_choose(c, i, k, false)
    }
    if (*c).kind[i] == K_TAB {
        let t: usize = tab_nth(c, (*c).aux[i], k)
        if t != NONE {
            tab_select(c, t)
        }
    }
}

fn drop_choose(c: *mut Ctl, i: usize, k: usize, notify: bool) {
    if k >= (*c).cnt[i] {
        return
    }
    let changed: bool = (*c).last[i] != k as i64
    (*c).last[i] = k as i64
    app.set_text((*c).a, (*c).node[i], (*c).opts[(*c).base[i] + k])
    if changed && notify {
        fire(c, i)
    }
}

fn open_dropdown(a: *mut app.App, id: usize) -> bool {
    let c: *mut Ctl = st(a)
    let i: usize = find(c, id)
    if i == NONE || (*c).kind[i] != K_DROP || (*c).cnt[i] == 0 {
        return false
    }
    (*c).drop_open = true
    (*c).drop_ctl = i
    (*c).drop_hot = (*c).last[i] as usize
    touch(c)
    return true
}

fn dropdown_is_open(a: *mut app.App) -> bool {
    let c: *mut Ctl = st(a)
    return (*c).drop_open
}

fn drop_close(c: *mut Ctl) {
    (*c).drop_open = false
    touch(c)
}

// The rectangle of the open list (x, y, w, h) in window pixels; false when none is open.
fn popup_rect(a: *mut app.App, out: *mut [f64; 4]) -> bool {
    let c: *mut Ctl = st(a)
    if !(*c).drop_open {
        return false
    }
    let rc: *mut render.Ctx = app.app_ctx(a)
    let sc: *mut scene.Scene = sc_of(c)
    let node: usize = (*c).node[(*c).drop_ctl]
    let rh: f64 = wave2.menu_item_height(rc)
    let h: f64 = rh * ((*c).cnt[(*c).drop_ctl] as f64) + kit.ln(rc, 8)
    var y: f64 = scene.node_y(sc, node) + scene.node_h(sc, node) + kit.ln(rc, 2)
    if y + h > (*c).win_h {
        y = scene.node_y(sc, node) - h - kit.ln(rc, 2)
    }
    if y < 0.0 {
        y = 0.0
    }
    (*out)[0] = scene.node_x(sc, node)
    (*out)[1] = y
    (*out)[2] = scene.node_w(sc, node)
    (*out)[3] = h
    return true
}

fn drop_row_at(c: *mut Ctl, x: f64, y: f64) -> usize {
    var r: [f64; 4] = [0.0; 4]
    if !popup_rect((*c).a, &r) {
        return NONE
    }
    if x < r[0] || x >= r[0] + r[2] || y < r[1] || y >= r[1] + r[3] {
        return NONE
    }
    let rc: *mut render.Ctx = app.app_ctx((*c).a)
    let pad: f64 = kit.ln(rc, 4)
    let k: f64 = (y - r[1] - pad) / wave2.menu_item_height(rc)
    if k < 0.0 {
        return NONE
    }
    let row: usize = k as usize
    if row >= (*c).cnt[(*c).drop_ctl] {
        return NONE
    }
    return row
}

fn draw_drop(c: *mut Ctl, rc: *mut render.Ctx) {
    var r: [f64; 4] = [0.0; 4]
    if !popup_rect((*c).a, &r) {
        return
    }
    var p: widget.Widget = widget.widget_new(widget.KIND_MENU)
    widget.w_place(&p, r[0], r[1], r[2], r[3])
    wave2.draw_menu(rc, &p)
    let i: usize = (*c).drop_ctl
    let rh: f64 = wave2.menu_item_height(rc)
    let pad: f64 = kit.ln(rc, 4)
    var k: usize = 0
    while k < (*c).cnt[i] {
        let s: str = (*c).opts[(*c).base[i] + k]
        var e: widget.Widget = widget.widget_new(widget.KIND_MENU)
        widget.w_place(&e, r[0] + pad, r[1] + pad + rh * (k as f64), r[2] - 2.0 * pad, rh)
        widget.w_set_text(&e, s.p as u64, s.n)
        widget.w_set_hover(&e, k == (*c).drop_hot)
        wave2.draw_menu_item(rc, &e, (*c).last[i] == k as i64, false)
        k = k + 1
    }
}

// keys while the list is open: Up / Down / Home / End move, Enter / Space choose, Esc closes
fn drop_key(c: *mut Ctl, key: u32, mods: u32) {
    let i: usize = (*c).drop_ctl
    let n: usize = (*c).cnt[i]
    if key == editor.KEY_UP && (*c).drop_hot > 0 && (*c).drop_hot != NONE {
        (*c).drop_hot = (*c).drop_hot - 1
    } else if key == editor.KEY_DOWN && (*c).drop_hot + 1 < n {
        if (*c).drop_hot == NONE {
            (*c).drop_hot = 0
        } else {
            (*c).drop_hot = (*c).drop_hot + 1
        }
    } else if key == editor.KEY_HOME {
        (*c).drop_hot = 0
    } else if key == editor.KEY_END {
        (*c).drop_hot = n - 1
    } else if key == editor.KEY_ENTER {
        if (*c).drop_hot != NONE {
            drop_choose(c, i, (*c).drop_hot, true)
        }
        drop_close(c)
    } else if key == editor.KEY_ESC || key == editor.KEY_TAB {
        drop_close(c)
    }
    touch(c)
}

// ============================================================ TABS

// Tabs: `tabs` opens the row of the tab buttons, `tab(a, text)` adds one each, `tabs_end`
// closes the row. The pages follow: `tab_page(a, group)` opens a column for the page of the
// next tab (close it with app.end). Returns the group (use it for `tab_page`).
fn tabs(a: *mut app.App) -> usize {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 {
        return NONE
    }
    let g: usize = (*c).groups
    (*c).groups = g + 1
    let r: usize = app.row(a)
    return g
}

fn tab(a: *mut app.App, group: usize, text: str, on_change: fn(*mut app.App, usize)) -> usize {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 || (*c).n >= CTL_MAX {
        return NONE
    }
    let node: usize = app.node_new(a, widget.KIND_TAB, text)
    if node == NONE {
        return NONE
    }
    let i: usize = add_entry(c, K_TAB, node)
    (*c).aux[i] = group
    set_cb(c, i, on_change)
    // the first tab of a group starts selected
    if tab_nth(c, group, 1) == NONE {
        widget.w_set_selected(scene.node_widget(sc_of(c), node), true)
        (*c).last[i] = 1
    }
    return node
}

fn tabs_end(a: *mut app.App) {
    app.end(a)
}

// the page of the next tab of the group: a column, close it with app.end
fn tab_page(a: *mut app.App, group: usize) -> usize {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 {
        return NONE
    }
    // the first tab without a page gets it
    var i: usize = 0
    while i < (*c).n {
        if (*c).kind[i] == K_TAB && (*c).aux[i] == group && (*c).page[i] == NONE {
            let p: usize = app.column(a)
            (*c).page[i] = p
            page_show(c, i, (*c).last[i] != 0)
            return p
        }
        i = i + 1
    }
    return NONE
}

fn page_show(c: *mut Ctl, i: usize, on: bool) {
    let p: usize = (*c).page[i]
    if p == NONE {
        return
    }
    scene.node_set_hidden(sc_of(c), p, !on)
    if on {
        scene.node_set_bounds(sc_of(c), p, 0, 0)
    } else {
        scene.node_set_bounds(sc_of(c), p, 1, 1)
    }
}

// the k-th tab (0 ..) of a group as an entry index, NONE if there is none
fn tab_nth(c: *mut Ctl, group: usize, k: usize) -> usize {
    var seen: usize = 0
    var i: usize = 0
    while i < (*c).n {
        if (*c).kind[i] == K_TAB && (*c).aux[i] == group {
            if seen == k {
                return i
            }
            seen = seen + 1
        }
        i = i + 1
    }
    return NONE
}

fn tab_index(c: *mut Ctl, t: usize) -> usize {
    var seen: usize = 0
    var i: usize = 0
    while i < t {
        if (*c).kind[i] == K_TAB && (*c).aux[i] == (*c).aux[t] {
            seen = seen + 1
        }
        i = i + 1
    }
    return seen
}

fn tab_count(c: *mut Ctl, group: usize) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < (*c).n {
        if (*c).kind[i] == K_TAB && (*c).aux[i] == group {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// select tab `t` (an entry) and show its page; no callback
fn tab_select(c: *mut Ctl, t: usize) {
    var j: usize = 0
    while j < (*c).n {
        if (*c).kind[j] == K_TAB && (*c).aux[j] == (*c).aux[t] {
            let on: bool = j == t
            widget.w_set_selected(wid(c, j), on)
            if on {
                (*c).last[j] = 1
            } else {
                (*c).last[j] = 0
            }
            page_show(c, j, on)
        }
        j = j + 1
    }
    touch(c)
}

// ============================================================ EXPANDER

// A header that shows / hides the body below it. `expander_body` opens the body column (close it
// with app.end).
fn expander(a: *mut app.App, title: str, open: bool, on_change: fn(*mut app.App, usize)) -> usize {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 || (*c).n >= CTL_MAX {
        return NONE
    }
    let node: usize = app.node_new(a, widget.KIND_BUTTON, "")
    if node == NONE {
        return NONE
    }
    let i: usize = add_entry(c, K_EXPAND, node)
    (*c).tip[i] = title
    set_cb(c, i, on_change)
    if open {
        (*c).last[i] = 1
    }
    expander_label(c, i)
    return node
}

fn expander_label(c: *mut Ctl, i: usize) {
    if (*c).last[i] != 0 {
        app.set_text((*c).a, (*c).node[i], "v ")
    } else {
        app.set_text((*c).a, (*c).node[i], "> ")
    }
    app.append_text((*c).a, (*c).node[i], (*c).tip[i])
    a11y.a11y_set_expanded(app.ax((*c).a), (*c).node[i], (*c).last[i] as u32)
}

fn expander_body(a: *mut app.App, id: usize) -> usize {
    let c: *mut Ctl = st(a)
    let i: usize = find(c, id)
    if i == NONE || (*c).kind[i] != K_EXPAND {
        return NONE
    }
    let p: usize = app.column(a)
    (*c).page[i] = p
    body_show(c, i)
    return p
}

fn body_show(c: *mut Ctl, i: usize) {
    let p: usize = (*c).page[i]
    if p == NONE {
        return
    }
    let on: bool = (*c).last[i] != 0
    scene.node_set_hidden(sc_of(c), p, !on)
    if on {
        scene.node_set_bounds(sc_of(c), p, 0, 0)
    } else {
        scene.node_set_bounds(sc_of(c), p, 1, 1)
    }
}

fn expanded(a: *mut app.App, id: usize) -> bool {
    let c: *mut Ctl = st(a)
    let i: usize = find(c, id)
    if i == NONE {
        return false
    }
    return (*c).last[i] != 0
}

fn set_expanded(a: *mut app.App, id: usize, on: bool) {
    let c: *mut Ctl = st(a)
    let i: usize = find(c, id)
    if i == NONE || (*c).kind[i] != K_EXPAND {
        return
    }
    if on {
        (*c).last[i] = 1
    } else {
        (*c).last[i] = 0
    }
    expander_label(c, i)
    body_show(c, i)
    touch(c)
}

// ============================================================ MENUS

// A menu bar (a row of headers), menus with items, separators, check items, shortcuts and
// Alt+letter. The items are ACTIONS of the window's registry (action.fi): the same entry shows its
// shortcut in the menu and runs from the keyboard, and the popup is the context-menu popup
// (menuview.fi). Menus are made in this order: menubar, menu, its items, menu, its items ...,
// menubar_end. The items of one menu must follow it directly (one row of a pool).

// The row that holds the menu headers; close it with `menubar_end`.
fn menubar(a: *mut app.App) -> usize {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 {
        return NONE
    }
    let r: usize = app.row(a)
    (*c).mbar = true
    return r
}

fn menubar_end(a: *mut app.App) {
    app.end(a)
}

// the label without '&' into `out`; `mn` gets the mnemonic letter (lower case, 0 = none) and
// `at` its index in the clean text (NONE = none)
#[allow_escape]
fn clean_label(raw: str, out: *mut [u8; 64], mn: *mut u32, at: *mut usize) -> usize {
    var n: usize = 0
    var i: usize = 0
    *mn = 0 as u32
    *at = NONE
    while i < raw.n && n < 63 {
        let b: u8 = *((raw.p as u64 + i as u64) as *mut u8)
        if b == 38 as u8 && i + 1 < raw.n {
            let nx: u8 = *((raw.p as u64 + (i + 1) as u64) as *mut u8)
            if nx == 38 as u8 {
                (*out)[n] = 38 as u8
                n = n + 1
                i = i + 2
            } else {
                if *mn == 0 as u32 {
                    var lc: u32 = nx as u32
                    if lc >= 65 as u32 && lc <= 90 as u32 {
                        lc = lc + 32 as u32
                    }
                    *mn = lc
                    *at = n
                }
                i = i + 1
            }
        } else {
            (*out)[n] = b
            n = n + 1
            i = i + 1
        }
    }
    return n
}

// A menu header in the bar ("&File": Alt+F opens it). Returns the header's node (the menu's id).
#[allow_escape]
fn menu(a: *mut app.App, label: str) -> usize {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 || (*c).n >= CTL_MAX {
        return NONE
    }
    var buf: [u8; 64] = [0 as u8; 64]
    var mn: u32 = 0 as u32
    var at: usize = NONE
    let n: usize = clean_label(label, &buf, &mn, &at)
    let node: usize = app.node_new(a, widget.KIND_BUTTON, str { p: (&buf[0]) as *mut u8, n: n })
    if node == NONE {
        return NONE
    }
    let i: usize = add_entry(c, K_MENU, node)
    (*c).aux[i] = mn as usize
    (*c).lo[i] = at as i64
    (*c).base[i] = (*c).n_macts
    scene.node_set_draw(sc_of(c), node, c as u64, draw_header)
    let ok: bool = app.on_context(a, node, menu_provider)
    return node
}

// A menu without a header: for context_menu or a menu the program opens itself. Returns its id.
fn popup_menu(a: *mut app.App) -> usize {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 || (*c).n >= CTL_MAX {
        return NONE
    }
    let id: usize = MENU_VIRT + (*c).n
    let i: usize = add_entry(c, K_POPUP, id)
    (*c).base[i] = (*c).n_macts
    return id
}

// Make the menu `m` the context menu of `node` (and everything inside it): right click, the
// menu key and Shift+F10 open it.
fn context_menu(a: *mut app.App, node: usize, m: usize) -> bool {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 || (*c).n >= CTL_MAX {
        return false
    }
    let mi: usize = find(c, m)
    if mi == NONE || ((*c).kind[mi] != K_MENU && (*c).kind[mi] != K_POPUP) {
        return false
    }
    let i: usize = add_entry(c, K_CTXMAP, node)
    (*c).aux[i] = mi
    return app.on_context(a, node, menu_provider)
}

fn item_run(ud: u64, cx: *mut action.ActCtx) {
    let r: *mut Rec = ud as *mut Rec
    let c: *mut Ctl = (*r).c
    let k: usize = (*r).k
    if (*c).ichk[k] != 0 as u32 {
        (*c).ichk[k] = (3 as u32) - (*c).ichk[k]
    }
    let f: fn(*mut app.App, usize) = (*c).icb[k]
    f((*c).a, (*c).macts[k])
}

fn item_enabled(ud: u64, cx: *mut action.ActCtx) -> bool {
    let r: *mut Rec = ud as *mut Rec
    return (*(*r).c).ien[(*r).k]
}

fn item_check(ud: u64, cx: *mut action.ActCtx) -> u32 {
    let r: *mut Rec = ud as *mut Rec
    return (*(*r).c).ichk[(*r).k]
}

fn item_add(a: *mut app.App, m: usize, id: str, label: str, chk: u32,
    cb: fn(*mut app.App, usize)) -> usize {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 {
        return NONE
    }
    let i: usize = find(c, m)
    if i == NONE || ((*c).kind[i] != K_MENU && (*c).kind[i] != K_POPUP) {
        return NONE
    }
    // the items of one menu stand in a row of the pool: they must be added right after the menu
    if (*c).base[i] + (*c).cnt[i] != (*c).n_macts || (*c).n_macts >= OPT_MAX {
        return NONE
    }
    let r: *mut action.Actions = app.actions(a)
    let k: usize = (*c).n_macts
    (*c).irec[k] = Rec { c: c, k: k }
    let act: usize = action.act_add(r, id, label, item_run, (&(*c).irec[k]) as u64)
    if act == action.ACT_NONE {
        return NONE
    }
    action.act_set_enabled(r, act, item_enabled)
    if chk != 0 as u32 {
        action.act_set_check(r, act, item_check)
    }
    (*c).macts[k] = act
    (*c).ichk[k] = chk
    (*c).ien[k] = true
    (*c).icb[k] = cb
    (*c).n_macts = k + 1
    (*c).cnt[i] = (*c).cnt[i] + 1
    return act
}

// An item: `id` is the action's verb (unique in the window), `label` its text ("&Open"; the
// letter after '&' is the mnemonic). `on_select(a, act)` runs when it is chosen -- by mouse,
// keyboard, mnemonic or shortcut. Returns the action index (the item's id), NONE when full.
fn menu_item(a: *mut app.App, m: usize, id: str, label: str,
    on_select: fn(*mut app.App, usize)) -> usize {
    return item_add(a, m, id, label, 0 as u32, on_select)
}

// An item with a tick; choosing it flips the tick, then calls `on_select`.
fn menu_check(a: *mut app.App, m: usize, id: str, label: str, on: bool,
    on_select: fn(*mut app.App, usize)) -> usize {
    var k: u32 = 1 as u32
    if on {
        k = 2 as u32
    }
    return item_add(a, m, id, label, k, on_select)
}

// A line between two groups of items.
fn menu_sep(a: *mut app.App, m: usize) -> bool {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 {
        return false
    }
    let i: usize = find(c, m)
    if i == NONE || ((*c).kind[i] != K_MENU && (*c).kind[i] != K_POPUP) {
        return false
    }
    if (*c).base[i] + (*c).cnt[i] != (*c).n_macts || (*c).n_macts >= OPT_MAX {
        return false
    }
    (*c).macts[(*c).n_macts] = SEP_MARK
    (*c).n_macts = (*c).n_macts + 1
    (*c).cnt[i] = (*c).cnt[i] + 1
    return true
}

// The keyboard shortcut of an item: `key` is the capital letter (83 = 'S') or an action.SK_* key,
// `mods` is action.MOD_CTRL / MOD_SHIFT / MOD_ALT. It is shown in the menu and works anywhere
// in the window.
fn menu_shortcut(a: *mut app.App, act: usize, key: u32, mods: u32) {
    let r: *mut action.Actions = app.actions(a)
    if act < action.act_count(r) {
        action.act_set_shortcut(r, act, key, mods)
    }
}

fn slot_of_act(c: *mut Ctl, act: usize) -> usize {
    var k: usize = 0
    while k < (*c).n_macts {
        if (*c).macts[k] == act {
            return k
        }
        k = k + 1
    }
    return NONE
}

// Grey an item out (it neither shows as available nor runs).
fn menu_enable(a: *mut app.App, act: usize, on: bool) {
    let c: *mut Ctl = st(a)
    let k: usize = slot_of_act(c, act)
    if k != NONE {
        (*c).ien[k] = on
    }
}

fn menu_checked(a: *mut app.App, act: usize) -> bool {
    let c: *mut Ctl = st(a)
    let k: usize = slot_of_act(c, act)
    return k != NONE && (*c).ichk[k] == 2 as u32
}

fn menu_set_checked(a: *mut app.App, act: usize, on: bool) {
    let c: *mut Ctl = st(a)
    let k: usize = slot_of_act(c, act)
    if k != NONE && (*c).ichk[k] != 0 as u32 {
        if on {
            (*c).ichk[k] = 2 as u32
        } else {
            (*c).ichk[k] = 1 as u32
        }
    }
}

// The provider of a menu: asked when a menu is requested at a node (the header, or a node inside
// one with a context menu); it puts the items of the nearest menu in.
fn menu_provider(ud: u64, pc: *mut ctxmenu.ProviderCtx) {
    let a: *mut app.App = ud as *mut app.App
    let c: *mut Ctl = st(a)
    let sc: *mut scene.Scene = sc_of(c)
    var n: usize = ctxmenu.pc_target(pc)
    var mi: usize = NONE
    var guard: usize = 0
    while n != scene.SCENE_NONE && n < scene.scene_count(sc) && mi == NONE && guard < 64 {
        var i: usize = 0
        while i < (*c).n && mi == NONE {
            if (*c).node[i] == n {
                if (*c).kind[i] == K_MENU {
                    mi = i
                } else if (*c).kind[i] == K_CTXMAP {
                    mi = (*c).aux[i]
                }
            }
            i = i + 1
        }
        n = scene.scene_parent(sc, n)
        guard = guard + 1
    }
    if mi == NONE {
        return
    }
    var g: u32 = 1 as u32
    var k: usize = 0
    while k < (*c).cnt[mi] {
        let slot: usize = (*c).base[mi] + k
        if (*c).macts[slot] == SEP_MARK {
            g = g + 1 as u32
        } else {
            let e: usize = ctxmenu.pc_add(pc, (*c).macts[slot])
            ctxmenu.pc_group(pc, e, g)
        }
        k = k + 1
    }
}

// Open the menu of header entry `i` under its header.
fn open_menu(c: *mut Ctl, i: usize) -> bool {
    let a: *mut app.App = (*c).a
    let sc: *mut scene.Scene = sc_of(c)
    let node: usize = (*c).node[i]
    let y0: f64 = scene.node_y(sc, node)
    let ch: u32 = fuiwirt.host_context(app.app_host(a), action.SRC_API, node,
        scene.node_x(sc, node), y0 + scene.node_h(sc, node), y0)
    let open: bool = ctxmenu.ctx_is_open(app.context(a))
    if open {
        (*c).mhdr = i
    }
    touch(c)
    return open
}

// Open the menu of the header `m` from the program (as Alt+letter does).
fn open_menu_id(a: *mut app.App, m: usize) -> bool {
    let c: *mut Ctl = st(a)
    let i: usize = find(c, m)
    if i == NONE || (*c).kind[i] != K_MENU {
        return false
    }
    return open_menu(c, i)
}

// Is a menu of the bar open now?
fn menu_is_open(a: *mut app.App) -> bool {
    let c: *mut Ctl = st(a)
    return menuview.mv_is_open(mv_of(c))
}

// the header after (or before) `i`, wrapping
fn header_next(c: *mut Ctl, i: usize, back: bool) -> usize {
    var j: usize = i
    var n: usize = 0
    while n < (*c).n {
        if back {
            if j == 0 {
                j = (*c).n - 1
            } else {
                j = j - 1
            }
        } else {
            j = (j + 1) % (*c).n
        }
        if (*c).kind[j] == K_MENU {
            return j
        }
        n = n + 1
    }
    return i
}

// the header with the mnemonic `cp` (lower case), NONE if none
fn header_by_mnemonic(c: *mut Ctl, cp: u32) -> usize {
    var i: usize = 0
    while i < (*c).n {
        if (*c).kind[i] == K_MENU && (*c).aux[i] == cp as usize {
            return i
        }
        i = i + 1
    }
    return NONE
}

// A header: a quiet text, a rounded fill when the pointer is on it or its menu is open, the
// mnemonic letter underlined.
fn draw_header(ud: u64, rc: *mut render.Ctx, e: *mut widget.Widget) {
    let c: *mut Ctl = ud as *mut Ctl
    let z: *mut painter.Painter = render.ctx_painter(rc)
    let i: usize = find(c, scene.scene_node_of(sc_of(c), e))
    let x0: f64 = widget.w_x(e)
    let y0: f64 = widget.w_y(e)
    let w: f64 = widget.w_w(e)
    let h: f64 = widget.w_h(e)
    var lit: bool = widget.w_is_hover(e)
    if i != NONE && (*c).mhdr == i && menuview.mv_is_open(mv_of(c)) {
        lit = true
    }
    if lit {
        painter.round_rect(z, x0, y0 + kit.ln(rc, 2), w, h - kit.ln(rc, 4), kit.ln(rc, 4),
            kit.tokc(rc, style.TOK_BUTTON_HOVER))
    }
    if widget.w_is_focus(e) {
        kit.focus_ring(rc, x0, y0 + kit.ln(rc, 2), w, h - kit.ln(rc, 4), kit.ln(rc, 4), style.TOK_BASE)
    }
    let size: f64 = kit.ln(rc, 14)
    let col: u32 = kit.tokc(rc, style.TOK_TEXT)
    let t: str = str { p: widget.w_text(e) as *mut u8, n: widget.w_text_len(e) }
    let tw: f64 = kit.text_width(rc, size, 400, t)
    let tx: f64 = x0 + (w - tw) / 2.0
    let used: f64 = kit.draw_label(rc, tx, y0, h, size, 400, col, t, 0.0)
    if i != NONE && (*c).lo[i] >= 0 as i64 && ((*c).lo[i] as usize) < t.n {
        let at: usize = (*c).lo[i] as usize
        let pre: f64 = kit.text_width(rc, size, 400, str { p: t.p, n: at })
        let ch: f64 = kit.text_width(rc, size, 400, str { p: (t.p as u64 + at as u64) as *mut u8, n: 1 })
        let by: f64 = painter.text_baseline_mid(z, y0, h, size)
        painter.surface(z, tx + pre, by + kit.ln(rc, 2), ch, kit.ln(rc, 1), col)
    }
}

// Close the open menu and open the next (or previous) header's menu: Left / Right in a menu bar.
fn menu_switch(c: *mut Ctl, back: bool) -> bool {
    let i: usize = (*c).mhdr
    if i == NONE {
        return false
    }
    let j: usize = header_next(c, i, back)
    if j == i {
        return true
    }
    let r: u32 = ctxmenu.ctx_close(app.context((*c).a), ctxmenu.CLOSE_API)
    let o: bool = open_menu(c, j)
    return true
}

// ============================================================ TOOLTIP

// A tooltip for a control (or any node): it shows TIP_DELAY ms after the pointer came to rest on the
// node (or inside it) and goes away with the next move out of it, click, key or dialog.
fn tooltip(a: *mut app.App, id: usize, text: str) -> bool {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 || (*c).n >= CTL_MAX {
        return false
    }
    if id >= scene.scene_count(sc_of(c)) {
        return false
    }
    let i: usize = add_entry(c, K_TIP, id)
    (*c).tip[i] = text
    return true
}

// Is a tooltip showing now?
fn tooltip_shown(a: *mut app.App) -> bool {
    let c: *mut Ctl = st(a)
    return (*c).tip_on && !tip_blocked(c)
}

// the tooltip entry of the node or of its nearest ancestor that has one; NONE if none
fn tip_entry(c: *mut Ctl, node: usize) -> usize {
    let sc: *mut scene.Scene = sc_of(c)
    var n: usize = node
    var guard: usize = 0
    while n != scene.SCENE_NONE && n < scene.scene_count(sc) && guard < 64 {
        var i: usize = 0
        while i < (*c).n {
            if (*c).kind[i] == K_TIP && (*c).node[i] == n {
                return i
            }
            i = i + 1
        }
        n = scene.scene_parent(sc, n)
        guard = guard + 1
    }
    return NONE
}

// Hide the tooltip and keep it hidden until the pointer enters another node. true = was shown.
fn tip_hide(c: *mut Ctl) -> bool {
    let was: bool = (*c).tip_on
    (*c).tip_on = false
    (*c).tip_since = 0 - 1
    return was
}

// the pointer moved: true when the picture changed (a shown tooltip went away)
fn tip_move(c: *mut Ctl, x: f64, y: f64) -> bool {
    let node: usize = scene.scene_hit(sc_of(c), x, y)
    var i: usize = NONE
    if node != scene.SCENE_NONE && node < scene.scene_count(sc_of(c)) {
        i = tip_entry(c, node)
    }
    if i == (*c).tip_node {
        return false
    }
    let was: bool = (*c).tip_on
    (*c).tip_on = false
    (*c).tip_node = i
    (*c).tip_since = fuiwirt.host_now(app.app_host((*c).a))
    return was
}

fn tip_blocked(c: *mut Ctl) -> bool {
    return (*c).dlg != 0 as u32 || (*c).drop_open || sh_blocking(c) || cmb_any_open(c) || dd_running(c) || menuview.mv_is_open(mv_of(c))
}

// the program timer (fuiwirt.host_set_wake): shows the tooltip after the delay, runs the dialog fade
fn wake_tick(ud: u64, now: i64) -> bool {
    let c: *mut Ctl = ud as *mut Ctl
    if ripple.busy(&(*c).rp, now) {
        return true
    }
    if w5_tick(c, now) {
        return true
    }
    if w8_tick(c, now) {
        return true
    }
    if sh_tick(c, now) {
        return true
    }
    if tl_tick(c, now) {
        return true
    }
    if dd_tick_c(c) {
        return true
    }
    // a virtual list (app.vlist_new) running out after a fling or a wheel turn: paint every tick
    if app.vlist_moving((*c).a) {
        return true
    }
    if (*c).dlg != 0 as u32 {
        return kit.modal_animating(&(*c).dlg_m, now)
    }
    if (*c).tip_node == NONE || (*c).tip_on || (*c).tip_since < 0 as i64 || tip_blocked(c) {
        return false
    }
    if now - (*c).tip_since >= TIP_DELAY {
        (*c).tip_on = true
        return true
    }
    return false
}

fn wake_wait(ud: u64, now: i64) -> i64 {
    let c: *mut Ctl = ud as *mut Ctl
    if ripple.busy(&(*c).rp, now) {
        return 16
    }
    if w5_busy(c) {
        return 16
    }
    if w8_busy(c) {
        return 33
    }
    if sh_busy(c) {
        return 16
    }
    if tl_busy(c) {
        return 16
    }
    if dd_wants_timer(c) {
        return 16
    }
    if app.vlist_moving((*c).a) {
        return 16
    }
    if (*c).dlg != 0 as u32 {
        if kit.modal_animating(&(*c).dlg_m, now) {
            return 16
        }
        return 0 - 1
    }
    if (*c).tip_node == NONE || (*c).tip_on || (*c).tip_since < 0 as i64 || tip_blocked(c) {
        return 0 - 1
    }
    let left: i64 = TIP_DELAY - (now - (*c).tip_since)
    if left < 1 as i64 {
        return 1
    }
    return left
}

fn draw_tip(c: *mut Ctl, rc: *mut render.Ctx) {
    let i: usize = (*c).tip_node
    if i == NONE || (*c).tip[i].n == 0 {
        return
    }
    let sc: *mut scene.Scene = sc_of(c)
    let node: usize = (*c).node[i]
    let s: str = (*c).tip[i]
    var bw: f64 = 0.0
    var bh: f64 = 0.0
    wave2.tooltip_size(rc, s.p as u64, s.n, &bw, &bh)
    var ox: f64 = 0.0
    var oy: f64 = 0.0
    let ny: f64 = scene.node_y(sc, node)
    wave2.tooltip_place(scene.node_x(sc, node) + scene.node_w(sc, node) / 2.0, ny, bw, bh,
        (*c).win_w, (*c).win_h, ny, ny + scene.node_h(sc, node), 0.0, 0.0, kit.ln(rc, 4), &ox, &oy)
    var e: widget.Widget = widget.widget_new(widget.KIND_TOOLTIP)
    widget.w_place(&e, ox, oy, bw, bh)
    widget.w_set_text(&e, s.p as u64, s.n)
    wave2.draw_tooltip(rc, &e)
}

// ============================================================ DIALOGS

// MODAL DIALOGS drawn inside the window (kit.Modal: scrim, panel, title, close button, focus ring
// of Tab). `message` has one button (OK), `confirm` OK and Cancel, `input` a text field, OK and
// Cancel. While one is open nothing behind it gets a key or a click. `on_answer(a, ans)` runs
// after the dialog is gone with ANS_OK or ANS_CANCEL (Esc, the close button); an input dialog's
// text is then `dialog_text(a)`. Enter = OK, Esc = cancel, Tab / Left / Right move between the
// buttons. One dialog at a time: a second call while one is open returns false.
//
// The labels of the buttons are in the two functions below (one place for a translation).
fn tr_ok() -> str { return uistr.t("appctl.ok", "OK") }
fn tr_cancel() -> str { return uistr.t("appctl.cancel", "Cancel") }

struct DLay {
    tx: f64, ty: f64, tw: f64, pitch: f64,
    fx: f64, fy: f64, fw: f64, fh: f64,
    ox: f64, oy: f64, cx: f64, cy: f64, bw: f64, bh: f64,
}

fn message(a: *mut app.App, title: str, text: str, on_answer: fn(*mut app.App, u32)) -> bool {
    return dlg_open(a, D_MSG, title, text, "", on_answer)
}

fn confirm(a: *mut app.App, title: str, text: str, on_answer: fn(*mut app.App, u32)) -> bool {
    return dlg_open(a, D_CONFIRM, title, text, "", on_answer)
}

// `prompt` is the line above the field, `initial` the text in it (selected).
fn input(a: *mut app.App, title: str, prompt: str, initial: str,
    on_answer: fn(*mut app.App, u32)) -> bool {
    return dlg_open(a, D_INPUT, title, prompt, initial, on_answer)
}

fn dialog_open(a: *mut app.App) -> bool {
    let c: *mut Ctl = st(a)
    return (*c).dlg != 0 as u32
}

// The text of the input dialog (valid until the next change of it).
fn dialog_text(a: *mut app.App) -> str {
    let c: *mut Ctl = st(a)
    let t: *mut textbuf.TextBuf = editor.editor_buf(&(*c).dlg_ed)
    return str { p: textbuf.tb_ptr(t) as *mut u8, n: textbuf.tb_len(t) }
}

// Answer the open dialog from the program (as a click on the button would).
fn dialog_answer(a: *mut app.App, ans: u32) {
    let c: *mut Ctl = st(a)
    if (*c).dlg != 0 as u32 {
        dlg_finish(c, ans)
    }
}

fn dlg_line_count(t: str) -> usize {
    var n: usize = 1
    var i: usize = 0
    while i < t.n {
        if *((t.p as u64 + i as u64) as *mut u8) == 10 as u8 && n < 8 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// the slot of the OK button in the focus ring (the field is slot 0 in an input dialog)
fn dlg_ok_slot(c: *mut Ctl) -> usize {
    if (*c).dlg == D_INPUT {
        return 1
    }
    return 0
}

fn dlg_open(a: *mut app.App, kind: u32, title: str, text: str, init: str,
    cb: fn(*mut app.App, u32)) -> bool {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 || (*c).dlg != 0 as u32 {
        return false
    }
    if (*c).drop_open {
        drop_close(c)
    }
    cmb_close_all(c)
    dd_stop(c)
    let ctxm: *mut ctxmenu.Ctxm = app.context(a)
    if ctxmenu.ctx_is_open(ctxm) {
        let r: u32 = ctxmenu.ctx_close(ctxm, ctxmenu.CLOSE_API)
    }
    let hh: bool = tip_hide(c)
    (*c).dlg = kind
    (*c).dlg_title = title
    (*c).dlg_text = text
    (*c).dlg_cb = cb
    (*c).dlg_hot = NONE
    (*c).dlg_hclose = false
    var h: usize = 8 + 22 * dlg_line_count(text) + 12 + 32 + 16
    var nf: usize = 1
    if kind == D_CONFIRM {
        nf = 2
    }
    if kind == D_INPUT {
        nf = 3
        h = h + 40
    }
    kit.modal_open(&(*c).dlg_m, title, DLG_W_PT, h, nf, fuiwirt.host_now(app.app_host(a)))
    if kind == D_INPUT {
        editor.editor_set_text(&(*c).dlg_ed, init.p as u64, init.n)
        editor.editor_select_all(&(*c).dlg_ed)
        kit.modal_set_focus(&(*c).dlg_m, 0)
    } else {
        kit.modal_set_focus(&(*c).dlg_m, 0)
    }
    touch(c)
    return true
}

fn dlg_finish(c: *mut Ctl, ans: u32) {
    let f: fn(*mut app.App, u32) = (*c).dlg_cb
    (*c).dlg = 0 as u32
    (*c).dlg_hot = NONE
    kit.modal_close(&(*c).dlg_m)
    touch(c)
    f((*c).a, ans)
}

fn dlg_layout(c: *mut Ctl, rc: *mut render.Ctx) -> DLay {
    var x: f64 = 0.0
    var y: f64 = 0.0
    var w: f64 = 0.0
    var h: f64 = 0.0
    kit.modal_content_rect(rc, &(*c).dlg_m, (*c).win_w, (*c).win_h, &x, &y, &w, &h)
    let pitch: f64 = kit.ln(rc, 22)
    let bw: f64 = kit.ln(rc, BTN_W_PT)
    let bh: f64 = kit.ln(rc, 32)
    let ty: f64 = y + kit.ln(rc, 8)
    let fy: f64 = ty + pitch * (dlg_line_count((*c).dlg_text) as f64) + kit.ln(rc, 8)
    let by: f64 = y + h - bh
    let cx: f64 = x + w - bw
    var ox: f64 = cx
    if (*c).dlg != D_MSG {
        ox = cx - kit.ln(rc, 8) - bw
    }
    return DLay { tx: x, ty: ty, tw: w, pitch: pitch, fx: x, fy: fy, fw: w, fh: kit.ln(rc, 32),
        ox: ox, oy: by, cx: cx, cy: by, bw: bw, bh: bh }
}

fn in_rect(px: f64, py: f64, x: f64, y: f64, w: f64, h: f64) -> bool {
    return px >= x && px < x + w && py >= y && py < y + h
}

// what a point is on: ANS_OK / ANS_CANCEL (a button), 3 (the field), 0 (nothing)
fn dlg_part_at(c: *mut Ctl, x: f64, y: f64) -> u32 {
    let rc: *mut render.Ctx = app.app_ctx((*c).a)
    let l: DLay = dlg_layout(c, rc)
    if in_rect(x, y, l.ox, l.oy, l.bw, l.bh) {
        return ANS_OK
    }
    if (*c).dlg != D_MSG && in_rect(x, y, l.cx, l.cy, l.bw, l.bh) {
        return ANS_CANCEL
    }
    if (*c).dlg == D_INPUT && in_rect(x, y, l.fx, l.fy, l.fw, l.fh) {
        return 3 as u32
    }
    return 0 as u32
}

// The rectangle (x, y, w, h in window pixels) of a part of the open dialog: ANS_OK or ANS_CANCEL
// (a button) or 3 (the input field). false when it is not there. For tests and automation.
fn dialog_rect(a: *mut app.App, part: u32, out: *mut [f64; 4]) -> bool {
    let c: *mut Ctl = st(a)
    if (*c).dlg == 0 as u32 {
        return false
    }
    let l: DLay = dlg_layout(c, app.app_ctx(a))
    if part == ANS_OK {
        (*out)[0] = l.ox
        (*out)[1] = l.oy
    } else if part == ANS_CANCEL && (*c).dlg != D_MSG {
        (*out)[0] = l.cx
        (*out)[1] = l.cy
    } else if part == 3 as u32 && (*c).dlg == D_INPUT {
        (*out)[0] = l.fx
        (*out)[1] = l.fy
        (*out)[2] = l.fw
        (*out)[3] = l.fh
        return true
    } else {
        return false
    }
    (*out)[2] = l.bw
    (*out)[3] = l.bh
    return true
}

fn dlg_esc_answer(c: *mut Ctl) -> u32 {
    if (*c).dlg == D_MSG {
        return ANS_OK
    }
    return ANS_CANCEL
}

// The keys of an open dialog; every key is taken (nothing reaches the window behind it).
fn dlg_key(c: *mut Ctl, key: u32, mods: u32) -> bool {
    let m: *mut kit.Modal = &(*c).dlg_m
    let ok_slot: usize = dlg_ok_slot(c)
    let foc: usize = kit.modal_focus(m)
    let in_field: bool = (*c).dlg == D_INPUT && foc == 0
    let r: u32 = kit.modal_key(m, key, mods)
    if r == kit.MODAL_KEY_CLOSE {
        dlg_finish(c, dlg_esc_answer(c))
        return true
    }
    if r == kit.MODAL_KEY_FOCUS {
        touch(c)
        return true
    }
    if r == kit.MODAL_KEY_ACTIVATE {
        if foc == ok_slot + 1 {
            dlg_finish(c, ANS_CANCEL)
        } else {
            dlg_finish(c, ANS_OK)
        }
        return true
    }
    if in_field {
        let er: u32 = editor.editor_key(&(*c).dlg_ed, key, mods)
        touch(c)
        return true
    }
    // on a button: Left / Right move between the buttons, Space presses the focused one
    if key == editor.KEY_LEFT || key == editor.KEY_RIGHT {
        kit.modal_set_focus(m, kit.ring_next(foc, (*m).n_focus, key == editor.KEY_LEFT))
        touch(c)
        return true
    }
    touch(c)
    return true
}

fn dlg_chr(c: *mut Ctl, cp: u32, mods: u32) -> bool {
    if (*c).dlg == D_INPUT && kit.modal_focus(&(*c).dlg_m) == 0 {
        let er: u32 = editor.editor_char(&(*c).dlg_ed, cp, mods)
        touch(c)
        return true
    }
    if cp == 32 as u32 && (*c).dlg != 0 as u32 {
        let foc: usize = kit.modal_focus(&(*c).dlg_m)
        if foc == dlg_ok_slot(c) + 1 {
            dlg_finish(c, ANS_CANCEL)
        } else {
            dlg_finish(c, ANS_OK)
        }
    }
    return true
}

// the pointer while a dialog is open (the popup sink): hover, press on a button / the field / the X
fn dlg_ptr(c: *mut Ctl, kind: u32, x: f64, y: f64) -> u32 {
    let rc: *mut render.Ctx = app.app_ctx((*c).a)
    let hit: u32 = kit.modal_hit(rc, &(*c).dlg_m, (*c).win_w, (*c).win_h, x, y)
    if kind == fuiwirt.HOOK_MOVE {
        (*c).dlg_hclose = hit == kit.MODAL_HIT_CLOSE
        (*c).dlg_hot = NONE
        let part: u32 = dlg_part_at(c, x, y)
        if part == ANS_OK || part == ANS_CANCEL {
            (*c).dlg_hot = part as usize
        }
    } else if kind == fuiwirt.HOOK_DOWN {
        if hit == kit.MODAL_HIT_CLOSE {
            dlg_finish(c, dlg_esc_answer(c))
        } else if hit == kit.MODAL_HIT_PANEL {
            let part2: u32 = dlg_part_at(c, x, y)
            if part2 == ANS_OK {
                dlg_finish(c, ANS_OK)
            } else if part2 == ANS_CANCEL {
                dlg_finish(c, ANS_CANCEL)
            } else if part2 == 3 as u32 {
                kit.modal_set_focus(&(*c).dlg_m, 0)
                touch(c)
            }
        }
    }
    touch(c)
    return ctxmenu.CR_CONSUMED | ctxmenu.CR_REPAINT
}

fn draw_dlg_button(rc: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, text: str,
    primary: bool, hot: bool, focus: bool) {
    var e: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    widget.w_place(&e, x, y, w, h)
    widget.w_set_text(&e, text.p as u64, text.n)
    widget.w_set_hover(&e, hot)
    widget.w_set_focus(&e, focus)
    if primary {
        wave2.button_variant(render.ctx_theme(rc), &e, wave2.BTN_PRIMARY)
    } else {
        wave2.button_variant(render.ctx_theme(rc), &e, wave2.BTN_SECONDARY)
    }
    render.draw_widget(rc, &e)
}

fn draw_dlg(c: *mut Ctl, rc: *mut render.Ctx) {
    let now: i64 = fuiwirt.host_now(app.app_host((*c).a))
    kit.modal_draw(rc, &(*c).dlg_m, (*c).win_w, (*c).win_h, now, (*c).dlg_hclose)
    let l: DLay = dlg_layout(c, rc)
    let col: u32 = kit.tokc(rc, style.TOK_TEXT)
    let t: str = (*c).dlg_text
    var start: usize = 0
    var k: usize = 0
    var i: usize = 0
    while i <= t.n {
        if i == t.n || *((t.p as u64 + i as u64) as *mut u8) == 10 as u8 {
            if k < 8 {
                let ln1: str = str { p: (t.p as u64 + start as u64) as *mut u8, n: i - start }
                let used: f64 = kit.draw_label(rc, l.tx, l.ty + l.pitch * (k as f64), l.pitch,
                    kit.ln(rc, 14), 400, col, ln1, l.tw)
            }
            k = k + 1
            start = i + 1
        }
        i = i + 1
    }
    let foc: usize = kit.modal_focus(&(*c).dlg_m)
    let ok_slot: usize = dlg_ok_slot(c)
    if (*c).dlg == D_INPUT {
        var f: widget.Widget = widget.widget_new(widget.KIND_TEXTBOX)
        widget.w_place(&f, l.fx, l.fy, l.fw, l.fh)
        widget.w_set_focus(&f, foc == 0)
        render.draw_textfield(rc, &f, &(*c).dlg_ed, foc == 0)
    }
    draw_dlg_button(rc, l.ox, l.oy, l.bw, l.bh, tr_ok(), true, (*c).dlg_hot == ANS_OK as usize,
        foc == ok_slot)
    if (*c).dlg != D_MSG {
        draw_dlg_button(rc, l.cx, l.cy, l.bw, l.bh, tr_cancel(), false,
            (*c).dlg_hot == ANS_CANCEL as usize, foc == ok_slot + 1)
    }
}

// ============================================================ EVENTS

// Compare every control with what was last reported; call back for what the USER changed.
fn sync(c: *mut Ctl) {
    var i: usize = 0
    while i < (*c).n {
        let k: u32 = (*c).kind[i]
        if k == K_CHECK || k == K_TOGGLE || k == K_SLIDER {
            let v: i64 = widget.w_value(wid(c, i))
            if v != (*c).last[i] {
                (*c).last[i] = v
                fire(c, i)
            }
        } else if k == K_RADIO {
            let v2: i64 = widget.w_value(wid(c, i))
            if v2 != (*c).last[i] {
                (*c).last[i] = v2
                if v2 != 0 {
                    radio_exclusive(c, i)
                    (*c).last[i] = 1
                    fire(c, i)
                }
            }
        } else if k == K_TAB {
            let on: bool = widget.w_is_selected(wid(c, i))
            if on && (*c).last[i] == 0 {
                tab_select(c, i)
                fire(c, i)
            }
        }
        i = i + 1
    }
}

fn is_focus_kind(k: u32) -> bool {
    return k == K_SLIDER || k == K_RADIO || k == K_TAB || k == K_SPIN || k == K_DROP
    || k == K_RATING || k == K_SEG || k == K_CHIPS || k == K_PAGER || k == K_PGRID || k == K_RANGE
    || k == K_TIMEP || k == K_CRUMB || k == K_INFOB || k == K_STEPPER
}

// move the keyboard focus to a node
fn focus_node(c: *mut Ctl, node: usize) {
    let r: u32 = control.panel_set_focus(fuiwirt.host_panel(app.app_host((*c).a)), node)
}

// the previous (back) / next entry of the same radio group or tab group, wrapping
fn neighbour(c: *mut Ctl, i: usize, back: bool) -> usize {
    var j: usize = i
    var n: usize = 0
    while n < (*c).n {
        if back {
            if j == 0 {
                j = (*c).n - 1
            } else {
                j = j - 1
            }
        } else {
            j = (j + 1) % (*c).n
        }
        if (*c).kind[j] == (*c).kind[i] && (*c).aux[j] == (*c).aux[i] {
            return j
        }
        n = n + 1
    }
    return i
}

fn slider_move(c: *mut Ctl, i: usize, v: i64) {
    let w: i64 = control.clamp_i64(v, (*c).lo[i], (*c).hi[i])
    let p: i64 = permille(w, (*c).lo[i], (*c).hi[i])
    if p == (*c).last[i] {
        return
    }
    widget.w_set_value(wid(c, i), p)
    (*c).last[i] = p
    fire(c, i)
}

fn ctl_key(ud: u64, key: u32, mods: u32) -> bool {
    let c: *mut Ctl = ud as *mut Ctl
    if (*c).dlg != 0 as u32 {
        return dlg_key(c, key, mods)
    }
    if (*c).drop_open {
        drop_key(c, key, mods)
        return true
    }
    if (*c).sh_on && (*c).sh.cur != kit.NONE {
        if sh_key(c, key) {
            return true
        }
    }
    if dd_key_route(c, key, mods) {
        return true
    }
    if cmb_key_route(c, key, mods) {
        return true
    }
    if (*c).pg_edit_i != NONE {
        if key == editor.KEY_ENTER {
            w6_commit(c)
            return true
        }
        if key == editor.KEY_ESC {
            w6_cancel(c)
            return true
        }
        if key == editor.KEY_TAB {
            w6_commit(c)
            return false
        }
        let er: u32 = editor.editor_key(&(*c).pg_ed, key, mods)
        touch(c)
        return true
    }
    let hid: bool = tip_hide(c)
    if menuview.mv_is_open(mv_of(c)) {
        if (*c).mhdr != NONE && (key == editor.KEY_LEFT || key == editor.KEY_RIGHT) {
            let cm: *mut ctxmenu.Ctxm = app.context((*c).a)
            let d0: usize = ctxmenu.ctx_depth(cm)
            if key == editor.KEY_LEFT {
                if d0 <= 1 {
                    return menu_switch(c, true)
                }
            } else {
                let now: i64 = fuiwirt.host_now(app.app_host((*c).a))
                let kr: u32 = menuview.mv_key(mv_of(c), action.SK_RIGHT, mods, now)
                if ctxmenu.ctx_depth(cm) > d0 {
                    return true
                }
                return menu_switch(c, false)
            }
        }
        return false
    }
    let f: usize = app.focus((*c).a)
    if f == NONE {
        return false
    }
    let i: usize = find(c, f)
    if i == NONE || !is_focus_kind((*c).kind[i]) {
        return false
    }
    let k: u32 = (*c).kind[i]
    let up: bool = key == editor.KEY_UP || key == editor.KEY_LEFT
    let down: bool = key == editor.KEY_DOWN || key == editor.KEY_RIGHT
    if is_w5_kind(k) {
        return w5_key(c, i, key)
    }
    if is_w8_kind(k) {
        return w8_key(c, i, key)
    }
    if k == K_PGRID {
        return w6_key(c, i, key)
    }
    if k == K_SLIDER {
        let cur: i64 = from_permille((*c).last[i], (*c).lo[i], (*c).hi[i])
        var big: i64 = ((*c).hi[i] - (*c).lo[i]) / 10
        if big < 1 {
            big = 1
        }
        if up {
            slider_move(c, i, cur - 1)
        } else if down {
            slider_move(c, i, cur + 1)
        } else if key == editor.KEY_PGUP {
            slider_move(c, i, cur + big)
        } else if key == editor.KEY_PGDN {
            slider_move(c, i, cur - big)
        } else if key == editor.KEY_HOME {
            slider_move(c, i, (*c).lo[i])
        } else if key == editor.KEY_END {
            slider_move(c, i, (*c).hi[i])
        } else {
            return false
        }
        return true
    }
    if k == K_SPIN {
        let st1: i64 = spin_step(c, i)
        if key == editor.KEY_UP {
            let m1: bool = spin_move(c, i, st1)
        } else if key == editor.KEY_DOWN {
            let m2: bool = spin_move(c, i, 0 - st1)
        } else if key == editor.KEY_PGUP {
            let m3: bool = spin_move(c, i, st1 * 10)
        } else if key == editor.KEY_PGDN {
            let m4: bool = spin_move(c, i, 0 - st1 * 10)
        } else if key == editor.KEY_HOME {
            let m5: bool = spin_move(c, i, (*c).lo[i] - (*c).last[i])
        } else if key == editor.KEY_END {
            let m6: bool = spin_move(c, i, (*c).hi[i] - (*c).last[i])
        } else {
            return false
        }
        return true
    }
    if k == K_RADIO || k == K_TAB {
        if !up && !down {
            return false
        }
        let j: usize = neighbour(c, i, up)
        if j == i {
            return true
        }
        if k == K_RADIO {
            widget.w_set_value(wid(c, j), 1)
            widget.w_set_selected(wid(c, j), true)
            radio_exclusive(c, j)
            (*c).last[j] = 1
        } else {
            tab_select(c, j)
        }
        focus_node(c, (*c).node[j])
        fire(c, j)
        return true
    }
    if k == K_DROP {
        if key == editor.KEY_UP && (*c).last[i] > 0 {
            drop_choose(c, i, ((*c).last[i] - 1) as usize, true)
            return true
        }
        if key == editor.KEY_DOWN {
            if ((*c).last[i] as usize) + 1 < (*c).cnt[i] {
                drop_choose(c, i, ((*c).last[i] + 1) as usize, true)
            }
            return true
        }
    }
    return false
}

fn ctl_chr(ud: u64, cp: u32, mods: u32) -> bool {
    let c: *mut Ctl = ud as *mut Ctl
    if (*c).dlg != 0 as u32 {
        return dlg_chr(c, cp, mods)
    }
    if (*c).drop_open {
        return true
    }
    if sh_blocking(c) {
        return true
    }
    if dd_chr_route(c, cp, mods) {
        return true
    }
    if (*c).pg_edit_i != NONE {
        let er: u32 = editor.editor_char(&(*c).pg_ed, cp, mods)
        touch(c)
        return true
    }
    if w8_chr(c, cp, mods) {
        return true
    }
    if menuview.mv_is_open(mv_of(c)) {
        return false
    }
    // Alt+letter opens the menu whose header has that mnemonic
    if (mods & editor.MOD_ALT) != 0 as u32 && (mods & editor.MOD_CTRL) == 0 as u32 {
        var lc: u32 = cp
        if lc >= 65 as u32 && lc <= 90 as u32 {
            lc = lc + 32 as u32
        }
        let h: usize = header_by_mnemonic(c, lc)
        if h != NONE {
            let hh: bool = tip_hide(c)
            let o: bool = open_menu(c, h)
            return true
        }
    }
    return false
}

fn ctl_ptr(ud: u64, kind: u32, x: f64, y: f64) -> bool {
    let c: *mut Ctl = ud as *mut Ctl
    sync(c)
    if kind == fuiwirt.HOOK_WHEEL {
        if w6_wheel(c, y) {
            return true
        }
        if w8_wheel(c, y) {
            return true
        }
    } else {
        (*c).px = x
        (*c).py = y
    }
    if sh_blocking(c) {
        return false
    }
    if dd_ptr_route(c, kind, x, y) {
        return true
    }
    if cmb_ptr_route(c, kind, x, y) {
        return true
    }
    if sh_visible(c) && !(*c).sh.modal {
        // the host keeps a press / move over the panel from the page (the shield); the same events must not
        // reach the controls behind it here either (tooltip, split, ripple, wave 5/6 pointer)
        if fuiwirt.host_shielded(app.app_host((*c).a)) {
            let hid0: bool = tip_hide(c)
            let used0: bool = sh_ptr(c, kind, x, y)
            return true
        }
        if sh_ptr(c, kind, x, y) {
            return true
        }
    }
    if split_ptr(c, kind, x, y) {
        return true
    }
    ripple_ptr(c, kind, x, y)
    var w5r: bool = w5_ptr(c, kind, x, y)
    if w8_ptr(c, kind, x, y) {
        w5r = true
    }
    if w6_ptr(c, kind, x, y) {
        w5r = true
    }
    if kind == fuiwirt.HOOK_MOVE {
        let tm: bool = tip_move(c, x, y)
        return tm || w5r
    }
    let hid: bool = tip_hide(c)
    if kind != fuiwirt.HOOK_DOWN {
        return hid || w5r
    }
    let node: usize = scene.scene_hit(sc_of(c), x, y)
    let i: usize = find(c, node)
    if i == NONE || (*c).kind[i] != K_SPIN {
        return w5r
    }
    let zone: f64 = kit.ln(app.app_ctx((*c).a), SPIN_ZONE_PT)
    let nx: f64 = scene.node_x(sc_of(c), node)
    if x < nx + zone {
        let m1: bool = spin_move(c, i, 0 - spin_step(c, i))
    } else if x >= nx + scene.node_w(sc_of(c), node) - zone {
        let m2: bool = spin_move(c, i, spin_step(c, i))
    }
    return true
}

fn ctl_act(ud: u64, node: usize) {
    let c: *mut Ctl = ud as *mut Ctl
    sync(c)
    let i: usize = find(c, node)
    if i == NONE {
        return
    }
    if is_w8_kind((*c).kind[i]) {
        w8_act(c, i)
    } else if is_w5_kind((*c).kind[i]) {
        w5_act(c, i)
    } else if (*c).kind[i] == K_PGRID {
        w6_act(c, i)
    } else if (*c).kind[i] == K_DROP && !(*c).drop_open {
        let o: bool = open_dropdown((*c).a, node)
    } else if (*c).kind[i] == K_MENU {
        let o2: bool = open_menu(c, i)
    } else if (*c).kind[i] == K_EXPAND {
        set_expanded((*c).a, node, (*c).last[i] == 0)
        fire(c, i)
    }
}

fn ctl_paint(ud: u64, rc: *mut render.Ctx, w: usize, h: usize) {
    let c: *mut Ctl = ud as *mut Ctl
    (*c).win_w = w as f64
    (*c).win_h = h as f64
    draw_sheet(c, rc)
    cmb_paint(c, rc)
    sz_paint(c, rc, w, h)
    if (*c).drop_open {
        draw_drop(c, rc)
    }
    if (*c).tip_on && !tip_blocked(c) {
        draw_tip(c, rc)
    }
    if (*c).dlg != 0 as u32 {
        draw_dlg(c, rc)
    }
    ripple_draw(c, rc)
    dd_paint(c, rc, w, h)
}

// ============================================================ SPLITTER (r240)
//
// Two panes with a draggable bar, as scene nodes:
//
//     let sp: usize = appctl.split_begin(a, true, 300, "Sidebar width", changed)   // side by side, 300 permille
//     ... widgets of pane A ...
//     appctl.split_mid(a)                                                            // bar + pane B
//     ... widgets of pane B ...
//     appctl.split_end(a)
//
// `sp` is the bar node (id of the control, valid after `split_mid`; before it `split_begin` returns the container).
// The bar follows lib/fui/splitter.fi (grab margin, minimum sizes, offset of the grab, Esc cancels the drag); the
// panes are flex children that share the room by weight (pixel sizes of the splitter), so a resize keeps the ratio.
// Entry: node = bar, page = pane A, base = pane B, cnt = container, aux = the heap Splitter.

// A pane shares the room by weight only. Basis and minimum are both one unit: a content minimum (the pane's text
// width) above a zero basis would freeze the pane at once in flex.verteile and it would never grow.
fn split_pane_flex(sc: *mut scene.Scene, pane: usize) {
    scene.node_set_base(sc, pane, 1)
    scene.node_set_bounds(sc, pane, 1, 0)
}

fn split_state(c: *mut Ctl, i: usize) -> *mut splitter.Splitter {
    return (*c).aux[i] as *mut splitter.Splitter
}

// the geometry from the last layout into the splitter, then the panes' weights from the splitter
fn split_apply(c: *mut Ctl, i: usize) {
    let sc: *mut scene.Scene = sc_of(c)
    let s: *mut splitter.Splitter = split_state(c, i)
    let ct: usize = (*c).cnt[i]
    splitter.layout(s, scene.node_x(sc, ct) as i64, scene.node_y(sc, ct) as i64,
        scene.node_w(sc, ct) as i64, scene.node_h(sc, ct) as i64)
    var ra: [i64; 4] = [0, 0, 0, 0]
    var rb: [i64; 4] = [0, 0, 0, 0]
    splitter.pane_a(s, &ra)
    splitter.pane_b(s, &rb)
    var la: i64 = ra[2]
    var lb: i64 = rb[2]
    if (*s).vertical != 0 as u32 {
        la = ra[3]
        lb = rb[3]
    }
    // weights 0 would starve a flex item of its share; one unit keeps the item alive
    scene.node_set_grow(sc, (*c).page[i], la + 1, 0)
    scene.node_set_grow(sc, (*c).base[i], lb + 1, 0)
}

fn split_draw(ud: u64, rc: *mut render.Ctx, e: *mut widget.Widget) {
    let c: *mut Ctl = ud as *mut Ctl
    var i: usize = 0
    while i < (*c).n {
        if (*c).kind[i] == K_SPLIT && wid(c, i) == e {
            let s: *mut splitter.Splitter = split_state(c, i)
            let z: *mut painter.Painter = render.ctx_painter(rc)
            var col: u32 = render.color_of(rc, style.color_token(style.TOK_SEPARATOR))
            if splitter.dragging(s) {
                col = render.color_of(rc, style.color_token(style.TOK_ACCENT))
            } else if splitter.hovered(s) {
                col = render.color_of(rc, style.color_token(style.TOK_BORDER))
            }
            let x: f64 = widget.w_x(e)
            let y: f64 = widget.w_y(e)
            let w: f64 = widget.w_w(e)
            let h: f64 = widget.w_h(e)
            painter.surface(z, x, y, w, h, col)
            let grip: u32 = render.color_of(rc, style.color_token(style.TOK_TEXT_MUTED))
            var k: i64 = 0 - 1
            while k <= 1 {
                if (*s).vertical != 0 as u32 {
                    painter.round_rect(z, x + w / 2.0 + (k * 8) as f64 - 1.0, y + h / 2.0 - 1.0, 2.0, 2.0, 1.0, grip)
                } else {
                    painter.round_rect(z, x + w / 2.0 - 1.0, y + h / 2.0 + (k * 8) as f64 - 1.0, 2.0, 2.0, 1.0, grip)
                }
                k = k + 1
            }
            return
        }
        i = i + 1
    }
}

// Opens the container and pane A. `vertical` = panes side by side (the bar is vertical), as in splitter.fi
// splitter_new(false, ..); here `side_by_side` says it in plain words.
fn split_begin(a: *mut app.App, side_by_side: bool, ratio_pm: i64, name: str,
    on_change: fn(*mut app.App, usize)) -> usize {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 || (*c).n >= CTL_MAX {
        return NONE
    }
    var ct: usize = NONE
    if side_by_side {
        ct = app.row(a)
    } else {
        ct = app.column(a)
    }
    if ct == NONE {
        return NONE
    }
    scene.node_set_grow(sc_of(c), ct, 1, 1)
    scene.node_set_align_self(sc_of(c), ct, flex.AL_STRETCH)
    scene.node_set_gap(sc_of(c), ct, 0, 0)
    let sp: u64 = rt.heap_alloc(256)
    if sp == 0 {
        app.end(a)
        return NONE
    }
    *(sp as *mut splitter.Splitter) = splitter.splitter_new(!side_by_side, ratio_pm)
    let i: usize = add_entry(c, K_SPLIT, NONE)
    (*c).aux[i] = sp as usize
    (*c).cnt[i] = ct
    set_cb(c, i, on_change)
    (*c).tip[i] = name
    let pa: usize = app.column(a)
    split_pane_flex(sc_of(c), pa)
    scene.node_set_align_self(sc_of(c), pa, flex.AL_STRETCH)
    scene.node_set_grow(sc_of(c), pa, ratio_pm + 1, 0)
    (*c).page[i] = pa
    return ct
}

// Ends pane A, adds the bar, opens pane B. Returns the bar node (the id of the control).
fn split_mid(a: *mut app.App) -> usize {
    let c: *mut Ctl = st(a)
    var i: usize = (*c).n
    var found: usize = NONE
    while i > 0 {
        i = i - 1
        if (*c).kind[i] == K_SPLIT && (*c).node[i] == NONE && found == NONE {
            found = i
        }
    }
    if found == NONE {
        return NONE
    }
    app.end(a)
    let s: *mut splitter.Splitter = split_state(c, found)
    let bar: usize = app.custom(a, widget.KIND_NONE, 6, 6)
    if bar == NONE {
        return NONE
    }
    (*c).node[found] = bar
    scene.node_set_grow(sc_of(c), bar, 0, 0)
    scene.node_set_align_self(sc_of(c), bar, flex.AL_STRETCH)
    scene.node_set_base(sc_of(c), bar, (*s).bar_px)
    scene.node_set_draw(sc_of(c), bar, c as u64, split_draw)
    name_node(c, bar, (*c).tip[found])
    (*c).tip[found] = ""
    let pb: usize = app.column(a)
    split_pane_flex(sc_of(c), pb)
    scene.node_set_align_self(sc_of(c), pb, flex.AL_STRETCH)
    scene.node_set_grow(sc_of(c), pb, 1001 - (*s).pm, 0)
    (*c).base[found] = pb
    return bar
}

fn split_end(a: *mut app.App) {
    app.end(a)
    app.end(a)
}

fn split_index(a: *mut app.App, bar: usize) -> usize {
    let c: *mut Ctl = st(a)
    let i: usize = find(c, bar)
    if i == NONE || (*c).kind[i] != K_SPLIT {
        return NONE
    }
    return i
}

// the ratio of the first pane in permille of the room both panes share
fn split_ratio(a: *mut app.App, bar: usize) -> i64 {
    let i: usize = split_index(a, bar)
    if i == NONE { return 0 - 1 }
    return splitter.ratio(split_state(st(a), i))
}

fn split_set_ratio(a: *mut app.App, bar: usize, pm: i64) {
    let i: usize = split_index(a, bar)
    if i == NONE { return }
    let c: *mut Ctl = st(a)
    splitter.set_ratio(split_state(c, i), pm)
    split_apply(c, i)
    touch(c)
}

// smallest size of pane A and pane B in pixels
fn split_limits(a: *mut app.App, bar: usize, min_a: i64, min_b: i64) {
    let i: usize = split_index(a, bar)
    if i == NONE { return }
    splitter.set_limits(split_state(st(a), i), min_a, min_b)
}

fn split_hovered(a: *mut app.App, bar: usize) -> bool {
    let i: usize = split_index(a, bar)
    return i != NONE && splitter.hovered(split_state(st(a), i))
}

fn split_dragging(a: *mut app.App, bar: usize) -> bool {
    let i: usize = split_index(a, bar)
    return i != NONE && splitter.dragging(split_state(st(a), i))
}

// pointer events for all splitters; true = the frame must be repainted (the event is consumed on a hit)
fn split_ptr(c: *mut Ctl, kind: u32, x: f64, y: f64) -> bool {
    var res: bool = false
    var i: usize = 0
    while i < (*c).n {
        if (*c).kind[i] == K_SPLIT && (*c).node[i] != NONE {
            let s: *mut splitter.Splitter = split_state(c, i)
            split_apply(c, i)
            let px: i64 = x as i64
            let py: i64 = y as i64
            if kind == fuiwirt.HOOK_MOVE {
                let hv: bool = splitter.hovered(s)
                let moved: bool = splitter.move(s, px, py)
                if moved {
                    split_apply(c, i)
                    fire(c, i)
                }
                if moved || hv != splitter.hovered(s) {
                    res = true
                }
            } else if kind == fuiwirt.HOOK_LEAVE {
                if splitter.hovered(s) { res = true }
                (*s).hover = 0 as u32
            } else if kind == fuiwirt.HOOK_DOWN {
                if splitter.down(s, px, py) {
                    res = true
                }
            } else if kind == fuiwirt.HOOK_UP {
                if splitter.dragging(s) {
                    splitter.up(s)
                    res = true
                }
            }
        }
        i = i + 1
    }
    return res
}

// ============================================================ RIPPLE
//
// The press wave of lib/fui/ripple.fi on buttons. OFF by default: theme token `Shape.ripple` (theme file key
// `ripple = 1`, or `appctl.ripple_on(a, true)` which also installs these hooks for an app that uses no other
// appctl control). With the token 0 nothing is recorded and nothing is painted.

fn ripple_on(a: *mut app.App, on: bool) {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 {
        return
    }
    var n: usize = 0
    if on { n = 1 }
    (*theme.theme_shape(app.app_theme(a))).ripple = n
    if !on {
        ripple.clear(&(*c).rp)
    }
    touch(c)
}

fn ripple_enabled(c: *mut Ctl) -> bool {
    return (*theme.theme_shape(app.app_theme((*c).a))).ripple != 0
}

fn ripple_ptr(c: *mut Ctl, kind: u32, x: f64, y: f64) {
    if !ripple_enabled(c) {
        return
    }
    let now: i64 = fuiwirt.host_now(app.app_host((*c).a))
    if kind == fuiwirt.HOOK_DOWN {
        let sc: *mut scene.Scene = sc_of(c)
        let n: usize = scene.scene_hit(sc, x, y)
        if n == NONE || n >= scene.scene_count(sc) {
            return
        }
        if widget.w_kind(scene.node_widget(sc, n)) != widget.KIND_BUTTON {
            return
        }
        let wi: usize = find(c, n)
        if wi != NONE && (is_w5_kind((*c).kind[wi]) || is_w8_kind((*c).kind[wi]) || (*c).kind[wi] == K_PGRID) {
            return
        }
        (*c).rp_node = n
        let s: usize = ripple.press(&(*c).rp, now, x, y, scene.node_x(sc, n), scene.node_y(sc, n),
            scene.node_w(sc, n), scene.node_h(sc, n))
        touch(c)
    } else if kind == fuiwirt.HOOK_UP || kind == fuiwirt.HOOK_LEAVE {
        ripple.release(&(*c).rp, now)
        touch(c)
    }
}

fn ripple_draw(c: *mut Ctl, rc: *mut render.Ctx) {
    if (*c).rp_node == NONE || !ripple_enabled(c) {
        return
    }
    let now: i64 = fuiwirt.host_now(app.app_host((*c).a))
    if !ripple.busy(&(*c).rp, now) {
        return
    }
    let sc: *mut scene.Scene = sc_of(c)
    let n: usize = (*c).rp_node
    let col: u32 = kit.tokc(rc, style.TOK_TEXT) & 16777215 as u32
    ripple.paint(render.ctx_painter(rc), &(*c).rp, now, scene.node_x(sc, n), scene.node_y(sc, n),
        scene.node_w(sc, n), scene.node_h(sc, n), 0.0, col)
}

// ============================================================ THE POPUP SINK

fn mv_of(c: *mut Ctl) -> u64 { return app.ctx_view((*c).a) as u64 }

fn sink_open(ud: u64) -> bool {
    let c: *mut Ctl = ud as *mut Ctl
    return (*c).drop_open || (*c).dlg != 0 as u32 || sh_blocking(c) || menuview.mv_is_open(mv_of(c))
}

fn sink_ptr(ud: u64, kind: u32, x: f64, y: f64, btn: u32, now: i64) -> u32 {
    let c: *mut Ctl = ud as *mut Ctl
    if (*c).dlg != 0 as u32 {
        return dlg_ptr(c, kind, x, y)
    }
    if sh_blocking(c) && !(*c).drop_open && !menuview.mv_is_open(mv_of(c)) {
        let used: bool = sh_ptr(c, kind, x, y)
        return ctxmenu.CR_CONSUMED | ctxmenu.CR_REPAINT
    }
    if !(*c).drop_open {
        return menuview.mv_pointer(mv_of(c), kind, x, y, btn, now)
    }
    let row: usize = drop_row_at(c, x, y)
    if kind == fuiwirt.HOOK_MOVE {
        if row != NONE {
            (*c).drop_hot = row
        }
    } else if kind == fuiwirt.HOOK_DOWN {
        if row != NONE {
            drop_choose(c, (*c).drop_ctl, row, true)
        }
        drop_close(c)
    }
    return ctxmenu.CR_CONSUMED | ctxmenu.CR_REPAINT
}

fn sink_key(ud: u64, key: u32, mods: u32, now: i64) -> u32 {
    let c: *mut Ctl = ud as *mut Ctl
    if menuview.mv_is_open(mv_of(c)) {
        return menuview.mv_key(mv_of(c), key, mods, now)
    }
    return ctxmenu.CR_CONSUMED
}

fn sink_chr(ud: u64, cp: u32, mods: u32, now: i64) -> u32 {
    let c: *mut Ctl = ud as *mut Ctl
    if menuview.mv_is_open(mv_of(c)) {
        return menuview.mv_char(mv_of(c), cp, mods, now)
    }
    return ctxmenu.CR_CONSUMED
}

fn sink_tick(ud: u64, now: i64) -> u32 {
    let c: *mut Ctl = ud as *mut Ctl
    if menuview.mv_is_open(mv_of(c)) {
        return menuview.mv_tick(mv_of(c), now)
    }
    return 0 as u32
}

fn sink_wait(ud: u64, now: i64) -> i64 {
    let c: *mut Ctl = ud as *mut Ctl
    if menuview.mv_is_open(mv_of(c)) {
        return menuview.mv_wait(mv_of(c), now)
    }
    return fuiwirt.WAIT_FOREVER
}

// ============================================================ WAVE 5 CONTROLS (r45 wiring)
//
// The controls of lib/fui/wave5.fi as nodes of the ten-line API. Each is ONE focusable node (a button without
// surface: `no_fill`) whose painter is the wave5 painter; the state (value, hover, chips, data) lives in a heap
// `W5` that the entry points at (`aux`). The geometry of hit tests is the one of the painters (wave5.*_hit).
//
//     let r: usize = appctl.rating(a, "Quality", 5, true, 7, changed)      // 3.5 stars of 5
//     let s: usize = appctl.segmented(a, "View", 240, changed)
//     appctl.segment_add(a, s, "Day"); appctl.segment_add(a, s, "Week")
//     let t: usize = appctl.chips(a, "Tags", 320, 72, changed)
//     appctl.chip_add(a, t, "rust", true)
//     let k: usize = appctl.skeleton(a, 240, 60, 3)                           // 3 lines of placeholder
//     let g: usize = appctl.chart(a, "Load", wave5.CH_AREA, 240, 80)
//     appctl.chart_set(a, g, &vals[0], n)
//     let p: usize = appctl.pager(a, "Pages", 3, 320, 180, draw_page, changed)
//
// The callback runs when the USER changed the control; `*_changed` tells which chip. A skeleton shimmers while
// it is on (theme motion 0 or `skeleton_on(a, id, false)` = still). The pager asks `draw_page(a, rc, page, x, y,
// w, h)` for the pages that are visible (clip is set); drag, arrows, dots, keys and the glide are the library's.

const K_RATING: u32 = 15
const K_SEG: u32 = 16
const K_CHIPS: u32 = 17
const K_SKEL: u32 = 18
const K_CHART: u32 = 19
const K_PAGER: u32 = 20
const W5_MAX: usize = 8
const W5_VALS: usize = 128

fn pg_draw_none(a: *mut app.App, rc: *mut render.Ctx, page: usize, x: f64, y: f64, w: f64, h: f64) {
}

struct W5 {
    max: usize,
    spp: usize,
    val: usize,
    hover: usize,
    hpart: u32,
    n: usize,
    sel: usize,
    fch: usize,
    chg: usize,
    chg_rm: bool,
    chips: [wave5.Chip; 8],
    segs: [wave5.Seg; 8],
    vals: [f64; 128],
    nv: usize,
    ckind: u32,
    lines: usize,
    on: bool,
    phase: i64,
    last_ms: i64,
    rg: wave7.Range,
    pg: wave5.Pager,
    pdraw: fn(*mut app.App, *mut render.Ctx, usize, f64, f64, f64, f64),
}

fn w5_blank() -> W5 {
    return W5 { max: 0, spp: 1, val: 0, hover: kit.NONE, hpart: 0 as u32, n: 0, sel: 0, fch: kit.NONE, chg: 0,
        chg_rm: false,
        chips: [wave5.Chip { label: "", icon: kit.ICON_NONE, selected: false, close: false }; 8],
        segs: [wave5.Seg { label: "", icon: kit.ICON_NONE }; 8],
        vals: [0.0; 128], nv: 0, ckind: 0 as u32, lines: 0, on: true, phase: 0, last_ms: 0,
        rg: wave7.range_new(0, 100, 1, 0, 100), pg: wave5.pager_new(0), pdraw: pg_draw_none }
}

fn w5_of(c: *mut Ctl, i: usize) -> *mut W5 {
    return (*c).aux[i] as *mut W5
}

fn is_w5_kind(k: u32) -> bool {
    return (k >= K_RATING && k <= K_PAGER) || k == K_RANGE
}

// one node + one entry; `name` is spoken, `role` the screen reader role
fn w5_make(a: *mut app.App, kind: u32, wpt: usize, hpt: usize, name: str, role: u32,
    on_change: fn(*mut app.App, usize)) -> usize {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 || (*c).n >= CTL_MAX {
        return NONE
    }
    let p: u64 = rt.heap_alloc(8192)
    if p == 0 {
        return NONE
    }
    *(p as *mut W5) = w5_blank()
    let focusable: bool = kind == K_RATING || kind == K_SEG || kind == K_CHIPS || kind == K_PAGER || kind == K_RANGE
    var wk: u32 = widget.KIND_NONE
    if focusable {
        wk = widget.KIND_BUTTON
    }
    let node: usize = app.custom(a, wk, wpt, hpt)
    if node == NONE {
        return NONE
    }
    (*scene.nd(sc_of(c), node)).no_fill = 1 as u32
    let i: usize = add_entry(c, kind, node)
    (*c).aux[i] = p as usize
    set_cb(c, i, on_change)
    scene.node_set_draw(sc_of(c), node, c as u64, w5_draw)
    a11y.a11y_set_role(app.ax(a), node, role)
    name_node(c, node, name)
    return node
}

fn w5_idx(a: *mut app.App, id: usize, kind: u32) -> usize {
    let c: *mut Ctl = st(a)
    let i: usize = find(c, id)
    if i == NONE || (*c).kind[i] != kind {
        return NONE
    }
    return i
}

fn rating(a: *mut app.App, name: str, max: usize, half: bool, init: usize,
    on_change: fn(*mut app.App, usize)) -> usize {
    if max == 0 || max > 10 {
        return NONE
    }
    let node: usize = w5_make(a, K_RATING, max * 28, 32, name, a11y.ROLE_SLIDER, on_change)
    if node == NONE {
        return NONE
    }
    let c: *mut Ctl = st(a)
    let w: *mut W5 = w5_of(c, find(c, node))
    (*w).max = max
    (*w).spp = 1
    if half {
        (*w).spp = 2
    }
    (*w).val = init
    if (*w).val > max * (*w).spp {
        (*w).val = max * (*w).spp
    }
    rating_sync(c, find(c, node))
    return node
}

fn rating_sync(c: *mut Ctl, i: usize) {
    let w: *mut W5 = w5_of(c, i)
    var pm: i64 = 0
    if (*w).max > 0 {
        pm = ((*w).val * 1000 / ((*w).max * (*w).spp)) as i64
    }
    widget.w_set_value(wid(c, i), pm)
}

// The rating in steps (half stars count 1; whole stars count `spp`): 0 .. max * (2 if half stars else 1).
fn rating_value(a: *mut app.App, id: usize) -> usize {
    let c: *mut Ctl = st(a)
    let i: usize = w5_idx(a, id, K_RATING)
    if i == NONE { return 0 }
    return (*w5_of(c, i)).val
}

fn set_rating_value(a: *mut app.App, id: usize, v: usize) {
    let c: *mut Ctl = st(a)
    let i: usize = w5_idx(a, id, K_RATING)
    if i == NONE { return }
    let w: *mut W5 = w5_of(c, i)
    var x: usize = v
    if x > (*w).max * (*w).spp {
        x = (*w).max * (*w).spp
    }
    (*w).val = x
    rating_sync(c, i)
    touch(c)
}

fn segmented(a: *mut app.App, name: str, wpt: usize, on_change: fn(*mut app.App, usize)) -> usize {
    let node: usize = w5_make(a, K_SEG, wpt, 32, name, a11y.ROLE_GROUP, on_change)
    if node == NONE {
        return NONE
    }
    let c: *mut Ctl = st(a)
    (*w5_of(c, find(c, node))).sel = kit.NONE
    return node
}

fn segment_add(a: *mut app.App, id: usize, text: str) -> bool {
    let c: *mut Ctl = st(a)
    let i: usize = w5_idx(a, id, K_SEG)
    if i == NONE { return false }
    let w: *mut W5 = w5_of(c, i)
    if (*w).n >= W5_MAX { return false }
    let s: *mut wave5.Seg = wave5.seg_at(&(*w).segs[0], (*w).n)
    (*s).label = text
    (*w).n = (*w).n + 1
    if (*w).sel == kit.NONE {
        (*w).sel = 0
    }
    return true
}

// The selected segment (0 based), or the count when none.
fn segmented_selected(a: *mut app.App, id: usize) -> usize {
    let c: *mut Ctl = st(a)
    let i: usize = w5_idx(a, id, K_SEG)
    if i == NONE { return 0 }
    return (*w5_of(c, i)).sel
}

fn set_segmented_selected(a: *mut app.App, id: usize, k: usize) {
    let c: *mut Ctl = st(a)
    let i: usize = w5_idx(a, id, K_SEG)
    if i == NONE { return }
    let w: *mut W5 = w5_of(c, i)
    if k < (*w).n {
        (*w).sel = k
        touch(c)
    }
}

fn chips(a: *mut app.App, name: str, wpt: usize, hpt: usize, on_change: fn(*mut app.App, usize)) -> usize {
    let node: usize = w5_make(a, K_CHIPS, wpt, hpt, name, a11y.ROLE_GROUP, on_change)
    if node == NONE {
        return NONE
    }
    let c: *mut Ctl = st(a)
    (*w5_of(c, find(c, node))).fch = 0
    return node
}

fn chip_add(a: *mut app.App, id: usize, text: str, closable: bool) -> bool {
    let c: *mut Ctl = st(a)
    let i: usize = w5_idx(a, id, K_CHIPS)
    if i == NONE { return false }
    let w: *mut W5 = w5_of(c, i)
    if (*w).n >= W5_MAX { return false }
    let ch: *mut wave5.Chip = wave5.chip_at(&(*w).chips[0], (*w).n)
    (*ch).label = text
    (*ch).selected = false
    (*ch).close = closable
    (*w).n = (*w).n + 1
    touch(c)
    return true
}

fn chip_count(a: *mut app.App, id: usize) -> usize {
    let c: *mut Ctl = st(a)
    let i: usize = w5_idx(a, id, K_CHIPS)
    if i == NONE { return 0 }
    return (*w5_of(c, i)).n
}

fn chip_selected(a: *mut app.App, id: usize, k: usize) -> bool {
    let c: *mut Ctl = st(a)
    let i: usize = w5_idx(a, id, K_CHIPS)
    if i == NONE { return false }
    let w: *mut W5 = w5_of(c, i)
    if k >= (*w).n { return false }
    return (*wave5.chip_at(&(*w).chips[0], k)).selected
}

// The chip that caused the last callback, and whether it was removed (it is gone from the list then).
fn chip_changed(a: *mut app.App, id: usize) -> usize {
    let c: *mut Ctl = st(a)
    let i: usize = w5_idx(a, id, K_CHIPS)
    if i == NONE { return 0 }
    return (*w5_of(c, i)).chg
}

fn chip_was_removed(a: *mut app.App, id: usize) -> bool {
    let c: *mut Ctl = st(a)
    let i: usize = w5_idx(a, id, K_CHIPS)
    if i == NONE { return false }
    return (*w5_of(c, i)).chg_rm
}

fn chip_remove_at(w: *mut W5, k: usize) {
    var j: usize = k
    while j + 1 < (*w).n {
        *wave5.chip_at(&(*w).chips[0], j) = *wave5.chip_at(&(*w).chips[0], j + 1)
        j = j + 1
    }
    if (*w).n > 0 {
        (*w).n = (*w).n - 1
    }
    if (*w).fch >= (*w).n && (*w).n > 0 {
        (*w).fch = (*w).n - 1
    }
    (*w).hover = kit.NONE
}

fn skeleton(a: *mut app.App, wpt: usize, hpt: usize, lines: usize) -> usize {
    let node: usize = w5_make(a, K_SKEL, wpt, hpt, "Loading", a11y.ROLE_PROGRESSBAR, cb_none)
    if node == NONE {
        return NONE
    }
    let c: *mut Ctl = st(a)
    (*w5_of(c, find(c, node))).lines = lines
    return node
}

// A skeleton shimmers while `on`; off = the still placeholder (also what a theme with motion 0 gets).
fn skeleton_on(a: *mut app.App, id: usize, on: bool) {
    let c: *mut Ctl = st(a)
    let i: usize = w5_idx(a, id, K_SKEL)
    if i == NONE { return }
    (*w5_of(c, i)).on = on
    touch(c)
}

fn chart(a: *mut app.App, name: str, kind: u32, wpt: usize, hpt: usize) -> usize {
    let node: usize = w5_make(a, K_CHART, wpt, hpt, name, a11y.ROLE_IMAGE, cb_none)
    if node == NONE {
        return NONE
    }
    let c: *mut Ctl = st(a)
    (*w5_of(c, find(c, node))).ckind = kind
    return node
}

// Sets the data (more than 128 values are decimated: means for lines, peaks for bars).
fn chart_set(a: *mut app.App, id: usize, vals: *mut f64, n: usize) {
    let c: *mut Ctl = st(a)
    let i: usize = w5_idx(a, id, K_CHART)
    if i == NONE { return }
    let w: *mut W5 = w5_of(c, i)
    if n <= W5_VALS {
        var k: usize = 0
        while k < n {
            (*w).vals[k] = *((vals as u64 + (k * 8) as u64) as *mut f64)
            k = k + 1
        }
        (*w).nv = n
    } else {
        var tmp: [f64; 512] = [0.0; 512]
        let m: usize = wave5.chart_decimate(vals, n, W5_VALS, (*w).ckind == wave5.CH_BARS, &tmp)
        var k2: usize = 0
        while k2 < m && k2 < W5_VALS {
            (*w).vals[k2] = tmp[k2]
            k2 = k2 + 1
        }
        (*w).nv = m
    }
    touch(c)
}

fn pager(a: *mut app.App, name: str, pages: usize, wpt: usize, hpt: usize,
    draw_page: fn(*mut app.App, *mut render.Ctx, usize, f64, f64, f64, f64),
    on_change: fn(*mut app.App, usize)) -> usize {
    let node: usize = w5_make(a, K_PAGER, wpt, hpt, name, a11y.ROLE_GROUP, on_change)
    if node == NONE {
        return NONE
    }
    let c: *mut Ctl = st(a)
    let w: *mut W5 = w5_of(c, find(c, node))
    (*w).pg = wave5.pager_new(pages)
    (*w).pdraw = draw_page
    return node
}

fn pager_page(a: *mut app.App, id: usize) -> usize {
    let c: *mut Ctl = st(a)
    let i: usize = w5_idx(a, id, K_PAGER)
    if i == NONE { return 0 }
    return (*w5_of(c, i)).pg.cur
}

fn pager_show(a: *mut app.App, id: usize, k: usize) {
    let c: *mut Ctl = st(a)
    let i: usize = w5_idx(a, id, K_PAGER)
    if i == NONE { return }
    let w: *mut W5 = w5_of(c, i)
    wave5.pager_goto(&(*w).pg, k)
    (*w).sel = (*w).pg.cur
    touch(c)
}

// the page changed by the user (key, arrow, dot, swipe): tell the program once
fn pager_notify(c: *mut Ctl, i: usize) {
    let w: *mut W5 = w5_of(c, i)
    if (*w).pg.cur != (*w).sel {
        (*w).sel = (*w).pg.cur
        fire(c, i)
    }
}

fn motion_of(c: *mut Ctl) -> i64 {
    return (*theme.theme_shape(render.ctx_theme(app.app_ctx((*c).a)))).motion as i64
}

fn w5_draw(ud: u64, rc: *mut render.Ctx, e: *mut widget.Widget) {
    let c: *mut Ctl = ud as *mut Ctl
    var i: usize = 0
    while i < (*c).n {
        if is_w5_kind((*c).kind[i]) && wid(c, i) == e {
            break
        }
        i = i + 1
    }
    if i >= (*c).n {
        return
    }
    let w: *mut W5 = w5_of(c, i)
    let k: u32 = (*c).kind[i]
    let x: f64 = widget.w_x(e)
    let y: f64 = widget.w_y(e)
    let wd: f64 = widget.w_w(e)
    let h: f64 = widget.w_h(e)
    let focused: bool = app.focus((*c).a) == (*c).node[i]
    var stt: u32 = 0 as u32
    if focused {
        stt = stt | kit.ST_FOCUS
    }
    if widget.w_is_disabled(e) {
        stt = stt | kit.ST_DISABLED
    }
    if k == K_RATING {
        wave5.rating_draw(rc, x, y, (*w).max, (*w).spp, (*w).val, (*w).hover, stt)
    } else if k == K_SEG {
        wave5.seg_draw(rc, &(*w).segs[0], (*w).n, (*w).sel, (*w).hover, focused, x, y, wd)
    } else if k == K_CHIPS {
        var fc: usize = kit.NONE
        if focused {
            fc = (*w).fch
        }
        wave5.chips_draw(rc, &(*w).chips[0], (*w).n, (*w).hover, (*w).hpart, fc, x, y, wd)
    } else if k == K_SKEL {
        var ph: i64 = (*w).phase
        if !(*w).on {
            ph = 0 - 1
        }
        if (*w).lines > 0 {
            let used: f64 = wave5.skeleton_lines(rc, x, y, wd, (*w).lines, ph)
        } else {
            wave5.skeleton_draw(rc, x, y, wd, h, 8, ph)
        }
    } else if k == K_RANGE {
        let rh: f64 = wave7.range_height(rc)
        wave7.range_draw(rc, x, y + (h - rh) / 2.0, wd, &(*w).rg, stt)
    } else if k == K_CHART {
        wave5.chart_draw(rc, x, y, wd, h, &(*w).vals[0], (*w).nv, (*w).ckind, (*w).hover)
    } else if k == K_PAGER {
        let f: fn(*mut app.App, *mut render.Ctx, usize, f64, f64, f64, f64) = (*w).pdraw
        if wave5.pager_begin(rc, x, y, wd, h) {
            var j: usize = 0
            while j < (*w).pg.n {
                let px: f64 = wave5.pager_page_x(&(*w).pg, j, x, wd)
                if px < x + wd && px + wd > x {
                    f((*c).a, rc, j, px, y, wd, h)
                }
                j = j + 1
            }
            wave5.pager_end(rc)
        }
        wave5.pager_nav_draw(rc, &(*w).pg, x, y, wd, h, (*w).hpart)
        if focused {
            kit.focus_ring(rc, x, y, wd, h, kit.ln(rc, 8), style.TOK_BASE)
        }
    }
}

// The hover of entry `i` for a pointer at (x, y); true when it changed.
fn w5_hover(c: *mut Ctl, i: usize, x: f64, y: f64) -> bool {
    let w: *mut W5 = w5_of(c, i)
    let rc: *mut render.Ctx = app.app_ctx((*c).a)
    let sc: *mut scene.Scene = sc_of(c)
    let nd: usize = (*c).node[i]
    let nx: f64 = scene.node_x(sc, nd)
    let ny: f64 = scene.node_y(sc, nd)
    let nw: f64 = scene.node_w(sc, nd)
    let nh: f64 = scene.node_h(sc, nd)
    let k: u32 = (*c).kind[i]
    var hv: usize = kit.NONE
    var hp: u32 = 0 as u32
    if k == K_RATING {
        let s: usize = wave5.rating_hit(rc, nx, ny, (*w).max, (*w).spp, x, y)
        if s > 0 {
            hv = s
        }
    } else if k == K_SEG {
        hv = wave5.seg_hit(rc, (*w).n, nx, ny, nw, x, y)
    } else if k == K_CHIPS {
        var part: u32 = 0 as u32
        hv = wave5.chips_hit(rc, &(*w).chips[0], (*w).n, nx, ny, nw, x, y, &part)
        hp = part
    } else if k == K_CHART {
        hv = wave5.chart_hit(rc, nx, ny, nw, nh, (*w).nv, x, y)
    } else if k == K_PAGER {
        hp = wave5.pager_nav_hit(rc, &(*w).pg, nx, ny, nw, nh, x, y)
    }
    if hv == (*w).hover && hp == (*w).hpart {
        return false
    }
    (*w).hover = hv
    (*w).hpart = hp
    return true
}

fn w5_clear_hover(c: *mut Ctl, keep: usize) -> bool {
    var ch: bool = false
    var i: usize = 0
    while i < (*c).n {
        if is_w5_kind((*c).kind[i]) && i != keep {
            let w: *mut W5 = w5_of(c, i)
            if (*w).hover != kit.NONE || (*w).hpart != 0 as u32 {
                (*w).hover = kit.NONE
                (*w).hpart = 0 as u32
                ch = true
            }
        }
        i = i + 1
    }
    return ch
}

// pointer events for the wave 5 nodes; true = repaint
fn w5_ptr(c: *mut Ctl, kind: u32, x: f64, y: f64) -> bool {
    let now: i64 = fuiwirt.host_now(app.app_host((*c).a))
    let sc: *mut scene.Scene = sc_of(c)
    if (*c).w5_drag != NONE {
        let di: usize = (*c).w5_drag
        let dw: *mut W5 = w5_of(c, di)
        if (*c).kind[di] == K_RANGE {
            if kind == fuiwirt.HOOK_MOVE {
                let lo0: i64 = (*dw).rg.lo
                let hi0: i64 = (*dw).rg.hi
                wave7.range_drag(app.app_ctx((*c).a), &(*dw).rg, scene.node_x(sc, (*c).node[di]), scene.node_w(sc, (*c).node[di]), x)
                if (*dw).rg.lo != lo0 || (*dw).rg.hi != hi0 {
                    range_sync(c, di)
                    fire(c, di)
                }
                return true
            }
            if kind == fuiwirt.HOOK_UP || kind == fuiwirt.HOOK_LEAVE {
                wave7.range_release(&(*dw).rg)
                (*c).w5_drag = NONE
                return true
            }
        }
        if kind == fuiwirt.HOOK_MOVE {
            wave5.pager_drag_move(&(*dw).pg, x, scene.node_w(sc, (*c).node[di]), now)
            return true
        }
        if kind == fuiwirt.HOOK_UP || kind == fuiwirt.HOOK_LEAVE {
            wave5.pager_drag_end(&(*dw).pg)
            (*c).w5_drag = NONE
            pager_notify(c, di)
            return true
        }
    }
    if kind == fuiwirt.HOOK_LEAVE {
        return w5_clear_hover(c, NONE)
    }
    var node: usize = scene.scene_hit(sc, x, y)
    var i: usize = NONE
    if node != NONE && node < scene.scene_count(sc) {
        i = find(c, node)
    }
    if i != NONE && !is_w5_kind((*c).kind[i]) {
        i = NONE
    }
    var ch: bool = w5_clear_hover(c, i)
    if i == NONE {
        return ch
    }
    if w5_hover(c, i, x, y) {
        ch = true
    }
    if kind != fuiwirt.HOOK_DOWN {
        return ch
    }
    let w: *mut W5 = w5_of(c, i)
    let k: u32 = (*c).kind[i]
    if k == K_RATING {
        if (*w).hover != kit.NONE && (*w).hover != (*w).val {
            (*w).val = (*w).hover
            rating_sync(c, i)
            fire(c, i)
        }
    } else if k == K_SEG {
        if (*w).hover != kit.NONE && (*w).hover != (*w).sel {
            (*w).sel = (*w).hover
            fire(c, i)
        }
    } else if k == K_CHIPS {
        if (*w).hover != kit.NONE {
            let hk: usize = (*w).hover
            (*w).fch = hk
            (*w).chg = hk
            if (*w).hpart == wave5.CHIP_PART_CLOSE {
                (*w).chg_rm = true
                chip_remove_at(w, hk)
            } else {
                (*w).chg_rm = false
                let cc: *mut wave5.Chip = wave5.chip_at(&(*w).chips[0], hk)
                (*cc).selected = !(*cc).selected
            }
            fire(c, i)
        }
    } else if k == K_RANGE {
        let lo0: i64 = (*w).rg.lo
        let hi0: i64 = (*w).rg.hi
        let pk: usize = wave7.range_press(app.app_ctx((*c).a), &(*w).rg, scene.node_x(sc, (*c).node[i]), scene.node_w(sc, (*c).node[i]), x)
        (*c).w5_drag = i
        range_sync(c, i)
        if (*w).rg.lo != lo0 || (*w).rg.hi != hi0 {
            fire(c, i)
        }
    } else if k == K_PAGER {
        if (*w).hpart == wave5.PG_PREV {
            wave5.pager_prev(&(*w).pg)
            pager_notify(c, i)
        } else if (*w).hpart == wave5.PG_NEXT {
            wave5.pager_next(&(*w).pg)
            pager_notify(c, i)
        } else if (*w).hpart >= wave5.PG_DOT {
            wave5.pager_goto(&(*w).pg, ((*w).hpart - wave5.PG_DOT) as usize)
            pager_notify(c, i)
        } else {
            wave5.pager_drag_begin(&(*w).pg, x, now)
            (*c).w5_drag = i
        }
    }
    touch(c)
    return true
}

// keys of the focused wave 5 node; true = used
fn w5_key(c: *mut Ctl, i: usize, key: u32) -> bool {
    let w: *mut W5 = w5_of(c, i)
    let k: u32 = (*c).kind[i]
    if k == K_RATING {
        let v: usize = wave5.rating_key((*w).max, (*w).spp, (*w).val, key)
        if v == (*w).val {
            return false
        }
        (*w).val = v
        rating_sync(c, i)
        fire(c, i)
        return true
    }
    if k == K_RANGE {
        if !wave7.range_key(&(*w).rg, key) {
            return false
        }
        range_sync(c, i)
        fire(c, i)
        return true
    }
    if k == K_SEG {
        let s: usize = wave5.seg_key((*w).n, (*w).sel, key)
        if s == (*w).sel || s >= (*w).n {
            return false
        }
        (*w).sel = s
        fire(c, i)
        return true
    }
    if k == K_CHIPS {
        if (*w).n == 0 {
            return false
        }
        if wave5.chip_wants_remove(key) {
            let fk: usize = (*w).fch
            if fk < (*w).n && (*wave5.chip_at(&(*w).chips[0], fk)).close {
                (*w).chg = fk
                (*w).chg_rm = true
                chip_remove_at(w, fk)
                fire(c, i)
                return true
            }
            return false
        }
        let f2: usize = wave5.chips_key((*w).n, (*w).fch, key)
        if f2 == (*w).fch || f2 >= (*w).n {
            return false
        }
        (*w).fch = f2
        return true
    }
    if k == K_PAGER {
        if wave5.pager_key(&(*w).pg, key) {
            pager_notify(c, i)
            return true
        }
        return false
    }
    return false
}

// Space / Enter on a chip toggles it
fn w5_act(c: *mut Ctl, i: usize) {
    if (*c).kind[i] == K_RANGE {
        wave7.range_focus_next(&(*w5_of(c, i)).rg)
        range_sync(c, i)
        touch(c)
        return
    }
    if (*c).kind[i] != K_CHIPS {
        return
    }
    let w: *mut W5 = w5_of(c, i)
    if (*w).fch >= (*w).n {
        return
    }
    let cc: *mut wave5.Chip = wave5.chip_at(&(*w).chips[0], (*w).fch)
    (*cc).selected = !(*cc).selected
    (*w).chg = (*w).fch
    (*w).chg_rm = false
    fire(c, i)
}

// the timer: glide of the pagers, phase of the shimmers; true = repaint
fn w5_tick(c: *mut Ctl, now: i64) -> bool {
    var any: bool = false
    var i: usize = 0
    while i < (*c).n {
        let k: u32 = (*c).kind[i]
        if k == K_PAGER || k == K_SKEL {
            let w: *mut W5 = w5_of(c, i)
            var dt: i64 = 0
            if (*w).last_ms != 0 {
                dt = now - (*w).last_ms
            }
            (*w).last_ms = now
            if k == K_PAGER {
                if wave5.pager_animating(&(*w).pg) {
                    let moving: bool = wave5.pager_tick(&(*w).pg, dt, motion_of(c))
                    any = true
                } else {
                    (*w).last_ms = 0
                }
            } else if (*w).on && motion_of(c) > 0 && !scene.node_hidden(sc_of(c), (*c).node[i]) {
                (*w).phase = wave5.shim_step((*w).phase, dt)
                any = true
            }
        }
        i = i + 1
    }
    return any
}

fn w5_busy(c: *mut Ctl) -> bool {
    var i: usize = 0
    while i < (*c).n {
        let k: u32 = (*c).kind[i]
        if k == K_PAGER && wave5.pager_animating(&(*w5_of(c, i)).pg) {
            return true
        }
        if k == K_SKEL && (*w5_of(c, i)).on && !scene.node_hidden(sc_of(c), (*c).node[i]) && motion_of(c) > 0 {
            return true
        }
        i = i + 1
    }
    return false
}

// ============================================================ WAVE 6 CONTROLS (r45 wiring)
//
// The bottom sheet and the property grid of lib/fui/wave6.fi in the ten-line API.
//
// BOTTOM SHEET -- an OVERLAY drawn by the library over the whole window (like the dialogs), ONE per window:
//
//     appctl.sheet_setup(a, "Details", true, draw_body, changed)      // modal = with scrim; call it where the
//                                                                     // sheet's a11y marker should stand
//     appctl.sheet_show(a, 0)  /  appctl.sheet_hide(a)                // program side; they do NOT call `changed`
//     draw_body(a, rc, x, y, w, h)                                    // paints the content, clip is set
//
// The panel glides (dt-based), the handle drags with rubber band + fling, Esc / Up / Down / PgUp / PgDn move the
// snap points, a click on the scrim closes (modal). `changed(a, id)` runs when the USER moved or closed the sheet;
// `sheet_snap(a)` says where it rests (NONE = closed). `sheet_on_pointer` hears the pointer in the body
// (HOOK_MOVE / DOWN / UP at window coordinates) because a modal sheet shuts off the page behind it.
//
// PROPERTY GRID -- ONE focusable node, rows owned by the program (an array of wave6.PgRow, at most 64):
//
//     let g: usize = appctl.propgrid(a, "Properties", 360, 240, &rows[0], 9, changed, edit)
//
// `changed(a, id)` runs for a moved selection, a flipped switch, a folded group and a committed inline edit;
// `propgrid_event(a, id)` is the PGK_* (or PGE_COMMIT) and `propgrid_row(a, id)` its row. A text / number value
// opens an INLINE editor in its cell (Enter commits, Esc cancels, a click elsewhere commits; a number that does
// not parse is dropped). Choice and colour values (and everything if `propgrid_inline(a, g, false)`) call
// `edit(a, id)` instead: the program opens its own editor for `propgrid_row(a, id)`. The wheel, PgUp / PgDn and
// the selection scroll the rows; the divider between the columns drags. The screen reader gets the node as a
// tree whose description is the selected row ("label, value").
//
// HONEST (wave 6): the rows array must outlive the window (GC heap, or `#[allow_escape]` on main); the sheet's
// content is the program's drawing: the screen reader gets the marker node (dialog, panel rectangle, name),
// `sheet_describe` and up to 8 `sheet_item` nodes -- not the pixels of the body; a NON-modal sheet owns the pixels
// of its panel (the host's pointer shield keeps presses, moves, the wheel and right clicks over it from the page),
// the page outside the panel stays live; the inline editor has no mouse caret / selection (keys only) and no
// IME; a grid has at most 64 rows.
const K_PGRID: u32 = 21
const K_SHEET: u32 = 22
const K_RANGE: u32 = 23
const K_COMBO: u32 = 29
const PG_ROWS_MAX: usize = 64
const PGE_COMMIT: u32 = 5

fn sh_body_none(a: *mut app.App, rc: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64) {
}

fn sh_bptr_none(a: *mut app.App, kind: u32, x: f64, y: f64) {
}

struct W6 {
    rows: *mut wave6.PgRow,
    n: usize,
    g: wave6.PGrid,
    ev: u32,
    ev_row: usize,
    inl: bool,
    on_edit: fn(*mut app.App, usize),
    own_p: [u64; 64],
    own_n: [usize; 64],
    desc: [u8; 192],
    dn: usize,
}

fn w6_blank() -> W6 {
    return W6 { rows: 0 as u64 as *mut wave6.PgRow, n: 0, g: wave6.pgrid_new(), ev: 0 as u32, ev_row: NONE,
        inl: true, on_edit: cb_none, own_p: [0 as u64; 64], own_n: [0; 64], desc: [0 as u8; 192], dn: 0 }
}

fn w6_of(c: *mut Ctl, i: usize) -> *mut W6 {
    return (*c).aux[i] as *mut W6
}

fn is_w6_kind(k: u32) -> bool {
    return k == K_PGRID
}

// ------------------------------------------------------------ the sheet

// open (or still gliding out), and blocking = the modal sheet holds the window (open and not already leaving)
fn sh_visible(c: *mut Ctl) -> bool {
    return (*c).sh_on && wave6.sheet_is_open(&(*c).sh)
}

fn sh_blocking(c: *mut Ctl) -> bool {
    return (*c).sh_on && (*c).sh.modal && ((*c).sh.cur != kit.NONE || (*c).sh.drag)
}

// The marker node and its items follow the panel: hidden when closed, else the node takes the rectangle of the
// panel (window pixels) and the items theirs inside the body, so AT-SPI / UIA bounds and hit points are true.
// The layout puts them back to zero size on every scene_layout; the next paint / tick writes them again.
fn sh_sync_marker(c: *mut Ctl) {
    if (*c).sh_node == NONE {
        return
    }
    let sc: *mut scene.Scene = sc_of(c)
    let open: bool = wave6.sheet_is_open(&(*c).sh)
    scene.node_set_hidden(sc, (*c).sh_node, !open)
    // a closed sheet is not listed: role and name are taken back (a hidden node still shows in the a11y tree)
    let ax: *mut a11y.A11y = app.ax((*c).a)
    if open {
        a11y.a11y_set_role(ax, (*c).sh_node, a11y.ROLE_DIALOG)
        name_node(c, (*c).sh_node, (*c).sh_name)
        a11y.a11y_set_description(ax, (*c).sh_node, (*c).sh_desc, (*c).sh_dn)
    } else {
        a11y.a11y_set_role(ax, (*c).sh_node, a11y.ROLE_NONE)
        a11y.a11y_clear_name(ax, (*c).sh_node)
        a11y.a11y_set_description(ax, (*c).sh_node, 0, 0)
    }
    var k: usize = 0
    while k < (*c).sh_ni {
        scene.node_set_hidden(sc, (*c).sh_it[k], !open)
        if open {
            a11y.a11y_set_role(ax, (*c).sh_it[k], (*c).sh_irole[k])
            name_node(c, (*c).sh_it[k], (*c).sh_iname[k])
        } else {
            a11y.a11y_set_role(ax, (*c).sh_it[k], a11y.ROLE_NONE)
            a11y.a11y_clear_name(ax, (*c).sh_it[k])
        }
        k = k + 1
    }
    if !open {
        return
    }
    let rc: *mut render.Ctx = app.app_ctx((*c).a)
    var pr: [f64; 4] = [0.0, 0.0, 0.0, 0.0]
    if wave6.sheet_panel_rect(rc, &(*c).sh, 0.0, 0.0, (*c).win_w, (*c).win_h, &pr) {
        let nm: *mut scene.Node = scene.nd(sc, (*c).sh_node)
        (*nm).x = pr[0]
        (*nm).y = pr[1]
        (*nm).w = pr[2]
        (*nm).h = pr[3]
    }
    var br: [f64; 4] = [0.0, 0.0, 0.0, 0.0]
    let has_body: bool = wave6.sheet_body_rect(rc, &(*c).sh, 0.0, 0.0, (*c).win_w, (*c).win_h, &br)
    k = 0
    while k < (*c).sh_ni {
        let ni: *mut scene.Node = scene.nd(sc, (*c).sh_it[k])
        if has_body {
            (*ni).x = br[0] + kit.ln(rc, (*c).sh_ir[k * 4] as usize)
            (*ni).y = br[1] + kit.ln(rc, (*c).sh_ir[k * 4 + 1] as usize)
            (*ni).w = kit.ln(rc, (*c).sh_ir[k * 4 + 2] as usize)
            (*ni).h = kit.ln(rc, (*c).sh_ir[k * 4 + 3] as usize)
        } else {
            (*ni).w = 0.0
            (*ni).h = 0.0
        }
        k = k + 1
    }
}

// The sheet of the window (one): `modal` = scrim and the page behind is shut off. `body` paints the content.
// The marker node (zero size, role dialog, name `name`) is made HERE: call it where the node should stand.
fn sheet_setup(a: *mut app.App, name: str, modal: bool, body: fn(*mut app.App, *mut render.Ctx, f64, f64, f64, f64),
    on_change: fn(*mut app.App, usize)) -> bool {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 || (*c).sh_on || (*c).n >= CTL_MAX {
        return false
    }
    let node: usize = app.custom(a, widget.KIND_NONE, 0, 0)
    if node == NONE {
        return false
    }
    (*scene.nd(sc_of(c), node)).no_fill = 1 as u32
    let i: usize = add_entry(c, K_SHEET, node)
    set_cb(c, i, on_change)
    (*c).sh = wave6.sheet_new(modal)
    (*c).sh_on = true
    (*c).sh_node = node
    (*c).sh_body = body
    (*c).sh_name = name
    sh_sync_marker(c)
    return true
}

// 1..4 ascending fractions of the window height (0.1 .. 1.0); false for a bad list
fn sheet_snaps(a: *mut app.App, f: *mut f64, n: usize) -> bool {
    let c: *mut Ctl = st(a)
    if !(*c).sh_on {
        return false
    }
    return wave6.sheet_set_snaps(&(*c).sh, f, n)
}

fn sheet_dismiss(a: *mut app.App, on: bool) {
    let c: *mut Ctl = st(a)
    if (*c).sh_on {
        (*c).sh.dismiss = on
    }
}

fn sheet_on_pointer(a: *mut app.App, f: fn(*mut app.App, u32, f64, f64)) {
    let c: *mut Ctl = st(a)
    (*c).sh_bptr = f
}

fn sheet_show(a: *mut app.App, snap: usize) {
    let c: *mut Ctl = st(a)
    if !(*c).sh_on {
        return
    }
    wave6.sheet_open(&(*c).sh, snap)
    (*c).sh_ms = 0
    (*c).sh_kb = false
    sh_sync_marker(c)
    touch(c)
}

fn sheet_hide(a: *mut app.App) {
    let c: *mut Ctl = st(a)
    if !(*c).sh_on {
        return
    }
    wave6.sheet_close(&(*c).sh)
    (*c).sh_ms = 0
    touch(c)
}

// the snap point it rests at (NONE = closed)
fn sheet_snap(a: *mut app.App) -> usize {
    let c: *mut Ctl = st(a)
    if !(*c).sh_on || (*c).sh.cur == kit.NONE {
        return NONE
    }
    return (*c).sh.cur
}

fn sheet_visible(a: *mut app.App) -> bool {
    let c: *mut Ctl = st(a)
    return sh_visible(c)
}

// the shown height as a fraction of the window (0 .. 1)
fn sheet_height(a: *mut app.App) -> f64 {
    let c: *mut Ctl = st(a)
    if !(*c).sh_on {
        return 0.0
    }
    return wave6.sheet_pos(&(*c).sh)
}

// the content room / the grab zone in window pixels (x, y, w, h); false when nothing shows
fn sheet_body(a: *mut app.App, out: *mut [f64; 4]) -> bool {
    let c: *mut Ctl = st(a)
    if !(*c).sh_on {
        return false
    }
    return wave6.sheet_body_rect(app.app_ctx(a), &(*c).sh, 0.0, 0.0, (*c).win_w, (*c).win_h, out)
}

fn sheet_handle(a: *mut app.App, out: *mut [f64; 4]) -> bool {
    let c: *mut Ctl = st(a)
    if !(*c).sh_on {
        return false
    }
    return wave6.sheet_handle_rect(app.app_ctx(a), &(*c).sh, 0.0, 0.0, (*c).win_w, (*c).win_h, out)
}

// ---- the accessible side: node, description, items
//
// The sheet is ONE scene node (role dialog, name) that takes the rectangle of the panel while it is open (hidden
// when closed), so the tree dump, AT-SPI and UIA list it with true bounds. What the body shows is painted by the
// program, so it tells the screen reader: `sheet_describe` = the text it says after name and role (copied), and
// `sheet_item(a, role, name, x, y, w, h)` = up to 8 child nodes inside the body (points relative to the body's
// top-left; the name stays with the caller). Items follow the panel and are hidden with it.

// the scene node of the sheet (NONE before sheet_setup)
fn sheet_node(a: *mut app.App) -> usize {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 || !(*c).sh_on {
        return NONE
    }
    return (*c).sh_node
}

fn sheet_describe(a: *mut app.App, text: str) {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 || !(*c).sh_on {
        return
    }
    if (*c).sh_desc == 0 as u64 {
        (*c).sh_desc = rt.heap_alloc(256)
    }
    var n: usize = text.n
    if n > 256 {
        n = 256
    }
    var k: usize = 0
    let d: *mut u8 = (*c).sh_desc as *mut u8
    while k < n {
        *(d + k) = *((text.p as *mut u8) + k)
        k = k + 1
    }
    (*c).sh_dn = n
    sh_sync_marker(c)
}

// A part of the body for the screen reader. Returns its index (0..7) or NONE. Rect in points inside the body.
fn sheet_item(a: *mut app.App, role: u32, name: str, x: usize, y: usize, w: usize, h: usize) -> usize {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 || !(*c).sh_on || (*c).sh_ni >= 8 {
        return NONE
    }
    let sc: *mut scene.Scene = sc_of(c)
    let node: usize = scene.scene_add(sc, (*c).sh_node, scene.N_WIDGET)
    if node == scene.SCENE_NONE {
        return NONE
    }
    scene.node_set_widget_kind(sc, node, widget.KIND_NONE)
    scene.node_set_size(sc, node, 0.0, 0.0)
    (*scene.nd(sc, node)).no_fill = 1 as u32
    let k: usize = (*c).sh_ni
    (*c).sh_irole[k] = role
    (*c).sh_iname[k] = name
    (*c).sh_it[k] = node
    (*c).sh_ni = k + 1
    sheet_item_rect(a, k, x, y, w, h)
    return k
}

fn sheet_item_rect(a: *mut app.App, k: usize, x: usize, y: usize, w: usize, h: usize) {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 || !(*c).sh_on || k >= (*c).sh_ni {
        return
    }
    (*c).sh_ir[k * 4] = x as f64
    (*c).sh_ir[k * 4 + 1] = y as f64
    (*c).sh_ir[k * 4 + 2] = w as f64
    (*c).sh_ir[k * 4 + 3] = h as f64
    sh_sync_marker(c)
}

// the pointer shield of the host: a NON-modal sheet owns the pixels of its panel (handle + body), the page
// behind does not hear them. The modal one shuts the whole window off through the popup sink instead.
fn sh_shield(ud: u64, x: f64, y: f64) -> bool {
    let c: *mut Ctl = ud as *mut Ctl
    if cmb_shield(c, x, y) {
        return true
    }
    if !sh_visible(c) || (*c).sh.modal {
        return false
    }
    return wave6.sheet_hit(app.app_ctx((*c).a), &(*c).sh, 0.0, 0.0, (*c).win_w, (*c).win_h, x, y) != wave6.SH_NONE
}

// tell the program once when the USER changed where the sheet rests
fn sh_notify(c: *mut Ctl, prev: usize) {
    sh_sync_marker(c)
    if (*c).sh.cur != prev {
        let i: usize = find(c, (*c).sh_node)
        if i != NONE {
            fire(c, i)
        }
    }
}

fn sh_busy(c: *mut Ctl) -> bool {
    return (*c).sh_on && wave6.sheet_animating(&(*c).sh) && !wave6.sheet_dragging(&(*c).sh)
}

// the glide of the sheet; true = repaint
fn sh_tick(c: *mut Ctl, now: i64) -> bool {
    if !sh_busy(c) {
        (*c).sh_ms = 0
        return false
    }
    var dt: i64 = 0
    if (*c).sh_ms != 0 {
        dt = now - (*c).sh_ms
    }
    (*c).sh_ms = now
    let more: bool = wave6.sheet_tick(&(*c).sh, dt, motion_of(c))
    if !more {
        (*c).sh_ms = 0
        sh_sync_marker(c)
    }
    return true
}

// the pointer on the sheet: true = used
fn sh_ptr(c: *mut Ctl, kind: u32, x: f64, y: f64) -> bool {
    let now: i64 = fuiwirt.host_now(app.app_host((*c).a))
    let s: *mut wave6.Sheet = &(*c).sh
    if wave6.sheet_dragging(s) {
        if kind == fuiwirt.HOOK_MOVE {
            wave6.sheet_drag_move(s, y, (*c).win_h, now)
        } else if kind == fuiwirt.HOOK_UP || kind == fuiwirt.HOOK_LEAVE {
            let prev: usize = (*s).cur
            let closing: bool = wave6.sheet_drag_end(s)
            (*c).sh_ms = 0
            sh_notify(c, prev)
        }
        touch(c)
        return true
    }
    if kind == fuiwirt.HOOK_LEAVE {
        return false
    }
    let hit: u32 = wave6.sheet_hit(app.app_ctx((*c).a), s, 0.0, 0.0, (*c).win_w, (*c).win_h, x, y)
    if kind == fuiwirt.HOOK_DOWN {
        (*c).sh_kb = false
        if hit == wave6.SH_HANDLE {
            wave6.sheet_drag_begin(s, y, now)
            touch(c)
            return true
        }
        if hit == wave6.SH_NONE {
            if (*s).modal && (*s).dismiss {
                let prev2: usize = (*s).cur
                wave6.sheet_close(s)
                (*c).sh_ms = 0
                sh_notify(c, prev2)
                touch(c)
            }
            return (*s).modal
        }
    }
    if hit == wave6.SH_BODY {
        let f: fn(*mut app.App, u32, f64, f64) = (*c).sh_bptr
        f((*c).a, kind, x, y)
        touch(c)
        return true
    }
    return false
}

// keys of the sheet: Esc / Up / Down / PgUp / PgDn; a modal sheet takes every key
fn sh_key(c: *mut Ctl, key: u32) -> bool {
    (*c).sh_kb = true
    let modal: bool = (*c).sh.modal
    if !modal && key != editor.KEY_ESC && key != editor.KEY_PGUP && key != editor.KEY_PGDN {
        return false
    }
    let prev: usize = (*c).sh.cur
    let r: u32 = wave6.sheet_key(&(*c).sh, key)
    if r == wave6.SH_KEY_NONE {
        return modal
    }
    (*c).sh_ms = 0
    sh_notify(c, prev)
    touch(c)
    return true
}

fn draw_sheet(c: *mut Ctl, rc: *mut render.Ctx) {
    if !sh_visible(c) {
        if (*c).sh_on {
            sh_sync_marker(c)
        }
        return
    }
    var stt: u32 = 0 as u32
    if (*c).sh_kb && (*c).sh.cur != kit.NONE {
        stt = kit.ST_FOCUS
    }
    sh_sync_marker(c)
    wave6.sheet_draw(rc, &(*c).sh, 0.0, 0.0, (*c).win_w, (*c).win_h, stt)
    var r: [f64; 4] = [0.0, 0.0, 0.0, 0.0]
    if wave6.sheet_body_begin(rc, &(*c).sh, 0.0, 0.0, (*c).win_w, (*c).win_h, &r) {
        let f: fn(*mut app.App, *mut render.Ctx, f64, f64, f64, f64) = (*c).sh_body
        f((*c).a, rc, r[0], r[1], r[2], r[3])
        wave6.sheet_body_end(rc)
    }
}

// ------------------------------------------------------------ the property grid

fn propgrid(a: *mut app.App, name: str, wpt: usize, hpt: usize, rows: *mut wave6.PgRow, n: usize,
    on_change: fn(*mut app.App, usize), on_edit: fn(*mut app.App, usize)) -> usize {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 || (*c).n >= CTL_MAX || n > PG_ROWS_MAX {
        return NONE
    }
    let p: u64 = rt.heap_alloc(4096)
    if p == 0 {
        return NONE
    }
    *(p as *mut W6) = w6_blank()
    let node: usize = app.custom(a, widget.KIND_BUTTON, wpt, hpt)
    if node == NONE {
        return NONE
    }
    (*scene.nd(sc_of(c), node)).no_fill = 1 as u32
    let i: usize = add_entry(c, K_PGRID, node)
    (*c).aux[i] = p as usize
    set_cb(c, i, on_change)
    let w: *mut W6 = p as *mut W6
    (*w).rows = rows
    (*w).n = n
    (*w).on_edit = on_edit
    scene.node_set_draw(sc_of(c), node, c as u64, w6_draw)
    a11y.a11y_set_role(app.ax(a), node, a11y.ROLE_TREE)
    name_node(c, node, name)
    return node
}

fn w6_idx(a: *mut app.App, id: usize) -> usize {
    let c: *mut Ctl = st(a)
    let i: usize = find(c, id)
    if i == NONE || (*c).kind[i] != K_PGRID {
        return NONE
    }
    return i
}

// the PGK_* (or PGE_COMMIT) of the last event and its row
fn propgrid_event(a: *mut app.App, id: usize) -> u32 {
    let i: usize = w6_idx(a, id)
    if i == NONE { return 0 as u32 }
    return (*w6_of(st(a), i)).ev
}

fn propgrid_row(a: *mut app.App, id: usize) -> usize {
    let i: usize = w6_idx(a, id)
    if i == NONE { return NONE }
    return (*w6_of(st(a), i)).ev_row
}

fn propgrid_selected(a: *mut app.App, id: usize) -> usize {
    let i: usize = w6_idx(a, id)
    if i == NONE { return NONE }
    let sel: usize = (*w6_of(st(a), i)).g.sel
    if sel == kit.NONE { return NONE }
    return sel
}

fn propgrid_select(a: *mut app.App, id: usize, row: usize) {
    let c: *mut Ctl = st(a)
    let i: usize = w6_idx(a, id)
    if i == NONE { return }
    let w: *mut W6 = w6_of(c, i)
    if row != NONE && row >= (*w).n { return }
    (*w).g.sel = row
    if row == NONE {
        (*w).g.sel = kit.NONE
    }
    w6_fit_sel(c, i)
    w6_describe(c, i)
    touch(c)
}

fn propgrid_top(a: *mut app.App, id: usize) -> usize {
    let i: usize = w6_idx(a, id)
    if i == NONE { return 0 }
    return (*w6_of(st(a), i)).g.top
}

fn propgrid_set_top(a: *mut app.App, id: usize, top: usize) {
    let c: *mut Ctl = st(a)
    let i: usize = w6_idx(a, id)
    if i == NONE { return }
    let w: *mut W6 = w6_of(c, i)
    (*w).g.top = top
    w6_fit_top(c, i)
    touch(c)
}

// the label column in permille of the width
fn propgrid_label_pm(a: *mut app.App, id: usize) -> i64 {
    let i: usize = w6_idx(a, id)
    if i == NONE { return 0 as i64 }
    return (*w6_of(st(a), i)).g.label_pm
}

// the inline editor on / off (off = every edit asks the program: `edit(a, id)`)
fn propgrid_inline(a: *mut app.App, id: usize, on: bool) {
    let i: usize = w6_idx(a, id)
    if i == NONE { return }
    (*w6_of(st(a), i)).inl = on
}

// The value cell of row `row` in window pixels (x, y, w, h); false for a group or a row not shown.
fn propgrid_cell(a: *mut app.App, id: usize, row: usize, out: *mut [f64; 4]) -> bool {
    let c: *mut Ctl = st(a)
    let i: usize = w6_idx(a, id)
    if i == NONE { return false }
    let w: *mut W6 = w6_of(c, i)
    let sc: *mut scene.Scene = sc_of(c)
    let nd: usize = (*c).node[i]
    return wave6.pg_value_rect(app.app_ctx(a), &(*w).g, (*w).rows, (*w).n, row, scene.node_x(sc, nd),
        scene.node_y(sc, nd), scene.node_w(sc, nd), scene.node_h(sc, nd), out)
}

// The row (any kind) at visible position `k` counted from the top, as a rectangle; for tests and automation.
fn propgrid_row_rect(a: *mut app.App, id: usize, row: usize, out: *mut [f64; 4]) -> bool {
    let c: *mut Ctl = st(a)
    let i: usize = w6_idx(a, id)
    if i == NONE { return false }
    let w: *mut W6 = w6_of(c, i)
    if row >= (*w).n || !wave6.pg_is_visible((*w).rows, (*w).n, row) { return false }
    let vp: usize = wave6.pg_visible_pos((*w).rows, (*w).n, row)
    if vp < (*w).g.top { return false }
    let sc: *mut scene.Scene = sc_of(c)
    let nd: usize = (*c).node[i]
    let rh: f64 = wave6.pg_row_h(app.app_ctx(a))
    let ry: f64 = scene.node_y(sc, nd) + ((vp - (*w).g.top) as f64) * rh
    if ry + rh > scene.node_y(sc, nd) + scene.node_h(sc, nd) + 0.5 { return false }
    (*out)[0] = scene.node_x(sc, nd)
    (*out)[1] = ry
    (*out)[2] = scene.node_w(sc, nd)
    (*out)[3] = rh
    return true
}

fn propgrid_editing(a: *mut app.App) -> bool {
    return (*st(a)).pg_edit_i != NONE
}

// the text in the inline editor (valid until the next change of it)
fn propgrid_edit_text(a: *mut app.App) -> str {
    let c: *mut Ctl = st(a)
    let t: *mut textbuf.TextBuf = editor.editor_buf(&(*c).pg_ed)
    return str { p: textbuf.tb_ptr(t) as *mut u8, n: textbuf.tb_len(t) }
}

fn propgrid_commit(a: *mut app.App) {
    w6_commit(st(a))
}

fn propgrid_cancel(a: *mut app.App) {
    w6_cancel(st(a))
}

// the description of the selected row for the screen reader, after the program changed rows itself
fn propgrid_refresh(a: *mut app.App, id: usize) {
    let c: *mut Ctl = st(a)
    let i: usize = w6_idx(a, id)
    if i == NONE { return }
    w6_describe(c, i)
    touch(c)
}

fn w6_fit(c: *mut Ctl, i: usize) -> usize {
    return wave6.pg_fit(app.app_ctx((*c).a), scene.node_h(sc_of(c), (*c).node[i]))
}

fn w6_fit_top(c: *mut Ctl, i: usize) {
    let w: *mut W6 = w6_of(c, i)
    wave6.pg_clamp_top(&(*w).g, (*w).rows, (*w).n, w6_fit(c, i))
}

fn w6_fit_sel(c: *mut Ctl, i: usize) {
    let w: *mut W6 = w6_of(c, i)
    wave6.pg_show_sel(&(*w).g, (*w).rows, (*w).n, w6_fit(c, i))
}

// ---- the a11y description: "label, value"

fn desc_put(w: *mut W6, p: u64, n: usize) {
    var k: usize = 0
    while k < n && (*w).dn < 190 {
        (*w).desc[(*w).dn] = *((p + k as u64) as *mut u8)
        (*w).dn = (*w).dn + 1
        k = k + 1
    }
}

fn desc_str(w: *mut W6, s: str) {
    desc_put(w, s.p as u64, s.n)
}

// decimal digits of v into buf (at most 24 bytes), returns the length
fn w6_fmt_i64(v: i64, buf: *mut [u8; 24]) -> usize {
    var tmp: [u8; 24] = [0 as u8; 24]
    var m: i64 = v
    var neg: bool = false
    if m < 0 as i64 {
        neg = true
        m = 0 as i64 - m
    }
    var k: usize = 0
    if m == 0 as i64 {
        tmp[0] = 48 as u8
        k = 1
    }
    while m > 0 as i64 && k < 22 {
        tmp[k] = (48 + (m % 10 as i64)) as u8
        m = m / 10 as i64
        k = k + 1
    }
    var o: usize = 0
    if neg {
        (*buf)[0] = 45 as u8
        o = 1
    }
    while k > 0 {
        k = k - 1
        (*buf)[o] = tmp[k]
        o = o + 1
    }
    return o
}

fn desc_dec(w: *mut W6, v: i64) {
    var b: [u8; 24] = [0 as u8; 24]
    let n: usize = w6_fmt_i64(v, &b)
    desc_put(w, (&b[0]) as u64, n)
}

fn w6_describe(c: *mut Ctl, i: usize) {
    let w: *mut W6 = w6_of(c, i)
    (*w).dn = 0
    let sel: usize = (*w).g.sel
    if sel != kit.NONE && sel < (*w).n {
        let r: *mut wave6.PgRow = wave6.pg_row_at((*w).rows, sel)
        desc_str(w, (*r).label)
        if (*r).kind == wave6.PG_GROUP {
            if (*r).on {
                desc_str(w, ", expanded")
            } else {
                desc_str(w, ", collapsed")
            }
        } else {
            desc_str(w, ", ")
            if (*r).kind == wave6.PG_BOOL {
                if (*r).on {
                    desc_str(w, "on")
                } else {
                    desc_str(w, "off")
                }
            } else if (*r).kind == wave6.PG_NUM {
                desc_dec(w, (*r).num)
                if (*r).text.n > 0 {
                    desc_str(w, " ")
                    desc_str(w, (*r).text)
                }
            } else if (*r).kind == wave6.PG_COLOR {
                desc_str(w, "color")
            } else {
                desc_str(w, (*r).text)
            }
            if (*r).readonly {
                desc_str(w, ", read only")
            }
        }
    }
    a11y.a11y_set_description(app.ax((*c).a), (*c).node[i], (&(*w).desc[0]) as u64, (*w).dn)
}

// ---- the inline editor

fn w6_begin_edit(c: *mut Ctl, i: usize) -> bool {
    let w: *mut W6 = w6_of(c, i)
    let sel: usize = (*w).g.sel
    if !(*w).inl || sel == kit.NONE || sel >= (*w).n || sel >= PG_ROWS_MAX {
        return false
    }
    let r: *mut wave6.PgRow = wave6.pg_row_at((*w).rows, sel)
    if (*r).readonly || ((*r).kind != wave6.PG_TEXT && (*r).kind != wave6.PG_NUM) {
        return false
    }
    if (*c).pg_edit_i != NONE {
        w6_commit(c)
    }
    if (*r).kind == wave6.PG_TEXT {
        editor.editor_set_text(&(*c).pg_ed, (*r).text.p as u64, (*r).text.n)
    } else {
        var tmp: [u8; 24] = [0 as u8; 24]
        let n: usize = w6_fmt_i64((*r).num, &tmp)
        editor.editor_set_text(&(*c).pg_ed, (&tmp[0]) as u64, n)
    }
    editor.editor_select_all(&(*c).pg_ed)
    (*c).pg_edit_i = i
    (*c).pg_edit_row = sel
    touch(c)
    return true
}

fn w6_cancel(c: *mut Ctl) {
    if (*c).pg_edit_i == NONE {
        return
    }
    (*c).pg_edit_i = NONE
    (*c).pg_edit_row = NONE
    touch(c)
}

// Applies the inline editor to its row; a number that does not parse is dropped (the row stays as it was).
fn w6_commit(c: *mut Ctl) {
    let i: usize = (*c).pg_edit_i
    if i == NONE {
        return
    }
    let row: usize = (*c).pg_edit_row
    (*c).pg_edit_i = NONE
    (*c).pg_edit_row = NONE
    touch(c)
    let w: *mut W6 = w6_of(c, i)
    let t: *mut textbuf.TextBuf = editor.editor_buf(&(*c).pg_ed)
    let p: u64 = textbuf.tb_ptr(t)
    let n: usize = textbuf.tb_len(t)
    let r: *mut wave6.PgRow = wave6.pg_row_at((*w).rows, row)
    if (*r).kind == wave6.PG_NUM {
        var k: usize = 0
        var neg: bool = false
        if n > 0 && *(p as *mut u8) == 45 as u8 {
            neg = true
            k = 1
        }
        if k >= n || n - k > 17 {
            return
        }
        var v: i64 = 0
        while k < n {
            let ch: u8 = *((p + k as u64) as *mut u8)
            if ch < 48 as u8 || ch > 57 as u8 {
                return
            }
            v = v * 10 as i64 + ((ch as i64) - 48 as i64)
            k = k + 1
        }
        if neg {
            v = 0 as i64 - v
        }
        (*r).num = v
    } else {
        if (*w).own_p[row] != 0 as u64 {
            rt.heap_free((*w).own_p[row], (*w).own_n[row])
            (*w).own_p[row] = 0 as u64
            (*w).own_n[row] = 0
        }
        var q: u64 = 0
        if n > 0 {
            q = rt.heap_alloc(n)
            if q == 0 {
                return
            }
            rt.mem_copy(q, p, n)
            (*w).own_p[row] = q
            (*w).own_n[row] = n
        }
        (*r).text = str { p: q as *mut u8, n: n }
    }
    (*w).ev = PGE_COMMIT
    (*w).ev_row = row
    w6_describe(c, i)
    fire(c, i)
}

// ---- events

fn w6_event(c: *mut Ctl, i: usize, e: u32) {
    let w: *mut W6 = w6_of(c, i)
    (*w).ev = e
    (*w).ev_row = (*w).g.sel
    if e == wave6.PGK_NONE {
        return
    }
    if e == wave6.PGK_EDIT {
        w6_describe(c, i)
        if !w6_begin_edit(c, i) {
            let f: fn(*mut app.App, usize) = (*w).on_edit
            f((*c).a, (*c).node[i])
        }
        touch(c)
        return
    }
    w6_fit_sel(c, i)
    w6_describe(c, i)
    touch(c)
    fire(c, i)
}

fn w6_draw(ud: u64, rc: *mut render.Ctx, e: *mut widget.Widget) {
    let c: *mut Ctl = ud as *mut Ctl
    var i: usize = 0
    while i < (*c).n {
        if is_w6_kind((*c).kind[i]) && wid(c, i) == e {
            break
        }
        i = i + 1
    }
    if i >= (*c).n {
        return
    }
    let w: *mut W6 = w6_of(c, i)
    let x: f64 = widget.w_x(e)
    let y: f64 = widget.w_y(e)
    let wd: f64 = widget.w_w(e)
    let h: f64 = widget.w_h(e)
    let focused: bool = app.focus((*c).a) == (*c).node[i]
    wave6.pg_clamp_top(&(*w).g, (*w).rows, (*w).n, wave6.pg_fit(rc, h))
    wave6.pg_draw(rc, &(*w).g, (*w).rows, (*w).n, focused, x, y, wd, h)
    if (*c).pg_edit_i == i {
        var r: [f64; 4] = [0.0, 0.0, 0.0, 0.0]
        if wave6.pg_value_rect(rc, &(*w).g, (*w).rows, (*w).n, (*c).pg_edit_row, x, y, wd, h, &r) {
            var f: widget.Widget = widget.widget_new(widget.KIND_TEXTBOX)
            widget.w_place(&f, r[0], r[1], r[2], r[3])
            widget.w_set_focus(&f, true)
            render.draw_textfield(rc, &f, &(*c).pg_ed, true)
        }
    }
}

fn w6_hover(c: *mut Ctl, i: usize, x: f64, y: f64) -> bool {
    let w: *mut W6 = w6_of(c, i)
    let sc: *mut scene.Scene = sc_of(c)
    let nd: usize = (*c).node[i]
    var part: u32 = 0 as u32
    let row: usize = wave6.pg_hit(app.app_ctx((*c).a), &(*w).g, (*w).rows, (*w).n, scene.node_x(sc, nd),
        scene.node_y(sc, nd), scene.node_w(sc, nd), scene.node_h(sc, nd), x, y, &part)
    if row == (*w).g.hover && part == (*w).g.hpart {
        return false
    }
    (*w).g.hover = row
    (*w).g.hpart = part
    return true
}

fn w6_clear_hover(c: *mut Ctl, keep: usize) -> bool {
    var ch: bool = false
    var i: usize = 0
    while i < (*c).n {
        if is_w6_kind((*c).kind[i]) && i != keep {
            let w: *mut W6 = w6_of(c, i)
            if (*w).g.hover != kit.NONE || (*w).g.hpart != 0 as u32 {
                (*w).g.hover = kit.NONE
                (*w).g.hpart = 0 as u32
                ch = true
            }
        }
        i = i + 1
    }
    return ch
}

// pointer events for the property grids; true = repaint
fn w6_ptr(c: *mut Ctl, kind: u32, x: f64, y: f64) -> bool {
    let sc: *mut scene.Scene = sc_of(c)
    if (*c).w6_drag != NONE {
        let di: usize = (*c).w6_drag
        let dw: *mut W6 = w6_of(c, di)
        if kind == fuiwirt.HOOK_MOVE {
            wave6.pg_div_move(&(*dw).g, x, scene.node_w(sc, (*c).node[di]))
            return true
        }
        if kind == fuiwirt.HOOK_UP || kind == fuiwirt.HOOK_LEAVE {
            wave6.pg_div_end(&(*dw).g)
            (*c).w6_drag = NONE
            return true
        }
    }
    if kind == fuiwirt.HOOK_LEAVE {
        return w6_clear_hover(c, NONE)
    }
    var node: usize = scene.scene_hit(sc, x, y)
    var i: usize = NONE
    if node != NONE && node < scene.scene_count(sc) {
        i = find(c, node)
    }
    if i != NONE && !is_w6_kind((*c).kind[i]) {
        i = NONE
    }
    var ch: bool = w6_clear_hover(c, i)
    if i == NONE {
        if kind == fuiwirt.HOOK_DOWN && (*c).pg_edit_i != NONE {
            w6_commit(c)
            ch = true
        }
        return ch
    }
    if w6_hover(c, i, x, y) {
        ch = true
    }
    if kind != fuiwirt.HOOK_DOWN {
        return ch
    }
    let w: *mut W6 = w6_of(c, i)
    let part: u32 = (*w).g.hpart
    let row: usize = (*w).g.hover
    if (*c).pg_edit_i != NONE {
        // a press inside the cell being edited stays in the editor (no mouse caret placement: honest limit)
        if (*c).pg_edit_i == i && row == (*c).pg_edit_row && part == wave6.PGP_VALUE {
            return true
        }
        w6_commit(c)
    }
    if part == wave6.PGP_DIV {
        wave6.pg_div_begin(&(*w).g, x)
        (*c).w6_drag = i
        touch(c)
        return true
    }
    let e: u32 = wave6.pg_press(&(*w).g, (*w).rows, (*w).n, row, part)
    w6_event(c, i, e)
    touch(c)
    return true
}

// the wheel over a property grid (dy in notches, positive = down); true = used
fn w6_wheel(c: *mut Ctl, dy: f64) -> bool {
    if (*c).pg_edit_i != NONE {
        return false
    }
    let sc: *mut scene.Scene = sc_of(c)
    let node: usize = scene.scene_hit(sc, (*c).px, (*c).py)
    if node == NONE || node >= scene.scene_count(sc) {
        return false
    }
    let i: usize = find(c, node)
    if i == NONE || !is_w6_kind((*c).kind[i]) {
        return false
    }
    let w: *mut W6 = w6_of(c, i)
    var d: i64 = (dy * 3.0) as i64
    if d == 0 as i64 {
        if dy > 0.0 {
            d = 1 as i64
        } else if dy < 0.0 {
            d = 0 as i64 - 1 as i64
        }
    }
    if wave6.pg_scroll_by(&(*w).g, (*w).rows, (*w).n, w6_fit(c, i), d) {
        touch(c)
    }
    return true
}

// keys of the focused property grid; true = used
fn w6_key(c: *mut Ctl, i: usize, key: u32) -> bool {
    let w: *mut W6 = w6_of(c, i)
    let e: u32 = wave6.pg_key(&(*w).g, (*w).rows, (*w).n, key)
    if e == wave6.PGK_NONE {
        return false
    }
    w6_event(c, i, e)
    return true
}

// Space / Enter that reach the node as an activation (the grid has taken the keys it knows already)
fn w6_act(c: *mut Ctl, i: usize) {
    let w: *mut W6 = w6_of(c, i)
    let e: u32 = wave6.pg_key(&(*w).g, (*w).rows, (*w).n, 32 as u32)
    if e != wave6.PGK_NONE {
        w6_event(c, i, e)
    }
}

// ============================================================ WAVE 7 CONTROLS + TIMELINES (r146, r149 wiring)
//
// RANGE SLIDER (lib/fui/wave7.fi): ONE focusable node with two thumbs; the arrow keys, Home / End move the focused thumb,
// Space / Enter switch the thumb, a press picks the nearer thumb and drags it (thumbs never cross). The screen reader gets a
// slider named by `name` whose value is the focused thumb (per mille of min..max).
//
//     let r: usize = appctl.range_slider(a, "Price", 280, 0, 100, 5, 20, 80, changed)
//     appctl.range_lo(a, r)  appctl.range_hi(a, r)  appctl.set_range_values(a, r, 30, 70)
//
// TIMELINES (lib/fui/timeline.fi): up to TL_APP per window on the window's clock. The program builds the tracks on
// `timeline_ref`, `timeline_play` starts the clock; the library advances it by the REAL frame time (dt, from the program
// timer -- no frame counting) and repaints until it stands. The program reads `timeline_value(a, id, track)` while it
// paints. REDUCED MOTION (theme motion 0 or the system setting on the transition registry, syspref.motion_apply):
// `timeline_play` jumps to the final state at once, no frame in between.

const TL_APP: usize = 8

struct W7 {
    tl: [timeline.Timeline; 8],
    n: usize,
    last: i64, // host clock of the last tick (0 = no timeline was running)
}

fn w7_get(c: *mut Ctl) -> *mut W7 {
    if (*c).w7 != 0 {
        return (*c).w7 as *mut W7
    }
    var probe: [W7; 2] = [W7 { tl: [timeline.timeline_new(); 8], n: 0, last: 0 }; 2]
    let sz: usize = ((&probe[1]) as usize) - ((&probe[0]) as usize)
    let p: u64 = rt.heap_alloc(sz)
    if p == 0 {
        return 0 as u64 as *mut W7
    }
    *(p as *mut W7) = W7 { tl: [timeline.timeline_new(); 8], n: 0, last: 0 }
    (*c).w7 = p
    return p as *mut W7
}

fn range_sync(c: *mut Ctl, i: usize) {
    let w: *mut W5 = w5_of(c, i)
    var v: i64 = (*w).rg.lo
    if (*w).rg.focus == wave7.RANGE_HI {
        v = (*w).rg.hi
    }
    var pm: i64 = 0
    if (*w).rg.max > (*w).rg.min {
        pm = (v - (*w).rg.min) * 1000 / ((*w).rg.max - (*w).rg.min)
    }
    widget.w_set_value(wid(c, i), pm)
}

fn range_idx(a: *mut app.App, id: usize) -> usize {
    return w5_idx(a, id, K_RANGE)
}

fn range_slider(a: *mut app.App, name: str, wpt: usize, min: i64, max: i64, step: i64, lo: i64, hi: i64,
    on_change: fn(*mut app.App, usize)) -> usize {
    if max <= min {
        return NONE
    }
    let node: usize = w5_make(a, K_RANGE, wpt, 32, name, a11y.ROLE_SLIDER, on_change)
    if node == NONE {
        return NONE
    }
    let c: *mut Ctl = st(a)
    let i: usize = find(c, node)
    (*w5_of(c, i)).rg = wave7.range_new(min, max, step, lo, hi)
    range_sync(c, i)
    return node
}

fn range_lo(a: *mut app.App, id: usize) -> i64 {
    let i: usize = range_idx(a, id)
    if i == NONE { return 0 }
    return (*w5_of(st(a), i)).rg.lo
}

fn range_hi(a: *mut app.App, id: usize) -> i64 {
    let i: usize = range_idx(a, id)
    if i == NONE { return 0 }
    return (*w5_of(st(a), i)).rg.hi
}

// program side: does not call `changed`
fn set_range_values(a: *mut app.App, id: usize, lo: i64, hi: i64) {
    let c: *mut Ctl = st(a)
    let i: usize = range_idx(a, id)
    if i == NONE { return }
    wave7.range_set(&(*w5_of(c, i)).rg, lo, hi)
    range_sync(c, i)
    touch(c)
}

// which thumb the keys move: wave7.RANGE_LO or wave7.RANGE_HI
fn range_focus_thumb(a: *mut app.App, id: usize) -> usize {
    let i: usize = range_idx(a, id)
    if i == NONE { return wave7.RANGE_NONE }
    return (*w5_of(st(a), i)).rg.focus
}

fn tl_reduced(c: *mut Ctl) -> bool {
    return motion_of(c) == 0 || app.app_reduced_motion((*c).a)
}

// true while the window's timelines respect reduced motion (they jump to the end)
fn timeline_reduced(a: *mut app.App) -> bool {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 { return false }
    return tl_reduced(c)
}

// a new timeline of the window (NONE when TL_APP are taken)
fn timeline(a: *mut app.App) -> usize {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 { return NONE }
    let t: *mut W7 = w7_get(c)
    if t as u64 == 0 || (*t).n >= TL_APP { return NONE }
    let i: usize = (*t).n
    (*t).n = i + 1
    (*t).tl[i] = timeline.timeline_new()
    return i
}

// the timeline to build tracks on (timeline.seq / par / at / stagger ...); a null pointer for a bad id
fn timeline_ref(a: *mut app.App, id: usize) -> *mut timeline.Timeline {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 { return 0 as u64 as *mut timeline.Timeline }
    let t: *mut W7 = w7_get(c)
    if t as u64 == 0 || id >= (*t).n { return 0 as u64 as *mut timeline.Timeline }
    return &(*t).tl[id]
}

fn timeline_play(a: *mut app.App, id: usize) {
    let tl: *mut timeline.Timeline = timeline_ref(a, id)
    if tl as u64 == 0 { return }
    let c: *mut Ctl = st(a)
    let t: *mut W7 = w7_get(c)
    let red: bool = tl_reduced(c)
    timeline.set_reduced(tl, red)
    if !tl_busy(c) {
        (*t).last = fuiwirt.host_now(app.app_host(a))
    }
    timeline.play(tl)
    if red {
        let any: bool = timeline.advance(tl, 0)
    }
    touch(c)
}

fn timeline_pause(a: *mut app.App, id: usize) {
    let tl: *mut timeline.Timeline = timeline_ref(a, id)
    if tl as u64 == 0 { return }
    timeline.pause(tl)
}

fn timeline_stop(a: *mut app.App, id: usize) {
    let tl: *mut timeline.Timeline = timeline_ref(a, id)
    if tl as u64 == 0 { return }
    timeline.stop(tl)
    touch(st(a))
}

fn timeline_value(a: *mut app.App, id: usize, track: usize) -> f64 {
    let tl: *mut timeline.Timeline = timeline_ref(a, id)
    if tl as u64 == 0 || track >= timeline.track_count(tl) { return 0.0 }
    return timeline.value(tl, track)
}

fn timeline_playing(a: *mut app.App, id: usize) -> bool {
    let tl: *mut timeline.Timeline = timeline_ref(a, id)
    if tl as u64 == 0 { return false }
    return timeline.playing(tl)
}

fn timeline_finished(a: *mut app.App, id: usize) -> bool {
    let tl: *mut timeline.Timeline = timeline_ref(a, id)
    if tl as u64 == 0 { return false }
    return timeline.finished(tl)
}

// the timer: advance every playing timeline by the real time since the last tick; true = repaint
fn tl_tick(c: *mut Ctl, now: i64) -> bool {
    if (*c).w7 == 0 { return false }
    let t: *mut W7 = (*c).w7 as *mut W7
    var dt: i64 = 0
    if (*t).last != 0 {
        dt = now - (*t).last
    }
    (*t).last = now
    var any: bool = false
    let red: bool = tl_reduced(c)
    var i: usize = 0
    while i < (*t).n {
        if timeline.playing(&(*t).tl[i]) {
            timeline.set_reduced(&(*t).tl[i], red)
            // a tick means a repaint, also the one that ends it (the last value must be painted)
            let busy: bool = timeline.advance(&(*t).tl[i], dt)
            any = true
        }
        i = i + 1
    }
    if !tl_busy(c) {
        (*t).last = 0
    }
    return any
}

fn tl_busy(c: *mut Ctl) -> bool {
    if (*c).w7 == 0 { return false }
    let t: *mut W7 = (*c).w7 as *mut W7
    var i: usize = 0
    while i < (*t).n {
        if timeline.playing(&(*t).tl[i]) {
            return true
        }
        i = i + 1
    }
    return false
}

// ============================================================ WAVE 8 CONTROLS (r45 wiring)
//
// Spinner, time picker, breadcrumb, info bar and stepper of lib/fui/wave8.fi in the ten-line API. Each is ONE node
// (a focusable one where keys make sense); the state lives in a heap `W8` next to the node.
//
//     let sp: usize = appctl.spinner(a, "Loading", 32)            // still when theme motion is 0 / reduced motion
//     appctl.spinner_on(a, sp, false)                              // program side: hide the busy ring
//     let tp: usize = appctl.timepicker(a, "Alarm", 160, 7, 30, 5, true, changed)   // h, m, minute step, 24 h
//     appctl.timepicker_hour(a, tp)  appctl.timepicker_minute(a, tp)  appctl.set_time(a, tp, 18, 45)
//     let bc: usize = appctl.breadcrumb(a, "Path", 320, changed)
//     appctl.breadcrumb_add(a, bc, "Home")  appctl.breadcrumb_event(a, bc)   // crumb index or BREADCRUMB_OVERFLOW
//     let ib: usize = appctl.infobar(a, wave8.IB_WARNING, "Low disk", "Only 2 GB left", 420, changed)
//     appctl.infobar_action(a, ib, "Clean up")  appctl.infobar_event(a, ib)  // IB_PART_ACTION / IB_PART_CLOSE
//     let st: usize = appctl.stepper(a, "Setup", 420, changed)
//     appctl.stepper_add(a, st, "Account")  appctl.stepper_current(a, st)  appctl.stepper_set(a, st, 1, 2)
//
// `changed(a, id)` runs when the USER changed the control (the program setters do not call it). The a11y tree gets a
// value / description: time "07:30", path "Home > Mods > Fabric", step "Step 2 of 4: Mods", bar title + message.
// HONEST (wave 8): the closed info bar is hidden and gives back role / name; digits of the time picker come through
// the character hook (typed digits), the wheel acts on the field under the pointer; no seconds, one-line info bar.

const K_BUSY: u32 = 24
const K_TIMEP: u32 = 25
const K_CRUMB: u32 = 26
const K_INFOB: u32 = 27
const K_STEPPER: u32 = 28
const NO8: usize = 1000
const BREADCRUMB_OVERFLOW: usize = 999

struct W8 {
    on: bool,
    hov: usize, // hovered part (NO8 = none)
    foc: usize, // focused part (NO8 = default)
    ev: usize, // the last event (crumb / info bar part)
    cur: usize,
    reach: usize,
    tp: wave8.Time,
    cr: wave8.Crumbs,
    ib: wave8.InfoBar,
    sp: wave8.Steps,
    name: str,
    role: u32,
    dn: usize,
    desc: [u8; 192],
}

fn is_w8_kind(k: u32) -> bool {
    return k >= K_BUSY && k <= K_STEPPER
}

fn w8_of(c: *mut Ctl, i: usize) -> *mut W8 {
    return (*c).aux[i] as *mut W8
}

fn w8_idx(a: *mut app.App, id: usize, kind: u32) -> usize {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 { return NONE }
    let i: usize = find(c, id)
    if i == NONE || (*c).kind[i] != kind {
        return NONE
    }
    return i
}

fn w8_put(w: *mut W8, p: u64, n: usize) {
    var k: usize = 0
    while k < n && (*w).dn < 188 {
        (*w).desc[(*w).dn] = *((p + k as u64) as *mut u8)
        (*w).dn = (*w).dn + 1
        k = k + 1
    }
}

fn w8_str(w: *mut W8, s: str) {
    w8_put(w, s.p as u64, s.n)
}

fn w8_num(w: *mut W8, v: usize) {
    var buf: [u8; 24] = [0 as u8; 24]
    var tmp: [u8; 24] = [0 as u8; 24]
    var m: usize = v
    var k: usize = 0
    if m == 0 {
        tmp[0] = 48 as u8
        k = 1
    }
    while m > 0 && k < 20 {
        tmp[k] = (48 + m % 10) as u8
        m = m / 10
        k = k + 1
    }
    var j: usize = 0
    while j < k {
        buf[j] = tmp[k - 1 - j]
        j = j + 1
    }
    w8_put(w, (&buf[0]) as u64, k)
}

// value + description for the screen reader, from the state
fn w8_sync(c: *mut Ctl, i: usize) {
    let w: *mut W8 = w8_of(c, i)
    let k: u32 = (*c).kind[i]
    let ax: *mut a11y.A11y = app.ax((*c).a)
    (*w).dn = 0
    if k == K_TIMEP {
        var f: usize = 0
        while f < wave8.tp_fields(&(*w).tp) {
            var tb: [u8; 24] = [0 as u8; 24]
            let n: usize = wave8.tp_text(&(*w).tp, f, &tb)
            if f == wave8.TP_AMPM {
                w8_str(w, " ")
            } else if f > 0 {
                w8_str(w, ":")
            }
            w8_put(w, (&tb[0]) as u64, n)
            f = f + 1
        }
        widget.w_set_value(wid(c, i), (((*w).tp.h * 60 + (*w).tp.m) * 1000 / 1440) as i64)
    } else if k == K_CRUMB {
        var j: usize = 0
        while j < (*w).cr.n {
            if j > 0 {
                w8_str(w, " > ")
            }
            w8_str(w, (*w).cr.label[j])
            j = j + 1
        }
    } else if k == K_INFOB {
        if (*w).ib.severity == wave8.IB_ERROR {
            w8_str(w, "Error. ")
        } else if (*w).ib.severity == wave8.IB_WARNING {
            w8_str(w, "Warning. ")
        } else if (*w).ib.severity == wave8.IB_SUCCESS {
            w8_str(w, "Success. ")
        }
        w8_str(w, (*w).ib.message)
        if (*w).ib.action.n > 0 {
            w8_str(w, ". Action: ")
            w8_str(w, (*w).ib.action)
        }
    } else if k == K_STEPPER {
        w8_str(w, "Step ")
        w8_num(w, (*w).cur + 1)
        w8_str(w, " of ")
        w8_num(w, (*w).sp.n)
        if (*w).cur < (*w).sp.n {
            w8_str(w, ": ")
            w8_str(w, (*w).sp.label[(*w).cur])
        }
        var pm: usize = 0
        if (*w).sp.n > 1 {
            pm = (*w).cur * 1000 / ((*w).sp.n - 1)
        }
        widget.w_set_value(wid(c, i), pm as i64)
    }
    if (*w).dn > 0 && (*w).on {
        a11y.a11y_set_description(ax, (*c).node[i], (&(*w).desc[0]) as u64, (*w).dn)
    } else {
        a11y.a11y_set_description(ax, (*c).node[i], 0, 0)
    }
}

fn w8_make(a: *mut app.App, kind: u32, wpt: usize, hpt: usize, focusable: bool, name: str, role: u32,
    on_change: fn(*mut app.App, usize)) -> usize {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 || (*c).n >= CTL_MAX {
        return NONE
    }
    let p: u64 = rt.heap_alloc(2048)
    if p == 0 {
        return NONE
    }
    *(p as *mut W8) = W8 { on: true, hov: NO8, foc: NO8, ev: NO8, cur: 0, reach: 0,
        tp: wave8.tp_new(0, 0, 1, true), cr: wave8.crumbs_new(), ib: wave8.infobar_new(wave8.IB_INFO, "", ""),
        sp: wave8.steps_new(), name: name, role: role, dn: 0, desc: [0 as u8; 192] }
    var wk: u32 = widget.KIND_NONE
    if focusable {
        wk = widget.KIND_BUTTON
    }
    let node: usize = app.custom(a, wk, wpt, hpt)
    if node == NONE {
        return NONE
    }
    (*scene.nd(sc_of(c), node)).no_fill = 1 as u32
    let i: usize = add_entry(c, kind, node)
    (*c).aux[i] = p as usize
    set_cb(c, i, on_change)
    scene.node_set_draw(sc_of(c), node, c as u64, w8_draw)
    a11y.a11y_set_role(app.ax(a), node, role)
    name_node(c, node, name)
    return node
}

fn w8_noop(a: *mut app.App, id: usize) {
}

fn w8_top(h: f64, ch: f64) -> f64 {
    if h > ch {
        return (h - ch) / 2.0
    }
    return 0.0
}

fn spinner(a: *mut app.App, name: str, size_pt: usize) -> usize {
    let node: usize = w8_make(a, K_BUSY, size_pt, size_pt, false, name, a11y.ROLE_PROGRESSBAR, w8_noop)
    return node
}

fn spinner_on(a: *mut app.App, id: usize, on: bool) {
    let i: usize = w8_idx(a, id, K_BUSY)
    if i == NONE { return }
    (*w8_of(st(a), i)).on = on
    touch(st(a))
}

fn spinner_is_on(a: *mut app.App, id: usize) -> bool {
    let i: usize = w8_idx(a, id, K_BUSY)
    if i == NONE { return false }
    return (*w8_of(st(a), i)).on
}

fn timepicker(a: *mut app.App, name: str, wpt: usize, h: i64, m: i64, step: i64, h24: bool,
    on_change: fn(*mut app.App, usize)) -> usize {
    let node: usize = w8_make(a, K_TIMEP, wpt, 36, true, name, a11y.ROLE_GENERIC, on_change)
    if node == NONE {
        return NONE
    }
    let c: *mut Ctl = st(a)
    let i: usize = find(c, node)
    (*w8_of(c, i)).tp = wave8.tp_new(h, m, step, h24)
    w8_sync(c, i)
    return node
}

fn timepicker_hour(a: *mut app.App, id: usize) -> i64 {
    let i: usize = w8_idx(a, id, K_TIMEP)
    if i == NONE { return 0 }
    return (*w8_of(st(a), i)).tp.h
}

fn timepicker_minute(a: *mut app.App, id: usize) -> i64 {
    let i: usize = w8_idx(a, id, K_TIMEP)
    if i == NONE { return 0 }
    return (*w8_of(st(a), i)).tp.m
}

// program side: does not call `changed`
fn set_time(a: *mut app.App, id: usize, h: i64, m: i64) {
    let i: usize = w8_idx(a, id, K_TIMEP)
    if i == NONE { return }
    let c: *mut Ctl = st(a)
    wave8.tp_set(&(*w8_of(c, i)).tp, h, m)
    w8_sync(c, i)
    touch(c)
}

fn breadcrumb(a: *mut app.App, name: str, wpt: usize, on_change: fn(*mut app.App, usize)) -> usize {
    return w8_make(a, K_CRUMB, wpt, 32, true, name, a11y.ROLE_GROUP, on_change)
}

fn breadcrumb_add(a: *mut app.App, id: usize, label: str) -> bool {
    let i: usize = w8_idx(a, id, K_CRUMB)
    if i == NONE { return false }
    let c: *mut Ctl = st(a)
    let ok: bool = wave8.crumbs_add(&(*w8_of(c, i)).cr, label)
    w8_sync(c, i)
    touch(c)
    return ok
}

// program side: drop every crumb (rebuild the path with breadcrumb_add)
fn breadcrumb_clear(a: *mut app.App, id: usize) {
    let i: usize = w8_idx(a, id, K_CRUMB)
    if i == NONE { return }
    let c: *mut Ctl = st(a)
    (*w8_of(c, i)).cr = wave8.crumbs_new()
    (*w8_of(c, i)).foc = NO8
    w8_sync(c, i)
    touch(c)
}

// the crumb the user clicked / activated last: its index or BREADCRUMB_OVERFLOW
fn breadcrumb_event(a: *mut app.App, id: usize) -> usize {
    let i: usize = w8_idx(a, id, K_CRUMB)
    if i == NONE { return NONE }
    return (*w8_of(st(a), i)).ev
}

fn infobar(a: *mut app.App, severity: u32, title: str, message: str, wpt: usize,
    on_change: fn(*mut app.App, usize)) -> usize {
    var role: u32 = a11y.ROLE_STATUS
    if severity == wave8.IB_ERROR {
        role = a11y.ROLE_ALERTDIALOG
    }
    let node: usize = w8_make(a, K_INFOB, wpt, 48, true, title, role, on_change)
    if node == NONE {
        return NONE
    }
    let c: *mut Ctl = st(a)
    let i: usize = find(c, node)
    (*w8_of(c, i)).ib = wave8.infobar_new(severity, title, message)
    w8_sync(c, i)
    return node
}

fn infobar_action(a: *mut app.App, id: usize, label: str) {
    let i: usize = w8_idx(a, id, K_INFOB)
    if i == NONE { return }
    let c: *mut Ctl = st(a)
    (*w8_of(c, i)).ib.action = label
    w8_sync(c, i)
    touch(c)
}

fn infobar_closable(a: *mut app.App, id: usize, on: bool) {
    let i: usize = w8_idx(a, id, K_INFOB)
    if i == NONE { return }
    (*w8_of(st(a), i)).ib.closable = on
    touch(st(a))
}

// the part the user used last: wave8.IB_PART_ACTION or IB_PART_CLOSE (the bar hides itself on close)
fn infobar_event(a: *mut app.App, id: usize) -> u32 {
    let i: usize = w8_idx(a, id, K_INFOB)
    if i == NONE { return 0 as u32 }
    return (*w8_of(st(a), i)).ev as u32
}

fn infobar_open(a: *mut app.App, id: usize) -> bool {
    let i: usize = w8_idx(a, id, K_INFOB)
    if i == NONE { return false }
    return (*w8_of(st(a), i)).on
}

// program side: show or hide the bar (a hidden bar gives back its role and name)
fn infobar_show(a: *mut app.App, id: usize, on: bool) {
    let i: usize = w8_idx(a, id, K_INFOB)
    if i == NONE { return }
    let c: *mut Ctl = st(a)
    let w: *mut W8 = w8_of(c, i)
    (*w).on = on
    scene.node_set_hidden(sc_of(c), id, !on)
    let ax: *mut a11y.A11y = app.ax(a)
    if on {
        a11y.a11y_set_role(ax, id, (*w).role)
        name_node(c, id, (*w).name)
    } else {
        a11y.a11y_set_role(ax, id, a11y.ROLE_GENERIC)
        a11y.a11y_set_name(ax, id, 0, 0)
    }
    w8_sync(c, i)
    touch(c)
}

fn stepper(a: *mut app.App, name: str, wpt: usize, on_change: fn(*mut app.App, usize)) -> usize {
    return w8_make(a, K_STEPPER, wpt, 56, true, name, a11y.ROLE_GROUP, on_change)
}

fn stepper_add(a: *mut app.App, id: usize, label: str) -> bool {
    let i: usize = w8_idx(a, id, K_STEPPER)
    if i == NONE { return false }
    let c: *mut Ctl = st(a)
    let ok: bool = wave8.steps_add(&(*w8_of(c, i)).sp, label)
    w8_sync(c, i)
    touch(c)
    return ok
}

fn stepper_current(a: *mut app.App, id: usize) -> usize {
    let i: usize = w8_idx(a, id, K_STEPPER)
    if i == NONE { return NONE }
    return (*w8_of(st(a), i)).cur
}

// program side: the active step and the furthest step the user may click to (a linear wizard: current + 1)
fn stepper_set(a: *mut app.App, id: usize, current: usize, max_reach: usize) {
    let i: usize = w8_idx(a, id, K_STEPPER)
    if i == NONE { return }
    let c: *mut Ctl = st(a)
    let w: *mut W8 = w8_of(c, i)
    if current < (*w).sp.n {
        (*w).cur = current
    }
    (*w).reach = max_reach
    if (*w).reach < (*w).cur {
        (*w).reach = (*w).cur
    }
    w8_sync(c, i)
    touch(c)
}

fn w8_busy_on(c: *mut Ctl, i: usize) -> bool {
    return (*c).kind[i] == K_BUSY && (*w8_of(c, i)).on && motion_of(c) > 0 && !app.app_reduced_motion((*c).a)
    && !scene.node_hidden(sc_of(c), (*c).node[i])
}

// the effective focus part of a crumb bar / info bar
fn w8_cr_focus(w: *mut W8) -> usize {
    if (*w).foc != NO8 {
        return (*w).foc
    }
    if (*w).cr.n == 0 {
        return wave8.BC_NONE
    }
    return (*w).cr.n - 1
}

fn w8_ib_parts(w: *mut W8, out: *mut [u32; 2]) -> usize {
    var n: usize = 0
    if (*w).ib.action.n > 0 {
        (*out)[n] = wave8.IB_PART_ACTION
        n = n + 1
    }
    if (*w).ib.closable {
        (*out)[n] = wave8.IB_PART_CLOSE
        n = n + 1
    }
    return n
}

fn w8_ib_focus(w: *mut W8) -> u32 {
    var ps: [u32; 2] = [0 as u32; 2]
    let n: usize = w8_ib_parts(w, &ps)
    if n == 0 {
        return wave8.IB_PART_NONE
    }
    if (*w).foc != NO8 {
        var k: usize = 0
        while k < n {
            if ps[k] == (*w).foc as u32 {
                return ps[k]
            }
            k = k + 1
        }
    }
    return ps[0]
}

fn w8_draw(ud: u64, rc: *mut render.Ctx, e: *mut widget.Widget) {
    let c: *mut Ctl = ud as *mut Ctl
    var i: usize = 0
    while i < (*c).n {
        if is_w8_kind((*c).kind[i]) && wid(c, i) == e {
            break
        }
        i = i + 1
    }
    if i >= (*c).n {
        return
    }
    let w: *mut W8 = w8_of(c, i)
    let k: u32 = (*c).kind[i]
    let x: f64 = widget.w_x(e)
    let y: f64 = widget.w_y(e)
    let wd: f64 = widget.w_w(e)
    let h: f64 = widget.w_h(e)
    let focused: bool = app.focus((*c).a) == (*c).node[i]
    if k == K_BUSY {
        if !(*w).on {
            return
        }
        var d: f64 = wave8.spinner_size(rc)
        if d > h { d = h }
        if d > wd { d = wd }
        var t: i64 = fuiwirt.host_now(app.app_host((*c).a))
        if motion_of(c) == 0 || app.app_reduced_motion((*c).a) {
            t = 0 - 1
        }
        wave8.spinner_draw(rc, x + (wd - d) / 2.0, y + (h - d) / 2.0, d, t, kit.tokc(rc, style.TOK_TEXT))
    } else if k == K_TIMEP {
        var hv: usize = wave8.TP_NONE
        if (*w).hov != NO8 { hv = (*w).hov }
        wave8.tp_draw(rc, &(*w).tp, x, y + w8_top(h, wave8.tp_height(rc)), hv, focused, !widget.w_is_disabled(e))
    } else if k == K_CRUMB {
        var fp: usize = wave8.BC_NONE
        if focused { fp = w8_cr_focus(w) }
        wave8.bc_draw(rc, &(*w).cr, x, y + w8_top(h, wave8.bc_height(rc)), wd, (*w).hov, fp)
    } else if k == K_INFOB {
        if !(*w).on {
            return
        }
        var hp: u32 = wave8.IB_PART_NONE
        if (*w).hov != NO8 { hp = (*w).hov as u32 }
        var fp2: u32 = wave8.IB_PART_NONE
        if focused { fp2 = w8_ib_focus(w) }
        wave8.ib_draw(rc, &(*w).ib, x, y + w8_top(h, wave8.ib_height(rc)), wd, hp, fp2)
    } else if k == K_STEPPER {
        var hs: usize = wave8.STEP_NONE
        if (*w).hov != NO8 { hs = (*w).hov }
        var fs: usize = wave8.STEP_NONE
        if focused { fs = (*w).cur }
        wave8.stepper_draw(rc, &(*w).sp, (*w).cur, x, y + w8_top(h, wave8.stepper_height(rc)), wd, hs, fs)
    }
}

// the part of entry `i` under (x, y), as a W8 hover value
fn w8_hit(c: *mut Ctl, i: usize, x: f64, y: f64) -> usize {
    let w: *mut W8 = w8_of(c, i)
    let rc: *mut render.Ctx = app.app_ctx((*c).a)
    let sc: *mut scene.Scene = sc_of(c)
    let nd: usize = (*c).node[i]
    let nx: f64 = scene.node_x(sc, nd)
    let nw: f64 = scene.node_w(sc, nd)
    let nh: f64 = scene.node_h(sc, nd)
    let ny: f64 = scene.node_y(sc, nd)
    let k: u32 = (*c).kind[i]
    if k == K_TIMEP {
        let f: usize = wave8.tp_hit(rc, &(*w).tp, nx, ny + w8_top(nh, wave8.tp_height(rc)), x, y)
        if f == wave8.TP_NONE { return NO8 }
        return f
    }
    if k == K_CRUMB {
        return wave8.bc_hit(rc, &(*w).cr, nx, ny + w8_top(nh, wave8.bc_height(rc)), nw, x, y)
    }
    if k == K_INFOB {
        if !(*w).on { return NO8 }
        let p: u32 = wave8.ib_hit(rc, &(*w).ib, nx, ny + w8_top(nh, wave8.ib_height(rc)), nw, x, y)
        if p == wave8.IB_PART_NONE { return NO8 }
        return p as usize
    }
    if k == K_STEPPER {
        let s: usize = wave8.stepper_hit(rc, &(*w).sp, nx, ny + w8_top(nh, wave8.stepper_height(rc)), nw, x, y)
        if s == wave8.STEP_NONE { return NO8 }
        return s
    }
    return NO8
}

fn w8_clear_hover(c: *mut Ctl, keep: usize) -> bool {
    var ch: bool = false
    var i: usize = 0
    while i < (*c).n {
        if is_w8_kind((*c).kind[i]) && i != keep {
            let w: *mut W8 = w8_of(c, i)
            if (*w).hov != NO8 {
                (*w).hov = NO8
                ch = true
            }
        }
        i = i + 1
    }
    return ch
}

// pointer events for the wave 8 nodes; true = repaint
fn w8_ptr(c: *mut Ctl, kind: u32, x: f64, y: f64) -> bool {
    if kind == fuiwirt.HOOK_LEAVE {
        return w8_clear_hover(c, NONE)
    }
    let sc: *mut scene.Scene = sc_of(c)
    var node: usize = scene.scene_hit(sc, x, y)
    var i: usize = NONE
    if node != NONE && node < scene.scene_count(sc) {
        i = find(c, node)
    }
    if i != NONE && !is_w8_kind((*c).kind[i]) {
        i = NONE
    }
    var ch: bool = w8_clear_hover(c, i)
    if i == NONE {
        return ch
    }
    let w: *mut W8 = w8_of(c, i)
    let hv: usize = w8_hit(c, i, x, y)
    if hv != (*w).hov {
        (*w).hov = hv
        ch = true
    }
    if kind != fuiwirt.HOOK_DOWN || hv == NO8 {
        return ch
    }
    let k: u32 = (*c).kind[i]
    if k == K_TIMEP {
        wave8.tp_focus(&(*w).tp, hv)
    } else if k == K_CRUMB {
        (*w).ev = hv
        (*w).foc = hv
        fire(c, i)
    } else if k == K_INFOB {
        (*w).foc = hv
        w8_ib_use(c, i, hv as u32)
    } else if k == K_STEPPER {
        if hv < (*w).sp.n && hv <= (*w).reach && hv != (*w).cur {
            (*w).cur = hv
            w8_sync(c, i)
            fire(c, i)
        }
    }
    touch(c)
    return true
}

// the action / close part of an info bar used (by click or key)
fn w8_ib_use(c: *mut Ctl, i: usize, part: u32) {
    let w: *mut W8 = w8_of(c, i)
    if part == wave8.IB_PART_ACTION && (*w).ib.action.n > 0 {
        (*w).ev = wave8.IB_PART_ACTION as usize
        fire(c, i)
    } else if part == wave8.IB_PART_CLOSE && (*w).ib.closable {
        (*w).ev = wave8.IB_PART_CLOSE as usize
        let ax: *mut a11y.A11y = app.ax((*c).a)
        (*w).on = false
        (*w).foc = NO8
        scene.node_set_hidden(sc_of(c), (*c).node[i], true)
        a11y.a11y_set_role(ax, (*c).node[i], a11y.ROLE_GENERIC)
        a11y.a11y_set_name(ax, (*c).node[i], 0, 0)
        w8_sync(c, i)
        fire(c, i)
    }
}

fn w8_key(c: *mut Ctl, i: usize, key: u32) -> bool {
    let w: *mut W8 = w8_of(c, i)
    let k: u32 = (*c).kind[i]
    if k == K_TIMEP {
        let used: bool = key == editor.KEY_LEFT || key == editor.KEY_RIGHT || key == editor.KEY_UP
        || key == editor.KEY_DOWN || key == editor.KEY_HOME || key == editor.KEY_END
        if !used {
            return false
        }
        if wave8.tp_key(&(*w).tp, key) {
            w8_sync(c, i)
            fire(c, i)
        }
        touch(c)
        return true
    }
    if k == K_CRUMB {
        var dir: i64 = 0
        if key == editor.KEY_RIGHT { dir = 1 }
        if key == editor.KEY_LEFT { dir = 0 - 1 }
        if kit.kit_rtl() { dir = 0 - dir }
        if dir == 0 {
            return false
        }
        let rc: *mut render.Ctx = app.app_ctx((*c).a)
        let nw: f64 = scene.node_w(sc_of(c), (*c).node[i])
        let nf: usize = wave8.bc_focus_step(rc, &(*w).cr, nw, w8_cr_focus(w), dir)
        if nf == wave8.BC_NONE || nf == (*w).foc {
            return false
        }
        (*w).foc = nf
        touch(c)
        return true
    }
    if k == K_INFOB {
        if key == editor.KEY_ESC && (*w).ib.closable {
            w8_ib_use(c, i, wave8.IB_PART_CLOSE)
            touch(c)
            return true
        }
        if key != editor.KEY_LEFT && key != editor.KEY_RIGHT {
            return false
        }
        var ps: [u32; 2] = [0 as u32; 2]
        let n: usize = w8_ib_parts(w, &ps)
        if n < 2 {
            return false
        }
        let cur: u32 = w8_ib_focus(w)
        if cur == ps[0] { (*w).foc = ps[1] as usize } else { (*w).foc = ps[0] as usize }
        touch(c)
        return true
    }
    if k == K_STEPPER {
        let ns: usize = wave8.stepper_key((*w).sp.n, (*w).cur, (*w).reach, key)
        if ns == (*w).cur || ns >= (*w).sp.n {
            return false
        }
        (*w).cur = ns
        w8_sync(c, i)
        fire(c, i)
        touch(c)
        return true
    }
    return false
}

// Enter / Space on a crumb or an info bar part
fn w8_act(c: *mut Ctl, i: usize) {
    let w: *mut W8 = w8_of(c, i)
    let k: u32 = (*c).kind[i]
    if k == K_CRUMB {
        let f: usize = w8_cr_focus(w)
        if f == wave8.BC_NONE {
            return
        }
        (*w).ev = f
        fire(c, i)
    } else if k == K_INFOB && (*w).on {
        w8_ib_use(c, i, w8_ib_focus(w))
        touch(c)
    }
}

// typed digits go to the focused time picker
fn w8_chr(c: *mut Ctl, cp: u32, mods: u32) -> bool {
    if cp < 48 as u32 || cp > 57 as u32 || (mods & (editor.MOD_CTRL | editor.MOD_ALT)) != 0 as u32 {
        return false
    }
    let f: usize = app.focus((*c).a)
    if f == NONE {
        return false
    }
    let i: usize = find(c, f)
    if i == NONE || (*c).kind[i] != K_TIMEP {
        return false
    }
    let w: *mut W8 = w8_of(c, i)
    if wave8.tp_digit(&(*w).tp, (cp - 48 as u32) as i64) {
        w8_sync(c, i)
        fire(c, i)
    }
    touch(c)
    return true
}

// the wheel over a time picker: one notch = one step of the field under the pointer
fn w8_wheel(c: *mut Ctl, dy: f64) -> bool {
    let sc: *mut scene.Scene = sc_of(c)
    let node: usize = scene.scene_hit(sc, (*c).px, (*c).py)
    if node == NONE || node >= scene.scene_count(sc) {
        return false
    }
    let i: usize = find(c, node)
    if i == NONE || (*c).kind[i] != K_TIMEP {
        return false
    }
    let f: usize = w8_hit(c, i, (*c).px, (*c).py)
    if f == NO8 || dy == 0.0 {
        return false
    }
    var dir: i64 = 1
    if dy > 0.0 { dir = 0 - 1 }
    let w: *mut W8 = w8_of(c, i)
    (*w).tp.field = f
    if wave8.tp_wheel(&(*w).tp, f, dir) {
        w8_sync(c, i)
        fire(c, i)
    }
    touch(c)
    return true
}

fn w8_tick(c: *mut Ctl, now: i64) -> bool {
    var i: usize = 0
    while i < (*c).n {
        if w8_busy_on(c, i) {
            return true
        }
        i = i + 1
    }
    return false
}

fn w8_busy(c: *mut Ctl) -> bool {
    return w8_tick(c, 0)
}

// ============================================================ COMBOBOX (r146, W29)
//
// An editable combobox: an `app.entry` whose text is the query (lib/fui/wave9.fi has the model, the popup, the
// painting and the accessible side).
//
//     let cb: usize = appctl.combobox(a, "Country", picked)       // the field; `picked(a, node)` after a pick
//     let ok: bool = appctl.combobox_add(a, cb, "Austria")        // items (copied; 512 / 16 KB)
//
// Typing refilters (fuzzy, best first, 64 hits at most, 8 rows show), Down / Up open and walk, Enter takes the
// active row (`picked` fires, the field shows the item), Esc shuts the list, a click on a row takes it. The
// item index of the last pick is `combobox_picked` (NONE = none). The field is an ordinary entry: `app.text`,
// `app.set_text`, `app.on_edit` work as always. Entry: node = the field, aux = the heap Cmb.

fn cmb_of(c: *mut Ctl, i: usize) -> *mut wave9.Cmb {
    return (*c).aux[i] as u64 as *mut wave9.Cmb
}

fn cmb_idx(a: *mut app.App, id: usize) -> usize {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 { return NONE }
    let i: usize = find(c, id)
    if i == NONE || (*c).kind[i] != K_COMBO { return NONE }
    return i
}

fn cmb_any_open(c: *mut Ctl) -> bool {
    var i: usize = 0
    while i < (*c).n {
        if (*c).kind[i] == K_COMBO && wave9.cmb_is_open(cmb_of(c, i)) {
            return true
        }
        i = i + 1
    }
    return false
}

fn cmb_close_all(c: *mut Ctl) {
    var i: usize = 0
    while i < (*c).n {
        if (*c).kind[i] == K_COMBO {
            wave9.cmb_close(cmb_of(c, i))
        }
        i = i + 1
    }
}

// the user changed a text field: a combobox field refilters (and opens its list)
fn ctl_edit(ud: u64, node: usize) {
    let c: *mut Ctl = ud as *mut Ctl
    let i: usize = find(c, node)
    if i == NONE || (*c).kind[i] != K_COMBO {
        return
    }
    let r: bool = wave9.cmb_edit((*c).a, cmb_of(c, i), node)
}

// the combobox with the focus whose list is open (or any combobox with the focus for Down / Up)
fn cmb_focused(c: *mut Ctl) -> usize {
    let f: usize = app.focus((*c).a)
    if f == NONE { return NONE }
    let i: usize = find(c, f)
    if i == NONE || (*c).kind[i] != K_COMBO { return NONE }
    return i
}

fn cmb_key_route(c: *mut Ctl, key: u32, mods: u32) -> bool {
    let i: usize = cmb_focused(c)
    if i == NONE {
        return false
    }
    if (mods & editor.MOD_CTRL) != 0 as u32 || (mods & editor.MOD_ALT) != 0 as u32 {
        return false
    }
    let r: u32 = wave9.cmb_key((*c).a, cmb_of(c, i), (*c).node[i], key, mods)
    if r == wave9.CK_PICK {
        fire(c, i)
    }
    return r != wave9.CK_PASS
}

// the pointer while a list is open; true = the event belongs to the popup
fn cmb_ptr_route(c: *mut Ctl, kind: u32, x: f64, y: f64) -> bool {
    var i: usize = 0
    while i < (*c).n {
        if (*c).kind[i] == K_COMBO && wave9.cmb_is_open(cmb_of(c, i)) {
            let cb: *mut wave9.Cmb = cmb_of(c, i)
            let en: usize = (*c).node[i]
            let hit: bool = wave9.cmb_hit((*c).a, cb, en, (*c).win_h, x, y)
            let r: u32 = wave9.cmb_pointer((*c).a, cb, en, (*c).win_h, kind, x, y, (*c).px, (*c).py)
            if r == wave9.CK_PICK {
                fire(c, i)
                return true
            }
            if r != wave9.CK_PASS && hit {
                return true
            }
        }
        i = i + 1
    }
    return false
}

fn cmb_shield(c: *mut Ctl, x: f64, y: f64) -> bool {
    var i: usize = 0
    while i < (*c).n {
        if (*c).kind[i] == K_COMBO && wave9.cmb_is_open(cmb_of(c, i))
        && wave9.cmb_hit((*c).a, cmb_of(c, i), (*c).node[i], (*c).win_h, x, y) {
            return true
        }
        i = i + 1
    }
    return false
}

// paint: a list loses its focus -> shut; the scene nodes follow; the popup goes above the page
fn cmb_paint(c: *mut Ctl, rc: *mut render.Ctx) {
    let foc: usize = app.focus((*c).a)
    var i: usize = 0
    while i < (*c).n {
        if (*c).kind[i] == K_COMBO {
            let cb: *mut wave9.Cmb = cmb_of(c, i)
            if wave9.cmb_is_open(cb) && foc != (*c).node[i] {
                wave9.cmb_close(cb)
            }
            wave9.cmb_sync((*c).a, cb, (*c).node[i], (*c).win_h)
            if wave9.cmb_is_open(cb) {
                wave9.cmb_draw((*c).a, rc, cb, (*c).node[i], (*c).win_h)
            }
        }
        i = i + 1
    }
}

// An editable combobox; returns the field node (NONE when the entries or controls are used up).
fn combobox(a: *mut app.App, hint: str, on_pick: fn(*mut app.App, usize)) -> usize {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 { return NONE }
    let node: usize = app.entry(a, hint)
    if node == NONE { return NONE }
    let cb: *mut wave9.Cmb = wave9.cmb_new(a, node)
    if cb as u64 == 0 { return NONE }
    let i: usize = add_entry(c, K_COMBO, node)
    if i == NONE { return NONE }
    (*c).aux[i] = cb as u64 as usize
    set_cb(c, i, on_pick)
    return node
}

fn combobox_add(a: *mut app.App, id: usize, text: str) -> bool {
    let i: usize = cmb_idx(a, id)
    if i == NONE { return false }
    return wave9.cmb_add(cmb_of(st(a), i), text)
}

fn combobox_count(a: *mut app.App, id: usize) -> usize {
    let i: usize = cmb_idx(a, id)
    if i == NONE { return 0 }
    return wave9.cmb_item_count(cmb_of(st(a), i))
}

// open the list for the text in the field (all items for an empty field); true = it is open
fn combobox_open(a: *mut app.App, id: usize) -> bool {
    let i: usize = cmb_idx(a, id)
    if i == NONE { return false }
    let c: *mut Ctl = st(a)
    let r: bool = wave9.cmb_open(a, cmb_of(c, i), id)
    touch(c)
    return r
}

fn combobox_close(a: *mut app.App, id: usize) {
    let i: usize = cmb_idx(a, id)
    if i == NONE { return }
    wave9.cmb_close(cmb_of(st(a), i))
    touch(st(a))
}

fn combobox_is_open(a: *mut app.App, id: usize) -> bool {
    let i: usize = cmb_idx(a, id)
    if i == NONE { return false }
    return wave9.cmb_is_open(cmb_of(st(a), i))
}

fn combobox_results(a: *mut app.App, id: usize) -> usize {
    let i: usize = cmb_idx(a, id)
    if i == NONE { return 0 }
    return wave9.cmb_results(cmb_of(st(a), i))
}

// the item index of the last pick, NONE = none
fn combobox_picked(a: *mut app.App, id: usize) -> usize {
    let i: usize = cmb_idx(a, id)
    if i == NONE { return NONE }
    return wave9.cmb_picked(cmb_of(st(a), i))
}

// the active result row, NONE = the typed text
fn combobox_active(a: *mut app.App, id: usize) -> usize {
    let i: usize = cmb_idx(a, id)
    if i == NONE { return NONE }
    return wave9.cmb_active(cmb_of(st(a), i))
}

fn combobox_row_text(a: *mut app.App, id: usize, row: usize) -> str {
    let i: usize = cmb_idx(a, id)
    if i == NONE { return "" }
    return wave9.cmb_row_text(cmb_of(st(a), i), row)
}

// the accessible list node below the field and its row nodes (NONE = no such)
fn combobox_list_node(a: *mut app.App, id: usize) -> usize {
    let i: usize = cmb_idx(a, id)
    if i == NONE { return NONE }
    return wave9.cmb_list_node(cmb_of(st(a), i))
}

fn combobox_item_node(a: *mut app.App, id: usize, r: usize) -> usize {
    let i: usize = cmb_idx(a, id)
    if i == NONE { return NONE }
    return wave9.cmb_item_node(cmb_of(st(a), i), r)
}

// the popup rectangle / of a result row (window pixels); false = closed or not shown
fn combobox_rect(a: *mut app.App, id: usize, out: *mut [f64; 4]) -> bool {
    let i: usize = cmb_idx(a, id)
    if i == NONE { return false }
    let c: *mut Ctl = st(a)
    return wave9.cmb_rect(a, cmb_of(c, i), id, (*c).win_h, out)
}

fn combobox_row_rect(a: *mut app.App, id: usize, row: usize, out: *mut [f64; 4]) -> bool {
    let i: usize = cmb_idx(a, id)
    if i == NONE { return false }
    let c: *mut Ctl = st(a)
    return wave9.cmb_row_rect(a, cmb_of(c, i), id, (*c).win_h, row, out)
}

// the first result row that shows (the list scrolls)
fn combobox_top(a: *mut app.App, id: usize) -> usize {
    let i: usize = cmb_idx(a, id)
    if i == NONE { return 0 }
    return wave9.cmb_top(cmb_of(st(a), i))
}

// ============================================================ SIZE CLASS (r148, W29)
//
// The window's width and height classes in dp (compact < 600 <= medium < 900 <= expanded, with a hysteresis so a
// window dragged around a limit does not flicker; lib/fui/sizeclass.fi). Fed on every paint from the real window
// size and the scale; the program asks and may react once per change:
//
//     appctl.on_size_class(a, relayout)              // relayout(a, width_class) after the class changed
//     if appctl.size_class(a) == sizeclass.SC_COMPACT { ... bottom bar ... }
//     let cols: usize = appctl.size_columns(a, 240, 16, 4)    // columns of >= 240 dp with 16 dp gaps, at most 4
//
// Before the first paint the window counts as 0 dp wide (compact).

fn sz_cb_none(a: *mut app.App, c: u32) {
}

fn sz_of(c: *mut Ctl) -> *mut wave9.Sz {
    if (*c).sz == 0 {
        (*c).sz = wave9.sz_new() as u64
    }
    return (*c).sz as *mut wave9.Sz
}

fn sz_paint(c: *mut Ctl, rc: *mut render.Ctx, w: usize, h: usize) {
    let z: *mut wave9.Sz = sz_of(c)
    if z as u64 == 0 {
        return
    }
    var scale: f64 = kit.ln(rc, 1000) / 1000.0
    if scale < 0.25 {
        scale = 1.0
    }
    if wave9.sz_feed(z, w as f64, h as f64, scale) && (*c).sz_has {
        let f: fn(*mut app.App, u32) = (*c).sz_cb
        f((*c).a, wave9.sz_class_w(z))
    }
}

// the width class: sizeclass.SC_COMPACT / SC_MEDIUM / SC_EXPANDED
fn size_class(a: *mut app.App) -> u32 {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 { return 0 as u32 }
    let z: *mut wave9.Sz = sz_of(c)
    if z as u64 == 0 { return 0 as u32 }
    return wave9.sz_class_w(z)
}

fn height_class(a: *mut app.App) -> u32 {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 { return 0 as u32 }
    let z: *mut wave9.Sz = sz_of(c)
    if z as u64 == 0 { return 0 as u32 }
    return wave9.sz_class_h(z)
}

// the navigation that fits the width: sizeclass.NAV_BOTTOM / NAV_RAIL / NAV_SIDEBAR
fn nav_mode(a: *mut app.App) -> u32 {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 { return 0 as u32 }
    let z: *mut wave9.Sz = sz_of(c)
    if z as u64 == 0 { return 0 as u32 }
    return wave9.sz_nav(z)
}

// the window width in dp as of the last paint
fn size_dp_width(a: *mut app.App) -> i64 {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 { return 0 }
    let z: *mut wave9.Sz = sz_of(c)
    if z as u64 == 0 { return 0 }
    return wave9.sz_dp_w(z)
}

// how many columns of at least `min_col` dp fit (gap dp between them, at most `max_cols`; at least 1)
fn size_columns(a: *mut app.App, min_col: i64, gap: i64, max_cols: usize) -> usize {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 { return 1 }
    let z: *mut wave9.Sz = sz_of(c)
    if z as u64 == 0 { return 1 }
    return wave9.sz_columns(z, min_col, gap, max_cols)
}

// how often the class changed since the start (width or height)
fn size_changes(a: *mut app.App) -> usize {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 { return 0 }
    let z: *mut wave9.Sz = sz_of(c)
    if z as u64 == 0 { return 0 }
    return wave9.sz_changes(z)
}

// `f(a, width_class)` after the width OR height class changed (during a paint)
fn on_size_class(a: *mut app.App, f: fn(*mut app.App, u32)) {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 { return }
    (*c).sz_cb = f
    (*c).sz_has = true
}

// ============================================================ DRAG AND DROP (r144, W29)
//
// Sources and targets are nodes; a virtual list (app.vlist_new) is a source of ROWS and a target with a drop
// slot. lib/fui/wave10.fi has the model, the hit tests, the marker, the ghost and the keyboard way.
//
//     appctl.dnd_source(a, list_a, dnd.KIND_ROW, dnd.OP_MOVE | dnd.OP_COPY)    // rows of list_a can be dragged
//     appctl.dnd_target(a, list_b, dnd.KIND_ROW, dnd.OP_MOVE | dnd.OP_COPY, false)   // ... and dropped on list_b
//     appctl.dnd_on_drop(a, dropped)                                        // dropped(a, target_node)
//     // in `dropped`: appctl.dnd_effect(a), dnd_from(a), dnd_from_row(a), dnd_gap(a) say what happened
//
// The drag starts after 4 px (10 px touch). Ctrl moves to copy, Shift to move, Alt to link where the target
// allows it. Ctrl+Space on a focused source grabs it, Up / Down walk the drop gaps, Enter drops, Esc cancels.

fn dd_of(c: *mut Ctl) -> *mut wave10.Dd {
    if (*c).dd == 0 {
        (*c).dd = wave10.dd_new() as u64
    }
    return (*c).dd as *mut wave10.Dd
}

fn dd_running(c: *mut Ctl) -> bool {
    return (*c).dd != 0 && wave10.dd_busy((*c).dd as *mut wave10.Dd)
}

fn dd_stop(c: *mut Ctl) {
    if (*c).dd != 0 {
        wave10.dd_cancel((*c).dd as *mut wave10.Dd)
    }
}

fn dd_wants_timer(c: *mut Ctl) -> bool {
    return (*c).dd != 0 && wave10.dd_edge_active((*c).dd as *mut wave10.Dd)
}

fn dd_tick_c(c: *mut Ctl) -> bool {
    if (*c).dd == 0 {
        return false
    }
    return wave10.dd_tick((*c).a, (*c).dd as *mut wave10.Dd)
}

// the pointer: true = the event belongs to a running drag (nothing else hears it)
fn dd_ptr_route(c: *mut Ctl, kind: u32, x: f64, y: f64) -> bool {
    if (*c).dd == 0 {
        return false
    }
    return wave10.dd_pointer((*c).a, (*c).dd as *mut wave10.Dd, kind, x, y)
}

fn dd_key_route(c: *mut Ctl, key: u32, mods: u32) -> bool {
    if (*c).dd == 0 {
        return false
    }
    return wave10.dd_key((*c).a, (*c).dd as *mut wave10.Dd, key, mods) != 0 as u32
}

// Ctrl+Space grabs the focused source; while a keyboard drag runs, characters are swallowed
fn dd_chr_route(c: *mut Ctl, cp: u32, mods: u32) -> bool {
    if (*c).dd == 0 {
        return false
    }
    let dd: *mut wave10.Dd = (*c).dd as *mut wave10.Dd
    if wave10.dd_keyboard(dd) {
        return true
    }
    return wave10.dd_char((*c).a, dd, app.focus((*c).a), cp, mods)
}

fn dd_paint(c: *mut Ctl, rc: *mut render.Ctx, w: usize, h: usize) {
    if (*c).dd == 0 {
        return
    }
    wave10.dd_draw((*c).a, rc, (*c).dd as *mut wave10.Dd, w as f64, h as f64)
}

// `node` can be dragged (a list: its rows). kind = dnd.KIND_*, ops = dnd.OP_* bits it allows. false = 8 are taken.
fn dnd_source(a: *mut app.App, node: usize, kind: u32, ops: u32) -> bool {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 { return false }
    let dd: *mut wave10.Dd = dd_of(c)
    if dd as u64 == 0 { return false }
    return wave10.dd_source(dd, node, kind, ops)
}

// `node` takes drops of the kinds (dnd.KIND bits) with the ops it allows; `tree` = a drop may land ON a row.
fn dnd_target(a: *mut app.App, node: usize, kinds: u32, ops: u32, tree: bool) -> bool {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 { return false }
    let dd: *mut wave10.Dd = dd_of(c)
    if dd as u64 == 0 { return false }
    return wave10.dd_target(dd, node, kinds, ops, tree)
}

fn dnd_on_start(a: *mut app.App, f: fn(*mut app.App, usize)) {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 { return }
    let dd: *mut wave10.Dd = dd_of(c)
    if dd as u64 != 0 { wave10.dd_on_start(dd, f) }
}

// `f(a, target_node)` after a drop that was accepted (read what happened with dnd_effect / dnd_from / ...)
fn dnd_on_drop(a: *mut app.App, f: fn(*mut app.App, usize)) {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 { return }
    let dd: *mut wave10.Dd = dd_of(c)
    if dd as u64 != 0 { wave10.dd_on_drop(dd, f) }
}

// the text of the ghost at the pointer (47 bytes at most)
fn dnd_ghost(a: *mut app.App, text: str) {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 { return }
    let dd: *mut wave10.Dd = dd_of(c)
    if dd as u64 != 0 { wave10.dd_set_ghost(dd, text) }
}

fn dnd_busy(a: *mut app.App) -> bool {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 { return false }
    return dd_running(c)
}

fn dnd_cancel(a: *mut app.App) {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 { return }
    dd_stop(c)
    touch(c)
}

fn dnd_keyboard(a: *mut app.App) -> bool {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 || (*c).dd == 0 { return false }
    return wave10.dd_keyboard((*c).dd as *mut wave10.Dd)
}

// the last finished drag (valid in `on_drop` and after): effect dnd.OP_*, source node and row (NONE = a plain
// node), target node, drop gap 0..n between the target's rows, zone dnd.SLOT_*, the row under the pointer
fn dnd_effect(a: *mut app.App) -> u32 {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 || (*c).dd == 0 { return dnd.OP_NONE }
    return wave10.dd_r_effect((*c).dd as *mut wave10.Dd)
}

fn dnd_from(a: *mut app.App) -> usize {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 || (*c).dd == 0 { return NONE }
    return wave10.dd_r_source((*c).dd as *mut wave10.Dd)
}

fn dnd_from_row(a: *mut app.App) -> usize {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 || (*c).dd == 0 { return NONE }
    return wave10.dd_r_row((*c).dd as *mut wave10.Dd)
}

fn dnd_to(a: *mut app.App) -> usize {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 || (*c).dd == 0 { return NONE }
    return wave10.dd_r_target((*c).dd as *mut wave10.Dd)
}

fn dnd_gap(a: *mut app.App) -> i64 {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 || (*c).dd == 0 { return 0 }
    return wave10.dd_r_gap((*c).dd as *mut wave10.Dd)
}

fn dnd_zone(a: *mut app.App) -> u32 {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 || (*c).dd == 0 { return dnd.SLOT_ON }
    return wave10.dd_r_zone((*c).dd as *mut wave10.Dd)
}

fn dnd_to_row(a: *mut app.App) -> usize {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 || (*c).dd == 0 { return NONE }
    return wave10.dd_r_trow((*c).dd as *mut wave10.Dd)
}

// accepted drops since the start
fn dnd_drops(a: *mut app.App) -> usize {
    let c: *mut Ctl = st(a)
    if c as u64 == 0 || (*c).dd == 0 { return 0 }
    return wave10.dd_drops((*c).dd as *mut wave10.Dd)
}

// ============================================================ GRID (r334)
//
// `grid(a, "1fr 120 auto", "auto auto")` opens a GRID container (like
// app.row / app.column: the widgets after it sit in its cells, until
// app.end). Tracks are words split by blanks:
//   "120"       fixed, design points
//   "auto"      as big as the content
//   "1fr"       a share of the rest (also "2fr", "1.5fr")
//   "100-1fr"   at least 100 points, then a share (minmax(100px, 1fr))
// A child without grid_cell is placed automatically, row by row; extra rows
// get the size "auto". At most 16 explicit tracks per axis (grid.fi).

fn gr_digit(b: u8) -> bool {
    return b >= (48 as u8) && b <= (57 as u8)
}

fn gr_at(s: str, i: usize) -> u8 {
    return *((s.p as u64 + i as u64) as *mut u8)
}

// One track word from s[a..e); false = not understood.
fn gr_track(s: str, a: usize, e: usize, out: *mut grid.Track) -> bool {
    let w: str = str { p: (s.p as u64 + a as u64) as *mut u8, n: e - a }
    if w.n == 4 && *((w.p as u64) as *mut u8) == (97 as u8) {
        // "auto"
        if *((w.p as u64 + 1) as *mut u8) == (117 as u8) && *((w.p as u64 + 2) as *mut u8) == (116 as u8)
        && *((w.p as u64 + 3) as *mut u8) == (111 as u8) {
            *out = grid.tk_auto()
            return true
        }
        return false
    }
    // number [. digits] [fr] [- number [. digits] fr]
    var i: usize = 0
    var whole: i64 = 0
    var nd: usize = 0
    while i < w.n && gr_digit(*((w.p as u64 + i as u64) as *mut u8)) {
        whole = whole * 10 + (gr_at(w, i) as i64 - 48)
        i = i + 1
        nd = nd + 1
    }
    if nd == 0 {
        return false
    }
    var frac: i64 = 0
    var scale: i64 = 1000
    if i < w.n && *((w.p as u64 + i as u64) as *mut u8) == (46 as u8) {
        i = i + 1
        var fd: usize = 0
        scale = 100
        while i < w.n && gr_digit(*((w.p as u64 + i as u64) as *mut u8)) {
            if fd < 3 {
                frac = frac + (gr_at(w, i) as i64 - 48) * scale
                scale = scale / 10
            }
            fd = fd + 1
            i = i + 1
        }
        if fd == 0 {
            return false
        }
    }
    let is_fr: bool = i + 2 == w.n && *((w.p as u64 + i as u64) as *mut u8) == (102 as u8)
    && *((w.p as u64 + i as u64 + 1) as *mut u8) == (114 as u8)
    if is_fr {
        *out = grid.tk_fr(whole * 1000 + frac)
        return true
    }
    if i == w.n {
        if frac != 0 {
            return false
        }
        *out = grid.tk_px(whole)
        return true
    }
    // "min-<f>fr"
    if *((w.p as u64 + i as u64) as *mut u8) == (45 as u8) && frac == 0 {
        let rest: str = str { p: (w.p as u64 + i as u64 + 1) as *mut u8, n: w.n - i - 1 }
        var t2: grid.Track = grid.tk_auto()
        if gr_track(rest, 0, rest.n, &t2) && t2.max_k == grid.TK_FR {
            *out = grid.tk_minfr(whole, t2.max_v)
            return true
        }
    }
    return false
}

// Add the tracks of `spec` to node g (axis 0 columns, 1 rows). Returns how many were added.
fn gr_tracks(a: *mut app.App, g: usize, spec: str, axis: usize) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < spec.n {
        while i < spec.n && *((spec.p as u64 + i as u64) as *mut u8) == (32 as u8) {
            i = i + 1
        }
        let s0: usize = i
        while i < spec.n && *((spec.p as u64 + i as u64) as *mut u8) != (32 as u8) {
            i = i + 1
        }
        if i > s0 {
            var t: grid.Track = grid.tk_auto()
            if !gr_track(spec, s0, i, &t) {
                t = grid.tk_auto()
            }
            var ok: bool = false
            if axis == 0 {
                ok = scene.node_grid_col(app.app_scene(a), g, t)
            } else {
                ok = scene.node_grid_row(app.app_scene(a), g, t)
            }
            if ok {
                n = n + 1
            }
        }
    }
    return n
}

// Open a grid. NONE if the window is full. Close it with app.end(a).
fn grid(a: *mut app.App, cols: str, rows: str) -> usize {
    let g: usize = app.grid_box(a)
    if g == NONE {
        return NONE
    }
    gr_tracks(a, g, cols, 0)
    gr_tracks(a, g, rows, 1)
    a11y.a11y_set_role(app.ax(a), g, a11y.ROLE_GROUP)
    touch(st(a))
    return g
}

// The cell of a child: column/row 0-based (-1 = automatic), spans >= 1.
fn grid_cell(a: *mut app.App, child: usize, col: i64, row: i64, cspan: i64, rspan: i64) {
    scene.node_set_cell(app.app_scene(a), child, col, row, cspan, rspan)
    touch(st(a))
}

// Space between columns (x) and rows (y), design points.
fn grid_gap(a: *mut app.App, g: usize, x: i64, y: i64) {
    scene.node_grid_gap(app.app_scene(a), g, x, y)
    touch(st(a))
}

fn grid_pad(a: *mut app.App, g: usize, l: i64, t: i64, r: i64, b: i64) {
    scene.node_grid_padding(app.app_scene(a), g, l, t, r, b)
    touch(st(a))
}

// Right-to-left: column 0 on the right.
fn grid_rtl(a: *mut app.App, g: usize, rtl: bool) {
    scene.node_grid_rtl(app.app_scene(a), g, rtl)
    touch(st(a))
}

// The name a screen reader says for the group.
fn grid_name(a: *mut app.App, g: usize, name: str) {
    if name.n > 0 {
        a11y.a11y_set_name(app.ax(a), g, name.p as u64, name.n)
    }
}
