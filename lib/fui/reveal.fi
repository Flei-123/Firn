import fui.anim
import fui.ds_tokens_motion
import fui.ds_tokens_prim

export {
    Reveal, reveal_new, reveal_set, reveal_snap, reveal_value, reveal_busy, reveal_target,
    reveal_visible, reveal_settled, reveal_enable, reveal_is_enabled, reveal_time_scale, reveal_lerp,
}

struct Reveal {
    target: bool,
    from: f64,
    t0: f64,
    ms: f64,
    ease: usize,
}

static mut ON: bool = true
static mut SCALE: f64 = 1.0

fn reveal_enable(on: bool) { ON = on }

fn reveal_is_enabled() -> bool { return ON }

fn reveal_time_scale(k: f64) {
    if k >= 1.0 { SCALE = k }
}

fn reveal_lerp(a: f64, b: f64, t: f64) -> f64 { return a + (b - a) * t }

fn reveal_new() -> Reveal {
    return Reveal { target: false, from: 0.0, t0: 0.0, ms: 1.0, ease: ds_tokens_prim.EASE_LINEAR }
}

fn goal(r: *mut Reveal) -> f64 {
    if (*r).target { return 1.0 }
    return 0.0
}


fn reveal_value(r: *mut Reveal, now: f64) -> f64 {
    if (*r).t0 <= 0.0 || now <= 0.0 { return goal(r) }
    var p: f64 = (now - (*r).t0) / ((*r).ms * SCALE)
    if p >= 1.0 { return goal(r) }
    if p < 0.0 { p = 0.0 }
    let s: ds_tokens_motion.MotionSpec = ds_tokens_motion.spec((*r).ease)
    let b: ds_tokens_prim.Bezier = ds_tokens_prim.ease_curve(s.ease)
    var e: anim.Easing = anim.easing_bezier(b.x1 as f64 / 1000.0, b.y1 as f64 / 1000.0, b.x2 as f64 / 1000.0, b.y2 as f64 / 1000.0)
    return reveal_lerp((*r).from, goal(r), anim.ease_eval(&e, p))
}

fn reveal_snap(r: *mut Reveal, open: bool) {
    (*r).target = open
    (*r).t0 = 0.0
    (*r).from = goal(r)
}

fn reveal_set(r: *mut Reveal, open: bool, now: f64, open_role: usize, close_role: usize) {
    if open == (*r).target { return }
    var role: usize = close_role
    if open { role = open_role }
    let s: ds_tokens_motion.MotionSpec = ds_tokens_motion.spec(role)
    if !ON || now <= 0.0 || s.ms == 0 {
        reveal_snap(r, open)
        return
    }
    (*r).from = reveal_value(r, now)
    (*r).target = open
    (*r).t0 = now
    (*r).ms = s.ms as f64
    (*r).ease = role
}

fn reveal_busy(r: *mut Reveal, now: f64) -> bool {
    if (*r).t0 <= 0.0 || now <= 0.0 { return false }
    return now - (*r).t0 < (*r).ms * SCALE + 20.0
}

fn reveal_target(r: *mut Reveal) -> bool { return (*r).target }

fn reveal_settled(r: *mut Reveal, now: f64) -> bool { return !reveal_busy(r, now) }

fn reveal_visible(r: *mut Reveal, now: f64) -> bool {
    return (*r).target || reveal_busy(r, now)
}
