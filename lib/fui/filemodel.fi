// SPDX-License-Identifier: MPL-2.0
// lib/fui/filemodel.fi -- THE DIRECTORY MODEL OF THE FILE DIALOG (lib/fui/filedlg.fi).
//
// No drawing and no window here: only what a file chooser has to KNOW.
//
//   * a directory read into a table (name, size, time, kind, link state),
//     read in ONE pass; a folder that cannot be read leaves the old table
//     untouched (the dialog stays where it was),
//   * the VIEW of it: hidden files out, a filter ("*.png;*.jpg", exact
//     names, any case) applied, folders first, sorted by name, size or
//     time, ascending or descending,
//   * the text work around it: lexical path normalising, "~", relative
//     names, the file filter string of lib/std/dialog.fi ("Label|pat;pat|
//     Label2|pat"), the default extension of a filter, sizes and dates
//     as text, a case-insensitive prefix search.
//
// Paths use "/" only. Windows drives are not part of this module.
//
// THE TABLE LIVES ON THE HEAP in pieces that grow: the names in one rt.Buf
// (an entry keeps offset and length into it), the entries in one block, the
// view in one block of u32 indices. 5000 entries cost ~400 KiB.
import std.rt
import std.fs
import std.dir
import std.time

export {
    Entry, Model, model_init, model_free, model_open, model_rebuild,
    model_set_hidden, model_set_dirs_only, model_set_filters, model_set_filter_index,
    model_set_sort, model_sort_col, model_sort_desc, model_show_hidden,
    model_path, model_total, model_count, model_ent, model_view_ent, model_name,
    model_find_name, model_find_prefix, model_view_of_ent, model_clear_sel,
    model_sel_count, model_set_offset,
    ERR_NONE, ERR_NOT_FOUND, ERR_DENIED, ERR_NOT_DIR, ERR_OTHER,
    SORT_NAME, SORT_SIZE, SORT_DATE,
    IC_FILE, IC_FOLDER, IC_IMAGE, IC_TEXT, IC_ARCHIVE, IC_LINK, IC_FOLDER_LINK,
    NONE,
    path_normalize, path_resolve, path_is_abs, path_parent_len, path_split,
    push_str, str_eq, str_eq_ci, glob_match, filters_count, filter_label, filter_pats,
    default_ext, fmt_size, fmt_date, has_dot_in_name, last_slash, ext_icon,
    errno_text, buf_str, lower8,
}

const NONE: usize = 4294967295

const ERR_NONE: i32 = 0
const ERR_NOT_FOUND: i32 = 1
const ERR_DENIED: i32 = 2
const ERR_NOT_DIR: i32 = 3
const ERR_OTHER: i32 = 4

const SORT_NAME: i32 = 0
const SORT_SIZE: i32 = 1
const SORT_DATE: i32 = 2

const IC_FILE: i32 = 0
const IC_FOLDER: i32 = 1
const IC_IMAGE: i32 = 2
const IC_TEXT: i32 = 3
const IC_ARCHIVE: i32 = 4
const IC_LINK: i32 = 5
const IC_FOLDER_LINK: i32 = 6

struct Entry {
    off: usize,
    len: usize,
    size: u64,
    mtime: i64,
    dir: bool,
    link: bool,
    broken: bool,
    hid: bool,
    sel: bool,
    icon: i32,
}

struct Model {
    path: rt.Buf,
    names: rt.Buf,
    ents: u64,
    n: usize,
    cap: usize,
    esz: usize,
    view: u64,
    tmp: u64,
    nv: usize,
    sort_col: i32,
    sort_desc: bool,
    show_hidden: bool,
    dirs_only: bool,
    filters: rt.Buf,
    filter_idx: usize,
    off_min: i32,
}

fn buf_str(b: *mut rt.Buf) -> str {
    return str { p: rt.buf_data(b), n: rt.buf_len(b) }
}

fn push_str(b: *mut rt.Buf, s: str) {
    if s.n > 0 {
        rt.buf_push_bytes(b, s.p as u64, s.n)
    }
}

fn str_eq(a: str, b: str) -> bool {
    if a.n != b.n {
        return false
    }
    var i: usize = 0
    while i < a.n {
        if rt.ld8(a.p as u64, i) != rt.ld8(b.p as u64, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn lower8(c: u8) -> u8 {
    if c >= (65 as u8) && c <= (90 as u8) {
        return c + (32 as u8)
    }
    return c
}

fn str_eq_ci(a: str, b: str) -> bool {
    if a.n != b.n {
        return false
    }
    var i: usize = 0
    while i < a.n {
        if lower8(rt.ld8(a.p as u64, i)) != lower8(rt.ld8(b.p as u64, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

fn sub(s: str, at: usize, n: usize) -> str {
    return str { p: ((s.p as u64) + at as u64) as *mut u8, n: n }
}

// ============================================================ MODEL

fn size_t[T]() -> usize {
    return size_of[T]()
}

fn entry_size() -> usize {
    return size_t[Entry]()
}

fn model_init(m: *mut Model) {
    (*m).path = rt.buf_new()
    (*m).names = rt.buf_new()
    (*m).ents = 0
    (*m).n = 0
    (*m).cap = 0
    (*m).esz = entry_size()
    (*m).view = 0
    (*m).tmp = 0
    (*m).nv = 0
    (*m).sort_col = SORT_NAME
    (*m).sort_desc = false
    (*m).show_hidden = false
    (*m).dirs_only = false
    (*m).filters = rt.buf_new()
    (*m).filter_idx = 0
    (*m).off_min = 0
    rt.buf_push(&(*m).path, 47 as u8)
}

fn model_free(m: *mut Model) {
    rt.buf_free(&(*m).path)
    rt.buf_free(&(*m).names)
    rt.buf_free(&(*m).filters)
    if (*m).ents != 0 {
        rt.heap_free((*m).ents, (*m).cap * (*m).esz)
    }
    if (*m).view != 0 {
        rt.heap_free((*m).view, (*m).cap * 4)
        rt.heap_free((*m).tmp, (*m).cap * 4)
    }
    (*m).ents = 0
    (*m).view = 0
    (*m).tmp = 0
    (*m).cap = 0
    (*m).n = 0
    (*m).nv = 0
}

// The local UTC offset in minutes the dates are shown in (0 = UTC).
fn model_set_offset(m: *mut Model, minutes: i32) {
    (*m).off_min = minutes
}

fn model_path(m: *mut Model) -> str {
    return buf_str(&(*m).path)
}

fn model_total(m: *mut Model) -> usize { return (*m).n }
fn model_count(m: *mut Model) -> usize { return (*m).nv }
fn model_show_hidden(m: *mut Model) -> bool { return (*m).show_hidden }
fn model_sort_col(m: *mut Model) -> i32 { return (*m).sort_col }
fn model_sort_desc(m: *mut Model) -> bool { return (*m).sort_desc }

fn model_ent(m: *mut Model, i: usize) -> *mut Entry {
    return ((*m).ents + (i * (*m).esz) as u64) as *mut Entry
}

// The entry index shown at view position `k`.
fn model_view_ent(m: *mut Model, k: usize) -> usize {
    return rt.ld32((*m).view, k) as usize
}

fn model_view_of_ent(m: *mut Model, ei: usize) -> usize {
    var k: usize = 0
    while k < (*m).nv {
        if model_view_ent(m, k) == ei {
            return k
        }
        k = k + 1
    }
    return NONE
}

fn model_name(m: *mut Model, e: *mut Entry) -> str {
    return str { p: ((rt.buf_data(&(*m).names) as u64) + (*e).off as u64) as *mut u8, n: (*e).len }
}

fn model_clear_sel(m: *mut Model) {
    var i: usize = 0
    while i < (*m).n {
        (*model_ent(m, i)).sel = false
        i = i + 1
    }
}

fn model_sel_count(m: *mut Model) -> usize {
    var c: usize = 0
    var k: usize = 0
    while k < (*m).nv {
        if (*model_ent(m, model_view_ent(m, k))).sel {
            c = c + 1
        }
        k = k + 1
    }
    return c
}

fn grow(m: *mut Model, want: usize) -> bool {
    if want <= (*m).cap {
        return true
    }
    var nc: usize = (*m).cap * 2
    if nc < 256 {
        nc = 256
    }
    while nc < want {
        nc = nc * 2
    }
    let ne: u64 = rt.heap_alloc(nc * (*m).esz)
    let nv: u64 = rt.heap_alloc(nc * 4)
    let nt: u64 = rt.heap_alloc(nc * 4)
    if ne == 0 || nv == 0 || nt == 0 {
        if ne != 0 { rt.heap_free(ne, nc * (*m).esz) }
        if nv != 0 { rt.heap_free(nv, nc * 4) }
        if nt != 0 { rt.heap_free(nt, nc * 4) }
        return false
    }
    if (*m).n > 0 {
        rt.mem_copy(ne, (*m).ents, (*m).n * (*m).esz)
    }
    if (*m).nv > 0 {
        rt.mem_copy(nv, (*m).view, (*m).nv * 4)
    }
    if (*m).ents != 0 {
        rt.heap_free((*m).ents, (*m).cap * (*m).esz)
        rt.heap_free((*m).view, (*m).cap * 4)
        rt.heap_free((*m).tmp, (*m).cap * 4)
    }
    (*m).ents = ne
    (*m).view = nv
    (*m).tmp = nt
    (*m).cap = nc
    return true
}

// ============================================================ TEXT HELPERS

fn path_is_abs(s: str) -> bool {
    return s.n > 0 && rt.ld8(s.p as u64, 0) == (47 as u8)
}

// The index of the last "/" in `s`, NONE when there is none.
fn last_slash(s: str) -> usize {
    var i: usize = s.n
    while i > 0 {
        if rt.ld8(s.p as u64, i - 1) == (47 as u8) {
            return i - 1
        }
        i = i - 1
    }
    return NONE
}

// Does the base name (after the last "/") contain a "."?
fn has_dot_in_name(s: str) -> bool {
    var i: usize = s.n
    while i > 0 {
        let c: u8 = rt.ld8(s.p as u64, i - 1)
        if c == (47 as u8) {
            return false
        }
        if c == (46 as u8) {
            return true
        }
        i = i - 1
    }
    return false
}

// The absolute path `in` made canonical: "//" -> "/", "." dropped, ".." folded
// away (lexically, symbolic links are not looked at), no trailing "/" except
// for the root. Appends to `out`.
fn path_normalize(inp: str, out: *mut rt.Buf) {
    let start: usize = rt.buf_len(out)
    var i: usize = 0
    // the parts already written, as the lengths of `out` before each "/name"
    var marks: [usize; 128] = [0; 128]
    var depth: usize = 0
    while i < inp.n {
        while i < inp.n && rt.ld8(inp.p as u64, i) == (47 as u8) {
            i = i + 1
        }
        var j: usize = i
        while j < inp.n && rt.ld8(inp.p as u64, j) != (47 as u8) {
            j = j + 1
        }
        let l: usize = j - i
        if l == 0 {
            break
        }
        let part: str = sub(inp, i, l)
        if l == 1 && rt.ld8(part.p as u64, 0) == (46 as u8) {
            // "."
        } else if l == 2 && rt.ld8(part.p as u64, 0) == (46 as u8) && rt.ld8(part.p as u64, 1) == (46 as u8) {
            if depth > 0 {
                depth = depth - 1
                rt.buf_set_len(out, marks[depth])
            }
        } else {
            if depth < 128 {
                marks[depth] = rt.buf_len(out)
                depth = depth + 1
            }
            rt.buf_push(out, 47 as u8)
            rt.buf_push_bytes(out, part.p as u64, part.n)
        }
        i = j
    }
    if rt.buf_len(out) == start {
        rt.buf_push(out, 47 as u8)
    }
}

// What a user typed -> the absolute canonical path: "~" and "~/x" are the home
// directory, an absolute path stays, anything else is relative to `cwd`.
fn path_resolve(cwd: str, home: str, inp: str, out: *mut rt.Buf) {
    var tmp: rt.Buf = rt.buf_new()
    if inp.n > 0 && rt.ld8(inp.p as u64, 0) == (126 as u8)
    && (inp.n == 1 || rt.ld8(inp.p as u64, 1) == (47 as u8)) {
        push_str(&tmp, home)
        rt.buf_push(&tmp, 47 as u8)
        push_str(&tmp, sub(inp, 1, inp.n - 1))
    } else if path_is_abs(inp) {
        push_str(&tmp, inp)
    } else {
        push_str(&tmp, cwd)
        rt.buf_push(&tmp, 47 as u8)
        push_str(&tmp, inp)
    }
    path_normalize(buf_str(&tmp), out)
    rt.buf_free(&tmp)
}

// The length of the parent of the canonical path `p` ("/a/b" -> 2 = "/a"; "/a"
// -> 1 = "/"; "/" -> 1).
fn path_parent_len(p: str) -> usize {
    let s: usize = last_slash(p)
    if s == NONE || s == 0 {
        return 1
    }
    return s
}

// The k-th part of a canonical path: its start and end offsets in `p`
// ("/usr/lib" -> 0: 1..4 "usr", 1: 5..8 "lib"). false past the last part.
fn path_split(p: str, k: usize, start: *mut usize, end: *mut usize) -> bool {
    var i: usize = 0
    var idx: usize = 0
    while i < p.n {
        while i < p.n && rt.ld8(p.p as u64, i) == (47 as u8) {
            i = i + 1
        }
        if i >= p.n {
            return false
        }
        var j: usize = i
        while j < p.n && rt.ld8(p.p as u64, j) != (47 as u8) {
            j = j + 1
        }
        if idx == k {
            *start = i
            *end = j
            return true
        }
        idx = idx + 1
        i = j
    }
    return false
}

// ---------------------------------------------------------------- globbing

// Does `name` match `pat`? "*" any run, "?" any one byte; ASCII case does not
// matter. A pattern without those is an exact name.
fn glob_match(name: str, pat: str) -> bool {
    var ni: usize = 0
    var pi: usize = 0
    var star: usize = NONE
    var mark: usize = 0
    while ni < name.n {
        var pc: u8 = 0 as u8
        if pi < pat.n {
            pc = lower8(rt.ld8(pat.p as u64, pi))
        }
        let nc: u8 = lower8(rt.ld8(name.p as u64, ni))
        if pi < pat.n && pc == (42 as u8) {
            star = pi
            mark = ni
            pi = pi + 1
        } else if pi < pat.n && (pc == (63 as u8) || pc == nc) {
            pi = pi + 1
            ni = ni + 1
        } else if star != NONE {
            pi = star + 1
            mark = mark + 1
            ni = mark
        } else {
            return false
        }
    }
    while pi < pat.n && rt.ld8(pat.p as u64, pi) == (42 as u8) {
        pi = pi + 1
    }
    return pi == pat.n
}

// Is `name` one of the patterns of `pats` ("*.png;*.jpg")?
fn pats_match(name: str, pats: str) -> bool {
    if pats.n == 0 {
        return true
    }
    var s: usize = 0
    var i: usize = 0
    while i <= pats.n {
        if i == pats.n || rt.ld8(pats.p as u64, i) == (59 as u8) {
            let p: str = sub(pats, s, i - s)
            if p.n > 0 && glob_match(name, p) {
                return true
            }
            s = i + 1
        }
        i = i + 1
    }
    return false
}

// ---------------------------------------------------------------- the filter string
//
// "Label|pat;pat|Label2|pat". Segments come in pairs; a lone last segment is a
// label with the pattern "*".

fn seg(filters: str, k: usize, start: *mut usize, len: *mut usize) -> bool {
    var s: usize = 0
    var idx: usize = 0
    var i: usize = 0
    while i <= filters.n {
        if i == filters.n || rt.ld8(filters.p as u64, i) == (124 as u8) {
            if idx == k {
                *start = s
                *len = i - s
                return true
            }
            idx = idx + 1
            s = i + 1
        }
        i = i + 1
    }
    return false
}

fn filters_count(filters: str) -> usize {
    if filters.n == 0 {
        return 0
    }
    var c: usize = 1
    var i: usize = 0
    while i < filters.n {
        if rt.ld8(filters.p as u64, i) == (124 as u8) {
            c = c + 1
        }
        i = i + 1
    }
    return (c + 1) / 2
}

fn filter_label(filters: str, k: usize) -> str {
    var s: usize = 0
    var l: usize = 0
    if filters.n > 0 && seg(filters, k * 2, &s, &l) {
        return sub(filters, s, l)
    }
    return ""
}

fn filter_pats(filters: str, k: usize) -> str {
    var s: usize = 0
    var l: usize = 0
    if filters.n > 0 && seg(filters, k * 2 + 1, &s, &l) {
        return sub(filters, s, l)
    }
    return "*"
}

// "*.png" alone -> ".png"; anything with more than one pattern, a wildcard
// inside the extension or no extension at all -> "".
fn default_ext(pats: str) -> str {
    if pats.n < 3 || rt.ld8(pats.p as u64, 0) != (42 as u8) || rt.ld8(pats.p as u64, 1) != (46 as u8) {
        return ""
    }
    var i: usize = 2
    while i < pats.n {
        let c: u8 = rt.ld8(pats.p as u64, i)
        if c == (59 as u8) || c == (42 as u8) || c == (63 as u8) || c == (46 as u8) {
            return ""
        }
        i = i + 1
    }
    return sub(pats, 1, pats.n - 1)
}

// ---------------------------------------------------------------- sizes and dates

// 1234 -> "1.2 kB", 5 -> "5 B", 3 MB -> "3.0 MB" (decimal units, as the file
// managers of GNOME and macOS show them).
fn fmt_size(size: u64, out: *mut rt.Buf) {
    if size < 1000 {
        rt.buf_push_dec_u64(out, size)
        push_str(out, " B")
        return
    }
    var unit: str = " kB"
    var div: u64 = 1000
    if size >= 1000000000 {
        unit = " GB"
        div = 1000000000
    } else if size >= 1000000 {
        unit = " MB"
        div = 1000000
    }
    let whole: u64 = size / div
    var tenth: u64 = (size % div) * 10 / div
    if whole >= 100 {
        rt.buf_push_dec_u64(out, whole)
    } else {
        rt.buf_push_dec_u64(out, whole)
        rt.buf_push(out, 46 as u8)
        rt.buf_push_dec_u64(out, tenth)
    }
    push_str(out, unit)
}

fn two(out: *mut rt.Buf, v: u32) {
    rt.buf_push(out, (48 + (v / 10) % 10) as u8)
    rt.buf_push(out, (48 + v % 10) as u8)
}

// "2026-10-09 07:49" in the model's offset.
fn fmt_date(m: *mut Model, mtime_ns: i64, out: *mut rt.Buf) {
    let ms: i64 = mtime_ns / 1000000 + (*m).off_min as i64 * 60000
    let t: time.DateTime = time.civil_from_unix(ms)
    rt.buf_push_dec_i64(out, t.year as i64)
    rt.buf_push(out, 45 as u8)
    two(out, t.month)
    rt.buf_push(out, 45 as u8)
    two(out, t.day)
    rt.buf_push(out, 32 as u8)
    two(out, t.hour)
    rt.buf_push(out, 58 as u8)
    two(out, t.minute)
}

// The icon class of a file by its extension.
fn ext_icon(name: str) -> i32 {
    var dot: usize = NONE
    var i: usize = name.n
    while i > 0 {
        if rt.ld8(name.p as u64, i - 1) == (46 as u8) {
            dot = i - 1
            break
        }
        i = i - 1
    }
    if dot == NONE || dot == 0 {
        return IC_FILE
    }
    let e: str = sub(name, dot + 1, name.n - dot - 1)
    if e.n > 5 || e.n == 0 {
        return IC_FILE
    }
    if ext_in(e, "png jpg jpeg gif bmp webp svg ico tif tiff avif heic") {
        return IC_IMAGE
    }
    if ext_in(e, "txt md rst log csv json xml html htm css js ts fi rs c h cpp py sh toml yaml yml ini cfg conf tex") {
        return IC_TEXT
    }
    if ext_in(e, "zip tar gz tgz bz2 xz zst 7z rar iso deb rpm jar") {
        return IC_ARCHIVE
    }
    return IC_FILE
}

fn ext_in(e: str, list: str) -> bool {
    var s: usize = 0
    var i: usize = 0
    while i <= list.n {
        if i == list.n || rt.ld8(list.p as u64, i) == (32 as u8) {
            if str_eq_ci(e, sub(list, s, i - s)) {
                return true
            }
            s = i + 1
        }
        i = i + 1
    }
    return false
}

fn errno_text(code: i32) -> str {
    if code == ERR_NOT_FOUND { return "No such folder" }
    if code == ERR_DENIED { return "Permission denied" }
    if code == ERR_NOT_DIR { return "Not a folder" }
    if code == ERR_OTHER { return "Cannot read the folder" }
    return ""
}

// ============================================================ LOADING

fn add_entry(m: *mut Model, name: str, size: u64, mtime: i64, isdir: bool, link: bool,
    broken: bool) -> bool {
    if !grow(m, (*m).n + 1) {
        return false
    }
    let e: *mut Entry = model_ent(m, (*m).n)
    (*e).off = rt.buf_len(&(*m).names)
    (*e).len = name.n
    rt.buf_push_bytes(&(*m).names, name.p as u64, name.n)
    (*e).size = size
    (*e).mtime = mtime
    (*e).dir = isdir
    (*e).link = link
    (*e).broken = broken
    (*e).hid = name.n > 0 && rt.ld8(name.p as u64, 0) == (46 as u8)
    (*e).sel = false
    var ic: i32 = IC_FILE
    if isdir {
        ic = IC_FOLDER
        if link { ic = IC_FOLDER_LINK }
    } else if broken {
        ic = IC_LINK
    } else if link {
        ic = IC_LINK
    } else {
        ic = ext_icon(name)
    }
    (*e).icon = ic
    (*m).n = (*m).n + 1
    return true
}

// Read the directory `path` (canonical, absolute) into the table. Returns
// ERR_NONE and replaces the table, or an error and leaves everything as it was.
#[allow_escape]
fn model_open(m: *mut Model, path: str) -> i32 {
    let info: fs.FileInfo = fs.stat(path) catch fs.FileInfo { kind: 255 as u8, mode: 0 as u32, size: 0, mtime_ns: 0 }
    if info.kind == (255 as u8) {
        let en: i64 = fs.last_errno()
        if en == 13 || en == 1 {
            return ERR_DENIED
        }
        if en == 20 {
            return ERR_NOT_DIR
        }
        return ERR_NOT_FOUND
    }
    if info.kind != fs.KIND_DIR {
        return ERR_NOT_DIR
    }
    var d: dir.Dir = dir.open(path)
    if !dir.is_open(&d) {
        let code: i64 = 0 - d.fd
        dir.close(&d)
        if code == 13 || code == 1 {
            return ERR_DENIED
        }
        if code == 2 {
            return ERR_NOT_FOUND
        }
        return ERR_OTHER
    }
    // start the new table
    rt.buf_clear(&(*m).names)
    (*m).n = 0
    (*m).nv = 0
    rt.buf_clear(&(*m).path)
    push_str(&(*m).path, path)
    var full: rt.Buf = rt.buf_new()
    while dir.next(&d) {
        let nm: str = d.name
        if nm.n == 0 {
            continue
        }
        rt.buf_clear(&full)
        push_str(&full, path)
        if !(path.n == 1 && rt.ld8(path.p as u64, 0) == (47 as u8)) {
            rt.buf_push(&full, 47 as u8)
        }
        push_str(&full, nm)
        var link: bool = d.kind == dir.KIND_LINK
        var isdir: bool = d.kind == dir.KIND_DIR
        var broken: bool = false
        var size: u64 = 0
        var mt: i64 = 0
        let fp: str = buf_str(&full)
        // a link, or a file system that gives no type: ask (stat follows links)
        if d.kind == dir.KIND_LINK || d.kind == dir.KIND_UNKNOWN || d.kind == dir.KIND_FILE || d.kind == dir.KIND_DIR {
            let st: fs.FileInfo = fs.stat(fp) catch fs.FileInfo { kind: 255 as u8, mode: 0 as u32, size: 0, mtime_ns: 0 }
            if st.kind == (255 as u8) {
                if link {
                    broken = true
                }
            } else {
                isdir = st.kind == fs.KIND_DIR
                size = st.size
                mt = st.mtime_ns
            }
        }
        let ok: bool = add_entry(m, nm, size, mt, isdir, link, broken)
        if !ok {
            break
        }
    }
    dir.close(&d)
    rt.buf_free(&full)
    model_rebuild(m)
    return ERR_NONE
}

// ============================================================ VIEW

fn model_set_hidden(m: *mut Model, on: bool) { (*m).show_hidden = on }
fn model_set_dirs_only(m: *mut Model, on: bool) { (*m).dirs_only = on }

fn model_set_filters(m: *mut Model, filters: str) {
    rt.buf_clear(&(*m).filters)
    push_str(&(*m).filters, filters)
    (*m).filter_idx = 0
}

fn model_set_filter_index(m: *mut Model, k: usize) {
    (*m).filter_idx = k
}

fn model_set_sort(m: *mut Model, col: i32, desc: bool) {
    (*m).sort_col = col
    (*m).sort_desc = desc
}

// -1 / 0 / 1: entry `a` before, equal to, after entry `b`. Folders first,
// always; then the sort column; the name settles ties (case-insensitive first,
// then bytewise, so the order is total).
fn cmp_names(m: *mut Model, a: *mut Entry, b: *mut Entry) -> i32 {
    let na: str = model_name(m, a)
    let nb: str = model_name(m, b)
    var i: usize = 0
    while i < na.n && i < nb.n {
        let ca: u8 = lower8(rt.ld8(na.p as u64, i))
        let cb: u8 = lower8(rt.ld8(nb.p as u64, i))
        if ca != cb {
            if ca < cb { return 0 - 1 }
            return 1
        }
        i = i + 1
    }
    if na.n != nb.n {
        if na.n < nb.n { return 0 - 1 }
        return 1
    }
    i = 0
    while i < na.n {
        let ca: u8 = rt.ld8(na.p as u64, i)
        let cb: u8 = rt.ld8(nb.p as u64, i)
        if ca != cb {
            if ca < cb { return 0 - 1 }
            return 1
        }
        i = i + 1
    }
    return 0
}

fn cmp_view(m: *mut Model, ia: usize, ib: usize) -> i32 {
    let a: *mut Entry = model_ent(m, ia)
    let b: *mut Entry = model_ent(m, ib)
    if (*a).dir != (*b).dir {
        if (*a).dir { return 0 - 1 }
        return 1
    }
    var c: i32 = 0
    if (*m).sort_col == SORT_SIZE && !(*a).dir {
        if (*a).size < (*b).size { c = 0 - 1 }
        if (*a).size > (*b).size { c = 1 }
    } else if (*m).sort_col == SORT_DATE {
        if (*a).mtime < (*b).mtime { c = 0 - 1 }
        if (*a).mtime > (*b).mtime { c = 1 }
    }
    if c != 0 {
        if (*m).sort_desc { return 0 - c }
        return c
    }
    let n: i32 = cmp_names(m, a, b)
    // folders sorted by size/date fall back to the name; a descending name
    // sort reverses the names only
    if (*m).sort_col == SORT_NAME && (*m).sort_desc { return 0 - n }
    return n
}

// Bottom-up merge sort of view[0..n) with the scratch block.
fn sort_view(m: *mut Model) {
    let n: usize = (*m).nv
    var width: usize = 1
    var src: u64 = (*m).view
    var dst: u64 = (*m).tmp
    while width < n {
        var lo: usize = 0
        while lo < n {
            var mid: usize = lo + width
            if mid > n { mid = n }
            var hi: usize = lo + 2 * width
            if hi > n { hi = n }
            var i: usize = lo
            var j: usize = mid
            var k: usize = lo
            while i < mid && j < hi {
                let ea: usize = rt.ld32(src, i) as usize
                let eb: usize = rt.ld32(src, j) as usize
                if cmp_view(m, eb, ea) < 0 {
                    rt.st32(dst, k, eb as u32)
                    j = j + 1
                } else {
                    rt.st32(dst, k, ea as u32)
                    i = i + 1
                }
                k = k + 1
            }
            while i < mid {
                rt.st32(dst, k, rt.ld32(src, i))
                i = i + 1
                k = k + 1
            }
            while j < hi {
                rt.st32(dst, k, rt.ld32(src, j))
                j = j + 1
                k = k + 1
            }
            lo = lo + 2 * width
        }
        let t: u64 = src
        src = dst
        dst = t
        width = width * 2
    }
    if src != (*m).view {
        rt.mem_copy((*m).view, src, n * 4)
    }
}

// Filter + sort the table into the view. Selection flags stay with the entries.
fn model_rebuild(m: *mut Model) {
    (*m).nv = 0
    var pats: str = "*"
    let fs_: str = buf_str(&(*m).filters)
    if filters_count(fs_) > 0 {
        pats = filter_pats(fs_, (*m).filter_idx)
    }
    var i: usize = 0
    while i < (*m).n {
        let e: *mut Entry = model_ent(m, i)
        var keep: bool = true
        if (*e).hid && !(*m).show_hidden {
            keep = false
        }
        if keep && (*m).dirs_only && !(*e).dir {
            keep = false
        }
        if keep && !(*e).dir && !pats_match(model_name(m, e), pats) {
            keep = false
        }
        if keep {
            rt.st32((*m).view, (*m).nv, i as u32)
            (*m).nv = (*m).nv + 1
        } else {
            (*e).sel = false
        }
        i = i + 1
    }
    sort_view(m)
}

// The view position of the entry named `name` (exact), NONE if not shown.
fn model_find_name(m: *mut Model, name: str) -> usize {
    var k: usize = 0
    while k < (*m).nv {
        if str_eq(model_name(m, model_ent(m, model_view_ent(m, k))), name) {
            return k
        }
        k = k + 1
    }
    return NONE
}

// The first view position at or after `from` (wrapping round once) whose name
// starts with `prefix`, case-insensitive. NONE if none.
fn model_find_prefix(m: *mut Model, prefix: str, from: usize) -> usize {
    if prefix.n == 0 || (*m).nv == 0 {
        return NONE
    }
    var t: usize = 0
    while t < (*m).nv {
        var k: usize = from + t
        if k >= (*m).nv { k = k - (*m).nv }
        let nm: str = model_name(m, model_ent(m, model_view_ent(m, k)))
        if nm.n >= prefix.n && str_eq_ci(sub(nm, 0, prefix.n), prefix) {
            return k
        }
        t = t + 1
    }
    return NONE
}
