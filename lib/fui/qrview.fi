// SPDX-License-Identifier: MPL-2.0
// lib/fui/qrview.fi -- the QR code as a fUi widget.
//
//     var q: qr.QrCode = qr.qr_new()
//     qr.qr_encode_text("https://example.org", qr.QR_ECC_M, &q) catch ...
//     qrview.qrview_draw(c, &q, x, y, 240.0, 4, qrview.BLACK, qrview.WHITE)
//
// Immediate mode like the rest of the kit: every frame the program calls
// `qrview_draw` with the code it keeps (lib/qr/qr.fi). The code is drawn in the
// biggest WHOLE number of device pixels per module that fits the square given
// (so every module edge falls on a pixel and a camera sees no grey seams), centred
// in the square; the quiet zone is painted in the light colour. Horizontal runs
// of dark modules are one rectangle, so a version 40 code is ~2000 rectangles,
// not 31,000. If the square is smaller than one pixel per module the modules are
// fractional (the code is then not readable; `qrview_min_side` says what it
// needs).
//
// COLOURS. A scanner needs dark on light on BOTH themes; the defaults are black
// on white with a 4-module quiet zone, not theme tokens. A program that wants
// its own pair passes it, and `qrview_contrast_ok` checks the pair has the
// 3:1 the standard's reflectance rule comes to in practice.
//
// ACCESSIBILITY. A code is not readable by a screen reader; the program offers
// the text it carries (`qrview_alt` builds "QR code, N characters" for the a11y
// name) or a copy button next to it.
//
// HONEST NOTES
//   * No logo in the middle, no rounded modules, no gradient: all of that costs
//     error correction and the code is checked with a real reader only plain.
//   * The pixel size of a module is an integer in device pixels: the code never
//     fills the square exactly (up to one module's worth of space on every
//     side).
import std.rt
import std.math
import fui.painter
import fui.render
import qr.qr

export {
    qrview_draw, qrview_min_side, qrview_module_px, qrview_contrast_ok, qrview_alt,
    qrview_rect,
    BLACK, WHITE,
}

// opaque in the painter's colour format (0xAARRGGBB, alpha 255)
const BLACK: u32 = 4278190080
const WHITE: u32 = 4294967295

// The smallest square (device pixels) that gives every module one pixel, with
// a quiet zone of `quiet` modules.
fn qrview_min_side(q: *mut qr.QrCode, quiet: i64) -> f64 {
    return ((qr.qr_size(q) as i64) + 2 * quiet) as f64
}

// Device pixels per module that fit into a square of `side` (0 if none).
fn qrview_module_px(q: *mut qr.QrCode, side: f64, quiet: i64) -> i64 {
    let total: i64 = (qr.qr_size(q) as i64) + 2 * quiet
    if total <= 0 {
        return 0
    }
    return (side as i64) / total
}

// The rectangle the symbol itself (without the quiet zone) covers: x, y, w, h
// in `out`. For hit tests and for placing a caption.
fn qrview_rect(q: *mut qr.QrCode, x: f64, y: f64, side: f64, quiet: i64, out: *mut [f64; 4]) {
    let total: i64 = (qr.qr_size(q) as i64) + 2 * quiet
    var m: f64 = side / (total as f64)
    let px: i64 = qrview_module_px(q, side, quiet)
    if px >= 1 {
        m = px as f64
    }
    let whole: f64 = m * (total as f64)
    let ox: f64 = x + (side - whole) / 2.0
    let oy: f64 = y + (side - whole) / 2.0
    (*out)[0] = ox + m * (quiet as f64)
    (*out)[1] = oy + m * (quiet as f64)
    (*out)[2] = m * (qr.qr_size(q) as f64)
    (*out)[3] = m * (qr.qr_size(q) as f64)
}

// Paints the code (and its quiet zone) into the square (x, y, side, side).
fn qrview_draw(c: *mut render.Ctx, q: *mut qr.QrCode, x: f64, y: f64, side: f64,
        quiet: i64, dark: u32, light: u32) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let n: i64 = qr.qr_size(q) as i64
    if n == 0 {
        return
    }
    let total: i64 = n + 2 * quiet
    var m: f64 = side / (total as f64)
    let px: i64 = qrview_module_px(q, side, quiet)
    if px >= 1 {
        m = px as f64
    }
    let whole: f64 = m * (total as f64)
    let ox: f64 = x + (side - whole) / 2.0
    let oy: f64 = y + (side - whole) / 2.0
    painter.surface(z, ox, oy, whole, whole, light)
    var row: i64 = 0
    while row < n {
        var col: i64 = 0
        while col < n {
            if qr.qr_dark(q, col, row) {
                var run: i64 = 1
                while col + run < n && qr.qr_dark(q, col + run, row) {
                    run = run + 1
                }
                painter.surface(z, ox + m * ((col + quiet) as f64), oy + m * ((row + quiet) as f64),
                    m * (run as f64), m, dark)
                col = col + run
            } else {
                col = col + 1
            }
        }
        row = row + 1
    }
}

fn lum_chan(v: u32) -> f64 {
    let s: f64 = (v as f64) / 255.0
    if s <= 0.04045 {
        return s / 12.92
    }
    return math.powf((s + 0.055) / 1.055, 2.4)
}

fn lum(col: u32) -> f64 {
    return 0.2126 * lum_chan((col >> 16) & 255 as u32) + 0.7152 * lum_chan((col >> 8) & 255 as u32)
        + 0.0722 * lum_chan(col & 255 as u32)
}

// Dark darker than light, with a WCAG 2 contrast ratio of at least 3:1.
fn qrview_contrast_ok(dark: u32, light: u32) -> bool {
    let a: f64 = lum(dark)
    let b: f64 = lum(light)
    if a >= b {
        return false
    }
    return (b + 0.05) / (a + 0.05) >= 3.0
}

// "QR code, 23 characters" for the accessible name, into `out` (room for 64);
// its length.
fn qrview_alt(n_chars: usize, out: *mut [u8; 64]) -> usize {
    var k: usize = 0
    var i: usize = 0
    let a: str = "QR code, "
    while i < a.n {
        (*out)[k] = rt.ld8(a.p as u64, i)
        k = k + 1
        i = i + 1
    }
    var tmp: [u8; 24] = [0 as u8; 24]
    var t: usize = 0
    var v: usize = n_chars
    if v == 0 {
        tmp[0] = 48 as u8
        t = 1
    }
    while v > 0 {
        tmp[t] = (48 + v % 10) as u8
        t = t + 1
        v = v / 10
    }
    while t > 0 {
        t = t - 1
        (*out)[k] = tmp[t]
        k = k + 1
    }
    let b: str = " characters"
    i = 0
    while i < b.n {
        (*out)[k] = rt.ld8(b.p as u64, i)
        k = k + 1
        i = i + 1
    }
    return k
}
