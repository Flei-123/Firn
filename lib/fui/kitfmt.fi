// lib/fui/kitfmt.fi -- SMALL STRING BUILDERS FOR APP SCREENS: numbers with separators, decimals, signs, upper case, joins.
//
// Every function returns a str that lives in a ring of 24 buffers of 96 bytes: use the result at once (draw it), do not keep it.
//
//   uint(v, sep)         12345 -> "12,345" (sep) or "12345"
//   dec(v, places)       3.84 -> "3.8" (places 1), negative values get "-"
//   signed(v, places)    "+12.4" / "-2.3"
//   upper(s)             ASCII upper case
//   leading_uint(s)      "30d" -> 30 (digits at the start)
//   join(a, b)           a + b          join3(a, b, c)   a + b + c
//   slice(s, from, n)    n bytes of s from `from` (cut to the string)
import std.rt

export { uint, dec, signed, upper, join, join3, slice, leading_uint }

const SLOTS: usize = 24
const CAP: usize = 96

static mut RING: u64 = 0
static mut AT: usize = 0

fn next_slot() -> u64 {
    if RING == 0 { RING = rt.heap_alloc(SLOTS * CAP) }
    let base: u64 = RING + (AT * CAP) as u64
    AT = (AT + 1) % SLOTS
    return base
}

fn put_str(base: u64, n: usize, s: str) -> usize {
    var k: usize = n
    var i: usize = 0
    while i < s.n && k < CAP {
        *((base + k as u64) as *mut u8) = *((s.p as u64 + i as u64) as *mut u8)
        k = k + 1
        i = i + 1
    }
    return k
}

fn put_uint(base: u64, n: usize, v: u64, sep: bool, min_digits: usize) -> usize {
    var tmp: [u8; 24] = [0 as u8; 24]
    var m: usize = 0
    var x: u64 = v
    while x > 0 || m < min_digits {
        tmp[m] = (48 + (x % 10)) as u8
        m = m + 1
        x = x / 10
    }
    var k: usize = n
    var i: usize = 0
    while i < m && k < CAP {
        if sep && i > 0 && (m - i) % 3 == 0 {
            *((base + k as u64) as *mut u8) = 44 as u8
            k = k + 1
        }
        *((base + k as u64) as *mut u8) = tmp[m - 1 - i]
        k = k + 1
        i = i + 1
    }
    return k
}

fn uint(v: u64, sep: bool) -> str {
    let base: u64 = next_slot()
    let n: usize = put_uint(base, 0, v, sep, 1)
    return str { p: base as *mut u8, n: n }
}

fn put_dec(base: u64, n0: usize, v: f64, places: usize) -> usize {
    var scale: u64 = 1
    var i: usize = 0
    while i < places {
        scale = scale * 10
        i = i + 1
    }
    var n: usize = n0
    var a: f64 = v
    if a < 0.0 {
        n = put_str(base, n, "-")
        a = 0.0 - a
    }
    let r: u64 = (a * (scale as f64) + 0.5) as u64
    n = put_uint(base, n, r / scale, false, 1)
    if places > 0 {
        n = put_str(base, n, ".")
        n = put_uint(base, n, r % scale, false, places)
    }
    return n
}

fn dec(v: f64, places: usize) -> str {
    let base: u64 = next_slot()
    let n: usize = put_dec(base, 0, v, places)
    return str { p: base as *mut u8, n: n }
}

fn signed(v: f64, places: usize) -> str {
    let base: u64 = next_slot()
    var n: usize = 0
    if v >= 0.0 { n = put_str(base, 0, "+") }
    n = put_dec(base, n, v, places)
    return str { p: base as *mut u8, n: n }
}

fn upper(s: str) -> str {
    let base: u64 = next_slot()
    var n: usize = 0
    while n < s.n && n < CAP {
        var ch: u8 = *((s.p as u64 + n as u64) as *mut u8)
        if ch >= 97 as u8 && ch <= 122 as u8 { ch = ch - 32 as u8 }
        *((base + n as u64) as *mut u8) = ch
        n = n + 1
    }
    return str { p: base as *mut u8, n: n }
}

fn join3(a: str, b: str, c: str) -> str {
    let base: u64 = next_slot()
    var n: usize = put_str(base, 0, a)
    n = put_str(base, n, b)
    n = put_str(base, n, c)
    return str { p: base as *mut u8, n: n }
}

fn join(a: str, b: str) -> str {
    return join3(a, b, "")
}

fn slice(s: str, from: usize, n: usize) -> str {
    if from >= s.n { return str { p: s.p, n: 0 } }
    var k: usize = n
    if from + k > s.n { k = s.n - from }
    return str { p: (s.p as u64 + from as u64) as *mut u8, n: k }
}

fn leading_uint(s: str) -> u64 {
    var v: u64 = 0
    var i: usize = 0
    while i < s.n {
        let ch: u8 = *((s.p as u64 + i as u64) as *mut u8)
        if ch < 48 as u8 || ch > 57 as u8 { return v }
        v = v * 10 + ((ch - 48 as u8) as u64)
        i = i + 1
    }
    return v
}
