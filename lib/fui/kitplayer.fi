import std.rt
import fui.render
import fui.theme
import fui.editor
import fui.kpplayer
import fui.kpmodel
import fui.kplayout
import fui.kpdraw
import fui.kpcodecall

export {
    PlayerView, pv_new, pv_free, pv_open, pv_close, pv_player, pv_layout, pv_draw, pv_press, pv_move,
    pv_release, pv_key, pv_char, pv_wheel, pv_tick, pv_animating, pv_drag, pv_layout_ptr,
}

const SKIP_MS: i64 = 5000
const BIG_SKIP_MS: i64 = 10000
const VOL_STEP: i64 = 5

struct PlayerView {
    pl: kpplayer.Player,
    lay: kplayout.Layout,
    drag: u32,
    gen: u64,
}

fn pv_new() -> PlayerView {
    var v: PlayerView = PlayerView { pl: kpplayer.pl_new(), lay: kplayout.lay_new(), drag: kplayout.HIT_NONE, gen: 0 as u64 }
    kpplayer.pl_set_installer(&v.pl, kpcodecall.install_for)
    return v
}

fn pv_free(v: *mut PlayerView) {
    kpplayer.pl_free(&(*v).pl)
}

fn pv_close(v: *mut PlayerView) {
    kpplayer.pl_close(&(*v).pl)
    (*v).drag = kplayout.HIT_NONE
}

fn pv_player(v: *mut PlayerView) -> *mut kpplayer.Player {
    return &(*v).pl
}

fn pv_layout_ptr(v: *mut PlayerView) -> *mut kplayout.Layout {
    return &(*v).lay
}

fn pv_drag(v: *mut PlayerView) -> u32 {
    return (*v).drag
}

fn pv_open(v: *mut PlayerView, data: u64, n: usize, name: str) -> bool {
    pv_close(v)
    (*v).gen = (*v).gen + (1 as u64)
    let ok: bool = kpplayer.pl_open(&(*v).pl, data, n, name)
    if ok {
        kpplayer.pl_update(&(*v).pl)
    }
    return ok
}

fn pv_layout(v: *mut PlayerView, x: f64, y: f64, w: f64, h: f64, scale: f64) {
    kplayout.lay_compute(&(*v).lay, x, y, w, h, scale)
}

fn scale_of(c: *mut render.Ctx) -> f64 {
    let s: f64 = (theme.theme_scale(render.ctx_theme(c)) as f64) / 1000.0
    if s <= 0.0 {
        return 1.0
    }
    return s
}

fn pv_draw(c: *mut render.Ctx, v: *mut PlayerView, x: f64, y: f64, w: f64, h: f64) {
    pv_layout(v, x, y, w, h, scale_of(c))
    kpdraw.draw_player(c, &(*v).pl, &(*v).lay, (*v).gen, (*v).drag)
}

fn set_volume_at(v: *mut PlayerView, px: f64) {
    let pm: i64 = kplayout.bar_permille(&(*v).lay, &(*v).lay.vol, px)
    kpplayer.pl_set_volume(&(*v).pl, (pm / 10) as u32)
}

fn pv_press(v: *mut PlayerView, px: f64, py: f64) -> bool {
    let hit: u32 = kplayout.lay_hit(&(*v).lay, px, py)
    if hit == kplayout.HIT_PLAY || hit == kplayout.HIT_SURFACE {
        kpplayer.pl_toggle(&(*v).pl)
        return true
    }
    if hit == kplayout.HIT_MUTE {
        kpplayer.pl_toggle_mute(&(*v).pl)
        return true
    }
    if hit == kplayout.HIT_SEEK {
        let pm: i64 = kplayout.bar_permille(&(*v).lay, &(*v).lay.seek, px)
        if kpplayer.pl_scrub_begin(&(*v).pl, pm) {
            (*v).drag = kplayout.HIT_SEEK
        }
        return true
    }
    if hit == kplayout.HIT_VOL {
        (*v).drag = kplayout.HIT_VOL
        set_volume_at(v, px)
        return true
    }
    return hit != kplayout.HIT_NONE
}

fn pv_move(v: *mut PlayerView, px: f64, py: f64) -> bool {
    if (*v).drag == kplayout.HIT_SEEK {
        kpplayer.pl_scrub_to(&(*v).pl, kplayout.bar_permille(&(*v).lay, &(*v).lay.seek, px))
        return true
    }
    if (*v).drag == kplayout.HIT_VOL {
        set_volume_at(v, px)
        return true
    }
    return false
}

fn pv_release(v: *mut PlayerView, px: f64, py: f64) -> bool {
    let was: u32 = (*v).drag
    if was == kplayout.HIT_NONE {
        return false
    }
    pv_move(v, px, py)
    if was == kplayout.HIT_SEEK {
        kpplayer.pl_scrub_end(&(*v).pl)
    }
    (*v).drag = kplayout.HIT_NONE
    return true
}

fn pv_key(v: *mut PlayerView, key: u32, mods: u32) -> bool {
    let p: *mut kpplayer.Player = &(*v).pl
    if key == editor.KEY_LEFT {
        kpplayer.pl_skip_ms(p, 0 - SKIP_MS)
        return true
    }
    if key == editor.KEY_RIGHT {
        kpplayer.pl_skip_ms(p, SKIP_MS)
        return true
    }
    if key == editor.KEY_UP {
        kpplayer.pl_volume_step(p, VOL_STEP)
        return true
    }
    if key == editor.KEY_DOWN {
        kpplayer.pl_volume_step(p, 0 - VOL_STEP)
        return true
    }
    if key == editor.KEY_HOME {
        kpplayer.pl_seek_ms(p, 0 as u64)
        return true
    }
    if key == editor.KEY_END {
        kpplayer.pl_seek_ms(p, kpplayer.pl_duration_ms(p))
        return true
    }
    if key == editor.KEY_ENTER {
        kpplayer.pl_toggle(p)
        return true
    }
    return false
}

fn pv_char(v: *mut PlayerView, cp: u32, mods: u32) -> bool {
    let p: *mut kpplayer.Player = &(*v).pl
    if cp == 32 as u32 || cp == 107 as u32 {
        kpplayer.pl_toggle(p)
        return true
    }
    if cp == 109 as u32 {
        kpplayer.pl_toggle_mute(p)
        return true
    }
    if cp == 106 as u32 {
        kpplayer.pl_skip_ms(p, 0 - BIG_SKIP_MS)
        return true
    }
    if cp == 108 as u32 {
        kpplayer.pl_skip_ms(p, BIG_SKIP_MS)
        return true
    }
    return false
}

fn pv_wheel(v: *mut PlayerView, dy: f64) -> bool {
    if dy == 0.0 {
        return false
    }
    var step: i64 = VOL_STEP
    if dy > 0.0 {
        step = 0 - VOL_STEP
    }
    kpplayer.pl_volume_step(&(*v).pl, step)
    return true
}

fn pv_tick(v: *mut PlayerView) -> bool {
    return kpplayer.pl_update(&(*v).pl)
}

fn pv_animating(v: *mut PlayerView) -> bool {
    return kpplayer.pl_animating(&(*v).pl)
}
