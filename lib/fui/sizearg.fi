// SPDX-License-Identifier: MPL-2.0
// lib/fui/sizearg.fi -- the "WxH" value of `--size` (shots at a phone size).
//
//   width / height   the number, or the default when the text is not "WxH" with both >= 64
fn digits_end(p: u64, from: usize) -> usize {
    var k: usize = from
    while *((p + k as u64) as *mut u8) >= 48 as u8 && *((p + k as u64) as *mut u8) <= 57 as u8 { k = k + 1 }
    return k
}

fn number(p: u64, from: usize, to: usize) -> usize {
    var v: usize = 0
    var k: usize = from
    while k < to {
        v = v * 10 + (*((p + k as u64) as *mut u8) - 48 as u8) as usize
        k = k + 1
    }
    return v
}

fn width(p: u64, dflt: usize) -> usize {
    if p == 0 { return dflt }
    let e: usize = digits_end(p, 0)
    let f: usize = digits_end(p, e + 1)
    let w: usize = number(p, 0, e)
    let h: usize = number(p, e + 1, f)
    if w < 64 || h < 64 { return dflt }
    return w
}

fn height(p: u64, dflt: usize) -> usize {
    if p == 0 { return dflt }
    let e: usize = digits_end(p, 0)
    let f: usize = digits_end(p, e + 1)
    let w: usize = number(p, 0, e)
    let h: usize = number(p, e + 1, f)
    if w < 64 || h < 64 { return dflt }
    return h
}
