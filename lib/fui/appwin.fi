import std.rt
import fui.app
import fui.appwinhost

export {
    supported, open, close, alive, count, at, on_close, SLOT_MAX,
}

const SLOT_MAX: usize = appwinhost.SLOT_MAX

struct Registry {
    apps: [u64; 7],
    closed: [fn(*mut app.App); 7],
    has_closed: [bool; 7],
}

static mut REG: u64 = 0

fn closed_none(a: *mut app.App) {}

fn supported() -> bool {
    return appwinhost.supported()
}

fn reg() -> *mut Registry {
    if REG == 0 {
        let p: u64 = rt.heap_alloc(sizeof_registry())
        if p == 0 {
            return 0 as u64 as *mut Registry
        }
        *(p as *mut Registry) = Registry { apps: [0; 7], closed: [closed_none; 7], has_closed: [false; 7] }
        REG = p
    }
    return REG as *mut Registry
}

fn sizeof_registry() -> usize {
    var probe: [Registry; 2] = [Registry { apps: [0; 7], closed: [closed_none; 7], has_closed: [false; 7] }; 2]
    return ((&probe[1]) as usize) - ((&probe[0]) as usize)
}

fn slot_of(r: *mut Registry, a: *mut app.App) -> usize {
    var i: usize = 0
    while i < SLOT_MAX {
        if (*r).apps[i] == (a as u64) {
            return i
        }
        i = i + 1
    }
    return app.NONE
}

fn free_slot(r: *mut Registry) -> usize {
    var i: usize = 0
    while i < SLOT_MAX {
        if (*r).apps[i] == 0 {
            return i
        }
        i = i + 1
    }
    return app.NONE
}

fn host_closed(ud: u64) {
    let r: *mut Registry = reg()
    let a: *mut app.App = ud as *mut app.App
    let i: usize = slot_of(r, a)
    if i == app.NONE {
        return
    }
    (*r).apps[i] = 0
    if (*r).has_closed[i] {
        let f: fn(*mut app.App) = (*r).closed[i]
        (*r).has_closed[i] = false
        f(a)
    }
}

fn open(title: str, w: usize, h: usize) -> *mut app.App {
    if !supported() {
        return 0 as u64 as *mut app.App
    }
    let r: *mut Registry = reg()
    if r as u64 == 0 {
        return 0 as u64 as *mut app.App
    }
    let i: usize = free_slot(r)
    if i == app.NONE {
        return 0 as u64 as *mut app.App
    }
    let a: *mut app.App = app.window(title, w, h)
    if a as u64 == 0 {
        return a
    }
    if !appwinhost.add(a as u64, app.app_hooks(a), host_closed) {
        return 0 as u64 as *mut app.App
    }
    (*r).apps[i] = a as u64
    (*r).has_closed[i] = false
    return a
}

fn on_close(a: *mut app.App, f: fn(*mut app.App)) {
    let r: *mut Registry = reg()
    let i: usize = slot_of(r, a)
    if i == app.NONE {
        return
    }
    (*r).closed[i] = f
    (*r).has_closed[i] = true
}

fn close(a: *mut app.App) {
    if alive(a) {
        app.quit(a)
    }
}

fn alive(a: *mut app.App) -> bool {
    if !supported() {
        return false
    }
    return appwinhost.alive(a as u64) && !app.app_done(a as u64)
}

fn count() -> usize {
    return appwinhost.count()
}

fn at(index: usize) -> *mut app.App {
    let r: *mut Registry = reg()
    var seen: usize = 0
    var i: usize = 0
    while i < SLOT_MAX {
        if (*r).apps[i] != 0 {
            if seen == index {
                return (*r).apps[i] as *mut app.App
            }
            seen = seen + 1
        }
        i = i + 1
    }
    return 0 as u64 as *mut app.App
}
