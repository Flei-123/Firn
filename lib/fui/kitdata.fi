// SPDX-License-Identifier: MPL-2.0
// lib/fui/kitdata.fi -- READ A JSON FILE AND WALK IT, in a few calls (for app screens and demos).
//
//     let d: *mut kitdata.Doc = kitdata.load("/path/profiles.json")
//     let list: u32 = kitdata.get(d, kitdata.root(d), "profiles")
//     let p0: u32 = kitdata.at(d, list, 0)
//     kitdata.text(d, kitdata.get(d, p0, "name"))     // str, lives as long as the Doc
//     kitdata.num(d, kitdata.get(d, p0, "mods"))      // i64
//
// A missing file or key gives an empty document / NONE / "" / 0 -- never a crash.
import std.rt
import std.json

const NONE: u32 = 4294967295

struct Doc {
    j: json.Json,
    text: rt.Buf,
    ok: bool,
}

fn load(path: str) -> *mut Doc {
    let d: *mut Doc = rt.heap_alloc(1 << 12) as *mut Doc
    (*d).j = json.json_new()
    (*d).text = rt.buf_new()
    (*d).ok = false
    var p: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&p, path.p as u64, path.n)
    rt.buf_push(&p, 0 as u8)
    if rt.read_file(rt.buf_ptr(&p), &(*d).text) {
        (*d).ok = json.json_parse(&(*d).j, rt.buf_ptr(&(*d).text), rt.buf_len(&(*d).text)) catch false
    }
    rt.buf_free(&p)
    return d
}

fn root(d: *mut Doc) -> u32 {
    if !(*d).ok { return NONE }
    return json.json_root(&(*d).j)
}

// the member `key` of an object
fn get(d: *mut Doc, node: u32, key: str) -> u32 {
    if node == NONE { return NONE }
    return json.json_get(&(*d).j, node, key.p as u64, key.n)
}

// the `k`-th element of an array
fn at(d: *mut Doc, node: u32, k: usize) -> u32 {
    if node == NONE { return NONE }
    return json.json_child_at(&(*d).j, node, k)
}

fn count(d: *mut Doc, node: u32) -> usize {
    if node == NONE { return 0 }
    return json.json_count(&(*d).j, node)
}

fn text(d: *mut Doc, node: u32) -> str {
    let s: *mut u8 = rt.heap_alloc(1) as *mut u8
    if node == NONE { return str { p: s, n: 0 } }
    let sp = json.json_string(&(*d).j, node)
    return str { p: sp.p, n: sp.n }
}

fn num(d: *mut Doc, node: u32) -> i64 {
    if node == NONE { return 0 }
    return json.json_int(&(*d).j, node)
}

fn float(d: *mut Doc, node: u32) -> f64 {
    if node == NONE { return 0.0 }
    return json.json_number(&(*d).j, node)
}
