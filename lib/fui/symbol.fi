// SPDX-License-Identifier: GPL-2.0-only
// lib/fui/symbol.fi -- DIE ZEICHEN, DIE BEDIENELEMENTE BRAUCHEN.
//
// ====================================================== WARUM ES SIE GIBT
//
// Welle 2 bringt fuenfzehn Elemente, und fast jedes braucht ein
// kleines Zeichen: das Haekchen im Ankreuzfeld, der Punkt im
// Auswahlknopf, das Dreieck der Aufklappliste, die Pfeile der
// Bildlaufleiste, das Kreuz am Reiter.
//
// DIE FALLE, DIE DAS VERHINDERT, IST BELEGT: in OrientOS ist dieselbe
// Zeichnung der Fensterknoepfe ZWEIMAL still verlorengegangen, weil
// sie an einer zweiten Stelle nachgebaut wurde. Ein Haekchen, das im
// Ankreuzfeld anders aussieht als im Menue, ist derselbe Fehler in
// klein -- und er faellt niemandem auf, bis Justin beide nebeneinander
// sieht.
//
// DARUM: jedes Zeichen steht GENAU EINMAL hier, in Entwurfspunkten,
// und wird ueber `male.laenge_von` skaliert. Wer ein Zeichen braucht,
// ruft es -- er malt es nicht nach.
//
// ================================================== WARUM KEINE SCHRIFT
//
// Ein Haekchen aus einer Schriftart (U+2713) haengt daran, dass die
// Schrift dieses Zeichen HAT. DejaVu hat es, viele haben es nicht, und
// im Kernprofil gibt es ueberhaupt keine Schrift (K1 in kern.fi). Ein
// Ankreuzfeld, dessen Haken bei fehlender Schrift verschwindet, ist
// ein Ankreuzfeld, dem man nicht ansieht, ob es an ist.
//
// Alle Zeichen hier sind darum GEOMETRIE: Striche und Flaechen, die
// der Rasterer kantenglaettet. Sie funktionieren ohne jede Schrift.
//
// ============================================== DIE GEMEINSAME REGEL
//
// Jede Funktion bekommt ein QUADRAT (x, y, d) und malt darin. Das
// Quadrat ist die Zeichenflaeche, nicht das Element -- wer ein Zeichen
// in einem Knopf zentrieren will, rechnet das Quadrat aus und ruft
// dann. So bleibt jedes Zeichen unabhaengig davon, worin es steht.
import std.rt
import fui.zeichnen

export {
    hak, punkt, dreieck_ab, dreieck_auf, dreieck_links,
    dreieck_rechts, kreuz, minus, griff_linien,
    R_AB, R_AUF, R_LINKS, R_RECHTS, dreieck,
}

const R_AB: u32 = 0
const R_AUF: u32 = 1
const R_LINKS: u32 = 2
const R_RECHTS: u32 = 3

// ======================================================== DAS HAEKCHEN
//
// Zwei Striche, kurz nach unten und lang nach oben. Die Proportionen
// (0.22/0.48/0.78 waagerecht, 0.52/0.72/0.28 senkrecht) sind die von
// Material und HIG -- ein Haken, dessen langer Arm nicht deutlich
// laenger ist als der kurze, sieht aus wie ein v.
//
// Gemalt wird als zwei RECHTECKE entlang der Diagonalen, weil der
// Zeichner keine schraegen Striche kann: eine Treppe aus kurzen
// waagerechten Stuecken, die der Rasterer glaettet. Bei den Groessen,
// um die es geht (10-16 Punkte), ist das vom echten Strich nicht zu
// unterscheiden.
fn hak(z: *mut zeichnen.Zeichner, x: f64, y: f64, d: f64, st: f64,
    col: u32) {
    // Die drei Punkte des Hakens im Einheitsquadrat.
    let ax: f64 = x + d * 0.22
    let ay: f64 = y + d * 0.52
    let bx: f64 = x + d * 0.42
    let by: f64 = y + d * 0.72
    let cx: f64 = x + d * 0.78
    let cy: f64 = y + d * 0.28
    strich(z, ax, ay, bx, by, st, col)
    strich(z, bx, by, cx, cy, st, col)
}

// EIN SCHRAEGER STRICH als Treppe aus Rechtecken.
//
// Der Zeichner malt Rechtecke und runde Flaechen, keine Linien mit
// Steigung. Ein schraeger Strich wird darum in Schritte zerlegt: bei
// jedem Schritt ein kleines Quadrat der Strichstaerke. Die Schrittzahl
// richtet sich nach der laengeren Achse, damit keine Luecken bleiben.
fn strich(z: *mut zeichnen.Zeichner, x0: f64, y0: f64, x1: f64,
    y1: f64, st: f64, col: u32) {
    var dx: f64 = x1 - x0
    var dy: f64 = y1 - y0
    var adx: f64 = dx
    if adx < 0.0 {
        adx = 0.0 - adx
    }
    var ady: f64 = dy
    if ady < 0.0 {
        ady = 0.0 - ady
    }
    var lang: f64 = adx
    if ady > lang {
        lang = ady
    }
    // Zwei Schritte je Bildpunkt: bei einem Schritt bleiben auf der
    // Diagonalen Luecken, weil das Quadrat sich nur an der Ecke
    // beruehrt.
    var n: i64 = (lang * 2.0) as i64
    if n < 1 {
        n = 1
    }
    var s: f64 = st
    if s < 1.0 {
        s = 1.0
    }
    let h: f64 = s / 2.0
    var i: i64 = 0
    while i <= n {
        let t: f64 = (i as f64) / (n as f64)
        zeichnen.flaeche(z, x0 + dx * t - h, y0 + dy * t - h, s, s, col)
        i = i + 1
    }
}

// ============================================================ DER PUNKT
//
// Die Fuellung des Auswahlknopfs. Ein Kreis ist ein Rechteck mit dem
// halben Durchmesser als Radius -- `zeichnen.rund` kann das, und damit
// ist der Punkt kantengeglaettet wie alles andere.
fn punkt(z: *mut zeichnen.Zeichner, x: f64, y: f64, d: f64, col: u32) {
    zeichnen.rund(z, x, y, d, d, d / 2.0, col)
}

// =========================================================== DAS DREIECK
//
// Der Pfeil der Aufklappliste und der Bildlaufleiste. Gemalt als
// Stapel von Rechtecken, die zur Spitze hin schmaler werden -- vier
// Richtungen aus EINER Funktion, damit die Aufklappliste und die
// Bildlaufleiste garantiert dasselbe Dreieck zeigen.
//
// Die Hoehe ist 0.5 * d: ein gleichseitiges Dreieck wirkt bei kleinen
// Groessen zu wuchtig, die Systeme nehmen alle ein flaches.
fn dreieck(z: *mut zeichnen.Zeichner, x: f64, y: f64, d: f64,
    richtung: u32, col: u32) {
    let n: i64 = ((d * 0.5) as i64)
    var i: i64 = 0
    if richtung == R_AB || richtung == R_AUF {
        // Waagerechte Streifen, von der Basis zur Spitze schmaler.
        while i < n {
            let t: f64 = (i as f64)
            let br: f64 = d - t * 2.0
            if br <= 0.0 {
                return
            }
            var yy: f64 = y + t
            if richtung == R_AUF {
                yy = y + (n as f64) - 1.0 - t
            }
            zeichnen.flaeche(z, x + t, yy, br, 1.0, col)
            i = i + 1
        }
        return
    }
    // Senkrechte Streifen.
    while i < n {
        let t: f64 = (i as f64)
        let ho: f64 = d - t * 2.0
        if ho <= 0.0 {
            return
        }
        var xx: f64 = x + t
        if richtung == R_LINKS {
            xx = x + (n as f64) - 1.0 - t
        }
        zeichnen.flaeche(z, xx, y + t, 1.0, ho, col)
        i = i + 1
    }
}

fn dreieck_ab(z: *mut zeichnen.Zeichner, x: f64, y: f64, d: f64,
    col: u32) {
    dreieck(z, x, y, d, R_AB, col)
}

fn dreieck_auf(z: *mut zeichnen.Zeichner, x: f64, y: f64, d: f64,
    col: u32) {
    dreieck(z, x, y, d, R_AUF, col)
}

fn dreieck_links(z: *mut zeichnen.Zeichner, x: f64, y: f64, d: f64,
    col: u32) {
    dreieck(z, x, y, d, R_LINKS, col)
}

fn dreieck_rechts(z: *mut zeichnen.Zeichner, x: f64, y: f64, d: f64,
    col: u32) {
    dreieck(z, x, y, d, R_RECHTS, col)
}

// ============================================================ DAS KREUZ
//
// Das Schliesszeichen am Reiter. Zwei Diagonalen -- dieselbe
// Treppentechnik wie beim Haken, damit beide gleich aussehen.
//
// Es gibt bereits ein Kreuz in lib/fui/kern.fi (`kn_schliessen`) fuer
// die FENSTERKNOEPFE, und das bleibt dort: der Kern malt ohne
// Zeichner, mit eigener Kantenglaettung, auf ein rohes Ziel. Dieses
// hier ist das Kreuz FUER ELEMENTE. Zwei Fassungen fuer zwei
// Zeichenwege sind kein Nachbau -- ein Nachbau waere es, wenn
// dasselbe Ziel zweimal bemalt wuerde.
fn kreuz(z: *mut zeichnen.Zeichner, x: f64, y: f64, d: f64, st: f64,
    col: u32) {
    strich(z, x, y, x + d, y + d, st, col)
    strich(z, x + d, y, x, y + d, st, col)
}

// ============================================================ DER STRICH
//
// Das Zeichen fuer "teilweise angekreuzt" -- ein Ankreuzfeld, dessen
// Kinder nicht alle denselben Zustand haben. Jedes System hat es,
// und ohne ihn muesste ein Baum mit gemischten Haken luegen.
fn minus(z: *mut zeichnen.Zeichner, x: f64, y: f64, d: f64, st: f64,
    col: u32) {
    var s: f64 = st
    if s < 1.0 {
        s = 1.0
    }
    zeichnen.flaeche(z, x + d * 0.2, y + d / 2.0 - s / 2.0, d * 0.6, s,
        col)
}

// ====================================================== DIE GRIFFRILLEN
//
// Die Rillen auf dem Schieber einer Bildlaufleiste und dem Griff eines
// Schiebereglers. Drei kurze Striche -- sie sagen "das kann man
// anfassen", und das ist die einzige Stelle, an der eine Flaeche das
// von sich aus zeigt.
fn griff_linien(z: *mut zeichnen.Zeichner, x: f64, y: f64, w: f64,
    h: f64, senkrecht: bool, col: u32) {
    var i: i64 = 0
    while i < 3 {
        let o: f64 = ((i - 1) as f64) * 3.0
        if senkrecht {
            zeichnen.flaeche(z, x + w * 0.25, y + h / 2.0 + o,
                w * 0.5, 1.0, col)
        } else {
            zeichnen.flaeche(z, x + w / 2.0 + o, y + h * 0.25, 1.0,
                h * 0.5, col)
        }
        i = i + 1
    }
}
