import fui.app
import fui.scene
import fui.widget
import fui.render
import fui.webview
import fui.webview_types
import plat.fuiwirt

export {
    WvNode, wvnode_new, wvnode_attach, wvnode_pointer, wvnode_key, wvnode_char, wvnode_wheel,
    wvnode_tick, wvnode_wait, wvnode_rect_hit, wvnode_spot,
    wvnode_ime_active, wvnode_ime_pre, wvnode_ime_commit, wvnode_ime_end, wvnode_ime_spot,
}

const BUTTON_LEFT: u32 = 0
const DEFAULT_SCALE_MILLI: u32 = 1000
const NO_CARET: i32 = 0 - 1

struct WvNode {
    wv: *mut webview.WebView,
    node: usize,
    ox: f64,
    oy: f64,
    w: f64,
    h: f64,
    inside: bool,
    captured: bool,
    spot_x: f64,
    spot_y: f64,
    spot_h: f64,
}

fn wvnode_new(wv: *mut webview.WebView) -> WvNode {
    return WvNode { wv: wv, node: app.NONE, ox: 0.0, oy: 0.0, w: 0.0, h: 0.0, inside: false, captured: false,
        spot_x: 0.0, spot_y: 0.0, spot_h: 0.0 }
}

fn wvnode_rect_hit(n: *mut WvNode, x: f64, y: f64) -> bool {
    return x >= (*n).ox && y >= (*n).oy && x < (*n).ox + (*n).w && y < (*n).oy + (*n).h
}

fn wvnode_spot(ud: u64, x: f64, y: f64, h: f64) {
    let n: *mut WvNode = ud as *mut WvNode
    (*n).spot_x = (*n).ox + x
    (*n).spot_y = (*n).oy + y
    (*n).spot_h = h
}

fn draw(ud: u64, c: *mut render.Ctx, e: *mut widget.Widget) {
    let n: *mut WvNode = ud as *mut WvNode
    (*n).ox = widget.w_x(e)
    (*n).oy = widget.w_y(e)
    (*n).w = widget.w_w(e)
    (*n).h = widget.w_h(e)
    webview.webview_resize((*n).wv, (*n).w as u32, (*n).h as u32, DEFAULT_SCALE_MILLI)
    if webview.webview_frames((*n).wv) == 0 as u64 {
        webview.webview_tick((*n).wv, app.mono_us())
    }
    webview.webview_draw((*n).wv, render.ctx_painter(c), (*n).ox, (*n).oy)
}

fn wvnode_attach(a: *mut app.App, n: *mut WvNode, w_pt: usize, h_pt: usize) -> usize {
    (*n).node = app.custom(a, widget.KIND_TILE, w_pt, h_pt)
    if (*n).node == app.NONE {
        return app.NONE
    }
    scene.node_set_draw(app.app_scene(a), (*n).node, n as u64, draw)
    webview.webview_on_spot((*n).wv, n as u64, wvnode_spot)
    app.set_motion(a, n as u64, wvnode_pointer)
    app.set_keys(a, n as u64, wvnode_key, wvnode_char)
    app.set_wheel(a, n as u64, wvnode_wheel)
    app.set_extra_wake(a, n as u64, wvnode_tick, wvnode_wait)
    app.set_ime_sink(a, n as u64, wvnode_ime_active, wvnode_ime_pre, wvnode_ime_commit, wvnode_ime_end, wvnode_ime_spot)
    return (*n).node
}

fn wvnode_pointer(ud: u64, kind: u32, x: f64, y: f64) -> bool {
    let n: *mut WvNode = ud as *mut WvNode
    let hit: bool = wvnode_rect_hit(n, x, y)
    let lx: f64 = x - (*n).ox
    let ly: f64 = y - (*n).oy
    if kind == fuiwirt.HOOK_DOWN {
        if !hit {
            webview.webview_focus((*n).wv, false)
            return false
        }
        (*n).captured = true
        return webview.webview_pointer((*n).wv, webview_types.IN_DOWN, lx, ly, BUTTON_LEFT, 0 as u32)
    }
    if kind == fuiwirt.HOOK_UP {
        let was: bool = (*n).captured
        (*n).captured = false
        if !was {
            return false
        }
        return webview.webview_pointer((*n).wv, webview_types.IN_UP, lx, ly, BUTTON_LEFT, 0 as u32)
    }
    if kind == fuiwirt.HOOK_LEAVE || (!hit && !(*n).captured) {
        let was_inside: bool = (*n).inside
        (*n).inside = false
        if !was_inside {
            return false
        }
        return webview.webview_pointer((*n).wv, webview_types.IN_LEAVE, lx, ly, 0 as u32, 0 as u32)
    }
    (*n).inside = true
    return webview.webview_pointer((*n).wv, webview_types.IN_MOVE, lx, ly, 0 as u32, 0 as u32)
}

fn wvnode_key(ud: u64, key: u32, mods: u32) -> bool {
    let n: *mut WvNode = ud as *mut WvNode
    return webview.webview_key((*n).wv, true, key, mods)
}

fn wvnode_char(ud: u64, cp: u32, mods: u32) -> bool {
    let n: *mut WvNode = ud as *mut WvNode
    return webview.webview_char_mods((*n).wv, cp, mods)
}

fn wvnode_wheel(ud: u64, x: f64, y: f64, nx: f64, ny: f64) -> bool {
    let n: *mut WvNode = ud as *mut WvNode
    if !wvnode_rect_hit(n, x, y) {
        return false
    }
    return webview.webview_wheel((*n).wv, x - (*n).ox, y - (*n).oy, nx, ny, 0 as u32)
}

fn wvnode_tick(ud: u64, now: i64) -> bool {
    let n: *mut WvNode = ud as *mut WvNode
    return webview.webview_tick((*n).wv, now)
}

fn wvnode_wait(ud: u64, now: i64) -> i64 {
    let n: *mut WvNode = ud as *mut WvNode
    return webview.webview_wait_ms((*n).wv, now)
}

fn wvnode_ime_active(ud: u64) -> bool {
    let n: *mut WvNode = ud as *mut WvNode
    return webview.webview_focused((*n).wv)
}

fn wvnode_ime_pre(ud: u64, p: u64, n: usize, caret: usize) -> bool {
    let w: *mut WvNode = ud as *mut WvNode
    var cursor: i32 = NO_CARET
    if caret <= n {
        cursor = caret as i32
    }
    return webview.webview_preedit((*w).wv, p, n, cursor)
}

fn wvnode_ime_commit(ud: u64, p: u64, n: usize) -> bool {
    let w: *mut WvNode = ud as *mut WvNode
    return webview.webview_commit((*w).wv, p, n)
}

fn wvnode_ime_end(ud: u64) {
    let w: *mut WvNode = ud as *mut WvNode
    if webview.webview_preediting((*w).wv) {
        webview.webview_preedit((*w).wv, 0, 0, NO_CARET)
    }
}

fn wvnode_ime_spot(ud: u64, out: *mut [f64; 3]) -> bool {
    let n: *mut WvNode = ud as *mut WvNode
    if !webview.webview_has_caret((*n).wv) {
        return false
    }
    (*out)[0] = (*n).spot_x
    (*out)[1] = (*n).spot_y
    (*out)[2] = (*n).spot_h
    return true
}
