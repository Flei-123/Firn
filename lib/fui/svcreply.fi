import std.rt
import services.svc
import fui.svcq

export { pump }

fn ok_flag(status: i32) -> u32 {
    if status == svc.OK {
        return 1 as u32
    }
    return 0 as u32
}

fn translate(r: *mut svc.Reply) {
    if (*r).op == svc.OP_FILE_ITEM {
        svcq.push(svcq.EV_OPENED, ok_flag((*r).status), rt.buf_str(&(*r).name), rt.buf_ptr(&(*r).data), rt.buf_len(&(*r).data))
    } else if (*r).op == svc.OP_FILE_END && (*r).index == 0 as u32 {
        svcq.push(svcq.EV_OPENED, 0 as u32, "", 0, 0)
    } else if (*r).op == svc.OP_CLIP_TEXT {
        svcq.push(svcq.EV_CLIP, ok_flag((*r).status), "", rt.buf_ptr(&(*r).data), rt.buf_len(&(*r).data))
    }
}

fn pump() {
    var r: svc.Reply = svc.reply_new()
    while svc.poll(&r) {
        translate(&r)
    }
    svc.reply_free(&r)
}
