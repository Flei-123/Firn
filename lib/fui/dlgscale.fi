// lib/fui/dlgscale.fi -- THE TEXT SCALE OF THE STOCK DIALOGS (file, font, colour dialog; r391).
//
// A dialog lays out in design points. With the user's text scale above 1000 per mille the text of a row grows, so the row, the bar
// and the button must grow with it (measure = paint = hit test). `grow(ts, fixed, size)` is the design height `fixed` plus what a
// text line of `size` points gained at the scale `ts`; at 1000 it is `fixed` exactly (pixel identical to before).
// The scale itself comes from the dialog's theme (`app.set_text_scale`); `set_text_scale(p)` lets a program pass the host's
// setting before the dialog opens, FUI_TEXT_SCALE (e.g. 1.5 or 150%) does the same for tests. Unset = the app keeps what it has.

import plat.envvar
import window.hostmetrics
import fui.app
import fui.theme

export {
    set_text_scale, text_scale, apply, grow, grow_app, grow_theme,
}

static mut G_TS: usize = 0

// A program hands in the host's text scale (per mille); 0 = unset.
fn set_text_scale(promille: usize) {
    G_TS = promille
}

// The scale asked for by hand or by FUI_TEXT_SCALE, clamped to 500..3000; 0 when nobody asked.
fn text_scale() -> usize {
    var t: usize = G_TS
    if t == 0 {
        var b: [u8; 64] = [0; 64]
        let n: usize = envvar.env_value_copy("FUI_TEXT_SCALE", (&b[0]) as u64, 64)
        if n > 0 {
            t = hostmetrics.parse_scale_permille((&b[0]) as u64, n)
        }
    }
    if t == 0 {
        return 0
    }
    if t < 500 {
        return 500
    }
    if t > 3000 {
        return 3000
    }
    return t
}

// Give a new dialog window the asked-for scale (nothing when none was asked for).
fn apply(a: *mut app.App) {
    let t: usize = text_scale()
    if t != 0 {
        app.set_text_scale(a, t)
    }
}

// The design height `fixed` (points) for text of `size` points at the text scale `ts` (per mille).
fn grow(ts: usize, fixed: usize, size: usize) -> usize {
    if ts <= 1000 || ts == 0 {
        return fixed
    }
    let l1: usize = size * 14 / 10
    let l2: usize = hostmetrics.scale_text_px(size, ts) * 14 / 10
    if l2 > l1 {
        return fixed + (l2 - l1)
    }
    return fixed
}

fn grow_theme(m: *mut theme.Theme, fixed: usize, size: usize) -> usize {
    return grow(theme.theme_text_scale(m), fixed, size)
}

fn grow_app(a: *mut app.App, fixed: usize, size: usize) -> usize {
    return grow(theme.theme_text_scale(app.app_theme(a)), fixed, size)
}
