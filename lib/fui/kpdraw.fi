import std.rt
import fui.painter
import fui.render
import fui.kit
import fui.style
import fui.icons
import fui.uiimage
import fui.kpplayer
import fui.kpmodel
import fui.kplayout
import fui.kpfmt
import fui.kpicon

export { draw_player, frame_key }

const BLACK: u32 = 4278190080

fn frame_key(gen: u64, p: *mut kpplayer.Player) -> u64 {
    var k: u64 = (gen + (1 as u64)) *% (1099511628211 as u64)
    k = (k ^ kpplayer.pl_frame_no(p)) *% (1099511628211 as u64)
    k = (k ^ kpplayer.pl_frame(p)) *% (1099511628211 as u64)
    if k == 0 as u64 {
        k = 1 as u64
    }
    return k
}

fn centered(c: *mut render.Ctx, x: f64, w: f64, y: f64, h: f64, size: f64, weight: usize, col: u32, s: str) {
    var tw: f64 = kit.text_width(c, size, weight, s)
    if tw > w {
        tw = w
    }
    kit.draw_label(c, x + (w - tw) / 2.0, y, h, size, weight, col, s, tw + 2.0)
}

fn state_icon(z: *mut painter.Painter, st: u32, x: f64, y: f64, size: f64, col: u32) {
    if st == kpmodel.TS_PLAYING {
        kpicon.draw_pause(z, x, y, size, col)
        return
    }
    if st == kpmodel.TS_ENDED {
        kpicon.draw_replay(z, x, y, size, col)
        return
    }
    kpicon.draw_play(z, x, y, size, col)
}

fn draw_disc(z: *mut painter.Painter, cx: f64, cy: f64, r: f64, col: u32) {
    painter.round_rect(z, cx - r, cy - r, r * 2.0, r * 2.0, r, col)
}

fn draw_audio_face(c: *mut render.Ctx, p: *mut kpplayer.Player, area: *mut kplayout.Rect, s: f64) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let cx: f64 = (*area).x + (*area).w / 2.0
    var r: f64 = 48.0 * s
    if r * 3.0 > (*area).h {
        r = (*area).h / 3.0
    }
    let cy: f64 = (*area).y + (*area).h / 2.0 - 14.0 * s
    draw_disc(z, cx, cy, r, kit.tokc(c, style.TOK_ACCENT))
    state_icon(z, kpplayer.pl_state(p), cx - r * 0.45, cy - r * 0.45, r * 0.9, kit.tokc(c, style.TOK_TEXT_ON_ACCENT))
    let mw: f64 = (*area).w - 32.0 * s
    centered(c, (*area).x + 16.0 * s, mw, cy + r + 10.0 * s, 24.0 * s, 16.0, 600, kit.tokc(c, style.TOK_TEXT), kpplayer.pl_name(p))
    centered(c, (*area).x + 16.0 * s, mw, cy + r + 34.0 * s, 20.0 * s, 13.0, 400, kit.tokc(c, style.TOK_TEXT_MUTED), kpplayer.pl_info(p))
}

fn draw_video_face(c: *mut render.Ctx, p: *mut kpplayer.Player, area: *mut kplayout.Rect, gen: u64, s: f64) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    painter.surface(z, (*area).x, (*area).y, (*area).w, (*area).h, BLACK)
    if !kpplayer.pl_has_frame(p) {
        return
    }
    var dst: kplayout.Rect = kplayout.Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 }
    kplayout.fit_rect(kpplayer.pl_frame_width(p) as f64, kpplayer.pl_frame_height(p) as f64, area, &dst)
    var im: uiimage.Image = uiimage.image_wrap(kpplayer.pl_frame(p), kpplayer.pl_frame_width(p) as usize, kpplayer.pl_frame_height(p) as usize, 0)
    uiimage.image_draw_keyed(z, &im, dst.x, dst.y, dst.w, dst.h, frame_key(gen, p))
    let st: u32 = kpplayer.pl_state(p)
    if st != kpmodel.TS_PLAYING {
        let r: f64 = 30.0 * s
        let cx: f64 = (*area).x + (*area).w / 2.0
        let cy: f64 = (*area).y + (*area).h / 2.0
        draw_disc(z, cx, cy, r, kit.with_alpha(BLACK, 150 as u32))
        state_icon(z, st, cx - r * 0.5, cy - r * 0.5, r, 4294967295 as u32)
    }
}

fn draw_face(c: *mut render.Ctx, p: *mut kpplayer.Player, area: *mut kplayout.Rect, gen: u64, s: f64) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    if kpplayer.pl_state(p) == kpmodel.TS_FAILED {
        painter.surface(z, (*area).x, (*area).y, (*area).w, (*area).h, kit.tokc(c, style.TOK_BASE))
        var msg: str = "This file cannot be played"
        if kpplayer.pl_error(p) == kpplayer.PE_CODEC {
            msg = "No decoder for this codec"
        }
        centered(c, (*area).x + 16.0 * s, (*area).w - 32.0 * s, (*area).y + (*area).h / 2.0 - 12.0 * s, 24.0 * s, 15.0, 400, kit.tokc(c, style.TOK_ERROR), msg)
        return
    }
    if kpplayer.pl_has_video(p) {
        draw_video_face(c, p, area, gen, s)
        return
    }
    painter.surface(z, (*area).x, (*area).y, (*area).w, (*area).h, kit.tokc(c, style.TOK_BASE))
    draw_audio_face(c, p, area, s)
}

fn draw_track(c: *mut render.Ctx, l: *mut kplayout.Layout, r: *mut kplayout.Rect, permille: i64, thumb: bool, hot: bool) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let s: f64 = (*l).scale
    let inset: f64 = 8.0 * s
    let tx: f64 = (*r).x + inset
    let tw: f64 = (*r).w - 2.0 * inset
    if tw <= 0.0 {
        return
    }
    let th: f64 = 4.0 * s
    let ty: f64 = (*r).y + ((*r).h - th) / 2.0
    painter.round_rect(z, tx, ty, tw, th, th / 2.0, kit.tokc(c, style.TOK_SEPARATOR))
    let fw: f64 = tw * (permille as f64) / 1000.0
    if fw > 0.0 {
        painter.round_rect(z, tx, ty, fw, th, th / 2.0, kit.tokc(c, style.TOK_ACCENT))
    }
    if thumb {
        var tr: f64 = 5.0 * s
        if hot {
            tr = 7.0 * s
        }
        draw_disc(z, tx + fw, ty + th / 2.0, tr, kit.tokc(c, style.TOK_ACCENT))
    }
}

fn draw_time(c: *mut render.Ctx, r: *mut kplayout.Rect, ms: u64, s: f64, right: bool) {
    var b: rt.Buf = rt.buf_new()
    kpfmt.fmt_time(ms, &b)
    let t: str = str { p: rt.buf_ptr(&b) as *mut u8, n: rt.buf_len(&b) }
    let col: u32 = kit.tokc(c, style.TOK_TEXT_MUTED)
    var x: f64 = (*r).x
    if right {
        x = (*r).x + (*r).w - kit.text_width(c, 12.0, 400, t)
    }
    kit.draw_label(c, x, (*r).y, (*r).h, 12.0, 400, col, t, 0.0)
    rt.buf_free(&b)
}

fn draw_bar(c: *mut render.Ctx, p: *mut kpplayer.Player, l: *mut kplayout.Layout, drag: u32) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let s: f64 = (*l).scale
    painter.surface(z, (*l).bar.x, (*l).bar.y, (*l).bar.w, (*l).bar.h, kit.tokc(c, style.TOK_SURFACE))
    painter.surface(z, (*l).bar.x, (*l).bar.y, (*l).bar.w, 1.0, kit.tokc(c, style.TOK_SEPARATOR))
    let ink: u32 = kit.tokc(c, style.TOK_TEXT)
    let isz: f64 = 22.0 * s
    state_icon(z, kpplayer.pl_state(p), (*l).play.x + ((*l).play.w - isz) / 2.0, (*l).play.y + ((*l).play.h - isz) / 2.0, isz, ink)
    let dur: u64 = kpplayer.pl_duration_ms(p)
    var shown: u64 = kpplayer.pl_position_ms(p)
    if kpplayer.pl_scrubbing(p) {
        shown = dur * (kpplayer.pl_permille(p) as u64) / (1000 as u64)
    }
    draw_time(c, &(*l).cur, shown, s, false)
    draw_time(c, &(*l).dur, dur, s, true)
    draw_track(c, l, &(*l).seek, kpplayer.pl_permille(p), true, drag == kplayout.HIT_SEEK)
    let msz: f64 = 20.0 * s
    let mx: f64 = (*l).mute.x + ((*l).mute.w - msz) / 2.0
    let my: f64 = (*l).mute.y + ((*l).mute.h - msz) / 2.0
    let vol: u32 = kpplayer.pl_volume(p)
    if kpplayer.pl_muted(p) || vol == 0 as u32 {
        kpicon.draw_speaker_muted(z, mx, my, msz, ink)
    } else {
        kpicon.draw_speaker(z, mx, my, msz, ink, vol)
    }
    if (*l).has_vol {
        var level: i64 = (vol as i64) * 10
        if kpplayer.pl_muted(p) {
            level = 0
        }
        draw_track(c, l, &(*l).vol, level, true, drag == kplayout.HIT_VOL)
    }
}

fn draw_player(c: *mut render.Ctx, p: *mut kpplayer.Player, l: *mut kplayout.Layout, gen: u64, drag: u32) {
    draw_face(c, p, &(*l).surface, gen, (*l).scale)
    draw_bar(c, p, l, drag)
}
