// SPDX-License-Identifier: MPL-2.0
// lib/fui/uia.fi -- the MODEL of the Windows UI Automation bridge (roadmap r19 / r152).
//
//     import fui.uia
//
//     var pv: uia.Provider = uia.provider_new(app.app_scene(a), app.ax(a), "My app")
//     let root: uia.El = uia.el_root(&pv)
//     let kid: uia.El = uia.el_first_child(&pv, root)
//     uia.el_control_type(&pv, kid)       // 50000 = Button, ...
//
// WHAT IT IS. Everything a UIA provider has to ANSWER, as plain functions over the live scene and the
// a11y tree (lib/fui/a11y.fi): control type, name, patterns (Invoke, Toggle, Value, RangeValue,
// ExpandCollapse, SelectionItem, Selection), toggle / expand state, range, bounding rectangle,
// enabled / focus flags, navigation (parent, first/last child, next/previous sibling), runtime id,
// hit test. It is the counterpart of lib/fui/atspi.fi, with the same tree (the same children order,
// the same virtual list rows) so a screen reader on either OS sees the same program.
//
// It has NO Windows calls: it compiles and is tested on every host (tools/fui/uia_main.fi).
//
// HONEST
//   U1  The COM glue is NOT here. IRawElementProviderSimple / Fragment / FragmentRoot, the pattern
//       interfaces and WM_GETOBJECT -> UiaReturnRawElementProvider need hand-made vtables over
//       `#[win_callback]` thunks and `win64_call` (model: lib/audio/dev.windows.fi) and a Windows
//       host (Narrator, Inspect.exe, or Wine with a UIA client). Not built, not testable here
//       (Wine has no UIA client). Roadmap: uia COM glue.
//   U2  Rectangles are in WINDOW coordinates plus the origin set by `provider_set_origin` (the host
//       fills in the window's client position on the screen).
//   U3  No TextPattern (the text field offers the Value pattern only), no Scroll / Grid / Table
//       pattern, no events (UiaRaiseAutomationEvent): the host would call `el_*` again after a
//       change, events: lib/fui/uiacom.windows.fi polls (W23-c).
//   U4  Names: the a11y name (explicit > own label > labelled-by > content), rows of virtual lists by
//       their row name.
import std.rt
import fui.scene
import fui.a11y
import fui.widget
import fui.app

export {
    Provider, El, provider_new, provider_set_app, provider_set_origin, provider_title,
    el_none, el_is_none, el_equal, el_root, el_from_node,
    el_parent, el_first_child, el_last_child, el_next, el_prev, el_child_count,
    NAV_PARENT, NAV_NEXT, NAV_PREV, NAV_FIRST, NAV_LAST, el_navigate,
    el_control_type, control_type_of, el_type_name, el_name, el_automation_id, el_is_heading,
    el_patterns, el_has_pattern, pattern_id,
    PAT_INVOKE, PAT_VALUE, PAT_RANGE, PAT_TOGGLE, PAT_EXPAND, PAT_SELITEM, PAT_SELECTION,
    PAT_GRID, PAT_TABLE, PAT_GRIDITEM, PAT_TABLEITEM,
    el_value, el_range_value_ui, RANGE_DIV, el_grid_rows, el_grid_cols, el_cell_row, el_cell_col,
    el_cell_at, el_row_of_cell, el_head_count, el_head_at, el_head_of_cell, K_HEAD, CT_HEADERITEM, el_multi_select, el_selected_count, el_selected_at, el_row_index,
    el_enabled, el_focusable, el_has_focus, el_readonly, el_rect,
    TOG_OFF, TOG_ON, TOG_INDETERMINATE, el_toggle_state,
    EXP_COLLAPSED_S, EXP_EXPANDED_S, EXP_PARTIAL_S, EXP_LEAF_S, el_expand_state,
    el_range_value, el_range_min, el_range_max, el_is_selected,
    el_runtime_id, el_from_point,
    CT_BUTTON, CT_CHECKBOX, CT_COMBOBOX, CT_EDIT, CT_HYPERLINK, CT_IMAGE, CT_LISTITEM, CT_LIST,
    CT_MENU, CT_MENUITEM, CT_PROGRESSBAR, CT_RADIOBUTTON, CT_SCROLLBAR, CT_SLIDER, CT_STATUSBAR,
    CT_TABITEM, CT_TEXT, CT_TOOLBAR, CT_TOOLTIP, CT_TREE, CT_TREEITEM, CT_CUSTOM, CT_GROUP,
    CT_WINDOW, CT_PANE, CT_DATAITEM, CT_TABLE, CT_SEPARATOR,
}

// UIA_ControlTypeIds (UIAutomationClient.h).
const CT_BUTTON: u32 = 50000
const CT_CHECKBOX: u32 = 50002
const CT_COMBOBOX: u32 = 50003
const CT_EDIT: u32 = 50004
const CT_HYPERLINK: u32 = 50005
const CT_IMAGE: u32 = 50006
const CT_LISTITEM: u32 = 50007
const CT_LIST: u32 = 50008
const CT_MENU: u32 = 50009
const CT_MENUITEM: u32 = 50011
const CT_PROGRESSBAR: u32 = 50012
const CT_RADIOBUTTON: u32 = 50013
const CT_SCROLLBAR: u32 = 50014
const CT_SLIDER: u32 = 50015
const CT_STATUSBAR: u32 = 50017
const CT_TABITEM: u32 = 50019
const CT_TEXT: u32 = 50020
const CT_TOOLBAR: u32 = 50021
const CT_TOOLTIP: u32 = 50022
const CT_TREE: u32 = 50023
const CT_TREEITEM: u32 = 50024
const CT_CUSTOM: u32 = 50025
const CT_GROUP: u32 = 50026
const CT_WINDOW: u32 = 50032
const CT_PANE: u32 = 50033
const CT_TABLE: u32 = 50036
const CT_DATAITEM: u32 = 50029
const CT_SEPARATOR: u32 = 50038

// The patterns the model knows, as bits; `pattern_id` gives the UIA_PatternId.
const PAT_INVOKE: u32 = 1
const PAT_VALUE: u32 = 2
const PAT_RANGE: u32 = 4
const PAT_TOGGLE: u32 = 8
const PAT_EXPAND: u32 = 16
const PAT_SELITEM: u32 = 32
const PAT_SELECTION: u32 = 64
// W37: the table family (a bound list in table mode / one of its cells)
const PAT_GRID: u32 = 128
const PAT_TABLE: u32 = 256
const PAT_GRIDITEM: u32 = 512
const PAT_TABLEITEM: u32 = 1024

const TOG_OFF: u32 = 0
const TOG_ON: u32 = 1
const TOG_INDETERMINATE: u32 = 2
const EXP_COLLAPSED_S: u32 = 0
const EXP_EXPANDED_S: u32 = 1
const EXP_PARTIAL_S: u32 = 2
const EXP_LEAF_S: u32 = 3

const NAV_PARENT: u32 = 0
const NAV_NEXT: u32 = 1
const NAV_PREV: u32 = 2
const NAV_FIRST: u32 = 3
const NAV_LAST: u32 = 4

const NONE: usize = 4294967295
const K_NONE: u32 = 0
const K_NODE: u32 = 1
const K_ROW: u32 = 2
// W34: a cell of a virtual TABLE row; `row` holds row * CELL_MUL + column
const K_CELL: u32 = 3
const CELL_MUL: usize = 4096
// W38: a column header cell of a TABLE (`row` = the column); a child of the table node, after the scene children
const K_HEAD: u32 = 4
const CT_HEADERITEM: u32 = 50034

// One element: a scene node, or a visible row of the virtual list bound to a node.
struct El {
    kind: u32,
    node: usize,
    row: usize,
}

struct Provider {
    sc: *mut scene.Scene,
    ax: *mut a11y.A11y,
    title: str,
    ox: i64,
    oy: i64,
    app: u64, // *mut app.App (0 = unknown): the text of text fields lives in its editors
}

// `title` stays owned by the caller.
fn provider_new(sc: *mut scene.Scene, ax: *mut a11y.A11y, title: str) -> Provider {
    return Provider { sc: sc, ax: ax, title: title, ox: 0, oy: 0, app: 0 }
}

// Where the window's client area starts on the screen (U2).
// The app whose editors hold the text of the text fields (for the Value pattern).
fn provider_set_app(pv: *mut Provider, a: *mut app.App) {
    (*pv).app = a as u64
}

fn provider_set_origin(pv: *mut Provider, x: i64, y: i64) {
    (*pv).ox = x
    (*pv).oy = y
}

fn provider_title(pv: *mut Provider) -> str { return (*pv).title }

fn el_none() -> El { return El { kind: K_NONE, node: 0, row: 0 } }
fn el_is_none(e: El) -> bool { return e.kind == K_NONE }
fn el_equal(a: El, b: El) -> bool {
    return a.kind == b.kind && a.node == b.node && a.row == b.row
}

fn node_ok(pv: *mut Provider, i: usize) -> bool { return i < scene.scene_count((*pv).sc) }

fn el_from_node(pv: *mut Provider, i: usize) -> El {
    if !node_ok(pv, i) { return el_none() }
    return El { kind: K_NODE, node: i, row: 0 }
}

// The element of the window: the scene root.
fn el_root(pv: *mut Provider) -> El {
    let r: usize = scene.scene_root((*pv).sc)
    if r == scene.SCENE_NONE { return el_none() }
    return el_from_node(pv, r)
}

fn valid(pv: *mut Provider, e: El) -> bool {
    if e.kind == K_NONE || !node_ok(pv, e.node) { return false }
    if e.kind == K_ROW {
        return e.row >= a11y.a11y_vrow_first((*pv).ax, e.node)
        && e.row < a11y.a11y_vrow_end((*pv).ax, e.node)
    }
    if e.kind == K_CELL {
        return e.row / CELL_MUL >= a11y.a11y_vrow_first((*pv).ax, e.node)
        && e.row / CELL_MUL < a11y.a11y_vrow_end((*pv).ax, e.node)
        && e.row % CELL_MUL < a11y.a11y_vcol_count((*pv).ax, e.node)
    }
    if e.kind == K_HEAD {
        return e.row < a11y.a11y_vhead_count((*pv).ax, e.node)
    }
    return true
}

fn vrow_n(pv: *mut Provider, i: usize) -> usize {
    let a: usize = a11y.a11y_vrow_first((*pv).ax, i)
    let z: usize = a11y.a11y_vrow_end((*pv).ax, i)
    if z > a { return z - a }
    return 0
}

// ---------------------------------------------------------------- navigation

fn el_child_count(pv: *mut Provider, e: El) -> usize {
    if e.kind == K_ROW && valid(pv, e) { return a11y.a11y_vcol_count((*pv).ax, e.node) }
    if e.kind != K_NODE || !valid(pv, e) { return 0 }
    var n: usize = vrow_n(pv, e.node)
    var c: usize = a11y.a11y_kid_first((*pv).sc, (*pv).ax, e.node)
    while c != scene.SCENE_NONE {
        n = n + 1
        c = a11y.a11y_kid_next((*pv).sc, (*pv).ax, c)
    }
    return n + a11y.a11y_vhead_count((*pv).ax, e.node)
}

// Child number `k` (the visible virtual rows first, then the scene children -- the order of atspi.fi).
fn kid_at(pv: *mut Provider, e: El, k: usize) -> El {
    if e.kind == K_ROW && valid(pv, e) {
        if k < a11y.a11y_vcol_count((*pv).ax, e.node) {
            return El { kind: K_CELL, node: e.node, row: e.row * CELL_MUL + k }
        }
        return el_none()
    }
    if e.kind != K_NODE || !valid(pv, e) { return el_none() }
    let vn: usize = vrow_n(pv, e.node)
    if k < vn {
        return El { kind: K_ROW, node: e.node, row: a11y.a11y_vrow_first((*pv).ax, e.node) + k }
    }
    var j: usize = k - vn
    var c: usize = a11y.a11y_kid_first((*pv).sc, (*pv).ax, e.node)
    while c != scene.SCENE_NONE {
        if j == 0 { return El { kind: K_NODE, node: c, row: 0 } }
        j = j - 1
        c = a11y.a11y_kid_next((*pv).sc, (*pv).ax, c)
    }
    // after the scene children: the header cells of a table
    if j < a11y.a11y_vhead_count((*pv).ax, e.node) {
        return El { kind: K_HEAD, node: e.node, row: j }
    }
    return el_none()
}

fn el_parent(pv: *mut Provider, e: El) -> El {
    if !valid(pv, e) { return el_none() }
    if e.kind == K_ROW { return El { kind: K_NODE, node: e.node, row: 0 } }
    if e.kind == K_CELL { return El { kind: K_ROW, node: e.node, row: e.row / CELL_MUL } }
    if e.kind == K_HEAD { return El { kind: K_NODE, node: e.node, row: 0 } }
    let p: usize = scene.scene_parent((*pv).sc, e.node)
    if p == scene.SCENE_NONE || p >= scene.scene_count((*pv).sc) { return el_none() }
    return El { kind: K_NODE, node: p, row: 0 }
}

fn el_first_child(pv: *mut Provider, e: El) -> El { return kid_at(pv, e, 0) }

fn el_last_child(pv: *mut Provider, e: El) -> El {
    let n: usize = el_child_count(pv, e)
    if n == 0 { return el_none() }
    return kid_at(pv, e, n - 1)
}

fn index_in_parent(pv: *mut Provider, e: El) -> usize {
    let p: El = el_parent(pv, e)
    if p.kind == K_NONE { return NONE }
    let n: usize = el_child_count(pv, p)
    var k: usize = 0
    while k < n {
        if el_equal(kid_at(pv, p, k), e) { return k }
        k = k + 1
    }
    return NONE
}

fn el_next(pv: *mut Provider, e: El) -> El {
    let k: usize = index_in_parent(pv, e)
    if k == NONE { return el_none() }
    return kid_at(pv, el_parent(pv, e), k + 1)
}

fn el_prev(pv: *mut Provider, e: El) -> El {
    let k: usize = index_in_parent(pv, e)
    if k == NONE || k == 0 { return el_none() }
    return kid_at(pv, el_parent(pv, e), k - 1)
}

// IRawElementProviderFragment::Navigate(direction)
fn el_navigate(pv: *mut Provider, e: El, dir: u32) -> El {
    if dir == NAV_PARENT { return el_parent(pv, e) }
    if dir == NAV_NEXT { return el_next(pv, e) }
    if dir == NAV_PREV { return el_prev(pv, e) }
    if dir == NAV_FIRST { return el_first_child(pv, e) }
    if dir == NAV_LAST { return el_last_child(pv, e) }
    return el_none()
}

// ------------------------------------------------------------ types and names

// fUi role -> UIA control type.
fn control_type_of(r: u32) -> u32 {
    if r == a11y.ROLE_TEXT { return CT_TEXT }
    if r == a11y.ROLE_BUTTON { return CT_BUTTON }
    if r == a11y.ROLE_CHECKBOX { return CT_CHECKBOX }
    if r == a11y.ROLE_RADIO { return CT_RADIOBUTTON }
    if r == a11y.ROLE_SWITCH { return CT_BUTTON } // like WinUI's ToggleSwitch: a Button with Toggle
    if r == a11y.ROLE_SLIDER { return CT_SLIDER }
    if r == a11y.ROLE_TEXTBOX { return CT_EDIT }
    if r == a11y.ROLE_PROGRESSBAR { return CT_PROGRESSBAR }
    if r == a11y.ROLE_COMBOBOX { return CT_COMBOBOX }
    if r == a11y.ROLE_LIST { return CT_LIST }
    if r == a11y.ROLE_LISTITEM { return CT_LISTITEM }
    if r == a11y.ROLE_TREE { return CT_TREE }
    if r == a11y.ROLE_TREEITEM { return CT_TREEITEM }
    if r == a11y.ROLE_TABLE { return CT_TABLE }
    if r == a11y.ROLE_ROW { return CT_DATAITEM }
    if r == a11y.ROLE_CELL { return CT_CUSTOM }
    if r == a11y.ROLE_TAB { return CT_TABITEM }
    if r == a11y.ROLE_TABPANEL { return CT_PANE }
    if r == a11y.ROLE_MENU { return CT_MENU }
    if r == a11y.ROLE_MENUITEM { return CT_MENUITEM }
    if r == a11y.ROLE_MENUITEMCHECKBOX { return CT_MENUITEM }
    if r == a11y.ROLE_MENUITEMRADIO { return CT_MENUITEM }
    if r == a11y.ROLE_TOOLBAR { return CT_TOOLBAR }
    if r == a11y.ROLE_SCROLLBAR { return CT_SCROLLBAR }
    if r == a11y.ROLE_SEPARATOR { return CT_SEPARATOR }
    if r == a11y.ROLE_GROUP { return CT_GROUP }
    if r == a11y.ROLE_HEADING { return CT_TEXT }
    if r == a11y.ROLE_LINK { return CT_HYPERLINK }
    if r == a11y.ROLE_IMAGE { return CT_IMAGE }
    if r == a11y.ROLE_TOOLTIP { return CT_TOOLTIP }
    if r == a11y.ROLE_STATUS { return CT_STATUSBAR }
    if r == a11y.ROLE_DIALOG { return CT_WINDOW }
    if r == a11y.ROLE_ALERTDIALOG { return CT_WINDOW }
    return CT_CUSTOM
}

fn role_of(pv: *mut Provider, e: El) -> u32 {
    if e.kind == K_ROW { return a11y.a11y_vrow_role((*pv).ax, e.node) }
    if e.kind == K_CELL || e.kind == K_HEAD { return a11y.ROLE_CELL }
    return a11y.a11y_role((*pv).sc, (*pv).ax, e.node)
}

fn state_of(pv: *mut Provider, e: El) -> u32 {
    if e.kind == K_ROW { return a11y.a11y_vrow_state((*pv).sc, (*pv).ax, e.node, e.row) }
    if e.kind == K_CELL { return a11y.a11y_vcell_state((*pv).sc, (*pv).ax, e.node, e.row / CELL_MUL, e.row % CELL_MUL) }
    if e.kind == K_HEAD { return 0 as u32 }
    return a11y.a11y_state((*pv).sc, (*pv).ax, e.node)
}

fn el_control_type(pv: *mut Provider, e: El) -> u32 {
    if !valid(pv, e) { return 0 as u32 }
    if e.kind == K_NODE && e.node == scene.scene_root((*pv).sc) { return CT_WINDOW }
    if e.kind == K_HEAD { return CT_HEADERITEM }
    return control_type_of(role_of(pv, e))
}

// A.k.a. LocalizedControlType (English; the host may map it).
fn el_type_name(pv: *mut Provider, e: El) -> str {
    let t: u32 = el_control_type(pv, e)
    if t == CT_BUTTON { if role_of(pv, e) == a11y.ROLE_SWITCH { return "toggle switch" } return "button" }
    if t == CT_CHECKBOX { return "check box" }
    if t == CT_COMBOBOX { return "combo box" }
    if t == CT_EDIT { return "edit" }
    if t == CT_HYPERLINK { return "link" }
    if t == CT_IMAGE { return "image" }
    if t == CT_LISTITEM { return "list item" }
    if t == CT_LIST { return "list" }
    if t == CT_MENU { return "menu" }
    if t == CT_MENUITEM { return "menu item" }
    if t == CT_PROGRESSBAR { return "progress bar" }
    if t == CT_RADIOBUTTON { return "radio button" }
    if t == CT_SCROLLBAR { return "scroll bar" }
    if t == CT_SLIDER { return "slider" }
    if t == CT_STATUSBAR { return "status bar" }
    if t == CT_TABITEM { return "tab item" }
    if t == CT_TEXT { if role_of(pv, e) == a11y.ROLE_HEADING { return "heading" } return "text" }
    if t == CT_TOOLBAR { return "tool bar" }
    if t == CT_TOOLTIP { return "tooltip" }
    if t == CT_TREE { return "tree" }
    if t == CT_TREEITEM { return "tree item" }
    if t == CT_GROUP { return "group" }
    if t == CT_WINDOW { return "window" }
    if t == CT_PANE { return "pane" }
    if t == CT_TABLE { return "table" }
    if t == CT_DATAITEM { return "data item" }
    if t == CT_SEPARATOR { return "separator" }
    return "custom"
}

// The name into `p` (capacity `cap`); returns the length. The window's own name is the title.
fn el_name(pv: *mut Provider, e: El, p: u64, cap: usize) -> usize {
    if !valid(pv, e) { return 0 }
    var n: usize = 0
    if e.kind == K_CELL {
        return a11y.a11y_vcell_name((*pv).ax, e.node, e.row / CELL_MUL, e.row % CELL_MUL, p, cap)
    }
    if e.kind == K_ROW {
        return a11y.a11y_vrow_name((*pv).ax, e.node, e.row, p, cap)
    }
    if e.kind == K_HEAD {
        return a11y.a11y_vhead_name((*pv).ax, e.node, e.row, p, cap)
    }
    n = a11y.a11y_name((*pv).sc, (*pv).ax, e.node, p, cap)
    if n == 0 && e.node == scene.scene_root((*pv).sc) {
        n = (*pv).title.n
        if n > cap { n = cap }
        rt.mem_copy(p, (((*pv).title.p) as u64), n)
    }
    return n
}

// "n<i>" / "v<i>_<row>" into `out`, the same ids as the AT-SPI paths. Returns the length.
fn el_automation_id(e: El, out: *mut rt.Buf) -> usize {
    rt.buf_clear(out)
    if e.kind == K_NODE {
        rt.buf_push(out, 110 as u8)
        rt.buf_push_dec_u64(out, e.node as u64)
    } else if e.kind == K_ROW {
        rt.buf_push(out, 118 as u8)
        rt.buf_push_dec_u64(out, e.node as u64)
        rt.buf_push(out, 95 as u8)
        rt.buf_push_dec_u64(out, e.row as u64)
    } else if e.kind == K_HEAD {
        rt.buf_push(out, 104 as u8)
        rt.buf_push_dec_u64(out, e.node as u64)
        rt.buf_push(out, 95 as u8)
        rt.buf_push_dec_u64(out, e.row as u64)
    } else if e.kind == K_CELL {
        rt.buf_push(out, 99 as u8)
        rt.buf_push_dec_u64(out, e.node as u64)
        rt.buf_push(out, 95 as u8)
        rt.buf_push_dec_u64(out, (e.row / CELL_MUL) as u64)
        rt.buf_push(out, 95 as u8)
        rt.buf_push_dec_u64(out, (e.row % CELL_MUL) as u64)
    }
    return rt.buf_len(out)
}

fn el_is_heading(pv: *mut Provider, e: El) -> bool {
    return valid(pv, e) && e.kind == K_NODE && role_of(pv, e) == a11y.ROLE_HEADING
}

// ------------------------------------------------------------------ patterns

fn is_widget(pv: *mut Provider, e: El) -> bool {
    if e.kind == K_ROW { return true }
    return a11y.role_is_widget(role_of(pv, e))
}

fn el_patterns(pv: *mut Provider, e: El) -> u32 {
    if !valid(pv, e) { return 0 as u32 }
    let r: u32 = role_of(pv, e)
    var m: u32 = 0 as u32
    if r == a11y.ROLE_BUTTON || r == a11y.ROLE_LINK || r == a11y.ROLE_MENUITEM { m = m | PAT_INVOKE }
    if r == a11y.ROLE_CHECKBOX || r == a11y.ROLE_SWITCH || r == a11y.ROLE_MENUITEMCHECKBOX { m = m | PAT_TOGGLE }
    if r == a11y.ROLE_RADIO || r == a11y.ROLE_TAB || r == a11y.ROLE_LISTITEM || r == a11y.ROLE_TREEITEM
    || r == a11y.ROLE_MENUITEMRADIO || r == a11y.ROLE_ROW {
        m = m | PAT_SELITEM
    }
    if r == a11y.ROLE_LIST || r == a11y.ROLE_TREE || r == a11y.ROLE_COMBOBOX || r == a11y.ROLE_TABLE {
        m = m | PAT_SELECTION
    }
    if r == a11y.ROLE_TEXTBOX || r == a11y.ROLE_COMBOBOX { m = m | PAT_VALUE }
    if r == a11y.ROLE_COMBOBOX { m = m | PAT_EXPAND }
    if r == a11y.ROLE_TREEITEM {
        let st: u32 = state_of(pv, e)
        if (st & (a11y.ST_EXPANDED | a11y.ST_COLLAPSED)) != 0 as u32 { m = m | PAT_EXPAND }
    }
    if e.kind == K_NODE && a11y.a11y_has_range((*pv).sc, (*pv).ax, e.node) { m = m | PAT_RANGE }
    if e.kind == K_NODE && r == a11y.ROLE_TABLE && a11y.a11y_vtable((*pv).ax, e.node) {
        m = m | PAT_GRID | PAT_TABLE | PAT_SELECTION
    }
    if e.kind == K_CELL { m = m | PAT_GRIDITEM | PAT_TABLEITEM }
    // W40-a r361: a column header is a HeaderItem you can Invoke (a click on it sorts the table, like the mouse)
    if e.kind == K_HEAD { m = m | PAT_INVOKE }
    return m
}

fn el_has_pattern(pv: *mut Provider, e: El, bit: u32) -> bool {
    return (el_patterns(pv, e) & bit) != 0 as u32
}

// UIA_PatternId of one PAT_* bit (0 = none).
fn pattern_id(bit: u32) -> u32 {
    if bit == PAT_INVOKE { return 10000 as u32 }
    if bit == PAT_SELECTION { return 10001 as u32 }
    if bit == PAT_VALUE { return 10002 as u32 }
    if bit == PAT_RANGE { return 10003 as u32 }
    if bit == PAT_EXPAND { return 10005 as u32 }
    if bit == PAT_GRID { return 10006 as u32 }
    if bit == PAT_GRIDITEM { return 10007 as u32 }
    if bit == PAT_TABLE { return 10012 as u32 }
    if bit == PAT_TABLEITEM { return 10013 as u32 }
    if bit == PAT_SELITEM { return 10010 as u32 }
    if bit == PAT_TOGGLE { return 10015 as u32 }
    return 0 as u32
}

// ------------------------------------------------------------- flags and state

fn el_enabled(pv: *mut Provider, e: El) -> bool {
    if !valid(pv, e) { return false }
    return (state_of(pv, e) & a11y.ST_DISABLED) == 0 as u32
}

fn el_focusable(pv: *mut Provider, e: El) -> bool {
    return valid(pv, e) && (state_of(pv, e) & a11y.ST_FOCUSABLE) != 0 as u32
}

fn el_has_focus(pv: *mut Provider, e: El) -> bool {
    return valid(pv, e) && (state_of(pv, e) & a11y.ST_FOCUSED) != 0 as u32
}

fn el_readonly(pv: *mut Provider, e: El) -> bool {
    return valid(pv, e) && (state_of(pv, e) & a11y.ST_READONLY) != 0 as u32
}

fn el_is_selected(pv: *mut Provider, e: El) -> bool {
    return valid(pv, e) && (state_of(pv, e) & a11y.ST_SELECTED) != 0 as u32
}

fn el_toggle_state(pv: *mut Provider, e: El) -> u32 {
    let st: u32 = state_of(pv, e)
    if (st & a11y.ST_MIXED) != 0 as u32 { return TOG_INDETERMINATE }
    if (st & (a11y.ST_CHECKED | a11y.ST_PRESSED)) != 0 as u32 { return TOG_ON }
    return TOG_OFF
}

fn el_expand_state(pv: *mut Provider, e: El) -> u32 {
    let st: u32 = state_of(pv, e)
    if (st & a11y.ST_EXPANDED) != 0 as u32 { return EXP_EXPANDED_S }
    if (st & a11y.ST_COLLAPSED) != 0 as u32 { return EXP_COLLAPSED_S }
    return EXP_LEAF_S
}

fn el_range_value(pv: *mut Provider, e: El) -> i64 {
    if e.kind != K_NODE || !valid(pv, e) { return 0 }
    return a11y.a11y_value((*pv).sc, e.node)
}
// W37: UIA reports the range as 0 .. 100 (percent of the track), the a11y model counts per mille (0 .. 1000).
const RANGE_DIV: i64 = 10
fn el_range_min() -> i64 { return a11y.a11y_min() / RANGE_DIV }
fn el_range_max() -> i64 { return a11y.a11y_max() / RANGE_DIV }
// the value on the UIA scale (0.0 .. 100.0)
fn el_range_value_ui(pv: *mut Provider, e: El) -> f64 {
    return (el_range_value(pv, e) as f64) / (RANGE_DIV as f64)
}

// Value pattern text: the REAL text of a text field / combo box (never a secret), else the name.
fn el_value(pv: *mut Provider, e: El, p: u64, cap: usize) -> usize {
    if e.kind == K_NODE && valid(pv, e) {
        let r: u32 = role_of(pv, e)
        if r == a11y.ROLE_TEXTBOX || r == a11y.ROLE_COMBOBOX {
            if a11y.a11y_is_secret((*pv).sc, e.node) { return 0 }
            if (*pv).app != 0 {
                // the real text sits in the field's editor (the widget text is the label / hint)
                let t: str = app.text((*pv).app as *mut app.App, e.node)
                var m: usize = t.n
                if m > cap { m = cap }
                if m > 0 { rt.mem_copy(p, t.p as u64, m) }
                return m
            }
            let wd: *mut widget.Widget = scene.node_widget((*pv).sc, e.node)
            var n: usize = widget.w_text_len(wd)
            if n > cap { n = cap }
            if n > 0 { rt.mem_copy(p, widget.w_text(wd), n) }
            return n
        }
    }
    return el_name(pv, e, p, cap)
}

// ------------------------------------------------------------------ table (Grid / Table / GridItem / TableItem)

fn el_grid_rows(pv: *mut Provider, e: El) -> usize {
    if e.kind != K_NODE || !valid(pv, e) { return 0 }
    return a11y.a11y_vrow_total((*pv).ax, e.node)
}

fn el_grid_cols(pv: *mut Provider, e: El) -> usize {
    if e.kind != K_NODE || !valid(pv, e) { return 0 }
    return a11y.a11y_vcol_count((*pv).ax, e.node)
}

fn el_cell_row(e: El) -> usize { return e.row / CELL_MUL }
fn el_cell_col(e: El) -> usize { return e.row % CELL_MUL }

// The visible cell (row, col) of a table node; none when scrolled out (virtual rows) or out of range.
fn el_cell_at(pv: *mut Provider, e: El, row: usize, col: usize) -> El {
    if e.kind != K_NODE || !valid(pv, e) { return el_none() }
    let c: El = El { kind: K_CELL, node: e.node, row: row * CELL_MUL + col }
    if !valid(pv, c) { return el_none() }
    return c
}

// The row element a cell sits in.
fn el_row_of_cell(pv: *mut Provider, e: El) -> El {
    if e.kind != K_CELL || !valid(pv, e) { return el_none() }
    return El { kind: K_ROW, node: e.node, row: e.row / CELL_MUL }
}

// W38: the header cells of a table node (the column titles)
fn el_head_count(pv: *mut Provider, e: El) -> usize {
    if e.kind != K_NODE || !valid(pv, e) { return 0 }
    return a11y.a11y_vhead_count((*pv).ax, e.node)
}

fn el_head_at(pv: *mut Provider, e: El, col: usize) -> El {
    if e.kind != K_NODE || !valid(pv, e) { return el_none() }
    let h: El = El { kind: K_HEAD, node: e.node, row: col }
    if !valid(pv, h) { return el_none() }
    return h
}

// the column header of a cell (none without a header strip)
fn el_head_of_cell(pv: *mut Provider, e: El) -> El {
    if e.kind != K_CELL || !valid(pv, e) { return el_none() }
    let h: El = El { kind: K_HEAD, node: e.node, row: e.row % CELL_MUL }
    if !valid(pv, h) { return el_none() }
    return h
}

// The model row number of a row / cell (NONE else).
fn el_row_index(e: El) -> usize {
    if e.kind == K_ROW { return e.row }
    if e.kind == K_CELL { return e.row / CELL_MUL }
    return NONE
}

fn el_multi_select(pv: *mut Provider, e: El) -> bool {
    if e.kind != K_NODE || !valid(pv, e) { return false }
    return a11y.a11y_vmulti((*pv).ax, e.node)
}

// The selected rows that show (the others are not reachable as elements).
fn el_selected_count(pv: *mut Provider, e: El) -> usize {
    if e.kind != K_NODE || !valid(pv, e) { return 0 }
    var n: usize = 0
    var r: usize = a11y.a11y_vrow_first((*pv).ax, e.node)
    let z: usize = a11y.a11y_vrow_end((*pv).ax, e.node)
    while r < z {
        if (a11y.a11y_vrow_state((*pv).sc, (*pv).ax, e.node, r) & a11y.ST_SELECTED) != 0 as u32 { n = n + 1 }
        r = r + 1
    }
    return n
}

fn el_selected_at(pv: *mut Provider, e: El, k: usize) -> El {
    if e.kind != K_NODE || !valid(pv, e) { return el_none() }
    var n: usize = 0
    var r: usize = a11y.a11y_vrow_first((*pv).ax, e.node)
    let z: usize = a11y.a11y_vrow_end((*pv).ax, e.node)
    while r < z {
        if (a11y.a11y_vrow_state((*pv).sc, (*pv).ax, e.node, r) & a11y.ST_SELECTED) != 0 as u32 {
            if n == k { return El { kind: K_ROW, node: e.node, row: r } }
            n = n + 1
        }
        r = r + 1
    }
    return el_none()
}

// ------------------------------------------------------------------ geometry

// BoundingRectangle in SCREEN coordinates (window coordinates + the origin): x, y, w, h.
fn el_rect(pv: *mut Provider, e: El, out: *mut [i64; 4]) {
    var q: [i64; 4] = [0; 4]
    if valid(pv, e) {
        if e.kind == K_NODE {
            q[0] = scene.node_x((*pv).sc, e.node) as i64
            q[1] = scene.node_y((*pv).sc, e.node) as i64
            q[2] = scene.node_w((*pv).sc, e.node) as i64
            q[3] = scene.node_h((*pv).sc, e.node) as i64
        } else if e.kind == K_CELL {
            a11y.a11y_vcell_rect((*pv).sc, (*pv).ax, e.node, e.row / CELL_MUL, e.row % CELL_MUL, &q)
        } else if e.kind == K_HEAD {
            a11y.a11y_vhead_rect((*pv).sc, (*pv).ax, e.node, e.row, &q)
        } else {
            a11y.a11y_vrow_rect((*pv).sc, (*pv).ax, e.node, e.row, &q)
        }
    }
    (*out)[0] = q[0] + (*pv).ox
    (*out)[1] = q[1] + (*pv).oy
    (*out)[2] = q[2]
    (*out)[3] = q[3]
}

// UiaAppendRuntimeId marker 3, then node + 1 and the row (0 = the node itself): three ints.
fn el_runtime_id(e: El, out: *mut [i32; 3]) {
    (*out)[0] = 3
    (*out)[1] = (e.node + 1) as i32
    if e.kind == K_ROW {
        (*out)[2] = (e.row + 1) as i32
    } else if e.kind == K_HEAD {
        (*out)[2] = (1073741824 + e.row + 1) as i32
    } else if e.kind == K_CELL {
        // row + 1 in the high part, column + 1 in the low part (a node has 4096 columns at most)
        (*out)[2] = ((e.row / CELL_MUL + 1) * 8192 + (e.row % CELL_MUL) + 1) as i32
    } else {
        (*out)[2] = 0
    }
}

fn inside(pv: *mut Provider, e: El, x: i64, y: i64) -> bool {
    var q: [i64; 4] = [0; 4]
    el_rect(pv, e, &q)
    return x >= q[0] && y >= q[1] && x < q[0] + q[2] && y < q[1] + q[3]
}

fn descend(pv: *mut Provider, e: El, x: i64, y: i64, depth: usize) -> El {
    if depth > 40 { return e }
    var k: usize = el_child_count(pv, e)
    while k > 0 {
        k = k - 1
        let c: El = kid_at(pv, e, k)
        if c.kind != K_NONE && inside(pv, c, x, y) { return descend(pv, c, x, y, depth + 1) }
    }
    return e
}

// ElementProviderFromPoint: the deepest element under the SCREEN point; none when outside the window.
fn el_from_point(pv: *mut Provider, x: i64, y: i64) -> El {
    let r: El = el_root(pv)
    if r.kind == K_NONE || !inside(pv, r, x, y) { return el_none() }
    return descend(pv, r, x, y, 0)
}
