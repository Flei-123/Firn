import std.rt
import fui.svcq
import fui.svcmem
import fui.svcsys
import fui.svcfile
import fui.svcplat

export {
    SvcEvent, EV_NONE, EV_OPENED, EV_SAVED, EV_CLIP,
    ANS_OK, ANS_CANCEL, ANS_YES, ANS_NO,
    KIND_INFO, KIND_QUESTION, KIND_WARNING, KIND_ERROR,
    BTNS_OK, BTNS_OK_CANCEL, BTNS_YES_NO, BTNS_YES_NO_CANCEL,
    use_memory, is_memory, memory_reset, script_pick, script_answer,
    event_new, event_free, next, pending,
    open_request, save_request, read_path, write_path,
    clip_copy, clip_request, message, confirm,
    store_get, store_set,
}

const EV_NONE: u32 = svcq.EV_NONE
const EV_OPENED: u32 = svcq.EV_OPENED
const EV_SAVED: u32 = svcq.EV_SAVED
const EV_CLIP: u32 = svcq.EV_CLIP
const ANS_OK: i32 = 1
const ANS_CANCEL: i32 = 2
const ANS_YES: i32 = 3
const ANS_NO: i32 = 4
const KIND_INFO: i32 = 0
const KIND_QUESTION: i32 = 1
const KIND_WARNING: i32 = 2
const KIND_ERROR: i32 = 3
const BTNS_OK: i32 = 0
const BTNS_OK_CANCEL: i32 = 1
const BTNS_YES_NO: i32 = 2
const BTNS_YES_NO_CANCEL: i32 = 3
const SAVE_MIME: str = "application/octet-stream"

struct SvcEvent {
    kind: u32,
    status: u32,
    name: rt.Buf,
    data: rt.Buf,
}

static mut G_MEMORY: bool = false

fn use_memory(on: bool) {
    G_MEMORY = on
    svcmem.reset()
}

fn is_memory() -> bool {
    return G_MEMORY
}

fn memory_reset() {
    svcmem.reset()
}

fn script_pick(name: str) {
    svcmem.script_pick(name)
}

fn script_answer(answer: i32) {
    svcmem.script_answer(answer)
}

fn event_new() -> SvcEvent {
    return SvcEvent { kind: EV_NONE, status: 0 as u32, name: rt.buf_new(), data: rt.buf_new() }
}

fn event_free(ev: *mut SvcEvent) {
    rt.buf_free(&(*ev).name)
    rt.buf_free(&(*ev).data)
    (*ev).kind = EV_NONE
}

fn next(ev: *mut SvcEvent) -> bool {
    event_free(ev)
    (*ev).name = rt.buf_new()
    (*ev).data = rt.buf_new()
    return svcq.next(&(*ev).kind, &(*ev).status, &(*ev).name, &(*ev).data)
}

fn pending() -> usize {
    return svcq.pending()
}

fn open_request(title: str, filters: str) -> bool {
    if G_MEMORY {
        return svcmem.pick_open()
    }
    return svcplat.pick_open(title, filters)
}

fn save_request(title: str, name: str, p: u64, n: usize) -> bool {
    if G_MEMORY {
        return svcmem.pick_save(name, p, n)
    }
    return svcplat.pick_save(title, name, SAVE_MIME, p, n)
}

fn read_path(path: str, out: *mut rt.Buf) -> bool {
    if G_MEMORY {
        return svcmem.read_path(path, out)
    }
    return svcfile.read_path(path, out)
}

fn write_path(path: str, p: u64, n: usize) -> bool {
    if G_MEMORY {
        return svcmem.write_path(path, p, n)
    }
    return svcfile.write_path(path, p, n)
}

fn clip_copy(text: str) -> bool {
    if G_MEMORY {
        return svcmem.clip_copy(text)
    }
    return svcsys.clip_copy(text)
}

fn clip_request() -> bool {
    if G_MEMORY {
        return svcmem.clip_request()
    }
    return svcplat.clip_request()
}

fn message(kind: i32, title: str, text: str, buttons: i32) -> i32 {
    if G_MEMORY {
        return svcmem.answer()
    }
    return svcsys.message(kind, title, text, buttons)
}

fn confirm(title: str, text: str) -> bool {
    if G_MEMORY {
        return svcmem.answer() == ANS_YES
    }
    return svcsys.confirm(title, text)
}

fn store_get(key: str, out: *mut rt.Buf) -> bool {
    if G_MEMORY {
        return svcmem.store_get(key, out)
    }
    return svcplat.store_get(key, out)
}

fn store_set(key: str, p: u64, n: usize) -> bool {
    if G_MEMORY {
        return svcmem.store_set(key, p, n)
    }
    return svcplat.store_set(key, p, n)
}
