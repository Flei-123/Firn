import std.rt
import fui.ds_look
import fui.editor
import fui.kit
import fui.kitapp
import fui.kitform
import fui.kitpopup
import fui.lucide
import fui.painter
import fui.render
import fui.screenanim
import fui.screenax
import fui.style
import fui.widget
import plat.fuiwirt

const NONE: usize = 18446744073709551615
const CAP: usize = 48
const K_PLAIN: u32 = 1
const K_CHEVRON: u32 = 2
const K_TOGGLE: u32 = 3
const K_VALUE: u32 = 4
const K_COMBO: u32 = 5
const K_SLIDER: u32 = 6
const K_BUTTON: u32 = 7
const K_GROUP: u32 = 8
const TOGGLE_CHANNEL: u32 = 933
const TOGGLE_MS: i64 = 140

struct Panel {
    v: [i64; 48],
    lo: [i64; 48],
    hi: [i64; 48],
    k: [u32; 48],
    off: [u32; 48],
    ex: [u32; 48],
    o: [u64; 48],
    on: [usize; 48],
    reg: [usize; 48],
    r: [f64; 192],
    b: [f64; 192],
    n: usize,
    foc: usize,
    kbd: bool,
    open: usize,
    mi: usize,
    down: usize,
    drag: usize,
    fired: usize,
    group: usize,
    skip: bool,
    gy: f64,
    gh: f64,
    gbody: f64,
    x: f64,
    y: f64,
    w: f64,
    cx: f64,
    cy: f64,
    px: f64,
    py: f64,
    rev: u64,
    ctx: u64,
}

fn panel_new() -> *mut Panel {
    let p: *mut Panel = rt.heap_alloc(1 << 14) as *mut Panel
    var i: usize = 0
    while i < CAP {
        (*p).v[i] = 0
        (*p).lo[i] = 0
        (*p).hi[i] = 100
        (*p).k[i] = 0 as u32
        (*p).off[i] = 0 as u32
        (*p).ex[i] = 0 as u32
        (*p).o[i] = 0
        (*p).on[i] = 0
        (*p).reg[i] = 0
        i = i + 1
    }
    i = 0
    while i < CAP * 4 {
        (*p).r[i] = 0.0
        (*p).b[i] = 0.0
        i = i + 1
    }
    (*p).n = 0
    (*p).foc = NONE
    (*p).kbd = false
    (*p).open = NONE
    (*p).mi = NONE
    (*p).down = NONE
    (*p).drag = NONE
    (*p).fired = NONE
    (*p).group = NONE
    (*p).skip = false
    (*p).gy = 0.0
    (*p).gh = 0.0
    (*p).gbody = 0.0
    (*p).rev = 0
    (*p).ctx = 0
    (*p).px = 0.0 - 1.0
    (*p).py = 0.0 - 1.0
    return p
}

fn val(p: *mut Panel, id: usize) -> i64 { return (*p).v[id] }

fn set_val(p: *mut Panel, id: usize, v: i64) { (*p).v[id] = v }

fn revision(p: *mut Panel) -> u64 { return (*p).rev }

fn set_enabled(p: *mut Panel, id: usize, on: bool) {
    (*p).off[id] = 1 as u32
    if on { (*p).off[id] = 0 as u32 }
    if !on && (*p).open == id { (*p).open = NONE }
}

fn enabled(p: *mut Panel, id: usize) -> bool { return (*p).off[id] == 0 as u32 }

fn expanded(p: *mut Panel, id: usize) -> bool { return (*p).ex[id] != 0 as u32 }

fn set_expanded(p: *mut Panel, id: usize, on: bool) {
    (*p).ex[id] = 0 as u32
    if on { (*p).ex[id] = 1 as u32 }
}

fn begin(p: *mut Panel, c: *mut render.Ctx, x: f64, y: f64, w: f64, px: f64, py: f64) {
    (*p).x = x
    (*p).y = y
    (*p).w = w
    (*p).px = px
    (*p).py = py
    (*p).n = 0
    (*p).group = NONE
    (*p).skip = false
    (*p).ctx = c as u64
}

fn y_end(p: *mut Panel) -> f64 { return (*p).y }

fn advance(p: *mut Panel, dy: f64) { (*p).y = (*p).y + dy }

fn body_height(c: *mut render.Ctx, plain: usize, with_sub: usize) -> f64 {
    return ds_look.row_height(c, false) * (plain as f64) + ds_look.row_height(c, true) * (with_sub as f64)
}

fn inside_rect(p: *mut Panel, arr: bool, id: usize, x: f64, y: f64) -> bool {
    if arr {
        return ds_look.inside(x, y, (*p).r[id * 4], (*p).r[id * 4 + 1], (*p).r[id * 4 + 2], (*p).r[id * 4 + 3])
    }
    return ds_look.inside(x, y, (*p).b[id * 4], (*p).b[id * 4 + 1], (*p).b[id * 4 + 2], (*p).b[id * 4 + 3])
}

fn reg_add(p: *mut Panel, id: usize, kind: u32, x: f64, y: f64, w: f64, h: f64) {
    (*p).k[id] = kind
    (*p).r[id * 4] = x
    (*p).r[id * 4 + 1] = y
    (*p).r[id * 4 + 2] = w
    (*p).r[id * 4 + 3] = h
    (*p).b[id * 4] = x
    (*p).b[id * 4 + 1] = y
    (*p).b[id * 4 + 2] = w
    (*p).b[id * 4 + 3] = h
    if (*p).n < CAP {
        (*p).reg[(*p).n] = id
        (*p).n = (*p).n + 1
    }
}

fn ctl(p: *mut Panel, id: usize, x: f64, y: f64, w: f64, h: f64) {
    (*p).b[id * 4] = x
    (*p).b[id * 4 + 1] = y
    (*p).b[id * 4 + 2] = w
    (*p).b[id * 4 + 3] = h
}

fn row_wide(kind: u32, chevron: bool) -> bool {
    if kind == K_BUTTON || kind == K_SLIDER { return false }
    if kind == K_VALUE { return chevron }
    return true
}

fn ax_kind(kind: u32) -> u32 {
    if kind == K_TOGGLE { return widget.KIND_TOGGLE }
    if kind == K_COMBO { return widget.KIND_DROPDOWN }
    if kind == K_SLIDER { return widget.KIND_SLIDER }
    if kind == K_VALUE { return widget.KIND_LABEL }
    return widget.KIND_BUTTON
}

fn permille(p: *mut Panel, id: usize) -> i64 {
    if (*p).hi[id] <= (*p).lo[id] { return 0 }
    return ((*p).v[id] - (*p).lo[id]) * 1000 / ((*p).hi[id] - (*p).lo[id])
}

fn ax_value(p: *mut Panel, id: usize, kind: u32) -> i64 {
    if kind == K_SLIDER { return permille(p, id) }
    if kind == K_GROUP { return (*p).ex[id] as i64 }
    return (*p).v[id]
}

fn ax_state(p: *mut Panel, id: usize, kind: u32) -> u32 {
    var st: u32 = 0 as u32
    if (*p).off[id] != 0 as u32 { st = st | screenax.F_DISABLED }
    if (*p).foc == id && (*p).kbd { st = st | screenax.F_FOCUS }
    if kind == K_TOGGLE && (*p).v[id] != 0 { st = st | screenax.F_CHECKED }
    if kind == K_GROUP && (*p).ex[id] != 0 as u32 { st = st | screenax.F_CHECKED }
    return st
}

fn frame(p: *mut Panel, c: *mut render.Ctx, id: usize, kind: u32, icon: i64, title: str, sub: str, cw: f64, ch: f64, chevron: bool) -> bool {
    if (*p).skip { return false }
    let child: bool = (*p).group != NONE && kind != K_GROUP
    let rh: f64 = ds_look.row_height(c, sub.n > 0)
    let x: f64 = (*p).x
    let y: f64 = (*p).y
    let w: f64 = (*p).w
    let off: bool = (*p).off[id] != 0 as u32
    let pad: f64 = ds_look.pad(c)
    reg_add(p, id, kind, x, y, w, rh)
    if kind != K_GROUP {
        if child { ds_look.separator(c, x, y, w) } else { ds_look.card(c, x, y, w, rh) }
    }
    let hov: bool = !off && row_wide(kind, chevron) && (*p).open == NONE && ds_look.inside((*p).px, (*p).py, x, y, w, rh)
    var rr: f64 = ds_look.radius(c)
    var ix: f64 = x
    var iy: f64 = y
    var iw: f64 = w
    var ih: f64 = rh
    if child || (kind == K_GROUP && (*p).ex[id] != 0 as u32) {
        let inset: f64 = kit.ln(c, 2)
        rr = ds_look.radius_small(c)
        ix = x + inset
        iy = y + inset
        iw = w - inset * 2.0
        ih = rh - inset * 2.0
    }
    if hov && (*p).down == id {
        ds_look.fill(c, ix, iy, iw, ih, rr, ds_look.pressed_bg(c))
    } else {
        ds_look.overlay(c, ix, iy, iw, ih, rr, ds_look.hover_bg(c), ds_look.hover_level(c, x, y, hov))
    }
    var tx: f64 = x + pad
    var tcol: u32 = ds_look.fg(c)
    var scol: u32 = ds_look.fg_muted(c)
    if off {
        tcol = ds_look.fg_disabled(c)
        scol = ds_look.fg_disabled(c)
    }
    if icon >= 0 as i64 {
        let g: f64 = ds_look.glyph_size(c)
        ds_look.glyph(c, icon, tx, y + (rh - g) / 2.0, g, tcol)
        tx = tx + g + ds_look.gap(c)
    }
    let cx: f64 = x + w - pad - cw
    (*p).cx = cx
    (*p).cy = y + (rh - ch) / 2.0
    var room: f64 = cx - ds_look.gap(c) - tx
    if room < 0.0 { room = 0.0 }
    if sub.n > 0 {
        ds_look.label(c, tx, y + rh / 2.0 - kit.ln(c, 20), kit.ln(c, 20), 14, 400, tcol, title, room)
        ds_look.label(c, tx, y + rh / 2.0, kit.ln(c, 18), 12, 400, scol, sub, room)
    } else {
        ds_look.label(c, tx, y, rh, 14, 400, tcol, title, room)
    }
    ctl(p, id, cx, (*p).cy, cw, ch)
    if (*p).foc == id && (*p).kbd {
        ds_look.focus(c, ix, iy, iw, ih, rr)
    }
    if sub.n > 0 {
        screenax.note_join(ax_kind(kind), ax_state(p, id, kind), title, sub, x, y, w, rh, ax_value(p, id, kind))
    } else {
        screenax.note(ax_kind(kind), ax_state(p, id, kind), title, x, y, w, rh, ax_value(p, id, kind))
    }
    if kind == K_SLIDER {
        screenax.bind_last(p as u64, id as u64)
        screenax.set_num_handler(ax_num)
    }
    (*p).y = y + rh
    if (*p).group == NONE && kind != K_GROUP { (*p).y = (*p).y + ds_look.row_gap(c) }
    return hov
}

fn ax_num(own: u64, aux: u64, permille_v: i64) -> bool {
    let p: *mut Panel = own as *mut Panel
    let id: usize = aux as usize
    if id >= CAP || (*p).k[id] != K_SLIDER || (*p).off[id] != 0 as u32 { return false }
    clamp_set(p, id, (*p).lo[id] + (((*p).hi[id] - (*p).lo[id]) * permille_v + 500) / 1000)
    return true
}

fn row_plain(p: *mut Panel, c: *mut render.Ctx, id: usize, icon: i64, title: str, sub: str) {
    frame(p, c, id, K_PLAIN, icon, title, sub, 0.0, ds_look.glyph_small(c), false)
}

fn chevron_at(p: *mut Panel, c: *mut render.Ctx, id: usize, x: f64, y: f64) {
    var col: u32 = ds_look.fg_muted(c)
    if (*p).off[id] != 0 as u32 { col = ds_look.fg_disabled(c) }
    let g: f64 = ds_look.glyph_small(c)
    ds_look.glyph(c, lucide.CHEVRON_RIGHT, x, y, g, col)
}

fn row_chevron(p: *mut Panel, c: *mut render.Ctx, id: usize, icon: i64, title: str, sub: str) {
    let g: f64 = ds_look.glyph_small(c)
    frame(p, c, id, K_CHEVRON, icon, title, sub, g, g, false)
    if (*p).skip { return }
    chevron_at(p, c, id, (*p).cx, (*p).cy)
}

fn row_value(p: *mut Panel, c: *mut render.Ctx, id: usize, icon: i64, title: str, sub: str, value: str, chevron: bool) {
    var vw: f64 = ds_look.label_width(c, 14, 400, value)
    var cap: f64 = (*p).w * 0.4
    if vw > cap { vw = cap }
    var cw: f64 = vw
    let g: f64 = ds_look.glyph_small(c)
    if chevron { cw = cw + ds_look.gap(c) + g }
    (*p).lo[id] = 0
    if chevron { (*p).lo[id] = 1 }
    frame(p, c, id, K_VALUE, icon, title, sub, cw, g, chevron)
    if (*p).skip { return }
    var col: u32 = ds_look.fg_muted(c)
    if (*p).off[id] != 0 as u32 { col = ds_look.fg_disabled(c) }
    ds_look.label(c, (*p).cx, (*p).cy - (kit.ln(c, 20) - g) / 2.0, kit.ln(c, 20), 14, 400, col, value, vw + 2.0)
    if chevron { chevron_at(p, c, id, (*p).cx + vw + ds_look.gap(c), (*p).cy) }
}

fn row_toggle(p: *mut Panel, c: *mut render.Ctx, id: usize, icon: i64, title: str, sub: str) {
    let tw: f64 = kit.ln(c, 42)
    let th: f64 = kit.ln(c, 24)
    frame(p, c, id, K_TOGGLE, icon, title, sub, tw, th, false)
    if (*p).skip { return }
    let x: f64 = (*p).cx
    let y: f64 = (*p).cy
    let z: *mut painter.Painter = render.ctx_painter(c)
    let off: bool = (*p).off[id] != 0 as u32
    let t: f64 = screenanim.level(c, x, y, TOGGLE_CHANNEL, (*p).v[id] != 0, TOGGLE_MS)
    let rest: u32 = kit.tokc(c, style.TOK_BUTTON)
    var on_col: u32 = kit.tokc(c, style.TOK_ACCENT)
    var knob_off: u32 = kit.tokc(c, style.TOK_TEXT_MUTED)
    var knob_on: u32 = 0xFFFFFFFF as u32
    if off {
        on_col = kit.tokc(c, style.TOK_TEXT_DISABLED)
        knob_off = kit.tokc(c, style.TOK_TEXT_DISABLED)
        knob_on = kit.tokc(c, style.TOK_SURFACE)
    }
    let track: u32 = screenanim.mix(c, rest, on_col, t)
    let knob: u32 = screenanim.mix(c, knob_off, knob_on, t)
    if t < 1.0 { painter.round_ring(z, x, y, tw, th, th / 2.0, kit.ln(c, 1), kit.tokc(c, style.TOK_BORDER)) }
    painter.round_rect(z, x, y, tw, th, th / 2.0, track)
    painter.round_rect(z, x + kit.ln(c, 3) + kit.ln(c, 18) * t, y + kit.ln(c, 3), kit.ln(c, 18), kit.ln(c, 18), kit.ln(c, 9), knob)
}

fn combo_width(p: *mut Panel, c: *mut render.Ctx) -> f64 {
    let room: f64 = ((*p).w - kit.ln(c, 40)) * 0.45
    let want: f64 = kit.ln(c, 200)
    if want < room { return want }
    return room
}

fn row_combo(p: *mut Panel, c: *mut render.Ctx, id: usize, icon: i64, title: str, sub: str, list: str) {
    (*p).o[id] = list.p as u64
    (*p).on[id] = list.n
    let cw: f64 = combo_width(p, c)
    let ch: f64 = kit.ln(c, 32)
    let hov: bool = frame(p, c, id, K_COMBO, icon, title, sub, cw, ch, false)
    if (*p).skip { return }
    let x: f64 = (*p).cx
    let y: f64 = (*p).cy
    let off: bool = (*p).off[id] != 0 as u32
    let hot: bool = hov || (*p).open == id
    var fill: u32 = kit.tokc(c, style.TOK_BUTTON)
    if hot { fill = kit.tokc(c, style.TOK_BUTTON_HOVER) }
    var tcol: u32 = ds_look.fg(c)
    if off {
        fill = kit.tokc(c, style.TOK_BUTTON)
        tcol = ds_look.fg_disabled(c)
    }
    let r: f64 = ds_look.radius_small(c)
    ds_look.fill(c, x, y, cw, ch, r, fill)
    ds_look.ring(c, x, y, cw, ch, r, ds_look.card_line(c))
    ds_look.label(c, x + ds_look.gap(c), y, ch, 14, 400, tcol, kitform.nth(list, (*p).v[id] as usize), cw - ds_look.gap(c) - kit.ln(c, 32))
    let g: f64 = kit.ln(c, 14)
    ds_look.glyph(c, lucide.CHEVRON_DOWN, x + cw - ds_look.gap(c) - g, y + (ch - g) / 2.0, g, ds_look.fg_muted(c))
}

fn value_text(v: i64, unit: str, buf: *mut [u8; 40]) -> usize {
    var d: [u8; 24] = [0 as u8; 24]
    var n: usize = 0
    if v < 0 {
        (*buf)[0] = 45 as u8
        n = 1
    }
    var m: u64 = v as u64
    if v < 0 { m = (0 - v) as u64 }
    let len: usize = kit.fmt_uint(m, &d)
    var i: usize = 0
    while i < len { (*buf)[n + i] = d[i]; i = i + 1 }
    n = n + len
    if unit.n > 0 {
        (*buf)[n] = 32 as u8
        n = n + 1
        i = 0
        while i < unit.n && n < 39 { (*buf)[n] = rt.ld8(unit.p as u64, i); n = n + 1; i = i + 1 }
    }
    return n
}

#[allow_escape]
fn row_slider(p: *mut Panel, c: *mut render.Ctx, id: usize, icon: i64, title: str, sub: str, lo: i64, hi: i64, unit: str) {
    (*p).lo[id] = lo
    (*p).hi[id] = hi
    let vw: f64 = kit.ln(c, 64)
    var sw: f64 = kit.ln(c, 160)
    if (*p).w < kit.ln(c, 480) { sw = kit.ln(c, 96) }
    let ch: f64 = kit.ln(c, 24)
    frame(p, c, id, K_SLIDER, icon, title, sub, vw + ds_look.gap(c) + sw, ch, false)
    if (*p).skip { return }
    let sx: f64 = (*p).cx + vw + ds_look.gap(c)
    let sy: f64 = (*p).cy
    ctl(p, id, sx, sy, sw, ch)
    var buf: [u8; 40] = [0 as u8; 40]
    let n: usize = value_text((*p).v[id], unit, &buf)
    var vcol: u32 = ds_look.fg_muted(c)
    let off: bool = (*p).off[id] != 0 as u32
    if off { vcol = ds_look.fg_disabled(c) }
    ds_look.label(c, (*p).cx, sy, ch, 14, 400, vcol, str { p: ((&buf[0]) as u64) as *mut u8, n: n }, vw)
    let hot: bool = !off && ds_look.inside((*p).px, (*p).py, sx - kit.ln(c, 8), sy - kit.ln(c, 4), sw + kit.ln(c, 16), ch + kit.ln(c, 8))
    if off {
        let z: *mut painter.Painter = render.ctx_painter(c)
        let th: f64 = kit.ln(c, 6)
        let ty: f64 = sy + kit.ln(c, 9)
        let kx: f64 = sx + (sw - kit.ln(c, 18)) * (permille(p, id) as f64) / 1000.0
        painter.round_rect(z, sx, ty, sw, th, th / 2.0, kit.tokc(c, style.TOK_BUTTON))
        painter.round_rect(z, kx, ty - kit.ln(c, 6), kit.ln(c, 18), kit.ln(c, 18), kit.ln(c, 9), kit.tokc(c, style.TOK_TEXT_DISABLED))
    } else {
        kitapp.slider_hot_draw(c, sx, sy + kit.ln(c, 9), sw, permille(p, id), hot)
    }
}

fn row_button(p: *mut Panel, c: *mut render.Ctx, id: usize, icon: i64, title: str, sub: str, label: str) {
    let bh: f64 = kit.ln(c, 32)
    var bw: f64 = ds_look.label_width(c, 14, 400, label) + ds_look.gap(c) * 2.0
    if bw < kit.ln(c, 72) { bw = kit.ln(c, 72) }
    frame(p, c, id, K_BUTTON, icon, title, sub, bw, bh, false)
    if (*p).skip { return }
    let x: f64 = (*p).cx
    let y: f64 = (*p).cy
    let off: bool = (*p).off[id] != 0 as u32
    let hov: bool = !off && (*p).open == NONE && inside_rect(p, false, id, (*p).px, (*p).py)
    var fill: u32 = kit.tokc(c, style.TOK_BUTTON)
    if hov && (*p).down == id {
        fill = kit.tokc(c, style.TOK_BUTTON_ACTIVE)
    } else if hov {
        fill = kit.tokc(c, style.TOK_BUTTON_HOVER)
    }
    var tcol: u32 = ds_look.fg(c)
    if off { tcol = ds_look.fg_disabled(c) }
    let r: f64 = ds_look.radius_small(c)
    ds_look.fill(c, x, y, bw, bh, r, fill)
    ds_look.ring(c, x, y, bw, bh, r, ds_look.card_line(c))
    let lw: f64 = ds_look.label_width(c, 14, 400, label)
    var lx: f64 = x + (bw - lw) / 2.0
    if lx < x + kit.ln(c, 4) { lx = x + kit.ln(c, 4) }
    ds_look.label(c, lx, y, bh, 14, 400, tcol, label, bw - kit.ln(c, 8))
}

fn group_begin(p: *mut Panel, c: *mut render.Ctx, id: usize, icon: i64, title: str, sub: str, body_h: f64) -> bool {
    (*p).group = NONE
    (*p).skip = false
    let open: bool = (*p).ex[id] != 0 as u32
    let head: f64 = ds_look.row_height(c, sub.n > 0)
    var total: f64 = head
    if open { total = head + body_h }
    (*p).gy = (*p).y
    (*p).gh = total
    (*p).gbody = body_h
    ds_look.card(c, (*p).x, (*p).y, (*p).w, total)
    let g: f64 = ds_look.glyph_small(c)
    frame(p, c, id, K_GROUP, icon, title, sub, g, g, false)
    var chev: i64 = lucide.CHEVRON_DOWN
    if open { chev = lucide.CHEVRON_UP }
    var col: u32 = ds_look.fg_muted(c)
    if (*p).off[id] != 0 as u32 { col = ds_look.fg_disabled(c) }
    ds_look.glyph(c, chev, (*p).cx, (*p).cy, g, col)
    (*p).group = id
    (*p).skip = !open
    (*p).y = (*p).gy + head
    return open
}

fn group_end(p: *mut Panel, c: *mut render.Ctx) {
    if (*p).group == NONE { return }
    (*p).y = (*p).gy + (*p).gh + ds_look.row_gap(c)
    (*p).group = NONE
    (*p).skip = false
}

fn draw_end(p: *mut Panel, c: *mut render.Ctx) {
    let id: usize = (*p).open
    if id == NONE { return }
    var px: f64 = (*p).px
    var py: f64 = (*p).py
    if (*p).mi != NONE {
        var q: [f64; 4] = [0.0; 4]
        item_rect(p, c, id, (*p).mi, &q)
        px = q[0] + q[2] / 2.0
        py = q[1] + q[3] / 2.0
    }
    kitpopup.draw(c, (*p).b[id * 4], (*p).b[id * 4 + 1], (*p).b[id * 4 + 2], (*p).b[id * 4 + 3], opts(p, id), (*p).v[id], px, py)
}

fn end(p: *mut Panel, c: *mut render.Ctx) {
    group_end(p, c)
    draw_end(p, c)
}

fn opts(p: *mut Panel, id: usize) -> str {
    return str { p: (*p).o[id] as *mut u8, n: (*p).on[id] }
}

fn item_rect(p: *mut Panel, c: *mut render.Ctx, id: usize, i: usize, out: *mut [f64; 4]) {
    kitpopup.item_rect(c, (*p).b[id * 4], (*p).b[id * 4 + 1], (*p).b[id * 4 + 2], (*p).b[id * 4 + 3], kitform.parts(opts(p, id)), i, out)
}

fn put(p: *mut Panel, id: usize, v: i64) {
    if (*p).v[id] != v {
        (*p).v[id] = v
        (*p).rev = (*p).rev + 1
    }
}

fn clamp_set(p: *mut Panel, id: usize, v: i64) {
    var x: i64 = v
    if x < (*p).lo[id] { x = (*p).lo[id] }
    if x > (*p).hi[id] { x = (*p).hi[id] }
    put(p, id, x)
}

fn slider_at(p: *mut Panel, id: usize, x: f64) {
    let c: *mut render.Ctx = (*p).ctx as *mut render.Ctx
    let m: f64 = kit.ln(c, 9)
    var t: f64 = (x - (*p).b[id * 4] - m) / ((*p).b[id * 4 + 2] - m * 2.0)
    if t < 0.0 { t = 0.0 }
    if t > 1.0 { t = 1.0 }
    clamp_set(p, id, (*p).lo[id] + (((*p).hi[id] - (*p).lo[id]) as f64 * t + 0.5) as i64)
}

fn pointer(p: *mut Panel, kind: u32, x: f64, y: f64) -> bool {
    if (*p).drag == NONE { return false }
    if kind == fuiwirt.HOOK_MOVE {
        slider_at(p, (*p).drag, x)
        return true
    }
    if kind == fuiwirt.HOOK_UP {
        slider_at(p, (*p).drag, x)
        (*p).drag = NONE
        return true
    }
    return false
}

fn dragging(p: *mut Panel) -> bool { return (*p).drag != NONE }

fn hit_row(p: *mut Panel, x: f64, y: f64) -> usize {
    var i: usize = 0
    while i < (*p).n {
        let id: usize = (*p).reg[i]
        i = i + 1
        if !inside_rect(p, true, id, x, y) { continue }
        let kind: u32 = (*p).k[id]
        if kind == K_VALUE && (*p).lo[id] == 0 { return NONE }
        if kind == K_BUTTON || kind == K_SLIDER {
            if !inside_rect(p, false, id, x, y) { return NONE }
        }
        return id
    }
    return NONE
}

fn press(p: *mut Panel, x: f64, y: f64) -> usize {
    let c: *mut render.Ctx = (*p).ctx as *mut render.Ctx
    (*p).down = NONE
    (*p).kbd = false
    if (*p).open != NONE {
        let id: usize = (*p).open
        (*p).open = NONE
        (*p).mi = NONE
        let m: usize = kitpopup.hit(c, (*p).b[id * 4], (*p).b[id * 4 + 1], (*p).b[id * 4 + 2], (*p).b[id * 4 + 3], opts(p, id), x, y)
        if m != kitpopup.NONE {
            put(p, id, m as i64)
            return id
        }
        if inside_rect(p, true, id, x, y) { return id }
    }
    let id: usize = hit_row(p, x, y)
    if id == NONE {
        (*p).foc = NONE
        return NONE
    }
    if (*p).off[id] != 0 as u32 { return NONE }
    (*p).foc = id
    (*p).down = id
    if (*p).k[id] == K_SLIDER {
        (*p).drag = id
        (*p).down = NONE
        slider_at(p, id, x)
    }
    return NONE
}

fn activate(p: *mut Panel, id: usize) {
    let kind: u32 = (*p).k[id]
    if kind == K_TOGGLE { put(p, id, 1 - (*p).v[id]) }
    if kind == K_COMBO {
        (*p).open = id
        (*p).mi = NONE
        (*p).rev = (*p).rev + 1
    }
    if kind == K_GROUP {
        if (*p).ex[id] != 0 as u32 { (*p).ex[id] = 0 as u32 } else { (*p).ex[id] = 1 as u32 }
        (*p).rev = (*p).rev + 1
    }
    if kind == K_PLAIN || kind == K_CHEVRON || kind == K_BUTTON || kind == K_VALUE {
        (*p).fired = id
        (*p).rev = (*p).rev + 1
    }
}

fn release(p: *mut Panel, x: f64, y: f64) -> usize {
    let d: usize = (*p).down
    (*p).down = NONE
    if d == NONE { return NONE }
    if hit_row(p, x, y) != d { return NONE }
    activate(p, d)
    return d
}

fn click(p: *mut Panel, x: f64, y: f64) -> usize {
    let a: usize = press(p, x, y)
    let b: usize = release(p, x, y)
    if a != NONE { return a }
    return b
}

fn fired(p: *mut Panel) -> usize {
    let f: usize = (*p).fired
    (*p).fired = NONE
    return f
}

fn focus_step(p: *mut Panel, back: bool) -> bool {
    if (*p).n == 0 { return false }
    var at: usize = NONE
    var i: usize = 0
    while i < (*p).n {
        if (*p).reg[i] == (*p).foc { at = i }
        i = i + 1
    }
    var k: usize = 0
    var s: usize = at
    if at == NONE {
        if back { s = 0 } else { s = (*p).n - 1 }
    }
    while k < (*p).n {
        if back {
            if s == 0 { s = (*p).n - 1 } else { s = s - 1 }
        } else {
            s = (s + 1) % (*p).n
        }
        if focusable(p, (*p).reg[s]) {
            (*p).open = NONE
            (*p).mi = NONE
            (*p).foc = (*p).reg[s]
            (*p).kbd = true
            return true
        }
        k = k + 1
    }
    return false
}

fn focusable(p: *mut Panel, id: usize) -> bool {
    if (*p).off[id] != 0 as u32 { return false }
    if (*p).k[id] == K_VALUE && (*p).lo[id] == 0 { return false }
    return true
}

fn step(p: *mut Panel, id: usize, d: i64) {
    let kind: u32 = (*p).k[id]
    if kind == K_SLIDER {
        var st: i64 = ((*p).hi[id] - (*p).lo[id]) / 20
        if st < 1 { st = 1 }
        clamp_set(p, id, (*p).v[id] + d * st)
    }
    if kind == K_COMBO {
        var m: i64 = (*p).v[id] + d
        let last: i64 = kitform.parts(opts(p, id)) as i64 - 1
        if m < 0 { m = 0 }
        if m > last { m = last }
        put(p, id, m)
    }
    if kind == K_TOGGLE { put(p, id, 1 - (*p).v[id]) }
    if kind == K_GROUP {
        if d > 0 { (*p).ex[id] = 1 as u32 } else { (*p).ex[id] = 0 as u32 }
        (*p).rev = (*p).rev + 1
    }
}

fn menu_move(p: *mut Panel, d: i64) {
    let last: i64 = kitform.parts(opts(p, (*p).open)) as i64 - 1
    var m: i64 = (*p).v[(*p).open]
    if (*p).mi != NONE { m = (*p).mi as i64 }
    m = m + d
    if m < 0 { m = 0 }
    if m > last { m = last }
    (*p).mi = m as usize
}

fn key(p: *mut Panel, k: u32, mods: u32) -> bool {
    if (*p).open != NONE {
        let id: usize = (*p).open
        if k == editor.KEY_ESC { (*p).open = NONE; (*p).mi = NONE; return true }
        if k == editor.KEY_DOWN { menu_move(p, 1); return true }
        if k == editor.KEY_UP { menu_move(p, 0 - 1); return true }
        if k == editor.KEY_ENTER {
            if (*p).mi != NONE { put(p, id, (*p).mi as i64) }
            (*p).open = NONE
            (*p).mi = NONE
            return true
        }
    }
    if k == editor.KEY_TAB { return focus_step(p, (mods & editor.MOD_SHIFT) != 0 as u32) }
    let id: usize = (*p).foc
    if id == NONE { return false }
    let kind: u32 = (*p).k[id]
    if k == editor.KEY_ENTER {
        activate(p, id)
        return true
    }
    if kind == K_SLIDER {
        if k == editor.KEY_HOME { put(p, id, (*p).lo[id]); return true }
        if k == editor.KEY_END { put(p, id, (*p).hi[id]); return true }
        if k == editor.KEY_PGUP { step(p, id, 5); return true }
        if k == editor.KEY_PGDN { step(p, id, 0 - 5); return true }
    }
    if k == editor.KEY_DOWN { return focus_step(p, false) }
    if k == editor.KEY_UP { return focus_step(p, true) }
    if k == editor.KEY_RIGHT && kind != K_PLAIN && kind != K_CHEVRON && kind != K_BUTTON && kind != K_VALUE {
        step(p, id, 1)
        return true
    }
    if k == editor.KEY_LEFT && kind != K_PLAIN && kind != K_CHEVRON && kind != K_BUTTON && kind != K_VALUE {
        step(p, id, 0 - 1)
        return true
    }
    return false
}

fn text(p: *mut Panel, cp: u32, mods: u32) -> bool {
    if cp == 32 as u32 { return key(p, editor.KEY_ENTER, mods) }
    return false
}

fn reset(p: *mut Panel) {
    (*p).foc = NONE
    (*p).open = NONE
    (*p).mi = NONE
    (*p).down = NONE
    (*p).drag = NONE
}

fn focus_id(p: *mut Panel) -> usize { return (*p).foc }

fn set_focus(p: *mut Panel, id: usize) {
    (*p).foc = id
    (*p).kbd = id != NONE
}

fn row_rect(p: *mut Panel, id: usize, out: *mut [f64; 4]) {
    (*out)[0] = (*p).r[id * 4]
    (*out)[1] = (*p).r[id * 4 + 1]
    (*out)[2] = (*p).r[id * 4 + 2]
    (*out)[3] = (*p).r[id * 4 + 3]
}

fn control_rect(p: *mut Panel, id: usize, out: *mut [f64; 4]) {
    (*out)[0] = (*p).b[id * 4]
    (*out)[1] = (*p).b[id * 4 + 1]
    (*out)[2] = (*p).b[id * 4 + 2]
    (*out)[3] = (*p).b[id * 4 + 3]
}

fn combo_open(p: *mut Panel) -> usize { return (*p).open }
