// SPDX-License-Identifier: MPL-2.0
import std.rt

export {
    Entry, Spec, MAXN, SORT_NAME, SORT_SIZE, SORT_DATE, blank_entry, sort_order, key_name, is_dir,
}

const MAXN: usize = 256
const SORT_NAME: u32 = 0
const SORT_SIZE: u32 = 1
const SORT_DATE: u32 = 2

struct Entry {
    name: str,
    id: i64,
    size: i64,
    modified: str,
    icon: i64,
}

struct Spec {
    ud: u64,
    title: str,
    places: str,
    place_nodes: [i64; 8],
    place_icons: [i64; 8],
    root: i64,
    parent: fn(u64, i64) -> i64,
    name_of: fn(u64, i64) -> str,
    count: fn(u64, i64) -> usize,
    entry: fn(u64, i64, usize, *mut Entry),
}

fn blank_entry() -> Entry {
    return Entry { name: "", id: 0 - 1, size: 0 as i64, modified: "", icon: 0 - 1 }
}

fn is_dir(e: *mut Entry) -> bool { return (*e).id >= 0 as i64 }

fn lower(b: u8) -> u8 {
    if b >= 65 as u8 && b <= 90 as u8 { return b + 32 as u8 }
    return b
}

fn cmp_str(a: str, b: str) -> i64 {
    var i: usize = 0
    while i < a.n && i < b.n {
        let x: u8 = lower(rt.ld8(a.p as u64, i))
        let y: u8 = lower(rt.ld8(b.p as u64, i))
        if x < y { return 0 - 1 }
        if x > y { return 1 }
        i = i + 1
    }
    if a.n < b.n { return 0 - 1 }
    if a.n > b.n { return 1 }
    return 0
}

fn key_name(k: u32) -> str {
    if k == SORT_SIZE { return "Size" }
    if k == SORT_DATE { return "Modified" }
    return "Name"
}

fn compare(a: *mut Entry, b: *mut Entry, key: u32, desc: bool) -> i64 {
    let da: bool = is_dir(a)
    let db: bool = is_dir(b)
    if da && !db { return 0 - 1 }
    if db && !da { return 1 }
    var r: i64 = 0
    if key == SORT_SIZE {
        if (*a).size < (*b).size { r = 0 - 1 } else if (*a).size > (*b).size { r = 1 }
    } else if key == SORT_DATE {
        r = cmp_str((*a).modified, (*b).modified)
    }
    if r == 0 { r = cmp_str((*a).name, (*b).name) }
    if desc { return 0 - r }
    return r
}

fn sort_order(es: *mut [Entry; 256], order: *mut [usize; 256], n: usize, key: u32, desc: bool) {
    var i: usize = 0
    while i < n {
        (*order)[i] = i
        i = i + 1
    }
    i = 1
    while i < n {
        let v: usize = (*order)[i]
        var j: usize = i
        while j > 0 && compare(&(*es)[(*order)[j - 1]], &(*es)[v], key, desc) > 0 {
            (*order)[j] = (*order)[j - 1]
            j = j - 1
        }
        (*order)[j] = v
        i = i + 1
    }
}
