// SPDX-License-Identifier: MPL-2.0
// lib/fui/svg.fi -- AN SVG ICON, READ AND FILLED.
//
// ========================================================= WHY IT EXISTS
//
// lib/fui/icon.fi has nine marks as compiled-in geometry, and that is
// right for a tick and a triangle: they must work in the kernel profile
// where there is no font and no file system (K1 in core.fi).
//
// But an APPLICATION icon -- a printer, a folder, a company logo -- is
// not going to be hand coded as Firn arithmetic. It arrives as SVG,
// because that is what every icon set on earth ships. Up to today fUi
// had no way to put one on a button.
//
// A raster PNG is the other answer and it is in lib/fui/image.fi, but it
// is the WRONG answer for an icon that has to be sharp at 16, 24, 32 and
// on a 2x display: that is four files, and one of them will be forgotten.
// A path scales exactly.
//
// ==================================== IT SITS ON WHAT IS ALREADY THERE
//
// NOTHING is rasterised here. lib/font/raster.fi is the scanline
// rasteriser Certus already paints every page and every glyph with, and
// it takes lines, quadratics and cubics with a non-zero/even-odd winding
// rule. painter.fi already drives it for the four round corners.
//
// So this file is a PARSER and a TRANSFORM STACK, nothing more. Every
// curve ends up in `raster_line` / `raster_quad` / `raster_cubic`, and
// the fill and the antialiasing are the same code that draws the text
// next to the icon. That is the reason an SVG icon and a button corner
// cannot drift apart in look.
//
// ============================================ WHY NOT lib/browser
//
// painter.fi says it in its own head: "fUi must not hang on an
// application library". lib/browser is the Certus front end -- it brings
// the DOM, CSS and the JS engine with it. An OrientOS control panel that
// wants a printer icon is not going to link a browser.
//
// The consequence is accepted and it is real: this is a SECOND, much
// smaller SVG reader next to whatever Certus does for `<svg>` in a page.
// They are not the same job. Certus needs the full standard inside a
// live DOM with CSS cascading into it; a button needs a path filled in
// one colour. The rule "no second place for the same thing" is about the
// DRAWING, and the drawing is shared -- both end in lib/font/raster.fi.
//
// ===================================================== WHAT IS TAKEN
//
// THE PATH COMMANDS, all of them, absolute and relative:
//   M m  moveto            L l  lineto
//   H h  horizontal        V v  vertical
//   C c  cubic             S s  smooth cubic
//   Q q  quadratic         T t  smooth quadratic
//   A a  elliptical arc    Z z  closepath
//
// THE ATTRIBUTES:
//   viewBox               (min-x min-y width height)
//   width / height        on <svg>, as a fallback when there is no viewBox
//   d                     on <path>
//   fill                  #rgb, #rrggbb, `none`, and the 16 HTML names
//   fill-rule             nonzero | evenodd
//   fill-opacity          0..1
//   stroke                same syntax as fill
//   stroke-width
//   opacity               on a group or a shape
//   transform             translate(...) scale(...) matrix(...)
//                         rotate(...) as well -- it is three lines once
//                         matrix() is there
//
// THE ELEMENTS:
//   <svg> <g> <path> <rect> <circle> <ellipse> <line> <polyline> <polygon>
//   <title> and <desc> are SKIPPED (they are text, not shape)
//
// ============================================= WHAT IS NOT TAKEN
//
// Named here because a silent gap is how a wrong picture ships. All of
// these are IGNORED, and an icon using one draws without that feature
// rather than not at all:
//
//   * GRADIENTS and PATTERNS (<linearGradient>, <radialGradient>,
//     <pattern>, fill="url(#x)"). A fill that is a url() is treated as
//     `none`. This is the biggest gap; material icons do not use them,
//     many logos do.
//   * <text> and <tspan>. An icon with live text needs the font stack,
//     and in the kernel profile there is no font at all. Convert it to a
//     path in the authoring tool.
//   * <use>, <symbol>, <defs> references, <clipPath>, <mask>, <filter>.
//   * CSS: <style> blocks, class= and any presentation attribute arriving
//     through a stylesheet. Only the attributes above, on the element.
//   * stroke-linecap, stroke-linejoin, stroke-dasharray, stroke-opacity,
//     miter limits. The stroke here is a CENTRED BUTT stroke of constant
//     width (see `stroke_seg`), which is what an icon outline needs and
//     no more.
//   * preserveAspectRatio. The fit is CONTAIN, always -- the aspect ratio
//     is kept and the drawing is centred (see `svg_draw`).
//   * Nested <svg>, <switch>, <foreignObject>, animation, scripting.
//
// ================================================ THE ARC IS THE TRAP
//
// `A` is the one command that is not a few additions: the SVG form gives
// the END POINT plus two radii, a rotation and two flags, and the CENTRE
// has to be worked out from them. The formulae are the ones in the SVG
// 1.1 specification, appendix F.6.5, and they are implemented in
// `arc_to` below including the F.6.6 radius correction -- an arc whose
// radii are too small for the distance is scaled up rather than dropped,
// which is what the specification demands and what every renderer does.
//
// Getting this wrong is not subtle: rounded-corner icons come out with
// straight corners or with loops. tools/fui/svg_main.fi therefore checks
// an arc-drawn quarter circle against a cubic-drawn one.
//
// =================================================== NO ALLOCATION
//
// The library is allocation-free (widget.fi E1) and this file keeps that
// promise: the SVG text belongs to the caller, and the only state is the
// transform stack, which is a fixed array in `Svg`. A document nested
// deeper than STACK groups is refused, not grown.
import paint.canvas
import font.raster
import fui.painter
import fui.theme

export {
    Svg, svg_new, svg_parse, svg_ok, svg_vb_w, svg_vb_h,
    svg_draw, svg_draw_fit, svg_shapes,
    RULE_NONZERO, RULE_EVENODD,
}

const RULE_NONZERO: u32 = 0
const RULE_EVENODD: u32 = 1

// How deep groups may nest. Sixteen is far past any real icon; a
// document deeper than this is refused rather than silently flattened.
const STACK: usize = 16

// A 2x3 affine transform, the same shape SVG's matrix() has:
//
//   x' = a*x + c*y + e
//   y' = b*x + d*y + f
struct Xf {
    a: f64, b: f64, c: f64, d: f64, e: f64, f: f64,
}

#[no_gc]
fn xf_id() -> Xf {
    return Xf { a: 1.0, b: 0.0, c: 0.0, d: 1.0, e: 0.0, f: 0.0 }
}

// `m` applied FIRST, then `n`. The order matters and this is the one SVG
// uses: a transform on a child is applied before its parent's.
#[no_gc]
fn xf_mul(n: Xf, m: Xf) -> Xf {
    return Xf {
        a: n.a * m.a + n.c * m.b,
        b: n.b * m.a + n.d * m.b,
        c: n.a * m.c + n.c * m.d,
        d: n.b * m.c + n.d * m.d,
        e: n.a * m.e + n.c * m.f + n.e,
        f: n.b * m.e + n.d * m.f + n.f,
    }
}

#[no_gc]
fn xf_x(t: *mut Xf, x: f64, y: f64) -> f64 {
    return (*t).a * x + (*t).c * y + (*t).e
}

#[no_gc]
fn xf_y(t: *mut Xf, x: f64, y: f64) -> f64 {
    return (*t).b * x + (*t).d * y + (*t).f
}

// The average scale of a transform -- for the stroke width, which is one
// number and cannot follow x and y separately.
#[no_gc]
fn xf_scale(t: *mut Xf) -> f64 {
    let sx: f64 = fsqrt((*t).a * (*t).a + (*t).b * (*t).b)
    let sy: f64 = fsqrt((*t).c * (*t).c + (*t).d * (*t).d)
    return (sx + sy) / 2.0
}

struct Svg {
    src: u64,
    n: usize,
    vb_x: f64,
    vb_y: f64,
    vb_w: f64,
    vb_h: f64,
    ok: usize,
    shapes: usize,   // how many shapes were drawn -- for the tests
}

#[no_gc]
fn svg_new() -> Svg {
    return Svg {
        src: 0, n: 0, vb_x: 0.0, vb_y: 0.0, vb_w: 0.0, vb_h: 0.0,
        ok: 0, shapes: 0,
    }
}

#[no_gc]
fn svg_ok(s: *mut Svg) -> bool { return (*s).ok != 0 }

#[no_gc]
fn svg_vb_w(s: *mut Svg) -> f64 { return (*s).vb_w }

#[no_gc]
fn svg_vb_h(s: *mut Svg) -> f64 { return (*s).vb_h }

#[no_gc]
fn svg_shapes(s: *mut Svg) -> usize { return (*s).shapes }

// ====================================================================
// ARITHMETIC
// ====================================================================

#[no_gc]
fn b8(p: u64, i: usize) -> u8 {
    return *((p + i as u64) as *mut u8)
}

#[no_gc]
fn fabs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

#[no_gc]
fn fsqrt(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    // Newton, from a halved exponent. Same approach as
    // lib/font/raster.fi -- there is no libm in the kernel profile.
    var r: f64 = x
    if r > 1.0 { r = x / 2.0 } else { r = 1.0 }
    var i: usize = 0
    while i < 40 {
        let n: f64 = (r + x / r) / 2.0
        if fabs(n - r) < 0.0000000001 { return n }
        r = n
        i = i + 1
    }
    return r
}

// sin/cos by range reduction plus the Taylor series. Only `rotate(...)`
// and the arc need them, so a small, honest implementation beats pulling
// a maths library into a UI file.
#[no_gc]
fn fsin(a0: f64) -> f64 {
    let PI2: f64 = 6.283185307179586
    var a: f64 = a0
    // reduce into -PI..PI
    while a > 3.141592653589793 { a = a - PI2 }
    while a < 0.0 - 3.141592653589793 { a = a + PI2 }
    var t: f64 = a
    var s: f64 = a
    var i: usize = 1
    while i < 12 {
        let k: f64 = (2 * i) as f64
        t = 0.0 - t * a * a / (k * (k + 1.0))
        s = s + t
        i = i + 1
    }
    return s
}

#[no_gc]
fn fcos(a: f64) -> f64 {
    return fsin(a + 1.5707963267948966)
}

#[no_gc]
fn facos(x0: f64) -> f64 {
    // Only used by the arc, where the argument is a clamped cosine.
    var x: f64 = x0
    if x > 1.0 { x = 1.0 }
    if x < 0.0 - 1.0 { x = 0.0 - 1.0 }
    // atan-free: acos(x) = atan2(sqrt(1-x^2), x), and here by bisection
    // on cos, which is monotone on 0..PI. Twenty-four steps give about
    // 1e-7 radians -- far under a pixel at any icon size.
    var lo: f64 = 0.0
    var hi: f64 = 3.141592653589793
    var i: usize = 0
    while i < 48 {
        let mid: f64 = (lo + hi) / 2.0
        if fcos(mid) > x { lo = mid } else { hi = mid }
        i = i + 1
    }
    return (lo + hi) / 2.0
}

// ====================================================================
// THE TEXT SCANNER
// ====================================================================

#[no_gc]
fn is_space(c: u8) -> bool {
    return c == 32 as u8 || c == 9 as u8 || c == 10 as u8
        || c == 13 as u8 || c == 12 as u8
}

#[no_gc]
fn is_digit(c: u8) -> bool {
    return c >= 48 as u8 && c <= 57 as u8
}

#[no_gc]
fn is_alpha(c: u8) -> bool {
    return (c >= 65 as u8 && c <= 90 as u8)
        || (c >= 97 as u8 && c <= 122 as u8)
}

// A number, SVG flavour: optional sign, digits, optional fraction,
// optional exponent. Leading separators (space and comma) are eaten.
#[no_gc]
fn num_at(p: u64, n: usize, i0: usize, out: *mut f64) -> usize {
    var i: usize = i0
    while i < n && (is_space(b8(p, i)) || b8(p, i) == 44 as u8) {
        i = i + 1
    }
    if i >= n { return i0 }
    var sign: f64 = 1.0
    if b8(p, i) == 45 as u8 {
        sign = 0.0 - 1.0
        i = i + 1
    } else if b8(p, i) == 43 as u8 {
        i = i + 1
    }
    var seen: bool = false
    var v: f64 = 0.0
    while i < n && is_digit(b8(p, i)) {
        v = v * 10.0 + ((b8(p, i) - 48 as u8) as f64)
        seen = true
        i = i + 1
    }
    if i < n && b8(p, i) == 46 as u8 {
        i = i + 1
        var f: f64 = 0.1
        while i < n && is_digit(b8(p, i)) {
            v = v + ((b8(p, i) - 48 as u8) as f64) * f
            f = f / 10.0
            seen = true
            i = i + 1
        }
    }
    if !seen { return i0 }
    if i < n && (b8(p, i) == 101 as u8 || b8(p, i) == 69 as u8) {
        var j: usize = i + 1
        var es: f64 = 1.0
        if j < n && b8(p, j) == 45 as u8 {
            es = 0.0 - 1.0
            j = j + 1
        } else if j < n && b8(p, j) == 43 as u8 {
            j = j + 1
        }
        var ev: f64 = 0.0
        var eseen: bool = false
        while j < n && is_digit(b8(p, j)) {
            ev = ev * 10.0 + ((b8(p, j) - 48 as u8) as f64)
            eseen = true
            j = j + 1
        }
        if eseen {
            i = j
            var k: f64 = 0.0
            while k < ev {
                if es > 0.0 { v = v * 10.0 } else { v = v / 10.0 }
                k = k + 1.0
            }
        }
    }
    *out = sign * v
    return i
}

// A flag for the arc: exactly one character, 0 or 1.
#[no_gc]
fn flag_at(p: u64, n: usize, i0: usize, out: *mut f64) -> usize {
    var i: usize = i0
    while i < n && (is_space(b8(p, i)) || b8(p, i) == 44 as u8) {
        i = i + 1
    }
    if i >= n { return i0 }
    if b8(p, i) == 48 as u8 {
        *out = 0.0
        return i + 1
    }
    if b8(p, i) == 49 as u8 {
        *out = 1.0
        return i + 1
    }
    return num_at(p, n, i0, out)
}

// Compare the `len` bytes at `i` with a literal, case sensitively.
#[no_gc]
fn eq_at(p: u64, n: usize, i: usize, lit: u64, len: usize) -> bool {
    if i + len > n { return false }
    var k: usize = 0
    while k < len {
        if b8(p, i + k) != b8(lit, k) { return false }
        k = k + 1
    }
    return true
}

// ====================================================================
// COLOUR
// ====================================================================
//
// `#rgb`, `#rrggbb`, `none`, `currentColor` and the sixteen HTML 4
// colour names. Anything else -- and that includes `url(#grad)` -- comes
// back as NOT VISIBLE, which is the honest answer: better an icon
// missing a fill than an icon in a guessed colour.
//
// The result is 0xAARRGGBB with alpha 255, or 0 for "no paint".
#[no_gc]
fn hexv(c: u8) -> i64 {
    if c >= 48 as u8 && c <= 57 as u8 { return (c - 48 as u8) as i64 }
    if c >= 97 as u8 && c <= 102 as u8 { return (c - 87 as u8) as i64 }
    if c >= 65 as u8 && c <= 70 as u8 { return (c - 55 as u8) as i64 }
    return 0 - 1
}

fn parse_color(p: u64, n: usize, i0: usize, len: usize,
    cur: u32) -> u32 {
    var i: usize = i0
    var e: usize = i0 + len
    while i < e && is_space(b8(p, i)) { i = i + 1 }
    while e > i && is_space(b8(p, e - 1)) { e = e - 1 }
    if e <= i { return 0 as u32 }
    if b8(p, i) == 35 as u8 {
        let d: usize = e - i - 1
        if d >= 6 {
            let r: i64 = hexv(b8(p, i + 1)) * 16 + hexv(b8(p, i + 2))
            let g: i64 = hexv(b8(p, i + 3)) * 16 + hexv(b8(p, i + 4))
            let b: i64 = hexv(b8(p, i + 5)) * 16 + hexv(b8(p, i + 6))
            if r < 0 || g < 0 || b < 0 { return 0 as u32 }
            return (255 as u32) << 24 | ((r as u32) << 16)
                | ((g as u32) << 8) | (b as u32)
        }
        if d >= 3 {
            let r: i64 = hexv(b8(p, i + 1))
            let g: i64 = hexv(b8(p, i + 2))
            let b: i64 = hexv(b8(p, i + 3))
            if r < 0 || g < 0 || b < 0 { return 0 as u32 }
            // #abc means #aabbcc
            return (255 as u32) << 24 | (((r * 17) as u32) << 16)
                | (((g * 17) as u32) << 8) | ((b * 17) as u32)
        }
        return 0 as u32
    }
    var lnone: [u8; 4] = "none"
    if eq_at(p, n, i, (&lnone[0]) as u64, 4) { return 0 as u32 }
    var lcur: [u8; 12] = "currentColor"
    if eq_at(p, n, i, (&lcur[0]) as u64, 12) { return cur }
    // The sixteen HTML 4 names. Enough for icon sets, and named in the
    // head as the limit.
    var k_black: [u8; 5] = "black"
    if eq_at(p, n, i, (&k_black[0]) as u64, 5) { return 4278190080 as u32 }
    var k_white: [u8; 5] = "white"
    if eq_at(p, n, i, (&k_white[0]) as u64, 5) { return 4294967295 as u32 }
    var k_red: [u8; 3] = "red"
    if eq_at(p, n, i, (&k_red[0]) as u64, 3) { return 4294901760 as u32 }
    var k_lime: [u8; 4] = "lime"
    if eq_at(p, n, i, (&k_lime[0]) as u64, 4) { return 4278255360 as u32 }
    var k_blue: [u8; 4] = "blue"
    if eq_at(p, n, i, (&k_blue[0]) as u64, 4) { return 4278190335 as u32 }
    var k_green: [u8; 5] = "green"
    if eq_at(p, n, i, (&k_green[0]) as u64, 5) { return 4278222848 as u32 }
    var k_silver: [u8; 6] = "silver"
    if eq_at(p, n, i, (&k_silver[0]) as u64, 6) { return 4290822336 as u32 }
    var k_gray: [u8; 4] = "gray"
    if eq_at(p, n, i, (&k_gray[0]) as u64, 4) { return 4286611584 as u32 }
    var k_maroon: [u8; 6] = "maroon"
    if eq_at(p, n, i, (&k_maroon[0]) as u64, 6) { return 4286578688 as u32 }
    var k_purple: [u8; 6] = "purple"
    if eq_at(p, n, i, (&k_purple[0]) as u64, 6) { return 4286578816 as u32 }
    var k_fuchsia: [u8; 7] = "fuchsia"
    if eq_at(p, n, i, (&k_fuchsia[0]) as u64, 7) { return 4294902015 as u32 }
    var k_olive: [u8; 5] = "olive"
    if eq_at(p, n, i, (&k_olive[0]) as u64, 5) { return 4286611456 as u32 }
    var k_yellow: [u8; 6] = "yellow"
    if eq_at(p, n, i, (&k_yellow[0]) as u64, 6) { return 4294967040 as u32 }
    var k_navy: [u8; 4] = "navy"
    if eq_at(p, n, i, (&k_navy[0]) as u64, 4) { return 4278190208 as u32 }
    var k_teal: [u8; 4] = "teal"
    if eq_at(p, n, i, (&k_teal[0]) as u64, 4) { return 4278222976 as u32 }
    var k_aqua: [u8; 4] = "aqua"
    if eq_at(p, n, i, (&k_aqua[0]) as u64, 4) { return 4278255615 as u32 }
    return 0 as u32
}

// ====================================================================
// THE PAINT STATE
// ====================================================================
//
// What a shape is painted with. Inherited down the group tree, which is
// why it is copied on the stack rather than pointed at.
struct Paint {
    fill: u32,
    stroke: u32,
    sw: f64,
    rule: u32,
    fill_set: usize,
    opacity: f64,
    fill_op: f64,
}

#[no_gc]
fn paint_root(cur: u32) -> Paint {
    // THE SVG DEFAULT IS BLACK FILL, NO STROKE. Not "nothing": an icon
    // whose <path> has no fill attribute at all is solid black, and a
    // reader that defaults to invisible draws an empty box.
    return Paint {
        fill: 4278190080 as u32, stroke: 0 as u32, sw: 1.0,
        rule: RULE_NONZERO, fill_set: 0, opacity: 1.0, fill_op: 1.0,
    }
}

// ====================================================================
// THE DRAW CONTEXT
// ====================================================================
//
// Everything the recursive walk needs, in one structure so the
// signatures stay short.
struct Dc {
    z: u64,          // *mut painter.Painter
    tint: u32,       // != 0: paint everything in this colour
    xs: [f64; 96],   // the transform stack, six numbers per level
    depth: usize,
}

#[no_gc]
fn dc_xf(d: *mut Dc, lvl: usize) -> Xf {
    let o: usize = lvl * 6
    return Xf {
        a: (*d).xs[o], b: (*d).xs[o + 1], c: (*d).xs[o + 2],
        d: (*d).xs[o + 3], e: (*d).xs[o + 4], f: (*d).xs[o + 5],
    }
}

#[no_gc]
fn dc_set(d: *mut Dc, lvl: usize, t: Xf) {
    let o: usize = lvl * 6
    (*d).xs[o] = t.a
    (*d).xs[o + 1] = t.b
    (*d).xs[o + 2] = t.c
    (*d).xs[o + 3] = t.d
    (*d).xs[o + 4] = t.e
    (*d).xs[o + 5] = t.f
}

// ====================================================================
// THE PATH BUILDER
// ====================================================================
//
// Feeds the rasteriser. Holds the current point, the start of the
// subpath (for Z) and the last control point (for S and T), all in USER
// space -- the transform is applied on the way into the rasteriser, so
// that a relative command after a transform still means the right thing.
struct Pb {
    ra: u64,       // *mut raster.Raster
    t: Xf,
    cx: f64, cy: f64,     // current point, user space
    sx: f64, sy: f64,     // start of subpath
    lx: f64, ly: f64,     // last control point, user space
    have: usize,
    open: usize,
}

fn pb_move(b: *mut Pb, x: f64, y: f64) {
    if (*b).open != 0 {
        pb_close(b)
    }
    (*b).cx = x
    (*b).cy = y
    (*b).sx = x
    (*b).sy = y
    (*b).lx = x
    (*b).ly = y
    (*b).have = 1
    (*b).open = 1
}

fn pb_line(b: *mut Pb, x: f64, y: f64) {
    if (*b).have == 0 { return }
    let ra: *mut raster.Raster = (*b).ra as *mut raster.Raster
    raster.raster_line(ra, xf_x(&(*b).t, (*b).cx, (*b).cy),
        xf_y(&(*b).t, (*b).cx, (*b).cy),
        xf_x(&(*b).t, x, y), xf_y(&(*b).t, x, y))
    (*b).cx = x
    (*b).cy = y
    (*b).lx = x
    (*b).ly = y
}

fn pb_cubic(b: *mut Pb, c1x: f64, c1y: f64, c2x: f64, c2y: f64,
    x: f64, y: f64) {
    if (*b).have == 0 { return }
    let ra: *mut raster.Raster = (*b).ra as *mut raster.Raster
    raster.raster_cubic(ra,
        xf_x(&(*b).t, (*b).cx, (*b).cy), xf_y(&(*b).t, (*b).cx, (*b).cy),
        xf_x(&(*b).t, c1x, c1y), xf_y(&(*b).t, c1x, c1y),
        xf_x(&(*b).t, c2x, c2y), xf_y(&(*b).t, c2x, c2y),
        xf_x(&(*b).t, x, y), xf_y(&(*b).t, x, y))
    (*b).cx = x
    (*b).cy = y
    (*b).lx = c2x
    (*b).ly = c2y
}

fn pb_quad(b: *mut Pb, cx: f64, cy: f64, x: f64, y: f64) {
    if (*b).have == 0 { return }
    let ra: *mut raster.Raster = (*b).ra as *mut raster.Raster
    raster.raster_quad(ra,
        xf_x(&(*b).t, (*b).cx, (*b).cy), xf_y(&(*b).t, (*b).cx, (*b).cy),
        xf_x(&(*b).t, cx, cy), xf_y(&(*b).t, cx, cy),
        xf_x(&(*b).t, x, y), xf_y(&(*b).t, x, y))
    (*b).cx = x
    (*b).cy = y
    (*b).lx = cx
    (*b).ly = cy
}

// CLOSING IS A LINE BACK TO THE START, and it must be drawn even when
// the path looks closed already: the rasteriser counts crossings, and a
// subpath left one pixel open leaks the fill across the whole scanline.
fn pb_close(b: *mut Pb) {
    if (*b).have == 0 || (*b).open == 0 { return }
    let ra: *mut raster.Raster = (*b).ra as *mut raster.Raster
    raster.raster_line(ra, xf_x(&(*b).t, (*b).cx, (*b).cy),
        xf_y(&(*b).t, (*b).cx, (*b).cy),
        xf_x(&(*b).t, (*b).sx, (*b).sy),
        xf_y(&(*b).t, (*b).sx, (*b).sy))
    (*b).cx = (*b).sx
    (*b).cy = (*b).sy
    (*b).open = 0
}

// THE ELLIPTICAL ARC, SVG 1.1 F.6.5 plus the F.6.6 radius correction.
//
// Turned into up to four cubics: a Bezier follows a circular arc to
// better than 0.03 % of the radius up to 90 degrees, which is the same
// fact painter.fi uses for the round corners. More than 90 degrees per
// segment and the error becomes visible, so the sweep is split.
fn arc_to(b: *mut Pb, rx0: f64, ry0: f64, rot_deg: f64, large: bool,
    sweep: bool, x2: f64, y2: f64) {
    let x1: f64 = (*b).cx
    let y1: f64 = (*b).cy
    var rx: f64 = fabs(rx0)
    var ry: f64 = fabs(ry0)
    // F.6.2: a zero radius means a straight line. Not an error.
    if rx < 0.0000001 || ry < 0.0000001 {
        pb_line(b, x2, y2)
        return
    }
    if fabs(x2 - x1) < 0.0000001 && fabs(y2 - y1) < 0.0000001 {
        return
    }
    let PI: f64 = 3.141592653589793
    let phi: f64 = rot_deg * PI / 180.0
    let cp: f64 = fcos(phi)
    let sp: f64 = fsin(phi)
    // F.6.5.1 -- into the rotated frame
    let dx2: f64 = (x1 - x2) / 2.0
    let dy2: f64 = (y1 - y2) / 2.0
    let x1p: f64 = cp * dx2 + sp * dy2
    let y1p: f64 = 0.0 - sp * dx2 + cp * dy2
    // F.6.6 -- radii too small are scaled UP, not rejected
    let lam: f64 = (x1p * x1p) / (rx * rx) + (y1p * y1p) / (ry * ry)
    if lam > 1.0 {
        let s: f64 = fsqrt(lam)
        rx = rx * s
        ry = ry * s
    }
    // F.6.5.2 -- the centre in the rotated frame
    var num: f64 = rx * rx * ry * ry - rx * rx * y1p * y1p
        - ry * ry * x1p * x1p
    if num < 0.0 { num = 0.0 }
    let den: f64 = rx * rx * y1p * y1p + ry * ry * x1p * x1p
    if den < 0.0000000001 {
        pb_line(b, x2, y2)
        return
    }
    var co: f64 = fsqrt(num / den)
    if large == sweep { co = 0.0 - co }
    let cxp: f64 = co * rx * y1p / ry
    let cyp: f64 = 0.0 - co * ry * x1p / rx
    // F.6.5.3 -- back out of the rotated frame
    let cx: f64 = cp * cxp - sp * cyp + (x1 + x2) / 2.0
    let cy: f64 = sp * cxp + cp * cyp + (y1 + y2) / 2.0
    // F.6.5.5 / F.6.5.6 -- the two angles
    let ux: f64 = (x1p - cxp) / rx
    let uy: f64 = (y1p - cyp) / ry
    let vx: f64 = (0.0 - x1p - cxp) / rx
    let vy: f64 = (0.0 - y1p - cyp) / ry
    var th1: f64 = facos(ux / fsqrt(ux * ux + uy * uy))
    if uy < 0.0 { th1 = 0.0 - th1 }
    var dth: f64 = 0.0
    let dot: f64 = ux * vx + uy * vy
    let nn: f64 = fsqrt((ux * ux + uy * uy) * (vx * vx + vy * vy))
    var cs: f64 = 0.0
    if nn > 0.0000000001 { cs = dot / nn }
    dth = facos(cs)
    if ux * vy - uy * vx < 0.0 { dth = 0.0 - dth }
    if sweep && dth < 0.0 { dth = dth + 2.0 * PI }
    if !sweep && dth > 0.0 { dth = dth - 2.0 * PI }
    // Split so that no segment spans more than 90 degrees.
    var segs: i64 = (fabs(dth) / (PI / 2.0)) as i64 + 1
    if segs > 8 { segs = 8 }
    let delta: f64 = dth / (segs as f64)
    // THE BEZIER HANDLE LENGTH for this sweep -- the general form of the
    // 0.5523 in painter.fi, which is this same number at delta = 90 deg.
    //
    // MEASURED, NOT GUESSED (13.09.2026). The first version computed this
    // correctly and then used `tq / 2.0` below, i.e. half of it. The
    // picture still looked like a rounded icon, and the arc test caught it
    // only because it compares the AREA against the same shape drawn as a
    // cubic: 2741 pixels of ink against 2212, 24 % too much. Measured as
    // the radial error of a quarter circle the two differ by 0.1464
    // against 0.00027 -- that is a visibly flat arc, not a rounding
    // difference.
    //
    // The multiplier belongs on the RAW derivative of the parametric
    // ellipse, whose magnitude is the radius, not 1. So the factor is
    // exactly `4/3 * tan(delta/4)` and nothing else: no halving, no
    // normalising. The identity `tan(x) = sin(x)^2 / (sin(x) cos(x))` is
    // used to keep it to the two functions this file already has.
    let q: f64 = delta / 4.0
    var cq: f64 = fcos(q)
    if cq > 0.0 - 0.0000001 && cq < 0.0000001 {
        cq = 0.0000001
    }
    let tq: f64 = 4.0 / 3.0 * fsin(q) / cq
    var i: i64 = 0
    var th: f64 = th1
    while i < segs {
        let t2: f64 = th + delta
        let c1: f64 = fcos(th)
        let s1: f64 = fsin(th)
        let c2: f64 = fcos(t2)
        let s2: f64 = fsin(t2)
        // point and tangent on the unit circle, then into ellipse space
        let p1x: f64 = cx + rx * cp * c1 - ry * sp * s1
        let p1y: f64 = cy + rx * sp * c1 + ry * cp * s1
        let p2x: f64 = cx + rx * cp * c2 - ry * sp * s2
        let p2y: f64 = cy + rx * sp * c2 + ry * cp * s2
        let d1x: f64 = 0.0 - rx * cp * s1 - ry * sp * c1
        let d1y: f64 = 0.0 - rx * sp * s1 + ry * cp * c1
        let d2x: f64 = 0.0 - rx * cp * s2 - ry * sp * c2
        let d2y: f64 = 0.0 - rx * sp * s2 + ry * cp * c2
        // p1 is the current point already (bar rounding); drive from it
        (*b).cx = p1x
        (*b).cy = p1y
        pb_cubic(b, p1x + tq * d1x, p1y + tq * d1y,
            p2x - tq * d2x, p2y - tq * d2y, p2x, p2y)
        th = t2
        i = i + 1
    }
    (*b).cx = x2
    (*b).cy = y2
    (*b).lx = x2
    (*b).ly = y2
}

// ====================================================================
// THE `d` ATTRIBUTE
// ====================================================================
//
// One pass, no intermediate storage. The command letter is sticky: after
// "M 1 2 3 4" the 3 4 is an implicit L, which is what the specification
// says and what every real icon relies on.
fn run_path(b: *mut Pb, p: u64, n: usize, i0: usize, len: usize) {
    var i: usize = i0
    let end: usize = i0 + len
    var cmd: u8 = 0 as u8
    var v: [f64; 7] = [0.0; 7]
    while i < end {
        while i < end && (is_space(b8(p, i)) || b8(p, i) == 44 as u8) {
            i = i + 1
        }
        if i >= end { break }
        let c: u8 = b8(p, i)
        if is_alpha(c) {
            cmd = c
            i = i + 1
        } else if cmd == 0 as u8 {
            // A number with no command before it -- nothing sensible to
            // do, so stop rather than guess.
            break
        }
        // How many numbers this command eats.
        var need: usize = 0
        let lc: u8 = lower(cmd)
        if lc == 109 as u8 { need = 2 }       // m
        else if lc == 108 as u8 { need = 2 }  // l
        else if lc == 104 as u8 { need = 1 }  // h
        else if lc == 118 as u8 { need = 1 }  // v
        else if lc == 99 as u8 { need = 6 }   // c
        else if lc == 115 as u8 { need = 4 }  // s
        else if lc == 113 as u8 { need = 4 }  // q
        else if lc == 116 as u8 { need = 2 }  // t
        else if lc == 97 as u8 { need = 7 }   // a
        else if lc == 122 as u8 { need = 0 }  // z
        else {
            // Unknown letter: stop. Carrying on would put the numbers
            // that follow into the wrong command.
            break
        }
        var k: usize = 0
        var okk: bool = true
        while k < need {
            var got: f64 = 0.0
            var ni: usize = 0
            // The arc's flags 4 and 5 are single characters and may be
            // written without a separator ("a1 1 0 011 1"), so they get
            // their own reader.
            if lc == 97 as u8 && (k == 3 || k == 4) {
                ni = flag_at(p, end, i, &got)
            } else {
                ni = num_at(p, end, i, &got)
            }
            if ni == i {
                okk = false
                break
            }
            v[k] = got
            i = ni
            k = k + 1
        }
        if !okk { break }
        let rel: bool = cmd >= 97 as u8
        let px: f64 = (*b).cx
        let py: f64 = (*b).cy
        if lc == 109 as u8 {
            var x: f64 = v[0]
            var y: f64 = v[1]
            if rel { x = px + x; y = py + y }
            pb_move(b, x, y)
            // After an M, further pairs are implicit L (spec 8.3.2).
            if cmd == 77 as u8 { cmd = 76 as u8 } else { cmd = 108 as u8 }
        } else if lc == 108 as u8 {
            var x: f64 = v[0]
            var y: f64 = v[1]
            if rel { x = px + x; y = py + y }
            pb_line(b, x, y)
        } else if lc == 104 as u8 {
            var x: f64 = v[0]
            if rel { x = px + x }
            pb_line(b, x, py)
        } else if lc == 118 as u8 {
            var y: f64 = v[0]
            if rel { y = py + y }
            pb_line(b, px, y)
        } else if lc == 99 as u8 {
            var a1: f64 = v[0]
            var b1: f64 = v[1]
            var a2: f64 = v[2]
            var b2: f64 = v[3]
            var x: f64 = v[4]
            var y: f64 = v[5]
            if rel {
                a1 = px + a1; b1 = py + b1
                a2 = px + a2; b2 = py + b2
                x = px + x; y = py + y
            }
            pb_cubic(b, a1, b1, a2, b2, x, y)
        } else if lc == 115 as u8 {
            // SMOOTH CUBIC: the first control point is the REFLECTION of
            // the previous one. If the previous command was not a cubic,
            // it is the current point -- getting that wrong puts a kink
            // in every rounded icon.
            var a2: f64 = v[0]
            var b2: f64 = v[1]
            var x: f64 = v[2]
            var y: f64 = v[3]
            if rel { a2 = px + a2; b2 = py + b2; x = px + x; y = py + y }
            let a1: f64 = 2.0 * px - (*b).lx
            let b1: f64 = 2.0 * py - (*b).ly
            pb_cubic(b, a1, b1, a2, b2, x, y)
        } else if lc == 113 as u8 {
            var a1: f64 = v[0]
            var b1: f64 = v[1]
            var x: f64 = v[2]
            var y: f64 = v[3]
            if rel { a1 = px + a1; b1 = py + b1; x = px + x; y = py + y }
            pb_quad(b, a1, b1, x, y)
        } else if lc == 116 as u8 {
            var x: f64 = v[0]
            var y: f64 = v[1]
            if rel { x = px + x; y = py + y }
            let a1: f64 = 2.0 * px - (*b).lx
            let b1: f64 = 2.0 * py - (*b).ly
            pb_quad(b, a1, b1, x, y)
        } else if lc == 97 as u8 {
            var x: f64 = v[5]
            var y: f64 = v[6]
            if rel { x = px + x; y = py + y }
            arc_to(b, v[0], v[1], v[2], v[3] != 0.0, v[4] != 0.0, x, y)
        } else if lc == 122 as u8 {
            pb_close(b)
        }
    }
    // AN UNCLOSED SUBPATH IS CLOSED FOR THE FILL. The rasteriser needs a
    // closed outline; SVG fills an open subpath as if it were closed,
    // and this is that rule.
    if (*b).open != 0 {
        pb_close(b)
    }
}

#[no_gc]
fn lower(c: u8) -> u8 {
    if c >= 65 as u8 && c <= 90 as u8 { return c + 32 as u8 }
    return c
}

// ====================================================================
// THE `transform` ATTRIBUTE
// ====================================================================
//
// translate, scale, matrix, rotate. Several in one attribute, applied
// LEFT TO RIGHT, which is what SVG says: "transform='translate(10,0)
// scale(2)'" moves then scales, so the scale happens in the moved frame.
fn parse_transform(p: u64, n: usize, i0: usize, len: usize) -> Xf {
    var out: Xf = xf_id()
    var i: usize = i0
    let end: usize = i0 + len
    var lt: [u8; 9] = "translate"
    var ls: [u8; 5] = "scale"
    var lm: [u8; 6] = "matrix"
    var lr: [u8; 6] = "rotate"
    while i < end {
        while i < end && (is_space(b8(p, i)) || b8(p, i) == 44 as u8) {
            i = i + 1
        }
        if i >= end { break }
        var v: [f64; 6] = [0.0; 6]
        var kind: usize = 0
        var after: usize = i
        if eq_at(p, end, i, (&lt[0]) as u64, 9) { kind = 1; after = i + 9 }
        else if eq_at(p, end, i, (&ls[0]) as u64, 5) { kind = 2; after = i + 5 }
        else if eq_at(p, end, i, (&lm[0]) as u64, 6) { kind = 3; after = i + 6 }
        else if eq_at(p, end, i, (&lr[0]) as u64, 6) { kind = 4; after = i + 6 }
        else {
            i = i + 1
            continue
        }
        // to the '('
        while after < end && b8(p, after) != 40 as u8 { after = after + 1 }
        if after >= end { break }
        var j: usize = after + 1
        var cnt: usize = 0
        while cnt < 6 && j < end {
            // stop at ')'
            var k: usize = j
            while k < end && (is_space(b8(p, k)) || b8(p, k) == 44 as u8) {
                k = k + 1
            }
            if k < end && b8(p, k) == 41 as u8 { j = k; break }
            var got: f64 = 0.0
            let nj: usize = num_at(p, end, j, &got)
            if nj == j { break }
            v[cnt] = got
            cnt = cnt + 1
            j = nj
        }
        while j < end && b8(p, j) != 41 as u8 { j = j + 1 }
        var m: Xf = xf_id()
        if kind == 1 {
            m.e = v[0]
            if cnt > 1 { m.f = v[1] }
        } else if kind == 2 {
            m.a = v[0]
            if cnt > 1 { m.d = v[1] } else { m.d = v[0] }
        } else if kind == 3 && cnt >= 6 {
            m.a = v[0]; m.b = v[1]; m.c = v[2]
            m.d = v[3]; m.e = v[4]; m.f = v[5]
        } else if kind == 4 {
            let PI: f64 = 3.141592653589793
            let ang: f64 = v[0] * PI / 180.0
            let ca: f64 = fcos(ang)
            let sa: f64 = fsin(ang)
            if cnt >= 3 {
                // rotate(a, cx, cy) = translate(c) rotate(a) translate(-c)
                var t1: Xf = xf_id()
                t1.e = v[1]
                t1.f = v[2]
                var rr: Xf = Xf { a: ca, b: sa, c: 0.0 - sa, d: ca,
                    e: 0.0, f: 0.0 }
                var t2: Xf = xf_id()
                t2.e = 0.0 - v[1]
                t2.f = 0.0 - v[2]
                m = xf_mul(t1, xf_mul(rr, t2))
            } else {
                m = Xf { a: ca, b: sa, c: 0.0 - sa, d: ca, e: 0.0, f: 0.0 }
            }
        }
        out = xf_mul(out, m)
        i = j + 1
    }
    return out
}

// ====================================================================
// THE ATTRIBUTE SCANNER
// ====================================================================
//
// Finds `name="value"` inside ONE element's angle brackets. Gives the
// offset and length of the value, or length 0 when the attribute is
// absent. Single quotes count too -- plenty of icon sets use them.
fn attr_at(p: u64, n: usize, tag0: usize, tag1: usize, name: u64,
    nlen: usize, vo: *mut usize) -> usize {
    var i: usize = tag0
    while i + nlen + 2 < tag1 {
        // the name must start at a word boundary
        if eq_at(p, tag1, i, name, nlen) {
            var ok_before: bool = false
            if i == tag0 { ok_before = true }
            else if is_space(b8(p, i - 1)) { ok_before = true }
            if ok_before {
                var j: usize = i + nlen
                while j < tag1 && is_space(b8(p, j)) { j = j + 1 }
                if j < tag1 && b8(p, j) == 61 as u8 {
                    j = j + 1
                    while j < tag1 && is_space(b8(p, j)) { j = j + 1 }
                    if j < tag1 && (b8(p, j) == 34 as u8
                        || b8(p, j) == 39 as u8) {
                        let q: u8 = b8(p, j)
                        j = j + 1
                        var e: usize = j
                        while e < tag1 && b8(p, e) != q { e = e + 1 }
                        *vo = j
                        return e - j
                    }
                }
            }
        }
        i = i + 1
    }
    *vo = 0
    return 0
}

// A number-valued attribute, with a default.
fn attr_num(p: u64, n: usize, t0: usize, t1: usize, name: u64,
    nlen: usize, def: f64) -> f64 {
    var vo: usize = 0
    let vl: usize = attr_at(p, n, t0, t1, name, nlen, &vo)
    if vl == 0 { return def }
    var got: f64 = 0.0
    if num_at(p, vo + vl, vo, &got) == vo { return def }
    return got
}

// ====================================================================
// FILL AND STROKE OF ONE SHAPE
// ====================================================================
//
// The raster window is opened by the CALLER of this (`fill_now`), because
// the rasteriser holds one window at a time and a shape needs it for the
// whole of its path.
fn fill_now(d: *mut Dc, pa: *mut Paint, use_stroke: bool,
    wx: f64, wy: f64) {
    let z: *mut painter.Painter = (*d).z as *mut painter.Painter
    var col: u32 = (*pa).fill
    if use_stroke { col = (*pa).stroke }
    if (*d).tint != 0 as u32 {
        col = (*d).tint | (255 as u32) << 24
    }
    if col == 0 as u32 { return }
    // opacity folds into the alpha
    var a: f64 = (((col >> 24) & 255 as u32) as f64) / 255.0
    a = a * (*pa).opacity
    if !use_stroke { a = a * (*pa).fill_op }
    if a <= 0.0 { return }
    var aa: u32 = (a * 255.0 + 0.5) as u32
    if aa > 255 as u32 { aa = 255 as u32 }
    let out: u32 = (col & 16777215 as u32) | (aa << 24)
    painter.fill_raster_rule(z, wx, wy, out,
        (*pa).rule == RULE_EVENODD)
}

// A STROKE AS A QUADRILATERAL PER SEGMENT.
//
// Not a real stroker: no joins, no caps, no dashes (named in the head).
// For an icon outline of one or two pixels that is indistinguishable from
// a proper one, and a proper one is a few hundred lines of offsetting
// that would have to be tested in its own right.
//
// Each segment becomes a rectangle of width `w` around it, rasterised
// with the NON-ZERO rule so overlapping segments at a corner stay solid
// instead of cancelling out.
fn stroke_seg(ra: *mut raster.Raster, x0: f64, y0: f64, x1: f64,
    y1: f64, w: f64) {
    var dx: f64 = x1 - x0
    var dy: f64 = y1 - y0
    let len: f64 = fsqrt(dx * dx + dy * dy)
    if len < 0.0000001 { return }
    let h: f64 = w / 2.0
    let nx: f64 = 0.0 - dy / len * h
    let ny: f64 = dx / len * h
    raster.raster_line(ra, x0 + nx, y0 + ny, x1 + nx, y1 + ny)
    raster.raster_line(ra, x1 + nx, y1 + ny, x1 - nx, y1 - ny)
    raster.raster_line(ra, x1 - nx, y1 - ny, x0 - nx, y0 - ny)
    raster.raster_line(ra, x0 - nx, y0 - ny, x0 + nx, y0 + ny)
}

// ====================================================================
// ONE SHAPE
// ====================================================================
//
// Opens a raster window that covers the whole destination rectangle,
// pushes the shape into it and fills. One window per shape, because the
// rasteriser holds one at a time.
//
// `dx/dy/dw/dh` is the destination rectangle in canvas pixels -- the
// window, not the shape's own bounding box. Working the bounding box out
// per shape would be faster and is deliberately not done: it needs a
// second pass over every path, and an icon is at most a few hundred
// pixels across.
fn shape_begin(d: *mut Dc, dx: f64, dy: f64, dw: f64, dh: f64,
    wx: *mut f64, wy: *mut f64) -> bool {
    let z: *mut painter.Painter = (*d).z as *mut painter.Painter
    return painter.raster_open(z, dx, dy, dw, dh, 1.0, wx, wy)
}

// <path d="...">
fn do_path(s: *mut Svg, d: *mut Dc, pa: *mut Paint, t: Xf,
    t0: usize, t1: usize, dx: f64, dy: f64, dw: f64, dh: f64) {
    let p: u64 = (*s).src
    let n: usize = (*s).n
    var ld: [u8; 1] = "d"
    var vo: usize = 0
    let vl: usize = attr_at(p, n, t0, t1, (&ld[0]) as u64, 1, &vo)
    if vl == 0 { return }
    let z: *mut painter.Painter = (*d).z as *mut painter.Painter

    // ---- the FILL
    if (*pa).fill != 0 as u32 || (*d).tint != 0 as u32 {
        var wx: f64 = 0.0
        var wy: f64 = 0.0
        if shape_begin(d, dx, dy, dw, dh, &wx, &wy) {
            var b: Pb = Pb { ra: painter.raster_of(z) as u64, t: t,
                cx: 0.0, cy: 0.0, sx: 0.0, sy: 0.0, lx: 0.0, ly: 0.0,
                have: 0, open: 0 }
            run_path(&b, p, n, vo, vl)
            fill_now(d, pa, false, wx, wy)
            (*s).shapes = (*s).shapes + 1
        }
    }
    // ---- the STROKE, as a second pass over the same path
    if (*pa).stroke != 0 as u32 && (*pa).sw > 0.0 {
        var wx2: f64 = 0.0
        var wy2: f64 = 0.0
        if shape_begin(d, dx, dy, dw, dh, &wx2, &wy2) {
            stroke_path(z, p, n, vo, vl, t, (*pa).sw * xf_scale(&t))
            // The stroke quads overlap at the joins, so NON-ZERO always
            // -- under even-odd the overlap would punch a hole at every
            // corner.
            var sp: Paint = *pa
            sp.rule = RULE_NONZERO
            fill_now(d, &sp, true, wx2, wy2)
        }
    }
}

// The path again, as a ribbon of quadrilaterals. It walks the same
// command set through a flattener: the stroke needs POINTS, and the
// rasteriser takes curves, so the curves are subdivided here.
fn stroke_path(z: *mut painter.Painter, p: u64, n: usize, i0: usize,
    len: usize, t: Xf, w: f64) {
    flat_run(painter.raster_of(z), p, n, i0, len, t, w)
}

// ====================================================================
// THE PUBLIC ENTRY POINTS
// ====================================================================

// Read the <svg> element: viewBox, or width/height as a fallback.
//
// WITHOUT A viewBox AND WITHOUT width/height there is no way to know how
// big the drawing is, and guessing 100x100 would put every such icon at
// the wrong scale. `svg_ok` then gives false.
fn svg_parse(s: *mut Svg, src: u64, n: usize) -> bool {
    *s = svg_new()
    (*s).src = src
    (*s).n = n
    // find "<svg"
    var lsvg: [u8; 4] = "<svg"
    var i: usize = 0
    var found: bool = false
    while i + 4 <= n {
        if eq_at(src, n, i, (&lsvg[0]) as u64, 4) {
            found = true
            break
        }
        i = i + 1
    }
    if !found { return false }
    var t1: usize = i
    while t1 < n && b8(src, t1) != 62 as u8 { t1 = t1 + 1 }
    var lvb: [u8; 7] = "viewBox"
    var vo: usize = 0
    let vl: usize = attr_at(src, n, i, t1, (&lvb[0]) as u64, 7, &vo)
    if vl != 0 {
        var a: f64 = 0.0
        var j: usize = num_at(src, vo + vl, vo, &a)
        var bb: f64 = 0.0
        j = num_at(src, vo + vl, j, &bb)
        var c: f64 = 0.0
        j = num_at(src, vo + vl, j, &c)
        var dd: f64 = 0.0
        j = num_at(src, vo + vl, j, &dd)
        if c > 0.0 && dd > 0.0 {
            (*s).vb_x = a
            (*s).vb_y = bb
            (*s).vb_w = c
            (*s).vb_h = dd
            (*s).ok = 1
            return true
        }
    }
    var lw: [u8; 5] = "width"
    var lh: [u8; 6] = "height"
    let w: f64 = attr_num(src, n, i, t1, (&lw[0]) as u64, 5, 0.0)
    let h: f64 = attr_num(src, n, i, t1, (&lh[0]) as u64, 6, 0.0)
    if w > 0.0 && h > 0.0 {
        (*s).vb_x = 0.0
        (*s).vb_y = 0.0
        (*s).vb_w = w
        (*s).vb_h = h
        (*s).ok = 1
        return true
    }
    return false
}

// DRAW THE ICON INTO A RECTANGLE, aspect ratio kept and centred.
//
// `tint` 0 draws the icon in its own colours; a colour paints every shape
// in it, which is how one monochrome icon serves a light and a dark theme.
fn svg_draw(s: *mut Svg, z: *mut painter.Painter, x: f64, y: f64,
    w: f64, h: f64, tint: u32) {
    if (*s).ok == 0 || w <= 0.0 || h <= 0.0 { return }
    // CONTAIN: the smaller scale, so nothing is cropped.
    var sc: f64 = w / (*s).vb_w
    let sy: f64 = h / (*s).vb_h
    if sy < sc { sc = sy }
    let ow: f64 = (*s).vb_w * sc
    let oh: f64 = (*s).vb_h * sc
    let ox: f64 = x + (w - ow) / 2.0
    let oy: f64 = y + (h - oh) / 2.0
    svg_draw_fit(s, z, ox, oy, sc, tint)
}

// Draw at an explicit origin and scale -- for a caller that has worked
// the placement out itself (a toolbar aligning several icons on a grid).
fn svg_draw_fit(s: *mut Svg, z: *mut painter.Painter, ox: f64, oy: f64,
    sc: f64, tint: u32) {
    if (*s).ok == 0 { return }
    (*s).shapes = 0
    var d: Dc = Dc { z: z as u64, tint: tint, xs: [0.0; 96], depth: 0 }
    // The root transform: viewBox offset, then the scale, then the origin.
    var root: Xf = Xf { a: sc, b: 0.0, c: 0.0, d: sc,
        e: ox - (*s).vb_x * sc, f: oy - (*s).vb_y * sc }
    dc_set(&d, 0, root)
    // The destination rectangle -- the raster window for every shape.
    let dw: f64 = (*s).vb_w * sc
    let dh: f64 = (*s).vb_h * sc
    var pa: Paint = paint_root(tint)
    walk(s, &d, pa, root, 0, (*s).n, ox, oy, dw, dh, 0)
}

// ====================================================================
// THE FLATTENER, FOR THE STROKE
// ====================================================================
//
// Walks `d` a second time and emits the path as SEGMENTS, each one turned
// into a quadrilateral by `stroke_seg`. Curves are subdivided into a fixed
// number of pieces -- sixteen, which at icon sizes is under a tenth of a
// pixel of chord error and costs nothing.
//
// It duplicates the command DISPATCH of `run_path` and not the geometry.
// That is a real cost and it was weighed: the alternative is a callback
// per segment through a function value, and a closure on the hot path of
// every icon is worse than forty lines that are checked by the same
// tests. If a third consumer of `d` ever appears, this is the place to
// introduce that callback.
fn flat_run(ra: *mut raster.Raster, p: u64, n: usize, i0: usize,
    len: usize, t: Xf, w: f64) {
    var i: usize = i0
    let end: usize = i0 + len
    var cmd: u8 = 0 as u8
    var v: [f64; 7] = [0.0; 7]
    var cx: f64 = 0.0
    var cy: f64 = 0.0
    var sx: f64 = 0.0
    var sy: f64 = 0.0
    var lx: f64 = 0.0
    var ly: f64 = 0.0
    var have: bool = false
    while i < end {
        while i < end && (is_space(b8(p, i)) || b8(p, i) == 44 as u8) {
            i = i + 1
        }
        if i >= end { break }
        let c: u8 = b8(p, i)
        if is_alpha(c) {
            cmd = c
            i = i + 1
        } else if cmd == 0 as u8 {
            break
        }
        var need: usize = 0
        let lc: u8 = lower(cmd)
        if lc == 109 as u8 { need = 2 }
        else if lc == 108 as u8 { need = 2 }
        else if lc == 104 as u8 { need = 1 }
        else if lc == 118 as u8 { need = 1 }
        else if lc == 99 as u8 { need = 6 }
        else if lc == 115 as u8 { need = 4 }
        else if lc == 113 as u8 { need = 4 }
        else if lc == 116 as u8 { need = 2 }
        else if lc == 97 as u8 { need = 7 }
        else if lc == 122 as u8 { need = 0 }
        else { break }
        var k: usize = 0
        var okk: bool = true
        while k < need {
            var got: f64 = 0.0
            var ni: usize = 0
            if lc == 97 as u8 && (k == 3 || k == 4) {
                ni = flag_at(p, end, i, &got)
            } else {
                ni = num_at(p, end, i, &got)
            }
            if ni == i { okk = false; break }
            v[k] = got
            i = ni
            k = k + 1
        }
        if !okk { break }
        let rel: bool = cmd >= 97 as u8
        let px: f64 = cx
        let py: f64 = cy
        if lc == 109 as u8 {
            var x: f64 = v[0]
            var y: f64 = v[1]
            if rel { x = px + x; y = py + y }
            cx = x; cy = y; sx = x; sy = y; lx = x; ly = y
            have = true
            if cmd == 77 as u8 { cmd = 76 as u8 } else { cmd = 108 as u8 }
        } else if lc == 108 as u8 || lc == 104 as u8 || lc == 118 as u8 {
            var x: f64 = px
            var y: f64 = py
            if lc == 108 as u8 {
                x = v[0]; y = v[1]
                if rel { x = px + x; y = py + y }
            } else if lc == 104 as u8 {
                x = v[0]
                if rel { x = px + x }
            } else {
                y = v[0]
                if rel { y = py + y }
            }
            if have {
                stroke_seg(ra, xf_x(&t, px, py), xf_y(&t, px, py),
                    xf_x(&t, x, y), xf_y(&t, x, y), w)
            }
            cx = x; cy = y; lx = x; ly = y
        } else if lc == 99 as u8 || lc == 115 as u8 {
            var a1: f64 = 0.0
            var b1: f64 = 0.0
            var a2: f64 = 0.0
            var b2: f64 = 0.0
            var x: f64 = 0.0
            var y: f64 = 0.0
            if lc == 99 as u8 {
                a1 = v[0]; b1 = v[1]; a2 = v[2]; b2 = v[3]
                x = v[4]; y = v[5]
                if rel {
                    a1 = px + a1; b1 = py + b1; a2 = px + a2
                    b2 = py + b2; x = px + x; y = py + y
                }
            } else {
                a2 = v[0]; b2 = v[1]; x = v[2]; y = v[3]
                if rel { a2 = px + a2; b2 = py + b2; x = px + x; y = py + y }
                a1 = 2.0 * px - lx
                b1 = 2.0 * py - ly
            }
            flat_cubic(ra, t, px, py, a1, b1, a2, b2, x, y, w, have)
            cx = x; cy = y; lx = a2; ly = b2
        } else if lc == 113 as u8 || lc == 116 as u8 {
            var a1: f64 = 0.0
            var b1: f64 = 0.0
            var x: f64 = 0.0
            var y: f64 = 0.0
            if lc == 113 as u8 {
                a1 = v[0]; b1 = v[1]; x = v[2]; y = v[3]
                if rel { a1 = px + a1; b1 = py + b1; x = px + x; y = py + y }
            } else {
                x = v[0]; y = v[1]
                if rel { x = px + x; y = py + y }
                a1 = 2.0 * px - lx
                b1 = 2.0 * py - ly
            }
            // A quadratic is the cubic with the two handles at 2/3.
            flat_cubic(ra, t, px, py, px + 2.0 / 3.0 * (a1 - px),
                py + 2.0 / 3.0 * (b1 - py), x + 2.0 / 3.0 * (a1 - x),
                y + 2.0 / 3.0 * (b1 - y), x, y, w, have)
            cx = x; cy = y; lx = a1; ly = b1
        } else if lc == 97 as u8 {
            // The arc as a straight chord for the STROKE only. Named in
            // the head of the file: a stroked arc comes out as a polygon
            // of its segments, which for an icon outline at one or two
            // pixels is not visible -- but it IS a simplification, and
            // pretending otherwise in a comment would be the fault this
            // project keeps finding.
            var x: f64 = v[5]
            var y: f64 = v[6]
            if rel { x = px + x; y = py + y }
            if have {
                stroke_seg(ra, xf_x(&t, px, py), xf_y(&t, px, py),
                    xf_x(&t, x, y), xf_y(&t, x, y), w)
            }
            cx = x; cy = y; lx = x; ly = y
        } else if lc == 122 as u8 {
            if have {
                stroke_seg(ra, xf_x(&t, cx, cy), xf_y(&t, cx, cy),
                    xf_x(&t, sx, sy), xf_y(&t, sx, sy), w)
            }
            cx = sx; cy = sy
        }
    }
}

fn flat_cubic(ra: *mut raster.Raster, t: Xf, x0: f64, y0: f64, c1x: f64,
    c1y: f64, c2x: f64, c2y: f64, x1: f64, y1: f64, w: f64, have: bool) {
    if !have { return }
    let N: usize = 16
    var prevx: f64 = x0
    var prevy: f64 = y0
    var i: usize = 1
    while i <= N {
        let u: f64 = (i as f64) / (N as f64)
        let m: f64 = 1.0 - u
        let bx: f64 = m * m * m * x0 + 3.0 * m * m * u * c1x
            + 3.0 * m * u * u * c2x + u * u * u * x1
        let by: f64 = m * m * m * y0 + 3.0 * m * m * u * c1y
            + 3.0 * m * u * u * c2y + u * u * u * y1
        stroke_seg(ra, xf_x(&t, prevx, prevy), xf_y(&t, prevx, prevy),
            xf_x(&t, bx, by), xf_y(&t, bx, by), w)
        prevx = bx
        prevy = by
        i = i + 1
    }
}

// ====================================================================
// THE ELEMENT WALK
// ====================================================================
//
// A flat scan over the text, not a DOM: every `<...>` is looked at, and
// `<g>` pushes the transform, `</g>` pops it. That is enough for an icon
// and it needs no allocation at all -- the whole state is `Dc.xs` and
// the paint, which is passed by value so inheritance comes for free.
//
// A `<g>` that is never closed simply keeps its transform to the end of
// the document, which is what a browser does with it too.
fn walk(s: *mut Svg, d: *mut Dc, inherited: Paint, t: Xf, from: usize,
    to: usize, ox: f64, oy: f64, dw: f64, dh: f64, depth: usize) {
    let p: u64 = (*s).src
    let n: usize = (*s).n
    var i: usize = from
    var lg: [u8; 2] = "g\0"
    var lpath: [u8; 4] = "path"
    var lrect: [u8; 4] = "rect"
    var lcirc: [u8; 6] = "circle"
    var lell: [u8; 7] = "ellipse"
    var lline: [u8; 4] = "line"
    var lpl: [u8; 8] = "polyline"
    var lpg: [u8; 7] = "polygon"
    var cur: Paint = inherited
    var ct: Xf = t
    // ONE LEVEL of group nesting is tracked by recursion below; this loop
    // handles the siblings.
    while i < to {
        if b8(p, i) != 60 as u8 {
            i = i + 1
            continue
        }
        // an end tag?
        if i + 1 < to && b8(p, i + 1) == 47 as u8 {
            // </g> ends THIS level -- give control back to the caller.
            if i + 3 < to && b8(p, i + 2) == 103 as u8 {
                return
            }
            i = i + 2
            continue
        }
        // a comment or a declaration
        if i + 1 < to && (b8(p, i + 1) == 33 as u8
            || b8(p, i + 1) == 63 as u8) {
            i = i + 2
            continue
        }
        var t0: usize = i + 1
        var t1: usize = t0
        while t1 < to && b8(p, t1) != 62 as u8 { t1 = t1 + 1 }
        if t1 >= to { return }
        // self closing?
        var selfclose: bool = false
        if t1 > t0 && b8(p, t1 - 1) == 47 as u8 { selfclose = true }

        // The paint of THIS element, inherited then overridden.
        var pa: Paint = cur
        read_paint(s, &pa, t0, t1)
        // its own transform
        var lx: [u8; 9] = "transform"
        var vo: usize = 0
        let vl: usize = attr_at(p, n, t0, t1, (&lx[0]) as u64, 9, &vo)
        var et: Xf = ct
        if vl != 0 {
            et = xf_mul(ct, parse_transform(p, n, vo, vl))
        }

        if eq_at(p, to, t0, (&lg[0]) as u64, 1)
            && (t0 + 1 >= to || is_space(b8(p, t0 + 1))
                || b8(p, t0 + 1) == 62 as u8 || b8(p, t0 + 1) == 47 as u8) {
            // A GROUP. Recurse with its paint and transform; the
            // recursion returns at the matching </g>.
            if !selfclose && depth + 1 < STACK {
                walk(s, d, pa, et, t1 + 1, to, ox, oy, dw, dh, depth + 1)
                // skip past the group we just drew
                i = skip_group(p, t1 + 1, to)
                continue
            }
            i = t1 + 1
            continue
        }
        if eq_at(p, to, t0, (&lpath[0]) as u64, 4) {
            do_path(s, d, &pa, et, t0, t1, ox, oy, dw, dh)
        } else if eq_at(p, to, t0, (&lrect[0]) as u64, 4) {
            do_rect(s, d, &pa, et, t0, t1, ox, oy, dw, dh)
        } else if eq_at(p, to, t0, (&lcirc[0]) as u64, 6) {
            do_ellipse(s, d, &pa, et, t0, t1, ox, oy, dw, dh, true)
        } else if eq_at(p, to, t0, (&lell[0]) as u64, 7) {
            do_ellipse(s, d, &pa, et, t0, t1, ox, oy, dw, dh, false)
        } else if eq_at(p, to, t0, (&lpl[0]) as u64, 8) {
            do_poly(s, d, &pa, et, t0, t1, ox, oy, dw, dh, false)
        } else if eq_at(p, to, t0, (&lpg[0]) as u64, 7) {
            do_poly(s, d, &pa, et, t0, t1, ox, oy, dw, dh, true)
        } else if eq_at(p, to, t0, (&lline[0]) as u64, 4) {
            do_line(s, d, &pa, et, t0, t1, ox, oy, dw, dh)
        }
        i = t1 + 1
    }
}

// Where the matching </g> ends. Counts nesting, so a group inside a group
// does not cut the outer one short.
fn skip_group(p: u64, from: usize, to: usize) -> usize {
    var i: usize = from
    var lvl: i64 = 1
    while i < to {
        if b8(p, i) == 60 as u8 {
            if i + 2 < to && b8(p, i + 1) == 47 as u8
                && b8(p, i + 2) == 103 as u8 {
                lvl = lvl - 1
                if lvl == 0 {
                    while i < to && b8(p, i) != 62 as u8 { i = i + 1 }
                    return i + 1
                }
            } else if i + 1 < to && b8(p, i + 1) == 103 as u8 {
                var k: usize = i + 2
                if k < to && (is_space(b8(p, k)) || b8(p, k) == 62 as u8) {
                    // not self closing?
                    var e: usize = i
                    while e < to && b8(p, e) != 62 as u8 { e = e + 1 }
                    if e > i && b8(p, e - 1) != 47 as u8 {
                        lvl = lvl + 1
                    }
                }
            }
        }
        i = i + 1
    }
    return to
}

// fill / stroke / stroke-width / fill-rule / opacity off one element.
fn read_paint(s: *mut Svg, pa: *mut Paint, t0: usize, t1: usize) {
    let p: u64 = (*s).src
    let n: usize = (*s).n
    var lf: [u8; 4] = "fill"
    var lst: [u8; 6] = "stroke"
    var lsw: [u8; 12] = "stroke-width"
    var lfr: [u8; 9] = "fill-rule"
    var lop: [u8; 7] = "opacity"
    var lfo: [u8; 12] = "fill-opacity"
    var vo: usize = 0
    var vl: usize = attr_at(p, n, t0, t1, (&lf[0]) as u64, 4, &vo)
    if vl != 0 {
        (*pa).fill = parse_color(p, n, vo, vl, (*pa).fill)
    }
    vl = attr_at(p, n, t0, t1, (&lst[0]) as u64, 6, &vo)
    if vl != 0 {
        (*pa).stroke = parse_color(p, n, vo, vl, (*pa).stroke)
    }
    (*pa).sw = attr_num(p, n, t0, t1, (&lsw[0]) as u64, 12, (*pa).sw)
    vl = attr_at(p, n, t0, t1, (&lfr[0]) as u64, 9, &vo)
    if vl != 0 {
        var leo: [u8; 7] = "evenodd"
        if eq_at(p, n, vo, (&leo[0]) as u64, 7) {
            (*pa).rule = RULE_EVENODD
        } else {
            (*pa).rule = RULE_NONZERO
        }
    }
    let op: f64 = attr_num(p, n, t0, t1, (&lop[0]) as u64, 7, 1.0)
    (*pa).opacity = (*pa).opacity * op
    (*pa).fill_op = attr_num(p, n, t0, t1, (&lfo[0]) as u64, 12, 1.0)
}

// <rect>, with rx/ry -- a rounded rect is what a "button" icon is.
fn do_rect(s: *mut Svg, d: *mut Dc, pa: *mut Paint, t: Xf, t0: usize,
    t1: usize, ox: f64, oy: f64, dw: f64, dh: f64) {
    let p: u64 = (*s).src
    let n: usize = (*s).n
    var lx: [u8; 1] = "x"
    var ly: [u8; 1] = "y"
    var lw: [u8; 5] = "width"
    var lh: [u8; 6] = "height"
    var lrx: [u8; 2] = "rx"
    var lry: [u8; 2] = "ry"
    let x: f64 = attr_num(p, n, t0, t1, (&lx[0]) as u64, 1, 0.0)
    let y: f64 = attr_num(p, n, t0, t1, (&ly[0]) as u64, 1, 0.0)
    let w: f64 = attr_num(p, n, t0, t1, (&lw[0]) as u64, 5, 0.0)
    let h: f64 = attr_num(p, n, t0, t1, (&lh[0]) as u64, 6, 0.0)
    if w <= 0.0 || h <= 0.0 { return }
    var rx: f64 = attr_num(p, n, t0, t1, (&lrx[0]) as u64, 2, 0.0)
    var ry: f64 = attr_num(p, n, t0, t1, (&lry[0]) as u64, 2, 0.0)
    if rx > 0.0 && ry <= 0.0 { ry = rx }
    if ry > 0.0 && rx <= 0.0 { rx = ry }
    if rx > w / 2.0 { rx = w / 2.0 }
    if ry > h / 2.0 { ry = h / 2.0 }
    let z: *mut painter.Painter = (*d).z as *mut painter.Painter
    if (*pa).fill == 0 as u32 && (*d).tint == 0 as u32 { return }
    var wx: f64 = 0.0
    var wy: f64 = 0.0
    if !shape_begin(d, ox, oy, dw, dh, &wx, &wy) { return }
    let ra: *mut raster.Raster = painter.raster_of(z)
    if rx <= 0.0 {
        raster.raster_line(ra, xf_x(&t, x, y), xf_y(&t, x, y),
            xf_x(&t, x + w, y), xf_y(&t, x + w, y))
        raster.raster_line(ra, xf_x(&t, x + w, y), xf_y(&t, x + w, y),
            xf_x(&t, x + w, y + h), xf_y(&t, x + w, y + h))
        raster.raster_line(ra, xf_x(&t, x + w, y + h),
            xf_y(&t, x + w, y + h), xf_x(&t, x, y + h),
            xf_y(&t, x, y + h))
        raster.raster_line(ra, xf_x(&t, x, y + h), xf_y(&t, x, y + h),
            xf_x(&t, x, y), xf_y(&t, x, y))
    } else {
        // The same four cubics as painter.path_round, in user space.
        let K: f64 = 0.5522847498307933
        let kx: f64 = rx * K
        let ky: f64 = ry * K
        var b: Pb = Pb { ra: ra as u64, t: t, cx: 0.0, cy: 0.0,
            sx: 0.0, sy: 0.0, lx: 0.0, ly: 0.0, have: 0, open: 0 }
        pb_move(&b, x + rx, y)
        pb_line(&b, x + w - rx, y)
        pb_cubic(&b, x + w - rx + kx, y, x + w, y + ry - ky, x + w, y + ry)
        pb_line(&b, x + w, y + h - ry)
        pb_cubic(&b, x + w, y + h - ry + ky, x + w - rx + kx, y + h,
            x + w - rx, y + h)
        pb_line(&b, x + rx, y + h)
        pb_cubic(&b, x + rx - kx, y + h, x, y + h - ry + ky, x, y + h - ry)
        pb_line(&b, x, y + ry)
        pb_cubic(&b, x, y + ry - ky, x + rx - kx, y, x + rx, y)
        pb_close(&b)
    }
    fill_now(d, pa, false, wx, wy)
    (*s).shapes = (*s).shapes + 1
}

// <circle> and <ellipse>, as four cubics.
fn do_ellipse(s: *mut Svg, d: *mut Dc, pa: *mut Paint, t: Xf, t0: usize,
    t1: usize, ox: f64, oy: f64, dw: f64, dh: f64, circle: bool) {
    let p: u64 = (*s).src
    let n: usize = (*s).n
    var lcx: [u8; 2] = "cx"
    var lcy: [u8; 2] = "cy"
    var lr: [u8; 1] = "r"
    var lrx: [u8; 2] = "rx"
    var lry: [u8; 2] = "ry"
    let cx: f64 = attr_num(p, n, t0, t1, (&lcx[0]) as u64, 2, 0.0)
    let cy: f64 = attr_num(p, n, t0, t1, (&lcy[0]) as u64, 2, 0.0)
    var rx: f64 = 0.0
    var ry: f64 = 0.0
    if circle {
        rx = attr_num(p, n, t0, t1, (&lr[0]) as u64, 1, 0.0)
        ry = rx
    } else {
        rx = attr_num(p, n, t0, t1, (&lrx[0]) as u64, 2, 0.0)
        ry = attr_num(p, n, t0, t1, (&lry[0]) as u64, 2, 0.0)
    }
    if rx <= 0.0 || ry <= 0.0 { return }
    if (*pa).fill == 0 as u32 && (*d).tint == 0 as u32 { return }
    let z: *mut painter.Painter = (*d).z as *mut painter.Painter
    var wx: f64 = 0.0
    var wy: f64 = 0.0
    if !shape_begin(d, ox, oy, dw, dh, &wx, &wy) { return }
    let K: f64 = 0.5522847498307933
    let kx: f64 = rx * K
    let ky: f64 = ry * K
    var b: Pb = Pb { ra: painter.raster_of(z) as u64, t: t, cx: 0.0,
        cy: 0.0, sx: 0.0, sy: 0.0, lx: 0.0, ly: 0.0, have: 0, open: 0 }
    pb_move(&b, cx + rx, cy)
    pb_cubic(&b, cx + rx, cy + ky, cx + kx, cy + ry, cx, cy + ry)
    pb_cubic(&b, cx - kx, cy + ry, cx - rx, cy + ky, cx - rx, cy)
    pb_cubic(&b, cx - rx, cy - ky, cx - kx, cy - ry, cx, cy - ry)
    pb_cubic(&b, cx + kx, cy - ry, cx + rx, cy - ky, cx + rx, cy)
    pb_close(&b)
    fill_now(d, pa, false, wx, wy)
    (*s).shapes = (*s).shapes + 1
}

// <polyline> and <polygon>. The only difference is whether the last point
// joins back to the first.
fn do_poly(s: *mut Svg, d: *mut Dc, pa: *mut Paint, t: Xf, t0: usize,
    t1: usize, ox: f64, oy: f64, dw: f64, dh: f64, close: bool) {
    let p: u64 = (*s).src
    let n: usize = (*s).n
    var lp: [u8; 6] = "points"
    var vo: usize = 0
    let vl: usize = attr_at(p, n, t0, t1, (&lp[0]) as u64, 6, &vo)
    if vl == 0 { return }
    if (*pa).fill == 0 as u32 && (*d).tint == 0 as u32 { return }
    let z: *mut painter.Painter = (*d).z as *mut painter.Painter
    var wx: f64 = 0.0
    var wy: f64 = 0.0
    if !shape_begin(d, ox, oy, dw, dh, &wx, &wy) { return }
    var b: Pb = Pb { ra: painter.raster_of(z) as u64, t: t, cx: 0.0,
        cy: 0.0, sx: 0.0, sy: 0.0, lx: 0.0, ly: 0.0, have: 0, open: 0 }
    var i: usize = vo
    let e: usize = vo + vl
    var first: bool = true
    while i < e {
        var x: f64 = 0.0
        var ni: usize = num_at(p, e, i, &x)
        if ni == i { break }
        var y: f64 = 0.0
        let nj: usize = num_at(p, e, ni, &y)
        if nj == ni { break }
        i = nj
        if first {
            pb_move(&b, x, y)
            first = false
        } else {
            pb_line(&b, x, y)
        }
    }
    // A polyline is filled as if closed too (SVG 11.5) -- the difference
    // is only in the stroke, which is not drawn for these.
    pb_close(&b)
    fill_now(d, pa, false, wx, wy)
    (*s).shapes = (*s).shapes + 1
}

// <line> -- stroke only, it has no area.
fn do_line(s: *mut Svg, d: *mut Dc, pa: *mut Paint, t: Xf, t0: usize,
    t1: usize, ox: f64, oy: f64, dw: f64, dh: f64) {
    let p: u64 = (*s).src
    let n: usize = (*s).n
    if (*pa).stroke == 0 as u32 && (*d).tint == 0 as u32 { return }
    if (*pa).sw <= 0.0 { return }
    var l1: [u8; 2] = "x1"
    var l2: [u8; 2] = "y1"
    var l3: [u8; 2] = "x2"
    var l4: [u8; 2] = "y2"
    let x1: f64 = attr_num(p, n, t0, t1, (&l1[0]) as u64, 2, 0.0)
    let y1: f64 = attr_num(p, n, t0, t1, (&l2[0]) as u64, 2, 0.0)
    let x2: f64 = attr_num(p, n, t0, t1, (&l3[0]) as u64, 2, 0.0)
    let y2: f64 = attr_num(p, n, t0, t1, (&l4[0]) as u64, 2, 0.0)
    let z: *mut painter.Painter = (*d).z as *mut painter.Painter
    var wx: f64 = 0.0
    var wy: f64 = 0.0
    if !shape_begin(d, ox, oy, dw, dh, &wx, &wy) { return }
    stroke_seg(painter.raster_of(z), xf_x(&t, x1, y1), xf_y(&t, x1, y1),
        xf_x(&t, x2, y2), xf_y(&t, x2, y2), (*pa).sw * xf_scale(&t))
    var sp: Paint = *pa
    sp.rule = RULE_NONZERO
    fill_now(d, &sp, true, wx, wy)
    (*s).shapes = (*s).shapes + 1
}
