// SPDX-License-Identifier: MPL-2.0
import std.rt

export {
    PickList, picklist_new, picklist_clear, picklist_add, picklist_count, picklist_current, picklist_set_current,
    picklist_id_ptr, picklist_id_len, picklist_label_ptr, picklist_label_len, picklist_find_id,
}

const MAX: usize = 32
const ID_CAP: usize = 16
const LABEL_CAP: usize = 48

struct PickList {
    ids: [u8; 512],
    id_n: [usize; 32],
    labels: [u8; 1536],
    label_n: [usize; 32],
    count: usize,
    cur: i64,
}

fn picklist_new() -> PickList {
    return PickList { ids: [0 as u8; 512], id_n: [0; 32], labels: [0 as u8; 1536], label_n: [0; 32], count: 0, cur: -1 }
}

fn picklist_clear(p: *mut PickList) {
    (*p).count = 0
    (*p).cur = -1
}

fn copy_in(dst: u64, cap: usize, src: u64, n: usize) -> usize {
    var m: usize = n
    if m > cap {
        m = cap
    }
    var i: usize = 0
    while i < m {
        rt.st8(dst, i, rt.ld8(src, i))
        i = i + 1
    }
    return m
}

fn picklist_add(p: *mut PickList, idp: u64, idn: usize, lp: u64, ln: usize) -> usize {
    if (*p).count >= MAX {
        return MAX
    }
    let i: usize = (*p).count
    (*p).id_n[i] = copy_in(((&(*p).ids[0]) as u64) + ((i * ID_CAP) as u64), ID_CAP, idp, idn)
    (*p).label_n[i] = copy_in(((&(*p).labels[0]) as u64) + ((i * LABEL_CAP) as u64), LABEL_CAP, lp, ln)
    (*p).count = i + 1
    return i
}

fn picklist_count(p: *mut PickList) -> usize {
    return (*p).count
}

fn picklist_current(p: *mut PickList) -> i64 {
    return (*p).cur
}

fn picklist_set_current(p: *mut PickList, i: i64) {
    (*p).cur = i
}

fn picklist_id_ptr(p: *mut PickList, i: usize) -> u64 {
    return ((&(*p).ids[0]) as u64) + ((i * ID_CAP) as u64)
}

fn picklist_id_len(p: *mut PickList, i: usize) -> usize {
    return (*p).id_n[i]
}

fn picklist_label_ptr(p: *mut PickList, i: usize) -> u64 {
    return ((&(*p).labels[0]) as u64) + ((i * LABEL_CAP) as u64)
}

fn picklist_label_len(p: *mut PickList, i: usize) -> usize {
    return (*p).label_n[i]
}

fn picklist_find_id(p: *mut PickList, idp: u64, idn: usize) -> i64 {
    var i: usize = 0
    while i < (*p).count {
        if (*p).id_n[i] == idn && rt.mem_eq(picklist_id_ptr(p, i), idp, idn) {
            return i as i64
        }
        i = i + 1
    }
    return -1
}
