import std.rt

export { Pan, pan_new, pan_down, pan_move, pan_up, pan_cancel, pan_active, PAN_SLOP, UP_NONE, UP_TAP, UP_PAN }

const PAN_SLOP: f64 = 16.0
const ST_IDLE: u32 = 0
const ST_DOWN: u32 = 1
const ST_PAN: u32 = 2
const UP_NONE: u32 = 0
const UP_TAP: u32 = 1
const UP_PAN: u32 = 2

struct Pan {
    state: u32,
    x0: f64,
    y0: f64,
    ly: f64,
}

fn pan_new() -> Pan {
    return Pan { state: ST_IDLE, x0: 0.0, y0: 0.0, ly: 0.0 }
}

fn pan_down(p: *mut Pan, x: f64, y: f64) {
    (*p).state = ST_DOWN
    (*p).x0 = x
    (*p).y0 = y
    (*p).ly = y
}

fn absf(v: f64) -> f64 {
    if v < 0.0 { return 0.0 - v }
    return v
}

fn pan_move(p: *mut Pan, x: f64, y: f64) -> f64 {
    if (*p).state == ST_IDLE { return 0.0 }
    if (*p).state == ST_DOWN {
        if absf(x - (*p).x0) <= PAN_SLOP && absf(y - (*p).y0) <= PAN_SLOP { return 0.0 }
        (*p).state = ST_PAN
        (*p).ly = y
        return 0.0
    }
    let d: f64 = y - (*p).ly
    (*p).ly = y
    return d
}

fn pan_up(p: *mut Pan) -> u32 {
    let st: u32 = (*p).state
    (*p).state = ST_IDLE
    if st == ST_DOWN { return UP_TAP }
    if st == ST_PAN { return UP_PAN }
    return UP_NONE
}

fn pan_cancel(p: *mut Pan) {
    (*p).state = ST_IDLE
}

fn pan_active(p: *mut Pan) -> bool {
    return (*p).state == ST_PAN
}
