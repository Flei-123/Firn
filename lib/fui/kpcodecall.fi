import media.audio.source
import media.audio.all
import media.audio.wav
import media.audio.mpeg
import media.audio.ogg_vorbis
import media.audio.flac
import media.audio.opus_src
import media.audio.aac_src

export { install_for, install_every }

fn install_every(r: *mut source.Registry, fmt: u32) {
    all.register_all(r)
}

fn install_for(r: *mut source.Registry, fmt: u32) {
    if fmt == source.FMT_WAV {
        wav.register(r)
        return
    }
    if fmt == source.FMT_MP3 {
        mpeg.register(r)
        return
    }
    if fmt == source.FMT_VORBIS {
        ogg_vorbis.register(r)
        return
    }
    if fmt == source.FMT_FLAC {
        flac.register(r)
        return
    }
    if fmt == source.FMT_OPUS {
        opus_src.register(r)
        return
    }
    if fmt == source.FMT_AAC_M4A || fmt == source.FMT_AAC_ADTS {
        aac_src.register(r)
        return
    }
    all.register_all(r)
}
