// SPDX-License-Identifier: MPL-2.0
// lib/fui/themelist.fi -- THE THEMES THAT COME WITH fUi.
//
// Every fUi program offers the same choice in its settings: its own
// light/dark set (no file), these built-in themes, and whatever theme
// files the user keeps. The built-in ones stand HERE, as the very text
// a theme file would hold, and go through the SAME reader and the SAME
// check (lib/fui/themefile.fi) -- there is no second, pre-parsed form
// of them that could drift from what a user's file does.
//
// They are text in the program and not files next to it, because a
// program on Windows, on a phone or inside OrientOS has no common
// place to look for files that ship with a library. A user who wants
// to start from one prints it (`themefile --print <n>`) and edits it.
//
// Whoever adds a theme: append the text, raise THEME_COUNT, and run
// tools/fui/themefile_main.fi -- it refuses to pass while any built-in
// theme misses 4.5:1.
export {
    THEME_COUNT, builtin_text,
}

const THEME_COUNT: usize = 4

static T0: [u8; 636] = "# nord.theme -- the Nord palette (nordtheme.com, MIT) as an fUi theme.\n# Colours taken from Polar Night / Snow Storm / Frost / Aurora; where a\n# Nord colour missed 4.5:1 it was lightened until it did not\n# (text_muted, error) -- tools/fui/themefile_main.fi recomputes it.\nname = Nord\nmode = dark\nshape = osum\naccent = #88C0D0\n\nbase = #2E3440\nsurface = #3B4252\nsurface_raised = #434C5E\nbutton = #434C5E\nbutton_hover = #4C566A\nbutton_active = #5A657C\nfield = #3B4252\nfield_focus = #2E3440\nborder = #4C566A\nseparator = #434C5E\ntext = #ECEFF4\ntext_muted = #B4BCCB\ntext_disabled = #B4BCCB\nerror = #F09AA3\nwarning = #EBCB8B\nsuccess = #A3BE8C\n"

static T1: [u8; 629] = "# solarized-light.theme -- Solarized light (Ethan Schoonover, MIT) as an\n# fUi theme. base3/base2 as the surfaces, base02 as text; the accent is\n# a darkened Solarized blue, because the original (#268BD2) carries\n# neither light nor dark text at 4.5:1.\nname = Solarized Light\nmode = light\nshape = osum\naccent = #1A62A0\n\nbase = #EEE8D5\nsurface = #FDF6E3\nsurface_raised = #FFFDF5\nbutton = #E6DFC8\nbutton_hover = #DDD6BE\nbutton_active = #D2CAB0\nfield = #FDF6E3\nfield_focus = #FFFFFF\nborder = #D3CBB2\nseparator = #D3CBB2\ntext = #073642\ntext_muted = #4F5F63\ntext_disabled = #52636A\nerror = #B0201F\nwarning = #7A5A00\nsuccess = #4D6A00\n"

static T2: [u8; 548] = "# high-contrast.theme -- black ground, white text, yellow accent, square\n# corners and wider focus rings. Every text pair is above 7:1 (WCAG AAA).\nname = High Contrast\nmode = dark\nshape = classic\naccent = #FFD400\nfocus_w = 3\nborder_w = 2\n\nbase = #000000\nsurface = #0A0A0A\nsurface_raised = #1A1A1A\nbutton = #1F1F1F\nbutton_hover = #333333\nbutton_active = #474747\nfield = #000000\nfield_focus = #000000\nborder = #FFFFFF\nseparator = #808080\ntext = #FFFFFF\ntext_muted = #E0E0E0\ntext_disabled = #C8C8C8\nerror = #FF7A7A\nwarning = #FFD400\nsuccess = #6CFF8F\n"

static T3: [u8; 140] = "# classic.theme -- the built-in light colours with the square shape.\n# The shortest useful theme: two lines.\nname = Classic\nshape = classic\n"

// Built-in theme `i` (0 .. THEME_COUNT-1): its text, the length
// through `len`. 0 and length 0 for an index that does not exist.
fn builtin_text(i: usize, len: *mut usize) -> u64 {
    if i == 0 {
        *len = 636
        return (&T0[0]) as u64
    }
    if i == 1 {
        *len = 629
        return (&T1[0]) as u64
    }
    if i == 2 {
        *len = 548
        return (&T2[0]) as u64
    }
    if i == 3 {
        *len = 140
        return (&T3[0]) as u64
    }
    *len = 0
    return 0
}
