import fui.ds_tokens_prim

export {
    C_BASE, C_SURFACE, C_RAISED, C_BUTTON, C_BUTTON_HOVER, C_BUTTON_ACTIVE, C_FIELD, C_FIELD_FOCUS, C_BORDER, C_SEPARATOR, C_TEXT, C_TEXT_MUTED, C_TEXT_DISABLED, C_TEXT_ON_ACCENT, C_ACCENT, C_SELECTION, C_SELECTION_TEXT, C_ERROR, C_WARNING, C_SUCCESS,
    CORE_COUNT, core_light, core_dark, core,
}

const C_BASE: usize = 0
const C_SURFACE: usize = 1
const C_RAISED: usize = 2
const C_BUTTON: usize = 3
const C_BUTTON_HOVER: usize = 4
const C_BUTTON_ACTIVE: usize = 5
const C_FIELD: usize = 6
const C_FIELD_FOCUS: usize = 7
const C_BORDER: usize = 8
const C_SEPARATOR: usize = 9
const C_TEXT: usize = 10
const C_TEXT_MUTED: usize = 11
const C_TEXT_DISABLED: usize = 12
const C_TEXT_ON_ACCENT: usize = 13
const C_ACCENT: usize = 14
const C_SELECTION: usize = 15
const C_SELECTION_TEXT: usize = 16
const C_ERROR: usize = 17
const C_WARNING: usize = 18
const C_SUCCESS: usize = 19
const CORE_COUNT: usize = 20

#[no_gc]
fn core_light(role: usize) -> u32 {
    if role == C_BASE { return ds_tokens_prim.NEUTRAL_F3F3F3 }
    if role == C_SURFACE { return ds_tokens_prim.NEUTRAL_F9F9F9 }
    if role == C_RAISED { return ds_tokens_prim.NEUTRAL_FFFFFF }
    if role == C_BUTTON { return ds_tokens_prim.NEUTRAL_EEEEEE }
    if role == C_BUTTON_HOVER { return ds_tokens_prim.NEUTRAL_E6E6E6 }
    if role == C_BUTTON_ACTIVE { return ds_tokens_prim.NEUTRAL_DCDCDC }
    if role == C_FIELD { return ds_tokens_prim.NEUTRAL_EEEEEE }
    if role == C_FIELD_FOCUS { return ds_tokens_prim.BLUE_E6EFFC }
    if role == C_BORDER { return ds_tokens_prim.NEUTRAL_D0D0D0 }
    if role == C_SEPARATOR { return ds_tokens_prim.NEUTRAL_E0E0E0 }
    if role == C_TEXT { return ds_tokens_prim.NEUTRAL_1B1B1B }
    if role == C_TEXT_MUTED { return ds_tokens_prim.NEUTRAL_5C5C5C }
    if role == C_TEXT_DISABLED { return ds_tokens_prim.NEUTRAL_6B6B6B }
    if role == C_TEXT_ON_ACCENT { return ds_tokens_prim.NEUTRAL_FFFFFF }
    if role == C_ACCENT { return ds_tokens_prim.BLUE_0067C0 }
    if role == C_SELECTION { return ds_tokens_prim.BLUE_CCE4F7 }
    if role == C_SELECTION_TEXT { return ds_tokens_prim.NEUTRAL_1B1B1B }
    if role == C_ERROR { return ds_tokens_prim.RED_A4262C }
    if role == C_WARNING { return ds_tokens_prim.AMBER_9D5D00 }
    if role == C_SUCCESS { return ds_tokens_prim.GREEN_0F7B0F }
    return 0 as u32
}

#[no_gc]
fn core_dark(role: usize) -> u32 {
    if role == C_BASE { return ds_tokens_prim.NEUTRAL_202020 }
    if role == C_SURFACE { return ds_tokens_prim.NEUTRAL_282828 }
    if role == C_RAISED { return ds_tokens_prim.NEUTRAL_303030 }
    if role == C_BUTTON { return ds_tokens_prim.NEUTRAL_3A3A3A }
    if role == C_BUTTON_HOVER { return ds_tokens_prim.NEUTRAL_454545 }
    if role == C_BUTTON_ACTIVE { return ds_tokens_prim.NEUTRAL_2C2C2C }
    if role == C_FIELD { return ds_tokens_prim.NEUTRAL_3A3A3A }
    if role == C_FIELD_FOCUS { return ds_tokens_prim.NEUTRAL_171717 }
    if role == C_BORDER { return ds_tokens_prim.NEUTRAL_4A4A4A }
    if role == C_SEPARATOR { return ds_tokens_prim.NEUTRAL_3A3A3A }
    if role == C_TEXT { return ds_tokens_prim.NEUTRAL_FFFFFF }
    if role == C_TEXT_MUTED { return ds_tokens_prim.NEUTRAL_C4C4C4 }
    if role == C_TEXT_DISABLED { return ds_tokens_prim.NEUTRAL_B0B0B0 }
    if role == C_TEXT_ON_ACCENT { return ds_tokens_prim.NEUTRAL_000000 }
    if role == C_ACCENT { return ds_tokens_prim.BLUE_4CC2FF }
    if role == C_SELECTION { return ds_tokens_prim.BLUE_264F78 }
    if role == C_SELECTION_TEXT { return ds_tokens_prim.NEUTRAL_FFFFFF }
    if role == C_ERROR { return ds_tokens_prim.RED_FF99A4 }
    if role == C_WARNING { return ds_tokens_prim.YELLOW_FCE100 }
    if role == C_SUCCESS { return ds_tokens_prim.GREEN_6CCB5F }
    return 0 as u32
}

#[no_gc]
fn core(role: usize, dark: bool) -> u32 {
    if dark { return core_dark(role) }
    return core_light(role)
}
