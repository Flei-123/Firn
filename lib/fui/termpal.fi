// SPDX-License-Identifier: MPL-2.0
import term.termgrid

export { resolve, indexed_rgb, is_dark, blend }

const BASE_COLORS: usize = 16
const CUBE_START: u32 = 16
const GRAY_START: u32 = 232
const CUBE_SIDE: u32 = 6
const CUBE_STEP: u32 = 40
const CUBE_FIRST: u32 = 55
const GRAY_STEP: u32 = 10
const GRAY_FIRST: u32 = 8
const DARK_LUMA_LIMIT: u32 = 128
const DIM_ALPHA: u32 = 160

fn base_dark(i: u32) -> u32 {
    if i == 0 as u32 { return 0x2E3436 }
    if i == 1 as u32 { return 0xCC0000 }
    if i == 2 as u32 { return 0x4E9A06 }
    if i == 3 as u32 { return 0xC4A000 }
    if i == 4 as u32 { return 0x3465A4 }
    if i == 5 as u32 { return 0x75507B }
    if i == 6 as u32 { return 0x06989A }
    if i == 7 as u32 { return 0xD3D7CF }
    if i == 8 as u32 { return 0x555753 }
    if i == 9 as u32 { return 0xEF2929 }
    if i == 10 as u32 { return 0x8AE234 }
    if i == 11 as u32 { return 0xFCE94F }
    if i == 12 as u32 { return 0x729FCF }
    if i == 13 as u32 { return 0xAD7FA8 }
    if i == 14 as u32 { return 0x34E2E2 }
    return 0xEEEEEC
}

fn base_light(i: u32) -> u32 {
    if i == 3 as u32 { return 0x8A6D00 }
    if i == 7 as u32 { return 0x6B6E68 }
    if i == 10 as u32 { return 0x3A7D0A }
    if i == 11 as u32 { return 0x9A7B00 }
    if i == 14 as u32 { return 0x0A7F80 }
    if i == 15 as u32 { return 0x3B3D3A }
    return base_dark(i)
}

fn cube_level(v: u32) -> u32 {
    if v == 0 as u32 { return 0 as u32 }
    return CUBE_FIRST + v * CUBE_STEP
}

fn indexed_rgb(i: u32, dark: bool) -> u32 {
    if i < BASE_COLORS as u32 {
        if dark { return base_dark(i) }
        return base_light(i)
    }
    if i < GRAY_START {
        let c: u32 = i - CUBE_START
        let r: u32 = cube_level(c / (CUBE_SIDE * CUBE_SIDE))
        let g: u32 = cube_level((c / CUBE_SIDE) % CUBE_SIDE)
        let b: u32 = cube_level(c % CUBE_SIDE)
        return (r << 16) | (g << 8) | b
    }
    let v: u32 = GRAY_FIRST + (i - GRAY_START) * GRAY_STEP
    return (v << 16) | (v << 8) | v
}

fn is_dark(rgb: u32) -> bool {
    let r: u32 = (rgb >> 16) & 255 as u32
    let g: u32 = (rgb >> 8) & 255 as u32
    let b: u32 = rgb & 255 as u32
    return (r * 30 + g * 59 + b * 11) / 100 < DARK_LUMA_LIMIT
}

fn resolve(word: u32, fallback: u32, dark: bool) -> u32 {
    let kind: u32 = termgrid.color_kind(word)
    if kind == termgrid.COLOR_INDEXED { return indexed_rgb(termgrid.color_value(word), dark) }
    if kind == termgrid.COLOR_RGB { return termgrid.color_value(word) }
    return fallback & 0xFFFFFF as u32
}

fn blend(fg: u32, bg: u32) -> u32 {
    let a: u32 = DIM_ALPHA
    let r: u32 = (((fg >> 16) & 255 as u32) * a + ((bg >> 16) & 255 as u32) * (255 as u32 - a)) / 255 as u32
    let g: u32 = (((fg >> 8) & 255 as u32) * a + ((bg >> 8) & 255 as u32) * (255 as u32 - a)) / 255 as u32
    let b: u32 = ((fg & 255 as u32) * a + (bg & 255 as u32) * (255 as u32 - a)) / 255 as u32
    return (r << 16) | (g << 8) | b
}
