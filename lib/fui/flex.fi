profile kernel
// SPDX-License-Identifier: MPL-2.0
// lib/fui/flex.fi -- FLEXBOX, WIE CSS SIE MEINT.
//
// ========================================================= WARUM ES DAS GIBT
//
// lib/fui/layout.fi kann einen Stapel und ein Gitter. Das reicht fuer
// eine Werkzeugleiste und fuer eine Maske, aber nicht fuer das, was
// eine heutige Oberflaeche an Verteilung verlangt: "die drei Knoepfe
// rechts, der Rest Luft", "gleicher Abstand zwischen allen, keiner
// aussen", "wenn es eng wird, schrumpft NUR das Textfeld, und nur bis
// zu seiner Mindestbreite". Wer das mit `box_layout` nachbaut, rechnet
// jedes Mal von Hand -- und genau dieses Handrechnen steht in
// lib/browser/chrome.fi und ist der Grund, warum layout.fi ueberhaupt
// gebaut wurde.
//
// ==================================================== ES ERSETZT NICHTS
//
// layout.fi BLEIBT. Kein zweites, konkurrierendes Layoutsystem: flex.fi
// benutzt denselben `Rect`, dasselbe Mess-Protokoll (der Aufrufer haelt
// seine Felder, A1 aus layout.fi gilt weiter) und dieselbe Regel fuer
// den Rest der Ganzzahldivision. Wer einen Stapel will, nimmt `Box`;
// wer Verteilung, Umbruch und Schrumpfen will, nimmt `FlexBox`.
//
// ======================================================= WARUM IM KERN
//
// `profile kernel` in Zeile 1, wie layout.fi. Ein Layout rechnet nur.
// GANZZAHLIG: eine Pixelposition ist eine ganze Zahl, und ein Layout,
// das auf halben Pixeln rechnet, erzeugt genau die unscharfen Kanten,
// die man nie wieder los wird. Die Anteile (grow/shrink) sind darum
// PROMILLE als i64 und keine f64 -- 1000 heisst "1.0".
//
// ================================================== DIE VERTEILUNG
//
// Der Ort, an dem eine Flexbox richtig oder falsch ist, ist die
// NACHVERTEILUNG. Ein Kind, das an seiner Mindest- oder Hoechstbreite
// festklemmt, nimmt seinen Anteil nicht an -- der frei gewordene Platz
// muss unter den UEBRIGEN noch einmal verteilt werden, und zwar so
// lange, bis niemand mehr neu festklemmt (css-flexbox-1, 9.7). Wer nur
// einmal verteilt und danach klemmt, hat am Ende eine Zeile, die nicht
// die volle Breite fuellt. Genau das prueft tools/fui/flex_main.fi mit
// von Hand gerechneten Pixeln nach.
import fui.layout

export {
    // Richtungen
    FLEX_ROW, FLEX_ROW_REVERSE, FLEX_COLUMN, FLEX_COLUMN_REVERSE,
    // justify-content
    JUSTIFY_START, JUSTIFY_END, JUSTIFY_CENTER, JUSTIFY_BETWEEN,
    JUSTIFY_AROUND, JUSTIFY_EVENLY,
    // align-items / align-self
    AL_AUTO, AL_START, AL_END, AL_CENTER, AL_STRETCH, AL_BASELINE,
    // align-content -- EIGENE Werte, siehe unten
    AC_START, AC_END, AC_CENTER, AC_STRETCH, AC_BETWEEN, AC_AROUND,
    AC_EVENLY,
    // flex-wrap
    WRAP_NONE, WRAP_WRAP, WRAP_REVERSE,
    // Die Typen
    FlexItem, flex_item, item_set_flex, item_set_bounds,
    item_set_align, item_set_baseline,
    FlexBox, flexbox_new, flex_set_gap, flex_set_justify,
    flex_set_align_items, flex_set_align_content, flex_set_wrap,
    flex_set_padding,
    // Das Rechnen
    flex_measure_main, flex_measure_cross, flex_layout,
    flex_line_count,
    // Die Richtungsfrage -- EINE Stelle, auch fuer lib/fui/scene.fi
    flex_is_row,
    // Die Bruecke zum Mess-Protokoll
    flex_px, flex_item_from_pref,
    // Die Schrittweite eines Kindes im Feld -- gemessen, nicht geglaubt
    flex_item_stride,
    FLEX_MAX,
}

// ============================================================ DIE WERTE
const FLEX_ROW: u32 = 0
const FLEX_ROW_REVERSE: u32 = 1
const FLEX_COLUMN: u32 = 2
const FLEX_COLUMN_REVERSE: u32 = 3

const JUSTIFY_START: u32 = 0
const JUSTIFY_END: u32 = 1
const JUSTIFY_CENTER: u32 = 2
const JUSTIFY_BETWEEN: u32 = 3
const JUSTIFY_AROUND: u32 = 4
const JUSTIFY_EVENLY: u32 = 5

const AL_AUTO: u32 = 0
const AL_START: u32 = 1
const AL_END: u32 = 2
const AL_CENTER: u32 = 3
const AL_STRETCH: u32 = 4
const AL_BASELINE: u32 = 5

// align-content hat EIGENE Werte und leiht sich weder die von
// `align-items` noch die von `justify-content`. Der Grund ist nicht
// Ordnungsliebe: AL_START ist 1 und JUSTIFY_END ist ebenfalls 1, und
// wer die eine Zahl in die andere Rechnung gibt, bekommt schweigend
// die falsche Verteilung. CSS kennt fuer align-content ausserdem
// `stretch` UND `space-between` -- zwei Dinge, die es in keiner der
// beiden anderen Listen zusammen gibt.
const AC_START: u32 = 0
const AC_END: u32 = 1
const AC_CENTER: u32 = 2
const AC_STRETCH: u32 = 3
const AC_BETWEEN: u32 = 4
const AC_AROUND: u32 = 5
const AC_EVENLY: u32 = 6

const WRAP_NONE: u32 = 0
const WRAP_WRAP: u32 = 1
const WRAP_REVERSE: u32 = 2

// Wie viele Kinder eine Flexbox in einem Aufruf verteilt. Fest, weil
// der Kern keinen Allokator hat (A1 aus layout.fi: der Aufrufer haelt
// seine Felder, die Zeilenbuchhaltung aber braucht Platz).
const FLEX_MAX: usize = 64

// ============================================================ EIN KIND
//
// Ein Kind ist ein WERT, kein Zeiger auf ein Widget: die Flexbox soll
// auch Dinge verteilen koennen, die keine Widgets sind (Spalten einer
// Tabelle, Kacheln eines Rasters). Wer Widgets verteilt, fuellt `basis`
// und `cross` aus `render.pref_of` -- das ist das vorhandene
// Mess-Protokoll, und es bleibt das einzige.
struct FlexItem {
    basis: i64,      // flex-basis, in Pixeln (auto = die gemessene Groesse)
    cross: i64,      // die gewuenschte Groesse QUER
    grow: i64,       // Promille: 1000 = flex-grow: 1
    shrink: i64,     // Promille: 1000 = flex-shrink: 1
    min_main: i64,
    max_main: i64,   // <= 0 heisst "keine obere Schranke"
    align: u32,      // align-self, AL_AUTO = was der Behaelter sagt
    baseline: i64,   // Abstand Oberkante -> Grundlinie, fuer AL_BASELINE
}

fn flex_item(basis: i64, cross: i64) -> FlexItem {
    return FlexItem { basis: basis, cross: cross, grow: 0, shrink: 1000,
        min_main: 0, max_main: 0, align: AL_AUTO, baseline: 0 }
}

fn item_set_flex(k: *mut FlexItem, grow: i64, shrink: i64, basis: i64) {
    (*k).grow = grow
    (*k).shrink = shrink
    (*k).basis = basis
}

fn item_set_bounds(k: *mut FlexItem, min_main: i64, max_main: i64) {
    (*k).min_main = min_main
    (*k).max_main = max_main
}

fn item_set_align(k: *mut FlexItem, a: u32) { (*k).align = a }
fn item_set_baseline(k: *mut FlexItem, b: i64) { (*k).baseline = b }

// -------------------------------------- DIE BRUECKE ZUM MESS-PROTOKOLL
//
// `render.pref_of` misst in f64 -- eine Schrift hat nun einmal keine
// ganzzahlige Breite. Die Flexbox rechnet ganzzahlig. Dazwischen
// gehoert GENAU EINE Umrechnung, sonst rundet jede Aufrufstelle anders
// und zwei Kaesten mit demselben Text werden verschieden breit.
//
// Gerundet wird AUFWAERTS: die gemessene Groesse ist das Minimum, das
// der Inhalt braucht: ein halber Bildpunkt zu wenig schneidet den
// letzten Buchstaben an, ein halber zu viel faellt niemandem auf.
//
// flex.fi importiert dafuer NICHTS. Es sind reine Zahlenfunktionen,
// der Aufrufer misst und reicht die Zahlen herein -- dieselbe Richtung
// der Abhaengigkeit wie bei layout.fi, das ebenfalls Zahlen nimmt und
// keine Widgets. `#[allow_fp]` wie in lib/math/core_math.fi: im Kern
// gehoeren die SSE-Register dem unterbrochenen Faden, und wer sie
// anfasst, sagt es hin.
#[allow_fp]
fn flex_px(v: f64) -> i64 {
    if v <= 0.0 {
        return 0
    }
    let ganz: i64 = v as i64
    if (ganz as f64) < v {
        return ganz + 1
    }
    return ganz
}

// Aus einem Messergebnis (pw, ph) wird ein Kind: was in Hauptrichtung
// liegt, haengt an der Richtung des Behaelters -- bei einer Zeile ist
// die Breite die Basis, bei einer Spalte die Hoehe. Die gemessene
// Groesse ist zugleich die Mindestgroesse, damit Schrumpfen den Inhalt
// nicht abschneidet; wer das nicht will, ruft danach
// `item_set_bounds`.
#[allow_fp]
fn flex_item_from_pref(pw: f64, ph: f64, zeile: bool) -> FlexItem {
    let b: i64 = flex_px(pw)
    let c: i64 = flex_px(ph)
    if zeile {
        var k: FlexItem = flex_item(b, c)
        k.min_main = b
        return k
    }
    var k: FlexItem = flex_item(c, b)
    k.min_main = c
    return k
}

// ========================================================= DER BEHAELTER
struct FlexBox {
    dir: u32,
    justify: u32,
    align_items: u32,
    align_content: u32,
    wrap: u32,
    gap_main: i64,
    gap_cross: i64,
    pad_l: i64,
    pad_t: i64,
    pad_r: i64,
    pad_b: i64,
}

fn flexbox_new(dir: u32) -> FlexBox {
    return FlexBox { dir: dir, justify: JUSTIFY_START,
        align_items: AL_STRETCH, align_content: AC_STRETCH,
        wrap: WRAP_NONE,
        gap_main: 0, gap_cross: 0,
        pad_l: 0, pad_t: 0, pad_r: 0, pad_b: 0 }
}

// gap: Haupt- und Querrichtung GETRENNT, wie `row-gap` und `column-gap`.
fn flex_set_gap(s: *mut FlexBox, main: i64, cross: i64) {
    (*s).gap_main = main
    (*s).gap_cross = cross
}

fn flex_set_justify(s: *mut FlexBox, j: u32) { (*s).justify = j }
fn flex_set_align_items(s: *mut FlexBox, a: u32) { (*s).align_items = a }
fn flex_set_align_content(s: *mut FlexBox, a: u32) { (*s).align_content = a }
fn flex_set_wrap(s: *mut FlexBox, w: u32) { (*s).wrap = w }

fn flex_set_padding(s: *mut FlexBox, l: i64, t: i64, r: i64, b: i64) {
    (*s).pad_l = l
    (*s).pad_t = t
    (*s).pad_r = r
    (*s).pad_b = b
}

// IST DIESER KASTEN EINE ZEILE? Die Frage wird an EINER Stelle
// beantwortet, und sie ist exportiert: lib/fui/scene.fi stellt sie
// genauso (ein Kasten misst seine Hauptachse waagerecht oder
// senkrecht), und ein zweites `(*fb).dir == FLEX_ROW` dort waere beim
// naechsten Richtungswert (etwa einer Schreibrichtung von rechts nach
// links) an einer der beiden Stellen falsch.
fn flex_is_row(s: *mut FlexBox) -> bool {
    return (*s).dir == FLEX_ROW || (*s).dir == FLEX_ROW_REVERSE
}

fn ist_rueckwaerts(s: *mut FlexBox) -> bool {
    return (*s).dir == FLEX_ROW_REVERSE || (*s).dir == FLEX_COLUMN_REVERSE
}

// DIE SCHRITTWEITE EINES `FlexItem` IM FELD. Ein Feld von Kindern wird
// als `*mut FlexItem` weitergereicht; wer darin das i-te Kind sucht,
// rechnet seine Adresse aus. Die Zahl dafuer steht nirgends als Ziffer,
// sie wird GEMESSEN -- die Differenz zweier Nachbarn eines echten
// Feldes ist das, was der Uebersetzer wirklich legt. lib/fui/scene.fi
// fuellt dasselbe Feld und holt die Schrittweite von hier; ein zweiter
// Ort dafuer hiesse, dass ein neues Feld in `FlexItem` an EINER Stelle
// unbemerkt bliebe und jedes zweite Kind an der falschen Adresse landet.
fn flex_item_stride() -> usize {
    var probe: [FlexItem; 2] = [flex_item(0, 0); 2]
    return ((&probe[1]) as u64 - (&probe[0]) as u64) as usize
}

fn item_at(k: *mut FlexItem, i: usize) -> *mut FlexItem {
    return (k as u64 + (i * flex_item_stride()) as u64) as *mut FlexItem
}

// Ein Kind auf seine Schranken klemmen.
fn klemme(k: *mut FlexItem, v: i64) -> i64 {
    var x: i64 = v
    if x < (*k).min_main {
        x = (*k).min_main
    }
    if (*k).max_main > 0 && x > (*k).max_main {
        x = (*k).max_main
    }
    if x < 0 {
        x = 0
    }
    return x
}

// ------------------------------------------------------------ MESSEN
//
// Die Groesse, die der Behaelter in HAUPTRICHTUNG braucht, wenn nichts
// waechst und nichts schrumpft: die Summe der Basen, die Luecken und
// die Innenraender. Das ist das Gegenstueck zu `box_measure`.
fn flex_measure_main(s: *mut FlexBox, k: *mut FlexItem, n: usize) -> i64 {
    var summe: i64 = 0
    var i: usize = 0
    while i < n {
        summe = summe + klemme(item_at(k, i), (*item_at(k, i)).basis)
        i = i + 1
    }
    if n > 1 {
        summe = summe + (*s).gap_main * ((n - 1) as i64)
    }
    if flex_is_row(s) {
        return summe + (*s).pad_l + (*s).pad_r
    }
    return summe + (*s).pad_t + (*s).pad_b
}

// Die Groesse QUER: das groesste Kind (ohne Umbruch).
fn flex_measure_cross(s: *mut FlexBox, k: *mut FlexItem, n: usize) -> i64 {
    var groesstes: i64 = 0
    var i: usize = 0
    while i < n {
        let c: i64 = (*item_at(k, i)).cross
        if c > groesstes {
            groesstes = c
        }
        i = i + 1
    }
    if flex_is_row(s) {
        return groesstes + (*s).pad_t + (*s).pad_b
    }
    return groesstes + (*s).pad_l + (*s).pad_r
}

// Wie viele Zeilen der Umbruch ergibt. Der Aufrufer braucht das, um zu
// wissen, wie hoch der Behaelter werden muss, BEVOR er verteilt.
fn flex_line_count(s: *mut FlexBox, k: *mut FlexItem, n: usize,
    space: layout.Rect) -> usize {
    if (*s).wrap == WRAP_NONE || n == 0 {
        if n == 0 {
            return 0
        }
        return 1
    }
    let platz: i64 = haupt_platz(s, space)
    var zeilen: usize = 1
    var lauf: i64 = 0
    var i: usize = 0
    while i < n {
        let b: i64 = klemme(item_at(k, i), (*item_at(k, i)).basis)
        var nach: i64 = lauf + b
        if lauf > 0 {
            nach = nach + (*s).gap_main
        }
        if lauf > 0 && nach > platz {
            zeilen = zeilen + 1
            lauf = b
        } else {
            lauf = nach
        }
        i = i + 1
    }
    return zeilen
}

fn haupt_platz(s: *mut FlexBox, space: layout.Rect) -> i64 {
    if flex_is_row(s) {
        return space.w - (*s).pad_l - (*s).pad_r
    }
    return space.h - (*s).pad_t - (*s).pad_b
}

// ------------------------------------------------------------ VERTEILEN
//
// Der Kern: `groessen` bekommt fuer jedes Kind einer Zeile die
// Hauptgroesse. Freier Platz wird nach `grow` verteilt, fehlender nach
// `shrink` MAL BASIS gewichtet (so macht es CSS: ein breites Kind gibt
// mehr her als ein schmales), und wer dabei an eine Schranke stoesst,
// wird eingefroren; der Rest wird NEU verteilt, bis niemand mehr
// einfriert.
// DAS SCHRUMPFGEWICHT, IN TAUSENDSTELN.
//
// 20.09.2026 -- ein Fehler, den man nur an Zahlen sieht. Hier stand
// `shrink * basis / 1000`, also die Division MITTEN in der Rechnung.
// `shrink` ist in Promille gefuehrt (250 = flex-shrink: 0.25), und
// damit verschwand jedes Kind, dessen Produkt unter 1000 lag,
// vollstaendig aus der Verteilung: ein Kind mit shrink 0.25 und
// Basis 3 bekam das Gewicht 0 und gab KEINEN Bildpunkt her, obwohl
// CSS ihm 0.75 Anteile zuspricht. Die Nachbarn mussten den Mangel
// allein tragen, und die Zeile war um genau diesen Betrag falsch
// verteilt.
//
// Das Gewicht bleibt darum in Tausendsteln stehen; geteilt wird ERST
// beim Anteil (`rest * gewicht_i / gewicht_summe`), wo Zaehler und
// Nenner dieselbe Einheit haben und sie sich herauskuerzt. Der Wert
// bleibt in i64 bequem: 64 Kinder mal 1000 Promille mal ein paar
// tausend Bildpunkte Basis sind rund 10^8.
fn schrumpfgewicht(it: *mut FlexItem) -> i64 {
    let g: i64 = (*it).shrink * (*it).basis
    if g < 0 {
        return 0
    }
    return g
}

fn verteile(s: *mut FlexBox, k: *mut FlexItem, von: usize, n: usize,
    platz: i64, groessen: *mut i64, frozen: *mut i64) {
    var i: usize = 0
    var basis_summe: i64 = 0
    while i < n {
        let it: *mut FlexItem = item_at(k, von + i)
        st(groessen, i, (*it).basis)
        st(frozen, i, 0)
        basis_summe = basis_summe + (*it).basis
        i = i + 1
    }
    var luecken: i64 = 0
    if n > 1 {
        luecken = (*s).gap_main * ((n - 1) as i64)
    }
    // Kinder, deren Basis schon ausserhalb ihrer Schranken liegt,
    // frieren sofort ein -- sonst verteilt die erste Runde Platz an
    // jemanden, der ihn gar nicht annehmen kann.
    i = 0
    while i < n {
        let it: *mut FlexItem = item_at(k, von + i)
        let g: i64 = klemme(it, ld(groessen, i))
        if g != ld(groessen, i) {
            st(groessen, i, g)
            st(frozen, i, 1)
        }
        i = i + 1
    }
    var runde: usize = 0
    while runde <= n {
        var summe: i64 = 0
        i = 0
        while i < n {
            summe = summe + ld(groessen, i)
            i = i + 1
        }
        let rest: i64 = platz - luecken - summe
        if rest == 0 {
            return
        }
        // Die Gewichte der noch beweglichen Kinder.
        var gewicht: i64 = 0
        i = 0
        while i < n {
            if ld(frozen, i) == 0 {
                let it: *mut FlexItem = item_at(k, von + i)
                if rest > 0 {
                    gewicht = gewicht + (*it).grow
                } else {
                    gewicht = gewicht + schrumpfgewicht(it)
                }
            }
            i = i + 1
        }
        if gewicht <= 0 {
            return
        }
        // Verteilen, und wer dabei klemmt, friert ein.
        var neu_gefroren: bool = false
        var vergeben: i64 = 0
        var letzter: usize = n
        i = 0
        while i < n {
            if ld(frozen, i) == 0 {
                let it: *mut FlexItem = item_at(k, von + i)
                var anteil: i64 = 0
                if rest > 0 {
                    anteil = rest * (*it).grow / gewicht
                } else {
                    anteil = rest * schrumpfgewicht(it) / gewicht
                }
                let roh: i64 = ld(groessen, i) + anteil
                let ge: i64 = klemme(it, roh)
                st(groessen, i, ge)
                vergeben = vergeben + anteil
                letzter = i
                if ge != roh {
                    st(frozen, i, 1)
                    neu_gefroren = true
                }
            }
            i = i + 1
        }
        // DER REST DER GANZZAHLDIVISION. Er geht an das letzte bewegliche
        // Kind, damit die Summe der Teile EXAKT den Platz fuellt -- genau
        // die Regel, die box_layout schon hat.
        if !neu_gefroren && letzter < n {
            let fehlt: i64 = rest - vergeben
            if fehlt != 0 {
                let it: *mut FlexItem = item_at(k, von + letzter)
                let ge: i64 = klemme(it, ld(groessen, letzter) + fehlt)
                st(groessen, letzter, ge)
            }
            return
        }
        if !neu_gefroren {
            return
        }
        runde = runde + 1
    }
}

fn ld(p: *mut i64, i: usize) -> i64 {
    return *((p as u64 + (i * 8) as u64) as *mut i64)
}

fn st(p: *mut i64, i: usize, v: i64) {
    *((p as u64 + (i * 8) as u64) as *mut i64) = v
}

// Der Anfang und der Abstand, die `justify-content` vorgibt.
fn justify_anfang(j: u32, frei: i64, n: usize) -> i64 {
    if frei <= 0 {
        return 0
    }
    if j == JUSTIFY_END {
        return frei
    }
    if j == JUSTIFY_CENTER {
        return frei / 2
    }
    if j == JUSTIFY_AROUND {
        return frei / ((n * 2) as i64)
    }
    if j == JUSTIFY_EVENLY {
        return frei / ((n + 1) as i64)
    }
    return 0
}

fn justify_abstand(j: u32, frei: i64, n: usize) -> i64 {
    if frei <= 0 || n == 0 {
        return 0
    }
    if j == JUSTIFY_BETWEEN {
        if n < 2 {
            return 0
        }
        return frei / ((n - 1) as i64)
    }
    if j == JUSTIFY_AROUND {
        return frei / (n as i64)
    }
    if j == JUSTIFY_EVENLY {
        return frei / ((n + 1) as i64)
    }
    return 0
}

// ------------------------------------------------------- ALIGN-CONTENT
//
// Die Verteilung der ZEILEN quer -- die eigene Rechnung, nicht die von
// `justify-content` geliehene. Zwei Gruende: die Werte sind andere
// (siehe AC_*), und `stretch` gibt es drueben gar nicht. `stretch`
// verteilt den freien Platz auf die Zeilen SELBST und laesst danach
// keinen Anfang und keinen Abstand uebrig; alles andere laesst die
// Zeilenhoehen, wie sie sind, und schiebt nur.
//
// `quer` zeigt auf `zahl` Zeilenhoehen und wird bei AC_STRETCH
// veraendert. Zurueck kommt der freie Platz, der NACH dem Strecken
// noch zu verschieben ist; Anfang und Abstand landen in `anfang` und
// `abstand`.
fn inhalt_verteilen(a: u32, zahl: usize, frei_in: i64, quer: *mut i64,
    anfang: *mut i64, abstand: *mut i64) {
    *anfang = 0
    *abstand = 0
    if zahl == 0 || frei_in <= 0 {
        return
    }
    var frei: i64 = frei_in
    if a == AC_STRETCH {
        // Jede Zeile bekommt denselben Anteil, und der Rest der
        // Ganzzahldivision geht an die letzte -- dieselbe Regel wie
        // bei der Hauptrichtung, damit die Summe EXAKT aufgeht und
        // unten kein leerer Streifen bleibt.
        let je: i64 = frei / (zahl as i64)
        var vergeben: i64 = 0
        var z: usize = 0
        while z < zahl {
            let p: *mut i64 = (quer as u64 + (z * 8) as u64) as *mut i64
            *p = *p + je
            vergeben = vergeben + je
            z = z + 1
        }
        let letzte: *mut i64 =
            (quer as u64 + ((zahl - 1) * 8) as u64) as *mut i64
        *letzte = *letzte + (frei - vergeben)
        return
    }
    if a == AC_END {
        *anfang = frei
        return
    }
    if a == AC_CENTER {
        *anfang = frei / 2
        return
    }
    if a == AC_BETWEEN {
        if zahl > 1 {
            *abstand = frei / ((zahl - 1) as i64)
        }
        return
    }
    if a == AC_AROUND {
        // Jede Zeile bekommt gleich viel Luft, halb davor, halb
        // dahinter -- aussen also eine halbe, innen eine ganze.
        let je: i64 = frei / (zahl as i64)
        *anfang = je / 2
        *abstand = je
        return
    }
    if a == AC_EVENLY {
        let je: i64 = frei / ((zahl + 1) as i64)
        *anfang = je
        *abstand = je
        return
    }
}

// ------------------------------------------------------------- SETZEN
//
// Die fertigen Rechtecke landen in `out` -- ein Feld des Aufrufers,
// genau wie bei `box_layout`. `zeile_hoehen` ist Arbeitsspeicher fuer
// die Querverteilung und muss FLEX_MAX Eintraege fassen.
fn flex_layout(s: *mut FlexBox, space: layout.Rect, k: *mut FlexItem,
    n: usize, out: *mut layout.Rect, groessen: *mut i64,
    frozen: *mut i64) {
    if n == 0 {
        return
    }
    let inner: layout.Rect = layout.rect_shrink(space, (*s).pad_l,
        (*s).pad_t, (*s).pad_r, (*s).pad_b)
    let platz: i64 = haupt_platz(s, space)
    // ---- Zeilen bilden
    var zeilen_start: [usize; 64] = [0; 64]
    var zeilen_n: [usize; 64] = [0; 64]
    var zahl: usize = 0
    if (*s).wrap == WRAP_NONE {
        zeilen_start[0] = 0
        zeilen_n[0] = n
        zahl = 1
    } else {
        var lauf: i64 = 0
        var anfang: usize = 0
        var i: usize = 0
        while i < n {
            let b: i64 = klemme(item_at(k, i), (*item_at(k, i)).basis)
            var nach: i64 = lauf + b
            if lauf > 0 {
                nach = nach + (*s).gap_main
            }
            if lauf > 0 && nach > platz {
                zeilen_start[zahl] = anfang
                zeilen_n[zahl] = i - anfang
                zahl = zahl + 1
                anfang = i
                lauf = b
            } else {
                lauf = nach
            }
            i = i + 1
        }
        zeilen_start[zahl] = anfang
        zeilen_n[zahl] = n - anfang
        zahl = zahl + 1
    }
    // ---- Die Hoehe einer Zeile: das groesste Kind darin.
    var zeilen_quer: [i64; 64] = [0; 64]
    var quer_summe: i64 = 0
    var z: usize = 0
    while z < zahl {
        var gr: i64 = 0
        var i: usize = 0
        while i < zeilen_n[z] {
            let c: i64 = (*item_at(k, zeilen_start[z] + i)).cross
            if c > gr {
                gr = c
            }
            i = i + 1
        }
        zeilen_quer[z] = gr
        quer_summe = quer_summe + gr
        z = z + 1
    }
    var quer_ganz: i64 = inner.h
    if !flex_is_row(s) {
        quer_ganz = inner.w
    }
    var quer_luecken: i64 = 0
    if zahl > 1 {
        quer_luecken = (*s).gap_cross * ((zahl - 1) as i64)
    }
    // Ohne Umbruch gibt es genau eine Zeile, und sie fuellt die
    // Querrichtung ganz -- sonst haengt `align-items: stretch` in der
    // Luft. MIT Umbruch entscheidet darueber align-content, auch bei
    // nur einer Zeile.
    if (*s).wrap == WRAP_NONE {
        zeilen_quer[0] = quer_ganz
        quer_summe = quer_ganz
    }
    var quer_frei: i64 = quer_ganz - quer_summe - quer_luecken
    if quer_frei < 0 {
        quer_frei = 0
    }
    var inhalt_anfang: i64 = 0
    var inhalt_abstand: i64 = 0
    inhalt_verteilen((*s).align_content, zahl, quer_frei,
        (&zeilen_quer[0]) as *mut i64, &inhalt_anfang, &inhalt_abstand)
    var quer_lauf: i64 = 0
    if flex_is_row(s) {
        quer_lauf = inner.y
    } else {
        quer_lauf = inner.x
    }
    quer_lauf = quer_lauf + inhalt_anfang
    // ---- Jede Zeile setzen
    z = 0
    while z < zahl {
        var zi: usize = z
        if (*s).wrap == WRAP_REVERSE {
            zi = zahl - 1 - z
        }
        let von: usize = zeilen_start[zi]
        let m: usize = zeilen_n[zi]
        verteile(s, k, von, m, platz, groessen, frozen)
        var summe: i64 = 0
        var i: usize = 0
        while i < m {
            summe = summe + ld(groessen, i)
            i = i + 1
        }
        var luecken: i64 = 0
        if m > 1 {
            luecken = (*s).gap_main * ((m - 1) as i64)
        }
        var frei: i64 = platz - summe - luecken
        if frei < 0 {
            frei = 0
        }
        var haupt_anfang: i64 = inner.x
        if !flex_is_row(s) {
            haupt_anfang = inner.y
        }
        var pos: i64 = haupt_anfang + justify_anfang((*s).justify, frei, m)
        let extra: i64 = justify_abstand((*s).justify, frei, m)
        // Die Grundlinie der Zeile: die tiefste ueber alle Kinder, die
        // sich danach ausrichten wollen.
        var grundlinie: i64 = 0
        i = 0
        while i < m {
            let it: *mut FlexItem = item_at(k, von + i)
            var al: u32 = (*it).align
            if al == AL_AUTO {
                al = (*s).align_items
            }
            if al == AL_BASELINE && (*it).baseline > grundlinie {
                grundlinie = (*it).baseline
            }
            i = i + 1
        }
        i = 0
        while i < m {
            let ii: usize = i
            let it: *mut FlexItem = item_at(k, von + ii)
            let haupt: i64 = ld(groessen, ii)
            var al: u32 = (*it).align
            if al == AL_AUTO {
                al = (*s).align_items
            }
            var quer: i64 = (*it).cross
            var quer_pos: i64 = quer_lauf
            if al == AL_STRETCH {
                quer = zeilen_quer[zi]
            } else if al == AL_CENTER {
                quer_pos = quer_pos + (zeilen_quer[zi] - quer) / 2
            } else if al == AL_END {
                quer_pos = quer_pos + zeilen_quer[zi] - quer
            } else if al == AL_BASELINE {
                quer_pos = quer_pos + grundlinie - (*it).baseline
            }
            // *_REVERSE dreht die HAUPTACHSE um, nicht die Reihenfolge
            // im Feld: in CSS liegt bei `row-reverse` der Anfang der
            // Achse rechts. Darum wird durchgehend vorwaerts gerechnet
            // und die fertige Lage am Ende gespiegelt -- so stimmt
            // auch `justify-content: flex-start`, das dann rechts
            // buendig packt. Wer stattdessen nur die Reihenfolge
            // tauscht, bekommt bei freiem Platz eine Zeile, die auf
            // der falschen Seite klebt.
            var mpos: i64 = pos
            if ist_rueckwaerts(s) {
                mpos = haupt_anfang + platz - (pos - haupt_anfang) - haupt
            }
            if flex_is_row(s) {
                *((out as u64 + ((von + ii) * 32) as u64) as *mut layout.Rect) =
                    layout.rect_new(mpos, quer_pos, haupt, quer)
            } else {
                *((out as u64 + ((von + ii) * 32) as u64) as *mut layout.Rect) =
                    layout.rect_new(quer_pos, mpos, quer, haupt)
            }
            pos = pos + haupt + (*s).gap_main + extra
            i = i + 1
        }
        quer_lauf = quer_lauf + zeilen_quer[zi] + (*s).gap_cross
            + inhalt_abstand
        z = z + 1
    }
}
