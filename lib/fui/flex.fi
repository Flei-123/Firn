profile kernel
// SPDX-License-Identifier: MPL-2.0
// lib/fui/flex.fi -- FLEXBOX, AS CSS MEANS IT.
//
// ========================================================= WHY IT EXISTS
//
// lib/fui/layout.fi can do a stack and a grid. That suffices for
// a toolbar and for a form, but not for what
// a present-day surface demands in distribution: "the three buttons
// on the right, the rest air", "equal spacing between all, none
// outside", "when it gets tight, ONLY the text field shrinks, and only down
// to its minimum width". Whoever rebuilds that with `box_layout` calculates
// by hand every time -- and exactly this hand calculation stands
// in lib/browser/chrome.fi and is the reason why layout.fi was built at all.
//
// ==================================================== IT REPLACES NOTHING
//
// layout.fi STAYS. No second, competing layout system: flex.fi
// uses the same `Rect`, the same measuring protocol (the caller holds
// his arrays, A1 from layout.fi still applies) and the same rule for
// the remainder of the integer division. Whoever wants a stack takes `Box`;
// whoever wants distribution, wrapping and shrinking takes `FlexBox`.
//
// ======================================================= WHY IN THE KERNEL
//
// `profile kernel` in line 1, like layout.fi. A layout only calculates.
// INTEGER: a pixel position is a whole number, and a layout
// that calculates on half pixels produces exactly the blurry edges
// that you never get rid of again. The shares (grow/shrink) are therefore
// PER MILLE as i64 and no f64 -- 1000 means "1.0".
//
// ================================================== THE DISTRIBUTION
//
// The place at which a flexbox is right or wrong is the
// REDISTRIBUTION. A child that clamps at its minimum or maximum width
// does not accept its share -- the space that became free
// has to be distributed once more among the OTHERS, and
// until nobody clamps anew (css-flexbox-1, 9.7). Whoever distributes only
// once and clamps afterwards has in the end a line that does not
// fill the full width. Exactly that is checked by tools/fui/flex_main.fi with
// pixels calculated by hand.
import fui.layout

export {
    // Richtungen
    FLEX_ROW, FLEX_ROW_REVERSE, FLEX_COLUMN, FLEX_COLUMN_REVERSE,
    // justify-content
    JUSTIFY_START, JUSTIFY_END, JUSTIFY_CENTER, JUSTIFY_BETWEEN,
    JUSTIFY_AROUND, JUSTIFY_EVENLY,
    // align-items / align-self
    AL_AUTO, AL_START, AL_END, AL_CENTER, AL_STRETCH, AL_BASELINE,
    // align-content -- OWN values, see below
    AC_START, AC_END, AC_CENTER, AC_STRETCH, AC_BETWEEN, AC_AROUND,
    AC_EVENLY,
    // flex-wrap
    WRAP_NONE, WRAP_WRAP, WRAP_REVERSE,
    // Die Typen
    FlexItem, flex_item, item_set_flex, item_set_bounds,
    item_set_align, item_set_baseline,
    FlexBox, flexbox_new, flex_set_gap, flex_set_justify,
    flex_set_align_items, flex_set_align_content, flex_set_wrap,
    flex_set_padding,
    // The calculating
    flex_measure_main, flex_measure_cross, flex_measure_cross_wrap,
    flex_layout,
    flex_line_count,
    // The direction question -- ONE place, also for lib/fui/scene.fi
    flex_is_row,
    // The bridge to the measuring protocol
    flex_px, flex_item_from_pref,
    // The stride of a child in the array -- measured, not believed
    flex_item_stride,
    FLEX_MAX,
}

// ============================================================ THE VALUES
const FLEX_ROW: u32 = 0
const FLEX_ROW_REVERSE: u32 = 1
const FLEX_COLUMN: u32 = 2
const FLEX_COLUMN_REVERSE: u32 = 3

const JUSTIFY_START: u32 = 0
const JUSTIFY_END: u32 = 1
const JUSTIFY_CENTER: u32 = 2
const JUSTIFY_BETWEEN: u32 = 3
const JUSTIFY_AROUND: u32 = 4
const JUSTIFY_EVENLY: u32 = 5

const AL_AUTO: u32 = 0
const AL_START: u32 = 1
const AL_END: u32 = 2
const AL_CENTER: u32 = 3
const AL_STRETCH: u32 = 4
const AL_BASELINE: u32 = 5

// align-content has OWN values and borrows neither those of
// `align-items` nor those of `justify-content`. The reason is not
// tidiness: AL_START is 1 and JUSTIFY_END is likewise 1, and
// whoever gives the one number into the other calculation silently gets
// the wrong distribution. CSS also knows for align-content
// `stretch` AND `space-between` -- two things that exist together in neither of
// the two other lists.
const AC_START: u32 = 0
const AC_END: u32 = 1
const AC_CENTER: u32 = 2
const AC_STRETCH: u32 = 3
const AC_BETWEEN: u32 = 4
const AC_AROUND: u32 = 5
const AC_EVENLY: u32 = 6

const WRAP_NONE: u32 = 0
const WRAP_WRAP: u32 = 1
const WRAP_REVERSE: u32 = 2

// How many children a flexbox distributes in one call. Fixed, because
// the kernel has no allocator (A1 from layout.fi: the caller holds
// his arrays, but the line bookkeeping needs room).
const FLEX_MAX: usize = 64

// ============================================================ A CHILD
//
// A child is a VALUE, not a pointer to a widget: the flexbox is to
// be able to distribute things that are not widgets (columns of a
// table, tiles of a grid). Whoever distributes widgets fills `basis`
// and `cross` from `render.pref_of` -- that is the existing
// measuring protocol, and it stays the only one.
struct FlexItem {
    basis: i64, // flex-basis, in Pixeln (auto = die gemessene Groesse)
    cross: i64, // die gewuenschte Groesse QUER
    grow: i64, // Promille: 1000 = flex-grow: 1
    shrink: i64, // Promille: 1000 = flex-shrink: 1
    min_main: i64,
    max_main: i64, // <= 0 heisst "keine obere Schranke"
    align: u32, // align-self, AL_AUTO = was der Behaelter sagt
    baseline: i64, // Abstand Oberkante -> Grundlinie, fuer AL_BASELINE
}

fn flex_item(basis: i64, cross: i64) -> FlexItem {
    return FlexItem { basis: basis, cross: cross, grow: 0, shrink: 1000,
        min_main: 0, max_main: 0, align: AL_AUTO, baseline: 0 }
}

fn item_set_flex(k: *mut FlexItem, grow: i64, shrink: i64, basis: i64) {
    (*k).grow = grow
    (*k).shrink = shrink
    (*k).basis = basis
}

fn item_set_bounds(k: *mut FlexItem, min_main: i64, max_main: i64) {
    (*k).min_main = min_main
    (*k).max_main = max_main
}

fn item_set_align(k: *mut FlexItem, a: u32) { (*k).align = a }
fn item_set_baseline(k: *mut FlexItem, b: i64) { (*k).baseline = b }

// -------------------------------------- THE BRIDGE TO THE MEASURING PROTOCOL
//
// `render.pref_of` measures in f64 -- a font simply has no
// integer width. The flexbox calculates in integers. In between
// belongs EXACTLY ONE conversion, otherwise every call site rounds differently
// and two boxes with the same text become different widths.
//
// Rounding is UPWARDS: the measured size is the minimum that the
// content needs: half a pixel too little cuts off the
// last letter, half a pixel too much is noticed by nobody.
//
// flex.fi imports NOTHING for it. These are pure number functions,
// the caller measures and passes the numbers in -- the same direction
// of dependency as with layout.fi, which likewise takes numbers and
// no widgets. `#[allow_fp]` as in lib/math/core_math.fi: in the kernel
// the SSE registers belong to the interrupted thread, and whoever
// touches them says so.
#[allow_fp]
fn flex_px(v: f64) -> i64 {
    if v <= 0.0 {
        return 0
    }
    let whole: i64 = v as i64
    if (whole as f64) < v {
        return whole + 1
    }
    return whole
}

// Aus einem Messergebnis (pw, ph) wird ein Kind: was in Hauptrichtung
// liegt, haengt an der Richtung des Behaelters -- bei einer Zeile ist
// die Breite die Basis, bei einer Spalte die Hoehe. Die gemessene
// Groesse ist zugleich die Mindestgroesse, damit Schrumpfen den Inhalt
// nicht abschneidet; wer das nicht will, ruft danach
// `item_set_bounds`.
#[allow_fp]
fn flex_item_from_pref(pw: f64, ph: f64, line: bool) -> FlexItem {
    let b: i64 = flex_px(pw)
    let c: i64 = flex_px(ph)
    if line {
        var k: FlexItem = flex_item(b, c)
        k.min_main = b
        return k
    }
    var k: FlexItem = flex_item(c, b)
    k.min_main = c
    return k
}

// ========================================================= DER BEHAELTER
struct FlexBox {
    dir: u32,
    justify: u32,
    align_items: u32,
    align_content: u32,
    wrap: u32,
    gap_main: i64,
    gap_cross: i64,
    pad_l: i64,
    pad_t: i64,
    pad_r: i64,
    pad_b: i64,
}

fn flexbox_new(dir: u32) -> FlexBox {
    return FlexBox { dir: dir, justify: JUSTIFY_START,
        align_items: AL_STRETCH, align_content: AC_STRETCH,
        wrap: WRAP_NONE,
        gap_main: 0, gap_cross: 0,
        pad_l: 0, pad_t: 0, pad_r: 0, pad_b: 0 }
}

// gap: Haupt- und Querrichtung GETRENNT, wie `row-gap` und `column-gap`.
fn flex_set_gap(s: *mut FlexBox, main: i64, cross: i64) {
    (*s).gap_main = main
    (*s).gap_cross = cross
}

fn flex_set_justify(s: *mut FlexBox, j: u32) { (*s).justify = j }
fn flex_set_align_items(s: *mut FlexBox, a: u32) { (*s).align_items = a }
fn flex_set_align_content(s: *mut FlexBox, a: u32) { (*s).align_content = a }
fn flex_set_wrap(s: *mut FlexBox, w: u32) { (*s).wrap = w }

fn flex_set_padding(s: *mut FlexBox, l: i64, t: i64, r: i64, b: i64) {
    (*s).pad_l = l
    (*s).pad_t = t
    (*s).pad_r = r
    (*s).pad_b = b
}

// IST DIESER KASTEN EINE ZEILE? Die Frage wird an EINER Stelle
// beantwortet, und sie ist exportiert: lib/fui/scene.fi stellt sie
// genauso (ein Kasten misst seine Hauptachse waagerecht oder
// senkrecht), und ein zweites `(*fb).dir == FLEX_ROW` dort waere beim
// naechsten Richtungswert (etwa einer Schreibrichtung von rechts nach
// links) an einer der beiden Stellen falsch.
fn flex_is_row(s: *mut FlexBox) -> bool {
    return (*s).dir == FLEX_ROW || (*s).dir == FLEX_ROW_REVERSE
}

fn is_backward(s: *mut FlexBox) -> bool {
    return (*s).dir == FLEX_ROW_REVERSE || (*s).dir == FLEX_COLUMN_REVERSE
}

// DIE SCHRITTWEITE EINES `FlexItem` IM FELD. Ein Feld von Kindern wird
// als `*mut FlexItem` weitergereicht; wer darin das i-te Kind sucht,
// rechnet seine Adresse aus. Die Zahl dafuer steht nirgends als Ziffer,
// sie wird GEMESSEN -- die Differenz zweier Nachbarn eines echten
// Feldes ist das, was der Uebersetzer wirklich legt. lib/fui/scene.fi
// fuellt dasselbe Feld und holt die Schrittweite von hier; ein zweiter
// Ort dafuer hiesse, dass ein neues Feld in `FlexItem` an EINER Stelle
// unbemerkt bliebe und jedes zweite Kind an der falschen Adresse landet.
fn flex_item_stride() -> usize {
    var probe: [FlexItem; 2] = [flex_item(0, 0); 2]
    return ((&probe[1]) as u64 - (&probe[0]) as u64) as usize
}

fn item_at(k: *mut FlexItem, i: usize) -> *mut FlexItem {
    return (k as u64 + (i * flex_item_stride()) as u64) as *mut FlexItem
}

// Ein Kind auf seine Schranken klemmen.
fn klemme(k: *mut FlexItem, v: i64) -> i64 {
    var x: i64 = v
    if x < (*k).min_main {
        x = (*k).min_main
    }
    if (*k).max_main > 0 && x > (*k).max_main {
        x = (*k).max_main
    }
    if x < 0 {
        x = 0
    }
    return x
}

// ------------------------------------------------------------ MESSEN
//
// Die Groesse, die der Behaelter in HAUPTRICHTUNG braucht, wenn nichts
// waechst und nichts schrumpft: die Summe der Basen, die Luecken und
// die Innenraender. Das ist das Gegenstueck zu `box_measure`.
fn flex_measure_main(s: *mut FlexBox, k: *mut FlexItem, n: usize) -> i64 {
    var sum: i64 = 0
    var i: usize = 0
    while i < n {
        sum = sum + klemme(item_at(k, i), (*item_at(k, i)).basis)
        i = i + 1
    }
    if n > 1 {
        sum = sum + (*s).gap_main * ((n - 1) as i64)
    }
    if flex_is_row(s) {
        return sum + (*s).pad_l + (*s).pad_r
    }
    return sum + (*s).pad_t + (*s).pad_b
}

// Die Groesse QUER: das groesste Kind (ohne Umbruch).
fn flex_measure_cross(s: *mut FlexBox, k: *mut FlexItem, n: usize) -> i64 {
    var groesstes: i64 = 0
    var i: usize = 0
    while i < n {
        let c: i64 = (*item_at(k, i)).cross
        if c > groesstes {
            groesstes = c
        }
        i = i + 1
    }
    if flex_is_row(s) {
        return groesstes + (*s).pad_t + (*s).pad_b
    }
    return groesstes + (*s).pad_l + (*s).pad_r
}

// Wie viele Zeilen der Umbruch ergibt. Der Aufrufer braucht das, um zu
// wissen, wie hoch der Behaelter werden muss, BEVOR er verteilt.
// THE CROSS SIZE OF A WRAPPING BOX WHOSE MAIN SIZE IS KNOWN (29.09.2026).
// `flex_measure_cross` gives the tallest item -- right for one line, wrong
// the moment `flex-wrap` breaks the items into several: the box then
// claims one line of height and the second line of buttons lies over
// whatever follows (examples/codehub on a phone). With a definite main
// size (a row of fixed width) the lines are known before the layout: they
// are broken exactly as `flex_layout` breaks them (the same rule as
// `flex_line_count`: an item goes onto a new line when it and the gap no
// longer fit), and the cross size is the sum of the lines' tallest items
// plus the gaps between the lines. `main` is the box's outer main size.
fn flex_measure_cross_wrap(s: *mut FlexBox, k: *mut FlexItem, n: usize,
    main: i64) -> i64 {
    var pad_c: i64 = (*s).pad_l + (*s).pad_r
    var slot: i64 = main - (*s).pad_t - (*s).pad_b
    if flex_is_row(s) {
        pad_c = (*s).pad_t + (*s).pad_b
        slot = main - (*s).pad_l - (*s).pad_r
    }
    if (*s).wrap == WRAP_NONE || n == 0 {
        return flex_measure_cross(s, k, n)
    }
    var total: i64 = 0
    var line_max: i64 = 0
    var lines: i64 = 1
    var run: i64 = 0
    var i: usize = 0
    while i < n {
        let b: i64 = klemme(item_at(k, i), (*item_at(k, i)).basis)
        let c: i64 = (*item_at(k, i)).cross
        var to: i64 = run + b
        if run > 0 {
            to = to + (*s).gap_main
        }
        if run > 0 && to > slot {
            total = total + line_max
            lines = lines + 1
            line_max = c
            run = b
        } else {
            run = to
            if c > line_max {
                line_max = c
            }
        }
        i = i + 1
    }
    total = total + line_max + (*s).gap_cross * (lines - 1)
    return total + pad_c
}

fn flex_line_count(s: *mut FlexBox, k: *mut FlexItem, n: usize,
    space: layout.Rect) -> usize {
    if (*s).wrap == WRAP_NONE || n == 0 {
        if n == 0 {
            return 0
        }
        return 1
    }
    let slot: i64 = main_slot(s, space)
    var lines: usize = 1
    var run: i64 = 0
    var i: usize = 0
    while i < n {
        let b: i64 = klemme(item_at(k, i), (*item_at(k, i)).basis)
        var to: i64 = run + b
        if run > 0 {
            to = to + (*s).gap_main
        }
        if run > 0 && to > slot {
            lines = lines + 1
            run = b
        } else {
            run = to
        }
        i = i + 1
    }
    return lines
}

fn main_slot(s: *mut FlexBox, space: layout.Rect) -> i64 {
    if flex_is_row(s) {
        return space.w - (*s).pad_l - (*s).pad_r
    }
    return space.h - (*s).pad_t - (*s).pad_b
}

// ------------------------------------------------------------ VERTEILEN
//
// Der Kern: `groessen` bekommt fuer jedes Kind einer Zeile die
// Hauptgroesse. Freier Platz wird nach `grow` verteilt, fehlender nach
// `shrink` MAL BASIS gewichtet (so macht es CSS: ein breites Kind gibt
// mehr her als ein schmales), und wer dabei an eine Schranke stoesst,
// wird eingefroren; der Rest wird NEU verteilt, bis niemand mehr
// einfriert.
// DAS SCHRUMPFGEWICHT, IN TAUSENDSTELN.
//
// 20.09.2026 -- ein Fehler, den man nur an Zahlen sieht. Hier stand
// `shrink * basis / 1000`, also die Division MITTEN in der Rechnung.
// `shrink` ist in Promille gefuehrt (250 = flex-shrink: 0.25), und
// damit verschwand jedes Kind, dessen Produkt unter 1000 lag,
// vollstaendig aus der Verteilung: ein Kind mit shrink 0.25 und
// Basis 3 bekam das Gewicht 0 und gab KEINEN Bildpunkt her, obwohl
// CSS ihm 0.75 Anteile zuspricht. Die Nachbarn mussten den Mangel
// allein tragen, und die Zeile war um genau diesen Betrag falsch
// verteilt.
//
// Das Gewicht bleibt darum in Tausendsteln stehen; geteilt wird ERST
// beim Anteil (`rest * gewicht_i / gewicht_summe`), wo Zaehler und
// Nenner dieselbe Einheit haben und sie sich herauskuerzt. Der Wert
// bleibt in i64 bequem: 64 Kinder mal 1000 Promille mal ein paar
// tausend Bildpunkte Basis sind rund 10^8.
fn schrumpfgewicht(it: *mut FlexItem) -> i64 {
    let g: i64 = (*it).shrink * (*it).basis
    if g < 0 {
        return 0
    }
    return g
}

fn verteile(s: *mut FlexBox, k: *mut FlexItem, von: usize, n: usize,
    slot: i64, groessen: *mut i64, frozen: *mut i64) {
    var i: usize = 0
    var base_sum: i64 = 0
    while i < n {
        let it: *mut FlexItem = item_at(k, von + i)
        st(groessen, i, (*it).basis)
        st(frozen, i, 0)
        base_sum = base_sum + (*it).basis
        i = i + 1
    }
    var gaps: i64 = 0
    if n > 1 {
        gaps = (*s).gap_main * ((n - 1) as i64)
    }
    // Kinder, deren Basis schon ausserhalb ihrer Schranken liegt,
    // frieren sofort ein -- sonst verteilt die erste Runde Platz an
    // jemanden, der ihn gar nicht annehmen kann.
    i = 0
    while i < n {
        let it: *mut FlexItem = item_at(k, von + i)
        let g: i64 = klemme(it, ld(groessen, i))
        if g != ld(groessen, i) {
            st(groessen, i, g)
            st(frozen, i, 1)
        }
        i = i + 1
    }
    var round: usize = 0
    while round <= n {
        var sum: i64 = 0
        i = 0
        while i < n {
            sum = sum + ld(groessen, i)
            i = i + 1
        }
        let rest: i64 = slot - gaps - sum
        if rest == 0 {
            return
        }
        // Die Gewichte der noch beweglichen Kinder.
        var weight: i64 = 0
        i = 0
        while i < n {
            if ld(frozen, i) == 0 {
                let it: *mut FlexItem = item_at(k, von + i)
                if rest > 0 {
                    weight = weight + (*it).grow
                } else {
                    weight = weight + schrumpfgewicht(it)
                }
            }
            i = i + 1
        }
        if weight <= 0 {
            return
        }
        // Verteilen, und wer dabei klemmt, friert ein.
        var new_frozen: bool = false
        var vergeben: i64 = 0
        var last: usize = n
        i = 0
        while i < n {
            if ld(frozen, i) == 0 {
                let it: *mut FlexItem = item_at(k, von + i)
                var anteil: i64 = 0
                if rest > 0 {
                    anteil = rest * (*it).grow / weight
                } else {
                    anteil = rest * schrumpfgewicht(it) / weight
                }
                let roh: i64 = ld(groessen, i) + anteil
                let ge: i64 = klemme(it, roh)
                st(groessen, i, ge)
                vergeben = vergeben + anteil
                last = i
                if ge != roh {
                    st(frozen, i, 1)
                    new_frozen = true
                }
            }
            i = i + 1
        }
        // DER REST DER GANZZAHLDIVISION. Er geht an das letzte bewegliche
        // Kind, damit die Summe der Teile EXAKT den Platz fuellt -- genau
        // die Regel, die box_layout schon hat.
        if !new_frozen && last < n {
            let missing: i64 = rest - vergeben
            if missing != 0 {
                let it: *mut FlexItem = item_at(k, von + last)
                let ge: i64 = klemme(it, ld(groessen, last) + missing)
                st(groessen, last, ge)
            }
            return
        }
        if !new_frozen {
            return
        }
        round = round + 1
    }
}

fn ld(p: *mut i64, i: usize) -> i64 {
    return *((p as u64 + (i * 8) as u64) as *mut i64)
}

fn st(p: *mut i64, i: usize, v: i64) {
    *((p as u64 + (i * 8) as u64) as *mut i64) = v
}

// Der Anfang und der Abstand, die `justify-content` vorgibt.
fn justify_start(j: u32, free: i64, n: usize) -> i64 {
    if free <= 0 {
        return 0
    }
    if j == JUSTIFY_END {
        return free
    }
    if j == JUSTIFY_CENTER {
        return free / 2
    }
    if j == JUSTIFY_AROUND {
        return free / ((n * 2) as i64)
    }
    if j == JUSTIFY_EVENLY {
        return free / ((n + 1) as i64)
    }
    return 0
}

fn justify_distance(j: u32, free: i64, n: usize) -> i64 {
    if free <= 0 || n == 0 {
        return 0
    }
    if j == JUSTIFY_BETWEEN {
        if n < 2 {
            return 0
        }
        return free / ((n - 1) as i64)
    }
    if j == JUSTIFY_AROUND {
        return free / (n as i64)
    }
    if j == JUSTIFY_EVENLY {
        return free / ((n + 1) as i64)
    }
    return 0
}

// ------------------------------------------------------- ALIGN-CONTENT
//
// Die Verteilung der ZEILEN quer -- die eigene Rechnung, nicht die von
// `justify-content` geliehene. Zwei Gruende: die Werte sind andere
// (siehe AC_*), und `stretch` gibt es drueben gar nicht. `stretch`
// verteilt den freien Platz auf die Zeilen SELBST und laesst danach
// keinen Anfang und keinen Abstand uebrig; alles andere laesst die
// Zeilenhoehen, wie sie sind, und schiebt nur.
//
// `quer` zeigt auf `zahl` Zeilenhoehen und wird bei AC_STRETCH
// veraendert. Zurueck kommt der freie Platz, der NACH dem Strecken
// noch zu verschieben ist; Anfang und Abstand landen in `anfang` und
// `abstand`.
fn content_distribute(a: u32, number: usize, free_in: i64, cross: *mut i64,
    begin: *mut i64, distance: *mut i64) {
    *begin = 0
    *distance = 0
    if number == 0 || free_in <= 0 {
        return
    }
    var free: i64 = free_in
    if a == AC_STRETCH {
        // Jede Zeile bekommt denselben Anteil, und der Rest der
        // Ganzzahldivision geht an die letzte -- dieselbe Regel wie
        // bei der Hauptrichtung, damit die Summe EXAKT aufgeht und
        // unten kein leerer Streifen bleibt.
        let je: i64 = free / (number as i64)
        var vergeben: i64 = 0
        var z: usize = 0
        while z < number {
            let p: *mut i64 = (cross as u64 + (z * 8) as u64) as *mut i64
            *p = *p + je
            vergeben = vergeben + je
            z = z + 1
        }
        let last: *mut i64 =
        (cross as u64 + ((number - 1) * 8) as u64) as *mut i64
        *last = *last + (free - vergeben)
        return
    }
    if a == AC_END {
        *begin = free
        return
    }
    if a == AC_CENTER {
        *begin = free / 2
        return
    }
    if a == AC_BETWEEN {
        if number > 1 {
            *distance = free / ((number - 1) as i64)
        }
        return
    }
    if a == AC_AROUND {
        // Jede Zeile bekommt gleich viel Luft, halb davor, halb
        // dahinter -- aussen also eine halbe, innen eine ganze.
        let je: i64 = free / (number as i64)
        *begin = je / 2
        *distance = je
        return
    }
    if a == AC_EVENLY {
        let je: i64 = free / ((number + 1) as i64)
        *begin = je
        *distance = je
        return
    }
}

// ------------------------------------------------------------- SETZEN
//
// Die fertigen Rechtecke landen in `out` -- ein Feld des Aufrufers,
// genau wie bei `box_layout`. `zeile_hoehen` ist Arbeitsspeicher fuer
// die Querverteilung und muss FLEX_MAX Eintraege fassen.
fn flex_layout(s: *mut FlexBox, space: layout.Rect, k: *mut FlexItem,
    n: usize, out: *mut layout.Rect, groessen: *mut i64,
    frozen: *mut i64) {
    if n == 0 {
        return
    }
    let inner: layout.Rect = layout.rect_shrink(space, (*s).pad_l,
        (*s).pad_t, (*s).pad_r, (*s).pad_b)
    let slot: i64 = main_slot(s, space)
    // ---- Zeilen bilden
    var lines_start: [usize; 64] = [0; 64]
    var lines_n: [usize; 64] = [0; 64]
    var number: usize = 0
    if (*s).wrap == WRAP_NONE {
        lines_start[0] = 0
        lines_n[0] = n
        number = 1
    } else {
        var run: i64 = 0
        var begin: usize = 0
        var i: usize = 0
        while i < n {
            let b: i64 = klemme(item_at(k, i), (*item_at(k, i)).basis)
            var to: i64 = run + b
            if run > 0 {
                to = to + (*s).gap_main
            }
            if run > 0 && to > slot {
                lines_start[number] = begin
                lines_n[number] = i - begin
                number = number + 1
                begin = i
                run = b
            } else {
                run = to
            }
            i = i + 1
        }
        lines_start[number] = begin
        lines_n[number] = n - begin
        number = number + 1
    }
    // ---- Die Hoehe einer Zeile: das groesste Kind darin.
    var lines_cross: [i64; 64] = [0; 64]
    var cross_sum: i64 = 0
    var z: usize = 0
    while z < number {
        var gr: i64 = 0
        var i: usize = 0
        while i < lines_n[z] {
            let c: i64 = (*item_at(k, lines_start[z] + i)).cross
            if c > gr {
                gr = c
            }
            i = i + 1
        }
        lines_cross[z] = gr
        cross_sum = cross_sum + gr
        z = z + 1
    }
    var cross_whole: i64 = inner.h
    if !flex_is_row(s) {
        cross_whole = inner.w
    }
    var cross_gaps: i64 = 0
    if number > 1 {
        cross_gaps = (*s).gap_cross * ((number - 1) as i64)
    }
    // Ohne Umbruch gibt es genau eine Zeile, und sie fuellt die
    // Querrichtung ganz -- sonst haengt `align-items: stretch` in der
    // Luft. MIT Umbruch entscheidet darueber align-content, auch bei
    // nur einer Zeile.
    if (*s).wrap == WRAP_NONE {
        lines_cross[0] = cross_whole
        cross_sum = cross_whole
    }
    var cross_free: i64 = cross_whole - cross_sum - cross_gaps
    if cross_free < 0 {
        cross_free = 0
    }
    var content_start: i64 = 0
    var content_distance: i64 = 0
    content_distribute((*s).align_content, number, cross_free,
        (&lines_cross[0]) as *mut i64, &content_start, &content_distance)
    var cross_run: i64 = 0
    if flex_is_row(s) {
        cross_run = inner.y
    } else {
        cross_run = inner.x
    }
    cross_run = cross_run + content_start
    // ---- Jede Zeile setzen
    z = 0
    while z < number {
        var zi: usize = z
        if (*s).wrap == WRAP_REVERSE {
            zi = number - 1 - z
        }
        let von: usize = lines_start[zi]
        let m: usize = lines_n[zi]
        verteile(s, k, von, m, slot, groessen, frozen)
        var sum: i64 = 0
        var i: usize = 0
        while i < m {
            sum = sum + ld(groessen, i)
            i = i + 1
        }
        var gaps: i64 = 0
        if m > 1 {
            gaps = (*s).gap_main * ((m - 1) as i64)
        }
        var free: i64 = slot - sum - gaps
        if free < 0 {
            free = 0
        }
        var main_start: i64 = inner.x
        if !flex_is_row(s) {
            main_start = inner.y
        }
        var pos: i64 = main_start + justify_start((*s).justify, free, m)
        let extra: i64 = justify_distance((*s).justify, free, m)
        // Die Grundlinie der Zeile: die tiefste ueber alle Kinder, die
        // sich danach ausrichten wollen.
        var grundlinie: i64 = 0
        i = 0
        while i < m {
            let it: *mut FlexItem = item_at(k, von + i)
            var al: u32 = (*it).align
            if al == AL_AUTO {
                al = (*s).align_items
            }
            if al == AL_BASELINE && (*it).baseline > grundlinie {
                grundlinie = (*it).baseline
            }
            i = i + 1
        }
        i = 0
        while i < m {
            let ii: usize = i
            let it: *mut FlexItem = item_at(k, von + ii)
            let main: i64 = ld(groessen, ii)
            var al: u32 = (*it).align
            if al == AL_AUTO {
                al = (*s).align_items
            }
            var cross: i64 = (*it).cross
            var cross_pos: i64 = cross_run
            if al == AL_STRETCH {
                cross = lines_cross[zi]
            } else if al == AL_CENTER {
                cross_pos = cross_pos + (lines_cross[zi] - cross) / 2
            } else if al == AL_END {
                cross_pos = cross_pos + lines_cross[zi] - cross
            } else if al == AL_BASELINE {
                cross_pos = cross_pos + grundlinie - (*it).baseline
            }
            // *_REVERSE dreht die HAUPTACHSE um, nicht die Reihenfolge
            // im Feld: in CSS liegt bei `row-reverse` der Anfang der
            // Achse rechts. Darum wird durchgehend vorwaerts gerechnet
            // und die fertige Lage am Ende gespiegelt -- so stimmt
            // auch `justify-content: flex-start`, das dann rechts
            // buendig packt. Wer stattdessen nur die Reihenfolge
            // tauscht, bekommt bei freiem Platz eine Zeile, die auf
            // der falschen Seite klebt.
            var mpos: i64 = pos
            if is_backward(s) {
                mpos = main_start + slot - (pos - main_start) - main
            }
            if flex_is_row(s) {
                *((out as u64 + ((von + ii) * 32) as u64) as *mut layout.Rect) =
                layout.rect_new(mpos, cross_pos, main, cross)
            } else {
                *((out as u64 + ((von + ii) * 32) as u64) as *mut layout.Rect) =
                layout.rect_new(cross_pos, mpos, cross, main)
            }
            pos = pos + main + (*s).gap_main + extra
            i = i + 1
        }
        cross_run = cross_run + lines_cross[zi] + (*s).gap_cross
        +content_distance
        z = z + 1
    }
}
