// SPDX-License-Identifier: MPL-2.0
// lib/fui/nav_layout.fi -- adaptive layout: window size in, rectangles out. No drawing, no host.

export {
    Rect, LayoutParams, Layout,
    NL_WIDE, NL_MID, NL_STACK, NL_PAGE_LIST, NL_PAGE_CONTENT, NL_PAGE_DETAIL,
    NL_BP_WIDE, NL_BP_MID,
    nlay_params, nlay_mode, nlay_compute, nlay_rect_has,
}

const NL_WIDE: u32 = 0
const NL_MID: u32 = 1
const NL_STACK: u32 = 2

const NL_PAGE_LIST: u32 = 0
const NL_PAGE_CONTENT: u32 = 1
const NL_PAGE_DETAIL: u32 = 2

const NL_BP_WIDE: i32 = 1100
const NL_BP_MID: i32 = 700

struct Rect {
    x: i32,
    y: i32,
    w: i32,
    h: i32,
}

struct LayoutParams {
    rail_w: i32,
    list_w: i32,
    detail_w: i32,
    tab_h: i32,
    min_content: i32,
    detail_open: bool,
    page: u32,
}

struct Layout {
    mode: u32,
    rail: Rect,
    list: Rect,
    content: Rect,
    detail: Rect,
    tabbar: Rect,
    detail_overlay: bool,
    page: u32,
}

fn rect(x: i32, y: i32, w: i32, h: i32) -> Rect {
    var ww: i32 = w
    var hh: i32 = h
    if ww < 0 { ww = 0 }
    if hh < 0 { hh = 0 }
    return Rect { x: x, y: y, w: ww, h: hh }
}

fn none() -> Rect {
    return Rect { x: 0, y: 0, w: 0, h: 0 }
}

fn nlay_params() -> LayoutParams {
    return LayoutParams { rail_w: 64, list_w: 320, detail_w: 280, tab_h: 56, min_content: 360,
        detail_open: false, page: NL_PAGE_LIST }
}

fn nlay_mode(w: i32) -> u32 {
    if w >= NL_BP_WIDE { return NL_WIDE }
    if w >= NL_BP_MID { return NL_MID }
    return NL_STACK
}

fn nlay_rect_has(r: Rect, x: i32, y: i32) -> bool {
    return x >= r.x && y >= r.y && x < r.x + r.w && y < r.y + r.h
}

fn min_i(a: i32, b: i32) -> i32 {
    if a < b { return a }
    return b
}

fn max_i(a: i32, b: i32) -> i32 {
    if a > b { return a }
    return b
}

fn nlay_compute(w: i32, h: i32, p: *mut LayoutParams) -> Layout {
    let mode: u32 = nlay_mode(w)
    var l: Layout = Layout { mode: mode, rail: none(), list: none(), content: none(), detail: none(),
        tabbar: none(), detail_overlay: false, page: (*p).page }
    if mode == NL_STACK {
        var body_h: i32 = h
        if (*p).page == NL_PAGE_LIST {
            body_h = h - (*p).tab_h
            l.tabbar = rect(0, h - (*p).tab_h, w, (*p).tab_h)
        }
        let full: Rect = rect(0, 0, w, body_h)
        if (*p).page == NL_PAGE_CONTENT { l.content = full }
        else if (*p).page == NL_PAGE_DETAIL { l.detail = full }
        else { l.list = full }
        return l
    }
    l.rail = rect(0, 0, (*p).rail_w, h)
    let after_rail: i32 = w - (*p).rail_w
    var detail_w: i32 = 0
    if mode == NL_WIDE && (*p).detail_open { detail_w = (*p).detail_w }
    let list_cap: i32 = after_rail - detail_w - (*p).min_content
    var list_w: i32 = min_i((*p).list_w, list_cap)
    if mode == NL_MID { list_w = min_i(list_w, after_rail * 36 / 100) }
    list_w = max_i(list_w, 0)
    l.list = rect((*p).rail_w, 0, list_w, h)
    let cx: i32 = (*p).rail_w + list_w
    l.content = rect(cx, 0, w - cx - detail_w, h)
    if mode == NL_WIDE && (*p).detail_open {
        l.detail = rect(w - detail_w, 0, detail_w, h)
    } else if mode == NL_MID && (*p).detail_open {
        let dw: i32 = min_i((*p).detail_w, l.content.w * 70 / 100)
        l.detail = rect(w - dw, 0, dw, h)
        l.detail_overlay = true
    }
    return l
}
