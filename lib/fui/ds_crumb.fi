import std.rt
import fui.ds_look
import fui.editor
import fui.kit
import fui.kitform
import fui.kitpopup
import fui.ds_icons
import fui.ds_icons_names
import fui.render
import fui.screenax
import fui.widget

const NONE: usize = 18446744073709551615
const CAP: usize = 64
const MORE: usize = 1000

struct Crumbs {
    sx: [f64; 64],
    sw: [f64; 64],
    n: usize,
    base: usize,
    hidden: usize,
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    mx: f64,
    mw: f64,
    menu_w: f64,
    list_p: u64,
    list_n: usize,
    more_p: u64,
    more_n: usize,
    foc: usize,
    kbd: bool,
    open: bool,
    mi: usize,
    down: usize,
    fired: usize,
    px: f64,
    py: f64,
    rev: u64,
    ctx: u64,
}

fn crumbs_new() -> *mut Crumbs {
    let k: *mut Crumbs = rt.heap_alloc(1 << 13) as *mut Crumbs
    var i: usize = 0
    while i < CAP {
        (*k).sx[i] = 0.0
        (*k).sw[i] = 0.0
        i = i + 1
    }
    (*k).n = 0
    (*k).base = 0
    (*k).hidden = 0
    (*k).x = 0.0
    (*k).y = 0.0
    (*k).w = 0.0
    (*k).h = 0.0
    (*k).mx = 0.0
    (*k).mw = 0.0
    (*k).menu_w = 0.0
    (*k).list_p = 0
    (*k).list_n = 0
    (*k).more_p = "More".p as u64
    (*k).more_n = 4
    (*k).foc = NONE
    (*k).kbd = false
    (*k).open = false
    (*k).mi = NONE
    (*k).down = NONE
    (*k).fired = NONE
    (*k).px = 0.0 - 1.0
    (*k).py = 0.0 - 1.0
    (*k).rev = 0
    (*k).ctx = 0
    return k
}

fn set_more_name(k: *mut Crumbs, name: str) {
    (*k).more_p = name.p as u64
    (*k).more_n = name.n
}

fn more_name(k: *mut Crumbs) -> str {
    return str { p: (*k).more_p as *mut u8, n: (*k).more_n }
}

fn list_of(k: *mut Crumbs) -> str {
    return str { p: (*k).list_p as *mut u8, n: (*k).list_n }
}

fn seg_name(k: *mut Crumbs, i: usize) -> str {
    return kitform.nth(list_of(k), (*k).base + i)
}

fn begin(k: *mut Crumbs, c: *mut render.Ctx, x: f64, y: f64, w: f64, px: f64, py: f64) {
    (*k).x = x
    (*k).y = y
    (*k).w = w
    (*k).px = px
    (*k).py = py
    (*k).ctx = c as u64
    (*k).h = kit.grow_h(c, 32, 14)
}

fn weight_of(k: *mut Crumbs, i: usize) -> usize {
    if i + 1 == (*k).n { return 600 }
    return 400
}

fn sep_width(c: *mut render.Ctx) -> f64 { return kit.ln(c, 20) }

fn measure(k: *mut Crumbs, c: *mut render.Ctx) {
    let all: usize = kitform.parts(list_of(k))
    (*k).base = 0
    (*k).n = all
    if all > CAP {
        (*k).base = all - CAP
        (*k).n = CAP
    }
    var i: usize = 0
    while i < (*k).n {
        (*k).sw[i] = ds_look.label_width(c, 14, weight_of(k, i), seg_name(k, i)) + ds_look.radius(c) * 2.0
        i = i + 1
    }
}

fn tail_width(k: *mut Crumbs, c: *mut render.Ctx, from: usize) -> f64 {
    var t: f64 = 0.0
    var i: usize = from
    while i < (*k).n {
        t = t + (*k).sw[i]
        if i + 1 < (*k).n { t = t + sep_width(c) }
        i = i + 1
    }
    return t
}

fn layout(k: *mut Crumbs, c: *mut render.Ctx) {
    let sep: f64 = sep_width(c)
    (*k).hidden = 0
    if tail_width(k, c, 0) > (*k).w && (*k).n > 1 {
        var cut: usize = 1
        while cut + 1 < (*k).n && (*k).h + sep + tail_width(k, c, cut) > (*k).w { cut = cut + 1 }
        (*k).hidden = cut
    }
    var cx: f64 = (*k).x
    (*k).mx = cx
    (*k).mw = (*k).h
    if (*k).hidden > 0 { cx = cx + (*k).h + sep }
    var i: usize = (*k).hidden
    while i < (*k).n {
        (*k).sx[i] = cx
        var w: f64 = (*k).sw[i]
        let room: f64 = (*k).x + (*k).w - cx
        if w > room { w = room }
        if w < kit.ln(c, 24) { w = kit.ln(c, 24) }
        (*k).sw[i] = w
        cx = cx + w + sep
        i = i + 1
    }
}

fn hidden_list(k: *mut Crumbs) -> str {
    let all: str = list_of(k)
    let first: str = seg_name(k, 0)
    let last: str = seg_name(k, (*k).hidden - 1)
    return ds_look.sub(all, ds_look.byte_offset(all, first), ds_look.byte_offset(all, last) + last.n)
}

fn menu_width(k: *mut Crumbs, c: *mut render.Ctx) -> f64 {
    var m: f64 = kit.ln(c, 180)
    var i: usize = 0
    while i < (*k).hidden {
        let w: f64 = ds_look.label_width(c, 13, 400, seg_name(k, i)) + kit.ln(c, 48)
        if w > m { m = w }
        i = i + 1
    }
    return m
}

fn clickable(k: *mut Crumbs, i: usize) -> bool {
    return i >= (*k).hidden && i + 1 < (*k).n
}

fn is_focus(k: *mut Crumbs, id: usize) -> bool { return (*k).foc == id && (*k).kbd }

fn draw(k: *mut Crumbs, c: *mut render.Ctx, list: str) -> f64 {
    (*k).list_p = list.p as u64
    (*k).list_n = list.n
    measure(k, c)
    layout(k, c)
    (*k).menu_w = 0.0
    if (*k).hidden > 0 { (*k).menu_w = menu_width(k, c) }
    let sep: f64 = sep_width(c)
    let r: f64 = ds_look.radius_small(c)
    if (*k).hidden > 0 {
        paint_more(k, c, r)
        draw_sep(c, (*k).mx + (*k).h, (*k).y, sep, (*k).h)
    }
    var i: usize = (*k).hidden
    while i < (*k).n {
        paint_seg(k, c, i, r)
        if i + 1 < (*k).n { draw_sep(c, (*k).sx[i] + (*k).sw[i], (*k).y, sep, (*k).h) }
        i = i + 1
    }
    return (*k).h
}

fn draw_sep(c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64) {
    let g: f64 = kit.ln(c, 12)
    ds_look.glyph(c, ds_icons.gid(ds_icons_names.CHEVRON_RIGHT), x + (w - g) / 2.0, y + (h - g) / 2.0, g, ds_look.fg_muted(c))
}

fn paint_more(k: *mut Crumbs, c: *mut render.Ctx, r: f64) {
    let hov: bool = over_more(k, (*k).px, (*k).py)
    let pressed: bool = hov && (*k).down == MORE
    if pressed || (*k).open {
        ds_look.fill(c, (*k).mx, (*k).y, (*k).mw, (*k).h, r, ds_look.pressed_bg(c))
    } else {
        ds_look.overlay(c, (*k).mx, (*k).y, (*k).mw, (*k).h, r, ds_look.hover_bg(c), ds_look.hover_level(c, (*k).mx, (*k).y, hov))
    }
    let g: f64 = ds_look.glyph_small(c)
    ds_look.glyph(c, ds_look.ICON_MORE, (*k).mx + ((*k).mw - g) / 2.0, (*k).y + ((*k).h - g) / 2.0, g, ds_look.fg(c))
    var st: u32 = 0 as u32
    if is_focus(k, MORE) {
        ds_look.focus(c, (*k).mx, (*k).y, (*k).mw, (*k).h, r)
        st = screenax.F_FOCUS
    }
    screenax.note(widget.KIND_BUTTON, st, more_name(k), (*k).mx, (*k).y, (*k).mw, (*k).h, 0)
}

fn paint_seg(k: *mut Crumbs, c: *mut render.Ctx, i: usize, r: f64) {
    let x: f64 = (*k).sx[i]
    let w: f64 = (*k).sw[i]
    let name: str = seg_name(k, i)
    let current: bool = i + 1 == (*k).n
    let can: bool = !current
    let hov: bool = can && ds_look.inside((*k).px, (*k).py, x, (*k).y, w, (*k).h)
    if hov && (*k).down == (*k).base + i {
        ds_look.fill(c, x, (*k).y, w, (*k).h, r, ds_look.pressed_bg(c))
    } else {
        ds_look.overlay(c, x, (*k).y, w, (*k).h, r, ds_look.hover_bg(c), ds_look.hover_level(c, x, (*k).y, hov))
    }
    var col: u32 = ds_look.fg_muted(c)
    if current || hov { col = ds_look.fg(c) }
    ds_look.label(c, x + ds_look.radius(c), (*k).y, (*k).h, 14, weight_of(k, i), col, name, w - ds_look.radius(c) * 2.0)
    var st: u32 = 0 as u32
    if is_focus(k, (*k).base + i) {
        ds_look.focus(c, x, (*k).y, w, (*k).h, r)
        st = screenax.F_FOCUS
    }
    if can {
        screenax.note(widget.KIND_BUTTON, st, name, x, (*k).y, w, (*k).h, 0)
    } else {
        screenax.note(widget.KIND_LABEL, 0 as u32, name, x, (*k).y, w, (*k).h, 0)
    }
}

fn over_more(k: *mut Crumbs, x: f64, y: f64) -> bool {
    return (*k).hidden > 0 && ds_look.inside(x, y, (*k).mx, (*k).y, (*k).mw, (*k).h)
}

fn menu_pointer(k: *mut Crumbs, c: *mut render.Ctx, out: *mut [f64; 4]) -> bool {
    if (*k).mi == NONE { return false }
    var q: [f64; 4] = [0.0; 4]
    kitpopup.item_rect(c, (*k).mx, (*k).y, (*k).menu_w, (*k).h, (*k).hidden, (*k).mi, &q)
    (*out)[0] = q[0] + q[2] / 2.0
    (*out)[1] = q[1] + q[3] / 2.0
    return true
}

fn end(k: *mut Crumbs, c: *mut render.Ctx) {
    if !(*k).open || (*k).hidden == 0 { return }
    var px: f64 = (*k).px
    var py: f64 = (*k).py
    var kp: [f64; 4] = [0.0; 4]
    if menu_pointer(k, c, &kp) {
        px = kp[0]
        py = kp[1]
    }
    kitpopup.draw(c, (*k).mx, (*k).y, (*k).menu_w, (*k).h, hidden_list(k), 0 - 1, px, py)
    var i: usize = 0
    while i < (*k).hidden {
        var q: [f64; 4] = [0.0; 4]
        kitpopup.item_rect(c, (*k).mx, (*k).y, (*k).menu_w, (*k).h, (*k).hidden, i, &q)
        screenax.note(widget.KIND_BUTTON, screenax.F_MENUITEM, seg_name(k, i), q[0], q[1], q[2], q[3], 0)
        i = i + 1
    }
}

fn seg_at(k: *mut Crumbs, x: f64, y: f64) -> usize {
    var i: usize = (*k).hidden
    while i < (*k).n {
        if clickable(k, i) && ds_look.inside(x, y, (*k).sx[i], (*k).y, (*k).sw[i], (*k).h) { return i }
        i = i + 1
    }
    return NONE
}

fn menu_hit(k: *mut Crumbs, x: f64, y: f64) -> usize {
    let c: *mut render.Ctx = (*k).ctx as *mut render.Ctx
    return kitpopup.hit(c, (*k).mx, (*k).y, (*k).menu_w, (*k).h, hidden_list(k), x, y)
}

fn press(k: *mut Crumbs, x: f64, y: f64) -> usize {
    (*k).down = NONE
    (*k).kbd = false
    if (*k).open {
        (*k).open = false
        (*k).mi = NONE
        let m: usize = menu_hit(k, x, y)
        if m != kitpopup.NONE {
            (*k).rev = (*k).rev + 1
            return (*k).base + m
        }
        if over_more(k, x, y) { return NONE }
    }
    if over_more(k, x, y) {
        (*k).down = MORE
        (*k).foc = MORE
        return NONE
    }
    let i: usize = seg_at(k, x, y)
    if i == NONE {
        (*k).foc = NONE
        return NONE
    }
    (*k).down = (*k).base + i
    (*k).foc = (*k).base + i
    return NONE
}

fn release(k: *mut Crumbs, x: f64, y: f64) -> usize {
    let d: usize = (*k).down
    (*k).down = NONE
    if d == NONE { return NONE }
    if d == MORE {
        if over_more(k, x, y) {
            (*k).open = true
            (*k).mi = NONE
            (*k).rev = (*k).rev + 1
        }
        return NONE
    }
    let i: usize = seg_at(k, x, y)
    if i == NONE || (*k).base + i != d { return NONE }
    (*k).rev = (*k).rev + 1
    return d
}

fn click(k: *mut Crumbs, x: f64, y: f64) -> usize {
    let a: usize = press(k, x, y)
    let b: usize = release(k, x, y)
    if a != NONE { return a }
    return b
}

fn order_slot(k: *mut Crumbs, id: usize) -> usize {
    var s: usize = 0
    if (*k).hidden > 0 {
        if id == MORE { return 0 }
        s = 1
    }
    var i: usize = (*k).hidden
    while i + 1 < (*k).n {
        if (*k).base + i == id { return s }
        s = s + 1
        i = i + 1
    }
    return NONE
}

fn order_count(k: *mut Crumbs) -> usize {
    var s: usize = 0
    if (*k).hidden > 0 { s = 1 }
    if (*k).n > (*k).hidden + 1 { s = s + (*k).n - (*k).hidden - 1 }
    return s
}

fn order_id(k: *mut Crumbs, s: usize) -> usize {
    var at: usize = s
    if (*k).hidden > 0 {
        if s == 0 { return MORE }
        at = s - 1
    }
    return (*k).base + (*k).hidden + at
}

fn focus_step(k: *mut Crumbs, back: bool) -> bool {
    let n: usize = order_count(k)
    if n == 0 { return false }
    var s: usize = order_slot(k, (*k).foc)
    if s == NONE {
        if back { s = 0 } else { s = n - 1 }
    }
    if back {
        if s == 0 { s = n - 1 } else { s = s - 1 }
    } else {
        s = (s + 1) % n
    }
    (*k).foc = order_id(k, s)
    (*k).kbd = true
    return true
}

fn menu_step(k: *mut Crumbs, d: i64) {
    var m: i64 = 0
    if (*k).mi != NONE { m = (*k).mi as i64 + d }
    if (*k).mi == NONE && d < 0 { m = (*k).hidden as i64 - 1 }
    if m < 0 { m = 0 }
    if m >= (*k).hidden as i64 { m = (*k).hidden as i64 - 1 }
    (*k).mi = m as usize
}

fn activate(k: *mut Crumbs) -> bool {
    if (*k).open {
        if (*k).mi == NONE { return true }
        (*k).fired = (*k).base + (*k).mi
        (*k).open = false
        (*k).mi = NONE
        (*k).rev = (*k).rev + 1
        return true
    }
    if (*k).foc == NONE { return false }
    if (*k).foc == MORE {
        (*k).open = true
        (*k).mi = 0
        (*k).rev = (*k).rev + 1
        return true
    }
    (*k).fired = (*k).foc
    (*k).rev = (*k).rev + 1
    return true
}

fn key(k: *mut Crumbs, code: u32, mods: u32) -> bool {
    if (*k).open {
        if code == editor.KEY_ESC { (*k).open = false; (*k).mi = NONE; return true }
        if code == editor.KEY_DOWN { menu_step(k, 1); return true }
        if code == editor.KEY_UP { menu_step(k, 0 - 1); return true }
        if code == editor.KEY_ENTER { return activate(k) }
        if code == editor.KEY_TAB { (*k).open = false; (*k).mi = NONE }
    }
    if code == editor.KEY_TAB { return focus_step(k, (mods & editor.MOD_SHIFT) != 0 as u32) }
    if code == editor.KEY_RIGHT { return focus_step(k, false) }
    if code == editor.KEY_LEFT { return focus_step(k, true) }
    if code == editor.KEY_ENTER { return activate(k) }
    if code == editor.KEY_DOWN && (*k).foc == MORE { return activate(k) }
    return false
}

fn text(k: *mut Crumbs, cp: u32, mods: u32) -> bool {
    if cp == 32 as u32 { return activate(k) }
    return false
}

fn fired(k: *mut Crumbs) -> usize {
    let f: usize = (*k).fired
    (*k).fired = NONE
    return f
}

fn hidden_count(k: *mut Crumbs) -> usize { return (*k).hidden }
fn menu_open(k: *mut Crumbs) -> bool { return (*k).open }
fn close_menu(k: *mut Crumbs) {
    (*k).open = false
    (*k).mi = NONE
}
fn set_focus(k: *mut Crumbs, id: usize) {
    (*k).foc = id
    (*k).kbd = id != NONE
}
fn focus_id(k: *mut Crumbs) -> usize { return (*k).foc }
fn revision(k: *mut Crumbs) -> u64 { return (*k).rev }
fn count(k: *mut Crumbs) -> usize { return (*k).base + (*k).n }
