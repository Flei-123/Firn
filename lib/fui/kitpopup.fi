import fui.kit
import fui.kitapp
import fui.kitform
import fui.lucide
import fui.painter
import fui.render
import fui.style

const NONE: usize = 18446744073709551615

fn item_rect(c: *mut render.Ctx, bx: f64, by: f64, bw: f64, bh: f64, n: usize, i: usize, out: *mut [f64; 4]) {
    (*out)[0] = bx + kit.ln(c, 4)
    (*out)[2] = bw - kit.ln(c, 8)
    (*out)[1] = by + bh + kit.ln(c, 8) + kit.ln(c, 34) * (i as f64)
    (*out)[3] = kit.ln(c, 34)
    if i == n {
        (*out)[0] = bx
        (*out)[2] = bw
        (*out)[1] = by + bh + kit.ln(c, 4)
        (*out)[3] = kit.ln(c, 34) * (n as f64) + kit.ln(c, 8)
    }
}

fn inside(q: *mut [f64; 4], x: f64, y: f64) -> bool {
    return x >= (*q)[0] && x < (*q)[0] + (*q)[2] && y >= (*q)[1] && y < (*q)[1] + (*q)[3]
}

fn chrome(c: *mut render.Ctx, q: *mut [f64; 4]) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    kit.soft_shadow(c, (*q)[0], (*q)[1], (*q)[2], (*q)[3], kit.ln(c, 8), kit.ln(c, 16), kit.ln(c, 6), 200)
    painter.round_rect(z, (*q)[0], (*q)[1], (*q)[2], (*q)[3], kit.ln(c, 8), kit.tokc(c, style.TOK_SURFACE_RAISED))
    painter.round_ring(z, (*q)[0], (*q)[1], (*q)[2], (*q)[3], kit.ln(c, 8), kit.ln(c, 1), kit.tokc(c, style.TOK_BORDER))
}

fn draw(c: *mut render.Ctx, bx: f64, by: f64, bw: f64, bh: f64, list: str, sel: i64, px: f64, py: f64) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let n: usize = kitform.parts(list)
    var q: [f64; 4] = [0.0; 4]
    item_rect(c, bx, by, bw, bh, n, n, &q)
    chrome(c, &q)
    var i: usize = 0
    while i < n {
        item_rect(c, bx, by, bw, bh, n, i, &q)
        if inside(&q, px, py) { painter.round_rect(z, q[0], q[1], q[2], q[3], kit.ln(c, 6), kit.tokc(c, style.TOK_BUTTON_HOVER)) }
        kitapp.text(c, q[0] + kit.ln(c, 10), q[1], q[3], 13, 400, style.TOK_TEXT, kitform.nth(list, i))
        if sel == i as i64 { kit.sym(c, lucide.CHECK, q[0] + q[2] - kit.ln(c, 28), q[1] + (q[3] - kit.ln(c, 16)) / 2.0, kit.ln(c, 16), kit.accent_gfx(c, style.TOK_SURFACE_RAISED)) }
        i = i + 1
    }
}

fn hit(c: *mut render.Ctx, bx: f64, by: f64, bw: f64, bh: f64, list: str, x: f64, y: f64) -> usize {
    let n: usize = kitform.parts(list)
    var q: [f64; 4] = [0.0; 4]
    var i: usize = 0
    while i < n {
        item_rect(c, bx, by, bw, bh, n, i, &q)
        if inside(&q, x, y) { return i }
        i = i + 1
    }
    return NONE
}
