import std.rt
import std.env
import std.fs
import std.dialog
import std.clipboard
import fui.svcq
import fui.svcfile

export { pick_open, pick_save, clip_request, store_get, store_set }

const STORE_ENV: str = "FUI_STORE_DIR"
const HOME_ENV: str = "HOME"
const HOME_STORE: str = "/.local/share/fui"

fn status_of(ok: bool) -> u32 {
    if ok {
        return 1 as u32
    }
    return 0 as u32
}

fn pick_open(title: str, filters: str) -> bool {
    var path: rt.Buf = rt.buf_new()
    let r: i32 = dialog.open_file(title, "", filters, &path)
    if r == dialog.CANCELED {
        rt.buf_free(&path)
        return svcq.push(svcq.EV_OPENED, 0 as u32, "", 0, 0)
    }
    if r != dialog.OK {
        rt.buf_free(&path)
        return false
    }
    var data: rt.Buf = rt.buf_new()
    let ok: bool = svcfile.read_path(rt.buf_str(&path), &data)
    let pushed: bool = svcq.push(svcq.EV_OPENED, status_of(ok), rt.buf_str(&path), rt.buf_ptr(&data), rt.buf_len(&data))
    rt.buf_free(&path)
    rt.buf_free(&data)
    return pushed
}

fn pick_save(title: str, name: str, mime: str, p: u64, n: usize) -> bool {
    var path: rt.Buf = rt.buf_new()
    let r: i32 = dialog.save_file(title, "", name, "", &path)
    if r == dialog.CANCELED {
        rt.buf_free(&path)
        return svcq.push(svcq.EV_SAVED, 0 as u32, "", 0, 0)
    }
    if r != dialog.OK {
        rt.buf_free(&path)
        return false
    }
    let ok: bool = svcfile.write_path(rt.buf_str(&path), p, n)
    let pushed: bool = svcq.push(svcq.EV_SAVED, status_of(ok), rt.buf_str(&path), 0, 0)
    rt.buf_free(&path)
    return pushed
}

fn clip_request() -> bool {
    var text: rt.Buf = rt.buf_new()
    let ok: bool = clipboard.paste_text(&text)
    let pushed: bool = svcq.push(svcq.EV_CLIP, status_of(ok), "", rt.buf_ptr(&text), rt.buf_len(&text))
    rt.buf_free(&text)
    return pushed
}

fn push_key_byte(out: *mut rt.Buf, c: u8) {
    var ok: bool = c >= 97 as u8 && c <= 122 as u8
    ok = ok || (c >= 65 as u8 && c <= 90 as u8)
    ok = ok || (c >= 48 as u8 && c <= 57 as u8)
    ok = ok || c == 45 as u8 || c == 46 as u8 || c == 95 as u8
    if ok {
        rt.buf_push(out, c)
    } else {
        rt.buf_push(out, 95 as u8)
    }
}

fn store_dir(out: *mut rt.Buf) -> bool {
    let dir: str = env.get(STORE_ENV)
    if dir.n > 0 {
        rt.buf_push_bytes(out, dir.p as u64, dir.n)
        return true
    }
    let home: str = env.get(HOME_ENV)
    if home.n == 0 {
        return false
    }
    rt.buf_push_bytes(out, home.p as u64, home.n)
    rt.buf_push_bytes(out, HOME_STORE.p as u64, HOME_STORE.n)
    return true
}

fn store_path(key: str, out: *mut rt.Buf) -> bool {
    if key.n == 0 || !store_dir(out) {
        return false
    }
    rt.buf_push(out, 47 as u8)
    var i: usize = 0
    while i < key.n {
        push_key_byte(out, key.chars(i))
        i = i + 1
    }
    return true
}

fn store_get(key: str, out: *mut rt.Buf) -> bool {
    var path: rt.Buf = rt.buf_new()
    var ok: bool = store_path(key, &path)
    if ok {
        ok = svcfile.read_path(rt.buf_str(&path), out)
    }
    rt.buf_free(&path)
    return ok
}

fn store_set(key: str, p: u64, n: usize) -> bool {
    var dir: rt.Buf = rt.buf_new()
    if !store_dir(&dir) {
        rt.buf_free(&dir)
        return false
    }
    fs.mkdir_all(rt.buf_str(&dir)) catch false
    rt.buf_free(&dir)
    var path: rt.Buf = rt.buf_new()
    var ok: bool = store_path(key, &path)
    if ok {
        ok = svcfile.write_path(rt.buf_str(&path), p, n)
    }
    rt.buf_free(&path)
    return ok
}
