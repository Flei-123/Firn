import std.rt
import services.svc
import services.svcfile
import services.svcclip
import services.svcstore
import fui.svcq
import fui.svcaccept
import fui.svcreply

export { pick_open, pick_save, clip_request, store_get, store_set }

fn status_of(ok: bool) -> u32 {
    if ok {
        return 1 as u32
    }
    return 0 as u32
}

fn pick_open(title: str, filters: str) -> bool {
    var accept: rt.Buf = rt.buf_new()
    svcaccept.from_filters(filters, &accept)
    var id: u32 = 0 as u32
    let s: i32 = svcfile.open(rt.buf_str(&accept), false, &id)
    rt.buf_free(&accept)
    svcreply.pump()
    return s == svc.OK
}

fn pick_save(title: str, name: str, mime: str, p: u64, n: usize) -> bool {
    let s: i32 = svcfile.save(name, mime, p, n)
    if s == svc.NO_BACKEND || s == svc.INVALID {
        return false
    }
    return svcq.push(svcq.EV_SAVED, status_of(s == svc.OK), name, 0, 0)
}

fn clip_request() -> bool {
    var id: u32 = 0 as u32
    let s: i32 = svcclip.paste_text(&id)
    svcreply.pump()
    return s == svc.OK
}

fn store_get(key: str, out: *mut rt.Buf) -> bool {
    return svcstore.get(key, out) == svc.OK
}

fn store_set(key: str, p: u64, n: usize) -> bool {
    let value: str = str { p: p as *mut u8, n: n }
    return svcstore.set(key, value) == svc.OK
}
