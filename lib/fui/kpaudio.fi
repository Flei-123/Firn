import std.rt
import audio.sink
import media.clock
import media.audio.source
import media.audio.sniff
import media.audio.sinkplay

export {
    KpAudio, Installer, ka_new, ka_open, ka_close, ka_attach, ka_pump, ka_pause, ka_resume, ka_seek_ms,
    ka_position_ms, ka_duration_ms, ka_clock_us, ka_set_volume, ka_ended, ka_is_attached, ka_failed,
    ka_set_discard, ka_set_installer, ka_info, ka_is_open, install_none,
}

type Installer = fn(*mut source.Registry, u32)

struct KpAudio {
    sp: sinkplay.SinkPlay,
    open: bool,
    attached: bool,
    failed: bool,
    discard: bool,
    inst: Installer,
}

fn install_none(r: *mut source.Registry, fmt: u32) {
}

fn ka_new() -> KpAudio {
    return KpAudio { sp: sinkplay.sp_new(), open: false, attached: false, failed: false, discard: false, inst: install_none }
}

fn ka_set_installer(a: *mut KpAudio, inst: Installer) {
    (*a).inst = inst
}

fn ka_set_discard(a: *mut KpAudio, on: bool) {
    (*a).discard = on
}

fn ka_is_open(a: *mut KpAudio) -> bool {
    return (*a).open
}

fn ka_is_attached(a: *mut KpAudio) -> bool {
    return (*a).attached
}

fn ka_failed(a: *mut KpAudio) -> bool {
    return (*a).failed
}

fn ka_close(a: *mut KpAudio) {
    sinkplay.sp_close(&(*a).sp)
    (*a).open = false
    (*a).attached = false
    (*a).failed = false
}

fn ka_open(a: *mut KpAudio, data: u64, n: usize) -> bool {
    ka_close(a)
    var r: source.Registry = source.registry_new()
    let f: Installer = (*a).inst
    f(&r, sniff.sniff_format(data, n))
    if !sinkplay.sp_open_with(&(*a).sp, &r, data, n, false) {
        return false
    }
    (*a).open = true
    return true
}

fn ka_info(a: *mut KpAudio) -> source.AudioInfo {
    return sinkplay.sp_info(&(*a).sp)
}

fn ka_attach(a: *mut KpAudio) -> bool {
    if !(*a).open || (*a).failed {
        return false
    }
    if (*a).attached {
        return true
    }
    let inf: source.AudioInfo = sinkplay.sp_info(&(*a).sp)
    var oc: u32 = 2 as u32
    if inf.channels == 1 as u32 {
        oc = 1 as u32
    }
    var ok: bool = false
    if (*a).discard {
        ok = sinkplay.sp_attach(&(*a).sp, sink.sink_open_file("/dev/null", inf.rate, oc, true))
    } else {
        ok = sinkplay.sp_start(&(*a).sp, "firn-kitplayer")
    }
    if !ok {
        (*a).failed = true
        return false
    }
    (*a).attached = true
    return true
}

fn ka_pump(a: *mut KpAudio) -> bool {
    if !(*a).attached {
        return true
    }
    return sinkplay.sp_pump(&(*a).sp)
}

fn ka_pause(a: *mut KpAudio) {
    if (*a).attached {
        sinkplay.sp_pause(&(*a).sp)
    }
}

fn ka_resume(a: *mut KpAudio) {
    if (*a).attached {
        sinkplay.sp_resume(&(*a).sp)
    }
}

fn ka_seek_ms(a: *mut KpAudio, ms: u64) -> bool {
    if !(*a).open {
        return false
    }
    return sinkplay.sp_seek_ms(&(*a).sp, ms)
}

fn ka_position_ms(a: *mut KpAudio) -> u64 {
    return sinkplay.sp_position_ms(&(*a).sp)
}

fn ka_duration_ms(a: *mut KpAudio) -> u64 {
    return sinkplay.sp_duration_ms(&(*a).sp)
}

fn ka_clock_us(a: *mut KpAudio) -> i64 {
    let c: *mut clock.Clock = sinkplay.sp_clock(&(*a).sp)
    let rate: u64 = clock.clock_rate(c) as u64
    if rate == 0 as u64 {
        return 0
    }
    return (clock.clock_samples(c) * (1000000 as u64) / rate) as i64
}

fn ka_set_volume(a: *mut KpAudio, percent: u32) {
    sinkplay.sp_set_volume(&(*a).sp, percent)
}

fn ka_ended(a: *mut KpAudio) -> bool {
    return (*a).attached && sinkplay.sp_is_finished(&(*a).sp)
}
