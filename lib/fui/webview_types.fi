import std.rt

export {
    Input, Event, DamageRect, Rect, Backend,
    input_new, input_free, event_new, event_free, backend_null,
    API_VERSION,
    LOAD_URL, LOAD_HTML,
    ST_NEW, ST_LOADING, ST_READY, ST_FAILED,
    RENDER_UNCHANGED, RENDER_CHANGED, RENDER_BUFFER_TOO_SMALL,
    TICK_IDLE, TICK_DIRTY, TICK_DEAD,
    IN_MOVE, IN_LEAVE, IN_DOWN, IN_UP, IN_WHEEL, IN_KEY_DOWN, IN_KEY_UP, IN_CHAR,
    IN_PREEDIT, IN_COMMIT, IN_FOCUS, IN_BLUR, IN_REPLY,
    EV_TITLE, EV_LOADED, EV_NAV, EV_HOVER, EV_CURSOR, EV_SCROLLED, EV_RESIZED, EV_OVERFLOW,
    EV_CLIP_WRITE, EV_CLIP_READ, EV_CONFIRM, EV_ALERT, EV_OPEN_FILE, EV_SAVE_FILE,
    CAP_IME, CAP_CLIP, CAP_FILES, CAP_DIALOG, CAP_CANVAS, CAP_URL, CAP_AX,
    PERM_CLIP, PERM_DIALOG, PERM_FILES,
    NAV_DENY, NAV_ALLOW, NAV_EXTERNAL,
    EVENT_BUDGET,
}

const API_VERSION: u32 = 0
const LOAD_URL: u32 = 1
const LOAD_HTML: u32 = 2
const ST_NEW: u32 = 0
const ST_LOADING: u32 = 1
const ST_READY: u32 = 2
const ST_FAILED: u32 = 3
const RENDER_UNCHANGED: u32 = 0
const RENDER_CHANGED: u32 = 1
const RENDER_BUFFER_TOO_SMALL: u32 = 2
const TICK_IDLE: u32 = 0
const TICK_DIRTY: u32 = 1
const TICK_DEAD: u32 = 2
const IN_MOVE: u32 = 1
const IN_LEAVE: u32 = 2
const IN_DOWN: u32 = 3
const IN_UP: u32 = 4
const IN_WHEEL: u32 = 5
const IN_KEY_DOWN: u32 = 6
const IN_KEY_UP: u32 = 7
const IN_CHAR: u32 = 8
const IN_PREEDIT: u32 = 9
const IN_COMMIT: u32 = 10
const IN_FOCUS: u32 = 11
const IN_BLUR: u32 = 12
const IN_REPLY: u32 = 13
const EV_TITLE: u32 = 1
const EV_LOADED: u32 = 2
const EV_NAV: u32 = 3
const EV_HOVER: u32 = 4
const EV_CURSOR: u32 = 5
const EV_SCROLLED: u32 = 6
const EV_RESIZED: u32 = 7
const EV_OVERFLOW: u32 = 8
const EV_CLIP_WRITE: u32 = 16
const EV_CLIP_READ: u32 = 17
const EV_CONFIRM: u32 = 18
const EV_ALERT: u32 = 19
const EV_OPEN_FILE: u32 = 20
const EV_SAVE_FILE: u32 = 21
const CAP_IME: u32 = 1
const CAP_CLIP: u32 = 2
const CAP_FILES: u32 = 4
const CAP_DIALOG: u32 = 8
const CAP_CANVAS: u32 = 16
const CAP_URL: u32 = 32
const CAP_AX: u32 = 64
const PERM_CLIP: u32 = 1
const PERM_DIALOG: u32 = 2
const PERM_FILES: u32 = 4
const NAV_DENY: u32 = 0
const NAV_ALLOW: u32 = 1
const NAV_EXTERNAL: u32 = 2
const EVENT_BUDGET: usize = 64

struct Input {
    kind: u32,
    x: f64,
    y: f64,
    dx: f64,
    dy: f64,
    button: u32,
    mods: u32,
    key: u32,
    cp: u32,
    cursor: i32,
    id: u32,
    status: u32,
    text: rt.Buf,
}

struct Event {
    kind: u32,
    a: u32,
    b: u32,
    text: rt.Buf,
}

struct DamageRect {
    x: u32,
    y: u32,
    w: u32,
    h: u32,
}

struct Rect {
    x: f64,
    y: f64,
    w: f64,
    h: f64,
}

struct Backend {
    ud: u64,
    caps: u32,
    create: fn(u64, u32, u32) -> bool,
    destroy: fn(u64),
    load: fn(u64, u32, u64, usize) -> bool,
    resize: fn(u64, u32, u32, u32) -> bool,
    paint: fn(u64, u64, usize, usize, *mut DamageRect) -> u32,
    input: fn(u64, *mut Input) -> bool,
    tick: fn(u64, i64) -> u32,
    next_event: fn(u64, *mut Event) -> bool,
    caret: fn(u64, *mut Rect) -> bool,
    wait_ms: fn(u64, i64) -> i64,
}

fn input_new() -> Input {
    return Input { kind: 0, x: 0.0, y: 0.0, dx: 0.0, dy: 0.0, button: 0, mods: 0, key: 0, cp: 0,
        cursor: 0 - 1, id: 0, status: 0, text: rt.buf_new() }
}

fn input_free(i: *mut Input) {
    rt.buf_free(&(*i).text)
}

fn event_new() -> Event {
    return Event { kind: 0, a: 0, b: 0, text: rt.buf_new() }
}

fn event_free(e: *mut Event) {
    rt.buf_free(&(*e).text)
}

fn null_create(ud: u64, w: u32, h: u32) -> bool { return false }
fn null_destroy(ud: u64) { }
fn null_load(ud: u64, kind: u32, p: u64, n: usize) -> bool { return false }
fn null_resize(ud: u64, w: u32, h: u32, scale: u32) -> bool { return false }
fn null_paint(ud: u64, px: u64, stride: usize, cap: usize, damage: *mut DamageRect) -> u32 { return RENDER_UNCHANGED }
fn null_input(ud: u64, input: *mut Input) -> bool { return false }
fn null_tick(ud: u64, now_us: i64) -> u32 { return TICK_IDLE }
fn null_next_event(ud: u64, ev: *mut Event) -> bool { return false }
fn null_caret(ud: u64, r: *mut Rect) -> bool { return false }
fn null_wait_ms(ud: u64, now_us: i64) -> i64 { return 0 - 1 }

fn backend_null() -> Backend {
    return Backend { ud: 0, caps: 0, create: null_create, destroy: null_destroy, load: null_load,
        resize: null_resize, paint: null_paint, input: null_input, tick: null_tick,
        next_event: null_next_event, caret: null_caret, wait_ms: null_wait_ms }
}
