import std.rt
import std.vec

export { Style, Item, Layout, T_TEXT, T_RECT, T_DOT, T_RULE, F_BOLD, F_ITALIC, F_CODE, F_BLOCK,
    R_TEXT, R_MUTED, R_ACCENT, R_CODE, R_CODE_BG, R_RULE, NONE, layout_new, layout_reset, layout_bytes }

const T_TEXT: u32 = 1
const T_RECT: u32 = 2
const T_DOT: u32 = 3
const T_RULE: u32 = 4

const F_BOLD: u32 = 1
const F_ITALIC: u32 = 2
const F_CODE: u32 = 4
const F_BLOCK: u32 = 8

const R_TEXT: u32 = 0
const R_MUTED: u32 = 1
const R_ACCENT: u32 = 2
const R_CODE: u32 = 3
const R_CODE_BG: u32 = 4
const R_RULE: u32 = 5

const NONE: i64 = -1

struct Style {
    size: f64,
    text: u32,
    muted: u32,
    accent: u32,
    code_fg: u32,
    code_bg: u32,
    rule: u32,
}

struct Item {
    kind: u32,
    flags: u32,
    role: u32,
    off: u32,
    n: u32,
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    size: f64,
}

struct Layout {
    items: Vec[Item],
    pool: rt.Buf,
    w: f64,
    h: f64,
}

fn layout_new() -> Layout {
    return Layout { items: vec_new[Item](), pool: rt.buf_new(), w: 0.0, h: 0.0 }
}

fn layout_reset(l: *mut Layout) {
    vec_clear[Item](&(*l).items)
    rt.buf_clear(&(*l).pool)
    (*l).w = 0.0
    (*l).h = 0.0
}

fn bytes_of[T: Any]() -> usize {
    return size_of[T]()
}

fn layout_bytes() -> usize {
    return bytes_of[Layout]()
}
