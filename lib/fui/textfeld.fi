// SPDX-License-Identifier: GPL-2.0-only
// lib/widget/textfeld.fi -- EIN EINZEILIGES TEXTFELD, OHNE BILDSCHIRM.
//
// ===================================================================
// WARUM DIESE DATEI EXISTIERT (Runde TEXTBOX-2)
// ===================================================================
//
// Bis zu dieser Runde lag "die Textbox" der Adresszeile in drei Dateien
// zugleich: der Puffer in lib/android/a_main.fi (`G_EINGABE`), die
// Schreibmarke in lib/android/ui.fi (`cpos`, `sel` = alles oder nichts)
// und die Rechnung in UTF-16-Einheiten in lib/android/ime.fi (`G_SEL`,
// `G_COMP`). Drei Orte, drei halbe Wahrheiten -- und ein Zeiger, der nur
// "am Ende" oder "alles markiert" kannte. Justins Frage war: "Was fehlt
// noch bis zu einer normalen Textbox?" Die Antwort: ein Ort, an dem sie
// GANZ steht.
//
// Das ist diese Datei. Sie kennt KEINE Leinwand, KEIN Android, KEINE
// Schrift. Sie kennt einen Puffer in WTF-8, eine Schreibmarke (`zeiger`),
// einen Anker (`anker`; ungleich `zeiger` heisst: es ist etwas
// markiert) und einen schwebenden Bereich (`komp_a..komp_b`, das Wort,
// das eine Bildschirmtastatur gerade zusammensetzt). Alles, was ein
// Textfeld TUT -- einfuegen, loeschen, markieren, Wort greifen, Zeiger
// mit Pfeiltasten bewegen, Zeiger aus einer Fingerstelle bestimmen --
// steht hier EINMAL, und jeder Bildschirm (Android, X11, Windows) malt
// nur noch, was hier steht.
//
// ===================================================================
// WAS ES BRAUCHT, UM EINEN FINGER ZU VERSTEHEN
// ===================================================================
//
// Ein Textfeld ohne Schrift weiss nicht, wie breit "Tirol" ist. Es
// fragt: `tf_zeiger_aus_x(t, x, mess, ctx)` bekommt eine Messfunktion
// `mess(ctx, p, n) -> Breite der ersten n Oktett in Bildpunkten`. Der
// Aufrufer gibt seine Schrift ueber `ctx` mit. So bleibt die Regel "wer
// auf die rechte Haelfte eines Zeichens tippt, will dahinter stehen"
// hier, und die Schrift dort, wo sie hingehoert.
//
// ===================================================================
// MASSE
// ===================================================================
//
// Alle Stellen sind OKTETT-Versaetze in den Puffer und liegen immer auf
// einer Zeichengrenze (kein 10xxxxxx-Fortsetzungsoktett). Android
// rechnet in UTF-16-Einheiten; `tf_u16_von` und `tf_oktett_von_u16`
// rechnen um, damit lib/android/ime.fi es nicht selbst tun muss.
//
// KEIN Sammlerobjekt und KEIN `rt`: der Puffer kommt vom Aufrufer
// (`tf_init`), alle Rechnungen laufen auf rohen Zeigern, jede Funktion
// ausser den zwei mit Messrueckruf ist `#[no_gc]` -- damit darf die
// Datei auch von einem Faden ohne Sammler benutzt werden.

export {
    Textfeld,
    tf_new, tf_init,
    tf_ptr, tf_len, tf_cap, tf_zeiger, tf_anker, tf_sel_a, tf_sel_b,
    tf_hat_sel, tf_komp_a, tf_komp_b, tf_hat_komp,
    tf_text_setzen, tf_leeren, tf_laenge_setzen,
    tf_alles, tf_setze, tf_zeiger_setzen, tf_auswahl_weg,
    tf_einfuegen, tf_einfuegen_cp, tf_ersetzen, tf_loesche,
    tf_rueck, tf_entf, tf_auswahl_loeschen,
    tf_links, tf_rechts, tf_anfang, tf_ende,
    tf_vor, tf_nach, tf_grenze,
    tf_wort_um, tf_wort_markieren, tf_ist_wortzeichen,
    tf_kopieren, tf_ausschneiden,
    tf_komp_setzen, tf_komp_ende,
    tf_x_von, tf_zeiger_aus_x,
    tf_u16_von, tf_oktett_von_u16, tf_u16_len,
    tf_cp_bei, tf_cp_kodieren,
    tf_zieh, tf_set_zieh, tf_geheim, tf_set_geheim,
}

struct Textfeld {
    p: u64,          // der Puffer (WTF-8), gehoert dem Aufrufer
    n: usize,        // wieviele Oktett belegt sind
    cap: usize,      // wieviele Platz haben
    zeiger: usize,   // die Schreibmarke, Oktettversatz
    anker: usize,    // das andere Ende der Markierung (== zeiger: keine)
    komp_a: usize,   // schwebender Text [komp_a, komp_b)
    komp_b: usize,
    geheim: u32,     // 1 = Passwort: nichts nach draussen geben
    zieh: u32,       // 0 keine, 1 Zeiger wird gezogen, 2 Anfangsgriff, 3 Endgriff
    rolle: f64,      // waagrechter Versatz in Bildpunkten (fuer lange Texte)
}

#[no_gc]
fn tf_new() -> Textfeld {
    return Textfeld {
        p: 0, n: 0, cap: 0, zeiger: 0, anker: 0, komp_a: 0, komp_b: 0,
        geheim: 0, zieh: 0, rolle: 0.0,
    }
}

#[no_gc]
fn tf_init(t: *mut Textfeld, p: u64, cap: usize) {
    (*t).p = p
    (*t).cap = cap
    (*t).n = 0
    (*t).zeiger = 0
    (*t).anker = 0
    (*t).komp_a = 0
    (*t).komp_b = 0
}

// ------------------------------------------------------------ Lesen
#[no_gc]
fn tf_ptr(t: *mut Textfeld) -> u64 { return (*t).p }
#[no_gc]
fn tf_len(t: *mut Textfeld) -> usize { return (*t).n }
#[no_gc]
fn tf_cap(t: *mut Textfeld) -> usize { return (*t).cap }
#[no_gc]
fn tf_zeiger(t: *mut Textfeld) -> usize { return (*t).zeiger }
#[no_gc]
fn tf_anker(t: *mut Textfeld) -> usize { return (*t).anker }
#[no_gc]
fn tf_hat_sel(t: *mut Textfeld) -> bool { return (*t).anker != (*t).zeiger }
#[no_gc]
fn tf_komp_a(t: *mut Textfeld) -> usize { return (*t).komp_a }
#[no_gc]
fn tf_komp_b(t: *mut Textfeld) -> usize { return (*t).komp_b }
#[no_gc]
fn tf_hat_komp(t: *mut Textfeld) -> bool { return (*t).komp_b > (*t).komp_a }
#[no_gc]
fn tf_zieh(t: *mut Textfeld) -> u32 { return (*t).zieh }
#[no_gc]
fn tf_set_zieh(t: *mut Textfeld, z: u32) { (*t).zieh = z }
#[no_gc]
fn tf_geheim(t: *mut Textfeld) -> bool { return (*t).geheim != 0 }
#[no_gc]
fn tf_set_geheim(t: *mut Textfeld, g: bool) {
    if g { (*t).geheim = 1 } else { (*t).geheim = 0 }
}

// Anfang und Ende der Markierung, geordnet.
#[no_gc]
fn tf_sel_a(t: *mut Textfeld) -> usize {
    if (*t).anker < (*t).zeiger { return (*t).anker }
    return (*t).zeiger
}
#[no_gc]
fn tf_sel_b(t: *mut Textfeld) -> usize {
    if (*t).anker > (*t).zeiger { return (*t).anker }
    return (*t).zeiger
}

// ----------------------------------------------------- Zeichengrenzen
#[no_gc]
fn okt(t: *mut Textfeld, i: usize) -> u8 {
    return *(((*t).p + i as u64) as *mut u8)
}

// Ist `i` eine Zeichengrenze? 0 und n sind es immer.
#[no_gc]
fn tf_grenze(t: *mut Textfeld, i: usize) -> bool {
    if i == 0 || i >= (*t).n {
        return true
    }
    return (okt(t, i) & 0xC0 as u8) != 0x80 as u8
}

// Die Grenze VOR `i` (0, wenn es keine gibt).
#[no_gc]
fn tf_vor(t: *mut Textfeld, i: usize) -> usize {
    if i == 0 {
        return 0
    }
    var a: usize = i - 1
    while a > 0 && !tf_grenze(t, a) {
        a = a - 1
    }
    return a
}

// Die Grenze NACH `i` (n, wenn es keine gibt).
#[no_gc]
fn tf_nach(t: *mut Textfeld, i: usize) -> usize {
    if i >= (*t).n {
        return (*t).n
    }
    var b: usize = i + 1
    while b < (*t).n && !tf_grenze(t, b) {
        b = b + 1
    }
    return b
}

// Auf die naechste Grenze links runden und in den Puffer klemmen.
#[no_gc]
fn klemm(t: *mut Textfeld, i0: usize) -> usize {
    var i: usize = i0
    if i > (*t).n {
        i = (*t).n
    }
    while i > 0 && !tf_grenze(t, i) {
        i = i - 1
    }
    return i
}

// ------------------------------------------------------ Kodepunkte
// Der Kodepunkt an Oktett `i`; `*adv` = wieviele Oktett er belegt.
#[no_gc]
fn tf_cp_bei(t: *mut Textfeld, i: usize, adv: *mut usize) -> u32 {
    let n: usize = (*t).n
    if i >= n {
        *adv = 0
        return 0 as u32
    }
    let b0: u32 = okt(t, i) as u32
    if b0 < 0x80 as u32 {
        *adv = 1
        return b0
    }
    if b0 >= 0xF0 as u32 && i + 3 < n {
        *adv = 4
        return ((b0 & 0x07 as u32) << 18)
            | ((okt(t, i + 1) as u32 & 0x3F as u32) << 12)
            | ((okt(t, i + 2) as u32 & 0x3F as u32) << 6)
            | (okt(t, i + 3) as u32 & 0x3F as u32)
    }
    if b0 >= 0xE0 as u32 && i + 2 < n {
        *adv = 3
        return ((b0 & 0x0F as u32) << 12)
            | ((okt(t, i + 1) as u32 & 0x3F as u32) << 6)
            | (okt(t, i + 2) as u32 & 0x3F as u32)
    }
    if b0 >= 0xC0 as u32 && i + 1 < n {
        *adv = 2
        return ((b0 & 0x1F as u32) << 6)
            | (okt(t, i + 1) as u32 & 0x3F as u32)
    }
    *adv = 1
    return 0xFFFD as u32
}

// Einen Kodepunkt nach WTF-8 kodieren (Vieroktettzweig fuer Emoji).
// Rueckgabe: Zahl der Oktett in `roh` (Platz fuer 4).
#[no_gc]
fn tf_cp_kodieren(cp: u32, roh: u64) -> usize {
    if cp < 0x80 as u32 {
        *(roh as *mut u8) = cp as u8
        return 1
    }
    if cp < 0x800 as u32 {
        *(roh as *mut u8) = (0xC0 as u32 | (cp >> 6)) as u8
        *((roh + 1) as *mut u8) = (0x80 as u32 | (cp & 0x3F as u32)) as u8
        return 2
    }
    if cp < 0x10000 as u32 {
        *(roh as *mut u8) = (0xE0 as u32 | (cp >> 12)) as u8
        *((roh + 1) as *mut u8) = (0x80 as u32 | ((cp >> 6) & 0x3F as u32)) as u8
        *((roh + 2) as *mut u8) = (0x80 as u32 | (cp & 0x3F as u32)) as u8
        return 3
    }
    *(roh as *mut u8) = (0xF0 as u32 | (cp >> 18)) as u8
    *((roh + 1) as *mut u8) = (0x80 as u32 | ((cp >> 12) & 0x3F as u32)) as u8
    *((roh + 2) as *mut u8) = (0x80 as u32 | ((cp >> 6) & 0x3F as u32)) as u8
    *((roh + 3) as *mut u8) = (0x80 as u32 | (cp & 0x3F as u32)) as u8
    return 4
}

// ------------------------------------------------------- Inhalt setzen
// Den ganzen Text ersetzen; Zeiger und Anker stehen danach am Ende.
#[no_gc]
fn tf_text_setzen(t: *mut Textfeld, p: u64, n0: usize) {
    var n: usize = n0
    if n > (*t).cap {
        n = (*t).cap
    }
    var i: usize = 0
    while i < n {
        *(((*t).p + i as u64) as *mut u8) = *((p + i as u64) as *mut u8)
        i = i + 1
    }
    (*t).n = n
    (*t).zeiger = n
    (*t).anker = n
    (*t).komp_a = 0
    (*t).komp_b = 0
}

#[no_gc]
fn tf_leeren(t: *mut Textfeld) {
    (*t).n = 0
    (*t).zeiger = 0
    (*t).anker = 0
    (*t).komp_a = 0
    (*t).komp_b = 0
}

// Jemand hat DIREKT in den Puffer geschrieben (die Eingabemethode tut
// das) und meldet die neue Laenge. Zeiger, Anker und Schwebendes werden
// in den Puffer geklemmt; wo der Zeiger hin soll, sagt der Aufrufer
// danach mit `tf_setze`.
#[no_gc]
fn tf_laenge_setzen(t: *mut Textfeld, n0: usize) {
    var n: usize = n0
    if n > (*t).cap {
        n = (*t).cap
    }
    (*t).n = n
    (*t).zeiger = klemm(t, (*t).zeiger)
    (*t).anker = klemm(t, (*t).anker)
    (*t).komp_a = klemm(t, (*t).komp_a)
    (*t).komp_b = klemm(t, (*t).komp_b)
    if (*t).komp_b < (*t).komp_a {
        (*t).komp_b = (*t).komp_a
    }
}

// ------------------------------------------------------- Markierung
#[no_gc]
fn tf_alles(t: *mut Textfeld) {
    (*t).anker = 0
    (*t).zeiger = (*t).n
}

// Zeiger UND Anker setzen (Oktett). Beide werden auf Grenzen geklemmt.
#[no_gc]
fn tf_setze(t: *mut Textfeld, zeiger: usize, anker: usize) {
    (*t).zeiger = klemm(t, zeiger)
    (*t).anker = klemm(t, anker)
}

// Nur den Zeiger; `halten` = die Markierung vom Anker aus erweitern
// (Umschalttaste), sonst Anker mitnehmen.
#[no_gc]
fn tf_zeiger_setzen(t: *mut Textfeld, zeiger: usize, halten: bool) {
    (*t).zeiger = klemm(t, zeiger)
    if !halten {
        (*t).anker = (*t).zeiger
    }
}

#[no_gc]
fn tf_auswahl_weg(t: *mut Textfeld) {
    (*t).anker = (*t).zeiger
}

// --------------------------------------------------- Einfuegen/Loeschen
// [a, b) durch `n` Oktett ab `p` ersetzen. Zeiger und Anker stehen
// danach hinter dem Eingefuegten. Rueckgabe: falsch, wenn es nicht
// passt -- dann ist NICHTS geaendert.
#[no_gc]
fn tf_ersetzen(t: *mut Textfeld, a0: usize, b0: usize, p: u64,
    n: usize) -> bool {
    var a: usize = klemm(t, a0)
    var b: usize = klemm(t, b0)
    if b < a {
        let x: usize = a
        a = b
        b = x
    }
    let alt: usize = (*t).n
    let weg: usize = b - a
    if alt - weg + n > (*t).cap {
        return false
    }
    // Den Rest hinter `b` verschieben. Beide Richtungen sind moeglich,
    // also die sichere: nach hinten von hinten, nach vorn von vorn.
    if n > weg {
        let d: usize = n - weg
        var i: usize = alt
        while i > b {
            *(((*t).p + (i - 1 + d) as u64) as *mut u8) =
                *(((*t).p + (i - 1) as u64) as *mut u8)
            i = i - 1
        }
    } else if n < weg {
        let d: usize = weg - n
        var i: usize = b
        while i < alt {
            *(((*t).p + (i - d) as u64) as *mut u8) =
                *(((*t).p + i as u64) as *mut u8)
            i = i + 1
        }
    }
    var j: usize = 0
    while j < n {
        *(((*t).p + (a + j) as u64) as *mut u8) = *((p + j as u64) as *mut u8)
        j = j + 1
    }
    (*t).n = alt - weg + n
    (*t).zeiger = a + n
    (*t).anker = a + n
    // Schwebendes, das den Bereich beruehrt, ist damit vorbei; was
    // dahinter liegt, rueckt mit.
    if (*t).komp_b > a && (*t).komp_a <= b {
        (*t).komp_a = 0
        (*t).komp_b = 0
    } else if (*t).komp_a > b {
        (*t).komp_a = (*t).komp_a + n - weg
        (*t).komp_b = (*t).komp_b + n - weg
    }
    return true
}

// Text an der Marke einfuegen. Ist etwas markiert, wird es ERSETZT --
// so tut es jedes Textfeld, und so hat es MOBIL8 fuer die Adresszeile
// verlangt.
#[no_gc]
fn tf_einfuegen(t: *mut Textfeld, p: u64, n: usize) -> bool {
    return tf_ersetzen(t, tf_sel_a(t), tf_sel_b(t), p, n)
}

#[no_gc]
fn tf_einfuegen_cp(t: *mut Textfeld, cp: u32) -> bool {
    if cp == 0 as u32 {
        return false
    }
    var roh: [u8; 4] = [0; 4]
    let k: usize = tf_cp_kodieren(cp, (&roh[0]) as u64)
    return tf_einfuegen(t, (&roh[0]) as u64, k)
}

#[no_gc]
fn tf_loesche(t: *mut Textfeld, a: usize, b: usize) -> bool {
    return tf_ersetzen(t, a, b, 0, 0)
}

// Ruecktaste: Markierung weg, sonst das Zeichen VOR dem Zeiger.
#[no_gc]
fn tf_rueck(t: *mut Textfeld) -> bool {
    if tf_hat_sel(t) {
        return tf_loesche(t, tf_sel_a(t), tf_sel_b(t))
    }
    if (*t).zeiger == 0 {
        return false
    }
    let a: usize = tf_vor(t, (*t).zeiger)
    return tf_loesche(t, a, (*t).zeiger)
}

// Entf: Markierung weg, sonst das Zeichen HINTER dem Zeiger.
#[no_gc]
fn tf_entf(t: *mut Textfeld) -> bool {
    if tf_hat_sel(t) {
        return tf_loesche(t, tf_sel_a(t), tf_sel_b(t))
    }
    if (*t).zeiger >= (*t).n {
        return false
    }
    let b: usize = tf_nach(t, (*t).zeiger)
    return tf_loesche(t, (*t).zeiger, b)
}

#[no_gc]
fn tf_auswahl_loeschen(t: *mut Textfeld) -> bool {
    if !tf_hat_sel(t) {
        return false
    }
    return tf_loesche(t, tf_sel_a(t), tf_sel_b(t))
}

// ------------------------------------------------------- Pfeiltasten
// Ohne `halten` und mit Markierung: der Zeiger springt an deren Rand
// (links: Anfang, rechts: Ende) -- so machen es alle Textfelder.
#[no_gc]
fn tf_links(t: *mut Textfeld, halten: bool) {
    if !halten && tf_hat_sel(t) {
        let a: usize = tf_sel_a(t)
        (*t).zeiger = a
        (*t).anker = a
        return
    }
    tf_zeiger_setzen(t, tf_vor(t, (*t).zeiger), halten)
}

#[no_gc]
fn tf_rechts(t: *mut Textfeld, halten: bool) {
    if !halten && tf_hat_sel(t) {
        let b: usize = tf_sel_b(t)
        (*t).zeiger = b
        (*t).anker = b
        return
    }
    tf_zeiger_setzen(t, tf_nach(t, (*t).zeiger), halten)
}

#[no_gc]
fn tf_anfang(t: *mut Textfeld, halten: bool) {
    tf_zeiger_setzen(t, 0, halten)
}

#[no_gc]
fn tf_ende(t: *mut Textfeld, halten: bool) {
    tf_zeiger_setzen(t, (*t).n, halten)
}

// ------------------------------------------------------------- Woerter
// Was in einer Adresszeile ein Wort ist: Buchstaben, Ziffern, `_`, `-`
// und alles ab 0x80 (fremde Schriften). Trenner sind `/ . : ? = & # @`
// und Leerraum -- ein Langdruck auf "wikipedia" in
// `de.wikipedia.org/wiki/Tirol` soll "wikipedia" greifen, nicht die
// ganze Zeile.
#[no_gc]
fn tf_ist_wortzeichen(b: u8) -> bool {
    if b >= 0x80 as u8 {
        return true
    }
    if b >= 48 as u8 && b <= 57 as u8 {
        return true
    }
    if b >= 65 as u8 && b <= 90 as u8 {
        return true
    }
    if b >= 97 as u8 && b <= 122 as u8 {
        return true
    }
    return b == 95 as u8 || b == 45 as u8
}

// Das Wort um Oktett `pos`: [*a, *b). Steht `pos` auf einem Trenner,
// wird das Zeichen selbst gegriffen.
#[no_gc]
fn tf_wort_um(t: *mut Textfeld, pos0: usize, a: *mut usize, b: *mut usize) {
    let n: usize = (*t).n
    if n == 0 {
        *a = 0
        *b = 0
        return
    }
    var pos: usize = klemm(t, pos0)
    if pos >= n {
        pos = tf_vor(t, n)
    }
    if !tf_ist_wortzeichen(okt(t, pos)) {
        // vielleicht steht der Zeiger genau HINTER einem Wort
        if pos > 0 && tf_ist_wortzeichen(okt(t, pos - 1)) {
            pos = pos - 1
        } else {
            *a = pos
            *b = tf_nach(t, pos)
            return
        }
    }
    var x: usize = pos
    while x > 0 && tf_ist_wortzeichen(okt(t, x - 1)) {
        x = x - 1
    }
    var y: usize = pos
    while y < n && tf_ist_wortzeichen(okt(t, y)) {
        y = y + 1
    }
    *a = x
    *b = y
}

#[no_gc]
fn tf_wort_markieren(t: *mut Textfeld, pos: usize) {
    var a: usize = 0
    var b: usize = 0
    tf_wort_um(t, pos, &a, &b)
    (*t).anker = a
    (*t).zeiger = b
}

// ---------------------------------------------------- Zwischenablage
// Die Markierung nach `ziel` kopieren (hoechstens `cap`). Rueckgabe:
// Laenge; 0 wenn nichts markiert ist oder das Feld geheim ist.
#[no_gc]
fn tf_kopieren(t: *mut Textfeld, ziel: u64, cap: usize) -> usize {
    if (*t).geheim != 0 || !tf_hat_sel(t) {
        return 0
    }
    let a: usize = tf_sel_a(t)
    var k: usize = tf_sel_b(t) - a
    if k > cap {
        k = cap
    }
    var i: usize = 0
    while i < k {
        *((ziel + i as u64) as *mut u8) = okt(t, a + i)
        i = i + 1
    }
    return k
}

#[no_gc]
fn tf_ausschneiden(t: *mut Textfeld, ziel: u64, cap: usize) -> usize {
    let k: usize = tf_kopieren(t, ziel, cap)
    if k > 0 {
        let ok: bool = tf_auswahl_loeschen(t)
    }
    return k
}

// ------------------------------------------------------- Schwebendes
#[no_gc]
fn tf_komp_setzen(t: *mut Textfeld, a: usize, b: usize) {
    (*t).komp_a = klemm(t, a)
    (*t).komp_b = klemm(t, b)
    if (*t).komp_b < (*t).komp_a {
        let x: usize = (*t).komp_a
        (*t).komp_a = (*t).komp_b
        (*t).komp_b = x
    }
}

#[no_gc]
fn tf_komp_ende(t: *mut Textfeld) {
    (*t).komp_a = 0
    (*t).komp_b = 0
}

// ----------------------------------------------------- Finger und Schrift
// Die Bildpunktstelle einer Grenze `i`, relativ zum Textanfang.
fn tf_x_von(t: *mut Textfeld, i0: usize, mess: fn(u64, u64, usize) -> f64,
    ctx: u64) -> f64 {
    let i: usize = klemm(t, i0)
    if i == 0 {
        return 0.0
    }
    return mess(ctx, (*t).p, i)
}

// Die Grenze, die einer Bildpunktstelle `x` (relativ zum Textanfang) am
// NAECHSTEN liegt -- nicht die letzte, die noch davor passt. Wer auf die
// rechte Haelfte eines Zeichens tippt, will dahinter stehen.
fn tf_zeiger_aus_x(t: *mut Textfeld, x: f64,
    mess: fn(u64, u64, usize) -> f64, ctx: u64) -> usize {
    if x <= 0.0 || (*t).n == 0 {
        return 0
    }
    var best: usize = 0
    var bestd: f64 = x
    var i: usize = 1
    while i <= (*t).n {
        if tf_grenze(t, i) {
            let w: f64 = mess(ctx, (*t).p, i)
            var d: f64 = w - x
            if d < 0.0 {
                d = 0.0 - d
            }
            if d < bestd {
                bestd = d
                best = i
            }
            if w > x + bestd {
                break
            }
        }
        i = i + 1
    }
    return best
}

// ------------------------------------------------------------- UTF-16
// Wieviele UTF-16-Einheiten stehen VOR Oktett `i`? Ein Kodepunkt ab
// 0x10000 zaehlt zwei. Das ist die Waehrung, in der Android rechnet.
#[no_gc]
fn tf_u16_von(t: *mut Textfeld, i0: usize) -> usize {
    let i: usize = klemm(t, i0)
    var k: usize = 0
    var j: usize = 0
    var adv: usize = 0
    while j < i {
        let cp: u32 = tf_cp_bei(t, j, &adv)
        if adv == 0 {
            break
        }
        if cp >= 0x10000 as u32 {
            k = k + 2
        } else {
            k = k + 1
        }
        j = j + adv
    }
    return k
}

#[no_gc]
fn tf_u16_len(t: *mut Textfeld) -> usize {
    return tf_u16_von(t, (*t).n)
}

// Der Oktettversatz der UTF-16-Einheit `e` (klemmt auf n). Faellt `e`
// in ein Ersatzpaar, gilt der Anfang des Zeichens.
#[no_gc]
fn tf_oktett_von_u16(t: *mut Textfeld, e: usize) -> usize {
    var k: usize = 0
    var j: usize = 0
    var adv: usize = 0
    while j < (*t).n {
        if k >= e {
            return j
        }
        let cp: u32 = tf_cp_bei(t, j, &adv)
        if adv == 0 {
            break
        }
        if cp >= 0x10000 as u32 {
            k = k + 2
        } else {
            k = k + 1
        }
        j = j + adv
    }
    return (*t).n
}
