export { Spec, chat, article }

struct Spec {
    h_px: [f64; 4],
    h_top: [f64; 4],
    h_bot: [f64; 4],
    h_lhk: f64,
    lhk: f64,
    para_gap: f64,
    tight_gap: f64,
    li_gap: f64,
    list_gap: f64,
    indent: f64,
    muted_body: bool,
    strong_text: bool,
    code_head: bool,
    pre_padx: f64,
    pre_padt: f64,
    pre_radius: f64,
    pre_k: f64,
    pre_lhk: f64,
    pre_top: f64,
    pre_bot: f64,
    pre_border: f64,
    code_pad: f64,
    code_k: f64,
    code_radius: f64,
    code_vpad: f64,
    code_accent: bool,
    code_ring: bool,
    pad_x: f64,
    pad_y: f64,
}

fn chat() -> Spec {
    return Spec {
        h_px: [24.0, 20.48, 17.6, 16.0], h_top: [22.4, 22.4, 22.4, 22.4], h_bot: [11.2, 11.2, 11.2, 11.2],
        h_lhk: 1.3, lhk: 1.5, para_gap: 8.0, tight_gap: 3.0, li_gap: 2.88, list_gap: 8.0, indent: 22.4,
        muted_body: false, strong_text: false,
        code_head: true, pre_padx: 16.0, pre_padt: 14.4, pre_radius: 12.0, pre_k: 12.5 / 14.0, pre_lhk: 1.55, pre_top: 16.0, pre_bot: 16.0, pre_border: 1.0,
        code_pad: 4.8, code_k: 0.86, code_radius: 6.0, code_vpad: 1.8, code_accent: false, code_ring: true,
        pad_x: 0.0, pad_y: 0.0,
    }
}

fn article() -> Spec {
    return Spec {
        h_px: [26.0, 19.0, 17.0, 16.0], h_top: [0.0, 20.0, 16.0, 16.0], h_bot: [14.0, 8.0, 8.0, 8.0],
        h_lhk: 1.6, lhk: 1.6, para_gap: 8.0, tight_gap: 2.0, li_gap: 2.0, list_gap: 8.0, indent: 22.0,
        muted_body: true, strong_text: true,
        code_head: false, pre_padx: 15.0, pre_padt: 13.0, pre_radius: 10.0, pre_k: 13.0 / 14.0, pre_lhk: 1.5, pre_top: 12.0, pre_bot: 9.0, pre_border: 1.0,
        code_pad: 6.0, code_k: 12.5 / 14.0, code_radius: 5.0, code_vpad: 1.0, code_accent: true, code_ring: false,
        pad_x: 30.0, pad_y: 24.0,
    }
}
