// SPDX-License-Identifier: MPL-2.0
import std.rt

export { PumpMux, mux_blank, mux_add, mux_count, mux_fd, mux_ms, mux_step }

const SLOT_BYTES: usize = 48
const POLL_MS: i64 = 10
const NO_FD: i32 = 0 - 1

struct Slot {
    ud: u64,
    fd: fn(u64) -> i32,
    ms: fn(u64, i64) -> i64,
    step: fn(u64) -> bool,
    next: *mut Slot,
}

struct PumpMux {
    head: *mut Slot,
    count: usize,
}

fn mux_blank() -> PumpMux {
    return PumpMux { head: 0 as *mut Slot, count: 0 }
}

fn mux_count(m: *mut PumpMux) -> usize { return (*m).count }

fn mux_add(m: *mut PumpMux, ud: u64, fd: fn(u64) -> i32, ms: fn(u64, i64) -> i64, step: fn(u64) -> bool) {
    let s: *mut Slot = rt.heap_alloc(SLOT_BYTES) as *mut Slot
    (*s).ud = ud
    (*s).fd = fd
    (*s).ms = ms
    (*s).step = step
    (*s).next = (*m).head
    (*m).head = s
    (*m).count = (*m).count + 1
}

fn watched(m: *mut PumpMux) -> usize {
    var n: usize = 0
    var s: *mut Slot = (*m).head
    while s != 0 as *mut Slot {
        let f: fn(u64) -> i32 = (*s).fd
        if f((*s).ud) >= 0 { n = n + 1 }
        s = (*s).next
    }
    return n
}

fn mux_fd(ud: u64) -> i32 {
    var s: *mut Slot = (*(ud as *mut PumpMux)).head
    while s != 0 as *mut Slot {
        let f: fn(u64) -> i32 = (*s).fd
        let d: i32 = f((*s).ud)
        if d >= 0 { return d }
        s = (*s).next
    }
    return NO_FD
}

fn mux_ms(ud: u64, wanted: i64) -> i64 {
    let m: *mut PumpMux = ud as *mut PumpMux
    var ms: i64 = wanted
    if watched(m) > 1 && (ms < 0 || ms > POLL_MS) { ms = POLL_MS }
    var s: *mut Slot = (*m).head
    while s != 0 as *mut Slot {
        let f: fn(u64, i64) -> i64 = (*s).ms
        let one: i64 = f((*s).ud, ms)
        if one >= 0 && (ms < 0 || one < ms) { ms = one }
        s = (*s).next
    }
    return ms
}

fn mux_step(ud: u64) -> bool {
    var any: bool = false
    var s: *mut Slot = (*(ud as *mut PumpMux)).head
    while s != 0 as *mut Slot {
        let f: fn(u64) -> bool = (*s).step
        if f((*s).ud) { any = true }
        s = (*s).next
    }
    return any
}
