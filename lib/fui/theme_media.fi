import std.rt

export {
    media_bg, media_fg, media_btn, media_track, media_accent, media_backdrop, media_notice, media_mute_slash,
    close_hover_bg, close_hover_bg_print, close_hover_glyph, rgb_only,
}

#[no_gc]
fn media_bg(video: bool) -> u32 {
    if video {
        return 0xFF202124 as u32
    }
    return 0xFFF1F3F4 as u32
}

#[no_gc]
fn media_fg(video: bool) -> u32 {
    if video {
        return 0xFFFFFFFF as u32
    }
    return 0xFF202124 as u32
}

#[no_gc]
fn media_btn(video: bool) -> u32 {
    if video {
        return 0xFF3C4043 as u32
    }
    return 0xFFDADCE0 as u32
}

#[no_gc]
fn media_track(video: bool) -> u32 {
    if video {
        return 0xFF5F6368 as u32
    }
    return 0xFFCCCCCC as u32
}

#[no_gc]
fn media_accent(video: bool) -> u32 {
    if video {
        return 0xFF8AB4F8 as u32
    }
    return 0xFF1A73E8 as u32
}

#[no_gc]
fn media_backdrop(video: bool) -> u32 {
    if video {
        return 0xFF000000 as u32
    }
    return 0xFFDADCE0 as u32
}

#[no_gc]
fn media_notice() -> u32 {
    return 0xFFBDC1C6 as u32
}

#[no_gc]
fn media_mute_slash() -> u32 {
    return 0xFFD93025 as u32
}

#[no_gc]
fn close_hover_bg() -> u32 {
    return 0xC42B1C as u32
}

#[no_gc]
fn close_hover_bg_print() -> u32 {
    return 0xA02419 as u32
}

#[no_gc]
fn close_hover_glyph() -> u32 {
    return 0xFFFFFF as u32
}

#[no_gc]
fn rgb_only(c: u32) -> u32 {
    return c & 0xFFFFFF as u32
}
