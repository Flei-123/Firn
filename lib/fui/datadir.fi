import std.rt
import std.env
import plat.exedir

export { file }

const CANDIDATES: usize = 5

fn push_str(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn dir_of(i: usize, b: *mut rt.Buf) -> bool {
    if i == 0 {
        let v: str = env.get("FUI_DATA_DIR")
        if v.n == 0 { return false }
        push_str(b, v)
        return true
    }
    if i == 1 {
        if !exedir.dir(b) { return false }
        push_str(b, "/data")
        return true
    }
    if i == 2 {
        push_str(b, "data")
        return true
    }
    if i == 3 {
        push_str(b, "examples/fui_apps/data")
        return true
    }
    let v: str = env.get("FIRNLIB")
    if v.n == 0 { return false }
    push_str(b, v)
    push_str(b, "/../examples/fui_apps/data")
    return true
}

fn exists(b: *mut rt.Buf) -> bool {
    var probe: rt.Buf = rt.buf_new()
    let ok: bool = rt.read_file(rt.buf_ptr(b), &probe)
    rt.buf_free(&probe)
    return ok
}

#[allow_escape]
fn file(name: str) -> str {
    let out: *mut rt.Buf = rt.heap_alloc(64) as *mut rt.Buf
    var i: usize = 0
    while i < CANDIDATES {
        *out = rt.buf_new()
        if dir_of(i, out) {
            push_str(out, "/")
            push_str(out, name)
            rt.buf_push(out, 0 as u8)
            if exists(out) { return str { p: rt.buf_ptr(out) as *mut u8, n: rt.buf_len(out) - 1 } }
        }
        rt.buf_free(out)
        i = i + 1
    }
    return name
}
