// SPDX-License-Identifier: MPL-2.0
// lib/fui/uistr.fi -- THE STANDARD TEXTS OF fUi, LOCALISED (gap list #64).
//
// Every string that fUi's own dialogs and pickers show or speak (OK/Cancel, the file dialog, the colour and
// font dialogs, message boxes) is a function `tr_<name>() -> str` in its module. Each of them asks this file:
//
//     fn tr_ok() -> str { return uistr.t("colordlg.ok", "OK") }
//
// The second argument is the ENGLISH text and the answer when the language is English or the key has no
// translation, so a missing translation is never an empty label. A program picks the language once:
//
//     uistr.set_lang("de")            // "de", "de-AT", "de_DE.UTF-8" ... any tag starting with a known code
//     uistr.set_lang_tag(env_lang)    // same, returns false for an unknown language (stays as it was)
//
// ADDING A LANGUAGE: add a code to `lang_code`, a table function like `de` below and a line in `t`. The
// audit `tools/fui/uistr_audit.py` (in run.sh) checks that no `tr_` function still returns a bare literal and
// that every key used anywhere in lib/fui has a German entry. English costs one compare per call; another
// language costs a linear scan of ~120 keys, only when a text is built (not per pixel).
//
// HONEST: Arabic and the other right-to-left catalogues are NOT here yet (gap list #64 keeps the row "teilweise");
// the mechanism and German are. Plurals are the dialogs' own " item"/" items" pair, not CLDR plurals.
export {
    t, set_lang, set_lang_tag, lang, LANG_EN, LANG_DE, lang_name,
}

const LANG_EN: u32 = 0
const LANG_DE: u32 = 1

static mut LANG: u32 = 0

fn lang() -> u32 { return LANG }

fn lang_name() -> str {
    if LANG == LANG_DE { return "de" }
    return "en"
}

fn lc(b: u8) -> u8 {
    if b >= 65 as u8 && b <= 90 as u8 { return b + 32 as u8 }
    return b
}

fn same(a: str, b: str) -> bool {
    if a.n != b.n { return false }
    var i: usize = 0
    while i < a.n {
        if *((a.p as u64 + i as u64) as *mut u8) != *((b.p as u64 + i as u64) as *mut u8) { return false }
        i = i + 1
    }
    return true
}

// A language tag: the first two letters decide ("de", "DE", "de-AT", "de_DE.UTF-8"). True when known.
fn set_lang_tag(tag: str) -> bool {
    if tag.n < 2 { return false }
    let a: u8 = lc(*(tag.p as u64 as *mut u8))
    let b: u8 = lc(*((tag.p as u64 + 1) as *mut u8))
    if tag.n > 2 {
        let c: u8 = *((tag.p as u64 + 2) as *mut u8)
        if !(c == 45 as u8 || c == 95 as u8 || c == 46 as u8 || c == 64 as u8) { return false }
    }
    if a == 101 as u8 && b == 110 as u8 {
        LANG = LANG_EN
        return true
    }
    if a == 100 as u8 && b == 101 as u8 {
        LANG = LANG_DE
        return true
    }
    return false
}

fn set_lang(tag: str) { set_lang_tag(tag) }

// The text for `key` in the current language; `en` when English or untranslated.
fn t(key: str, en: str) -> str {
    if LANG == LANG_DE {
        let r: str = de(key)
        if r.n > 0 { return r }
    }
    return en
}

// "" = no entry.
