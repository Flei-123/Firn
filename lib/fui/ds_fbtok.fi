import fui.kit
import fui.lucide
import fui.render
import fui.ds_tokens

export { INFO, SUCCESS, WARNING, ERROR, tone, tint, icon, kind_name, surface, border, text, muted, hover_fill, radius, gap, line_h }

const INFO: u32 = 0
const SUCCESS: u32 = 1
const WARNING: u32 = 2
const ERROR: u32 = 3

fn role_of(kind: u32) -> usize {
    if kind == SUCCESS { return ds_tokens.C_SUCCESS }
    if kind == WARNING { return ds_tokens.C_WARNING }
    if kind == ERROR { return ds_tokens.C_ERROR }
    return ds_tokens.C_INFO
}

fn bg_role_of(kind: u32) -> usize {
    if kind == SUCCESS { return ds_tokens.C_SUCCESS_BG }
    if kind == WARNING { return ds_tokens.C_WARNING_BG }
    if kind == ERROR { return ds_tokens.C_ERROR_BG }
    return ds_tokens.C_INFO_BG
}

fn tone(c: *mut render.Ctx, kind: u32) -> u32 { return ds_tokens.paint(kit.theme_of(c), role_of(kind)) }
fn tint(c: *mut render.Ctx, kind: u32) -> u32 { return ds_tokens.paint(kit.theme_of(c), bg_role_of(kind)) }

fn icon(kind: u32) -> i64 {
    if kind == SUCCESS { return lucide.CIRCLE_CHECK }
    if kind == WARNING { return lucide.TRIANGLE_ALERT }
    if kind == ERROR { return lucide.CIRCLE_X }
    return lucide.INFO
}

fn kind_name(kind: u32) -> str {
    if kind == SUCCESS { return "Success" }
    if kind == WARNING { return "Warning" }
    if kind == ERROR { return "Error" }
    return "Information"
}

fn surface(c: *mut render.Ctx) -> u32 { return ds_tokens.paint(kit.theme_of(c), ds_tokens.C_RAISED) }
fn border(c: *mut render.Ctx) -> u32 { return ds_tokens.paint(kit.theme_of(c), ds_tokens.C_BORDER) }
fn text(c: *mut render.Ctx) -> u32 { return ds_tokens.paint(kit.theme_of(c), ds_tokens.C_TEXT) }
fn muted(c: *mut render.Ctx) -> u32 { return ds_tokens.paint(kit.theme_of(c), ds_tokens.C_TEXT_MUTED) }
fn hover_fill(c: *mut render.Ctx) -> u32 { return ds_tokens.paint(kit.theme_of(c), ds_tokens.C_BUTTON_HOVER) }
fn radius(c: *mut render.Ctx) -> f64 { return kit.ln(c, 8) }
fn gap(c: *mut render.Ctx) -> f64 { return kit.ln(c, 12) }
fn line_h(c: *mut render.Ctx) -> f64 { return kit.ln(c, 20) }
