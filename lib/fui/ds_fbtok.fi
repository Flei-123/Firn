import fui.kit
import fui.lucide
import fui.render
import fui.style

export { INFO, SUCCESS, WARNING, ERROR, tone, tint, icon, kind_name, surface, border, text, muted, hover_fill, radius, gap, line_h }

const INFO: u32 = 0
const SUCCESS: u32 = 1
const WARNING: u32 = 2
const ERROR: u32 = 3

fn tone(c: *mut render.Ctx, kind: u32) -> u32 {
    if kind == SUCCESS { return kit.tokc(c, style.TOK_SUCCESS) }
    if kind == WARNING { return kit.tokc(c, style.TOK_WARNING) }
    if kind == ERROR { return kit.tokc(c, style.TOK_ERROR) }
    return kit.accent_gfx(c, style.TOK_SURFACE_RAISED)
}

fn tint(c: *mut render.Ctx, kind: u32) -> u32 {
    return kit.with_alpha(tone(c, kind), 40 as u32)
}

fn icon(kind: u32) -> i64 {
    if kind == SUCCESS { return lucide.CIRCLE_CHECK }
    if kind == WARNING { return lucide.TRIANGLE_ALERT }
    if kind == ERROR { return lucide.CIRCLE_X }
    return lucide.INFO
}

fn kind_name(kind: u32) -> str {
    if kind == SUCCESS { return "Success" }
    if kind == WARNING { return "Warning" }
    if kind == ERROR { return "Error" }
    return "Information"
}

fn surface(c: *mut render.Ctx) -> u32 { return kit.tokc(c, style.TOK_SURFACE_RAISED) }
fn border(c: *mut render.Ctx) -> u32 { return kit.tokc(c, style.TOK_BORDER) }
fn text(c: *mut render.Ctx) -> u32 { return kit.tokc(c, style.TOK_TEXT) }
fn muted(c: *mut render.Ctx) -> u32 { return kit.tokc(c, style.TOK_TEXT_MUTED) }
fn hover_fill(c: *mut render.Ctx) -> u32 { return kit.tokc(c, style.TOK_BUTTON_HOVER) }
fn radius(c: *mut render.Ctx) -> f64 { return kit.ln(c, 8) }
fn gap(c: *mut render.Ctx) -> f64 { return kit.ln(c, 12) }
fn line_h(c: *mut render.Ctx) -> f64 { return kit.ln(c, 20) }
