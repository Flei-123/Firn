import fui.app
import fui.render
import fui.scene
import fui.widget
import fui.termpaint
import fui.terminteract
import fui.termwstate
import plat.fuiwirt
import term.term
import term.termback

export { tw_attach }

const TICK_WAIT_MS: i64 = 100
const NO_WAIT: i64 = 0 - 1

fn draw(ud: u64, c: *mut render.Ctx, e: *mut widget.Widget) {
    let tw: *mut termwstate.TermWidget = ud as *mut termwstate.TermWidget
    let f: *mut termpaint.Frame = &(*tw).fr
    (*f).ox = widget.w_x(e)
    (*f).oy = widget.w_y(e)
    (*f).w = widget.w_w(e)
    (*f).h = widget.w_h(e)
    if !(*tw).measured {
        termpaint.measure_cell(c, f)
        (*tw).measured = true
    }
    termwstate.tw_fit(tw, (*f).w, (*f).h)
    termwstate.tw_pump(tw)
    (*f).cols = term.term_cols((*tw).term)
    (*f).rows = term.term_rows((*tw).term)
    (*f).focused = (*tw).focus
    termpaint.paint_term(c, f, (*tw).term, &(*tw).sel)
}

fn pump_fd(ud: u64) -> i32 {
    let tw: *mut termwstate.TermWidget = ud as *mut termwstate.TermWidget
    return termback.back_fd(&(*tw).back)
}

fn pump_ms(ud: u64, wanted: i64) -> i64 { return wanted }

fn pump_step(ud: u64) -> bool {
    return termwstate.tw_pump(ud as *mut termwstate.TermWidget)
}

fn tick(ud: u64, now: i64) -> bool {
    return terminteract.tw_poll_paste(ud as *mut termwstate.TermWidget)
}

fn wait(ud: u64, now: i64) -> i64 {
    let tw: *mut termwstate.TermWidget = ud as *mut termwstate.TermWidget
    if (*tw).paste_wait { return TICK_WAIT_MS }
    return NO_WAIT
}

fn tw_attach(a: *mut app.App, tw: *mut termwstate.TermWidget, w_pt: usize, h_pt: usize) -> usize {
    (*tw).node = app.custom(a, widget.KIND_TILE, w_pt, h_pt)
    if (*tw).node == app.NONE { return app.NONE }
    let ud: u64 = tw as u64
    scene.node_set_draw(app.app_scene(a), (*tw).node, ud, draw)
    app.use_mono_face(a)
    app.set_motion(a, ud, terminteract.tw_pointer)
    app.set_keys(a, ud, terminteract.tw_key, terminteract.tw_char)
    app.set_wheel(a, ud, terminteract.tw_wheel)
    app.set_extra_wake(a, ud, tick, wait)
    if termback.back_fd(&(*tw).back) >= 0 { app.set_pump(a, ud, pump_fd, pump_ms, pump_step) }
    return (*tw).node
}
