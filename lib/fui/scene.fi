// SPDX-License-Identifier: MPL-2.0
// lib/fui/scene.fi -- THE DESCRIBED SURFACE.
//
// ===================================================== WHY IT EXISTS
//
// Until here a surface in fUi was PAINTED: call by call,
// each with its own coordinates. That works as long as
// somebody has the coordinates in his head -- and it breaks at the moment
// at which a font size changes, a text becomes longer or
// the window has a different width. Exactly that is why on the web you
// describe a page instead of drawing it.
//
// This module is the description: a TREE of nodes. Every node
// has a kind, an id, classes, children and a style. The tree
// is built ONCE and then processed in clearly separated passes:
//
//     1. STYLE     scene_style   -- which rule applies to which
//                                   node (lib/fui/sheet.fi), and what
//                                   it inherits from its parent.
//     2. MEASURE   scene_measure -- every node reports its
//                                   preferred size. Leaves via
//                                   render.pref_of, boxes via
//                                   flex.flex_measure_main/_cross.
//     3. ARRANGE   scene_layout  -- flex.flex_layout distributes the space
//                                   and writes the rectangles.
//     4. DRAW      scene_draw    -- and only now is it painted.
//
// THAT THESE ARE FOUR PASSES IS THE WHOLE POINT. A node that
// still changes its size while drawing makes the picture depend on the
// drawing order -- then the second element stands a line lower, depending on
// whether the first has already been painted. `scene_draw` watches over it: it
// remembers the measured sizes and reports via
// `scene_size_drift` if one has changed during drawing.
// tools/fui/scene_main.fi re-calculates this number.
//
// ================================================ WHAT IS NOT HERE
//
// This module CALCULATES ALMOST NOTHING ITSELF, and that is deliberate:
//
//     flexbox        lib/fui/flex.fi
//     box/grid       lib/fui/layout.fi
//     measure/paint  lib/fui/render.fi, wave2.fi, wave3.fi
//     time/easing    lib/fui/anim.fi
//     matrices       lib/fui/transform.fi (on lib/svg/matrix.fi)
//     clipping       lib/fui/viewport.fi (on lib/paint/canvas.fi)
//     rules/rank     lib/fui/sheet.fi
//
// What stands here is the TREE and the ORDER. As soon as in this
// file a second flexbox or a second time calculation appears,
// it is wrong.
//
// ======================================================= THE STRUCTURE
//
//     var sc: scene.Scene = scene.scene_new()
//     let wurzel: usize = scene.scene_add(&sc, scene.SCENE_NONE,
//         scene.N_BOX)
//     let kopf: usize = scene.scene_add(&sc, wurzel, scene.N_TEXT)
//     scene.node_set_text(&sc, kopf, (&t[0]) as u64, 5)
//     scene.node_add_class(&sc, kopf, sheet.sheet_name((&k[0]) as u64, 4))
//     scene.scene_style(&sc, &blatt)
//     scene.scene_measure(&sc, &c)
//     scene.scene_layout(&sc, &c, 0.0, 0.0, 800.0, 600.0)
//     scene.scene_draw(&sc, &c)
//
// Nodes are NUMBERS (slots in a fixed array), not pointers: the
// tree stays copyable, needs no allocator and no collector --
// the same decision as with anim.Animator and sheet.Sheet.
export {
    Scene, Node,
    scene_new, scene_add, scene_box, scene_widget, scene_count,
    scene_node, scene_reset,
    scene_root, scene_parent, scene_first_child, scene_next_sibling,
    scene_child_count, scene_child_at,
    node_nat_w, node_nat_h, node_set_id, node_id, node_add_class, node_remove_class, node_class_count, node_has_class,
    node_set_state, node_state, node_kind,
    node_set_text, node_set_widget_kind, node_widget,
    node_set_image, node_set_svg, node_set_art_align,
    node_set_flex, node_set_gap, node_set_padding, node_set_space,
    node_set_wrap, node_set_flexitem, node_set_hidden, node_hidden,
    node_set_grid, node_is_grid, node_grid_col, node_grid_row,
    node_grid_gap, node_grid_padding, node_grid_flow, node_grid_content,
    node_grid_items, node_grid_auto, node_grid_rtl, node_set_cell,
    node_set_cell_align, node_grid_spec, grid_pool_slot,
    node_cell_get, node_grid_count, node_grid_gap_get,
    scene_draw_subtree,
    node_set_opacity, node_set_offset, node_set_live, node_live,
    node_set_text_wrap, node_text_lines, node_set_text_reserve, scene_set_view, scene_view,
    scene_draw_still, scene_draw_live, scene_reflows,
    node_set_ink, scene_set_cull, scene_culled, scene_rot_bounds,
    Memo, memo_new, memo_clear, memo_free, scene_free, nd, memo_hits, memo_misses, scene_attach_memo,
    memo_style_hits, memo_style_misses, memo_box_hits, memo_box_misses,
    memo_layout_hits, memo_layout_misses,
    node_set_grow, node_set_base, node_set_bounds, node_set_align_self,
    node_set_strict, node_set_margin, node_set_minmax, node_set_fill, node_set_aspect,
    node_set_size, node_set_viewport, node_viewport, node_set_merge,
    node_set_draw, node_style, node_decl, scene_ink_rect, scene_geom_hash, scene_layout_stable,
    node_pref_w, node_pref_h, node_x, node_y, node_w, node_h,
    scene_style, scene_measure, scene_layout, scene_draw, scene_run,
    scene_phase, scene_size_drift, scene_desc,
    scene_kid_overflow, scene_depth_overflow, scene_node_overflow,
    scene_overflow_reason,
    OF_NONE, OF_NODES, OF_KIDS, OF_DEPTH, OF_LIMITS,
    scene_xform_skipped,
    scene_limits_ok, scene_work_max, scene_limit_break,
    scene_hit, scene_find_id,
    scene_bind_panel, scene_node_of, scene_viewport_at,
    N_BOX, N_TEXT, N_IMAGE, N_SVG, N_WIDGET, N_VIEWPORT,
    SCENE_NONE, SCENE_MAX, KIDS_MAX,
    PHASE_BUILD, PHASE_STYLE, PHASE_MEASURE, PHASE_LAYOUT, PHASE_DRAW,
}

import fui.style
import fui.widget
import fui.control
import fui.layout
import fui.flex
import fui.grid
import fui.render
import fui.transform
import fui.wave3
import fui.uiimage
import fui.uisvg
import fui.sheet
import fui.viewport
import fui.layer
import fui.merge
import fui.painter
import fui.theme
import paint.canvas
import std.rt

// ======================================================= THE KINDS
//
// A node is one of six things. It needs no more: a
// button is an N_WIDGET with widget.KIND_BUTTON, a card an
// N_WIDGET with widget.KIND_CARD -- the kinds of the widgets stand in
// lib/fui/widget.fi and are not enumerated here a second time.
const N_BOX: u32 = 1
const N_TEXT: u32 = 2
const N_IMAGE: u32 = 3
const N_SVG: u32 = 4
const N_WIDGET: u32 = 5
const N_VIEWPORT: u32 = 6

// HOW MANY NODES A TREE CARRIES, AND WHY IT IS 128.
//
// The question was whether 256 or 512 should stand here, so that
// a list with two hundred rows fits in. The answer is no,
// for two MEASURED reasons:
//
//   1. A BOX DISTRIBUTES AT MOST KIDS_MAX = 64 CHILDREN (that is
//      flex.FLEX_MAX, see below). A list with two hundred rows
//      as two hundred siblings does not exist in this tree at all
//      -- it would already be cut off at the children limit,
//      and raising SCENE_MAX would change nothing about that. A
//      long list is built differently in fUi: the pane box paints
//      the VISIBLE rows (viewport_visible says which those are),
//      and at 44 points of row height on a 1080 screen those are
//      at most twenty-five.
//   2. A TREE ALREADY COSTS 95304 BYTES on the stack (measured
//      on 22.09.2026, 744 bytes per node: a node carries a
//      complete widget.Widget, a sheet.Decl and a
//      flex.FlexBox). At 512 nodes that would be 380 KB for one
//      window -- on a kernel stack that is no longer a number,
//      but a crash.
//
// 128 nodes are a complete application surface: title, toolbar,
// side bar, content area and a dialog together lie in
// tools/fui/gallery9_main.fi at around seventy. Whoever needs more
// builds two trees (one per window) -- and whoever hits the limit anyway
// learns of it: `scene_add` returns SCENE_NONE,
// `scene_node_overflow` counts, and `scene_overflow_reason`
// names the reason in one number.
const SCENE_MAX: usize = 4096
// How many children ONE box distributes. It is exactly flex.FLEX_MAX --
// `flex_layout` accepts no more in one call, and less would be
// a second, quieter limit. A list with forty rows in
// a pane box is the normal case, not the exception.
const KIDS_MAX: usize = 64
const SCENE_NONE: usize = 4294967295

// THE LENGTH OF THE WORK ARRAYS IN `measure_node` AND `layout_node`.
//
// There stand four arrays -- the FlexItems, the rectangles and the
// two work arrays of `flex_layout` --, and their length stands there
// as a DIGIT. That is no negligence, but the language:
// Firn accepts no name for an array length, a
// `[flex.FlexItem; KIDS_MAX]` is rejected with "expected an integer array
// length, found 'KIDS_MAX'". So the digit is named here
// ONCE, and the check `scene_limits_ok` holds against each other the three
// numbers that must fit together:
//
//     KIDS_MAX <= WORK_MAX        otherwise `fill_items` would write behind
//                                 the last array element,
//     KIDS_MAX <= flex.FLEX_MAX   otherwise `flex_layout` does not accept the
//                                 children at all.
//
// `scene_measure` and `scene_layout` ask them BEFORE the first write
// and REPORT instead of writing (`scene_limit_break`). Whoever changes one of the
// three numbers and forgets the others therefore gets a
// number and no overwritten stack -- tools/fui/scene_main.fi
// re-calculates them.
const WORK_MAX: usize = 64

// WHY A TREE IS NOT COMPLETE, as numbers. See
// `scene_overflow_reason`.
const OF_NONE: u32 = 0
const OF_NODES: u32 = 1
const OF_KIDS: u32 = 2
const OF_DEPTH: u32 = 3
const OF_LIMITS: u32 = 4

// The passes, as numbers, so that a check can name them.
const PHASE_BUILD: u32 = 0
const PHASE_STYLE: u32 = 1
const PHASE_MEASURE: u32 = 2
const PHASE_LAYOUT: u32 = 3
const PHASE_DRAW: u32 = 4

struct Node {
    kind: u32,
    id: u32,
    cls: [u32; 8],
    ncls: usize,
    // The tree. Children hang in a singly linked list, and
    // `last` keeps appending at O(1) -- the order of the children
    // is the order in which they were created, as on the web.
    parent: usize,
    first: usize,
    last: usize,
    next: usize,
    nkids: usize,
    // THE CARRIER. Text, image, state, value and style of a node are
    // exactly what a widget.Widget already holds -- and render.pref_of
    // and wave3.draw_any accept exactly that. A node style of its own
    // would be the second place for the style.
    e: widget.Widget,
    d: sheet.Decl,
    // The box, if this node distributes children.
    fb: flex.FlexBox,
    // 1 = this box is a GRID (node_set_grid): its spec lives in the scene's
    // grid pool at the node's own slot, and its children sit in cells.
    grid: u32,
    // The cell of THIS node in its parent grid, packed (node_set_cell):
    // bits 0-15 column + 1 (0 = automatic), 16-31 row + 1, 32-39 column
    // span, 40-47 row span (0 = 1), 48-55 justify-self, 56-63 align-self
    // (flex.AL_*, 0 = what the grid says). All zero = the default cell.
    cell: u64,
    // What this node says about itself to its parent.
    grow: i64,
    shrink: i64,
    basis: i64, // < 0 = auto (die gemessene Groesse)
    // THE LIMITS ON THE MAIN AXIS, in design points. 0 means
    // "none" -- exactly as with flex.item_set_bounds, to which they go on
    // unchanged. Calculation with them happens there and only
    // there; this module clamps nothing itself.
    min_main: i64,
    max_main: i64,
    align_self: u32,
    fix_w: f64, // <= 0 = automatisch
    fix_h: f64,
    // The result of the passes.
    pw: f64,
    ph: f64,
    // WHAT CAME OUT WHEN MEASURING, recorded. `mw`/`mh` are the
    // sizes with which pass 2 finished; `scene_draw`
    // compares them afterwards against what stands there when painting. Without
    // this deduction the drift guard would be a claim: it can only
    // report what it noted beforehand.
    mw: f64,
    mh: f64,
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    // The viewport, if kind == N_VIEWPORT. It belongs to the
    // CALLER -- like an image at the widget, and for the same reason: it
    // outlives the tree, because the scroll position must not
    // be forgotten by a rebuild.
    vp: u64,
    // THE PAINTER OF ITS OWN. A node may, in addition to its kind, paint something
    // that this library does not know -- a diagram, a
    // map, a measurement curve. It gets the drawing context and ITS
    // widget (so its already arranged surface) and paints into it.
    // What it must NOT do is change its size; exactly that is caught by
    // the guard in `scene_draw`, and tools/fui/scene_main.fi proves it
    // with a deliberately wrong painter.
    dr: fn(u64, *mut render.Ctx, *mut widget.Widget),
    du: u64,
    has_dr: u32,
    // NOT PAINTED, NOT HIT (node_set_hidden) -- CSS `visibility: hidden`:
    // the node keeps its room in the layout, only its picture is gone.
    hidden: u32,
    // MERGE GROUP (node_set_merge): the melt distance in design points of the
    // group this node's children form (0 = none), and whether THIS node's
    // surface is painted by its parent's group (set each frame by the parent)
    merge_k: usize,
    no_fill: u32,
    // ---- 30.09.2026: the page look
    // OPACITY OF THE WHOLE SUBTREE (0..255, node_set_opacity) and its
    // OFFSET in design points (node_set_offset) -- CSS `opacity` and
    // `transform: translate`, the two halves of every fade-in.
    alpha: u32,
    off_x: f64,
    off_y: f64,
    // LIVE (node_set_live): changes every frame; scene_draw_still leaves it
    // out, scene_draw_live paints only it.
    live: u32,
    // A PARAGRAPH (node_set_text_wrap): the text breaks into lines at the
    // width the layout gives it, at most `wrap` lines; its height follows.
    // `avail` is that width (pixels) from the last layout, < 0 = unknown.
    wrap: usize,
    avail: f64,
    lines: usize,
    // ROOM FOR A TEXT NOT SHOWN YET (node_set_text_reserve): measured as
    // if it showed `res_p`/`res_n`, painted with its own text
    res_p: u64,
    res_n: usize,
    // ---- CULLING (docs/APP-TREE.md T10, 4.4)
    // `ink`: how far a custom painter (node_set_draw) paints past the
    // node's rectangle, design points; < 0 = it did not say, and such a
    // node is never skipped. bx0..by1: the ink bounds of the whole
    // subtree in pixels (cull_bounds), bxf = 1: somewhere in the subtree
    // is a node whose ink cannot be bounded (a transform, an offset, an
    // unannounced painter) -- then this node is always painted.
    ink: f64,
    bx0: f64,
    by0: f64,
    bx1: f64,
    by1: f64,
    bxf: u32,
    // ---- 18.10.2026: CSS-style layout extras (lib/fui/lay.fi). All zero = off,
    // and a tree that never sets them lays out exactly as before.
    // strict: this BOX lays its children out the CSS way (a child with an
    // explicit cross size is not stretched; the automatic minimum of a fixed
    // child is min(content, fixed)).
    strict: u32,
    fill: u32, // bit 0 = fill_w (explicit width ignored on stretch), bit 1 = fill_h
    mg_l: i64, // margin, design points
    mg_t: i64,
    mg_r: i64,
    mg_b: i64,
    mn_w: i64, // min/max width/height, design points, 0 = none
    mx_w: i64,
    mn_h: i64,
    mx_h: i64,
    asp_w: i64, // aspect ratio (height = width * asp_h / asp_w), 0 = none
    asp_h: i64,
    nat_w: f64, // the measured size BEFORE any fixed size
    nat_h: f64,
}

// The painter that a node has as long as nobody gives it one. It
// paints nothing -- a field of type `fn` needs a value, and a
// null pointer would be one that you would have to check before every call.
fn draw_none(ud: u64, c: *mut render.Ctx, e: *mut widget.Widget) {
}

struct Scene {
    nodes: u64,
    // byte size of one Node (measured at the first allocation), the
    // number of slots that were blanked so far, and the slot limit
    nsz: u64,
    hi: usize,
    n: usize,
    root: usize,
    phase: u32,
    drift: usize,
    // THE TWO LIMITS THAT WOULD OTHERWISE BE SILENT. A box
    // distributes at most KIDS_MAX children, and a chain is
    // at most sheet.CHAIN_MAX levels deep. Both are fixed arrays
    // and no opinion -- but a tree that silently swallows the 65th child
    // or paints the node of the 17th level unstyled is
    // exactly the kind of error that you see only in the picture and then
    // have to search for. So it is COUNTED, like `drift`, and
    // tools/fui/scene_main.fi re-calculates the number.
    kidof: usize,
    depthof: usize,
    // AND THE THIRD: the tree itself is full. `scene_add` then honestly
    // returns SCENE_NONE -- but whoever creates two hundred rows in a loop
    // does not look at the return value.
    // This number says afterwards HOW MANY nodes were missing, and a
    // caller can then report, instead of showing half a picture.
    nodeof: usize,
    // HOW OFTEN A TRANSFORMATION WAS SKIPPED. Not every kind can
    // be painted under a matrix (the reason stands at `draw_self`).
    // Such a node is painted STRAIGHT instead of not at all -- and the
    // number stands here, so that "my picture does not rotate" has an
    // answer that you can read off.
    xfof: usize,
    // AND THE LAST, WHICH MUST NOT OCCUR AT ALL: the three
    // limits from the head of this file (KIDS_MAX, WORK_MAX,
    // flex.FLEX_MAX) no longer fit together. Then NOTHING is
    // arranged and nothing measured, because the first write access
    // would lie behind the array -- it is counted instead.
    limof: usize,
    // the view's width in design points, for fluid font sizes
    // (style.SF_FLUID); 0 = unknown
    view_w: usize,
    // what scene_draw paints: 0 everything, 1 all but the live nodes
    dmode: u32,
    // how many extra measure + layout rounds the paragraphs cost
    reflows: usize,
    // culling: 1 = skip subtrees whose ink misses the clip (default);
    // `culled` counts the skipped subtrees of the last paint
    cull: u32,
    culled: usize,
    // the measure memo (scene_attach_memo), *mut Memo; 0 = none
    memo: u64,
    // THE GRID POOL: one GridSpec per node slot, mapped on the first
    // node_set_grid (zero pages, so only grid nodes cost memory). `gsz` is
    // the byte size of one spec (measured). scene_free gives it back.
    gpool: u64,
    gsz: u64,
}

fn node_blank() -> Node {
    return Node {
        kind: N_BOX, id: 0 as u32, cls: [0 as u32; 8], ncls: 0,
        parent: SCENE_NONE, first: SCENE_NONE, last: SCENE_NONE,
        next: SCENE_NONE, nkids: 0,
        e: widget.widget_new(widget.KIND_NONE), d: sheet.decl_new(),
        fb: flex.flexbox_new(flex.FLEX_COLUMN), grid: 0 as u32, cell: 0,
        grow: 0, shrink: 1000, basis: 0 - 1,
        min_main: 0, max_main: 0, align_self: flex.AL_AUTO,
        fix_w: 0.0, fix_h: 0.0,
        pw: 0.0, ph: 0.0, mw: 0.0, mh: 0.0,
        x: 0.0, y: 0.0, w: 0.0, h: 0.0, vp: 0,
        dr: draw_none, du: 0, has_dr: 0 as u32, hidden: 0 as u32, merge_k: 0, no_fill: 0 as u32,
        alpha: 255 as u32, off_x: 0.0, off_y: 0.0, live: 0 as u32,
        wrap: 0, avail: 0.0 - 1.0, lines: 1, res_p: 0, res_n: 0,
        ink: 0.0 - 1.0, bx0: 0.0, by0: 0.0, bx1: 0.0, by1: 0.0,
        bxf: 0 as u32,
        strict: 0 as u32, fill: 0 as u32, mg_l: 0, mg_t: 0, mg_r: 0, mg_b: 0,
        mn_w: 0, mx_w: 0, mn_h: 0, mx_h: 0, asp_w: 0, asp_h: 0,
        nat_w: 0.0, nat_h: 0.0,
    }
}

fn scene_new() -> Scene {
    return Scene { nodes: 0, nsz: 0, hi: 0, n: 0, root: SCENE_NONE,
        phase: PHASE_BUILD, drift: 0, kidof: 0, depthof: 0, nodeof: 0,
        xfof: 0, limof: 0, view_w: 0, dmode: 0 as u32, reflows: 0,
        cull: 1 as u32, culled: 0, memo: 0, gpool: 0, gsz: 0 }
}

fn scene_reset(sc: *mut Scene) {
    (*sc).n = 0
    (*sc).root = SCENE_NONE
    (*sc).phase = PHASE_BUILD
    (*sc).drift = 0
    (*sc).kidof = 0
    (*sc).depthof = 0
    (*sc).nodeof = 0
    (*sc).xfof = 0
    (*sc).limof = 0
    (*sc).dmode = 0 as u32
}

fn scene_count(sc: *mut Scene) -> usize { return (*sc).n }
fn scene_root(sc: *mut Scene) -> usize { return (*sc).root }
fn scene_phase(sc: *mut Scene) -> u32 { return (*sc).phase }
fn scene_size_drift(sc: *mut Scene) -> usize { return (*sc).drift }

// HOW MANY BOXES HAVE MORE CHILDREN THAN A BOX DISTRIBUTES. The
// number applies to the LAST pass that distributed children
// (`scene_measure` and `scene_layout` each reset it to zero) --
// just as `scene_size_drift` applies to the last drawing. If it is
// not zero, children are missing in the picture, and the caller knows it instead of
// searching for it.
fn scene_kid_overflow(sc: *mut Scene) -> usize { return (*sc).kidof }

// HOW OFTEN THE STYLE BROKE OFF AT THE DEPTH. Beyond
// sheet.CHAIN_MAX levels there is no chain any more in which a rule
// could select; the subtree therefore stays UNSTYLED. This number
// says so -- before, nobody did.
fn scene_depth_overflow(sc: *mut Scene) -> usize { return (*sc).depthof }

// HOW MANY NODES THE TREE COULD NO LONGER TAKE. The number applies
// to the whole build since the last `scene_reset` -- unlike
// `kidof`, which belongs to the last pass, because nodes are created in
// pass 0. Zero means: the tree stands there complete.
fn scene_node_overflow(sc: *mut Scene) -> usize { return (*sc).nodeof }

// HOW OFTEN A TRANSFORMATION WAS SKIPPED. Applies to the last
// drawing, like `scene_size_drift`.
fn scene_xform_skipped(sc: *mut Scene) -> usize { return (*sc).xfof }

// DO THE THREE LIMITS FIT TOGETHER? The reasoning stands at
// WORK_MAX: Firn accepts no name for an array length, so there
// is the length of the work arrays twice -- as a digit in the array and as a
// name here. This function is the bracket around both places, and it
// is CALLED before anything is written.
fn scene_limits_ok() -> bool {
    return KIDS_MAX <= WORK_MAX && KIDS_MAX <= flex.FLEX_MAX
}

// The length of the work arrays, so that a check can name it
// without writing the digit a third time.
fn scene_work_max() -> usize { return WORK_MAX }

// HOW OFTEN A PASS DID NOT RUN BECAUSE OF THE LIMITS. Zero
// means: `scene_measure` and `scene_layout` really calculated.
// If it is not zero, there is no picture -- and that is the honest
// answer to the fact that the alternative would be a write access behind the
// array.
fn scene_limit_break(sc: *mut Scene) -> usize { return (*sc).limof }

// ======================================================================
// AN ANSWER TO "WHY IS SOMETHING MISSING THERE" -- IN ONE NUMBER
// ======================================================================
//
// The five counters above are individually right and together unwieldy:
// whoever wants to know after the build whether his picture is complete does not
// want to ask five questions, but one. `scene_overflow_reason`
// is this one question, and it answers with the MOST SERIOUS reason
// that applies -- in this order:
//
//     OF_LIMITS   The limits no longer fit together. Then
//                 nothing was arranged; everything else is a consequence.
//     OF_NODES    The tree was full. Nodes are missing entirely.
//     OF_KIDS     A box had more children than it distributes.
//     OF_DEPTH    The style broke off at the depth -- the picture
//                 stands, but a subtree is unstyled.
//
// A caller thereby writes ONE line ("the tree is not
// complete, reason N") instead of none -- and exactly that is what
// tools/fui/gallery9_main.fi and demos/fuidemo/main.fi have done since this
// round. The number stays retrievable alongside: the reason says WHAT, the
// counters say HOW MUCH.
fn scene_overflow_reason(sc: *mut Scene) -> u32 {
    if (*sc).limof != 0 {
        return OF_LIMITS
    }
    if (*sc).nodeof != 0 {
        return OF_NODES
    }
    if (*sc).kidof != 0 {
        return OF_KIDS
    }
    if (*sc).depthof != 0 {
        return OF_DEPTH
    }
    return OF_NONE
}

fn scene_node(sc: *mut Scene, i: usize) -> *mut Node {
    return &(*nd(sc, i))
}

// THE NODE ARRAY LIVES ON THE HEAP (r102/r222). One block of SCENE_MAX
// nodes is mapped on first use; the kernel hands out zero pages, so only
// the part a tree really touches costs memory. The block never moves
// (a pointer from `node_widget` stays valid while the tree grows), and a
// slot is blanked (`node_blank`) the first time it is reached -- `hi` is
// how many slots were. `scene_new` allocates nothing, so a Scene that is
// copied by value (a probe, `[level; 3]`) never shares or leaks a block.
//
// `nd_grow` maps the block and blanks the slots up to `k`; an index past
// SCENE_MAX is clamped to the last slot instead of reading behind the block.
fn scene_ensure(sc: *mut Scene) -> bool {
    if (*sc).nodes != 0 {
        return true
    }
    var probe: [Node; 2] = [node_blank(); 2]
    let sz: u64 = (&probe[1]) as u64 - (&probe[0]) as u64
    let p: u64 = rt.heap_alloc(SCENE_MAX * sz as usize)
    if p == 0 {
        return false
    }
    (*sc).nsz = sz
    (*sc).nodes = p
    (*sc).hi = 0
    return true
}

fn nd_grow(sc: *mut Scene, k: usize) -> usize {
    var j: usize = k
    if j >= SCENE_MAX {
        j = SCENE_MAX - 1
    }
    scene_ensure(sc)
    while (*sc).hi <= j {
        *(((*sc).nodes + ((*sc).hi as u64) * (*sc).nsz) as *mut Node) = node_blank()
        (*sc).hi = (*sc).hi + 1
    }
    return j
}

// The pointer to node `i`. (The `sc +% (nodes -% sc + ...)` form equals nodes + k * nsz; it
// only gives the escape analysis the fact that the result belongs to what `sc` points at: a text pointer stored
// into a node then lands in the caller's Scene, exactly as before the nodes
// moved to the heap, and a local text is still accepted.)
fn nd(sc: *mut Scene, i: usize) -> *mut Node {
    var k: usize = i
    if k >= (*sc).hi {
        k = nd_grow(sc, k)
    }
    return ((sc as u64) +% ((*sc).nodes -% (sc as u64) +% (k as u64) * (*sc).nsz)) as *mut Node
}

// Give the node block back. The Scene is empty (and usable) afterwards.
fn scene_free(sc: *mut Scene) {
    if (*sc).nodes != 0 {
        rt.heap_free((*sc).nodes, SCENE_MAX * (*sc).nsz as usize)
    }
    (*sc).nodes = 0
    (*sc).hi = 0
    if (*sc).gpool != 0 {
        rt.heap_free((*sc).gpool, SCENE_MAX * (*sc).gsz as usize)
    }
    (*sc).gpool = 0
    scene_reset(sc)
}

// CREATE A NODE. `parent` is SCENE_NONE for the root.
// Returned is the slot; if the tree is full, SCENE_NONE comes back
// -- THE SAME number with which this module says "no node" everywhere.
// Formerly SCENE_MAX stood here, so a valid-looking slot:
// whoever called `node_set_text` with it wrote behind the last array element.
// Now the answer is honest, and every setter checks its slot
// (`i >= (*sc).n`) and otherwise does nothing -- a full tree loses
// nodes, but it damages nothing.
fn scene_add(sc: *mut Scene, parent: usize, kind: u32) -> usize {
    if (*sc).n >= SCENE_MAX || !scene_ensure(sc) {
        // THE FEEDBACK CHANNEL TO THE LIMIT. SCENE_NONE is seen only by whoever
        // looks; in a loop over two hundred rows nobody
        // sees it. So every rejected node is COUNTED, like
        // `kidof` and `drift`, and `scene_node_overflow` hands out
        // the number.
        (*sc).nodeof = (*sc).nodeof + 1
        return SCENE_NONE
    }
    let i: usize = (*sc).n
    // A PARAGRAPH REMEMBERS ITS WIDTH ACROSS scene_reset. A program that
    // describes its tree anew every frame builds the same node in the same
    // slot; the width the last layout gave it is the best first guess, so
    // the frame needs no extra measure + layout round (scene_reflows = 0).
    // Only a hint: para_widths checks it after the layout like any width.
    let hint: f64 = (*nd(sc, i)).avail
    *nd(sc, i) = node_blank()
    (*nd(sc, i)).avail = hint
    (*nd(sc, i)).kind = kind
    (*nd(sc, i)).parent = parent
    // A kind gets its carrier: a text is a label,
    // a box is a frameless something, a widget says its kind
    // itself (node_set_widget_kind).
    if kind == N_TEXT {
        widget.w_set_kind(&(*nd(sc, i)).e, widget.KIND_LABEL)
    } else {
        widget.w_set_kind(&(*nd(sc, i)).e, widget.KIND_NONE)
    }
    (*sc).n = i + 1
    if parent == SCENE_NONE {
        if (*sc).root == SCENE_NONE {
            (*sc).root = i
        }
        return i
    }
    if parent >= (*sc).n {
        return i
    }
    let p: *mut Node = &(*nd(sc, parent))
    if (*p).first == SCENE_NONE {
        (*p).first = i
    } else {
        (*nd(sc, (*p).last)).next = i
    }
    (*p).last = i
    (*p).nkids = (*p).nkids + 1
    return i
}

// CREATE A BOX -- node and distribution in ONE sentence. An
// N_BOX without a flexbox practically never exists in a described surface:
// a box IS what distributes its children. That is why
// the direction stands here right along with it -- and the class by which
// the style sheet later finds it likewise. If the tree hits its limit,
// this function passes SCENE_NONE on and touches nothing.
fn scene_box(sc: *mut Scene, parent: usize, cls: u32, dir: u32,
    justify: u32, align_items: u32) -> usize {
    let i: usize = scene_add(sc, parent, N_BOX)
    if i == SCENE_NONE {
        return i
    }
    // 0 means "no class". A class name arises in
    // sheet.sheet_name from a string, and the function returns
    // expressly 1 for a hash of 0 -- so zero
    // is free and needs no name of its own.
    if cls != 0 as u32 {
        node_add_class(sc, i, cls)
    }
    node_set_flex(sc, i, dir, justify, align_items)
    return i
}

// THE SAME FOR A WIDGET: kind and label belong together.
// An N_WIDGET without `node_set_widget_kind` would be a button without a kind,
// and a button without text is usable in no surface of this house.
// The pointer to the text stays with the caller: a node only
// holds it, it does not copy it (node_set_text).
fn scene_widget(sc: *mut Scene, parent: usize, k: u32, p: u64,
    n: usize) -> usize {
    let i: usize = scene_add(sc, parent, N_WIDGET)
    if i == SCENE_NONE {
        return i
    }
    node_set_widget_kind(sc, i, k)
    node_set_text(sc, i, p, n)
    return i
}

fn scene_parent(sc: *mut Scene, i: usize) -> usize {
    return (*nd(sc, i)).parent
}

fn scene_first_child(sc: *mut Scene, i: usize) -> usize {
    return (*nd(sc, i)).first
}

fn scene_next_sibling(sc: *mut Scene, i: usize) -> usize {
    return (*nd(sc, i)).next
}

fn scene_child_count(sc: *mut Scene, i: usize) -> usize {
    return (*nd(sc, i)).nkids
}

fn scene_child_at(sc: *mut Scene, i: usize, k: usize) -> usize {
    var c: usize = (*nd(sc, i)).first
    var j: usize = 0
    while c != SCENE_NONE && j < k {
        c = (*nd(sc, c)).next
        j = j + 1
    }
    return c
}

// ================================================ WHAT A NODE IS
fn node_kind(sc: *mut Scene, i: usize) -> u32 { return (*nd(sc, i)).kind }

fn node_set_id(sc: *mut Scene, i: usize, id: u32) {
    if i >= (*sc).n {
        return
    }
    (*nd(sc, i)).id = id
    widget.w_set_id(&(*nd(sc, i)).e, id)
}

fn node_id(sc: *mut Scene, i: usize) -> u32 { return (*nd(sc, i)).id }

fn node_add_class(sc: *mut Scene, i: usize, c: u32) -> bool {
    if i >= (*sc).n {
        return false
    }
    let nd: *mut Node = &(*nd(sc, i))
    if (*nd).ncls >= sheet.DESC_CLASS_MAX {
        return false
    }
    (*nd).cls[(*nd).ncls] = c
    (*nd).ncls = (*nd).ncls + 1
    return true
}

// Take a class off a node again (a row that is no longer chosen). False
// when the node did not have it.
fn node_remove_class(sc: *mut Scene, i: usize, c: u32) -> bool {
    if i >= (*sc).n {
        return false
    }
    let nd: *mut Node = &(*nd(sc, i))
    var k: usize = 0
    while k < (*nd).ncls {
        if (*nd).cls[k] == c {
            var j: usize = k
            while j + 1 < (*nd).ncls {
                (*nd).cls[j] = (*nd).cls[j + 1]
                j = j + 1
            }
            (*nd).ncls = (*nd).ncls - 1
            return true
        }
        k = k + 1
    }
    return false
}

fn node_class_count(sc: *mut Scene, i: usize) -> usize {
    return (*nd(sc, i)).ncls
}

fn node_has_class(sc: *mut Scene, i: usize, c: u32) -> bool {
    let nd: *mut Node = &(*nd(sc, i))
    var k: usize = 0
    while k < (*nd).ncls {
        if (*nd).cls[k] == c {
            return true
        }
        k = k + 1
    }
    return false
}

// The state stands ON THE WIDGET -- where render.draw_base and
// control.fi already read it. `node_state` asks the same place; a
// second state field on the node would be the start of hover
// meaning two different things.
fn node_set_state(sc: *mut Scene, i: usize, st: u32) {
    if i >= (*sc).n {
        return
    }
    let e: *mut widget.Widget = &(*nd(sc, i)).e
    widget.w_set_hover(e, st == style.STATE_HOVER)
    widget.w_set_active(e, st == style.STATE_ACTIVE)
    widget.w_set_focus(e, st == style.STATE_FOCUS)
    widget.w_set_disabled(e, st == style.STATE_DISABLED)
    widget.w_set_selected(e, st == style.STATE_SELECTED)
}

fn node_state(sc: *mut Scene, i: usize) -> u32 {
    return widget.w_state(&(*nd(sc, i)).e)
}

fn node_set_text(sc: *mut Scene, i: usize, p: u64, n: usize) {
    if i >= (*sc).n {
        return
    }
    widget.w_set_text(&(*nd(sc, i)).e, p, n)
}

fn node_set_widget_kind(sc: *mut Scene, i: usize, k: u32) {
    if i >= (*sc).n {
        return
    }
    widget.w_set_kind(&(*nd(sc, i)).e, k)
}

// The carrier itself -- for everything that a widget can do and a node does not
// repeat itself (value of a slider, line count, ink).
fn node_widget(sc: *mut Scene, i: usize) -> *mut widget.Widget {
    return &(*nd(sc, i)).e
}

fn node_set_image(sc: *mut Scene, i: usize, img: *mut uiimage.Image,
    w: usize, h: usize) {
    if i >= (*sc).n {
        return
    }
    widget.w_set_image(&(*nd(sc, i)).e, img as u64)
    widget.w_set_art_size(&(*nd(sc, i)).e, w, h)
}

fn node_set_svg(sc: *mut Scene, i: usize, ic: *mut uisvg.Icon, w: usize,
    h: usize) {
    if i >= (*sc).n {
        return
    }
    widget.w_set_svg(&(*nd(sc, i)).e, ic as u64)
    widget.w_set_art_size(&(*nd(sc, i)).e, w, h)
}

fn node_set_art_align(sc: *mut Scene, i: usize, a: u32) {
    if i >= (*sc).n {
        return
    }
    widget.w_set_art_align(&(*nd(sc, i)).e, a)
}

// ============================================ WHAT A BOX DISTRIBUTES
fn node_set_flex(sc: *mut Scene, i: usize, dir: u32, justify: u32,
    align_items: u32) {
    if i >= (*sc).n {
        return
    }
    let nd: *mut Node = &(*nd(sc, i))
    (*nd).fb = flex.flexbox_new(dir)
    flex.flex_set_justify(&(*nd).fb, justify)
    flex.flex_set_align_items(&(*nd).fb, align_items)
}

fn node_set_gap(sc: *mut Scene, i: usize, main: i64, cross: i64) {
    if i >= (*sc).n {
        return
    }
    flex.flex_set_gap(&(*nd(sc, i)).fb, main, cross)
}

fn node_set_padding(sc: *mut Scene, i: usize, l: i64, t: i64, r: i64,
    b: i64) {
    if i >= (*sc).n {
        return
    }
    flex.flex_set_padding(&(*nd(sc, i)).fb, l, t, r, b)
}

// PADDING AND GAP IN ONE SENTENCE. Both say the same -- how much
// air a box leaves -- and both land in the same flexbox.
// Whoever needs only one of the two keeps calling `node_set_padding`
// or `node_set_gap`; calculation is done in flex.fi, here things are only
// passed on.
fn node_set_space(sc: *mut Scene, i: usize, l: i64, t: i64, r: i64,
    b: i64, gap_main: i64, gap_cross: i64) {
    node_set_padding(sc, i, l, t, r, b)
    node_set_gap(sc, i, gap_main, gap_cross)
}

// ================================================ A GRID (lib/fui/grid.fi)
//
// A box can distribute its children not on ONE axis (flex) but on TRACKS:
// `node_set_grid` turns the node into a grid, `node_grid_col/_row` append
// tracks (grid.tk_px / tk_auto / tk_fr / tk_minmax), `node_set_cell` puts a
// child on a cell and span (or leaves it to the auto-placement). The
// calculation is grid.fi's and ONLY there; this module fills the items from
// the measured children and writes the rectangles back -- the same split as
// for flex.fi. The spec of a grid node lives in the scene's grid pool at the
// node's own slot, so the node itself stays small.
fn grid_pool_slot(sc: *mut Scene, i: usize) -> *mut grid.GridSpec {
    return ((sc as u64) +% ((*sc).gpool -% (sc as u64) +% (i as u64) * (*sc).gsz)) as *mut grid.GridSpec
}

fn grid_pool_ensure(sc: *mut Scene) -> bool {
    if (*sc).gpool != 0 {
        return true
    }
    var probe: [grid.GridSpec; 2] = [grid.grid_spec_new(); 2]
    let sz: u64 = (&probe[1]) as u64 - (&probe[0]) as u64
    let p: u64 = rt.heap_alloc(SCENE_MAX * sz as usize)
    if p == 0 {
        return false
    }
    (*sc).gsz = sz
    (*sc).gpool = p
    return true
}

// Turn node `i` into a grid with no tracks yet. false = no memory.
fn node_set_grid(sc: *mut Scene, i: usize) -> bool {
    if i >= (*sc).n || i >= SCENE_MAX || !grid_pool_ensure(sc) {
        return false
    }
    *grid_pool_slot(sc, i) = grid.grid_spec_new()
    (*nd(sc, i)).grid = 1 as u32
    return true
}

fn node_is_grid(sc: *mut Scene, i: usize) -> bool {
    if i >= (*sc).n {
        return false
    }
    return (*nd(sc, i)).grid != (0 as u32)
}

// The spec of a grid node (0 if the node is no grid) -- for tests and tools.
fn node_grid_spec(sc: *mut Scene, i: usize) -> *mut grid.GridSpec {
    if !node_is_grid(sc, i) {
        return 0 as *mut grid.GridSpec
    }
    return grid_pool_slot(sc, i)
}

// Track sizes are DESIGN points (grid.tk_px(240) is 240 at scale 1000).
fn node_grid_col(sc: *mut Scene, i: usize, t: grid.Track) -> bool {
    if !node_is_grid(sc, i) {
        return false
    }
    return grid.gs_add_col(grid_pool_slot(sc, i), t)
}

fn node_grid_row(sc: *mut Scene, i: usize, t: grid.Track) -> bool {
    if !node_is_grid(sc, i) {
        return false
    }
    return grid.gs_add_row(grid_pool_slot(sc, i), t)
}

fn node_grid_gap(sc: *mut Scene, i: usize, x: i64, y: i64) {
    if node_is_grid(sc, i) {
        grid.gs_set_gap(grid_pool_slot(sc, i), x, y)
    }
}

fn node_grid_padding(sc: *mut Scene, i: usize, l: i64, t: i64, r: i64,
    b: i64) {
    if node_is_grid(sc, i) {
        grid.gs_set_padding(grid_pool_slot(sc, i), l, t, r, b)
    }
}

fn node_grid_flow(sc: *mut Scene, i: usize, flow: u32, dense: bool) {
    if node_is_grid(sc, i) {
        grid.gs_set_flow(grid_pool_slot(sc, i), flow, dense)
    }
}

// justify-content / align-content (grid.GC_*)
fn node_grid_content(sc: *mut Scene, i: usize, justify: u32, align_c: u32) {
    if node_is_grid(sc, i) {
        grid.gs_set_content(grid_pool_slot(sc, i), justify, align_c)
    }
}

// justify-items / align-items (flex.AL_*)
fn node_grid_items(sc: *mut Scene, i: usize, ax: u32, ay: u32) {
    if node_is_grid(sc, i) {
        grid.gs_set_items(grid_pool_slot(sc, i), ax, ay)
    }
}

// grid-auto-columns / grid-auto-rows
fn node_grid_auto(sc: *mut Scene, i: usize, col: grid.Track, row: grid.Track) {
    if node_is_grid(sc, i) {
        grid.gs_set_auto(grid_pool_slot(sc, i), col, row)
    }
}

// right-to-left: column 0 on the right
fn node_grid_rtl(sc: *mut Scene, i: usize, rtl: bool) {
    if node_is_grid(sc, i) {
        grid.gs_set_rtl(grid_pool_slot(sc, i), rtl)
    }
}

// The cell of a CHILD: column/row 0-based, -1 = automatic; spans >= 1.
fn node_set_cell(sc: *mut Scene, i: usize, col: i64, row: i64, cspan: i64,
    rspan: i64) {
    if i >= (*sc).n {
        return
    }
    var c: u64 = 0
    if col >= 0 && col < 65535 {
        c = (col + 1) as u64
    }
    var r: u64 = 0
    if row >= 0 && row < 65535 {
        r = (row + 1) as u64
    }
    var cs: u64 = 1
    if cspan > 1 {
        cs = cspan as u64
        if cs > 32 {
            cs = 32
        }
    }
    var rs: u64 = 1
    if rspan > 1 {
        rs = rspan as u64
        if rs > 32 {
            rs = 32
        }
    }
    let keep: u64 = (*nd(sc, i)).cell & 0xFFFF000000000000
    (*nd(sc, i)).cell = keep | c | (r << 16) | (cs << 32) | (rs << 40)
}

// Read back the cell of a CHILD (what node_set_cell stored): which = 0 column,
// 1 row (both -1 = automatic), 2 column span, 3 row span. 0 - 1 for a bad node.
fn node_cell_get(sc: *mut Scene, i: usize, which: usize) -> i64 {
    if i >= (*sc).n {
        return 0 - 1
    }
    let c: u64 = (*nd(sc, i)).cell
    if which == 0 {
        return ((c & 0xFFFF) as i64) - 1
    }
    if which == 1 {
        return (((c >> 16) & 0xFFFF) as i64) - 1
    }
    var cs: i64 = ((c >> 32) & 255) as i64
    var rs: i64 = ((c >> 40) & 255) as i64
    if cs < 1 { cs = 1 }
    if rs < 1 { rs = 1 }
    if which == 2 {
        return cs
    }
    return rs
}

// Number of explicit tracks of a grid node: axis 0 = columns, 1 = rows.
// 0 for a node that is no grid.
fn node_grid_count(sc: *mut Scene, i: usize, axis: usize) -> usize {
    if !node_is_grid(sc, i) {
        return 0
    }
    if axis == 0 {
        return (*grid_pool_slot(sc, i)).ncols
    }
    return (*grid_pool_slot(sc, i)).nrows
}

// The gap of a grid node: axis 0 = between columns, 1 = between rows.
fn node_grid_gap_get(sc: *mut Scene, i: usize, axis: usize) -> i64 {
    if !node_is_grid(sc, i) {
        return 0
    }
    if axis == 0 {
        return (*grid_pool_slot(sc, i)).gap_x
    }
    return (*grid_pool_slot(sc, i)).gap_y
}

// justify-self / align-self of a child inside its cell (flex.AL_*, AL_AUTO =
// what the grid says).
fn node_set_cell_align(sc: *mut Scene, i: usize, ax: u32, ay: u32) {
    if i >= (*sc).n {
        return
    }
    let keep: u64 = (*nd(sc, i)).cell & 0x0000FFFFFFFFFFFF
    (*nd(sc, i)).cell = keep | ((ax as u64 & 255) << 48) | ((ay as u64 & 255) << 56)
}

fn node_set_wrap(sc: *mut Scene, i: usize, w: u32) {
    if i >= (*sc).n {
        return
    }
    flex.flex_set_wrap(&(*nd(sc, i)).fb, w)
}

fn node_set_grow(sc: *mut Scene, i: usize, grow: i64, shrink: i64) {
    if i >= (*sc).n {
        return
    }
    (*nd(sc, i)).grow = grow
    (*nd(sc, i)).shrink = shrink
}

fn node_set_base(sc: *mut Scene, i: usize, basis: i64) {
    if i >= (*sc).n {
        return
    }
    (*nd(sc, i)).basis = basis
}

// THE MINIMUM AND MAXIMUM SIZE ON THE MAIN AXIS. That is
// `min-width`/`max-width` of a row (or `min-height`/`max-height`
// of a column), and it is the value without which a growing child disappears when
// shrinking: a search field with grow 1000 becomes so small in a
// narrow bar that its text no longer fits in. 0 means
// "no limit".
//
// CLAMPING IS DONE IN flex.fi. This function passes the two numbers on to
// `flex.item_set_bounds` (in `fill_items`), and the
// redistribution that follows from it (css-flexbox-1, 9.7) stands there in
// ONE place. An `if breite < min` of its own in this file would be
// the second clamp and wrong at the second pass of the
// redistribution.
fn node_set_bounds(sc: *mut Scene, i: usize, min_main: i64,
    max_main: i64) {
    if i >= (*sc).n {
        return
    }
    (*nd(sc, i)).min_main = min_main
    (*nd(sc, i)).max_main = max_main
}

// GROW, SHRINK AND THE LIMITS WITH THEM -- in one sentence. A
// child with `grow` but without `min_main` is the most frequent error in
// a narrow bar (the search field shrinks below its text), and
// two separate calls invite exactly the forgetting of the second.
// Clamping is still done in flex.fi.
fn node_set_flexitem(sc: *mut Scene, i: usize, grow: i64, shrink: i64,
    min_main: i64, max_main: i64) {
    node_set_grow(sc, i, grow, shrink)
    node_set_bounds(sc, i, min_main, max_main)
}

fn node_set_align_self(sc: *mut Scene, i: usize, a: u32) {
    if i >= (*sc).n {
        return
    }
    (*nd(sc, i)).align_self = a
}

// ---- CSS extras (lib/fui/lay.fi). Plain setters; the arithmetic is in
// fill_items / lay_adjust below and in flex.fi.
fn node_set_strict(sc: *mut Scene, i: usize, on: bool) {
    if i >= (*sc).n {
        return
    }
    if on {
        (*nd(sc, i)).strict = 1 as u32
    } else {
        (*nd(sc, i)).strict = 0 as u32
    }
}

fn node_set_margin(sc: *mut Scene, i: usize, l: i64, t: i64, r: i64, b: i64) {
    if i >= (*sc).n {
        return
    }
    (*nd(sc, i)).mg_l = l
    (*nd(sc, i)).mg_t = t
    (*nd(sc, i)).mg_r = r
    (*nd(sc, i)).mg_b = b
}

fn node_set_minmax(sc: *mut Scene, i: usize, min_w: i64, max_w: i64,
    min_h: i64, max_h: i64) {
    if i >= (*sc).n {
        return
    }
    (*nd(sc, i)).mn_w = min_w
    (*nd(sc, i)).mx_w = max_w
    (*nd(sc, i)).mn_h = min_h
    (*nd(sc, i)).mx_h = max_h
}

fn node_set_fill(sc: *mut Scene, i: usize, bits: u32) {
    if i >= (*sc).n {
        return
    }
    (*nd(sc, i)).fill = bits
}

fn node_set_aspect(sc: *mut Scene, i: usize, w: i64, h: i64) {
    if i >= (*sc).n {
        return
    }
    (*nd(sc, i)).asp_w = w
    (*nd(sc, i)).asp_h = h
}

// HIDDEN (29.09.2026): the node and everything under it is laid out as
// always but neither painted nor hit -- CSS `visibility: hidden`. What a
// page does with it (examples/codehub): paint the still part of a picture
// once with the moving parts hidden, then paint only those parts on top of
// the copy, frame after frame (`scene_draw_subtree`).
fn node_set_hidden(sc: *mut Scene, i: usize, on: bool) {
    if i >= (*sc).n {
        return
    }
    if on {
        (*nd(sc, i)).hidden = 1 as u32
    } else {
        (*nd(sc, i)).hidden = 0 as u32
    }
}

fn node_hidden(sc: *mut Scene, i: usize) -> bool {
    if i >= (*sc).n {
        return false
    }
    return (*nd(sc, i)).hidden != 0 as u32
}

// ======================================================================
// THE PAGE LOOK (30.09.2026)
// ======================================================================

// THE OPACITY OF A NODE AND EVERYTHING IN IT, 0..1 -- CSS `opacity`. The
// subtree is painted as ONE picture off the screen and laid over at this
// opacity (lib/fui/layer.fi), so overlapping parts do not show through
// each other. 0 paints nothing (the node keeps its room); 1 costs nothing.
fn node_set_opacity(sc: *mut Scene, i: usize, a: f64) {
    if i >= (*sc).n {
        return
    }
    var k: f64 = a
    if k < 0.0 {
        k = 0.0
    }
    if k > 1.0 {
        k = 1.0
    }
    (*nd(sc, i)).alpha = (k * 255.0 + 0.5) as u32
}

// THE OFFSET OF A NODE AND EVERYTHING IN IT, design points -- CSS
// `transform: translate(dx, dy)`: painted there, laid out here. Nothing
// around it moves (the rise of a fade-in). A scroll area inside keeps its
// clip where the layout put it; hits still find the laid-out place.
fn node_set_offset(sc: *mut Scene, i: usize, dx: f64, dy: f64) {
    if i >= (*sc).n {
        return
    }
    (*nd(sc, i)).off_x = dx
    (*nd(sc, i)).off_y = dy
}

// A LIVE NODE changes every frame (a hovered button, a blinking cursor):
// scene_draw_still paints the page without it, scene_draw_live only it.
fn node_set_live(sc: *mut Scene, i: usize, on: bool) {
    if i >= (*sc).n {
        return
    }
    if on {
        (*nd(sc, i)).live = 1 as u32
    } else {
        (*nd(sc, i)).live = 0 as u32
    }
}

fn node_live(sc: *mut Scene, i: usize) -> bool {
    if i >= (*sc).n {
        return false
    }
    return (*nd(sc, i)).live != 0 as u32
}

// A PARAGRAPH: the text breaks into lines at the width the layout gives
// it (at most `max_lines`, 0 = one line as before), and its height is the
// height of those lines -- nobody counts lines or fixes sizes by hand. In
// a column it is at most as wide as the column; in a row it shrinks with
// the row. scene_layout measures again when a width changed (scene_reflows).
fn node_set_text_wrap(sc: *mut Scene, i: usize, max_lines: usize) {
    if i >= (*sc).n {
        return
    }
    (*nd(sc, i)).wrap = max_lines
}

// ROOM FOR THE WHOLE TEXT while only a part of it shows -- a terminal
// that types, a counter that runs up, a text that streams in. The node is
// MEASURED with (p, n) (its width, and as a paragraph its lines and
// height) and PAINTED with its own text, so nothing around it moves while
// the shown part grows. (p, n) should start with the shown text. n = 0
// ends the reservation.
fn node_set_text_reserve(sc: *mut Scene, i: usize, p: u64, n: usize) {
    if i >= (*sc).n {
        return
    }
    (*nd(sc, i)).res_p = p
    (*nd(sc, i)).res_n = n
}

// The lines a paragraph got in the last layout (1 for any other node).
fn node_text_lines(sc: *mut Scene, i: usize) -> usize {
    if i >= (*sc).n {
        return 0
    }
    return (*nd(sc, i)).lines
}

// THE VIEW'S WIDTH in design points -- what a fluid font size
// (style.style_set_font_fluid) is measured against, CSS `vw`. Set it
// before scene_style.
fn scene_set_view(sc: *mut Scene, w: f64) {
    if w <= 0.0 {
        (*sc).view_w = 0
        return
    }
    (*sc).view_w = (w + 0.5) as usize
}

fn scene_view(sc: *mut Scene) -> usize { return (*sc).view_w }

// Extra measure + layout rounds of the last scene_layout (paragraphs whose
// width changed).
fn scene_reflows(sc: *mut Scene) -> usize { return (*sc).reflows }

// A fixed size. 0 or less means "measured".
fn node_set_size(sc: *mut Scene, i: usize, w: f64, h: f64) {
    if i >= (*sc).n {
        return
    }
    (*nd(sc, i)).fix_w = w
    (*nd(sc, i)).fix_h = h
}

fn node_set_viewport(sc: *mut Scene, i: usize, v: *mut viewport.Viewport) {
    if i >= (*sc).n {
        return
    }
    (*nd(sc, i)).vp = v as u64
}

fn node_viewport(sc: *mut Scene, i: usize) -> *mut viewport.Viewport {
    return (*nd(sc, i)).vp as *mut viewport.Viewport
}

// ATTACH A PAINTER OF ITS OWN. It runs AFTER what the kind of the
// node paints, and inside a pane box also inside its
// clip -- so it cannot run out of the viewport.
// `ud` the caller passes through to himself; this module never looks at
// the number.
fn node_set_draw(sc: *mut Scene, i: usize, ud: u64,
    f: fn(u64, *mut render.Ctx, *mut widget.Widget)) {
    if i >= (*sc).n {
        return
    }
    (*nd(sc, i)).dr = f
    (*nd(sc, i)).du = ud
    (*nd(sc, i)).has_dr = 1 as u32
}

fn node_style(sc: *mut Scene, i: usize) -> *mut style.Style {
    return widget.w_style(&(*nd(sc, i)).e)
}

fn node_decl(sc: *mut Scene, i: usize) -> *mut sheet.Decl {
    return &(*nd(sc, i)).d
}

fn node_pref_w(sc: *mut Scene, i: usize) -> f64 { return (*nd(sc, i)).pw }
fn node_pref_h(sc: *mut Scene, i: usize) -> f64 { return (*nd(sc, i)).ph }
fn node_x(sc: *mut Scene, i: usize) -> f64 { return (*nd(sc, i)).x }
fn node_y(sc: *mut Scene, i: usize) -> f64 { return (*nd(sc, i)).y }
fn node_w(sc: *mut Scene, i: usize) -> f64 { return (*nd(sc, i)).w }
fn node_h(sc: *mut Scene, i: usize) -> f64 { return (*nd(sc, i)).h }
// The size the node measured to BEFORE any fixed size or flex stretch (what its content wants).
fn node_nat_w(sc: *mut Scene, i: usize) -> f64 { return (*nd(sc, i)).nat_w }
fn node_nat_h(sc: *mut Scene, i: usize) -> f64 { return (*nd(sc, i)).nat_h }

// ======================================================================
// PASS 1: THE STYLE
// ======================================================================
//
// For every node the CHAIN of its ancestors is built as
// sheet.NodeDesc (root first) and sheet.sheet_resolve
// is asked. Afterwards the node inherits from its parent what is inheritable
// -- and ONLY that; the limit is drawn by sheet.decl_inherit.
//
// The result lands as style.Style on the widget of the node. From here
// on the style of a node is nothing special any more: render.draw_base
// reads it as with every other widget of this library.
fn scene_desc(sc: *mut Scene, i: usize) -> sheet.NodeDesc {
    let nd: *mut Node = &(*nd(sc, i))
    var d: sheet.NodeDesc = sheet.desc_new(desc_kind_of(sc, i), (*nd).id)
    var k: usize = 0
    while k < (*nd).ncls {
        sheet.desc_add_class(&d, (*nd).cls[k])
        k = k + 1
    }
    sheet.desc_set_state(&d, widget.w_state(&(*nd).e))
    return d
}

// THE KIND BY WHICH A RULE SELECTS. For a widget node that
// is the kind of the widget (button, card, tab) -- by that a style sheet wants
// to select. For all others the kind of the node, shifted by
// 1000, so that the two number spaces do not
// overlap.
fn desc_kind_of(sc: *mut Scene, i: usize) -> u32 {
    let nd: *mut Node = &(*nd(sc, i))
    if (*nd).kind == N_WIDGET {
        return widget.w_kind(&(*nd).e)
    }
    return 1000 as u32 + (*nd).kind
}

fn style_walk(sc: *mut Scene, sh: *mut sheet.Sheet, i: usize,
    chain: *mut sheet.NodeDesc, depth: usize, pk: u64) {
    if i == SCENE_NONE || i >= (*sc).n {
        return
    }
    // THE BREAK-OFF IS COUNTED. A chain cannot be built deeper than
    // sheet.CHAIN_MAX, so this node together with its subtree
    // gets no style. That may occur -- it must not occur silently:
    // otherwise an unstyled, invisible box stands in the picture and
    // nobody knows why.
    if depth >= sheet.CHAIN_MAX {
        (*sc).depthof = (*sc).depthof + 1
        return
    }
    // The stride comes from sheet.fi -- there the type lies, there
    // it is measured. A 56 at this place would be a second place
    // for the same thing and wrong at the next field in `NodeDesc`.
    let dp: *mut sheet.NodeDesc = (chain as u64
        +(depth * sheet.sheet_desc_stride()) as u64) as *mut sheet.NodeDesc
    *dp = scene_desc(sc, i)
    let nd: *mut Node = &(*nd(sc, i))
    // THE STYLE MEMO: a node's resolved style depends on its chain (its own
    // description and its ancestors') and on the sheet -- nothing else. The
    // key folds the parent's key with this node's description, so an equal
    // key means an equal chain under an equal sheet (scene_style seeds the
    // root with the sheet's fingerprint).
    var sk: u64 = 0
    var hit: bool = false
    if pk != 0 && i < SCENE_MAX {
        let m: *mut Memo = (*sc).memo as *mut Memo
        sk = mix_desc(pk, dp)
        let slot: *mut MemoSlot = &(*ms(m, i))
        if (*slot).skey == sk {
            (*nd).d = (*slot).sd
            (*m).shits = (*m).shits + 1
            hit = true
        }
    }
    if !hit {
        var d: sheet.Decl = sheet.decl_new()
        sheet.sheet_resolve(sh, chain, depth + 1, &d)
        if (*nd).parent != SCENE_NONE {
            sheet.decl_inherit(&d, &(*nd(sc, (*nd).parent)).d)
        }
        // A FLUID FONT SIZE becomes a plain one here, against the view's
        // width -- before the children inherit it.
        let ds: *mut style.Style = sheet.decl_style(&d)
        if ((*ds).set_mask & style.SF_FLUID) != 0 as u32 {
            (*ds).font_px = style.style_fluid_px(ds, (*sc).view_w) as u16
        }
        (*nd).d = d
        if sk != 0 {
            let m2: *mut Memo = (*sc).memo as *mut Memo
            (*ms(m2, i)).skey = sk
            (*ms(m2, i)).sd = d
            (*m2).smisses = (*m2).smisses + 1
        }
    }
    *widget.w_style(&(*nd).e) = *sheet.decl_style(&(*nd).d)
    var c: usize = (*nd).first
    while c != SCENE_NONE {
        style_walk(sc, sh, c, chain, depth + 1, sk)
        c = (*nd(sc, c)).next
    }
}

// A description folded into a style key, field by field (the padding
// of a NodeDesc is not part of it).
fn mix_desc(pk: u64, d: *mut sheet.NodeDesc) -> u64 {
    var h: u64 = mix(pk, (*d).kind as u64)
    h = mix(h, (*d).id as u64)
    h = mix(h, (*d).state as u64)
    h = mix(h, (*d).ncls as u64)
    var k: usize = 0
    while k < (*d).ncls && k < sheet.DESC_CLASS_MAX {
        h = mix(h, (*d).cls[k] as u64)
        k = k + 1
    }
    if h == 0 {
        h = 1
    }
    return h
}

// The root's style key: the sheet's rules as bytes, their number, and the
// view's width (fluid font sizes). Any edit of the sheet -- a new rule, a
// value changed by the inspector -- changes it, and every node misses.
fn style_root_key(sc: *mut Scene, sh: *mut sheet.Sheet) -> u64 {
    let n: usize = sheet.sheet_count(sh)
    var h: u64 = mix(0x5157, n as u64)
    h = mix(h, (*sc).view_w as u64)
    if n > 0 {
        let a: u64 = sheet.sheet_sel(sh, 0) as u64
        var stride: usize = 0
        if n > 1 {
            stride = (sheet.sheet_sel(sh, 1) as u64 - a) as usize
            h = mix_bytes(h, a, n * stride)
        } else {
            // one rule: its selector up to the declaration, then the
            // declaration itself
            let m: *mut Memo = (*sc).memo as *mut Memo
            let dd: u64 = sheet.sheet_decl(sh, 0) as u64
            h = mix_bytes(h, a, (dd - a) as usize)
            h = mix_bytes(h, dd, (*m).dsz)
        }
    }
    if h == 0 {
        h = 1
    }
    return h
}

fn scene_style(sc: *mut Scene, sh: *mut sheet.Sheet) {
    if (*sc).root == SCENE_NONE {
        return
    }
    var chain: [sheet.NodeDesc; 16] =
    [sheet.desc_new(0 as u32, 0 as u32); 16]
    (*sc).depthof = 0
    var rk: u64 = 0
    if (*sc).memo != 0 {
        rk = style_root_key(sc, sh)
    }
    style_walk(sc, sh, (*sc).root, &chain[0], 0, rk)
    (*sc).phase = PHASE_STYLE
}

// ======================================================================
// PASS 2: MEASURING
// ======================================================================
//
// From the bottom up. A leaf asks render.pref_of -- the same
// measuring protocol that every widget of this library uses. A box
// asks flex.flex_measure_main/_cross over its already measured
// children. A pane box reports the size of ITS VIEWPORT, not
// that of its content -- that is exactly its purpose.
fn measure_node(sc: *mut Scene, c: *mut render.Ctx, i: usize) {
    if i == SCENE_NONE || i >= (*sc).n {
        return
    }
    var k: usize = (*nd(sc, i)).first
    while k != SCENE_NONE {
        measure_node(sc, c, k)
        k = (*nd(sc, k)).next
    }
    let nd: *mut Node = &(*nd(sc, i))
    var pw: f64 = 0.0
    var ph: f64 = 0.0
    if (*nd).kind == N_VIEWPORT && (*nd).vp != 0 {
        let v: *mut viewport.Viewport = (*nd).vp as *mut viewport.Viewport
        pw = viewport.viewport_w(v)
        ph = viewport.viewport_h(v)
    } else if (*nd).nkids == 0 {
        // a reserved text is measured in place of the shown one
        let sp: u64 = widget.w_text(&(*nd).e)
        let sn: usize = widget.w_text_len(&(*nd).e)
        if (*nd).res_n > 0 {
            widget.w_set_text(&(*nd).e, (*nd).res_p, (*nd).res_n)
        }
        if (*nd).kind == N_BOX && (*nd).parent != SCENE_NONE
            && (*nd(sc, (*nd).parent)).strict != (0 as u32) {
            // an EMPTY block in a CSS-style box has no size of its own (a div)
            pw = 0.0
            ph = 0.0
        } else if !memo_get(sc, c, i, &pw, &ph) {
            render.pref_of(c, &(*nd).e, &pw, &ph)
            if (*nd).wrap > 0 && widget.w_text_len(&(*nd).e) != 0 {
                measure_para(sc, c, i, &pw, &ph)
            }
            memo_put(sc, i, pw, ph)
        }
        if (*nd).res_n > 0 {
            widget.w_set_text(&(*nd).e, sp, sn)
        }
    } else {
        // THE BOX MEMO: a box's size is a function of its own flex values,
        // its fixed size and its children's items -- `box_key` folds all
        // of them (and the children's own layout keys) into one number.
        let bk: u64 = box_key(sc, i)
        if bk != 0 && memo_box_get(sc, i, bk, &pw, &ph) {
            // pw/ph came from the memo
        } else if (*nd).grid != (0 as u32) {
            measure_grid(sc, c, i, &pw, &ph)
            memo_box_put(sc, i, bk, pw, ph)
        } else {
            var items: [flex.FlexItem; 64] = [flex.flex_item(0, 0); 64]
            let n: usize = fill_items(sc, c, i, &items[0])
            // THE DIRECTION QUESTION IS ASKED BY flex.fi. `flex_is_row` is the same
            // function that `flex_measure_main` and `flex_layout` ask
            // internally -- a `(*fb).dir == FLEX_ROW` at this place would be
            // the second place for the same decision.
            let line: bool = flex.flex_is_row(&(*nd).fb)
            var fb: flex.FlexBox = box_px(c, &(*nd).fb)
            let m: i64 = flex.flex_measure_main(&fb, &items[0], n)
            var q: i64 = flex.flex_measure_cross(&fb, &items[0], n)
            // A WRAPPING BOX OF FIXED MAIN SIZE knows its lines already: its
            // cross size is theirs, not one line's (flex_measure_cross_wrap).
            var fixed_main: f64 = (*nd).fix_h
            if line {
                fixed_main = (*nd).fix_w
            }
            // a wrapping CSS-style row measures its height at the width the
            // last layout gave it (reflow, like a paragraph)
            if line && (*nd).strict != (0 as u32) && fb.wrap != flex.WRAP_NONE
                && fixed_main <= 0.0 && (*nd).avail > 0.0 {
                fixed_main = (*nd).avail
            }
            if fixed_main > 0.0 {
                q = flex.flex_measure_cross_wrap(&fb, &items[0], n,
                    px_of(c, fixed_main) as i64)
            }
            if line {
                pw = m as f64
                ph = q as f64
            } else {
                pw = q as f64
                ph = m as f64
            }
            memo_box_put(sc, i, bk, pw, ph)
        }
    }
    memo_set_lk(sc, i)
    // ================================== THE SIZE FROM THE STYLE SHEET
    //
    // `width`/`height` are perfectly normal style values (style.SF_WIDTH,
    // SF_HEIGHT): they come from the same precedence as colour and
    // radius and therefore stand ONCE for a whole class of
    // nodes, instead of at every single one in the tree. Measuring is done nevertheless
    // first -- so a node without a rule keeps its preferred size.
    //
    // AND THE TREE BEATS THE SHEET. `node_set_size` stands directly at
    // this one node; whoever writes it there means exactly it.
    // That is why it comes AFTER the sheet. The other way round the rule would be
    // stronger than the exception, and a special case could not
    // be expressed at all.
    //
    // AND BOTH ARE DESIGN POINTS. A line of style sheet "height 56"
    // means 56 points at 96 dpi, exactly like the inner margin of a button
    // -- and that goes in render.fi through `len_of`. Until 23.09.2026
    // the sizes of this file did NOT go through it: on a screen
    // with scale 2 the font of a button became twice as large,
    // the bar around it stayed 56 pixels high, and the text
    // ran out of it. Now every length of this module takes
    // the same path (`px_of`, `box_px`, `fill_items`) -- there is no second
    // way of calculating for the scale, at scale 1000
    // `len_of(n) == n` and every previous picture stays pixel for pixel
    // the same.
    (*nd).nat_w = pw
    (*nd).nat_h = ph
    let st: *mut style.Style = widget.w_style(&(*nd).e)
    if style.style_has_width(st) {
        pw = render.len_of(c, style.style_width(st))
    }
    if style.style_has_height(st) {
        ph = render.len_of(c, style.style_height(st))
    }
    if (*nd).fix_w > 0.0 {
        pw = px_of(c, (*nd).fix_w)
    }
    if (*nd).fix_h > 0.0 {
        ph = px_of(c, (*nd).fix_h)
    }
    if (*nd).asp_w > 0 && (*nd).asp_h > 0 && (*nd).fix_h <= 0.0 && pw > 0.0 {
        ph = (((pw as i64) * (*nd).asp_h / (*nd).asp_w) as f64)
    }
    (*nd).pw = pw
    (*nd).ph = ph
    (*nd).mw = pw
    (*nd).mh = ph
    widget.w_set_pref(&(*nd).e, pw, ph)
}

// A PARAGRAPH'S SIZE: as wide as its text in one line, but not wider
// than the room the last layout gave it; as high as its lines at that
// width. Without a layout yet it is one line -- scene_layout comes back.
fn measure_para(sc: *mut Scene, c: *mut render.Ctx, i: usize,
    pw: *mut f64, ph: *mut f64) {
    let nd: *mut Node = &(*nd(sc, i))
    var w: f64 = *pw
    if (*nd).fix_w > 0.0 {
        w = px_of(c, (*nd).fix_w)
    } else if (*nd).avail >= 0.0 && (*nd).avail < w {
        w = (*nd).avail
    }
    var h: f64 = 0.0
    let n: usize = render.text_lines_at(c, &(*nd).e, w, (*nd).wrap, &h)
    (*nd).lines = n
    widget.w_set_text_lines(&(*nd).e, n)
    *pw = w
    *ph = h
}

// AFTER A LAYOUT: the width each paragraph really has. In a column that
// is the column's inner width (a paragraph that is not stretched must
// still break at the column's edge); anywhere else the width it was laid
// out at. True when one changed -- then the tree is measured again.
fn para_widths(sc: *mut Scene, c: *mut render.Ctx) -> bool {
    var changed: bool = false
    var i: usize = 0
    while i < (*sc).n {
        let nd: *mut Node = &(*nd(sc, i))
        if (*nd).strict != (0 as u32) && (*nd).nkids > 0 && (*nd).fb.wrap != flex.WRAP_NONE
            && flex.flex_is_row(&(*nd).fb) && (*nd).fix_w <= 0.0 {
            var dw: f64 = (*nd).w - (*nd).avail
            if dw < 0.0 {
                dw = 0.0 - dw
            }
            if (*nd).avail < 0.0 || dw > 0.5 {
                (*nd).avail = (*nd).w
                changed = true
            }
        }
        if (*nd).wrap > 0 && (*nd).nkids == 0 && (*nd).fix_w <= 0.0 {
            var a: f64 = (*nd).w
            let p: usize = (*nd).parent
            var in_col: bool = false
            if p != SCENE_NONE && (*nd(sc, p)).grid == (0 as u32) {
                in_col = !flex.flex_is_row(&(*nd(sc, p)).fb)
            }
            if in_col {
                var fb: flex.FlexBox = box_px(c, &(*nd(sc, p)).fb)
                let inner: f64 = (*nd(sc, p)).w - (fb.pad_l as f64)
                -(fb.pad_r as f64)
                if inner > 0.0 {
                    a = inner
                }
            }
            var dd: f64 = a - (*nd).avail
            if dd < 0.0 {
                dd = 0.0 - dd
            }
            if (*nd).avail < 0.0 || dd > 0.5 {
                (*nd).avail = a
                // only a change of the LINES matters for the tree; a
                // paragraph that still fits keeps its measure
                changed = true
            }
        }
        i = i + 1
    }
    return changed
}

// FlexItems are made from the measured children. The conversion f64 ->
// integer basis is done by flex.flex_item_from_pref, and as the
// only place -- whoever rounds himself here gets two boxes with
// the same text in two widths.
fn fill_items(sc: *mut Scene, cx: *mut render.Ctx, i: usize,
    items: *mut flex.FlexItem) -> usize {
    let nd: *mut Node = &(*nd(sc, i))
    let line: bool = flex.flex_is_row(&(*nd).fb)
    var c: usize = (*nd).first
    var n: usize = 0
    while c != SCENE_NONE && n < KIDS_MAX {
        let kid: *mut Node = &(*nd(sc, c))
        var it: flex.FlexItem = flex.flex_item_from_pref((*kid).pw,
            (*kid).ph, line)
        var b: i64 = it.basis
        if (*kid).basis >= 0 {
            // A fixed basis is a length from the design -- so
            // via the same way as every other (see `px_of`).
            b = render.len_signed(cx, (*kid).basis) as i64
        }
        flex.item_set_flex(&it, (*kid).grow, (*kid).shrink, b)
        // THE LIMITS OF THE NODE GO ON -- BUT ONLY IF THERE ARE ANY.
        // `flex_item_from_pref` sets a content-based minimum size
        // (the measured basis, like `min-width: auto` on the
        // web): a button does not shrink below its own text.
        // Whoever passed the two zeros of the node through here unseen would
        // take away exactly this lower bound from it
        // -- a narrow row would then squeeze all buttons down to twenty
        // points, and the described bar would stand differently
        // from the painted one. So the rule is: 0/0 means "no OWN
        // limit", and then the content-based one stays.
        if (*kid).min_main != 0 || (*kid).max_main != 0 {
            flex.item_set_bounds(&it,
                render.len_signed(cx, (*kid).min_main) as i64,
                render.len_signed(cx, (*kid).max_main) as i64)
        }
        flex.item_set_align(&it, (*kid).align_self)
        // A PARAGRAPH MAY SHRINK below its one-line width -- that is the
        // point of it (CSS: its min-content is a word, not the line).
        if (*kid).wrap > 0 && line && (*kid).min_main == 0 {
            it.min_main = 0
        }
        if (*nd).strict != (0 as u32) || kid_extras(kid) {
            item_extras(cx, nd, kid, &it, line)
        }
        // The same rule as for the chain above: the stride of a
        // FlexItem is known by flex.fi, not by this module.
        *((items as u64 + (n * flex.flex_item_stride()) as u64)
            as *mut flex.FlexItem) = it
        n = n + 1
        c = (*kid).next
    }
    // WHAT NO LONGER FITS IS REPORTED. A box with 65
    // children distributes 64 of them; the 65th gets no rectangle and
    // would stay at (0,0) with the size zero. Formerly
    // `draw_node` painted it there (invisible, but present); now
    // this box counts up ONCE, and drawing leaves out nodes without
    // a surface.
    if c != SCENE_NONE {
        (*sc).kidof = (*sc).kidof + 1
    }
    return n
}


// ======================================================================
// CSS EXTRAS (lib/fui/lay.fi): margins, min/max, strict stretch, aspect
// ======================================================================
//
// Margins are done by INFLATION: the flex item is made bigger by the margins
// (basis, cross, bounds), flex.fi distributes as always, and `lay_adjust`
// shrinks the finished rectangle by the margins again. Free space, grow and
// stretch come out as in CSS. (Known difference: CSS scales the shrink share
// by the size WITHOUT margins, flex.fi by the inflated size -- only visible
// with margins AND shrinking children together.)
fn kid_extras(kid: *mut Node) -> bool {
    return (*kid).mg_l != 0 || (*kid).mg_t != 0 || (*kid).mg_r != 0
        || (*kid).mg_b != 0 || (*kid).mn_w != 0 || (*kid).mx_w != 0
        || (*kid).mn_h != 0 || (*kid).mx_h != 0 || (*kid).asp_w != 0
}

fn has_fixed(kid: *mut Node, horiz: bool) -> bool {
    let st: *mut style.Style = widget.w_style(&(*kid).e)
    if horiz {
        return (*kid).fix_w > 0.0 || style.style_has_width(st)
    }
    return (*kid).fix_h > 0.0 || style.style_has_height(st)
}

fn min_i64(a: i64, b: i64) -> i64 {
    if a < b {
        return a
    }
    return b
}

fn item_extras(cx: *mut render.Ctx, par: *mut Node, kid: *mut Node,
    it: *mut flex.FlexItem, line: bool) {
    let strict: bool = (*par).strict != (0 as u32)
    var fixed_main: bool = has_fixed(kid, line)
    var fixed_cross: bool = has_fixed(kid, !line)
    var fill_main: bool = ((*kid).fill & 1) != (0 as u32)
    var fill_cross: bool = ((*kid).fill & 2) != (0 as u32)
    if !line {
        fill_main = ((*kid).fill & 2) != (0 as u32)
        fill_cross = ((*kid).fill & 1) != (0 as u32)
    }
    var mn_m: i64 = (*kid).mn_h
    var mx_m: i64 = (*kid).mx_h
    var mn_c: i64 = (*kid).mn_w
    var mx_c: i64 = (*kid).mx_w
    var nat: f64 = (*kid).nat_h
    var pref: f64 = (*kid).ph
    if line {
        mn_m = (*kid).mn_w
        mx_m = (*kid).mx_w
        mn_c = (*kid).mn_h
        mx_c = (*kid).mx_h
        nat = (*kid).nat_w
        pref = (*kid).pw
    }
    if strict {
        // css-flexbox-1 4.5: the automatic minimum is min(content, specified)
        var mm: i64 = flex.flex_px(nat)
        if fill_main {
            mm = 0
        } else if fixed_main {
            mm = min_i64(mm, flex.flex_px(pref))
        }
        if (*kid).wrap > 0 && line {
            mm = 0
        }
        (*it).min_main = mm
        var al: u32 = (*it).align
        if al == flex.AL_AUTO {
            al = (*par).fb.align_items
        }
        if al == flex.AL_STRETCH && fixed_cross && !fill_cross {
            (*it).align = flex.AL_START
        }
    }
    if mn_m > 0 {
        (*it).min_main = render.len_signed(cx, mn_m) as i64
    }
    if mx_m > 0 {
        (*it).max_main = render.len_signed(cx, mx_m) as i64
    }
    // the cross size of the item (what makes the line high) obeys min/max too
    if mn_c > 0 && (*it).cross < render.len_signed(cx, mn_c) as i64 {
        (*it).cross = render.len_signed(cx, mn_c) as i64
    }
    if mx_c > 0 && (*it).cross > render.len_signed(cx, mx_c) as i64 {
        (*it).cross = render.len_signed(cx, mx_c) as i64
    }
    var ml: i64 = render.len_signed(cx, (*kid).mg_l) as i64
    var mt: i64 = render.len_signed(cx, (*kid).mg_t) as i64
    var mr: i64 = render.len_signed(cx, (*kid).mg_r) as i64
    var mb: i64 = render.len_signed(cx, (*kid).mg_b) as i64
    var mm_: i64 = mt + mb
    var mc_: i64 = ml + mr
    if line {
        mm_ = ml + mr
        mc_ = mt + mb
    }
    (*it).basis = (*it).basis + mm_
    (*it).mgn = mm_
    (*it).cross = (*it).cross + mc_
    (*it).min_main = (*it).min_main + mm_
    if (*it).max_main > 0 {
        (*it).max_main = (*it).max_main + mm_
    }
}

fn clamp_i(v: f64, lo: f64, hi: f64) -> f64 {
    var r: f64 = v
    if hi > 0.0 && r > hi {
        r = hi
    }
    if lo > 0.0 && r < lo {
        r = lo
    }
    return r
}

// The finished rectangle of a child, shrunk by its margins and clamped by
// its min/max (and given its aspect ratio).
fn lay_adjust(cx: *mut render.Ctx, kid: *mut Node, x: *mut f64, y: *mut f64,
    w: *mut f64, h: *mut f64) {
    let ml: f64 = render.len_signed(cx, (*kid).mg_l) as f64
    let mt: f64 = render.len_signed(cx, (*kid).mg_t) as f64
    let mr: f64 = render.len_signed(cx, (*kid).mg_r) as f64
    let mb: f64 = render.len_signed(cx, (*kid).mg_b) as f64
    var nx: f64 = *x + ml
    var ny: f64 = *y + mt
    var nw: f64 = *w - ml - mr
    var nh: f64 = *h - mt - mb
    if nw < 0.0 {
        nw = 0.0
    }
    if nh < 0.0 {
        nh = 0.0
    }
    nw = clamp_i(nw, render.len_signed(cx, (*kid).mn_w) as f64,
        render.len_signed(cx, (*kid).mx_w) as f64)
    if (*kid).asp_w > 0 && (*kid).asp_h > 0 && (*kid).fix_h <= 0.0 {
        nh = (((nw as i64) * (*kid).asp_h / (*kid).asp_w) as f64)
    }
    nh = clamp_i(nh, render.len_signed(cx, (*kid).mn_h) as f64,
        render.len_signed(cx, (*kid).mx_h) as f64)
    *x = nx
    *y = ny
    *w = nw
    *h = nh
}

// A FIXED SIZE INTO PIXELS. `node_set_size` takes a
// floating-point number, because rectangles here are floating-point numbers; what is meant is nevertheless
// a length from the design, and that goes through `render.len_of`,
// commercially rounded to whole points as there.
fn px_of(c: *mut render.Ctx, n: f64) -> f64 {
    if n <= 0.0 {
        return 0.0
    }
    return render.len_of(c, (n + 0.5) as usize)
}

// THE BOX, AS flex.fi IS TO SEE IT: inner margin and gaps in
// pixels. The numbers at the node stay design points -- whoever changes
// the scale (a window moves to another screen)
// simply measures the same tree anew and gets the new points, without
// anybody having to calculate the old ones back.
fn box_px(c: *mut render.Ctx, fb: *mut flex.FlexBox) -> flex.FlexBox {
    var b: flex.FlexBox = *fb
    b.gap_main = render.len_signed(c, b.gap_main) as i64
    b.gap_cross = render.len_signed(c, b.gap_cross) as i64
    b.pad_l = render.len_signed(c, b.pad_l) as i64
    b.pad_t = render.len_signed(c, b.pad_t) as i64
    b.pad_r = render.len_signed(c, b.pad_r) as i64
    b.pad_b = render.len_signed(c, b.pad_b) as i64
    return b
}

// THE GRID, AS grid.fi IS TO SEE IT: tracks, gaps and inner margin in
// pixels (design points through render.len_signed, like box_px).
fn gs_px(c: *mut render.Ctx, g: *mut grid.GridSpec) -> grid.GridSpec {
    var b: grid.GridSpec = *g
    var j: usize = 0
    while j < b.ncols {
        b.cols[j] = track_px(c, b.cols[j])
        j = j + 1
    }
    j = 0
    while j < b.nrows {
        b.rows[j] = track_px(c, b.rows[j])
        j = j + 1
    }
    b.auto_col = track_px(c, b.auto_col)
    b.auto_row = track_px(c, b.auto_row)
    b.gap_x = render.len_signed(c, b.gap_x) as i64
    b.gap_y = render.len_signed(c, b.gap_y) as i64
    b.pad_l = render.len_signed(c, b.pad_l) as i64
    b.pad_t = render.len_signed(c, b.pad_t) as i64
    b.pad_r = render.len_signed(c, b.pad_r) as i64
    b.pad_b = render.len_signed(c, b.pad_b) as i64
    return b
}

fn track_px(c: *mut render.Ctx, t: grid.Track) -> grid.Track {
    var r: grid.Track = t
    if r.min_k == grid.TK_PX {
        r.min_v = render.len_signed(c, r.min_v) as i64
    }
    if r.max_k == grid.TK_PX {
        r.max_v = render.len_signed(c, r.max_v) as i64
    }
    return r
}

// The GridItems from the measured children of grid node `i`: the measured
// size is both the preferred and (except for a paragraph, which may shrink)
// the minimum size; a child with a size of its own (node_set_size or a
// width/height rule) is not stretched.
fn fill_grid_items(sc: *mut Scene, i: usize, items: *mut grid.GridItem) -> usize {
    let nd: *mut Node = &(*nd(sc, i))
    var c: usize = (*nd).first
    var n: usize = 0
    while c != SCENE_NONE && n < KIDS_MAX {
        let kid: *mut Node = &(*nd(sc, c))
        var it: grid.GridItem = grid.grid_item(flex.flex_px((*kid).pw),
            flex.flex_px((*kid).ph))
        if (*kid).wrap > 0 {
            it.min_w = 0
        }
        let cl: u64 = (*kid).cell
        var cc: i64 = (cl & 0xFFFF) as i64
        var rr: i64 = ((cl >> 16) & 0xFFFF) as i64
        var cs: i64 = ((cl >> 32) & 255) as i64
        var rs: i64 = ((cl >> 40) & 255) as i64
        if cs < 1 {
            cs = 1
        }
        if rs < 1 {
            rs = 1
        }
        grid.gitem_place(&it, cc - 1, rr - 1, cs, rs)
        grid.gitem_align(&it, ((cl >> 48) & 255) as u32,
            ((cl >> 56) & 255) as u32)
        let st: *mut style.Style = widget.w_style(&(*kid).e)
        grid.gitem_fixed(&it, (*kid).fix_w > 0.0 || style.style_has_width(st),
            (*kid).fix_h > 0.0 || style.style_has_height(st))
        *((items as u64 + (n * grid.grid_item_stride()) as u64)
            as *mut grid.GridItem) = it
        n = n + 1
        c = (*kid).next
    }
    if c != SCENE_NONE {
        (*sc).kidof = (*sc).kidof + 1
    }
    return n
}

// MEASURING a grid box (max-content): the tracks at their content size.
fn measure_grid(sc: *mut Scene, c: *mut render.Ctx, i: usize, pw: *mut f64,
    ph: *mut f64) {
    var items: [grid.GridItem; 64] = [grid.grid_item(0, 0); 64]
    let n: usize = fill_grid_items(sc, i, &items[0])
    var g: grid.GridSpec = gs_px(c, grid_pool_slot(sc, i))
    var w: i64 = 0
    var h: i64 = 0
    grid.grid_measure(&g, &items[0], n, &w, &h)
    *pw = w as f64
    *ph = h as f64
}

// ARRANGING the children of a grid box in the rectangle (ox, oy, iw, ih).
fn layout_grid(sc: *mut Scene, c: *mut render.Ctx, i: usize, ox: f64,
    oy: f64, iw: f64, ih: f64) {
    let nd: *mut Node = &(*nd(sc, i))
    var items: [grid.GridItem; 64] = [grid.grid_item(0, 0); 64]
    let n: usize = fill_grid_items(sc, i, &items[0])
    var out: [layout.Rect; 64] = [layout.rect_new(0, 0, 0, 0); 64]
    var g: grid.GridSpec = gs_px(c, grid_pool_slot(sc, i))
    grid.grid_layout(&g,
        layout.rect_new(ox as i64, oy as i64, iw as i64, ih as i64),
        &items[0], n, &out[0])
    var k: usize = (*nd).first
    var j: usize = 0
    while k != SCENE_NONE && j < n {
        layout_node(sc, c, k, layout.rect_x(&out[j]) as f64,
            layout.rect_y(&out[j]) as f64,
            layout.rect_w(&out[j]) as f64,
            layout.rect_h(&out[j]) as f64)
        k = (*nd(sc, k)).next
        j = j + 1
    }
}

// ======================================================================
// THE MEASURE MEMO (docs/APP-TREE.md T10, r100)
// ======================================================================
//
// A tree rebuilt every frame (CodeHub, fui.app) measures every text every
// frame -- and measuring text is the dearest of the four passes (2.6 of
// 5.8 us per node, docs/APP-TREE.md 4.3). Almost all of it is the same
// text in the same style as one frame before. The memo remembers, per
// node number, WHAT was measured (a fingerprint of everything a leaf's
// size depends on) and WHAT CAME OUT; a leaf whose fingerprint did not
// change takes its size from the memo instead of shaping its text again.
//
// The fingerprint covers: the widget as a whole (kind, text pointer and
// length, the resolved style set, the picture, the line limit) with its
// OUTPUTS (place, preferred size) left out; the text's BYTES (a caller may
// reuse one buffer for another text); the node's own measure inputs
// (kind, fixed size, paragraph lines and width); and the context --
// the theme's shape, the scale, and the font the text is set in. What it
// does not see: a font slot's file being swapped under the same pointer.
// Whoever does that calls memo_clear.
//
// The memo belongs to the CALLER, like a viewport: it outlives the tree
// (scene_reset keeps it attached) and costs the kernel profile nothing,
// which never attaches one. Without it every leaf is measured, as before.
struct MemoSlot {
    key: u64,
    pw: f64,
    ph: f64,
    lines: usize,
    // the style memo: key (parent's key + own description) and result
    skey: u64,
    sd: sheet.Decl,
    // the layout memo: `lk` is this measure's fingerprint of everything
    // the subtree's layout depends on except its rectangle; `lkin` the
    // same with the rectangle, as of the last layout; ax..ah the rectangle
    // the node got in the last layout (absolute)
    lk: u64,
    lkin: u64,
    ax: f64,
    ay: f64,
    aw: f64,
    ah: f64,
}

fn memo_slot_blank() -> MemoSlot {
    return MemoSlot { key: 0, pw: 0.0, ph: 0.0, lines: 0, skey: 0,
        sd: sheet.decl_new(), lk: 0, lkin: 0, ax: 0.0, ay: 0.0, aw: 0.0,
        ah: 0.0 }
}

struct Memo {
    s: u64,
    ssz: u64,
    shi: usize,
    hits: usize,
    misses: usize,
    // the context fingerprint of the running scene_measure
    ctx: u64,
    // the byte size of a widget.Widget and a theme.Shape, measured once
    wsz: usize,
    shsz: usize,
    // the fingerprint of the leaf being measured (memo_get -> memo_put)
    cur: u64,
    // the byte size of a sheet.Decl
    dsz: usize,
    // style, box-measure and layout hits and misses
    shits: usize,
    smisses: usize,
    bhits: usize,
    bmisses: usize,
    lhits: usize,
    lmisses: usize,
}

fn memo_new() -> Memo {
    var pw: [widget.Widget; 2] = [widget.widget_new(widget.KIND_NONE); 2]
    var ps: [theme.Shape; 2] = [theme.shape_osum(); 2]
    var pd: [sheet.Decl; 2] = [sheet.decl_new(); 2]
    return Memo { s: 0, ssz: 0, shi: 0,
        hits: 0, misses: 0, ctx: 0,
        wsz: ((&pw[1]) as u64 - (&pw[0]) as u64) as usize,
        shsz: ((&ps[1]) as u64 - (&ps[0]) as u64) as usize, cur: 0,
        dsz: ((&pd[1]) as u64 - (&pd[0]) as u64) as usize,
        shits: 0, smisses: 0, bhits: 0, bmisses: 0, lhits: 0, lmisses: 0 }
}

// The memo's slots live on the heap like the nodes (one block of SCENE_MAX
// slots, mapped on first use, blanked the first time a slot is reached).
fn ms_grow(m: *mut Memo, k: usize) -> usize {
    var j: usize = k
    if j >= SCENE_MAX {
        j = SCENE_MAX - 1
    }
    if (*m).s == 0 {
        var probe: [MemoSlot; 2] = [memo_slot_blank(); 2]
        (*m).ssz = (&probe[1]) as u64 - (&probe[0]) as u64
        (*m).s = rt.heap_alloc(SCENE_MAX * (*m).ssz as usize)
        (*m).shi = 0
    }
    while (*m).shi <= j {
        *(((*m).s + ((*m).shi as u64) * (*m).ssz) as *mut MemoSlot) = memo_slot_blank()
        (*m).shi = (*m).shi + 1
    }
    return j
}

fn ms(m: *mut Memo, i: usize) -> *mut MemoSlot {
    var k: usize = i
    if k >= (*m).shi {
        k = ms_grow(m, k)
    }
    return ((m as u64) +% ((*m).s -% (m as u64) +% (k as u64) * (*m).ssz)) as *mut MemoSlot
}

// Give the memo's slots back (the memo is empty and usable afterwards).
fn memo_free(m: *mut Memo) {
    if (*m).s != 0 {
        rt.heap_free((*m).s, SCENE_MAX * (*m).ssz as usize)
    }
    (*m).s = 0
    (*m).shi = 0
}

fn memo_clear(m: *mut Memo) {
    var i: usize = 0
    while i < (*m).shi {
        (*ms(m, i)).key = 0
        (*ms(m, i)).skey = 0
        (*ms(m, i)).lk = 0
        (*ms(m, i)).lkin = 0
        i = i + 1
    }
    (*m).hits = 0
    (*m).misses = 0
    (*m).shits = 0
    (*m).smisses = 0
    (*m).bhits = 0
    (*m).bmisses = 0
    (*m).lhits = 0
    (*m).lmisses = 0
}

fn memo_hits(m: *mut Memo) -> usize { return (*m).hits }
fn memo_misses(m: *mut Memo) -> usize { return (*m).misses }
fn memo_style_hits(m: *mut Memo) -> usize { return (*m).shits }
fn memo_style_misses(m: *mut Memo) -> usize { return (*m).smisses }
fn memo_box_hits(m: *mut Memo) -> usize { return (*m).bhits }
fn memo_box_misses(m: *mut Memo) -> usize { return (*m).bmisses }
fn memo_layout_hits(m: *mut Memo) -> usize { return (*m).lhits }
fn memo_layout_misses(m: *mut Memo) -> usize { return (*m).lmisses }

// Attach a memo (0 detaches). It stays attached across scene_reset.
fn scene_attach_memo(sc: *mut Scene, m: *mut Memo) {
    (*sc).memo = m as u64
}

fn mix(h: u64, w: u64) -> u64 {
    var x: u64 = (h ^ w) *% (11400714819323198485 as u64)
    x = x ^ (x >> 29)
    return x
}

fn mix_bytes(h0: u64, p: u64, n: usize) -> u64 {
    var h: u64 = mix(h0, n as u64)
    if p == 0 {
        return h
    }
    var k: usize = 0
    while k + 8 <= n {
        h = mix(h, *((p + k as u64) as *mut u64))
        k = k + 8
    }
    var t: u64 = 0
    var sh: u64 = 0
    while k < n {
        let byte: u8 = *((p + k as u64) as *mut u8)
        t = t | ((byte as u64) << sh)
        sh = sh + 8
        k = k + 1
    }
    return mix(h, t)
}

fn mix_f64(h: u64, v: f64) -> u64 {
    var t: f64 = v
    return mix(h, *(((&t) as u64) as *mut u64))
}

fn memo_ctx(sc: *mut Scene, c: *mut render.Ctx) {
    if (*sc).memo == 0 {
        return
    }
    let m: *mut Memo = (*sc).memo as *mut Memo
    var h: u64 = mix_bytes(7, theme.theme_shape(render.ctx_theme(c)) as u64,
        (*m).shsz)
    h = mix_f64(h, render.len_of(c, 1000))
    h = mix(h, painter.painter_font(render.ctx_painter(c)))
    h = mix(h, (*sc).view_w as u64)
    (*m).ctx = h
}

// The leaf `i` from the memo: true = pw/ph are set and nothing is left
// to measure. On a miss the fingerprint is kept for memo_put.
fn memo_get(sc: *mut Scene, c: *mut render.Ctx, i: usize, pw: *mut f64,
    ph: *mut f64) -> bool {
    if (*sc).memo == 0 || i >= SCENE_MAX {
        return false
    }
    let m: *mut Memo = (*sc).memo as *mut Memo
    let nd: *mut Node = &(*nd(sc, i))
    // the widget without its outputs
    var e: widget.Widget = (*nd).e
    widget.w_place(&e, 0.0, 0.0, 0.0, 0.0)
    widget.w_set_pref(&e, 0.0, 0.0)
    var h: u64 = mix_bytes((*m).ctx, (&e) as u64, (*m).wsz)
    h = mix_bytes(h, widget.w_text(&e), widget.w_text_len(&e))
    // the font this text is set in (render.font_enter's choice)
    let sz: *mut style.StyleSet = widget.w_styleset(&e)
    let fid: usize = style.resolve_num(sz, style.SF_FONT_ID,
        (*style.styleset_base(sz)).font_id as usize, 0)
    if fid != 0 {
        h = mix(h, painter.painter_font_slot(render.ctx_painter(c), fid))
    }
    h = mix(h, (*nd).kind as u64)
    h = mix(h, (*nd).wrap as u64)
    h = mix_f64(h, (*nd).avail)
    h = mix_f64(h, (*nd).fix_w)
    h = mix_f64(h, (*nd).fix_h)
    if h == 0 {
        h = 1
    }
    (*m).cur = h
    let slot: *mut MemoSlot = &(*ms(m, i))
    if (*slot).key != h {
        (*m).misses = (*m).misses + 1
        return false
    }
    (*m).hits = (*m).hits + 1
    *pw = (*slot).pw
    *ph = (*slot).ph
    if (*nd).wrap > 0 && widget.w_text_len(&(*nd).e) != 0 {
        (*nd).lines = (*slot).lines
        widget.w_set_text_lines(&(*nd).e, (*slot).lines)
    }
    return true
}

fn memo_put(sc: *mut Scene, i: usize, pw: f64, ph: f64) {
    if (*sc).memo == 0 || i >= SCENE_MAX {
        return
    }
    let m: *mut Memo = (*sc).memo as *mut Memo
    let slot: *mut MemoSlot = &(*ms(m, i))
    (*slot).key = (*m).cur
    (*slot).pw = pw
    (*slot).ph = ph
    (*slot).lines = (*nd(sc, i)).lines
}

// THE FINGERPRINT OF A BOX: what its measure and the layout of its
// children read. Its flex values (field by field), its fixed size, and per
// child: the child's number, its measured size and flex item values, and
// the child's own layout key -- so an equal key means an equal subtree as
// far as sizes and places go. 0 = no memo (or not cacheable: a box with
// more children than KIDS_MAX).
fn box_key(sc: *mut Scene, i: usize) -> u64 {
    if (*sc).memo == 0 || i >= SCENE_MAX {
        return 0
    }
    let m: *mut Memo = (*sc).memo as *mut Memo
    let nd: *mut Node = &(*nd(sc, i))
    if (*nd).nkids > KIDS_MAX {
        return 0
    }
    let fb: *mut flex.FlexBox = &(*nd).fb
    var h: u64 = mix((*m).ctx, 0xB0C5)
    h = mix(h, (*nd).kind as u64)
    h = mix(h, (*fb).dir as u64)
    h = mix(h, (*fb).justify as u64)
    h = mix(h, (*fb).align_items as u64)
    h = mix(h, (*fb).align_content as u64)
    h = mix(h, (*fb).wrap as u64)
    h = mix(h, (*fb).gap_main as u64)
    h = mix(h, (*fb).gap_cross as u64)
    h = mix(h, (*fb).pad_l as u64)
    h = mix(h, (*fb).pad_t as u64)
    h = mix(h, (*fb).pad_r as u64)
    h = mix(h, (*fb).pad_b as u64)
    h = mix_f64(h, (*nd).fix_w)
    h = mix_f64(h, (*nd).fix_h)
    if (*nd).strict != (0 as u32) {
        h = mix(h, 0x57C1)
        if (*fb).wrap != flex.WRAP_NONE {
            h = mix_f64(h, (*nd).avail)
        }
    }
    if (*nd).grid != (0 as u32) {
        h = mix(h, grid.gs_hash(grid_pool_slot(sc, i)))
    }
    var k: usize = (*nd).first
    while k != SCENE_NONE {
        let kid: *mut Node = &(*nd(sc, k))
        h = mix(h, k as u64)
        h = mix(h, (*kid).cell)
        h = mix_f64(h, (*kid).pw)
        h = mix_f64(h, (*kid).ph)
        h = mix(h, (*kid).basis as u64)
        h = mix(h, (*kid).grow as u64)
        h = mix(h, (*kid).shrink as u64)
        h = mix(h, (*kid).min_main as u64)
        h = mix(h, (*kid).max_main as u64)
        h = mix(h, (*kid).align_self as u64)
        h = mix(h, (*kid).wrap as u64)
        if kid_extras(kid) || (*kid).fill != (0 as u32) {
            h = mix(h, (*kid).mg_l as u64)
            h = mix(h, (*kid).mg_t as u64)
            h = mix(h, (*kid).mg_r as u64)
            h = mix(h, (*kid).mg_b as u64)
            h = mix(h, (*kid).mn_w as u64)
            h = mix(h, (*kid).mx_w as u64)
            h = mix(h, (*kid).mn_h as u64)
            h = mix(h, (*kid).mx_h as u64)
            h = mix(h, (*kid).asp_w as u64)
            h = mix(h, (*kid).asp_h as u64)
            h = mix(h, (*kid).fill as u64)
        }
        h = mix(h, (*ms(m, k)).lk)
        k = (*kid).next
    }
    if h == 0 {
        h = 1
    }
    return h
}

fn memo_box_get(sc: *mut Scene, i: usize, bk: u64, pw: *mut f64,
    ph: *mut f64) -> bool {
    let m: *mut Memo = (*sc).memo as *mut Memo
    let slot: *mut MemoSlot = &(*ms(m, i))
    if (*slot).key != bk {
        (*m).bmisses = (*m).bmisses + 1
        return false
    }
    (*m).bhits = (*m).bhits + 1
    *pw = (*slot).pw
    *ph = (*slot).ph
    return true
}

fn memo_box_put(sc: *mut Scene, i: usize, bk: u64, pw: f64, ph: f64) {
    if bk == 0 {
        return
    }
    let m: *mut Memo = (*sc).memo as *mut Memo
    (*ms(m, i)).key = bk
    (*ms(m, i)).pw = pw
    (*ms(m, i)).ph = ph
}

// The layout key of node i, after it was measured: a leaf's own layout
// depends on nothing but its rectangle; a box's on its box key; a scroll
// box is never taken from the memo (its scroll position moves its content
// without any size changing) -- 0.
fn memo_set_lk(sc: *mut Scene, i: usize) {
    if (*sc).memo == 0 || i >= SCENE_MAX {
        return
    }
    let m: *mut Memo = (*sc).memo as *mut Memo
    let nd: *mut Node = &(*nd(sc, i))
    var lk: u64 = 0
    if (*nd).kind == N_VIEWPORT {
        lk = 0
    } else if (*nd).nkids == 0 {
        lk = 0x1EAF
    } else {
        lk = box_key(sc, i)
    }
    (*ms(m, i)).lk = lk
}

fn scene_measure(sc: *mut Scene, c: *mut render.Ctx) {
    if (*sc).root == SCENE_NONE {
        return
    }
    memo_ctx(sc, c)
    // REPORT INSTEAD OF WRITE. If the limits no longer fit, the
    // first write access in `fill_items` is one behind the array --
    // so it is not even begun here.
    if !scene_limits_ok() {
        (*sc).limof = (*sc).limof + 1
        return
    }
    (*sc).kidof = 0
    measure_node(sc, c, (*sc).root)
    (*sc).phase = PHASE_MEASURE
}

// ======================================================================
// PASS 3: ARRANGING
// ======================================================================
//
// From the top down: the root is given the space, and
// flex.flex_layout distributes it among the children. The rectangles that
// come out are ABSOLUTE (window coordinates) -- also inside
// a pane box, where the scroll position is already included.
// That is why `scene_hit` hits without a second calculation, and that is why
// after scrolling a renewed `scene_layout` suffices.
fn layout_node(sc: *mut Scene, c: *mut render.Ctx, i: usize, x: f64,
    y: f64, w: f64, h: f64) {
    if i == SCENE_NONE || i >= (*sc).n {
        return
    }
    let nd: *mut Node = &(*nd(sc, i))
    (*nd).x = x
    (*nd).y = y
    (*nd).w = w
    (*nd).h = h
    widget.w_place(&(*nd).e, x, y, w, h)
    // THE PANE BOX ALWAYS GETS ITS RECTANGLE -- even when it is
    // empty. Until 21.09.2026 the early return at `nkids ==
    // 0` stood BEFORE this place, and a pane box without children therefore kept
    // the rectangle that it got when it was created: its
    // bars sat somewhere other than its background, `viewport_hit` calculated
    // against an old viewport, and the clip cut off a surface
    // that no longer existed. A list that has just been filtered to empty
    // is no special case, but the normal case -- so
    // this branch now stands before the early return.
    //
    // The children then get the CONTENT as their space, shifted by
    // the scroll position.
    var ox: f64 = x
    var oy: f64 = y
    var iw: f64 = w
    var ih: f64 = h
    if (*nd).kind == N_VIEWPORT && (*nd).vp != 0 {
        let v: *mut viewport.Viewport = (*nd).vp as *mut viewport.Viewport
        viewport.viewport_set_rect(v, x, y, w, h)
        ox = viewport.viewport_content_x(v)
        oy = viewport.viewport_content_y(v)
        iw = viewport.viewport_content_w(v)
        ih = viewport.viewport_content_h(v)
    }
    // THE LAYOUT MEMO. Same key as last time (layout key + width, height
    // and the fraction of x/y the flex pass truncates) = the same places
    // for the whole subtree, only moved by (dx, dy).
    var lkin: u64 = 0
    if (*sc).memo != 0 && i < SCENE_MAX {
        let m: *mut Memo = (*sc).memo as *mut Memo
        let slot: *mut MemoSlot = &(*ms(m, i))
        let lk: u64 = (*slot).lk
        if lk != 0 && (*nd).nkids > 0 {
            lkin = mix(lk, 0x1A70)
            lkin = mix_f64(lkin, w)
            lkin = mix_f64(lkin, h)
            lkin = mix_f64(lkin, x - ((x as i64) as f64))
            lkin = mix_f64(lkin, y - ((y as i64) as f64))
            if lkin == 0 {
                lkin = 1
            }
            if (*slot).lkin == lkin {
                let dx: f64 = x - (*slot).ax
                let dy: f64 = y - (*slot).ay
                (*m).lhits = (*m).lhits + 1
                var k0: usize = (*nd).first
                while k0 != SCENE_NONE {
                    replay_node(sc, c, k0, dx, dy)
                    k0 = (*nd(sc, k0)).next
                }
                (*slot).ax = x
                (*slot).ay = y
                (*slot).aw = w
                (*slot).ah = h
                return
            }
            (*m).lmisses = (*m).lmisses + 1
        }
        (*slot).lkin = lkin
        (*slot).ax = x
        (*slot).ay = y
        (*slot).aw = w
        (*slot).ah = h
    }
    if (*nd).nkids == 0 {
        return
    }
    if (*nd).grid != (0 as u32) {
        layout_grid(sc, c, i, ox, oy, iw, ih)
        return
    }
    var items: [flex.FlexItem; 64] = [flex.flex_item(0, 0); 64]
    let n: usize = fill_items(sc, c, i, &items[0])
    var out: [layout.Rect; 64] = [layout.rect_new(0, 0, 0, 0); 64]
    var groessen: [i64; 64] = [0; 64]
    var frozen: [i64; 64] = [0; 64]
    var fb: flex.FlexBox = box_px(c, &(*nd).fb)
    flex.flex_layout(&fb,
        layout.rect_new(ox as i64, oy as i64, iw as i64, ih as i64),
        &items[0], n, &out[0], &groessen[0], &frozen[0])
    var k: usize = (*nd).first
    var j: usize = 0
    while k != SCENE_NONE && j < n {
        var rx: f64 = layout.rect_x(&out[j]) as f64
        var ry: f64 = layout.rect_y(&out[j]) as f64
        var rw: f64 = layout.rect_w(&out[j]) as f64
        var rh: f64 = layout.rect_h(&out[j]) as f64
        if kid_extras(&(*nd(sc, k))) {
            lay_adjust(c, &(*nd(sc, k)), &rx, &ry, &rw, &rh)
        }
        layout_node(sc, c, k, rx, ry, rw, rh)
        k = (*nd(sc, k)).next
        j = j + 1
    }
}

// A node below a layout-memo hit: its last rectangle, moved. A node that
// is never taken from the memo (a scroll box, a box over KIDS_MAX) is laid
// out for real at that rectangle.
fn replay_node(sc: *mut Scene, c: *mut render.Ctx, i: usize, dx: f64,
    dy: f64) {
    let m: *mut Memo = (*sc).memo as *mut Memo
    let slot: *mut MemoSlot = &(*ms(m, i))
    let nx: f64 = (*slot).ax + dx
    let ny: f64 = (*slot).ay + dy
    if (*slot).lk == 0 {
        layout_node(sc, c, i, nx, ny, (*slot).aw, (*slot).ah)
        return
    }
    let nd: *mut Node = &(*nd(sc, i))
    (*nd).x = nx
    (*nd).y = ny
    (*nd).w = (*slot).aw
    (*nd).h = (*slot).ah
    widget.w_place(&(*nd).e, nx, ny, (*slot).aw, (*slot).ah)
    (*slot).ax = nx
    (*slot).ay = ny
    var k: usize = (*nd).first
    while k != SCENE_NONE {
        replay_node(sc, c, k, dx, dy)
        k = (*nd(sc, k)).next
    }
}

fn scene_layout(sc: *mut Scene, c: *mut render.Ctx, x: f64, y: f64,
    w: f64, h: f64) {
    if (*sc).root == SCENE_NONE {
        return
    }
    // The same bracket as when measuring, for the same reason: the four
    // work arrays in `layout_node` are WORK_MAX long.
    if !scene_limits_ok() {
        (*sc).limof = (*sc).limof + 1
        return
    }
    (*sc).kidof = 0
    layout_node(sc, c, (*sc).root, x, y, w, h)
    // PARAGRAPHS: their height depends on the width they got. Measure and
    // lay out again while a width changed -- twice is the usual case (the
    // first layout gives the widths), the third round catches a row whose
    // widths moved because a height did.
    (*sc).reflows = 0
    while (*sc).reflows < 3 && para_widths(sc, c) {
        measure_node(sc, c, (*sc).root)
        (*sc).kidof = 0
        layout_node(sc, c, (*sc).root, x, y, w, h)
        (*sc).reflows = (*sc).reflows + 1
    }
    (*sc).phase = PHASE_LAYOUT
}

// ======================================================================
// PASS 4: DRAWING
// ======================================================================
//
// And HERE no size changes any more. `scene_draw` remembers before
// painting each node its measured size and compares afterwards;
// every deviation counts `drift` up. A check that reads this number
// catches the relapse into "quickly get wider while painting" before it stands
// in the picture.
// WHAT A NODE PAINTS ITSELF -- its kind, and then its own
// painter. The children come in `draw_node`, because a pane box puts
// its clip between the two.
//
// THE TRANSFORMATION IS A PERFECTLY NORMAL STYLE VALUE. If the sheet names
// `transform` for this node, its surface goes through the matrix --
// it is calculated in lib/fui/transform.fi, set up in
// sheet.decl_apply_transform_at, and painted by render.draw_widget_xf
// or wave3.draw_any_xf. Not a single line of
// matrix calculation stands here. Rotation is about the CENTRE of the node; its children
// stay where they stand -- whoever wants to rotate a whole group rotates
// the node that paints it.
//
// AND THE TRANSFORMATION DOES NOT REPLACE THE KIND. Until 21.09.2026
// there stood here a branch BEFORE the distinction of kinds: if a node had a
// matrix, it went through `render.draw_widget_xf` -- and was thereby, no matter
// what it was, a box with surface, border and font. A
// rotated checkbox lost its tick, a rotated picture
// its picture, and in the source nothing was to be seen. Now
// FIRST the kind decides and then the path:
//
//     N_BOX, N_VIEWPORT, N_TEXT   render.draw_widget_xf -- their whole
//                                 appearance IS surface, border, font.
//     N_WIDGET                    wave3.draw_any_xf, but only if
//                                 `wave3.kind_xf_ready` names the kind as ready
//                                 for it.
//     N_IMAGE, N_SVG              render.draw_widget_art_xf. Here there stood
//                                 until 22.09.2026 "painted straight,
//                                 a picture surface under a matrix
//                                 would be a second sampling" -- that
//                                 was no reason, but a
//                                 missing line: the sampling exists
//                                 in uiimage.sample_bilinear, the
//                                 way to it is
//                                 transform.tf_draw_image, and
//                                 render.fi hangs both on the same
//                                 decomposition that the straight path
//                                 also uses.
//
// What can NOT be transformed is painted UNCHANGED and the
// skipped transformation COUNTED (`scene_xform_skipped`) -- the same
// rule as with `drift` and `kidof`: a missing element is
// worse than an unrotated one, and a silent omission is
// worse than both.
fn draw_self(sc: *mut Scene, c: *mut render.Ctx, i: usize) {
    let nd: *mut Node = &(*nd(sc, i))
    // a member of a merge group has no surface of its own: the group painted it
    (*c).nobg = (*nd).no_fill
    let e: *mut widget.Widget = &(*nd).e
    let kind: u32 = (*nd).kind
    let umgeformt: bool = sheet.decl_has(&(*nd).d,
        sheet.EX_TRANSLATE | sheet.EX_SCALE | sheet.EX_ROTATE, true)
    var xf: transform.Xform = transform.xf_new()
    if umgeformt {
        sheet.decl_apply_transform_at(&(*nd).d, &xf,
            (*nd).x + (*nd).w / 2.0, (*nd).y + (*nd).h / 2.0)
    }
    if kind == N_BOX || kind == N_VIEWPORT {
        if umgeformt {
            render.draw_widget_xf(c, e, &xf)
        } else {
            render.draw_base(c, e)
        }
    } else if kind == N_TEXT {
        if umgeformt {
            render.draw_widget_xf(c, e, &xf)
        } else {
            render.draw_label(c, e)
        }
    } else if kind == N_IMAGE || kind == N_SVG {
        if umgeformt {
            render.draw_widget_art_xf(c, e, &xf)
        } else {
            render.draw_widget_art(c, e)
        }
    } else if kind == N_WIDGET {
        if umgeformt && wave3.kind_xf_ready(widget.w_kind(e)) {
            wave3.draw_any_xf(c, e, &xf)
        } else {
            if umgeformt {
                (*sc).xfof = (*sc).xfof + 1
            }
            wave3.draw_any(c, e)
        }
    }
    (*c).nobg = 0 as u32
    if (*nd).has_dr != 0 as u32 {
        let f: fn(u64, *mut render.Ctx, *mut widget.Widget) = (*nd).dr
        f((*nd).du, c, e)
    }
}

// MERGE GROUP (r70). The children of a node with `node_set_merge(k)` are one
// shape: their surfaces are painted together by lib/fui/merge.fi -- far apart
// each looks like itself, closer than k they melt into a neck -- and then
// each child paints only its content (text, icon) on top. COLOUR (r72):
// each child brings the fill it would have painted itself; when they all
// are the same the group is painted in that one colour, otherwise every
// shape keeps its own colour and the neck mixes them by distance
// (merge.merge_paint_colors). Borders and shadows of the members are not
// painted, a group has one outline. More than merge.MERGE_MAX children:
// the rest keep their own surface.
fn draw_merge_bg(sc: *mut Scene, c: *mut render.Ctx, i: usize) {
    let nd: *mut Node = &(*nd(sc, i))
    var g: merge.MergeGroup = merge.merge_new(render.len_of(c, (*nd).merge_k))
    var col: u32 = 0 as u32
    var same: bool = true
    var have: bool = false
    var k: usize = (*nd).first
    while k != SCENE_NONE {
        let ch: *mut Node = &(*nd(sc, k))
        (*ch).no_fill = 0 as u32
        if (*ch).hidden == 0 as u32 && (*ch).w > 0.0 && (*ch).h > 0.0 {
            if merge.merge_add_rect(&g, (*ch).x, (*ch).y, (*ch).w, (*ch).h,
                render.radius_of(c, &(*ch).e)) {
                (*ch).no_fill = 1 as u32
                let cc: u32 = render.fill_of(c, &(*ch).e)
                merge.merge_set_color(&g, merge.merge_count(&g) - 1, cc)
                if !have {
                    col = cc
                    have = true
                } else if cc != col {
                    same = false
                }
            }
        }
        k = (*ch).next
    }
    if have {
        if same {
            merge.merge_paint(render.ctx_painter(c), &g, col)
        } else {
            merge.merge_paint_colors(render.ctx_painter(c), &g)
        }
    }
}

// Make the children of `i` one merge group: shapes closer than `k` design
// points melt together. 0 turns it off again.
fn node_set_merge(sc: *mut Scene, i: usize, k: usize) {
    if i >= (*sc).n {
        return
    }
    (*nd(sc, i)).merge_k = k
    if k == 0 {
        var c: usize = (*nd(sc, i)).first
        while c != SCENE_NONE {
            (*nd(sc, c)).no_fill = 0 as u32
            c = (*nd(sc, c)).next
        }
    }
}

// A NODE WITH ITS EFFECTS: offset and opacity of its subtree around the
// plain paint. The offset moves the rectangles of the whole subtree for
// the length of the paint and back -- so custom painters, text and
// children all see the moved place, and the drift guard compares like
// with like.
fn draw_node(sc: *mut Scene, c: *mut render.Ctx, i: usize) {
    if i == SCENE_NONE || i >= (*sc).n {
        return
    }
    let nd: *mut Node = &(*nd(sc, i))
    if (*sc).dmode == 1 as u32 && (*nd).live != 0 as u32 {
        return
    }
    let a: u32 = (*nd).alpha
    if a == 0 as u32 || (*nd).hidden != 0 as u32 {
        return
    }
    // NOTHING OF IT CAN BE SEEN: its ink bounds miss the clip.
    if (*sc).cull != 0 as u32 && (*nd).bxf == 0 as u32 {
        let cv: *mut canvas.Canvas = painter.painter_canvas(render.ctx_painter(c))
        if (*nd).bx1 <= canvas.clip_x0(cv) || (*nd).bx0 >= canvas.clip_x1(cv)
        || (*nd).by1 <= canvas.clip_y0(cv) || (*nd).by0 >= canvas.clip_y1(cv) {
            (*sc).culled = (*sc).culled + 1
            return
        }
    }
    // design points to whole pixels (a text half a pixel off is blurred)
    let k: f64 = render.len_of(c, 1000) / 1000.0
    let dx: f64 = round_px((*nd).off_x * k)
    let dy: f64 = round_px((*nd).off_y * k)
    let moved: bool = dx != 0.0 || dy != 0.0
    if moved {
        shift_tree(sc, i, dx, dy)
    }
    if a >= 255 as u32 {
        draw_plain(sc, c, i)
    } else {
        let z: *mut painter.Painter = render.ctx_painter(c)
        let ok: bool = layer.group_begin(z, (*nd).x, (*nd).y, (*nd).w,
            (*nd).h, render.len_of(c, 64))
        draw_plain(sc, c, i)
        layer.group_end(z, a)
    }
    if moved {
        shift_tree(sc, i, 0.0 - dx, 0.0 - dy)
    }
}

fn round_px(v: f64) -> f64 {
    if v < 0.0 {
        return 0.0 - round_px(0.0 - v)
    }
    return ((v + 0.5) as i64) as f64
}

fn shift_tree(sc: *mut Scene, i: usize, dx: f64, dy: f64) {
    let nd: *mut Node = &(*nd(sc, i))
    (*nd).x = (*nd).x + dx
    (*nd).y = (*nd).y + dy
    // the ink bounds move with the paint, so a culled test inside a
    // moved group compares like with like
    (*nd).bx0 = (*nd).bx0 + dx
    (*nd).by0 = (*nd).by0 + dy
    (*nd).bx1 = (*nd).bx1 + dx
    (*nd).by1 = (*nd).by1 + dy
    widget.w_place(&(*nd).e, widget.w_x(&(*nd).e) + dx,
        widget.w_y(&(*nd).e) + dy, widget.w_w(&(*nd).e), widget.w_h(&(*nd).e))
    var k: usize = (*nd).first
    while k != SCENE_NONE {
        shift_tree(sc, k, dx, dy)
        k = (*nd(sc, k)).next
    }
}

fn draw_plain(sc: *mut Scene, c: *mut render.Ctx, i: usize) {
    if i == SCENE_NONE || i >= (*sc).n {
        return
    }
    let nd: *mut Node = &(*nd(sc, i))
    let rx: f64 = (*nd).x
    let ry: f64 = (*nd).y
    let rw: f64 = (*nd).w
    let rh: f64 = (*nd).h
    // WHAT HAS NO SURFACE IS NOT PAINTED. A node with width
    // or height zero has got no rectangle -- either because its
    // box could no longer distribute it (scene_kid_overflow) or
    // because it is empty. Sending it through `draw_self` nevertheless
    // means painting it at (0,0): a border, a focus ring, a
    // shadow then stand in the top left corner of the window without
    // anybody having put it there.
    if rw <= 0.0 || rh <= 0.0 || (*nd).hidden != 0 as u32 {
        return
    }
    let kind: u32 = (*nd).kind
    if kind == N_VIEWPORT && (*nd).vp != 0 {
        let v: *mut viewport.Viewport = (*nd).vp as *mut viewport.Viewport
        // The background of the viewport is painted BEFORE the clip, the bars
        // AFTER -- otherwise the box would cut off its own bars.
        render.draw_base(c, &(*nd).e)
        if viewport.viewport_begin(c, v) {
            if (*nd).has_dr != 0 as u32 {
                let f: fn(u64, *mut render.Ctx, *mut widget.Widget) =
                (*nd).dr
                f((*nd).du, c, &(*nd).e)
            }
            var k: usize = (*nd).first
            while k != SCENE_NONE {
                draw_node(sc, c, k)
                k = (*nd(sc, k)).next
            }
            viewport.viewport_end(c, v)
        }
        viewport.viewport_draw_bars(c, v)
    } else {
        draw_self(sc, c, i)
        if (*nd).merge_k > 0 {
            draw_merge_bg(sc, c, i)
        }
        var k: usize = (*nd).first
        while k != SCENE_NONE {
            draw_node(sc, c, k)
            k = (*nd(sc, k)).next
        }
    }
    // ================================================== THE GUARD
    //
    // Compared is against what passes 2 and 3 left behind:
    // the measured size (`mw`/`mh`) and the arranged rectangle. It is asked
    // at THREE places, because a node can make itself wider in three ways -- at the node, at
    // the widget (`w_set_pref`, so a second measuring when painting) and at
    // the surface (`w_place`, so a shifting when painting). Each
    // of them makes the picture depend on the drawing order; each
    // counts here ONCE.
    if (*nd).pw != (*nd).mw || (*nd).ph != (*nd).mh
    || widget.w_pref_w(&(*nd).e) != (*nd).mw
    || widget.w_pref_h(&(*nd).e) != (*nd).mh
    || (*nd).x != rx || (*nd).y != ry
    || (*nd).w != rw || (*nd).h != rh
    || widget.w_x(&(*nd).e) != rx || widget.w_y(&(*nd).e) != ry
    || widget.w_w(&(*nd).e) != rw || widget.w_h(&(*nd).e) != rh {
        (*sc).drift = (*sc).drift + 1
    }
}

// ONE NODE AND WHAT IS UNDER IT, painted on its own (after scene_draw
// laid the picture out). The drift guard counts as in scene_draw; a
// subtree inside a scroll area is painted without that area's clip.
fn scene_draw_subtree(sc: *mut Scene, c: *mut render.Ctx, i: usize) {
    if i == SCENE_NONE || i >= (*sc).n {
        return
    }
    cull_bounds(sc, c)
    draw_node(sc, c, i)
}

// THE PAGE WITHOUT ITS LIVE NODES (node_set_live) -- what a program
// bakes once (layer.Bake) and copies every frame, painting only
// scene_draw_live over it.
fn scene_draw_still(sc: *mut Scene, c: *mut render.Ctx) {
    (*sc).dmode = 1 as u32
    scene_draw(sc, c)
    (*sc).dmode = 0 as u32
}

// ONLY THE LIVE NODES, each with everything in it. Offset and opacity of
// the nodes AROUND a live node are not applied (it is painted where the
// layout put it) -- a live node inside a fading group waits until the
// fade is over, or the page paints everything (scene_draw) meanwhile.
fn scene_draw_live(sc: *mut Scene, c: *mut render.Ctx) {
    if (*sc).root == SCENE_NONE {
        return
    }
    cull_bounds(sc, c)
    live_walk(sc, c, (*sc).root)
}

fn live_walk(sc: *mut Scene, c: *mut render.Ctx, i: usize) {
    if i == SCENE_NONE || i >= (*sc).n {
        return
    }
    let nd: *mut Node = &(*nd(sc, i))
    if (*nd).hidden != 0 as u32 {
        return
    }
    if (*nd).live != 0 as u32 {
        draw_node(sc, c, i)
        return
    }
    var k: usize = (*nd).first
    while k != SCENE_NONE {
        live_walk(sc, c, k)
        k = (*nd(sc, k)).next
    }
}

fn scene_draw(sc: *mut Scene, c: *mut render.Ctx) {
    if (*sc).root == SCENE_NONE {
        return
    }
    (*sc).drift = 0
    (*sc).xfof = 0
    cull_bounds(sc, c)
    draw_node(sc, c, (*sc).root)
    (*sc).phase = PHASE_DRAW
}

// ======================================================================
// CULLING: WHAT CANNOT BE SEEN IS NOT PAINTED (docs/APP-TREE.md 4.4)
// ======================================================================
//
// Before a paint every subtree gets its INK BOUNDS: its rectangle grown
// by how far its paint may reach past it, joined with its children's.
// draw_node skips a subtree whose bounds miss the canvas clip -- a
// scrolled-away list row, a card below the window. The picture stays the
// same octets (tools/fui/dom_main.fi paints both ways and compares).
//
// HOW FAR PAINT REACHES PAST A RECTANGLE: 40 points for the focus ring,
// a text's overhang and the theme's drop shadow (plus twice its blur
// radius), plus what the style adds -- a box shadow's lift and twice its
// blur, a text shadow's offset, an outline. Some paint cannot be bounded
// here at all: a transform (it moves the node anywhere), an offset
// (node_set_offset; it shifts during the paint), and a custom painter
// that did not announce its overflow (node_set_ink). Such a node is
// always painted, and so is every ancestor of it -- its own children
// can still be skipped.
//
// The fold runs from the back: a child always has a higher number than
// its parent (scene_add appends), so one pass sees every child first.
// Points of paint past a rectangle that every node may have (a text's overhang,
// anti-aliasing, the offset of the focus ring) on top of focus width and shadow.
const INK_BASE: f64 = 14.0
// A PLAIN BUTTON (no custom painter, no box shadow) paints nothing but its box
// and a focus ring (2 gap + focus_w): anti-aliasing 2 + that. It casts no
// elevation shadow either, so the theme's shadow reach is not added (W6:
// a hover repaints ~1.5x the button, not ~4x).
const INK_FLAT: f64 = 4.0

fn ink_margin(sc: *mut Scene, c: *mut render.Ctx, nd: *mut Node) -> f64 {
    let fo: *mut theme.Shape = theme.theme_shape(render.ctx_theme(c))
    var m: f64 = INK_BASE + ((*fo).focus_w as f64) + 2.0 * ((*fo).shadow_r as f64)
    let st: *mut style.Style = widget.w_style(&(*nd).e)
    if widget.w_kind(&(*nd).e) == widget.KIND_BUTTON && (*nd).has_dr == 0 as u32
    && ((*st).set_mask & style.SF_BOX_SHADOW) == 0 as u32 {
        m = INK_FLAT + ((*fo).focus_w as f64)
    }
    if ((*st).set_mask & style.SF_BOX_SHADOW) != 0 as u32 {
        var lift: f64 = (*st).bs_lift as f64
        if lift < 0.0 {
            lift = 0.0 - lift
        }
        m = m + lift + 2.0 * ((*st).bs_blur as f64)
    }
    var sx: f64 = (*st).sh_dx as f64
    var sy: f64 = (*st).sh_dy as f64
    if sx < 0.0 { sx = 0.0 - sx }
    if sy < 0.0 { sy = 0.0 - sy }
    if sy > sx { sx = sy }
    m = m + sx + ((*st).out_w as f64)
    if (*nd).has_dr != 0 as u32 && (*nd).ink > 0.0 {
        m = m + (*nd).ink
    }
    return m * render.len_of(c, 1000) / 1000.0
}

fn cull_bounds(sc: *mut Scene, c: *mut render.Ctx) {
    (*sc).culled = 0
    if (*sc).cull == 0 as u32 {
        return
    }
    var k: usize = 0
    while k < (*sc).n {
        let nd: *mut Node = &(*nd(sc, k))
        let m: f64 = ink_margin(sc, c, nd)
        (*nd).bx0 = (*nd).x - m
        (*nd).by0 = (*nd).y - m
        (*nd).bx1 = (*nd).x + (*nd).w + m
        (*nd).by1 = (*nd).y + (*nd).h + m
        (*nd).bxf = 0 as u32
        if ((*nd).has_dr != 0 as u32 && (*nd).ink < 0.0)
        || (*nd).off_x != 0.0 || (*nd).off_y != 0.0
        || sheet.decl_has(&(*nd).d,
            sheet.EX_TRANSLATE | sheet.EX_SCALE | sheet.EX_ROTATE, true) {
            (*nd).bxf = 1 as u32
        }
        k = k + 1
    }
    var i: usize = (*sc).n
    while i > 0 {
        i = i - 1
        let nd: *mut Node = &(*nd(sc, i))
        let p: usize = (*nd).parent
        if p != SCENE_NONE && p < i {
            let pn: *mut Node = &(*nd(sc, p))
            if (*nd).bx0 < (*pn).bx0 { (*pn).bx0 = (*nd).bx0 }
            if (*nd).by0 < (*pn).by0 { (*pn).by0 = (*nd).by0 }
            if (*nd).bx1 > (*pn).bx1 { (*pn).bx1 = (*nd).bx1 }
            if (*nd).by1 > (*pn).by1 { (*pn).by1 = (*nd).by1 }
            if (*nd).bxf != 0 as u32 { (*pn).bxf = 1 as u32 }
        }
    }
}

// HOW FAR A CUSTOM PAINTER (node_set_draw) PAINTS PAST THE NODE, design
// points. Without this call such a node is never culled.
fn node_set_ink(sc: *mut Scene, i: usize, pts: f64) {
    if i >= (*sc).n {
        return
    }
    (*nd(sc, i)).ink = pts
}

// Culling on (the default) or off -- off paints every node, as before.
fn scene_set_cull(sc: *mut Scene, on: bool) {
    if on { (*sc).cull = 1 as u32 } else { (*sc).cull = 0 as u32 }
}

// How many subtrees the last paint skipped.
fn scene_culled(sc: *mut Scene) -> usize { return (*sc).culled }

// ======================================================================
// HIT AND SEARCH
// ======================================================================
//
// What is looked for is the TOPMOST node under the point, so the one painted
// last -- that is why the child list is read backwards. If the
// node lies in a pane box, the point must ALSO lie in its
// visible viewport: what is cut off cannot be
// clicked. The scroll position already sits in the rectangles (see
// pass 3).
fn hit_node(sc: *mut Scene, i: usize, px: f64, py: f64) -> usize {
    if i == SCENE_NONE || i >= (*sc).n {
        return SCENE_NONE
    }
    let nd: *mut Node = &(*nd(sc, i))
    if (*nd).hidden != 0 as u32 {
        return SCENE_NONE
    }
    if (*nd).kind == N_VIEWPORT && (*nd).vp != 0 {
        let v: *mut viewport.Viewport = (*nd).vp as *mut viewport.Viewport
        var cx: f64 = 0.0
        var cy: f64 = 0.0
        if !viewport.viewport_hit(v, px, py, &cx, &cy) {
            return SCENE_NONE
        }
    }
    if px < (*nd).x || py < (*nd).y || px >= (*nd).x + (*nd).w
    || py >= (*nd).y + (*nd).h {
        return SCENE_NONE
    }
    // Backwards: the last child lies on top.
    var best: usize = SCENE_NONE
    var k: usize = (*nd).first
    while k != SCENE_NONE {
        let t: usize = hit_node(sc, k, px, py)
        if t != SCENE_NONE {
            best = t
        }
        k = (*nd(sc, k)).next
    }
    if best != SCENE_NONE {
        return best
    }
    return i
}

fn scene_hit(sc: *mut Scene, px: f64, py: f64) -> usize {
    return hit_node(sc, (*sc).root, px, py)
}

// ======================================================================
// THE TREE BECOMES OPERABLE -- via lib/fui/control.fi, not next to it
// ======================================================================
//
// A described tree was until 23.09.2026 only a PICTURE: it was painted,
// not operated. The operation does exist already, though, in
// control.fi (hover, press, release, focus chain, dragging) --
// it knew only widgets that lie densely in an array. The widgets
// of this tree lie one each in a node. So the panel gets
// the distance of two nodes (`panel_attach_stride`) and the
// hit question from here (`panel_set_hit`) -- and thereby there is
// still exactly ONE operation.
//
// WHY THE HIT QUESTION COMES FROM HERE. control.fi searches from back
// to front for the first widget whose rectangle contains the point.
// In the tree that would be wrong: a row that in the pane box has scrolled
// up and away lies with its rectangle UNDER the toolbar,
// but is cut off -- it must not get a click. `scene_hit`
// knows that (it asks the viewport), so it answers. Only N_WIDGET nodes
// are hit: a box or a text is no operation, and a press on it must give it
// no focus.
fn scene_bind_panel(sc: *mut Scene, s: *mut control.Panel) {
    let a: u64 = (&(*nd(sc, 0)).e) as u64
    let b: u64 = (&(*nd(sc, 1)).e) as u64
    control.panel_attach_stride(s, a, (*sc).n, (b - a) as usize)
    control.panel_set_hit(s, sc as u64, scene_panel_hit)
}

// Which node carries this widget? SCENE_NONE if none.
fn scene_node_of(sc: *mut Scene, e: *mut widget.Widget) -> usize {
    let a: u64 = (&(*nd(sc, 0)).e) as u64
    let b: u64 = (&(*nd(sc, 1)).e) as u64
    let p: u64 = e as u64
    if p < a {
        return SCENE_NONE
    }
    let i: usize = ((p - a) / (b - a)) as usize
    if i >= (*sc).n {
        return SCENE_NONE
    }
    return i
}

fn scene_panel_hit(zx: u64, e: *mut widget.Widget, x: f64,
    y: f64) -> bool {
    let sc: *mut Scene = zx as *mut Scene
    let i: usize = scene_node_of(sc, e)
    if i == SCENE_NONE || (*nd(sc, i)).kind != N_WIDGET {
        return false
    }
    if !widget.w_hits(e, x, y) {
        return false
    }
    let h: usize = hit_node(sc, (*sc).root, x, y)
    if h == i {
        return true
    }
    // A button that carries children (mobile tile, chip, nav item): a hit on
    // any descendant is a hit on the button, unless a nested button sits between.
    if widget.w_kind(e) != widget.KIND_BUTTON {
        return false
    }
    var k: usize = h
    while k != SCENE_NONE && k < (*sc).n {
        if k == i {
            return true
        }
        if (*nd(sc, k)).kind == N_WIDGET && widget.w_kind(&(*nd(sc, k)).e) == widget.KIND_BUTTON {
            return false
        }
        k = (*nd(sc, k)).parent
    }
    return false
}

// THE PANE BOX UNDER THE POINTER -- for the mouse wheel and the
// arrow keys. From the hit node upwards until one is a
// pane box. SCENE_NONE: the pointer stands over none.
fn scene_viewport_at(sc: *mut Scene, x: f64, y: f64) -> usize {
    var i: usize = scene_hit(sc, x, y)
    while i != SCENE_NONE && i < (*sc).n {
        if (*nd(sc, i)).kind == N_VIEWPORT && (*nd(sc, i)).vp != 0 {
            return i
        }
        i = (*nd(sc, i)).parent
    }
    return SCENE_NONE
}

fn scene_find_id(sc: *mut Scene, id: u32) -> usize {
    var i: usize = 0
    while i < (*sc).n {
        if (*nd(sc, i)).id == id {
            return i
        }
        i = i + 1
    }
    return SCENE_NONE
}

// ======================================================================
// THE FOUR PASSES, IN THEIR ORDER
// ======================================================================
//
// THE ORDER IS THE WHOLE POINT OF THIS MODULE -- and until here
// it was a matter of courtesy: four calls that every
// caller had to write down himself in the right sequence. Whoever
// forgot `scene_measure` got a picture of zero sizes; whoever forgot
// `scene_style` got a picture without a style sheet -- both without an
// error message, both to be seen only in the proof.
//
// `scene_run` makes ONE sentence of the four: describe, then
// let run. Nothing is calculated here that does not already stand above;
// the four functions stay individually reachable, because whoever wants
// to read something off between arranging and drawing (the proofs do
// exactly that) needs them separately.
fn scene_run(sc: *mut Scene, c: *mut render.Ctx, sh: *mut sheet.Sheet,
    x: f64, y: f64, w: f64, h: f64) {
    scene_style(sc, sh)
    scene_measure(sc, c)
    scene_layout(sc, c, x, y, w, h)
    scene_draw(sc, c)
}

// ======================================================================
// DAMAGE: WHERE DID A NODE LAST PAINT? (lib/fui/damage.fi)
// ======================================================================
//
// The ink bounds of node i from the last paint (cull_bounds): its rectangle
// grown by the reach of its shadow, focus ring and text, joined with its
// children's. out = x0, y0, x1, y1. False when they cannot be trusted: no
// culling, a node out of range, or a subtree with a transform / offset /
// custom painter that did not announce its overflow -- repaint everything.
fn scene_ink_rect(sc: *mut Scene, i: usize, out: *mut [f64; 4]) -> bool {
    if (*sc).cull == 0 as u32 || i >= (*sc).n || (*sc).phase != PHASE_DRAW {
        return false
    }
    let nd: *mut Node = &(*nd(sc, i))
    if (*nd).bxf != 0 as u32 {
        return false
    }
    (*out)[0] = (*nd).bx0
    (*out)[1] = (*nd).by0
    (*out)[2] = (*nd).bx1
    (*out)[3] = (*nd).by1
    return true
}

// r444: the damage rectangle of a node that ONLY ROTATES (about its centre): the square around the circle that holds the box at every
// angle, so the same rectangle covers the old and the new picture. False for any other transform, an offset, a transformed ancestor, a
// custom painter or a node out of range -- the caller then repaints everything. Valid after the layout of the frame.
fn scene_rot_bounds(sc: *mut Scene, c: *mut render.Ctx, i: usize, out: *mut [f64; 4]) -> bool {
    if i >= (*sc).n {
        return false
    }
    let nd: *mut Node = &(*nd(sc, i))
    if !sheet.decl_has(&(*nd).d, sheet.EX_ROTATE, true) {
        return false
    }
    if sheet.decl_has(&(*nd).d, sheet.EX_TRANSLATE | sheet.EX_SCALE, true) {
        return false
    }
    if (*nd).off_x != 0.0 || (*nd).off_y != 0.0 || (*nd).has_dr != 0 as u32 {
        return false
    }
    var p: usize = (*nd).parent
    while p != SCENE_NONE && p < (*sc).n {
        let pn: *mut Node = &(*nd(sc, p))
        if (*pn).off_x != 0.0 || (*pn).off_y != 0.0
        || sheet.decl_has(&(*pn).d, sheet.EX_TRANSLATE | sheet.EX_SCALE | sheet.EX_ROTATE, true) {
            return false
        }
        p = (*pn).parent
    }
    var big: f64 = (*nd).w
    var small: f64 = (*nd).h
    if small > big {
        big = (*nd).h
        small = (*nd).w
    }
    // sqrt(a^2 + b^2) <= a + 0.4143 b for b <= a (convex in b, tight at b = a)
    let half: f64 = 0.5 * (big + 0.4143 * small) + ink_margin(sc, c, nd) + 2.0
    let cx: f64 = (*nd).x + (*nd).w / 2.0
    let cy: f64 = (*nd).y + (*nd).h / 2.0
    (*out)[0] = cx - half
    (*out)[1] = cy - half
    (*out)[2] = cx + half
    (*out)[3] = cy + half
    return true
}

// A fingerprint of the geometry of all nodes (x, y, w, h). A partial repaint
// is only right if the layout did not move anything outside the damage:
// compare the value before and after the layout of the frame.
fn scene_geom_hash(sc: *mut Scene) -> u64 {
    var h: u64 = 1469598103934665603
    var k: usize = 0
    while k < (*sc).n {
        let nd: *mut Node = &(*nd(sc, k))
        h = ((h << 13) | (h >> 51)) ^ (((*nd).x * 64.0) as i64 as u64)
        h = ((h << 13) | (h >> 51)) ^ (((*nd).y * 64.0) as i64 as u64)
        h = ((h << 13) | (h >> 51)) ^ (((*nd).w * 64.0) as i64 as u64)
        h = ((h << 13) | (h >> 51)) ^ (((*nd).h * 64.0) as i64 as u64)
        k = k + 1
    }
    return h
}

// Style, measure and layout as scene_run does -- but report whether the
// geometry of any node moved. True = nothing moved, so a paint under a
// clip of the damaged rectangle gives the same picture as a full paint.
fn scene_layout_stable(sc: *mut Scene, c: *mut render.Ctx, sh: *mut sheet.Sheet,
    x: f64, y: f64, w: f64, h: f64) -> bool {
    let h0: u64 = scene_geom_hash(sc)
    scene_style(sc, sh)
    scene_measure(sc, c)
    scene_layout(sc, c, x, y, w, h)
    return scene_geom_hash(sc) == h0
}
