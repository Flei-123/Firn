// SPDX-License-Identifier: MPL-2.0
import std.rt

export { EV_NONE, EV_OPENED, EV_SAVED, EV_CLIP, push, next, pending, clear }

const SLOTS: usize = 8
const CELL: usize = 64
const EV_NONE: u32 = 0
const EV_OPENED: u32 = 1
const EV_SAVED: u32 = 2
const EV_CLIP: u32 = 3

static mut Q_KIND: [u64; 8] = [0; 8]
static mut Q_STATUS: [u64; 8] = [0; 8]
static mut Q_NAME: [u64; 8] = [0; 8]
static mut Q_DATA: [u64; 8] = [0; 8]
static mut Q_HEAD: usize = 0
static mut Q_COUNT: usize = 0

fn cell_with(p: u64, n: usize) -> u64 {
    let cell: *mut rt.Buf = rt.heap_alloc(CELL) as *mut rt.Buf
    *cell = rt.buf_new()
    rt.buf_push_bytes(cell, p, n)
    return cell as u64
}

fn cell_take(addr: u64, out: *mut rt.Buf) {
    let cell: *mut rt.Buf = addr as *mut rt.Buf
    *out = *cell
    rt.heap_free(addr, CELL)
}

fn push(kind: u32, status: u32, name: str, p: u64, n: usize) -> bool {
    if Q_COUNT >= SLOTS {
        return false
    }
    let at: usize = (Q_HEAD + Q_COUNT) % SLOTS
    Q_KIND[at] = kind as u64
    Q_STATUS[at] = status as u64
    Q_NAME[at] = cell_with(name.p as u64, name.n)
    Q_DATA[at] = cell_with(p, n)
    Q_COUNT = Q_COUNT + 1
    return true
}

fn next(kind: *mut u32, status: *mut u32, name: *mut rt.Buf, data: *mut rt.Buf) -> bool {
    if Q_COUNT == 0 {
        return false
    }
    let at: usize = Q_HEAD
    *kind = Q_KIND[at] as u32
    *status = Q_STATUS[at] as u32
    cell_take(Q_NAME[at], name)
    cell_take(Q_DATA[at], data)
    Q_HEAD = (Q_HEAD + 1) % SLOTS
    Q_COUNT = Q_COUNT - 1
    return true
}

fn pending() -> usize {
    return Q_COUNT
}

fn clear() {
    var kind: u32 = 0 as u32
    var status: u32 = 0 as u32
    var name: rt.Buf = rt.buf_new()
    var data: rt.Buf = rt.buf_new()
    while next(&kind, &status, &name, &data) {
        rt.buf_free(&name)
        rt.buf_free(&data)
    }
}
