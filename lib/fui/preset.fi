// SPDX-License-Identifier: MPL-2.0
// lib/fui/preset.fi -- THE SKINS OF lib/fui/screen.fi: ONE FUNCTION PER LOOK, ONE CALL IN THE APP.
//
//     screen.run(start, "FleiLauncher", 1100, 700, 0, paint, press, key, preset.launcher)
//
// A skin sets everything a look consists of -- the colour set (lib/fui/palette.fi: dark AND
// light), the accent, the sidebar geometry -- so an application carries no token lines.
//   launcher   the FleiLauncher: navy ground, green accent, soft inset sidebar rows
//   studio     the productivity apps (notes, settings, form): slate ground, blue accent
//   messenger  the chat: blue accent, navy / white grounds
// `look(m, id, dark, rgb)` re-applies a look with another accent (a live theme switch).
import fui.theme
import fui.kit
import fui.kitcolor
import fui.palette

export { launcher, studio, messenger, look }

fn nav_of(id: usize) {
    if id == palette.LAUNCHER {
        kit.nav_look(12, 18, 42, 14, true)
    } else if id == palette.STUDIO {
        kit.nav_look(14, 29, 37, 14, true)
        kit.nav_gap(2)
    } else {
        kit.nav_look(8, 8, 40, 12, false)
    }
}

fn look(m: *mut theme.Theme, id: usize, dark: bool, rgb: u32) {
    kitcolor.set_accent(rgb)
    kitcolor.kit_theme(m, dark)
    palette.apply(m, id, dark)
    nav_of(id)
}

fn skin(m: *mut theme.Theme, id: usize, dark: bool) {
    look(m, id, dark, palette.accent_of(id, dark))
}

fn launcher(m: *mut theme.Theme, dark: bool) { skin(m, palette.LAUNCHER, dark) }
fn studio(m: *mut theme.Theme, dark: bool) { skin(m, palette.STUDIO, dark) }
fn messenger(m: *mut theme.Theme, dark: bool) { skin(m, palette.MESSENGER, dark) }
