// SPDX-License-Identifier: MPL-2.0
// lib/fui/sheet.fi -- THE STYLE SHEET: SELECTOR -> STYLE VALUES.
//
// ===================================================== WHY IT EXISTS
//
// Until here EVERY widget carried its style itself: whoever wanted twenty buttons
// to look alike called `style_set_bg` twenty times. That is
// the state in which HTML was before CSS, and it has exactly the consequence
// that it had there: the twenty-first element looks different, because
// somebody forgot a line.
//
// This module reverses the direction. You write ONCE a rule
//
//     "everything with the class `knopf` gets this background"
//
// and every node to which the selector fits fetches the value itself.
//
// ================================================ WHAT IS NOT HERE
//
// 1. NO CSS READER. The sheet is built IN THE SOURCE (`sheet_add`).
//    A text parser for CSS already exists in lib/browser; a second
//    would be the second place for the same thing, and that is expressly
//    forbidden in this tree.
// 2. NO SECOND SET OF STYLE VALUES. A `Decl` carries a
//    `style.Style` -- the same that every widget already has, together with its
//    `set_mask`. Thereby "this value is set" is
//    explained at ONE place, and the rule "later rule wins" is nothing
//    more than the overwriting of fields whose bit is set.
// 3. NO TIME AND NO MATRIX. `transition` and `transform` are here
//    only VALUES. What becomes of them is calculated by lib/fui/anim.fi or
//    lib/fui/transform.fi -- this module passes the numbers through.
// 4. NO TREE. This module knows no node and no child. It
//    gets a CHAIN of `NodeDesc` (root first, the node
//    itself last) and answers from it the question "which values
//    apply". The tree stands in lib/fui/scene.fi, and the dependency
//    points in one direction only: scene -> sheet.
//
// ==================================================== THE PRECEDENCE
//
// As in CSS, and for the same reason: it must be CALCULABLE which
// of two contradicting rules applies -- not "the one that happened to
// run last".
//
//     id                        counts 10000
//     class and state           counts   100
//     kind                      counts     1
//
// The parts of an ancestor ("class A inside class B") count
// ALONG -- a nested selector is more specific than the same
// selector without an ancestor. At equal rank the rule written LATER
// wins; that is why every rule carries its running number.
//
// ===================================================== THE INHERITANCE
//
// A child inherits from the parent EXACTLY FIVE values: font family
// (`SF_FONT_ID`), font size (`SF_FONT_PX`), font colour (`SF_FG`),
// line height (`SF_LINE_HEIGHT`) and writing direction (`SF_DIRECTION`,
// since 23.09.2026) -- and only if it itself says
// nothing about it. Everything else is NOT inherited: a background that
// is inherited paints every box of a container once more, and the
// border of the parent would sit around every child. That is the same
// limit that CSS draws.
export {
    // --- Names
    sheet_name,
    // --- Auswahl
    Sel, sel_any, sel_kind, sel_id, sel_class,
    sel_with_class, sel_with_state, sel_within_class,
    sel_within_kind, sel_within_id,
    sel_specificity, sel_class_overflow,
    KIND_ANY, ID_ANY, STATE_ANY, SEL_CLASS_MAX,
    // --- Values
    Decl, decl_new, decl_style, decl_set_style,
    decl_set_transition, decl_transition_ms, decl_transition_ease,
    decl_set_translate, decl_set_scale, decl_set_rotate,
    decl_tx, decl_ty, decl_sx, decl_sy, decl_rot,
    decl_has, decl_merge, decl_inherit,
    EX_TRANSITION, EX_TRANSLATE, EX_SCALE, EX_ROTATE,
    INHERIT_MASK, sheet_inheritable,
    // --- The bridges: nothing is calculated here, only passed on
    decl_easing, decl_apply_transition,
    decl_apply_transform, decl_apply_transform_at,
    // --- The described node
    NodeDesc, desc_new, desc_add_class, desc_set_state, desc_class_count,
    sheet_desc_stride,
    DESC_CLASS_MAX,
    // --- The sheet
    Sheet, sheet_new, sheet_add, sheet_rule, sheet_count, sheet_sel, sheet_decl,
    sheet_match, sel_match, sheet_resolve, sheet_order, sheet_rule_overflow,
    RULE_MAX, CHAIN_MAX,
}

import fui.style
import fui.anim
import fui.transform

// ======================================================================
// NAMES
// ======================================================================
//
// Classes and ids are NUMBERS, not strings. A comparison
// of strings in the innermost loop of the rule resolution would be
// the most expensive part of drawing, and fUi gets by without an allocator --
// there is no place at which a class list could lie as text.
//
// So that you can nevertheless write `sheet_name("knopf")`, FNV-1a stands here:
// the same string gives the same number, in every program
// of this tree. 0 is reserved for "no class", so a zero
// is raised to 1.
fn sheet_name(p: u64, n: usize) -> u32 {
    var h: u32 = 2166136261 as u32
    var i: usize = 0
    while i < n {
        let b: u32 = (*((p + i as u64) as *mut u8)) as u32
        h = h ^ b
        // DELIBERATELY VIA u64. Firn catches the overflow of a
        // u32 multiplication (and that is good); FNV-1a, however, NEEDS
        // exactly this overflow. So it is calculated wide and
        // afterwards cut to 32 bits -- that is the same number
        // that every other FNV version yields.
        let wide: u64 = (h as u64) * (16777619 as u64)
        h = (wide & (4294967295 as u64)) as u32
        i = i + 1
    }
    if h == 0 as u32 {
        return 1 as u32
    }
    return h
}

// ======================================================================
// DIE AUSWAHL
// ======================================================================
const KIND_ANY: u32 = 4294967295 as u32
const ID_ANY: u32 = 0 as u32
const STATE_ANY: u32 = 255 as u32
const SEL_CLASS_MAX: usize = 4

struct Sel {
    kind: u32, // Art des Knotens, KIND_ANY = egal
    id: u32, // Kennung, ID_ANY = egal
    cls: [u32; 4], // ALLE diese Klassen muss der Knoten tragen
    ncls: usize,
    state: u32, // style.STATE_*, STATE_ANY = egal
    // --- the ancestor ("inside of"). One part suffices; all three
    // must fit the SAME ancestor.
    anc_kind: u32,
    anc_id: u32,
    anc_cls: u32,
    has_anc: u32,
    // HOW MANY CLASSES NO LONGER FITTED. A selector carries at most
    // SEL_CLASS_MAX classes; the fifth was silently swallowed by
    // `sel_with_class` until 21.09.2026 -- and a rule
    // that demands one class fewer FITS MORE nodes than
    // intended. That is the error that you see only in the picture.
    // That is why the selector counts it along, and `sel_class_overflow` hands out
    // the number. It stands IN the selector and not in a
    // global counter, because `Sel` is a value: it is copied,
    // passed on and stays with its rule in doing so.
    clsof: usize,
}

fn sel_any() -> Sel {
    return Sel { kind: KIND_ANY, id: ID_ANY, cls: [0 as u32; 4],
        ncls: 0, state: STATE_ANY, anc_kind: KIND_ANY, anc_id: ID_ANY,
        anc_cls: 0 as u32, has_anc: 0 as u32, clsof: 0 }
}

fn sel_kind(k: u32) -> Sel {
    var s: Sel = sel_any()
    s.kind = k
    return s
}

fn sel_id(id: u32) -> Sel {
    var s: Sel = sel_any()
    s.id = id
    return s
}

fn sel_class(c: u32) -> Sel {
    var s: Sel = sel_any()
    s.cls[0] = c
    s.ncls = 1
    return s
}

fn sel_with_class(s: Sel, c: u32) -> Sel {
    var o: Sel = s
    if o.ncls < SEL_CLASS_MAX {
        o.cls[o.ncls] = c
        o.ncls = o.ncls + 1
        return o
    }
    o.clsof = o.clsof + 1
    return o
}

// HOW MANY CLASSES OF THIS SELECTOR ARE MISSING. Zero means: it demands
// exactly what the caller wrote.
fn sel_class_overflow(s: *mut Sel) -> usize { return (*s).clsof }

fn sel_with_state(s: Sel, st: u32) -> Sel {
    var o: Sel = s
    o.state = st
    return o
}

fn sel_within_class(s: Sel, c: u32) -> Sel {
    var o: Sel = s
    o.anc_cls = c
    o.has_anc = 1 as u32
    return o
}

fn sel_within_kind(s: Sel, k: u32) -> Sel {
    var o: Sel = s
    o.anc_kind = k
    o.has_anc = 1 as u32
    return o
}

fn sel_within_id(s: Sel, id: u32) -> Sel {
    var o: Sel = s
    o.anc_id = id
    o.has_anc = 1 as u32
    return o
}

// THE RANK OF A SELECTOR. See head: id 10000, class and state
// 100, kind 1 -- and the parts of the ancestor count along.
fn sel_specificity(s: *mut Sel) -> i64 {
    var v: i64 = 0
    if (*s).id != ID_ANY {
        v = v + 10000
    }
    v = v + 100 * ((*s).ncls as i64)
    if (*s).state != STATE_ANY {
        v = v + 100
    }
    if (*s).kind != KIND_ANY {
        v = v + 1
    }
    if (*s).has_anc != 0 as u32 {
        if (*s).anc_id != ID_ANY {
            v = v + 10000
        }
        if (*s).anc_cls != 0 as u32 {
            v = v + 100
        }
        if (*s).anc_kind != KIND_ANY {
            v = v + 1
        }
    }
    return v
}

// ======================================================================
// THE VALUES OF A RULE
// ======================================================================
//
// `style.Style` carries the style values AND their `set_mask`. What it does not
// know are transition and transformation -- those stand next to it, with
// a small mask of their own, so that "set" means for them too what it means
// for every other value.
const EX_TRANSITION: u32 = 1
const EX_TRANSLATE: u32 = 2
const EX_SCALE: u32 = 4
const EX_ROTATE: u32 = 8

struct Decl {
    s: style.Style,
    trans_ms: i64,
    trans_ease: u32, // anim.EASE_*
    tx: f64,
    ty: f64,
    sx: f64,
    sy: f64,
    // IN DEGREES, NOT IN RADIANS. Rotation is done at the end of
    // lib/svg/matrix.fi (`mat_drehe`), and that calculates in degrees -- with
    // argument reduction, so that rotate(90) gives an exact zero. Whoever
    // here ran in radians would have to convert on the way to the matrix,
    // and that would be the second place at which an angle is
    // touched. So here stands the same unit as there.
    rot: f64,
    ex: u32,
}

fn decl_new() -> Decl {
    return Decl { s: style.style_new(), trans_ms: 0, trans_ease: 0 as u32,
        tx: 0.0, ty: 0.0, sx: 1.0, sy: 1.0, rot: 0.0, ex: 0 as u32 }
}

fn decl_style(d: *mut Decl) -> *mut style.Style { return &(*d).s }

fn decl_set_style(d: *mut Decl, s: style.Style) { (*d).s = s }

// `transition: <ms> <easing>` -- die Zahlen gehen unveraendert an
// anim.trans_set_duration / anim.easing_named.
fn decl_set_transition(d: *mut Decl, ms: i64, ease: u32) {
    (*d).trans_ms = ms
    (*d).trans_ease = ease
    (*d).ex = (*d).ex | EX_TRANSITION
}

fn decl_transition_ms(d: *mut Decl) -> i64 { return (*d).trans_ms }
fn decl_transition_ease(d: *mut Decl) -> u32 { return (*d).trans_ease }

fn decl_set_translate(d: *mut Decl, x: f64, y: f64) {
    (*d).tx = x
    (*d).ty = y
    (*d).ex = (*d).ex | EX_TRANSLATE
}

fn decl_set_scale(d: *mut Decl, x: f64, y: f64) {
    (*d).sx = x
    (*d).sy = y
    (*d).ex = (*d).ex | EX_SCALE
}

fn decl_set_rotate(d: *mut Decl, grad: f64) {
    (*d).rot = grad
    (*d).ex = (*d).ex | EX_ROTATE
}

fn decl_tx(d: *mut Decl) -> f64 { return (*d).tx }
fn decl_ty(d: *mut Decl) -> f64 { return (*d).ty }
fn decl_sx(d: *mut Decl) -> f64 { return (*d).sx }
fn decl_sy(d: *mut Decl) -> f64 { return (*d).sy }
fn decl_rot(d: *mut Decl) -> f64 { return (*d).rot }

// Is this value set? `bit` is a style.SF_* OR an EX_*; the
// two masks are separate, so `extra` says which one is meant.
fn decl_has(d: *mut Decl, bit: u32, extra: bool) -> bool {
    if extra {
        return ((*d).ex & bit) != 0 as u32
    }
    return ((*d).s.set_mask & bit) != 0 as u32
}

// ======================================================================
// THE BRIDGES: WHERE THE VALUE TAKES EFFECT
// ======================================================================
//
// Until here `transition` and `transform` were only numbers in a
// `Decl` -- and numbers that nobody collects are a claim. The
// three functions here collect them, and in such a way that in this file
// NOT ONE line of time or matrix arithmetic stands:
//
//   * The duration goes to `anim.trans_set_duration`, the curve to
//     `anim.easing_named` -- what becomes of both (Bezier, steps, spring)
//     is decided by lib/fui/anim.fi alone.
//   * Shift, scaling and rotation go to `transform.xf_*`,
//     which in turn call lib/svg/matrix.fi. No sine is touched here
//     and no matrix multiplied.
//
// That is the whole point: the style sheet SAYS what is to apply; calculation
// is done where the calculation already stands anyway.

// The curve of this transition as `anim.Easing`. If no
// `transition` is set, it is the linear curve -- the same default
// that `anim.easing_named(EASE_LINEAR)` delivers.
fn decl_easing(d: *mut Decl) -> anim.Easing {
    if ((*d).ex & EX_TRANSITION) == 0 as u32 {
        return anim.easing_named(anim.EASE_LINEAR)
    }
    return anim.easing_named((*d).trans_ease)
}

// Set the transition of a widget to what the sheet says.
// `false` means: this Decl names no `transition`, the transition
// stays untouched (and thereby keeps what it was told before).
fn decl_apply_transition(d: *mut Decl, t: *mut anim.Transition) -> bool {
    if ((*d).ex & EX_TRANSITION) == 0 as u32 {
        return false
    }
    anim.trans_set_duration(t, (*d).trans_ms)
    anim.trans_set_easing(t, anim.easing_named((*d).trans_ease))
    return true
}

// Put the transformation onto the stack, around the point (ox, oy) --
// in a surface that is the CENTRE of the node, not the corner
// of the canvas: a tile that grows under the pointer grows towards
// all sides.
//
// The order is that of CSS: first shift, then rotate, then
// scale. It is fixed here, so that two nodes with the same Decl
// do not look different. `false` means: this Decl names no
// transformation, the stack was not touched.
fn decl_apply_transform_at(d: *mut Decl, x: *mut transform.Xform,
    ox: f64, oy: f64) -> bool {
    let e: u32 = (*d).ex
    if (e & (EX_TRANSLATE | EX_SCALE | EX_ROTATE)) == 0 as u32 {
        return false
    }
    if (e & EX_TRANSLATE) != 0 as u32 {
        transform.xf_translate(x, (*d).tx, (*d).ty)
    }
    if (e & EX_ROTATE) != 0 as u32 {
        transform.xf_rotate_at(x, (*d).rot, ox, oy)
    }
    if (e & EX_SCALE) != 0 as u32 {
        transform.xf_scale(x, (*d).sx, (*d).sy, ox, oy)
    }
    return true
}

// The same transformation around the origin of the canvas. That is the case
// in which the caller has already set his origin.
fn decl_apply_transform(d: *mut Decl, x: *mut transform.Xform) -> bool {
    let e: u32 = (*d).ex
    if (e & (EX_TRANSLATE | EX_SCALE | EX_ROTATE)) == 0 as u32 {
        return false
    }
    if (e & EX_TRANSLATE) != 0 as u32 {
        transform.xf_translate(x, (*d).tx, (*d).ty)
    }
    if (e & EX_ROTATE) != 0 as u32 {
        transform.xf_rotate(x, (*d).rot)
    }
    if (e & EX_SCALE) != 0 as u32 {
        transform.xf_scale(x, (*d).sx, (*d).sy, 0.0, 0.0)
    }
    return true
}

// ======================================================================
// MERGING
// ======================================================================
//
// `dst` is the version valid so far, `src` the rule of HIGHER RANK (or
// later). It is taken over field by field and only what `src` really
// sets -- a rule that names only the font colour does not delete the background
// that another one has set. That is the whole difference
// between "style sheet" and "last call wins".
fn decl_merge(dst: *mut Decl, src: *mut Decl) {
    let m: u32 = (*src).s.set_mask
    let a: *mut style.Style = &(*dst).s
    let b: *mut style.Style = &(*src).s
    if (m & style.SF_BG) != 0 as u32 { (*a).bg = (*b).bg }
    if (m & style.SF_BORDER) != 0 as u32 {
        (*a).border = (*b).border
        (*a).border_w = (*b).border_w
    }
    if (m & style.SF_FG) != 0 as u32 { (*a).fg = (*b).fg }
    if (m & style.SF_BORDER_W) != 0 as u32 { (*a).border_w = (*b).border_w }
    if (m & style.SF_RADIUS) != 0 as u32 { (*a).radius = (*b).radius }
    if (m & style.SF_PAD_X) != 0 as u32 { (*a).pad_x = (*b).pad_x }
    if (m & style.SF_PAD_Y) != 0 as u32 { (*a).pad_y = (*b).pad_y }
    if (m & style.SF_FONT_PX) != 0 as u32 { (*a).font_px = (*b).font_px }
    if (m & style.SF_WEIGHT) != 0 as u32 { (*a).weight = (*b).weight }
    if (m & style.SF_SLANT) != 0 as u32 { (*a).slant = (*b).slant }
    if (m & style.SF_ALIGN) != 0 as u32 { (*a).align = (*b).align }
    if (m & style.SF_ALPHA) != 0 as u32 { (*a).alpha = (*b).alpha }
    if (m & style.SF_FONT_ID) != 0 as u32 { (*a).font_id = (*b).font_id }
    if (m & style.SF_TRACKING) != 0 as u32 { (*a).tracking = (*b).tracking }
    if (m & style.SF_WORD_SPACING) != 0 as u32 {
        (*a).word_spacing = (*b).word_spacing
    }
    if (m & style.SF_LINE_HEIGHT) != 0 as u32 {
        (*a).line_height = (*b).line_height
        (*a).line_h_abs = (*b).line_h_abs
    }
    if (m & style.SF_KERNING) != 0 as u32 { (*a).kerning = (*b).kerning }
    if (m & style.SF_OUTLINE) != 0 as u32 {
        (*a).out_w = (*b).out_w
        (*a).out_col = (*b).out_col
    }
    if (m & style.SF_SHADOW) != 0 as u32 {
        (*a).sh_dx = (*b).sh_dx
        (*a).sh_dy = (*b).sh_dy
        (*a).sh_col = (*b).sh_col
    }
    if (m & style.SF_GRADIENT) != 0 as u32 { (*a).grad_col = (*b).grad_col }
    // The size like every other value: field by field, and only if the
    // higher-ranking rule really names it. Width and height stand
    // INDIVIDUALLY -- a rule that fixes only the height of a row
    // must not set its width to zero.
    if (m & style.SF_WIDTH) != 0 as u32 { (*a).width = (*b).width }
    if (m & style.SF_HEIGHT) != 0 as u32 { (*a).height = (*b).height }
    if (m & style.SF_DIRECTION) != 0 as u32 { (*a).dir = (*b).dir }
    if (m & style.SF_BG_GRAD) != 0 as u32 {
        (*a).bg2 = (*b).bg2
        (*a).g_a0 = (*b).g_a0
        (*a).g_a1 = (*b).g_a1
        (*a).g_dx = (*b).g_dx
        (*a).g_dy = (*b).g_dy
    }
    if (m & style.SF_BOX_SHADOW) != 0 as u32 {
        (*a).bs_lift = (*b).bs_lift
        (*a).bs_blur = (*b).bs_blur
        (*a).bs_a = (*b).bs_a
        (*a).bs_col = (*b).bs_col
    }
    if (m & style.SF_BG_GLOW) != 0 as u32 {
        (*a).gl_col = (*b).gl_col
        (*a).gl_x = (*b).gl_x
        (*a).gl_y = (*b).gl_y
        (*a).gl_rx = (*b).gl_rx
        (*a).gl_ry = (*b).gl_ry
        (*a).gl_k = (*b).gl_k
    }
    if (m & style.SF_FLUID) != 0 as u32 {
        (*a).fl_min = (*b).fl_min
        (*a).fl_max = (*b).fl_max
        (*a).fl_base = (*b).fl_base
        (*a).fl_vw = (*b).fl_vw
    }
    (*a).set_mask = (*a).set_mask | m

    let e: u32 = (*src).ex
    if (e & EX_TRANSITION) != 0 as u32 {
        (*dst).trans_ms = (*src).trans_ms
        (*dst).trans_ease = (*src).trans_ease
    }
    if (e & EX_TRANSLATE) != 0 as u32 {
        (*dst).tx = (*src).tx
        (*dst).ty = (*src).ty
    }
    if (e & EX_SCALE) != 0 as u32 {
        (*dst).sx = (*src).sx
        (*dst).sy = (*src).sy
    }
    if (e & EX_ROTATE) != 0 as u32 {
        (*dst).rot = (*src).rot
    }
    (*dst).ex = (*dst).ex | e
}

// ======================================================================
// INHERITANCE
// ======================================================================
//
// EXACTLY FIVE values pass from the parent to the child, and only to
// where the child itself is silent. The fifth is, since
// 23.09.2026, the writing direction (style.SF_DIRECTION): a box that
// is set to RTL sets everything in it to RTL, like `dir` on the web. The limit is deliberate and is
// re-calculated with numbers in tools/fui/sheet_main.fi: the background of the
// parent must NOT arrive at the child.
// FG (4) | FONT_PX (128) | FONT_ID (4096) | LINE_HEIGHT (32768)
// | DIRECTION (4194304) = 4231300.
// The number stands there calculated out, so that tools/fui/sheet_main.fi can
// re-calculate it against the five bits.
const INHERIT_MASK: u32 = 4231300 as u32

fn sheet_inheritable(bit: u32) -> bool {
    return (INHERIT_MASK & bit) != 0 as u32
}

fn decl_inherit(child: *mut Decl, parent: *mut Decl) {
    let pm: u32 = (*parent).s.set_mask
    let cm: u32 = (*child).s.set_mask
    let a: *mut style.Style = &(*child).s
    let b: *mut style.Style = &(*parent).s
    if (pm & style.SF_FG) != 0 as u32 && (cm & style.SF_FG) == 0 as u32 {
        (*a).fg = (*b).fg
        (*a).set_mask = (*a).set_mask | style.SF_FG
    }
    if (pm & style.SF_FONT_PX) != 0 as u32
    && (cm & style.SF_FONT_PX) == 0 as u32 {
        (*a).font_px = (*b).font_px
        (*a).set_mask = (*a).set_mask | style.SF_FONT_PX
    }
    if (pm & style.SF_FONT_ID) != 0 as u32
    && (cm & style.SF_FONT_ID) == 0 as u32 {
        (*a).font_id = (*b).font_id
        (*a).set_mask = (*a).set_mask | style.SF_FONT_ID
    }
    if (pm & style.SF_LINE_HEIGHT) != 0 as u32
    && (cm & style.SF_LINE_HEIGHT) == 0 as u32 {
        (*a).line_height = (*b).line_height
        (*a).line_h_abs = (*b).line_h_abs
        (*a).set_mask = (*a).set_mask | style.SF_LINE_HEIGHT
    }
    if (pm & style.SF_DIRECTION) != 0 as u32
    && (cm & style.SF_DIRECTION) == 0 as u32 {
        (*a).dir = (*b).dir
        (*a).set_mask = (*a).set_mask | style.SF_DIRECTION
    }
}

// ======================================================================
// THE DESCRIBED NODE
// ======================================================================
//
// That is all that this module needs to know about a node. Whoever has a
// different kind of tree fills out the same sheet -- that is why no scene.Node
// hangs here in the source.
const DESC_CLASS_MAX: usize = 8

struct NodeDesc {
    kind: u32,
    id: u32,
    cls: [u32; 8],
    ncls: usize,
    state: u32,
}

fn desc_new(kind: u32, id: u32) -> NodeDesc {
    return NodeDesc { kind: kind, id: id, cls: [0 as u32; 8], ncls: 0,
        state: style.STATE_NORMAL }
}

fn desc_add_class(d: *mut NodeDesc, c: u32) -> bool {
    if (*d).ncls >= DESC_CLASS_MAX {
        return false
    }
    (*d).cls[(*d).ncls] = c
    (*d).ncls = (*d).ncls + 1
    return true
}

fn desc_set_state(d: *mut NodeDesc, st: u32) { (*d).state = st }
fn desc_class_count(d: *mut NodeDesc) -> usize { return (*d).ncls }

// THE STRIDE OF A `NodeDesc` IN THE ARRAY. Whoever passes on a chain as
// `*mut NodeDesc` has to calculate the address of the i-th member
// himself -- and this number must stand nowhere in the source as a
// digit. It is MEASURED here: the difference of two neighbours
// of a real array is what the translator really lays, and
// not what somebody once counted. lib/fui/scene.fi fetches
// the same number from here; a second place for it would mean that an
// additional field in `NodeDesc` would go unnoticed at ONE place.
fn sheet_desc_stride() -> usize {
    var probe: [NodeDesc; 2] = [desc_new(0 as u32, 0 as u32); 2]
    return ((&probe[1]) as u64 - (&probe[0]) as u64) as usize
}

fn desc_has_class(d: *mut NodeDesc, c: u32) -> bool {
    var i: usize = 0
    while i < (*d).ncls {
        if (*d).cls[i] == c {
            return true
        }
        i = i + 1
    }
    return false
}

// ======================================================================
// THE SHEET
// ======================================================================
//
// Fixed size, no allocator -- the same decision as with
// anim.Animator, and for the same reason: fUi also runs where there is no
// allocator.
const RULE_MAX: usize = 64
const CHAIN_MAX: usize = 16

struct Rule {
    sel: Sel,
    d: Decl,
}

struct Sheet {
    r: [Rule; 64],
    n: usize,
    // HOW MANY RULES THE SHEET NO LONGER TOOK. The same rule as with
    // scene.scene_add: returning RULE_MAX is honest, but
    // nobody looks at a return value that stands in a build sequence of
    // forty lines. A missing rule means that a part
    // of the surface stays unpainted -- so it is counted, and
    // `sheet_rule_overflow` hands out the number.
    ruleof: usize,
}

fn sheet_new() -> Sheet {
    return Sheet { r: [Rule { sel: sel_any(), d: decl_new() }; 64], n: 0,
        ruleof: 0 }
}

// Append a rule. The return value is its running number --
// and that is at the same time what is decisive at a tie of rank: the
// later rule wins.
fn sheet_add(sh: *mut Sheet, s: Sel, d: Decl) -> usize {
    if (*sh).n >= RULE_MAX {
        (*sh).ruleof = (*sh).ruleof + 1
        return RULE_MAX
    }
    let i: usize = (*sh).n
    (*sh).r[i].sel = s
    (*sh).r[i].d = d
    (*sh).n = i + 1
    return i
}

// A RULE FROM A STYLE -- the short form for the normal case.
// Almost every rule of this house consists of a selector and a
// set of style values; the three lines `decl_new`, `decl_set_style`,
// `sheet_add` are written anew for it every time. Here they stand
// ONCE. Nothing is hidden in doing so: whoever needs a transition or a
// transformation keeps building his Decl himself and calls
// `sheet_add` -- this function calls exactly the same.
fn sheet_rule(sh: *mut Sheet, s: Sel, st: style.Style) -> usize {
    var d: Decl = decl_new()
    decl_set_style(&d, st)
    return sheet_add(sh, s, d)
}

fn sheet_count(sh: *mut Sheet) -> usize { return (*sh).n }

// HOW MANY RULES WERE REJECTED since this sheet arose.
fn sheet_rule_overflow(sh: *mut Sheet) -> usize { return (*sh).ruleof }
fn sheet_sel(sh: *mut Sheet, i: usize) -> *mut Sel { return &(*sh).r[i].sel }
fn sheet_decl(sh: *mut Sheet, i: usize) -> *mut Decl { return &(*sh).r[i].d }

// The order is the insertion order; it stands here as a
// function, so that the check can name it without digging
// around inside.
fn sheet_order(sh: *mut Sheet, i: usize) -> i64 { return i as i64 }

fn chain_at(chain: *mut NodeDesc, i: usize) -> *mut NodeDesc {
    return (chain as u64 + (i * sheet_desc_stride()) as u64) as *mut NodeDesc
}

// Does rule `i` fit the LAST member of the chain?
//
// `chain` is the chain of ancestors, root first, the node itself
// at position `depth - 1`.
fn sheet_match(sh: *mut Sheet, i: usize, chain: *mut NodeDesc,
    depth: usize) -> bool {
    if depth == 0 || i >= (*sh).n {
        return false
    }
    return sel_match(&(*sh).r[i].sel, chain, depth)
}

// DOES THE SELECTOR `s` MATCH THE LAST LINK OF THE CHAIN? The one matcher:
// sheet_match asks it for a rule, lib/fui/query.fi for a query
// (querySelectorAll) -- there is no second selector engine.
fn sel_match(s: *mut Sel, chain: *mut NodeDesc, depth: usize) -> bool {
    if depth == 0 {
        return false
    }
    let me: *mut NodeDesc = chain_at(chain, depth - 1)
    if (*s).kind != KIND_ANY && (*s).kind != (*me).kind {
        return false
    }
    if (*s).id != ID_ANY && (*s).id != (*me).id {
        return false
    }
    if (*s).state != STATE_ANY && (*s).state != (*me).state {
        return false
    }
    var k: usize = 0
    while k < (*s).ncls {
        if !desc_has_class(me, (*s).cls[k]) {
            return false
        }
        k = k + 1
    }
    if (*s).has_anc == 0 as u32 {
        return true
    }
    // "inside of": SOME real ancestor must fit all three
    // named parts. That is the descendant combinator from CSS
    // (" "), not the child combinator (">").
    var a: usize = 0
    while a + 1 < depth {
        let p: *mut NodeDesc = chain_at(chain, a)
        var ok: bool = true
        if (*s).anc_kind != KIND_ANY && (*s).anc_kind != (*p).kind {
            ok = false
        }
        if (*s).anc_id != ID_ANY && (*s).anc_id != (*p).id {
            ok = false
        }
        if (*s).anc_cls != 0 as u32 && !desc_has_class(p, (*s).anc_cls) {
            ok = false
        }
        if ok {
            return true
        }
        a = a + 1
    }
    return false
}

// ALL matching rules, merged in the order of ASCENDING rank.
// Thereby the highest rank wins, and at a tie of rank the later rule
// -- without a special case standing anywhere for it.
//
// Sorting is done with a simple selection sort over the
// rule numbers: RULE_MAX is 64, and this merging happens
// once per node and frame.
fn sheet_resolve(sh: *mut Sheet, chain: *mut NodeDesc, depth: usize,
    out: *mut Decl) {
    var idx: [usize; 64] = [0; 64]
    var m: usize = 0
    var i: usize = 0
    while i < (*sh).n {
        if sheet_match(sh, i, chain, depth) {
            idx[m] = i
            m = m + 1
        }
        i = i + 1
    }
    // Ascending by (rank, number).
    var a: usize = 0
    while a < m {
        var best: usize = a
        var b: usize = a + 1
        while b < m {
            let sb: i64 = sel_specificity(&(*sh).r[idx[b]].sel)
            let sbest: i64 = sel_specificity(&(*sh).r[idx[best]].sel)
            if sb < sbest || (sb == sbest && idx[b] < idx[best]) {
                best = b
            }
            b = b + 1
        }
        let t: usize = idx[a]
        idx[a] = idx[best]
        idx[best] = t
        a = a + 1
    }
    var j: usize = 0
    while j < m {
        decl_merge(out, &(*sh).r[idx[j]].d)
        j = j + 1
    }
}
