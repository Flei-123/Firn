import std.io
import std.rt
import fui.action
import fui.ds_icons_core
import fui.ds_icons_names
import fui.icons
import fui.painter

export {
    BASE, gid, count, NONE, find, name_of, path_of, draw, draw_id, draw_pt, missing_count, set_full, full_installed,
}


const NONE: i64 = -1
const BASE: i64 = 1000

fn gid(id: i64) -> i64 {
    return BASE + id
}

static mut MISSING: usize = 0
static mut WARNED: bool = false
static mut FULL: u64 = 0

struct FullSet {
    look: fn(i64, i64, bool) -> str,
}

fn set_full(look: fn(i64, i64, bool) -> str) {
    if FULL != 0 { return }
    let h: *mut FullSet = rt.heap_alloc(16) as *mut FullSet
    (*h).look = look
    FULL = h as u64
}

fn full_installed() -> bool {
    return FULL != 0
}

fn core_look(id: i64, grade: i64, filled: bool) -> str {
    if grade == 0 {
        if filled { return ds_icons_core.filled16(id) }
        return ds_icons_core.regular16(id)
    }
    if grade == 1 {
        if filled { return ds_icons_core.filled20(id) }
        return ds_icons_core.regular20(id)
    }
    if filled { return ds_icons_core.filled24(id) }
    return ds_icons_core.regular24(id)
}

fn look(id: i64, grade: i64, filled: bool) -> str {
    let d: str = core_look(id, grade, filled)
    if d.n > 0 { return d }
    if FULL == 0 { return "" }
    let h: *mut FullSet = FULL as *mut FullSet
    let f: fn(i64, i64, bool) -> str = (*h).look
    return f(id, grade, filled)
}

fn count() -> i64 {
    return ds_icons_names.COUNT
}

fn missing_count() -> usize {
    return MISSING
}

fn name_of(id: i64) -> str {
    return ds_icons_names.name_of(id)
}

fn find(name: str) -> i64 {
    var i: i64 = 0
    while i < ds_icons_names.COUNT {
        if action.str_eq(ds_icons_names.name_of(i), name) {
            return i
        }
        i = i + 1
    }
    return NONE
}

fn pick(id: i64, grade: i64, filled: bool) -> str {
    var order: [i64; 3] = [grade, 1, 2]
    if grade == 0 {
        order = [0, 1, 2]
    } else if grade == 1 {
        order = [1, 2, 0]
    } else {
        order = [2, 1, 0]
    }
    var k: usize = 0
    while k < 3 {
        let g: i64 = order[k]
        let d: str = look(id, g, filled)
        if d.n > 0 {
            return d
        }
        k = k + 1
    }
    return ""
}

fn path_of(id: i64, size: f64, filled: bool) -> str {
    if id < 0 || id >= ds_icons_names.COUNT {
        return ""
    }
    var grade: i64 = 2
    if size <= 18.0 {
        grade = 0
    } else if size <= 22.0 {
        grade = 1
    }
    var d: str = pick(id, grade, filled)
    if d.n == 0 && filled {
        d = pick(id, grade, false)
    }
    return d
}

fn draw_id(z: *mut painter.Painter, id: i64, x: f64, y: f64, size: f64, col: u32, filled: bool) -> bool {
    let d: str = path_of(id, size, filled)
    if d.n == 0 {
        MISSING = MISSING + 1
        if !WARNED {
            WARNED = true
            if FULL == 0 {
                io.eprint("ds_icons: icon needs ds_icons_full.install(): ")
                io.eprint_line(ds_icons_names.name_of(id))
            } else {
                io.eprint("ds_icons: no glyph for id\n")
            }
        }
        return false
    }
    icons.path_draw(z, d, x, y, size, col, 0.0)
    return true
}

fn draw(z: *mut painter.Painter, name: str, x: f64, y: f64, size: f64, col: u32, filled: bool) -> bool {
    let id: i64 = find(name)
    if id < 0 {
        MISSING = MISSING + 1
        io.eprint("ds_icons: unknown icon name: ")
        io.eprint_line(name)
        return false
    }
    return draw_id(z, id, x, y, size, col, filled)
}

fn draw_pt(z: *mut painter.Painter, id: i64, x: f64, y: f64, size_pt: f64, col: u32, filled: bool) -> bool {
    return draw_id(z, id, x, y, size_pt * 96.0 / 72.0, col, filled)
}
