import fui.ds_catalog_tok
import fui.painter
import fui.render
import std.rt

export { draw, SCENE_W, SCENE_H, scene_count, height_of }

const SCENE_W: usize = 296
const SCENE_H: usize = 140
const SCENES: str = "0,0,296,140,6,p;1,1,294,138,5,s;10,9,8,8,4,b;24,9,8,8,4,b;38,9,8,8,4,b;1,26,294,1,0,p;8,34,58,98,4,r;14,42,46,10,3,t;14,60,46,8,3,p;14,74,46,8,3,p;14,88,46,8,3,p;80,36,92,12,3,b;80,58,200,8,3,p;80,72,180,8,3,p;80,86,150,8,3,p;80,106,64,22,4,a;152,106,64,22,4,p|0,0,296,140,6,p;1,1,294,138,5,s;12,12,90,10,3,b;188,8,96,18,4,r;12,36,88,46,6,r;20,45,28,28,7,t;56,48,36,8,3,b;56,62,26,8,3,p;106,36,88,46,6,r;114,45,28,28,7,a;150,48,36,8,3,b;150,62,26,8,3,p;200,36,88,46,6,r;208,45,28,28,7,t;244,48,36,8,3,b;244,62,26,8,3,p;12,88,88,46,6,r;20,97,28,28,7,a;56,100,36,8,3,b;56,114,26,8,3,p;106,88,88,46,6,r;114,97,28,28,7,t;150,100,36,8,3,b;150,114,26,8,3,p;200,88,88,46,6,r;208,97,28,28,7,a;244,100,36,8,3,b;244,114,26,8,3,p|0,0,296,140,6,p;1,1,294,138,5,s;12,12,80,10,3,b;12,118,272,1,0,b;20,78,24,40,4,t;56,54,24,64,4,t;92,66,24,52,4,t;128,34,24,84,4,t;164,58,24,60,4,t;200,22,24,96,4,a;236,46,24,72,4,t|0,0,296,140,6,p;1,1,294,138,5,s;12,10,22,22,11,t;42,16,70,8,3,b;12,40,150,22,10,p;12,66,100,22,10,p;134,92,150,22,10,a;12,120,272,14,7,r"

fn color_of(c: *mut render.Ctx, key: u8) -> u32 {
    if key == 115 as u8 { return ds_catalog_tok.surface(c) }
    if key == 114 as u8 { return ds_catalog_tok.raised(c) }
    if key == 112 as u8 { return ds_catalog_tok.separator(c) }
    if key == 98 as u8 { return ds_catalog_tok.border(c) }
    if key == 116 as u8 { return ds_catalog_tok.accent_tint(c) }
    return ds_catalog_tok.accent_fill(c)
}

fn height_of(w: f64) -> f64 { return w * (SCENE_H as f64) / (SCENE_W as f64) }

fn scene_count() -> usize {
    var n: usize = 1
    var i: usize = 0
    while i < SCENES.n {
        if rt.ld8(SCENES.p as u64, i) == 124 as u8 { n = n + 1 }
        i = i + 1
    }
    return n
}

fn scene_start(index: usize) -> usize {
    var seen: usize = 0
    var i: usize = 0
    while i < SCENES.n && seen < index {
        if rt.ld8(SCENES.p as u64, i) == 124 as u8 { seen = seen + 1 }
        i = i + 1
    }
    return i
}

fn draw(c: *mut render.Ctx, ox: f64, oy: f64, w: f64, scene: usize) {
    let k: f64 = w / (SCENE_W as f64)
    let z: *mut painter.Painter = render.ctx_painter(c)
    var i: usize = scene_start(scene % scene_count())
    var v: [f64; 5] = [0.0; 5]
    var field: usize = 0
    var num: usize = 0
    while i < SCENES.n {
        let b: u8 = rt.ld8(SCENES.p as u64, i)
        if b == 124 as u8 { return }
        if b >= 48 as u8 && b <= 57 as u8 {
            num = num * 10 + (b - 48 as u8) as usize
        } else if b == 44 as u8 {
            v[field] = num as f64
            field = field + 1
            num = 0
        } else if b >= 97 as u8 && b <= 122 as u8 {
            painter.round_rect(z, ox + v[0] * k, oy + v[1] * k, v[2] * k, v[3] * k, v[4] * k, color_of(c, b))
            field = 0
            num = 0
        }
        i = i + 1
    }
}
