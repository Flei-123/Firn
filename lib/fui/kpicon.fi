import fui.painter
import fui.icons

export { draw_play, draw_pause, draw_replay, draw_speaker, draw_speaker_muted }

const PLAY_D: str = "M8 5 L8 19 L19 12 Z"
const PAUSE_D: str = "M6 5 L10 5 L10 19 L6 19 Z M14 5 L18 5 L18 19 L14 19 Z"
const REPLAY_ARC_D: str = "M4 12 A8 8 0 1 0 7 6.3"
const REPLAY_HEAD_D: str = "M3 3.5 L3 9 L8.5 9"
const SPEAKER_D: str = "M3 9 L7 9 L12 5 L12 19 L7 15 L3 15 Z"
const WAVE_D: str = "M15.5 9 C17 10.5 17 13.5 15.5 15"
const WAVE_FAR_D: str = "M18 6.5 C21 9.5 21 14.5 18 17.5"
const CROSS_D: str = "M16 9.5 L21 14.5 M21 9.5 L16 14.5"

fn draw_play(z: *mut painter.Painter, x: f64, y: f64, size: f64, col: u32) {
    icons.path_draw(z, PLAY_D, x, y, size, col, 0.0)
}

fn draw_pause(z: *mut painter.Painter, x: f64, y: f64, size: f64, col: u32) {
    icons.path_draw(z, PAUSE_D, x, y, size, col, 0.0)
}

fn draw_replay(z: *mut painter.Painter, x: f64, y: f64, size: f64, col: u32) {
    icons.path_draw(z, REPLAY_ARC_D, x, y, size, col, 2.2)
    icons.path_draw(z, REPLAY_HEAD_D, x, y, size, col, 2.2)
}

fn draw_speaker(z: *mut painter.Painter, x: f64, y: f64, size: f64, col: u32, level: u32) {
    icons.path_draw(z, SPEAKER_D, x, y, size, col, 0.0)
    if level > 0 as u32 {
        icons.path_draw(z, WAVE_D, x, y, size, col, 2.0)
    }
    if level > 50 as u32 {
        icons.path_draw(z, WAVE_FAR_D, x, y, size, col, 2.0)
    }
}

fn draw_speaker_muted(z: *mut painter.Painter, x: f64, y: f64, size: f64, col: u32) {
    icons.path_draw(z, SPEAKER_D, x, y, size, col, 0.0)
    icons.path_draw(z, CROSS_D, x, y, size, col, 2.0)
}
