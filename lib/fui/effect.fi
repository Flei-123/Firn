// SPDX-License-Identifier: MPL-2.0
// lib/fui/effect.fi -- UNSCHAERFE, SCHATTEN, GLAS, FARBMATRIX.
//
// ========================================================= WARUM ES DAS GIBT
//
// Der Unterschied zwischen einer Oberflaeche von 1998 und einer von
// heute ist zu einem guten Teil ein einziger Effekt: WEICHE UNSCHAERFE.
// Ein Schatten mit einem harten Rand sieht aufgeklebt aus; derselbe
// Schatten, weich, laesst die Karte ueber der Seite schweben. Und das
// "Glas" moderner Leisten ist nichts anderes als der UNTERGRUND,
// verwischt und leicht aufgehellt.
//
// fUi hatte dafuer bisher nichts, und das ist kein Zierrat: ohne
// Unschaerfe kann man Tiefe nur durch Linien andeuten, und Linien
// ueberall sind genau das Aussehen, das Justin nicht will.
//
// ==================================================== WIE DIE UNSCHAERFE RECHNET
//
// Eine echte Gausskurve pro Pixel zu falten kostet (2r+1) Multiplika-
// tionen je Pixel und Richtung; bei r = 24 sind das ueber einen
// Bildschirm mehr, als eine Oberflaeche pro Bild ausgeben darf. Der
// bekannte Ausweg ist DREIMAL KASTEN: die Faltung mit einem Rechteck
// dreimal hintereinander naehert eine Gausskurve so gut an, dass der
// Unterschied unter einem Achtel eines Tonwerts bleibt (der Satz
// dahinter ist der zentrale Grenzwertsatz; drei Faltungen geben einen
// kubischen B-Spline). Und ein Kasten kostet mit LAUFENDER SUMME genau
// eine Addition und eine Subtraktion je Pixel -- O(1) statt O(r).
//
// ZWEI FALLEN, und beide sieht man sofort:
//
//   1. PREMULTIPLIED. Wer R, G, B ungewichtet mittelt und A getrennt,
//      zieht die Farbe voellig durchsichtiger Pixel (meist Schwarz) in
//      den Rand hinein -- der klassische dunkle Saum um jedes weiche
//      Ding. Die Leinwand liegt ohnehin premultiplied vor
//      (lib/paint/canvas.fi), also wird genau so gemittelt und nicht
//      zurueckgerechnet.
//   2. DER RAND. Wer ueber den Rand hinaus mit Nullen mittelt, bekommt
//      einen dunklen Streifen am Bildrand. Hier wird der Randwert
//      FORTGESETZT (clamp-to-edge), das ist die Antwort, die ein
//      Auschnitt eines groesseren Bildes gaebe.
//
// ============================== DIE ABGRENZUNG ZU paint/painter.blur_pass
//
// Es gibt in diesem Baum ZWEI Kastenweichzeichner, und hier steht
// nachpruefbar, warum das kein zweiter Ort fuer dieselbe Sache ist.
//
//   lib/paint/painter.fi  verwischt DECKUNGSGRADE: ein f64 je Pixel,
//       ein Kanal, kein Alpha, und ausserhalb der Reihe steht NULL --
//       richtig, weil das Fenster dort vor dem Rastern um den
//       Unschaerferadius vergroessert wird, draussen also wirklich
//       nichts liegt. Es arbeitet VOR dem Malen, auf der Form.
//   diese Datei           verwischt eine LEINWAND: vier premultipli-
//       zierte u8-Kanaele, und ausserhalb wird der RANDWERT
//       FORTGESETZT -- richtig, weil ein Ausschnitt einer Leinwand
//       draussen weitergeht. Sie arbeitet NACH dem Malen, auf Pixeln.
//
// Verschiedene Daten, verschiedene Randregel, dieselbe Arithmetik
// (laufende Summe, drei Durchgaenge). Firn Stufe 0 hat keine Form, in
// der EIN Rumpf beide Datentypen bedient, ohne dass eine der beiden
// Seiten je Pixel durch eine Umwandlung laeuft -- also stehen sie
// getrennt, und die Behauptung, dass sie trotzdem DASSELBE tun, wird
// GEMESSEN statt behauptet:
//
//   tools/fui/effect_main.fi, Abschnitt 12 und
//   tools/fui/blurref_main.fi
//
// verwischen dieselbe Stufenkante mit demselben sigma (4.0, also ein
// Fenster von neun Abtastwerten in beiden) und vergleichen die
// Tonwerte gegen DIESELBE Tabelle. Die beiden Programme sind getrennt,
// weil Firn ein Modul nach dem LETZTEN Pfadabschnitt aufloest und
// `fui.painter` und `paint.painter` darum nicht in dasselbe Programm
// passen; die Tabelle steht in beiden und verbindet sie.
//
// Gezeichnet wird im Uebrigen ueber lib/fui/painter.fi (die runden
// Ecken stehen dort und nur dort), die Pixel liegen in
// lib/paint/canvas.fi, die Wurzel kommt aus lib/svg/matrix.fi. Hier
// steht nur die Arithmetik, die es sonst nirgends gibt.
import std.rt
import paint.canvas
import fui.painter
import svg.matrix

export {
    // Unschaerfe
    blur_rect, blur_buffer, box_pass_h, box_pass_v,
    sigma_for_radius, radius_for_sigma,
    // Schatten und Glas
    drop_shadow_round, drop_shadow_spread, backdrop_blur, glass_round,
    frost_rect,
    // Tiefe ohne Kosten je Bild
    veil_rect, glow_ground, Keep, keep_new, keep_has, keep_take, keep_put,
    rrect_fast, rrect_shadow, ramp_rect, shift_rows, keep_mix, copy_px, flo, cei, slide_compose, layer_clear, layer_over,
    // Farbmatrix
    ColorMatrix, cm_identity, cm_saturate, cm_brightness, cm_contrast,
    cm_grayscale, cm_mul, cm_apply_rect, cm_apply_pixel,
}

// ============================================================ DIE MASSE
//
// Ein Kasten der Breite (2r+1) hat die Varianz ((2r+1)^2 - 1)/12; drei
// davon addieren sich, also ist sigma = sqrt(3 * ((2r+1)^2 - 1) / 12).
// Die Umkehrung dient dazu, aus einem CSS-`blur(8px)` (das sigma
// meint) den Kastenradius zu bekommen.
fn sigma_for_radius(r: i64) -> f64 {
    let d: f64 = (2 * r + 1) as f64
    return matrix.m_sqrt(3.0 * (d * d - 1.0) / 12.0)
}

fn radius_for_sigma(s: f64) -> i64 {
    // aus sigma^2 = 3*((2r+1)^2-1)/12 folgt (2r+1) = sqrt(4*sigma^2+1)
    let d: f64 = matrix.m_sqrt(4.0 * s * s + 1.0)
    var r: i64 = ((d - 1.0) * 0.5 + 0.5) as i64
    if r < 0 {
        r = 0
    }
    return r
}

// Auf den naechsten ganzen Punkt. `as i64` schneidet ab und zieht
// negative Werte damit in die falsche Richtung; ein Schatten links
// neben der Leinwand saesse dadurch einen Punkt zu weit rechts.
fn runde(v: f64) -> i64 {
    if v < 0.0 {
        return (v - 0.5) as i64
    }
    return (v + 0.5) as i64
}

fn ld8(p: u64) -> u8 { return *(p as *mut u8) }
fn st8(p: u64, v: u8) { *(p as *mut u8) = v }

// ------------------------------------------------- EIN KASTENDURCHGANG
//
// Waagerecht, mit laufender Summe, ueber alle vier Kanaele eines
// RGBA-Puffers `w * h`. `src` und `dst` duerfen NICHT derselbe Puffer
// sein -- die laufende Summe liest hinter sich.
fn box_pass_h(src: *mut u8, dst: *mut u8, w: usize, h: usize, r: i64) {
    if r <= 0 {
        var i: usize = 0
        while i < w * h * 4 {
            st8(dst as u64 + i as u64, ld8(src as u64 + i as u64))
            i = i + 1
        }
        return
    }
    let teiler: i64 = 2 * r + 1
    var y: usize = 0
    while y < h {
        let zeile: u64 = src as u64 + (y * w * 4) as u64
        let zeile_d: u64 = dst as u64 + (y * w * 4) as u64
        var k: usize = 0
        while k < 4 {
            // Die Anfangssumme: der linke Randwert (r+1)-mal plus die
            // ersten r Pixel. Das ist die Fortsetzung des Randes.
            var summe: i64 = (ld8(zeile + k as u64) as i64) * (r + 1)
            var j: i64 = 1
            while j <= r {
                var q: i64 = j
                if q > (w - 1) as i64 {
                    q = (w - 1) as i64
                }
                summe = summe + (ld8(zeile + (q * 4 + k as i64) as u64) as i64)
                j = j + 1
            }
            var x: i64 = 0
            while x < w as i64 {
                st8(zeile_d + (x * 4 + k as i64) as u64,
                    ((summe + teiler / 2) / teiler) as u8)
                var rechts: i64 = x + r + 1
                if rechts > (w - 1) as i64 {
                    rechts = (w - 1) as i64
                }
                var links: i64 = x - r
                if links < 0 {
                    links = 0
                }
                summe = summe + (ld8(zeile + (rechts * 4 + k as i64) as u64) as i64)
                summe = summe - (ld8(zeile + (links * 4 + k as i64) as u64) as i64)
                x = x + 1
            }
            k = k + 1
        }
        y = y + 1
    }
}

// Senkrecht, dasselbe.
fn box_pass_v(src: *mut u8, dst: *mut u8, w: usize, h: usize, r: i64) {
    if r <= 0 {
        var i: usize = 0
        while i < w * h * 4 {
            st8(dst as u64 + i as u64, ld8(src as u64 + i as u64))
            i = i + 1
        }
        return
    }
    let teiler: i64 = 2 * r + 1
    let schritt: i64 = (w * 4) as i64
    var x: usize = 0
    while x < w {
        let spalte: u64 = src as u64 + (x * 4) as u64
        let spalte_d: u64 = dst as u64 + (x * 4) as u64
        var k: usize = 0
        while k < 4 {
            var summe: i64 = (ld8(spalte + k as u64) as i64) * (r + 1)
            var j: i64 = 1
            while j <= r {
                var q: i64 = j
                if q > (h - 1) as i64 {
                    q = (h - 1) as i64
                }
                summe = summe + (ld8(spalte + (q * schritt + k as i64) as u64) as i64)
                j = j + 1
            }
            var y: i64 = 0
            while y < h as i64 {
                st8(spalte_d + (y * schritt + k as i64) as u64,
                    ((summe + teiler / 2) / teiler) as u8)
                var unten: i64 = y + r + 1
                if unten > (h - 1) as i64 {
                    unten = (h - 1) as i64
                }
                var oben: i64 = y - r
                if oben < 0 {
                    oben = 0
                }
                summe = summe + (ld8(spalte + (unten * schritt + k as i64) as u64) as i64)
                summe = summe - (ld8(spalte + (oben * schritt + k as i64) as u64) as i64)
                y = y + 1
            }
            k = k + 1
        }
        x = x + 1
    }
}

// DREI DURCHGAENGE je Richtung auf einem eigenstaendigen RGBA-Puffer.
// `tmp` muss `w * h * 4` Oktette fassen. Danach steht das Ergebnis
// wieder in `px`.
fn blur_buffer(px: *mut u8, tmp: *mut u8, w: usize, h: usize, r: i64) {
    if r <= 0 || w == 0 || h == 0 {
        return
    }
    box_pass_h(px, tmp, w, h, r)
    box_pass_h(tmp, px, w, h, r)
    box_pass_h(px, tmp, w, h, r)
    box_pass_v(tmp, px, w, h, r)
    box_pass_v(px, tmp, w, h, r)
    box_pass_v(tmp, px, w, h, r)
}

// ================================================= FROST: GLASS FOR A FRAME
//
// `backdrop_blur` is exact -- the band is blurred at full resolution, then
// masked, saturated and tinted per pixel -- and it costs what exact costs.
// MEASURED (FirnChat, 24.09.2026, tests/fui-look.mjs): the head and the
// input bar of the messenger, 1152 x 60 and 1152 x 72 pixels, took about
// 140 ms of a 190 ms frame in WebAssembly. A bar that scrolls content
// under it has to be redrawn every frame; that is not affordable.
//
// FROST is the way every compositor does it: a blur of a large radius
// carries no fine detail anyway, so the band is SHRUNK by `f` in both
// directions (a box average of f x f pixels), blurred there with radius
// blur / f -- f^2 fewer pixels, and f times shorter windows are not even
// needed, the running sum is O(1) -- and stretched back BILINEARLY while
// the tint is laid over it. The result differs from the exact blur by
// less than the tint lets through; the cost is one read of the band, a
// small blur and one write.
//
// Rectangular on purpose (a bar, a sheet head): no mask, no saturation.
// `tint` is a straight colour with alpha: 0xC0FFFFFF lays three quarters
// of white over the frosted band. Coordinates are canvas pixels.
// A box blur of radius r, once across and once down (a triangle), on a
// small band of w x h pixels in `a` (`b` is scratch of the same size).
// The mean is a multiplication by 65536 / (2r + 1), not a division;
// the edge value continues past the rim.
fn box2(a: *mut u8, b: *mut u8, w: i64, h: i64, r: i64) {
    let n: i64 = 2 * r + 1
    let inv: i64 = (65536 + n / 2) / n
    // across: a -> b
    var y: i64 = 0
    while y < h {
        let row: u64 = a as u64 + (y * w * 4) as u64
        let out: u64 = b as u64 + (y * w * 4) as u64
        var k: u64 = 0
        while k < 4 {
            var sum: i64 = ((*((row + k) as *mut u8)) as i64) * (r + 1)
            var j: i64 = 1
            while j <= r {
                var q: i64 = j
                if q > w - 1 { q = w - 1 }
                sum = sum + ((*((row + (q * 4) as u64 + k) as *mut u8)) as i64)
                j = j + 1
            }
            var x: i64 = 0
            while x < w {
                *((out + (x * 4) as u64 + k) as *mut u8) = ((sum * inv + 32768) >> 16) as u8
                var rr: i64 = x + r + 1
                if rr > w - 1 { rr = w - 1 }
                var ll: i64 = x - r
                if ll < 0 { ll = 0 }
                sum = sum + ((*((row + (rr * 4) as u64 + k) as *mut u8)) as i64) -
                    ((*((row + (ll * 4) as u64 + k) as *mut u8)) as i64)
                x = x + 1
            }
            k = k + 1
        }
        y = y + 1
    }
    // down: b -> a
    var x2: i64 = 0
    let st: i64 = w * 4
    while x2 < w {
        let col: u64 = b as u64 + (x2 * 4) as u64
        let out: u64 = a as u64 + (x2 * 4) as u64
        var k: u64 = 0
        while k < 4 {
            var sum: i64 = ((*((col + k) as *mut u8)) as i64) * (r + 1)
            var j: i64 = 1
            while j <= r {
                var q: i64 = j
                if q > h - 1 { q = h - 1 }
                sum = sum + ((*((col + (q * st) as u64 + k) as *mut u8)) as i64)
                j = j + 1
            }
            var yy: i64 = 0
            while yy < h {
                *((out + (yy * st) as u64 + k) as *mut u8) = ((sum * inv + 32768) >> 16) as u8
                var dd: i64 = yy + r + 1
                if dd > h - 1 { dd = h - 1 }
                var uu: i64 = yy - r
                if uu < 0 { uu = 0 }
                sum = sum + ((*((col + (dd * st) as u64 + k) as *mut u8)) as i64) -
                    ((*((col + (uu * st) as u64 + k) as *mut u8)) as i64)
                yy = yy + 1
            }
            k = k + 1
        }
        x2 = x2 + 1
    }
}

// The mean of four pixels, per octet, rounded -- red/blue and green/alpha
// each in two 16 bit lanes of one u64 (a sum of four octets needs ten).
fn mean4(a: u32, b: u32, c: u32, d: u32) -> u32 {
    let m: u64 = 16711935 // 0x00FF00FF
    let lo: u64 = (a as u64 & m) + (b as u64 & m) + (c as u64 & m) + (d as u64 & m) + 131074
    let hi: u64 = ((a as u64 >> 8) & m) + ((b as u64 >> 8) & m) + ((c as u64 >> 8) & m) +
        ((d as u64 >> 8) & m) + 131074
    return (((lo >> 2) & m) | (((hi >> 2) & m) << 8)) as u32
}

// a + (b - a) * t / 256 per octet, t in 0..256 -- two lanes at a time
fn lerp4(a: u32, b: u32, t: u64) -> u32 {
    let m: u64 = 16711935 // 0x00FF00FF
    let it: u64 = 256 - t
    let lo: u64 = (((a as u64 & m) * it + (b as u64 & m) * t + 8388736) >> 8) & m
    let hi: u64 = ((((a as u64 >> 8) & m) * it + ((b as u64 >> 8) & m) * t + 8388736) >> 8) & m
    return (lo | (hi << 8)) as u32
}

fn frost_rect(z: *mut painter.Painter, x: f64, y: f64, w: f64, h: f64,
    blur: i64, tint: u32) -> bool {
    let cv: *mut canvas.Canvas = painter.painter_canvas(z)
    let cw: i64 = canvas.canvas_width(cv) as i64
    let ch: i64 = canvas.canvas_height(cv) as i64
    var fb: [i64; 4] = [0; 4]
    let rx0: i64 = runde(x)
    let ry0: i64 = runde(y)
    if !band_of(cv, rx0 as f64, ry0 as f64, (runde(x + w) - rx0) as f64,
        (runde(y + h) - ry0) as f64, &fb[0]) {
        return true
    }
    let x0: i64 = fb[0]
    let y0: i64 = fb[1]
    let x1: i64 = fb[2]
    let y1: i64 = fb[3]
    let iw: i64 = x1 - x0
    let ih: i64 = y1 - y0
    if iw <= 0 || ih <= 0 {
        return true
    }
    // the shrink: 4 for a real blur, less for a small one -- and 8 for
    // a wide one (16 pixels and more: the glass of a bar), where the
    // stretch back is the whole cost and the blur hides the difference
    var f: i64 = 4
    if blur >= 16 { f = 8 }
    if blur < 8 { f = 2 }
    if blur < 3 { f = 1 }
    let sw: i64 = (iw + f - 1) / f
    let sh: i64 = (ih + f - 1) / f
    let n: usize = (sw * sh * 4) as usize
    // one block of memory: the small band, its blur partner, one
    // stretched row, and the table of the columns (source + weight)
    let rowb: usize = (sw * 4) as usize
    let tab: usize = (iw * 16) as usize
    let all: usize = 2 * n + rowb + tab
    let mem0: u64 = rt.heap_alloc(all)
    if mem0 == 0 {
        return false
    }
    let a: *mut u8 = mem0 as *mut u8
    let b: *mut u8 = (mem0 + n as u64) as *mut u8
    let vrow: u64 = mem0 + (2 * n) as u64
    let ctab: u64 = vrow + rowb as u64
    let px: u64 = canvas.canvas_pixels(cv) as u64
    let stride: i64 = cw * 4
    // 1. SHRINK: each small pixel is the mean of the 2 x 2 pixels in the
    //    middle of its f x f block. The blur that follows is several small
    //    pixels wide, so the other samples add nothing one could see --
    //    and reading every pixel of the band was the dearest step.
    let off: i64 = f / 2 - (f / 4)
    var sy: i64 = 0
    while sy < sh {
        var ya: i64 = sy * f + off
        if ya > ih - 1 { ya = ih - 1 }
        var yb: i64 = ya + f / 2
        if f < 2 { yb = ya }
        if yb > ih - 1 { yb = ih - 1 }
        let ra: u64 = px + ((y0 + ya) * stride + x0 * 4) as u64
        let rb: u64 = px + ((y0 + yb) * stride + x0 * 4) as u64
        var d: u64 = a as u64 + (sy * sw * 4) as u64
        var sx: i64 = 0
        while sx < sw {
            var xa: i64 = sx * f + off
            if xa > iw - 1 { xa = iw - 1 }
            var xb: i64 = xa + f / 2
            if f < 2 { xb = xa }
            if xb > iw - 1 { xb = iw - 1 }
            let qa: u64 = (xa * 4) as u64
            let qb: u64 = (xb * 4) as u64
            // FOUR CHANNELS AT ONCE: two lanes of 16 bits each for red and
            // blue, two for green and alpha -- a sum of four octets fits
            *((d) as *mut u32) = mean4(*((ra + qa) as *mut u32), *((ra + qb) as *mut u32),
                *((rb + qa) as *mut u32), *((rb + qb) as *mut u32))
            d = d + 4
            sx = sx + 1
        }
        sy = sy + 1
    }
    // 2. BLUR the small band: three box passes each way where the band
    // is fine (f < 8), two with a multiplied reciprocal where it is the
    // eighth of a wide glass -- after the stretch nobody tells a triangle
    // from a gaussian, and the divisions were 2 ms of every frame
    var rs: i64 = (blur + f / 2) / f
    if rs < 1 { rs = 1 }
    if f >= 8 {
        box2(a, b, sw, sh, rs)
    } else {
        blur_buffer(a, b, sw as usize, sh as usize, rs)
    }
    // 3. THE TINT, laid over the SMALL band: stretching is linear, so
    //    tinting before or after gives the same colours -- and before it
    //    is f^2 times fewer pixels. premultiplied: out = v (1 - ta) + t ta
    let ta: i64 = ((tint >> 24) & 255 as u32) as i64
    let inv: i64 = 255 - ta
    var tk: [i64; 4] = [0; 4]
    tk[0] = (((tint >> 16) & 255 as u32) as i64) * ta
    tk[1] = (((tint >> 8) & 255 as u32) as i64) * ta
    tk[2] = ((tint & 255 as u32) as i64) * ta
    tk[3] = 255 * ta
    var i: usize = 0
    while i < n {
        let q: u64 = a as u64 + i as u64
        let v: i64 = ((*((q) as *mut u8)) as i64) * inv + tk[i & 3] + 128
        *((q) as *mut u8) = ((v + (v >> 8)) >> 8) as u8
        i = i + 1
    }
    // 4. THE COLUMN TABLE: for every pixel of the band, the small column
    //    left of it (times 4, an octet offset) and the weight of the one
    //    right of it, in 1/256 -- centres aligned.
    var xx: i64 = 0
    while xx < iw {
        var fx: i64 = ((xx * 2 + 1) * 128) / f - 128
        if fx < 0 { fx = 0 }
        var c0: i64 = fx >> 8
        var wx: i64 = fx & 255
        if c0 >= sw - 1 {
            c0 = sw - 1
            wx = 0
        }
        let e: u64 = ctab + (xx * 16) as u64
        *(e as *mut i64) = c0 * 4
        *((e + 8) as *mut i64) = wx
        xx = xx + 1
    }
    // 5. STRETCH: per row of the band, the two small rows are mixed ONCE
    //    into `vrow`, then every pixel mixes two neighbours of it.
    var yy: i64 = 0
    while yy < ih {
        var fy: i64 = ((yy * 2 + 1) * 128) / f - 128
        if fy < 0 { fy = 0 }
        var r0: i64 = fy >> 8
        var wy: i64 = fy & 255
        if r0 >= sh - 1 {
            r0 = sh - 1
            wy = 0
        }
        var r1: i64 = r0 + 1
        if r1 > sh - 1 { r1 = sh - 1 }
        let s0: u64 = a as u64 + (r0 * sw * 4) as u64
        let s1: u64 = a as u64 + (r1 * sw * 4) as u64
        var j: u64 = 0
        let jn: u64 = (sw * 4) as u64
        while j < jn {
            *((vrow + j) as *mut u32) = lerp4(*((s0 + j) as *mut u32), *((s1 + j) as *mut u32), wy as u64)
            j = j + 4
        }
        var o: u64 = px + ((y0 + yy) * stride + x0 * 4) as u64
        var e: u64 = ctab
        xx = 0
        while xx < iw {
            let c: u64 = vrow + (*(e as *mut i64)) as u64
            let wx: u64 = (*((e + 8) as *mut i64)) as u64
            if wx == 0 && xx + 1 < iw && (*((e + 24) as *mut i64)) == 0 &&
                (*((e + 16) as *mut i64)) == (*(e as *mut i64)) {
                // two pixels on the same small column (the right rim)
                *((o) as *mut u32) = *((c) as *mut u32)
                *((o + 4) as *mut u32) = *((c) as *mut u32)
                o = o + 8
                e = e + 32
                xx = xx + 2
                continue
            }
            if wx == 0 {
                *((o) as *mut u32) = *((c) as *mut u32)
            } else {
                // lerp4, written out: a call per pixel was half the frost
                let pa: u64 = (*((c) as *mut u32)) as u64
                let pb: u64 = (*((c + 4) as *mut u32)) as u64
                let iw8: u64 = 256 - wx
                let lo: u64 = (((pa & 16711935) * iw8 + (pb & 16711935) * wx + 8388736) >> 8) & 16711935
                let hi: u64 = ((((pa >> 8) & 16711935) * iw8 + ((pb >> 8) & 16711935) * wx + 8388736) >> 8) & 16711935
                *((o) as *mut u32) = (lo | (hi << 8)) as u32
            }
            o = o + 4
            e = e + 16
            xx = xx + 1
        }
        yy = yy + 1
    }
    rt.heap_free(mem0, all)
    return true
}

// ============================================ DEPTH THAT A FRAME DOES NOT PAY
//
// Three small pieces for a surface with depth (FirnChat, THE LOOK, second
// round, 24.09.2026). Glass over a ground of ONE colour is invisible:
// frosting a plain colour gives the plain colour. So the ground gets
// light in it -- a ramp and a few large, soft spots of colour -- and the
// panels over it let it through. That ground is dear to compute and
// never changes while the window keeps its size, so it is computed ONCE
// and put back with one copy per frame.
//
//   veil_rect    a straight colour with alpha over a band, integer
//                arithmetic (a fill with alpha goes through the float
//                blend of canvas_blend per pixel -- several times this);
//   glow_ground  the ground: a vertical ramp and up to four soft spots,
//                DITHERED (a dark ramp in 8 bit shows bands otherwise);
//   Keep         a copy of the canvas, taken once per key (size, scheme,
//                layout) and put back whole or in part.
//
// Coordinates are canvas pixels.

// The integer bounds of a band on the canvas; false when nothing is left.
fn band_of(cv: *mut canvas.Canvas, x: f64, y: f64, w: f64, h: f64,
    out: *mut i64) -> bool {
    let cw: i64 = canvas.canvas_width(cv) as i64
    let ch: i64 = canvas.canvas_height(cv) as i64
    var x0: i64 = runde(x)
    var y0: i64 = runde(y)
    var x1: i64 = runde(x + w)
    var y1: i64 = runde(y + h)
    if x0 < 0 { x0 = 0 }
    if y0 < 0 { y0 = 0 }
    if x1 > cw { x1 = cw }
    if y1 > ch { y1 = ch }
    // THE CLIP HOLDS here too (its rectangle, in whole pixels): a picture
    // that repaints only a band of itself relies on it
    let kx0: i64 = cei(canvas.clip_x0(cv))
    let ky0: i64 = cei(canvas.clip_y0(cv))
    let kx1: i64 = flo(canvas.clip_x1(cv))
    let ky1: i64 = flo(canvas.clip_y1(cv))
    if x0 < kx0 { x0 = kx0 }
    if y0 < ky0 { y0 = ky0 }
    if x1 > kx1 { x1 = kx1 }
    if y1 > ky1 { y1 = ky1 }
    *out = x0
    *((out as u64 + 8) as *mut i64) = y0
    *((out as u64 + 16) as *mut i64) = x1
    *((out as u64 + 24) as *mut i64) = y1
    return x1 > x0 && y1 > y0
}

// A VEIL: `tint` (straight ARGB, its alpha is the strength) over the band.
// The canvas is premultiplied, so out = v (1 - ta) + t ta, per octet --
// the same arithmetic as the tint of frost_rect, so a veil over a plain
// ground and a frost over the same ground give the same colour.
fn veil_rect(z: *mut painter.Painter, x: f64, y: f64, w: f64, h: f64,
    tint: u32) {
    let cv: *mut canvas.Canvas = painter.painter_canvas(z)
    var b: [i64; 4] = [0; 4]
    if !band_of(cv, x, y, w, h, &b[0]) {
        return
    }
    let ta: i64 = ((tint >> 24) & 255 as u32) as i64
    if ta == 0 {
        return
    }
    let inv: i64 = 255 - ta
    let tr: i64 = (((tint >> 16) & 255 as u32) as i64) * ta + 128
    let tg: i64 = (((tint >> 8) & 255 as u32) as i64) * ta + 128
    let tb: i64 = ((tint & 255 as u32) as i64) * ta + 128
    let tA: i64 = 255 * ta + 128
    let px: u64 = canvas.canvas_pixels(cv) as u64
    let stride: i64 = (canvas.canvas_width(cv) as i64) * 4
    // the same arithmetic per octet, two lanes at a time
    let m: u64 = 16711935
    let tlo: u64 = (tr as u64) | ((tb as u64) << 16)
    let thi: u64 = (tg as u64) | ((tA as u64) << 16)
    let iv: u64 = inv as u64
    var yy: i64 = b[1]
    while yy < b[3] {
        var o: u64 = px + (yy * stride + b[0] * 4) as u64
        let end: u64 = o + ((b[2] - b[0]) * 4) as u64
        while o < end {
            let d: u64 = (*(o as *mut u32)) as u64
            var lo: u64 = (d & m) * iv + tlo
            lo = ((lo + ((lo >> 8) & m)) >> 8) & m
            var hi: u64 = ((d >> 8) & m) * iv + thi
            hi = ((hi + ((hi >> 8) & m)) >> 8) & m
            *(o as *mut u32) = (lo | (hi << 8)) as u32
            o = o + 4
        }
        yy = yy + 1
    }
}

// THE GROUND WITH LIGHT IN IT. The band (x, y, w, h) gets a vertical ramp
// from `top` to `bottom` (opaque RGB), and over it `n` soft spots (at most
// four). A spot is 8 numbers at spots + 64 i: centre x, centre y, radius
// across, radius down, strength 0..1, red, green, blue (0..255). Its
// weight falls as (1 - d^2)^2 with d^2 = (dx/rx)^2 + (dy/ry)^2 -- smooth
// to its rim, no exp per pixel. A spot with a huge `ry` is a column of
// light: the same in every row, so a band painted with it can be moved
// up and down (a scrolling history) without showing it.
//
// DITHERED: a 4 x 4 Bayer offset of less than one level before the
// rounding. A ramp from 0x0B1120 to a spot a few levels lighter spans
// only a handful of octet values over hundreds of pixels; without the
// offset the eye counts the bands.
fn glow_ground(z: *mut painter.Painter, x: f64, y: f64, w: f64, h: f64,
    top: u32, bottom: u32, spots: u64, n: usize) {
    let cv: *mut canvas.Canvas = painter.painter_canvas(z)
    var b: [i64; 4] = [0; 4]
    if !band_of(cv, x, y, w, h, &b[0]) {
        return
    }
    let bw: i64 = b[2] - b[0]
    if bw <= 0 || b[3] <= b[1] {
        return
    }
    var bay: [f64; 16] = [0.0; 16]
    let order: [i64; 16] = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5]
    var i: usize = 0
    while i < 16 {
        bay[i] = ((order[i] as f64) + 0.5) / 16.0 - 0.5
        i = i + 1
    }
    var m: usize = n
    if m > 4 { m = 4 }
    // the spots, read once: x, y, 1/rx^2, 1/ry^2, strength, r, g, b
    var sp: [f64; 32] = [0.0; 32]
    i = 0
    while i < m * 8 {
        sp[i] = *((spots + (i * 8) as u64) as *mut f64)
        i = i + 1
    }
    i = 0
    while i < m {
        let rx: f64 = sp[i * 8 + 2]
        let ry: f64 = sp[i * 8 + 3]
        if rx > 0.0 {
            sp[i * 8 + 2] = 1.0 / (rx * rx)
        }
        if ry > 0.0 {
            sp[i * 8 + 3] = 1.0 / (ry * ry)
        }
        i = i + 1
    }
    // THE ACROSS HALF OF EVERY DISTANCE, ONCE PER COLUMN (24.09.2026). The
    // weight of a spot needs d^2 = dx^2/rx^2 + dy^2/ry^2 per pixel; the
    // first half is the same in every row and the second the same in every
    // column, so each is computed once and added -- the same two products
    // and the same sum as before, the same octets (tools/fui: the look of
    // FirnChat unchanged). And no helper per octet: the rounding is written
    // out and the pixel stored as one word. 1996 x 1211 in WebAssembly:
    // 125 ms before, the start frame of the chat page was mostly this.
    let colp: u64 = rt.heap_alloc(m * (bw as usize) * 8 + 8)
    if colp == 0 as u64 {
        glow_ground_px(cv, &b[0], y, h, top, bottom, &sp[0], m, &bay[0])
        return
    }
    var k0: usize = 0
    while k0 < m {
        let q0: usize = k0 * 8
        var xi: i64 = 0
        let row: u64 = colp + (k0 * (bw as usize) * 8) as u64
        while xi < bw {
            let dx: f64 = ((b[0] + xi) as f64) + 0.5 - sp[q0]
            *((row + (xi * 8) as u64) as *mut f64) = dx * dx * sp[q0 + 2]
            xi = xi + 1
        }
        k0 = k0 + 1
    }
    let t0r: f64 = ((top >> 16) & 255 as u32) as f64
    let t0g: f64 = ((top >> 8) & 255 as u32) as f64
    let t0b: f64 = (top & 255 as u32) as f64
    let t1r: f64 = ((bottom >> 16) & 255 as u32) as f64
    let t1g: f64 = ((bottom >> 8) & 255 as u32) as f64
    let t1b: f64 = (bottom & 255 as u32) as f64
    let px: u64 = canvas.canvas_pixels(cv) as u64
    let stride: i64 = (canvas.canvas_width(cv) as i64) * 4
    var span: f64 = h
    if span < 1.0 { span = 1.0 }
    var rowt: [f64; 4] = [0.0; 4]
    var act: [u64; 4] = [0; 4] // the column halves of the spots this row meets
    var ramp: [u32; 4] = [0; 4]
    var yy: i64 = b[1]
    while yy < b[3] {
        let fy: f64 = (yy as f64) + 0.5
        var t: f64 = (fy - y) / span
        if t < 0.0 { t = 0.0 }
        if t > 1.0 { t = 1.0 }
        let rr: f64 = t0r + (t1r - t0r) * t
        let rg: f64 = t0g + (t1g - t0g) * t
        let rb: f64 = t0b + (t1b - t0b) * t
        // the spots that reach this row at all (the column half is never
        // negative, so a row half of 1 or more keeps d^2 at 1 or more)
        var na: usize = 0
        var k: usize = 0
        while k < m {
            let q: usize = k * 8
            let dy: f64 = fy - sp[q + 1]
            let rt2: f64 = dy * dy * sp[q + 3]
            if rt2 < 1.0 {
                rowt[na] = rt2
                act[na] = (k as u64) | ((colp + (k * (bw as usize) * 8) as u64) << 3)
                na = na + 1
            }
            k = k + 1
        }
        // the four dithered pixels of the bare ramp in this row
        var j: usize = 0
        while j < 4 {
            let d0: f64 = bay[(((yy & 3) * 4) as usize) + j]
            var vr: f64 = rr + d0 + 0.5
            if vr < 0.0 { vr = 0.0 }
            if vr > 255.0 { vr = 255.0 }
            var vg: f64 = rg + d0 + 0.5
            if vg < 0.0 { vg = 0.0 }
            if vg > 255.0 { vg = 255.0 }
            var vb: f64 = rb + d0 + 0.5
            if vb < 0.0 { vb = 0.0 }
            if vb > 255.0 { vb = 255.0 }
            ramp[j] = ((vr as i64) | ((vg as i64) << 8) | ((vb as i64) << 16)
                | (255 << 24)) as u32
            j = j + 1
        }
        let dbase: usize = ((yy & 3) * 4) as usize
        var o: u64 = px + (yy * stride + b[0] * 4) as u64
        if na == 0 {
            var xi2: i64 = 0
            while xi2 < bw {
                *(o as *mut u32) = ramp[((b[0] + xi2) & 3) as usize]
                o = o + 4
                xi2 = xi2 + 1
            }
        } else {
            // the light itself at every GLOW_STEP-th column (and the last),
            // exactly; in between it is a straight line -- it is a sum of
            // (1 - d^2)^2 bumps hundreds of pixels wide, and the line is off
            // by far less than the dither (tools/fui glow bench: at most one
            // level at a few pixels in a thousand). Rounding and dither stay
            // per pixel.
            let actu: u64 = (&act[0]) as u64
            let rowu: u64 = (&rowt[0]) as u64
            let spu: u64 = (&sp[0]) as u64
            // the dither of this row plus the half for rounding
            var dfx: [f64; 4] = [0.0; 4]
            var dj: usize = 0
            while dj < 4 {
                dfx[dj] = bay[dbase + dj] + 0.5
                dj = dj + 1
            }
            let dfu: u64 = (&dfx[0]) as u64
            let aend: u64 = (na * 8) as u64
            var x0: i64 = 0
            var c0r: f64 = 0.0
            var c0g: f64 = 0.0
            var c0b: f64 = 0.0
            glow_at(actu, rowu, spu, aend, colp, 0, rr, rg, rb, &c0r, &c0g, &c0b)
            var xx: u64 = b[0] as u64
            while x0 < bw {
                var x1: i64 = x0 + GLOW_STEP
                if x1 > bw - 1 {
                    x1 = bw - 1
                }
                var c1r: f64 = c0r
                var c1g: f64 = c0g
                var c1b: f64 = c0b
                var n1: i64 = 1
                if x1 > x0 {
                    glow_at(actu, rowu, spu, aend, colp, x1, rr, rg, rb,
                        &c1r, &c1g, &c1b)
                    n1 = x1 - x0
                }
                let inv: f64 = 1.0 / (n1 as f64)
                let sr: f64 = (c1r - c0r) * inv
                let sg: f64 = (c1g - c0g) * inv
                let sb: f64 = (c1b - c0b) * inv
                var cr: f64 = c0r
                var cg: f64 = c0g
                var cb: f64 = c0b
                // the span [x0, x1): the last column is painted with the
                // last span's end
                var cnt: i64 = n1
                if x1 == bw - 1 {
                    cnt = n1 + 1
                }
                // No clamps: a colour between two colours of 0..255, plus a
                // dither of less than half a level, plus the half for the
                // rounding, stays inside [0, 256).
                var q: i64 = 0
                while q < cnt {
                    let d: f64 = *((dfu + ((xx & 3) << 3)) as *mut f64)
                    *(o as *mut u32) = (((cr + d) as i64)
                        | (((cg + d) as i64) << 8)
                        | (((cb + d) as i64) << 16) | (255 << 24)) as u32
                    cr = cr + sr
                    cg = cg + sg
                    cb = cb + sb
                    o = o + 4
                    xx = xx + 1
                    q = q + 1
                }
                c0r = c1r
                c0g = c1g
                c0b = c1b
                x0 = x0 + cnt
            }
        }
        yy = yy + 1
    }
    rt.heap_free(colp, m * (bw as usize) * 8 + 8)
}

const GLOW_STEP: i64 = 8

// The light of the spots that reach this row, at column `xi` of the band,
// over the ramp colour (rr, rg, rb) -- exactly what the per pixel loop
// computed.
fn glow_at(actu: u64, rowu: u64, spu: u64, aend: u64, colp: u64, xi: i64,
    rr: f64, rg: f64, rb: f64, outr: *mut f64, outg: *mut f64,
    outb: *mut f64) {
    var cr: f64 = rr
    var cg: f64 = rg
    var cb: f64 = rb
    let xo: u64 = (xi * 8) as u64
    var ao: u64 = 0
    while ao < aend {
        let ak: u64 = *((actu + ao) as *mut u64)
        let d2: f64 = *(((ak >> 3) + xo) as *mut f64) + *((rowu + ao) as *mut f64)
        if d2 < 1.0 {
            let q: u64 = spu + ((ak & 7) << 6)
            let u: f64 = 1.0 - d2
            let wgt: f64 = u * u * *((q + 32) as *mut f64)
            cr = cr + (*((q + 40) as *mut f64) - cr) * wgt
            cg = cg + (*((q + 48) as *mut f64) - cg) * wgt
            cb = cb + (*((q + 56) as *mut f64) - cb) * wgt
        }
        ao = ao + 8
    }
    *outr = cr
    *outg = cg
    *outb = cb
}

// The same ground, pixel by pixel -- what glow_ground falls back to when
// the column table cannot be had.
fn glow_ground_px(cv: *mut canvas.Canvas, bp: *mut i64, y: f64, h: f64,
    top: u32, bottom: u32, spp: *mut f64, m: usize, bayp: *mut f64) {
    let b0: i64 = *bp
    let b1: i64 = *((bp as u64 + 8) as *mut i64)
    let b2: i64 = *((bp as u64 + 16) as *mut i64)
    let b3: i64 = *((bp as u64 + 24) as *mut i64)
    let spu: u64 = spp as u64
    let bayu: u64 = bayp as u64
    let t0r: f64 = ((top >> 16) & 255 as u32) as f64
    let t0g: f64 = ((top >> 8) & 255 as u32) as f64
    let t0b: f64 = (top & 255 as u32) as f64
    let t1r: f64 = ((bottom >> 16) & 255 as u32) as f64
    let t1g: f64 = ((bottom >> 8) & 255 as u32) as f64
    let t1b: f64 = (bottom & 255 as u32) as f64
    let px: u64 = canvas.canvas_pixels(cv) as u64
    let stride: i64 = (canvas.canvas_width(cv) as i64) * 4
    var span: f64 = h
    if span < 1.0 { span = 1.0 }
    var yy: i64 = b1
    while yy < b3 {
        let fy: f64 = (yy as f64) + 0.5
        var t: f64 = (fy - y) / span
        if t < 0.0 { t = 0.0 }
        if t > 1.0 { t = 1.0 }
        let rr: f64 = t0r + (t1r - t0r) * t
        let rg: f64 = t0g + (t1g - t0g) * t
        let rb: f64 = t0b + (t1b - t0b) * t
        var o: u64 = px + (yy * stride + b0 * 4) as u64
        var xx: i64 = b0
        while xx < b2 {
            var cr: f64 = rr
            var cg: f64 = rg
            var cb: f64 = rb
            let fx: f64 = (xx as f64) + 0.5
            var k: usize = 0
            while k < m {
                let q: u64 = spu + (k * 64) as u64
                let dx: f64 = fx - *(q as *mut f64)
                let dy: f64 = fy - *((q + 8) as *mut f64)
                let d2: f64 = dx * dx * *((q + 16) as *mut f64)
                    + dy * dy * *((q + 24) as *mut f64)
                if d2 < 1.0 {
                    let u: f64 = 1.0 - d2
                    let wgt: f64 = u * u * *((q + 32) as *mut f64)
                    cr = cr + (*((q + 40) as *mut f64) - cr) * wgt
                    cg = cg + (*((q + 48) as *mut f64) - cg) * wgt
                    cb = cb + (*((q + 56) as *mut f64) - cb) * wgt
                }
                k = k + 1
            }
            let d: f64 = *((bayu + (((yy & 3) * 4 + (xx & 3)) * 8) as u64) as *mut f64)
            st8(o, oct8(cr + d) as u8)
            st8(o + 1, oct8(cg + d) as u8)
            st8(o + 2, oct8(cb + d) as u8)
            st8(o + 3, 255 as u8)
            o = o + 4
            xx = xx + 1
        }
        yy = yy + 1
    }
}

// 0..255 with rounding, clamped
fn oct8(v: f64) -> i64 {
    var x: f64 = v + 0.5
    if x < 0.0 { x = 0.0 }
    if x > 255.0 { x = 255.0 }
    return x as i64
}

// A COPY OF n OCTETS. Blocks of 4096, 512 and 64 octets are copied as
// whole structs -- which the compiler turns into ONE bulk copy each (a
// `memory.copy` in WebAssembly) -- and the rest eight at a time. rt.mem_copy
// calls a function per word: 22 ms for one canvas of 1996 x 1211,
// measured; this is the price of the memory.
struct Blk4096 {
    v: [u64; 512],
}

struct Blk512 {
    v: [u64; 64],
}

struct Blk64 {
    v: [u64; 8],
}

fn copy_px(dst: u64, src: u64, n: usize) {
    var i: u64 = 0
    let nn: u64 = n as u64
    while i + 4096 <= nn {
        *((dst + i) as *mut Blk4096) = *((src + i) as *mut Blk4096)
        i = i + 4096
    }
    while i + 512 <= nn {
        *((dst + i) as *mut Blk512) = *((src + i) as *mut Blk512)
        i = i + 512
    }
    while i + 64 <= nn {
        *((dst + i) as *mut Blk64) = *((src + i) as *mut Blk64)
        i = i + 64
    }
    while i + 8 <= nn {
        *((dst + i) as *mut u64) = *((src + i) as *mut u64)
        i = i + 8
    }
    while i + 4 <= nn {
        *((dst + i) as *mut u32) = *((src + i) as *mut u32)
        i = i + 4
    }
    while i < nn {
        *((dst + i) as *mut u8) = *((src + i) as *mut u8)
        i = i + 1
    }
}

// A KEPT PICTURE: the canvas as it was when `keep_take` was called, under
// a key the caller chooses (size, scheme, layout -- whatever would change
// the picture). The memory belongs to the Keep and is reused as long as
// the canvas keeps its size.
struct Keep {
    mem: u64,
    bytes: usize,
    w: usize,
    h: usize,
    key: u64,
}

fn keep_new() -> Keep {
    return Keep { mem: 0, bytes: 0, w: 0, h: 0, key: 0 }
}

// Does the Keep hold a picture for this key and this canvas?
fn keep_has(k: *mut Keep, z: *mut painter.Painter, key: u64) -> bool {
    let cv: *mut canvas.Canvas = painter.painter_canvas(z)
    return (*k).mem != 0 && (*k).key == key &&
        (*k).w == canvas.canvas_width(cv) && (*k).h == canvas.canvas_height(cv)
}

// Take the whole canvas into the Keep under `key`. False when there is no
// memory for it (the caller simply paints again next time).
fn keep_take(k: *mut Keep, z: *mut painter.Painter, key: u64) -> bool {
    let cv: *mut canvas.Canvas = painter.painter_canvas(z)
    let w: usize = canvas.canvas_width(cv)
    let h: usize = canvas.canvas_height(cv)
    let need: usize = w * h * 4
    if need == 0 {
        return false
    }
    if (*k).mem == 0 || (*k).bytes != need {
        if (*k).mem != 0 {
            rt.heap_free((*k).mem, (*k).bytes)
        }
        (*k).mem = rt.heap_alloc(need)
        (*k).bytes = need
        if (*k).mem == 0 {
            (*k).bytes = 0
            (*k).key = 0
            return false
        }
    }
    copy_px((*k).mem, canvas.canvas_pixels(cv) as u64, need)
    (*k).w = w
    (*k).h = h
    (*k).key = key
    return true
}

// The kept picture laid OVER the band with strength a (0..1): what is
// painted there fades towards the kept ground -- a thing that fades in
// over a ground with light in it, without a flat veil.
fn keep_mix(k: *mut Keep, z: *mut painter.Painter, x: f64, y: f64, w: f64,
    h: f64, a: f64) {
    let cv: *mut canvas.Canvas = painter.painter_canvas(z)
    if (*k).mem == 0 || (*k).w != canvas.canvas_width(cv) ||
        (*k).h != canvas.canvas_height(cv) {
        return
    }
    var b: [i64; 4] = [0; 4]
    if !band_of(cv, x, y, w, h, &b[0]) {
        return
    }
    var t: i64 = (a * 256.0 + 0.5) as i64
    if t <= 0 {
        return
    }
    if t > 256 { t = 256 }
    let px: u64 = canvas.canvas_pixels(cv) as u64
    let stride: i64 = ((*k).w as i64) * 4
    var yy: i64 = b[1]
    while yy < b[3] {
        var off: u64 = (yy * stride + b[0] * 4) as u64
        let end: u64 = (yy * stride + b[2] * 4) as u64
        while off < end {
            *((px + off) as *mut u32) = lerp4(*((px + off) as *mut u32),
                *(((*k).mem + off) as *mut u32), t as u64)
            off = off + 4
        }
        yy = yy + 1
    }
}

// THE SLIDE OF TWO PANES, from two kept pictures: `under` moved `sl`
// pixels to the left and shown up to column cx, `over` from column cx on
// (its own column 0 there), and a shade of black with alpha `shade`
// (0..255) over the part of `under` that shows. One copy of the canvas
// and a veil per frame -- the panes themselves are painted once, at rest.
fn slide_compose(under: *mut Keep, over: *mut Keep, z: *mut painter.Painter,
    sl: i64, cx: i64, shade: u32) -> bool {
    let cv: *mut canvas.Canvas = painter.painter_canvas(z)
    let w: usize = canvas.canvas_width(cv)
    let h: usize = canvas.canvas_height(cv)
    if (*under).mem == 0 || (*over).mem == 0 || (*under).w != w ||
        (*under).h != h || (*over).w != w || (*over).h != h {
        return false
    }
    let wi: i64 = w as i64
    var c: i64 = cx
    if c < 0 { c = 0 }
    if c > wi { c = wi }
    var s: i64 = sl
    if s < 0 { s = 0 }
    if s > wi - c { s = wi - c }
    let px: u64 = canvas.canvas_pixels(cv) as u64
    let stride: u64 = (w * 4) as u64
    var y: u64 = 0
    while y < h as u64 {
        let row: u64 = y * stride
        if c > 0 {
            copy_px(px + row, (*under).mem + row + (s * 4) as u64, (c * 4) as usize)
        }
        if c < wi {
            copy_px(px + row + (c * 4) as u64, (*over).mem + row,
                ((wi - c) * 4) as usize)
        }
        y = y + 1
    }
    if shade > 0 as u32 && c > 0 {
        veil_rect(z, 0.0, 0.0, c as f64, h as f64, shade << 24)
    }
    return true
}

// A LAYER: a second canvas of the same size that holds what stands OVER
// something that changes (the title and the field over a glass band), with
// alpha, premultiplied. `layer_clear` makes rows [y0, y1) of it empty,
// `layer_over` lays rows [y0, y1) of it over the canvas of `z` -- src-over
// per pixel, empty pixels skipped, full ones copied.
fn layer_clear(cv: *mut canvas.Canvas, y0: i64, y1: i64) {
    let w: i64 = canvas.canvas_width(cv) as i64
    let h: i64 = canvas.canvas_height(cv) as i64
    var a: i64 = y0
    var b: i64 = y1
    if a < 0 { a = 0 }
    if b > h { b = h }
    if b <= a {
        return
    }
    let px: u64 = canvas.canvas_pixels(cv) as u64
    var i: u64 = (a * w * 4) as u64
    let e: u64 = (b * w * 4) as u64
    while i + 8 <= e {
        *((px + i) as *mut u64) = 0
        i = i + 8
    }
    while i < e {
        *((px + i) as *mut u8) = 0 as u8
        i = i + 1
    }
}

fn layer_over(z: *mut painter.Painter, src: *mut canvas.Canvas, y0: i64,
    y1: i64) {
    let cv: *mut canvas.Canvas = painter.painter_canvas(z)
    let w: i64 = canvas.canvas_width(cv) as i64
    let h: i64 = canvas.canvas_height(cv) as i64
    if canvas.canvas_width(src) != w as usize || canvas.canvas_height(src) != h as usize {
        return
    }
    var a: i64 = y0
    var b: i64 = y1
    if a < 0 { a = 0 }
    if b > h { b = h }
    let dp: u64 = canvas.canvas_pixels(cv) as u64
    let sp: u64 = canvas.canvas_pixels(src) as u64
    let m: u64 = 16711935 // 0x00FF00FF
    var i: u64 = (a * w * 4) as u64
    let e: u64 = (b * w * 4) as u64
    while i < e {
        let s: u64 = (*((sp + i) as *mut u32)) as u64
        let sa: u64 = s >> 24
        if sa == 255 {
            *((dp + i) as *mut u32) = s as u32
        } else if sa != 0 {
            // d (255 - sa) / 255 + s, two lanes at a time
            let d: u64 = (*((dp + i) as *mut u32)) as u64
            let ia: u64 = 255 - sa
            var lo: u64 = (d & m) * ia + 8388736
            lo = ((lo + ((lo >> 8) & m)) >> 8) & m
            var hi: u64 = ((d >> 8) & m) * ia + 8388736
            hi = ((hi + ((hi >> 8) & m)) >> 8) & m
            *((dp + i) as *mut u32) = ((lo | (hi << 8)) + s) as u32
        }
        i = i + 4
    }
}

// Put the kept picture back into the band (canvas pixels). The whole
// canvas is one copy; a band is one copy per row.
fn keep_put(k: *mut Keep, z: *mut painter.Painter, x: f64, y: f64, w: f64,
    h: f64) {
    let cv: *mut canvas.Canvas = painter.painter_canvas(z)
    if (*k).mem == 0 || (*k).w != canvas.canvas_width(cv) ||
        (*k).h != canvas.canvas_height(cv) {
        return
    }
    var b: [i64; 4] = [0; 4]
    if !band_of(cv, x, y, w, h, &b[0]) {
        return
    }
    let px: u64 = canvas.canvas_pixels(cv) as u64
    let stride: i64 = ((*k).w as i64) * 4
    if b[0] == 0 && b[2] == (*k).w as i64 {
        let off: u64 = (b[1] * stride) as u64
        copy_px(px + off, (*k).mem + off, ((b[3] - b[1]) * stride) as usize)
        return
    }
    let rowb: usize = ((b[2] - b[0]) * 4) as usize
    var yy: i64 = b[1]
    while yy < b[3] {
        let off: u64 = (yy * stride + b[0] * 4) as u64
        copy_px(px + off, (*k).mem + off, rowb)
        yy = yy + 1
    }
}

// ============================================ SHAPES AT THE PRICE OF A FILL
//
// MEASURED (FirnChat in Chromium, 1996 x 1211, 24.09.2026): a frame of
// the conversation took 212 ms, and most of it was the round rectangles
// of the bubbles going through the general rasteriser -- per pixel of the
// box an accumulation cell, a running sum, the blend through the clip and
// the reset of the cell: four passes and two float conversions per
// channel, for a shape whose inside is simply one colour.
//
// A round rectangle does not need a rasteriser. Its coverage is known in
// closed form: inside the straight parts it is the overlap of the pixel
// with the box (exact), and in the four corner squares it is the signed
// distance to the rounded box, 0.5 - d, clamped -- the same number for a
// straight edge, and within a few hundredths of the exact area on the
// arc. So a row is: the edge pixels with their coverage, and between
// them a run of stores.
//
// NOT pixel-identical with painter.round_rect (whose arc is a cubic and
// whose coverage is the exact area): the flat pictures that tests compare
// octet for octet keep using that one. These are for the looks that are
// judged by eye.

// straight ARGB with the painter's rule: alpha 0 means opaque
fn solid(col: u32) -> u32 {
    if (col >> 24) & 255 as u32 == 0 as u32 {
        return col | 4278190080 as u32
    }
    return col
}

fn flo(v: f64) -> i64 {
    let t: i64 = v as i64
    if (t as f64) > v {
        return t - 1
    }
    return t
}

fn cei(v: f64) -> i64 {
    let t: i64 = flo(v)
    if (t as f64) < v {
        return t + 1
    }
    return t
}

fn ovl(a0: f64, a1: f64, b0: f64, b1: f64) -> f64 {
    var lo: f64 = a0
    if b0 > lo { lo = b0 }
    var hi: f64 = a1
    if b1 < hi { hi = b1 }
    if hi <= lo {
        return 0.0
    }
    return hi - lo
}

// sqrt for the small distances of a corner (0 .. a few hundred pixels):
// a start within 5 % and two Newton steps, closer than 1e-4 of a pixel.
fn root(v: f64) -> f64 {
    if v <= 0.0 {
        return 0.0
    }
    var g: f64 = v
    if g > 1.0 {
        g = 1.0
        var o: f64 = v
        while o > 4.0 {
            o = o * 0.25
            g = g * 2.0
        }
        g = g * (0.5 + 0.5 * o) // o in (1, 4]: within 10 %
    }
    g = 0.5 * (g + v / g)
    g = 0.5 * (g + v / g)
    g = 0.5 * (g + v / g)
    return g
}

// Mix two straight ARGB colours, t in 0..1 (per channel, rounded).
fn mix8(a: u32, b: u32, t: f64) -> u32 {
    var k: i64 = (t * 256.0 + 0.5) as i64
    if k < 0 { k = 0 }
    if k > 256 { k = 256 }
    var out: u32 = 0 as u32
    var sh: u32 = 0 as u32
    while sh < 32 as u32 {
        let ca: i64 = ((a >> sh) & 255 as u32) as i64
        let cb: i64 = ((b >> sh) & 255 as u32) as i64
        let v: i64 = ca + (((cb - ca) * k) >> 8)
        out = out | ((v as u32) << sh)
        sh = sh + 8 as u32
    }
    return out
}

// src-over of a straight colour with coverage `cov` onto the premultiplied
// pixel at p, in integers.
fn over(p: u64, col: u32, cov: f64) {
    let ca: i64 = ((col >> 24) & 255 as u32) as i64
    let a: i64 = ((ca as f64) * cov + 0.5) as i64
    if a <= 0 {
        return
    }
    let c: u64 = col as u64
    if a >= 255 {
        // the octets r g b a of the canvas, as one word (little endian)
        *(p as *mut u32) = (((c >> 16) & 255) | (((c >> 8) & 255) << 8) |
            ((c & 255) << 16) | 4278190080) as u32
        return
    }
    // c a + d (255 - a), rounded -- red/blue and green/alpha in two lanes
    // each, written out (no helper per octet: engines that do not inline
    // pay a call for each)
    let m: u64 = 16711935
    let aa: u64 = a as u64
    let inv: u64 = 255 - aa
    let d: u64 = (*(p as *mut u32)) as u64
    let slo: u64 = ((c >> 16) & 255) | ((c & 255) << 16)
    let shi: u64 = ((c >> 8) & 255) | 16711680
    var lo: u64 = slo * aa + (d & m) * inv + 8388736
    lo = ((lo + ((lo >> 8) & m)) >> 8) & m
    var hi: u64 = shi * aa + ((d >> 8) & m) * inv + 8388736
    hi = ((hi + ((hi >> 8) & m)) >> 8) & m
    *(p as *mut u32) = (lo | (hi << 8)) as u32
}

// The signed distance of (px, py) to the round box (x, y, w, h, r):
// negative inside.
fn rbox_d(px: f64, py: f64, cx: f64, cy: f64, hx: f64, hy: f64, r: f64) -> f64 {
    var qx: f64 = px - cx
    if qx < 0.0 { qx = 0.0 - qx }
    qx = qx - hx
    var qy: f64 = py - cy
    if qy < 0.0 { qy = 0.0 - qy }
    qy = qy - hy
    var ox: f64 = qx
    if ox < 0.0 { ox = 0.0 }
    var oy: f64 = qy
    if oy < 0.0 { oy = 0.0 }
    var inside: f64 = qx
    if qy > inside { inside = qy }
    if inside > 0.0 { inside = 0.0 }
    return root(ox * ox + oy * oy) + inside - r
}

// How much of a pixel lies inside a straight edge whose normal is (nx,
// ny) (a = the smaller, b = the larger of |nx|, |ny|) and which passes at
// signed distance d from the pixel's centre (d > 0: the centre is
// outside). Exact for a straight edge: across the edge the pixel is a
// trapezoid of widths a and b, and this is its area up to the edge.
fn edge_cov(d: f64, a: f64, b: f64) -> f64 {
    let t: f64 = 0.0 - d
    let lo: f64 = (a + b) / 2.0
    if t <= 0.0 - lo {
        return 0.0
    }
    if t >= lo {
        return 1.0
    }
    let k: f64 = (b - a) / 2.0
    if a < 0.000001 {
        return 0.5 + t / b
    }
    if t < 0.0 - k {
        let s: f64 = t + lo
        return s * s / (2.0 * a * b)
    }
    if t > k {
        let s: f64 = lo - t
        return 1.0 - s * s / (2.0 * a * b)
    }
    return 0.5 + t / b
}

// The coverage of pixel (px, py) (its centre) by the round box: the
// overlap on the straight parts (0.5 - d there), and on the arc the area
// under the tangent of the arc (edge_cov) -- within a few levels of the
// exact area for any radius of a few pixels and more.
fn rbox_cov(px: f64, py: f64, cx: f64, cy: f64, hx: f64, hy: f64, r: f64) -> f64 {
    var qx: f64 = px - cx
    if qx < 0.0 { qx = 0.0 - qx }
    qx = qx - hx
    var qy: f64 = py - cy
    if qy < 0.0 { qy = 0.0 - qy }
    qy = qy - hy
    var cov: f64 = 0.0
    if qx > 0.0 && qy > 0.0 {
        let len: f64 = root(qx * qx + qy * qy)
        var a: f64 = qx / len
        var b: f64 = qy / len
        if a > b {
            let t: f64 = a
            a = b
            b = t
        }
        cov = edge_cov(len - r, a, b)
    } else {
        var dd: f64 = qx
        if qy > dd { dd = qy }
        cov = 0.5 - (dd - r)
    }
    if cov < 0.0 { cov = 0.0 }
    if cov > 1.0 { cov = 1.0 }
    return cov
}

// A ROUND RECTANGLE, filled from `top` to `bottom` (the same colour twice
// for a flat one). Canvas pixels; colours straight ARGB, alpha 0 = opaque.
fn rrect_fast(z: *mut painter.Painter, x: f64, y: f64, w: f64, h: f64,
    r0: f64, top: u32, bottom: u32) {
    if w <= 0.0 || h <= 0.0 {
        return
    }
    let cv: *mut canvas.Canvas = painter.painter_canvas(z)
    let cw: i64 = canvas.canvas_width(cv) as i64
    let ch: i64 = canvas.canvas_height(cv) as i64
    var r: f64 = r0
    var m: f64 = w
    if h < m { m = h }
    if r > m / 2.0 { r = m / 2.0 }
    if r < 0.0 { r = 0.0 }
    var bb: [i64; 4] = [0; 4]
    if !band_of(cv, flo(x) as f64, flo(y) as f64, (cei(x + w) - flo(x)) as f64,
        (cei(y + h) - flo(y)) as f64, &bb[0]) {
        return
    }
    let y0: i64 = bb[1]
    let y1: i64 = bb[3]
    let x0: i64 = bb[0]
    let x1: i64 = bb[2]
    let c0: u32 = solid(top)
    let c1: u32 = solid(bottom)
    let grad: bool = c0 != c1
    // the columns and rows that need the distance (the corner squares)
    let xl: i64 = cei(x + r)
    let xr: i64 = flo(x + w - r)
    let yt: i64 = cei(y + r)
    let yb: i64 = flo(y + h - r)
    // the columns that are wholly inside horizontally
    let ix0: i64 = cei(x)
    let ix1: i64 = flo(x + w)
    let cx: f64 = x + w / 2.0
    let cy: f64 = y + h / 2.0
    let hx: f64 = w / 2.0 - r
    let hy: f64 = h / 2.0 - r
    let px: u64 = canvas.canvas_pixels(cv) as u64
    let stride: i64 = cw * 4
    var yy: i64 = y0
    while yy < y1 {
        let pyc: f64 = (yy as f64) + 0.5
        var col: u32 = c0
        if grad {
            var t: f64 = (pyc - y) / h
            if t < 0.0 { t = 0.0 }
            if t > 1.0 { t = 1.0 }
            col = mix8(c0, c1, t)
        }
        let fy: f64 = ovl(yy as f64, (yy as f64) + 1.0, y, y + h)
        let corner: bool = yy < yt || yy >= yb
        let row: u64 = px + (yy * stride) as u64
        var xx: i64 = x0
        while xx < x1 {
            let p: u64 = row + (xx * 4) as u64
            if corner && (xx < xl || xx >= xr) {
                let cov: f64 = rbox_cov((xx as f64) + 0.5, pyc, cx, cy, hx, hy, r)
                if cov > 0.0 {
                    over(p, col, cov)
                }
                xx = xx + 1
                continue
            }
            if xx >= ix0 && xx < ix1 && fy >= 1.0 && ((col >> 24) & 255 as u32) == 255 as u32 {
                // THE RUN: every pixel up to the right edge column
                var e: i64 = ix1
                if corner && xr < e { e = xr }
                if e > x1 { e = x1 }
                let cw8: u64 = col as u64
                let word: u32 = (((cw8 >> 16) & 255) | (((cw8 >> 8) & 255) << 8) |
                    ((cw8 & 255) << 16) | 4278190080) as u32
                var q: u64 = p
                while xx < e {
                    *(q as *mut u32) = word
                    q = q + 4
                    xx = xx + 1
                }
                continue
            }
            let fx: f64 = ovl(xx as f64, (xx as f64) + 1.0, x, x + w)
            over(p, col, fx * fy)
            xx = xx + 1
        }
        yy = yy + 1
    }
}

// rbox_d with an octagon for the circle (max + 0.414 min, within 8 %):
// good enough for a shadow that is soft anyway, and no root per pixel
fn rbox_q(px: f64, py: f64, cx: f64, cy: f64, hx: f64, hy: f64, r: f64) -> f64 {
    var qx: f64 = px - cx
    if qx < 0.0 { qx = 0.0 - qx }
    qx = qx - hx
    var qy: f64 = py - cy
    if qy < 0.0 { qy = 0.0 - qy }
    qy = qy - hy
    var ox: f64 = qx
    if ox < 0.0 { ox = 0.0 }
    var oy: f64 = qy
    if oy < 0.0 { oy = 0.0 }
    var inside: f64 = qx
    if qy > inside { inside = qy }
    if inside > 0.0 { inside = 0.0 }
    var big: f64 = ox
    var small: f64 = oy
    if small > big {
        big = oy
        small = ox
    }
    return big + 0.414 * small + inside - r
}

// A SOFT SHADOW of a round card (x, y, w, h, r) that floats `lift` pixels
// over the page: the card's shape moved down by `lift`, its edge
// softened over `blur` pixels (a smoothstep of the signed distance -- the
// look of a gaussian, not its price), in `col` (straight ARGB, its alpha
// the darkest point). Only what the card will not cover is painted: the
// card itself is drawn over it right after.
fn rrect_shadow(z: *mut painter.Painter, x: f64, y: f64, w: f64, h: f64,
    r0: f64, lift: f64, blur: f64, col: u32) {
    if w <= 0.0 || h <= 0.0 || blur <= 0.0 {
        return
    }
    let cv: *mut canvas.Canvas = painter.painter_canvas(z)
    let cw: i64 = canvas.canvas_width(cv) as i64
    let ch: i64 = canvas.canvas_height(cv) as i64
    var r: f64 = r0
    var m: f64 = w
    if h < m { m = h }
    if r > m / 2.0 { r = m / 2.0 }
    let sy: f64 = y + lift
    // ONLY THE LOWER HALF: the card floats `lift` pixels up, so its
    // shadow shows under it and at its lower sides; above the middle the
    // card covers nearly all of it -- and that half was half the price
    var bb: [i64; 4] = [0; 4]
    let fy0: i64 = flo(y + h / 2.0)
    let fx0: i64 = flo(x - blur)
    if !band_of(cv, fx0 as f64, fy0 as f64, (cei(x + w + blur) - fx0) as f64,
        (cei(sy + h + blur) - fy0) as f64, &bb[0]) {
        return
    }
    let y0: i64 = bb[1]
    let y1: i64 = bb[3]
    let x0: i64 = bb[0]
    let x1: i64 = bb[2]
    let cx: f64 = x + w / 2.0
    let cy: f64 = sy + h / 2.0
    let ccy: f64 = y + h / 2.0 // the card
    let hx: f64 = w / 2.0 - r
    let hy: f64 = h / 2.0 - r
    // the band of each row that lies deep inside the card: skipped
    let inx0: i64 = cei(x + r + 1.0)
    let inx1: i64 = flo(x + w - r - 1.0)
    let px: u64 = canvas.canvas_pixels(cv) as u64
    let stride: i64 = cw * 4
    var yy: i64 = y0
    while yy < y1 {
        let pyc: f64 = (yy as f64) + 0.5
        let row: u64 = px + (yy * stride) as u64
        // a row wholly inside the card (away from its round ends) skips
        // its middle
        let deep: bool = pyc > y + 1.0 && pyc < y + h - 1.0
        var xx: i64 = x0
        while xx < x1 {
            if deep && xx >= inx0 && xx < inx1 {
                xx = inx1
                continue
            }
            let fx: f64 = (xx as f64) + 0.5
            // under the card: nothing to do
            if rbox_q(fx, pyc, cx, ccy, hx, hy, r) < 0.0 - 1.0 {
                xx = xx + 1
                continue
            }
            let d: f64 = rbox_q(fx, pyc, cx, cy, hx, hy, r)
            var t: f64 = (d + blur * 0.5) / (blur * 1.5)
            if t < 1.0 {
                if t < 0.0 { t = 0.0 }
                let cov: f64 = 1.0 - t * t * (3.0 - 2.0 * t)
                over(row + (xx * 4) as u64, col, cov)
            }
            xx = xx + 1
        }
        yy = yy + 1
    }
}

// A RAMP OF SHADE: `col` (straight ARGB, its alpha the strongest point)
// running out to nothing over the band. dir 0 = strongest at the top,
// 1 = at the bottom, 2 = at the left, 3 = at the right. The soft edge of
// a bar or a panel, in integers.
fn ramp_rect(z: *mut painter.Painter, x: f64, y: f64, w: f64, h: f64,
    col: u32, dir: u32) {
    let cv: *mut canvas.Canvas = painter.painter_canvas(z)
    var b: [i64; 4] = [0; 4]
    if !band_of(cv, x, y, w, h, &b[0]) {
        return
    }
    let px: u64 = canvas.canvas_pixels(cv) as u64
    let stride: i64 = (canvas.canvas_width(cv) as i64) * 4
    let ca: f64 = ((col >> 24) & 255 as u32) as f64
    let black: bool = (col & 16777215 as u32) == 0 as u32
    // the strength of every column (dir 2, 3) as an integer alpha, once
    var lut: [u32; 256] = [0; 256]
    let nx: i64 = b[2] - b[0]
    if (dir == 2 as u32 || dir == 3 as u32) && nx <= 256 {
        var j: i64 = 0
        while j < nx {
            let xx: i64 = b[0] + j
            var u: f64 = ((xx as f64) + 0.5 - x) / w
            if dir == 3 as u32 {
                u = (x + w - (xx as f64) - 0.5) / w
            }
            if u < 0.0 { u = 0.0 }
            if u > 1.0 { u = 1.0 }
            let k: f64 = 1.0 - u
            lut[j as usize] = (ca * k * k + 0.5) as u32
            j = j + 1
        }
    }
    let m: u64 = 16711935
    var yy: i64 = b[1]
    while yy < b[3] {
        let row: u64 = px + (yy * stride) as u64
        var ra: u32 = 0 as u32
        if dir == 0 as u32 || dir == 1 as u32 {
            var t: f64 = ((yy as f64) + 0.5 - y) / h
            if dir == 1 as u32 {
                t = (y + h - (yy as f64) - 0.5) / h
            }
            if t < 0.0 { t = 0.0 }
            if t > 1.0 { t = 1.0 }
            let k: f64 = 1.0 - t
            ra = (ca * k * k + 0.5) as u32
        }
        var xx: i64 = b[0]
        while xx < b[2] {
            var a: u32 = ra
            if dir == 2 as u32 || dir == 3 as u32 {
                if nx <= 256 {
                    a = lut[(xx - b[0]) as usize]
                } else {
                    var u: f64 = ((xx as f64) + 0.5 - x) / w
                    if dir == 3 as u32 {
                        u = (x + w - (xx as f64) - 0.5) / w
                    }
                    if u < 0.0 { u = 0.0 }
                    if u > 1.0 { u = 1.0 }
                    let k: f64 = 1.0 - u
                    a = (ca * k * k + 0.5) as u32
                }
            }
            if a > 0 as u32 {
                let p: u64 = row + (xx * 4) as u64
                if black {
                    // black over: d (255 - a) / 255, two lanes at a time
                    let d: u64 = (*(p as *mut u32)) as u64
                    let ia: u64 = 255 - a as u64
                    var lo: u64 = (d & m) * ia + 8388736
                    lo = ((lo + ((lo >> 8) & m)) >> 8) & m
                    var hi: u64 = ((d >> 8) & m) * ia + 8388736
                    hi = ((hi + ((hi >> 8) & m)) >> 8) & m
                    // the alpha lane went the same way: a + da (255 - a)
                    *(p as *mut u32) = ((lo | (hi << 8)) + ((a as u64) << 24)) as u32
                } else {
                    over(p, (col & 16777215 as u32) | 4278190080 as u32, (a as f64) / 255.0)
                }
            }
            xx = xx + 1
        }
        yy = yy + 1
    }
}

// SCROLL BY COPY: the block of columns [x0, x1) and rows [y0, y1) moves
// `d` rows down (up for a negative d) inside itself. The rows that come
// in from outside the block are left as they were -- the caller paints
// them. Rows are copied from the far end first, so nothing is read after
// it was overwritten.
fn shift_rows(z: *mut painter.Painter, x0: i64, x1: i64, y0: i64, y1: i64,
    d: i64) {
    let cv: *mut canvas.Canvas = painter.painter_canvas(z)
    let cw: i64 = canvas.canvas_width(cv) as i64
    let ch: i64 = canvas.canvas_height(cv) as i64
    var a: i64 = x0
    var e: i64 = x1
    var t: i64 = y0
    var u: i64 = y1
    if a < 0 { a = 0 }
    if e > cw { e = cw }
    if t < 0 { t = 0 }
    if u > ch { u = ch }
    if e <= a || u <= t || d == 0 {
        return
    }
    let px: u64 = canvas.canvas_pixels(cv) as u64
    let stride: i64 = cw * 4
    let n: usize = ((e - a) * 4) as usize
    if d > 0 {
        var yy: i64 = u - 1
        while yy - d >= t {
            copy_px(px + (yy * stride + a * 4) as u64,
                px + ((yy - d) * stride + a * 4) as u64, n)
            yy = yy - 1
        }
    } else {
        var yy: i64 = t
        while yy - d < u {
            copy_px(px + (yy * stride + a * 4) as u64,
                px + ((yy - d) * stride + a * 4) as u64, n)
            yy = yy + 1
        }
    }
}

// Einen Ausschnitt der Leinwand verwischen. Der Ausschnitt wird
// herauskopiert (damit die laufende Summe einen dichten Puffer hat),
// verwischt und zurueckgeschrieben.
fn blur_rect(cv: *mut canvas.Canvas, x0: i64, y0: i64, w: i64, h: i64,
    r: i64) -> bool {
    if w <= 0 || h <= 0 || r <= 0 {
        return true
    }
    let n: usize = (w * h * 4) as usize
    let a: *mut u8 = rt.heap_alloc(n) as *mut u8
    if a as usize == 0 {
        return false
    }
    let b: *mut u8 = rt.heap_alloc(n) as *mut u8
    if b as usize == 0 {
        rt.heap_free(a as u64, n)
        return false
    }
    hole(cv, x0, y0, w, h, a)
    blur_buffer(a, b, w as usize, h as usize, r)
    setze(cv, x0, y0, w, h, a)
    rt.heap_free(b as u64, n)
    rt.heap_free(a as u64, n)
    return true
}

// Ausschnitt heraus: ROH, premultipliziert, Rand fortgesetzt.
fn hole(cv: *mut canvas.Canvas, x0: i64, y0: i64, w: i64, h: i64,
    out: *mut u8) {
    let cw: i64 = canvas.canvas_width(cv) as i64
    let ch: i64 = canvas.canvas_height(cv) as i64
    let quelle: u64 = canvas.canvas_pixels(cv) as u64
    var y: i64 = 0
    while y < h {
        var sy: i64 = y0 + y
        if sy < 0 { sy = 0 }
        if sy > ch - 1 { sy = ch - 1 }
        var x: i64 = 0
        while x < w {
            var sx: i64 = x0 + x
            if sx < 0 { sx = 0 }
            if sx > cw - 1 { sx = cw - 1 }
            let s: u64 = quelle + ((sy * cw + sx) * 4) as u64
            let d: u64 = out as u64 + ((y * w + x) * 4) as u64
            st8(d, ld8(s))
            st8(d + 1, ld8(s + 1))
            st8(d + 2, ld8(s + 2))
            st8(d + 3, ld8(s + 3))
            x = x + 1
        }
        y = y + 1
    }
}

// und zurueck, ohne Mischen (der Ausschnitt ERSETZT).
fn setze(cv: *mut canvas.Canvas, x0: i64, y0: i64, w: i64, h: i64,
    src: *mut u8) {
    let cw: i64 = canvas.canvas_width(cv) as i64
    let ch: i64 = canvas.canvas_height(cv) as i64
    let ziel: u64 = canvas.canvas_pixels(cv) as u64
    var y: i64 = 0
    while y < h {
        let dy: i64 = y0 + y
        if dy >= 0 && dy < ch {
            var x: i64 = 0
            while x < w {
                let dx: i64 = x0 + x
                if dx >= 0 && dx < cw {
                    let s: u64 = src as u64 + ((y * w + x) * 4) as u64
                    let d: u64 = ziel + ((dy * cw + dx) * 4) as u64
                    st8(d, ld8(s))
                    st8(d + 1, ld8(s + 1))
                    st8(d + 2, ld8(s + 2))
                    st8(d + 3, ld8(s + 3))
                }
                x = x + 1
            }
        }
        y = y + 1
    }
}

// ============================================================ DER SCHATTEN
//
// Ein weicher Schatten unter einem abgerundeten Rechteck. Der Weg ist
// der von CSS `box-shadow`: die FORM wird in eine eigene, leere
// Leinwand gezeichnet, deren ALPHA verwischt, das Ergebnis mit der
// Schattenfarbe eingefaerbt, versetzt und UNTER das Ding gemalt.
//
// Warum eine eigene Leinwand: wer den Untergrund mitverwischt, zieht
// dessen Farbe in den Schatten. Der Schatten kennt nur die Form.
fn drop_shadow_round(z: *mut painter.Painter, x: f64, y: f64, w: f64,
    h: f64, radius: f64, dx: f64, dy: f64, blur: i64, col: u32) -> bool {
    return drop_shadow_spread(z, x, y, w, h, radius, dx, dy, blur, 0.0, col)
}

// Mit STREUUNG, wie die vierte Laenge in CSS `box-shadow`: die Form
// waechst vor dem Verwischen um `spread` nach allen vier Seiten (ein
// negativer Wert laesst sie schrumpfen). Das ist der Unterschied
// zwischen einem Schatten, der genau unter der Karte liegt, und einem,
// der wie ein Hof um sie herumsteht.
//
// Der Radius waechst mit: eine um 6 Punkte groessere Form mit
// unveraendertem Eckenradius haette spitzere Ecken als die Karte
// darueber, und genau das sieht man als Zipfel.
fn drop_shadow_spread(z: *mut painter.Painter, x: f64, y: f64, w: f64,
    h: f64, radius: f64, dx: f64, dy: f64, blur: i64, spread: f64,
    col: u32) -> bool {
    let fw: f64 = w + 2.0 * spread
    let fh: f64 = h + 2.0 * spread
    if fw <= 0.0 || fh <= 0.0 {
        return true
    }
    var fr: f64 = radius + spread
    if fr < 0.0 {
        fr = 0.0
    }
    var b: i64 = blur
    if b < 0 {
        b = 0
    }
    // Der Saum um die Form muss die ganze Unschaerfe fassen: drei
    // Kaesten der Halbbreite `blur` tragen genau 3*blur weit, plus zwei
    // Punkte Luft fuer die Kantenglaettung.
    let rand: i64 = b * 3 + 2
    let bw: i64 = (fw as i64) + 1 + 2 * rand
    let bh: i64 = (fh as i64) + 1 + 2 * rand
    var tmp: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&tmp, bw as usize, bh as usize) {
        return false
    }
    canvas.canvas_clear(&tmp, 0 as u32)
    var tz: painter.Painter = painter.painter_new()
    if !painter.painter_init(&tz, &tmp, bw as usize, bh as usize) {
        canvas.canvas_free(&tmp)
        return false
    }
    // Die Form in voller Deckkraft -- die Farbe kommt spaeter, sonst
    // mischt der Weichzeichner die Farbe mit dem Nichts daneben.
    painter.round_rect(&tz, rand as f64, rand as f64, fw, fh, fr,
        0xFFFFFFFF as u32)
    let n: usize = (bw * bh * 4) as usize
    let scratch: *mut u8 = rt.heap_alloc(n) as *mut u8
    if scratch as usize == 0 {
        painter.painter_free(&tz)
        canvas.canvas_free(&tmp)
        return false
    }
    blur_buffer(canvas.canvas_pixels(&tmp), scratch, bw as usize,
        bh as usize, b)
    rt.heap_free(scratch as u64, n)
    // Einfaerben und auf die Zielleinwand mischen.
    let zv: *mut canvas.Canvas = painter.painter_canvas(z)
    let sr: i64 = ((col >> 16) & 255 as u32) as i64
    let sg: i64 = ((col >> 8) & 255 as u32) as i64
    let sb: i64 = (col & 255 as u32) as i64
    let sa: i64 = ((col >> 24) & 255 as u32) as i64
    let quelle: u64 = canvas.canvas_pixels(&tmp) as u64
    // DER ZIELBEREICH WIRD GEKLEMMT, und zwar VOR der Schleife: wer
    // jedes Pixel einzeln auf "liegt es noch drin" prueft, laeuft bei
    // einem Schatten am linken Rand ueber Millionen Punkte, die
    // ohnehin verworfen werden -- und wer nur auf >= 0 prueft, laesst
    // die rechte Seite in die naechste Bildzeile umbrechen.
    let bx0: i64 = runde(x - spread + dx) - rand
    let by0: i64 = runde(y - spread + dy) - rand
    let cw: i64 = canvas.canvas_width(zv) as i64
    let ch: i64 = canvas.canvas_height(zv) as i64
    var i0: i64 = 0
    if bx0 < 0 {
        i0 = 0 - bx0
    }
    var i1: i64 = bw
    if bx0 + i1 > cw {
        i1 = cw - bx0
    }
    var j0: i64 = 0
    if by0 < 0 {
        j0 = 0 - by0
    }
    var j1: i64 = bh
    if by0 + j1 > ch {
        j1 = ch - by0
    }
    var j: i64 = j0
    while j < j1 {
        var i: i64 = i0
        while i < i1 {
            let a: i64 = ld8(quelle + ((j * bw + i) * 4 + 3) as u64) as i64
            if a != 0 {
                let deck: i64 = (a * sa + 127) / 255
                if deck != 0 {
                    canvas.canvas_blend(zv, (bx0 + i) as usize,
                        (by0 + j) as usize,
                        ((deck as u32) << 24) | ((sr as u32) << 16) |
                        ((sg as u32) << 8) | (sb as u32), 1.0)
                }
            }
            i = i + 1
        }
        j = j + 1
    }
    painter.painter_free(&tz)
    canvas.canvas_free(&tmp)
    return true
}

// ================================================================ GLAS
//
// `backdrop-filter: blur()`. Der UNTERGRUND unter dem Rechteck wird
// kopiert, verwischt, aufgehellt oder abgedunkelt und mit einem
// abgerundeten Rechteck zurueckmaskiert. Dass die Maske rund ist, ist
// der ganze Unterschied zwischen "Glasscheibe" und "grauer Fleck".
//
// `tint` ist die Farbe, die ueber die verwischte Kopie gelegt wird
// (0xAARRGGBB, Alpha entscheidet, wie stark).
fn backdrop_blur(z: *mut painter.Painter, x: f64, y: f64, w: f64, h: f64,
    radius: f64, blur: i64, tint: u32) -> bool {
    return glas_flaeche(z, x, y, w, h, radius, blur, tint, 1.0)
}

// Dasselbe, aber mit einer SAETTIGUNG auf der verwischten Kopie. Das
// ist der Punkt, an dem aus "verwischt" wirklich Glas wird: eine
// Milchscheibe nimmt dem Untergrund die Sattheit, eine Glasscheibe
// gibt sie ihm zurueck (Apples `backdrop-filter: blur() saturate(180%)`
// tut nichts anderes). Gerechnet wird mit der Farbmatrix aus dieser
// Datei -- kein zweiter Saettigungsregler.
fn glas_flaeche(z: *mut painter.Painter, x: f64, y: f64, w: f64, h: f64,
    radius: f64, blur: i64, tint: u32, sat: f64) -> bool {
    let iw: i64 = w as i64
    let ih: i64 = h as i64
    if iw <= 0 || ih <= 0 {
        return true
    }
    let zv: *mut canvas.Canvas = painter.painter_canvas(z)
    let n: usize = (iw * ih * 4) as usize
    let a: *mut u8 = rt.heap_alloc(n) as *mut u8
    if a as usize == 0 {
        return false
    }
    let b: *mut u8 = rt.heap_alloc(n) as *mut u8
    if b as usize == 0 {
        rt.heap_free(a as u64, n)
        return false
    }
    hole(zv, x as i64, y as i64, iw, ih, a)
    blur_buffer(a, b, iw as usize, ih as usize, blur)
    // Die verwischte Kopie durch die runde Maske zurueckmalen. Die
    // Maske entsteht aus derselben `round_rect`, die alles in fUi
    // rundet -- kein zweiter Eckenzeichner.
    //
    // VIER PUNKTE LUFT, und das ist kein Schoenheitsfehler: das
    // Rasterfenster in painter.raster_window nimmt fuer die
    // Kantenglaettung rundherum einen ganzen Punkt mehr und gibt auf,
    // wenn das Fenster GROESSER als die Leinwand wird. Eine Maske, die
    // genau so gross ist wie die Form, faellt dadurch still aus -- und
    // eine leere Maske heisst: gar kein Glas. Genau das war der Grund,
    // warum ueber dem Muster nichts zu sehen war: nicht die Unschaerfe
    // war zu schwach, es wurde gar nichts durchgelassen.
    let mw: i64 = iw + 4
    let mh: i64 = ih + 4
    var maske: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&maske, mw as usize, mh as usize) {
        rt.heap_free(b as u64, n)
        rt.heap_free(a as u64, n)
        return false
    }
    canvas.canvas_clear(&maske, 0 as u32)
    var mz: painter.Painter = painter.painter_new()
    if !painter.painter_init(&mz, &maske, mw as usize, mh as usize) {
        canvas.canvas_free(&maske)
        rt.heap_free(b as u64, n)
        rt.heap_free(a as u64, n)
        return false
    }
    painter.round_rect(&mz, 2.0, 2.0, w, h, radius, 0xFFFFFFFF as u32)
    let mp: u64 = canvas.canvas_pixels(&maske) as u64
    let ta: i64 = ((tint >> 24) & 255 as u32) as i64
    var cs: ColorMatrix = cm_saturate(sat)
    var j: i64 = 0
    while j < ih {
        var i: i64 = 0
        while i < iw {
            let m: i64 = ld8(mp + (((j + 2) * mw + i + 2) * 4 + 3) as u64) as i64
            if m != 0 {
                let s: u64 = a as u64 + ((j * iw + i) * 4) as u64
                let sa: i64 = ld8(s + 3) as i64
                var rr: i64 = ld8(s) as i64
                var gg: i64 = ld8(s + 1) as i64
                var bb: i64 = ld8(s + 2) as i64
                // Die Kopie liegt premultipliziert vor; die Toenung und
                // die Saettigung rechnen gerade. Also erst gerade
                // machen -- sonst wirkt beides auf halbdurchsichtigen
                // Stellen doppelt.
                if sa > 0 && sa < 255 {
                    rr = rr * 255 / sa
                    gg = gg * 255 / sa
                    bb = bb * 255 / sa
                }
                if sat != 1.0 {
                    let neu: u32 = cm_apply_pixel(&cs,
                        (255 as u32 << 24) | ((rr as u32) << 16) |
                        ((gg as u32) << 8) | (bb as u32))
                    rr = ((neu >> 16) & 255 as u32) as i64
                    gg = ((neu >> 8) & 255 as u32) as i64
                    bb = (neu & 255 as u32) as i64
                }
                // Die Tönung: ueber die verwischte Kopie, mit ihrem
                // eigenen Alpha gewichtet.
                if ta != 0 {
                    rr = rr + (((tint >> 16) & 255 as u32) as i64 - rr) * ta / 255
                    gg = gg + (((tint >> 8) & 255 as u32) as i64 - gg) * ta / 255
                    bb = bb + ((tint & 255 as u32) as i64 - bb) * ta / 255
                }
                let px: i64 = runde(x) + i
                let py: i64 = runde(y) + j
                // Ueber 255 kann keiner der drei Werte bleiben: sonst
                // laufen die Kanaele beim Zusammenschieben ineinander
                // und aus zu hellem Rot wird Gruen.
                if rr > 255 { rr = 255 }
                if gg > 255 { gg = 255 }
                if bb > 255 { bb = 255 }
                if rr < 0 { rr = 0 }
                if gg < 0 { gg = 0 }
                if bb < 0 { bb = 0 }
                if px >= 0 && py >= 0 {
                    canvas.canvas_blend(zv, px as usize, py as usize,
                        ((255 as u32) << 24) | ((rr as u32) << 16) |
                        ((gg as u32) << 8) | (bb as u32),
                        (m as f64) / 255.0)
                }
            }
            i = i + 1
        }
        j = j + 1
    }
    painter.painter_free(&mz)
    canvas.canvas_free(&maske)
    rt.heap_free(b as u64, n)
    rt.heap_free(a as u64, n)
    return true
}

// ------------------------------------------------- DIE FERTIGE SCHEIBE
//
// `backdrop_blur` allein sah ueber dem gemusterten Grund noch nach
// "leicht unscharf" aus und nicht nach Glas. Es fehlten genau drei
// Dinge, und alle drei haben einen Grund:
//
//   1. GENUG UNSCHAERFE. Unter einem Kastenradius von etwa einem
//      Zehntel der Scheibenbreite bleibt das Muster als Muster
//      erkennbar; erst darueber wird es zu Farbwolken. Deshalb waechst
//      der Radius hier mit der Scheibe mit und wird nur nach unten
//      begrenzt.
//   2. GENUG TOENUNG, und zwar in die richtige Richtung: auf hellem
//      Grund wird milchig-weiss aufgehellt, auf dunklem tief
//      abgedunkelt. Eine weisse Toenung im dunklen Thema macht aus der
//      Scheibe einen grauen Fleck -- das ist genau der Fehler, den
//      Justin im ersten Bild gesehen hat.
//   3. EIN FEINER RAND. Echtes Glas hat eine Kante, an der sich das
//      Licht bricht: aussen eine haarfeine dunkle Linie, innen ein
//      heller Streifen. Ohne diese zwei Linien schwimmt die Scheibe im
//      Untergrund, mit ihnen liegt sie darauf.
//
// Die Saettigung von 1.4 haelt die Farben des Untergrunds am Leben;
// ohne sie wird jede Scheibe grau, weil Verwischen Farben mittelt.
fn glass_round(z: *mut painter.Painter, x: f64, y: f64, w: f64, h: f64,
    radius: f64, dark: bool) -> bool {
    if w <= 0.0 || h <= 0.0 {
        return true
    }
    // Der Radius waechst mit der Scheibe, bleibt aber in einem Band:
    // unter 6 bleibt das Muster ein Muster, ueber 14 wird aus dem
    // Untergrund eine strukturlose Wolke und man sieht nicht mehr, dass
    // ueberhaupt etwas dahinter liegt.
    var kurz: f64 = w
    if h < kurz {
        kurz = h
    }
    var r: i64 = (kurz / 10.0) as i64
    if r < 6 {
        r = 6
    }
    if r > 14 {
        r = 14
    }
    var tint: u32 = 0x7AFFFFFF as u32
    var aussen: u32 = 0x22000000 as u32
    var innen: u32 = 0xA0FFFFFF as u32
    if dark {
        tint = 0x8C10141B as u32
        aussen = 0x60000000 as u32
        innen = 0x33FFFFFF as u32
    }
    if !glas_flaeche(z, x, y, w, h, radius, r, tint, 1.4) {
        return false
    }
    painter.round_ring(z, x, y, w, h, radius, 1.0, aussen)
    if w > 2.0 && h > 2.0 {
        painter.round_ring(z, x + 1.0, y + 1.0, w - 2.0, h - 2.0,
            radius - 1.0, 1.0, innen)
    }
    return true
}

// ========================================================= DIE FARBMATRIX
//
// Vier Zeilen zu fuenf Spalten, wie `feColorMatrix`: die letzte Spalte
// ist der Versatz. Saettigung, Helligkeit, Kontrast und Graustufe sind
// nur BELEGUNGEN dieser einen Matrix -- deshalb gibt es sie nicht als
// vier eigene Schleifen ueber die Pixel, sondern als vier Bauer.
struct ColorMatrix {
    m: [f64; 20],
}

fn cm_identity() -> ColorMatrix {
    var c: ColorMatrix = ColorMatrix { m: [0.0; 20] }
    c.m[0] = 1.0
    c.m[6] = 1.0
    c.m[12] = 1.0
    c.m[18] = 1.0
    return c
}

// Die Leuchtdichtefaktoren sind die von Rec.709, dieselben, die
// lib/fui/theme.fi fuer den Kontrast benutzt.
fn cm_saturate(s: f64) -> ColorMatrix {
    var c: ColorMatrix = cm_identity()
    let lr: f64 = 0.2126
    let lg: f64 = 0.7152
    let lb: f64 = 0.0722
    c.m[0] = lr + (1.0 - lr) * s
    c.m[1] = lg - lg * s
    c.m[2] = lb - lb * s
    c.m[5] = lr - lr * s
    c.m[6] = lg + (1.0 - lg) * s
    c.m[7] = lb - lb * s
    c.m[10] = lr - lr * s
    c.m[11] = lg - lg * s
    c.m[12] = lb + (1.0 - lb) * s
    return c
}

fn cm_grayscale() -> ColorMatrix {
    return cm_saturate(0.0)
}

fn cm_brightness(b: f64) -> ColorMatrix {
    var c: ColorMatrix = cm_identity()
    c.m[0] = b
    c.m[6] = b
    c.m[12] = b
    return c
}

// Kontrast dreht um die Mitte 0.5: y = (x - 0.5) * k + 0.5.
fn cm_contrast(k: f64) -> ColorMatrix {
    var c: ColorMatrix = cm_identity()
    let o: f64 = 0.5 - 0.5 * k
    c.m[0] = k
    c.m[6] = k
    c.m[12] = k
    c.m[4] = o
    c.m[9] = o
    c.m[14] = o
    return c
}

// Erst `a`, dann `b`. (Die Reihenfolge ist die, die man beim Lesen
// erwartet: cm_mul(saturate, contrast) heisst "saettigen, dann
// kontrastieren".)
fn cm_mul(a: ColorMatrix, b: ColorMatrix) -> ColorMatrix {
    var c: ColorMatrix = ColorMatrix { m: [0.0; 20] }
    var z: usize = 0
    while z < 4 {
        var s: usize = 0
        while s < 5 {
            var summe: f64 = 0.0
            var i: usize = 0
            while i < 4 {
                summe = summe + b.m[z * 5 + i] * a.m[i * 5 + s]
                i = i + 1
            }
            if s == 4 {
                summe = summe + b.m[z * 5 + 4]
            }
            c.m[z * 5 + s] = summe
            s = s + 1
        }
        z = z + 1
    }
    return c
}

fn klemme8(v: f64) -> u32 {
    var x: f64 = v * 255.0 + 0.5
    if x < 0.0 {
        x = 0.0
    }
    if x > 255.0 {
        x = 255.0
    }
    return (x as i64) as u32
}

// Ein einzelnes Pixel, 0xAARRGGBB NICHT premultipliziert -- so lassen
// sich Sollwerte von Hand nachrechnen, und genau das tut die Pruefung.
fn cm_apply_pixel(c: *mut ColorMatrix, px: u32) -> u32 {
    let r: f64 = (((px >> 16) & 255 as u32) as f64) / 255.0
    let g: f64 = (((px >> 8) & 255 as u32) as f64) / 255.0
    let b: f64 = ((px & 255 as u32) as f64) / 255.0
    let a: f64 = (((px >> 24) & 255 as u32) as f64) / 255.0
    let nr: f64 = (*c).m[0] * r + (*c).m[1] * g + (*c).m[2] * b + (*c).m[3] * a + (*c).m[4]
    let ng: f64 = (*c).m[5] * r + (*c).m[6] * g + (*c).m[7] * b + (*c).m[8] * a + (*c).m[9]
    let nb: f64 = (*c).m[10] * r + (*c).m[11] * g + (*c).m[12] * b + (*c).m[13] * a + (*c).m[14]
    let na: f64 = (*c).m[15] * r + (*c).m[16] * g + (*c).m[17] * b + (*c).m[18] * a + (*c).m[19]
    return (klemme8(na) << 24) | (klemme8(nr) << 16) | (klemme8(ng) << 8) |
        klemme8(nb)
}

// Auf einen Rechteckbereich der Leinwand. Die Leinwand liegt
// PREMULTIPLIED vor, die Matrix rechnet gerade -- also heraus, rechnen,
// wieder hinein.
fn cm_apply_rect(cv: *mut canvas.Canvas, c: *mut ColorMatrix, x0: i64,
    y0: i64, w: i64, h: i64) {
    let cw: i64 = canvas.canvas_width(cv) as i64
    let ch: i64 = canvas.canvas_height(cv) as i64
    let p: u64 = canvas.canvas_pixels(cv) as u64
    var y: i64 = y0
    while y < y0 + h {
        if y >= 0 && y < ch {
            var x: i64 = x0
            while x < x0 + w {
                if x >= 0 && x < cw {
                    let d: u64 = p + ((y * cw + x) * 4) as u64
                    let a: i64 = ld8(d + 3) as i64
                    if a != 0 {
                        // gerade machen
                        let rr: u32 = ((ld8(d) as i64) * 255 / a) as u32
                        let gg: u32 = ((ld8(d + 1) as i64) * 255 / a) as u32
                        let bb: u32 = ((ld8(d + 2) as i64) * 255 / a) as u32
                        let neu: u32 = cm_apply_pixel(c,
                            ((a as u32) << 24) | (rr << 16) | (gg << 8) | bb)
                        let na: i64 = ((neu >> 24) & 255 as u32) as i64
                        st8(d, ((((neu >> 16) & 255 as u32) as i64) * na / 255) as u8)
                        st8(d + 1, ((((neu >> 8) & 255 as u32) as i64) * na / 255) as u8)
                        st8(d + 2, (((neu & 255 as u32) as i64) * na / 255) as u8)
                        st8(d + 3, na as u8)
                    }
                }
                x = x + 1
            }
        }
        y = y + 1
    }
}
