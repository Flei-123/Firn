import std.rt
import services.svc
import services.svcdir
import services.svcmut
import fui.memtree
import fui.svcpath

export {
    use_memory_tree, use_auto, native_available, memory_tree_active, list, make_dir, rename, remove, read_file,
    can_list, can_mutate, backend_label,
}

static mut G_MEMORY_TREE: bool = false

fn use_memory_tree(on: bool) {
    G_MEMORY_TREE = on
}

fn native_available() -> bool {
    return svc.has(svc.CAP_DIR_LIST) && svc.has(svc.CAP_DIR_MUTATE)
}

fn use_auto() {
    G_MEMORY_TREE = !native_available()
}

fn memory_tree_active() -> bool {
    return G_MEMORY_TREE
}

fn can_list() -> bool {
    return G_MEMORY_TREE || svc.has(svc.CAP_DIR_LIST)
}

fn can_mutate() -> bool {
    return G_MEMORY_TREE || svc.has(svc.CAP_DIR_MUTATE)
}

fn backend_label() -> str {
    if G_MEMORY_TREE {
        return "sample files (in memory)"
    }
    return "this computer"
}

fn list(path: str, out: *mut rt.Buf) -> i32 {
    if G_MEMORY_TREE {
        return memtree.list(path, out)
    }
    return svcdir.list(path, out)
}

fn make_dir(path: str) -> i32 {
    if G_MEMORY_TREE {
        return memtree.make_dir(path)
    }
    return svcmut.make_dir(path)
}

fn rename(from: str, to: str) -> i32 {
    if G_MEMORY_TREE {
        return memtree.rename(from, to)
    }
    return svcmut.rename(from, to)
}

fn remove(path: str) -> i32 {
    if G_MEMORY_TREE {
        return memtree.remove(path)
    }
    return svcmut.remove(path)
}

fn read_file(path: str, out: *mut rt.Buf) -> bool {
    if G_MEMORY_TREE {
        return memtree.read_file(path, out) == svc.OK
    }
    return svcpath.read_path(path, out)
}
