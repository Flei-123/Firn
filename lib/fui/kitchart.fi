// SPDX-License-Identifier: MPL-2.0
// lib/fui/kitchart.fi -- CHART SHAPES for app screens: filled polygon, thick polyline, ring sector.
//
//   fill_poly(c, xs, ys, n, col)              n <= MAXP points, any simple polygon
//   fill_poly_grad(c, xs, ys, n, top, bot, y0, y1)   the same with a vertical ramp top -> bot (opaque colours) from y0 to y1
//   polyline(c, xs, ys, n, width, col)        a line of `width` (left to right is cleanest)
//   sector(c, cx, cy, r_in, r_out, a0, a1, col)   a donut piece, angles in radians (0 = right, clockwise)
//
// Coordinates are pixels; colours 0xAARRGGBB like the rest of fui.
import std.math
import fui.painter
import fui.render
import font.raster

export { fill_poly, fill_poly_grad, polyline, sector, MAXP }

const MAXP: usize = 512

fn lo(a: f64, b: f64) -> f64 {
    if a < b { return a }
    return b
}

fn hi(a: f64, b: f64) -> f64 {
    if a > b { return a }
    return b
}

fn poly_raster(c: *mut render.Ctx, xs: *mut [f64; 512], ys: *mut [f64; 512], n: usize, wx: *mut f64, wy: *mut f64) -> bool {
    if n < 3 { return false }
    let z: *mut painter.Painter = render.ctx_painter(c)
    var x0: f64 = (*xs)[0]
    var x1: f64 = x0
    var y0: f64 = (*ys)[0]
    var y1: f64 = y0
    var i: usize = 1
    while i < n {
        x0 = lo(x0, (*xs)[i])
        x1 = hi(x1, (*xs)[i])
        y0 = lo(y0, (*ys)[i])
        y1 = hi(y1, (*ys)[i])
        i = i + 1
    }
    if !painter.raster_window(z, x0, y0, x1 - x0, y1 - y0, 2.0, wx, wy) { return false }
    i = 0
    while i < n {
        let j: usize = (i + 1) % n
        raster.raster_line(&(*z).ra, (*xs)[i], (*ys)[i], (*xs)[j], (*ys)[j])
        i = i + 1
    }
    raster.raster_finish(&(*z).ra)
    return true
}

fn fill_poly(c: *mut render.Ctx, xs: *mut [f64; 512], ys: *mut [f64; 512], n: usize, col: u32) {
    var wx: f64 = 0.0
    var wy: f64 = 0.0
    if !poly_raster(c, xs, ys, n, &wx, &wy) { return }
    let z: *mut painter.Painter = render.ctx_painter(c)
    painter.painter_fill_raster(z, &(*z).ra, wx as usize, wy as usize, col)
}

fn fill_poly_grad(c: *mut render.Ctx, xs: *mut [f64; 512], ys: *mut [f64; 512], n: usize, top: u32, bot: u32, y0: f64, y1: f64) {
    var wx: f64 = 0.0
    var wy: f64 = 0.0
    if !poly_raster(c, xs, ys, n, &wx, &wy) { return }
    painter.fill_raster_gradient(render.ctx_painter(c), wx, wy, top, bot, y0, y1)
}

// One quad per segment, same winding for every segment that runs left to right.
fn polyline(c: *mut render.Ctx, xs: *mut [f64; 512], ys: *mut [f64; 512], n: usize, width: f64, col: u32) {
    var qx: [f64; 512] = [0.0; 512]
    var qy: [f64; 512] = [0.0; 512]
    let hw: f64 = width / 2.0
    var i: usize = 0
    while i + 1 < n {
        var dx: f64 = (*xs)[i + 1] - (*xs)[i]
        var dy: f64 = (*ys)[i + 1] - (*ys)[i]
        var l: f64 = math.sqrt(dx * dx + dy * dy)
        if l < 0.001 { l = 1.0 }
        dx = dx / l
        dy = dy / l
        let nx: f64 = (0.0 - dy) * hw
        let ny: f64 = dx * hw
        // extend by half a width at both ends so joints stay closed
        let ax: f64 = (*xs)[i] - dx * hw
        let ay: f64 = (*ys)[i] - dy * hw
        let bx: f64 = (*xs)[i + 1] + dx * hw
        let by: f64 = (*ys)[i + 1] + dy * hw
        qx[0] = ax + nx
        qy[0] = ay + ny
        qx[1] = bx + nx
        qy[1] = by + ny
        qx[2] = bx - nx
        qy[2] = by - ny
        qx[3] = ax - nx
        qy[3] = ay - ny
        fill_poly(c, &qx, &qy, 4, col)
        i = i + 1
    }
}

fn sector(c: *mut render.Ctx, cx: f64, cy: f64, r_in: f64, r_out: f64, a0: f64, a1: f64, col: u32) {
    var px: [f64; 512] = [0.0; 512]
    var py: [f64; 512] = [0.0; 512]
    var steps: usize = (((a1 - a0) * r_out) / 3.0) as usize + 2
    if steps > 200 { steps = 200 }
    var i: usize = 0
    while i <= steps {
        let a: f64 = a0 + (a1 - a0) * (i as f64) / (steps as f64)
        px[i] = cx + r_out * math.cos(a)
        py[i] = cy + r_out * math.sin(a)
        px[steps + 1 + i] = cx + r_in * math.cos(a1 - (a1 - a0) * (i as f64) / (steps as f64))
        py[steps + 1 + i] = cy + r_in * math.sin(a1 - (a1 - a0) * (i as f64) / (steps as f64))
        i = i + 1
    }
    fill_poly(c, &px, &py, 2 * steps + 2, col)
}
