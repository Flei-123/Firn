// SPDX-License-Identifier: MPL-2.0
import fui.ds_navview
import fui.ds_touchtrack
import fui.ds_vgrid
import fui.kit
import fui.render
import fui.viewport

export {
    Targets, Rig, rig_new, down, move, up, cancel, tick, moving, stop_all,
    T_NONE, T_SHOTS, T_PAGE, T_GRID, T_NAV, UP_NONE, UP_TAP, UP_PAN,
}

const T_NONE: u32 = 0
const T_SHOTS: u32 = 1
const T_PAGE: u32 = 2
const T_GRID: u32 = 3
const T_NAV: u32 = 4
const UP_NONE: u32 = 0
const UP_TAP: u32 = 1
const UP_PAN: u32 = 2
const FLING_DP: usize = 160

struct Targets {
    shots: *mut viewport.Viewport,
    page: *mut viewport.Viewport,
    grid: *mut ds_vgrid.Grid,
    nav: *mut ds_navview.NavView,
    detail: bool,
    sx: f64,
    sy: f64,
    sw: f64,
    sh: f64,
}

struct Rig {
    track: ds_touchtrack.Track,
    target: u32,
    id: u32,
}

fn rig_new() -> Rig {
    return Rig { track: ds_touchtrack.track_new(), target: T_NONE, id: 0 as u32 }
}

fn stop_all(tg: *mut Targets) {
    viewport.viewport_drag((*tg).shots, 0.0, 0.0, 0 as i64)
    viewport.viewport_drag((*tg).page, 0.0, 0.0, 0 as i64)
    ds_vgrid.stop((*tg).grid)
}

fn down(r: *mut Rig, tg: *mut Targets, x: f64, y: f64, us: i64) {
    ds_touchtrack.track_down(&(*r).track, x, y, us)
    (*r).target = T_NONE
    stop_all(tg)
}

fn inside_shots(tg: *mut Targets, x: f64, y: f64) -> bool {
    return x >= (*tg).sx && x < (*tg).sx + (*tg).sw && y >= (*tg).sy && y < (*tg).sy + (*tg).sh
}

fn pick(r: *mut Rig, tg: *mut Targets, axis: u32) -> u32 {
    let x0: f64 = ds_touchtrack.track_x0(&(*r).track)
    let y0: f64 = ds_touchtrack.track_y0(&(*r).track)
    if (*tg).detail {
        if axis == ds_touchtrack.AXIS_X {
            if inside_shots(tg, x0, y0) { return T_SHOTS }
            return T_NONE
        }
        return T_PAGE
    }
    if axis == ds_touchtrack.AXIS_X { return T_NONE }
    if x0 < ds_navview.content_x((*tg).nav) { return T_NAV }
    return T_GRID
}

fn drag_view(vp: *mut viewport.Viewport, dx: f64, dy: f64, ms: i64) {
    viewport.viewport_set_overscroll(vp, true)
    viewport.viewport_drag(vp, 0.0 - dx, 0.0 - dy, ms)
}

fn move(r: *mut Rig, tg: *mut Targets, c: *mut render.Ctx, x: f64, y: f64, us: i64) -> bool {
    var d: [f64; 2] = [0.0; 2]
    let axis: u32 = ds_touchtrack.track_move(&(*r).track, c, x, y, us, &d)
    if axis == ds_touchtrack.AXIS_NONE { return false }
    if (*r).target == T_NONE { (*r).target = pick(r, tg, axis) }
    let ms: i64 = us / 1000 as i64
    if (*r).target == T_SHOTS { drag_view((*tg).shots, d[0], 0.0, ms) }
    if (*r).target == T_PAGE { drag_view((*tg).page, 0.0, d[1], ms) }
    if (*r).target == T_GRID { ds_vgrid.pan((*tg).grid, d[1], ms) }
    if (*r).target == T_NAV { ds_navview.pan((*tg).nav, ds_touchtrack.track_x0(&(*r).track), ds_touchtrack.track_y0(&(*r).track), d[1], ms) }
    return (*r).target != T_NONE
}

fn fling_view(vp: *mut viewport.Viewport, vx: f64, vy: f64, ms: i64, ppi: f64) {
    if viewport.viewport_over_x(vp) != 0.0 || viewport.viewport_over_y(vp) != 0.0 { return }
    viewport.viewport_fling_android(vp, 0.0 - vx, 0.0 - vy, ms, ppi)
}

fn up(r: *mut Rig, tg: *mut Targets, c: *mut render.Ctx, us: i64) -> u32 {
    var v: [f64; 2] = [0.0; 2]
    let was_on: bool = ds_touchtrack.track_on(&(*r).track)
    let moved: bool = ds_touchtrack.track_up(&(*r).track, us, &v)
    if !was_on { return UP_NONE }
    if !moved { return UP_TAP }
    var speed: f64 = v[1]
    if ds_touchtrack.track_axis(&(*r).track) == ds_touchtrack.AXIS_X { speed = v[0] }
    if speed < 0.0 { speed = 0.0 - speed }
    if speed < ds_touchtrack.FLING_MIN_PER_MS {
        (*r).target = T_NONE
        return UP_PAN
    }
    let ms: i64 = us / 1000 as i64
    let ppi: f64 = kit.ln(c, FLING_DP)
    let t: u32 = (*r).target
    (*r).target = T_NONE
    if t == T_SHOTS { fling_view((*tg).shots, v[0], 0.0, ms, ppi) }
    if t == T_PAGE { fling_view((*tg).page, 0.0, v[1], ms, ppi) }
    if t == T_GRID { ds_vgrid.fling((*tg).grid, v[1] * 1000.0, ms) }
    if t == T_NAV { ds_navview.fling((*tg).nav, v[1] * 1000.0, ms, ppi) }
    return UP_PAN
}

fn cancel(r: *mut Rig) {
    var v: [f64; 2] = [0.0; 2]
    ds_touchtrack.track_up(&(*r).track, 0 as i64, &v)
    (*r).target = T_NONE
}

fn tick(tg: *mut Targets, ms: i64) -> bool {
    var ch: bool = false
    if viewport.viewport_tick((*tg).shots, ms) { ch = true }
    if viewport.viewport_tick((*tg).page, ms) { ch = true }
    if ds_vgrid.tick((*tg).grid, ms) { ch = true }
    if ds_navview.tick((*tg).nav, ms) { ch = true }
    return ch
}

fn moving(tg: *mut Targets) -> bool {
    return viewport.viewport_moving((*tg).shots) || viewport.viewport_moving((*tg).page) || ds_vgrid.moving((*tg).grid)
}
