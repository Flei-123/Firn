// SPDX-License-Identifier: MPL-2.0
// lib/fui/kittabs.fi -- a horizontal page strip for narrow screens (phones): the side navigation turns into equal tabs.
//
//   compact      is the window too narrow for a side column
//   tabs_draw    the strip, one tab per "|"-separated label
//   tabs_hit     which tab is under (x, y); kit.NONE when none
import fui.kit
import fui.kitform
import fui.painter
import fui.render
import fui.screenax
import fui.style
import fui.widget

fn compact(c: *mut render.Ctx, w: f64) -> bool {
    return kit.narrow(c, w)
}

fn tabs_height(c: *mut render.Ctx) -> f64 {
    return kit.ln(c, 44)
}

fn tabs_count(labels: str) -> usize {
    var n: usize = 1
    var i: usize = 0
    while i < labels.n {
        if *((labels.p as u64 + i as u64) as *mut u8) == 124 as u8 { n = n + 1 }
        i = i + 1
    }
    return n
}

fn tabs_hit(c: *mut render.Ctx, labels: str, first: usize, x0: f64, y0: f64, w: f64, x: f64, y: f64) -> usize {
    if y < y0 || y >= y0 + tabs_height(c) || x < x0 || x >= x0 + w { return kit.NONE }
    let n: usize = tabs_count(labels) - first
    let i: usize = ((x - x0) / (w / n as f64)) as usize
    if i >= n { return kit.NONE }
    return first + i
}

fn tabs_draw(c: *mut render.Ctx, labels: str, first: usize, active: usize, hover: usize, x0: f64, y0: f64, w: f64) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let h: f64 = tabs_height(c)
    painter.surface(z, x0, y0, w, h, kit.tokc(c, style.TOK_SURFACE))
    painter.surface(z, x0, y0 + h - kit.ln(c, 1), w, kit.ln(c, 1), kit.tokc(c, style.TOK_SEPARATOR))
    let total: usize = tabs_count(labels)
    let n: usize = total - first
    let tw: f64 = w / n as f64
    var i: usize = first
    while i < total {
        let tx: f64 = x0 + (i - first) as f64 * tw
        let name: str = kitform.nth(labels, i)
        let on: bool = i == active
        var flags: u32 = screenax.F_MENUITEM
        if on { flags = flags | screenax.F_SELECTED }
        screenax.note(widget.KIND_BUTTON, flags, name, tx, y0, tw, h, 0)
        var tok: u32 = style.TOK_TEXT_MUTED
        var wt: usize = 400
        if on {
            tok = style.TOK_TEXT
            wt = 600
            painter.round_rect(z, tx + kit.ln(c, 4), y0 + kit.ln(c, 6), tw - kit.ln(c, 8), h - kit.ln(c, 12), kit.ln(c, 8), kit.tokc(c, style.TOK_BUTTON))
        } else if i == hover {
            painter.round_rect(z, tx + kit.ln(c, 4), y0 + kit.ln(c, 6), tw - kit.ln(c, 8), h - kit.ln(c, 12), kit.ln(c, 8), kit.tokc(c, style.TOK_SELECTION))
        }
        let size: f64 = kit.ln(c, 12)
        let lw: f64 = kit.text_width(c, size, wt, name)
        kit.draw_label(c, tx + (tw - lw) / 2.0, y0, h, size, wt, kit.tokc(c, tok), name, tw)
        i = i + 1
    }
}
