// SPDX-License-Identifier: MPL-2.0
import fui.ds_icons
import fui.ds_icons_names
import std.rt
import fui.ds_appcard
import fui.ds_catalog_tok
import fui.ds_iconbtn
import fui.ds_navview
import fui.ds_touchtrack
import fui.ds_tpl_run
import fui.ds_tpl_shots
import fui.ds_tpl_touch
import fui.ds_vgrid
import fui.editor
import fui.event
import fui.kit
import fui.kitapp
import fui.kitform
import fui.painter
import fui.render
import fui.screen
import fui.screenanim
import fui.screenext
import fui.screenax
import fui.style
import fui.viewport
import fui.widget
import plat.fuiwirt

export {
    Item, Spec, Store, store_new, store_run, paint, paint_in, press, key, text, wheel, pointer, open_detail, close_detail, select_cat, set_query,
    in_detail, detail_index, category, NONE, ID_BACK,
    touch_down, touch_move, touch_up, touch_pointer, tick, moving, grid_scroll_y, page_scroll_y, shots_scroll_x,
}

const NONE: usize = 18446744073709551615
const ID_BACK: usize = 1
const SLOTS: usize = 48
const SHOT_NAMES: str = "Screenshot 1|Screenshot 2|Screenshot 3|Screenshot 4|Screenshot 5|Screenshot 6|Screenshot 7|Screenshot 8"
const F_NAV: u32 = 0
const F_SEARCH: u32 = 1
const F_GRID: u32 = 2

struct Item {
    icon: i64,
    name: str,
    sub: str,
    meta: str,
    desc: str,
    state: u32,
    permille: i64,
}

struct Spec {
    ud: u64,
    title: str,
    cats: str,
    icons: [i64; 8],
    foot: str,
    foot_icon: i64,
    hint: str,
    shots: usize,
    count: fn(u64, usize, str) -> usize,
    item: fn(u64, usize, str, usize, *mut Item),
    act: fn(u64, usize, str, usize, u32),
}

struct Store {
    spec: Spec,
    nav: ds_navview.NavView,
    grid: ds_vgrid.Grid,
    field: *mut kit.Search,
    back: *mut ds_iconbtn.Btns,
    cards: [ds_appcard.Card; 48],
    shots: viewport.Viewport,
    page: viewport.Viewport,
    rig: ds_tpl_touch.Rig,
    tg: ds_tpl_touch.Targets,
    cat: usize,
    detail: usize,
    focus: u32,
    big_down: bool,
    ctx: u64,
    fx: f64,
    fy: f64,
    fw: f64,
    fh: f64,
    bx: f64,
    by: f64,
    bw: f64,
    bh: f64,
    sx: f64,
    sy: f64,
    sw: f64,
    sh: f64,
}

fn blank_item() -> Item {
    return Item { icon: ds_icons.gid(ds_icons_names.APPS), name: "", sub: "", meta: "", desc: "", state: ds_appcard.S_INSTALL, permille: 0 as i64 }
}

fn store_new(spec: Spec) -> *mut Store {
    let s: *mut Store = rt.heap_alloc(1 << 16) as *mut Store
    (*s).spec = spec
    (*s).nav = ds_navview.nv_new()
    (*s).grid = ds_vgrid.grid_new()
    ds_vgrid.set_cell(&(*s).grid, 240, 148, 12)
    ds_vgrid.set_pad(&(*s).grid, 24)
    (*s).field = kitform.field_new()
    (*s).back = ds_iconbtn.btns_new()
    var i: usize = 0
    while i < SLOTS {
        (*s).cards[i] = ds_appcard.card_new()
        i = i + 1
    }
    (*s).shots = viewport.viewport_new(0.0, 0.0, 100.0, 100.0, 100.0, 100.0)
    (*s).page = viewport.viewport_new(0.0, 0.0, 100.0, 100.0, 100.0, 100.0)
    (*s).rig = ds_tpl_touch.rig_new()
    (*s).tg = ds_tpl_touch.Targets { shots: &(*s).shots, page: &(*s).page, grid: &(*s).grid, nav: &(*s).nav, detail: false, sx: 0.0, sy: 0.0, sw: 0.0, sh: 0.0 }
    (*s).cat = 0
    (*s).detail = NONE
    (*s).focus = F_GRID
    (*s).big_down = false
    (*s).ctx = 0
    (*s).fx = 0.0
    (*s).fy = 0.0
    (*s).fw = 0.0
    (*s).fh = 0.0
    (*s).bx = 0.0
    (*s).by = 0.0
    (*s).bw = 0.0
    (*s).bh = 0.0
    (*s).sx = 0.0
    (*s).sy = 0.0
    (*s).sw = 0.0
    (*s).sh = 0.0
    var k: usize = 0
    while k < ds_tpl_run.count_of(spec.cats) {
        ds_navview.add(&(*s).nav, spec.icons[k], kitform.nth(spec.cats, k))
        k = k + 1
    }
    if spec.foot.n > 0 { ds_navview.add_footer(&(*s).nav, spec.foot_icon, spec.foot) }
    return s
}

fn query(s: *mut Store) -> str { return kitform.field_text((*s).field) }

fn category(s: *mut Store) -> usize { return (*s).cat }
fn in_detail(s: *mut Store) -> bool { return (*s).detail != NONE }
fn detail_index(s: *mut Store) -> usize { return (*s).detail }

fn item_at(s: *mut Store, i: usize, out: *mut Item) {
    *out = blank_item()
    ((*s).spec.item)((*s).spec.ud, (*s).cat, query(s), i, out)
}

fn select_cat(s: *mut Store, k: usize) {
    if k >= ds_tpl_run.count_of((*s).spec.cats) { return }
    (*s).cat = k
    (*s).detail = NONE
    ds_navview.select(&(*s).nav, k)
    ds_vgrid.select(&(*s).grid, ds_vgrid.NONE)
    ds_vgrid.scroll_by(&(*s).grid, 0.0 - 1000000.0)
}

fn set_query(s: *mut Store, q: str) {
    kit.search_set_text((*s).field, q)
    ds_vgrid.scroll_by(&(*s).grid, 0.0 - 1000000.0)
}

fn open_detail(s: *mut Store, i: usize) {
    (*s).detail = i
    (*s).shots = viewport.viewport_new(0.0, 0.0, 100.0, 100.0, 100.0, 100.0)
    viewport.viewport_set_offset(&(*s).page, 0.0, 0.0)
    ds_navview.set_back(&(*s).nav, true)
}

fn close_detail(s: *mut Store) {
    (*s).detail = NONE
    ds_navview.set_back(&(*s).nav, false)
}

fn draw_catalog(s: *mut Store, c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, px: f64, py: f64) {
    let minimal: bool = ds_navview.mode(&(*s).nav) == ds_navview.MODE_MINIMAL
    var pad: f64 = kit.ln(c, 24)
    if minimal { pad = kit.ln(c, 16) }
    let head: f64 = kit.ln(c, 40)
    let title: str = kitform.nth((*s).spec.cats, (*s).cat)
    kitapp.heading_text(c, x + pad, y + pad, head, 28, title)
    var sw: f64 = kit.ln(c, 320)
    var sx: f64 = x + w - pad - sw
    var sy: f64 = y + pad + (head - kit.ln(c, 38)) / 2.0
    var gy: f64 = y + pad + head + kit.ln(c, 8)
    if minimal || sw > w - pad * 2.0 - kit.ln(c, 160) {
        sw = w - pad * 2.0
        sx = x + pad
        sy = y + pad + head + kit.ln(c, 4)
        gy = sy + kit.ln(c, 38) + kit.ln(c, 8)
    }
    (*s).fx = sx
    (*s).fy = sy
    (*s).fw = sw
    (*s).fh = kit.ln(c, 38)
    kit.search_focus((*s).field, (*s).focus == F_SEARCH)
    kit.search_draw(c, (*s).field, sx, sy, sw, (*s).fh, (*s).spec.hint, false)
    let q: str = query(s)
    let n: usize = ((*s).spec.count)((*s).spec.ud, (*s).cat, q)
    ds_vgrid.set_count(&(*s).grid, n)
    ds_vgrid.set_cell(&(*s).grid, 240, ds_appcard.preferred_h(c) as usize, 12)
    ds_vgrid.layout(&(*s).grid, c, x, gy, w, y + h - gy)
    ds_vgrid.move(&(*s).grid, px, py)
    if ds_vgrid.begin(&(*s).grid, c, title) {
        var i: usize = ds_vgrid.first(&(*s).grid)
        let e: usize = ds_vgrid.end_index(&(*s).grid)
        while i < e {
            var it: Item = blank_item()
            ((*s).spec.item)((*s).spec.ud, (*s).cat, q, i, &it)
            var r: [f64; 4] = [0.0; 4]
            ds_vgrid.cell_rect(&(*s).grid, i, &r)
            let card: *mut ds_appcard.Card = &(*s).cards[i % SLOTS]
            ds_appcard.set_state(card, it.state)
            ds_appcard.set_progress(card, it.permille)
            ds_appcard.draw(card, c, r[0], r[1], r[2], r[3], it.icon, it.name, it.sub, it.meta, px, py)
            i = i + 1
        }
    }
    ds_vgrid.finish(&(*s).grid, c)
}

fn section_label(c: *mut render.Ctx, x: f64, y: f64, s: str) {
    kitapp.heading_text(c, x, y, kit.ln(c, 24), 16, s)
}

fn draw_shot(c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, n: usize) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    painter.round_rect(z, x, y, w, h, ds_catalog_tok.radius_card(c), ds_catalog_tok.raised(c))
    painter.round_ring(z, x, y, w, h, ds_catalog_tok.radius_card(c), kit.ln(c, 1), ds_catalog_tok.separator(c))
    let inset: f64 = kit.ln(c, 12)
    ds_tpl_shots.draw(c, x + inset, y + inset, w - inset * 2.0, n)
    let cap: str = kitform.nth(SHOT_NAMES, n)
    kit.draw_label(c, x + inset, y + h - kit.ln(c, 40), kit.ln(c, 32), kit.ln(c, 13), 400, ds_catalog_tok.muted(c), cap, w - kit.ln(c, 24))
}

fn big_button(s: *mut Store, c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, state: u32, px: f64, py: f64) {
    (*s).bx = x
    (*s).by = y
    (*s).bw = w
    (*s).bh = h
    var st: u32 = 0 as u32
    if px >= x && px < x + w && py >= y && py < y + h { st = kit.ST_HOVER }
    if (*s).big_down { st = st | kit.ST_ACTIVE }
    var kind: u32 = kit.BTN_PRIMARY
    if state == ds_appcard.S_INSTALLING || state == ds_appcard.S_UNAVAILABLE { kind = kit.BTN_SECONDARY }
    if state == ds_appcard.S_UNAVAILABLE { st = st | kit.ST_DISABLED }
    var label: str = ds_appcard.label_of(state)
    if state == ds_appcard.S_INSTALLING { label = "Cancel" }
    kit.button_draw(c, x, y, w, h, label, 0 - 1, kind, st)
}

fn draw_detail(s: *mut Store, c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, px: f64, py: f64) {
    var it: Item = blank_item()
    item_at(s, (*s).detail, &it)
    let minimal: bool = ds_navview.mode(&(*s).nav) == ds_navview.MODE_MINIMAL
    var pad: f64 = kit.ln(c, 24)
    if minimal { pad = kit.ln(c, 16) }
    let tile: f64 = kit.ln(c, 96)
    let btn_h: f64 = kit.ln(c, 40)
    var btn_w: f64 = kit.ln(c, 160)
    if minimal { btn_w = w - pad * 2.0 }
    let shot_h: f64 = kit.ln(c, 200)
    let desc_w: f64 = ds_tpl_run.min_f(w - pad * 2.0, kit.ln(c, 720))
    let line_h: f64 = kit.ln(c, 22)
    let tsize: f64 = render.tsz(c, kit.ln(c, 14))
    var run: painter.TextRun = painter.run_new(tsize)
    let lines: usize = painter.run_line_count(render.ctx_painter(c), &run, it.desc.p as u64, it.desc.n, desc_w, 8)
    let total: f64 = pad + kit.ln(c, 32) + kit.ln(c, 12) + tile + kit.ln(c, 20) + btn_h + kit.ln(c, 28) + kit.ln(c, 32) + shot_h
        + kit.ln(c, 12) + kit.ln(c, 16) + kit.ln(c, 32) + (lines as f64) * line_h + pad
    viewport.viewport_set_bar(&(*s).page, kit.ln(c, 12) as usize)
    viewport.viewport_set_rect(&(*s).page, x, y, w, h)
    viewport.viewport_set_content(&(*s).page, w, total)
    var cy: f64 = viewport.viewport_content_y(&(*s).page) + pad
    let cx: f64 = x + pad
    if viewport.viewport_begin(c, &(*s).page) {
        ds_iconbtn.begin((*s).back, c, px, py)
        ds_iconbtn.add((*s).back, c, ID_BACK, cx, cy, ds_icons.gid(ds_icons_names.BACK), "Back", false, true)
        ds_iconbtn.end((*s).back, c)
        cy = cy + kit.ln(c, 32) + kit.ln(c, 12)
        let z: *mut painter.Painter = render.ctx_painter(c)
        painter.round_rect(z, cx, cy, tile, tile, kit.ln(c, 20), ds_catalog_tok.accent_tint(c))
        let isz: f64 = tile / 2.0
        kit.sym(c, it.icon, cx + (tile - isz) / 2.0, cy + (tile - isz) / 2.0, isz, ds_catalog_tok.accent(c))
        let nx: f64 = cx + tile + kit.ln(c, 16)
        let room: f64 = x + w - pad - nx
        screenax.note(widget.KIND_LABEL, screenax.F_HEADING, it.name, nx, cy, room, kit.ln(c, 40), 0)
        kit.draw_label(c, nx, cy + kit.ln(c, 6), kit.ln(c, 40), kit.ln(c, 28), 700, ds_catalog_tok.text(c), it.name, room)
        kit.draw_label(c, nx, cy + kit.ln(c, 46), kit.ln(c, 24), kit.ln(c, 14), 400, ds_catalog_tok.muted(c), it.sub, room)
        kit.draw_label(c, nx, cy + kit.ln(c, 70), kit.ln(c, 22), kit.ln(c, 13), 400, ds_catalog_tok.muted(c), it.meta, room)
        cy = cy + tile + kit.ln(c, 20)
        big_button(s, c, cx, cy, btn_w, btn_h, it.state, px, py)
        cy = cy + btn_h + kit.ln(c, 28)
        section_label(c, cx, cy, "Screenshots")
        cy = cy + kit.ln(c, 32)
        let sw: f64 = ds_tpl_run.min_f(kit.ln(c, 320), w - pad * 2.0 - kit.ln(c, 40))
        let gap: f64 = kit.ln(c, 12)
        (*s).sx = x
        (*s).sy = cy
        (*s).sw = w
        (*s).sh = shot_h
        viewport.viewport_set_rect(&(*s).shots, x, cy, w, shot_h + kit.ln(c, 12))
        viewport.viewport_set_content(&(*s).shots, pad * 2.0 + ((*s).spec.shots as f64) * (sw + gap) - gap, shot_h)
        if viewport.viewport_begin(c, &(*s).shots) {
            var k: usize = 0
            let ox: f64 = viewport.viewport_content_x(&(*s).shots)
            while k < (*s).spec.shots {
                draw_shot(c, ox + pad + (k as f64) * (sw + gap), cy, sw, shot_h, k)
                k = k + 1
            }
            viewport.viewport_end(c, &(*s).shots)
        }
        cy = cy + shot_h + kit.ln(c, 12) + kit.ln(c, 16)
        section_label(c, cx, cy, "Description")
        cy = cy + kit.ln(c, 32)
        painter.run_draw_wrapped(z, &run, cx, painter.text_baseline_mid(z, cy, line_h, tsize), desc_w, line_h, ds_catalog_tok.text(c),
            it.desc.p as u64, it.desc.n, painter.TEXT_L, 8)
        viewport.viewport_end(c, &(*s).page)
    }
    viewport.viewport_draw_bars(c, &(*s).page)
}

fn paint_in(ud: u64, c: *mut render.Ctx, ox: f64, oy: f64, w: f64, h: f64, px: f64, py: f64) {
    let s: *mut Store = ud as *mut Store
    (*s).ctx = c as u64
    ds_tpl_touch.tick(&(*s).tg, render.ctx_time(c))
    painter.surface(render.ctx_painter(c), ox, oy, w, h, kit.tokc(c, style.TOK_BASE))
    ds_navview.layout(&(*s).nav, c, ox, oy, w, h)
    ds_navview.draw(&(*s).nav, c, px, py)
    let x: f64 = ds_navview.content_x(&(*s).nav)
    let y: f64 = ds_navview.content_y(&(*s).nav)
    let cw: f64 = ds_navview.content_w(&(*s).nav)
    let ch: f64 = ds_navview.content_h(&(*s).nav)
    if (*s).detail != NONE { draw_detail(s, c, x, y, cw, ch, px, py) } else { draw_catalog(s, c, x, y, cw, ch, px, py) }
    ds_navview.draw_overlay(&(*s).nav, c, px, py)
    (*s).tg.detail = (*s).detail != NONE
    (*s).tg.sx = (*s).sx
    (*s).tg.sy = (*s).sy
    (*s).tg.sw = (*s).sw
    (*s).tg.sh = (*s).sh
    if ds_tpl_touch.moving(&(*s).tg) { screenanim.want(c, render.ctx_time(c) + 16) }
}

fn paint(ud: u64, c: *mut render.Ctx, w: f64, h: f64, px: f64, py: f64) {
    paint_in(ud, c, 0.0, 0.0, w, h, px, py)
}

fn fire_item(s: *mut Store, i: usize, action: u32) {
    ((*s).spec.act)((*s).spec.ud, (*s).cat, query(s), i, action)
}

fn press_detail(s: *mut Store, c: *mut render.Ctx, x: f64, y: f64) {
    if viewport.viewport_bar_press(c, &(*s).page, x, y) { return }
    if ds_iconbtn.click((*s).back, x, y) == ID_BACK {
        close_detail(s)
        return
    }
    if ds_tpl_run.inside(x, y, (*s).bx, (*s).by, (*s).bw, (*s).bh) {
        var it: Item = blank_item()
        item_at(s, (*s).detail, &it)
        fire_item(s, (*s).detail, ds_appcard.action_of(it.state))
    }
}

fn press_catalog(s: *mut Store, c: *mut render.Ctx, x: f64, y: f64) {
    let hit: u32 = kit.search_press(c, (*s).field, (*s).fx, (*s).fy, (*s).fw, (*s).fh, x, y, (ds_tpl_run.now_ms() * 1000) as u64)
    if hit != kit.SEARCH_HIT_NONE {
        (*s).focus = F_SEARCH
        if hit == kit.SEARCH_HIT_CLEAR { ds_vgrid.scroll_by(&(*s).grid, 0.0 - 1000000.0) }
        return
    }
    let i: usize = ds_vgrid.press(&(*s).grid, x, y)
    if i == ds_vgrid.NONE { return }
    (*s).focus = F_GRID
    let a: u32 = ds_appcard.click(&(*s).cards[i % SLOTS], x, y)
    if a == ds_appcard.ACT_CARD {
        open_detail(s, i)
    } else if a != ds_appcard.ACT_NONE {
        fire_item(s, i, a)
    }
}

fn press(ud: u64, x: f64, y: f64) {
    let s: *mut Store = ud as *mut Store
    let c: *mut render.Ctx = (*s).ctx as *mut render.Ctx
    let ev: u32 = ds_navview.press(&(*s).nav, x, y)
    if ev == ds_navview.EV_SELECT {
        let k: usize = ds_navview.selected(&(*s).nav)
        if ds_navview.is_footer(&(*s).nav, k) { return }
        select_cat(s, k)
        (*s).focus = F_NAV
        return
    }
    if ev == ds_navview.EV_BACK {
        close_detail(s)
        return
    }
    if ev != ds_navview.EV_NONE || ds_navview.overlay_open(&(*s).nav) { return }
    if (*s).detail != NONE { press_detail(s, c, x, y) } else { press_catalog(s, c, x, y) }
}

fn cycle_focus(s: *mut Store) {
    if (*s).focus == F_NAV { (*s).focus = F_SEARCH } else if (*s).focus == F_SEARCH { (*s).focus = F_GRID } else { (*s).focus = F_NAV }
}

fn key_detail(s: *mut Store, k: u32, mods: u32) -> bool {
    if k == editor.KEY_ESC || k == editor.KEY_BACKSPACE {
        close_detail(s)
        return true
    }
    if k == editor.KEY_ENTER {
        var it: Item = blank_item()
        item_at(s, (*s).detail, &it)
        fire_item(s, (*s).detail, ds_appcard.action_of(it.state))
        return true
    }
    if ds_iconbtn.key((*s).back, k, mods) {
        if ds_iconbtn.fired((*s).back) == ID_BACK { close_detail(s) }
        return true
    }
    return viewport.viewport_key(&(*s).page, k)
}

fn key_search(s: *mut Store, k: u32, mods: u32) -> bool {
    if k == editor.KEY_TAB {
        cycle_focus(s)
        return true
    }
    let r: u32 = kit.search_key((*s).field, k, mods)
    if r == editor.RES_CHANGED { ds_vgrid.scroll_by(&(*s).grid, 0.0 - 1000000.0) }
    return r != editor.RES_PASS
}

fn key(ud: u64, k: u32, mods: u32) -> bool {
    let s: *mut Store = ud as *mut Store
    if ds_navview.overlay_open(&(*s).nav) {
        return ds_navview.key(&(*s).nav, k, mods) != ds_navview.EV_NONE
    }
    if (*s).detail != NONE { return key_detail(s, k, mods) }
    if (*s).focus == F_SEARCH { return key_search(s, k, mods) }
    if k == editor.KEY_TAB {
        cycle_focus(s)
        return true
    }
    if (*s).focus == F_NAV {
        let ev: u32 = ds_navview.key(&(*s).nav, k, mods)
        if ev == ds_navview.EV_SELECT {
            select_cat(s, ds_navview.selected(&(*s).nav))
            return true
        }
        return ev != ds_navview.EV_NONE
    }
    if k == editor.KEY_ENTER && ds_vgrid.selected(&(*s).grid) != ds_vgrid.NONE {
        open_detail(s, ds_vgrid.selected(&(*s).grid))
        return true
    }
    return ds_vgrid.key(&(*s).grid, k, mods)
}

fn text(ud: u64, cp: u32, mods: u32) -> bool {
    let s: *mut Store = ud as *mut Store
    if (*s).detail != NONE || (*s).focus != F_SEARCH { return false }
    kit.search_char((*s).field, cp, mods)
    ds_vgrid.scroll_by(&(*s).grid, 0.0 - 1000000.0)
    return true
}

fn wheel(ud: u64, px: f64, py: f64, dx: f64, dy: f64) -> bool {
    let s: *mut Store = ud as *mut Store
    let c: *mut render.Ctx = (*s).ctx as *mut render.Ctx
    let step: f64 = kit.ln(c, 48)
    if ds_navview.wheel(&(*s).nav, px, py, dy) { return true }
    if (*s).detail != NONE {
        if dx != 0.0 && ds_tpl_run.inside(px, py, (*s).sx, (*s).sy, (*s).sw, (*s).sh) {
            viewport.viewport_scroll_by(&(*s).shots, dx * step, 0.0)
        } else {
            viewport.viewport_scroll_by(&(*s).page, 0.0, dy * step)
        }
        return true
    }
    ds_vgrid.scroll_by(&(*s).grid, dy * step)
    return true
}

fn pointer(ud: u64, kind: u32, x: f64, y: f64) -> bool {
    let s: *mut Store = ud as *mut Store
    let c: *mut render.Ctx = (*s).ctx as *mut render.Ctx
    if kind == fuiwirt.HOOK_UP {
        ds_vgrid.release(&(*s).grid)
        viewport.viewport_bar_release(&(*s).page)
        return true
    }
    if kind == fuiwirt.HOOK_MOVE {
        if (*s).detail != NONE { return viewport.viewport_bar_drag(c, &(*s).page, x, y) }
        return ds_vgrid.drag(&(*s).grid, x, y)
    }
    return false
}

fn grid_scroll_y(ud: u64) -> f64 { return ds_vgrid.scroll_y(&(*(ud as *mut Store)).grid) }
fn page_scroll_y(ud: u64) -> f64 { return viewport.viewport_off_y(&(*(ud as *mut Store)).page) }
fn shots_scroll_x(ud: u64) -> f64 { return viewport.viewport_off_x(&(*(ud as *mut Store)).shots) }

fn tick(ud: u64, ms: i64) -> bool {
    let s: *mut Store = ud as *mut Store
    return ds_tpl_touch.tick(&(*s).tg, ms)
}

fn moving(ud: u64) -> bool {
    let s: *mut Store = ud as *mut Store
    return ds_tpl_touch.moving(&(*s).tg)
}

fn touch_down(ud: u64, x: f64, y: f64, us: i64) {
    let s: *mut Store = ud as *mut Store
    ds_tpl_touch.down(&(*s).rig, &(*s).tg, x, y, us)
}

fn touch_move(ud: u64, x: f64, y: f64, us: i64) -> bool {
    let s: *mut Store = ud as *mut Store
    return ds_tpl_touch.move(&(*s).rig, &(*s).tg, (*s).ctx as *mut render.Ctx, x, y, us)
}

fn touch_up(ud: u64, x: f64, y: f64, us: i64) -> bool {
    let s: *mut Store = ud as *mut Store
    let r: u32 = ds_tpl_touch.up(&(*s).rig, &(*s).tg, (*s).ctx as *mut render.Ctx, us)
    if r == ds_tpl_touch.UP_TAP {
        press(ud, ds_touchtrack.track_x0(&(*s).rig.track), ds_touchtrack.track_y0(&(*s).rig.track))
        pointer(ud, fuiwirt.HOOK_UP, x, y)
    }
    return r != ds_tpl_touch.UP_NONE
}

fn touch_pointer(ud: u64, kind: u32, id: u32, ptype: u32, x: f64, y: f64, pressure: f64) -> bool {
    if ptype != event.PT_TOUCH { return false }
    let s: *mut Store = ud as *mut Store
    if (*s).ctx == 0 { return false }
    let us: i64 = render.ctx_time((*s).ctx as *mut render.Ctx) * 1000 as i64
    if kind == fuiwirt.PE_DOWN {
        if ds_touchtrack.track_on(&(*s).rig.track) { return true }
        (*s).rig.id = id
        touch_down(ud, x, y, us)
        return true
    }
    if !ds_touchtrack.track_on(&(*s).rig.track) || id != (*s).rig.id { return true }
    if kind == fuiwirt.PE_MOVE { touch_move(ud, x, y, us) }
    if kind == fuiwirt.PE_UP { touch_up(ud, x, y, us) }
    if kind == fuiwirt.PE_CANCEL { ds_tpl_touch.cancel(&(*s).rig) }
    return true
}

fn store_run(start: u64, window_title: str, spec: Spec) -> i32 {
    let s: *mut Store = store_new(spec)
    let k: i64 = ds_tpl_run.arg_num(start, "--cat")
    if k >= 0 { select_cat(s, k as usize) }
    let q: str = ds_tpl_run.arg_str(start, "--query")
    if q.n > 0 { set_query(s, q) }
    let d: i64 = ds_tpl_run.arg_num(start, "--detail")
    if d >= 0 { open_detail(s, d as usize) }
    return screen.run_ext(start, window_title, 1100, 700, s as u64, paint, press, key, text, wheel, pointer, screenext.extras_pointers(screenext.extras_blank(), touch_pointer), ds_tpl_run.skin)
}
