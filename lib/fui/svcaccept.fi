import std.rt

export { from_filters }

const BAR: u8 = 124
const SEMI: u8 = 59
const STAR: u8 = 42
const COMMA: u8 = 44

fn from_filters(filters: str, out: *mut rt.Buf) {
    var i: usize = 0
    while i < filters.n && filters.chars(i) != BAR {
        i = i + 1
    }
    i = i + 1
    while i < filters.n && filters.chars(i) != BAR {
        let c: u8 = filters.chars(i)
        i = i + 1
        if c == STAR {
            continue
        }
        if c == SEMI {
            rt.buf_push(out, COMMA)
            continue
        }
        rt.buf_push(out, c)
    }
}
