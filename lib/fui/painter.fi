// SPDX-License-Identifier: MPL-2.0
// lib/fui/painter.fi -- THE DRAWING LAYER OF fUi.
//
// ========================================================= WHY IT EXISTS
//
// lib/fenster/fenster.fi says outright in F1 what it does NOT do:
//
//     "NO drawing except pixels, rectangles and system text. Whoever
//      wants curves rasterises them himself and pushes the finished
//      buffer across with `bild`."
//
// Exactly that "rasterises them himself" stands here. Every control in
// fUi paints EXCLUSIVELY through this file -- no widget sets a pixel
// itself.
//
// THAT IS THE RULE THIS IS ABOUT. In OrientOS the control centre paints
// its own tiles instead of using `paint_button`, and that is why they
// look different from every other button in the system. In Certus the
// bar painted its buttons itself, and lib/android/ui.fi did it once
// more. Three drawings of the same thing. Whoever paints past this file
// builds the same mistake in.
//
// ====================================================== WHAT IT DRAWS
//
// Everything antialiased through the rasteriser Certus also paints the
// page with (lib/font/raster.fi) -- no GDI, no Xlib, no system font.
//
//   surface          a rectangle
//   round_rect       a rectangle with round corners
//   round_ring       its outline (for the focus ring)
//   border_col       a horizontal or vertical line
//   text             text with an alignment, on a baseline
//   text_width       how wide it would be -- for the layout
//   caret_bar        the caret
//
// ================================= THE FOUR CORNERS WITHOUT lib/svg
//
// Certus rounds with `svg.pfad.pfad_rund_rechteck`. THIS PARAGRAPH USED
// TO SAY that lib/svg does not exist in the Firn tree -- it did not
// when the file was written, but it does since the port in `2b82d78e`,
// and a reason that has stopped being true is worse than none. The
// corners stay here anyway, for the reason that actually carries:
//
// this file is the layer every widget draws through, and it draws
// STRAIGHT INTO THE RASTERISER with four cubics and no allocation.
// `svg.pfad` is the other direction -- a path object that is built,
// kept and handed to a filler, which is what a DOCUMENT needs and what
// a button does not. Pulling it in here would hang the drawing layer of
// every control on the SVG stack (path, stroke, paint, xml) for four
// corner arcs.
//
// Where lib/svg genuinely OWNS something, fUi uses it and does not
// write a second copy: `lib/fui/transform.fi` takes all of its matrix
// arithmetic from `lib/svg/matrix.fi`. The rule is one place per thing,
// not one library per tree.
//
// The factor 0.5523 is the well known one: a cubic Bezier meets a
// quarter circle with an error under 0.03 % of the radius when the
// control points lie at 4/3 * (sqrt(2) - 1) = 0.55228... of the edge
// length. That is not an approximation by feel but the number every
// vector drawing program uses.
//
// =============================================== THE TEXT SITS CENTRED
//
// Justin, 10.09.2026: in OrientOS the label does not sit in the middle
// of the button. That is a mistake fUi must not inherit, and it has a
// known cause: whoever centres vertically by the LINE HEIGHT centres
// the line and not the font.
//
// Right is the FONT METRIC. A capital letter stands on the baseline and
// reaches `ascent` upwards; `descent` hangs below it and is not used at
// all by "Button". The optical middle of a line therefore lies at
//
//     baseline = y + (h + ascent - descent) / 2
//
// and NOT at `y + h/2 + size/2`. `text_baseline_mid` computes exactly
// that, and `tools/fui/preview_main.fi` measures on the finished
// picture afterwards that as many empty rows stand above as below.
import std.rt
import paint.canvas
import font.raster
import font.metrics
import font.ttf
import font.gsub
import str.ucd_bidi
import fui.theme
import fui.bidi
import fui.shape

export {
    Painter, painter_new, painter_init, painter_free, painter_ok,
    painter_canvas, painter_set_font, painter_font,
    surface, round_rect, round_ring, border_col, mit_alpha,
    round_rect_grad, mix_argb,
    text, text_width, text_fits_upto, text_baseline_mid,
    TEXT_L, TEXT_M, TEXT_R,
    caret_bar,
    font_ascent, font_descent,
    TextRun, run_new, run_plain,
    run_set_tracking, run_set_word_spacing, run_set_kerning,
    run_set_weight, run_set_slant, run_set_line_height,
    run_set_outline, run_set_shadow, run_set_gradient,
    run_width, run_fits_upto, run_draw, run_line_height,
    run_fits_ellipsis, run_draw_ellipsis, ellipsis_w,
    run_line_upto, run_line_count, run_draw_wrapped,
    advance_of, pair_kern,
    // DIE ZWEIRICHTUNGSSCHRIFT (siehe "DER BIDI-WEG" weiter unten)
    run_set_dir, run_dir, run_caret_x, run_hit, run_para_rtl,
    run_sel_draw, run_is_bidi, BIDI_CAP,
    Measure, measure_new, measure_x, measure_hit, measure_width,
    measure_rtl,
}

// The alignment horizontally. Vertically there is only one sensible
// one (centred to the font metric), so it is not a choice.
const TEXT_L: u32 = 0
const TEXT_M: u32 = 1
const TEXT_R: u32 = 2

// The scratch buffer of the TrueType reader. The same number as in
// lib/browser/chrome.fi -- it is enough for every glyph of a user
// interface.
const SCRATCH: usize = 65536

struct Painter {
    cv: u64,          // the canvas, owned by the caller
    ra: raster.Raster,
    rbuf: *mut u8,
    rcap: usize,
    scratch: *mut u8,
    fm: u64,          // the font set (metrics.FontSet), 0 = none
    w: usize,
    h: usize,
    ok: usize,
    // ---- DER BIDI-WEG (siehe dort). Die Tabelle aus der UCD, der
    // Arbeitsraum fuer BIDI_CAP Zeichen, und was gerade darin steht.
    bt: u64,          // ucd_bidi.ucd_bidi_map, 0 = keine Tabelle
    bx: u64,          // bidi_bytes() Oktette
    bn: usize,        // vorbereitete Zeichen, 0 = der alte Weg
    blev: u8,         // Absatzebene des ersten Absatzes
    bvn: usize,       // sichtbare Glyphen der zuletzt gelegten Zeile
    gs: gsub.Gsub,    // die arabischen Lookups der Schrift
    gs_fm: u64,       // fuer welche Schrift `gs` gilt
}

#[no_gc]
fn painter_new() -> Painter {
    return Painter {
        cv: 0, ra: raster.raster_new(), rbuf: 0 as *mut u8, rcap: 0,
        scratch: 0 as *mut u8, fm: 0, w: 0, h: 0, ok: 0,
        bt: 0, bx: 0, bn: 0, blev: 0 as u8, bvn: 0,
        gs: gsub.gsub_new(), gs_fm: 0,
    }
}

// `w` x `h` is the largest area rasterised at once. That is NOT the
// canvas: what gets rasterised is always only the rectangle of one
// widget, and a button is seldom bigger than a few hundred pixels.
// Whoever gives the whole canvas pays (w + 2) * h * 8 bytes for
// nothing.
fn painter_init(z: *mut Painter, cv: *mut canvas.Canvas, w: usize,
    h: usize) -> bool {
    (*z).cv = cv as u64
    (*z).w = w
    (*z).h = h
    let need: usize = raster.raster_bytes_needed(w, h)
    (*z).rbuf = rt.heap_alloc(need) as *mut u8
    if (*z).rbuf as usize == 0 {
        return false
    }
    (*z).rcap = need
    raster.raster_attach(&(*z).ra, (*z).rbuf, need)
    (*z).scratch = rt.heap_alloc(SCRATCH) as *mut u8
    if (*z).scratch as usize == 0 {
        return false
    }
    // DIE BIDI-TABELLE UND IHR ARBEITSRAUM. Scheitert eines davon, malt
    // dieser Maler weiter -- aber jeden Text von links nach rechts, wie
    // vor der Bidi-Runde. Das ist kein stiller Ersatz: `run_is_bidi`
    // sagt es, und tools/fui/bidi_main.fi prueft es.
    (*z).bt = ucd_bidi.ucd_bidi_map()
    if (*z).bt != 0 {
        (*z).bx = rt.heap_alloc(bidi_bytes())
        if (*z).bx == 0 {
            ucd_bidi.ucd_bidi_free((*z).bt)
            (*z).bt = 0
        }
    }
    (*z).ok = 1
    return true
}

fn painter_free(z: *mut Painter) {
    if (*z).rbuf as usize != 0 {
        rt.heap_free((*z).rbuf as u64, (*z).rcap)
        (*z).rbuf = 0 as *mut u8
    }
    if (*z).scratch as usize != 0 {
        rt.heap_free((*z).scratch as u64, SCRATCH)
        (*z).scratch = 0 as *mut u8
    }
    if (*z).bx != 0 {
        rt.heap_free((*z).bx, bidi_bytes())
        (*z).bx = 0
    }
    if (*z).bt != 0 {
        ucd_bidi.ucd_bidi_free((*z).bt)
        (*z).bt = 0
    }
    (*z).ok = 0
}

#[no_gc]
fn painter_ok(z: *mut Painter) -> bool { return (*z).ok != 0 }

#[no_gc]
fn painter_canvas(z: *mut Painter) -> *mut canvas.Canvas {
    return (*z).cv as *mut canvas.Canvas
}

#[no_gc]
fn painter_set_font(z: *mut Painter, fm: u64) { (*z).fm = fm }

#[no_gc]
fn painter_font(z: *mut Painter) -> u64 { return (*z).fm }

// ------------------------------------------------------------- helpers

#[no_gc]
// Down to the whole pixel. Used for raster window origins -- the
// reason stands at `raster_window`.
#[no_gc]
fn floor_px(v: f64) -> f64 {
    let t: f64 = (v as i64) as f64
    if t > v {
        return t - 1.0
    }
    return t
}

#[no_gc]
fn clamp(v: f64, lo: f64, hi: f64) -> f64 {
    if v < lo { return lo }
    if v > hi { return hi }
    return v
}

#[no_gc]
fn b8(p: u64, i: usize) -> u8 {
    return *((p + i as u64) as *mut u8)
}

// A code point from UTF-8. Taken from lib/browser/chrome.fi.
#[no_gc]
fn utf8_at(p: u64, n: usize, i: usize, adv: *mut usize) -> u32 {
    let c0: u32 = b8(p, i) as u32
    if c0 < 128 as u32 {
        *adv = 1
        return c0
    }
    if c0 >= 240 as u32 && i + 3 < n {
        *adv = 4
        return ((c0 & 7 as u32) << 18)
        | (((b8(p, i + 1) as u32) & 63 as u32) << 12)
        | (((b8(p, i + 2) as u32) & 63 as u32) << 6)
        | ((b8(p, i + 3) as u32) & 63 as u32)
    }
    if c0 >= 224 as u32 && i + 2 < n {
        *adv = 3
        return ((c0 & 15 as u32) << 12)
        | (((b8(p, i + 1) as u32) & 63 as u32) << 6)
        | ((b8(p, i + 2) as u32) & 63 as u32)
    }
    if c0 >= 192 as u32 && i + 1 < n {
        *adv = 2
        return ((c0 & 31 as u32) << 6)
        | ((b8(p, i + 1) as u32) & 63 as u32)
    }
    *adv = 1
    return c0
}

// ========================================================== THE AREAS

// A rectangle. The simplest thing, and it does NOT go through the
// rasteriser: whole pixels need no antialiasing, and `canvas_fill_rect`
// is many times faster.

// ===================================== ALPHA ERGAENZEN, NICHT VERWERFEN
//
// UEBERNOMMEN AUS DEM CERTUS-ZWEIG (lib/fui/uipaint.fi, 13.09.2026),
// wo dieser Fehler gefunden und ausgeschrieben wurde. Er steckte in
// BEIDEN Schalen, und er steckte auch hier.
//
// Alle vier Fuellwege riefen `theme.opaque(col)`. Das SETZT das Alpha
// auf voll -- auch dann, wenn der Aufrufer ausdruecklich eines
// mitgegeben hat. Eine Farbe wie `0x22 << 24 | 0x1A73E8` ("der Akzent
// mit 13 % Deckkraft") wurde damit zu vollem Blau.
//
// GEMESSEN (Certus): der Fokusrand der Adresszeile auf dem Telefon.
// Gemeint war eine Lasur, unter der die Pille hell bleibt (rechnerisch
// #D4E2F2); gemalt wurde die Pille VOLL in der Akzentfarbe. Warum es
// niemandem auffiel: blau auf blau sieht aus wie Absicht. Erst mit
// einem gruenen Akzent war die Flaeche knallgruen.
//
// `opaque` bleibt fuer den Normalfall: wer 0xRRGGBB uebergibt (Alpha
// 0), will eine deckende Flaeche. Wer ein Alpha SETZT, meint es auch.
#[no_gc]
fn mit_alpha(col: u32) -> u32 {
    if (col >> 24) & 255 as u32 == 0 as u32 {
        return theme.opaque(col)
    }
    return col
}
fn surface(z: *mut Painter, x: f64, y: f64, w: f64, h: f64, col: u32) {
    if (*z).ok == 0 || w <= 0.0 || h <= 0.0 {
        return
    }
    canvas.canvas_fill_rect(painter_canvas(z), x, y, x + w, y + h,
        mit_alpha(col))
}

// A line. Horizontal or vertical -- a slanted line is only needed by a
// user interface for icons, and those have their own path. `st` is the
// stroke width.
fn border_col(z: *mut Painter, x: f64, y: f64, w: f64, h: f64, st: f64,
    col: u32) {
    if w >= h {
        surface(z, x, y, w, st, col)
    } else {
        surface(z, x, y, st, h, col)
    }
}

// The factor for the quarter circle out of a cubic.
#[no_gc]
fn K() -> f64 { return 0.5522847498307933 }

// Write the outline of a round rectangle into the rasteriser.
// `r` is clamped to half the shorter side -- a radius bigger than the
// rectangle is not a shape but a mistake, and in `u64` the subtraction
// below would be exactly the overflow Justin's start menu in OrientOS
// died of (kernel/user/wlib.fi, round ECHTHARDWARE-1). Here everything
// is f64, but the clamp stands all the same.
#[no_gc]
fn path_round(ra: *mut raster.Raster, x: f64, y: f64, w: f64, h: f64,
    r0: f64) {
    var r: f64 = r0
    var m: f64 = w
    if h < m {
        m = h
    }
    if r > m / 2.0 {
        r = m / 2.0
    }
    if r < 0.0 {
        r = 0.0
    }
    let x1: f64 = x + w
    let y1: f64 = y + h
    let k: f64 = r * K()
    if r <= 0.0 {
        // A square rectangle is the same path with four lines -- that
        // way `shape_classic` (radius 0) is pixel-identical with what
        // `surface` paints, and not a second lot of drawing code.
        raster.raster_line(ra, x, y, x1, y)
        raster.raster_line(ra, x1, y, x1, y1)
        raster.raster_line(ra, x1, y1, x, y1)
        raster.raster_line(ra, x, y1, x, y)
        return
    }
    // top, clockwise
    raster.raster_line(ra, x + r, y, x1 - r, y)
    raster.raster_cubic(ra, x1 - r, y, x1 - r + k, y, x1, y + r - k,
        x1, y + r)
    raster.raster_line(ra, x1, y + r, x1, y1 - r)
    raster.raster_cubic(ra, x1, y1 - r, x1, y1 - r + k, x1 - r + k, y1,
        x1 - r, y1)
    raster.raster_line(ra, x1 - r, y1, x + r, y1)
    raster.raster_cubic(ra, x + r, y1, x + r - k, y1, x, y1 - r + k,
        x, y1 - r)
    raster.raster_line(ra, x, y1 - r, x, y + r)
    raster.raster_cubic(ra, x, y + r, x, y + r - k, x + r - k, y,
        x + r, y)
}

// Open the raster window for a rectangle. Gives false when there is
// nothing to do.
#[no_gc]
fn raster_window(z: *mut Painter, x: f64, y: f64, w: f64, h: f64,
    luft: f64, wx: *mut f64, wy: *mut f64) -> bool {
    let cv: *mut canvas.Canvas = painter_canvas(z)
    let cw: f64 = canvas.canvas_width(cv) as f64
    let ch: f64 = canvas.canvas_height(cv) as f64
    // THE ORIGIN SITS ON A WHOLE PIXEL.
    //
    // Justin, 12.09.2026: adding letter spacing moved the "N" of a
    // badge one pixel left, and the wave 3 pixel check caught it. The
    // cause was NOT the spacing -- it was here.
    //
    // `canvas_fill_raster` writes the coverage back at
    // `wx as usize, wy as usize`, so it TRUNCATES the origin. The
    // rasteriser meanwhile subtracts the true, fractional origin. The
    // difference between the two is a subpixel shift, and it depends on
    // the FRACTION of the origin. As long as every caller happened to
    // hand in the same fraction, everything lined up. The wider window
    // the text needs for an outline pushed the origin below zero, the
    // clamp made it exactly 0.0, the fraction changed -- and the glyph
    // moved.
    //
    // Flooring the origin makes the fraction always zero, so the
    // rasteriser and the write-back agree by construction. This is the
    // same class of bug as the baseline being rounded to a whole pixel
    // (see `text_baseline_mid`), and it gets the same answer.
    let ax: f64 = floor_px(clamp(x - luft, 0.0, cw))
    let ay: f64 = floor_px(clamp(y - luft, 0.0, ch))
    let bx: f64 = clamp(x + w + luft, 0.0, cw)
    let by: f64 = clamp(y + h + luft, 0.0, ch)
    if bx <= ax || by <= ay {
        return false
    }
    let rw: usize = (bx - ax) as usize + 1
    let rh: usize = (by - ay) as usize + 1
    if rw > (*z).w || rh > (*z).h {
        return false
    }
    *wx = ax
    *wy = ay
    return raster.raster_begin(&(*z).ra, ax, ay, rw, rh)
}

// A RECTANGLE WITH ROUND CORNERS, antialiased.
fn round_rect(z: *mut Painter, x: f64, y: f64, w: f64, h: f64, r: f64,
    col: u32) {
    if (*z).ok == 0 || w <= 0.0 || h <= 0.0 {
        return
    }
    if r <= 0.0 {
        surface(z, x, y, w, h, col)
        return
    }
    var wx: f64 = 0.0
    var wy: f64 = 0.0
    if !raster_window(z, x, y, w, h, 1.0, &wx, &wy) {
        return
    }
    path_round(&(*z).ra, x, y, w, h, r)
    raster.raster_finish(&(*z).ra)
    canvas.canvas_fill_raster(painter_canvas(z), &(*z).ra,
        wx as usize, wy as usize, mit_alpha(col))
}

// THE OUTLINE. A ring and not a filled area: it lies ON an already
// painted widget. It is made as two paths in ONE raster run -- outside
// clockwise, inside against it. The rasteriser counts windings, so
// exactly the border stays.
//
// That is the focus ring, and it is the only thing somebody working by
// keyboard relies on. Therefore it is two pixels wide
// (theme.Shape.focus_w) and not one: one disappears on every screen
// with scaling.
fn round_ring(z: *mut Painter, x: f64, y: f64, w: f64, h: f64, r: f64,
    st: f64, col: u32) {
    if (*z).ok == 0 || w <= 0.0 || h <= 0.0 || st <= 0.0 {
        return
    }
    var wx: f64 = 0.0
    var wy: f64 = 0.0
    if !raster_window(z, x, y, w, h, 1.0, &wx, &wy) {
        return
    }
    path_round(&(*z).ra, x, y, w, h, r)
    // inside, counter-running -- hence the points in reverse order
    let ix: f64 = x + st
    let iy: f64 = y + st
    let iw: f64 = w - 2.0 * st
    let ih: f64 = h - 2.0 * st
    if iw > 0.0 && ih > 0.0 {
        var ir: f64 = r - st
        if ir < 0.0 {
            ir = 0.0
        }
        path_round_ccw(&(*z).ra, ix, iy, iw, ih, ir)
    }
    raster.raster_finish(&(*z).ra)
    canvas.canvas_fill_raster(painter_canvas(z), &(*z).ra,
        wx as usize, wy as usize, mit_alpha(col))
}

// A ROUND RECTANGLE WITH A LINEAR GRADIENT, antialiased.
//
// `c0` at the start, `c1` at the end of the direction (dx, dy): (0, 1)
// runs top to bottom, (1, 1) from the upper left corner to the lower
// right one -- the diagonal of avatars and accent buttons. The ramp is
// laid over the box, not over the canvas, so the same call gives the
// same picture wherever it stands. Colours carry alpha like every other
// colour here (0 alpha = opaque, `mit_alpha`), and are mixed per channel
// in sRGB, the way CSS `linear-gradient` mixes by default.
//
// Same path, same raster window as `round_rect` -- only the write-back
// asks for a colour per pixel instead of one for all.
fn round_rect_grad(z: *mut Painter, x: f64, y: f64, w: f64, h: f64,
    r: f64, c0: u32, c1: u32, dx: f64, dy: f64) {
    if (*z).ok == 0 || w <= 0.0 || h <= 0.0 {
        return
    }
    var wx: f64 = 0.0
    var wy: f64 = 0.0
    if !raster_window(z, x, y, w, h, 1.0, &wx, &wy) {
        return
    }
    path_round(&(*z).ra, x, y, w, h, r)
    raster.raster_finish(&(*z).ra)
    let a: u32 = mit_alpha(c0)
    let b: u32 = mit_alpha(c1)
    // the length of the box along the direction: t runs 0..1 over it
    var ax: f64 = dx
    if ax < 0.0 {
        ax = 0.0 - ax
    }
    var ay: f64 = dy
    if ay < 0.0 {
        ay = 0.0 - ay
    }
    var span: f64 = w * ax + h * ay
    if span <= 0.0 {
        span = 1.0
    }
    // the corner the ramp starts in
    var ox: f64 = x
    if dx < 0.0 {
        ox = x + w
    }
    var oy: f64 = y
    if dy < 0.0 {
        oy = y + h
    }
    let cv: *mut canvas.Canvas = painter_canvas(z)
    let ra: *mut raster.Raster = &(*z).ra
    let rh: usize = raster.raster_used_y1(ra)
    let rw: usize = raster.raster_used_x1(ra)
    let rx0: usize = raster.raster_used_x0(ra)
    var yy: usize = raster.raster_used_y0(ra)
    while yy < rh {
        let row: u64 = raster.raster_cov_row(ra, yy)
        let py: f64 = wy + (yy as f64) + 0.5
        // a ramp that runs straight down has ONE colour per row: mixed
        // once here, not once per pixel
        var rowcol: u32 = 0 as u32
        if dx == 0.0 {
            rowcol = mix_argb(a, b, clamp01(((py - oy) * dy) / span))
        }
        var xx: usize = rx0
        while xx < rw {
            let v: f64 = *((row + (xx * 8) as u64) as *mut f64)
            if v > 0.0 {
                var col: u32 = rowcol
                if dx != 0.0 {
                    let px: f64 = wx + (xx as f64) + 0.5
                    col = mix_argb(a, b,
                        clamp01(((px - ox) * dx + (py - oy) * dy) / span))
                }
                var cov: f64 = v
                if cov > 1.0 {
                    cov = 1.0
                }
                canvas.canvas_blend(cv, (wx as usize) + xx, (wy as usize) + yy,
                    col, cov)
            }
            xx = xx + 1
        }
        yy = yy + 1
    }
}

fn clamp01(t: f64) -> f64 {
    if t < 0.0 {
        return 0.0
    }
    if t > 1.0 {
        return 1.0
    }
    return t
}

// Two colours mixed per channel, alpha included: t = 0 is `a`, 1 is `b`.
fn mix_argb(a: u32, b: u32, t: f64) -> u32 {
    var out: u32 = 0 as u32
    var sh: u32 = 0 as u32
    while sh < 32 as u32 {
        let ca: f64 = ((a >> sh) & 255 as u32) as f64
        let cb: f64 = ((b >> sh) & 255 as u32) as f64
        var v: f64 = ca + (cb - ca) * t + 0.5
        if v > 255.0 {
            v = 255.0
        }
        if v < 0.0 {
            v = 0.0
        }
        out = out | ((v as u32) << sh)
        sh = sh + 8 as u32
    }
    return out
}

// The same path counter-clockwise. It stands as a function of its own
// and not as a switch in `path_round`, because a loop with swapped
// points is harder to read than two clear cases.
#[no_gc]
fn path_round_ccw(ra: *mut raster.Raster, x: f64, y: f64, w: f64,
    h: f64, r0: f64) {
    var r: f64 = r0
    var m: f64 = w
    if h < m {
        m = h
    }
    if r > m / 2.0 {
        r = m / 2.0
    }
    if r < 0.0 {
        r = 0.0
    }
    let x1: f64 = x + w
    let y1: f64 = y + h
    let k: f64 = r * K()
    if r <= 0.0 {
        raster.raster_line(ra, x, y, x, y1)
        raster.raster_line(ra, x, y1, x1, y1)
        raster.raster_line(ra, x1, y1, x1, y)
        raster.raster_line(ra, x1, y, x, y)
        return
    }
    // DER FEHLER, DEN JUSTIN IM BILD GEFUNDEN HAT (10.09.2026).
    //
    // Diese vier Kurven waren falsch, und zwar auf eine Art, die
    // uebersetzt, laeuft und fast richtig aussieht:
    //
    //   * Die ERSTE Kurve endete auf ihrem eigenen ANFANG
    //     (P3 = (x+r, y) statt (x, y+r)) -- ein Segment, das nirgends
    //     hinfuehrt.
    //   * Bei allen vier waren die Kontrollpunkte um eine Stelle
    //     VERSCHOBEN, so dass der zweite Kontrollpunkt auf dem
    //     Endpunkt lag. Eine Bezier mit c2 == P3 ist keine
    //     Viertelkreis-Rundung mehr, sondern faellt zur Sehne hin ab.
    //
    // Sichtbar wurde das erst am Fokusring, weil dort AUSSEN- und
    // INNENpfad uebereinanderliegen: der Innenpfad schnitt oben zu
    // wenig weg. Gemessen im hellen Bild, Ring des Knopfs "Focused",
    // Farbe (0,96,223):
    //
    //     obere Kante  y=52..57  -> 6 Zeilen dick
    //     untere Kante y=80..81  -> 2 Zeilen dick
    //     oben rechts bis x=661, die Seiten nur bis x=659
    //
    // Soll sind ueberall 2 (theme.Shape.focus_w bei Massstab 1).
    //
    // DIE REGEL, DIE DABEI GILT: bei einer Viertelkreis-Bezier liegt
    // c1 TANGENTIAL am Startpunkt und c2 TANGENTIAL am Endpunkt, je
    // k = r * K() entfernt. Wer die Punkte nur abschreibt und dabei
    // die Reihenfolge dreht, bekommt genau diesen Fehler.
    //
    // Gegen den Uhrzeigersinn, beginnend oben links:
    //     (x+r, y) -> (x, y+r) -> (x, y1-r) -> (x+r, y1)
    //  -> (x1-r, y1) -> (x1, y1-r) -> (x1, y+r) -> (x1-r, y)
    //
    // oben links: waagerecht los, senkrecht an
    raster.raster_cubic(ra, x + r, y, x + r - k, y, x, y + r - k,
        x, y + r)
    raster.raster_line(ra, x, y + r, x, y1 - r)
    // unten links: senkrecht los, waagerecht an
    raster.raster_cubic(ra, x, y1 - r, x, y1 - r + k, x + r - k, y1,
        x + r, y1)
    raster.raster_line(ra, x + r, y1, x1 - r, y1)
    // unten rechts: waagerecht los, senkrecht an
    raster.raster_cubic(ra, x1 - r, y1, x1 - r + k, y1, x1, y1 - r + k,
        x1, y1 - r)
    raster.raster_line(ra, x1, y1 - r, x1, y + r)
    // oben rechts: senkrecht los, waagerecht an
    raster.raster_cubic(ra, x1, y + r, x1, y + r - k, x1 - r + k, y,
        x1 - r, y)
    raster.raster_line(ra, x1 - r, y, x + r, y)
}

// ============================================================ THE TEXT


// ======================================================================
// THE TEXT RUN
// ======================================================================
//
// ========================================================= WHY IT EXISTS
//
// Justin, 12.09.2026: "can you make the text bold, letter size, letter
// spacing -- like TextMeshPro in Unity? or would an own text library be
// good?" The answer to the second half is no: lib/font already does the
// hard part (TrueType outlines, metrics, a real `kern` table). What was
// missing is that fUi never USED most of it.
//
// A TextRun is the set of attributes one piece of text is drawn with.
// It exists for ONE reason, and it is the reason the wave 3 measurement
// found a real bug:
//
//     `text_width`, `text_fits_upto` and `text` each walked the string
//     themselves and each worked out the advance themselves. Three
//     copies of the same arithmetic. When `painter.text` learned to cut
//     off, the cut used a width that the drawing then did not keep to.
//
// So now there is ONE function that says how wide a character is --
// `advance_of` -- and all three ask it. Add letter spacing there and
// the measurement, the cutting and the drawing change TOGETHER. They
// cannot drift apart, because there is nothing left to drift.
//
// THIS IS THE SAME RULE AS EVERYWHERE IN fUi, one level down: a bug is
// fixed once. Not once per function.
//
// ================================================== WHAT IT CAN DO
//
//   tracking       letter spacing, in pixels, MAY BE NEGATIVE
//   word_spacing   extra space on U+0020 only
//   kerning        the font's own pair adjustment, on by default
//   weight         400 normal, 700 bold (synthetic if the font has no
//                  bold face: the glyph is drawn several times, offset)
//   slant          upright or italic (a shear on the outline)
//   line_height    for multi-line text
//   outline        a contour around the glyph, colour + width
//   shadow         an offset copy underneath, colour + alpha
//   gradient       a second colour, blended over the height of the line
//
// ============================================ WHY TRACKING IS PIXELS
//
// The style says it in DESIGN POINTS and `render.len_of` turns that
// into pixels -- the same road every other length in fUi takes, so
// tracking scales with the display like a padding does. By the time it
// reaches here it is pixels, because the painter knows nothing about
// design points and must not start now.
//
// ================================= WHY TRACKING SITS AFTER EVERY GLYPH
//
// `(n - 1) * tracking` is what the acceptance measures, and that is the
// definition it measures against: the space sits BETWEEN the letters,
// so a single letter is not made wider by it. The loops therefore add
// the tracking only when another character follows -- `advance_of` gets
// told whether it is the last one.
struct TextRun {
    size: f64,
    tracking: f64,
    word_spacing: f64,
    line_height: f64,   // 0 = from the font metric
    kerning: usize,      // 0 = off, 1 = on
    weight: usize,      // 400 / 700
    slant: usize,       // 0 = upright, 1 = italic
    // --- outline
    out_w: f64,
    out_col: u32,
    out_on: usize,
    // --- shadow
    sh_dx: f64,
    sh_dy: f64,
    sh_col: u32,
    sh_on: usize,
    // --- gradient
    grad_col: u32,
    grad_on: usize,
    // --- die Absatzrichtung: bidi.DIR_AUTO (das erste starke Zeichen
    // entscheidet), DIR_LTR oder DIR_RTL. render.text_run_of setzt sie
    // aus `direction` im Stil.
    dir: u32,
}

// A run with nothing switched on except the things that are always
// true: kerning on (that is what a reader expects) and the weight the
// font was made for.
#[no_gc]
fn run_new(size: f64) -> TextRun {
    return TextRun {
        size: size, tracking: 0.0, word_spacing: 0.0, line_height: 0.0,
        kerning: 1, weight: 400, slant: 0,
        out_w: 0.0, out_col: 0, out_on: 0,
        sh_dx: 0.0, sh_dy: 0.0, sh_col: 0, sh_on: 0,
        grad_col: 0, grad_on: 0, dir: bidi.DIR_AUTO,
    }
}

// The same thing under the name the old callers used, so `text` and
// `text_width` keep behaving exactly as before.
#[no_gc]
fn run_plain(size: f64) -> TextRun {
    return run_new(size)
}

#[no_gc]
fn run_set_tracking(r: TextRun, px: f64) -> TextRun {
    var o: TextRun = r
    o.tracking = px
    return o
}

#[no_gc]
fn run_set_word_spacing(r: TextRun, px: f64) -> TextRun {
    var o: TextRun = r
    o.word_spacing = px
    return o
}

#[no_gc]
fn run_set_kerning(r: TextRun, on: bool) -> TextRun {
    var o: TextRun = r
    if on {
        o.kerning = 1
    } else {
        o.kerning = 0
    }
    return o
}

#[no_gc]
fn run_set_weight(r: TextRun, w: usize) -> TextRun {
    var o: TextRun = r
    o.weight = w
    return o
}

#[no_gc]
fn run_set_slant(r: TextRun, s: usize) -> TextRun {
    var o: TextRun = r
    o.slant = s
    return o
}

#[no_gc]
fn run_set_line_height(r: TextRun, px: f64) -> TextRun {
    var o: TextRun = r
    o.line_height = px
    return o
}

#[no_gc]
fn run_set_outline(r: TextRun, width_px: f64, col: u32) -> TextRun {
    var o: TextRun = r
    o.out_w = width_px
    o.out_col = col
    o.out_on = 1
    return o
}

#[no_gc]
fn run_set_shadow(r: TextRun, dx: f64, dy: f64, col: u32) -> TextRun {
    var o: TextRun = r
    o.sh_dx = dx
    o.sh_dy = dy
    o.sh_col = col
    o.sh_on = 1
    return o
}

#[no_gc]
fn run_set_dir(r: TextRun, d: u32) -> TextRun {
    var o: TextRun = r
    o.dir = d
    return o
}

#[no_gc]
fn run_dir(r: *mut TextRun) -> u32 { return (*r).dir }

#[no_gc]
fn run_set_gradient(r: TextRun, col: u32) -> TextRun {
    var o: TextRun = r
    o.grad_col = col
    o.grad_on = 1
    return o
}

// THE LINE HEIGHT of a run. Without a set value it comes from the font
// metric (ascent + descent) -- that is the height the font itself says
// it needs, and it is the right default for every language.
#[no_gc]
fn run_line_height(z: *mut Painter, r: *mut TextRun) -> f64 {
    if (*r).line_height > 0.0 {
        return (*r).line_height
    }
    return metrics.fm_ascent((*z).fm, (*r).size)
        + metrics.fm_descent((*z).fm, (*r).size)
}

// THE KERNING BETWEEN TWO CHARACTERS, or zero when it is switched off.
//
// WHY IT CAN BE SWITCHED OFF: in a table of numbers every column has to
// stand under the one above it. Kerning makes "11" narrower than "10"
// and the column starts to wobble. That is why the switch exists and
// why the table in wave 3 is the place that uses it.
#[no_gc]
fn pair_kern(z: *mut Painter, r: *mut TextRun, a: u32, b: u32) -> f64 {
    if (*r).kerning == 0 {
        return 0.0
    }
    return metrics.fm_kern((*z).fm, (*r).size, a, b)
}

// HOW FAR THE PEN MOVES AFTER ONE CHARACTER.
//
// THE ONE PLACE THIS IS DECIDED. Every measurement and the drawing ask
// this function, and that is what keeps them from disagreeing.
//
//   * the font's advance for the glyph
//   * the kerning against the character that FOLLOWS
//   * the word spacing, on the space only
//   * the tracking, but NOT after the last character
//
// `nxt` is 0 when nothing follows -- then neither kerning nor tracking
// is added, and that is exactly the `(n - 1) * tracking` the acceptance
// measures.
#[no_gc]
fn advance_of(z: *mut Painter, r: *mut TextRun, cp: u32,
    nxt: u32) -> f64 {
    var a: f64 = metrics.fm_advance((*z).fm, (*r).size, cp)
    if cp == 32 as u32 {
        a = a + (*r).word_spacing
    }
    if nxt != 0 as u32 {
        a = a + pair_kern(z, r, cp, nxt)
        a = a + (*r).tracking
    }
    return a
}

// The character that follows position `i`, or 0 at the end. Needed
// because kerning and tracking look forward.
#[no_gc]
fn next_cp(p: u64, n: usize, i: usize, adv: usize) -> u32 {
    let j: usize = i + adv
    if j >= n {
        return 0
    }
    var a2: usize = 1
    return utf8_at(p, n, j, &a2)
}

// HOW WIDE THE RUN IS. Walks exactly like the drawing does.
#[no_gc]
fn run_width(z: *mut Painter, r: *mut TextRun, p: u64,
    n: usize) -> f64 {
    if !metrics.fm_present((*z).fm) || n == 0 {
        return 0.0
    }
    let k: usize = bidi_prepare(z, r, p, n)
    if k > 0 {
        return bw_range(z, r, 0, k)
    }
    var x: f64 = 0.0
    var i: usize = 0
    while i < n {
        var adv: usize = 1
        let cp: u32 = utf8_at(p, n, i, &adv)
        let nx: u32 = next_cp(p, n, i, adv)
        x = x + advance_of(z, r, cp, nx)
        i = i + adv
    }
    return x
}

// HOW MANY BYTES FIT into `room`, on a character boundary.
//
// It counts with the SAME advance as the drawing, so a text that is cut
// here really does end inside the rect. Wave 3 measured that a long
// file name ran into the next column; with tracking the same mistake
// would come straight back if this function did its own arithmetic.
#[no_gc]
fn run_fits_upto(z: *mut Painter, r: *mut TextRun, p: u64, n: usize,
    room: f64) -> usize {
    if !metrics.fm_present((*z).fm) {
        return n
    }
    let k: usize = bidi_prepare(z, r, p, n)
    if k > 0 {
        return bo_byte(z, bidi_fits(z, r, 0, k, room))
    }
    var x: f64 = 0.0
    var i: usize = 0
    while i < n {
        var adv: usize = 1
        let cp: u32 = utf8_at(p, n, i, &adv)
        let nx: u32 = next_cp(p, n, i, adv)
        // WHAT HAS TO FIT IS THE FULL ADVANCE, exactly as the old
        // `text_fits_upto` counted it -- and that is not a detail.
        //
        // The first version of this function asked whether the INK
        // fits, reasoning that the tracking after the last letter may
        // hang over the edge. That is defensible, but it made every
        // centred text ONE PIXEL WIDER than before, because the
        // alignment divides the measured width in half. The wave 3
        // badge check caught it at once: the "N" of NEW moved a pixel
        // left and the measured pill colour became the glyph's
        // antialiased edge.
        //
        // The lesson is the one this file keeps learning: the
        // measurement and the drawing have to count THE SAME THING.
        // `run_width` counts full advances, so this counts full
        // advances. Whoever wants the ink can ask `run_width` for one
        // character.
        let step: f64 = advance_of(z, r, cp, nx)
        if x + step > room {
            return i
        }
        x = x + step
        i = i + adv
    }
    return n
}

// ======================================================================
// KUERZEN MIT AUSLASSUNGSPUNKTEN, UND UMBRECHEN
// ======================================================================
//
// Justin, 13.09.2026, am Bild des Kontrollzentrums: eine Kachel, deren
// Beschriftung als "Netz vortaeusc" endet, ist kein Ergebnis. Windows
// bricht die Beschriftung um oder beendet sie mit "...".
//
// WARUM DAS HIERHER GEHOERT UND NICHT IN DEN AUFRUFER. `run_fits_upto`
// schneidet hart auf dem letzten Zeichen, das noch passt -- das ist
// richtig fuer einen Textcursor und falsch fuer eine Beschriftung. Wer
// es im Programm nachbaut, misst mit einer zweiten Rechnung und bekommt
// eine andere Breite als der Maler: genau der Fehler, den der Kopf von
// `art_text_split` beschreibt. Also steht es in der Datei, die die
// Vorschuebe kennt, und jedes Element bekommt es umsonst.
//
// DIE AUSLASSUNGSPUNKTE SIND DREI PUNKTE UND KEIN U+2026. Die
// Symbolschrift dieses Baums fuehrt das einzelne Zeichen nicht
// zwangslaeufig; drei Punkte hat jede Schrift. Gemessen wird mit
// denselben Vorschueben wie der Rest der Zeile, Kerning eingeschlossen.

// Wie breit sind die drei Punkte in diesem Lauf?
fn ellipsis_w(z: *mut Painter, r: *mut TextRun) -> f64 {
    var w: f64 = 0.0
    var k: usize = 0
    while k < 3 {
        var nx: u32 = 0
        if k < 2 {
            nx = 46
        }
        w = w + advance_of(z, r, 46, nx)
        k = k + 1
    }
    return w
}

// WIE VIELE OKTETTE PASSEN, WENN HINTER IHNEN NOCH "..." STEHEN MUSS.
//
// Gibt zusaetzlich ueber `gekuerzt` zurueck, OB gekuerzt wurde -- der
// Aufrufer muss wissen, ob er die Punkte ueberhaupt malen soll, und
// soll es nicht an einem Laengenvergleich zweiter Hand ablesen.
fn run_fits_ellipsis(z: *mut Painter, r: *mut TextRun, p: u64, n: usize,
    room: f64, gekuerzt: *mut bool) -> usize {
    *gekuerzt = false
    if !metrics.fm_present((*z).fm) || n == 0 {
        return n
    }
    // Passt alles, ist nichts zu tun -- und das ist der haeufige Fall.
    if run_width(z, r, p, n) <= room {
        return n
    }
    *gekuerzt = true
    let ew: f64 = ellipsis_w(z, r)
    if ew > room {
        return 0
    }
    return run_fits_upto(z, r, p, n, room - ew)
}

// EINE ZEILE MALEN, DIE MIT "..." ENDET, WENN SIE NICHT PASST.
//
// Rueckgabe wie `run_draw`: wo der Stift stehengeblieben ist.
fn run_draw_ellipsis(z: *mut Painter, r: *mut TextRun, x: f64,
    base_y: f64, w: f64, col: u32, p: u64, n: usize,
    align: u32) -> f64 {
    if (*z).ok == 0 || !metrics.fm_present((*z).fm) || n == 0 {
        return x
    }
    if w <= 0.0 {
        return run_draw(z, r, x, base_y, w, col, p, n, align)
    }
    let bk: usize = bidi_prepare(z, r, p, n)
    if bk > 0 {
        return bidi_draw_ellipsis(z, r, x, base_y, w, col, 0, bk, align)
    }
    var ab: bool = false
    let nn: usize = run_fits_ellipsis(z, r, p, n, w, &ab)
    if !ab {
        return run_draw(z, r, x, base_y, w, col, p, n, align)
    }
    if nn == 0 {
        return x
    }
    // DIE AUSRICHTUNG RECHNET MIT DER GESAMTBREITE AUS TEXT UND PUNKTEN,
    // sonst sitzt eine mittige Beschriftung um die halbe Punktbreite
    // daneben -- derselbe Fehler, den `run_draw` im Kopf beschreibt.
    let bw: f64 = run_width(z, r, p, nn)
    let ew: f64 = ellipsis_w(z, r)
    var sx: f64 = x
    if align == TEXT_M {
        sx = x + (w - (bw + ew)) / 2.0
    } else if align == TEXT_R {
        sx = x + w - (bw + ew)
    }
    // Beide Stuecke linksbuendig ab `sx` -- die Ausrichtung ist oben
    // schon eingerechnet, ein zweites Mal waere sie doppelt.
    let e1: f64 = run_draw(z, r, sx, base_y, 0.0, col, p, nn, TEXT_L)
    var pkt: [u8; 4] = "...\0"
    let e2: f64 = run_draw(z, r, e1, base_y, 0.0, col,
        (&pkt[0 as usize]) as u64, 3, TEXT_L)
    return e2
}

// ================================================== UMBRECHEN AN WORTGRENZEN
//
// Sucht das Ende der Zeile, die in `room` passt, und gibt ueber `nach`
// zurueck, wo die naechste Zeile ANFAENGT (das Leerzeichen dazwischen
// wird uebersprungen, es gehoert keiner der beiden Zeilen).
//
// WARUM AN WORTGRENZEN UND NICHT AN ZEICHEN: ein Umbruch mitten im Wort
// liest sich schlechter als eine kuerzere Zeile. Passt ein EINZELNES
// Wort nicht in die Breite, wird es doch auf dem Zeichen getrennt --
// sonst stuende die Zeile leer da und die Schleife kaeme nicht voran.
fn run_line_upto(z: *mut Painter, r: *mut TextRun, p: u64, n: usize,
    room: f64, nach: *mut usize) -> usize {
    *nach = n
    if !metrics.fm_present((*z).fm) || n == 0 {
        return n
    }
    let k: usize = bidi_prepare(z, r, p, n)
    if k > 0 {
        var nx: usize = k
        let e: usize = bidi_line_break(z, r, 0, k, room, &nx)
        *nach = bo_byte(z, nx)
        return bo_byte(z, e)
    }
    var x: f64 = 0.0
    var i: usize = 0
    var letzte_luecke: usize = 0
    var nach_luecke: usize = 0
    while i < n {
        var adv: usize = 1
        let cp: u32 = utf8_at(p, n, i, &adv)
        let nx: u32 = next_cp(p, n, i, adv)
        if cp == 32 {
            letzte_luecke = i
            nach_luecke = i + adv
        }
        let step: f64 = advance_of(z, r, cp, nx)
        if x + step > room {
            if letzte_luecke > 0 {
                *nach = nach_luecke
                return letzte_luecke
            }
            // Ein einzelnes zu langes Wort: hart trennen, aber nie mit
            // null Zeichen zurueckkommen.
            if i == 0 {
                *nach = adv
                return adv
            }
            *nach = i
            return i
        }
        x = x + step
        i = i + adv
    }
    *nach = n
    return n
}

// WIE VIELE ZEILEN BRAUCHT DIESER TEXT IN DIESER BREITE?
// Zum Messen, bevor etwas gemalt wird -- das Layout fragt danach.
// NUR LEERZEICHEN SIND KEINE ZEILE.
//
// GEFUNDEN IM PRUEFSTAND, nicht im Kopf: `run_line_count` sagte DREI
// Zeilen voraus, wo `run_draw_wrapped` ZWEI malte. Die dritte war der
// Rest "  " am Ende der Zeichenkette -- ein Umbruch hinter dem letzten
// Wort laesst die Leerzeichen stehen, und eine Zeile aus zwei
// Leerzeichen ist im Bild nichts, in der Rechnung aber eine Zeile.
//
// Das ist genau die Sorte Abweichung, vor der der Kopf dieser Datei
// warnt: das Messen und das Malen muessen DASSELBE zaehlen. Wer die
// Hoehe aus der Vorhersage nimmt, laesst sonst eine leere Zeile Platz.
fn nur_leer(p: u64, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        if b8(p, i) != 32 as u8 {
            return false
        }
        i = i + 1
    }
    return true
}

fn run_line_count(z: *mut Painter, r: *mut TextRun, p: u64, n: usize,
    room: f64, max_zeilen: usize) -> usize {
    if n == 0 || room <= 0.0 {
        return 0
    }
    let k: usize = bidi_prepare(z, r, p, n)
    if k > 0 {
        return bidi_wrapped(z, r, 0.0, 0.0, room, 0.0, 0 as u32, k, TEXT_L,
            max_zeilen, false)
    }
    var zeilen: usize = 0
    var i: usize = 0
    while i < n && zeilen < max_zeilen {
        if nur_leer(p + (i as u64), n - i) {
            return zeilen
        }
        var weiter: usize = 0
        let bis: usize = run_line_upto(z, r, p + (i as u64), n - i,
            room, &weiter)
        if bis == 0 {
            return zeilen + 1
        }
        zeilen = zeilen + 1
        i = i + weiter
    }
    return zeilen
}

// MEHRZEILIG MALEN. Die letzte erlaubte Zeile bekommt "...", wenn der
// Text dort noch nicht zu Ende ist -- sonst bricht er stumm ab, und
// genau das ist der Fehler, der ueberhaupt zu dieser Runde gefuehrt hat.
//
// `zeilen_h` ist der Zeilenabstand in Bildpunkten; `base_y` die
// Grundlinie der ERSTEN Zeile. Rueckgabe: die Zahl der gemalten Zeilen.
fn run_draw_wrapped(z: *mut Painter, r: *mut TextRun, x: f64,
    base_y: f64, w: f64, zeilen_h: f64, col: u32, p: u64, n: usize,
    align: u32, max_zeilen: usize) -> usize {
    if (*z).ok == 0 || !metrics.fm_present((*z).fm) || n == 0 {
        return 0
    }
    if w <= 0.0 || max_zeilen == 0 {
        return 0
    }
    let k: usize = bidi_prepare(z, r, p, n)
    if k > 0 {
        return bidi_wrapped(z, r, x, base_y, w, zeilen_h, col, k, align,
            max_zeilen, true)
    }
    var zeilen: usize = 0
    var i: usize = 0
    var y: f64 = base_y
    while i < n && zeilen < max_zeilen {
        // Siehe `nur_leer`: der Rest aus lauter Leerzeichen bekommt
        // keine eigene Zeile, sonst zaehlt die Vorhersage anders als
        // das Bild.
        if nur_leer(p + (i as u64), n - i) {
            return zeilen
        }
        var weiter: usize = 0
        let bis: usize = run_line_upto(z, r, p + (i as u64), n - i, w,
            &weiter)
        if bis == 0 {
            return zeilen
        }
        let ist_letzte: bool = (zeilen + 1 == max_zeilen)
        let rest_bleibt: bool = (i + weiter < n)
        if ist_letzte && rest_bleibt {
            // Auf der letzten Zeile steht der GANZE Rest zur Wahl, nicht
            // nur das, was das Umbrechen ihr zugeteilt hat -- sonst
            // stuenden die Punkte schon nach dem vorletzten Wort.
            let e4: f64 = run_draw_ellipsis(z, r, x, y, w, col,
                p + (i as u64), n - i, align)
        } else {
            let e5: f64 = run_draw(z, r, x, y, w, col, p + (i as u64),
                bis, align)
        }
        zeilen = zeilen + 1
        y = y + zeilen_h
        i = i + weiter
    }
    return zeilen
}

// ======================================================================
// DRAWING A RUN
// ======================================================================
//
// ============================================== THE ORDER OF THE PASSES
//
// shadow, then outline, then the glyph. That order is not a taste, it
// is what makes the result readable:
//
//   * the SHADOW lies furthest back, so it must go down first
//   * the OUTLINE lies around the glyph and must not cover it, so it
//     goes down before it
//   * the GLYPH last, on top of both
//
// The other way round the outline would eat the letter and the letter
// would sit in a fog.
//
// =================================== WHY THE OUTLINE IS DRAWN AND NOT GROWN
//
// A real contour needs the path offset outwards (Minkowski). That is a
// hard piece of geometry, it goes wrong on sharp corners, and it is not
// what a user interface needs.
//
// What is done here: the glyph is rasterised SEVERAL TIMES, moved by
// `out_w` in eight directions. The union of the copies is the glyph
// grown by `out_w` in every direction -- which is exactly what a
// contour is. Eight directions is enough because the steps in between
// are covered by the neighbouring copies; with four the diagonals stay
// thin, and that is visible on an O.
//
// It costs eight rasterisations per outlined text. That is paid only by
// whoever switches the outline on, and it is drawn into ONE raster and
// filled ONCE -- so it costs one fill, not eight.
//
// ============================================ SYNTHETIC BOLD AND ITALIC
//
// If the font set has no bold face, bold is made: the glyph is drawn
// three times, each a little to the right. That is what every text
// engine does as a fallback and it is honest -- it says so here.
//
// Italic is a SHEAR: x' = x + y * 0.21. The 0.21 is the tangent of
// about 12 degrees, the slant of most italic faces. `ttf.outline_at`
// takes a 2x3 matrix, so this costs nothing extra.
const ITALIC_SHEAR: f64 = 0.21
const BOLD_STEP: f64 = 0.035    // of the font size, per pass
const BOLD_PASSES: usize = 3

// One glyph into the raster, with the run's weight and slant.
#[no_gc]
fn glyph_into(z: *mut Painter, r: *mut TextRun, f: *mut ttf.Font,
    gid: u32, pen: f64, base_y: f64, sc: f64) {
    var m01: f64 = 0.0
    if (*r).slant != 0 {
        // A shear in x by the height. The sign is such that the top
        // leans RIGHT, which is what italic means.
        m01 = ITALIC_SHEAR
    }
    var k: usize = 0
    var passes: usize = 1
    var step: f64 = 0.0
    if (*r).weight >= 700 {
        passes = BOLD_PASSES
        step = (*r).size * BOLD_STEP
    }
    while k < passes {
        let dx: f64 = (k as f64) * step
        let okg: bool = ttf.outline_at(f, gid, &(*z).ra,
            pen + dx, base_y, sc,
            1.0, m01, 0.0, 1.0, 0.0, 0.0,
            (*z).scratch, SCRATCH, 0)
        k = k + 1
    }
}

// A whole string into the raster at one offset. Used by every pass --
// shadow, outline and the glyph itself -- so the three cannot land in
// different places.
#[no_gc]
fn run_into_raster(z: *mut Painter, r: *mut TextRun, p: u64, n: usize,
    sx: f64, base_y: f64, dx: f64, dy: f64) {
    let f: *mut ttf.Font = metrics.fontset_font((*z).fm)
    let up: f64 = metrics.fm_upem((*z).fm)
    let sc: f64 = (*r).size / up
    var pen: f64 = sx + dx
    var i: usize = 0
    while i < n {
        var adv: usize = 1
        let cp: u32 = utf8_at(p, n, i, &adv)
        let nx: u32 = next_cp(p, n, i, adv)
        let gid: u32 = ttf.font_glyph_for(f, cp)
        glyph_into(z, r, f, gid, pen, base_y + dy, sc)
        pen = pen + advance_of(z, r, cp, nx)
        i = i + adv
    }
}

// Welcher Weg in das Raster? Siehe `paint_run`.
#[no_gc]
fn into_raster(z: *mut Painter, r: *mut TextRun, vis: bool, p: u64,
    n: usize, sx: f64, base_y: f64, dx: f64, dy: f64) {
    if vis {
        bidi_into_raster(z, r, sx, base_y, dx, dy)
    } else {
        run_into_raster(z, r, p, n, sx, base_y, dx, dy)
    }
}

// The eight directions the outline grows in.
#[no_gc]
fn out_dir_x(k: usize) -> f64 {
    if k == 0 { return 1.0 }
    if k == 1 { return -1.0 }
    if k == 2 { return 0.0 }
    if k == 3 { return 0.0 }
    if k == 4 { return 0.7071 }
    if k == 5 { return -0.7071 }
    if k == 6 { return 0.7071 }
    return -0.7071
}

#[no_gc]
fn out_dir_y(k: usize) -> f64 {
    if k == 0 { return 0.0 }
    if k == 1 { return 0.0 }
    if k == 2 { return 1.0 }
    if k == 3 { return -1.0 }
    if k == 4 { return 0.7071 }
    if k == 5 { return 0.7071 }
    if k == 6 { return -0.7071 }
    return -0.7071
}

// Fills the current raster with one colour and clears it for the next
// pass. Returns nothing -- the raster belongs to the painter.
// Fills the FINISHED raster with one colour. The caller finishes it --
// see the note at `fill_raster_gradient` for why that must happen
// exactly once.
#[no_gc]
fn flush_raster(z: *mut Painter, wx: f64, wy: f64, col: u32) {
    canvas.canvas_fill_raster(painter_canvas(z), &(*z).ra,
        wx as usize, wy as usize, mit_alpha(col))
}

// A GRADIENT OVER THE LINE.
//
// The glyph is filled row by row, and the colour is mixed from the top
// colour to the bottom one over the height of the font. That is what
// TextMeshPro calls a vertical gradient, and it is the only one worth
// having in a user interface -- a horizontal one over a whole line
// makes the last word a different colour from the first and looks like
// a fault.
//
// It goes through `canvas_blend` per row because the colour changes per
// row; `canvas_fill_raster` can only do one colour.
// RASTER_FINISH IS CALLED HERE AND EXACTLY ONCE.
//
// Justin, 12.09.2026: the gradient came out invisible and nothing in
// the source said why. The cause is worth writing down, because it is
// a trap for the next person who reads coverage back:
//
//     `raster.raster_finish` INTEGRATES THE ACCUMULATOR IN PLACE. It
//     walks each row, adds the cell deltas into a running sum and
//     writes the sum back over the delta. Run it a second time and it
//     integrates the already-integrated values -- every cell is then
//     positive, the running sum never returns to zero, and the result
//     is nothing that resembles the glyph.
//
// The first version of this function called `raster_finish` itself and
// was called from a place that had already finished the raster. So the
// fix is not a bigger threshold or a different offset: it is to finish
// ONCE. `run_draw` now finishes before it chooses between the flat
// fill and this one, and neither of them finishes again.
fn fill_raster_gradient(z: *mut Painter, wx: f64, wy: f64, top: u32,
    bot: u32, y0: f64, y1: f64) {
    let cv: *mut canvas.Canvas = painter_canvas(z)
    let x0: usize = raster.raster_used_x0(&(*z).ra)
    let x1: usize = raster.raster_used_x1(&(*z).ra)
    let ry0: usize = raster.raster_used_y0(&(*z).ra)
    let ry1: usize = raster.raster_used_y1(&(*z).ra)
    let span: f64 = y1 - y0
    var y: usize = ry0
    while y < ry1 {
        // where this row sits in the line, 0..1
        let devy: f64 = wy + (y as f64)
        var t: f64 = 0.0
        if span > 0.0 {
            t = (devy - y0) / span
        }
        if t < 0.0 { t = 0.0 }
        if t > 1.0 { t = 1.0 }
        let col: u32 = theme.opaque(theme.mix(top, bot,
            (t * 1000.0) as usize))
        var x: usize = x0
        while x < x1 {
            let cov: f64 = raster.raster_cov(&(*z).ra, x, y)
            if cov > 0.001 {
                canvas.canvas_blend(cv, (wx as usize) + x,
                    (wy as usize) + y, col, cov)
            }
            x = x + 1
        }
        y = y + 1
    }
}

// DRAW THE RUN. Returns where the pen ended, like `text` does.
//
// `w` is the room it may use; 0 or less means "no cutting". The
// alignment is worked out from the width the run REALLY has, so a
// centred text with tracking still sits in the middle.
fn run_draw(z: *mut Painter, r: *mut TextRun, x: f64, base_y: f64,
    w: f64, col: u32, p: u64, n: usize, align: u32) -> f64 {
    if (*z).ok == 0 || !metrics.fm_present((*z).fm) || n == 0 {
        return x
    }
    let k: usize = bidi_prepare(z, r, p, n)
    if k > 0 {
        var c: usize = k
        if w > 0.0 {
            c = bidi_fits(z, r, 0, k, w)
        }
        return bidi_draw_line(z, r, x, base_y, w, col, 0, c, align)
    }
    return run_draw_ltr(z, r, x, base_y, w, col, p, n, align)
}

// DER ALTE WEG, UNVERAENDERT: jedes Zeichen in logischer Reihenfolge von
// links nach rechts. Jeder Text ohne rechtslaeufiges Zeichen kommt hier
// an und wird Bildpunkt fuer Bildpunkt so gemalt wie vor der Bidi-Runde.
fn run_draw_ltr(z: *mut Painter, r: *mut TextRun, x: f64, base_y: f64,
    w: f64, col: u32, p: u64, n: usize, align: u32) -> f64 {
    if (*z).ok == 0 || !metrics.fm_present((*z).fm) || n == 0 {
        return x
    }
    var nn: usize = n
    if w > 0.0 {
        nn = run_fits_upto(z, r, p, n, w)
    }
    if nn == 0 {
        return x
    }
    let br: f64 = run_width(z, r, p, nn)
    var sx: f64 = x
    if align == TEXT_M {
        sx = x + (w - br) / 2.0
    } else if align == TEXT_R {
        sx = x + w - br
    }
    sx = ((sx + 0.5) as i64) as f64
    return paint_run(z, r, sx, base_y, br, col, p, nn, false)
}

// DIE DREI DURCHGAENGE (Schatten, Kontur, Glyphe) FUER EINE GELEGTE ZEILE.
//
// Eine Stelle fuer beide Wege: `vis` = false malt `p`/`nn` in logischer
// Reihenfolge (der alte Weg), `vis` = true die zuletzt mit `bidi_layout`
// gelegte Zeile in der Reihenfolge auf dem Schirm. Fenster, Schatten,
// Kontur und Verlauf sind damit fuer Arabisch dieselben wie fuer
// Lateinisch -- ein zweiter Satz Durchgaenge fuer den Bidi-Weg waere
// genau der zweite Ort, der irgendwann anders rechnet.
fn paint_run(z: *mut Painter, r: *mut TextRun, sx: f64, base_y: f64,
    br: f64, col: u32, p: u64, nn: usize, vis: bool) -> f64 {
    // THE WINDOW. It has to hold everything the passes reach into:
    // the shadow offset, the outline width and the shear of an italic.
    // Too small a window and the raster clips -- which is the class of
    // bug that cost two rounds on the close cross.
    // ONLY AS MUCH ROOM AS THE PASSES REALLY NEED.
    //
    // `raster_window` already adds one font size of air on every side
    // and refuses a window bigger than the painter's raster budget.
    // The first version added half a font size ON TOP of that for
    // every text, which pushed the window one row over the budget on a
    // short canvas -- `raster_window` then returned false and
    // `run_draw` returned WITHOUT DRAWING ANYTHING. The gradient
    // looked broken; in truth nothing was drawn at all.
    //
    // So the padding starts at zero and only grows for the features
    // that really reach outside the glyph. Plain text asks for exactly
    // the window the old `text` asked for, which is also why the other
    // waves keep rendering pixel for pixel as before.
    var pad: f64 = 0.0
    if (*r).out_on != 0 {
        pad = pad + (*r).out_w + 1.0
    }
    var shx: f64 = 0.0
    var shy: f64 = 0.0
    if (*r).sh_on != 0 {
        shx = (*r).sh_dx
        shy = (*r).sh_dy
        if shx < 0.0 { shx = 0.0 - shx }
        if shy < 0.0 { shy = 0.0 - shy }
    }
    if (*r).slant != 0 {
        pad = pad + (*r).size * ITALIC_SHEAR
    }
    if (*r).weight >= 700 {
        pad = pad + (*r).size * BOLD_STEP * (BOLD_PASSES as f64)
    }
    var wx: f64 = 0.0
    var wy: f64 = 0.0
    let wl: f64 = sx - pad - shx
    let wt: f64 = base_y - (*r).size * 1.4 - pad - shy
    let ww: f64 = br + 2.0 * pad + 2.0 * shx
    let wh: f64 = (*r).size * 2.0 + 2.0 * pad + 2.0 * shy
    // A WINDOW THAT DOES NOT FIT MEANS NOTHING IS DRAWN, and that has
    // to be visible to whoever debugs it.
    //
    // Justin, 12.09.2026: the gradient looked broken for half an hour.
    // It was not: the painter had been set up with a raster budget of
    // 120 rows, the window for 40 px text needs 121, `raster_window`
    // said no, and this function returned in silence. The old `text`
    // did exactly the same, so the trap is as old as the file.
    //
    // It still returns -- there is nothing sensible to draw into a
    // window that does not exist -- but the reason is written down
    // here now, in the one place somebody will be standing when it
    // happens: give `painter_init` a raster height of at least
    // 3 * the largest font size.
    if !raster_window(z, wl, wt, ww, wh, (*r).size, &wx, &wy) {
        return sx + br
    }

    // ---- pass 1: THE SHADOW, furthest back
    if (*r).sh_on != 0 {
        into_raster(z, r, vis, p, nn, sx, base_y, (*r).sh_dx,
            (*r).sh_dy)
        raster.raster_finish(&(*z).ra)
        flush_raster(z, wx, wy, (*r).sh_col)
        // a fresh window for the next pass
        if !raster_window(z, wl, wt, ww, wh, (*r).size, &wx, &wy) {
            return sx + br
        }
    }

    // ---- pass 2: THE OUTLINE, eight copies into ONE raster
    if (*r).out_on != 0 && (*r).out_w > 0.0 {
        var k: usize = 0
        while k < 8 {
            into_raster(z, r, vis, p, nn, sx, base_y,
                out_dir_x(k) * (*r).out_w,
                out_dir_y(k) * (*r).out_w)
            k = k + 1
        }
        raster.raster_finish(&(*z).ra)
        flush_raster(z, wx, wy, (*r).out_col)
        if !raster_window(z, wl, wt, ww, wh, (*r).size, &wx, &wy) {
            return sx + br
        }
    }

    // ---- pass 3: THE GLYPH
    into_raster(z, r, vis, p, nn, sx, base_y, 0.0, 0.0)
    raster.raster_finish(&(*z).ra)
    if (*r).grad_on != 0 {
        let asc: f64 = metrics.fm_ascent((*z).fm, (*r).size)
        let dsc: f64 = metrics.fm_descent((*z).fm, (*r).size)
        fill_raster_gradient(z, wx, wy, col, (*r).grad_col,
            base_y - asc, base_y + dsc)
    } else {
        flush_raster(z, wx, wy, col)
    }
    return sx + br
}

#[no_gc]
fn font_ascent(z: *mut Painter, size: f64) -> f64 {
    return metrics.fm_ascent((*z).fm, size)
}

#[no_gc]
fn font_descent(z: *mut Painter, size: f64) -> f64 {
    return metrics.fm_descent((*z).fm, size)
}

// How wide does the text get? The number every layout rests on.
#[no_gc]
fn text_width(z: *mut Painter, p: u64, n: usize, size: f64) -> f64 {
    var r: TextRun = run_new(size)
    return run_width(z, &r, p, n)
}

// How many bytes fit into `platz`? Always on a character boundary --
// never in the middle of a UTF-8 character.
#[no_gc]
fn text_fits_upto(z: *mut Painter, p: u64, n: usize, size: f64,
    platz: f64) -> usize {
    var r: TextRun = run_new(size)
    return run_fits_upto(z, &r, p, n, platz)
}

// THE BASELINE FOR VERTICALLY CENTRED TEXT.
//
// This is the arithmetic that fixes Justin's finding "the label does
// not sit in the middle", and the reason stands at the head of this
// file: what is centred is the FONT, not the line.
//
//     The font occupies from (baseline - ascent) to
//     (baseline + descent). Its middle lies at
//     baseline - (ascent - descent) / 2, and that should fall on
//     y + h/2:
//
//         baseline = y + h/2 + (ascent - descent) / 2
//                  = y + (h + ascent - descent) / 2
//
// Rounded to a whole pixel: a baseline between two pixels makes every
// line half blurred (the same reasoning stands in lib/font/metrics.fi
// at `fm_ascent`).
#[no_gc]
fn text_baseline_mid(z: *mut Painter, y: f64, h: f64, size: f64) -> f64 {
    let a: f64 = metrics.fm_ascent((*z).fm, size)
    let d: f64 = metrics.fm_descent((*z).fm, size)
    let b: f64 = y + (h + a - d) / 2.0
    let t: f64 = ((b + 0.5) as i64) as f64
    return t
}

// DRAW TEXT.
//
// `x`/`w` is the rect it is aligned in; `base_y` the baseline (from
// `text_baseline_mid`). Back comes the position where it ends -- from
// that the TextBuf works out where its caret sits.
fn text(z: *mut Painter, x: f64, base_y: f64, w: f64, size: f64,
    col: u32, p: u64, n: usize, align: u32) -> f64 {
    // THE PLAIN CASE OF `run_draw`. It stays because most callers want
    // nothing special, and because every caller in the tree already
    // uses it -- but there is only ONE walk over the string now, in
    // run_draw. When wave 3's measurement found that this function
    // drew every glyph however narrow the rect was, the reason was
    // that it did its own arithmetic. That cannot happen again here:
    // there is no arithmetic left in it.
    var r: TextRun = run_new(size)
    return run_draw(z, &r, x, base_y, w, col, p, n, align)
}

// THE CARET. A vertical stroke on whole pixels -- it must NOT go
// through the rasteriser, otherwise at half positions it is two pale
// columns instead of one sharp one.
fn caret_bar(z: *mut Painter, x: f64, y: f64, h: f64, st: f64,
    col: u32) {
    let ix: f64 = ((x + 0.5) as i64) as f64
    var s: f64 = st
    if s < 1.0 {
        s = 1.0
    }
    surface(z, ix, y, s, h, col)
}

// ======================================================================
// DER BIDI-WEG
// ======================================================================
//
// WARUM ER HIER STEHT. Jede Beschriftung, jeder Knopf, jede Tabelle und
// jedes Textfeld misst und malt ueber `run_width`, `run_fits_upto`,
// `run_draw`, `run_draw_ellipsis` und `run_draw_wrapped`. Wer die
// Zweirichtungsschrift an EINER dieser Stellen vergisst, bekommt genau
// den Fehler, den der Kopf dieser Datei beschreibt: gemessen wird etwas
// anderes als gemalt. Also entscheidet jede von ihnen am Anfang dasselbe:
//
//   `bidi_prepare` -- braucht dieser Text den Algorithmus? NEIN heisst:
//   kein R, AL, AN und kein RLE/RLO/RLI darin, und die Richtung ist nicht
//   RTL (bidi.bidi_needed). Dann geht es den alten Weg, unveraendert --
//   jede lateinische Zeile in jedem Beleg bleibt Bildpunkt fuer Bildpunkt,
//   was sie war. JA heisst: der GANZE Text wird einmal vorbereitet
//
//     1. UTF-8 -> Codepunkte, samt der Oktettlage jedes Zeichens
//     2. Ebenen (bidi.bidi_run) -- fuer den ganzen Absatz, nicht fuer die
//        Zeile: ob ein umgebrochenes Stueck von rechts nach links laeuft,
//        entscheidet sein Absatz
//     3. Glyphen (shape.shape_run): Spiegelbilder, arabische Gestalten
//     4. Vorschuebe je Zeichen aus der Schrift
//
//   und alles Weitere -- Messen, Umbrechen, Kuerzen, Malen, die
//   Schreibmarke -- rechnet mit denselben vorbereiteten Zahlen.
//
// WAS DER BIDI-WEG ANDERS MACHT ALS DER ALTE, und warum:
//
//   * KEIN PAARWEISES KERNING. Die `kern`-Tabelle ist nach Glyphenpaaren
//     von links nach rechts gebaut; in einer gemischten Zeile sind die
//     Nachbarn auf dem Schirm andere als im Text, und ein Kerning, das
//     beim Messen (logisch) ein anderes Paar sieht als beim Malen
//     (visuell), macht genau die Abweichung, die hier verboten ist.
//     DejaVu Sans kernt Arabisch und Hebraeisch ohnehin nicht.
//   * DER ZEICHENABSTAND (tracking) steht zwischen SICHTBAREN Glyphen --
//     ein Alif, das im Lam-Alif aufgegangen ist, bekommt keinen.
//   * DIE VOKALZEICHEN. Ohne GPOS gibt es keine Ankerpunkte. DejaVu Sans
//     zeichnet arabische und hebraeische Vokale mit Vorschub 0 und der
//     Tinte RECHTS vom Ursprung, also fuer die Lage VOR ihrem
//     Grundbuchstaben auf dem Schirm -- und genau dort stehen sie nach
//     L2, denn die Umkehrung dreht "Grundbuchstabe, Vokal" zu "Vokal,
//     Grundbuchstabe". Regel L3 (die Reihenfolge wieder umdrehen) ist fuer
//     Schriften gedacht, die das Gegenteil erwarten; sie wird hier darum
//     NICHT angewendet.
//
// DIE GRENZE: `BIDI_CAP` Zeichen je Text. Ein laengerer Text geht den
// alten Weg (von links nach rechts). Fuer Beschriftungen und Eingabe-
// felder ist das weit mehr als genug; ein Textverarbeitungsfenster
// braucht einen eigenen Absatzspeicher und nicht diesen Arbeitsraum.

const BIDI_CAP: usize = 4096

// Die Teilfelder des Arbeitsraums, in dieser Reihenfolge ab `bx`:
//   cp u32, boff u32 (CAP + 2), cls0/cls/lev/pl/del/form/ll u8,
//   gid/ord/vis u32, used u32[16], adv/x f64, work (bidi.fi)
#[no_gc]
fn bo_cp() -> usize { return 0 }
#[no_gc]
fn bo_boff() -> usize { return BIDI_CAP * 4 }
#[no_gc]
fn bo_cls0() -> usize { return BIDI_CAP * 8 + 8 }
#[no_gc]
fn bo_cls() -> usize { return bo_cls0() + BIDI_CAP }
#[no_gc]
fn bo_lev() -> usize { return bo_cls() + BIDI_CAP }
#[no_gc]
fn bo_pl() -> usize { return bo_lev() + BIDI_CAP }
#[no_gc]
fn bo_del() -> usize { return bo_pl() + BIDI_CAP }
#[no_gc]
fn bo_form() -> usize { return bo_del() + BIDI_CAP }
#[no_gc]
fn bo_ll() -> usize { return bo_form() + BIDI_CAP }
#[no_gc]
fn bo_gid() -> usize { return bo_ll() + BIDI_CAP }
#[no_gc]
fn bo_ord() -> usize { return bo_gid() + BIDI_CAP * 4 }
#[no_gc]
fn bo_vis() -> usize { return bo_ord() + BIDI_CAP * 4 }
#[no_gc]
fn bo_used() -> usize { return bo_vis() + BIDI_CAP * 4 }
#[no_gc]
fn bo_adv() -> usize { return bo_used() + 64 }
#[no_gc]
fn bo_x() -> usize { return bo_adv() + BIDI_CAP * 8 }
#[no_gc]
fn bo_work() -> usize { return bo_x() + BIDI_CAP * 8 }
#[no_gc]
fn bidi_bytes() -> usize { return bo_work() + bidi.bidi_work_bytes(BIDI_CAP) }

#[no_gc]
fn bq(z: *mut Painter, off: usize) -> u64 { return (*z).bx + off as u64 }
#[no_gc]
fn br8(z: *mut Painter, off: usize, i: usize) -> u8 {
    return *((bq(z, off) + i as u64) as *mut u8)
}
#[no_gc]
fn br32(z: *mut Painter, off: usize, i: usize) -> u32 {
    return *((bq(z, off) + (i * 4) as u64) as *mut u32)
}
#[no_gc]
fn bw32(z: *mut Painter, off: usize, i: usize, v: u32) {
    *((bq(z, off) + (i * 4) as u64) as *mut u32) = v
}
#[no_gc]
fn brf(z: *mut Painter, off: usize, i: usize) -> f64 {
    return *((bq(z, off) + (i * 8) as u64) as *mut f64)
}
#[no_gc]
fn bwf(z: *mut Painter, off: usize, i: usize, v: f64) {
    *((bq(z, off) + (i * 8) as u64) as *mut f64) = v
}

// Die Oktettlage des Zeichens `i` (bei `bn` das Textende).
#[no_gc]
fn bo_byte(z: *mut Painter, i: usize) -> usize {
    return br32(z, bo_boff(), i) as usize
}

// Das Zeichen, das an Oktett `b` beginnt (oder das erste dahinter).
#[no_gc]
fn bo_char(z: *mut Painter, b: usize) -> usize {
    var i: usize = 0
    while i < (*z).bn && bo_byte(z, i) < b {
        i = i + 1
    }
    return i
}

#[no_gc]
fn bidi_para(z: *mut Painter) -> bidi.BidiPara {
    return bidi.bidi_new((*z).bt, bq(z, bo_cp()), (*z).bn, bq(z, bo_cls0()),
        bq(z, bo_cls()), bq(z, bo_lev()), bq(z, bo_pl()), bq(z, bo_work()))
}

// Ein Zeichen ohne Glyphe: in einer Ligatur aufgegangen, oder ein
// Steuerzeichen, das X9 herausnimmt (LRM, RLE, ZWJ ...).
#[no_gc]
fn bidi_hidden(z: *mut Painter, i: usize) -> bool {
    return br8(z, bo_del(), i) != 0 as u8
        || bidi.bidi_is_removed(br8(z, bo_cls0(), i))
}

// Ist gerade ein Text auf dem Bidi-Weg vorbereitet? Fuer die Pruefung.
#[no_gc]
fn run_is_bidi(z: *mut Painter) -> bool { return (*z).bn > 0 }

// DIE VORBEREITUNG. Rueckgabe: die Zahl der Zeichen, 0 = der alte Weg.
#[no_gc]
fn bidi_prepare(z: *mut Painter, r: *mut TextRun, p: u64, n: usize) -> usize {
    (*z).bn = 0
    if (*z).bt == 0 || (*z).bx == 0 || n == 0
        || !metrics.fm_present((*z).fm) {
        return 0
    }
    // 1. die Codepunkte
    var i: usize = 0
    var k: usize = 0
    while i < n {
        if k >= BIDI_CAP {
            return 0
        }
        var adv: usize = 1
        let cp: u32 = utf8_at(p, n, i, &adv)
        bw32(z, bo_cp(), k, cp)
        bw32(z, bo_boff(), k, i as u32)
        k = k + 1
        i = i + adv
    }
    bw32(z, bo_boff(), k, n as u32)
    if !bidi.bidi_needed((*z).bt, bq(z, bo_cp()), k, (*r).dir) {
        return 0
    }
    // 2. die Ebenen
    (*z).bn = k
    var bp: bidi.BidiPara = bidi_para(z)
    (*z).blev = bidi.bidi_run(&bp, (*r).dir)
    // 3. die Glyphen
    let f: *mut ttf.Font = metrics.fontset_font((*z).fm)
    if (*z).gs_fm != (*z).fm {
        let has: bool = gsub.gsub_init(f, &(*z).gs)
        (*z).gs_fm = (*z).fm
    }
    var miss: usize = 0
    let how: u32 = shape.shape_run((*z).bt, f, &(*z).gs, true,
        bq(z, bo_cp()), bq(z, bo_cls0()), bq(z, bo_lev()), k,
        bq(z, bo_gid()), bq(z, bo_del()), bq(z, bo_form()),
        bq(z, bo_used()), &miss)
    // 4. die Vorschuebe
    let sc: f64 = (*r).size / metrics.fm_upem((*z).fm)
    var j: usize = 0
    while j < k {
        var a: f64 = 0.0
        if !bidi_hidden(z, j) {
            a = (ttf.font_advance(f, br32(z, bo_gid(), j)) as f64) * sc
            if br32(z, bo_cp(), j) == 32 as u32 {
                a = a + (*r).word_spacing
            }
        }
        bwf(z, bo_adv(), j, a)
        j = j + 1
    }
    return k
}

// Die Breite der Zeichen a..b-1: Vorschuebe plus der Zeichenabstand
// zwischen den sichtbaren Glyphen.
#[no_gc]
fn bw_range(z: *mut Painter, r: *mut TextRun, a: usize, b: usize) -> f64 {
    var x: f64 = 0.0
    var nv: usize = 0
    var i: usize = a
    while i < b {
        x = x + brf(z, bo_adv(), i)
        if !bidi_hidden(z, i) {
            nv = nv + 1
        }
        i = i + 1
    }
    if nv > 1 {
        x = x + ((nv - 1) as f64) * (*r).tracking
    }
    return x
}

// Der Schritt nach Zeichen i, wenn danach noch etwas bis b kommt -- das
// Gegenstueck zu `advance_of` mit seinem `nxt`.
#[no_gc]
fn bidi_step(z: *mut Painter, r: *mut TextRun, i: usize, b: usize) -> f64 {
    var s: f64 = brf(z, bo_adv(), i)
    if !bidi_hidden(z, i) && i + 1 < b {
        s = s + (*r).tracking
    }
    return s
}

// Wie viele Zeichen ab a passen in `room`? Rueckgabe: das Ende (a..b).
// Unsichtbare Zeichen hinter dem letzten passenden gehen mit -- ein Alif,
// das im Lam-Alif steckt, darf nicht allein auf der naechsten Zeile
// landen.
#[no_gc]
fn bidi_fits(z: *mut Painter, r: *mut TextRun, a: usize, b: usize,
    room: f64) -> usize {
    var x: f64 = 0.0
    var i: usize = a
    while i < b {
        let st: f64 = bidi_step(z, r, i, b)
        if !bidi_hidden(z, i) && x + st > room {
            return i
        }
        x = x + st
        i = i + 1
    }
    return b
}

// Wo endet die Zeile ab a, und wo beginnt die naechste? Dieselbe Regel
// wie `run_line_upto`: an Leerzeichen, und ein einzelnes zu langes Wort
// wird doch auf dem Zeichen getrennt.
#[no_gc]
fn bidi_line_break(z: *mut Painter, r: *mut TextRun, a: usize, b: usize,
    room: f64, nach: *mut usize) -> usize {
    var x: f64 = 0.0
    var i: usize = a
    var gap: usize = a
    var after: usize = a
    while i < b {
        if br32(z, bo_cp(), i) == 32 as u32 {
            gap = i
            after = i + 1
        }
        let st: f64 = bidi_step(z, r, i, b)
        if !bidi_hidden(z, i) && x + st > room {
            if gap > a {
                *nach = after
                return gap
            }
            if i == a {
                var e: usize = a + 1
                while e < b && bidi_hidden(z, e) {
                    e = e + 1
                }
                *nach = e
                return e
            }
            *nach = i
            return i
        }
        x = x + st
        i = i + 1
    }
    *nach = b
    return b
}

// DIE ZEILE a..b-1 LEGEN: L1 fuer ihr Ende, L2 fuer die Reihenfolge, und
// danach je Zeichen seine linke Kante (`bo_x`, relativ zum Zeilenanfang)
// sowie die Liste der sichtbaren Glyphen von links nach rechts
// (`bo_vis`, `bvn`). Rueckgabe: die Breite der Zeile.
#[no_gc]
fn bidi_layout(z: *mut Painter, r: *mut TextRun, a: usize, b: usize) -> f64 {
    (*z).bvn = 0
    if b <= a {
        return 0.0
    }
    var bp: bidi.BidiPara = bidi_para(z)
    bidi.bidi_line_levels(&bp, a, b, bq(z, bo_ll()))
    bidi.bidi_reorder(bq(z, bo_ll()), b - a, bq(z, bo_ord()))
    var tv: usize = 0
    var i: usize = a
    while i < b {
        if !bidi_hidden(z, i) {
            tv = tv + 1
        }
        i = i + 1
    }
    var x: f64 = 0.0
    var seen: usize = 0
    var k: usize = 0
    while k < b - a {
        let j: usize = a + br32(z, bo_ord(), k) as usize
        bwf(z, bo_x(), j, x)
        if !bidi_hidden(z, j) {
            bw32(z, bo_vis(), (*z).bvn, j as u32)
            (*z).bvn = (*z).bvn + 1
            x = x + brf(z, bo_adv(), j)
            seen = seen + 1
            if seen < tv {
                x = x + (*r).tracking
            }
        }
        k = k + 1
    }
    return x
}

// Die zuletzt gelegte Zeile in das Raster.
#[no_gc]
fn bidi_into_raster(z: *mut Painter, r: *mut TextRun, sx: f64,
    base_y: f64, dx: f64, dy: f64) {
    let f: *mut ttf.Font = metrics.fontset_font((*z).fm)
    let sc: f64 = (*r).size / metrics.fm_upem((*z).fm)
    var k: usize = 0
    while k < (*z).bvn {
        let j: usize = br32(z, bo_vis(), k) as usize
        glyph_into(z, r, f, br32(z, bo_gid(), j),
            sx + dx + brf(z, bo_x(), j), base_y + dy, sc)
        k = k + 1
    }
}

// Eine Zeile a..b-1 ausgerichtet malen. Rueckgabe wie `run_draw`.
fn bidi_draw_line(z: *mut Painter, r: *mut TextRun, x: f64, base_y: f64,
    w: f64, col: u32, a: usize, b: usize, align: u32) -> f64 {
    if b <= a {
        return x
    }
    let br: f64 = bidi_layout(z, r, a, b)
    var sx: f64 = x
    if align == TEXT_M {
        sx = x + (w - br) / 2.0
    } else if align == TEXT_R {
        sx = x + w - br
    }
    sx = ((sx + 0.5) as i64) as f64
    return paint_run(z, r, sx, base_y, br, col, 0, 0, true)
}

// EINE ZEILE MIT "..." -- AM RICHTIGEN ENDE. Die Punkte stehen dort, wo
// der Text weitergehen wuerde: in einem Absatz von links nach rechts
// rechts, in einem von rechts nach links LINKS. Gekuerzt wird logisch
// (der Anfang des Textes bleibt stehen), gelegt wird nur das, was bleibt.
fn bidi_draw_ellipsis(z: *mut Painter, r: *mut TextRun, x: f64,
    base_y: f64, w: f64, col: u32, a: usize, b: usize,
    align: u32) -> f64 {
    let full: f64 = bw_range(z, r, a, b)
    if w <= 0.0 || full <= w {
        return bidi_draw_line(z, r, x, base_y, w, col, a, b, align)
    }
    let ew: f64 = ellipsis_w(z, r)
    if ew > w {
        return x
    }
    let c: usize = bidi_fits(z, r, a, b, w - ew)
    if c == a {
        return x
    }
    let tw: f64 = bidi_layout(z, r, a, c)
    var sx: f64 = x
    if align == TEXT_M {
        sx = x + (w - (tw + ew)) / 2.0
    } else if align == TEXT_R {
        sx = x + w - (tw + ew)
    }
    let rtl: bool = (br8(z, bo_pl(), a) & 1 as u8) != 0 as u8
    var tx: f64 = sx
    var dx: f64 = sx + tw
    if rtl {
        tx = sx + ew
        dx = sx
    }
    tx = ((tx + 0.5) as i64) as f64
    let e1: f64 = paint_run(z, r, tx, base_y, tw, col, 0, 0, true)
    // Die Punkte gehen den alten Weg: drei ASCII-Zeichen brauchen keinen
    // Algorithmus -- und `run_draw` wuerde den vorbereiteten Text
    // ueberschreiben, den ein mehrzeiliger Aufrufer noch braucht.
    var pkt: [u8; 4] = "...\0"
    let e2: f64 = run_draw_ltr(z, r, dx, base_y, 0.0, col,
        (&pkt[0 as usize]) as u64, 3, TEXT_L)
    if rtl {
        return tx + tw
    }
    return e2
}

// MEHRZEILIG, fuer Messen (`malen` = false) und Malen. Eine Funktion,
// damit die Vorhersage der Zeilenzahl und das Bild nicht
// auseinanderlaufen -- dieselbe Lehre wie bei `nur_leer`.
fn bidi_wrapped(z: *mut Painter, r: *mut TextRun, x: f64, base_y: f64,
    w: f64, zeilen_h: f64, col: u32, k: usize, align: u32,
    max_zeilen: usize, malen: bool) -> usize {
    var zeilen: usize = 0
    var i: usize = 0
    var y: f64 = base_y
    while i < k && zeilen < max_zeilen {
        var leer: bool = true
        var q: usize = i
        while q < k {
            if br32(z, bo_cp(), q) != 32 as u32 {
                leer = false
                break
            }
            q = q + 1
        }
        if leer {
            return zeilen
        }
        var weiter: usize = k
        let bis: usize = bidi_line_break(z, r, i, k, w, &weiter)
        if bis == i {
            return zeilen
        }
        if malen {
            if zeilen + 1 == max_zeilen && weiter < k {
                let e4: f64 = bidi_draw_ellipsis(z, r, x, y, w, col, i, k,
                    align)
            } else {
                let e5: f64 = bidi_draw_line(z, r, x, y, w, col, i, bis,
                    align)
            }
        }
        zeilen = zeilen + 1
        y = y + zeilen_h
        i = weiter
    }
    return zeilen
}

// ======================================================================
// DIE SCHREIBMARKE IN DER ZWEIRICHTUNGSSCHRIFT
// ======================================================================
//
// In einem gemischten Text liegt die Grenze hinter dem Zeichen i NICHT
// bei "Breite der ersten i Zeichen": hinter einem hebraeischen Wort steht
// die Marke LINKS von ihm. Die Regel, nach der jeder Texteditor sie
// setzt: sie haengt an der HINTERKANTE des Zeichens davor -- rechts bei
// gerader Ebene, links bei ungerader. Am Textanfang gibt es kein Zeichen
// davor; dann haengt sie an der VORDERKANTE des ersten.
//
// Alle Zahlen sind relativ zum linken Rand des Textes, so wie `run_draw`
// ihn mit TEXT_L legt. Ohne Bidi-Weg ist das die Breite der ersten
// `bi` Oktette -- genau das, was das Textfeld vorher gerechnet hat.
#[no_gc]
fn run_caret_x(z: *mut Painter, r: *mut TextRun, p: u64, n: usize,
    bi: usize) -> f64 {
    var b: usize = bi
    if b > n {
        b = n
    }
    let k: usize = bidi_prepare(z, r, p, n)
    if k == 0 {
        if b == 0 {
            return 0.0
        }
        return run_width(z, r, p, b)
    }
    let tw: f64 = bidi_layout(z, r, 0, k)
    let ci: usize = bo_char(z, b)
    if ci == 0 {
        let x0: f64 = brf(z, bo_x(), 0)
        if (br8(z, bo_ll(), 0) & 1 as u8) != 0 as u8 {
            return x0 + brf(z, bo_adv(), 0)
        }
        return x0
    }
    let j: usize = ci - 1
    let xj: f64 = brf(z, bo_x(), j)
    if (br8(z, bo_ll(), j) & 1 as u8) != 0 as u8 {
        return xj
    }
    return xj + brf(z, bo_adv(), j)
}

// DIE GRENZE UNTER EINEM PUNKT x (relativ zum linken Textrand), als
// Oktettlage. Getroffen wird die naechste sichtbare Glyphe; die linke
// Haelfte einer Glyphe gerader Ebene ist ihr Anfang, die linke Haelfte
// einer Glyphe ungerader Ebene ihr ENDE.
#[no_gc]
fn run_hit(z: *mut Painter, r: *mut TextRun, p: u64, n: usize,
    x: f64) -> usize {
    let k: usize = bidi_prepare(z, r, p, n)
    if k == 0 {
        // der alte Weg: die naechste Zeichengrenze nach der Breite davor
        var best: usize = 0
        var bestd: f64 = x
        if bestd < 0.0 {
            bestd = 0.0 - bestd
        }
        var i: usize = 0
        while i < n {
            var adv: usize = 1
            let cp: u32 = utf8_at(p, n, i, &adv)
            i = i + adv
            var d: f64 = run_width(z, r, p, i) - x
            if d < 0.0 {
                d = 0.0 - d
            }
            if d < bestd {
                bestd = d
                best = i
            }
        }
        return best
    }
    let tw: f64 = bidi_layout(z, r, 0, k)
    var best_i: usize = k
    var best_d: f64 = 0.0
    var j: usize = 0
    while j < k {
        if !bidi_hidden(z, j) {
            let l: f64 = brf(z, bo_x(), j)
            let rr: f64 = l + brf(z, bo_adv(), j)
            var d: f64 = 0.0
            if x < l {
                d = l - x
            } else if x > rr {
                d = x - rr
            }
            if best_i == k || d < best_d {
                best_i = j
                best_d = d
            }
        }
        j = j + 1
    }
    if best_i == k {
        return 0
    }
    let l2: f64 = brf(z, bo_x(), best_i)
    let mid: f64 = l2 + brf(z, bo_adv(), best_i) / 2.0
    let odd: bool = (br8(z, bo_ll(), best_i) & 1 as u8) != 0 as u8
    var after: bool = x >= mid
    if odd {
        after = !after
    }
    var c: usize = best_i
    if after {
        c = best_i + 1
        // hinter einem Lam-Alif steht die Marke hinter dem Alif
        while c < k && bidi_hidden(z, c) && br8(z, bo_del(), c) != 0 as u8 {
            c = c + 1
        }
    }
    return bo_byte(z, c)
}

// Laeuft der Absatz dieses Textes von rechts nach links?
#[no_gc]
fn run_para_rtl(z: *mut Painter, r: *mut TextRun, p: u64, n: usize) -> bool {
    if n == 0 {
        return (*r).dir == bidi.DIR_RTL
    }
    let k: usize = bidi_prepare(z, r, p, n)
    if k == 0 {
        return false
    }
    return ((*z).blev & 1 as u8) != 0 as u8
}

// DIE AUSWAHL: die Oktette sa..sb-1 hinterlegen. Auf dem alten Weg ist
// das EIN Rechteck; in der Zweirichtungsschrift kann eine logisch
// zusammenhaengende Auswahl auf dem Schirm in mehrere Stuecke zerfallen
// ("abc אבג" mit Auswahl ueber "c א" sind zwei Stuecke), und jedes wird
// fuer sich gemalt. `ox` ist der linke Textrand.
fn run_sel_draw(z: *mut Painter, r: *mut TextRun, ox: f64, y: f64, h: f64,
    p: u64, n: usize, sa: usize, sb: usize, col: u32) {
    if sb <= sa {
        return
    }
    let k: usize = bidi_prepare(z, r, p, n)
    if k == 0 {
        let xa: f64 = run_width(z, r, p, sa)
        let xb: f64 = run_width(z, r, p, sb)
        surface(z, ox + xa, y, xb - xa, h, col)
        return
    }
    let tw: f64 = bidi_layout(z, r, 0, k)
    let ca: usize = bo_char(z, sa)
    let cb: usize = bo_char(z, sb)
    var open: bool = false
    var x0: f64 = 0.0
    var x1: f64 = 0.0
    var q: usize = 0
    while q < k {
        let j: usize = br32(z, bo_ord(), q) as usize
        let inside: bool = j >= ca && j < cb
        let l: f64 = brf(z, bo_x(), j)
        let rr: f64 = l + brf(z, bo_adv(), j)
        if inside {
            if !open {
                open = true
                x0 = l
            }
            x1 = rr
        } else if open && !bidi_hidden(z, j) {
            surface(z, ox + x0, y, x1 - x0, h, col)
            open = false
        }
        q = q + 1
    }
    if open {
        surface(z, ox + x0, y, x1 - x0, h, col)
    }
}

// ======================================================================
// DAS MESSEN FUER DAS TEXTFELD
// ======================================================================
//
// lib/fui/editor.fi kennt keine Leinwand (mit Absicht, siehe dort) und
// fragt die Lage der Schreibmarke ueber Funktionszeiger mit einem
// Kontextwert -- dieselbe Form wie die Zwischenablage. `Measure` ist
// dieser Kontext: ein Maler und der Textlauf, mit dem das Feld malt.
struct Measure {
    z: u64,
    r: TextRun,
}

fn measure_new(z: *mut Painter, r: TextRun) -> Measure {
    return Measure { z: z as u64, r: r }
}

fn measure_x(ctx: u64, p: u64, n: usize, i: usize) -> f64 {
    let m: *mut Measure = ctx as *mut Measure
    return run_caret_x((*m).z as *mut Painter, &(*m).r, p, n, i)
}

fn measure_hit(ctx: u64, p: u64, n: usize, x: f64) -> usize {
    let m: *mut Measure = ctx as *mut Measure
    return run_hit((*m).z as *mut Painter, &(*m).r, p, n, x)
}

fn measure_width(ctx: u64, p: u64, n: usize) -> f64 {
    let m: *mut Measure = ctx as *mut Measure
    return run_width((*m).z as *mut Painter, &(*m).r, p, n)
}

fn measure_rtl(ctx: u64, p: u64, n: usize) -> bool {
    let m: *mut Measure = ctx as *mut Measure
    return run_para_rtl((*m).z as *mut Painter, &(*m).r, p, n)
}
