// SPDX-License-Identifier: MPL-2.0
// lib/fui/applay.fi -- LAYOUT HELPERS FOR THE TEN-LINE APP API (fui.app): pages that read like a web page.
//
// WHY: `app.row` and `app.column` open a box that CENTRES its children on both axes (the right thing for a ten-line demo window, the
// wrong thing for a phone page: buttons, status lines and fields hang in the middle of the screen). The primitives for a page that
// starts at the left already exist in fui.scene / fui.flex (justify start, align stretch, wrap, grow); what was missing is ONE call
// for each of the usual shapes. This file is those calls. Nothing here is drawn; everything is plain node settings, so a page built
// with them costs no extra nodes.
//
//   hrow(a)             a LINE of widgets from the left, centred vertically, WRAPPING into the next line when the room is used,
//                       as wide as its container (a chip bar). Close with `app.end`.
//   hline(a)            the same without wrapping (a field and its button: give the field `grow`)
//   vstack(a)           a column from the top, children stretched to the full width, as wide as its container
//   stretch(a, n)       node `n` is as wide as its container (cross axis of a column)
//   grow(a, n, g)       node `n` takes the free room of a row (g = share) / the free height of a column; never below `min_pt`
//   field_fill(a, n)    a text field that takes the room left in its line (instead of the fixed ENTRY_W)
//   pad(a, n, l, t, r, b), gap(a, n, main, cross)   inner margin / space between the children, in design points
//   align_start(a, n)   a child of a stretching column keeps its own width at the left
//
// All sizes are design points (CSS px at 96 dpi), like the rest of fUi.
import fui.app
import fui.scene
import fui.flex

export { hrow, hline, vstack, stretch, grow, field_fill, pad, gap, align_start }

const NONE: usize = 4294967295
const LINE_GAP: i64 = 8
const FIELD_MIN: i64 = 60

// A line of widgets from the left, centred vertically, wrapping, as wide as the container.
fn hrow(a: *mut app.App) -> usize {
    let r: usize = app.row(a)
    if r == NONE { return NONE }
    let sc: *mut scene.Scene = app.app_scene(a)
    scene.node_set_flex(sc, r, flex.FLEX_ROW, flex.JUSTIFY_START, flex.AL_CENTER)
    scene.node_set_wrap(sc, r, flex.WRAP_WRAP)
    scene.node_set_gap(sc, r, LINE_GAP, LINE_GAP)
    scene.node_set_align_self(sc, r, flex.AL_STRETCH)
    return r
}

// A line that never wraps: the widgets share the width (a field with `grow` + a button).
fn hline(a: *mut app.App) -> usize {
    let r: usize = app.row(a)
    if r == NONE { return NONE }
    let sc: *mut scene.Scene = app.app_scene(a)
    scene.node_set_flex(sc, r, flex.FLEX_ROW, flex.JUSTIFY_START, flex.AL_CENTER)
    scene.node_set_gap(sc, r, LINE_GAP, LINE_GAP)
    scene.node_set_align_self(sc, r, flex.AL_STRETCH)
    return r
}

// A column from the top whose children are as wide as the column; the column is as wide as its container.
fn vstack(a: *mut app.App) -> usize {
    let c: usize = app.column(a)
    if c == NONE { return NONE }
    let sc: *mut scene.Scene = app.app_scene(a)
    scene.node_set_flex(sc, c, flex.FLEX_COLUMN, flex.JUSTIFY_START, flex.AL_STRETCH)
    scene.node_set_gap(sc, c, LINE_GAP, LINE_GAP)
    scene.node_set_align_self(sc, c, flex.AL_STRETCH)
    return c
}

// Node `n` is as wide as its container (a child of a column).
fn stretch(a: *mut app.App, n: usize) {
    if n == NONE { return }
    scene.node_set_align_self(app.app_scene(a), n, flex.AL_STRETCH)
}

// Node `n` is left at the start of the cross axis (a child of a stretching column that should keep its own width).
fn align_start(a: *mut app.App, n: usize) {
    if n == NONE { return }
    scene.node_set_align_self(app.app_scene(a), n, flex.AL_START)
}

// Free room goes to node `n` in the proportion `g` (0 = none); the node never shrinks below FIELD_MIN points.
fn grow(a: *mut app.App, n: usize, g: i64) {
    if n == NONE { return }
    scene.node_set_flexitem(app.app_scene(a), n, g, 1, FIELD_MIN, 0)
}

// A text field that fills the rest of its line: the fixed width of `app.entry` is cut to the minimum, `grow` does the rest.
fn field_fill(a: *mut app.App, n: usize) {
    if n == NONE { return }
    app.set_width(a, n, FIELD_MIN as usize)
    scene.node_set_flexitem(app.app_scene(a), n, 1, 1, FIELD_MIN, 0)
}

// Inner margin of a box, in points.
fn pad(a: *mut app.App, n: usize, l: i64, t: i64, r: i64, b: i64) {
    if n == NONE { return }
    scene.node_set_padding(app.app_scene(a), n, l, t, r, b)
}

// Space between the children of a box (main axis, cross axis; between lines of a wrapping row).
fn gap(a: *mut app.App, n: usize, main: i64, cross: i64) {
    if n == NONE { return }
    scene.node_set_gap(app.app_scene(a), n, main, cross)
}
