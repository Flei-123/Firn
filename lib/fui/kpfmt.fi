import std.rt

export { fmt_time }

fn put2(out: *mut rt.Buf, v: u64) {
    if v < 10 as u64 {
        rt.buf_push(out, 48 as u8)
    }
    rt.buf_push_dec_u64(out, v)
}

fn fmt_time(ms: u64, out: *mut rt.Buf) {
    let total: u64 = ms / (1000 as u64)
    let s: u64 = total % (60 as u64)
    let m: u64 = (total / (60 as u64)) % (60 as u64)
    let h: u64 = total / (3600 as u64)
    if h > 0 as u64 {
        rt.buf_push_dec_u64(out, h)
        rt.buf_push(out, 58 as u8)
        put2(out, m)
    } else {
        rt.buf_push_dec_u64(out, m)
    }
    rt.buf_push(out, 58 as u8)
    put2(out, s)
}
