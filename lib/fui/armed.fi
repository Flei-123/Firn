// SPDX-License-Identifier: MPL-2.0
export {
    Armed, armed_new, armed_tap, armed_clear, armed_is, armed_id,
}

const NONE: i64 = -1

struct Armed {
    id: i64,
}

fn armed_new() -> Armed {
    return Armed { id: NONE }
}

fn armed_tap(a: *mut Armed, id: i64) -> bool {
    if (*a).id == id {
        (*a).id = NONE
        return true
    }
    (*a).id = id
    return false
}

fn armed_clear(a: *mut Armed) {
    (*a).id = NONE
}

fn armed_is(a: *mut Armed, id: i64) -> bool {
    return (*a).id == id && id != NONE
}

fn armed_id(a: *mut Armed) -> i64 {
    return (*a).id
}
