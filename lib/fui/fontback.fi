// SPDX-License-Identifier: MPL-2.0
import font.metrics

export {
    FontBackend, fbk_default, fbk_custom,
    fbk_ascent, fbk_descent, fbk_advance, fbk_pair_adjust,
    fbk_present, fbk_has, fbk_pick,
    fbk_set_ctx, fbk_ctx,
}

struct FontBackend {
    custom: usize,
    ctx: u64,
    ascent: fn(u64, u64, f64) -> f64,
    descent: fn(u64, u64, f64) -> f64,
    advance: fn(u64, u64, f64, u32) -> f64,
    pair_adjust: fn(u64, u64, f64, u32, u32) -> f64,
    present: fn(u64, u64) -> bool,
    has: fn(u64, u64, u32) -> bool,
    pick: fn(u64, u64, u32) -> u64,
}

#[no_gc]
fn stub_ascent(fm: u64, ctx: u64, size: f64) -> f64 {
    return metrics.fm_ascent(fm, size)
}

#[no_gc]
fn stub_descent(fm: u64, ctx: u64, size: f64) -> f64 {
    return metrics.fm_descent(fm, size)
}

#[no_gc]
fn stub_advance(fm: u64, ctx: u64, size: f64, cp: u32) -> f64 {
    return metrics.fm_advance(fm, size, cp)
}

#[no_gc]
fn stub_pair_adjust(fm: u64, ctx: u64, size: f64, a: u32, b: u32) -> f64 {
    return metrics.fm_kern(fm, size, a, b)
}

#[no_gc]
fn stub_present(fm: u64, ctx: u64) -> bool {
    return metrics.fm_present(fm)
}

#[no_gc]
fn stub_has(fm: u64, ctx: u64, cp: u32) -> bool {
    return metrics.fm_has(fm, cp)
}

#[no_gc]
fn stub_pick(fm: u64, ctx: u64, cp: u32) -> u64 {
    return fm
}

#[no_gc]
fn fbk_default() -> FontBackend {
    return FontBackend {
        custom: 0, ctx: 0,
        ascent: stub_ascent, descent: stub_descent,
        advance: stub_advance, pair_adjust: stub_pair_adjust,
        present: stub_present, has: stub_has, pick: stub_pick,
    }
}

#[no_gc]
fn fbk_custom(b: FontBackend) -> FontBackend {
    var o: FontBackend = b
    o.custom = 1
    return o
}

#[no_gc]
fn fbk_set_ctx(b: *mut FontBackend, ctx: u64) {
    (*b).ctx = ctx
}

#[no_gc]
fn fbk_ctx(b: *mut FontBackend) -> u64 {
    return (*b).ctx
}

#[no_gc]
fn fbk_ascent(b: *mut FontBackend, fm: u64, size: f64) -> f64 {
    if (*b).custom == 0 {
        return metrics.fm_ascent(fm, size)
    }
    let f: fn(u64, u64, f64) -> f64 = (*b).ascent
    return f(fm, (*b).ctx, size)
}

#[no_gc]
fn fbk_descent(b: *mut FontBackend, fm: u64, size: f64) -> f64 {
    if (*b).custom == 0 {
        return metrics.fm_descent(fm, size)
    }
    let f: fn(u64, u64, f64) -> f64 = (*b).descent
    return f(fm, (*b).ctx, size)
}

#[no_gc]
fn fbk_advance(b: *mut FontBackend, fm: u64, size: f64, cp: u32) -> f64 {
    if (*b).custom == 0 {
        return metrics.fm_advance(fm, size, cp)
    }
    let f: fn(u64, u64, f64, u32) -> f64 = (*b).advance
    return f(fm, (*b).ctx, size, cp)
}

#[no_gc]
fn fbk_pair_adjust(b: *mut FontBackend, fm: u64, size: f64, a: u32, c: u32) -> f64 {
    if (*b).custom == 0 {
        return metrics.fm_kern(fm, size, a, c)
    }
    let f: fn(u64, u64, f64, u32, u32) -> f64 = (*b).pair_adjust
    return f(fm, (*b).ctx, size, a, c)
}

#[no_gc]
fn fbk_present(b: *mut FontBackend, fm: u64) -> bool {
    if (*b).custom == 0 {
        return metrics.fm_present(fm)
    }
    let f: fn(u64, u64) -> bool = (*b).present
    return f(fm, (*b).ctx)
}

#[no_gc]
fn fbk_has(b: *mut FontBackend, fm: u64, cp: u32) -> bool {
    if (*b).custom == 0 {
        return metrics.fm_has(fm, cp)
    }
    let f: fn(u64, u64, u32) -> bool = (*b).has
    return f(fm, (*b).ctx, cp)
}

#[no_gc]
fn fbk_pick(b: *mut FontBackend, fm: u64, cp: u32) -> u64 {
    if (*b).custom == 0 {
        return fm
    }
    let f: fn(u64, u64, u32) -> u64 = (*b).pick
    return f(fm, (*b).ctx, cp)
}
