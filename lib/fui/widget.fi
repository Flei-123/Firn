// SPDX-License-Identifier: MPL-2.0
// lib/fui/widget.fi -- WHAT EVERY CONTROL IS.
//
// ========================================================= WHY IT EXISTS
//
// Justin wants the full list: button, label, checkbox, dropdown, tab,
// table, tree, dialogs -- "really everything". That only works if they
// all ARE the same. Otherwise wave 3 has a different construction than
// wave 1, and then the cut was wrong (JARVIS' condition: "If wave 3
// overturns the construction of wave 1, you cut it wrong").
//
// This file is that cut. A widget is:
//
//   * a RECT              where it sits
//   * a STATE             normal/hover/active/focus/disabled/selected
//   * a STYLESET          how it should look (lib/fui/style.fi)
//   * a KIND              what it is (button, label, ...)
//   * A FEW NUMBERS       text, value, id
//
//
// and nothing else. Everything a widget DOES is a function on it.
//
// ==================================================== WHAT IS NOT HERE
//
// E1 NO storage of its own. The text of a label is a pointer owned by
//    the caller, not a copied buffer. That keeps a widget a value
//    structure and the library allocation-free.
// E2 NO drawing. That lives in lib/fui/render.fi, so this file stays
//    testable without a canvas.
// E3 NO child list. A widget does not know who sits inside it --
//    the layout knows that (lib/fui/layout.fi). A tree of pointers
//    would be the end of being allocation-free.
import std.rt
import fui.style

export {
    Widget, widget_new,
    w_place, w_x, w_y, w_w, w_h, w_hits,
    w_set_state_bits, w_state, w_set_hover, w_set_active,
    w_set_focus, w_set_disabled, w_set_selected,
    w_is_hover, w_is_active, w_is_focus, w_is_disabled,
    w_is_selected, w_is_enabled,
    w_styleset, w_set_styleset, w_style, w_set_style,
    w_set_text, w_text, w_text_len,
    w_set_value, w_value, w_set_id, w_id,
    w_kind, w_set_kind,
    w_pref_w, w_pref_h, w_set_pref, w_set_grow,
    w_grows_x, w_grows_y,
    KIND_NONE, KIND_LABEL, KIND_BUTTON, KIND_TOGGLE, KIND_CHECKBOX,
    KIND_RADIO, KIND_TEXTBOX, KIND_SLIDER, KIND_PROGRESS,
    KIND_DROPDOWN, KIND_LIST, KIND_TAB, KIND_TOOLBAR, KIND_MENU,
    KIND_SCROLLBAR, KIND_SEPARATOR, KIND_GROUPBOX, KIND_TABLE, KIND_TREE,
    KIND_TILE, KIND_CARD, KIND_BADGE, KIND_TOOLTIP,
}

// ============================================================ THE KINDS
//
// The full list from Justin's brief, right here -- including the ones
// that only get built in waves 3 and 4. A number costs nothing, and a
// kind added later would otherwise shift the numbers.
const KIND_NONE: u32 = 0
const KIND_LABEL: u32 = 1
const KIND_BUTTON: u32 = 2
const KIND_TOGGLE: u32 = 3
const KIND_CHECKBOX: u32 = 4
const KIND_RADIO: u32 = 5
const KIND_TEXTBOX: u32 = 6
const KIND_SLIDER: u32 = 7
const KIND_PROGRESS: u32 = 8
const KIND_DROPDOWN: u32 = 9
const KIND_LIST: u32 = 10
const KIND_TAB: u32 = 11
const KIND_TOOLBAR: u32 = 12
const KIND_MENU: u32 = 13
const KIND_SCROLLBAR: u32 = 14
const KIND_SEPARATOR: u32 = 15
const KIND_GROUPBOX: u32 = 16
const KIND_TABLE: u32 = 17
const KIND_TREE: u32 = 18
const KIND_TILE: u32 = 19
const KIND_CARD: u32 = 20
const KIND_BADGE: u32 = 21
const KIND_TOOLTIP: u32 = 22

// ====================================================== THE STATE BITS
//
// As BITS and not as one number, because they hold at the same time:
// a button can be focused AND hovered. Which of them decides the
// LOOK is settled by `w_state` -- in one place.
const BIT_HOVER: u32 = 1
const BIT_ACTIVE: u32 = 2
const BIT_FOCUS: u32 = 4
const BIT_DISABLED: u32 = 8
const BIT_SELECTED: u32 = 16

struct Widget {
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    kind: u32,
    bits: u32,
    styleset: style.StyleSet,
    // The text belongs to the CALLER (E1). A widget only holds the
    // pointer -- that keeps it copyable and the library
    // allocation-free.
    t_p: u64,
    t_n: usize,
    // The value: on a slider the position, on a checkbox 0/1, on a tab
    // the number. ONE number, because every widget needs exactly one --
    // and whoever needs two has two widgets.
    value: i64,
    // What the caller gets back on a hit.
    id: u32,
    // Preferred size and stretchiness -- the layout asks for these.
    pref_w: f64,
    pref_h: f64,
    grow: u32,   // Bit 0 = waagerecht, Bit 1 = vertical
}

fn widget_new(kind: u32) -> Widget {
    return Widget {
        x: 0.0, y: 0.0, w: 0.0, h: 0.0,
        kind: kind, bits: 0, styleset: style.styleset_new(),
        t_p: 0, t_n: 0, value: 0, id: 0,
        pref_w: 0.0, pref_h: 0.0, grow: 0,
    }
}

// --------------------------------------------------------- the geometry
fn w_place(e: *mut Widget, x: f64, y: f64, w: f64, h: f64) {
    (*e).x = x
    (*e).y = y
    (*e).w = w
    (*e).h = h
}

fn w_x(e: *mut Widget) -> f64 { return (*e).x }
fn w_y(e: *mut Widget) -> f64 { return (*e).y }
fn w_w(e: *mut Widget) -> f64 { return (*e).w }
fn w_h(e: *mut Widget) -> f64 { return (*e).h }

// THE HIT AREA IS THE WHOLE RECT.
//
// The template says it outright: "visible area and hit area are the
// same rect. An icon smaller than its button changes nothing about
// that." A disabled widget is NOT hit -- otherwise it swallows clicks
// that should go to the widget underneath.
//
fn w_hits(e: *mut Widget, px: f64, py: f64) -> bool {
    if ((*e).bits & BIT_DISABLED) != 0 as u32 {
        return false
    }
    return px >= (*e).x && px < (*e).x + (*e).w
        && py >= (*e).y && py < (*e).y + (*e).h
}

// ----------------------------------------------------------- the states
fn set_bit(e: *mut Widget, bit: u32, an: bool) {
    if an {
        (*e).bits = (*e).bits | bit
    } else {
        (*e).bits = (*e).bits & (4294967295 as u32 - bit)
    }
}

fn w_set_hover(e: *mut Widget, an: bool) { set_bit(e, BIT_HOVER, an) }
fn w_set_active(e: *mut Widget, an: bool) { set_bit(e, BIT_ACTIVE, an) }
fn w_set_focus(e: *mut Widget, an: bool) { set_bit(e, BIT_FOCUS, an) }
fn w_set_selected(e: *mut Widget, an: bool) {
    set_bit(e, BIT_SELECTED, an)
}

// Disabling clears caret and press with it: a disabled widget that
// still holds "pressed" in memory jumps when it is re-enabled.
fn w_set_disabled(e: *mut Widget, an: bool) {
    set_bit(e, BIT_DISABLED, an)
    if an {
        set_bit(e, BIT_HOVER, false)
        set_bit(e, BIT_ACTIVE, false)
    }
}

fn w_is_hover(e: *mut Widget) -> bool {
    return ((*e).bits & BIT_HOVER) != 0 as u32
}
fn w_is_active(e: *mut Widget) -> bool {
    return ((*e).bits & BIT_ACTIVE) != 0 as u32
}
fn w_is_focus(e: *mut Widget) -> bool {
    return ((*e).bits & BIT_FOCUS) != 0 as u32
}
fn w_is_disabled(e: *mut Widget) -> bool {
    return ((*e).bits & BIT_DISABLED) != 0 as u32
}
fn w_is_selected(e: *mut Widget) -> bool {
    return ((*e).bits & BIT_SELECTED) != 0 as u32
}
fn w_is_enabled(e: *mut Widget) -> bool {
    return ((*e).bits & BIT_DISABLED) == 0 as u32
}

// ==================================================== THE VISIBLE STATE
//
// THE PRECEDENCE, ONCE AND FOR ALL WIDGETS. Several bits hold at the
// same time; which one decides the look is written here:
//
//   1. DISABLED beats everything. A disabled button under the pointer
//               is disabled, not hovered.
//   2. ACTIVE   what is being pressed right now, you see.
//   3. SELECTED a selected tab stays selected, even when the pointer
//               is somewhere else.
//   4. HOVER
//   5. FOCUS    last, because focus is a RING and does not colour the
//               surface (see theme.surface_for). A widget that is
//               focused AND hovered should show the hover surface and
//               the focus ring on top of it.
fn w_state(e: *mut Widget) -> u32 {
    let b: u32 = (*e).bits
    if (b & BIT_DISABLED) != 0 as u32 {
        return style.STATE_DISABLED
    }
    if (b & BIT_ACTIVE) != 0 as u32 {
        return style.STATE_ACTIVE
    }
    if (b & BIT_SELECTED) != 0 as u32 {
        return style.STATE_SELECTED
    }
    if (b & BIT_HOVER) != 0 as u32 {
        return style.STATE_HOVER
    }
    if (b & BIT_FOCUS) != 0 as u32 {
        return style.STATE_FOCUS
    }
    return style.STATE_NORMAL
}

fn w_set_state_bits(e: *mut Widget, bits: u32) { (*e).bits = bits }

// -------------------------------------------------------------- the Style
fn w_styleset(e: *mut Widget) -> *mut style.StyleSet { return &(*e).styleset }
fn w_set_styleset(e: *mut Widget, z: style.StyleSet) { (*e).styleset = z }
fn w_style(e: *mut Widget) -> *mut style.Style {
    return style.styleset_base(&(*e).styleset)
}
fn w_set_style(e: *mut Widget, s: style.Style) {
    let p: *mut style.Style = style.styleset_base(&(*e).styleset)
    *p = s
}

// ---------------------------------------------------------- text and value
fn w_set_text(e: *mut Widget, p: u64, n: usize) {
    (*e).t_p = p
    (*e).t_n = n
}
fn w_text(e: *mut Widget) -> u64 { return (*e).t_p }
fn w_text_len(e: *mut Widget) -> usize { return (*e).t_n }

fn w_set_value(e: *mut Widget, v: i64) { (*e).value = v }
fn w_value(e: *mut Widget) -> i64 { return (*e).value }

fn w_set_id(e: *mut Widget, k: u32) { (*e).id = k }
fn w_id(e: *mut Widget) -> u32 { return (*e).id }

fn w_kind(e: *mut Widget) -> u32 { return (*e).kind }
fn w_set_kind(e: *mut Widget, a: u32) { (*e).kind = a }

// ------------------------------------------------------- for the layout
fn w_set_pref(e: *mut Widget, w: f64, h: f64) {
    (*e).pref_w = w
    (*e).pref_h = h
}
fn w_pref_w(e: *mut Widget) -> f64 { return (*e).pref_w }
fn w_pref_h(e: *mut Widget) -> f64 { return (*e).pref_h }

// Stretchy means: take the space that is left over. An address field in
// a bar grows horizontally, the buttons next to it do not.
fn w_set_grow(e: *mut Widget, x: bool, y: bool) {
    var d: u32 = 0
    if x {
        d = d | 1 as u32
    }
    if y {
        d = d | 2 as u32
    }
    (*e).grow = d
}
fn w_grows_x(e: *mut Widget) -> bool {
    return ((*e).grow & 1 as u32) != 0 as u32
}
fn w_grows_y(e: *mut Widget) -> bool {
    return ((*e).grow & 2 as u32) != 0 as u32
}
