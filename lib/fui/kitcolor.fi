// SPDX-License-Identifier: MPL-2.0
// lib/fui/kitcolor.fi -- THE LAUNCHER LOOK: a dark theme with a green accent.
//
// The theme tables (lib/fui/theme.fi) already hold a light and a dark set
// whose text pairs are checked for WCAG 2 contrast in the build
// (tools/fui/contrast_main.fi). What an application changes is the ACCENT --
// `theme_set_accent` re-derives the text that stands on it and the selection.
// What no table can say is how an accent behaves as TEXT: the launcher's
// #1bd96a is 9:1 on the dark ground and 1.7:1 on a white one. This file is
// the one place that knows how to turn an accent into a readable text colour
// for any ground, so every component of the kit (links, active tab labels,
// the sidebar's active item, toast icons) asks here and none of them
// invents its own darker green.
//
//     var m: theme.Theme = theme.theme_new(true)
//     kitcolor.kit_theme(&m, true)              // dark, accent #1bd96a
//     let g: u32 = kitcolor.accent_text(&m, base_colour)   // >= 4.5:1 on it
import fui.theme

export { LAUNCHER_ACCENT, kit_theme, kit_apply, accent_text, accent_ui, accent_with, tone, on_color,
    avatar_color, AVATAR_N, kit_contrast_ok, MIN_TEXT_CONTRAST, MIN_UI_CONTRAST }

// The launcher accent, 0xRRGGBB.
const LAUNCHER_ACCENT: u32 = 0x1BD96A

// WCAG 2 AA for normal text, and for the parts of a control that carry no
// text (WCAG 2.1 1.4.11: 3:1).
const MIN_TEXT_CONTRAST: f64 = 4.5
const MIN_UI_CONTRAST: f64 = 3.0

// Light or dark, with the launcher accent.
fn kit_theme(m: *mut theme.Theme, dark: bool) {
    theme.theme_set_dark(m, dark)
    theme.theme_set_accent(m, LAUNCHER_ACCENT)
}

// Put the launcher accent back if something replaced it. `theme_set_dark`
// (what a window host calls when the system switches light/dark) rebuilds the
// colour set and with it the default accent; a program that wants its own
// calls this at the start of every frame -- it costs one compare.
fn kit_apply(m: *mut theme.Theme) {
    let f: *mut theme.Colors = theme.theme_colors(m)
    if ((*f).accent & 16777215 as u32) != LAUNCHER_ACCENT {
        theme.theme_set_accent(m, LAUNCHER_ACCENT)
    }
}

// The accent as TEXT on the ground `bg` (0xRRGGBB): the accent itself when
// it reads (>= 4.5:1), else the accent pulled towards black (on a light
// ground) or white (on a dark one) in 5 % steps until it does.
fn accent_text(m: *mut theme.Theme, bg: u32) -> u32 {
    return accent_with(m, bg, MIN_TEXT_CONTRAST)
}

// The accent as a GRAPHIC (an underline, a progress fill, a focus bar) on
// `bg`: 3:1 is the rule for parts of a control (WCAG 2.1, 1.4.11).
fn accent_ui(m: *mut theme.Theme, bg: u32) -> u32 {
    return accent_with(m, bg, MIN_UI_CONTRAST)
}

fn accent_with(m: *mut theme.Theme, bg: u32, need: f64) -> u32 {
    let f: *mut theme.Colors = theme.theme_colors(m)
    return tone(m, (*f).accent, bg, need)
}

// Any colour as a foreground on `bg`: itself if it has `need`:1, else pulled
// towards black (light ground) or white (dark ground) in 5 % steps.
fn tone(m: *mut theme.Theme, colour: u32, bg: u32, need: f64) -> u32 {
    let a: u32 = colour & 16777215 as u32
    let g: u32 = bg & 16777215 as u32
    if theme.contrast(a, g) >= need {
        return a
    }
    var toward: u32 = 0 as u32
    if theme.luminance(g) < 0.5 {
        toward = 16777215 as u32
    }
    var t: usize = 50
    while t <= 1000 {
        let c: u32 = theme.mix(a, toward, t)
        if theme.contrast(c, g) >= need {
            return c
        }
        t = t + 50
    }
    return toward
}

// What to write ON a fill: the theme's `text` or its `base`, whichever has
// the larger contrast with the fill (the rule accent_derive uses for the
// accent, here for any colour -- an avatar, an error button).
fn on_color(m: *mut theme.Theme, fill: u32) -> u32 {
    let f: *mut theme.Colors = theme.theme_colors(m)
    let g: u32 = fill & 16777215 as u32
    if theme.contrast((*f).base, g) >= theme.contrast((*f).text, g) {
        return (*f).base
    }
    return (*f).text
}

// Eight soft, mid-light hues for avatars (the Tokyo Night pastels); every
// one has >= 4.5:1 against the dark `text` of both themes and against the
// dark theme's `base`. The same identity (a number) always gets the same hue.
const AVATAR_N: usize = 8

fn avatar_color(seed: u32) -> u32 {
    let k: usize = (seed as usize) % AVATAR_N
    if k == 0 { return 0x7AA2F7 as u32 }
    if k == 1 { return 0x9ECE6A as u32 }
    if k == 2 { return 0xE0AF68 as u32 }
    if k == 3 { return 0xF7768E as u32 }
    if k == 4 { return 0xBB9AF7 as u32 }
    if k == 5 { return 0x7DCFFF as u32 }
    if k == 6 { return 0x73DACA as u32 }
    return 0xFF9E64 as u32
}

// Does text of colour `fg` read on `bg`?
fn kit_contrast_ok(fg: u32, bg: u32) -> bool {
    return theme.contrast(fg & 16777215 as u32, bg & 16777215 as u32) >= MIN_TEXT_CONTRAST
}
