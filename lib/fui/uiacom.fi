// lib/fui/uiacom.fi -- the UIA COM glue on every target EXCEPT Windows: nothing to do. The real file is
// lib/fui/uiacom.windows.fi (the compiler takes it for --target=x86_64-windows); the names are the same, so a
// program calls `uiacom.enable_from_env(a, "title")` unconditionally. On Linux the screen reader bridge is
// lib/fui/atspi.fi.
import fui.app

export { attach, opened, enable_from_env, is_attached, entry_count, getobject_count }

fn attach(a: *mut app.App, hwnd: u64, title: str) -> bool { return false }

fn opened(ud: u64, win: u64) {}

fn enable_from_env(a: *mut app.App, title: str) -> bool { return false }

fn is_attached() -> bool { return false }

fn entry_count() -> usize { return 0 }

fn getobject_count() -> u64 { return 0 }
