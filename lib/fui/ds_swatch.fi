import std.rt
import fui.editor
import fui.kit
import fui.kitcolor
import fui.kitform
import fui.lucide
import fui.painter
import fui.render
import fui.screenax
import fui.style
import fui.widget
import fui.ds_fbtok
import fui.ds_fbtext

export {
    Swatch, NONE, swatch_new, set_palette, set_custom, accent_palette, accent_names, draw, press, key, text,
    selected, set_selected, rgb, set_rgb, count, columns, cell_rect, editing, foc, revision, field_rect,
}

const NONE: i64 = -1
const PAL_CAP: usize = 512
const NAMES_CAP: usize = 1024

struct Swatch {
    pal: [u8; 512],
    pal_n: usize,
    names: [u8; 1024],
    names_n: usize,
    n: usize,
    cols: usize,
    sel: i64,
    foc: i64,
    kbd: bool,
    custom_on: bool,
    custom_rgb: u32,
    has_custom: bool,
    editing: bool,
    fld: *mut kit.Search,
    ctx: u64,
    x: f64,
    y: f64,
    cell: f64,
    gap: f64,
    fr: [f64; 4],
    px: f64,
    py: f64,
    rev: u64,
    now: u64,
}

fn accent_palette() -> str {
    return "ffb900|ff8c00|f7630c|ca5010|da3b01|ef6950|d13438|ff4343|e74856|e81123|ea005e|c30052|e3008c|bf0077|c239b3|9a0089|0078d4|0063b1|8e8cd8|6b69d6|8764b8|744da9|b146c2|881798|0099bc|2d7d9a|00b7c3|038387|00b294|018574|00cc6a|10893e"
}

fn accent_names() -> str {
    return "Yellow gold|Gold|Bright orange|Dark orange|Rust|Pale rust|Brick red|Mod red|Pale red|Red|Bright rose|Rose|Light plum|Plum|Light orchid|Orchid|Blue|Navy blue|Purple shadow|Dark purple shadow|Pastel iris|Spring iris|Light violet red|Violet red|Bright cool blue|Cool blue|Seafoam|Seafoam teal|Light mint|Dark mint|Turf green|Sport green"
}

fn copy_into(dst: *mut u8, cap: usize, s: str) -> usize {
    var n: usize = s.n
    if n > cap { n = cap }
    var i: usize = 0
    while i < n {
        rt.st8(dst as u64, i, rt.ld8(s.p as u64, i))
        i = i + 1
    }
    return n
}

fn swatch_new() -> *mut Swatch {
    let s: *mut Swatch = rt.heap_alloc(1 << 12) as *mut Swatch
    (*s).pal_n = 0
    (*s).names_n = 0
    (*s).n = 0
    (*s).cols = 1
    (*s).sel = NONE
    (*s).foc = NONE
    (*s).kbd = false
    (*s).custom_on = false
    (*s).custom_rgb = 0 as u32
    (*s).has_custom = false
    (*s).editing = false
    (*s).fld = kitform.field_new()
    (*s).ctx = 0
    (*s).x = 0.0
    (*s).y = 0.0
    (*s).cell = 32.0
    (*s).gap = 6.0
    var i: usize = 0
    while i < 4 { (*s).fr[i] = 0.0; i = i + 1 }
    (*s).px = 0.0 - 1.0
    (*s).py = 0.0 - 1.0
    (*s).rev = 0
    (*s).now = 0
    set_palette(s, accent_palette(), accent_names())
    return s
}

fn pal_str(s: *mut Swatch) -> str { return str { p: ((&(*s).pal[0]) as u64) as *mut u8, n: (*s).pal_n } }
fn names_str(s: *mut Swatch) -> str { return str { p: ((&(*s).names[0]) as u64) as *mut u8, n: (*s).names_n } }

fn set_palette(s: *mut Swatch, pal: str, names: str) {
    (*s).pal_n = copy_into((&(*s).pal[0]) as *mut u8, PAL_CAP, pal)
    (*s).names_n = copy_into((&(*s).names[0]) as *mut u8, NAMES_CAP, names)
    (*s).n = 0
    if (*s).pal_n > 0 { (*s).n = kitform.parts(pal_str(s)) }
    (*s).sel = NONE
    (*s).foc = NONE
}

fn set_custom(s: *mut Swatch, on: bool) {
    (*s).custom_on = on
    if !on { (*s).editing = false }
}

fn count(s: *mut Swatch) -> usize {
    if (*s).custom_on { return (*s).n + 1 }
    return (*s).n
}

fn columns(s: *mut Swatch) -> usize { return (*s).cols }
fn selected(s: *mut Swatch) -> i64 { return (*s).sel }
fn foc(s: *mut Swatch) -> i64 { return (*s).foc }
fn editing(s: *mut Swatch) -> bool { return (*s).editing }
fn revision(s: *mut Swatch) -> u64 { return (*s).rev }

fn field_rect(s: *mut Swatch, out: *mut [f64; 4]) {
    var i: usize = 0
    while i < 4 { (*out)[i] = (*s).fr[i]; i = i + 1 }
}

fn index_rgb(s: *mut Swatch, i: usize) -> u32 {
    if i == (*s).n { return (*s).custom_rgb }
    let v: i64 = kitcolor.parse_hex(kitform.nth(pal_str(s), i))
    if v < 0 { return 0 as u32 }
    return v as u32
}

fn rgb(s: *mut Swatch) -> u32 {
    if (*s).sel < 0 { return 0 as u32 }
    return index_rgb(s, (*s).sel as usize)
}

fn put_sel(s: *mut Swatch, i: i64) {
    if (*s).sel != i {
        (*s).sel = i
        (*s).rev = (*s).rev + 1
    }
}

fn set_selected(s: *mut Swatch, i: i64) {
    if i < 0 || i as usize >= count(s) { put_sel(s, NONE); return }
    if i as usize == (*s).n && !(*s).has_custom { return }
    put_sel(s, i)
}

fn set_rgb(s: *mut Swatch, v: u32) {
    var i: usize = 0
    while i < (*s).n {
        if index_rgb(s, i) == (v & 16777215 as u32) { put_sel(s, i as i64); return }
        i = i + 1
    }
    if (*s).custom_on {
        (*s).custom_rgb = v & 16777215 as u32
        (*s).has_custom = true
        put_sel(s, (*s).n as i64)
        return
    }
    put_sel(s, NONE)
}

fn cell_rect(s: *mut Swatch, i: usize, out: *mut [f64; 4]) {
    let cols: usize = (*s).cols
    let col: usize = i % cols
    let row: usize = i / cols
    (*out)[0] = (*s).x + ((*s).cell + (*s).gap) * (col as f64)
    (*out)[1] = (*s).y + ((*s).cell + (*s).gap) * (row as f64)
    (*out)[2] = (*s).cell
    (*out)[3] = (*s).cell
}

fn name_of(s: *mut Swatch, i: usize, buf: *mut [u8; 256]) -> str {
    if i == (*s).n { return "Custom colour" }
    let nm: str = kitform.nth(names_str(s), i)
    if (*s).names_n > 0 && nm.n > 0 { return nm }
    let v: u32 = index_rgb(s, i)
    var h: [u8; 8] = [0 as u8; 8]
    kitcolor.hex_digits(v, &h)
    (*buf)[0] = 35 as u8
    var k: usize = 0
    while k < 6 { (*buf)[1 + k] = h[k]; k = k + 1 }
    return str { p: ((&(*buf)[0]) as u64) as *mut u8, n: 7 }
}

fn opaque(rgbv: u32) -> u32 { return 0xFF000000 as u32 | (rgbv & 16777215 as u32) }

#[allow_escape]
fn draw(s: *mut Swatch, c: *mut render.Ctx, x: f64, y: f64, w: f64, label: str, px: f64, py: f64) -> f64 {
    let z: *mut painter.Painter = render.ctx_painter(c)
    (*s).ctx = c as u64
    (*s).x = x
    (*s).y = y
    (*s).px = px
    (*s).py = py
    (*s).cell = kit.ln(c, 32)
    (*s).gap = kit.ln(c, 6)
    var cols: usize = ((w + (*s).gap) / ((*s).cell + (*s).gap)) as usize
    if cols < 1 { cols = 1 }
    (*s).cols = cols
    let total: usize = count(s)
    var i: usize = 0
    var rect: [f64; 4] = [0.0; 4]
    var nm_buf: [u8; 256] = [0 as u8; 256]
    let rad: f64 = kit.ln(c, 6)
    while i < total {
        cell_rect(s, i, &rect)
        let on: bool = (*s).sel == i as i64
        let fill: u32 = opaque(index_rgb(s, i))
        let plain_custom: bool = i == (*s).n && !(*s).has_custom
        if plain_custom {
            painter.round_rect(z, rect[0], rect[1], rect[2], rect[3], rad, ds_fbtok.surface(c))
            kit.sym(c, lucide.PLUS, rect[0] + (rect[2] - kit.ln(c, 16)) / 2.0, rect[1] + (rect[3] - kit.ln(c, 16)) / 2.0, kit.ln(c, 16), ds_fbtok.muted(c))
        } else {
            painter.round_rect(z, rect[0], rect[1], rect[2], rect[3], rad, fill)
        }
        painter.round_ring(z, rect[0], rect[1], rect[2], rect[3], rad, kit.ln(c, 1), kit.with_alpha(ds_fbtok.border(c), 200 as u32))
        if ds_fbtext.inside(&rect, px, py) && !on {
            painter.round_ring(z, rect[0] - kit.ln(c, 2), rect[1] - kit.ln(c, 2), rect[2] + kit.ln(c, 4), rect[3] + kit.ln(c, 4), rad + kit.ln(c, 2), kit.ln(c, 1), ds_fbtok.muted(c))
        }
        if on {
            painter.round_ring(z, rect[0] - kit.ln(c, 3), rect[1] - kit.ln(c, 3), rect[2] + kit.ln(c, 6), rect[3] + kit.ln(c, 6), rad + kit.ln(c, 3), kit.ln(c, 2), ds_fbtok.text(c))
            if !plain_custom {
                let ink: u32 = theme_on(c, fill)
                kit.sym(c, lucide.CHECK, rect[0] + (rect[2] - kit.ln(c, 16)) / 2.0, rect[1] + (rect[3] - kit.ln(c, 16)) / 2.0, kit.ln(c, 16), ink)
            }
        }
        var st: u32 = 0 as u32
        if on { st = screenax.F_CHECKED }
        if (*s).kbd && (*s).foc == i as i64 {
            st = st | screenax.F_FOCUS
            kit.focus_ring(c, rect[0], rect[1], rect[2], rect[3], rad, style.TOK_SURFACE)
        }
        screenax.note_join(widget.KIND_RADIO, st, label, name_of(s, i, &nm_buf), rect[0], rect[1], rect[2], rect[3], 0)
        i = i + 1
    }
    var rows: usize = (total + cols - 1) / cols
    if rows < 1 { rows = 1 }
    var h: f64 = ((*s).cell + (*s).gap) * (rows as f64) - (*s).gap
    (*s).fr[0] = 0.0
    (*s).fr[1] = 0.0
    (*s).fr[2] = 0.0
    (*s).fr[3] = 0.0
    if (*s).editing && (*s).custom_on {
        let fy: f64 = y + h + kit.ln(c, 10)
        var fw: f64 = kit.ln(c, 160)
        if fw > w { fw = w }
        let fh: f64 = kit.ln(c, 38)
        (*s).fr[0] = x
        (*s).fr[1] = fy
        (*s).fr[2] = fw
        (*s).fr[3] = fh
        let txt: str = kitform.field_text((*s).fld)
        let bad: bool = txt.n > 0 && kitcolor.parse_hex(txt) < 0
        kitform.field_box(c, (*s).fld, x, fy, fw, fh, "#RRGGBB", bad, true)
        kit.search_ax_note((*s).fld, "Custom colour hex value", x, fy, fw, fh)
        let v: i64 = kitcolor.parse_hex(txt)
        if v >= 0 {
            painter.round_rect(z, x + fw + kit.ln(c, 10), fy + (fh - kit.ln(c, 28)) / 2.0, kit.ln(c, 28), kit.ln(c, 28), rad, opaque(v as u32))
        }
        h = h + kit.ln(c, 10) + fh
    }
    return h
}

fn theme_on(c: *mut render.Ctx, fill: u32) -> u32 {
    return theme_opaque(kitcolor.on_color(kit.theme_of(c), fill))
}

fn theme_opaque(col: u32) -> u32 { return 0xFF000000 as u32 | (col & 16777215 as u32) }

fn cell_at(s: *mut Swatch, x: f64, y: f64) -> i64 {
    var rect: [f64; 4] = [0.0; 4]
    var i: usize = 0
    let total: usize = count(s)
    while i < total {
        cell_rect(s, i, &rect)
        if ds_fbtext.inside(&rect, x, y) { return i as i64 }
        i = i + 1
    }
    return NONE
}

#[allow_escape]
fn open_editor(s: *mut Swatch) {
    (*s).editing = true
    kit.search_focus((*s).fld, true)
    if (*s).has_custom {
        var h: [u8; 8] = [0 as u8; 8]
        kitcolor.hex_digits((*s).custom_rgb, &h)
        var t: [u8; 8] = [0 as u8; 8]
        t[0] = 35 as u8
        var k: usize = 0
        while k < 6 { t[1 + k] = h[k]; k = k + 1 }
        kit.search_set_text((*s).fld, str { p: ((&t[0]) as u64) as *mut u8, n: 7 })
    }
}

fn close_editor(s: *mut Swatch) {
    (*s).editing = false
    kit.search_focus((*s).fld, false)
}

fn apply_custom(s: *mut Swatch) -> bool {
    let v: i64 = kitcolor.parse_hex(kitform.field_text((*s).fld))
    if v < 0 { return false }
    (*s).custom_rgb = v as u32
    (*s).has_custom = true
    put_sel(s, (*s).n as i64)
    close_editor(s)
    return true
}

#[allow_escape]
fn press(s: *mut Swatch, x: f64, y: f64) -> i64 {
    let c: *mut render.Ctx = (*s).ctx as *mut render.Ctx
    (*s).now = (*s).now + 1000000
    if (*s).editing && ds_fbtext.inside(&(*s).fr, x, y) {
        (*s).kbd = false
        (*s).foc = NONE
        kitform.field_box_press(c, (*s).fld, (*s).fr[0], (*s).fr[1], (*s).fr[2], (*s).fr[3], x, y, (*s).now)
        return (*s).n as i64 + 1
    }
    kit.search_focus((*s).fld, false)
    let i: i64 = cell_at(s, x, y)
    (*s).kbd = false
    (*s).foc = NONE
    if i < 0 { return NONE }
    (*s).foc = i
    if i as usize == (*s).n {
        if (*s).has_custom { put_sel(s, i) }
        open_editor(s)
        return i
    }
    close_editor(s)
    put_sel(s, i)
    return i
}

fn focus_cell(s: *mut Swatch, i: i64) {
    var t: i64 = i
    let total: i64 = count(s) as i64
    if t < 0 { t = 0 }
    if t >= total { t = total - 1 }
    (*s).foc = t
    (*s).kbd = true
    if (t as usize) < (*s).n || (*s).has_custom { put_sel(s, t) }
}

fn activate(s: *mut Swatch) -> bool {
    if (*s).foc < 0 { return false }
    if (*s).foc as usize == (*s).n && (*s).custom_on {
        if (*s).has_custom { put_sel(s, (*s).foc) }
        open_editor(s)
        (*s).kbd = false
        return true
    }
    put_sel(s, (*s).foc)
    return true
}

fn key(s: *mut Swatch, k: u32, mods: u32) -> bool {
    if (*s).editing && kit.search_has_focus((*s).fld) {
        if k == editor.KEY_ENTER {
            if apply_custom(s) { (*s).kbd = true }
            return true
        }
        if k == editor.KEY_ESC {
            close_editor(s)
            (*s).foc = (*s).n as i64
            (*s).kbd = true
            return true
        }
        if k == editor.KEY_TAB {
            close_editor(s)
            (*s).foc = NONE
            (*s).kbd = false
            return false
        }
        return kit.search_key((*s).fld, k, mods) != editor.RES_PASS
    }
    let total: i64 = count(s) as i64
    if total == 0 { return false }
    if k == editor.KEY_TAB {
        if (*s).foc < 0 {
            var at: i64 = (*s).sel
            if at < 0 { at = 0 }
            (*s).foc = at
            (*s).kbd = true
            return true
        }
        (*s).foc = NONE
        (*s).kbd = false
        return false
    }
    if (*s).foc < 0 { return false }
    var step: i64 = 0
    var fwd: i64 = 1
    if kit.kit_rtl() { fwd = 0 - 1 }
    if k == editor.KEY_RIGHT { step = fwd }
    if k == editor.KEY_LEFT { step = 0 - fwd }
    if k == editor.KEY_DOWN { step = (*s).cols as i64 }
    if k == editor.KEY_UP { step = 0 - ((*s).cols as i64) }
    if step != 0 {
        var t: i64 = (*s).foc + step
        if t < 0 || t >= total { t = (*s).foc }
        focus_cell(s, t)
        return true
    }
    if k == editor.KEY_HOME { focus_cell(s, 0); return true }
    if k == editor.KEY_END { focus_cell(s, total - 1); return true }
    if k == editor.KEY_ENTER { return activate(s) }
    return false
}

fn text(s: *mut Swatch, cp: u32, mods: u32) -> bool {
    if (*s).editing && kit.search_has_focus((*s).fld) {
        kit.search_char((*s).fld, cp, mods)
        return true
    }
    if cp == 32 as u32 && (*s).foc >= 0 { return activate(s) }
    return false
}
