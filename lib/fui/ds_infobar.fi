// SPDX-License-Identifier: MPL-2.0
import std.rt
import fui.editor
import fui.kit
import fui.lucide
import fui.painter
import fui.render
import fui.screenax
import fui.style
import fui.widget
import fui.ds_fbtok
import fui.ds_fbtext

export {
    Bar, EV_NONE, EV_ACTION, EV_CLOSE, EV_FOCUS, FOCUS_NONE, FOCUS_ACTION, FOCUS_CLOSE, bar_new, is_open, set_open, draw, press, key, text,
    focused, set_focus, action_count, close_count, action_rect, close_rect, bar_rect,
}

const EV_NONE: u32 = 0
const EV_ACTION: u32 = 1
const EV_CLOSE: u32 = 2
const EV_FOCUS: u32 = 3
const FOCUS_NONE: u32 = 0
const FOCUS_ACTION: u32 = 1
const FOCUS_CLOSE: u32 = 2

struct Bar {
    open: bool,
    has_action: bool,
    has_close: bool,
    foc: u32,
    kbd: bool,
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    act: [f64; 4],
    cls: [f64; 4],
    px: f64,
    py: f64,
    fired: u64,
    closed: u64,
}

fn bar_new() -> *mut Bar {
    let b: *mut Bar = rt.heap_alloc(512) as *mut Bar
    (*b).open = true
    (*b).has_action = false
    (*b).has_close = false
    (*b).foc = FOCUS_NONE
    (*b).kbd = false
    (*b).x = 0.0
    (*b).y = 0.0
    (*b).w = 0.0
    (*b).h = 0.0
    var i: usize = 0
    while i < 4 {
        (*b).act[i] = 0.0
        (*b).cls[i] = 0.0
        i = i + 1
    }
    (*b).px = 0.0 - 1.0
    (*b).py = 0.0 - 1.0
    (*b).fired = 0
    (*b).closed = 0
    return b
}

fn is_open(b: *mut Bar) -> bool { return (*b).open }
fn focused(b: *mut Bar) -> u32 { return (*b).foc }
fn action_count(b: *mut Bar) -> u64 { return (*b).fired }
fn close_count(b: *mut Bar) -> u64 { return (*b).closed }

fn set_open(b: *mut Bar, on: bool) {
    (*b).open = on
    if !on {
        (*b).foc = FOCUS_NONE
        (*b).kbd = false
    }
}

fn set_focus(b: *mut Bar, which: u32) {
    (*b).foc = which
    (*b).kbd = which != FOCUS_NONE
}

fn action_rect(b: *mut Bar, out: *mut [f64; 4]) {
    var i: usize = 0
    while i < 4 { (*out)[i] = (*b).act[i]; i = i + 1 }
}

fn close_rect(b: *mut Bar, out: *mut [f64; 4]) {
    var i: usize = 0
    while i < 4 { (*out)[i] = (*b).cls[i]; i = i + 1 }
}

fn bar_rect(b: *mut Bar, out: *mut [f64; 4]) {
    (*out)[0] = (*b).x
    (*out)[1] = (*b).y
    (*out)[2] = (*b).w
    (*out)[3] = (*b).h
}

fn clear_parts(b: *mut Bar) {
    (*b).has_action = false
    (*b).has_close = false
    var i: usize = 0
    while i < 4 { (*b).act[i] = 0.0; (*b).cls[i] = 0.0; i = i + 1 }
}

#[allow_escape]
fn draw(b: *mut Bar, c: *mut render.Ctx, x: f64, y: f64, w: f64, kind: u32, title: str, msg: str, action: str, closable: bool, px: f64, py: f64) -> f64 {
    (*b).x = x
    (*b).y = y
    (*b).w = w
    (*b).px = px
    (*b).py = py
    clear_parts(b)
    if !(*b).open {
        (*b).h = 0.0
        return 0.0
    }
    let z: *mut painter.Painter = render.ctx_painter(c)
    let pad: f64 = ds_fbtok.gap(c)
    let isz: f64 = kit.ln(c, 18)
    let line: f64 = ds_fbtok.line_h(c)
    let rad: f64 = ds_fbtok.radius(c)
    let bh: f64 = kit.button_height(c)
    let cs: f64 = kit.ln(c, 28)
    var bw: f64 = 0.0
    var right: f64 = pad
    if closable { right = right + cs + kit.ln(c, 4) }
    if action.n > 0 {
        bw = kit.button_width(c, action, kit.ICON_NONE)
        right = right + bw + kit.ln(c, 8)
    }
    let tx: f64 = x + pad + isz + ds_fbtok.gap(c)
    let tw: f64 = w - (tx - x) - right
    let tsz: f64 = kit.ln(c, 14)
    let title_w: f64 = kit.text_width(c, tsz, 700, title)
    let msg_w: f64 = kit.text_width(c, tsz, 400, msg)
    var one_line: bool = title.n == 0 || msg.n == 0
    if title.n > 0 && msg.n > 0 && title_w + kit.ln(c, 8) + msg_w <= tw { one_line = true }
    var n_lines: usize = 1
    var title_lines: usize = 0
    if !one_line {
        if title.n > 0 { title_lines = 1 }
        n_lines = title_lines + ds_fbtext.lines(c, msg, tw, 14, 400, 4)
    }
    if title.n == 0 && msg.n > 0 && one_line {
        n_lines = ds_fbtext.lines(c, msg, tw, 14, 400, 4)
        if n_lines < 1 { n_lines = 1 }
    }
    var h: f64 = pad * 2.0 + line * (n_lines as f64)
    if h < kit.ln(c, 44) { h = kit.ln(c, 44) }
    (*b).h = h
    let ty: f64 = y + (h - line * (n_lines as f64)) / 2.0
    painter.round_rect(z, x, y, w, h, rad, ds_fbtok.surface(c))
    painter.round_rect(z, x, y, w, h, rad, ds_fbtok.tint(c, kind))
    painter.round_ring(z, x, y, w, h, rad, kit.ln(c, 1), kit.with_alpha(ds_fbtok.tone(c, kind), 110 as u32))
    kit.sym(c, ds_fbtok.icon(kind), kit.rx(x + pad, isz, x, w), ty + (line - isz) / 2.0, isz, ds_fbtok.tone(c, kind))
    if title.n > 0 { kit.label_in(c, tx, ty, line, tsz, 700, ds_fbtok.text(c), title, tw) }
    if msg.n > 0 {
        if one_line && title.n > 0 {
            kit.label_in(c, tx + title_w + kit.ln(c, 8), ty, line, tsz, 400, ds_fbtok.muted(c), msg, tw - title_w - kit.ln(c, 8))
        } else {
            ds_fbtext.draw(c, tx, ty + (title_lines as f64) * line, tw, msg, 14, 400, ds_fbtok.muted(c), 4)
        }
    }
    var r: f64 = x + w - pad
    if closable {
        (*b).has_close = true
        (*b).cls[0] = r - cs
        (*b).cls[1] = y + (h - cs) / 2.0
        (*b).cls[2] = cs
        (*b).cls[3] = cs
        r = r - cs - kit.ln(c, 4)
    }
    if action.n > 0 {
        (*b).has_action = true
        (*b).act[0] = r - bw
        (*b).act[1] = y + (h - bh) / 2.0
        (*b).act[2] = bw
        (*b).act[3] = bh
    }
    var buf: [u8; 256] = [0 as u8; 256]
    let nm: usize = ds_fbtext.join2(&buf, title, ". ", msg)
    screenax.note_join(widget.KIND_LABEL, 0 as u32, ds_fbtok.kind_name(kind), str { p: ((&buf[0]) as u64) as *mut u8, n: nm }, x, y, w, h, 0)
    if (*b).has_action {
        var st: u32 = 0 as u32
        if ds_fbtext.inside(&(*b).act, px, py) { st = st | kit.ST_HOVER }
        if (*b).kbd && (*b).foc == FOCUS_ACTION { st = st | kit.ST_FOCUS }
        kit.button_draw(c, (*b).act[0], (*b).act[1], bw, bh, action, kit.ICON_NONE, kit.BTN_SECONDARY, st)
    }
    if (*b).has_close {
        let cx: f64 = (*b).cls[0]
        let cy: f64 = (*b).cls[1]
        if ds_fbtext.inside(&(*b).cls, px, py) { painter.round_rect(z, cx, cy, cs, cs, kit.ln(c, 6), ds_fbtok.hover_fill(c)) }
        let xs: f64 = kit.ln(c, 14)
        kit.sym(c, lucide.X, cx + (cs - xs) / 2.0, cy + (cs - xs) / 2.0, xs, ds_fbtok.muted(c))
        var fl: u32 = 0 as u32
        if (*b).kbd && (*b).foc == FOCUS_CLOSE {
            fl = screenax.F_FOCUS
            kit.focus_ring(c, cx, cy, cs, cs, kit.ln(c, 6), style.TOK_SURFACE_RAISED)
        }
        screenax.note(widget.KIND_BUTTON, fl, "Close", cx, cy, cs, cs, 0)
    }
    return h
}

fn activate(b: *mut Bar) -> u32 {
    if (*b).foc == FOCUS_ACTION && (*b).has_action {
        (*b).fired = (*b).fired + 1
        return EV_ACTION
    }
    if (*b).foc == FOCUS_CLOSE && (*b).has_close {
        (*b).closed = (*b).closed + 1
        set_open(b, false)
        return EV_CLOSE
    }
    return EV_NONE
}

fn press(b: *mut Bar, x: f64, y: f64) -> u32 {
    if !(*b).open { return EV_NONE }
    (*b).foc = FOCUS_NONE
    (*b).kbd = false
    if (*b).has_action && ds_fbtext.inside(&(*b).act, x, y) {
        (*b).fired = (*b).fired + 1
        return EV_ACTION
    }
    if (*b).has_close && ds_fbtext.inside(&(*b).cls, x, y) {
        (*b).closed = (*b).closed + 1
        set_open(b, false)
        return EV_CLOSE
    }
    return EV_NONE
}

fn step(b: *mut Bar, back: bool) -> bool {
    let cur: u32 = (*b).foc
    var nxt: u32 = FOCUS_NONE
    if !back {
        if cur == FOCUS_NONE {
            if (*b).has_action { nxt = FOCUS_ACTION } else if (*b).has_close { nxt = FOCUS_CLOSE }
        } else if cur == FOCUS_ACTION && (*b).has_close { nxt = FOCUS_CLOSE }
    } else {
        if cur == FOCUS_NONE {
            if (*b).has_close { nxt = FOCUS_CLOSE } else if (*b).has_action { nxt = FOCUS_ACTION }
        } else if cur == FOCUS_CLOSE && (*b).has_action { nxt = FOCUS_ACTION }
    }
    (*b).foc = nxt
    (*b).kbd = nxt != FOCUS_NONE
    return nxt != FOCUS_NONE
}

fn key(b: *mut Bar, k: u32, mods: u32) -> u32 {
    if !(*b).open || !((*b).has_action || (*b).has_close) { return EV_NONE }
    if k == editor.KEY_TAB {
        if step(b, (mods & editor.MOD_SHIFT) != 0 as u32) { return EV_FOCUS }
        return EV_NONE
    }
    if (*b).foc == FOCUS_NONE { return EV_NONE }
    if k == editor.KEY_RIGHT { step(b, false); return EV_FOCUS }
    if k == editor.KEY_LEFT { step(b, true); return EV_FOCUS }
    if k == editor.KEY_ENTER { return activate(b) }
    if k == editor.KEY_ESC && (*b).has_close {
        (*b).foc = FOCUS_CLOSE
        return activate(b)
    }
    return EV_NONE
}

fn text(b: *mut Bar, cp: u32, mods: u32) -> u32 {
    if cp == 32 as u32 && (*b).open && (*b).foc != FOCUS_NONE { return activate(b) }
    return EV_NONE
}
