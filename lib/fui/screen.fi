// SPDX-License-Identifier: MPL-2.0
// lib/fui/screen.fi -- AN IMMEDIATE-MODE SCREEN IN ONE CALL.
//
// `screen.run(start, title, w, h, ud, paint, press, key)` runs a screen the app paints from its
// own state: a window, or -- with `--shot out.png` -- ONE headless frame written as a PNG
// (no display needed). `--theme light|dark` picks the theme (default dark).
//
//   fn paint(ud: u64, c: *mut render.Ctx, w: f64, h: f64, px: f64, py: f64)   // px, py = the pointer
//   fn press(ud: u64, x: f64, y: f64)                                          // a click
//   fn key(ud: u64, key: u32, mods: u32) -> bool                                // editor.KEY_*
//
// Used by examples/fui_apps/*. Every event repaints the whole frame.
import std.rt
import std.time
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.style
import fui.painter
import fui.render
import fui.scene
import fui.anim
import fui.screenanim
import fui.kitcolor
import fui.face
import fui.safeout
import fui.sizearg
import fui.editor
import fui.kit
import fui.a11y
import fui.screenax
import fui.screenaxtree
import fui.screenbridge
import fui.screenext
import fui.screenpan
import plat.backkey
import fui.apphost
import plat.fuiwirt
import plat.sysfont

struct Screen {
    m: theme.Theme,
    c: render.Ctx,
    sc: scene.Scene,
    w: fuiwirt.Host,
    hk: apphost.Hooks,
    tr: anim.TransReg,
    ud: u64,
    paint: fn(u64, *mut render.Ctx, f64, f64, f64, f64),
    press: fn(u64, f64, f64),
    key: fn(u64, u32, u32) -> bool,
    text: fn(u64, u32, u32) -> bool,
    wheel: fn(u64, f64, f64, f64, f64) -> bool,
    pointer: fn(u64, u32, f64, f64) -> bool,
    dark: bool,
    skin: fn(*mut theme.Theme, bool),
    themed: bool,
    tree: u64,
    px: f64,
    py: f64,
    ex: screenext.Extras,
    pn: screenpan.Pan,
    back_held: bool,
}

fn screen_blank() -> Screen {
    return Screen {
        m: theme.theme_new(true),
        c: render.ctx_new(0 as u64 as *mut theme.Theme, 0 as u64 as *mut painter.Painter),
        sc: scene.scene_new(),
        w: fuiwirt.host_new(0 as u64 as *mut scene.Scene, 0 as u64 as *mut render.Ctx),
        hk: apphost.hooks_blank(),
        tr: anim.transreg_new(),
        ud: 0, paint: no_paint, press: no_press, key: no_key, text: no_key, wheel: no_wheel, pointer: no_pointer, dark: true, skin: no_skin, themed: false, tree: 0, px: 0.0 - 1.0, py: 0.0 - 1.0,
        ex: screenext.extras_blank(), pn: screenpan.pan_new(), back_held: false,
    }
}

fn no_skin(m: *mut theme.Theme, dark: bool) {}
fn no_paint(ud: u64, c: *mut render.Ctx, w: f64, h: f64, px: f64, py: f64) {}
fn no_press(ud: u64, x: f64, y: f64) {}
fn no_key(ud: u64, key: u32, mods: u32) -> bool { return false }
fn no_pointer(ud: u64, kind: u32, x: f64, y: f64) -> bool { return false }
fn no_wheel(ud: u64, px: f64, py: f64, dx: f64, dy: f64) -> bool { return false }

struct PumpHooks {
    ud: u64,
    fd: fn(u64) -> i32,
    ms: fn(u64, i64) -> i64,
    step: fn(u64) -> bool,
}

static mut PUMP: u64 = 0

fn set_pump(ud: u64, fd: fn(u64) -> i32, ms: fn(u64, i64) -> i64, step: fn(u64) -> bool) {
    let p: *mut PumpHooks = rt.heap_alloc(64) as *mut PumpHooks
    *p = PumpHooks { ud: ud, fd: fd, ms: ms, step: step }
    PUMP = p as u64
}

fn size_of_screen() -> usize {
    var probe: [Screen; 2] = [screen_blank(), screen_blank()]
    return ((&probe[1]) as usize) - ((&probe[0]) as usize)
}

fn on_attach(ud: u64, z: *mut painter.Painter) {
    let s: *mut Screen = ud as *mut Screen
    face.install(z)
    (*s).c = render.ctx_new(&(*s).m, z)
    anim.transreg_bind(&(*s).tr, &(*s).c)
}

fn follow_host_theme(s: *mut Screen) {
    if (*s).themed { return }
    (*s).themed = true
    let dark: bool = theme.theme_is_dark(&(*s).m)
    if dark == (*s).dark { return }
    (*s).dark = dark
    kitcolor.kit_theme(&(*s).m, dark)
    ((*s).skin)(&(*s).m, dark)
}

fn on_paint(ud: u64, w: usize, h: usize) {
    let s: *mut Screen = ud as *mut Screen
    follow_host_theme(s)
    kitcolor.kit_apply(&(*s).m)
    let c: *mut render.Ctx = &(*s).c
    painter.painter_clear(render.ctx_painter(c), theme.opaque((*theme.theme_colors(&(*s).m)).base))
    anim.transreg_new_frame(&(*s).tr)
    screenax.begin()
    screenanim.begin_frame()
    ((*s).paint)((*s).ud, c, w as f64, h as f64, (*s).px, (*s).py)
    focus_ring(c)
    if (*s).tree != 0 && screenax.changed() { screenaxtree.publish((*s).tree as *mut screenaxtree.Tree) }
    sync_back(s)
}

fn sync_back(s: *mut Screen) {
    if !(*s).ex.back_on { return }
    (*s).back_held = ((*s).ex.back_wanted)((*s).ud)
    backkey.back_hold((*s).back_held)
}

fn focus_ring(c: *mut render.Ctx) {
    var q: [f64; 4] = [0.0; 4]
    if !screenax.focus_rect(&q) { return }
    kit.focus_ring(c, q[0] - kit.ln(c, 3), q[1] - kit.ln(c, 3), q[2] + kit.ln(c, 6), q[3] + kit.ln(c, 6), kit.ln(c, 10), style.TOK_BASE)
}

fn press_now(s: *mut Screen, x: f64, y: f64) {
    screenax.focus_clear()
    ((*s).press)((*s).ud, x, y)
}

fn on_press(ud: u64, x: f64, y: f64) {
    let s: *mut Screen = ud as *mut Screen
    fuiwirt.host_touch(&(*s).w)
    if (*s).ex.pan_on {
        screenpan.pan_down(&(*s).pn, x, y)
        return
    }
    press_now(s, x, y)
}

fn ax_click(ud: u64, x: f64, y: f64) -> bool {
    let s: *mut Screen = ud as *mut Screen
    fuiwirt.host_touch(&(*s).w)
    press_now(s, x, y)
    ((*s).pointer)((*s).ud, fuiwirt.HOOK_UP, x, y)
    return true
}

fn ax_act(ud: u64, i: usize) -> bool {
    var q: [f64; 4] = [0.0; 4]
    screenax.rect_of(i, &q)
    return ax_click(ud, q[0] + q[2] / 2.0, q[1] + q[3] / 2.0)
}

fn ax_setnum(ud: u64, i: usize, v: i64) -> bool {
    let s: *mut Screen = ud as *mut Screen
    if !screenax.apply_num(i, v) { return false }
    fuiwirt.host_touch(&(*s).w)
    return true
}

#[allow_escape]
fn ax_settext(ud: u64, i: usize, t: str) -> bool {
    let s: *mut Screen = ud as *mut Screen
    if !screenax.apply_text(i, t) { return false }
    fuiwirt.host_touch(&(*s).w)
    return true
}

fn ax_setcaret(ud: u64, i: usize, anchor: usize, caret: usize) -> bool {
    let s: *mut Screen = ud as *mut Screen
    if !screenax.apply_caret(i, anchor, caret) { return false }
    fuiwirt.host_touch(&(*s).w)
    return true
}

fn ax_focus(ud: u64, i: usize) -> bool {
    let s: *mut Screen = ud as *mut Screen
    screenax.set_focus_index(i)
    fuiwirt.host_touch(&(*s).w)
    return true
}

fn on_hook(ud: u64, kind: u32, x: f64, y: f64) -> bool {
    let s: *mut Screen = ud as *mut Screen
    if kind == fuiwirt.HOOK_LEAVE {
        (*s).px = 0.0 - 1.0
        (*s).py = 0.0 - 1.0
        screenpan.pan_cancel(&(*s).pn)
    } else if kind != fuiwirt.HOOK_WHEEL {
        (*s).px = x
        (*s).py = y
        if (*s).ex.pan_on && (kind == fuiwirt.HOOK_MOVE || kind == fuiwirt.HOOK_UP) { return pan_hook(s, kind, x, y) }
        if kind == fuiwirt.HOOK_MOVE || kind == fuiwirt.HOOK_UP { ((*s).pointer)((*s).ud, kind, x, y) }
    } else {
        fuiwirt.host_touch(&(*s).w)
        return ((*s).wheel)((*s).ud, (*s).px, (*s).py, x, y)
    }
    return true
}

fn on_ptr(ud: u64, kind: u32, id: u32, ptype: u32, x: f64, y: f64, pressure: f64) -> bool {
    let s: *mut Screen = ud as *mut Screen
    return ((*s).ex.ptr)((*s).ud, kind, id, ptype, x, y, pressure)
}

fn pan_hook(s: *mut Screen, kind: u32, x: f64, y: f64) -> bool {
    let p: *mut screenpan.Pan = &(*s).pn
    if kind == fuiwirt.HOOK_MOVE {
        let d: f64 = screenpan.pan_move(p, x, y)
        if screenpan.pan_active(p) {
            if d != 0.0 { ((*s).ex.pan)((*s).ud, (*p).x0, (*p).y0, d) }
            return true
        }
        ((*s).pointer)((*s).ud, kind, x, y)
        return true
    }
    let r: u32 = screenpan.pan_up(p)
    if r == screenpan.UP_TAP { press_now(s, (*p).x0, (*p).y0) }
    if r != screenpan.UP_PAN { ((*s).pointer)((*s).ud, kind, x, y) }
    return true
}

fn on_key(ud: u64, key: u32, mods: u32) -> bool {
    let s: *mut Screen = ud as *mut Screen
    fuiwirt.host_touch(&(*s).w)
    if ((*s).key)((*s).ud, key, mods) { return true }
    if key == editor.KEY_ESC && (*s).ex.back_on && ((*s).ex.back_wanted)((*s).ud) {
        ((*s).ex.back_go)((*s).ud)
        return true
    }
    return ax_key(s, key, mods)
}

fn ax_key(s: *mut Screen, key: u32, mods: u32) -> bool {
    if key == editor.KEY_TAB { return screenax.focus_step((mods & editor.MOD_SHIFT) != 0 as u32) }
    if key != editor.KEY_ENTER { return false }
    var t: [f64; 2] = [0.0; 2]
    if !screenax.target(&t) { return false }
    ((*s).press)((*s).ud, t[0], t[1])
    return true
}

fn on_text(ud: u64, cp: u32, mods: u32) -> bool {
    let s: *mut Screen = ud as *mut Screen
    fuiwirt.host_touch(&(*s).w)
    if ((*s).text)((*s).ud, cp, mods) { return true }
    if cp != 32 as u32 { return false }
    return ax_key(s, editor.KEY_ENTER, mods)
}
fn wake_tick(ud: u64, now: i64) -> bool {
    let s: *mut Screen = ud as *mut Screen
    var ch: bool = screenanim.wake_tick(ud, now)
    if (*s).back_held && backkey.back_take() {
        ((*s).ex.back_go)((*s).ud)
        sync_back(s)
        ch = true
    }
    return ch
}

fn wake_wait(ud: u64, now: i64) -> i64 {
    let s: *mut Screen = ud as *mut Screen
    let w: i64 = screenanim.wake_wait(ud, now)
    if (*s).back_held && (w < 0 || w > 100) { return 100 }
    return w
}

fn on_act(ud: u64, i: usize) {}
fn on_done(ud: u64) -> bool { return false }
fn on_field(ud: u64, out: *mut [f64; 4]) -> bool { return false }

fn has_arg(start: u64, name: str) -> usize {
    var i: usize = 1
    while i < rt.arg_count(start) {
        let p: u64 = rt.arg_ptr(start, i)
        var k: usize = 0
        var same: bool = true
        while k < name.n {
            if *((p + k as u64) as *mut u8) != *((name.p as u64 + k as u64) as *mut u8) { same = false }
            k = k + 1
        }
        if same && *((p + name.n as u64) as *mut u8) == 0 as u8 { return i }
        i = i + 1
    }
    return 0
}

// the value after `name` ("--shot" -> the path), 0 when the flag is absent
fn arg_after(start: u64, name: str) -> u64 {
    let i: usize = has_arg(start, name)
    if i == 0 || i + 1 >= rt.arg_count(start) { return 0 }
    return rt.arg_ptr(start, i + 1)
}

// `--bench` with `--shot`: paints 60 more frames, prints `BENCH frame_us median=.. avg=.. max=..`.
fn bench_frames(s: *mut Screen, w: usize, h: usize) {
    var us: [i64; 60] = [0; 60]
    var sum: i64 = 0
    var i: usize = 0
    while i < 60 {
        let t0: u64 = time.monotonic_ns()
        on_paint(s as u64, w, h)
        us[i] = ((time.monotonic_ns() - t0) / 1000) as i64
        sum = sum + us[i]
        i = i + 1
    }
    var j: usize = 1
    while j < 60 {
        let k: i64 = us[j]
        var m: usize = j
        while m > 0 && us[m - 1] > k {
            us[m] = us[m - 1]
            m = m - 1
        }
        us[m] = k
        j = j + 1
    }
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b, "BENCH frame_us median=".p as u64, 22)
    rt.buf_push_dec_i64(&b, us[30])
    rt.buf_push_bytes(&b, " avg=".p as u64, 5)
    rt.buf_push_dec_i64(&b, sum / 60)
    rt.buf_push_bytes(&b, " max=".p as u64, 5)
    rt.buf_push_dec_i64(&b, us[59])
    rt.buf_push(&b, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
}

#[allow_escape]
fn shot(s: *mut Screen, w: usize, h: usize, dark: bool, path: u64, axp: u64, bench: bool) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) { return 9 }
    var z: painter.Painter = painter.painter_new()
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, w, h) || !painter.painter_init(&z, &cv, w, h) { return 10 }
    painter.painter_set_font(&z, fs as u64)
    on_attach(s as u64, &z)
    on_paint(s as u64, w, h)
    on_paint(s as u64, w, h)
    if axp != 0 && (*s).tree != 0 {
        let t: *mut screenaxtree.Tree = (*s).tree as *mut screenaxtree.Tree
        let jb: u64 = rt.heap_alloc(262144)
        let jn: usize = a11y.a11y_dump_json(screenaxtree.tree_scene(t), screenaxtree.tree_ax(t), jb, 262144)
        if !safeout.write_file(axp, jb, jn) { return 12 }
    }
    if bench { bench_frames(s, w, h) }
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if !png.write_png(&cv, &out) { return 11 }
    if !safeout.write_file(path, mem.buf_ptr(&out) as u64, mem.buf_len(&out)) { return 12 }
    return 0
}

// Run the screen: `--theme light|dark`, `--shot file.png` (one frame, no window).
fn run(start: u64, title: str, w: usize, h: usize, ud: u64,
    paint: fn(u64, *mut render.Ctx, f64, f64, f64, f64), press: fn(u64, f64, f64),
    key: fn(u64, u32, u32) -> bool, skin: fn(*mut theme.Theme, bool)) -> i32 {
    return run_text(start, title, w, h, ud, paint, press, key, no_key, skin)
}

// `run` plus `text(ud, codepoint, mods)`: typed characters (for apps with text fields); true = used.
fn run_text(start: u64, title: str, w: usize, h: usize, ud: u64,
    paint: fn(u64, *mut render.Ctx, f64, f64, f64, f64), press: fn(u64, f64, f64),
    key: fn(u64, u32, u32) -> bool, text: fn(u64, u32, u32) -> bool, skin: fn(*mut theme.Theme, bool)) -> i32 {
    return run_wheel(start, title, w, h, ud, paint, press, key, text, no_wheel, skin)
}

// `run_text` plus `wheel(ud, px, py, dx, dy)`: mouse wheel notches (dy > 0 = down) at the pointer; true = used.
fn run_wheel(start: u64, title: str, w: usize, h: usize, ud: u64,
    paint: fn(u64, *mut render.Ctx, f64, f64, f64, f64), press: fn(u64, f64, f64),
    key: fn(u64, u32, u32) -> bool, text: fn(u64, u32, u32) -> bool,
    wheel: fn(u64, f64, f64, f64, f64) -> bool, skin: fn(*mut theme.Theme, bool)) -> i32 {
    return run_full(start, title, w, h, ud, paint, press, key, text, wheel, no_pointer, skin)
}

// `run_wheel` plus `pointer(ud, kind, x, y)`: pointer moves and releases (fuiwirt.HOOK_MOVE / HOOK_UP), for drags; true = repaint.
fn run_full(start: u64, title: str, w: usize, h: usize, ud: u64,
    paint: fn(u64, *mut render.Ctx, f64, f64, f64, f64), press: fn(u64, f64, f64),
    key: fn(u64, u32, u32) -> bool, text: fn(u64, u32, u32) -> bool,
    wheel: fn(u64, f64, f64, f64, f64) -> bool, pointer: fn(u64, u32, f64, f64) -> bool, skin: fn(*mut theme.Theme, bool)) -> i32 {
    return run_ext(start, title, w, h, ud, paint, press, key, text, wheel, pointer, screenext.extras_blank(), skin)
}

// `run_full` plus `ex` (lib/fui/screenext.fi): touch pan (a press is held until the release, a drag past the slop calls `pan(ud, x0, y0, dy)`)
// and the Back key (`back_wanted(ud)` = a detail view is open; Escape and Android Back then call `back_go(ud)`; otherwise Back closes the app),
// and (`screenext.extras_pointers`) every pointer record -- `ptr(ud, kind, id, ptype, x, y, pressure)` with kind fuiwirt.PE_DOWN / PE_MOVE / PE_UP /
// PE_CANCEL, ptype event.PT_MOUSE / PT_TOUCH / PT_PEN, pressure 0.0 = unknown -- on back ends with real pointers (Android: all fingers and the pen
// with pressure; X11 XInput2 touch, no pressure). True = consumed; false = the normal press / pointer handling runs.
fn run_ext(start: u64, title: str, w: usize, h: usize, ud: u64,
    paint: fn(u64, *mut render.Ctx, f64, f64, f64, f64), press: fn(u64, f64, f64),
    key: fn(u64, u32, u32) -> bool, text: fn(u64, u32, u32) -> bool,
    wheel: fn(u64, f64, f64, f64, f64) -> bool, pointer: fn(u64, u32, f64, f64) -> bool, ex: screenext.Extras, skin: fn(*mut theme.Theme, bool)) -> i32 {
    screenax.install()
    let p: u64 = rt.heap_alloc(size_of_screen())
    if p == 0 { return 12 }
    let s: *mut Screen = p as *mut Screen
    *s = screen_blank()
    (*s).ud = ud
    (*s).paint = paint
    (*s).press = press
    (*s).key = key
    (*s).text = text
    (*s).wheel = wheel
    (*s).pointer = pointer
    (*s).ex = ex
    var dark: bool = true
    let t: u64 = arg_after(start, "--theme")
    if t != 0 && *(t as *mut u8) == 108 as u8 { dark = false }
    (*s).dark = dark
    (*s).skin = skin
    kitcolor.kit_theme(&(*s).m, dark)
    skin(&(*s).m, dark)
    let sp: u64 = arg_after(start, "--shot")
    let axp: u64 = arg_after(start, "--ax")
    if axp != 0 { screenax.set_tree(true); (*s).tree = screenaxtree.tree_new(title) as u64 }
    if sp != 0 {
        let zp: u64 = arg_after(start, "--size")
        let sw: usize = sizearg.width(zp, w)
        let sh: usize = sizearg.height(zp, h)
        return shot(s, sw, sh, dark, sp, axp, has_arg(start, "--bench") != 0)
    }
    (*s).w = fuiwirt.host_new(&(*s).sc, &(*s).c)
    fuiwirt.host_set_transitions(&(*s).w, &(*s).tr)
    fuiwirt.host_set_hook(&(*s).w, p, on_hook)
    if (*s).ex.ptr_on { fuiwirt.host_set_pointer_sink(&(*s).w, p, on_ptr) }
    fuiwirt.host_set_wake(&(*s).w, p, wake_tick, wake_wait)
    fuiwirt.host_bind(&(*s).w)
    (*s).hk = apphost.hooks_new(p, &(*s).m, &(*s).w, on_attach, on_paint, on_key, on_text,
        on_press, on_act, on_done, on_field, title, w, h)
    let tr: *mut screenaxtree.Tree = screenaxtree.tree_new(title)
    if screenbridge.enable(&(*s).hk, tr, title, p, ax_act, ax_focus, ax_click, ax_setnum, ax_settext, ax_setcaret) {
        screenax.set_tree(true)
        (*s).tree = tr as u64
    }
    if PUMP != 0 {
        let ph: *mut PumpHooks = PUMP as *mut PumpHooks
        apphost.hooks_set_pump(&(*s).hk, (*ph).ud, (*ph).fd, (*ph).ms, (*ph).step)
    }
    return apphost.run(&(*s).hk)
}
