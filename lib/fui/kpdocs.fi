import docview.pdf.opener
import docview.office.dx_open
import docview.office.od_open
import docview.office.xl_open
import docview.office.pp_open
import docview.office.dx_imgfui

export { DocInstaller, install_none, install_pdf, install_docx, install_odt, install_xlsx, install_pptx, install_pdf_docx, install_pdf_docx_odt, install_pdf_office }

type DocInstaller = fn()

fn install_none() {
}

fn install_pdf() {
    opener.pdf_install_lazy()
}

fn install_docx() {
    dx_open.docx_install_lazy()
    dx_imgfui.install_images()
}

fn install_pdf_docx() {
    opener.pdf_install_lazy()
    dx_open.docx_install_lazy()
    dx_imgfui.install_images()
}

fn install_odt() {
    od_open.odt_install_lazy()
    dx_imgfui.install_images()
}

fn install_pdf_docx_odt() {
    opener.pdf_install_lazy()
    dx_open.docx_install_lazy()
    od_open.odt_install_lazy()
    dx_imgfui.install_images()
}

fn install_xlsx() {
    xl_open.xlsx_install_lazy()
    dx_imgfui.install_images()
}

fn install_pptx() {
    pp_open.pptx_install_lazy()
    dx_imgfui.install_images()
}

fn install_pdf_office() {
    opener.pdf_install_lazy()
    dx_open.docx_install_lazy()
    od_open.odt_install_lazy()
    xl_open.xlsx_install_lazy()
    pp_open.pptx_install_lazy()
    dx_imgfui.install_images()
}
