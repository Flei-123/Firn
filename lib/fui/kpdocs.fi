// SPDX-License-Identifier: MPL-2.0
import docview.pdf.opener
import docview.office.dx_open
import docview.office.dx_imgfui

export { DocInstaller, install_none, install_pdf, install_docx, install_pdf_docx }

type DocInstaller = fn()

fn install_none() {
}

fn install_pdf() {
    opener.pdf_install_lazy()
}

fn install_docx() {
    dx_open.docx_install_lazy()
    dx_imgfui.install_images()
}

fn install_pdf_docx() {
    opener.pdf_install_lazy()
    dx_open.docx_install_lazy()
    dx_imgfui.install_images()
}
