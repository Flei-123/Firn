import fui.scene
import fui.widget
import fui.a11y
import fui.termwstate

export { tax_terminal }

const DEFAULT_LABEL: str = "Terminal"

fn tax_terminal(sc: *mut scene.Scene, ax: *mut a11y.A11y, parent: usize, tw: *mut termwstate.TermWidget) -> usize {
    let n: usize = scene.scene_add(sc, parent, scene.N_WIDGET)
    if n == scene.SCENE_NONE { return n }
    scene.node_set_widget_kind(sc, n, widget.KIND_TILE)
    a11y.a11y_set_role(ax, n, a11y.ROLE_TERMINAL)
    var name: str = termwstate.tw_title(tw)
    if name.n == 0 { name = DEFAULT_LABEL }
    a11y.a11y_set_name(ax, n, name.p as u64, name.n)
    let screen: str = termwstate.tw_screen_text(tw)
    a11y.a11y_set_description(ax, n, screen.p as u64, screen.n)
    a11y.a11y_set_live(ax, n, a11y.LIVE_OFF)
    return n
}
