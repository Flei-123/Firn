import fui.kit
import fui.kitchart
import fui.kitfmt
import fui.painter
import fui.render
import fui.style
import fui.kitplot

export { Line, LINE_CAP, line_new, line_draw, line_push, line_clear }

const LINE_CAP: usize = 512

struct Line {
    v: *mut [f64; 512],
    n: usize,
    label: str,
    idx: usize,
}

fn line_new(v: *mut [f64; 512], label: str, idx: usize) -> Line {
    return Line { v: v, n: 0, label: label, idx: idx }
}

fn line_clear(l: *mut Line) {
    (*l).n = 0
}

fn line_push(l: *mut Line, value: f64) {
    if (*l).n >= LINE_CAP {
        var i: usize = 0
        while i < LINE_CAP / 2 {
            (*(*l).v)[i] = (*(*l).v)[i * 2]
            i = i + 1
        }
        (*l).n = LINE_CAP / 2
    }
    (*(*l).v)[(*l).n] = value
    (*l).n = (*l).n + 1
}

fn extent(a: *mut Line, b: *mut Line, lo: *mut f64, hi: *mut f64) {
    var mn: f64 = 1.0e18
    var mx: f64 = 0.0 - 1.0e18
    var i: usize = 0
    while i < (*a).n {
        let v: f64 = (*(*a).v)[i]
        if v < mn { mn = v }
        if v > mx { mx = v }
        i = i + 1
    }
    i = 0
    while i < (*b).n {
        let v: f64 = (*(*b).v)[i]
        if v < mn { mn = v }
        if v > mx { mx = v }
        i = i + 1
    }
    if mx < mn {
        mn = 0.0
        mx = 1.0
    }
    var span: f64 = mx - mn
    if span < 0.0001 { span = 0.0001 }
    *lo = mn - span * 0.08
    *hi = mx + span * 0.08
    if *lo < 0.0 && mn >= 0.0 { *lo = 0.0 }
}

fn series_draw(c: *mut render.Ctx, s: *mut Line, x: f64, y: f64, w: f64, h: f64, lo: f64, hi: f64) {
    if (*s).n == 0 { return }
    let col: u32 = kitplot.series_col(c, (*s).idx)
    var xs: [f64; 512] = [0.0; 512]
    var ys: [f64; 512] = [0.0; 512]
    var i: usize = 0
    let den: f64 = ((*s).n - 1) as f64
    while i < (*s).n {
        var fx: f64 = 0.5
        if (*s).n > 1 { fx = (i as f64) / den }
        xs[i] = x + w * fx
        ys[i] = y + h - h * (((*(*s).v)[i] - lo) / (hi - lo))
        i = i + 1
    }
    if (*s).n > 1 {
        kitchart.polyline(c, &xs, &ys, (*s).n, kit.ln(c, 2), col)
    }
    let d: f64 = kit.ln(c, 3)
    painter.round_rect(render.ctx_painter(c), xs[(*s).n - 1] - d, ys[(*s).n - 1] - d, d * 2.0, d * 2.0, d, col)
}

fn legend_item(c: *mut render.Ctx, x: f64, y: f64, s: *mut Line) -> f64 {
    let col: u32 = kitplot.series_col(c, (*s).idx)
    let d: f64 = kit.ln(c, 4)
    painter.round_rect(render.ctx_painter(c), x, y + kit.ln(c, 7) - d / 2.0, d * 2.0, d * 2.0, d, col)
    let tw: f64 = kit.text_width(c, kit.ln(c, 11), 400, (*s).label)
    kit.draw_label(c, x + d * 2.0 + kit.ln(c, 5), y, kit.ln(c, 14), kit.ln(c, 11), 400, kit.tokc(c, style.TOK_TEXT_MUTED), (*s).label, 0.0)
    return d * 2.0 + kit.ln(c, 5) + tw + kit.ln(c, 12)
}

fn line_draw(c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, a: *mut Line, b: *mut Line, places: usize) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let lm: f64 = kit.ln(c, 44)
    let top: f64 = kit.ln(c, 20)
    let bm: f64 = kit.ln(c, 6)
    let px: f64 = x + lm
    let py: f64 = y + top
    let pw: f64 = w - lm - kit.ln(c, 8)
    let ph: f64 = h - top - bm
    if pw < kit.ln(c, 40) || ph < kit.ln(c, 30) { return }
    var lo: f64 = 0.0
    var hi: f64 = 1.0
    extent(a, b, &lo, &hi)
    var g: usize = 0
    while g < 5 {
        let gy: f64 = py + ph * (g as f64) / 4.0
        painter.surface(z, px, gy, pw, kit.ln(c, 1), kit.tokc(c, style.TOK_SEPARATOR))
        let v: f64 = hi - (hi - lo) * (g as f64) / 4.0
        let txt: str = kitfmt.dec(v, places)
        let tw: f64 = kit.text_width(c, kit.ln(c, 10), 400, txt)
        kit.draw_label(c, px - tw - kit.ln(c, 6), gy - kit.ln(c, 7), kit.ln(c, 14), kit.ln(c, 10), 400, kit.tokc(c, style.TOK_TEXT_MUTED), txt, 0.0)
        g = g + 1
    }
    series_draw(c, a, px, py, pw, ph, lo, hi)
    series_draw(c, b, px, py, pw, ph, lo, hi)
    var lx: f64 = px
    lx = lx + legend_item(c, lx, y, a)
    legend_item(c, lx, y, b)
}
