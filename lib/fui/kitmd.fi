// SPDX-License-Identifier: MPL-2.0
// lib/fui/kitmd.fi -- MARKDOWN FOR CHAT BUBBLES (immediate mode, cached layout).
//
//     var st: kitmd.Style = kitmd.style_theme(c, size, fg, muted)
//     let h: f64 = kitmd.md_height(c, text, maxw, size)
//     kitmd.md_draw(c, x, y, maxw, text, &st)
//
// Parsed by lib/markdown, laid out once per (text, width, size, face) and kept in a small cache, so the
// height query and the draw of one frame cost one layout. Bold, italic, `code`, bullet and numbered
// lists (nested, hanging wrap), # headings, fenced code blocks, quotes. Broken Markdown stays visible
// as text. Invalid UTF-8 and control characters are removed before parsing (kitmd_clean).
import std.rt
import fui.painter
import fui.render
import fui.kit
import fui.style
import fui.kitmd_types
import fui.kitmd_measure
import fui.kitmd_lay
import fui.kitmd_draw

export { style_theme, style_plain, md_layout, md_measure, md_height, md_width, md_draw, md_cache_clear, md_builds }

const SLOTS: usize = 24
static mut SL_KEY: [u64; 24] = [0; 24]
static mut SL_LAY: [u64; 24] = [0; 24]
static mut SL_NEXT: usize = 0
static mut BUILDS: i64 = 0

fn md_builds() -> i64 {
    return BUILDS
}

fn style_plain(size: f64, fg: u32, muted: u32, accent: u32, code_bg: u32, rule: u32) -> kitmd_types.Style {
    return kitmd_types.Style { size: size, text: fg, muted: muted, accent: accent, code_fg: fg, code_bg: code_bg, rule: rule }
}

fn style_theme(c: *mut render.Ctx, size: f64, fg: u32) -> kitmd_types.Style {
    return style_plain(size, fg, kit.tokc(c, style.TOK_TEXT_MUTED), kit.tokc(c, style.TOK_ACCENT),
        kit.tokc(c, style.TOK_FIELD), kit.tokc(c, style.TOK_BORDER))
}

fn key_of(z: *mut painter.Painter, p: u64, n: usize, maxw: f64, size: f64) -> u64 {
    var h: u64 = kitmd_measure.hash_new()
    var i: usize = 0
    while i < n {
        h = kitmd_measure.hmix(h, rt.ld8(p, i) as u64)
        i = i + 1
    }
    h = kitmd_measure.hmix(h, n as u64)
    h = kitmd_measure.hmix(h, (maxw * 16.0) as u64)
    h = kitmd_measure.hmix(h, (size * 64.0) as u64)
    h = kitmd_measure.hmix(h, painter.painter_font(z))
    h = kitmd_measure.hmix(h, painter.painter_font_slot(z, 1))
    return h | 1
}

fn md_cache_clear() {
    var i: usize = 0
    while i < SLOTS {
        SL_KEY[i] = 0
        i = i + 1
    }
}

fn md_layout(c: *mut render.Ctx, text: str, maxw: f64, size: f64) -> *mut kitmd_types.Layout {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let key: u64 = key_of(z, text.p as u64, text.n, maxw, size)
    var i: usize = 0
    while i < SLOTS {
        if SL_KEY[i] == key {
            return SL_LAY[i] as *mut kitmd_types.Layout
        }
        i = i + 1
    }
    let s: usize = SL_NEXT
    SL_NEXT = (SL_NEXT + 1) % SLOTS
    if SL_LAY[s] == 0 {
        let m: u64 = rt.heap_alloc(kitmd_types.layout_bytes())
        *(m as *mut kitmd_types.Layout) = kitmd_types.layout_new()
        SL_LAY[s] = m
    }
    let lay: *mut kitmd_types.Layout = SL_LAY[s] as *mut kitmd_types.Layout
    kitmd_lay.build(z, lay, text.p as u64, text.n, maxw, size)
    BUILDS = BUILDS + 1
    SL_KEY[s] = key
    return lay
}

fn md_measure(c: *mut render.Ctx, text: str, maxw: f64, size: f64, out: *mut [f64; 2]) {
    let lay: *mut kitmd_types.Layout = md_layout(c, text, maxw, size)
    (*out)[0] = (*lay).w
    (*out)[1] = (*lay).h
}

fn md_height(c: *mut render.Ctx, text: str, maxw: f64, size: f64) -> f64 {
    return (*md_layout(c, text, maxw, size)).h
}

fn md_width(c: *mut render.Ctx, text: str, maxw: f64, size: f64) -> f64 {
    return (*md_layout(c, text, maxw, size)).w
}

fn md_draw(c: *mut render.Ctx, x: f64, y: f64, maxw: f64, text: str, st: *mut kitmd_types.Style) -> f64 {
    let lay: *mut kitmd_types.Layout = md_layout(c, text, maxw, (*st).size)
    kitmd_draw.draw(c, lay, x, y, st)
    return (*lay).h
}
