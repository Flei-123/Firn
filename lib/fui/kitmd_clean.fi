import std.rt
import fui.painter

export { clean_into, scalar_ok }

fn scalar_ok(cp: u32) -> bool {
    if cp < 32 as u32 { return cp == 10 as u32 }
    if cp >= 127 as u32 && cp <= 159 as u32 { return false }
    if cp == 173 as u32 { return false }
    if cp >= 0x200B as u32 && cp <= 0x200F as u32 { return false }
    if cp >= 0x2028 as u32 && cp <= 0x202E as u32 { return false }
    if cp >= 0x2060 as u32 && cp <= 0x206F as u32 { return false }
    if cp >= 0xD800 as u32 && cp <= 0xF8FF as u32 { return false }
    if cp >= 0xFDD0 as u32 && cp <= 0xFDEF as u32 { return false }
    if cp >= 0xFE00 as u32 && cp <= 0xFE0F as u32 { return false }
    if cp == 0xFEFF as u32 { return false }
    if cp >= 0xFFF0 as u32 && cp <= 0xFFFF as u32 { return false }
    if cp > 0x10FFFF as u32 { return false }
    if (cp & 0xFFFE as u32) == 0xFFFE as u32 { return false }
    return true
}

fn decode(p: u64, n: usize, i: usize, len: *mut usize) -> u32 {
    let b0: u32 = rt.ld8(p, i) as u32
    var need: usize = 0
    var cp: u32 = 0 as u32
    var min: u32 = 0 as u32
    if b0 < 0x80 as u32 {
        *len = 1
        return b0
    } else if b0 >= 0xC2 as u32 && b0 <= 0xDF as u32 {
        need = 1
        cp = b0 & 0x1F as u32
        min = 0x80 as u32
    } else if b0 >= 0xE0 as u32 && b0 <= 0xEF as u32 {
        need = 2
        cp = b0 & 0x0F as u32
        min = 0x800 as u32
    } else if b0 >= 0xF0 as u32 && b0 <= 0xF4 as u32 {
        need = 3
        cp = b0 & 0x07 as u32
        min = 0x10000 as u32
    } else {
        *len = 1
        return 0xFFFFFFFF as u32
    }
    if i + need >= n {
        *len = n - i
        return 0xFFFFFFFE as u32
    }
    var j: usize = 1
    while j <= need {
        let b: u32 = rt.ld8(p, i + j) as u32
        if (b & 0xC0 as u32) != 0x80 as u32 {
            *len = j
            return 0xFFFFFFFF as u32
        }
        cp = (cp << 6) | (b & 0x3F as u32)
        j = j + 1
    }
    *len = need + 1
    if cp < min { return 0xFFFFFFFF as u32 }
    return cp
}

fn clean_into(z: *mut painter.Painter, out: *mut rt.Buf, p: u64, n: usize) {
    var i: usize = 0
    while i < n {
        var len: usize = 1
        let cp: u32 = decode(p, n, i, &len)
        if cp == 9 as u32 || cp == 160 as u32 || cp == 11 as u32 || cp == 12 as u32 {
            rt.buf_push(out, 32 as u8)
        } else if cp == 0x85 as u32 || cp == 0x2028 as u32 || cp == 0x2029 as u32 {
            rt.buf_push(out, 10 as u8)
        } else if cp < 0xFFFFFFFE as u32 && scalar_ok(cp) {
            if cp < 128 as u32 || z as u64 == 0 || painter.glyph_present(z, cp) {
                rt.buf_push_bytes(out, p + (i as u64), len)
            }
        }
        i = i + len
    }
}
