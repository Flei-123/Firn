// SPDX-License-Identifier: MPL-2.0
// lib/fui/fontdlg.fi -- THE FONT DIALOG (fUi roadmap r177, Firn r348): the
// Windows "Choose Font" in fUi's own look.
//
//     var fam: rt.Buf = rt.buf_new()
//     var pick: fontdlg.FontPick = fontdlg.pick_new()
//     let rc: i32 = fontdlg.run("Choose a font", "DejaVu Sans", 12, &fam, &pick)
//     // rc 0: fam holds the family (UTF-8), pick the size / bold / italic /
//     //       underline / strike;  1: cancelled or closed;  12: no window
//
// ========================================================= WHAT IT HAS
//
//   * three lists -- Font (with a filter field above: typing narrows the
//     list to the families that CONTAIN the text), Style (the faces of the
//     chosen family: Regular, Italic, Bold, Bold Italic, then Light, Medium,
//     Condensed ...) and Size (8 .. 72 plus a free number field, 1 .. 999);
//   * check boxes Bold, Italic, Underline, Strikeout;
//   * a sample box that draws the sample text WITH THE CHOSEN FACE at the
//     chosen size (see "THE PREVIEW");
//   * OK / Cancel; Enter = OK, Esc = Cancel, closing the window = Cancel.
//
// The fonts come from lib/fui/fontscan.fi (one walk of the font folders per
// program start, in slices of 8 ms per frame while the window is open, so a
// big folder never freezes it; the status line says "Scanning ..." until it
// is done).
//
// ====================================================== THE LISTS
//
// Each list is ONE scene node with its own painter -- never a node per row
// (a window has 128 nodes). The painter draws only the rows that are in
// view, so 500 families cost the same as 20. Rows: hover (TOK_BUTTON_HOVER),
// chosen (TOK_SELECTION / TOK_SELECTION_TEXT), a thin scroll bar with a
// thumb you can drag, the focus ring of the theme around the whole list.
// The mouse wheel scrolls the list under the pointer; the chosen row is
// scrolled into view when the keyboard or the filter changes it.
//
// Keys (list focused): Up/Down, PageUp/PageDown, Home/End; typing a name
// jumps to the first row that starts with it (a second of silence starts a
// new word). In the filter field Up/Down/PageUp/PageDown move the family
// list; in the size field Up/Down count.
//
// ====================================================== BOLD AND ITALIC
//
// The check boxes hold the user's WISH. A tick picks the face of the family
// that is bold / italic exactly (`fontscan.pick_face`: a plain Bold beats a
// Condensed Bold). If the family HAS no such face the tick stays and the
// sample is EMULATED by the painter (a bolder outline, a sheared one;
// painter.run_set_weight / run_set_slant) -- the status line says so. The
// answer `FontPick.bold` / `.italic` is then the wish: an application that
// opens the family at that weight gets the same emulation. Choosing a row
// of the Style list sets the ticks from that face.
//
// ====================================================== THE PREVIEW
//
// Can a program load a font file at run time into a font slot? Yes:
// `metrics.fontset_load` takes any TrueType file in memory and
// `painter.painter_set_font` swaps it in for the length of one draw (the
// glyph cache keys on the font set). So the sample is the real face. The
// last three faces stay in memory (least recently used goes first; a font
// that is not in memory is read from disk, 1 ms for 750 KB). Limits
// (lib/font/ttf.fi): outlines of the CFF kind (.otf from Adobe/URW) and
// faces inside a .ttc collection cannot be drawn; the sample then uses the
// system face and the status line says so. The sample is capped to the
// height of its box (a 72 pt line does not fit 120 pixels) and clipped at
// its right edge.
//
// The names in the lists are written in the system face, not each in its own
// (that would load every file of the list).
//
// ====================================================== FOR EMBEDDING
//
// `run` is `dlg_new` + `build` + `app.run`. A program with its own window
// calls `dlg_new` and `build(a, d, family, size)` into the current container
// of its `app.App` and reads `dlg_done`, `dlg_result` after the window
// closed (or when `dlg_done` is true). `dlg_key` / `dlg_char` are the key
// hooks `build` installs; tests call them directly.
import std.rt
import std.time
import font.metrics
import paint.canvas
import fui.app
import fui.scene
import fui.widget
import fui.render
import fui.painter
import fui.style
import fui.theme
import fui.a11y
import fui.editor
import fui.fcache
import fui.flex
import fui.fontscan
import plat.fuiwirt
import plat.envvar

export {
    FontPick, pick_new, FontDlg, dlg_new, build, run, dlg_done, dlg_result,
    dlg_key, dlg_char, dlg_family, dlg_face, dlg_size, dlg_bold, dlg_italic,
    dlg_underline, dlg_strike, dlg_visible_count, dlg_status,
    dlg_set_family, dlg_set_size, dlg_node, dlg_preview_rect, set_first_slice,
    dlg_list_top, dlg_list_geometry, dlg_font_loads, dlg_synth,
    DLG_FAMILY, DLG_STYLE, DLG_SIZE, SAMPLE_TEXT,
    NODE_FILTER, NODE_SIZE, NODE_SAMPLE, NODE_LIST_FAMILY, NODE_LIST_STYLE,
    NODE_LIST_SIZE, NODE_BOLD, NODE_ITALIC, NODE_UNDERLINE, NODE_STRIKE,
    NODE_PREVIEW, NODE_OK, NODE_CANCEL, NODE_STATUS,
    WIN_W, WIN_H,
}

struct FontPick {
    size: i32,
    bold: bool,
    italic: bool,
    underline: bool,
    strike: bool,
}

fn pick_new() -> FontPick {
    return FontPick { size: 12, bold: false, italic: false, underline: false, strike: false }
}

// ------------------------------------------------------------ texts (one place)

fn tr_family() -> str { return "Font" }
fn tr_style() -> str { return "Style" }
fn tr_size() -> str { return "Size" }
fn tr_sample() -> str { return "Sample" }
fn tr_bold() -> str { return "Bold" }
fn tr_italic() -> str { return "Italic" }
fn tr_underline() -> str { return "Underline" }
fn tr_strike() -> str { return "Strikeout" }
fn tr_ok() -> str { return "OK" }
fn tr_cancel() -> str { return "Cancel" }
fn tr_filter_hint() -> str { return "Filter fonts" }
fn tr_size_hint() -> str { return "Font size" }
fn tr_sample_hint() -> str { return "Sample text" }
fn tr_family_list() -> str { return "Font family list" }
fn tr_style_list() -> str { return "Font style list" }
fn tr_size_list() -> str { return "Font size list" }
fn tr_preview() -> str { return "Font sample" }
fn tr_scanning() -> str { return "Scanning fonts" }
fn tr_families() -> str { return "font families" }
fn tr_no_match() -> str { return "No font matches the filter" }
fn tr_fallback() -> str { return "No fonts found - using the system font" }
fn tr_no_preview() -> str { return "This font format cannot be previewed - showing the system font" }
fn tr_emulated() -> str { return "Not installed in this family - emulated in the sample" }

const SAMPLE_TEXT: str = "AaBbYyZz 0123 äöü ß"

// ------------------------------------------------------------ constants

const WIN_W: usize = 574
const WIN_H: usize = 564
const FAM_W: f64 = 252.0
const STY_W: f64 = 176.0
const SIZ_W: f64 = 90.0
const LIST_H: f64 = 172.0
const PREV_H: f64 = 112.0
const ROW_PT: f64 = 24.0

const DLG_FAMILY: usize = 0
const DLG_STYLE: usize = 1
const DLG_SIZE: usize = 2
const NONE: usize = 4294967295
const BIG: i64 = 1000000

// The node roles `dlg_node` answers to.
const NODE_FILTER: usize = 0
const NODE_SIZE: usize = 1
const NODE_SAMPLE: usize = 2
const NODE_LIST_FAMILY: usize = 3
const NODE_LIST_STYLE: usize = 4
const NODE_LIST_SIZE: usize = 5
const NODE_BOLD: usize = 6
const NODE_ITALIC: usize = 7
const NODE_UNDERLINE: usize = 8
const NODE_STRIKE: usize = 9
const NODE_PREVIEW: usize = 10
const NODE_OK: usize = 11
const NODE_CANCEL: usize = 12
const NODE_STATUS: usize = 13

// How long `build` lets the font walk run before the window opens (milliseconds);
// what is not found by then is found in the slices of the frames.
static mut FIRST_SLICE: u64 = 120

static SIZES: [i32; 16] = [8, 9, 10, 11, 12, 14, 16, 18, 20, 22, 24, 26, 28, 36, 48, 72]

// ------------------------------------------------------------ state

struct ListView {
    dlg: u64,
    which: usize,
    node: usize,
    top: f64, // scrolled by (pixels)
    hover: usize, // row under the pointer, NONE
    row_h: f64, // the geometry of the last draw (the pointer hooks use it)
    gx: f64,
    gy: f64,
    gw: f64,
    gh: f64,
    inset: f64,
    bar_w: f64,
    max_top: f64,
    n: usize,
    reveal: bool,
    center: bool, // scroll the chosen row to the middle (first show), else only into view
    drag: bool, // the thumb is being dragged
    drag_dy: f64,
    bar_hot: bool,
}

fn lv_blank() -> ListView {
    return ListView { dlg: 0, which: 0, node: NONE, top: 0.0, hover: NONE, row_h: 0.0,
        gx: 0.0, gy: 0.0, gw: 0.0, gh: 0.0, inset: 0.0, bar_w: 0.0, max_top: 0.0, n: 0,
        reveal: false, center: false, drag: false, drag_dy: 0.0, bar_hot: false }
}

// One font of the sample, kept in memory.
struct Slot {
    face: usize,
    used: u64,
    fs: u64, // *mut metrics.FontSet, 0 = empty
    data: rt.Buf,
}

fn slot_blank() -> Slot {
    return Slot { face: NONE, used: 0, fs: 0, data: rt.buf_new() }
}

struct FontDlg {
    a: *mut app.App,
    lv: [ListView; 3],
    n_vis: usize,
    vis: u64, // u32 family ids, FACES_MAX of them
    fam: usize, // the chosen family (fontscan index), NONE
    face: usize, // the chosen face, as an index within the family
    size: i32,
    bold: bool,
    italic: bool,
    under: bool,
    strike: bool,
    nodes: [usize; 14],
    result: i32, // -1 running, 0 chosen, 1 cancelled
    out_fam: rt.Buf,
    last_filter: rt.Buf,
    last_size: rt.Buf,
    last_status: rt.Buf,
    init_fam: rt.Buf,
    init_pending: bool,
    ta: [u8; 40],
    ta_n: usize,
    ta_ns: u64,
    slots: [Slot; 3],
    tick: u64,
    loads: usize, // files read for the sample
    px: f64, // the pointer, last seen
    py: f64,
    prev_state: u32, // 0 real face, 1 system face (cannot draw it), 2 face missing
    synth_b: bool,
    synth_i: bool,
    scan_ns: u64, // when the last walk slice ended
    ax_last: [rt.Buf; 3], // the accessible names of the lists, with the chosen row
    ready: bool,
}

fn fdlg_alloc_of[T]() -> u64 {
    return rt.heap_alloc(size_of[T]())
}

fn fdlg_size_of[T]() -> usize {
    return size_of[T]()
}

fn dlg_blank() -> FontDlg {
    return FontDlg {
        a: 0 as u64 as *mut app.App,
        lv: [lv_blank(); 3],
        n_vis: 0, vis: 0, fam: NONE, face: NONE, size: 12,
        bold: false, italic: false, under: false, strike: false,
        nodes: [NONE; 14], result: 0 - 1,
        out_fam: rt.buf_new(), last_filter: rt.buf_new(), last_size: rt.buf_new(),
        last_status: rt.buf_new(), init_fam: rt.buf_new(), init_pending: true,
        ta: [0 as u8; 40], ta_n: 0, ta_ns: 0,
        slots: [slot_blank(); 3], tick: 0, loads: 0, px: 0.0, py: 0.0,
        prev_state: 0 as u32, synth_b: false, synth_i: false, scan_ns: 0 as u64, ax_last: [rt.buf_new(); 3],
        ready: false }
}

// A new dialog state on the heap; 0 when out of memory.
fn dlg_new() -> *mut FontDlg {
    let p: u64 = fdlg_alloc_of[FontDlg]()
    if p == 0 {
        return 0 as u64 as *mut FontDlg
    }
    let d: *mut FontDlg = p as *mut FontDlg
    *d = dlg_blank()
    (*d).vis = rt.heap_alloc(fontscan.FACES_MAX * 4)
    if (*d).vis == 0 {
        return 0 as u64 as *mut FontDlg
    }
    var i: usize = 0
    while i < 3 {
        (*d).lv[i].dlg = p
        (*d).lv[i].which = i
        i = i + 1
    }
    return d
}

fn dlg_done(d: *mut FontDlg) -> bool { return (*d).result >= 0 }
fn dlg_family(d: *mut FontDlg) -> usize { return (*d).fam }
fn dlg_face(d: *mut FontDlg) -> usize { return (*d).face }
fn dlg_size(d: *mut FontDlg) -> i32 { return (*d).size }
fn dlg_bold(d: *mut FontDlg) -> bool { return (*d).bold }
fn dlg_italic(d: *mut FontDlg) -> bool { return (*d).italic }
fn dlg_underline(d: *mut FontDlg) -> bool { return (*d).under }
fn dlg_strike(d: *mut FontDlg) -> bool { return (*d).strike }
fn dlg_visible_count(d: *mut FontDlg) -> usize { return (*d).n_vis }
fn dlg_font_loads(d: *mut FontDlg) -> usize { return (*d).loads }

// Is the sample emulating Bold (0) or Italic (1) because the face lacks it?
fn dlg_synth(d: *mut FontDlg, which: usize) -> bool {
    if which == 0 {
        return (*d).synth_b
    }
    return (*d).synth_i
}

// The scene node of a part (NODE_*).
fn dlg_node(d: *mut FontDlg, role: usize) -> usize {
    if role >= 14 {
        return NONE
    }
    return (*d).nodes[role]
}

// The geometry the list `which` painted last: x, y, w, h, row height, scroll
// offset, rows. false before the first frame.
fn dlg_list_geometry(d: *mut FontDlg, which: usize, out: *mut [f64; 7]) -> bool {
    if which >= 3 || (*d).lv[which].row_h <= 0.0 {
        return false
    }
    let l: *mut ListView = &(*d).lv[which]
    (*out)[0] = (*l).gx
    (*out)[1] = (*l).gy
    (*out)[2] = (*l).gw
    (*out)[3] = (*l).gh
    (*out)[4] = (*l).row_h
    (*out)[5] = (*l).top
    (*out)[6] = (*l).n as f64
    return true
}

fn dlg_list_top(d: *mut FontDlg, which: usize) -> f64 {
    if which >= 3 {
        return 0.0
    }
    return (*d).lv[which].top
}

// The sample box as painted last: x, y, w, h.
fn dlg_preview_rect(d: *mut FontDlg, out: *mut [f64; 4]) -> bool {
    let sc: *mut scene.Scene = app.app_scene((*d).a)
    let n: usize = (*d).nodes[NODE_PREVIEW]
    if n == NONE {
        return false
    }
    (*out)[0] = scene.node_x(sc, n)
    (*out)[1] = scene.node_y(sc, n)
    (*out)[2] = scene.node_w(sc, n)
    (*out)[3] = scene.node_h(sc, n)
    return true
}

// ------------------------------------------------------------ small helpers

fn col(c: *mut render.Ctx, tk: u32) -> u32 {
    return render.color_of(c, style.color_token(tk))
}

fn pt_px(c: *mut render.Ctx, pt: f64) -> f64 {
    return render.len_of(c, 1000) * pt / 1000.0
}

fn round_i(x: f64) -> f64 {
    if x < 0.0 {
        return 0.0 - round_i(0.0 - x)
    }
    return ((x + 0.5) as i64) as f64
}

fn max_f(a: f64, b: f64) -> f64 {
    if a > b {
        return a
    }
    return b
}

fn min_f(a: f64, b: f64) -> f64 {
    if a < b {
        return a
    }
    return b
}

fn view_of(b: *mut rt.Buf) -> str {
    return str { p: rt.buf_data(b), n: rt.buf_len(b) }
}

fn set_buf(b: *mut rt.Buf, s: str) {
    rt.buf_clear(b)
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn same(a: str, b: str) -> bool {
    if a.n != b.n {
        return false
    }
    var i: usize = 0
    while i < a.n {
        if rt.ld8(a.p as u64, i) != rt.ld8(b.p as u64, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn dec_str(v: i64, b: *mut rt.Buf) {
    rt.buf_clear(b)
    rt.buf_push_dec_i64(b, v)
}

fn now_ns() -> u64 {
    return time.monotonic_ns()
}

fn touch(d: *mut FontDlg) {
    fuiwirt.host_touch(app.app_host((*d).a))
}

fn vis_at(d: *mut FontDlg, i: usize) -> usize {
    return rt.ld32((*d).vis, i) as usize
}

fn vis_set(d: *mut FontDlg, i: usize, v: usize) {
    rt.st32((*d).vis, i, v as u32)
}

// The display row of the chosen family in the filtered list, NONE if hidden.
fn fam_row(d: *mut FontDlg) -> usize {
    if (*d).fam == NONE {
        return NONE
    }
    var i: usize = 0
    while i < (*d).n_vis {
        if vis_at(d, i) == (*d).fam {
            return i
        }
        i = i + 1
    }
    return NONE
}

fn size_row(d: *mut FontDlg) -> usize {
    var i: usize = 0
    while i < 16 {
        if SIZES[i] == (*d).size {
            return i
        }
        i = i + 1
    }
    return NONE
}

fn item_count(d: *mut FontDlg, which: usize) -> usize {
    if which == DLG_FAMILY {
        return (*d).n_vis
    }
    if which == DLG_STYLE {
        if (*d).fam == NONE {
            return 0
        }
        return fontscan.family_face_count((*d).fam)
    }
    return 16
}

// The text of row `i` of list `which`; numbers are written into `tmp`.
fn item_text(d: *mut FontDlg, which: usize, i: usize, tmp: *mut rt.Buf) -> str {
    if which == DLG_FAMILY {
        return fontscan.family_name(vis_at(d, i))
    }
    if which == DLG_STYLE {
        return fontscan.face_style(fontscan.family_face((*d).fam, i))
    }
    dec_str(SIZES[i] as i64, tmp)
    return view_of(tmp)
}

fn sel_row(d: *mut FontDlg, which: usize) -> usize {
    if which == DLG_FAMILY {
        return fam_row(d)
    }
    if which == DLG_STYLE {
        if (*d).fam == NONE {
            return NONE
        }
        return (*d).face
    }
    return size_row(d)
}

fn face_id(d: *mut FontDlg) -> usize {
    if (*d).fam == NONE || (*d).face == NONE {
        return NONE
    }
    return fontscan.family_face((*d).fam, (*d).face)
}

fn clamp_size(v: i64) -> i32 {
    if v < 1 {
        return 1
    }
    if v > 999 {
        return 999
    }
    return v as i32
}

// ------------------------------------------------------------ selection logic

fn set_check(d: *mut FontDlg, role: usize, on: bool) {
    let n: usize = (*d).nodes[role]
    if n == NONE {
        return
    }
    let w: *mut widget.Widget = scene.node_widget(app.app_scene((*d).a), n)
    if on {
        widget.w_set_value(w, 1)
    } else {
        widget.w_set_value(w, 0)
    }
    widget.w_set_selected(w, on)
}

fn sync_checks(d: *mut FontDlg) {
    set_check(d, NODE_BOLD, (*d).bold)
    set_check(d, NODE_ITALIC, (*d).italic)
    set_check(d, NODE_UNDERLINE, (*d).under)
    set_check(d, NODE_STRIKE, (*d).strike)
}

fn set_ok_enabled(d: *mut FontDlg) {
    let n: usize = (*d).nodes[NODE_OK]
    if n == NONE {
        return
    }
    let w: *mut widget.Widget = scene.node_widget(app.app_scene((*d).a), n)
    widget.w_set_disabled(w, (*d).fam == NONE)
}

fn reveal_all(d: *mut FontDlg) {
    var i: usize = 0
    while i < 3 {
        (*d).lv[i].reveal = true
        (*d).lv[i].center = true
        i = i + 1
    }
}

// Is the face `j` of the chosen family emulated in part (bold / italic)?
fn compute_synth(d: *mut FontDlg) {
    (*d).synth_b = false
    (*d).synth_i = false
    let f: usize = face_id(d)
    if f == NONE {
        return
    }
    (*d).synth_b = (*d).bold && !fontscan.face_bold(f)
    (*d).synth_i = (*d).italic && !fontscan.face_italic(f)
}

// Choose face `j` of the chosen family; `from_row`: the user picked the row,
// so the ticks follow the face.
fn select_face(d: *mut FontDlg, j: usize, from_row: bool) {
    if (*d).fam == NONE || j >= fontscan.family_face_count((*d).fam) {
        return
    }
    (*d).face = j
    if from_row {
        let f: usize = fontscan.family_face((*d).fam, j)
        (*d).bold = fontscan.face_bold(f)
        (*d).italic = fontscan.face_italic(f)
        sync_checks(d)
    }
    compute_synth(d)
    (*d).lv[DLG_STYLE].reveal = true
    touch(d)
}

// Choose the family `fam` (a fontscan index). The style stays when the new
// family has it, else the face that fits the Bold / Italic ticks, else the first.
fn select_family(d: *mut FontDlg, fam: usize) {
    var keep: rt.Buf = rt.buf_new()
    var had: bool = false
    let old: usize = face_id(d)
    if old != NONE {
        set_buf(&keep, fontscan.face_style(old))
        had = true
    }
    (*d).fam = fam
    (*d).face = NONE
    if fam != NONE {
        var j: usize = NONE
        if had {
            j = fontscan.find_face_style(fam, view_of(&keep))
        }
        if j == NONE {
            j = fontscan.pick_face(fam, (*d).bold, (*d).italic)
        }
        if j == NONE {
            j = fontscan.pick_face(fam, false, false)
        }
        if j == NONE {
            j = 0
        }
        (*d).face = j
    }
    rt.buf_free(&keep)
    compute_synth(d)
    set_ok_enabled(d)
    (*d).lv[DLG_FAMILY].reveal = true
    (*d).lv[DLG_STYLE].top = 0.0
    (*d).lv[DLG_STYLE].reveal = true
    touch(d)
}

// Choose the row `i` of the (filtered) family list.
fn select_family_row(d: *mut FontDlg, i: usize) {
    if i >= (*d).n_vis {
        return
    }
    select_family(d, vis_at(d, i))
}

// Set the size (clamped 1..999) and show it in the field.
fn set_size(d: *mut FontDlg, v: i64, write: bool) {
    (*d).size = clamp_size(v)
    if write {
        var t: rt.Buf = rt.buf_new()
        dec_str((*d).size as i64, &t)
        app.set_text((*d).a, (*d).nodes[NODE_SIZE], view_of(&t))
        set_buf(&(*d).last_size, view_of(&t))
        rt.buf_free(&t)
    }
    (*d).lv[DLG_SIZE].reveal = true
    touch(d)
}

// Rebuild the filtered list from the filter text; keep the chosen family if
// it is still shown, else take the first one shown.
fn refilter(d: *mut FontDlg) {
    let ft: str = view_of(&(*d).last_filter)
    (*d).n_vis = 0
    var i: usize = 0
    let n: usize = fontscan.family_count()
    while i < n {
        if fontscan.fold_has(fontscan.family_name(i), ft) {
            vis_set(d, (*d).n_vis, i)
            (*d).n_vis = (*d).n_vis + 1
        }
        i = i + 1
    }
    if fam_row(d) == NONE {
        if (*d).n_vis > 0 && !(*d).init_pending {
            select_family(d, vis_at(d, 0))
        } else if (*d).n_vis == 0 {
            select_family(d, NONE)
        }
    }
    (*d).lv[DLG_FAMILY].reveal = true
    touch(d)
}

// The family table changed (more fonts found): find the chosen family again
// by name, rebuild the filtered list.
fn after_scan_step(d: *mut FontDlg) {
    var name: rt.Buf = rt.buf_new()
    var style_name: rt.Buf = rt.buf_new()
    let old: usize = face_id(d)
    if (*d).fam != NONE && old != NONE {
        set_buf(&name, fontscan.family_name((*d).fam))
        set_buf(&style_name, fontscan.face_style(old))
    }
    (*d).fam = NONE
    (*d).face = NONE
    if rt.buf_len(&name) > 0 {
        let f: usize = fontscan.find_family(view_of(&name))
        if f != NONE {
            (*d).fam = f
            var j: usize = fontscan.find_face_style(f, view_of(&style_name))
            if j == NONE {
                j = 0
            }
            (*d).face = j
        }
    }
    rt.buf_free(&name)
    rt.buf_free(&style_name)
    // the initial family, as soon as the walk has found it (or is over)
    if (*d).init_pending {
        let f2: usize = fontscan.find_family(view_of(&(*d).init_fam))
        if f2 != NONE {
            (*d).init_pending = false
            refilter(d)
            select_family(d, f2)
            reveal_all(d)
            return
        }
        if fontscan.done() {
            (*d).init_pending = false
            refilter(d)
            if (*d).n_vis > 0 {
                select_family(d, vis_at(d, 0))
            }
            return
        }
    }
    refilter(d)
    compute_synth(d)
    set_ok_enabled(d)
}

// ------------------------------------------------------------ status line

fn status_line(d: *mut FontDlg, out: *mut rt.Buf) {
    rt.buf_clear(out)
    if !fontscan.done() {
        rt.buf_push_bytes(out, tr_scanning().p as u64, tr_scanning().n)
        rt.buf_push_bytes(out, " - ".p as u64, 3)
        rt.buf_push_dec_u64(out, fontscan.family_count() as u64)
        rt.buf_push_bytes(out, " ".p as u64, 1)
        rt.buf_push_bytes(out, tr_families().p as u64, tr_families().n)
        return
    }
    if (*d).n_vis == 0 {
        rt.buf_push_bytes(out, tr_no_match().p as u64, tr_no_match().n)
        return
    }
    if fontscan.fallback_active() {
        rt.buf_push_bytes(out, tr_fallback().p as u64, tr_fallback().n)
        return
    }
    let fid: usize = face_id(d)
    if (*d).prev_state == 1 as u32 || (fid != NONE && !fontscan.face_drawable(fid)) {
        rt.buf_push_bytes(out, tr_no_preview().p as u64, tr_no_preview().n)
        return
    }
    if (*d).synth_b || (*d).synth_i {
        if (*d).synth_b && (*d).synth_i {
            rt.buf_push_bytes(out, "Bold Italic - ".p as u64, 14)
        } else if (*d).synth_b {
            rt.buf_push_bytes(out, "Bold - ".p as u64, 7)
        } else {
            rt.buf_push_bytes(out, "Italic - ".p as u64, 9)
        }
        rt.buf_push_bytes(out, tr_emulated().p as u64, tr_emulated().n)
        return
    }
    rt.buf_push_dec_u64(out, (*d).n_vis as u64)
    rt.buf_push_bytes(out, " ".p as u64, 1)
    rt.buf_push_bytes(out, tr_families().p as u64, tr_families().n)
}

// The accessible name of each list: its own name and the chosen row ("Font
// family list: DejaVu Sans"). The rows are not nodes of their own (a list is
// one node that paints only what is in view), so the chosen one is said here.
fn update_names(d: *mut FontDlg) {
    var which: usize = 0
    while which < 3 {
        let n: usize = (*d).nodes[NODE_LIST_FAMILY + which]
        if n != NONE {
            var base: str = tr_family_list()
            if which == DLG_STYLE {
                base = tr_style_list()
            }
            if which == DLG_SIZE {
                base = tr_size_list()
            }
            var nm: rt.Buf = rt.buf_new()
            rt.buf_push_bytes(&nm, base.p as u64, base.n)
            let sel: usize = sel_row(d, which)
            if sel != NONE && sel < item_count(d, which) {
                var tmp: rt.Buf = rt.buf_new()
                let item: str = item_text(d, which, sel, &tmp)
                rt.buf_push_bytes(&nm, ": ".p as u64, 2)
                rt.buf_push_bytes(&nm, item.p as u64, item.n)
                rt.buf_free(&tmp)
            }
            if !same(view_of(&nm), view_of(&(*d).ax_last[which])) {
                set_buf(&(*d).ax_last[which], view_of(&nm))
                a11y.a11y_set_name(&(*(*d).a).ax, n, rt.buf_ptr(&(*d).ax_last[which]), rt.buf_len(&(*d).ax_last[which]))
            }
            rt.buf_free(&nm)
        }
        which = which + 1
    }
}

// The status line, when its text changed.
fn show_status(d: *mut FontDlg) {
    var sl: rt.Buf = rt.buf_new()
    status_line(d, &sl)
    if !same(view_of(&sl), view_of(&(*d).last_status)) {
        set_buf(&(*d).last_status, view_of(&sl))
        app.set_text((*d).a, (*d).nodes[NODE_STATUS], view_of(&sl))
    }
    rt.buf_free(&sl)
}

// The text fields and the walk, once per painted node (idempotent, cheap).
fn sync(d: *mut FontDlg) {
    let a: *mut app.App = (*d).a
    if !fontscan.done() {
        // one slice per frame: the painters of one frame all come here
        let now: u64 = now_ns()
        if now - (*d).scan_ns > 4000000 as u64 {
            let before: usize = fontscan.family_count()
            let fin: bool = fontscan.step(8 as u64)
            (*d).scan_ns = now_ns()
            if fontscan.family_count() != before || fin {
                after_scan_step(d)
            }
        }
        touch(d)
    }
    // the filter field
    let ft: str = app.text(a, (*d).nodes[NODE_FILTER])
    if !same(ft, view_of(&(*d).last_filter)) {
        set_buf(&(*d).last_filter, ft)
        refilter(d)
    }
    // the size field: digits only, 1 .. 999
    let st: str = app.text(a, (*d).nodes[NODE_SIZE])
    if !same(st, view_of(&(*d).last_size)) {
        var v: i64 = 0
        var digits: usize = 0
        var bad: bool = false
        var i: usize = 0
        while i < st.n {
            let ch: u8 = rt.ld8(st.p as u64, i)
            if ch >= 48 as u8 && ch <= 57 as u8 {
                if v < 100000 {
                    v = v * 10 + ((ch - 48 as u8) as i64)
                }
                digits = digits + 1
            } else {
                bad = true
            }
            i = i + 1
        }
        if digits == 0 {
            set_buf(&(*d).last_size, st)
            if st.n > 0 {
                // only junk typed: empty the field again
                app.set_text(a, (*d).nodes[NODE_SIZE], "")
                set_buf(&(*d).last_size, "")
            }
        } else {
            let cv: i32 = clamp_size(v)
            if bad || (cv as i64) != v || (st.n > 1 && rt.ld8(st.p as u64, 0) == 48 as u8) {
                set_size(d, v, true)
            } else {
                set_buf(&(*d).last_size, st)
                (*d).size = cv
                (*d).lv[DLG_SIZE].reveal = true
            }
        }
    }
    show_status(d)
    update_names(d)
}

// ------------------------------------------------------------ the sample font

// The font set for face `f`, loaded on first use; 0 = the system face (the
// face cannot be drawn, or its file cannot be read).
fn preview_font(d: *mut FontDlg, z: *mut painter.Painter, f: usize) -> u64 {
    (*d).prev_state = 0 as u32
    if f == NONE {
        (*d).prev_state = 2 as u32
        return 0
    }
    (*d).tick = (*d).tick + 1
    var i: usize = 0
    while i < 3 {
        if (*d).slots[i].fs != 0 && (*d).slots[i].face == f {
            (*d).slots[i].used = (*d).tick
            return (*d).slots[i].fs
        }
        i = i + 1
    }
    if !fontscan.face_drawable(f) {
        (*d).prev_state = 1 as u32
        return 0
    }
    // the oldest slot goes
    var k: usize = 0
    i = 1
    while i < 3 {
        if (*d).slots[i].used < (*d).slots[k].used {
            k = i
        }
        i = i + 1
    }
    if (*d).slots[k].fs != 0 {
        rt.buf_free(&(*d).slots[k].data)
        let fsz: usize = fdlg_size_of[metrics.FontSet]()
        rt.heap_free((*d).slots[k].fs, fsz)
        (*d).slots[k].fs = 0
        (*d).slots[k].face = NONE
        // the glyph cache and the shaping tables are keyed by the font set's
        // address, and the next one may get the same address
        fcache.fc_clear()
        (*z).gs_fm = 0
    }
    var path: rt.Buf = rt.buf_new()
    let ps: str = fontscan.face_path(f)
    rt.buf_push_bytes(&path, ps.p as u64, ps.n)
    rt.buf_push(&path, 0 as u8)
    var data: rt.Buf = rt.buf_new()
    let got: bool = rt.read_file(rt.buf_ptr(&path), &data)
    rt.buf_free(&path)
    if !got || rt.buf_len(&data) < 1024 {
        rt.buf_free(&data)
        (*d).prev_state = 2 as u32
        return 0
    }
    let fs: u64 = fdlg_alloc_of[metrics.FontSet]()
    if fs == 0 {
        rt.buf_free(&data)
        return 0
    }
    *(fs as *mut metrics.FontSet) = metrics.fontset_new()
    if !metrics.fontset_load(fs as *mut metrics.FontSet, rt.buf_ptr(&data) as *mut u8, rt.buf_len(&data)) {
        rt.buf_free(&data)
        let fsz2: usize = fdlg_size_of[metrics.FontSet]()
        rt.heap_free(fs, fsz2)
        (*d).prev_state = 1 as u32
        return 0
    }
    (*d).loads = (*d).loads + 1
    (*d).slots[k].data = data
    (*d).slots[k].fs = fs
    (*d).slots[k].face = f
    (*d).slots[k].used = (*d).tick
    return fs
}

// ------------------------------------------------------------ the painters

// Frame of a list or the sample box: field ground, border, focus ring.
fn paint_frame(c: *mut render.Ctx, z: *mut painter.Painter, e: *mut widget.Widget) {
    let m: *mut theme.Theme = render.ctx_theme(c)
    let fo: *mut theme.Shape = theme.theme_shape(m)
    let x: f64 = widget.w_x(e)
    let y: f64 = widget.w_y(e)
    let w: f64 = widget.w_w(e)
    let h: f64 = widget.w_h(e)
    let r: f64 = render.len_of(c, (*fo).r_field)
    painter.round_rect(z, x, y, w, h, r, theme.opaque(col(c, style.TOK_FIELD)))
    painter.round_ring(z, x, y, w, h, r, max_f(1.0, render.len_of(c, (*fo).border_w)), col(c, style.TOK_BORDER))
}

fn paint_focus(c: *mut render.Ctx, z: *mut painter.Painter, e: *mut widget.Widget) {
    if widget.w_is_focus(e) {
        render.draw_focus_ring(c, e)
    }
}

// The scroll position that keeps row `sel` in view.
fn reveal_top(top: f64, row_h: f64, view_h: f64, sel: usize) -> f64 {
    let y0: f64 = (sel as f64) * row_h
    let y1: f64 = y0 + row_h
    if y0 < top {
        return y0
    }
    if y1 > top + view_h {
        return y1 - view_h
    }
    return top
}

fn draw_list(ud: u64, c: *mut render.Ctx, e: *mut widget.Widget) {
    let lv: *mut ListView = ud as *mut ListView
    let d: *mut FontDlg = (*lv).dlg as *mut FontDlg
    sync(d)
    let z: *mut painter.Painter = render.ctx_painter(c)
    let cv: *mut canvas.Canvas = painter.painter_canvas(z)
    paint_frame(c, z, e)
    let which: usize = (*lv).which
    let x: f64 = widget.w_x(e)
    let y: f64 = widget.w_y(e)
    let w: f64 = widget.w_w(e)
    let h: f64 = widget.w_h(e)
    let inset: f64 = max_f(1.0, round_i(pt_px(c, 2.0)))
    let row_h: f64 = round_i(pt_px(c, ROW_PT))
    let bar_w: f64 = round_i(pt_px(c, 10.0))
    let ix: f64 = x + inset
    let iy: f64 = y + inset
    let iw: f64 = w - 2.0 * inset
    let ih: f64 = h - 2.0 * inset
    let n: usize = item_count(d, which)
    let content: f64 = (n as f64) * row_h
    var max_top: f64 = content - ih
    if max_top < 0.0 {
        max_top = 0.0
    }
    let sel: usize = sel_row(d, which)
    if (*lv).reveal {
        if sel != NONE && sel < n {
            if (*lv).center {
                (*lv).top = (sel as f64) * row_h - (ih - row_h) / 2.0
            } else {
                (*lv).top = reveal_top((*lv).top, row_h, ih, sel)
            }
        }
        (*lv).reveal = false
        (*lv).center = false
    }
    if (*lv).top > max_top {
        (*lv).top = max_top
    }
    if (*lv).top < 0.0 {
        (*lv).top = 0.0
    }
    (*lv).row_h = row_h
    (*lv).gx = x
    (*lv).gy = y
    (*lv).gw = w
    (*lv).gh = h
    (*lv).inset = inset
    (*lv).bar_w = bar_w
    (*lv).max_top = max_top
    (*lv).n = n
    let px: f64 = render.len_of(c, render.def_font(c))
    let pad: f64 = round_i(pt_px(c, 8.0))
    var tw: f64 = iw - 2.0 * pad
    if max_top > 0.0 {
        tw = tw - bar_w
    }
    if canvas.clip_push_rect(cv, ix, iy, ix + iw, iy + ih) {
        var first: usize = (((*lv).top / row_h) as i64) as usize
        var yy: f64 = iy + (first as f64) * row_h - (*lv).top
        var tmp: rt.Buf = rt.buf_new()
        while first < n && yy < iy + ih {
            let chosen: bool = first == sel
            let hot: bool = first == (*lv).hover
            var fg: u32 = col(c, style.TOK_TEXT)
            if chosen {
                painter.round_rect(z, ix, yy, iw, row_h, pt_px(c, 4.0), theme.opaque(col(c, style.TOK_SELECTION)))
                fg = col(c, style.TOK_SELECTION_TEXT)
            } else if hot {
                painter.round_rect(z, ix, yy, iw, row_h, pt_px(c, 4.0), theme.opaque(col(c, style.TOK_BUTTON_HOVER)))
            }
            let label: str = item_text(d, which, first, &tmp)
            var run: painter.TextRun = painter.run_new(px)
            let by: f64 = painter.text_baseline_mid(z, yy, row_h, px)
            let e1: f64 = painter.run_draw_ellipsis(z, &run, ix + pad, by, tw, fg, label.p as u64, label.n,
                painter.TEXT_L)
            first = first + 1
            yy = yy + row_h
        }
        rt.buf_free(&tmp)
        canvas.clip_pop(cv)
    }
    if max_top > 0.0 {
        var th: f64 = ih * ih / content
        let tmin: f64 = round_i(pt_px(c, 24.0))
        if th < tmin {
            th = tmin
        }
        let ty: f64 = iy + ((*lv).top / max_top) * (ih - th)
        var tc: u32 = painter.mix_argb(theme.opaque(col(c, style.TOK_FIELD)), theme.opaque(col(c, style.TOK_TEXT_MUTED)), 0.45)
        if (*lv).bar_hot || (*lv).drag {
            tc = painter.mix_argb(theme.opaque(col(c, style.TOK_FIELD)), theme.opaque(col(c, style.TOK_TEXT_MUTED)), 0.8)
        }
        let tw2: f64 = round_i(pt_px(c, 6.0))
        painter.round_rect(z, ix + iw - tw2 - 2.0, ty, tw2, th, tw2 / 2.0, theme.opaque(tc))
    }
    paint_focus(c, z, e)
}

// The sample text: the field's text, or the stock sample.
fn sample_text(d: *mut FontDlg) -> str {
    let t: str = app.text((*d).a, (*d).nodes[NODE_SAMPLE])
    if t.n == 0 {
        return SAMPLE_TEXT
    }
    return t
}

fn draw_preview(ud: u64, c: *mut render.Ctx, e: *mut widget.Widget) {
    let d: *mut FontDlg = ud as *mut FontDlg
    sync(d)
    let z: *mut painter.Painter = render.ctx_painter(c)
    let cv: *mut canvas.Canvas = painter.painter_canvas(z)
    paint_frame(c, z, e)
    let x: f64 = widget.w_x(e)
    let y: f64 = widget.w_y(e)
    let w: f64 = widget.w_w(e)
    let h: f64 = widget.w_h(e)
    let pad: f64 = round_i(pt_px(c, 12.0))
    var px: f64 = round_i(pt_px(c, (*d).size as f64 * 4.0 / 3.0))
    let cap: f64 = h - 2.0 * pad
    if px > cap {
        px = cap
    }
    if px < 4.0 {
        px = 4.0
    }
    let f: usize = face_id(d)
    let fm: u64 = preview_font(d, z, f)
    let old: u64 = painter.painter_font(z)
    if fm != 0 {
        painter.painter_set_font(z, fm)
    }
    var run: painter.TextRun = painter.run_new(px)
    var wb: bool = (*d).bold
    var wi: bool = (*d).italic
    if fm != 0 {
        // a real face carries its own weight and slant; only the missing ones are emulated
        wb = (*d).synth_b
        wi = (*d).synth_i
    }
    if wb {
        run = painter.run_set_weight(run, 700)
    }
    if wi {
        run = painter.run_set_slant(run, 1)
    }
    let txt: str = sample_text(d)
    let by: f64 = painter.text_baseline_mid(z, y, h, px)
    let fg: u32 = col(c, style.TOK_TEXT)
    if canvas.clip_push_rect(cv, x + pad / 2.0, y + 1.0, x + w - pad / 2.0, y + h - 1.0) {
        let x1: f64 = painter.run_draw(z, &run, x + pad, by, 0.0, fg, txt.p as u64, txt.n, painter.TEXT_L)
        let th: f64 = max_f(1.0, round_i(px / 14.0))
        if (*d).under {
            painter.surface(z, x + pad, by + max_f(1.0, round_i(px / 10.0)), x1 - (x + pad), th, fg)
        }
        if (*d).strike {
            let asc: f64 = painter.font_ascent(z, px)
            painter.surface(z, x + pad, by - round_i(asc * 0.32), x1 - (x + pad), th, fg)
        }
        canvas.clip_pop(cv)
    }
    painter.painter_set_font(z, old)
}

// ------------------------------------------------------------ keyboard

fn list_of_node(d: *mut FontDlg, n: usize) -> usize {
    if n == NONE {
        return NONE
    }
    var i: usize = 0
    while i < 3 {
        if (*d).lv[i].node == n {
            return i
        }
        i = i + 1
    }
    return NONE
}

// Move the chosen row of a list by `delta` rows (clamped); the keyboard calls it.
fn move_row(d: *mut FontDlg, which: usize, delta: i64) {
    let n: usize = item_count(d, which)
    if n == 0 {
        return
    }
    var cur: i64 = 0 - 1
    let s: usize = sel_row(d, which)
    if s != NONE {
        cur = s as i64
    }
    var to: i64 = cur + delta
    if delta >= BIG {
        to = (n as i64) - 1
    }
    if delta <= 0 - BIG {
        to = 0
    }
    if cur < 0 && delta > 0 && delta < BIG {
        to = delta - 1
    }
    if to < 0 {
        to = 0
    }
    if to > (n as i64) - 1 {
        to = (n as i64) - 1
    }
    if which == DLG_FAMILY {
        select_family_row(d, to as usize)
    } else if which == DLG_STYLE {
        select_face(d, to as usize, true)
    } else {
        set_size(d, SIZES[to as usize] as i64, true)
    }
    (*d).lv[which].reveal = true
    touch(d)
}

fn page_rows(d: *mut FontDlg, which: usize) -> i64 {
    let l: *mut ListView = &(*d).lv[which]
    if (*l).row_h <= 0.0 {
        return 8
    }
    let r: i64 = (((*l).gh - 2.0 * (*l).inset) / (*l).row_h) as i64 - 1
    if r < 1 {
        return 1
    }
    return r
}

fn nav_delta(d: *mut FontDlg, which: usize, key: u32) -> i64 {
    if key == editor.KEY_UP {
        return 0 - 1
    }
    if key == editor.KEY_DOWN {
        return 1
    }
    if key == editor.KEY_PGUP {
        return 0 - page_rows(d, which)
    }
    if key == editor.KEY_PGDN {
        return page_rows(d, which)
    }
    if key == editor.KEY_HOME {
        return 0 - BIG
    }
    if key == editor.KEY_END {
        return BIG
    }
    return 0
}

fn finish(d: *mut FontDlg, code: i32) {
    if (*d).result >= 0 {
        return
    }
    (*d).result = code
    app.quit((*d).a)
}

fn do_ok(d: *mut FontDlg) {
    sync(d)
    if (*d).fam == NONE {
        return
    }
    set_buf(&(*d).out_fam, fontscan.family_name((*d).fam))
    finish(d, 0)
}

// Lower-case a byte for the type-ahead match.
fn low(c: u8) -> u8 {
    if c >= 65 as u8 && c <= 90 as u8 {
        return c + 32 as u8
    }
    return c
}

fn starts_with(s: str, p: *mut [u8; 40], n: usize) -> bool {
    if s.n < n {
        return false
    }
    var i: usize = 0
    while i < n {
        if low(rt.ld8(s.p as u64, i)) != low((*p)[i]) {
            return false
        }
        i = i + 1
    }
    return true
}

// A typed character in a list: jump to the first row that starts with what
// was typed within the last second.
fn typeahead(d: *mut FontDlg, which: usize, cp: u32) {
    if cp >= 128 as u32 {
        return
    }
    let now: u64 = now_ns()
    if now - (*d).ta_ns > 1000000000 as u64 {
        (*d).ta_n = 0
    }
    (*d).ta_ns = now
    if (*d).ta_n < 39 {
        (*d).ta[(*d).ta_n] = cp as u8
        (*d).ta_n = (*d).ta_n + 1
    }
    var tmp: rt.Buf = rt.buf_new()
    let n: usize = item_count(d, which)
    var i: usize = 0
    var hit: usize = NONE
    while i < n && hit == NONE {
        if starts_with(item_text(d, which, i, &tmp), &(*d).ta, (*d).ta_n) {
            hit = i
        }
        i = i + 1
    }
    rt.buf_free(&tmp)
    if hit == NONE {
        return
    }
    if which == DLG_FAMILY {
        select_family_row(d, hit)
    } else if which == DLG_STYLE {
        select_face(d, hit, true)
    } else {
        set_size(d, SIZES[hit] as i64, true)
    }
    (*d).lv[which].reveal = true
    touch(d)
}

fn dlg_of(ud: u64) -> *mut FontDlg {
    let a: *mut app.App = ud as *mut app.App
    return app.data(a) as *mut FontDlg
}

// The key hook of the window (`ud` is the app.App, as for app.app_key).
// true = the dialog used the key.
fn dlg_key(ud: u64, key: u32, mods: u32) -> bool {
    let a: *mut app.App = ud as *mut app.App
    let d: *mut FontDlg = dlg_of(ud)
    if d as u64 == 0 {
        return app.app_key(ud, key, mods)
    }
    let f: usize = app.focus(a)
    if key == editor.KEY_ESC {
        finish(d, 1)
        return true
    }
    if key == editor.KEY_ENTER {
        if f == (*d).nodes[NODE_CANCEL] {
            return false
        }
        do_ok(d)
        return true
    }
    let wl: usize = list_of_node(d, f)
    if wl != NONE {
        let dl: i64 = nav_delta(d, wl, key)
        if dl != 0 {
            move_row(d, wl, dl)
            return true
        }
    }
    if f == (*d).nodes[NODE_FILTER] {
        let dl2: i64 = nav_delta(d, DLG_FAMILY, key)
        if dl2 != 0 && key != editor.KEY_HOME && key != editor.KEY_END {
            move_row(d, DLG_FAMILY, dl2)
            return true
        }
    }
    if f == (*d).nodes[NODE_SIZE] {
        if key == editor.KEY_UP {
            set_size(d, ((*d).size as i64) + 1, true)
            return true
        }
        if key == editor.KEY_DOWN {
            set_size(d, ((*d).size as i64) - 1, true)
            return true
        }
    }
    return app.app_key(ud, key, mods)
}

// The character hook: a printable character with a list focused is type-ahead.
fn dlg_char(ud: u64, cp: u32, mods: u32) -> bool {
    let a: *mut app.App = ud as *mut app.App
    let d: *mut FontDlg = dlg_of(ud)
    if d as u64 == 0 {
        return app.app_char(ud, cp, mods)
    }
    let wl: usize = list_of_node(d, app.focus(a))
    if wl != NONE && cp >= 32 as u32 && (mods & (editor.MOD_CTRL | editor.MOD_ALT)) == 0 as u32 {
        typeahead(d, wl, cp)
        return true
    }
    return app.app_char(ud, cp, mods)
}

// ------------------------------------------------------------ the mouse

fn in_rect(x: f64, y: f64, rx: f64, ry: f64, rw: f64, rh: f64) -> bool {
    return x >= rx && x < rx + rw && y >= ry && y < ry + rh
}

// The row of list `which` at window position (x, y); NONE if none.
fn row_at(d: *mut FontDlg, which: usize, x: f64, y: f64) -> usize {
    let l: *mut ListView = &(*d).lv[which]
    if (*l).row_h <= 0.0 {
        return NONE
    }
    let iy: f64 = (*l).gy + (*l).inset
    if !in_rect(x, y, (*l).gx + (*l).inset, iy, (*l).gw - 2.0 * (*l).inset, (*l).gh - 2.0 * (*l).inset) {
        return NONE
    }
    let r: usize = (((y - iy + (*l).top) / (*l).row_h) as i64) as usize
    if r >= (*l).n {
        return NONE
    }
    return r
}

// The scroll bar zone (right edge) of a list that overflows.
fn on_bar(d: *mut FontDlg, which: usize, x: f64, y: f64) -> bool {
    let l: *mut ListView = &(*d).lv[which]
    if (*l).max_top <= 0.0 {
        return false
    }
    return in_rect(x, y, (*l).gx + (*l).gw - (*l).inset - (*l).bar_w, (*l).gy + (*l).inset, (*l).bar_w,
        (*l).gh - 2.0 * (*l).inset)
}

fn thumb_geometry(l: *mut ListView, ty: *mut f64, th: *mut f64) {
    let ih: f64 = (*l).gh - 2.0 * (*l).inset
    let content: f64 = (*l).row_h * ((*l).n as f64)
    var t: f64 = ih * ih / content
    if t < (*l).row_h {
        t = (*l).row_h
    }
    *th = t
    *ty = (*l).gy + (*l).inset + ((*l).top / (*l).max_top) * (ih - t)
}

fn scroll_by(d: *mut FontDlg, which: usize, dy: f64) {
    let l: *mut ListView = &(*d).lv[which]
    var t: f64 = (*l).top + dy
    if t > (*l).max_top {
        t = (*l).max_top
    }
    if t < 0.0 {
        t = 0.0
    }
    (*l).top = t
}

fn list_under(d: *mut FontDlg, x: f64, y: f64) -> usize {
    var i: usize = 0
    while i < 3 {
        let l: *mut ListView = &(*d).lv[i]
        if (*l).row_h > 0.0 && in_rect(x, y, (*l).gx, (*l).gy, (*l).gw, (*l).gh) {
            return i
        }
        i = i + 1
    }
    return NONE
}

fn pick_row(d: *mut FontDlg, which: usize, r: usize) {
    if which == DLG_FAMILY {
        select_family_row(d, r)
    } else if which == DLG_STYLE {
        select_face(d, r, true)
    } else {
        set_size(d, SIZES[r] as i64, true)
    }
}

// The row under the pointer in every list, a thumb being dragged, the bar's
// hot state. true = something changed.
fn hover_update(d: *mut FontDlg, x: f64, y: f64) -> bool {
    var changed: bool = false
    var i2: usize = 0
    while i2 < 3 {
        let l: *mut ListView = &(*d).lv[i2]
        if (*l).drag {
            var ty: f64 = 0.0
            var th: f64 = 0.0
            thumb_geometry(l, &ty, &th)
            let ih: f64 = (*l).gh - 2.0 * (*l).inset
            var f: f64 = (y - (*l).drag_dy - ((*l).gy + (*l).inset)) / (ih - th)
            if f < 0.0 {
                f = 0.0
            }
            if f > 1.0 {
                f = 1.0
            }
            (*l).top = f * (*l).max_top
            changed = true
        } else {
            var hv: usize = row_at(d, i2, x, y)
            let bar: bool = on_bar(d, i2, x, y)
            if bar {
                hv = NONE
            }
            if hv != (*l).hover || bar != (*l).bar_hot {
                (*l).hover = hv
                (*l).bar_hot = bar
                changed = true
            }
        }
        i2 = i2 + 1
    }
    return changed
}

// The pointer hook (installed over app.app_hook's; it hands on what it does
// not use). kind: fuiwirt.HOOK_*. true = paint again.
fn dlg_hook(ud: u64, kind: u32, x: f64, y: f64) -> bool {
    let d: *mut FontDlg = ud as *mut FontDlg
    let a: *mut app.App = (*d).a
    var changed: bool = false
    if kind == fuiwirt.HOOK_WHEEL {
        let w: usize = list_under(d, (*d).px, (*d).py)
        if w != NONE {
            scroll_by(d, w, y * 3.0 * (*d).lv[w].row_h)
            let hv: bool = hover_update(d, (*d).px, (*d).py)
            touch(d)
            return true
        }
        return app.app_hook(a as u64, kind, x, y)
    }
    if kind == fuiwirt.HOOK_LEAVE {
        var i: usize = 0
        while i < 3 {
            if (*d).lv[i].hover != NONE || (*d).lv[i].bar_hot {
                changed = true
            }
            (*d).lv[i].hover = NONE
            (*d).lv[i].bar_hot = false
            i = i + 1
        }
    } else {
        (*d).px = x
        (*d).py = y
    }
    if kind == fuiwirt.HOOK_MOVE {
        if hover_update(d, x, y) {
            changed = true
        }
    }
    if kind == fuiwirt.HOOK_DOWN {
        let w2: usize = list_under(d, x, y)
        if w2 != NONE {
            let l2: *mut ListView = &(*d).lv[w2]
            if on_bar(d, w2, x, y) {
                var ty2: f64 = 0.0
                var th2: f64 = 0.0
                thumb_geometry(l2, &ty2, &th2)
                if y >= ty2 && y < ty2 + th2 {
                    (*l2).drag = true
                    (*l2).drag_dy = y - ty2
                } else if y < ty2 {
                    scroll_by(d, w2, 0.0 - ((*l2).gh - 2.0 * (*l2).inset))
                } else {
                    scroll_by(d, w2, (*l2).gh - 2.0 * (*l2).inset)
                }
                changed = true
            } else {
                let r: usize = row_at(d, w2, x, y)
                if r != NONE {
                    pick_row(d, w2, r)
                    changed = true
                }
            }
        }
    }
    if kind == fuiwirt.HOOK_UP {
        var i3: usize = 0
        while i3 < 3 {
            if (*d).lv[i3].drag {
                (*d).lv[i3].drag = false
                changed = true
            }
            i3 = i3 + 1
        }
    }
    let base: bool = app.app_hook(a as u64, kind, x, y)
    if changed {
        touch(d)
    }
    return changed || base
}

// ------------------------------------------------------------ the buttons

fn cb_ok(a: *mut app.App) {
    do_ok(app.data(a) as *mut FontDlg)
}

fn cb_cancel(a: *mut app.App) {
    finish(app.data(a) as *mut FontDlg, 1)
}

fn checked(d: *mut FontDlg, role: usize) -> bool {
    let n: usize = (*d).nodes[role]
    if n == NONE {
        return false
    }
    return widget.w_value(scene.node_widget(app.app_scene((*d).a), n)) != 0
}

// A tick was clicked: the wish changes, the face follows when there is one.
fn cb_check(a: *mut app.App) {
    let d: *mut FontDlg = app.data(a) as *mut FontDlg
    let b: bool = checked(d, NODE_BOLD)
    let i: bool = checked(d, NODE_ITALIC)
    let changed: bool = b != (*d).bold || i != (*d).italic
    (*d).bold = b
    (*d).italic = i
    (*d).under = checked(d, NODE_UNDERLINE)
    (*d).strike = checked(d, NODE_STRIKE)
    if changed && (*d).fam != NONE {
        let j: usize = fontscan.pick_face((*d).fam, b, i)
        if j != NONE {
            select_face(d, j, false)
        }
    }
    compute_synth(d)
    touch(d)
}

// ------------------------------------------------------------ building

fn name_node(d: *mut FontDlg, n: usize, s: str) {
    if n == NONE {
        return
    }
    a11y.a11y_set_name(&(*(*d).a).ax, n, s.p as u64, s.n)
}

// A list: one focusable node with its own painter.
fn make_list(d: *mut FontDlg, parent: usize, which: usize, w: f64, h: f64, name: str) -> usize {
    let sc: *mut scene.Scene = app.app_scene((*d).a)
    let n: usize = scene.scene_add(sc, parent, scene.N_WIDGET)
    if n == scene.SCENE_NONE {
        return NONE
    }
    scene.node_set_widget_kind(sc, n, widget.KIND_LIST)
    scene.node_set_size(sc, n, w, h)
    scene.node_set_draw(sc, n, (&(*d).lv[which]) as u64, draw_list)
    (*d).lv[which].node = n
    name_node(d, n, name)
    return n
}

// Put the left-aligned look on a container the app made.
fn set_box(d: *mut FontDlg, n: usize, dir: u32, justify: u32, align: u32) {
    scene.node_set_flex(app.app_scene((*d).a), n, dir, justify, align)
}

// Build the dialog into the current container of `a`. `family` and `size`
// are what the dialog starts with (a family that is not installed leaves the
// first row chosen). Installs the key and pointer hooks.
fn build(a: *mut app.App, d: *mut FontDlg, family: str, size: i32) {
    (*d).a = a
    app.set_data(a, d as u64)
    set_buf(&(*d).init_fam, family)
    (*d).size = clamp_size(size as i64)
    let sc: *mut scene.Scene = app.app_scene(a)
    let root: usize = app.root(a)
    set_box(d, root, flex.FLEX_COLUMN, flex.JUSTIFY_START, flex.AL_START)
    scene.node_set_gap(sc, root, 12, 12)
    scene.node_set_padding(sc, root, 16, 16, 16, 16)

    // the three columns
    let top: usize = app.row(a)
    set_box(d, top, flex.FLEX_ROW, flex.JUSTIFY_START, flex.AL_START)
    scene.node_set_gap(sc, top, 12, 12)
    let c1: usize = app.column(a)
    set_box(d, c1, flex.FLEX_COLUMN, flex.JUSTIFY_START, flex.AL_START)
    scene.node_set_gap(sc, c1, 4, 4)
    app.label(a, tr_family(), 0)
    let ef: usize = app.entry(a, tr_filter_hint())
    scene.node_set_size(sc, ef, FAM_W, 0.0)
    (*d).nodes[NODE_FILTER] = ef
    (*d).nodes[NODE_LIST_FAMILY] = make_list(d, c1, DLG_FAMILY, FAM_W, LIST_H, tr_family_list())
    app.end(a)
    let c2: usize = app.column(a)
    set_box(d, c2, flex.FLEX_COLUMN, flex.JUSTIFY_START, flex.AL_START)
    scene.node_set_gap(sc, c2, 4, 4)
    app.label(a, tr_style(), 0)
    app.spacer(a, 1, 32)
    (*d).nodes[NODE_LIST_STYLE] = make_list(d, c2, DLG_STYLE, STY_W, LIST_H, tr_style_list())
    app.end(a)
    let c3: usize = app.column(a)
    set_box(d, c3, flex.FLEX_COLUMN, flex.JUSTIFY_START, flex.AL_START)
    scene.node_set_gap(sc, c3, 4, 4)
    app.label(a, tr_size(), 0)
    let es: usize = app.entry(a, tr_size_hint())
    scene.node_set_size(sc, es, SIZ_W, 0.0)
    (*d).nodes[NODE_SIZE] = es
    (*d).nodes[NODE_LIST_SIZE] = make_list(d, c3, DLG_SIZE, SIZ_W, LIST_H, tr_size_list())
    app.end(a)
    app.end(a)

    // the four ticks
    let ticks: usize = app.row(a)
    set_box(d, ticks, flex.FLEX_ROW, flex.JUSTIFY_START, flex.AL_CENTER)
    scene.node_set_gap(sc, ticks, 20, 20)
    (*d).nodes[NODE_BOLD] = app.button(a, tr_bold(), cb_check)
    (*d).nodes[NODE_ITALIC] = app.button(a, tr_italic(), cb_check)
    (*d).nodes[NODE_UNDERLINE] = app.button(a, tr_underline(), cb_check)
    (*d).nodes[NODE_STRIKE] = app.button(a, tr_strike(), cb_check)
    var k: usize = NODE_BOLD
    while k <= NODE_STRIKE {
        scene.node_set_widget_kind(sc, (*d).nodes[k], widget.KIND_CHECKBOX)
        k = k + 1
    }
    app.end(a)

    // the sample
    let pcol: usize = app.column(a)
    set_box(d, pcol, flex.FLEX_COLUMN, flex.JUSTIFY_START, flex.AL_START)
    scene.node_set_gap(sc, pcol, 4, 4)
    app.label(a, tr_sample(), 0)
    let pv: usize = scene.scene_add(sc, pcol, scene.N_WIDGET)
    scene.node_set_widget_kind(sc, pv, widget.KIND_LABEL)
    scene.node_set_size(sc, pv, FAM_W + STY_W + SIZ_W + 24.0, PREV_H)
    scene.node_set_draw(sc, pv, d as u64, draw_preview)
    (*d).nodes[NODE_PREVIEW] = pv
    name_node(d, pv, tr_preview())
    let et: usize = app.entry(a, tr_sample_hint())
    scene.node_set_size(sc, et, FAM_W + STY_W + SIZ_W + 24.0, 0.0)
    app.set_text(a, et, SAMPLE_TEXT)
    (*d).nodes[NODE_SAMPLE] = et
    let st: usize = app.label(a, "", 0)
    (*d).nodes[NODE_STATUS] = st
    app.end(a)

    // the buttons
    let bar: usize = app.row(a)
    set_box(d, bar, flex.FLEX_ROW, flex.JUSTIFY_END, flex.AL_CENTER)
    scene.node_set_gap(sc, bar, 8, 8)
    scene.node_set_size(sc, bar, FAM_W + STY_W + SIZ_W + 24.0, 0.0)
    (*d).nodes[NODE_OK] = app.button(a, tr_ok(), cb_ok)
    (*d).nodes[NODE_CANCEL] = app.button(a, tr_cancel(), cb_cancel)
    app.end(a)

    // the hooks
    (*a).hk.key = dlg_key
    (*a).hk.text = dlg_char
    fuiwirt.host_set_hook(app.app_host(a), d as u64, dlg_hook)

    // the fields, the walk, the first choice
    app.set_text(a, es, "")
    var t: rt.Buf = rt.buf_new()
    dec_str((*d).size as i64, &t)
    app.set_text(a, es, view_of(&t))
    set_buf(&(*d).last_size, view_of(&t))
    rt.buf_free(&t)
    let done: bool = fontscan.step(FIRST_SLICE)
    after_scan_step(d)
    sync_checks(d)
    set_ok_enabled(d)
    reveal_all(d)
    show_status(d)
}

// The answer, after the dialog is done: 0 = chosen (family and pick filled),
// 1 = cancelled / not done.
fn dlg_result(d: *mut FontDlg, out_family: *mut rt.Buf, out: *mut FontPick) -> i32 {
    if (*d).result != 0 {
        return 1
    }
    rt.buf_clear(out_family)
    rt.buf_push_bytes(out_family, rt.buf_ptr(&(*d).out_fam), rt.buf_len(&(*d).out_fam))
    (*out).size = (*d).size
    (*out).bold = (*d).bold
    (*out).italic = (*d).italic
    (*out).underline = (*d).under
    (*out).strike = (*d).strike
    return 0
}

// Change the first walk slice of `build` (the default is 120 ms; a test uses a
// tiny one to see the "Scanning" state).
fn set_first_slice(ms: u64) {
    FIRST_SLICE = ms
}

// The status text (for tests): what the line says now.
fn dlg_status(d: *mut FontDlg) -> str {
    return view_of(&(*d).last_status)
}

// Set the family by name from code (a test or a caller). false = not installed.
fn dlg_set_family(d: *mut FontDlg, name: str) -> bool {
    let f: usize = fontscan.find_family(name)
    if f == NONE {
        return false
    }
    if fam_row(d) == NONE {
        set_buf(&(*d).last_filter, "")
        app.set_text((*d).a, (*d).nodes[NODE_FILTER], "")
        refilter(d)
    }
    select_family(d, f)
    reveal_all(d)
    return true
}

fn dlg_set_size(d: *mut FontDlg, v: i32) {
    set_size(d, v as i64, true)
}

// THE WINDOW: opens its own, blocks until the user is done.
// 0 = chosen, 1 = cancelled / closed, 12 = no window possible.
fn run(title: str, family: str, size: i32, out_family: *mut rt.Buf, out: *mut FontPick) -> i32 {
    let a: *mut app.App = app.window(title, WIN_W, WIN_H)
    if a as u64 == 0 {
        return 12
    }
    let d: *mut FontDlg = dlg_new()
    if d as u64 == 0 {
        return 12
    }
    build(a, d, family, size)
    let rc: i32 = app.run(a)
    if envvar.env_has("FUI_AUDIT") {
        return rc
    }
    if rc != 0 {
        return 12
    }
    return dlg_result(d, out_family, out)
}
