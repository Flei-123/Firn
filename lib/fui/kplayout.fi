// SPDX-License-Identifier: MPL-2.0
export {
    Rect, Layout, lay_new, lay_compute, lay_hit, rect_has, bar_permille, fit_rect,
    HIT_NONE, HIT_SURFACE, HIT_BAR, HIT_PLAY, HIT_SEEK, HIT_MUTE, HIT_VOL,
}

const HIT_NONE: u32 = 0
const HIT_SURFACE: u32 = 1
const HIT_BAR: u32 = 2
const HIT_PLAY: u32 = 3
const HIT_SEEK: u32 = 4
const HIT_MUTE: u32 = 5
const HIT_VOL: u32 = 6

struct Rect {
    x: f64,
    y: f64,
    w: f64,
    h: f64,
}

struct Layout {
    all: Rect,
    surface: Rect,
    bar: Rect,
    play: Rect,
    cur: Rect,
    seek: Rect,
    dur: Rect,
    mute: Rect,
    vol: Rect,
    has_vol: bool,
    scale: f64,
}

fn rect_zero() -> Rect {
    return Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 }
}

fn lay_new() -> Layout {
    return Layout { all: rect_zero(), surface: rect_zero(), bar: rect_zero(), play: rect_zero(), cur: rect_zero(),
        seek: rect_zero(), dur: rect_zero(), mute: rect_zero(), vol: rect_zero(), has_vol: false, scale: 1.0 }
}

fn rect_has(r: *mut Rect, px: f64, py: f64) -> bool {
    return px >= (*r).x && px < (*r).x + (*r).w && py >= (*r).y && py < (*r).y + (*r).h
}

fn lay_compute(l: *mut Layout, x: f64, y: f64, w: f64, h: f64, scale: f64) {
    let s: f64 = scale
    var bh: f64 = 52.0 * s
    if bh > h {
        bh = h
    }
    let by: f64 = y + h - bh
    (*l).scale = s
    (*l).all = Rect { x: x, y: y, w: w, h: h }
    (*l).surface = Rect { x: x, y: y, w: w, h: h - bh }
    (*l).bar = Rect { x: x, y: by, w: w, h: bh }
    let pad: f64 = 12.0 * s
    let gap: f64 = 6.0 * s
    let btn: f64 = 36.0 * s
    let tw: f64 = 52.0 * s
    let rowh: f64 = 24.0 * s
    var lx: f64 = x + pad
    (*l).play = Rect { x: lx, y: by + (bh - btn) / 2.0, w: btn, h: btn }
    lx = lx + btn + gap
    (*l).cur = Rect { x: lx, y: by, w: tw, h: bh }
    lx = lx + tw + gap
    var rx: f64 = x + w - pad
    (*l).has_vol = w >= 480.0 * s
    if (*l).has_vol {
        let vw: f64 = 84.0 * s
        (*l).vol = Rect { x: rx - vw, y: by + (bh - rowh) / 2.0, w: vw, h: rowh }
        rx = rx - vw - gap
    } else {
        (*l).vol = rect_zero()
    }
    let mw: f64 = 32.0 * s
    (*l).mute = Rect { x: rx - mw, y: by + (bh - mw) / 2.0, w: mw, h: mw }
    rx = rx - mw - gap
    (*l).dur = Rect { x: rx - tw, y: by, w: tw, h: bh }
    rx = rx - tw - gap
    var sw: f64 = rx - lx
    if sw < 0.0 {
        sw = 0.0
    }
    (*l).seek = Rect { x: lx, y: by + (bh - rowh) / 2.0, w: sw, h: rowh }
}

fn lay_hit(l: *mut Layout, px: f64, py: f64) -> u32 {
    if rect_has(&(*l).play, px, py) {
        return HIT_PLAY
    }
    if rect_has(&(*l).mute, px, py) {
        return HIT_MUTE
    }
    if (*l).has_vol && rect_has(&(*l).vol, px, py) {
        return HIT_VOL
    }
    if rect_has(&(*l).seek, px, py) {
        return HIT_SEEK
    }
    if rect_has(&(*l).bar, px, py) {
        return HIT_BAR
    }
    if rect_has(&(*l).surface, px, py) {
        return HIT_SURFACE
    }
    return HIT_NONE
}

fn bar_permille(l: *mut Layout, r: *mut Rect, px: f64) -> i64 {
    let inset: f64 = 8.0 * (*l).scale
    let span: f64 = (*r).w - 2.0 * inset
    if span <= 0.0 {
        return 0
    }
    var v: f64 = (px - ((*r).x + inset)) / span * 1000.0
    if v < 0.0 {
        v = 0.0
    }
    if v > 1000.0 {
        v = 1000.0
    }
    return (v + 0.5) as i64
}

fn fit_rect(vw: f64, vh: f64, area: *mut Rect, out: *mut Rect) {
    if vw <= 0.0 || vh <= 0.0 || (*area).w <= 0.0 || (*area).h <= 0.0 {
        *out = Rect { x: (*area).x, y: (*area).y, w: 0.0, h: 0.0 }
        return
    }
    var w: f64 = (*area).w
    var h: f64 = w * vh / vw
    if h > (*area).h {
        h = (*area).h
        w = h * vw / vh
    }
    *out = Rect { x: (*area).x + ((*area).w - w) / 2.0, y: (*area).y + ((*area).h - h) / 2.0, w: w, h: h }
}
