import fui.kit
import fui.kitapp
import fui.kitdata
import fui.kitform
import fui.render
import fui.style

const NONE: usize = 18446744073709551615

#[allow_escape]
fn field_text(d: *mut kitdata.Doc, item: u32, key: str, buf: *mut [u8; 24]) -> str {
    if key.n == 0 { return "" }
    let node: u32 = kitdata.get(d, item, key)
    let t: str = kitdata.text(d, node)
    if t.n > 0 { return t }
    let v: i64 = kitdata.num(d, node)
    if v <= 0 { return "" }
    let n: usize = kit.fmt_uint(v as u64, buf)
    return str { p: ((&(*buf)[0]) as u64) as *mut u8, n: n }
}

fn row_height(c: *mut render.Ctx, d: *mut kitdata.Doc, item: u32, keys: str) -> f64 {
    var buf: [u8; 24] = [0 as u8; 24]
    if field_text(d, item, kitform.nth(keys, 1), &buf).n > 0 { return kit.ln(c, 68) }
    return kit.ln(c, 58)
}

fn height(c: *mut render.Ctx, d: *mut kitdata.Doc, list: u32, keys: str) -> f64 {
    var y: f64 = 0.0
    var i: usize = 0
    while i < kitdata.count(d, list) {
        y = y + row_height(c, d, kitdata.at(d, list, i), keys) + kit.ln(c, 10)
        i = i + 1
    }
    return y
}

fn cards(c: *mut render.Ctx, d: *mut kitdata.Doc, list: u32, keys: str, x: f64, y: f64, w: f64, px: f64, py: f64) -> usize {
    var hot: usize = NONE
    var yy: f64 = y
    var i: usize = 0
    while i < kitdata.count(d, list) {
        let item: u32 = kitdata.at(d, list, i)
        let h: f64 = row_height(c, d, item, keys)
        let over: bool = px >= x && px < x + w && py >= yy && py < yy + h
        if over { hot = i }
        kitapp.card_draw(c, x, yy, w, h, over)
        var b0: [u8; 24] = [0 as u8; 24]
        var b1: [u8; 24] = [0 as u8; 24]
        var b2: [u8; 24] = [0 as u8; 24]
        let title: str = field_text(d, item, kitform.nth(keys, 0), &b0)
        let sub: str = field_text(d, item, kitform.nth(keys, 1), &b1)
        let meta: str = field_text(d, item, kitform.nth(keys, 2), &b2)
        var ty: f64 = yy + h / 2.0 - kit.ln(c, 9)
        if sub.n > 0 {
            ty = yy + h / 2.0 - kit.ln(c, 18)
            kitapp.text(c, x + kit.ln(c, 20), yy + h / 2.0 + kit.ln(c, 1), kit.ln(c, 16), 12, 400, style.TOK_TEXT_MUTED, sub)
        }
        kitapp.text(c, x + kit.ln(c, 20), ty, kit.ln(c, 18), 14, 400, style.TOK_TEXT, title)
        if meta.n > 0 {
            let mw: f64 = kit.text_width(c, kit.ln(c, 12), 400, meta)
            kitapp.text(c, x + w - kit.ln(c, 20) - mw, yy + h / 2.0 - kit.ln(c, 8), kit.ln(c, 16), 12, 400, style.TOK_TEXT_MUTED, meta)
        }
        yy = yy + h + kit.ln(c, 10)
        i = i + 1
    }
    return hot
}

fn hit(c: *mut render.Ctx, d: *mut kitdata.Doc, list: u32, keys: str, x: f64, y: f64, w: f64, px: f64, py: f64) -> usize {
    var yy: f64 = y
    var i: usize = 0
    while i < kitdata.count(d, list) {
        let h: f64 = row_height(c, d, kitdata.at(d, list, i), keys)
        if px >= x && px < x + w && py >= yy && py < yy + h { return i }
        yy = yy + h + kit.ln(c, 10)
        i = i + 1
    }
    return NONE
}
