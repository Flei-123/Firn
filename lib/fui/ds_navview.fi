import fui.ds_catalog_tok
import fui.editor
import fui.kit
import fui.lucide
import fui.painter
import fui.render
import fui.screenax
import fui.sizeclass
import fui.widget

export {
    NavView, nv_new, add, add_header, add_footer, set_badge, select, selected, item_count, label_at, set_back, layout,
    draw, draw_overlay, press, key, hover_at, mode, overlay_open, close_overlay, content_x, content_y, content_w, content_h,
    pane_w, pane_rect, is_footer, MODE_EXPANDED, MODE_COMPACT, MODE_MINIMAL,
    EV_NONE, EV_SELECT, EV_BACK, EV_TOGGLE, EV_DISMISS, NONE,
}

const NONE: usize = 18446744073709551615
const MAX_BODY: usize = 12
const MAX_FOOT: usize = 4

const MODE_EXPANDED: u32 = 0
const MODE_COMPACT: u32 = 1
const MODE_MINIMAL: u32 = 2

const EV_NONE: u32 = 0
const EV_SELECT: u32 = 1
const EV_BACK: u32 = 2
const EV_TOGGLE: u32 = 3
const EV_DISMISS: u32 = 4

const REG_NONE: u32 = 0
const REG_TOP: u32 = 1
const REG_BODY: u32 = 2
const REG_FOOT: u32 = 3
const REG_BAR_BACK: u32 = 4
const REG_BAR_MENU: u32 = 5
const REG_SCRIM: u32 = 6

const LINE_COMPACT: i64 = 641
const LINE_EXPANDED: i64 = 1008

struct NavView {
    items: [kit.NavItem; 12],
    n: usize,
    foot: [kit.NavItem; 4],
    nf: usize,
    top: [kit.NavItem; 2],
    nt: usize,
    sel: usize,
    hov_reg: u32,
    hov_idx: usize,
    tracker: sizeclass.Tracker,
    mode: u32,
    user_compact: bool,
    overlay: bool,
    back: bool,
    foc: bool,
    kbd: bool,
    ctx: u64,
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    pw: f64,
    cx: f64,
    cy: f64,
    cw: f64,
    chh: f64,
}

fn blank() -> kit.NavItem {
    return kit.NavItem { icon: kit.ICON_NONE, label: "", badge: 0, header: false }
}

fn nv_new() -> NavView {
    var t: sizeclass.Tracker = sizeclass.tracker_new()
    sizeclass.set_lines(&t, LINE_COMPACT, LINE_EXPANDED)
    return NavView { items: [blank(); 12], n: 0, foot: [blank(); 4], nf: 0, top: [blank(); 2], nt: 0, sel: NONE,
        hov_reg: REG_NONE, hov_idx: NONE, tracker: t, mode: MODE_EXPANDED, user_compact: false, overlay: false, back: false,
        foc: false, kbd: false, ctx: 0 as u64, x: 0.0, y: 0.0, w: 0.0, h: 0.0, pw: 0.0, cx: 0.0, cy: 0.0, cw: 0.0, chh: 0.0 }
}

fn body_ptr(v: *mut NavView) -> *mut kit.NavItem { return &(*v).items[0] }
fn foot_ptr(v: *mut NavView) -> *mut kit.NavItem { return &(*v).foot[0] }
fn top_ptr(v: *mut NavView) -> *mut kit.NavItem { return &(*v).top[0] }

fn add(v: *mut NavView, icon: i64, label: str) -> usize {
    if (*v).n >= MAX_BODY { return NONE }
    (*v).items[(*v).n] = kit.NavItem { icon: icon, label: label, badge: 0, header: false }
    (*v).n = (*v).n + 1
    if (*v).sel == NONE { (*v).sel = (*v).n - 1 }
    return (*v).n - 1
}

fn add_header(v: *mut NavView, label: str) -> usize {
    if (*v).n >= MAX_BODY { return NONE }
    (*v).items[(*v).n] = kit.NavItem { icon: kit.ICON_NONE, label: label, badge: 0, header: true }
    (*v).n = (*v).n + 1
    return (*v).n - 1
}

fn add_footer(v: *mut NavView, icon: i64, label: str) -> usize {
    if (*v).nf >= MAX_FOOT { return NONE }
    (*v).foot[(*v).nf] = kit.NavItem { icon: icon, label: label, badge: 0, header: false }
    (*v).nf = (*v).nf + 1
    return (*v).n + (*v).nf - 1
}

fn item_count(v: *mut NavView) -> usize { return (*v).n + (*v).nf }

fn item_at(v: *mut NavView, u: usize) -> *mut kit.NavItem {
    if u < (*v).n { return kit.nav_at(body_ptr(v), u) }
    return kit.nav_at(foot_ptr(v), u - (*v).n)
}

fn label_at(v: *mut NavView, u: usize) -> str {
    if u >= (*v).n + (*v).nf { return "" }
    return (*item_at(v, u)).label
}

fn set_badge(v: *mut NavView, u: usize, n: usize) {
    if u >= (*v).n + (*v).nf { return }
    (*item_at(v, u)).badge = n
}

fn is_footer(v: *mut NavView, u: usize) -> bool { return u >= (*v).n && u < (*v).n + (*v).nf }

fn selectable(v: *mut NavView, u: usize) -> bool {
    return u < (*v).n + (*v).nf && !(*item_at(v, u)).header
}

fn select(v: *mut NavView, u: usize) {
    if u == NONE || selectable(v, u) { (*v).sel = u }
}

fn selected(v: *mut NavView) -> usize { return (*v).sel }
fn set_back(v: *mut NavView, on: bool) { (*v).back = on }
fn mode(v: *mut NavView) -> u32 { return (*v).mode }
fn overlay_open(v: *mut NavView) -> bool { return (*v).overlay }
fn close_overlay(v: *mut NavView) { (*v).overlay = false }
fn content_x(v: *mut NavView) -> f64 { return (*v).cx }
fn content_y(v: *mut NavView) -> f64 { return (*v).cy }
fn content_w(v: *mut NavView) -> f64 { return (*v).cw }
fn content_h(v: *mut NavView) -> f64 { return (*v).chh }
fn pane_w(v: *mut NavView) -> f64 { return (*v).pw }

fn pane_rect(v: *mut NavView, c: *mut render.Ctx, out: *mut [f64; 4]) {
    (*out)[0] = (*v).x
    (*out)[1] = (*v).y
    (*out)[2] = overlay_w(v, c)
    (*out)[3] = (*v).h
}

fn overlay_w(v: *mut NavView, c: *mut render.Ctx) -> f64 {
    var w: f64 = ds_catalog_tok.nav_w_expanded(c)
    if w > (*v).w - kit.ln(c, 48) { w = (*v).w - kit.ln(c, 48) }
    if w < 0.0 { w = 0.0 }
    return w
}

fn rebuild_top(v: *mut NavView) {
    (*v).nt = 0
    if (*v).back {
        (*v).top[0] = kit.NavItem { icon: lucide.ARROW_LEFT, label: "Back", badge: 0, header: false }
        (*v).nt = 1
    }
    if (*v).mode != MODE_MINIMAL || (*v).overlay {
        (*v).top[(*v).nt] = kit.NavItem { icon: lucide.MENU, label: "Menu", badge: 0, header: false }
        (*v).nt = (*v).nt + 1
    }
}

fn layout(v: *mut NavView, c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64) {
    (*v).ctx = c as u64
    (*v).x = x
    (*v).y = y
    (*v).w = w
    (*v).h = h
    sizeclass.track(&(*v).tracker, (w / kit.ln(c, 1)) as i64)
    let cls: u32 = sizeclass.class_w(&(*v).tracker)
    var m: u32 = MODE_EXPANDED
    if cls == sizeclass.SC_MEDIUM { m = MODE_COMPACT }
    if cls == sizeclass.SC_COMPACT { m = MODE_MINIMAL }
    if m == MODE_EXPANDED && (*v).user_compact { m = MODE_COMPACT }
    if m == MODE_EXPANDED { (*v).overlay = false }
    (*v).mode = m
    rebuild_top(v)
    (*v).pw = 0.0
    if m == MODE_EXPANDED { (*v).pw = ds_catalog_tok.nav_w_expanded(c) }
    if m == MODE_COMPACT { (*v).pw = ds_catalog_tok.nav_w_compact(c) }
    (*v).cx = x + (*v).pw
    (*v).cy = y
    (*v).cw = w - (*v).pw
    (*v).chh = h
    if m == MODE_MINIMAL {
        (*v).cy = y + ds_catalog_tok.top_bar_h(c)
        (*v).chh = h - ds_catalog_tok.top_bar_h(c)
    }
}

fn top_h(v: *mut NavView, c: *mut render.Ctx) -> f64 { return kit.nav_item_y(c, top_ptr(v), (*v).nt) }
fn foot_h(v: *mut NavView, c: *mut render.Ctx) -> f64 { return kit.nav_item_y(c, foot_ptr(v), (*v).nf) }

fn bar_button(v: *mut NavView, c: *mut render.Ctx, k: usize) -> f64 {
    return (*v).x + (ds_catalog_tok.top_bar_h(c)) * (k as f64)
}

fn locate(v: *mut NavView, c: *mut render.Ctx, px: f64, py: f64, idx: *mut usize) -> u32 {
    *idx = NONE
    rebuild_top(v)
    var pane_x: f64 = (*v).x
    var pane_wd: f64 = (*v).pw
    var collapsed: bool = (*v).mode == MODE_COMPACT
    if (*v).overlay {
        pane_wd = overlay_w(v, c)
        collapsed = false
    }
    if (*v).mode == MODE_MINIMAL && !(*v).overlay {
        let bh: f64 = ds_catalog_tok.top_bar_h(c)
        if py >= (*v).y && py < (*v).y + bh && px >= (*v).x {
            var k: usize = 0
            if (*v).back {
                if px < bar_button(v, c, 1) { return REG_BAR_BACK }
                k = 1
            }
            if px >= bar_button(v, c, k) && px < bar_button(v, c, k + 1) { return REG_BAR_MENU }
        }
        return REG_NONE
    }
    if px < pane_x || px >= pane_x + pane_wd || py < (*v).y || py >= (*v).y + (*v).h {
        if (*v).overlay { return REG_SCRIM }
        return REG_NONE
    }
    let th: f64 = top_h(v, c)
    let fh: f64 = foot_h(v, c)
    var i: usize = kit.nav_hit(c, top_ptr(v), (*v).nt, pane_x, (*v).y, pane_wd, collapsed, px, py)
    if i != NONE { *idx = i; return REG_TOP }
    i = kit.nav_hit(c, body_ptr(v), (*v).n, pane_x, (*v).y + th, pane_wd, collapsed, px, py)
    if i != NONE { *idx = i; return REG_BODY }
    i = kit.nav_hit(c, foot_ptr(v), (*v).nf, pane_x, (*v).y + (*v).h - fh, pane_wd, collapsed, px, py)
    if i != NONE { *idx = (*v).n + i; return REG_FOOT }
    return REG_NONE
}

fn hover_at(v: *mut NavView, px: f64, py: f64) -> bool {
    let c: *mut render.Ctx = (*v).ctx as *mut render.Ctx
    var idx: usize = NONE
    let r: u32 = locate(v, c, px, py, &idx)
    if r == (*v).hov_reg && idx == (*v).hov_idx { return false }
    (*v).hov_reg = r
    (*v).hov_idx = idx
    return true
}

fn draw_pane(v: *mut NavView, c: *mut render.Ctx, x: f64, w: f64, collapsed: bool) {
    rebuild_top(v)
    let th: f64 = top_h(v, c)
    let fh: f64 = foot_h(v, c)
    var ht: usize = NONE
    var hb: usize = NONE
    var hf: usize = NONE
    if (*v).hov_reg == REG_TOP { ht = (*v).hov_idx }
    if (*v).hov_reg == REG_BODY { hb = (*v).hov_idx }
    if (*v).hov_reg == REG_FOOT { hf = (*v).hov_idx - (*v).n }
    var sb: usize = NONE
    var sf: usize = NONE
    if (*v).sel != NONE && (*v).sel < (*v).n { sb = (*v).sel }
    if (*v).sel != NONE && (*v).sel >= (*v).n { sf = (*v).sel - (*v).n }
    screenax.note(widget.KIND_MENU, 0 as u32, "Navigation", x, (*v).y, w, (*v).h, 0)
    var body_h: f64 = (*v).h - th - fh
    if body_h < 0.0 { body_h = 0.0 }
    kit.nav_draw(c, top_ptr(v), (*v).nt, NONE, ht, false, x, (*v).y, w, th, collapsed)
    kit.nav_draw(c, body_ptr(v), (*v).n, sb, hb, (*v).foc && (*v).kbd, x, (*v).y + th, w, body_h, collapsed)
    kit.nav_draw(c, foot_ptr(v), (*v).nf, sf, hf, (*v).foc && (*v).kbd, x, (*v).y + (*v).h - fh, w, fh, collapsed)
}

fn draw_bar_button(v: *mut NavView, c: *mut render.Ctx, k: usize, icon: i64, label: str, hot: bool) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let bh: f64 = ds_catalog_tok.top_bar_h(c)
    let bx: f64 = bar_button(v, c, k)
    let inset: f64 = kit.ln(c, 4)
    if hot {
        painter.round_rect(z, bx + inset, (*v).y + inset, bh - inset * 2.0, bh - inset * 2.0, ds_catalog_tok.radius_item(c), ds_catalog_tok.fill_hover(c))
    }
    let s: f64 = ds_catalog_tok.icon_size(c)
    kit.sym(c, icon, bx + (bh - s) / 2.0, (*v).y + (bh - s) / 2.0, s, ds_catalog_tok.text(c))
    screenax.note(widget.KIND_BUTTON, 0 as u32, label, bx, (*v).y, bh, bh, 0)
}

fn draw(v: *mut NavView, c: *mut render.Ctx, px: f64, py: f64) {
    (*v).ctx = c as u64
    hover_at(v, px, py)
    if (*v).mode == MODE_MINIMAL {
        let z: *mut painter.Painter = render.ctx_painter(c)
        painter.surface(z, (*v).x, (*v).y, (*v).w, ds_catalog_tok.top_bar_h(c), ds_catalog_tok.surface(c))
        var k: usize = 0
        if (*v).back {
            draw_bar_button(v, c, 0, lucide.ARROW_LEFT, "Back", (*v).hov_reg == REG_BAR_BACK)
            k = 1
        }
        draw_bar_button(v, c, k, lucide.MENU, "Menu", (*v).hov_reg == REG_BAR_MENU)
        return
    }
    if (*v).overlay { return }
    draw_pane(v, c, (*v).x, (*v).pw, (*v).mode == MODE_COMPACT)
}

fn draw_overlay(v: *mut NavView, c: *mut render.Ctx, px: f64, py: f64) {
    if !(*v).overlay { return }
    let z: *mut painter.Painter = render.ctx_painter(c)
    let ow: f64 = overlay_w(v, c)
    painter.surface(z, (*v).x + ow, (*v).y, (*v).w - ow, (*v).h, ds_catalog_tok.scrim(c))
    hover_at(v, px, py)
    draw_pane(v, c, (*v).x, ow, false)
}

fn toggle(v: *mut NavView) {
    if (*v).tracker.cw == sizeclass.SC_EXPANDED {
        (*v).user_compact = !(*v).user_compact
        return
    }
    (*v).overlay = !(*v).overlay
}

fn press(v: *mut NavView, px: f64, py: f64) -> u32 {
    let c: *mut render.Ctx = (*v).ctx as *mut render.Ctx
    var idx: usize = NONE
    let r: u32 = locate(v, c, px, py, &idx)
    if r == REG_NONE { return EV_NONE }
    (*v).foc = true
    (*v).kbd = false
    if r == REG_SCRIM {
        (*v).overlay = false
        return EV_DISMISS
    }
    if r == REG_BAR_BACK { return EV_BACK }
    if r == REG_BAR_MENU {
        (*v).overlay = true
        return EV_TOGGLE
    }
    if r == REG_TOP {
        if (*v).back && idx == 0 { return EV_BACK }
        toggle(v)
        return EV_TOGGLE
    }
    (*v).sel = idx
    (*v).overlay = false
    return EV_SELECT
}

fn step(v: *mut NavView, from: usize, dir: i64) -> usize {
    let total: usize = (*v).n + (*v).nf
    if total == 0 { return NONE }
    var i: i64 = 0 - 1
    if from != NONE { i = from as i64 }
    if from == NONE && dir < 0 as i64 { i = total as i64 }
    i = i + dir
    while i >= 0 as i64 && i < total as i64 {
        if selectable(v, i as usize) { return i as usize }
        i = i + dir
    }
    return from
}

fn key(v: *mut NavView, code: u32, mods: u32) -> u32 {
    if code == editor.KEY_ESC && (*v).overlay {
        (*v).overlay = false
        return EV_DISMISS
    }
    if code == editor.KEY_LEFT && (mods & editor.MOD_ALT) != 0 as u32 && (*v).back { return EV_BACK }
    var t: usize = (*v).sel
    if code == editor.KEY_DOWN {
        t = step(v, (*v).sel, 1 as i64)
    } else if code == editor.KEY_UP {
        t = step(v, (*v).sel, 0 - 1)
    } else if code == editor.KEY_HOME {
        t = step(v, NONE, 1 as i64)
    } else if code == editor.KEY_END {
        t = step(v, NONE, 0 - 1)
    } else if code == editor.KEY_ENTER {
        return EV_SELECT
    } else {
        return EV_NONE
    }
    (*v).foc = true
    (*v).kbd = true
    if t == (*v).sel { return EV_NONE }
    (*v).sel = t
    return EV_SELECT
}
