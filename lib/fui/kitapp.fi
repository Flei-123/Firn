// lib/fui/kitapp.fi -- THE PARTS A WHOLE APP SCREEN NEEDS ON TOP OF lib/fui/kit.fi.
//
// Immediate mode like kit.fi: `*_draw(c, x, y, w, h, ...)` paints from the state the app keeps.
// Only theme tokens, so light and dark both work. Lengths are design points (kit.ln).
//
//   titlebar_draw   brand + window controls        card_draw     panel with border, hover glow
//   heading_draw    title + sub lines              select_draw   closed drop-down field
//   account_draw    avatar + name + status         info_card_draw  picture, glyph, title, meta, two links
//   grid_cols       how many cards fit             progress / slider bars: slider_draw
import fui.anim
import fui.kit
import fui.screenax
import fui.widget
import fui.kitfx
import fui.painter
import fui.render
import fui.screenanim
import fui.style
import fui.lucide
import fui.theme

fn col(c: *mut render.Ctx, tok: u32) -> u32 {
    return kit.tokc(c, tok)
}

// text in a box of height `h`, `size` in points; returns its width
fn text(c: *mut render.Ctx, x: f64, y: f64, h: f64, size: usize, weight: usize, tok: u32, s: str) -> f64 {
    return kit.draw_label(c, x, y, h, kit.ln(c, size), weight, col(c, tok), s, 0.0)
}

// How many cards of at least `min_w` fit in `w` (gap `gap`).
fn grid_cols(w: f64, min_w: f64, gap: f64) -> usize {
    var n: usize = ((w + gap) / (min_w + gap)) as usize
    if n < 1 { n = 1 }
    return n
}

// A panel: surface, border; with `hover` the accent ring and a soft glow.
fn card_draw(c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, hover: bool) {
    card_bg_draw(c, x, y, w, h, hover, style.TOK_SURFACE)
}

// The same on another ground token (the raised panel of a box that sits on the side bar).
fn card_bg_draw(c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, hover: bool, bg: u32) {
    card_bg_t(c, x, y, w, h, screenanim.hover(c, x, y, hover), bg)
}

// The same at a hover amount `t` (0..1) -- the ring and the glow glide in.
fn card_bg_t(c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, t: f64, bg: u32) {
    card_r_t(c, x, y, w, h, kit.ln(c, 12), t, bg)
}

// A panel with the corner radius `r`.
fn card_r_draw(c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, r: f64, hover: bool, bg: u32) {
    card_r_t(c, x, y, w, h, r, screenanim.hover(c, x, y, hover), bg)
}

fn card_r_t(c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, r: f64, t: f64, bg: u32) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    var ring: u32 = col(c, style.TOK_SEPARATOR)
    if t > 0.0 {
        let acc: u32 = kit.accent_gfx(c, style.TOK_SURFACE)
        ring = screenanim.mix(c, ring, acc, t)
        kit.glow_rect(c, x, y, w, h, r, acc, kit.ln(c, 12), kit.ln(c, 8), (90.0 * t) as u32)
    }
    painter.round_rect(z, x, y, w, h, r, col(c, bg))
    painter.round_ring(z, x, y, w, h, r, kit.ln(c, 1), ring)
}

// A page title with up to two muted lines under it ("" = none). Returns the height used.
fn heading_draw(c: *mut render.Ctx, x: f64, y: f64, title: str, sub: str, sub2: str) -> f64 {
    var h: f64 = kit.ln(c, 30)
    screenax.note(widget.KIND_LABEL, screenax.F_HEADING, title, x, y, kit.ln(c, 400), h, 0)
    let w: f64 = text(c, x, y, h, 22, 700, style.TOK_TEXT, title)
    text(c, x, y + h, kit.ln(c, 18), 13, 400, style.TOK_TEXT_MUTED, sub)
    text(c, x, y + h + kit.ln(c, 18), kit.ln(c, 18), 13, 400, style.TOK_TEXT_MUTED, sub2)
    return h + kit.ln(c, 36)
}

// A closed drop-down: the chosen text and a chevron.
fn select_draw(c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, label: str, hover: bool) {
    screenax.note(widget.KIND_DROPDOWN, 0 as u32, label, x, y, w, h, 0)
    select_paint(c, x, y, w, h, label, hover)
}

fn select_paint(c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, label: str, hover: bool) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let r: f64 = kit.ln(c, 8)
    painter.round_rect(z, x, y, w, h, r, col(c, style.TOK_SURFACE_RAISED))
    let ring: u32 = screenanim.mix(c, col(c, style.TOK_BORDER), kit.accent_gfx(c, style.TOK_FIELD), screenanim.hover(c, x, y, hover))
    painter.round_ring(z, x, y, w, h, r, kit.ln(c, 1), ring)
    kit.label_in(c, x + kit.ln(c, 12), y, h, kit.ln(c, 13), 400, col(c, style.TOK_TEXT), label, w - kit.ln(c, 40))
    kit.sym(c, lucide.CHEVRON_DOWN, x + w - kit.ln(c, 28), y + (h - kit.ln(c, 16)) / 2.0, kit.ln(c, 16), col(c, style.TOK_TEXT_MUTED))
}

// The account box at the foot of a sidebar.
fn account_draw(c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, name: str, status: str, hover: bool) {
    screenax.note(widget.KIND_BUTTON, 0 as u32, name, x, y, w, h, 0)
    card_bg_draw(c, x, y, w, h, hover, style.TOK_SURFACE_RAISED)
    let d: f64 = kit.ln(c, 34)
    // a rounded tile with the accent initial (the launcher look), not a coloured disc
    let z: *mut painter.Painter = render.ctx_painter(c)
    painter.round_rect(z, x + kit.ln(c, 10), y + (h - d) / 2.0, d, d, kit.ln(c, 8), col(c, style.TOK_FIELD_FOCUS))
    if name.n > 0 {
        let ini: str = str { p: name.p, n: 1 }
        text(c, x + kit.ln(c, 10) + (d - kit.text_width(c, kit.ln(c, 14), 700, ini)) / 2.0, y + (h - d) / 2.0, d, 14, 700, style.TOK_ACCENT, ini)
    }
    let tx: f64 = x + kit.ln(c, 54)
    text(c, tx, y + kit.ln(c, 12), kit.ln(c, 18), 13, 700, style.TOK_TEXT, name)
    text(c, tx, y + kit.ln(c, 30), kit.ln(c, 14), 11, 400, style.TOK_TEXT_MUTED, status)
    kit.sym(c, lucide.CHEVRON_DOWN, x + w - kit.ln(c, 30), y + (h - kit.ln(c, 16)) / 2.0, kit.ln(c, 16), col(c, style.TOK_TEXT_MUTED))
}

// The title bar of a frameless window: brand ("Flei" + bold "Launcher") and the three controls.
fn titlebar_draw(c: *mut render.Ctx, w: f64, h: f64, light: str, bold: str) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    painter.surface(z, 0.0, 0.0, w, h, col(c, style.TOK_SURFACE))
    painter.surface(z, 0.0, h - kit.ln(c, 1), w, kit.ln(c, 1), col(c, style.TOK_SEPARATOR))
    kit.sym(c, lucide.ZAP, kit.ln(c, 22), (h - kit.ln(c, 18)) / 2.0, kit.ln(c, 18), kit.accent_gfx(c, style.TOK_SURFACE))
    let t: f64 = text(c, kit.ln(c, 56), 0.0, h, 14, 400, style.TOK_TEXT_MUTED, light)
    text(c, kit.ln(c, 56) + t, 0.0, h, 14, 700, style.TOK_TEXT, bold)
    var i: usize = 0
    while i < 3 {
        var g: i64 = lucide.MINUS
        if i == 1 { g = lucide.SQUARE }
        if i == 2 { g = lucide.X }
        kit.sym(c, g, w - kit.ln(c, 119 - 42 * i), (h - kit.ln(c, 14)) / 2.0, kit.ln(c, 14), col(c, style.TOK_TEXT_MUTED))
        i = i + 1
    }
}

// The picture every info card shows instead of the initials disc (kitfx.pic_load; 0 = none).
static mut PIC: u64 = 0

fn set_picture(p: *mut kitfx.Pic) {
    PIC = p as u64
}

// A card with a picture (seed colour) at the left, a glyph at the right, a title, a muted line and two text links.
fn info_card_draw(c: *mut render.Ctx, x: f64, y0: f64, w: f64, h: f64, hover: bool, seed: u32,
    glyph: i64, glyph_col: u32, title: str, meta: str, link1: str, link2: str) {
    // a hovered card rises 3 pt (CSS translateY(-3px)), with the accent glow
    let t: f64 = screenanim.hover(c, x, y0, hover)
    let y: f64 = y0 + kitfx.card_lift(c, t)
    screenax.note(widget.KIND_TILE, 0 as u32, title, x, y0, w, h, 0)
    card_bg_t(c, x, y, w, h, t, style.TOK_SURFACE)
    let p: f64 = kit.ln(c, 16)
    let d: f64 = kit.ln(c, 42)
    if kitfx.pic_ok(PIC as *mut kitfx.Pic) {
        kitfx.pic_draw(c, PIC as *mut kitfx.Pic, x + p, y + p, d, kit.ln(c, 10), col(c, style.TOK_SURFACE))
    } else {
        kit.avatar_draw(c, x + p, y + p, d, seed, title, kit.ICON_NONE)
    }
    kit.sym(c, glyph, x + w - p - kit.ln(c, 26), y + p + kit.ln(c, 8), kit.ln(c, 26), glyph_col)
    text(c, x + p, y + p + d + kit.ln(c, 7), kit.ln(c, 24), 15, 700, style.TOK_TEXT, title)
    text(c, x + p, y + p + d + kit.ln(c, 33), kit.ln(c, 18), 12, 400, style.TOK_TEXT_MUTED, meta)
    let l: f64 = text(c, x + p, y + h - p - kit.ln(c, 17), kit.ln(c, 16), 12, 400, style.TOK_TEXT_MUTED, link1)
    text(c, x + p + l + kit.ln(c, 14), y + h - p - kit.ln(c, 17), kit.ln(c, 16), 12, 400, style.TOK_TEXT_MUTED, link2)
}

// A slider (track, accent fill, knob with a halo) at `permille` 0..1000.
fn slider_draw(c: *mut render.Ctx, x: f64, y: f64, w: f64, permille: i64) {
    slider_hot_draw(c, x, y, w, permille, false)
}

// The same; `hot` (pointer on the slider) swells the halo. The knob glides to a new value, the halo fades.
fn slider_hot_draw(c: *mut render.Ctx, x: f64, y: f64, w: f64, permille: i64, hot: bool) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let th: f64 = kit.ln(c, 6)
    let pm: f64 = anim.chan_f(c, screenanim.key_at(x, y), 904 as u32, permille as f64, 90)
    let ht: f64 = screenanim.hover(c, x, y, hot)
    let kx: f64 = x + (w - kit.ln(c, 18)) * pm / 1000.0
    painter.round_rect(z, x, y, w, th, th / 2.0, col(c, style.TOK_BUTTON))
    painter.round_rect(z, x, y, kx - x + kit.ln(c, 9), th, th / 2.0, col(c, style.TOK_ACCENT))
    let sw: f64 = kit.ln(c, 5) * ht
    painter.round_rect(z, kx - kit.ln(c, 4) - sw, y - kit.ln(c, 7) - sw, kit.ln(c, 26) + 2.0 * sw, kit.ln(c, 26) + 2.0 * sw, kit.ln(c, 13) + sw, kit.with_alpha(col(c, style.TOK_ACCENT), (70.0 + 40.0 * ht) as u32))
    painter.round_rect(z, kx, y - kit.ln(c, 6), kit.ln(c, 18), kit.ln(c, 18), kit.ln(c, 9), col(c, style.TOK_ACCENT))
}
