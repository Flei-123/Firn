// SPDX-License-Identifier: MPL-2.0
// lib/fui/bidi.fi -- BIDIRECTIONAL TEXT: LEVELS AND ORDER.
//
// ========================================================= WHY IT EXISTS
//
// Arabic and Hebrew are written from right to left, but numbers in them
// from left to right, and a Latin word in the middle of a
// Hebrew sentence too. A surface that simply paints every string
// from left to right shows an Arabic reader every
// word mirrored -- and no checking program notices, because the
// characters are all there. Which order is right is not decided by
// taste, but by the Unicode bidirectional algorithm (UAX #9). This
// file is it.
//
// ================================================== WHAT IS CALCULATED HERE
//
// ONLY LEVELS AND ORDER. Where the class of a character comes from is said by
// lib/str/ucd_bidi.fi (generated from the UCD, not by hand); how an
// Arabic letter chooses its form is said by lib/fui/shape.fi; how wide
// a glyph is is said by lib/font/metrics.fi; painting is done in
// lib/fui/painter.fi. What stands here is on which LEVEL each character lands
// and in what order the characters of a line
// stand on the screen -- nothing else. Exactly this separation makes it checkable:
// tools/fui/bidi_main.fi re-calculates the levels and the order without a
// font and without a canvas.
//
// The rules, in the order of the specification (Unicode 17.0.0):
//
//   P2, P3   the paragraph level: the first strong character (L, R, AL), where
//            the content of isolates is skipped -- or given by the
//            caller (`direction: ltr|rtl` in the style sheet)
//   X1..X8   the explicit embeddings, overrides and isolates
//            (LRE RLE LRO RLO PDF LRI RLI FSI PDI) with the stack of
//            depth 125
//   X9       the control characters drop out (here they become BN and
//            are skipped in all further rules)
//   X10      runs of equal level, joined via matching
//            isolates into sequences; sos and eos at their edges
//   W1..W7   the weak types: NSM, numbers, separators
//   N0       bracket pairs (BD16, at most 63 open)
//   N1, N2   the neutrals between strong characters
//   I1, I2   the implicit levels
//   L1       separators and whitespace at the line end to the paragraph level
//   L2       the reversal from the highest level to the lowest
//            odd one
//
// L3 (keep combining marks behind their base letters) and L4
// (mirrored images at odd levels) belong to the painting of the glyphs and
// stand in lib/fui/shape.fi or lib/fui/painter.fi -- they change no
// level.
//
// ================================================= WHAT THE ARRAYS LOOK LIKE
//
// Without allocation. The caller passes pointers to arrays that he
// holds himself (the painter holds them once per painter, see painter.fi), and
// `bidi_work_bytes(n)` says how large the work area must be. That
// is the same rule as in the TrueType reader: whoever allocates in a drawing
// path pays at every frame -- and in the Osum window server there is no
// heap at all while painting.
//
//   cp    u32[n]   the code points, in logical order
//   cls0  u8[n]    the class from the UCD, unchanged (L1 needs it)
//   cls   u8[n]    the class in the course of the rules
//   lev   u8[n]    the resolved level
//   pl    u8[n]    the paragraph level of the paragraph to which the character belongs
//   work  bidi_work_bytes(n) octets
//
// All functions are #[no_gc]: the measuring paths of the painter are, and the
// promise holds for the whole call tree.
import str.ucd_bidi

export {
    BidiPara, bidi_new, bidi_work_bytes, bidi_run, bidi_needed,
    bidi_para_level_of, bidi_first_strong,
    bidi_line_levels, bidi_reorder, bidi_is_removed,
    DIR_AUTO, DIR_LTR, DIR_RTL,
    MAX_DEPTH,
}

// THE PARAGRAPH DIRECTION. AUTO means P2/P3 (the first strong character
// decides, without one left to right applies); LTR and RTL fix the
// paragraph level (0 or 1) -- that is `direction: ltr|rtl` from
// lib/fui/style.fi.
const DIR_AUTO: u32 = 0
const DIR_LTR: u32 = 1
const DIR_RTL: u32 = 2

// The largest explicit level (BD2). 125, so that 126 as an odd level
// above it still has room for I1/I2.
const MAX_DEPTH: u8 = 125

// BD16 follows at most this many open brackets. Whoever has more open
// gets no more pairs for the rest of the sequence -- that is what the
// specification says, and that is exactly what `pair_brackets` does.
const BRACKET_STACK: usize = 63

const NONE: u32 = 0xFFFFFFFF

struct BidiPara {
    t: u64, // die Tabelle aus ucd_bidi.ucd_bidi_map
    cp: u64,
    n: usize,
    cls0: u64,
    cls: u64,
    lev: u64,
    pl: u64,
    work: u64,
}

// ------------------------------------------------------------ Lesen/Schreiben

#[no_gc]
fn r8(p: u64, i: usize) -> u8 {
    return *((p + i as u64) as *mut u8)
}

#[no_gc]
fn w8(p: u64, i: usize, v: u8) {
    *((p + i as u64) as *mut u8) = v
}

#[no_gc]
fn r32(p: u64, i: usize) -> u32 {
    return *((p + (i * 4) as u64) as *mut u32)
}

#[no_gc]
fn w32(p: u64, i: usize, v: u32) {
    *((p + (i * 4) as u64) as *mut u32) = v
}

// ------------------------------------------------------------ the work area
//
// The sub-arrays, in this order from `work`:
//
//   match   u32[n]   for every isolate start the matching PDI (BD9)
//   mpdi    u8[n]    1 if this PDI belongs to a start
//   rs, re  u32[n]   start and end of every run (BD7)
//   runat   u32[n]   which run begins at this character
//   seq     u32[n]   the characters of the sequence being worked on (BD13)
//   pairs   u32[n]   bracket pairs, two entries each
//   stk     3 x 128  octets: the direction stack of X1..X8
//   bstk    u32[126] the bracket stack of BD16
#[no_gc]
fn off_match(n: usize) -> usize { return 0 }

#[no_gc]
fn off_mpdi(n: usize) -> usize { return n * 4 }

#[no_gc]
fn off_rs(n: usize) -> usize { return n * 5 }

#[no_gc]
fn off_re(n: usize) -> usize { return n * 9 }

#[no_gc]
fn off_runat(n: usize) -> usize { return n * 13 }

#[no_gc]
fn off_seq(n: usize) -> usize { return n * 17 }

#[no_gc]
fn off_pairs(n: usize) -> usize { return n * 21 }

#[no_gc]
fn off_stk(n: usize) -> usize { return n * 25 }

#[no_gc]
fn off_bstk(n: usize) -> usize { return n * 25 + 384 }

#[no_gc]
fn bidi_work_bytes(n: usize) -> usize {
    // Rounded up to eight, so that a caller who lays further fields
    // behind it stays aligned.
    return (n * 25 + 384 + 126 * 4 + 7) / 8 * 8
}

#[no_gc]
fn bidi_new(t: u64, cp: u64, n: usize, cls0: u64, cls: u64, lev: u64,
    pl: u64, work: u64) -> BidiPara {
    return BidiPara {
        t: t, cp: cp, n: n, cls0: cls0, cls: cls, lev: lev, pl: pl,
        work: work,
    }
}

// ------------------------------------------------------------ Klassenfragen

#[no_gc]
fn is_isolate_init(c: u8) -> bool {
    return c == ucd_bidi.BIDI_LRI || c == ucd_bidi.BIDI_RLI
    || c == ucd_bidi.BIDI_FSI
}

// The characters that X9 takes out. After X1..X8 that is always the
// class BN here -- the embedding characters are rewritten to BN there.
#[no_gc]
fn bidi_is_removed(c: u8) -> bool {
    return c == ucd_bidi.BIDI_BN || c == ucd_bidi.BIDI_LRE
    || c == ucd_bidi.BIDI_RLE || c == ucd_bidi.BIDI_LRO
    || c == ucd_bidi.BIDI_RLO || c == ucd_bidi.BIDI_PDF
}

// NI from the BD6 note: the neutrals and the isolate characters.
#[no_gc]
fn is_ni(c: u8) -> bool {
    return c == ucd_bidi.BIDI_B || c == ucd_bidi.BIDI_S
    || c == ucd_bidi.BIDI_WS || c == ucd_bidi.BIDI_ON
    || c == ucd_bidi.BIDI_LRI || c == ucd_bidi.BIDI_RLI
    || c == ucd_bidi.BIDI_FSI || c == ucd_bidi.BIDI_PDI
}

// The strong direction in the sense of N0/N1: L stays L, R/AL and the
// numbers EN/AN count as R. 255 means "none".
#[no_gc]
fn strong_n(c: u8) -> u8 {
    if c == ucd_bidi.BIDI_L {
        return ucd_bidi.BIDI_L
    }
    if c == ucd_bidi.BIDI_R || c == ucd_bidi.BIDI_AL
    || c == ucd_bidi.BIDI_EN || c == ucd_bidi.BIDI_AN {
        return ucd_bidi.BIDI_R
    }
    return 255 as u8
}

#[no_gc]
fn dir_of_level(lv: u8) -> u8 {
    if (lv & 1 as u8) != 0 as u8 {
        return ucd_bidi.BIDI_R
    }
    return ucd_bidi.BIDI_L
}

// ======================================================================
// P2/P3 -- THE FIRST STRONG CHARACTER
// ======================================================================
//
// Between an isolate start and its PDI NO search is done: an
// isolated Latin word at the start of an Arabic sentence must not determine the
// direction of the sentence, exactly that is what isolates are for.
// Return: 0 for L, 1 for R/AL, -1 if none occurs. `stop_pdi`
// means: stop at the first PDI of depth 0 (that is how FSI asks in X5c).
#[no_gc]
fn bidi_first_strong(cls: u64, from: usize, to: usize,
    stop_pdi: bool) -> i32 {
    var depth: usize = 0
    var i: usize = from
    while i < to {
        let c: u8 = r8(cls, i)
        if is_isolate_init(c) {
            depth = depth + 1
        } else if c == ucd_bidi.BIDI_PDI {
            if depth > 0 {
                depth = depth - 1
            } else if stop_pdi {
                return 0 - 1
            }
        } else if c == ucd_bidi.BIDI_B {
            return 0 - 1
        } else if depth == 0 {
            if c == ucd_bidi.BIDI_L {
                return 0
            }
            if c == ucd_bidi.BIDI_R || c == ucd_bidi.BIDI_AL {
                return 1
            }
        }
        i = i + 1
    }
    return 0 - 1
}

// ======================================================================
// DOES THIS TEXT NEED THE ALGORITHM AT ALL?
// ======================================================================
//
// Without R, AL, AN and without RLE/RLO/RLI every level in a paragraph of level 0
// stays even (LRE/LRO raise by two, EN is raised after W7/I1 at most
// by two), and L2 then reverses nothing: the order on the
// screen is the logical one. The painter asks that BEFORE everything else and in
// this case goes its old way -- thereby every Latin
// label in every proof paints pixel for pixel as before.
#[no_gc]
fn bidi_needed(t: u64, cp: u64, n: usize, dir: u32) -> bool {
    if dir == DIR_RTL {
        return true
    }
    var i: usize = 0
    while i < n {
        let c: u8 = ucd_bidi.ucd_bidi_class(t, r32(cp, i))
        if c == ucd_bidi.BIDI_R || c == ucd_bidi.BIDI_AL
        || c == ucd_bidi.BIDI_AN || c == ucd_bidi.BIDI_RLE
        || c == ucd_bidi.BIDI_RLO || c == ucd_bidi.BIDI_RLI {
            return true
        }
        i = i + 1
    }
    return false
}

// ======================================================================
// THE WHOLE RUN: CLASSES, PARAGRAPHS, LEVELS
// ======================================================================
//
// A paragraph ends behind every character of class B (P1); each gets
// its own level. `dir` applies to all paragraphs. Returned is the
// level of the FIRST paragraph -- for a label that is the one by
// which the alignment goes.
#[no_gc]
fn bidi_run(p: *mut BidiPara, dir: u32) -> u8 {
    let n: usize = (*p).n
    var i: usize = 0
    while i < n {
        let c: u8 = ucd_bidi.ucd_bidi_class((*p).t, r32((*p).cp, i))
        w8((*p).cls0, i, c)
        w8((*p).cls, i, c)
        w8((*p).lev, i, 0 as u8)
        i = i + 1
    }
    var first: u8 = 0 as u8
    var start: usize = 0
    var k: usize = 0
    while start < n {
        var end: usize = start
        while end < n {
            let c2: u8 = r8((*p).cls0, end)
            end = end + 1
            if c2 == ucd_bidi.BIDI_B {
                break
            }
        }
        var lv: u8 = 0 as u8
        if dir == DIR_RTL {
            lv = 1 as u8
        } else if dir == DIR_AUTO {
            if bidi_first_strong((*p).cls0, start, end, false) == 1 {
                lv = 1 as u8
            }
        }
        if k == 0 {
            first = lv
        }
        resolve_paragraph(p, start, end, lv)
        var j: usize = start
        while j < end {
            w8((*p).pl, j, lv)
            j = j + 1
        }
        start = end
        k = k + 1
    }
    return first
}

#[no_gc]
fn bidi_para_level_of(p: *mut BidiPara, i: usize) -> u8 {
    if (*p).n == 0 {
        return 0 as u8
    }
    return r8((*p).pl, i)
}

// ------------------------------------------------------ BD9: passende PDIs
#[no_gc]
fn match_isolates(p: *mut BidiPara, a: usize, b: usize) {
    let n: usize = (*p).n
    let mt: u64 = (*p).work + off_match(n) as u64
    let mp: u64 = (*p).work + off_mpdi(n) as u64
    var i: usize = a
    while i < b {
        w32(mt, i, NONE)
        w8(mp, i, 0 as u8)
        i = i + 1
    }
    i = a
    while i < b {
        if is_isolate_init(r8((*p).cls0, i)) {
            var depth: usize = 1
            var j: usize = i + 1
            while j < b {
                let c: u8 = r8((*p).cls0, j)
                if is_isolate_init(c) {
                    depth = depth + 1
                } else if c == ucd_bidi.BIDI_PDI {
                    depth = depth - 1
                    if depth == 0 {
                        w32(mt, i, j as u32)
                        w8(mp, j, 1 as u8)
                        break
                    }
                } else if c == ucd_bidi.BIDI_B {
                    break
                }
                j = j + 1
            }
        }
        i = i + 1
    }
}

// ======================================================================
// X1..X8 -- THE DIRECTION STACK
// ======================================================================
//
// An entry is three octets: the level, the override (0 none,
// 1 L, 2 R) and whether it comes from an isolate. Overflow is COUNTED
// and not cut off, so that the later PDF/PDI reach the right
// entry -- that is the point of the three counters in X1.
#[no_gc]
fn next_odd(lv: u8) -> u8 {
    return (lv + 1 as u8) | 1 as u8
}

#[no_gc]
fn next_even(lv: u8) -> u8 {
    return (lv + 2 as u8) & (254 as u8)
}

#[no_gc]
fn explicit_levels(p: *mut BidiPara, a: usize, b: usize, para: u8) {
    let n: usize = (*p).n
    let stk: u64 = (*p).work + off_stk(n) as u64
    let mt: u64 = (*p).work + off_match(n) as u64
    // Entry k: level at 3k, override at 3k+1, isolate at 3k+2
    var sp: usize = 1
    w8(stk, 0, para)
    w8(stk, 1, 0 as u8)
    w8(stk, 2, 0 as u8)
    var oi: usize = 0 // Ueberlauf der Isolate
    var oe: usize = 0 // Ueberlauf der Einbettungen
    var vi: usize = 0 // gueltige Isolate
    var i: usize = a
    while i < b {
        let c: u8 = r8((*p).cls0, i)
        let top: usize = (sp - 1) * 3
        let cur: u8 = r8(stk, top)
        let ovr: u8 = r8(stk, top + 1)
        if c == ucd_bidi.BIDI_RLE || c == ucd_bidi.BIDI_LRE
        || c == ucd_bidi.BIDI_RLO || c == ucd_bidi.BIDI_LRO {
            // X2..X5
            var nl: u8 = next_even(cur)
            if c == ucd_bidi.BIDI_RLE || c == ucd_bidi.BIDI_RLO {
                nl = next_odd(cur)
            }
            if nl <= MAX_DEPTH && oi == 0 && oe == 0 {
                var o: u8 = 0 as u8
                if c == ucd_bidi.BIDI_RLO {
                    o = 2 as u8
                } else if c == ucd_bidi.BIDI_LRO {
                    o = 1 as u8
                }
                w8(stk, sp * 3, nl)
                w8(stk, sp * 3 + 1, o)
                w8(stk, sp * 3 + 2, 0 as u8)
                sp = sp + 1
            } else if oi == 0 {
                oe = oe + 1
            }
            w8((*p).lev, i, cur)
            w8((*p).cls, i, ucd_bidi.BIDI_BN)
        } else if is_isolate_init(c) {
            // X5a..X5c
            w8((*p).lev, i, cur)
            if ovr == 1 as u8 {
                w8((*p).cls, i, ucd_bidi.BIDI_L)
            } else if ovr == 2 as u8 {
                w8((*p).cls, i, ucd_bidi.BIDI_R)
            }
            var rtl: bool = c == ucd_bidi.BIDI_RLI
            if c == ucd_bidi.BIDI_FSI {
                var e: usize = r32(mt, i) as usize
                if r32(mt, i) == NONE {
                    e = b
                }
                rtl = bidi_first_strong((*p).cls0, i + 1, e, true) == 1
            }
            var nl2: u8 = next_even(cur)
            if rtl {
                nl2 = next_odd(cur)
            }
            if nl2 <= MAX_DEPTH && oi == 0 && oe == 0 {
                vi = vi + 1
                w8(stk, sp * 3, nl2)
                w8(stk, sp * 3 + 1, 0 as u8)
                w8(stk, sp * 3 + 2, 1 as u8)
                sp = sp + 1
            } else {
                oi = oi + 1
            }
        } else if c == ucd_bidi.BIDI_PDI {
            // X6a
            if oi > 0 {
                oi = oi - 1
            } else if vi == 0 {
                // a PDI without a start: nothing to do
            } else {
                oe = 0
                while r8(stk, (sp - 1) * 3 + 2) == 0 as u8 {
                    sp = sp - 1
                }
                sp = sp - 1
                vi = vi - 1
            }
            let t2: usize = (sp - 1) * 3
            w8((*p).lev, i, r8(stk, t2))
            let o2: u8 = r8(stk, t2 + 1)
            if o2 == 1 as u8 {
                w8((*p).cls, i, ucd_bidi.BIDI_L)
            } else if o2 == 2 as u8 {
                w8((*p).cls, i, ucd_bidi.BIDI_R)
            }
        } else if c == ucd_bidi.BIDI_PDF {
            // X7
            if oi > 0 {
                // nothing
            } else if oe > 0 {
                oe = oe - 1
            } else if r8(stk, top + 2) == 0 as u8 && sp >= 2 {
                sp = sp - 1
            }
            w8((*p).lev, i, cur)
            w8((*p).cls, i, ucd_bidi.BIDI_BN)
        } else if c == ucd_bidi.BIDI_B {
            // X8: the paragraph separator stands on the paragraph level
            w8((*p).lev, i, para)
        } else if c == ucd_bidi.BIDI_BN {
            w8((*p).lev, i, cur)
        } else {
            // X6
            w8((*p).lev, i, cur)
            if ovr == 1 as u8 {
                w8((*p).cls, i, ucd_bidi.BIDI_L)
            } else if ovr == 2 as u8 {
                w8((*p).cls, i, ucd_bidi.BIDI_R)
            }
        }
        i = i + 1
    }
}

// ======================================================================
// X10 -- RUNS AND THEIR SEQUENCES
// ======================================================================
#[no_gc]
fn resolve_paragraph(p: *mut BidiPara, a: usize, b: usize, para: u8) {
    let n: usize = (*p).n
    match_isolates(p, a, b)
    explicit_levels(p, a, b, para)

    // BD7: runs over the characters that were not removed.
    let rs: u64 = (*p).work + off_rs(n) as u64
    let re: u64 = (*p).work + off_re(n) as u64
    let runat: u64 = (*p).work + off_runat(n) as u64
    let mt: u64 = (*p).work + off_match(n) as u64
    let mp: u64 = (*p).work + off_mpdi(n) as u64
    var nr: usize = 0
    var i: usize = a
    var last: usize = NONE as usize
    while i < b {
        w32(runat, i, NONE)
        if r8((*p).cls, i) != ucd_bidi.BIDI_BN {
            if last != NONE as usize
            && r8((*p).lev, last) == r8((*p).lev, i) {
                w32(re, nr - 1, i as u32)
            } else {
                w32(rs, nr, i as u32)
                w32(re, nr, i as u32)
                w32(runat, i, nr as u32)
                nr = nr + 1
            }
            last = i
        }
        i = i + 1
    }

    // BD13: every sequence begins with a run whose first character is
    // NO PDI that belongs to a start.
    let seq: u64 = (*p).work + off_seq(n) as u64
    var r: usize = 0
    while r < nr {
        let first: usize = r32(rs, r) as usize
        if r8(mp, first) == 0 as u8 {
            var m: usize = 0
            var cr: usize = r
            while true {
                // append the run cr, without the removed characters
                var j: usize = r32(rs, cr) as usize
                let e: usize = r32(re, cr) as usize
                while j <= e {
                    if r8((*p).cls, j) != ucd_bidi.BIDI_BN {
                        w32(seq, m, j as u32)
                        m = m + 1
                    }
                    j = j + 1
                }
                // if it ends with an isolate start that has a PDI,
                // the sequence continues at the run that begins with
                // this PDI
                let lastc: usize = e
                if is_isolate_init(r8((*p).cls0, lastc))
                && r32(mt, lastc) != NONE {
                    let pdi: usize = r32(mt, lastc) as usize
                    let nx: u32 = r32(runat, pdi)
                    if nx == NONE {
                        break
                    }
                    cr = nx as usize
                } else {
                    break
                }
            }
            resolve_sequence(p, seq, m, a, b, para)
        }
        r = r + 1
    }

    // I1/I2 ONLY HERE, AFTER ALL SEQUENCES. The sos and eos of a sequence
    // depend on the level of their neighbours, and what is meant is the
    // EXPLICIT level from X1..X8. Whoever applies I1/I2 already at the end of every
    // sequence raises the neighbours of the next sequence beforehand -- an
    // L at level 3 then stands at 4, and the sequence behind it gets
    // sos = L instead of R. BidiCharacterTest.txt showed exactly that in ten
    // cases (line 162 ff.).
    i = a
    while i < b {
        let c: u8 = r8((*p).cls, i)
        if c != ucd_bidi.BIDI_BN {
            let l0: u8 = r8((*p).lev, i)
            if (l0 & 1 as u8) == 0 as u8 {
                if c == ucd_bidi.BIDI_R {
                    w8((*p).lev, i, l0 + 1 as u8)
                } else if c == ucd_bidi.BIDI_AN || c == ucd_bidi.BIDI_EN {
                    w8((*p).lev, i, l0 + 2 as u8)
                }
            } else {
                if c == ucd_bidi.BIDI_L || c == ucd_bidi.BIDI_AN
                || c == ucd_bidi.BIDI_EN {
                    w8((*p).lev, i, l0 + 1 as u8)
                }
            }
        }
        i = i + 1
    }

    // The removed characters get the level of their predecessor (or
    // the paragraph level). They are not visible; but this way they tear
    // no run apart when L2 reverses.
    var prev: u8 = para
    i = a
    while i < b {
        if r8((*p).cls, i) == ucd_bidi.BIDI_BN {
            w8((*p).lev, i, prev)
        } else {
            prev = r8((*p).lev, i)
        }
        i = i + 1
    }
}

// The level of the non-removed neighbour in direction `step` (+1/-1),
// or `para` if there is none.
#[no_gc]
fn neighbour_level(p: *mut BidiPara, from: usize, a: usize, b: usize,
    fwd: bool, para: u8) -> u8 {
    if fwd {
        var j: usize = from + 1
        while j < b {
            if r8((*p).cls, j) != ucd_bidi.BIDI_BN {
                return r8((*p).lev, j)
            }
            j = j + 1
        }
        return para
    }
    var k: usize = from
    while k > a {
        k = k - 1
        if r8((*p).cls, k) != ucd_bidi.BIDI_BN {
            return r8((*p).lev, k)
        }
    }
    return para
}

#[no_gc]
fn cls_at(p: *mut BidiPara, seq: u64, k: usize) -> u8 {
    return r8((*p).cls, r32(seq, k) as usize)
}

#[no_gc]
fn set_at(p: *mut BidiPara, seq: u64, k: usize, v: u8) {
    w8((*p).cls, r32(seq, k) as usize, v)
}

// ======================================================================
// ONE SEQUENCE: W1..W7, N0..N2 (I1/I2 follow in resolve_paragraph)
// ======================================================================
#[no_gc]
fn resolve_sequence(p: *mut BidiPara, seq: u64, m: usize, a: usize,
    b: usize, para: u8) {
    if m == 0 {
        return
    }
    let f0: usize = r32(seq, 0) as usize
    let fl: usize = r32(seq, m - 1) as usize
    let lv: u8 = r8((*p).lev, f0)
    // sos/eos (X10): the higher of the two levels at the boundary.
    var before: u8 = neighbour_level(p, f0, a, b, false, para)
    var after: u8 = neighbour_level(p, fl, a, b, true, para)
    if is_isolate_init(r8((*p).cls0, fl)) {
        after = para
    }
    if lv > before {
        before = lv
    }
    if lv > after {
        after = lv
    }
    let sos: u8 = dir_of_level(before)
    let eos: u8 = dir_of_level(after)

    // ---- W1: NSM takes the type of the predecessor, behind an isolate
    // character it becomes ON.
    var k: usize = 0
    while k < m {
        if cls_at(p, seq, k) == ucd_bidi.BIDI_NSM {
            if k == 0 {
                set_at(p, seq, k, sos)
            } else {
                let pv: u8 = cls_at(p, seq, k - 1)
                if is_isolate_init(pv) || pv == ucd_bidi.BIDI_PDI {
                    set_at(p, seq, k, ucd_bidi.BIDI_ON)
                } else {
                    set_at(p, seq, k, pv)
                }
            }
        }
        k = k + 1
    }
    // ---- W2: EN behind AL becomes AN. W3: AL becomes R.
    var ls: u8 = sos
    k = 0
    while k < m {
        let c: u8 = cls_at(p, seq, k)
        if c == ucd_bidi.BIDI_L || c == ucd_bidi.BIDI_R
        || c == ucd_bidi.BIDI_AL {
            ls = c
        } else if c == ucd_bidi.BIDI_EN && ls == ucd_bidi.BIDI_AL {
            set_at(p, seq, k, ucd_bidi.BIDI_AN)
        }
        k = k + 1
    }
    k = 0
    while k < m {
        if cls_at(p, seq, k) == ucd_bidi.BIDI_AL {
            set_at(p, seq, k, ucd_bidi.BIDI_R)
        }
        k = k + 1
    }
    // ---- W4: a single ES between EN and EN, a single CS
    // between two numbers of the same type.
    k = 1
    while k + 1 < m {
        let c: u8 = cls_at(p, seq, k)
        let pv: u8 = cls_at(p, seq, k - 1)
        let nx: u8 = cls_at(p, seq, k + 1)
        if c == ucd_bidi.BIDI_ES && pv == ucd_bidi.BIDI_EN
        && nx == ucd_bidi.BIDI_EN {
            set_at(p, seq, k, ucd_bidi.BIDI_EN)
        } else if c == ucd_bidi.BIDI_CS && pv == nx
        && (pv == ucd_bidi.BIDI_EN || pv == ucd_bidi.BIDI_AN) {
            set_at(p, seq, k, pv)
        }
        k = k + 1
    }
    // ---- W5: a sequence of ET next to EN becomes EN.
    k = 0
    while k < m {
        if cls_at(p, seq, k) == ucd_bidi.BIDI_ET {
            var e: usize = k
            while e < m && cls_at(p, seq, e) == ucd_bidi.BIDI_ET {
                e = e + 1
            }
            var to_en: bool = false
            if k > 0 && cls_at(p, seq, k - 1) == ucd_bidi.BIDI_EN {
                to_en = true
            }
            if e < m && cls_at(p, seq, e) == ucd_bidi.BIDI_EN {
                to_en = true
            }
            if to_en {
                var j: usize = k
                while j < e {
                    set_at(p, seq, j, ucd_bidi.BIDI_EN)
                    j = j + 1
                }
            }
            k = e
        } else {
            k = k + 1
        }
    }
    // ---- W6: the remaining separators become ON.
    k = 0
    while k < m {
        let c: u8 = cls_at(p, seq, k)
        if c == ucd_bidi.BIDI_ES || c == ucd_bidi.BIDI_ET
        || c == ucd_bidi.BIDI_CS {
            set_at(p, seq, k, ucd_bidi.BIDI_ON)
        }
        k = k + 1
    }
    // ---- W7: EN after an L (or sos = L) becomes L.
    var ls2: u8 = sos
    k = 0
    while k < m {
        let c: u8 = cls_at(p, seq, k)
        if c == ucd_bidi.BIDI_L || c == ucd_bidi.BIDI_R {
            ls2 = c
        } else if c == ucd_bidi.BIDI_EN && ls2 == ucd_bidi.BIDI_L {
            set_at(p, seq, k, ucd_bidi.BIDI_L)
        }
        k = k + 1
    }

    // ---- N0: die Klammerpaare
    pair_brackets(p, seq, m, lv, sos)

    // ---- N1/N2: neutrals between equal strong sides take their
    // direction, all others that of the embedding.
    let emb: u8 = dir_of_level(lv)
    k = 0
    while k < m {
        if is_ni(cls_at(p, seq, k)) {
            var e: usize = k
            while e < m && is_ni(cls_at(p, seq, e)) {
                e = e + 1
            }
            var lead: u8 = sos
            if k > 0 {
                lead = strong_n(cls_at(p, seq, k - 1))
            }
            var trail: u8 = eos
            if e < m {
                trail = strong_n(cls_at(p, seq, e))
            }
            var to: u8 = emb
            if lead == trail && lead != 255 as u8 {
                to = lead
            }
            var j: usize = k
            while j < e {
                set_at(p, seq, j, to)
                j = j + 1
            }
            k = e
        } else {
            k = k + 1
        }
    }
}

// ======================================================================
// N0 -- BRACKET PAIRS
// ======================================================================
//
// BD16: brackets are looked for in pairs, and only those whose
// current type is ON (a bracket overridden by LRO/RLO is
// no longer one). Comparison is through the canonical equivalent, so that
// U+2329 matches U+3009.
//
// Then per pair, in the order of the opening brackets: if there is
// a strong character of the embedding direction inside, both brackets take
// this direction. If only the opposite direction is inside, the
// context BEFORE the opening bracket decides: if that is also opposite, the
// brackets take the opposite direction, otherwise that of the embedding. If nothing
// strong is inside at all, they stay neutral for N1.
#[no_gc]
fn pair_brackets(p: *mut BidiPara, seq: u64, m: usize, lv: u8, sos: u8) {
    let n: usize = (*p).n
    let bs: u64 = (*p).work + off_bstk(n) as u64
    let pr: u64 = (*p).work + off_pairs(n) as u64
    let t: u64 = (*p).t
    var sp: usize = 0
    var np: usize = 0
    var k: usize = 0
    while k < m {
        let i: usize = r32(seq, k) as usize
        if r8((*p).cls, i) == ucd_bidi.BIDI_ON {
            let c: u32 = r32((*p).cp, i)
            let ty: u8 = ucd_bidi.ucd_bracket_type(t, c)
            if ty == ucd_bidi.BRACKET_OPEN {
                if sp == BRACKET_STACK {
                    break
                }
                let want: u32 = ucd_bidi.ucd_bracket_canon(t,
                    ucd_bidi.ucd_bracket_pair(t, c))
                w32(bs, sp * 2, want)
                w32(bs, sp * 2 + 1, k as u32)
                sp = sp + 1
            } else if ty == ucd_bidi.BRACKET_CLOSE {
                let me: u32 = ucd_bidi.ucd_bracket_canon(t, c)
                var s: usize = sp
                while s > 0 {
                    s = s - 1
                    if r32(bs, s * 2) == me {
                        // sort in by the position of the opening
                        let op: u32 = r32(bs, s * 2 + 1)
                        var q: usize = np
                        while q > 0 && r32(pr, (q - 1) * 2) > op {
                            w32(pr, q * 2, r32(pr, (q - 1) * 2))
                            w32(pr, q * 2 + 1, r32(pr, (q - 1) * 2 + 1))
                            q = q - 1
                        }
                        w32(pr, q * 2, op)
                        w32(pr, q * 2 + 1, k as u32)
                        np = np + 1
                        sp = s
                        break
                    }
                }
            }
        }
        k = k + 1
    }

    let e: u8 = dir_of_level(lv)
    var o: u8 = ucd_bidi.BIDI_R
    if e == ucd_bidi.BIDI_R {
        o = ucd_bidi.BIDI_L
    }
    var q2: usize = 0
    while q2 < np {
        let ko: usize = r32(pr, q2 * 2) as usize
        let kc: usize = r32(pr, q2 * 2 + 1) as usize
        var has_e: bool = false
        var has_o: bool = false
        var j: usize = ko + 1
        while j < kc {
            let s2: u8 = strong_n(cls_at(p, seq, j))
            if s2 == e {
                has_e = true
                break
            }
            if s2 == o {
                has_o = true
            }
            j = j + 1
        }
        var to: u8 = 255 as u8
        if has_e {
            to = e
        } else if has_o {
            var ctx: u8 = sos
            var j2: usize = ko
            while j2 > 0 {
                j2 = j2 - 1
                let s3: u8 = strong_n(cls_at(p, seq, j2))
                if s3 != 255 as u8 {
                    ctx = s3
                    break
                }
            }
            if ctx == o {
                to = o
            } else {
                to = e
            }
        }
        if to != 255 as u8 {
            set_at(p, seq, ko, to)
            set_at(p, seq, kc, to)
            // An NSM directly behind a bracket changed in this way had become
            // ON after W1; it now follows its bracket.
            var a1: usize = ko + 1
            while a1 < m && r8((*p).cls0, r32(seq, a1) as usize)
            == ucd_bidi.BIDI_NSM {
                set_at(p, seq, a1, to)
                a1 = a1 + 1
            }
            var a2: usize = kc + 1
            while a2 < m && r8((*p).cls0, r32(seq, a2) as usize)
            == ucd_bidi.BIDI_NSM {
                set_at(p, seq, a2, to)
                a2 = a2 + 1
            }
        }
        q2 = q2 + 1
    }
}

// ======================================================================
// L1 -- THE LEVELS OF A LINE
// ======================================================================
//
// After the line break, per line: segment and paragraph separators, all whitespace
// before them and all whitespace at the line end fall to the paragraph level.
// Whitespace here means WS and the isolate characters -- and the characters
// removed by X9 that stand in between. What is asked is the
// ORIGINAL class: a space that N1 has made R is
// still whitespace at the line end. Without this rule the
// space at the end of an Arabic line hangs to the left of the first word
// of the line, and the line looks indented.
//
// `out` gets the levels of the characters from..to-1, from position 0.
#[no_gc]
fn bidi_line_levels(p: *mut BidiPara, from: usize, to: usize, out: u64) {
    var i: usize = from
    while i < to {
        w8(out, i - from, r8((*p).lev, i))
        i = i + 1
    }
    if to <= from {
        return
    }
    var trailing: bool = true
    var k: usize = to
    while k > from {
        k = k - 1
        let c: u8 = r8((*p).cls0, k)
        let para: u8 = r8((*p).pl, k)
        if c == ucd_bidi.BIDI_S || c == ucd_bidi.BIDI_B {
            w8(out, k - from, para)
            trailing = true
        } else if c == ucd_bidi.BIDI_WS || is_isolate_init(c)
        || c == ucd_bidi.BIDI_PDI || bidi_is_removed(c) {
            if trailing {
                w8(out, k - from, para)
            }
        } else {
            trailing = false
        }
    }
}

// ======================================================================
// L2 -- THE ORDER ON THE SCREEN
// ======================================================================
//
// `lv` holds the levels of a line (after L1), `order` gets per
// screen position the LOGICAL position (0..n-1). From the highest level
// down to the lowest odd one every contiguous
// stretch with at least this level is reversed.
#[no_gc]
fn bidi_reorder(lv: u64, n: usize, order: u64) {
    var i: usize = 0
    var hi: u8 = 0 as u8
    var lo_odd: u8 = 255 as u8
    while i < n {
        w32(order, i, i as u32)
        let l: u8 = r8(lv, i)
        if l > hi {
            hi = l
        }
        if (l & 1 as u8) != 0 as u8 && l < lo_odd {
            lo_odd = l
        }
        i = i + 1
    }
    if lo_odd == 255 as u8 {
        return
    }
    var cur: u8 = hi
    while cur >= lo_odd {
        var s: usize = 0
        while s < n {
            if r8(lv, r32(order, s) as usize) >= cur {
                var e: usize = s
                while e < n && r8(lv, r32(order, e) as usize) >= cur {
                    e = e + 1
                }
                var x: usize = s
                var y: usize = e - 1
                while x < y {
                    let tmp: u32 = r32(order, x)
                    w32(order, x, r32(order, y))
                    w32(order, y, tmp)
                    x = x + 1
                    y = y - 1
                }
                s = e
            } else {
                s = s + 1
            }
        }
        if cur == 0 as u8 {
            break
        }
        cur = cur - 1 as u8
    }
}
