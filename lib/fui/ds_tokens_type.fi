// SPDX-License-Identifier: MPL-2.0
export {
    T_CAPTION, T_BODY, T_BODY_LARGE, T_SUBTITLE, T_TITLE, T_TITLE_LARGE, T_BODY_STRONG, T_DISPLAY, T_COUNT,
    W_REGULAR, W_SEMIBOLD, TypeSpec, spec, size_px, line_px, weight_of,
}

const T_CAPTION: usize = 0
const T_BODY: usize = 1
const T_BODY_LARGE: usize = 2
const T_SUBTITLE: usize = 3
const T_TITLE: usize = 4
const T_TITLE_LARGE: usize = 5
const T_BODY_STRONG: usize = 6
const T_DISPLAY: usize = 7
const T_COUNT: usize = 8

const W_REGULAR: usize = 400
const W_SEMIBOLD: usize = 600

struct TypeSpec {
    size: usize,
    line: usize,
    weight: usize,
}

#[no_gc]
fn spec(role: usize) -> TypeSpec {
    if role == T_CAPTION { return TypeSpec { size: 12, line: 16, weight: W_REGULAR } }
    if role == T_BODY { return TypeSpec { size: 14, line: 20, weight: W_REGULAR } }
    if role == T_BODY_LARGE { return TypeSpec { size: 18, line: 24, weight: W_REGULAR } }
    if role == T_SUBTITLE { return TypeSpec { size: 20, line: 28, weight: W_SEMIBOLD } }
    if role == T_TITLE { return TypeSpec { size: 28, line: 36, weight: W_SEMIBOLD } }
    if role == T_BODY_STRONG { return TypeSpec { size: 14, line: 20, weight: W_SEMIBOLD } }
    if role == T_DISPLAY { return TypeSpec { size: 68, line: 92, weight: W_SEMIBOLD } }
    return TypeSpec { size: 40, line: 52, weight: W_SEMIBOLD }
}

#[no_gc]
fn size_px(role: usize) -> usize {
    return spec(role).size
}

#[no_gc]
fn line_px(role: usize) -> usize {
    return spec(role).line
}

#[no_gc]
fn weight_of(role: usize) -> usize {
    return spec(role).weight
}
