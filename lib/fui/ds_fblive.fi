import std.hash
import fui.screenax
import fui.ds_fbtok

export { announce, text_hash }

fn text_hash(s: str) -> u32 {
    let h: u32 = hash.fnv1a32(s.p as u64, s.n)
    if h == 0 as u32 { return 1 as u32 }
    return h
}

fn announce(kind: u32, text: str) {
    if kind == ds_fbtok.WARNING || kind == ds_fbtok.ERROR {
        screenax.announce_assertive(text)
    } else {
        screenax.announce_polite(text)
    }
}
