// SPDX-License-Identifier: MPL-2.0
// lib/fui/kitscroll.fi -- vertical wheel scroll state for immediate-mode screen apps.
//
//   scroll_new   zeroed state
//   scroll_fit   after laying out: content and view height, clamps the position
//   scroll_by    wheel notches (dy > 0 = down); true when the position moved
//   scroll_arg   --scroll N on the command line (for shots)
import fui.screen

struct Scroll {
    pos: f64,
    max: f64,
    step: f64,
}

fn scroll_new() -> Scroll {
    return Scroll { pos: 0.0, max: 0.0, step: 48.0 }
}

fn scroll_fit(s: *mut Scroll, content: f64, view: f64, step: f64) {
    (*s).step = step
    (*s).max = content - view
    if (*s).max < 0.0 { (*s).max = 0.0 }
    if (*s).pos > (*s).max { (*s).pos = (*s).max }
    if (*s).pos < 0.0 { (*s).pos = 0.0 }
}

fn scroll_by(s: *mut Scroll, dy: f64) -> bool {
    let old: f64 = (*s).pos
    var p: f64 = old + dy * (*s).step
    if p > (*s).max { p = (*s).max }
    if p < 0.0 { p = 0.0 }
    (*s).pos = p
    return p != old
}

fn scroll_arg(s: *mut Scroll, start: u64) {
    let ap: u64 = screen.arg_after(start, "--scroll")
    if ap == 0 { return }
    var v: f64 = 0.0
    var k: usize = 0
    while *((ap + k as u64) as *mut u8) >= 48 as u8 && *((ap + k as u64) as *mut u8) <= 57 as u8 {
        v = v * 10.0 + (*((ap + k as u64) as *mut u8) - 48 as u8) as f64
        k = k + 1
    }
    (*s).pos = v
    (*s).max = v
}
