// SPDX-License-Identifier: MPL-2.0
// lib/fui/uisvg.fi -- AN SVG SYMBOL ON A CONTROL.
//
// ========================================================= WHY SO
//
// THIS FILE WRITES NO SVG READER. It is the seam to
// `lib/svg`, and that is a deliberate decision that an earlier
// version of this round had made wrongly.
//
// ------------------------------------------- THE OBJECTION AND WHAT IT MEANS
//
// In the head of lib/fui/painter.fi there stands:
//
//     "Certus rounds with `svg.pfad.pfad_rund_rechteck`. lib/svg does NOT
//      exist in the Firn tree ... and fUi must not hang on an application
//      library."
//
// The FIRST half sentence was right for the Firn tree and is now
// outdated: `lib/svg` IS here, ported on 13.09.2026 from the
// Certus tree (7581 lines, seven of eight files byte-identical).
//
// The SECOND half sentence is the actual point, and it stays valid --
// but it does not say "SVG is forbidden", but "fUi must not hang on
// lib/browser". MEASURED (13.09.2026): `lib/svg` imports
// exclusively
//
//     html.mem   font.raster   font.ttf   font.metrics
//     paint.canvas   paint.png   svg.*
//
// and NOT ONCE `browser`, `css`, `dom` or `js`. It is thereby
// a graphics library on the same layer as `lib/font` and
// `lib/paint`, which fUi uses anyway -- and no application library.
// The objection does not hit it.
//
// ------------------------------------------------- WHY NO SECOND READER
//
// The first version of this round built a small path reader of its own
// (lib/fui/svg.fi, around 1250 lines), because the job said there
// was no lib/svg. That one is DELETED, and that is the right answer:
//
//   * The project rule "no second place for the same thing" exists exactly
//     for this reason -- in the project the same window element has already arisen
//     twice in duplicate.
//   * lib/svg can do considerably more: `use`/`symbol`, the `style` attribute,
//     `preserveAspectRatio`, gradients, real stroking with joins
//     and caps, text elements. The reader of its own could do none of that.
//   * Two readers mean: a symbol looks different in Certus from in
//     OrientOS, and nobody notices until Justin lays the two side by side.
//
// ============================================== HOW THE SYMBOL GETS HERE
//
// `svg.image.svg_zu_bild_gross` rasterises SVG octets into a
// `png.Image` of a GIVEN size. Exactly that is the right seam:
//
//   * Rasterising is done at the TARGET size, not at the intrinsic size
//     with subsequent scaling. A path has no resolution -- a
//     symbol at 16 and at 64 points is rasterised twice SHARP
//     instead of once rasterised and then enlarged. That is the whole
//     reason to hold a symbol as SVG and not as PNG.
//   * The result is an image store, and that can
//     lib/fui/image.fi already draw -- with alpha and with tint. So there is
//     NO second drawing path for SVG.
//
// ================================================ THE ACCENT COLOUR
//
// Justin, 13.09.2026: tinted surfaces are to draw the accent colour from
// theme.fi (TOK_ACCENT / TOK_TEXT_ON_ACCENT), because two other
// rounds switch the surfaces to it.
//
// SVG has `currentColor` for that, and `lib/svg` already supports it
// (color.F_AKTUELL, `Zustand.aktuell`). TWO WAYS stand open here, and
// both lead to the theme colour:
//
//   1. `icon_render_tinted` gives the colour as `currentColor` INTO the
//      rasteriser. A symbol that writes `fill="currentColor"` -- that is how
//      Lucide, Feather and Material deliver their symbols -- takes it
//      on, and correctly per surface: a two-colour symbol
//      keeps its second colour.
//   2. `w_set_art_tint` on the widget paints the ALPHA mask of the finished
//      image in one colour. That works on every symbol, also on one
//      with a hard-wired `fill="#333"`, but makes it single-colour.
//
// Way 1 is the right one and is preferred; way 2 is the emergency measure for
// foreign symbols. Both fetch the colour via `render.color_of` from the
// theme and not from a fixed number.
//
// ==================================================== WHO OWNS WHAT
//
// A rasterised symbol is a `png.Image` and it belongs to the CALLER
// (the same rule as the text, widget.fi E1). `icon_render` creates it,
// `icon_free` gives it back. The widget holds only the pointer.
//
// RASTERISING IS NOT FREE -- it walks the XML tree and the paths. A
// symbol is therefore rasterised ONCE on a size change and then
// only blitted at every frame build. Whoever re-rasterises per frame
// pays for the parser sixty times per second.
import paint.png
import svg.image
import fui.uiimage

export {
    Icon, icon_new, icon_render, icon_free, icon_view, icon_ok,
    icon_w, icon_h, is_svg,
}

// EIN GERASTERTES SYMBOL. Der Bildspeicher gehoert dem AUFRUFER, genau wie
// der Text eines Labels (widget.fi E1) -- diese Struktur haelt ihn, damit
// der Aufrufer ihn nicht selbst verwalten muss, und `icon_free` gibt ihn
// zurueck.
//
// `at` ist die Kantenlaenge, bei der gerastert wurde. Wer dasselbe Symbol
// groesser braucht, rastert neu -- das ist der ganze Vorteil gegenueber
// einem PNG, und `icon_render` prueft es selbst.
struct Icon {
    im: png.Image,
    at_w: usize,
    at_h: usize,
}

fn icon_new() -> Icon {
    return Icon { im: png.image_new(), at_w: 0, at_h: 0 }
}

fn icon_ok(ic: *mut Icon) -> bool {
    return png.image_ok(&(*ic).im)
}

fn icon_w(ic: *mut Icon) -> usize { return (*ic).at_w }
fn icon_h(ic: *mut Icon) -> usize { return (*ic).at_h }

// Sind das SVG-Oktette? Weitergereicht an lib/svg, damit die Antwort an
// EINER Stelle steht -- ein Aufrufer, der `<?xml` oder einen Kommentar vor
// dem `<svg` hat, bekommt dieselbe Antwort wie Certus.
fn is_svg(p: u64, n: usize) -> bool {
    return image.ist_svg(p, n)
}

// SYMBOL RASTERN, in genau dieser Pixelgroesse.
//
// `aktuell` ist die Farbe, die `currentColor` im Dokument annimmt -- hier
// gibt der Aufrufer die Akzentfarbe des Themas herein (siehe der Kopf
// dieser Datei). 0 heisst Schwarz, also der SVG-Standard.
//
// EINE FARBE OHNE ALPHA WIRD DECKEND GEMACHT. Die Themenfarben stehen als
// 0x00RRGGBB da; ohne diese Zeile malt lib/svg korrekt nichts. Der Grund
// steht ausgeschrieben im Rumpf.
//
// `fm` ist der Schriftsatz fuer ein `<text>` im Symbol, 0 wenn es keinen
// gibt. Ein Symbol ohne Textelement braucht ihn nicht, und im
// Kernel-Profil gibt es ohnehin keine Schrift.
//
// WIRD NEU GERASTERT, wenn sich die Groesse geaendert hat, und sonst
// nicht. Rastern laeuft den XML-Baum und alle Pfade ab; wer das pro
// Bildaufbau macht, bezahlt den Zerteiler sechzigmal je Sekunde.
fn icon_render(ic: *mut Icon, src: u64, n: usize, w: usize, h: usize,
    aktuell: u32, fm: u64) -> bool {
    if w == 0 || h == 0 {
        return false
    }
    if png.image_ok(&(*ic).im) && (*ic).at_w == w && (*ic).at_h == h {
        return true
    }
    icon_free(ic)
    // DIE DECKUNG WIRD ERZWUNGEN, und das ist kein Schoenheitsfehler,
    // sondern eine Falle, in die diese Runde selbst getappt ist:
    //
    // Die Farben im Thema stehen als 0x00RRGGBB da -- OHNE Alpha. Jeder
    // Malaufruf in fUi schiebt sie durch `theme.opaque()` (painter.fi
    // macht das in `flush_raster` und in `round_rect`), also faellt das
    // nie auf. Wer die Farbe aber, wie hier, an eine FREMDE Schicht
    // weitergibt, reicht Alpha 0 weiter -- und lib/svg malt daraufhin
    // voellig korrekt: gar nichts.
    //
    // GEMESSEN (13.09.2026): `render.color_of(c, TOK_ACCENT)` gab 24799
    // = 0x000060DF. Die Akzent-Leiter im Belegbild war komplett leer, und
    // im Quelltext war nichts zu sehen -- genau die Sorte Fehler, die nur
    // im Bild auffaellt.
    //
    // Darum hier und nicht beim Aufrufer: sonst muss sich jeder, der ein
    // Symbol einfaerbt, an `| 0xFF000000` erinnern.
    var col: u32 = aktuell
    if (col & 4278190080 as u32) == 0 as u32 {
        col = col | 4278190080 as u32
    }
    if col == 4278190080 as u32 && aktuell == 0 as u32 {
        // 0 heisst "nichts vorgegeben" -> der SVG-Standard ist Schwarz.
        col = 4278190080 as u32
    }
    if !image.svg_too_image_color(src, n, &(*ic).im, fm, w, h, col) {
        return false
    }
    (*ic).at_w = w
    (*ic).at_h = h
    return true
}

fn icon_free(ic: *mut Icon) {
    if png.image_ok(&(*ic).im) {
        png.image_free(&(*ic).im)
    }
    (*ic).im = png.image_new()
    (*ic).at_w = 0
    (*ic).at_h = 0
}

// DER BLICK DARAUF, den ein Widget haelt.
//
// Das gerasterte Symbol ist ein `png.Image` mit geradem RGBA, und
// `fui.image` zeichnet genau das -- mit Alpha und, wenn noetig, mit
// Toenung. Es gibt also KEINEN zweiten Zeichenweg fuer SVG: ab hier ist
// ein Symbol dasselbe wie ein PNG.
fn icon_view(ic: *mut Icon) -> uiimage.Image {
    if !png.image_ok(&(*ic).im) {
        return uiimage.image_new()
    }
    return uiimage.image_wrap((*ic).im.px as u64,
        png.image_width(&(*ic).im), png.image_height(&(*ic).im), 0)
}
