// SPDX-License-Identifier: MPL-2.0
// lib/fui/uisvg.fi -- EIN SVG-SYMBOL AUF EINEM BEDIENELEMENT.
//
// ========================================================= WARUM SO
//
// DIESE DATEI SCHREIBT KEINEN SVG-LESER. Sie ist die Naht zu
// `lib/svg`, und das ist eine bewusste Entscheidung, die eine frühere
// Fassung dieser Runde falsch getroffen hatte.
//
// ------------------------------------------- DER EINWAND UND WAS ER MEINT
//
// Im Kopf von lib/fui/painter.fi steht:
//
//     "Certus rundet mit `svg.pfad.pfad_rund_rechteck`. lib/svg does NOT
//      exist in the Firn tree ... and fUi must not hang on an application
//      library."
//
// Der ERSTE Halbsatz war für den Firn-Baum richtig und ist jetzt
// überholt: `lib/svg` IST hier, portiert am 13.09.2026 aus dem
// Certus-Baum (7581 Zeilen, sieben von acht Dateien byte-identisch).
//
// Der ZWEITE Halbsatz ist der eigentliche Punkt, und er bleibt gültig --
// er sagt aber nicht "SVG ist verboten", sondern "fUi darf nicht an
// lib/browser hängen". GEMESSEN (13.09.2026): `lib/svg` importiert
// ausschliesslich
//
//     html.mem   font.raster   font.ttf   font.metrics
//     paint.canvas   paint.png   svg.*
//
// und KEIN einziges Mal `browser`, `css`, `dom` oder `js`. Es ist damit
// eine Grafikbibliothek auf derselben Schicht wie `lib/font` und
// `lib/paint`, die fUi ohnehin benutzt -- und keine Anwendungsbibliothek.
// Der Einwand trifft sie nicht.
//
// ------------------------------------------------- WARUM KEIN ZWEITER LESER
//
// Die erste Fassung dieser Runde hat einen eigenen, kleinen Pfadleser
// gebaut (lib/fui/svg.fi, rund 1250 Zeilen), weil der Auftrag sagte, es
// gebe kein lib/svg. Der ist GELÖSCHT, und das ist die richtige Antwort:
//
//   * Die Projektregel "kein zweiter Ort für dieselbe Sache" ist genau
//     deswegen da -- im Projekt ist dasselbe Fenster-Element schon
//     zweimal doppelt entstanden.
//   * lib/svg kann erheblich mehr: `use`/`symbol`, das `style`-Attribut,
//     `preserveAspectRatio`, Verläufe, echtes Bestreichen mit Verbindungen
//     und Enden, Textelemente. Der eigene Leser konnte davon nichts.
//   * Zwei Leser heissen: ein Symbol sieht in Certus anders aus als in
//     OrientOS, und niemand merkt es, bis Justin die beiden nebeneinander
//     legt.
//
// ============================================== WIE DAS SYMBOL HIERHER KOMMT
//
// `svg.image.svg_zu_bild_gross` rastert SVG-Oktette in ein
// `png.Image` einer VORGEGEBENEN Grösse. Genau das ist die richtige Naht:
//
//   * Gerastert wird in der ZIELGROSSE, nicht in der Eigengrösse mit
//     anschliessendem Skalieren. Ein Pfad hat keine Auflösung -- ein
//     Symbol bei 16 und bei 64 Punkten wird zweimal SCHARF gerastert
//     statt einmal gerastert und dann vergrössert. Das ist der ganze
//     Grund, ein Symbol als SVG und nicht als PNG zu halten.
//   * Das Ergebnis ist ein Bildspeicher, und den kann
//     lib/fui/image.fi schon zeichnen -- mit Alpha und mit Tönung. Es
//     gibt also KEINEN zweiten Zeichenweg für SVG.
//
// ================================================ DIE AKZENTFARBE
//
// Justin, 13.09.2026: eingefärbte Flächen sollen die Akzentfarbe aus
// theme.fi ziehen (TOK_ACCENT / TOK_TEXT_ON_ACCENT), weil zwei andere
// Runden die Oberflächen darauf umstellen.
//
// SVG hat dafür `currentColor`, und `lib/svg` unterstützt es bereits
// (color.F_AKTUELL, `Zustand.aktuell`). ZWEI WEGE stehen hier offen, und
// beide führen zur Themenfarbe:
//
//   1. `icon_render_tinted` gibt die Farbe als `currentColor` IN den
//      Rasterer. Ein Symbol, das `fill="currentColor"` schreibt -- so
//      liefern Lucide, Feather und Material ihre Symbole aus -- nimmt sie
//      damit an, und zwar pro Fläche richtig: ein zweifarbiges Symbol
//      behält seine zweite Farbe.
//   2. `w_set_art_tint` auf dem Widget malt die ALPHA-Maske des fertigen
//      Bildes in einer Farbe. Das wirkt auf jedes Symbol, auch auf eines
//      mit fest verdrahtetem `fill="#333"`, macht es aber einfarbig.
//
// Weg 1 ist der richtige und wird bevorzugt; Weg 2 ist der Notnagel für
// fremde Symbole. Beide holen die Farbe über `render.color_of` aus dem
// Thema und nicht aus einer festen Zahl.
//
// ==================================================== WER WAS BESITZT
//
// Ein gerastertes Symbol ist ein `png.Image` und der gehört dem AUFRUFER
// (dieselbe Regel wie der Text, widget.fi E1). `icon_render` legt ihn an,
// `icon_free` gibt ihn zurück. Das Widget hält nur den Zeiger.
//
// RASTERN IST NICHT GRATIS -- es läuft den XML-Baum und die Pfade ab. Ein
// Symbol wird deshalb EINMAL bei der Grössenänderung gerastert und dann
// bei jedem Bildaufbau nur noch geblittet. Wer pro Bild neu rastert,
// bezahlt den Zerteiler sechzigmal je Sekunde.
import paint.png
import svg.image
import fui.uiimage

export {
    Icon, icon_new, icon_render, icon_free, icon_view, icon_ok,
    icon_w, icon_h, is_svg,
}

// EIN GERASTERTES SYMBOL. Der Bildspeicher gehoert dem AUFRUFER, genau wie
// der Text eines Labels (widget.fi E1) -- diese Struktur haelt ihn, damit
// der Aufrufer ihn nicht selbst verwalten muss, und `icon_free` gibt ihn
// zurueck.
//
// `at` ist die Kantenlaenge, bei der gerastert wurde. Wer dasselbe Symbol
// groesser braucht, rastert neu -- das ist der ganze Vorteil gegenueber
// einem PNG, und `icon_render` prueft es selbst.
struct Icon {
    im: png.Image,
    at_w: usize,
    at_h: usize,
}

fn icon_new() -> Icon {
    return Icon { im: png.image_new(), at_w: 0, at_h: 0 }
}

fn icon_ok(ic: *mut Icon) -> bool {
    return png.image_ok(&(*ic).im)
}

fn icon_w(ic: *mut Icon) -> usize { return (*ic).at_w }
fn icon_h(ic: *mut Icon) -> usize { return (*ic).at_h }

// Sind das SVG-Oktette? Weitergereicht an lib/svg, damit die Antwort an
// EINER Stelle steht -- ein Aufrufer, der `<?xml` oder einen Kommentar vor
// dem `<svg` hat, bekommt dieselbe Antwort wie Certus.
fn is_svg(p: u64, n: usize) -> bool {
    return image.ist_svg(p, n)
}

// SYMBOL RASTERN, in genau dieser Pixelgroesse.
//
// `aktuell` ist die Farbe, die `currentColor` im Dokument annimmt -- hier
// gibt der Aufrufer die Akzentfarbe des Themas herein (siehe der Kopf
// dieser Datei). 0 heisst Schwarz, also der SVG-Standard.
//
// EINE FARBE OHNE ALPHA WIRD DECKEND GEMACHT. Die Themenfarben stehen als
// 0x00RRGGBB da; ohne diese Zeile malt lib/svg korrekt nichts. Der Grund
// steht ausgeschrieben im Rumpf.
//
// `fm` ist der Schriftsatz fuer ein `<text>` im Symbol, 0 wenn es keinen
// gibt. Ein Symbol ohne Textelement braucht ihn nicht, und im
// Kernel-Profil gibt es ohnehin keine Schrift.
//
// WIRD NEU GERASTERT, wenn sich die Groesse geaendert hat, und sonst
// nicht. Rastern laeuft den XML-Baum und alle Pfade ab; wer das pro
// Bildaufbau macht, bezahlt den Zerteiler sechzigmal je Sekunde.
fn icon_render(ic: *mut Icon, src: u64, n: usize, w: usize, h: usize,
    aktuell: u32, fm: u64) -> bool {
    if w == 0 || h == 0 {
        return false
    }
    if png.image_ok(&(*ic).im) && (*ic).at_w == w && (*ic).at_h == h {
        return true
    }
    icon_free(ic)
    // DIE DECKUNG WIRD ERZWUNGEN, und das ist kein Schoenheitsfehler,
    // sondern eine Falle, in die diese Runde selbst getappt ist:
    //
    // Die Farben im Thema stehen als 0x00RRGGBB da -- OHNE Alpha. Jeder
    // Malaufruf in fUi schiebt sie durch `theme.opaque()` (painter.fi
    // macht das in `flush_raster` und in `round_rect`), also faellt das
    // nie auf. Wer die Farbe aber, wie hier, an eine FREMDE Schicht
    // weitergibt, reicht Alpha 0 weiter -- und lib/svg malt daraufhin
    // voellig korrekt: gar nichts.
    //
    // GEMESSEN (13.09.2026): `render.color_of(c, TOK_ACCENT)` gab 24799
    // = 0x000060DF. Die Akzent-Leiter im Belegbild war komplett leer, und
    // im Quelltext war nichts zu sehen -- genau die Sorte Fehler, die nur
    // im Bild auffaellt.
    //
    // Darum hier und nicht beim Aufrufer: sonst muss sich jeder, der ein
    // Symbol einfaerbt, an `| 0xFF000000` erinnern.
    var col: u32 = aktuell
    if (col & 4278190080 as u32) == 0 as u32 {
        col = col | 4278190080 as u32
    }
    if col == 4278190080 as u32 && aktuell == 0 as u32 {
        // 0 heisst "nichts vorgegeben" -> der SVG-Standard ist Schwarz.
        col = 4278190080 as u32
    }
    if !image.svg_too_image_color(src, n, &(*ic).im, fm, w, h, col) {
        return false
    }
    (*ic).at_w = w
    (*ic).at_h = h
    return true
}

fn icon_free(ic: *mut Icon) {
    if png.image_ok(&(*ic).im) {
        png.image_free(&(*ic).im)
    }
    (*ic).im = png.image_new()
    (*ic).at_w = 0
    (*ic).at_h = 0
}

// DER BLICK DARAUF, den ein Widget haelt.
//
// Das gerasterte Symbol ist ein `png.Image` mit geradem RGBA, und
// `fui.image` zeichnet genau das -- mit Alpha und, wenn noetig, mit
// Toenung. Es gibt also KEINEN zweiten Zeichenweg fuer SVG: ab hier ist
// ein Symbol dasselbe wie ein PNG.
fn icon_view(ic: *mut Icon) -> uiimage.Image {
    if !png.image_ok(&(*ic).im) {
        return uiimage.image_new()
    }
    return uiimage.image_wrap((*ic).im.px as u64,
        png.image_width(&(*ic).im), png.image_height(&(*ic).im), 0)
}
