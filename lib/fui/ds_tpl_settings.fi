import std.rt
import paint.canvas
import fui.ds_iconbtn
import fui.ds_icons_full
import fui.ds_navview
import fui.ds_settings
import fui.ds_swatch
import fui.ds_tokens
import fui.editor
import fui.kit
import fui.kitcolor
import fui.kitform
import fui.painter
import fui.render
import fui.screen
import fui.style
import fui.theme
import plat.fuiwirt

const NONE: usize = 18446744073709551615
const CAP: usize = 64
const IDS: usize = 48
const K_SECTION: u32 = 1
const K_TOGGLE: u32 = 2
const K_COMBO: u32 = 3
const K_SLIDER: u32 = 4
const K_LINK: u32 = 5
const K_VALUE: u32 = 6
const K_BUTTON: u32 = 7
const K_SWATCH: u32 = 8
const BACK_ID: usize = 0
const MAX_PAGES: usize = 12

static mut ACCENT: usize = 0

struct Item {
    kind: u32,
    id: usize,
    icon: i64,
    title: str,
    sub: str,
    extra: str,
    lo: i64,
    hi: i64,
    page: usize,
}

struct Tpl {
    items: [Item; 64],
    n: usize,
    pages: usize,
    picon: [i64; 12],
    page: usize,
    opened: bool,
    seen: [i64; 48],
    rev: u64,
    scroll: f64,
    content_h: f64,
    view_y: f64,
    view_h: f64,
    stacked: bool,
    title: str,
    search_hint: str,
    empty_text: str,
    results_text: str,
    search: u64,
    sx: f64,
    sy: f64,
    sw: f64,
    sh: f64,
    panel: u64,
    list: u64,
    nav: u64,
    back: u64,
    ctx: u64,
    swatch: u64,
    swatch_id: usize,
    swatch_on: bool,
    apply: fn(u64, usize, i64),
    fire: fn(u64, usize),
    ud: u64,
}

fn tp(ud: u64) -> *mut Tpl { return ud as *mut Tpl }
fn panel_of(t: *mut Tpl) -> *mut ds_settings.Panel { return (*t).panel as *mut ds_settings.Panel }
fn list_of(t: *mut Tpl) -> *mut ds_settings.Panel { return (*t).list as *mut ds_settings.Panel }
fn nav_of(t: *mut Tpl) -> *mut ds_navview.NavView { return (*t).nav as *mut ds_navview.NavView }
fn back_of(t: *mut Tpl) -> *mut ds_iconbtn.Btns { return (*t).back as *mut ds_iconbtn.Btns }
fn swatch_of(t: *mut Tpl) -> *mut ds_swatch.Swatch { return (*t).swatch as *mut ds_swatch.Swatch }
fn search_of(t: *mut Tpl) -> *mut kit.Search { return (*t).search as *mut kit.Search }

fn no_apply(ud: u64, id: usize, v: i64) {}
fn no_fire(ud: u64, id: usize) {}

fn new(title: str, apply: fn(u64, usize, i64), fire: fn(u64, usize), ud: u64) -> *mut Tpl {
    let t: *mut Tpl = rt.heap_alloc(1 << 15) as *mut Tpl
    var i: usize = 0
    while i < CAP {
        (*t).items[i] = Item { kind: 0 as u32, id: 0, icon: 0 - 1, title: "", sub: "", extra: "", lo: 0, hi: 0, page: 0 }
        i = i + 1
    }
    i = 0
    while i < IDS {
        (*t).seen[i] = 0
        i = i + 1
    }
    (*t).n = 0
    (*t).pages = 0
    i = 0
    while i < MAX_PAGES {
        (*t).picon[i] = 0 - 1
        i = i + 1
    }
    (*t).page = 0
    (*t).opened = false
    (*t).rev = 0
    (*t).scroll = 0.0
    (*t).content_h = 0.0
    (*t).view_y = 0.0
    (*t).view_h = 0.0
    (*t).stacked = false
    (*t).title = title
    (*t).search_hint = "Find a setting"
    (*t).empty_text = "No settings found"
    (*t).results_text = "Search results"
    (*t).search = kitform.field_new() as u64
    (*t).sx = 0.0
    (*t).sy = 0.0
    (*t).sw = 0.0
    (*t).sh = 0.0
    (*t).panel = ds_settings.panel_new() as u64
    (*t).list = ds_settings.panel_new() as u64
    (*t).nav = rt.heap_alloc(1 << 13)
    *nav_of(t) = ds_navview.nv_new()
    (*t).back = ds_iconbtn.btns_new() as u64
    (*t).ctx = 0
    (*t).swatch = 0
    (*t).swatch_id = NONE
    (*t).swatch_on = false
    (*t).apply = apply
    (*t).fire = fire
    (*t).ud = ud
    return t
}

fn set_texts(t: *mut Tpl, hint: str, empty: str, results: str) {
    (*t).search_hint = hint
    (*t).empty_text = empty
    (*t).results_text = results
}

fn push(t: *mut Tpl, kind: u32, id: usize, icon: i64, title: str, sub: str, extra: str, lo: i64, hi: i64) {
    if (*t).n >= CAP { return }
    (*t).items[(*t).n] = Item { kind: kind, id: id, icon: icon, title: title, sub: sub, extra: extra, lo: lo, hi: hi, page: (*t).pages - 1 }
    (*t).n = (*t).n + 1
}

fn page(t: *mut Tpl, icon: i64, title: str) -> usize {
    if (*t).pages >= MAX_PAGES { return (*t).pages - 1 }
    ds_navview.add(nav_of(t), icon, title)
    (*t).picon[(*t).pages] = icon
    (*t).pages = (*t).pages + 1
    return (*t).pages - 1
}

fn section(t: *mut Tpl, title: str) { push(t, K_SECTION, 0, 0 - 1, title, "", "", 0, 0) }
fn toggle(t: *mut Tpl, id: usize, icon: i64, title: str, sub: str) { push(t, K_TOGGLE, id, icon, title, sub, "", 0, 0) }
fn combo(t: *mut Tpl, id: usize, icon: i64, title: str, sub: str, list: str) { push(t, K_COMBO, id, icon, title, sub, list, 0, 0) }
fn slider(t: *mut Tpl, id: usize, icon: i64, title: str, sub: str, lo: i64, hi: i64, unit: str) { push(t, K_SLIDER, id, icon, title, sub, unit, lo, hi) }
fn link(t: *mut Tpl, id: usize, icon: i64, title: str, sub: str) { push(t, K_LINK, id, icon, title, sub, "", 0, 0) }
fn value(t: *mut Tpl, id: usize, icon: i64, title: str, sub: str, shown: str) { push(t, K_VALUE, id, icon, title, sub, shown, 0, 0) }
fn button(t: *mut Tpl, id: usize, icon: i64, title: str, sub: str, label: str) { push(t, K_BUTTON, id, icon, title, sub, label, 0, 0) }

fn hex_digit(v: u32) -> u8 {
    if v < 10 as u32 { return (48 as u32 + v) as u8 }
    return (87 as u32 + v) as u8
}

fn accent_palette(buf: *mut [u8; 80], dark: bool) -> str {
    var n: usize = 0
    var i: usize = 0
    while i < ds_tokens.accent_count() {
        if i > 0 {
            (*buf)[n] = 124 as u8
            n = n + 1
        }
        let col: u32 = ds_tokens.accent_color(i, dark)
        var sh: i64 = 20
        while sh >= 0 {
            (*buf)[n] = hex_digit((col >> (sh as u32)) & 15 as u32)
            n = n + 1
            sh = sh - 4
        }
        i = i + 1
    }
    return str { p: ((&(*buf)[0]) as u64) as *mut u8, n: n }
}

fn swatch(t: *mut Tpl, id: usize, title: str, sub: str) {
    if (*t).swatch == 0 {
        (*t).swatch = ds_swatch.swatch_new() as u64
        let buf: *mut [u8; 80] = rt.heap_alloc(80) as *mut [u8; 80]
        ds_swatch.set_palette(swatch_of(t), accent_palette(buf, false), "Default|Accent 2|Accent 3|Accent 4|Accent 5|Accent 6|Accent 7|Accent 8")
        ds_swatch.set_selected(swatch_of(t), 0 as i64)
    }
    (*t).swatch_id = id
    push(t, K_SWATCH, id, 0 - 1, title, sub, "", 0, 0)
}

fn set(t: *mut Tpl, id: usize, v: i64) {
    if id == (*t).swatch_id && (*t).swatch != 0 {
        ds_swatch.set_selected(swatch_of(t), v)
        ACCENT = v as usize
    }
    ds_settings.set_val(panel_of(t), id, v)
    (*t).seen[id] = v
}

fn get(t: *mut Tpl, id: usize) -> i64 { return ds_settings.val(panel_of(t), id) }

fn ctx(t: *mut Tpl) -> *mut render.Ctx { return (*t).ctx as *mut render.Ctx }

fn lower(b: u8) -> u8 {
    if b >= 65 as u8 && b <= 90 as u8 { return b + 32 as u8 }
    return b
}

fn contains(hay: str, needle: str) -> bool {
    if needle.n == 0 { return true }
    if needle.n > hay.n { return false }
    var i: usize = 0
    while i + needle.n <= hay.n {
        var j: usize = 0
        while j < needle.n && lower(rt.ld8(hay.p as u64, i + j)) == lower(rt.ld8(needle.p as u64, j)) {
            j = j + 1
        }
        if j == needle.n { return true }
        i = i + 1
    }
    return false
}

fn query(t: *mut Tpl) -> str { return kitform.field_text(search_of(t)) }
fn searching(t: *mut Tpl) -> bool { return query(t).n > 0 }

fn shown(t: *mut Tpl, i: usize) -> bool {
    let it: *mut Item = &(*t).items[i]
    if searching(t) {
        if (*it).kind == K_SECTION { return false }
        return contains((*it).title, query(t)) || contains((*it).sub, query(t))
    }
    return (*it).page == (*t).page
}

fn count_shown(t: *mut Tpl) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < (*t).n {
        if shown(t, i) && (*t).items[i].kind != K_SECTION { n = n + 1 }
        i = i + 1
    }
    return n
}

fn page_title(t: *mut Tpl) -> str {
    if searching(t) { return (*t).results_text }
    return ds_navview.label_at(nav_of(t), (*t).page)
}

fn draw_item(t: *mut Tpl, c: *mut render.Ctx, i: usize) {
    let p: *mut ds_settings.Panel = panel_of(t)
    let it: *mut Item = &(*t).items[i]
    let k: u32 = (*it).kind
    if k == K_SECTION {
        ds_settings.advance(p, kit.ln(c, 16))
        kit.draw_label(c, (*p).x, ds_settings.y_end(p), kit.ln(c, 20), kit.ln(c, 14), 600, kit.tokc(c, style.TOK_TEXT), (*it).title, 0.0)
        ds_settings.advance(p, kit.ln(c, 28))
        return
    }
    if k == K_TOGGLE { ds_settings.row_toggle(p, c, (*it).id, (*it).icon, (*it).title, (*it).sub) }
    if k == K_COMBO { ds_settings.row_combo(p, c, (*it).id, (*it).icon, (*it).title, (*it).sub, (*it).extra) }
    if k == K_SLIDER { ds_settings.row_slider(p, c, (*it).id, (*it).icon, (*it).title, (*it).sub, (*it).lo, (*it).hi, (*it).extra) }
    if k == K_LINK { ds_settings.row_chevron(p, c, (*it).id, (*it).icon, (*it).title, (*it).sub) }
    if k == K_VALUE { ds_settings.row_value(p, c, (*it).id, (*it).icon, (*it).title, (*it).sub, (*it).extra, true) }
    if k == K_BUTTON { ds_settings.row_button(p, c, (*it).id, (*it).icon, (*it).title, (*it).sub, (*it).extra) }
    if k == K_SWATCH {
        let sx: f64 = (*p).x
        let sy: f64 = ds_settings.y_end(p)
        kit.draw_label(c, sx, sy + kit.ln(c, 8), kit.ln(c, 20), kit.ln(c, 14), 400, kit.tokc(c, style.TOK_TEXT), (*it).title, 0.0)
        let sh: f64 = ds_swatch.draw(swatch_of(t), c, sx, sy + kit.ln(c, 36), (*p).w, (*it).title, (*p).px, (*p).py)
        (*t).swatch_on = true
        ds_settings.advance(p, kit.ln(c, 36) + sh + kit.ln(c, 12))
    }
}

fn draw_rows(t: *mut Tpl, c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, px: f64, py: f64) {
    let p: *mut ds_settings.Panel = panel_of(t)
    (*t).swatch_on = false
    (*t).view_y = y
    (*t).view_h = h
    var room: f64 = (*t).content_h - h
    if room < 0.0 { room = 0.0 }
    if (*t).scroll > room { (*t).scroll = room }
    if (*t).scroll < 0.0 { (*t).scroll = 0.0 }
    let cv: *mut canvas.Canvas = painter.painter_canvas(render.ctx_painter(c))
    let pushed: bool = canvas.clip_push_rect(cv, x - kit.ln(c, 8), y, x + w + kit.ln(c, 8), y + h)
    var vx: f64 = px
    var vy: f64 = py
    if py < y || py >= y + h {
        vx = 0.0 - 1.0
        vy = 0.0 - 1.0
    }
    let top: f64 = y - (*t).scroll
    ds_settings.begin(p, c, x, top, w, vx, vy)
    var i: usize = 0
    while i < (*t).n {
        if shown(t, i) { draw_item(t, c, i) }
        i = i + 1
    }
    if count_shown(t) == 0 {
        kit.draw_label(c, x, top + kit.ln(c, 8), kit.ln(c, 20), kit.ln(c, 14), 400, kit.tokc(c, style.TOK_TEXT_MUTED), (*t).empty_text, 0.0)
        ds_settings.advance(p, kit.ln(c, 36))
    }
    (*t).content_h = ds_settings.y_end(p) - top + kit.ln(c, 24)
    if pushed { canvas.clip_pop(cv) }
    ds_settings.end(p, c)
}

fn draw_search(t: *mut Tpl, c: *mut render.Ctx, x: f64, y: f64, w: f64, px: f64, py: f64) {
    (*t).sx = x
    (*t).sy = y
    (*t).sw = w
    (*t).sh = kit.ln(c, 36)
    kit.search_draw(c, search_of(t), x, y, w, (*t).sh, (*t).search_hint, false)
}

fn paint_wide(t: *mut Tpl, c: *mut render.Ctx, ox: f64, oy: f64, w: f64, h: f64, px: f64, py: f64) {
    let v: *mut ds_navview.NavView = nav_of(t)
    ds_navview.layout(v, c, ox, oy, w, h)
    ds_navview.select(v, (*t).page)
    ds_navview.draw(v, c, px, py)
    let pad: f64 = kit.ln(c, 32)
    let cx: f64 = ds_navview.content_x(v)
    let cy: f64 = ds_navview.content_y(v)
    let cw: f64 = ds_navview.content_w(v)
    var iw: f64 = cw - pad * 2.0
    if iw > kit.ln(c, 960) { iw = kit.ln(c, 960) }
    let ix: f64 = cx + pad
    kit.draw_label(c, ix, cy + kit.ln(c, 24), kit.ln(c, 36), kit.ln(c, 28), 600, kit.tokc(c, style.TOK_TEXT), page_title(t), 0.0)
    var sw: f64 = kit.ln(c, 280)
    if sw > iw / 2.0 { sw = iw / 2.0 }
    draw_search(t, c, ix + iw - sw, cy + kit.ln(c, 28), sw, px, py)
    let top: f64 = cy + kit.ln(c, 84)
    draw_rows(t, c, ix, top, iw, oy + h - top, px, py)
    ds_navview.draw_overlay(v, c, px, py)
}

fn paint_list(t: *mut Tpl, c: *mut render.Ctx, ox: f64, oy: f64, w: f64, h: f64, px: f64, py: f64) {
    let pad: f64 = kit.ln(c, 16)
    kit.draw_label(c, ox + pad, oy + kit.ln(c, 16), kit.ln(c, 36), kit.ln(c, 28), 600, kit.tokc(c, style.TOK_TEXT), (*t).title, 0.0)
    draw_search(t, c, ox + pad, oy + kit.ln(c, 64), w - pad * 2.0, px, py)
    let top: f64 = oy + kit.ln(c, 112)
    if searching(t) {
        draw_rows(t, c, ox + pad, top, w - pad * 2.0, oy + h - top, px, py)
        return
    }
    let lp: *mut ds_settings.Panel = list_of(t)
    ds_settings.begin(lp, c, ox + pad, top, w - pad * 2.0, px, py)
    var i: usize = 0
    while i < (*t).pages {
        ds_settings.row_chevron(lp, c, i, (*t).picon[i], ds_navview.label_at(nav_of(t), i), "")
        i = i + 1
    }
    ds_settings.end(lp, c)
}

fn paint_page(t: *mut Tpl, c: *mut render.Ctx, ox: f64, oy: f64, w: f64, h: f64, px: f64, py: f64) {
    let b: *mut ds_iconbtn.Btns = back_of(t)
    ds_iconbtn.begin(b, c, px, py)
    ds_iconbtn.add(b, c, BACK_ID, ox + kit.ln(c, 8), oy + kit.ln(c, 12), ds_iconbtn.back_glyph(), "Back", false, true)
    ds_iconbtn.end(b, c)
    kit.draw_label(c, ox + kit.ln(c, 56), oy + kit.ln(c, 12), kit.ln(c, 36), kit.ln(c, 28), 600, kit.tokc(c, style.TOK_TEXT), page_title(t), 0.0)
    let pad: f64 = kit.ln(c, 16)
    let top: f64 = oy + kit.ln(c, 64)
    draw_rows(t, c, ox + pad, top, w - pad * 2.0, oy + h - top, px, py)
}

fn paint_in(ud: u64, c: *mut render.Ctx, ox: f64, oy: f64, w: f64, h: f64, px: f64, py: f64) {
    let t: *mut Tpl = tp(ud)
    (*t).ctx = c as u64
    painter.surface(render.ctx_painter(c), ox, oy, w, h, kit.tokc(c, style.TOK_BASE))
    (*t).stacked = w < kit.ln(c, 641)
    if !(*t).stacked {
        paint_wide(t, c, ox, oy, w, h, px, py)
        return
    }
    if (*t).opened {
        paint_page(t, c, ox, oy, w, h, px, py)
    } else {
        paint_list(t, c, ox, oy, w, h, px, py)
    }
}

fn paint(ud: u64, c: *mut render.Ctx, w: f64, h: f64, px: f64, py: f64) {
    paint_in(ud, c, 0.0, 0.0, w, h, px, py)
}

fn sync(t: *mut Tpl) {
    let p: *mut ds_settings.Panel = panel_of(t)
    let f: usize = ds_settings.fired(p)
    if f != NONE {
        let fire: fn(u64, usize) = (*t).fire
        fire((*t).ud, f)
    }
    if ds_settings.revision(p) == (*t).rev { return }
    (*t).rev = ds_settings.revision(p)
    var i: usize = 0
    while i < (*t).n {
        let it: *mut Item = &(*t).items[i]
        i = i + 1
        if (*it).kind == K_SECTION || (*it).kind == K_LINK || (*it).kind == K_VALUE || (*it).kind == K_BUTTON || (*it).kind == K_SWATCH { continue }
        let v: i64 = ds_settings.val(p, (*it).id)
        if v == (*t).seen[(*it).id] { continue }
        (*t).seen[(*it).id] = v
        let apply: fn(u64, usize, i64) = (*t).apply
        apply((*t).ud, (*it).id, v)
    }
}

fn sync_swatch(t: *mut Tpl) {
    if (*t).swatch == 0 { return }
    let v: i64 = ds_swatch.selected(swatch_of(t))
    if v < 0 as i64 || v == (*t).seen[(*t).swatch_id] { return }
    (*t).seen[(*t).swatch_id] = v
    ACCENT = v as usize
    let m: *mut theme.Theme = render.ctx_theme(ctx(t))
    ds_tokens.set_accent(m, ACCENT)
    kitcolor.set_accent(ds_tokens.accent_color(ACCENT, (*theme.theme_colors(m)).dark))
    let apply: fn(u64, usize, i64) = (*t).apply
    apply((*t).ud, (*t).swatch_id, v)
}

fn open_page(t: *mut Tpl, i: usize) {
    (*t).page = i
    (*t).opened = true
    (*t).scroll = 0.0
    (*t).content_h = 0.0
    ds_settings.reset(panel_of(t))
}

fn close_page(t: *mut Tpl) -> bool {
    if !(*t).opened { return false }
    (*t).opened = false
    (*t).scroll = 0.0
    (*t).content_h = 0.0
    ds_settings.reset(panel_of(t))
    return true
}

fn press(ud: u64, x: f64, y: f64) {
    let t: *mut Tpl = tp(ud)
    let c: *mut render.Ctx = ctx(t)
    let s: *mut kit.Search = search_of(t)
    let hit: bool = kitform.field_box_press(c, s, (*t).sx, (*t).sy, (*t).sw, (*t).sh, x, y, 0 as u64)
    if hit {
        (*t).scroll = 0.0
        return
    }
    kit.search_focus(s, false)
    if (*t).stacked {
        if (*t).opened {
            if ds_iconbtn.press(back_of(t), x, y) != NONE { return }
        } else if !searching(t) {
            ds_settings.press(list_of(t), x, y)
            return
        }
    } else {
        let v: *mut ds_navview.NavView = nav_of(t)
        let ev: u32 = ds_navview.press(v, x, y)
        if ev == ds_navview.EV_SELECT {
            (*t).page = ds_navview.selected(v)
            (*t).scroll = 0.0
            (*t).content_h = 0.0
            ds_settings.reset(panel_of(t))
            return
        }
        if ev != ds_navview.EV_NONE { return }
    }
    if y < (*t).view_y { return }
    if (*t).swatch_on {
        if ds_swatch.press(swatch_of(t), x, y) != ds_swatch.NONE {
            sync_swatch(t)
            return
        }
    }
    ds_settings.press(panel_of(t), x, y)
    sync(t)
}

fn pointer(ud: u64, kind: u32, x: f64, y: f64) -> bool {
    let t: *mut Tpl = tp(ud)
    var used: bool = ds_settings.pointer(panel_of(t), kind, x, y)
    if kind == fuiwirt.HOOK_UP {
        if (*t).stacked && !(*t).opened && !searching(t) {
            let id: usize = ds_settings.release(list_of(t), x, y)
            if id != NONE && id < (*t).pages {
                ds_settings.fired(list_of(t))
                open_page(t, id)
                return true
            }
        }
        if (*t).stacked && (*t).opened {
            if ds_iconbtn.release(back_of(t), x, y) == BACK_ID {
                close_page(t)
                return true
            }
        }
        if ds_settings.release(panel_of(t), x, y) != NONE { used = true }
    }
    sync(t)
    return used
}

fn key(ud: u64, k: u32, mods: u32) -> bool {
    let t: *mut Tpl = tp(ud)
    let s: *mut kit.Search = search_of(t)
    if kit.search_has_focus(s) {
        if k == editor.KEY_ESC && kit.search_text_len(s) == 0 { kit.search_focus(s, false) }
        else { kit.search_key(s, k, mods) }
        (*t).scroll = 0.0
        return true
    }
    if (*t).stacked && !(*t).opened && !searching(t) {
        if ds_settings.key(list_of(t), k, mods) {
            let f: usize = ds_settings.fired(list_of(t))
            if f != NONE && f < (*t).pages { open_page(t, f) }
            return true
        }
        return false
    }
    if k == editor.KEY_ESC && (*t).stacked && (*t).opened { return close_page(t) }
    if (*t).swatch_on && ds_swatch.foc(swatch_of(t)) >= 0 as i64 {
        let used: bool = ds_swatch.key(swatch_of(t), k, mods)
        sync_swatch(t)
        if used { return true }
    }
    if ds_settings.key(panel_of(t), k, mods) {
        sync(t)
        return true
    }
    if (*t).swatch_on && k == editor.KEY_TAB && ds_swatch.key(swatch_of(t), k, mods) { return true }
    if !(*t).stacked {
        let v: *mut ds_navview.NavView = nav_of(t)
        let ev: u32 = ds_navview.key(v, k, mods)
        if ev == ds_navview.EV_SELECT {
            (*t).page = ds_navview.selected(v)
            (*t).scroll = 0.0
            (*t).content_h = 0.0
            return true
        }
    }
    return false
}

fn text(ud: u64, cp: u32, mods: u32) -> bool {
    let t: *mut Tpl = tp(ud)
    let s: *mut kit.Search = search_of(t)
    if kit.search_has_focus(s) {
        kit.search_char(s, cp, mods)
        (*t).scroll = 0.0
        return true
    }
    if (*t).swatch_on && ds_swatch.foc(swatch_of(t)) >= 0 as i64 {
        let used: bool = ds_swatch.text(swatch_of(t), cp, mods)
        sync_swatch(t)
        if used { return true }
    }
    if ds_settings.text(panel_of(t), cp, mods) {
        sync(t)
        return true
    }
    return false
}

fn wheel(ud: u64, px: f64, py: f64, dx: f64, dy: f64) -> bool {
    let t: *mut Tpl = tp(ud)
    if ds_navview.wheel(nav_of(t), px, py, dy) { return true }
    (*t).scroll = (*t).scroll + dy * kit.ln(ctx(t), 48)
    return true
}

fn skin(m: *mut theme.Theme, dark: bool) {
    ds_icons_full.install()
    ds_tokens.apply(m, dark, ACCENT)
    ds_tokens.set_accent(m, ACCENT)
    kitcolor.set_accent(ds_tokens.accent_color(ACCENT, dark))
}

fn run(start: u64, t: *mut Tpl, w: usize, h: usize) -> i32 {
    if screen.has_arg(start, "--page") != 0 {
        let a: u64 = screen.arg_after(start, "--page")
        (*t).page = (rt.ld8(a, 0) - 48 as u8) as usize
        (*t).opened = true
    }
    if screen.has_arg(start, "--search") != 0 {
        let a: u64 = screen.arg_after(start, "--search")
        var n: usize = 0
        while rt.ld8(a, n) != 0 as u8 { n = n + 1 }
        kit.search_set_text(search_of(t), str { p: a as *mut u8, n: n })
    }
    return screen.run_full(start, (*t).title, w, h, t as u64, paint, press, key, text, wheel, pointer, skin)
}
