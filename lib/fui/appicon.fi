import fui.a11y
import fui.app
import fui.ds_icons
import fui.ds_look
import fui.render
import fui.scene
import fui.widget

export {
    icon_button, BUTTON_SIZE,
}

const BUTTON_SIZE: usize = 32

fn paint(ud: u64, c: *mut render.Ctx, e: *mut widget.Widget) {
    let glyph: i64 = ud as i64
    let x: f64 = widget.w_x(e)
    let y: f64 = widget.w_y(e)
    let w: f64 = widget.w_w(e)
    let h: f64 = widget.w_h(e)
    let off: bool = widget.w_is_disabled(e)
    let hover: bool = !off && widget.w_is_hover(e)
    let radius: f64 = ds_look.radius_small(c)
    if hover && widget.w_is_active(e) {
        ds_look.fill(c, x, y, w, h, radius, ds_look.pressed_bg(c))
    } else {
        ds_look.overlay(c, x, y, w, h, radius, ds_look.hover_bg(c), ds_look.hover_level(c, x, y, hover))
    }
    var ink: u32 = ds_look.fg(c)
    if off {
        ink = ds_look.fg_disabled(c)
    }
    let size: f64 = ds_look.glyph_small(c)
    ds_look.glyph(c, ds_icons.gid(glyph), x + (w - size) / 2.0, y + (h - size) / 2.0, size, ink)
    if widget.w_is_focus(e) {
        ds_look.focus(c, x, y, w, h, radius)
    }
}

fn icon_button(a: *mut app.App, icon: i64, label: str, on_click: fn(*mut app.App)) -> usize {
    if label.n == 0 || icon < 0 {
        return app.NONE
    }
    let node: usize = app.custom(a, widget.KIND_BUTTON, BUTTON_SIZE, BUTTON_SIZE)
    if node == app.NONE {
        return app.NONE
    }
    let sc: *mut scene.Scene = app.app_scene(a)
    (*scene.nd(sc, node)).no_fill = 1 as u32
    scene.node_set_draw(sc, node, icon as u64, paint)
    app.node_set_click(a, node, on_click)
    a11y.a11y_set_name(app.ax(a), node, label.p as u64, label.n)
    return node
}
