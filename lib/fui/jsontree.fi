// SPDX-License-Identifier: MPL-2.0
// lib/fui/jsontree.fi -- fill a fUi tree (appctl.tree) from a JSON document.
//
//     var d: json.Json = json.json_new()
//     json.json_parse(&d, p, n) catch false
//     jsontree.fill(a, tree, &d, json.json_root(&d), "name", "children", 2)
//
// Every object is one item: its string member `name_key` is the label, the array `kids_key` holds
// the child objects. The root is item 0; branches nested up to `open_depth` start open.
// The document must stay alive: labels are pointed at, not copied.
import fui.app
import fui.appctl
import std.json
import std.str

export { fill }

fn add(a: *mut app.App, tree: usize, d: *mut json.Json, o: u32, name_key: str, kids_key: str,
    depth: usize, open_depth: usize) {
    let nm: str.Span = json.json_string(d, json.json_get(d, o, name_key.p as u64, name_key.n))
    let kids: u32 = json.json_get(d, o, kids_key.p as u64, kids_key.n)
    let c: bool = appctl.tree_add(a, tree, depth, str { p: nm.p, n: nm.n }, depth < open_depth)
    var k: u32 = json.json_child(d, kids)
    while k != json.JSON_NONE {
        add(a, tree, d, k, name_key, kids_key, depth + 1, open_depth)
        k = json.json_next(d, k)
    }
}

fn fill(a: *mut app.App, tree: usize, d: *mut json.Json, root: u32, name_key: str, kids_key: str, open_depth: usize) {
    add(a, tree, d, root, name_key, kids_key, 0, open_depth)
}
