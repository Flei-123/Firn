// SPDX-License-Identifier: MPL-2.0
// lib/fui/imelist.fi -- THE CANDIDATE LIST OF THE INPUT METHOD.
//
// ========================================================= WHY IT EXISTS
//
// Whoever types "zhong" has to see which characters come into question, and
// be able to choose one of them with a digit or the arrow keys.
// This list stands UNDER the insertion point, numbered 1 to 9, and the
// chosen row is highlighted. Its state (which candidates, which one
// chosen, whether it is open) stands in lib/fui/ime.fi; which key does what,
// in lib/fui/editor.fi. Here stands only what it LOOKS like and WHERE.
//
// ================================================ WHY AS A TREE AND NOT PAINTED
//
// The list is a tree from lib/fui/scene.fi, coloured by a
// style sheet from lib/fui/sheet.fi -- the same description as any
// other page in fUi. That is no end in itself: a painted list
// would have to calculate the width of its longest row itself, set the height
// per row itself and choose the colour of the chosen row itself.
// Exactly that is what scene_measure, flex_layout and the precedence
// of the style sheet already do, and a second place for it would be the place at which
// the list looks different from a menu for the first time.
//
// The colours come EXCLUSIVELY from the tokens of the theme: the panel
// like a menu (TOK_SURFACE_RAISED with TOK_BORDER), the chosen row
// like highlighted text (TOK_SELECTION / TOK_SELECTION_TEXT), the digits
// in the quiet font (TOK_TEXT_MUTED). No colour table of its own.
//
// ======================================================= WHY A MODULE OF ITS OWN
//
// The widgets stand in wave2.fi/wave3.fi. The list cannot stand there,
// because it builds a TREE: scene.fi imports wave3.fi, so
// wave3.fi cannot import scene.fi without closing a circle. The list
// therefore sits one level higher, where an application also builds
// its tree -- and uses nothing that an application could not also
// use.
//
// ============================================================ THE USE
//
//     var blatt: sheet.Sheet = sheet.sheet_new()
//     imelist.imelist_rules(&blatt)              // once
//     var sc: scene.Scene = scene.scene_new()
//     let wurzel: usize = imelist.imelist_build(&sc, ed_ime)
//     imelist.imelist_layout(&sc, &blatt, &c, ed_ime, breite, hoehe)
//     scene.scene_draw(&sc, &c)
//
// The list is a tree OF ITS OWN and is painted AFTER the window: it
// lies above everything, like a menu, and pushes nothing aside.
import fui.style
import fui.sheet
import fui.scene
import fui.flex
import fui.render
import fui.ime

export {
    imelist_rules, imelist_build, imelist_layout, imelist_hit,
    imelist_names, ImeListNames, IMELIST_GAP,
}

// The distance between insertion point and list, in design points.
const IMELIST_GAP: usize = 4

// The class names as strings. `sheet.sheet_name` makes of them
// the numbers by which sheet and tree find each other.
static NM_LIST: [u8; 9] = "ime-liste"
static NM_LINE: [u8; 9] = "ime-zeile"
static NM_CHOICE: [u8; 8] = "ime-wahl"
static NM_NR: [u8; 6] = "ime-nr"
static NM_CAND: [u8; 8] = "ime-kand"
// The digits 1 to 9 that the rows point to. A node holds only
// a pointer to its text (scene.node_set_text does not copy), so the
// text must live longer than the tree -- as a `static` it does.
static DIGITS: [u8; 9] = "123456789"

struct ImeListNames {
    list: u32,
    line: u32,
    choice: u32,
    nr: u32,
    cand: u32,
}

fn imelist_names() -> ImeListNames {
    return ImeListNames {
        list: sheet.sheet_name((&NM_LIST[0]) as u64, 9),
        line: sheet.sheet_name((&NM_LINE[0]) as u64, 9),
        choice: sheet.sheet_name((&NM_CHOICE[0]) as u64, 8),
        nr: sheet.sheet_name((&NM_NR[0]) as u64, 6),
        cand: sheet.sheet_name((&NM_CAND[0]) as u64, 8),
    }
}

// THE RULES. They go into the sheet of the caller -- so an
// application can overrule them with a rule of its own, written later, like
// any other rule.
fn imelist_rules(sh: *mut sheet.Sheet) {
    let k: ImeListNames = imelist_names()
    // The panel: raised like a menu, a point of border.
    var s1: style.Style = style.style_new()
    s1 = style.style_set_bg(s1, style.color_token(style.TOK_SURFACE_RAISED))
    s1 = style.style_set_border(s1, style.color_token(style.TOK_BORDER), 1)
    s1 = style.style_set_radius(s1, 8)
    s1 = style.style_set_fg(s1, style.color_token(style.TOK_TEXT))
    let r1: usize = sheet.sheet_rule(sh, sheet.sel_class(k.list), s1)
    // A row: transparent, slightly rounded, so that the chosen
    // row stands as a surface in the panel and does not bump into its edge.
    var s2: style.Style = style.style_new()
    s2 = style.style_set_radius(s2, 6)
    let r2: usize = sheet.sheet_rule(sh, sheet.sel_class(k.line), s2)
    // The chosen row: like highlighted text.
    var s3: style.Style = style.style_new()
    s3 = style.style_set_bg(s3, style.color_token(style.TOK_SELECTION))
    s3 = style.style_set_fg(s3, style.color_token(style.TOK_SELECTION_TEXT))
    let r3: usize = sheet.sheet_rule(sh,
        sheet.sel_with_class(sheet.sel_class(k.line), k.choice), s3)
    // The digit: quiet and smaller. In the chosen row, though, in the
    // highlight font -- a quiet digit on the highlight colour
    // does not carry the contrast, and the rule below is the later written
    // AND the more specific one, so it wins twice over.
    var s4: style.Style = style.style_new()
    s4 = style.style_set_fg(s4, style.color_token(style.TOK_TEXT_MUTED))
    s4 = style.style_set_font(s4, 0, 13)
    s4 = style.style_set_pad(s4, 0, 0)
    let r4: usize = sheet.sheet_rule(sh, sheet.sel_class(k.nr), s4)
    var s5: style.Style = style.style_new()
    s5 = style.style_set_fg(s5, style.color_token(style.TOK_SELECTION_TEXT))
    let r5: usize = sheet.sheet_rule(sh,
        sheet.sel_within_class(sheet.sel_class(k.nr), k.choice), s5)
    // The candidate itself: larger than the field font, because a
    // character with twenty strokes needs more points than an a.
    var s6: style.Style = style.style_new()
    s6 = style.style_set_font(s6, 0, 20)
    s6 = style.style_set_pad(s6, 0, 0)
    let r6: usize = sheet.sheet_rule(sh, sheet.sel_class(k.cand), s6)
}

// THE TREE. One row per candidate of the VISIBLE page (at most 9),
// each with its digit and its candidate. Returned is the root,
// or scene.SCENE_NONE if there is nothing to show -- an empty
// panel under the field would be a frame around nothing.
//
// The id of every row is candidate number + 1 (0 means "no id" in scene.fi);
// `imelist_hit` reads it back.
fn imelist_build(sc: *mut scene.Scene, m: *mut ime.Ime) -> usize {
    if !ime.ime_cand_shown(m) {
        return scene.SCENE_NONE
    }
    let k: ImeListNames = imelist_names()
    let root: usize = scene.scene_box(sc, scene.SCENE_NONE, k.list,
        flex.FLEX_COLUMN, flex.JUSTIFY_START, flex.AL_STRETCH)
    scene.node_set_padding(sc, root, 4, 4, 4, 4)
    scene.node_set_gap(sc, root, 2, 0)
    let first: usize = ime.ime_cand_page_first(m)
    var i: usize = first
    while i < first + ime.CAND_PAGE && i < ime.ime_cand_count(m) {
        let z: usize = scene.scene_box(sc, root, k.line, flex.FLEX_ROW,
            flex.JUSTIFY_START, flex.AL_CENTER)
        scene.node_set_padding(sc, z, 8, 3, 14, 3)
        scene.node_set_gap(sc, z, 10, 0)
        scene.node_set_id(sc, z, (i + 1) as u32)
        if i == ime.ime_cand_sel(m) {
            let ok: bool = scene.node_add_class(sc, z, k.choice)
        }
        let nr: usize = scene.scene_add(sc, z, scene.N_TEXT)
        let ok1: bool = scene.node_add_class(sc, nr, k.nr)
        scene.node_set_text(sc, nr, (&DIGITS[i - first]) as u64, 1)
        let kd: usize = scene.scene_add(sc, z, scene.N_TEXT)
        let ok2: bool = scene.node_add_class(sc, kd, k.cand)
        scene.node_set_text(sc, kd, ime.ime_cand_text(m, i),
            ime.ime_cand_len(m, i))
        i = i + 1
    }
    return root
}

// WHERE THE LIST STANDS. Under the insertion point (ime_spot_*, reported
// by the field via editor.editor_ime_spot -- horizontally the write pointer,
// vertically in a single-line field the whole field, so that the list
// does not fall over its lower edge), IMELIST_GAP points below it,
// flush left with it. If there is not enough room downwards, it stands
// ABOVE -- a list that runs out of the window at the bottom shows its
// last candidates to nobody. If there is not enough room to the right, it moves
// to the left until it fits.
//
// The size comes from scene_measure and is not guessed: first
// measure, then place.
fn imelist_layout(sc: *mut scene.Scene, sh: *mut sheet.Sheet,
    c: *mut render.Ctx, m: *mut ime.Ime, area_w: f64, area_h: f64) {
    let root: usize = scene.scene_root(sc)
    if root == scene.SCENE_NONE {
        return
    }
    scene.scene_style(sc, sh)
    scene.scene_measure(sc, c)
    let pw: f64 = scene.node_pref_w(sc, root)
    let ph: f64 = scene.node_pref_h(sc, root)
    let luft: f64 = render.len_of(c, IMELIST_GAP)
    var x: f64 = ime.ime_spot_x(m)
    if x + pw > area_w {
        x = area_w - pw
    }
    if x < 0.0 {
        x = 0.0
    }
    var y: f64 = ime.ime_spot_y(m) + ime.ime_spot_h(m) + luft
    if y + ph > area_h && ime.ime_spot_y(m) - luft - ph >= 0.0 {
        y = ime.ime_spot_y(m) - luft - ph
    }
    // Whole points: a panel on half a row has a soft
    // edge at the top and a hard one at the bottom.
    x = ((x + 0.5) as i64) as f64
    y = ((y + 0.5) as i64) as f64
    scene.scene_layout(sc, c, x, y, pw, ph)
}

// Which candidate lies under the pointer? -1: none. What is hit is
// the topmost node; the row is it itself or its parent.
fn imelist_hit(sc: *mut scene.Scene, px: f64, py: f64) -> i64 {
    var i: usize = scene.scene_hit(sc, px, py)
    while i != scene.SCENE_NONE {
        let id: u32 = scene.node_id(sc, i)
        if id != 0 as u32 {
            return (id - 1 as u32) as i64
        }
        i = scene.scene_parent(sc, i)
    }
    return 0 - 1
}
