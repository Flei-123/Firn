// SPDX-License-Identifier: MPL-2.0
// lib/fui/imelist.fi -- DIE KANDIDATENLISTE DER EINGABEMETHODE.
//
// ========================================================= WARUM ES SIE GIBT
//
// Wer "zhong" tippt, muss sehen, welche Zeichen in Frage kommen, und
// eines davon mit einer Ziffer oder den Pfeiltasten waehlen koennen.
// Diese Liste steht UNTER der Einfuegestelle, nummeriert 1 bis 9, und die
// gewaehlte Zeile ist hinterlegt. Ihr Zustand (welche Kandidaten, welcher
// gewaehlt, ob sie offen ist) steht in lib/fui/ime.fi; welche Taste was
// tut, in lib/fui/editor.fi. Hier steht nur, wie sie AUSSIEHT und WO.
//
// ================================================ WARUM ALS BAUM UND NICHT GEMALT
//
// Die Liste ist ein Baum aus lib/fui/scene.fi, eingefaerbt von einem
// Stilblatt aus lib/fui/sheet.fi -- dieselbe Beschreibung wie jede
// andere Seite in fUi. Das ist kein Selbstzweck: eine gemalte Liste
// muesste die Breite ihrer laengsten Zeile selbst ausrechnen, die Hoehe
// je Zeile selbst setzen und die Farbe der gewaehlten Zeile selbst
// waehlen. Genau das tun scene_measure, flex_layout und die Rangfolge
// des Stilblatts schon, und ein zweiter Ort dafuer waere der Ort, an dem
// die Liste zum ersten Mal anders aussieht als ein Menue.
//
// Die Farben kommen AUSSCHLIESSLICH aus den Marken des Themas: die Tafel
// wie ein Menue (TOK_SURFACE_RAISED mit TOK_BORDER), die gewaehlte Zeile
// wie markierter Text (TOK_SELECTION / TOK_SELECTION_TEXT), die Ziffern
// in der leisen Schrift (TOK_TEXT_MUTED). Keine eigene Farbtabelle.
//
// ======================================================= WARUM EIN EIGENES MODUL
//
// Die Widgets stehen in wave2.fi/wave3.fi. Dort kann die Liste nicht
// stehen, weil sie einen BAUM baut: scene.fi importiert wave3.fi, also
// kann wave3.fi scene.fi nicht importieren, ohne einen Kreis zu
// schliessen. Die Liste sitzt darum eine Ebene hoeher, dort, wo auch
// eine Anwendung ihren Baum baut -- und benutzt nichts, was eine
// Anwendung nicht auch benutzen koennte.
//
// ============================================================ DER GEBRAUCH
//
//     var blatt: sheet.Sheet = sheet.sheet_new()
//     imelist.imelist_rules(&blatt)              // einmal
//     var sc: scene.Scene = scene.scene_new()
//     let wurzel: usize = imelist.imelist_build(&sc, ed_ime)
//     imelist.imelist_layout(&sc, &blatt, &c, ed_ime, breite, hoehe)
//     scene.scene_draw(&sc, &c)
//
// Die Liste ist ein EIGENER Baum und wird NACH dem Fenster gemalt: sie
// liegt ueber allem, wie ein Menue, und schiebt nichts beiseite.
import fui.style
import fui.sheet
import fui.scene
import fui.flex
import fui.render
import fui.ime

export {
    imelist_rules, imelist_build, imelist_layout, imelist_hit,
    imelist_names, ImeListNames, IMELIST_GAP,
}

// Der Abstand zwischen Einfuegestelle und Liste, in Designpunkten.
const IMELIST_GAP: usize = 4

// Die Klassennamen als Zeichenketten. `sheet.sheet_name` macht daraus
// die Zahlen, mit denen Blatt und Baum sich finden.
static NM_LISTE: [u8; 9] = "ime-liste"
static NM_ZEILE: [u8; 9] = "ime-zeile"
static NM_WAHL: [u8; 8] = "ime-wahl"
static NM_NR: [u8; 6] = "ime-nr"
static NM_KAND: [u8; 8] = "ime-kand"
// Die Ziffern 1 bis 9, auf die die Zeilen zeigen. Ein Knoten haelt nur
// einen Zeiger auf seinen Text (scene.node_set_text kopiert nicht), also
// muss der Text laenger leben als der Baum -- als `static` tut er das.
static ZIFFERN: [u8; 9] = "123456789"

struct ImeListNames {
    liste: u32,
    zeile: u32,
    wahl: u32,
    nr: u32,
    kand: u32,
}

fn imelist_names() -> ImeListNames {
    return ImeListNames {
        liste: sheet.sheet_name((&NM_LISTE[0]) as u64, 9),
        zeile: sheet.sheet_name((&NM_ZEILE[0]) as u64, 9),
        wahl: sheet.sheet_name((&NM_WAHL[0]) as u64, 8),
        nr: sheet.sheet_name((&NM_NR[0]) as u64, 6),
        kand: sheet.sheet_name((&NM_KAND[0]) as u64, 8),
    }
}

// DIE REGELN. Sie gehen in das Blatt des Aufrufers -- so kann eine
// Anwendung sie mit einer eigenen, spaeter geschriebenen Regel
// ueberstimmen, wie jede andere Regel auch.
fn imelist_rules(sh: *mut sheet.Sheet) {
    let k: ImeListNames = imelist_names()
    // Die Tafel: gehoben wie ein Menue, ein Punkt Rand.
    var s1: style.Style = style.style_new()
    s1 = style.style_set_bg(s1, style.color_token(style.TOK_SURFACE_RAISED))
    s1 = style.style_set_border(s1, style.color_token(style.TOK_BORDER), 1)
    s1 = style.style_set_radius(s1, 8)
    s1 = style.style_set_fg(s1, style.color_token(style.TOK_TEXT))
    let r1: usize = sheet.sheet_rule(sh, sheet.sel_class(k.liste), s1)
    // Eine Zeile: durchsichtig, leicht gerundet, damit die gewaehlte
    // Zeile als Flaeche in der Tafel steht und nicht an ihren Rand stoesst.
    var s2: style.Style = style.style_new()
    s2 = style.style_set_radius(s2, 6)
    let r2: usize = sheet.sheet_rule(sh, sheet.sel_class(k.zeile), s2)
    // Die gewaehlte Zeile: wie markierter Text.
    var s3: style.Style = style.style_new()
    s3 = style.style_set_bg(s3, style.color_token(style.TOK_SELECTION))
    s3 = style.style_set_fg(s3, style.color_token(style.TOK_SELECTION_TEXT))
    let r3: usize = sheet.sheet_rule(sh,
        sheet.sel_with_class(sheet.sel_class(k.zeile), k.wahl), s3)
    // Die Ziffer: leise und kleiner. In der gewaehlten Zeile aber in der
    // Markierungsschrift -- eine leise Ziffer auf der Markierungsfarbe
    // traegt den Kontrast nicht, und die Regel darunter ist die spaeter
    // geschriebene UND die genauere, sie gewinnt also doppelt.
    var s4: style.Style = style.style_new()
    s4 = style.style_set_fg(s4, style.color_token(style.TOK_TEXT_MUTED))
    s4 = style.style_set_font(s4, 0, 13)
    s4 = style.style_set_pad(s4, 0, 0)
    let r4: usize = sheet.sheet_rule(sh, sheet.sel_class(k.nr), s4)
    var s5: style.Style = style.style_new()
    s5 = style.style_set_fg(s5, style.color_token(style.TOK_SELECTION_TEXT))
    let r5: usize = sheet.sheet_rule(sh,
        sheet.sel_within_class(sheet.sel_class(k.nr), k.wahl), s5)
    // Der Kandidat selbst: groesser als die Feldschrift, denn ein
    // Schriftzeichen mit zwanzig Strichen braucht mehr Punkte als ein a.
    var s6: style.Style = style.style_new()
    s6 = style.style_set_font(s6, 0, 20)
    s6 = style.style_set_pad(s6, 0, 0)
    let r6: usize = sheet.sheet_rule(sh, sheet.sel_class(k.kand), s6)
}

// DER BAUM. Eine Zeile je Kandidat der SICHTBAREN Seite (hoechstens 9),
// jede mit ihrer Ziffer und ihrem Kandidaten. Zurueck kommt die Wurzel,
// oder scene.SCENE_NONE, wenn es nichts zu zeigen gibt -- eine leere
// Tafel unter dem Feld waere ein Rahmen um nichts.
//
// Die Kennung jeder Zeile ist Kandidatennummer + 1 (0 heisst in scene.fi
// "keine Kennung"); `imelist_hit` liest sie zurueck.
fn imelist_build(sc: *mut scene.Scene, m: *mut ime.Ime) -> usize {
    if !ime.ime_cand_shown(m) {
        return scene.SCENE_NONE
    }
    let k: ImeListNames = imelist_names()
    let wurzel: usize = scene.scene_box(sc, scene.SCENE_NONE, k.liste,
        flex.FLEX_COLUMN, flex.JUSTIFY_START, flex.AL_STRETCH)
    scene.node_set_padding(sc, wurzel, 4, 4, 4, 4)
    scene.node_set_gap(sc, wurzel, 2, 0)
    let erst: usize = ime.ime_cand_page_first(m)
    var i: usize = erst
    while i < erst + ime.CAND_PAGE && i < ime.ime_cand_count(m) {
        let z: usize = scene.scene_box(sc, wurzel, k.zeile, flex.FLEX_ROW,
            flex.JUSTIFY_START, flex.AL_CENTER)
        scene.node_set_padding(sc, z, 8, 3, 14, 3)
        scene.node_set_gap(sc, z, 10, 0)
        scene.node_set_id(sc, z, (i + 1) as u32)
        if i == ime.ime_cand_sel(m) {
            let ok: bool = scene.node_add_class(sc, z, k.wahl)
        }
        let nr: usize = scene.scene_add(sc, z, scene.N_TEXT)
        let ok1: bool = scene.node_add_class(sc, nr, k.nr)
        scene.node_set_text(sc, nr, (&ZIFFERN[i - erst]) as u64, 1)
        let kd: usize = scene.scene_add(sc, z, scene.N_TEXT)
        let ok2: bool = scene.node_add_class(sc, kd, k.kand)
        scene.node_set_text(sc, kd, ime.ime_cand_text(m, i),
            ime.ime_cand_len(m, i))
        i = i + 1
    }
    return wurzel
}

// WO DIE LISTE STEHT. Unter der Einfuegestelle (ime_spot_*, gemeldet
// vom Feld ueber editor.editor_ime_spot), IMELIST_GAP Punkte darunter,
// linksbuendig an ihr. Reicht der Platz nach unten nicht, steht sie
// DARUEBER -- eine Liste, die unten aus dem Fenster laeuft, zeigt ihre
// letzten Kandidaten niemandem. Reicht er nach rechts nicht, rueckt sie
// nach links, bis sie passt.
//
// Die Groesse kommt aus scene_measure und wird nicht geraten: erst
// messen, dann legen.
fn imelist_layout(sc: *mut scene.Scene, sh: *mut sheet.Sheet,
    c: *mut render.Ctx, m: *mut ime.Ime, flaeche_w: f64, flaeche_h: f64) {
    let wurzel: usize = scene.scene_root(sc)
    if wurzel == scene.SCENE_NONE {
        return
    }
    scene.scene_style(sc, sh)
    scene.scene_measure(sc, c)
    let pw: f64 = scene.node_pref_w(sc, wurzel)
    let ph: f64 = scene.node_pref_h(sc, wurzel)
    let luft: f64 = render.len_of(c, IMELIST_GAP)
    var x: f64 = ime.ime_spot_x(m)
    if x + pw > flaeche_w {
        x = flaeche_w - pw
    }
    if x < 0.0 {
        x = 0.0
    }
    var y: f64 = ime.ime_spot_y(m) + ime.ime_spot_h(m) + luft
    if y + ph > flaeche_h && ime.ime_spot_y(m) - luft - ph >= 0.0 {
        y = ime.ime_spot_y(m) - luft - ph
    }
    // Ganze Punkte: eine Tafel auf einer halben Zeile hat einen weichen
    // Rand oben und einen harten unten.
    x = ((x + 0.5) as i64) as f64
    y = ((y + 0.5) as i64) as f64
    scene.scene_layout(sc, c, x, y, pw, ph)
}

// Welcher Kandidat liegt unter dem Zeiger? -1: keiner. Getroffen wird
// der oberste Knoten; die Zeile ist er selbst oder sein Elternteil.
fn imelist_hit(sc: *mut scene.Scene, px: f64, py: f64) -> i64 {
    var i: usize = scene.scene_hit(sc, px, py)
    while i != scene.SCENE_NONE {
        let id: u32 = scene.node_id(sc, i)
        if id != 0 as u32 {
            return (id - 1 as u32) as i64
        }
        i = scene.scene_parent(sc, i)
    }
    return 0 - 1
}
