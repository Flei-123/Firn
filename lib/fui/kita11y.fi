// SPDX-License-Identifier: MPL-2.0
// lib/fui/kita11y.fi -- THE KIT IN THE ACCESSIBILITY TREE.
//
// The parts of lib/fui/kit.fi are immediate mode: painted every frame from the state the
// program keeps, no node behind them -- and a screen reader (or lib/fui/audit.fi) cannot
// read what is only painted. This file lets every part DESCRIBE ITSELF into a scene
// tree (lib/fui/scene.fi + lib/fui/a11y.fi), from the very state and strings the frame
// paints, so that nothing is written down twice:
//
//     var kx: kita11y.KitAx = kita11y.kax_new(&scene, &ax)
//     let root: usize = kita11y.kax_root(&kx, "Launcher")
//     kita11y.kax_nav(&kx, root, items, n, active, collapsed)
//     kita11y.kax_tabbar(&kx, root, tabs, nt, sel)
//     kita11y.kax_search(&kx, root, &search, "Search mods")
//     kita11y.kax_grid(&kx, root, tiles, nt, selected)
//     kita11y.kax_button(&kx, root, "Play", kit.ST_FOCUS)
//     kita11y.kax_toasts(&kx, root, &toasts)
//     kita11y.kax_modal(&kx, root, &modal)       // and then its own buttons as children
//     let report: audit.Audit = audit.audit_tree_ax(&scene, &ax)
//
// WHAT EACH PART BECOMES (the role, the name, the state a screen reader announces):
//
//   button       button, the label; disabled / focused from the part's state bits
//   tab bar      toolbar of tabs: "Installed, 3" (label, then the badge), the selected one
//                selected, "tab 2 of 3" from the position among its siblings
//   sidebar      a menu of menu items (the headers are headings): "Settings", the active
//                one selected; a collapsed sidebar names its items the same (they are
//                only symbols on screen: the name is what a reader needs most)
//   tile grid    a list of tiles: "title, subtitle, badge"; the selected tile pressed
//   search       a text box named by its hint, holding the text; a "Clear" button while
//                there is text (a secret is never exported: this field is not one)
//   progress     a progress bar with its label, 0..1000 as the widget's value; an
//                indeterminate one says "working"
//   toasts       a live status node per message (`kit.TK_ERROR` = "Error: ..."), with the
//                action and a "Dismiss" button as children -- announced when it appears
//   modal        a group named by its title with a "Close" button; while open the
//                caller should add only its own controls under it (the focus trap)
//   avatar       an image named by the person
//   rating       a slider named "Quality, 3.5 of 5", value 0..1000 (the stars filled)
//   range        a slider named "Price, 20 to 80", value 0..1000 of the thumb the keys move (the high one when `focus_hi`)
//   chips        a group of buttons, the selected ones pressed; a closable chip has a child
//                button "Remove, <label>"
//   segmented    a group of radio buttons, the chosen one checked
//   chart        an image "Downloads, min 2, max 9, last 7"
//   skeleton     a progress bar "Loading" (no value: it is a placeholder)
//   drag source  a group named by the item, pressed while it is grabbed; description "Draggable: rows (move, copy). Ctrl+Space grabs."
//   drop target  a group "name, drop target" (", drop here" while a drag is over it), description "Accepts: rows (move, copy)."
//   drag status  a status node "Grabbed Row 3. Drop at position 4 of 9" (live: announced as the position changes)
//   accordion    a group named by the accordion, a button per section header ("Title"), expanded or collapsed; the caller adds the open bodies
//   toolbar      a toolbar of buttons: the items that fit; when some are folded a "More, 2 folded" button (expanded while the panel is open), then the folded items as buttons
//   table        a table (role table) named by the program: a header row of cells "Name, sorted ascending", then a row per data row whose cells carry the text; the cursor cell is announced "..., current cell" (", editing" while its editor is open). sort_col >= ncols = unsorted
//   pager        a group "Gallery, page 2 of 5": a toolbar of tabs "Page 1" .. (the current one
//                selected) and Previous / Next buttons (disabled at the ends)
//
// The names are put in an arena of this object (`names`, 8 KiB): the a11y tree keeps
// pointers, not copies, and the strings are made here (a label plus its badge, a
// tile's three lines). `kax_reset` forgets the tree and the arena for the next frame; a
// program may also describe once after each change instead of each frame.
//
// HONEST NOTES
//   * The tree has no geometry: it says WHAT is there, not WHERE. Wiring it to AT-SPI /
//     UIA (so that a real screen reader reads it) is the platform step that is still
//     open; `a11y.a11y_dump` is the text a test compares.
//   * A part the program draws that is not described here is not in the tree. The
//     describe functions take the same arguments as the draw functions so that
//     adding one is the same line as drawing one.
import std.rt
import fui.scene
import fui.widget
import fui.a11y
import fui.kit
import fui.wave5
import fui.wave6
import fui.wave8
import fui.dnd
import fui.wave8m
import fui.flex

export {
    KitAx, kax_new, kax_free, kax_reset, kax_root, kax_button, kax_label, kax_tabbar, kax_nav, kax_grid,
    kax_search, kax_progress, kax_toasts, kax_modal, kax_avatar, kax_heading,
    kax_rating, kax_range, kax_chips, kax_segmented, kax_chart, kax_skeleton, kax_pagedots, kax_pager,
    kax_sheet, kax_propgrid,
    kax_spinner, kax_timepicker, kax_breadcrumb, kax_infobar, kax_stepper,
    kax_dnd_source, kax_dnd_target, kax_dnd_status, kax_accordion, kax_toolbar, kax_table,
}

const ARENA_CAP: usize = 8192

struct KitAx {
    sc: *mut scene.Scene,
    ax: *mut a11y.A11y,
    names: rt.Buf, // the composed names; never grown after kax_new (the tree points into it)
}

fn kax_new(sc: *mut scene.Scene, ax: *mut a11y.A11y) -> KitAx {
    var kx: KitAx = KitAx { sc: sc, ax: ax, names: rt.buf_new() }
    rt.buf_reserve(&kx.names, ARENA_CAP)
    return kx
}

fn kax_free(kx: *mut KitAx) {
    rt.buf_free(&(*kx).names)
}

// Forget the tree and the names: the next frame describes anew.
fn kax_reset(kx: *mut KitAx) {
    scene.scene_reset((*kx).sc)
    a11y.a11y_reset((*kx).ax)
    rt.buf_clear(&(*kx).names)
}

// Copies `s` into the arena; the arena view, or `s` itself if the arena is full.
fn keep(kx: *mut KitAx, s: str) -> str {
    let len: usize = rt.buf_len(&(*kx).names)
    if len + s.n + 1 > ARENA_CAP || s.n == 0 {
        return s
    }
    rt.buf_push_bytes(&(*kx).names, s.p as u64, s.n)
    return str { p: rt.ptr_of(rt.buf_ptr(&(*kx).names) + len as u64), n: s.n }
}

// a, then ", " and b (if b is not empty), then ", " and c
fn join3(kx: *mut KitAx, a: str, b: str, c: str) -> str {
    let len: usize = rt.buf_len(&(*kx).names)
    let need: usize = a.n + b.n + c.n + 4
    if len + need > ARENA_CAP {
        return a
    }
    rt.buf_push_bytes(&(*kx).names, a.p as u64, a.n)
    if b.n > 0 {
        rt.buf_push(&(*kx).names, 44 as u8)
        rt.buf_push(&(*kx).names, 32 as u8)
        rt.buf_push_bytes(&(*kx).names, b.p as u64, b.n)
    }
    if c.n > 0 {
        rt.buf_push(&(*kx).names, 44 as u8)
        rt.buf_push(&(*kx).names, 32 as u8)
        rt.buf_push_bytes(&(*kx).names, c.p as u64, c.n)
    }
    return str { p: rt.ptr_of(rt.buf_ptr(&(*kx).names) + len as u64), n: rt.buf_len(&(*kx).names) - len }
}

// (the digits are copied into the arena before the frame ends)
#[allow_escape]
fn dec(kx: *mut KitAx, v: usize) -> str {
    var tmp: [u8; 24] = [0 as u8; 24]
    let n: usize = kit.fmt_uint(v as u64, &tmp)
    return keep(kx, str { p: rt.ptr_of((&tmp[0]) as u64), n: n })
}

fn node(kx: *mut KitAx, parent: usize, kind: u32, name: str) -> usize {
    let n: usize = scene.scene_widget((*kx).sc, parent, kind, name.p as u64, name.n)
    if n != scene.SCENE_NONE {
        a11y.a11y_set_name((*kx).ax, n, name.p as u64, name.n)
    }
    return n
}

// The root of the described window: a column box named by the window title.
fn kax_root(kx: *mut KitAx, title: str) -> usize {
    let r: usize = scene.scene_box((*kx).sc, scene.SCENE_NONE, 0 as u32, flex.FLEX_COLUMN, flex.JUSTIFY_START, flex.AL_START)
    if r != scene.SCENE_NONE {
        let t: str = keep(kx, title)
        a11y.a11y_set_name((*kx).ax, r, t.p as u64, t.n)
        a11y.a11y_set_role((*kx).ax, r, a11y.ROLE_GROUP)
    }
    return r
}

// A heading (a section title).
fn kax_heading(kx: *mut KitAx, parent: usize, text: str) -> usize {
    let t: str = keep(kx, text)
    let n: usize = scene.scene_add((*kx).sc, parent, scene.N_TEXT)
    if n != scene.SCENE_NONE {
        scene.node_set_text((*kx).sc, n, t.p as u64, t.n)
        a11y.a11y_set_role((*kx).ax, n, a11y.ROLE_HEADING)
    }
    return n
}

// A plain text.
fn kax_label(kx: *mut KitAx, parent: usize, text: str) -> usize {
    let t: str = keep(kx, text)
    let n: usize = scene.scene_add((*kx).sc, parent, scene.N_TEXT)
    if n != scene.SCENE_NONE {
        scene.node_set_text((*kx).sc, n, t.p as u64, t.n)
    }
    return n
}

fn apply_state(kx: *mut KitAx, n: usize, st: u32) {
    if n == scene.SCENE_NONE {
        return
    }
    let e: *mut widget.Widget = scene.node_widget((*kx).sc, n)
    if (st & kit.ST_DISABLED) != 0 as u32 {
        widget.w_set_disabled(e, true)
    }
    if (st & kit.ST_FOCUS) != 0 as u32 {
        widget.w_set_focus(e, true)
    }
}

// A button with the label the frame paints and the state bits (`kit.ST_*`) it is drawn with.
fn kax_button(kx: *mut KitAx, parent: usize, label: str, st: u32) -> usize {
    let n: usize = node(kx, parent, widget.KIND_BUTTON, keep(kx, label))
    apply_state(kx, n, st)
    return n
}

// The tab bar: a toolbar of tabs "label, badge"; `sel` is the selected index (kit.NONE: none).
fn kax_tabbar(kx: *mut KitAx, parent: usize, tabs: *mut kit.Tab, n: usize, sel: usize) -> usize {
    let bar: usize = scene.scene_add((*kx).sc, parent, scene.N_WIDGET)
    if bar == scene.SCENE_NONE {
        return bar
    }
    scene.node_set_widget_kind((*kx).sc, bar, widget.KIND_TOOLBAR)
    var i: usize = 0
    while i < n {
        let t: *mut kit.Tab = kit.tab_at(tabs, i)
        var badge: str = ""
        if (*t).badge > 0 {
            badge = dec(kx, (*t).badge)
        }
        let tn: usize = node(kx, bar, widget.KIND_TAB, join3(kx, (*t).label, badge, ""))
        if tn != scene.SCENE_NONE && i == sel {
            widget.w_set_selected(scene.node_widget((*kx).sc, tn), true)
        }
        i = i + 1
    }
    return bar
}

// The sidebar: a menu; headers are headings, the other entries menu items, `active` selected.
fn kax_nav(kx: *mut KitAx, parent: usize, items: *mut kit.NavItem, n: usize, active: usize, collapsed: bool) -> usize {
    let menu: usize = scene.scene_add((*kx).sc, parent, scene.N_WIDGET)
    if menu == scene.SCENE_NONE {
        return menu
    }
    scene.node_set_widget_kind((*kx).sc, menu, widget.KIND_MENU)
    var i: usize = 0
    while i < n {
        let it: *mut kit.NavItem = kit.nav_at(items, i)
        if (*it).header {
            kax_heading(kx, menu, (*it).label)
        } else {
            var badge: str = ""
            if (*it).badge > 0 {
                badge = dec(kx, (*it).badge)
            }
            let nn: usize = node(kx, menu, widget.KIND_BUTTON, join3(kx, (*it).label, badge, ""))
            if nn != scene.SCENE_NONE {
                a11y.a11y_set_role((*kx).ax, nn, a11y.ROLE_MENUITEM)
                if i == active {
                    widget.w_set_selected(scene.node_widget((*kx).sc, nn), true)
                }
            }
        }
        i = i + 1
    }
    return menu
}

// The tile grid: a list of tiles named "title, subtitle, badge"; the selected one is pressed.
fn kax_grid(kx: *mut KitAx, parent: usize, tiles: *mut kit.Tile, n: usize, selected: usize) -> usize {
    let list: usize = scene.scene_add((*kx).sc, parent, scene.N_WIDGET)
    if list == scene.SCENE_NONE {
        return list
    }
    scene.node_set_widget_kind((*kx).sc, list, widget.KIND_LIST)
    var i: usize = 0
    while i < n {
        let t: *mut kit.Tile = kit.tile_at(tiles, i)
        let tn: usize = node(kx, list, widget.KIND_TILE, join3(kx, (*t).title, (*t).sub, (*t).badge))
        if tn != scene.SCENE_NONE && i == selected {
            a11y.a11y_set_toggle((*kx).ax, tn, true)
            widget.w_set_value(scene.node_widget((*kx).sc, tn), 1)
        }
        i = i + 1
    }
    return list
}

// The search field: a text box named by `hint`, holding the text; a Clear button while there is text.
fn kax_search(kx: *mut KitAx, parent: usize, s: *mut kit.Search, hint: str) -> usize {
    let tb: usize = node(kx, parent, widget.KIND_TEXTBOX, keep(kx, hint))
    if tb == scene.SCENE_NONE {
        return tb
    }
    let n: usize = kit.search_text_len(s)
    if n > 0 {
        let txt: str = keep(kx, str { p: rt.ptr_of(kit.search_text_ptr(s)), n: n })
        scene.node_set_text((*kx).sc, tb, txt.p as u64, txt.n)
        node(kx, parent, widget.KIND_BUTTON, "Clear")
    }
    if kit.search_has_focus(s) {
        widget.w_set_focus(scene.node_widget((*kx).sc, tb), true)
    }
    return tb
}

// A progress bar: `permille` 0..1000 (< 0 = indeterminate), `label` the text it shows (empty: "Progress").
fn kax_progress(kx: *mut KitAx, parent: usize, permille: i64, label: str) -> usize {
    var name: str = label
    if name.n == 0 {
        name = "Progress"
    }
    if permille < 0 as i64 {
        name = join3(kx, name, "working", "")
    }
    let n: usize = node(kx, parent, widget.KIND_PROGRESS, keep(kx, name))
    if n != scene.SCENE_NONE {
        var v: i64 = permille
        if v < 0 {
            v = 0
        }
        if v > 1000 {
            v = 1000
        }
        widget.w_set_value(scene.node_widget((*kx).sc, n), v)
    }
    return n
}

fn toast_kind_word(k: u32) -> str {
    if k == kit.TK_SUCCESS { return "Success" }
    if k == kit.TK_WARNING { return "Warning" }
    if k == kit.TK_ERROR { return "Error" }
    return "Information"
}

// The messages on screen: a live status node each ("Error: text"), the action and a Dismiss
// button as its children. A message that is already fading out is not described.
fn kax_toasts(kx: *mut KitAx, parent: usize, q: *mut kit.Toasts) -> usize {
    var first: usize = scene.SCENE_NONE
    var i: usize = 0
    while i < 4 {
        let t: *mut kit.Toast = &(*q).t[i]
        if (*t).alive && (*t).closing == 0 {
            let text: str = str { p: rt.ptr_of((&(*t).text[0]) as u64), n: (*t).n }
            let n: usize = scene.scene_add((*kx).sc, parent, scene.N_WIDGET)
            if n != scene.SCENE_NONE {
                scene.node_set_widget_kind((*kx).sc, n, widget.KIND_BADGE)
                let name: str = join3(kx, toast_kind_word((*t).kind), "", "")
                var full: str = keep(kx, text)
                // "Error: text": the kind word, a colon, the text
                let len: usize = rt.buf_len(&(*kx).names)
                if len + name.n + full.n + 3 <= ARENA_CAP {
                    rt.buf_push_bytes(&(*kx).names, name.p as u64, name.n)
                    rt.buf_push(&(*kx).names, 58 as u8)
                    rt.buf_push(&(*kx).names, 32 as u8)
                    rt.buf_push_bytes(&(*kx).names, full.p as u64, full.n)
                    full = str { p: rt.ptr_of(rt.buf_ptr(&(*kx).names) + len as u64), n: rt.buf_len(&(*kx).names) - len }
                }
                scene.node_set_text((*kx).sc, n, full.p as u64, full.n)
                a11y.a11y_set_name((*kx).ax, n, full.p as u64, full.n)
                scene.node_set_live((*kx).sc, n, true)
                if (*t).an > 0 {
                    node(kx, n, widget.KIND_BUTTON, keep(kx, str { p: rt.ptr_of((&(*t).action[0]) as u64), n: (*t).an }))
                }
                node(kx, n, widget.KIND_BUTTON, "Dismiss")
                if first == scene.SCENE_NONE {
                    first = n
                }
            }
        }
        i = i + 1
    }
    return first
}

// The open dialog: a group named by its title, with a Close button. SCENE_NONE while closed.
// The program describes its own controls under the returned node (the focus trap).
fn kax_modal(kx: *mut KitAx, parent: usize, m: *mut kit.Modal) -> usize {
    if !kit.modal_blocks(m) {
        return scene.SCENE_NONE
    }
    let title: str = keep(kx, str { p: rt.ptr_of((&(*m).title[0]) as u64), n: (*m).tn })
    let g: usize = scene.scene_add((*kx).sc, parent, scene.N_WIDGET)
    if g == scene.SCENE_NONE {
        return g
    }
    scene.node_set_widget_kind((*kx).sc, g, widget.KIND_GROUPBOX)
    a11y.a11y_set_name((*kx).ax, g, title.p as u64, title.n)
    node(kx, g, widget.KIND_BUTTON, "Close")
    return g
}

// A person's picture (an avatar): an image named by the person.
fn kax_avatar(kx: *mut KitAx, parent: usize, name: str) -> usize {
    let n: usize = scene.scene_add((*kx).sc, parent, scene.N_BOX)
    if n != scene.SCENE_NONE {
        let t: str = keep(kx, name)
        a11y.a11y_set_name((*kx).ax, n, t.p as u64, t.n)
        a11y.a11y_set_role((*kx).ax, n, a11y.ROLE_IMAGE)
    }
    return n
}

// ----------------------------------------------------------------------------- wave 5

// Appends `s` to the open composition in the arena (see arena_view).
fn arena_add(kx: *mut KitAx, s: str) {
    if rt.buf_len(&(*kx).names) + s.n + 1 > ARENA_CAP || s.n == 0 {
        return
    }
    rt.buf_push_bytes(&(*kx).names, s.p as u64, s.n)
}

// The decimal digits of `v`, straight into the open composition (dec() would keep() them apart).
#[allow_escape]
fn arena_dec(kx: *mut KitAx, v: usize) {
    var tmp: [u8; 24] = [0 as u8; 24]
    let n: usize = kit.fmt_uint(v as u64, &tmp)
    arena_add(kx, str { p: rt.ptr_of((&tmp[0]) as u64), n: n })
}

fn arena_num(kx: *mut KitAx, v: i64) {
    if v < 0 as i64 {
        arena_add(kx, "-")
        arena_dec(kx, (0 - v) as usize)
    } else {
        arena_dec(kx, v as usize)
    }
}

fn arena_since(kx: *mut KitAx, start: usize) -> str {
    return str { p: rt.ptr_of(rt.buf_ptr(&(*kx).names) + start as u64), n: rt.buf_len(&(*kx).names) - start }
}

// A rating: a slider named "name, 3.5 of 5" (the half only when `spp` is 2 and there is one),
// the value the filled share of the stars in per mille.
fn kax_rating(kx: *mut KitAx, parent: usize, name: str, max: usize, spp: usize, value: usize, st: u32) -> usize {
    var sp: usize = spp
    if sp == 0 {
        sp = 1
    }
    let start: usize = rt.buf_len(&(*kx).names)
    arena_add(kx, name)
    arena_add(kx, ", ")
    arena_dec(kx, value / sp)
    if value % sp != 0 {
        arena_add(kx, ".5")
    }
    arena_add(kx, " of ")
    arena_dec(kx, max)
    let n: usize = node(kx, parent, widget.KIND_SLIDER, arena_since(kx, start))
    if n != scene.SCENE_NONE {
        var pm: i64 = 0
        if max > 0 {
            pm = (value * 1000 / (max * sp)) as i64
        }
        widget.w_set_value(scene.node_widget((*kx).sc, n), pm)
    }
    apply_state(kx, n, st)
    return n
}

// A range slider (wave7): a slider named "name, 20 to 80", the value the focused thumb in per mille of min..max.
fn kax_range(kx: *mut KitAx, parent: usize, name: str, min: i64, max: i64, lo: i64, hi: i64, focus_hi: bool, st: u32) -> usize {
    let start: usize = rt.buf_len(&(*kx).names)
    arena_add(kx, name)
    arena_add(kx, ", ")
    arena_num(kx, lo)
    arena_add(kx, " to ")
    arena_num(kx, hi)
    let n: usize = node(kx, parent, widget.KIND_SLIDER, arena_since(kx, start))
    if n != scene.SCENE_NONE {
        var v: i64 = lo
        if focus_hi {
            v = hi
        }
        var pm: i64 = 0
        if max > min {
            pm = (v - min) * 1000 / (max - min)
        }
        widget.w_set_value(scene.node_widget((*kx).sc, n), pm)
    }
    apply_state(kx, n, st)
    return n
}

// The chips: a group named `name`; each chip a button (pressed while selected), a closable one with
// a "Remove, label" button as its child. `focus` is the chip with the keyboard focus (kit.NONE).
fn kax_chips(kx: *mut KitAx, parent: usize, name: str, chips: *mut wave5.Chip, n: usize, focus: usize) -> usize {
    let g: usize = scene.scene_add((*kx).sc, parent, scene.N_WIDGET)
    if g == scene.SCENE_NONE {
        return g
    }
    scene.node_set_widget_kind((*kx).sc, g, widget.KIND_GROUPBOX)
    let gn: str = keep(kx, name)
    a11y.a11y_set_name((*kx).ax, g, gn.p as u64, gn.n)
    var i: usize = 0
    while i < n {
        let ch: *mut wave5.Chip = wave5.chip_at(chips, i)
        let cn: usize = node(kx, g, widget.KIND_BUTTON, keep(kx, (*ch).label))
        if cn != scene.SCENE_NONE {
            if (*ch).selected {
                a11y.a11y_set_toggle((*kx).ax, cn, true)
                widget.w_set_value(scene.node_widget((*kx).sc, cn), 1)
            }
            if i == focus {
                widget.w_set_focus(scene.node_widget((*kx).sc, cn), true)
            }
            if (*ch).close {
                node(kx, cn, widget.KIND_BUTTON, join3(kx, "Remove", (*ch).label, ""))
            }
        }
        i = i + 1
    }
    return g
}

// A segmented control: a group named `name` of radio buttons, the chosen one checked.
fn kax_segmented(kx: *mut KitAx, parent: usize, name: str, segs: *mut wave5.Seg, n: usize, sel: usize) -> usize {
    let g: usize = scene.scene_add((*kx).sc, parent, scene.N_WIDGET)
    if g == scene.SCENE_NONE {
        return g
    }
    scene.node_set_widget_kind((*kx).sc, g, widget.KIND_GROUPBOX)
    let gn: str = keep(kx, name)
    a11y.a11y_set_name((*kx).ax, g, gn.p as u64, gn.n)
    var i: usize = 0
    while i < n {
        let s: *mut wave5.Seg = wave5.seg_at(segs, i)
        let rn: usize = node(kx, g, widget.KIND_RADIO, keep(kx, (*s).label))
        if rn != scene.SCENE_NONE && i == sel {
            widget.w_set_value(scene.node_widget((*kx).sc, rn), 1)
            widget.w_set_selected(scene.node_widget((*kx).sc, rn), true)
        }
        i = i + 1
    }
    return g
}

// A chart: an image named "name, min 2, max 9, last 7" (whole numbers; "no data" for none).
fn kax_chart(kx: *mut KitAx, parent: usize, name: str, vals: *mut f64, n: usize) -> usize {
    let start: usize = rt.buf_len(&(*kx).names)
    arena_add(kx, name)
    if n == 0 {
        arena_add(kx, ", no data")
    } else {
        var lo: f64 = *vals
        var hi: f64 = *vals
        var i: usize = 0
        while i < n {
            let v: f64 = *((vals as usize + i * 8) as *mut f64)
            if v < lo { lo = v }
            if v > hi { hi = v }
            i = i + 1
        }
        let last: f64 = *((vals as usize + (n - 1) * 8) as *mut f64)
        arena_add(kx, ", min ")
        arena_num(kx, lo as i64)
        arena_add(kx, ", max ")
        arena_num(kx, hi as i64)
        arena_add(kx, ", last ")
        arena_num(kx, last as i64)
    }
    let nm: str = arena_since(kx, start)
    let node_i: usize = scene.scene_add((*kx).sc, parent, scene.N_BOX)
    if node_i != scene.SCENE_NONE {
        a11y.a11y_set_name((*kx).ax, node_i, nm.p as u64, nm.n)
        a11y.a11y_set_role((*kx).ax, node_i, a11y.ROLE_IMAGE)
    }
    return node_i
}

// A skeleton (placeholder): a progress bar named `label` (empty: "Loading") without a value.
fn kax_skeleton(kx: *mut KitAx, parent: usize, label: str) -> usize {
    var nm: str = label
    if nm.n == 0 {
        nm = "Loading"
    }
    return node(kx, parent, widget.KIND_PROGRESS, keep(kx, nm))
}

// The page dots: a toolbar of tabs "Page 1" .. "Page n", the current one selected.
fn kax_pagedots(kx: *mut KitAx, parent: usize, n: usize, cur: usize) -> usize {
    let bar: usize = scene.scene_add((*kx).sc, parent, scene.N_WIDGET)
    if bar == scene.SCENE_NONE {
        return bar
    }
    scene.node_set_widget_kind((*kx).sc, bar, widget.KIND_TOOLBAR)
    var i: usize = 0
    while i < n {
        let ps: usize = rt.buf_len(&(*kx).names)
        arena_add(kx, "Page ")
        arena_dec(kx, i + 1)
        let tn: usize = node(kx, bar, widget.KIND_TAB, arena_since(kx, ps))
        if tn != scene.SCENE_NONE && i == cur {
            widget.w_set_selected(scene.node_widget((*kx).sc, tn), true)
        }
        i = i + 1
    }
    return bar
}

// A pager: a group "name, page 2 of 5" with the Previous / Next buttons (disabled at the ends)
// and the page dots. The program describes the visible page's own controls under the group.
fn kax_pager(kx: *mut KitAx, parent: usize, name: str, p: *mut wave5.Pager) -> usize {
    let g: usize = scene.scene_add((*kx).sc, parent, scene.N_WIDGET)
    if g == scene.SCENE_NONE {
        return g
    }
    scene.node_set_widget_kind((*kx).sc, g, widget.KIND_GROUPBOX)
    let start: usize = rt.buf_len(&(*kx).names)
    arena_add(kx, name)
    arena_add(kx, ", page ")
    arena_dec(kx, (*p).cur + 1)
    arena_add(kx, " of ")
    arena_dec(kx, (*p).n)
    let gn: str = arena_since(kx, start)
    a11y.a11y_set_name((*kx).ax, g, gn.p as u64, gn.n)
    var prev_st: u32 = 0 as u32
    if (*p).cur == 0 {
        prev_st = kit.ST_DISABLED
    }
    var next_st: u32 = 0 as u32
    if (*p).cur + 1 >= (*p).n {
        next_st = kit.ST_DISABLED
    }
    kax_button(kx, g, "Previous", prev_st)
    kax_button(kx, g, "Next", next_st)
    kax_pagedots(kx, g, (*p).n, (*p).cur)
    return g
}

// A bottom sheet: a dialog group `name` holding the grab handle as a slider "Resize" (the shown height in
// permille); nothing when the sheet is closed. The program describes its content under the returned node.
// `st`: kit.ST_FOCUS marks the handle as focused.
fn kax_sheet(kx: *mut KitAx, parent: usize, name: str, s: *mut wave6.Sheet, st: u32) -> usize {
    if !wave6.sheet_is_open(s) {
        return scene.SCENE_NONE
    }
    let g: usize = scene.scene_add((*kx).sc, parent, scene.N_WIDGET)
    if g == scene.SCENE_NONE {
        return g
    }
    scene.node_set_widget_kind((*kx).sc, g, widget.KIND_GROUPBOX)
    let gn: str = keep(kx, name)
    a11y.a11y_set_name((*kx).ax, g, gn.p as u64, gn.n)
    a11y.a11y_set_role((*kx).ax, g, a11y.ROLE_DIALOG)
    let h: usize = node(kx, g, widget.KIND_SLIDER, "Resize")
    if h != scene.SCENE_NONE {
        widget.w_set_value(scene.node_widget((*kx).sc, h), (wave6.sheet_pos(s) * 1000.0) as i64)
        apply_state(kx, h, st)
    }
    return g
}

// A property grid: a tree named `name`; a group row = tree item (expanded / collapsed) named by its label, a
// value row = "label, value" (switch = check box with its state). Only visible rows are described.
fn kax_propgrid(kx: *mut KitAx, parent: usize, name: str, g: *mut wave6.PGrid, rows: *mut wave6.PgRow, n: usize,
    focus: bool) -> usize {
    let t: usize = scene.scene_add((*kx).sc, parent, scene.N_WIDGET)
    if t == scene.SCENE_NONE {
        return t
    }
    scene.node_set_widget_kind((*kx).sc, t, widget.KIND_TREE)
    let tn: str = keep(kx, name)
    a11y.a11y_set_name((*kx).ax, t, tn.p as u64, tn.n)
    var i: usize = 0
    while i < n {
        let r: *mut wave6.PgRow = wave6.pg_row_at(rows, i)
        if !wave6.pg_is_visible(rows, n, i) {
            i = i + 1
        } else {
            var rn: usize = scene.SCENE_NONE
            if (*r).kind == wave6.PG_GROUP {
                rn = node(kx, t, widget.KIND_BUTTON, keep(kx, (*r).label))
                if rn != scene.SCENE_NONE {
                    a11y.a11y_set_role((*kx).ax, rn, a11y.ROLE_TREEITEM)
                    if (*r).on {
                        a11y.a11y_set_expanded((*kx).ax, rn, 2 as u32)
                    } else {
                        a11y.a11y_set_expanded((*kx).ax, rn, 1 as u32)
                    }
                }
            } else if (*r).kind == wave6.PG_BOOL {
                rn = node(kx, t, widget.KIND_CHECKBOX, keep(kx, (*r).label))
                if rn != scene.SCENE_NONE {
                    widget.w_set_value(scene.node_widget((*kx).sc, rn), if_on((*r).on))
                }
            } else {
                let ps: usize = rt.buf_len(&(*kx).names)
                arena_add(kx, (*r).label)
                arena_add(kx, ", ")
                if (*r).kind == wave6.PG_NUM {
                    var v: i64 = (*r).num
                    if v < 0 as i64 {
                        arena_add(kx, "-")
                        v = 0 as i64 - v
                    }
                    arena_dec(kx, v as usize)
                    if (*r).text.n > 0 {
                        arena_add(kx, " ")
                        arena_add(kx, (*r).text)
                    }
                } else if (*r).kind == wave6.PG_COLOR {
                    arena_add(kx, "color")
                } else {
                    arena_add(kx, (*r).text)
                }
                rn = node(kx, t, widget.KIND_BUTTON, arena_since(kx, ps))
                if rn != scene.SCENE_NONE && (*r).readonly {
                    a11y.a11y_set_readonly((*kx).ax, rn, true)
                }
            }
            if rn != scene.SCENE_NONE {
                if i == (*g).sel {
                    widget.w_set_selected(scene.node_widget((*kx).sc, rn), true)
                    if focus {
                        widget.w_set_focus(scene.node_widget((*kx).sc, rn), true)
                    }
                }
            }
            i = i + 1
        }
    }
    return t
}

fn if_on(b: bool) -> i64 {
    if b {
        return 1000
    }
    return 0
}

// ---- wave 8 (lib/fui/wave8.fi)

// A busy ring: a progress node "label, working" (no value). A still one (reduced motion) says the same.
fn kax_spinner(kx: *mut KitAx, parent: usize, label: str) -> usize {
    var name: str = label
    if name.n == 0 {
        name = "Loading"
    }
    return kax_progress(kx, parent, 0 - 1, name)
}

// A time field: a group named "name, 07:30" (12 h: "07:30 PM"); the value is the minute of the day in per mille of 24 h.
#[allow_escape]
fn kax_timepicker(kx: *mut KitAx, parent: usize, name: str, t: *mut wave8.Time, st: u32) -> usize {
    let start: usize = rt.buf_len(&(*kx).names)
    arena_add(kx, name)
    arena_add(kx, ", ")
    var f: usize = 0
    while f < wave8.tp_fields(t) {
        var tb: [u8; 24] = [0 as u8; 24]
        let n: usize = wave8.tp_text(t, f, &tb)
        if f == wave8.TP_AMPM {
            arena_add(kx, " ")
        } else if f > 0 {
            arena_add(kx, ":")
        }
        arena_add(kx, str { p: rt.ptr_of((&tb[0]) as u64), n: n })
        f = f + 1
    }
    let g: usize = node(kx, parent, widget.KIND_GROUPBOX, arena_since(kx, start))
    if g != scene.SCENE_NONE {
        widget.w_set_value(scene.node_widget((*kx).sc, g), (((*t).h * 60 + (*t).m) * 1000 / 1440) as i64)
    }
    apply_state(kx, g, st)
    return g
}

// A path: a group named `name`, every crumb a button; the last one is the current page (pressed). `focus` = crumb or kit.NONE.
fn kax_breadcrumb(kx: *mut KitAx, parent: usize, name: str, cr: *mut wave8.Crumbs, focus: usize) -> usize {
    let g: usize = scene.scene_add((*kx).sc, parent, scene.N_WIDGET)
    if g == scene.SCENE_NONE {
        return g
    }
    scene.node_set_widget_kind((*kx).sc, g, widget.KIND_GROUPBOX)
    let gn: str = keep(kx, name)
    a11y.a11y_set_name((*kx).ax, g, gn.p as u64, gn.n)
    var i: usize = 0
    while i < (*cr).n {
        let cn: usize = node(kx, g, widget.KIND_BUTTON, keep(kx, (*cr).label[i]))
        if cn != scene.SCENE_NONE {
            if i + 1 == (*cr).n {
                a11y.a11y_set_toggle((*kx).ax, cn, true)
                widget.w_set_value(scene.node_widget((*kx).sc, cn), 1)
            }
            if i == focus {
                widget.w_set_focus(scene.node_widget((*kx).sc, cn), true)
            }
        }
        i = i + 1
    }
    return g
}

// An info bar: a status node "Warning: title, message" (an error is an alert), the action and Close as button children.
fn kax_infobar(kx: *mut KitAx, parent: usize, ib: *mut wave8.InfoBar) -> usize {
    var word: str = "Information"
    if (*ib).severity == wave8.IB_SUCCESS { word = "Success" }
    if (*ib).severity == wave8.IB_WARNING { word = "Warning" }
    if (*ib).severity == wave8.IB_ERROR { word = "Error" }
    let start: usize = rt.buf_len(&(*kx).names)
    arena_add(kx, word)
    arena_add(kx, ": ")
    arena_add(kx, (*ib).title)
    if (*ib).message.n > 0 {
        arena_add(kx, ", ")
        arena_add(kx, (*ib).message)
    }
    let n: usize = node(kx, parent, widget.KIND_GROUPBOX, arena_since(kx, start))
    if n == scene.SCENE_NONE {
        return n
    }
    var role: u32 = a11y.ROLE_STATUS
    if (*ib).severity == wave8.IB_ERROR {
        role = a11y.ROLE_ALERTDIALOG
    }
    a11y.a11y_set_role((*kx).ax, n, role)
    if (*ib).action.n > 0 {
        node(kx, n, widget.KIND_BUTTON, keep(kx, (*ib).action))
    }
    if (*ib).closable {
        node(kx, n, widget.KIND_BUTTON, "Close")
    }
    return n
}

// A wizard: a group named "name, step 2 of 4"; every step a button "label, done|current|todo" (the current one pressed).
fn kax_stepper(kx: *mut KitAx, parent: usize, name: str, s: *mut wave8.Steps, current: usize) -> usize {
    let start: usize = rt.buf_len(&(*kx).names)
    arena_add(kx, name)
    arena_add(kx, ", step ")
    arena_num(kx, (current + 1) as i64)
    arena_add(kx, " of ")
    arena_num(kx, (*s).n as i64)
    let g: usize = scene.scene_add((*kx).sc, parent, scene.N_WIDGET)
    if g == scene.SCENE_NONE {
        return g
    }
    scene.node_set_widget_kind((*kx).sc, g, widget.KIND_GROUPBOX)
    let gn: str = arena_since(kx, start)
    a11y.a11y_set_name((*kx).ax, g, gn.p as u64, gn.n)
    var i: usize = 0
    while i < (*s).n {
        var word: str = "todo"
        if i < current { word = "done" }
        if i == current { word = "current" }
        let cn: usize = node(kx, g, widget.KIND_BUTTON, join3(kx, (*s).label[i], word, ""))
        if cn != scene.SCENE_NONE && i == current {
            a11y.a11y_set_toggle((*kx).ax, cn, true)
            widget.w_set_value(scene.node_widget((*kx).sc, cn), 1)
        }
        i = i + 1
    }
    return g
}

// "rows, tabs (move, copy)" into the open composition.
fn arena_kinds_ops(kx: *mut KitAx, kinds: u32, ops: u32) {
    var first: bool = true
    var k: u32 = 1 as u32
    while k <= 16 as u32 {
        if (kinds & k) != 0 as u32 {
            if !first { arena_add(kx, ", ") }
            first = false
            var w: str = "items"
            if k == dnd.KIND_TEXT { w = "text" }
            if k == dnd.KIND_ROW { w = "rows" }
            if k == dnd.KIND_FILE { w = "files" }
            if k == dnd.KIND_TAB { w = "tabs" }
            arena_add(kx, w)
        }
        k = k * 2 as u32
    }
    arena_add(kx, " (")
    first = true
    if (ops & dnd.OP_MOVE) != 0 as u32 {
        arena_add(kx, "move")
        first = false
    }
    if (ops & dnd.OP_COPY) != 0 as u32 {
        if !first { arena_add(kx, ", ") }
        arena_add(kx, "copy")
        first = false
    }
    if (ops & dnd.OP_LINK) != 0 as u32 {
        if !first { arena_add(kx, ", ") }
        arena_add(kx, "link")
    }
    arena_add(kx, ")")
}

// Something that can be dragged: a group named `name`, pressed while it is `grabbed`. The description says what
// it is and how to take it (Ctrl+Space); grabbed, it says how to place it. kind = dnd.KIND_*, ops = dnd.OP_* bits.
fn kax_dnd_source(kx: *mut KitAx, parent: usize, name: str, kind: u32, ops: u32, grabbed: bool) -> usize {
    let g: usize = node(kx, parent, widget.KIND_GROUPBOX, keep(kx, name))
    if g == scene.SCENE_NONE {
        return g
    }
    let start: usize = rt.buf_len(&(*kx).names)
    if grabbed {
        arena_add(kx, "Grabbed. Up and Down choose the drop position, Enter drops, Escape cancels.")
        a11y.a11y_set_toggle((*kx).ax, g, true)
        widget.w_set_value(scene.node_widget((*kx).sc, g), 1)
    } else {
        arena_add(kx, "Draggable: ")
        arena_kinds_ops(kx, kind, ops)
        arena_add(kx, ". Ctrl+Space grabs.")
    }
    let d: str = arena_since(kx, start)
    a11y.a11y_set_description((*kx).ax, g, d.p as u64, d.n)
    return g
}

// Something that takes drops: a group "name, drop target" (", drop here" while a drag is over it) whose
// description lists the kinds and operations it accepts; `tree` = a drop may also land ON one of its rows.
fn kax_dnd_target(kx: *mut KitAx, parent: usize, name: str, kinds: u32, ops: u32, tree: bool, hot: bool) -> usize {
    let start: usize = rt.buf_len(&(*kx).names)
    arena_add(kx, name)
    arena_add(kx, ", drop target")
    if hot {
        arena_add(kx, ", drop here")
    }
    let nm: str = arena_since(kx, start)
    let g: usize = node(kx, parent, widget.KIND_GROUPBOX, nm)
    if g == scene.SCENE_NONE {
        return g
    }
    let d0: usize = rt.buf_len(&(*kx).names)
    arena_add(kx, "Accepts: ")
    arena_kinds_ops(kx, kinds, ops)
    if tree {
        arena_add(kx, ", onto rows too")
    }
    arena_add(kx, ".")
    let d: str = arena_since(kx, d0)
    a11y.a11y_set_description((*kx).ax, g, d.p as u64, d.n)
    return g
}

// The live line while an item is carried: a status node "Grabbed Row 3. Drop at position 4 of 9".
fn kax_dnd_status(kx: *mut KitAx, parent: usize, item: str, pos: usize, total: usize) -> usize {
    let start: usize = rt.buf_len(&(*kx).names)
    arena_add(kx, "Grabbed ")
    arena_add(kx, item)
    arena_add(kx, ". Drop at position ")
    arena_dec(kx, pos)
    arena_add(kx, " of ")
    arena_dec(kx, total)
    let n: usize = node(kx, parent, widget.KIND_GROUPBOX, arena_since(kx, start))
    if n != scene.SCENE_NONE {
        a11y.a11y_set_role((*kx).ax, n, a11y.ROLE_STATUS)
    }
    return n
}

// An accordion: a group named `name`; every section header is a button named by its title, expanded or collapsed from
// the model; the focused header (`g.focus`) is focused when `focused`. The open bodies are the caller's children.
fn kax_accordion(kx: *mut KitAx, parent: usize, name: str, titles: *mut str, g: *mut wave8m.Accordion, focused: bool) -> usize {
    let n0: usize = scene.scene_add((*kx).sc, parent, scene.N_WIDGET)
    if n0 == scene.SCENE_NONE {
        return n0
    }
    scene.node_set_widget_kind((*kx).sc, n0, widget.KIND_GROUPBOX)
    let gn: str = keep(kx, name)
    a11y.a11y_set_name((*kx).ax, n0, gn.p as u64, gn.n)
    var i: usize = 0
    while i < (*g).n {
        let h: usize = node(kx, n0, widget.KIND_BUTTON, keep(kx, *((titles as u64 + (i * 16) as u64) as *mut str)))
        if h != scene.SCENE_NONE {
            var ex: u32 = a11y.EXP_COLLAPSED
            if wave8m.acc_is_open(g, i) { ex = a11y.EXP_EXPANDED }
            a11y.a11y_set_expanded((*kx).ax, h, ex)
            if focused && i == (*g).focus {
                widget.w_set_focus(scene.node_widget((*kx).sc, h), true)
            }
        }
        i = i + 1
    }
    return n0
}

// A toolbar after the fit: `labels[0..n]`, `mask` = the items still in the bar (wave8m.toolbar_fit), `open` = the
// panel of folded items is open. The bar lists the items that fit; a folded item is listed after the "More" button.
fn kax_toolbar(kx: *mut KitAx, parent: usize, name: str, labels: *mut str, n: usize, mask: u64, open: bool) -> usize {
    let t: usize = scene.scene_add((*kx).sc, parent, scene.N_WIDGET)
    if t == scene.SCENE_NONE {
        return t
    }
    scene.node_set_widget_kind((*kx).sc, t, widget.KIND_GROUPBOX)
    a11y.a11y_set_role((*kx).ax, t, a11y.ROLE_TOOLBAR)
    let tn: str = keep(kx, name)
    a11y.a11y_set_name((*kx).ax, t, tn.p as u64, tn.n)
    var folded: usize = 0
    var i: usize = 0
    while i < n {
        if (mask & ((1 as u64) << (i as u64))) != (0 as u64) {
            node(kx, t, widget.KIND_BUTTON, keep(kx, *((labels as u64 + (i * 16) as u64) as *mut str)))
        } else {
            folded = folded + 1
        }
        i = i + 1
    }
    if folded > 0 {
        let start: usize = rt.buf_len(&(*kx).names)
        arena_add(kx, "More, ")
        arena_dec(kx, folded)
        arena_add(kx, " folded")
        let m: usize = node(kx, t, widget.KIND_BUTTON, arena_since(kx, start))
        if m != scene.SCENE_NONE {
            var ex: u32 = a11y.EXP_COLLAPSED
            if open { ex = a11y.EXP_EXPANDED }
            a11y.a11y_set_expanded((*kx).ax, m, ex)
        }
        if open {
            var k: usize = 0
            while k < n {
                if (mask & ((1 as u64) << (k as u64))) == (0 as u64) {
                    node(kx, t, widget.KIND_BUTTON, keep(kx, *((labels as u64 + (k * 16) as u64) as *mut str)))
                }
                k = k + 1
            }
        }
    }
    return t
}

// A table (appctl.table twin): a header row and a row per data row, every cell a cell node.
// `titles` = ncols names, `cells` = nrows * ncols texts (row after row). `sort_col` >= ncols = unsorted.
fn kax_table(kx: *mut KitAx, parent: usize, name: str, titles: *mut str, ncols: usize, cells: *mut str, nrows: usize,
    sort_col: usize, desc: bool, cur_row: usize, cur_col: usize, editing: bool) -> usize {
    let t: usize = scene.scene_add((*kx).sc, parent, scene.N_WIDGET)
    if t == scene.SCENE_NONE {
        return t
    }
    scene.node_set_widget_kind((*kx).sc, t, widget.KIND_GROUPBOX)
    a11y.a11y_set_role((*kx).ax, t, a11y.ROLE_TABLE)
    let tn: str = keep(kx, name)
    a11y.a11y_set_name((*kx).ax, t, tn.p as u64, tn.n)
    let hr: usize = scene.scene_add((*kx).sc, t, scene.N_WIDGET)
    if hr != scene.SCENE_NONE {
        scene.node_set_widget_kind((*kx).sc, hr, widget.KIND_GROUPBOX)
        a11y.a11y_set_role((*kx).ax, hr, a11y.ROLE_ROW)
        let hn: str = keep(kx, "Header")
        a11y.a11y_set_name((*kx).ax, hr, hn.p as u64, hn.n)
        var c: usize = 0
        while c < ncols {
            let start: usize = rt.buf_len(&(*kx).names)
            arena_add(kx, *((titles as u64 + (c * 16) as u64) as *mut str))
            if c == sort_col {
                if desc {
                    arena_add(kx, ", sorted descending")
                } else {
                    arena_add(kx, ", sorted ascending")
                }
            }
            let cn: usize = node(kx, hr, widget.KIND_LABEL, arena_since(kx, start))
            if cn != scene.SCENE_NONE {
                a11y.a11y_set_role((*kx).ax, cn, a11y.ROLE_CELL)
            }
            c = c + 1
        }
    }
    var r: usize = 0
    while r < nrows {
        let rn: usize = scene.scene_add((*kx).sc, t, scene.N_WIDGET)
        if rn != scene.SCENE_NONE {
            scene.node_set_widget_kind((*kx).sc, rn, widget.KIND_GROUPBOX)
            a11y.a11y_set_role((*kx).ax, rn, a11y.ROLE_ROW)
            let start2: usize = rt.buf_len(&(*kx).names)
            arena_add(kx, "Row ")
            arena_dec(kx, r + 1)
            let rname: str = arena_since(kx, start2)
            a11y.a11y_set_name((*kx).ax, rn, rname.p as u64, rname.n)
            var k: usize = 0
            while k < ncols {
                let start3: usize = rt.buf_len(&(*kx).names)
                arena_add(kx, *((cells as u64 + ((r * ncols + k) * 16) as u64) as *mut str))
                if r == cur_row && k == cur_col {
                    arena_add(kx, ", current cell")
                    if editing {
                        arena_add(kx, ", editing")
                    }
                }
                let cn2: usize = node(kx, rn, widget.KIND_LABEL, arena_since(kx, start3))
                if cn2 != scene.SCENE_NONE {
                    a11y.a11y_set_role((*kx).ax, cn2, a11y.ROLE_CELL)
                }
                k = k + 1
            }
        }
        r = r + 1
    }
    return t
}
