// SPDX-License-Identifier: GPL-2.0-only
// lib/widget/textbuf.fi -- EIN EINZEILIGES TEXTFELD, OHNE BILDSCHIRM.
//
// ===================================================================
// WARUM DIESE DATEI EXISTIERT (Runde TEXTBOX-2)
// ===================================================================
//
// Bis zu dieser Runde lag "die Textbox" der Adresszeile in drei Dateien
// zugleich: der Puffer in lib/android/a_main.fi (`G_EINGABE`), die
// Schreibmarke in lib/android/ui.fi (`cpos`, `sel` = alles oder nichts)
// und die Rechnung in UTF-16-Einheiten in lib/android/ime.fi (`G_SEL`,
// `G_COMP`). Drei Orte, drei halbe Wahrheiten -- und ein Zeiger, der nur
// "am Ende" oder "alles markiert" kannte. Justins Frage war: "Was fehlt
// noch bis zu einer normalen Textbox?" Die Antwort: ein Ort, an dem sie
// GANZ steht.
//
// Das ist diese Datei. Sie kennt KEINE Leinwand, KEIN Android, KEINE
// Schrift. Sie kennt einen Puffer in WTF-8, eine Schreibmarke (`caret`),
// einen Anker (`anchor`; ungleich `caret` heisst: es ist etwas
// markiert) und einen schwebenden Bereich (`comp_a..comp_b`, das Wort,
// das eine Bildschirmtastatur gerade zusammensetzt). Alles, was ein
// TextBuf TUT -- einfuegen, loeschen, markieren, Wort greifen, Zeiger
// mit Pfeiltasten bewegen, Zeiger align einer Fingerstelle bestimmen --
// steht hier EINMAL, und jeder Bildschirm (Android, X11, Windows) malt
// nur noch, was hier steht.
//
// ===================================================================
// WAS ES BRAUCHT, UM EINEN FINGER ZU VERSTEHEN
// ===================================================================
//
// Ein TextBuf ohne Schrift weiss nicht, how breit "Tirol" ist. Es
// fragt: `tb_caret_from_x(t, x, mess, ctx)` bekommt eine Messfunktion
// `mess(ctx, p, n) -> Breite der ersten n Oktett in Bildpunkten`. Der
// Aufrufer gibt seine Schrift ueber `ctx` mit. So bleibt die Regel "wer
// auf die rechte Haelfte eines Zeichens tippt, will dahinter stehen"
// hier, und die Schrift dort, wo sie hingehoert.
//
// ===================================================================
// MASSE
// ===================================================================
//
// Alle Stellen sind OKTETT-Versaetze in den Puffer und liegen immer auf
// einer Zeichengrenze (kein 10xxxxxx-Fortsetzungsoktett). Android
// rechnet in UTF-16-Einheiten; `tb_u16_of` und `tb_byte_from_u16`
// rechnen um, damit lib/android/ime.fi es nicht selbst tun muss.
//
// KEIN Sammlerobjekt und KEIN `rt`: der Puffer kommt vom Aufrufer
// (`tb_init`), alle Rechnungen laufen auf rohen Zeigern, jede Funktion
// ausser den zwei mit Messrueckruf ist `#[no_gc]` -- damit darf die
// Datei auch von einem Faden ohne Sammler benutzt werden.

export {
    TextBuf,
    tb_new, tb_init,
    tb_ptr, tb_len, tb_cap, tb_caret, tb_anchor, tb_sel_a, tb_sel_b,
    tb_has_sel, tb_comp_a, tb_comp_b, tb_has_comp,
    tb_set_text, tb_clear, tb_set_len,
    tb_select_all, tb_set_range, tb_set_caret, tb_clear_sel,
    tb_insert, tb_insert_cp, tb_replace, tb_delete,
    tb_backspace, tb_delete_fwd, tb_delete_sel,
    tb_left, tb_right, tb_home, tb_end,
    tb_prev, tb_next, tb_is_boundary,
    tb_word_at, tb_select_word, tb_is_word_byte,
    tb_copy, tb_cut,
    tb_comp_set, tb_comp_end,
    tb_x_of, tb_caret_from_x,
    tb_u16_of, tb_byte_from_u16, tb_u16_len,
    tb_cp_at, tb_cp_encode,
    tb_drag, tb_set_drag, tb_secret, tb_set_secret,
}

struct TextBuf {
    p: u64,          // der Puffer (WTF-8), gehoert dem Aufrufer
    n: usize,        // wieviele Oktett belegt sind
    cap: usize,      // wieviele Platz haben
    caret: usize,   // die Schreibmarke, Oktettversatz
    anchor: usize,    // das andere Ende der Markierung (== caret: keine)
    comp_a: usize,   // schwebender Text [comp_a, comp_b)
    comp_b: usize,
    secret: u32,     // 1 = Passwort: nichts nach draussen geben
    drag: u32,       // 0 keine, 1 Zeiger wird gezogen, 2 Anfangsgriff, 3 Endgriff
    scroll: f64,      // waagrechter Versatz in Bildpunkten (fuer lange Texte)
}

#[no_gc]
fn tb_new() -> TextBuf {
    return TextBuf {
        p: 0, n: 0, cap: 0, caret: 0, anchor: 0, comp_a: 0, comp_b: 0,
        secret: 0, drag: 0, scroll: 0.0,
    }
}

#[no_gc]
fn tb_init(t: *mut TextBuf, p: u64, cap: usize) {
    (*t).p = p
    (*t).cap = cap
    (*t).n = 0
    (*t).caret = 0
    (*t).anchor = 0
    (*t).comp_a = 0
    (*t).comp_b = 0
}

// ------------------------------------------------------------ Lesen
#[no_gc]
fn tb_ptr(t: *mut TextBuf) -> u64 { return (*t).p }
#[no_gc]
fn tb_len(t: *mut TextBuf) -> usize { return (*t).n }
#[no_gc]
fn tb_cap(t: *mut TextBuf) -> usize { return (*t).cap }
#[no_gc]
fn tb_caret(t: *mut TextBuf) -> usize { return (*t).caret }
#[no_gc]
fn tb_anchor(t: *mut TextBuf) -> usize { return (*t).anchor }
#[no_gc]
fn tb_has_sel(t: *mut TextBuf) -> bool { return (*t).anchor != (*t).caret }
#[no_gc]
fn tb_comp_a(t: *mut TextBuf) -> usize { return (*t).comp_a }
#[no_gc]
fn tb_comp_b(t: *mut TextBuf) -> usize { return (*t).comp_b }
#[no_gc]
fn tb_has_comp(t: *mut TextBuf) -> bool { return (*t).comp_b > (*t).comp_a }
#[no_gc]
fn tb_drag(t: *mut TextBuf) -> u32 { return (*t).drag }
#[no_gc]
fn tb_set_drag(t: *mut TextBuf, z: u32) { (*t).drag = z }
#[no_gc]
fn tb_secret(t: *mut TextBuf) -> bool { return (*t).secret != 0 }
#[no_gc]
fn tb_set_secret(t: *mut TextBuf, g: bool) {
    if g { (*t).secret = 1 } else { (*t).secret = 0 }
}

// Anfang und Ende der Markierung, geordnet.
#[no_gc]
fn tb_sel_a(t: *mut TextBuf) -> usize {
    if (*t).anchor < (*t).caret { return (*t).anchor }
    return (*t).caret
}
#[no_gc]
fn tb_sel_b(t: *mut TextBuf) -> usize {
    if (*t).anchor > (*t).caret { return (*t).anchor }
    return (*t).caret
}

// ----------------------------------------------------- Zeichengrenzen
#[no_gc]
fn byte_of(t: *mut TextBuf, i: usize) -> u8 {
    return *(((*t).p + i as u64) as *mut u8)
}

// Ist `i` eine Zeichengrenze? 0 und n sind es immer.
#[no_gc]
fn tb_is_boundary(t: *mut TextBuf, i: usize) -> bool {
    if i == 0 || i >= (*t).n {
        return true
    }
    return (byte_of(t, i) & 0xC0 as u8) != 0x80 as u8
}

// Die Grenze VOR `i` (0, wenn es keine gibt).
#[no_gc]
fn tb_prev(t: *mut TextBuf, i: usize) -> usize {
    if i == 0 {
        return 0
    }
    var a: usize = i - 1
    while a > 0 && !tb_is_boundary(t, a) {
        a = a - 1
    }
    return a
}

// Die Grenze NACH `i` (n, wenn es keine gibt).
#[no_gc]
fn tb_next(t: *mut TextBuf, i: usize) -> usize {
    if i >= (*t).n {
        return (*t).n
    }
    var b: usize = i + 1
    while b < (*t).n && !tb_is_boundary(t, b) {
        b = b + 1
    }
    return b
}

// Auf die naechste Grenze left runden und in den Puffer klemmen.
#[no_gc]
fn clamp(t: *mut TextBuf, i0: usize) -> usize {
    var i: usize = i0
    if i > (*t).n {
        i = (*t).n
    }
    while i > 0 && !tb_is_boundary(t, i) {
        i = i - 1
    }
    return i
}

// ------------------------------------------------------ Kodepunkte
// Der Kodepunkt an Oktett `i`; `*adv` = wieviele Oktett er belegt.
#[no_gc]
fn tb_cp_at(t: *mut TextBuf, i: usize, adv: *mut usize) -> u32 {
    let n: usize = (*t).n
    if i >= n {
        *adv = 0
        return 0 as u32
    }
    let b0: u32 = byte_of(t, i) as u32
    if b0 < 0x80 as u32 {
        *adv = 1
        return b0
    }
    if b0 >= 0xF0 as u32 && i + 3 < n {
        *adv = 4
        return ((b0 & 0x07 as u32) << 18)
            | ((byte_of(t, i + 1) as u32 & 0x3F as u32) << 12)
            | ((byte_of(t, i + 2) as u32 & 0x3F as u32) << 6)
            | (byte_of(t, i + 3) as u32 & 0x3F as u32)
    }
    if b0 >= 0xE0 as u32 && i + 2 < n {
        *adv = 3
        return ((b0 & 0x0F as u32) << 12)
            | ((byte_of(t, i + 1) as u32 & 0x3F as u32) << 6)
            | (byte_of(t, i + 2) as u32 & 0x3F as u32)
    }
    if b0 >= 0xC0 as u32 && i + 1 < n {
        *adv = 2
        return ((b0 & 0x1F as u32) << 6)
            | (byte_of(t, i + 1) as u32 & 0x3F as u32)
    }
    *adv = 1
    return 0xFFFD as u32
}

// Einen Kodepunkt nach WTF-8 kodieren (Vieroktettzweig fuer Emoji).
// Rueckgabe: Zahl der Oktett in `roh` (Platz fuer 4).
#[no_gc]
fn tb_cp_encode(cp: u32, roh: u64) -> usize {
    if cp < 0x80 as u32 {
        *(roh as *mut u8) = cp as u8
        return 1
    }
    if cp < 0x800 as u32 {
        *(roh as *mut u8) = (0xC0 as u32 | (cp >> 6)) as u8
        *((roh + 1) as *mut u8) = (0x80 as u32 | (cp & 0x3F as u32)) as u8
        return 2
    }
    if cp < 0x10000 as u32 {
        *(roh as *mut u8) = (0xE0 as u32 | (cp >> 12)) as u8
        *((roh + 1) as *mut u8) = (0x80 as u32 | ((cp >> 6) & 0x3F as u32)) as u8
        *((roh + 2) as *mut u8) = (0x80 as u32 | (cp & 0x3F as u32)) as u8
        return 3
    }
    *(roh as *mut u8) = (0xF0 as u32 | (cp >> 18)) as u8
    *((roh + 1) as *mut u8) = (0x80 as u32 | ((cp >> 12) & 0x3F as u32)) as u8
    *((roh + 2) as *mut u8) = (0x80 as u32 | ((cp >> 6) & 0x3F as u32)) as u8
    *((roh + 3) as *mut u8) = (0x80 as u32 | (cp & 0x3F as u32)) as u8
    return 4
}

// ------------------------------------------------------- Inhalt setzen
// Den ganzen Text ersetzen; Zeiger und Anker stehen danach am Ende.
#[no_gc]
fn tb_set_text(t: *mut TextBuf, p: u64, n0: usize) {
    var n: usize = n0
    if n > (*t).cap {
        n = (*t).cap
    }
    var i: usize = 0
    while i < n {
        *(((*t).p + i as u64) as *mut u8) = *((p + i as u64) as *mut u8)
        i = i + 1
    }
    (*t).n = n
    (*t).caret = n
    (*t).anchor = n
    (*t).comp_a = 0
    (*t).comp_b = 0
}

#[no_gc]
fn tb_clear(t: *mut TextBuf) {
    (*t).n = 0
    (*t).caret = 0
    (*t).anchor = 0
    (*t).comp_a = 0
    (*t).comp_b = 0
}

// Jemand hat DIREKT in den Puffer geschrieben (die Eingabemethode tut
// das) und meldet die neue Laenge. Zeiger, Anker und Schwebendes werden
// in den Puffer geklemmt; wo der Zeiger hin soll, sagt der Aufrufer
// danach mit `tb_set_range`.
#[no_gc]
fn tb_set_len(t: *mut TextBuf, n0: usize) {
    var n: usize = n0
    if n > (*t).cap {
        n = (*t).cap
    }
    (*t).n = n
    (*t).caret = clamp(t, (*t).caret)
    (*t).anchor = clamp(t, (*t).anchor)
    (*t).comp_a = clamp(t, (*t).comp_a)
    (*t).comp_b = clamp(t, (*t).comp_b)
    if (*t).comp_b < (*t).comp_a {
        (*t).comp_b = (*t).comp_a
    }
}

// ------------------------------------------------------- Markierung
#[no_gc]
fn tb_select_all(t: *mut TextBuf) {
    (*t).anchor = 0
    (*t).caret = (*t).n
}

// Zeiger UND Anker setzen (Oktett). Beide werden auf Grenzen geklemmt.
#[no_gc]
fn tb_set_range(t: *mut TextBuf, caret: usize, anchor: usize) {
    (*t).caret = clamp(t, caret)
    (*t).anchor = clamp(t, anchor)
}

// Nur den Zeiger; `extend` = die Markierung vom Anker align erweitern
// (Umschalttaste), sonst Anker mitnehmen.
#[no_gc]
fn tb_set_caret(t: *mut TextBuf, caret: usize, extend: bool) {
    (*t).caret = clamp(t, caret)
    if !extend {
        (*t).anchor = (*t).caret
    }
}

#[no_gc]
fn tb_clear_sel(t: *mut TextBuf) {
    (*t).anchor = (*t).caret
}

// --------------------------------------------------- Einfuegen/Loeschen
// [a, b) durch `n` Oktett ab `p` ersetzen. Zeiger und Anker stehen
// danach hinter dem Eingefuegten. Rueckgabe: falsch, wenn es nicht
// passt -- dann ist NICHTS geaendert.
#[no_gc]
fn tb_replace(t: *mut TextBuf, a0: usize, b0: usize, p: u64,
    n: usize) -> bool {
    var a: usize = clamp(t, a0)
    var b: usize = clamp(t, b0)
    if b < a {
        let x: usize = a
        a = b
        b = x
    }
    let alt: usize = (*t).n
    let weg: usize = b - a
    if alt - weg + n > (*t).cap {
        return false
    }
    // Den Rest hinter `b` verschieben. Beide Richtungen sind moeglich,
    // also die sichere: nach hinten von hinten, nach vorn von vorn.
    if n > weg {
        let d: usize = n - weg
        var i: usize = alt
        while i > b {
            *(((*t).p + (i - 1 + d) as u64) as *mut u8) =
                *(((*t).p + (i - 1) as u64) as *mut u8)
            i = i - 1
        }
    } else if n < weg {
        let d: usize = weg - n
        var i: usize = b
        while i < alt {
            *(((*t).p + (i - d) as u64) as *mut u8) =
                *(((*t).p + i as u64) as *mut u8)
            i = i + 1
        }
    }
    var j: usize = 0
    while j < n {
        *(((*t).p + (a + j) as u64) as *mut u8) = *((p + j as u64) as *mut u8)
        j = j + 1
    }
    (*t).n = alt - weg + n
    (*t).caret = a + n
    (*t).anchor = a + n
    // Schwebendes, das den Bereich beruehrt, ist damit vorbei; was
    // dahinter liegt, rueckt mit.
    if (*t).comp_b > a && (*t).comp_a <= b {
        (*t).comp_a = 0
        (*t).comp_b = 0
    } else if (*t).comp_a > b {
        (*t).comp_a = (*t).comp_a + n - weg
        (*t).comp_b = (*t).comp_b + n - weg
    }
    return true
}

// Text an der Theme einfuegen. Ist etwas markiert, wird es ERSETZT --
// so tut es jedes TextBuf, und so hat es MOBIL8 fuer die Adresszeile
// verlangt.
#[no_gc]
fn tb_insert(t: *mut TextBuf, p: u64, n: usize) -> bool {
    return tb_replace(t, tb_sel_a(t), tb_sel_b(t), p, n)
}

#[no_gc]
fn tb_insert_cp(t: *mut TextBuf, cp: u32) -> bool {
    if cp == 0 as u32 {
        return false
    }
    var roh: [u8; 4] = [0; 4]
    let k: usize = tb_cp_encode(cp, (&roh[0]) as u64)
    return tb_insert(t, (&roh[0]) as u64, k)
}

#[no_gc]
fn tb_delete(t: *mut TextBuf, a: usize, b: usize) -> bool {
    return tb_replace(t, a, b, 0, 0)
}

// Ruecktaste: Markierung weg, sonst das Zeichen VOR dem Zeiger.
#[no_gc]
fn tb_backspace(t: *mut TextBuf) -> bool {
    if tb_has_sel(t) {
        return tb_delete(t, tb_sel_a(t), tb_sel_b(t))
    }
    if (*t).caret == 0 {
        return false
    }
    let a: usize = tb_prev(t, (*t).caret)
    return tb_delete(t, a, (*t).caret)
}

// Entf: Markierung weg, sonst das Zeichen HINTER dem Zeiger.
#[no_gc]
fn tb_delete_fwd(t: *mut TextBuf) -> bool {
    if tb_has_sel(t) {
        return tb_delete(t, tb_sel_a(t), tb_sel_b(t))
    }
    if (*t).caret >= (*t).n {
        return false
    }
    let b: usize = tb_next(t, (*t).caret)
    return tb_delete(t, (*t).caret, b)
}

#[no_gc]
fn tb_delete_sel(t: *mut TextBuf) -> bool {
    if !tb_has_sel(t) {
        return false
    }
    return tb_delete(t, tb_sel_a(t), tb_sel_b(t))
}

// ------------------------------------------------------- Pfeiltasten
// Ohne `extend` und mit Markierung: der Zeiger springt an deren Rand
// (left: Anfang, right: Ende) -- so machen es alle Textfelder.
#[no_gc]
fn tb_left(t: *mut TextBuf, extend: bool) {
    if !extend && tb_has_sel(t) {
        let a: usize = tb_sel_a(t)
        (*t).caret = a
        (*t).anchor = a
        return
    }
    tb_set_caret(t, tb_prev(t, (*t).caret), extend)
}

#[no_gc]
fn tb_right(t: *mut TextBuf, extend: bool) {
    if !extend && tb_has_sel(t) {
        let b: usize = tb_sel_b(t)
        (*t).caret = b
        (*t).anchor = b
        return
    }
    tb_set_caret(t, tb_next(t, (*t).caret), extend)
}

#[no_gc]
fn tb_home(t: *mut TextBuf, extend: bool) {
    tb_set_caret(t, 0, extend)
}

#[no_gc]
fn tb_end(t: *mut TextBuf, extend: bool) {
    tb_set_caret(t, (*t).n, extend)
}

// ------------------------------------------------------------- Woerter
// Was in einer Adresszeile ein Wort ist: Buchstaben, Ziffern, `_`, `-`
// und alles ab 0x80 (fremde Schriften). Trenner sind `/ . : ? = & # @`
// und Leerraum -- ein Langdruck auf "wikipedia" in
// `de.wikipedia.org/wiki/Tirol` soll "wikipedia" greifen, nicht die
// ganze Zeile.
#[no_gc]
fn tb_is_word_byte(b: u8) -> bool {
    if b >= 0x80 as u8 {
        return true
    }
    if b >= 48 as u8 && b <= 57 as u8 {
        return true
    }
    if b >= 65 as u8 && b <= 90 as u8 {
        return true
    }
    if b >= 97 as u8 && b <= 122 as u8 {
        return true
    }
    return b == 95 as u8 || b == 45 as u8
}

// Das Wort um Oktett `pos`: [*a, *b). Steht `pos` auf einem Trenner,
// wird das Zeichen selbst gegriffen.
#[no_gc]
fn tb_word_at(t: *mut TextBuf, pos0: usize, a: *mut usize, b: *mut usize) {
    let n: usize = (*t).n
    if n == 0 {
        *a = 0
        *b = 0
        return
    }
    var pos: usize = clamp(t, pos0)
    if pos >= n {
        pos = tb_prev(t, n)
    }
    if !tb_is_word_byte(byte_of(t, pos)) {
        // vielleicht steht der Zeiger genau HINTER einem Wort
        if pos > 0 && tb_is_word_byte(byte_of(t, pos - 1)) {
            pos = pos - 1
        } else {
            *a = pos
            *b = tb_next(t, pos)
            return
        }
    }
    var x: usize = pos
    while x > 0 && tb_is_word_byte(byte_of(t, x - 1)) {
        x = x - 1
    }
    var y: usize = pos
    while y < n && tb_is_word_byte(byte_of(t, y)) {
        y = y + 1
    }
    *a = x
    *b = y
}

#[no_gc]
fn tb_select_word(t: *mut TextBuf, pos: usize) {
    var a: usize = 0
    var b: usize = 0
    tb_word_at(t, pos, &a, &b)
    (*t).anchor = a
    (*t).caret = b
}

// ---------------------------------------------------- Zwischenablage
// Die Markierung nach `ziel` kopieren (hoechstens `cap`). Rueckgabe:
// Laenge; 0 wenn nichts markiert ist oder das Feld secret ist.
#[no_gc]
fn tb_copy(t: *mut TextBuf, dst: u64, cap: usize) -> usize {
    if (*t).secret != 0 || !tb_has_sel(t) {
        return 0
    }
    let a: usize = tb_sel_a(t)
    var k: usize = tb_sel_b(t) - a
    if k > cap {
        k = cap
    }
    var i: usize = 0
    while i < k {
        *((dst + i as u64) as *mut u8) = byte_of(t, a + i)
        i = i + 1
    }
    return k
}

#[no_gc]
fn tb_cut(t: *mut TextBuf, dst: u64, cap: usize) -> usize {
    let k: usize = tb_copy(t, dst, cap)
    if k > 0 {
        let ok: bool = tb_delete_sel(t)
    }
    return k
}

// ------------------------------------------------------- Schwebendes
#[no_gc]
fn tb_comp_set(t: *mut TextBuf, a: usize, b: usize) {
    (*t).comp_a = clamp(t, a)
    (*t).comp_b = clamp(t, b)
    if (*t).comp_b < (*t).comp_a {
        let x: usize = (*t).comp_a
        (*t).comp_a = (*t).comp_b
        (*t).comp_b = x
    }
}

#[no_gc]
fn tb_comp_end(t: *mut TextBuf) {
    (*t).comp_a = 0
    (*t).comp_b = 0
}

// ----------------------------------------------------- Finger und Schrift
// Die Bildpunktstelle einer Grenze `i`, relativ zum Textanfang.
fn tb_x_of(t: *mut TextBuf, i0: usize, mess: fn(u64, u64, usize) -> f64,
    ctx: u64) -> f64 {
    let i: usize = clamp(t, i0)
    if i == 0 {
        return 0.0
    }
    return mess(ctx, (*t).p, i)
}

// Die Grenze, die einer Bildpunktstelle `x` (relativ zum Textanfang) am
// NAECHSTEN liegt -- nicht die letzte, die noch davor passt. Wer auf die
// rechte Haelfte eines Zeichens tippt, will dahinter stehen.
fn tb_caret_from_x(t: *mut TextBuf, x: f64,
    mess: fn(u64, u64, usize) -> f64, ctx: u64) -> usize {
    if x <= 0.0 || (*t).n == 0 {
        return 0
    }
    var best: usize = 0
    var bestd: f64 = x
    var i: usize = 1
    while i <= (*t).n {
        if tb_is_boundary(t, i) {
            let w: f64 = mess(ctx, (*t).p, i)
            var d: f64 = w - x
            if d < 0.0 {
                d = 0.0 - d
            }
            if d < bestd {
                bestd = d
                best = i
            }
            if w > x + bestd {
                break
            }
        }
        i = i + 1
    }
    return best
}

// ------------------------------------------------------------- UTF-16
// Wieviele UTF-16-Einheiten stehen VOR Oktett `i`? Ein Kodepunkt ab
// 0x10000 zaehlt zwei. Das ist die Waehrung, in der Android rechnet.
#[no_gc]
fn tb_u16_of(t: *mut TextBuf, i0: usize) -> usize {
    let i: usize = clamp(t, i0)
    var k: usize = 0
    var j: usize = 0
    var adv: usize = 0
    while j < i {
        let cp: u32 = tb_cp_at(t, j, &adv)
        if adv == 0 {
            break
        }
        if cp >= 0x10000 as u32 {
            k = k + 2
        } else {
            k = k + 1
        }
        j = j + adv
    }
    return k
}

#[no_gc]
fn tb_u16_len(t: *mut TextBuf) -> usize {
    return tb_u16_of(t, (*t).n)
}

// Der Oktettversatz der UTF-16-Einheit `e` (klemmt auf n). Faellt `e`
// in ein Ersatzpaar, gilt der Anfang des Zeichens.
#[no_gc]
fn tb_byte_from_u16(t: *mut TextBuf, e: usize) -> usize {
    var k: usize = 0
    var j: usize = 0
    var adv: usize = 0
    while j < (*t).n {
        if k >= e {
            return j
        }
        let cp: u32 = tb_cp_at(t, j, &adv)
        if adv == 0 {
            break
        }
        if cp >= 0x10000 as u32 {
            k = k + 2
        } else {
            k = k + 1
        }
        j = j + adv
    }
    return (*t).n
}
