// SPDX-License-Identifier: MPL-2.0
// lib/fui/cmdbar.fi -- THE COMMAND BAR (fUi gallery): icon buttons, groups, an overflow, tooltips.
//
// ========================================================= WHAT
//
// A row of commands (New folder, Cut, Copy, Paste, Rename, Delete, View, More) costs a row of its own
// when every command is a word. Here every command is an ICON button of one size on one centre line;
// the WORD lives in the tooltip and in the accessibility name ("Copy (Ctrl+C)"), so a person who needs it
// reads it and a person who knows the icon loses no height. When the row is too narrow the last commands
// move into an OVERFLOW menu behind a "..." button -- the first commands (the ones the caller put first,
// the important ones) stay.
//
// This file is the MODEL of that bar and only integers: how many items fit, where the groups part, what
// the tooltip says. A host (fUi's scene, OrientOS's fuiscene, a browser page) draws the buttons; the model
// is the same everywhere, so the same bar overflows at the same width on every host. It works in a
// kernel-profile program too.
//
// ========================================================= THE USE
//
//     // the caller keeps three arrays of n entries: width of each item, 1 when a group starts at it
//     let k: u64 = cmdbar.fit_count(n, seps_ptr, avail, ITEM_W, GAP, SEP_W)   // items that stay visible
//     if k < n { /* items k..n-1 go into the overflow menu; the bar reserves OVF_W for its button */ }
//     let len: u64 = cmdbar.tip_text("Copy", "Ctrl+C", out, cap)               // "Copy (Ctrl+C)"
//
// All widths are in the same unit (points or pixels), whatever the host uses.

export {
    fit_count, bar_width, tip_text, ITEM_W, GAP, SEP_W,
}

// The size of an icon button (a square) and the gap between two buttons, in points; the space a group
// separator takes. A host in pixels multiplies them by its scale.
const ITEM_W: u64 = 32
const GAP: u64 = 4
const SEP_W: u64 = 12

// The width of the first `k` items: `k` buttons, `k - 1` gaps, and a separator for every item among them
// (except the first) at which a group starts. `seps` points to `n` bytes (1 = a group starts here).
fn bar_width(k: u64, seps: u64, item: u64, gap: u64, sep: u64) -> u64 {
    if k == 0 {
        return 0
    }
    var w: u64 = k * item + (k - 1) * gap
    var i: u64 = 1
    while i < k {
        if *((seps + i) as *mut u8) != 0 as u8 {
            w = w + sep
        }
        i = i + 1
    }
    return w
}

// HOW MANY ITEMS STAY IN THE BAR. All `n` when they fit into `avail`; otherwise as many leading items as fit
// WITH ONE MORE BUTTON for the overflow (a gap and an item width) -- at least 0.
fn fit_count(n: u64, seps: u64, avail: u64, item: u64, gap: u64, sep: u64) -> u64 {
    if bar_width(n, seps, item, gap, sep) <= avail {
        return n
    }
    var k: u64 = n
    while k > 0 {
        k = k - 1
        if bar_width(k, seps, item, gap, sep) + gap + item <= avail {
            return k
        }
    }
    return 0
}

// THE TOOLTIP: "<label> (<shortcut>)", or only the label when there is no shortcut. NUL-terminated inside
// `cap`; the return value is the length. `label` / `shortcut` are NUL-terminated pointers (0 = none).
fn tip_text(label: u64, shortcut: u64, out: u64, cap: u64) -> u64 {
    if cap < 2 {
        return 0
    }
    var at: u64 = 0
    var i: u64 = 0
    if label != 0 {
        while *((label + i) as *mut u8) != 0 as u8 && at + 1 < cap {
            *((out + at) as *mut u8) = *((label + i) as *mut u8)
            at = at + 1
            i = i + 1
        }
    }
    if shortcut != 0 && *(shortcut as *mut u8) != 0 as u8 && at + 4 < cap {
        *((out + at) as *mut u8) = 32 as u8
        *((out + at + 1) as *mut u8) = 40 as u8
        at = at + 2
        i = 0
        while *((shortcut + i) as *mut u8) != 0 as u8 && at + 2 < cap {
            *((out + at) as *mut u8) = *((shortcut + i) as *mut u8)
            at = at + 1
            i = i + 1
        }
        *((out + at) as *mut u8) = 41 as u8
        at = at + 1
    }
    *((out + at) as *mut u8) = 0 as u8
    return at
}
