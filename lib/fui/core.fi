profile kernel
// SPDX-License-Identifier: GPL-2.0-only
// lib/fui/core.fi -- DER FREISTEHENDE KERN VON fUi.
//
// ================================================== WARUM ES IHN GIBT
//
// Justin, 10.09.2026: "warum machen wir nicht EINE Lib fuer alle
// Buttons, auch die die im Kernel laufen, nur dass diese Lib halt
// direkt im Kernel verwendet wird?"
//
// Der Einwand dagegen lautete: die Titelleiste gehoert dem
// Fensterserver, also malt der Fenstermanager IM KERN (kernel/wm.fi)
// seine Knoepfe selbst, und fUi koenne nur die Anwendungsknoepfe
// uebernehmen. Das ist genau die Teilung, an der die Zeichnung heute
// SCHON ZWEIMAL kaputtgegangen ist: erst ein zerfranstes Kreuz align
// einem Vektorrasterer, dann ein Kreuz, von dem nur noch eine Diagonale
// uebrig war.
//
// Diese Datei loest das auf. Sie traegt `profile kernel` in Zeile 1 und
// haelt sich an SPEC 2:
//
//   * KEINE Speicheranforderung. Jeder Puffer kommt vom Aufrufer.
//   * KEIN Systemruf, keine Laufzeit, kein `std.rt`, kein `std.io`.
//   * KEIN Gc, kein Rc, kein `throw`.
//   * KEIN Fliesskomma. Alles ganzzahlig -- siehe bottom.
//
// Damit bindet der Fenstermanager von OrientOS GENAU DIESE DATEI ein
// und malt dieselben Bildpunkte how jede Anwendung, weil es derselbe
// Quelltext ist. Auseinanderlaufen ist dann nicht mehr moeglich.
//
// ===================================================== OHNE FLIESSKOMMA
//
// SPEC 2 laesst Fliesskomma im Kernprofil nur mit `#[allow_fp]` zu, und
// zwar align einem echten Grund: der Zustand der Fliesskommaeinheit
// gehoert dem unterbrochenen Prozess. Ein Fenstermanager, der beim
// Zeichnen die FPU anfasst, muss sie sichern.
//
// Diese Datei rechnet darum GANZZAHLIG. Das ist keine Einschraenkung,
// sondern passt zur Sache: die Vorlage align OrientOS
// (/root/jarvis/downloads/button-vorlage/) setzt jeden Bildpunkt genau
// einmal, ohne Mischen. Die Kantenglaettung der runden Ecken laeuft
// ueber eine Deckungszahl 0..255 align ganzzahliger Flaechenrechnung.
//
// ============================================ DAS BILDPUNKTFORMAT
//
// BGRX, 32 Bit, how lib/fenster/fenster.fi es in F3 festlegt: B, G, R, X
// im Speicher. Eine Farbe kommt als 0xRRGGBB herein; `put` legt sie
// richtig ab. Damit malt der Kern in denselben Puffer, den die
// Fensterschicht ohnehin herumreicht.
//
// ==================================================== WAS HIER NICHT IST
//
// K1 KEIN TEXT. Schriftrasterung braucht die Schriftdatei, einen
//    Kratzpuffer und Fliesskomma. Sie steht in lib/fui/painter.fi
//    (Profil `app`). Der Fenstermanager malt seine Titel mit seiner
//    eigenen Schrift -- das ist der eine Teil, der geteilt bleibt.
// K2 KEIN ZUSTAND. Kein `static mut`, nichts, was zwischen zwei
//    Aufrufen ueberlebt. Alles steht in den Argumenten.

export {
    Target, target_new,
    put, get, fill_all, fill_rect, border, line_h, line_v,
    round_fill, round_frame,
    cap_minimize, cap_maximize, cap_restore, cap_close,
    cap_surface,
    CAP_NORMAL, CAP_HOVER, CAP_ACTIVE,
    mix_channel, corner_coverage,
}

// Die drei Zustaende, die ein Knopf im Kern kennt. Fokus und Sperre
// sind Sachen der Schale -- ein Fensterknopf hat sie nicht.
const CAP_NORMAL: u32 = 0
const CAP_HOVER: u32 = 1
const CAP_ACTIVE: u32 = 2

// ==================================================== DAS ZIEL
//
// Ein Bildpunktpuffer, den der Aufrufer stellt. `stride` ist die Zahl
// der OKTETT je Zeile, nicht der Bildpunkte -- ein Fensterserver
// bekommt fast nie eine Zeile ohne Rand.
struct Target {
    p: u64,        // Anfang des Puffers
    w: usize,      // Breite in Bildpunkten
    h: usize,      // Hoehe in Bildpunkten
    stride: usize, // Oktett je Zeile
}

fn target_new(p: u64, w: usize, h: usize, stride: usize) -> Target {
    return Target { p: p, w: w, h: h, stride: stride }
}

// EINEN BILDPUNKT SETZEN. Ausserhalb wird NICHTS geschrieben -- das ist
// die einzige Sicherung, die eine Zeichenroutine im Kern braucht, und
// sie steht an genau einer Stelle.
fn put(z: *mut Target, x: usize, y: usize, color: u32) {
    if x >= (*z).w || y >= (*z).h {
        return
    }
    let off: u64 = (y * (*z).stride + x * 4) as u64
    // BGRX: Blau zuerst.
    *(((*z).p + off) as *mut u8) = (color & 255 as u32) as u8
    *(((*z).p + off + 1 as u64) as *mut u8) =
        ((color >> 8) & 255 as u32) as u8
    *(((*z).p + off + 2 as u64) as *mut u8) =
        ((color >> 16) & 255 as u32) as u8
    *(((*z).p + off + 3 as u64) as *mut u8) = 0 as u8
}

fn get(z: *mut Target, x: usize, y: usize) -> u32 {
    if x >= (*z).w || y >= (*z).h {
        return 0 as u32
    }
    let off: u64 = (y * (*z).stride + x * 4) as u64
    let b: u32 = (*(((*z).p + off) as *mut u8)) as u32
    let g: u32 = (*(((*z).p + off + 1 as u64) as *mut u8)) as u32
    let r: u32 = (*(((*z).p + off + 2 as u64) as *mut u8)) as u32
    return (r << 16) | (g << 8) | b
}

// Zwei Colors nach Deckung 0..255 mischen. Ganzzahlig, kanalweise.
// Das ist die ganze Kantenglaettung dieser Datei.
fn mix_channel(bottom: u32, top: u32, a: usize) -> u32 {
    if a >= 255 {
        return top
    }
    if a == 0 {
        return bottom
    }
    var out: u32 = 0
    var s: u32 = 16
    while true {
        let cu: usize = ((bottom >> s) & 255 as u32) as usize
        let co: usize = ((top >> s) & 255 as u32) as usize
        let v: usize = (cu * (255 - a) + co * a + 127) / 255
        out = out | ((v as u32) << s)
        if s == 0 as u32 {
            break
        }
        s = s - 8 as u32
    }
    return out
}

// ================================================= DIE FLAECHEN

fn fill_all(z: *mut Target, color: u32) {
    fill_rect(z, 0, 0, (*z).w, (*z).h, color)
}

fn fill_rect(z: *mut Target, x: usize, y: usize, w: usize, h: usize,
    color: u32) {
    var yy: usize = 0
    while yy < h {
        var xx: usize = 0
        while xx < w {
            put(z, x + xx, y + yy, color)
            xx = xx + 1
        }
        yy = yy + 1
    }
}

// Ein UMRISS, `st` Bildpunkte stark. Das Maximieren-Zeichen ist genau
// das.
fn border(z: *mut Target, x: usize, y: usize, w: usize, h: usize,
    st: usize, color: u32) {
    if w == 0 || h == 0 || st == 0 {
        return
    }
    var s: usize = st
    if 2 * s > w || 2 * s > h {
        s = 1
    }
    fill_rect(z, x, y, w, s, color)
    fill_rect(z, x, y + h - s, w, s, color)
    fill_rect(z, x, y + s, s, h - 2 * s, color)
    fill_rect(z, x + w - s, y + s, s, h - 2 * s, color)
}

fn line_h(z: *mut Target, x: usize, y: usize, len: usize, st: usize,
    color: u32) {
    fill_rect(z, x, y, len, st, color)
}

fn line_v(z: *mut Target, x: usize, y: usize, len: usize, st: usize,
    color: u32) {
    fill_rect(z, x, y, st, len, color)
}

// ============================================== DIE RUNDEN ECKEN
//
// Die Deckung eines Bildpunktes an einer Ecke mit Radius `r`, als Zahl
// 0..255. GANZZAHLIG und ohne Wurzel: geprueft wird mit 4x4 Proben je
// Bildpunkt, ob die Probe im Kreis liegt (dx*dx + dy*dy <= r*r). 16
// Proben ergeben 17 Stufen, und der Unterschied zu einer exakten
// Flaechenrechnung liegt unter einer Helligkeitsstufe von 255.
//
// `cx`/`cy` ist der Mittelpunkt des Eckkreises, `px`/`py` der
// Bildpunkt. Alles in Bildpunkten, alles `usize`.
fn corner_coverage(px: usize, py: usize, cx: usize, cy: usize,
    r: usize) -> usize {
    if r == 0 {
        return 255
    }
    let rr: usize = r * r
    var drin: usize = 0
    // Vier mal vier Proben, jeweils in der Mitte ihres Viertels:
    // Versatz 1/8, 3/8, 5/8, 7/8. Mal 8 gerechnet, damit es ganzzahlig
    // bleibt.
    var iy: usize = 0
    while iy < 4 {
        var ix: usize = 0
        while ix < 4 {
            // Stelle der Probe, in Achteln
            let sx8: usize = px * 8 + 1 + ix * 2
            let sy8: usize = py * 8 + 1 + iy * 2
            let cx8: usize = cx * 8
            let cy8: usize = cy * 8
            var dx: usize = 0
            if sx8 > cx8 {
                dx = sx8 - cx8
            } else {
                dx = cx8 - sx8
            }
            var dy: usize = 0
            if sy8 > cy8 {
                dy = sy8 - cy8
            } else {
                dy = cy8 - sy8
            }
            // Vergleich in Achteln: (dx/8)^2 + (dy/8)^2 <= r^2
            if dx * dx + dy * dy <= rr * 64 {
                drin = drin + 1
            }
            ix = ix + 1
        }
        iy = iy + 1
    }
    return drin * 255 / 16
}

// EIN RECHTECK MIT RUNDEN ECKEN, kantengeglaettet, ganzzahlig.
//
// Der Radius wird auf die halbe kuerzere Seite geklemmt. Das ist NICHT
// Vorsicht auf Verdacht: in `u64` ist `w - 2*border_w` bei einem Knopf, der
// schmaler als zwei Raender ist, eine Zahl nahe 2^64 -- genau daran ist
// Justins Startmenue in OrientOS gestorben (kernel/user/wlib.fi, Runde
// ECHTHARDWARE-1, "panic: integer overflow in 'u64 - u64'").
fn round_fill(z: *mut Target, x: usize, y: usize, w: usize, h: usize,
    r0: usize, color: u32) {
    if w == 0 || h == 0 {
        return
    }
    var r: usize = r0
    var m: usize = w
    if h < m {
        m = h
    }
    if r > m / 2 {
        r = m / 2
    }
    if r == 0 {
        fill_rect(z, x, y, w, h, color)
        return
    }
    // Der Mittelteil und die zwei Balken -- ohne Ecken.
    fill_rect(z, x + r, y, w - 2 * r, h, color)
    fill_rect(z, x, y + r, r, h - 2 * r, color)
    fill_rect(z, x + w - r, y + r, r, h - 2 * r, color)
    // Die vier Ecken, Bildpunkt fuer Bildpunkt mit Deckung.
    var iy: usize = 0
    while iy < r {
        var ix: usize = 0
        while ix < r {
            // left top: Mittelpunkt (r, r) im Eckquadrat
            let a: usize = corner_coverage(ix, iy, r, r, r)
            if a > 0 {
                blend_px(z, x + ix, y + iy, color, a)
                blend_px(z, x + w - 1 - ix, y + iy, color, a)
                blend_px(z, x + ix, y + h - 1 - iy, color, a)
                blend_px(z, x + w - 1 - ix, y + h - 1 - iy, color, a)
            }
            ix = ix + 1
        }
        iy = iy + 1
    }
}

// Einen Bildpunkt mit Deckung auf das legen, was schon da steht.
fn blend_px(z: *mut Target, x: usize, y: usize, color: u32, a: usize) {
    if a >= 255 {
        put(z, x, y, color)
        return
    }
    if a == 0 {
        return
    }
    let bottom: u32 = get(z, x, y)
    put(z, x, y, mix_channel(bottom, color, a))
}

// Der Umriss eines runden Rechtecks -- der Fokusring der Schale und der
// Rahmen eines Fensters.
fn round_frame(z: *mut Target, x: usize, y: usize, w: usize, h: usize,
    r: usize, st: usize, color: u32) {
    if st == 0 || w == 0 || h == 0 {
        return
    }
    // Die ehrliche Bauart im Kern ohne Zwischenpuffer: `st` Ringe, von
    // aussen nach inner, jeder ein runder Umriss align vier Balken und
    // vier Eckboegen. Bei st = 1..3 (mehr ist kein Rahmen) ist das
    // billiger als ein zweiter Puffer.
    var i: usize = 0
    while i < st {
        if 2 * i >= w || 2 * i >= h {
            break
        }
        var ri: usize = 0
        if r > i {
            ri = r - i
        }
        ring_one(z, x + i, y + i, w - 2 * i, h - 2 * i, ri, color)
        i = i + 1
    }
}

// EIN Bildpunkt Umriss.
fn ring_one(z: *mut Target, x: usize, y: usize, w: usize, h: usize,
    r0: usize, color: u32) {
    var r: usize = r0
    var m: usize = w
    if h < m {
        m = h
    }
    if r > m / 2 {
        r = m / 2
    }
    // die vier geraden Stuecke
    fill_rect(z, x + r, y, w - 2 * r, 1, color)
    fill_rect(z, x + r, y + h - 1, w - 2 * r, 1, color)
    fill_rect(z, x, y + r, 1, h - 2 * r, color)
    fill_rect(z, x + w - 1, y + r, 1, h - 2 * r, color)
    if r == 0 {
        return
    }
    // die vier Boegen: der Bildpunkt, dessen Deckung von inner nach
    // aussen kippt
    var iy: usize = 0
    while iy < r {
        var ix: usize = 0
        while ix < r {
            let a: usize = corner_coverage(ix, iy, r, r, r)
            let b: usize = corner_coverage(ix, iy, r, r, r - 1)
            if a > b {
                let d: usize = a - b
                blend_px(z, x + ix, y + iy, color, d)
                blend_px(z, x + w - 1 - ix, y + iy, color, d)
                blend_px(z, x + ix, y + h - 1 - iy, color, d)
                blend_px(z, x + w - 1 - ix, y + h - 1 - iy, color, d)
            }
            ix = ix + 1
        }
        iy = iy + 1
    }
}

// ======================================================================
// DIE VIER FENSTERZEICHEN
// ======================================================================
//
// Vorlage: /root/jarvis/downloads/button-vorlage/KNOPF-VORLAGE.md, align
// kernel/wm.fi `cap_glyph` im Stand bee3999. Justin nennt diese drei
// Knoepfe die einzige Sache im System, die perfekt ist.
//
// UEBERNOMMEN IST DIE FORM, NICHT DIE GROESSE. Die Urfassung ist auf
// 10 x 10 Bildpunkte festgenagelt; auf Justins Schirm (3440x1440,
// Vervielfachung 2) ist der Knopf 60 breit und das Zeichen weiterhin 10
// -- daher sein Befund "-- [] /". JEDE Laenge hier haengt an `d` und
// `sb`, und der Aufrufer gibt `d = 10 * scale`, `sb = 1 * scale`.
//
// `x`/`y` ist die linke obere Ecke des Zeichenfeldes, `d` seine
// Kantenlaenge.

// Minimieren: ein waagerechter Strich auf halber Hoehe.
fn cap_minimize(z: *mut Target, x: usize, y: usize, d: usize,
    sb: usize, color: u32) {
    if d == 0 || sb == 0 {
        return
    }
    // Vorlage: von (0, d/2) nach (d-1, d/2), Dicke sb. Bei sb > 1 wird
    // der Strich um die Mittellinie herum aufgetragen, sonst wandert er
    // beim Skalieren nach bottom.
    var oy: usize = d / 2
    if sb > 1 {
        if oy >= sb / 2 {
            oy = oy - sb / 2
        } else {
            oy = 0
        }
    }
    line_h(z, x, y + oy, d, sb, color)
}

// Maximieren: ein leeres Quadrat.
fn cap_maximize(z: *mut Target, x: usize, y: usize, d: usize,
    sb: usize, color: u32) {
    if d == 0 || sb == 0 {
        return
    }
    border(z, x, y, d, d, sb, color)
}

// Wiederherstellen: zwei versetzte Quadrate. Der Versatz ist 2 bei
// Skala 1, also `2 * sb` -- in der Vorlage steht "bei Skala ist der
// Versatz 2 * scale", und `sb` IST die Skala (Strichbreite 1 * scale).
fn cap_restore(z: *mut Target, x: usize, y: usize, d: usize,
    sb: usize, color: u32) {
    if d == 0 || sb == 0 {
        return
    }
    let v: usize = 2 * sb
    if d <= v {
        border(z, x, y, d, d, sb, color)
        return
    }
    let k: usize = d - v
    // A: um `v` nach right, top
    border(z, x + v, y, k, k, sb, color)
    // B: um `v` nach bottom, left
    border(z, x, y + v, k, k, sb, color)
}

// ======================================================================
// SCHLIESSEN -- DAS KREUZ, UND WARUM ES SO UND NICHT ANDERS GEMALT WIRD
// ======================================================================
//
// ZWEI FEHLER SIND HIER SCHON TEUER BEZAHLT WORDEN, beide stehen in der
// Vorlage:
//
// 1. EIN VEKTORRASTERER MIT EINEM GEMEINSAMEN PFAD IST FALSCH. Legt man
//    die zwei Diagonalen als zwei Strichumrisse in EINEN Pfad und
//    fuellt nach der Nichtnull-Regel, addieren sich an der Kreuzung die
//    Umlaufzahlen und es entsteht ein fetter Zusatzbalken. Gemessen:
//    4 doppelt gedeckte Bildpunkte bei Skala 1, 12 bei 2, 24 bei 3 --
//    es wird mit der Skalierung SCHLIMMER. Darum wird hier Punkt fuer
//    Punkt set_mask, jeder genau einmal, ohne Mischen. Ausfransen ist
//    damit unmoeglich.
//
// 2. NAIV NACH RECHTS VERBREITERN LAEUFT AUS DEM FELD. In der ersten
//    und letzten Zeile fehlt dann right ein Punkt und das Kreuz wird
//    21 Spalten breit in einem 20er-Feld. Richtig ist die Rechnung align
//    der Vorlage: `kn = d - (sb - 1)` Schritte, mittig set_mask mit
//    `off = (d - (kn + sb - 1)) / 2`, und die zweite Diagonale waechst
//    nach LINKS statt nach right.
//
// Gemessen bei d = 20: sb=1 -> 20x20, sb=2 -> 20x19, sb=3 -> 20x18,
// in allen Faellen 0 Punkte ausserhalb und in beiden Achsen
// spiegelgleich.
fn cap_close(z: *mut Target, x: usize, y: usize, d: usize,
    sb: usize, color: u32) {
    if d == 0 || sb == 0 {
        return
    }
    if sb > d {
        return
    }
    let kn: usize = d - (sb - 1)
    // ==================================================================
    // EIN DRITTER FEHLER, VON DIESER RUNDE GEFUNDEN UND GEMESSEN
    // ==================================================================
    //
    // Die Vorlage nennt EINEN Versatz: `off = (d - (kn + sb - 1)) / 2`.
    // Der ist waagerecht richtig und vertical FALSCH, denn die zwei
    // Ausdehnungen sind nicht gleich:
    //
    //     belegte BREITE = kn + sb - 1   (k laeuft, und t geht nach
    //                                     right -- beides addiert sich)
    //     belegte HOEHE  = kn            (nur k laeuft; t bewegt sich
    //                                     waagerecht, nicht vertical)
    //
    // Bei sb = 1 sind beide gleich, darum faellt es in der Urfassung
    // NIE auf. Ab sb = 2 ist die Hoehe um (sb - 1) kleiner, das Kreuz
    // klebt top und laesst bottom eine Zeile frei.
    //
    // GEMESSEN mit tools/fui/kreuz_main.fi vor der Berichtigung:
    //     d=20 sb=2  vertical ungleich: 76 Bildpunkte
    //     d=30 sb=3  vertical ungleich: 216 Bildpunkte
    // Waagerecht war es in beiden Faellen sauber -- genau das Muster,
    // das eine nur waagerecht gedachte Rechnung hinterlaesst.
    //
    // Auf Justins Schirm ist sb = 2. Das Kreuz saesse also um einen
    // halben Bildpunkt zu hoch im Knopf -- visible neben dem Quadrat
    // des Maximieren-Knopfes, das mittig sitzt.
    let breit: usize = kn + sb - 1
    let up: usize = kn
    var ox: usize = 0
    if d > breit {
        ox = (d - breit) / 2
    }
    var oy: usize = 0
    if d > up {
        oy = (d - up) / 2
    }
    var k: usize = 0
    while k < kn {
        var t: usize = 0
        while t < sb {
            // Diagonale 1: waechst nach RECHTS
            put(z, x + ox + k + t, y + oy + k, color)
            // Diagonale 2: waechst nach LINKS
            put(z, x + ox + kn - 1 - k + t, y + oy + k, color)
            t = t + 1
        }
        k = k + 1
    }
}

// ======================================================================
// DIE KNOPFFLAECHE
// ======================================================================
//
// Die drei Zustaende. Der Fenstermanager ruft das mit seinen Colors,
// eine Anwendung mit denen align lib/fui/theme.fi -- dieselbe Zeichnung,
// zwei Farbquellen.
fn cap_surface(z: *mut Target, x: usize, y: usize, w: usize, h: usize,
    r: usize, state: u32, f_normal: u32, f_hover: u32,
    f_active: u32) {
    var f: u32 = f_normal
    if state == CAP_HOVER {
        f = f_hover
    } else if state == CAP_ACTIVE {
        f = f_active
    }
    round_fill(z, x, y, w, h, r, f)
}
