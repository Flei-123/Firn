import std.rt
import fui.painter
import fui.kitmd_types

export { hmix, hash_new, run_of, font_enter, font_leave, word_w, space_w, fit_bytes, cache_clear, cache_stat }

const WC_N: usize = 8192
static mut WC_KEY: [u64; 8192] = [0; 8192]
static mut WC_VAL: [f64; 8192] = [0.0; 8192]
static mut WC_HITS: i64 = 0
static mut WC_MISSES: i64 = 0

fn hash_new() -> u64 {
    return (7 as u64 << 32) | (11 as u64)
}

fn hmix(k: u64, v: u64) -> u64 {
    let w: u64 = v % 1000000007
    let a: u64 = ((k >> 32) * 131 + w + 1) % 1000000007
    let b: u64 = ((k & 4294967295) * 257 + w + 3) % 998244353
    return (a << 32) | b
}

fn run_of(flags: u32, size: f64) -> painter.TextRun {
    var r: painter.TextRun = painter.run_new(size)
    if flags & kitmd_types.F_BOLD != 0 as u32 {
        r = painter.run_set_weight(r, 700)
    }
    if flags & kitmd_types.F_ITALIC != 0 as u32 {
        r = painter.run_set_slant(r, 1)
    }
    return r
}

fn font_enter(z: *mut painter.Painter, flags: u32) -> u64 {
    if flags & kitmd_types.F_CODE != 0 as u32 {
        let f: u64 = painter.painter_font_slot(z, 1)
        if f != 0 {
            let old: u64 = painter.painter_font(z)
            painter.painter_set_font(z, f)
            return old
        }
    }
    return 0
}

fn font_leave(z: *mut painter.Painter, old: u64) {
    if old != 0 {
        painter.painter_set_font(z, old)
    }
}

fn cache_clear() {
    var i: usize = 0
    while i < WC_N {
        WC_KEY[i] = 0
        i = i + 1
    }
}

fn cache_stat(k: usize) -> i64 {
    if k == 0 { return WC_HITS }
    return WC_MISSES
}

fn word_w(z: *mut painter.Painter, flags: u32, size: f64, p: u64, n: usize) -> f64 {
    let old: u64 = font_enter(z, flags)
    let face: u64 = painter.painter_font(z)
    var h: u64 = hash_new()
    h = hmix(h, flags as u64)
    h = hmix(h, (size * 64.0) as u64)
    h = hmix(h, face)
    var i: usize = 0
    while i < n {
        h = hmix(h, rt.ld8(p, i) as u64)
        i = i + 1
    }
    let key: u64 = h | 1
    let slot: usize = ((h >> 9) % 8192) as usize
    if WC_KEY[slot] == key {
        WC_HITS = WC_HITS + 1
        font_leave(z, old)
        return WC_VAL[slot]
    }
    var r: painter.TextRun = run_of(flags, size)
    let w: f64 = painter.run_width(z, &r, p, n)
    font_leave(z, old)
    WC_MISSES = WC_MISSES + 1
    WC_KEY[slot] = key
    WC_VAL[slot] = w
    return w
}

fn space_w(z: *mut painter.Painter, flags: u32, size: f64) -> f64 {
    var sp: [u8; 1] = [32 as u8]
    return word_w(z, flags, size, (&sp[0]) as u64, 1)
}

fn fit_bytes(z: *mut painter.Painter, flags: u32, size: f64, p: u64, n: usize, room: f64) -> usize {
    let old: u64 = font_enter(z, flags)
    var r: painter.TextRun = run_of(flags, size)
    var k: usize = painter.run_fits_upto(z, &r, p, n, room)
    font_leave(z, old)
    if k == 0 {
        k = 1
        while k < n && (rt.ld8(p, k) & 192 as u8) == 128 as u8 {
            k = k + 1
        }
    }
    return k
}
