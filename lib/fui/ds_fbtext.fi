import std.rt
import fui.kit
import fui.painter
import fui.render

export { lines, draw, inside, join2, cat, run_of }

fn run_of(size: f64, weight: usize) -> painter.TextRun {
    var r: painter.TextRun = painter.run_new(size)
    if weight > 400 { r = painter.run_set_weight(r, weight) }
    return r
}

fn lines(c: *mut render.Ctx, s: str, w: f64, size_pt: usize, weight: usize, max_lines: usize) -> usize {
    if s.n == 0 || w <= 0.0 { return 0 }
    var r: painter.TextRun = run_of(render.tsz(c, kit.ln(c, size_pt)), weight)
    return painter.run_line_count(render.ctx_painter(c), &r, s.p as u64, s.n, w, max_lines)
}

fn draw(c: *mut render.Ctx, x: f64, y: f64, w: f64, s: str, size_pt: usize, weight: usize, col: u32, max_lines: usize) -> usize {
    if s.n == 0 || w <= 0.0 { return 0 }
    let z: *mut painter.Painter = render.ctx_painter(c)
    let tsize: f64 = render.tsz(c, kit.ln(c, size_pt))
    var r: painter.TextRun = run_of(tsize, weight)
    let lh: f64 = kit.ln(c, 20)
    let by: f64 = painter.text_baseline_mid(z, y, lh, tsize)
    var al: u32 = painter.TEXT_L
    if kit.kit_rtl() { al = painter.TEXT_R }
    return painter.run_draw_wrapped(z, &r, x, by, w, lh, col, s.p as u64, s.n, al, max_lines)
}

fn inside(q: *mut [f64; 4], x: f64, y: f64) -> bool {
    return x >= (*q)[0] && x < (*q)[0] + (*q)[2] && y >= (*q)[1] && y < (*q)[1] + (*q)[3]
}

fn cat(dst: *mut [u8; 256], at: usize, s: str) -> usize {
    var n: usize = at
    var i: usize = 0
    while i < s.n && n < 255 {
        (*dst)[n] = rt.ld8(s.p as u64, i)
        n = n + 1
        i = i + 1
    }
    return n
}

fn join2(dst: *mut [u8; 256], a: str, sep: str, b: str) -> usize {
    var n: usize = cat(dst, 0, a)
    if a.n > 0 && b.n > 0 { n = cat(dst, n, sep) }
    return cat(dst, n, b)
}
