// SPDX-License-Identifier: MPL-2.0
export {
    Transport, tr_new, tr_load, tr_fail, tr_clear, tr_play, tr_pause, tr_toggle, tr_seek, tr_skip, tr_take_seek,
    tr_tick, tr_scrub_begin, tr_scrub_to, tr_scrub_end, tr_display_ms, tr_set_volume, tr_volume_step,
    tr_toggle_mute, tr_eff_volume, tr_permille, tr_ms_at, tr_is_active,
    TS_EMPTY, TS_READY, TS_PLAYING, TS_PAUSED, TS_ENDED, TS_FAILED,
}

const TS_EMPTY: u32 = 0
const TS_READY: u32 = 1
const TS_PLAYING: u32 = 2
const TS_PAUSED: u32 = 3
const TS_ENDED: u32 = 4
const TS_FAILED: u32 = 5

struct Transport {
    state: u32,
    pos_ms: u64,
    dur_ms: u64,
    volume: u32,
    muted: bool,
    scrubbing: bool,
    scrub_ms: u64,
    resume: bool,
    seek_req: bool,
    seek_to: u64,
}

fn tr_new() -> Transport {
    return Transport { state: TS_EMPTY, pos_ms: 0 as u64, dur_ms: 0 as u64, volume: 100 as u32, muted: false,
        scrubbing: false, scrub_ms: 0 as u64, resume: false, seek_req: false, seek_to: 0 as u64 }
}

fn tr_clear(t: *mut Transport) {
    (*t).state = TS_EMPTY
    (*t).pos_ms = 0 as u64
    (*t).dur_ms = 0 as u64
    (*t).scrubbing = false
    (*t).scrub_ms = 0 as u64
    (*t).resume = false
    (*t).seek_req = false
    (*t).seek_to = 0 as u64
}

fn tr_load(t: *mut Transport, dur_ms: u64) {
    tr_clear(t)
    (*t).dur_ms = dur_ms
    (*t).state = TS_READY
}

fn tr_fail(t: *mut Transport) {
    tr_clear(t)
    (*t).state = TS_FAILED
}

fn tr_is_active(t: *mut Transport) -> bool {
    return (*t).state == TS_READY || (*t).state == TS_PLAYING || (*t).state == TS_PAUSED || (*t).state == TS_ENDED
}

fn clamp_ms(t: *mut Transport, ms: u64) -> u64 {
    if (*t).dur_ms > 0 as u64 && ms > (*t).dur_ms {
        return (*t).dur_ms
    }
    return ms
}

fn request_seek(t: *mut Transport, ms: u64) {
    (*t).seek_req = true
    (*t).seek_to = ms
    (*t).pos_ms = ms
}

fn tr_play(t: *mut Transport) -> bool {
    if (*t).state == TS_READY || (*t).state == TS_PAUSED {
        (*t).state = TS_PLAYING
        return true
    }
    if (*t).state == TS_ENDED {
        request_seek(t, 0 as u64)
        (*t).state = TS_PLAYING
        return true
    }
    return false
}

fn tr_pause(t: *mut Transport) -> bool {
    if (*t).state == TS_PLAYING {
        (*t).state = TS_PAUSED
        return true
    }
    return false
}

fn tr_toggle(t: *mut Transport) -> bool {
    if (*t).state == TS_PLAYING {
        return tr_pause(t)
    }
    return tr_play(t)
}

fn tr_seek(t: *mut Transport, ms: u64) -> bool {
    if !tr_is_active(t) {
        return false
    }
    let target: u64 = clamp_ms(t, ms)
    request_seek(t, target)
    let at_end: bool = (*t).dur_ms > 0 as u64 && target >= (*t).dur_ms
    if at_end && (*t).state == TS_PLAYING {
        (*t).state = TS_ENDED
    }
    if !at_end && (*t).state == TS_ENDED {
        (*t).state = TS_PLAYING
    }
    return true
}

fn tr_skip(t: *mut Transport, delta_ms: i64) -> bool {
    let cur: i64 = tr_display_ms(t) as i64
    var next: i64 = cur + delta_ms
    if next < 0 {
        next = 0
    }
    return tr_seek(t, next as u64)
}

fn tr_take_seek(t: *mut Transport, ms: *mut u64) -> bool {
    if !(*t).seek_req {
        return false
    }
    (*t).seek_req = false
    *ms = (*t).seek_to
    return true
}

fn tr_tick(t: *mut Transport, pos_ms: u64, finished: bool) -> bool {
    if (*t).state != TS_PLAYING {
        return false
    }
    (*t).pos_ms = clamp_ms(t, pos_ms)
    if finished {
        (*t).state = TS_ENDED
        if (*t).dur_ms > 0 as u64 {
            (*t).pos_ms = (*t).dur_ms
        }
    }
    return true
}

fn tr_permille(t: *mut Transport, ms: u64) -> i64 {
    if (*t).dur_ms == 0 as u64 {
        return 0
    }
    var v: u64 = ms
    if v > (*t).dur_ms {
        v = (*t).dur_ms
    }
    return (v * (1000 as u64) / (*t).dur_ms) as i64
}

fn tr_ms_at(t: *mut Transport, permille: i64) -> u64 {
    var pm: i64 = permille
    if pm < 0 {
        pm = 0
    }
    if pm > 1000 {
        pm = 1000
    }
    return (*t).dur_ms * (pm as u64) / (1000 as u64)
}

fn tr_display_ms(t: *mut Transport) -> u64 {
    if (*t).scrubbing {
        return (*t).scrub_ms
    }
    return (*t).pos_ms
}

fn tr_scrub_begin(t: *mut Transport, permille: i64) -> bool {
    if !tr_is_active(t) || (*t).dur_ms == 0 as u64 {
        return false
    }
    (*t).scrubbing = true
    (*t).resume = (*t).state == TS_PLAYING
    if (*t).resume {
        (*t).state = TS_PAUSED
    }
    (*t).scrub_ms = tr_ms_at(t, permille)
    return true
}

fn tr_scrub_to(t: *mut Transport, permille: i64) {
    if (*t).scrubbing {
        (*t).scrub_ms = tr_ms_at(t, permille)
    }
}

fn tr_scrub_end(t: *mut Transport) -> bool {
    if !(*t).scrubbing {
        return false
    }
    (*t).scrubbing = false
    let target: u64 = (*t).scrub_ms
    let resume: bool = (*t).resume
    (*t).resume = false
    request_seek(t, target)
    if resume {
        (*t).state = TS_PLAYING
        if (*t).dur_ms > 0 as u64 && target >= (*t).dur_ms {
            (*t).state = TS_ENDED
        }
    }
    return true
}

fn tr_set_volume(t: *mut Transport, percent: u32) {
    var v: u32 = percent
    if v > 100 as u32 {
        v = 100 as u32
    }
    (*t).volume = v
    if v > 0 as u32 {
        (*t).muted = false
    }
}

fn tr_volume_step(t: *mut Transport, delta: i64) {
    var v: i64 = (*t).volume as i64
    if (*t).muted {
        v = 0
    }
    v = v + delta
    if v < 0 {
        v = 0
    }
    if v > 100 {
        v = 100
    }
    tr_set_volume(t, v as u32)
}

fn tr_toggle_mute(t: *mut Transport) {
    if (*t).muted {
        (*t).muted = false
        if (*t).volume == 0 as u32 {
            (*t).volume = 50 as u32
        }
        return
    }
    (*t).muted = true
}

fn tr_eff_volume(t: *mut Transport) -> u32 {
    if (*t).muted {
        return 0 as u32
    }
    return (*t).volume
}
