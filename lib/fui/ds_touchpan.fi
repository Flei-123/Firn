// SPDX-License-Identifier: MPL-2.0
import fui.ds_navview
import fui.ds_scroller
import fui.ds_touchtrack
import fui.ds_vgrid
import fui.event
import fui.kit
import fui.render
import fui.screenanim
import plat.fuiwirt

export {
    Pan, pan_new, attach, region, forward_x, down, move, up, cancel, tick, moving, frame, record, pending, press_x, press_y,
    R_NAV, R_GRID, R_A, R_B, UP_NONE, UP_TAP, UP_PAN, UP_FWD, MV_NONE, MV_PAN, MV_FWD_START, MV_FWD,
}

const R_NAV: usize = 0
const R_GRID: usize = 1
const R_A: usize = 2
const R_B: usize = 3
const T_NONE: u32 = 0
const T_FWD: u32 = 5
const UP_NONE: u32 = 0
const UP_TAP: u32 = 1
const UP_PAN: u32 = 2
const UP_FWD: u32 = 3
const MV_NONE: u32 = 0
const MV_PAN: u32 = 1
const MV_FWD_START: u32 = 2
const MV_FWD: u32 = 3
const FLING_DP: usize = 160

struct Pan {
    track: ds_touchtrack.Track,
    target: u32,
    id: u32,
    fwd: bool,
    ptr: [u64; 4],
    rect: [f64; 16],
    on: [bool; 4],
}

fn pan_new() -> Pan {
    return Pan { track: ds_touchtrack.track_new(), target: T_NONE, id: 0 as u32, fwd: false, ptr: [0; 4], rect: [0.0; 16], on: [false; 4] }
}

fn attach(p: *mut Pan, slot: usize, target: u64) {
    (*p).ptr[slot] = target
}

fn region(p: *mut Pan, which: usize, x: f64, y: f64, w: f64, h: f64) {
    (*p).rect[which * 4] = x
    (*p).rect[which * 4 + 1] = y
    (*p).rect[which * 4 + 2] = w
    (*p).rect[which * 4 + 3] = h
    (*p).on[which] = w > 0.0 && h > 0.0
}

fn forward_x(p: *mut Pan, on: bool) { (*p).fwd = on }

fn press_x(p: *mut Pan) -> f64 { return ds_touchtrack.track_x0(&(*p).track) }
fn press_y(p: *mut Pan) -> f64 { return ds_touchtrack.track_y0(&(*p).track) }
fn pending(p: *mut Pan) -> bool { return ds_touchtrack.track_on(&(*p).track) }

fn nav_of(p: *mut Pan) -> *mut ds_navview.NavView { return (*p).ptr[R_NAV] as *mut ds_navview.NavView }
fn grid_of(p: *mut Pan) -> *mut ds_vgrid.Grid { return (*p).ptr[R_GRID] as *mut ds_vgrid.Grid }
fn sa_of(p: *mut Pan) -> *mut ds_scroller.Scroller { return (*p).ptr[R_A] as *mut ds_scroller.Scroller }
fn sb_of(p: *mut Pan) -> *mut ds_scroller.Scroller { return (*p).ptr[R_B] as *mut ds_scroller.Scroller }

fn stop_all(p: *mut Pan) {
    if (*p).ptr[R_NAV] != 0 { ds_navview.stop(nav_of(p)) }
    if (*p).ptr[R_GRID] != 0 { ds_vgrid.stop(grid_of(p)) }
    if (*p).ptr[R_A] != 0 { ds_scroller.stop(sa_of(p)) }
    if (*p).ptr[R_B] != 0 { ds_scroller.stop(sb_of(p)) }
}

fn down(p: *mut Pan, x: f64, y: f64, us: i64) {
    ds_touchtrack.track_down(&(*p).track, x, y, us)
    (*p).target = T_NONE
    stop_all(p)
}

fn hit(p: *mut Pan, which: usize, x: f64, y: f64) -> bool {
    if (*p).ptr[which] == 0 || !(*p).on[which] { return false }
    let rx: f64 = (*p).rect[which * 4]
    let ry: f64 = (*p).rect[which * 4 + 1]
    return x >= rx && x < rx + (*p).rect[which * 4 + 2] && y >= ry && y < ry + (*p).rect[which * 4 + 3]
}

fn pick(p: *mut Pan, axis: u32) -> u32 {
    let x0: f64 = press_x(p)
    let y0: f64 = press_y(p)
    var which: usize = 0
    var found: u32 = T_NONE
    while which < 4 {
        if found == T_NONE && hit(p, which, x0, y0) { found = (which + 1) as u32 }
        which = which + 1
    }
    if axis == ds_touchtrack.AXIS_X {
        if (*p).fwd && found == (R_A + 1) as u32 { return T_FWD }
        return T_NONE
    }
    if found == T_FWD { return T_NONE }
    return found
}

fn move(p: *mut Pan, c: *mut render.Ctx, x: f64, y: f64, us: i64) -> u32 {
    var d: [f64; 2] = [0.0; 2]
    let axis: u32 = ds_touchtrack.track_move(&(*p).track, c, x, y, us, &d)
    if axis == ds_touchtrack.AXIS_NONE { return MV_NONE }
    var first: bool = false
    if (*p).target == T_NONE {
        (*p).target = pick(p, axis)
        first = true
    }
    let t: u32 = (*p).target
    if t == T_NONE { return MV_NONE }
    if t == T_FWD {
        if first { return MV_FWD_START }
        return MV_FWD
    }
    let ms: i64 = us / 1000 as i64
    if t == (R_NAV + 1) as u32 { ds_navview.pan(nav_of(p), press_x(p), press_y(p), d[1], ms) }
    if t == (R_GRID + 1) as u32 { ds_vgrid.pan(grid_of(p), d[1], ms) }
    if t == (R_A + 1) as u32 { ds_scroller.drag(sa_of(p), d[1], ms) }
    if t == (R_B + 1) as u32 { ds_scroller.drag(sb_of(p), d[1], ms) }
    return MV_PAN
}

fn up(p: *mut Pan, c: *mut render.Ctx, us: i64) -> u32 {
    var v: [f64; 2] = [0.0; 2]
    let was_on: bool = ds_touchtrack.track_on(&(*p).track)
    let moved: bool = ds_touchtrack.track_up(&(*p).track, us, &v)
    if !was_on { return UP_NONE }
    if !moved { return UP_TAP }
    let t: u32 = (*p).target
    (*p).target = T_NONE
    if t == T_FWD { return UP_FWD }
    var speed: f64 = v[1]
    if speed < 0.0 { speed = 0.0 - speed }
    if speed < ds_touchtrack.FLING_MIN_PER_MS { return UP_PAN }
    let ms: i64 = us / 1000 as i64
    let ppi: f64 = kit.ln(c, FLING_DP)
    if t == (R_NAV + 1) as u32 && ds_navview.scroll_max(nav_of(p)) > 0.0 { ds_navview.fling(nav_of(p), v[1] * 1000.0, ms, ppi) }
    if t == (R_GRID + 1) as u32 { ds_vgrid.fling(grid_of(p), v[1] * 1000.0, ms) }
    if t == (R_A + 1) as u32 && ds_scroller.limit(sa_of(p)) > 0.0 { ds_scroller.fling(sa_of(p), v[1], ms, ppi) }
    if t == (R_B + 1) as u32 && ds_scroller.limit(sb_of(p)) > 0.0 { ds_scroller.fling(sb_of(p), v[1], ms, ppi) }
    return UP_PAN
}

fn cancel(p: *mut Pan) {
    var v: [f64; 2] = [0.0; 2]
    ds_touchtrack.track_up(&(*p).track, 0 as i64, &v)
    (*p).target = T_NONE
}

fn tick(p: *mut Pan, ms: i64) -> bool {
    var ch: bool = false
    if (*p).ptr[R_NAV] != 0 && ds_navview.tick(nav_of(p), ms) { ch = true }
    if (*p).ptr[R_GRID] != 0 && ds_vgrid.tick(grid_of(p), ms) { ch = true }
    if (*p).ptr[R_A] != 0 && ds_scroller.tick(sa_of(p), ms) { ch = true }
    if (*p).ptr[R_B] != 0 && ds_scroller.tick(sb_of(p), ms) { ch = true }
    return ch
}

fn moving(p: *mut Pan) -> bool {
    if (*p).ptr[R_NAV] != 0 && ds_navview.moving(nav_of(p)) { return true }
    if (*p).ptr[R_GRID] != 0 && ds_vgrid.moving(grid_of(p)) { return true }
    if (*p).ptr[R_A] != 0 && ds_scroller.moving(sa_of(p)) { return true }
    if (*p).ptr[R_B] != 0 && ds_scroller.moving(sb_of(p)) { return true }
    return false
}

fn frame(p: *mut Pan, c: *mut render.Ctx) {
    tick(p, render.ctx_time(c))
    if moving(p) { screenanim.want(c, render.ctx_time(c) + 16) }
}

fn record(p: *mut Pan, c: *mut render.Ctx, kind: u32, id: u32, ptype: u32, x: f64, y: f64,
    on_down: fn(u64, f64, f64, i64), on_move: fn(u64, f64, f64, i64) -> bool, on_up: fn(u64, f64, f64, i64) -> bool, ud: u64) -> bool {
    if ptype != event.PT_TOUCH { return false }
    if c as u64 == 0 { return false }
    let us: i64 = render.ctx_time(c) * 1000 as i64
    if kind == fuiwirt.PE_DOWN {
        if ds_touchtrack.track_on(&(*p).track) { return true }
        (*p).id = id
        on_down(ud, x, y, us)
        return true
    }
    if !ds_touchtrack.track_on(&(*p).track) || id != (*p).id { return true }
    if kind == fuiwirt.PE_MOVE { on_move(ud, x, y, us) }
    if kind == fuiwirt.PE_UP { on_up(ud, x, y, us) }
    if kind == fuiwirt.PE_CANCEL { cancel(p) }
    return true
}
