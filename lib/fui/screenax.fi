import std.rt
import std.gcobj
import fui.widget

export {
    Ax, install, active, get, begin, note, note_last, set_value_last, count, changed, mark_shown, key_for, focus_key, set_focus_key, F_FOCUS, F_CHECKED, F_SELECTED, F_DISABLED, F_MENUITEM, F_HEADING,
    name_of, kind_of, state_of, value_of, rect_of, focusable, focus_step, focus_rect, focus_clear, target, set_tree, wants_tree, at_point, NONE, CAP,
    focus_index, set_focus_index, bind_last, text_last, text_of, owner_of, aux_of, set_num_handler, set_text_handler, set_text_handler_at, bind_text_last, H_SEARCH, H_EDITOR, caret_last, caret_of, set_caret_handler_at, apply_caret, note_join, group, apply_num, apply_text, settable_num, settable_text,
}

const CAP: usize = 256
const ARENA: usize = 32768
const NAME_MAX: usize = 120
const TEXT_MAX: usize = 4000
const NONE: usize = 18446744073709551615
const H_SEARCH: usize = 0
const H_EDITOR: usize = 1
const HANDLERS: usize = 4
const CARET_NONE: u32 = 4294967295

const F_FOCUS: u32 = 1
const F_CHECKED: u32 = 2
const F_SELECTED: u32 = 4
const F_DISABLED: u32 = 8
const F_MENUITEM: u32 = 16
const F_HEADING: u32 = 32

const SEED: u64 = 1469598103934665603
const PRIME: u64 = 1099511628211

struct Ax {
    kind: [u32; 256],
    st: [u32; 256],
    off: [u32; 256],
    len: [u32; 256],
    key: [u64; 256],
    val: [i64; 256],
    own: [u64; 256],
    aux: [u64; 256],
    gr: [u32; 256],
    toff: [u32; 256],
    tlen: [u32; 256],
    th: [u32; 256],
    car: [u32; 256],
    anc: [u32; 256],
    setnum: fn(u64, u64, i64) -> bool,
    settexts: [fn(u64, u64, str) -> bool; 4],
    setcarets: [fn(u64, u64, usize, usize) -> bool; 4],
    r: [f64; 1024],
    n: usize,
    alen: usize,
    arena: u64,
    hash: u64,
    shown: u64,
    fkey: u64,
    appfocus: bool,
    tree: bool,
    grp: u32,
}

static mut G: u64 = 0

fn no_num(own: u64, aux: u64, v: i64) -> bool { return false }
fn no_text(own: u64, aux: u64, t: str) -> bool { return false }
fn no_caret(own: u64, aux: u64, anchor: usize, caret: usize) -> bool { return false }

fn get() -> *mut Ax { return G as *mut Ax }
fn active() -> bool { return G != 0 }

fn install() -> *mut Ax {
    if G != 0 { return G as *mut Ax }
    let a: *mut Ax = gcobj.alloc[Ax](1 << 15) as *mut Ax
    if a as u64 == 0 { return a }
    (*a).arena = rt.heap_alloc(ARENA)
    (*a).setnum = no_num
    var h: usize = 0
    while h < HANDLERS {
        (*a).settexts[h] = no_text
        (*a).setcarets[h] = no_caret
        h = h + 1
    }
    (*a).n = 0
    (*a).alen = 0
    (*a).hash = SEED
    (*a).shown = 0
    (*a).fkey = 0
    (*a).appfocus = false
    (*a).tree = false
    (*a).grp = 0 as u32
    G = a as u64
    return a
}

fn set_tree(on: bool) {
    if G != 0 { (*get()).tree = on }
}

fn wants_tree() -> bool { return G != 0 && (*get()).tree }

fn begin() {
    if G == 0 { return }
    let a: *mut Ax = get()
    (*a).n = 0
    (*a).alen = 0
    (*a).hash = SEED
    (*a).appfocus = false
    (*a).grp = 0 as u32
}

fn group(g: u32) {
    if G != 0 { (*get()).grp = g }
}

fn mix(h: u64, v: u64) -> u64 { return (h ^ v) *% PRIME }

fn count() -> usize {
    if G == 0 { return 0 }
    return (*get()).n
}

fn key_for(kind: u32, name: str) -> u64 {
    var n: usize = name.n
    if n > NAME_MAX { n = NAME_MAX }
    var k: u64 = mix(SEED, kind as u64)
    var j: usize = 0
    while j < n {
        k = mix(k, rt.ld8(name.p as u64, j) as u64)
        j = j + 1
    }
    return k
}

fn focus_key() -> u64 {
    if G == 0 { return 0 }
    return (*get()).fkey
}

fn set_focus_key(k: u64) {
    if G != 0 { (*get()).fkey = k }
}

fn shown_mark() -> u64 { return mix((*get()).hash, (*get()).fkey) }

fn changed() -> bool {
    if G == 0 { return false }
    return shown_mark() != (*get()).shown
}

fn mark_shown() {
    if G != 0 { (*get()).shown = shown_mark() }
}

fn note(kind: u32, st: u32, name: str, x: f64, y: f64, w: f64, h: f64, value: i64) -> usize {
    if G == 0 { return NONE }
    let a: *mut Ax = get()
    let i: usize = (*a).n
    if i >= CAP { return NONE }
    var n: usize = name.n
    if n > NAME_MAX { n = NAME_MAX }
    if (*a).alen + n > ARENA { n = 0 }
    var k: u64 = key_for(kind, name)
    if n < name.n { k = key_for(kind, str { p: name.p, n: n }) }
    if n > 0 { rt.mem_copy((*a).arena + (*a).alen as u64, name.p as u64, n) }
    (*a).kind[i] = kind
    (*a).st[i] = st
    (*a).off[i] = (*a).alen as u32
    (*a).len[i] = n as u32
    (*a).key[i] = k
    (*a).val[i] = value
    (*a).own[i] = 0
    (*a).gr[i] = (*a).grp
    (*a).aux[i] = 0
    (*a).toff[i] = 0 as u32
    (*a).tlen[i] = 0 as u32
    (*a).th[i] = 0 as u32
    (*a).car[i] = CARET_NONE
    (*a).anc[i] = 0 as u32
    (*a).r[i * 4] = x
    (*a).r[i * 4 + 1] = y
    (*a).r[i * 4 + 2] = w
    (*a).r[i * 4 + 3] = h
    (*a).alen = (*a).alen + n
    (*a).n = i + 1
    if (st & F_FOCUS) != 0 as u32 { (*a).appfocus = true }
    var hh: u64 = mix((*a).hash, k)
    hh = mix(hh, st as u64)
    hh = mix(hh, value as u64)
    hh = mix(hh, (*a).grp as u64)
    hh = mix(hh, (x as i64) as u64)
    hh = mix(hh, (y as i64) as u64)
    hh = mix(hh, (w as i64) as u64)
    hh = mix(hh, (h as i64) as u64)
    (*a).hash = hh
    return i
}

#[allow_escape]
fn note_join(kind: u32, st: u32, a: str, b: str, x: f64, y: f64, w: f64, h: f64, value: i64) -> usize {
    if G == 0 { return NONE }
    var buf: [u8; 128] = [0 as u8; 128]
    var n: usize = 0
    var i: usize = 0
    while i < a.n && n < 60 {
        buf[n] = rt.ld8(a.p as u64, i)
        n = n + 1
        i = i + 1
    }
    if a.n > 0 && b.n > 0 && n < 126 {
        buf[n] = 58 as u8
        buf[n + 1] = 32 as u8
        n = n + 2
    }
    i = 0
    while i < b.n && n < NAME_MAX {
        buf[n] = rt.ld8(b.p as u64, i)
        n = n + 1
        i = i + 1
    }
    return note(kind, st, str { p: (&buf[0]) as *mut u8, n: n }, x, y, w, h, value)
}

fn note_last() -> usize {
    if G == 0 || (*get()).n == 0 { return NONE }
    return (*get()).n - 1
}

fn set_value_last(v: i64) {
    if G == 0 || (*get()).n == 0 { return }
    (*get()).val[(*get()).n - 1] = v
    (*get()).hash = mix((*get()).hash, v as u64)
}

fn bind_last(own: u64, aux: u64) {
    if G == 0 || (*get()).n == 0 { return }
    let i: usize = (*get()).n - 1
    (*get()).own[i] = own
    (*get()).aux[i] = aux
}

fn text_last(t: str) {
    if G == 0 || (*get()).n == 0 { return }
    let a: *mut Ax = get()
    let i: usize = (*a).n - 1
    var n: usize = t.n
    if n > TEXT_MAX { n = TEXT_MAX }
    if (*a).alen + n > ARENA { return }
    if n > 0 { rt.mem_copy((*a).arena + (*a).alen as u64, t.p as u64, n) }
    (*a).toff[i] = (*a).alen as u32
    (*a).tlen[i] = n as u32
    (*a).alen = (*a).alen + n
    var hh: u64 = (*a).hash
    var j: usize = 0
    while j < n {
        hh = mix(hh, rt.ld8(t.p as u64, j) as u64)
        j = j + 1
    }
    (*a).hash = mix(hh, n as u64)
}

fn text_of(i: usize) -> str {
    let a: *mut Ax = get()
    return str { p: ((*a).arena + (*a).toff[i] as u64) as *mut u8, n: (*a).tlen[i] as usize }
}

fn owner_of(i: usize) -> u64 { return (*get()).own[i] }
fn aux_of(i: usize) -> u64 { return (*get()).aux[i] }

fn set_num_handler(f: fn(u64, u64, i64) -> bool) {
    if G != 0 { (*get()).setnum = f }
}

fn set_text_handler(f: fn(u64, u64, str) -> bool) { set_text_handler_at(H_SEARCH, f) }

fn set_text_handler_at(slot: usize, f: fn(u64, u64, str) -> bool) {
    if G != 0 && slot < HANDLERS { (*get()).settexts[slot] = f }
}

fn set_caret_handler_at(slot: usize, f: fn(u64, u64, usize, usize) -> bool) {
    if G != 0 && slot < HANDLERS { (*get()).setcarets[slot] = f }
}

fn caret_last(caret: usize, anchor: usize) {
    if G == 0 || (*get()).n == 0 { return }
    let a: *mut Ax = get()
    let i: usize = (*a).n - 1
    var c: usize = caret
    var an: usize = anchor
    if c > (*a).tlen[i] as usize { c = (*a).tlen[i] as usize }
    if an > (*a).tlen[i] as usize { an = (*a).tlen[i] as usize }
    (*a).car[i] = c as u32
    (*a).anc[i] = an as u32
    (*a).hash = mix(mix((*a).hash, c as u64), an as u64 + 1)
}

fn caret_of(i: usize, caret: *mut usize, anchor: *mut usize) -> bool {
    if G == 0 || i >= (*get()).n || (*get()).car[i] == CARET_NONE { return false }
    *caret = (*get()).car[i] as usize
    *anchor = (*get()).anc[i] as usize
    return true
}

fn apply_caret(i: usize, anchor: usize, caret: usize) -> bool {
    if G == 0 || i >= (*get()).n || (*get()).own[i] == 0 || (*get()).car[i] == CARET_NONE { return false }
    return ((*get()).setcarets[(*get()).th[i] as usize])((*get()).own[i], (*get()).aux[i], anchor, caret)
}

fn bind_text_last(own: u64, aux: u64, slot: usize) {
    if G == 0 || (*get()).n == 0 || slot >= HANDLERS { return }
    bind_last(own, aux)
    (*get()).th[(*get()).n - 1] = slot as u32
}

fn settable_num(i: usize) -> bool {
    return G != 0 && i < (*get()).n && (*get()).own[i] != 0 && (*get()).kind[i] == widget.KIND_SLIDER
}

fn settable_text(i: usize) -> bool {
    return G != 0 && i < (*get()).n && (*get()).own[i] != 0 && (*get()).kind[i] == widget.KIND_TEXTBOX
}

fn apply_num(i: usize, v: i64) -> bool {
    if !settable_num(i) || ((*get()).st[i] & F_DISABLED) != 0 as u32 { return false }
    return ((*get()).setnum)((*get()).own[i], (*get()).aux[i], v)
}

#[allow_escape]
fn apply_text(i: usize, t: str) -> bool {
    if !settable_text(i) || ((*get()).st[i] & F_DISABLED) != 0 as u32 { return false }
    return ((*get()).settexts[(*get()).th[i] as usize])((*get()).own[i], (*get()).aux[i], t)
}

fn name_of(i: usize) -> str {
    let a: *mut Ax = get()
    return str { p: ((*a).arena + (*a).off[i] as u64) as *mut u8, n: (*a).len[i] as usize }
}

fn kind_of(i: usize) -> u32 { return (*get()).kind[i] }
fn state_of(i: usize) -> u32 { return (*get()).st[i] }
fn value_of(i: usize) -> i64 { return (*get()).val[i] }

fn rect_of(i: usize, out: *mut [f64; 4]) {
    let a: *mut Ax = get()
    (*out)[0] = (*a).r[i * 4]
    (*out)[1] = (*a).r[i * 4 + 1]
    (*out)[2] = (*a).r[i * 4 + 2]
    (*out)[3] = (*a).r[i * 4 + 3]
}

fn focusable(i: usize) -> bool {
    let a: *mut Ax = get()
    if ((*a).st[i] & F_DISABLED) != 0 as u32 { return false }
    if ((*a).st[i] & F_MENUITEM) != 0 as u32 { return true }
    let k: u32 = (*a).kind[i]
    return k == widget.KIND_BUTTON || k == widget.KIND_TOGGLE || k == widget.KIND_CHECKBOX || k == widget.KIND_RADIO
    || k == widget.KIND_TEXTBOX || k == widget.KIND_SLIDER || k == widget.KIND_DROPDOWN || k == widget.KIND_TAB
}

fn focus_index() -> usize {
    if G == 0 || (*get()).fkey == 0 { return NONE }
    let a: *mut Ax = get()
    var i: usize = 0
    while i < (*a).n {
        if (*a).key[i] == (*a).fkey && focusable(i) { return i }
        i = i + 1
    }
    return NONE
}

fn set_focus_index(i: usize) {
    if G == 0 { return }
    if i >= (*get()).n { (*get()).fkey = 0; return }
    (*get()).fkey = (*get()).key[i]
}

fn focus_clear() {
    if G != 0 { (*get()).fkey = 0 }
}

fn rank(i: usize) -> u64 { return ((*get()).gr[i] as u64) * 4096 + i as u64 }

fn focus_step(back: bool) -> bool {
    if G == 0 { return false }
    let a: *mut Ax = get()
    var cnt: usize = 0
    var first: usize = NONE
    var last: usize = NONE
    var prev: usize = NONE
    var next: usize = NONE
    let cur: usize = focus_index()
    var i: usize = 0
    while i < (*a).n {
        if focusable(i) {
            cnt = cnt + 1
            if first == NONE || rank(i) < rank(first) { first = i }
            if last == NONE || rank(i) > rank(last) { last = i }
            if cur != NONE && rank(i) < rank(cur) && (prev == NONE || rank(i) > rank(prev)) { prev = i }
            if cur != NONE && rank(i) > rank(cur) && (next == NONE || rank(i) < rank(next)) { next = i }
        }
        i = i + 1
    }
    if cnt == 0 { return false }
    var to: usize = NONE
    if cur == NONE {
        to = first
        if back { to = last }
    } else if back {
        to = prev
        if to == NONE { to = last }
    } else {
        to = next
        if to == NONE { to = first }
    }
    set_focus_index(to)
    return true
}

fn focus_rect(out: *mut [f64; 4]) -> bool {
    if G == 0 || (*get()).appfocus { return false }
    let i: usize = focus_index()
    if i == NONE { return false }
    rect_of(i, out)
    return true
}

fn target(out: *mut [f64; 2]) -> bool {
    var q: [f64; 4] = [0.0; 4]
    if !focus_rect(&q) { return false }
    (*out)[0] = q[0] + q[2] / 2.0
    (*out)[1] = q[1] + q[3] / 2.0
    return true
}

fn at_point(x: f64, y: f64) -> usize {
    if G == 0 { return NONE }
    let a: *mut Ax = get()
    var i: usize = (*a).n
    while i > 0 {
        i = i - 1
        if x >= (*a).r[i * 4] && x < (*a).r[i * 4] + (*a).r[i * 4 + 2] && y >= (*a).r[i * 4 + 1] && y < (*a).r[i * 4 + 1] + (*a).r[i * 4 + 3] && focusable(i) { return i }
    }
    return NONE
}
