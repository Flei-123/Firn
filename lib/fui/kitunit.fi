import std.rt
import fui.painter
import fui.regioncache
import fui.render
import paint.canvas

export { begin, end, abort, text_sum, ink }

fn text_sum(t: str) -> f64 {
    var h: u64 = 5381
    var i: usize = 0
    while i < t.n {
        h = ((h * 131) + (rt.ld8(t.p as u64, i) as u64)) & 1048575
        i = i + 1
    }
    return h as f64
}

fn ink(a: u32, b: u32, c: u32, d: u32, e: u32) -> u64 {
    var h: u64 = 14695981039346656037
    h = (h ^ (a as u64)) *% 1099511628211
    h = (h ^ (b as u64)) *% 1099511628211
    h = (h ^ (c as u64)) *% 1099511628211
    h = (h ^ (d as u64)) *% 1099511628211
    h = (h ^ (e as u64)) *% 1099511628211
    return h
}

fn begin(c: *mut render.Ctx, kind: u64, aux: u64, nums: *mut [f64; 8], x0: f64, y0: f64, x1: f64, y1: f64) -> bool {
    return regioncache.begin(painter.painter_canvas(render.ctx_painter(c)), kind, aux, nums, x0, y0, x1, y1)
}

fn end(c: *mut render.Ctx) {
    regioncache.end(painter.painter_canvas(render.ctx_painter(c)))
}

fn abort() {
    regioncache.abort()
}
