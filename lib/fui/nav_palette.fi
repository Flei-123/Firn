// SPDX-License-Identifier: MPL-2.0
// lib/fui/nav_palette.fi -- command palette model (Ctrl+K): entries from the action registry and from routes,
// fuzzy filter, selection. No drawing, no host.
import std.vec
import text.fuzzy
import fui.action

export {
    PalEntry, Pal, Pick,
    NP_ACTION, NP_ROUTE, NP_MAX, NP_SHOWN, NP_NONE, NP_QUERY_MAX,
    NK_IGNORED, NK_HANDLED, NK_PICK, NK_CLOSED,
    npal_new, npal_clear, npal_add_route, npal_add_actions, npal_refresh_actions,
    npal_open, npal_close, npal_is_open, npal_toggle_key, npal_key,
    npal_type, npal_backspace, npal_set_query, npal_query,
    npal_count, npal_entry_at, npal_title, npal_hint, npal_enabled, npal_is_route,
    npal_move, npal_selected, npal_pick, npal_shortcut_text, npal_positions,
}

const NP_ACTION: u32 = 0
const NP_ROUTE: u32 = 1
const NP_MAX: usize = 128
const NP_SHOWN: usize = 64
const NP_NONE: usize = 0xFFFFFFFF
const NP_QUERY_MAX: usize = 64

const NK_IGNORED: u32 = 0
const NK_HANDLED: u32 = 1
const NK_PICK: u32 = 2
const NK_CLOSED: u32 = 3

struct PalEntry {
    title: str,
    hint: str,
    url: str,
    kind: u32,
    action: usize,
    key: u32,
    mods: u32,
    enabled: bool,
    shown: bool,
}

struct Pal {
    e: [PalEntry; 128],
    n: usize,
    q: [u8; 64],
    qn: usize,
    res: [usize; 64],
    nres: usize,
    sel: usize,
    open: bool,
}

struct Pick {
    ok: bool,
    kind: u32,
    action: usize,
    url: str,
}

fn blank() -> PalEntry {
    return PalEntry { title: "", hint: "", url: "", kind: NP_ACTION, action: NP_NONE, key: 0 as u32, mods: 0 as u32,
        enabled: true, shown: true }
}

fn npal_new() -> Pal {
    return Pal { e: [blank(); 128], n: 0, q: [0 as u8; 64], qn: 0, res: [0; 64], nres: 0, sel: 0, open: false }
}

fn npal_clear(p: *mut Pal) {
    (*p).n = 0
    refilter(p)
}

fn npal_add_route(p: *mut Pal, title: str, hint: str, url: str) -> bool {
    if (*p).n >= NP_MAX || title.n == 0 || url.n == 0 { return false }
    var e: PalEntry = blank()
    e.title = title
    e.hint = hint
    e.url = url
    e.kind = NP_ROUTE
    (*p).e[(*p).n] = e
    (*p).n = (*p).n + 1
    refilter(p)
    return true
}

fn npal_add_actions(p: *mut Pal, reg: *mut action.Actions, cx: *mut action.ActCtx) -> usize {
    var added: usize = 0
    var i: usize = 0
    while i < action.act_count(reg) && (*p).n < NP_MAX {
        var e: PalEntry = blank()
        e.title = action.act_label(reg, i)
        e.hint = action.act_desc(reg, i)
        e.kind = NP_ACTION
        e.action = i
        e.key = action.act_key(reg, i)
        e.mods = action.act_mods(reg, i)
        e.enabled = action.act_enabled(reg, i, cx)
        e.shown = action.act_visible(reg, i, cx)
        if e.title.n > 0 {
            (*p).e[(*p).n] = e
            (*p).n = (*p).n + 1
            added = added + 1
        }
        i = i + 1
    }
    refilter(p)
    return added
}

fn npal_refresh_actions(p: *mut Pal, reg: *mut action.Actions, cx: *mut action.ActCtx) {
    var i: usize = 0
    while i < (*p).n {
        if (*p).e[i].kind == NP_ACTION {
            (*p).e[i].enabled = action.act_enabled(reg, (*p).e[i].action, cx)
            (*p).e[i].shown = action.act_visible(reg, (*p).e[i].action, cx)
        }
        i = i + 1
    }
    refilter(p)
}

fn npal_query(p: *mut Pal) -> str {
    return str { p: (&(*p).q[0]) as *mut u8, n: (*p).qn }
}

fn refilter(p: *mut Pal) {
    (*p).nres = 0
    (*p).sel = 0
    var items: Vec[str] = vec_new[str]()
    var map: Vec[usize] = vec_new[usize]()
    var i: usize = 0
    while i < (*p).n {
        if (*p).e[i].shown {
            vec_push[str](&items, (*p).e[i].title)
            vec_push[usize](&map, i)
        }
        i = i + 1
    }
    if (*p).qn == 0 {
        var k: usize = 0
        while k < vec_len[usize](&map) && (*p).nres < NP_SHOWN {
            (*p).res[(*p).nres] = vec_at[usize](&map, k)
            (*p).nres = (*p).nres + 1
            k = k + 1
        }
    } else {
        var order: Vec[usize] = vec_new[usize]()
        fuzzy.rank(npal_query(p), &items, fuzzy.CASE_SMART, &order)
        var k: usize = 0
        while k < vec_len[usize](&order) && (*p).nres < NP_SHOWN {
            (*p).res[(*p).nres] = vec_at[usize](&map, vec_at[usize](&order, k))
            (*p).nres = (*p).nres + 1
            k = k + 1
        }
        vec_free[usize](&order)
    }
    vec_free[str](&items)
    vec_free[usize](&map)
}

fn npal_set_query(p: *mut Pal, q: str) {
    var n: usize = q.n
    if n > NP_QUERY_MAX { n = NP_QUERY_MAX }
    var i: usize = 0
    while i < n {
        (*p).q[i] = *((q.p as u64 + i as u64) as *mut u8)
        i = i + 1
    }
    (*p).qn = n
    refilter(p)
}

fn npal_open(p: *mut Pal) {
    (*p).open = true
    (*p).qn = 0
    refilter(p)
}

fn npal_close(p: *mut Pal) { (*p).open = false }

fn npal_is_open(p: *mut Pal) -> bool { return (*p).open }

fn npal_toggle_key(key: u32, mods: u32) -> bool {
    return action.key_logical(key) == (75 as u32) && (mods & (action.MOD_CTRL | action.MOD_META)) != (0 as u32)
}

fn npal_type(p: *mut Pal, ch: u8) -> bool {
    if !(*p).open || ch < (32 as u8) || ch == (127 as u8) || (*p).qn >= NP_QUERY_MAX { return false }
    (*p).q[(*p).qn] = ch
    (*p).qn = (*p).qn + 1
    refilter(p)
    return true
}

fn npal_backspace(p: *mut Pal) -> bool {
    if (*p).qn == 0 { return false }
    var n: usize = (*p).qn - 1
    while n > 0 && ((*p).q[n] & (192 as u8)) == (128 as u8) { n = n - 1 }
    (*p).qn = n
    refilter(p)
    return true
}

fn npal_count(p: *mut Pal) -> usize { return (*p).nres }

fn npal_entry_at(p: *mut Pal, i: usize) -> usize {
    if i >= (*p).nres { return NP_NONE }
    return (*p).res[i]
}

fn npal_title(p: *mut Pal, i: usize) -> str {
    if i >= (*p).nres { return "" }
    return (*p).e[(*p).res[i]].title
}

fn npal_hint(p: *mut Pal, i: usize) -> str {
    if i >= (*p).nres { return "" }
    return (*p).e[(*p).res[i]].hint
}

fn npal_enabled(p: *mut Pal, i: usize) -> bool {
    if i >= (*p).nres { return false }
    return (*p).e[(*p).res[i]].enabled
}

fn npal_is_route(p: *mut Pal, i: usize) -> bool {
    if i >= (*p).nres { return false }
    return (*p).e[(*p).res[i]].kind == NP_ROUTE
}

fn npal_move(p: *mut Pal, delta: i32) {
    if (*p).nres == 0 { return }
    let n: i32 = (*p).nres as i32
    var s: i32 = ((*p).sel as i32 + delta) % n
    if s < 0 { s = s + n }
    (*p).sel = s as usize
}

fn npal_selected(p: *mut Pal) -> usize {
    if (*p).nres == 0 { return NP_NONE }
    return (*p).sel
}

fn npal_pick(p: *mut Pal) -> Pick {
    var r: Pick = Pick { ok: false, kind: NP_ACTION, action: NP_NONE, url: "" }
    if (*p).nres == 0 { return r }
    let e: PalEntry = (*p).e[(*p).res[(*p).sel]]
    if !e.enabled { return r }
    r.ok = true
    r.kind = e.kind
    r.action = e.action
    r.url = e.url
    return r
}

fn npal_key(p: *mut Pal, key: u32, mods: u32) -> u32 {
    if npal_toggle_key(key, mods) {
        if (*p).open { (*p).open = false; return NK_CLOSED }
        npal_open(p)
        return NK_HANDLED
    }
    if !(*p).open { return NK_IGNORED }
    if key == action.SK_ESCAPE {
        (*p).open = false
        return NK_CLOSED
    }
    if key == action.SK_ENTER {
        if npal_pick(p).ok { return NK_PICK }
        return NK_HANDLED
    }
    if key == action.SK_DOWN { npal_move(p, 1); return NK_HANDLED }
    if key == action.SK_UP { npal_move(p, -1); return NK_HANDLED }
    if key == action.SK_BACKSPACE { npal_backspace(p); return NK_HANDLED }
    return NK_IGNORED
}

fn npal_shortcut_text(p: *mut Pal, i: usize, out: *mut u8, cap: usize) -> usize {
    if i >= (*p).nres { return 0 }
    let e: PalEntry = (*p).e[(*p).res[i]]
    return action.shortcut_text(e.key, e.mods, out, cap)
}

fn npal_positions(p: *mut Pal, i: usize, out: *mut u32, cap: usize) -> usize {
    if i >= (*p).nres || (*p).qn == 0 { return 0 }
    var m: fuzzy.Match = fuzzy.match_new()
    var n: usize = 0
    if fuzzy.match_text(npal_query(p), (*p).e[(*p).res[i]].title, fuzzy.CASE_SMART, &m) {
        var k: usize = 0
        while k < fuzzy.match_count(&m) && n < cap {
            *((out as u64 + (n * 4) as u64) as *mut u32) = fuzzy.match_byte(&m, k) as u32
            n = n + 1
            k = k + 1
        }
    }
    fuzzy.match_free(&m)
    return n
}
