// SPDX-License-Identifier: MPL-2.0
// lib/fui/lay.fi -- CSS FLEXBOX FOR THE TEN-LINE APP API.
//
// WHY: app.row / app.column / app.card open boxes that CENTRE everything
// (justify CENTER, align CENTER) and the app layer has no setter for gap,
// padding, margin, grow, shrink, basis, min/max or "full width". A web
// mobile layout (column of cards, label above a full-width field, a row with
// a field that takes the rest) cannot be built from that. This module is the
// web way: the defaults are CSS's (justify START, align STRETCH, gap 0,
// padding 0), every setter takes DESIGN POINTS (= CSS px).
//
// app.row / app.column / app.card are NOT touched: lay.* is an addition.
//
//   lay.vbox(a) ... app.end(a)         flex-direction: column
//   lay.hbox(a) ... app.end(a)         flex-direction: row
//   lay.hwrap(a) ... app.end(a)        row + flex-wrap: wrap (real line logic)
//
// Setters take ANY node id (a box or a widget): lay.grow(a, id, 1000) ...
// Arithmetic: flex.fi (distribution, redistribution on clamping), margins by
// inflation in scene.fi (fill_items / lay_adjust). tools/fui/lay_main.fi checks
// it against numbers MEASURED in Chromium (tools/fui/lay_ref.py).
//
// Known differences to CSS (kept small on purpose):
//   - margins + shrink: CSS scales the shrink share by the size WITHOUT the
//     margins, flex.fi by the size with them.
//   - no auto margins, no `order`, no `display:none` (lay.hidden = visibility).
//   - min-content of a nested box is its preferred size.
//   - min/max cross-size clamps the rectangle; the item stays at the cross start.
import fui.app
import fui.scene
import fui.flex
import fui.style
import fui.theme
import window.hostmetrics
import fui.viewport
import fui.touchscroll
import std.rt

export {
    AL_START, AL_CENTER, AL_END, AL_STRETCH, AL_BASELINE,
    JU_START, JU_CENTER, JU_END, JU_BETWEEN, JU_AROUND, JU_EVENLY,
    page, vbox, hbox, hwrap,
    align, justify, align_self, gap, pad, pad_all, margin,
    grow, shrink, basis, size, min_w, max_w, min_h, max_h,
    fill_w, fill_h, aspect, hidden, inset_safe,
    label, text_wrap, text_start, spacer_grow,
    scroll_v, scroll_h, scroll_sync, scroll_set_bar, scroll_offset, scroll_offset_x, scroll_over, scroll_to, scroll_to_x, scroll_pan, scroll_fling, scroll_reveal, scroll_node, scroll_last,
}

const AL_START: u32 = 1
const AL_CENTER: u32 = 3
const AL_END: u32 = 2
const AL_STRETCH: u32 = 4
const AL_BASELINE: u32 = 5

const JU_START: u32 = 0
const JU_CENTER: u32 = 2
const JU_END: u32 = 1
const JU_BETWEEN: u32 = 3
const JU_AROUND: u32 = 4
const JU_EVENLY: u32 = 5

const ALL_LINES: usize = 1000

// -------------------------------------------------------------- BOXES
fn open_css(a: *mut app.App, dir: u32, wrap: bool) -> usize {
    let b: usize = app.open_box(a, dir)
    if b == app.NONE {
        return b
    }
    let sc: *mut scene.Scene = app.app_scene(a)
    // node_set_flex starts a fresh FlexBox: gap 0, padding 0 (CSS)
    scene.node_set_flex(sc, b, dir, flex.JUSTIFY_START, flex.AL_STRETCH)
    scene.node_set_strict(sc, b, true)
    if wrap {
        scene.node_set_wrap(sc, b, flex.WRAP_WRAP)
    }
    return b
}

// A column: children stand one below the other, full width (stretch).
fn vbox(a: *mut app.App) -> usize {
    return open_css(a, flex.FLEX_COLUMN, false)
}

// A row: children side by side, full height of the row (stretch).
fn hbox(a: *mut app.App) -> usize {
    return open_css(a, flex.FLEX_ROW, false)
}

// A row that breaks into lines when it is too narrow (flex-wrap: wrap).
fn hwrap(a: *mut app.App) -> usize {
    return open_css(a, flex.FLEX_ROW, true)
}

// The window's root column the CSS way: children stretch over the full
// width, start at the top, no padding, no gap. Call once, before building.
// (app.set_insets later still adds the host insets to the root padding.)
fn page(a: *mut app.App) {
    let r: usize = app.root(a)
    let sc: *mut scene.Scene = app.app_scene(a)
    scene.node_set_flex(sc, r, flex.FLEX_COLUMN, flex.JUSTIFY_START, flex.AL_STRETCH)
    scene.node_set_strict(sc, r, true)
    scene.node_set_padding(sc, r, 0, 0, 0, 0)
}

// ----------------------------------------------------------- HELPERS
fn sc_of(a: *mut app.App) -> *mut scene.Scene {
    return app.app_scene(a)
}

fn ok(a: *mut app.App, id: usize) -> bool {
    return a as u64 != 0 && id < scene.scene_count(sc_of(a))
}

// ---------------------------------------------------- CONTAINER SETTERS
// align-items of a box
fn align(a: *mut app.App, id: usize, al: u32) {
    if !ok(a, id) {
        return
    }
    flex.flex_set_align_items(&(*scene.nd(sc_of(a), id)).fb, al)
}

// justify-content of a box
fn justify(a: *mut app.App, id: usize, ju: u32) {
    if !ok(a, id) {
        return
    }
    flex.flex_set_justify(&(*scene.nd(sc_of(a), id)).fb, ju)
}

// align-self of one child
fn align_self(a: *mut app.App, id: usize, al: u32) {
    if !ok(a, id) {
        return
    }
    scene.node_set_align_self(sc_of(a), id, al)
}

// column-gap = x, row-gap = y (CSS `gap: y x`)
fn gap(a: *mut app.App, id: usize, x: i64, y: i64) {
    if !ok(a, id) {
        return
    }
    let fb: *mut flex.FlexBox = &(*scene.nd(sc_of(a), id)).fb
    if flex.flex_is_row(fb) {
        flex.flex_set_gap(fb, x, y)
    } else {
        flex.flex_set_gap(fb, y, x)
    }
}

fn pad(a: *mut app.App, id: usize, l: i64, t: i64, r: i64, b: i64) {
    if !ok(a, id) {
        return
    }
    scene.node_set_padding(sc_of(a), id, l, t, r, b)
}

fn pad_all(a: *mut app.App, id: usize, p: i64) {
    pad(a, id, p, p, p, p)
}

// ------------------------------------------------------- CHILD SETTERS
fn margin(a: *mut app.App, id: usize, l: i64, t: i64, r: i64, b: i64) {
    if !ok(a, id) {
        return
    }
    scene.node_set_margin(sc_of(a), id, l, t, r, b)
}

// flex-grow in permille: 1000 = 1
fn grow(a: *mut app.App, id: usize, permille: i64) {
    if !ok(a, id) {
        return
    }
    scene.node_set_grow(sc_of(a), id, permille, (*scene.nd(sc_of(a), id)).shrink)
}

// flex-shrink in permille: 1000 = 1 (the default), 0 = never shrink
fn shrink(a: *mut app.App, id: usize, permille: i64) {
    if !ok(a, id) {
        return
    }
    scene.node_set_grow(sc_of(a), id, (*scene.nd(sc_of(a), id)).grow, permille)
}

// flex-basis in points (the main axis of the parent)
fn basis(a: *mut app.App, id: usize, pt: i64) {
    if !ok(a, id) {
        return
    }
    scene.node_set_base(sc_of(a), id, pt)
}

// width / height in points, 0 = auto
fn size(a: *mut app.App, id: usize, w: i64, h: i64) {
    if !ok(a, id) {
        return
    }
    scene.node_set_size(sc_of(a), id, w as f64, h as f64)
}

fn min_w(a: *mut app.App, id: usize, pt: i64) {
    if !ok(a, id) {
        return
    }
    let n: *mut scene.Node = scene.nd(sc_of(a), id)
    scene.node_set_minmax(sc_of(a), id, pt, (*n).mx_w, (*n).mn_h, (*n).mx_h)
}

fn max_w(a: *mut app.App, id: usize, pt: i64) {
    if !ok(a, id) {
        return
    }
    let n: *mut scene.Node = scene.nd(sc_of(a), id)
    scene.node_set_minmax(sc_of(a), id, (*n).mn_w, pt, (*n).mn_h, (*n).mx_h)
}

fn min_h(a: *mut app.App, id: usize, pt: i64) {
    if !ok(a, id) {
        return
    }
    let n: *mut scene.Node = scene.nd(sc_of(a), id)
    scene.node_set_minmax(sc_of(a), id, (*n).mn_w, (*n).mx_w, pt, (*n).mx_h)
}

fn max_h(a: *mut app.App, id: usize, pt: i64) {
    if !ok(a, id) {
        return
    }
    let n: *mut scene.Node = scene.nd(sc_of(a), id)
    scene.node_set_minmax(sc_of(a), id, (*n).mn_w, (*n).mx_w, (*n).mn_h, pt)
}

fn parent_is_row(a: *mut app.App, id: usize) -> bool {
    let p: usize = scene.scene_parent(sc_of(a), id)
    if p == scene.SCENE_NONE {
        return false
    }
    return flex.flex_is_row(&(*scene.nd(sc_of(a), p)).fb)
}

// width: 100%. In a column: the child is stretched over the full width (an
// explicit width is ignored). In a row: it takes the rest (grow 1, basis 0).
fn fill_w(a: *mut app.App, id: usize) {
    if !ok(a, id) {
        return
    }
    let n: *mut scene.Node = scene.nd(sc_of(a), id)
    scene.node_set_fill(sc_of(a), id, (*n).fill | (1 as u32))
    if parent_is_row(a, id) {
        scene.node_set_grow(sc_of(a), id, 1000, 1000)
        scene.node_set_base(sc_of(a), id, 0)
    } else {
        scene.node_set_align_self(sc_of(a), id, flex.AL_STRETCH)
    }
}

// height: 100%. In a row: stretched over the full height. In a column: the
// child takes the rest (grow 1, basis 0) -- a screen column's content area.
fn fill_h(a: *mut app.App, id: usize) {
    if !ok(a, id) {
        return
    }
    let n: *mut scene.Node = scene.nd(sc_of(a), id)
    scene.node_set_fill(sc_of(a), id, (*n).fill | (2 as u32))
    if parent_is_row(a, id) {
        scene.node_set_align_self(sc_of(a), id, flex.AL_STRETCH)
    } else {
        scene.node_set_grow(sc_of(a), id, 1000, 1000)
        scene.node_set_base(sc_of(a), id, 0)
    }
}

// aspect-ratio: w / h. The height follows the width (of a node with a width
// of its own, or after it is laid out).
fn aspect(a: *mut app.App, id: usize, w: i64, h: i64) {
    if !ok(a, id) {
        return
    }
    scene.node_set_aspect(sc_of(a), id, w, h)
}

// visibility: hidden -- the room stays, nothing is painted or hit.
fn hidden(a: *mut app.App, id: usize, on: bool) {
    if !ok(a, id) {
        return
    }
    scene.node_set_hidden(sc_of(a), id, on)
}

// padding of `id` = what it has + the host insets (status bar, notch,
// gesture bar), as app.set_insets does for the root. Call after lay.pad.
fn inset_safe(a: *mut app.App, id: usize) {
    if !ok(a, id) {
        return
    }
    let sc: usize = theme.theme_scale(app.app_theme(a))
    let fb: *mut flex.FlexBox = &(*scene.nd(sc_of(a), id)).fb
    scene.node_set_padding(sc_of(a), id,
        (*fb).pad_l + hostmetrics.inset_points(app.inset(a, 0), sc),
        (*fb).pad_t + hostmetrics.inset_points(app.inset(a, 1), sc),
        (*fb).pad_r + hostmetrics.inset_points(app.inset(a, 2), sc),
        (*fb).pad_b + hostmetrics.inset_points(app.inset(a, 3), sc))
}

// ------------------------------------------------------------ TEXT
// A text node breaks into lines at the width its container gives it (all
// lines, no limit) -- CSS `white-space: normal`.
fn text_wrap(a: *mut app.App, id: usize) {
    if !ok(a, id) {
        return
    }
    scene.node_set_text_wrap(sc_of(a), id, ALL_LINES)
}

// text-align: start (the window's text default is centred)
fn text_start(a: *mut app.App, id: usize) {
    app.set_text_align(a, id, style.ALIGN_LEFT)
}

// A paragraph: app.label that wraps at the container width and starts at the
// left. `size` as in app.label (points, 0 = theme size).
fn label(a: *mut app.App, s: str, size: usize) -> usize {
    let id: usize = app.label(a, s, size)
    if id != app.NONE {
        text_wrap(a, id)
        text_start(a, id)
    }
    return id
}

// An empty element that takes the free room (flex: 1) -- pushes what follows
// to the end of the box.
fn spacer_grow(a: *mut app.App) -> usize {
    let id: usize = app.spacer(a, 0, 0)
    if id != app.NONE {
        grow(a, id, 1000)
        basis(a, id, 0)
    }
    return id
}

// ---------------------------------------------------------------- SCROLL (overflow-y: auto)
// `scroll_v(a)` opens a vertical scroll area that takes the room left in its column (flex: 1 1 0, min 0) and returns the INNER column
// (stretch, like vbox); close with app.end. The inner column is as high as its content wants; what does not fit scrolls (wheel, arrow
// keys, scroll bar). `scroll_sync(a)` (once per frame, before the layout; mobile.sync calls it) hands the measured content size to the
// viewport. A finger drags the content and a flick runs out (lib/fui/touchscroll.fi); `scroll_pan` / `scroll_fling` stay for programs that drive it by hand.
const SCROLL_MAX: usize = 8
static mut SC_N: usize = 0
static mut SC_VN: [usize; 8] = [4294967295; 8]
static mut SC_IN: [usize; 8] = [4294967295; 8]
static mut SC_VP: [u64; 8] = [0; 8]
static mut SC_HZ: [bool; 8] = [false; 8]

fn scroll_v(a: *mut app.App) -> usize {
    return scroll_open(a, false, 0)
}

fn scroll_h(a: *mut app.App, height_pt: i64) -> usize {
    return scroll_open(a, true, height_pt)
}

fn scroll_open(a: *mut app.App, horizontal: bool, height_pt: i64) -> usize {
    if SC_N >= SCROLL_MAX || (*a).depth >= 15 {
        return app.NONE
    }
    let sc: *mut scene.Scene = app.app_scene(a)
    let par: usize = (*a).stack[(*a).depth - 1]
    let vn: usize = scene.scene_add(sc, par, scene.N_VIEWPORT)
    if vn == scene.SCENE_NONE {
        return app.NONE
    }
    let vp: *mut viewport.Viewport = rt.heap_alloc(65536) as *mut viewport.Viewport
    *vp = viewport.viewport_new(0.0, 0.0, 100.0, 100.0, 100.0, 100.0)
    viewport.viewport_set_bar(vp, 6)
    scene.node_set_viewport(sc, vn, vp)
    touchscroll.register(a, vn)
    if horizontal {
        scene.node_set_grow(sc, vn, 0, 0)
        scene.node_set_minmax(sc, vn, 0, 0, height_pt, height_pt)
    } else {
        scene.node_set_flexitem(sc, vn, 1000, 1000, 1, 0)
        scene.node_set_base(sc, vn, 0)
    }
    scene.node_set_align_self(sc, vn, flex.AL_STRETCH)
    let inner: usize = scene.scene_add(sc, vn, scene.N_BOX)
    if inner == scene.SCENE_NONE {
        return app.NONE
    }
    if horizontal {
        scene.node_set_flex(sc, inner, flex.FLEX_ROW, flex.JUSTIFY_START, flex.AL_STRETCH)
        scene.node_set_align_self(sc, inner, flex.AL_START)
    } else {
        scene.node_set_flex(sc, inner, flex.FLEX_COLUMN, flex.JUSTIFY_START, flex.AL_STRETCH)
    }
    scene.node_set_strict(sc, inner, true)
    scene.node_set_grow(sc, inner, 0, 0)
    SC_VN[SC_N] = vn
    SC_IN[SC_N] = inner
    SC_VP[SC_N] = vp as u64
    SC_HZ[SC_N] = horizontal
    SC_N = SC_N + 1
    (*a).stack[(*a).depth] = inner
    (*a).depth = (*a).depth + 1
    return inner
}

fn scroll_sync(a: *mut app.App) {
    let sc: *mut scene.Scene = app.app_scene(a)
    var k: usize = 0
    while k < SC_N {
        let vp: *mut viewport.Viewport = SC_VP[k] as *mut viewport.Viewport
        let w: f64 = scene.node_w(sc, SC_VN[k])
        let h: f64 = scene.node_nat_h(sc, SC_IN[k])
        if SC_HZ[k] {
            let bar: f64 = viewport.viewport_bar_pt(vp) as f64
            viewport.viewport_set_content(vp, scene.node_nat_w(sc, SC_IN[k]), scene.node_h(sc, SC_VN[k]) - bar)
        } else if w > 0.0 {
            // the content is as much narrower than the area as the bar's gutter (6 pt by default; scroll_set_bar can make it 0) (else the viewport adds a horizontal bar and scrolls 6 px too far)
            viewport.viewport_set_content(vp, w - viewport.viewport_bar_pt(vp) as f64, h)
        }
        k = k + 1
    }
}

// the scroll bar strip of scroll area k in design points (0 = no strip: the content uses the full width, like the web mobile page)
fn scroll_set_bar(k: usize, pt: usize) {
    if k >= SC_N {
        return
    }
    viewport.viewport_set_bar(SC_VP[k] as *mut viewport.Viewport, pt)
}

// The scroll offset (design pixels) of the k-th scroll area made, 0 if none.
fn scroll_offset(k: usize) -> f64 {
    if k >= SC_N {
        return 0.0
    }
    return viewport.viewport_off_y(SC_VP[k] as *mut viewport.Viewport)
}

fn scroll_offset_x(k: usize) -> f64 {
    if k >= SC_N {
        return 0.0
    }
    return viewport.viewport_off_x(SC_VP[k] as *mut viewport.Viewport)
}

fn scroll_over(k: usize) -> f64 {
    if k >= SC_N {
        return 0.0
    }
    let v: *mut viewport.Viewport = SC_VP[k] as *mut viewport.Viewport
    if SC_HZ[k] {
        return viewport.viewport_over_x(v)
    }
    return viewport.viewport_over_y(v)
}

fn scroll_to_x(k: usize, x: f64) {
    if k < SC_N {
        viewport.viewport_set_offset(SC_VP[k] as *mut viewport.Viewport, x, 0.0)
    }
}

fn scroll_to(k: usize, y: f64) {
    if k < SC_N {
        viewport.viewport_set_offset(SC_VP[k] as *mut viewport.Viewport, 0.0, y)
    }
}

// A finger drag: the content follows the finger (`dy` = the finger's move in px, the offset changes by -dy). Call it from an
// EV_PAN_MOVE handler of a node around the area.
fn scroll_pan(k: usize, dy: f64) {
    if k < SC_N {
        viewport.viewport_scroll_by(SC_VP[k] as *mut viewport.Viewport, 0.0, 0.0 - dy)
    }
}

// The run-out after the finger lifts (`vy_per_s` = the finger's velocity in px per second, as EV_PAN_END gives it).
fn scroll_fling(k: usize, vy_per_s: f64, now_ms: i64) {
    if k < SC_N {
        viewport.viewport_fling_friction(SC_VP[k] as *mut viewport.Viewport, 0.0, (0.0 - vy_per_s) / 1000.0, now_ms)
    }
}

// Bring node `id` (a focused text field) into view: if it lies inside one of the scroll areas, that area scrolls (as little as possible)
// until the node AND `extra` device pixels below it (the next row, so a field is not glued to the keyboard edge) are visible.
// A node taller than the area keeps its top edge visible. true = the offset changed (the caller paints a frame). Nodes outside every
// scroll area do nothing. Call it when the focus moved or the on-screen keyboard changed the room (the area is shorter by then).
fn scroll_reveal(a: *mut app.App, id: usize, extra: f64) -> bool {
    if !ok(a, id) {
        return false
    }
    let sc: *mut scene.Scene = sc_of(a)
    var p: usize = scene.scene_parent(sc, id)
    var guard: usize = 0
    while p != scene.SCENE_NONE && guard < 64 {
        var k: usize = 0
        while k < SC_N {
            if SC_VN[k] == p {
                let v: *mut viewport.Viewport = SC_VP[k] as *mut viewport.Viewport
                let ry: f64 = scene.node_y(sc, id) - viewport.viewport_content_y(v)
                return viewport.viewport_ensure_visible(v, 0.0, ry, 1.0, scene.node_h(sc, id) + extra)
            }
            k = k + 1
        }
        p = scene.scene_parent(sc, p)
        guard = guard + 1
    }
    return false
}

// The viewport node of the k-th scroll area made (app.NONE if none): for geometry checks.
fn scroll_node(k: usize) -> usize {
    if k >= SC_N {
        return app.NONE
    }
    return SC_VN[k]
}

// The index (for scroll_offset / scroll_pan / scroll_node) of the scroll area made LAST (app.NONE if none): call it right after
// scroll_v, because the index depends on the build order of the pages.
fn scroll_last() -> usize {
    if SC_N == 0 {
        return app.NONE
    }
    return SC_N - 1
}
