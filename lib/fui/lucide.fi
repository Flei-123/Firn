// The Lucide name of an icon ("send-horizontal").
fn lucide_name(id: i64) -> str {
    if id == 0 {
        return "users"
    }
    if id == 1 {
        return "user"
    }
    if id == 2 {
        return "user-round"
    }
    if id == 3 {
        return "user-plus"
    }
    if id == 4 {
        return "user-check"
    }
    if id == 5 {
        return "user-x"
    }
    if id == 6 {
        return "plus"
    }
    if id == 7 {
        return "message-square-plus"
    }
    if id == 8 {
        return "square-pen"
    }
    if id == 9 {
        return "sun"
    }
    if id == 10 {
        return "moon"
    }
