// The id of a Lucide name, -1 when this set does not carry it.
fn lucide_find(p: u64, n: usize) -> i64 {
    var i: i64 = 0
    while i < LUCIDE_N {
        let s: str = lucide_name(i)
        if s.n == n {
            var k: usize = 0
            while k < n && *((s.p as u64 + k as u64) as *mut u8) == *((p + k as u64) as *mut u8) {
                k = k + 1
            }
            if k == n {
                return i
            }
        }
        i = i + 1
    }
    return 0 - 1
}
