// SPDX-License-Identifier: MPL-2.0
// lib/fui/imagepng.fi -- A PNG BECOMES AN fUi PICTURE.
//
// ========================================================= WHY A FILE
//
// This is four lines of glue, and it has a file of its own for exactly
// one reason: lib/fui/image.fi must keep building in `profile kernel`.
//
// lib/paint/png.fi needs the heap and the GC-managed `rt.Buf` for the
// IDAT stream, so it cannot be freestanding. A `#[cfg]` around the
// import would be the tidy answer, but Firn stage 0 has no conditional
// compilation of imports -- so the split is the file boundary instead.
//
// A kernel build compiles image.fi and NOT this file. An application
// build compiles both. tools/fui/run.sh checks the first half of that
// claim by building image.fi with --profile=kernel and counting the
// syscalls and foreign names; if somebody moves this import into
// image.fi, that check fails.
//
// ================================================= WHAT PNG IS TAKEN
//
// Whatever lib/paint/png.fi takes, which as of today (13.09.2026) is:
//
//   colour type 0 (grey), 2 (RGB), 4 (grey+alpha), 6 (RGBA)
//   eight bits per sample
//   all five row filters (none/sub/up/average/paeth)
//   non-interlaced
//
// NOT taken, and refused rather than guessed at (see the head of
// lib/paint/png.fi):
//
//   colour type 3 (palette)
//   sixteen bits per sample
//   interlaced (Adam7)
//
// `decode_png` gives false for those, `image_from_png` passes the false
// on, and the caller gets an empty picture rather than noise. That is
// the right way round: a wrong picture is worse than no picture.
//
// ==================================================== WHO OWNS WHAT
//
// `paint.png.Image` OWNS its pixels -- it allocated them. The
// `fui.image.Image` this makes only POINTS at them (widget.fi E1).
//
// So the caller keeps the `png.Image` alive for as long as the widget is
// on screen, and frees it with `png.image_free` afterwards. That is the
// same contract as the text of a label, and it is why this function
// hands back both halves.
import std.rt
import paint.png
import fui.image

export {
    image_from_png, png_image_view,
}

// Decode PNG bytes into `dst` (which the caller owns and later frees
// with `png.image_free`) and hand back an fUi picture pointing into it.
//
// Gives false when the bytes are not a PNG this decoder takes; `view` is
// then an empty picture, and drawing it does nothing.
fn image_from_png(src: u64, n: usize, dst: *mut png.Image,
    view: *mut image.Image) -> bool {
    *view = image.image_new()
    if !png.decode_png(src, n, dst) {
        return false
    }
    *view = png_image_view(dst)
    return true
}

// An fUi picture over an ALREADY decoded paint.png.Image.
//
// The formats line up on purpose: `png.Image.px` is straight RGBA, four
// bytes per pixel, tightly packed -- which is exactly what
// `image.image_wrap` wants. No conversion, no copy.
fn png_image_view(im: *mut png.Image) -> image.Image {
    if !png.image_ok(im) {
        return image.image_new()
    }
    return image.image_wrap((*im).px as u64, png.image_width(im),
        png.image_height(im), 0)
}
