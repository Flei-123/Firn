// SPDX-License-Identifier: MPL-2.0
import fui.kit
import fui.render

export {
    Track, track_new, track_down, track_move, track_up, track_on, track_moved, track_axis, track_x0, track_y0,
    AXIS_NONE, AXIS_X, AXIS_Y, SAMPLES, HORIZON_US, REST_US, FLING_MIN_PER_MS, SLOP_PT,
}

const SAMPLES: usize = 16
const HORIZON_US: i64 = 100000
const REST_US: i64 = 80000
const FLING_MIN_PER_MS: f64 = 0.05
const SLOP_PT: usize = 8
const AXIS_NONE: u32 = 0
const AXIS_X: u32 = 1
const AXIS_Y: u32 = 2

struct Track {
    on: bool,
    moved: bool,
    axis: u32,
    x0: f64,
    y0: f64,
    lx: f64,
    ly: f64,
    n: usize,
    xs: [f64; 16],
    ys: [f64; 16],
    ts: [i64; 16],
}

fn track_new() -> Track {
    return Track { on: false, moved: false, axis: AXIS_NONE, x0: 0.0, y0: 0.0, lx: 0.0, ly: 0.0, n: 0, xs: [0.0; 16], ys: [0.0; 16], ts: [0; 16] }
}

fn track_on(t: *mut Track) -> bool { return (*t).on }
fn track_moved(t: *mut Track) -> bool { return (*t).moved }
fn track_axis(t: *mut Track) -> u32 { return (*t).axis }
fn track_x0(t: *mut Track) -> f64 { return (*t).x0 }
fn track_y0(t: *mut Track) -> f64 { return (*t).y0 }

fn absf(v: f64) -> f64 {
    if v < 0.0 { return 0.0 - v }
    return v
}

fn push(t: *mut Track, x: f64, y: f64, us: i64) {
    var n: usize = (*t).n
    if n >= SAMPLES {
        var i: usize = 1
        while i < SAMPLES {
            (*t).xs[i - 1] = (*t).xs[i]
            (*t).ys[i - 1] = (*t).ys[i]
            (*t).ts[i - 1] = (*t).ts[i]
            i = i + 1
        }
        n = SAMPLES - 1
    }
    (*t).xs[n] = x
    (*t).ys[n] = y
    (*t).ts[n] = us
    (*t).n = n + 1
}

fn track_down(t: *mut Track, x: f64, y: f64, us: i64) {
    (*t).on = true
    (*t).moved = false
    (*t).axis = AXIS_NONE
    (*t).x0 = x
    (*t).y0 = y
    (*t).lx = x
    (*t).ly = y
    (*t).n = 0
    push(t, x, y, us)
}

fn lead(from: f64, now: f64, slop: f64) -> f64 {
    if now > from { return from + slop }
    return from - slop
}

fn track_move(t: *mut Track, c: *mut render.Ctx, x: f64, y: f64, us: i64, out: *mut [f64; 2]) -> u32 {
    (*out)[0] = 0.0
    (*out)[1] = 0.0
    if !(*t).on { return AXIS_NONE }
    push(t, x, y, us)
    if !(*t).moved {
        let slop: f64 = kit.ln(c, SLOP_PT)
        let dx: f64 = x - (*t).x0
        let dy: f64 = y - (*t).y0
        if absf(dx) < slop && absf(dy) < slop { return AXIS_NONE }
        (*t).moved = true
        if absf(dx) > absf(dy) {
            (*t).axis = AXIS_X
            (*t).lx = lead((*t).x0, x, slop)
        } else {
            (*t).axis = AXIS_Y
            (*t).ly = lead((*t).y0, y, slop)
        }
    }
    if (*t).axis == AXIS_X {
        (*out)[0] = x - (*t).lx
        (*t).lx = x
    } else {
        (*out)[1] = y - (*t).ly
        (*t).ly = y
    }
    return (*t).axis
}

fn velocity(t: *mut Track, now_us: i64, out: *mut [f64; 2]) {
    (*out)[0] = 0.0
    (*out)[1] = 0.0
    let n: usize = (*t).n
    if n < 2 { return }
    let last: i64 = (*t).ts[n - 1]
    if now_us - last > REST_US { return }
    var i: usize = n - 1
    while i > 0 && last - (*t).ts[i - 1] <= HORIZON_US { i = i - 1 }
    let span: i64 = last - (*t).ts[i]
    if span < 4000 as i64 { return }
    let ms: f64 = (span as f64) / 1000.0
    (*out)[0] = ((*t).xs[n - 1] - (*t).xs[i]) / ms
    (*out)[1] = ((*t).ys[n - 1] - (*t).ys[i]) / ms
}

fn track_up(t: *mut Track, us: i64, out: *mut [f64; 2]) -> bool {
    (*out)[0] = 0.0
    (*out)[1] = 0.0
    if !(*t).on { return false }
    (*t).on = false
    if !(*t).moved { return false }
    velocity(t, us, out)
    return true
}
