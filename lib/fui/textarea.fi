// SPDX-License-Identifier: MPL-2.0
// lib/fui/textarea.fi -- THE TEXT AREA: SEVERAL LINES, WRAPPED, SCROLLED.
//
// The buffer and the editing are editor.fi / textbuf.fi (multi-line mode).
// The cut into visual lines is talayout.fi (cached, incremental), scroll and
// touch fling are tascroll.fi, the picture is tadraw.fi. This file holds the
// public API, the vertical movement with a goal column and the mouse.
import fui.textbuf
import fui.editor
import fui.ime
import fui.painter
import fui.render
import fui.widget
import fui.talayout
import fui.tascroll
import fui.tadraw

export {
    Lines, ta_new, ta_init, ta_free,
    ta_set_measure, ta_bind_painter, ta_set_view,
    ta_relayout, ta_line_count, ta_line_start, ta_line_end, ta_line_limit,
    ta_line_of, ta_x_of, ta_pos_at, ta_pos_at_xy,
    ta_key, ta_char, ta_mouse_down, ta_mouse_drag, ta_wheel,
    ta_scroll_y, ta_scroll_max, ta_scroll_to_caret, ta_content_h, ta_row_h, ta_visible_rows,
    ta_caret_box, ta_draw, ta_set_metrics,
    ta_touch_down, ta_touch_move, ta_touch_up, ta_kin_tick, ta_moving, ta_over,
    ta_set_visual, ta_line_rtl,
}

struct Lines {
    ix: talayout.LineIndex,
    v: tascroll.View,
    goal_x: f64,
    goal_on: u32,
    goal_caret: usize,
}

#[no_gc]
fn ta_new() -> Lines {
    return Lines {
        ix: talayout.ix_new(), v: tascroll.view_new(),
        goal_x: 0.0, goal_on: 0, goal_caret: 0,
    }
}

fn ta_init(l: *mut Lines, cap: usize) -> bool { return talayout.ix_init(&(*l).ix, cap) }

fn ta_free(l: *mut Lines) { talayout.ix_free(&(*l).ix) }

fn ta_set_measure(l: *mut Lines, m: fn(u64, u64, usize) -> f64, ctx: u64) {
    talayout.ix_set_measure(&(*l).ix, m, ctx)
}

fn ta_set_visual(l: *mut Lines, ctx: u64, x: fn(u64, u64, usize, usize) -> f64,
    hit: fn(u64, u64, usize, f64) -> usize, rtl: fn(u64, u64, usize) -> bool) {
    talayout.ix_set_visual(&(*l).ix, ctx, x, hit, rtl)
}

fn ta_bind_painter(l: *mut Lines, z: *mut painter.Painter, r: *mut painter.TextRun) {
    talayout.ix_bind_painter(&(*l).ix, z, r)
}

fn ta_set_view(l: *mut Lines, w: f64, h: f64, row_h: f64) {
    tascroll.view_set_box(&(*l).v, w, h, row_h)
    talayout.ix_set_width(&(*l).ix, w)
}

fn ta_set_metrics(l: *mut Lines, px_pt: f64, row_k: f64, bar: bool) {
    tascroll.view_set_metrics(&(*l).v, px_pt, row_k, bar)
}

fn ta_relayout(l: *mut Lines, ed: *mut editor.Editor) {
    talayout.ix_relayout(&(*l).ix, editor.editor_buf(ed))
    tascroll.view_clamp(&(*l).v, ta_line_count(l))
}

fn ta_line_count(l: *mut Lines) -> usize { return talayout.ix_count(&(*l).ix) }
fn ta_line_start(l: *mut Lines, i: usize) -> usize { return talayout.ix_start(&(*l).ix, i) }
fn ta_line_end(l: *mut Lines, i: usize) -> usize { return talayout.ix_end(&(*l).ix, i) }

fn ta_line_limit(l: *mut Lines, t: *mut textbuf.TextBuf, i: usize) -> usize {
    return talayout.ix_limit(&(*l).ix, t, i)
}

fn ta_line_of(l: *mut Lines, pos: usize) -> usize { return talayout.ix_line_of(&(*l).ix, pos) }

fn ta_line_rtl(l: *mut Lines, t: *mut textbuf.TextBuf, i: usize) -> bool {
    return talayout.ix_line_rtl(&(*l).ix, t, i)
}

fn ta_x_of(l: *mut Lines, t: *mut textbuf.TextBuf, i: usize, pos: usize) -> f64 {
    return talayout.ix_x_of(&(*l).ix, t, i, pos)
}

fn ta_pos_at(l: *mut Lines, t: *mut textbuf.TextBuf, i: usize, x: f64) -> usize {
    return talayout.ix_pos_at(&(*l).ix, t, i, x)
}

fn ta_pos_at_xy(l: *mut Lines, ed: *mut editor.Editor, x: f64, y: f64) -> usize {
    var row: f64 = (y + (*l).v.scroll_y) / (*l).v.row_h
    if row < 0.0 {
        row = 0.0
    }
    var i: usize = row as usize
    if i >= ta_line_count(l) {
        i = ta_line_count(l) - 1
    }
    return ta_pos_at(l, editor.editor_buf(ed), i, x)
}

fn ta_content_h(l: *mut Lines) -> f64 { return tascroll.view_content_h(&(*l).v, ta_line_count(l)) }
fn ta_row_h(l: *mut Lines) -> f64 { return (*l).v.row_h }
fn ta_visible_rows(l: *mut Lines) -> usize { return tascroll.view_visible_rows(&(*l).v) }
fn ta_scroll_y(l: *mut Lines) -> f64 { return (*l).v.scroll_y }
fn ta_scroll_max(l: *mut Lines) -> f64 { return tascroll.view_scroll_max(&(*l).v, ta_line_count(l)) }
fn ta_wheel(l: *mut Lines, dy: f64) { tascroll.view_wheel(&(*l).v, ta_line_count(l), dy) }
fn ta_over(l: *mut Lines) -> f64 { return tascroll.view_over(&(*l).v) }
fn ta_moving(l: *mut Lines) -> bool { return tascroll.view_moving(&(*l).v) }

fn ta_touch_down(l: *mut Lines, us: i64) {
    tascroll.view_touch_down(&(*l).v, ta_line_count(l), us)
}

fn ta_touch_move(l: *mut Lines, dy: f64, now_ms: i64, us: i64) {
    tascroll.view_touch_move(&(*l).v, ta_line_count(l), dy, now_ms, us)
}

fn ta_touch_up(l: *mut Lines, now_ms: i64, us: i64) { tascroll.view_touch_up(&(*l).v, now_ms, us) }

fn ta_kin_tick(l: *mut Lines, now_ms: i64) {
    tascroll.view_tick(&(*l).v, ta_line_count(l), now_ms)
}

fn ta_scroll_to_caret(l: *mut Lines, ed: *mut editor.Editor) {
    let car: usize = textbuf.tb_caret(editor.editor_buf(ed))
    tascroll.view_scroll_to_row(&(*l).v, ta_line_count(l), ta_line_of(l, car))
}

fn ta_caret_box(l: *mut Lines, ed: *mut editor.Editor, x: *mut f64,
    y: *mut f64, h: *mut f64) {
    let t: *mut textbuf.TextBuf = editor.editor_buf(ed)
    let car: usize = textbuf.tb_caret(t)
    let i: usize = ta_line_of(l, car)
    *x = ta_x_of(l, t, i, car)
    *y = (i as f64) * (*l).v.row_h - (*l).v.scroll_y
    *h = (*l).v.row_h
}

fn ta_draw(c: *mut render.Ctx, e0: *mut widget.Widget, ed: *mut editor.Editor,
    l: *mut Lines, caret_on: bool) {
    tadraw.draw(c, e0, ed, &(*l).ix, &(*l).v, caret_on)
}

fn line_direction_key(l: *mut Lines, ed: *mut editor.Editor, key: u32) -> u32 {
    if key != editor.KEY_LEFT && key != editor.KEY_RIGHT {
        return key
    }
    let t: *mut textbuf.TextBuf = editor.editor_buf(ed)
    if !ta_line_rtl(l, t, ta_line_of(l, textbuf.tb_caret(t))) {
        return key
    }
    if key == editor.KEY_LEFT {
        return editor.KEY_RIGHT
    }
    return editor.KEY_LEFT
}

// =============================================================== THE KEYS

// Up / Down / PageUp / PageDown: `delta` lines (negative = up).
fn move_vertical(l: *mut Lines, ed: *mut editor.Editor, delta: i64,
    extend: bool) {
    let t: *mut textbuf.TextBuf = editor.editor_buf(ed)
    let car: usize = textbuf.tb_caret(t)
    let i: usize = ta_line_of(l, car)
    // The goal column is only valid while the caret is where the last
    // vertical move left it: anything else (a program that set the text,
    // a click, an edit) moved it and a new column starts here.
    if (*l).goal_on == 0 || (*l).goal_caret != car {
        (*l).goal_x = ta_x_of(l, t, i, car)
        (*l).goal_on = 1
    }
    let target: i64 = (i as i64) + delta
    var pos: usize = 0
    if target < 0 as i64 {
        pos = 0
    } else if (target as usize) >= ta_line_count(l) {
        pos = textbuf.tb_len(t)
    } else {
        pos = ta_pos_at(l, t, target as usize, (*l).goal_x)
    }
    textbuf.tb_set_caret(t, pos, extend)
    (*l).goal_caret = textbuf.tb_caret(t)
    editor.editor_caret_wake(ed)
    ta_scroll_to_caret(l, ed)
}

// A key for a text area. Same answers as editor.editor_key (RES_*).
fn ta_key(l: *mut Lines, ed: *mut editor.Editor, key: u32,
    mods: u32) -> u32 {
    let t: *mut textbuf.TextBuf = editor.editor_buf(ed)
    ta_relayout(l, ed)
    let extend: bool = (mods & editor.MOD_SHIFT) != 0 as u32
    let ctrl: bool = (mods & editor.MOD_CTRL) != 0 as u32
    // a running input method keeps the arrows for its own list
    if !ime.ime_on(editor.editor_ime(ed)) {
        if key == editor.KEY_UP {
            move_vertical(l, ed, 0 as i64 - 1 as i64, extend)
            return editor.RES_MOVED
        }
        if key == editor.KEY_DOWN {
            move_vertical(l, ed, 1 as i64, extend)
            return editor.RES_MOVED
        }
        if key == editor.KEY_PGUP || key == editor.KEY_PGDN {
            var rows: i64 = (ta_visible_rows(l) as i64) - 1 as i64
            if rows < 1 as i64 {
                rows = 1 as i64
            }
            if key == editor.KEY_PGUP {
                rows = 0 as i64 - rows
            }
            move_vertical(l, ed, rows, extend)
            return editor.RES_MOVED
        }
        if key == editor.KEY_HOME || key == editor.KEY_END {
            (*l).goal_on = 0
            var pos: usize = 0
            if key == editor.KEY_HOME {
                if !ctrl {
                    pos = ta_line_start(l, ta_line_of(l, textbuf.tb_caret(t)))
                }
            } else if ctrl {
                pos = textbuf.tb_len(t)
            } else {
                pos = ta_line_limit(l, t, ta_line_of(l, textbuf.tb_caret(t)))
            }
            textbuf.tb_set_caret(t, pos, extend)
            editor.editor_caret_wake(ed)
            ta_scroll_to_caret(l, ed)
            return editor.RES_MOVED
        }
    }
    (*l).goal_on = 0
    let r: u32 = editor.editor_key(ed, line_direction_key(l, ed, key), mods)
    if r == editor.RES_CHANGED || r == editor.RES_MOVED {
        ta_relayout(l, ed)
        ta_scroll_to_caret(l, ed)
    }
    return r
}

// A typed character (also Ctrl+C / V / Z ...): editor.editor_char, plus the
// layout and the scroll that follow a change.
fn ta_char(l: *mut Lines, ed: *mut editor.Editor, cp: u32,
    mods: u32) -> u32 {
    (*l).goal_on = 0
    let r: u32 = editor.editor_char(ed, cp, mods)
    if r == editor.RES_CHANGED || r == editor.RES_MOVED {
        ta_relayout(l, ed)
        ta_scroll_to_caret(l, ed)
    }
    return r
}

// ============================================================== THE MOUSE

// Mouse button down at (x, y) from the top left of the text. A single click
// puts the caret there (Shift extends), a double click selects the word,
// a triple click the whole paragraph (up to the LF on both sides).
fn ta_mouse_down(l: *mut Lines, ed: *mut editor.Editor, x: f64, y: f64,
    now_us: u64, extend: bool) -> u32 {
    let t: *mut textbuf.TextBuf = editor.editor_buf(ed)
    ta_relayout(l, ed)
    (*l).goal_on = 0
    let n: usize = editor.editor_click(ed, x, now_us)
    let pos: usize = ta_pos_at_xy(l, ed, x, y)
    if extend {
        textbuf.tb_set_caret(t, pos, true)
        textbuf.tb_set_drag(t, 1 as u32)
        return editor.RES_MOVED
    }
    if n >= 3 {
        let len: usize = textbuf.tb_len(t)
        var a: usize = pos
        while a > 0 && talayout.ix_byte_at(t, a - 1) != 10 as u8 {
            a = a - 1
        }
        let b: usize = talayout.ix_find_lf(t, pos, len)
        textbuf.tb_set_range(t, b, a)
        textbuf.tb_set_drag(t, 0 as u32)
        return editor.RES_MOVED
    }
    if n == 2 {
        textbuf.tb_select_word(t, pos)
        textbuf.tb_set_drag(t, 0 as u32)
        return editor.RES_MOVED
    }
    textbuf.tb_set_caret(t, pos, extend)
    textbuf.tb_set_drag(t, 1 as u32)
    return editor.RES_MOVED
}

// The mouse moved with the button down: extend the selection and follow it
// with the scroll when it leaves the box above or below.
fn ta_mouse_drag(l: *mut Lines, ed: *mut editor.Editor, x: f64,
    y: f64) -> u32 {
    let t: *mut textbuf.TextBuf = editor.editor_buf(ed)
    if textbuf.tb_drag(t) == 0 as u32 {
        return editor.RES_NONE
    }
    ta_relayout(l, ed)
    let pos: usize = ta_pos_at_xy(l, ed, x, y)
    textbuf.tb_set_caret(t, pos, true)
    editor.editor_caret_wake(ed)
    ta_scroll_to_caret(l, ed)
    return editor.RES_MOVED
}

