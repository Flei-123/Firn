import fui.ds_tokens
import fui.ds_tokens_comp
import fui.kit
import fui.render
import fui.theme

export {
    surface, raised, text, muted, disabled, accent, on_accent, border, separator, fill_hover, fill_pressed, fill_selected,
    scrim, accent_tint, accent_fill,
    pad, gap, radius_card, radius_tile, radius_item, icon_size, tile_size, row_h, nav_w_expanded, nav_w_compact,
    top_bar_h, ring_size,
}

fn th(c: *mut render.Ctx) -> *mut theme.Theme { return render.ctx_theme(c) }
fn role(c: *mut render.Ctx, r: usize) -> u32 { return ds_tokens.paint(th(c), r) }
fn px(c: *mut render.Ctx, n: usize) -> f64 { return theme.theme_px(th(c), n) as f64 }

fn surface(c: *mut render.Ctx) -> u32 { return ds_tokens_comp.nav(th(c)).pane_bg }
fn raised(c: *mut render.Ctx) -> u32 { return role(c, ds_tokens.C_RAISED) }
fn text(c: *mut render.Ctx) -> u32 { return role(c, ds_tokens.C_TEXT) }
fn muted(c: *mut render.Ctx) -> u32 { return role(c, ds_tokens.C_TEXT_MUTED) }
fn disabled(c: *mut render.Ctx) -> u32 { return role(c, ds_tokens.C_TEXT_DISABLED) }
fn accent(c: *mut render.Ctx) -> u32 { return role(c, ds_tokens.C_ACCENT_TEXT) }
fn on_accent(c: *mut render.Ctx) -> u32 { return role(c, ds_tokens.C_TEXT_ON_ACCENT) }
fn border(c: *mut render.Ctx) -> u32 { return ds_tokens_comp.card(th(c)).border }
fn separator(c: *mut render.Ctx) -> u32 { return role(c, ds_tokens.C_SEPARATOR) }
fn fill_hover(c: *mut render.Ctx) -> u32 { return ds_tokens_comp.nav(th(c)).bg_hover }
fn fill_pressed(c: *mut render.Ctx) -> u32 { return role(c, ds_tokens.C_SUBTLE_ACTIVE) }
fn fill_selected(c: *mut render.Ctx) -> u32 { return ds_tokens_comp.row(th(c)).bg_selected }
fn scrim(c: *mut render.Ctx) -> u32 { return role(c, ds_tokens.C_SCRIM) }
fn accent_tint(c: *mut render.Ctx) -> u32 { return kit.with_alpha(accent(c), 48 as u32) }
fn accent_fill(c: *mut render.Ctx) -> u32 { return role(c, ds_tokens.C_ACCENT) }

fn pad(c: *mut render.Ctx) -> f64 { return ds_tokens_comp.card(th(c)).pad as f64 }
fn gap(c: *mut render.Ctx) -> f64 { return ds_tokens.space(th(c), ds_tokens.SP_M) as f64 }
fn radius_card(c: *mut render.Ctx) -> f64 { return ds_tokens_comp.card(th(c)).radius as f64 }
fn radius_tile(c: *mut render.Ctx) -> f64 { return ds_tokens_comp.card(th(c)).radius as f64 }
fn radius_item(c: *mut render.Ctx) -> f64 { return ds_tokens_comp.nav(th(c)).item_radius as f64 }
fn icon_size(c: *mut render.Ctx) -> f64 { return px(c, 24) }
fn tile_size(c: *mut render.Ctx) -> f64 { return px(c, 56) }
fn row_h(c: *mut render.Ctx) -> f64 { return px(c, 56) }
fn nav_w_expanded(c: *mut render.Ctx) -> f64 { return kit.nav_width(c, false) }
fn nav_w_compact(c: *mut render.Ctx) -> f64 { return kit.nav_width(c, true) }
fn top_bar_h(c: *mut render.Ctx) -> f64 { return px(c, 48) }
fn ring_size(c: *mut render.Ctx) -> f64 { return px(c, 24) }
