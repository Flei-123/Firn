import fui.kit
import fui.render
import fui.style

export {
    surface, raised, text, muted, disabled, accent, on_accent, border, separator, fill_hover, fill_pressed, fill_selected,
    scrim, accent_tint, accent_fill,
    pad, gap, radius_card, radius_tile, radius_item, icon_size, tile_size, row_h, nav_w_expanded, nav_w_compact,
    top_bar_h, ring_size,
}

fn surface(c: *mut render.Ctx) -> u32 { return kit.tokc(c, style.TOK_SURFACE) }
fn raised(c: *mut render.Ctx) -> u32 { return kit.tokc(c, style.TOK_SURFACE_RAISED) }
fn text(c: *mut render.Ctx) -> u32 { return kit.tokc(c, style.TOK_TEXT) }
fn muted(c: *mut render.Ctx) -> u32 { return kit.tokc(c, style.TOK_TEXT_MUTED) }
fn disabled(c: *mut render.Ctx) -> u32 { return kit.tokc(c, style.TOK_TEXT_DISABLED) }
fn accent(c: *mut render.Ctx) -> u32 { return kit.accent_gfx(c, style.TOK_SURFACE) }
fn on_accent(c: *mut render.Ctx) -> u32 { return kit.tokc(c, style.TOK_TEXT_ON_ACCENT) }
fn border(c: *mut render.Ctx) -> u32 { return kit.tokc(c, style.TOK_BORDER) }
fn separator(c: *mut render.Ctx) -> u32 { return kit.tokc(c, style.TOK_SEPARATOR) }
fn fill_hover(c: *mut render.Ctx) -> u32 { return kit.tokc(c, style.TOK_BUTTON_HOVER) }
fn fill_pressed(c: *mut render.Ctx) -> u32 { return kit.tokc(c, style.TOK_BUTTON_ACTIVE) }
fn fill_selected(c: *mut render.Ctx) -> u32 { return kit.tokc(c, style.TOK_SELECTION) }
fn scrim(c: *mut render.Ctx) -> u32 { return kit.with_alpha(kit.tokc(c, style.TOK_BASE), 150 as u32) }
fn accent_tint(c: *mut render.Ctx) -> u32 { return kit.with_alpha(accent(c), 48 as u32) }

fn pad(c: *mut render.Ctx) -> f64 { return kit.ln(c, 16) }
fn gap(c: *mut render.Ctx) -> f64 { return kit.ln(c, 12) }
fn radius_card(c: *mut render.Ctx) -> f64 { return kit.ln(c, 12) }
fn radius_tile(c: *mut render.Ctx) -> f64 { return kit.ln(c, 12) }
fn radius_item(c: *mut render.Ctx) -> f64 { return kit.ln(c, 8) }
fn icon_size(c: *mut render.Ctx) -> f64 { return kit.ln(c, 24) }
fn tile_size(c: *mut render.Ctx) -> f64 { return kit.ln(c, 56) }
fn row_h(c: *mut render.Ctx) -> f64 { return kit.ln(c, 56) }
fn nav_w_expanded(c: *mut render.Ctx) -> f64 { return kit.nav_width(c, false) }
fn nav_w_compact(c: *mut render.Ctx) -> f64 { return kit.nav_width(c, true) }
fn top_bar_h(c: *mut render.Ctx) -> f64 { return kit.ln(c, 48) }
fn ring_size(c: *mut render.Ctx) -> f64 { return kit.ln(c, 24) }

fn accent_fill(c: *mut render.Ctx) -> u32 { return kit.tokc(c, style.TOK_ACCENT) }
