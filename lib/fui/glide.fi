// SPDX-License-Identifier: MPL-2.0
export { pos, set_limits, set_stop, set, add, nudge, goto, fling, stop, busy_ch, busy, tick, CHANNELS, CH_A, CH_B, CH_C, CH_D }

const CHANNELS: usize = 4
const CH_A: usize = 0
const CH_B: usize = 1
const CH_C: usize = 2
const CH_D: usize = 3

const FRICTION: f64 = 0.0023
const EASE_RATE: f64 = 0.012

static mut G_POS: [f64; 4] = [0.0; 4]
static mut G_VEL: [f64; 4] = [0.0; 4]
static mut G_TGT: [f64; 4] = [0.0; 4]
static mut G_HAS_TGT: [bool; 4] = [false; 4]
static mut G_MIN: [f64; 4] = [-1000000000.0; 4]
static mut G_MAX: [f64; 4] = [1000000000.0; 4]
static mut G_STOP: [f64; 4] = [0.02, 0.02, 0.02, 0.02]
static mut G_LAST_MS: f64 = 0.0

fn pos(ch: usize) -> f64 {
    return G_POS[ch]
}

fn clamp(ch: usize, v: f64) -> f64 {
    var r: f64 = v
    if r > G_MAX[ch] {
        r = G_MAX[ch]
    }
    if r < G_MIN[ch] {
        r = G_MIN[ch]
    }
    return r
}

fn set_stop(ch: usize, v: f64) {
    G_STOP[ch] = v
}

fn set_limits(ch: usize, lo: f64, hi: f64) {
    G_MIN[ch] = lo
    G_MAX[ch] = hi
    G_POS[ch] = clamp(ch, G_POS[ch])
}

fn set(ch: usize, v: f64) {
    G_POS[ch] = clamp(ch, v)
    G_VEL[ch] = 0.0
    G_HAS_TGT[ch] = false
}

fn add(ch: usize, d: f64) {
    G_HAS_TGT[ch] = false
    G_POS[ch] = clamp(ch, G_POS[ch] + d)
}

fn nudge(ch: usize, d: f64) {
    var base: f64 = G_POS[ch]
    if G_HAS_TGT[ch] {
        base = G_TGT[ch]
    }
    G_TGT[ch] = clamp(ch, base + d)
    G_HAS_TGT[ch] = true
    G_VEL[ch] = 0.0
}

fn goto(ch: usize, t: f64) {
    G_TGT[ch] = clamp(ch, t)
    G_HAS_TGT[ch] = true
    G_VEL[ch] = 0.0
}

fn fling(ch: usize, v: f64) {
    G_HAS_TGT[ch] = false
    G_VEL[ch] = v
}

fn stop(ch: usize) {
    G_VEL[ch] = 0.0
    G_HAS_TGT[ch] = false
}

fn abs(v: f64) -> f64 {
    if v < 0.0 {
        return 0.0 - v
    }
    return v
}

fn busy_ch(ch: usize) -> bool {
    return G_HAS_TGT[ch] || abs(G_VEL[ch]) > G_STOP[ch]
}

fn busy() -> bool {
    var ch: usize = 0
    while ch < CHANNELS {
        if busy_ch(ch) {
            return true
        }
        ch = ch + 1
    }
    return false
}

fn ease_step(ch: usize, dt: f64) {
    let diff: f64 = G_TGT[ch] - G_POS[ch]
    var k: f64 = EASE_RATE * dt
    if k > 0.6 {
        k = 0.6
    }
    G_POS[ch] = G_POS[ch] + diff * k
    if abs(G_TGT[ch] - G_POS[ch]) < 0.002 {
        G_POS[ch] = G_TGT[ch]
        G_HAS_TGT[ch] = false
    }
}

fn glide_step(ch: usize, dt: f64) {
    let before: f64 = G_POS[ch]
    G_POS[ch] = clamp(ch, G_POS[ch] + G_VEL[ch] * dt)
    if G_POS[ch] == before {
        G_VEL[ch] = 0.0
        return
    }
    var decay: f64 = 1.0 - FRICTION * dt
    if decay < 0.0 {
        decay = 0.0
    }
    G_VEL[ch] = G_VEL[ch] * decay
}

fn tick(ms: f64) -> bool {
    var dt: f64 = ms - G_LAST_MS
    if G_LAST_MS == 0.0 || dt > 50.0 {
        dt = 16.0
    }
    if dt < 1.0 {
        dt = 1.0
    }
    G_LAST_MS = ms
    var moved: bool = false
    var ch: usize = 0
    while ch < CHANNELS {
        if G_HAS_TGT[ch] {
            ease_step(ch, dt)
            moved = true
        } else if abs(G_VEL[ch]) > G_STOP[ch] {
            glide_step(ch, dt)
            moved = true
        } else {
            G_VEL[ch] = 0.0
        }
        ch = ch + 1
    }
    return moved
}
