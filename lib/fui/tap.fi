// SPDX-License-Identifier: MPL-2.0

export {
    Tap, tap_new, tap_down, tap_move, tap_up, tap_cancel, tap_live, tap_lost, tap_settled, tap_take_press, tap_x0, tap_y0,
    TOUCH_SLOP, MOUSE_SLOP, PRESS_DELAY_MS, LONG_PRESS_MS,
}

const TOUCH_SLOP: f64 = 8.0
const MOUSE_SLOP: f64 = 4.0
const PRESS_DELAY_MS: f64 = 90.0
const LONG_PRESS_MS: f64 = 450.0

struct Tap {
    live: bool,
    lost: bool,
    touch: bool,
    shown: bool,
    pid: u32,
    x0: f64,
    y0: f64,
    t0: f64,
}

fn tap_new() -> Tap {
    return Tap { live: false, lost: false, touch: false, shown: false, pid: 0 as u32, x0: 0.0, y0: 0.0, t0: 0.0 }
}

fn tap_live(t: *mut Tap) -> bool { return (*t).live }
fn tap_lost(t: *mut Tap) -> bool { return (*t).lost }

fn slop_of(touch: bool) -> f64 {
    if touch {
        return TOUCH_SLOP
    }
    return MOUSE_SLOP
}

fn far(t: *mut Tap, x: f64, y: f64) -> bool {
    var dx: f64 = x - (*t).x0
    var dy: f64 = y - (*t).y0
    if dx < 0.0 { dx = 0.0 - dx }
    if dy < 0.0 { dy = 0.0 - dy }
    let s: f64 = slop_of((*t).touch)
    return dx > s || dy > s
}

fn tap_down(t: *mut Tap, pid: u32, primary: bool, touch: bool, x: f64, y: f64, ms: f64) {
    if (*t).live && pid != (*t).pid {
        (*t).lost = true
        return
    }
    (*t).live = true
    (*t).lost = !primary
    (*t).touch = touch
    (*t).shown = false
    (*t).pid = pid
    (*t).x0 = x
    (*t).y0 = y
    (*t).t0 = ms
}

fn tap_move(t: *mut Tap, pid: u32, x: f64, y: f64) -> bool {
    if !(*t).live || (*t).lost || pid != (*t).pid {
        return false
    }
    if far(t, x, y) {
        (*t).lost = true
        return true
    }
    return false
}

fn tap_up(t: *mut Tap, pid: u32, x: f64, y: f64, ms: f64) -> bool {
    if !(*t).live || pid != (*t).pid {
        return false
    }
    var ok: bool = !(*t).lost && !far(t, x, y)
    if ok && (*t).touch && (*t).t0 > 0.0 && ms > 0.0 && ms - (*t).t0 > LONG_PRESS_MS {
        ok = false
    }
    (*t).live = false
    (*t).lost = false
    return ok
}

fn tap_cancel(t: *mut Tap) {
    (*t).live = false
    (*t).lost = false
}

fn tap_settled(t: *mut Tap, ms: f64) -> bool {
    if !(*t).live || (*t).lost {
        return false
    }
    if !(*t).touch {
        return true
    }
    return ms - (*t).t0 >= PRESS_DELAY_MS
}

fn tap_take_press(t: *mut Tap, ms: f64) -> bool {
    if !(*t).touch || (*t).shown || !tap_settled(t, ms) {
        return false
    }
    (*t).shown = true
    return true
}

fn tap_x0(t: *mut Tap) -> f64 { return (*t).x0 }
fn tap_y0(t: *mut Tap) -> f64 { return (*t).y0 }
