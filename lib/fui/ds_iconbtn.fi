import std.rt
import fui.ds_look
import fui.editor
import fui.kit
import fui.lucide
import fui.render
import fui.screenanim
import fui.screenax
import fui.style
import fui.widget

const NONE: usize = 18446744073709551615
const CAP: usize = 16
const TIP_CHANNEL: u32 = 931
const TIP_MS: i64 = 500

struct Btns {
    r: [f64; 64],
    glyph: [i64; 16],
    name: [u64; 16],
    name_n: [usize; 16],
    tip: [u64; 16],
    tip_n: [usize; 16],
    off: [u32; 16],
    big: [u32; 16],
    ids: [usize; 16],
    n: usize,
    foc: usize,
    kbd: bool,
    down: usize,
    fired: usize,
    px: f64,
    py: f64,
    bw: f64,
    bh: f64,
    rev: u64,
    ctx: u64,
}

fn btns_new() -> *mut Btns {
    let b: *mut Btns = rt.heap_alloc(1 << 12) as *mut Btns
    var i: usize = 0
    while i < CAP * 4 {
        (*b).r[i] = 0.0
        i = i + 1
    }
    i = 0
    while i < CAP {
        (*b).glyph[i] = 0 - 1
        (*b).name[i] = 0
        (*b).name_n[i] = 0
        (*b).tip[i] = 0
        (*b).tip_n[i] = 0
        (*b).off[i] = 0 as u32
        (*b).big[i] = 0 as u32
        (*b).ids[i] = 0
        i = i + 1
    }
    (*b).n = 0
    (*b).foc = NONE
    (*b).kbd = false
    (*b).down = NONE
    (*b).fired = NONE
    (*b).px = 0.0 - 1.0
    (*b).py = 0.0 - 1.0
    (*b).bw = 0.0
    (*b).bh = 0.0
    (*b).rev = 0
    (*b).ctx = 0
    return b
}

fn begin(b: *mut Btns, c: *mut render.Ctx, px: f64, py: f64) {
    (*b).n = 0
    (*b).px = px
    (*b).py = py
    (*b).ctx = c as u64
}

fn set_bounds(b: *mut Btns, w: f64, h: f64) {
    (*b).bw = w
    (*b).bh = h
}

fn size_of(c: *mut render.Ctx, big: bool) -> f64 {
    return ds_look.icon_button_size(c, big)
}

fn slot_of(b: *mut Btns, id: usize) -> usize {
    var i: usize = 0
    while i < (*b).n {
        if (*b).ids[i] == id { return i }
        i = i + 1
    }
    return NONE
}

fn hovered_slot(b: *mut Btns) -> usize {
    var i: usize = 0
    while i < (*b).n {
        if (*b).off[i] == 0 as u32 && at(b, i, (*b).px, (*b).py) { return i }
        i = i + 1
    }
    return NONE
}

fn at(b: *mut Btns, i: usize, x: f64, y: f64) -> bool {
    return ds_look.inside(x, y, (*b).r[i * 4], (*b).r[i * 4 + 1], (*b).r[i * 4 + 2], (*b).r[i * 4 + 3])
}

fn add_tip(b: *mut Btns, c: *mut render.Ctx, id: usize, x: f64, y: f64, glyph: i64, name: str, tip: str, big: bool, enabled: bool) -> f64 {
    let s: f64 = size_of(c, big)
    if (*b).n >= CAP { return s }
    let i: usize = (*b).n
    (*b).n = i + 1
    (*b).ids[i] = id
    (*b).r[i * 4] = x
    (*b).r[i * 4 + 1] = y
    (*b).r[i * 4 + 2] = s
    (*b).r[i * 4 + 3] = s
    (*b).glyph[i] = glyph
    (*b).name[i] = name.p as u64
    (*b).name_n[i] = name.n
    (*b).tip[i] = tip.p as u64
    (*b).tip_n[i] = tip.n
    (*b).big[i] = 0 as u32
    if big { (*b).big[i] = 1 as u32 }
    (*b).off[i] = 0 as u32
    if !enabled { (*b).off[i] = 1 as u32 }
    paint(b, c, i)
    return s
}

fn add(b: *mut Btns, c: *mut render.Ctx, id: usize, x: f64, y: f64, glyph: i64, name: str, big: bool, enabled: bool) -> f64 {
    return add_tip(b, c, id, x, y, glyph, name, name, big, enabled)
}

fn is_focus(b: *mut Btns, i: usize) -> bool {
    return (*b).foc == (*b).ids[i] && (*b).kbd
}

fn paint(b: *mut Btns, c: *mut render.Ctx, i: usize) {
    let x: f64 = (*b).r[i * 4]
    let y: f64 = (*b).r[i * 4 + 1]
    let s: f64 = (*b).r[i * 4 + 2]
    let off: bool = (*b).off[i] != 0 as u32
    let hov: bool = !off && at(b, i, (*b).px, (*b).py)
    let pressed: bool = hov && (*b).down == (*b).ids[i]
    let r: f64 = ds_look.radius_small(c)
    if pressed {
        ds_look.fill(c, x, y, s, s, r, ds_look.pressed_bg(c))
    } else {
        ds_look.overlay(c, x, y, s, s, r, ds_look.hover_bg(c), ds_look.hover_level(c, x, y, hov))
    }
    var col: u32 = ds_look.fg(c)
    if off { col = ds_look.fg_disabled(c) }
    var g: f64 = ds_look.glyph_small(c)
    if (*b).big[i] != 0 as u32 { g = ds_look.glyph_size(c) }
    ds_look.glyph(c, (*b).glyph[i], x + (s - g) / 2.0, y + (s - g) / 2.0, g, col)
    if is_focus(b, i) { ds_look.focus(c, x, y, s, s, r) }
    var st: u32 = 0 as u32
    if off { st = st | screenax.F_DISABLED }
    if is_focus(b, i) { st = st | screenax.F_FOCUS }
    screenax.note(widget.KIND_BUTTON, st, name_str(b, i), x, y, s, s, 0)
}

fn name_str(b: *mut Btns, i: usize) -> str {
    return str { p: (*b).name[i] as *mut u8, n: (*b).name_n[i] }
}

fn tip_str(b: *mut Btns, i: usize) -> str {
    if (*b).tip_n[i] == 0 { return name_str(b, i) }
    return str { p: (*b).tip[i] as *mut u8, n: (*b).tip_n[i] }
}

fn tip_slot(b: *mut Btns, c: *mut render.Ctx) -> usize {
    let h: usize = hovered_slot(b)
    if h != NONE {
        let t: f64 = screenanim.level(c, (*b).r[h * 4], (*b).r[h * 4 + 1], TIP_CHANNEL, true, TIP_MS)
        if t >= 1.0 { return h }
        return NONE
    }
    var i: usize = 0
    while i < (*b).n {
        if is_focus(b, i) && (*b).off[i] == 0 as u32 { return i }
        i = i + 1
    }
    return NONE
}

fn tip_rect(b: *mut Btns, c: *mut render.Ctx, i: usize, out: *mut [f64; 4]) {
    let t: str = tip_str(b, i)
    let w: f64 = ds_look.label_width(c, 12, 400, t) + ds_look.gap(c) * 2.0
    let h: f64 = kit.ln(c, 28)
    var x: f64 = (*b).r[i * 4] + (*b).r[i * 4 + 2] / 2.0 - w / 2.0
    var y: f64 = (*b).r[i * 4 + 1] + (*b).r[i * 4 + 3] + kit.ln(c, 6)
    if (*b).bw > 0.0 && x + w > (*b).bw { x = (*b).bw - w - kit.ln(c, 4) }
    if x < kit.ln(c, 4) { x = kit.ln(c, 4) }
    if (*b).bh > 0.0 && y + h > (*b).bh { y = (*b).r[i * 4 + 1] - h - kit.ln(c, 6) }
    (*out)[0] = x
    (*out)[1] = y
    (*out)[2] = w
    (*out)[3] = h
}

fn end(b: *mut Btns, c: *mut render.Ctx) {
    let i: usize = tip_slot(b, c)
    if i == NONE { return }
    var q: [f64; 4] = [0.0; 4]
    tip_rect(b, c, i, &q)
    let r: f64 = ds_look.radius_small(c)
    kit.soft_shadow(c, q[0], q[1], q[2], q[3], r, kit.ln(c, 10), kit.ln(c, 3), 160)
    ds_look.fill(c, q[0], q[1], q[2], q[3], r, kit.tokc(c, style.TOK_SURFACE_RAISED))
    ds_look.ring(c, q[0], q[1], q[2], q[3], r, ds_look.card_line(c))
    ds_look.label(c, q[0] + ds_look.gap(c), q[1], q[3], 12, 400, ds_look.fg(c), tip_str(b, i), q[2] - ds_look.gap(c) * 2.0)
    screenax.note(widget.KIND_TOOLTIP, 0 as u32, tip_str(b, i), q[0], q[1], q[2], q[3], 0)
}

fn tip_shown(b: *mut Btns, c: *mut render.Ctx) -> bool {
    return tip_slot(b, c) != NONE
}

fn hit(b: *mut Btns, x: f64, y: f64) -> usize {
    var i: usize = 0
    while i < (*b).n {
        if at(b, i, x, y) { return (*b).ids[i] }
        i = i + 1
    }
    return NONE
}

fn press(b: *mut Btns, x: f64, y: f64) -> usize {
    (*b).down = NONE
    (*b).kbd = false
    let id: usize = hit(b, x, y)
    if id == NONE {
        (*b).foc = NONE
        return NONE
    }
    let i: usize = slot_of(b, id)
    if (*b).off[i] != 0 as u32 { return NONE }
    (*b).foc = id
    (*b).down = id
    return id
}

fn release(b: *mut Btns, x: f64, y: f64) -> usize {
    let d: usize = (*b).down
    (*b).down = NONE
    if d == NONE { return NONE }
    if hit(b, x, y) != d { return NONE }
    (*b).rev = (*b).rev + 1
    return d
}

fn click(b: *mut Btns, x: f64, y: f64) -> usize {
    press(b, x, y)
    return release(b, x, y)
}

fn fire(b: *mut Btns) -> bool {
    if (*b).foc == NONE { return false }
    (*b).fired = (*b).foc
    (*b).rev = (*b).rev + 1
    return true
}

fn fired(b: *mut Btns) -> usize {
    let f: usize = (*b).fired
    (*b).fired = NONE
    return f
}

fn next_enabled(b: *mut Btns, from: usize, back: bool) -> usize {
    var k: usize = 0
    var i: usize = from
    while k < (*b).n {
        if back {
            if i == 0 { i = (*b).n - 1 } else { i = i - 1 }
        } else {
            i = (i + 1) % (*b).n
        }
        if (*b).off[i] == 0 as u32 { return i }
        k = k + 1
    }
    return NONE
}

fn focus_step(b: *mut Btns, back: bool) -> bool {
    if (*b).n == 0 { return false }
    var from: usize = slot_of(b, (*b).foc)
    if from == NONE {
        if back { from = 0 } else { from = (*b).n - 1 }
    }
    let to: usize = next_enabled(b, from, back)
    if to == NONE { return false }
    (*b).foc = (*b).ids[to]
    (*b).kbd = true
    return true
}

fn key(b: *mut Btns, k: u32, mods: u32) -> bool {
    if k == editor.KEY_TAB { return focus_step(b, (mods & editor.MOD_SHIFT) != 0 as u32) }
    if (*b).foc == NONE { return false }
    if k == editor.KEY_ENTER { return fire(b) }
    if k == editor.KEY_RIGHT || k == editor.KEY_DOWN { return focus_step(b, false) }
    if k == editor.KEY_LEFT || k == editor.KEY_UP { return focus_step(b, true) }
    return false
}

fn text(b: *mut Btns, cp: u32, mods: u32) -> bool {
    if cp == 32 as u32 { return fire(b) }
    return false
}

fn focus_id(b: *mut Btns) -> usize { return (*b).foc }
fn set_focus(b: *mut Btns, id: usize) {
    (*b).foc = id
    (*b).kbd = id != NONE
}
fn revision(b: *mut Btns) -> u64 { return (*b).rev }
fn rect_of(b: *mut Btns, id: usize, out: *mut [f64; 4]) -> bool {
    let i: usize = slot_of(b, id)
    if i == NONE { return false }
    (*out)[0] = (*b).r[i * 4]
    (*out)[1] = (*b).r[i * 4 + 1]
    (*out)[2] = (*b).r[i * 4 + 2]
    (*out)[3] = (*b).r[i * 4 + 3]
    return true
}

fn back_glyph() -> i64 { return lucide.ARROW_LEFT }
fn forward_glyph() -> i64 { return lucide.ARROW_RIGHT }
fn close_glyph() -> i64 { return lucide.X }
fn more_glyph() -> i64 { return ds_look.ICON_MORE }
