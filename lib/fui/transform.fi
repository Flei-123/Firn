// SPDX-License-Identifier: MPL-2.0
// lib/fui/transform.fi -- WIDGETS UNDER AN AFFINE MAPPING.
//
// ========================================================= WHY IT EXISTS
//
// A tab that turns slightly when opened; a tile that
// grows by two percent under the pointer; a whole window that
// falls into the bar when minimised -- all of that is ONE affine
// mapping over the drawing, and without it every movement stays
// a shift on whole pixels.
//
// ============================================== NO SECOND PLACE FOR MATRICES
//
// lib/svg/matrix.fi HAS the matrix arithmetic: product, inverse matrix,
// determinant, rotation about a point, skew, and sine/cosine with
// argument reduction in degrees (rotate(90) gives an exact zero there --
// exactly what an edge needs that must not stand crooked). This
// file DOES NOT CALCULATE ITSELF. It holds a stack and maps
// drawing onto it; every line of matrix arithmetic here would be the
// second version of the same thing, and that is the rule of this tree.
//
// ======================================== WHAT HAS TO BE DONE RIGHT
//
// 1. SHAPES are mapped as a PATH and rasterised afterwards -- the
//    points go through the matrix, not the finished pixel image.
//    The other way round you get staircases that no anti-aliasing can
//    remove any more, because the information is already gone.
// 2. IMAGES go the opposite way: for every TARGET PIXEL the
//    source position is looked up with the INVERSE MATRIX and sampled there BILINEARLY.
//    Mapping forwards leaves holes as soon as
//    enlarged.
// 3. THE HIT TEST. Whoever draws under a rotation and tests straight
//    clicks next to it -- visible already at five degrees. The
//    mouse point is therefore brought back with the inverse matrix into the
//    widget coordinate system and ONLY THEN checked against the
//    rectangle. `tf_hit_test` is the version of
//    `control.hit_test` for a surface under transformation; the
//    straight version in control.fi stays what it is.
// 4. TEXT is rotated as a PATH. The glyph goes outline by outline
//    through the same matrix as every other shape -- `ttf.outline_at`
//    has taken the 2x3 matrix since round BILD+SVG, and that is exactly the
//    way that lib/svg/paint.fi already goes for `<text transform=...>`. A rotated
//    section of a finished text picture would be rasterised twice
//    and visibly soft.
//
// ==================================== WHAT DELIBERATELY DOES NOT STAND HERE
//
// A SECOND HIT TEST IN control.fi. The question was pending:
// does `control.fi` get a version that takes a matrix? NO --
// and for the very reason that carries this file at all: a
// point that is brought back ONCE then runs through the
// existing search. What control.fi has had since round FEHLERBEHEBUNG
// is something different and much smaller: ONE FIELD in which the answer to
// "does this point lie on this widget" can be exchanged
// (`control.panel_set_hit`). No matrix, no second search, no
// dependency on lib/svg -- control.fi calls a function that it
// does not know. `tf_bind_panel` hangs the version with the
// inverse mapping in down here, and after that the NORMAL sequence
// (`control.mouse_down`) hits the rotated widget.
//
// Whoever prefers to convert himself can still do so:
//
//     control.mouse_move(&pn, tf_local_x(&xf, mx, my),
//                             tf_local_y(&xf, mx, my))
//
// For that `tf_local_x`/`tf_local_y` stand here (the same calculation as
// `xf_inv_x`/`xf_inv_y`, under the name under which a caller looks for it).
//
// A SECOND BILINEAR SAMPLING. It once stood here, with the
// remark that the one in `uiimage.fi` is file-local. That is fixed: there
// it is exported, here only `tf_sample_bilinear` stands as
// the name under which the transformation path calls it -- four lines
// that catch the empty image and pass it on. One calculation, one
// place.
import std.rt
import paint.canvas
import font.raster
import font.ttf
import font.metrics
import svg.matrix
import fui.painter
import fui.widget
import fui.control
import fui.uiimage
import fui.gpu

export {
    Xform, xf_new, xf_reset, xf_mat, xf_set,
    xf_push, xf_pop, xf_depth,
    xf_translate, xf_scale, xf_rotate, xf_rotate_at, xf_skew,
    xf_apply, xf_point_x, xf_point_y, xf_inv_x, xf_inv_y,
    xf_scale_hint,
    XF_MAX,
    // Zeichnen
    tf_fill_round_rect, tf_fill_quad, tf_draw_image,
    tf_draw_image_tinted, tf_text,
    tf_sample_bilinear,
    // Treffer
    tf_hit_rect, tf_hit_widget, tf_hit_test,
    tf_local_x, tf_local_y,
    XfBind, xfbind_new, tf_bind_panel, tf_unbind_panel, tf_panel_hit,
}

// How deep the stack goes. Fixed, because fUi must be able to run without an allocator;
// 16 is the same depth that lib/paint/canvas.fi chooses for
// the clip stack, and for the same reason.
const XF_MAX: usize = 16

struct Xform {
    m: [matrix.Mat; 16],
    n: usize, // Tiefe: n-1 ist die oberste, gueltige Matrix
}

fn xf_new() -> Xform {
    var x: Xform = Xform { m: [matrix.mat_one(); 16], n: 1 }
    return x
}

fn xf_reset(x: *mut Xform) {
    (*x).n = 1
    (*x).m[0] = matrix.mat_one()
}

fn xf_depth(x: *mut Xform) -> usize { return (*x).n }

fn xf_mat(x: *mut Xform) -> matrix.Mat {
    return (*x).m[(*x).n - 1]
}

fn xf_set(x: *mut Xform, m: matrix.Mat) {
    (*x).m[(*x).n - 1] = m
}

// Save the current state. `false` means: the stack is full --
// that is visible and honest, and better than an allocation in the middle
// of drawing.
fn xf_push(x: *mut Xform) -> bool {
    if (*x).n >= XF_MAX {
        return false
    }
    (*x).m[(*x).n] = (*x).m[(*x).n - 1]
    (*x).n = (*x).n + 1
    return true
}

fn xf_pop(x: *mut Xform) {
    if (*x).n > 1 {
        (*x).n = (*x).n - 1
    }
}

// CONCATENATE. The new mapping comes on the RIGHT of the existing one: whoever
// first rotates and then shifts shifts in the rotated system --
// the same order as `transform: rotate(...) translate(...)` in
// CSS and as in SVG.
fn xf_apply(x: *mut Xform, m: matrix.Mat) {
    (*x).m[(*x).n - 1] = matrix.mat_mal((*x).m[(*x).n - 1], m)
}

fn xf_translate(x: *mut Xform, tx: f64, ty: f64) {
    xf_apply(x, matrix.mat_verschiebe(tx, ty))
}

fn xf_scale(x: *mut Xform, sx: f64, sy: f64, ox: f64, oy: f64) {
    xf_apply(x, matrix.mat_verschiebe(ox, oy))
    xf_apply(x, matrix.mat_scale(sx, sy))
    xf_apply(x, matrix.mat_verschiebe(0.0 - ox, 0.0 - oy))
}

fn xf_rotate(x: *mut Xform, grad: f64) {
    xf_apply(x, matrix.mat_rotate(grad))
}

// About a freely selectable origin -- that is the normal case in a
// surface: rotation is about the CENTRE of the widget and not about the
// corner of the canvas.
fn xf_rotate_at(x: *mut Xform, grad: f64, cx: f64, cy: f64) {
    xf_apply(x, matrix.mat_rotate_around(grad, cx, cy))
}

fn xf_skew(x: *mut Xform, gx: f64, gy: f64, ox: f64, oy: f64) {
    xf_apply(x, matrix.mat_verschiebe(ox, oy))
    if gx != 0.0 {
        xf_apply(x, matrix.mat_neige_x(gx))
    }
    if gy != 0.0 {
        xf_apply(x, matrix.mat_neige_y(gy))
    }
    xf_apply(x, matrix.mat_verschiebe(0.0 - ox, 0.0 - oy))
}

fn xf_point_x(x: *mut Xform, px: f64, py: f64) -> f64 {
    return matrix.mat_x(xf_mat(x), px, py)
}

fn xf_point_y(x: *mut Xform, px: f64, py: f64) -> f64 {
    return matrix.mat_y(xf_mat(x), px, py)
}

// The point BACK in the widget system. For a degenerate matrix
// (scaling 0) the point itself comes back; you cannot hit anything there
// anyway, because nothing is to be seen.
fn xf_inv_x(x: *mut Xform, px: f64, py: f64) -> f64 {
    var ok: bool = false
    let k: matrix.Mat = matrix.mat_kehr(xf_mat(x), &ok)
    if !ok {
        return px
    }
    return matrix.mat_x(k, px, py)
}

fn xf_inv_y(x: *mut Xform, px: f64, py: f64) -> f64 {
    var ok: bool = false
    let k: matrix.Mat = matrix.mat_kehr(xf_mat(x), &ok)
    if !ok {
        return py
    }
    return matrix.mat_y(k, px, py)
}

// How strongly the mapping enlarges on average. Whoever wants to let a
// stroke width or a radius grow along needs it --
// `mat_laengenmass` from lib/svg/matrix.fi is exactly this number.
fn xf_scale_hint(x: *mut Xform) -> f64 {
    return matrix.mat_laengenmass(xf_mat(x))
}

// ======================================================= DRAWING SHAPES
//
// A raster buffer of its own, because the buffer of the painter is laid out
// for the STRAIGHT size of a widget -- a rotated rectangle
// needs the bounding box of the rotated corners, and that is larger.
struct Window {
    ra: raster.Raster,
    buf: *mut u8,
    n: usize,
    ox: i64,
    oy: i64,
    ok: bool,
}

fn window_open(x0: f64, y0: f64, x1: f64, y1: f64) -> Window {
    var f: Window = Window { ra: raster.raster_new(), buf: 0 as *mut u8,
        n: 0, ox: 0, oy: 0, ok: false }
    var ax: i64 = (matrix.m_floor(x0) as i64) - 1
    var ay: i64 = (matrix.m_floor(y0) as i64) - 1
    if ax < 0 { ax = 0 }
    if ay < 0 { ay = 0 }
    let bx: i64 = (matrix.m_ceil(x1) as i64) + 1
    let by: i64 = (matrix.m_ceil(y1) as i64) + 1
    let w: i64 = bx - ax
    let h: i64 = by - ay
    if w <= 0 || h <= 0 {
        return f
    }
    let n: usize = raster.raster_bytes_needed(w as usize, h as usize)
    f.buf = rt.heap_alloc(n) as *mut u8
    if f.buf as usize == 0 {
        return f
    }
    f.n = n
    raster.raster_attach(&f.ra, f.buf, n)
    raster.raster_begin(&f.ra, ax as f64, ay as f64, w as usize, h as usize)
    f.ox = ax
    f.oy = ay
    f.ok = true
    return f
}

fn window_close(f: *mut Window) {
    if (*f).buf as usize != 0 {
        rt.heap_free((*f).buf as u64, (*f).n)
        (*f).buf = 0 as *mut u8
    }
}

fn less(a: f64, b: f64) -> f64 {
    if a < b {
        return a
    }
    return b
}

fn greater(a: f64, b: f64) -> f64 {
    if a > b {
        return a
    }
    return b
}

// A quadrilateral whose four corners already stand in the screen system.
// Every mapped shape comes down to this.
fn tf_fill_quad(z: *mut painter.Painter, x0: f64, y0: f64, x1: f64,
    y1: f64, x2: f64, y2: f64, x3: f64, y3: f64, col: u32) {
    let lx: f64 = less(less(x0, x1), less(x2, x3))
    let ly: f64 = less(less(y0, y1), less(y2, y3))
    let hx: f64 = greater(greater(x0, x1), greater(x2, x3))
    let hy: f64 = greater(greater(y0, y1), greater(y2, y3))
    var f: Window = window_open(lx, ly, hx, hy)
    if !f.ok {
        return
    }
    raster.raster_line(&f.ra, x0, y0, x1, y1)
    raster.raster_line(&f.ra, x1, y1, x2, y2)
    raster.raster_line(&f.ra, x2, y2, x3, y3)
    raster.raster_line(&f.ra, x3, y3, x0, y0)
    raster.raster_finish(&f.ra)
    painter.painter_fill_raster(z, &f.ra,
        f.ox as usize, f.oy as usize, col)
    window_close(&f)
}

// A rounded rectangle under the mapping. The corners are the
// known cubics with the factor 0.5523 (the same as in
// painter.path_round -- the number is that of the quarter circle and not
// a second opinion), and EVERY control point goes individually through the
// matrix. That is why the rounding stays a rounding under a rotation
// and does not become an ellipse from a rotated pixel image.
fn tf_fill_round_rect(z: *mut painter.Painter, xf: *mut Xform, x: f64,
    y: f64, w: f64, h: f64, r0: f64, col: u32) {
    if w <= 0.0 || h <= 0.0 {
        return
    }
    let m: matrix.Mat = xf_mat(xf)
    var r: f64 = r0
    var kl: f64 = w
    if h < kl {
        kl = h
    }
    if r > kl / 2.0 {
        r = kl / 2.0
    }
    if r < 0.0 {
        r = 0.0
    }
    if r == 0.0 {
        tf_fill_quad(z,
            matrix.mat_x(m, x, y), matrix.mat_y(m, x, y),
            matrix.mat_x(m, x + w, y), matrix.mat_y(m, x + w, y),
            matrix.mat_x(m, x + w, y + h), matrix.mat_y(m, x + w, y + h),
            matrix.mat_x(m, x, y + h), matrix.mat_y(m, x, y + h), col)
        return
    }
    // The bounding box of the four mapped corners.
    let ex0: f64 = matrix.mat_x(m, x, y)
    let ey0: f64 = matrix.mat_y(m, x, y)
    let ex1: f64 = matrix.mat_x(m, x + w, y)
    let ey1: f64 = matrix.mat_y(m, x + w, y)
    let ex2: f64 = matrix.mat_x(m, x + w, y + h)
    let ey2: f64 = matrix.mat_y(m, x + w, y + h)
    let ex3: f64 = matrix.mat_x(m, x, y + h)
    let ey3: f64 = matrix.mat_y(m, x, y + h)
    var f: Window = window_open(
        less(less(ex0, ex1), less(ex2, ex3)),
        less(less(ey0, ey1), less(ey2, ey3)),
        greater(greater(ex0, ex1), greater(ex2, ex3)),
        greater(greater(ey0, ey1), greater(ey2, ey3)))
    if !f.ok {
        return
    }
    let k: f64 = r * 0.5522847498307933
    let x1: f64 = x + w
    let y1: f64 = y + h
    // top, clockwise -- the same direction of travel as painter.path_round
    lin(&f.ra, m, x + r, y, x1 - r, y)
    kub(&f.ra, m, x1 - r, y, x1 - r + k, y, x1, y + r - k, x1, y + r)
    lin(&f.ra, m, x1, y + r, x1, y1 - r)
    kub(&f.ra, m, x1, y1 - r, x1, y1 - r + k, x1 - r + k, y1, x1 - r, y1)
    lin(&f.ra, m, x1 - r, y1, x + r, y1)
    kub(&f.ra, m, x + r, y1, x + r - k, y1, x, y1 - r + k, x, y1 - r)
    lin(&f.ra, m, x, y1 - r, x, y + r)
    kub(&f.ra, m, x, y + r, x, y + r - k, x + r - k, y, x + r, y)
    raster.raster_finish(&f.ra)
    painter.painter_fill_raster(z, &f.ra,
        f.ox as usize, f.oy as usize, col)
    window_close(&f)
}

fn lin(ra: *mut raster.Raster, m: matrix.Mat, ax: f64, ay: f64, bx: f64,
    by: f64) {
    raster.raster_line(ra, matrix.mat_x(m, ax, ay), matrix.mat_y(m, ax, ay),
        matrix.mat_x(m, bx, by), matrix.mat_y(m, bx, by))
}

fn kub(ra: *mut raster.Raster, m: matrix.Mat, ax: f64, ay: f64, bx: f64,
    by: f64, cx: f64, cy: f64, dx: f64, dy: f64) {
    raster.raster_cubic(ra,
        matrix.mat_x(m, ax, ay), matrix.mat_y(m, ax, ay),
        matrix.mat_x(m, bx, by), matrix.mat_y(m, bx, by),
        matrix.mat_x(m, cx, cy), matrix.mat_y(m, cx, cy),
        matrix.mat_x(m, dx, dy), matrix.mat_y(m, dx, dy))
}

// ======================================================= DRAWING IMAGES
//
// Backwards: run over the target pixels, put each one back into the
// image with the inverse matrix, sample there BILINEARLY. Whoever maps
// forwards sprays holes when enlarging and, when shrinking,
// hits the same place twice.
// THE TINT STANDS NEXT TO IT, NOT UNDER IT. A symbol of this
// library is a mask: the SHAPE comes from the image, the COLOUR
// from the theme (the reason stands at `uiimage.image_draw`). A
// rotated symbol without a tint would therefore be invisible in the light scheme.
// But it is not calculated twice: `tf_draw_image`
// is exactly this call with tint 0, and the loop stands
// ONCE.
fn tf_draw_image(z: *mut painter.Painter, xf: *mut Xform,
    b: *mut uiimage.Image, x: f64, y: f64, w: f64, h: f64,
    alpha: f64) {
    tf_draw_image_tinted(z, xf, b, x, y, w, h, alpha, 0 as u32)
}

fn tf_draw_image_tinted(z: *mut painter.Painter, xf: *mut Xform,
    b: *mut uiimage.Image, x: f64, y: f64, w: f64, h: f64, alpha: f64,
    tint: u32) {
    if !uiimage.image_ok(b) || w <= 0.0 || h <= 0.0 {
        return
    }
    let m: matrix.Mat = xf_mat(xf)
    var ok: bool = false
    let inv: matrix.Mat = matrix.mat_kehr(m, &ok)
    if !ok {
        return
    }
    let cv: *mut canvas.Canvas = painter.painter_canvas(z)
    let cw: i64 = canvas.canvas_width(cv) as i64
    let ch: i64 = canvas.canvas_height(cv) as i64
    let e0x: f64 = matrix.mat_x(m, x, y)
    let e0y: f64 = matrix.mat_y(m, x, y)
    let e1x: f64 = matrix.mat_x(m, x + w, y)
    let e1y: f64 = matrix.mat_y(m, x + w, y)
    let e2x: f64 = matrix.mat_x(m, x + w, y + h)
    let e2y: f64 = matrix.mat_y(m, x + w, y + h)
    let e3x: f64 = matrix.mat_x(m, x, y + h)
    let e3y: f64 = matrix.mat_y(m, x, y + h)
    var px0: i64 = matrix.m_floor(less(less(e0x, e1x), less(e2x, e3x))) as i64
    var py0: i64 = matrix.m_floor(less(less(e0y, e1y), less(e2y, e3y))) as i64
    let px1: i64 = (matrix.m_ceil(greater(greater(e0x, e1x), greater(e2x, e3x))) as i64) + 1
    let py1: i64 = (matrix.m_ceil(greater(greater(e0y, e1y), greater(e2y, e3y))) as i64) + 1
    if px0 < 0 { px0 = 0 }
    if py0 < 0 { py0 = 0 }
    // ON THE GPU (lib/fui/gpu.fi): the picture is sampled per target pixel
    // here, so its band is read back, drawn in memory by the loop below
    // and put back -- the same pixels, one read-back slower
    let gg: *mut gpu.Gpu = gpu.gpu_of(cv)
    if gg as u64 != 0 {
        var qx1: i64 = px1
        var qy1: i64 = py1
        if qx1 > cw { qx1 = cw }
        if qy1 > ch { qy1 = ch }
        if qx1 > px0 && qy1 > py0 {
            gpu.gpu_sw_begin(gg, cv, px0 as i32, py0 as i32, qx1 as i32, qy1 as i32)
            tf_draw_image_tinted(z, xf, b, x, y, w, h, alpha, tint)
            gpu.gpu_sw_end(gg, cv, px0 as i32, py0 as i32, qx1 as i32, qy1 as i32)
        }
        return
    }
    let bw: f64 = uiimage.image_w(b) as f64
    let bh: f64 = uiimage.image_h(b) as f64
    // HOW WIDE IS THE EDGE IN TARGET PIXELS. The coordinate `u` of the
    // image is a linear field over the canvas; its slope
    // stands in the FIRST ROW of the inverse matrix, that of `v` in the
    // second. The reciprocal of the magnitude is the distance in target pixels
    // that one unit in the image needs -- and thereby exactly the width
    // over which the opacity must run from 0 to 1. Without this
    // calculation the edge is a hard comparison and the rotated
    // image has the staircases because of which the file maps
    // backwards at all.
    let gx: f64 = matrix.m_sqrt(matrix.mat_get(inv, 0) * matrix.mat_get(inv, 0)
        +matrix.mat_get(inv, 2) * matrix.mat_get(inv, 2))
    let gy: f64 = matrix.m_sqrt(matrix.mat_get(inv, 1) * matrix.mat_get(inv, 1)
        +matrix.mat_get(inv, 3) * matrix.mat_get(inv, 3))
    if gx <= 0.0 || gy <= 0.0 {
        return
    }
    var py: i64 = py0
    while py < py1 && py < ch {
        var px: i64 = px0
        while px < px1 && px < cw {
            // Put the centre of the target pixel back.
            let sx: f64 = matrix.mat_x(inv, (px as f64) + 0.5, (py as f64) + 0.5)
            let sy: f64 = matrix.mat_y(inv, (px as f64) + 0.5, (py as f64) + 0.5)
            // The smallest distance to the four edges, in TARGET PIXELS.
            var d: f64 = (sx - x) / gx
            d = less(d, (x + w - sx) / gx)
            d = less(d, (sy - y) / gy)
            d = less(d, (y + h - sy) / gy)
            var coverage: f64 = d + 0.5
            if coverage > 1.0 { coverage = 1.0 }
            if coverage > 0.0 {
                // in image coordinates; `tf_sample_bilinear` continues
                // the edge, so the position may lie just outside
                // (that is half the pixel width of the edge).
                let u: f64 = (sx - x) / w * bw - 0.5
                let v: f64 = (sy - y) / h * bh - 0.5
                let c: u32 = tf_sample_bilinear(b, u, v)
                let a: f64 = (((c >> 24) & 255 as u32) as f64) / 255.0 *
                alpha * coverage
                if a > 0.0 {
                    // With a tint only the opacity of the image
                    // counts; the colour comes from the caller.
                    var col: u32 = (255 as u32 << 24)
                    | (c & 16777215 as u32)
                    if tint != 0 as u32 {
                        col = (255 as u32 << 24) | (tint & 16777215 as u32)
                    }
                    canvas.canvas_blend(cv, px as usize, py as usize,
                        col, a)
                }
            }
            px = px + 1
        }
        py = py + 1
    }
}

// BILINEAR SAMPLING -- ONE NAME FOR ONE CALCULATION.
//
// Until round FEHLERBEHEBUNG there stood here a second, complete
// bilinear sampling, with the reason that the one in `uiimage.fi` is
// file-local. That was an excuse: not exporting a function
// is no reason to write down its calculation again -- it is
// the reason to export it. `uiimage.sample_bilinear` already calculates
// ALPHA-WEIGHTED (without that the edge of an image
// with transparency gets a grey fringe, because an invisible black
// neighbour position is averaged in) and continues the edge. So this file calls
// it and keeps only the name under which a
// caller from the transformation path looks for it.
//
// THE COORDINATE CONVENTION IS THE SAME IN BOTH: `u`/`v` count in
// PIXEL CENTRES, (0,0) is the centre of the top left pixel --
// exactly what `tf_draw_image` produces with its `- 0.5`. That is why
// the point goes on unchanged; the empty image size is caught here,
// because an image without pixels in the sampling would otherwise clamp onto
// its own edge.
fn tf_sample_bilinear(b: *mut uiimage.Image, u: f64, v: f64) -> u32 {
    if uiimage.image_w(b) == 0 || uiimage.image_h(b) == 0 {
        return 0 as u32
    }
    return uiimage.sample_bilinear(b, u, v)
}

// ======================================================== DRAWING TEXT
//
// THE BASELINE ROTATES ALONG. Every glyph goes as an OUTLINE through
// the same matrix as every other shape: `ttf.outline_at` takes the
// 2x3 matrix (that is why it is exported there -- lib/svg/paint.fi
// draws `<text transform=...>` in just the same way), the outlines are rasterised
// in target pixels and filled ONCE. Rotating a finished text picture
// afterwards would mean rasterising twice, and you see that
// at once: soft, ragged letters.
//
// Measuring is done as with straight text -- `painter.text_width` and
// `painter.text_fits_upto`, so that the alignment and the cutting off
// use the same numbers as everywhere else and no second
// opinion arises. Returned is the END of the text in the
// coordinates of the caller (not on the screen), so what
// `painter.text` also delivers in its system.
const TF_SCRATCH: usize = 65536

fn tf_text(z: *mut painter.Painter, xf: *mut Xform, x: f64, base_y: f64,
    w: f64, size: f64, col: u32, p: u64, n: usize, align: u32) -> f64 {
    if n == 0 || size <= 0.0 || w <= 0.0 {
        return x
    }
    let fm: u64 = painter.painter_font(z)
    if !metrics.fm_present(fm) {
        return x
    }
    let m: matrix.Mat = xf_mat(xf)
    if matrix.mat_determinante(m) == 0.0 {
        return x
    }
    // How much fits, and how wide is it? The same measurement as straight.
    let cnt: usize = painter.text_fits_upto(z, p, n, size, w)
    if cnt == 0 {
        return x
    }
    let br: f64 = painter.text_width(z, p, cnt, size)
    var sx: f64 = x
    if align == painter.TEXT_M {
        sx = x + (w - br) / 2.0
    }
    if align == painter.TEXT_R {
        sx = x + w - br
    }
    // The bounding box in the system of the caller: the text stands from
    // (baseline - ascent) to (baseline + descent). One point of
    // extra, because the outline of a glyph may protrude beyond the
    // metric.
    let asc: f64 = painter.font_ascent(z, size)
    let dsc: f64 = painter.font_descent(z, size)
    let lx0: f64 = sx - 1.0
    let ly0: f64 = base_y - asc - 1.0
    let lx1: f64 = sx + br + 1.0
    let ly1: f64 = base_y + dsc + 1.0
    let e0x: f64 = matrix.mat_x(m, lx0, ly0)
    let e0y: f64 = matrix.mat_y(m, lx0, ly0)
    let e1x: f64 = matrix.mat_x(m, lx1, ly0)
    let e1y: f64 = matrix.mat_y(m, lx1, ly0)
    let e2x: f64 = matrix.mat_x(m, lx1, ly1)
    let e2y: f64 = matrix.mat_y(m, lx1, ly1)
    let e3x: f64 = matrix.mat_x(m, lx0, ly1)
    let e3y: f64 = matrix.mat_y(m, lx0, ly1)
    var f: Window = window_open(
        less(less(e0x, e1x), less(e2x, e3x)),
        less(less(e0y, e1y), less(e2y, e3y)),
        greater(greater(e0x, e1x), greater(e2x, e3x)),
        greater(greater(e0y, e1y), greater(e2y, e3y)))
    if !f.ok {
        return sx + br
    }
    let sc: *mut u8 = rt.heap_alloc(TF_SCRATCH) as *mut u8
    if sc as usize == 0 {
        window_close(&f)
        return sx + br
    }
    let fnt: *mut ttf.Font = metrics.fontset_font(fm)
    let up: f64 = metrics.fm_upem(fm)
    let gsc: f64 = size / up
    // THE MATRIX IN THE FONT SYSTEM. The y axis of a font points
    // UP, that of the screen down; `ttf.devy` therefore subtracts the
    // result. A point (px,py) of the glyph thus stands at the
    // caller at (gsc*px, -gsc*py) next to the pen, and from that
    // becomes, with the linear part (a,b,c,d) of the matrix:
    //
    //     screen-x = a*gsc*px - c*gsc*py   -> m00 = a, m10 = -c
    //     screen-y = b*gsc*px - d*gsc*py   -> m01 = -b, m11 = d
    //
    // (m01/m11 with a reversed sign, because devy subtracts.)
    let m00: f64 = matrix.mat_get(m, 0)
    let m01: f64 = 0.0 - matrix.mat_get(m, 1)
    let m10: f64 = 0.0 - matrix.mat_get(m, 2)
    let m11: f64 = matrix.mat_get(m, 3)
    var pen: f64 = sx
    var i: usize = 0
    while i < cnt {
        var adv: usize = 1
        let cp: u32 = utf8_bei(p, cnt, i, &adv)
        let gid: u32 = ttf.font_glyph_for(fnt, cp)
        let okg: bool = ttf.outline_at(fnt, gid, &f.ra,
            matrix.mat_x(m, pen, base_y), matrix.mat_y(m, pen, base_y),
            gsc, m00, m01, m10, m11, 0.0, 0.0, sc, TF_SCRATCH, 0)
        var step: f64 = metrics.fm_advance(fm, size, cp)
        let nx: usize = i + adv
        if nx < cnt {
            var adv2: usize = 1
            let cp2: u32 = utf8_bei(p, cnt, nx, &adv2)
            step = step + metrics.fm_kern(fm, size, cp, cp2)
        }
        pen = pen + step
        i = i + adv
    }
    raster.raster_finish(&f.ra)
    painter.painter_fill_raster(z, &f.ra,
        f.ox as usize, f.oy as usize, col)
    rt.heap_free(sc as u64, TF_SCRATCH)
    window_close(&f)
    return sx + br
}

// A CHARACTER FROM UTF-8. lib/fui/painter.fi has the same rule of three,
// but FILE-LOCAL -- it is not exported there, and painter.fi
// does not belong to this file. The glyph run here needs no more than the length and the
// code point.
fn utf8_bei(p: u64, n: usize, i: usize, adv: *mut usize) -> u32 {
    let c0: u32 = rt.ld8(p, i) as u32
    if c0 < 128 as u32 {
        *adv = 1
        return c0
    }
    if c0 >= 240 as u32 && i + 3 < n {
        *adv = 4
        return ((c0 & 7 as u32) << 18)
        | (((rt.ld8(p, i + 1) as u32) & 63 as u32) << 12)
        | (((rt.ld8(p, i + 2) as u32) & 63 as u32) << 6)
        | ((rt.ld8(p, i + 3) as u32) & 63 as u32)
    }
    if c0 >= 224 as u32 && i + 2 < n {
        *adv = 3
        return ((c0 & 15 as u32) << 12)
        | (((rt.ld8(p, i + 1) as u32) & 63 as u32) << 6)
        | ((rt.ld8(p, i + 2) as u32) & 63 as u32)
    }
    if c0 >= 192 as u32 && i + 1 < n {
        *adv = 2
        return ((c0 & 31 as u32) << 6)
        | ((rt.ld8(p, i + 1) as u32) & 63 as u32)
    }
    *adv = 1
    return c0
}

// ========================================================= THE HITS
//
// The point comes from the screen system and is brought back with the
// inverse matrix into the system in which the rectangle stands.
fn tf_hit_rect(xf: *mut Xform, x: f64, y: f64, w: f64, h: f64, mx: f64,
    my: f64) -> bool {
    var ok: bool = false
    let k: matrix.Mat = matrix.mat_kehr(xf_mat(xf), &ok)
    if !ok {
        return false
    }
    let lx: f64 = matrix.mat_x(k, mx, my)
    let ly: f64 = matrix.mat_y(k, mx, my)
    return lx >= x && lx < x + w && ly >= y && ly < y + h
}

// THE MOUSE POINT IN THE SYSTEM OF THE CALLER. With that every existing
// event of control.fi keeps running unchanged -- see the head of this
// file. With a degenerate matrix the point itself comes back; there
// is nothing to be seen anyway and `tf_hit_rect` says no.
fn tf_local_x(xf: *mut Xform, mx: f64, my: f64) -> f64 {
    return xf_inv_x(xf, mx, my)
}

fn tf_local_y(xf: *mut Xform, mx: f64, my: f64) -> f64 {
    return xf_inv_y(xf, mx, my)
}

fn tf_hit_widget(xf: *mut Xform, e: *mut widget.Widget, mx: f64,
    my: f64) -> bool {
    // Disabled means not hit -- the same rule as in
    // `widget.w_hits`, and it must not disappear under a rotation,
    // otherwise a grey widget swallows clicks.
    if widget.w_is_disabled(e) {
        return false
    }
    return tf_hit_rect(xf, widget.w_x(e), widget.w_y(e), widget.w_w(e),
        widget.w_h(e), mx, my)
}

// ============================ THE MAPPING IN THE POINTER PATH OF control.fi
//
// Until round FEHLERBEHEBUNG `tf_hit_widget` was a function that
// a user had to call HIMSELF -- and whoever forgot that clicked
// next to his rotated widget without anything knowing about it. That
// is exactly the kind of error that this library set out against:
// calculated correctly, connected nowhere.
//
// Now the calculation hangs IN the normal sequence. `control.Panel` has carried,
// since the same round, an exchangeable answer to the question "does
// this point lie on this widget"; `tf_bind_panel` hangs the version
// with the inverse mapping in there, and after that
// `control.mouse_move`, `mouse_down` and `mouse_up` hit the rotated
// widget by themselves.
//
// NO SECOND PLACE: control.fi gets NO matrix and no second
// search -- it only calls a function that it does not know. The
// inverse mapping still stands exactly once, namely in
// `tf_hit_rect`.
//
// `e` is the widget FOR WHICH the mapping applies. 0 means: for all
// -- that is the case in which the whole surface lies under a
// mapping (a scaled window). All others get the straight
// rectangle, because a rotation that concerns only one tile
// must not shift the neighbours.
struct XfBind {
    xf: u64, // *mut Xform -- gehoert dem Aufrufer
    e: u64, // *mut widget.Widget, oder 0 fuer "alle"
}

fn xfbind_new(xf: *mut Xform, e: u64) -> XfBind {
    return XfBind { xf: xf as u64, e: e }
}

fn tf_panel_hit(zx: u64, e: *mut widget.Widget, mx: f64, my: f64) -> bool {
    if zx == 0 {
        return widget.w_hits(e, mx, my)
    }
    let b: *mut XfBind = zx as *mut XfBind
    if (*b).e != 0 && (*b).e != (e as u64) {
        return widget.w_hits(e, mx, my)
    }
    return tf_hit_widget((*b).xf as *mut Xform, e, mx, my)
}

fn tf_bind_panel(s: *mut control.Panel, b: *mut XfBind) {
    control.panel_set_hit(s, b as u64, tf_panel_hit)
}

// Back to the straight rectangle again. Stands here and not only in
// control.fi, so that a caller finds registering and deregistering side by side.
fn tf_unbind_panel(s: *mut control.Panel) {
    control.panel_clear_hit(s)
}

// The version of `control.hit_test` for a surface under a
// mapping: ONE point is brought back, after that exactly the
// existing search runs. So there is still only ONE hit test --
// here stands only the conversion in front of it.
fn tf_hit_test(s: *mut control.Panel, xf: *mut Xform, mx: f64,
    my: f64) -> usize {
    var ok: bool = false
    let k: matrix.Mat = matrix.mat_kehr(xf_mat(xf), &ok)
    if !ok {
        return control.NOBODY
    }
    return control.hit_test(s, matrix.mat_x(k, mx, my),
        matrix.mat_y(k, mx, my))
}
