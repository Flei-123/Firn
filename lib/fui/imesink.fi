// SPDX-License-Identifier: MPL-2.0
export {
    ImeSink, imesink_new, imesink_set, imesink_on, imesink_active, imesink_id,
    imesink_pre, imesink_commit, imesink_end, imesink_spot,
}

struct ImeSink {
    on: bool,
    ud: u64,
    active: fn(u64) -> bool,
    pre: fn(u64, u64, usize, usize) -> bool,
    commit: fn(u64, u64, usize) -> bool,
    end: fn(u64),
    spot: fn(u64, *mut [f64; 3]) -> bool,
}

fn active_none(ud: u64) -> bool { return false }
fn pre_none(ud: u64, p: u64, n: usize, caret: usize) -> bool { return false }
fn commit_none(ud: u64, p: u64, n: usize) -> bool { return false }
fn end_none(ud: u64) {}
fn spot_none(ud: u64, out: *mut [f64; 3]) -> bool { return false }

fn imesink_new() -> ImeSink {
    return ImeSink { on: false, ud: 0, active: active_none, pre: pre_none, commit: commit_none,
        end: end_none, spot: spot_none }
}

fn imesink_set(s: *mut ImeSink, ud: u64, active: fn(u64) -> bool, pre: fn(u64, u64, usize, usize) -> bool,
    commit: fn(u64, u64, usize) -> bool, end: fn(u64), spot: fn(u64, *mut [f64; 3]) -> bool) {
    (*s).ud = ud
    (*s).active = active
    (*s).pre = pre
    (*s).commit = commit
    (*s).end = end
    (*s).spot = spot
    (*s).on = true
}

fn imesink_on(s: *mut ImeSink) -> bool { return (*s).on }

fn imesink_active(s: *mut ImeSink) -> bool {
    if !(*s).on {
        return false
    }
    let f: fn(u64) -> bool = (*s).active
    return f((*s).ud)
}

fn imesink_id(s: *mut ImeSink) -> u64 { return (*s).ud }

fn imesink_pre(s: *mut ImeSink, p: u64, n: usize, caret: usize) -> bool {
    let f: fn(u64, u64, usize, usize) -> bool = (*s).pre
    return f((*s).ud, p, n, caret)
}

fn imesink_commit(s: *mut ImeSink, p: u64, n: usize) -> bool {
    let f: fn(u64, u64, usize) -> bool = (*s).commit
    return f((*s).ud, p, n)
}

fn imesink_end(s: *mut ImeSink) {
    let f: fn(u64) = (*s).end
    f((*s).ud)
}

fn imesink_spot(s: *mut ImeSink, out: *mut [f64; 3]) -> bool {
    let f: fn(u64, *mut [f64; 3]) -> bool = (*s).spot
    return f((*s).ud, out)
}
