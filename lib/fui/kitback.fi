// lib/fui/kitback.fi -- the back control of a narrow (phone) layout: list -> detail and back.
//
//   chevron_draw   the "<" mark centred in a row of height h at x
//   bar_draw       a top bar: chevron + label (the list the detail came from)
//   bar_hit        is (x, y) on the back control of a bar at (x0, y0)
import fui.icons
import fui.kit
import fui.lucide
import fui.painter
import fui.render
import fui.screenax
import fui.style
import fui.widget

fn bar_height(c: *mut render.Ctx) -> f64 {
    return kit.ln(c, 44)
}

fn reach(c: *mut render.Ctx) -> f64 {
    return kit.ln(c, 132)
}

fn chevron_draw(c: *mut render.Ctx, x: f64, y: f64, h: f64, col: u32) {
    let s: f64 = kit.ln(c, 22)
    icons.icon_pt(c, lucide.CHEVRON_LEFT, x, y + (h - s) / 2.0, s, col)
}

fn bar_hit(c: *mut render.Ctx, x0: f64, y0: f64, x: f64, y: f64) -> bool {
    return x >= x0 && x < x0 + reach(c) && y >= y0 && y < y0 + bar_height(c)
}

fn bar_draw(c: *mut render.Ctx, label: str, hover: bool, x0: f64, y0: f64, w: f64) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let h: f64 = bar_height(c)
    painter.surface(z, x0, y0, w, h, kit.tokc(c, style.TOK_SURFACE))
    painter.surface(z, x0, y0 + h - kit.ln(c, 1), w, kit.ln(c, 1), kit.tokc(c, style.TOK_SEPARATOR))
    screenax.note(widget.KIND_BUTTON, 0 as u32, label, x0, y0, reach(c), h, 0)
    var tok: u32 = style.TOK_TEXT_MUTED
    if hover { tok = style.TOK_TEXT }
    chevron_draw(c, x0 + kit.ln(c, 10), y0, h, kit.tokc(c, style.TOK_ACCENT))
    kit.draw_label(c, x0 + kit.ln(c, 38), y0, h, kit.ln(c, 14), 600, kit.tokc(c, tok), label, 0.0)
}
