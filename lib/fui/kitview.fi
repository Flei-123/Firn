import std.rt
import docview.obj
import docview.dvbytes
import docview.kind
import docview.kinds
import docview.dvinstall
import docview.registry
import markdown.doc
import fui.painter
import fui.render
import fui.kit
import fui.style
import fui.kitdoc
import fui.kitcode
import fui.kitplayer
import fui.markdownview

export {
    View, view_new, view_free, view_open, view_draw, view_wheel, view_press, view_move, view_release, view_key, view_char,
    view_tick, view_animating, view_media, view_kind, view_mode, view_status,
    MODE_NONE, MODE_PAGES, MODE_CODE, MODE_MARKDOWN, MODE_MEDIA, MODE_UNSUPPORTED,
}

const MODE_NONE: u32 = 0
const MODE_PAGES: u32 = 1
const MODE_CODE: u32 = 2
const MODE_MARKDOWN: u32 = 3
const MODE_MEDIA: u32 = 4
const MODE_UNSUPPORTED: u32 = 5

struct View {
    kind: u32,
    mode: u32,
    name: rt.Buf,
    pages: kitdoc.DocView,
    code: kitcode.CodeView,
    md: u64,
    media: u64,
    installed: bool,
}

fn view_new() -> View {
    return View { kind: kinds.KIND_UNKNOWN, mode: MODE_NONE, name: rt.buf_new(), pages: kitdoc.docv_new(),
        code: kitcode.code_new(), md: 0, media: 0, installed: false }
}

fn drop_markdown(v: *mut View) {
    if (*v).md != 0 {
        markdownview.mdv_free((*v).md as *mut markdownview.MdView)
        obj.obj_free[markdownview.MdView]((*v).md)
        (*v).md = 0
    }
}

fn drop_media(v: *mut View) {
    if (*v).media != 0 {
        kitplayer.pv_free((*v).media as *mut kitplayer.PlayerView)
        obj.obj_free[kitplayer.PlayerView]((*v).media)
        (*v).media = 0
    }
}

fn view_free(v: *mut View) {
    drop_markdown(v)
    drop_media(v)
    kitdoc.docv_free(&(*v).pages)
    kitcode.code_free(&(*v).code)
    rt.buf_free(&(*v).name)
}

fn view_kind(v: *mut View) -> u32 {
    return (*v).kind
}

fn view_mode(v: *mut View) -> u32 {
    return (*v).mode
}

fn mode_for(k: u32, have_opener: bool) -> u32 {
    let f: u32 = kinds.kind_family(k)
    if f == kinds.FAMILY_AUDIO || f == kinds.FAMILY_VIDEO {
        return MODE_MEDIA
    }
    if k == kinds.KIND_CODE || k == kinds.KIND_TEXT {
        return MODE_CODE
    }
    if k == kinds.KIND_MARKDOWN {
        return MODE_MARKDOWN
    }
    if have_opener && (f == kinds.FAMILY_DOCUMENT || f == kinds.FAMILY_IMAGE) {
        return MODE_PAGES
    }
    return MODE_UNSUPPORTED
}

fn open_markdown(v: *mut View, p: u64, n: usize) -> bool {
    let raw: u64 = obj.obj_alloc[markdownview.MdView]()
    if raw == 0 {
        return false
    }
    let m: *mut markdownview.MdView = raw as *mut markdownview.MdView
    *m = markdownview.mdv_new()
    markdownview.mdv_set_markdown(m, str { p: p as *mut u8, n: n }, doc.opts_default())
    (*v).md = raw
    return true
}

fn open_media(v: *mut View, p: u64, n: usize, name: str) -> bool {
    let raw: u64 = obj.obj_alloc[kitplayer.PlayerView]()
    if raw == 0 {
        return false
    }
    let m: *mut kitplayer.PlayerView = raw as *mut kitplayer.PlayerView
    *m = kitplayer.pv_new()
    kitplayer.pv_open(m, p, n, name)
    (*v).media = raw
    return true
}

fn view_media(v: *mut View) -> *mut kitplayer.PlayerView {
    return (*v).media as *mut kitplayer.PlayerView
}

fn view_open(v: *mut View, p: u64, n: usize, name: str) -> u32 {
    if !(*v).installed {
        dvinstall.install_builtin()
        (*v).installed = true
    }
    drop_markdown(v)
    drop_media(v)
    kitdoc.docv_close(&(*v).pages)
    rt.buf_clear(&(*v).name)
    rt.buf_push_bytes(&(*v).name, name.p as u64, name.n)
    (*v).kind = kind.sniff(p, n, name)
    (*v).mode = mode_for((*v).kind, true)
    if (*v).mode == MODE_PAGES {
        if !kitdoc.docv_open(&(*v).pages, p, n, name) {
            (*v).mode = MODE_UNSUPPORTED
        }
    }
    if (*v).mode == MODE_CODE {
        kitcode.code_set(&(*v).code, p, n, kind.code_language(name))
    }
    if (*v).mode == MODE_MARKDOWN {
        if !open_markdown(v, p, n) {
            (*v).mode = MODE_UNSUPPORTED
        }
    }
    if (*v).mode == MODE_MEDIA {
        if !open_media(v, p, n, name) {
            (*v).mode = MODE_UNSUPPORTED
        }
    }
    return (*v).mode
}

fn view_wheel(v: *mut View, dy: f64) -> bool {
    if (*v).mode == MODE_PAGES {
        return kitdoc.docv_wheel(&(*v).pages, dy)
    }
    if (*v).mode == MODE_CODE {
        return kitcode.code_wheel(&(*v).code, dy)
    }
    if (*v).mode == MODE_MARKDOWN && (*v).md != 0 {
        markdownview.mdv_wheel((*v).md as *mut markdownview.MdView, dy)
        return true
    }
    if (*v).mode == MODE_MEDIA && (*v).media != 0 {
        return kitplayer.pv_wheel(view_media(v), dy)
    }
    return false
}

fn view_press(v: *mut View, x: f64, y: f64) -> bool {
    if (*v).mode == MODE_MEDIA && (*v).media != 0 {
        return kitplayer.pv_press(view_media(v), x, y)
    }
    return false
}

fn view_move(v: *mut View, x: f64, y: f64) -> bool {
    if (*v).mode == MODE_MEDIA && (*v).media != 0 {
        return kitplayer.pv_move(view_media(v), x, y)
    }
    return false
}

fn view_release(v: *mut View, x: f64, y: f64) -> bool {
    if (*v).mode == MODE_MEDIA && (*v).media != 0 {
        return kitplayer.pv_release(view_media(v), x, y)
    }
    return false
}

fn view_key(v: *mut View, key: u32, mods: u32) -> bool {
    if (*v).mode == MODE_MEDIA && (*v).media != 0 {
        return kitplayer.pv_key(view_media(v), key, mods)
    }
    return false
}

fn view_char(v: *mut View, cp: u32, mods: u32) -> bool {
    if (*v).mode == MODE_MEDIA && (*v).media != 0 {
        return kitplayer.pv_char(view_media(v), cp, mods)
    }
    return false
}

fn view_tick(v: *mut View) -> bool {
    if (*v).mode == MODE_MEDIA && (*v).media != 0 {
        return kitplayer.pv_tick(view_media(v))
    }
    return false
}

fn view_animating(v: *mut View) -> bool {
    if (*v).mode == MODE_MEDIA && (*v).media != 0 {
        return kitplayer.pv_animating(view_media(v))
    }
    return false
}

fn view_status(v: *mut View, out: *mut rt.Buf) {
    if (*v).mode == MODE_PAGES {
        kitdoc.docv_status(&(*v).pages, out)
        return
    }
    rt.buf_push_bytes(out, kinds.kind_name((*v).kind).p as u64, kinds.kind_name((*v).kind).n)
}

fn placeholder(c: *mut render.Ctx, v: *mut View, x: f64, y: f64, w: f64, h: f64) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    painter.surface(z, x, y, w, h, kit.tokc(c, style.TOK_SURFACE))
    var label: str = "No preview for this file"
    if (*v).mode == MODE_NONE {
        label = "Nothing opened"
    }
    kit.draw_label(c, x + 16.0, y + h / 2.0 - 12.0, 24.0, 15.0, 400, kit.tokc(c, style.TOK_TEXT_MUTED), label, w - 32.0)
}

fn view_draw(c: *mut render.Ctx, v: *mut View, x: f64, y: f64, w: f64, h: f64) {
    if (*v).mode == MODE_PAGES {
        kitdoc.docv_draw(c, &(*v).pages, x, y, w, h)
        return
    }
    if (*v).mode == MODE_CODE {
        kitcode.code_draw(c, &(*v).code, x, y, w, h)
        return
    }
    if (*v).mode == MODE_MARKDOWN && (*v).md != 0 {
        let m: *mut markdownview.MdView = (*v).md as *mut markdownview.MdView
        markdownview.mdv_set_rect(m, x, y, w, h)
        markdownview.mdv_paint(m, c)
        return
    }
    if (*v).mode == MODE_MEDIA && (*v).media != 0 {
        kitplayer.pv_draw(c, view_media(v), x, y, w, h)
        return
    }
    placeholder(c, v, x, y, w, h)
}
