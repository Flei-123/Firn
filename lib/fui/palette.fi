// lib/fui/palette.fi -- NAMED COLOUR SETS FOR THE KIT SKINS (a registry, one table per look).
//
// A `Pal` is one theme's colours as 0xRRGGBB; a field that is 0 keeps what the theme already
// holds (so a set can name only the colours that differ from the stock theme). `get(id, dark)`
// is the registry: every skin of lib/fui/preset.fi is an id here, never a block of assignments.
import fui.theme

export { Pal, LAUNCHER, STUDIO, MESSENGER, COUNT, get, apply, accent_of }

const LAUNCHER: usize = 0
const STUDIO: usize = 1
const MESSENGER: usize = 2
const COUNT: usize = 3

struct Pal {
    base: u32,
    surface: u32,
    raised: u32,
    field: u32,
    field_focus: u32,
    button: u32,
    button_hover: u32,
    button_active: u32,
    border: u32,
    separator: u32,
    text: u32,
    muted: u32,
    disabled: u32,
    on_accent: u32,
    err: u32,
}

fn none() -> Pal {
    return Pal { base: 0 as u32, surface: 0 as u32, raised: 0 as u32, field: 0 as u32, field_focus: 0 as u32, button: 0 as u32,
        button_hover: 0 as u32, button_active: 0 as u32, border: 0 as u32, separator: 0 as u32, text: 0 as u32, muted: 0 as u32,
        disabled: 0 as u32, on_accent: 0 as u32, err: 0 as u32 }
}

fn launcher_dark() -> Pal {
    var p: Pal = none()
    p.base = 0x07090F as u32
    p.surface = 0x0B0E17 as u32
    p.raised = 0x0E1220 as u32
    p.button = 0x151B2C as u32
    p.button_hover = 0x1D2438 as u32
    p.field = 0x0B0E17 as u32
    p.field_focus = 0x10162A as u32
    p.border = 0x262A36 as u32
    p.separator = 0x171A22 as u32
    p.text = 0xEEF1FA as u32
    p.muted = 0xAAB2CE as u32
    p.disabled = 0x6B7392 as u32
    return p
}

fn studio_dark() -> Pal {
    var p: Pal = none()
    p.base = 0x0C0F1A as u32
    p.surface = 0x121728 as u32
    p.raised = 0x1A2038 as u32
    p.field = 0x121728 as u32
    p.field_focus = 0x1A2038 as u32
    p.button = 0x1A2038 as u32
    p.button_hover = 0x222A47 as u32
    p.button_active = 0x2A3358 as u32
    p.border = 0x22252F as u32
    p.separator = 0x1B1E28 as u32
    p.text = 0xEEF1FA as u32
    p.muted = 0xAAB2CE as u32
    p.disabled = 0x6B7392 as u32
    p.err = 0xFF6B8A as u32
    return p
}

fn studio_light() -> Pal {
    var p: Pal = none()
    p.base = 0xF3F5FB as u32
    p.surface = 0xFFFFFF as u32
    p.raised = 0xEEF1F8 as u32
    p.field = 0xEEF1F8 as u32
    p.field_focus = 0xFFFFFF as u32
    p.button = 0xE4E9F6 as u32
    p.button_hover = 0xD9E0F2 as u32
    p.border = 0xE3E4E8 as u32
    p.separator = 0xE8EAF1 as u32
    p.text = 0x10152A as u32
    p.muted = 0x454D6B as u32
    p.disabled = 0x8089A6 as u32
    p.err = 0xE03A5E as u32
    return p
}

fn messenger_dark() -> Pal {
    var p: Pal = none()
    p.base = 0x0B0E17 as u32
    p.surface = 0x0F1320 as u32
    p.raised = 0x1B2136 as u32
    p.field = 0x161B2D as u32
    p.field_focus = 0x161B2D as u32
    p.button = 0x1E2540 as u32
    p.button_hover = 0x262E4D as u32
    p.border = 0x23283A as u32
    p.separator = 0x1B2030 as u32
    p.text = 0xEEF1FA as u32
    p.muted = 0x7A82A3 as u32
    p.disabled = 0x6B7392 as u32
    return p
}

fn messenger_light() -> Pal {
    var p: Pal = none()
    p.base = 0xF3F5FB as u32
    p.surface = 0xFFFFFF as u32
    p.raised = 0xFFFFFF as u32
    p.field = 0xF0F3FA as u32
    p.field_focus = 0xFFFFFF as u32
    p.button = 0xE4E9F6 as u32
    p.button_hover = 0xD9E0F2 as u32
    p.border = 0xE3E6EE as u32
    p.separator = 0xE8EAF1 as u32
    p.text = 0x10152A as u32
    p.muted = 0x5C6483 as u32
    return p
}

// The colours of look `id` for the light or dark theme (all zero = the stock theme).
fn get(id: usize, dark: bool) -> Pal {
    if id == LAUNCHER && dark { return launcher_dark() }
    if id == STUDIO { if dark { return studio_dark() } else { return studio_light() } }
    if id == MESSENGER { if dark { return messenger_dark() } else { return messenger_light() } }
    return none()
}

// The accent the look is designed around (0xRRGGBB).
fn accent_of(id: usize, dark: bool) -> u32 {
    if id == STUDIO { if dark { return 0x5B8CFF as u32 } else { return 0x3D6DF0 as u32 } }
    if id == MESSENGER { return 0x3D6DF0 as u32 }
    return 0x1BD96A as u32
}

fn put(slot: *mut u32, v: u32) {
    if v != 0 as u32 { *slot = v }
}

fn apply(m: *mut theme.Theme, id: usize, dark: bool) {
    let p: Pal = get(id, dark)
    let f: *mut theme.Colors = theme.theme_colors(m)
    put(&(*f).base, p.base)
    put(&(*f).surface, p.surface)
    put(&(*f).surface_raised, p.raised)
    put(&(*f).field, p.field)
    put(&(*f).field_focus, p.field_focus)
    put(&(*f).button, p.button)
    put(&(*f).button_hover, p.button_hover)
    put(&(*f).button_active, p.button_active)
    put(&(*f).border_col, p.border)
    put(&(*f).separator, p.separator)
    put(&(*f).text, p.text)
    put(&(*f).text_muted, p.muted)
    put(&(*f).text_disabled, p.disabled)
    put(&(*f).text_on_accent, p.on_accent)
    put(&(*f).err_col, p.err)
}
