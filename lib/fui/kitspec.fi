import std.rt
import fui.kitdata
import fui.kitset
import fui.render

const ROW_SEP: u8 = 10
const FIELD_SEP: u8 = 126

fn pick(s: str, sep: u8, i: usize) -> str {
    var k: usize = 0
    var a: usize = 0
    var j: usize = 0
    while j <= s.n {
        if j == s.n || rt.ld8(s.p as u64, j) == sep {
            if k == i { return str { p: (s.p as u64 + a as u64) as *mut u8, n: j - a } }
            k = k + 1
            a = j + 1
        }
        j = j + 1
    }
    return str { p: s.p, n: 0 }
}

fn count(s: str, sep: u8) -> usize {
    var n: usize = 1
    var i: usize = 0
    while i < s.n {
        if rt.ld8(s.p as u64, i) == sep { n = n + 1 }
        i = i + 1
    }
    return n
}

fn dec(t: str) -> i64 {
    var v: i64 = 0
    var i: usize = 0
    while i < t.n {
        v = v * 10 + (rt.ld8(t.p as u64, i) - 48 as u8) as i64
        i = i + 1
    }
    return v
}

fn kind_of(row: str) -> u8 { return rt.ld8(row.p as u64, 0) }
fn id_of(row: str) -> usize { return dec(pick(row, FIELD_SEP, 1)) as usize }

fn draw_row(s: *mut kitset.Set, c: *mut render.Ctx, row: str) {
    let k: u8 = kind_of(row)
    let id: usize = id_of(row)
    let title: str = pick(row, FIELD_SEP, 3)
    let sub: str = pick(row, FIELD_SEP, 4)
    let a: str = pick(row, FIELD_SEP, 5)
    if k == 116 as u8 { kitset.row_toggle(s, c, id, title, sub) }
    if k == 115 as u8 { kitset.row_select(s, c, id, title, a) }
    if k == 114 as u8 { kitset.row_radio(s, c, id, title, sub, a) }
    if k == 99 as u8 { kitset.row_colors(s, c, id, title, a) }
    if k == 108 as u8 { kitset.row_slider(s, c, id, title, dec(a), dec(pick(row, FIELD_SEP, 6)), pick(row, FIELD_SEP, 7)) }
    if k == 102 as u8 { kitset.row_field(s, c, id, title, a) }
}

fn page_draw(s: *mut kitset.Set, c: *mut render.Ctx, spec: str, page: usize) {
    var cur: usize = 0
    var i: usize = 0
    let n: usize = count(spec, ROW_SEP)
    while i < n {
        let row: str = pick(spec, ROW_SEP, i)
        i = i + 1
        if row.n == 0 { continue }
        if kind_of(row) == 112 as u8 {
            cur = cur + 1
            continue
        }
        if cur == page { draw_row(s, c, row) }
    }
}

fn bind(s: *mut kitset.Set, d: *mut kitdata.Doc, spec: str) {
    var i: usize = 0
    let n: usize = count(spec, ROW_SEP)
    while i < n {
        let row: str = pick(spec, ROW_SEP, i)
        i = i + 1
        if row.n == 0 || kind_of(row) == 112 as u8 { continue }
        let k: u8 = kind_of(row)
        let id: usize = id_of(row)
        let node: u32 = kitdata.path(d, pick(row, FIELD_SEP, 2))
        if k == 116 as u8 || k == 108 as u8 { kitset.set_val(s, id, kitdata.value(d, node)) }
        if k == 115 as u8 || k == 114 as u8 || k == 99 as u8 { kitset.set_val(s, id, kitset.index_of(pick(row, FIELD_SEP, 5), kitdata.text(d, node))) }
        if k == 102 as u8 { kitset.set_text(s, id, kitdata.text(d, node)) }
    }
}
