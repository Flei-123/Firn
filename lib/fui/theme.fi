// SPDX-License-Identifier: MPL-2.0
// lib/fui/theme.fi -- THE ONE SOURCE FOR COLOUR, SHAPE AND SPACE (fUi).
//
// ========================================================= WHY IT EXISTS
//
// Justin, 10.09.2026: "There should then be ONE general one for
// everything, not several separate ones!!!"
//
// Today the same numbers stand in three places. In Certus
// (lib/browser/chrome.fi) as `theme_dark`/`theme_light` with ten
// colours. In OrientOS (kernel/user/wlibc.fi) as 24 shape marks and a
// set of colour schemes. In lib/android/ui.fi once more, because the
// phone painted its own. Three versions of the same thing drift apart,
// and they HAD already drifted -- that is exactly the finding
// lib/browser/chrome.fi itself opens with ("four numbers that did not
// match their hex value").
//
// This file is the one source. No control in fUi writes a colour, a
// radius or a spacing down as a number; every one of them asks here.
//
// ==================================================== WHERE THE NUMBERS COME FROM
//
// NOTHING HERE IS INVENTED, and where something is derived, the
// arithmetic stands next to it. Two sources and one check:
//
//   1. /root/osum-merge11/assets/shapes/osum.shape -- the house shape of
//      OrientOS. It is in its turn derived from the design system under
//      .../skills/design-system/references/primitive-tokens.md and
//      component-specs.md and keeps ONE checkable rule: EVERY LENGTH IS
//      A MULTIPLE OF FOUR. That is the only property of a spacing
//      system you can count from outside.
//
//   2. lib/browser/chrome.fi -- the ten colours Certus paints today.
//      They are the Firefox Photon colours, and Justin knows them.
//
//   3. WCAG 2, contrast 4.5:1 for text (design system, priority 1).
//      EVERY text pair in this file is recomputed. The numbers stand
//      below in the table, and `tools/fui/contrast_main.fi` recomputes
//      them in the build -- a theme that breaks its own promise fails
//      there and not on Justin's screen.
//
// =============================== THREE COLOURS THE CHECK CHANGED
//
// The contrast arithmetic was no formality; it found three real
// mistakes, two of them in today's Certus:
//
//   1. `text_muted` dark (0x8F8F9D) on the bar (0x2B2A33) gives 4.44:1
//      -- just under the threshold. Lightened by ONE step per channel
//      (0x90909E) it is 4.50:1.
//
//   2. WHITE TEXT ON THE ACCENT (0x0A84FF) gives 3.65:1 in the dark
//      scheme. That is the colour Certus uses today for progress and
//      the focus ring. The accent STAYS -- it is the Firefox blue and
//      Justin knows it -- but `text_on_accent` is NOT white in the dark
//      scheme, it is the base tone 0x1C1B22: 4.68:1.
//
//   3. `text_muted` has TWO jobs that contradict each other: helper
//      text on the SURFACE (dark, 0x2B2A33) and the label of a DISABLED
//      BUTTON (lighter, 0x42414D). One colour for both gives 3.18:1 on
//      the button. Hence `text_disabled` as A ROLE OF ITS OWN,
//      computed against the button surface: 0xAEAEBC, 4.57:1 -- and
//      still clearly weaker than ordinary text (9.71:1), otherwise
//      "disabled" would not be visible.
//
// ========================================================= THE THREE AXES
//
// OrientOS separates colour (`.scheme`), shape (`.shape`) and space,
// and that is the right division: a dark scheme with square corners is
// a sensible combination, a set "dark and rounded" as ONE theme would
// not be. fUi takes the division over.
//
// ==================================================== WHAT IS NOT HERE
//
// M1 NO font file. Which font gets loaded is decided by the
//    application (Certus looks for segoeui/arial/DejaVu). Only the
//    SIZE stands here.
// M2 NO drawing. This file knows no canvas and imports nothing except
//    `std.rt`.
// M3 NO state logic. WHICH colour a pressed button has stands here;
//    THAT it is pressed is known by lib/fui/widget.fi.
import fui.style

export {
    Colors, colors_light, colors_dark, colors_for_dark,
    Shape, shape_osum, shape_classic,
    Theme, theme_new, theme_colors, theme_shape, theme_is_dark,
    theme_set_dark, theme_set_shape, theme_set_scale, theme_scale,
    theme_px, theme_set_accent, accent_derive,
    surface_for, text_for, border_for,
    luminance, contrast, opaque, mix,
    color_from_token, color_from_style,
    scrim_color,
}

// ============================================================ THE STATES
//
// THEY DO NOT STAND HERE. The states belong to `lib/fui/style.fi` and
// this file reads them from there -- `style.STATE_NORMAL` and so on.
//
// For a while they stood in BOTH files, with the same five values
// written out twice. Nothing was broken by it, and that is precisely
// what made it dangerous: the two copies agreed only as long as
// nobody touched one of them, and `style.fi` had already grown a
// sixth state (`STATE_SELECTED`) that this file never heard of. A
// second place for the same thing is a divergence waiting for its
// occasion, so the copy is gone.
//
// `style.STATE_DISABLED` beats all the others: a disabled button
// under the pointer is disabled, not hovered.

// =========================================================== THE COLOURS
//
// 0xRRGGBB, as everywhere in Certus and in OrientOS. The canvas wants
// 0xAARRGGBB; `opaque` sets the alpha.
//
// The names are ROLES and not colour names. "grey3" would be named
// wrongly in a light scheme; `surface_raised` holds in both.
struct Colors {
    // --- surfaces, from back to front
    base: u32,        // the window itself, the empty page
    surface: u32,      // a bar, a panel on the ground
    surface_raised: u32, // a card, a menu -- closer to the eye
    // --- controls
    button: u32,
    button_hover: u32,
    button_active: u32,
    field: u32,
    field_focus: u32,
    // --- strokes
    border_col: u32,        // Rahmen eines Elements
    separator: u32,      // dividing line between two things
    // --- text
    text: u32,
    text_muted: u32,     // helper text ON THE SURFACE
    text_disabled: u32,  // label ON A BUTTON, disabled
    text_on_accent: u32,
    // --- the one loud colour
    accent: u32,
    selection: u32,        // Hintergrund markierten Textes
    selection_text: u32,
    // --- messages
    err_col: u32,
    warning: u32,
    success: u32,
    dark: bool,
}

// --------------------------------------------------------------- LIGHT
//
// chrome.fi `theme_light` (Firefox Photon light) plus the roles Certus
// did not have. Measured contrasts stand as a comment.
#[no_gc]
fn colors_light() -> Colors {
    return Colors {
        // THE THREE LAYERS HAVE TO BE THREE. Until 20.09.2026 the page
        // and the raised card were both pure white, so a menu, a card
        // and a dialog were invisible as SURFACES -- only their border
        // told them apart, and where the border is thin (or a shadow
        // does the work) the layering was simply gone. The light
        // scheme now runs the same way as the dark one: the page is
        // the lowest layer, the bar sits on it, the card sits above
        // both, and pure white is reserved for what is closest to the
        // eye. The steps are measured in contrast_main.fi (OKLab dE
        // of at least 0.012 between neighbouring layers).
        base: 16053494,           // 0xF4F4F6  the page, one step down
        surface: 16382459,         // 0xF9F9FB  chrome.fi bar
        surface_raised: 16777215,    // 0xFFFFFF  a card stands above it
        button: 15592944,           // 0xEDEDF0  chrome.fi field
        button_hover: 14671842,     // 0xDFDFE2  chrome.fi hover
        // One step below `button_hover`, the same grey series continued
        // (6 % towards the text). Firefox takes the next step for
        // pressed, and the series F9F9FB -> EDEDF0 -> DFDFE2 -> D3D3D6
        // keeps its spacing.
        button_active: 13882326,     // 0xD3D3D6  text on it 12.25:1
        field: 15592944,            // 0xEDEDF0  chrome.fi field
        field_focus: 16777215,      // 0xFFFFFF  chrome.fi field_focus
        border_col: 14145499,           // 0xD7D7DB  chrome.fi sep
        separator: 14145499,         // 0xD7D7DB  `sep_strength` regelt
                                   //           the opacity
        text: 1381403,             // 0x15141B  chrome.fi fg
        text_muted: 5987174,       // 0x5B5B66  chrome.fi fg_dim, 6,37:1
        text_disabled: 5987174,    // 0x5B5B66  on the button 5.74:1 --
                                   //           light needs no colour
                                   //           of its own
        text_on_accent: 16777215, // 0xFFFFFF  on the accent 5.62:1
        accent: 24799,             // 0x0060DF  chrome.fi accent
        // 22 % accent on white -- the classic selection colour of a
        // text field. Text on it 13.09:1.
        selection: 13098232,         // 0xC7DCF8
        selection_text: 1381403,     // 0x15141B
        err_col: 12910658,          // 0xC50042  chrome.fi err, 5,78:1
        // NOT 0xFFA436 (Photon warning). That is a SURFACE colour --
        // as text on the light bar orange gives 1.88:1, and the check
        // found it at once. Taken is the text version of the same
        // colour (Photon amber-90): 6.94:1.
        warning: 7426304,          // 0x715100
        success: 96832,                // 0x017A40  Photon success, 5,18:1
        dark: false,
    }
}

// ---------------------------------------------------------------- DARK
#[no_gc]
fn colors_dark() -> Colors {
    return Colors {
        base: 1841954,            // 0x1C1B22  chrome.fi page
        surface: 2828851,          // 0x2B2A33  chrome.fi bar
        // 6 % towards the text: a card lies IN FRONT OF the bar, so
        // lighter. Text on it 11.42:1.
        surface_raised: 3618623,     // 0x37373F
        button: 4342093,            // 0x42414D  chrome.fi field
        button_hover: 5395038,      // 0x52525E  chrome.fi hover
        button_active: 6513518,      // 0x63636E  text on it 5.74:1
        field: 4342093,             // 0x42414D  chrome.fi field
        field_focus: 1841954,       // 0x1C1B22  chrome.fi field_focus
        border_col: 3815748,            // 0x3A3944  chrome.fi sep
        separator: 3815748,          // 0x3A3944
        text: 16514046,            // 0xFBFBFE  chrome.fi fg
        // FINDING 1: chrome.fi has 0x8F8F9D -- 4.44:1, just under.
        // One step per channel lighter: 4.50:1.
        text_muted: 9474206,       // 0x90909E
        // FINDING 3: a role of its own, computed against the BUTTON
        // surface. 4.57:1 on the button, against 9.71:1 for ordinary
        // text -- weaker, but legible.
        text_disabled: 11447996,   // 0xAEAEBC
        // FINDING 2: NOT white. White on 0x0A84FF is 3.65:1.
        text_on_accent: 1841954,  // 0x1C1B22  4,68:1
        accent: 689407,            // 0x0A84FF  chrome.fi accent
        // 35 % accent on the base tone. Text on it 10.18:1.
        selection: 1458287,          // 0x16406F
        selection_text: 16514046,    // 0xFBFBFE
        err_col: 16735324,          // 0xFF5C5C  chrome.fi err, 4,68:1
        warning: 16760143,         // 0xFFBD4F  Photon warning dark
        success: 5570493,              // 0x54FFBD  Photon success dark
        dark: true,
    }
}

#[no_gc]
fn colors_for_dark(dark: bool) -> Colors {
    if dark {
        return colors_dark()
    }
    return colors_light()
}

// ============================================================= THE SHAPE
//
// All lengths in DESIGN POINTS at 96 dpi. `theme_px` converts them into
// device points -- therefore no length may be used straight from this
// structure.
//
// The numbers are those of osum.shape, word for word. Rule: every
// length is a multiple of four, except `border_w` (1) and `focus_w`
// (2), which are stroke widths.
struct Shape {
    // --- radii, by role: window > panel > button > field.
    // That is the order Fluent, HIG, Material 3 and Adwaita all four
    // keep: the radius says how BIG an area is. An input field with
    // the radius of a window looks like a pill.
    // Tablette.
    r_window: usize,
    r_panel: usize,
    r_button: usize,
    r_field: usize,
    // --- strokes
    border_w: usize,
    focus_w: usize,          // 2: a single one vanishes when scaling
    sep_strength: usize,  // 0..100
    // --- spacings, the four grid
    sp_xs: usize,          // innerhalb eines Elements
    sp_s: usize,           // between two elements of a group
    sp_m: usize,           // between two groups, inner margin of a card
    sp_l: usize,           // between two cards, margin of a page
    // --- paddings
    pad_x: usize,
    pad_y: usize,
    gap: usize,
    // --- heights
    ctrl_h: usize,         // "what you touch is at least 32 high"
    row: usize,            // one list row
    // --- font
    font: usize,
    // --- time
    motion: usize,         // ms; schnell 3/4, langsam 5/4
    // --- shadow
    //
    // DIE DECKKRAFT DES SCHATTENS, und warum sie 64 ist und nicht 32.
    //
    // 32/255 sind 12,5 % Schwarz. Auf der hellen Seite drueckt das den
    // Grund um ganze vier Tonwerte, wenn der Weichzeichner den Schatten
    // erst einmal verteilt hat -- gemessen am 21.09.2026 unter einer
    // Karte von 220 x 96: zwoelf Punkt unter ihrer Kante lagen blur 8
    // und blur 16 drei Tonwerte auseinander. Drei Tonwerte sind keine
    // Kante, keine Tiefe und kein Schatten; sie sind ein Geruecht.
    // Jedes Programm, das den Schatten WIRKLICH sehen wollte, rechnete
    // sich seinen eigenen Wert (tools/fui/gallery7_main.fi verdoppelte,
    // demos/fuidemo verdreifachte) -- und damit hatte die Bibliothek
    // ihre eigene Regel nicht mehr in der Hand.
    //
    // 64/255 sind 25 %, der Wert, mit dem die Umgebungen arbeiten, an
    // denen sich diese hier misst. Die Karte steht damit sichtbar vor
    // der Seite, der Verlauf unter ihr laeuft ueber 40 (hell) bzw. 20
    // (dunkel) Tonwerte, und tools/fui/gallery7_main.fi malt jetzt
    // den UNVERAENDERTEN Wert der Bibliothek und rechnet ihn nach.
    shadow: usize,
    shadow_r: usize,
}

// The house shape. This is osum.shape.
#[no_gc]
fn shape_osum() -> Shape {
    return Shape {
        r_window: 12, r_panel: 10, r_button: 8, r_field: 6,
        border_w: 1, focus_w: 2, sep_strength: 20,
        sp_xs: 4, sp_s: 8, sp_m: 16, sp_l: 24,
        pad_x: 16, pad_y: 8, gap: 12,
        ctrl_h: 32, row: 28,
        font: 15,
        motion: 160,
        shadow: 64, shadow_r: 8,
    }
}

// The square version -- classic.shape. It is NOT "ugly as an option":
// it is the PROOF that the shape is a theme and not an assumption in
// the drawing code. A widget that looks the same with `shape_classic`
// as with `shape_osum` has written its numbers in instead of fetching
// them -- and exactly that shows up this way.
#[no_gc]
fn shape_classic() -> Shape {
    return Shape {
        r_window: 0, r_panel: 0, r_button: 0, r_field: 0,
        border_w: 1, focus_w: 1, sep_strength: 100,
        sp_xs: 2, sp_s: 6, sp_m: 10, sp_l: 12,
        pad_x: 12, pad_y: 4, gap: 8,
        ctrl_h: 26, row: 20,
        font: 15,
        motion: 0,
        shadow: 0, shadow_r: 0,
    }
}

// ============================================================= THE THEME
struct Theme {
    f: Colors,
    fo: Shape,
    // The scale in per mille: 1000 = 100 %, 1500 = 150 %. It comes from
    // `fenster.uiscale(f)` and is held HERE, so that a widget does not
    // have to ask the window to know a length.
    scale: usize,
}

#[no_gc]
fn theme_new(dark: bool) -> Theme {
    return Theme { f: colors_for_dark(dark), fo: shape_osum(),
        scale: 1000 }
}

#[no_gc]
fn theme_colors(m: *mut Theme) -> *mut Colors {
    return &(*m).f
}

#[no_gc]
fn theme_shape(m: *mut Theme) -> *mut Shape {
    return &(*m).fo
}

#[no_gc]
fn theme_is_dark(m: *mut Theme) -> bool {
    return (*m).f.dark
}

#[no_gc]
fn theme_set_dark(m: *mut Theme, dark: bool) {
    (*m).f = colors_for_dark(dark)
}

fn theme_set_shape(m: *mut Theme, fo: *mut Shape) {
    (*m).fo = *fo
}

// ================================================= THE ADJUSTABLE ACCENT
//
// Justin, 13.09.2026: "Jede eingefaerbte/aktive Flaeche muss die
// EINSTELLBARE Akzentfarbe aus dem fUi-Thema ziehen, nicht fest
// verdrahtetes Blau."
//
// Bis hierher war der Akzent eine Konstante in `colors_light`/
// `colors_dark` -- das Firefox-Blau, das Justin kennt. Es BLEIBT die
// Vorgabe; neu ist nur, dass man es tauschen kann, ohne eine Zeile
// Code anzufassen.
//
// DREI ROLLEN HAENGEN AM AKZENT, und zwei davon darf man nicht einfach
// stehen lassen, wenn sich der Akzent aendert:
//
//   accent          die Flaeche selbst
//   text_on_accent  was AUF dieser Flaeche steht. Steht es fest auf
//                   Weiss, ist ein gelber Akzent unlesbar (Weiss auf
//                   0xFFD400 gibt 1,42:1). Genau dieser Fehler steckte
//                   schon einmal im dunklen Satz -- Befund 2 im Kopf
//                   dieser Datei.
//   selection       der markierte Text. Er ist eine AUFGEHELLTE Fassung
//                   des Akzents, kein eigener Farbton.
//
// Sie werden darum NACHGERECHNET und nicht gesetzt. `contrast` steht
// weiter unten in dieser Datei und ist dieselbe Formel, mit der die
// Tabelle im Kopf geprueft wurde.

// Was auf dem Akzent lesbar ist: die HELLERE der beiden Grundfarben des
// Satzes gegen die dunklere, gemessen -- nicht geraten.
//
// Genommen wird `text` oder `base`, je nachdem, welches den groesseren
// Abstand zum Akzent hat. Im hellen Satz ist das bei Blau `base`
// (0xFFFFFF, 5,62:1), bei einem hellen Gelb dagegen `text` (0x15141B).
// Damit stimmt die Regel fuer JEDEN Akzent und nicht nur fuer Blau.
#[no_gc]
fn accent_derive(f: *mut Colors, accent: u32) {
    let a: u32 = accent & 16777215 as u32
    (*f).accent = a

    // ---- 1. DER TEXT AUF DEM AKZENT
    let k_hell: f64 = contrast(a, (*f).base)
    let k_dunkel: f64 = contrast(a, (*f).text)
    if k_hell >= k_dunkel {
        (*f).text_on_accent = (*f).base
    } else {
        (*f).text_on_accent = (*f).text
    }

    // ---- 2. DIE AUSWAHLFARBE
    //
    // Die vorgegebenen Werte sind "22 % Akzent auf Weiss" (hell) und
    // "35 % Akzent auf dem Grundton" (dunkel) -- siehe die Kommentare
    // bei `colors_light`/`colors_dark`. Genau diese beiden Mischungen
    // stehen hier, damit der Standardakzent WIEDER GENAU die Zahl
    // ergibt, die vorher fest dastand (geprueft: hell 0xC7DCF8,
    // dunkel 0x16406F).
    if (*f).dark {
        (*f).selection = mix((*f).base, a, 350)
        (*f).selection_text = (*f).text
    } else {
        (*f).selection = mix((*f).base, a, 220)
        (*f).selection_text = (*f).text
    }
}

// Den Akzent des Themas setzen. 0xRRGGBB; das Alpha wird verworfen.
#[no_gc]
fn theme_set_accent(m: *mut Theme, accent: u32) {
    accent_derive(&(*m).f, accent)
}

fn theme_set_scale(m: *mut Theme, promille: usize) {
    var p: usize = promille
    if p < 500 {
        p = 500
    }
    if p > 4000 {
        p = 4000
    }
    (*m).scale = p
}

#[no_gc]
fn theme_scale(m: *mut Theme) -> usize {
    return (*m).scale
}

// A DESIGN LENGTH INTO DEVICE POINTS. Every length in fUi goes through
// here.
//
// The mistake this prevents stands at the head of lib/fenster/fenster.fi:
// Justin's cursor was 8x15 pixels on a 34-inch screen, because it was
// the only piece painted with fixed numbers.
//
// Rounded half up, and NEVER to zero: a border of one pixel stays one
// pixel. A border that disappears when scaled down is a widget without
// an edge.
#[no_gc]
fn theme_px(m: *mut Theme, n: usize) -> usize {
    if n == 0 {
        return 0
    }
    let v: usize = (n * (*m).scale + 500) / 1000
    if v == 0 {
        return 1
    }
    return v
}

// ==================================================== SURFACE AND TEXT
//
// Which colour does a widget have in state X? This question stands ONCE
// here and not in every widget -- that is exactly the mistake we are
// dismantling in OrientOS right now, where the control centre paints
// its own tiles instead of using `paint_button`.
#[no_gc]
fn surface_for(m: *mut Theme, state: u32) -> u32 {
    let f: *mut Colors = &(*m).f
    if state == style.STATE_DISABLED {
        // A disabled button is the RESTING COLOUR with pale text --
        // not a grey surface of its own. Two signals for the same state
        // are one too many.
        return (*f).button
    }
    if state == style.STATE_ACTIVE {
        return (*f).button_active
    }
    if state == style.STATE_HOVER {
        return (*f).button_hover
    }
    // style.STATE_FOCUS does NOT change the SURFACE -- focus is a RING.
    // Whoever colours both can no longer tell a focused button from a
    // hovered one.
    return (*f).button
}

#[no_gc]
fn text_for(m: *mut Theme, state: u32) -> u32 {
    let f: *mut Colors = &(*m).f
    if state == style.STATE_DISABLED {
        return (*f).text_disabled
    }
    return (*f).text
}

// The border colour. In focus it is the accent -- that is the ring, and
// it is the only thing somebody working by keyboard relies on.
// bedient.
#[no_gc]
fn border_for(m: *mut Theme, state: u32) -> u32 {
    let f: *mut Colors = &(*m).f
    if state == style.STATE_FOCUS {
        return (*f).accent
    }
    return (*f).border_col
}

// ============================================= LUMINANCE AND CONTRAST
//
// Taken from lib/browser/chrome.fi (round CERTUS-WIN2). They stand here
// because a theme has to be able to recompute its own promise.
#[no_gc]
fn lin(c: f64) -> f64 {
    if c <= 0.04045 {
        return c / 12.92
    }
    return high24((c + 0.055) / 1.055)
}

// x to the power 2.4 through e^(2.4 * ln x). A power of its own,
// because this file should hang on nothing except `std.rt`.
#[no_gc]
fn high24(x: f64) -> f64 {
    if x <= 0.0 {
        return 0.0
    }
    return e_pow(2.4 * ln_von(x))
}

#[no_gc]
fn ln_von(x: f64) -> f64 {
    if x <= 0.0 {
        return 0.0 - 30.0
    }
    // ln x = 2 * artanh((x-1)/(x+1)); brought onto [0.5; 2] first.
    var e: i32 = 0
    var v: f64 = x
    while v > 2.0 {
        v = v / 2.0
        e = e + 1
    }
    while v < 0.5 {
        v = v * 2.0
        e = e - 1
    }
    let t: f64 = (v - 1.0) / (v + 1.0)
    let t2: f64 = t * t
    var s: f64 = t
    var p: f64 = t
    var k: f64 = 3.0
    var i: usize = 0
    while i < 12 {
        p = p * t2
        s = s + p / k
        k = k + 2.0
        i = i + 1
    }
    return 2.0 * s + (e as f64) * 0.6931471805599453
}

#[no_gc]
fn e_pow(x: f64) -> f64 {
    var n: i32 = 0
    var v: f64 = x
    while v > 0.6931471805599453 {
        v = v - 0.6931471805599453
        n = n + 1
    }
    while v < 0.0 - 0.6931471805599453 {
        v = v + 0.6931471805599453
        n = n - 1
    }
    var s: f64 = 1.0
    var p: f64 = 1.0
    var i: usize = 1
    while i < 14 {
        p = p * v / (i as f64)
        s = s + p
        i = i + 1
    }
    var m: f64 = 1.0
    var k: i32 = 0
    if n >= 0 {
        while k < n {
            m = m * 2.0
            k = k + 1
        }
    } else {
        while k > n {
            m = m / 2.0
            k = k - 1
        }
    }
    return s * m
}

// The relative luminance after WCAG 2.
#[no_gc]
fn luminance(c: u32) -> f64 {
    let r: f64 = (((c >> 16) & 255 as u32) as f64) / 255.0
    let g: f64 = (((c >> 8) & 255 as u32) as f64) / 255.0
    let b: f64 = ((c & 255 as u32) as f64) / 255.0
    return 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b)
}

// The contrast ratio of two colours, 1.0 to 21.0.
#[no_gc]
fn contrast(a: u32, b: u32) -> f64 {
    let la: f64 = luminance(a)
    let lb: f64 = luminance(b)
    if la > lb {
        return (la + 0.05) / (lb + 0.05)
    }
    return (lb + 0.05) / (la + 0.05)
}

// Mix two colours, `t` in per mille (0 = a, 1000 = b). Per channel.
// That makes the derived colours recomputable from above and not
// merely asserted.
// ============================================================ THE SCRIM
//
// What lies BEHIND a modal dialog. It is not a colour of its own but
// the window's own base pushed towards black -- so it darkens in light
// mode AND in dark mode, instead of turning grey in one of them.
//
// WHY IT IS HERE AND NOT IN THE DIALOG: it is a theme decision, like
// every other colour. A dialog that mixed its own scrim would be the
// one surface in the system that does not follow the theme.
//
// 55 percent towards black is the value the four big systems sit
// between (Material 32%, HIG ~40%, Fluent 60%); it has to be strong
// enough that the window behind it is clearly OUT of reach.
//
// 20.09.2026 -- WARUM DAS DUNKLE SCHEMA IN DIE ANDERE RICHTUNG GEHT.
// Der Satz "es dunkelt in beiden Schemata ab" hielt der Rechnung
// nicht stand. Der dunkle Grund ist 0x1C1B22, seine Leuchtdichte
// 0.0116. Selbst gegen REINES SCHWARZ bleibt davon ein Abstand von
// 0.0116 und ein Kontrast von 1.19:1 -- unter der Schwelle, an der
// ein Mensch auf einem Flachbildschirm noch eine Kante sieht. Ein
// Schleier, den man nicht sieht, ist kein Schleier: der Anwender
// haelt das Fenster weiter fuer bedienbar. Im Dunklen wird also
// AUFGEHELLT (23 % Richtung Weiss, 0x504F55): Abstand 0.068,
// Kontrast 2.11:1 zum Grund, und der Dialog auf `surface` (0x2B2A33)
// steht mit 1.75:1 sichtbar DAVOR. Die Zahlen rechnet
// `tools/fui/contrast_main.fi` in beiden Schemata nach.
#[no_gc]
fn scrim_color(m: *mut Theme) -> u32 {
    let f: *mut Colors = theme_colors(m)
    if theme_is_dark(m) {
        return opaque(mix((*f).base, 16777215 as u32, 230))
    }
    return opaque(mix((*f).base, 0 as u32, 550))
}

#[no_gc]
fn mix(a: u32, b: u32, t: usize) -> u32 {
    var tt: usize = t
    if tt > 1000 {
        tt = 1000
    }
    var out: u32 = 0
    var s: u32 = 16
    while true {
        let ca: usize = ((a >> s) & 255 as u32) as usize
        let cb: usize = ((b >> s) & 255 as u32) as usize
        var v: usize = 0
        if cb >= ca {
            v = ca + ((cb - ca) * tt + 500) / 1000
        } else {
            v = ca - ((ca - cb) * tt + 500) / 1000
        }
        out = out | ((v as u32) << s)
        if s == 0 as u32 {
            break
        }
        s = s - 8 as u32
    }
    return out
}

// 0xRRGGBB -> 0xAARRGGBB with full alpha. The canvas wants that.
#[no_gc]
fn opaque(c: u32) -> u32 {
    return c | 4278190080 as u32
}

// ========================================= THE BRIDGE TO THE STYLE SYSTEM
//
// lib/fui/style.fi lies in the CORE and must know no colour table -- it
// carries colours as a TOKEN NUMBER (TK_*). Here stands the mapping
// from the number to the colour, and only here. That is the reason a
// theme change does NOT rebuild the widgets (Justin's point 3): in the
// widgets there is no colour but a number, and the number means
// something else after the change.
#[no_gc]
fn color_from_token(m: *mut Theme, tk: u32) -> u32 {
    let f: *mut Colors = &(*m).f
    if tk == style.TOK_BASE { return (*f).base }
    if tk == style.TOK_SURFACE { return (*f).surface }
    if tk == style.TOK_SURFACE_RAISED { return (*f).surface_raised }
    if tk == style.TOK_BUTTON { return (*f).button }
    if tk == style.TOK_BUTTON_HOVER { return (*f).button_hover }
    if tk == style.TOK_BUTTON_ACTIVE { return (*f).button_active }
    if tk == style.TOK_FIELD { return (*f).field }
    if tk == style.TOK_FIELD_FOCUS { return (*f).field_focus }
    if tk == style.TOK_BORDER { return (*f).border_col }
    if tk == style.TOK_SEPARATOR { return (*f).separator }
    if tk == style.TOK_TEXT { return (*f).text }
    if tk == style.TOK_TEXT_MUTED { return (*f).text_muted }
    if tk == style.TOK_TEXT_DISABLED { return (*f).text_disabled }
    if tk == style.TOK_TEXT_ON_ACCENT { return (*f).text_on_accent }
    if tk == style.TOK_ACCENT { return (*f).accent }
    if tk == style.TOK_SELECTION { return (*f).selection }
    if tk == style.TOK_SELECTION_TEXT { return (*f).selection_text }
    if tk == style.TOK_ERROR { return (*f).err_col }
    if tk == style.TOK_WARNING { return (*f).warning }
    if tk == style.TOK_SUCCESS { return (*f).success }
    // A number that does not exist: the text colour. It is legible on
    // every surface of this theme -- an unknown role should show up,
    // but make nothing invisible.
    return (*f).text
}

// A STYLE VALUE (literal, token, transparent, inherit) to a colour.
// Transparent and inherit have no colour -- the caller has to ask
// `style.color_is_visible` first. So that this cannot go wrong
// quietly, the text colour is returned here and not black: a forgotten
// visibility test then shows up.
fn color_from_style(m: *mut Theme, w: u32) -> u32 {
    let a: u32 = style.color_kind(w)
    if a == style.COLOR_LITERAL {
        return style.color_value(w)
    }
    if a == style.COLOR_TOKEN {
        return color_from_token(m, style.color_value(w))
    }
    return (*m).f.text
}
