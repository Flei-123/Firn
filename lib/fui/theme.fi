// SPDX-License-Identifier: GPL-2.0-only
// lib/fui/theme.fi -- DIE EINE QUELLE FUER FARBE, FORM UND RAUM (fUi).
//
// ====================================================== WARUM ES SIE GIBT
//
// Justin, 10.09.2026: "Es soll dann EINE allgemeine fuer alles geben,
// keine mehreren separaten!!!"
//
// Heute stehen dieselben Zahlen an drei Orten. In Certus
// (lib/browser/chrome.fi) als `theme_dark`/`theme_light` mit zehn
// Colors. In OrientOS (kernel/user/wlibc.fi) als 24 Formmarken und ein
// StyleSet Farbschemata. In lib/android/ui.fi noch einmal, weil das Telefon
// seine eigenen malte. Drei Fassungen derselben Sache laufen
// auseinander, und sie WAREN schon auseinander -- das ist genau der
// Befund, mit dem lib/browser/chrome.fi selbst anfaengt ("vier Zahlen,
// die nicht zu ihrem Hexwert passten").
//
// Diese Datei ist die eine Quelle. Kein Bedienelement in fUi schreibt
// eine Farbe, einen Radius oder einen Abstand als Zahl hin; jedes fragt
// hier.
//
// ================================================ WO DIE ZAHLEN HERKOMMEN
//
// NICHTS HIER IST ERFUNDEN, und wo etwas abgeleitet ist, steht die
// Rechnung daneben. Zwei Quellen und eine Pruefung:
//
//   1. /root/osum-merge11/assets/shapes/osum.shape -- die Hausform von
//      OrientOS. Sie ist ihrerseits align dem Entwurfssystem unter
//      .../skills/design-system/references/primitive-tokens.md und
//      component-specs.md hergeleitet und haelt EINE nachpruefbare
//      Regel: JEDE LAENGE IST EIN VIELFACHES VON VIER. Das ist die
//      einzige Eigenschaft eines Abstandssystems, die man von aussen
//      nachzaehlen kann.
//
//   2. lib/browser/chrome.fi -- die zehn Colors, die Certus heute malt.
//      Es sind die Firefox-Photon-Colors, und Justin kennt sie.
//
//   3. WCAG 2, Kontrast 4.5:1 fuer Text (Entwurfssystem, Priorität 1).
//      JEDES Textpaar dieser Datei ist nachgerechnet. Die Zahlen stehen
//      bottom in der Tafel, und `tools/fui/contrast.fi` rechnet sie im
//      Bau nach -- eine Theme, die ihre eigene Zusage bricht, faellt
//      dort auf und nicht auf Justins Bildschirm.
//
// ============================ DREI FARBEN, DIE DIE PRUEFUNG GEAENDERT HAT
//
// Die Kontrastrechnung war kein Formalismus; sie hat drei echte Fehler
// gefunden, zwei davon im heutigen Certus:
//
//   1. `text_muted` dark (0x8F8F9D) auf der Leiste (0x2B2A33) ergibt
//      4,44:1 -- knapp unter der Schwelle. Um EINE Stufe je Kanal
//      aufgehellt (0x90909E) sind es 4,50:1.
//
//   2. WEISSER TEXT AUF DEM AKZENT (0x0A84FF) ergibt im dunklen Schema
//      3,65:1. Das ist die Farbe, die Certus heute fuer Fortschritt und
//      Fokusring benutzt. Der Akzent BLEIBT -- er ist das Firefox-Blau
//      und Justin kennt ihn --, aber `text_on_accent` ist im dunklen
//      Schema NICHT weiss, sondern der Grundton 0x1C1B22: 4,68:1.
//
//   3. `text_muted` hat ZWEI Aufgaben, die einander widersprechen:
//      Hilfstext auf der FLAECHE (dark, 0x2B2A33) und Beschriftung
//      eines GESPERRTEN KNOPFES (heller, 0x42414D). Eine Farbe fuer
//      beides ergibt auf dem Knopf 3,18:1. Darum gibt es `text_disabled`
//      als EIGENE ROLLE, gegen die Knopfflaeche gerechnet: 0xAEAEBC,
//      4,57:1 -- und immer noch deutlich schwaecher als gewoehnlicher
//      Text (9,71:1), sonst waere "gesperrt" nicht zu sehen.
//
// ===================================================== DIE DREI ACHSEN
//
// OrientOS trennt Farbe (`.scheme`), Shape (`.shape`) und Raum, und das
// ist die richtige Teilung: ein dunkles Schema mit eckigen Ecken ist
// eine sinnvolle Verbindung, ein StyleSet "dark und round_rect" als EINE Theme
// waere es nicht. fUi uebernimmt die Teilung.
//
// ================================================== WAS HIER NICHT STEHT
//
// M1 KEINE Schriftdatei. Welche Schrift geladen wird, entscheidet die
//    Anwendung (Certus sucht segoeui/arial/DejaVu). Hier steht nur die
//    GROESSE.
// M2 KEIN Zeichnen. Diese Datei kennt keine Leinwand und importiert
//    ausser `std.rt` nichts.
// M3 KEINE Zustandslogik. WELCHE Farbe ein gedrueckter Knopf hat, steht
//    hier; DASS er gedrueckt ist, weiss lib/fui/widget.fi.
import std.rt
import fui.style

export {
    Colors, colors_light, colors_dark, colors_for_dark,
    Shape, shape_osum, shape_classic,
    Theme, theme_new, theme_colors, theme_shape, theme_is_dark,
    theme_set_dark, theme_set_shape, theme_set_scale, theme_scale,
    theme_px,
    STATE_NORMAL, STATE_HOVER, STATE_ACTIVE, STATE_FOCUS, STATE_DISABLED,
    surface_for, text_for, border_for,
    luminance, contrast, opaque, mix,
    color_from_token, color_from_style,
}

// ===================================================== DIE ZUSTAENDE
//
// Die fuenf, die jedes Bedienelement kennt. Sie stehen HIER und nicht in
// jedem Widget -- sonst muesste ein sechster an acht Stellen
// nachgetragen werden.
//
// `STATE_DISABLED` schlaegt alle anderen: ein gesperrter Knopf unter dem
// Zeiger ist gesperrt, nicht ueberfahren.
const STATE_NORMAL: u32 = 0
const STATE_HOVER: u32 = 1
const STATE_ACTIVE: u32 = 2
const STATE_FOCUS: u32 = 3
const STATE_DISABLED: u32 = 4

// ========================================================== DIE FARBEN
//
// 0xRRGGBB, how ueberall in Certus und in OrientOS. Die Leinwand will
// 0xAARRGGBB; `opaque` setzt das Alpha.
//
// Die Namen sind ROLLEN und keine Farbnamen. "grau3" waere in einem
// hellen Schema falsch benannt; `surface_raised` stimmt in beiden.
struct Colors {
    // --- Flaechen, von hinten nach vorn
    base: u32,        // das Fenster selbst, die leere Seite
    surface: u32,      // eine Leiste, eine Tafel auf dem Grund
    surface_raised: u32, // eine Karte, ein Menue -- naeher am Auge
    // --- Bedienelemente
    button: u32,
    button_hover: u32,
    button_active: u32,
    field: u32,
    field_focus: u32,
    // --- Striche
    border_col: u32,        // Rahmen eines Elements
    separator: u32,      // Trennlinie zwischen zwei Dingen
    // --- Text
    text: u32,
    text_muted: u32,     // Hilfstext AUF DER FLAECHE
    text_disabled: u32,  // Beschriftung AUF EINEM KNOPF, gesperrt
    text_on_accent: u32,
    // --- die eine laute Farbe
    accent: u32,
    selection: u32,        // Hintergrund markierten Textes
    selection_text: u32,
    // --- Meldungen
    err_col: u32,
    warning: u32,
    success: u32,
    dark: bool,
}

// ---------------------------------------------------------------- HELL
//
// chrome.fi `theme_light` (Firefox Photon hell) plus die Rollen, die
// Certus nicht hatte. Gemessene Kontraste stehen als Kommentar.
fn colors_light() -> Colors {
    return Colors {
        base: 16777215,           // 0xFFFFFF  chrome.fi page
        surface: 16382459,         // 0xF9F9FB  chrome.fi bar
        surface_raised: 16777215,    // 0xFFFFFF  ein Menue steht auf Weiss
        button: 15592944,           // 0xEDEDF0  chrome.fi field
        button_hover: 14671842,     // 0xDFDFE2  chrome.fi hover
        // Eine Stufe unter `button_hover`, dieselbe Graureihe fortgesetzt
        // (6 % Richtung Text). Firefox nimmt fuer gedrueckt die naechste
        // Stufe, und die Reihe F9F9FB -> EDEDF0 -> DFDFE2 -> D3D3D6
        // haelt ihren Abstand.
        button_active: 13882326,     // 0xD3D3D6  Text darauf 12,25:1
        field: 15592944,            // 0xEDEDF0  chrome.fi field
        field_focus: 16777215,      // 0xFFFFFF  chrome.fi field_focus
        border_col: 14145499,           // 0xD7D7DB  chrome.fi sep
        separator: 14145499,         // 0xD7D7DB  `sep_strength` regelt
                                   //           die Deckkraft
        text: 1381403,             // 0x15141B  chrome.fi fg
        text_muted: 5987174,       // 0x5B5B66  chrome.fi fg_dim, 6,37:1
        text_disabled: 5987174,    // 0x5B5B66  auf dem Knopf 5,74:1 --
                                   //           hell braucht keine
                                   //           eigene Farbe
        text_on_accent: 16777215, // 0xFFFFFF  auf dem Akzent 5,62:1
        accent: 24799,             // 0x0060DF  chrome.fi accent
        // 22 % Akzent auf Weiss -- die klassische Markierungsfarbe
        // eines Textfeldes. Text darauf 13,09:1.
        selection: 13098232,         // 0xC7DCF8
        selection_text: 1381403,     // 0x15141B
        err_col: 12910658,          // 0xC50042  chrome.fi err, 5,78:1
        // NICHT 0xFFA436 (Photon warning). Das ist eine FLAECHENfarbe
        // -- als Text auf der hellen Leiste ergibt Orange 1,88:1, und
        // die Pruefung hat es sofort gefunden. Genommen ist die
        // Textfassung derselben Farbe (Photon amber-90): 6,94:1.
        warning: 7426304,          // 0x715100
        success: 96832,                // 0x017A40  Photon success, 5,18:1
        dark: false,
    }
}

// -------------------------------------------------------------- DUNKEL
fn colors_dark() -> Colors {
    return Colors {
        base: 1841954,            // 0x1C1B22  chrome.fi page
        surface: 2828851,          // 0x2B2A33  chrome.fi bar
        // 6 % Richtung Text: eine Karte liegt VOR der Leiste, also
        // heller. Text darauf 11,42:1.
        surface_raised: 3618623,     // 0x37373F
        button: 4342093,            // 0x42414D  chrome.fi field
        button_hover: 5395038,      // 0x52525E  chrome.fi hover
        button_active: 6513518,      // 0x63636E  Text darauf 5,74:1
        field: 4342093,             // 0x42414D  chrome.fi field
        field_focus: 1841954,       // 0x1C1B22  chrome.fi field_focus
        border_col: 3815748,            // 0x3A3944  chrome.fi sep
        separator: 3815748,          // 0x3A3944
        text: 16514046,            // 0xFBFBFE  chrome.fi fg
        // BEFUND 1: chrome.fi hat 0x8F8F9D -- 4,44:1, knapp darunter.
        // Eine Stufe je Kanal heller: 4,50:1.
        text_muted: 9474206,       // 0x90909E
        // BEFUND 3: eigene Rolle, gegen die KNOPFflaeche gerechnet.
        // 4,57:1 auf dem Knopf, gegen 9,71:1 fuer gewoehnlichen Text --
        // schwaecher, aber lesbar.
        text_disabled: 11447996,   // 0xAEAEBC
        // BEFUND 2: NICHT weiss. Weiss auf 0x0A84FF sind 3,65:1.
        text_on_accent: 1841954,  // 0x1C1B22  4,68:1
        accent: 689407,            // 0x0A84FF  chrome.fi accent
        // 35 % Akzent auf dem Grundton. Text darauf 10,18:1.
        selection: 1458287,          // 0x16406F
        selection_text: 16514046,    // 0xFBFBFE
        err_col: 16735324,          // 0xFF5C5C  chrome.fi err, 4,68:1
        warning: 16760143,         // 0xFFBD4F  Photon warning dark
        success: 5570493,              // 0x54FFBD  Photon success dark
        dark: true,
    }
}

fn colors_for_dark(dark: bool) -> Colors {
    if dark {
        return colors_dark()
    }
    return colors_light()
}

// ============================================================ DIE FORM
//
// Alle Laengen in ENTWURFSPUNKTEN bei 96 dpi. `theme_px` rechnet sie in
// Geraetepunkte -- darum darf keine Laenge direkt align dieser Struktur
// benutzt werden.
//
// Die Zahlen sind die von osum.shape, Wort fuer Wort. Regel: jede
// Laenge ist ein Vielfaches von vier, ausser `border_w` (1) und `focus_w` (2),
// die Strichstaerken sind.
struct Shape {
    // --- Radien, nach Rolle: Fenster > Tafel > Knopf > Feld.
    // Das ist die Reihenfolge, die Fluent, HIG, Material 3 und Adwaita
    // alle vier einhalten: der Radius sagt, how GROSS eine Flaeche ist.
    // Ein Eingabefeld mit dem Radius eines Fensters sieht align how eine
    // Tablette.
    r_window: usize,
    r_panel: usize,
    r_button: usize,
    r_field: usize,
    // --- Striche
    border_w: usize,
    focus_w: usize,          // 2: einer verschwindet beim Skalieren
    sep_strength: usize,  // 0..100
    // --- Abstaende, das Viererraster
    sp_xs: usize,          // innerhalb eines Elements
    sp_s: usize,           // zwischen zwei Elementen einer Gruppe
    sp_m: usize,           // zwischen zwei Gruppen, Innenrand einer Karte
    sp_l: usize,           // zwischen zwei Karten, Rand einer Seite
    // --- Innenabstaende
    pad_x: usize,
    pad_y: usize,
    gap: usize,
    // --- Hoehen
    ctrl_h: usize,         // "was man anfasst, ist mindestens 32 hoch"
    row: usize,            // eine Listenzeile
    // --- Schrift
    font: usize,
    // --- Zeit
    motion: usize,         // ms; schnell 3/4, langsam 5/4
    // --- Schatten
    shadow: usize,
    shadow_r: usize,
}

// Die Hausform. Das ist osum.shape.
fn shape_osum() -> Shape {
    return Shape {
        r_window: 12, r_panel: 10, r_button: 8, r_field: 6,
        border_w: 1, focus_w: 2, sep_strength: 20,
        sp_xs: 4, sp_s: 8, sp_m: 16, sp_l: 24,
        pad_x: 16, pad_y: 8, gap: 12,
        ctrl_h: 32, row: 28,
        font: 15,
        motion: 160,
        shadow: 32, shadow_r: 8,
    }
}

// Die eckige Fassung -- classic.shape. Sie ist NICHT "haesslich als
// Wahlmoeglichkeit": sie ist der BEWEIS, dass die Shape eine Theme ist
// und keine Annahme im Zeichencode. Ein Widget, das mit
// `shape_classic` genauso aussieht how mit `shape_osum`, hat seine
// Zahlen hineingeschrieben statt sie zu holen -- und genau das faellt
// damit auf.
fn shape_classic() -> Shape {
    return Shape {
        r_window: 0, r_panel: 0, r_button: 0, r_field: 0,
        border_w: 1, focus_w: 1, sep_strength: 100,
        sp_xs: 2, sp_s: 6, sp_m: 10, sp_l: 12,
        pad_x: 12, pad_y: 4, gap: 8,
        ctrl_h: 26, row: 20,
        font: 15,
        motion: 0,
        shadow: 0, shadow_r: 0,
    }
}

// =========================================================== DIE MARKE
struct Theme {
    f: Colors,
    fo: Shape,
    // Der Massstab in Promille: 1000 = 100 %, 1500 = 150 %. Er kommt
    // align `fenster.uiscale(f)` und wird HIER gehalten, damit ein
    // Widget nicht das Fenster fragen muss, um eine Laenge zu kennen.
    scale: usize,
}

fn theme_new(dark: bool) -> Theme {
    return Theme { f: colors_for_dark(dark), fo: shape_osum(),
        scale: 1000 }
}

fn theme_colors(m: *mut Theme) -> *mut Colors {
    return &(*m).f
}

fn theme_shape(m: *mut Theme) -> *mut Shape {
    return &(*m).fo
}

fn theme_is_dark(m: *mut Theme) -> bool {
    return (*m).f.dark
}

fn theme_set_dark(m: *mut Theme, dark: bool) {
    (*m).f = colors_for_dark(dark)
}

fn theme_set_shape(m: *mut Theme, fo: *mut Shape) {
    (*m).fo = *fo
}

fn theme_set_scale(m: *mut Theme, promille: usize) {
    var p: usize = promille
    if p < 500 {
        p = 500
    }
    if p > 4000 {
        p = 4000
    }
    (*m).scale = p
}

fn theme_scale(m: *mut Theme) -> usize {
    return (*m).scale
}

// EINE ENTWURFSLAENGE IN GERAETEPUNKTE. Jede Laenge in fUi geht hier
// durch.
//
// Der Fehler, den das verhindert, steht im Kopf von
// lib/fenster/fenster.fi: Justins Zeiger war 8x15 Bildpunkte auf einem
// 34-Zoll-Schirm, weil er als einziges Stueck mit festen Zahlen gemalt
// wurde.
//
// Kaufmaennisch gerundet, und NIE auf null: ein Rahmen von einem
// Bildpunkt bleibt ein Bildpunkt. Ein Rahmen, der beim Verkleinern
// verschwindet, ist ein Widget ohne Kante.
fn theme_px(m: *mut Theme, n: usize) -> usize {
    if n == 0 {
        return 0
    }
    let v: usize = (n * (*m).scale + 500) / 1000
    if v == 0 {
        return 1
    }
    return v
}

// ================================================= FLAECHE UND TEXT
//
// Welche Farbe hat ein Widget im Zustand X? Diese Frage steht EINMAL
// hier und nicht in jedem Widget -- das ist genau der Fehler, den wir
// in OrientOS gerade ausbauen, wo das Kontrollzentrum eigene Kacheln
// malt statt `paint_button` zu benutzen.
fn surface_for(m: *mut Theme, state: u32) -> u32 {
    let f: *mut Colors = &(*m).f
    if state == STATE_DISABLED {
        // Ein gesperrter Knopf ist die RUHEFARBE mit blassem Text --
        // nicht eine eigene graue Flaeche. Zwei Signale fuer denselben
        // Zustand sind eines zu viel.
        return (*f).button
    }
    if state == STATE_ACTIVE {
        return (*f).button_active
    }
    if state == STATE_HOVER {
        return (*f).button_hover
    }
    // STATE_FOCUS aendert die FLAECHE NICHT -- der Fokus ist ein RING.
    // Wer beides faerbt, kann einen fokussierten von einem
    // ueberfahrenen Knopf nicht mehr unterscheiden.
    return (*f).button
}

fn text_for(m: *mut Theme, state: u32) -> u32 {
    let f: *mut Colors = &(*m).f
    if state == STATE_DISABLED {
        return (*f).text_disabled
    }
    return (*f).text
}

// Die Randfarbe. Im Fokus ist es der Akzent -- das ist der Ring, und er
// ist das einzige, worauf sich jemand verlaesst, der mit der Tastatur
// bedient.
fn border_for(m: *mut Theme, state: u32) -> u32 {
    let f: *mut Colors = &(*m).f
    if state == STATE_FOCUS {
        return (*f).accent
    }
    return (*f).border_col
}

// ============================================ HELLIGKEIT UND KONTRAST
//
// Uebernommen align lib/browser/chrome.fi (Runde CERTUS-WIN2). Sie stehen
// hier, weil eine Theme ihre eigene Zusage nachrechnen koennen muss.
fn lin(c: f64) -> f64 {
    if c <= 0.04045 {
        return c / 12.92
    }
    return hoch24((c + 0.055) / 1.055)
}

// x hoch 2,4 ueber e^(2,4 * ln x). Eine eigene Potenz, weil diese Datei
// an nichts ausser `std.rt` haengen soll.
fn hoch24(x: f64) -> f64 {
    if x <= 0.0 {
        return 0.0
    }
    return e_pow(2.4 * ln_von(x))
}

fn ln_von(x: f64) -> f64 {
    if x <= 0.0 {
        return 0.0 - 30.0
    }
    // ln x = 2 * artanh((x-1)/(x+1)); vorher auf [0,5; 2] gebracht.
    var e: i32 = 0
    var v: f64 = x
    while v > 2.0 {
        v = v / 2.0
        e = e + 1
    }
    while v < 0.5 {
        v = v * 2.0
        e = e - 1
    }
    let t: f64 = (v - 1.0) / (v + 1.0)
    let t2: f64 = t * t
    var s: f64 = t
    var p: f64 = t
    var k: f64 = 3.0
    var i: usize = 0
    while i < 12 {
        p = p * t2
        s = s + p / k
        k = k + 2.0
        i = i + 1
    }
    return 2.0 * s + (e as f64) * 0.6931471805599453
}

fn e_pow(x: f64) -> f64 {
    var n: i32 = 0
    var v: f64 = x
    while v > 0.6931471805599453 {
        v = v - 0.6931471805599453
        n = n + 1
    }
    while v < 0.0 - 0.6931471805599453 {
        v = v + 0.6931471805599453
        n = n - 1
    }
    var s: f64 = 1.0
    var p: f64 = 1.0
    var i: usize = 1
    while i < 14 {
        p = p * v / (i as f64)
        s = s + p
        i = i + 1
    }
    var m: f64 = 1.0
    var k: i32 = 0
    if n >= 0 {
        while k < n {
            m = m * 2.0
            k = k + 1
        }
    } else {
        while k > n {
            m = m / 2.0
            k = k - 1
        }
    }
    return s * m
}

// Die relative Leuchtdichte nach WCAG 2.
fn luminance(c: u32) -> f64 {
    let r: f64 = (((c >> 16) & 255 as u32) as f64) / 255.0
    let g: f64 = (((c >> 8) & 255 as u32) as f64) / 255.0
    let b: f64 = ((c & 255 as u32) as f64) / 255.0
    return 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b)
}

// Das Kontrastverhaeltnis zweier Colors, 1,0 bis 21,0.
fn contrast(a: u32, b: u32) -> f64 {
    let la: f64 = luminance(a)
    let lb: f64 = luminance(b)
    if la > lb {
        return (la + 0.05) / (lb + 0.05)
    }
    return (lb + 0.05) / (la + 0.05)
}

// Zwei Colors mischen, `t` in Promille (0 = a, 1000 = b). Kanalweise.
// Damit sind die abgeleiteten Colors top nachrechenbar und nicht bloss
// behauptet.
fn mix(a: u32, b: u32, t: usize) -> u32 {
    var tt: usize = t
    if tt > 1000 {
        tt = 1000
    }
    var out: u32 = 0
    var s: u32 = 16
    while true {
        let ca: usize = ((a >> s) & 255 as u32) as usize
        let cb: usize = ((b >> s) & 255 as u32) as usize
        var v: usize = 0
        if cb >= ca {
            v = ca + ((cb - ca) * tt + 500) / 1000
        } else {
            v = ca - ((ca - cb) * tt + 500) / 1000
        }
        out = out | ((v as u32) << s)
        if s == 0 as u32 {
            break
        }
        s = s - 8 as u32
    }
    return out
}

// 0xRRGGBB -> 0xAARRGGBB mit vollem Alpha. Die Leinwand will das.
fn opaque(c: u32) -> u32 {
    return c | 4278190080 as u32
}

// ====================================== DIE BRUECKE ZUM STILSYSTEM
//
// lib/fui/style.fi liegt im KERN und darf keine Farbtafel kennen -- es
// fuehrt Colors als TOKEN-NUMMER (TK_*). Hier steht die Abbildung von
// der Nummer auf die Farbe, und nur hier. Das ist der Grund, warum ein
// Themenwechsel die Widgets NICHT neu aufbaut (Justins Punkt 3): in den
// Widgets steht keine Farbe, sondern eine Nummer, und die Nummer
// bedeutet nach dem Wechsel etwas anderes.
fn color_from_token(m: *mut Theme, tk: u32) -> u32 {
    let f: *mut Colors = &(*m).f
    if tk == style.TOK_BASE { return (*f).base }
    if tk == style.TOK_SURFACE { return (*f).surface }
    if tk == style.TOK_SURFACE_RAISED { return (*f).surface_raised }
    if tk == style.TOK_BUTTON { return (*f).button }
    if tk == style.TOK_BUTTON_HOVER { return (*f).button_hover }
    if tk == style.TOK_BUTTON_ACTIVE { return (*f).button_active }
    if tk == style.TOK_FIELD { return (*f).field }
    if tk == style.TOK_FIELD_FOCUS { return (*f).field_focus }
    if tk == style.TOK_BORDER { return (*f).border_col }
    if tk == style.TOK_SEPARATOR { return (*f).separator }
    if tk == style.TOK_TEXT { return (*f).text }
    if tk == style.TOK_TEXT_MUTED { return (*f).text_muted }
    if tk == style.TOK_TEXT_DISABLED { return (*f).text_disabled }
    if tk == style.TOK_TEXT_ON_ACCENT { return (*f).text_on_accent }
    if tk == style.TOK_ACCENT { return (*f).accent }
    if tk == style.TOK_SELECTION { return (*f).selection }
    if tk == style.TOK_SELECTION_TEXT { return (*f).selection_text }
    if tk == style.TOK_ERROR { return (*f).err_col }
    if tk == style.TOK_WARNING { return (*f).warning }
    if tk == style.TOK_SUCCESS { return (*f).success }
    // Eine Nummer, die es nicht gibt: die Textfarbe. Sie ist auf jeder
    // Flaeche dieses Themas lesbar -- eine unbekannte Rolle soll
    // auffallen, aber nichts unsichtbar machen.
    return (*f).text
}

// Ein STILWERT (literal, token, transparent, erben) zu einer Farbe.
// Transparent und Erben haben keine Farbe -- der Aufrufer muss vorher
// `style.color_is_visible` fragen. Damit das nicht still schiefgeht,
// gibt es hier die Textfarbe zurueck und nicht Schwarz: ein
// vergessener Sichtbarkeitstest faellt dann auf.
fn color_from_style(m: *mut Theme, w: u32) -> u32 {
    let a: u32 = style.color_kind(w)
    if a == style.COLOR_LITERAL {
        return style.color_value(w)
    }
    if a == style.COLOR_TOKEN {
        return color_from_token(m, style.color_value(w))
    }
    return (*m).f.text
}
