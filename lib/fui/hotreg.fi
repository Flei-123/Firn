// SPDX-License-Identifier: MPL-2.0
// lib/fui/hotreg.fi -- WHO IS UNDER THE POINTER, FOR IMMEDIATE-MODE SCREENS.
//
// An immediate-mode screen draws its controls from its state and keeps no widget list, so nothing tells the
// pointer handler which control it stands on. This registry closes that gap: every control asks `state` while it
// is drawn (id + rect), the rects of the finished frame answer `move`/`down` between two frames, and the answer
// "the hot control changed" is the one reason to paint again.
//
//   begin_frame()                       the rects drawn so far become the hit list, the new list starts empty
//   state(id, x, y, w, h, enabled)      kit.ST_* bits for the control (hover / active / focus / disabled); registers it
//   move(x, y) -> bool                  the pointer moved; true = the hot control changed (paint again)
//   down(x, y) -> bool, up() -> bool    press / release; true = the look changed
//   leave() -> bool                     the pointer left the window
//   touch(on)                           a finger drives: no hover stays behind, the press ends with the finger
//   over() -> bool                      a control is under the pointer (cursor "pointer")
//   hot(), pressed()                    the ids; 0 = none (ids must not be 0)
//   set_focus(id)                       the control that has the keyboard focus (its state carries ST_FOCUS)
//
// Rects are in whatever space the caller hit-tests in; the registry only compares numbers. Later controls win over
// earlier ones (they are drawn on top).
import fui.kit

export { begin_frame, state, move, down, up, leave, touch, over, hot, pressed, set_focus, focus, reset, registered, HOT_MAX }

const HOT_MAX: usize = 1024

static mut CUR_N: usize = 0
static mut NEXT_N: usize = 0
static mut CUR_ID: [u32; 1024] = [0 as u32; 1024]
static mut CUR_X: [f64; 1024] = [0.0; 1024]
static mut CUR_Y: [f64; 1024] = [0.0; 1024]
static mut CUR_W: [f64; 1024] = [0.0; 1024]
static mut CUR_H: [f64; 1024] = [0.0; 1024]
static mut NEXT_ID: [u32; 1024] = [0 as u32; 1024]
static mut NEXT_X: [f64; 1024] = [0.0; 1024]
static mut NEXT_Y: [f64; 1024] = [0.0; 1024]
static mut NEXT_W: [f64; 1024] = [0.0; 1024]
static mut NEXT_H: [f64; 1024] = [0.0; 1024]
static mut HOT: u32 = 0 as u32
static mut DOWN: u32 = 0 as u32
static mut FOCUS: u32 = 0 as u32
static mut TOUCH: bool = false

fn begin_frame() {
    var i: usize = 0
    while i < NEXT_N {
        CUR_ID[i] = NEXT_ID[i]
        CUR_X[i] = NEXT_X[i]
        CUR_Y[i] = NEXT_Y[i]
        CUR_W[i] = NEXT_W[i]
        CUR_H[i] = NEXT_H[i]
        i = i + 1
    }
    CUR_N = NEXT_N
    NEXT_N = 0
}

fn reset() {
    CUR_N = 0
    NEXT_N = 0
    HOT = 0 as u32
    DOWN = 0 as u32
    FOCUS = 0 as u32
    TOUCH = false
}

fn registered() -> usize {
    return NEXT_N
}

fn state(id: u32, x: f64, y: f64, w: f64, h: f64, enabled: bool) -> u32 {
    if !enabled {
        return kit.ST_DISABLED
    }
    if NEXT_N < HOT_MAX && id != 0 as u32 {
        NEXT_ID[NEXT_N] = id
        NEXT_X[NEXT_N] = x
        NEXT_Y[NEXT_N] = y
        NEXT_W[NEXT_N] = w
        NEXT_H[NEXT_N] = h
        NEXT_N = NEXT_N + 1
    }
    var st: u32 = 0 as u32
    if id == HOT && id != 0 as u32 {
        st = st | kit.ST_HOVER
    }
    if id == DOWN && id != 0 as u32 {
        st = st | kit.ST_ACTIVE
    }
    if id == FOCUS && id != 0 as u32 {
        st = st | kit.ST_FOCUS
    }
    return st
}

fn id_at(x: f64, y: f64) -> u32 {
    var i: usize = CUR_N
    while i > 0 {
        i = i - 1
        if x >= CUR_X[i] && x < CUR_X[i] + CUR_W[i] && y >= CUR_Y[i] && y < CUR_Y[i] + CUR_H[i] {
            return CUR_ID[i]
        }
    }
    return 0 as u32
}

fn move(x: f64, y: f64) -> bool {
    if TOUCH {
        return false
    }
    let id: u32 = id_at(x, y)
    if id == HOT {
        return false
    }
    HOT = id
    return true
}

fn down(x: f64, y: f64) -> bool {
    let id: u32 = id_at(x, y)
    var changed: bool = id != DOWN
    if !TOUCH && id != HOT {
        HOT = id
        changed = true
    }
    DOWN = id
    return changed
}

fn up() -> bool {
    var changed: bool = DOWN != 0 as u32
    DOWN = 0 as u32
    if TOUCH && HOT != 0 as u32 {
        HOT = 0 as u32
        changed = true
    }
    return changed
}

fn leave() -> bool {
    let changed: bool = HOT != 0 as u32 || DOWN != 0 as u32
    HOT = 0 as u32
    DOWN = 0 as u32
    return changed
}

fn touch(on: bool) {
    TOUCH = on
    if on {
        HOT = 0 as u32
    }
}

fn over() -> bool {
    return HOT != 0 as u32
}

fn hot() -> u32 {
    return HOT
}

fn pressed() -> u32 {
    return DOWN
}

fn set_focus(id: u32) {
    FOCUS = id
}

fn focus() -> u32 {
    return FOCUS
}
