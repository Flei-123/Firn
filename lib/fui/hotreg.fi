// SPDX-License-Identifier: MPL-2.0
// lib/fui/hotreg.fi -- WHO IS UNDER THE POINTER, FOR IMMEDIATE-MODE SCREENS.
//
// An immediate-mode screen draws its controls from its state and keeps no widget list, so nothing tells the
// pointer handler which control it stands on. This registry closes that gap: every control asks `state` while it
// is drawn (id + rect), the rects of the finished frame answer `move`/`down` between two frames, and the answer
// "the hot control changed" is the one reason to paint again.
//
//   begin_frame()                       the rects drawn so far become the hit list, the new list starts empty
//   state(id, x, y, w, h, enabled)      kit.ST_* bits for the control (hover / active / focus / disabled); registers it
//   move(x, y) -> bool                  the pointer moved; true = the hot control changed (paint again)
//   down(x, y) -> bool, up() -> bool    press / release; true = the look changed
//   leave() -> bool                     the pointer left the window
//   touch(on)                           a finger drives: no hover stays behind, the press ends with the finger
//   over() -> bool                      a control is under the pointer (cursor "pointer")
//   hot(), pressed()                    the ids; 0 = none (ids must not be 0)
//   set_focus(id)                       the control that has the keyboard focus (its state carries ST_FOCUS)
//   clip_push(x, y, w, h), clip_pop()   controls drawn inside are only hit where the clip shows them (nested clips intersect)
//
// Rects are in whatever space the caller hit-tests in; the registry only compares numbers. Later controls win over
// earlier ones (they are drawn on top).
import fui.kit

export { begin_frame, state, move, down, up, leave, touch, over, hot, pressed, set_focus, focus, reset, registered, clip_push, clip_pop, press_settle, press_cancel, press_pending, HOT_MAX }

const HOT_MAX: usize = 1024

static mut CUR_N: usize = 0
static mut NEXT_N: usize = 0
static mut CUR_ID: [u32; 1024] = [0 as u32; 1024]
static mut CUR_X: [f64; 1024] = [0.0; 1024]
static mut CUR_Y: [f64; 1024] = [0.0; 1024]
static mut CUR_W: [f64; 1024] = [0.0; 1024]
static mut CUR_H: [f64; 1024] = [0.0; 1024]
static mut NEXT_ID: [u32; 1024] = [0 as u32; 1024]
static mut NEXT_X: [f64; 1024] = [0.0; 1024]
static mut NEXT_Y: [f64; 1024] = [0.0; 1024]
static mut NEXT_W: [f64; 1024] = [0.0; 1024]
static mut NEXT_H: [f64; 1024] = [0.0; 1024]
static mut HOT: u32 = 0 as u32
static mut DOWN: u32 = 0 as u32
static mut PEND: u32 = 0 as u32
static mut FOCUS: u32 = 0 as u32
static mut TOUCH: bool = false
const CLIP_MAX: usize = 16
static mut CLIP_N: usize = 0
static mut CLIP_X0: [f64; 16] = [0.0; 16]
static mut CLIP_Y0: [f64; 16] = [0.0; 16]
static mut CLIP_X1: [f64; 16] = [0.0; 16]
static mut CLIP_Y1: [f64; 16] = [0.0; 16]

fn begin_frame() {
    var i: usize = 0
    while i < NEXT_N {
        CUR_ID[i] = NEXT_ID[i]
        CUR_X[i] = NEXT_X[i]
        CUR_Y[i] = NEXT_Y[i]
        CUR_W[i] = NEXT_W[i]
        CUR_H[i] = NEXT_H[i]
        i = i + 1
    }
    CUR_N = NEXT_N
    NEXT_N = 0
}

fn clip_push(x: f64, y: f64, w: f64, h: f64) {
    if CLIP_N >= CLIP_MAX {
        return
    }
    var x0: f64 = x
    var y0: f64 = y
    var x1: f64 = x + w
    var y1: f64 = y + h
    if CLIP_N > 0 {
        let t: usize = CLIP_N - 1
        if CLIP_X0[t] > x0 { x0 = CLIP_X0[t] }
        if CLIP_Y0[t] > y0 { y0 = CLIP_Y0[t] }
        if CLIP_X1[t] < x1 { x1 = CLIP_X1[t] }
        if CLIP_Y1[t] < y1 { y1 = CLIP_Y1[t] }
    }
    CLIP_X0[CLIP_N] = x0
    CLIP_Y0[CLIP_N] = y0
    CLIP_X1[CLIP_N] = x1
    CLIP_Y1[CLIP_N] = y1
    CLIP_N = CLIP_N + 1
}

fn clip_pop() {
    if CLIP_N > 0 {
        CLIP_N = CLIP_N - 1
    }
}

fn reset() {
    CLIP_N = 0
    CUR_N = 0
    NEXT_N = 0
    HOT = 0 as u32
    DOWN = 0 as u32
    PEND = 0 as u32
    FOCUS = 0 as u32
    TOUCH = false
}

fn registered() -> usize {
    return NEXT_N
}

fn state(id: u32, x: f64, y: f64, w: f64, h: f64, enabled: bool) -> u32 {
    if !enabled {
        return kit.ST_DISABLED
    }
    var rx: f64 = x
    var ry: f64 = y
    var rw: f64 = w
    var rh: f64 = h
    if CLIP_N > 0 {
        let t: usize = CLIP_N - 1
        var x1: f64 = x + w
        var y1: f64 = y + h
        if CLIP_X0[t] > rx { rx = CLIP_X0[t] }
        if CLIP_Y0[t] > ry { ry = CLIP_Y0[t] }
        if CLIP_X1[t] < x1 { x1 = CLIP_X1[t] }
        if CLIP_Y1[t] < y1 { y1 = CLIP_Y1[t] }
        if x1 <= rx || y1 <= ry {
            return 0 as u32
        }
        rw = x1 - rx
        rh = y1 - ry
    }
    if NEXT_N < HOT_MAX && id != 0 as u32 {
        NEXT_ID[NEXT_N] = id
        NEXT_X[NEXT_N] = rx
        NEXT_Y[NEXT_N] = ry
        NEXT_W[NEXT_N] = rw
        NEXT_H[NEXT_N] = rh
        NEXT_N = NEXT_N + 1
    }
    var st: u32 = 0 as u32
    if id == HOT && id != 0 as u32 {
        st = st | kit.ST_HOVER
    }
    if id == DOWN && id != 0 as u32 {
        st = st | kit.ST_ACTIVE
    }
    if id == FOCUS && id != 0 as u32 {
        st = st | kit.ST_FOCUS
    }
    return st
}

fn id_at(x: f64, y: f64) -> u32 {
    var i: usize = CUR_N
    while i > 0 {
        i = i - 1
        if x >= CUR_X[i] && x < CUR_X[i] + CUR_W[i] && y >= CUR_Y[i] && y < CUR_Y[i] + CUR_H[i] {
            return CUR_ID[i]
        }
    }
    return 0 as u32
}

fn move(x: f64, y: f64) -> bool {
    if TOUCH {
        return false
    }
    let id: u32 = id_at(x, y)
    if id == HOT {
        return false
    }
    HOT = id
    return true
}

fn down(x: f64, y: f64) -> bool {
    let id: u32 = id_at(x, y)
    var changed: bool = id != DOWN
    if !TOUCH && id != HOT {
        HOT = id
        changed = true
    }
    if TOUCH {
        PEND = id
        let was: bool = DOWN != 0 as u32
        DOWN = 0 as u32
        return was
    }
    DOWN = id
    return changed
}

fn press_pending() -> bool {
    return PEND != 0 as u32
}

fn press_settle() -> bool {
    if PEND == 0 as u32 {
        return false
    }
    DOWN = PEND
    PEND = 0 as u32
    return true
}

fn press_cancel() -> bool {
    let changed: bool = DOWN != 0 as u32
    DOWN = 0 as u32
    PEND = 0 as u32
    return changed
}

fn up() -> bool {
    var changed: bool = DOWN != 0 as u32
    DOWN = 0 as u32
    PEND = 0 as u32
    if TOUCH && HOT != 0 as u32 {
        HOT = 0 as u32
        changed = true
    }
    return changed
}

fn leave() -> bool {
    let changed: bool = HOT != 0 as u32 || DOWN != 0 as u32
    HOT = 0 as u32
    DOWN = 0 as u32
    PEND = 0 as u32
    return changed
}

fn touch(on: bool) {
    TOUCH = on
    if on {
        HOT = 0 as u32
    }
}

fn over() -> bool {
    return HOT != 0 as u32
}

fn hot() -> u32 {
    return HOT
}

fn pressed() -> u32 {
    return DOWN
}

fn set_focus(id: u32) {
    FOCUS = id
}

fn focus() -> u32 {
    return FOCUS
}
