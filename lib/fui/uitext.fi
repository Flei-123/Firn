// SPDX-License-Identifier: MPL-2.0
import std.rt

export {
    U_CHAR, U_FORMAT, U_WORD, U_LINE, U_PARAGRAPH, U_PAGE, U_DOCUMENT, EP_START, EP_END, NONE,
    is_boundary, next_boundary, prev_boundary, floor_boundary, step_position, expand, move_range, move_endpoint,
    compare_endpoints, find_text, clamp,
}

const U_CHAR: u32 = 0
const U_FORMAT: u32 = 1
const U_WORD: u32 = 2
const U_LINE: u32 = 3
const U_PARAGRAPH: u32 = 4
const U_PAGE: u32 = 5
const U_DOCUMENT: u32 = 6
const EP_START: u32 = 0
const EP_END: u32 = 1
const NONE: usize = 4294967295

fn byte_at(p: u64, i: usize) -> u32 { return rt.ld8(p, i) as u32 }

fn char_class(c: u32) -> u32 {
    if c == 10 as u32 { return 1 as u32 }
    if c == 32 as u32 || c == 9 as u32 || c == 13 as u32 { return 0 as u32 }
    if c >= 128 as u32 { return 2 as u32 }
    if c >= 48 as u32 && c <= 57 as u32 { return 2 as u32 }
    if c >= 65 as u32 && c <= 90 as u32 { return 2 as u32 }
    if c >= 97 as u32 && c <= 122 as u32 { return 2 as u32 }
    if c == 95 as u32 { return 2 as u32 }
    return 3 as u32
}

fn clamp(v: usize, n: usize) -> usize {
    if v > n { return n }
    return v
}

fn is_char_start(p: u64, i: usize) -> bool {
    return (byte_at(p, i) & 192 as u32) != 128 as u32
}

fn is_boundary(unit: u32, p: u64, n: usize, i: usize) -> bool {
    if i == 0 || i >= n { return true }
    if unit == U_CHAR { return is_char_start(p, i) }
    if unit == U_WORD {
        if !is_char_start(p, i) { return false }
        let cur: u32 = char_class(byte_at(p, i))
        let prev: u32 = char_class(byte_at(p, i - 1))
        if cur == 1 as u32 || prev == 1 as u32 { return true }
        if cur == 0 as u32 { return false }
        return prev == 0 as u32 || prev != cur
    }
    if unit == U_LINE || unit == U_PARAGRAPH { return byte_at(p, i - 1) == 10 as u32 }
    return false
}

fn next_boundary(unit: u32, p: u64, n: usize, i: usize) -> usize {
    if i >= n { return n }
    var j: usize = i + 1
    while j < n && !is_boundary(unit, p, n, j) { j = j + 1 }
    return clamp(j, n)
}

fn prev_boundary(unit: u32, p: u64, n: usize, i: usize) -> usize {
    if i == 0 { return 0 }
    if i > n { return n }
    var j: usize = i - 1
    while j > 0 && !is_boundary(unit, p, n, j) { j = j - 1 }
    return j
}

fn floor_boundary(unit: u32, p: u64, n: usize, i: usize) -> usize {
    if i >= n { return n }
    var j: usize = i
    while j > 0 && !is_boundary(unit, p, n, j) { j = j - 1 }
    return j
}

fn step_position(unit: u32, p: u64, n: usize, i: usize, count: i64, moved: *mut i64) -> usize {
    var pos: usize = clamp(i, n)
    var m: i64 = 0
    if count > 0 {
        while m < count {
            let nb: usize = next_boundary(unit, p, n, pos)
            if nb == pos { break }
            pos = nb
            m = m + 1
        }
    } else if count < 0 {
        let want: i64 = 0 - count
        var k: i64 = 0
        while k < want {
            if pos == 0 { break }
            pos = prev_boundary(unit, p, n, pos)
            k = k + 1
        }
        m = 0 - k
    }
    *moved = m
    return pos
}

fn expand(unit: u32, p: u64, n: usize, s: *mut usize, e: *mut usize) {
    if unit == U_DOCUMENT || unit == U_PAGE || unit == U_FORMAT {
        *s = 0
        *e = n
        return
    }
    let ns: usize = floor_boundary(unit, p, n, *s)
    *s = ns
    *e = next_boundary(unit, p, n, ns)
}

fn move_range(unit: u32, p: u64, n: usize, s: *mut usize, e: *mut usize, count: i64) -> i64 {
    let degenerate: bool = *s == *e
    if !degenerate { expand(unit, p, n, s, e) }
    var moved: i64 = 0
    var ns: usize = step_position(unit, p, n, *s, count, &moved)
    if degenerate {
        *s = ns
        *e = ns
        return moved
    }
    if ns >= n && n > 0 && moved > 0 {
        ns = prev_boundary(unit, p, n, n)
        moved = moved - 1
    }
    *s = ns
    *e = next_boundary(unit, p, n, ns)
    return moved
}

fn move_endpoint(unit: u32, p: u64, n: usize, s: *mut usize, e: *mut usize, endpoint: u32, count: i64) -> i64 {
    var moved: i64 = 0
    if endpoint == EP_START {
        *s = step_position(unit, p, n, *s, count, &moved)
        if *s > *e { *e = *s }
    } else {
        *e = step_position(unit, p, n, *e, count, &moved)
        if *e < *s { *s = *e }
    }
    return moved
}

fn compare_endpoints(a_s: usize, a_e: usize, a_ep: u32, b_s: usize, b_e: usize, b_ep: u32) -> i32 {
    var va: usize = a_e
    if a_ep == EP_START { va = a_s }
    var vb: usize = b_e
    if b_ep == EP_START { vb = b_s }
    if va < vb { return -1 }
    if va > vb { return 1 }
    return 0
}

fn lower(c: u32) -> u32 {
    if c >= 65 as u32 && c <= 90 as u32 { return c + 32 as u32 }
    return c
}

fn matches_at(p: u64, at: usize, q: u64, m: usize, fold: bool) -> bool {
    var k: usize = 0
    while k < m {
        var a: u32 = byte_at(p, at + k)
        var b: u32 = byte_at(q, k)
        if fold {
            a = lower(a)
            b = lower(b)
        }
        if a != b { return false }
        k = k + 1
    }
    return true
}

fn find_text(p: u64, s: usize, e: usize, q: u64, m: usize, backward: bool, fold: bool, found: *mut usize) -> bool {
    if m == 0 || e < s || e - s < m { return false }
    let last: usize = e - m
    if backward {
        var i: usize = last + 1
        while i > s {
            i = i - 1
            if matches_at(p, i, q, m, fold) {
                *found = i
                return true
            }
        }
        return false
    }
    var j: usize = s
    while j <= last {
        if matches_at(p, j, q, m, fold) {
            *found = j
            return true
        }
        j = j + 1
    }
    return false
}
