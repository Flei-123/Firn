import std.rt
import fui.render
import fui.style
import fui.widget
import fui.theme
import fui.textbind

const FIELD_CAP: usize = 128
const HINT_PAD: f64 = 12.0
const HINT_PX: usize = 14

struct Field {
    b: [u8; 128],
    n: usize,
    cur: usize,
    anc: usize,
    secret: bool,
    x: f64,
    y: f64,
    w: f64,
    h: f64,
}

fn field_new() -> Field {
    return Field { b: [0; 128], n: 0, cur: 0, anc: 0, secret: false, x: 0.0, y: 0.0,
        w: 0.0, h: 0.0 }
}

fn field_secret() -> Field {
    var f: Field = field_new()
    f.secret = true
    return f
}

fn field_ptr(f: *mut Field) -> u64 {
    return (&(*f).b[0]) as u64
}

fn field_len(f: *mut Field) -> usize {
    return (*f).n
}

fn field_clear(f: *mut Field) {
    (*f).n = 0
    (*f).cur = 0
    (*f).anc = 0
}

fn field_owner(f: *mut Field) -> i64 {
    return (f as u64) as i64
}

fn bind(f: *mut Field) {
    textbind.bind(field_owner(f), field_ptr(f), (*f).n, (*f).cur, (*f).anc, false,
        (*f).secret)
}

fn store(f: *mut Field) {
    (*f).n = textbind.out(field_ptr(f), FIELD_CAP, &(*f).cur, &(*f).anc)
}

fn field_focus(f: *mut Field) {
    (*f).cur = (*f).n
    (*f).anc = (*f).n
}

fn field_insert(f: *mut Field, p: u64, n: usize) -> bool {
    bind(f)
    let any: bool = textbind.insert(p, n, FIELD_CAP)
    store(f)
    return any
}

fn field_key(f: *mut Field, p: u64, n: usize, ctrl: bool, shift: bool,
    alt: bool) -> u32 {
    bind(f)
    let r: u32 = textbind.key(p, n, ctrl, shift, alt, FIELD_CAP)
    store(f)
    return r
}

fn field_inside(f: *mut Field, x: f64, y: f64) -> bool {
    return x >= (*f).x && x < (*f).x + (*f).w && y >= (*f).y && y < (*f).y + (*f).h
}

fn field_box(f: *mut Field) {
    textbind.box_set((*f).x, (*f).y, (*f).w, (*f).h)
}

fn field_press(f: *mut Field, c: *mut render.Ctx, x: f64, y: f64, shift: bool,
    now_us: u64) {
    bind(f)
    field_box(f)
    textbind.press(c, x, y, shift, now_us, (*f).secret)
    store(f)
}

fn field_drag(f: *mut Field, c: *mut render.Ctx, x: f64, y: f64) -> bool {
    if !textbind.dragging() {
        return false
    }
    bind(f)
    field_box(f)
    textbind.drag(c, x, y, (*f).secret)
    store(f)
    return true
}

fn field_release() {
    textbind.release_mouse()
}

fn hint_draw(c: *mut render.Ctx, ox: f64, x: f64, y: f64, w: f64, h: f64, hint: str) {
    let k: f64 = (theme.theme_scale(render.ctx_theme(c)) as f64) / 1000.0
    var e: widget.Widget = widget.widget_new(widget.KIND_LABEL)
    widget.w_place(&e, (x + ox + HINT_PAD) * k, (y + (h - (HINT_PX as f64) - 4.0) / 2.0) * k,
        (w - 2.0 * HINT_PAD) * k, ((HINT_PX as f64) + 4.0) * k)
    widget.w_set_text(&e, hint.p as u64, hint.n)
    let s: *mut style.Style = widget.w_style(&e)
    *s = style.style_set_fg(*s, style.color_token(style.TOK_TEXT_DISABLED))
    *s = style.style_set_font(*s, 0, HINT_PX)
    *s = style.style_set_pad(*s, 0, 0)
    render.draw_label(c, &e)
}

fn field_paint(c: *mut render.Ctx, ox: f64, f: *mut Field, x: f64, y: f64, w: f64,
    h: f64, hint: str, focus: bool) {
    (*f).x = x
    (*f).y = y
    (*f).w = w
    (*f).h = h
    if focus {
        bind(f)
        textbind.paint_active(c, ox, x, y, w, h, false, (*f).secret)
    } else {
        textbind.paint_idle(c, ox, x, y, w, h, field_ptr(f), (*f).n, false, (*f).secret)
    }
    if (*f).n == 0 {
        hint_draw(c, ox, x, y, w, h, hint)
    }
}
