import fui.viewport

export {
    Scroller, scroller_init, fit, offset, position, reset, limit, wheel_by, drag, fling, stop, tick, moving, over,
}

struct Scroller {
    vp: viewport.Viewport,
}

fn scroller_init(s: *mut Scroller) {
    (*s).vp = viewport.viewport_new(0.0, 0.0, 100.0, 100.0, 100.0, 100.0)
    viewport.viewport_set_bar(&(*s).vp, 0)
}

fn fit(s: *mut Scroller, x: f64, y: f64, w: f64, h: f64, content_h: f64) {
    viewport.viewport_set_rect(&(*s).vp, x, y, w, h)
    viewport.viewport_set_content(&(*s).vp, w, content_h)
}

fn offset(s: *mut Scroller) -> f64 {
    return viewport.viewport_off_y(&(*s).vp) + viewport.viewport_over_y(&(*s).vp)
}

fn position(s: *mut Scroller) -> f64 { return viewport.viewport_off_y(&(*s).vp) }

fn over(s: *mut Scroller) -> f64 { return viewport.viewport_over_y(&(*s).vp) }

fn limit(s: *mut Scroller) -> f64 { return viewport.viewport_max_y(&(*s).vp) }

fn reset(s: *mut Scroller) {
    viewport.viewport_set_overscroll(&(*s).vp, false)
    viewport.viewport_set_offset(&(*s).vp, 0.0, 0.0)
}

fn wheel_by(s: *mut Scroller, dy: f64) {
    viewport.viewport_scroll_by(&(*s).vp, 0.0, dy)
}

fn drag(s: *mut Scroller, dy: f64, ms: i64) {
    viewport.viewport_set_overscroll(&(*s).vp, true)
    viewport.viewport_drag(&(*s).vp, 0.0, 0.0 - dy, ms)
}

fn fling(s: *mut Scroller, vy_per_ms: f64, ms: i64, ppi: f64) {
    if viewport.viewport_over_y(&(*s).vp) != 0.0 { return }
    viewport.viewport_fling_android(&(*s).vp, 0.0, 0.0 - vy_per_ms, ms, ppi)
}

fn stop(s: *mut Scroller) {
    viewport.viewport_drag(&(*s).vp, 0.0, 0.0, 0 as i64)
}

fn tick(s: *mut Scroller, ms: i64) -> bool {
    return viewport.viewport_tick(&(*s).vp, ms)
}

fn moving(s: *mut Scroller) -> bool {
    return viewport.viewport_moving(&(*s).vp)
}
