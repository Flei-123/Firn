// SPDX-License-Identifier: MPL-2.0
// lib/fui/vlistview.fi -- PAINTS A VIRTUAL LIST (lib/fui/vlist.fi) INTO ONE NODE.
//
// `vv_paint(v, c, e, focused, ud, f)` is the draw function of a scene node
// (scene.node_set_draw): it draws the frame (wave3.draw_list), the header of
// a table (titles, dividers, the sort arrow), and ONLY THE ROWS THAT SHOW --
// each one asked from the source `f(ud, index, &row)` -- with the hover,
// selection and focus look of lib/fui/wave3.fi, the symbol of column 0 and
// the right-aligned detail text of a list row. Then the scroll bar.
// A tree with 100000 rows costs what 25 rows cost.
//
// The row height in the model is in px; `vv_row_px` turns design points
// (0 = the theme's row height) into px at the scale of the context.
//
// The answer of `vv_paint` is true while a kinetic scroll is still running:
// the window has to paint again.
import fui.vlist
import fui.viewport
import fui.render
import fui.widget
import fui.wave3
import fui.theme
import fui.style
import fui.painter
import fui.icons
import fui.lucide
import paint.canvas

export { vv_paint, vv_row_px, vv_header_px }

// design points of the header
const HEADER_PT: usize = 26

fn vv_row_px(c: *mut render.Ctx, pt: usize) -> f64 {
    if pt == 0 {
        return wave3.row_height(c)
    }
    return render.len_of(c, pt)
}

fn vv_header_px(c: *mut render.Ctx) -> f64 {
    let a: f64 = render.len_of(c, HEADER_PT)
    let b: f64 = wave3.row_height(c)
    if a > b {
        return a
    }
    return b
}

fn draw_header(v: *mut vlist.Vlist, c: *mut render.Ctx, x: f64, y: f64, w: f64) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let h: f64 = vlist.vl_header_h(v)
    painter.surface(z, x, y, w, h, render.color_of(c, style.color_token(style.TOK_SURFACE_RAISED)))
    let line: u32 = render.color_of(c, style.color_token(style.TOK_BORDER))
    painter.surface(z, x, y + h - 1.0, w, 1.0, line)
    let padx: f64 = render.len_of(c, 8)
    var k: usize = 0
    while k < vlist.vl_columns(v) {
        let cx: f64 = x + vlist.vl_col_x(v, k)
        let cw: f64 = vlist.vl_col_width(v, k)
        let t: str = vlist.vl_col_title(v, k)
        var tw: f64 = cw - 2.0 * padx
        if vlist.vl_sort_col(v) == k {
            tw = tw - render.len_of(c, 14)
        }
        wave3.cell_text(c, t.p as u64, t.n, cx + padx, y, tw, h,
            style.color_token(style.TOK_TEXT), style.ALIGN_LEFT, false, 0)
        if vlist.vl_sort_col(v) == k {
            var id: i64 = lucide.CHEVRON_UP
            if vlist.vl_sort_desc(v) {
                id = lucide.CHEVRON_DOWN
            }
            let side: f64 = render.len_of(c, 12)
            icons.icon(z, id, cx + cw - padx - side, y + (h - side) / 2.0, side,
                render.color_of(c, style.color_token(style.TOK_TEXT_MUTED)))
        }
        // the divider after the cell
        if k + 1 < vlist.vl_columns(v) {
            painter.surface(z, cx + cw - 1.0, y + h * 0.25, 1.0, h * 0.5, line)
        }
        k = k + 1
    }
}

fn draw_cell(v: *mut vlist.Vlist, c: *mut render.Ctx, r: *mut vlist.VRow, x: f64, y: f64, w: f64, h: f64,
    fg: u32, muted: u32, icon_ok: bool) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    var tx: f64 = x
    var tw: f64 = w
    if icon_ok && (*r).icon >= 0 as i64 {
        let side: f64 = render.len_of(c, 16)
        icons.icon(z, (*r).icon, x, y + (h - side) / 2.0, side, render.color_of(c, fg))
        tx = x + side + render.len_of(c, 8)
        tw = w - side - render.len_of(c, 8)
    }
    var dw: f64 = 0.0
    if (*r).dn > 0 && tw > 0.0 {
        dw = painter.text_width(z, (&(*r).detail[0]) as u64, (*r).dn, render.text_len_of(c, 13)) + render.len_of(c, 8)
        if dw > tw / 2.0 {
            dw = tw / 2.0
        }
        wave3.cell_text(c, (&(*r).detail[0]) as u64, (*r).dn, tx + tw - dw, y, dw, h,
            muted, style.ALIGN_RIGHT, true, 13)
    }
    if tw - dw > 0.0 {
        wave3.cell_text(c, (&(*r).text[0]) as u64, (*r).n, tx, y, tw - dw, h, fg, style.ALIGN_LEFT, (*r).px > 0, (*r).px)
    }
}

// A CARD ROW (VRow.sn > 0): rounded card with a hairline, a leading icon (optionally tinted), a title, a quieter subtitle line and
// a trailing outlined pill (VRow.detail). The card leaves 4 pt free above and below, so neighbours are 8 pt apart. Design points:
// radius 16, padding 12, icon 24, title 14, subtitle 12, pill text 12.
fn draw_project_card(c: *mut render.Ctx, r: *mut vlist.VRow, x: f64, y: f64, w: f64, h: f64, sel: bool) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let gap: f64 = render.len_of(c, 4)
    let cx: f64 = x
    let cy: f64 = y + gap
    let ch: f64 = h - 2.0 * gap
    let rad: f64 = render.len_of(c, 14)
    var bg: u32 = render.color_of(c, style.color_token(style.TOK_SURFACE))
    if sel {
        bg = render.color_of(c, style.color_token(style.TOK_SELECTION))
    }
    painter.round_rect(z, cx, cy, w, ch, rad, bg)
    painter.round_ring(z, cx, cy, w, ch, rad, 1.0, render.color_of(c, style.color_token(style.TOK_SEPARATOR)))
    let pad: f64 = render.len_of(c, 12)
    let tx: f64 = cx + pad
    let tw: f64 = w - 2.0 * pad
    var ty: f64 = cy + render.len_of(c, 8)
    let lh1: f64 = render.len_of(c, 22)
    let lh2: f64 = render.len_of(c, 17)
    // title + accent percent right behind it
    wave3.cell_text(c, (&(*r).text[0]) as u64, (*r).n, tx, ty, tw, lh1, style.color_token(style.TOK_TEXT), style.ALIGN_LEFT, true, 16)
    if (*r).dn > 0 {
        let nw: f64 = painter.text_width(z, (&(*r).text[0]) as u64, (*r).n, render.text_len_of(c, 16)) + render.len_of(c, 10)
        wave3.cell_text(c, (&(*r).detail[0]) as u64, (*r).dn, tx + nw, ty, tw - nw, lh1, style.color_token(style.TOK_ACCENT),
            style.ALIGN_LEFT, true, 16)
    }
    ty = ty + lh1 + render.len_of(c, 6)
    // progress bar: 6 pt track, accent fill
    let bh: f64 = render.len_of(c, 6)
    painter.round_rect(z, tx, ty, tw, bh, bh * 0.5, render.color_of(c, style.color_token(style.TOK_FIELD)))
    var pc: i64 = (*r).bar
    if pc > 100 {
        pc = 100
    }
    if pc > 0 {
        painter.round_rect(z, tx, ty, tw * (pc as f64) / 100.0, bh, bh * 0.5, render.color_of(c, style.color_token(style.TOK_ACCENT)))
    }
    ty = ty + bh + render.len_of(c, 6)
    wave3.cell_text(c, (&(*r).sub[0]) as u64, (*r).sn, tx, ty, tw, lh2, style.color_token(style.TOK_TEXT_MUTED), style.ALIGN_LEFT, true, 12)
    ty = ty + lh2
    if (*r).s2n > 0 {
        wave3.cell_text(c, (&(*r).sub2[0]) as u64, (*r).s2n, tx, ty, tw, lh2, style.color_token(style.TOK_TEXT), style.ALIGN_LEFT, true, 12)
        ty = ty + lh2
    }
    if (*r).s3n > 0 {
        wave3.cell_text(c, (&(*r).sub3[0]) as u64, (*r).s3n, tx, ty, tw, lh2, style.color_token(style.TOK_ERROR), style.ALIGN_LEFT, true, 12)
    }
}

fn draw_card(c: *mut render.Ctx, r: *mut vlist.VRow, x: f64, y: f64, w: f64, h: f64, sel: bool) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let gap: f64 = render.len_of(c, 4)
    let cx: f64 = x
    let cy: f64 = y + gap
    let cw: f64 = w
    let ch: f64 = h - 2.0 * gap
    let rad: f64 = render.len_of(c, 16)
    var bg: u32 = render.color_of(c, style.color_token(style.TOK_SURFACE))
    if sel {
        bg = render.color_of(c, style.color_token(style.TOK_SELECTION))
    }
    painter.round_rect(z, cx, cy, cw, ch, rad, bg)
    painter.round_ring(z, cx, cy, cw, ch, rad, 1.0, render.color_of(c, style.color_token(style.TOK_SEPARATOR)))
    let pad: f64 = render.len_of(c, 12)
    let isz: f64 = render.len_of(c, 24)
    var fg: u32 = style.color_token(style.TOK_TEXT)
    var icol: u32 = fg
    if (*r).tint_on {
        icol = style.color_literal((*r).tint)
    }
    var tx: f64 = cx + pad
    if (*r).icon >= 0 as i64 {
        icons.icon(z, (*r).icon, cx + pad, cy + (ch - isz) / 2.0, isz, render.color_of(c, icol))
        tx = cx + pad + isz + render.len_of(c, 12)
    }
    var right: f64 = cx + cw - pad
    if (*r).dn > 0 {
        let ps: f64 = render.text_len_of(c, 12)
        let pw: f64 = painter.text_width(z, (&(*r).detail[0]) as u64, (*r).dn, ps) + 2.0 * render.len_of(c, 10)
        let ph: f64 = render.len_of(c, 24)
        let px0: f64 = right - pw
        let py0: f64 = cy + (ch - ph) / 2.0
        var ring: u32 = render.color_of(c, style.color_token(style.TOK_BORDER))
        var ptx: u32 = style.color_token(style.TOK_TEXT_MUTED)
        if (*r).pill_tint != 0 as u32 {
            ring = render.color_of(c, style.color_literal((*r).pill_tint))
            ptx = style.color_literal((*r).pill_tint)
        }
        painter.round_ring(z, px0, py0, pw, ph, render.len_of(c, 12), 1.0, ring)
        wave3.cell_text(c, (&(*r).detail[0]) as u64, (*r).dn, px0, py0, pw, ph, ptx,
            style.ALIGN_CENTER, true, 12)
        right = px0 - render.len_of(c, 8)
    }
    let lh1: f64 = render.len_of(c, 20)
    let lh2: f64 = render.len_of(c, 16)
    let ty: f64 = cy + (ch - lh1 - lh2) / 2.0
    var tpx: usize = 14
    if (*r).px > 0 {
        tpx = (*r).px
    }
    wave3.cell_text(c, (&(*r).text[0]) as u64, (*r).n, tx, ty, right - tx, lh1, fg, style.ALIGN_LEFT, true, tpx)
    wave3.cell_text(c, (&(*r).sub[0]) as u64, (*r).sn, tx, ty + lh1, right - tx, lh2, style.color_token(style.TOK_TEXT_MUTED),
        style.ALIGN_LEFT, true, 12)
}

// Paint the list into the node `e`. true = a scroll run-out is still moving.
fn vv_paint(v: *mut vlist.Vlist, c: *mut render.Ctx, e: *mut widget.Widget, focused: bool,
    ud: u64, f: fn(u64, usize, *mut vlist.VRow)) -> bool {
    let m: *mut theme.Theme = render.ctx_theme(c)
    let fo: *mut theme.Shape = theme.theme_shape(m)
    wave3.draw_list(c, e)
    let bw: f64 = render.len_of(c, (*fo).border_w)
    let x: f64 = widget.w_x(e) + bw
    let y: f64 = widget.w_y(e) + bw
    let w: f64 = widget.w_w(e) - 2.0 * bw
    let h: f64 = widget.w_h(e) - 2.0 * bw
    vlist.vl_set_rect(v, x, y, w, h)
    let vp: *mut viewport.Viewport = vlist.vl_viewport(v)
    let moving: bool = viewport.viewport_tick(vp, render.ctx_time(c)) || viewport.viewport_moving(vp)
    let z: *mut painter.Painter = render.ctx_painter(c)
    let ncol: usize = vlist.vl_columns(v)
    let hdr: f64 = vlist.vl_header_h(v)
    let padx: f64 = render.len_of(c, 8)
    let body_y: f64 = vlist.vl_body_y(v)
    let oy: f64 = viewport.viewport_off_y(vp)
    let inner_w: f64 = viewport.viewport_inner_w(vp)
    if hdr > 0.0 {
        draw_header(v, c, x, y, w)
    }
    if viewport.viewport_begin(c, vp) {
        var row: vlist.VRow = vlist.vrow_new()
        let n: usize = vlist.vl_end(v)
        var i: usize = vlist.vl_first(v)
        while i < n {
            let top: f64 = body_y + vlist.vl_row_top(v, i) - oy
            let rh: f64 = vlist.vl_height_of(v, i)
            // A row wholly outside the canvas clip (a partial repaint of
            // the window around this list) costs nothing: no row source
            // call, no shaping, no text.
            let cvp: *mut canvas.Canvas = painter.painter_canvas(z)
            var seen: bool = true
            if top + rh <= canvas.clip_y0(cvp) || top >= canvas.clip_y1(cvp)
            || x + inner_w <= canvas.clip_x0(cvp) || x >= canvas.clip_x1(cvp) {
                seen = false
            }
            if seen {
                row.n = 0
                row.dn = 0
                row.sn = 0
                row.tint_on = false
                row.px = 0
                row.bar = 0 - 1
                row.s2n = 0
                row.s3n = 0
                row.pill_tint = 0 as u32
                row.icon = 0 - 1
                row.disabled = false
                row.col = 0
                f(ud, i, &row)
                let sel: bool = vlist.vl_is_selected(v, i)
                if row.sn > 0 && row.bar >= 0 as i64 {
                    draw_project_card(c, &row, x, top, inner_w, rh, sel)
                } else if row.sn > 0 {
                    draw_card(c, &row, x, top, inner_w, rh, sel)
                }
                if row.sn == 0 {
                let hov: bool = vlist.vl_hover(v) == i
                let foc: bool = focused && vlist.vl_cur(v) == i
                var rw: widget.Widget = wave3.row_part(c, x, top, inner_w, rh, hov, sel, row.disabled, foc)
                let rs: *mut style.Style = widget.w_style(&rw)
                *rs = style.style_set_bg(*rs, wave3.row_bg(&rw))
                *rs = style.style_set_radius(*rs, (*fo).r_field)
                render.draw_base(c, &rw)
                if foc {
                    render.draw_focus_ring(c, &rw)
                }
                var fg: u32 = wave3.row_fg(&rw)
                var muted: u32 = style.color_token(style.TOK_TEXT_MUTED)
                if sel {
                    muted = fg
                }
                if ncol == 0 {
                    draw_cell(v, c, &row, x + padx, top, inner_w - 2.0 * padx, rh, fg, muted, true)
                } else {
                    var k: usize = 0
                    while k < ncol {
                        if k > 0 {
                            row.n = 0
                            row.dn = 0
                            row.icon = 0 - 1
                            row.col = k
                            f(ud, i, &row)
                        }
                        let cx: f64 = x + vlist.vl_col_x(v, k)
                        let cw: f64 = vlist.vl_col_width(v, k)
                        draw_cell(v, c, &row, cx + padx, top, cw - 2.0 * padx, rh, fg, muted, k == 0)
                        k = k + 1
                    }
                }
                }
            }
            i = i + 1
        }
        viewport.viewport_end(c, vp)
    }
    viewport.viewport_draw_bars(c, vp)
    return moving
}
