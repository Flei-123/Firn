const ACCENT_COUNT: usize = 8

#[no_gc]
fn accent_light(i: usize) -> u32 {
    if i == 1 { return 0x00706F as u32 }
    if i == 2 { return 0x0F7B0F as u32 }
    if i == 3 { return 0xA84400 as u32 }
    if i == 4 { return 0xC42B1C as u32 }
    if i == 5 { return 0xB4136F as u32 }
    if i == 6 { return 0x6B4FBB as u32 }
    if i == 7 { return 0x5E5E5E as u32 }
    return BLUE_0067C0
}

#[no_gc]
fn accent_dark(i: usize) -> u32 {
    if i == 1 { return 0x4FD6C8 as u32 }
    if i == 2 { return 0x6CCB5F as u32 }
    if i == 3 { return 0xFFA64D as u32 }
    if i == 4 { return 0xFF99A4 as u32 }
    if i == 5 { return 0xFF8CC8 as u32 }
    if i == 6 { return 0xB4A0FF as u32 }
    if i == 7 { return 0xC0C0C0 as u32 }
    return BLUE_4CC2FF
}

const SP_COUNT: usize = 14

#[no_gc]
fn space_px(i: usize) -> usize {
    if i == 0 { return 0 }
    if i == 1 { return 2 }
    if i == 2 { return 4 }
    if i == 3 { return 6 }
    if i == 4 { return 8 }
    if i == 5 { return 10 }
    if i == 6 { return 12 }
    if i == 7 { return 16 }
    if i == 8 { return 20 }
    if i == 9 { return 24 }
    if i == 10 { return 32 }
    if i == 11 { return 40 }
    if i == 12 { return 48 }
    return 64
}

const R_NONE: usize = 0
const R_XS: usize = 1
const R_SM: usize = 2
const R_MD: usize = 3
const R_LG: usize = 4
const R_XL: usize = 5
const R_XXL: usize = 6
const R_PILL: usize = 7
const RADIUS_COUNT: usize = 8

#[no_gc]
fn radius_px(i: usize) -> usize {
    if i == 0 { return 0 }
    if i == 1 { return 2 }
    if i == 2 { return 4 }
    if i == 3 { return 6 }
    if i == 4 { return 8 }
    if i == 5 { return 12 }
    if i == 6 { return 16 }
    return 9999
}

const D_INSTANT: usize = 0
const D_ULTRA_FAST: usize = 1
const D_QUICK: usize = 2
const D_FASTER: usize = 3
const D_FAST: usize = 4
const D_SNAPPY: usize = 5
const D_NORMAL: usize = 6
const D_GENTLE: usize = 7
const D_SLOW: usize = 8
const D_SLOWER: usize = 9
const D_ULTRA_SLOW: usize = 10
const D_COUNT: usize = 11

#[no_gc]
fn duration_ms(i: usize) -> usize {
    if i == 0 { return 0 }
    if i == 1 { return 50 }
    if i == 2 { return 83 }
    if i == 3 { return 100 }
    if i == 4 { return 150 }
    if i == 5 { return 167 }
    if i == 6 { return 200 }
    if i == 7 { return 250 }
    if i == 8 { return 300 }
    if i == 9 { return 400 }
    return 500
}

const EASE_LINEAR: usize = 0
const EASE_STANDARD: usize = 1
const EASE_DECELERATE: usize = 2
const EASE_ACCELERATE: usize = 3
const EASE_COUNT: usize = 4

struct Bezier {
    x1: usize,
    y1: usize,
    x2: usize,
    y2: usize,
}

#[no_gc]
fn ease_curve(i: usize) -> Bezier {
    if i == EASE_STANDARD { return Bezier { x1: 330, y1: 0, x2: 670, y2: 1000 } }
    if i == EASE_DECELERATE { return Bezier { x1: 100, y1: 900, x2: 200, y2: 1000 } }
    if i == EASE_ACCELERATE { return Bezier { x1: 900, y1: 100, x2: 1000, y2: 200 } }
    return Bezier { x1: 0, y1: 0, x2: 1000, y2: 1000 }
}

const SHADOW_LEVELS: usize = 5

struct ShadowSpec {
    dy: usize,
    blur: usize,
    alpha: usize,
    ambient_blur: usize,
    ambient_alpha: usize,
}

#[no_gc]
fn shadow_spec(level: usize) -> ShadowSpec {
    if level == 1 { return ShadowSpec { dy: 2, blur: 4, alpha: 40, ambient_blur: 2, ambient_alpha: 31 } }
    if level == 2 { return ShadowSpec { dy: 4, blur: 8, alpha: 56, ambient_blur: 2, ambient_alpha: 31 } }
    if level == 3 { return ShadowSpec { dy: 8, blur: 16, alpha: 72, ambient_blur: 2, ambient_alpha: 31 } }
    if level == 0 { return ShadowSpec { dy: 0, blur: 0, alpha: 0, ambient_blur: 0, ambient_alpha: 0 } }
    return ShadowSpec { dy: 16, blur: 32, alpha: 88, ambient_blur: 4, ambient_alpha: 36 }
}
