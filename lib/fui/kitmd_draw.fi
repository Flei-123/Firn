import std.rt
import std.vec
import fui.painter
import fui.render
import fui.kitmd_types
import fui.kitmd_measure

export { draw }

fn role_col(st: *mut kitmd_types.Style, role: u32) -> u32 {
    if role == kitmd_types.R_MUTED { return (*st).muted }
    if role == kitmd_types.R_ACCENT { return (*st).accent }
    if role == kitmd_types.R_CODE { return (*st).code_fg }
    if role == kitmd_types.R_CODE_BG { return (*st).code_bg }
    if role == kitmd_types.R_RULE { return (*st).rule }
    return (*st).text
}

fn draw_text(z: *mut painter.Painter, it: *mut kitmd_types.Item, lay: *mut kitmd_types.Layout, ox: f64, oy: f64, st: *mut kitmd_types.Style) {
    if (*it).n == 0 { return }
    let x: f64 = ox + (*it).x
    let y: f64 = oy + (*it).y
    if (*it).flags & kitmd_types.F_CODE != 0 as u32 && (*it).flags & kitmd_types.F_BLOCK == 0 as u32 {
        let px: f64 = (*it).size * 0.18
        painter.round_rect(z, x - px, y + (*it).h * 0.1, (*it).w + 2.0 * px, (*it).h * 0.8, (*it).size * 0.25, (*st).code_bg)
    }
    let old: u64 = kitmd_measure.font_enter(z, (*it).flags)
    var r: painter.TextRun = kitmd_measure.run_of((*it).flags, (*it).size)
    let base: f64 = painter.text_baseline_mid(z, y, (*it).h, (*it).size)
    painter.run_draw(z, &r, x, base, (*it).w + 2.0, role_col(st, (*it).role), rt.buf_ptr(&(*lay).pool) + ((*it).off as u64), (*it).n as usize, painter.TEXT_L)
    kitmd_measure.font_leave(z, old)
}

fn draw(c: *mut render.Ctx, lay: *mut kitmd_types.Layout, ox: f64, oy: f64, st: *mut kitmd_types.Style) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let n: usize = vec_len[kitmd_types.Item](&(*lay).items)
    var i: usize = 0
    while i < n {
        let it: *mut kitmd_types.Item = vec_elem_ptr[kitmd_types.Item](&(*lay).items, i)
        if (*it).kind == kitmd_types.T_TEXT {
            draw_text(z, it, lay, ox, oy, st)
        } else if (*it).kind == kitmd_types.T_RECT {
            var r: f64 = (*it).size * 0.4
            if (*it).role == kitmd_types.R_RULE { r = (*it).w / 2.0 }
            painter.round_rect(z, ox + (*it).x, oy + (*it).y, (*it).w, (*it).h, r, role_col(st, (*it).role))
        } else if (*it).kind == kitmd_types.T_DOT {
            painter.round_rect(z, ox + (*it).x, oy + (*it).y, (*it).w, (*it).h, (*it).w / 2.0, (*st).text)
        } else if (*it).kind == kitmd_types.T_RULE {
            painter.surface(z, ox + (*it).x, oy + (*it).y, (*it).w, 1.0, (*st).rule)
        }
        i = i + 1
    }
}
