// SPDX-License-Identifier: MPL-2.0
// lib/fui/render.fi -- THE ONE PLACE WHERE WIDGETS GET PAINTED.
//
// ========================================================= WHY IT EXISTS
//
// This is the rule the whole undertaking is about, and it has been paid
// for dearly twice:
//
//   * In OrientOS the control centre paints its own tiles instead of
//     using `paint_button` -- which is why they look different from
//     every other button in the system.
//   * The window buttons broke twice, because their drawing was rebuilt
//     in a second place.
//
// THEREFORE: no control in fUi paints itself. There is exactly one file
// that turns a `Widget` into pixels, and this is it. Whoever builds a
// new widget adds a case here -- and gets states, style, focus ring and
// antialiasing for free, because they are already there.
//
// ================================================= THE BUILD-UP OF A WIDGET
//
// Every widget is painted in the SAME order, and that is not
// convenience -- it is the reason they all fit together:
//
//   1. SURFACE   the background, if it is visible
//   2. BORDER    the outline, if it is visible
//   3. CONTENT   text or icon
//   4. FOCUS RING last, so that it lies over everything
//
// `draw_base` does 1, 2 and 4 for EVERY widget. A new widget writes
// only its content.
import fui.style
import fui.theme
import fui.widget
import fui.painter
import fui.uiimage
import fui.uisvg
import fui.effect
import fui.transform
import fui.bidi

export {
    Ctx, ctx_new, ctx_theme, ctx_painter,
    ctx_bind_anim, ctx_unbind_anim, ctx_set_time, ctx_time,
    anim_run, anim_none, anim_bg_of,
    shadow_color, is_raised, draw_elevation,
    draw_base, draw_widget, draw_label, draw_button,
    draw_text, draw_focus_ring,
    def_bg, def_bg_state, def_border, def_fg, def_radius, def_border_width,
    def_pad_x, def_pad_y, def_font, def_align,
    color_of, len_of, len_signed,
    text_run_of,
    draw_widget_xf,
    def_art_size, def_art_gap, art_box, draw_art, art_extra_w,
    art_text_split, draw_widget_art, pady_of,
    art_tint_of, draw_art_xf, draw_widget_art_xf,
    pref_of, set_pref_from,
    dir_of, is_rtl_style,
}

// What is needed for painting: the theme (Colors, Shape, scale) and the
// painter (canvas, font, rasteriser). Both belong to the caller.
//
struct Ctx {
    m: u64,   // *mut theme.Theme
    z: u64,   // *mut painter.Painter
    // ================================================ DIE ZEIT IM BILD
    //
    // Ein Knopf, der beim Ueberfahren SPRINGT, sieht alt aus -- das ist
    // der ganze Grund, aus dem es lib/fui/anim.fi gibt. Bis zur Runde
    // FEHLERBEHEBUNG fuehrte den Uebergang aber NUR das Demoprogramm,
    // und damit war er genau das, was diese Bibliothek verhindern soll:
    // jede Anwendung haette ihren eigenen bauen muessen. Jetzt fuehrt
    // ihn der Zeichenweg selbst.
    //
    // WARUM EIN FUNKTIONSZEIGER UND KEIN `anim.Animator` ALS FELD:
    // anim.fi fragt render.fi nach den ZIELWERTEN eines Zustandes
    // (`render.def_bg_state`, `def_radius`, `def_border_width` -- die
    // Kaskade steht hier und darf kein zweites Mal geschrieben werden),
    // also importiert anim.fi diese Datei. Andersherum waere ein
    // Kreis, und keine der beiden Dateien liesse sich uebersetzen. Ein
    // FELD hingegen wird zur Laufzeit gesetzt: `anim.transreg_bind`
    // haengt das Register ein, und render.fi ruft eine Funktion, die
    // es nicht kennt. Dieselbe Loesung wie die Trefferpruefung in
    // control.fi, und aus demselben Grund.
    //
    // `ms` ist die Uhrzeit des laufenden Bildes. Sie gehoert dem
    // Aufrufer (S2 in control.fi: die Uhr haelt, wer das Fenster
    // haelt); hier steht nur, welchen Stand das gerade gemalte Bild
    // zeigt.
    an: u64,   // Zustand des Registers, sein Eigentuemer ist der Aufrufer
    ah: fn(u64, u64, u64, i64) -> bool,
    ms: i64,
}

fn ctx_new(m: *mut theme.Theme, z: *mut painter.Painter) -> Ctx {
    return Ctx { m: m as u64, z: z as u64, an: 0, ah: anim_none, ms: 0 }
}

// DIE VORGABE: es gibt keine Zeit im Bild, und nichts ist veraltet.
// Ohne eingehaengtes Register malt render.fi Bild fuer Bild genau das,
// was es immer gemalt hat.
fn anim_none(reg: u64, cx: u64, wx: u64, now_ms: i64) -> bool {
    return false
}

fn ctx_bind_anim(c: *mut Ctx, reg: u64,
    h: fn(u64, u64, u64, i64) -> bool) {
    (*c).an = reg
    (*c).ah = h
}

fn ctx_unbind_anim(c: *mut Ctx) {
    (*c).an = 0
    (*c).ah = anim_none
}

// Die Uhrzeit des Bildes setzen. Zurueck kommt nichts: ob etwas neu zu
// malen ist, sagt `anim_run` beim Malen -- und nur das ist ehrlich,
// denn die Antwort haengt am Widget und nicht an der Uhr.
fn ctx_set_time(c: *mut Ctx, ms: i64) {
    (*c).ms = ms
}

fn ctx_time(c: *mut Ctx) -> i64 { return (*c).ms }

// DEN UEBERGANG EINES WIDGETS WEITERRECHNEN. `true` heisst: das Bild
// ist veraltet, der Aufrufer soll im naechsten Takt wieder malen.
//
// Was dabei geschieht, entscheidet das eingehaengte Register: die
// Fassung in anim.fi setzt den Tween bei einem Zustandswechsel neu an,
// rechnet ihn auf `now_ms` und schreibt den Zwischenstand (Farbe,
// Radius, Randstaerke, Deckung) in den Style des Widgets zurueck --
// weshalb der Rest dieser Datei davon nichts merkt und einfach malt.
fn anim_run(c: *mut Ctx, e: *mut widget.Widget) -> bool {
    if (*c).an == 0 {
        return false
    }
    return (*c).ah((*c).an, c as u64, e as u64, (*c).ms)
}

// DIE FLAECHENFARBE, DIE DIESER ZEICHENWEG GERADE MALEN WUERDE.
//
// Dieselbe Rechnung wie in `draw_base`, nur ohne Leinwand -- damit
// eine Pruefung den Wert AUS DEM RENDER-PFAD lesen kann und nicht die
// Kaskade nachbaut. Nach `anim_run` steht hier die gemischte Farbe des
// laufenden Uebergangs.
fn anim_bg_of(c: *mut Ctx, e: *mut widget.Widget) -> u32 {
    let sz: *mut style.StyleSet = widget.w_styleset(e)
    let bg: u32 = style.resolve_bg(sz, widget.w_state(e),
        def_bg_state(widget.w_kind(e), widget.w_state(e)))
    if !style.color_is_visible(bg) {
        return 0 as u32
    }
    return theme.opaque(color_of(c, bg))
}

fn ctx_theme(c: *mut Ctx) -> *mut theme.Theme {
    return (*c).m as *mut theme.Theme
}

fn ctx_painter(c: *mut Ctx) -> *mut painter.Painter {
    return (*c).z as *mut painter.Painter
}

// A resolved style value to a real colour.
fn color_of(c: *mut Ctx, w: u32) -> u32 {
    return theme.color_from_style(ctx_theme(c), w)
}

// A design length into device points -- every length goes through here.
fn len_of(c: *mut Ctx, n: usize) -> f64 {
    return theme.theme_px(ctx_theme(c), n) as f64
}

// ======================================================================
// THE WIDGET DEFAULTS
// ======================================================================
//
// What a widget asks for by itself, when the caller says nothing. This
// is the bottom layer of the inheritance chain from lib/fui/style.fi.
//
// HERE stands "a label has no background by default" as ONE line -- and
// not as a rule in the programmer's head.

// ======================================================================
// THE WIDGET DEFAULT HANGS ON THE STATE -- OTHERWISE THERE ARE NO STATES
// ======================================================================
//
// A BUG OF THIS ROUND, FOUND IN THE PICTURE. The first version returned
// `TOK_BUTTON` here for every state. It compiled cleanly, it ran too --
// and on the gallery page all five buttons were THE SAME GREY. Measured
// (dark, centre of each button):
//
//     normal 0x42414D  hover 0x42414D  active 0x42414D  ...
//
// The reason: `style.resolve_bg` falls back to the widget default when
// neither the state override nor the caller says anything -- and that
// is exactly the normal case for an ordinary button. A default without
// a state therefore makes the states invisible, even though the style
// system underneath computes correctly.
//
// THAT IS THE REASON THE GALLERY PAGE EXISTS: in the source both look
// the same.
// DER SCHALTER STAND IN BEIDEN ZWEIGEN, UND DAS WAR EIN WIDERSPRUCH.
// Bis zum 21.09.2026 zaehlte `KIND_TOGGLE` hier zu den Knopf-artigen
// Elementen und ZUGLEICH weiter unten in `def_bg` zu denen ohne eigene
// Flaeche. Welche der beiden Regeln galt, entschied allein die
// Reihenfolge der Abfragen -- also diese, denn `def_bg` wird erst
// gerufen, wenn hier nichts passt. Gemalt wurde damit die ganze ZEILE
// des Schalters in Knopfgrau, obwohl zwei Kommentare (hier unten bei
// KIND_SLIDER und in wave2.draw_checkbox) ausdruecklich sagen: ein
// Schalter faerbt seinen KASTEN, nicht seine Zeile. Zwei Orte, zwei
// Aussagen, und die dokumentierte verlor still.
//
// Der Schalter ist darum HIER heraus und steht nur noch in `def_bg`
// unter den durchsichtigen. Seine Zustaende gehen dabei nicht
// verloren: die Pille nimmt TOK_ACCENT, sobald er an ist
// (wave2.draw_toggle), und Hover/Fokus stehen im Ring. Was verschwindet,
// ist ausschliesslich der graue Balken hinter der Beschriftung --
// tools/fui/wave2_main.fi Abschnitt 14 misst nach, dass die Zeile
// neben der Pille die Farbe des Untergrunds behaelt, und die Belege
// 03/04 (fui-wave2-light/dark.png) zeigen es.
fn def_bg_state(kind: u32, zu: u32) -> u32 {
    if kind == widget.KIND_BUTTON
        || kind == widget.KIND_TILE || kind == widget.KIND_TAB {
        if zu == style.STATE_ACTIVE {
            return style.color_token(style.TOK_BUTTON_ACTIVE)
        }
        if zu == style.STATE_HOVER {
            return style.color_token(style.TOK_BUTTON_HOVER)
        }
        if zu == style.STATE_SELECTED {
            return style.color_token(style.TOK_ACCENT)
        }
        // DISABLED and FOCUS keep the resting colour: disabled shows
        // in the pale text, focus in the ring. Two signals for the
        // same state are one too many.
        return style.color_token(style.TOK_BUTTON)
    }
    if kind == widget.KIND_TEXTBOX {
        if zu == style.STATE_FOCUS {
            return style.color_token(style.TOK_FIELD_FOCUS)
        }
        return style.color_token(style.TOK_FIELD)
    }
    return def_bg(kind)
}

fn def_bg(kind: u32) -> u32 {
    if kind == widget.KIND_LABEL {
        // A label is text on whatever lies underneath.
        return style.color_transparent()
    }
    if kind == widget.KIND_TEXTBOX {
        return style.color_token(style.TOK_FIELD)
    }
    if kind == widget.KIND_SEPARATOR {
        return style.color_token(style.TOK_SEPARATOR)
    }
    if kind == widget.KIND_PROGRESS {
        return style.color_token(style.TOK_FIELD)
    }
    if kind == widget.KIND_CARD || kind == widget.KIND_MENU {
        return style.color_token(style.TOK_SURFACE_RAISED)
    }
    if kind == widget.KIND_TOOLBAR {
        return style.color_token(style.TOK_SURFACE)
    }
    if kind == widget.KIND_NONE {
        return style.color_transparent()
    }
    // ============================ A SLIDER HAS NO SURFACE OF ITS OWN
    //
    // A BUG OF WAVE 2, FOUND IN THE PICTURE. Without this case a
    // slider fell through to `TOK_BUTTON` and painted its whole rect
    // -- 200 x 24 of button grey -- and the track, the fill and the
    // handle then sat on top of that slab. Measured near the top edge
    // the row was then filled right across at EVERY value, so the
    // handle could not be found at all and the three positions read
    // the same.
    //
    // What a slider consists of is the track, the filled part and the
    // handle; the area between them belongs to whatever lies behind.
    // The same holds for a radio button, a checkbox and a toggle: they
    // colour their BOX, not their row (the reason stands in
    // wave2.draw_checkbox).
    if kind == widget.KIND_SLIDER || kind == widget.KIND_CHECKBOX
        || kind == widget.KIND_RADIO || kind == widget.KIND_TOGGLE
        || kind == widget.KIND_TOOLTIP || kind == widget.KIND_BADGE {
        return style.color_transparent()
    }
    if kind == widget.KIND_SCROLLBAR {
        // A scrollbar DOES have a track -- that is the difference
        // from a slider, and it is what you drop a page onto.
        return style.color_token(style.TOK_SURFACE)
    }
    return style.color_token(style.TOK_BUTTON)
}

fn def_border(kind: u32) -> u32 {
    if kind == widget.KIND_TEXTBOX {
        return style.color_token(style.TOK_BORDER)
    }
    // Buttons of this theme carry no border -- `tone=0` in
    // osum.shape: they are separated by spacing, not by a line.
    return style.color_transparent()
}

fn def_fg(kind: u32) -> u32 {
    return style.color_token(style.TOK_TEXT)
}

fn def_radius(c: *mut Ctx, kind: u32) -> usize {
    let fo: *mut theme.Shape = theme.theme_shape(ctx_theme(c))
    if kind == widget.KIND_TEXTBOX {
        return (*fo).r_field
    }
    if kind == widget.KIND_CARD || kind == widget.KIND_MENU {
        return (*fo).r_panel
    }
    if kind == widget.KIND_LABEL || kind == widget.KIND_SEPARATOR {
        return 0
    }
    return (*fo).r_button
}

fn def_border_width(c: *mut Ctx, kind: u32) -> usize {
    let fo: *mut theme.Shape = theme.theme_shape(ctx_theme(c))
    if kind == widget.KIND_TEXTBOX {
        return (*fo).border_w
    }
    return 0
}

fn def_pad_x(c: *mut Ctx, kind: u32) -> usize {
    let fo: *mut theme.Shape = theme.theme_shape(ctx_theme(c))
    if kind == widget.KIND_LABEL {
        return 0
    }
    return (*fo).pad_x
}

fn def_pad_y(c: *mut Ctx, kind: u32) -> usize {
    let fo: *mut theme.Shape = theme.theme_shape(ctx_theme(c))
    if kind == widget.KIND_LABEL {
        return 0
    }
    return (*fo).pad_y
}

fn def_font(c: *mut Ctx) -> usize {
    let fo: *mut theme.Shape = theme.theme_shape(ctx_theme(c))
    return (*fo).font
}

fn def_align(kind: u32) -> u32 {
    if kind == widget.KIND_LABEL || kind == widget.KIND_TEXTBOX {
        return style.ALIGN_LEFT
    }
    // A button labels itself centred.
    return style.ALIGN_CENTER
}

// ======================================================================
// THE SHADOW UNDER A RAISED SURFACE
// ======================================================================
//
// A card, a menu and a tooltip are not on the page, they are IN FRONT
// of it. Until now the only means of saying so was a line around them,
// and a line around everything is exactly the look this library is
// meant to leave behind. What says "in front" on every modern surface
// is a SOFT shadow -- and since lib/fui/effect.fi has one, it is used
// here, in the one place that paints widgets, and nowhere else.
//
// The numbers come from the theme and not from here: `Shape.shadow` is
// the strength, `Shape.shadow_r` the blur radius. `shape_classic` has
// both at zero, so the square theme gets NO shadow -- that is the
// proof that the shadow is a theme decision and not an assumption in
// the drawing code.

// HOW DARK THE SHADOW IS, DEPENDS ON THE GROUND.
//
// The same black at the same alpha carries far less on a dark page
// than on a white one: on 0xFFFFFF an alpha of 64 darkens by 64 steps,
// on 0x1C1B22 there are barely 28 steps of room left below. Dark
// therefore takes three times the alpha -- the value at which the
// shadow under a card is as visible in the dark picture as in the
// light one.
fn shadow_color(c: *mut Ctx) -> u32 {
    let m: *mut theme.Theme = ctx_theme(c)
    let fo: *mut theme.Shape = theme.theme_shape(m)
    var a: usize = (*fo).shadow
    if theme.theme_is_dark(m) {
        a = a * 3
    }
    if a > 255 {
        a = 255
    }
    return (a as u32) << 24
}

// Which kinds stand in front of the page. A button does NOT -- a
// shadow under every button is the 2008 look, and Material dropped it
// for the same reason.
//
// A TOOLTIP does not either, and that is not an oversight: the check
// this library exists for (wave2_main.fi, section 8) measures the four
// pixels diagonally outside a tooltip's corners and demands the
// background UNCHANGED there, because in the real system a grey box
// sat behind the tooltip. A tooltip is small and lies directly at the
// pointer; it needs no shadow to be seen. Cards and menus do.
fn is_raised(kind: u32) -> bool {
    return kind == widget.KIND_CARD || kind == widget.KIND_MENU
}

// The shadow itself: offset downwards by half the blur, so that the
// light comes from above, as it does everywhere else in the theme.
// Whether it worked is returned -- the shape needs a canvas of its
// own, and if there is no memory for it, the card is still painted.
fn draw_elevation(c: *mut Ctx, e: *mut widget.Widget) -> bool {
    let m: *mut theme.Theme = ctx_theme(c)
    let fo: *mut theme.Shape = theme.theme_shape(m)
    if (*fo).shadow == 0 || (*fo).shadow_r == 0 {
        return true
    }
    let sz: *mut style.StyleSet = widget.w_styleset(e)
    let r: f64 = len_of(c, style.resolve_num(sz, style.SF_RADIUS,
        (*style.styleset_base(sz)).radius as usize,
        def_radius(c, widget.w_kind(e))))
    let b: f64 = len_of(c, (*fo).shadow_r)
    return effect.drop_shadow_round(ctx_painter(c), widget.w_x(e),
        widget.w_y(e), widget.w_w(e), widget.w_h(e), r, 0.0, b * 0.5,
        b as i64, shadow_color(c))
}

// ======================================================================
// THE COMMON BASE
// ======================================================================
//
// Surface, border and focus ring -- the same for EVERY widget. That is
// the part a new widget no longer has to write.
//
// `nur_ring` paints the focus ring AFTER the content; that is why it is
// a call of its own and not part of `draw_base`.
fn draw_base(c: *mut Ctx, e: *mut widget.Widget) {
    let z: *mut painter.Painter = ctx_painter(c)
    let sz: *mut style.StyleSet = widget.w_styleset(e)
    let kind: u32 = widget.w_kind(e)
    let zu: u32 = widget.w_state(e)

    // ---- 1. THE SURFACE
    //
    // THE DECIDING LINE OF THIS FILE: if the value is not visible,
    // NOTHING IS PAINTED. No substitute coat in the window colour --
    // that is Justin's point 4, and over a background image the
    // difference shows at once.
    let bg: u32 = style.resolve_bg(sz, zu, def_bg_state(kind, zu))
    let r: f64 = len_of(c, style.resolve_num(sz, style.SF_RADIUS,
        (*style.styleset_base(sz)).radius as usize, def_radius(c, kind)))
    if style.color_is_visible(bg) {
        // What stands IN FRONT of the page gets its shadow first: it
        // lies UNDER the surface, so it has to be painted before it --
        // afterwards the surface would cover the part of it that falls
        // inside the card, and the shadow would show through the
        // rounded corners.
        if is_raised(kind) {
            if !draw_elevation(c, e) {
                // No memory for the shadow's own canvas. The card is
                // painted anyway -- a missing shadow is a blemish, a
                // missing card is a hole.
            }
        }
        painter.round_rect(z, widget.w_x(e), widget.w_y(e),
            widget.w_w(e), widget.w_h(e), r, color_of(c, bg))
    }

    // ---- 2. THE BORDER
    let ra: u32 = style.resolve_border(sz, zu, def_border(kind))
    let st: f64 = len_of(c, style.resolve_num(sz, style.SF_BORDER_W,
        (*style.styleset_base(sz)).border_w as usize, def_border_width(c, kind)))
    if style.color_is_visible(ra) && st > 0.0 {
        painter.round_ring(z, widget.w_x(e), widget.w_y(e),
            widget.w_w(e), widget.w_h(e), r, st, color_of(c, ra))
    }
}

// THE FOCUS RING, last and over everything.
//
// It is the only thing somebody working by keyboard relies on --
// therefore it is two pixels wide (theme.Shape.focus_w) and does NOT
// colour the surface: were it a fill, you could not tell focused from
// hovered apart.
//
fn draw_focus_ring(c: *mut Ctx, e: *mut widget.Widget) {
    if !widget.w_is_focus(e) || widget.w_is_disabled(e) {
        return
    }
    let z: *mut painter.Painter = ctx_painter(c)
    let m: *mut theme.Theme = ctx_theme(c)
    let f: *mut theme.Colors = theme.theme_colors(m)
    let fo: *mut theme.Shape = theme.theme_shape(m)
    let sz: *mut style.StyleSet = widget.w_styleset(e)
    let kind: u32 = widget.w_kind(e)
    let r: f64 = len_of(c, style.resolve_num(sz, style.SF_RADIUS,
        (*style.styleset_base(sz)).radius as usize, def_radius(c, kind)))
    painter.round_ring(z, widget.w_x(e), widget.w_y(e), widget.w_w(e),
        widget.w_h(e), r, len_of(c, (*fo).focus_w), (*f).accent)
}

// ======================================================================
// THE PICTURE OF A WIDGET
// ======================================================================
//
// Justin, 13.09.2026: a button with an icon left of the text, a label
// with a picture. The pointer lives on the Widget (widget.fi); the
// geometry and the drawing are HERE, once, so that a button, a menu
// entry, a tab and a toolbar button all place their icon by the same
// arithmetic. Placing it per widget is exactly how the same drawing
// drifts apart, which is the fault this library exists to stop.

// THE DEFAULT ICON SIZE FOLLOWS THE FONT, not the widget height.
//
// The same rule as `wave2.box_side` for the tick box of a checkbox, and
// the reason is the same: an icon next to a line of 15 point text should
// be as big as that text, whether the row it sits in is 32 or 40 high.
// Tie it to the height and the icon in a tall toolbar looks blown up.
//
// The factor is 1.0 -- an icon on the text's own em box. Material uses
// 24 on a 16 point body, Fluent 16 on 14; both land within a point or
// two of the em size, and taking the font size exactly means a caller who
// changes the font gets an icon that follows without touching anything.
fn def_art_size(c: *mut Ctx) -> usize {
    let fo: *mut theme.Shape = theme.theme_shape(ctx_theme(c))
    return (*fo).font
}

// The gap between picture and text: the small grid step. `sp_s` is what
// separates two elements of one group everywhere else in the theme, and
// an icon and its label are exactly that.
fn def_art_gap(c: *mut Ctx) -> usize {
    let fo: *mut theme.Shape = theme.theme_shape(ctx_theme(c))
    return (*fo).sp_s
}

// THE SIZE OF THE PICTURE BOX IN PIXELS, out of the widget or the theme.
fn art_box(c: *mut Ctx, e: *mut widget.Widget, aw: *mut f64,
    ah: *mut f64) {
    var w: usize = widget.w_art_w(e)
    var h: usize = widget.w_art_h(e)
    if w == 0 && h == 0 {
        w = def_art_size(c)
        h = w
    } else if w == 0 {
        w = h
    } else if h == 0 {
        h = w
    }
    *aw = len_of(c, w)
    *ah = len_of(c, h)
}

// HOW MUCH ROOM THE PICTURE TAKES FROM THE TEXT, horizontally.
//
// Zero when there is no picture, and zero for ART_ONLY as well -- there
// the picture is not beside the text, it IS the content. The layout
// (layout.fi) and the text placement both ask this one function, so they
// cannot disagree about the width.
fn art_extra_w(c: *mut Ctx, e: *mut widget.Widget) -> f64 {
    if !widget.w_has_art(e) {
        return 0.0
    }
    let al: u32 = widget.w_art_align(e)
    if al == widget.ART_ONLY || al == widget.ART_ABOVE
        || al == widget.ART_ABOVE_CENTER {
        return 0.0
    }
    var aw: f64 = 0.0
    var ah: f64 = 0.0
    art_box(c, e, &aw, &ah)
    var g: usize = widget.w_art_gap(e)
    if g == 0 {
        g = def_art_gap(c)
    }
    // The gap only counts when there IS text on the other side of it.
    if widget.w_text_len(e) == 0 {
        return aw
    }
    return aw + len_of(c, g)
}

// SPLIT THE CONTENT BOX INTO PICTURE AND TEXT.
//
// Hands back where the picture goes and what is left for the text. ONE
// place, because the drawing and the measuring have to agree: if the text
// were centred in the whole rect while the icon sat on the left, the two
// would overlap, and that is the classic version of this bug.
//
// `cx`/`cw` is the content box (the rect minus the padding).
fn art_text_split(c: *mut Ctx, e: *mut widget.Widget, cx: f64, cy: f64,
    cw: f64, ch: f64, ax: *mut f64, ay: *mut f64, aw: *mut f64,
    ah: *mut f64, tx: *mut f64, tw: *mut f64) {
    var bw: f64 = 0.0
    var bh: f64 = 0.0
    art_box(c, e, &bw, &bh)
    var g: usize = widget.w_art_gap(e)
    if g == 0 {
        g = def_art_gap(c)
    }
    var gap: f64 = len_of(c, g)
    if widget.w_text_len(e) == 0 {
        gap = 0.0
    }
    let al: u32 = widget.w_art_align(e)
    // Vertically the picture is centred in the content box, always. An
    // icon on the baseline of the text looks dropped.
    *ay = cy + (ch - bh) / 2.0
    *aw = bw
    *ah = bh
    if al == widget.ART_ONLY {
        // The whole box, centred. No text is drawn.
        *ax = cx + (cw - bw) / 2.0
        *tx = cx
        *tw = 0.0
        return
    }
    if al == widget.ART_ABOVE || al == widget.ART_ABOVE_CENTER {
        // Picture on top, text underneath. The two share the height, so
        // the picture is centred horizontally and sits in the upper part.
        // ABOVE_CENTER unterscheidet sich NUR in der Textausrichtung
        // (siehe `text_align_of`) -- die Kaesten sind dieselben, und
        // deshalb steht hier kein zweiter Zweig.
        *ax = cx + (cw - bw) / 2.0
        *ay = cy
        *tx = cx
        *tw = cw
        return
    }
    // IN EINEM RTL-ELEMENT TAUSCHEN ANFANG UND ENDE. ART_LEFT meint "vor
    // dem Text", und vor dem Text ist bei `direction: rtl` rechts -- ein
    // Symbol, das links bliebe, stuende hinter dem arabischen Wort. Die
    // Zerlegung ist sonst dieselbe; nur die Seite wechselt.
    var right: bool = al == widget.ART_RIGHT
    if is_rtl_style(e) {
        right = !right
    }
    if right {
        *ax = cx + cw - bw
        *tx = cx
        *tw = cw - bw - gap
        return
    }
    // ART_LEFT, the default.
    *ax = cx
    *tx = cx + bw + gap
    *tw = cw - bw - gap
}

// DRAW THE PICTURE OF A WIDGET into the box worked out above.
//
// The tint: `art_tint` is a style COLOUR TOKEN, so it follows the theme
// like every other colour in fUi. A disabled widget draws its icon in the
// pale text colour -- the same signal its label gets, and the reason is
// the same as in `draw_text`: a disabled control has to read as disabled
// in every part of it, not just the words.
fn draw_widget_art(c: *mut Ctx, e: *mut widget.Widget) {
    if !widget.w_has_art(e) {
        return
    }
    let sz: *mut style.StyleSet = widget.w_styleset(e)
    let s: *mut style.Style = style.styleset_base(sz)
    let kind: u32 = widget.w_kind(e)
    let padx: f64 = len_of(c, style.resolve_num(sz, style.SF_PAD_X,
        (*s).pad_x as usize, def_pad_x(c, kind)))
    let pady: f64 = pady_of(c, e)
    var ax: f64 = 0.0
    var ay: f64 = 0.0
    var aw: f64 = 0.0
    var ah: f64 = 0.0
    var tx: f64 = 0.0
    var tw: f64 = 0.0
    art_text_split(c, e, widget.w_x(e) + padx, widget.w_y(e) + pady,
        widget.w_w(e) - 2.0 * padx, widget.w_h(e) - 2.0 * pady,
        &ax, &ay, &aw, &ah, &tx, &tw)
    draw_art(c, e, ax, ay, aw, ah)
}

// DIE TOENUNG EINES BILDES, AN EINER STELLE. Sie wird vom geraden und
// vom umgeformten Zeichenweg gebraucht, und zwei Fassungen davon
// waeren zwei Antworten auf die Frage, welche Farbe ein abgeschaltetes
// Symbol hat.
fn art_tint_of(c: *mut Ctx, e: *mut widget.Widget) -> u32 {
    var tint: u32 = 0
    let tk: u32 = widget.w_art_tint(e)
    if tk != 0 as u32 {
        tint = color_of(c, tk)
    }
    if widget.w_state(e) == style.STATE_DISABLED {
        // A tinted icon goes pale with the text. An icon in its OWN
        // colours is left alone: washing a company logo out would be a
        // surprise, and the control reads as disabled from its label.
        if tk != 0 as u32 {
            tint = color_of(c, style.color_token(style.TOK_TEXT_DISABLED))
        }
    }
    return tint
}

fn draw_art(c: *mut Ctx, e: *mut widget.Widget, x: f64, y: f64, w: f64,
    h: f64) {
    if !widget.w_has_art(e) || w <= 0.0 || h <= 0.0 {
        return
    }
    let z: *mut painter.Painter = ctx_painter(c)
    let tint: u32 = art_tint_of(c, e)
    let k: u32 = widget.w_art_kind(e)
    if k == widget.ART_IMAGE {
        let im: *mut uiimage.Image = widget.w_art_p(e) as *mut uiimage.Image
        uiimage.image_draw(z, im, x, y, w, h, uiimage.FIT_CONTAIN, tint)
        return
    }
    if k == widget.ART_SVG {
        // AB HIER IST EIN SYMBOL DASSELBE WIE EIN PNG.
        //
        // `w_set_svg` haelt einen `uisvg.Icon`, also ein SCHON GERASTERTES
        // Symbol. Gerastert wird nicht hier: das laeuft den XML-Baum und
        // alle Pfade ab, und wer das im Zeichenweg macht, bezahlt den
        // Zerteiler bei jedem Bildaufbau. Der Aufrufer rastert mit
        // `uisvg.icon_render` einmal je Groesse -- der Kopf von
        // lib/fui/uisvg.fi sagt warum.
        //
        // Deshalb gibt es hier auch KEINEN zweiten Zeichenweg fuer SVG:
        // dasselbe `uiimage.image_draw` wie beim Bild, mit demselben
        // Alpha und derselben Toenung.
        let ic: *mut uisvg.Icon = widget.w_art_p(e) as *mut uisvg.Icon
        var vw: uiimage.Image = uisvg.icon_view(ic)
        uiimage.image_draw(z, &vw, x, y, w, h, uiimage.FIT_CONTAIN, tint)
    }
}

// ======================================================================
// DASSELBE BILD UNTER EINER AFFINEN ABBILDUNG
// ======================================================================
//
// WARUM ES DAS BRAUCHT. lib/fui/scene.fi darf einem Knoten eine
// Umformung geben (`transform` im Stilblatt ist ein Stilwert wie jeder
// andere). Fuer einen Kasten, einen Text und die meisten Widgets gibt
// es dafuer `draw_widget_xf`; ein BILD oder ein SYMBOL fiel bis zum
// 22.09.2026 heraus und wurde GERADE gemalt -- eine Karte mit einem
// gedrehten Wappen zeigte das Wappen aufrecht, und im Quelltext stand
// als Begruendung, ein Bild unter einer Matrix waere eine zweite
// Abtastung. Das war nicht richtig: die Abtastung gibt es schon, sie
// steht in `uiimage.sample_bilinear`, und der Weg darauf ist
// `transform.tf_draw_image`. Hier wird er nur angeschlossen.
//
// ES WIRD NICHTS NACHGERECHNET: wohin das Bild im Widget gehoert, sagt
// `art_text_split` (dieselbe Zerlegung wie im geraden Weg), wie es ins
// Rechteck passt, sagt `uiimage.image_fit` (dieselbe Einpassung, die
// `image_draw` benutzt), und wie es unter der Matrix abgetastet wird,
// sagt transform.fi. Diese Funktion reicht drei Zahlen weiter.
fn draw_art_xf(c: *mut Ctx, e: *mut widget.Widget,
    xf: *mut transform.Xform, x: f64, y: f64, w: f64, h: f64) {
    if !widget.w_has_art(e) || w <= 0.0 || h <= 0.0 {
        return
    }
    let z: *mut painter.Painter = ctx_painter(c)
    let tint: u32 = art_tint_of(c, e)
    let k: u32 = widget.w_art_kind(e)
    var im: uiimage.Image = uiimage.image_new()
    if k == widget.ART_IMAGE {
        im = *(widget.w_art_p(e) as *mut uiimage.Image)
    } else if k == widget.ART_SVG {
        im = uisvg.icon_view(widget.w_art_p(e) as *mut uisvg.Icon)
    } else {
        return
    }
    var dx: f64 = 0.0
    var dy: f64 = 0.0
    var dw: f64 = 0.0
    var dh: f64 = 0.0
    uiimage.image_fit(&im, x, y, w, h, uiimage.FIT_CONTAIN, &dx, &dy,
        &dw, &dh)
    transform.tf_draw_image_tinted(z, xf, &im, dx, dy, dw, dh, 1.0,
        tint)
}

// DIE GENAUE ENTSPRECHUNG VON `draw_widget_art`, nur unter einer
// Abbildung: derselbe Kasten, dieselbe Zerlegung, dasselbe Bild --
// und ausdruecklich NICHTS darueber hinaus. Wer zusaetzlich Flaeche
// und Schrift gedreht haben will, ruft vorher `draw_widget_xf`; dass
// diese Funktion es nicht von sich aus tut, haelt sie mit dem geraden
// Weg deckungsgleich. Ein Zeichenweg, der mehr malt als sein gerades
// Gegenstueck, faellt sonst genau dann auf, wenn eine Drehung
// dazukommt.
fn draw_widget_art_xf(c: *mut Ctx, e: *mut widget.Widget,
    xf: *mut transform.Xform) {
    if !widget.w_has_art(e) {
        return
    }
    let sz: *mut style.StyleSet = widget.w_styleset(e)
    let s: *mut style.Style = style.styleset_base(sz)
    let kind: u32 = widget.w_kind(e)
    let padx: f64 = len_of(c, style.resolve_num(sz, style.SF_PAD_X,
        (*s).pad_x as usize, def_pad_x(c, kind)))
    let pady: f64 = pady_of(c, e)
    var ax: f64 = 0.0
    var ay: f64 = 0.0
    var aw: f64 = 0.0
    var ah: f64 = 0.0
    var tx: f64 = 0.0
    var tw: f64 = 0.0
    art_text_split(c, e, widget.w_x(e) + padx, widget.w_y(e) + pady,
        widget.w_w(e) - 2.0 * padx, widget.w_h(e) - 2.0 * pady,
        &ax, &ay, &aw, &ah, &tx, &tw)
    draw_art_xf(c, e, xf, ax, ay, aw, ah)
}

// ======================================================================
// HOW BIG A WIDGET WANTS TO BE
// ======================================================================
//
// THE LAYOUT HAS TO KNOW ABOUT THE PICTURE, or a button with an icon gets
// exactly the width its text needs and the icon is clipped. Justin's point
// C, 13.09.2026: "layout.fi must count the size into pref_w/pref_h".
//
// lib/fui/layout.fi deliberately takes NUMBERS and not widgets
// (`box_measure(s, pref, n)`) -- it is the part that must stay testable
// without a canvas or a font. So the measuring of a widget lives here,
// where the theme and the painter already are, and the caller feeds the
// result into the layout. That keeps the direction of the dependency the
// way the rest of the library has it.
//
// `w_set_pref` on the widget is what this is for: measure once, lay out
// many times.
fn pref_of(c: *mut Ctx, e: *mut widget.Widget, pw: *mut f64,
    ph: *mut f64) {
    let z: *mut painter.Painter = ctx_painter(c)
    let sz: *mut style.StyleSet = widget.w_styleset(e)
    let s: *mut style.Style = style.styleset_base(sz)
    let kind: u32 = widget.w_kind(e)
    let fo: *mut theme.Shape = theme.theme_shape(ctx_theme(c))
    let padx: f64 = len_of(c, style.resolve_num(sz, style.SF_PAD_X,
        (*s).pad_x as usize, def_pad_x(c, kind)))
    let pady: f64 = len_of(c, style.resolve_num(sz, style.SF_PAD_Y,
        (*s).pad_y as usize, def_pad_y(c, kind)))
    let px: f64 = len_of(c, style.resolve_num(sz, style.SF_FONT_PX,
        (*s).font_px as usize, def_font(c)))

    // --- the text
    var tw: f64 = 0.0
    var th: f64 = 0.0
    if widget.w_text_len(e) != 0 {
        var r: painter.TextRun = text_run_of(c, e, px)
        tw = painter.run_width(z, &r, widget.w_text(e),
            widget.w_text_len(e))
        th = painter.run_line_height(z, &r)
    }

    // --- the picture
    var aw: f64 = 0.0
    var ah: f64 = 0.0
    var gap: f64 = 0.0
    if widget.w_has_art(e) {
        art_box(c, e, &aw, &ah)
        var g: usize = widget.w_art_gap(e)
        if g == 0 {
            g = def_art_gap(c)
        }
        if widget.w_text_len(e) != 0 {
            gap = len_of(c, g)
        }
    }

    let al: u32 = widget.w_art_align(e)
    var cw: f64 = 0.0
    var chh: f64 = 0.0
    if !widget.w_has_art(e) {
        cw = tw
        chh = th
    } else if al == widget.ART_ONLY {
        // No text: the picture IS the content, and the box is square
        // unless the caller asked for something else.
        cw = aw
        chh = ah
    } else if al == widget.ART_ABOVE || al == widget.ART_ABOVE_CENTER {
        // Stacked: the wider of the two, and the heights add.
        cw = tw
        if aw > cw {
            cw = aw
        }
        chh = ah + gap + th
        if widget.w_text_len(e) == 0 {
            chh = ah
        }
        // MEHRZEILIGE BESCHRIFTUNG BRAUCHT MEHR HOEHE, und wer sie nicht
        // einrechnet, bekommt genau den Fehler, den der Kopf dieser
        // Datei beschreibt: die zweite Zeile laeuft unten aus der
        // Kachel. Die Breite waechst dabei NICHT -- das ist ja der Sinn
        // des Umbruchs.
        let zl: usize = widget.w_text_lines(e)
        if zl > 1 && widget.w_text_len(e) != 0 {
            chh = chh + ((zl - 1) as f64) * line_h_of(c, e)
        }
    } else {
        // Side by side: the widths add, the height is the taller.
        cw = aw + gap + tw
        chh = th
        if ah > chh {
            chh = ah
        }
    }
    *pw = cw + 2.0 * padx
    *ph = chh + 2.0 * pady
    // A CONTROL IS AT LEAST AS HIGH AS ONE. `ctrl_h` is the theme's
    // "what you touch is at least 32 high" -- a 16 point icon in a
    // button must not make the button shorter than every other button
    // in the row.
    if kind != widget.KIND_LABEL {
        let minh: f64 = len_of(c, (*fo).ctrl_h)
        if *ph < minh {
            *ph = minh
        }
    }
}

// Measure and store in one go -- what a caller does before laying out.
fn set_pref_from(c: *mut Ctx, e: *mut widget.Widget) {
    var pw: f64 = 0.0
    var ph: f64 = 0.0
    pref_of(c, e, &pw, &ph)
    widget.w_set_pref(e, pw, ph)
}

// ======================================================================
// THE TEXT OF A WIDGET
// ======================================================================
//
// Horizontally by the alignment, vertically ALWAYS centred to the font
// metrics -- that is Justin's complaint 1, and the reason stands in
// painter.text_baseline_mid: whoever centres by the line height centres
// the line and not the font.
fn draw_text(c: *mut Ctx, e: *mut widget.Widget) {
    if widget.w_text_len(e) == 0 {
        return
    }
    let z: *mut painter.Painter = ctx_painter(c)
    let sz: *mut style.StyleSet = widget.w_styleset(e)
    let s: *mut style.Style = style.styleset_base(sz)
    let kind: u32 = widget.w_kind(e)
    let zu: u32 = widget.w_state(e)

    // The text colour. On a disabled widget the default is the pale
    // one -- but a style that is set beats it, otherwise you could not
    // choose the colour of a disabled widget.
    var fallback: u32 = def_fg(kind)
    if zu == style.STATE_DISABLED {
        fallback = style.color_token(style.TOK_TEXT_DISABLED)
    }
    let tf: u32 = style.resolve_fg(sz, zu, fallback)
    if !style.color_is_visible(tf) {
        return
    }
    let px: f64 = len_of(c, style.resolve_num(sz, style.SF_FONT_PX,
        (*s).font_px as usize, def_font(c)))
    let padx: f64 = len_of(c, style.resolve_num(sz, style.SF_PAD_X,
        (*s).pad_x as usize, def_pad_x(c, kind)))
    // DIE AUSRICHTUNG KOMMT AUS EINER FUNKTION und nicht mehr aus zwei
    // Zeilen hier: ART_ABOVE_CENTER muss sie ueberschreiben koennen, und
    // `pref_of` fragt dieselbe Regel.
    let align: u32 = text_align_of(e)
    let base_y: f64 = painter.text_baseline_mid(z, widget.w_y(e),
        widget.w_h(e), px)
    // THE RUN CARRIES EVERYTHING THE STYLE SAYS ABOUT TEXT.
    //
    // This is the one place it is assembled, and that is the answer to
    // Justin's "the values have to take effect on EVERY element that
    // paints text -- button, label, list, table, menu, tab, text
    // field. Not only the label." Every one of those goes through
    // `draw_text`, so every one of them gets tracking, kerning, the
    // outline and the shadow without knowing that any of it exists.
    var r: painter.TextRun = text_run_of(c, e, px)

    // THE PICTURE TAKES ITS ROOM OFF THE TEXT BOX.
    //
    // Without this the text would be laid out in the whole rect while the
    // icon sits on the left of it, and a centred label would run straight
    // through the icon. Both sides ask `art_text_split`, so they cannot
    // disagree -- that is the whole reason it is one function.
    var tx0: f64 = widget.w_x(e) + padx
    var tw0: f64 = widget.w_w(e) - 2.0 * padx
    if widget.w_has_art(e) {
        let al: u32 = widget.w_art_align(e)
        if al == widget.ART_ONLY {
            // A picture-only widget draws no text at all.
            return
        }
        var ax: f64 = 0.0
        var ay: f64 = 0.0
        var aw: f64 = 0.0
        var ah: f64 = 0.0
        var nx: f64 = 0.0
        var nw: f64 = 0.0
        art_text_split(c, e, widget.w_x(e) + padx,
            widget.w_y(e) + pady_of(c, e), tw0,
            widget.w_h(e) - 2.0 * pady_of(c, e),
            &ax, &ay, &aw, &ah, &nx, &nw)
        if al == widget.ART_ABOVE || al == widget.ART_ABOVE_CENTER {
            // Text under the picture: the baseline moves down by the
            // picture plus the gap, and the box keeps its width.
            var g: usize = widget.w_art_gap(e)
            if g == 0 {
                g = def_art_gap(c)
            }
            let shift: f64 = ah + len_of(c, g)
            let zl: usize = widget.w_text_lines(e)
            let lh: f64 = painter.run_line_height(z, &r)
            // MEHRZEILIG: die Grundlinie der ERSTEN Zeile so setzen, dass
            // der ganze Block in der Restflaeche mittig steht. Wer
            // stattdessen die erste Zeile mittig setzt und die weiteren
            // darunter haengt, schiebt den Block nach unten aus dem
            // Element -- im Quelltext unsichtbar, im Bild sofort.
            if zl > 1 {
                let blockh: f64 = ((zl - 1) as f64) * lh
                let by2: f64 = painter.text_baseline_mid(z,
                    widget.w_y(e) + shift,
                    widget.w_h(e) - shift - blockh, px)
                let nz: usize = painter.run_draw_wrapped(z, &r, tx0, by2,
                    tw0, lh, color_of(c, tf), widget.w_text(e),
                    widget.w_text_len(e), align, zl)
                return
            }
            let by: f64 = painter.text_baseline_mid(z,
                widget.w_y(e) + shift, widget.w_h(e) - shift, px)
            let e3: f64 = painter.run_draw_ellipsis(z, &r, tx0, by, tw0,
                color_of(c, tf), widget.w_text(e), widget.w_text_len(e),
                align)
            return
        }
        tx0 = nx
        tw0 = nw
    }
    if tw0 <= 0.0 {
        return
    }
    // AUCH DER GEWOEHNLICHE WEG KUERZT MIT PUNKTEN.
    //
    // Vorher schnitt `run_draw` hart auf dem letzten passenden Zeichen
    // ab ("Netz vortaeusc"), und weil das im Quelltext nicht zu sehen
    // ist, stand es monatelang so im Bild. `run_draw_ellipsis` malt
    // unveraendert weiter, solange der Text passt -- der haeufige Fall
    // kostet eine Breitenmessung und sonst nichts.
    let zl2: usize = widget.w_text_lines(e)
    if zl2 > 1 {
        let lh2: f64 = painter.run_line_height(z, &r)
        let blockh2: f64 = ((zl2 - 1) as f64) * lh2
        let by3: f64 = painter.text_baseline_mid(z, widget.w_y(e),
            widget.w_h(e) - blockh2, px)
        let nz2: usize = painter.run_draw_wrapped(z, &r, tx0, by3, tw0,
            lh2, color_of(c, tf), widget.w_text(e),
            widget.w_text_len(e), align, zl2)
        return
    }
    let e2: f64 = painter.run_draw_ellipsis(z, &r, tx0, base_y, tw0,
        color_of(c, tf), widget.w_text(e), widget.w_text_len(e), align)
}

// The vertical padding in pixels -- pulled out because the art split
// needs it and `draw_text` only had the horizontal one.
fn pady_of(c: *mut Ctx, e: *mut widget.Widget) -> f64 {
    let sz: *mut style.StyleSet = widget.w_styleset(e)
    let s: *mut style.Style = style.styleset_base(sz)
    return len_of(c, style.resolve_num(sz, style.SF_PAD_Y,
        (*s).pad_y as usize, def_pad_y(c, widget.w_kind(e))))
}

// DER ZEILENABSTAND DIESES ELEMENTS, in Bildpunkten.
//
// Eine eigene Funktion, weil ihn jetzt DREI Stellen brauchen: das Messen
// (`pref_of`), das Malen (`draw_text`) und die Grundlinie der ersten
// Zeile. Drei Rechnungen desselben Abstands gehen irgendwann auseinander.
fn line_h_of(c: *mut Ctx, e: *mut widget.Widget) -> f64 {
    let z: *mut painter.Painter = ctx_painter(c)
    let sz: *mut style.StyleSet = widget.w_styleset(e)
    let s: *mut style.Style = style.styleset_base(sz)
    let px: f64 = len_of(c, style.resolve_num(sz, style.SF_FONT_PX,
        (*s).font_px as usize, def_font(c)))
    var r: painter.TextRun = text_run_of(c, e, px)
    return painter.run_line_height(z, &r)
}

// DIE TEXTAUSRICHTUNG DIESES ELEMENTS.
//
// ART_ABOVE_CENTER zwingt die Beschriftung in die Mitte -- das ist der
// ganze Unterschied zu ART_ABOVE, und er steht hier und nicht im
// Aufrufer, damit eine Kachel nicht zwei Dinge einstellen muss.
fn text_align_of(e: *mut widget.Widget) -> u32 {
    let sz: *mut style.StyleSet = widget.w_styleset(e)
    let s: *mut style.Style = style.styleset_base(sz)
    if widget.w_has_art(e)
        && widget.w_art_align(e) == widget.ART_ABOVE_CENTER {
        return style.ALIGN_CENTER
    }
    if ((*s).set_mask & style.SF_ALIGN) != 0 as u32 {
        return (*s).align as u32
    }
    // IN EINEM RTL-ELEMENT BEGINNT DER TEXT RECHTS. Die Vorgabe "links"
    // heisst eigentlich "am Anfang" (text-align: start), und der Anfang
    // liegt bei `direction: rtl` rechts. Eine ausdruecklich gesetzte
    // Ausrichtung (oben) bleibt, was sie ist, und "mittig" auch.
    let da: u32 = def_align(widget.w_kind(e))
    if da == style.ALIGN_LEFT && is_rtl_style(e) {
        return style.ALIGN_RIGHT
    }
    return da
}

// ======================================================================
// FROM THE STYLE TO THE TEXT RUN
// ======================================================================
//
// Reads the text values out of the cascade and turns the design points
// into pixels. Anything the style does not set stays at the run's own
// default, so a style that says nothing changes nothing -- the rule
// that holds for every value in fUi.
//
// WHY THE COLOURS GO THROUGH `color_of`: the outline and the shadow
// take a TOKEN like every other colour, so they follow the theme. A
// black shadow hard-coded here would be the one colour in the library
// that does not go dark with the rest -- and that is exactly the fault
// Justin found in the real system.
fn text_run_of(c: *mut Ctx, e: *mut widget.Widget,
    px: f64) -> painter.TextRun {
    let sz: *mut style.StyleSet = widget.w_styleset(e)
    let s: *mut style.Style = style.styleset_base(sz)
    let zu: u32 = widget.w_state(e)
    var r: painter.TextRun = painter.run_new(px)

    // --- weight and slant. These two already existed in the Style and
    // were never used by anything -- now they are.
    let wg: usize = style.resolve_num(sz, style.SF_WEIGHT,
        (*s).weight as usize, style.WEIGHT_NORMAL as usize)
    r = painter.run_set_weight(r, wg)
    let sl: usize = style.resolve_num(sz, style.SF_SLANT,
        (*s).slant as usize, style.SLANT_UPRIGHT as usize)
    r = painter.run_set_slant(r, sl)

    // --- tracking and word spacing, design points -> pixels
    let tr: i64 = style.resolve_snum(sz, style.SF_TRACKING,
        (*s).tracking as i64, 0)
    if tr != 0 {
        r = painter.run_set_tracking(r, len_signed(c, tr))
    }
    let ws: i64 = style.resolve_snum(sz, style.SF_WORD_SPACING,
        (*s).word_spacing as i64, 0)
    if ws != 0 {
        r = painter.run_set_word_spacing(r, len_signed(c, ws))
    }

    // --- kerning. On unless the style says otherwise.
    if ((*s).set_mask & style.SF_KERNING) != 0 as u32 {
        r = painter.run_set_kerning(r, (*s).kerning != 0 as u8)
    }

    // --- the line height, for whoever draws more than one line
    if ((*s).set_mask & style.SF_LINE_HEIGHT) != 0 as u32 {
        if (*s).line_h_abs != 0 as u16 {
            r = painter.run_set_line_height(r,
                len_of(c, (*s).line_h_abs as usize))
        } else {
            r = painter.run_set_line_height(r,
                px * ((*s).line_height as f64) / 1000.0)
        }
    }

    // --- outline
    if ((*s).set_mask & style.SF_OUTLINE) != 0 as u32
        && (*s).out_w != 0 as u16 {
        r = painter.run_set_outline(r,
            len_of(c, (*s).out_w as usize),
            color_of(c, (*s).out_col))
    }

    // --- shadow
    if ((*s).set_mask & style.SF_SHADOW) != 0 as u32 {
        r = painter.run_set_shadow(r,
            len_signed(c, (*s).sh_dx as i64),
            len_signed(c, (*s).sh_dy as i64),
            color_of(c, (*s).sh_col))
    }

    // --- gradient
    if ((*s).set_mask & style.SF_GRADIENT) != 0 as u32 {
        r = painter.run_set_gradient(r, color_of(c, (*s).grad_col))
    }

    // --- die Schreibrichtung (UAX #9). Ohne Angabe entscheidet das
    // erste starke Zeichen -- eine arabische Beschriftung in einer
    // Oberflaeche, die nichts ueber Richtung weiss, steht trotzdem
    // richtig herum.
    r = painter.run_set_dir(r, dir_of(e))
    return r
}

// DIE SCHREIBRICHTUNG EINES ELEMENTS als bidi.DIR_*. Einzeln
// uebersetzt und nicht als Zahl durchgereicht: style.fi muss kernelrein
// bleiben und kennt bidi.fi nicht, also stehen die Werte dort ein
// zweites Mal -- und diese Funktion ist die Stelle, an der die beiden
// Listen einander begegnen.
fn dir_of(e: *mut widget.Widget) -> u32 {
    let s: *mut style.Style = style.styleset_base(widget.w_styleset(e))
    let d: u32 = style.style_direction(s)
    if d == style.DIR_RTL {
        return bidi.DIR_RTL
    }
    if d == style.DIR_LTR {
        return bidi.DIR_LTR
    }
    return bidi.DIR_AUTO
}

// Steht im Stil ausdruecklich RTL? Nur dann beginnen Text und Bild
// rechts. Bei DIR_AUTO entscheidet der Text nur ueber seine eigene
// Reihenfolge, nicht ueber die Anordnung im Element -- sonst sprang eine
// Beschriftung von links nach rechts, sobald jemand ein arabisches Wort
// hineinschreibt.
fn is_rtl_style(e: *mut widget.Widget) -> bool {
    return dir_of(e) == bidi.DIR_RTL
}

// A SIGNED design length into pixels. `len_of` is unsigned because
// every other length is; tracking and the shadow offset are the two
// that may be negative, so the sign is handled here and the scaling
// stays in one place.
fn len_signed(c: *mut Ctx, n: i64) -> f64 {
    if n < 0 {
        return 0.0 - len_of(c, (0 - n) as usize)
    }
    return len_of(c, n as usize)
}

// ======================================================================
// THE WIDGETS
// ======================================================================

// A LABEL. Text, nothing else -- and that is why its background is
// transparent by default (`def_bg`). It is the simplest widget and
// shows that the build-up carries: it has not a single line of drawing
// code of its own.
fn draw_label(c: *mut Ctx, e: *mut widget.Widget) {
    draw_base(c, e)
    draw_widget_art(c, e)
    draw_text(c, e)
    draw_focus_ring(c, e)
}

// A BUTTON. The same build-up -- the difference sits solely in the
// widget defaults (fill instead of transparent, text centred instead of
// left).
fn draw_button(c: *mut Ctx, e: *mut widget.Widget) {
    // DER UEBERGANG LAEUFT HIER, nicht in der Anwendung. Ohne
    // eingehaengtes Register kostet die Zeile einen Vergleich.
    //
    // WARUM IN `draw_button` UND NICHT IN `draw_base`: die Wellen 2/3
    // malen ihre Bausteine (Kasten, Griff, Bahn) als KURZLEBIGE
    // Widgets auf dem Stapel durch `draw_base`. Ein Register, das sich
    // seine Eintraege nach der Adresse des Widgets merkt, bekaeme dort
    // Adressen, die gleich wieder jemand anderem gehoeren. Der ganze
    // Knopf ist langlebig, sein Griff ist es nicht.
    let dirty: bool = anim_run(c, e)
    draw_base(c, e)
    draw_widget_art(c, e)
    draw_text(c, e)
    draw_focus_ring(c, e)
}

// ======================================================================
// DASSELBE WIDGET UNTER EINER AFFINEN ABBILDUNG
// ======================================================================
//
// WARUM DAS HIER STEHT UND NICHT IM ANWENDUNGSPROGRAMM. lib/fui/
// transform.fi konnte seit seinem ersten Tag ein gedrehtes Rechteck und
// einen gedrehten Text malen -- aber nur, wer die Datei kannte, kam
// daran. Ein Widget ging diesen Weg nirgends, und damit war die
// Faehigkeit genau das, wogegen diese Bibliothek angetreten ist:
// vorhanden, geprueft, nicht angeschlossen. Der Zeichenweg gehoert in
// dieselbe Datei wie `draw_base`, und zwar aus demselben Grund, aus dem
// `draw_elevation` hier steht und nicht in effect.fi: WAS ein Widget
// malt, entscheidet render.fi; WIE die Unschaerfe oder die Matrix
// gerechnet wird, entscheidet das Fachmodul.
//
// ES IST DERSELBE AUFBAU wie oben, Schritt fuer Schritt -- Flaeche,
// Rand, Inhalt, Fokusring -- nur dass jede Form durch die Matrix geht:
// die PUNKTE werden abgebildet und danach gerastert, nie das fertige
// Bild gedreht (der Grund steht im Kopf von transform.fi: was einmal
// Pixel ist, bekommt Treppen, die kein Kantenglaetten mehr wegnimmt).
//
// WAS DER AUFRUFER DAZU TUN MUSS: die Trefferpruefung mitdrehen. Sonst
// klickt er neben das, was er sieht. Dafuer gibt es
// `transform.tf_bind_panel` -- eine Zeile, und der normale Zeigerpfad
// von control.fi trifft das gedrehte Widget.
fn draw_widget_xf(c: *mut Ctx, e: *mut widget.Widget,
    xf: *mut transform.Xform) {
    // Auch der gedrehte Weg fuehrt den Uebergang -- sonst haette ein
    // schief stehender Knopf kein Hover und niemand wuesste warum.
    let dirty: bool = anim_run(c, e)
    let z: *mut painter.Painter = ctx_painter(c)
    let sz: *mut style.StyleSet = widget.w_styleset(e)
    let kind: u32 = widget.w_kind(e)
    let zu: u32 = widget.w_state(e)
    let x: f64 = widget.w_x(e)
    let y: f64 = widget.w_y(e)
    let w: f64 = widget.w_w(e)
    let h: f64 = widget.w_h(e)
    let r: f64 = len_of(c, style.resolve_num(sz, style.SF_RADIUS,
        (*style.styleset_base(sz)).radius as usize, def_radius(c, kind)))

    // ---- 1. DIE FLAECHE. Dieselbe Regel wie in `draw_base`: was nicht
    // sichtbar ist, wird NICHT gemalt -- kein Ersatzanstrich.
    // JEDE FARBE GEHT DECKEND HINEIN. `transform.tf_*` gibt die Farbe
    // unveraendert an die Leinwand weiter, und die rechnet mit dem
    // Alphakanal: eine Farbe ohne ihn ist eine unsichtbare Farbe. Das
    // ist derselbe `theme.opaque`, den lib/svg und tools/fui/gallery8
    // an dieser Stelle rufen.
    let bg: u32 = style.resolve_bg(sz, zu, def_bg_state(kind, zu))
    if style.color_is_visible(bg) {
        transform.tf_fill_round_rect(z, xf, x, y, w, h, r, theme.opaque(color_of(c, bg)))
    }

    // ---- 2. DER RAND. Ein Ring ist die Flaeche minus die innere
    // Flaeche; unter einer Abbildung heisst das: das aeussere
    // abgerundete Rechteck malen und das innere in der FLAECHENFARBE
    // daruebersetzen, wenn es eine gibt. Ohne Flaechenfarbe bleibt der
    // Rand ein voller Kasten -- das waere falsch, also wird er dann
    // nicht gemalt. Diese Einschraenkung steht hier ehrlich, statt
    // einen zweiten Ringrasterer aufzumachen.
    let ra: u32 = style.resolve_border(sz, zu, def_border(kind))
    let st: f64 = len_of(c, style.resolve_num(sz, style.SF_BORDER_W,
        (*style.styleset_base(sz)).border_w as usize,
        def_border_width(c, kind)))
    if style.color_is_visible(ra) && st > 0.0 && style.color_is_visible(bg) {
        transform.tf_fill_round_rect(z, xf, x, y, w, h, r, theme.opaque(color_of(c, ra)))
        var ir: f64 = r - st
        if ir < 0.0 {
            ir = 0.0
        }
        transform.tf_fill_round_rect(z, xf, x + st, y + st,
            w - 2.0 * st, h - 2.0 * st, ir, theme.opaque(color_of(c, bg)))
    }

    // ---- 3. DER FOKUSRING. Er steht hier VOR dem Inhalt und nicht
    // wie im geraden Weg dahinter, und das ist kein Versehen: unter
    // einer Abbildung wird ein Ring aus zwei gefuellten Formen gebaut
    // (aussen der Ring, innen die Flaechenfarbe wieder hinein), und
    // die innere Fuellung wuerde die Schrift wegwischen, kaeme sie
    // danach. Am Bild aendert die Reihenfolge nichts -- der Ring liegt
    // am Rand, die Schrift in der Mitte.
    if widget.w_is_focus(e) && !widget.w_is_disabled(e)
        && style.color_is_visible(bg) {
        let m: *mut theme.Theme = ctx_theme(c)
        let fw: f64 = len_of(c, (*theme.theme_shape(m)).focus_w)
        transform.tf_fill_round_rect(z, xf, x, y, w, h, r,
            theme.opaque((*theme.theme_colors(m)).accent))
        var ir2: f64 = r - fw
        if ir2 < 0.0 {
            ir2 = 0.0
        }
        transform.tf_fill_round_rect(z, xf, x + fw, y + fw,
            w - 2.0 * fw, h - 2.0 * fw, ir2, theme.opaque(color_of(c, bg)))
    }

    // ---- 4. DER INHALT. Die Schrift geht Kontur fuer Kontur durch
    // dieselbe Matrix, und sie wird EINMAL gerastert.
    if widget.w_text_len(e) != 0 {
        var fallback: u32 = def_fg(kind)
        if zu == style.STATE_DISABLED {
            fallback = style.color_token(style.TOK_TEXT_DISABLED)
        }
        let tf: u32 = style.resolve_fg(sz, zu, fallback)
        if style.color_is_visible(tf) {
            let s: *mut style.Style = style.styleset_base(sz)
            let px: f64 = len_of(c, style.resolve_num(sz, style.SF_FONT_PX,
                (*s).font_px as usize, def_font(c)))
            let padx: f64 = len_of(c, style.resolve_num(sz, style.SF_PAD_X,
                (*s).pad_x as usize, def_pad_x(c, kind)))
            // Die Grundlinie kommt aus derselben Rechnung wie beim
            // geraden Text -- sonst saesse die Schrift im gedrehten
            // Knopf anders als im geraden.
            let by: f64 = painter.text_baseline_mid(z, y, h, px)
            transform.tf_text(z, xf, x + padx, by, w - 2.0 * padx, px,
                theme.opaque(color_of(c, tf)), widget.w_text(e), widget.w_text_len(e),
                text_align_of(e))
        }
    }
}

// THE DISPATCHER OF THE BUILD-UP. Paints a widget out of what THIS
// file knows: the shared build-up plus the widget defaults.
//
// ================== WHY THE FULL DISPATCHER IS NOT IN THIS FILE
//
// The controls of wave 2 (checkbox, slider, tabs, tooltip, ...) stand
// in lib/fui/wave2.fi, and the one that paints ANY control is
// `wave2.draw_any`. It is the one an application calls.
//
// The direction of the dependency decides that. wave2.fi needs
// `draw_base`, `draw_text` and `draw_focus_ring` from here -- that is
// the shared build-up, and it is the reason all the controls fit
// together. So wave2.fi imports render.fi. If render.fi imported
// wave2.fi back, the two would be a cycle and neither would build.
//
// A function pointer set at start-up would break the cycle, and it was
// tried: Firn stage 0 refuses it, because the starting value of a
// `static` is written into the object file and a function name is not
// a constant in that sense (SPEC 14.1.statics) -- and a null pointer
// is out too, since no conversion between a function pointer and a
// number is allowed.
//
// So the rule for a caller is ONE line, and it stands in the README:
//
//     paint with `wave2.draw_any(c, e)`, not with
//     `render.draw_widget(c, e)`
//
// `draw_any` falls back to this function for everything it does not
// know itself, so nothing is lost -- and the promise of the library
// (one call paints any control, no program paints its own) holds.
fn draw_widget(c: *mut Ctx, e: *mut widget.Widget) {
    let kind: u32 = widget.w_kind(e)
    if kind == widget.KIND_LABEL {
        draw_label(c, e)
        return
    }
    // Button, toggle, tile ... they all paint the same base. What
    // tells them apart are the widget defaults.
    draw_button(c, e)
}