// SPDX-License-Identifier: MPL-2.0
// lib/fui/control.fi -- THE PART THAT MAKES A CONTROL RESPOND.
//
// ========================================================= WHY IT EXISTS
//
// Justin, 11.09.2026, on wave 2: "Hover must really work (mouse move ->
// state change -> repaint), not just a field in the struct." And:
// "A slider must be draggable and deliver a VALUE, not only look drawn."
//
// That is the whole reason this file is separate from widget.fi and
// from render.fi. Wave 1 could get away without it, because a button
// whose `hover` bit somebody else sets still LOOKS right in a gallery
// picture. A slider cannot: whether it works is not decided by how it
// is painted but by whether pulling the mouse changes the number.
//
// THE MISTAKE THIS PREVENTS is the one the brief names outright --
// FAKE SWITCHES. A checkbox that paints a tick but never flips, a
// slider that shows a handle at a fixed place: both look perfect in a
// screenshot and are worth nothing. Whoever puts the event handling in
// the application instead of the library gets exactly that, because
// every application then invents its own -- and nineteen of twenty
// invent it wrong.
//
// ================================================== WHAT A PANEL IS
//
// A `Panel` is a LIST OF WIDGETS THE CALLER OWNS plus three numbers:
// who is under the pointer, who is being pressed, who has the focus.
// Those three are exactly the state that cannot live in a single
// widget, because they are relationships BETWEEN widgets: only one
// widget at a time can be hovered, and that is a property of the set,
// not of the element.
//
// The widgets stay the caller's. A Panel holds a pointer to his array
// and a count -- no allocation and no copy. That is the same decision
// widget.fi made in E1 and E3, and for the same reason. The file sits
// in the app profile only because widget.fi does; it asks for no
// memory of its own and would otherwise be core-clean.
//
// ======================================= WHY IT RETURNS "PLEASE REPAINT"
//
// Every event function gives back a bitmask: what CHANGED. Nothing
// changed -> 0 -> the caller does not repaint. That is not an
// optimisation for its own sake, it is the difference between a
// window that redraws sixty times a second while the mouse sits still
// and one that does not.
//
// The caller cannot forget it either: he gets the answer as the return
// value of the call he had to make anyway.
//
// ==================================================== WHAT IS NOT HERE
//
// S1 NO drawing. This file never touches a canvas; it imports neither
//    painter nor render. Event handling and painting are two jobs,
//    and a file that does both cannot be tested without a screen.
// S2 NO timer. A tooltip appears after a delay -- the delay is COUNTED
//    by the caller, who owns the clock. This file only takes the
//    answer ("the pointer has now rested long enough") and turns it
//    into a state.
// S3 NO keyboard focus chain beyond tab order. Which key does what is
//    the widget's business (lib/fui/editor.fi does it for text).
import fui.widget

export {
    Panel, panel_new, panel_attach, panel_count, panel_widget,
    panel_hot, panel_pressed, panel_focus,
    panel_set_focus, panel_clear, key_arrow, panel_key, panel_char, SLIDER_STEP, SLIDER_PAGE,
    KN_LEFT, KN_RIGHT, KN_HOME, KN_END, KN_ENTER, KN_ESC, KN_TAB, KN_UP, KN_DOWN, KN_PGUP, KN_PGDN,
    mouse_move, mouse_down, mouse_up, mouse_leave, mouse_cancel,
    key_tab, activate_focused,
    CH_NONE, CH_REPAINT, CH_VALUE, CH_ACTIVATE, CH_FOCUS, DMG_OVER, panel_dmg_take,
    NOBODY,
    hit_test,
    value_from_x, value_from_y, clamp_i64,
    track_begin, track_active, track_end, track_widget,
    drag_value,
    // The hit test that another place supplies -- see below.
    panel_hits, panel_set_hit, panel_clear_hit, hit_plain,
    // What can take the focus -- THE one rule for it, which
    // lib/fui/a11y.fi also asks, instead of keeping one of its own.
    can_focus,
    // A panel over widgets that do not lie densely in an array
    // (the nodes of a scene.Scene), and a lent tab order.
    panel_attach_stride, panel_set_order, panel_clear_order,
    // After a rebuild: who held what, found again by key (lib/fui/query.fi).
    panel_restore,
    // MNEMONICS (Alt+letter, '&'-marked labels; opt-in per panel).
    panel_set_mnemonics, panel_mnemonics, panel_alt_char, panel_mnemonic_count,
    panel_mnemonic_widget, panel_mn_bind, panel_mn_clear, panel_mn_index, panel_mn_letter, mn_letter, mn_index, mn_clean, MN_NONE,
}

// ===================================================== THE CHANGE BITS
//
// What came of an event. They combine: a click on a checkbox changes
// the value AND wants a repaint AND counts as an activation.
const CH_NONE: u32 = 0
const CH_REPAINT: u32 = 1 // the picture is stale
const CH_VALUE: u32 = 2 // the value of a widget moved
const CH_ACTIVATE: u32 = 4 // a button was really triggered
const CH_FOCUS: u32 = 8 // the focus moved

// "no widget". Not 0 -- 0 is the first widget.
const NOBODY: usize = 18446744073709551615

// ============================================================ THE PANEL
//
// `p` is the caller's array of `widget.Widget`. It is held as a u64 and
// not as a typed pointer, because a struct in the kernel profile must
// not carry a pointer into GC memory -- the same reason render.Ctx
// keeps its theme as u64.
struct Panel {
    p: u64, // *mut widget.Widget -- the caller's array
    n: usize, // how many
    hot: usize, // under the pointer, or NOBODY
    press: usize, // being held down, or NOBODY
    focus: usize, // has the keyboard, or NOBODY
    // The drag. `track` is the widget the button went down on and that
    // keeps receiving the movement until it is released -- ALSO when
    // the pointer has long left it. That is the point: whoever pulls a
    // slider and slips off it by two pixels does not want the handle
    // to jump back.
    track: usize,
    tombstone: i64, // the offset inside the handle at the moment of grabbing
    // WHO DECIDES WHETHER A POINT LIES ON A WIDGET.
    //
    // The default is `hit_plain` -- the straight rectangle, as it
    // always was. Whoever draws under an AFFINE TRANSFORMATION hangs
    // their own answer in here (lib/fui/transform.fi does that with
    // `tf_bind_panel`), and the whole pointer path of this file then goes
    // through it: hover, press, release.
    //
    // IT IS A FUNCTION AND NOT A MATRIX. A matrix in this
    // field would mean that control.fi has to know lib/svg/matrix.fi and
    // write the inverse mapping down a second time. This way the
    // calculation stays where it already stands, and this file knows only:
    // somebody can answer the question better than I can.
    zx: u64, // state of that answer, its owner is the caller
    zh: fn(u64, *mut widget.Widget, f64, f64) -> bool,
    // THE DISTANCE BETWEEN TWO WIDGETS IN THE CALLER'S ARRAY, in bytes.
    // 0 means: a dense array of widget.Widget (the default, as
    // it always was). A described tree, however, holds its widgets IN
    // its nodes (scene.Node carries one), and those lie a
    // whole node apart. With this distance the same
    // panel serves them too -- instead of a second
    // focus management for trees arising next to it.
    st: usize,
    // THE TAB ORDER, LENT. 0 means: the order of the
    // array (the default). Otherwise the address of an array of usize
    // that names `nord` numbers of widgets in the order in which
    // Tab is to run -- lib/fui/a11y.fi calculates it from the
    // tree order. The array belongs to the caller; the panel only
    // reads it, and WHO has the focus still stands only here.
    ord: u64,
    nord: usize,
    // DAMAGE: the widgets whose LOOK changed since the host last asked
    // (hover, press, focus ring). The host turns them into one dirty
    // rectangle, so a hover repaints a button and not the window.
    // dmg_n == DMG_OVER: too many to list -- paint everything.
    dmg: [usize; 6],
    dmg_n: usize,
    // 1 = labels may carry a '&' mnemonic marker (opt-in: a literal '&' in
    // normal text must stay a '&'). Set with `panel_set_mnemonics`.
    mn: u32,
    // BOUND MNEMONICS: a program that strips the '&' from the shown text (so no
    // ampersand is painted) tells the panel the letter instead (`panel_mn_bind`).
    nmn: usize,
    mnw: [usize; 48],
    mnl: [u32; 48],
    mni: [usize; 48],
}

const DMG_OVER: usize = 255

// note that widget i changed its look
fn dm_note(s: *mut Panel, i: usize) {
    if i == NOBODY || (*s).dmg_n == DMG_OVER {
        return
    }
    var k: usize = 0
    while k < (*s).dmg_n {
        if (*s).dmg[k] == i {
            return
        }
        k = k + 1
    }
    if (*s).dmg_n >= 6 {
        (*s).dmg_n = DMG_OVER
        return
    }
    (*s).dmg[(*s).dmg_n] = i
    (*s).dmg_n = (*s).dmg_n + 1
}

// Take the noted widgets (out) and forget them. Returns how many, or
// DMG_OVER when the list overflowed.
fn panel_dmg_take(s: *mut Panel, out: *mut [usize; 6]) -> usize {
    let n: usize = (*s).dmg_n
    var k: usize = 0
    while k < 6 {
        (*out)[k] = (*s).dmg[k]
        k = k + 1
    }
    (*s).dmg_n = 0
    return n
}

fn panel_new() -> Panel {
    return Panel { p: 0, n: 0, hot: NOBODY, press: NOBODY,
        focus: NOBODY, track: NOBODY, tombstone: 0,
        zx: 0, zh: hit_plain, st: 0, ord: 0, nord: 0, dmg: [0; 6], dmg_n: 0, mn: 0 as u32,
        nmn: 0, mnw: [0; 48], mnl: [0 as u32; 48], mni: [0; 48] }
}

// THE DEFAULT: the straight rectangle of the widget, together with the rule that
// a disabled widget is not hit (widget.w_hits).
fn hit_plain(zx: u64, e: *mut widget.Widget, x: f64, y: f64) -> bool {
    return widget.w_hits(e, x, y)
}

// Hang in a foreign answer. `zx` is its state; it belongs to
// the caller and is only passed through here.
fn panel_set_hit(s: *mut Panel, zx: u64,
    h: fn(u64, *mut widget.Widget, f64, f64) -> bool) {
    (*s).zx = zx
    (*s).zh = h
}

// Back to the straight rectangle.
fn panel_clear_hit(s: *mut Panel) {
    (*s).zx = 0
    (*s).zh = hit_plain
}

// THE ONE PLACE AT WHICH THIS FILE ASKS WHETHER A POINT HITS. Everything
// in the pointer path goes through here -- otherwise the search would find the rotated
// widget, and the release on it no longer.
fn panel_hits(s: *mut Panel, e: *mut widget.Widget, x: f64, y: f64) -> bool {
    return (*s).zh((*s).zx, e, x, y)
}

// The caller hands his array over. Nothing is copied.
fn panel_attach(s: *mut Panel, p: u64, n: usize) {
    (*s).p = p
    (*s).n = n
    (*s).hot = NOBODY
    (*s).press = NOBODY
    (*s).track = NOBODY
    (*s).st = 0
    (*s).ord = 0
    (*s).nord = 0
}

// THE SAME WITH A DISTANCE. `stride` is the distance of two widgets
// in bytes and is MEASURED by the caller (difference of two neighbours
// of a real array), not written down as a digit -- the same
// rule as with `widget_size` and layout.rect_stride.
fn panel_attach_stride(s: *mut Panel, p: u64, n: usize, stride: usize) {
    panel_attach(s, p, n)
    (*s).st = stride
}

// Lend the tab order: `ord` points to `n` numbers (usize).
// Numbers that do not exist in the panel are passed over when walking,
// instead of reaching into nothing.
fn panel_set_order(s: *mut Panel, ord: u64, n: usize) {
    (*s).ord = ord
    (*s).nord = n
}

fn panel_clear_order(s: *mut Panel) {
    (*s).ord = 0
    (*s).nord = 0
}

fn panel_count(s: *mut Panel) -> usize { return (*s).n }

// The i-th widget. The arithmetic is the one the compiler would do --
// it stands here because the array is held as a raw address.
fn panel_widget(s: *mut Panel, i: usize) -> *mut widget.Widget {
    var st: usize = (*s).st
    if st == 0 {
        st = widget_size()
    }
    return ((*s).p + ((i * st) as u64)) as *mut widget.Widget
}

// How big one widget is. `size_of` is not available in stage 0, so it
// is measured: the distance between element 0 and element 1 of a real
// array. That is exact and survives every change to the struct -- a
// hard-coded number would not.
fn widget_size() -> usize {
    var probe: [widget.Widget; 2] = [widget.widget_new(widget.KIND_NONE); 2]
    let a: usize = (&probe[0]) as usize
    let b: usize = (&probe[1]) as usize
    return b - a
}

fn panel_hot(s: *mut Panel) -> usize { return (*s).hot }
fn panel_pressed(s: *mut Panel) -> usize { return (*s).press }
fn panel_focus(s: *mut Panel) -> usize { return (*s).focus }

// ============================================================ THE HIT
//
// WHO IS UNDER THE POINTER. Searched from the BACK forwards, because
// what was painted last lies on top -- a menu that opens over a button
// must take the click, not the button under it.
//
// A disabled widget is not hit; `widget.w_hits` sees to that, and the
// reason stands there: it would swallow clicks meant for what lies
// beneath.
fn hit_test(s: *mut Panel, x: f64, y: f64) -> usize {
    if (*s).n == 0 {
        return NOBODY
    }
    var i: usize = (*s).n
    while i > 0 {
        i = i - 1
        let e: *mut widget.Widget = panel_widget(s, i)
        if panel_hits(s, e, x, y) {
            return i
        }
    }
    return NOBODY
}

// ==================================================== THE MOUSE MOVES
//
// THIS IS THE FUNCTION JUSTIN'S POINT IS ABOUT. Hover is not a field
// somebody sets -- it is what happens here:
//
//   1. work out who is under the pointer now
//   2. if that is somebody else than before: clear the old bit, set
//      the new one
//   3. say that the picture is stale
//
// Step 3 is the one that is forgotten, and then hover "works" in the
// data and not on the screen.
//
// WHILE A BUTTON IS HELD DOWN hover does not wander: the pressed
// widget keeps the pointer until it is released. Otherwise dragging
// across a toolbar would light up every button on the way.
fn mouse_move(s: *mut Panel, x: f64, y: f64) -> u32 {
    // A drag beats everything: the tracked widget gets the movement.
    if (*s).track != NOBODY {
        return drag_move(s, x, y)
    }

    let neu: usize = hit_test(s, x, y)
    var ch: u32 = CH_NONE

    if neu == (*s).hot {
        return CH_NONE
    }

    // the old one loses the hover
    if (*s).hot != NOBODY && (*s).hot < (*s).n {
        widget.w_set_hover(panel_widget(s, (*s).hot), false)
        dm_note(s, (*s).hot)
        ch = ch | CH_REPAINT
    }
    // the new one gets it
    if neu != NOBODY {
        dm_note(s, neu)
        widget.w_set_hover(panel_widget(s, neu), true)
        ch = ch | CH_REPAINT
    }
    (*s).hot = neu

    // A widget being held down keeps its pressed look only while the
    // pointer is on it. That is the behaviour of every system: press,
    // slide off, and the button rises again -- releasing outside must
    // not trigger.
    if (*s).press != NOBODY && (*s).press < (*s).n {
        let e: *mut widget.Widget = panel_widget(s, (*s).press)
        widget.w_set_active(e, (*s).press == neu)
        dm_note(s, (*s).press)
        ch = ch | CH_REPAINT
    }
    return ch
}

// ===================================================== THE BUTTON GOES DOWN
//
// Sets `active` and moves the focus. Both belong together: a click
// takes the focus away from wherever it was, and that has to be
// visible at once.
fn mouse_down(s: *mut Panel, x: f64, y: f64) -> u32 {
    let i: usize = hit_test(s, x, y)
    var ch: u32 = CH_REPAINT
    if i == NOBODY {
        // Clicking into empty space takes the focus away. Otherwise a
        // ring stays standing on a widget nobody is working in.
        if (*s).focus != NOBODY {
            ch = ch | panel_set_focus(s, NOBODY)
        }
        return ch
    }
    let e: *mut widget.Widget = panel_widget(s, i)
    widget.w_set_active(e, true)
    dm_note(s, i)
    (*s).press = i
    ch = ch | panel_set_focus(s, i)

    // A widget that carries a value takes the press as the start of a
    // drag. WHICH widgets those are is decided by the kind -- and by
    // that alone, so that a new kind does not have to be entered in
    // three places.
    if kind_drags(widget.w_kind(e)) {
        ch = ch | track_begin(s, i, x, y)
    }
    return ch
}

// ==================================================== THE BUTTON COMES UP
//
// AN ACTIVATION ONLY COUNTS WHEN IT GOES UP ON THE SAME WIDGET. That
// is not a detail: it is the way out every system offers -- press the
// wrong button, slide off, release. Whoever triggers on the way down
// takes that away.
fn mouse_up(s: *mut Panel, x: f64, y: f64) -> u32 {
    var ch: u32 = CH_NONE

    if (*s).track != NOBODY {
        ch = ch | track_end(s)
    }

    if (*s).press == NOBODY {
        return ch
    }
    let i: usize = (*s).press
    (*s).press = NOBODY
    if i >= (*s).n {
        return ch | CH_REPAINT
    }
    let e: *mut widget.Widget = panel_widget(s, i)
    widget.w_set_active(e, false)
    dm_note(s, i)
    ch = ch | CH_REPAINT

    // Really on it? Then it is an activation.
    if panel_hits(s, e, x, y) {
        ch = ch | CH_ACTIVATE
        ch = ch | toggle_on_click(e)
    }
    return ch
}

// The pointer leaves the window. Everything that hangs on it goes out
// -- a hover that stays standing when the mouse is elsewhere is the
// most visible bug of the lot.
fn mouse_leave(s: *mut Panel) -> u32 {
    var ch: u32 = CH_NONE
    if (*s).hot != NOBODY && (*s).hot < (*s).n {
        widget.w_set_hover(panel_widget(s, (*s).hot), false)
        dm_note(s, (*s).hot)
        ch = ch | CH_REPAINT
    }
    (*s).hot = NOBODY
    if (*s).press != NOBODY && (*s).press < (*s).n {
        dm_note(s, (*s).press)
        widget.w_set_active(panel_widget(s, (*s).press), false)
        ch = ch | CH_REPAINT
    }
    return ch
}

// THE POINTER WAS TAKEN AWAY (lib/fui/event.fi, docs/APP-TREE.md T4). A
// gesture won the arena -- a pan, a pinch, a long press -- and the press
// that started it must not end as a click. Unlike mouse_leave this also
// lets go of the press and the drag, so the later mouse_up finds nothing
// to activate. The hover stays: the pointer is still there.
fn mouse_cancel(s: *mut Panel) -> u32 {
    var ch: u32 = CH_NONE
    if (*s).press != NOBODY && (*s).press < (*s).n {
        dm_note(s, (*s).press)
        widget.w_set_active(panel_widget(s, (*s).press), false)
        ch = ch | CH_REPAINT
    }
    (*s).press = NOBODY
    if (*s).track != NOBODY {
        ch = ch | track_end(s)
    }
    return ch
}

// ====================================================== WHAT A CLICK FLIPS
//
// A checkbox flips, a radio button switches on and switches its
// siblings off, a toggle switch flips. A button does nothing -- it
// has no value.
//
// THIS STANDS HERE AND NOT IN THE APPLICATION. That is the whole point
// of the brief: whoever leaves the flipping to the caller gets a
// checkbox that one program flips and the next does not.
fn toggle_on_click(e: *mut widget.Widget) -> u32 {
    let k: u32 = widget.w_kind(e)
    if k == widget.KIND_CHECKBOX || k == widget.KIND_TOGGLE {
        var v: i64 = widget.w_value(e)
        // 2 is "partially" (the dash). A click out of partially goes
        // to ON -- that is what the systems do, and it is the only
        // answer that is not arbitrary.
        if v == 0 {
            v = 1
        } else {
            v = 0
        }
        widget.w_set_value(e, v)
        widget.w_set_selected(e, v != 0)
        return CH_VALUE
    }
    if k == widget.KIND_RADIO {
        widget.w_set_value(e, 1)
        widget.w_set_selected(e, true)
        return CH_VALUE
    }
    if k == widget.KIND_TAB {
        widget.w_set_selected(e, true)
        return CH_VALUE
    }
    return CH_NONE
}

// Which kinds answer to being dragged. One list, so a new kind is
// entered once.
fn kind_drags(k: u32) -> bool {
    return k == widget.KIND_SLIDER || k == widget.KIND_SCROLLBAR
}

// ============================================================ THE FOCUS
fn panel_set_focus(s: *mut Panel, i: usize) -> u32 {
    if (*s).focus == i {
        return CH_NONE
    }
    if (*s).focus != NOBODY && (*s).focus < (*s).n {
        dm_note(s, (*s).focus)
        widget.w_set_focus(panel_widget(s, (*s).focus), false)
    }
    dm_note(s, i)
    if i != NOBODY && i < (*s).n {
        // A disabled widget does not take the focus -- otherwise the
        // tab order runs into a dead end.
        if widget.w_is_disabled(panel_widget(s, i)) {
            (*s).focus = NOBODY
            return CH_REPAINT | CH_FOCUS
        }
        widget.w_set_focus(panel_widget(s, i), true)
    }
    (*s).focus = i
    return CH_REPAINT | CH_FOCUS
}

// TAB AND SHIFT+TAB. Skips everything that cannot be focused -- a
// label, a separator, anything disabled. Wraps around at the end,
// because a focus that gets stuck at the last widget is a trap for
// somebody working by keyboard.
fn key_tab(s: *mut Panel, backwards: bool) -> u32 {
    if (*s).n == 0 {
        return CH_NONE
    }
    if (*s).ord != 0 && (*s).nord > 0 {
        return key_tab_order(s, backwards)
    }
    var start: usize = (*s).focus
    var i: usize = 0
    while i < (*s).n {
        var k: usize = 0
        if start == NOBODY {
            if backwards {
                k = (*s).n - 1 - i
            } else {
                k = i
            }
        } else {
            if backwards {
                // + n so the subtraction cannot go below zero
                k = (start + (*s).n - 1 - i) % (*s).n
            } else {
                k = (start + 1 + i) % (*s).n
            }
        }
        if can_focus(panel_widget(s, k)) {
            return panel_set_focus(s, k)
        }
        i = i + 1
    }
    return CH_NONE
}

// THE SAME WALKING OVER THE LENT ORDER. The rules are word for word
// the same as `key_tab`: what `can_focus` rejects is skipped
// (so also everything disabled, at the moment at which
// walking happens -- a button that was disabled only after calculating the
// order is skipped nevertheless), and at the end
// it starts again at the front. If the focus stands on no widget of the
// order, Tab begins at the first and Shift+Tab at the last.
fn key_tab_order(s: *mut Panel, backwards: bool) -> u32 {
    let m: usize = (*s).nord
    var pos: usize = NOBODY
    var k: usize = 0
    while k < m {
        if order_at(s, k) == (*s).focus {
            pos = k
        }
        k = k + 1
    }
    var i: usize = 0
    while i < m {
        var j: usize = 0
        if pos == NOBODY {
            if backwards {
                j = m - 1 - i
            } else {
                j = i
            }
        } else {
            if backwards {
                j = (pos + m - 1 - i) % m
            } else {
                j = (pos + 1 + i) % m
            }
        }
        let w: usize = order_at(s, j)
        if w < (*s).n && can_focus(panel_widget(s, w)) {
            return panel_set_focus(s, w)
        }
        i = i + 1
    }
    return CH_NONE
}

// The k-th number of the lent order. The 8 is the width
// of a usize and does not change if somebody adds a field to a
// structure.
fn order_at(s: *mut Panel, k: usize) -> usize {
    return *(((*s).ord + (k * 8) as u64) as *mut usize)
}

// What can take the focus. A label cannot -- it does nothing, and a
// ring around it would only be in the way.
fn can_focus(e: *mut widget.Widget) -> bool {
    if widget.w_is_disabled(e) {
        return false
    }
    let k: u32 = widget.w_kind(e)
    if k == widget.KIND_LABEL || k == widget.KIND_SEPARATOR
    || k == widget.KIND_TOOLTIP || k == widget.KIND_PROGRESS
    || k == widget.KIND_BADGE || k == widget.KIND_CARD
    || k == widget.KIND_GROUPBOX || k == widget.KIND_NONE {
        return false
    }
    return true
}

// SPACE AND ENTER ON THE FOCUSED WIDGET. The keyboard equivalent of a
// click, and it has to flip exactly the same things -- hence the same
// function (`toggle_on_click`) and not a second copy of the rules.
fn activate_focused(s: *mut Panel) -> u32 {
    if (*s).focus == NOBODY || (*s).focus >= (*s).n {
        return CH_NONE
    }
    let e: *mut widget.Widget = panel_widget(s, (*s).focus)
    if widget.w_is_disabled(e) {
        return CH_NONE
    }
    return CH_REPAINT | CH_ACTIVATE | toggle_on_click(e)
}


// ====================================== THE ARROW KEYS AND THE WHOLE KEYBOARD (W5)
//
// What a keyboard user expects of every control, in ONE place so that a host
// does not decide it (the same keys must do the same on every host):
//
//   Tab / Shift+Tab   next / previous focusable widget (key_tab_order or key_tab)
//   Space             press the focused widget (checkbox / switch flips, radio selects,
//                     button triggers) -- `panel_char(s, 32)`
//   Enter             triggers a button; flips nothing else that has no default action
//   Left / Down       slider and scrollbar: one step less (SLIDER_STEP per mille)
//   Right / Up        one step more
//   PgDn / PgUp       a page (SLIDER_PAGE) less / more
//   Home / End        the lowest / the highest value
//   Left/Up, Right/Down on a radio: the previous / next radio of the RUN of
//                     radio widgets the focus is in (wraps), selected at once
//   Esc               lets go of a held pointer (a drag in progress is cancelled)
//
// The key numbers are those of lib/fui/editor.fi (what fui.apphost hands to a
// program); they stand here as numbers because this file imports only the
// widget. tools/fui/keyboard_main.fi holds them against editor.KEY_*.
const SLIDER_STEP: i64 = 10
const SLIDER_PAGE: i64 = 100
const KN_LEFT: u32 = 1
const KN_RIGHT: u32 = 2
const KN_HOME: u32 = 3
const KN_END: u32 = 4
const KN_ENTER: u32 = 7
const KN_ESC: u32 = 8
const KN_TAB: u32 = 9
const KN_UP: u32 = 10
const KN_DOWN: u32 = 11
const KN_PGUP: u32 = 12
const KN_PGDN: u32 = 13

fn radio_neighbour(s: *mut Panel, from: usize, forward: bool) -> usize {
    // the run of consecutive radio widgets around `from`
    var lo: usize = from
    while lo > 0 && widget.w_kind(panel_widget(s, lo - 1)) == widget.KIND_RADIO {
        lo = lo - 1
    }
    var hi: usize = from
    while hi + 1 < (*s).n && widget.w_kind(panel_widget(s, hi + 1)) == widget.KIND_RADIO {
        hi = hi + 1
    }
    var j: usize = from
    var tries: usize = 0
    while tries <= hi - lo {
        if forward {
            if j >= hi { j = lo } else { j = j + 1 }
        } else {
            if j <= lo { j = hi } else { j = j - 1 }
        }
        if !widget.w_is_disabled(panel_widget(s, j)) {
            return j
        }
        tries = tries + 1
    }
    return from
}

fn key_arrow(s: *mut Panel, key: u32) -> u32 {
    if (*s).focus == NOBODY || (*s).focus >= (*s).n {
        return CH_NONE
    }
    let f: usize = (*s).focus
    let e: *mut widget.Widget = panel_widget(s, f)
    if widget.w_is_disabled(e) {
        return CH_NONE
    }
    let k: u32 = widget.w_kind(e)
    if kind_drags(k) {
        let v: i64 = widget.w_value(e)
        var n: i64 = v
        if key == KN_LEFT || key == KN_DOWN {
            n = v - SLIDER_STEP
        } else if key == KN_RIGHT || key == KN_UP {
            n = v + SLIDER_STEP
        } else if key == KN_PGDN {
            n = v - SLIDER_PAGE
        } else if key == KN_PGUP {
            n = v + SLIDER_PAGE
        } else if key == KN_HOME {
            n = 0
        } else if key == KN_END {
            n = VAL_MAX
        } else {
            return CH_NONE
        }
        n = clamp_i64(n, 0, VAL_MAX)
        if n == v {
            return CH_NONE
        }
        widget.w_set_value(e, n)
        return CH_REPAINT | CH_VALUE
    }
    if k == widget.KIND_RADIO {
        var fwd: bool = false
        if key == KN_RIGHT || key == KN_DOWN {
            fwd = true
        } else if key != KN_LEFT && key != KN_UP {
            return CH_NONE
        }
        let j: usize = radio_neighbour(s, f, fwd)
        if j == f {
            return CH_NONE
        }
        // the radios of the run: all off, the neighbour on, the focus follows
        var a: usize = j
        while a > 0 && widget.w_kind(panel_widget(s, a - 1)) == widget.KIND_RADIO {
            a = a - 1
        }
        var b: usize = j
        while b + 1 < (*s).n && widget.w_kind(panel_widget(s, b + 1)) == widget.KIND_RADIO {
            b = b + 1
        }
        var q: usize = a
        while q <= b {
            let r: *mut widget.Widget = panel_widget(s, q)
            widget.w_set_value(r, 0)
            widget.w_set_selected(r, false)
            q = q + 1
        }
        let ch: u32 = toggle_on_click(panel_widget(s, j))
        return panel_set_focus(s, j) | ch | CH_REPAINT
    }
    return CH_NONE
}

// A key code of the editor numbering on the panel. Returns CH_* bits.
fn panel_key(s: *mut Panel, key: u32, shift: bool) -> u32 {
    if key == KN_TAB {
        if (*s).nord > 0 {
            return key_tab_order(s, shift) | CH_REPAINT
        }
        return key_tab(s, shift) | CH_REPAINT
    }
    if key == KN_ENTER {
        if (*s).focus != NOBODY && (*s).focus < (*s).n
        && widget.w_kind(panel_widget(s, (*s).focus)) == widget.KIND_BUTTON {
            return activate_focused(s)
        }
        return CH_NONE
    }
    if key == KN_ESC {
        return mouse_cancel(s)
    }
    return key_arrow(s, key)
}

// A character: Space (32) presses the focused widget, like Enter on a button.
fn panel_char(s: *mut Panel, cp: u32) -> u32 {
    if cp == 32 as u32 {
        return activate_focused(s)
    }
    return CH_NONE
}

// ============================================================ THE DRAG
//
// THIS IS WHAT MAKES A SLIDER A SLIDER. Justin's condition: it must be
// draggable and deliver a value.
//
// The values run 0..1000 (per mille) and not 0..100 or 0..1: a
// slider 200 pixels wide has 200 positions, and with 0..100 every
// second pixel would be the same number -- you feel that as juddering.
// An integer and not a float, because a value that gets saved and read
// back has to compare equal -- 0.1 does not.
const VAL_MAX: i64 = 1000

fn clamp_i64(v: i64, lo: i64, hi: i64) -> i64 {
    if v < lo { return lo }
    if v > hi { return hi }
    return v
}

// WHERE THE POINTER SITS, AS A VALUE.
//
// The usable travel is not the full width: the handle has a width of
// its own and its CENTRE is what points at the value. Whoever
// forgets that gets a slider that reaches 1000 before the right edge
// and never quite gets to 0.
fn value_from_x(x: f64, left: f64, width: f64, handle: f64) -> i64 {
    var travel: f64 = width - handle
    if travel <= 0.0 {
        return 0
    }
    let rel: f64 = x - left - handle / 2.0
    let v: i64 = ((rel * (VAL_MAX as f64)) / travel) as i64
    return clamp_i64(v, 0, VAL_MAX)
}

// The same downwards, for a vertical scrollbar. Counted from the TOP:
// 0 is up, 1000 is down -- that is how a scroll position reads.
fn value_from_y(y: f64, top: f64, height: f64, handle: f64) -> i64 {
    var travel: f64 = height - handle
    if travel <= 0.0 {
        return 0
    }
    let rel: f64 = y - top - handle / 2.0
    let v: i64 = ((rel * (VAL_MAX as f64)) / travel) as i64
    return clamp_i64(v, 0, VAL_MAX)
}

// Grab it. The value jumps to where it was clicked -- that is what
// every system does today, and it is the only behaviour that makes
// sense on a touch screen.
fn track_begin(s: *mut Panel, i: usize, x: f64, y: f64) -> u32 {
    (*s).track = i
    (*s).tombstone = 0
    return drag_move(s, x, y)
}

fn track_active(s: *mut Panel) -> bool { return (*s).track != NOBODY }
fn track_widget(s: *mut Panel) -> usize { return (*s).track }

fn track_end(s: *mut Panel) -> u32 {
    if (*s).track == NOBODY {
        return CH_NONE
    }
    (*s).track = NOBODY
    return CH_REPAINT
}

// The movement during a drag. Works out the new value and writes it
// -- and ONLY reports CH_VALUE when it really changed, so that a
// caller who saves on every change does not save a thousand times.
fn drag_move(s: *mut Panel, x: f64, y: f64) -> u32 {
    let i: usize = (*s).track
    if i == NOBODY || i >= (*s).n {
        return CH_NONE
    }
    let e: *mut widget.Widget = panel_widget(s, i)
    let alt: i64 = widget.w_value(e)
    let neu: i64 = drag_value(e, x, y)
    if neu == alt {
        return CH_NONE
    }
    widget.w_set_value(e, neu)
    return CH_REPAINT | CH_VALUE
}

// WHICH VALUE A POINTER POSITION MEANS ON THIS WIDGET.
//
// Separate, so the acceptance can check the arithmetic without a
// Panel and without events -- a number you can only get at through
// three layers of mouse handling does not get checked.
//
// Which way round it runs follows the SHAPE and not the kind: a
// scrollbar lying on its side is dragged horizontally like a slider.
// That way a horizontal scrollbar needs no case of its own.
fn drag_value(e: *mut widget.Widget, x: f64, y: f64) -> i64 {
    let w: f64 = widget.w_w(e)
    let h: f64 = widget.w_h(e)
    if h > w {
        // upright: the handle is as high as it is wide
        return value_from_y(y, widget.w_y(e), h, w)
    }
    return value_from_x(x, widget.w_x(e), w, h)
}

// Everything off. For a caller who rebuilds his window.
// PUT THE FOUR BACK after the widgets were rebuilt (lib/fui/query.fi finds
// them again by key path). Numbers past the panel -- a control that is gone
// -- are let go (NOBODY). The widget bits are set again, because a rebuilt
// widget starts without them.
fn panel_restore(s: *mut Panel, focus: usize, hot: usize, press: usize,
    track: usize) {
    (*s).focus = NOBODY
    (*s).hot = NOBODY
    (*s).press = NOBODY
    (*s).track = NOBODY
    if hot < (*s).n {
        (*s).hot = hot
        widget.w_set_hover(panel_widget(s, hot), true)
    }
    if press < (*s).n {
        (*s).press = press
        widget.w_set_active(panel_widget(s, press), true)
    }
    if track < (*s).n {
        (*s).track = track
    }
    if focus < (*s).n {
        let ch: u32 = panel_set_focus(s, focus)
    }
}

fn panel_clear(s: *mut Panel) {
    var i: usize = 0
    while i < (*s).n {
        let e: *mut widget.Widget = panel_widget(s, i)
        widget.w_set_hover(e, false)
        widget.w_set_active(e, false)
        widget.w_set_focus(e, false)
        i = i + 1
    }
    (*s).hot = NOBODY
    (*s).press = NOBODY
    (*s).focus = NOBODY
    (*s).track = NOBODY
}


// ================================================== MNEMONICS (Alt+letter)
//
// A label "&Save" has the mnemonic S: Alt+S activates it (a button, a
// checkbox, a radio, a tab) or -- on a plain label -- moves the focus to the
// next control in tab order (the Windows rule: "&Name:" in front of a field).
// "&&" is a literal '&'. When several controls share a letter, Alt+letter
// only MOVES the focus (round robin, in tab order) and the user confirms with
// Space/Enter -- like Windows; a unique letter acts at once.
//
// OPT-IN: a panel looks at '&' only after `panel_set_mnemonics(s, true)`; a
// program with literal ampersands in its texts is not changed behind its back.
// The underline is drawn by the renderer from `mn_index` (clean-text index).
const MN_NONE: usize = 18446744073709551615

fn panel_set_mnemonics(s: *mut Panel, on: bool) {
    if on { (*s).mn = 1 as u32 } else { (*s).mn = 0 as u32 }
}

fn panel_mnemonics(s: *mut Panel) -> bool { return (*s).mn != 0 as u32 }

fn mn_up(b: u32) -> u32 {
    if b >= 97 as u32 && b <= 122 as u32 { return b - (32 as u32) }
    return b
}

// The mnemonic letter (upper-case ASCII; other bytes as they are) of the
// text at `p`/`n`, 0 for none. "&&" is skipped, a trailing '&' is no marker.
fn mn_letter(p: u64, n: usize) -> u32 {
    var i: usize = 0
    while i + 1 < n {
        let b: u8 = *((p + i as u64) as *mut u8)
        if b == (38 as u8) {
            let c: u8 = *((p + (i + 1) as u64) as *mut u8)
            if c == (38 as u8) {
                i = i + 2
            } else {
                return mn_up(c as u32)
            }
        } else {
            i = i + 1
        }
    }
    return 0 as u32
}

// Byte index of the marked letter in the CLEAN text (markers removed), or
// MN_NONE: that is where the renderer draws the underline.
fn mn_index(p: u64, n: usize) -> usize {
    var i: usize = 0
    var out: usize = 0
    while i < n {
        let b: u8 = *((p + i as u64) as *mut u8)
        if b == (38 as u8) && i + 1 < n {
            let c: u8 = *((p + (i + 1) as u64) as *mut u8)
            if c == (38 as u8) {
                out = out + 1
                i = i + 2
            } else {
                return out
            }
        } else {
            out = out + 1
            i = i + 1
        }
    }
    return MN_NONE
}

// The text without markers into `dst` (cap bytes); returns its length.
fn mn_clean(p: u64, n: usize, dst: *mut u8, cap: usize) -> usize {
    var i: usize = 0
    var out: usize = 0
    while i < n {
        let b: u8 = *((p + i as u64) as *mut u8)
        if b == (38 as u8) && i + 1 < n {
            let c: u8 = *((p + (i + 1) as u64) as *mut u8)
            if c == (38 as u8) {
                if out < cap { *((dst as u64 + out as u64) as *mut u8) = b }
                out = out + 1
                i = i + 2
            } else {
                i = i + 1
            }
        } else {
            if out < cap { *((dst as u64 + out as u64) as *mut u8) = b }
            out = out + 1
            i = i + 1
        }
    }
    if out > cap { return cap }
    return out
}

// Tell the panel that widget `w` has the mnemonic `letter` at clean-text byte
// `idx` (the text itself carries no '&'). A second bind of `w` replaces the first.
// false when the table (48) is full.
fn panel_mn_bind(s: *mut Panel, w: usize, letter: u32, idx: usize) -> bool {
    var i: usize = 0
    while i < (*s).nmn {
        if (*s).mnw[i] == w {
            (*s).mnl[i] = mn_up(letter)
            (*s).mni[i] = idx
            return true
        }
        i = i + 1
    }
    if (*s).nmn >= 48 { return false }
    (*s).mnw[(*s).nmn] = w
    (*s).mnl[(*s).nmn] = mn_up(letter)
    (*s).mni[(*s).nmn] = idx
    (*s).nmn = (*s).nmn + 1
    return true
}

fn panel_mn_clear(s: *mut Panel) { (*s).nmn = 0 }

fn bound_slot(s: *mut Panel, w: usize) -> usize {
    var i: usize = 0
    while i < (*s).nmn {
        if (*s).mnw[i] == w { return i }
        i = i + 1
    }
    return MN_NONE
}

// The mnemonic letter of widget `w`: a bound one, else (only when the panel
// is in '&' mode) the one marked in its text. 0 = none.
fn mn_of(s: *mut Panel, w: usize) -> u32 {
    let b: usize = bound_slot(s, w)
    if b != MN_NONE { return (*s).mnl[b] }
    if (*s).mn == 0 as u32 { return 0 as u32 }
    let e: *mut widget.Widget = panel_widget(s, w)
    return mn_letter(widget.w_text(e), widget.w_text_len(e))
}

// The mnemonic letter of widget `w` (upper-case), 0 for none (AT-SPI GetKeyBinding asks).
fn panel_mn_letter(s: *mut Panel, w: usize) -> u32 {
    if w >= (*s).n { return 0 as u32 }
    return mn_of(s, w)
}

// Where the underline goes in the shown text of `w`, MN_NONE for no mnemonic.
fn panel_mn_index(s: *mut Panel, w: usize) -> usize {
    let b: usize = bound_slot(s, w)
    if b != MN_NONE { return (*s).mni[b] }
    if (*s).mn == 0 as u32 { return MN_NONE }
    let e: *mut widget.Widget = panel_widget(s, w)
    return mn_index(widget.w_text(e), widget.w_text_len(e))
}

fn mn_takes(e: *mut widget.Widget) -> bool {
    if widget.w_is_disabled(e) { return false }
    let k: u32 = widget.w_kind(e)
    return k == widget.KIND_BUTTON || k == widget.KIND_CHECKBOX
    || k == widget.KIND_RADIO || k == widget.KIND_TOGGLE
    || k == widget.KIND_TAB || k == widget.KIND_LABEL
}

// Widget numbers in tab order (the lent order, else the array).
fn walk_len(s: *mut Panel) -> usize {
    if (*s).ord != 0 && (*s).nord > 0 { return (*s).nord }
    return (*s).n
}

fn walk_at(s: *mut Panel, k: usize) -> usize {
    if (*s).ord != 0 && (*s).nord > 0 { return order_at(s, k) }
    return k
}

// How many controls answer to this letter (case-insensitive).
fn panel_mnemonic_count(s: *mut Panel, cp: u32) -> usize {
    if (*s).mn == 0 as u32 && (*s).nmn == 0 { return 0 }
    let want: u32 = mn_up(cp)
    var c: usize = 0
    var k: usize = 0
    while k < walk_len(s) {
        let w: usize = walk_at(s, k)
        if w < (*s).n {
            let e: *mut widget.Widget = panel_widget(s, w)
            if mn_takes(e) && mn_of(s, w) == want {
                c = c + 1
            }
        }
        k = k + 1
    }
    return c
}

// The k-th control (tab order) with this letter, MN_NONE for none.
fn panel_mnemonic_widget(s: *mut Panel, cp: u32, nth: usize) -> usize {
    if (*s).mn == 0 as u32 && (*s).nmn == 0 { return MN_NONE }
    let want: u32 = mn_up(cp)
    var c: usize = 0
    var k: usize = 0
    while k < walk_len(s) {
        let w: usize = walk_at(s, k)
        if w < (*s).n {
            let e: *mut widget.Widget = panel_widget(s, w)
            if mn_takes(e) && mn_of(s, w) == want {
                if c == nth { return w }
                c = c + 1
            }
        }
        k = k + 1
    }
    return MN_NONE
}

// Position of widget `w` in the walk, MN_NONE when it is not in it.
fn walk_pos(s: *mut Panel, w: usize) -> usize {
    var k: usize = 0
    while k < walk_len(s) {
        if walk_at(s, k) == w { return k }
        k = k + 1
    }
    return MN_NONE
}

// The next focusable widget after walk position `pos` (no wrap).
fn walk_next_focusable(s: *mut Panel, pos: usize) -> usize {
    var k: usize = pos + 1
    while k < walk_len(s) {
        let w: usize = walk_at(s, k)
        if w < (*s).n && can_focus(panel_widget(s, w)) { return w }
        k = k + 1
    }
    return MN_NONE
}

// ALT + LETTER. Returns CH_* bits (CH_NONE when no control has the letter, so
// the caller can try the menu bar / the action registry next).
fn panel_alt_char(s: *mut Panel, cp: u32) -> u32 {
    let total: usize = panel_mnemonic_count(s, cp)
    if total == 0 { return CH_NONE }
    // the first match AFTER the focus in tab order (round robin)
    var pick: usize = panel_mnemonic_widget(s, cp, 0)
    if total > 1 && (*s).focus != NOBODY {
        let fp: usize = walk_pos(s, (*s).focus)
        var j: usize = 0
        while j < total {
            let w: usize = panel_mnemonic_widget(s, cp, j)
            let wp: usize = walk_pos(s, w)
            if fp != MN_NONE && wp != MN_NONE && wp > fp {
                pick = w
                j = total
            } else {
                j = j + 1
            }
        }
    }
    if pick == MN_NONE { return CH_NONE }
    let e: *mut widget.Widget = panel_widget(s, pick)
    if widget.w_kind(e) == widget.KIND_LABEL {
        // "&Name:" in front of a field: the focus goes to what follows
        let nx: usize = walk_next_focusable(s, walk_pos(s, pick))
        if nx == MN_NONE { return CH_NONE }
        return panel_set_focus(s, nx) | CH_REPAINT
    }
    let ch: u32 = panel_set_focus(s, pick) | CH_REPAINT
    if total > 1 { return ch }
    return ch | activate_focused(s)
}
