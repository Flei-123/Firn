// SPDX-License-Identifier: MPL-2.0
export { Extras, extras_blank, extras_pan, extras_back, extras_pointers }

struct Extras {
    pan: fn(u64, f64, f64, f64) -> bool,
    pan_on: bool,
    back_wanted: fn(u64) -> bool,
    back_go: fn(u64),
    back_on: bool,
    ptr: fn(u64, u32, u32, u32, f64, f64, f64) -> bool,
    ptr_on: bool,
}

fn no_pan(ud: u64, x: f64, y: f64, dy: f64) -> bool { return false }
fn no_wanted(ud: u64) -> bool { return false }
fn no_go(ud: u64) {}
fn no_ptr(ud: u64, kind: u32, id: u32, ptype: u32, x: f64, y: f64, pressure: f64) -> bool { return false }

fn extras_blank() -> Extras {
    return Extras { pan: no_pan, pan_on: false, back_wanted: no_wanted, back_go: no_go, back_on: false, ptr: no_ptr, ptr_on: false }
}

fn extras_pan(e: Extras, f: fn(u64, f64, f64, f64) -> bool) -> Extras {
    return Extras { pan: f, pan_on: true, back_wanted: e.back_wanted, back_go: e.back_go, back_on: e.back_on, ptr: e.ptr, ptr_on: e.ptr_on }
}

fn extras_back(e: Extras, wanted: fn(u64) -> bool, go: fn(u64)) -> Extras {
    return Extras { pan: e.pan, pan_on: e.pan_on, back_wanted: wanted, back_go: go, back_on: true, ptr: e.ptr, ptr_on: e.ptr_on }
}

fn extras_pointers(e: Extras, f: fn(u64, u32, u32, u32, f64, f64, f64) -> bool) -> Extras {
    return Extras { pan: e.pan, pan_on: e.pan_on, back_wanted: e.back_wanted, back_go: e.back_go, back_on: e.back_on, ptr: f, ptr_on: true }
}
