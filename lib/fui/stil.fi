profile kernel
// SPDX-License-Identifier: GPL-2.0-only
// lib/fui/stil.fi -- WIE EIN ELEMENT AUSSIEHT. EIN TYP FUER ALLE.
//
// ====================================================== WARUM ES SIE GIBT
//
// Justin, 10.09.2026: jedes Element muss frei gestaltbar sein -- "kein
// Hintergrund", "Hintergrund nur bei hover", "Hintergrund rot", oder
// themeabhaengig; dazu Schriftfarbe, -art, -groesse, -schnitt, Rahmen,
// Radius, Innenabstand, Ausrichtung, Deckkraft.
//
// Der Fehler, den das verhindert, ist derselbe wie ueberall in diesem
// Baum: WENN JEDES WIDGET SEINE EIGENEN GESTALTUNGSPARAMETER HAT, gibt
// es am Ende zwanzig Arten, "mach den Hintergrund rot" zu sagen, und
// neunzehn davon kann man nicht kombinieren. Darum EIN Typ -- `Stil` --
// fuer Knopf, Beschriftung, Textfeld, Reiter, Tabelle und alles, was
// noch kommt.
//
// ===================================== WARUM DIESE DATEI IM KERN LIEGT
//
// `profile kernel` in Zeile 1. Ein Stil ist eine reine WERTESTRUKTUR:
// nur Zahlen, kein Zeiger, keine Allokation, kein Systemruf. Damit kann
// der Fenstermanager von OrientOS seine Titelknoepfe mit DEMSELBEN
// Stilsystem malen wie jede Anwendung -- und Justins Forderung, dass
// der Kern das mittraegt, ist ohne Sonderweg erfuellt.
//
// Der Preis steht unten bei `Schrift`: die Schrift wird als NUMMER
// gefuehrt, nicht als geladene Datei. Wer laedt, ist die Schale.
//
// =============================================== EIN FARBWERT, VIER ARTEN
//
// Firn Stufe 0 hat KEIN `enum` (SPEC 14.1). Die vier Arten stehen darum
// in den oberen acht Bit eines `u32` -- eine Farbe braucht nur 24:
//
//     0x00RRGGBB   LITERAL       genau diese Farbe
//     0x01______   TOKEN         eine Rolle aus dem Thema (siehe TK_*)
//     0x02000000   TRANSPARENT   NICHT MALEN
//     0x03000000   ERBEN         nimm, was die Ebene darunter sagt
//
// Keine echte Farbe kollidiert mit einer Art, weil die Art in eigenen
// Bits liegt: 0x000000 (schwarz) ist Art 0 und damit LITERAL, 0xFFFFFF
// ebenso.
//
// WARUM DIE DECKKRAFT NICHT IN DIESEN BITS STEHT: sie ist ein eigenes
// Feld, weil sie getrennt vererbt werden muss. Sonst koennte man nicht
// "erbe die Farbe, aber nimm eigene Deckkraft" sagen.
//
// ================================== "KEIN HINTERGRUND" IST EIN ZUSTAND
//
// Justins Punkt 4, und er hat recht: `TRANSPARENT` heisst NICHT MALEN.
// Es heisst nicht "male die Fensterfarbe drueber". Der Unterschied ist
// unsichtbar auf einer einfarbigen Flaeche und sofort sichtbar ueber
// einem Bild oder einem Verlauf -- und ein Knopf auf einem Hintergrund-
// bild ist genau der Fall, fuer den man das braucht.
//
// ==================================================== DIE VERERBUNG
//
//   1. THEMA          die Marke (lib/fui/marke.fi)
//   2. WIDGET         was ein Knopf von sich aus ist
//   3. AUFRUFER       was der Programmierer setzt
//   4. ZUSTAND        was zusaetzlich fuer hover/druck/... gilt
//
// Aufgeloest wird von 4 nach 1: die erste Ebene, die nicht `ERBEN`
// sagt, gewinnt. Das ist EINE Funktion (`stil_farbe`) und steht einmal
// da, nicht in jedem Widget.

export {
    Stil, stil_neu, stil_leer,
    Ueber, ueber_neu, ueber_leer,
    Satz, satz_neu, satz_stil, satz_ueber, satz_setz_ueber,
    farb_literal, farb_token, farb_transparent, farb_erben,
    farb_art, farb_wert, farb_ist_sichtbar, farb_ist_token,
    ART_LITERAL, ART_TOKEN, ART_TRANSPARENT, ART_ERBEN,
    TK_GRUND, TK_FLAECHE, TK_FLAECHE_HOCH, TK_KNOPF, TK_KNOPF_UEBER,
    TK_KNOPF_DRUCK, TK_FELD, TK_FELD_FOKUS, TK_LINIE, TK_TRENNER,
    TK_TEXT, TK_TEXT_BLASS, TK_TEXT_GESPERRT, TK_TEXT_AUF_AKZENT,
    TK_AKZENT, TK_AUSWAHL, TK_AUSWAHL_TEXT, TK_FEHLER, TK_WARNUNG,
    TK_GUT, TK_ANZAHL,
    ZU_NORMAL, ZU_UEBER, ZU_DRUCK, ZU_FOKUS, ZU_SPERR, ZU_GEWAEHLT,
    ZU_ANZAHL,
    AUS_LINKS, AUS_MITTE, AUS_RECHTS,
    GEW_NORMAL, GEW_FETT, GEW_LEICHT,
    SCHNITT_GERADE, SCHNITT_KURSIV,
    S_HG, S_RAHMEN, S_TEXTFARBE, S_RAHMEN_ST, S_RADIUS, S_PAD_X,
    S_PAD_Y, S_FONT_PX, S_GEWICHT, S_SCHNITT, S_AUSRICHT, S_DECKKRAFT,
    S_FONT_NR,
    stil_setz_hg, stil_setz_rahmen, stil_setz_textfarbe,
    stil_setz_radius, stil_setz_rahmen_st, stil_setz_pad,
    stil_setz_font, stil_setz_gewicht, stil_setz_schnitt,
    stil_setz_ausricht, stil_setz_deckkraft,
    ueber_setz_hg, ueber_setz_rahmen, ueber_setz_textfarbe,
    ueber_setz_deckkraft,
    loese_hg, loese_rahmen, loese_textfarbe, loese_deckkraft,
    loese_zahl,
}

// ======================================================= DIE FARBARTEN
const ART_LITERAL: u32 = 0
const ART_TOKEN: u32 = 1
const ART_TRANSPARENT: u32 = 2
const ART_ERBEN: u32 = 3

// Genau diese Farbe: `farb_literal(0xFF0000)` = rot.
fn farb_literal(rgb: u32) -> u32 {
    return rgb & 16777215 as u32
}

// Eine Rolle aus dem Thema. Zieht bei einem Themenwechsel VON SELBST
// mit -- das ist Justins Punkt 3: die Widgets werden nicht neu gebaut,
// weil in ihnen gar keine Farbe steht, sondern eine Nummer.
fn farb_token(tk: u32) -> u32 {
    return (ART_TOKEN << 24) | (tk & 16777215 as u32)
}

// NICHT MALEN. Kein Ersatzanstrich in Fensterfarbe.
fn farb_transparent() -> u32 {
    return ART_TRANSPARENT << 24
}

// Nimm, was die Ebene darunter sagt. Das ist der Vorgabewert JEDES
// Feldes -- ein frisch angelegter Stil aendert nichts.
fn farb_erben() -> u32 {
    return ART_ERBEN << 24
}

fn farb_art(f: u32) -> u32 {
    return (f >> 24) & 255 as u32
}

fn farb_wert(f: u32) -> u32 {
    return f & 16777215 as u32
}

fn farb_ist_sichtbar(f: u32) -> bool {
    let a: u32 = farb_art(f)
    return a == ART_LITERAL || a == ART_TOKEN
}

fn farb_ist_token(f: u32) -> bool {
    return farb_art(f) == ART_TOKEN
}

// ========================================================= DIE TOKEN
//
// Die Rollen des Themas, als Nummern. Sie stehen HIER und nicht in
// marke.fi, weil diese Datei im Kern liegt und marke.fi nicht: der
// Fenstermanager kennt die Nummern, und die Schale bildet sie auf die
// Farben ab (`marke.farbe_von_token`). Damit haengt der Kern an keiner
// Farbtafel.
//
// Die Reihenfolge ist die von `marke.Farben` -- wer dort eine Rolle
// ergaenzt, ergaenzt sie hier an derselben Stelle.
const TK_GRUND: u32 = 0
const TK_FLAECHE: u32 = 1
const TK_FLAECHE_HOCH: u32 = 2
const TK_KNOPF: u32 = 3
const TK_KNOPF_UEBER: u32 = 4
const TK_KNOPF_DRUCK: u32 = 5
const TK_FELD: u32 = 6
const TK_FELD_FOKUS: u32 = 7
const TK_LINIE: u32 = 8
const TK_TRENNER: u32 = 9
const TK_TEXT: u32 = 10
const TK_TEXT_BLASS: u32 = 11
const TK_TEXT_GESPERRT: u32 = 12
const TK_TEXT_AUF_AKZENT: u32 = 13
const TK_AKZENT: u32 = 14
const TK_AUSWAHL: u32 = 15
const TK_AUSWAHL_TEXT: u32 = 16
const TK_FEHLER: u32 = 17
const TK_WARNUNG: u32 = 18
const TK_GUT: u32 = 19
const TK_ANZAHL: u32 = 20

// ======================================================= DIE ZUSTAENDE
//
// Die sechs, die Justin nennt. `ZU_GEWAEHLT` ist neu gegenueber
// marke.fi und gehoert dazu: ein Reiter, eine Listenzeile und ein
// Umschaltknopf sind ausgewaehlt, ohne fokussiert zu sein.
const ZU_NORMAL: u32 = 0
const ZU_UEBER: u32 = 1
const ZU_DRUCK: u32 = 2
const ZU_FOKUS: u32 = 3
const ZU_SPERR: u32 = 4
const ZU_GEWAEHLT: u32 = 5
const ZU_ANZAHL: usize = 6

// ==================================================== AUSRICHTUNG USW.
const AUS_LINKS: u32 = 0
const AUS_MITTE: u32 = 1
const AUS_RECHTS: u32 = 2

const GEW_LEICHT: u32 = 300
const GEW_NORMAL: u32 = 400
const GEW_FETT: u32 = 700

const SCHNITT_GERADE: u32 = 0
const SCHNITT_KURSIV: u32 = 1

// ================================================== WELCHES FELD GESETZT
//
// Die Zahlenfelder (Radius, Innenabstand, Schriftgroesse) koennen nicht
// wie Farben ein `ERBEN` in sich tragen -- 0 ist ein gueltiger Radius.
// Darum eine Bitmaske: steht das Bit, gilt der Wert; steht es nicht,
// wird geerbt.
const S_HG: u32 = 1
const S_RAHMEN: u32 = 2
const S_TEXTFARBE: u32 = 4
const S_RAHMEN_ST: u32 = 8
const S_RADIUS: u32 = 16
const S_PAD_X: u32 = 32
const S_PAD_Y: u32 = 64
const S_FONT_PX: u32 = 128
const S_GEWICHT: u32 = 256
const S_SCHNITT: u32 = 512
const S_AUSRICHT: u32 = 1024
const S_DECKKRAFT: u32 = 2048
const S_FONT_NR: u32 = 4096

// ============================================================ DER STIL
//
// Eine reine Wertestruktur, 32 Oktett. Kopierbar, kein Zeiger, keine
// Allokation -- im Kernprofil uebergebbar.
//
// DIE SCHRIFT ALS NUMMER, und warum: eine Schriftdatei laden heisst
// lesen und Speicher anfordern, und beides gibt es im Kern nicht. Der
// Stil traegt darum `font_nr` -- 0 heisst "die Schrift des Themas",
// alles andere ist ein Platz in der Schriftliste der Schale
// (`zeichnen.zeichner_schrift_bei`). Der Kern reicht die Nummer durch
// und malt keinen Text; die Schale schlaegt sie nach. Damit kollidiert
// das Schriftladen NICHT mit dem Kernprofil, und es ist auch nicht
// still vereinfacht: der Kern kann Text schlicht nicht, und das steht
// in K1 von lib/fui/kern.fi.
struct Stil {
    hg: u32,          // Hintergrund (Farbwert)
    rahmen: u32,      // Rahmenfarbe (Farbwert)
    textfarbe: u32,   // Schriftfarbe (Farbwert)
    rahmen_st: u16,   // Rahmenstaerke in Entwurfspunkten
    radius: u16,      // Eckradius in Entwurfspunkten
    pad_x: u16,       // Innenabstand waagerecht
    pad_y: u16,       // Innenabstand senkrecht
    font_px: u16,     // Schriftgroesse in Entwurfspunkten
    gewicht: u16,     // 300 / 400 / 700
    schnitt: u16,     // gerade / kursiv
    font_nr: u16,     // 0 = die Schrift des Themas
    ausricht: u8,     // links / mittig / rechts
    deckkraft: u8,    // 0..255
    gesetzt: u32,     // Bitmaske S_*
}

// Ein Stil, der NICHTS aendert: jedes Feld erbt. Das ist der
// Vorgabewert -- wer nichts sagt, bekommt das Thema.
fn stil_neu() -> Stil {
    return Stil {
        hg: farb_erben(), rahmen: farb_erben(), textfarbe: farb_erben(),
        rahmen_st: 0, radius: 0, pad_x: 0, pad_y: 0, font_px: 0,
        gewicht: 0, schnitt: 0, font_nr: 0,
        ausricht: 0, deckkraft: 255, gesetzt: 0,
    }
}

fn stil_leer() -> Stil {
    return stil_neu()
}

// ---- die Setzer. Sie geben den Stil ZURUECK, damit man sie
// hintereinanderhaengen kann, ohne dass Firn Stufe 0 Methoden braucht.
fn stil_setz_hg(s: Stil, f: u32) -> Stil {
    var o: Stil = s
    o.hg = f
    o.gesetzt = o.gesetzt | S_HG
    return o
}

fn stil_setz_rahmen(s: Stil, f: u32, staerke: usize) -> Stil {
    var o: Stil = s
    o.rahmen = f
    o.rahmen_st = staerke as u16
    o.gesetzt = o.gesetzt | S_RAHMEN | S_RAHMEN_ST
    return o
}

fn stil_setz_textfarbe(s: Stil, f: u32) -> Stil {
    var o: Stil = s
    o.textfarbe = f
    o.gesetzt = o.gesetzt | S_TEXTFARBE
    return o
}

fn stil_setz_radius(s: Stil, r: usize) -> Stil {
    var o: Stil = s
    o.radius = r as u16
    o.gesetzt = o.gesetzt | S_RADIUS
    return o
}

fn stil_setz_rahmen_st(s: Stil, st: usize) -> Stil {
    var o: Stil = s
    o.rahmen_st = st as u16
    o.gesetzt = o.gesetzt | S_RAHMEN_ST
    return o
}

fn stil_setz_pad(s: Stil, x: usize, y: usize) -> Stil {
    var o: Stil = s
    o.pad_x = x as u16
    o.pad_y = y as u16
    o.gesetzt = o.gesetzt | S_PAD_X | S_PAD_Y
    return o
}

// `nr` 0 = die Schrift des Themas.
fn stil_setz_font(s: Stil, nr: usize, px: usize) -> Stil {
    var o: Stil = s
    o.font_nr = nr as u16
    o.font_px = px as u16
    o.gesetzt = o.gesetzt | S_FONT_NR | S_FONT_PX
    return o
}

fn stil_setz_gewicht(s: Stil, g: u32) -> Stil {
    var o: Stil = s
    o.gewicht = g as u16
    o.gesetzt = o.gesetzt | S_GEWICHT
    return o
}

fn stil_setz_schnitt(s: Stil, k: u32) -> Stil {
    var o: Stil = s
    o.schnitt = k as u16
    o.gesetzt = o.gesetzt | S_SCHNITT
    return o
}

fn stil_setz_ausricht(s: Stil, a: u32) -> Stil {
    var o: Stil = s
    o.ausricht = a as u8
    o.gesetzt = o.gesetzt | S_AUSRICHT
    return o
}

fn stil_setz_deckkraft(s: Stil, d: usize) -> Stil {
    var o: Stil = s
    var v: usize = d
    if v > 255 {
        v = 255
    }
    o.deckkraft = v as u8
    o.gesetzt = o.gesetzt | S_DECKKRAFT
    return o
}

// ================================================ DER ZUSTANDS-AUFSATZ
//
// DUENN, und das mit Absicht. Ein Zustand ueberschreibt in der Praxis
// fast nie alles -- meist nur die Hintergrundfarbe ("Hintergrund nur
// bei hover"). Ein voller `Stil` je Zustand waere 6 x 32 = 192 Oktett
// je Element; so sind es 32 + 5 x 16 = 112, und bei einem Element ohne
// Zustandsabweichung nur 32.
//
// Das zaehlt, weil im Kernprofil alles auf dem Stapel liegt: eine
// Werkzeugleiste mit 20 Knoepfen ist damit 2240 statt 3840 Oktett.
struct Ueber {
    hg: u32,
    rahmen: u32,
    textfarbe: u32,
    deckkraft: u8,
    gesetzt: u8,
}

fn ueber_neu() -> Ueber {
    return Ueber { hg: farb_erben(), rahmen: farb_erben(),
        textfarbe: farb_erben(), deckkraft: 255, gesetzt: 0 }
}

fn ueber_leer() -> Ueber {
    return ueber_neu()
}

fn ueber_setz_hg(u: Ueber, f: u32) -> Ueber {
    var o: Ueber = u
    o.hg = f
    o.gesetzt = o.gesetzt | 1 as u8
    return o
}

fn ueber_setz_rahmen(u: Ueber, f: u32) -> Ueber {
    var o: Ueber = u
    o.rahmen = f
    o.gesetzt = o.gesetzt | 2 as u8
    return o
}

fn ueber_setz_textfarbe(u: Ueber, f: u32) -> Ueber {
    var o: Ueber = u
    o.textfarbe = f
    o.gesetzt = o.gesetzt | 4 as u8
    return o
}

fn ueber_setz_deckkraft(u: Ueber, d: usize) -> Ueber {
    var o: Ueber = u
    var v: usize = d
    if v > 255 {
        v = 255
    }
    o.deckkraft = v as u8
    o.gesetzt = o.gesetzt | 8 as u8
    return o
}

// ============================================================ DER SATZ
//
// Grundstil plus die fuenf Zustandsaufsaetze. Das ist, was ein Element
// bekommt.
//
// `ZU_NORMAL` hat keinen eigenen Aufsatz -- dafuer IST der Grundstil da.
struct Satz {
    s: Stil,
    u: [Ueber; 5],   // UEBER, DRUCK, FOKUS, SPERR, GEWAEHLT
}

fn satz_neu() -> Satz {
    return Satz { s: stil_neu(), u: [ueber_neu(); 5] }
}

fn satz_stil(z: *mut Satz) -> *mut Stil {
    return &(*z).s
}

fn satz_ueber(z: *mut Satz, zustand: u32) -> *mut Ueber {
    var i: usize = 0
    if zustand >= 1 as u32 && zustand <= 5 as u32 {
        i = (zustand as usize) - 1
    }
    return &(*z).u[i]
}

fn satz_setz_ueber(z: *mut Satz, zustand: u32, u: Ueber) {
    if zustand >= 1 as u32 && zustand <= 5 as u32 {
        (*z).u[(zustand as usize) - 1] = u
    }
}

// ====================================================== DIE AUFLOESUNG
//
// Von oben nach unten: Zustand, Aufrufer, Widget-Vorgabe. Die erste
// Ebene, die nicht `ERBEN` sagt, gewinnt. Das ist Justins Punkt 1 und 2
// in einer Funktion.
//
// `wid` ist die Vorgabe des Widgets -- ein Knopf reicht dort
// `farb_token(TK_KNOPF)` herein, eine Beschriftung
// `farb_transparent()`. Damit steht "eine Beschriftung hat von Haus aus
// keinen Hintergrund" an EINER Stelle im Knopfcode und nicht als Regel
// im Kopf des Programmierers.
fn loese_farbe(zustand_f: u32, zustand_hat: bool, eigen_f: u32,
    eigen_hat: bool, wid: u32) -> u32 {
    if zustand_hat && farb_art(zustand_f) != ART_ERBEN {
        return zustand_f
    }
    if eigen_hat && farb_art(eigen_f) != ART_ERBEN {
        return eigen_f
    }
    return wid
}

fn loese_hg(z: *mut Satz, zustand: u32, wid: u32) -> u32 {
    let s: *mut Stil = &(*z).s
    if zustand == ZU_NORMAL {
        return loese_farbe(farb_erben(), false, (*s).hg,
            ((*s).gesetzt & S_HG) != 0 as u32, wid)
    }
    let u: *mut Ueber = satz_ueber(z, zustand)
    return loese_farbe((*u).hg, ((*u).gesetzt & 1 as u8) != 0 as u8,
        (*s).hg, ((*s).gesetzt & S_HG) != 0 as u32, wid)
}

fn loese_rahmen(z: *mut Satz, zustand: u32, wid: u32) -> u32 {
    let s: *mut Stil = &(*z).s
    if zustand == ZU_NORMAL {
        return loese_farbe(farb_erben(), false, (*s).rahmen,
            ((*s).gesetzt & S_RAHMEN) != 0 as u32, wid)
    }
    let u: *mut Ueber = satz_ueber(z, zustand)
    return loese_farbe((*u).rahmen, ((*u).gesetzt & 2 as u8) != 0 as u8,
        (*s).rahmen, ((*s).gesetzt & S_RAHMEN) != 0 as u32, wid)
}

fn loese_textfarbe(z: *mut Satz, zustand: u32, wid: u32) -> u32 {
    let s: *mut Stil = &(*z).s
    if zustand == ZU_NORMAL {
        return loese_farbe(farb_erben(), false, (*s).textfarbe,
            ((*s).gesetzt & S_TEXTFARBE) != 0 as u32, wid)
    }
    let u: *mut Ueber = satz_ueber(z, zustand)
    return loese_farbe((*u).textfarbe,
        ((*u).gesetzt & 4 as u8) != 0 as u8,
        (*s).textfarbe, ((*s).gesetzt & S_TEXTFARBE) != 0 as u32, wid)
}

fn loese_deckkraft(z: *mut Satz, zustand: u32) -> usize {
    let s: *mut Stil = &(*z).s
    if zustand != ZU_NORMAL {
        let u: *mut Ueber = satz_ueber(z, zustand)
        if ((*u).gesetzt & 8 as u8) != 0 as u8 {
            return (*u).deckkraft as usize
        }
    }
    if ((*s).gesetzt & S_DECKKRAFT) != 0 as u32 {
        return (*s).deckkraft as usize
    }
    return 255
}

// Ein Zahlenfeld aufloesen. `bit` ist das S_*, `wert` der Wert im Stil,
// `wid` die Vorgabe des Widgets.
fn loese_zahl(z: *mut Satz, bit: u32, wert: usize, wid: usize) -> usize {
    let s: *mut Stil = &(*z).s
    if ((*s).gesetzt & bit) != 0 as u32 {
        return wert
    }
    return wid
}
