// SPDX-License-Identifier: MPL-2.0
export { set_area, in_area, active, x0, y0, axis, last_dy, velocity, touch, begin, move_to, end_at, swipe_dir, cancel, AXIS_NONE, AXIS_V, AXIS_H, END_TAP, END_FLING, END_SWIPE }

const AXIS_NONE: u8 = 0
const AXIS_V: u8 = 1
const AXIS_H: u8 = 2

const END_TAP: u8 = 0
const END_FLING: u8 = 1
const END_SWIPE: u8 = 2

const SLOP: f64 = 8.0
const SWIPE_MIN: f64 = 56.0

static mut G_ACTIVE: bool = false
static mut G_TOUCH: bool = false
static mut G_AXIS: u8 = 0
static mut G_X0: f64 = 0.0
static mut G_Y0: f64 = 0.0
static mut G_LX: f64 = 0.0
static mut G_LY: f64 = 0.0
static mut G_LT: f64 = 0.0
static mut G_VY: f64 = 0.0
static mut G_DY: f64 = 0.0
static mut G_AX: f64 = 0.0
static mut G_AY: f64 = 0.0
static mut G_AW: f64 = 0.0
static mut G_AH: f64 = 0.0
static mut G_HSWIPE: bool = false

fn set_area(x: f64, y: f64, w: f64, h: f64, hswipe: bool) {
    G_AX = x
    G_AY = y
    G_AW = w
    G_AH = h
    G_HSWIPE = hswipe
}

fn in_area(x: f64, y: f64) -> bool {
    return x >= G_AX && x < G_AX + G_AW && y >= G_AY && y < G_AY + G_AH
}

fn active() -> bool {
    return G_ACTIVE
}

fn x0() -> f64 {
    return G_X0
}

fn y0() -> f64 {
    return G_Y0
}

fn axis() -> u8 {
    return G_AXIS
}

fn last_dy() -> f64 {
    return G_DY
}

fn velocity() -> f64 {
    return G_VY
}

fn touch() -> bool {
    return G_TOUCH
}

fn begin(x: f64, y: f64, touch: bool, ms: f64) {
    G_ACTIVE = true
    G_TOUCH = touch
    G_AXIS = AXIS_NONE
    G_X0 = x
    G_Y0 = y
    G_LX = x
    G_LY = y
    G_LT = ms
    G_VY = 0.0
    G_DY = 0.0
}

fn abs(v: f64) -> f64 {
    if v < 0.0 {
        return 0.0 - v
    }
    return v
}

fn move_to(x: f64, y: f64, ms: f64) -> u8 {
    if !G_ACTIVE || !G_TOUCH {
        return AXIS_NONE
    }
    if G_AXIS == AXIS_NONE {
        let ax: f64 = abs(x - G_X0)
        let ay: f64 = abs(y - G_Y0)
        if ay > SLOP && ay >= ax {
            G_AXIS = AXIS_V
            G_LY = y
        } else if G_HSWIPE && ax > SLOP && ax > ay {
            G_AXIS = AXIS_H
        } else {
            return AXIS_NONE
        }
    }
    if G_AXIS == AXIS_V {
        G_DY = G_LY - y
        var dt: f64 = ms - G_LT
        if dt < 1.0 {
            dt = 1.0
        }
        G_VY = G_VY * 0.4 + (G_DY / dt) * 0.6
        G_LY = y
        G_LT = ms
    }
    G_LX = x
    return G_AXIS
}

fn end_at(ms: f64) -> u8 {
    let was: bool = G_ACTIVE
    G_ACTIVE = false
    if !was {
        return END_TAP
    }
    if G_AXIS == AXIS_V {
        if ms - G_LT > 90.0 {
            G_VY = 0.0
        }
        return END_FLING
    }
    if G_AXIS == AXIS_H && abs(G_LX - G_X0) >= SWIPE_MIN {
        return END_SWIPE
    }
    if G_AXIS == AXIS_H {
        return END_FLING
    }
    return END_TAP
}

fn swipe_dir() -> i64 {
    if G_LX < G_X0 {
        return 1
    }
    return 0 - 1
}

fn cancel() {
    G_ACTIVE = false
    G_AXIS = AXIS_NONE
}
