// SPDX-License-Identifier: MPL-2.0
import std.rt
import fui.combofilter
import fui.ds_fbtext
import fui.ds_fbtok
import fui.ds_icons
import fui.ds_icons_names
import fui.editor
import fui.kit
import fui.kitform
import fui.kitpopup
import fui.painter
import fui.render
import fui.screenax
import fui.style
import fui.widget

export {
    Combo, NONE, combo_new, set_items, set_rows, place, layout, draw, end, press, key, text, wheel, focus, blur,
    is_open, value, set_value, revision, text_of, item_count, item_label, result_count, result_item, active_row, top_row,
    visible_rows, flipped, panel_rect, row_rect, announce_text, announce_rev, query_of, open_list, close_list,
}

const NONE: i64 = -1
const MAX_ITEMS: usize = 512
const POOL_CAP: usize = 8192
const RESULT_CAP: usize = 256
const ROWS_MAX: i64 = 8

struct Combo {
    fld: *mut kit.Search,
    st: combofilter.ComboState,
    pool: u64,
    pool_n: usize,
    offs: u64,
    n_items: usize,
    idx: u64,
    nres: usize,
    value: i64,
    rows_max: i64,
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    win_h: f64,
    px: f64,
    py: f64,
    ctx: u64,
    foc: bool,
    sig: u64,
    rev: u64,
    ann: [u8; 40],
    ann_n: usize,
    ann_rev: u64,
    now: u64,
    flip: bool,
    prows: i64,
    vb: [f64; 4],
}

fn rd32(p: u64, i: usize) -> usize { return (*((p + (i * 4) as u64) as *mut u32)) as usize }
fn wr32(p: u64, i: usize, v: usize) { *((p + (i * 4) as u64) as *mut u32) = v as u32 }

fn combo_new() -> *mut Combo {
    let cb: *mut Combo = rt.heap_alloc(1 << 12) as *mut Combo
    (*cb).fld = kitform.field_new()
    (*cb).st = combofilter.state_new(ROWS_MAX)
    (*cb).pool = rt.heap_alloc(POOL_CAP)
    (*cb).pool_n = 0
    (*cb).offs = rt.heap_alloc((MAX_ITEMS + 1) * 4)
    wr32((*cb).offs, 0, 0)
    (*cb).n_items = 0
    (*cb).idx = rt.heap_alloc(RESULT_CAP * 4)
    (*cb).nres = 0
    (*cb).value = NONE
    (*cb).rows_max = ROWS_MAX
    (*cb).x = 0.0
    (*cb).y = 0.0
    (*cb).w = 0.0
    (*cb).h = 0.0
    (*cb).win_h = 0.0
    (*cb).px = 0.0 - 1.0
    (*cb).py = 0.0 - 1.0
    (*cb).ctx = 0
    (*cb).foc = false
    (*cb).sig = 0
    (*cb).rev = 0
    (*cb).ann_n = 0
    (*cb).ann_rev = 0
    (*cb).now = 0
    (*cb).flip = false
    (*cb).prows = 0
    var i: usize = 0
    while i < 4 { (*cb).vb[i] = 0.0; i = i + 1 }
    return cb
}

fn set_items(cb: *mut Combo, list: str) {
    var n: usize = 0
    var pn: usize = 0
    wr32((*cb).offs, 0, 0)
    var i: usize = 0
    while list.n > 0 && i <= list.n && n < MAX_ITEMS {
        if i == list.n || rt.ld8(list.p as u64, i) == 124 as u8 {
            wr32((*cb).offs, n + 1, pn)
            n = n + 1
        } else if pn < POOL_CAP {
            rt.st8((*cb).pool, pn, rt.ld8(list.p as u64, i))
            pn = pn + 1
        }
        i = i + 1
    }
    (*cb).pool_n = pn
    (*cb).n_items = n
    (*cb).value = NONE
    (*cb).nres = 0
    kit.search_clear((*cb).fld)
    (*cb).sig = sig_of(text_of(cb))
    combofilter.close(&(*cb).st)
}

fn set_rows(cb: *mut Combo, rows: i64) {
    var r: i64 = rows
    if r < 1 { r = 1 }
    (*cb).rows_max = r
}

fn item_count(cb: *mut Combo) -> usize { return (*cb).n_items }

fn item_label(cb: *mut Combo, i: usize) -> str {
    if i >= (*cb).n_items { return "" }
    let a: usize = rd32((*cb).offs, i)
    let b: usize = rd32((*cb).offs, i + 1)
    return str { p: ((*cb).pool + a as u64) as *mut u8, n: b - a }
}

fn text_of(cb: *mut Combo) -> str { return kitform.field_text((*cb).fld) }
fn value(cb: *mut Combo) -> i64 { return (*cb).value }
fn revision(cb: *mut Combo) -> u64 { return (*cb).rev }
fn is_open(cb: *mut Combo) -> bool { return combofilter.is_open(&(*cb).st) }
fn result_count(cb: *mut Combo) -> usize { return (*cb).nres }
fn result_item(cb: *mut Combo, r: usize) -> usize { return rd32((*cb).idx, r) }
fn active_row(cb: *mut Combo) -> i64 { return combofilter.active_row(&(*cb).st) }
fn top_row(cb: *mut Combo) -> i64 { return combofilter.top_row(&(*cb).st) }
fn visible_rows(cb: *mut Combo) -> i64 { return (*cb).prows }
fn flipped(cb: *mut Combo) -> bool { return (*cb).flip }
fn announce_text(cb: *mut Combo) -> str { return str { p: ((&(*cb).ann[0]) as u64) as *mut u8, n: (*cb).ann_n } }
fn announce_rev(cb: *mut Combo) -> u64 { return (*cb).ann_rev }

fn same(a: str, b: str) -> bool {
    return a.n == b.n && rt.mem_eq(a.p as u64, b.p as u64, a.n)
}

fn lower(b: u8) -> u8 {
    if b >= 65 as u8 && b <= 90 as u8 { return b + 32 as u8 }
    return b
}

fn same_ci(a: str, b: str) -> bool {
    if a.n != b.n { return false }
    var i: usize = 0
    while i < a.n {
        if lower(rt.ld8(a.p as u64, i)) != lower(rt.ld8(b.p as u64, i)) { return false }
        i = i + 1
    }
    return true
}

fn sig_of(t: str) -> u64 {
    var h: u64 = 14695981039346656037
    var i: usize = 0
    while i < t.n {
        h = (h ^ (rt.ld8(t.p as u64, i) as u64)) *% 1099511628211
        i = i + 1
    }
    return (h ^ (t.n as u64)) *% 1099511628211
}

fn query_of(cb: *mut Combo) -> str {
    let t: str = text_of(cb)
    if (*cb).value >= 0 && same(t, item_label(cb, (*cb).value as usize)) { return str { p: t.p, n: 0 } }
    return t
}

fn put_str(cb: *mut Combo, at: usize, m: str) -> usize {
    var n: usize = at
    var i: usize = 0
    while i < m.n && n < 40 {
        (*cb).ann[n] = rt.ld8(m.p as u64, i)
        n = n + 1
        i = i + 1
    }
    return n
}

fn announce(cb: *mut Combo) {
    var n: usize = 0
    if (*cb).nres == 0 {
        n = put_str(cb, 0, "No results")
    } else {
        var d: [u8; 24] = [0 as u8; 24]
        let k: usize = kit.fmt_uint((*cb).nres as u64, &d)
        var i: usize = 0
        while i < k {
            (*cb).ann[n] = d[i]
            n = n + 1
            i = i + 1
        }
        if (*cb).nres == 1 { n = put_str(cb, n, " result") } else { n = put_str(cb, n, " results") }
    }
    (*cb).ann_n = n
    (*cb).ann_rev = (*cb).ann_rev + 1
}

fn refilter(cb: *mut Combo) {
    let q: str = query_of(cb)
    let k: usize = combofilter.filter((*cb).pool, (*cb).offs, (*cb).n_items, q.p as u64, q.n as u64, (*cb).idx, RESULT_CAP)
    (*cb).nres = k
    combofilter.set_results(&(*cb).st, k)
    announce(cb)
}

fn open_list(cb: *mut Combo) {
    refilter(cb)
    if (*cb).value >= 0 {
        var r: usize = 0
        while r < (*cb).nres {
            if rd32((*cb).idx, r) == (*cb).value as usize {
                (*cb).st.sel = r as i64
                combofilter.ensure_visible(&(*cb).st)
            }
            r = r + 1
        }
    }
}

fn close_list(cb: *mut Combo) {
    combofilter.close(&(*cb).st)
}

fn focus(cb: *mut Combo, on: bool) {
    (*cb).foc = on
    kit.search_focus((*cb).fld, on)
}

fn blur(cb: *mut Combo) {
    focus(cb, false)
    commit_typed(cb)
    close_list(cb)
}

fn set_value(cb: *mut Combo, i: i64) {
    if i < 0 || i as usize >= (*cb).n_items {
        if (*cb).value != NONE {
            (*cb).value = NONE
            (*cb).rev = (*cb).rev + 1
        }
        return
    }
    kit.search_set_text((*cb).fld, item_label(cb, i as usize))
    (*cb).sig = sig_of(text_of(cb))
    if (*cb).value != i {
        (*cb).value = i
        (*cb).rev = (*cb).rev + 1
    }
}

fn choose(cb: *mut Combo, item: usize) {
    set_value(cb, item as i64)
    close_list(cb)
}

fn commit_typed(cb: *mut Combo) {
    let t: str = text_of(cb)
    if t.n == 0 {
        set_value(cb, NONE)
        return
    }
    var i: usize = 0
    while i < (*cb).n_items {
        if same_ci(t, item_label(cb, i)) {
            set_value(cb, i as i64)
            return
        }
        i = i + 1
    }
    if (*cb).value >= 0 && !same(t, item_label(cb, (*cb).value as usize)) { set_value(cb, NONE) }
}

fn typed(cb: *mut Combo) {
    let t: str = text_of(cb)
    let s: u64 = sig_of(t)
    if s == (*cb).sig { return }
    (*cb).sig = s
    if (*cb).value >= 0 && !same(t, item_label(cb, (*cb).value as usize)) {
        (*cb).value = NONE
        (*cb).rev = (*cb).rev + 1
    }
    refilter(cb)
}

fn place(cb: *mut Combo, x: f64, y: f64, w: f64, h: f64, win_h: f64) {
    (*cb).x = x
    (*cb).y = y
    (*cb).w = w
    (*cb).h = h
    (*cb).win_h = win_h
}

fn layout(cb: *mut Combo, c: *mut render.Ctx) -> bool {
    (*cb).ctx = c as u64
    (*cb).prows = 0
    if !combofilter.is_open(&(*cb).st) || (*cb).nres == 0 { return false }
    let rowh: f64 = kit.ln(c, 34)
    let chrome: f64 = kit.ln(c, 12)
    var rows: i64 = (*cb).nres as i64
    if rows > (*cb).rows_max { rows = (*cb).rows_max }
    let below: f64 = (*cb).win_h - ((*cb).y + (*cb).h) - kit.ln(c, 12)
    let above: f64 = (*cb).y - kit.ln(c, 12)
    let fit_below: i64 = ((below - chrome) / rowh) as i64
    let fit_above: i64 = ((above - chrome) / rowh) as i64
    (*cb).flip = false
    if (*cb).win_h > 0.0 && fit_below < rows {
        if fit_above > fit_below {
            (*cb).flip = true
            if fit_above < rows { rows = fit_above }
        } else {
            rows = fit_below
        }
    }
    if rows < 1 { rows = 1 }
    (*cb).prows = rows
    (*cb).st.rows = rows
    combofilter.ensure_visible(&(*cb).st)
    (*cb).vb[0] = (*cb).x
    (*cb).vb[1] = (*cb).y
    (*cb).vb[2] = (*cb).w
    (*cb).vb[3] = (*cb).h
    if (*cb).flip {
        (*cb).vb[1] = (*cb).y - kit.ln(c, 8) - (rowh * (rows as f64) + kit.ln(c, 8))
        (*cb).vb[3] = 0.0
    }
    return true
}

fn panel_rect(cb: *mut Combo, c: *mut render.Ctx, out: *mut [f64; 4]) {
    kitpopup.item_rect(c, (*cb).vb[0], (*cb).vb[1], (*cb).vb[2], (*cb).vb[3], (*cb).prows as usize, (*cb).prows as usize, out)
}

fn row_rect(cb: *mut Combo, c: *mut render.Ctx, j: usize, out: *mut [f64; 4]) {
    kitpopup.item_rect(c, (*cb).vb[0], (*cb).vb[1], (*cb).vb[2], (*cb).vb[3], (*cb).prows as usize, j, out)
}

fn row_at(cb: *mut Combo, c: *mut render.Ctx, x: f64, y: f64) -> i64 {
    var q: [f64; 4] = [0.0; 4]
    var j: usize = 0
    while (j as i64) < (*cb).prows {
        row_rect(cb, c, j, &q)
        if ds_fbtext.inside(&q, x, y) {
            let r: i64 = combofilter.top_row(&(*cb).st) + j as i64
            if r < (*cb).nres as i64 { return r }
        }
        j = j + 1
    }
    return NONE
}

fn chev_w(c: *mut render.Ctx) -> f64 { return kit.ln(c, 30) }

fn draw(cb: *mut Combo, c: *mut render.Ctx, x: f64, y: f64, w: f64, label: str, hint: str, px: f64, py: f64, win_h: f64) -> f64 {
    let h: f64 = kit.ln(c, 38)
    place(cb, x, y, w, h, win_h)
    (*cb).ctx = c as u64
    (*cb).px = px
    (*cb).py = py
    let fw: f64 = w - chev_w(c)
    kitform.field_box(c, (*cb).fld, x, y, fw, h, hint, false, true)
    var g: i64 = ds_icons.gid(ds_icons_names.CHEVRON_DOWN)
    if combofilter.is_open(&(*cb).st) { g = ds_icons.gid(ds_icons_names.CHEVRON_UP) }
    let gs: f64 = kit.ln(c, 14)
    kit.sym(c, g, x + fw + (chev_w(c) - gs) / 2.0, y + (h - gs) / 2.0, gs, ds_fbtok.muted(c))
    kit.search_ax_note((*cb).fld, label, x, y, fw, h)
    return h
}

fn paint_item(cb: *mut Combo, c: *mut render.Ctx, item: usize, x: f64, y: f64, h: f64, room: f64) {
    let a: usize = rd32((*cb).offs, item)
    let n: usize = rd32((*cb).offs, item + 1) - a
    let q: str = query_of(cb)
    var mask: u64 = 0
    if q.n > 0 { mask = combofilter.highlight((*cb).pool, (*cb).offs, item, q.p as u64, q.n as u64) }
    let size: f64 = kit.ln(c, 13)
    var tx: f64 = x
    var i: usize = 0
    while i < n && tx < x + room {
        let on: bool = bit_on(mask, i)
        var j: usize = i + 1
        while j < n && bit_on(mask, j) == on { j = j + 1 }
        while j < n && j > i && is_cont(rt.ld8((*cb).pool, a + j)) { j = j + 1 }
        let seg: str = str { p: ((*cb).pool + (a + i) as u64) as *mut u8, n: j - i }
        var wt: usize = 400
        var col: u32 = ds_fbtok.text(c)
        if on {
            wt = 700
            col = kit.accent_on(c, style.TOK_SURFACE_RAISED)
        }
        kit.draw_label(c, tx, y, h, size, wt, col, seg, x + room - tx)
        tx = tx + kit.text_width(c, size, wt, seg)
        i = j
    }
}

fn bit_on(mask: u64, i: usize) -> bool {
    if i >= 64 { return false }
    return ((mask >> (i as u64)) & 1) != 0
}

fn is_cont(b: u8) -> bool { return b >= 128 as u8 && b < 192 as u8 }

#[allow_escape]
fn end(cb: *mut Combo, c: *mut render.Ctx) {
    if !layout(cb, c) { return }
    let z: *mut painter.Painter = render.ctx_painter(c)
    var q: [f64; 4] = [0.0; 4]
    panel_rect(cb, c, &q)
    kitpopup.chrome(c, &q)
    let top: i64 = combofilter.top_row(&(*cb).st)
    let act: i64 = combofilter.active_row(&(*cb).st)
    var j: usize = 0
    while (j as i64) < (*cb).prows {
        let r: i64 = top + j as i64
        j = j + 1
        if r >= (*cb).nres as i64 { break }
        var rr: [f64; 4] = [0.0; 4]
        row_rect(cb, c, j - 1, &rr)
        let item: usize = rd32((*cb).idx, r as usize)
        let hov: bool = ds_fbtext.inside(&rr, (*cb).px, (*cb).py)
        if r == act || hov { painter.round_rect(z, rr[0], rr[1], rr[2], rr[3], kit.ln(c, 6), ds_fbtok.hover_fill(c)) }
        paint_item(cb, c, item, rr[0] + kit.ln(c, 10), rr[1], rr[3], rr[2] - kit.ln(c, 40))
        if (*cb).value == item as i64 {
            kit.sym(c, ds_icons.gid(ds_icons_names.CHECKMARK), rr[0] + rr[2] - kit.ln(c, 28), rr[1] + (rr[3] - kit.ln(c, 16)) / 2.0, kit.ln(c, 16), kit.accent_gfx(c, style.TOK_SURFACE_RAISED))
        }
        var st: u32 = 0 as u32
        if r == act { st = screenax.F_SELECTED }
        if (*cb).value == item as i64 { st = st | screenax.F_CHECKED }
        screenax.note(widget.KIND_LIST, st, item_label(cb, item), rr[0], rr[1], rr[2], rr[3], 0)
    }
    if (*cb).nres as i64 > (*cb).prows {
        let total: f64 = (*cb).nres as f64
        let tr_h: f64 = q[3] - kit.ln(c, 16)
        let th: f64 = tr_h * ((*cb).prows as f64) / total
        let ty: f64 = q[1] + kit.ln(c, 8) + tr_h * (top as f64) / total
        painter.round_rect(z, q[0] + q[2] - kit.ln(c, 7), ty, kit.ln(c, 3), th, kit.ln(c, 2), kit.with_alpha(ds_fbtok.muted(c), 140 as u32))
    }
}

fn inside_box(cb: *mut Combo, x: f64, y: f64) -> bool {
    return x >= (*cb).x && x < (*cb).x + (*cb).w && y >= (*cb).y && y < (*cb).y + (*cb).h
}

fn press(cb: *mut Combo, x: f64, y: f64) -> bool {
    let c: *mut render.Ctx = (*cb).ctx as *mut render.Ctx
    (*cb).now = (*cb).now + 1000000
    if combofilter.is_open(&(*cb).st) {
        let r: i64 = row_at(cb, c, x, y)
        if r >= 0 {
            choose(cb, rd32((*cb).idx, r as usize))
            return true
        }
        var q: [f64; 4] = [0.0; 4]
        panel_rect(cb, c, &q)
        if ds_fbtext.inside(&q, x, y) { return true }
    }
    if inside_box(cb, x, y) {
        let cw: f64 = chev_w(c)
        if x >= (*cb).x + (*cb).w - cw {
            if combofilter.is_open(&(*cb).st) {
                close_list(cb)
            } else {
                focus(cb, true)
                open_list(cb)
            }
            return true
        }
        focus(cb, true)
        kitform.field_box_press(c, (*cb).fld, (*cb).x, (*cb).y, (*cb).w - cw, (*cb).h, x, y, (*cb).now)
        if !combofilter.is_open(&(*cb).st) { open_list(cb) }
        return true
    }
    if (*cb).foc { blur(cb) }
    return false
}

fn wheel(cb: *mut Combo, dy: i64) {
    if !combofilter.is_open(&(*cb).st) { return }
    var t: i64 = combofilter.top_row(&(*cb).st) + dy
    var maxtop: i64 = (*cb).nres as i64 - (*cb).prows
    if maxtop < 0 { maxtop = 0 }
    if t < 0 { t = 0 }
    if t > maxtop { t = maxtop }
    (*cb).st.top = t
}

fn key(cb: *mut Combo, k: u32, mods: u32) -> bool {
    if !(*cb).foc { return false }
    let st: *mut combofilter.ComboState = &(*cb).st
    let open: bool = combofilter.is_open(st)
    if k == editor.KEY_DOWN {
        if open { combofilter.key_down(st) } else { open_list(cb) }
        return true
    }
    if k == editor.KEY_UP {
        if !open { open_list(cb) }
        combofilter.key_up(st)
        return true
    }
    if open && k == editor.KEY_PGDN { combofilter.page_down(st); return true }
    if open && k == editor.KEY_PGUP { combofilter.page_up(st); return true }
    if open && k == editor.KEY_HOME { combofilter.key_home(st); return true }
    if open && k == editor.KEY_END { combofilter.key_end(st); return true }
    if k == editor.KEY_ENTER {
        if open {
            let r: i64 = combofilter.accept(st)
            if r >= 0 { choose(cb, rd32((*cb).idx, r as usize)) } else { commit_typed(cb) }
            return true
        }
        commit_typed(cb)
        return false
    }
    if k == editor.KEY_ESC {
        if combofilter.dismiss(st) { return true }
        if (*cb).value >= 0 && !same(text_of(cb), item_label(cb, (*cb).value as usize)) {
            set_value(cb, (*cb).value)
            return true
        }
        return false
    }
    if k == editor.KEY_TAB {
        close_list(cb)
        commit_typed(cb)
        return false
    }
    if kit.search_key((*cb).fld, k, mods) != editor.RES_PASS {
        typed(cb)
        return true
    }
    return false
}

fn text(cb: *mut Combo, cp: u32, mods: u32) -> bool {
    if !(*cb).foc { return false }
    kit.search_char((*cb).fld, cp, mods)
    typed(cb)
    return true
}
