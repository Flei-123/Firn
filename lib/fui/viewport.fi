// SPDX-License-Identifier: MPL-2.0
// lib/fui/viewport.fi -- DER SCHEIBENKASTEN.
//
// ===================================================== WARUM ES IHN GIBT
//
// lib/fui/wave2.fi kann einen Rollbalken MALEN. Was fehlte, war der
// Behaelter darunter: ein Ausschnitt, der weniger hoch ist als sein
// Inhalt. Ohne ihn hat eine Liste mit zweihundert Zeilen nur zwei
// Moeglichkeiten -- sie wird zweihundert Zeilen hoch, oder der Aufrufer
// rechnet sich von Hand aus, welche Zeilen er noch malen darf. Das
// zweite ist der Weg, auf dem in diesem Baum jedes Mal ein Bildpunkt
// danebenliegt, und das erste ist kein Fenster.
//
// ================================================== WAS ER WIRKLICH TUT
//
//   1. ER SCHNEIDET AB, und zwar ECHT: `viewport_begin` legt ueber
//      canvas.clip_push_rect einen Clip auf den Ausschnitt, und
//      `viewport_end` nimmt ihn wieder herunter. Jeder Zeichenweg
//      dieses Baums (painter, uiimage, effect, transform) geht durch
//      canvas.canvas_blend / canvas_fill_rect / canvas_fill_raster und
//      wird davon erfasst. Es gibt hier KEINEN zweiten Clip -- der
//      Stapel steht in lib/paint/canvas.fi, und genau dieser wird
//      benutzt.
//   2. ER VERSCHIEBT. Der Inhalt wird bei
//      (`viewport_content_x`, `viewport_content_y`) gemalt, also um die
//      Rollposition versetzt.
//   3. ER RECHNET DIE ROLLBALKEN AUS DEM VERHAELTNIS. Anteil =
//      Ausschnitt / Inhalt, Stellung = Verschiebung / groesstmoegliche
//      Verschiebung. Beides geht als `pref` und `value` an
//      wave2.draw_scrollbar -- die Laenge des Schiebers rechnet
//      wave2.scrollbar_thumb, und zwar als EINZIGE Stelle.
//   4. ER LAESST WEICH AUS. Das kinetische Rollen ist eine ganz normale
//      anim.Animation mit EASE_OUT auf der Verschiebung. Es gibt hier
//      keine zweite Zeitrechnung: die Millisekunden kommen von aussen
//      herein (render.ctx_time), wie ueberall sonst in fUi.
//   5. ER LAESST SEINE BALKEN ANFASSEN. `viewport_bar_hit` sagt,
//      welcher Balken unter dem Zeiger liegt, `viewport_bar_press`
//      greift den Schieber (oder springt seitenweise, wenn daneben
//      gedrueckt wurde), `viewport_bar_drag` uebersetzt die Strecke
//      des Zeigers in eine Verschiebung. Die Geometrie des Schiebers
//      kommt dabei aus wave2.scrollbar_thumb -- aus derselben
//      Rechnung, die ihn malt, und sogar seine Weglaenge wird dort
//      ERFRAGT statt hergeleitet.
//   6. ER RECHNET DEN KLICK ZURUECK. `viewport_hit` nimmt einen Punkt
//      in Fensterkoordinaten und gibt den Punkt IM INHALT. Ohne das
//      trifft ein Klick in einer gerollten Liste die falsche Zeile --
//      derselbe Fehler, den lib/fui/transform.fi fuer die Drehung mit
//      der Kehrabbildung loest.
//
// ============================================== DIE BALKEN ERSCHEINEN
//
// Ein Balken wird gezeigt, wenn der Inhalt in dieser Richtung nicht
// hineinpasst -- und die Rechnung ist ueber Kreuz: ein senkrechter
// Balken nimmt Breite weg, wodurch der Inhalt waagerecht knapp werden
// kann, und umgekehrt. Darum wird in `bars_needed` erst grob, dann
// ueber Kreuz entschieden. Wer das nicht tut, bekommt den bekannten
// Flackerfall: ein Balken erscheint, macht den anderen noetig, der
// macht den ersten ueberfluessig.
export {
    Viewport, viewport_new,
    viewport_set_rect, viewport_set_content, viewport_set_bar,
    viewport_set_inset, viewport_inset,
    viewport_x, viewport_y, viewport_w, viewport_h,
    viewport_content_w, viewport_content_h,
    viewport_off_x, viewport_off_y, viewport_set_offset,
    viewport_max_x, viewport_max_y,
    viewport_inner_w, viewport_inner_h,
    viewport_needs_h, viewport_needs_v,
    viewport_scroll_by, viewport_wheel, viewport_key,
    viewport_fling, viewport_tick, viewport_moving,
    viewport_share_h, viewport_share_v,
    viewport_value_h, viewport_value_v,
    viewport_bar_rect_v, viewport_bar_rect_h,
    viewport_bar_hit, viewport_bar_thumb,
    viewport_bar_press, viewport_bar_drag, viewport_bar_release,
    viewport_bar_dragging,
    VP_BAR_NONE, VP_BAR_V, VP_BAR_H,
    viewport_content_x, viewport_content_y,
    viewport_hit, viewport_visible,
    viewport_ensure_visible,
    viewport_begin, viewport_end,
    viewport_draw_bars,
    VP_UP, VP_DOWN, VP_LEFT, VP_RIGHT,
    VP_PAGE_UP, VP_PAGE_DOWN, VP_HOME, VP_END,
    VP_STEP, VP_WHEEL_STEP, VP_FLING_MS,
}

import paint.canvas
import fui.layout
import fui.widget
import fui.painter
import fui.render
import fui.anim
import fui.wave2

// DIE TASTEN. Es gibt in diesem Baum noch keinen gemeinsamen
// Tastencode -- lib/fui/control.fi kennt nur die Tabulatorkette, und
// lib/fui/editor.fi fuehrt seine eigenen Codes fuer das Textfeld. Also
// stehen hier die acht Bewegungen, die ein Scheibenkasten kennt, als
// eigene Zahlen. Sie sind ABSICHTLICH keine Zeichen: der Aufrufer
// uebersetzt seine Tastatur einmal darauf.
const VP_UP: u32 = 1
const VP_DOWN: u32 = 2
const VP_LEFT: u32 = 3
const VP_RIGHT: u32 = 4
const VP_PAGE_UP: u32 = 5
const VP_PAGE_DOWN: u32 = 6
const VP_HOME: u32 = 7
const VP_END: u32 = 8

// Ein Tastenschritt und ein Radschritt, in Entwurfspunkten. Der
// Radschritt ist das Dreifache -- ein Radrasten soll mehr bewegen als
// ein Tastendruck, sonst rollt niemand mit dem Rad.
const VP_STEP: f64 = 24.0
const VP_WHEEL_STEP: f64 = 72.0
// Wie lange das kinetische Auslaufen dauert.
const VP_FLING_MS: i64 = 420

// WELCHER BALKEN GEMEINT IST. Dieselbe Sorte Zahl wie die acht
// Bewegungen oben: der Aufrufer bekommt eine Richtung zurueck und
// muss dafuer nicht wissen, wie ein Balken gebaut ist.
const VP_BAR_NONE: u32 = 0
const VP_BAR_V: u32 = 1
const VP_BAR_H: u32 = 2

struct Viewport {
    // Der Ausschnitt im Fenster.
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    // Der Inhalt dahinter.
    cw: f64,
    ch: f64,
    // Die Verschiebung. Positiv heisst: der Inhalt steht weiter oben
    // bzw. weiter links, als sein Anfang.
    ox: f64,
    oy: f64,
    // Die Dicke eines Rollbalkens in Entwurfspunkten.
    bar: usize,
    // DAS POLSTER DES AUSSCHNITTS. Es gehoert dem KASTEN, nicht dem
    // Inhalt: der Inhalt wird nach wie vor an derselben Stelle
    // angeordnet, aber ABGESCHNITTEN wird ein Polster frueher. Damit
    // bleibt ringsum ein Streifen des Kastengrundes stehen, und der
    // Anschnitt einer halben Zeile ist im Bild von einem
    // versehentlichen Anschnitt an der Blattkante zu unterscheiden --
    // genau das war an den Belegen 23 bis 26 nicht zu sehen. Die
    // Balken werden NACH dem Clip gemalt und bleiben darum ganz.
    pad: f64,
    // Das kinetische Auslaufen -- zwei ganz normale Tweens.
    fx: anim.Animation,
    fy: anim.Animation,
    fx_on: u32,
    fy_on: u32,
    // Das Ziehen an einem Balken: welche Richtung, wo gegriffen wurde
    // und welche Verschiebung in diesem Augenblick galt.
    drag: u32,
    grab: f64,
    grab_off: f64,
}

fn viewport_new(x: f64, y: f64, w: f64, h: f64, cw: f64,
    ch: f64) -> Viewport {
    return Viewport { x: x, y: y, w: w, h: h, cw: cw, ch: ch,
        ox: 0.0, oy: 0.0, bar: 12, pad: 0.0,
        fx: anim.anim_new(0, 1, 0.0, 0.0, anim.easing_linear()),
        fy: anim.anim_new(0, 1, 0.0, 0.0, anim.easing_linear()),
        fx_on: 0 as u32, fy_on: 0 as u32,
        drag: VP_BAR_NONE, grab: 0.0, grab_off: 0.0 }
}

fn viewport_set_rect(v: *mut Viewport, x: f64, y: f64, w: f64, h: f64) {
    (*v).x = x
    (*v).y = y
    (*v).w = w
    (*v).h = h
    clamp_offset(v)
}

fn viewport_set_content(v: *mut Viewport, cw: f64, ch: f64) {
    (*v).cw = cw
    (*v).ch = ch
    clamp_offset(v)
}

fn viewport_set_bar(v: *mut Viewport, points: usize) { (*v).bar = points }

// Das Polster des Ausschnitts, in Entwurfspunkten. 0 heisst: der
// Schnitt liegt genau auf der Kante (das war das Verhalten bis zum
// 22.09.2026). Negative Werte gibt es nicht -- ein Schnitt AUSSERHALB
// des Kastens waere kein Ausschnitt mehr.
fn viewport_set_inset(v: *mut Viewport, points: f64) {
    if points < 0.0 {
        (*v).pad = 0.0
        return
    }
    (*v).pad = points
}

fn viewport_inset(v: *mut Viewport) -> f64 { return (*v).pad }

fn viewport_x(v: *mut Viewport) -> f64 { return (*v).x }
fn viewport_y(v: *mut Viewport) -> f64 { return (*v).y }
fn viewport_w(v: *mut Viewport) -> f64 { return (*v).w }
fn viewport_h(v: *mut Viewport) -> f64 { return (*v).h }
fn viewport_content_w(v: *mut Viewport) -> f64 { return (*v).cw }
fn viewport_content_h(v: *mut Viewport) -> f64 { return (*v).ch }
fn viewport_off_x(v: *mut Viewport) -> f64 { return (*v).ox }
fn viewport_off_y(v: *mut Viewport) -> f64 { return (*v).oy }

// ======================================================================
// WELCHE BALKEN NOETIG SIND -- die Rechnung ueber Kreuz
// ======================================================================
//
// `bar_px` ist die Dicke des Balkens in DERSELBEN EINHEIT, in der auch
// Ausschnitt und Inhalt dieses Kastens stehen. Dieses Modul rechnet
// NICHT um: `viewport_set_bar` nimmt die Zahl, die der Aufrufer ihm
// gibt, und `bar_px_of` gibt sie zurueck. Wer mit einem Massstab != 1
// arbeitet, setzt sie darum ueber `theme.theme_px` -- dort steht die
// Umrechnung Entwurfspunkt -> Bildpunkt, und ein zweiter Ort dafuer
// waere genau der Fehler, den dieser Baum am teuersten bezahlt hat.
// tools/fui/viewport_main.fi Abschnitt 11 weist nach, dass der Clip
// auch bei Massstab 1.5 auf dem Ausschnitt sitzt.
//
// Dass die Dicke hier ein PARAMETER ist und kein Feldzugriff, hat einen
// Grund: so laesst sich die Rechnung ueber Kreuz mit einer beliebigen
// Dicke pruefen, ohne den Kasten dafuer zu veraendern.
fn bars_needed(v: *mut Viewport, bar_px: f64, nh: *mut bool,
    nv: *mut bool) {
    var h_needed: bool = (*v).cw > (*v).w
    var v_needed: bool = (*v).ch > (*v).h
    if v_needed && !h_needed {
        h_needed = (*v).cw > (*v).w - bar_px
    }
    if h_needed && !v_needed {
        v_needed = (*v).ch > (*v).h - bar_px
    }
    *nh = h_needed
    *nv = v_needed
}

fn bar_px_of(v: *mut Viewport) -> f64 { return (*v).bar as f64 }

fn viewport_needs_h(v: *mut Viewport) -> bool {
    var a: bool = false
    var b: bool = false
    bars_needed(v, bar_px_of(v), &a, &b)
    return a
}

fn viewport_needs_v(v: *mut Viewport) -> bool {
    var a: bool = false
    var b: bool = false
    bars_needed(v, bar_px_of(v), &a, &b)
    return b
}

// Der WIRKLICH sichtbare Ausschnitt: der Kasten minus die Balken, die
// gezeigt werden. Jede Rechnung dieses Moduls -- Anteil, Klemmung,
// `ensure_visible`, Trefferpruefung -- benutzt diese beiden Zahlen, und
// darum sitzt ein Element nie unter seinem eigenen Rollbalken.
fn viewport_inner_w(v: *mut Viewport) -> f64 {
    if viewport_needs_v(v) {
        let r: f64 = (*v).w - bar_px_of(v)
        if r < 0.0 {
            return 0.0
        }
        return r
    }
    return (*v).w
}

fn viewport_inner_h(v: *mut Viewport) -> f64 {
    if viewport_needs_h(v) {
        let r: f64 = (*v).h - bar_px_of(v)
        if r < 0.0 {
            return 0.0
        }
        return r
    }
    return (*v).h
}

fn viewport_max_x(v: *mut Viewport) -> f64 {
    let r: f64 = (*v).cw - viewport_inner_w(v)
    if r < 0.0 {
        return 0.0
    }
    return r
}

fn viewport_max_y(v: *mut Viewport) -> f64 {
    let r: f64 = (*v).ch - viewport_inner_h(v)
    if r < 0.0 {
        return 0.0
    }
    return r
}

fn clamp_offset(v: *mut Viewport) {
    let mx: f64 = viewport_max_x(v)
    let my: f64 = viewport_max_y(v)
    if (*v).ox < 0.0 { (*v).ox = 0.0 }
    if (*v).oy < 0.0 { (*v).oy = 0.0 }
    if (*v).ox > mx { (*v).ox = mx }
    if (*v).oy > my { (*v).oy = my }
}

// WER SELBST ANFASST, HAELT DAS AUSLAUFEN AN.
//
// Ohne das gaebe es den Fall, den jeder kennt und niemand will: waehrend
// die Liste noch weich auslaeuft, dreht man am Rad -- und der naechste
// Takt schreibt die Verschiebung des Tweens darueber, als haette man
// nichts getan. Jede Bedienung geht hier durch `viewport_set_offset`,
// also steht der Abbruch an EINER Stelle: Rad, Taste,
// `viewport_scroll_by` und `viewport_ensure_visible` erben ihn.
//
// `viewport_tick` schreibt die Felder absichtlich direkt und nicht ueber
// diese Funktion -- sonst hielte die laufende Bewegung sich selbst an.
fn fling_stop(v: *mut Viewport) {
    (*v).fx_on = 0 as u32
    (*v).fy_on = 0 as u32
}

fn viewport_set_offset(v: *mut Viewport, ox: f64, oy: f64) {
    fling_stop(v)
    (*v).ox = ox
    (*v).oy = oy
    clamp_offset(v)
}

fn viewport_scroll_by(v: *mut Viewport, dx: f64, dy: f64) {
    viewport_set_offset(v, (*v).ox + dx, (*v).oy + dy)
}

// ======================================================================
// BEDIENUNG
// ======================================================================
//
// Das Rad rollt SOFORT (ein Rasten ist eine Strecke, keine Bewegung);
// wer weich auslaufen will, ruft `viewport_fling`.
fn viewport_wheel(v: *mut Viewport, dx: f64, dy: f64) {
    viewport_scroll_by(v, dx * VP_WHEEL_STEP, dy * VP_WHEEL_STEP)
}

// Eine Taste. Der Rueckgabewert sagt, ob sich etwas bewegt hat -- genau
// die Auskunft, die ein Fenster braucht, um zu entscheiden, ob es neu
// zeichnen muss, und die es sonst raten wuerde.
fn viewport_key(v: *mut Viewport, key: u32) -> bool {
    let vorher_x: f64 = (*v).ox
    let vorher_y: f64 = (*v).oy
    if key == VP_UP {
        viewport_scroll_by(v, 0.0, 0.0 - VP_STEP)
    } else if key == VP_DOWN {
        viewport_scroll_by(v, 0.0, VP_STEP)
    } else if key == VP_LEFT {
        viewport_scroll_by(v, 0.0 - VP_STEP, 0.0)
    } else if key == VP_RIGHT {
        viewport_scroll_by(v, VP_STEP, 0.0)
    } else if key == VP_PAGE_UP {
        viewport_scroll_by(v, 0.0, 0.0 - viewport_inner_h(v))
    } else if key == VP_PAGE_DOWN {
        viewport_scroll_by(v, 0.0, viewport_inner_h(v))
    } else if key == VP_HOME {
        viewport_set_offset(v, (*v).ox, 0.0)
    } else if key == VP_END {
        viewport_set_offset(v, (*v).ox, viewport_max_y(v))
    } else {
        return false
    }
    return (*v).ox != vorher_x || (*v).oy != vorher_y
}

// DAS WEICHE AUSLAUFEN. `vx`/`vy` sind Geschwindigkeiten in Pixeln je
// Millisekunde -- wie sie ein Zeigergeraet liefert. Daraus wird ein
// ZIEL, und der Weg dorthin ist ein Tween mit EASE_OUT: schnell am
// Anfang, ruhig am Ende. Die halbe Dauer als Faktor ist die Strecke,
// die eine gleichmaessig gebremste Bewegung zuruecklegt.
fn viewport_fling(v: *mut Viewport, vx: f64, vy: f64, now_ms: i64) {
    let strecke: f64 = (VP_FLING_MS as f64) / 2.0
    var zx: f64 = (*v).ox + vx * strecke
    var zy: f64 = (*v).oy + vy * strecke
    if zx < 0.0 { zx = 0.0 }
    if zy < 0.0 { zy = 0.0 }
    let mx: f64 = viewport_max_x(v)
    let my: f64 = viewport_max_y(v)
    if zx > mx { zx = mx }
    if zy > my { zy = my }
    (*v).fx = anim.anim_new(now_ms, VP_FLING_MS, (*v).ox, zx,
        anim.easing_named(anim.EASE_OUT))
    (*v).fy = anim.anim_new(now_ms, VP_FLING_MS, (*v).oy, zy,
        anim.easing_named(anim.EASE_OUT))
    (*v).fx_on = 1 as u32
    (*v).fy_on = 1 as u32
}

// Der Takt. Gibt zurueck, ob sich die Verschiebung geaendert hat.
fn viewport_tick(v: *mut Viewport, now_ms: i64) -> bool {
    var geaendert: bool = false
    if (*v).fx_on != 0 as u32 {
        let n: f64 = anim.anim_value(&(*v).fx, now_ms)
        if n != (*v).ox {
            (*v).ox = n
            geaendert = true
        }
        if anim.anim_done(&(*v).fx, now_ms) {
            (*v).fx_on = 0 as u32
        }
    }
    if (*v).fy_on != 0 as u32 {
        let n: f64 = anim.anim_value(&(*v).fy, now_ms)
        if n != (*v).oy {
            (*v).oy = n
            geaendert = true
        }
        if anim.anim_done(&(*v).fy, now_ms) {
            (*v).fy_on = 0 as u32
        }
    }
    if geaendert {
        clamp_offset(v)
    }
    return geaendert
}

fn viewport_moving(v: *mut Viewport) -> bool {
    return (*v).fx_on != 0 as u32 || (*v).fy_on != 0 as u32
}

// ======================================================================
// DIE BALKEN AUS DEM VERHAELTNIS
// ======================================================================
//
// Der Anteil ist Ausschnitt / Inhalt, die Stellung Verschiebung /
// groesstmoegliche Verschiebung. Beides in Promille von
// wave2.VAL_MAX, weil genau das die Sprache ist, die
// `wave2.draw_scrollbar` spricht.
fn viewport_share_v(v: *mut Viewport) -> f64 {
    if (*v).ch <= 0.0 {
        return 1.0
    }
    let s: f64 = viewport_inner_h(v) / (*v).ch
    if s > 1.0 {
        return 1.0
    }
    return s
}

fn viewport_share_h(v: *mut Viewport) -> f64 {
    if (*v).cw <= 0.0 {
        return 1.0
    }
    let s: f64 = viewport_inner_w(v) / (*v).cw
    if s > 1.0 {
        return 1.0
    }
    return s
}

fn viewport_value_v(v: *mut Viewport) -> i64 {
    let m: f64 = viewport_max_y(v)
    if m <= 0.0 {
        return 0
    }
    return (((*v).oy / m) * (wave2.VAL_MAX as f64)) as i64
}

fn viewport_value_h(v: *mut Viewport) -> i64 {
    let m: f64 = viewport_max_x(v)
    if m <= 0.0 {
        return 0
    }
    return (((*v).ox / m) * (wave2.VAL_MAX as f64)) as i64
}

// Wo der senkrechte Balken sitzt: am rechten Rand, und er endet ueber
// dem waagerechten, wenn es einen gibt.
fn viewport_bar_rect_v(v: *mut Viewport, x: *mut f64, y: *mut f64,
    w: *mut f64, h: *mut f64) -> bool {
    if !viewport_needs_v(v) {
        return false
    }
    let b: f64 = bar_px_of(v)
    *x = (*v).x + (*v).w - b
    *y = (*v).y
    *w = b
    *h = viewport_inner_h(v)
    return true
}

fn viewport_bar_rect_h(v: *mut Viewport, x: *mut f64, y: *mut f64,
    w: *mut f64, h: *mut f64) -> bool {
    if !viewport_needs_h(v) {
        return false
    }
    let b: f64 = bar_px_of(v)
    *x = (*v).x
    *y = (*v).y + (*v).h - b
    *w = viewport_inner_w(v)
    *h = b
    return true
}

// ======================================================================
// DER INHALT UND DER PUNKT DARIN
// ======================================================================
fn viewport_content_x(v: *mut Viewport) -> f64 { return (*v).x - (*v).ox }
fn viewport_content_y(v: *mut Viewport) -> f64 { return (*v).y - (*v).oy }

// Liegt ein Fensterpunkt im Ausschnitt, und wo liegt er IM INHALT?
// `cx`/`cy` sind Inhaltskoordinaten (0,0 = Anfang des Inhalts).
fn viewport_hit(v: *mut Viewport, px: f64, py: f64, cx: *mut f64,
    cy: *mut f64) -> bool {
    let iw: f64 = viewport_inner_w(v)
    let ih: f64 = viewport_inner_h(v)
    // GETROFFEN WIRD, WAS MAN SIEHT. Das Polster schneidet den Inhalt
    // weg; ein Punkt darin zeigt auf nichts Sichtbares mehr, also darf
    // er auch nichts treffen -- sonst klickt man auf eine Zeile, die
    // an dieser Stelle gar nicht gemalt ist.
    let p: f64 = (*v).pad
    if px < (*v).x + p || py < (*v).y + p || px >= (*v).x + iw - p
    || py >= (*v).y + ih - p {
        return false
    }
    *cx = px - (*v).x + (*v).ox
    *cy = py - (*v).y + (*v).oy
    return true
}

// Liegt ein Rechteck des INHALTS im Ausschnitt (auch nur teilweise)?
// Damit spart sich ein Aufrufer das Malen der 190 Zeilen, die ohnehin
// abgeschnitten wuerden -- der Clip haelt sie auf, aber schneller ist,
// sie gar nicht erst zu malen.
fn viewport_visible(v: *mut Viewport, rx: f64, ry: f64, rw: f64,
    rh: f64) -> bool {
    if rx + rw <= (*v).ox || ry + rh <= (*v).oy {
        return false
    }
    if rx >= (*v).ox + viewport_inner_w(v)
    || ry >= (*v).oy + viewport_inner_h(v) {
        return false
    }
    return true
}

// EIN RECHTECK IN DEN AUSSCHNITT HOLEN. Ohne das gibt es keine
// Tastaturbedienung in einer langen Liste: die Auswahl wandert nach
// unten und verschwindet, weil niemand nachrollt. Das Rechteck steht in
// INHALTSKOORDINATEN.
//
// Gerollt wird so wenig wie moeglich -- liegt das Rechteck oberhalb,
// kommt es an die Oberkante; liegt es unterhalb, an die Unterkante. Ist
// es groesser als der Ausschnitt, gewinnt die Oberkante: man liest von
// oben.
fn viewport_ensure_visible(v: *mut Viewport, rx: f64, ry: f64, rw: f64,
    rh: f64) -> bool {
    let vorher_x: f64 = (*v).ox
    let vorher_y: f64 = (*v).oy
    let iw: f64 = viewport_inner_w(v)
    let ih: f64 = viewport_inner_h(v)
    var nx: f64 = (*v).ox
    var ny: f64 = (*v).oy
    if rx + rw > nx + iw {
        nx = rx + rw - iw
    }
    if rx < nx {
        nx = rx
    }
    if ry + rh > ny + ih {
        ny = ry + rh - ih
    }
    if ry < ny {
        ny = ry
    }
    viewport_set_offset(v, nx, ny)
    return (*v).ox != vorher_x || (*v).oy != vorher_y
}

// ======================================================================
// DAS ABSCHNEIDEN
// ======================================================================
//
// EIN Clip, und er kommt aus lib/paint/canvas.fi. `viewport_begin`
// schiebt ihn auf den Stapel, `viewport_end` nimmt ihn herunter -- und
// dazwischen darf gemalt werden, was will: jeder Weg dieses Baums
// schreibt ueber canvas_blend / canvas_fill_rect / canvas_fill_raster
// und wird davon erfasst.
//
// Der Rueckgabewert ist falsch, wenn der Stapel voll ist (16 Ebenen).
// Dann wird NICHT gemalt -- lieber ein leerer Kasten als Inhalt, der
// ueber den Rand laeuft.
fn viewport_begin(c: *mut render.Ctx, v: *mut Viewport) -> bool {
    let cv: *mut canvas.Canvas = painter.painter_canvas(render.ctx_painter(c))
    // Das Polster wird hier abgezogen und NUR hier: die Stellung des
    // Inhalts, die Balken und die Trefferpruefung rechnen weiter mit
    // dem ganzen Rechteck. Ist das Polster groesser als der Ausschnitt,
    // bleibt nichts uebrig -- dann meldet clip_push_rect von sich aus
    // false, und der Aufrufer malt gar nichts.
    let p: f64 = (*v).pad
    return canvas.clip_push_rect(cv, (*v).x + p, (*v).y + p,
        (*v).x + viewport_inner_w(v) - p, (*v).y + viewport_inner_h(v) - p)
}

fn viewport_end(c: *mut render.Ctx, v: *mut Viewport) {
    canvas.clip_pop(painter.painter_canvas(render.ctx_painter(c)))
}

// ======================================================================
// DIE BALKEN MALEN
// ======================================================================
//
// Gemalt wird mit wave2.draw_scrollbar, also mit DEM Rollbalken dieser
// Bibliothek. Dieses Modul rechnet nur Anteil und Stellung aus; wie ein
// Rollbalken aussieht, steht an einer Stelle, und die ist nicht hier.
// DAS WIDGET EINES BALKENS -- an EINER Stelle gebaut.
//
// Gemalt und bedient wird derselbe Rollbalken, also darf er auch nur
// einmal zusammengesetzt werden: Rechteck, Anteil (als `pref`) und
// Stellung (als `value`). Stuende das Malen hier und das Greifen
// daneben, haetten Bild und Bedienung zwei Geometrien -- und der
// Schieber laege genau dort, wo man NICHT hinfasst. `wert` sagt, mit
// welcher Stellung der Balken gebaut wird: die Bedienung fragt ihn
// auch nach den Enden seiner Spur (0 und VAL_MAX), und genau daher
// kommt die Weglaenge des Schiebers, ohne sie ein zweites Mal
// auszurechnen.
fn bar_widget(v: *mut Viewport, senkrecht: bool,
    wert: i64) -> widget.Widget {
    var bx: f64 = 0.0
    var by: f64 = 0.0
    var bw: f64 = 0.0
    var bh: f64 = 0.0
    var e: widget.Widget = widget.widget_new(widget.KIND_SCROLLBAR)
    if senkrecht {
        if !viewport_bar_rect_v(v, &bx, &by, &bw, &bh) {
            return e
        }
        widget.w_place(&e, bx, by, bw, bh)
        widget.w_set_pref(&e, 0.0,
            viewport_share_v(v) * (wave2.VAL_MAX as f64))
        widget.w_set_value(&e, wert)
        return e
    }
    if !viewport_bar_rect_h(v, &bx, &by, &bw, &bh) {
        return e
    }
    widget.w_place(&e, bx, by, bw, bh)
    widget.w_set_pref(&e,
        viewport_share_h(v) * (wave2.VAL_MAX as f64), 0.0)
    widget.w_set_value(&e, wert)
    return e
}

fn viewport_draw_bars(c: *mut render.Ctx, v: *mut Viewport) {
    if viewport_needs_v(v) {
        var e: widget.Widget = bar_widget(v, true, viewport_value_v(v))
        wave2.draw_scrollbar(c, &e)
    }
    if viewport_needs_h(v) {
        var e: widget.Widget = bar_widget(v, false, viewport_value_h(v))
        wave2.draw_scrollbar(c, &e)
    }
}

// ======================================================================
// DIE BALKEN BEDIENEN
// ======================================================================
//
// Bis hierher konnte der Kasten seine Balken MALEN, und der Zeiger
// hatte nichts damit zu tun: rollen liess sich nur mit Rad und
// Tastatur. Das ist genau die halbe Sache, gegen die dieses Modul
// geschrieben ist -- ein Rollbalken, den man nicht anfassen kann, ist
// eine Anzeige und kein Bedienelement.
//
// WAS HIER NICHT STEHT: die Geometrie des Schiebers. Sie kommt Stueck
// fuer Stueck aus `wave2.scrollbar_thumb`, also aus derselben Rechnung,
// die ihn auch malt. Selbst die WEGLAENGE (wie weit der Schieber von
// oben nach unten wandert) wird nicht hergeleitet, sondern GEFRAGT:
// einmal die Lage bei Stellung 0, einmal bei VAL_MAX, die Differenz
// ist der Weg. Damit kann die Bedienung gar nicht von dem abweichen,
// was im Bild steht -- auch dann nicht, wenn wave2 sein Polster oder
// seine Mindestlaenge aendert.
fn viewport_bar_hit(v: *mut Viewport, px: f64, py: f64) -> u32 {
    var bx: f64 = 0.0
    var by: f64 = 0.0
    var bw: f64 = 0.0
    var bh: f64 = 0.0
    if viewport_bar_rect_v(v, &bx, &by, &bw, &bh) {
        if px >= bx && px < bx + bw && py >= by && py < by + bh {
            return VP_BAR_V
        }
    }
    if viewport_bar_rect_h(v, &bx, &by, &bw, &bh) {
        if px >= bx && px < bx + bw && py >= by && py < by + bh {
            return VP_BAR_H
        }
    }
    return VP_BAR_NONE
}

// Der Schieber eines Balkens als Rechteck -- dieselbe Form, die
// `wave2.draw_scrollbar` malt, bei der aktuellen Stellung.
fn viewport_bar_thumb(c: *mut render.Ctx, v: *mut Viewport,
    dir: u32) -> layout.Rect {
    var wert: i64 = viewport_value_h(v)
    if dir == VP_BAR_V {
        wert = viewport_value_v(v)
    }
    var e: widget.Widget = bar_widget(v, dir == VP_BAR_V, wert)
    return wave2.scrollbar_thumb(c, &e)
}

// DIE WEGLAENGE DES SCHIEBERS, BEI WAVE2 ERFRAGT. Der Schieber steht
// bei Stellung 0 am Anfang der Spur und bei VAL_MAX an ihrem Ende; was
// dazwischen liegt, ist genau die Strecke, die ein Ziehen ausnutzen
// kann. Sie in Polster und Mindestlaenge selbst zu zerlegen waere die
// zweite Fassung einer Rechnung, die es schon gibt.
fn bar_travel(c: *mut render.Ctx, v: *mut Viewport, dir: u32) -> f64 {
    let senkrecht: bool = dir == VP_BAR_V
    var e0: widget.Widget = bar_widget(v, senkrecht, 0)
    var e1: widget.Widget = bar_widget(v, senkrecht, wave2.VAL_MAX)
    var x0: f64 = 0.0
    var y0: f64 = 0.0
    var w0: f64 = 0.0
    var h0: f64 = 0.0
    var x1: f64 = 0.0
    var y1: f64 = 0.0
    var w1: f64 = 0.0
    var h1: f64 = 0.0
    wave2.scrollbar_thumb_f(c, &e0, &x0, &y0, &w0, &h0)
    wave2.scrollbar_thumb_f(c, &e1, &x1, &y1, &w1, &h1)
    if senkrecht {
        return y1 - y0
    }
    return x1 - x0
}

// EINEN BALKEN ANFASSEN.
//
// Zwei Faelle, und beide sind das, was jedes System tut:
//
//   * AUF DEM SCHIEBER faengt ein Ziehen an. Gemerkt werden der Punkt,
//     an dem gegriffen wurde, und die Verschiebung in diesem
//     Augenblick -- so bleibt der Griff unter dem Zeiger stehen, statt
//     dass der Schieber unter ihm wegspringt.
//   * AUF DER SPUR springt es SEITENWEISE: eine Seite ist der sichtbare
//     Ausschnitt, dieselbe Strecke wie Bild-auf/Bild-ab. Ein Sprung an
//     die Zeigerstelle waere die Alternative; seitenweise ist die
//     Wahl, die den Inhalt nicht ueberspringen laesst.
//
// Zurueck kommt, ob der Druck ueberhaupt einen Balken getroffen hat --
// die Auskunft, die ein Fenster braucht, um den Druck nicht auch noch
// an den Inhalt weiterzureichen.
fn viewport_bar_press(c: *mut render.Ctx, v: *mut Viewport, px: f64,
    py: f64) -> bool {
    let dir: u32 = viewport_bar_hit(v, px, py)
    if dir == VP_BAR_NONE {
        return false
    }
    let t: layout.Rect = viewport_bar_thumb(c, v, dir)
    let tx: f64 = layout.rect_x(&t) as f64
    let ty: f64 = layout.rect_y(&t) as f64
    let tw: f64 = layout.rect_w(&t) as f64
    let th: f64 = layout.rect_h(&t) as f64
    if px >= tx && px < tx + tw && py >= ty && py < ty + th {
        fling_stop(v)
        (*v).drag = dir
        if dir == VP_BAR_V {
            (*v).grab = py
            (*v).grab_off = (*v).oy
        } else {
            (*v).grab = px
            (*v).grab_off = (*v).ox
        }
        return true
    }
    // Die Spur: eine Seite vor oder zurueck, je nachdem, auf welcher
    // Seite des Schiebers gedrueckt wurde.
    if dir == VP_BAR_V {
        if py < ty {
            viewport_scroll_by(v, 0.0, 0.0 - viewport_inner_h(v))
        } else {
            viewport_scroll_by(v, 0.0, viewport_inner_h(v))
        }
        return true
    }
    if px < tx {
        viewport_scroll_by(v, 0.0 - viewport_inner_w(v), 0.0)
    } else {
        viewport_scroll_by(v, viewport_inner_w(v), 0.0)
    }
    return true
}

// DAS ZIEHEN. Die Strecke des Zeigers wird mit dem VERHAELTNIS
// groesste Verschiebung / Weglaenge des Schiebers auf den Inhalt
// uebersetzt -- dasselbe Verhaeltnis wie Inhalt / Spur, nur ohne den
// Umweg ueber die Laenge des Schiebers (tools/fui/viewport_main.fi
// Abschnitt 12 rechnet beide Wege gegeneinander).
//
// Zurueck kommt, ob sich etwas bewegt hat.
fn viewport_bar_drag(c: *mut render.Ctx, v: *mut Viewport, px: f64,
    py: f64) -> bool {
    if (*v).drag == VP_BAR_NONE {
        return false
    }
    let dir: u32 = (*v).drag
    let weg: f64 = bar_travel(c, v, dir)
    if weg <= 0.0 {
        return false
    }
    if dir == VP_BAR_V {
        let vorher: f64 = (*v).oy
        let d: f64 = (py - (*v).grab) * viewport_max_y(v) / weg
        viewport_set_offset(v, (*v).ox, (*v).grab_off + d)
        return (*v).oy != vorher
    }
    let vorher: f64 = (*v).ox
    let d: f64 = (px - (*v).grab) * viewport_max_x(v) / weg
    viewport_set_offset(v, (*v).grab_off + d, (*v).oy)
    return (*v).ox != vorher
}

// Loslassen. Ein eigener Aufruf, weil ein Kasten, der das Ziehen am
// Rand seiner Spur selbst beendet, beim Zurueckfahren nicht mehr
// mitzoege.
fn viewport_bar_release(v: *mut Viewport) {
    (*v).drag = VP_BAR_NONE
}

fn viewport_bar_dragging(v: *mut Viewport) -> u32 { return (*v).drag }
