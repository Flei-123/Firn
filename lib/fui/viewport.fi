// SPDX-License-Identifier: MPL-2.0
// lib/fui/viewport.fi -- THE PANE BOX.
//
// ===================================================== WHY IT EXISTS
//
// lib/fui/wave2.fi can PAINT a scrollbar. What was missing was the
// container underneath: a viewport that is less high than its
// content. Without it a list with two hundred rows has only two
// possibilities -- it becomes two hundred rows high, or the caller
// calculates by hand which rows he may still paint. The
// second is the way in which in this tree every time a pixel
// is off, and the first is no window.
//
// ================================================== WHAT IT REALLY DOES
//
//   1. IT CUTS OFF, and REALLY: `viewport_begin` lays via
//      canvas.clip_push_rect a clip onto the viewport, and
//      `viewport_end` takes it down again. Every drawing path
//      of this tree (painter, uiimage, effect, transform) goes through
//      canvas.canvas_blend / canvas_fill_rect / canvas_fill_raster and
//      is caught by it. There is NO second clip here -- the
//      stack stands in lib/paint/canvas.fi, and exactly this one is
//      used.
//   2. IT SHIFTS. The content is painted at
//      (`viewport_content_x`, `viewport_content_y`), so offset by the
//      scroll position.
//   3. IT CALCULATES THE SCROLLBARS FROM THE RATIO. Share =
//      viewport / content, position = offset / largest possible
//      offset. Both go as `pref` and `value` to
//      wave2.draw_scrollbar -- the length of the thumb is calculated by
//      wave2.scrollbar_thumb, and as the ONLY place.
//   4. IT RUNS OUT SOFTLY. Kinetic scrolling is a perfectly normal
//      anim.Animation with EASE_OUT on the offset. There is
//      no second time calculation here: the milliseconds come in from outside
//      (render.ctx_time), as everywhere else in fUi.
//   5. IT LETS ITS BARS BE GRASPED. `viewport_bar_hit` says
//      which bar lies under the pointer, `viewport_bar_press`
//      grasps the thumb (or jumps page by page if pressed next to it),
//      `viewport_bar_drag` translates the distance
//      of the pointer into an offset. The geometry of the thumb
//      comes from wave2.scrollbar_thumb -- from the same
//      calculation that paints it, and even its travel length is
//      ASKED there instead of derived.
//   6. IT CALCULATES THE CLICK BACK. `viewport_hit` takes a point
//      in window coordinates and gives the point IN THE CONTENT. Without that
//      a click in a scrolled list hits the wrong row --
//      the same error that lib/fui/transform.fi solves for rotation with
//      the inverse mapping.
//
// ============================================== THE BARS APPEAR
//
// A bar is shown if the content does not fit in this direction
// -- and the calculation is crosswise: a vertical
// bar takes width away, whereby the content can become tight horizontally,
// and vice versa. That is why in `bars_needed` a decision is made first roughly, then
// crosswise. Whoever does not do that gets the well-known flicker case:
// a bar appears, makes the other necessary, which
// makes the first superfluous.
export {
    Viewport, viewport_new,
    viewport_set_rect, viewport_set_content, viewport_set_bar,
    viewport_set_inset, viewport_inset,
    viewport_x, viewport_y, viewport_w, viewport_h,
    viewport_content_w, viewport_content_h,
    viewport_off_x, viewport_off_y, viewport_set_offset,
    viewport_max_x, viewport_max_y,
    viewport_inner_w, viewport_inner_h,
    viewport_needs_h, viewport_needs_v,
    viewport_scroll_by, viewport_wheel, viewport_key,
    viewport_fling, viewport_tick, viewport_moving,
    viewport_share_h, viewport_share_v,
    viewport_value_h, viewport_value_v,
    viewport_bar_rect_v, viewport_bar_rect_h,
    viewport_bar_hit, viewport_bar_thumb,
    viewport_bar_press, viewport_bar_drag, viewport_bar_release,
    viewport_bar_dragging,
    VP_BAR_NONE, VP_BAR_V, VP_BAR_H,
    viewport_content_x, viewport_content_y,
    viewport_hit, viewport_visible,
    viewport_ensure_visible,
    viewport_begin, viewport_end,
    viewport_draw_bars,
    VP_UP, VP_DOWN, VP_LEFT, VP_RIGHT,
    VP_PAGE_UP, VP_PAGE_DOWN, VP_HOME, VP_END,
    VP_STEP, VP_WHEEL_STEP, VP_FLING_MS,
}

import paint.canvas
import fui.layout
import fui.widget
import fui.painter
import fui.render
import fui.anim
import fui.wave2

// THE KEYS. There is no common key code in this tree yet --
// lib/fui/control.fi knows only the tab chain, and
// lib/fui/editor.fi keeps its own codes for the text field. So
// here stand the eight movements that a pane box knows, as
// numbers of their own. They are DELIBERATELY no characters: the caller
// translates his keyboard onto them once.
const VP_UP: u32 = 1
const VP_DOWN: u32 = 2
const VP_LEFT: u32 = 3
const VP_RIGHT: u32 = 4
const VP_PAGE_UP: u32 = 5
const VP_PAGE_DOWN: u32 = 6
const VP_HOME: u32 = 7
const VP_END: u32 = 8

// A key step and a wheel step, in design points. The
// wheel step is three times as much -- a wheel notch should move more than
// a key press, otherwise nobody scrolls with the wheel.
const VP_STEP: f64 = 24.0
const VP_WHEEL_STEP: f64 = 72.0
// How long the kinetic run-out lasts.
const VP_FLING_MS: i64 = 420

// WHICH BAR IS MEANT. The same kind of number as the eight
// movements above: the caller gets a direction back and
// need not know for that how a bar is built.
const VP_BAR_NONE: u32 = 0
const VP_BAR_V: u32 = 1
const VP_BAR_H: u32 = 2

struct Viewport {
    // The viewport in the window.
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    // The content behind it.
    cw: f64,
    ch: f64,
    // The offset. Positive means: the content stands further up
    // or further left than its start.
    ox: f64,
    oy: f64,
    // The thickness of a scrollbar in design points.
    bar: usize,
    // THE PADDING OF THE VIEWPORT. It belongs to the BOX, not to the
    // content: the content is still arranged at the same place,
    // but a padding is CUT OFF earlier. Thereby
    // a strip of box background remains all around, and the
    // cut-off of half a row in the picture can be told apart from an
    // accidental cut at the sheet edge --
    // exactly that was not to be seen in proofs 23 to 26. The
    // bars are painted AFTER the clip and therefore stay whole.
    pad: f64,
    // The kinetic run-out -- two perfectly normal tweens.
    fx: anim.Animation,
    fy: anim.Animation,
    fx_on: u32,
    fy_on: u32,
    // Dragging a bar: which direction, where it was grasped
    // and which offset applied at that moment.
    drag: u32,
    tombstone: f64,
    tombstone_off: f64,
}

fn viewport_new(x: f64, y: f64, w: f64, h: f64, cw: f64,
    ch: f64) -> Viewport {
    return Viewport { x: x, y: y, w: w, h: h, cw: cw, ch: ch,
        ox: 0.0, oy: 0.0, bar: 12, pad: 0.0,
        fx: anim.anim_new(0, 1, 0.0, 0.0, anim.easing_linear()),
        fy: anim.anim_new(0, 1, 0.0, 0.0, anim.easing_linear()),
        fx_on: 0 as u32, fy_on: 0 as u32,
        drag: VP_BAR_NONE, tombstone: 0.0, tombstone_off: 0.0 }
}

fn viewport_set_rect(v: *mut Viewport, x: f64, y: f64, w: f64, h: f64) {
    (*v).x = x
    (*v).y = y
    (*v).w = w
    (*v).h = h
    clamp_offset(v)
}

fn viewport_set_content(v: *mut Viewport, cw: f64, ch: f64) {
    (*v).cw = cw
    (*v).ch = ch
    clamp_offset(v)
}

fn viewport_set_bar(v: *mut Viewport, points: usize) { (*v).bar = points }

// The padding of the viewport, in design points. 0 means: the
// cut lies exactly on the edge (that was the behaviour until
// 22.09.2026). Negative values do not exist -- a cut OUTSIDE
// the box would no longer be a viewport.
fn viewport_set_inset(v: *mut Viewport, points: f64) {
    if points < 0.0 {
        (*v).pad = 0.0
        return
    }
    (*v).pad = points
}

fn viewport_inset(v: *mut Viewport) -> f64 { return (*v).pad }

fn viewport_x(v: *mut Viewport) -> f64 { return (*v).x }
fn viewport_y(v: *mut Viewport) -> f64 { return (*v).y }
fn viewport_w(v: *mut Viewport) -> f64 { return (*v).w }
fn viewport_h(v: *mut Viewport) -> f64 { return (*v).h }
fn viewport_content_w(v: *mut Viewport) -> f64 { return (*v).cw }
fn viewport_content_h(v: *mut Viewport) -> f64 { return (*v).ch }
fn viewport_off_x(v: *mut Viewport) -> f64 { return (*v).ox }
fn viewport_off_y(v: *mut Viewport) -> f64 { return (*v).oy }

// ======================================================================
// WHICH BARS ARE NECESSARY -- the crosswise calculation
// ======================================================================
//
// `bar_px` is the thickness of the bar in THE SAME UNIT in which
// viewport and content of this box also stand. This module does NOT
// convert: `viewport_set_bar` takes the number that the caller gives it,
// and `bar_px_of` returns it. Whoever works with a scale != 1
// therefore sets it via `theme.theme_px` -- there stands the
// conversion design point -> pixel, and a second place for it would be
// exactly the error that this tree has paid for most dearly.
// tools/fui/viewport_main.fi section 11 proves that the clip
// also sits on the viewport at scale 1.5.
//
// That the thickness is a PARAMETER here and not a field access has a
// reason: that way the crosswise calculation can be checked with any
// thickness, without changing the box for it.
fn bars_needed(v: *mut Viewport, bar_px: f64, nh: *mut bool,
    nv: *mut bool) {
    var h_needed: bool = (*v).cw > (*v).w
    var v_needed: bool = (*v).ch > (*v).h
    if v_needed && !h_needed {
        h_needed = (*v).cw > (*v).w - bar_px
    }
    if h_needed && !v_needed {
        v_needed = (*v).ch > (*v).h - bar_px
    }
    *nh = h_needed
    *nv = v_needed
}

fn bar_px_of(v: *mut Viewport) -> f64 { return (*v).bar as f64 }

fn viewport_needs_h(v: *mut Viewport) -> bool {
    var a: bool = false
    var b: bool = false
    bars_needed(v, bar_px_of(v), &a, &b)
    return a
}

fn viewport_needs_v(v: *mut Viewport) -> bool {
    var a: bool = false
    var b: bool = false
    bars_needed(v, bar_px_of(v), &a, &b)
    return b
}

// The REALLY visible viewport: the box minus the bars that
// are shown. Every calculation of this module -- share, clamping,
// `ensure_visible`, hit test -- uses these two numbers,
// and that is why an element never sits under its own scrollbar.
fn viewport_inner_w(v: *mut Viewport) -> f64 {
    if viewport_needs_v(v) {
        let r: f64 = (*v).w - bar_px_of(v)
        if r < 0.0 {
            return 0.0
        }
        return r
    }
    return (*v).w
}

fn viewport_inner_h(v: *mut Viewport) -> f64 {
    if viewport_needs_h(v) {
        let r: f64 = (*v).h - bar_px_of(v)
        if r < 0.0 {
            return 0.0
        }
        return r
    }
    return (*v).h
}

fn viewport_max_x(v: *mut Viewport) -> f64 {
    let r: f64 = (*v).cw - viewport_inner_w(v)
    if r < 0.0 {
        return 0.0
    }
    return r
}

fn viewport_max_y(v: *mut Viewport) -> f64 {
    let r: f64 = (*v).ch - viewport_inner_h(v)
    if r < 0.0 {
        return 0.0
    }
    return r
}

fn clamp_offset(v: *mut Viewport) {
    let mx: f64 = viewport_max_x(v)
    let my: f64 = viewport_max_y(v)
    if (*v).ox < 0.0 { (*v).ox = 0.0 }
    if (*v).oy < 0.0 { (*v).oy = 0.0 }
    if (*v).ox > mx { (*v).ox = mx }
    if (*v).oy > my { (*v).oy = my }
}

// WHOEVER TOUCHES IT HIMSELF STOPS THE RUN-OUT.
//
// Without that there would be the case that everybody knows and nobody wants: while
// the list is still running out softly, you turn the wheel -- and the next
// tick writes the offset of the tween over it, as if you had done
// nothing. Every operation goes through `viewport_set_offset` here,
// so the abort stands at ONE place: wheel, key,
// `viewport_scroll_by` and `viewport_ensure_visible` inherit it.
//
// `viewport_tick` deliberately writes the fields directly and not via
// this function -- otherwise the running movement would stop itself.
fn fling_stop(v: *mut Viewport) {
    (*v).fx_on = 0 as u32
    (*v).fy_on = 0 as u32
}

fn viewport_set_offset(v: *mut Viewport, ox: f64, oy: f64) {
    fling_stop(v)
    (*v).ox = ox
    (*v).oy = oy
    clamp_offset(v)
}

fn viewport_scroll_by(v: *mut Viewport, dx: f64, dy: f64) {
    viewport_set_offset(v, (*v).ox + dx, (*v).oy + dy)
}

// ======================================================================
// OPERATION
// ======================================================================
//
// The wheel scrolls AT ONCE (a notch is a distance, not a movement);
// whoever wants a soft run-out calls `viewport_fling`.
fn viewport_wheel(v: *mut Viewport, dx: f64, dy: f64) {
    viewport_scroll_by(v, dx * VP_WHEEL_STEP, dy * VP_WHEEL_STEP)
}

// A key. The return value says whether something has moved -- exactly
// the information that a window needs to decide whether it has to redraw,
// and that it would otherwise guess.
fn viewport_key(v: *mut Viewport, key: u32) -> bool {
    let before_x: f64 = (*v).ox
    let before_y: f64 = (*v).oy
    if key == VP_UP {
        viewport_scroll_by(v, 0.0, 0.0 - VP_STEP)
    } else if key == VP_DOWN {
        viewport_scroll_by(v, 0.0, VP_STEP)
    } else if key == VP_LEFT {
        viewport_scroll_by(v, 0.0 - VP_STEP, 0.0)
    } else if key == VP_RIGHT {
        viewport_scroll_by(v, VP_STEP, 0.0)
    } else if key == VP_PAGE_UP {
        viewport_scroll_by(v, 0.0, 0.0 - viewport_inner_h(v))
    } else if key == VP_PAGE_DOWN {
        viewport_scroll_by(v, 0.0, viewport_inner_h(v))
    } else if key == VP_HOME {
        viewport_set_offset(v, (*v).ox, 0.0)
    } else if key == VP_END {
        viewport_set_offset(v, (*v).ox, viewport_max_y(v))
    } else {
        return false
    }
    return (*v).ox != before_x || (*v).oy != before_y
}

// THE SOFT RUN-OUT. `vx`/`vy` are velocities in pixels per
// millisecond -- as a pointer device delivers them. From that becomes a
// TARGET, and the way there is a tween with EASE_OUT: fast at the
// start, calm at the end. Half the duration as a factor is the distance
// that a uniformly braked movement covers.
fn viewport_fling(v: *mut Viewport, vx: f64, vy: f64, now_ms: i64) {
    let strecke: f64 = (VP_FLING_MS as f64) / 2.0
    var zx: f64 = (*v).ox + vx * strecke
    var zy: f64 = (*v).oy + vy * strecke
    if zx < 0.0 { zx = 0.0 }
    if zy < 0.0 { zy = 0.0 }
    let mx: f64 = viewport_max_x(v)
    let my: f64 = viewport_max_y(v)
    if zx > mx { zx = mx }
    if zy > my { zy = my }
    (*v).fx = anim.anim_new(now_ms, VP_FLING_MS, (*v).ox, zx,
        anim.easing_named(anim.EASE_OUT))
    (*v).fy = anim.anim_new(now_ms, VP_FLING_MS, (*v).oy, zy,
        anim.easing_named(anim.EASE_OUT))
    (*v).fx_on = 1 as u32
    (*v).fy_on = 1 as u32
}

// The clock. Returns whether the offset has changed.
fn viewport_tick(v: *mut Viewport, now_ms: i64) -> bool {
    var geaendert: bool = false
    if (*v).fx_on != 0 as u32 {
        let n: f64 = anim.anim_value(&(*v).fx, now_ms)
        if n != (*v).ox {
            (*v).ox = n
            geaendert = true
        }
        if anim.anim_done(&(*v).fx, now_ms) {
            (*v).fx_on = 0 as u32
        }
    }
    if (*v).fy_on != 0 as u32 {
        let n: f64 = anim.anim_value(&(*v).fy, now_ms)
        if n != (*v).oy {
            (*v).oy = n
            geaendert = true
        }
        if anim.anim_done(&(*v).fy, now_ms) {
            (*v).fy_on = 0 as u32
        }
    }
    if geaendert {
        clamp_offset(v)
    }
    return geaendert
}

fn viewport_moving(v: *mut Viewport) -> bool {
    return (*v).fx_on != 0 as u32 || (*v).fy_on != 0 as u32
}

// ======================================================================
// THE BARS FROM THE RATIO
// ======================================================================
//
// The share is viewport / content, the position offset /
// largest possible offset. Both in per mille of
// wave2.VAL_MAX, because that is exactly the language that
// `wave2.draw_scrollbar` speaks.
fn viewport_share_v(v: *mut Viewport) -> f64 {
    if (*v).ch <= 0.0 {
        return 1.0
    }
    let s: f64 = viewport_inner_h(v) / (*v).ch
    if s > 1.0 {
        return 1.0
    }
    return s
}

fn viewport_share_h(v: *mut Viewport) -> f64 {
    if (*v).cw <= 0.0 {
        return 1.0
    }
    let s: f64 = viewport_inner_w(v) / (*v).cw
    if s > 1.0 {
        return 1.0
    }
    return s
}

fn viewport_value_v(v: *mut Viewport) -> i64 {
    let m: f64 = viewport_max_y(v)
    if m <= 0.0 {
        return 0
    }
    return (((*v).oy / m) * (wave2.VAL_MAX as f64)) as i64
}

fn viewport_value_h(v: *mut Viewport) -> i64 {
    let m: f64 = viewport_max_x(v)
    if m <= 0.0 {
        return 0
    }
    return (((*v).ox / m) * (wave2.VAL_MAX as f64)) as i64
}

// Where the vertical bar sits: at the right edge, and it ends above
// the horizontal one if there is one.
fn viewport_bar_rect_v(v: *mut Viewport, x: *mut f64, y: *mut f64,
    w: *mut f64, h: *mut f64) -> bool {
    if !viewport_needs_v(v) {
        return false
    }
    let b: f64 = bar_px_of(v)
    *x = (*v).x + (*v).w - b
    *y = (*v).y
    *w = b
    *h = viewport_inner_h(v)
    return true
}

fn viewport_bar_rect_h(v: *mut Viewport, x: *mut f64, y: *mut f64,
    w: *mut f64, h: *mut f64) -> bool {
    if !viewport_needs_h(v) {
        return false
    }
    let b: f64 = bar_px_of(v)
    *x = (*v).x
    *y = (*v).y + (*v).h - b
    *w = viewport_inner_w(v)
    *h = b
    return true
}

// ======================================================================
// THE CONTENT AND THE POINT IN IT
// ======================================================================
fn viewport_content_x(v: *mut Viewport) -> f64 { return (*v).x - (*v).ox }
fn viewport_content_y(v: *mut Viewport) -> f64 { return (*v).y - (*v).oy }

// Does a window point lie in the viewport, and where does it lie IN THE CONTENT?
// `cx`/`cy` are content coordinates (0,0 = start of the content).
fn viewport_hit(v: *mut Viewport, px: f64, py: f64, cx: *mut f64,
    cy: *mut f64) -> bool {
    let iw: f64 = viewport_inner_w(v)
    let ih: f64 = viewport_inner_h(v)
    // WHAT IS HIT IS WHAT YOU SEE. The padding cuts the content
    // away; a point in it points at nothing visible any more, so it
    // must also hit nothing -- otherwise you click on a row that
    // is not painted at all at this place.
    let p: f64 = (*v).pad
    if px < (*v).x + p || py < (*v).y + p || px >= (*v).x + iw - p
    || py >= (*v).y + ih - p {
        return false
    }
    *cx = px - (*v).x + (*v).ox
    *cy = py - (*v).y + (*v).oy
    return true
}

// Does a rectangle of the CONTENT lie in the viewport (even only partly)?
// With that a caller saves himself the painting of the 190 rows that would be
// cut off anyway -- the clip stops them, but it is faster
// not to paint them at all.
fn viewport_visible(v: *mut Viewport, rx: f64, ry: f64, rw: f64,
    rh: f64) -> bool {
    if rx + rw <= (*v).ox || ry + rh <= (*v).oy {
        return false
    }
    if rx >= (*v).ox + viewport_inner_w(v)
    || ry >= (*v).oy + viewport_inner_h(v) {
        return false
    }
    return true
}

// BRING A RECTANGLE INTO THE VIEWPORT. Without that there is no
// keyboard operation in a long list: the selection wanders
// down and disappears, because nobody scrolls along. The rectangle stands in
// CONTENT COORDINATES.
//
// Scrolling is done as little as possible -- if the rectangle lies above,
// it comes to the top edge; if it lies below, to the bottom edge. If
// it is larger than the viewport, the top edge wins: you read from
// the top.
fn viewport_ensure_visible(v: *mut Viewport, rx: f64, ry: f64, rw: f64,
    rh: f64) -> bool {
    let before_x: f64 = (*v).ox
    let before_y: f64 = (*v).oy
    let iw: f64 = viewport_inner_w(v)
    let ih: f64 = viewport_inner_h(v)
    var nx: f64 = (*v).ox
    var ny: f64 = (*v).oy
    if rx + rw > nx + iw {
        nx = rx + rw - iw
    }
    if rx < nx {
        nx = rx
    }
    if ry + rh > ny + ih {
        ny = ry + rh - ih
    }
    if ry < ny {
        ny = ry
    }
    viewport_set_offset(v, nx, ny)
    return (*v).ox != before_x || (*v).oy != before_y
}

// ======================================================================
// THE CUTTING OFF
// ======================================================================
//
// ONE clip, and it comes from lib/paint/canvas.fi. `viewport_begin`
// pushes it onto the stack, `viewport_end` takes it down -- and
// in between anything may be painted: every path of this tree
// writes via canvas_blend / canvas_fill_rect / canvas_fill_raster
// and is caught by it.
//
// The return value is false if the stack is full (16 levels).
// Then NOTHING is painted -- better an empty box than content that
// runs over the edge.
fn viewport_begin(c: *mut render.Ctx, v: *mut Viewport) -> bool {
    let cv: *mut canvas.Canvas = painter.painter_canvas(render.ctx_painter(c))
    // The padding is subtracted here and ONLY here: the position of the
    // content, the bars and the hit test keep calculating with
    // the whole rectangle. If the padding is larger than the viewport,
    // nothing remains -- then clip_push_rect reports
    // false by itself, and the caller paints nothing at all.
    let p: f64 = (*v).pad
    return canvas.clip_push_rect(cv, (*v).x + p, (*v).y + p,
        (*v).x + viewport_inner_w(v) - p, (*v).y + viewport_inner_h(v) - p)
}

fn viewport_end(c: *mut render.Ctx, v: *mut Viewport) {
    canvas.clip_pop(painter.painter_canvas(render.ctx_painter(c)))
}

// ======================================================================
// PAINTING THE BARS
// ======================================================================
//
// Painting is done with wave2.draw_scrollbar, so with THE scrollbar of this
// library. This module only calculates share and position; what a
// scrollbar looks like stands at one place, and that is not here.
// THE WIDGET OF A BAR -- built at ONE place.
//
// The same scrollbar is painted and operated, so it may also be
// assembled only once: rectangle, share (as `pref`) and
// position (as `value`). If painting stood here and grasping
// next to it, picture and operation would have two geometries -- and the
// thumb would lie exactly where you do NOT grasp. `wert` says with
// which position the bar is built: the operation also asks it
// for the ends of its track (0 and VAL_MAX), and that is exactly where
// the travel length of the thumb comes from, without calculating it a second time.
fn bar_widget(v: *mut Viewport, senkrecht: bool,
    value: i64) -> widget.Widget {
    var bx: f64 = 0.0
    var by: f64 = 0.0
    var bw: f64 = 0.0
    var bh: f64 = 0.0
    var e: widget.Widget = widget.widget_new(widget.KIND_SCROLLBAR)
    if senkrecht {
        if !viewport_bar_rect_v(v, &bx, &by, &bw, &bh) {
            return e
        }
        widget.w_place(&e, bx, by, bw, bh)
        widget.w_set_pref(&e, 0.0,
            viewport_share_v(v) * (wave2.VAL_MAX as f64))
        widget.w_set_value(&e, value)
        return e
    }
    if !viewport_bar_rect_h(v, &bx, &by, &bw, &bh) {
        return e
    }
    widget.w_place(&e, bx, by, bw, bh)
    widget.w_set_pref(&e,
        viewport_share_h(v) * (wave2.VAL_MAX as f64), 0.0)
    widget.w_set_value(&e, value)
    return e
}

fn viewport_draw_bars(c: *mut render.Ctx, v: *mut Viewport) {
    if viewport_needs_v(v) {
        var e: widget.Widget = bar_widget(v, true, viewport_value_v(v))
        wave2.draw_scrollbar(c, &e)
    }
    if viewport_needs_h(v) {
        var e: widget.Widget = bar_widget(v, false, viewport_value_h(v))
        wave2.draw_scrollbar(c, &e)
    }
}

// ======================================================================
// OPERATING THE BARS
// ======================================================================
//
// Until here the box could PAINT its bars, and the pointer
// had nothing to do with them: scrolling was possible only with wheel and
// keyboard. That is exactly the half measure that this module was
// written against -- a scrollbar that you cannot grasp is
// a display and no control.
//
// WHAT IS NOT HERE: the geometry of the thumb. It comes piece
// by piece from `wave2.scrollbar_thumb`, so from the same calculation
// that also paints it. Even the TRAVEL LENGTH (how far the thumb
// wanders from top to bottom) is not derived, but ASKED:
// once the position at 0, once at VAL_MAX, the difference
// is the travel. With that the operation cannot deviate at all from what
// stands in the picture -- not even if wave2 changes its padding or
// its minimum length.
fn viewport_bar_hit(v: *mut Viewport, px: f64, py: f64) -> u32 {
    var bx: f64 = 0.0
    var by: f64 = 0.0
    var bw: f64 = 0.0
    var bh: f64 = 0.0
    if viewport_bar_rect_v(v, &bx, &by, &bw, &bh) {
        if px >= bx && px < bx + bw && py >= by && py < by + bh {
            return VP_BAR_V
        }
    }
    if viewport_bar_rect_h(v, &bx, &by, &bw, &bh) {
        if px >= bx && px < bx + bw && py >= by && py < by + bh {
            return VP_BAR_H
        }
    }
    return VP_BAR_NONE
}

// The thumb of a bar as a rectangle -- the same shape that
// `wave2.draw_scrollbar` paints, at the current position.
fn viewport_bar_thumb(c: *mut render.Ctx, v: *mut Viewport,
    dir: u32) -> layout.Rect {
    var value: i64 = viewport_value_h(v)
    if dir == VP_BAR_V {
        value = viewport_value_v(v)
    }
    var e: widget.Widget = bar_widget(v, dir == VP_BAR_V, value)
    return wave2.scrollbar_thumb(c, &e)
}

// THE TRAVEL LENGTH OF THE THUMB, ASKED OF WAVE2. The thumb stands
// at position 0 at the start of the track and at VAL_MAX at its end; what
// lies in between is exactly the distance that a drag can use.
// Splitting it into padding and minimum length itself would be the
// second version of a calculation that already exists.
fn bar_travel(c: *mut render.Ctx, v: *mut Viewport, dir: u32) -> f64 {
    let senkrecht: bool = dir == VP_BAR_V
    var e0: widget.Widget = bar_widget(v, senkrecht, 0)
    var e1: widget.Widget = bar_widget(v, senkrecht, wave2.VAL_MAX)
    var x0: f64 = 0.0
    var y0: f64 = 0.0
    var w0: f64 = 0.0
    var h0: f64 = 0.0
    var x1: f64 = 0.0
    var y1: f64 = 0.0
    var w1: f64 = 0.0
    var h1: f64 = 0.0
    wave2.scrollbar_thumb_f(c, &e0, &x0, &y0, &w0, &h0)
    wave2.scrollbar_thumb_f(c, &e1, &x1, &y1, &w1, &h1)
    if senkrecht {
        return y1 - y0
    }
    return x1 - x0
}

// GRASP A BAR.
//
// Two cases, and both are what every system does:
//
//   * ON THE THUMB a drag begins. Remembered are the point
//     at which it was grasped, and the offset at this
//     moment -- so the grip stays under the pointer, instead of
//     the thumb jumping away from under it.
//   * ON THE TRACK it jumps PAGE BY PAGE: a page is the visible
//     viewport, the same distance as page up/page down. A jump to
//     the pointer position would be the alternative; page by page is
//     the choice that does not let the content be skipped.
//
// Returned is whether the press hit a bar at all --
// the information that a window needs so as not to pass the press on
// to the content as well.
fn viewport_bar_press(c: *mut render.Ctx, v: *mut Viewport, px: f64,
    py: f64) -> bool {
    let dir: u32 = viewport_bar_hit(v, px, py)
    if dir == VP_BAR_NONE {
        return false
    }
    let t: layout.Rect = viewport_bar_thumb(c, v, dir)
    let tx: f64 = layout.rect_x(&t) as f64
    let ty: f64 = layout.rect_y(&t) as f64
    let tw: f64 = layout.rect_w(&t) as f64
    let th: f64 = layout.rect_h(&t) as f64
    if px >= tx && px < tx + tw && py >= ty && py < ty + th {
        fling_stop(v)
        (*v).drag = dir
        if dir == VP_BAR_V {
            (*v).tombstone = py
            (*v).tombstone_off = (*v).oy
        } else {
            (*v).tombstone = px
            (*v).tombstone_off = (*v).ox
        }
        return true
    }
    // The track: one page forward or back, depending on which
    // side of the thumb was pressed.
    if dir == VP_BAR_V {
        if py < ty {
            viewport_scroll_by(v, 0.0, 0.0 - viewport_inner_h(v))
        } else {
            viewport_scroll_by(v, 0.0, viewport_inner_h(v))
        }
        return true
    }
    if px < tx {
        viewport_scroll_by(v, 0.0 - viewport_inner_w(v), 0.0)
    } else {
        viewport_scroll_by(v, viewport_inner_w(v), 0.0)
    }
    return true
}

// THE DRAG. The distance of the pointer is translated to the content with the RATIO
// largest offset / travel length of the thumb -- the same ratio as
// content / track, only without the detour via the length of the thumb
// (tools/fui/viewport_main.fi section 12 calculates both ways
// against each other).
//
// Returned is whether something has moved.
fn viewport_bar_drag(c: *mut render.Ctx, v: *mut Viewport, px: f64,
    py: f64) -> bool {
    if (*v).drag == VP_BAR_NONE {
        return false
    }
    let dir: u32 = (*v).drag
    let weg: f64 = bar_travel(c, v, dir)
    if weg <= 0.0 {
        return false
    }
    if dir == VP_BAR_V {
        let before: f64 = (*v).oy
        let d: f64 = (py - (*v).tombstone) * viewport_max_y(v) / weg
        viewport_set_offset(v, (*v).ox, (*v).tombstone_off + d)
        return (*v).oy != before
    }
    let before: f64 = (*v).ox
    let d: f64 = (px - (*v).tombstone) * viewport_max_x(v) / weg
    viewport_set_offset(v, (*v).tombstone_off + d, (*v).oy)
    return (*v).ox != before
}

// Release. A call of its own, because a box that ends the drag at the
// edge of its track itself would no longer come along when moving back.
fn viewport_bar_release(v: *mut Viewport) {
    (*v).drag = VP_BAR_NONE
}

fn viewport_bar_dragging(v: *mut Viewport) -> u32 { return (*v).drag }
