import std.rt
import fui.painter
import fui.render
import fui.style
import fui.kit
import fui.face
import fui.termpal
import term.termgrid
import term.termstate
import term.termsel
import term.termtext

export { Frame, frame_new, measure_cell, paint_term, enter_mono, leave_mono, PAD, TERM_PX }

const PAD: f64 = 4.0
const TERM_PX: f64 = 14.0
const BAR_W: f64 = 3.0
const BAR_MIN: f64 = 8.0
const BAR_ALPHA: u32 = 140
const BOLD_WEIGHT: usize = 700
const RUN_SPAN: f64 = 2.0

struct Frame {
    ox: f64,
    oy: f64,
    w: f64,
    h: f64,
    cw: f64,
    ch: f64,
    size: f64,
    cols: usize,
    rows: usize,
    view_off: usize,
    focused: bool,
    dark: bool,
    fg: u32,
    bg: u32,
    sel_fg: u32,
    sel_bg: u32,
    cursor: u32,
    cursor_on: bool,
}

fn frame_new() -> Frame {
    return Frame { ox: 0.0, oy: 0.0, w: 0.0, h: 0.0, cw: 8.0, ch: 17.0, size: TERM_PX, cols: 0, rows: 0,
        view_off: 0, focused: true, dark: true, fg: 0 as u32, bg: 0 as u32, sel_fg: 0 as u32, sel_bg: 0 as u32,
        cursor: 0 as u32, cursor_on: true }
}

fn enter_mono(z: *mut painter.Painter) -> u64 {
    let f: u64 = painter.painter_font_slot(z, face.MONO_SLOT)
    if f == 0 { return 0 }
    let old: u64 = painter.painter_font(z)
    painter.painter_set_font(z, f)
    return old
}

fn leave_mono(z: *mut painter.Painter, old: u64) {
    if old != 0 { painter.painter_set_font(z, old) }
}

fn whole(v: f64) -> f64 { return ((v + 0.5) as i64) as f64 }

fn measure_cell(c: *mut render.Ctx, f: *mut Frame) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    let old: u64 = enter_mono(z)
    var r: painter.TextRun = painter.run_new((*f).size)
    r.kerning = 0
    let w: f64 = painter.run_width(z, &r, "M".p as u64, 1)
    let h: f64 = painter.run_line_height(z, &r)
    leave_mono(z, old)
    if w >= 1.0 { (*f).cw = w }
    if h >= 1.0 { (*f).ch = whole(h) }
}

fn load_theme(c: *mut render.Ctx, f: *mut Frame) {
    (*f).fg = kit.tokc(c, style.TOK_TEXT) & 0xFFFFFF as u32
    (*f).bg = kit.tokc(c, style.TOK_FIELD) & 0xFFFFFF as u32
    (*f).sel_fg = kit.tokc(c, style.TOK_SELECTION_TEXT) & 0xFFFFFF as u32
    (*f).sel_bg = kit.tokc(c, style.TOK_SELECTION) & 0xFFFFFF as u32
    (*f).cursor = kit.tokc(c, style.TOK_ACCENT) & 0xFFFFFF as u32
    (*f).dark = termpal.is_dark((*f).bg)
}

fn cell_look(f: *mut Frame, flags: u32, fgw: u32, bgw: u32, selected: bool, fg: *mut u32, bg: *mut u32) {
    var a: u32 = termpal.resolve(fgw, (*f).fg, (*f).dark)
    var b: u32 = termpal.resolve(bgw, (*f).bg, (*f).dark)
    if (flags & termgrid.F_INVERSE) != 0 as u32 {
        let t: u32 = a
        a = b
        b = t
    }
    if (flags & termgrid.F_DIM) != 0 as u32 { a = termpal.blend(a, b) }
    if (flags & termgrid.F_HIDDEN) != 0 as u32 { a = b }
    if selected {
        a = (*f).sel_fg
        b = (*f).sel_bg
    }
    *fg = a
    *bg = b
}

fn col_x(f: *mut Frame, col: usize) -> f64 { return whole((*f).ox + PAD + (col as f64) * (*f).cw) }

fn row_y(f: *mut Frame, row: usize) -> f64 { return (*f).oy + PAD + (row as f64) * (*f).ch }

fn is_selected(s: *mut termsel.Sel, g: *mut termgrid.Grid, line: usize, x: usize) -> bool {
    return termsel.sel_active(s) && termsel.sel_contains(s, g, line, x)
}

fn paint_backgrounds(z: *mut painter.Painter, f: *mut Frame, g: *mut termgrid.Grid, s: *mut termsel.Sel, line: usize, y: usize) {
    var x: usize = 0
    while x < (*f).cols {
        var fg: u32 = 0
        var bg: u32 = 0
        cell_look(f, termgrid.cell_flags(g, line, x), termgrid.cell_fg(g, line, x), termgrid.cell_bg(g, line, x),
            is_selected(s, g, line, x), &fg, &bg)
        var e: usize = x + 1
        while e < (*f).cols {
            var fg2: u32 = 0
            var bg2: u32 = 0
            cell_look(f, termgrid.cell_flags(g, line, e), termgrid.cell_fg(g, line, e), termgrid.cell_bg(g, line, e),
                is_selected(s, g, line, e), &fg2, &bg2)
            if bg2 != bg { break }
            e = e + 1
        }
        if bg != (*f).bg {
            painter.surface(z, col_x(f, x), row_y(f, y), col_x(f, e) - col_x(f, x), (*f).ch, bg)
        }
        x = e
    }
}

fn run_ends(f: *mut Frame, g: *mut termgrid.Grid, s: *mut termsel.Sel, line: usize, x: usize, fg: u32, flags: u32) -> usize {
    var e: usize = x + 1
    while e < (*f).cols {
        let fl: u32 = termgrid.cell_flags(g, line, e)
        if (fl & termgrid.F_WIDE) != 0 as u32 || (fl & termgrid.F_TAIL) != 0 as u32 { break }
        if (fl & (termgrid.F_BOLD | termgrid.F_ITALIC)) != (flags & (termgrid.F_BOLD | termgrid.F_ITALIC)) { break }
        var fg2: u32 = 0
        var bg2: u32 = 0
        cell_look(f, fl, termgrid.cell_fg(g, line, e), termgrid.cell_bg(g, line, e), is_selected(s, g, line, e), &fg2, &bg2)
        if fg2 != fg { break }
        e = e + 1
    }
    return e
}

fn draw_run(z: *mut painter.Painter, f: *mut Frame, g: *mut termgrid.Grid, line: usize, y: usize, x: usize, e: usize, fg: u32, flags: u32) {
    var b: rt.Buf = rt.buf_new()
    var any: bool = false
    var i: usize = x
    while i < e {
        var cp: u32 = termgrid.cell_cp(g, line, i)
        if cp == 0 as u32 { cp = 32 as u32 } else { any = true }
        termtext.push_cp(&b, cp)
        i = i + 1
    }
    if any {
        var r: painter.TextRun = painter.run_new((*f).size)
        r.kerning = 0
        if (flags & termgrid.F_BOLD) != 0 as u32 { r.weight = BOLD_WEIGHT }
        if (flags & termgrid.F_ITALIC) != 0 as u32 { r.slant = 1 }
        let base: f64 = painter.text_baseline_mid(z, row_y(f, y), (*f).ch, (*f).size)
        painter.run_draw(z, &r, col_x(f, x), base, ((e - x) as f64 + RUN_SPAN) * (*f).cw, fg, rt.buf_ptr(&b), rt.buf_len(&b), painter.TEXT_L)
    }
    rt.buf_free(&b)
}

fn draw_lines_of(z: *mut painter.Painter, f: *mut Frame, x: usize, e: usize, y: usize, fg: u32, flags: u32) {
    if (flags & termgrid.F_UNDERLINE) != 0 as u32 {
        painter.surface(z, col_x(f, x), row_y(f, y) + (*f).ch - 2.0, col_x(f, e) - col_x(f, x), 1.0, fg)
    }
    if (flags & termgrid.F_STRIKE) != 0 as u32 {
        painter.surface(z, col_x(f, x), row_y(f, y) + (*f).ch / 2.0, col_x(f, e) - col_x(f, x), 1.0, fg)
    }
}

fn paint_texts(z: *mut painter.Painter, f: *mut Frame, g: *mut termgrid.Grid, s: *mut termsel.Sel, line: usize, y: usize) {
    var x: usize = 0
    while x < (*f).cols {
        let flags: u32 = termgrid.cell_flags(g, line, x)
        if (flags & termgrid.F_TAIL) != 0 as u32 {
            x = x + 1
            continue
        }
        var fg: u32 = 0
        var bg: u32 = 0
        cell_look(f, flags, termgrid.cell_fg(g, line, x), termgrid.cell_bg(g, line, x), is_selected(s, g, line, x), &fg, &bg)
        var e: usize = x + 1
        if (flags & termgrid.F_WIDE) != 0 as u32 {
            e = x + 2
        } else {
            e = run_ends(f, g, s, line, x, fg, flags)
        }
        if e > (*f).cols { e = (*f).cols }
        draw_run(z, f, g, line, y, x, e, fg, flags)
        draw_lines_of(z, f, x, e, y, fg, flags)
        x = e
    }
}

fn paint_cursor(z: *mut painter.Painter, f: *mut Frame, t: *mut termstate.Term, first: usize) {
    let g: *mut termgrid.Grid = termstate.cur(t)
    if !(*t).cursor_visible || (*g).cx >= (*f).cols { return }
    if (*f).focused && !(*f).cursor_on { return }
    let line: usize = (*g).sb_len + (*g).cy
    if line < first || line - first >= (*f).rows { return }
    let y: usize = line - first
    let x: usize = (*g).cx
    let px: f64 = col_x(f, x)
    let py: f64 = row_y(f, y)
    if (*f).focused {
        painter.surface(z, px, py, (*f).cw, (*f).ch, (*f).cursor)
        draw_run(z, f, g, line, y, x, x + 1, (*f).bg, 0 as u32)
        return
    }
    painter.surface(z, px, py, (*f).cw, 1.0, (*f).cursor)
    painter.surface(z, px, py + (*f).ch - 1.0, (*f).cw, 1.0, (*f).cursor)
    painter.surface(z, px, py, 1.0, (*f).ch, (*f).cursor)
    painter.surface(z, px + (*f).cw - 1.0, py, 1.0, (*f).ch, (*f).cursor)
}

fn paint_bar(c: *mut render.Ctx, z: *mut painter.Painter, f: *mut Frame, g: *mut termgrid.Grid, first: usize) {
    let total: usize = termgrid.abs_lines(g)
    if (*g).sb_len == 0 || (*f).view_off == 0 { return }
    let track: f64 = (*f).h - PAD * 2.0
    var thumb: f64 = track * ((*f).rows as f64) / (total as f64)
    if thumb < BAR_MIN { thumb = BAR_MIN }
    let top: f64 = (*f).oy + PAD + (track - thumb) * (first as f64) / (((*g).sb_len) as f64)
    let col: u32 = kit.with_alpha(kit.tokc(c, style.TOK_TEXT_MUTED), BAR_ALPHA)
    painter.surface(z, (*f).ox + (*f).w - BAR_W - 1.0, top, BAR_W, thumb, col)
}

fn paint_term(c: *mut render.Ctx, f: *mut Frame, t: *mut termstate.Term, s: *mut termsel.Sel) {
    let z: *mut painter.Painter = render.ctx_painter(c)
    load_theme(c, f)
    painter.surface(z, (*f).ox, (*f).oy, (*f).w, (*f).h, (*f).bg)
    let g: *mut termgrid.Grid = termstate.cur(t)
    let old: u64 = enter_mono(z)
    let first: usize = (*g).sb_len - (*f).view_off
    var y: usize = 0
    while y < (*f).rows && first + y < termgrid.abs_lines(g) {
        paint_backgrounds(z, f, g, s, first + y, y)
        paint_texts(z, f, g, s, first + y, y)
        y = y + 1
    }
    paint_cursor(z, f, t, first)
    leave_mono(z, old)
    paint_bar(c, z, f, g, first)
}
