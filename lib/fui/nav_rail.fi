// lib/fui/nav_rail.fi -- app rail model: entries, badges, active entry, hidden or grey entries. No drawing.
import fui.cmdbar

export {
    RailItem, Rail,
    NR_ON, NR_GREY, NR_HIDDEN, NR_MAX, NR_NONE,
    nrail_new, nrail_add, nrail_find, nrail_set_state, nrail_set_badge, nrail_activate,
    nrail_active, nrail_active_id, nrail_next, nrail_visible_count, nrail_visible_at,
    nrail_total_badge, nrail_badge_text, nrail_fit, nrail_item_y, nrail_hit, nrail_tabs,
}

const NR_ON: u32 = 0
const NR_GREY: u32 = 1
const NR_HIDDEN: u32 = 2
const NR_MAX: usize = 12
const NR_NONE: usize = 0xFFFFFFFF

struct RailItem {
    id: str,
    label: str,
    icon: i64,
    badge: u32,
    state: u32,
}

struct Rail {
    it: [RailItem; 12],
    n: usize,
    active: usize,
}

fn blank() -> RailItem {
    return RailItem { id: "", label: "", icon: 0 as i64, badge: 0 as u32, state: NR_ON }
}

fn same(a: str, b: str) -> bool {
    if a.n != b.n { return false }
    var i: usize = 0
    while i < a.n {
        if *((a.p as u64 + i as u64) as *mut u8) != *((b.p as u64 + i as u64) as *mut u8) { return false }
        i = i + 1
    }
    return true
}

fn nrail_new() -> Rail {
    return Rail { it: [blank(); 12], n: 0, active: NR_NONE }
}

fn nrail_find(r: *mut Rail, id: str) -> usize {
    var i: usize = 0
    while i < (*r).n {
        if same((*r).it[i].id, id) { return i }
        i = i + 1
    }
    return NR_NONE
}

fn nrail_add(r: *mut Rail, id: str, label: str, icon: i64) -> usize {
    if (*r).n >= NR_MAX || id.n == 0 || nrail_find(r, id) != NR_NONE { return NR_NONE }
    let at: usize = (*r).n
    (*r).it[at] = RailItem { id: id, label: label, icon: icon, badge: 0 as u32, state: NR_ON }
    (*r).n = at + 1
    if (*r).active == NR_NONE { (*r).active = at }
    return at
}

fn nrail_next(r: *mut Rail, from: usize, dir: i32) -> usize {
    if (*r).n == 0 { return NR_NONE }
    var i: usize = from
    var k: usize = 0
    while k < (*r).n {
        if dir >= 0 { i = (i + 1) % (*r).n } else { i = (i + (*r).n - 1) % (*r).n }
        if (*r).it[i].state == NR_ON { return i }
        k = k + 1
    }
    return NR_NONE
}

fn nrail_set_state(r: *mut Rail, id: str, state: u32) -> bool {
    let i: usize = nrail_find(r, id)
    if i == NR_NONE || state > NR_HIDDEN { return false }
    (*r).it[i].state = state
    if (*r).active == i && state != NR_ON {
        (*r).active = nrail_next(r, i, 1)
    }
    if (*r).active == NR_NONE {
        var j: usize = 0
        while j < (*r).n {
            if (*r).it[j].state == NR_ON {
                (*r).active = j
                return true
            }
            j = j + 1
        }
    }
    return true
}

fn nrail_set_badge(r: *mut Rail, id: str, n: u32) -> bool {
    let i: usize = nrail_find(r, id)
    if i == NR_NONE { return false }
    (*r).it[i].badge = n
    return true
}

fn nrail_activate(r: *mut Rail, id: str) -> bool {
    let i: usize = nrail_find(r, id)
    if i == NR_NONE || (*r).it[i].state != NR_ON { return false }
    (*r).active = i
    return true
}

fn nrail_active(r: *mut Rail) -> usize { return (*r).active }

fn nrail_active_id(r: *mut Rail) -> str {
    if (*r).active == NR_NONE { return "" }
    return (*r).it[(*r).active].id
}

fn nrail_visible_count(r: *mut Rail) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < (*r).n {
        if (*r).it[i].state != NR_HIDDEN { n = n + 1 }
        i = i + 1
    }
    return n
}

fn nrail_visible_at(r: *mut Rail, k: usize) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < (*r).n {
        if (*r).it[i].state != NR_HIDDEN {
            if n == k { return i }
            n = n + 1
        }
        i = i + 1
    }
    return NR_NONE
}

fn nrail_total_badge(r: *mut Rail) -> u32 {
    var t: u32 = 0 as u32
    var i: usize = 0
    while i < (*r).n {
        if (*r).it[i].state == NR_ON { t = t + (*r).it[i].badge }
        i = i + 1
    }
    return t
}

fn nrail_badge_text(n: u32, out: u64, cap: usize) -> usize {
    if cap < 5 { return 0 }
    var at: usize = 0
    if n == (0 as u32) {
        *(out as *mut u8) = 0 as u8
        return 0
    }
    if n > (99 as u32) {
        *(out as *mut u8) = 57 as u8
        *((out + 1) as *mut u8) = 57 as u8
        *((out + 2) as *mut u8) = 43 as u8
        *((out + 3) as *mut u8) = 0 as u8
        return 3
    }
    if n >= (10 as u32) {
        *(out as *mut u8) = 48 as u8 + (n / (10 as u32)) as u8
        at = 1
    }
    *((out + at as u64) as *mut u8) = 48 as u8 + (n % (10 as u32)) as u8
    *((out + at as u64 + 1) as *mut u8) = 0 as u8
    return at + 1
}

fn nrail_fit(r: *mut Rail, avail: u64, item: u64, gap: u64) -> usize {
    var seps: [u8; 12] = [0 as u8; 12]
    return cmdbar.fit_count(nrail_visible_count(r) as u64, (&seps[0]) as u64, avail, item, gap, 0) as usize
}

fn nrail_item_y(k: usize, top: i32, item: i32, gap: i32) -> i32 {
    return top + (k as i32) * (item + gap)
}

fn nrail_hit(r: *mut Rail, y: i32, top: i32, item: i32, gap: i32, avail: i32) -> usize {
    if y < top || item <= 0 { return NR_NONE }
    let rel: i32 = y - top
    let k: i32 = rel / (item + gap)
    if rel - k * (item + gap) >= item { return NR_NONE }
    let shown: usize = nrail_fit(r, avail as u64, item as u64, gap as u64)
    if (k as usize) >= shown { return NR_NONE }
    return nrail_visible_at(r, k as usize)
}

fn nrail_tabs(r: *mut Rail, max: usize, out: *mut usize) -> usize {
    let vis: usize = nrail_visible_count(r)
    var n: usize = vis
    if vis > max { n = max - 1 }
    var k: usize = 0
    while k < n {
        *((out as u64 + (k * 8) as u64) as *mut usize) = nrail_visible_at(r, k)
        k = k + 1
    }
    return n
}
