// SPDX-License-Identifier: MPL-2.0
import fui.kit
import fui.kitapp
import fui.kitcolor
import fui.kitdata
import fui.kitfmt
import fui.kitunit
import fui.kittabs
import fui.painter
import fui.render
import fui.screenax
import fui.widget
import fui.style
import fui.theme

export { Seg, Page, Box, skin, seg_new, seg_hit, seg_draw, page, head_draw, kpi_row, card_body, table_card }

struct Seg {
    n: usize,
    on: usize,
    x0: f64,
    y0: f64,
    h: f64,
    edge: [f64; 10],
}

struct Box {
    x: f64,
    y: f64,
    w: f64,
    h: f64,
}

struct Page {
    m: f64,
    gap: f64,
    hy: f64,
    hh: f64,
    ky: f64,
    kh: f64,
    y1: f64,
    h1: f64,
    y2: f64,
    h2: f64,
    wide: f64,
    narrow: f64,
    compact: bool,
    kcols: usize,
    kpitch: f64,
    sy: f64,
    sh: f64,
    ch: f64,
    rev: Box,
    src: Box,
    ord: Box,
    evt: Box,
}

fn skin(m: *mut theme.Theme, dark: bool) {
    let f: *mut theme.Colors = theme.theme_colors(m)
    if dark {
        accent(m, 0x6c8cff as u32)
        (*f).base = 0x080b14 as u32
        (*f).surface = 0x0f1424 as u32
        (*f).surface_raised = 0x171e36 as u32
        (*f).border_col = 0x212635 as u32
        (*f).separator = 0x212635 as u32
        (*f).text = 0xeef1fa as u32
        (*f).text_muted = 0xaab2ce as u32
        (*f).text_disabled = 0x6b7392 as u32
    } else {
        accent(m, 0x4a6ef0 as u32)
        (*f).base = 0xf2f4fa as u32
        (*f).surface = 0xffffff as u32
        (*f).surface_raised = 0xeef1f8 as u32
        (*f).border_col = 0xe7e8eb as u32
        (*f).separator = 0xe7e8eb as u32
        (*f).text = 0x10152a as u32
        (*f).text_muted = 0x454d6b as u32
        (*f).text_disabled = 0x8089a6 as u32
    }
    (*f).text_on_accent = 0xffffff as u32
    (*f).success = 0x16a35b as u32
    (*f).err_col = 0xe03a5e as u32
    if dark {
        (*f).success = 0x3ddc84 as u32
        (*f).err_col = 0xff6b8a as u32
    }
}

fn accent(m: *mut theme.Theme, rgb: u32) {
    kitcolor.set_accent(rgb)
    theme.theme_set_accent(m, rgb)
}

fn tok(c: *mut render.Ctx, t: u32) -> u32 {
    return kit.tokc(c, t)
}

fn seg_new() -> Seg {
    return Seg { n: 0, on: 0, x0: 0.0, y0: 0.0, h: 0.0, edge: [0.0; 10] }
}

fn seg_hit(sg: *mut Seg, x: f64, y: f64) -> i64 {
    if x < (*sg).x0 || x >= (*sg).edge[(*sg).n] || y < (*sg).y0 || y >= (*sg).y0 + (*sg).h { return 0 - 1 }
    var i: usize = 0
    while i < (*sg).n {
        if x < (*sg).edge[i + 1] { return i as i64 }
        i = i + 1
    }
    return 0 - 1
}

fn seg_total(c: *mut render.Ctx, d: *mut kitdata.Doc, list: u32, n: usize) -> f64 {
    var total: f64 = kit.ln(c, 3) * 2.0 + kit.ln(c, 2)
    var i: usize = 0
    while i < n {
        total = total + kit.text_width(c, kit.ln(c, 13), 700, kitdata.text(d, kitdata.at(d, list, i))) + kit.ln(c, 32)
        i = i + 1
    }
    return total
}

fn seg_body(c: *mut render.Ctx, sg: *mut Seg, d: *mut kitdata.Doc, list: u32, xr: f64, y: f64, room: f64, n: usize) {
    let pad: f64 = kit.ln(c, 3)
    let bh: f64 = kit.ln(c, 27)
    let total: f64 = seg_total(c, d, list, n)
    let h: f64 = bh + pad * 2.0 + kit.ln(c, 2)
    let x0: f64 = xr - total
    let y0: f64 = y + (room - h) / 2.0
    (*sg).n = n
    (*sg).x0 = x0
    (*sg).y0 = y0
    (*sg).h = h
    let z: *mut painter.Painter = render.ctx_painter(c)
    painter.round_rect(z, x0, y0, total, h, kit.ln(c, 10), tok(c, style.TOK_BORDER))
    painter.round_rect(z, x0 + 1.0, y0 + 1.0, total - 2.0, h - 2.0, kit.ln(c, 10), tok(c, style.TOK_SURFACE))
    var bx: f64 = x0 + 1.0 + pad
    var i: usize = 0
    while i < n {
        let s: str = kitdata.text(d, kitdata.at(d, list, i))
        let tw: f64 = kit.text_width(c, kit.ln(c, 13), 700, s)
        let bw: f64 = tw + kit.ln(c, 32)
        (*sg).edge[i] = bx - pad - 1.0
        var col: u32 = tok(c, style.TOK_TEXT_MUTED)
        if i == (*sg).on {
            painter.round_rect(z, bx, y0 + 1.0 + pad, bw, bh, kit.ln(c, 7), kit.accent_gfx(c, style.TOK_SURFACE))
            col = tok(c, style.TOK_TEXT_ON_ACCENT)
        }
        kit.draw_label(c, bx + kit.ln(c, 16), y0 + 1.0 + pad, bh, kit.ln(c, 13), 700, col, s, 0.0)
        bx = bx + bw
        i = i + 1
    }
    (*sg).edge[n] = x0 + total
}

fn seg_draw(c: *mut render.Ctx, sg: *mut Seg, d: *mut kitdata.Doc, list: u32, xr: f64, y: f64, room: f64) {
    let n: usize = kitdata.count(d, list)
    var sum: f64 = 0.0
    var i: usize = 0
    while i < n {
        sum = sum + kitunit.text_sum(kitdata.text(d, kitdata.at(d, list, i))) * ((i + 1) as f64)
        i = i + 1
    }
    let aux: u64 = kitunit.ink(tok(c, style.TOK_BORDER), tok(c, style.TOK_SURFACE), tok(c, style.TOK_TEXT_MUTED), tok(c, style.TOK_TEXT_ON_ACCENT), kit.accent_gfx(c, style.TOK_SURFACE))
    var nums: [f64; 8] = [xr, y, room, ((*sg).on as f64) + kit.ln(c, 1) * 4096.0, sum, 0.0, 0.0, 0.0]
    let reach: f64 = kit.ln(c, 420)
    let m: f64 = kit.ln(c, 6)
    if !kitunit.begin(c, 10, aux, &nums, xr - reach, y - m, xr + m, y + room + m) {
        seg_body(c, sg, d, list, xr, y, room, n)
        if (*sg).x0 >= xr - reach + 2.0 && (*sg).y0 >= y - m && (*sg).y0 + (*sg).h <= y + room + m { kitunit.end(c) } else { kitunit.abort() }
    }
}

fn page(c: *mut render.Ctx, w: f64, h: f64, head_h: f64, kpi_h: f64, f1: f64, f2: f64, scroll: f64) -> Page {
    if kittabs.compact(c, w) { return page_compact(c, w, scroll) }
    let m: f64 = kit.ln(c, 28)
    let gap: f64 = kit.ln(c, 14)
    let row: f64 = kit.ln(c, 16)
    let hy: f64 = kit.ln(c, 22)
    let ky: f64 = hy + head_h + row
    let y1: f64 = ky + kpi_h + row
    let avail: f64 = h - hy - y1 - row
    let h1: f64 = avail * f1 / (f1 + f2)
    let cw: f64 = w - m * 2.0
    let wide: f64 = (cw - gap) * 2.0 / 3.0
    let narrow: f64 = cw - gap - wide
    let y2: f64 = y1 + h1 + row
    let h2: f64 = avail - h1
    let sx: f64 = m + wide + gap
    return Page { m: m, gap: gap, hy: hy, hh: head_h, ky: ky, kh: kpi_h, y1: y1, h1: h1, y2: y2, h2: h2, wide: wide, narrow: narrow,
        compact: false, kcols: 0, kpitch: 0.0, sy: hy, sh: head_h, ch: h,
        rev: Box { x: m, y: y1, w: wide, h: h1 }, src: Box { x: sx, y: y1, w: narrow, h: h1 },
        ord: Box { x: m, y: y2, w: wide, h: h2 }, evt: Box { x: sx, y: y2, w: narrow, h: h2 } }
}

fn page_compact(c: *mut render.Ctx, w: f64, scroll: f64) -> Page {
    let m: f64 = kit.ln(c, 16)
    let gap: f64 = kit.ln(c, 10)
    let row: f64 = kit.ln(c, 12)
    let hy: f64 = kit.ln(c, 16) - scroll
    let sh: f64 = kit.ln(c, 35)
    let head_h: f64 = kit.ln(c, 46) + sh
    let kh: f64 = kit.ln(c, 88)
    let kpitch: f64 = kh + gap
    let ky: f64 = hy + head_h + row
    let y1: f64 = ky + kpitch * 2.0 - gap + row
    let cw: f64 = w - m * 2.0
    let h1: f64 = kit.ln(c, 200)
    let h2: f64 = kit.ln(c, 180)
    let h3: f64 = kit.ln(c, 150)
    let h4: f64 = kit.ln(c, 236)
    let y2: f64 = y1 + h1 + row
    let y3: f64 = y2 + h2 + row
    let y4: f64 = y3 + h3 + row
    return Page { m: m, gap: gap, hy: hy, hh: head_h, ky: ky, kh: kh, y1: y1, h1: h1, y2: y2, h2: h2, wide: cw, narrow: cw,
        compact: true, kcols: 2, kpitch: kpitch, sy: hy + kit.ln(c, 46), sh: sh, ch: y4 + h4 + m + scroll,
        rev: Box { x: m, y: y1, w: cw, h: h1 }, src: Box { x: m, y: y3, w: cw, h: h3 },
        ord: Box { x: m, y: y2, w: cw, h: h2 }, evt: Box { x: m, y: y4, w: cw, h: h4 } }
}

fn head_draw(c: *mut render.Ctx, sg: *mut Seg, d: *mut kitdata.Doc, ranges: u32, p: Page, w: f64, title: str, sub: str) {
    screenax.note(widget.KIND_LABEL, screenax.F_HEADING, title, p.m, p.hy, kit.ln(c, 300), kit.ln(c, 26), 0)
    let aux: u64 = kitunit.ink(tok(c, style.TOK_TEXT), tok(c, style.TOK_TEXT_DISABLED), 0 as u32, 0 as u32, 0 as u32)
    var nums: [f64; 8] = [p.m, p.hy, kit.ln(c, 1), 0.0, kitunit.text_sum(title), kitunit.text_sum(sub), 0.0, 0.0]
    let reach: f64 = kit.ln(c, 400)
    let m: f64 = kit.ln(c, 4)
    if !kitunit.begin(c, 9, aux, &nums, p.m - m, p.hy - m, p.m + reach, p.hy + kit.ln(c, 40) + m) {
        let tw: f64 = kit.draw_label(c, p.m, p.hy, kit.ln(c, 26), kit.ln(c, 22), 700, tok(c, style.TOK_TEXT), title, 0.0)
        let sw: f64 = kit.draw_label(c, p.m, p.hy + kit.ln(c, 25), kit.ln(c, 15), kit.ln(c, 12) + 0.5, 400, tok(c, style.TOK_TEXT_DISABLED), sub, 0.0)
        if tw <= reach && sw <= reach { kitunit.end(c) } else { kitunit.abort() }
    }
    seg_draw(c, sg, d, ranges, w - p.m, p.sy, p.sh)
}

fn snap(v: f64) -> f64 {
    return ((v + 0.5) as i64) as f64
}

fn snapped(x: f64, y: f64, w: f64, h: f64) -> Box {
    return Box { x: snap(x), y: snap(y), w: snap(x + w) - snap(x), h: snap(y + h) - snap(y) }
}

fn card_ink(c: *mut render.Ctx) -> u32 {
    return kitapp.col(c, style.TOK_SURFACE)
}

fn card_body(c: *mut render.Ctx, x0: f64, y0: f64, w0: f64, h0: f64, title: str) -> Box {
    let s: Box = snapped(x0, y0, w0, h0)
    let x: f64 = s.x
    let y: f64 = s.y
    let w: f64 = s.w
    let h: f64 = s.h
    let px: f64 = kit.ln(c, 18) + 1.0
    let top: f64 = kit.ln(c, 16) + 1.0
    screenax.note(widget.KIND_LABEL, screenax.F_HEADING, title, x + px, y + top, w - px * 2.0, kit.ln(c, 16), 0)
    let aux: u64 = kitunit.ink(card_ink(c), kitapp.col(c, style.TOK_SEPARATOR), tok(c, style.TOK_TEXT), 0 as u32, 0 as u32)
    var nums: [f64; 8] = [x, y, w, h, kitunit.text_sum(title) + kit.ln(c, 1) * 1048576.0, 0.0, 0.0, 0.0]
    if !kitunit.begin(c, 8, aux, &nums, x - 2.0, y - 2.0, x + w + 2.0, y + h + 2.0) {
        kitapp.card_r_plain(c, x, y, w, h, kit.ln(c, 14), style.TOK_SURFACE)
        let tw: f64 = kit.draw_label(c, x + px, y + top, kit.ln(c, 16), kit.ln(c, 13) + 0.5, 700, tok(c, style.TOK_TEXT), title, 0.0)
        if px + tw <= w { kitunit.end(c) } else { kitunit.abort() }
    }
    let used: f64 = top + kit.ln(c, 16) + kit.ln(c, 10)
    return Box { x: x + px, y: y + used, w: w - px * 2.0, h: h - used - kit.ln(c, 16) - 1.0 }
}

fn value_text(d: *mut kitdata.Doc, k: u32) -> str {
    let v: f64 = kitdata.float(d, kitdata.get(d, k, "value"))
    let unit: str = kitdata.text(d, kitdata.get(d, k, "unit"))
    if unit.n == 1 { return kitfmt.join(kitfmt.dec(v, 1), unit) }
    if unit.n == 3 { return kitfmt.join("€", kitfmt.uint(v as u64, true)) }
    return kitfmt.uint(v as u64, true)
}

fn kpi_body(c: *mut render.Ctx, s: Box, name: str, value: str, delta: f64) -> bool {
    let x: f64 = s.x
    let y: f64 = s.y
    kitapp.card_r_plain(c, s.x, s.y, s.w, s.h, kit.ln(c, 14), style.TOK_SURFACE)
    let px: f64 = x + kit.ln(c, 18) + 1.0
    var r: painter.TextRun = painter.run_set_tracking(painter.run_new(render.tsz(c, kit.ln(c, 11))), kit.ln(c, 11) * 0.06)
    let z: *mut painter.Painter = render.ctx_painter(c)
    let up: str = kitfmt.upper(name)
    let nw: f64 = painter.run_width(z, &r, up.p as u64, name.n)
    painter.run_draw(z, &r, px, painter.text_baseline_mid(z, y + kit.ln(c, 17), kit.ln(c, 13), render.tsz(c, kit.ln(c, 11))), 0.0, tok(c, style.TOK_TEXT_DISABLED), up.p as u64, name.n, painter.TEXT_L)
    let vw: f64 = kit.draw_label(c, px, y + kit.ln(c, 34), kit.ln(c, 30), kit.ln(c, 26), 700, tok(c, style.TOK_TEXT), value, 0.0)
    var col: u32 = tok(c, style.TOK_SUCCESS)
    var mark: str = "▲ "
    var a: f64 = delta
    if delta < 0.0 {
        col = tok(c, style.TOK_ERROR)
        mark = "▼ "
        a = 0.0 - delta
    }
    let dw: f64 = kit.draw_label(c, px, y + kit.ln(c, 68), kit.ln(c, 15), kit.ln(c, 13), 400, col, kitfmt.join3(mark, kitfmt.dec(a, 1), "%"), 0.0)
    var wide: f64 = nw
    if vw > wide { wide = vw }
    if dw > wide { wide = dw }
    return px + wide <= x + s.w
}

fn kpi_draw(c: *mut render.Ctx, x0: f64, y0: f64, w0: f64, h0: f64, name: str, value: str, delta: f64) {
    let s: Box = snapped(x0, y0, w0, h0)
    var dtxt: str = "Down "
    var da: f64 = 0.0 - delta
    if delta >= 0.0 {
        dtxt = "Up "
        da = delta
    }
    screenax.note_join(widget.KIND_LABEL, 0 as u32, name, kitfmt.join3(value, ", ", kitfmt.join3(dtxt, kitfmt.dec(da, 1), "%")), s.x, s.y, s.w, s.h, 0)
    var trend: u32 = tok(c, style.TOK_SUCCESS)
    if delta < 0.0 { trend = tok(c, style.TOK_ERROR) }
    let aux: u64 = kitunit.ink(card_ink(c), kitapp.col(c, style.TOK_SEPARATOR), tok(c, style.TOK_TEXT_DISABLED), tok(c, style.TOK_TEXT), trend)
    var nums: [f64; 8] = [s.x, s.y, s.w, s.h, delta, kitunit.text_sum(name) + kitunit.text_sum(value) * 1048576.0, kit.ln(c, 1), 0.0]
    if !kitunit.begin(c, 11, aux, &nums, s.x - 2.0, s.y - 2.0, s.x + s.w + 2.0, s.y + s.h + 2.0) {
        if kpi_body(c, s, name, value, delta) { kitunit.end(c) } else { kitunit.abort() }
    }
}

fn kpi_row(c: *mut render.Ctx, d: *mut kitdata.Doc, list: u32, p: Page, w: f64) {
    let n: usize = kitdata.count(d, list)
    if n == 0 { return }
    var cols: usize = p.kcols
    if cols == 0 { cols = n }
    let cw: f64 = (w - p.m * 2.0 - p.gap * ((cols - 1) as f64)) / (cols as f64)
    var i: usize = 0
    while i < n {
        let k: u32 = kitdata.at(d, list, i)
        kpi_draw(c, p.m + (cw + p.gap) * ((i % cols) as f64), p.ky + p.kpitch * ((i / cols) as f64), cw, p.kh, kitdata.text(d, kitdata.get(d, k, "name")), value_text(d, k), kitdata.float(d, kitdata.get(d, k, "delta_pct")))
        i = i + 1
    }
}

fn widest(c: *mut render.Ctx, d: *mut kitdata.Doc, list: u32, key: str, from: usize, len: usize, size: f64) -> f64 {
    var m: f64 = 0.0
    var i: usize = 0
    while i < kitdata.count(d, list) {
        let s: str = kitfmt.slice(kitdata.text(d, kitdata.get(d, kitdata.at(d, list, i), key)), from, len)
        let w: f64 = kit.text_width(c, size, 400, s)
        if w > m { m = w }
        i = i + 1
    }
    return m
}

fn row_texts(d: *mut kitdata.Doc, e: u32, k1: str, from: usize, len: usize, k2: str, out: *mut [f64; 2]) {
    (*out)[0] = kitunit.text_sum(kitfmt.slice(kitdata.text(d, kitdata.get(d, e, k1)), from, len))
    (*out)[1] = kitunit.text_sum(kitdata.text(d, kitdata.get(d, e, k2)))
}

fn table_rows(c: *mut render.Ctx, b: Box, d: *mut kitdata.Doc, list: u32, k1: str, from: usize, len: usize, k2: str, count: usize) -> bool {
    let size: f64 = kit.ln(c, 12)
    let w1: f64 = widest(c, d, list, k1, from, len, size) + kit.ln(c, 10)
    let w2: f64 = widest(c, d, list, k2, 0, 200, size)
    var col2: f64 = b.w * w1 / (w1 + w2)
    if col2 < w1 { col2 = w1 }
    let rh: f64 = kit.ln(c, 24)
    let z: *mut painter.Painter = render.ctx_painter(c)
    var i: usize = 0
    while i < count {
        let e: u32 = kitdata.at(d, list, i)
        let ry: f64 = b.y + rh * (i as f64)
        kit.draw_label(c, b.x, ry, rh - 1.0, size, 400, tok(c, style.TOK_TEXT_DISABLED), kitfmt.slice(kitdata.text(d, kitdata.get(d, e, k1)), from, len), 0.0)
        kit.draw_label(c, b.x + col2, ry, rh - 1.0, size, 400, tok(c, style.TOK_TEXT_MUTED), kitdata.text(d, kitdata.get(d, e, k2)), b.w - col2)
        painter.surface(z, b.x, ry + rh - 1.0, b.w, 1.0, tok(c, style.TOK_SEPARATOR))
        i = i + 1
    }
    return w1 <= b.w
}

fn table_card(c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, title: str, d: *mut kitdata.Doc, list: u32, k1: str, from: usize, len: usize, k2: str) {
    let b: Box = card_body(c, x, y, w, h, title)
    let rh: f64 = kit.ln(c, 24)
    var count: usize = 0
    var s1: f64 = 0.0
    var s2: f64 = 0.0
    var t: [f64; 2] = [0.0, 0.0]
    while count < kitdata.count(d, list) && b.y + (count as f64 + 1.0) * rh <= y + h - kit.ln(c, 10) {
        row_texts(d, kitdata.at(d, list, count), k1, from, len, k2, &t)
        s1 = s1 + t[0] * ((count + 1) as f64)
        s2 = s2 + t[1] * ((count + 1) as f64)
        count = count + 1
    }
    let aux: u64 = kitunit.ink(tok(c, style.TOK_TEXT_DISABLED), tok(c, style.TOK_TEXT_MUTED), tok(c, style.TOK_SEPARATOR), 0 as u32, 0 as u32)
    var nums: [f64; 8] = [b.x, b.y, b.w, rh, s1, s2, (count as f64) + kit.ln(c, 1) * 4096.0, 0.0]
    if !kitunit.begin(c, 12, aux, &nums, b.x - 2.0, b.y - 2.0, b.x + b.w + 2.0, b.y + rh * (count as f64) + 2.0) {
        if table_rows(c, b, d, list, k1, from, len, k2, count) { kitunit.end(c) } else { kitunit.abort() }
    }
}
