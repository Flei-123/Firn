import fui.scene
import fui.widget
import fui.a11y
import fui.webview

export { wax_document }

fn wax_document(sc: *mut scene.Scene, ax: *mut a11y.A11y, parent: usize, wv: *mut webview.WebView, label: str) -> usize {
    let n: usize = scene.scene_add(sc, parent, scene.N_WIDGET)
    if n == scene.SCENE_NONE {
        return n
    }
    scene.node_set_widget_kind(sc, n, widget.KIND_TILE)
    widget.w_set_focus(scene.node_widget(sc, n), webview.webview_focused(wv))
    a11y.a11y_set_role(ax, n, a11y.ROLE_DOCUMENT)
    var name: str = webview.webview_title(wv)
    if name.n == 0 {
        name = label
    }
    a11y.a11y_set_name(ax, n, name.p as u64, name.n)
    let hover: str = webview.webview_hover(wv)
    if hover.n > 0 {
        a11y.a11y_set_description(ax, n, hover.p as u64, hover.n)
    }
    return n
}
