// SPDX-License-Identifier: MPL-2.0
// lib/fui/icon.fi -- THE MARKS THAT CONTROLS NEED.
//
// ========================================================= WHY IT EXISTS
//
// Wave 2 brings fifteen widgets, and almost every one of them needs a
// small mark: the tick in the checkbox, the dot in the radio button,
// the triangle of the dropdown, the arrows of the scrollbar, the cross
// on the tab.
//
// THE TRAP THIS AVOIDS IS ON RECORD: in OrientOS the same drawing of
// the window buttons went silently missing TWICE, because it was
// rebuilt in a second place. A tick that looks different in the
// checkbox than in the menu is the same mistake in miniature -- and
// nobody notices until Justin puts the two side by side.
// sieht.
//
// THEREFORE: every mark lives EXACTLY ONCE here, in design points, and
// is scaled through `render.len_of`. Whoever needs a mark calls it --
// he does not redraw it.
//
// ===================================================== WHY NO FONT
//
// A tick from a font (U+2713) depends on that font HAVING the glyph.
// DejaVu has it, many do not, and in the kernel profile there is no
// font at all (K1 in core.fi). A checkbox whose tick disappears when
// the font is missing is a checkbox you cannot tell the state of.
//
// Every mark here is therefore GEOMETRY: strokes and areas that the
// rasteriser antialiases. They work without any font at all.
//
// =============================================== THE COMMON RULE
//
// Each function is handed a SQUARE (x, y, d) and draws inside it. The
// square is the drawing area, not the widget -- whoever wants to
// centre a mark in a button works the square out and then calls. That
// keeps every mark independent of what it sits in.
import fui.painter

export {
    check, dot, triangle_down, triangle_up, triangle_left,
    triangle_right, cross, dash, grip_lines,
    DIR_DOWN, DIR_UP, DIR_LEFT, DIR_RIGHT, triangle,
}

const DIR_DOWN: u32 = 0
const DIR_UP: u32 = 1
const DIR_LEFT: u32 = 2
const DIR_RIGHT: u32 = 3

// ============================================================== THE TICK
//
// Two strokes, short going down and long going up. The proportions
// (0.22/0.48/0.78 horizontal, 0.52/0.72/0.28 vertical) are those of
// Material and HIG -- a tick whose long arm is not clearly longer than
// the short one looks like a v.
//
// Drawn as two RECTANGLES along the diagonals, because the painter
// cannot do slanted strokes: a staircase of short horizontal pieces
// that the rasteriser smooths. At the sizes in question (10-16
// points) that is indistinguishable from a real stroke.
// unterscheiden.
fn check(z: *mut painter.Painter, x: f64, y: f64, d: f64, st: f64,
    col: u32) {
// The three points of the tick in the unit square.
    let ax: f64 = x + d * 0.22
    let ay: f64 = y + d * 0.52
    let bx: f64 = x + d * 0.42
    let by: f64 = y + d * 0.72
    let cx: f64 = x + d * 0.78
    let cy: f64 = y + d * 0.28
    stroke(z, ax, ay, bx, by, st, col)
    stroke(z, bx, by, cx, cy, st, col)
}

// A SLANTED STROKE as a staircase of rectangles.
//
// The painter draws rectangles and rounded areas, not lines with a
// slope. A slanted stroke is therefore split into steps: at each step
// a small square of the stroke width. The number of steps follows the
// longer axis, so that no gaps are left.
fn stroke(z: *mut painter.Painter, x0: f64, y0: f64, x1: f64,
    y1: f64, st: f64, col: u32) {
    var dx: f64 = x1 - x0
    var dy: f64 = y1 - y0
    var adx: f64 = dx
    if adx < 0.0 {
        adx = 0.0 - adx
    }
    var ady: f64 = dy
    if ady < 0.0 {
        ady = 0.0 - ady
    }
    var lang: f64 = adx
    if ady > lang {
        lang = ady
    }
// Two steps per pixel: with one step, gaps stay on the diagonal,
// because the square only touches at the corner.
    // beruehrt.
    var n: i64 = (lang * 2.0) as i64
    if n < 1 {
        n = 1
    }
    var s: f64 = st
    if s < 1.0 {
        s = 1.0
    }
    let h: f64 = s / 2.0
    var i: i64 = 0
    while i <= n {
        let t: f64 = (i as f64) / (n as f64)
        painter.surface(z, x0 + dx * t - h, y0 + dy * t - h, s, s, col)
        i = i + 1
    }
}

// =============================================================== THE DOT
//
// The fill of the radio button. A circle is a rectangle with half the
// diameter as its radius -- `painter.round_rect` can do that, and so
// the dot is antialiased like everything else.
fn dot(z: *mut painter.Painter, x: f64, y: f64, d: f64, col: u32) {
    painter.round_rect(z, x, y, d, d, d / 2.0, col)
}

// ========================================================== THE TRIANGLE
//
// The arrow of the dropdown and of the scrollbar. Drawn as a stack of
// rectangles that narrow towards the tip -- four directions out of ONE
// function, so that the dropdown and the scrollbar are guaranteed to
// show the same triangle.
//
// The height is 0.5 * d: an equilateral triangle looks too heavy at
// small sizes, the systems all take a flat one.
fn triangle(z: *mut painter.Painter, x: f64, y: f64, d: f64,
    dir: u32, col: u32) {
    let n: i64 = ((d * 0.5) as i64)
    var i: i64 = 0
    if dir == DIR_DOWN || dir == DIR_UP {
// Horizontal strips, narrowing from the base to the tip.
        while i < n {
            let t: f64 = (i as f64)
            let br: f64 = d - t * 2.0
            if br <= 0.0 {
                return
            }
            var yy: f64 = y + t
            if dir == DIR_UP {
                yy = y + (n as f64) - 1.0 - t
            }
            painter.surface(z, x + t, yy, br, 1.0, col)
            i = i + 1
        }
        return
    }
// Vertical strips.
    while i < n {
        let t: f64 = (i as f64)
        let ho: f64 = d - t * 2.0
        if ho <= 0.0 {
            return
        }
        var xx: f64 = x + t
        if dir == DIR_LEFT {
            xx = x + (n as f64) - 1.0 - t
        }
        painter.surface(z, xx, y + t, 1.0, ho, col)
        i = i + 1
    }
}

fn triangle_down(z: *mut painter.Painter, x: f64, y: f64, d: f64,
    col: u32) {
    triangle(z, x, y, d, DIR_DOWN, col)
}

fn triangle_up(z: *mut painter.Painter, x: f64, y: f64, d: f64,
    col: u32) {
    triangle(z, x, y, d, DIR_UP, col)
}

fn triangle_left(z: *mut painter.Painter, x: f64, y: f64, d: f64,
    col: u32) {
    triangle(z, x, y, d, DIR_LEFT, col)
}

fn triangle_right(z: *mut painter.Painter, x: f64, y: f64, d: f64,
    col: u32) {
    triangle(z, x, y, d, DIR_RIGHT, col)
}

// ============================================================= THE CROSS
//
// The close mark on the tab. Two diagonals -- the same staircase
// technique as on the tick, so that both look alike.
//
// There is already a cross in lib/fui/core.fi (`cap_close`) for the
// WINDOW BUTTONS, and it stays there: the core draws without a
// painter, with its own antialiasing, onto a raw target. This one
// here is the cross FOR WIDGETS. Two versions for two drawing paths
// are not a rebuild -- a rebuild would be it if
// the same target were painted twice.
fn cross(z: *mut painter.Painter, x: f64, y: f64, d: f64, st: f64,
    col: u32) {
    stroke(z, x, y, x + d, y + d, st, col)
    stroke(z, x + d, y, x, y + d, st, col)
}

// ============================================================ THE DASH
//
// The mark for "partially checked" -- a checkbox whose children do not
// all have the same state. Every system has it, and without it a tree
// with mixed ticks would have to lie.
fn dash(z: *mut painter.Painter, x: f64, y: f64, d: f64, st: f64,
    col: u32) {
    var s: f64 = st
    if s < 1.0 {
        s = 1.0
    }
    painter.surface(z, x + d * 0.2, y + d / 2.0 - s / 2.0, d * 0.6, s,
        col)
}

// ========================================================= THE GRIP GROOVES
//
// The grooves on the thumb of a scrollbar and on the handle of a
// slider. Three short strokes -- they say "this can be grabbed", and
// that is the only place where an area advertises that about
// itself.
fn grip_lines(z: *mut painter.Painter, x: f64, y: f64, w: f64,
    h: f64, vertical: bool, col: u32) {
    var i: i64 = 0
    while i < 3 {
        let o: f64 = ((i - 1) as f64) * 3.0
        if vertical {
            painter.surface(z, x + w * 0.25, y + h / 2.0 + o,
                w * 0.5, 1.0, col)
        } else {
            painter.surface(z, x + w / 2.0 + o, y + h * 0.25, 1.0,
                h * 0.5, col)
        }
        i = i + 1
    }
}
