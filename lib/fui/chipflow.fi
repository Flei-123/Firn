// SPDX-License-Identifier: MPL-2.0
export {
    Flow, flow_new, flow_place, flow_rows, flow_height, zone_left, zone_hit,
}

struct Flow {
    left: f64,
    right: f64,
    gap: f64,
    row_h: f64,
    max_rows: usize,
    x: f64,
    row: usize,
}

fn flow_new(left: f64, right: f64, gap: f64, row_h: f64, max_rows: usize) -> Flow {
    var cap: usize = max_rows
    if cap < 1 {
        cap = 1
    }
    return Flow { left: left, right: right, gap: gap, row_h: row_h, max_rows: cap, x: left, row: 0 }
}

fn flow_place(f: *mut Flow, w: f64, out: *mut [f64; 2]) -> usize {
    if (*f).x + w > (*f).right && (*f).x > (*f).left && (*f).row + 1 < (*f).max_rows {
        (*f).row = (*f).row + 1
        (*f).x = (*f).left
    }
    (*out)[0] = (*f).x
    (*out)[1] = ((*f).row as f64) * (*f).row_h
    (*f).x = (*f).x + w + (*f).gap
    return (*f).row
}

fn flow_rows(f: *mut Flow) -> usize {
    return (*f).row + 1
}

fn flow_height(f: *mut Flow) -> f64 {
    return (((*f).row + 1) as f64) * (*f).row_h
}

fn zone_left(x: f64, w: f64, zone_w: f64) -> f64 {
    return x + w - zone_w
}

fn zone_hit(px: f64, py: f64, x: f64, y: f64, w: f64, h: f64, zone_w: f64) -> bool {
    return px >= x + w - zone_w && px < x + w && py >= y && py < y + h
}
