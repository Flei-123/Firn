profile kernel
// SPDX-License-Identifier: GPL-2.0-only
// lib/fui/anordnung.fi -- WO DIE ELEMENTE LIEGEN.
//
// ====================================================== WARUM ES SIE GIBT
//
// Ohne Anordnung ist eine Bedienelement-Sammlung keine
// WinForms-Alternative, sondern eine Sammlung von Rechtecken, deren
// Stellen jemand von Hand ausrechnet. Genau das steht heute in
// lib/browser/chrome.fi: `BTN_X0 = 6`, `btn_x(i) = BTN_X0 + i * (BTN +
// BTN_GAP)`, `feld_x() = btn_x(2) + BTN + FELD_LUECKE`. Das
// funktioniert fuer EINE Leiste mit DREI Knoepfen und faellt um, sobald
// ein vierter dazukommt.
//
// ==================================================== WARUM IM KERN
//
// `profile kernel` in Zeile 1. Eine Anordnung rechnet nur -- sie malt
// nicht und fordert keinen Speicher an. Damit kann der Fenstermanager
// von OrientOS seine Titelleiste mit derselben Anordnung legen wie eine
// Anwendung ihre Werkzeugleiste.
//
// GANZZAHLIG, wie alles im Kern (SPEC 2: kein Fliesskomma ohne
// `#[allow_fp]`). Das passt zur Sache: eine Bildpunktstelle ist eine
// ganze Zahl, und eine Anordnung, die auf halbe Bildpunkte rechnet,
// erzeugt genau die unscharfen Kanten, die man dann nicht mehr
// loswird.
//
// ================================================== DIE ZWEI DURCHGAENGE
//
// Jede Anordnung, die etwas taugt, laeuft zweimal:
//
//   1. MESSEN   Wie gross will jedes Kind sein? (`wunsch`)
//   2. LEGEN    Der Platz wird verteilt; wer dehnbar ist, bekommt den
//               Rest.
//
// Getrennt, weil der zweite Durchgang das Ergebnis des ersten braucht:
// erst wenn alle Wuensche bekannt sind, weiss man, wieviel ueberhaupt
// uebrig ist.
//
// ================================================== WAS HIER NICHT STEHT
//
// A1 KEINE Kinderliste im Behaelter. Der Aufrufer haelt sein Feld von
//    Elementen selbst und reicht Zeiger herein. Ein Baum aus Zeigern
//    waere das Ende der Allokationsfreiheit -- und im Kern gibt es
//    keinen Allokator, der ihn bauen koennte.
// A2 KEINE Verschachtelung ueber Zeiger. Wer ein Raster in einem
//    Stapel braucht, rechnet den inneren Kasten aus und ruft die
//    innere Anordnung darauf. Das ist eine Zeile mehr und kostet keine
//    Allokation.

export {
    Kasten, kasten_neu, kasten_x, kasten_y, kasten_w, kasten_h,
    kasten_schrumpf, kasten_verschiebe,
    Stapel, stapel_neu, stapel_setz_rand, stapel_setz_abstand,
    stapel_setz_ausricht, stapel_messen, stapel_legen,
    Raster, raster_neu, raster_setz_rand, raster_setz_abstand,
    raster_zelle,
    verteile, mittig_in, ausrichten,
    WAAGRECHT, SENKRECHT,
    A_ANFANG, A_MITTE, A_ENDE, A_DEHNEN,
}

const WAAGRECHT: u32 = 0
const SENKRECHT: u32 = 1

// Wie ein Kind QUER zur Stapelrichtung liegt.
const A_ANFANG: u32 = 0
const A_MITTE: u32 = 1
const A_ENDE: u32 = 2
const A_DEHNEN: u32 = 3

// ============================================================ DER KASTEN
//
// Ein Rechteck in Bildpunkten. Die Waehrung der ganzen Anordnung.
struct Kasten {
    x: i64,
    y: i64,
    w: i64,
    h: i64,
}

fn kasten_neu(x: i64, y: i64, w: i64, h: i64) -> Kasten {
    return Kasten { x: x, y: y, w: w, h: h }
}

fn kasten_x(k: *mut Kasten) -> i64 { return (*k).x }
fn kasten_y(k: *mut Kasten) -> i64 { return (*k).y }
fn kasten_w(k: *mut Kasten) -> i64 { return (*k).w }
fn kasten_h(k: *mut Kasten) -> i64 { return (*k).h }

// Einen Kasten um `rand` nach innen ziehen. NIE unter null: ein
// Innenrand, der groesser ist als der Kasten, ergibt einen leeren
// Kasten und keinen negativen -- in `usize` waere das der Ueberlauf,
// an dem Justins Startmenue in OrientOS gestorben ist.
fn kasten_schrumpf(k: Kasten, links: i64, oben: i64, rechts: i64,
    unten: i64) -> Kasten {
    var o: Kasten = Kasten { x: k.x + links, y: k.y + oben,
        w: k.w - links - rechts, h: k.h - oben - unten }
    if o.w < 0 {
        o.w = 0
    }
    if o.h < 0 {
        o.h = 0
    }
    return o
}

fn kasten_verschiebe(k: Kasten, dx: i64, dy: i64) -> Kasten {
    return Kasten { x: k.x + dx, y: k.y + dy, w: k.w, h: k.h }
}

// ============================================================ DER STAPEL
//
// Eine Reihe von Kindern, waagerecht oder senkrecht. Das ist die
// Anordnung, die neun von zehn Oberflaechen brauchen: eine Leiste, eine
// Knopfreihe, eine Spalte in einem Dialog.
struct Stapel {
    richtung: u32,
    rand_l: i64,
    rand_o: i64,
    rand_r: i64,
    rand_u: i64,
    abstand: i64,
    ausricht: u32,   // quer zur Richtung
}

fn stapel_neu(richtung: u32) -> Stapel {
    return Stapel { richtung: richtung, rand_l: 0, rand_o: 0,
        rand_r: 0, rand_u: 0, abstand: 0, ausricht: A_DEHNEN }
}

fn stapel_setz_rand(s: *mut Stapel, l: i64, o: i64, r: i64, u: i64) {
    (*s).rand_l = l
    (*s).rand_o = o
    (*s).rand_r = r
    (*s).rand_u = u
}

fn stapel_setz_abstand(s: *mut Stapel, a: i64) { (*s).abstand = a }

fn stapel_setz_ausricht(s: *mut Stapel, a: u32) { (*s).ausricht = a }

// ---- DURCHGANG 1: MESSEN
//
// Wieviel Platz braucht ein Stapel mindestens? `wunsch` ist ein Feld
// der Wunschgroessen IN Stapelrichtung, `n` seine Laenge.
//
// Der Aufrufer haelt das Feld (A1). Zurueck kommt die Summe samt
// Abstaenden und Raendern.
fn stapel_messen(s: *mut Stapel, wunsch: *mut i64, n: usize) -> i64 {
    var summe: i64 = 0
    var i: usize = 0
    while i < n {
        summe = summe + *((wunsch as u64 + (i * 8) as u64) as *mut i64)
        i = i + 1
    }
    if n > 1 {
        summe = summe + (*s).abstand * ((n - 1) as i64)
    }
    if (*s).richtung == WAAGRECHT {
        return summe + (*s).rand_l + (*s).rand_r
    }
    return summe + (*s).rand_o + (*s).rand_u
}

// ---- DURCHGANG 2: LEGEN
//
// Verteilt `raum` auf `n` Kinder und schreibt die fertigen Kaesten nach
// `aus`. `wunsch` ist die gewuenschte Groesse in Stapelrichtung,
// `dehnt` sagt je Kind, ob es den Rest mitnehmen darf (0/1), `quer` die
// gewuenschte Groesse QUER zur Richtung.
//
// DIE VERTEILUNG DES RESTES ist die Stelle, an der eine Anordnung
// entweder stimmt oder um einen Bildpunkt danebenliegt: der Rest einer
// Ganzzahldivision wird auf die ERSTEN Dehnbaren verteilt, einer je
// Kind. Damit ist die Summe der Teile GENAU der Raum -- und nicht einer
// weniger, was man an der rechten Kante sieht.
fn stapel_legen(s: *mut Stapel, raum: Kasten, wunsch: *mut i64,
    dehnt: *mut i64, quer: *mut i64, aus: *mut Kasten, n: usize) {
    let innen: Kasten = kasten_schrumpf(raum, (*s).rand_l, (*s).rand_o,
        (*s).rand_r, (*s).rand_u)
    // Wieviel ist gewuenscht, wieviel ist dehnbar?
    var summe: i64 = 0
    var dehnbare: i64 = 0
    var i: usize = 0
    while i < n {
        summe = summe + ld(wunsch, i)
        if ld(dehnt, i) != 0 {
            dehnbare = dehnbare + 1
        }
        i = i + 1
    }
    var luecken: i64 = 0
    if n > 1 {
        luecken = (*s).abstand * ((n - 1) as i64)
    }
    var ganz: i64 = innen.w
    if (*s).richtung == SENKRECHT {
        ganz = innen.h
    }
    var rest: i64 = ganz - summe - luecken
    if rest < 0 {
        rest = 0
    }
    // Der Zuschlag je dehnbarem Kind, und der Rest davon.
    var zuschlag: i64 = 0
    var extra: i64 = 0
    if dehnbare > 0 {
        zuschlag = rest / dehnbare
        extra = rest - zuschlag * dehnbare
    }
    // Legen.
    var lauf: i64 = innen.x
    if (*s).richtung == SENKRECHT {
        lauf = innen.y
    }
    var j: usize = 0
    while j < n {
        var groesse: i64 = ld(wunsch, j)
        if ld(dehnt, j) != 0 {
            groesse = groesse + zuschlag
            if extra > 0 {
                groesse = groesse + 1
                extra = extra - 1
            }
        }
        if groesse < 0 {
            groesse = 0
        }
        // Quer zur Richtung
        let q_ganz: i64 = quer_ganz(s, &innen)
        var q_gross: i64 = ld(quer, j)
        if (*s).ausricht == A_DEHNEN || q_gross <= 0 || q_gross > q_ganz {
            q_gross = q_ganz
        }
        var q_pos: i64 = quer_pos(s, &innen)
        if (*s).ausricht == A_MITTE {
            q_pos = q_pos + (q_ganz - q_gross) / 2
        } else if (*s).ausricht == A_ENDE {
            q_pos = q_pos + q_ganz - q_gross
        }
        if (*s).richtung == WAAGRECHT {
            st_kasten(aus, j, kasten_neu(lauf, q_pos, groesse, q_gross))
        } else {
            st_kasten(aus, j, kasten_neu(q_pos, lauf, q_gross, groesse))
        }
        lauf = lauf + groesse + (*s).abstand
        j = j + 1
    }
}

fn quer_ganz(s: *mut Stapel, innen: *mut Kasten) -> i64 {
    if (*s).richtung == WAAGRECHT {
        return (*innen).h
    }
    return (*innen).w
}

fn quer_pos(s: *mut Stapel, innen: *mut Kasten) -> i64 {
    if (*s).richtung == WAAGRECHT {
        return (*innen).y
    }
    return (*innen).x
}

// Feldzugriff ohne Allokation. Firn Stufe 0 hat keine Scheiben, also
// rechnet der Zugriff selbst -- an EINER Stelle, damit die
// Adressrechnung nicht ueberall steht.
fn ld(f: *mut i64, i: usize) -> i64 {
    return *((f as u64 + (i * 8) as u64) as *mut i64)
}

fn st_kasten(f: *mut Kasten, i: usize, k: Kasten) {
    *((f as u64 + (i * 32) as u64) as *mut Kasten) = k
}

// ============================================================ DAS RASTER
//
// Spalten mal Zeilen, gleich breit. Reicht fuer Dialoge, Kacheln, eine
// Tastatur -- und wer verschiedene Spaltenbreiten braucht, legt zwei
// Stapel ineinander (A2).
struct Raster {
    spalten: usize,
    zeilen: usize,
    rand_l: i64,
    rand_o: i64,
    rand_r: i64,
    rand_u: i64,
    ab_x: i64,
    ab_y: i64,
}

fn raster_neu(spalten: usize, zeilen: usize) -> Raster {
    return Raster { spalten: spalten, zeilen: zeilen, rand_l: 0,
        rand_o: 0, rand_r: 0, rand_u: 0, ab_x: 0, ab_y: 0 }
}

fn raster_setz_rand(r: *mut Raster, l: i64, o: i64, re: i64, u: i64) {
    (*r).rand_l = l
    (*r).rand_o = o
    (*r).rand_r = re
    (*r).rand_u = u
}

fn raster_setz_abstand(r: *mut Raster, x: i64, y: i64) {
    (*r).ab_x = x
    (*r).ab_y = y
}

// Die Zelle (`sp`, `ze`) in `raum`.
//
// GERECHNET UND NICHT AUFADDIERT: die Stelle jeder Zelle kommt aus
// ihrer Nummer, nicht aus der Summe der vorherigen. Damit haeuft sich
// kein Rundungsfehler an, und die letzte Spalte endet genau an der
// Kante -- der Fehler, den man sonst erst bei zwoelf Spalten sieht.
fn raster_zelle(r: *mut Raster, raum: Kasten, sp: usize,
    ze: usize) -> Kasten {
    if (*r).spalten == 0 || (*r).zeilen == 0 {
        return kasten_neu(raum.x, raum.y, 0, 0)
    }
    let innen: Kasten = kasten_schrumpf(raum, (*r).rand_l, (*r).rand_o,
        (*r).rand_r, (*r).rand_u)
    let nsp: i64 = (*r).spalten as i64
    let nze: i64 = (*r).zeilen as i64
    let ganz_x: i64 = innen.w - (*r).ab_x * (nsp - 1)
    let ganz_y: i64 = innen.h - (*r).ab_y * (nze - 1)
    let i: i64 = sp as i64
    let j: i64 = ze as i64
    // Kante links = Anfang + i-tel des Ganzen; Kante rechts = (i+1)-tel.
    // Die Breite ist ihre Differenz -- so summieren sich die Spalten
    // exakt auf `ganz_x`.
    var x0: i64 = 0
    var x1: i64 = 0
    if ganz_x > 0 {
        x0 = ganz_x * i / nsp
        x1 = ganz_x * (i + 1) / nsp
    }
    var y0: i64 = 0
    var y1: i64 = 0
    if ganz_y > 0 {
        y0 = ganz_y * j / nze
        y1 = ganz_y * (j + 1) / nze
    }
    return kasten_neu(innen.x + x0 + (*r).ab_x * i,
        innen.y + y0 + (*r).ab_y * j, x1 - x0, y1 - y0)
}

// ====================================================== KLEINE HELFER

// `n` Teile auf `ganz` verteilen, Rest auf die ersten. Zurueck kommt
// die Groesse des `i`-ten Teils. Dieselbe Rechnung wie im Raster --
// hier fuer den Aufrufer, der von Hand verteilt.
fn verteile(ganz: i64, n: usize, i: usize) -> i64 {
    if n == 0 {
        return 0
    }
    let a: i64 = ganz * (i as i64) / (n as i64)
    let b: i64 = ganz * ((i + 1) as i64) / (n as i64)
    return b - a
}

// Ein Stueck der Groesse `gross` mittig in `ganz`. Der Rest faellt nach
// unten/rechts -- eine Entscheidung, die einmal getroffen sein muss,
// damit zwei Elemente nebeneinander gleich sitzen.
fn mittig_in(ganz: i64, gross: i64) -> i64 {
    if gross >= ganz {
        return 0
    }
    return (ganz - gross) / 2
}

fn ausrichten(ganz: i64, gross: i64, wie: u32) -> i64 {
    if wie == A_MITTE {
        return mittig_in(ganz, gross)
    }
    if wie == A_ENDE {
        if gross >= ganz {
            return 0
        }
        return ganz - gross
    }
    return 0
}
