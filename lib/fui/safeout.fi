// SPDX-License-Identifier: MPL-2.0
// lib/fui/safeout.fi -- WRITE GUARD for proof programs and test tools.
//
// The proof programs (tools/fui/*_main.fi) take their output path from the
// command line: `gallery9_main <out.png> [light|dark] [font.ttf] ...`. A call
// with a swapped argument once wrote a PNG over the system font
// /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf (757 KB -> 21 KB) and broke
// every later run. `write_file` here is a drop-in for `rt.write_file` that
// REFUSES system locations and font files and reports it on stderr.
//
//     import fui.safeout
//     if !safeout.write_file(path_ptr, data_ptr, len) { ... }
import std.rt
import std.str

export { write_file, path_is_protected }

fn byte_at(p: u64, i: usize) -> u8 {
    return rt.ld8(p, i)
}

fn length(p: u64) -> usize {
    var n: usize = 0
    while byte_at(p, n) != 0 as u8 {
        n = n + 1
    }
    return n
}

// true if the NUL-terminated path at `p` begins with `pre` (ASCII).
fn starts_with(p: u64, pre: str) -> bool {
    let n: usize = pre.length()
    var i: usize = 0
    while i < n {
        if byte_at(p, i) != pre.chars(i) {
            return false
        }
        i = i + 1
    }
    return true
}

// true if the path ends with `suf` (ASCII, compared case-insensitively
// for letters).
fn ends_with(p: u64, len: usize, suf: str) -> bool {
    let n: usize = suf.length()
    if len < n {
        return false
    }
    var i: usize = 0
    while i < n {
        var a: u8 = byte_at(p, len - n + i)
        if a >= 65 as u8 {
            if a <= 90 as u8 {
                a = a + 32 as u8
            }
        }
        if a != suf.chars(i) {
            return false
        }
        i = i + 1
    }
    return true
}

// system directories and font/binary file endings no proof may overwrite
fn path_is_protected(p: u64) -> bool {
    let len: usize = length(p)
    if starts_with(p, "/usr/") { return true }
    if starts_with(p, "/etc/") { return true }
    if starts_with(p, "/bin/") { return true }
    if starts_with(p, "/sbin/") { return true }
    if starts_with(p, "/lib") { return true }
    if starts_with(p, "/boot/") { return true }
    if starts_with(p, "/var/lib/") { return true }
    if ends_with(p, len, ".ttf") { return true }
    if ends_with(p, len, ".otf") { return true }
    if ends_with(p, len, ".ttc") { return true }
    if ends_with(p, len, ".woff") { return true }
    if ends_with(p, len, ".woff2") { return true }
    return false
}

fn write_file(path: u64, p: u64, n: usize) -> bool {
    if path_is_protected(path) {
        var m: [u8; 46] = "safeout: refusing to write a system/font path\n"
        rt.write_everything(2, (&m[0]) as u64, 46)
        return false
    }
    return rt.write_file(path, p, n)
}
