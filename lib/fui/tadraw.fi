import fui.textbuf
import fui.editor
import fui.painter
import fui.render
import fui.widget
import fui.style
import fui.theme
import fui.talayout
import fui.tascroll
import paint.canvas

export { draw }

fn draw_tinted(c: *mut render.Ctx, z: *mut painter.Painter, r: *mut painter.TextRun, ix: *mut talayout.LineIndex,
    t: *mut textbuf.TextBuf, a: usize, b: usize, x0: f64, base: f64, fg: u32) {
    let p: u64 = textbuf.tb_ptr(t)
    var x: f64 = x0
    var pos: usize = a
    while pos < b {
        var end: usize = b
        let col: u32 = talayout.ix_tint_at(ix, c as u64, p, textbuf.tb_len(t), textbuf.tb_rev(t), pos, &end)
        if end > b || end <= pos {
            end = b
        }
        var use: u32 = fg
        if col != 0 as u32 {
            use = col
        }
        let drawn: f64 = painter.run_draw(z, r, x, base, 0.0, use, p + pos as u64, end - pos, painter.TEXT_L)
        x = x + painter.run_width(z, r, p + pos as u64, end - pos)
        pos = end
    }
}

fn draw(c: *mut render.Ctx, e0: *mut widget.Widget, ed: *mut editor.Editor,
    ix: *mut talayout.LineIndex, v: *mut tascroll.View, caret_on: bool) {
    var mw: widget.Widget = *e0
    let e: *mut widget.Widget = &mw
    render.draw_base(c, e)
    let z: *mut painter.Painter = render.ctx_painter(c)
    let sz: *mut style.StyleSet = widget.w_styleset(e)
    let zu: u32 = widget.w_state(e)
    let kind: u32 = widget.w_kind(e)
    var px: f64 = render.field_px(c, e)
    if (*v).px_pt > 0.0 {
        px = render.len_of(c, 1000) * (*v).px_pt / 1000.0
    }
    let cx: f64 = render.field_text_x0(c, e)
    let cw: f64 = widget.w_w(e) - 2.0 * (cx - widget.w_x(e))
    let pady: f64 = render.pady_of(c, e)
    let cy: f64 = widget.w_y(e) + pady
    let ch: f64 = widget.w_h(e) - 2.0 * pady
    if cw <= 0.0 || ch <= 0.0 {
        return
    }
    var r: painter.TextRun = render.text_run_of(c, e, px)
    let asc: f64 = painter.font_ascent(z, px)
    let desc: f64 = painter.font_descent(z, px)
    let lh: f64 = ((asc + desc + 0.5) as i64) as f64
    var rh: f64 = (((asc + desc) * 1.25 + 0.5) as i64) as f64
    if (*v).row_k > 0.0 {
        rh = px * (*v).row_k
    }
    if rh < lh + 1.0 {
        rh = lh + 1.0
    }
    talayout.ix_bind_painter(ix, z, &r)
    tascroll.view_set_box(v, cw, ch, rh)
    talayout.ix_set_width(ix, cw)
    talayout.ix_relayout(ix, editor.editor_buf(ed))
    let rows: usize = talayout.ix_count(ix)
    tascroll.view_tick(v, rows, render.ctx_time(c))
    let sy: f64 = (*v).scroll_y + tascroll.view_over(v)

    let t: *mut textbuf.TextBuf = editor.editor_buf(ed)
    let p: u64 = textbuf.tb_ptr(t)
    var fallback: u32 = render.def_fg(kind)
    if zu == style.STATE_DISABLED {
        fallback = style.color_token(style.TOK_TEXT_DISABLED)
    }
    let fg: u32 = render.color_of(c, style.resolve_fg(sz, zu, fallback))
    let sel_bg: u32 = render.color_of(c,
        style.color_token(style.TOK_SELECTION))
    let sa: usize = textbuf.tb_sel_a(t)
    let sb: usize = textbuf.tb_sel_b(t)
    let has_sel: bool = textbuf.tb_has_sel(t)
    let len: usize = textbuf.tb_len(t)
    let has_comp: bool = textbuf.tb_has_comp(t)
    let comp_a: usize = textbuf.tb_comp_a(t)
    let comp_b: usize = textbuf.tb_comp_b(t)
    let fo: *mut theme.Shape = theme.theme_shape(render.ctx_theme(c))
    var us: f64 = render.len_of(c, (*fo).border_w)
    if us < 1.0 {
        us = 1.0
    }

    let cv: *mut canvas.Canvas = painter.painter_canvas(z)
    if !canvas.clip_push_rect(cv, cx, cy, cx + cw, cy + ch) {
        return
    }
    var first: usize = 0
    if sy > 0.0 {
        first = (sy / rh) as usize
    }
    var last: usize = ((sy + ch) / rh) as usize
    if last >= rows {
        last = rows - 1
    }
    let car: usize = textbuf.tb_caret(t)
    let car_line: usize = talayout.ix_line_of(ix, car)
    let pad_in: f64 = (rh - lh) / 2.0
    var i: usize = first
    while i <= last {
        let a: usize = talayout.ix_start(ix, i)
        let b: usize = talayout.ix_end(ix, i)
        let top: f64 = cy + (i as f64) * rh - sy
        let base: f64 = painter.text_baseline_mid(z, top, rh, px)
        if has_sel {
            // the selected part of this line ...
            var la: usize = sa
            if la < a {
                la = a
            }
            var lb: usize = sb
            if lb > b {
                lb = b
            }
            if lb > la {
                painter.run_sel_draw(z, &r, cx, top + pad_in, lh, p + a as u64,
                    b - a, la - a, lb - a, sel_bg)
            }
            // ... and the line break behind it: a small block, so a
            // selected empty line is not invisible
            if !talayout.ix_is_soft(ix, i) && b < len && sa <= b && sb > b {
                var xe: f64 = 0.0
                if b > a {
                    xe = talayout.ix_width_of(ix, t, a, b - a)
                }
                painter.surface(z, cx + xe, top + pad_in, px / 3.0, lh, sel_bg)
            }
        }
        if b > a && talayout.ix_tinted(ix) {
            draw_tinted(c, z, &r, ix, t, a, b, cx, base, fg)
        } else if b > a {
            let e1: f64 = painter.run_draw(z, &r, cx, base, 0.0, fg,
                p + a as u64, b - a, painter.TEXT_L)
        }
        if has_comp {
            var ca: usize = comp_a
            if ca < a {
                ca = a
            }
            var cb: usize = comp_b
            if cb > b {
                cb = b
            }
            if cb > ca {
                let ua: f64 = cx + painter.run_caret_x(z, &r, p + a as u64,
                    b - a, ca - a)
                let ub: f64 = cx + painter.run_caret_x(z, &r, p + a as u64,
                    b - a, cb - a)
                painter.surface(z, ua, base + render.len_of(c, 2), ub - ua,
                    us, fg)
            }
        }
        if caret_on && !has_sel && i == car_line && widget.w_is_focus(e) {
            var kx: f64 = cx
            if car > a {
                kx = cx + painter.run_caret_x(z, &r, p + a as u64, b - a,
                    car - a)
            }
            var st: f64 = render.len_of(c, 1)
            if st < 1.0 {
                st = 1.0
            }
            if kx > cx + cw - st {
                kx = cx + cw - st
            }
            painter.caret_bar(z, kx, top + pad_in, lh, st, fg)
        }
        i = i + 1
    }
    // the scroll thumb: only when there is something to scroll
    let total: f64 = tascroll.view_content_h(v, rows)
    if total > ch && !(*v).bar_off {
        var tw: f64 = render.len_of(c, 3)
        if tw < 2.0 {
            tw = 2.0
        }
        var th: f64 = ch * ch / total
        if th < tw * 3.0 {
            th = tw * 3.0
        }
        let ty: f64 = cy + (ch - th) * (*v).scroll_y / (total - ch)
        let tcol: u32 = render.color_of(c,
            style.color_token(style.TOK_TEXT_MUTED))
        painter.surface(z, cx + cw - tw, ty, tw, th, tcol)
    }
    canvas.clip_pop(cv)
    render.draw_focus_ring(c, e)
}
