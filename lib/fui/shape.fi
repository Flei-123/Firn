// SPDX-License-Identifier: MPL-2.0
// lib/fui/shape.fi -- FROM CODE POINT TO GLYPH: MIRRORING AND ARABIC
// SHAPES.
//
// ========================================================= WHY IT EXISTS
//
// lib/fui/bidi.fi says in what ORDER the characters stand. That
// suffices for Hebrew, but not for Arabic: there the SHAPE of every letter
// depends on its neighbours. "بسم" are in the text three
// code points in their base form; what has to be painted is beh at the start,
// seen in the middle and meem at the end. Whoever paints the base forms side by side
// shows three single letters that a reader recognises as a spelling alphabet
// and not as a word -- in the picture "the right way round" and nevertheless
// wrong.
//
// In addition comes rule L4 of UAX #9: a bracket in a stretch that runs from
// right to left is painted MIRRORED -- "(" becomes ")" --,
// otherwise it points in the wrong direction.
//
// ================================================================ THE PATH
//
//   1. the glyph of every character from the font (cmap), at an odd
//      level that of the mirror image from the UCD (L4)
//   2. the SHAPE of every Arabic position from the joining types
//      (ArabicShaping.txt, via lib/str/ucd_bidi.fi): can the
//      character bind to its predecessor on the right and to its
//      successor on the left? Transparent characters (the vowel signs,
//      joining type T) are skipped when looking for the neighbour.
//   3a. IF THE FONT HAS GSUB for `arab`: the lookups of the features
//      isol/fina/init/medi at the positions with this shape, rlig and
//      liga at every Arabic position, in the order of the
//      LookupList (lib/font/gsub.fi). That is the right way, and the
//      font of this house (DejaVu Sans) goes it.
//   3b. IF IT HAS NONE -- THE APPROXIMATION: the shape is chosen via the
//      Arabic presentation forms of the Unicode standard
//      (U+FB50..U+FDFF, U+FE70..U+FEFF). They stand in UnicodeData.txt
//      as a decomposition (`FE91;...;<initial> 0628`), and the generator of the
//      bidi table has collected them per base letter.
//
// ===================================== WHY 3b IS AN APPROXIMATION, OPENLY
//
// The presentation forms exist only for reasons of compatibility
// with old character sets, and they cover only a part:
//
//   * only the letters for which Unicode keeps a form (76
//     base letters). Newer letters for Urdu, Persian, Kurdish
//     etc. without a form of their own stay in the base shape.
//   * of the ligatures only lam-alif. That one is REQUIRED (Unicode standard,
//     chapter 9.2 "Arabic", section Ligatures: the lam-alif ligature
//     is mandatory in every rendering), all others are ornament and
//     are not formed in 3b.
//   * the font must carry the forms itself. If it lacks one,
//     the base glyph stays -- and `shape_run` COUNTS such positions
//     (`missing`), instead of pretending that everything was shaped.
//   * no position of the vowel signs (that would be GPOS; that is missing in 3a
//     just the same, see gsub.fi).
//
// 3b is therefore readable and right for the base letters, but not
// what a typesetter would deliver. That is why the painter goes 3a whenever
// the font allows it, and tools/fui/bidi_main.fi re-calculates
// that both ways yield THE SAME glyphs with DejaVu Sans.
//
// What does NOT happen here: no level, no order (bidi.fi),
// no advance, no painting (painter.fi). All arrays belong to the
// caller, and everything is #[no_gc].
import str.ucd_bidi
import font.ttf
import font.gsub

export {
    shape_run, shape_forms, apply_acts, multi_apply, multi_apply_u, single_apply, shape_is_arabic,
    SHAPE_NONE, SHAPE_GSUB, SHAPE_FORMS,
    FORM_NONE, FORM_OTHER,
    LAM,
}

// Was `shape_run` getan hat.
const SHAPE_NONE: u32 = 0 // no Arabic character in it
const SHAPE_GSUB: u32 = 1 // Weg 3a, die Schrift hat es gesagt
const SHAPE_FORMS: u32 = 2 // Weg 3b, die Naeherung

// In the shape array: 0..3 are ucd_bidi.FORM_*, plus these two.
const FORM_NONE: u8 = 255 // no Arabic position
const FORM_OTHER: u8 = 254 // Arabic, but without a shape (vowel, hamza)

// The one letter that may form a ligature in 3b (see above).
const LAM: u32 = 0x644

#[no_gc]
fn r8(p: u64, i: usize) -> u8 { return *((p + i as u64) as *mut u8) }
#[no_gc]
fn w8(p: u64, i: usize, v: u8) { *((p + i as u64) as *mut u8) = v }
#[no_gc]
fn r32(p: u64, i: usize) -> u32 { return *((p + (i * 4) as u64) as *mut u32) }
#[no_gc]
fn w32(p: u64, i: usize, v: u32) { *((p + (i * 4) as u64) as *mut u32) = v }

// An Arabic position: a character of class AL, or a
// transparent character (vowel) that hangs on such a one.
#[no_gc]
fn shape_is_arabic(form: u64, i: usize) -> bool {
    return r8(form, i) != FORM_NONE
}

#[no_gc]
fn joins_left_side(j: u8) -> bool {
    // These joining types can accept a SUCCESSOR.
    return j == ucd_bidi.JOIN_L || j == ucd_bidi.JOIN_D
    || j == ucd_bidi.JOIN_C
}

#[no_gc]
fn joins_right_side(j: u8) -> bool {
    // These can bind to a PREDECESSOR.
    return j == ucd_bidi.JOIN_R || j == ucd_bidi.JOIN_D
    || j == ucd_bidi.JOIN_C
}

// THE SHAPES. `form[i]` gets ucd_bidi.FORM_* for every Arabic
// position with a shape, FORM_OTHER for Arabic positions without and
// FORM_NONE for everything else. Calculation is in LOGICAL order
// -- before and after means in the text, not on the screen.
#[no_gc]
fn shape_forms(t: u64, cp: u64, cls0: u64, n: usize, form: u64) -> usize {
    var arabic: usize = 0
    var base_arab: bool = false
    var i: usize = 0
    while i < n {
        let c: u32 = r32(cp, i)
        let j: u8 = ucd_bidi.ucd_joining(t, c)
        if r8(cls0, i) == ucd_bidi.BIDI_AL {
            w8(form, i, FORM_OTHER)
            base_arab = true
            arabic = arabic + 1
        } else if j == ucd_bidi.JOIN_T && base_arab {
            w8(form, i, FORM_OTHER)
        } else {
            w8(form, i, FORM_NONE)
            if j != ucd_bidi.JOIN_T {
                base_arab = false
            }
        }
        i = i + 1
    }
    if arabic == 0 {
        return 0
    }
    i = 0
    while i < n {
        let jt: u8 = ucd_bidi.ucd_joining(t, r32(cp, i))
        if r8(form, i) != FORM_NONE && (jt == ucd_bidi.JOIN_R
            || jt == ucd_bidi.JOIN_D || jt == ucd_bidi.JOIN_L) {
            // the predecessor, across transparent characters
            var prev: u8 = ucd_bidi.JOIN_U
            var k: usize = i
            while k > 0 {
                k = k - 1
                let pj: u8 = ucd_bidi.ucd_joining(t, r32(cp, k))
                if pj != ucd_bidi.JOIN_T {
                    prev = pj
                    break
                }
            }
            var next: u8 = ucd_bidi.JOIN_U
            var q: usize = i + 1
            while q < n {
                let nj: u8 = ucd_bidi.ucd_joining(t, r32(cp, q))
                if nj != ucd_bidi.JOIN_T {
                    next = nj
                    break
                }
                q = q + 1
            }
            let jp: bool = joins_right_side(jt) && joins_left_side(prev)
            let jn: bool = joins_left_side(jt) && joins_right_side(next)
            var fm: u32 = ucd_bidi.FORM_ISOL
            if jp && jn {
                fm = ucd_bidi.FORM_MEDI
            } else if jp {
                fm = ucd_bidi.FORM_FINA
            } else if jn {
                fm = ucd_bidi.FORM_INIT
            }
            w8(form, i, fm as u8)
        }
        i = i + 1
    }
    return arabic
}

#[no_gc]
fn form_bit(fm: u8) -> u32 {
    if fm == ucd_bidi.FORM_ISOL as u8 { return gsub.F_ISOL }
    if fm == ucd_bidi.FORM_FINA as u8 { return gsub.F_FINA }
    if fm == ucd_bidi.FORM_INIT as u8 { return gsub.F_INIT }
    if fm == ucd_bidi.FORM_MEDI as u8 { return gsub.F_MEDI }
    return 0
}

// Sequence units (see lib/font/gsub.fi UNIT): `pos * UNIT + k`, k = 0 the glyph
// of the position, k >= 1 its k-th extra glyph.

// Write the glyph of a unit.
#[no_gc]
fn unit_put(g: *mut gsub.Gsub, gid: u64, u: usize, v: u32) {
    let pos: usize = u / gsub.UNIT
    let k: usize = u % gsub.UNIT
    if k == 0 {
        w32(gid, pos, v)
        return
    }
    let at: usize = gsub.gsub_x_index(g, pos, k)
    if at < gsub.MAX_EXTRA {
        gsub.gsub_x_set(g, at, v)
    }
}

// The unit goes away (absorbed into a ligature, or deleted by a multiple
// substitution with 0 outputs). An extra glyph leaves the table. The glyph of
// the position: if the position still has extras the first of them becomes
// its glyph (the character keeps its cluster and stays visible, the extras
// are NOT hidden with it); otherwise the position is marked absorbed.
// Afterwards a position with `del` set has no extras.
#[no_gc]
fn unit_absorb(g: *mut gsub.Gsub, gid: u64, del: u64, u: usize) {
    let pos: usize = u / gsub.UNIT
    let k: usize = u % gsub.UNIT
    gsub.gsub_elog_add(g, u, 0)
    if k > 0 {
        gsub.gsub_x_remove(g, pos, k)
        return
    }
    if gsub.gsub_x_cnt(g, pos) > 0 {
        w32(gid, pos, gsub.gsub_x_gid(g, gsub.gsub_x_index(g, pos, 1)))
        gsub.gsub_x_remove(g, pos, 1)
        return
    }
    w8(del, pos, 1 as u8)
}

// MULTIPLE SUBSTITUTION (type 2) of lookup `li` at the unit `u`. One output
// glyph replaces the glyph of the unit; several: the first is the glyph of
// the unit, the others go into the table of EXTRA glyphs of the Gsub right
// behind it (they belong to the same character, so the cluster map stays: one
// character -> its glyph + its extras). A full table leaves everything as it
// was; a sequence of 0 glyphs deletes the unit. Returns how many units to
// step forward: 1 + the inserted extras, 0 if the unit was deleted (the next
// unit moved into its place).
#[no_gc]
fn multi_apply_u(f: *mut ttf.Font, g: *mut gsub.Gsub, gid: u64, del: u64,
    li: u32, u: usize) -> usize {
    let q: usize = u / gsub.UNIT
    let k: usize = u % gsub.UNIT
    let g1: u32 = gsub.gsub_unit_gid(g, gid, u)
    if !gsub.gsub_multiple_has(f, g, li, g1) {
        return 1
    }
    let m: usize = gsub.gsub_multiple_len(f, g, li, g1)
    if m == 0 {
        unit_absorb(g, gid, del, u)
        return 0
    }
    if m > 1 && gsub.gsub_x_room(g) < m - 1 {
        return 1
    }
    unit_put(g, gid, u, gsub.gsub_multiple_glyph(f, g, li, g1, 0))
    var j: usize = 1
    while j < m {
        let ok: bool = gsub.gsub_x_insert(g, q, k + j - 1,
            gsub.gsub_multiple_glyph(f, g, li, g1, j))
        j = j + 1
    }
    gsub.gsub_elog_add(g, u, m - 1)
    return m
}

// The same for the glyph of the POSITION `q` (no deletion handling needed by
// the callers: a sequence of 0 glyphs does nothing here -- use
// `multi_apply_u` for deletion).
#[no_gc]
fn multi_apply(f: *mut ttf.Font, g: *mut gsub.Gsub, gid: u64, li: u32,
    q: usize) {
    let g1: u32 = r32(gid, q)
    if gsub.gsub_multiple_len(f, g, li, g1) == 0 {
        return
    }
    let st: usize = multi_apply_u(f, g, gid, 0, li, q * gsub.UNIT)
}

// A single substitution (type 1) at position `q` for the glyph of the
// position AND its extra glyphs.
#[no_gc]
fn single_apply(f: *mut ttf.Font, g: *mut gsub.Gsub, gid: u64, li: u32,
    ign: bool, q: usize) {
    let g1: u32 = r32(gid, q)
    if !(ign && gsub.gsub_is_mark(f, g, g1)) {
        w32(gid, q, gsub.gsub_li_single(f, g, li, g1))
    }
    var e: usize = 0
    while e < gsub.gsub_x_count(g) {
        if gsub.gsub_x_pos(g, e) == q {
            let x1: u32 = gsub.gsub_x_gid(g, e)
            if !(ign && gsub.gsub_is_mark(f, g, x1)) {
                gsub.gsub_x_set(g, e, gsub.gsub_li_single(f, g, li, x1))
            }
        }
        e = e + 1
    }
}

// How deep a context lookup may call context lookups.
const NEST_MAX: u32 = 6

// A record that no longer names anything (its unit was absorbed).
const UNIT_GONE: u32 = 4294967295

// Where a unit `v` goes when the edit (u, c) of the log happened (see
// `gsub_elog_add`): c == 0 the unit `u` was removed, c > 0 c units were put
// behind `u`. Only units of the same position move (positions never shift).
// A record on a removed unit is gone; the END of a match that stands on a
// removed unit stays (it then names the unit that moved up).
#[no_gc]
fn unit_after(v: u32, u: usize, c: usize, is_end: bool) -> u32 {
    if v == UNIT_GONE || (v as usize) / gsub.UNIT != u / gsub.UNIT {
        return v
    }
    let vk: usize = (v as usize) % gsub.UNIT
    let uk: usize = u % gsub.UNIT
    if c == 0 {
        if (v as usize) == u {
            if is_end {
                return v
            }
            return UNIT_GONE
        }
        if vk > uk {
            return v - 1
        }
        return v
    }
    if vk > uk {
        return v + c as u32
    }
    return v
}

// The SubstLookupRecords that `gsub_context_u` found: each names a UNIT
// (a glyph of the sequence, the extras included) and a lookup of the font.
// Single (1, on that unit), multiple (2, several output glyphs go into the
// extra glyphs), alternate (3), ligature (4, components may be extras; absorbed
// ones leave the sequence) are applied in place; a CONTEXT lookup (5, 6) as
// the target is matched at that unit and its own records are applied the same
// way, NEST_MAX deep. Records still to do are shifted when an earlier record
// inserts or removes units of the same position -- also when it happens deep in
// a nested lookup (the edits are read from the log of the Gsub).
// `mend` is the unit behind the input of the matched rule; the answer is where
// it ended up after all the edits: there the walk goes on (HarfBuzz
// apply_lookup). Nested lookups reuse the scratch of the Gsub, so the
// records are copied first.
#[no_gc]
fn apply_acts(f: *mut ttf.Font, g: *mut gsub.Gsub, gid: u64, del: u64,
    n: usize, used: u64, na: usize, depth: u32, mend: usize) -> usize {
    var ap: [u32; 8] = [0; 8]
    var al: [u32; 8] = [0; 8]
    var cnt: usize = na
    if cnt > 8 {
        cnt = 8
    }
    var end: u32 = mend as u32
    var c: usize = 0
    while c < cnt {
        ap[c] = gsub.gsub_act_unit(g, c) as u32
        al[c] = gsub.gsub_act_lookup(g, c)
        c = c + 1
    }
    var j: usize = 0
    while j < cnt {
        let u: usize = ap[j] as usize
        let q: usize = u / gsub.UNIT
        let uk: usize = u % gsub.UNIT
        let li: u32 = al[j]
        let nty: u32 = gsub.gsub_li_type(f, g, li)
        let nign: bool = gsub.gsub_li_ignores_marks(f, g, li)
        let e0: usize = gsub.gsub_elog_len(g)
        if ap[j] != UNIT_GONE && q < n && r8(del, q) == 0 as u8
        && uk <= gsub.gsub_x_cnt(g, q)
        && !(nign && gsub.gsub_is_mark(f, g, gsub.gsub_unit_gid(g, gid, u))) {
            if nty == 1 as u32 {
                unit_put(g, gid, u, gsub.gsub_li_single(f, g, li,
                        gsub.gsub_unit_gid(g, gid, u)))
            } else if nty == 2 as u32 {
                let st: usize = multi_apply_u(f, g, gid, del, li, u)
            } else if nty == 3 as u32 {
                unit_put(g, gid, u, gsub.gsub_li_alternate(f, g, li,
                        gsub.gsub_unit_gid(g, gid, u), gsub.gsub_alt(g)))
            } else if nty == 4 as u32 {
                var nu: usize = 0
                let lg: u32 = gsub.gsub_li_ligature_u(f, g, li, gid, del, n, u,
                    used, 16, &nu)
                if lg != 0 as u32 {
                    unit_put(g, gid, u, lg)
                    // from behind, so the removals do not shift the units
                    // still to be taken out
                    var uu: usize = nu
                    while uu > 0 {
                        uu = uu - 1
                        unit_absorb(g, gid, del, r32(used, uu) as usize)
                    }
                }
            } else if (nty == 5 as u32 || nty == 6 as u32) && depth < NEST_MAX {
                let nn: usize = gsub.gsub_context_li_u(f, g, li, gid, del, n, u)
                if gsub.gsub_match_hit(g) {
                    let ne: usize = apply_acts(f, g, gid, del, n, used, nn,
                        depth + 1, gsub.gsub_match_end(g))
                }
            }
        }
        // what this record (and everything below it) inserted or removed
        // moves the records still to do and the end of the match
        let e1: usize = gsub.gsub_elog_len(g)
        var e: usize = e0
        while e < e1 {
            let eu: usize = gsub.gsub_elog_unit(g, e)
            let ec: usize = gsub.gsub_elog_count(g, e)
            end = unit_after(end, eu, ec, true)
            var j2: usize = j + 1
            while j2 < cnt {
                ap[j2] = unit_after(ap[j2], eu, ec, false)
                j2 = j2 + 1
            }
            e = e + 1
        }
        j = j + 1
    }
    return end as usize
}

// One lookup of type 2, 3, 4, 5 or 6 over the whole sequence, unit by unit
// (the glyph of a position, then its extras). Positions that are absorbed
// or have no shape for the lookup's feature are passed over. After a context
// rule matched the walk goes on at the END OF ITS INPUT (HarfBuzz), after
// anything else at the next unit.
#[no_gc]
fn walk_units(f: *mut ttf.Font, g: *mut gsub.Gsub, gid: u64, del: u64,
    form: u64, n: usize, used: u64, k: usize, ty: u32, mk: u32, every: bool,
    ign: bool) {
    var u: usize = 0
    while u / gsub.UNIT < n {
        let p: usize = u / gsub.UNIT
        let uk: usize = u % gsub.UNIT
        let fm: u8 = r8(form, p)
        var applies: bool = false
        if fm != FORM_NONE && r8(del, p) == 0 as u8 {
            applies = every || (mk & form_bit(fm)) != 0 as u32
        }
        if !applies {
            u = (p + 1) * gsub.UNIT
        } else if uk > gsub.gsub_x_cnt(g, p) {
            u = (p + 1) * gsub.UNIT
        } else {
            let g0: u32 = gsub.gsub_unit_gid(g, gid, u)
            var nxt: usize = u + 1
            if !(ign && gsub.gsub_is_mark(f, g, g0)) {
                if ty == 2 as u32 {
                    nxt = u + multi_apply_u(f, g, gid, del,
                        gsub.gsub_lookup_index(g, k), u)
                } else if ty == 3 as u32 {
                    unit_put(g, gid, u, gsub.gsub_alternate(f, g, k, g0,
                            gsub.gsub_alt(g)))
                } else if ty == 4 as u32 {
                    var nu: usize = 0
                    let lg: u32 = gsub.gsub_ligature_u(f, g, k, gid, del, n, u,
                        used, 16, &nu)
                    if lg != 0 as u32 {
                        unit_put(g, gid, u, lg)
                        var uu: usize = nu
                        while uu > 0 {
                            uu = uu - 1
                            unit_absorb(g, gid, del, r32(used, uu) as usize)
                        }
                    }
                } else {
                    gsub.gsub_elog_reset(g)
                    let na: usize = gsub.gsub_context_u(f, g, k, gid, del, n, u)
                    if gsub.gsub_match_hit(g) {
                        let ne: usize = apply_acts(f, g, gid, del, n, used, na,
                            0 as u32, gsub.gsub_match_end(g))
                        // behind the input; never back before this unit, and
                        // not stuck on it unless it was removed
                        if ne > u || (ne == u && gsub.gsub_elog_len(g) > 0) {
                            nxt = ne
                        }
                    }
                }
            }
            u = nxt
        }
    }
}

// A reverse chaining lookup (type 8): from the last unit to the first, so a
// lookahead sees what was substituted behind.
#[no_gc]
fn walk_reverse(f: *mut ttf.Font, g: *mut gsub.Gsub, gid: u64, del: u64,
    form: u64, n: usize, k: usize, mk: u32, every: bool, ign: bool) {
    var p: usize = n
    while p > 0 {
        p = p - 1
        let fm: u8 = r8(form, p)
        var applies: bool = false
        if fm != FORM_NONE && r8(del, p) == 0 as u8 {
            applies = every || (mk & form_bit(fm)) != 0 as u32
        }
        if applies {
            var uk: usize = gsub.gsub_x_cnt(g, p) + 1
            while uk > 0 {
                uk = uk - 1
                let u: usize = p * gsub.UNIT + uk
                if !(ign && gsub.gsub_is_mark(f, g, gsub.gsub_unit_gid(g, gid, u))) {
                    let r: u32 = gsub.gsub_reverse_u(f, g, k, gid, del, n, u)
                    if r != 0 as u32 {
                        unit_put(g, gid, u, r)
                    }
                }
            }
        }
    }
}

// ======================================================================
// THE WHOLE PATH FOR A PARAGRAPH
// ======================================================================
//
//   cp, cls0, lev   the code points, their UCD classes and the resolved
//                   levels (from bidi.fi, for L4)
//   gid             gets the glyph per position
//   del             gets 1 for positions that have been absorbed into a
//                   ligature (they are not painted and have
//                   no advance, but stay as characters --
//                   the caret stands in a lam-alif behind the
//                   alif, not in the middle of the glyph)
//   form            work array u8[n], afterwards the shape per position
//   used            work array u32[16] for the ligature search
//   use_gsub        false forces the approximation 3b -- ONLY for the
//                   proof in tools/fui/bidi_main.fi that both ways yield
//                   the same
//   missing         gets the number of Arabic positions with
//                   a shape for which path 3b found no glyph in the
//                   font
#[no_gc]
fn shape_run(t: u64, f: *mut ttf.Font, g: *mut gsub.Gsub, use_gsub: bool,
    cp: u64, cls0: u64, lev: u64, n: usize, gid: u64, del: u64,
    form: u64, used: u64, missing: *mut usize) -> u32 {
    *missing = 0
    gsub.gsub_x_reset(g)
    // 1. die Glyphen, samt L4
    var i: usize = 0
    while i < n {
        var c: u32 = r32(cp, i)
        if (r8(lev, i) & 1 as u8) != 0 as u8 {
            let m: u32 = ucd_bidi.ucd_mirror(t, c)
            if m != c && ttf.font_glyph_for(f, m) != 0 as u32 {
                c = m
            }
        }
        w32(gid, i, ttf.font_glyph_for(f, c))
        w8(del, i, 0 as u8)
        i = i + 1
    }
    // 2. die Gestalten
    if shape_forms(t, cp, cls0, n, form) == 0 {
        return SHAPE_NONE
    }
    // 3a. die Schrift
    if use_gsub && gsub.gsub_ok(g) && gsub.gsub_count(g) > 0 {
        var k: usize = 0
        while k < gsub.gsub_count(g) {
            let ty: u32 = gsub.gsub_lookup_type(f, g, k)
            let mk: u32 = gsub.gsub_lookup_mask(g, k)
            let every: bool = (mk & (gsub.F_RLIG | gsub.F_LIGA
                    | gsub.F_RQD | gsub.F_CCMP)) != 0 as u32
            let ign: bool = gsub.gsub_lookup_ignores_marks(f, g, k)
            if ty == 1 as u32 {
                var p: usize = 0
                while p < n {
                    let fm: u8 = r8(form, p)
                    if fm != FORM_NONE && r8(del, p) == 0 as u8
                    && (every || (mk & form_bit(fm)) != 0 as u32) {
                        single_apply(f, g, gid, gsub.gsub_lookup_index(g, k),
                            ign, p)
                    }
                    p = p + 1
                }
            } else if ty == 8 as u32 {
                walk_reverse(f, g, gid, del, form, n, k, mk, every, ign)
            } else if ty >= 2 as u32 && ty <= 6 as u32 {
                walk_units(f, g, gid, del, form, n, used, k, ty, mk, every,
                    ign)
            }
            k = k + 1
        }
        return SHAPE_GSUB
    }
    // 3b. THE APPROXIMATION via the presentation forms -- see head.
    i = 0
    while i < n {
        let fm2: u8 = r8(form, i)
        if fm2 <= ucd_bidi.FORM_MEDI as u8 && r8(del, i) == 0 as u8 {
            let c2: u32 = r32(cp, i)
            var done: bool = false
            // Lam-alif, the one mandatory ligature. The ligature stands there
            // where the lam stands; its form is "final" if the lam
            // binds to its predecessor, otherwise "isolated" -- the
            // alif never binds to a successor.
            if c2 == LAM && (fm2 == ucd_bidi.FORM_INIT as u8
                || fm2 == ucd_bidi.FORM_MEDI as u8) {
                var q: usize = i + 1
                while q < n && ucd_bidi.ucd_joining(t, r32(cp, q))
                == ucd_bidi.JOIN_T {
                    q = q + 1
                }
                if q < n {
                    var lf: u32 = ucd_bidi.FORM_ISOL
                    if fm2 == ucd_bidi.FORM_MEDI as u8 {
                        lf = ucd_bidi.FORM_FINA
                    }
                    let lig: u32 = ucd_bidi.ucd_arabic_ligature(t, c2,
                        r32(cp, q), lf)
                    if lig != 0 as u32 {
                        let lg2: u32 = ttf.font_glyph_for(f, lig)
                        if lg2 != 0 as u32 {
                            w32(gid, i, lg2)
                            w8(del, q, 1 as u8)
                            done = true
                        } else {
                            *missing = *missing + 1
                        }
                    }
                }
            }
            // ISOLATED IS THE BASE FORM. The base glyph of the font is
            // the isolated shape; setting U+FE8D (ALEF ISOLATED FORM)
            // changes no picture, only the glyph number -- and
            // then deviates without reason from path 3a, which for `isol` with
            // DejaVu has no lookup at all.
            if !done && fm2 == ucd_bidi.FORM_ISOL as u8 {
                done = true
            }
            if !done {
                let pf: u32 = ucd_bidi.ucd_arabic_form(t, c2, fm2 as u32)
                if pf != 0 as u32 {
                    let pg: u32 = ttf.font_glyph_for(f, pf)
                    if pg != 0 as u32 {
                        w32(gid, i, pg)
                    } else {
                        *missing = *missing + 1
                    }
                } else {
                    // No entry for a connected shape: the
                    // letter stays in the base form, and that is
                    // counted.
                    *missing = *missing + 1
                }
            }
        }
        i = i + 1
    }
    return SHAPE_FORMS
}
