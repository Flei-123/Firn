import fui.ds_catalog_tok
import fui.ds_vgrid
import fui.editor
import fui.kit
import fui.lucide
import fui.painter
import fui.render
import fui.screenax
import fui.widget

export {
    ListDetail, ld_new, set_count, set_break, set_list_width, set_row, layout, list_of, stacked, detail_visible,
    detail_x, detail_y, detail_w, detail_h, list_x, list_y, list_w, list_h, open_detail, back, row_draw, draw_chrome,
    begin_list, finish_list, move, press, release, key, wheel, tick, selected, count,
    EV_NONE, EV_SELECT, EV_OPEN, EV_BACK, NONE,
}

const NONE: usize = 18446744073709551615

const EV_NONE: u32 = 0
const EV_SELECT: u32 = 1
const EV_OPEN: u32 = 2
const EV_BACK: u32 = 3

struct ListDetail {
    grid: ds_vgrid.Grid,
    stack: bool,
    show: bool,
    break_pt: usize,
    list_pt: usize,
    row_pt: usize,
    ctx: u64,
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    lw: f64,
    dx: f64,
    dy: f64,
    dw: f64,
    dh: f64,
    bar_hot: bool,
}

fn ld_new() -> ListDetail {
    var g: ds_vgrid.Grid = ds_vgrid.grid_new()
    ds_vgrid.set_cell(&g, 4096, 56, 4)
    ds_vgrid.set_pad(&g, 8)
    return ListDetail { grid: g, stack: false, show: false, break_pt: 640, list_pt: 320, row_pt: 56, ctx: 0 as u64,
        x: 0.0, y: 0.0, w: 0.0, h: 0.0, lw: 0.0, dx: 0.0, dy: 0.0, dw: 0.0, dh: 0.0, bar_hot: false }
}

fn list_of(l: *mut ListDetail) -> *mut ds_vgrid.Grid { return &(*l).grid }

fn set_count(l: *mut ListDetail, n: usize) {
    ds_vgrid.set_count(&(*l).grid, n)
    if n == 0 { (*l).show = false }
}

fn count(l: *mut ListDetail) -> usize { return ds_vgrid.count(&(*l).grid) }
fn selected(l: *mut ListDetail) -> usize { return ds_vgrid.selected(&(*l).grid) }
fn set_break(l: *mut ListDetail, pt: usize) { (*l).break_pt = pt }
fn set_list_width(l: *mut ListDetail, pt: usize) { (*l).list_pt = pt }

fn set_row(l: *mut ListDetail, pt: usize) {
    (*l).row_pt = pt
    ds_vgrid.set_cell(&(*l).grid, 4096, pt, 4)
}

fn stacked(l: *mut ListDetail) -> bool { return (*l).stack }
fn detail_visible(l: *mut ListDetail) -> bool { return !(*l).stack || (*l).show }
fn detail_x(l: *mut ListDetail) -> f64 { return (*l).dx }
fn detail_y(l: *mut ListDetail) -> f64 { return (*l).dy }
fn detail_w(l: *mut ListDetail) -> f64 { return (*l).dw }
fn detail_h(l: *mut ListDetail) -> f64 { return (*l).dh }
fn list_x(l: *mut ListDetail) -> f64 { return (*l).x }
fn list_y(l: *mut ListDetail) -> f64 { return (*l).y }
fn list_w(l: *mut ListDetail) -> f64 { return (*l).lw }
fn list_h(l: *mut ListDetail) -> f64 { return (*l).h }

fn bar_h(l: *mut ListDetail) -> f64 {
    return ds_catalog_tok.top_bar_h((*l).ctx as *mut render.Ctx)
}

fn layout(l: *mut ListDetail, c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64) {
    (*l).ctx = c as u64
    (*l).x = x
    (*l).y = y
    (*l).w = w
    (*l).h = h
    (*l).stack = w < kit.ln(c, (*l).break_pt)
    if !(*l).stack {
        var lw: f64 = kit.ln(c, (*l).list_pt)
        if lw > w / 2.0 { lw = w / 2.0 }
        (*l).lw = lw
        (*l).dx = x + lw + kit.ln(c, 1)
        (*l).dy = y
        (*l).dw = w - lw - kit.ln(c, 1)
        (*l).dh = h
        (*l).show = false
        if ds_vgrid.selected(&(*l).grid) == NONE && ds_vgrid.count(&(*l).grid) > 0 { ds_vgrid.select(&(*l).grid, 0) }
        ds_vgrid.layout(&(*l).grid, c, x, y, lw, h)
        return
    }
    (*l).lw = w
    (*l).dx = x
    (*l).dy = y + ds_catalog_tok.top_bar_h(c)
    (*l).dw = w
    (*l).dh = h - ds_catalog_tok.top_bar_h(c)
    ds_vgrid.layout(&(*l).grid, c, x, y, w, h)
}

fn open_detail(l: *mut ListDetail, i: usize) {
    ds_vgrid.select(&(*l).grid, i)
    if (*l).stack && i != NONE { (*l).show = true }
}

fn back(l: *mut ListDetail) -> bool {
    if !(*l).stack || !(*l).show { return false }
    (*l).show = false
    return true
}

fn begin_list(l: *mut ListDetail, c: *mut render.Ctx, name: str) -> bool {
    if (*l).stack && (*l).show { return false }
    return ds_vgrid.begin(&(*l).grid, c, name)
}

fn finish_list(l: *mut ListDetail, c: *mut render.Ctx) {
    if (*l).stack && (*l).show { return }
    ds_vgrid.finish(&(*l).grid, c)
}

fn row_draw(l: *mut ListDetail, c: *mut render.Ctx, i: usize, icon: i64, title: str, sub: str, px: f64, py: f64) {
    var r: [f64; 4] = [0.0; 4]
    ds_vgrid.cell_rect(&(*l).grid, i, &r)
    let z: *mut painter.Painter = render.ctx_painter(c)
    let sel: bool = ds_vgrid.selected(&(*l).grid) == i
    let hot: bool = px >= r[0] && px < r[0] + r[2] && py >= r[1] && py < r[1] + r[3]
    let rad: f64 = ds_catalog_tok.radius_item(c)
    if sel {
        painter.round_rect(z, r[0], r[1], r[2], r[3], rad, ds_catalog_tok.fill_selected(c))
        painter.round_rect(z, r[0], r[1] + r[3] * 0.25, kit.ln(c, 3), r[3] * 0.5, kit.ln(c, 2), ds_catalog_tok.accent(c))
    } else if hot {
        painter.round_rect(z, r[0], r[1], r[2], r[3], rad, ds_catalog_tok.fill_hover(c))
    }
    var tx: f64 = r[0] + ds_catalog_tok.pad(c)
    if icon >= 0 as i64 {
        let s: f64 = ds_catalog_tok.icon_size(c)
        kit.sym(c, icon, tx, r[1] + (r[3] - s) / 2.0, s, ds_catalog_tok.accent(c))
        tx = tx + s + ds_catalog_tok.gap(c)
    }
    let room: f64 = r[0] + r[2] - ds_catalog_tok.pad(c) - tx
    if sub.n > 0 {
        kit.draw_label(c, tx, r[1], r[3] / 2.0, kit.ln(c, 14), 700, ds_catalog_tok.text(c), title, room)
        kit.draw_label(c, tx, r[1] + r[3] / 2.0, r[3] / 2.0, kit.ln(c, 12), 400, ds_catalog_tok.muted(c), sub, room)
    } else {
        kit.draw_label(c, tx, r[1], r[3], kit.ln(c, 14), 700, ds_catalog_tok.text(c), title, room)
    }
    var f: u32 = 0 as u32
    if sel { f = screenax.F_SELECTED }
    if sel && ds_vgrid.has_focus(&(*l).grid) { f = f | screenax.F_FOCUS }
    screenax.note_join(widget.KIND_TILE, f, title, sub, r[0], r[1], r[2], r[3], 0)
}

fn draw_chrome(l: *mut ListDetail, c: *mut render.Ctx, title: str, px: f64, py: f64) {
    (*l).ctx = c as u64
    let z: *mut painter.Painter = render.ctx_painter(c)
    if !(*l).stack {
        painter.surface(z, (*l).x + (*l).lw, (*l).y, kit.ln(c, 1), (*l).h, ds_catalog_tok.separator(c))
        return
    }
    if !(*l).show { return }
    let bh: f64 = ds_catalog_tok.top_bar_h(c)
    painter.surface(z, (*l).x, (*l).y, (*l).w, bh, ds_catalog_tok.surface(c))
    painter.surface(z, (*l).x, (*l).y + bh - kit.ln(c, 1), (*l).w, kit.ln(c, 1), ds_catalog_tok.separator(c))
    (*l).bar_hot = px >= (*l).x && px < (*l).x + bh && py >= (*l).y && py < (*l).y + bh
    if (*l).bar_hot {
        let inset: f64 = kit.ln(c, 4)
        painter.round_rect(z, (*l).x + inset, (*l).y + inset, bh - inset * 2.0, bh - inset * 2.0, ds_catalog_tok.radius_item(c), ds_catalog_tok.fill_hover(c))
    }
    let s: f64 = ds_catalog_tok.icon_size(c)
    kit.sym(c, lucide.ARROW_LEFT, (*l).x + (bh - s) / 2.0, (*l).y + (bh - s) / 2.0, s, ds_catalog_tok.text(c))
    screenax.note(widget.KIND_BUTTON, 0 as u32, "Back", (*l).x, (*l).y, bh, bh, 0)
    kit.draw_label(c, (*l).x + bh, (*l).y, bh, kit.ln(c, 16), 700, ds_catalog_tok.text(c), title, (*l).w - bh - ds_catalog_tok.pad(c))
}

fn move(l: *mut ListDetail, px: f64, py: f64) -> bool {
    return ds_vgrid.move(&(*l).grid, px, py)
}

fn press(l: *mut ListDetail, x: f64, y: f64) -> u32 {
    if (*l).stack && (*l).show {
        let bh: f64 = bar_h(l)
        if x >= (*l).x && x < (*l).x + bh && y >= (*l).y && y < (*l).y + bh {
            (*l).show = false
            return EV_BACK
        }
        return EV_NONE
    }
    let i: usize = ds_vgrid.press(&(*l).grid, x, y)
    if i == NONE { return EV_NONE }
    if (*l).stack {
        (*l).show = true
        return EV_OPEN
    }
    return EV_SELECT
}

fn release(l: *mut ListDetail) { ds_vgrid.release(&(*l).grid) }

fn key(l: *mut ListDetail, code: u32, mods: u32) -> u32 {
    if (*l).stack && (*l).show {
        if code == editor.KEY_ESC || code == editor.KEY_BACKSPACE || (code == editor.KEY_LEFT && (mods & editor.MOD_ALT) != 0 as u32) {
            (*l).show = false
            return EV_BACK
        }
        return EV_NONE
    }
    if code == editor.KEY_ENTER {
        let s: usize = ds_vgrid.selected(&(*l).grid)
        if s == NONE { return EV_NONE }
        if (*l).stack {
            (*l).show = true
            return EV_OPEN
        }
        return EV_SELECT
    }
    if code == editor.KEY_LEFT || code == editor.KEY_RIGHT { return EV_NONE }
    if ds_vgrid.key(&(*l).grid, code, mods) { return EV_SELECT }
    return EV_NONE
}

fn wheel(l: *mut ListDetail, notches: f64, now_ms: i64) { ds_vgrid.wheel(&(*l).grid, notches, now_ms) }
fn tick(l: *mut ListDetail, now_ms: i64) -> bool { return ds_vgrid.tick(&(*l).grid, now_ms) }
