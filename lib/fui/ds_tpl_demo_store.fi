import fui.ds_appcard
import fui.ds_icons
import fui.ds_icons_names
import fui.ds_tpl_store
import fui.kitform

export { spec }

const NAMES: str = "Notes|Calculator|Browser|Mail|Calendar|Photos|Music|Videos|Terminal|Editor|Maps|Weather|Files|Camera|Clock|Contacts|Paint|Chess|Podcasts|Books|Drive|Chat|Recorder|Sketch"
const SUBS: str = "Productivity|Utilities|Internet|Communication|Productivity|Media|Media|Media|Developer tools|Developer tools|Utilities|Utilities|System|Media|Utilities|Communication|Creative|Games|Media|Reading|Cloud|Communication|Media|Creative"
const DESC: str = "A fast and simple app for everyday use. It starts instantly, works offline and keeps your data on your device. Sync is optional and encrypted end to end. The interface follows your system theme and scales from phones to large desktop screens."
static mut STATES: [u32; 24] = [0 as u32; 24]

fn pick(i: usize, list: str) -> str { return kitform.nth(list, i % 24) }

fn count(ud: u64, cat: usize, q: str) -> usize { return 24 }

fn item(ud: u64, cat: usize, q: str, i: usize, out: *mut ds_tpl_store.Item) {
    *out = ds_tpl_store.Item { icon: ds_icons.gid(ds_icons_names.APPS), name: pick(i, NAMES), sub: pick(i, SUBS), meta: "4.8 stars", desc: DESC, state: STATES[i % 24], permille: 0 as i64 }
}

fn act(ud: u64, cat: usize, q: str, i: usize, action: u32) {
    if action == ds_appcard.ACT_INSTALL || action == ds_appcard.ACT_UPDATE { STATES[i % 24] = ds_appcard.S_OPEN }
}

fn spec() -> ds_tpl_store.Spec {
    STATES[1] = ds_appcard.S_OPEN
    return ds_tpl_store.Spec { ud: 0, title: "Store", cats: "Home|Apps|Games|Create", icons: [ds_icons.gid(ds_icons_names.HOME), ds_icons.gid(ds_icons_names.APPS), ds_icons.gid(ds_icons_names.GAMES), ds_icons.gid(ds_icons_names.SPARKLE), 0, 0, 0, 0],
        foot: "Library", foot_icon: ds_icons.gid(ds_icons_names.BOOK), hint: "Search apps", shots: 4, count: count, item: item, act: act }
}
