// SPDX-License-Identifier: MPL-2.0
import fui.ds_vgrid
import fui.kit
import fui.render

export {
    Touch, touch_new, touch_down, touch_move, touch_up, touch_active, touch_moved,
    SAMPLES, HORIZON_US, REST_US, FLING_MIN_PER_MS, SLOP_PT,
}

const SAMPLES: usize = 16
const HORIZON_US: i64 = 100000
const REST_US: i64 = 80000
const FLING_MIN_PER_MS: f64 = 0.05
const SLOP_PT: usize = 8

struct Touch {
    on: bool,
    moved: bool,
    x0: f64,
    y0: f64,
    last_y: f64,
    n: usize,
    ys: [f64; 16],
    ts: [i64; 16],
}

fn touch_new() -> Touch {
    return Touch { on: false, moved: false, x0: 0.0, y0: 0.0, last_y: 0.0, n: 0, ys: [0.0; 16], ts: [0; 16] }
}

fn touch_active(t: *mut Touch) -> bool { return (*t).on }
fn touch_moved(t: *mut Touch) -> bool { return (*t).moved }

fn push(t: *mut Touch, y: f64, us: i64) {
    var n: usize = (*t).n
    if n >= SAMPLES {
        var i: usize = 1
        while i < SAMPLES {
            (*t).ys[i - 1] = (*t).ys[i]
            (*t).ts[i - 1] = (*t).ts[i]
            i = i + 1
        }
        n = SAMPLES - 1
    }
    (*t).ys[n] = y
    (*t).ts[n] = us
    (*t).n = n + 1
}

fn finger_per_ms(t: *mut Touch, now_us: i64) -> f64 {
    let n: usize = (*t).n
    if n < 2 { return 0.0 }
    let last: i64 = (*t).ts[n - 1]
    if now_us - last > REST_US { return 0.0 }
    var i: usize = n - 1
    while i > 0 && last - (*t).ts[i - 1] <= HORIZON_US { i = i - 1 }
    let span: i64 = last - (*t).ts[i]
    if span < 4000 as i64 { return 0.0 }
    return ((*t).ys[n - 1] - (*t).ys[i]) / ((span as f64) / 1000.0)
}

fn touch_down(t: *mut Touch, g: *mut ds_vgrid.Grid, x: f64, y: f64, us: i64) {
    (*t).on = true
    (*t).moved = false
    (*t).x0 = x
    (*t).y0 = y
    (*t).last_y = y
    (*t).n = 0
    push(t, y, us)
    ds_vgrid.stop(g)
}

fn touch_move(t: *mut Touch, g: *mut ds_vgrid.Grid, c: *mut render.Ctx, y: f64, us: i64) -> bool {
    if !(*t).on { return false }
    push(t, y, us)
    if !(*t).moved {
        let d: f64 = y - (*t).y0
        let slop: f64 = kit.ln(c, SLOP_PT)
        if d < slop && d > 0.0 - slop { return false }
        (*t).moved = true
        if d > 0.0 { (*t).last_y = (*t).y0 + slop } else { (*t).last_y = (*t).y0 - slop }
    }
    let before: f64 = ds_vgrid.scroll_y(g)
    ds_vgrid.pan(g, y - (*t).last_y, us / 1000 as i64)
    (*t).last_y = y
    return ds_vgrid.scroll_y(g) != before
}

fn touch_up(t: *mut Touch, g: *mut ds_vgrid.Grid, us: i64) -> usize {
    if !(*t).on { return ds_vgrid.NONE }
    (*t).on = false
    if !(*t).moved { return ds_vgrid.index_at(g, (*t).x0, (*t).y0) }
    let v: f64 = finger_per_ms(t, us)
    var a: f64 = v
    if a < 0.0 { a = 0.0 - a }
    if a >= FLING_MIN_PER_MS { ds_vgrid.fling(g, v * 1000.0, us / 1000 as i64) }
    return ds_vgrid.NONE
}
