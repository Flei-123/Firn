import fui.ds_tokens
import fui.icons
import fui.kit
import fui.kitapp
import fui.painter
import fui.render
import fui.screenanim
import fui.style

const NONE: usize = 18446744073709551615
const ICON_MORE: i64 = -2
const MORE_PATH: str = "M12 12h.01M19 12h.01M5 12h.01"

fn role(c: *mut render.Ctx, r: usize) -> u32 { return ds_tokens.paint(render.ctx_theme(c), r) }
fn fg(c: *mut render.Ctx) -> u32 { return role(c, ds_tokens.C_TEXT) }
fn fg_muted(c: *mut render.Ctx) -> u32 { return role(c, ds_tokens.C_TEXT_MUTED) }
fn fg_disabled(c: *mut render.Ctx) -> u32 { return role(c, ds_tokens.C_TEXT_DISABLED) }
fn card_bg(c: *mut render.Ctx) -> u32 { return role(c, ds_tokens.C_SURFACE) }
fn card_line(c: *mut render.Ctx) -> u32 { return role(c, ds_tokens.C_SEPARATOR) }
fn hover_bg(c: *mut render.Ctx) -> u32 { return role(c, ds_tokens.C_BUTTON_HOVER) }
fn pressed_bg(c: *mut render.Ctx) -> u32 { return role(c, ds_tokens.C_BUTTON_ACTIVE) }
fn accent(c: *mut render.Ctx) -> u32 { return kit.accent_gfx(c, style.TOK_SURFACE) }

fn radius(c: *mut render.Ctx) -> f64 { return kit.ln(c, 8) }
fn radius_small(c: *mut render.Ctx) -> f64 { return kit.ln(c, 4) }
fn pad(c: *mut render.Ctx) -> f64 { return kit.ln(c, 16) }
fn gap(c: *mut render.Ctx) -> f64 { return kit.ln(c, 12) }
fn glyph_size(c: *mut render.Ctx) -> f64 { return kit.ln(c, 20) }
fn glyph_small(c: *mut render.Ctx) -> f64 { return kit.ln(c, 16) }
fn row_gap(c: *mut render.Ctx) -> f64 { return kit.ln(c, 3) }

fn row_height(c: *mut render.Ctx, has_sub: bool) -> f64 {
    if has_sub { return kit.grow_h(c, 68, 14) }
    return kit.grow_h(c, 52, 14)
}

fn icon_button_size(c: *mut render.Ctx, big: bool) -> f64 {
    if big { return kit.ln(c, 40) }
    return kit.ln(c, 32)
}

fn fill(c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, r: f64, col: u32) {
    painter.round_rect(render.ctx_painter(c), x, y, w, h, r, col)
}

fn ring(c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, r: f64, col: u32) {
    painter.round_ring(render.ctx_painter(c), x, y, w, h, r, kit.ln(c, 1), col)
}

fn card(c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64) {
    kitapp.card_r_paint(c, x, y, w, h, radius(c), card_bg(c), card_line(c))
}

fn separator(c: *mut render.Ctx, x: f64, y: f64, w: f64) {
    painter.round_rect(render.ctx_painter(c), x, y, w, kit.ln(c, 1), 0.0, card_line(c))
}

fn overlay(c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, r: f64, base: u32, t: f64) {
    if t <= 0.0 { return }
    var k: f64 = t
    if k > 1.0 { k = 1.0 }
    fill(c, x, y, w, h, r, kit.with_alpha(base, (k * 255.0) as u32))
}

fn hover_level(c: *mut render.Ctx, x: f64, y: f64, on: bool) -> f64 {
    return screenanim.hover(c, x, y, on)
}

fn label(c: *mut render.Ctx, x: f64, y: f64, h: f64, pt: usize, weight: usize, col: u32, s: str, max_w: f64) -> f64 {
    return kit.draw_label(c, x, y, h, kit.ln(c, pt), weight, col, s, max_w)
}

fn label_width(c: *mut render.Ctx, pt: usize, weight: usize, s: str) -> f64 {
    return kit.text_width(c, kit.ln(c, pt), weight, s)
}

fn glyph(c: *mut render.Ctx, id: i64, x: f64, y: f64, size: f64, col: u32) {
    if id == ICON_MORE {
        icons.path_draw(render.ctx_painter(c), MORE_PATH, x, y, size, col, icons.STROKE_DEFAULT + 0.5)
        return
    }
    kit.sym(c, id, x, y, size, col)
}

fn focus(c: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64, r: f64) {
    kit.focus_ring(c, x, y, w, h, r, style.TOK_SURFACE)
}

fn inside(x: f64, y: f64, rx: f64, ry: f64, rw: f64, rh: f64) -> bool {
    return x >= rx && x < rx + rw && y >= ry && y < ry + rh
}

fn byte_offset(whole: str, part: str) -> usize {
    return (part.p as u64 - whole.p as u64) as usize
}

fn sub(whole: str, from: usize, to: usize) -> str {
    return str { p: (whole.p as u64 + from as u64) as *mut u8, n: to - from }
}
