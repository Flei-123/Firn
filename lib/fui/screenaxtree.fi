import std.rt
import std.gcobj
import fui.scene
import fui.a11y
import fui.widget
import fui.flex
import fui.screenax

export { Tree, tree_new, publish, tree_scene, tree_ax, tree_node, reg_of_node }

struct Tree {
    sc: scene.Scene,
    ax: a11y.A11y,
    root: usize,
    map: [u32; 256],
    title: str,
}

fn tree_new(title: str) -> *mut Tree {
    let t: *mut Tree = gcobj.alloc[Tree](1 << 12) as *mut Tree
    (*t).sc = scene.scene_new()
    (*t).ax = a11y.a11y_new()
    (*t).root = scene.SCENE_NONE
    (*t).title = title
    return t
}

fn tree_scene(t: *mut Tree) -> *mut scene.Scene { return &(*t).sc }
fn tree_ax(t: *mut Tree) -> *mut a11y.A11y { return &(*t).ax }

fn tree_node(t: *mut Tree, reg: usize) -> usize {
    if reg >= screenax.CAP { return scene.SCENE_NONE }
    return (*t).map[reg] as usize
}

fn reg_of_node(t: *mut Tree, node: usize) -> usize {
    var i: usize = 0
    while i < screenax.count() {
        if (*t).map[i] as usize == node { return i }
        i = i + 1
    }
    return screenax.NONE
}

fn leaf(t: *mut Tree, i: usize) -> usize {
    let nm: str = screenax.name_of(i)
    let st: u32 = screenax.state_of(i)
    if (st & screenax.F_HEADING) != 0 as u32 {
        let h: usize = scene.scene_add(&(*t).sc, (*t).root, scene.N_TEXT)
        if h != scene.SCENE_NONE {
            scene.node_set_text(&(*t).sc, h, nm.p as u64, nm.n)
            a11y.a11y_set_name(&(*t).ax, h, nm.p as u64, nm.n)
            a11y.a11y_set_role(&(*t).ax, h, a11y.ROLE_HEADING)
        }
        return h
    }
    let n: usize = scene.scene_widget(&(*t).sc, (*t).root, screenax.kind_of(i), nm.p as u64, nm.n)
    if n == scene.SCENE_NONE { return n }
    a11y.a11y_set_name(&(*t).ax, n, nm.p as u64, nm.n)
    if (st & screenax.F_MENUITEM) != 0 as u32 { a11y.a11y_set_role(&(*t).ax, n, a11y.ROLE_MENUITEM) }
    let e: *mut widget.Widget = scene.node_widget(&(*t).sc, n)
    var v: i64 = screenax.value_of(i)
    if (st & screenax.F_CHECKED) != 0 as u32 { v = 1 }
    widget.w_set_value(e, v)
    if screenax.focus_index() == i || (screenax.focus_index() == screenax.NONE && (st & screenax.F_FOCUS) != 0 as u32) { widget.w_set_focus(e, true) }
    if (st & screenax.F_SELECTED) != 0 as u32 { widget.w_set_selected(e, true) }
    if (st & screenax.F_DISABLED) != 0 as u32 { widget.w_set_disabled(e, true) }
    if screenax.kind_of(i) == widget.KIND_TEXTBOX {
        let tv: str = screenax.text_of(i)
        widget.w_set_text(e, tv.p as u64, tv.n)
        a11y.a11y_set_readonly(&(*t).ax, n, !screenax.settable_text(i))
    }
    return n
}

fn publish(t: *mut Tree) {
    screenax.mark_shown()
    scene.scene_reset(&(*t).sc)
    a11y.a11y_reset(&(*t).ax)
    (*t).root = scene.scene_box(&(*t).sc, scene.SCENE_NONE, 0 as u32, flex.FLEX_COLUMN, flex.JUSTIFY_START, flex.AL_START)
    if (*t).root == scene.SCENE_NONE { return }
    a11y.a11y_set_name(&(*t).ax, (*t).root, (*t).title.p as u64, (*t).title.n)
    a11y.a11y_set_role(&(*t).ax, (*t).root, a11y.ROLE_GROUP)
    var maxx: f64 = 0.0
    var maxy: f64 = 0.0
    var q: [f64; 4] = [0.0; 4]
    var i: usize = 0
    while i < screenax.count() {
        let n: usize = leaf(t, i)
        (*t).map[i] = n as u32
        if n != scene.SCENE_NONE {
            screenax.rect_of(i, &q)
            scene.node_set_rect(&(*t).sc, n, q[0], q[1], q[2], q[3])
            if q[0] + q[2] > maxx { maxx = q[0] + q[2] }
            if q[1] + q[3] > maxy { maxy = q[1] + q[3] }
        }
        i = i + 1
    }
    scene.node_set_rect(&(*t).sc, (*t).root, 0.0, 0.0, maxx, maxy)
}
