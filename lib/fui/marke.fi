// SPDX-License-Identifier: GPL-2.0-only
// lib/fui/marke.fi -- DIE EINE QUELLE FUER FARBE, FORM UND RAUM (fUi).
//
// ====================================================== WARUM ES SIE GIBT
//
// Justin, 10.09.2026: "Es soll dann EINE allgemeine fuer alles geben,
// keine mehreren separaten!!!"
//
// Heute stehen dieselben Zahlen an drei Orten. In Certus
// (lib/browser/chrome.fi) als `theme_dark`/`theme_light` mit zehn
// Farben. In OrientOS (kernel/user/wlibc.fi) als 24 Formmarken und ein
// Satz Farbschemata. In lib/android/ui.fi noch einmal, weil das Telefon
// seine eigenen malte. Drei Fassungen derselben Sache laufen
// auseinander, und sie WAREN schon auseinander -- das ist genau der
// Befund, mit dem lib/browser/chrome.fi selbst anfaengt ("vier Zahlen,
// die nicht zu ihrem Hexwert passten").
//
// Diese Datei ist die eine Quelle. Kein Bedienelement in fUi schreibt
// eine Farbe, einen Radius oder einen Abstand als Zahl hin; jedes fragt
// hier.
//
// ================================================ WO DIE ZAHLEN HERKOMMEN
//
// NICHTS HIER IST ERFUNDEN, und wo etwas abgeleitet ist, steht die
// Rechnung daneben. Zwei Quellen und eine Pruefung:
//
//   1. /root/osum-merge11/assets/shapes/osum.shape -- die Hausform von
//      OrientOS. Sie ist ihrerseits aus dem Entwurfssystem unter
//      .../skills/design-system/references/primitive-tokens.md und
//      component-specs.md hergeleitet und haelt EINE nachpruefbare
//      Regel: JEDE LAENGE IST EIN VIELFACHES VON VIER. Das ist die
//      einzige Eigenschaft eines Abstandssystems, die man von aussen
//      nachzaehlen kann.
//
//   2. lib/browser/chrome.fi -- die zehn Farben, die Certus heute malt.
//      Es sind die Firefox-Photon-Farben, und Justin kennt sie.
//
//   3. WCAG 2, Kontrast 4.5:1 fuer Text (Entwurfssystem, Priorität 1).
//      JEDES Textpaar dieser Datei ist nachgerechnet. Die Zahlen stehen
//      unten in der Tafel, und `tools/fui/kontrast.fi` rechnet sie im
//      Bau nach -- eine Marke, die ihre eigene Zusage bricht, faellt
//      dort auf und nicht auf Justins Bildschirm.
//
// ============================ DREI FARBEN, DIE DIE PRUEFUNG GEAENDERT HAT
//
// Die Kontrastrechnung war kein Formalismus; sie hat drei echte Fehler
// gefunden, zwei davon im heutigen Certus:
//
//   1. `text_blass` dunkel (0x8F8F9D) auf der Leiste (0x2B2A33) ergibt
//      4,44:1 -- knapp unter der Schwelle. Um EINE Stufe je Kanal
//      aufgehellt (0x90909E) sind es 4,50:1.
//
//   2. WEISSER TEXT AUF DEM AKZENT (0x0A84FF) ergibt im dunklen Schema
//      3,65:1. Das ist die Farbe, die Certus heute fuer Fortschritt und
//      Fokusring benutzt. Der Akzent BLEIBT -- er ist das Firefox-Blau
//      und Justin kennt ihn --, aber `text_auf_akzent` ist im dunklen
//      Schema NICHT weiss, sondern der Grundton 0x1C1B22: 4,68:1.
//
//   3. `text_blass` hat ZWEI Aufgaben, die einander widersprechen:
//      Hilfstext auf der FLAECHE (dunkel, 0x2B2A33) und Beschriftung
//      eines GESPERRTEN KNOPFES (heller, 0x42414D). Eine Farbe fuer
//      beides ergibt auf dem Knopf 3,18:1. Darum gibt es `text_gesperrt`
//      als EIGENE ROLLE, gegen die Knopfflaeche gerechnet: 0xAEAEBC,
//      4,57:1 -- und immer noch deutlich schwaecher als gewoehnlicher
//      Text (9,71:1), sonst waere "gesperrt" nicht zu sehen.
//
// ===================================================== DIE DREI ACHSEN
//
// OrientOS trennt Farbe (`.scheme`), Form (`.shape`) und Raum, und das
// ist die richtige Teilung: ein dunkles Schema mit eckigen Ecken ist
// eine sinnvolle Verbindung, ein Satz "dunkel und rund" als EINE Marke
// waere es nicht. fUi uebernimmt die Teilung.
//
// ================================================== WAS HIER NICHT STEHT
//
// M1 KEINE Schriftdatei. Welche Schrift geladen wird, entscheidet die
//    Anwendung (Certus sucht segoeui/arial/DejaVu). Hier steht nur die
//    GROESSE.
// M2 KEIN Zeichnen. Diese Datei kennt keine Leinwand und importiert
//    ausser `std.rt` nichts.
// M3 KEINE Zustandslogik. WELCHE Farbe ein gedrueckter Knopf hat, steht
//    hier; DASS er gedrueckt ist, weiss lib/fui/element.fi.
import std.rt
import fui.stil

export {
    Farben, farben_hell, farben_dunkel, farben_von_dunkel,
    Form, form_osum, form_klassisch,
    Marke, marke_neu, marke_farben, marke_form, marke_ist_dunkel,
    marke_setz_dunkel, marke_setz_form, marke_setz_skala, marke_skala,
    marke_px,
    ZU_NORMAL, ZU_UEBER, ZU_DRUCK, ZU_FOKUS, ZU_SPERR,
    flaeche_fuer, text_fuer, rand_fuer,
    leucht, kontrast, deck, misch,
    farbe_von_token, farbe_von_stilwert,
}

// ===================================================== DIE ZUSTAENDE
//
// Die fuenf, die jedes Bedienelement kennt. Sie stehen HIER und nicht in
// jedem Element -- sonst muesste ein sechster an acht Stellen
// nachgetragen werden.
//
// `ZU_SPERR` schlaegt alle anderen: ein gesperrter Knopf unter dem
// Zeiger ist gesperrt, nicht ueberfahren.
const ZU_NORMAL: u32 = 0
const ZU_UEBER: u32 = 1
const ZU_DRUCK: u32 = 2
const ZU_FOKUS: u32 = 3
const ZU_SPERR: u32 = 4

// ========================================================== DIE FARBEN
//
// 0xRRGGBB, wie ueberall in Certus und in OrientOS. Die Leinwand will
// 0xAARRGGBB; `deck` setzt das Alpha.
//
// Die Namen sind ROLLEN und keine Farbnamen. "grau3" waere in einem
// hellen Schema falsch benannt; `flaeche_hoch` stimmt in beiden.
struct Farben {
    // --- Flaechen, von hinten nach vorn
    grund: u32,        // das Fenster selbst, die leere Seite
    flaeche: u32,      // eine Leiste, eine Tafel auf dem Grund
    flaeche_hoch: u32, // eine Karte, ein Menue -- naeher am Auge
    // --- Bedienelemente
    knopf: u32,
    knopf_ueber: u32,
    knopf_druck: u32,
    feld: u32,
    feld_fokus: u32,
    // --- Striche
    linie: u32,        // Rahmen eines Elements
    trenner: u32,      // Trennlinie zwischen zwei Dingen
    // --- Text
    text: u32,
    text_blass: u32,     // Hilfstext AUF DER FLAECHE
    text_gesperrt: u32,  // Beschriftung AUF EINEM KNOPF, gesperrt
    text_auf_akzent: u32,
    // --- die eine laute Farbe
    akzent: u32,
    auswahl: u32,        // Hintergrund markierten Textes
    auswahl_text: u32,
    // --- Meldungen
    fehler: u32,
    warnung: u32,
    gut: u32,
    dunkel: bool,
}

// ---------------------------------------------------------------- HELL
//
// chrome.fi `theme_light` (Firefox Photon hell) plus die Rollen, die
// Certus nicht hatte. Gemessene Kontraste stehen als Kommentar.
fn farben_hell() -> Farben {
    return Farben {
        grund: 16777215,           // 0xFFFFFF  chrome.fi page
        flaeche: 16382459,         // 0xF9F9FB  chrome.fi bar
        flaeche_hoch: 16777215,    // 0xFFFFFF  ein Menue steht auf Weiss
        knopf: 15592944,           // 0xEDEDF0  chrome.fi feld
        knopf_ueber: 14671842,     // 0xDFDFE2  chrome.fi hover
        // Eine Stufe unter `knopf_ueber`, dieselbe Graureihe fortgesetzt
        // (6 % Richtung Text). Firefox nimmt fuer gedrueckt die naechste
        // Stufe, und die Reihe F9F9FB -> EDEDF0 -> DFDFE2 -> D3D3D6
        // haelt ihren Abstand.
        knopf_druck: 13882326,     // 0xD3D3D6  Text darauf 12,25:1
        feld: 15592944,            // 0xEDEDF0  chrome.fi feld
        feld_fokus: 16777215,      // 0xFFFFFF  chrome.fi feld_fokus
        linie: 14145499,           // 0xD7D7DB  chrome.fi sep
        trenner: 14145499,         // 0xD7D7DB  `trenner_kraft` regelt
                                   //           die Deckkraft
        text: 1381403,             // 0x15141B  chrome.fi fg
        text_blass: 5987174,       // 0x5B5B66  chrome.fi fg_dim, 6,37:1
        text_gesperrt: 5987174,    // 0x5B5B66  auf dem Knopf 5,74:1 --
                                   //           hell braucht keine
                                   //           eigene Farbe
        text_auf_akzent: 16777215, // 0xFFFFFF  auf dem Akzent 5,62:1
        akzent: 24799,             // 0x0060DF  chrome.fi akzent
        // 22 % Akzent auf Weiss -- die klassische Markierungsfarbe
        // eines Textfeldes. Text darauf 13,09:1.
        auswahl: 13098232,         // 0xC7DCF8
        auswahl_text: 1381403,     // 0x15141B
        fehler: 12910658,          // 0xC50042  chrome.fi err, 5,78:1
        // NICHT 0xFFA436 (Photon warning). Das ist eine FLAECHENfarbe
        // -- als Text auf der hellen Leiste ergibt Orange 1,88:1, und
        // die Pruefung hat es sofort gefunden. Genommen ist die
        // Textfassung derselben Farbe (Photon amber-90): 6,94:1.
        warnung: 7426304,          // 0x715100
        gut: 96832,                // 0x017A40  Photon success, 5,18:1
        dunkel: false,
    }
}

// -------------------------------------------------------------- DUNKEL
fn farben_dunkel() -> Farben {
    return Farben {
        grund: 1841954,            // 0x1C1B22  chrome.fi page
        flaeche: 2828851,          // 0x2B2A33  chrome.fi bar
        // 6 % Richtung Text: eine Karte liegt VOR der Leiste, also
        // heller. Text darauf 11,42:1.
        flaeche_hoch: 3618623,     // 0x37373F
        knopf: 4342093,            // 0x42414D  chrome.fi feld
        knopf_ueber: 5395038,      // 0x52525E  chrome.fi hover
        knopf_druck: 6513518,      // 0x63636E  Text darauf 5,74:1
        feld: 4342093,             // 0x42414D  chrome.fi feld
        feld_fokus: 1841954,       // 0x1C1B22  chrome.fi feld_fokus
        linie: 3815748,            // 0x3A3944  chrome.fi sep
        trenner: 3815748,          // 0x3A3944
        text: 16514046,            // 0xFBFBFE  chrome.fi fg
        // BEFUND 1: chrome.fi hat 0x8F8F9D -- 4,44:1, knapp darunter.
        // Eine Stufe je Kanal heller: 4,50:1.
        text_blass: 9474206,       // 0x90909E
        // BEFUND 3: eigene Rolle, gegen die KNOPFflaeche gerechnet.
        // 4,57:1 auf dem Knopf, gegen 9,71:1 fuer gewoehnlichen Text --
        // schwaecher, aber lesbar.
        text_gesperrt: 11447996,   // 0xAEAEBC
        // BEFUND 2: NICHT weiss. Weiss auf 0x0A84FF sind 3,65:1.
        text_auf_akzent: 1841954,  // 0x1C1B22  4,68:1
        akzent: 689407,            // 0x0A84FF  chrome.fi akzent
        // 35 % Akzent auf dem Grundton. Text darauf 10,18:1.
        auswahl: 1458287,          // 0x16406F
        auswahl_text: 16514046,    // 0xFBFBFE
        fehler: 16735324,          // 0xFF5C5C  chrome.fi err, 4,68:1
        warnung: 16760143,         // 0xFFBD4F  Photon warning dunkel
        gut: 5570493,              // 0x54FFBD  Photon success dunkel
        dunkel: true,
    }
}

fn farben_von_dunkel(dunkel: bool) -> Farben {
    if dunkel {
        return farben_dunkel()
    }
    return farben_hell()
}

// ============================================================ DIE FORM
//
// Alle Laengen in ENTWURFSPUNKTEN bei 96 dpi. `marke_px` rechnet sie in
// Geraetepunkte -- darum darf keine Laenge direkt aus dieser Struktur
// benutzt werden.
//
// Die Zahlen sind die von osum.shape, Wort fuer Wort. Regel: jede
// Laenge ist ein Vielfaches von vier, ausser `rand` (1) und `fokus` (2),
// die Strichstaerken sind.
struct Form {
    // --- Radien, nach Rolle: Fenster > Tafel > Knopf > Feld.
    // Das ist die Reihenfolge, die Fluent, HIG, Material 3 und Adwaita
    // alle vier einhalten: der Radius sagt, wie GROSS eine Flaeche ist.
    // Ein Eingabefeld mit dem Radius eines Fensters sieht aus wie eine
    // Tablette.
    r_fenster: usize,
    r_tafel: usize,
    r_knopf: usize,
    r_feld: usize,
    // --- Striche
    rand: usize,
    fokus: usize,          // 2: einer verschwindet beim Skalieren
    trenner_kraft: usize,  // 0..100
    // --- Abstaende, das Viererraster
    sp_xs: usize,          // innerhalb eines Elements
    sp_s: usize,           // zwischen zwei Elementen einer Gruppe
    sp_m: usize,           // zwischen zwei Gruppen, Innenrand einer Karte
    sp_l: usize,           // zwischen zwei Karten, Rand einer Seite
    // --- Innenabstaende
    pad_x: usize,
    pad_y: usize,
    gap: usize,
    // --- Hoehen
    ctrl_h: usize,         // "was man anfasst, ist mindestens 32 hoch"
    row: usize,            // eine Listenzeile
    // --- Schrift
    font: usize,
    // --- Zeit
    motion: usize,         // ms; schnell 3/4, langsam 5/4
    // --- Schatten
    schatten: usize,
    schatten_r: usize,
}

// Die Hausform. Das ist osum.shape.
fn form_osum() -> Form {
    return Form {
        r_fenster: 12, r_tafel: 10, r_knopf: 8, r_feld: 6,
        rand: 1, fokus: 2, trenner_kraft: 20,
        sp_xs: 4, sp_s: 8, sp_m: 16, sp_l: 24,
        pad_x: 16, pad_y: 8, gap: 12,
        ctrl_h: 32, row: 28,
        font: 15,
        motion: 160,
        schatten: 32, schatten_r: 8,
    }
}

// Die eckige Fassung -- classic.shape. Sie ist NICHT "haesslich als
// Wahlmoeglichkeit": sie ist der BEWEIS, dass die Form eine Marke ist
// und keine Annahme im Zeichencode. Ein Element, das mit
// `form_klassisch` genauso aussieht wie mit `form_osum`, hat seine
// Zahlen hineingeschrieben statt sie zu holen -- und genau das faellt
// damit auf.
fn form_klassisch() -> Form {
    return Form {
        r_fenster: 0, r_tafel: 0, r_knopf: 0, r_feld: 0,
        rand: 1, fokus: 1, trenner_kraft: 100,
        sp_xs: 2, sp_s: 6, sp_m: 10, sp_l: 12,
        pad_x: 12, pad_y: 4, gap: 8,
        ctrl_h: 26, row: 20,
        font: 15,
        motion: 0,
        schatten: 0, schatten_r: 0,
    }
}

// =========================================================== DIE MARKE
struct Marke {
    f: Farben,
    fo: Form,
    // Der Massstab in Promille: 1000 = 100 %, 1500 = 150 %. Er kommt
    // aus `fenster.uiscale(f)` und wird HIER gehalten, damit ein
    // Element nicht das Fenster fragen muss, um eine Laenge zu kennen.
    skala: usize,
}

fn marke_neu(dunkel: bool) -> Marke {
    return Marke { f: farben_von_dunkel(dunkel), fo: form_osum(),
        skala: 1000 }
}

fn marke_farben(m: *mut Marke) -> *mut Farben {
    return &(*m).f
}

fn marke_form(m: *mut Marke) -> *mut Form {
    return &(*m).fo
}

fn marke_ist_dunkel(m: *mut Marke) -> bool {
    return (*m).f.dunkel
}

fn marke_setz_dunkel(m: *mut Marke, dunkel: bool) {
    (*m).f = farben_von_dunkel(dunkel)
}

fn marke_setz_form(m: *mut Marke, fo: *mut Form) {
    (*m).fo = *fo
}

fn marke_setz_skala(m: *mut Marke, promille: usize) {
    var p: usize = promille
    if p < 500 {
        p = 500
    }
    if p > 4000 {
        p = 4000
    }
    (*m).skala = p
}

fn marke_skala(m: *mut Marke) -> usize {
    return (*m).skala
}

// EINE ENTWURFSLAENGE IN GERAETEPUNKTE. Jede Laenge in fUi geht hier
// durch.
//
// Der Fehler, den das verhindert, steht im Kopf von
// lib/fenster/fenster.fi: Justins Zeiger war 8x15 Bildpunkte auf einem
// 34-Zoll-Schirm, weil er als einziges Stueck mit festen Zahlen gemalt
// wurde.
//
// Kaufmaennisch gerundet, und NIE auf null: ein Rahmen von einem
// Bildpunkt bleibt ein Bildpunkt. Ein Rahmen, der beim Verkleinern
// verschwindet, ist ein Element ohne Kante.
fn marke_px(m: *mut Marke, n: usize) -> usize {
    if n == 0 {
        return 0
    }
    let v: usize = (n * (*m).skala + 500) / 1000
    if v == 0 {
        return 1
    }
    return v
}

// ================================================= FLAECHE UND TEXT
//
// Welche Farbe hat ein Element im Zustand X? Diese Frage steht EINMAL
// hier und nicht in jedem Element -- das ist genau der Fehler, den wir
// in OrientOS gerade ausbauen, wo das Kontrollzentrum eigene Kacheln
// malt statt `paint_button` zu benutzen.
fn flaeche_fuer(m: *mut Marke, zustand: u32) -> u32 {
    let f: *mut Farben = &(*m).f
    if zustand == ZU_SPERR {
        // Ein gesperrter Knopf ist die RUHEFARBE mit blassem Text --
        // nicht eine eigene graue Flaeche. Zwei Signale fuer denselben
        // Zustand sind eines zu viel.
        return (*f).knopf
    }
    if zustand == ZU_DRUCK {
        return (*f).knopf_druck
    }
    if zustand == ZU_UEBER {
        return (*f).knopf_ueber
    }
    // ZU_FOKUS aendert die FLAECHE NICHT -- der Fokus ist ein RING.
    // Wer beides faerbt, kann einen fokussierten von einem
    // ueberfahrenen Knopf nicht mehr unterscheiden.
    return (*f).knopf
}

fn text_fuer(m: *mut Marke, zustand: u32) -> u32 {
    let f: *mut Farben = &(*m).f
    if zustand == ZU_SPERR {
        return (*f).text_gesperrt
    }
    return (*f).text
}

// Die Randfarbe. Im Fokus ist es der Akzent -- das ist der Ring, und er
// ist das einzige, worauf sich jemand verlaesst, der mit der Tastatur
// bedient.
fn rand_fuer(m: *mut Marke, zustand: u32) -> u32 {
    let f: *mut Farben = &(*m).f
    if zustand == ZU_FOKUS {
        return (*f).akzent
    }
    return (*f).linie
}

// ============================================ HELLIGKEIT UND KONTRAST
//
// Uebernommen aus lib/browser/chrome.fi (Runde CERTUS-WIN2). Sie stehen
// hier, weil eine Marke ihre eigene Zusage nachrechnen koennen muss.
fn lin(c: f64) -> f64 {
    if c <= 0.04045 {
        return c / 12.92
    }
    return hoch24((c + 0.055) / 1.055)
}

// x hoch 2,4 ueber e^(2,4 * ln x). Eine eigene Potenz, weil diese Datei
// an nichts ausser `std.rt` haengen soll.
fn hoch24(x: f64) -> f64 {
    if x <= 0.0 {
        return 0.0
    }
    return e_hoch(2.4 * ln_von(x))
}

fn ln_von(x: f64) -> f64 {
    if x <= 0.0 {
        return 0.0 - 30.0
    }
    // ln x = 2 * artanh((x-1)/(x+1)); vorher auf [0,5; 2] gebracht.
    var e: i32 = 0
    var v: f64 = x
    while v > 2.0 {
        v = v / 2.0
        e = e + 1
    }
    while v < 0.5 {
        v = v * 2.0
        e = e - 1
    }
    let t: f64 = (v - 1.0) / (v + 1.0)
    let t2: f64 = t * t
    var s: f64 = t
    var p: f64 = t
    var k: f64 = 3.0
    var i: usize = 0
    while i < 12 {
        p = p * t2
        s = s + p / k
        k = k + 2.0
        i = i + 1
    }
    return 2.0 * s + (e as f64) * 0.6931471805599453
}

fn e_hoch(x: f64) -> f64 {
    var n: i32 = 0
    var v: f64 = x
    while v > 0.6931471805599453 {
        v = v - 0.6931471805599453
        n = n + 1
    }
    while v < 0.0 - 0.6931471805599453 {
        v = v + 0.6931471805599453
        n = n - 1
    }
    var s: f64 = 1.0
    var p: f64 = 1.0
    var i: usize = 1
    while i < 14 {
        p = p * v / (i as f64)
        s = s + p
        i = i + 1
    }
    var m: f64 = 1.0
    var k: i32 = 0
    if n >= 0 {
        while k < n {
            m = m * 2.0
            k = k + 1
        }
    } else {
        while k > n {
            m = m / 2.0
            k = k - 1
        }
    }
    return s * m
}

// Die relative Leuchtdichte nach WCAG 2.
fn leucht(c: u32) -> f64 {
    let r: f64 = (((c >> 16) & 255 as u32) as f64) / 255.0
    let g: f64 = (((c >> 8) & 255 as u32) as f64) / 255.0
    let b: f64 = ((c & 255 as u32) as f64) / 255.0
    return 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b)
}

// Das Kontrastverhaeltnis zweier Farben, 1,0 bis 21,0.
fn kontrast(a: u32, b: u32) -> f64 {
    let la: f64 = leucht(a)
    let lb: f64 = leucht(b)
    if la > lb {
        return (la + 0.05) / (lb + 0.05)
    }
    return (lb + 0.05) / (la + 0.05)
}

// Zwei Farben mischen, `t` in Promille (0 = a, 1000 = b). Kanalweise.
// Damit sind die abgeleiteten Farben oben nachrechenbar und nicht bloss
// behauptet.
fn misch(a: u32, b: u32, t: usize) -> u32 {
    var tt: usize = t
    if tt > 1000 {
        tt = 1000
    }
    var out: u32 = 0
    var s: u32 = 16
    while true {
        let ca: usize = ((a >> s) & 255 as u32) as usize
        let cb: usize = ((b >> s) & 255 as u32) as usize
        var v: usize = 0
        if cb >= ca {
            v = ca + ((cb - ca) * tt + 500) / 1000
        } else {
            v = ca - ((ca - cb) * tt + 500) / 1000
        }
        out = out | ((v as u32) << s)
        if s == 0 as u32 {
            break
        }
        s = s - 8 as u32
    }
    return out
}

// 0xRRGGBB -> 0xAARRGGBB mit vollem Alpha. Die Leinwand will das.
fn deck(c: u32) -> u32 {
    return c | 4278190080 as u32
}

// ====================================== DIE BRUECKE ZUM STILSYSTEM
//
// lib/fui/stil.fi liegt im KERN und darf keine Farbtafel kennen -- es
// fuehrt Farben als TOKEN-NUMMER (TK_*). Hier steht die Abbildung von
// der Nummer auf die Farbe, und nur hier. Das ist der Grund, warum ein
// Themenwechsel die Widgets NICHT neu aufbaut (Justins Punkt 3): in den
// Widgets steht keine Farbe, sondern eine Nummer, und die Nummer
// bedeutet nach dem Wechsel etwas anderes.
fn farbe_von_token(m: *mut Marke, tk: u32) -> u32 {
    let f: *mut Farben = &(*m).f
    if tk == stil.TK_GRUND { return (*f).grund }
    if tk == stil.TK_FLAECHE { return (*f).flaeche }
    if tk == stil.TK_FLAECHE_HOCH { return (*f).flaeche_hoch }
    if tk == stil.TK_KNOPF { return (*f).knopf }
    if tk == stil.TK_KNOPF_UEBER { return (*f).knopf_ueber }
    if tk == stil.TK_KNOPF_DRUCK { return (*f).knopf_druck }
    if tk == stil.TK_FELD { return (*f).feld }
    if tk == stil.TK_FELD_FOKUS { return (*f).feld_fokus }
    if tk == stil.TK_LINIE { return (*f).linie }
    if tk == stil.TK_TRENNER { return (*f).trenner }
    if tk == stil.TK_TEXT { return (*f).text }
    if tk == stil.TK_TEXT_BLASS { return (*f).text_blass }
    if tk == stil.TK_TEXT_GESPERRT { return (*f).text_gesperrt }
    if tk == stil.TK_TEXT_AUF_AKZENT { return (*f).text_auf_akzent }
    if tk == stil.TK_AKZENT { return (*f).akzent }
    if tk == stil.TK_AUSWAHL { return (*f).auswahl }
    if tk == stil.TK_AUSWAHL_TEXT { return (*f).auswahl_text }
    if tk == stil.TK_FEHLER { return (*f).fehler }
    if tk == stil.TK_WARNUNG { return (*f).warnung }
    if tk == stil.TK_GUT { return (*f).gut }
    // Eine Nummer, die es nicht gibt: die Textfarbe. Sie ist auf jeder
    // Flaeche dieses Themas lesbar -- eine unbekannte Rolle soll
    // auffallen, aber nichts unsichtbar machen.
    return (*f).text
}

// Ein STILWERT (literal, token, transparent, erben) zu einer Farbe.
// Transparent und Erben haben keine Farbe -- der Aufrufer muss vorher
// `stil.farb_ist_sichtbar` fragen. Damit das nicht still schiefgeht,
// gibt es hier die Textfarbe zurueck und nicht Schwarz: ein
// vergessener Sichtbarkeitstest faellt dann auf.
fn farbe_von_stilwert(m: *mut Marke, w: u32) -> u32 {
    let a: u32 = stil.farb_art(w)
    if a == stil.ART_LITERAL {
        return stil.farb_wert(w)
    }
    if a == stil.ART_TOKEN {
        return farbe_von_token(m, stil.farb_wert(w))
    }
    return (*m).f.text
}
