// SPDX-License-Identifier: GPL-2.0-only
// lib/fui/male.fi -- DIE EINE STELLE, AN DER ELEMENTE GEMALT WERDEN.
//
// ====================================================== WARUM ES SIE GIBT
//
// Das ist die Regel, um die es in diesem ganzen Vorhaben geht, und sie
// ist zweimal teuer bezahlt worden:
//
//   * In OrientOS malt das Kontrollzentrum eigene Kacheln, statt
//     `paint_button` zu benutzen -- darum sehen sie anders aus als jeder
//     andere Knopf im System.
//   * Die Fensterknoepfe sind zweimal kaputtgegangen, weil ihre
//     Zeichnung an einer zweiten Stelle nachgebaut wurde.
//
// DARUM: kein Bedienelement in fUi malt sich selbst. Es gibt genau eine
// Datei, die aus einem `Element` Bildpunkte macht, und das ist diese.
// Wer ein neues Element baut, ergaenzt hier einen Fall -- und bekommt
// Zustaende, Stil, Fokusring und Kantenglaettung geschenkt, weil sie
// schon da sind.
//
// ============================================== DER AUFBAU EINES ELEMENTS
//
// Jedes Element wird in DERSELBEN Reihenfolge gemalt, und das ist keine
// Bequemlichkeit -- es ist der Grund, warum sie alle zusammenpassen:
//
//   1. FLAECHE   der Hintergrund, wenn er sichtbar ist
//   2. RAHMEN    der Umriss, wenn er sichtbar ist
//   3. INHALT    Text oder Symbol
//   4. FOKUSRING zuletzt, damit er ueber allem liegt
//
// `male_grund` macht 1, 2 und 4 fuer JEDES Element. Ein neues Element
// schreibt nur seinen Inhalt.
import std.rt
import paint.canvas
import fui.stil
import fui.marke
import fui.element
import fui.zeichnen

export {
    Ctx, ctx_neu, ctx_marke, ctx_zeichner,
    male_grund, male_element, male_beschriftung, male_knopf,
    wid_hg, wid_hg_zu, wid_rahmen, wid_text, wid_radius, wid_rahmen_st,
    wid_pad_x, wid_pad_y, wid_font, wid_ausricht,
    farbe_von, laenge_von,
}

// Was zum Malen gebraucht wird: die Marke (Farben, Form, Massstab) und
// der Zeichner (Leinwand, Schrift, Rasterer). Beide gehoeren dem
// Aufrufer.
struct Ctx {
    m: u64,   // *mut marke.Marke
    z: u64,   // *mut zeichnen.Zeichner
}

fn ctx_neu(m: *mut marke.Marke, z: *mut zeichnen.Zeichner) -> Ctx {
    return Ctx { m: m as u64, z: z as u64 }
}

fn ctx_marke(c: *mut Ctx) -> *mut marke.Marke {
    return (*c).m as *mut marke.Marke
}

fn ctx_zeichner(c: *mut Ctx) -> *mut zeichnen.Zeichner {
    return (*c).z as *mut zeichnen.Zeichner
}

// Einen aufgeloesten Stilwert zu einer echten Farbe.
fn farbe_von(c: *mut Ctx, w: u32) -> u32 {
    return marke.farbe_von_stilwert(ctx_marke(c), w)
}

// Eine Entwurfslaenge in Geraetepunkte -- jede Laenge geht hier durch.
fn laenge_von(c: *mut Ctx, n: usize) -> f64 {
    return marke.marke_px(ctx_marke(c), n) as f64
}

// ======================================================================
// DIE WIDGET-VORGABEN
// ======================================================================
//
// Was ein Element von sich aus ist, wenn der Aufrufer nichts sagt. Das
// ist die unterste Ebene der Vererbungskette aus lib/fui/stil.fi.
//
// HIER steht "eine Beschriftung hat von Haus aus keinen Hintergrund"
// als EINE Zeile -- und nicht als Regel im Kopf des Programmierers.

// ======================================================================
// DIE WIDGET-VORGABE HAENGT AM ZUSTAND -- SONST GIBT ES KEINE ZUSTAENDE
// ======================================================================
//
// EIN FEHLER DIESER RUNDE, IM BILD GEFUNDEN. Die erste Fassung gab hier
// fuer jeden Zustand `TK_KNOPF` zurueck. Uebersetzt hat das sauber,
// gelaufen ist es auch -- und auf der Schauseite waren alle fuenf
// Knoepfe GLEICH GRAU. Gemessen (dunkel, Mitte des jeweiligen Knopfes):
//
//     normal 0x42414D  ueber 0x42414D  druck 0x42414D  ...
//
// Der Grund: `stil.loese_hg` faellt auf die Widget-Vorgabe zurueck,
// wenn weder Zustandsaufsatz noch Aufrufer etwas sagen -- und genau das
// ist bei einem gewoehnlichen Knopf der Normalfall. Eine Vorgabe ohne
// Zustand macht die Zustaende also unsichtbar, obwohl das Stilsystem
// darunter richtig rechnet.
//
// DAS IST DER GRUND, WARUM ES DIE SCHAUSEITE GIBT: im Quelltext sieht
// beides gleich aus.
fn wid_hg_zu(art: u32, zu: u32) -> u32 {
    if art == element.AR_KNOPF || art == element.AR_UMSCHALT
        || art == element.AR_KACHEL || art == element.AR_REITER {
        if zu == stil.ZU_DRUCK {
            return stil.farb_token(stil.TK_KNOPF_DRUCK)
        }
        if zu == stil.ZU_UEBER {
            return stil.farb_token(stil.TK_KNOPF_UEBER)
        }
        if zu == stil.ZU_GEWAEHLT {
            return stil.farb_token(stil.TK_AKZENT)
        }
        // SPERR und FOKUS behalten die Ruhefarbe: gesperrt zeigt sich
        // am blassen Text, Fokus am Ring. Zwei Signale fuer denselben
        // Zustand sind eines zu viel.
        return stil.farb_token(stil.TK_KNOPF)
    }
    if art == element.AR_TEXTFELD {
        if zu == stil.ZU_FOKUS {
            return stil.farb_token(stil.TK_FELD_FOKUS)
        }
        return stil.farb_token(stil.TK_FELD)
    }
    return wid_hg(art)
}

fn wid_hg(art: u32) -> u32 {
    if art == element.AR_BESCHRIFTUNG {
        // Eine Beschriftung ist Text auf dem, was darunter liegt.
        return stil.farb_transparent()
    }
    if art == element.AR_TEXTFELD {
        return stil.farb_token(stil.TK_FELD)
    }
    if art == element.AR_TRENNER {
        return stil.farb_token(stil.TK_TRENNER)
    }
    if art == element.AR_FORTSCHRITT {
        return stil.farb_token(stil.TK_FELD)
    }
    if art == element.AR_KARTE || art == element.AR_MENUE {
        return stil.farb_token(stil.TK_FLAECHE_HOCH)
    }
    if art == element.AR_WERKZEUG {
        return stil.farb_token(stil.TK_FLAECHE)
    }
    if art == element.AR_LEER {
        return stil.farb_transparent()
    }
    return stil.farb_token(stil.TK_KNOPF)
}

fn wid_rahmen(art: u32) -> u32 {
    if art == element.AR_TEXTFELD {
        return stil.farb_token(stil.TK_LINIE)
    }
    // Knoepfe dieses Themas tragen keinen Rahmen -- `tone=0` in
    // osum.shape: getrennt wird durch Abstand, nicht durch eine Linie.
    return stil.farb_transparent()
}

fn wid_text(art: u32) -> u32 {
    return stil.farb_token(stil.TK_TEXT)
}

fn wid_radius(c: *mut Ctx, art: u32) -> usize {
    let fo: *mut marke.Form = marke.marke_form(ctx_marke(c))
    if art == element.AR_TEXTFELD {
        return (*fo).r_feld
    }
    if art == element.AR_KARTE || art == element.AR_MENUE {
        return (*fo).r_tafel
    }
    if art == element.AR_BESCHRIFTUNG || art == element.AR_TRENNER {
        return 0
    }
    return (*fo).r_knopf
}

fn wid_rahmen_st(c: *mut Ctx, art: u32) -> usize {
    let fo: *mut marke.Form = marke.marke_form(ctx_marke(c))
    if art == element.AR_TEXTFELD {
        return (*fo).rand
    }
    return 0
}

fn wid_pad_x(c: *mut Ctx, art: u32) -> usize {
    let fo: *mut marke.Form = marke.marke_form(ctx_marke(c))
    if art == element.AR_BESCHRIFTUNG {
        return 0
    }
    return (*fo).pad_x
}

fn wid_pad_y(c: *mut Ctx, art: u32) -> usize {
    let fo: *mut marke.Form = marke.marke_form(ctx_marke(c))
    if art == element.AR_BESCHRIFTUNG {
        return 0
    }
    return (*fo).pad_y
}

fn wid_font(c: *mut Ctx) -> usize {
    let fo: *mut marke.Form = marke.marke_form(ctx_marke(c))
    return (*fo).font
}

fn wid_ausricht(art: u32) -> u32 {
    if art == element.AR_BESCHRIFTUNG || art == element.AR_TEXTFELD {
        return stil.AUS_LINKS
    }
    // Ein Knopf beschriftet sich mittig.
    return stil.AUS_MITTE
}

// ======================================================================
// DER GEMEINSAME GRUND
// ======================================================================
//
// Flaeche, Rahmen und Fokusring -- fuer JEDES Element gleich. Das ist
// der Teil, den ein neues Element nicht mehr schreiben muss.
//
// `nur_ring` malt den Fokusring NACH dem Inhalt; darum ist er ein
// eigener Aufruf und nicht Teil von `male_grund`.
fn male_grund(c: *mut Ctx, e: *mut element.Element) {
    let z: *mut zeichnen.Zeichner = ctx_zeichner(c)
    let sz: *mut stil.Satz = element.el_satz(e)
    let art: u32 = element.el_art(e)
    let zu: u32 = element.el_zustand(e)

    // ---- 1. DIE FLAECHE
    //
    // DIE ENTSCHEIDENDE ZEILE DIESER DATEI: ist der Wert nicht
    // sichtbar, wird NICHT GEMALT. Kein Ersatzanstrich in Fensterfarbe
    // -- das ist Justins Punkt 4, und ueber einem Hintergrundbild ist
    // der Unterschied sofort zu sehen.
    let hg: u32 = stil.loese_hg(sz, zu, wid_hg_zu(art, zu))
    let r: f64 = laenge_von(c, stil.loese_zahl(sz, stil.S_RADIUS,
        (*stil.satz_stil(sz)).radius as usize, wid_radius(c, art)))
    if stil.farb_ist_sichtbar(hg) {
        zeichnen.rund(z, element.el_x(e), element.el_y(e),
            element.el_w(e), element.el_h(e), r, farbe_von(c, hg))
    }

    // ---- 2. DER RAHMEN
    let ra: u32 = stil.loese_rahmen(sz, zu, wid_rahmen(art))
    let st: f64 = laenge_von(c, stil.loese_zahl(sz, stil.S_RAHMEN_ST,
        (*stil.satz_stil(sz)).rahmen_st as usize, wid_rahmen_st(c, art)))
    if stil.farb_ist_sichtbar(ra) && st > 0.0 {
        zeichnen.ring(z, element.el_x(e), element.el_y(e),
            element.el_w(e), element.el_h(e), r, st, farbe_von(c, ra))
    }
}

// DER FOKUSRING, zuletzt und ueber allem.
//
// Er ist das einzige, worauf sich jemand verlaesst, der mit der
// Tastatur bedient -- darum ist er zwei Bildpunkte stark
// (marke.Form.fokus) und faerbt die Flaeche NICHT: waere er eine
// Fuellung, koennte man fokussiert nicht von ueberfahren
// unterscheiden.
fn male_fokusring(c: *mut Ctx, e: *mut element.Element) {
    if !element.el_ist_fokus(e) || element.el_ist_sperr(e) {
        return
    }
    let z: *mut zeichnen.Zeichner = ctx_zeichner(c)
    let m: *mut marke.Marke = ctx_marke(c)
    let f: *mut marke.Farben = marke.marke_farben(m)
    let fo: *mut marke.Form = marke.marke_form(m)
    let sz: *mut stil.Satz = element.el_satz(e)
    let art: u32 = element.el_art(e)
    let r: f64 = laenge_von(c, stil.loese_zahl(sz, stil.S_RADIUS,
        (*stil.satz_stil(sz)).radius as usize, wid_radius(c, art)))
    zeichnen.ring(z, element.el_x(e), element.el_y(e), element.el_w(e),
        element.el_h(e), r, laenge_von(c, (*fo).fokus), (*f).akzent)
}

// ======================================================================
// DER TEXT EINES ELEMENTS
// ======================================================================
//
// Waagerecht nach der Ausrichtung, senkrecht IMMER mittig zur
// Schriftmetrik -- das ist Justins Beschwerde 1, und der Grund steht
// in zeichnen.text_mitte_y: wer mit der Zeilenhoehe zentriert,
// zentriert die Zeile und nicht die Schrift.
fn male_text(c: *mut Ctx, e: *mut element.Element) {
    if element.el_text_len(e) == 0 {
        return
    }
    let z: *mut zeichnen.Zeichner = ctx_zeichner(c)
    let sz: *mut stil.Satz = element.el_satz(e)
    let s: *mut stil.Stil = stil.satz_stil(sz)
    let art: u32 = element.el_art(e)
    let zu: u32 = element.el_zustand(e)

    // Die Textfarbe. Bei einem gesperrten Element ist die Vorgabe die
    // blasse -- aber ein gesetzter Stil schlaegt sie, sonst koennte man
    // die Farbe eines gesperrten Elements nicht bestimmen.
    var vorgabe: u32 = wid_text(art)
    if zu == stil.ZU_SPERR {
        vorgabe = stil.farb_token(stil.TK_TEXT_GESPERRT)
    }
    let tf: u32 = stil.loese_textfarbe(sz, zu, vorgabe)
    if !stil.farb_ist_sichtbar(tf) {
        return
    }
    let px: f64 = laenge_von(c, stil.loese_zahl(sz, stil.S_FONT_PX,
        (*s).font_px as usize, wid_font(c)))
    let padx: f64 = laenge_von(c, stil.loese_zahl(sz, stil.S_PAD_X,
        (*s).pad_x as usize, wid_pad_x(c, art)))
    var aus: u32 = wid_ausricht(art)
    if ((*s).gesetzt & stil.S_AUSRICHT) != 0 as u32 {
        aus = (*s).ausricht as u32
    }
    let base: f64 = zeichnen.text_mitte_y(z, element.el_y(e),
        element.el_h(e), px)
    let e2: f64 = zeichnen.text(z, element.el_x(e) + padx, base,
        element.el_w(e) - 2.0 * padx, px, farbe_von(c, tf),
        element.el_text(e), element.el_text_len(e), aus)
}

// ======================================================================
// DIE ELEMENTE
// ======================================================================

// EINE BESCHRIFTUNG. Text, sonst nichts -- und darum ist ihr
// Hintergrund von Haus aus transparent (`wid_hg`). Sie ist das
// einfachste Element und zeigt, dass der Aufbau traegt: sie hat keine
// einzige eigene Zeile Zeichencode.
fn male_beschriftung(c: *mut Ctx, e: *mut element.Element) {
    male_grund(c, e)
    male_text(c, e)
    male_fokusring(c, e)
}

// EIN KNOPF. Derselbe Aufbau -- der Unterschied steckt allein in den
// Widget-Vorgaben (Fuellung statt transparent, Text mittig statt
// links).
fn male_knopf(c: *mut Ctx, e: *mut element.Element) {
    male_grund(c, e)
    male_text(c, e)
    male_fokusring(c, e)
}

// DER VERTEILER. Ein Element malen, ohne zu wissen, was es ist -- das
// braucht die Anordnung, und es ist die Stelle, an der ein neues
// Element eingehaengt wird.
fn male_element(c: *mut Ctx, e: *mut element.Element) {
    let art: u32 = element.el_art(e)
    if art == element.AR_BESCHRIFTUNG {
        male_beschriftung(c, e)
        return
    }
    // Knopf, Umschalter, Ankreuzfeld, Reiter, Kachel ... alle malen
    // heute denselben Grund. Was sie unterscheidet, sind die
    // Widget-Vorgaben und -- ab Welle 2 -- ihr Inhalt.
    male_knopf(c, e)
}
