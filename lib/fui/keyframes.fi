import fui.anim
import fui.render

export { phase, pingpong, ring_wave, spin, blink, request_frame, ease_in_out, ease_out }

const WAVE_END: f64 = 0.7

fn request_frame(c: *mut render.Ctx) {
    let reg: u64 = render.ctx_anim_reg(c)
    if reg != 0 {
        anim.chan_mark(reg as *mut anim.TransReg)
    }
}

fn ease_in_out(t: f64) -> f64 {
    var e: anim.Easing = anim.easing_named(anim.EASE_IN_OUT)
    return anim.ease_eval(&e, t)
}

fn ease_out(t: f64) -> f64 {
    var e: anim.Easing = anim.easing_named(anim.EASE_OUT)
    return anim.ease_eval(&e, t)
}

fn phase(c: *mut render.Ctx, period_ms: i64, offset_ms: i64) -> f64 {
    request_frame(c)
    if period_ms < 1 {
        return 0.0
    }
    var t: i64 = (render.ctx_time(c) + offset_ms) % period_ms
    if t < 0 {
        t = t + period_ms
    }
    return (t as f64) / (period_ms as f64)
}

fn pingpong(c: *mut render.Ctx, period_ms: i64, from: f64, to: f64) -> f64 {
    let p: f64 = phase(c, period_ms, 0)
    var tri: f64 = 2.0 * p
    if p >= 0.5 {
        tri = 2.0 - 2.0 * p
    }
    return from + (to - from) * ease_in_out(tri)
}

fn ring_wave(c: *mut render.Ctx, period_ms: i64) -> f64 {
    let p: f64 = phase(c, period_ms, 0)
    if p >= WAVE_END {
        return 1.0
    }
    return ease_out(p / WAVE_END)
}

fn spin(c: *mut render.Ctx, period_ms: i64) -> f64 {
    return phase(c, period_ms, 0)
}

fn blink(c: *mut render.Ctx, period_ms: i64, low: f64) -> f64 {
    let p: f64 = phase(c, period_ms, 0)
    if p < 0.5 {
        return 1.0
    }
    return low
}
