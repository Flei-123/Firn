import fui.editor
import fui.app
import term.terminput

export { map_key }

const KEY_F2_CODE: u32 = 101
const FN_KEY_COUNT: u32 = 12

fn map_key(key: u32) -> u32 {
    if key == editor.KEY_LEFT { return terminput.TK_LEFT }
    if key == editor.KEY_RIGHT { return terminput.TK_RIGHT }
    if key == editor.KEY_UP { return terminput.TK_UP }
    if key == editor.KEY_DOWN { return terminput.TK_DOWN }
    if key == editor.KEY_HOME { return terminput.TK_HOME }
    if key == editor.KEY_END { return terminput.TK_END }
    if key == editor.KEY_PGUP { return terminput.TK_PGUP }
    if key == editor.KEY_PGDN { return terminput.TK_PGDN }
    if key == editor.KEY_DELETE { return terminput.TK_DELETE }
    if key == editor.KEY_BACKSPACE { return terminput.TK_BACKSPACE }
    if key == editor.KEY_ENTER { return terminput.TK_ENTER }
    if key == editor.KEY_TAB { return terminput.TK_TAB }
    if key == editor.KEY_ESC { return terminput.TK_ESC }
    if key == app.KEYX_F5 { return terminput.TK_F1 + 4 as u32 }
    if key == KEY_F2_CODE { return terminput.TK_F1 + 1 as u32 }
    if key == app.KEYX_INSERT { return terminput.TK_INSERT }
    if key >= app.KEYX_FN_BASE && key < app.KEYX_FN_BASE + FN_KEY_COUNT { return terminput.TK_F1 + (key - app.KEYX_FN_BASE) }
    return 0 as u32
}
