profile kernel
// SPDX-License-Identifier: GPL-2.0-only
// lib/fui/layout.fi -- WO DIE ELEMENTE LIEGEN.
//
// ====================================================== WARUM ES SIE GIBT
//
// Ohne Anordnung ist eine Bedienelement-Sammlung keine
// WinForms-Alternative, sondern eine Sammlung von Rechtecken, deren
// Stellen jemand von Hand ausrechnet. Genau das steht heute in
// lib/browser/chrome.fi: `BTN_X0 = 6`, `btn_x(i) = BTN_X0 + i * (BTN +
// BTN_GAP)`, `feld_x() = btn_x(2) + BTN + FELD_LUECKE`. Das
// funktioniert fuer EINE Leiste mit DREI Knoepfen und faellt um, sobald
// ein vierter dazukommt.
//
// ==================================================== WARUM IM KERN
//
// `profile kernel` in Zeile 1. Eine Anordnung rechnet nur -- sie malt
// nicht und fordert keinen Speicher an. Damit kann der Fenstermanager
// von OrientOS seine Titelleiste mit derselben Anordnung legen how eine
// Anwendung ihre Werkzeugleiste.
//
// GANZZAHLIG, how alles im Kern (SPEC 2: kein Fliesskomma ohne
// `#[allow_fp]`). Das passt zur Sache: eine Bildpunktstelle ist eine
// ganze Zahl, und eine Anordnung, die auf halbe Bildpunkte rechnet,
// erzeugt genau die unscharfen Kanten, die man dann nicht mehr
// loswird.
//
// ================================================== DIE ZWEI DURCHGAENGE
//
// Jede Anordnung, die etwas taugt, laeuft zweimal:
//
//   1. MESSEN   Wie size will jedes Kind sein? (`pref`)
//   2. LEGEN    Der Platz wird verteilt; wer dehnbar ist, bekommt den
//               Rest.
//
// Getrennt, weil der zweite Durchgang das Ergebnis des ersten braucht:
// erst wenn alle Wuensche bekannt sind, weiss man, wieviel ueberhaupt
// uebrig ist.
//
// ================================================== WAS HIER NICHT STEHT
//
// A1 KEINE Kinderliste im Behaelter. Der Aufrufer haelt sein Feld von
//    Elementen selbst und reicht Zeiger herein. Ein Baum align Zeigern
//    waere das Ende der Allokationsfreiheit -- und im Kern gibt es
//    keinen Allokator, der ihn bauen koennte.
// A2 KEINE Verschachtelung ueber Zeiger. Wer ein Grid in einem
//    Box braucht, rechnet den inneren Rect align und ruft die
//    innere Anordnung darauf. Das ist eine Zeile mehr und kostet keine
//    Allokation.

export {
    Rect, rect_new, rect_x, rect_y, rect_w, rect_h,
    rect_shrink, rect_offset,
    Box, box_new, box_set_margin, box_set_gap,
    box_set_align, box_measure, box_layout,
    Grid, grid_new, grid_set_margin, grid_set_gap,
    grid_cell,
    distribute, center_in, align_in,
    HORIZONTAL, VERTICAL,
    ALIGN_START, ALIGN_MID, ALIGN_END, ALIGN_STRETCH,
}

const HORIZONTAL: u32 = 0
const VERTICAL: u32 = 1

// Wie ein Kind QUER zur Stapelrichtung liegt.
const ALIGN_START: u32 = 0
const ALIGN_MID: u32 = 1
const ALIGN_END: u32 = 2
const ALIGN_STRETCH: u32 = 3

// ============================================================ DER KASTEN
//
// Ein Rechteck in Bildpunkten. Die Waehrung der ganzen Anordnung.
struct Rect {
    x: i64,
    y: i64,
    w: i64,
    h: i64,
}

fn rect_new(x: i64, y: i64, w: i64, h: i64) -> Rect {
    return Rect { x: x, y: y, w: w, h: h }
}

fn rect_x(k: *mut Rect) -> i64 { return (*k).x }
fn rect_y(k: *mut Rect) -> i64 { return (*k).y }
fn rect_w(k: *mut Rect) -> i64 { return (*k).w }
fn rect_h(k: *mut Rect) -> i64 { return (*k).h }

// Einen Rect um `border_w` nach inner ziehen. NIE unter null: ein
// Innenrand, der groesser ist als der Rect, ergibt einen leeren
// Rect und keinen negativen -- in `usize` waere das der Ueberlauf,
// an dem Justins Startmenue in OrientOS gestorben ist.
fn rect_shrink(k: Rect, left: i64, top: i64, right: i64,
    bottom: i64) -> Rect {
    var o: Rect = Rect { x: k.x + left, y: k.y + top,
        w: k.w - left - right, h: k.h - top - bottom }
    if o.w < 0 {
        o.w = 0
    }
    if o.h < 0 {
        o.h = 0
    }
    return o
}

fn rect_offset(k: Rect, dx: i64, dy: i64) -> Rect {
    return Rect { x: k.x + dx, y: k.y + dy, w: k.w, h: k.h }
}

// ============================================================ DER STAPEL
//
// Eine Reihe von Kindern, waagerecht oder vertical. Das ist die
// Anordnung, die neun von zehn Oberflaechen brauchen: eine Leiste, eine
// Knopfreihe, eine Spalte in einem Dialog.
struct Box {
    dir: u32,
    rand_l: i64,
    rand_o: i64,
    rand_r: i64,
    rand_u: i64,
    gap: i64,
    align: u32,   // quer zur Richtung
}

fn box_new(dir: u32) -> Box {
    return Box { dir: dir, rand_l: 0, rand_o: 0,
        rand_r: 0, rand_u: 0, gap: 0, align: ALIGN_STRETCH }
}

fn box_set_margin(s: *mut Box, l: i64, o: i64, r: i64, u: i64) {
    (*s).rand_l = l
    (*s).rand_o = o
    (*s).rand_r = r
    (*s).rand_u = u
}

fn box_set_gap(s: *mut Box, a: i64) { (*s).gap = a }

fn box_set_align(s: *mut Box, a: u32) { (*s).align = a }

// ---- DURCHGANG 1: MESSEN
//
// Wieviel Platz braucht ein Box mindestens? `pref` ist ein Feld
// der Wunschgroessen IN Stapelrichtung, `n` seine Laenge.
//
// Der Aufrufer haelt das Feld (A1). Zurueck kommt die Summe samt
// Abstaenden und Raendern.
fn box_measure(s: *mut Box, pref: *mut i64, n: usize) -> i64 {
    var summe: i64 = 0
    var i: usize = 0
    while i < n {
        summe = summe + *((pref as u64 + (i * 8) as u64) as *mut i64)
        i = i + 1
    }
    if n > 1 {
        summe = summe + (*s).gap * ((n - 1) as i64)
    }
    if (*s).dir == HORIZONTAL {
        return summe + (*s).rand_l + (*s).rand_r
    }
    return summe + (*s).rand_o + (*s).rand_u
}

// ---- DURCHGANG 2: LEGEN
//
// Verteilt `space` auf `n` Kinder und schreibt die fertigen Kaesten nach
// `align`. `pref` ist die gewuenschte Groesse in Stapelrichtung,
// `grow` sagt je Kind, ob es den Rest mitnehmen darf (0/1), `quer` die
// gewuenschte Groesse QUER zur Richtung.
//
// DIE VERTEILUNG DES RESTES ist die Stelle, an der eine Anordnung
// entweder stimmt oder um einen Bildpunkt danebenliegt: der Rest einer
// Ganzzahldivision wird auf die ERSTEN Dehnbaren verteilt, einer je
// Kind. Damit ist die Summe der Teile GENAU der Raum -- und nicht einer
// weniger, was man an der rechten Kante sieht.
fn box_layout(s: *mut Box, space: Rect, pref: *mut i64,
    grow: *mut i64, cross: *mut i64, align: *mut Rect, n: usize) {
    let inner: Rect = rect_shrink(space, (*s).rand_l, (*s).rand_o,
        (*s).rand_r, (*s).rand_u)
    // Wieviel ist gewuenscht, wieviel ist dehnbar?
    var summe: i64 = 0
    var dehnbare: i64 = 0
    var i: usize = 0
    while i < n {
        summe = summe + ld(pref, i)
        if ld(grow, i) != 0 {
            dehnbare = dehnbare + 1
        }
        i = i + 1
    }
    var luecken: i64 = 0
    if n > 1 {
        luecken = (*s).gap * ((n - 1) as i64)
    }
    var total: i64 = inner.w
    if (*s).dir == VERTICAL {
        total = inner.h
    }
    var rest: i64 = total - summe - luecken
    if rest < 0 {
        rest = 0
    }
    // Der Zuschlag je dehnbarem Kind, und der Rest davon.
    var zuschlag: i64 = 0
    var extra: i64 = 0
    if dehnbare > 0 {
        zuschlag = rest / dehnbare
        extra = rest - zuschlag * dehnbare
    }
    // Legen.
    var lauf: i64 = inner.x
    if (*s).dir == VERTICAL {
        lauf = inner.y
    }
    var j: usize = 0
    while j < n {
        var groesse: i64 = ld(pref, j)
        if ld(grow, j) != 0 {
            groesse = groesse + zuschlag
            if extra > 0 {
                groesse = groesse + 1
                extra = extra - 1
            }
        }
        if groesse < 0 {
            groesse = 0
        }
        // Quer zur Richtung
        let q_ganz: i64 = cross_size(s, &inner)
        var q_gross: i64 = ld(cross, j)
        if (*s).align == ALIGN_STRETCH || q_gross <= 0 || q_gross > q_ganz {
            q_gross = q_ganz
        }
        var q_pos: i64 = cross_pos(s, &inner)
        if (*s).align == ALIGN_MID {
            q_pos = q_pos + (q_ganz - q_gross) / 2
        } else if (*s).align == ALIGN_END {
            q_pos = q_pos + q_ganz - q_gross
        }
        if (*s).dir == HORIZONTAL {
            store_rect(align, j, rect_new(lauf, q_pos, groesse, q_gross))
        } else {
            store_rect(align, j, rect_new(q_pos, lauf, q_gross, groesse))
        }
        lauf = lauf + groesse + (*s).gap
        j = j + 1
    }
}

fn cross_size(s: *mut Box, inner: *mut Rect) -> i64 {
    if (*s).dir == HORIZONTAL {
        return (*inner).h
    }
    return (*inner).w
}

fn cross_pos(s: *mut Box, inner: *mut Rect) -> i64 {
    if (*s).dir == HORIZONTAL {
        return (*inner).y
    }
    return (*inner).x
}

// Feldzugriff ohne Allokation. Firn Stufe 0 hat keine Scheiben, also
// rechnet der Zugriff selbst -- an EINER Stelle, damit die
// Adressrechnung nicht ueberall steht.
fn ld(f: *mut i64, i: usize) -> i64 {
    return *((f as u64 + (i * 8) as u64) as *mut i64)
}

fn store_rect(f: *mut Rect, i: usize, k: Rect) {
    *((f as u64 + (i * 32) as u64) as *mut Rect) = k
}

// ============================================================ DAS RASTER
//
// Spalten mal Zeilen, gleich breit. Reicht fuer Dialoge, Kacheln, eine
// Tastatur -- und wer verschiedene Spaltenbreiten braucht, legt zwei
// Box ineinander (A2).
struct Grid {
    cols: usize,
    rows: usize,
    rand_l: i64,
    rand_o: i64,
    rand_r: i64,
    rand_u: i64,
    ab_x: i64,
    ab_y: i64,
}

fn grid_new(cols: usize, rows: usize) -> Grid {
    return Grid { cols: cols, rows: rows, rand_l: 0,
        rand_o: 0, rand_r: 0, rand_u: 0, ab_x: 0, ab_y: 0 }
}

fn grid_set_margin(r: *mut Grid, l: i64, o: i64, re: i64, u: i64) {
    (*r).rand_l = l
    (*r).rand_o = o
    (*r).rand_r = re
    (*r).rand_u = u
}

fn grid_set_gap(r: *mut Grid, x: i64, y: i64) {
    (*r).ab_x = x
    (*r).ab_y = y
}

// Die Zelle (`col_i`, `ze`) in `space`.
//
// GERECHNET UND NICHT AUFADDIERT: die Stelle jeder Zelle kommt align
// ihrer Nummer, nicht align der Summe der vorherigen. Damit haeuft sich
// kein Rundungsfehler an, und die letzte Spalte endet genau an der
// Kante -- der Fehler, den man sonst erst bei zwoelf Spalten sieht.
fn grid_cell(r: *mut Grid, space: Rect, col_i: usize,
    ze: usize) -> Rect {
    if (*r).cols == 0 || (*r).rows == 0 {
        return rect_new(space.x, space.y, 0, 0)
    }
    let inner: Rect = rect_shrink(space, (*r).rand_l, (*r).rand_o,
        (*r).rand_r, (*r).rand_u)
    let nsp: i64 = (*r).cols as i64
    let nze: i64 = (*r).rows as i64
    let ganz_x: i64 = inner.w - (*r).ab_x * (nsp - 1)
    let ganz_y: i64 = inner.h - (*r).ab_y * (nze - 1)
    let i: i64 = col_i as i64
    let j: i64 = ze as i64
    // Kante left = Anfang + i-tel des Ganzen; Kante right = (i+1)-tel.
    // Die Breite ist ihre Differenz -- so summieren sich die Spalten
    // exakt auf `ganz_x`.
    var x0: i64 = 0
    var x1: i64 = 0
    if ganz_x > 0 {
        x0 = ganz_x * i / nsp
        x1 = ganz_x * (i + 1) / nsp
    }
    var y0: i64 = 0
    var y1: i64 = 0
    if ganz_y > 0 {
        y0 = ganz_y * j / nze
        y1 = ganz_y * (j + 1) / nze
    }
    return rect_new(inner.x + x0 + (*r).ab_x * i,
        inner.y + y0 + (*r).ab_y * j, x1 - x0, y1 - y0)
}

// ====================================================== KLEINE HELFER

// `n` Teile auf `total` verteilen, Rest auf die ersten. Zurueck kommt
// die Groesse des `i`-ten Teils. Dieselbe Rechnung how im Grid --
// hier fuer den Aufrufer, der von Hand verteilt.
fn distribute(total: i64, n: usize, i: usize) -> i64 {
    if n == 0 {
        return 0
    }
    let a: i64 = total * (i as i64) / (n as i64)
    let b: i64 = total * ((i + 1) as i64) / (n as i64)
    return b - a
}

// Ein Stueck der Groesse `size` mittig in `total`. Der Rest faellt nach
// bottom/right -- eine Entscheidung, die einmal getroffen sein muss,
// damit zwei Elemente nebeneinander gleich sitzen.
fn center_in(total: i64, size: i64) -> i64 {
    if size >= total {
        return 0
    }
    return (total - size) / 2
}

fn align_in(total: i64, size: i64, how: u32) -> i64 {
    if how == ALIGN_MID {
        return center_in(total, size)
    }
    if how == ALIGN_END {
        if size >= total {
            return 0
        }
        return total - size
    }
    return 0
}
