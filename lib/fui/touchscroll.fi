// SPDX-License-Identifier: MPL-2.0
// lib/fui/touchscroll.fi -- finger drag and fling for scroll areas (lay.scroll_v): the pan gesture of the event router drives the viewport.

import fui.app
import fui.event
import fui.scene
import fui.viewport
import fui.render
import plat.fuiwirt

export {
    pan_handler, pan_apply, fling_start, register,
}

const FLING_DP: usize = 160

fn pan_apply(vp: *mut viewport.Viewport, dx: f64, dy: f64, now_ms: i64) -> bool {
    let ox: f64 = viewport.viewport_off_x(vp)
    let oy: f64 = viewport.viewport_off_y(vp)
    let px: f64 = viewport.viewport_over_x(vp)
    let py: f64 = viewport.viewport_over_y(vp)
    viewport.viewport_set_overscroll(vp, true)
    viewport.viewport_drag(vp, 0.0 - dx, 0.0 - dy, now_ms)
    return viewport.viewport_off_x(vp) != ox || viewport.viewport_off_y(vp) != oy
        || viewport.viewport_over_x(vp) != px || viewport.viewport_over_y(vp) != py
}

fn fling_start(vp: *mut viewport.Viewport, vx_per_s: f64, vy_per_s: f64, now_ms: i64, px_per_160dp: f64) {
    viewport.viewport_fling_android(vp, 0.0 - vx_per_s / 1000.0, 0.0 - vy_per_s / 1000.0, now_ms, px_per_160dp)
}

fn pan_handler(ud: u64, e: *mut event.Ev) -> u32 {
    let a: *mut app.App = ud as *mut app.App
    let sc: *mut scene.Scene = app.app_scene(a)
    let node: usize = event.ev_current(e)
    if node >= scene.scene_count(sc) {
        return event.H_GO
    }
    let vp: *mut viewport.Viewport = scene.node_viewport(sc, node)
    if vp as u64 == 0 as u64 {
        return event.H_GO
    }
    let kind: u32 = event.ev_kind(e)
    let host: *mut fuiwirt.Host = app.app_host(a)
    if kind == event.EV_PAN_MOVE {
        if pan_apply(vp, event.ev_dx(e), event.ev_dy(e), fuiwirt.host_now(host)) {
            fuiwirt.host_touch(host)
        }
    } else if kind == event.EV_PAN_END && event.ev_fling(e) && viewport.viewport_over_x(vp) == 0.0 && viewport.viewport_over_y(vp) == 0.0 {
        let now: i64 = fuiwirt.host_now(host)
        fling_start(vp, event.ev_vx(e), event.ev_vy(e), now, render.len_of(app.app_ctx(a), FLING_DP))
        fuiwirt.host_touch(host)
    }
    return event.H_STOP
}

fn register(a: *mut app.App, node: usize) -> bool {
    return app.on(a, node, event.EV_PAN_ALL, pan_handler)
}
