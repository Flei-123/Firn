// SPDX-License-Identifier: MPL-2.0
// lib/fui/filedlg.fi -- THE FILE DIALOG OF fUi (open / open several / save / pick a folder).
//
// One window of its own (`run`), built ENTIRELY on lib/fui/app.fi, with real navigation:
//
//   * a place bar: breadcrumb buttons (a click jumps; Ctrl+L or a click on the free part turns it into a
//     path field), Back / Forward / Up / Refresh, "New folder" with an inline name row,
//   * a side list of places (Home, Desktop, Documents ... from XDG user-dirs, "/", the folders visited),
//   * THE FILE LIST: ONE scene node with its own painter, virtualised (only the visible rows are painted,
//     so 5000 entries cost what 15 cost), a header with sortable columns, icons, hover / selection / focus,
//     a scroll bar that can be dragged and clicked, wheel, keyboard, type-to-find,
//   * a name field, a filter chooser (a context menu of radio entries), "Show hidden files",
//   * the overwrite question as a row of its own in the SAME window (Replace? default No),
//   * an OK button that is greyed out while there is nothing valid to accept, a status line.
//
// The data side (reading, sorting, filtering, paths) is lib/fui/filemodel.fi and knows no window.
//
// HOW IT IS USED
//
//     var out: rt.Buf = rt.buf_new()
//     let rc: i32 = filedlg.run(2, "Save as", "/home/justin", "notes.txt", "Text|*.txt|All|*", &out)
//     // rc 0: `out` got the path(s); 1: cancelled or closed; 12: no window possible
//
// modes: 0 open one, 1 open several (paths separated by LF), 2 save, 3 pick a folder. `filters` is the
// "Label|pat;pat|Label2|pat" string of lib/std/dialog.fi ("" = everything).
//
// FOR A TEST OR AN EMBEDDING PROGRAM: `dlg_new` builds the window without running it, `dlg_app` is its
// app.App, and the functions exported below (nav_to, do_ok, set_sort ...) are what the keys and clicks call.
//
// LIMITS (honest): Unix paths only (Windows drives are not part of this round); a path longer than 255
// octets does not fit app.TEXT_CAP and is shown cut; the rows of the list are not separate accessibility
// nodes (the list is one node with role "list"; the focused row's name is in the status line).
import std.rt
