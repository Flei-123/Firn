// SPDX-License-Identifier: MPL-2.0
// lib/fui/looppump.fi -- fUi and the network in ONE thread: the window loop of
// `app.run` also serves an `async.loop` (sockets, timers, WebSocket, HTTP).
//
//     import async.loop
//     import fui.app
//     import fui.looppump
//
//     var l: loop.Loop = loop.loop_new()
//     loop.loop_init(&l)
//     let a: *mut app.App = app.window("chat", 320, 200)
//     looppump.attach(a, &l)          // before app.run
//     ... start requests / WebSockets on &l, their callbacks may call app.set_text ...
//     app.run(a)
//
// HOW IT WORKS. `app.run` sleeps in the window wait. With the pump attached it
// wakes up on the loop's descriptor as well (`loop.loop_fd`, readable while a
// watched descriptor is ready), sleeps no longer than the next timer
// (`loop.embed_wait_ms`) and, once per turn, runs `loop.run_once(&l, 0)`. When
// the loop did anything (an event, a timer, a deferred call) the window is
// repainted, so a callback only needs to change the app's state.
// A window event wins over the network (window.wait_any_fd), so a busy
// connection cannot starve the keyboard. Idle costs no CPU.
//
// HONEST
//   P1  The loop and the UI are the SAME thread: a callback that blocks
//       (async.ahttp resolves names blocking, ahttp H2) freezes the window.
//   P2  With a text input method (fuiime.enable) two descriptors would have to
//       be watched; the window wait takes one, so the pump is then looked at
//       every 10 ms. Without it the sleep is as long as the loop allows.
//   P3  Where the loop has no pollable descriptor (poll backend) the sleep is
//       capped at 10 ms by `embed_wait_ms`.
//   P4  `app.run` in a browser page has no pump (the page's own loop serves
//       fetch / WebSocket); this library needs the Linux/Windows async stack.
import async.loop
import std.time
import fui.app
import fui.scene

export {
    attach, quiet_done,
}

fn pump_fd(ud: u64) -> i32 {
    return loop.loop_fd(ud as *mut loop.Loop)
}

fn pump_ms(ud: u64, wanted: i64) -> i64 {
    return loop.embed_wait_ms(ud as *mut loop.Loop, wanted)
}

// QUIET TIMERS. Every pump step that did anything repaints the whole window (the loop cannot know what a callback changed). A periodic
// housekeeping timer (poll a flag, look at the keyboard) would so cost a full frame every period (a56: 10 frames/s in idle). Such a
// callback ends with quiet_done(); a step in which ONLY quiet callbacks ran and the scene was not edited (scene.scene_epoch) paints
// nothing. Net events, other timers and every scene edit still repaint; a heartbeat repaints at least every QUIET_BEAT_MS anyway.
const QUIET_BEAT_MS: i64 = 3000
static mut QUIET_HITS: u64 = 0
static mut QUIET_LAST_NS: i64 = 0

fn quiet_done() {
    QUIET_HITS = QUIET_HITS + (1 as u64)
}

fn pump_step(ud: u64) -> bool {
    let e0: u64 = scene.scene_epoch()
    QUIET_HITS = 0 as u64
    let n: u64 = loop.run_once(ud as *mut loop.Loop, 0)
    if n == (0 as u64) { return false }
    let now: i64 = time.now_unix_ns()
    if n == QUIET_HITS && scene.scene_epoch() == e0 && now - QUIET_LAST_NS < QUIET_BEAT_MS * 1000000 {
        return false
    }
    QUIET_LAST_NS = now
    return true
}

fn attach(a: *mut app.App, l: *mut loop.Loop) {
    app.set_pump(a, l as u64, pump_fd, pump_ms, pump_step)
}
