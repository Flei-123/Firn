import std.clipboard
import services.svc
import services.svcclip
import services.svcdialog

export { clip_copy, message, confirm }

const SERVE_MS: i64 = 400

fn clip_copy(s: str) -> bool {
    let ok: bool = svcclip.copy_text(s) == svc.OK
    if ok && svc.backend_name() == "native" {
        clipboard.serve(SERVE_MS)
    }
    return ok
}

fn message(kind: i32, title: str, text: str, buttons: i32) -> i32 {
    var a: i32 = 0
    if svcdialog.message(kind, title, text, buttons, &a) != svc.OK {
        return 0
    }
    return a
}

fn confirm(title: str, text: str) -> bool {
    var yes: bool = false
    if svcdialog.confirm(title, text, &yes) != svc.OK {
        return false
    }
    return yes
}
