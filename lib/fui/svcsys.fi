import std.rt
import std.clipboard
import std.dialog

export { clip_copy, message, confirm }

const SERVE_MS: i64 = 400

fn clip_copy(s: str) -> bool {
    let ok: bool = clipboard.copy_text(s)
    if ok && clipboard.backend_name() == "native" {
        clipboard.serve(SERVE_MS)
    }
    return ok
}

fn message(kind: i32, title: str, text: str, buttons: i32) -> i32 {
    var a: i32 = 0
    if dialog.message(kind, title, text, buttons, &a) != dialog.OK {
        return 0
    }
    return a
}

fn confirm(title: str, text: str) -> bool {
    var yes: bool = false
    if dialog.confirm(title, text, &yes) != dialog.OK {
        return false
    }
    return yes
}
