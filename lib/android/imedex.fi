// SPDX-License-Identifier: MPL-2.0
// lib/android/imedex.fi -- THE TWO CLASSES OF THE INPUT METHOD, AS DEX.
//
// Provenance: the design (a View that lets the keyboard in, an
// InputConnection whose methods are all `native`) is Certus', lib/android/
// imedex.fi, round DEX/MOBIL4, by the sole author Justin; this file is
// written anew for Firn on top of lib/android/dex.fi, with English names
// and one more method (deleteSurroundingTextInCodePoints).
//
// WHAT IS BUILT, AS JAVA:
//
//     package org.firn;
//     public class ImeView extends android.view.View {
//         public static boolean e;                    // "a text is edited"
//         public ImeView(Context c) { super(c); }
//         public boolean onCheckIsTextEditor() { return e; }
//         public native InputConnection onCreateInputConnection(EditorInfo i);
//     }
//     public class ImeConn extends android.view.inputmethod.BaseInputConnection {
//         public ImeConn(View v, boolean full) { super(v, full); }
//         public native boolean commitText(CharSequence t, int p);
//         ... fifteen more, all `native`
//     }
//
// WHY SO LITTLE BYTECODE. A `native` method may override a Java method: it
// has no body, so no bytecode -- its body is a Firn function that
// `RegisterNatives` hangs onto it (lib/android/inputmethod.fi). Only three
// methods need instructions at all: the two constructors and
// onCheckIsTextEditor (a static field read). Seven instructions in all.
//
// WHY A VIEW AT ALL. The input method service asks the FOCUSED VIEW for its
// InputConnection (`View.onCreateInputConnection`). The NativeContentView of
// a NativeActivity does not override it, so the default answers null and
// Android says "showSoftInput() ignored, view is not served". A class of our
// own is the only way out, and a class needs bytecode: so it is made here, in
// memory, at the first use.
import android.dex

export {
    imedex_build, CLS_VIEW, CLS_CONN, CLS_VIEW_DOT, CLS_CONN_DOT,
}

// Class names: JNI (slashes) for FindClass, dotted for loadClass.
const CLS_VIEW: str = "org/firn/ImeView\0"
const CLS_CONN: str = "org/firn/ImeConn\0"
const FIELD_E: str = "e"
const CLS_VIEW_DOT: str = "org.firn.ImeView\0"
const CLS_CONN_DOT: str = "org.firn.ImeConn\0"

#[no_gc]
fn t_(d: u64, s: str) -> u32 {
    return dex.dex_typ(d, s.p as u64, s.n)
}

#[no_gc]
fn m_(d: u64, cls: u32, pro: u32, s: str) -> u32 {
    return dex.dex_method(d, cls, pro, s.p as u64, s.n)
}

// `d` is a set from `dex.dex_neu()`. False when the writer ran out of room;
// then `dex.dex_error` is above zero and NOTHING must be loaded.
#[no_gc]
fn imedex_build(d: u64) -> bool {
    if d == 0 {
        return false
    }
    // ------------------------------------------------------- types
    let t_a: u32 = t_(d, "Lorg/firn/ImeView;")
    let t_b: u32 = t_(d, "Lorg/firn/ImeConn;")
    let t_view: u32 = t_(d, "Landroid/view/View;")
    let t_ctx: u32 = t_(d, "Landroid/content/Context;")
    let t_ei: u32 = t_(d, "Landroid/view/inputmethod/EditorInfo;")
    let t_ic: u32 = t_(d, "Landroid/view/inputmethod/InputConnection;")
    let t_bic: u32 = t_(d, "Landroid/view/inputmethod/BaseInputConnection;")
    let t_key: u32 = t_(d, "Landroid/view/KeyEvent;")
    let t_cs: u32 = t_(d, "Ljava/lang/CharSequence;")
    let t_v: u32 = t_(d, "V")
    let t_z: u32 = t_(d, "Z")
    let t_i: u32 = t_(d, "I")
    let t_ta: u32 = t_(d, "Landroid/view/inputmethod/TextAttribute;")
    let t_st: u32 = t_(d, "Landroid/view/inputmethod/SurroundingText;")
    let t_etr: u32 = t_(d, "Landroid/view/inputmethod/ExtractedTextRequest;")
    let t_et: u32 = t_(d, "Landroid/view/inputmethod/ExtractedText;")

    // ---------------------------------------------------- prototypes
    var ar: [u32; 5] = [0 as u32; 5]
    let par: u64 = (&ar[0]) as u64
    ar[0] = t_ctx
    let p_ctx_v: u32 = dex.dex_proto(d, t_v, par, 1)
    ar[0] = t_ei
    let p_ei_ic: u32 = dex.dex_proto(d, t_ic, par, 1)
    let p_z: u32 = dex.dex_proto(d, t_z, par, 0)
    ar[0] = t_view
    ar[1] = t_z
    let p_viewz_v: u32 = dex.dex_proto(d, t_v, par, 2)
    ar[0] = t_cs
    ar[1] = t_i
    let p_csi_z: u32 = dex.dex_proto(d, t_z, par, 2)
    ar[0] = t_i
    ar[1] = t_i
    let p_ii_z: u32 = dex.dex_proto(d, t_z, par, 2)
    let p_ii_cs: u32 = dex.dex_proto(d, t_cs, par, 2)
    ar[0] = t_key
    let p_key_z: u32 = dex.dex_proto(d, t_z, par, 1)
    ar[0] = t_i
    let p_i_cs: u32 = dex.dex_proto(d, t_cs, par, 1)
    let p_i_i: u32 = dex.dex_proto(d, t_i, par, 1)
    let p_i_z: u32 = dex.dex_proto(d, t_z, par, 1)
    // replaceText(int, int, CharSequence, int, TextAttribute) (API 34)
    ar[0] = t_i
    ar[1] = t_i
    ar[2] = t_cs
    ar[3] = t_i
    ar[4] = t_ta
    let p_repl: u32 = dex.dex_proto(d, t_z, par, 5)
    // getSurroundingText(int, int, int) (API 31)
    ar[0] = t_i
    ar[1] = t_i
    ar[2] = t_i
    let p_iii_st: u32 = dex.dex_proto(d, t_st, par, 3)
    // getExtractedText(ExtractedTextRequest, int)
    ar[0] = t_etr
    ar[1] = t_i
    let p_etri_et: u32 = dex.dex_proto(d, t_et, par, 2)

    // ------------------------------------------------------ methods
    // The first two belong to the FRAMEWORK: they stand in `method_ids` so
    // that `invoke-direct` can name them, but in neither class.
    let m_super_a: u32 = m_(d, t_view, p_ctx_v, "<init>")
    let m_super_b: u32 = m_(d, t_bic, p_viewz_v, "<init>")

    let m_a_init: u32 = m_(d, t_a, p_ctx_v, "<init>")
    let m_a_ocic: u32 = m_(d, t_a, p_ei_ic, "onCreateInputConnection")
    let m_a_edit: u32 = m_(d, t_a, p_z, "onCheckIsTextEditor")

    let m_b_init: u32 = m_(d, t_b, p_viewz_v, "<init>")
    let m_b_commit: u32 = m_(d, t_b, p_csi_z, "commitText")
    let m_b_setcmp: u32 = m_(d, t_b, p_csi_z, "setComposingText")
    let m_b_fincmp: u32 = m_(d, t_b, p_z, "finishComposingText")
    let m_b_delsur: u32 = m_(d, t_b, p_ii_z, "deleteSurroundingText")
    let m_b_delcp: u32 = m_(d, t_b, p_ii_z, "deleteSurroundingTextInCodePoints")
    let m_b_sendk: u32 = m_(d, t_b, p_key_z, "sendKeyEvent")
    let m_b_before: u32 = m_(d, t_b, p_ii_cs, "getTextBeforeCursor")
    let m_b_after: u32 = m_(d, t_b, p_ii_cs, "getTextAfterCursor")
    let m_b_sel: u32 = m_(d, t_b, p_i_cs, "getSelectedText")
    let m_b_caps: u32 = m_(d, t_b, p_i_i, "getCursorCapsMode")
    let m_b_action: u32 = m_(d, t_b, p_i_z, "performEditorAction")
    let m_b_setsel: u32 = m_(d, t_b, p_ii_z, "setSelection")
    let m_b_setreg: u32 = m_(d, t_b, p_ii_z, "setComposingRegion")
    let m_b_replace: u32 = m_(d, t_b, p_repl, "replaceText")
    let m_b_surr: u32 = m_(d, t_b, p_iii_st, "getSurroundingText")
    let m_b_extract: u32 = m_(d, t_b, p_etri_et, "getExtractedText")

    // -------------------------------------------------------- field
    let f_e: u32 = dex.dex_field(d, t_a, t_z, FIELD_E.p as u64, FIELD_E.n)

    // --------------------------------------------------------- code
    // ImeView.<init>(Context c) { super(c); }
    //   regs = 2, ins = 2  ->  p0 = v0 (this), p1 = v1 (c)
    let c_a_init: i32 = dex.dex_code(d, 2 as u32, 2 as u32, 2 as u32)
    dex.dex_op35c(d, c_a_init, dex.OP_INVOKE_DIRECT, 2 as u32, m_super_a,
        0 as u32, 1 as u32, 0 as u32, 0 as u32, 0 as u32)
    dex.dex_op10x(d, c_a_init, dex.OP_RETURN_VOID)

    // ImeView.onCheckIsTextEditor() { return e; }
    //   regs = 2, ins = 1  ->  p0 = v1 (this), v0 is free
    let c_a_edit: i32 = dex.dex_code(d, 2 as u32, 1 as u32, 0 as u32)
    dex.dex_op21c(d, c_a_edit, dex.OP_SGET_BOOLEAN, 0 as u32, f_e)
    dex.dex_op11x(d, c_a_edit, dex.OP_RETURN, 0 as u32)

    // ImeConn.<init>(View v, boolean full) { super(v, full); }
    let c_b_init: i32 = dex.dex_code(d, 3 as u32, 3 as u32, 3 as u32)
    dex.dex_op35c(d, c_b_init, dex.OP_INVOKE_DIRECT, 3 as u32, m_super_b,
        0 as u32, 1 as u32, 2 as u32, 0 as u32, 0 as u32)
    dex.dex_op10x(d, c_b_init, dex.OP_RETURN_VOID)

    // ------------------------------------------------------ classes
    let k_a: u32 = dex.dex_class(d, t_a, dex.ACC_PUBLIC, t_view)
    let k_b: u32 = dex.dex_class(d, t_b, dex.ACC_PUBLIC, t_bic)

    let open: u32 = dex.ACC_PUBLIC
    let nat: u32 = dex.ACC_PUBLIC | dex.ACC_NATIVE
    let ctor: u32 = dex.ACC_PUBLIC | dex.ACC_CONSTRUCTOR

    dex.dex_member(d, k_a, dex.G_STATFELD, f_e,
        dex.ACC_PUBLIC | dex.ACC_STATIC, 0 - 1)
    dex.dex_member(d, k_a, dex.G_DIREKT, m_a_init, ctor, c_a_init)
    dex.dex_member(d, k_a, dex.G_VIRTUELL, m_a_ocic, nat, 0 - 1)
    dex.dex_member(d, k_a, dex.G_VIRTUELL, m_a_edit, open, c_a_edit)

    dex.dex_member(d, k_b, dex.G_DIREKT, m_b_init, ctor, c_b_init)
    dex.dex_member(d, k_b, dex.G_VIRTUELL, m_b_commit, nat, 0 - 1)
    dex.dex_member(d, k_b, dex.G_VIRTUELL, m_b_setcmp, nat, 0 - 1)
    dex.dex_member(d, k_b, dex.G_VIRTUELL, m_b_fincmp, nat, 0 - 1)
    dex.dex_member(d, k_b, dex.G_VIRTUELL, m_b_delsur, nat, 0 - 1)
    dex.dex_member(d, k_b, dex.G_VIRTUELL, m_b_delcp, nat, 0 - 1)
    dex.dex_member(d, k_b, dex.G_VIRTUELL, m_b_sendk, nat, 0 - 1)
    dex.dex_member(d, k_b, dex.G_VIRTUELL, m_b_before, nat, 0 - 1)
    dex.dex_member(d, k_b, dex.G_VIRTUELL, m_b_after, nat, 0 - 1)
    dex.dex_member(d, k_b, dex.G_VIRTUELL, m_b_sel, nat, 0 - 1)
    dex.dex_member(d, k_b, dex.G_VIRTUELL, m_b_caps, nat, 0 - 1)
    dex.dex_member(d, k_b, dex.G_VIRTUELL, m_b_action, nat, 0 - 1)
    dex.dex_member(d, k_b, dex.G_VIRTUELL, m_b_setsel, nat, 0 - 1)
    dex.dex_member(d, k_b, dex.G_VIRTUELL, m_b_setreg, nat, 0 - 1)
    dex.dex_member(d, k_b, dex.G_VIRTUELL, m_b_replace, nat, 0 - 1)
    dex.dex_member(d, k_b, dex.G_VIRTUELL, m_b_surr, nat, 0 - 1)
    dex.dex_member(d, k_b, dex.G_VIRTUELL, m_b_extract, nat, 0 - 1)

    return dex.dex_error(d) == 0 as u32
}
