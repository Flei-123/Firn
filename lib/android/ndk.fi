// SPDX-License-Identifier: MPL-2.0
// Herkunft: Certus, lib/android/ndk.fi, Stand Certus-Commit 9e119268;
// vom alleinigen Urheber Justin am 23.09.2026 fuer Firn unter MPL-2.0
// freigegeben. In Firn dazugekommen: ANativeActivity_finish,
// AConfiguration_getUiModeNight, code_of_thread (lib/android/activity.fi).
// lib/android/ndk.fi -- die duenne Naht zwischen Certus und Android.
//
// Alles, was hier steht, ist ENTWEDER eine `extern fn` auf eine Funktion,
// die Androids eigene Bibliotheken mitbringen (libandroid.so, liblog.so),
// ODER ein Handgriff auf rohem Speicher, weil das Rahmenwerk eine
// C-Struktur herueberreicht und Firn deren Bauplan nicht kennt.
//
// ES IST KEINE ZEILE C DABEI. Das ist der Punkt: der uebliche Weg zu einer
// Android-App aus fremdem Code ist `android_native_app_glue.c` aus dem NDK,
// rund tausend Zeilen C, die den Lebenslauf der Tafel verwalten. Diese
// Datei macht dasselbe in Firn, und darum bleibt Certus ein Programm ohne
// C im ausfuehrbaren Teil.
//
// ZWEI DINGE, DIE GEMESSEN WURDEN UND DIE MAN SONST NICHT AHNT:
//
//  1. EIN FIRN-FUNKTIONSWERT IST NICHT DIE CODEADRESSE.
//     `compiler/src/fnval.rs`: ein Wert vom Typ `fn(..)` ist ein Zeiger auf
//     einen SATZ, dessen erstes Wort die Codeadresse haelt. Wer so einen
//     Wert in Androids Rueckruftafel schreibt, gibt dem Rahmenwerk einen
//     Zeiger auf einen Zeiger -- und das Telefon stuerzt beim ersten
//     Rueckruf ab (in dieser Runde unter qemu-aarch64 nachgestellt: Signal
//     11, siehe docs/MOBIL-BEFUND.md). `code_of1/2/3` holen darum das
//     erste Wort heraus.
//
//  2. FIRN KANN `fn(..)` NICHT NACH `u64` WANDELN.
//     `error: conversion from fn(i64) -> i64 to u64 is not allowed`. Der
//     Umweg ohne Sprachaenderung: den Wert ueber ein STRUKTURFELD in ein
//     `[u64; 1]` schreiben und die Zelle als Zahl lesen. Genau das tun die
//     drei Halter unten.
//
// Die Zahlen der Bauplaene stehen in <android/native_activity.h>,
// <android/native_window.h> und <android/input.h> des NDK r27c und sind
// hier als OFFSETS IN OKTETT festgehalten, weil Firn keine C-Kopfdateien
// liest.
export {
    ANativeWindow_setBuffersGeometry, ANativeWindow_lock,
    ANativeWindow_unlockAndPost, ANativeWindow_getWidth,
    ANativeWindow_getHeight, ANativeWindow_acquire, ANativeWindow_release,
    log_write, LOG_INFO, LOG_WARN, LOG_ERROR,
    ALooper_forThread, AInputQueue_attachLooper, AInputQueue_detachLooper,
    AInputQueue_getEvent, AInputQueue_preDispatchEvent,
    AInputQueue_hasEvents,
    AInputQueue_finishEvent, AInputEvent_getType, AMotionEvent_getAction,
    AMotionEvent_getX, AMotionEvent_getY,
    AAssetManager_open, AAsset_getLength, AAsset_read, AAsset_close,
    peek64, poke64, peek32, poke32,
    code_of1, code_of2, code_of3, code_of4,
    ACT_CALLBACKS, ACT_INTERNAL_PATH, ACT_SDK_VERSION, ACT_ASSET_MANAGER,
    CB_ON_START, CB_ON_RESUME, CB_ON_SAVE, CB_ON_PAUSE, CB_ON_STOP,
    CB_ON_DESTROY, CB_ON_FOCUS, CB_ON_WIN_CREATED, CB_ON_WIN_RESIZED,
    CB_ON_WIN_REDRAW, CB_ON_WIN_DESTROYED, CB_ON_QUEUE_CREATED,
    CB_ON_QUEUE_DESTROYED, CB_ON_RECT, CB_ON_CONFIG, CB_ON_LOWMEM,
    BUF_WIDTH, BUF_HEIGHT, BUF_STRIDE, BUF_FORMAT, BUF_BITS, BUF_SIZE,
    WINDOW_FORMAT_RGBA_8888, WINDOW_FORMAT_RGBX_8888,
    EVENT_TYPE_KEY, EVENT_TYPE_MOTION,
    ACTION_DOWN, ACTION_UP, ACTION_MOVE, ACTION_MASK,
    LOOPER_EVENT_INPUT,
    // RUNDE MOBIL2 -- was die Oberflaeche und der Netzfaden brauchen.
    ALooper_addFd, ALooper_removeFd, ALooper_wake, ALooper_prepare,
    ALooper_pollOnce,
    // RUNDE KERN-3: die Uhr der Schleife (bionic, kein Systemaufruf-Umweg)
    timerfd_create, timerfd_settime,
    ANativeActivity_showSoftInput, ANativeActivity_hideSoftInput,
    AKeyEvent_getAction, AKeyEvent_getKeyCode, AKeyEvent_getMetaState,
    AMotionEvent_getPointerCount, AMotionEvent_getPointerId,
    AMotionEvent_getEventTime, AInputEvent_getSource,
    ALOOPER_EVENT_INPUT, ALOOPER_EVENT_OUTPUT,
    ALOOPER_PREPARE_ALLOW_NON_CALLBACKS,
    SOFT_INPUT_FORCED, SOFT_INPUT_IMPLICIT, HIDE_SOFT_INPUT_NOT_ALWAYS,
    KEY_ACTION_DOWN, KEY_ACTION_UP,
    KEYCODE_BACK, KEYCODE_ENTER, KEYCODE_DEL, KEYCODE_SPACE,
    KEYCODE_NUMPAD_ENTER, KEYCODE_ESCAPE, KEYCODE_DPAD_LEFT,
    KEYCODE_DPAD_RIGHT, KEYCODE_MOVE_HOME, KEYCODE_MOVE_END,
    KEYCODE_FORWARD_DEL, KEYCODE_A, KEYCODE_C, KEYCODE_V, KEYCODE_X,
    META_CTRL, META_SHIFT,
    ACTION_CANCEL, ACTION_POINTER_DOWN, ACTION_POINTER_UP,
    key_char,
    ACT_INTERNAL_DATA_PATH, ACT_EXTERNAL_DATA_PATH,
    // RUNDE MOBIL3 -- die Bildschirmdichte, fuer den Rueckfall bei den
    // Systemleisten.  RUNDE LOKAL -- die Sprache, die das Geraet
    // eingestellt hat. Dieselbe AConfiguration, zwei Fragen an sie.
    AConfiguration_new, AConfiguration_delete,
    AConfiguration_fromAssetManager, AConfiguration_getDensity,
    AConfiguration_getLanguage, AConfiguration_getCountry,
    system_property_get,
    // RUNDE MOBIL4 -- DER BILDTAKT.
    AChoreographer_getInstance, AChoreographer_postFrameCallback64,
    AChoreographer_postFrameCallbackDelayed64,
    // Firn (lib/android/activity.fi): the host of any Firn program.
    ANativeActivity_finish, AConfiguration_getUiModeNight,
    code_of_thread,
    KEYCODE_TAB, KEYCODE_DPAD_UP, KEYCODE_DPAD_DOWN, KEYCODE_PAGE_UP,
    KEYCODE_PAGE_DOWN, META_ALT,
    AMOTION_EVENT_ACTION_HOVER_MOVE, AMOTION_EVENT_ACTION_SCROLL,
    AMotionEvent_getAxisValue, AXIS_VSCROLL,
}

// ---------------------------------------------------------------- libandroid
// Firn: every `extern fn` here is C and cannot start a collection, so it
// carries #[no_gc] -- the callbacks of lib/android/activity.fi run on
// Android's main thread, where the collector must never run.
#[no_gc]
extern fn ANativeWindow_setBuffersGeometry(win: u64, w: i32, h: i32,
    format: i32) -> i32;
#[no_gc]
extern fn ANativeWindow_lock(win: u64, out_buffer: u64, dirty: u64) -> i32;
#[no_gc]
extern fn ANativeWindow_unlockAndPost(win: u64) -> i32;
#[no_gc]
extern fn ANativeWindow_getWidth(win: u64) -> i32;
#[no_gc]
extern fn ANativeWindow_getHeight(win: u64) -> i32;
#[no_gc]
extern fn ANativeWindow_acquire(win: u64);
#[no_gc]
extern fn ANativeWindow_release(win: u64);

#[no_gc]
extern fn ALooper_forThread() -> u64;
#[no_gc]
extern fn AInputQueue_attachLooper(q: u64, looper: u64, ident: i32,
    callback: u64, data: u64);
#[no_gc]
extern fn AInputQueue_detachLooper(q: u64);
#[no_gc]
extern fn AInputQueue_getEvent(q: u64, out_event: u64) -> i32;
// RUNDE MOBIL9: liegt etwas in der Warteschlange? Steht seit API 9 in
// libandroid.so, gebunden war es nie. Es ist die Frage, mit der eine
// lange Bemalung sich selbst unterbricht, BEVOR Androids
// Eingabeverteiler nach fuenf Sekunden einen ANR wirft.
#[no_gc]
extern fn AInputQueue_hasEvents(q: u64) -> i32;
#[no_gc]
extern fn AInputQueue_preDispatchEvent(q: u64, event: u64) -> i32;
#[no_gc]
extern fn AInputQueue_finishEvent(q: u64, event: u64, handled: i32);
#[no_gc]
extern fn AInputEvent_getType(event: u64) -> i32;
#[no_gc]
extern fn AMotionEvent_getAction(event: u64) -> i32;
#[no_gc]
extern fn AMotionEvent_getX(event: u64, pointer_index: usize) -> f32;
#[no_gc]
extern fn AMotionEvent_getY(event: u64, pointer_index: usize) -> f32;

// RUNDE MOBIL2. Die Schleife des Hauptfadens: hier haengt seit dieser
// Runde NICHT nur die Eingabewarteschlange, sondern auch die Weckleitung
// des Netzfadens (ein `socketpair`). `ALooper_addFd` ist der einzige Weg,
// einen fremden Deskriptor in Androids Hauptschleife zu bekommen, ohne
// eigenen Faden fuer das Warten -- und damit der einzige Weg, aus einem
// Arbeitsfaden heraus den Bildschirm anzustossen, ohne ihn zu beruehren.
#[no_gc]
extern fn ALooper_addFd(looper: u64, fd: i32, ident: i32, events: i32,
    callback: u64, data: u64) -> i32;
#[no_gc]
extern fn ALooper_removeFd(looper: u64, fd: i32) -> i32;
#[no_gc]
extern fn ALooper_wake(looper: u64);
#[no_gc]
extern fn ALooper_prepare(opts: i32) -> u64;
// RUNDE EINKERN: das Warten selbst. Bis hierher hat lib/android/a_main.fi
// die Schleife NIE gefragt -- Android ruft sie fuer eine NativeActivity
// selbst und verteilt an die mit `ALooper_addFd` angemeldeten Rueckrufe.
// Eine Fensterschicht nach dem Vertrag von lib/window/window.fi hat
// aber ein `warte(ms)`, und das ist unter Android genau diese Funktion
// (<android/looper.h>, seit API 1 in libandroid.so). Wer weiter ueber
// Rueckrufe arbeitet, ruft sie nicht.
// RUNDE KERN-3: ein Zeitgeber als Deskriptor fuer die Schleife -- bionic,
// weil die Systemaufruf-Tafel des Uebersetzers timerfd nicht kennt.
#[no_gc]
extern fn timerfd_create(clockid: i32, flags: i32) -> i32;
#[no_gc]
extern fn timerfd_settime(fd: i32, flags: i32, neu: u64, alt: u64) -> i32;
#[no_gc]
extern fn ALooper_pollOnce(timeoutMillis: i32, outFd: u64, outEvents: u64,
    outData: u64) -> i32;

// Die Bildschirmtastatur. Ohne Java gibt es genau diese zwei Griffe; sie
// stehen in <android/native_activity.h> und liegen in libandroid.so.
#[no_gc]
extern fn ANativeActivity_showSoftInput(activity: u64, flags: i32);
#[no_gc]
extern fn ANativeActivity_hideSoftInput(activity: u64, flags: i32);
// Firn: ends the activity from ANY thread (<android/native_activity.h>:
// "this method can be called from any thread"). The app thread of
// lib/android/activity.fi calls it when the program's `main` returns.
#[no_gc]
extern fn ANativeActivity_finish(activity: u64);

// ------------------------------------------------------------ DER BILDTAKT
//
// RUNDE MOBIL4. Bis hierher hat diese App gemalt, WANN SIE FERTIG WAR:
// `eingabe_bereit` leert die Warteschlange und ruft `zeichnen()`. Auf
// einem 120-Hz-Schirm heisst das, dass jedes Bild an einer beliebigen
// Stelle des 8,3-ms-Rasters landet -- mal kurz vor dem naechsten
// Bildwechsel, mal kurz danach. Der Schirm nimmt aber nur zu SEINEN
// Zeitpunkten ein Bild ab. Was zu spaet fertig wird, wartet eine ganze
// Periode; was zu frueh fertig wird, wird verworfen oder doppelt gezeigt.
// Das Ergebnis ist Zittern, und Zittern fuehlt sich schlechter an als
// eine niedrigere, aber gleichmaessige Rate -- genau Justins Satz
// "es steht zwar 110 fps da, aber so fuehlt es sich nicht an".
//
// `AChoreographer` ist Androids Taktgeber. Er sitzt auf demselben
// `ALooper` wie diese App, er kostet KEINE Java-Klasse (er steht in
// <android/choreographer.h> und liegt in libandroid.so), und er ruft den
// angemeldeten Rueckruf genau einmal je Bildwechsel -- mit dem
// Zeitstempel des Bildwechsels als Argument.
//
// ZWEI FASSUNGEN, UND WARUM DIE ZWEITE.
//   `AChoreographer_postFrameCallback`   ab API 24, `long frameTimeNanos`
//   `AChoreographer_postFrameCallback64` ab API 29, `int64_t frameTimeNanos`
// Auf einem 32-Bit-Android ist `long` 32 Bit breit, und eine Nanosekunden-
// Uhr laeuft darin nach 4,3 Sekunden ueber. Die App verlangt ohnehin
// API 29 (`android_res_nquery`, siehe AndroidManifest.xml), also die 64er.
//
// Der Rueckruf ist `void (*)(int64_t frameTimeNanos, void* data)`. In Firn
// steht er als `fn(u64, u64)` da und geht durch `code_of2`: beide
// Argumente sind auf arm64 wie auf x86_64 ganzzahlige Register, und die
// Zeit ist positiv. Eine eigene Halterform waere derselbe Maschinencode
// unter anderem Namen.
#[no_gc]
extern fn AChoreographer_getInstance() -> u64;
#[no_gc]
extern fn AChoreographer_postFrameCallback64(choreographer: u64,
    callback: u64, data: u64);
// RUNDE MOBIL12 -- DER BLINKENDE SCHREIBZEIGER BRAUCHT EINEN TAKT, DER
// LANGSAMER IST ALS DER BILDSCHIRM.
//
// Ohne diese Fassung gaebe es nur zwei Wege, eine Schreibmarke blinken
// zu lassen: entweder je Bildwechsel ein Bild anfordern (bei 120 Hz also
// 120 Bilder je Sekunde, damit sich zweimal etwas aendert -- auf einem
// Telefon ist das der Akku), oder einen eigenen Faden mit einer Uhr.
// `postFrameCallbackDelayed64` ist der dritte und richtige: derselbe
// Taktgeber, nur mit einer Wartezeit davor. Sie steht ab API 29 in
// libandroid.so (geprueft mit `nm -D` fuer beide Befehlssaetze).
#[no_gc]
extern fn AChoreographer_postFrameCallbackDelayed64(choreographer: u64,
    callback: u64, data: u64, delayMillis: u32);

