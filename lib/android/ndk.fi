// <android/configuration.h>. It lies in libandroid.so, is pure C and
// needs no Java class. `getDensity` gives dpi (160 = mdpi); 0 means
// ANY and 65534 means NONE -- neither is a number to calculate with.
#[no_gc]
extern fn AConfiguration_new() -> u64;
#[no_gc]
extern fn AConfiguration_delete(cfg: u64);
#[no_gc]
extern fn AConfiguration_fromAssetManager(cfg: u64, am: u64);
#[no_gc]
extern fn AConfiguration_getDensity(cfg: u64) -> i32;
// Firn: light or dark. 0 = ANY, 1 = NO (light), 2 = YES (dark).
#[no_gc]
extern fn AConfiguration_getUiModeNight(cfg: u64) -> i32;

// ------------------------------------------------------------ ROUND LOKAL
//
// THE LANGUAGE OF THE DEVICE. <android/configuration.h>, in libandroid.so.
//
// That is the information that Android itself keeps: it follows the setting
// under "System > Languages" AND the app's own language that Android 13
// added (per-app language preferences). It comes from the
// configuration of the activity, not from an environment variable -- an
// Android app has none.
//
// TWO THINGS THAT YOU CANNOT SEE FROM THE HEADER AND THAT WOULD BE WRONG HERE
// IF YOU DID NOT KNOW THEM:
//
//  1. `AConfiguration_getLanguage` and `AConfiguration_getCountry`
//     write EXACTLY TWO octets and DO NOT APPEND A NULL
//     (<android/configuration.h>: "Returns the current language code ...
//     the output will be filled with the 2-letter code, or 0 if none").
//     Whoever does not zero the buffer himself afterwards reads what lay there
//     before.
//  2. If no language is set, the two octets stay NULL -- that
//     is no error and is not reported. The caller has to check it;
//     `lang.lang_set_system` stops at the first null and
//     `ist_leer_locale` catches the rest.
#[no_gc]
extern fn AConfiguration_getLanguage(config: u64, out_language: u64);
#[no_gc]
extern fn AConfiguration_getCountry(config: u64, out_country: u64);

// The second way to the same information: the system property `persist.sys.locale`
// (formerly `persist.sys.language`/`persist.sys.country`). It is open to EVERY
// native process, also one without an activity -- and that is exactly
// why it stands here: the test rig from tools/android/pruefstand has
// no activity and no stock manager, so also no
// AConfiguration. Without this second way the determination of the language would not have been
// measurable at all on a real Android system.
//
// `__system_property_get` writes at most PROP_VALUE_MAX = 92 octets
// and appends a null; the return value is the length without the null.
#[no_gc]
#[link_name(__system_property_get)]
extern fn sys_prop_get(name: u64, value: u64) -> i32;

#[no_gc]
fn system_property_get(name: u64, value: u64) -> i32 {
    return sys_prop_get(name, value)
}

#[no_gc]
extern fn AAssetManager_open(mgr: u64, filename: u64, mode: i32) -> u64;
#[no_gc]
extern fn AAsset_getLength(asset: u64) -> i64;
#[no_gc]
extern fn AAsset_read(asset: u64, buf: u64, count: usize) -> i32;
#[no_gc]
extern fn AAsset_close(asset: u64);

// -------------------------------------------------------------------- liblog
#[no_gc]
#[link_name(__android_log_write)]
extern fn android_log_write(prio: i32, tag: u64, text: u64) -> i32;

const LOG_INFO: i32 = 4
const LOG_WARN: i32 = 5
const LOG_ERROR: i32 = 6

// `tag` and `text` are C strings (with a terminating null).
#[no_gc]
fn log_write(prio: i32, tag: u64, text: u64) {
    let ignoriert: i32 = android_log_write(prio, tag, text)
}

