// SPDX-License-Identifier: MPL-2.0
// Provenance: Certus, lib/android/ndk.fi, as of Certus commit 9e119268;
// released by the sole author Justin on 23.09.2026 for Firn under MPL-2.0.
// Added in Firn: ANativeActivity_finish,
// AConfiguration_getUiModeNight, code_of_thread (lib/android/activity.fi).
// lib/android/ndk.fi -- the thin seam between Certus and Android.
//
// Everything that stands here is EITHER an `extern fn` onto a function
// that Android's own libraries bring along (libandroid.so, liblog.so),
// OR a handle on raw memory, because the framework hands over a
// C structure and Firn does not know its blueprint.
//
// THERE IS NOT A LINE OF C IN IT. That is the point: the usual way to an
// Android app from foreign code is `android_native_app_glue.c` from the NDK,
// around a thousand lines of C that manage the life cycle of the board. This
// file does the same in Firn, and that is why Certus remains a program without
// C in the executable part.
//
// TWO THINGS THAT WERE MEASURED AND THAT YOU WOULD OTHERWISE NOT SUSPECT:
//
//  1. A FIRN FUNCTION VALUE IS NOT THE CODE ADDRESS.
//     `compiler/src/fnval.rs`: a value of type `fn(..)` is a pointer to
//     a RECORD whose first word holds the code address. Whoever writes such a
//     value into Android's callback table gives the framework a
//     pointer to a pointer -- and the phone crashes at the first
//     callback (reproduced in this round under qemu-aarch64: signal
//     11, see docs/MOBIL-BEFUND.md). `code_of1/2/3` therefore fetch the
//     first word out.
//
//  2. FIRN CANNOT CONVERT `fn(..)` TO `u64`.
//     `error: conversion from fn(i64) -> i64 to u64 is not allowed`. The
//     detour without a language change: write the value through a STRUCT FIELD into
//     a `[u64; 1]` and read the cell as a number. Exactly that is what the
//     three holders below do.
//
// The numbers of the blueprints stand in <android/native_activity.h>,
// <android/native_window.h> and <android/input.h> of NDK r27c and are
// recorded here as OFFSETS IN OCTETS, because Firn does not
// read C header files.
export {
    ANativeWindow_setBuffersGeometry, ANativeWindow_lock,
    ANativeWindow_unlockAndPost, ANativeWindow_getWidth,
    ANativeWindow_getHeight, ANativeWindow_acquire, ANativeWindow_release,
    log_write, LOG_INFO, LOG_WARN, LOG_ERROR,
    ALooper_forThread, AInputQueue_attachLooper, AInputQueue_detachLooper,
    AInputQueue_getEvent, AInputQueue_preDispatchEvent,
    AInputQueue_hasEvents,
    AInputQueue_finishEvent, AInputEvent_getType, AMotionEvent_getAction,
    AMotionEvent_getX, AMotionEvent_getY,
    AAssetManager_open, AAsset_getLength, AAsset_read, AAsset_close,
    peek64, poke64, peek32, poke32,
    code_of1, code_of2, code_of3, code_of4,
    ACT_CALLBACKS, ACT_INTERNAL_PATH, ACT_SDK_VERSION, ACT_ASSET_MANAGER,
    CB_ON_START, CB_ON_RESUME, CB_ON_SAVE, CB_ON_PAUSE, CB_ON_STOP,
    CB_ON_DESTROY, CB_ON_FOCUS, CB_ON_WIN_CREATED, CB_ON_WIN_RESIZED,
    CB_ON_WIN_REDRAW, CB_ON_WIN_DESTROYED, CB_ON_QUEUE_CREATED,
    CB_ON_QUEUE_DESTROYED, CB_ON_RECT, CB_ON_CONFIG, CB_ON_LOWMEM,
    BUF_WIDTH, BUF_HEIGHT, BUF_STRIDE, BUF_FORMAT, BUF_BITS, BUF_SIZE,
    WINDOW_FORMAT_RGBA_8888, WINDOW_FORMAT_RGBX_8888,
    EVENT_TYPE_KEY, EVENT_TYPE_MOTION,
    ACTION_DOWN, ACTION_UP, ACTION_MOVE, ACTION_MASK,
    LOOPER_EVENT_INPUT,
    // ROUND MOBIL2 -- what the surface and the network thread need.
    ALooper_addFd, ALooper_removeFd, ALooper_wake, ALooper_prepare,
    ALooper_pollOnce,
    // ROUND KERN-3: the clock of the loop (bionic, no system call detour)
    timerfd_create, timerfd_settime,
    ANativeActivity_showSoftInput, ANativeActivity_hideSoftInput,
    AKeyEvent_getAction, AKeyEvent_getKeyCode, AKeyEvent_getMetaState,
    AMotionEvent_getPointerCount, AMotionEvent_getPointerId,
    AMotionEvent_getEventTime, AInputEvent_getSource,
    AMotionEvent_getToolType, ACTION_POINTER_INDEX_MASK,
    ACTION_POINTER_INDEX_SHIFT,
    ALOOPER_EVENT_INPUT, ALOOPER_EVENT_OUTPUT,
    ALOOPER_PREPARE_ALLOW_NON_CALLBACKS,
    SOFT_INPUT_FORCED, SOFT_INPUT_IMPLICIT, HIDE_SOFT_INPUT_NOT_ALWAYS,
    KEY_ACTION_DOWN, KEY_ACTION_UP,
    KEYCODE_BACK, KEYCODE_ENTER, KEYCODE_DEL, KEYCODE_SPACE,
    KEYCODE_NUMPAD_ENTER, KEYCODE_ESCAPE, KEYCODE_DPAD_LEFT,
    KEYCODE_DPAD_RIGHT, KEYCODE_MOVE_HOME, KEYCODE_MOVE_END,
    KEYCODE_FORWARD_DEL, KEYCODE_A, KEYCODE_C, KEYCODE_V, KEYCODE_X,
    META_CTRL, META_SHIFT,
    ACTION_CANCEL, ACTION_POINTER_DOWN, ACTION_POINTER_UP,
    key_char,
    ACT_INTERNAL_DATA_PATH, ACT_EXTERNAL_DATA_PATH,
    // ROUND MOBIL3 -- the screen density, for the fallback at the
    // system bars.  ROUND LOKAL -- the language that the device has
    // set. The same AConfiguration, two questions to it.
    AConfiguration_new, AConfiguration_delete,
    AConfiguration_fromAssetManager, AConfiguration_getDensity,
    AConfiguration_getLanguage, AConfiguration_getCountry,
    system_property_get,
    // ROUND MOBIL4 -- THE FRAME CLOCK.
    AChoreographer_getInstance, AChoreographer_postFrameCallback64,
    AChoreographer_postFrameCallbackDelayed64,
    // Firn (lib/android/activity.fi): the host of any Firn program.
    ANativeActivity_finish, AConfiguration_getUiModeNight,
    code_of_thread,
    KEYCODE_TAB, KEYCODE_DPAD_UP, KEYCODE_DPAD_DOWN, KEYCODE_PAGE_UP,
    KEYCODE_PAGE_DOWN, META_ALT,
    AMOTION_EVENT_ACTION_HOVER_MOVE, AMOTION_EVENT_ACTION_SCROLL,
    AMotionEvent_getAxisValue, AXIS_VSCROLL,
}

// ---------------------------------------------------------------- libandroid
// Firn: every `extern fn` here is C and cannot start a collection, so it
// carries #[no_gc] -- the callbacks of lib/android/activity.fi run on
// Android's main thread, where the collector must never run.
#[no_gc]
extern fn ANativeWindow_setBuffersGeometry(win: u64, w: i32, h: i32,
    format: i32) -> i32;
#[no_gc]
extern fn ANativeWindow_lock(win: u64, out_buffer: u64, dirty: u64) -> i32;
#[no_gc]
extern fn ANativeWindow_unlockAndPost(win: u64) -> i32;
#[no_gc]
extern fn ANativeWindow_getWidth(win: u64) -> i32;
#[no_gc]
extern fn ANativeWindow_getHeight(win: u64) -> i32;
#[no_gc]
extern fn ANativeWindow_acquire(win: u64);
#[no_gc]
extern fn ANativeWindow_release(win: u64);

#[no_gc]
extern fn ALooper_forThread() -> u64;
#[no_gc]
extern fn AInputQueue_attachLooper(q: u64, looper: u64, ident: i32,
    callback: u64, data: u64);
#[no_gc]
extern fn AInputQueue_detachLooper(q: u64);
#[no_gc]
extern fn AInputQueue_getEvent(q: u64, out_event: u64) -> i32;
// ROUND MOBIL9: is something in the queue? It has been in libandroid.so
// since API 9, it was just never bound. It is the question with which a
// long painting interrupts itself BEFORE Android's
// input dispatcher throws an ANR after five seconds.
#[no_gc]
extern fn AInputQueue_hasEvents(q: u64) -> i32;
#[no_gc]
extern fn AInputQueue_preDispatchEvent(q: u64, event: u64) -> i32;
#[no_gc]
extern fn AInputQueue_finishEvent(q: u64, event: u64, handled: i32);
#[no_gc]
extern fn AInputEvent_getType(event: u64) -> i32;
#[no_gc]
extern fn AMotionEvent_getAction(event: u64) -> i32;
#[no_gc]
extern fn AMotionEvent_getX(event: u64, pointer_index: usize) -> f32;
#[no_gc]
extern fn AMotionEvent_getY(event: u64, pointer_index: usize) -> f32;

// ROUND MOBIL2. The loop of the main thread: since this
// round not ONLY the input queue hangs here, but also the wake-up line
// of the network thread (a `socketpair`). `ALooper_addFd` is the only way
// to get a foreign descriptor into Android's main loop without
// a thread of its own for waiting -- and thereby the only way to prod the screen from a
// worker thread without touching it.
#[no_gc]
extern fn ALooper_addFd(looper: u64, fd: i32, ident: i32, events: i32,
    callback: u64, data: u64) -> i32;
#[no_gc]
extern fn ALooper_removeFd(looper: u64, fd: i32) -> i32;
#[no_gc]
extern fn ALooper_wake(looper: u64);
#[no_gc]
extern fn ALooper_prepare(opts: i32) -> u64;
// ROUND EINKERN: the waiting itself. Until here lib/android/a_main.fi
// NEVER asked the loop -- Android calls it itself for a NativeActivity
// and distributes to the callbacks registered with `ALooper_addFd`.
// A window layer after the contract of lib/window/window.fi
// does have a `warte(ms)`, though, and under Android that is exactly this function
// (<android/looper.h>, in libandroid.so since API 1). Whoever keeps working through
// callbacks does not call it.
// ROUND KERN-3: a timer as a descriptor for the loop -- bionic,
// because the system call table of the translator does not know timerfd.
#[no_gc]
extern fn timerfd_create(clockid: i32, flags: i32) -> i32;
#[no_gc]
extern fn timerfd_settime(fd: i32, flags: i32, neu: u64, alt: u64) -> i32;
#[no_gc]
extern fn ALooper_pollOnce(timeoutMillis: i32, outFd: u64, outEvents: u64,
    outData: u64) -> i32;

// The on-screen keyboard. Without Java there are exactly these two handles; they
// stand in <android/native_activity.h> and lie in libandroid.so.
#[no_gc]
extern fn ANativeActivity_showSoftInput(activity: u64, flags: i32);
#[no_gc]
extern fn ANativeActivity_hideSoftInput(activity: u64, flags: i32);
// Firn: ends the activity from ANY thread (<android/native_activity.h>:
// "this method can be called from any thread"). The app thread of
// lib/android/activity.fi calls it when the program's `main` returns.
#[no_gc]
extern fn ANativeActivity_finish(activity: u64);

// ------------------------------------------------------------ THE FRAME CLOCK
//
// ROUND MOBIL4. Until here this app painted WHEN IT WAS READY:
// `eingabe_bereit` empties the queue and calls `zeichnen()`. On
// a 120 Hz screen that means that every frame lands at an arbitrary
// place of the 8.3 ms grid -- sometimes shortly before the next
// frame change, sometimes shortly after. But the screen takes a frame only at ITS
// own times. What is finished too late waits a whole
// period; what is finished too early is discarded or shown twice.
// The result is jitter, and jitter feels worse than
// a lower but even rate -- exactly Justin's sentence
// "it says 110 fps, but that is not how it feels".
//
// `AChoreographer` is Android's clock. It sits on the same
// `ALooper` as this app, it costs NO Java class (it stands in
// <android/choreographer.h> and lies in libandroid.so), and it calls the
// registered callback exactly once per frame change -- with the
// timestamp of the frame change as argument.
//
// TWO VERSIONS, AND WHY THE SECOND.
//   `AChoreographer_postFrameCallback`   from API 24, `long frameTimeNanos`
//   `AChoreographer_postFrameCallback64` from API 29, `int64_t frameTimeNanos`
// On a 32-bit Android `long` is 32 bits wide, and a nanosecond
// clock overflows in it after 4.3 seconds. The app demands API 29 anyway
// (`android_res_nquery`, see AndroidManifest.xml), so the 64 one.
//
// The callback is `void (*)(int64_t frameTimeNanos, void* data)`. In Firn
// it stands as `fn(u64, u64)` and goes through `code_of2`: both
// arguments are integer registers on arm64 as on x86_64, and the
// time is positive. A holder form of its own would be the same machine code
// under another name.
#[no_gc]
extern fn AChoreographer_getInstance() -> u64;
#[no_gc]
extern fn AChoreographer_postFrameCallback64(choreographer: u64,
    callback: u64, data: u64);
// ROUND MOBIL12 -- THE BLINKING CURSOR NEEDS A CLOCK THAT IS
// SLOWER THAN THE SCREEN.
//
// Without this version there would be only two ways to make a text cursor blink:
// either request a frame per frame change (at 120 Hz that is
// 120 frames per second, so that something changes twice -- on a phone
// that is the battery), or a thread of its own with a clock.
// `postFrameCallbackDelayed64` is the third and right one: the same
// clock, only with a wait in front. It stands in libandroid.so from API 29
// (checked with `nm -D` for both instruction sets).
#[no_gc]
extern fn AChoreographer_postFrameCallbackDelayed64(choreographer: u64,
    callback: u64, data: u64, delayMillis: u32);

