// RUNDE TEXTBOX-2: Entf, und die vier Buchstaben der Bearbeitungsgriffe.
const KEYCODE_FORWARD_DEL: i32 = 112
const KEYCODE_A: i32 = 29
const KEYCODE_C: i32 = 31
const KEYCODE_V: i32 = 50
const KEYCODE_X: i32 = 52
const META_CTRL: i32 = 0x7000     // CTRL_ON | CTRL_LEFT_ON | CTRL_RIGHT_ON
const META_SHIFT: i32 = 0xC1      // SHIFT_ON | SHIFT_LEFT_ON | SHIFT_RIGHT_ON
const META_ALT: i32 = 0x32        // ALT_ON | ALT_LEFT_ON | ALT_RIGHT_ON

// WARUM EINE EIGENE TAFEL UND NICHT `getUnicodeChar`: das waere
// `KeyCharacterMap`, eine JAVA-Klasse. Das NDK hat sie nicht, und diese
// App hat kein classes.dex. Fuer eine Adresszeile reicht die Tafel: die
// sechsundzwanzig Buchstaben, die zehn Ziffern und die Zeichen, die in
// einer Adresse vorkommen duerfen. Was fehlt, gibt 0 und wird verworfen
// -- lieber ein Zeichen zu wenig als ein falsches.
#[no_gc]
fn key_char(code: i32, meta: i32) -> u32 {
    let layer: bool = (meta & 1) != 0 || (meta & 64) != 0 || (meta & 128) != 0
    if code >= 29 && code <= 54 {
        // A .. Z
        let k: u32 = (code - 29) as u32
        if layer {
            return 65 as u32 + k
        }
        return 97 as u32 + k
    }
    if code >= 7 && code <= 16 {
        // 0 .. 9. Mit Umschalt die Zeichen der deutschen und der
        // amerikanischen Reihe -- genommen wird die amerikanische, weil
        // Androids Standardbelegung diese meldet.
        let z: u32 = (code - 7) as u32
        if !layer {
            return 48 as u32 + z
        }
        if z == 1 as u32 { return 33 as u32 }  // !
        if z == 2 as u32 { return 64 as u32 }  // @
        if z == 3 as u32 { return 35 as u32 }  // #
        if z == 4 as u32 { return 36 as u32 }  // $
        if z == 5 as u32 { return 37 as u32 }  // %
        if z == 6 as u32 { return 94 as u32 }  // ^
        if z == 7 as u32 { return 38 as u32 }  // &
        if z == 8 as u32 { return 42 as u32 }  // *
        if z == 9 as u32 { return 40 as u32 }  // (
        return 41 as u32                        // )
    }
    if code == KEYCODE_SPACE { return 32 as u32 }
    if code == 55 { if layer { return 60 as u32 } return 44 as u32 } // , <
    if code == 56 { if layer { return 62 as u32 } return 46 as u32 } // . >
    if code == 76 { if layer { return 63 as u32 } return 47 as u32 } // / ?
    if code == 69 { if layer { return 95 as u32 } return 45 as u32 } // - _
    if code == 70 { if layer { return 43 as u32 } return 61 as u32 } // = +
    if code == 74 { if layer { return 58 as u32 } return 59 as u32 } // ; :
    if code == 75 { if layer { return 34 as u32 } return 39 as u32 } // ' "
    if code == 71 { if layer { return 123 as u32 } return 91 as u32 } // [ {
    if code == 72 { if layer { return 125 as u32 } return 93 as u32 } // ] }
    if code == 73 { if layer { return 124 as u32 } return 92 as u32 } // \\ |
    if code == 68 { if layer { return 126 as u32 } return 96 as u32 } // ` ~
    if code == 77 { return 64 as u32 }  // @
    if code == 156 { return 45 as u32 } // Ziffernblock minus
    if code == 158 { return 46 as u32 } // Ziffernblock Punkt
    if code >= 144 && code <= 153 {
        return 48 as u32 + (code - 144) as u32
    }
    return 0 as u32
}

// ---------------------------------------------- rohe Speicherhandgriffe
#[no_gc]
fn peek64(p: u64) -> u64 {
    return *(p as *mut u64)
}

#[no_gc]
fn poke64(p: u64, v: u64) {
    *(p as *mut u64) = v
}

#[no_gc]
fn peek32(p: u64) -> i32 {
    return *(p as *mut i32)
}

#[no_gc]
fn poke32(p: u64, v: i32) {
    *(p as *mut i32) = v
}

// ------------------------------------- Codeadresse eines Firn-Rueckrufs
// Drei Halter, weil Firn typisiert ist und die drei Formen der Rueckrufe
// verschieden aussehen. Mehr braucht die Tafel nicht.
struct Holder1 { f: fn(u64) }
struct Holder2 { f: fn(u64, u64) }
struct Holder3 { f: fn(u64, i32) }
// RUNDE VERIFY: der Signalbehandler aus lib/android/crash.fi. Seine
// Form ist die von SA_SIGINFO: (int sig, siginfo_t*, ucontext_t*).
struct Holder4 { f: fn(i32, u64, u64) }

#[no_gc]
fn code_of1(f: fn(u64)) -> u64 {
    var roh: [u64; 1] = [0; 1]
    let h: *mut Holder1 = (&roh[0]) as *mut Holder1
    (*h).f = f
    return peek64(roh[0])
}

#[no_gc]
fn code_of2(f: fn(u64, u64)) -> u64 {
    var roh: [u64; 1] = [0; 1]
    let h: *mut Holder2 = (&roh[0]) as *mut Holder2
    (*h).f = f
    return peek64(roh[0])
}

#[no_gc]
fn code_of3(f: fn(u64, i32)) -> u64 {
    var roh: [u64; 1] = [0; 1]
    let h: *mut Holder3 = (&roh[0]) as *mut Holder3
    (*h).f = f
    return peek64(roh[0])
}

// RUNDE VERIFY: dasselbe fuer den Signalbehandler.
#[no_gc]
fn code_of4(f: fn(i32, u64, u64)) -> u64 {
    var roh: [u64; 1] = [0; 1]
    let h: *mut Holder4 = (&roh[0]) as *mut Holder4
    (*h).f = f
    return peek64(roh[0])
}

// Firn: the start routine of a pthread, `void* (*)(void*)`.
struct HolderT { f: fn(u64) -> u64 }

#[no_gc]
fn code_of_thread(f: fn(u64) -> u64) -> u64 {
    var roh: [u64; 1] = [0; 1]
    let h: *mut HolderT = (&roh[0]) as *mut HolderT
    (*h).f = f
    return peek64(roh[0])
}
