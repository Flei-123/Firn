// <android/configuration.h>. Es liegt in libandroid.so, ist reines C und
// braucht keine Java-Klasse. `getDensity` gibt dpi (160 = mdpi); 0 heisst
// ANY und 65534 heisst NONE -- beides ist keine Zahl zum Rechnen.
#[no_gc]
extern fn AConfiguration_new() -> u64;
#[no_gc]
extern fn AConfiguration_delete(cfg: u64);
#[no_gc]
extern fn AConfiguration_fromAssetManager(cfg: u64, am: u64);
#[no_gc]
extern fn AConfiguration_getDensity(cfg: u64) -> i32;
// Firn: light or dark. 0 = ANY, 1 = NO (light), 2 = YES (dark).
#[no_gc]
extern fn AConfiguration_getUiModeNight(cfg: u64) -> i32;

// ------------------------------------------------------------ RUNDE LOKAL
//
// DIE SPRACHE DES GERAETS. <android/configuration.h>, in libandroid.so.
//
// Das ist die Angabe, die Android selbst fuehrt: sie folgt der Einstellung
// unter "System > Sprachen" UND der App-eigenen Sprache, die Android 13
// dazubekommen hat (per-app language preferences). Sie kommt aus der
// Konfiguration der Aktivitaet, nicht aus einer Umgebungsvariablen -- eine
// Android-App hat keine.
//
// ZWEI DINGE, DIE MAN AM KOPF NICHT SIEHT UND DIE HIER FALSCH WAEREN,
// WENN MAN SIE NICHT WUESSTE:
//
//  1. `AConfiguration_getLanguage` und `AConfiguration_getCountry`
//     schreiben GENAU ZWEI Oktette und HAENGEN KEINE NULL AN
//     (<android/configuration.h>: "Returns the current language code ...
//     the output will be filled with the 2-letter code, or 0 if none").
//     Wer den Puffer nicht selbst nullt, liest hinterher, was vorher da
//     lag.
//  2. Ist keine Sprache gesetzt, bleiben die beiden Oktette NULL -- das
//     ist kein Fehler und wird nicht gemeldet. Der Aufrufer muss es
//     pruefen; `lang.lang_set_system` bricht an der ersten Null ab und
//     `ist_leer_locale` faengt den Rest.
#[no_gc]
extern fn AConfiguration_getLanguage(config: u64, out_language: u64);
#[no_gc]
extern fn AConfiguration_getCountry(config: u64, out_country: u64);

// Der zweite Weg zur selben Angabe: die Systemeigenschaft `persist.sys.locale`
// (frueher `persist.sys.language`/`persist.sys.country`). Sie steht JEDEM
// eingeborenen Prozess offen, auch einem ohne Aktivitaet -- und genau
// deshalb steht sie hier: der Pruefstand aus tools/android/pruefstand hat
// keine Aktivitaet und keinen Vorratsverwalter, also auch keine
// AConfiguration. Ohne diesen zweiten Weg waere die Sprachermittlung auf
// einem echten Android-System ueberhaupt nicht messbar gewesen.
//
// `__system_property_get` schreibt hoechstens PROP_VALUE_MAX = 92 Oktett
// und haengt eine Null an; die Rueckgabe ist die Laenge ohne die Null.
#[no_gc]
#[link_name(__system_property_get)]
extern fn sys_prop_get(name: u64, value: u64) -> i32;

#[no_gc]
fn system_property_get(name: u64, value: u64) -> i32 {
    return sys_prop_get(name, value)
}

#[no_gc]
extern fn AAssetManager_open(mgr: u64, filename: u64, mode: i32) -> u64;
#[no_gc]
extern fn AAsset_getLength(asset: u64) -> i64;
#[no_gc]
extern fn AAsset_read(asset: u64, buf: u64, count: usize) -> i32;
#[no_gc]
extern fn AAsset_close(asset: u64);

// -------------------------------------------------------------------- liblog
#[no_gc]
#[link_name(__android_log_write)]
extern fn android_log_write(prio: i32, tag: u64, text: u64) -> i32;

const LOG_INFO: i32 = 4
const LOG_WARN: i32 = 5
const LOG_ERROR: i32 = 6

// `tag` und `text` sind C-Zeichenketten (mit abschliessender Null).
#[no_gc]
fn log_write(prio: i32, tag: u64, text: u64) {
    let ignoriert: i32 = android_log_write(prio, tag, text)
}

