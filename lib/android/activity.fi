// SPDX-License-Identifier: MPL-2.0
// lib/android/activity.fi -- THE HOST OF ANY FIRN PROGRAM ON ANDROID.
//
// ================================================================= WHY
//
// Certus runs on Android through lib/android/a_main.fi: 11,800 lines in
// which the browser answers every callback of `NativeActivity` itself, on
// Android's main thread. That is right for a browser and useless for
// every other program. A Firn program has a `main`, opens a window through
// lib/window/window.fi and then sits in `wait_event` -- exactly as under
// X11 and Windows. This file makes that SAME program run on Android:
//
//   * `firn_activity_create` is the entry point. The manifest names it
//     with `android.app.func_name` (tools/android/build.sh writes that), so
//     it can live next to Certus' own `ANativeActivity_onCreate` without a
//     clash.
//   * It starts ONE thread -- the app thread -- and calls the program's
//     `main` on it. That thread owns everything Firn: the collector (its
//     stack is the one `gc_init` measures), the window buffer, the input.
//   * Android's main thread only FORWARDS. Each callback puts a value into
//     the shared block below, writes one command octet into a socket pair
//     and -- for window, input queue and destroy -- WAITS until the app
//     thread has taken it over. That is the protocol of the NDK's
//     `android_native_app_glue.c`, without a line of C.
//   * The app thread's side of the protocol (reading the octets, taking
//     over the window, turning AInputEvents into window events) lives in
//     lib/window/android.fi, because that is where `wait_event` is.
//
// ======================================================= THE TWO THREADS
//
// T1 Android's main thread runs ONLY the #[no_gc] callbacks below. They
//    allocate nothing from the collector and call no Firn code that does:
//    the collector was initialised on the app thread and scans THAT stack.
// T2 The app thread is a bionic pthread (pthread_create), not a thread of
//    lib/gc: its thread pointer belongs to bionic, so libandroid, liblog
//    and libc are callable from it (see lib/android/worker.fi in Certus for
//    what happens with a Firn thread that sets its own tpidr_el0).
//
// ========================================================= WHAT IS OPEN
//
// O1 No soft keyboard composition (IME). Hardware keys and the key events
//    Android synthesises (`adb shell input text`, simple keyboards) arrive;
//    a real InputConnection needs a dex class (Certus: lib/android/ime.fi).
// O2 `onSaveInstanceState` is not answered: a program that wants to keep
//    state across a process kill writes it into `activity_data_path`.
import std.rt
import android.ndk

export {
    firn_activity_create,
    activity_on, activity_pointer, activity_looper, activity_read_cmd,
    activity_pending_window, activity_pending_queue, activity_ack,
    activity_density, activity_night, activity_config_read,
    activity_soft_input, activity_data_path, activity_app_ended,
    activity_resumed, activity_content_rect,
    IDENT_CMD, IDENT_INPUT,
    CMD_NONE, CMD_WINDOW, CMD_RESIZED, CMD_REDRAW, CMD_QUEUE, CMD_CONFIG,
    CMD_PAUSE, CMD_RESUME, CMD_DESTROY, CMD_FOCUS, CMD_LOWMEM,
}

// ------------------------------------------------ the looper identities
// `ALooper_pollOnce` returns these for the two descriptors the app thread
// listens on (ALOOPER_PREPARE_ALLOW_NON_CALLBACKS, no callbacks).
const IDENT_CMD: i32 = 1
const IDENT_INPUT: i32 = 2

// ------------------------------------------------------- the commands
const CMD_NONE: i32 = -1
const CMD_WINDOW: i32 = 1
const CMD_RESIZED: i32 = 2
const CMD_REDRAW: i32 = 3
const CMD_QUEUE: i32 = 4
const CMD_CONFIG: i32 = 5
const CMD_PAUSE: i32 = 6
const CMD_RESUME: i32 = 7
const CMD_DESTROY: i32 = 8
const CMD_FOCUS: i32 = 9
const CMD_LOWMEM: i32 = 10

// ---------------------------------------------------- the shared block
// Raw memory (mmap), never touched by the collector. Offsets in octets.
const B_ACT: u64 = 0          // ANativeActivity*
const B_LOOPER: u64 = 8       // the app thread's ALooper
const B_WIN: u64 = 16         // the window the main thread hands over
const B_QUEUE: u64 = 24       // the input queue the main thread hands over
const B_SENT: u64 = 32        // commands written (main thread only)
const B_ACKED: u64 = 40       // commands taken over (app thread only)
const B_READY: u64 = 48       // 1 = the app thread listens
const B_GONE: u64 = 56        // 1 = the program's main has returned
const B_FD_R: u64 = 64        // command socket, app end
const B_FD_W: u64 = 72        // command socket, main thread end
const B_CONFIG: u64 = 80      // AConfiguration* (main thread's copy)
const B_DENSITY: u64 = 88
const B_NIGHT: u64 = 96
const B_RESUMED: u64 = 104
const B_PATH: u64 = 112       // 512 octets: data path, zero terminated
const B_RECT: u64 = 624       // 4 x i32: the content rectangle (ARect)
const B_ATTR: u64 = 640       // 128 octets: pthread_attr_t
const B_TID: u64 = 768        // pthread_t
const B_ARGV: u64 = 1024      // the argument block `main(start)` gets
const B_ARGBUF: u64 = 2048    // the argument text
const B_BYTES: usize = 8192
const ARGV_MAX: usize = 60
const ARGBUF_CAP: usize = 6144

const STACK_BYTES: usize = 16777216
const PTHREAD_CREATE_DETACHED: i32 = 1

static mut G_B: u64 = 0

// ------------------------------------------------------------- bionic
#[no_gc]
extern fn pthread_create(tid: u64, attr: u64, start: u64, arg: u64) -> i32;
#[no_gc]
extern fn pthread_attr_init(attr: u64) -> i32;
#[no_gc]
extern fn pthread_attr_setstacksize(attr: u64, n: usize) -> i32;
#[no_gc]
extern fn pthread_attr_setdetachstate(attr: u64, state: i32) -> i32;

// The program's own `main`. Every Firn compilation unit has one
// (SPEC 14.8); in a shared library `_start` is never run, so this file is
// the one that calls it -- on the app thread, with an argument block in
// the shape `_start` would have passed.
#[link_name(main)]
extern fn firn_program_main(start: u64) -> i32;

// bionic's dup2, not the system call: Android's seccomp filter for apps
// kills the process on the raw x86_64 dup2 (33) -- measured in the
// emulator, SIGSYS -- and bionic goes through dup3.
#[no_gc]
#[link_name(dup2)]
extern fn c_dup2(old: i32, new: i32) -> i32;

// ---------------------------------------------------------- raw access
#[no_gc]
fn ld(o: u64) -> u64 {
    return *((G_B + o) as *mut u64)
}

#[no_gc]
fn st(o: u64, v: u64) {
    *((G_B + o) as *mut u64) = v
}

// A load the other thread's stores become visible to (a full barrier on
// both machines: `lock xadd` / ldaxr-stlxr).
#[no_gc]
fn ld_sync(o: u64) -> u64 {
    return __atomic_add((G_B + o) as *mut u64, 0)
}

// The main thread's callbacks are #[no_gc] all the way down (SPEC 3.5.4),
// so they use these instead of the rt helpers.
#[no_gc]
fn roh_laenge(p: u64) -> usize {
    if p == 0 {
        return 0
    }
    var n: usize = 0
    while *((p + n as u64) as *mut u8) != 0 as u8 {
        n = n + 1
    }
    return n
}

#[no_gc]
fn roh_kopie(z: u64, q: u64, n: usize) {
    var i: usize = 0
    while i < n {
        *((z + i as u64) as *mut u8) = *((q + i as u64) as *mut u8)
        i = i + 1
    }
}

#[no_gc]
fn schlafen_us(us: i64) {
    var ts: [i64; 2] = [0; 2]
    ts[0] = 0
    ts[1] = us * 1000
    syscall(35, (&ts[0]) as i64, 0, 0, 0, 0, 0)
}

// ================================================ THE APP THREAD'S SIDE

// Is this program running under the host? False in a program that has
// its own `ANativeActivity_onCreate` (Certus) and on every other system.
#[no_gc]
fn activity_on() -> bool {
    return G_B != 0
}

#[no_gc]
fn activity_pointer() -> u64 {
    if G_B == 0 { return 0 }
    return ld(B_ACT)
}

#[no_gc]
fn activity_looper() -> u64 {
    if G_B == 0 { return 0 }
    return ld(B_LOOPER)
}

#[no_gc]
fn activity_resumed() -> bool {
    if G_B == 0 { return false }
    return ld_sync(B_RESUMED) != 0
}

// One command octet, without blocking. CMD_NONE = nothing there.
#[no_gc]
fn activity_read_cmd() -> i32 {
    if G_B == 0 { return CMD_NONE }
    var b: [u8; 1] = [0 as u8; 1]
    let fd: i64 = ld(B_FD_R) as i64
    // recvfrom(fd, buf, 1, MSG_DONTWAIT, 0, 0)
    let r: i64 = syscall(45, fd, (&b[0]) as i64, 1, 64, 0, 0)
    if r != 1 {
        return CMD_NONE
    }
    return b[0] as i32
}

#[no_gc]
fn activity_pending_window() -> u64 {
    if G_B == 0 { return 0 }
    return ld_sync(B_WIN)
}

#[no_gc]
fn activity_pending_queue() -> u64 {
    if G_B == 0 { return 0 }
    return ld_sync(B_QUEUE)
}

// Every command read is acknowledged exactly once, AFTER it was acted
// upon: the main thread waits for this before it lets Android destroy a
// window or a queue.
#[no_gc]
fn activity_ack() {
    if G_B == 0 { return }
    __atomic_add((G_B + B_ACKED) as *mut u64, 1)
}

// Re-read the configuration (density, light/dark). Called on the app
// thread when CMD_CONFIG arrives; AConfiguration_fromAssetManager only
// reads the asset manager's current configuration.
#[no_gc]
fn activity_config_read() {
    if G_B == 0 { return }
    let act: u64 = ld(B_ACT)
    let am: u64 = ndk.peek64(act + ndk.ACT_ASSET_MANAGER)
    let cfg: u64 = ndk.AConfiguration_new()
    if cfg == 0 || am == 0 {
        return
    }
    ndk.AConfiguration_fromAssetManager(cfg, am)
    let d: i32 = ndk.AConfiguration_getDensity(cfg)
    let n: i32 = ndk.AConfiguration_getUiModeNight(cfg)
    ndk.AConfiguration_delete(cfg)
    // 0 = ANY and 65534 = NONE are no numbers to compute with.
    if d > 0 && d < 65534 {
        st(B_DENSITY, d as u64)
    }
    st(B_NIGHT, n as u64)
}

// Android density in dpi (160 = mdpi); 0 = unknown.
#[no_gc]
fn activity_density() -> usize {
    if G_B == 0 { return 0 }
    return ld(B_DENSITY) as usize
}

// 0 = unknown, 1 = light, 2 = dark.
#[no_gc]
fn activity_night() -> u32 {
    if G_B == 0 { return 0 }
    return ld(B_NIGHT) as u32
}

// The soft keyboard. Callable from the app thread: the two NDK calls post
// to the main thread themselves.
#[no_gc]
fn activity_soft_input(show: bool) {
    if G_B == 0 { return }
    let act: u64 = ld(B_ACT)
    if show {
        ndk.ANativeActivity_showSoftInput(act, ndk.SOFT_INPUT_IMPLICIT)
    } else {
        ndk.ANativeActivity_hideSoftInput(act, ndk.HIDE_SOFT_INPUT_NOT_ALWAYS)
    }
}

// Where the program may write: externalDataPath if Android gave one
// (readable with `adb` without root), else internalDataPath. A zero
// terminated C string, 0 = none.
#[no_gc]
fn activity_data_path() -> u64 {
    if G_B == 0 { return 0 }
    if *((G_B + B_PATH) as *mut u8) == 0 as u8 {
        return 0
    }
    return G_B + B_PATH
}

// The part of the window not covered by status bar, navigation bar or a
// display cutout, from `onContentRectChanged`. False = not reported yet.
#[no_gc]
fn activity_content_rect(l: *mut i32, t: *mut i32, r: *mut i32,
    b: *mut i32) -> bool {
    if G_B == 0 { return false }
    let p: u64 = G_B + B_RECT
    *l = *(p as *mut i32)
    *t = *((p + 4) as *mut i32)
    *r = *((p + 8) as *mut i32)
    *b = *((p + 12) as *mut i32)
    return *r > *l && *b > *t
}

#[no_gc]
fn activity_app_ended() -> bool {
    if G_B == 0 { return true }
    return ld_sync(B_GONE) != 0
}

// ----------------------------------------------------- the arguments
// `<data path>/args.txt`, one argument per line, becomes argv[1..]. That
// is the only way to hand `--protokoll` or `--dpi=` to a program on a
// phone without Java: `adb push args.txt /sdcard/Android/data/<pkg>/files/`.
fn argumente_bauen() -> u64 {
    let blk: u64 = G_B + B_ARGV
    let buf: u64 = G_B + B_ARGBUF
    var name: [u8; 9] = "firn-app\0"
    rt.mem_copy(buf, (&name[0]) as u64, 9)
    var n: usize = 1
    rt.st64(blk, 1, buf)
    var used: usize = 9
    let dp: u64 = activity_data_path()
    if dp != 0 {
        var pfad: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&pfad, dp, rt.c_length(dp))
        var tail: [u8; 10] = "/args.txt\0"
        rt.buf_push_bytes(&pfad, (&tail[0]) as u64, 10)
        var inhalt: rt.Buf = rt.buf_new()
        if rt.read_file(rt.buf_ptr(&pfad), &inhalt) {
            let p: u64 = rt.buf_ptr(&inhalt)
            let len: usize = rt.buf_len(&inhalt)
            var i: usize = 0
            while i < len && n < ARGV_MAX {
                var j: usize = i
                while j < len && rt.ld8(p, j) != 10 as u8 {
                    j = j + 1
                }
                var e: usize = j
                if e > i && rt.ld8(p, e - 1) == 13 as u8 {
                    e = e - 1
                }
                if e > i && used + (e - i) + 1 < ARGBUF_CAP {
                    rt.mem_copy(buf + used as u64, p + i as u64, e - i)
                    rt.st8(buf + used as u64, e - i, 0 as u8)
                    rt.st64(blk, 1 + n, buf + used as u64)
                    used = used + (e - i) + 1
                    n = n + 1
                }
                i = j + 1
            }
        }
        rt.buf_free(&inhalt)
        rt.buf_free(&pfad)
    }
    rt.st64(blk, 0, n as u64)
    rt.st64(blk, 1 + n, 0)
    return blk
}

// -------------------------------------------------------- the thread
// The name starts with `thread_` on purpose: that identifier is what makes
// the compiler pull in the runtime of lib/gc (compiler/src/gc.rs,
// `source_needs_gc`), and with it `gc_init` -- a program without `str` or
// `gc class` would otherwise have no collector to initialise, and one WITH
// them needs it initialised on this stack, not on Android's main thread.
fn thread_app_main(arg: u64) -> u64 {
    // The collector's stack is THIS stack. gc_init reads the bottom from
    // /proc/self/maps, which works for a pthread stack as well.
    let g: bool = gc_init()
    let looper: u64 = ndk.ALooper_prepare(ndk.ALOOPER_PREPARE_ALLOW_NON_CALLBACKS)
    st(B_LOOPER, looper)
    let r: i32 = ndk.ALooper_addFd(looper, ld(B_FD_R) as i32, IDENT_CMD,
        ndk.ALOOPER_EVENT_INPUT, 0, 0)
    activity_config_read()
    __atomic_add((G_B + B_READY) as *mut u64, 1)
    let start: u64 = argumente_bauen()
    let code: i32 = firn_program_main(start)
    // The program is done. Say so first -- the main thread stops waiting
    // for acknowledgements from here on -- then close the activity.
    __atomic_add((G_B + B_GONE) as *mut u64, 1)
    var m: [u8; 26] = "main returned, finishing\0\0"
    log_c((&m[0]) as u64)
    ndk.ANativeActivity_finish(ld(B_ACT))
    return code as u64
}

#[no_gc]
fn log_c(text: u64) {
    var tag: [u8; 5] = "firn\0"
    ndk.log_write(ndk.LOG_INFO, (&tag[0]) as u64, text)
}

// ============================================== THE MAIN THREAD'S SIDE

// One command to the app thread. `sync`: wait until it was taken over --
// but never for a program that has already ended.
#[no_gc]
fn senden(cmd: i32, sync: bool) {
    if G_B == 0 {
        return
    }
    let seq: u64 = ld(B_SENT) + 1
    st(B_SENT, seq)
    var b: [u8; 1] = [0 as u8; 1]
    b[0] = cmd as u8
    let w: i64 = syscall(1, ld(B_FD_W) as i64, (&b[0]) as i64, 1, 0, 0, 0)
    if !sync || w != 1 {
        return
    }
    while ld_sync(B_ACKED) < seq && ld_sync(B_GONE) == 0 {
        schlafen_us(200)
    }
}

#[no_gc]
fn auf_start(a: u64) { }

#[no_gc]
fn auf_fortsetzen(a: u64) {
    st(B_RESUMED, 1)
    senden(CMD_RESUME, false)
}

#[no_gc]
fn auf_pause(a: u64) {
    st(B_RESUMED, 0)
    senden(CMD_PAUSE, false)
}

#[no_gc]
fn auf_halt(a: u64) { }

// The activity is going away for good. The program got EV_CLOSED; give
// it two seconds to leave `main`, then END THE PROCESS. A second activity
// in the same process cannot get a fresh program: the collector measured
// the stack of the first app thread (gc_init runs once), and every static
// of the program still holds its old value. A new start is a new process.
#[no_gc]
fn auf_ende(a: u64) {
    senden(CMD_DESTROY, true)
    var i: usize = 0
    while ld_sync(B_GONE) == 0 && i < 2000 {
        schlafen_us(1000)
        i = i + 1
    }
    var m: [u8; 20] = "activity destroyed\0\0"
    log_c((&m[0]) as u64)
    syscall(231, 0, 0, 0, 0, 0, 0)
}

#[no_gc]
fn auf_scharf(a: u64, hat: i32) {
    senden(CMD_FOCUS, false)
}

#[no_gc]
fn auf_fenster_da(a: u64, win: u64) {
    st(B_WIN, win)
    senden(CMD_WINDOW, true)
}

#[no_gc]
fn auf_fenster_neu(a: u64, win: u64) {
    senden(CMD_RESIZED, false)
}

#[no_gc]
fn auf_fenster_malen(a: u64, win: u64) {
    senden(CMD_REDRAW, true)
}

#[no_gc]
fn auf_fenster_weg(a: u64, win: u64) {
    st(B_WIN, 0)
    senden(CMD_WINDOW, true)
}

#[no_gc]
fn auf_rechteck(a: u64, r: u64) {
    if r == 0 {
        return
    }
    let p: u64 = G_B + B_RECT
    var i: u64 = 0
    while i < 4 {
        *((p + i * 4) as *mut i32) = *((r + i * 4) as *mut i32)
        i = i + 1
    }
    senden(CMD_RESIZED, false)
}

#[no_gc]
fn auf_warte_da(a: u64, q: u64) {
    st(B_QUEUE, q)
    senden(CMD_QUEUE, true)
}

#[no_gc]
fn auf_warte_weg(a: u64, q: u64) {
    st(B_QUEUE, 0)
    senden(CMD_QUEUE, true)
}

#[no_gc]
fn auf_einstellung(a: u64) {
    senden(CMD_CONFIG, false)
}

#[no_gc]
fn auf_wenigspeicher(a: u64) {
    senden(CMD_LOWMEM, false)
}

#[no_gc]
fn pfad_kopieren(src: u64) -> bool {
    if src == 0 {
        return false
    }
    let n: usize = roh_laenge(src)
    if n == 0 || n > 480 {
        return false
    }
    roh_kopie(G_B + B_PATH, src, n)
    *((G_B + B_PATH + n as u64) as *mut u8) = 0 as u8
    return true
}

// stdout and stderr into `<data path>/stdout.txt`: a program's `print`
// and a panic message are then readable with `adb shell cat`.
#[no_gc]
fn ausgabe_umlenken() {
    let dp: u64 = activity_data_path()
    if dp == 0 {
        return
    }
    var p: [u8; 512] = [0 as u8; 512]
    let n: usize = roh_laenge(dp)
    roh_kopie((&p[0]) as u64, dp, n)
    var tail: [u8; 12] = "/stdout.txt\0"
    roh_kopie((&p[0]) as u64 + n as u64, (&tail[0]) as u64, 12)
    // open(path, O_WRONLY|O_CREAT|O_TRUNC, 0644)
    let fd: i64 = syscall(2, (&p[0]) as i64, 577, 420, 0, 0, 0)
    if fd < 0 {
        return
    }
    let a: i32 = c_dup2(fd as i32, 1)
    let b: i32 = c_dup2(fd as i32, 2)
    syscall(3, fd, 0, 0, 0, 0, 0)
}

// ================================================ THE ENTRY POINT
//
// Named in the manifest as `android.app.func_name`. Android calls it on
// its main thread for every new activity instance -- after a rotation
// with `configChanges` missing, or after the process was kept and the
// activity recreated. The shared block and the thread exist ONCE per
// process; a second call only hands over the new activity.
#[export_c]
#[no_gc]
fn firn_activity_create(activity: u64, saved: u64, saved_len: usize) {
    if G_B == 0 {
        let b: u64 = rt.heap_alloc(B_BYTES)
        if b == 0 {
            return
        }
        // mmap hands out zeroed pages.
        G_B = b
        var fds: [i32; 2] = [0; 2]
        // socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, fds)
        let r: i64 = syscall(53, 1, 524289, 0, (&fds[0]) as i64, 0, 0)
        if r != 0 {
            G_B = 0
            return
        }
        st(B_FD_R, fds[0] as u64)
        st(B_FD_W, fds[1] as u64)
    }
    st(B_ACT, activity)
    let copied: bool = pfad_kopieren(ndk.peek64(activity + ndk.ACT_EXTERNAL_DATA_PATH))
    if !copied {
        let c2: bool = pfad_kopieren(ndk.peek64(activity + ndk.ACT_INTERNAL_DATA_PATH))
    }

    let tafel: u64 = ndk.peek64(activity + ndk.ACT_CALLBACKS)
    if tafel != 0 {
        ndk.poke64(tafel + ndk.CB_ON_START * 8, ndk.code_of1(auf_start))
        ndk.poke64(tafel + ndk.CB_ON_RESUME * 8, ndk.code_of1(auf_fortsetzen))
        ndk.poke64(tafel + ndk.CB_ON_PAUSE * 8, ndk.code_of1(auf_pause))
        ndk.poke64(tafel + ndk.CB_ON_STOP * 8, ndk.code_of1(auf_halt))
        ndk.poke64(tafel + ndk.CB_ON_DESTROY * 8, ndk.code_of1(auf_ende))
        ndk.poke64(tafel + ndk.CB_ON_LOWMEM * 8,
            ndk.code_of1(auf_wenigspeicher))
        ndk.poke64(tafel + ndk.CB_ON_CONFIG * 8, ndk.code_of1(auf_einstellung))
        ndk.poke64(tafel + ndk.CB_ON_FOCUS * 8, ndk.code_of3(auf_scharf))
        ndk.poke64(tafel + ndk.CB_ON_WIN_CREATED * 8,
            ndk.code_of2(auf_fenster_da))
        ndk.poke64(tafel + ndk.CB_ON_WIN_RESIZED * 8,
            ndk.code_of2(auf_fenster_neu))
        ndk.poke64(tafel + ndk.CB_ON_WIN_REDRAW * 8,
            ndk.code_of2(auf_fenster_malen))
        ndk.poke64(tafel + ndk.CB_ON_WIN_DESTROYED * 8,
            ndk.code_of2(auf_fenster_weg))
        ndk.poke64(tafel + ndk.CB_ON_QUEUE_CREATED * 8,
            ndk.code_of2(auf_warte_da))
        ndk.poke64(tafel + ndk.CB_ON_QUEUE_DESTROYED * 8,
            ndk.code_of2(auf_warte_weg))
        ndk.poke64(tafel + ndk.CB_ON_RECT * 8, ndk.code_of2(auf_rechteck))
    }

    if ld(B_TID) != 0 {
        // The thread is already there (a new activity in the same process,
        // the old one was destroyed without the process ending -- which
        // `auf_ende` prevents). If the program has ended, there is nothing
        // to host.
        if ld_sync(B_GONE) != 0 {
            ndk.ANativeActivity_finish(activity)
        }
        return
    }
    ausgabe_umlenken()
    let attr: u64 = G_B + B_ATTR
    let a1: i32 = pthread_attr_init(attr)
    let a2: i32 = pthread_attr_setstacksize(attr, STACK_BYTES)
    let a3: i32 = pthread_attr_setdetachstate(attr, PTHREAD_CREATE_DETACHED)
    let rc: i32 = pthread_create(G_B + B_TID, attr,
        ndk.code_of_thread(thread_app_main), 0)
    if rc != 0 {
        var m: [u8; 23] = "pthread_create failed\0\0"
        log_c((&m[0]) as u64)
        st(B_TID, 0)
        return
    }
    // Wait until the app thread listens: from here on every callback can
    // rely on its command being read.
    var i: usize = 0
    while ld_sync(B_READY) == 0 && i < 20000 {
        schlafen_us(100)
        i = i + 1
    }
    var ok: [u8; 20] = "firn host started\0\0\0"
    log_c((&ok[0]) as u64)
}
