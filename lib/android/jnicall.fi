// SPDX-License-Identifier: MPL-2.0
// lib/android/jnicall.fi -- CALLING JAVA FROM FIRN, ON ANY THREAD.
//
// JNI is a C interface: `JNIEnv*` points at a pointer to a table of
// function pointers (`struct JNINativeInterface`, <jni.h>), and whoever can
// read the table can call every method of the framework -- without a class
// of his own. Certus' lib/android/jni.fi does that for one question (the
// insets); this file is the general form of it, and everything in it is
// #[no_gc]: it runs on Android's main thread (service callbacks) and on the
// push thread, where the collector must never run.
//
// THE INDICES are the positions in the JNI specification's function table
// ("Interface Function Table"); the ones Certus MEASURED from the NDK's
// jni.h (6, 15, 17, 23, 31, 33, 36, 51, 94, 100, 113, 131, 167) agree.
//
// ONLY THE `A` FORMS (argument array of `jvalue`) are used: the variadic
// forms pass their arguments differently on aarch64 (AAPCS64 6.4.2), and a
// Firn call does not know about that. A `jvalue` is eight octets; an `int`
// or `boolean` lies in the low ones, so an argument array is `[u64; n]`.
import android.ndk

export {
    j_env, j_vm, j_detach, j_ok, j_class, j_method, j_smethod, j_sfield_int,
    j_obj, j_void, j_int, j_bool, j_sobj, j_new, j_str, j_del, j_global,
    j_obj_class, j_array1, j_utf_chars, j_utf_release,
    j_array_len, j_array_get,
}

const F_FIND_CLASS: u64 = 6
const F_EXC_DESCRIBE: u64 = 16
const F_EXC_CLEAR: u64 = 17
const F_NEW_GLOBAL: u64 = 21
const F_DEL_LOCAL: u64 = 23
const F_NEW_OBJECT_A: u64 = 30
const F_GET_OBJECT_CLASS: u64 = 31
const F_GET_METHOD: u64 = 33
const F_CALL_OBJECT_A: u64 = 36
const F_CALL_BOOLEAN_A: u64 = 39
const F_CALL_INT_A: u64 = 51
const F_CALL_VOID_A: u64 = 63
const F_GET_STATIC_METHOD: u64 = 113
const F_CALL_STATIC_OBJECT_A: u64 = 116
const F_GET_STATIC_FIELD: u64 = 144
const F_GET_STATIC_INT: u64 = 150
const F_NEW_STRING_UTF: u64 = 167
const F_GET_STRING_UTF: u64 = 169
const F_REL_STRING_UTF: u64 = 170
const F_GET_ARRAY_LENGTH: u64 = 171
const F_NEW_OBJECT_ARRAY: u64 = 172
const F_GET_OBJECT_ARRAY: u64 = 173
const F_SET_OBJECT_ARRAY: u64 = 174
const F_GET_JAVA_VM: u64 = 219
const F_EXC_CHECK: u64 = 228
// JNIInvokeInterface
const V_ATTACH: u64 = 4
const V_DETACH: u64 = 5
const V_GET_ENV: u64 = 6
const JNI_VERSION_1_6: u64 = 65542

// ------------------------------------------------ calls through a table
struct C2 { f: fn(u64, u64) -> u64 }
struct C3 { f: fn(u64, u64, u64) -> u64 }
struct C4 { f: fn(u64, u64, u64, u64) -> u64 }
struct C5 { f: fn(u64, u64, u64, u64, u64) -> u64 }

#[no_gc]
fn eintrag(env: u64, i: u64) -> u64 {
    return ndk.peek64(ndk.peek64(env) + i * 8)
}

#[no_gc]
fn ruf2(code: u64, a: u64, b: u64) -> u64 {
    var satz: [u64; 1] = [0; 1]
    satz[0] = code
    var wert: [u64; 1] = [0; 1]
    wert[0] = (&satz[0]) as u64
    let h: *mut C2 = (&wert[0]) as *mut C2
    let f: fn(u64, u64) -> u64 = (*h).f
    return f(a, b)
}

#[no_gc]
fn ruf3(code: u64, a: u64, b: u64, c: u64) -> u64 {
    var satz: [u64; 1] = [0; 1]
    satz[0] = code
    var wert: [u64; 1] = [0; 1]
    wert[0] = (&satz[0]) as u64
    let h: *mut C3 = (&wert[0]) as *mut C3
    let f: fn(u64, u64, u64) -> u64 = (*h).f
    return f(a, b, c)
}

#[no_gc]
fn ruf4(code: u64, a: u64, b: u64, c: u64, d: u64) -> u64 {
    var satz: [u64; 1] = [0; 1]
    satz[0] = code
    var wert: [u64; 1] = [0; 1]
    wert[0] = (&satz[0]) as u64
    let h: *mut C4 = (&wert[0]) as *mut C4
    let f: fn(u64, u64, u64, u64) -> u64 = (*h).f
    return f(a, b, c, d)
}

#[no_gc]
fn ruf5(code: u64, a: u64, b: u64, c: u64, d: u64, e: u64) -> u64 {
    var satz: [u64; 1] = [0; 1]
    satz[0] = code
    var wert: [u64; 1] = [0; 1]
    wert[0] = (&satz[0]) as u64
    let h: *mut C5 = (&wert[0]) as *mut C5
    let f: fn(u64, u64, u64, u64, u64) -> u64 = (*h).f
    return f(a, b, c, d, e)
}

// ------------------------------------------------------ the environment

// The JNIEnv of THIS thread. A thread Java has never seen is attached
// (and stays attached until `j_detach`). 0 = no VM.
#[no_gc]
fn j_env(vm: u64) -> u64 {
    if vm == 0 {
        return 0
    }
    var env: [u64; 1] = [0; 1]
    let t: u64 = ndk.peek64(vm)
    let r: u64 = ruf3(ndk.peek64(t + V_GET_ENV * 8), vm, (&env[0]) as u64,
        JNI_VERSION_1_6)
    if (r & 4294967295) == 0 && env[0] != 0 {
        return env[0]
    }
    env[0] = 0
    let a: u64 = ruf3(ndk.peek64(t + V_ATTACH * 8), vm, (&env[0]) as u64, 0)
    if (a & 4294967295) != 0 {
        return 0
    }
    return env[0]
}

#[no_gc]
fn j_detach(vm: u64) {
    if vm == 0 {
        return
    }
    let t: u64 = ndk.peek64(vm)
    let r: u64 = ruf2(ndk.peek64(t + V_DETACH * 8), vm, 0)
}

#[no_gc]
fn j_vm(env: u64) -> u64 {
    var vm: [u64; 1] = [0; 1]
    let r: u64 = ruf2(eintrag(env, F_GET_JAVA_VM), env, (&vm[0]) as u64)
    return vm[0]
}

// A pending exception MUST be cleared, or the next JNI call aborts the
// VM. It is described first: the stack trace lands in logcat, which is
// the only way to see WHICH Java call refused.
#[no_gc]
fn j_ok(env: u64) -> bool {
    let e: u64 = ruf2(eintrag(env, F_EXC_CHECK), env, 0) & 255
    if e != 0 {
        let d: u64 = ruf2(eintrag(env, F_EXC_DESCRIBE), env, 0)
        let c: u64 = ruf2(eintrag(env, F_EXC_CLEAR), env, 0)
        return false
    }
    return true
}

// -------------------------------------------------------- the lookups
// `name`, `sig`: zero terminated.
#[no_gc]
fn j_class(env: u64, name: u64) -> u64 {
    let c: u64 = ruf2(eintrag(env, F_FIND_CLASS), env, name)
    if !j_ok(env) {
        return 0
    }
    return c
}

#[no_gc]
fn j_obj_class(env: u64, o: u64) -> u64 {
    if o == 0 {
        return 0
    }
    return ruf2(eintrag(env, F_GET_OBJECT_CLASS), env, o)
}

#[no_gc]
fn j_method(env: u64, cls: u64, name: u64, sig: u64) -> u64 {
    if cls == 0 {
        return 0
    }
    let m: u64 = ruf4(eintrag(env, F_GET_METHOD), env, cls, name, sig)
    if !j_ok(env) {
        return 0
    }
    return m
}

#[no_gc]
fn j_smethod(env: u64, cls: u64, name: u64, sig: u64) -> u64 {
    if cls == 0 {
        return 0
    }
    let m: u64 = ruf4(eintrag(env, F_GET_STATIC_METHOD), env, cls, name, sig)
    if !j_ok(env) {
        return 0
    }
    return m
}

#[no_gc]
fn j_sfield_int(env: u64, cls: u64, name: u64, sig: u64) -> i32 {
    if cls == 0 {
        return 0
    }
    let f: u64 = ruf4(eintrag(env, F_GET_STATIC_FIELD), env, cls, name, sig)
    if f == 0 || !j_ok(env) {
        return 0
    }
    return jint(ruf3(eintrag(env, F_GET_STATIC_INT), env, cls, f))
}

// The low 32 bits as a SIGNED jint. A plain `as i32` is a checked cast in
// Firn and aborts on -1 (checkSelfPermission's "denied") -- measured.
#[no_gc]
fn jint(r: u64) -> i32 {
    let v: u64 = r & 4294967295
    if v >= 2147483648 {
        return (v as i64 - 4294967296) as i32
    }
    return v as i32
}

// ---------------------------------------------------------- the calls
// `args`: address of a `[u64; n]` (jvalue array), 0 for none.
#[no_gc]
fn j_obj(env: u64, o: u64, m: u64, args: u64) -> u64 {
    if o == 0 || m == 0 {
        return 0
    }
    let r: u64 = ruf4(eintrag(env, F_CALL_OBJECT_A), env, o, m, args)
    if !j_ok(env) {
        return 0
    }
    return r
}

#[no_gc]
fn j_void(env: u64, o: u64, m: u64, args: u64) -> bool {
    if o == 0 || m == 0 {
        return false
    }
    let r: u64 = ruf4(eintrag(env, F_CALL_VOID_A), env, o, m, args)
    return j_ok(env)
}

// `jint` is four octets: the upper half of the register is undefined after
// a C call (Certus measured a status bar of four billion pixels once).
#[no_gc]
fn j_int(env: u64, o: u64, m: u64, args: u64) -> i32 {
    if o == 0 || m == 0 {
        return 0
    }
    let r: u64 = ruf4(eintrag(env, F_CALL_INT_A), env, o, m, args)
    if !j_ok(env) {
        return 0
    }
    return jint(r)
}

#[no_gc]
fn j_bool(env: u64, o: u64, m: u64, args: u64) -> bool {
    if o == 0 || m == 0 {
        return false
    }
    let r: u64 = ruf4(eintrag(env, F_CALL_BOOLEAN_A), env, o, m, args)
    if !j_ok(env) {
        return false
    }
    return (r & 255) != 0
}

#[no_gc]
fn j_sobj(env: u64, cls: u64, m: u64, args: u64) -> u64 {
    if cls == 0 || m == 0 {
        return 0
    }
    let r: u64 = ruf4(eintrag(env, F_CALL_STATIC_OBJECT_A), env, cls, m, args)
    if !j_ok(env) {
        return 0
    }
    return r
}

#[no_gc]
fn j_new(env: u64, cls: u64, ctor: u64, args: u64) -> u64 {
    if cls == 0 || ctor == 0 {
        return 0
    }
    let r: u64 = ruf4(eintrag(env, F_NEW_OBJECT_A), env, cls, ctor, args)
    if !j_ok(env) {
        return 0
    }
    return r
}

// A Java string from zero terminated MODIFIED UTF-8 (ASCII is fine; the
// caller cleans foreign text first, see push.fi `utf_sauber`).
#[no_gc]
fn j_str(env: u64, c: u64) -> u64 {
    let r: u64 = ruf2(eintrag(env, F_NEW_STRING_UTF), env, c)
    if !j_ok(env) {
        return 0
    }
    return r
}

// `new T[1] { o }` for an object array of class `cls`.
#[no_gc]
fn j_array1(env: u64, cls: u64, o: u64) -> u64 {
    let a: u64 = ruf4(eintrag(env, F_NEW_OBJECT_ARRAY), env, 1, cls, 0)
    if a == 0 || !j_ok(env) {
        return 0
    }
    let r: u64 = ruf4(eintrag(env, F_SET_OBJECT_ARRAY), env, a, 0, o)
    if !j_ok(env) {
        return 0
    }
    return a
}

// The length of a Java array; 0 for none.
#[no_gc]
fn j_array_len(env: u64, a: u64) -> usize {
    if a == 0 {
        return 0
    }
    let r: u64 = ruf2(eintrag(env, F_GET_ARRAY_LENGTH), env, a)
    let n: i32 = jint(r)
    if n <= 0 {
        return 0
    }
    return n as usize
}

// Element `i` of an object array, as a new local reference (0 on error).
#[no_gc]
fn j_array_get(env: u64, a: u64, i: usize) -> u64 {
    if a == 0 {
        return 0
    }
    let r: u64 = ruf3(eintrag(env, F_GET_OBJECT_ARRAY), env, a, i as u64)
    if !j_ok(env) {
        return 0
    }
    return r
}

#[no_gc]
fn j_utf_chars(env: u64, s: u64) -> u64 {
    if s == 0 {
        return 0
    }
    return ruf3(eintrag(env, F_GET_STRING_UTF), env, s, 0)
}

#[no_gc]
fn j_utf_release(env: u64, s: u64, c: u64) {
    if s == 0 || c == 0 {
        return
    }
    let r: u64 = ruf3(eintrag(env, F_REL_STRING_UTF), env, s, c)
}

#[no_gc]
fn j_del(env: u64, o: u64) {
    if o == 0 {
        return
    }
    let r: u64 = ruf2(eintrag(env, F_DEL_LOCAL), env, o)
}

#[no_gc]
fn j_global(env: u64, o: u64) -> u64 {
    if o == 0 {
        return 0
    }
    return ruf2(eintrag(env, F_NEW_GLOBAL), env, o)
}
