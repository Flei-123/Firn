// SPDX-License-Identifier: MPL-2.0
// lib/android/intentextra.fi -- the extras of the Intent that started the activity (`adb shell am start --es key v --ei k 1 --ez b true`),
// read over JNI on the app thread. Nothing is removed from the Intent (unlike push_intent_cid); every local reference is deleted.
//
//     intentextra.extra_str("tab", &buf[0], 64)      -> length (0 = no such string extra)
//     intentextra.extra_int("autoscroll", 0)         -> the int extra, or the default
//     intentextra.extra_bool("autorun", false)       -> the boolean extra, or the default
//
// Any failed step answers "not there" (0 / default) and clears the Java exception. Read once at start (the Intent of a later
// onNewIntent is not followed).
import android.ndk
import android.activity
import android.jnicall

export { extra_str, extra_int, extra_bool }

const S_GET_INTENT: str = "getIntent\0"
const S_GET_INTENT_SIG: str = "()Landroid/content/Intent;\0"
const S_GET_STR: str = "getStringExtra\0"
const S_GET_STR_SIG: str = "(Ljava/lang/String;)Ljava/lang/String;\0"
const S_GET_INT: str = "getIntExtra\0"
const S_GET_INT_SIG: str = "(Ljava/lang/String;I)I\0"
const S_GET_BOOL: str = "getBooleanExtra\0"
const S_GET_BOOL_SIG: str = "(Ljava/lang/String;Z)Z\0"

// the activity's Intent as a local reference (0 = none); `env` is the JNIEnv of this thread
#[no_gc]
fn intent_of(env: *mut u64) -> u64 {
    let act: u64 = activity.activity_pointer()
    if act == 0 {
        return 0
    }
    let e: u64 = jnicall.j_env(ndk.peek64(act + 8))
    let clazz: u64 = ndk.peek64(act + 24)
    if e == 0 || clazz == 0 {
        return 0
    }
    *env = e
    let cc: u64 = jnicall.j_obj_class(e, clazz)
    if cc == 0 {
        return 0
    }
    let it: u64 = jnicall.j_obj(e, clazz, jnicall.j_method(e, cc, S_GET_INTENT.p as u64, S_GET_INTENT_SIG.p as u64), 0)
    jnicall.j_del(e, cc)
    return it
}

// `key` must be zero terminated ("tab\0")
#[no_gc]
fn extra_str(key: str, out: u64, cap: usize) -> usize {
    var env: u64 = 0
    let it: u64 = intent_of(&env)
    if it == 0 || cap < 2 {
        return 0
    }
    var n: usize = 0
    let ic: u64 = jnicall.j_obj_class(env, it)
    var a: [u64; 1] = [0; 1]
    a[0] = jnicall.j_str(env, key.p as u64)
    let js: u64 = jnicall.j_obj(env, it, jnicall.j_method(env, ic, S_GET_STR.p as u64, S_GET_STR_SIG.p as u64), (&a[0]) as u64)
    if js != 0 {
        let ch: u64 = jnicall.j_utf_chars(env, js)
        if ch != 0 {
            var l: usize = 0
            while *((ch + l as u64) as *mut u8) != 0 as u8 && l + 1 < cap {
                *((out + l as u64) as *mut u8) = *((ch + l as u64) as *mut u8)
                l = l + 1
            }
            *((out + l as u64) as *mut u8) = 0 as u8
            n = l
            jnicall.j_utf_release(env, js, ch)
        }
        jnicall.j_del(env, js)
    }
    jnicall.j_del(env, a[0])
    jnicall.j_del(env, ic)
    jnicall.j_del(env, it)
    return n
}

#[no_gc]
fn extra_int(key: str, dflt: i32) -> i32 {
    var env: u64 = 0
    let it: u64 = intent_of(&env)
    if it == 0 {
        return dflt
    }
    let ic: u64 = jnicall.j_obj_class(env, it)
    var a: [u64; 2] = [0; 2]
    a[0] = jnicall.j_str(env, key.p as u64)
    a[1] = (dflt as u64) & 4294967295
    let r: i32 = jnicall.j_int(env, it, jnicall.j_method(env, ic, S_GET_INT.p as u64, S_GET_INT_SIG.p as u64), (&a[0]) as u64)
    jnicall.j_del(env, a[0])
    jnicall.j_del(env, ic)
    jnicall.j_del(env, it)
    return r
}

#[no_gc]
fn extra_bool(key: str, dflt: bool) -> bool {
    var env: u64 = 0
    let it: u64 = intent_of(&env)
    if it == 0 {
        return dflt
    }
    let ic: u64 = jnicall.j_obj_class(env, it)
    var a: [u64; 2] = [0; 2]
    a[0] = jnicall.j_str(env, key.p as u64)
    if dflt {
        a[1] = 1 as u64
    }
    let r: bool = jnicall.j_bool(env, it, jnicall.j_method(env, ic, S_GET_BOOL.p as u64, S_GET_BOOL_SIG.p as u64), (&a[0]) as u64)
    jnicall.j_del(env, a[0])
    jnicall.j_del(env, ic)
    jnicall.j_del(env, it)
    return r
}
