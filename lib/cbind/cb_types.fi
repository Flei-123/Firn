import std.vec
import std.dict
import cbind.cb_util

export {
    Ty, Param, Field, Rec, Typedef, FnDecl, Db, db_new, ty_new, ty_ptr, ty_arr, ty_named, ty_ref, strip,
    K_VOID, K_INT, K_FLT, K_BOOL, K_PTR, K_ARR, K_FUNC, K_REC, K_NAME,
    B_VOID, B_CHAR, B_SCHAR, B_UCHAR, B_SHORT, B_USHORT, B_INT, B_UINT, B_LONG, B_ULONG, B_LLONG, B_ULLONG,
    B_FLOAT, B_DOUBLE, B_LDOUBLE, B_BOOL, B_I128, B_U128,
    typedef_add, typedef_find, rec_find, rec_add, tag_key, db_warn, int_type,
}

const K_VOID: u32 = 0
const K_INT: u32 = 1
const K_FLT: u32 = 2
const K_BOOL: u32 = 3
const K_PTR: u32 = 4
const K_ARR: u32 = 5
const K_FUNC: u32 = 6
const K_REC: u32 = 7
const K_NAME: u32 = 8

const B_VOID: i32 = 0
const B_CHAR: i32 = 1
const B_SCHAR: i32 = 2
const B_UCHAR: i32 = 3
const B_SHORT: i32 = 4
const B_USHORT: i32 = 5
const B_INT: i32 = 6
const B_UINT: i32 = 7
const B_LONG: i32 = 8
const B_ULONG: i32 = 9
const B_LLONG: i32 = 10
const B_ULLONG: i32 = 11
const B_FLOAT: i32 = 12
const B_DOUBLE: i32 = 13
const B_LDOUBLE: i32 = 14
const B_BOOL: i32 = 15
const B_I128: i32 = 16
const B_U128: i32 = 17

struct Ty {
    kind: u32,
    size: u64,
    align: u64,
    sgn: bool,
    elem: i32,
    count: i64,
    rec: i32,
    name: str,
    pstart: u32,
    pcount: u32,
    variadic: bool,
}

struct Param {
    name: str,
    ty: i32,
}

struct Field {
    name: str,
    ty: i32,
    bits: i32,
    off: u64,
    bitoff: u64,
    aalign: u64,
}

struct Rec {
    name: str,
    cname: str,
    is_union: bool,
    is_enum: bool,
    complete: bool,
    packed: bool,
    aalign: u64,
    fstart: u32,
    fcount: u32,
    size: u64,
    align: u64,
    laid: bool,
    ty: i32,
    file: u32,
    neg: bool,
    owner: i32,
    owner_field: str,
}

struct Typedef {
    name: str,
    ty: i32,
    file: u32,
    used: bool,
    builtin: bool,
}

struct FnDecl {
    name: str,
    ty: i32,
    file: u32,
    has_body: bool,
    is_static: bool,
    target: str,
}

struct Db {
    tys: Vec[Ty],
    params: Vec[Param],
    fields: Vec[Field],
    recs: Vec[Rec],
    tds: Vec[Typedef],
    fns: Vec[FnDecl],
    td_index: Dict[i32],
    tag_index: Dict[i32],
    consts: Dict[i64],
    const_names: Vec[str],
    const_vals: Vec[i64],
    const_files: Vec[u32],
    text_consts: Vec[str],
    warns: Vec[str],
}

fn db_warn(db: *mut Db, msg: str) {
    vec_push[str](&(*db).warns, msg)
}

fn ty_new(db: *mut Db, kind: u32, size: u64, align: u64, sgn: bool) -> i32 {
    let id: i32 = vec_len[Ty](&(*db).tys) as i32
    vec_push[Ty](&(*db).tys, Ty {
            kind: kind, size: size, align: align, sgn: sgn, elem: 0 - 1, count: 0, rec: 0 - 1,
            name: "", pstart: 0, pcount: 0, variadic: false,
        })
    return id
}

fn ty_ref(db: *mut Db, id: i32) -> *mut Ty {
    return vec_elem_ptr[Ty](&(*db).tys, id as usize)
}

fn ty_ptr(db: *mut Db, elem: i32) -> i32 {
    let id: i32 = ty_new(db, K_PTR, 8, 8, false)
    (*ty_ref(db, id)).elem = elem
    return id
}

fn ty_arr(db: *mut Db, elem: i32, count: i64) -> i32 {
    let id: i32 = ty_new(db, K_ARR, 0, 0, false)
    let t: *mut Ty = ty_ref(db, id)
    (*t).elem = elem
    (*t).count = count
    return id
}

fn ty_named(db: *mut Db, name: str, target: i32) -> i32 {
    let id: i32 = ty_new(db, K_NAME, 0, 0, false)
    let t: *mut Ty = ty_ref(db, id)
    (*t).elem = target
    (*t).name = name
    return id
}

fn strip(db: *mut Db, id: i32) -> i32 {
    var t: i32 = id
    while (*ty_ref(db, t)).kind == K_NAME {
        t = (*ty_ref(db, t)).elem
    }
    return t
}

fn int_type(sz: u64, sgn: bool) -> i32 {
    if sz == 1 { if sgn { return B_SCHAR } return B_UCHAR }
    if sz == 2 { if sgn { return B_SHORT } return B_USHORT }
    if sz == 4 { if sgn { return B_INT } return B_UINT }
    if sz == 8 { if sgn { return B_LONG } return B_ULONG }
    if sgn { return B_I128 }
    return B_U128
}

fn typedef_add(db: *mut Db, name: str, ty: i32, file: u32, builtin: bool) {
    var old: i32 = 0
    if dict_get_if[i32](&(*db).td_index, name, &old) {
        return
    }
    let idx: i32 = vec_len[Typedef](&(*db).tds) as i32
    vec_push[Typedef](&(*db).tds, Typedef { name: name, ty: ty_named(db, name, ty), file: file, used: false, builtin: builtin })
    dict_set[i32](&(*db).td_index, name, idx)
}

fn typedef_find(db: *mut Db, name: str) -> i32 {
    var idx: i32 = 0
    if dict_get_if[i32](&(*db).td_index, name, &idx) {
        return idx
    }
    return 0 - 1
}

fn tag_key(is_union: bool, is_enum: bool, name: str) -> str {
    if is_enum { return "enum " + name }
    if is_union { return "union " + name }
    return "struct " + name
}

fn rec_find(db: *mut Db, key: str) -> i32 {
    var idx: i32 = 0
    if dict_get_if[i32](&(*db).tag_index, key, &idx) {
        return idx
    }
    return 0 - 1
}

fn rec_add(db: *mut Db, name: str, is_union: bool, is_enum: bool, file: u32) -> i32 {
    let idx: i32 = vec_len[Rec](&(*db).recs) as i32
    let ty: i32 = ty_new(db, K_REC, 0, 0, false)
    (*ty_ref(db, ty)).rec = idx
    var cname: str = ""
    if name.n > 0 {
        cname = tag_key(is_union, is_enum, name)
        dict_set[i32](&(*db).tag_index, cname, idx)
    }
    vec_push[Rec](&(*db).recs, Rec {
            name: name, cname: cname, is_union: is_union, is_enum: is_enum, complete: false, packed: false, aalign: 0,
            fstart: 0, fcount: 0, size: 0, align: 1, laid: false, ty: ty, file: file, neg: false, owner: 0 - 1, owner_field: "",
        })
    return idx
}

fn add_base(db: *mut Db, size: u64, align: u64, sgn: bool, kind: u32) {
    ty_new(db, kind, size, align, sgn)
}

fn builtin_typedef(db: *mut Db, name: str, base: i32) {
    typedef_add(db, name, base, 0, true)
}

fn db_new() -> Db {
    var db: Db = Db {
        tys: vec_new[Ty](), params: vec_new[Param](), fields: vec_new[Field](), recs: vec_new[Rec](), tds: vec_new[Typedef](),
        fns: vec_new[FnDecl](), td_index: dict_new[i32](), tag_index: dict_new[i32](), consts: dict_new[i64](),
        const_names: vec_new[str](), const_vals: vec_new[i64](), const_files: vec_new[u32](), text_consts: vec_new[str](), warns: vec_new[str](),
    }
    let p: *mut Db = &db
    add_base(p, 1, 1, false, K_VOID)
    add_base(p, 1, 1, true, K_INT)
    add_base(p, 1, 1, true, K_INT)
    add_base(p, 1, 1, false, K_INT)
    add_base(p, 2, 2, true, K_INT)
    add_base(p, 2, 2, false, K_INT)
    add_base(p, 4, 4, true, K_INT)
    add_base(p, 4, 4, false, K_INT)
    add_base(p, 8, 8, true, K_INT)
    add_base(p, 8, 8, false, K_INT)
    add_base(p, 8, 8, true, K_INT)
    add_base(p, 8, 8, false, K_INT)
    add_base(p, 4, 4, true, K_FLT)
    add_base(p, 8, 8, true, K_FLT)
    add_base(p, 16, 16, true, K_FLT)
    add_base(p, 1, 1, false, K_BOOL)
    add_base(p, 16, 16, true, K_INT)
    add_base(p, 16, 16, false, K_INT)
    builtin_typedef(p, "size_t", B_ULONG)
    builtin_typedef(p, "ssize_t", B_LONG)
    builtin_typedef(p, "ptrdiff_t", B_LONG)
    builtin_typedef(p, "intptr_t", B_LONG)
    builtin_typedef(p, "uintptr_t", B_ULONG)
    builtin_typedef(p, "intmax_t", B_LONG)
    builtin_typedef(p, "uintmax_t", B_ULONG)
    builtin_typedef(p, "off_t", B_LONG)
    builtin_typedef(p, "time_t", B_LONG)
    builtin_typedef(p, "wchar_t", B_INT)
    builtin_typedef(p, "int8_t", B_SCHAR)
    builtin_typedef(p, "uint8_t", B_UCHAR)
    builtin_typedef(p, "int16_t", B_SHORT)
    builtin_typedef(p, "uint16_t", B_USHORT)
    builtin_typedef(p, "int32_t", B_INT)
    builtin_typedef(p, "uint32_t", B_UINT)
    builtin_typedef(p, "int64_t", B_LONG)
    builtin_typedef(p, "uint64_t", B_ULONG)
    return db
}
