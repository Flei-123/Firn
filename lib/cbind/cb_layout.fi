import std.vec
import cbind.cb_types

export { size_of, align_of, layout_rec, round_up }

fn round_up(v: u64, a: u64) -> u64 {
    if a <= 1 {
        return v
    }
    return (v + a - 1) / a * a
}

fn size_of(db: *mut cb_types.Db, t: i32) -> u64 {
    let s: i32 = cb_types.strip(db, t)
    let ty: *mut cb_types.Ty = cb_types.ty_ref(db, s)
    if (*ty).kind == cb_types.K_ARR {
        if (*ty).count < 0 {
            return 0
        }
        return size_of(db, (*ty).elem) * ((*ty).count as u64)
    }
    if (*ty).kind == cb_types.K_REC {
        layout_rec(db, (*ty).rec)
        return (*vec_elem_ptr[cb_types.Rec](&(*db).recs, (*ty).rec as usize)).size
    }
    return (*ty).size
}

fn align_of(db: *mut cb_types.Db, t: i32) -> u64 {
    let s: i32 = cb_types.strip(db, t)
    let ty: *mut cb_types.Ty = cb_types.ty_ref(db, s)
    if (*ty).kind == cb_types.K_ARR {
        return align_of(db, (*ty).elem)
    }
    if (*ty).kind == cb_types.K_REC {
        layout_rec(db, (*ty).rec)
        return (*vec_elem_ptr[cb_types.Rec](&(*db).recs, (*ty).rec as usize)).align
    }
    return (*ty).align
}

fn place_bits(r: *mut cb_types.Rec, f: *mut cb_types.Field, unit_bits: u64, bitpos: u64) -> u64 {
    let w: u64 = (*f).bits as u64
    var pos: u64 = bitpos
    if w == 0 {
        return round_up(pos, unit_bits)
    }
    if !(*r).packed && pos / unit_bits != (pos + w - 1) / unit_bits {
        pos = round_up(pos, unit_bits)
    }
    (*f).bitoff = pos
    (*f).off = pos / 8
    return pos + w
}

fn layout_rec(db: *mut cb_types.Db, ri: i32) {
    let r: *mut cb_types.Rec = vec_elem_ptr[cb_types.Rec](&(*db).recs, ri as usize)
    if (*r).laid {
        return
    }
    (*r).laid = true
    if (*r).is_enum {
        (*r).size = 4
        (*r).align = 4
        return
    }
    var align: u64 = 1
    var bitpos: u64 = 0
    var max_size: u64 = 0
    for k in 0..(*r).fcount {
        let f: *mut cb_types.Field = vec_elem_ptr[cb_types.Field](&(*db).fields, ((*r).fstart + k) as usize)
        let fs: u64 = size_of(db, (*f).ty)
        var fa: u64 = align_of(db, (*f).ty)
        if (*r).packed {
            fa = 1
        }
        if (*f).aalign > fa {
            fa = (*f).aalign
        }
        if (*f).bits >= 0 {
            let unit: u64 = fs * 8
            if (*r).is_union {
                (*f).bitoff = 0
                (*f).off = 0
                if fs > max_size {
                    max_size = fs
                }
            } else {
                bitpos = place_bits(r, f, unit, bitpos)
            }
            if (*f).name.n > 0 && (*f).bits > 0 && !(*r).packed && fa > align {
                align = fa
            }
            continue
        }
        if fa > align {
            align = fa
        }
        if (*r).is_union {
            (*f).off = 0
            if fs > max_size {
                max_size = fs
            }
            continue
        }
        bitpos = round_up(bitpos, fa * 8)
        (*f).off = bitpos / 8
        (*f).bitoff = bitpos
        bitpos = bitpos + fs * 8
    }
    if (*r).aalign > align {
        align = (*r).aalign
    }
    var size: u64 = (bitpos + 7) / 8
    if (*r).is_union {
        size = max_size
    }
    (*r).align = align
    (*r).size = round_up(size, align)
}
