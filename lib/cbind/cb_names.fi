import std.vec
import cbind.cb_util
import cbind.cb_types

export { rec_label, fi_name, fi_type, rec_ptr, td_ptr, is_primitive_name, has_offset }

fn rec_ptr(db: *mut cb_types.Db, ri: i32) -> *mut cb_types.Rec {
    return vec_elem_ptr[cb_types.Rec](&(*db).recs, ri as usize)
}

fn td_ptr(db: *mut cb_types.Db, ti: i32) -> *mut cb_types.Typedef {
    return vec_elem_ptr[cb_types.Typedef](&(*db).tds, ti as usize)
}

fn rec_label(db: *mut cb_types.Db, ri: i32) -> str {
    let r: *mut cb_types.Rec = rec_ptr(db, ri)
    if (*r).name.n > 0 {
        return (*r).name
    }
    if (*r).owner >= 0 && (*r).owner != ri {
        var f: str = (*r).owner_field
        if f.n == 0 {
            f = "anon"
        }
        return rec_label(db, (*r).owner) + "_" + f
    }
    return "anon" + cb_util.istr(ri as i64)
}

fn is_keyword(s: str) -> bool {
    return s == "fn" || s == "let" || s == "var" || s == "const" || s == "struct" || s == "enum" || s == "impl"
    || s == "type" || s == "import" || s == "export" || s == "if" || s == "else" || s == "while" || s == "for"
    || s == "in" || s == "loop" || s == "match" || s == "return" || s == "break" || s == "continue" || s == "as"
    || s == "true" || s == "false" || s == "self" || s == "extern" || s == "defer" || s == "try" || s == "catch"
    || s == "interface" || s == "dyn" || s == "mut" || s == "unsafe" || s == "pub" || s == "use" || s == "static"
    || s == "where" || s == "profile" || s == "str" || s == "bool"
}

fn fi_name(s: str) -> str {
    if is_keyword(s) {
        return s + "_"
    }
    return s
}

fn is_primitive_name(s: str) -> bool {
    return s == "u8" || s == "i8" || s == "u16" || s == "i16" || s == "u32" || s == "i32" || s == "u64" || s == "i64"
    || s == "f32" || s == "f64" || s == "usize" || s == "isize" || s == "bool" || s == "str"
}

fn int_name(size: u64, sgn: bool) -> str {
    if size == 1 { if sgn { return "i8" } return "u8" }
    if size == 2 { if sgn { return "i16" } return "u16" }
    if size == 4 { if sgn { return "i32" } return "u32" }
    if size == 8 { if sgn { return "i64" } return "u64" }
    return "[u8; 16]"
}

fn ptr_type(db: *mut cb_types.Db, elem: i32) -> str {
    let s: i32 = cb_types.strip(db, elem)
    let e: *mut cb_types.Ty = cb_types.ty_ref(db, s)
    if (*e).kind == cb_types.K_FUNC {
        return "u64"
    }
    if (*e).kind == cb_types.K_VOID || ((*e).kind == cb_types.K_INT && (*e).size == 1) || (*e).kind == cb_types.K_BOOL {
        return "*mut u8"
    }
    if (*e).kind == cb_types.K_REC {
        let r: *mut cb_types.Rec = rec_ptr(db, (*e).rec)
        if (*r).is_enum {
            return "*mut u32"
        }
        return "*mut " + rec_label(db, (*e).rec)
    }
    if (*e).kind == cb_types.K_ARR {
        return "*mut u8"
    }
    return "*mut " + fi_type(db, elem)
}

fn fi_type(db: *mut cb_types.Db, t: i32) -> str {
    let ty: *mut cb_types.Ty = cb_types.ty_ref(db, t)
    let k: u32 = (*ty).kind
    if k == cb_types.K_NAME {
        let target: *mut cb_types.Ty = cb_types.ty_ref(db, cb_types.strip(db, t))
        if (*target).kind == cb_types.K_REC && !(*rec_ptr(db, (*target).rec)).is_enum {
            return rec_label(db, (*target).rec)
        }
        if is_primitive_name((*ty).name) {
            return fi_type(db, (*ty).elem)
        }
        return (*ty).name
    }
    if k == cb_types.K_INT { return int_name((*ty).size, (*ty).sgn) }
    if k == cb_types.K_BOOL { return "u8" }
    if k == cb_types.K_VOID { return "u8" }
    if k == cb_types.K_FLT {
        if (*ty).size == 4 { return "f32" }
        if (*ty).size == 8 { return "f64" }
        return "[u8; 16]"
    }
    if k == cb_types.K_PTR { return ptr_type(db, (*ty).elem) }
    if k == cb_types.K_ARR {
        var n: i64 = (*ty).count
        if n < 0 {
            n = 0
        }
        return "[" + fi_type(db, (*ty).elem) + "; " + cb_util.istr(n) + "]"
    }
    if k == cb_types.K_REC {
        let r: *mut cb_types.Rec = rec_ptr(db, (*ty).rec)
        if (*r).is_enum {
            if (*r).neg {
                return "i32"
            }
            return "u32"
        }
        return rec_label(db, (*ty).rec)
    }
    return "u64"
}

fn has_offset(db: *mut cb_types.Db, f: *mut cb_types.Field) -> bool {
    if (*f).bits >= 0 || (*f).name.n == 0 {
        return false
    }
    let t: *mut cb_types.Ty = cb_types.ty_ref(db, cb_types.strip(db, (*f).ty))
    return !((*t).kind == cb_types.K_ARR && (*t).count < 0)
}
