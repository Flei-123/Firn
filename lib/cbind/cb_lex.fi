import std.vec
import cbind.cb_util

export { Tok, lex, T_EOF, T_ID, T_NUM, T_STR, T_CHR, T_PUNCT, tok_new, tok_is }

const T_EOF: u32 = 0
const T_ID: u32 = 1
const T_NUM: u32 = 2
const T_STR: u32 = 3
const T_CHR: u32 = 4
const T_PUNCT: u32 = 5

struct Tok {
    kind: u32,
    text: str,
    line: u32,
    file: u32,
    bol: bool,
    spc: bool,
}

fn tok_new(kind: u32, text: str, line: u32, file: u32) -> Tok {
    return Tok { kind: kind, text: text, line: line, file: file, bol: false, spc: false }
}

fn tok_is(t: *mut Tok, text: str) -> bool {
    return ((*t).kind == T_PUNCT || (*t).kind == T_ID) && (*t).text == text
}

fn punct_len(src: str, i: usize) -> usize {
    let c: u32 = cb_util.at(src, i)
    let n: usize = src.n
    var c1: u32 = 0
    var c2: u32 = 0
    if i + 1 < n { c1 = cb_util.at(src, i + 1) }
    if i + 2 < n { c2 = cb_util.at(src, i + 2) }
    if c == 46 && c1 == 46 && c2 == 46 { return 3 }
    if (c == 60 && c1 == 60 && c2 == 61) || (c == 62 && c1 == 62 && c2 == 61) { return 3 }
    if c1 == 61 && (c == 61 || c == 33 || c == 60 || c == 62 || c == 43 || c == 45 || c == 42 || c == 47 || c == 37 || c == 38 || c == 124 || c == 94) { return 2 }
    if (c == 45 && c1 == 62) || (c == 43 && c1 == 43) || (c == 45 && c1 == 45) { return 2 }
    if (c == 60 && c1 == 60) || (c == 62 && c1 == 62) || (c == 38 && c1 == 38) || (c == 124 && c1 == 124) { return 2 }
    if c == 35 && c1 == 35 { return 2 }
    return 1
}

fn quoted_end(src: str, i: usize, quote: u32) -> usize {
    var j: usize = i + 1
    while j < src.n {
        let c: u32 = cb_util.at(src, j)
        if c == 92 {
            j = j + 2
            continue
        }
        if c == quote || c == 10 {
            return j + 1
        }
        j = j + 1
    }
    return src.n
}

fn number_end(src: str, i: usize) -> usize {
    var j: usize = i
    let hex: bool = src.n > i + 1 && cb_util.at(src, i) == 48 && (cb_util.at(src, i + 1) == 120 || cb_util.at(src, i + 1) == 88)
    while j < src.n {
        let c: u32 = cb_util.at(src, j)
        if cb_util.is_alnum(c) || c == 46 {
            j = j + 1
            continue
        }
        let prev: u32 = cb_util.at(src, j - 1)
        let exp: bool = (!hex && (prev == 101 || prev == 69)) || prev == 112 || prev == 80
        if (c == 43 || c == 45) && exp {
            j = j + 1
            continue
        }
        break
    }
    return j
}

fn lex(src: str, file: u32, out: *mut Vec[Tok]) {
    var i: usize = 0
    var line: u32 = 1
    var bol: bool = true
    var spc: bool = false
    let n: usize = src.n
    while i < n {
        let c: u32 = cb_util.at(src, i)
        if c == 10 {
            line = line + 1
            bol = true
            spc = true
            i = i + 1
            continue
        }
        if cb_util.is_space(c) {
            spc = true
            i = i + 1
            continue
        }
        if c == 92 && i + 1 < n && cb_util.at(src, i + 1) == 10 {
            line = line + 1
            spc = true
            i = i + 2
            continue
        }
        if c == 92 && i + 2 < n && cb_util.at(src, i + 1) == 13 && cb_util.at(src, i + 2) == 10 {
            line = line + 1
            spc = true
            i = i + 3
            continue
        }
        if c == 47 && i + 1 < n && cb_util.at(src, i + 1) == 47 {
            while i < n && cb_util.at(src, i) != 10 { i = i + 1 }
            continue
        }
        if c == 47 && i + 1 < n && cb_util.at(src, i + 1) == 42 {
            i = i + 2
            while i + 1 < n && !(cb_util.at(src, i) == 42 && cb_util.at(src, i + 1) == 47) {
                if cb_util.at(src, i) == 10 { line = line + 1 }
                i = i + 1
            }
            i = i + 2
            spc = true
            continue
        }
        var kind: u32 = T_PUNCT
        var end: usize = i + 1
        if cb_util.is_alpha(c) {
            kind = T_ID
            while end < n && cb_util.is_alnum(cb_util.at(src, end)) { end = end + 1 }
        } else if cb_util.is_digit(c) || (c == 46 && i + 1 < n && cb_util.is_digit(cb_util.at(src, i + 1))) {
            kind = T_NUM
            end = number_end(src, i)
        } else if c == 34 {
            kind = T_STR
            end = quoted_end(src, i, 34)
        } else if c == 39 {
            kind = T_CHR
            end = quoted_end(src, i, 39)
        } else {
            end = i + punct_len(src, i)
        }
        var t: Tok = tok_new(kind, cb_util.sub(src, i, end), line, file)
        t.bol = bol
        t.spc = spc
        vec_push[Tok](out, t)
        bol = false
        spc = false
        i = end
    }
    var e: Tok = tok_new(T_EOF, "", line, file)
    e.bol = true
    vec_push[Tok](out, e)
}
