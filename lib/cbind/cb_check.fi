import std.rt
import std.vec
import cbind.cb_util
import cbind.cb_types
import cbind.cb_layout
import cbind.cb_names

export { emit_check_c, emit_check_fi }

fn visible(db: *mut cb_types.Db, foreign: *mut Vec[bool], r: *mut cb_types.Rec) -> bool {
    return !*vec_elem_ptr[bool](foreign, (*r).file as usize) && (*r).complete && !(*r).is_enum && (*r).cname.n > 0
}

fn emit_check_c(db: *mut cb_types.Db, foreign: *mut Vec[bool], header: str) -> str {
    var b: rt.Buf = rt.buf_new()
    cb_util.put(&b, "#include <stdio.h>\n#include <stddef.h>\n#include \"" + header + "\"\nint main(void) {\n")
    for i in 0..vec_len[cb_types.Rec](&(*db).recs) {
        let r: *mut cb_types.Rec = cb_names.rec_ptr(db, i as i32)
        if !visible(db, foreign, r) {
            continue
        }
        cb_util.put(&b, "    printf(\"S " + (*r).name + " %zu\\n\", sizeof(" + (*r).cname + "));\n")
        if (*r).is_union {
            continue
        }
        for k in 0..(*r).fcount {
            let f: *mut cb_types.Field = vec_elem_ptr[cb_types.Field](&(*db).fields, ((*r).fstart + k) as usize)
            if cb_names.has_offset(db, f) {
                cb_util.put(&b, "    printf(\"O " + (*r).name + "." + (*f).name + " %zu\\n\", offsetof(" + (*r).cname + ", " + (*f).name + "));\n")
            }
        }
    }
    cb_util.put(&b, "    return 0;\n}\n")
    let s: str = cb_util.gstr(&b)
    rt.buf_free(&b)
    return s
}

fn emit_check_fi(db: *mut cb_types.Db, foreign: *mut Vec[bool]) -> str {
    var b: rt.Buf = rt.buf_new()
    var calls: rt.Buf = rt.buf_new()
    for i in 0..vec_len[cb_types.Rec](&(*db).recs) {
        let r: *mut cb_types.Rec = cb_names.rec_ptr(db, i as i32)
        if !visible(db, foreign, r) {
            continue
        }
        let label: str = (*r).name
        let fname: str = "check_" + cb_util.istr(i as i64)
        cb_util.put(&calls, "    " + fname + "()\n")
        cb_util.put(&b, "fn " + fname + "() {\n")
        cb_util.put(&b, "    var raw: [u8; " + cb_util.istr(cb_layout.size_of(db, (*r).ty) as i64 + 8) + "] = [0; " + cb_util.istr(cb_layout.size_of(db, (*r).ty) as i64 + 8) + "]\n")
        cb_util.put(&b, "    let p: *mut " + label + " = ((&raw[0]) as u64) as *mut " + label + "\n")
        cb_util.put(&b, "    let sz: usize = size_of[" + label + "]()\n")
        cb_util.put(&b, "    io.fmt_print_line(f\"S " + label + " {sz}\")\n")
        if !(*r).is_union {
            for k in 0..(*r).fcount {
                let f: *mut cb_types.Field = vec_elem_ptr[cb_types.Field](&(*db).fields, ((*r).fstart + k) as usize)
                if cb_names.has_offset(db, f) {
                    let fn_name: str = cb_names.fi_name((*f).name)
                    let var_name: str = "o" + cb_util.istr(k as i64)
                    cb_util.put(&b, "    let " + var_name + ": u64 = ((&(*p)." + fn_name + ") as u64) - (p as u64)\n")
                    cb_util.put(&b, "    io.fmt_print_line(f\"O " + label + "." + (*f).name + " {" + var_name + "}\")\n")
                }
            }
        }
        cb_util.put(&b, "}\n\n")
    }
    cb_util.put(&b, "fn main() -> i32 {\n")
    cb_util.put(&b, cb_util.gstr(&calls))
    cb_util.put(&b, "    return 0\n}\n")
    let s: str = cb_util.gstr(&b)
    rt.buf_free(&b)
    rt.buf_free(&calls)
    return s
}
