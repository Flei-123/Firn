import std.vec
import std.dict
import cbind.cb_util
import cbind.cb_lex

export { eval_range, parse_int_text }

struct Ev {
    toks: *mut Vec[cb_lex.Tok],
    pos: usize,
    end: usize,
    ok: bool,
    zero: bool,
    consts: *mut Dict[i64],
}

fn parse_int_text(s: str, ok: *mut bool) -> i64 {
    var i: usize = 0
    var base: u64 = 10
    if s.n > 1 && cb_util.at(s, 0) == 48 {
        let c1: u32 = cb_util.at(s, 1)
        if c1 == 120 || c1 == 88 {
            base = 16
            i = 2
        } else if c1 == 98 || c1 == 66 {
            base = 2
            i = 2
        } else {
            base = 8
            i = 1
        }
    }
    var v: u64 = 0
    var digits: usize = 0
    while i < s.n {
        let c: u32 = cb_util.at(s, i)
        var d: u64 = 99
        if c >= 48 && c <= 57 {
            d = (c - 48) as u64
        } else if c >= 97 && c <= 102 {
            d = (c - 87) as u64
        } else if c >= 65 && c <= 70 {
            d = (c - 55) as u64
        }
        if d >= base {
            break
        }
        v = v * base + d
        digits = digits + 1
        i = i + 1
    }
    while i < s.n {
        let c: u32 = cb_util.at(s, i)
        if c != 117 && c != 85 && c != 108 && c != 76 {
            *ok = false
        }
        i = i + 1
    }
    if digits == 0 && base == 8 {
        return 0
    }
    if digits == 0 {
        *ok = false
    }
    return v as i64
}

fn char_value(s: str) -> i64 {
    if s.n < 3 {
        return 0
    }
    let c: u32 = cb_util.at(s, 1)
    if c != 92 {
        return c as i64
    }
    let e: u32 = cb_util.at(s, 2)
    if e == 110 { return 10 }
    if e == 116 { return 9 }
    if e == 114 { return 13 }
    if e == 48 { return 0 }
    if e == 97 { return 7 }
    return e as i64
}

fn cur(e: *mut Ev) -> *mut cb_lex.Tok {
    return vec_elem_ptr[cb_lex.Tok](&(*(*e).toks), (*e).pos)
}

fn at_end(e: *mut Ev) -> bool {
    return (*e).pos >= (*e).end
}

fn is_op(e: *mut Ev, s: str) -> bool {
    if at_end(e) {
        return false
    }
    let t: *mut cb_lex.Tok = cur(e)
    return (*t).kind == cb_lex.T_PUNCT && (*t).text == s
}

fn prec(s: str) -> i32 {
    if s == "||" { return 1 }
    if s == "&&" { return 2 }
    if s == "|" { return 3 }
    if s == "^" { return 4 }
    if s == "&" { return 5 }
    if s == "==" || s == "!=" { return 6 }
    if s == "<" || s == ">" || s == "<=" || s == ">=" { return 7 }
    if s == "<<" || s == ">>" { return 8 }
    if s == "+" || s == "-" { return 9 }
    if s == "*" || s == "/" || s == "%" { return 10 }
    return 0
}

fn apply(e: *mut Ev, op: str, a: i64, b: i64) -> i64 {
    if op == "||" { if a != 0 || b != 0 { return 1 } return 0 }
    if op == "&&" { if a != 0 && b != 0 { return 1 } return 0 }
    if op == "|" { return a | b }
    if op == "^" { return a ^ b }
    if op == "&" { return a & b }
    if op == "==" { if a == b { return 1 } return 0 }
    if op == "!=" { if a != b { return 1 } return 0 }
    if op == "<" { if a < b { return 1 } return 0 }
    if op == ">" { if a > b { return 1 } return 0 }
    if op == "<=" { if a <= b { return 1 } return 0 }
    if op == ">=" { if a >= b { return 1 } return 0 }
    if op == "<<" { return a << (b as u64) }
    if op == ">>" { return a >> (b as u64) }
    if op == "+" { return a + b }
    if op == "-" { return a - b }
    if op == "*" { return a * b }
    if b == 0 {
        (*e).ok = false
        return 0
    }
    if op == "/" { return a / b }
    return a % b
}

fn skip_parens(e: *mut Ev) {
    var depth: i32 = 0
    while !at_end(e) {
        let t: *mut cb_lex.Tok = cur(e)
        if (*t).kind == cb_lex.T_PUNCT && (*t).text == "(" { depth = depth + 1 }
        if (*t).kind == cb_lex.T_PUNCT && (*t).text == ")" { depth = depth - 1 }
        (*e).pos = (*e).pos + 1
        if depth == 0 { return }
    }
}

fn is_type_kw(s: str) -> bool {
    return s == "int" || s == "unsigned" || s == "long" || s == "short" || s == "char" || s == "signed"
}

fn primary(e: *mut Ev) -> i64 {
    if at_end(e) {
        (*e).ok = false
        return 0
    }
    let t: *mut cb_lex.Tok = cur(e)
    if (*t).kind == cb_lex.T_NUM {
        (*e).pos = (*e).pos + 1
        return parse_int_text((*t).text, &(*e).ok)
    }
    if (*t).kind == cb_lex.T_CHR {
        (*e).pos = (*e).pos + 1
        return char_value((*t).text)
    }
    if (*t).kind == cb_lex.T_ID {
        (*e).pos = (*e).pos + 1
        var v: i64 = 0
        if dict_get_if[i64]((*e).consts, (*t).text, &v) {
            return v
        }
        if (*e).zero {
            if is_op(e, "(") { skip_parens(e) }
            return 0
        }
        (*e).ok = false
        return 0
    }
    if is_op(e, "(") {
        let nx: *mut cb_lex.Tok = vec_elem_ptr[cb_lex.Tok](&(*(*e).toks), (*e).pos + 1)
        if (*e).pos + 1 < (*e).end && (*nx).kind == cb_lex.T_ID && is_type_kw((*nx).text) {
            skip_parens(e)
            return unary(e)
        }
        (*e).pos = (*e).pos + 1
        let v: i64 = cond(e)
        if is_op(e, ")") {
            (*e).pos = (*e).pos + 1
        } else {
            (*e).ok = false
        }
        return v
    }
    (*e).ok = false
    (*e).pos = (*e).pos + 1
    return 0
}

fn unary(e: *mut Ev) -> i64 {
    if is_op(e, "-") {
        (*e).pos = (*e).pos + 1
        return 0 - unary(e)
    }
    if is_op(e, "+") {
        (*e).pos = (*e).pos + 1
        return unary(e)
    }
    if is_op(e, "~") {
        (*e).pos = (*e).pos + 1
        return unary(e) ^ (0 - 1)
    }
    if is_op(e, "!") {
        (*e).pos = (*e).pos + 1
        if unary(e) == 0 { return 1 }
        return 0
    }
    return primary(e)
}

fn binary(e: *mut Ev, min: i32) -> i64 {
    var lhs: i64 = unary(e)
    while !at_end(e) {
        let t: *mut cb_lex.Tok = cur(e)
        if (*t).kind != cb_lex.T_PUNCT {
            break
        }
        let p: i32 = prec((*t).text)
        if p == 0 || p < min {
            break
        }
        (*e).pos = (*e).pos + 1
        let rhs: i64 = binary(e, p + 1)
        lhs = apply(e, (*t).text, lhs, rhs)
    }
    return lhs
}

fn cond(e: *mut Ev) -> i64 {
    let c: i64 = binary(e, 1)
    if is_op(e, "?") {
        (*e).pos = (*e).pos + 1
        let a: i64 = cond(e)
        if is_op(e, ":") {
            (*e).pos = (*e).pos + 1
        } else {
            (*e).ok = false
        }
        let b: i64 = cond(e)
        if c != 0 { return a }
        return b
    }
    return c
}

fn eval_range(toks: *mut Vec[cb_lex.Tok], from: usize, to: usize, consts: *mut Dict[i64], zero: bool, ok: *mut bool) -> i64 {
    var e: Ev = Ev { toks: toks, pos: from, end: to, ok: true, zero: zero, consts: consts }
    let v: i64 = cond(&e)
    if e.pos != e.end {
        e.ok = false
    }
    *ok = e.ok
    return v
}
