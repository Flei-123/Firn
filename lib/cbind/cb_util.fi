import std.rt

export { gstr, put, put_i, istr, at, sub, is_alpha, is_digit, is_alnum, is_space, str_buf, dirname }

fn gstr(b: *mut rt.Buf) -> str {
    return __str_copy(str { p: rt.buf_data(b), n: rt.buf_len(b) })
}

fn put(b: *mut rt.Buf, s: str) {
    if s.n > 0 {
        rt.buf_push_bytes(b, s.p as u64, s.n)
    }
}

fn put_i(b: *mut rt.Buf, v: i64) {
    rt.buf_push_dec_i64(b, v)
}

fn istr(v: i64) -> str {
    var b: rt.Buf = rt.buf_new()
    put_i(&b, v)
    let s: str = gstr(&b)
    rt.buf_free(&b)
    return s
}

fn at(s: str, i: usize) -> u32 {
    return (*(s.p + i)) as u32
}

fn sub(s: str, from: usize, to: usize) -> str {
    return str { p: s.p + from, n: to - from }
}

fn is_alpha(c: u32) -> bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 36
}

fn is_digit(c: u32) -> bool {
    return c >= 48 && c <= 57
}

fn is_alnum(c: u32) -> bool {
    return is_alpha(c) || is_digit(c)
}

fn is_space(c: u32) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13 || c == 11 || c == 12
}

fn str_buf(s: str, b: *mut rt.Buf) {
    put(b, s)
    rt.buf_push(b, 0 as u8)
}

fn dirname(path: str) -> str {
    var i: usize = path.n
    while i > 0 {
        if at(path, i - 1) == 47 {
            return sub(path, 0, i - 1)
        }
        i = i - 1
    }
    return "."
}
