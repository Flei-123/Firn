import std.vec
import cbind.cb_util
import cbind.cb_lex
import cbind.cb_types
import cbind.cb_expr

export { Ps, Attrs, ps_new, cur, la, is_p, is_id, accept, skip_group, skip_attrs, expr_end, eval_here, starts_type, is_type_kw, at_eof, skip_to_semi }

struct Ps {
    toks: *mut Vec[cb_lex.Tok],
    db: *mut cb_types.Db,
    pos: usize,
}

struct Attrs {
    packed: bool,
    align: u64,
}

fn ps_new(toks: *mut Vec[cb_lex.Tok], db: *mut cb_types.Db) -> Ps {
    return Ps { toks: toks, db: db, pos: 0 }
}

fn la(ps: *mut Ps, k: usize) -> *mut cb_lex.Tok {
    var i: usize = (*ps).pos + k
    let last: usize = vec_len[cb_lex.Tok]((*ps).toks) - 1
    if i > last {
        i = last
    }
    return vec_elem_ptr[cb_lex.Tok]((*ps).toks, i)
}

fn cur(ps: *mut Ps) -> *mut cb_lex.Tok {
    return la(ps, 0)
}

fn at_eof(ps: *mut Ps) -> bool {
    return (*cur(ps)).kind == cb_lex.T_EOF
}

fn is_p(ps: *mut Ps, s: str) -> bool {
    let t: *mut cb_lex.Tok = cur(ps)
    return (*t).kind == cb_lex.T_PUNCT && (*t).text == s
}

fn is_id(ps: *mut Ps, s: str) -> bool {
    let t: *mut cb_lex.Tok = cur(ps)
    return (*t).kind == cb_lex.T_ID && (*t).text == s
}

fn accept(ps: *mut Ps, s: str) -> bool {
    if is_p(ps, s) {
        (*ps).pos = (*ps).pos + 1
        return true
    }
    return false
}

fn skip_group(ps: *mut Ps) {
    var depth: i32 = 0
    while !at_eof(ps) {
        let t: *mut cb_lex.Tok = cur(ps)
        if (*t).kind == cb_lex.T_PUNCT {
            if (*t).text == "(" || (*t).text == "[" || (*t).text == "{" {
                depth = depth + 1
            } else if (*t).text == ")" || (*t).text == "]" || (*t).text == "}" {
                depth = depth - 1
            }
        }
        (*ps).pos = (*ps).pos + 1
        if depth <= 0 {
            return
        }
    }
}

fn skip_to_semi(ps: *mut Ps) {
    while !at_eof(ps) {
        if is_p(ps, ";") {
            (*ps).pos = (*ps).pos + 1
            return
        }
        if is_p(ps, "{") || is_p(ps, "(") || is_p(ps, "[") {
            skip_group(ps)
            continue
        }
        (*ps).pos = (*ps).pos + 1
    }
}

fn scan_attr_group(ps: *mut Ps, a: *mut Attrs) {
    let start: usize = (*ps).pos
    skip_group(ps)
    let end: usize = (*ps).pos
    var k: usize = start
    while k < end {
        let t: *mut cb_lex.Tok = vec_elem_ptr[cb_lex.Tok]((*ps).toks, k)
        if (*t).kind == cb_lex.T_ID && ((*t).text == "packed" || (*t).text == "__packed__") {
            (*a).packed = true
        }
        if (*t).kind == cb_lex.T_ID && ((*t).text == "aligned" || (*t).text == "__aligned__") {
            var al: u64 = 16
            if k + 2 < end && (*vec_elem_ptr[cb_lex.Tok]((*ps).toks, k + 1)).text == "(" {
                var ok: bool = true
                al = cb_expr.parse_int_text((*vec_elem_ptr[cb_lex.Tok]((*ps).toks, k + 2)).text, &ok) as u64
            }
            if al > (*a).align {
                (*a).align = al
            }
        }
        k = k + 1
    }
}

fn skip_attrs(ps: *mut Ps, a: *mut Attrs) {
    while !at_eof(ps) {
        let t: *mut cb_lex.Tok = cur(ps)
        if (*t).kind != cb_lex.T_ID {
            return
        }
        let s: str = (*t).text
        if s == "__attribute__" || s == "__attribute" || s == "__declspec" {
            (*ps).pos = (*ps).pos + 1
            if is_p(ps, "(") {
                scan_attr_group(ps, a)
            }
        } else if s == "_Alignas" || s == "alignas" || s == "__asm__" || s == "__asm" || s == "asm" {
            (*ps).pos = (*ps).pos + 1
            if is_p(ps, "(") {
                scan_attr_group(ps, a)
            }
        } else if s == "__extension__" || s == "_Noreturn" {
            (*ps).pos = (*ps).pos + 1
        } else {
            return
        }
    }
}

fn expr_end(ps: *mut Ps) -> usize {
    var depth: i32 = 0
    var k: usize = (*ps).pos
    let n: usize = vec_len[cb_lex.Tok]((*ps).toks)
    while k < n {
        let t: *mut cb_lex.Tok = vec_elem_ptr[cb_lex.Tok]((*ps).toks, k)
        if (*t).kind == cb_lex.T_EOF {
            return k
        }
        if (*t).kind == cb_lex.T_PUNCT {
            let s: str = (*t).text
            if s == "(" || s == "[" || s == "{" {
                depth = depth + 1
            } else if s == ")" || s == "]" || s == "}" {
                if depth == 0 {
                    return k
                }
                depth = depth - 1
            } else if depth == 0 && (s == "," || s == ";" || s == ":" || s == "=") {
                return k
            }
        }
        k = k + 1
    }
    return k
}

fn eval_here(ps: *mut Ps, ok: *mut bool) -> i64 {
    let end: usize = expr_end(ps)
    let v: i64 = cb_expr.eval_range((*ps).toks, (*ps).pos, end, &(*(*ps).db).consts, false, ok)
    (*ps).pos = end
    return v
}

fn is_type_kw(s: str) -> bool {
    return s == "void" || s == "char" || s == "short" || s == "int" || s == "long" || s == "float" || s == "double"
    || s == "signed" || s == "unsigned" || s == "_Bool" || s == "struct" || s == "union" || s == "enum"
    || s == "const" || s == "volatile" || s == "restrict" || s == "__restrict" || s == "__restrict__"
    || s == "__int128" || s == "__int128_t" || s == "__uint128_t" || s == "_Complex" || s == "_Atomic"
    || s == "__builtin_va_list" || s == "__gnuc_va_list" || s == "__const" || s == "__volatile__"
}

fn starts_type(ps: *mut Ps, k: usize) -> bool {
    let t: *mut cb_lex.Tok = la(ps, k)
    if (*t).kind != cb_lex.T_ID {
        return false
    }
    if is_type_kw((*t).text) {
        return true
    }
    return cb_types.typedef_find((*ps).db, (*t).text) >= 0
}
