import std.rt
import std.vec
import std.dict
import cbind.cb_util
import cbind.cb_types
import cbind.cb_names

export { emit_glue }

fn base_name(t: i32) -> str {
    if t == cb_types.B_VOID { return "void" }
    if t == cb_types.B_CHAR { return "char" }
    if t == cb_types.B_SCHAR { return "signed char" }
    if t == cb_types.B_UCHAR { return "unsigned char" }
    if t == cb_types.B_SHORT { return "short" }
    if t == cb_types.B_USHORT { return "unsigned short" }
    if t == cb_types.B_INT { return "int" }
    if t == cb_types.B_UINT { return "unsigned int" }
    if t == cb_types.B_LONG { return "long" }
    if t == cb_types.B_ULONG { return "unsigned long" }
    if t == cb_types.B_LLONG { return "long long" }
    if t == cb_types.B_ULLONG { return "unsigned long long" }
    if t == cb_types.B_FLOAT { return "float" }
    if t == cb_types.B_DOUBLE { return "double" }
    if t == cb_types.B_LDOUBLE { return "long double" }
    if t == cb_types.B_BOOL { return "_Bool" }
    return ""
}

fn c_type(db: *mut cb_types.Db, t: i32) -> str {
    let ty: *mut cb_types.Ty = cb_types.ty_ref(db, t)
    if (*ty).kind == cb_types.K_NAME {
        return (*ty).name
    }
    if (*ty).kind == cb_types.K_PTR {
        let e: *mut cb_types.Ty = cb_types.ty_ref(db, cb_types.strip(db, (*ty).elem))
        if (*e).kind == cb_types.K_FUNC || (*e).kind == cb_types.K_ARR {
            return ""
        }
        let inner: str = c_type(db, (*ty).elem)
        if inner.n == 0 {
            return ""
        }
        return inner + " *"
    }
    if (*ty).kind == cb_types.K_REC {
        return (*cb_names.rec_ptr(db, (*ty).rec)).cname
    }
    if (*ty).kind == cb_types.K_ARR || (*ty).kind == cb_types.K_FUNC {
        return ""
    }
    return base_name(t)
}

fn wrapper(db: *mut cb_types.Db, fd: *mut cb_types.FnDecl, prefix: str, warn: *mut Vec[str]) -> str {
    let ft: *mut cb_types.Ty = cb_types.ty_ref(db, cb_types.strip(db, (*fd).ty))
    let ret: str = c_type(db, (*ft).elem)
    if ret.n == 0 {
        cb_types.db_warn(db, "no C type for return of " + (*fd).name)
        return ""
    }
    var params: str = ""
    var args: str = ""
    for i in 0..(*ft).pcount {
        let p: *mut cb_types.Param = vec_elem_ptr[cb_types.Param](&(*db).params, ((*ft).pstart + i) as usize)
        let ct: str = c_type(db, (*p).ty)
        if ct.n == 0 {
            cb_types.db_warn(db, "no C type for parameter of " + (*fd).name)
            return ""
        }
        if i > 0 {
            params = params + ", "
            args = args + ", "
        }
        params = params + ct + " a" + cb_util.istr(i as i64)
        args = args + "a" + cb_util.istr(i as i64)
    }
    var body: str = "return " + (*fd).name + "(" + args + ");"
    if ret == "void" {
        body = (*fd).name + "(" + args + ");"
    }
    return ret + " " + prefix + (*fd).name + "(" + params + ") { " + body + " }\n"
}

fn emit_glue(db: *mut cb_types.Db, foreign: *mut Vec[bool], wraps: *mut Dict[bool], prefix: str, header: str) -> str {
    var b: rt.Buf = rt.buf_new()
    cb_util.put(&b, "#include \"" + header + "\"\n")
    for i in 0..vec_len[cb_types.FnDecl](&(*db).fns) {
        let fd: *mut cb_types.FnDecl = vec_elem_ptr[cb_types.FnDecl](&(*db).fns, i)
        if *vec_elem_ptr[bool](foreign, (*fd).file as usize) || !dict_has[bool](wraps, (*fd).name) {
            continue
        }
        var warn: Vec[str] = vec_new[str]()
        cb_util.put(&b, wrapper(db, fd, prefix, &warn))
    }
    let s: str = cb_util.gstr(&b)
    rt.buf_free(&b)
    return s
}
