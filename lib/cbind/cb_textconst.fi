import std.vec
import cbind.cb_util
import cbind.cb_lex

export { const_line }

fn simple_escapes(s: str) -> bool {
    var i: usize = 1
    while i + 1 < s.n {
        if cb_util.at(s, i) == 92 {
            let c: u32 = cb_util.at(s, i + 1)
            if !(c == 110 || c == 116 || c == 114 || c == 92 || c == 34 || c == 48) {
                return false
            }
            i = i + 1
        }
        i = i + 1
    }
    return true
}

fn string_literal(toks: *mut Vec[cb_lex.Tok]) -> str {
    var out: str = "\""
    for i in 0..vec_len[cb_lex.Tok](toks) {
        let t: *mut cb_lex.Tok = vec_elem_ptr[cb_lex.Tok](toks, i)
        if (*t).kind != cb_lex.T_STR || !simple_escapes((*t).text) {
            return ""
        }
        out = out + cb_util.sub((*t).text, 1, (*t).text.n - 1)
    }
    return out + "\""
}

fn float_literal(text: str) -> str {
    var n: usize = text.n
    let last: u32 = cb_util.at(text, n - 1)
    if last == 102 || last == 70 || last == 108 || last == 76 {
        n = n - 1
    }
    var dot: bool = false
    var exp: bool = false
    for i in 0..n {
        let c: u32 = cb_util.at(text, i)
        if c == 46 { dot = true }
        else if c == 101 || c == 69 { exp = true }
        else if !(cb_util.is_digit(c) || c == 43 || c == 45) { return "" }
    }
    if !dot && !exp {
        return ""
    }
    var s: str = cb_util.sub(text, 0, n)
    if cb_util.at(s, 0) == 46 {
        s = "0" + s
    }
    if cb_util.at(s, s.n - 1) == 46 {
        s = s + "0"
    }
    return s
}

fn const_line(name: str, toks: *mut Vec[cb_lex.Tok]) -> str {
    let n: usize = vec_len[cb_lex.Tok](toks)
    if n == 0 {
        return ""
    }
    let first: *mut cb_lex.Tok = vec_elem_ptr[cb_lex.Tok](toks, 0)
    if (*first).kind == cb_lex.T_STR {
        let lit: str = string_literal(toks)
        if lit.n == 0 {
            return ""
        }
        return "const " + name + ": str = " + lit
    }
    var sign: str = ""
    var k: usize = 0
    if (*first).kind == cb_lex.T_PUNCT && (*first).text == "-" && n == 2 {
        sign = "0.0 - "
        k = 1
    }
    let num: *mut cb_lex.Tok = vec_elem_ptr[cb_lex.Tok](toks, k)
    if n - k != 1 || (*num).kind != cb_lex.T_NUM {
        return ""
    }
    let lit: str = float_literal((*num).text)
    if lit.n == 0 {
        return ""
    }
    return "const " + name + ": f64 = " + sign + lit
}
