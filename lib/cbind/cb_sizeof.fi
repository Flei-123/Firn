import std.vec
import std.dict
import cbind.cb_types
import cbind.cb_layout
import cbind.cb_names

export { register }

fn register(db: *mut cb_types.Db) {
    for i in 0..vec_len[cb_types.Typedef](&(*db).tds) {
        let td: *mut cb_types.Typedef = cb_names.td_ptr(db, i as i32)
        dict_set[i64](&(*db).consts, "sizeof:" + (*td).name, cb_layout.size_of(db, (*td).ty) as i64)
    }
    for i in 0..vec_len[cb_types.Rec](&(*db).recs) {
        let r: *mut cb_types.Rec = cb_names.rec_ptr(db, i as i32)
        if (*r).cname.n == 0 || !(*r).complete {
            continue
        }
        var size: u64 = 4
        if !(*r).is_enum {
            cb_layout.layout_rec(db, i as i32)
            size = (*r).size
        }
        dict_set[i64](&(*db).consts, "sizeof:" + (*r).cname, size as i64)
    }
}
