// lib/browser/tree.fi — HTML-BAUMKONSTRUKTION nach WHATWG §13.2.6, in Firn.
//
// Eingabe ist der Tokenstrom aus lib/html/tokenizer.fi (ueber das binaere
// Protokoll, lib/browser/token_stream.fi), Ausgabe ist ein DOM-Baum aus
// lib/browser/node.fi.
//
// UMGESETZT (vollstaendig, nicht angedeutet):
//   * die Einfuegemodi "initial", "before html", "before head", "in head",
//     "in head noscript", "after head", "in body", "text", "in table",
//     "in table text", "in caption", "in column group", "in table body",
//     "in row", "in cell", "in select", "in select in table", "after body",
//     "in frameset", "after frameset", "after after body",
//     "after after frameset" — 22 der 23 Modi.
//   * Stapel offener Elemente mit allen vier Geltungsbereichen (scope,
//     list item scope, button scope, table scope)
//   * Liste der aktiven Formatierungselemente samt Marken, Noahs Arche
//     (hoechstens drei gleiche Eintraege) und "reconstruct the active
//     formatting elements"
//   * das Adoption-Agency-Verfahren, beide Schleifen, mit Lesezeichen
//   * implizites Schliessen ("generate implied end tags", auch die
//     gruendliche Fassung)
//   * "foster parenting" mit der vollstaendigen Fundstelle
//     ("appropriate place for inserting a node")
//   * "reset the insertion mode appropriately"
//   * der generische Rohtext-/RCDATA-Weg mit RUECKKOPPLUNG auf den
//     Tokenizer (`<title>`, `<style>`, `<script>`, `<textarea>`,
//     `<plaintext>` …)
//   * Quirks-Modus aus dem DOCTYPE
//
// NICHT UMGESETZT — bewusst, und hier genannt statt versteckt:
//   * "in template" und der `<template>`-Inhalt. Das ist der 23. Modus und
//     braucht einen zweiten Baum je Template plus einen eigenen Stapel von
//     Einfuegemodi. `<template>` wird deshalb wie ein gewoehnliches Element
//     behandelt.
//   * FREMDINHALT (SVG/MathML) als eigener Regelsatz. Namensraeume gibt es
//     (`<svg>` und `<math>` erzeugen Elemente im richtigen Namensraum, und
//     der Namensraum steht am Knoten), aber die Sonderregeln fuer den
//     Inhalt — Namenskorrektur, Attributanpassung, Integrationspunkte,
//     Ausbruchtags — fehlen.
//   * Fragmentzerlegung (`innerHTML`) mit Kontextelement.
//   * Skriptausfuehrung und alles, was daran haengt (`document.write`,
//     "scripting flag" ist AUS).
//
// GRENZEN DER BAUART:
//   * Der Stapel offener Elemente hat 512 Plaetze, die Formatierungsliste
//     128. Beides sind Felder IM Zustand, damit der konservative Stapelscan
//     des Sammlers sie ohne Anmeldung sieht (SPEC §3.5.3). Ein Ueberlauf
//     ist ein SICHTBARER Abbruch, keine stille Kuerzung.

import html.mem
import html.tokens
import browser.node
import browser.names
import browser.tag
import browser.token_stream

export {
    Tree,
    EM_INITIAL, EM_VOR_HTML, EM_VOR_HEAD, EM_IN_HEAD, EM_IN_HEAD_NOSCRIPT,
    EM_NACH_HEAD, EM_IN_BODY, EM_TEXT, EM_IN_TABLE, EM_IN_TABLE_TEXT,
    EM_IN_CAPTION, EM_IN_COLGROUP, EM_IN_TABLE_BODY, EM_IN_ROW, EM_IN_CELL,
    EM_IN_SELECT, EM_IN_SELECT_IN_TABLE, EM_NACH_BODY, EM_IN_FRAMESET,
    EM_NACH_FRAMESET, EM_NACH_NACH_BODY, EM_NACH_NACH_FRAMESET,
    tree_new, tree_buffer_init, tree_init, tree_free,
    tree_token, tree_eof, tree_document, tree_error, tree_broken, tree_release,
    tree_switching, tree_um_pos, tree_um_tag, tree_um_delete,
    tree_mode, tree_open_number,
}

// --------------------------------------------------------------- Einfuegemodi

const EM_INITIAL: u32 = 1
const EM_VOR_HTML: u32 = 2
const EM_VOR_HEAD: u32 = 3
const EM_IN_HEAD: u32 = 4
const EM_IN_HEAD_NOSCRIPT: u32 = 5
const EM_NACH_HEAD: u32 = 6
const EM_IN_BODY: u32 = 7
const EM_TEXT: u32 = 8
const EM_IN_TABLE: u32 = 9
const EM_IN_TABLE_TEXT: u32 = 10
const EM_IN_CAPTION: u32 = 11
const EM_IN_COLGROUP: u32 = 12
const EM_IN_TABLE_BODY: u32 = 13
const EM_IN_ROW: u32 = 14
const EM_IN_CELL: u32 = 15
const EM_IN_SELECT: u32 = 16
const EM_IN_SELECT_IN_TABLE: u32 = 17
const EM_NACH_BODY: u32 = 18
const EM_IN_FRAMESET: u32 = 19
const EM_NACH_FRAMESET: u32 = 20
const EM_NACH_NACH_BODY: u32 = 21
const EM_NACH_NACH_FRAMESET: u32 = 22

// Geltungsbereiche des Stapels (WHATWG §13.2.4.2).
const SC_NORMAL: u32 = 0
const SC_LISTE: u32 = 1
const SC_BUTTON: u32 = 2
const SC_TABELLE: u32 = 3
const SC_SELECT: u32 = 4

const MAX_OFFEN: usize = 512
const MAX_AKTIV: usize = 128

// Startzustaende des Tokenizers (lib/html/tokenizer.fi).
const ZST_DATA: u32 = 0
const ZST_PLAINTEXT: u32 = 1
const ZST_RCDATA: u32 = 2
const ZST_RAWTEXT: u32 = 3
const ZST_SCRIPT: u32 = 4

// ------------------------------------------------------------------ Zustand

// ALLE `Gc[…]`-Felder liegen ABSICHTLICH in diesem Struct und damit im
// Rahmen des Aufrufers: der Stapelscan des Sammlers ist konservativ
// (SPEC §3.5.3) und sieht sie dort ohne jede Anmeldung. Ein `Baum` auf der
// Halde (mem.heap_alloc) waere fuer den Sammler UNSICHTBAR — dann muesste er
// mit `gc_wurzel_anmelden` angemeldet werden.
struct Tree {
    names: *mut names.Names,
    stream: *mut token_stream.Stream,

    doc: Gc[Document],
    header: Gc[Elem],          // head element pointer
    form: Gc[Elem],          // form element pointer

    open: [Gc[Node]; 512],
    n_open: usize,

    // Liste der aktiven Formatierungselemente. Der Nullzeiger ist die MARKE.
    active: [Gc[Node]; 128],
    nactive: usize,

    mode: u32,
    basemode: u32,               // "original insertion mode"
    frameset_ok: bool,
    foster: bool,               // "foster parenting" eingeschaltet?

    // "in table text": gesammelte Zeichen und ob alles nur Leerraum war
    tt: Gc[Chain],
    tt_only_space: bool,

    // Rueckkopplung auf den Tokenizer
    switching: u32,           // 0 = keine, sonst ZST_*
    um_pos: usize,              // Quellposition (relativ zum aktuellen Lauf)
    um_tag: mem.CpBuf,          // lastStartTag fuer den Neustart
    help: mem.CpBuf,            // Arbeitspuffer (Namen aus dem Protokoll)
    nl_skip: bool,     // naechstes U+000A verwerfen (pre/textarea)

    // Buchhaltung
    tname: u32,                 // Atom des aktuellen Tag-Namens
    err: u64,                // Zahl der Parse-Fehler
    broken: u32,                // != 0: Ueberlauf / Speicher aus (sichtbar)
}

#[no_gc]
fn tree_new() -> Tree {
    return Tree{
        names: 0 as *mut names.Names,
        stream: 0 as *mut token_stream.Stream,
        doc: gc_null[Document](),
        header: gc_null[Elem](),
        form: gc_null[Elem](),
        open: [gc_null[Node](); 512],
        n_open: 0,
        active: [gc_null[Node](); 128],
        nactive: 0,
        mode: EM_INITIAL,
        basemode: EM_INITIAL,
        frameset_ok: true,
        foster: false,
        tt: gc_null[Chain](),
        tt_only_space: true,
        switching: 0,
        um_pos: 0,
        um_tag: mem.cp_new(),
        help: mem.cp_new(),
        nl_skip: false,
        tname: 0,
        err: 0,
        broken: 0,
    }
}

// EINMAL vor dem ersten Dokument. Getrennt von `baum_init`, und das ist
// kein Schoenheitsfehler: `mem.cp_init` nullt den Zeiger, OHNE freizugeben.
// Stuende es in `baum_init`, verloere jedes weitere Dokument die Puffer des
// vorigen — im Dauerlauf gemessen 8 KiB je Runde, bei flachem GC-Heap.
#[no_gc]
fn tree_buffer_init(b: *mut Tree) {
    mem.cp_init(&(*b).um_tag)
    mem.cp_init(&(*b).help)
}

// Legt ein frisches Dokument an und setzt den Zustand zurueck.
// `false` = Speicher aus; der Aufrufer MUSS dann sichtbar scheitern.
fn tree_init(b: *mut Tree, nm: *mut names.Names, st: *mut token_stream.Stream) -> bool {
    mem.cp_clear(&(*b).um_tag)
    mem.cp_clear(&(*b).help)
    (*b).nl_skip = false
    (*b).names = nm
    (*b).stream = st
    (*b).doc = node.document_new() catch gc_null[Document]()
    if (*b).doc == gc_null[Document]() {
        return false
    }
    (*b).header = gc_null[Elem]()
    (*b).form = gc_null[Elem]()
    (*b).n_open = 0
    (*b).nactive = 0
    var i: usize = 0
    while i < MAX_OFFEN {
        (*b).open[i] = gc_null[Node]()
        i = i + 1
    }
    i = 0
    while i < MAX_AKTIV {
        (*b).active[i] = gc_null[Node]()
        i = i + 1
    }
    (*b).mode = EM_INITIAL
    (*b).basemode = EM_INITIAL
    (*b).frameset_ok = true
    (*b).foster = false
    (*b).tt = gc_null[Chain]()
    (*b).tt_only_space = true
    (*b).switching = 0
    (*b).um_pos = 0
    (*b).tname = 0
    (*b).err = 0
    (*b).broken = 0
    return true
}

// Laesst den zuletzt gebauten Baum los: alle Gc-Felder des Zustands werden
// genullt. Ohne das haelt der Zustand den fertigen Baum weiter fest — fuer
// den Dauerlauf (lib/browser/soak_tree.fi) ist genau das der Unterschied
// zwischen "wird eingesammelt" und "waechst".
fn tree_release(b: *mut Tree) {
    (*b).doc = gc_null[Document]()
    (*b).header = gc_null[Elem]()
    (*b).form = gc_null[Elem]()
    (*b).tt = gc_null[Chain]()
    var i: usize = 0
    while i < MAX_OFFEN {
        (*b).open[i] = gc_null[Node]()
        i = i + 1
    }
    i = 0
    while i < MAX_AKTIV {
        (*b).active[i] = gc_null[Node]()
        i = i + 1
    }
    (*b).n_open = 0
    (*b).nactive = 0
}

#[no_gc]
fn tree_free(b: *mut Tree) {
    mem.cp_free(&(*b).um_tag)
    mem.cp_free(&(*b).help)
}

fn tree_document(b: *mut Tree) -> Gc[Document] {
    return (*b).doc
}

#[no_gc]
fn tree_error(b: *mut Tree) -> u64 {
    return (*b).err
}

#[no_gc]
fn tree_broken(b: *mut Tree) -> u32 {
    return (*b).broken
}

#[no_gc]
fn tree_mode(b: *mut Tree) -> u32 {
    return (*b).mode
}

#[no_gc]
fn tree_open_number(b: *mut Tree) -> usize {
    return (*b).n_open
}

#[no_gc]
fn tree_switching(b: *mut Tree) -> u32 {
    return (*b).switching
}

#[no_gc]
fn tree_um_pos(b: *mut Tree) -> usize {
    return (*b).um_pos
}

#[no_gc]
fn tree_um_tag(b: *mut Tree) -> *mut mem.CpBuf {
    return &(*b).um_tag
}

#[no_gc]
fn tree_um_delete(b: *mut Tree) {
    (*b).switching = 0
}

#[no_gc]
fn parse_error(b: *mut Tree) {
    (*b).err = (*b).err + 1
}

// ------------------------------------------------------- Stapel und Listen

fn stack_push(b: *mut Tree, k: Gc[Node]) {
    if (*b).n_open >= MAX_OFFEN {
        (*b).broken = 1
        return
    }
    (*b).open[(*b).n_open] = k
    (*b).n_open = (*b).n_open + 1
}

fn stack_pop(b: *mut Tree) -> Gc[Node] {
    if (*b).n_open == 0 {
        return gc_null[Node]()
    }
    (*b).n_open = (*b).n_open - 1
    let k: Gc[Node] = (*b).open[(*b).n_open]
    (*b).open[(*b).n_open] = gc_null[Node]()
    return k
}

fn current(b: *mut Tree) -> Gc[Node] {
    if (*b).n_open == 0 {
        return gc_null[Node]()
    }
    return (*b).open[(*b).n_open - 1]
}

fn stack_at(b: *mut Tree, i: usize) -> Gc[Node] {
    if i >= (*b).n_open {
        return gc_null[Node]()
    }
    return (*b).open[i]
}

fn stack_index(b: *mut Tree, k: Gc[Node]) -> i64 {
    var i: usize = (*b).n_open
    while i > 0 {
        i = i - 1
        if (*b).open[i] == k {
            return i as i64
        }
    }
    return -1
}

fn stack_contains(b: *mut Tree, k: Gc[Node]) -> bool {
    return stack_index(b, k) >= 0
}

// Entfernt EINEN bestimmten Knoten aus dem Stapel (nicht unbedingt oben).
fn stack_remove(b: *mut Tree, k: Gc[Node]) {
    let idx: i64 = stack_index(b, k)
    if idx < 0 {
        return
    }
    var i: usize = idx as usize
    while i + 1 < (*b).n_open {
        (*b).open[i] = (*b).open[i + 1]
        i = i + 1
    }
    (*b).n_open = (*b).n_open - 1
    (*b).open[(*b).n_open] = gc_null[Node]()
}

// Fuegt `neu` unmittelbar UNTER `bezug` ein (also an dessen Stelle, `bezug`
// rutscht eine Stelle hoch). Schritt 19 des Adoption-Agency-Verfahrens.
fn stack_insert_under(b: *mut Tree, ref_node: Gc[Node], new: Gc[Node]) {
    let idx: i64 = stack_index(b, ref_node)
    if idx < 0 {
        stack_push(b, new)
        return
    }
    if (*b).n_open >= MAX_OFFEN {
        (*b).broken = 1
        return
    }
    var i: usize = (*b).n_open
    while i > idx as usize {
        (*b).open[i] = (*b).open[i - 1]
        i = i - 1
    }
    (*b).open[idx as usize] = new
    (*b).n_open = (*b).n_open + 1
}

fn stack_replace(b: *mut Tree, old: Gc[Node], new: Gc[Node]) {
    let idx: i64 = stack_index(b, old)
    if idx >= 0 {
        (*b).open[idx as usize] = new
    }
}

// Poppt so lange, bis `k` gepoppt wurde (einschliesslich).
fn stack_pop_to(b: *mut Tree, k: Gc[Node]) {
    while (*b).n_open > 0 {
        let x: Gc[Node] = stack_pop(b)
        if x == k {
            return
        }
    }
}

// Poppt so lange, bis ein HTML-Element mit diesem Namen gepoppt wurde.
// Der Standard ruft das nur, wenn das Element wirklich im Stapel steht.
// Die Vorpruefung ist trotzdem da: ohne sie raeumt EIN Denkfehler an der
// Aufrufstelle den ganzen Stapel leer, und der Fehler zeigt sich erst viel
// spaeter als leerer Baum.
fn stack_pop_to_name(b: *mut Tree, name: u32) {
    var da: bool = false
    var i: usize = (*b).n_open
    while i > 0 {
        i = i - 1
        if node.elem_is((*b).open[i], name) {
            da = true
            break
        }
    }
    if !da {
        return
    }
    while (*b).n_open > 0 {
        let x: Gc[Node] = stack_pop(b)
        if node.elem_is(x, name) {
            return
        }
    }
}

// ------------------------------------------------------ Geltungsbereiche

// Die Grundliste des Geltungsbereichs (WHATWG §13.2.4.2 "has an element in
// scope"). Alles ausser den drei Fremdinhaltsgruppen ist HTML.
fn scope_base_list(name: u32, ns: u32) -> bool {
    if ns == node.NS_HTML {
        return name == tag.M_APPLET || name == tag.M_CAPTION || name == tag.M_HTML ||
            name == tag.M_TABLE || name == tag.M_TD || name == tag.M_TH ||
            name == tag.M_MARQUEE || name == tag.M_OBJECT || name == tag.M_TEMPLATE
    }
    if ns == node.NS_MATHML {
        return name == tag.M_MI || name == tag.M_MO || name == tag.M_MN ||
            name == tag.M_MS || name == tag.M_MTEXT || name == tag.M_ANNOTATION_XML
    }
    if ns == node.NS_SVG {
        return name == tag.M_FOREIGNOBJECT || name == tag.M_DESC || name == tag.M_TITLE
    }
    return false
}

fn scope_end(name: u32, ns: u32, kind: u32) -> bool {
    if kind == SC_TABELLE {
        if ns != node.NS_HTML {
            return false
        }
        return name == tag.M_HTML || name == tag.M_TABLE || name == tag.M_TEMPLATE
    }
    if kind == SC_SELECT {
        // "has an element in select scope" ist umgekehrt formuliert: alles
        // AUSSER optgroup/option beendet die Suche.
        if ns != node.NS_HTML {
            return true
        }
        return !(name == tag.M_OPTGROUP || name == tag.M_OPTION)
    }
    if scope_base_list(name, ns) {
        return true
    }
    if kind == SC_LISTE && ns == node.NS_HTML {
        return name == tag.M_OL || name == tag.M_UL
    }
    if kind == SC_BUTTON && ns == node.NS_HTML {
        return name == tag.M_BUTTON
    }
    return false
}

// Steht ein HTML-Element mit diesem Namen im angegebenen Geltungsbereich?
fn in_scope(b: *mut Tree, name: u32, kind: u32) -> bool {
    var i: usize = (*b).n_open
    while i > 0 {
        i = i - 1
        let k: Gc[Node] = (*b).open[i]
        let e: Gc[Elem] = node.node_as_elem(k)
        if e == gc_null[Elem]() {
            continue
        }
        if e.ns == node.NS_HTML && e.name == name {
            return true
        }
        if scope_end(e.name, e.ns, kind) {
            return false
        }
    }
    return false
}

// Wie `in_scope`, aber fuer einen bestimmten Knoten statt fuer einen Namen.
fn node_in_scope(b: *mut Tree, target: Gc[Node], kind: u32) -> bool {
    var i: usize = (*b).n_open
    while i > 0 {
        i = i - 1
        let k: Gc[Node] = (*b).open[i]
        if k == target {
            return true
        }
        let e: Gc[Elem] = node.node_as_elem(k)
        if e == gc_null[Elem]() {
            continue
        }
        if scope_end(e.name, e.ns, kind) {
            return false
        }
    }
    return false
}

// Steht EINES der Tabellenzellenelemente im Tabellen-Geltungsbereich?
fn cell_in_table_scope(b: *mut Tree) -> bool {
    return in_scope(b, tag.M_TD, SC_TABELLE) || in_scope(b, tag.M_TH, SC_TABELLE)
}

// ------------------------------------------------------------- Kategorien

// WHATWG §13.2.4.2 "Special". Vollstaendig; die Liste steht so im Standard.
fn is_special(name: u32, ns: u32) -> bool {
    if ns == node.NS_MATHML {
        return name == tag.M_MI || name == tag.M_MO || name == tag.M_MN ||
            name == tag.M_MS || name == tag.M_MTEXT || name == tag.M_ANNOTATION_XML
    }
    if ns == node.NS_SVG {
        return name == tag.M_FOREIGNOBJECT || name == tag.M_DESC || name == tag.M_TITLE
    }
    if ns != node.NS_HTML {
        return false
    }
    if name == tag.M_ADDRESS || name == tag.M_APPLET || name == tag.M_AREA ||
        name == tag.M_ARTICLE || name == tag.M_ASIDE || name == tag.M_BASE ||
        name == tag.M_BASEFONT || name == tag.M_BGSOUND || name == tag.M_BLOCKQUOTE ||
        name == tag.M_BODY || name == tag.M_BR || name == tag.M_BUTTON ||
        name == tag.M_CAPTION || name == tag.M_CENTER || name == tag.M_COL ||
        name == tag.M_COLGROUP || name == tag.M_DD || name == tag.M_DETAILS ||
        name == tag.M_DIR || name == tag.M_DIV || name == tag.M_DL ||
        name == tag.M_DT || name == tag.M_EMBED || name == tag.M_FIELDSET {
        return true
    }
    if name == tag.M_FIGCAPTION || name == tag.M_FIGURE || name == tag.M_FOOTER ||
        name == tag.M_FORM || name == tag.M_FRAME || name == tag.M_FRAMESET ||
        name == tag.M_H1 || name == tag.M_H2 || name == tag.M_H3 ||
        name == tag.M_H4 || name == tag.M_H5 || name == tag.M_H6 ||
        name == tag.M_HEAD || name == tag.M_HEADER || name == tag.M_HGROUP ||
        name == tag.M_HR || name == tag.M_HTML || name == tag.M_IFRAME ||
        name == tag.M_IMG || name == tag.M_INPUT || name == tag.M_KEYGEN ||
        name == tag.M_LI || name == tag.M_LINK || name == tag.M_LISTING {
        return true
    }
    if name == tag.M_MAIN || name == tag.M_MARQUEE || name == tag.M_MENU ||
        name == tag.M_META || name == tag.M_NAV || name == tag.M_NOEMBED ||
        name == tag.M_NOFRAMES || name == tag.M_NOSCRIPT || name == tag.M_OBJECT ||
        name == tag.M_OL || name == tag.M_P || name == tag.M_PARAM ||
        name == tag.M_PLAINTEXT || name == tag.M_PRE || name == tag.M_SCRIPT ||
        name == tag.M_SEARCH || name == tag.M_SECTION || name == tag.M_SELECT ||
        name == tag.M_SOURCE || name == tag.M_STYLE || name == tag.M_SUMMARY ||
        name == tag.M_TABLE || name == tag.M_TBODY || name == tag.M_TD {
        return true
    }
    return name == tag.M_TEMPLATE || name == tag.M_TEXTAREA || name == tag.M_TFOOT ||
        name == tag.M_TH || name == tag.M_THEAD || name == tag.M_TITLE ||
        name == tag.M_TR || name == tag.M_TRACK || name == tag.M_UL ||
        name == tag.M_WBR || name == tag.M_XMP
}

// WHATWG §13.2.4.2 "Formatting" — genau die Elemente, die in der Liste der
// aktiven Formatierungselemente landen.
fn is_formatting(name: u32) -> bool {
    return name == tag.M_A || name == tag.M_B || name == tag.M_BIG ||
        name == tag.M_CODE || name == tag.M_EM || name == tag.M_FONT ||
        name == tag.M_I || name == tag.M_NOBR || name == tag.M_S ||
        name == tag.M_SMALL || name == tag.M_STRIKE || name == tag.M_STRONG ||
        name == tag.M_TT || name == tag.M_U
}

fn is_heading(name: u32) -> bool {
    return name == tag.M_H1 || name == tag.M_H2 || name == tag.M_H3 ||
        name == tag.M_H4 || name == tag.M_H5 || name == tag.M_H6
}

// Die Gruppe "address, article, aside, …" aus "in body".
fn is_block_group(name: u32) -> bool {
    return name == tag.M_ADDRESS || name == tag.M_ARTICLE || name == tag.M_ASIDE ||
        name == tag.M_BLOCKQUOTE || name == tag.M_CENTER || name == tag.M_DETAILS ||
        name == tag.M_DIALOG || name == tag.M_DIR || name == tag.M_DIV ||
        name == tag.M_DL || name == tag.M_FIELDSET || name == tag.M_FIGCAPTION ||
        name == tag.M_FIGURE || name == tag.M_FOOTER || name == tag.M_HEADER ||
        name == tag.M_HGROUP || name == tag.M_MAIN || name == tag.M_MENU ||
        name == tag.M_NAV || name == tag.M_OL || name == tag.M_P ||
        name == tag.M_SEARCH || name == tag.M_SECTION || name == tag.M_SUMMARY ||
        name == tag.M_UL
}

// Die Gruppe der ENDTAGS "address, article, …". Sie ist NICHT dieselbe wie
// die Starttag-Gruppe: `p` hat eine eigene Regel (es wird notfalls erzeugt),
// dafuer gehoeren `button`, `listing` und `pre` dazu. Diese Verwechslung hat
// beim ersten Lauf `</p>` den ganzen Stapel leergeraeumt.
fn end_block_group(name: u32) -> bool {
    if name == tag.M_P {
        return false
    }
    return is_block_group(name) || name == tag.M_BUTTON ||
        name == tag.M_LISTING || name == tag.M_PRE
}

fn is_whitespace(c: u32) -> bool {
    return c == 9 as u32 || c == 10 as u32 || c == 12 as u32 || c == 13 as u32 ||
        c == 32 as u32
}

// -------------------------------------------------- Knoten bauen/einfuegen

// WHATWG §13.2.6.1 "appropriate place for inserting a node", vollstaendig
// samt "foster parenting". Ergebnis sind ZWEI Werte (Elternknoten und der
// Knoten, VOR dem eingefuegt wird; Nullzeiger = anhaengen) — Firn hat keine
// Tupel, also gehen sie ueber Zeiger hinaus.
fn matching_site(b: *mut Tree, overriding: Gc[Node],
                   parent_out: *mut Gc[Node], ref_out: *mut Gc[Node]) {
    var target: Gc[Node] = overriding
    if target == gc_null[Node]() {
        target = current(b)
    }
    *parent_out = target
    *ref_out = gc_null[Node]()
    if !(*b).foster {
        return
    }
    let e: Gc[Elem] = node.node_as_elem(target)
    if e == gc_null[Elem]() || e.ns != node.NS_HTML {
        return
    }
    if !(e.name == tag.M_TABLE || e.name == tag.M_TBODY || e.name == tag.M_TFOOT ||
         e.name == tag.M_THEAD || e.name == tag.M_TR) {
        return
    }
    // Die letzte `table` im Stapel suchen.
    var i: usize = (*b).n_open
    var table: Gc[Node] = gc_null[Node]()
    var tidx: usize = 0
    while i > 0 {
        i = i - 1
        if node.elem_is((*b).open[i], tag.M_TABLE) {
            table = (*b).open[i]
            tidx = i
            break
        }
    }
    if table == gc_null[Node]() {
        // Fragmentfall: in das unterste Element des Stapels.
        if (*b).n_open > 0 {
            *parent_out = (*b).open[0]
        }
        return
    }
    if table.parent != gc_null[Node]() {
        *parent_out = table.parent
        *ref_out = table
        return
    }
    if tidx > 0 {
        *parent_out = (*b).open[tidx - 1]
    }
}

// Setzt die Attribute des aktuellen Starttag-Tokens auf `e`.
fn attribute_take(b: *mut Tree, e: Gc[Elem]) -> AllocError!bool {
    let st: *mut token_stream.Stream = (*b).stream
    let n: u32 = token_stream.stream_nattr(st)
    var off: usize = token_stream.stream_attr_first(st)
    var k: u32 = 0
    let buffer: *mut mem.CpBuf = &(*b).help
    while k < n {
        // Name
        mem.cp_clear(buffer)
        let nl: usize = token_stream.chain_length(st, off)
        var j: usize = 0
        while j < nl {
            mem.cp_push(buffer, token_stream.chain_cp(st, off, j))
            j = j + 1
        }
        let aname: u32 = names.names_of_cp((*b).names, buffer)
        off = token_stream.chain_end(st, off)
        // Wert
        let value = try node.chain_new()
        let wl: usize = token_stream.chain_length(st, off)
        j = 0
        while j < wl {
            let ok: bool = try node.chain_push(value, token_stream.chain_cp(st, off, j))
            if !ok {
                return false
            }
            j = j + 1
        }
        off = token_stream.chain_end(st, off)
        if aname == 0 as u32 {
            return false
        }
        let set: bool = try node.attr_set(e, aname, 0, value)
        if !set {
            // Doppelte Attribute verwirft schon der Tokenizer; hier waere es
            // nur ein zweiter Schutz.
            parse_error(b)
        }
        k = k + 1
    }
    return true
}

// "create an element for a token" — ohne Einfuegen.
fn elem_for_token(b: *mut Tree, ns: u32) -> AllocError!Gc[Elem] {
    let e = try node.elem_new((*b).tname, ns)
    if token_stream.stream_kind((*b).stream) == tokens.TB_START {
        let ok: bool = try attribute_take(b, e)
        if !ok {
            return gc_null[Elem]()
        }
    }
    return e
}

// Kopiert ein Element mitsamt Attributen. Das Adoption-Agency-Verfahren
// verlangt "create an element for the token for which the element was
// created" — der Kopie eines Elements ist das gleichwertig und braucht kein
// Aufbewahren alter Token.
fn elem_clone(e: Gc[Elem]) -> AllocError!Gc[Elem] {
    let new = try node.elem_new(e.name, e.ns)
    var a: Gc[Attr] = e.first_attr
    while a != gc_null[Attr]() {
        let ok: bool = try node.attr_set(new, a.name, a.ns, a.value)
        a = a.next
    }
    return new
}

// "insert a node at the appropriate place"
fn node_insert(b: *mut Tree, k: Gc[Node]) {
    var parent: Gc[Node] = gc_null[Node]()
    var ref_node: Gc[Node] = gc_null[Node]()
    matching_site(b, gc_null[Node](), &parent, &ref_node)
    if parent == gc_null[Node]() {
        return
    }
    node.kind_insert_before(parent, k, ref_node)
}

// "insert an HTML element for the token": erzeugen, einfuegen, auf den
// Stapel legen.
fn elem_insert_for_token(b: *mut Tree, ns: u32) -> AllocError!Gc[Elem] {
    let e = try elem_for_token(b, ns)
    if e == gc_null[Elem]() {
        return e
    }
    node_insert(b, e)
    stack_push(b, e)
    return e
}

// Wie oben, aber mit einem selbst gewaehlten Namen (z. B. das implizite
// `html`, `head` oder `body`).
fn elem_insert_name(b: *mut Tree, name: u32) -> AllocError!Gc[Elem] {
    let e = try node.elem_new(name, node.NS_HTML)
    node_insert(b, e)
    stack_push(b, e)
    return e
}

// WHATWG §13.2.6.1 "insert a character".
fn char_insert(b: *mut Tree, cp: u32) -> AllocError!bool {
    var parent: Gc[Node] = gc_null[Node]()
    var ref_node: Gc[Node] = gc_null[Node]()
    matching_site(b, gc_null[Node](), &parent, &ref_node)
    if parent == gc_null[Node]() {
        return false
    }
    // In ein Dokument kommt kein Text.
    if parent.kind == node.K_DOKUMENT {
        return true
    }
    var before: Gc[Node] = gc_null[Node]()
    if ref_node == gc_null[Node]() {
        before = parent.last_child
    } else {
        before = ref_node.previous
    }
    if before != gc_null[Node]() && before.kind == node.K_TEXT {
        let t: Gc[Text] = before.as?[Text]
        if t != gc_null[Text]() {
            return try node.chain_push(t.data, cp)
        }
    }
    let chain = try node.chain_new()
    let ok: bool = try node.chain_push(chain, cp)
    if !ok {
        return false
    }
    let t = try node.text_new(chain)
    node.kind_insert_before(parent, t, ref_node)
    return true
}

// Kommentar des aktuellen Tokens an eine bestimmte Stelle haengen.
// `eltern == gc_null` heisst "an die passende Stelle".
fn comment_insert(b: *mut Tree, parent: Gc[Node]) -> AllocError!bool {
    let st: *mut token_stream.Stream = (*b).stream
    let off: usize = token_stream.stream_data(st)
    let n: usize = token_stream.chain_length(st, off)
    let chain = try node.chain_new()
    var i: usize = 0
    while i < n {
        let ok: bool = try node.chain_push(chain, token_stream.chain_cp(st, off, i))
        if !ok {
            return false
        }
        i = i + 1
    }
    let c = try node.comment_new(chain)
    if parent != gc_null[Node]() {
        node.append_child(parent, c)
    } else {
        node_insert(b, c)
    }
    return true
}

// --------------------------------------- Liste der aktiven Formatierungen

fn active_push_mark(b: *mut Tree) {
    if (*b).nactive >= MAX_AKTIV {
        (*b).broken = 2
        return
    }
    (*b).active[(*b).nactive] = gc_null[Node]()
    (*b).nactive = (*b).nactive + 1
}

fn attribute_equal(a: Gc[Elem], c: Gc[Elem]) -> bool {
    if a.nattr != c.nattr {
        return false
    }
    var x: Gc[Attr] = a.first_attr
    while x != gc_null[Attr]() {
        var y: Gc[Attr] = c.first_attr
        var found: bool = false
        while y != gc_null[Attr]() {
            if y.name == x.name && y.ns == x.ns && node.chain_equal(y.value, x.value) {
                found = true
                break
            }
            y = y.next
        }
        if !found {
            return false
        }
        x = x.next
    }
    return true
}

// "push onto the list of active formatting elements" mit NOAHS ARCHE:
// stehen nach der letzten Marke schon drei gleiche Eintraege, faellt der
// aelteste heraus.
fn active_push(b: *mut Tree, k: Gc[Node]) {
    let e: Gc[Elem] = node.node_as_elem(k)
    if e != gc_null[Elem]() {
        var same: u32 = 0
        var first: i64 = -1
        var i: usize = (*b).nactive
        while i > 0 {
            i = i - 1
            let x: Gc[Node] = (*b).active[i]
            if x == gc_null[Node]() {
                break
            }
            let xe: Gc[Elem] = node.node_as_elem(x)
            if xe == gc_null[Elem]() {
                continue
            }
            if xe.name == e.name && xe.ns == e.ns && attribute_equal(xe, e) {
                same = same + 1
                first = i as i64
            }
        }
        if same >= 3 as u32 && first >= 0 {
            active_remove_at(b, first as usize)
        }
    }
    if (*b).nactive >= MAX_AKTIV {
        (*b).broken = 2
        return
    }
    (*b).active[(*b).nactive] = k
    (*b).nactive = (*b).nactive + 1
}

fn active_remove_at(b: *mut Tree, idx: usize) {
    if idx >= (*b).nactive {
        return
    }
    var i: usize = idx
    while i + 1 < (*b).nactive {
        (*b).active[i] = (*b).active[i + 1]
        i = i + 1
    }
    (*b).nactive = (*b).nactive - 1
    (*b).active[(*b).nactive] = gc_null[Node]()
}

fn active_index(b: *mut Tree, k: Gc[Node]) -> i64 {
    if k == gc_null[Node]() {
        return -1
    }
    var i: usize = (*b).nactive
    while i > 0 {
        i = i - 1
        if (*b).active[i] == k {
            return i as i64
        }
    }
    return -1
}

fn active_remove(b: *mut Tree, k: Gc[Node]) {
    let i: i64 = active_index(b, k)
    if i >= 0 {
        active_remove_at(b, i as usize)
    }
}

// "clear the list of active formatting elements up to the last marker"
fn active_to_mark_clear(b: *mut Tree) {
    while (*b).nactive > 0 {
        (*b).nactive = (*b).nactive - 1
        let k: Gc[Node] = (*b).active[(*b).nactive]
        (*b).active[(*b).nactive] = gc_null[Node]()
        if k == gc_null[Node]() {
            return
        }
    }
}

// Letzter Eintrag mit diesem Namen NACH der letzten Marke.
fn active_last_with_names(b: *mut Tree, name: u32) -> i64 {
    var i: usize = (*b).nactive
    while i > 0 {
        i = i - 1
        let k: Gc[Node] = (*b).active[i]
        if k == gc_null[Node]() {
            return -1
        }
        if node.elem_is(k, name) {
            return i as i64
        }
    }
    return -1
}

// WHATWG §13.2.4.3 "reconstruct the active formatting elements".
fn active_restore(b: *mut Tree) -> AllocError!bool {
    if (*b).nactive == 0 {
        return true
    }
    var i: usize = (*b).nactive - 1
    let last: Gc[Node] = (*b).active[i]
    if last == gc_null[Node]() || stack_contains(b, last) {
        return true
    }
    // Zurueckspulen
    while i > 0 {
        i = i - 1
        let x: Gc[Node] = (*b).active[i]
        if x == gc_null[Node]() || stack_contains(b, x) {
            i = i + 1
            break
        }
    }
    // Vorwaerts neu anlegen
    while i < (*b).nactive {
        let x: Gc[Node] = (*b).active[i]
        let xe: Gc[Elem] = node.node_as_elem(x)
        if xe == gc_null[Elem]() {
            i = i + 1
            continue
        }
        let new = try elem_clone(xe)
        node_insert(b, new)
        stack_push(b, new)
        (*b).active[i] = new
        i = i + 1
    }
    return true
}

// ------------------------------------------------- Implizites Schliessen

// WHATWG §13.2.6.3 "generate implied end tags", `ausser` wird ausgenommen
// (0 = nichts ausnehmen).
fn implizit_close(b: *mut Tree, except: u32) {
    while true {
        let k: Gc[Node] = current(b)
        let e: Gc[Elem] = node.node_as_elem(k)
        if e == gc_null[Elem]() || e.ns != node.NS_HTML {
            return
        }
        if e.name == except {
            return
        }
        if e.name == tag.M_DD || e.name == tag.M_DT || e.name == tag.M_LI ||
            e.name == tag.M_OPTGROUP || e.name == tag.M_OPTION || e.name == tag.M_P ||
            e.name == tag.M_RB || e.name == tag.M_RP || e.name == tag.M_RT ||
            e.name == tag.M_RTC {
            stack_pop(b)
        } else {
            return
        }
    }
}

// "generate all implied end tags thoroughly"
fn implizit_close_thorough(b: *mut Tree) {
    while true {
        let k: Gc[Node] = current(b)
        let e: Gc[Elem] = node.node_as_elem(k)
        if e == gc_null[Elem]() || e.ns != node.NS_HTML {
            return
        }
        if e.name == tag.M_CAPTION || e.name == tag.M_COLGROUP || e.name == tag.M_DD ||
            e.name == tag.M_DT || e.name == tag.M_LI || e.name == tag.M_OPTGROUP ||
            e.name == tag.M_OPTION || e.name == tag.M_P || e.name == tag.M_RB ||
            e.name == tag.M_RP || e.name == tag.M_RT || e.name == tag.M_RTC ||
            e.name == tag.M_TBODY || e.name == tag.M_TD || e.name == tag.M_TFOOT ||
            e.name == tag.M_TH || e.name == tag.M_THEAD || e.name == tag.M_TR {
            stack_pop(b)
        } else {
            return
        }
    }
}

// "close a p element"
fn p_close(b: *mut Tree) {
    implizit_close(b, tag.M_P)
    if !node.elem_is(current(b), tag.M_P) {
        parse_error(b)
    }
    stack_pop_to_name(b, tag.M_P)
}

// "clear the stack back to a table context" und die beiden Verwandten.
fn stack_to_table_context(b: *mut Tree) {
    while (*b).n_open > 0 {
        let k: Gc[Node] = current(b)
        if node.elem_is(k, tag.M_TABLE) || node.elem_is(k, tag.M_TEMPLATE) ||
            node.elem_is(k, tag.M_HTML) {
            return
        }
        stack_pop(b)
    }
}

fn stack_to_body_context(b: *mut Tree) {
    while (*b).n_open > 0 {
        let k: Gc[Node] = current(b)
        if node.elem_is(k, tag.M_TBODY) || node.elem_is(k, tag.M_TFOOT) ||
            node.elem_is(k, tag.M_THEAD) || node.elem_is(k, tag.M_TEMPLATE) ||
            node.elem_is(k, tag.M_HTML) {
            return
        }
        stack_pop(b)
    }
}

fn stack_to_line_context(b: *mut Tree) {
    while (*b).n_open > 0 {
        let k: Gc[Node] = current(b)
        if node.elem_is(k, tag.M_TR) || node.elem_is(k, tag.M_TEMPLATE) ||
            node.elem_is(k, tag.M_HTML) {
            return
        }
        stack_pop(b)
    }
}

// "close the cell"
fn cell_close(b: *mut Tree) {
    implizit_close(b, 0)
    let k: Gc[Node] = current(b)
    if !(node.elem_is(k, tag.M_TD) || node.elem_is(k, tag.M_TH)) {
        parse_error(b)
    }
    while (*b).n_open > 0 {
        let x: Gc[Node] = stack_pop(b)
        if node.elem_is(x, tag.M_TD) || node.elem_is(x, tag.M_TH) {
            break
        }
    }
    active_to_mark_clear(b)
    (*b).mode = EM_IN_ROW
}

// WHATWG §13.2.6.2 "reset the insertion mode appropriately".
fn insert_mode_reset(b: *mut Tree) {
    var i: usize = (*b).n_open
    while i > 0 {
        i = i - 1
        let k: Gc[Node] = (*b).open[i]
        let last: bool = i == 0
        let e: Gc[Elem] = node.node_as_elem(k)
        if e == gc_null[Elem]() || e.ns != node.NS_HTML {
            if last {
                (*b).mode = EM_IN_BODY
                return
            }
            continue
        }
        let n: u32 = e.name
        if n == tag.M_SELECT {
            // Der Standard sucht hier nach einer umgebenden Tabelle.
            var j: usize = i
            while j > 0 {
                j = j - 1
                let a: Gc[Node] = (*b).open[j]
                if node.elem_is(a, tag.M_TEMPLATE) {
                    break
                }
                if node.elem_is(a, tag.M_TABLE) {
                    (*b).mode = EM_IN_SELECT_IN_TABLE
                    return
                }
            }
            (*b).mode = EM_IN_SELECT
            return
        }
        if (n == tag.M_TD || n == tag.M_TH) && !last {
            (*b).mode = EM_IN_CELL
            return
        }
        if n == tag.M_TR {
            (*b).mode = EM_IN_ROW
            return
        }
        if n == tag.M_TBODY || n == tag.M_THEAD || n == tag.M_TFOOT {
            (*b).mode = EM_IN_TABLE_BODY
            return
        }
        if n == tag.M_CAPTION {
            (*b).mode = EM_IN_CAPTION
            return
        }
        if n == tag.M_COLGROUP {
            (*b).mode = EM_IN_COLGROUP
            return
        }
        if n == tag.M_TABLE {
            (*b).mode = EM_IN_TABLE
            return
        }
        if n == tag.M_HEAD && !last {
            (*b).mode = EM_IN_HEAD
            return
        }
        if n == tag.M_BODY {
            (*b).mode = EM_IN_BODY
            return
        }
        if n == tag.M_FRAMESET {
            (*b).mode = EM_IN_FRAMESET
            return
        }
        if n == tag.M_HTML {
            if (*b).header == gc_null[Elem]() {
                (*b).mode = EM_VOR_HEAD
            } else {
                (*b).mode = EM_NACH_HEAD
            }
            return
        }
        if last {
            (*b).mode = EM_IN_BODY
            return
        }
    }
    (*b).mode = EM_IN_BODY
}

// --------------------------------------------- Rohtext- und RCDATA-Wege

// WHATWG §13.2.6.2: "generic raw text element parsing algorithm" bzw.
// "generic RCDATA element parsing algorithm". Der einzige Ort, an dem der
// Baumaufbau den TOKENIZER umstellt — deshalb wird hier die Rueckkopplung
// vermerkt, die der Treiber danach ausfuehrt.
fn raw_text_elem(b: *mut Tree, state: u32) -> AllocError!bool {
    let e = try elem_insert_for_token(b, node.NS_HTML)
    if e == gc_null[Elem]() {
        return false
    }
    (*b).basemode = (*b).mode
    (*b).mode = EM_TEXT
    (*b).switching = state
    (*b).um_pos = token_stream.stream_pos((*b).stream)
    mem.cp_clear(&(*b).um_tag)
    names.names_after_cpbuf((*b).names, (*b).tname, &(*b).um_tag)
    return true
}

// ----------------------------------------- Das Adoption-Agency-Verfahren

// WHATWG §13.2.6.4.7, "adoption agency algorithm". Antwort `true` heisst:
// erledigt. `false` heisst: der Aufrufer soll das Token wie in "any other
// end tag" behandeln.
fn adoption_agency(b: *mut Tree, subject: u32) -> AllocError!bool {
    // Schritt 2
    let cur: Gc[Node] = current(b)
    if node.elem_is(cur, subject) && active_index(b, cur) < 0 {
        stack_pop(b)
        return true
    }
    var round: u32 = 0
    while round < 8 as u32 {
        round = round + 1
        // Schritt 4.3
        let fidx: i64 = active_last_with_names(b, subject)
        if fidx < 0 {
            return false
        }
        let formatting: Gc[Node] = (*b).active[fidx as usize]
        // Schritt 4.4
        if !stack_contains(b, formatting) {
            parse_error(b)
            active_remove_at(b, fidx as usize)
            return true
        }
        // Schritt 4.5
        if !node_in_scope(b, formatting, SC_NORMAL) {
            parse_error(b)
            return true
        }
        // Schritt 4.6
        if formatting != current(b) {
            parse_error(b)
        }
        // Schritt 4.7: der oberste Sonderknoten UNTERHALB von formatierung
        let sidx: i64 = stack_index(b, formatting)
        var farthest: Gc[Node] = gc_null[Node]()
        var fidx_stack: usize = 0
        var i: usize = sidx as usize + 1
        while i < (*b).n_open {
            let x: Gc[Node] = (*b).open[i]
            let xe: Gc[Elem] = node.node_as_elem(x)
            if xe != gc_null[Elem]() && is_special(xe.name, xe.ns) {
                farthest = x
                fidx_stack = i
                break
            }
            i = i + 1
        }
        // Schritt 4.8
        if farthest == gc_null[Node]() {
            stack_pop_to(b, formatting)
            active_remove(b, formatting)
            return true
        }
        // Schritt 4.9
        let ancestor: Gc[Node] = (*b).open[sidx as usize - 1]
        // Schritt 4.10: das Lesezeichen steht VOR formatierung
        var bookmark: usize = fidx as usize
        // Schritt 4.11
        var nodeX: Gc[Node] = farthest
        var lastX: Gc[Node] = farthest
        var node_idx: usize = fidx_stack
        var inner: u32 = 0
        while true {
            inner = inner + 1
            // Schritt 4.13.2
            if node_idx == 0 {
                break
            }
            node_idx = node_idx - 1
            nodeX = (*b).open[node_idx]
            // Schritt 4.13.3
            if nodeX == formatting {
                break
            }
            let aidx: i64 = active_index(b, nodeX)
            // Schritt 4.13.4
            if inner > 3 as u32 && aidx >= 0 {
                active_remove_at(b, aidx as usize)
                if bookmark > aidx as usize {
                    bookmark = bookmark - 1
                }
                // knotenX steht jetzt nicht mehr in der Liste
                stack_remove(b, nodeX)
                continue
            }
            // Schritt 4.13.5
            if aidx < 0 {
                stack_remove(b, nodeX)
                continue
            }
            // Schritt 4.13.6
            let xe: Gc[Elem] = node.node_as_elem(nodeX)
            if xe == gc_null[Elem]() {
                stack_remove(b, nodeX)
                continue
            }
            let new = try elem_clone(xe)
            (*b).active[aidx as usize] = new
            (*b).open[node_idx] = new
            nodeX = new
            // Schritt 4.13.7
            if lastX == farthest {
                bookmark = aidx as usize + 1
            }
            // Schritt 4.13.8
            node.append_child(nodeX, lastX)
            // Schritt 4.13.9
            lastX = nodeX
        }
        // Schritt 4.14
        var parent: Gc[Node] = gc_null[Node]()
        var ref_node: Gc[Node] = gc_null[Node]()
        matching_site(b, ancestor, &parent, &ref_node)
        if parent != gc_null[Node]() {
            node.kind_insert_before(parent, lastX, ref_node)
        }
        // Schritt 4.15..4.17
        let fe: Gc[Elem] = node.node_as_elem(formatting)
        if fe == gc_null[Elem]() {
            return true
        }
        let new_fe = try elem_clone(fe)
        node.relink_children(farthest, new_fe)
        node.append_child(farthest, new_fe)
        // Schritt 4.18
        active_remove(b, formatting)
        if bookmark > (*b).nactive {
            bookmark = (*b).nactive
        }
        active_insert_at(b, bookmark, new_fe)
        // Schritt 4.19
        stack_remove(b, formatting)
        stack_insert_over(b, farthest, new_fe)
    }
    return true
}

fn active_insert_at(b: *mut Tree, idx: usize, k: Gc[Node]) {
    if (*b).nactive >= MAX_AKTIV {
        (*b).broken = 2
        return
    }
    var i: usize = (*b).nactive
    while i > idx {
        (*b).active[i] = (*b).active[i - 1]
        i = i - 1
    }
    (*b).active[idx] = k
    (*b).nactive = (*b).nactive + 1
}

// Legt `neu` unmittelbar OBERHALB von `bezug` ab (im Standard heisst das
// "immediately below the position of furthestBlock" — der Stapel dort waechst
// nach unten, hier nach oben, die Stelle ist dieselbe).
fn stack_insert_over(b: *mut Tree, ref_node: Gc[Node], new: Gc[Node]) {
    let idx: i64 = stack_index(b, ref_node)
    if idx < 0 {
        stack_push(b, new)
        return
    }
    if (*b).n_open >= MAX_OFFEN {
        (*b).broken = 1
        return
    }
    var i: usize = (*b).n_open
    while i > idx as usize + 1 {
        (*b).open[i] = (*b).open[i - 1]
        i = i - 1
    }
    (*b).open[idx as usize + 1] = new
    (*b).n_open = (*b).n_open + 1
}

// ===========================================================================
//                        DIE EINFUEGEMODI
// ===========================================================================
//
// Jeder Modus beantwortet ein Token mit einer von drei Zahlen:
//     0  fertig
//     1  ERNEUT verarbeiten (der Modus wurde gewechselt — "reprocess")
//    99  Speicher aus (kommt nur aus einem `catch`)
// Das ist die woertliche Entsprechung des "reprocess the token" im Standard.

const A_FERTIG: u32 = 0
const A_ERNEUT: u32 = 1
const A_AUS: u32 = 99

// ------------------------------------------------------------ Hilfsfragen

fn tok_is_start(b: *mut Tree) -> bool {
    return token_stream.stream_kind((*b).stream) == tokens.TB_START
}

fn tok_is_end(b: *mut Tree) -> bool {
    return token_stream.stream_kind((*b).stream) == tokens.TB_END
}

fn tok_self_closing(b: *mut Tree) -> bool {
    return (token_stream.stream_flags((*b).stream) & tokens.TB_F_SELF_CLOSING) != 0 as u32
}

// Fuegt ein leeres Element ein und nimmt es sofort wieder vom Stapel
// ("Insert an HTML element for the token. Immediately pop …").
fn empty_elem(b: *mut Tree) -> AllocError!bool {
    let e = try elem_insert_for_token(b, node.NS_HTML)
    if e == gc_null[Elem]() {
        return false
    }
    stack_pop(b)
    return true
}

// Attribute des Tokens an ein bestehendes Element anfuegen, ohne
// vorhandene zu ueberschreiben (`<html>` und `<body>` in "in body").
fn attribute_amend(b: *mut Tree, e: Gc[Elem]) -> AllocError!bool {
    if e == gc_null[Elem]() {
        return true
    }
    let st: *mut token_stream.Stream = (*b).stream
    let n: u32 = token_stream.stream_nattr(st)
    var off: usize = token_stream.stream_attr_first(st)
    var k: u32 = 0
    let buffer: *mut mem.CpBuf = &(*b).help
    while k < n {
        mem.cp_clear(buffer)
        let nl: usize = token_stream.chain_length(st, off)
        var j: usize = 0
        while j < nl {
            mem.cp_push(buffer, token_stream.chain_cp(st, off, j))
            j = j + 1
        }
        let aname: u32 = names.names_of_cp((*b).names, buffer)
        off = token_stream.chain_end(st, off)
        let value = try node.chain_new()
        let wl: usize = token_stream.chain_length(st, off)
        j = 0
        while j < wl {
            let ok: bool = try node.chain_push(value, token_stream.chain_cp(st, off, j))
            if !ok {
                return false
            }
            j = j + 1
        }
        off = token_stream.chain_end(st, off)
        let set: bool = try node.attr_set(e, aname, 0, value)
        k = k + 1
    }
    return true
}

// Hat das aktuelle Starttag-Token ein `type`-Attribut mit dem Wert `hidden`
// (ASCII-fallunempfindlich)? Braucht "in body" fuer `<input>` und
// "in table" fuer das versteckte Eingabefeld.
fn tok_type_is(b: *mut Tree, p: *mut u8, len: usize) -> bool {
    let st: *mut token_stream.Stream = (*b).stream
    let n: u32 = token_stream.stream_nattr(st)
    var off: usize = token_stream.stream_attr_first(st)
    var k: u32 = 0
    let buffer: *mut mem.CpBuf = &(*b).help
    while k < n {
        mem.cp_clear(buffer)
        let nl: usize = token_stream.chain_length(st, off)
        var j: usize = 0
        while j < nl {
            mem.cp_push(buffer, token_stream.chain_cp(st, off, j))
            j = j + 1
        }
        let is_type: bool = nl == 4 && mem.cp_at(buffer, 0) == 116 as u32 &&
            mem.cp_at(buffer, 1) == 121 as u32 && mem.cp_at(buffer, 2) == 112 as u32 &&
            mem.cp_at(buffer, 3) == 101 as u32
        off = token_stream.chain_end(st, off)
        if is_type {
            let wl: usize = token_stream.chain_length(st, off)
            if wl != len {
                return false
            }
            var i: usize = 0
            while i < wl {
                var c: u32 = token_stream.chain_cp(st, off, i)
                if c >= 65 as u32 && c <= 90 as u32 {
                    c = c + 32 as u32
                }
                if c != (*((p as u64 + i as u64) as *mut u8)) as u32 {
                    return false
                }
                i = i + 1
            }
            return true
        }
        off = token_stream.chain_end(st, off)
        k = k + 1
    }
    return false
}

fn has_type_attr(b: *mut Tree) -> bool {
    let st: *mut token_stream.Stream = (*b).stream
    let n: u32 = token_stream.stream_nattr(st)
    var off: usize = token_stream.stream_attr_first(st)
    var k: u32 = 0
    while k < n {
        let nl: usize = token_stream.chain_length(st, off)
        if nl == 4 && token_stream.chain_cp(st, off, 0) == 116 as u32 &&
            token_stream.chain_cp(st, off, 1) == 121 as u32 &&
            token_stream.chain_cp(st, off, 2) == 112 as u32 &&
            token_stream.chain_cp(st, off, 3) == 101 as u32 {
            return true
        }
        off = token_stream.chain_end(st, off)
        off = token_stream.chain_end(st, off)
        k = k + 1
    }
    return false
}

// -------------------------------------------------------- Zeichen: Modi

fn char_in_body(b: *mut Tree, cp: u32) -> AllocError!u32 {
    if cp == 0 as u32 {
        parse_error(b)
        return A_FERTIG
    }
    let ok0: bool = try active_restore(b)
    let ok: bool = try char_insert(b, cp)
    if !ok {
        return A_AUS
    }
    if !is_whitespace(cp) {
        (*b).frameset_ok = false
    }
    return A_FERTIG
}

fn char_mode(b: *mut Tree, cp: u32) -> AllocError!u32 {
    let m: u32 = (*b).mode
    if m == EM_INITIAL {
        if is_whitespace(cp) {
            return A_FERTIG
        }
        parse_error(b)
        node.doc_mode_set((*b).doc, node.MODUS_QUIRKS)
        (*b).mode = EM_VOR_HTML
        return A_ERNEUT
    }
    if m == EM_VOR_HTML {
        if is_whitespace(cp) {
            return A_FERTIG
        }
        let e = try node.elem_new(tag.M_HTML, node.NS_HTML)
        node.append_child((*b).doc, e)
        stack_push(b, e)
        (*b).mode = EM_VOR_HEAD
        return A_ERNEUT
    }
    if m == EM_VOR_HEAD {
        if is_whitespace(cp) {
            return A_FERTIG
        }
        let e = try elem_insert_name(b, tag.M_HEAD)
        (*b).header = e
        (*b).mode = EM_IN_HEAD
        return A_ERNEUT
    }
    if m == EM_IN_HEAD {
        if is_whitespace(cp) {
            let ok: bool = try char_insert(b, cp)
            return A_FERTIG
        }
        stack_pop(b)
        (*b).mode = EM_NACH_HEAD
        return A_ERNEUT
    }
    if m == EM_IN_HEAD_NOSCRIPT {
        if is_whitespace(cp) {
            let ok: bool = try char_insert(b, cp)
            return A_FERTIG
        }
        parse_error(b)
        stack_pop(b)
        (*b).mode = EM_IN_HEAD
        return A_ERNEUT
    }
    if m == EM_NACH_HEAD {
        if is_whitespace(cp) {
            let ok: bool = try char_insert(b, cp)
            return A_FERTIG
        }
        let e = try elem_insert_name(b, tag.M_BODY)
        (*b).mode = EM_IN_BODY
        return A_ERNEUT
    }
    if m == EM_IN_BODY || m == EM_IN_CAPTION || m == EM_IN_CELL {
        return try char_in_body(b, cp)
    }
    if m == EM_TEXT {
        let ok: bool = try char_insert(b, cp)
        if !ok {
            return A_AUS
        }
        return A_FERTIG
    }
    if m == EM_IN_TABLE || m == EM_IN_TABLE_BODY || m == EM_IN_ROW {
        let k: Gc[Node] = current(b)
        if node.elem_is(k, tag.M_TABLE) || node.elem_is(k, tag.M_TBODY) ||
            node.elem_is(k, tag.M_TFOOT) || node.elem_is(k, tag.M_THEAD) ||
            node.elem_is(k, tag.M_TR) {
            (*b).tt = try node.chain_new()
            (*b).tt_only_space = true
            (*b).basemode = m
            (*b).mode = EM_IN_TABLE_TEXT
            return A_ERNEUT
        }
        parse_error(b)
        (*b).foster = true
        let r: u32 = try char_in_body(b, cp)
        (*b).foster = false
        return r
    }
    if m == EM_IN_TABLE_TEXT {
        if cp == 0 as u32 {
            parse_error(b)
            return A_FERTIG
        }
        if !is_whitespace(cp) {
            (*b).tt_only_space = false
        }
        let ok: bool = try node.chain_push((*b).tt, cp)
        if !ok {
            return A_AUS
        }
        return A_FERTIG
    }
    if m == EM_IN_COLGROUP {
        if is_whitespace(cp) {
            let ok: bool = try char_insert(b, cp)
            return A_FERTIG
        }
        if !node.elem_is(current(b), tag.M_COLGROUP) {
            parse_error(b)
            return A_FERTIG
        }
        stack_pop(b)
        (*b).mode = EM_IN_TABLE
        return A_ERNEUT
    }
    if m == EM_IN_SELECT || m == EM_IN_SELECT_IN_TABLE {
        if cp == 0 as u32 {
            parse_error(b)
            return A_FERTIG
        }
        let ok: bool = try char_insert(b, cp)
        return A_FERTIG
    }
    if m == EM_NACH_BODY || m == EM_NACH_NACH_BODY {
        if is_whitespace(cp) {
            return try char_in_body(b, cp)
        }
        parse_error(b)
        (*b).mode = EM_IN_BODY
        return A_ERNEUT
    }
    if m == EM_IN_FRAMESET || m == EM_NACH_FRAMESET || m == EM_NACH_NACH_FRAMESET {
        if is_whitespace(cp) {
            let ok: bool = try char_insert(b, cp)
            return A_FERTIG
        }
        parse_error(b)
        return A_FERTIG
    }
    return A_FERTIG
}

// Schuettet die im Modus "in table text" gesammelten Zeichen aus.
fn tt_flush(b: *mut Tree) -> AllocError!bool {
    let k: Gc[Chain] = (*b).tt
    (*b).tt = gc_null[Chain]()
    if k == gc_null[Chain]() {
        (*b).mode = (*b).basemode
        return true
    }
    let n: u64 = node.chain_len(k)
    if (*b).tt_only_space {
        var i: u64 = 0
        while i < n {
            let ok: bool = try char_insert(b, node.chain_at(k, i))
            if !ok {
                return false
            }
            i = i + 1
        }
        (*b).mode = (*b).basemode
        return true
    }
    parse_error(b)
    (*b).foster = true
    var i: u64 = 0
    while i < n {
        let r: u32 = try char_in_body(b, node.chain_at(k, i))
        i = i + 1
    }
    (*b).foster = false
    (*b).mode = (*b).basemode
    return true
}

// ------------------------------------------------- "initial" / "before html"

// Quirks-Erkennung aus dem DOCTYPE (WHATWG §13.2.6.4.1).
// EHRLICHE GRENZE: die vollstaendige Liste der oeffentlichen Kennungen des
// Standards (rund 55 Praefixe aus der Zeit vor HTML5) ist NICHT eingebaut.
// Umgesetzt sind: die "force quirks"-Flagge des Tokenizers, ein Name != html,
// ein vorhandenes System-Literal in Verbindung mit HTML 4.01, sowie die vier
// Praefixe, die heute noch vorkommen. Alles andere gilt als "no quirks".
fn doctype_mode(b: *mut Tree, name: Gc[Chain], pubid: Gc[Chain], sysid: Gc[Chain],
                 force: bool, has_pubid: bool, has_sysid: bool) -> u32 {
    var lit_html: [u8; 4] = "html"
    if force || !node.chain_equal_ascii(name, &lit_html[0], 4) {
        return node.MODUS_QUIRKS
    }
    var p_x_frame: [u8; 32] = "-//W3C//DTD XHTML 1.0 Frameset//"
    var p_x_trans: [u8; 36] = "-//W3C//DTD XHTML 1.0 Transitional//"
    var p_h_frame: [u8; 32] = "-//W3C//DTD HTML 4.01 Frameset//"
    var p_h_trans: [u8; 36] = "-//W3C//DTD HTML 4.01 Transitional//"
    if has_pubid {
        if node.chain_starts_ascii_small(pubid, &p_h_frame[0], 32) ||
            node.chain_starts_ascii_small(pubid, &p_h_trans[0], 36) {
            if has_sysid {
                return node.MODUS_BEGRENZT
            }
            return node.MODUS_QUIRKS
        }
        if node.chain_starts_ascii_small(pubid, &p_x_frame[0], 32) ||
            node.chain_starts_ascii_small(pubid, &p_x_trans[0], 36) {
            return node.MODUS_BEGRENZT
        }
    }
    return node.MODUS_KEIN_QUIRKS
}

fn chain_out_stream(b: *mut Tree, off: usize) -> AllocError!Gc[Chain] {
    let st: *mut token_stream.Stream = (*b).stream
    let k = try node.chain_new()
    let n: usize = token_stream.chain_length(st, off)
    var i: usize = 0
    while i < n {
        let ok: bool = try node.chain_push(k, token_stream.chain_cp(st, off, i))
        i = i + 1
    }
    return k
}

fn m_initial(b: *mut Tree) -> AllocError!u32 {
    let kind: u32 = token_stream.stream_kind((*b).stream)
    if kind == tokens.TB_COMMENT {
        let ok: bool = try comment_insert(b, (*b).doc)
        return A_FERTIG
    }
    if kind == tokens.TB_DOCTYPE {
        let st: *mut token_stream.Stream = (*b).stream
        let f: u32 = token_stream.stream_flags(st)
        let name = try chain_out_stream(b, token_stream.stream_name(st))
        let pubid = try chain_out_stream(b, token_stream.stream_doctype_pubid(st))
        let sysid = try chain_out_stream(b, token_stream.stream_doctype_sysid(st))
        let has_pubid: bool = (f & tokens.TB_F_HAT_PUBID) != 0 as u32
        let has_sysid: bool = (f & tokens.TB_F_HAT_SYSID) != 0 as u32
        let force: bool = (f & tokens.TB_F_FORCE_QUIRKS) != 0 as u32
        let d = try node.doctype_new(name, pubid, sysid, has_pubid, has_sysid)
        node.append_child((*b).doc, d)
        node.doc_mode_set((*b).doc,
            doctype_mode(b, name, pubid, sysid, force, has_pubid, has_sysid))
        (*b).mode = EM_VOR_HTML
        return A_FERTIG
    }
    parse_error(b)
    node.doc_mode_set((*b).doc, node.MODUS_QUIRKS)
    (*b).mode = EM_VOR_HTML
    return A_ERNEUT
}

fn m_before_html(b: *mut Tree) -> AllocError!u32 {
    let kind: u32 = token_stream.stream_kind((*b).stream)
    if kind == tokens.TB_DOCTYPE {
        parse_error(b)
        return A_FERTIG
    }
    if kind == tokens.TB_COMMENT {
        let ok: bool = try comment_insert(b, (*b).doc)
        return A_FERTIG
    }
    if kind == tokens.TB_START && (*b).tname == tag.M_HTML {
        let e = try elem_for_token(b, node.NS_HTML)
        node.append_child((*b).doc, e)
        stack_push(b, e)
        (*b).mode = EM_VOR_HEAD
        return A_FERTIG
    }
    if kind == tokens.TB_END {
        let n: u32 = (*b).tname
        if !(n == tag.M_HEAD || n == tag.M_BODY || n == tag.M_HTML || n == tag.M_BR) {
            parse_error(b)
            return A_FERTIG
        }
    }
    let e = try node.elem_new(tag.M_HTML, node.NS_HTML)
    node.append_child((*b).doc, e)
    stack_push(b, e)
    (*b).mode = EM_VOR_HEAD
    return A_ERNEUT
}

fn m_before_head(b: *mut Tree) -> AllocError!u32 {
    let kind: u32 = token_stream.stream_kind((*b).stream)
    if kind == tokens.TB_COMMENT {
        let ok: bool = try comment_insert(b, gc_null[Node]())
        return A_FERTIG
    }
    if kind == tokens.TB_DOCTYPE {
        parse_error(b)
        return A_FERTIG
    }
    if kind == tokens.TB_START && (*b).tname == tag.M_HTML {
        return try m_in_body(b)
    }
    if kind == tokens.TB_START && (*b).tname == tag.M_HEAD {
        let e = try elem_insert_for_token(b, node.NS_HTML)
        (*b).header = e
        (*b).mode = EM_IN_HEAD
        return A_FERTIG
    }
    if kind == tokens.TB_END {
        let n: u32 = (*b).tname
        if !(n == tag.M_HEAD || n == tag.M_BODY || n == tag.M_HTML || n == tag.M_BR) {
            parse_error(b)
            return A_FERTIG
        }
    }
    let e = try elem_insert_name(b, tag.M_HEAD)
    (*b).header = e
    (*b).mode = EM_IN_HEAD
    return A_ERNEUT
}

// ------------------------------------------------------------- "in head"

fn m_in_head(b: *mut Tree) -> AllocError!u32 {
    let kind: u32 = token_stream.stream_kind((*b).stream)
    if kind == tokens.TB_COMMENT {
        let ok: bool = try comment_insert(b, gc_null[Node]())
        return A_FERTIG
    }
    if kind == tokens.TB_DOCTYPE {
        parse_error(b)
        return A_FERTIG
    }
    let n: u32 = (*b).tname
    if kind == tokens.TB_START {
        if n == tag.M_HTML {
            return try m_in_body(b)
        }
        if n == tag.M_BASE || n == tag.M_BASEFONT || n == tag.M_BGSOUND ||
            n == tag.M_LINK || n == tag.M_META {
            let ok: bool = try empty_elem(b)
            return A_FERTIG
        }
        if n == tag.M_TITLE {
            let ok: bool = try raw_text_elem(b, ZST_RCDATA)
            return A_FERTIG
        }
        if n == tag.M_NOFRAMES || n == tag.M_STYLE {
            let ok: bool = try raw_text_elem(b, ZST_RAWTEXT)
            return A_FERTIG
        }
        if n == tag.M_NOSCRIPT {
            // Die Skriptflagge ist AUS (kein Skriptbetrieb, siehe Kopf).
            let e = try elem_insert_for_token(b, node.NS_HTML)
            (*b).mode = EM_IN_HEAD_NOSCRIPT
            return A_FERTIG
        }
        if n == tag.M_SCRIPT {
            let ok: bool = try raw_text_elem(b, ZST_SCRIPT)
            return A_FERTIG
        }
        if n == tag.M_HEAD {
            parse_error(b)
            return A_FERTIG
        }
    }
    if kind == tokens.TB_END {
        if n == tag.M_HEAD {
            stack_pop(b)
            (*b).mode = EM_NACH_HEAD
            return A_FERTIG
        }
        if !(n == tag.M_BODY || n == tag.M_HTML || n == tag.M_BR) {
            parse_error(b)
            return A_FERTIG
        }
    }
    stack_pop(b)
    (*b).mode = EM_NACH_HEAD
    return A_ERNEUT
}

fn m_in_head_noscript(b: *mut Tree) -> AllocError!u32 {
    let kind: u32 = token_stream.stream_kind((*b).stream)
    let n: u32 = (*b).tname
    if kind == tokens.TB_DOCTYPE {
        parse_error(b)
        return A_FERTIG
    }
    if kind == tokens.TB_START && n == tag.M_HTML {
        return try m_in_body(b)
    }
    if kind == tokens.TB_END && n == tag.M_NOSCRIPT {
        stack_pop(b)
        (*b).mode = EM_IN_HEAD
        return A_FERTIG
    }
    if kind == tokens.TB_COMMENT {
        return try m_in_head(b)
    }
    if kind == tokens.TB_START {
        if n == tag.M_BASEFONT || n == tag.M_BGSOUND || n == tag.M_LINK ||
            n == tag.M_META || n == tag.M_NOFRAMES || n == tag.M_STYLE {
            return try m_in_head(b)
        }
        if n == tag.M_HEAD || n == tag.M_NOSCRIPT {
            parse_error(b)
            return A_FERTIG
        }
    }
    if kind == tokens.TB_END && n != tag.M_BR {
        parse_error(b)
        return A_FERTIG
    }
    parse_error(b)
    stack_pop(b)
    (*b).mode = EM_IN_HEAD
    return A_ERNEUT
}

fn m_after_head(b: *mut Tree) -> AllocError!u32 {
    let kind: u32 = token_stream.stream_kind((*b).stream)
    let n: u32 = (*b).tname
    if kind == tokens.TB_COMMENT {
        let ok: bool = try comment_insert(b, gc_null[Node]())
        return A_FERTIG
    }
    if kind == tokens.TB_DOCTYPE {
        parse_error(b)
        return A_FERTIG
    }
    if kind == tokens.TB_START {
        if n == tag.M_HTML {
            return try m_in_body(b)
        }
        if n == tag.M_BODY {
            let e = try elem_insert_for_token(b, node.NS_HTML)
            (*b).frameset_ok = false
            (*b).mode = EM_IN_BODY
            return A_FERTIG
        }
        if n == tag.M_FRAMESET {
            let e = try elem_insert_for_token(b, node.NS_HTML)
            (*b).mode = EM_IN_FRAMESET
            return A_FERTIG
        }
        if n == tag.M_BASE || n == tag.M_BASEFONT || n == tag.M_BGSOUND ||
            n == tag.M_LINK || n == tag.M_META || n == tag.M_NOFRAMES ||
            n == tag.M_SCRIPT || n == tag.M_STYLE || n == tag.M_TEMPLATE ||
            n == tag.M_TITLE {
            parse_error(b)
            // Der `head` kommt fuer die Dauer der Verarbeitung zurueck auf
            // den Stapel — genau so steht es im Standard.
            stack_push(b, (*b).header)
            let r: u32 = try m_in_head(b)
            stack_remove(b, (*b).header)
            return r
        }
        if n == tag.M_HEAD {
            parse_error(b)
            return A_FERTIG
        }
    }
    if kind == tokens.TB_END && !(n == tag.M_BODY || n == tag.M_HTML || n == tag.M_BR) {
        parse_error(b)
        return A_FERTIG
    }
    let e = try elem_insert_name(b, tag.M_BODY)
    (*b).mode = EM_IN_BODY
    return A_ERNEUT
}

// ------------------------------------------------------------- "in body"

// "any other end tag" aus "in body" — die Schleife, die einen Endtag durch
// den Stapel sucht und dabei an Sonderelementen abbricht.
fn end_general(b: *mut Tree) -> AllocError!u32 {
    let name: u32 = (*b).tname
    var i: usize = (*b).n_open
    while i > 0 {
        i = i - 1
        let k: Gc[Node] = (*b).open[i]
        if node.elem_is(k, name) {
            implizit_close(b, name)
            if k != current(b) {
                parse_error(b)
            }
            stack_pop_to(b, k)
            return A_FERTIG
        }
        let e: Gc[Elem] = node.node_as_elem(k)
        if e != gc_null[Elem]() && is_special(e.name, e.ns) {
            parse_error(b)
            return A_FERTIG
        }
    }
    return A_FERTIG
}

fn in_body_start(b: *mut Tree) -> AllocError!u32 {
    let n: u32 = (*b).tname
    if n == tag.M_HTML {
        parse_error(b)
        if (*b).n_open > 0 {
            let ok: bool = try attribute_amend(b, node.node_as_elem((*b).open[0]))
        }
        return A_FERTIG
    }
    if n == tag.M_BASE || n == tag.M_BASEFONT || n == tag.M_BGSOUND ||
        n == tag.M_LINK || n == tag.M_META || n == tag.M_NOFRAMES ||
        n == tag.M_SCRIPT || n == tag.M_STYLE || n == tag.M_TEMPLATE ||
        n == tag.M_TITLE {
        return try m_in_head(b)
    }
    if n == tag.M_BODY {
        parse_error(b)
        if (*b).n_open < 2 || !node.elem_is((*b).open[1], tag.M_BODY) {
            return A_FERTIG
        }
        (*b).frameset_ok = false
        let ok: bool = try attribute_amend(b, node.node_as_elem((*b).open[1]))
        return A_FERTIG
    }
    if n == tag.M_FRAMESET {
        parse_error(b)
        if (*b).n_open < 2 || !node.elem_is((*b).open[1], tag.M_BODY) {
            return A_FERTIG
        }
        if !(*b).frameset_ok {
            return A_FERTIG
        }
        node.kind_remove((*b).open[1])
        while (*b).n_open > 1 {
            stack_pop(b)
        }
        let e = try elem_insert_for_token(b, node.NS_HTML)
        (*b).mode = EM_IN_FRAMESET
        return A_FERTIG
    }
    if is_block_group(n) {
        if in_scope(b, tag.M_P, SC_BUTTON) {
            p_close(b)
        }
        let e = try elem_insert_for_token(b, node.NS_HTML)
        return A_FERTIG
    }
    if is_heading(n) {
        if in_scope(b, tag.M_P, SC_BUTTON) {
            p_close(b)
        }
        let k: Gc[Node] = current(b)
        let ke: Gc[Elem] = node.node_as_elem(k)
        if ke != gc_null[Elem]() && ke.ns == node.NS_HTML && is_heading(ke.name) {
            parse_error(b)
            stack_pop(b)
        }
        let e = try elem_insert_for_token(b, node.NS_HTML)
        return A_FERTIG
    }
    if n == tag.M_PRE || n == tag.M_LISTING {
        if in_scope(b, tag.M_P, SC_BUTTON) {
            p_close(b)
        }
        let e = try elem_insert_for_token(b, node.NS_HTML)
        (*b).nl_skip = true
        (*b).frameset_ok = false
        return A_FERTIG
    }
    if n == tag.M_FORM {
        if (*b).form != gc_null[Elem]() {
            parse_error(b)
            return A_FERTIG
        }
        if in_scope(b, tag.M_P, SC_BUTTON) {
            p_close(b)
        }
        let e = try elem_insert_for_token(b, node.NS_HTML)
        (*b).form = e
        return A_FERTIG
    }
    if n == tag.M_LI {
        (*b).frameset_ok = false
        var i: usize = (*b).n_open
        while i > 0 {
            i = i - 1
            let k: Gc[Node] = (*b).open[i]
            if node.elem_is(k, tag.M_LI) {
                implizit_close(b, tag.M_LI)
                if !node.elem_is(current(b), tag.M_LI) {
                    parse_error(b)
                }
                stack_pop_to_name(b, tag.M_LI)
                break
            }
            let e2: Gc[Elem] = node.node_as_elem(k)
            if e2 != gc_null[Elem]() && is_special(e2.name, e2.ns) &&
                !(e2.name == tag.M_ADDRESS || e2.name == tag.M_DIV || e2.name == tag.M_P) {
                break
            }
        }
        if in_scope(b, tag.M_P, SC_BUTTON) {
            p_close(b)
        }
        let e = try elem_insert_for_token(b, node.NS_HTML)
        return A_FERTIG
    }
    if n == tag.M_DD || n == tag.M_DT {
        (*b).frameset_ok = false
        var i: usize = (*b).n_open
        while i > 0 {
            i = i - 1
            let k: Gc[Node] = (*b).open[i]
            if node.elem_is(k, tag.M_DD) {
                implizit_close(b, tag.M_DD)
                if !node.elem_is(current(b), tag.M_DD) {
                    parse_error(b)
                }
                stack_pop_to_name(b, tag.M_DD)
                break
            }
            if node.elem_is(k, tag.M_DT) {
                implizit_close(b, tag.M_DT)
                if !node.elem_is(current(b), tag.M_DT) {
                    parse_error(b)
                }
                stack_pop_to_name(b, tag.M_DT)
                break
            }
            let e2: Gc[Elem] = node.node_as_elem(k)
            if e2 != gc_null[Elem]() && is_special(e2.name, e2.ns) &&
                !(e2.name == tag.M_ADDRESS || e2.name == tag.M_DIV || e2.name == tag.M_P) {
                break
            }
        }
        if in_scope(b, tag.M_P, SC_BUTTON) {
            p_close(b)
        }
        let e = try elem_insert_for_token(b, node.NS_HTML)
        return A_FERTIG
    }
    if n == tag.M_PLAINTEXT {
        if in_scope(b, tag.M_P, SC_BUTTON) {
            p_close(b)
        }
        let e = try elem_insert_for_token(b, node.NS_HTML)
        (*b).switching = ZST_PLAINTEXT
        (*b).um_pos = token_stream.stream_pos((*b).stream)
        mem.cp_clear(&(*b).um_tag)
        return A_FERTIG
    }
    if n == tag.M_BUTTON {
        if in_scope(b, tag.M_BUTTON, SC_NORMAL) {
            parse_error(b)
            implizit_close(b, 0)
            stack_pop_to_name(b, tag.M_BUTTON)
        }
        let ok: bool = try active_restore(b)
        let e = try elem_insert_for_token(b, node.NS_HTML)
        (*b).frameset_ok = false
        return A_FERTIG
    }
    if n == tag.M_A {
        let idx: i64 = active_last_with_names(b, tag.M_A)
        if idx >= 0 {
            parse_error(b)
            let old: Gc[Node] = (*b).active[idx as usize]
            let r: bool = try adoption_agency(b, tag.M_A)
            active_remove(b, old)
            stack_remove(b, old)
        }
        let ok: bool = try active_restore(b)
        let e = try elem_insert_for_token(b, node.NS_HTML)
        active_push(b, e)
        return A_FERTIG
    }
    if is_formatting(n) && n != tag.M_NOBR {
        let ok: bool = try active_restore(b)
        let e = try elem_insert_for_token(b, node.NS_HTML)
        active_push(b, e)
        return A_FERTIG
    }
    if n == tag.M_NOBR {
        let ok: bool = try active_restore(b)
        if in_scope(b, tag.M_NOBR, SC_NORMAL) {
            parse_error(b)
            let r: bool = try adoption_agency(b, tag.M_NOBR)
            let ok2: bool = try active_restore(b)
        }
        let e = try elem_insert_for_token(b, node.NS_HTML)
        active_push(b, e)
        return A_FERTIG
    }
    if n == tag.M_APPLET || n == tag.M_MARQUEE || n == tag.M_OBJECT {
        let ok: bool = try active_restore(b)
        let e = try elem_insert_for_token(b, node.NS_HTML)
        active_push_mark(b)
        (*b).frameset_ok = false
        return A_FERTIG
    }
    if n == tag.M_TABLE {
        if node.doc_mode((*b).doc) != node.MODUS_QUIRKS &&
            in_scope(b, tag.M_P, SC_BUTTON) {
            p_close(b)
        }
        let e = try elem_insert_for_token(b, node.NS_HTML)
        (*b).frameset_ok = false
        (*b).mode = EM_IN_TABLE
        return A_FERTIG
    }
    if n == tag.M_AREA || n == tag.M_BR || n == tag.M_EMBED || n == tag.M_IMG ||
        n == tag.M_KEYGEN || n == tag.M_WBR {
        let ok: bool = try active_restore(b)
        let ok2: bool = try empty_elem(b)
        (*b).frameset_ok = false
        return A_FERTIG
    }
    if n == tag.M_INPUT {
        let ok: bool = try active_restore(b)
        var lit_hidden: [u8; 6] = "hidden"
        let hidden: bool = tok_type_is(b, &lit_hidden[0], 6)
        let ok2: bool = try empty_elem(b)
        if !hidden {
            (*b).frameset_ok = false
        }
        return A_FERTIG
    }
    if n == tag.M_PARAM || n == tag.M_SOURCE || n == tag.M_TRACK {
        let ok: bool = try empty_elem(b)
        return A_FERTIG
    }
    if n == tag.M_HR {
        if in_scope(b, tag.M_P, SC_BUTTON) {
            p_close(b)
        }
        let ok: bool = try empty_elem(b)
        (*b).frameset_ok = false
        return A_FERTIG
    }
    if n == tag.M_IMAGE {
        // Der Standard sagt woertlich: "Don't ask."
        parse_error(b)
        (*b).tname = tag.M_IMG
        return A_ERNEUT
    }
    if n == tag.M_TEXTAREA {
        let e = try elem_insert_for_token(b, node.NS_HTML)
        (*b).nl_skip = true
        (*b).frameset_ok = false
        (*b).basemode = (*b).mode
        (*b).mode = EM_TEXT
        (*b).switching = ZST_RCDATA
        (*b).um_pos = token_stream.stream_pos((*b).stream)
        mem.cp_clear(&(*b).um_tag)
        names.names_after_cpbuf((*b).names, tag.M_TEXTAREA, &(*b).um_tag)
        return A_FERTIG
    }
    if n == tag.M_XMP {
        if in_scope(b, tag.M_P, SC_BUTTON) {
            p_close(b)
        }
        let ok: bool = try active_restore(b)
        (*b).frameset_ok = false
        let ok2: bool = try raw_text_elem(b, ZST_RAWTEXT)
        return A_FERTIG
    }
    if n == tag.M_IFRAME {
        (*b).frameset_ok = false
        let ok: bool = try raw_text_elem(b, ZST_RAWTEXT)
        return A_FERTIG
    }
    if n == tag.M_NOEMBED {
        let ok: bool = try raw_text_elem(b, ZST_RAWTEXT)
        return A_FERTIG
    }
    if n == tag.M_SELECT {
        let ok: bool = try active_restore(b)
        let e = try elem_insert_for_token(b, node.NS_HTML)
        (*b).frameset_ok = false
        let m: u32 = (*b).mode
        if m == EM_IN_TABLE || m == EM_IN_CAPTION || m == EM_IN_TABLE_BODY ||
            m == EM_IN_ROW || m == EM_IN_CELL {
            (*b).mode = EM_IN_SELECT_IN_TABLE
        } else {
            (*b).mode = EM_IN_SELECT
        }
        return A_FERTIG
    }
    if n == tag.M_OPTGROUP || n == tag.M_OPTION {
        if node.elem_is(current(b), tag.M_OPTION) {
            stack_pop(b)
        }
        let ok: bool = try active_restore(b)
        let e = try elem_insert_for_token(b, node.NS_HTML)
        return A_FERTIG
    }
    if n == tag.M_RB || n == tag.M_RTC {
        if in_scope(b, tag.M_RUBY, SC_NORMAL) {
            implizit_close(b, 0)
        }
        let e = try elem_insert_for_token(b, node.NS_HTML)
        return A_FERTIG
    }
    if n == tag.M_RP || n == tag.M_RT {
        implizit_close(b, tag.M_RTC)
        let e = try elem_insert_for_token(b, node.NS_HTML)
        return A_FERTIG
    }
    if n == tag.M_MATH || n == tag.M_SVG {
        // Runde 54: NUR der Namensraum, nicht der Regelsatz fuer Fremdinhalt
        // (siehe Kopf dieser Datei).
        let ok: bool = try active_restore(b)
        var ns: u32 = node.NS_MATHML
        if n == tag.M_SVG {
            ns = node.NS_SVG
        }
        let e = try elem_insert_for_token(b, ns)
        if tok_self_closing(b) {
            stack_pop(b)
        }
        return A_FERTIG
    }
    if n == tag.M_CAPTION || n == tag.M_COL || n == tag.M_COLGROUP ||
        n == tag.M_FRAME || n == tag.M_HEAD || n == tag.M_TBODY ||
        n == tag.M_TD || n == tag.M_TFOOT || n == tag.M_TH ||
        n == tag.M_THEAD || n == tag.M_TR {
        parse_error(b)
        return A_FERTIG
    }
    let ok: bool = try active_restore(b)
    let e = try elem_insert_for_token(b, node.NS_HTML)
    return A_FERTIG
}

fn in_body_end(b: *mut Tree) -> AllocError!u32 {
    let n: u32 = (*b).tname
    if n == tag.M_BODY || n == tag.M_HTML {
        if !in_scope(b, tag.M_BODY, SC_NORMAL) {
            parse_error(b)
            return A_FERTIG
        }
        (*b).mode = EM_NACH_BODY
        if n == tag.M_HTML {
            return A_ERNEUT
        }
        return A_FERTIG
    }
    if end_block_group(n) {
        if !in_scope(b, n, SC_NORMAL) {
            parse_error(b)
            return A_FERTIG
        }
        implizit_close(b, 0)
        if !node.elem_is(current(b), n) {
            parse_error(b)
        }
        stack_pop_to_name(b, n)
        return A_FERTIG
    }
    if n == tag.M_FORM {
        let f: Gc[Elem] = (*b).form
        (*b).form = gc_null[Elem]()
        if f == gc_null[Elem]() || !node_in_scope(b, f, SC_NORMAL) {
            parse_error(b)
            return A_FERTIG
        }
        implizit_close(b, 0)
        if current(b) != f {
            parse_error(b)
        }
        stack_remove(b, f)
        return A_FERTIG
    }
    if n == tag.M_P {
        if !in_scope(b, tag.M_P, SC_BUTTON) {
            parse_error(b)
            let e = try elem_insert_name(b, tag.M_P)
        }
        p_close(b)
        return A_FERTIG
    }
    if n == tag.M_LI {
        if !in_scope(b, tag.M_LI, SC_LISTE) {
            parse_error(b)
            return A_FERTIG
        }
        implizit_close(b, tag.M_LI)
        if !node.elem_is(current(b), tag.M_LI) {
            parse_error(b)
        }
        stack_pop_to_name(b, tag.M_LI)
        return A_FERTIG
    }
    if n == tag.M_DD || n == tag.M_DT {
        if !in_scope(b, n, SC_NORMAL) {
            parse_error(b)
            return A_FERTIG
        }
        implizit_close(b, n)
        if !node.elem_is(current(b), n) {
            parse_error(b)
        }
        stack_pop_to_name(b, n)
        return A_FERTIG
    }
    if is_heading(n) {
        if !(in_scope(b, tag.M_H1, SC_NORMAL) || in_scope(b, tag.M_H2, SC_NORMAL) ||
             in_scope(b, tag.M_H3, SC_NORMAL) || in_scope(b, tag.M_H4, SC_NORMAL) ||
             in_scope(b, tag.M_H5, SC_NORMAL) || in_scope(b, tag.M_H6, SC_NORMAL)) {
            parse_error(b)
            return A_FERTIG
        }
        implizit_close(b, 0)
        if !node.elem_is(current(b), n) {
            parse_error(b)
        }
        while (*b).n_open > 0 {
            let x: Gc[Node] = stack_pop(b)
            let xe: Gc[Elem] = node.node_as_elem(x)
            if xe != gc_null[Elem]() && xe.ns == node.NS_HTML && is_heading(xe.name) {
                break
            }
        }
        return A_FERTIG
    }
    if is_formatting(n) {
        let next: bool = try adoption_agency(b, n)
        if !next {
            return try end_general(b)
        }
        return A_FERTIG
    }
    if n == tag.M_APPLET || n == tag.M_MARQUEE || n == tag.M_OBJECT {
        if !in_scope(b, n, SC_NORMAL) {
            parse_error(b)
            return A_FERTIG
        }
        implizit_close(b, 0)
        if !node.elem_is(current(b), n) {
            parse_error(b)
        }
        stack_pop_to_name(b, n)
        active_to_mark_clear(b)
        return A_FERTIG
    }
    if n == tag.M_BR {
        parse_error(b)
        let ok: bool = try active_restore(b)
        let ok2: bool = try empty_elem(b)
        (*b).frameset_ok = false
        return A_FERTIG
    }
    if n == tag.M_TEMPLATE {
        return try m_in_head(b)
    }
    return try end_general(b)
}

fn m_in_body(b: *mut Tree) -> AllocError!u32 {
    let kind: u32 = token_stream.stream_kind((*b).stream)
    if kind == tokens.TB_COMMENT {
        let ok: bool = try comment_insert(b, gc_null[Node]())
        return A_FERTIG
    }
    if kind == tokens.TB_DOCTYPE {
        parse_error(b)
        return A_FERTIG
    }
    if kind == tokens.TB_START {
        return try in_body_start(b)
    }
    return try in_body_end(b)
}

// --------------------------------------------------------------- "text"

fn m_text(b: *mut Tree) -> AllocError!u32 {
    // In diesem Modus kommen nur Zeichen und der passende Endtag an.
    stack_pop(b)
    (*b).mode = (*b).basemode
    return A_FERTIG
}

// ------------------------------------------------------------ "in table"

fn table_else(b: *mut Tree) -> AllocError!u32 {
    parse_error(b)
    (*b).foster = true
    let r: u32 = try m_in_body(b)
    (*b).foster = false
    return r
}

fn m_in_table(b: *mut Tree) -> AllocError!u32 {
    let kind: u32 = token_stream.stream_kind((*b).stream)
    let n: u32 = (*b).tname
    if kind == tokens.TB_COMMENT {
        let ok: bool = try comment_insert(b, gc_null[Node]())
        return A_FERTIG
    }
    if kind == tokens.TB_DOCTYPE {
        parse_error(b)
        return A_FERTIG
    }
    if kind == tokens.TB_START {
        if n == tag.M_CAPTION {
            stack_to_table_context(b)
            active_push_mark(b)
            let e = try elem_insert_for_token(b, node.NS_HTML)
            (*b).mode = EM_IN_CAPTION
            return A_FERTIG
        }
        if n == tag.M_COLGROUP {
            stack_to_table_context(b)
            let e = try elem_insert_for_token(b, node.NS_HTML)
            (*b).mode = EM_IN_COLGROUP
            return A_FERTIG
        }
        if n == tag.M_COL {
            stack_to_table_context(b)
            let e = try elem_insert_name(b, tag.M_COLGROUP)
            (*b).mode = EM_IN_COLGROUP
            return A_ERNEUT
        }
        if n == tag.M_TBODY || n == tag.M_TFOOT || n == tag.M_THEAD {
            stack_to_table_context(b)
            let e = try elem_insert_for_token(b, node.NS_HTML)
            (*b).mode = EM_IN_TABLE_BODY
            return A_FERTIG
        }
        if n == tag.M_TD || n == tag.M_TH || n == tag.M_TR {
            stack_to_table_context(b)
            let e = try elem_insert_name(b, tag.M_TBODY)
            (*b).mode = EM_IN_TABLE_BODY
            return A_ERNEUT
        }
        if n == tag.M_TABLE {
            parse_error(b)
            if !in_scope(b, tag.M_TABLE, SC_TABELLE) {
                return A_FERTIG
            }
            stack_pop_to_name(b, tag.M_TABLE)
            insert_mode_reset(b)
            return A_ERNEUT
        }
        if n == tag.M_STYLE || n == tag.M_SCRIPT || n == tag.M_TEMPLATE {
            return try m_in_head(b)
        }
        if n == tag.M_INPUT {
            var lit_hidden: [u8; 6] = "hidden"
            if has_type_attr(b) && tok_type_is(b, &lit_hidden[0], 6) {
                parse_error(b)
                let ok: bool = try empty_elem(b)
                return A_FERTIG
            }
            return try table_else(b)
        }
        if n == tag.M_FORM {
            parse_error(b)
            if (*b).form != gc_null[Elem]() {
                return A_FERTIG
            }
            let e = try elem_insert_for_token(b, node.NS_HTML)
            (*b).form = e
            stack_pop(b)
            return A_FERTIG
        }
    }
    if kind == tokens.TB_END {
        if n == tag.M_TABLE {
            if !in_scope(b, tag.M_TABLE, SC_TABELLE) {
                parse_error(b)
                return A_FERTIG
            }
            stack_pop_to_name(b, tag.M_TABLE)
            insert_mode_reset(b)
            return A_FERTIG
        }
        if n == tag.M_BODY || n == tag.M_CAPTION || n == tag.M_COL ||
            n == tag.M_COLGROUP || n == tag.M_HTML || n == tag.M_TBODY ||
            n == tag.M_TD || n == tag.M_TFOOT || n == tag.M_TH ||
            n == tag.M_THEAD || n == tag.M_TR {
            parse_error(b)
            return A_FERTIG
        }
        if n == tag.M_TEMPLATE {
            return try m_in_head(b)
        }
    }
    return try table_else(b)
}

// ---------------------------------------------------------- "in caption"

fn caption_close(b: *mut Tree) -> u32 {
    if !in_scope(b, tag.M_CAPTION, SC_TABELLE) {
        parse_error(b)
        return A_FERTIG
    }
    implizit_close(b, 0)
    if !node.elem_is(current(b), tag.M_CAPTION) {
        parse_error(b)
    }
    stack_pop_to_name(b, tag.M_CAPTION)
    active_to_mark_clear(b)
    (*b).mode = EM_IN_TABLE
    return A_ERNEUT
}

fn m_in_caption(b: *mut Tree) -> AllocError!u32 {
    let kind: u32 = token_stream.stream_kind((*b).stream)
    let n: u32 = (*b).tname
    if kind == tokens.TB_END && n == tag.M_CAPTION {
        let r: u32 = caption_close(b)
        if r == A_ERNEUT {
            return A_FERTIG
        }
        return A_FERTIG
    }
    if kind == tokens.TB_START {
        if n == tag.M_CAPTION || n == tag.M_COL || n == tag.M_COLGROUP ||
            n == tag.M_TBODY || n == tag.M_TD || n == tag.M_TFOOT ||
            n == tag.M_TH || n == tag.M_THEAD || n == tag.M_TR {
            parse_error(b)
            return caption_close(b)
        }
    }
    if kind == tokens.TB_END {
        if n == tag.M_TABLE {
            parse_error(b)
            return caption_close(b)
        }
        if n == tag.M_BODY || n == tag.M_COL || n == tag.M_COLGROUP ||
            n == tag.M_HTML || n == tag.M_TBODY || n == tag.M_TD ||
            n == tag.M_TFOOT || n == tag.M_TH || n == tag.M_THEAD ||
            n == tag.M_TR {
            parse_error(b)
            return A_FERTIG
        }
    }
    return try m_in_body(b)
}

// ------------------------------------------------------ "in column group"

fn m_in_colgroup(b: *mut Tree) -> AllocError!u32 {
    let kind: u32 = token_stream.stream_kind((*b).stream)
    let n: u32 = (*b).tname
    if kind == tokens.TB_COMMENT {
        let ok: bool = try comment_insert(b, gc_null[Node]())
        return A_FERTIG
    }
    if kind == tokens.TB_DOCTYPE {
        parse_error(b)
        return A_FERTIG
    }
    if kind == tokens.TB_START {
        if n == tag.M_HTML {
            return try m_in_body(b)
        }
        if n == tag.M_COL {
            let ok: bool = try empty_elem(b)
            return A_FERTIG
        }
        if n == tag.M_TEMPLATE {
            return try m_in_head(b)
        }
    }
    if kind == tokens.TB_END {
        if n == tag.M_COLGROUP {
            if !node.elem_is(current(b), tag.M_COLGROUP) {
                parse_error(b)
                return A_FERTIG
            }
            stack_pop(b)
            (*b).mode = EM_IN_TABLE
            return A_FERTIG
        }
        if n == tag.M_COL {
            parse_error(b)
            return A_FERTIG
        }
        if n == tag.M_TEMPLATE {
            return try m_in_head(b)
        }
    }
    if !node.elem_is(current(b), tag.M_COLGROUP) {
        parse_error(b)
        return A_FERTIG
    }
    stack_pop(b)
    (*b).mode = EM_IN_TABLE
    return A_ERNEUT
}

// ------------------------------------------------------- "in table body"

fn m_in_table_body(b: *mut Tree) -> AllocError!u32 {
    let kind: u32 = token_stream.stream_kind((*b).stream)
    let n: u32 = (*b).tname
    if kind == tokens.TB_START {
        if n == tag.M_TR {
            stack_to_body_context(b)
            let e = try elem_insert_for_token(b, node.NS_HTML)
            (*b).mode = EM_IN_ROW
            return A_FERTIG
        }
        if n == tag.M_TD || n == tag.M_TH {
            parse_error(b)
            stack_to_body_context(b)
            let e = try elem_insert_name(b, tag.M_TR)
            (*b).mode = EM_IN_ROW
            return A_ERNEUT
        }
        if n == tag.M_CAPTION || n == tag.M_COL || n == tag.M_COLGROUP ||
            n == tag.M_TBODY || n == tag.M_TFOOT || n == tag.M_THEAD {
            if !(in_scope(b, tag.M_TBODY, SC_TABELLE) ||
                 in_scope(b, tag.M_THEAD, SC_TABELLE) ||
                 in_scope(b, tag.M_TFOOT, SC_TABELLE)) {
                parse_error(b)
                return A_FERTIG
            }
            stack_to_body_context(b)
            stack_pop(b)
            (*b).mode = EM_IN_TABLE
            return A_ERNEUT
        }
    }
    if kind == tokens.TB_END {
        if n == tag.M_TBODY || n == tag.M_TFOOT || n == tag.M_THEAD {
            if !in_scope(b, n, SC_TABELLE) {
                parse_error(b)
                return A_FERTIG
            }
            stack_to_body_context(b)
            stack_pop(b)
            (*b).mode = EM_IN_TABLE
            return A_FERTIG
        }
        if n == tag.M_TABLE {
            if !(in_scope(b, tag.M_TBODY, SC_TABELLE) ||
                 in_scope(b, tag.M_THEAD, SC_TABELLE) ||
                 in_scope(b, tag.M_TFOOT, SC_TABELLE)) {
                parse_error(b)
                return A_FERTIG
            }
            stack_to_body_context(b)
            stack_pop(b)
            (*b).mode = EM_IN_TABLE
            return A_ERNEUT
        }
        if n == tag.M_BODY || n == tag.M_CAPTION || n == tag.M_COL ||
            n == tag.M_COLGROUP || n == tag.M_HTML || n == tag.M_TD ||
            n == tag.M_TH || n == tag.M_TR {
            parse_error(b)
            return A_FERTIG
        }
    }
    return try m_in_table(b)
}

// ------------------------------------------------------------- "in row"

fn m_in_row(b: *mut Tree) -> AllocError!u32 {
    let kind: u32 = token_stream.stream_kind((*b).stream)
    let n: u32 = (*b).tname
    if kind == tokens.TB_START {
        if n == tag.M_TD || n == tag.M_TH {
            stack_to_line_context(b)
            let e = try elem_insert_for_token(b, node.NS_HTML)
            (*b).mode = EM_IN_CELL
            active_push_mark(b)
            return A_FERTIG
        }
        if n == tag.M_CAPTION || n == tag.M_COL || n == tag.M_COLGROUP ||
            n == tag.M_TBODY || n == tag.M_TFOOT || n == tag.M_THEAD ||
            n == tag.M_TR {
            if !in_scope(b, tag.M_TR, SC_TABELLE) {
                parse_error(b)
                return A_FERTIG
            }
            stack_to_line_context(b)
            stack_pop(b)
            (*b).mode = EM_IN_TABLE_BODY
            return A_ERNEUT
        }
    }
    if kind == tokens.TB_END {
        if n == tag.M_TR {
            if !in_scope(b, tag.M_TR, SC_TABELLE) {
                parse_error(b)
                return A_FERTIG
            }
            stack_to_line_context(b)
            stack_pop(b)
            (*b).mode = EM_IN_TABLE_BODY
            return A_FERTIG
        }
        if n == tag.M_TABLE {
            if !in_scope(b, tag.M_TR, SC_TABELLE) {
                parse_error(b)
                return A_FERTIG
            }
            stack_to_line_context(b)
            stack_pop(b)
            (*b).mode = EM_IN_TABLE_BODY
            return A_ERNEUT
        }
        if n == tag.M_TBODY || n == tag.M_TFOOT || n == tag.M_THEAD {
            if !in_scope(b, n, SC_TABELLE) {
                parse_error(b)
                return A_FERTIG
            }
            if !in_scope(b, tag.M_TR, SC_TABELLE) {
                return A_FERTIG
            }
            stack_to_line_context(b)
            stack_pop(b)
            (*b).mode = EM_IN_TABLE_BODY
            return A_ERNEUT
        }
        if n == tag.M_BODY || n == tag.M_CAPTION || n == tag.M_COL ||
            n == tag.M_COLGROUP || n == tag.M_HTML || n == tag.M_TD ||
            n == tag.M_TH {
            parse_error(b)
            return A_FERTIG
        }
    }
    return try m_in_table(b)
}

// ------------------------------------------------------------ "in cell"

fn m_in_cell(b: *mut Tree) -> AllocError!u32 {
    let kind: u32 = token_stream.stream_kind((*b).stream)
    let n: u32 = (*b).tname
    if kind == tokens.TB_END {
        if n == tag.M_TD || n == tag.M_TH {
            if !in_scope(b, n, SC_TABELLE) {
                parse_error(b)
                return A_FERTIG
            }
            implizit_close(b, 0)
            if !node.elem_is(current(b), n) {
                parse_error(b)
            }
            stack_pop_to_name(b, n)
            active_to_mark_clear(b)
            (*b).mode = EM_IN_ROW
            return A_FERTIG
        }
        if n == tag.M_BODY || n == tag.M_CAPTION || n == tag.M_COL ||
            n == tag.M_COLGROUP || n == tag.M_HTML {
            parse_error(b)
            return A_FERTIG
        }
        if n == tag.M_TABLE || n == tag.M_TBODY || n == tag.M_TFOOT ||
            n == tag.M_THEAD || n == tag.M_TR {
            if !in_scope(b, n, SC_TABELLE) {
                parse_error(b)
                return A_FERTIG
            }
            cell_close(b)
            return A_ERNEUT
        }
    }
    if kind == tokens.TB_START {
        if n == tag.M_CAPTION || n == tag.M_COL || n == tag.M_COLGROUP ||
            n == tag.M_TBODY || n == tag.M_TD || n == tag.M_TFOOT ||
            n == tag.M_TH || n == tag.M_THEAD || n == tag.M_TR {
            if !cell_in_table_scope(b) {
                parse_error(b)
                return A_FERTIG
            }
            cell_close(b)
            return A_ERNEUT
        }
    }
    return try m_in_body(b)
}

// ---------------------------------------------------------- "in select"

fn m_in_select(b: *mut Tree) -> AllocError!u32 {
    let kind: u32 = token_stream.stream_kind((*b).stream)
    let n: u32 = (*b).tname
    if kind == tokens.TB_COMMENT {
        let ok: bool = try comment_insert(b, gc_null[Node]())
        return A_FERTIG
    }
    if kind == tokens.TB_DOCTYPE {
        parse_error(b)
        return A_FERTIG
    }
    if kind == tokens.TB_START {
        if n == tag.M_HTML {
            return try m_in_body(b)
        }
        if n == tag.M_OPTION {
            if node.elem_is(current(b), tag.M_OPTION) {
                stack_pop(b)
            }
            let e = try elem_insert_for_token(b, node.NS_HTML)
            return A_FERTIG
        }
        if n == tag.M_OPTGROUP {
            if node.elem_is(current(b), tag.M_OPTION) {
                stack_pop(b)
            }
            if node.elem_is(current(b), tag.M_OPTGROUP) {
                stack_pop(b)
            }
            let e = try elem_insert_for_token(b, node.NS_HTML)
            return A_FERTIG
        }
        if n == tag.M_HR {
            if node.elem_is(current(b), tag.M_OPTION) {
                stack_pop(b)
            }
            if node.elem_is(current(b), tag.M_OPTGROUP) {
                stack_pop(b)
            }
            let ok: bool = try empty_elem(b)
            return A_FERTIG
        }
        if n == tag.M_SELECT {
            parse_error(b)
            if !in_scope(b, tag.M_SELECT, SC_SELECT) {
                return A_FERTIG
            }
            stack_pop_to_name(b, tag.M_SELECT)
            insert_mode_reset(b)
            return A_FERTIG
        }
        if n == tag.M_INPUT || n == tag.M_KEYGEN || n == tag.M_TEXTAREA {
            parse_error(b)
            if !in_scope(b, tag.M_SELECT, SC_SELECT) {
                return A_FERTIG
            }
            stack_pop_to_name(b, tag.M_SELECT)
            insert_mode_reset(b)
            return A_ERNEUT
        }
        if n == tag.M_SCRIPT || n == tag.M_TEMPLATE {
            return try m_in_head(b)
        }
    }
    if kind == tokens.TB_END {
        if n == tag.M_OPTGROUP {
            if node.elem_is(current(b), tag.M_OPTION) && (*b).n_open >= 2 &&
                node.elem_is((*b).open[(*b).n_open - 2], tag.M_OPTGROUP) {
                stack_pop(b)
            }
            if node.elem_is(current(b), tag.M_OPTGROUP) {
                stack_pop(b)
            } else {
                parse_error(b)
            }
            return A_FERTIG
        }
        if n == tag.M_OPTION {
            if node.elem_is(current(b), tag.M_OPTION) {
                stack_pop(b)
            } else {
                parse_error(b)
            }
            return A_FERTIG
        }
        if n == tag.M_SELECT {
            if !in_scope(b, tag.M_SELECT, SC_SELECT) {
                parse_error(b)
                return A_FERTIG
            }
            stack_pop_to_name(b, tag.M_SELECT)
            insert_mode_reset(b)
            return A_FERTIG
        }
        if n == tag.M_TEMPLATE {
            return try m_in_head(b)
        }
    }
    parse_error(b)
    return A_FERTIG
}

fn m_in_select_in_table(b: *mut Tree) -> AllocError!u32 {
    let kind: u32 = token_stream.stream_kind((*b).stream)
    let n: u32 = (*b).tname
    let affected: bool = n == tag.M_CAPTION || n == tag.M_TABLE || n == tag.M_TBODY ||
        n == tag.M_TFOOT || n == tag.M_THEAD || n == tag.M_TR || n == tag.M_TD ||
        n == tag.M_TH
    if kind == tokens.TB_START && affected {
        parse_error(b)
        stack_pop_to_name(b, tag.M_SELECT)
        insert_mode_reset(b)
        return A_ERNEUT
    }
    if kind == tokens.TB_END && affected {
        parse_error(b)
        if !in_scope(b, n, SC_TABELLE) {
            return A_FERTIG
        }
        stack_pop_to_name(b, tag.M_SELECT)
        insert_mode_reset(b)
        return A_ERNEUT
    }
    return try m_in_select(b)
}

// --------------------------------------------------------- "after body" …

fn m_after_body(b: *mut Tree) -> AllocError!u32 {
    let kind: u32 = token_stream.stream_kind((*b).stream)
    let n: u32 = (*b).tname
    if kind == tokens.TB_COMMENT {
        var target: Gc[Node] = gc_null[Node]()
        if (*b).n_open > 0 {
            target = (*b).open[0]
        }
        let ok: bool = try comment_insert(b, target)
        return A_FERTIG
    }
    if kind == tokens.TB_DOCTYPE {
        parse_error(b)
        return A_FERTIG
    }
    if kind == tokens.TB_START && n == tag.M_HTML {
        return try m_in_body(b)
    }
    if kind == tokens.TB_END && n == tag.M_HTML {
        (*b).mode = EM_NACH_NACH_BODY
        return A_FERTIG
    }
    parse_error(b)
    (*b).mode = EM_IN_BODY
    return A_ERNEUT
}

fn m_in_frameset(b: *mut Tree) -> AllocError!u32 {
    let kind: u32 = token_stream.stream_kind((*b).stream)
    let n: u32 = (*b).tname
    if kind == tokens.TB_COMMENT {
        let ok: bool = try comment_insert(b, gc_null[Node]())
        return A_FERTIG
    }
    if kind == tokens.TB_DOCTYPE {
        parse_error(b)
        return A_FERTIG
    }
    if kind == tokens.TB_START {
        if n == tag.M_HTML {
            return try m_in_body(b)
        }
        if n == tag.M_FRAMESET {
            let e = try elem_insert_for_token(b, node.NS_HTML)
            return A_FERTIG
        }
        if n == tag.M_FRAME {
            let ok: bool = try empty_elem(b)
            return A_FERTIG
        }
        if n == tag.M_NOFRAMES {
            return try m_in_head(b)
        }
    }
    if kind == tokens.TB_END && n == tag.M_FRAMESET {
        if node.elem_is(current(b), tag.M_HTML) {
            parse_error(b)
            return A_FERTIG
        }
        stack_pop(b)
        if !node.elem_is(current(b), tag.M_FRAMESET) {
            (*b).mode = EM_NACH_FRAMESET
        }
        return A_FERTIG
    }
    parse_error(b)
    return A_FERTIG
}

fn m_after_frameset(b: *mut Tree) -> AllocError!u32 {
    let kind: u32 = token_stream.stream_kind((*b).stream)
    let n: u32 = (*b).tname
    if kind == tokens.TB_COMMENT {
        let ok: bool = try comment_insert(b, gc_null[Node]())
        return A_FERTIG
    }
    if kind == tokens.TB_DOCTYPE {
        parse_error(b)
        return A_FERTIG
    }
    if kind == tokens.TB_START && n == tag.M_HTML {
        return try m_in_body(b)
    }
    if kind == tokens.TB_END && n == tag.M_HTML {
        (*b).mode = EM_NACH_NACH_FRAMESET
        return A_FERTIG
    }
    if kind == tokens.TB_START && n == tag.M_NOFRAMES {
        return try m_in_head(b)
    }
    parse_error(b)
    return A_FERTIG
}

fn m_after_after_body(b: *mut Tree) -> AllocError!u32 {
    let kind: u32 = token_stream.stream_kind((*b).stream)
    let n: u32 = (*b).tname
    if kind == tokens.TB_COMMENT {
        let ok: bool = try comment_insert(b, (*b).doc)
        return A_FERTIG
    }
    if kind == tokens.TB_DOCTYPE {
        return try m_in_body(b)
    }
    if kind == tokens.TB_START && n == tag.M_HTML {
        return try m_in_body(b)
    }
    parse_error(b)
    (*b).mode = EM_IN_BODY
    return A_ERNEUT
}

fn m_after_after_frameset(b: *mut Tree) -> AllocError!u32 {
    let kind: u32 = token_stream.stream_kind((*b).stream)
    let n: u32 = (*b).tname
    if kind == tokens.TB_COMMENT {
        let ok: bool = try comment_insert(b, (*b).doc)
        return A_FERTIG
    }
    if kind == tokens.TB_DOCTYPE {
        return try m_in_body(b)
    }
    if kind == tokens.TB_START && n == tag.M_HTML {
        return try m_in_body(b)
    }
    if kind == tokens.TB_START && n == tag.M_NOFRAMES {
        return try m_in_head(b)
    }
    parse_error(b)
    return A_FERTIG
}

// ------------------------------------------------------------ Verteiler

fn mark_mode(b: *mut Tree) -> AllocError!u32 {
    let m: u32 = (*b).mode
    if m == EM_INITIAL {
        return try m_initial(b)
    }
    if m == EM_VOR_HTML {
        return try m_before_html(b)
    }
    if m == EM_VOR_HEAD {
        return try m_before_head(b)
    }
    if m == EM_IN_HEAD {
        return try m_in_head(b)
    }
    if m == EM_IN_HEAD_NOSCRIPT {
        return try m_in_head_noscript(b)
    }
    if m == EM_NACH_HEAD {
        return try m_after_head(b)
    }
    if m == EM_IN_BODY {
        return try m_in_body(b)
    }
    if m == EM_TEXT {
        return try m_text(b)
    }
    if m == EM_IN_TABLE {
        return try m_in_table(b)
    }
    if m == EM_IN_TABLE_TEXT {
        let ok: bool = try tt_flush(b)
        return A_ERNEUT
    }
    if m == EM_IN_CAPTION {
        return try m_in_caption(b)
    }
    if m == EM_IN_COLGROUP {
        return try m_in_colgroup(b)
    }
    if m == EM_IN_TABLE_BODY {
        return try m_in_table_body(b)
    }
    if m == EM_IN_ROW {
        return try m_in_row(b)
    }
    if m == EM_IN_CELL {
        return try m_in_cell(b)
    }
    if m == EM_IN_SELECT {
        return try m_in_select(b)
    }
    if m == EM_IN_SELECT_IN_TABLE {
        return try m_in_select_in_table(b)
    }
    if m == EM_NACH_BODY {
        return try m_after_body(b)
    }
    if m == EM_IN_FRAMESET {
        return try m_in_frameset(b)
    }
    if m == EM_NACH_FRAMESET {
        return try m_after_frameset(b)
    }
    if m == EM_NACH_NACH_BODY {
        return try m_after_after_body(b)
    }
    return try m_after_after_frameset(b)
}

// EOF: der Standard behandelt es je Modus. Alles, was nicht ausdruecklich
// etwas anderes tut, laeuft in "stop parsing".
fn eof_mode(b: *mut Tree) -> AllocError!u32 {
    let m: u32 = (*b).mode
    if m == EM_INITIAL {
        parse_error(b)
        node.doc_mode_set((*b).doc, node.MODUS_QUIRKS)
        (*b).mode = EM_VOR_HTML
        return A_ERNEUT
    }
    if m == EM_VOR_HTML {
        let e = try node.elem_new(tag.M_HTML, node.NS_HTML)
        node.append_child((*b).doc, e)
        stack_push(b, e)
        (*b).mode = EM_VOR_HEAD
        return A_ERNEUT
    }
    if m == EM_VOR_HEAD {
        let e = try elem_insert_name(b, tag.M_HEAD)
        (*b).header = e
        (*b).mode = EM_IN_HEAD
        return A_ERNEUT
    }
    if m == EM_IN_HEAD {
        stack_pop(b)
        (*b).mode = EM_NACH_HEAD
        return A_ERNEUT
    }
    if m == EM_IN_HEAD_NOSCRIPT {
        parse_error(b)
        stack_pop(b)
        (*b).mode = EM_IN_HEAD
        return A_ERNEUT
    }
    if m == EM_NACH_HEAD {
        let e = try elem_insert_name(b, tag.M_BODY)
        (*b).mode = EM_IN_BODY
        return A_ERNEUT
    }
    if m == EM_TEXT {
        parse_error(b)
        stack_pop(b)
        (*b).mode = (*b).basemode
        return A_ERNEUT
    }
    if m == EM_IN_TABLE_TEXT {
        let ok: bool = try tt_flush(b)
        return A_ERNEUT
    }
    if m == EM_IN_CAPTION || m == EM_IN_CELL {
        return A_FERTIG
    }
    if m == EM_IN_COLGROUP {
        if !node.elem_is(current(b), tag.M_COLGROUP) {
            return A_FERTIG
        }
        stack_pop(b)
        (*b).mode = EM_IN_TABLE
        return A_ERNEUT
    }
    return A_FERTIG
}

// ===========================================================================
//                       EINSTIEG: EIN TOKEN
// ===========================================================================

fn tname_read(b: *mut Tree) {
    let st: *mut token_stream.Stream = (*b).stream
    let off: usize = token_stream.stream_name(st)
    let n: usize = token_stream.chain_length(st, off)
    mem.cp_clear(&(*b).help)
    var i: usize = 0
    while i < n {
        mem.cp_push(&(*b).help, token_stream.chain_cp(st, off, i))
        i = i + 1
    }
    (*b).tname = names.names_of_cp((*b).names, &(*b).help)
}

// Die Schleife hinter "reprocess the token": ein Modus darf das Token an den
// naechsten weiterreichen. 64 Runden sind grosszuegig — der Standard braucht
// nie mehr als eine Handvoll; mehr waere ein Fehler in diesem Code und soll
// SICHTBAR abbrechen statt zu haengen.
fn process_char(b: *mut Tree, cp: u32) -> bool {
    var round: u32 = 0
    while round < 64 as u32 {
        round = round + 1
        let r: u32 = char_mode(b, cp) catch A_AUS
        if r == A_AUS {
            (*b).broken = 3
            return false
        }
        if r == A_FERTIG {
            return true
        }
    }
    (*b).broken = 4
    return false
}

fn process_mark(b: *mut Tree) -> bool {
    var round: u32 = 0
    while round < 64 as u32 {
        round = round + 1
        let r: u32 = mark_mode(b) catch A_AUS
        if r == A_AUS {
            (*b).broken = 3
            return false
        }
        if r == A_FERTIG {
            return true
        }
    }
    (*b).broken = 4
    return false
}

// Verarbeitet den Satz, auf dem der Strom gerade steht.
fn tree_token(b: *mut Tree) -> bool {
    let st: *mut token_stream.Stream = (*b).stream
    let kind: u32 = token_stream.stream_kind(st)
    if kind == tokens.TB_CHARACTER {
        let off: usize = token_stream.stream_data(st)
        let n: usize = token_stream.chain_length(st, off)
        var i: usize = 0
        if (*b).nl_skip {
            (*b).nl_skip = false
            if n > 0 && token_stream.chain_cp(st, off, 0) == 10 as u32 {
                i = 1
            }
        }
        while i < n {
            if !process_char(b, token_stream.chain_cp(st, off, i)) {
                return false
            }
            i = i + 1
        }
        return true
    }
    (*b).nl_skip = false
    (*b).tname = 0
    if kind == tokens.TB_START || kind == tokens.TB_END {
        tname_read(b)
        if (*b).tname == 0 as u32 {
            (*b).broken = 3
            return false
        }
    }
    return process_mark(b)
}

// Das Ende der Eingabe ("stop parsing"). Danach steht der Baum.
fn tree_eof(b: *mut Tree) -> bool {
    var round: u32 = 0
    while round < 64 as u32 {
        round = round + 1
        let r: u32 = eof_mode(b) catch A_AUS
        if r == A_AUS {
            (*b).broken = 3
            return false
        }
        if r == A_FERTIG {
            return true
        }
    }
    (*b).broken = 4
    return false
}
