// lib/browser/token_stream.fi — Leser des binaeren Tokenprotokolls.
//
// Gegenstueck zu `tb_*` in lib/html/tokens.fi. Der Tokenizer schreibt seine
// Token als Datensaetze in einen Bytepuffer, dieser Leser laeuft sie ab.
//
// WARUM EIN PUFFER UND KEIN RUECKRUF: der Tokenizer ist vollstaendig
// `#[no_gc]` (SPEC §3.5.4) — er darf keine Funktion aufrufen, die GC-Speicher
// anfordert. Der Baumaufbau tut genau das (jeder Knoten ist ein GC-Objekt).
// Zwischen beiden MUSS also etwas stehen, das keine Zeiger auf GC-Objekte
// kennt. Das ist dieser Puffer.
//
// Der Leser haelt nur Offsets in den Puffer; er kopiert nichts. Alle
// Zugriffe gehen ueber `kette_*`, damit der Baumaufbau die Zeichen direkt in
// eine GC-Kette schaufeln kann, ohne Zwischenpuffer.

import html.mem
import html.tokens

export {
    Stream,
    stream_new, stream_set, stream_next, stream_am_end,
    stream_kind, stream_flags, stream_pos, stream_nattr,
    stream_name, stream_attr_first, stream_data,
    stream_doctype_pubid, stream_doctype_sysid,
    chain_length, chain_cp, chain_end,
    stream_back,
}

struct Stream {
    p: *mut u8,
    n: usize,
    i: usize,          // naechster ungelesener Byte-Offset
    set: usize,       // Anfang des AKTUELLEN Satzes
    kind: u32,
    flags: u32,
    pos: usize,
    nattr: u32,
}

#[no_gc]
fn stream_new() -> Stream {
    return Stream{
        p: 0 as *mut u8,
        n: 0,
        i: 0,
        set: 0,
        kind: 0,
        flags: 0,
        pos: 0,
        nattr: 0,
    }
}

#[no_gc]
fn stream_set(s: *mut Stream, p: *mut u8, n: usize) {
    (*s).p = p
    (*s).n = n
    (*s).i = 0
    (*s).set = 0
    (*s).kind = 0
    (*s).flags = 0
    (*s).pos = 0
    (*s).nattr = 0
}

#[no_gc]
fn u32_at(s: *mut Stream, off: usize) -> u32 {
    if off + 4 > (*s).n {
        return 0
    }
    let b: u64 = (*s).p as u64 + off as u64
    return (*(b as *mut u8)) as u32 |
        (((*((b + 1) as *mut u8)) as u32) << 8) |
        (((*((b + 2) as *mut u8)) as u32) << 16) |
        (((*((b + 3) as *mut u8)) as u32) << 24)
}

// Laenge der Kette, die bei `off` beginnt (in Codepunkten).
#[no_gc]
fn chain_length(s: *mut Stream, off: usize) -> usize {
    return u32_at(s, off) as usize
}

// Codepunkt `i` der Kette bei `off`.
#[no_gc]
fn chain_cp(s: *mut Stream, off: usize, i: usize) -> u32 {
    return u32_at(s, off + 4 + i * 4)
}

// Offset direkt HINTER der Kette bei `off` — so laeuft man Attributpaare ab.
#[no_gc]
fn chain_end(s: *mut Stream, off: usize) -> usize {
    return off + 4 + chain_length(s, off) * 4
}

#[no_gc]
fn stream_am_end(s: *mut Stream) -> bool {
    return (*s).i >= (*s).n
}

// Liest den naechsten Satz. `false` = Strom zu Ende.
#[no_gc]
fn stream_next(s: *mut Stream) -> bool {
    if (*s).i + 16 > (*s).n {
        return false
    }
    (*s).set = (*s).i
    (*s).kind = u32_at(s, (*s).i)
    (*s).flags = u32_at(s, (*s).i + 4)
    (*s).pos = u32_at(s, (*s).i + 8) as usize
    (*s).nattr = u32_at(s, (*s).i + 12)
    var off: usize = (*s).i + 16
    if (*s).kind == tokens.TB_START {
        off = chain_end(s, off)
        var k: u32 = 0
        while k < (*s).nattr {
            off = chain_end(s, off)
            off = chain_end(s, off)
            k = k + 1
        }
    } else if (*s).kind == tokens.TB_DOCTYPE {
        off = chain_end(s, off)
        off = chain_end(s, off)
        off = chain_end(s, off)
    } else {
        off = chain_end(s, off)
    }
    (*s).i = off
    return true
}

// Setzt den Leser auf den Anfang des zuletzt gelesenen Satzes zurueck. Das
// braucht der Baumaufbau, wenn ein Token in einem anderen Einfuegemodus
// ERNEUT verarbeitet werden muss ("reprocess the token") und der Modus
// zwischendurch den Strom nicht weiterschieben darf.
#[no_gc]
fn stream_back(s: *mut Stream) {
    (*s).i = (*s).set
}

#[no_gc]
fn stream_kind(s: *mut Stream) -> u32 {
    return (*s).kind
}

#[no_gc]
fn stream_flags(s: *mut Stream) -> u32 {
    return (*s).flags
}

#[no_gc]
fn stream_pos(s: *mut Stream) -> usize {
    return (*s).pos
}

#[no_gc]
fn stream_nattr(s: *mut Stream) -> u32 {
    return (*s).nattr
}

// Offset der Namenskette des aktuellen Satzes (Start-/Endtag, DOCTYPE).
#[no_gc]
fn stream_name(s: *mut Stream) -> usize {
    return (*s).set + 16
}

// Offset der ersten Attributkette (Name des ersten Attributs).
#[no_gc]
fn stream_attr_first(s: *mut Stream) -> usize {
    return chain_end(s, (*s).set + 16)
}

// Offset der Datenkette (Kommentar, Zeichen).
#[no_gc]
fn stream_data(s: *mut Stream) -> usize {
    return (*s).set + 16
}

#[no_gc]
fn stream_doctype_pubid(s: *mut Stream) -> usize {
    return chain_end(s, (*s).set + 16)
}

#[no_gc]
fn stream_doctype_sysid(s: *mut Stream) -> usize {
    return chain_end(s, chain_end(s, (*s).set + 16))
}
