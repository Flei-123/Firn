// lib/browser/treiber.fi — Tokenizer + Baumaufbau zu EINEM Weg verbunden.
//
// Ein `Lauf` haelt alles, was ein Zerleger braucht: die Atomtabelle, den
// Tokenizer-Sink, den Protokolleser und den Baumzustand. Er wird EINMAL
// angelegt und fuer beliebig viele Dokumente wiederverwendet.
//
// WICHTIG — WO EIN `Lauf` LIEGEN MUSS: im RAHMEN des Aufrufers, als `var`.
// Er enthaelt `Gc[…]`-Felder (im `Baum`), und der Stapelscan des Sammlers ist
// konservativ (SPEC §3.5.3): auf dem Stapel findet er sie ohne jede
// Anmeldung, auf der Halde (mem.heap_alloc) NICHT. Ein `Lauf` auf der Halde
// muesste mit `gc_wurzel_anmelden` angemeldet werden.
//
// DIE RUECKKOPPLUNG AUF DEN TOKENIZER, offen benannt:
// `lib/html/tokenizer.fi` ist eine EINMAL durchlaufende Schleife — sie laesst
// sich nicht anhalten und fortsetzen. Der Baumaufbau muss den Tokenizer aber
// umschalten koennen, sobald `<title>`, `<style>`, `<script>`, `<textarea>`
// oder `<plaintext>` auftaucht (WHATWG "generic raw text element parsing
// algorithm"). Der Weg hier: der Tokenizer laeuft bis zum Ende, der
// Baumaufbau verarbeitet die Saetze, und wenn er umschalten will, wird der
// REST der Eingabe ab der gemerkten Quellposition ERNEUT tokenisiert — mit
// dem neuen Startzustand.
//
// Der Preis ist ehrlich: O(k * n) statt O(n), wobei k die Zahl der
// Umschaltungen ist (auf einer echten Seite: Titel, Stile, Skripte — einige
// Dutzend). Gemessen auf testdata/realweb/ ist das tragbar; der saubere Weg
// waere ein FORTSETZBARER Tokenizer, und der gehoert in eine eigene Runde,
// weil er die 6.810/6.810 der Tokenizer-Suite anfasst.

import html.mem
import html.tokens
import html.tokenizer
import browser.knoten
import browser.namen
import browser.baum
import browser.tokenstrom

export {
    Lauf,
    lauf_neu, lauf_init, lauf_frei,
    lauf_text_aus_bytes, lauf_text, lauf_baum, lauf_dokument, lauf_namen,
    lauf_baum_loslassen,
    lauf_dokument_bauen,
}

struct Lauf {
    b: baum.Baum,
    s: tokens.Sink,
    st: tokenstrom.Strom,
    nm: namen.Namen,
    text: mem.CpBuf,
    rest: mem.CpBuf,
    lasttag: mem.CpBuf,
}

#[no_gc]
fn lauf_neu() -> Lauf {
    return Lauf{
        b: baum.baum_neu(),
        s: tokens.sink_neu(),
        st: tokenstrom.strom_neu(),
        nm: namen.namen_neu(),
        text: mem.cp_neu(),
        rest: mem.cp_neu(),
        lasttag: mem.cp_neu(),
    }
}

// EINMAL vor dem ersten Dokument. `false` = Speicher aus.
#[no_gc]
fn lauf_init(l: *mut Lauf) -> bool {
    if !namen.namen_init(&(*l).nm) {
        return false
    }
    tokens.sink_init(&(*l).s)
    tokens.sink_set_baum_modus(&(*l).s, true)
    baum.baum_puffer_init(&(*l).b)
    mem.cp_init(&(*l).text)
    mem.cp_init(&(*l).rest)
    mem.cp_init(&(*l).lasttag)
    return true
}

#[no_gc]
fn lauf_frei(l: *mut Lauf) {
    baum.baum_frei(&(*l).b)
    tokens.sink_free(&(*l).s)
    namen.namen_frei(&(*l).nm)
    mem.cp_free(&(*l).text)
    mem.cp_free(&(*l).rest)
    mem.cp_free(&(*l).lasttag)
}

#[no_gc]
fn lauf_text(l: *mut Lauf) -> *mut mem.CpBuf {
    return &(*l).text
}

#[no_gc]
fn lauf_namen(l: *mut Lauf) -> *mut namen.Namen {
    return &(*l).nm
}

#[no_gc]
fn lauf_baum(l: *mut Lauf) -> *mut baum.Baum {
    return &(*l).b
}

fn lauf_dokument(l: *mut Lauf) -> Gc[Dokument] {
    return baum.baum_dokument(&(*l).b)
}

// Laesst den zuletzt gebauten Baum los. Ohne das haelt der Zustand ihn
// weiter fest — fuer den Dauerlauf ist genau das der Unterschied zwischen
// "wird eingesammelt" und "waechst".
fn lauf_baum_loslassen(l: *mut Lauf) {
    baum.baum_loslassen(&(*l).b)
}

#[no_gc]
fn byte_bei(basis: u64, ges: usize, k: usize) -> u32 {
    if k >= ges {
        return 0 as u32
    }
    return (*((basis + k as u64) as *mut u8)) as u32
}

// WTF-8 -> Codepunkte, mit Zeilenendenormalisierung (\r\n und \r -> \n).
// Derselbe Vertrag mit dem Tokenizer wie in lib/html/tokenize_main.fi,
// deshalb dieselbe Vorverarbeitung.
#[no_gc]
fn lauf_text_aus_bytes(l: *mut Lauf, p: *mut u8, len: usize) {
    let out: *mut mem.CpBuf = &(*l).text
    mem.cp_clear(out)
    let basis: u64 = p as u64
    mem.cp_reserve(out, len)
    let ziel: u64 = mem.cp_ptr(out) as u64
    var aus: usize = 0
    var i: usize = 0
    while i < len {
        let c0: u32 = byte_bei(basis, len, i)
        if c0 < 0x80 as u32 && c0 != 13 as u32 {
            *((ziel + aus as u64 * 4) as *mut u32) = c0
            aus = aus + 1
            i = i + 1
            continue
        }
        var cp: u32 = c0
        var breite: usize = 1
        if c0 >= 0xF0 as u32 {
            breite = 4
            cp = ((c0 & 0x07 as u32) << 18) |
                ((byte_bei(basis, len, i + 1) & 0x3F as u32) << 12) |
                ((byte_bei(basis, len, i + 2) & 0x3F as u32) << 6) |
                (byte_bei(basis, len, i + 3) & 0x3F as u32)
        } else if c0 >= 0xE0 as u32 {
            breite = 3
            cp = ((c0 & 0x0F as u32) << 12) |
                ((byte_bei(basis, len, i + 1) & 0x3F as u32) << 6) |
                (byte_bei(basis, len, i + 2) & 0x3F as u32)
        } else if c0 >= 0xC0 as u32 {
            breite = 2
            cp = ((c0 & 0x1F as u32) << 6) |
                (byte_bei(basis, len, i + 1) & 0x3F as u32)
        }
        i = i + breite
        if cp == 13 as u32 {
            cp = 10 as u32
            if i < len && byte_bei(basis, len, i) == 10 as u32 {
                i = i + 1
            }
        }
        *((ziel + aus as u64 * 4) as *mut u32) = cp
        aus = aus + 1
    }
    mem.cp_set_len(out, aus)
}

#[no_gc]
fn rest_setzen(text: *mut mem.CpBuf, von: usize, rest: *mut mem.CpBuf) {
    mem.cp_clear(rest)
    let n: usize = mem.cp_len(text)
    var i: usize = von
    while i < n {
        mem.cp_push(rest, mem.cp_at(text, i))
        i = i + 1
    }
}

// Baut aus `lauf_text(l)` einen Baum. 0 = gut, sonst ein Fehlercode:
//   1 der Tokenizer erreichte einen Zustand, den er nicht kennt
//   2 der Baumaufbau brach ab (Ueberlauf oder Speicher aus)
//   3 zu viele Umschaltungen (kann nur ein Fehler in diesem Code sein)
//   9 kein Dokument (Speicher aus)
fn lauf_dokument_bauen(l: *mut Lauf) -> u32 {
    let b: *mut baum.Baum = &(*l).b
    let s: *mut tokens.Sink = &(*l).s
    let st: *mut tokenstrom.Strom = &(*l).st
    if !baum.baum_init(b, &(*l).nm, st) {
        return 9
    }
    var basis: usize = 0
    var zustand: u32 = 0
    mem.cp_clear(&(*l).lasttag)
    rest_setzen(&(*l).text, 0, &(*l).rest)
    var runden: u32 = 0
    while runden < 4096 as u32 {
        runden = runden + 1
        tokens.sink_out_clear(s)
        tokens.sink_set_last_start_tag_cp(s, &(*l).lasttag)
        tokens.sink_begin(s)
        if !tokenizer.tokenize(&(*l).rest, zustand, s) {
            tokens.sink_abort(s)
            return 1
        }
        tokens.sink_end(s)
        tokenstrom.strom_setzen(st, tokens.sink_out_ptr(s), tokens.sink_out_len(s))
        baum.baum_um_loeschen(b)
        var geschaltet: bool = false
        while tokenstrom.strom_weiter(st) {
            if !baum.baum_token(b) {
                return 2
            }
            if baum.baum_umschaltung(b) != 0 as u32 {
                geschaltet = true
                break
            }
        }
        if !geschaltet {
            if !baum.baum_eof(b) {
                return 2
            }
            if baum.baum_kaputt(b) != 0 as u32 {
                return 2
            }
            return 0
        }
        basis = basis + baum.baum_um_pos(b)
        zustand = baum.baum_umschaltung(b)
        mem.cp_copy_from(&(*l).lasttag, baum.baum_um_tag(b))
        baum.baum_um_loeschen(b)
        rest_setzen(&(*l).text, basis, &(*l).rest)
    }
    return 3
}
