// SPDX-License-Identifier: GPL-2.0-only
// lib/browser/b1_main.fi -- the driver for the html5lib tree construction tests.
//
// The same work as `lib/browser/parse_main.fi`, but with ONE more field in
// the job: the fragment context. Round 54 left `#document-fragment` cases
// out; from round B1 on they are parsed, so the context element has to
// travel from the runner into the parser.
//
// The job format (little-endian, tools/domb1/harness.py writes it):
//     u32  len_input
//     u8[] input          (WTF-8)
//     u32  len_context
//     u8[] context        ("", "td", "svg path", "math ms", "template", ...)
//     u32  flags          (bit 0 = the scripting flag of WHATWG 13.2)
// The end of the stream = the end of the input.
//
// The output per job: the lines of the tree, then one line `#ENDE`. On a
// visible error a `#KAPUTT <code>` stands in front of it. With a context
// the children of the FRAGMENT ROOT are written, without one the children
// of the document -- exactly the two cases the `.dat` files expect.
//
// `parse_main.fi` stays as it is: tools/html/run.sh of round 54 drives it
// with the old two field format, and that must keep working.
//
// Compile with:  firnc -o build/b1parse lib/browser/b1_main.fi

import html.mem
import browser.node
import browser.driver
import browser.write

#[no_gc]
fn read_u32(b: *mut mem.Buf, off: usize) -> u32 {
    var v: u32 = 0
    var i: usize = 0
    while i < 4 {
        v = v | ((mem.buf_at(b, off + i) as u32) << (8 * i as u32))
        i = i + 1
    }
    return v
}

#[no_gc]
fn lit(out: *mut mem.Buf, p: u64, n: usize) {
    var i: usize = 0
    while i < n {
        mem.buf_push(out, *((p + i as u64) as *mut u8))
        i = i + 1
    }
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    // The `Run` lies in the frame of `main` -- the stack scan of the collector
    // is conservative and finds its Gc pointers only there (SPEC 3.5.3).
    var l: driver.Run = driver.run_new()
    if !driver.run_init(&l) {
        return 91
    }

    var ins: mem.Buf = mem.buf_new()
    mem.read_all_stdin(&ins)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)

    let total: usize = mem.buf_len(&ins)
    var off: usize = 0
    while off + 4 <= total {
        let inlen: usize = read_u32(&ins, off) as usize
        driver.run_text_out_bytes(&l,
            ((mem.buf_ptr(&ins) as u64) + (off + 4) as u64) as *mut u8, inlen)
        off = off + 4 + inlen
        var ctxlen: usize = 0
        if off + 4 <= total {
            ctxlen = read_u32(&ins, off) as usize
            driver.run_context_out_bytes(&l,
                ((mem.buf_ptr(&ins) as u64) + (off + 4) as u64) as *mut u8, ctxlen)
            off = off + 4 + ctxlen
        } else {
            driver.run_context_out_bytes(&l, 0 as *mut u8, 0)
        }
        var flags: u32 = 0
        if off + 4 <= total {
            flags = read_u32(&ins, off)
            off = off + 4
        }
        driver.run_scripting_set(&l, (flags & 1 as u32) != 0 as u32)

        let rc: u32 = driver.run_document_build(&l)
        if rc != 0 as u32 {
            var k: [u8; 8] = "#KAPUTT "
            lit(&out, (&k) as u64, 8)
            mem.buf_push_dec(&out, rc as u64)
            mem.buf_push(&out, 10 as u8)
        }
        if ctxlen > 0 {
            write.subtree_write(driver.run_names(&l), driver.run_root(&l), &out)
        } else {
            write.tree_write(driver.run_names(&l), driver.run_document(&l), &out)
        }
        var e: [u8; 6] = "#ENDE\n"
        lit(&out, (&e) as u64, 6)
        if mem.buf_len(&out) > 65536 {
            mem.buf_flush(&out, 1)
        }
    }
    mem.buf_flush(&out, 1)
    driver.run_free(&l)
    return 0
}
