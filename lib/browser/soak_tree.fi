// lib/browser/soak_tree.fi — DAUERLAUF: echte DOM-Baeume aufbauen und
// verwerfen, ohne dass der Speicher waechst.
//
// WORUM ES GEHT (Abnahmepunkt 2, SPEC §3.5.5): ein DOM-Baum ist die
// Zyklenart, an der ein Zaehlverweis scheitert. Jeder Knoten haelt seine
// Eltern STARK und seine Kinder STARK; dazu kommen die Geschwisterzeiger in
// beide Richtungen. Ein Baum aus n Knoten hat damit rund 2n Zyklen. Wird er
// unerreichbar, gibt ein Zaehlverweis NICHTS frei.
//
// Anders als lib/dom/soak_gc.fi (der Prototyp aus Runde 4) baut dieses
// Programm keine kuenstlichen Zyklensaetze, sondern faehrt den ECHTEN
// Baumaufbau aus lib/browser/tree.fi ueber ein echtes HTML-Stueck — mit
// Tabelle, Formatierungselementen, Attributen, Rohtext und Kommentar. Was
// hier nicht eingesammelt wird, waere in einer Engine ein Leck.
//
// Eingabe (stdin, 12 Byte): u32 runden, u32 budget_ms, u32 leck.
// Fehlt sie, gelten die Vorgaben unten.
//
// `leck != 0` schaltet die GEGENPROBE ein: jeder gebaute Baum wird in einer
// GC-Kette FESTGEHALTEN. Dann MUSS der Verbrauch steigen. Eine Messung, die
// ein Leck nicht anzeigen kann, ist wertlos — deshalb wird sie bei jedem Lauf
// mitgefahren (tools/html/gc_tree.sh bricht ab, wenn die Gegenprobe gruen
// bleibt).
//
// Ausgabe: TSV auf stdout, eine Zeile je SAMPLE Runden:
//     t_ms  runden  knoten  rss_kib  lebende  laeufe  heap_bytes  pause_max_ns

import html.mem
import browser.node
import browser.driver
import dom.meas

const DEFAULT_ROUNDS: u64 = 20000
const DEFAULT_BUDGET_MS: i64 = 10000
const SAMPLE: u64 = 500
const SOURCE_LEN: usize = 446

// Das Stueck HTML, das je Runde zu einem Baum wird. Bewusst mit allem, was
// im Baumaufbau Knoten erzeugt: Doctype, Kopf, Rohtext (RCDATA und RAWTEXT,
// also zwei Umschaltungen des Tokenizers), Tabelle, verschachtelte
// Formatierung mit Adoption-Agency-Fall, Attribute, Kommentar, Auswahlliste.
#[no_gc]
fn source(out: *mut mem.Buf) {
    var t: [u8; 446] = "<!DOCTYPE html><html><head><title>Dauerlauf</title><style>b{x:1}</style></head><body id=\"w\" class=\"k\"><h1>Kopf</h1><p>Ein <b>fetter <i>und schraeger</i></b> Absatz mit <a href=\"/x\">Verweis</a>.</p><!--Kommentar--><table><caption>Tab</caption><tr><td>a<td><b>b</b><tr><td colspan=\"2\">c</table><ul><li>eins<li>zwei<li>drei</ul><div><div><div><span>tief</span></div></div></div><p>a<b>b<i>c</p>d</i>e<select><option>1<option>2</select></body></html>"
    mem.buf_clear(out)
    var i: usize = 0
    while i < SOURCE_LEN {
        mem.buf_push(out, t[i])
        i = i + 1
    }
}

// Haelt einen Baum fest — nur fuer die Gegenprobe.
gc class Holder {
    doc: Gc[Document],
    next: Gc[Holder],
}

fn node_count(k: Gc[Node]) -> u64 {
    if k == gc_null[Node]() {
        return 0
    }
    var n: u64 = 1
    var c: Gc[Node] = k.first_child
    while c != gc_null[Node]() {
        n = n + node_count(c)
        c = c.next
    }
    return n
}

// Legt einen tiefen, genullten Rahmen ueber die aufgegebenen Stapelrahmen der
// letzten Runde. Der Stapelscan ist KONSERVATIV (SPEC §3.5.3) — ein alter
// Zeiger in einem toten Rahmen haelt sonst einen ganzen Baum am Leben. Der
// Selbstaufruf haelt die Funktion aus dem Einbetter heraus, sonst laegen die
// genullten Rahmen im LEBENDEN Rahmen des Aufrufers.
fn scrub_deep(n: u64) {
    var buffer: [u64; 512] = [0; 512]
    var i: usize = 0
    while i < 512 {
        buffer[i] = 0
        i = i + 1
    }
    barrier(&buffer)
    if n > 0 {
        scrub_deep(n - 1)
    }
}

fn line(t_ms: u64, rounds: u64, node: u64, rss: u64, live: u64,
         runs: u64, heap: u64, pause: u64) {
    meas.meas_u64(t_ms)
    meas.meas_tab()
    meas.meas_u64(rounds)
    meas.meas_tab()
    meas.meas_u64(node)
    meas.meas_tab()
    meas.meas_u64(rss)
    meas.meas_tab()
    meas.meas_u64(live)
    meas.meas_tab()
    meas.meas_u64(runs)
    meas.meas_tab()
    meas.meas_u64(heap)
    meas.meas_tab()
    meas.meas_u64(pause)
    meas.meas_nl()
}

fn text_out(p: u64, n: i64) {
    meas.meas_write(p, n)
}

fn main() -> i32 {
    if !gc_init() {
        return 2
    }
    var rounds_max: u64 = DEFAULT_ROUNDS
    var budget: i64 = DEFAULT_BUDGET_MS
    var leak: bool = false
    var ins: mem.Buf = mem.buf_new()
    mem.read_all_stdin(&ins)
    if mem.buf_len(&ins) >= 8 {
        var v: u64 = 0
        var i: usize = 0
        while i < 4 {
            v = v | ((mem.buf_at(&ins, i) as u64) << (8 * i as u64))
            i = i + 1
        }
        if v > 0 {
            rounds_max = v
        }
        var w: u64 = 0
        i = 0
        while i < 4 {
            w = w | ((mem.buf_at(&ins, 4 + i) as u64) << (8 * i as u64))
            i = i + 1
        }
        if w > 0 {
            budget = w as i64
        }
        if mem.buf_len(&ins) >= 12 {
            var lw: u64 = 0
            i = 0
            while i < 4 {
                lw = lw | ((mem.buf_at(&ins, 8 + i) as u64) << (8 * i as u64))
                i = i + 1
            }
            leak = lw != 0
        }
    }
    mem.buf_free(&ins)

    var header: [u8; 97] = "# firn-baum-soak v1\n# spalten: t_ms\trunden\tknoten\trss_kib\tlebende\tlaeufe\theap_bytes\tpause_max_ns\n"
    text_out((&header) as u64, 97)

    var src: mem.Buf = mem.buf_new()
    mem.buf_init(&src)
    source(&src)

    // Der `Lauf` liegt im Rahmen von `main` (konservativer Stapelscan).
    var l: driver.Run = driver.run_new()
    if !driver.run_init(&l) {
        return 3
    }

    let t0: u64 = meas.meas_now_ms()
    var rounds: u64 = 0
    var node_per_round: u64 = 0
    var chain: Gc[Holder] = gc_null[Holder]()
    while rounds < rounds_max {
        driver.run_text_out_bytes(&l, mem.buf_ptr(&src), mem.buf_len(&src))
        let rc: u32 = driver.run_document_build(&l)
        if rc != 0 as u32 {
            var f: [u8; 18] = "# fehler in runde\n"
            text_out((&f) as u64, 18)
            return 4
        }
        let n: u64 = node_count(driver.run_document(&l))
        if node_per_round == 0 {
            node_per_round = n
        } else if node_per_round != n {
            var f2: [u8; 23] = "# knotenzahl schwankt!\n"
            text_out((&f2) as u64, 23)
            return 5
        }
        if leak {
            let h = gc Holder{ doc: driver.run_document(&l), next: chain } catch gc_null[Holder]()
            if h == gc_null[Holder]() {
                var fo: [u8; 20] = "# speicher aus (gc)\n"
                text_out((&fo) as u64, 20)
                return 6
            }
            chain = h
        }
        rounds = rounds + 1
        if rounds % SAMPLE == 0 {
            // Der Baum der LETZTEN Runde haengt noch am Zustand; erst hier
            // wird er losgelassen und der Stapel gesaeubert.
            tree_release_and_clean(&l)
            let t: u64 = meas.meas_now_ms() - t0
            line(t, rounds, node_per_round, meas.meas_rss_kib(),
                  gc_live_objects(), gc_collections(), gc_heap_bytes(),
                  gc_pause_ns_max())
            if t as i64 >= budget {
                break
            }
        }
    }
    var ez: [u8; 11] = "# angelegt="
    text_out((&ez) as u64, 11)
    meas.meas_u64(gc_diag(6))
    var ez2: [u8; 9] = " lebende="
    text_out((&ez2) as u64, 9)
    meas.meas_u64(gc_live_objects())
    var ez3: [u8; 6] = " leck="
    text_out((&ez3) as u64, 6)
    if leak {
        meas.meas_u64(1)
    } else {
        meas.meas_u64(0)
    }
    meas.meas_nl()
    // Die Kette darf bis hierhin nicht wegoptimiert werden.
    if leak && chain == gc_null[Holder]() {
        return 7
    }
    var e: [u8; 9] = "# fertig\n"
    text_out((&e) as u64, 9)
    driver.run_free(&l)
    return 0
}

fn tree_release_and_clean(l: *mut driver.Run) {
    driver.run_tree_release(l)
    scrub_deep(3)
}
