// lib/browser/driver.fi — Tokenizer + Baumaufbau zu EINEM Weg verbunden.
//
// Ein `Lauf` haelt alles, was ein Zerleger braucht: die Atomtabelle, den
// Tokenizer-Sink, den Protokolleser und den Baumzustand. Er wird EINMAL
// angelegt und fuer beliebig viele Dokumente wiederverwendet.
//
// WICHTIG — WO EIN `Lauf` LIEGEN MUSS: im RAHMEN des Aufrufers, als `var`.
// Er enthaelt `Gc[…]`-Felder (im `Baum`), und der Stapelscan des Sammlers ist
// konservativ (SPEC §3.5.3): auf dem Stapel findet er sie ohne jede
// Anmeldung, auf der Halde (mem.heap_alloc) NICHT. Ein `Lauf` auf der Halde
// muesste mit `gc_wurzel_anmelden` angemeldet werden.
//
// DIE RUECKKOPPLUNG AUF DEN TOKENIZER, offen benannt:
// `lib/html/tokenizer.fi` ist eine EINMAL durchlaufende Schleife — sie laesst
// sich nicht anhalten und fortsetzen. Der Baumaufbau muss den Tokenizer aber
// umschalten koennen, sobald `<title>`, `<style>`, `<script>`, `<textarea>`
// oder `<plaintext>` auftaucht (WHATWG "generic raw text element parsing
// algorithm"). Der Weg hier: der Tokenizer laeuft bis zum Ende, der
// Baumaufbau verarbeitet die Saetze, und wenn er umschalten will, wird der
// REST der Eingabe ab der gemerkten Quellposition ERNEUT tokenisiert — mit
// dem neuen Startzustand.
//
// Der Preis ist ehrlich: O(k * n) statt O(n), wobei k die Zahl der
// Umschaltungen ist (auf einer echten Seite: Titel, Stile, Skripte — einige
// Dutzend). Gemessen auf testdata/realweb/ ist das tragbar; der saubere Weg
// waere ein FORTSETZBARER Tokenizer, und der gehoert in eine eigene Runde,
// weil er die 6.810/6.810 der Tokenizer-Suite anfasst.

import html.mem
import html.tokens
import html.tokenizer
import browser.node
import browser.names
import browser.tree
import browser.token_stream

export {
    Run,
    run_new, run_init, run_free,
    run_text_out_bytes, run_text, run_tree, run_document, run_names,
    run_tree_release,
    run_document_build,
}

struct Run {
    b: tree.Tree,
    s: tokens.Sink,
    st: token_stream.Stream,
    nm: names.Names,
    text: mem.CpBuf,
    rest: mem.CpBuf,
    lasttag: mem.CpBuf,
}

#[no_gc]
fn run_new() -> Run {
    return Run{
        b: tree.tree_new(),
        s: tokens.sink_new(),
        st: token_stream.stream_new(),
        nm: names.names_new(),
        text: mem.cp_new(),
        rest: mem.cp_new(),
        lasttag: mem.cp_new(),
    }
}

// EINMAL vor dem ersten Dokument. `false` = Speicher aus.
#[no_gc]
fn run_init(l: *mut Run) -> bool {
    if !names.names_init(&(*l).nm) {
        return false
    }
    tokens.sink_init(&(*l).s)
    tokens.sink_set_tree_mode(&(*l).s, true)
    tree.tree_buffer_init(&(*l).b)
    mem.cp_init(&(*l).text)
    mem.cp_init(&(*l).rest)
    mem.cp_init(&(*l).lasttag)
    return true
}

#[no_gc]
fn run_free(l: *mut Run) {
    tree.tree_free(&(*l).b)
    tokens.sink_free(&(*l).s)
    names.names_free(&(*l).nm)
    mem.cp_free(&(*l).text)
    mem.cp_free(&(*l).rest)
    mem.cp_free(&(*l).lasttag)
}

#[no_gc]
fn run_text(l: *mut Run) -> *mut mem.CpBuf {
    return &(*l).text
}

#[no_gc]
fn run_names(l: *mut Run) -> *mut names.Names {
    return &(*l).nm
}

#[no_gc]
fn run_tree(l: *mut Run) -> *mut tree.Tree {
    return &(*l).b
}

fn run_document(l: *mut Run) -> Gc[Document] {
    return tree.tree_document(&(*l).b)
}

// Laesst den zuletzt gebauten Baum los. Ohne das haelt der Zustand ihn
// weiter fest — fuer den Dauerlauf ist genau das der Unterschied zwischen
// "wird eingesammelt" und "waechst".
fn run_tree_release(l: *mut Run) {
    tree.tree_release(&(*l).b)
}

#[no_gc]
fn byte_at(base: u64, total: usize, k: usize) -> u32 {
    if k >= total {
        return 0 as u32
    }
    return (*((base + k as u64) as *mut u8)) as u32
}

// WTF-8 -> Codepunkte, mit Zeilenendenormalisierung (\r\n und \r -> \n).
// Derselbe Vertrag mit dem Tokenizer wie in lib/html/tokenize_main.fi,
// deshalb dieselbe Vorverarbeitung.
#[no_gc]
fn run_text_out_bytes(l: *mut Run, p: *mut u8, len: usize) {
    let out: *mut mem.CpBuf = &(*l).text
    mem.cp_clear(out)
    let base: u64 = p as u64
    mem.cp_reserve(out, len)
    let target: u64 = mem.cp_ptr(out) as u64
    var outi: usize = 0
    var i: usize = 0
    while i < len {
        let c0: u32 = byte_at(base, len, i)
        if c0 < 0x80 as u32 && c0 != 13 as u32 {
            *((target + outi as u64 * 4) as *mut u32) = c0
            outi = outi + 1
            i = i + 1
            continue
        }
        var cp: u32 = c0
        var width: usize = 1
        if c0 >= 0xF0 as u32 {
            width = 4
            cp = ((c0 & 0x07 as u32) << 18) |
                ((byte_at(base, len, i + 1) & 0x3F as u32) << 12) |
                ((byte_at(base, len, i + 2) & 0x3F as u32) << 6) |
                (byte_at(base, len, i + 3) & 0x3F as u32)
        } else if c0 >= 0xE0 as u32 {
            width = 3
            cp = ((c0 & 0x0F as u32) << 12) |
                ((byte_at(base, len, i + 1) & 0x3F as u32) << 6) |
                (byte_at(base, len, i + 2) & 0x3F as u32)
        } else if c0 >= 0xC0 as u32 {
            width = 2
            cp = ((c0 & 0x1F as u32) << 6) |
                (byte_at(base, len, i + 1) & 0x3F as u32)
        }
        i = i + width
        if cp == 13 as u32 {
            cp = 10 as u32
            if i < len && byte_at(base, len, i) == 10 as u32 {
                i = i + 1
            }
        }
        *((target + outi as u64 * 4) as *mut u32) = cp
        outi = outi + 1
    }
    mem.cp_set_len(out, outi)
}

#[no_gc]
fn rest_set(text: *mut mem.CpBuf, of: usize, rest: *mut mem.CpBuf) {
    mem.cp_clear(rest)
    let n: usize = mem.cp_len(text)
    var i: usize = of
    while i < n {
        mem.cp_push(rest, mem.cp_at(text, i))
        i = i + 1
    }
}

// Baut aus `lauf_text(l)` einen Baum. 0 = gut, sonst ein Fehlercode:
//   1 der Tokenizer erreichte einen Zustand, den er nicht kennt
//   2 der Baumaufbau brach ab (Ueberlauf oder Speicher aus)
//   3 zu viele Umschaltungen (kann nur ein Fehler in diesem Code sein)
//   9 kein Dokument (Speicher aus)
fn run_document_build(l: *mut Run) -> u32 {
    let b: *mut tree.Tree = &(*l).b
    let s: *mut tokens.Sink = &(*l).s
    let st: *mut token_stream.Stream = &(*l).st
    if !tree.tree_init(b, &(*l).nm, st) {
        return 9
    }
    var base: usize = 0
    var state: u32 = 0
    mem.cp_clear(&(*l).lasttag)
    rest_set(&(*l).text, 0, &(*l).rest)
    var rounds: u32 = 0
    while rounds < 4096 as u32 {
        rounds = rounds + 1
        tokens.sink_out_clear(s)
        tokens.sink_set_last_start_tag_cp(s, &(*l).lasttag)
        tokens.sink_begin(s)
        if !tokenizer.tokenize(&(*l).rest, state, s) {
            tokens.sink_abort(s)
            return 1
        }
        tokens.sink_end(s)
        token_stream.stream_set(st, tokens.sink_out_ptr(s), tokens.sink_out_len(s))
        tree.tree_sw_delete(b)
        var switched: bool = false
        while token_stream.stream_next(st) {
            if !tree.tree_token(b) {
                return 2
            }
            if tree.tree_switching(b) != 0 as u32 {
                switched = true
                break
            }
        }
        if !switched {
            if !tree.tree_eof(b) {
                return 2
            }
            if tree.tree_broken(b) != 0 as u32 {
                return 2
            }
            return 0
        }
        base = base + tree.tree_sw_pos(b)
        state = tree.tree_switching(b)
        mem.cp_copy_from(&(*l).lasttag, tree.tree_sw_tag(b))
        tree.tree_sw_delete(b)
        rest_set(&(*l).text, base, &(*l).rest)
    }
    return 3
}
