// SPDX-License-Identifier: GPL-2.0-only
// lib/browser/driver.fi -- the tokenizer and the tree construction joined into ONE path.
//
// A `Run` holds everything a parser needs: the atom table, the tokenizer
// sink, the protocol reader and the tree state. It is created ONCE and
// reused for any number of documents.
//
// IMPORTANT -- WHERE A `Run` HAS TO LIE: in the FRAME of the caller, as a
// `var`. It contains `Gc[...]` fields (inside the `Tree`), and the stack scan
// of the collector is conservative (SPEC 3.5.3): on the stack it finds them
// without any registration, on the heap (mem.heap_alloc) NOT. A `Run` on the
// heap would have to be registered with `gc_root_register`.
//
// THE FEEDBACK ONTO THE TOKENIZER, named openly:
// `lib/html/tokenizer.fi` is a loop that runs through ONCE -- it cannot be
// stopped and resumed. But the tree construction has to be able to switch
// the tokenizer over as soon as `<title>`, `<style>`, `<script>`, `<textarea>`
// or `<plaintext>` turns up (WHATWG "generic raw text element parsing
// algorithm"). The way taken here: the tokenizer runs to the end, the tree
// construction processes the records, and when it wants to switch over, the
// REST of the input is tokenized AGAIN from the remembered source position --
// with the new start state.
//
// The price is honest: O(k * n) instead of O(n), where k is the number of
// switch overs (on a real page: the title, styles, scripts -- a few
// dozen). Measured on testdata/realweb/ that is bearable; the clean way
// would be a RESUMABLE tokenizer, and that belongs in a round of its own,
// because it touches the 6,810/6,810 of the tokenizer suite.

import html.mem
import html.tokens
import html.tokenizer
import browser.node
import browser.names
import browser.tree
import browser.tag
import browser.token_stream

export {
    Run,
    run_new, run_init, run_free,
    run_text_out_bytes, run_text, run_tree, run_document, run_names,
    run_tree_release,
    run_document_build, run_context_out_bytes, run_root, run_scripting_set,
}

struct Run {
    b: tree.Tree,
    s: tokens.Sink,
    st: token_stream.Stream,
    nm: names.Names,
    text: mem.CpBuf,
    rest: mem.CpBuf,
    lasttag: mem.CpBuf,
    // ROUND B1: the context element of the fragment parsing algorithm, as
    // it stands in the `.dat` files: `td`, `svg path`, `math ms`, `template`.
    // Empty = a whole document.
    ctx: mem.Buf,
    ctx_name: u32,
    ctx_ns: u32,
    scripting: bool,
}

#[no_gc]
fn run_new() -> Run {
    return Run {
        b: tree.tree_new(),
        s: tokens.sink_new(),
        st: token_stream.stream_new(),
        nm: names.names_new(),
        text: mem.cp_new(),
        rest: mem.cp_new(),
        lasttag: mem.cp_new(),
        ctx: mem.buf_new(),
        ctx_name: 0,
        ctx_ns: 0,
        scripting: false,
    }
}

// ONCE before the first document. `false` = out of memory.
#[no_gc]
fn run_init(l: *mut Run) -> bool {
    if !names.names_init(&(*l).nm) {
        return false
    }
    tokens.sink_init(&(*l).s)
    tokens.sink_set_tree_mode(&(*l).s, true)
    tree.tree_buffer_init(&(*l).b)
    mem.cp_init(&(*l).text)
    mem.cp_init(&(*l).rest)
    mem.cp_init(&(*l).lasttag)
    mem.buf_init(&(*l).ctx)
    (*l).ctx_name = 0
    (*l).ctx_ns = 0
    return true
}

#[no_gc]
fn run_free(l: *mut Run) {
    tree.tree_free(&(*l).b)
    tokens.sink_free(&(*l).s)
    names.names_free(&(*l).nm)
    mem.cp_free(&(*l).text)
    mem.cp_free(&(*l).rest)
    mem.cp_free(&(*l).lasttag)
    mem.buf_free(&(*l).ctx)
}

#[no_gc]
fn run_text(l: *mut Run) -> *mut mem.CpBuf {
    return &(*l).text
}

#[no_gc]
fn run_names(l: *mut Run) -> *mut names.Names {
    return &(*l).nm
}

#[no_gc]
fn run_tree(l: *mut Run) -> *mut tree.Tree {
    return &(*l).b
}

fn run_document(l: *mut Run) -> Gc[Document] {
    return tree.tree_document(&(*l).b)
}

// The node whose children are the result: the document, or in the fragment
// case the root element the fragment was built under.
// The scripting flag for the NEXT document (WHATWG 13.2). It executes
// nothing -- it only decides whether `noscript` holds raw text.
#[no_gc]
fn run_scripting_set(l: *mut Run, on: bool) {
    (*l).scripting = on
}

fn run_root(l: *mut Run) -> Gc[Node] {
    return tree.tree_root(&(*l).b)
}

// Sets the context element for the NEXT `run_document_build`. An empty
// name switches fragment parsing off again.
//
// The notation is the one of the html5lib `.dat` files: `svg path` and
// `math ms` carry the namespace in front of the name, everything else is
// HTML.
#[no_gc]
fn run_context_out_bytes(l: *mut Run, p: *mut u8, len: usize) {
    mem.buf_clear(&(*l).ctx)
    (*l).ctx_name = 0
    (*l).ctx_ns = 0
    if len == 0 {
        return
    }
    var start: usize = 0
    var ns: u32 = node.NS_HTML
    var space: usize = len
    var i: usize = 0
    while i < len {
        if *((p as u64 + i as u64) as *mut u8) == 32 as u8 {
            space = i
            break
        }
        i = i + 1
    }
    if space < len {
        if space == 3 && *(p) == 115 as u8 {
            ns = node.NS_SVG // "svg "
        } else if space == 4 && *(p) == 109 as u8 {
            ns = node.NS_MATHML // "math "
        }
        start = space + 1
    }
    var k: usize = start
    while k < len {
        mem.buf_push(&(*l).ctx, *((p as u64 + k as u64) as *mut u8))
        k = k + 1
    }
    (*l).ctx_ns = ns
    (*l).ctx_name = names.names_of_bytes(&(*l).nm, mem.buf_ptr(&(*l).ctx),
        mem.buf_len(&(*l).ctx))
}

// The tokenizer start state a fragment context asks for
// (WHATWG 13.2.5, step 4 of the fragment parsing algorithm).
#[no_gc]
fn context_state(name: u32, ns: u32, scripting: bool) -> u32 {
    if ns != node.NS_HTML {
        return 0
    }
    if name == tag.M_NOSCRIPT && scripting {
        return 3 // RAWTEXT
    }
    if name == tag.M_TITLE || name == tag.M_TEXTAREA {
        return 2 // RCDATA
    }
    if name == tag.M_STYLE || name == tag.M_XMP || name == tag.M_IFRAME ||
    name == tag.M_NOEMBED || name == tag.M_NOFRAMES {
        return 3 // RAWTEXT
    }
    if name == tag.M_SCRIPT {
        return 4 // script data
    }
    if name == tag.M_PLAINTEXT {
        return 1 // PLAINTEXT
    }
    return 0
}

// Lets go of the tree built last. Without that the state keeps holding it
// -- for the endurance run that is exactly the difference between
// "gets collected" and "grows".
fn run_tree_release(l: *mut Run) {
    tree.tree_release(&(*l).b)
}

#[no_gc]
fn byte_at(base: u64, total: usize, k: usize) -> u32 {
    if k >= total {
        return 0 as u32
    }
    return (*((base + k as u64) as *mut u8)) as u32
}

// WTF-8 -> code points, with line ending normalization (\r\n and \r -> \n).
// The same contract with the tokenizer as in lib/html/tokenize_main.fi,
// hence the same preprocessing.
#[no_gc]
fn run_text_out_bytes(l: *mut Run, p: *mut u8, len: usize) {
    let out: *mut mem.CpBuf = &(*l).text
    mem.cp_clear(out)
    let base: u64 = p as u64
    mem.cp_reserve(out, len)
    let target: u64 = mem.cp_ptr(out) as u64
    var outi: usize = 0
    var i: usize = 0
    while i < len {
        let c0: u32 = byte_at(base, len, i)
        if c0 < 0x80 as u32 && c0 != 13 as u32 {
            *((target + outi as u64 * 4) as *mut u32) = c0
            outi = outi + 1
            i = i + 1
            continue
        }
        var cp: u32 = c0
        var width: usize = 1
        if c0 >= 0xF0 as u32 {
            width = 4
            cp = ((c0 & 0x07 as u32) << 18) |
            ((byte_at(base, len, i + 1) & 0x3F as u32) << 12) |
            ((byte_at(base, len, i + 2) & 0x3F as u32) << 6) |
            (byte_at(base, len, i + 3) & 0x3F as u32)
        } else if c0 >= 0xE0 as u32 {
            width = 3
            cp = ((c0 & 0x0F as u32) << 12) |
            ((byte_at(base, len, i + 1) & 0x3F as u32) << 6) |
            (byte_at(base, len, i + 2) & 0x3F as u32)
        } else if c0 >= 0xC0 as u32 {
            width = 2
            cp = ((c0 & 0x1F as u32) << 6) |
            (byte_at(base, len, i + 1) & 0x3F as u32)
        }
        i = i + width
        if cp == 13 as u32 {
            cp = 10 as u32
            if i < len && byte_at(base, len, i) == 10 as u32 {
                i = i + 1
            }
        }
        *((target + outi as u64 * 4) as *mut u32) = cp
        outi = outi + 1
    }
    mem.cp_set_len(out, outi)
}

#[no_gc]
fn rest_set(text: *mut mem.CpBuf, of: usize, rest: *mut mem.CpBuf) {
    mem.cp_clear(rest)
    let n: usize = mem.cp_len(text)
    var i: usize = of
    while i < n {
        mem.cp_push(rest, mem.cp_at(text, i))
        i = i + 1
    }
}

// Builds a tree out of `run_text(l)`. 0 = fine, otherwise an error code:
//   1 the tokenizer reached a state it does not know
//   2 the tree construction aborted (an overflow or out of memory)
//   3 too many switch overs (which can only be a bug in this code)
//   9 no document (out of memory)
fn run_document_build(l: *mut Run) -> u32 {
    let b: *mut tree.Tree = &(*l).b
    let s: *mut tokens.Sink = &(*l).s
    let st: *mut token_stream.Stream = &(*l).st
    let frag: bool = (*l).ctx_name != 0 as u32
    if frag {
        if !tree.tree_fragment_init(b, &(*l).nm, st, (*l).ctx_name, (*l).ctx_ns) {
            return 9
        }
    } else {
        if !tree.tree_init(b, &(*l).nm, st) {
            return 9
        }
    }
    tree.tree_scripting_set(b, (*l).scripting)
    var base: usize = 0
    var state: u32 = 0
    mem.cp_clear(&(*l).lasttag)
    if frag {
        // WHATWG 13.2.5 step 4 sets ONLY the tokenizer state. There is no
        // last start tag in a fragment, so no end tag is an "appropriate
        // end tag" -- `<!-- inside </script> -->` in a `script` context
        // stays text down to the last character.
        state = context_state((*l).ctx_name, (*l).ctx_ns, (*l).scripting)
    }
    rest_set(&(*l).text, 0, &(*l).rest)
    var rounds: u32 = 0
    while rounds < 4096 as u32 {
        rounds = rounds + 1
        tokens.sink_out_clear(s)
        tokens.sink_set_last_start_tag_cp(s, &(*l).lasttag)
        tokens.sink_begin(s)
        tree.tree_input_set(b, &(*l).rest)
        if !tokenizer.tokenize(&(*l).rest, state, s) {
            tokens.sink_abort(s)
            return 1
        }
        tokens.sink_end(s)
        token_stream.stream_set(st, tokens.sink_out_ptr(s), tokens.sink_out_len(s))
        tree.tree_sw_delete(b)
        var switched: bool = false
        while token_stream.stream_next(st) {
            if !tree.tree_token(b) {
                return 2
            }
            if tree.tree_switching(b) != 0 as u32 {
                switched = true
                break
            }
        }
        if !switched {
            if !tree.tree_eof(b) {
                return 2
            }
            if tree.tree_broken(b) != 0 as u32 {
                return 2
            }
            return 0
        }
        base = base + tree.tree_sw_pos(b)
        state = tree.tree_switching(b)
        mem.cp_copy_from(&(*l).lasttag, tree.tree_sw_tag(b))
        tree.tree_sw_delete(b)
        rest_set(&(*l).text, base, &(*l).rest)
    }
    return 3
}
