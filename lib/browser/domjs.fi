// SPDX-License-Identifier: GPL-2.0-only
// lib/browser/domjs.fi -- the DOM as JAVASCRIPT sees it (round B4).
//
// Round 63 built a JavaScript engine and round B1 built a DOM, and until
// now they had never met: a script could compute, and it could not touch
// the page. This file is the join, and it is the reason the thing in this
// repository can start to be called a browser rather than a renderer.
//
// HOW A NATIVE IS REACHED. `lib/js/builtin.fi` hands every native number
// from 30000 on to a function VALUE the driver installs
// (`Ctx.gen_native`). Round 66 put the generators there. This round
// installs `dom_native` instead and forwards everything below 40000 back
// to `gen.gen_native` -- so the chain is builtin -> dom -> generators, and
// neither of the two older files had to learn about this one. That is the
// same trick, for the same reason: `lib/js/interp.fi` must not import a
// DOM, or the engine could no longer be built without one.
//
// THE WRAPPER, and why it has to be the SAME object every time. A DOM node
// is a `Gc[Node]`; JavaScript wants an object with properties. `DomObj` is
// a `JsObj` with the node beside it -- a real subclass, so the collector
// traces the node through the compiler generated type table and a node
// that only a script still holds stays alive. `Host.wrappers` maps the
// node to its wrapper, because
//
//     document.getElementById("x") === document.getElementById("x")
//
// has to be true, and because an event listener list hangs off identity.
//
// WHAT AN ATTRIBUTE COSTS. Every setter that can change the picture calls
// `live_mark_*` (lib/browser/live.fi) and nothing else -- no relayout, no
// paint. The page is brought up to date once, after the script has run,
// which is what makes a loop of a thousand `appendChild` calls cost one
// layout instead of a thousand.
//
// NAMED LIMITS are in docs/ROUNDB4.md; the largest are: no shadow DOM, no
// custom elements, no mutation observers, no live `HTMLCollection` (every
// list is a snapshot, as `querySelectorAll` returns anyway), and `style`
// is the INLINE declaration block, not the computed style.
// CHAPTER Z, AND IT IS A RULE ABOUT THIS FILE (round B6)
//
// Every field this host hands to a page which says something about the
// MACHINE rather than about the document is a fingerprint bit, and it
// goes through `browser.fpz` before it is handed over:
//
//   navigator.hardwareConcurrency   fpz.fp_hardware_concurrency
//   navigator.deviceMemory          fpz.fp_device_memory
//   navigator.userAgent             fpz.fp_user_agent  (FROZEN, not
//                                   noised -- a per-site user agent is a
//                                   mark of its own)
//   screen.width / .height          fpz.fp_screen_round
//   performance.now / Date.now      fpz.fp_clock_us
//
// The key belongs to the ORIGIN of the document and to the SESSION, so
// the answers are consistent within one visit and line up with nothing
// outside it. There is no switch (Z6): every mode a user can be in is
// itself a bit.
//
// The requirement is Z3, Z4 and Z6 of orientos-browser/REQUIREMENTS.md,
// the measurement is `tools/fpz/run.sh`, and the reason is the AliExpress
// case of 24 August 2026 -- see `lib/browser/fpz.fi`.
import html.mem
import browser.node
import browser.names
import browser.tag
import browser.write
import browser.driver
import browser.live
import dom.api
import css.tok
import css.cv
import css.sel
import css.cascade
import js.lex
import js.val
import js.interp
import js.gen
import std.math

export {
    Host, DomObj, DOM_BASE,
    host_new, host_init, host_free,
    host_set_live, host_set_document, host_set_fragment_parser,
    host_set_location,
    dom_native, dom_arity, install_dom,
    host_timers_due, host_run_timers, host_timer_count, host_advance,
    host_dispatch_named, host_events_fired, host_listeners_run,
    host_timer_errors, host_last_throw,
    wrap_node, node_of,
}

const DOM_BASE: u64 = 40000

// The kinds of host object that are not a node.
const HK_NODE: u64 = 0
const HK_STYLE: u64 = 1 // an inline declaration block
const HK_CLASSLIST: u64 = 2
const HK_EVENT: u64 = 3
const HK_LOCATION: u64 = 4
const HK_WINDOW: u64 = 5

// The prototypes this file owns, in `Host.protos`.
const P_NODE: u64 = 0
const P_ELEMENT: u64 = 1
const P_DOCUMENT: u64 = 2
const P_TEXT: u64 = 3
const P_COMMENT: u64 = 4
const P_STYLE: u64 = 5
const P_CLASSLIST: u64 = 6
const P_EVENT: u64 = 7
const P_LOCATION: u64 = 8
const P_WINDOW: u64 = 9
// Round B4: the chain the DOM standard really has. `instanceof` is a
// property of the PROTOTYPE CHAIN, so an engine that puts every method on
// one object answers `el instanceof HTMLElement` with false and fails a
// whole class of tests for a reason that has nothing to do with the
// method itself.
const P_EVENTTARGET: u64 = 10
const P_HTMLELEMENT: u64 = 11
const P_CHARDATA: u64 = 12
const P_COUNT: u64 = 13

// A wrapper. `k` is the node for HK_NODE and the OWNER element for a
// style block or a class list; `hkind` says which.
gc class DomObj extends JsObj {
    k: Gc[Node],
    ev: Gc[JsObj], // an event object: its own fields hang here
    hkind: u64,
}

// One registered listener.
gc class Listener {
    target: Gc[Node],
    fn_: Gc[JsVal],
    type_: Gc[JsVal],
    capture: bool,
    once: bool,
    dead: bool,
}

// One timer.
gc class Timer {
    fn_: Gc[JsVal],
    args: Gc[GcVec],
    id: u64,
    due_ms: u64,
    every_ms: u64,
    repeat: bool,
    dead: bool,
}

struct Host {
    // --- the GC fields. A `Host` belongs in a frame; the collector scans
    // the stack conservatively and finds them there.
    wrappers: Gc[GcMap], // node -> DomObj
    listeners: Gc[GcMap], // node -> GcVec[Listener]
    timers: Gc[GcVec],
    protos: Gc[GcVec],
    realm: Gc[Realm],
    doc: Gc[Node],
    window: Gc[JsObj],
    ev_current: Gc[DomObj],

    lv: *mut live.Live,
    nm: *mut names.Names,
    // The second parser, for `innerHTML`. It belongs to the driver -- a
    // `Run` holds the whole tree construction state and there must be
    // exactly one of it per document being built.
    frag: *mut driver.Run,
    t: tok.Tokens,
    cx: sel.Ctx,
    tmp: mem.CpBuf,
    tmp2: mem.CpBuf,
    buf: mem.Buf,
    loc: mem.Buf,
    next_timer: u64,
    now_ms: u64,
    fired: u64, // events dispatched
    ran: u64, // listeners really called
    timers_run: u64,
    timer_errors: u64,
    last_throw: Gc[JsVal],
    ok: bool,
}

fn host_new() -> Host {
    return Host {
        wrappers: gc_null[GcMap](), listeners: gc_null[GcMap](),
        timers: gc_null[GcVec](), protos: gc_null[GcVec](),
        realm: gc_null[Realm](), doc: gc_null[Node](),
        window: gc_null[JsObj](), ev_current: gc_null[DomObj](),
        lv: 0 as *mut live.Live, nm: 0 as *mut names.Names,
        frag: 0 as *mut driver.Run,
        t: tok.tokens_new(), cx: sel.ctx_new(0 as *mut names.Names),
        tmp: mem.cp_new(), tmp2: mem.cp_new(), buf: mem.buf_new(),
        loc: mem.buf_new(),
        next_timer: 1, now_ms: 0, fired: 0, ran: 0, timers_run: 0,
        timer_errors: 0, last_throw: gc_null[JsVal](),
        ok: false,
    }
}

fn host_init(h: *mut Host, nm: *mut names.Names) -> bool {
    (*h).cx = sel.ctx_new(nm)
    sel.ctx_init(&(*h).cx)
    tok.tokens_init(&(*h).t)
    mem.cp_init(&(*h).tmp)
    mem.cp_init(&(*h).tmp2)
    mem.buf_init(&(*h).buf)
    mem.buf_init(&(*h).loc)
    (*h).nm = nm
    (*h).ok = true
    return true
}

fn host_free(h: *mut Host) {
    sel.ctx_free(&(*h).cx)
    mem.cp_free(&(*h).tmp)
    mem.cp_free(&(*h).tmp2)
    mem.buf_free(&(*h).buf)
    mem.buf_free(&(*h).loc)
    (*h).wrappers = gc_null[GcMap]()
    (*h).listeners = gc_null[GcMap]()
    (*h).timers = gc_null[GcVec]()
    (*h).protos = gc_null[GcVec]()
    (*h).realm = gc_null[Realm]()
    (*h).doc = gc_null[Node]()
    (*h).window = gc_null[JsObj]()
}

fn host_set_live(h: *mut Host, l: *mut live.Live) { (*h).lv = l }
fn host_set_fragment_parser(h: *mut Host, d: *mut driver.Run) {
    (*h).frag = d
}
fn host_set_document(h: *mut Host, d: Gc[Node]) { (*h).doc = d }
fn host_events_fired(h: *mut Host) -> u64 { return (*h).fired }
fn host_timer_errors(h: *mut Host) -> u64 { return (*h).timer_errors }
fn host_last_throw(h: *mut Host) -> Gc[JsVal] { return (*h).last_throw }
fn host_listeners_run(h: *mut Host) -> u64 { return (*h).ran }
fn host_timer_count(h: *mut Host) -> u64 {
    if (*h).timers == gc_null[GcVec]() {
        return 0
    }
    var n: u64 = 0
    var i: u64 = 0
    while i < gcvec_length((*h).timers) {
        let t: Gc[Timer] = gcvec_read[Timer]((*h).timers, i)
        if !t.dead {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn host_of(r: Gc[Realm]) -> *mut Host {
    return interp.ctx_host(r) as *mut Host
}

// ------------------------------------------------------------- Strings

fn js_to_cp(v: Gc[JsVal], out: *mut mem.CpBuf) {
    mem.cp_clear(out)
    if val.val_tag(v) != val.TAG_STR {
        return
    }
    var i: u64 = 0
    let n: u64 = val.str_len(v)
    while i < n {
        mem.cp_push(out, val.str_at(v, i))
        i = i + 1
    }
}

fn cp_to_js(r: Gc[Realm], b: *mut mem.CpBuf) -> AllocError!Gc[JsVal] {
    return try val.str_from_units(r, b, 0, mem.cp_len(b))
}

fn chain_to_js(r: Gc[Realm], c: Gc[Chain],
    tmp: *mut mem.CpBuf) -> AllocError!Gc[JsVal] {
    mem.cp_clear(tmp)
    if c != gc_null[Chain]() {
        node.chain_after_cpbuf(c, tmp)
    }
    return try cp_to_js(r, tmp)
}

fn name_to_js(r: Gc[Realm], nm: *mut names.Names, id: u32,
    tmp: *mut mem.CpBuf) -> AllocError!Gc[JsVal] {
    mem.cp_clear(tmp)
    names.names_after_cpbuf(nm, id, tmp)
    return try cp_to_js(r, tmp)
}

fn cp_upper(b: *mut mem.CpBuf) {
    var i: usize = 0
    let n: usize = mem.cp_len(b)
    while i < n {
        let c: u32 = mem.cp_at(b, i)
        if c >= 97 as u32 && c <= 122 as u32 {
            mem.cp_set(b, i, c - 32 as u32)
        }
        i = i + 1
    }
}

fn ascii_js(r: Gc[Realm], p: *mut u8, n: usize) -> AllocError!Gc[JsVal] {
    return try val.str_from_ascii(r, p, n)
}

fn arg(r: Gc[Realm], a: Gc[GcVec], i: u64) -> Gc[JsVal] {
    if i >= gcvec_length(a) {
        return val.realm_undefined(r)
    }
    return gcvec_read[JsVal](a, i)
}

fn arg_str(r: Gc[Realm], a: Gc[GcVec], i: u64,
    out: *mut mem.CpBuf) -> AllocError!bool {
    let v: Gc[JsVal] = arg(r, a, i)
    let s: Gc[JsVal] = try interp.to_string(r, v)
    js_to_cp(s, out)
    return true
}

// ------------------------------------------------------------- Wrappers

fn wrap_node(h: *mut Host, r: Gc[Realm], k: Gc[Node]) -> AllocError!Gc[JsVal] {
    if k == gc_null[Node]() {
        return val.realm_null(r)
    }
    let have: Gc[DomObj] = gcmap_get_value[DomObj]((*h).wrappers, k as u64)
    if have != gc_null[DomObj]() {
        let v: Gc[JsVal] = have
        return v
    }
    var which: u64 = P_NODE
    if k.kind == node.K_ELEM {
        which = P_HTMLELEMENT
        let e2: Gc[Elem] = node.node_as_elem(k)
        if e2.ns != node.NS_HTML {
            which = P_ELEMENT
        }
    } else if k.kind == node.K_TEXT {
        which = P_TEXT
    } else if k.kind == node.K_COMMENT {
        which = P_COMMENT
    } else if k.kind == node.K_DOCUMENT {
        which = P_DOCUMENT
    }
    let o: Gc[DomObj] = try dom_obj(h, r, which, k, HK_NODE)
    let ok: bool = try gcmap_set_value[DomObj]((*h).wrappers, k as u64, o)
    let v: Gc[JsVal] = o
    return v
}

fn dom_obj(h: *mut Host, r: Gc[Realm], which: u64, k: Gc[Node],
    hk: u64) -> AllocError!Gc[DomObj] {
    let proto: Gc[JsObj] = gcvec_read[JsObj]((*h).protos, which)
    return try gc DomObj {
        tag: val.TAG_OBJ,
        proto: proto,
        props: try gcmap_new(false, true),
        order: try gcvec_new_raw(),
        elems: gc_null[GcVec](),
        env: gc_null[Env](),
        prim: gc_null[JsVal](),
        extra: gc_null[JsObj](),
        cls: val.CLS_ORDINARY,
        node: 0,
        native: 0,
        flags: val.F_EXTENSIBLE,
        len: 0,
        k: k,
        ev: gc_null[JsObj](),
        hkind: hk,
    }
}

fn as_dom(v: Gc[JsVal]) -> Gc[DomObj] {
    if val.val_tag(v) != val.TAG_OBJ {
        return gc_null[DomObj]()
    }
    return v.as?[DomObj]
}

fn node_of(v: Gc[JsVal]) -> Gc[Node] {
    let d: Gc[DomObj] = as_dom(v)
    if d == gc_null[DomObj]() {
        return gc_null[Node]()
    }
    return d.k
}

fn elem_of(v: Gc[JsVal]) -> Gc[Elem] {
    let k: Gc[Node] = node_of(v)
    if k == gc_null[Node]() || k.kind != node.K_ELEM {
        return gc_null[Elem]()
    }
    return node.node_as_elem(k)
}

fn type_err(r: Gc[Realm], p: *mut u8, n: usize) -> AllocError!Gc[JsVal] {
    return interp.throw_error(r, interp.ERR_TYPE, p, n)
}

fn not_a_node(r: Gc[Realm]) -> AllocError!Gc[JsVal] {
    var m: [u8; 24] = "this is not a DOM node  "
    return type_err(r, &m[0], 22)
}

// A snapshot as a JavaScript array. Every list this file hands out is one;
// a live `HTMLCollection` would have to hang on the tree and be
// invalidated on every change, and `querySelectorAll` returns a snapshot
// in every browser anyway.
fn nodes_to_array(h: *mut Host, r: Gc[Realm],
    v: Gc[GcVec]) -> AllocError!Gc[JsVal] {
    let a: Gc[JsObj] = try val.array_new(r)
    var i: u64 = 0
    let n: u64 = gcvec_length(v)
    while i < n {
        let k: Gc[Node] = gcvec_read[Node](v, i)
        let w: Gc[JsVal] = try wrap_node(h, r, k)
        let ok: bool = try val.elems_push(r, a, w)
        i = i + 1
    }
    let okl: bool = try val.array_set_length(r, a, n)
    let out: Gc[JsVal] = a
    return out
}

