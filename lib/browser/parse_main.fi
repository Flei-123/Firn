// lib/browser/parse_main.fi — Treiber: HTML von der Standardeingabe, DOM-Baum
// im html5lib-Format auf die Standardausgabe.
//
// Auftragsformat (little-endian, siehe tools/html/PROTOKOLL.md):
//     u32  len_input
//     u8[] input        (WTF-8)
// Ende des Stroms = Ende der Eingabe.
//
// Ausgabe je Auftrag: die Zeilen des Baums, danach eine Zeile `#ENDE`.
// Bei einem sichtbaren Fehler steht davor `#KAPUTT <code>`.
//
// Die eigentliche Arbeit steht in lib/browser/treiber.fi; hier ist nur der
// Ein- und Ausgabeweg.
//
// Uebersetzen:  firnc -o build/parse lib/browser/parse_main.fi

import html.mem
import browser.knoten
import browser.treiber
import browser.schreiben

#[no_gc]
fn lies_u32(b: *mut mem.Buf, off: usize) -> u32 {
    var v: u32 = 0
    var i: usize = 0
    while i < 4 {
        v = v | ((mem.buf_at(b, off + i) as u32) << (8 * i as u32))
        i = i + 1
    }
    return v
}

#[no_gc]
fn lit(out: *mut mem.Buf, p: u64, n: usize) {
    var i: usize = 0
    while i < n {
        mem.buf_push(out, *((p + i as u64) as *mut u8))
        i = i + 1
    }
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    // Der `Lauf` liegt im Rahmen von `main` — der Stapelscan des Sammlers ist
    // konservativ und findet seine Gc-Zeiger nur dort (SPEC §3.5.3).
    var l: treiber.Lauf = treiber.lauf_neu()
    if !treiber.lauf_init(&l) {
        return 91
    }

    var ein: mem.Buf = mem.buf_neu()
    mem.read_all_stdin(&ein)
    var aus: mem.Buf = mem.buf_neu()
    mem.buf_init(&aus)

    let gesamt: usize = mem.buf_len(&ein)
    var off: usize = 0
    while off + 4 <= gesamt {
        let inlen: usize = lies_u32(&ein, off) as usize
        treiber.lauf_text_aus_bytes(&l,
            ((mem.buf_ptr(&ein) as u64) + (off + 4) as u64) as *mut u8, inlen)
        off = off + 4 + inlen

        let rc: u32 = treiber.lauf_dokument_bauen(&l)
        if rc != 0 as u32 {
            var k: [u8; 8] = "#KAPUTT "
            lit(&aus, (&k) as u64, 8)
            mem.buf_push_dec(&aus, rc as u64)
            mem.buf_push(&aus, 10 as u8)
        }
        schreiben.baum_schreiben(treiber.lauf_namen(&l), treiber.lauf_dokument(&l), &aus)
        var e: [u8; 6] = "#ENDE\n"
        lit(&aus, (&e) as u64, 6)
        if mem.buf_len(&aus) > 65536 {
            mem.buf_flush(&aus, 1)
        }
    }
    mem.buf_flush(&aus, 1)
    treiber.lauf_frei(&l)
    return 0
}
