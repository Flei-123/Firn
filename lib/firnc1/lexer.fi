// lib/firnc1/lexer.fi — DER LEXER VON FIRN, GESCHRIEBEN IN FIRN.
//
// Erster Teil von Stufe 1 (docs/SELBSTHOSTING.md §2, Punkt 5). Der Lexer hat
// die kleinste Schnittstelle im ganzen Compiler — Text hinein, Tokenfeld
// hinaus — und braucht genau die Bausteine, die seit Runde 15 bis 19 stehen:
// Allokator (`rt`), `Vec[T]` und `Interner`.
//
// MASSSTAB: `bin/lexdump.fi` gibt den Tokenstrom im GENAU gleichen Format aus
// wie `firnc0 --emit=tokens`. `tools/lex_compare.sh` laesst beide ueber das
// ganze Quellkorpus laufen und vergleicht Oktett fuer Oktett. Das ist keine
// Selbstauskunft, sondern eine Gegenprobe gegen eine unabhaengige Umsetzung
// in einer anderen Sprache.
//
// AUFBAU: Struktur der Felder statt Feld der Strukturen. `Vec[T]` verlangt
// `T: Scalar`, ein Token ist aber ein Verbund — also liegen Art, Zeile,
// Spalte, Laenge, Zahlwert und Nummer in SECHS gleich langen `Vec`. Das ist
// nicht nur ein Ausweg: der Parser liest fast immer nur die Art.
//
// ZEICHEN GEGEN OKTETTE: `firnc0` arbeitet auf `Vec<char>`, Spalten zaehlen
// ZEICHEN. Dieser Lexer arbeitet auf Oktetten und zaehlt eine Spalte nur beim
// FUEHRENDEN Oktett eines UTF-8-Zeichens. Ohne das verschieben sich alle
// Spalten hinter einem Umlaut in derselben Zeile.

import rt
import vec
import intern
import diag

export { Lexer, lex_new, lex_free, lex_run, lex_count, lex_kind, lex_line,
         lex_col, lex_length, lex_number, lex_nr, lex_error,
         lex_lit_kind, lex_lit_len, lex_lit_byte, lex_lit_unit,
         lex_name_ptr, lex_name_length, lex_float_slow,
         tab_build, tab_count, tab_ptr, tab_length, Table, table_new, table_free,
         lex_diags, lex_names, lex_names_set,
         lex_kw_ptr, lex_kw_len, A_FSTR }

// ------------------------------------------------------------- Tokenarten
// Reihenfolge = Reihenfolge in `compiler/src/lexer.rs`.
const A_INT: u32 = 0
const A_IDENT: u32 = 1
const A_FLOAT: u32 = 2
const A_STR: u32 = 3
const A_KWFN: u32 = 4
const A_KWLET: u32 = 5
const A_KWVAR: u32 = 6
const A_KWIF: u32 = 7
const A_KWELSE: u32 = 8
const A_KWWHILE: u32 = 9
const A_KWRETURN: u32 = 10
const A_KWSTRUCT: u32 = 11
const A_KWCONST: u32 = 12
const A_KWPROFILE: u32 = 13
const A_KWAS: u32 = 14
const A_KWMUT: u32 = 15
const A_KWTRUE: u32 = 16
const A_KWFALSE: u32 = 17
const A_KWSYSCALL: u32 = 18
const A_KWEXTERN: u32 = 19
const A_KWBREAK: u32 = 20
const A_KWCONTINUE: u32 = 21
const A_KWDEFER: u32 = 22
const A_KWERRDEFER: u32 = 23
const A_KWCOMPTIME: u32 = 24
const A_KWFOR: u32 = 25
const A_KWIN: u32 = 26
const A_KWIMPORT: u32 = 27
const A_KWEXPORT: u32 = 28
const A_KWENUM: u32 = 29
const A_KWMATCH: u32 = 30
const A_KWERROR: u32 = 31
const A_KWTRY: u32 = 32
const A_KWCATCH: u32 = 33
const A_LPAREN: u32 = 34
const A_RPAREN: u32 = 35
const A_LBRACE: u32 = 36
const A_RBRACE: u32 = 37
const A_LBRACKET: u32 = 38
const A_RBRACKET: u32 = 39
const A_COMMA: u32 = 40
const A_COLON: u32 = 41
const A_SEMI: u32 = 42
const A_DOT: u32 = 43
const A_DOTDOT: u32 = 44
const A_ARROW: u32 = 45
const A_ASSIGN: u32 = 46
const A_PLUS: u32 = 47
const A_MINUS: u32 = 48
const A_STAR: u32 = 49
const A_SLASH: u32 = 50
const A_PERCENT: u32 = 51
const A_AMP: u32 = 52
const A_PIPE: u32 = 53
const A_CARET: u32 = 54
const A_SHL: u32 = 55
const A_SHR: u32 = 56
const A_ANDAND: u32 = 57
const A_OROR: u32 = 58
const A_NOT: u32 = 59
const A_QUESTION: u32 = 60
const A_HASH: u32 = 61
const A_EQEQ: u32 = 62
const A_NOTEQ: u32 = 63
const A_LT: u32 = 64
const A_LE: u32 = 65
const A_GT: u32 = 66
const A_GE: u32 = 67
const A_EOF: u32 = 68
const A_FSTR: u32 = 69

// Art eines Zeichenkettenliterals
const L_BYTES: u32 = 0
const L_STR: u32 = 1
const L_STR16: u32 = 2
// `f"..."` (Interpolation, Runde 39): die Literaltafel traegt den ROHEN
// Rumpf — entschluesselt und zerlegt wird erst im Parser.
const L_FSTR: u32 = 3

// ------------------------------------------------------------------- Tafel
// Firn hat keine veraenderlichen globalen Zustaende (Punkt 13 der Liste in
// docs/SELBSTHOSTING.md). Eine Worttafel kann also nicht als globale Konstante
// liegen — sie wird aus EINEM Literal gebaut, das mit '|' getrennt ist.
struct Table {
    txt: u64,
    off: Vec[u32],
    len: Vec[u32],
}

fn table_new() -> Table {
    return Table{ txt: 0, off: vec_new[u32](), len: vec_new[u32]() }
}

fn table_free(t: *mut Table) {
    vec_free[u32](&(*t).off)
    vec_free[u32](&(*t).len)
}

fn tab_build(t: *mut Table, p: u64, n: usize) {
    (*t).txt = p
    var start: usize = 0
    var i: usize = 0
    while i <= n {
        if i == n || rt.ld8(p, i) == 124 as u8 {
            vec_push[u32](&(*t).off, start as u32)
            vec_push[u32](&(*t).len, (i - start) as u32)
            start = i + 1
        }
        i = i + 1
    }
}

fn tab_count(t: *mut Table) -> usize { return vec_len[u32](&(*t).off) }
fn tab_ptr(t: *mut Table, i: usize) -> u64 { return (*t).txt + vec_at[u32](&(*t).off, i) as u64 }
fn tab_length(t: *mut Table, i: usize) -> usize { return vec_at[u32](&(*t).len, i) as usize }

// ------------------------------------------------------------------ Lexer

struct Lexer {
    q: u64,             // Quelltext (Oktette)
    n: usize,
    p: usize,           // Leseposition in OKTETTEN
    line: u32,
    col: u32,        // Spalte in ZEICHEN, 1-basiert
    kind: Vec[u32],
    zl: Vec[u32],
    spl: Vec[u32],
    ln: Vec[u32],
    number: Vec[u64],     // Int-Wert bzw. Bitmuster des f64
    nr: Vec[u32],       // Ident: Internnummer · Str: Index in die Literaltafel
    names: intern.Interner,
    // Ist dieser Zeiger gesetzt, wird STATT der eigenen Tafel eine gemeinsame
    // benutzt. Das Modulsystem braucht das: mehrere Dateien, ein Namensraum —
    // sonst meinte dieselbe Nummer in zwei Dateien zwei verschiedene Woerter.
    names_extern: u64,
    lit: rt.Buf,        // Inhalte aller Literale hintereinander
    lit_off: Vec[u32],  // Versatz in `lit` (in OKTETTEN)
    lit_len: Vec[u32],  // Laenge in ELEMENTEN (u16 bei Str16!)
    lit_kind: Vec[u32],
    kw: Table,
    kw_txt: u64,        // Schluesselworttext wie an `lex_neu` uebergeben —
    kw_len: usize,      // der Parser braucht ihn zum Lexen von Fragmenten
                        // (Interpolation, Runde 39)
    digits: Vec[u8],   // Kladde fuer die Ziffern eines Zahlliterals
    dg: diag.Diags,     // gesammelte Meldungen
    file: u32,         // Nummer der Quelldatei in der Karte
    msg: rt.Buf,        // Kladde fuer den Text einer Meldung
    float_slow: usize,
}

fn lex_new(q: u64, n: usize, kw_txt: u64, kw_len: usize, name: u64, name_n: usize) -> Lexer {
    var l: Lexer = Lexer{
        q: q, n: n, p: 0, line: 1, col: 1,
        kind: vec_new[u32](), zl: vec_new[u32](), spl: vec_new[u32](),
        ln: vec_new[u32](), number: vec_new[u64](), nr: vec_new[u32](),
        names: intern.intern_new(),
        names_extern: 0,
        lit: rt.buf_new(),
        lit_off: vec_new[u32](), lit_len: vec_new[u32](), lit_kind: vec_new[u32](),
        kw: table_new(),
        kw_txt: kw_txt, kw_len: kw_len,
        digits: vec_new[u8](),
        dg: diag.diag_new(),
        file: 0,
        msg: rt.buf_new(),
        float_slow: 0,
    }
    tab_build(&l.kw, kw_txt, kw_len)
    l.file = diag.diag_file(&l.dg, name, name_n, q, n)
    return l
}

fn lex_free(l: *mut Lexer) {
    vec_free[u32](&(*l).kind)
    vec_free[u32](&(*l).zl)
    vec_free[u32](&(*l).spl)
    vec_free[u32](&(*l).ln)
    vec_free[u64](&(*l).number)
    vec_free[u32](&(*l).nr)
    // Eine GEMEINSAME Tafel gehoert dem Aufrufer und wird hier nicht frei.
    if (*l).names_extern == 0 {
        intern.intern_free(&(*l).names)
    }
    rt.buf_free(&(*l).lit)
    vec_free[u32](&(*l).lit_off)
    vec_free[u32](&(*l).lit_len)
    vec_free[u32](&(*l).lit_kind)
    vec_free[u8](&(*l).digits)
    table_free(&(*l).kw)
    rt.buf_free(&(*l).msg)
    diag.diag_free(&(*l).dg)
}

fn lex_count(l: *mut Lexer) -> usize { return vec_len[u32](&(*l).kind) }
fn lex_kind(l: *mut Lexer, i: usize) -> u32 { return vec_at[u32](&(*l).kind, i) }
fn lex_kw_ptr(l: *mut Lexer) -> u64 { return (*l).kw_txt }
fn lex_kw_len(l: *mut Lexer) -> usize { return (*l).kw_len }
fn lex_line(l: *mut Lexer, i: usize) -> u32 { return vec_at[u32](&(*l).zl, i) }
fn lex_col(l: *mut Lexer, i: usize) -> u32 { return vec_at[u32](&(*l).spl, i) }
fn lex_length(l: *mut Lexer, i: usize) -> u32 { return vec_at[u32](&(*l).ln, i) }
fn lex_number(l: *mut Lexer, i: usize) -> u64 { return vec_at[u64](&(*l).number, i) }
fn lex_nr(l: *mut Lexer, i: usize) -> u32 { return vec_at[u32](&(*l).nr, i) }
fn lex_error(l: *mut Lexer) -> usize { return diag.diag_count(&(*l).dg) }
fn lex_diags(l: *mut Lexer) -> *mut diag.Diags { return &(*l).dg }
fn lex_names(l: *mut Lexer) -> *mut intern.Interner {
    if (*l).names_extern != 0 {
        return (*l).names_extern as *mut intern.Interner
    }
    return &(*l).names
}

// Muss VOR `lex_lauf` gesetzt werden.
fn lex_names_set(l: *mut Lexer, it: u64) {
    (*l).names_extern = it
}

// ---------------------------------------------------------------- Meldungen
//
// Der Text einer Meldung wird in `msg` zusammengesetzt und dann als
// Oktettfolge an `diag` uebergeben. Firn hat keine Textverkettung (Punkt 4 der
// Liste in docs/SELBSTHOSTING.md) — dieser Puffer IST die Verkettung.

fn m_on(l: *mut Lexer) {
    rt.buf_clear(&(*l).msg)
}

fn m_txt(l: *mut Lexer, p: u64, n: usize) {
    rt.buf_push_bytes(&(*l).msg, p, n)
}

fn m_number(l: *mut Lexer, v: u64) {
    rt.buf_push_dec_u64(&(*l).msg, v)
}

// Ein ZEICHEN der Quelle (alle Oktette) in die Meldung kopieren.
fn m_char(l: *mut Lexer, i: usize) {
    var w: usize = 1
    while i + w < (*l).n {
        if (oct(l, i + w) & 192) != 128 { break }
        w = w + 1
    }
    var k: usize = 0
    while k < w {
        rt.buf_push(&(*l).msg, oct(l, i + k) as u8)
        k = k + 1
    }
}

// Ein Codepunkt als vier GROSSE Hexziffern (`{:04X}` in Rust).
fn m_hex4(l: *mut Lexer, v: u64) {
    var i: i64 = 3
    while i >= 0 {
        let d: u64 = (v >> (i * 4) as u64) & 15
        if d < 10 {
            rt.buf_push(&(*l).msg, (48 + d) as u8)
        } else {
            rt.buf_push(&(*l).msg, (55 + d) as u8)
        }
        i = i - 1
    }
}

fn m_report(l: *mut Lexer, line: u32, col: u32, length: u32) {
    diag.diag_error(&(*l).dg, (*l).file, line, col, length,
                     rt.buf_ptr(&(*l).msg), rt.buf_len(&(*l).msg))
}
fn lex_float_slow(l: *mut Lexer) -> usize { return (*l).float_slow }

fn lex_lit_kind(l: *mut Lexer, k: usize) -> u32 { return vec_at[u32](&(*l).lit_kind, k) }
fn lex_lit_len(l: *mut Lexer, k: usize) -> usize { return vec_at[u32](&(*l).lit_len, k) as usize }

fn lex_lit_byte(l: *mut Lexer, k: usize, i: usize) -> u8 {
    return rt.ld8(rt.buf_ptr(&(*l).lit), vec_at[u32](&(*l).lit_off, k) as usize + i)
}

fn lex_lit_unit(l: *mut Lexer, k: usize, i: usize) -> u16 {
    let b: u64 = rt.buf_ptr(&(*l).lit) + vec_at[u32](&(*l).lit_off, k) as u64
    return rt.ld16(b, i)
}

fn lex_name_ptr(l: *mut Lexer, nr: u32) -> u64 {
    return intern.intern_ptr(lex_names(l), nr)
}

fn lex_name_length(l: *mut Lexer, nr: u32) -> usize {
    return intern.intern_length(lex_names(l), nr)
}

// ------------------------------------------------------------ Zeichenzugriff
// 256 bedeutet Dateiende — so bleibt der Vergleich mit einem Oktett eindeutig.

fn look(l: *mut Lexer, k: usize) -> u32 {
    if (*l).p + k >= (*l).n {
        return 256
    }
    return rt.ld8((*l).q, (*l).p + k) as u32
}

fn oct(l: *mut Lexer, i: usize) -> u32 {
    if i >= (*l).n {
        return 256
    }
    return rt.ld8((*l).q, i) as u32
}

// Ein OKTETT weiter. Zeile/Spalte werden nur beim fuehrenden Oktett
// nachgefuehrt — Fortsetzungsoktette (10xxxxxx) gehoeren zum selben Zeichen.
fn vor1(l: *mut Lexer) {
    if (*l).p >= (*l).n {
        return
    }
    let b: u8 = rt.ld8((*l).q, (*l).p)
    (*l).p = (*l).p + 1
    if (b & 192 as u8) == 128 as u8 {
        return
    }
    if b == 10 as u8 {
        (*l).line = (*l).line + 1
        (*l).col = 1
    } else {
        (*l).col = (*l).col + 1
    }
}

// Ein ZEICHEN weiter.
fn sign(l: *mut Lexer) {
    vor1(l)
    while (*l).p < (*l).n {
        let b: u8 = rt.ld8((*l).q, (*l).p)
        if (b & 192 as u8) != 128 as u8 {
            break
        }
        vor1(l)
    }
}

fn tok(l: *mut Lexer, kind: u32, line: u32, col: u32, length: u32, number: u64, nr: u32) {
    vec_push[u32](&(*l).kind, kind)
    vec_push[u32](&(*l).zl, line)
    vec_push[u32](&(*l).spl, col)
    vec_push[u32](&(*l).ln, length)
    vec_push[u64](&(*l).number, number)
    vec_push[u32](&(*l).nr, nr)
}

fn is_digit(c: u32) -> bool { return c >= 48 && c <= 57 }
fn is_letter(c: u32) -> bool { return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) }
fn is_name_start(c: u32) -> bool { return c == 95 || is_letter(c) }
fn is_name_next(c: u32) -> bool { return c == 95 || is_letter(c) || is_digit(c) }

// EHRLICHE GRENZE: `char::is_whitespace` in Rust kennt auch U+00A0, U+2028 und
// weitere. Hier zaehlt nur ASCII-Leerraum; alles andere wird zu 'unbekanntes
// zeichen'. Im gesamten Quellkorpus kommt kein Unicode-Leerraum vor.
fn is_empty(c: u32) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13 || c == 11 || c == 12
}

fn hex_value(c: u32) -> i32 {
    if c >= 48 && c <= 57 { return (c - 48) as i32 }
    if c >= 97 && c <= 102 { return (c - 97 + 10) as i32 }
    if c >= 65 && c <= 70 { return (c - 65 + 10) as i32 }
    return -1
}

// ------------------------------------------------- Leerraum und Kommentare

fn skip(l: *mut Lexer) {
    while true {
        let c: u32 = look(l, 0)
        if is_empty(c) {
            vor1(l)
        } else if c == 47 && look(l, 1) == 47 {
            while (*l).p < (*l).n {
                if look(l, 0) == 10 { break }
                vor1(l)
            }
        } else if c == 47 && look(l, 1) == 42 {
            let kz: u32 = (*l).line
            let ks: u32 = (*l).col
            vor1(l)
            vor1(l)
            var depth: usize = 1
            while depth > 0 {
                if (*l).p >= (*l).n {
                    var mk: [u8; 42] = "block comment is not closed ('*/' missing)"
                    m_on(l)
                    m_txt(l, (&mk[0]) as u64, 42)
                    m_report(l, kz, ks, 2)
                    break
                }
                if look(l, 0) == 47 && look(l, 1) == 42 {
                    vor1(l)
                    vor1(l)
                    depth = depth + 1
                } else if look(l, 0) == 42 && look(l, 1) == 47 {
                    vor1(l)
                    vor1(l)
                    depth = depth - 1
                } else {
                    vor1(l)
                }
            }
        } else {
            return
        }
    }
}

// --------------------------------------------------------------- Bezeichner

fn lex_name(l: *mut Lexer) {
    let line: u32 = (*l).line
    let col: u32 = (*l).col
    let start: usize = (*l).p
    while (*l).p < (*l).n {
        if !is_name_next(look(l, 0)) { break }
        vor1(l)
    }
    let len: usize = (*l).p - start
    var k: usize = 0
    while k < tab_count(&(*l).kw) {
        if tab_length(&(*l).kw, k) == len {
            if rt.mem_eq(tab_ptr(&(*l).kw, k), (*l).q + start as u64, len) {
                tok(l, 4 + k as u32, line, col, len as u32, 0, 0)
                return
            }
        }
        k = k + 1
    }
    let n: i64 = intern.intern_number(lex_names(l), (*l).q + start as u64, len)
    tok(l, A_IDENT, line, col, len as u32, 0, n as u32)
}

// -------------------------------------------------------------------- Zahlen

// Bitmuster eines binary64. Der Umweg ueber eine ADRESSE ist Absicht: ein
// direktes `(&t) as *mut u64` mit anschliessendem Lesen hat der Codegenerator
// in Stufe 0 als Wertumwandlung behandelt und die Zahl 1 statt des Musters
// 4607182418800017408 geliefert — der Fehler faellt nur auf, weil `firnc0`
// danebensteht. Ueber `rt.ld64` auf dieselbe Adresse ist es eine echte
// Neudeutung derselben acht Oktette.
fn bits_of(x: f64) -> u64 {
    var t: f64 = 0.0
    let p: u64 = (&t) as u64
    *(p as *mut f64) = x
    return rt.ld64(p, 0)
}

// 10^k ist fuer k <= 22 in binary64 EXAKT darstellbar, und das Produkt
// 10^(k-1) * 10 rundet genau auf 10^k. Deshalb ist diese Schleife exakt.
// 10^k als Ganzzahl; 0, wenn es nicht mehr in 64 Bit passt.
fn ten_high_whole(k: usize) -> u64 {
    if k > 19 {
        return 0
    }
    var t: u64 = 1
    var i: usize = 0
    while i < k {
        t = t * 10
        i = i + 1
    }
    return t
}

fn ten_high(k: usize) -> f64 {
    var t: f64 = 1.0
    var i: usize = 0
    while i < k {
        t = t * 10.0
        i = i + 1
    }
    return t
}

// Der schnelle Pfad von Clinger: passt die Mantisse in 2^53 und liegt der
// Zehnerexponent zwischen -22 und 22, dann ist EINE Multiplikation bzw.
// Division in binary64 korrekt gerundet — das Ergebnis stimmt also aufs Bit.
// Sonst wird gezaehlt (`gleit_langsam`) und schrittweise gerechnet; das kann
// um ein ULP danebenliegen. Ein vollstaendiger Algorithmus (Eisel-Lemire)
// braucht 128-Bit-Arithmetik und steht noch aus.
fn float_value(l: *mut Lexer, mant: u64, overflow: bool, e: i64) -> f64 {
    if !overflow && mant <= 9007199254740992 && e >= -22 && e <= 22 {
        let f: f64 = mant as f64
        if e >= 0 {
            return f * ten_high(e as usize)
        }
        return f / ten_high((0 - e) as usize)
    }
    // Erweiterung von Clinger: liegt der Exponent ueber 22, laesst sich der
    // Ueberschuss oft in die MANTISSE ziehen, solange sie exakt bleibt
    // (<= 2^53). Dann bleibt es bei EINER Multiplikation und damit bei EINER
    // Rundung — das Ergebnis ist weiterhin korrekt gerundet.
    if !overflow && e > 22 && e <= 37 {
        let excess: usize = (e - 22) as usize
        let factor: u64 = ten_high_whole(excess)
        if factor > 0 && mant <= 9007199254740992 / factor {
            return (mant * factor) as f64 * ten_high(22)
        }
    }
    (*l).float_slow = (*l).float_slow + 1
    var f: f64 = mant as f64
    var k: i64 = e
    while k > 0 {
        f = f * 10.0
        k = k - 1
    }
    while k < 0 {
        f = f / 10.0
        k = k + 1
    }
    return f
}

fn lex_float_rest(l: *mut Lexer, line: u32, col: u32, breite0: u32,
                  mant0: u64, ueber0: bool, n_before: usize) -> bool {
    var width: u32 = breite0
    var mant: u64 = mant0
    var over: bool = ueber0
    var n_after: i64 = 0
    let _ = n_before
    if look(l, 0) == 46 {
        vor1(l)
        width = width + 1
        while (*l).p < (*l).n {
            let c: u32 = look(l, 0)
            if c == 95 {
                vor1(l)
                width = width + 1
                continue
            }
            if !is_digit(c) { break }
            if mant > 1844674407370955161 {
                over = true
            } else {
                mant = mant * 10 + (c - 48) as u64
            }
            n_after = n_after + 1
            vor1(l)
            width = width + 1
        }
    }
    var expo: i64 = 0
    if look(l, 0) == 101 || look(l, 0) == 69 {
        vor1(l)
        width = width + 1
        var neg: bool = false
        if look(l, 0) == 43 || look(l, 0) == 45 {
            if look(l, 0) == 45 { neg = true }
            vor1(l)
            width = width + 1
        }
        var digits: usize = 0
        while (*l).p < (*l).n {
            let c: u32 = look(l, 0)
            if c == 95 {
                vor1(l)
                width = width + 1
                continue
            }
            if !is_digit(c) { break }
            if expo < 100000 {
                expo = expo * 10 + (c - 48) as i64
            }
            digits = digits + 1
            vor1(l)
            width = width + 1
        }
        if digits == 0 {
            var b: u32 = width
            if b < 1 { b = 1 }
            var me: [u8; 72] = "floating point literal: the digits of the exponent are missing after 'e'"
            m_on(l)
            m_txt(l, (&me[0]) as u64, 72)
            m_report(l, line, col, b)
            tok(l, A_FLOAT, line, col, b, 0, 0)
            return true
        }
        if neg { expo = 0 - expo }
    }
    let f: f64 = float_value(l, mant, over, expo - n_after)
    var b2: u32 = width
    if b2 < 1 { b2 = 1 }
    tok(l, A_FLOAT, line, col, b2, bits_of(f), 0)
    return true
}

fn lex_int(l: *mut Lexer) {
    let line: u32 = (*l).line
    let col: u32 = (*l).col
    var width: u32 = 0
    var base: u32 = 10
    if look(l, 0) == 48 {
        let c2: u32 = look(l, 1)
        if c2 == 120 || c2 == 88 {
            base = 16
        } else if c2 == 98 || c2 == 66 {
            base = 2
        }
        if base != 10 {
            vor1(l)
            vor1(l)
            width = width + 2
        }
    }
    vec_clear[u8](&(*l).digits)
    var bad: bool = false
    var s_line: u32 = 0
    var s_col: u32 = 0
    var s_pos: usize = 0
    while (*l).p < (*l).n {
        let c: u32 = look(l, 0)
        if c == 95 {
            vor1(l)
            width = width + 1
            continue
        }
        if !(is_digit(c) || is_letter(c)) {
            break
        }
        // Bei Basis 10 beendet ein 'e'/'E' mit folgender Ziffer oder Vorzeichen
        // die Ganzzahl — sonst waere '1e3' eine ungueltige Ziffer.
        if base == 10 && (c == 101 || c == 69) {
            let c2: u32 = look(l, 1)
            if is_digit(c2) || c2 == 43 || c2 == 45 {
                break
            }
        }
        let w: i32 = hex_value(c)
        if w >= 0 && (w as u32) < base {
            vec_push[u8](&(*l).digits, w as u8)
        } else {
            // Nur die ERSTE ungueltige Ziffer wird gemeldet.
            if !bad {
                bad = true
                s_line = (*l).line
                s_col = (*l).col
                s_pos = (*l).p
            }
        }
        vor1(l)
        width = width + 1
    }
    let cnt: usize = vec_len[u8](&(*l).digits)
    // Gleitkomma nur zur Basis 10.
    if base == 10 && !bad && cnt > 0 {
        let dot: bool = look(l, 0) == 46 && is_digit(look(l, 1))
        var expo: bool = false
        if look(l, 0) == 101 || look(l, 0) == 69 {
            let c2: u32 = look(l, 1)
            expo = is_digit(c2) || c2 == 43 || c2 == 45
        }
        if dot || expo {
            var m: u64 = 0
            var ue: bool = false
            var i: usize = 0
            while i < cnt {
                if m > 1844674407370955161 {
                    ue = true
                } else {
                    m = m * 10 + vec_at[u8](&(*l).digits, i) as u64
                }
                i = i + 1
            }
            lex_float_rest(l, line, col, width, m, ue, cnt)
            return
        }
    }
    var b: u32 = width
    if b < 1 { b = 1 }
    if bad {
        var m1: [u8; 19] = "invalid character '"
        var m2: [u8; 32] = "' in an integer literal to base "
        m_on(l)
        m_txt(l, (&m1[0]) as u64, 19)
        m_char(l, s_pos)
        m_txt(l, (&m2[0]) as u64, 32)
        m_number(l, base as u64)
        m_report(l, s_line, s_col, 1)
        tok(l, A_INT, line, col, b, 0, 0)
        return
    }
    if cnt == 0 {
        var m3: [u8; 37] = "integer literal without digits (base "
        m_on(l)
        m_txt(l, (&m3[0]) as u64, 37)
        m_number(l, base as u64)
        var m4: [u8; 1] = ")"
        m_txt(l, (&m4[0]) as u64, 1)
        m_report(l, line, col, b)
        tok(l, A_INT, line, col, b, 0, 0)
        return
    }
    var value: u64 = 0
    var zu_big: bool = false
    var i: usize = 0
    while i < cnt {
        let d: u64 = vec_at[u8](&(*l).digits, i) as u64
        let limit: u64 = (18446744073709551615 - d) / base as u64
        if value > limit {
            zu_big = true
            break
        }
        value = value * base as u64 + d
        i = i + 1
    }
    if zu_big {
        var m5: [u8; 47] = "integer literal is too large (more than 64 bit)"
        m_on(l)
        m_txt(l, (&m5[0]) as u64, 47)
        m_report(l, line, col, b)
        tok(l, A_INT, line, col, b, 0, 0)
        return
    }
    tok(l, A_INT, line, col, b, value, 0)
}

// -------------------------------------------------------- Satz- und Rechenzeichen

// `false`, wenn das Zeichen unbekannt ist.
fn lex_char(l: *mut Lexer) -> bool {
    let line: u32 = (*l).line
    let col: u32 = (*l).col
    let c: u32 = look(l, 0)
    if c == 256 {
        return true
    }
    let n: u32 = look(l, 1)
    var kind: u32 = 999
    var width: u32 = 1
    if c == 45 && n == 62 { kind = A_ARROW; width = 2 }
    else if c == 46 && n == 46 { kind = A_DOTDOT; width = 2 }
    else if c == 60 && n == 60 { kind = A_SHL; width = 2 }
    else if c == 62 && n == 62 { kind = A_SHR; width = 2 }
    else if c == 38 && n == 38 { kind = A_ANDAND; width = 2 }
    else if c == 124 && n == 124 { kind = A_OROR; width = 2 }
    else if c == 61 && n == 61 { kind = A_EQEQ; width = 2 }
    else if c == 33 && n == 61 { kind = A_NOTEQ; width = 2 }
    else if c == 60 && n == 61 { kind = A_LE; width = 2 }
    else if c == 62 && n == 61 { kind = A_GE; width = 2 }
    else if c == 40 { kind = A_LPAREN }
    else if c == 41 { kind = A_RPAREN }
    else if c == 123 { kind = A_LBRACE }
    else if c == 125 { kind = A_RBRACE }
    else if c == 91 { kind = A_LBRACKET }
    else if c == 93 { kind = A_RBRACKET }
    else if c == 44 { kind = A_COMMA }
    else if c == 58 { kind = A_COLON }
    else if c == 59 { kind = A_SEMI }
    else if c == 46 { kind = A_DOT }
    else if c == 61 { kind = A_ASSIGN }
    else if c == 43 { kind = A_PLUS }
    else if c == 45 { kind = A_MINUS }
    else if c == 42 { kind = A_STAR }
    else if c == 47 { kind = A_SLASH }
    else if c == 37 { kind = A_PERCENT }
    else if c == 38 { kind = A_AMP }
    else if c == 124 { kind = A_PIPE }
    else if c == 94 { kind = A_CARET }
    else if c == 35 { kind = A_HASH }
    else if c == 33 { kind = A_NOT }
    else if c == 63 { kind = A_QUESTION }
    else if c == 60 { kind = A_LT }
    else if c == 62 { kind = A_GT }
    else { return false }
    var i: u32 = 0
    while i < width {
        vor1(l)
        i = i + 1
    }
    tok(l, kind, line, col, width, 0, 0)
    return true
}

// ------------------------------------------------------ Zeichenkettenliterale

fn push_utf8(l: *mut Lexer, cp: u32) {
    if cp < 128 {
        rt.buf_push(&(*l).lit, cp as u8)
    } else if cp < 2048 {
        rt.buf_push(&(*l).lit, (192 + (cp >> 6)) as u8)
        rt.buf_push(&(*l).lit, (128 + (cp & 63)) as u8)
    } else if cp < 65536 {
        rt.buf_push(&(*l).lit, (224 + (cp >> 12)) as u8)
        rt.buf_push(&(*l).lit, (128 + ((cp >> 6) & 63)) as u8)
        rt.buf_push(&(*l).lit, (128 + (cp & 63)) as u8)
    } else {
        rt.buf_push(&(*l).lit, (240 + (cp >> 18)) as u8)
        rt.buf_push(&(*l).lit, (128 + ((cp >> 12) & 63)) as u8)
        rt.buf_push(&(*l).lit, (128 + ((cp >> 6) & 63)) as u8)
        rt.buf_push(&(*l).lit, (128 + (cp & 63)) as u8)
    }
}

fn push_u16(l: *mut Lexer, v: u32) {
    rt.buf_push(&(*l).lit, (v & 255) as u8)
    rt.buf_push(&(*l).lit, ((v >> 8) & 255) as u8)
}

fn push_utf16(l: *mut Lexer, cp: u32) {
    if cp > 65535 {
        let r: u32 = cp - 65536
        push_u16(l, 55296 + (r >> 10))
        push_u16(l, 56320 + (r & 1023))
    } else {
        push_u16(l, cp)
    }
}

// Codepunkt eines UTF-8-Zeichens ab `i` mit `w` Oktetten.
fn utf8_code_point(l: *mut Lexer, i: usize, w: usize) -> u32 {
    let b0: u32 = oct(l, i)
    if w == 1 { return b0 }
    if w == 2 { return ((b0 & 31) << 6) | (oct(l, i + 1) & 63) }
    if w == 3 {
        return ((b0 & 15) << 12) | ((oct(l, i + 1) & 63) << 6) | (oct(l, i + 2) & 63)
    }
    return ((b0 & 7) << 18) | ((oct(l, i + 1) & 63) << 12) | ((oct(l, i + 2) & 63) << 6) | (oct(l, i + 3) & 63)
}

// Genau `anz` Hexziffern ab `i`; -1, wenn eine fehlt.
fn hex_fixed(l: *mut Lexer, i: usize, cnt: usize, end: usize) -> i64 {
    if i + cnt > end { return -1 }
    var v: i64 = 0
    var k: usize = 0
    while k < cnt {
        let h: i32 = hex_value(oct(l, i + k))
        if h < 0 { return -1 }
        v = v * 16 + h as i64
        k = k + 1
    }
    return v
}

// `\uXXXX` bzw. `\u{...}` ab `i` lesen. Rueckgabe: (breite << 32) | codepunkt,
// oder -1 bei Fehler. Firn hat keine Mehrfachrueckgabe — deshalb gepackt.
// Fehlercodes, damit die Meldung genau die von `firnc0` ist:
//   -1 nicht-hexadezimale Ziffer in `\u{...}`
//   -2 Codepunkt ueber U+10FFFF
//   -3 `\u{...}` nicht abgeschlossen
//   -4 `\uXXXX` ohne vier Hexziffern
fn read_u_escape(l: *mut Lexer, i: usize, end: usize) -> i64 {
    if oct(l, i) == 123 {
        var j: usize = i + 1
        var v: i64 = 0
        var n: usize = 0
        while j < end {
            let d: u32 = oct(l, j)
            if d == 125 { break }
            let h: i32 = hex_value(d)
            if h < 0 { return -1 }
            v = v * 16 + h as i64
            if v > 1114111 { return -2 }
            n = n + 1
            j = j + 1
        }
        if n == 0 || j >= end || oct(l, j) != 125 { return -3 }
        let br: i64 = (j + 1 - i) as i64
        return (br << 32) | v
    }
    let v: i64 = hex_fixed(l, i, 4, end)
    if v < 0 { return -4 }
    return (4 << 32) | v
}

fn is_high_surrogate(cp: i64) -> bool { return cp >= 55296 && cp <= 56319 }
fn is_deep_surrogate(cp: i64) -> bool { return cp >= 56320 && cp <= 57343 }

// Folgt ab `i` ein maskiertes NIEDRIGES Surrogat? Rueckgabe wie oben.
fn peek_deep(l: *mut Lexer, i: usize, end: usize) -> i64 {
    if i + 1 >= end { return -1 }
    if oct(l, i) != 92 || oct(l, i + 1) != 117 { return -1 }
    let r: i64 = read_u_escape(l, i + 2, end)
    if r < 0 { return -1 }
    let cp: i64 = r & 4294967295
    if !is_deep_surrogate(cp) { return -1 }
    let br: i64 = (r >> 32) + 2
    return (br << 32) | cp
}

// Meldung eines Literalfehlers. Rust setzt die Spalte auf
// `spalte + off`, wobei `off` ZEICHEN vom Anfang des Literals zaehlt
// (einschliesslich `b`/`u` und Anfuehrungszeichen), und stellt jeder Meldung
// "in a string literal: " voran.
fn lit_on(l: *mut Lexer) {
    var v: [u8; 21] = "in a string literal: "
    m_on(l)
    m_txt(l, (&v[0]) as u64, 21)
}

fn lit_report(l: *mut Lexer, line: u32, col: u32, off: usize) {
    m_report(l, line, col + off as u32, 1)
}

// Entschluesselt den Rumpf [bs, be) und haengt ihn an `lit`. `false` = Fehler.
// `lead` sind die Zeichen vor dem Rumpf (1 bei `"`, 2 bei `b"`/`u"`).
fn decode(l: *mut Lexer, kind: u32, bs: usize, be: usize,
                  line: u32, col: u32, lead: usize) -> bool {
    var i: usize = bs
    var zi: usize = 0        // Zeichenzaehler im Rumpf
    var good: bool = true
    while i < be {
        let b: u32 = oct(l, i)
        if b != 92 {
            var w: usize = 1
            while i + w < be {
                if (oct(l, i + w) & 192) != 128 { break }
                w = w + 1
            }
            if kind == L_BYTES {
                if b > 127 {
                    var e1: [u8; 11] = "character '"
                    var e2: [u8; 61] = "' is not allowed in a Bytes literal, write the octets as \\xNN"
                    lit_on(l)
                    m_txt(l, (&e1[0]) as u64, 11)
                    m_char(l, i)
                    m_txt(l, (&e2[0]) as u64, 61)
                    lit_report(l, line, col, lead + zi)
                    good = false
                } else {
                    rt.buf_push(&(*l).lit, b as u8)
                }
            } else if kind == L_STR {
                var k: usize = 0
                while k < w {
                    rt.buf_push(&(*l).lit, oct(l, i + k) as u8)
                    k = k + 1
                }
            } else {
                push_utf16(l, utf8_code_point(l, i, w))
            }
            i = i + w
            zi = zi + 1
            continue
        }
        let start: usize = zi          // Zeichenindex des Rueckstrichs
        i = i + 1
        zi = zi + 1
        if i >= be {
            var e3: [u8; 32] = "escape at the end of the literal"
            lit_on(l)
            m_txt(l, (&e3[0]) as u64, 32)
            lit_report(l, line, col, lead + start)
            return false
        }
        let e: u32 = oct(l, i)
        let e_pos: usize = i
        var ew: usize = 1
        while i + ew < be {
            if (oct(l, i + ew) & 192) != 128 { break }
            ew = ew + 1
        }
        i = i + ew
        zi = zi + 1
        var v: i64 = -1
        if e == 110 { v = 10 }
        else if e == 114 { v = 13 }
        else if e == 116 { v = 9 }
        else if e == 48 { v = 0 }
        else if e == 92 { v = 92 }
        else if e == 34 { v = 34 }
        else if e == 39 { v = 39 }
        if v >= 0 {
            if kind == L_STR16 {
                push_u16(l, v as u32)
            } else {
                rt.buf_push(&(*l).lit, v as u8)
            }
            continue
        }
        if e == 120 {
            let h: i64 = hex_fixed(l, i, 2, be)
            if h < 0 {
                var e4: [u8; 41] = "\\x expects exactly two hexadecimal digits"
                lit_on(l)
                m_txt(l, (&e4[0]) as u64, 41)
                lit_report(l, line, col, lead + start)
                return false
            }
            i = i + 2
            zi = zi + 2
            if kind == L_STR && h > 127 {
                var e5: [u8; 57] = "\\xNN above 0x7F does not yield valid UTF-8, write \\u{...}"
                lit_on(l)
                m_txt(l, (&e5[0]) as u64, 57)
                lit_report(l, line, col, lead + start)
                good = false
                continue
            }
            if kind == L_STR16 {
                push_u16(l, h as u32)
            } else {
                rt.buf_push(&(*l).lit, h as u8)
            }
            continue
        }
        if e == 117 {
            let r: i64 = read_u_escape(l, i, be)
            if r < 0 {
                lit_on(l)
                if r == 0 - 1 {
                    var f1: [u8; 34] = "\\u{...} expects hexadecimal digits"
                    m_txt(l, (&f1[0]) as u64, 34)
                } else if r == 0 - 2 {
                    var f2: [u8; 46] = "code point above U+10FFFF is not representable"
                    m_txt(l, (&f2[0]) as u64, 46)
                } else if r == 0 - 3 {
                    var f3: [u8; 25] = "\\u{...} is not terminated"
                    m_txt(l, (&f3[0]) as u64, 25)
                } else {
                    var f4: [u8; 42] = "\\u expects exactly four hexadecimal digits"
                    m_txt(l, (&f4[0]) as u64, 42)
                }
                lit_report(l, line, col, lead + start)
                return false
            }
            let cp: i64 = r & 4294967295
            let br: usize = (r >> 32) as usize
            i = i + br
            zi = zi + br
            if kind == L_BYTES {
                var f5: [u8; 56] = "\\u is not allowed in a Bytes literal (Bytes is not text)"
                lit_on(l)
                m_txt(l, (&f5[0]) as u64, 56)
                lit_report(l, line, col, lead + start)
                return false
            }
            if kind == L_STR16 {
                if cp > 65535 {
                    push_utf16(l, cp as u32)
                } else {
                    push_u16(l, cp as u32)
                }
                continue
            }
            // `Str` ist geprueftes UTF-8: ein ungepaartes Surrogat ist ein
            // Fehler, ein Paar wird zu EINEM Codepunkt vereinigt.
            var unpaired: bool = false
            if is_high_surrogate(cp) {
                let t: i64 = peek_deep(l, i, be)
                if t < 0 {
                    unpaired = true
                } else {
                    let tb: usize = (t >> 32) as usize
                    i = i + tb
                    zi = zi + tb
                    let lo: i64 = t & 4294967295
                    push_utf8(l, (65536 + ((cp - 55296) << 10) + (lo - 56320)) as u32)
                }
            } else if is_deep_surrogate(cp) {
                unpaired = true
            } else {
                push_utf8(l, cp as u32)
            }
            if unpaired {
                var g1: [u8; 21] = "unpaired surrogate U+"
                var g2: [u8; 62] = " in a Str literal; Str is checked UTF-8 — use u\"...\" (Str16)"
                lit_on(l)
                m_txt(l, (&g1[0]) as u64, 21)
                m_hex4(l, cp as u64)
                m_txt(l, (&g2[0]) as u64, 62)
                lit_report(l, line, col, lead + start)
                return false
            }
            continue
        }
        var h1: [u8; 17] = "unknown escape '\\"
        var h2: [u8; 1] = "'"
        lit_on(l)
        m_txt(l, (&h1[0]) as u64, 17)
        m_char(l, e_pos)
        m_txt(l, (&h2[0]) as u64, 1)
        lit_report(l, line, col, lead + start)
        return false
    }
    return good
}

// `false`, wenn an dieser Stelle kein Literal steht.
fn lex_text(l: *mut Lexer) -> bool {
    let c0: u32 = look(l, 0)
    var kind: u32 = 0
    var front: usize = 0
    if c0 == 34 {
        kind = L_STR
        front = 0
    } else if c0 == 98 && look(l, 1) == 34 {
        kind = L_BYTES
        front = 1
    } else if c0 == 117 && look(l, 1) == 34 {
        kind = L_STR16
        front = 1
    } else if c0 == 102 && look(l, 1) == 34 {
        kind = L_FSTR
        front = 1
    } else {
        return false
    }
    let line: u32 = (*l).line
    let col: u32 = (*l).col
    let bs: usize = (*l).p + front + 1
    var i: usize = bs
    var chars: usize = front + 1
    var closed: bool = false
    var be: usize = (*l).n
    while i < (*l).n {
        let b: u32 = oct(l, i)
        if b == 92 {
            i = i + 1
            chars = chars + 1
            if i >= (*l).n { break }
            if oct(l, i) == 10 { break }
            i = i + 1
            chars = chars + 1
            while i < (*l).n {
                if (oct(l, i) & 192) != 128 { break }
                i = i + 1
            }
            continue
        }
        if b == 34 {
            be = i
            closed = true
            i = i + 1
            chars = chars + 1
            break
        }
        if b == 10 {
            be = i
            break
        }
        i = i + 1
        chars = chars + 1
        while i < (*l).n {
            if (oct(l, i) & 192) != 128 { break }
            i = i + 1
        }
    }
    if !closed {
        be = i
    }
    var z: usize = 0
    while z < chars {
        sign(l)
        z = z + 1
    }
    let offset: usize = rt.buf_len(&(*l).lit)
    var good: bool = closed
    if closed && kind == L_FSTR {
        // Interpolation: der Rumpf bleibt ROH — das Zerlegen in Text- und
        // Ausdruckssegmente samt Entschluesseln macht der Parser (Runde 39).
        rt.buf_push_bytes(&(*l).lit, (*l).q + bs as u64, be - bs)
    } else if closed {
        good = decode(l, kind, bs, be, line, col, front + 1)
    } else {
        // Der Versatz ist hier `lead + Zeichen im Rumpf` — genau das steht in
        // `zeichen`, weil der Zaehler bei `lead` beginnt und das schliessende
        // Anfuehrungszeichen nie gelesen wurde.
        var u1: [u8; 34] = "string literal without a closing \""
        lit_on(l)
        m_txt(l, (&u1[0]) as u64, 34)
        lit_report(l, line, col, chars)
    }
    if !good {
        // Weiterlexen mit einem LEEREN Literal — genau wie firnc0, damit
        // Folgefehler nicht auf eine kaputte Tokenfolge zurueckgehen.
        rt.buf_set_len(&(*l).lit, offset)
    }
    let bytes: usize = rt.buf_len(&(*l).lit) - offset
    var elems: usize = bytes
    if kind == L_STR16 {
        elems = bytes / 2
    }
    let k: usize = vec_len[u32](&(*l).lit_off)
    vec_push[u32](&(*l).lit_off, offset as u32)
    vec_push[u32](&(*l).lit_len, elems as u32)
    vec_push[u32](&(*l).lit_kind, kind)
    var tkind: u32 = A_STR
    if kind == L_FSTR {
        tkind = A_FSTR
    }
    tok(l, tkind, line, col, chars as u32, 0, k as u32)
    return true
}

// ------------------------------------------------------------------- Lauf

fn lex_run(l: *mut Lexer) {
    while true {
        skip(l)
        let c: u32 = look(l, 0)
        if c == 256 {
            break
        }
        if lex_text(l) {
            continue
        }
        if is_digit(c) {
            lex_int(l)
        } else if is_name_start(c) {
            lex_name(l)
        } else if !lex_char(l) {
            var w1: [u8; 19] = "unknown character '"
            var w2: [u8; 20] = "' in the source text"
            let uz: u32 = (*l).line
            let us: u32 = (*l).col
            m_on(l)
            m_txt(l, (&w1[0]) as u64, 19)
            m_char(l, (*l).p)
            m_txt(l, (&w2[0]) as u64, 20)
            m_report(l, uz, us, 1)
            sign(l)
        }
    }
    tok(l, A_EOF, (*l).line, (*l).col, 0, 0, 0)
}
