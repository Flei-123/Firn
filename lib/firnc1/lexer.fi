// lib/firnc1/lexer.fi — DER LEXER VON FIRN, GESCHRIEBEN IN FIRN.
//
// Erster Teil von Stufe 1 (docs/SELBSTHOSTING.md §2, Punkt 5). Der Lexer hat
// die kleinste Schnittstelle im ganzen Compiler — Text hinein, Tokenfeld
// hinaus — und braucht genau die Bausteine, die seit Runde 15 bis 19 stehen:
// Allokator (`rt`), `Vec[T]` und `Interner`.
//
// MASSSTAB: `bin/lexdump.fi` gibt den Tokenstrom im GENAU gleichen Format aus
// wie `firnc0 --emit=tokens`. `tools/lex_vergleich.sh` laesst beide ueber das
// ganze Quellkorpus laufen und vergleicht Oktett fuer Oktett. Das ist keine
// Selbstauskunft, sondern eine Gegenprobe gegen eine unabhaengige Umsetzung
// in einer anderen Sprache.
//
// AUFBAU: Struktur der Felder statt Feld der Strukturen. `Vec[T]` verlangt
// `T: Scalar`, ein Token ist aber ein Verbund — also liegen Art, Zeile,
// Spalte, Laenge, Zahlwert und Nummer in SECHS gleich langen `Vec`. Das ist
// nicht nur ein Ausweg: der Parser liest fast immer nur die Art.
//
// ZEICHEN GEGEN OKTETTE: `firnc0` arbeitet auf `Vec<char>`, Spalten zaehlen
// ZEICHEN. Dieser Lexer arbeitet auf Oktetten und zaehlt eine Spalte nur beim
// FUEHRENDEN Oktett eines UTF-8-Zeichens. Ohne das verschieben sich alle
// Spalten hinter einem Umlaut in derselben Zeile.

import rt
import vec
import intern
import diag

export { Lexer, lex_neu, lex_frei, lex_lauf, lex_anzahl, lex_art, lex_zeile,
         lex_spalte, lex_laenge, lex_zahl, lex_nr, lex_fehler,
         lex_lit_art, lex_lit_len, lex_lit_byte, lex_lit_einheit,
         lex_name_zeiger, lex_name_laenge, lex_gleit_langsam,
         tab_bauen, tab_anzahl, tab_zeiger, tab_laenge, Tafel, tafel_neu, tafel_frei,
         lex_diags, lex_namen }

// ------------------------------------------------------------- Tokenarten
// Reihenfolge = Reihenfolge in `compiler/src/lexer.rs`.
const A_INT: u32 = 0
const A_IDENT: u32 = 1
const A_FLOAT: u32 = 2
const A_STR: u32 = 3
const A_KWFN: u32 = 4
const A_KWLET: u32 = 5
const A_KWVAR: u32 = 6
const A_KWIF: u32 = 7
const A_KWELSE: u32 = 8
const A_KWWHILE: u32 = 9
const A_KWRETURN: u32 = 10
const A_KWSTRUCT: u32 = 11
const A_KWCONST: u32 = 12
const A_KWPROFILE: u32 = 13
const A_KWAS: u32 = 14
const A_KWMUT: u32 = 15
const A_KWTRUE: u32 = 16
const A_KWFALSE: u32 = 17
const A_KWSYSCALL: u32 = 18
const A_KWEXTERN: u32 = 19
const A_KWBREAK: u32 = 20
const A_KWCONTINUE: u32 = 21
const A_KWDEFER: u32 = 22
const A_KWERRDEFER: u32 = 23
const A_KWCOMPTIME: u32 = 24
const A_KWFOR: u32 = 25
const A_KWIN: u32 = 26
const A_KWIMPORT: u32 = 27
const A_KWEXPORT: u32 = 28
const A_KWENUM: u32 = 29
const A_KWMATCH: u32 = 30
const A_KWERROR: u32 = 31
const A_KWTRY: u32 = 32
const A_KWCATCH: u32 = 33
const A_LPAREN: u32 = 34
const A_RPAREN: u32 = 35
const A_LBRACE: u32 = 36
const A_RBRACE: u32 = 37
const A_LBRACKET: u32 = 38
const A_RBRACKET: u32 = 39
const A_COMMA: u32 = 40
const A_COLON: u32 = 41
const A_SEMI: u32 = 42
const A_DOT: u32 = 43
const A_DOTDOT: u32 = 44
const A_ARROW: u32 = 45
const A_ASSIGN: u32 = 46
const A_PLUS: u32 = 47
const A_MINUS: u32 = 48
const A_STAR: u32 = 49
const A_SLASH: u32 = 50
const A_PERCENT: u32 = 51
const A_AMP: u32 = 52
const A_PIPE: u32 = 53
const A_CARET: u32 = 54
const A_SHL: u32 = 55
const A_SHR: u32 = 56
const A_ANDAND: u32 = 57
const A_OROR: u32 = 58
const A_NOT: u32 = 59
const A_QUESTION: u32 = 60
const A_HASH: u32 = 61
const A_EQEQ: u32 = 62
const A_NOTEQ: u32 = 63
const A_LT: u32 = 64
const A_LE: u32 = 65
const A_GT: u32 = 66
const A_GE: u32 = 67
const A_EOF: u32 = 68

// Art eines Zeichenkettenliterals
const L_BYTES: u32 = 0
const L_STR: u32 = 1
const L_STR16: u32 = 2

// ------------------------------------------------------------------- Tafel
// Firn hat keine veraenderlichen globalen Zustaende (Punkt 13 der Liste in
// docs/SELBSTHOSTING.md). Eine Worttafel kann also nicht als globale Konstante
// liegen — sie wird aus EINEM Literal gebaut, das mit '|' getrennt ist.
struct Tafel {
    txt: u64,
    off: Vec[u32],
    laen: Vec[u32],
}

fn tafel_neu() -> Tafel {
    return Tafel{ txt: 0, off: vec_neu[u32](), laen: vec_neu[u32]() }
}

fn tafel_frei(t: *mut Tafel) {
    vec_frei[u32](&(*t).off)
    vec_frei[u32](&(*t).laen)
}

fn tab_bauen(t: *mut Tafel, p: u64, n: usize) {
    (*t).txt = p
    var start: usize = 0
    var i: usize = 0
    while i <= n {
        if i == n || rt.ld8(p, i) == 124 as u8 {
            vec_push[u32](&(*t).off, start as u32)
            vec_push[u32](&(*t).laen, (i - start) as u32)
            start = i + 1
        }
        i = i + 1
    }
}

fn tab_anzahl(t: *mut Tafel) -> usize { return vec_len[u32](&(*t).off) }
fn tab_zeiger(t: *mut Tafel, i: usize) -> u64 { return (*t).txt + vec_at[u32](&(*t).off, i) as u64 }
fn tab_laenge(t: *mut Tafel, i: usize) -> usize { return vec_at[u32](&(*t).laen, i) as usize }

// ------------------------------------------------------------------ Lexer

struct Lexer {
    q: u64,             // Quelltext (Oktette)
    n: usize,
    p: usize,           // Leseposition in OKTETTEN
    zeile: u32,
    spalte: u32,        // Spalte in ZEICHEN, 1-basiert
    art: Vec[u32],
    zl: Vec[u32],
    spl: Vec[u32],
    ln: Vec[u32],
    zahl: Vec[u64],     // Int-Wert bzw. Bitmuster des f64
    nr: Vec[u32],       // Ident: Internnummer · Str: Index in die Literaltafel
    namen: intern.Interner,
    lit: rt.Buf,        // Inhalte aller Literale hintereinander
    lit_off: Vec[u32],  // Versatz in `lit` (in OKTETTEN)
    lit_len: Vec[u32],  // Laenge in ELEMENTEN (u16 bei Str16!)
    lit_art: Vec[u32],
    kw: Tafel,
    ziffern: Vec[u8],   // Kladde fuer die Ziffern eines Zahlliterals
    dg: diag.Diags,     // gesammelte Meldungen
    datei: u32,         // Nummer der Quelldatei in der Karte
    msg: rt.Buf,        // Kladde fuer den Text einer Meldung
    gleit_langsam: usize,
}

fn lex_neu(q: u64, n: usize, kw_txt: u64, kw_len: usize, name: u64, name_n: usize) -> Lexer {
    var l: Lexer = Lexer{
        q: q, n: n, p: 0, zeile: 1, spalte: 1,
        art: vec_neu[u32](), zl: vec_neu[u32](), spl: vec_neu[u32](),
        ln: vec_neu[u32](), zahl: vec_neu[u64](), nr: vec_neu[u32](),
        namen: intern.intern_neu(),
        lit: rt.buf_neu(),
        lit_off: vec_neu[u32](), lit_len: vec_neu[u32](), lit_art: vec_neu[u32](),
        kw: tafel_neu(),
        ziffern: vec_neu[u8](),
        dg: diag.diag_neu(),
        datei: 0,
        msg: rt.buf_neu(),
        gleit_langsam: 0,
    }
    tab_bauen(&l.kw, kw_txt, kw_len)
    l.datei = diag.diag_datei(&l.dg, name, name_n, q, n)
    return l
}

fn lex_frei(l: *mut Lexer) {
    vec_frei[u32](&(*l).art)
    vec_frei[u32](&(*l).zl)
    vec_frei[u32](&(*l).spl)
    vec_frei[u32](&(*l).ln)
    vec_frei[u64](&(*l).zahl)
    vec_frei[u32](&(*l).nr)
    intern.intern_frei(&(*l).namen)
    rt.buf_frei(&(*l).lit)
    vec_frei[u32](&(*l).lit_off)
    vec_frei[u32](&(*l).lit_len)
    vec_frei[u32](&(*l).lit_art)
    vec_frei[u8](&(*l).ziffern)
    tafel_frei(&(*l).kw)
    rt.buf_frei(&(*l).msg)
    diag.diag_frei(&(*l).dg)
}

fn lex_anzahl(l: *mut Lexer) -> usize { return vec_len[u32](&(*l).art) }
fn lex_art(l: *mut Lexer, i: usize) -> u32 { return vec_at[u32](&(*l).art, i) }
fn lex_zeile(l: *mut Lexer, i: usize) -> u32 { return vec_at[u32](&(*l).zl, i) }
fn lex_spalte(l: *mut Lexer, i: usize) -> u32 { return vec_at[u32](&(*l).spl, i) }
fn lex_laenge(l: *mut Lexer, i: usize) -> u32 { return vec_at[u32](&(*l).ln, i) }
fn lex_zahl(l: *mut Lexer, i: usize) -> u64 { return vec_at[u64](&(*l).zahl, i) }
fn lex_nr(l: *mut Lexer, i: usize) -> u32 { return vec_at[u32](&(*l).nr, i) }
fn lex_fehler(l: *mut Lexer) -> usize { return diag.diag_anzahl(&(*l).dg) }
fn lex_diags(l: *mut Lexer) -> *mut diag.Diags { return &(*l).dg }
fn lex_namen(l: *mut Lexer) -> *mut intern.Interner { return &(*l).namen }

// ---------------------------------------------------------------- Meldungen
//
// Der Text einer Meldung wird in `msg` zusammengesetzt und dann als
// Oktettfolge an `diag` uebergeben. Firn hat keine Textverkettung (Punkt 4 der
// Liste in docs/SELBSTHOSTING.md) — dieser Puffer IST die Verkettung.

fn m_auf(l: *mut Lexer) {
    rt.buf_leeren(&(*l).msg)
}

fn m_txt(l: *mut Lexer, p: u64, n: usize) {
    rt.buf_push_bytes(&(*l).msg, p, n)
}

fn m_zahl(l: *mut Lexer, v: u64) {
    rt.buf_push_dez_u64(&(*l).msg, v)
}

// Ein ZEICHEN der Quelle (alle Oktette) in die Meldung kopieren.
fn m_zeichen(l: *mut Lexer, i: usize) {
    var w: usize = 1
    while i + w < (*l).n {
        if (okt(l, i + w) & 192) != 128 { break }
        w = w + 1
    }
    var k: usize = 0
    while k < w {
        rt.buf_push(&(*l).msg, okt(l, i + k) as u8)
        k = k + 1
    }
}

// Ein Codepunkt als vier GROSSE Hexziffern (`{:04X}` in Rust).
fn m_hex4(l: *mut Lexer, v: u64) {
    var i: i64 = 3
    while i >= 0 {
        let d: u64 = (v >> (i * 4) as u64) & 15
        if d < 10 {
            rt.buf_push(&(*l).msg, (48 + d) as u8)
        } else {
            rt.buf_push(&(*l).msg, (55 + d) as u8)
        }
        i = i - 1
    }
}

fn m_melde(l: *mut Lexer, zeile: u32, spalte: u32, laenge: u32) {
    diag.diag_fehler(&(*l).dg, (*l).datei, zeile, spalte, laenge,
                     rt.buf_ptr(&(*l).msg), rt.buf_len(&(*l).msg))
}
fn lex_gleit_langsam(l: *mut Lexer) -> usize { return (*l).gleit_langsam }

fn lex_lit_art(l: *mut Lexer, k: usize) -> u32 { return vec_at[u32](&(*l).lit_art, k) }
fn lex_lit_len(l: *mut Lexer, k: usize) -> usize { return vec_at[u32](&(*l).lit_len, k) as usize }

fn lex_lit_byte(l: *mut Lexer, k: usize, i: usize) -> u8 {
    return rt.ld8(rt.buf_ptr(&(*l).lit), vec_at[u32](&(*l).lit_off, k) as usize + i)
}

fn lex_lit_einheit(l: *mut Lexer, k: usize, i: usize) -> u16 {
    let b: u64 = rt.buf_ptr(&(*l).lit) + vec_at[u32](&(*l).lit_off, k) as u64
    return rt.ld16(b, i)
}

fn lex_name_zeiger(l: *mut Lexer, nr: u32) -> u64 {
    return intern.intern_zeiger(&(*l).namen, nr)
}

fn lex_name_laenge(l: *mut Lexer, nr: u32) -> usize {
    return intern.intern_laenge(&(*l).namen, nr)
}

// ------------------------------------------------------------ Zeichenzugriff
// 256 bedeutet Dateiende — so bleibt der Vergleich mit einem Oktett eindeutig.

fn schau(l: *mut Lexer, k: usize) -> u32 {
    if (*l).p + k >= (*l).n {
        return 256
    }
    return rt.ld8((*l).q, (*l).p + k) as u32
}

fn okt(l: *mut Lexer, i: usize) -> u32 {
    if i >= (*l).n {
        return 256
    }
    return rt.ld8((*l).q, i) as u32
}

// Ein OKTETT weiter. Zeile/Spalte werden nur beim fuehrenden Oktett
// nachgefuehrt — Fortsetzungsoktette (10xxxxxx) gehoeren zum selben Zeichen.
fn vor1(l: *mut Lexer) {
    if (*l).p >= (*l).n {
        return
    }
    let b: u8 = rt.ld8((*l).q, (*l).p)
    (*l).p = (*l).p + 1
    if (b & 192 as u8) == 128 as u8 {
        return
    }
    if b == 10 as u8 {
        (*l).zeile = (*l).zeile + 1
        (*l).spalte = 1
    } else {
        (*l).spalte = (*l).spalte + 1
    }
}

// Ein ZEICHEN weiter.
fn vorz(l: *mut Lexer) {
    vor1(l)
    while (*l).p < (*l).n {
        let b: u8 = rt.ld8((*l).q, (*l).p)
        if (b & 192 as u8) != 128 as u8 {
            break
        }
        vor1(l)
    }
}

fn tok(l: *mut Lexer, art: u32, zeile: u32, spalte: u32, laenge: u32, zahl: u64, nr: u32) {
    vec_push[u32](&(*l).art, art)
    vec_push[u32](&(*l).zl, zeile)
    vec_push[u32](&(*l).spl, spalte)
    vec_push[u32](&(*l).ln, laenge)
    vec_push[u64](&(*l).zahl, zahl)
    vec_push[u32](&(*l).nr, nr)
}

fn ist_ziffer(c: u32) -> bool { return c >= 48 && c <= 57 }
fn ist_buchstabe(c: u32) -> bool { return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) }
fn ist_name_start(c: u32) -> bool { return c == 95 || ist_buchstabe(c) }
fn ist_name_weiter(c: u32) -> bool { return c == 95 || ist_buchstabe(c) || ist_ziffer(c) }

// EHRLICHE GRENZE: `char::is_whitespace` in Rust kennt auch U+00A0, U+2028 und
// weitere. Hier zaehlt nur ASCII-Leerraum; alles andere wird zu 'unbekanntes
// zeichen'. Im gesamten Quellkorpus kommt kein Unicode-Leerraum vor.
fn ist_leer(c: u32) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13 || c == 11 || c == 12
}

fn hexwert(c: u32) -> i32 {
    if c >= 48 && c <= 57 { return (c - 48) as i32 }
    if c >= 97 && c <= 102 { return (c - 97 + 10) as i32 }
    if c >= 65 && c <= 70 { return (c - 65 + 10) as i32 }
    return -1
}

// ------------------------------------------------- Leerraum und Kommentare

fn ueberspringe(l: *mut Lexer) {
    while true {
        let c: u32 = schau(l, 0)
        if ist_leer(c) {
            vor1(l)
        } else if c == 47 && schau(l, 1) == 47 {
            while (*l).p < (*l).n {
                if schau(l, 0) == 10 { break }
                vor1(l)
            }
        } else if c == 47 && schau(l, 1) == 42 {
            let kz: u32 = (*l).zeile
            let ks: u32 = (*l).spalte
            vor1(l)
            vor1(l)
            var tiefe: usize = 1
            while tiefe > 0 {
                if (*l).p >= (*l).n {
                    var mk: [u8; 50] = "blockkommentar wird nicht geschlossen ('*/' fehlt)"
                    m_auf(l)
                    m_txt(l, (&mk[0]) as u64, 50)
                    m_melde(l, kz, ks, 2)
                    break
                }
                if schau(l, 0) == 47 && schau(l, 1) == 42 {
                    vor1(l)
                    vor1(l)
                    tiefe = tiefe + 1
                } else if schau(l, 0) == 42 && schau(l, 1) == 47 {
                    vor1(l)
                    vor1(l)
                    tiefe = tiefe - 1
                } else {
                    vor1(l)
                }
            }
        } else {
            return
        }
    }
}

// --------------------------------------------------------------- Bezeichner

fn lex_name(l: *mut Lexer) {
    let zeile: u32 = (*l).zeile
    let spalte: u32 = (*l).spalte
    let start: usize = (*l).p
    while (*l).p < (*l).n {
        if !ist_name_weiter(schau(l, 0)) { break }
        vor1(l)
    }
    let laen: usize = (*l).p - start
    var k: usize = 0
    while k < tab_anzahl(&(*l).kw) {
        if tab_laenge(&(*l).kw, k) == laen {
            if rt.mem_eq(tab_zeiger(&(*l).kw, k), (*l).q + start as u64, laen) {
                tok(l, 4 + k as u32, zeile, spalte, laen as u32, 0, 0)
                return
            }
        }
        k = k + 1
    }
    let n: i64 = intern.intern_nummer(&(*l).namen, (*l).q + start as u64, laen)
    tok(l, A_IDENT, zeile, spalte, laen as u32, 0, n as u32)
}

// -------------------------------------------------------------------- Zahlen

// Bitmuster eines binary64. Der Umweg ueber eine ADRESSE ist Absicht: ein
// direktes `(&t) as *mut u64` mit anschliessendem Lesen hat der Codegenerator
// in Stufe 0 als Wertumwandlung behandelt und die Zahl 1 statt des Musters
// 4607182418800017408 geliefert — der Fehler faellt nur auf, weil `firnc0`
// danebensteht. Ueber `rt.ld64` auf dieselbe Adresse ist es eine echte
// Neudeutung derselben acht Oktette.
fn bits_von(x: f64) -> u64 {
    var t: f64 = 0.0
    let p: u64 = (&t) as u64
    *(p as *mut f64) = x
    return rt.ld64(p, 0)
}

// 10^k ist fuer k <= 22 in binary64 EXAKT darstellbar, und das Produkt
// 10^(k-1) * 10 rundet genau auf 10^k. Deshalb ist diese Schleife exakt.
// 10^k als Ganzzahl; 0, wenn es nicht mehr in 64 Bit passt.
fn zehn_hoch_ganz(k: usize) -> u64 {
    if k > 19 {
        return 0
    }
    var t: u64 = 1
    var i: usize = 0
    while i < k {
        t = t * 10
        i = i + 1
    }
    return t
}

fn zehn_hoch(k: usize) -> f64 {
    var t: f64 = 1.0
    var i: usize = 0
    while i < k {
        t = t * 10.0
        i = i + 1
    }
    return t
}

// Der schnelle Pfad von Clinger: passt die Mantisse in 2^53 und liegt der
// Zehnerexponent zwischen -22 und 22, dann ist EINE Multiplikation bzw.
// Division in binary64 korrekt gerundet — das Ergebnis stimmt also aufs Bit.
// Sonst wird gezaehlt (`gleit_langsam`) und schrittweise gerechnet; das kann
// um ein ULP danebenliegen. Ein vollstaendiger Algorithmus (Eisel-Lemire)
// braucht 128-Bit-Arithmetik und steht noch aus.
fn gleit_wert(l: *mut Lexer, mant: u64, ueberlauf: bool, e: i64) -> f64 {
    if !ueberlauf && mant <= 9007199254740992 && e >= -22 && e <= 22 {
        let f: f64 = mant as f64
        if e >= 0 {
            return f * zehn_hoch(e as usize)
        }
        return f / zehn_hoch((0 - e) as usize)
    }
    // Erweiterung von Clinger: liegt der Exponent ueber 22, laesst sich der
    // Ueberschuss oft in die MANTISSE ziehen, solange sie exakt bleibt
    // (<= 2^53). Dann bleibt es bei EINER Multiplikation und damit bei EINER
    // Rundung — das Ergebnis ist weiterhin korrekt gerundet.
    if !ueberlauf && e > 22 && e <= 37 {
        let ueberschuss: usize = (e - 22) as usize
        let faktor: u64 = zehn_hoch_ganz(ueberschuss)
        if faktor > 0 && mant <= 9007199254740992 / faktor {
            return (mant * faktor) as f64 * zehn_hoch(22)
        }
    }
    (*l).gleit_langsam = (*l).gleit_langsam + 1
    var f: f64 = mant as f64
    var k: i64 = e
    while k > 0 {
        f = f * 10.0
        k = k - 1
    }
    while k < 0 {
        f = f / 10.0
        k = k + 1
    }
    return f
}

fn lex_gleit_rest(l: *mut Lexer, zeile: u32, spalte: u32, breite0: u32,
                  mant0: u64, ueber0: bool, nvor: usize) -> bool {
    var breite: u32 = breite0
    var mant: u64 = mant0
    var ueber: bool = ueber0
    var nnach: i64 = 0
    let _ = nvor
    if schau(l, 0) == 46 {
        vor1(l)
        breite = breite + 1
        while (*l).p < (*l).n {
            let c: u32 = schau(l, 0)
            if c == 95 {
                vor1(l)
                breite = breite + 1
                continue
            }
            if !ist_ziffer(c) { break }
            if mant > 1844674407370955161 {
                ueber = true
            } else {
                mant = mant * 10 + (c - 48) as u64
            }
            nnach = nnach + 1
            vor1(l)
            breite = breite + 1
        }
    }
    var expo: i64 = 0
    if schau(l, 0) == 101 || schau(l, 0) == 69 {
        vor1(l)
        breite = breite + 1
        var neg: bool = false
        if schau(l, 0) == 43 || schau(l, 0) == 45 {
            if schau(l, 0) == 45 { neg = true }
            vor1(l)
            breite = breite + 1
        }
        var ziffern: usize = 0
        while (*l).p < (*l).n {
            let c: u32 = schau(l, 0)
            if c == 95 {
                vor1(l)
                breite = breite + 1
                continue
            }
            if !ist_ziffer(c) { break }
            if expo < 100000 {
                expo = expo * 10 + (c - 48) as i64
            }
            ziffern = ziffern + 1
            vor1(l)
            breite = breite + 1
        }
        if ziffern == 0 {
            var b: u32 = breite
            if b < 1 { b = 1 }
            var me: [u8; 61] = "gleitkommaliteral: nach 'e' fehlen die ziffern des exponenten"
            m_auf(l)
            m_txt(l, (&me[0]) as u64, 61)
            m_melde(l, zeile, spalte, b)
            tok(l, A_FLOAT, zeile, spalte, b, 0, 0)
            return true
        }
        if neg { expo = 0 - expo }
    }
    let f: f64 = gleit_wert(l, mant, ueber, expo - nnach)
    var b2: u32 = breite
    if b2 < 1 { b2 = 1 }
    tok(l, A_FLOAT, zeile, spalte, b2, bits_von(f), 0)
    return true
}

fn lex_ganzzahl(l: *mut Lexer) {
    let zeile: u32 = (*l).zeile
    let spalte: u32 = (*l).spalte
    var breite: u32 = 0
    var basis: u32 = 10
    if schau(l, 0) == 48 {
        let c2: u32 = schau(l, 1)
        if c2 == 120 || c2 == 88 {
            basis = 16
        } else if c2 == 98 || c2 == 66 {
            basis = 2
        }
        if basis != 10 {
            vor1(l)
            vor1(l)
            breite = breite + 2
        }
    }
    vec_leeren[u8](&(*l).ziffern)
    var schlecht: bool = false
    var s_zeile: u32 = 0
    var s_spalte: u32 = 0
    var s_pos: usize = 0
    while (*l).p < (*l).n {
        let c: u32 = schau(l, 0)
        if c == 95 {
            vor1(l)
            breite = breite + 1
            continue
        }
        if !(ist_ziffer(c) || ist_buchstabe(c)) {
            break
        }
        // Bei Basis 10 beendet ein 'e'/'E' mit folgender Ziffer oder Vorzeichen
        // die Ganzzahl — sonst waere '1e3' eine ungueltige Ziffer.
        if basis == 10 && (c == 101 || c == 69) {
            let c2: u32 = schau(l, 1)
            if ist_ziffer(c2) || c2 == 43 || c2 == 45 {
                break
            }
        }
        let w: i32 = hexwert(c)
        if w >= 0 && (w as u32) < basis {
            vec_push[u8](&(*l).ziffern, w as u8)
        } else {
            // Nur die ERSTE ungueltige Ziffer wird gemeldet.
            if !schlecht {
                schlecht = true
                s_zeile = (*l).zeile
                s_spalte = (*l).spalte
                s_pos = (*l).p
            }
        }
        vor1(l)
        breite = breite + 1
    }
    let anz: usize = vec_len[u8](&(*l).ziffern)
    // Gleitkomma nur zur Basis 10.
    if basis == 10 && !schlecht && anz > 0 {
        let punkt: bool = schau(l, 0) == 46 && ist_ziffer(schau(l, 1))
        var expo: bool = false
        if schau(l, 0) == 101 || schau(l, 0) == 69 {
            let c2: u32 = schau(l, 1)
            expo = ist_ziffer(c2) || c2 == 43 || c2 == 45
        }
        if punkt || expo {
            var m: u64 = 0
            var ue: bool = false
            var i: usize = 0
            while i < anz {
                if m > 1844674407370955161 {
                    ue = true
                } else {
                    m = m * 10 + vec_at[u8](&(*l).ziffern, i) as u64
                }
                i = i + 1
            }
            lex_gleit_rest(l, zeile, spalte, breite, m, ue, anz)
            return
        }
    }
    var b: u32 = breite
    if b < 1 { b = 1 }
    if schlecht {
        var m1: [u8; 21] = "ungueltiges zeichen '"
        var m2: [u8; 37] = "' in einem ganzzahlliteral zur basis "
        m_auf(l)
        m_txt(l, (&m1[0]) as u64, 21)
        m_zeichen(l, s_pos)
        m_txt(l, (&m2[0]) as u64, 37)
        m_zahl(l, basis as u64)
        m_melde(l, s_zeile, s_spalte, 1)
        tok(l, A_INT, zeile, spalte, b, 0, 0)
        return
    }
    if anz == 0 {
        var m3: [u8; 36] = "ganzzahlliteral ohne ziffern (basis "
        m_auf(l)
        m_txt(l, (&m3[0]) as u64, 36)
        m_zahl(l, basis as u64)
        var m4: [u8; 1] = ")"
        m_txt(l, (&m4[0]) as u64, 1)
        m_melde(l, zeile, spalte, b)
        tok(l, A_INT, zeile, spalte, b, 0, 0)
        return
    }
    var wert: u64 = 0
    var zu_gross: bool = false
    var i: usize = 0
    while i < anz {
        let d: u64 = vec_at[u8](&(*l).ziffern, i) as u64
        let grenze: u64 = (18446744073709551615 - d) / basis as u64
        if wert > grenze {
            zu_gross = true
            break
        }
        wert = wert * basis as u64 + d
        i = i + 1
    }
    if zu_gross {
        var m5: [u8; 46] = "ganzzahlliteral ist zu gross (mehr als 64 bit)"
        m_auf(l)
        m_txt(l, (&m5[0]) as u64, 46)
        m_melde(l, zeile, spalte, b)
        tok(l, A_INT, zeile, spalte, b, 0, 0)
        return
    }
    tok(l, A_INT, zeile, spalte, b, wert, 0)
}

// -------------------------------------------------------- Satz- und Rechenzeichen

// `false`, wenn das Zeichen unbekannt ist.
fn lex_zeichen(l: *mut Lexer) -> bool {
    let zeile: u32 = (*l).zeile
    let spalte: u32 = (*l).spalte
    let c: u32 = schau(l, 0)
    if c == 256 {
        return true
    }
    let n: u32 = schau(l, 1)
    var art: u32 = 999
    var breite: u32 = 1
    if c == 45 && n == 62 { art = A_ARROW; breite = 2 }
    else if c == 46 && n == 46 { art = A_DOTDOT; breite = 2 }
    else if c == 60 && n == 60 { art = A_SHL; breite = 2 }
    else if c == 62 && n == 62 { art = A_SHR; breite = 2 }
    else if c == 38 && n == 38 { art = A_ANDAND; breite = 2 }
    else if c == 124 && n == 124 { art = A_OROR; breite = 2 }
    else if c == 61 && n == 61 { art = A_EQEQ; breite = 2 }
    else if c == 33 && n == 61 { art = A_NOTEQ; breite = 2 }
    else if c == 60 && n == 61 { art = A_LE; breite = 2 }
    else if c == 62 && n == 61 { art = A_GE; breite = 2 }
    else if c == 40 { art = A_LPAREN }
    else if c == 41 { art = A_RPAREN }
    else if c == 123 { art = A_LBRACE }
    else if c == 125 { art = A_RBRACE }
    else if c == 91 { art = A_LBRACKET }
    else if c == 93 { art = A_RBRACKET }
    else if c == 44 { art = A_COMMA }
    else if c == 58 { art = A_COLON }
    else if c == 59 { art = A_SEMI }
    else if c == 46 { art = A_DOT }
    else if c == 61 { art = A_ASSIGN }
    else if c == 43 { art = A_PLUS }
    else if c == 45 { art = A_MINUS }
    else if c == 42 { art = A_STAR }
    else if c == 47 { art = A_SLASH }
    else if c == 37 { art = A_PERCENT }
    else if c == 38 { art = A_AMP }
    else if c == 124 { art = A_PIPE }
    else if c == 94 { art = A_CARET }
    else if c == 35 { art = A_HASH }
    else if c == 33 { art = A_NOT }
    else if c == 63 { art = A_QUESTION }
    else if c == 60 { art = A_LT }
    else if c == 62 { art = A_GT }
    else { return false }
    var i: u32 = 0
    while i < breite {
        vor1(l)
        i = i + 1
    }
    tok(l, art, zeile, spalte, breite, 0, 0)
    return true
}

// ------------------------------------------------------ Zeichenkettenliterale

fn push_utf8(l: *mut Lexer, cp: u32) {
    if cp < 128 {
        rt.buf_push(&(*l).lit, cp as u8)
    } else if cp < 2048 {
        rt.buf_push(&(*l).lit, (192 + (cp >> 6)) as u8)
        rt.buf_push(&(*l).lit, (128 + (cp & 63)) as u8)
    } else if cp < 65536 {
        rt.buf_push(&(*l).lit, (224 + (cp >> 12)) as u8)
        rt.buf_push(&(*l).lit, (128 + ((cp >> 6) & 63)) as u8)
        rt.buf_push(&(*l).lit, (128 + (cp & 63)) as u8)
    } else {
        rt.buf_push(&(*l).lit, (240 + (cp >> 18)) as u8)
        rt.buf_push(&(*l).lit, (128 + ((cp >> 12) & 63)) as u8)
        rt.buf_push(&(*l).lit, (128 + ((cp >> 6) & 63)) as u8)
        rt.buf_push(&(*l).lit, (128 + (cp & 63)) as u8)
    }
}

fn push_u16(l: *mut Lexer, v: u32) {
    rt.buf_push(&(*l).lit, (v & 255) as u8)
    rt.buf_push(&(*l).lit, ((v >> 8) & 255) as u8)
}

fn push_utf16(l: *mut Lexer, cp: u32) {
    if cp > 65535 {
        let r: u32 = cp - 65536
        push_u16(l, 55296 + (r >> 10))
        push_u16(l, 56320 + (r & 1023))
    } else {
        push_u16(l, cp)
    }
}

// Codepunkt eines UTF-8-Zeichens ab `i` mit `w` Oktetten.
fn utf8_codepunkt(l: *mut Lexer, i: usize, w: usize) -> u32 {
    let b0: u32 = okt(l, i)
    if w == 1 { return b0 }
    if w == 2 { return ((b0 & 31) << 6) | (okt(l, i + 1) & 63) }
    if w == 3 {
        return ((b0 & 15) << 12) | ((okt(l, i + 1) & 63) << 6) | (okt(l, i + 2) & 63)
    }
    return ((b0 & 7) << 18) | ((okt(l, i + 1) & 63) << 12) | ((okt(l, i + 2) & 63) << 6) | (okt(l, i + 3) & 63)
}

// Genau `anz` Hexziffern ab `i`; -1, wenn eine fehlt.
fn hex_fest(l: *mut Lexer, i: usize, anz: usize, ende: usize) -> i64 {
    if i + anz > ende { return -1 }
    var v: i64 = 0
    var k: usize = 0
    while k < anz {
        let h: i32 = hexwert(okt(l, i + k))
        if h < 0 { return -1 }
        v = v * 16 + h as i64
        k = k + 1
    }
    return v
}

// `\uXXXX` bzw. `\u{...}` ab `i` lesen. Rueckgabe: (breite << 32) | codepunkt,
// oder -1 bei Fehler. Firn hat keine Mehrfachrueckgabe — deshalb gepackt.
// Fehlercodes, damit die Meldung genau die von `firnc0` ist:
//   -1 nicht-hexadezimale Ziffer in `\u{...}`
//   -2 Codepunkt ueber U+10FFFF
//   -3 `\u{...}` nicht abgeschlossen
//   -4 `\uXXXX` ohne vier Hexziffern
fn lies_u_escape(l: *mut Lexer, i: usize, ende: usize) -> i64 {
    if okt(l, i) == 123 {
        var j: usize = i + 1
        var v: i64 = 0
        var n: usize = 0
        while j < ende {
            let d: u32 = okt(l, j)
            if d == 125 { break }
            let h: i32 = hexwert(d)
            if h < 0 { return -1 }
            v = v * 16 + h as i64
            if v > 1114111 { return -2 }
            n = n + 1
            j = j + 1
        }
        if n == 0 || j >= ende || okt(l, j) != 125 { return -3 }
        let br: i64 = (j + 1 - i) as i64
        return (br << 32) | v
    }
    let v: i64 = hex_fest(l, i, 4, ende)
    if v < 0 { return -4 }
    return (4 << 32) | v
}

fn ist_hoch_surrogat(cp: i64) -> bool { return cp >= 55296 && cp <= 56319 }
fn ist_tief_surrogat(cp: i64) -> bool { return cp >= 56320 && cp <= 57343 }

// Folgt ab `i` ein maskiertes NIEDRIGES Surrogat? Rueckgabe wie oben.
fn spaehe_tief(l: *mut Lexer, i: usize, ende: usize) -> i64 {
    if i + 1 >= ende { return -1 }
    if okt(l, i) != 92 || okt(l, i + 1) != 117 { return -1 }
    let r: i64 = lies_u_escape(l, i + 2, ende)
    if r < 0 { return -1 }
    let cp: i64 = r & 4294967295
    if !ist_tief_surrogat(cp) { return -1 }
    let br: i64 = (r >> 32) + 2
    return (br << 32) | cp
}

// Meldung eines Literalfehlers. Rust setzt die Spalte auf
// `spalte + off`, wobei `off` ZEICHEN vom Anfang des Literals zaehlt
// (einschliesslich `b`/`u` und Anfuehrungszeichen), und stellt jeder Meldung
// "in einem zeichenkettenliteral: " voran.
fn lit_auf(l: *mut Lexer) {
    var v: [u8; 31] = "in einem zeichenkettenliteral: "
    m_auf(l)
    m_txt(l, (&v[0]) as u64, 31)
}

fn lit_melde(l: *mut Lexer, zeile: u32, spalte: u32, off: usize) {
    m_melde(l, zeile, spalte + off as u32, 1)
}

// Entschluesselt den Rumpf [bs, be) und haengt ihn an `lit`. `false` = Fehler.
// `lead` sind die Zeichen vor dem Rumpf (1 bei `"`, 2 bei `b"`/`u"`).
fn entschluessele(l: *mut Lexer, art: u32, bs: usize, be: usize,
                  zeile: u32, spalte: u32, lead: usize) -> bool {
    var i: usize = bs
    var zi: usize = 0        // Zeichenzaehler im Rumpf
    var gut: bool = true
    while i < be {
        let b: u32 = okt(l, i)
        if b != 92 {
            var w: usize = 1
            while i + w < be {
                if (okt(l, i + w) & 192) != 128 { break }
                w = w + 1
            }
            if art == L_BYTES {
                if b > 127 {
                    var e1: [u8; 9] = "zeichen '"
                    var e2: [u8; 73] = "' ist in einem Bytes-literal nicht erlaubt, schreibe die oktette als \\xNN"
                    lit_auf(l)
                    m_txt(l, (&e1[0]) as u64, 9)
                    m_zeichen(l, i)
                    m_txt(l, (&e2[0]) as u64, 73)
                    lit_melde(l, zeile, spalte, lead + zi)
                    gut = false
                } else {
                    rt.buf_push(&(*l).lit, b as u8)
                }
            } else if art == L_STR {
                var k: usize = 0
                while k < w {
                    rt.buf_push(&(*l).lit, okt(l, i + k) as u8)
                    k = k + 1
                }
            } else {
                push_utf16(l, utf8_codepunkt(l, i, w))
            }
            i = i + w
            zi = zi + 1
            continue
        }
        let anfang: usize = zi          // Zeichenindex des Rueckstrichs
        i = i + 1
        zi = zi + 1
        if i >= be {
            var e3: [u8; 31] = "maskierung am ende des literals"
            lit_auf(l)
            m_txt(l, (&e3[0]) as u64, 31)
            lit_melde(l, zeile, spalte, lead + anfang)
            return false
        }
        let e: u32 = okt(l, i)
        let e_pos: usize = i
        var ew: usize = 1
        while i + ew < be {
            if (okt(l, i + ew) & 192) != 128 { break }
            ew = ew + 1
        }
        i = i + ew
        zi = zi + 1
        var v: i64 = -1
        if e == 110 { v = 10 }
        else if e == 114 { v = 13 }
        else if e == 116 { v = 9 }
        else if e == 48 { v = 0 }
        else if e == 92 { v = 92 }
        else if e == 34 { v = 34 }
        else if e == 39 { v = 39 }
        if v >= 0 {
            if art == L_STR16 {
                push_u16(l, v as u32)
            } else {
                rt.buf_push(&(*l).lit, v as u8)
            }
            continue
        }
        if e == 120 {
            let h: i64 = hex_fest(l, i, 2, be)
            if h < 0 {
                var e4: [u8; 41] = "\\x erwartet genau zwei hexadezimalziffern"
                lit_auf(l)
                m_txt(l, (&e4[0]) as u64, 41)
                lit_melde(l, zeile, spalte, lead + anfang)
                return false
            }
            i = i + 2
            zi = zi + 2
            if art == L_STR && h > 127 {
                var e5: [u8; 61] = "\\xNN ueber 0x7F ergibt kein gueltiges UTF-8, schreibe \\u{...}"
                lit_auf(l)
                m_txt(l, (&e5[0]) as u64, 61)
                lit_melde(l, zeile, spalte, lead + anfang)
                gut = false
                continue
            }
            if art == L_STR16 {
                push_u16(l, h as u32)
            } else {
                rt.buf_push(&(*l).lit, h as u8)
            }
            continue
        }
        if e == 117 {
            let r: i64 = lies_u_escape(l, i, be)
            if r < 0 {
                lit_auf(l)
                if r == 0 - 1 {
                    var f1: [u8; 35] = "\\u{...} erwartet hexadezimalziffern"
                    m_txt(l, (&f1[0]) as u64, 35)
                } else if r == 0 - 2 {
                    var f2: [u8; 46] = "codepunkt ueber U+10FFFF ist nicht darstellbar"
                    m_txt(l, (&f2[0]) as u64, 46)
                } else if r == 0 - 3 {
                    var f3: [u8; 31] = "\\u{...} ist nicht abgeschlossen"
                    m_txt(l, (&f3[0]) as u64, 31)
                } else {
                    var f4: [u8; 41] = "\\u erwartet genau vier hexadezimalziffern"
                    m_txt(l, (&f4[0]) as u64, 41)
                }
                lit_melde(l, zeile, spalte, lead + anfang)
                return false
            }
            let cp: i64 = r & 4294967295
            let br: usize = (r >> 32) as usize
            i = i + br
            zi = zi + br
            if art == L_BYTES {
                var f5: [u8; 65] = "\\u ist in einem Bytes-literal nicht erlaubt (Bytes ist kein text)"
                lit_auf(l)
                m_txt(l, (&f5[0]) as u64, 65)
                lit_melde(l, zeile, spalte, lead + anfang)
                return false
            }
            if art == L_STR16 {
                if cp > 65535 {
                    push_utf16(l, cp as u32)
                } else {
                    push_u16(l, cp as u32)
                }
                continue
            }
            // `Str` ist geprueftes UTF-8: ein ungepaartes Surrogat ist ein
            // Fehler, ein Paar wird zu EINEM Codepunkt vereinigt.
            var ungepaart: bool = false
            if ist_hoch_surrogat(cp) {
                let t: i64 = spaehe_tief(l, i, be)
                if t < 0 {
                    ungepaart = true
                } else {
                    let tb: usize = (t >> 32) as usize
                    i = i + tb
                    zi = zi + tb
                    let lo: i64 = t & 4294967295
                    push_utf8(l, (65536 + ((cp - 55296) << 10) + (lo - 56320)) as u32)
                }
            } else if ist_tief_surrogat(cp) {
                ungepaart = true
            } else {
                push_utf8(l, cp as u32)
            }
            if ungepaart {
                var g1: [u8; 23] = "ungepaartes surrogat U+"
                var g2: [u8; 74] = " in einem Str-literal; Str ist geprueftes UTF-8 — benutze u\"...\" (Str16)"
                lit_auf(l)
                m_txt(l, (&g1[0]) as u64, 23)
                m_hex4(l, cp as u64)
                m_txt(l, (&g2[0]) as u64, 74)
                lit_melde(l, zeile, spalte, lead + anfang)
                return false
            }
            continue
        }
        var h1: [u8; 24] = "unbekannte maskierung '\\"
        var h2: [u8; 1] = "'"
        lit_auf(l)
        m_txt(l, (&h1[0]) as u64, 24)
        m_zeichen(l, e_pos)
        m_txt(l, (&h2[0]) as u64, 1)
        lit_melde(l, zeile, spalte, lead + anfang)
        return false
    }
    return gut
}

// `false`, wenn an dieser Stelle kein Literal steht.
fn lex_text(l: *mut Lexer) -> bool {
    let c0: u32 = schau(l, 0)
    var art: u32 = 0
    var vorn: usize = 0
    if c0 == 34 {
        art = L_STR
        vorn = 0
    } else if c0 == 98 && schau(l, 1) == 34 {
        art = L_BYTES
        vorn = 1
    } else if c0 == 117 && schau(l, 1) == 34 {
        art = L_STR16
        vorn = 1
    } else {
        return false
    }
    let zeile: u32 = (*l).zeile
    let spalte: u32 = (*l).spalte
    let bs: usize = (*l).p + vorn + 1
    var i: usize = bs
    var zeichen: usize = vorn + 1
    var geschlossen: bool = false
    var be: usize = (*l).n
    while i < (*l).n {
        let b: u32 = okt(l, i)
        if b == 92 {
            i = i + 1
            zeichen = zeichen + 1
            if i >= (*l).n { break }
            if okt(l, i) == 10 { break }
            i = i + 1
            zeichen = zeichen + 1
            while i < (*l).n {
                if (okt(l, i) & 192) != 128 { break }
                i = i + 1
            }
            continue
        }
        if b == 34 {
            be = i
            geschlossen = true
            i = i + 1
            zeichen = zeichen + 1
            break
        }
        if b == 10 {
            be = i
            break
        }
        i = i + 1
        zeichen = zeichen + 1
        while i < (*l).n {
            if (okt(l, i) & 192) != 128 { break }
            i = i + 1
        }
    }
    if !geschlossen {
        be = i
    }
    var z: usize = 0
    while z < zeichen {
        vorz(l)
        z = z + 1
    }
    let versatz: usize = rt.buf_len(&(*l).lit)
    var gut: bool = geschlossen
    if geschlossen {
        gut = entschluessele(l, art, bs, be, zeile, spalte, vorn + 1)
    } else {
        // Der Versatz ist hier `lead + Zeichen im Rumpf` — genau das steht in
        // `zeichen`, weil der Zaehler bei `lead` beginnt und das schliessende
        // Anfuehrungszeichen nie gelesen wurde.
        var u1: [u8; 43] = "zeichenkettenliteral ohne abschliessendes \""
        lit_auf(l)
        m_txt(l, (&u1[0]) as u64, 43)
        lit_melde(l, zeile, spalte, zeichen)
    }
    if !gut {
        // Weiterlexen mit einem LEEREN Literal — genau wie firnc0, damit
        // Folgefehler nicht auf eine kaputte Tokenfolge zurueckgehen.
        rt.buf_set_len(&(*l).lit, versatz)
    }
    let oktette: usize = rt.buf_len(&(*l).lit) - versatz
    var elemente: usize = oktette
    if art == L_STR16 {
        elemente = oktette / 2
    }
    let k: usize = vec_len[u32](&(*l).lit_off)
    vec_push[u32](&(*l).lit_off, versatz as u32)
    vec_push[u32](&(*l).lit_len, elemente as u32)
    vec_push[u32](&(*l).lit_art, art)
    tok(l, A_STR, zeile, spalte, zeichen as u32, 0, k as u32)
    return true
}

// ------------------------------------------------------------------- Lauf

fn lex_lauf(l: *mut Lexer) {
    while true {
        ueberspringe(l)
        let c: u32 = schau(l, 0)
        if c == 256 {
            break
        }
        if lex_text(l) {
            continue
        }
        if ist_ziffer(c) {
            lex_ganzzahl(l)
        } else if ist_name_start(c) {
            lex_name(l)
        } else if !lex_zeichen(l) {
            var w1: [u8; 21] = "unbekanntes zeichen '"
            var w2: [u8; 14] = "' im quelltext"
            let uz: u32 = (*l).zeile
            let us: u32 = (*l).spalte
            m_auf(l)
            m_txt(l, (&w1[0]) as u64, 21)
            m_zeichen(l, (*l).p)
            m_txt(l, (&w2[0]) as u64, 14)
            m_melde(l, uz, us, 1)
            vorz(l)
        }
    }
    tok(l, A_EOF, (*l).zeile, (*l).spalte, 0, 0, 0)
}
