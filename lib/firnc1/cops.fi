// SPDX-License-Identifier: MPL-2.0

export { compute, ERR_NONE, ERR_DIV, ERR_REM, ERR_SHIFT, ERR_SAT }

const ERR_NONE: u32 = 0
const ERR_DIV: u32 = 1
const ERR_REM: u32 = 2
const ERR_SHIFT: u32 = 3
const ERR_SAT: u32 = 4

const B_ADD: u32 = 0
const B_SUB: u32 = 1
const B_MUL: u32 = 2
const B_DIV: u32 = 3
const B_REM: u32 = 4
const B_AND: u32 = 5
const B_OR: u32 = 6
const B_XOR: u32 = 7
const B_SHL: u32 = 8
const B_SHR: u32 = 9
const B_EQ: u32 = 10
const B_NE: u32 = 11
const B_LT: u32 = 12
const B_LE: u32 = 13
const B_GT: u32 = 14
const B_GE: u32 = 15
const B_LAND: u32 = 16
const B_LOR: u32 = 17
const B_ADDWRAP: u32 = 18
const B_SUBWRAP: u32 = 19
const B_MULWRAP: u32 = 20
const B_ADDSAT: u32 = 21
const B_SUBSAT: u32 = 22
const B_MULSAT: u32 = 23

const SHIFT_LIMIT: i64 = 128
const WORD_BITS: i64 = 64

fn flag(c: bool) -> i64 {
    if c {
        return 1
    }
    return 0
}

fn divide(a: i64, b: i64, err: *mut u32, code: u32, rem: bool) -> i64 {
    if b == 0 {
        *err = code
        return 0
    }
    if b == -1 {
        if rem {
            return 0
        }
        return 0 -% a
    }
    if rem {
        return a % b
    }
    return a / b
}

fn shift(a: i64, b: i64, left: bool, err: *mut u32) -> i64 {
    if b < 0 || b >= SHIFT_LIMIT {
        *err = ERR_SHIFT
        return 0
    }
    if b >= WORD_BITS {
        if left || a >= 0 {
            return 0
        }
        return -1
    }
    if left {
        return a << b
    }
    return a >> b
}

fn compute(op: u32, a: i64, b: i64, err: *mut u32) -> i64 {
    if op == B_ADD || op == B_ADDWRAP { return a +% b }
    if op == B_SUB || op == B_SUBWRAP { return a -% b }
    if op == B_MUL || op == B_MULWRAP { return a *% b }
    if op == B_DIV { return divide(a, b, err, ERR_DIV, false) }
    if op == B_REM { return divide(a, b, err, ERR_REM, true) }
    if op == B_AND { return a & b }
    if op == B_OR { return a | b }
    if op == B_XOR { return a ^ b }
    if op == B_SHL { return shift(a, b, true, err) }
    if op == B_SHR { return shift(a, b, false, err) }
    if op == B_EQ { return flag(a == b) }
    if op == B_NE { return flag(a != b) }
    if op == B_LT { return flag(a < b) }
    if op == B_LE { return flag(a <= b) }
    if op == B_GT { return flag(a > b) }
    if op == B_GE { return flag(a >= b) }
    if op == B_LAND { return flag(a != 0 && b != 0) }
    if op == B_LOR { return flag(a != 0 || b != 0) }
    *err = ERR_SAT
    return 0
}
