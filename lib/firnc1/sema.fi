// lib/firnc1/sema.fi — TYPPRUEFER, IN FIRN.
//
// Sechster Teil von Stufe 1 und der bisher groesste: die Portierung des Kerns
// von `compiler/src/sema.rs`. Geprueft wird das, was `firnc0` zusichert —
// **jeder Ausdruck bekommt einen konkreten Typ**.
//
// DAS VERFAHREN IST BIDIREKTIONAL. Ein Ganzzahlliteral hat in Firn keinen
// eigenen Typ; er kommt aus dem Zusammenhang:
//
//     let x: i32 = 5        der Kontexthinweis macht die 5 zu i32
//     a + 1                 der Typ von `a` macht die 1 zu dessen Typ
//     5                     allein steht: FEHLER, nicht ableitbar
//
// Dafuer gibt es zwei Wege durch denselben Baum:
//   * `probe` ermittelt den Typ OHNE zu melden und ohne die Tabelle zu
//     beschreiben — damit `a + 1` den Typ des Literals aus `a` gewinnt;
//   * `ausdruck` prueft wirklich und traegt den Typ ein.
// Die Reihenfolge ist Vertrag: erst der bereits typisierte Operand, dann der
// Kontexthinweis. Sonst meldet `let x: i64 = a + 1` (a: i32) den Fehler an der
// falschen Stelle.
//
// NICHT PORTIERT (und deshalb hier benannt): saemtliche Fehlermeldungen. Die
// Firn-Fassung ZAEHLT Fehler, sie beschreibt sie nicht. Der Vergleich laeuft
// nur ueber Quellen, die `firnc0` fehlerfrei prueft — dort ist die Zahl der
// Meldungen null, und was zaehlt, sind die Typen. Ebenso fehlen
// Erreichbarkeitsanalyse (`return` am Ende), Veraenderlichkeitspruefung
// (`let` gegen `var`) und die Rekursionspruefung fuer Structs.

import rt
import vec
import intern
import ast
import typen

export { Sema, sema_neu, sema_frei, sema_lauf, sema_fehler, sema_typ,
         sema_typen, sema_typ_anzahl, sema_braucht_comptime }

const KEIN: u32 = 4294967295

struct Sema {
    b: u64,              // Zeiger auf den Baum
    it: u64,             // Zeiger auf den Interner
    ty: typen.Typen,
    etyp: Vec[u32],      // Typ je Ausdrucksknoten
    v_name: Vec[u32],    // Bereiche: Namen, Typen und Grenzen
    v_typ: Vec[u32],
    b_grenze: Vec[u32],
    k_name: Vec[u32],    // Konstanten
    k_typ: Vec[u32],
    k_wert: Vec[u64],
    t_bool: u32,         // vorgefertigte Typen
    t_i64: u32,
    t_usize: u32,
    t_void: u32,
    t_fehler: u32,
    t_f64: u32,
    ret: u32,            // Rueckgabetyp der laufenden Funktion
    fehler: usize,
    ct_noetig: bool,     // eine Konstante braucht Auswertung zur Uebersetzungszeit
}

fn sema_neu(b: u64, it: u64) -> Sema {
    return Sema{
        b: b, it: it,
        ty: typen.typen_neu(),
        etyp: vec_neu[u32](),
        v_name: vec_neu[u32](), v_typ: vec_neu[u32](), b_grenze: vec_neu[u32](),
        k_name: vec_neu[u32](), k_typ: vec_neu[u32](), k_wert: vec_neu[u64](),
        t_bool: 0, t_i64: 0, t_usize: 0, t_void: 0, t_fehler: 0, t_f64: 0,
        ret: 0, fehler: 0, ct_noetig: false,
    }
}

fn sema_frei(s: *mut Sema) {
    typen.typen_frei(&(*s).ty)
    vec_frei[u32](&(*s).etyp)
    vec_frei[u32](&(*s).v_name)
    vec_frei[u32](&(*s).v_typ)
    vec_frei[u32](&(*s).b_grenze)
    vec_frei[u32](&(*s).k_name)
    vec_frei[u32](&(*s).k_typ)
    vec_frei[u64](&(*s).k_wert)
}

fn sema_fehler(s: *mut Sema) -> usize { return (*s).fehler }
fn sema_braucht_comptime(s: *mut Sema) -> bool { return (*s).ct_noetig }
fn sema_typen(s: *mut Sema) -> *mut typen.Typen { return &(*s).ty }
fn sema_typ_anzahl(s: *mut Sema) -> usize { return vec_len[u32](&(*s).etyp) }
fn sema_typ(s: *mut Sema, i: u32) -> u32 { return vec_at[u32](&(*s).etyp, i as usize) }

fn baum(s: *mut Sema) -> *mut ast.Baum { return (*s).b as *mut ast.Baum }
fn tafel(s: *mut Sema) -> *mut typen.Typen { return &(*s).ty }
fn namen(s: *mut Sema) -> *mut intern.Interner { return (*s).it as *mut intern.Interner }

fn meckern(s: *mut Sema) { (*s).fehler = (*s).fehler + 1 }

fn merke(s: *mut Sema, e: u32, t: u32) {
    vec_setzen[u32](&(*s).etyp, e as usize, t)
}

// ------------------------------------------------------------------ Bereiche

fn bereich_auf(s: *mut Sema) {
    vec_push[u32](&(*s).b_grenze, vec_len[u32](&(*s).v_name) as u32)
}

fn bereich_zu(s: *mut Sema) {
    let g: u32 = vec_letztes[u32](&(*s).b_grenze)
    vec_pop[u32](&(*s).b_grenze)
    while vec_len[u32](&(*s).v_name) > g as usize {
        vec_pop[u32](&(*s).v_name)
        vec_pop[u32](&(*s).v_typ)
    }
}

fn var_anlegen(s: *mut Sema, name: u32, t: u32) {
    vec_push[u32](&(*s).v_name, name)
    vec_push[u32](&(*s).v_typ, t)
}

// Von hinten suchen: der innerste Bereich gewinnt.
fn var_suchen(s: *mut Sema, name: u32) -> u32 {
    var i: usize = vec_len[u32](&(*s).v_name)
    while i > 0 {
        i = i - 1
        if vec_at[u32](&(*s).v_name, i) == name {
            return vec_at[u32](&(*s).v_typ, i)
        }
    }
    return KEIN
}

fn konst_suchen(s: *mut Sema, name: u32) -> u32 {
    var i: usize = 0
    while i < vec_len[u32](&(*s).k_name) {
        if vec_at[u32](&(*s).k_name, i) == name {
            return vec_at[u32](&(*s).k_typ, i)
        }
        i = i + 1
    }
    return KEIN
}

fn konst_wert(s: *mut Sema, name: u32) -> u64 {
    var i: usize = 0
    while i < vec_len[u32](&(*s).k_name) {
        if vec_at[u32](&(*s).k_name, i) == name {
            return vec_at[u64](&(*s).k_wert, i)
        }
        i = i + 1
    }
    return 0
}

// Nummer der Funktion mit diesem Namen, oder KEIN.
fn fn_suchen(s: *mut Sema, name: u32) -> u32 {
    var i: usize = 0
    while i < ast.fn_anzahl(baum(s)) {
        if ast.fn_name(baum(s), i) == name {
            return i as u32
        }
        i = i + 1
    }
    return KEIN
}

// -------------------------------------------------------------- Hilfsfragen

fn ist_int(s: *mut Sema, t: u32) -> bool { return typen.ist_ganzzahl(tafel(s), t) }
fn ist_fehler(s: *mut Sema, t: u32) -> bool { return typen.ty_art(tafel(s), t) == typen.K_FEHLER }
fn ist_bool(s: *mut Sema, t: u32) -> bool { return typen.ty_art(tafel(s), t) == typen.K_BOOL }
fn ist_f64(s: *mut Sema, t: u32) -> bool { return typen.ty_art(tafel(s), t) == typen.K_F64 }

// Darf dieser Typ an einer `as`-Umwandlung teilnehmen?
fn umwandelbar(s: *mut Sema, t: u32) -> bool {
    return ist_int(s, t) || ist_bool(s, t) || typen.ist_zeiger(tafel(s), t) || ist_f64(s, t)
}

// Loest einen Typausdruck des Baums auf.
fn ast_typ(s: *mut Sema, te: u32) -> u32 {
    return typen.aufloesen(tafel(s), baum(s), namen(s), te)
}

// ---------------------------------------------------------------- probe
//
// Typ eines Ausdrucks OHNE Meldung und ohne die Tabelle zu beschreiben.
// KEIN heisst "nicht ableitbar" — genau wie `Option::None` in sema.rs.

fn probe(s: *mut Sema, e: u32) -> u32 {
    return probe_t(s, e, 0)
}

fn probe_t(s: *mut Sema, e: u32, d: u32) -> u32 {
    if d >= 200 {
        return KEIN
    }
    let b: *mut ast.Baum = baum(s)
    let a: u32 = ast.e_art(b, e)
    if a == ast.E_INT {
        return KEIN
    }
    if a == ast.E_FLOAT {
        return (*s).t_f64
    }
    if a == ast.E_BOOL {
        return (*s).t_bool
    }
    if a == ast.E_ID {
        let v: u32 = var_suchen(s, ast.e_a(b, e))
        if v != KEIN {
            return v
        }
        return konst_suchen(s, ast.e_a(b, e))
    }
    if a == ast.E_UN {
        let op: u32 = ast.e_a(b, e)
        if op == 0 {
            return probe_t(s, ast.e_b(b, e), d + 1)
        }
        if op == 1 {
            return (*s).t_bool
        }
        if op == 2 {
            let inner: u32 = probe_t(s, ast.e_b(b, e), d + 1)
            if inner == KEIN {
                return KEIN
            }
            return typen.neuer_typ(tafel(s), typen.K_PTR, inner, 1)
        }
        let p: u32 = probe_t(s, ast.e_b(b, e), d + 1)
        if p == KEIN {
            return KEIN
        }
        if typen.ty_art(tafel(s), p) != typen.K_PTR {
            return KEIN
        }
        return typen.ty_a(tafel(s), p)
    }
    if a == ast.E_BIN {
        let op: u32 = ast.e_a(b, e)
        if op >= 10 {
            return (*s).t_bool
        }
        if op == 8 || op == 9 {
            return probe_t(s, ast.e_b(b, e), d + 1)
        }
        let l: u32 = probe_t(s, ast.e_b(b, e), d + 1)
        if l != KEIN {
            return l
        }
        return probe_t(s, ast.e_c(b, e), d + 1)
    }
    if a == ast.E_FELD {
        let bt: u32 = probe_t(s, ast.e_a(b, e), d + 1)
        if bt == KEIN {
            return KEIN
        }
        if typen.ty_art(tafel(s), bt) != typen.K_STRUCT {
            return KEIN
        }
        return typen.st_feld_typ(tafel(s), typen.ty_a(tafel(s), bt) as usize, ast.e_b(b, e))
    }
    if a == ast.E_IDX {
        let bt: u32 = probe_t(s, ast.e_a(b, e), d + 1)
        if bt == KEIN {
            return KEIN
        }
        if typen.ty_art(tafel(s), bt) != typen.K_ARR {
            return KEIN
        }
        return typen.ty_a(tafel(s), bt)
    }
    if a == ast.E_RUF {
        let f: u32 = fn_suchen(s, ast.e_a(b, e))
        if f == KEIN {
            return KEIN
        }
        return typen.ret_typ_der_funktion(tafel(s), f as usize)
    }
    if a == ast.E_SYSCALL {
        return (*s).t_i64
    }
    if a == ast.E_AS {
        return ast_typ(s, ast.e_b(b, e))
    }
    if a == ast.E_SLIT {
        let si: i32 = typen.struct_index(tafel(s), ast.e_a(b, e))
        if si < 0 {
            return KEIN
        }
        return typen.neuer_typ(tafel(s), typen.K_STRUCT, si as u32, 0)
    }
    if a == ast.E_ALIT {
        if ast.e_c(b, e) == 0 {
            return KEIN
        }
        let et: u32 = probe_t(s, ast.kind_at(b, ast.e_b(b, e)), d + 1)
        if et == KEIN {
            return KEIN
        }
        return typen.neuer_typ(tafel(s), typen.K_ARR, et, ast.e_c(b, e) as u64)
    }
    return KEIN
}

// ------------------------------------------------- konstante Auswertung
//
// Gebraucht fuer `const` und fuer die Laenge eines Wiederholungsliterals —
// die geht in den TYP ein (`[T; N]`), also muss sie hier stehen.

fn wickeln(s: *mut Sema, v: i64, t: u32) -> i64 {
    let bits: u32 = typen.bits_von(tafel(s), t)
    if bits == 0 || bits >= 64 {
        return v
    }
    let maske: i64 = (1 << bits as i64) - 1
    let m: i64 = v & maske
    if typen.ist_vorzeichen(tafel(s), t) {
        if (m >> (bits - 1) as i64) & 1 != 0 {
            return m - (1 << bits as i64)
        }
    }
    return m
}

fn konst_auswerten(s: *mut Sema, e: u32, gut: *mut bool) -> i64 {
    let b: *mut ast.Baum = baum(s)
    let a: u32 = ast.e_art(b, e)
    if a == ast.E_INT {
        return ast.e_zahl(b, e) as i64
    }
    if a == ast.E_BOOL {
        if ast.e_a(b, e) == 1 {
            return 1
        }
        return 0
    }
    if a == ast.E_ID {
        if konst_suchen(s, ast.e_a(b, e)) == KEIN {
            *gut = false
            return 0
        }
        return konst_wert(s, ast.e_a(b, e)) as i64
    }
    if a == ast.E_UN {
        let v: i64 = konst_auswerten(s, ast.e_b(b, e), gut)
        let op: u32 = ast.e_a(b, e)
        if op == 0 {
            return 0 - v
        }
        if op == 1 {
            if v == 0 {
                return 1
            }
            return 0
        }
        *gut = false
        return 0
    }
    if a == ast.E_BIN {
        let op: u32 = ast.e_a(b, e)
        let x: i64 = konst_auswerten(s, ast.e_b(b, e), gut)
        let y: i64 = konst_auswerten(s, ast.e_c(b, e), gut)
        var v: i64 = 0
        if op == 0 { v = x + y }
        else if op == 1 { v = x - y }
        else if op == 2 { v = x * y }
        else if op == 3 {
            if y == 0 {
                *gut = false
                return 0
            }
            v = x / y
        }
        else if op == 4 {
            if y == 0 {
                *gut = false
                return 0
            }
            v = x % y
        }
        else if op == 5 { v = x & y }
        else if op == 6 { v = x | y }
        else if op == 7 { v = x ^ y }
        else if op == 8 { v = x << y }
        else if op == 9 { v = x >> y }
        else if op == 10 { if x == y { v = 1 } }
        else if op == 11 { if x != y { v = 1 } }
        else if op == 12 { if x < y { v = 1 } }
        else if op == 13 { if x <= y { v = 1 } }
        else if op == 14 { if x > y { v = 1 } }
        else if op == 15 { if x >= y { v = 1 } }
        else if op == 16 { if x != 0 && y != 0 { v = 1 } }
        else { if x != 0 || y != 0 { v = 1 } }
        return wickeln(s, v, sema_typ(s, e))
    }
    if a == ast.E_AS {
        let v: i64 = konst_auswerten(s, ast.e_a(b, e), gut)
        let dst: u32 = sema_typ(s, e)
        if ist_bool(s, dst) {
            if v != 0 {
                return 1
            }
            return 0
        }
        if typen.ist_zeiger(tafel(s), dst) {
            *gut = false
            return 0
        }
        return wickeln(s, v, dst)
    }
    // Ein AUFRUF in einem konstanten Ausdruck heisst: `firnc0` fuehrt die
    // Funktion zur Uebersetzungszeit aus (comptime.rs). Das ist nicht
    // portiert — die Datei wird gesondert gezaehlt, nicht als Abweichung.
    if a == ast.E_RUF {
        (*s).ct_noetig = true
    }
    *gut = false
    return 0
}

// ------------------------------------------------------------- Ausdruecke
//
// `hinweis` ist der Kontexttyp oder KEIN. Rueckgabe ist immer ein konkreter
// Typ; im Fehlerfall der Fehlertyp.

fn ausdruck(s: *mut Sema, e: u32, hinweis: u32) -> u32 {
    let t: u32 = ausdruck_inner(s, e, hinweis)
    merke(s, e, t)
    return t
}

// Gibt allen Teilausdruecken einen konkreten Typ, ohne inhaltlich zu pruefen.
fn austypen(s: *mut Sema, e: u32) {
    ausdruck(s, e, (*s).t_i64)
}

fn feld_typ(s: *mut Sema, bt: u32, name: u32) -> u32 {
    if typen.ty_art(tafel(s), bt) == typen.K_STRUCT {
        let ft: u32 = typen.st_feld_typ(tafel(s), typen.ty_a(tafel(s), bt) as usize, name)
        if ft == KEIN {
            meckern(s)
            return (*s).t_fehler
        }
        return ft
    }
    if ist_fehler(s, bt) {
        return (*s).t_fehler
    }
    meckern(s)
    return (*s).t_fehler
}

fn index_typ(s: *mut Sema, bt: u32, idx: u32) -> u32 {
    let it: u32 = ausdruck(s, idx, (*s).t_usize)
    if !ist_fehler(s, it) && !typen.typ_gleich(tafel(s), it, (*s).t_usize) {
        meckern(s)
    }
    if typen.ty_art(tafel(s), bt) == typen.K_ARR {
        return typen.ty_a(tafel(s), bt)
    }
    if ist_fehler(s, bt) {
        return (*s).t_fehler
    }
    meckern(s)
    return (*s).t_fehler
}

// Zuweisbarer Ausdruck: liefert den Typ oder KEIN.
fn lwert(s: *mut Sema, e: u32) -> u32 {
    let b: *mut ast.Baum = baum(s)
    let a: u32 = ast.e_art(b, e)
    if a == ast.E_ID {
        let v: u32 = var_suchen(s, ast.e_a(b, e))
        if v != KEIN {
            merke(s, e, v)
            return v
        }
        let k: u32 = konst_suchen(s, ast.e_a(b, e))
        if k != KEIN {
            merke(s, e, k)
            return k
        }
        meckern(s)
        merke(s, e, (*s).t_fehler)
        return (*s).t_fehler
    }
    if a == ast.E_FELD {
        let bt: u32 = lwert(s, ast.e_a(b, e))
        if bt == KEIN {
            return KEIN
        }
        let t: u32 = feld_typ(s, bt, ast.e_b(b, e))
        merke(s, e, t)
        return t
    }
    if a == ast.E_IDX {
        let bt: u32 = lwert(s, ast.e_a(b, e))
        if bt == KEIN {
            return KEIN
        }
        let t: u32 = index_typ(s, bt, ast.e_b(b, e))
        merke(s, e, t)
        return t
    }
    if a == ast.E_UN && ast.e_a(b, e) == 3 {
        let t0: u32 = ausdruck(s, ast.e_b(b, e), KEIN)
        var t: u32 = (*s).t_fehler
        if typen.ty_art(tafel(s), t0) == typen.K_PTR {
            t = typen.ty_a(tafel(s), t0)
        } else if !ist_fehler(s, t0) {
            meckern(s)
        }
        merke(s, e, t)
        return t
    }
    austypen(s, e)
    meckern(s)
    return KEIN
}

fn unaer(s: *mut Sema, e: u32, hinweis: u32) -> u32 {
    let b: *mut ast.Baum = baum(s)
    let op: u32 = ast.e_a(b, e)
    let inner: u32 = ast.e_b(b, e)
    if op == 0 {
        var h: u32 = probe(s, inner)
        if h == KEIN {
            if hinweis != KEIN && ist_int(s, hinweis) {
                h = hinweis
            }
        }
        let t: u32 = ausdruck(s, inner, h)
        if ist_fehler(s, t) {
            return (*s).t_fehler
        }
        if !ist_int(s, t) {
            meckern(s)
            return (*s).t_fehler
        }
        return t
    }
    if op == 1 {
        let t: u32 = ausdruck(s, inner, (*s).t_bool)
        if ist_fehler(s, t) {
            return (*s).t_fehler
        }
        if !ist_bool(s, t) {
            meckern(s)
            return (*s).t_fehler
        }
        return (*s).t_bool
    }
    if op == 2 {
        let t: u32 = lwert(s, inner)
        if t == KEIN || ist_fehler(s, t) {
            return (*s).t_fehler
        }
        return typen.neuer_typ(tafel(s), typen.K_PTR, t, 1)
    }
    let t: u32 = ausdruck(s, inner, KEIN)
    if typen.ty_art(tafel(s), t) == typen.K_PTR {
        return typen.ty_a(tafel(s), t)
    }
    if ist_fehler(s, t) {
        return (*s).t_fehler
    }
    meckern(s)
    return (*s).t_fehler
}

fn binaer(s: *mut Sema, e: u32, hinweis: u32) -> u32 {
    let b: *mut ast.Baum = baum(s)
    let op: u32 = ast.e_a(b, e)
    let l: u32 = ast.e_b(b, e)
    let r: u32 = ast.e_c(b, e)

    // logische Verknuepfung
    if op == 16 || op == 17 {
        let lt: u32 = ausdruck(s, l, (*s).t_bool)
        let rt: u32 = ausdruck(s, r, (*s).t_bool)
        if !ist_fehler(s, lt) && !ist_bool(s, lt) {
            meckern(s)
        }
        if !ist_fehler(s, rt) && !ist_bool(s, rt) {
            meckern(s)
        }
        return (*s).t_bool
    }

    // Vergleich
    if op >= 10 && op <= 15 {
        var want: u32 = probe(s, l)
        if want == KEIN {
            want = probe(s, r)
        }
        let lt: u32 = ausdruck(s, l, want)
        let rt: u32 = ausdruck(s, r, want)
        if ist_fehler(s, lt) || ist_fehler(s, rt) {
            return (*s).t_bool
        }
        if !typen.vertraeglich(tafel(s), lt, rt) {
            meckern(s)
            return (*s).t_bool
        }
        let nur_gleich: bool = op == 10 || op == 11
        var ok: bool = ist_int(s, lt) || ist_f64(s, lt)
        if !ok && nur_gleich {
            ok = ist_bool(s, lt) || typen.ist_zeiger(tafel(s), lt)
        }
        if !ok {
            meckern(s)
        }
        return (*s).t_bool
    }

    // Verschiebung: der linke Operand bestimmt den Typ
    if op == 8 || op == 9 {
        var h: u32 = probe(s, l)
        if h == KEIN {
            if hinweis != KEIN && ist_int(s, hinweis) {
                h = hinweis
            }
        }
        let lt: u32 = ausdruck(s, l, h)
        var rh: u32 = probe(s, r)
        if rh == KEIN {
            if ist_int(s, lt) {
                rh = lt
            } else {
                rh = (*s).t_i64
            }
        }
        let rt: u32 = ausdruck(s, r, rh)
        if ist_fehler(s, lt) {
            return (*s).t_fehler
        }
        if ist_fehler(s, rt) {
            return lt
        }
        if !ist_int(s, lt) || !ist_int(s, rt) {
            meckern(s)
            return (*s).t_fehler
        }
        return lt
    }

    // Arithmetik und Bitoperationen: der bereits typisierte Operand hat
    // VORRANG vor dem Kontexthinweis.
    var want: u32 = probe(s, l)
    if want == KEIN {
        want = probe(s, r)
    }
    if want == KEIN {
        if hinweis != KEIN && ist_int(s, hinweis) {
            want = hinweis
        }
    }
    let lt: u32 = ausdruck(s, l, want)
    let rt: u32 = ausdruck(s, r, want)
    if ist_fehler(s, lt) || ist_fehler(s, rt) {
        return (*s).t_fehler
    }
    if ist_f64(s, lt) || ist_f64(s, rt) {
        // `%` und die Bitoperationen sind fuer f64 nicht definiert.
        let erlaubt: bool = op <= 3
        if !erlaubt {
            meckern(s)
            return (*s).t_fehler
        }
        if !typen.typ_gleich(tafel(s), lt, rt) {
            meckern(s)
            return (*s).t_fehler
        }
        return (*s).t_f64
    }
    if !ist_int(s, lt) || !ist_int(s, rt) || !typen.typ_gleich(tafel(s), lt, rt) {
        meckern(s)
        return (*s).t_fehler
    }
    return lt
}

fn ruf(s: *mut Sema, e: u32) -> u32 {
    let b: *mut ast.Baum = baum(s)
    let name: u32 = ast.e_a(b, e)
    let off: u32 = ast.e_b(b, e)
    let anz: u32 = ast.e_c(b, e)
    let f: u32 = fn_suchen(s, name)
    if f == KEIN {
        var k: u32 = 0
        while k < anz {
            austypen(s, ast.kind_at(b, off + k))
            k = k + 1
        }
        meckern(s)
        return (*s).t_fehler
    }
    let plen: u32 = ast.fn_plen(b, f as usize)
    if anz != plen {
        meckern(s)
    }
    var k: u32 = 0
    while k < anz {
        let arg: u32 = ast.kind_at(b, off + k)
        if k < plen {
            let pt: u32 = typen.param_typ_aufgeloest(tafel(s), f as usize, k)
            let t: u32 = ausdruck(s, arg, pt)
            if !typen.vertraeglich(tafel(s), t, pt) {
                meckern(s)
            }
        } else {
            austypen(s, arg)
        }
        k = k + 1
    }
    return typen.ret_typ_der_funktion(tafel(s), f as usize)
}

fn struct_literal(s: *mut Sema, e: u32) -> u32 {
    let b: *mut ast.Baum = baum(s)
    let name: u32 = ast.e_a(b, e)
    let off: u32 = ast.e_b(b, e)
    let anz: u32 = ast.e_c(b, e)
    let si: i32 = typen.struct_index(tafel(s), name)
    if si < 0 {
        var k: u32 = 0
        while k < anz {
            austypen(s, ast.kind_at(b, off + k * 2 + 1))
            k = k + 1
        }
        meckern(s)
        return (*s).t_fehler
    }
    var k: u32 = 0
    while k < anz {
        let fname: u32 = ast.kind_at(b, off + k * 2)
        let fexpr: u32 = ast.kind_at(b, off + k * 2 + 1)
        let ft: u32 = typen.st_feld_typ(tafel(s), si as usize, fname)
        if ft == KEIN {
            austypen(s, fexpr)
            meckern(s)
        } else {
            let t: u32 = ausdruck(s, fexpr, ft)
            if !typen.vertraeglich(tafel(s), t, ft) {
                meckern(s)
            }
        }
        k = k + 1
    }
    if anz != typen.st_flen(tafel(s), si as usize) {
        meckern(s)
    }
    return typen.neuer_typ(tafel(s), typen.K_STRUCT, si as u32, 0)
}

fn ausdruck_inner(s: *mut Sema, e: u32, hinweis: u32) -> u32 {
    let b: *mut ast.Baum = baum(s)
    let a: u32 = ast.e_art(b, e)

    if a == ast.E_FLOAT {
        return (*s).t_f64
    }
    if a == ast.E_INT {
        // Ein Ganzzahlliteral hat KEINEN eigenen Typ — er kommt von aussen.
        if hinweis != KEIN {
            if ist_int(s, hinweis) {
                return hinweis
            }
            if ist_fehler(s, hinweis) {
                return (*s).t_fehler
            }
        }
        meckern(s)
        return (*s).t_fehler
    }
    if a == ast.E_BOOL {
        return (*s).t_bool
    }
    if a == ast.E_ID {
        let v: u32 = var_suchen(s, ast.e_a(b, e))
        if v != KEIN {
            return v
        }
        let k: u32 = konst_suchen(s, ast.e_a(b, e))
        if k != KEIN {
            return k
        }
        meckern(s)
        return (*s).t_fehler
    }
    if a == ast.E_UN {
        return unaer(s, e, hinweis)
    }
    if a == ast.E_BIN {
        return binaer(s, e, hinweis)
    }
    if a == ast.E_FELD {
        let bt: u32 = ausdruck(s, ast.e_a(b, e), KEIN)
        return feld_typ(s, bt, ast.e_b(b, e))
    }
    if a == ast.E_IDX {
        let bt: u32 = ausdruck(s, ast.e_a(b, e), KEIN)
        return index_typ(s, bt, ast.e_b(b, e))
    }
    if a == ast.E_RUF {
        return ruf(s, e)
    }
    if a == ast.E_SYSCALL {
        let off: u32 = ast.e_b(b, e)
        let anz: u32 = ast.e_c(b, e)
        if anz == 0 || anz > 7 {
            meckern(s)
        }
        var k: u32 = 0
        while k < anz {
            let t: u32 = ausdruck(s, ast.kind_at(b, off + k), (*s).t_i64)
            if !ist_fehler(s, t) && !ist_int(s, t) && !typen.ist_zeiger(tafel(s), t) {
                meckern(s)
            }
            k = k + 1
        }
        return (*s).t_i64
    }
    if a == ast.E_AS {
        let dst: u32 = ast_typ(s, ast.e_b(b, e))
        var ih: u32 = KEIN
        if ist_int(s, dst) {
            ih = dst
        } else if ist_bool(s, dst) {
            ih = (*s).t_i64
        } else if typen.ist_zeiger(tafel(s), dst) {
            ih = (*s).t_usize
        }
        let src: u32 = ausdruck(s, ast.e_a(b, e), ih)
        if ist_fehler(s, src) || ist_fehler(s, dst) {
            return dst
        }
        if !umwandelbar(s, src) || !umwandelbar(s, dst) {
            meckern(s)
            return (*s).t_fehler
        }
        return dst
    }
    if a == ast.E_SLIT {
        return struct_literal(s, e)
    }
    if a == ast.E_AWDH {
        let wert: u32 = ast.e_a(b, e)
        let anzahl: u32 = ast.e_b(b, e)
        let ct: u32 = ausdruck(s, anzahl, (*s).t_usize)
        var n: u64 = 0
        if ist_fehler(s, ct) || !ist_int(s, ct) {
            if !ist_fehler(s, ct) {
                meckern(s)
            }
        } else {
            var gut: bool = true
            let v: i64 = konst_auswerten(s, anzahl, &gut)
            if gut && v > 0 {
                n = v as u64
            } else {
                meckern(s)
            }
        }
        var eh: u32 = KEIN
        if hinweis != KEIN {
            if typen.ty_art(tafel(s), hinweis) == typen.K_ARR {
                eh = typen.ty_a(tafel(s), hinweis)
            }
        }
        let vt: u32 = ausdruck(s, wert, eh)
        if n == 0 || ist_fehler(s, vt) {
            return (*s).t_fehler
        }
        if hinweis != KEIN {
            if typen.ty_art(tafel(s), hinweis) == typen.K_ARR {
                if !typen.vertraeglich(tafel(s), vt, typen.ty_a(tafel(s), hinweis)) {
                    meckern(s)
                }
                if typen.ty_n(tafel(s), hinweis) != n {
                    meckern(s)
                }
            }
        }
        return typen.neuer_typ(tafel(s), typen.K_ARR, vt, n)
    }
    // Array-Literal
    let off: u32 = ast.e_b(b, e)
    let anz: u32 = ast.e_c(b, e)
    var ist_arr: bool = false
    if hinweis != KEIN {
        ist_arr = typen.ty_art(tafel(s), hinweis) == typen.K_ARR
    }
    if ist_arr {
        let et: u32 = typen.ty_a(tafel(s), hinweis)
        if anz as u64 != typen.ty_n(tafel(s), hinweis) {
            meckern(s)
        }
        var k: u32 = 0
        while k < anz {
            let t: u32 = ausdruck(s, ast.kind_at(b, off + k), et)
            if !typen.vertraeglich(tafel(s), t, et) {
                meckern(s)
            }
            k = k + 1
        }
        return typen.neuer_typ(tafel(s), typen.K_ARR, et, typen.ty_n(tafel(s), hinweis))
    }
    var k: u32 = 0
    while k < anz {
        austypen(s, ast.kind_at(b, off + k))
        k = k + 1
    }
    meckern(s)
    return (*s).t_fehler
}

// ------------------------------------------------------------- Anweisungen

fn bedingung(s: *mut Sema, e: u32) {
    let t: u32 = ausdruck(s, e, (*s).t_bool)
    if !ist_fehler(s, t) && !ist_bool(s, t) {
        meckern(s)
    }
}

fn anweisung(s: *mut Sema, i: u32) {
    let b: *mut ast.Baum = baum(s)
    let a: u32 = ast.s_art(b, i)

    if a == ast.S_LET || a == ast.S_VAR {
        let te: u32 = ast.s_b(b, i)
        var t: u32 = 0
        if te != ast.NICHTS {
            let d: u32 = ast_typ(s, te)
            let got: u32 = ausdruck(s, ast.s_c(b, i), d)
            if !typen.vertraeglich(tafel(s), got, d) {
                meckern(s)
            }
            t = d
        } else {
            let got: u32 = ausdruck(s, ast.s_c(b, i), KEIN)
            if typen.ty_art(tafel(s), got) == typen.K_VOID {
                meckern(s)
                t = (*s).t_fehler
            } else {
                t = got
            }
        }
        var_anlegen(s, ast.s_a(b, i), t)
        return
    }
    if a == ast.S_ZUW {
        let t: u32 = lwert(s, ast.s_a(b, i))
        if t == KEIN {
            ausdruck(s, ast.s_b(b, i), (*s).t_i64)
            return
        }
        let got: u32 = ausdruck(s, ast.s_b(b, i), t)
        if !typen.vertraeglich(tafel(s), got, t) {
            meckern(s)
        }
        return
    }
    if a == ast.S_IF {
        bedingung(s, ast.s_a(b, i))
        block(s, ast.s_b(b, i), false)
        if ast.s_c(b, i) != ast.NICHTS {
            anweisung(s, ast.s_c(b, i))
        }
        return
    }
    if a == ast.S_WHILE {
        bedingung(s, ast.s_a(b, i))
        block(s, ast.s_b(b, i), false)
        return
    }
    if a == ast.S_FOR {
        var want: u32 = probe(s, ast.s_b(b, i))
        if want == KEIN {
            want = probe(s, ast.s_c(b, i))
        }
        let st: u32 = ausdruck(s, ast.s_b(b, i), want)
        var w2: u32 = want
        if w2 == KEIN {
            w2 = st
        }
        let et: u32 = ausdruck(s, ast.s_c(b, i), w2)
        var t: u32 = (*s).t_fehler
        if ist_fehler(s, st) || ist_fehler(s, et) {
            t = (*s).t_fehler
        } else if !ist_int(s, st) || !ist_int(s, et) || !typen.typ_gleich(tafel(s), st, et) {
            meckern(s)
            t = (*s).t_fehler
        } else {
            t = st
        }
        bereich_auf(s)
        var_anlegen(s, ast.s_a(b, i), t)
        block(s, ast.s_d(b, i), true)
        bereich_zu(s)
        return
    }
    if a == ast.S_RET {
        let w: u32 = (*s).ret
        if ast.s_a(b, i) == ast.NICHTS {
            if typen.ty_art(tafel(s), w) != typen.K_VOID && !ist_fehler(s, w) {
                meckern(s)
            }
            return
        }
        if typen.ty_art(tafel(s), w) == typen.K_VOID {
            ausdruck(s, ast.s_a(b, i), (*s).t_i64)
            meckern(s)
            return
        }
        let got: u32 = ausdruck(s, ast.s_a(b, i), w)
        if !typen.vertraeglich(tafel(s), got, w) {
            meckern(s)
        }
        return
    }
    if a == ast.S_DEFER || a == ast.S_ERRDEFER {
        anweisung(s, ast.s_a(b, i))
        return
    }
    if a == ast.S_EXPR {
        ausdruck(s, ast.s_a(b, i), KEIN)
        return
    }
    if a == ast.S_BLOCK {
        block(s, ast.s_a(b, i), false)
        return
    }
    // break / continue: der Parser hat die Lage schon geprueft.
}

fn block(s: *mut Sema, bi: u32, bereich_schon_offen: bool) {
    let b: *mut ast.Baum = baum(s)
    if !bereich_schon_offen {
        bereich_auf(s)
    }
    var k: u32 = 0
    while k < ast.b_len(b, bi) {
        anweisung(s, ast.sliste_at(b, ast.b_off(b, bi) + k))
        k = k + 1
    }
    if !bereich_schon_offen {
        bereich_zu(s)
    }
}

// ------------------------------------------------------------------- Lauf

fn sema_lauf(s: *mut Sema) {
    let b: *mut ast.Baum = baum(s)
    // 1. Structlayout und Funktionssignaturen — dieselbe Rechnung wie in
    //    `typen.fi`, hier einmal fuer alles.
    typen.typen_aufloesen(tafel(s), b, namen(s))

    // 2. Grundtypen anlegen, damit sie nicht bei jedem Zugriff neu entstehen.
    (*s).t_bool = typen.neuer_typ(tafel(s), typen.K_BOOL, 0, 0)
    (*s).t_i64 = typen.neuer_typ(tafel(s), typen.K_I64, 0, 0)
    (*s).t_usize = typen.neuer_typ(tafel(s), typen.K_USIZE, 0, 0)
    (*s).t_void = typen.neuer_typ(tafel(s), typen.K_VOID, 0, 0)
    (*s).t_fehler = typen.neuer_typ(tafel(s), typen.K_FEHLER, 0, 0)
    (*s).t_f64 = typen.neuer_typ(tafel(s), typen.K_F64, 0, 0)

    // 3. Typtabelle fuer alle Ausdruecke anlegen.
    var i: usize = 0
    while i < ast.ausdruck_anzahl(b) {
        vec_push[u32](&(*s).etyp, (*s).t_fehler)
        i = i + 1
    }

    // 4. Konstanten der Reihe nach: eine spaetere darf eine fruehere benutzen.
    bereich_auf(s)
    i = 0
    while i < ast.konst_anzahl(b) {
        let t: u32 = ast_typ(s, ast.konst_typ(b, i))
        let got: u32 = ausdruck(s, ast.konst_wert(b, i), t)
        if !typen.vertraeglich(tafel(s), got, t) {
            meckern(s)
        }
        var gut: bool = true
        let v: i64 = konst_auswerten(s, ast.konst_wert(b, i), &gut)
        vec_push[u32](&(*s).k_name, ast.konst_name(b, i))
        vec_push[u32](&(*s).k_typ, t)
        if gut {
            vec_push[u64](&(*s).k_wert, wickeln(s, v, t) as u64)
        } else {
            vec_push[u64](&(*s).k_wert, 0)
            meckern(s)
        }
        i = i + 1
    }

    // 5. Funktionsrumpfe.
    i = 0
    while i < ast.fn_anzahl(b) {
        (*s).ret = typen.ret_typ_der_funktion(tafel(s), i)
        bereich_auf(s)
        var k: u32 = 0
        while k < ast.fn_plen(b, i) {
            var_anlegen(s, ast.param_name(b, ast.fn_poff(b, i) + k),
                        typen.param_typ_aufgeloest(tafel(s), i, k))
            k = k + 1
        }
        block(s, ast.fn_rumpf(b, i), true)
        bereich_zu(s)
        i = i + 1
    }
    bereich_zu(s)
}
