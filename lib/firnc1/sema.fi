// lib/firnc1/sema.fi — TYPPRUEFER, IN FIRN.
//
// Sechster Teil von Stufe 1 und der bisher groesste: die Portierung des Kerns
// von `compiler/src/sema.rs`. Geprueft wird das, was `firnc0` zusichert —
// **jeder Ausdruck bekommt einen konkreten Typ**.
//
// DAS VERFAHREN IST BIDIREKTIONAL. Ein Ganzzahlliteral hat in Firn keinen
// eigenen Typ; er kommt aus dem Zusammenhang:
//
//     let x: i32 = 5        der Kontexthinweis macht die 5 zu i32
//     a + 1                 der Typ von `a` macht die 1 zu dessen Typ
//     5                     allein steht: FEHLER, nicht ableitbar
//
// Dafuer gibt es zwei Wege durch denselben Baum:
//   * `probe` ermittelt den Typ OHNE zu melden und ohne die Tabelle zu
//     beschreiben — damit `a + 1` den Typ des Literals aus `a` gewinnt;
//   * `ausdruck` prueft wirklich und traegt den Typ ein.
// Die Reihenfolge ist Vertrag: erst der bereits typisierte Operand, dann der
// Kontexthinweis. Sonst meldet `let x: i64 = a + 1` (a: i32) den Fehler an der
// falschen Stelle.
//
// NICHT PORTIERT (und deshalb hier benannt): saemtliche Fehlermeldungen. Die
// Firn-Fassung ZAEHLT Fehler, sie beschreibt sie nicht. Der Vergleich laeuft
// nur ueber Quellen, die `firnc0` fehlerfrei prueft — dort ist die Zahl der
// Meldungen null, und was zaehlt, sind die Typen. Ebenso fehlen
// Erreichbarkeitsanalyse (`return` am Ende), Veraenderlichkeitspruefung
// (`let` gegen `var`) und die Rekursionspruefung fuer Structs.

import rt
import vec
import intern
import ast
import typen
import muster
import fehler
import gc
import nogc

export { Sema, sema_neu, sema_frei, sema_lauf, sema_fehler, sema_typ,
         sema_typen, sema_typ_anzahl, sema_braucht_comptime, sema_konst_wert,
         sema_mu_setzen, sema_fe_setzen, sema_gc_setzen, sema_baum }

const KEIN: u32 = 4294967295

struct Sema {
    b: u64,              // Zeiger auf den Baum
    it: u64,             // Zeiger auf den Interner
    ty: typen.Typen,
    etyp: Vec[u32],      // Typ je Ausdrucksknoten
    v_name: Vec[u32],    // Bereiche: Namen, Typen und Grenzen
    v_typ: Vec[u32],
    b_grenze: Vec[u32],
    k_name: Vec[u32],    // Konstanten
    k_typ: Vec[u32],
    k_wert: Vec[u64],
    t_bool: u32,         // vorgefertigte Typen
    t_i64: u32,
    t_usize: u32,
    t_void: u32,
    t_fehler: u32,
    t_f64: u32,
    ret: u32,            // Rueckgabetyp der laufenden Funktion
    mu: u64,             // Register der Aufzaehlungen/Musterabgleiche (0 = keins)
    feh: u64,            // Register der Fehlermengen/-unionen (0 = keins)
    gc: u64,             // Registrierung der gc-Klassen (Runde 34; 0 = keine)
    fehler: usize,
    ct_noetig: bool,     // eine Konstante braucht Auswertung zur Uebersetzungszeit
}

fn sema_neu(b: u64, it: u64) -> Sema {
    return Sema{
        b: b, it: it,
        ty: typen.typen_neu(),
        etyp: vec_neu[u32](),
        v_name: vec_neu[u32](), v_typ: vec_neu[u32](), b_grenze: vec_neu[u32](),
        k_name: vec_neu[u32](), k_typ: vec_neu[u32](), k_wert: vec_neu[u64](),
        t_bool: 0, t_i64: 0, t_usize: 0, t_void: 0, t_fehler: 0, t_f64: 0,
        ret: 0, mu: 0, feh: 0, gc: 0, fehler: 0, ct_noetig: false,
    }
}

fn sema_frei(s: *mut Sema) {
    typen.typen_frei(&(*s).ty)
    vec_frei[u32](&(*s).etyp)
    vec_frei[u32](&(*s).v_name)
    vec_frei[u32](&(*s).v_typ)
    vec_frei[u32](&(*s).b_grenze)
    vec_frei[u32](&(*s).k_name)
    vec_frei[u32](&(*s).k_typ)
    vec_frei[u64](&(*s).k_wert)
}

fn sema_fehler(s: *mut Sema) -> usize { return (*s).fehler }

// Das Muster-Register anmelden. MUSS vor `sema_lauf` stehen.
fn sema_mu_setzen(s: *mut Sema, m: u64) { (*s).mu = m }

fn mu(s: *mut Sema) -> *mut muster.Mus { return (*s).mu as *mut muster.Mus }
fn hat_mu(s: *mut Sema) -> bool { return (*s).mu != 0 }

// Das Fehler-Register anmelden. MUSS vor `sema_lauf` stehen.
fn sema_fe_setzen(s: *mut Sema, f: u64) { (*s).feh = f }

fn fe(s: *mut Sema) -> *mut fehler.Fehler { return (*s).feh as *mut fehler.Fehler }
fn hat_fe(s: *mut Sema) -> bool { return (*s).feh != 0 }

// Die gc-Registrierung anmelden (Runde 34). MUSS vor `sema_lauf` stehen.
fn sema_gc_setzen(s: *mut Sema, g: u64) { (*s).gc = g }

fn gcp(s: *mut Sema) -> *mut gc.Gc { return (*s).gc as *mut gc.Gc }
fn hat_gc(s: *mut Sema) -> bool { return (*s).gc != 0 }

// Der Baum hinter diesem Lauf (fuer `nogc.fi`).
fn sema_baum(s: *mut Sema) -> *mut ast.Baum { return (*s).b as *mut ast.Baum }
fn sema_braucht_comptime(s: *mut Sema) -> bool { return (*s).ct_noetig }
fn sema_typen(s: *mut Sema) -> *mut typen.Typen { return &(*s).ty }
fn sema_typ_anzahl(s: *mut Sema) -> usize { return vec_len[u32](&(*s).etyp) }
fn sema_typ(s: *mut Sema, i: u32) -> u32 { return vec_at[u32](&(*s).etyp, i as usize) }

fn baum(s: *mut Sema) -> *mut ast.Baum { return (*s).b as *mut ast.Baum }
fn tafel(s: *mut Sema) -> *mut typen.Typen { return &(*s).ty }
fn namen(s: *mut Sema) -> *mut intern.Interner { return (*s).it as *mut intern.Interner }

fn meckern(s: *mut Sema) { (*s).fehler = (*s).fehler + 1 }

fn merke(s: *mut Sema, e: u32, t: u32) {
    vec_setzen[u32](&(*s).etyp, e as usize, t)
}

// ------------------------------------------------------------------ Bereiche

fn bereich_auf(s: *mut Sema) {
    vec_push[u32](&(*s).b_grenze, vec_len[u32](&(*s).v_name) as u32)
}

fn bereich_zu(s: *mut Sema) {
    let g: u32 = vec_letztes[u32](&(*s).b_grenze)
    vec_pop[u32](&(*s).b_grenze)
    while vec_len[u32](&(*s).v_name) > g as usize {
        vec_pop[u32](&(*s).v_name)
        vec_pop[u32](&(*s).v_typ)
    }
}

fn var_anlegen(s: *mut Sema, name: u32, t: u32) {
    vec_push[u32](&(*s).v_name, name)
    vec_push[u32](&(*s).v_typ, t)
}

// Von hinten suchen: der innerste Bereich gewinnt.
fn var_suchen(s: *mut Sema, name: u32) -> u32 {
    var i: usize = vec_len[u32](&(*s).v_name)
    while i > 0 {
        i = i - 1
        if vec_at[u32](&(*s).v_name, i) == name {
            return vec_at[u32](&(*s).v_typ, i)
        }
    }
    return KEIN
}

fn konst_suchen(s: *mut Sema, name: u32) -> u32 {
    var i: usize = 0
    while i < vec_len[u32](&(*s).k_name) {
        if vec_at[u32](&(*s).k_name, i) == name {
            return vec_at[u32](&(*s).k_typ, i)
        }
        i = i + 1
    }
    return KEIN
}

fn sema_konst_wert(s: *mut Sema, name: u32) -> u64 {
    return konst_wert(s, name)
}

fn konst_wert(s: *mut Sema, name: u32) -> u64 {
    var i: usize = 0
    while i < vec_len[u32](&(*s).k_name) {
        if vec_at[u32](&(*s).k_name, i) == name {
            return vec_at[u64](&(*s).k_wert, i)
        }
        i = i + 1
    }
    return 0
}

// Nummer der Funktion mit diesem Namen, oder KEIN.
fn fn_suchen(s: *mut Sema, name: u32) -> u32 {
    var i: usize = 0
    while i < ast.fn_anzahl(baum(s)) {
        if ast.fn_name(baum(s), i) == name {
            return i as u32
        }
        i = i + 1
    }
    return KEIN
}

// -------------------------------------------------------------- Hilfsfragen

fn ist_int(s: *mut Sema, t: u32) -> bool { return typen.ist_ganzzahl(tafel(s), t) }
fn ist_fehler(s: *mut Sema, t: u32) -> bool { return typen.ty_art(tafel(s), t) == typen.K_FEHLER }
fn ist_bool(s: *mut Sema, t: u32) -> bool { return typen.ty_art(tafel(s), t) == typen.K_BOOL }
fn ist_f64(s: *mut Sema, t: u32) -> bool { return typen.ty_art(tafel(s), t) == typen.K_F64 }

// Darf dieser Typ an einer `as`-Umwandlung teilnehmen?
fn umwandelbar(s: *mut Sema, t: u32) -> bool {
    return ist_int(s, t) || ist_bool(s, t) || typen.ist_zeiger(tafel(s), t) || ist_f64(s, t)
}

// Loest einen Typausdruck des Baums auf.
fn ast_typ(s: *mut Sema, te: u32) -> u32 {
    return typen.aufloesen(tafel(s), baum(s), namen(s), te)
}

// ---------------------------------------------------------------- probe
//
// Typ eines Ausdrucks OHNE Meldung und ohne die Tabelle zu beschreiben.
// KEIN heisst "nicht ableitbar" — genau wie `Option::None` in sema.rs.

fn probe(s: *mut Sema, e: u32) -> u32 {
    return probe_t(s, e, 0)
}

fn probe_t(s: *mut Sema, e: u32, d: u32) -> u32 {
    if d >= 200 {
        return KEIN
    }
    let b: *mut ast.Baum = baum(s)
    let a: u32 = ast.e_art(b, e)
    if a == ast.E_INT {
        return KEIN
    }
    if a == ast.E_FLOAT {
        return (*s).t_f64
    }
    if a == ast.E_BOOL {
        return (*s).t_bool
    }
    if a == ast.E_ID {
        let v: u32 = var_suchen(s, ast.e_a(b, e))
        if v != KEIN {
            return v
        }
        return konst_suchen(s, ast.e_a(b, e))
    }
    if a == ast.E_UN {
        let op: u32 = ast.e_a(b, e)
        if op == 0 {
            return probe_t(s, ast.e_b(b, e), d + 1)
        }
        if op == 1 {
            return (*s).t_bool
        }
        if op == 2 {
            let inner: u32 = probe_t(s, ast.e_b(b, e), d + 1)
            if inner == KEIN {
                return KEIN
            }
            return typen.neuer_typ(tafel(s), typen.K_PTR, inner, 1)
        }
        let p: u32 = probe_t(s, ast.e_b(b, e), d + 1)
        if p == KEIN {
            return KEIN
        }
        if typen.ty_art(tafel(s), p) != typen.K_PTR {
            return KEIN
        }
        return typen.ty_a(tafel(s), p)
    }
    if a == ast.E_BIN {
        let op: u32 = ast.e_a(b, e)
        if op >= 10 {
            return (*s).t_bool
        }
        if op == 8 || op == 9 {
            return probe_t(s, ast.e_b(b, e), d + 1)
        }
        let l: u32 = probe_t(s, ast.e_b(b, e), d + 1)
        if l != KEIN {
            return l
        }
        return probe_t(s, ast.e_c(b, e), d + 1)
    }
    if a == ast.E_FELD {
        let bt: u32 = probe_t(s, ast.e_a(b, e), d + 1)
        if bt == KEIN {
            return KEIN
        }
        // HOOK gc: Feldzugriff durch `Gc[T]` hindurch, ohne zu melden
        // (sema.rs::probe_d ueber gc::hook_field_base).
        if hat_gc(s) {
            let si: u32 = gc.gc_feld_basis(gcp(s), tafel(s), bt)
            if si != KEIN {
                return typen.st_feld_typ(tafel(s), si as usize, ast.e_b(b, e))
            }
        }
        if typen.ty_art(tafel(s), bt) != typen.K_STRUCT {
            return KEIN
        }
        return typen.st_feld_typ(tafel(s), typen.ty_a(tafel(s), bt) as usize, ast.e_b(b, e))
    }
    if a == ast.E_IDX {
        let bt: u32 = probe_t(s, ast.e_a(b, e), d + 1)
        if bt == KEIN {
            return KEIN
        }
        if typen.ty_art(tafel(s), bt) != typen.K_ARR {
            return KEIN
        }
        return typen.ty_a(tafel(s), bt)
    }
    if a == ast.E_RUF {
        if ast.e_zahl(b, e) != 0 {
            return (*s).t_usize
        }
        // HOOK fehlerunionen: `try a`/`a catch b` liefern den Erfolgstyp
        // der Fehlerunion (errors.rs::success_type ueber probe_d).
        if hat_fe(s) {
            if fehler.fehler_ist_ergebnisname(namen(s), ast.e_a(b, e)) {
                if ast.e_c(b, e) == 0 {
                    return KEIN
                }
                let inner: u32 = probe_t(s, ast.kind_at(b, ast.e_b(b, e)), d + 1)
                if inner == KEIN {
                    return KEIN
                }
                let u: u32 = fehler.fehler_union_von_typ(fe(s), tafel(s), inner)
                if u == KEIN {
                    return KEIN
                }
                return fehler.fehler_u_valty(fe(s), u)
            }
        }
        if hat_gc(s) {
            // HOOK gc (gc.rs::probe_typ): `weak`/`stark`/`x.as?[C]` OHNE
            // Pruefung — damit ein Ganzzahlliteral daneben seinen Typ
            // bekommt.
            var argt: u32 = KEIN
            if ast.e_c(b, e) > 0 {
                argt = probe_t(s, ast.kind_at(b, ast.e_b(b, e)), d + 1)
            }
            let pt: u32 = gc.gc_probe_typ(gcp(s), tafel(s), namen(s), ast.e_a(b, e), argt)
            if pt != KEIN {
                return pt
            }
        }
        let f: u32 = fn_suchen(s, ast.e_a(b, e))
        if f == KEIN {
            return KEIN
        }
        return typen.ret_typ_der_funktion(tafel(s), f as usize)
    }
    if a == ast.E_SYSCALL {
        return (*s).t_i64
    }
    if a == ast.E_AS {
        return ast_typ(s, ast.e_b(b, e))
    }
    if a == ast.E_SLIT {
        let si: i32 = typen.struct_index(tafel(s), ast.e_a(b, e))
        if si < 0 {
            return KEIN
        }
        return typen.neuer_typ(tafel(s), typen.K_STRUCT, si as u32, 0)
    }
    if a == ast.E_ALIT {
        if ast.e_c(b, e) == 0 {
            return KEIN
        }
        let et: u32 = probe_t(s, ast.kind_at(b, ast.e_b(b, e)), d + 1)
        if et == KEIN {
            return KEIN
        }
        return typen.neuer_typ(tafel(s), typen.K_ARR, et, ast.e_c(b, e) as u64)
    }
    return KEIN
}

// ------------------------------------------------- konstante Auswertung
//
// Gebraucht fuer `const` und fuer die Laenge eines Wiederholungsliterals —
// die geht in den TYP ein (`[T; N]`), also muss sie hier stehen.

fn wickeln(s: *mut Sema, v: i64, t: u32) -> i64 {
    let bits: u32 = typen.bits_von(tafel(s), t)
    if bits == 0 || bits >= 64 {
        return v
    }
    let maske: i64 = (1 << bits as i64) - 1
    let m: i64 = v & maske
    if typen.ist_vorzeichen(tafel(s), t) {
        if (m >> (bits - 1) as i64) & 1 != 0 {
            return m - (1 << bits as i64)
        }
    }
    return m
}

fn konst_auswerten(s: *mut Sema, e: u32, gut: *mut bool) -> i64 {
    let b: *mut ast.Baum = baum(s)
    let a: u32 = ast.e_art(b, e)
    if a == ast.E_INT {
        return ast.e_zahl(b, e) as i64
    }
    if a == ast.E_BOOL {
        if ast.e_a(b, e) == 1 {
            return 1
        }
        return 0
    }
    if a == ast.E_ID {
        if konst_suchen(s, ast.e_a(b, e)) == KEIN {
            *gut = false
            return 0
        }
        return konst_wert(s, ast.e_a(b, e)) as i64
    }
    if a == ast.E_UN {
        let v: i64 = konst_auswerten(s, ast.e_b(b, e), gut)
        let op: u32 = ast.e_a(b, e)
        if op == 0 {
            return 0 - v
        }
        if op == 1 {
            if v == 0 {
                return 1
            }
            return 0
        }
        *gut = false
        return 0
    }
    if a == ast.E_BIN {
        let op: u32 = ast.e_a(b, e)
        let x: i64 = konst_auswerten(s, ast.e_b(b, e), gut)
        let y: i64 = konst_auswerten(s, ast.e_c(b, e), gut)
        var v: i64 = 0
        if op == 0 { v = x + y }
        else if op == 1 { v = x - y }
        else if op == 2 { v = x * y }
        else if op == 3 {
            if y == 0 {
                *gut = false
                return 0
            }
            v = x / y
        }
        else if op == 4 {
            if y == 0 {
                *gut = false
                return 0
            }
            v = x % y
        }
        else if op == 5 { v = x & y }
        else if op == 6 { v = x | y }
        else if op == 7 { v = x ^ y }
        else if op == 8 { v = x << y }
        else if op == 9 { v = x >> y }
        else if op == 10 { if x == y { v = 1 } }
        else if op == 11 { if x != y { v = 1 } }
        else if op == 12 { if x < y { v = 1 } }
        else if op == 13 { if x <= y { v = 1 } }
        else if op == 14 { if x > y { v = 1 } }
        else if op == 15 { if x >= y { v = 1 } }
        else if op == 16 { if x != 0 && y != 0 { v = 1 } }
        else { if x != 0 || y != 0 { v = 1 } }
        return wickeln(s, v, sema_typ(s, e))
    }
    if a == ast.E_AS {
        let v: i64 = konst_auswerten(s, ast.e_a(b, e), gut)
        let dst: u32 = sema_typ(s, e)
        if ist_bool(s, dst) {
            if v != 0 {
                return 1
            }
            return 0
        }
        if typen.ist_zeiger(tafel(s), dst) {
            *gut = false
            return 0
        }
        return wickeln(s, v, dst)
    }
    // Ein AUFRUF in einem konstanten Ausdruck heisst: `firnc0` fuehrt die
    // Funktion zur Uebersetzungszeit aus (comptime.rs). Das ist nicht
    // portiert — die Datei wird gesondert gezaehlt, nicht als Abweichung.
    if a == ast.E_RUF {
        (*s).ct_noetig = true
    }
    *gut = false
    return 0
}

// ------------------------------------------------------------- Ausdruecke
//
// `hinweis` ist der Kontexttyp oder KEIN. Rueckgabe ist immer ein konkreter
// Typ; im Fehlerfall der Fehlertyp.

fn ausdruck(s: *mut Sema, e: u32, hinweis: u32) -> u32 {
    let t: u32 = ausdruck_inner(s, e, hinweis)
    merke(s, e, t)
    return t
}

// Gibt allen Teilausdruecken einen konkreten Typ, ohne inhaltlich zu pruefen.
fn austypen(s: *mut Sema, e: u32) {
    ausdruck(s, e, (*s).t_i64)
}

fn feld_typ(s: *mut Sema, bt: u32, name: u32) -> u32 {
    // HOOK gc: Feldzugriff durch `Gc[T]` hindurch (gc.rs::hook_field_base).
    // Ein Gc-Zeiger wird gefolgt, ohne `(*p).feld` — er ist erstklassig.
    if hat_gc(s) {
        let si: u32 = gc.gc_feld_basis(gcp(s), tafel(s), bt)
        if si != KEIN {
            let st: u32 = typen.neuer_typ(tafel(s), typen.K_STRUCT, si, 0)
            return feld_typ(s, st, name)
        }
    }
    if typen.ty_art(tafel(s), bt) == typen.K_STRUCT {
        let ft: u32 = typen.st_feld_typ(tafel(s), typen.ty_a(tafel(s), bt) as usize, name)
        if ft == KEIN {
            meckern(s)
            return (*s).t_fehler
        }
        return ft
    }
    if ist_fehler(s, bt) {
        return (*s).t_fehler
    }
    meckern(s)
    return (*s).t_fehler
}

fn index_typ(s: *mut Sema, bt: u32, idx: u32) -> u32 {
    let it: u32 = ausdruck(s, idx, (*s).t_usize)
    if !ist_fehler(s, it) && !typen.typ_gleich(tafel(s), it, (*s).t_usize) {
        meckern(s)
    }
    if typen.ty_art(tafel(s), bt) == typen.K_ARR {
        return typen.ty_a(tafel(s), bt)
    }
    if ist_fehler(s, bt) {
        return (*s).t_fehler
    }
    meckern(s)
    return (*s).t_fehler
}

// Zuweisbarer Ausdruck: liefert den Typ oder KEIN.
fn lwert(s: *mut Sema, e: u32) -> u32 {
    let b: *mut ast.Baum = baum(s)
    let a: u32 = ast.e_art(b, e)
    if a == ast.E_ID {
        let v: u32 = var_suchen(s, ast.e_a(b, e))
        if v != KEIN {
            merke(s, e, v)
            return v
        }
        let k: u32 = konst_suchen(s, ast.e_a(b, e))
        if k != KEIN {
            merke(s, e, k)
            return k
        }
        meckern(s)
        merke(s, e, (*s).t_fehler)
        return (*s).t_fehler
    }
    if a == ast.E_FELD {
        let bt: u32 = lwert(s, ast.e_a(b, e))
        if bt == KEIN {
            return KEIN
        }
        let t: u32 = feld_typ(s, bt, ast.e_b(b, e))
        merke(s, e, t)
        return t
    }
    if a == ast.E_IDX {
        let bt: u32 = lwert(s, ast.e_a(b, e))
        if bt == KEIN {
            return KEIN
        }
        let t: u32 = index_typ(s, bt, ast.e_b(b, e))
        merke(s, e, t)
        return t
    }
    if a == ast.E_UN && ast.e_a(b, e) == 3 {
        let t0: u32 = ausdruck(s, ast.e_b(b, e), KEIN)
        var t: u32 = (*s).t_fehler
        if typen.ty_art(tafel(s), t0) == typen.K_PTR {
            t = typen.ty_a(tafel(s), t0)
        } else if !ist_fehler(s, t0) {
            meckern(s)
        }
        merke(s, e, t)
        return t
    }
    austypen(s, e)
    meckern(s)
    return KEIN
}

fn unaer(s: *mut Sema, e: u32, hinweis: u32) -> u32 {
    let b: *mut ast.Baum = baum(s)
    let op: u32 = ast.e_a(b, e)
    let inner: u32 = ast.e_b(b, e)
    if op == 0 {
        var h: u32 = probe(s, inner)
        if h == KEIN {
            if hinweis != KEIN && ist_int(s, hinweis) {
                h = hinweis
            }
        }
        let t: u32 = ausdruck(s, inner, h)
        if ist_fehler(s, t) {
            return (*s).t_fehler
        }
        if !ist_int(s, t) {
            meckern(s)
            return (*s).t_fehler
        }
        return t
    }
    if op == 1 {
        let t: u32 = ausdruck(s, inner, (*s).t_bool)
        if ist_fehler(s, t) {
            return (*s).t_fehler
        }
        if !ist_bool(s, t) {
            meckern(s)
            return (*s).t_fehler
        }
        return (*s).t_bool
    }
    if op == 2 {
        let t: u32 = lwert(s, inner)
        if t == KEIN || ist_fehler(s, t) {
            return (*s).t_fehler
        }
        return typen.neuer_typ(tafel(s), typen.K_PTR, t, 1)
    }
    let t: u32 = ausdruck(s, inner, KEIN)
    if typen.ty_art(tafel(s), t) == typen.K_PTR {
        return typen.ty_a(tafel(s), t)
    }
    if ist_fehler(s, t) {
        return (*s).t_fehler
    }
    meckern(s)
    return (*s).t_fehler
}

fn binaer(s: *mut Sema, e: u32, hinweis: u32) -> u32 {
    let b: *mut ast.Baum = baum(s)
    let op: u32 = ast.e_a(b, e)
    let l: u32 = ast.e_b(b, e)
    let r: u32 = ast.e_c(b, e)

    // logische Verknuepfung
    if op == 16 || op == 17 {
        let lt: u32 = ausdruck(s, l, (*s).t_bool)
        let rt: u32 = ausdruck(s, r, (*s).t_bool)
        if !ist_fehler(s, lt) && !ist_bool(s, lt) {
            meckern(s)
        }
        if !ist_fehler(s, rt) && !ist_bool(s, rt) {
            meckern(s)
        }
        return (*s).t_bool
    }

    // Vergleich
    if op >= 10 && op <= 15 {
        // HOOK fehlerunionen: `e == E::NotFound` vergleicht zwei Fehlerwerte
        // derselben Menge (errors.rs::hook_binary).
        if hat_fe(s) && (op == 10 || op == 11) {
            if fehler_ruhig_set(s, l) != KEIN || fehler_ruhig_set(s, r) != KEIN {
                let lt2: u32 = ausdruck(s, l, KEIN)
                let rt2: u32 = ausdruck(s, r, KEIN)
                let ls: u32 = fehler.fehler_set_von_typ(fe(s), tafel(s), lt2)
                let rs: u32 = fehler.fehler_set_von_typ(fe(s), tafel(s), rt2)
                if ls != KEIN && rs != KEIN && ls == rs {
                    return (*s).t_bool
                }
                if !ist_fehler(s, lt2) && !ist_fehler(s, rt2) {
                    meckern(s)
                }
                return (*s).t_bool
            }
        }
        var want: u32 = probe(s, l)
        if want == KEIN {
            want = probe(s, r)
        }
        let lt: u32 = ausdruck(s, l, want)
        let rt: u32 = ausdruck(s, r, want)
        if ist_fehler(s, lt) || ist_fehler(s, rt) {
            return (*s).t_bool
        }
        // HOOK gc: Identitaetsvergleich zweier verwandter Gc-Zeiger (gc.rs).
        var gleiche: bool = typen.vertraeglich(tafel(s), lt, rt)
        if !gleiche && hat_gc(s) {
            gleiche = gc.gc_ist_verwandt((*s).gc, tafel(s), lt, rt)
        }
        if !gleiche {
            meckern(s)
            return (*s).t_bool
        }
        let nur_gleich: bool = op == 10 || op == 11
        var ok: bool = ist_int(s, lt) || ist_f64(s, lt)
        if !ok && nur_gleich {
            ok = ist_bool(s, lt) || typen.ist_zeiger(tafel(s), lt)
        }
        if !ok {
            meckern(s)
        }
        return (*s).t_bool
    }

    // Verschiebung: der linke Operand bestimmt den Typ
    if op == 8 || op == 9 {
        var h: u32 = probe(s, l)
        if h == KEIN {
            if hinweis != KEIN && ist_int(s, hinweis) {
                h = hinweis
            }
        }
        let lt: u32 = ausdruck(s, l, h)
        var rh: u32 = probe(s, r)
        if rh == KEIN {
            if ist_int(s, lt) {
                rh = lt
            } else {
                rh = (*s).t_i64
            }
        }
        let rt: u32 = ausdruck(s, r, rh)
        if ist_fehler(s, lt) {
            return (*s).t_fehler
        }
        if ist_fehler(s, rt) {
            return lt
        }
        if !ist_int(s, lt) || !ist_int(s, rt) {
            meckern(s)
            return (*s).t_fehler
        }
        return lt
    }

    // Arithmetik und Bitoperationen: der bereits typisierte Operand hat
    // VORRANG vor dem Kontexthinweis.
    var want: u32 = probe(s, l)
    if want == KEIN {
        want = probe(s, r)
    }
    if want == KEIN {
        if hinweis != KEIN && ist_int(s, hinweis) {
            want = hinweis
        }
    }
    let lt: u32 = ausdruck(s, l, want)
    let rt: u32 = ausdruck(s, r, want)
    if ist_fehler(s, lt) || ist_fehler(s, rt) {
        return (*s).t_fehler
    }
    if ist_f64(s, lt) || ist_f64(s, rt) {
        // `%` und die Bitoperationen sind fuer f64 nicht definiert.
        let erlaubt: bool = op <= 3
        if !erlaubt {
            meckern(s)
            return (*s).t_fehler
        }
        if !typen.typ_gleich(tafel(s), lt, rt) {
            meckern(s)
            return (*s).t_fehler
        }
        return (*s).t_f64
    }
    if !ist_int(s, lt) || !ist_int(s, rt) || !typen.typ_gleich(tafel(s), lt, rt) {
        meckern(s)
        return (*s).t_fehler
    }
    return lt
}

// ------------------------------------------------- gc (gc.rs)
//
// `gc C{...}` liefert `AllocError!Gc[C]` (check_neu in Stufe 0). Der
// Aufrufname traegt die Klasse ("gc C"), das einzige Argument ist das
// Structliteral mit den Anfangswerten.

fn gc_neu_pruefen(s: *mut Sema, e: u32) -> u32 {
    let b: *mut ast.Baum = baum(s)
    let name: u32 = ast.e_a(b, e)
    var slit: u32 = KEIN
    if ast.e_c(b, e) == 1 {
        let a0: u32 = ast.kind_at(b, ast.e_b(b, e))
        if ast.e_art(b, a0) == ast.E_SLIT {
            slit = a0
        }
    }
    let ki_i: i64 = gc.gc_klasse_aus_neu(gcp(s), namen(s), name)
    if ki_i < 0 {
        // unbekannte gc-klasse
        if slit != KEIN {
            var k: u32 = 0
            while k < ast.e_c(b, slit) {
                austypen(s, ast.kind_at(b, ast.e_b(b, slit) + k * 2 + 1))
                k = k + 1
            }
        }
        meckern(s)
        return (*s).t_fehler
    }
    let ki: u32 = ki_i as u32
    let sidx: u32 = gc.gc_sidx(gcp(s), ki)
    if slit != KEIN {
        let off: u32 = ast.e_b(b, slit)
        let anz: u32 = ast.e_c(b, slit)
        var k: u32 = 0
        while k < anz {
            let fname: u32 = ast.kind_at(b, off + k * 2)
            let fexpr: u32 = ast.kind_at(b, off + k * 2 + 1)
            // doppelt angegeben?
            var j: u32 = 0
            while j < k {
                if ast.kind_at(b, off + j * 2) == fname {
                    meckern(s)
                }
                j = j + 1
            }
            let want: u32 = typen.st_feld_typ(tafel(s), sidx as usize, fname)
            if want == KEIN {
                austypen(s, fexpr)
                meckern(s)
            } else {
                let got: u32 = ausdruck(s, fexpr, want)
                if !ist_fehler(s, got) && !typen.vertraeglich(tafel(s), got, want) {
                    meckern(s)
                }
            }
            k = k + 1
        }
        // Bei einer gc-Allokation muessen ALLE Felder angegeben werden.
        if anz != typen.st_flen(tafel(s), sidx as usize) {
            meckern(s)
        }
    }
    // Die fehlbare Allokation: AllocError!Gc[C] (DESIGNZIELE §2). Die Menge
    // kommt mit der automatisch eingezogenen Laufzeit (lib/gc/gc.fi).
    if !hat_fe(s) {
        meckern(s)
        return (*s).t_fehler
    }
    var ae: [u8; 10] = "AllocError"
    let aen: u32 = intern.intern_nummer(namen(s), (&ae[0]) as u64, 10) as u32
    let sm: u32 = fehler.fehler_menge_finden(fe(s), aen)
    if sm == KEIN {
        meckern(s)
        return (*s).t_fehler
    }
    let st: u32 = typen.neuer_typ(tafel(s), typen.K_STRUCT, sidx, 0)
    let val: u32 = typen.neuer_typ(tafel(s), typen.K_PTR, st, 1)
    let ut: u32 = fehler.fehler_union_bauen(fe(s), tafel(s), namen(s), sm, val)
    let ui: u32 = fehler.fehler_union_von_typ(fe(s), tafel(s), ut)
    if ui != KEIN {
        gc.gc_union_setzen(gcp(s), ki, ui)
    }
    // Der Literal-Knoten selbst traegt den Union-Typ (Stufe 0: `record`).
    if slit != KEIN {
        merke(s, slit, ut)
    }
    return ut
}

// `x.as?[C]` — die gepruefte Abwaertsumwandlung (check_as in Stufe 0).
fn gc_as_pruefen(s: *mut Sema, e: u32) -> u32 {
    let b: *mut ast.Baum = baum(s)
    let name: u32 = ast.e_a(b, e)
    let zi: i64 = gc.gc_klasse_aus_as(gcp(s), namen(s), name)
    if zi < 0 {
        var k: u32 = 0
        while k < ast.e_c(b, e) {
            austypen(s, ast.kind_at(b, ast.e_b(b, e) + k))
            k = k + 1
        }
        meckern(s)
        return (*s).t_fehler
    }
    let ziel: u32 = zi as u32
    if ast.e_c(b, e) == 0 {
        meckern(s)
        return (*s).t_fehler
    }
    let arg: u32 = ast.kind_at(b, ast.e_b(b, e))
    let at: u32 = ausdruck(s, arg, KEIN)
    if ist_fehler(s, at) {
        return (*s).t_fehler
    }
    var quelle: u32 = KEIN
    if typen.ty_art(tafel(s), at) == typen.K_PTR {
        let inner: u32 = typen.ty_a(tafel(s), at)
        if typen.ty_art(tafel(s), inner) == typen.K_STRUCT {
            quelle = gc.gc_klasse_von_struct(gcp(s), typen.ty_a(tafel(s), inner))
        }
    }
    if quelle == KEIN {
        // '.as?[C]' erwartet einen Gc[T]
        meckern(s)
        return (*s).t_fehler
    }
    if quelle != ziel && !gc.gc_ist_nachfahre(gcp(s), ziel, quelle) && !gc.gc_ist_nachfahre(gcp(s), quelle, ziel) {
        // die beiden Klassen sind nicht verwandt
        meckern(s)
        return (*s).t_fehler
    }
    let st: u32 = typen.neuer_typ(tafel(s), typen.K_STRUCT, gc.gc_sidx(gcp(s), ziel), 0)
    return typen.neuer_typ(tafel(s), typen.K_PTR, st, 1)
}

// `weak(g)` und `stark(w)` (der Rest von hook_call in Stufe 0).
fn gc_schwach_pruefen(s: *mut Sema, e: u32, ist_weak: bool) -> u32 {
    let b: *mut ast.Baum = baum(s)
    if ast.e_c(b, e) != 1 {
        var k: u32 = 0
        while k < ast.e_c(b, e) {
            austypen(s, ast.kind_at(b, ast.e_b(b, e) + k))
            k = k + 1
        }
        meckern(s)
        return (*s).t_fehler
    }
    let arg: u32 = ast.kind_at(b, ast.e_b(b, e))
    let at: u32 = ausdruck(s, arg, KEIN)
    if ist_fehler(s, at) {
        return (*s).t_fehler
    }
    if ist_weak {
        var ki: u32 = KEIN
        if typen.ty_art(tafel(s), at) == typen.K_PTR {
            let inner: u32 = typen.ty_a(tafel(s), at)
            if typen.ty_art(tafel(s), inner) == typen.K_STRUCT {
                ki = gc.gc_klasse_von_struct(gcp(s), typen.ty_a(tafel(s), inner))
            }
        }
        if ki == KEIN {
            // 'weak' erwartet einen Gc[T]
            meckern(s)
            return (*s).t_fehler
        }
        return typen.neuer_typ(tafel(s), typen.K_STRUCT, gc.gc_widx(gcp(s), ki), 0)
    }
    var ki: u32 = KEIN
    if typen.ty_art(tafel(s), at) == typen.K_STRUCT {
        ki = gc.gc_klasse_von_weak(gcp(s), typen.ty_a(tafel(s), at))
    }
    if ki == KEIN {
        // 'stark' erwartet einen GcWeak[T]
        meckern(s)
        return (*s).t_fehler
    }
    let st: u32 = typen.neuer_typ(tafel(s), typen.K_STRUCT, gc.gc_sidx(gcp(s), ki), 0)
    return typen.neuer_typ(tafel(s), typen.K_PTR, st, 1)
}

fn ruf(s: *mut Sema, e: u32) -> u32 {
    let b: *mut ast.Baum = baum(s)
    // `size_of[T]()` — kein gewoehnlicher Aufruf, sondern eine Groesse zur
    // Uebersetzungszeit (sizeof.rs). Der Parser hat den Typknoten nach
    // `e_zahl` gelegt (Knoten + 1); aufgeloest wird er erst hier, weil erst
    // hier die Structtafel steht.
    if ast.e_zahl(b, e) != 0 {
        let st: u32 = ast_typ(s, (ast.e_zahl(b, e) - 1) as u32)
        if ist_fehler(s, st) {
            meckern(s)
            return (*s).t_fehler
        }
        if typen.ty_art(tafel(s), st) == typen.K_VOID {
            meckern(s)
            return (*s).t_fehler
        }
        return (*s).t_usize
    }
    let name: u32 = ast.e_a(b, e)
    let off: u32 = ast.e_b(b, e)
    let anz: u32 = ast.e_c(b, e)
    // HOOK fehlerunionen (errors.rs::hook_call): `__try#`, `__catch#` und
    // `Fehlermenge::Variante`. Steht VOR dem enum/match-Hook, weil es in
    // Stufe 0 auch zuerst drankommt; eine Menge und eine Aufzaehlung
    // desselben Namens gibt es nicht (die Anmeldung meldet den Konflikt).
    if hat_fe(s) {
        if fehler.fehler_ist_tryname(namen(s), name) {
            return try_pruefen(s, e)
        }
        if fehler.fehler_ist_catchname(namen(s), name) {
            return catch_pruefen(s, e)
        }
        var en: u32 = KEIN
        var vn: u32 = KEIN
        fehler.fehler_name_teilen((*s).feh, namen(s), name, &en, &vn)
        if en != KEIN {
            if fehler.fehler_menge_finden(fe(s), en) != KEIN {
                return fehler_ctor_pruefen(s, en, e)
            }
        }
    }
    // HOOK enum/match (sema_match.rs): `__match#N` ist der Musterabgleich,
    // `Enum::Variante(..)` der Konstruktor. Beides steht nicht in der
    // Funktionsliste.
    if hat_mu(s) {
        if muster.mus_ist_matchname(namen(s), name) {
            match_pruefen(s, muster.mus_match_nummer(namen(s), name))
            return (*s).t_void
        }
        if muster.mus_ist_ctorname(namen(s), name) {
            return ctor_pruefen(s, name, e)
        }
    }
    // HOOK gc (gc.rs::hook_call): `gc C{...}`, die beiden Intrinsics,
    // `x.as?[C]`, `weak(g)` und `stark(w)`. Steht vor der Funktionssuche —
    // ausser `weak`/`stark`: eine gleichnamige EIGENE Funktion gewinnt
    // (in Stufe 0: `ck.fns.contains_key(name)`).
    if hat_gc(s) {
        if gc.gc_hat_neu_praefix(namen(s), name) {
            return gc_neu_pruefen(s, e)
        }
        if gc.gc_zustandsname(namen(s), name) != 0 {
            var k: u32 = 0
            while k < anz {
                austypen(s, ast.kind_at(b, off + k))
                k = k + 1
            }
            let u8t: u32 = typen.neuer_typ(tafel(s), typen.K_U8, 0, 0)
            return typen.neuer_typ(tafel(s), typen.K_PTR, u8t, 1)
        }
        if gc.gc_hat_as_praefix(namen(s), name) {
            return gc_as_pruefen(s, e)
        }
        if (gc.gc_ist_weak_name(namen(s), name) || gc.gc_ist_stark_name(namen(s), name)) && fn_suchen(s, name) == KEIN {
            return gc_schwach_pruefen(s, e, gc.gc_ist_weak_name(namen(s), name))
        }
        // `barrier(x)` (ct.rs): die undurchsichtige Sperre — Verhalten ist
        // die Identitaet, geprueft wird nur die Skalaritaet. Eine eigene
        // Funktion namens `barrier` gewinnt (ct.rs::hook_call).
        var bw: [u8; 7] = "barrier"
        if intern.intern_gleich(namen(s), name, (&bw[0]) as u64, 7) && fn_suchen(s, name) == KEIN {
            if anz != 1 {
                meckern(s)
                return (*s).t_fehler
            }
            let at: u32 = ausdruck(s, ast.kind_at(b, off), KEIN)
            if ist_fehler(s, at) {
                return (*s).t_fehler
            }
            if !ist_int(s, at) && !ist_bool(s, at) && !typen.ist_zeiger(tafel(s), at) {
                meckern(s)
                return (*s).t_fehler
            }
            return at
        }
    }
    let f: u32 = fn_suchen(s, name)
    if f == KEIN {
        var k: u32 = 0
        while k < anz {
            austypen(s, ast.kind_at(b, off + k))
            k = k + 1
        }
        meckern(s)
        return (*s).t_fehler
    }
    let plen: u32 = ast.fn_plen(b, f as usize)
    if anz != plen {
        meckern(s)
    }
    var k: u32 = 0
    while k < anz {
        let arg: u32 = ast.kind_at(b, off + k)
        if k < plen {
            let pt: u32 = typen.param_typ_aufgeloest(tafel(s), f as usize, k)
            // HOOK fehlerunionen: implizite Umwandlung eines Arguments
            // (errors.rs::hook_coerce in `call`).
            if hat_fe(s) && coerce_pruefen(s, arg, pt) {
                k = k + 1
                continue
            }
            let t: u32 = ausdruck(s, arg, pt)
            if !typen.vertraeglich(tafel(s), t, pt) {
                meckern(s)
            }
        } else {
            austypen(s, arg)
        }
        k = k + 1
    }
    return typen.ret_typ_der_funktion(tafel(s), f as usize)
}

fn struct_literal(s: *mut Sema, e: u32) -> u32 {
    let b: *mut ast.Baum = baum(s)
    let name: u32 = ast.e_a(b, e)
    let off: u32 = ast.e_b(b, e)
    let anz: u32 = ast.e_c(b, e)
    let si: i32 = typen.struct_index(tafel(s), name)
    if si < 0 {
        var k: u32 = 0
        while k < anz {
            austypen(s, ast.kind_at(b, off + k * 2 + 1))
            k = k + 1
        }
        meckern(s)
        return (*s).t_fehler
    }
    var k: u32 = 0
    while k < anz {
        let fname: u32 = ast.kind_at(b, off + k * 2)
        let fexpr: u32 = ast.kind_at(b, off + k * 2 + 1)
        let ft: u32 = typen.st_feld_typ(tafel(s), si as usize, fname)
        if ft == KEIN {
            austypen(s, fexpr)
            meckern(s)
        } else {
            // HOOK fehlerunionen: implizite Umwandlung eines Feldwerts.
            var umgewandelt: bool = false
            if hat_fe(s) {
                umgewandelt = coerce_pruefen(s, fexpr, ft)
            }
            if !umgewandelt {
                let t: u32 = ausdruck(s, fexpr, ft)
                if !typen.vertraeglich(tafel(s), t, ft) {
                    meckern(s)
                }
            }
        }
        k = k + 1
    }
    if anz != typen.st_flen(tafel(s), si as usize) {
        meckern(s)
    }
    return typen.neuer_typ(tafel(s), typen.K_STRUCT, si as u32, 0)
}

fn ausdruck_inner(s: *mut Sema, e: u32, hinweis: u32) -> u32 {
    let b: *mut ast.Baum = baum(s)
    let a: u32 = ast.e_art(b, e)

    if a == ast.E_FLOAT {
        return (*s).t_f64
    }
    if a == ast.E_INT {
        // Ein Ganzzahlliteral hat KEINEN eigenen Typ — er kommt von aussen.
        if hinweis != KEIN {
            if ist_int(s, hinweis) {
                return hinweis
            }
            if ist_fehler(s, hinweis) {
                return (*s).t_fehler
            }
        }
        meckern(s)
        return (*s).t_fehler
    }
    if a == ast.E_BOOL {
        return (*s).t_bool
    }
    if a == ast.E_ID {
        let v: u32 = var_suchen(s, ast.e_a(b, e))
        if v != KEIN {
            return v
        }
        let k: u32 = konst_suchen(s, ast.e_a(b, e))
        if k != KEIN {
            return k
        }
        meckern(s)
        return (*s).t_fehler
    }
    if a == ast.E_UN {
        return unaer(s, e, hinweis)
    }
    if a == ast.E_BIN {
        return binaer(s, e, hinweis)
    }
    if a == ast.E_FELD {
        let bt: u32 = ausdruck(s, ast.e_a(b, e), KEIN)
        return feld_typ(s, bt, ast.e_b(b, e))
    }
    if a == ast.E_IDX {
        let bt: u32 = ausdruck(s, ast.e_a(b, e), KEIN)
        return index_typ(s, bt, ast.e_b(b, e))
    }
    if a == ast.E_RUF {
        return ruf(s, e)
    }
    if a == ast.E_SYSCALL {
        let off: u32 = ast.e_b(b, e)
        let anz: u32 = ast.e_c(b, e)
        if anz == 0 || anz > 7 {
            meckern(s)
        }
        var k: u32 = 0
        while k < anz {
            let t: u32 = ausdruck(s, ast.kind_at(b, off + k), (*s).t_i64)
            if !ist_fehler(s, t) && !ist_int(s, t) && !typen.ist_zeiger(tafel(s), t) {
                meckern(s)
            }
            k = k + 1
        }
        return (*s).t_i64
    }
    if a == ast.E_AS {
        let dst: u32 = ast_typ(s, ast.e_b(b, e))
        var ih: u32 = KEIN
        if ist_int(s, dst) {
            ih = dst
        } else if ist_bool(s, dst) {
            ih = (*s).t_i64
        } else if typen.ist_zeiger(tafel(s), dst) {
            ih = (*s).t_usize
        }
        let src: u32 = ausdruck(s, ast.e_a(b, e), ih)
        if ist_fehler(s, src) || ist_fehler(s, dst) {
            return dst
        }
        if !umwandelbar(s, src) || !umwandelbar(s, dst) {
            meckern(s)
            return (*s).t_fehler
        }
        return dst
    }
    if a == ast.E_SLIT {
        return struct_literal(s, e)
    }
    if a == ast.E_AWDH {
        let wert: u32 = ast.e_a(b, e)
        let anzahl: u32 = ast.e_b(b, e)
        let ct: u32 = ausdruck(s, anzahl, (*s).t_usize)
        var n: u64 = 0
        if ist_fehler(s, ct) || !ist_int(s, ct) {
            if !ist_fehler(s, ct) {
                meckern(s)
            }
        } else {
            var gut: bool = true
            let v: i64 = konst_auswerten(s, anzahl, &gut)
            if gut && v > 0 {
                n = v as u64
            } else {
                meckern(s)
            }
        }
        var eh: u32 = KEIN
        if hinweis != KEIN {
            if typen.ty_art(tafel(s), hinweis) == typen.K_ARR {
                eh = typen.ty_a(tafel(s), hinweis)
            }
        }
        let vt: u32 = ausdruck(s, wert, eh)
        if n == 0 || ist_fehler(s, vt) {
            return (*s).t_fehler
        }
        if hinweis != KEIN {
            if typen.ty_art(tafel(s), hinweis) == typen.K_ARR {
                if !typen.vertraeglich(tafel(s), vt, typen.ty_a(tafel(s), hinweis)) {
                    meckern(s)
                }
                if typen.ty_n(tafel(s), hinweis) != n {
                    meckern(s)
                }
            }
        }
        return typen.neuer_typ(tafel(s), typen.K_ARR, vt, n)
    }
    // Array-Literal
    let off: u32 = ast.e_b(b, e)
    let anz: u32 = ast.e_c(b, e)
    var ist_arr: bool = false
    if hinweis != KEIN {
        ist_arr = typen.ty_art(tafel(s), hinweis) == typen.K_ARR
    }
    if ist_arr {
        let et: u32 = typen.ty_a(tafel(s), hinweis)
        if anz as u64 != typen.ty_n(tafel(s), hinweis) {
            meckern(s)
        }
        var k: u32 = 0
        while k < anz {
            let t: u32 = ausdruck(s, ast.kind_at(b, off + k), et)
            if !typen.vertraeglich(tafel(s), t, et) {
                meckern(s)
            }
            k = k + 1
        }
        return typen.neuer_typ(tafel(s), typen.K_ARR, et, typen.ty_n(tafel(s), hinweis))
    }
    var k: u32 = 0
    while k < anz {
        austypen(s, ast.kind_at(b, off + k))
        k = k + 1
    }
    meckern(s)
    return (*s).t_fehler
}

// ------------------------------------------------- enum/match (sema_match.rs)
//
// Portierung der Typpruefung fuer Aufzaehlungen und Musterabgleich.
// Wie ueberall in dieser Datei: Fehler werden GEZAEHLT, nicht beschrieben.

// Subjekt-Arten des Musterabgleichs (Subject in sema_match.rs).
const SJ_BAD: u32 = 0
const SJ_ENUM: u32 = 1
const SJ_BOOL: u32 = 2
const SJ_INT: u32 = 3

// `Enum::Variante(args..)` pruefen. Liefert den Aufzaehlungstyp.
fn ctor_pruefen(s: *mut Sema, name: u32, e: u32) -> u32 {
    let b: *mut ast.Baum = baum(s)
    let off: u32 = ast.e_b(b, e)
    let anz: u32 = ast.e_c(b, e)
    // Den Namen an der ersten Doppelpunktsstelle teilen.
    let it: *mut intern.Interner = namen(s)
    let zp: u64 = intern.intern_zeiger(it, name)
    let zn: usize = intern.intern_laenge(it, name)
    var ename: u32 = KEIN
    var vname: u32 = KEIN
    var i: usize = 0
    while i + 1 < zn {
        if rt.ld8(zp, i) == 58 as u8 && rt.ld8(zp, i + 1) == 58 as u8 {
            ename = intern.intern_nummer(it, zp, i) as u32
            vname = intern.intern_nummer(it, zp + (i + 2) as u64, zn - i - 2) as u32
            break
        }
        i = i + 1
    }
    let ei: u32 = muster.mus_enum_finden(mu(s), ename)
    if ei == KEIN {
        // unbekannte aufzaehlung
        var k: u32 = 0
        while k < anz {
            austypen(s, ast.kind_at(b, off + k))
            k = k + 1
        }
        meckern(s)
        return (*s).t_fehler
    }
    let vi: u32 = muster.mus_variante_finden(mu(s), ei, vname)
    if vi == KEIN {
        // aufzaehlung hat diese variante nicht
        var k2: u32 = 0
        while k2 < anz {
            austypen(s, ast.kind_at(b, off + k2))
            k2 = k2 + 1
        }
        meckern(s)
        return (*s).t_fehler
    }
    let roff: u32 = muster.mus_v_roff(mu(s), vi)
    let flen: u32 = muster.mus_v_tlen(mu(s), vi)
    if anz != flen {
        meckern(s)
    }
    var k3: u32 = 0
    while k3 < anz {
        let arg: u32 = ast.kind_at(b, off + k3)
        if k3 < flen {
            let want: u32 = muster.mus_rf_typ(mu(s), roff + k3)
            let got: u32 = ausdruck(s, arg, want)
            if !typen.vertraeglich(tafel(s), got, want) {
                meckern(s)
            }
        } else {
            austypen(s, arg)
        }
        k3 = k3 + 1
    }
    return typen.neuer_typ(tafel(s), typen.K_STRUCT, muster.mus_e_sidx(mu(s), ei), 0)
}

// Passt der Musterwert in den Typ? (fits in sema_match.rs)
fn passt_in(s: *mut Sema, v: i64, t: u32) -> bool {
    let bits: u32 = typen.bits_von(tafel(s), t)
    if bits == 0 {
        return true
    }
    if typen.ist_vorzeichen(tafel(s), t) {
        if bits >= 64 {
            return true
        }
        let lo: i64 = 0 - (1 << (bits - 1) as i64)
        let hi: i64 = (1 << (bits - 1) as i64) - 1
        return v >= lo && v <= hi
    }
    if v < 0 {
        return false
    }
    if bits >= 64 {
        // GRENZE: `u64`-Marken jenseits von `i64::MAX` lassen sich hier nicht
        // niederschreiben (Stufe 0 rechnet mit i128) — siehe muster.fi.
        return true
    }
    return (v as u64) < (1 << bits as i64) as u64
}

// Prueft ein Muster gegen den erwarteten Typ und legt seine Bindungen an.
fn muster_pruefen(s: *mut Sema, pat: u32, ty: u32, sj_art: u32, sj_ei: u32,
                  top: bool) {
    let m: *mut muster.Mus = mu(s)
    let a: u32 = muster.mus_mu_art(m, pat)
    if a == muster.MU_WILD {
        return
    }
    if a == muster.MU_BIND {
        var_anlegen(s, muster.mus_mu_a(m, pat), ty)
        return
    }
    if a == muster.MU_BOOL {
        if !ist_bool(s, ty) && !ist_fehler(s, ty) {
            meckern(s)
        }
        return
    }
    if a == muster.MU_INT {
        if !ist_int(s, ty) && !ist_fehler(s, ty) {
            meckern(s)
            return
        }
        if !ist_fehler(s, ty) {
            if !passt_in(s, muster.mus_mu_lo(m, pat), ty) {
                meckern(s)
            }
        }
        return
    }
    if a == muster.MU_BEREICH {
        if !ist_int(s, ty) && !ist_fehler(s, ty) {
            meckern(s)
            return
        }
        if !ist_fehler(s, ty) {
            if !passt_in(s, muster.mus_mu_lo(m, pat), ty) {
                meckern(s)
                return
            }
            if !passt_in(s, muster.mus_mu_hi(m, pat), ty) {
                meckern(s)
            }
        }
        return
    }
    // MU_VARIANT
    let ename: u32 = muster.mus_mu_a(m, pat)
    var ei: u32 = KEIN
    if ename != ast.NICHTS {
        ei = muster.mus_enum_finden(m, ename)
        if ei == KEIN {
            meckern(s)
            return
        }
    } else {
        // Ohne Namen: die Aufzaehlung kommt aus dem erwarteten Typ.
        if typen.ty_art(tafel(s), ty) == typen.K_STRUCT {
            ei = muster.mus_enum_bei_struct(m, typen.ty_a(tafel(s), ty))
        }
        if ei == KEIN {
            return
        }
    }
    let want: u32 = typen.neuer_typ(tafel(s), typen.K_STRUCT, muster.mus_e_sidx(m, ei), 0)
    if !ist_fehler(s, ty) {
        if !typen.typ_gleich(tafel(s), ty, want) {
            meckern(s)
            return
        }
    }
    if top {
        if sj_art == SJ_ENUM && sj_ei != ei {
            meckern(s)
            return
        }
    }
    let vi: u32 = muster.mus_variante_finden(m, ei, muster.mus_mu_b(m, pat))
    if vi == KEIN {
        meckern(s)
        return
    }
    let soff: u32 = muster.mus_mu_soff(m, pat)
    let slen: u32 = muster.mus_mu_slen(m, pat)
    let roff: u32 = muster.mus_v_roff(m, vi)
    let flen: u32 = muster.mus_v_tlen(m, vi)
    if slen != flen {
        meckern(s)
    }
    var k: u32 = 0
    while k < slen {
        if k < flen {
            let ft: u32 = muster.mus_rf_typ(m, roff + k)
            muster_pruefen(s, muster.mus_mu_kind(m, soff + k), ft, sj_art, sj_ei, false)
        }
        k = k + 1
    }
}

// Das `match` mit der Nummer `mi` pruefen (check_match in sema_match.rs).
fn match_pruefen(s: *mut Sema, mi: u32) {
    let m: *mut muster.Mus = mu(s)
    if mi as usize >= muster.mus_match_anzahl(m) {
        meckern(s)
        return
    }
    let subj: u32 = muster.mus_m_subj(m, mi)
    let sty: u32 = ausdruck(s, subj, KEIN)
    // Das Subjekt klassifizieren: Aufzaehlung, bool, Ganzzahl — sonst Fehler.
    var sj_art: u32 = SJ_BAD
    var sj_ei: u32 = KEIN
    if ist_fehler(s, sty) {
        sj_art = SJ_BAD
    } else if typen.ty_art(tafel(s), sty) == typen.K_STRUCT {
        let ei: u32 = muster.mus_enum_bei_struct(m, typen.ty_a(tafel(s), sty))
        if ei == KEIN {
            // 'match' auf einem gewoehnlichen Struct: Fehler.
            meckern(s)
            sj_art = SJ_BAD
        } else {
            sj_art = SJ_ENUM
            sj_ei = ei
        }
    } else if ist_bool(s, sty) {
        sj_art = SJ_BOOL
    } else if ist_int(s, sty) {
        sj_art = SJ_INT
    } else {
        meckern(s)
        sj_art = SJ_BAD
    }
    // Der erwartete Typ der Muster.
    var mty: u32 = sty
    if sj_art == SJ_ENUM {
        mty = typen.neuer_typ(tafel(s), typen.K_STRUCT, muster.mus_e_sidx(m, sj_ei), 0)
    } else if sj_art == SJ_BOOL {
        mty = (*s).t_bool
    }
    // 1. Je Fall: eigener Bereich, Muster pruefen, Rumpf pruefen.
    let aoff: u32 = muster.mus_m_aoff(m, mi)
    let alen: u32 = muster.mus_m_alen(m, mi)
    var ai: u32 = 0
    while ai < alen {
        bereich_auf(s)
        muster_pruefen(s, muster.mus_a_pat(m, aoff + ai), mty, sj_art, sj_ei, true)
        block(s, muster.mus_a_block(m, aoff + ai), true)
        bereich_zu(s)
        ai = ai + 1
    }
    // 2. Unerreichbarkeit: nach einem immer zutreffenden Fall kommt nichts.
    var auffang: bool = false
    ai = 0
    while ai < alen {
        if auffang {
            meckern(s)
            break
        }
        if muster.mus_unanfechtbar(m, muster.mus_a_pat(m, aoff + ai)) {
            auffang = true
        }
        ai = ai + 1
    }
    // 3. VOLLSTAENDIGKEIT — ein fehlender Fall ist ein FEHLER (SPEC §6.3).
    if sj_art == SJ_BAD {
        return
    }
    if auffang {
        return
    }
    if sj_art == SJ_INT {
        // Ohne Auffangfall ist ein Ganzzahl-match nie vollstaendig.
        meckern(s)
        return
    }
    if sj_art == SJ_BOOL {
        var hat_w: bool = false
        var hat_f: bool = false
        ai = 0
        while ai < alen {
            let pat: u32 = muster.mus_a_pat(m, aoff + ai)
            if muster.mus_mu_art(m, pat) == muster.MU_BOOL {
                if muster.mus_mu_a(m, pat) == 1 {
                    hat_w = true
                } else {
                    hat_f = true
                }
            }
            ai = ai + 1
        }
        if !hat_w || !hat_f {
            meckern(s)
        }
        return
    }
    // SJ_ENUM: jede Variante muss einen Fall haben, dessen Untermuster alle
    // unanfechtbar sind.
    let voff: u32 = muster.mus_e_voff(m, sj_ei)
    let vlen: u32 = muster.mus_e_vlen(m, sj_ei)
    var v: u32 = 0
    while v < vlen {
        let vname: u32 = muster.mus_v_name(m, voff + v)
        var abgedeckt: bool = false
        ai = 0
        while ai < alen {
            let pat: u32 = muster.mus_a_pat(m, aoff + ai)
            if muster.mus_mu_art(m, pat) == muster.MU_VARIANT {
                if muster.mus_mu_b(m, pat) == vname {
                    var alle_un: bool = true
                    let soff: u32 = muster.mus_mu_soff(m, pat)
                    let slen: u32 = muster.mus_mu_slen(m, pat)
                    var k: u32 = 0
                    while k < slen {
                        if !muster.mus_unanfechtbar(m, muster.mus_mu_kind(m, soff + k)) {
                            alle_un = false
                        }
                        k = k + 1
                    }
                    if alle_un {
                        abgedeckt = true
                    }
                }
            }
            ai = ai + 1
        }
        if !abgedeckt {
            meckern(s)
        }
        v = v + 1
    }
}

// ------------------------------------------------------------- Anweisungen

// -------------------------------------- fehlerunionen (errors.rs)
//
// Portierung der Typpruefung fuer `try`, `catch`, `Menge::Variante` und die
// implizite Umwandlung. Wie ueberall in dieser Datei: Fehler werden
// GEZAEHLT, nicht beschrieben.

// `try a` (check_try in errors.rs). Liefert den Erfolgstyp der Union.
fn try_pruefen(s: *mut Sema, e: u32) -> u32 {
    let b: *mut ast.Baum = baum(s)
    let arg: u32 = ast.kind_at(b, ast.e_b(b, e))
    let got: u32 = ausdruck(s, arg, KEIN)
    let u: u32 = fehler.fehler_union_von_typ(fe(s), tafel(s), got)
    if u == KEIN {
        // 'try' erwartet einen wert einer fehlerunion
        if !ist_fehler(s, got) {
            meckern(s)
        }
        return (*s).t_fehler
    }
    let val: u32 = fehler.fehler_u_valty(fe(s), u)
    let ru: u32 = fehler.fehler_union_von_typ(fe(s), tafel(s), (*s).ret)
    if ru == KEIN {
        // 'try' ausserhalb einer funktion mit fehlerunions-rueckgabetyp
        meckern(s)
        return val
    }
    if fehler.fehler_u_set(fe(s), ru) != fehler.fehler_u_set(fe(s), u) {
        // beide fehlermengen muessen dieselbe sein
        meckern(s)
        return val
    }
    fehler.fehler_try_setzen(fe(s), e, u)
    return val
}

// `a catch b` (check_catch in errors.rs). Liefert den Erfolgstyp der Union.
fn catch_pruefen(s: *mut Sema, e: u32) -> u32 {
    let b: *mut ast.Baum = baum(s)
    let off: u32 = ast.e_b(b, e)
    let lhs: u32 = ast.kind_at(b, off)
    let rhs: u32 = ast.kind_at(b, off + 1)
    let got: u32 = ausdruck(s, lhs, KEIN)
    let u: u32 = fehler.fehler_union_von_typ(fe(s), tafel(s), got)
    if u == KEIN {
        // 'catch' erwartet links einen wert einer fehlerunion
        if !ist_fehler(s, got) {
            meckern(s)
        }
        austypen(s, rhs)
        return (*s).t_fehler
    }
    let want: u32 = fehler.fehler_u_valty(fe(s), u)
    // `catch |f| ersatz`: der Fehlerwert ist im Ersatz sichtbar — mit dem
    // Typ der MENGE (dem reinen Fehlerwert).
    let bind: u32 = fehler.fehler_cb(fe(s), e)
    if bind != KEIN {
        bereich_auf(s)
        let st: u32 = fehler.fehler_set_typ(fe(s), tafel(s),
                                            fehler.fehler_u_set(fe(s), u))
        var_anlegen(s, bind, st)
    }
    let rt: u32 = ausdruck(s, rhs, want)
    if bind != KEIN {
        bereich_zu(s)
    }
    if !ist_fehler(s, rt) && !typen.vertraeglich(tafel(s), rt, want) {
        meckern(s)
    }
    fehler.fehler_catch_setzen(fe(s), e, u)
    return want
}

// `Menge::Variante` — der reine Fehlerwert (der Konstruktor-Ast von
// errors.rs::hook_call). Die Menge existiert; das hat der Aufrufer geprueft.
fn fehler_ctor_pruefen(s: *mut Sema, en: u32, e: u32) -> u32 {
    let b: *mut ast.Baum = baum(s)
    let off: u32 = ast.e_b(b, e)
    let anz: u32 = ast.e_c(b, e)
    var k: u32 = 0
    while k < anz {
        austypen(s, ast.kind_at(b, off + k))
        k = k + 1
    }
    if anz > 0 {
        // die fehlervariante traegt keine nutzdaten
        meckern(s)
    }
    if fehler.fehler_ctor_code((*s).feh, namen(s), ast.e_a(b, e)) < 0 {
        // unbekannte variante
        meckern(s)
        return (*s).t_fehler
    }
    return fehler.fehler_set_typ(fe(s), tafel(s),
                                 fehler.fehler_menge_finden(fe(s), en))
}

// Implizite Umwandlung in eine Fehlerunion an `return`/`let`/Zuweisung/
// Argument/Feld (hook_coerce in errors.rs). Liefert false, wenn `want`
// keine Fehlerunion ist — dann laeuft die gewoehnliche Pruefung.
fn coerce_pruefen(s: *mut Sema, e: u32, want: u32) -> bool {
    let u: u32 = fehler.fehler_union_von_typ(fe(s), tafel(s), want)
    if u == KEIN {
        return false
    }
    let uv: u32 = fehler.fehler_u_valty(fe(s), u)
    let got: u32 = ausdruck(s, e, uv)
    if ist_fehler(s, got) {
        return true
    }
    if typen.typ_gleich(tafel(s), got, want) {
        // schon eine Fehlerunion — nichts umzuwandeln
        return true
    }
    let sm: u32 = fehler.fehler_set_von_typ(fe(s), tafel(s), got)
    if sm != KEIN {
        if sm == fehler.fehler_u_set(fe(s), u) {
            fehler.fehler_coerce_setzen(fe(s), e, fehler.FEHLER_AUS_FEHLER, u)
            return true
        }
        // fehlerwert einer anderen menge
        meckern(s)
        return true
    }
    if typen.vertraeglich(tafel(s), got, uv) {
        fehler.fehler_coerce_setzen(fe(s), e, fehler.FEHLER_AUS_WERT, u)
        return true
    }
    meckern(s)
    return true
}

// Ist der Ausdruck ERKENNBAR ein Fehlerwert (`quiet_set` in errors.rs):
// eine Variante `E::V` oder eine Variable vom Typ einer Fehlermenge.
fn fehler_ruhig_set(s: *mut Sema, e: u32) -> u32 {
    let b: *mut ast.Baum = baum(s)
    let a: u32 = ast.e_art(b, e)
    if a == ast.E_RUF {
        var en: u32 = KEIN
        var vn: u32 = KEIN
        fehler.fehler_name_teilen((*s).feh, namen(s), ast.e_a(b, e), &en, &vn)
        if en != KEIN {
            return fehler.fehler_menge_finden(fe(s), en)
        }
        return KEIN
    }
    if a == ast.E_ID {
        let v: u32 = var_suchen(s, ast.e_a(b, e))
        if v != KEIN {
            return fehler.fehler_set_von_typ(fe(s), tafel(s), v)
        }
    }
    return KEIN
}

fn bedingung(s: *mut Sema, e: u32) {
    let t: u32 = ausdruck(s, e, (*s).t_bool)
    if !ist_fehler(s, t) && !ist_bool(s, t) {
        meckern(s)
    }
}

fn anweisung(s: *mut Sema, i: u32) {
    let b: *mut ast.Baum = baum(s)
    let a: u32 = ast.s_art(b, i)

    if a == ast.S_LET || a == ast.S_VAR {
        let te: u32 = ast.s_b(b, i)
        var t: u32 = 0
        if te != ast.NICHTS {
            let d: u32 = ast_typ(s, te)
            // HOOK fehlerunionen: implizite Umwandlung bei 'let'.
            var umgewandelt: bool = false
            if hat_fe(s) {
                umgewandelt = coerce_pruefen(s, ast.s_c(b, i), d)
            }
            if !umgewandelt {
                let got: u32 = ausdruck(s, ast.s_c(b, i), d)
                if !typen.vertraeglich(tafel(s), got, d) {
                    meckern(s)
                }
            }
            t = d
        } else {
            let got: u32 = ausdruck(s, ast.s_c(b, i), KEIN)
            if typen.ty_art(tafel(s), got) == typen.K_VOID {
                meckern(s)
                t = (*s).t_fehler
            } else {
                t = got
            }
        }
        var_anlegen(s, ast.s_a(b, i), t)
        return
    }
    if a == ast.S_ZUW {
        let t: u32 = lwert(s, ast.s_a(b, i))
        if t == KEIN {
            ausdruck(s, ast.s_b(b, i), (*s).t_i64)
            return
        }
        // HOOK fehlerunionen: implizite Umwandlung bei der Zuweisung.
        if hat_fe(s) && coerce_pruefen(s, ast.s_b(b, i), t) {
            return
        }
        let got: u32 = ausdruck(s, ast.s_b(b, i), t)
        if !typen.vertraeglich(tafel(s), got, t) {
            meckern(s)
        }
        return
    }
    if a == ast.S_IF {
        bedingung(s, ast.s_a(b, i))
        block(s, ast.s_b(b, i), false)
        if ast.s_c(b, i) != ast.NICHTS {
            anweisung(s, ast.s_c(b, i))
        }
        return
    }
    if a == ast.S_WHILE {
        bedingung(s, ast.s_a(b, i))
        block(s, ast.s_b(b, i), false)
        return
    }
    if a == ast.S_FOR {
        var want: u32 = probe(s, ast.s_b(b, i))
        if want == KEIN {
            want = probe(s, ast.s_c(b, i))
        }
        let st: u32 = ausdruck(s, ast.s_b(b, i), want)
        var w2: u32 = want
        if w2 == KEIN {
            w2 = st
        }
        let et: u32 = ausdruck(s, ast.s_c(b, i), w2)
        var t: u32 = (*s).t_fehler
        if ist_fehler(s, st) || ist_fehler(s, et) {
            t = (*s).t_fehler
        } else if !ist_int(s, st) || !ist_int(s, et) || !typen.typ_gleich(tafel(s), st, et) {
            meckern(s)
            t = (*s).t_fehler
        } else {
            t = st
        }
        bereich_auf(s)
        var_anlegen(s, ast.s_a(b, i), t)
        block(s, ast.s_d(b, i), true)
        bereich_zu(s)
        return
    }
    if a == ast.S_RET {
        let w: u32 = (*s).ret
        if ast.s_a(b, i) == ast.NICHTS {
            if typen.ty_art(tafel(s), w) != typen.K_VOID && !ist_fehler(s, w) {
                meckern(s)
            }
            return
        }
        if typen.ty_art(tafel(s), w) == typen.K_VOID {
            ausdruck(s, ast.s_a(b, i), (*s).t_i64)
            meckern(s)
            return
        }
        // HOOK fehlerunionen: implizite Umwandlung bei 'return'
        // (errors.rs::hook_coerce in check_stmt).
        if hat_fe(s) && coerce_pruefen(s, ast.s_a(b, i), w) {
            return
        }
        let got: u32 = ausdruck(s, ast.s_a(b, i), w)
        if !typen.vertraeglich(tafel(s), got, w) {
            meckern(s)
        }
        return
    }
    if a == ast.S_DEFER || a == ast.S_ERRDEFER {
        anweisung(s, ast.s_a(b, i))
        return
    }
    if a == ast.S_EXPR {
        let e2: u32 = ast.s_a(b, i)
        let et: u32 = ausdruck(s, e2, KEIN)
        // HOOK fehlerunionen: ein `E!T`-Wert ist implizit #[must_consume] —
        // das Ergebnis eines Aufrufs darf nicht verworfen werden
        // (sema.rs::check_discard, SPEC §5.1).
        if hat_fe(s) && ast.e_art(b, e2) == ast.E_RUF {
            if fehler.fehler_union_von_typ(fe(s), tafel(s), et) != KEIN {
                meckern(s)
            }
        }
        return
    }
    if a == ast.S_BLOCK {
        block(s, ast.s_a(b, i), false)
        return
    }
    // break / continue: der Parser hat die Lage schon geprueft.
}

fn block(s: *mut Sema, bi: u32, bereich_schon_offen: bool) {
    let b: *mut ast.Baum = baum(s)
    if !bereich_schon_offen {
        bereich_auf(s)
    }
    var k: u32 = 0
    while k < ast.b_len(b, bi) {
        anweisung(s, ast.sliste_at(b, ast.b_off(b, bi) + k))
        k = k + 1
    }
    if !bereich_schon_offen {
        bereich_zu(s)
    }
}

// ------------------------------------------------------------------- Lauf

fn sema_lauf(s: *mut Sema) {
    let b: *mut ast.Baum = baum(s)
    // 0. Aufzaehlungen: NAMEN anmelden, damit Structs und Signaturen sie
    //    benennen koennen (vor dem Structlayout — genau wie `declare_enums`
    //    vor `collect_structs` in Stufe 0).
    if hat_mu(s) {
        muster.mus_anmelden(mu(s), tafel(s))
    }
    // 0b. Fehlermengen: NAMEN anmelden — nach den Aufzaehlungen, vor den
    //    Structs des Baums, genau wie `declare_error_sets` in Stufe 0. Die
    //    Typaufloesung bekommt das Register, damit sie `__eu#<n>`-Platzhalter
    //    aufloesen kann.
    var fe_bisher: usize = 0
    if hat_fe(s) {
        fehler.fehler_anmelden((*s).feh, tafel(s), namen(s))
        typen.typen_fehler_setzen(tafel(s), (*s).feh)
    }
    // 0c. gc-Klassen: als Structs anmelden — NACH den Fehlermengen, VOR den
    //    Structs des Baums, genau wie `declare_classes` in Stufe 0. Die
    //    Typaufloesung bekommt das Register, damit sie `__gc#p:`/`__gc#w:`-
    //    Platzhalter aufloesen kann (derselbe Uebergabepunkt wie `__eu#<n>`).
    var gc_bisher: usize = 0
    if hat_gc(s) {
        gc.gc_anmelden((*s).gc, tafel(s), namen(s))
        typen.typen_gc_setzen(tafel(s), (*s).gc)
    }
    // 1. Structlayout und Funktionssignaturen — dieselbe Rechnung wie in
    //    `typen.fi`, hier einmal fuer alles.
    typen.typen_aufloesen(tafel(s), b, namen(s))
    if hat_fe(s) {
        // Fehler aus der Registrierung mitzaehlen (doppelte Mengen,
        // unbekannte Mengen, Unionen als verbotener Feldtyp).
        let fj: usize = fehler.fehler_fehler(fe(s))
        while fe_bisher < fj {
            meckern(s)
            fe_bisher = fe_bisher + 1
        }
    }
    // 1b. Aufzaehlungen: LAYOUTS eintragen — nach dem Structlayout der
    //    Handstructschreibungen, vor jedem Gebrauch (`layout_enums` in
    //    Stufe 0). Fehler daraus zaehlen mit.
    if hat_mu(s) {
        let mf: u32 = muster.mus_layout(mu(s), tafel(s), b, namen(s))
        var mk: u32 = 0
        while mk < mf {
            meckern(s)
            mk = mk + 1
        }
    }
    // 1c. gc-Klassen: Feldlayout festlegen — erst hier sind die Structs des
    //    Programms bekannt (`layout_classes` in Stufe 0). Fehler daraus
    //    (unbekannte Basis, Ringe, verbotene Feldtypen) zaehlen mit.
    if hat_gc(s) {
        gc.gc_layout((*s).gc, tafel(s), b, namen(s))
        let gj: usize = gc.gc_fehler(gcp(s))
        while gc_bisher < gj {
            meckern(s)
            gc_bisher = gc_bisher + 1
        }
    }

    // 2. Grundtypen anlegen, damit sie nicht bei jedem Zugriff neu entstehen.
    (*s).t_bool = typen.neuer_typ(tafel(s), typen.K_BOOL, 0, 0)
    (*s).t_i64 = typen.neuer_typ(tafel(s), typen.K_I64, 0, 0)
    (*s).t_usize = typen.neuer_typ(tafel(s), typen.K_USIZE, 0, 0)
    (*s).t_void = typen.neuer_typ(tafel(s), typen.K_VOID, 0, 0)
    (*s).t_fehler = typen.neuer_typ(tafel(s), typen.K_FEHLER, 0, 0)
    (*s).t_f64 = typen.neuer_typ(tafel(s), typen.K_F64, 0, 0)

    // 3. Typtabelle fuer alle Ausdruecke anlegen.
    var i: usize = 0
    while i < ast.ausdruck_anzahl(b) {
        vec_push[u32](&(*s).etyp, (*s).t_fehler)
        i = i + 1
    }

    // 4. Konstanten der Reihe nach: eine spaetere darf eine fruehere benutzen.
    bereich_auf(s)
    i = 0
    while i < ast.konst_anzahl(b) {
        let t: u32 = ast_typ(s, ast.konst_typ(b, i))
        let got: u32 = ausdruck(s, ast.konst_wert(b, i), t)
        if !typen.vertraeglich(tafel(s), got, t) {
            meckern(s)
        }
        var gut: bool = true
        let v: i64 = konst_auswerten(s, ast.konst_wert(b, i), &gut)
        vec_push[u32](&(*s).k_name, ast.konst_name(b, i))
        vec_push[u32](&(*s).k_typ, t)
        if gut {
            vec_push[u64](&(*s).k_wert, wickeln(s, v, t) as u64)
        } else {
            vec_push[u64](&(*s).k_wert, 0)
            meckern(s)
        }
        i = i + 1
    }

    // 5. Funktionsrumpfe.
    i = 0
    while i < ast.fn_anzahl(b) {
        (*s).ret = typen.ret_typ_der_funktion(tafel(s), i)
        bereich_auf(s)
        var k: u32 = 0
        while k < ast.fn_plen(b, i) {
            var_anlegen(s, ast.param_name(b, ast.fn_poff(b, i) + k),
                        typen.param_typ_aufgeloest(tafel(s), i, k))
            k = k + 1
        }
        block(s, ast.fn_rumpf(b, i), true)
        bereich_zu(s)
        i = i + 1
    }
    bereich_zu(s)
    if hat_fe(s) {
        // Unionen, die erst in einem RUMPF aufgeloest wurden (etwa
        // `let r: E!i32 = ...`), koennen dort noch Fehler gezaehlt haben.
        let fj: usize = fehler.fehler_fehler(fe(s))
        while fe_bisher < fj {
            meckern(s)
            fe_bisher = fe_bisher + 1
        }
    }
    if hat_gc(s) {
        // gc-Typfehler, die erst in einem RUMPF auftraten (unbekannte
        // Klasse in `Gc[...]`, Klassenname als Werttyp).
        let gj: usize = gc.gc_fehler(gcp(s))
        while gc_bisher < gj {
            meckern(s)
            gc_bisher = gc_bisher + 1
        }
        // 6. `#[no_gc]` transitiv pruefen (nogc.rs). Laeuft NACH der
        //    Typpruefung, weil Regel 3 (Schreiben in ein Gc[T]-Feld) die
        //    Typtabelle braucht.
        var mu2: u64 = 0
        if hat_mu(s) {
            mu2 = (*s).mu
        }
        let nf: usize = nogc.nogc_pruefen(s as u64, mu2, (*s).gc, (*s).it)
        var nk: usize = 0
        while nk < nf {
            meckern(s)
            nk = nk + 1
        }
    }
}
